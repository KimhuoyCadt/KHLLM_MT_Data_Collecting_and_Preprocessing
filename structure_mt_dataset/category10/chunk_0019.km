សង្គ្រោះជីវិត ផ្លាស់ប្តូរផ្នត់គំនិត ទំព័រដើម
- ផ្តល់ប្រាក់កម្ចីគ្មានការប្រាក់ចំនួន ២៣គ្រួសារ (ពិការ ៨គ្រួសារ) ដើម្បីប្រកបរបរចិញ្ចឹមសត្វ លក់គ្រឿងទេស កាត់ដេរ និងជួសជុល ម៉ូតូ។
វគ្គនេះមាន គោលបំណង ដើម្បី ពង្រឹងសមត្ថភាព បន្ថែមដល់ យុវជន កាកបាទក្រហម កម្ពុជា ហើយយកចំណេះ ដឹងទាំង នេះជួយ ផ្សព្វផ្សាយ សាលារៀន និងសហគមន៍ រៀងៗខ្លួន ឱ្យកាន់តែប្រសើរឡើង៕
សាខាកក្រករាជធានីភ្នំពេញ៖ នាព្រឹកថ្ងៃសៅរ៍ ទី០៤ ខែកុម្ភៈ ឆ្នាំ២០១៧នេះ ក៏ដូចជារៀងរាល់ ព្រឹកថ្ងៃសៅរ៍ សប្តាហ៍មុនៗផងដែរ យុវជន សាខាកាកបាទក្រហមកម្ពុជា រាជធានី ភ្នំពេញ ចំនួន ៣២០នាក់រួមជាមួយ គ្រូទីប្រឹក្សា ដោយមាន ការចាត់ចែង ពីមន្រ្តី ប្រតិបត្តិសាខា បានចុះ អប់រំ សុវត្ថិភាព ចរាចរណ៍ តាមស្តុបគោលដៅ សំខាន់ៗ ចំនួន២០ ក្នុងរាជធានីភ្នំពេញ ។
វគ្គ បណ្តុះបណ្តាល នេះ មានរយៈពេល ២ថ្ងៃ គឺចាប់ថ្ងៃទី ១១ដល់ ថ្ងៃ ទី១២ ខែកក្កដា ឆ្នាំ២០១៧ ក្នុងគោលបំណង ៖
ពង្រឹងសមត្ថភាព ដល់អ្នកស្ម័គ្រចិត្ត កាកបាទក្រហម កម្ពុជា ដើម្បី ជួយអប់រំ ផ្សព្វផ្សាយ សារគន្លឹះ ស្តីពី ការការពារជំងឺ មិនឆ្លង និងការថែទាំ សុខភាព ដល់ប្រជាពលរដ្ឋ ដែលមាន អាយុច្រើន រស់នៅក្នុង សហគមន៍ ឲ្យមាន សុខភាពល្អ
កក្រក ៖ នៅព្រឹកថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ២០១៧ នេះ លោកជំទាវ ម៉ែន នារីសោភ័គ អគ្គលេខាធិការរងទី ១ កាកបាទក្រហមកម្ពុជា និងសហការី បានចុះ សួរសុខទុក្ខ សំណេះ សំណាល និងសិក្សា ស្វែងយល់ពីស្ថានភាព របស់កុមារ ខ្សោយ សតិបញ្ញា និង កុមារពិការ នៃអង្គការ ជំនួយ នៃក្តីសង្ឃឹម សម្រាប់ សហគមន៍ ដែលមាន ទីតាំង ស្ថិតនៅក្នុង អនុវិទ្យាល័យ អនុវត្តន៍ ក្រុងតាខ្មៅ ខេត្តកណ្តាល។
សាខាកក្រកខេត្តកំពត ៖ កាលពី ព្រឹកថ្ងៃ ទី១៨ ខែកក្កដា ឆ្នាំ២០១៧ សាខា កាកបាទក្រហម កម្ពុជា ខេត្តកំពត បានរៀបចំ ពិធី វគ្គបណ្តុះបណ្តាល មួយ ក្រោម ប្រធានបទ «យុវជន ជាភ្នាក់ងារ នៃ ការផ្លាស់ប្តូរ ឥរិយាបទ» ជូនដល់ យុវជន កាកបាទក្រហម កម្ពុជា ចំនួន ៤០នាក់ (ស្រី២០នាក់) មកពី វិទ្យាល័យ គោលដៅ ចំនួន ៤ ដោយមាន ការអញ្ជើញ ចូលរួម ជាគណៈអធិបតី ពីសំណាក់ លោក តាក ហាប់ សមាជិក គណៈកម្មាធិការសាខា ស្ថិតក្នុងក្រុងកំពត ខេត្តកំពត ។
នៅក្នុង កិច្ចប្រជុំ នោះ ក៏មាន វត្តមាន ពី សំណាក់ ថ្នាក់ ដឹក នាំ រួមមាន តំណាង ពី សហព័ន្ធ អន្តរជាតិ គណៈ ក ម្មា ធិ ការ អន្តរជាតិ តំណាង រាជរ ជ្ឋា ភិ បាល តំណាង អង្គទូត ភ្ញៀវកិត្តិយស ជាតិ និង អន្តរជាតិ ជាពិសេស ពី សមាគមជាតិ បណ្តាល អាស៊ីអាគ្នេយ៍ ដើម្បី ចូល រូ ម ចែករំលែក នូវ ចំណេះដឹង និង បទពិសោធន៍ គ្នា ទៅវិញទៅមក។
ជាទី បញ្ចប់ សន្ទរកថា សម្តេច កិត្តិ ព្រឹទ្ធ បណ្ឌិត ប្រធាន បាន ជូនពរ ដល់ ភ្ញៀវកិត្តិយស ទាំងអស់ សូមអោយ មាន សុខ ភាពល្អ និង ការ ស្នាក់នៅ ប្រកបដោយ ផាសុខភាព នៅក្នុង រយៈពេល នៃ ការចូលរួម កិច្ចប្រជុំ។
គោលបំណងនៃការការចូលរួមច្រូតស្រូវនេះគឺសំដៅ ជួយប្រជាជនដែលមិនមានកម្លាំងគ្រប់គ្រាន់ ក្នុងការប្រមូលផល រួមមាន ស្ត្រីមេម៉ាយដែលមានកូនច្រើន ចាស់ជរាគ្មានទីពឹង គ្រួសាររស់នៅជាមួយមេរោគអេដស៍ជាដើម។ សូមបញ្ជាក់ជូនថា ការចូលរួមប្រមូលភោគផលស្រូវនេះ គឺយុវជនកាកបាទក្រហមកម្ពុជា ខេត្ត ព្រះវិហារបានចួលរួមក្នុងសកម្មភាពនេះជារៀងរាល់ឆ្នាំ។
កក្រក៖ នាព្រឹក ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ២០១៧ លោកជំទាវ ពុំ ចន្ទីនី អគ្គលេខាធិការ បានអញ្ជើញ ជាអធិបតីភាព ក្នុង ពិធីបិទ វគ្គបណ្តុះបណ្តាល ស្តីពី “គន្លឹះ ដើម្បីភាព ជោគជ័យ និងភាពជា អ្នកដឹកនាំ” ដែលមានរយៈពេល ៤ថ្ងៃ គឺចាប់ពីថ្ងៃទី ២៥ ដល់ ២៨ ខែកក្កដា ឆ្នាំ២០១៧ ដែលមានអ្នកចូលរួមជាមន្ត្រីទីស្នាក់ការកណ្តាល និងមន្ត្រី អ្នកស្ម័គ្រចិត្ត សាខា រាជធានី ភ្នំពេញ សរុបចំនួន ៧២នាក់។
- មនុស្សយើងកើតមកដើម្បីជោគជ័យ មិនបរាជ័យទេ
- គ្មាននរណាម្នាក់ កើតមក គ្មានកំហុស ទេ តែយើង មិនត្រូវ ធ្វើនូវកំហុស ដដែលៗ ហើយ កំហុស គឺជាបទពិសោធន៍
គោលបំណង នៃវេទិកា នេះគឺ សំដៅ ចែករំលែក បទពិសោធន៍ គ្នាទៅវិញ ទៅមក ទស្សនកិច្ច តាមសហគមន៍ និងចូលរួម បើក ពិពណ៌ អាស៊ាន-ចិន លើកទី១៤ ។
ថ្ងៃទី ០៨-០៩ ខែ មិថុនា ឆ្នាំ ២០១៦ កាកបាទក្រហមកម្ពុជា សហការ ជាមួយ បេឡាជាតិ របប សន្តិសុខ សង្គម បានរៀបចំ វគ្គបណ្តុះបណ្តាល វិជ្ជាស ង្គ្រោះបឋម ដល់ បុគ្គលិក រដ្ឋបាល បុគ្គលិក សហជីព មូលដ្ឋាន គិលានុដ្ឋាក នៃរោងចក្រនានា សរុបចំនួន ៣០នាក់ ក្នុងគោលបំណង ដើម្បី ឲ្យ អ្នកទាំងនោះក្លាយជា ភ្នាក់ងារ ជំនាញ អាចជួយ ធ្វើការ សង្គ្រោះ បឋម ដល់កម្មករ និយោជិត ពេល ជួបប្រទះ គ្រោះថ្នាក់ ចរាចរណ៍ និង ដួលសន្លប់ក្នុងការបំពេញការងារ មុនពេល រថយន្តសង្គ្រោះ មកដល់៕
គោលបំណង នៃកិច្ចប្រជុំ នេះគឺ ពិនិត្យ ឡើងវិញ នូវការ អនុវត្ត លទ្ធផល កិច្ចប្រជុំ ប្រចាំឆ្នាំ លើកទី ១៣ ដែលបានប្រារព្ធ នៅទីក្រុង ហ្សាកាតា ប្រទេស ឥណ្ឌូណេស៊ី និង យុទ្ធសាស្រ្ត កាកបាទក្រហម-អឌ្ឍចន្ទក្រហម អាស៊ាន និង ចុះកិច្ចព្រមព្រៀងសហប្រតិបត្តិការ រវាងកាកបាទក្រហម កម្ពុជា វៀតណាម និងឡាវ ផងដែរ ។
