នាងពាក់អាវពណ៌ខ្មៅ និងខោខូវប៊យមួយគូ និងស្បែកជើងកវែងខ្លីនៅក្រោមជើងរបស់នាង។
"មិនអីទេ ព្រោះអ្នកខ្ពើមណាស់ អញ្ចឹងអ្នកចាកចេញទៅ" James Yi និយាយដោយត្រជាក់។
"តើអ្នកពិតជាអនុញ្ញាតឱ្យពួកយើងទៅមែនទេ តើអ្នកដឹងទេថាប្រធានាធិបតីរបស់អ្នកចំណាយប្រាក់ប៉ុន្មានដើម្បីអញ្ជើញពួកយើងមក អ្នកត្រូវតែបណ្តេញពួកយើងចេញ"។ វីវៀនសួរ។
ពីរថ្ងៃនេះគឺជាពេលវេលាដ៏មមាញឹក និងមមាញឹកបំផុតសម្រាប់ Tanya An ។
"ខ្ញុំនឹងរក្សារឿងនេះទុកជាសម្ងាត់សម្រាប់ពេលនេះ ហើយអ្នកនឹងដឹងវារហូតដល់ថ្ងៃនោះ"។ Alton Ye បាននិយាយដោយអាថ៌កំបាំង។
Tanya An បានព្យួរទូរស័ព្ទ ហើយរត់ទៅទីនោះដោយមិនមើលពួកគេ។
អ្នកដែលធ្វើការបន្ថែមម៉ោងនៅក្នុងក្រុមហ៊ុននឹងមិនធ្វើការបន្ថែមម៉ោងទេ ហើយអ្នកដែលមិនគួរធ្វើការថែមម៉ោងនឹងត្រូវធ្វើការថែមម៉ោង។
ជាមួយនឹងពេលវេលាកន្លងផុតទៅ ពីរថ្ងៃបានកន្លងផុតទៅក្នុងមួយប៉ព្រិចភ្នែក។
ពេល អ្នក សារព័ត៌មាន ទាំងអស់ បាន ឮ ដំណឹង ផ្ទុះ ពួកគេ ស្ទើរតែ ទម្លាក់ កាមេរ៉ា ក្នុង ដៃ ដោយ ក្តី រំភើប។
តើ គាត់ ជា មនុស្ស បែប ណា តែងតែ ជា អ្វី ដែល អ្នក សារព័ត៌មាន ទាំងអស់ ចង់ ជីក កកាយ ប៉ុន្តែ ទោះជា គាត់ រង់ចាំ និង ព្យាយាម យ៉ាង ណា ក៏ដោយ ក៏ គ្មាន ដាន ព័ត៌មាន របស់គាត់ ដែរ។
ពេល ព័ត៌មាន នេះ ចេញ ភ្លាម ខ្ញុំ មិន ដឹង ថា មាន ក្រុមហ៊ុន ប៉ុន្មាន ចង់ ឃើញ ទេ។
នាយកដ្ឋានខ្លះប្រើម៉ាស៊ីនបញ្ចាំងរូបភាពក្នុងនាយកដ្ឋានរបស់ខ្លួន ខណៈខ្លះទៀតមើលផ្ទាល់!
Tanya An បានរត់ទៅយកប្រអប់នៅក្នុងដៃរបស់ Ming Alton ទាំងយប់ដោយប្រយ័ត្នប្រយែងបំផុត ព្រោះវាជារបស់ដែលនាងរចនា ហើយវាជាផលិតផលសម្រេចដំបូង។
រំងាប់អារម្មណ៍របស់ខ្ញុំ ហើយដើរទៅក្បែរម៉ូដែលនីមួយៗ។
ក្រោយ ពី បញ្ចប់ អ្វីៗ ទាំង អស់ គឺ ប្រហែល កន្លះ ម៉ោង ហើយ។
ភ្ញៀវ ជាច្រើន ក្នុង ចំណោម ទស្សនិកជន មិន មែន ជា ភ្ញៀវ ធម្មតា ទេ ប៉ុន្តែ ជា អ្នក រចនា ល្បី ៗ មួយ ចំនួន។
ក្រោយ មក តន្ត្រី ក៏ បាន រោទ៍ ហើយ ម៉ូដែល ដំបូង ក៏ ចេញ មក។
ពេលខ្លះពណ៌សផ្តល់ឱ្យមនុស្សនូវគំនិតអកុសល ប៉ុន្តែសម្លៀកបំពាក់ទាំងនេះត្រូវបានបង្កើតឡើងដោយមេ តើវាអាចជាសំណាងយ៉ាងដូចម្តេច។
ទីបំផុត វីវៀន និង ជេនីហ្វឺ បានបង្ហាញខ្លួនជាមួយគ្នា។ ពេល ចេញ មក ភ្លាម គេ ពោរ ពេញ ទៅ ដោយ ភាព ជឿជាក់ លើ ផ្ទៃ មុខ ធ្វើ ឱ្យ ពួក គេ មាន មន្ត ស្នេហ៍ ភ្លាម។
អ្នកថតរូប តែងតែថតចំណងជើងនៃថ្ងៃស្អែក។
ភ្ញៀវជាច្រើនបានខ្សឹបប្រាប់គ្នាទៅវិញទៅមក។ ខ្ញុំមិនដឹងថាត្រូវពិភាក្សាអ្វីទេ។
"ខ្ញុំចង់សួរអ្នកទាំងអស់គ្នា តើអ្នកគិតថានរណាជាអ្នករៀបចំកម្មវិធីនេះនៅថ្ងៃនេះ?" Alton Ye បានសួរដោយសំឡេងយ៉ាងជ្រាលជ្រៅ។
ហើយ Tanya An ក្នុង ទស្សនិកជន ក៏ បាន ឮ យ៉ាង ច្បាស់ ហើយ ទប់ ចិត្ត មិន បាន ក្នុង អារម្មណ៍ សោកសៅ បន្តិច។ គ្មាននរណាម្នាក់ដឹងថានាងធ្វើវាទេ។
"ទេ នេះត្រូវបានធ្វើឡើងដោយអ្នកហាត់ការនៃក្រុមហ៊ុនរបស់យើង ហើយគ្រឿងអលង្ការទាំងនេះត្រូវបានរចនាឡើងដោយនាង"។ Alton Ye បាននិយាយដោយសំឡេងយ៉ាងជ្រាលជ្រៅ។
ពេលដែល Tanya An ឈានជើងឡើងលើឆាក អ្នកសារព័ត៌មាន និងភ្ញៀវកិត្តិយសទាំងអស់ មានការភ្ញាក់ផ្អើលជាខ្លាំង ប៉ុន្តែនាងមិននឹកស្មានថា នាងតូចសោះឡើយ។
ប៉ុន្តែទោះបីជាបែបនេះក៏ដោយកេរ្តិ៍ឈ្មោះរបស់នីងវ៉ាន់យានមិនបានថយចុះទេផ្ទុយទៅវិញវានៅតែបន្តកើនឡើង។
បន្ទាប់ពីមានមនុស្សពីរបីនាក់បាននិយាយលាហើយមានមនុស្សបីនាក់ទៀតបានចាកចេញនៅក្នុងបន្ទប់ទទួលភ្ញៀវដ៏ធំ។
“ ខ្ញុំខ្ពស់ហើយសង្ហាជាបងប្រុសចុងក្រោយគេនៅលើពិភពលោក…”
ហេហេខ្ញុំដឹងថាអ្នកស្គាល់ខ្ញុំច្បាស់ហើយដូច្នេះខ្ញុំនឹងនិយាយអំពីវា។ Rena Ye បាននិយាយ។
“ និយាយថាតើយ៉ាកុបយីត្រឡប់មកវិញទេ?
អរគុណបងប្រុស។ Rena Ye បានរត់ជាន់ខាងលើបន្ទាប់ពីនិយាយ។
ហេតុអ្វីបានជាអ្នកព្រួយបារម្ភអំពីអារម្មណ៍របស់អ្នកដទៃ?” Alton Ye បានសួរ។
“ វាជាការល្អដែលដឹងថាវាឈឺណាស់។ ចាប់ពីពេលនេះទៅអ្នកអាចនិយាយតែពីខ្ញុំនៅចំពោះមុខខ្ញុំមិនមែនអ្នកដទៃទេសូម្បីតែអ្នកនាងរេណាក៏ដោយ។ លោកអាល់តុនបាននិយាយថាកំពុងគ្រប់គ្រងខ្លាំង។
“ តើអំណោយអ្វី?” តានីបានសួរដោយរំពឹង។
បន្ទាប់ពីនិយាយបែបនេះគាត់បានក្រោកឈរហើយដើរឆ្ពោះទៅបន្ទប់គេង។
អាល់តុនយូគូរដោយយកចិត្តទុកដាក់ហើយដាក់ក្រែមលាបមាត់។ Alton Ye ពិតជាចំណាយពេល ៥ នាទីដើម្បីនិយាយ។
តានីអានរៀនរចនាគ្រឿងអលង្ការហើយអាចមើលឃើញពីខ្លឹមសារនៃសេចក្តីស្រឡាញ់របស់ទេវតាមួយភ្លែត។
ពេលធីណាក្រឡេកមើលទៅនាងដឹងថាខ្សែកនេះពិតជាថ្លៃណាស់។
“ វាល្អណាស់។ នេះគឺជាខ្សែកដ៏ស្រស់ស្អាតបំផុតដែលខ្ញុំមិនធ្លាប់បានឃើញ” ។ តានីអានបាននិយាយ។
នេះគឺជាកំណប់ទ្រព្យរបស់អេលីសាបិត។
“ ទេ” តានយ៉ាអានបានបដិសេធភ្លាមៗ។
តាមពិតពាក្យរបស់អាល់តុនពិតជាមិនបញ្ឆោតទេ។ ចំពោះគាត់ ១០ កោដិដុល្លារគ្រាន់តែជាការធ្លាក់ចុះនៃការដាក់ធុង។
វាមិនអីទេអ្នកអាចទិញវាបានប្រសិនបើអ្នកបាត់បង់វា” ។ Alton Ye បាននិយាយដោយធម្មជាតិ។
“ ពូខ្ញុំសប្បាយចិត្តណាស់ដែលអ្នកបានផ្តល់ឱ្យខ្ញុំ។ ខ្ញុំនឹងរង់ចាំរហូតដល់ថ្ងៃដ៏សំខាន់មួយដើម្បីពាក់ខ្សែកនេះ។ ខ្ញុំនៅតែចូលចិត្តពាក់វានៅករបស់ខ្ញុំ។ តាយ៉ាន់អានបាននិយាយដោយចិញ្ចៀននិងខ្សែក។
“ យើងនឹងពាក់វាជាក្តីស្រឡាញ់របស់ពួកទេវតាយើងនឹងពាក់វាម្តងទៀតនៅពេលដែលអ្នកចូលរួមពិធីមង្គលការរបស់លីនគ្រុប” ។ Alton Ye បាននិយាយដោយសំលេងយ៉ាងជ្រាលជ្រៅ។
បានញ៉ាំ។ Alton Ye បានអមដំណើរយ៉ានអានដើម្បីអង្គុយនៅក្នុងបន្ទប់ទទួលភ្ញៀវអានសៀវភៅ។
