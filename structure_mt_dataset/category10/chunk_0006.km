នៅក្នុងទីក្រុងដាការនេះជាលើកដំបូង, ចុងបញ្ចប់នៃការរង់ចាំបានផ្សងព្រេងមួយត្រូវបានរកឃើញ, ក្រុង Cape Town ត្រូវបានគេចាប់អារម្មណ៍ដោយការស្វាគមន៍ដែលយើងបានប្រទានការ, ភាពរីករាយនៃអ្នកទស្សនាបាន.
