“ ព្រះជាម្ចាស់ជាព្រះវិញ្ញាណបរិសុទ្ធ”
"ដួងចិត្តរបស់ព្រះយេស៊ូវព្រះរាជបុត្រានៃព្រះវរបិតាដ៏អស់កល្បជានិច្ច" ។
"ដួងចិត្តរបស់ព្រះយេស៊ូវដើម្បីព្រះបន្ទូលរបស់ព្រះបានរួបរួមគ្នាយ៉ាងខ្លាំង" ។
"បេះដូងរបស់ព្រះយេស៊ូវ, ព្រះវិហារបរិសុទ្ធនៃព្រះ" ។
"បេះដូងនៃព្រះយេស៊ូវជាដំណាក់នៃព្រះនិងទ្វារស្ថានសួគ៌។ "
"បេះដូងរបស់ព្រះយេស៊ូវជម្រកនៃយុត្តិធម៌និងសេចក្តីស្រឡាញ់" ។
"ដួងចិត្តរបស់ព្រះយេស៊ូអប៊ីស៊ីនៃគុណធម៌ទាំងអស់" ។
"ដួងចិត្តរបស់ព្រះយេស៊ូជាព្រះមហាក្សត្រនិងជាបេះដូងនៃដួងចិត្តទាំងអស់" ។
"ដួងចិត្តរបស់ព្រះយេស៊ូវដែលស្ថិតនៅក្នុងភាពពេញលេញនៃទេវភាព" ។
«បេះដូងនៃព្រះយេស៊ូវដែលយើងទាំងអស់គ្នាបានទទួល»។
"ដួងចិត្តរបស់ព្រះយេស៊ូវអត់ធ្មត់និងមេត្តាករុណាខ្លាំងណាស់" ។
"បេះដូងរបស់ព្រះយេស៊ូវប្រភពនៃជីវិតនិងភាពបរិសុទ្ធ" ។
"បេះដូងរបស់ព្រះយេស៊ូវពេញដោយភាពអាម៉ាស់" ។
«ដួងចិត្តរបស់ព្រះយេស៊ូវបានស្តាប់បង្គាប់រហូតដល់ ការស្លាប់"។
"បេះដូងរបស់ព្រះយេស៊ូវសន្តិភាពនិងការផ្សះផ្សារបស់យើង" ។
"ដួងចិត្តរបស់ព្រះយេស៊ូវសេចក្ដីសង្គ្រោះរបស់អស់អ្នកដែលសង្ឃឹមលើអ្នក" ។
"បេះដូងនៃព្រះយេស៊ូវ, រីករាយនៃពួកបរិសុទ្ធទាំងអស់" ។
“ កូនចៀមនៃព្រះដែលដកបាបចេញពីលោកីយៈសូមស្តាប់យើង។
«ព្រះយេស៊ូវសុភាពរាបសានិងរាបសានៃដួងចិត្តធ្វើឱ្យចិត្តរបស់យើងស្រដៀងនឹងអ្នកដែរ»។
វាគឺជាពាក្យមួយក្នុងចំណោមពាក្យដែលស្អាតបំផុត
មិត្ដភាពមិនដឹងពីភាពអាត្មានិយម;
វាគឺជាការគោរពនិងទទួលយកអ្វីដែលពួកគេមាន។
កំពុងស្ថិតនៅក្នុងសេចក្តីអំណរនិងភាពលំបាក។
ពេលខ្លះអ្នករកឃើញនៅក្នុងជីវិត
នរណាម្នាក់ដែលនៅពេលដែលចូលក្នុងជីវិតរបស់អ្នក
ថានរណាម្នាក់ដែលធ្វើឱ្យអ្នកសើចឥតឈប់ឈរ;
ថាមានទ្វារត្រៀមខ្លួនជាស្រេច
នោះគឺជាមិត្តភាពដ៏អស់កល្បជានិច្ច។
ហើយពិភពលោកហាក់ដូចជាងងឹតហើយទទេ
និងការយល់ច្រឡំដ៏អស្ចារ្យ។
មិត្តភាពអស់កល្បរបស់អ្នកដើរតាមអ្នក។
មិត្តភាពអស់កល្បរបស់អ្នកដឹកនាំអ្នកហើយធ្វើឱ្យអ្នកសប្បាយចិត្ត។
ហើយប្រាប់អ្នកថាអ្វីៗនឹងល្អ។
អ្នកមានអារម្មណ៍សប្បាយរីករាយនិងពេញដោយអំណរ
អ្នកមានមិត្តភាពមួយជីវិត
មិត្តភាពគឺដូចជាផ្កាកុលាប។
ដើម្បីនិយាយថាស្នេហាគឺធ្វើឱ្យការឈឺចាប់ឈឺចាប់និងលះបង់លះបង់ជាទីស្រឡាញ់។
ដើម្បីនិយាយថាស្នេហាគឺការរកឃើញនូវសេចក្តីបន្ថែមនៃសេចក្តីប្រាថ្នាទាំងអស់នៃជីវិត។
មិត្តភាពគឺដូចគ្នានឹងដៃដែរ
និងមានអារម្មណ៍ថាអស់កម្លាំងត្រូវបានបន្ធូរបន្ថយ
និងបំភ្លឺរាត្រីខាងក្នុងរបស់យើង។
ខ្ញុំជំពាក់មិត្តភក្តិរបស់ខ្ញុំការអត់ធ្មត់របស់ខ្ញុំ
ប៉ុន្តែវាមិនអាចនៅជាមួយគាត់បានទេ
ខ្ញុំជំពាក់មិត្តរបស់ខ្ញុំខ្លះខឹង
យើងទាំងអស់គ្នាដឹងថាវាមិនអាចជាអំពើបាបទេ
ខ្ញុំនឹងសេពគប់មិត្តរបស់ខ្ញុំនៅពេលខ្ញុំស្លាប់
មិត្តភក្តិរបស់ខ្ញុំប្រសិនបើ couplet នេះដូចជាខ្យល់
អ្នកនឹងមានពហុវចនៈពីព្រោះអារម្មណ៍ទាមទារវា
ខ្ញុំចង់ឲ្យ អ្នកយល់ពីខ្ញុំដោយគ្មានពាក្យ។
ដែលអ្នកយល់ខ្ញុំដោយគ្មានពាក្យ
អ្នកសួរខ្ញុំ, មិត្តភក្តិ, ហើយខ្ញុំមិនដឹងថាខ្ញុំត្រូវផ្តល់ចម្លើយអ្វីដែលអ្នក,
ខ្ញុំចង់បង្ហាញពួកគេដោយដាក់ព្រះអាទិត្យដែលមើលមិនឃើញនៅក្នុងភ្នែករបស់ខ្ញុំ
អ្នកសួរខ្ញុំ, មិត្តភក្តិ, ហើយខ្ញុំមិនដឹងថាចម្លើយអ្វីដើម្បីផ្តល់ឱ្យអ្នក។
ខ្ញុំចង់អោយអ្នកមានអារម្មណ៍ថាវាជន់លិចព្រលឹងអ្នក
បង្កើតភាពសប្បាយរីករាយផងដែរខ្ញុំចង់អោយអ្នកក្លាយជា
ប្រសិនបើឥឡូវនេះខ្ញុំបានប្រាប់អ្នកថាអ្នកត្រូវតែដើរឆ្លងកាត់ទីក្រុងដែលបាត់បង់
ហើយច្រៀងសុបិនដ៏ខ្មៅងងឹតរបស់អ្នកនៅក្រោមដើមឈើរដូវក្ដៅ
ប្រសិនបើឥឡូវនេះខ្ញុំបានប្រាប់អ្នក
ផ្កាដោយខ្លួនវាផ្ទាល់ដែលញ័រនិងពោរពេញទៅដោយពណ៌ខៀវនៅភាគheastសាន
ក្មេងដែលគ្រវីសមុទ្រដោយដៃគ្មានទោសរបស់គាត់ ...
តើខ្ញុំនឹងដាក់ភ្លើងអ្វីនៅក្នុងមាត់របស់ខ្ញុំនិងអ្វីដែលកំពុងឆេះដែក?
ហើយធ្វើម៉េចទើបដឹងថាអ្នកយល់ពីខ្ញុំ?
តើធ្វើដូចម្តេចដើម្បីធ្វើឱ្យអ្នកមានអារម្មណ៍ថាអ្នកចាញ់ជារៀងរហូត?
ដាក់ភ្លើងសេឡេស្ទាលក្នុងភាពទុក្ខព្រួយដ៏ខ្មៅងងឹតរបស់អ្នកឬ?
មិត្តភាពគឺជាត្រីដែលមានពន្លឺភ្លឺរលោង។
ឆ្ពោះទៅរកសមុទ្រមេអំបៅដ៏សប្បាយរីករាយ។
សំឡាញ់អើយយកអ្វីដែលអ្នកចង់បាន
ហើយប្រសិនបើអ្នកចង់ខ្ញុំនឹងផ្តល់ឱ្យអ្នកនូវព្រលឹងរបស់ខ្ញុំទាំងមូល
ផឹកពីចានដែករបស់ខ្ញុំប្រសិនបើអ្នកស្រេកទឹក។
បំណងប្រាថ្នារបស់ខ្ញុំនេះដែលផ្កាកុលាបទាំងមូល
មិត្តប្រសិនបើអ្នកឃ្លានញ៉ាំនំបុ័ងរបស់ខ្ញុំ។
ទាំងអស់នេះដោយមិនសម្លឹងមើលអ្នកនឹងឃើញនៅក្នុងបន្ទប់អាក្រាតរបស់ខ្ញុំ។
- ដូចជាបេះដូងរបស់ខ្ញុំ - តែងតែស្វែងរកកំពស់។
គ្មាននរណាម្នាក់ដឹងពីរបៀបចែកចាយទេ
លើកលែងតែមួយដែលខ្ញុំចាំបាន។
វាគឺជាផ្កាកុលាបពណ៌សដែលបើកនៅក្នុងភាពស្ងៀមស្ងាត់។
ដោយមិនដឹងពីអ្វីដែលនៅតាមផ្លូវ។ បងប្អូនវាសនាយ៉ាងស្រាល,
បន្ទាប់ពីក្លិនក្រអូបរបស់ស្ត្រី។
ពេស្យាចារនិងការប្រយុទ្ធ។
មិត្តស្រីសម្រាប់យើងទាំងពីរនាក់។
នាំខ្ញុំចេញពីសង្កាត់
ហើយទុកនៅលើបបូរមាត់
ហើយកាលពីម្សិលមិញនិងជានិច្ច
នោះគឺជាភាពទន់ភ្លន់។
ពួកគេដឹងថាខ្ញុំដាក់ឈ្មោះអ្នកណាខ្លាំងណាស់។
តើយើងខិតជិតព្រះគម្ពីរមរមនយ៉ាងដូចម្តេច អានីឌីដការអធិស្ឋានទាំងនេះនឹងមកនៅក្នុងការងាយស្រួលផងដែរដើម្បីអបអរកំណើតរបស់ព្រះយេស៊ូ; ដូច្នេះអ្នកអាចប្រើរបស់ទាំងនេះ អំពូលភ្លើងដល់ព្រះកុមារ មិនមានបញ្ហានៅរដូវឈប់សម្រាក។
"ព្រះតេជព្រះគុណយើងសូមសរសើរអ្នកទាំងអស់គ្នា" ។
"ការលើកតម្កើងកុមារយើងទាំងអស់គ្នាសរសើរអ្នក" ។
"កូនខាងវិញ្ញាណយើងទាំងអស់គ្នាសរសើរអ្នក" ។
"លោកម្ចាស់នៃពួកសាវកយើងទាំងអស់គ្នាសរសើរអ្នក" ។
"អយ្យកោនៃយុត្តិធម៌យើងទាំងអស់គ្នាសរសើរអ្នក" ។
ប្រសិនបើអ្នកឃើញថាអត្ថបទនេះគួរឱ្យចាប់អារម្មណ៍យើងសូមអញ្ជើញអ្នកឱ្យអានអត្ថបទរបស់យើងនៅលើ:ការអធិស្ឋានដល់ទារកព្រះយេស៊ូវនៃក្រុងប្រាកសម្រាប់ការប្រលងចុងក្រោយ.
