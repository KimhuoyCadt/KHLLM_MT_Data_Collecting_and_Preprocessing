នេះមានន័យថាពួកគេឱ្យតម្លៃលើទំនាក់ទំនង, ពួកគេស្វែងរកយ៉ាងច្បាស់ដើម្បីស្គាល់ទំនាក់ទំនងសំខាន់ៗរបស់អ្នក, ហើយពួកគេផ្តល់ឱកាសដល់អ្នកដើម្បីចិញ្ចឹមបីបាច់និងរីកចម្រើន.
តើយើងធ្វើការជាមួយអង្គការយ៉ាងដូចម្តេច?
យើងផ្តល់នូវធនធានជាក់ស្តែងជាច្រើនដែលជួយបុគ្គលិកគ្រប់តួនាទីទាំងអស់ឱ្យធ្វើកិច្ចការនេះ.
យើងក៏មានការអភិវឌ្ឍន៍វិជ្ជាជីវៈជាមួយបុគ្គលិកនិងអ្នកស្ម័គ្រចិត្តផងដែរ.
អង្គការយើងធ្វើការជាមួយ
មើលបញ្ជីបច្ចុប្បន្ននៅទីនេះ.
តួនាទីរបស់ COTA អូស្រ្តាលីគឺដើម្បីលើកកម្ពស់, ធ្វើឱ្យប្រសើរឡើងនិងការពារសុខុមាលភាពរបស់មនុស្សចាស់នៅក្នុងប្រទេសអូស្ត្រាលីក្នុងនាមជាពលរដ្ឋនិងអ្នកប្រើប្រាស់.
ផ្ដល់នូវជំនាញនៅក្នុងគោលនយោបាយនិងការអនុវត្តរួមបញ្ចូលវប្បធម៍សម្រាប់វិស័យសេវាកម្មដែលមានអាយុ.
ការពារនិងបង្កើនសុវត្ថិភាព, សុខភាព, សុខុមាលភាពនិងគុណភាពនៃជីវិតរបស់ប្រជាជនដែលទទួលការព្យាបាលដែលមានអាយុ.
អស់រយៈពេលមួយឆ្នាំមកហើយដែលពួកគេបានបញ្ចូលការថែរក្សារួមគ្នាទៅគ្រប់ផ្នែកនៃថ្ងៃ.
នៅពេលដែលពួកគេចាប់ផ្តើមចូលរួមក្នុងការថែទាំរួមបញ្ចូលគ្នា, គំរូរបស់ពួកគេត្រូវបានផ្លាស់ប្តូរដូច្នេះពួកគេអាចទំនាក់ទំនងជាមួយមនុស្សវ័យចំណាស់ម្នាក់ៗ.
បុគ្គលិកទាំងអស់ដែលកំពុងធ្វើការជាមួយមនុស្សចាស់បន្ទាប់មកធានាថាពួកគេស្គាល់ច្បាស់អំពីទំនាក់ទំនងសំខាន់របស់បុគ្គលនោះ, និងកសាងវានៅក្នុងការសន្ទនានិងផែនការ.
មានរឿងជាច្រើនកើតឡើងនៅពីក្រោយឆាកដើម្បីគាំទ្ររឿងនេះ, រួមទាំងការចិញ្ចឹមបីបាច់ពិភពខាងក្នុងរបស់បុគ្គលិកម្នាក់ៗ.
ផ្នែកនៃការបណ្តុះបណ្តាលគឺដើម្បីពង្រីកការយល់ដឹងរបស់ក្រុមអំពីភាពខាងវិញ្ញាណ.
ឥឡូវនេះពួកគេយល់ថានៅកន្លែងជាច្រើនដូចជាអូស្ត្រាលី, ភាពខាងវិញ្ញាណគឺទូលំទូលាយណាស់ហើយអាចឬមិនរាប់បញ្ចូលជំនឿសាសនា.
ផលិតផល – សូមមើលខ្ញុំបានដឹងថាខ្ញុំ
ស្នាក់នៅបានតភ្ជាប់ – សូមមើលខ្ញុំបានដឹងថាខ្ញុំ
ហេតុអ្វីបានជាវាសំខាន់ដើម្បីភ្ជាប់ទំនាក់ទំនងនៅពេលក្រោយក្នុងជីវិត?
"អង្គការសុខភាពពិភពលោកបានចាត់ខាងវិញ្ញាណជាការជាប់ពាក់ព័ន្ធទៅនឹងគុណភាពនៃជីវិត".
គ្រាន់តែជាឧទាហរណ៍មួយចំនួនដែល:
ការគាំទ្រខាងវិញ្ញាណ (ខាងសាសនានិងគ្មានសាសនា) គឺជាកត្តាសំខាន់ក្នុងការសុខុមាលភាពនិងគុណភាពនៃជីវិតនៅចុងបញ្ចប់នៃជីវិត (Nichols 2013),
ការចូលរួមរបស់សាសនានិងខាងវិញ្ញាណត្រូវបានផ្សារភ្ជាប់ជាមួយនឹងលទ្ធផលល្អប្រសើរជាងមុនរួមទាំងភាពជាប់បានយូរសុខភាពកាន់តែច្រើន, ជំនាញតស៊ូ, ដែលមានគុណភាពនៃជីវិតទាក់ទងនឹងសុខភាព, និងការថប់បារម្ភតិច, ជំងឺធ្លាក់ទឹកចិត្តនិងធ្វើអត្តឃាត (Mueller, Plevak និង Rummans 2001),
ខាងវិញ្ញាណអាចមានឥទ្ធិពលលើបទពិសោធរបស់មនុស្សពេញវ័យដែលមានវ័យចំណាស់និងការយល់ឃើញនៃព្រឹត្តិការណ៍ជីវិត, នាំឱ្យមានការវាយតម្លៃជាវិជ្ជមានបន្ថែមទៀតនៃព្រឹត្តិការណ៍ទាំងនេះមានអត្ថន័យ (Cowlishaw, ការលេប, កែប្រែចិត្ដគំនិត, ត្នោតនិង Kendig 2013).
ការស្រាវជ្រាវដោយក្រុមអ្នកជំនាញបានរកឃើញថាការរួមទាំងការថែទាំខាងវិញ្ញាណអាចបំបាត់ជំងឺធ្លាក់ទឹកចិត្តនិងការថប់បារម្ភ (អូ & លោកគីម 2012).
ក្រុមដូចខាងវិញ្ញាណដែលបានផ្តល់ជូននូវការគាំទ្រគ្នាទៅវិញទៅមករវាងសមាជិកក្រុម, ការចែករំលែកនៅក្នុងបរិស្ថានការជឿទុកចិត្ដមួយ, ហើយមិត្តភាពថ្មី (MacKinlay 2006),
មនុស្សដែលមានអារម្មណ៍នៃអារម្មណ៍តែមួយគត់និងថែទាំ, មានអារម្មណ៍កាន់តែខ្លាំងនិងអ្នកដទៃទៀតដើម្បីដោះស្រាយដូចខាងក្រោមអន្តរាគមន៍ការថែរក្សាខាងវិញ្ញាណ (Narayanasamy & Owens 2000), និង
ចាប់តាំងពីការជួបប្រទះនឹងការថែទាំខាងវិញ្ញាណនៅក្នុងសកម្មភាព Malinka ទទួលបានគុណភាពនៃជីវិតកាន់តែច្រើន.
ថែទាំបានយកឱកាសដើម្បីនិយាយជាមួយនាងខណៈដែលពួកគេបានគាំទ្រមួយរបស់នាងជាមួយនឹងស្លៀកពាក់និងងូតទឹក.
នាងត្រូវបានទៅទស្សនាដោយប្រភេទថ្មីនៃសមាជិកបុគ្គលិកដែលគឺពិតជាល្អនៅការស្តាប់, និងការចាប់អារម្មណ៍នៅក្នុងរឿងជីវិតយូរមក Malinka របស់, រួមបញ្ចូលទាំងការស្វែងរកនិងតម្លៃរបស់នាងជំនឿ.
មនុស្សជាច្រើនគិតថាការទទួលយកការថែទាំដែលមានអាយុពីន័យថាពួកគេនៅលើផ្លូវទៅជាមើលមិនឃើញហើយការពឹងផ្អែកនេះប៉ុន្តែការពិតជាមួយនឹងការថែទាំស្តាំ, អ្នកអាចមានអារម្មណ៍កាន់តែច្រើននៅរស់ជាងអ្នកបានធ្វើពីមុន.
ផែនទីអត្ថន័យនិងភាពចាស់: មគ្គុទេសក៍ឆ្លុះបញ្ចាំងខ្លួនឯង – សូមមើលខ្ញុំបានដឹងថាខ្ញុំ
រចនារួមគ្នាជាមួយមនុស្សចាស់, ប្រើមគ្គុទេសក៍ងាយស្រួលនេះដើម្បីចូលរួមជាមួយអត្ថន័យជីវិតរបស់អ្នក.
ចែករំលែកកញ្ចប់ – សូមមើលខ្ញុំបានដឹងថាខ្ញុំ
រួមបញ្ចូលកាតសន្ទនា, កាតគោលបំណងនិងសំណួរសម្រាប់ការថែទាំចាស់.
ពេញ ឧបករណ៍ចែករំលែក សម្រាប់ក្រុមរួមមាន:
អ្នកគាំទ្រសហគមន៍ – សូមមើលខ្ញុំបានដឹងថាខ្ញុំ
យើងបានធ្វើការជាមួយក្រុមមនុស្សចាស់ដើម្បីបង្កើតមគ្គុទេសក៍ឆ្លុះបញ្ចាំងខ្លួនឯងដោយប្រើក្របខ័ណ្ឌមួយហៅថា 'ផែនទីអត្ថន័យ'.
អានបន្ថែមឬសន្យាទិញច្បាប់ចម្លងជាមុន នៅទីនេះ.
ការប្រព្រឹត្ដវ័យជរាមានន័យជាមួយនឹងអង្គការដែលបានមកពីជួរធំទូលាយមួយនៃទស្សនៈពិភពលោកនិងមានសាមគ្គីភាពនៅជុំវិញជាគោលដៅជារឿងធម្មតានៃគុណភាពជីវិតសម្រាប់ពេញលេញនៃការដែលពួកគេបានមនុស្សវ័យចំណាស់កំពុងបម្រើ.
យើងតស៊ូមតិសម្រាប់ការថែទាំខាងវិញ្ញាណត្រូវបានរួមបញ្ចូលនៅក្នុងការកំណត់ការថែទាំទាំងអស់.
យើងបានធ្វើការជាមួយនឹងការកើនឡើងនៃជួរការថែទាំដែលមានអាយុពីអ្នកផ្តល់ការធំនៅទូទាំងតូចនិងអូស្ត្រាលី.
