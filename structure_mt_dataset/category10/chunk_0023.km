ករណីទាំងបីខាងលើគឺស្ថិតក្នុងចំណោមករណីជាច្រើនទៀត ដែលបណ្តាលឲ្យអ្នកបើកបរ ទោចក្រ យាន យន្ត និងអ្នករួមដំណើរ ក្នុងនោះមានទាំងកុមារផង ហើយ ពួកគេភាគច្រើនមិនបានពាក់មួកសុវត្ថិភាព។ យោងតាម របាយ ការណ៍ របស់នាយកដ្ឋាននគរបាលចរាចរណ៍និង សណ្តាប់ធ្នាប់នៃ អគ្គស្នងការ ដ្ឋាន នគរបាល ជាតិ បានបង្ហាញថា គ្រាន់តែនៅក្នុង រយៈពេលពិធីបុណ្យចូលឆ្នាំខ្មែរ រយៈពេល៥ ថ្ងៃ (១៣- ១៧ មេសា ២០១៦) មាន គ្រោះថ្នាក់ចរាចរណ៍រហូតដល់ទៅ១១៣ ករណី។ មនុស្ស៥២នាក់បានស្លាប់ ក្នុង នោះ ២៦ នាក់មិនបានពាក់មួកសុវត្ថិភាព ហើយ និង២៣៩ នាក់ទៀតបាន របួស។
បើតាមលទ្ធផលនៃការវិភាគ របស់ អង្គការមូលនិធិបង្ការរបួស អាស៊ី (AIP Foundation)បាន ឲ្យដឹង ថា ប្រសិន បើ ការអនុវត្តច្បាប់ចរាចរណ៍ផ្លូវគោក មាន ប្រសិទ្ធភាពចាប់ តាំងពី២០១៥ ជាពិសេស សំដៅលើ អ្នក រួម ដំណើរ តាមទោចក្រយានយន្ត នោះហើយអត្រាពាក់មួកសុវត្ថិភាពឈានដល់៨០% កម្ពុជាអាច នឹង សង្រ្គោះ ជីវិតមនុស្ស បានដល់ទៅ ៥៦១នាក់ ការពារអ្នក រួម ដំណើរបាន ១0.៥៧៤នាក់ពីការរងរបួសក្បាល និង ការ ពារការ ខាតបង់ថវិកា រហូតដល់ទៅ ៩៨.៦១៨.៤២២ ដុល្លារ អាម៉េរិកនៅឆ្នាំ២០២០។
លោក បញ្ញា បានបន្តថា “បទពិសោធន៍ពីបណ្តាប្រទេសផ្សេងៗបង្ហាញថា ការអនុវត្តច្បាប់ឲ្យបានម៉ឺងម៉ាត់គឺពិតជាមានប្រសិទ្ធភាពក្នុងការបង្កើន ការ ពាក់ មួក សុវត្ថិភាពរហូតដល់ទៅ៩០% ដែលមាន ន័យថា បាន ជួយ ជីវិតអ្នកដែលបាន ប្រើប្រាស់ផ្លូវថ្នល់។ នៅក្នុងប្រទេសកម្ពុជា ដែលមានចំនួន អ្នក ប្រើប្រាស់ទោច ក្រយាន យន្តជាច្រើនបានស្លាប់និងរបួស ការអនុវត្តច្បាប់ដោយផ្តោតគោលដៅលើការពាក់មួសុវត្ថិភាព នឹង មាន ឥទ្ធិពលយ៉ាងខ្លាំងក្នុងការសង្គ្រោះជីវិតមនុស្ស”។
មាត្រា៨នៃច្បាប់ចរាចរណ៍ផ្លូវគោកចែង ថា “ទោចក្រយានយន្តអាច ផ្ទុកមនុស្សពីរនាក់ និងអាចបន្ថែមបានកុមារមួយនាក់។ អ្នក បើកបរទោច ក្រយានយន្ត និង អ្នក រួមដំណើរ ព្រមទាំង កុមារដែល មាន អាយុ ចាប់ ពី ៣ (បី) ឆ្នាំឡើងទៅ ត្រូវ ពាក់មួកសុវត្ថិភាពឲ្យបានត្រឹមត្រូវ។ អ្នក បើកបរ ត្រី ចក្រយានយន្ត និង អ្នក បើក បរ ទោចចក្រយានយន្តសណ្តោងរឺម៉ក ត្រូវពាក់មួកសុវត្ថិភាពឲ្យបានត្រឹមត្រូវ”។
ដោយ សារតែបញ្ហានេះ គឹម បញ្ញា បានបញ្ជាក់ថា “យើងសូមលើកទឹកចិត្តដល់រាជរដ្ឋាភិបាលឲ្យចាត់វិធានការណ៍បន្តទៀត ដើម្បីជំរុញឲ្យ មាន ការពាក់ មួក សុវត្ថិ ភាព នៅទូទាំងប្រទេស ពិសេសក្នុង ចំណោម មន្រ្ តីរាជការ និងសិស្សានុសិស្ស។ គ្រប់ក្រសួង ឬស្ថាប័ននីមួយៗរបស់រាជរដ្ឋាភិបាលគួរចេញជាបញ្ញតិ ឬសេចក្តី ណែ នាំសម្រាប់មន្រ្តីនិងបុគ្គលិករបស់ខ្លួនដោយតម្រូវឲ្យពាក់មួកសុវត្ថិភាពដាច់ខាត ទាំង អ្នក បើក បរ និង អ្នករួមដំណើរ។ ចំណុចនេះគឺ ត្រូវចាប់ ផ្តើម ពី កង កម្លាំង នគរបាល និងកងរាជអាវុធហត្ថ ហើយបន្ទាប់មក គឺមន្រ្តីរាជការនិងសិស្សានុសិស្ស។
លោក ឧត្តមសេនីយ៍ទោ ទី ឡុង អនុប្រធាននាយកដ្ឋាននគរបាលចរាចរណ៍ និង សណ្តាប់ធ្នាប់សាធារណៈ នៃអគ្គស្នងការដ្ឋាន នរគបាល ជាតិក៏ បាន ឯក ភាព នឹង លោក គឹម បញ្ញា ដែរ ដោយលោកនិយាយថា បើទោះជាចំនួនអ្នកពាក់ មួកសុវត្ថិភាពបានកើនឡើងចាប់ពីដើមឆ្នាំនេះក៏ដោយ ក៏ចំនួន នេះមិន បាន ដល់កម្រិតដែលជាគោលដៅនៅឡើយ ទេ។
គាត់បាននិយាយថា ”ខ្ញុំបានដឹងពីច្បាប់ចរាចរណ៍ ប៉ុន្តែខ្ញុំសង្កេតឃើញថា មានមនុស្សជាច្រើនមិនបាន ពាក់មួក សុវត្ថិភាពទេ ហើយ ពួកគេ មិន ត្រូវបាន នគរ បាល បានផាកពិន័យដែរ។ ដូចនេះពេលខ្លះ ខ្ញុំក៏មិន បាន ពាក់ មួកសុវត្ថិភាពដែរ”។
លោកវីរៈសេនីយ៍ ចេវ ហាក់ នាយការិយាល័យចរាចរណ៍ផ្លូវគោករាជធានីភ្នំពេញក៏បានទទួលស្គាល់ដែរថា ចំនួនអ្នកបើកបរទោចក្រយាន យន្តនិងអ្នក រួម ដំណើរ កាន់ តែច្រើនបានពាក់មួកសុវត្ថិភាពនៅពេលថ្ងៃ តែនៅពេលយប់ មិនច្រើនទេ ខណៈដែលការអនុវត្តច្បាប់នៅមានចន្លោះប្រហោងខ្លះ។
ចំណែក លោក ឧត្តមសេនីយ៍ទោ ទី ឡុង ក៏បានបន្ទរការលើកឡើងរបស់រដ្ឋមន្រ្តីក្រសួងមហាផ្ទៃដែរ ដោយ លោកបញ្ជាក់ថា ការពង្រឹង ការអនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវ គោក ត្រូវតែធ្វើឲ្យបានម៉ឺងម៉ាត់ ដើម្បី ផ្លាស់ ប្តូរ ឥរិ យា បថសាធារណជនចំពោះការបើកបរនៅតាមដងផ្លូវ ដើម្បីជួយសង្រ្គោះជីវិតមនុស្សពីគ្រោះថ្នាក់ ពិសេស ពីការ រង របួសក្បាល៕
ដំណើរទស្សនកិច្ចនេះពិតជាមោទនភាពដ៏ធំធេងសម្រាប់ប្រទេសកម្ពុជាដែលជាប្រទេសតូចតាច ដោយមានមេដឹកនាំនៃប្រទេសមហាអំណាចលើចក្រវាលបានមកស្នាក់អាស្រ័យ។ ម្យ៉ាងទៀត ការមកដល់ប្រទេសកម្ពុជារបស់លោកប្រធានាធិបតី អូបាម៉ា គឺជាឱកាសរបស់លោកក្នុងការបានជួបមេដឹកនាំកំពូលៗនៅអាស៊ី និងអឺរុប ដើម្បីពង្រឹងចំណងការទូត និងសហប្រតិបត្តិការសេដ្ឋកិច្ចពាណិជ្ជកម្មបន្ថែមទៀត បន្ទាប់ពីលោកទើបតែបានជាប់ឆ្នោតជាប្រធានាធិបតីអាមេរិកអាណតិទីពីរ។
នៅក្នុងសៀវភៅ “ហ៊ុន សែន – នយោបាយនិងអំណាចក្នុងប្រវត្តិសាស្ត្រខ្មែរជាង៤០ឆ្នាំ” អ្នកនិពន្ធ បានដកស្រង់សំណេររបស់សម្ដេច នរោត្តម សីហនុ ពីភាពសោកសៅរបស់ព្រះអង្គ និងពីការធ្វើ ទុក្ខទោម្នេញរបស់ពួកស៊ីអាយអេ (CIA) អាមេរិក ក្នុងការតាមធ្វើឃាត និងផ្ដួលរំលំព្រះអង្គ។
ក្រោយមក បើទោះជាដឹងថា អាមេរិកមិនមែនជាមិត្តរបស់ទ្រង់ក៏ដោយ ក៏ព្រះអង្គបានស្នើសុំរដ្ឋាភិ បាលអាមេរិកនូវសិទ្ធិជ្រកកោននយោបាយ បន្ទាប់របបប៉ុលពតបានដួលរលំនៅថ្ងៃ ៧ មករា ឆ្នាំ ១៩៧៩ ហើយវៀតណាមបានចូលមកកាន់កាប់ប្រទេសកម្ពុជា។ នៅក្នុងសៀវភៅ “អ្នកម្ដាយ និង កូនអង្គការ” អ្នកនិពន្ធបានដកស្រង់សំណេររបស់សម្ដេច សីហនុ ថា ទាំងអាមេរិកនិងបារាំង បាន បដិសេធន៍ពីការសុំសិទ្ធិជ្រកកោននយោបាយនេះ គឺមានតែប្រទេសចិនប៉ុណ្ណោះបាន ទទួល យក ព្រះអង្គ។
បន្ទាប់ពីរដ្ឋប្រហារនេះមក ប្រទេសកម្ពុជាដែលធ្លាប់តែសម្បូរណ៍រុងរឿងបានធ្លាក់ចូលក្នុងសង្គ្រាម ស៊ីវិល និងប្រល័យពូជសាសន៍ ហើយនគរពោរពេញដោយស្នាមរណ្តៅគ្រាប់បែកយន្តហោះបេ៥២ របស់អារមរិក និងក្រាលដោយគ្រាប់មីនរាប់លានគ្រាប់។ បញ្ហានេះបាន បង្ករឲ្យមនុស្សរាប់លាន នាក់ស្លាប់ ហើយអ្នករស់រានមានជីវិតរាប់លាននាក់ផ្សេងទៀតបានធ្លាក់ខ្លួនជាស្ត្រីមេម៉ាយ ជាកូនកំព្រាឪពុកម្ដាយ និងជាជនពិការ។
ប៉ុន្តែសម្រាប់កម្ពុជាគឺមិនដែលមានសកម្មជនណាទាមទារឲ្យមេដឹកនាំជប៉ុនធ្វើខមាទោសដល់ ប្រជាជាតិកម្ពុជាឡើយ បើទោះជាទាហានជប៉ុនបានឈ្លានពានកម្ពុជា និងមានទង្វើដូចខាង លើ ខ្លះៗក៏ដោយ។ ចំណុចនេះទំនងជាជនជាតិខ្មែរមិនចង់រំលឹកពីរឿងអតីតកាលដែលនាំឲ្យ ប៉ះពាល់ ដល់មិត្តភាពនាពេលបច្ចុប្បន្ន។
ឥឡូវនៅសប្ដាហ៍នេះ ប្រធានាធិបតី រដ្ឋមន្ត្រីការបរទេស និងមេទ័ពរបស់ប្រទេសមហាអំណាច ដែលបានគាំទ្រឲ្យបណ្ដេញព្រះអង្គចេញពីព្រះប្រមុខរដ្ឋកាលពីអតីតកាលបានមកទឹកដីកម្ពុជា។ បើតាមប្រសាសន៍របស់លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តីក្រសួងព័ត៌មានបានឲ្យដឹងថា រហូតមកត្រឹមថ្ងៃទី ១៣ វិច្ឆិកា នេះគឺមានតែនាយករដ្ឋមន្រ្តីនៃប្រទេសមួយប៉ុណ្ណោះដែលបានដាក់ស្នើចូលគោរពព្រះបរមសពរបស់ព្រះបិតាឯករាជ្យជាតិខ្មែរ តែសម្រាប់មេដឹកនាំអាមេរិកមិនទាន់មានកម្មវិធីចូលគោរពនៅឡើយទេ។
