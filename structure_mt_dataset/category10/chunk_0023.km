សេចក្តីសម្រេច របស់គណៈកម្មការអឺរ៉ុប ក្នុង ការ ដកផ្នែកខ្លះ នៃ ប្រព័ន្ធអនុ គ្រោះ ពន្ធ «អ្វីៗគ្រប់ យ៉ាង លើក លែង អាវុធ » ហៅកាត់ថា EBA សម្រាប់ ទំនិញ ចូល ទៅកាន់ ទីផ្សា រ សហភាពអឺរ៉ុ ប ( EU) នោះ បាន ចូលជា ធរមាន នៅថ្ងៃទី ១២ ខែសីហា ដោយ នៅ ពេល នេះ ផលិតផល កាត់ដេរ ផលិតផល ស្បែក ជើង និង សម្ភារៈ សម្រាប់ ការ ធ្វើ ដំណើរ ប្រមាណ ជា ២០ភាគរយ នឹង ត្រូវ ជាប់ កាតព្វកិច្ច បង់ពន្ធ។
សេចក្តីថ្លែងការណ៍នេះបាន ឲ្យដឹងថា៖ « សហភាពអឺរ៉ុប ចាប់ផ្តើម អនុវត្តវិធានការណ៍នេះ ស្របពេលនៅ រក្សាទំនាក់ទំនង ជាមួយ កម្ពុជា ជុំវិញ កំណែទម្រង់ចាំបាច់ នានា»។
សេចក្តី ថ្លែ ងការណ៍របស់សហភាពអឺរ៉ុប លើកឡើងថា៖ «សហភាពអឺរ៉ុប នឹង បន្ត ឃ្លាំមើល ស្ថានភាព ក្នុងប្រទេសនេះ ដោយ ផ្តោតការយក ចិត្ត ទុកដាក់ជា សំ ខាន់ លើការរឹតត្បិត លើ សេរីភាពនៃការ បញ្ចេញ មតិ និង សិទ្ធិ នយោ បា យនាពេលបច្ចុប្បន្ន ព្រមទាំង ជម្លោះដីធ្លីនិង សិទ្ធិ ការងារក្នុង បរិបទ នៃកំណែទម្រង់ ដែល កំពុង បន្តនេះ »។
លោក កុយ គួង បាន មាន ប្រសាសន៍ថា៖ « កន្លងមក យើង បាន ធ្វើការងារ ដើម្បី កែលម្អ និង លើកស្ទួយ សិទ្ធិ មនុស្ស និង លទ្ធិប្រជាធិបតេយ្យ ព្រមទាំង សិទ្ធិការ ងារ ក្នុងឋានៈ ជា រដ្ឋឯករាជ្យនិង មានអធិបតេយ្យ ភាព»។
លោក កុយ គួង បានមាន ប្រសាសន៍ថា៖ « បើទោះបីជា មាន ការ សម្រេចទាក់ទិន នឹងប្រព័ន្ធអនុគ្រោះពន្ធ EBA ក៏ដោយ ក៏រាជរដ្ឋាភិបាល កម្ពុជា នៅតែប្តេជ្ញាចិត្ត ខ្ពស់ក្នុងការ បន្ត លើកស្ទួយ និង កែលម្អស្ថានភាពសិទ្ធិមនុស្ស សិទ្ធិការងារនិង លទ្ធិប្រជាធិបតេយ្យ ក្នុងក្របខណ្ឌនៃរដ្ឋមានអធិបតេយ្យភាពនិងឯក រាជ្យពេញលេញ»។
លោក ហេង សួរ បាន មាន ប្រសាសន៍ថា៖ « ក្នុងឋានៈ ជា ប្រទេស ដែលមាន អធិបតេយ្យភាពនិង ឯករាជ្យ ពេញលេញ កម្ពុជា បំពេញយ៉ាងត្រឹមត្រូវ តាម គោលការណ៍ លទ្ធិប្រជាធិបតេយ្យ និង គោរព សិទ្ធិការងារ ដូចមាន ចែងក្នុង រដ្ឋធម្មនុញ្ញ ដោយ មិនចាំបាច់ មាន ប្រទេសណាមក រំឭកកម្ពុជា នោះទេ»។
លោក ហេង សួរ បានមាន ប្រសាសន៍ ថា៖ «ការដកផ្នែកខ្លះ នៃប្រព័ន្ធ EBA គឺគ្រាន់តែ ជា ផ្នែក តូច មួយ នៃ បញ្ហា ក្នុងដំណាក់កាលមានវិបត្តិកូវីដ១៩ ប៉ុណ្ណោះ ។ ប្រ ទេ សកម្ពុជា បារម្ភខ្លាំង អំពី ផលប៉ះពាល់ ដោយសារវីរុសកូវីដ ១៩ ពីព្រោះ … យើង ត្រូវ ប្រឈម នឹងកង្វះ វត្ថុធាតុដើម សម្រាប់វិស័យកាត់ដេរ ហើយ ដោយសារតែជំងឺនេះ យើង បារម្ភ ថា ចំនួន រោង ចក្រ ដែលត្រូវ បិទទ្វារ នឹង កើនឡើង ប៉ុន្តែយើង ស្ថិតនៅក្នុងតួលេខ មួយ ដែល អាច គ្រប់គ្រងបាន ខុស ពីការ វាយ តម្លៃ ពីដំបូង»។
លោក ហេង សួរ បាន មាន ប្រសាសន៍ថា៖ «កម្ពុជា ត្រូវ តែបន្ត នៅលើ វិថី នៃផែនការ សកម្មភាព កំណែទម្រង់របស់ខ្លួន ទាំង គោលនយោបាយ សេដ្ឋកិច្ច និង អភិបាល កិច្ច ដើម្បី រក្សា ភា ពប្រកួត ប្រជែង ដោយ មិន ពឹងផ្អែក ខ្លាំង លើ ប្រព័ន្ធ អនុ គ្រោះ ពន្ធ ដូចមុនទៀត»។
លិខិត នេះ លើកឡើង ថា រោងចក្រភាគច្រើន នៅកម្ពុជា កំពុងប្រតិបត្តិការដោយ កាត់បន្ថយ សមត្ថភាពផលិត ហើយ កម្មករ ជាង ១៣០.០០០ នាក់ បាន បាត់ បង់ ការងារ រួច ហើយ។
លោក មាន ប្រសាសន៍ថា៖ « ថ្ងៃនេះ យើងសោកស្តាយ ដែល ប្រទេសកម្ពុជា យើង មិន បានធ្វើកំណែ ទម្រង់ ទៅតាម លក្ខខណ្ឌដែល EU បាន ស្នើ ហើយ ធ្វើ ឲ្យ បាត់បង់ ប្រព័ន្ធអនុគ្រោះពន្ធនេះ ដូច្នេះវាគួរឲ្យ សោកស្តាយ សម្រាប់ ប្រទេសយើងទាំង មូល ផងដែរ»។
លោក ចន្ធូ បាន មាន ប្រសាសន៍ថា៖ « កម្មករយើងនឹងបាត់បង់ការងារនិងអត្ថប្រយោជន៍ច្រើន នាពេល អនាគត ដោយសារតែ ការសម្រេចដក EBA នេះ» ដោយ បានបន្ថែមថា សហព័ន្ធនិងសហជីព ជាង១០ រួម ទាំង FUFI ផងដែរ នឹង រៀប ចំសន្និសីទកាសែត មួយនៅថ្ងៃទី ១៤ ខែសីហា អំពីផែន ការ របស់ ខ្លួន ។
អ្នក នាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម មិន អាចទាក់ទង សុំការអត្ថាធិប្បាយបានទេ៕
ព្រះរាជាអាជ្ញាកាន់សំណុំរឿងក្បត់ជាតិប្រឆាំងលោក កឹម សុខា ក្នុងសវនាការនៅថ្ងៃពុធនេះបានដាក់ភស្តុតាងថ្មីដែលមេធាវីការពារក្តីឱ្យអតីតមេបក្សជំទាស់រូបនេះជំរុញឱ្យចៅក្រមបដិសេធដោយថាការដាក់ភស្តុតាងនោះគ្រាន់តែដើម្បីពន្យាពេលសវនាការ ហើយបង្ហាញថាព្រះរាជអាជ្ញាមិនមានភស្តុតាងគ្រប់គ្រាន់ដើម្បីដាក់បន្ទុកការចោទប្រកាន់របស់ខ្លួន។
លោក ហូ វ៉ាន់ មិនបាននិយាយពីឈ្មោះលោក កឹម សុខា នៅក្នុងកិច្ចសន្ទនានោះទេ ប៉ុន្តែព្រះរាជអាជ្ញាបាននិយាយថា ដោយសារលោក កឹម សុខា ជាប្រធានគណបក្សសង្គ្រោះជាតិនៅពេលនោះ ហើយលោក វ៉ាន់ ជាសហការី នោះបង្ហាញថា លោកបានជាប់ពាក់ព័ន្ធការធ្វើបាតុកម្មនៅទីលានប្រជាធិបតេយ្យ និងបាតុកម្មកន្លែងផ្សែងៗទៀត។
ប៉ុន្តែ លោក កឹម សុខា បាននិយាយទៅកាន់តុលាការថា លោកទទួលខុសត្រូវចំពោះបាតុកម្មនៅទីលានប្រជាធិបតេយ្យដែលទាមទារឱ្យបង្កើតគណៈកម្មាធិការឯករាជ្យមួយដើម្បីស៊ើបអង្កេតភាពមិនប្រក្រតីក្នុងការបោះឆ្នោតឆ្នាំ ២០១៣ តែប៉ុណ្ណោះ។
លោក កឹម សុខា ថា លោក មិន មែន ជា អ្នក សន្ទនា តាម ទូរស័ព្ទ ជាមួយ លោក ហូ វ៉ាន់ នោះ ទេ ហើយ ថា ភស្តុតាង ថ្មី នេះ គ្រាន់ តែ ចង់ អូសបន្លាយពេល សវនាការលោក ប៉ុណ្ណោះ។
លោក កឹម សុខា បានបន្តថា៖ «វាបង្ហាញឲ្យចេតនាច្បាស់ណាស់ថា(ព្រះរាជអាជ្ញា)មិនចង់បញ្ចប់រឿងក្តីនេះ» ដោយលោកបន្ថែមថាលោក ហូ វ៉ាន់ ខ្លួនឯងផ្ទាល់ត្រូវបានតុលាការកាត់ទោសកំបាំងមុខរួចទៅហើយដែរ។
អ្នកស្រី ម៉េង សុធារី សហមេធាវីការពារក្តីលោក កឹម សុខា បានស្នើឱ្យប្រធានចៅក្រមជំនុំជម្រះបដិសេធភស្តុតាងបន្ថែម ដោយនិយាយថាការសន្ទនារបស់លោក ហូ វ៉ាន់ បានកើតឡើងនៅខែមិថុនា ឆ្នាំ២០២២នេះ ប៉ុណ្ណោះ ដែលវាហួសពីវិសាលភាពនៃសំណុំរឿងនេះទៅហើយ។
ភ្លាមៗបន្ទាប់ពីការចាប់ខ្លួនលោក កឹម សុខា គណបក្សសង្រ្គោះជាតិត្រូវបានរំលាយដោយតុលាការកំពូល ហើយសមាជិកបក្សជាច្រើននាក់ត្រូវបានចាប់ខ្លួនលើបទចោទដែលគេជឿថាពាក់ព័ន្ធនឹងនយោបាយ។
បន្ទាប់ពីការពន្យារពេលជាច្រើនឆ្នាំ ការកាត់ក្តីលោក កឹម សុខា បានបន្តឡើងវិញកាលពីខែមករា ឆ្នាំ២០២២ ដោយសវនាការធ្វើឡើងម្តងក្នុងមួយសប្តាហ៍នាថ្ងៃពុធ។
លោក បាន លើកឡើង ថា៖ «ខ្ញុំ គិត ថា វា ជា តុលាការ នយោបាយ ព្រោះ មាន សវនាការ ចំនួន ៥២ដង រហូត មក ដល់ ពេល នេះ… ហើយ ព្រះរាជអាជ្ញា នៅ តែ ប្រមូល ភស្តុតាង បន្ថែម ទៀត»។
ប្រធានចៅក្រមជំនុំជម្រះ លោក កូយ សៅ មានប្រសាសន៍ថាលោកនឹងធ្វើសេចក្តីសម្រេចនៅថ្ងៃពុធសប្តាហ៍ក្រោយថាតើត្រូវទទួលយកឬបដិសេធភស្តុតាងថ្មីនោះ។
លោក ក៏ បាន រិះគន់សវនាការកាត់ក្តីលោក កឹម សុខា ដែលអូសបន្លាយយូរផងដែរ។
អ្នកបើកម៉ូតូបង្ហាញលិខិតលើកលែងផ្លូវការ ដល់នគរបាលរាជធានីភ្នំពេញ ក្នុងកំឡុងពេលអនុវត្តបំរាមគោចរចាប់ពីម៉ោង៨យប់ដល់ម៉ោង៥ព្រឹក ថ្ងៃទី១ ខែមេសាឆ្នាំ ២០២១។ រូបភាព៖ បញ្ញា ឆព័ណ្ណ
ក្នុងលិខិតផ្ញើជូនរដ្ឋាភិបាលកម្ពុជា ដែលបានផ្សព្វផ្សាយ ជាសាធារណៈ កាលពីចុងសប្តាហ៍មុន លោកស្រី រ៉ូណា ស្មីត អ្នករាយការណ៍ពិសេសផ្នែក សិទ្ធិមនុស្សបានលើក ឡើងពីកង្វល់ជាមួយនឹងបទប្បញ្ញត្តិនានានៅក្នុងច្បាប់ថ្មី ដែលផ្តល់អំណាចដល់រដ្ឋាភិបាលក្នុងការ «រឹតត្បិតឬហាមឃាត់ការធ្វើដំណើរ ការជួបជុំនិងការប្រមូលផ្តុំផ្សេងៗ និង រឹតត្បិតប្រតិបត្តិការអាជីវកម្ម ជាក់លាក់ ឬសកម្មភាពអាជីពមួយចំនួន»។
លិខិតនេះបានកត់សម្គាល់ថា៖ «ការដាក់ចេញនូវវិធានការ សុខភាពសាធារណៈ និងវិធានការផ្សេងទៀត ក្នុងគ្រាអាសន្ន ផ្នែកសុខភាពគួរតែ សំដៅដល់ការ ការពារសុខភាពសាធារណៈទាំងមូល ដែលផ្ទុយពីការទប់ស្កាត់ការរីករាលដាល»។ ដោយបានបន្ថែមថា«ទិសដៅបែបចង្អៀតនេះ អាចនាំឲ្យមានការមើល រំលងផលប៉ះពាល់សុខភាព ដោយផ្ទាល់និងដោយ ប្រយោលនៃវិធានការណ៍រឹតត្បិត ជាពិសេសវាទាក់ទងនឹងក្រុមមនុស្សទន់ខ្សោយនិងងាយរងគ្រោះ»។
សមាជិកសភាបានលើកយកសេចក្ដីព្រាងច្បាប់នៅថ្ងៃទី២៨ខែកុម្ភៈដែលនិយាយអំពីវិធានការទប់ស្កាត់ជំងឺកូវីដ-១៩ ប៉ុន្តែក៏មាននិយាយពីជំងឺឆ្លងជាទូទៅផងដែរ។ ត្រឹមថ្ងៃទី១១ខែមីនា ជាថ្ងៃដែលប្រទេសកម្ពុជា បានរាយការណ៍ ផ្លូវការពីករណីស្លាប់ ជាលើកដំបូងដោយសារជំងឺកូវីដ-១៩ សេចក្តីព្រាងច្បាប់នេះ បានឆ្លងកាត់ដំណើរ ការនីតិប្បញ្ញត្តិចាំបាច់ ដើម្បីក្លាយជាច្បាប់រួចទៅហើយ។
យោងតាមបទបញ្ជាបំរាមគោចរ ដែលបានចេញដោយអភិបាលរាជធានីភ្នំពេញលោក ឃួង ស្រេង នៅថ្ងៃទី១ខែមេសានេះ អាជីវកម្មរួមមានភោជនីយដ្ឋាន ហាងកាហ្វេ និងហាងលក់ភេសជ្ជៈ មិនត្រូវបានអនុញ្ញាតឱ្យទទួលអតិថិជន នៅនឹងកន្លែង ក្នុងអំឡុងរយៈពេលកំណត់ ដែលចាប់ពីម៉ោង៨ល្ងាចដល់ម៉ោង៥ព្រឹក។
លោក សាន សុខសីហា អ្នកនាំពាក្យស្នងការនគរបាលរាជធានីភ្នំពេញបានឲ្យដឹងថា ក្នុងរយៈពេល៣យប់ដំបូងនៃការអនុវត្តបំរាមគោចរចាប់ពីថ្ងៃទី២-៤ខែមេសា អាជ្ញា ធរបានរឹបអូសម៉ូតូចំនួន១៣៨គ្រឿងនិងរថយន្តចំនួន២៧គ្រឿងផ្សេងទៀត។ អ្នកដែលល្មើសបម្រាមគោចរអាចត្រូវបានដាក់ឲ្យធ្វើចត្តាឡីស័ករយៈពេល១៤ថ្ងៃនៅផ្ទះរបស់ខ្លួន។ លោក សុខសីហា មិនបានបញ្ជាក់លម្អិតទេ។
លោក ម៉ាលីន បានបន្តថា ច្បាប់ស្តីពីវិធានការទប់ស្កាត់ជំងឺ-១៩ ឆ្លើយតប ទៅនឹងស្ថានភាពធ្ងន់ធ្ងរនៅក្នុងប្រទេសនិងអនុលោមតាមរដ្ឋធម្មនុញ្ញកម្ពុជានិងកតិកា សញ្ញាអន្តរជាតិដូចជាច្បាប់ដែលលោកស្រី ស្មីត បានលើកឡើងដែរ។
លោក ម៉ាលីន បានទទួលស្គាល់ថា ច្បាប់ស្តីពីវិធានការប្រឆាំងជំងឺកូវីដ-១៩ មិនមានការពិគ្រោះយោបល់ទូលំទូលាយជាសាធារណៈទេ ប៉ុន្តែបានលើកឡើងជាថ្មីទៀតអំពី «ស្ថានភាពបន្ទាន់ក្នុងការឆ្លើយតបចំពោះប្រជាជន ដែលកំពុងប្រឈមនឹងការឆ្លងនិងការស្លាប់ដោយសារជំងឺកូវីដ-១៩»។
ពួកគេក៏បានលើកឡើងផងដែរថា លក្ខខណ្ឌនៅក្នុងច្បាប់នេះ មិនបានកំណត់ច្បាស់ លាស់ គ្មានដែនកំណត់ នៃរយៈពេលនៃវិធានការរឹតត្បិត និងអនុវត្តការដាក់ទណ្ឌកម្ម ដោយគ្មានទំនាក់ទំនងជាក់ស្តែងទៅនឹងសុខភាពសាធារណៈ។
លិខិតដដែលនេះបន្តថា៖ «យើងទទូចឲ្យរដ្ឋាភិបាល ពិនិត្យមើលច្បាប់នេះ ឡើងវិញ ធ្វើឱ្យស្របតាមស្តង់ដារ សិទ្ធិមនុស្សអន្តរជាតិ ដែលការពារសិទ្ធិ និងសេរីភាព របស់ប្រជាជនកម្ពុជា» ដោយទទូចឲ្យរដ្ឋាភិបាល ចាត់វិធានការបណ្តោះអាសន្ន ចាំបាច់នានាដើម្បី «បញ្ឈប់ការរំលោភបំពាននិងទប់ស្កាត់ មិនឲ្យកើតឡើងម្តងទៀត»។
លោក មាជ សុវណ្ណារ៉ា អតីតមន្រ្តីជាន់ខ្ពស់នៃគណបក្សសង្គ្រោះជាតិ ដែលត្រូវតុលាការកំពូលរំលាយចោលនោះបានមានប្រសាសន៍ថា ដំណើរការនៃការសរសេរច្បាប់ដោយគ្មានតម្លាភាពឬធាតុចូលពីអ្នកពាក់ព័ន្ធទាំងអស់ ជាពិសេសក្រុមសង្គមស៊ី វិល បានមើលរំលងផលប៉ះពាល់ ទូលំទូលាយនៃច្បាប់ ដែលមានលក្ខណៈរឹតត្បិតលើការរស់នៅរបស់ប្រជាពលរដ្ឋកម្ពុជា។
រហូតមកដល់ពេលនេះ មានមនុស្សចំនួន២១នាក់បានស្លាប់ដោយសារជំងឺនេះ។ ប្រ ទេសកម្ពុជាបានកត់ត្រាករណីឆ្លងជំងឺកូវីដ-១៩សរុបមានចំនួន២.៧៥២ករណីចាប់ តាំងពីចាប់ផ្តើមការរាតត្បាតនៅដើមឆ្នាំ២០២០មក៕
មន្ត្រីជាន់ខ្ពស់អាមេរិកជំរុញឱ្យរដ្ឋាភិបាលទម្លាក់ការចោទប្រកាន់លើសមាជិកបក្សប្រឆាំង
លោកស្រី Wendy Sherman ជាអនុរដ្ឋមន្ត្រីក្រសួងការបរទេសសហរដ្ឋអាមេរិកបានអំពាវនាវឱ្យរដ្ឋាភិបាលកម្ពុជាទម្លាក់ចោលនូវអ្វី ដែលលោកស្រីបានហៅថា ជាការចោទប្រកាន់ដោយហេតុផលនយោបាយមកលើក្រុមសកម្មជន អ្នកកាសែត និង សមាជិកនៃគណបក្សសង្គ្រោះជាតិ (CNRP) និងដើម្បីបើកលំហនយោបាយនៅមុនការបោះឆ្នោតឃុំសង្កាត់និងថ្នាក់ជាតិនាងពេលខាងមុខ។
លោក កឹម សុខា អតីតប្រធានគណបក្សសង្គ្រោះជាតិ ដែលជាគណបក្សប្រឆាំងធំតែមួយគត់ ដែលត្រូវបានតុលាការកំពូលរំលាយកាលពីឆ្នាំ២០១៧ ដោយចោទប្រកាន់ពីបទសមគំនិតជាមួយមហាអំណាចបរទេស ដែលតាមចោទថា បានចូលដៃជាមួយសហរដ្ឋអាមេរិក ដើម្បីផ្តួលរំលំរដ្ឋាភិបាល។ លោក កឹម សុខា បានអះអាងថា លោកគ្រាន់តែធ្វើសកម្មភាពត្រឹមត្រូវតាមច្បាប់និងតម្លាភាព ដើម្បីព្យាយាមឈ្នះការបោះឆ្នោត។ ការជំនុំជម្រះក្តីកំពុងបន្តនៅសាលាដំបូងរាជធានីភ្នំពេញ។
សេចក្តីថ្លែងការណ៍នេះ បានលើកឡើងថា មូលដ្ឋានយោធាចិននៅកម្ពុជាដែលត្រូវបានហាមឃាត់នៅក្រោមច្បាប់រដ្ឋធម្មនុញ្ញរបស់ប្រទេសកម្ពុជា នឹង«ធ្វើឱ្យអន្តរាយដល់អធិបតេយ្យភាពរបស់កម្ពុជា គំរាមកំហែងដល់សន្តិសុខក្នុងតំបន់និងមានប៉ះពាល់អវិជ្ជមានដល់ទំនាក់ទំនងរវាងសហរដ្ឋអាមេរិកនិងកម្ពុជា»។
លោក អំ សំអាត អនុប្រធានផ្នែកឃ្លាំមើលនៅអង្គការសិទ្ធិមនុស្សលីកាដូបានស្វា គមន៍ការអំពាវនាវរបស់សហរដ្ឋអាមេរិកឲ្យរដ្ឋាភិបាលទម្លាក់ចោលរាល់បទចោទ ប្រកាន់លើអ្នកជាប់ឃុំ ដែលត្រូវបានចាប់ខ្លួនក្នុងហេតុផលនយោបាយក៏ដូចជាការ បញ្ឈប់ការបង្ក្រាបលើសង្គមស៊ីវិលនិងសេរីភាពនៃការបញ្ចេញមតិ។
លោកស្រីបាននិយាយថា៖ «យើងសង្ឃឹមថា គាត់នឹងជួយដោះស្រាយស្ថាន ការណ៍នយោបាយ ជាពិសេសអ្នកដែលកំពុងជាប់ក្នុងពន្ធនាគារដោយសារតែការចោទប្រកាន់ក្រោមហេតុផលនយោបាយ ហើយដែលគ្មានកំហុស។ ពួកគេ ជាប្រទេសម្ចាស់ជំនួយ ហើយពួកគេបានផ្តល់ជំនួយមនុស្សធម៌ដល់ប្រទេសកម្ពុជា ពួកគេនឹងជួយឬដាក់សម្ពាធលើរដ្ឋាភិបាលបច្ចុប្បន្ន»។
លោកនាយករដ្ឋមន្រ្តី ហ៊ុន សែន បានជួបជាមួយគណៈប្រតិភូសហរដ្ឋអាមេរិកដឹកនាំដោយអនុរដ្ឋមន្ត្រីការបរទេស Wendy Sherman នៅវិមានសន្តិភាពរាជ ធានីភ្នំពេញកាលពីថ្ងៃទី១ ខែមិថុនា ឆ្នាំ២០២១។ រូបថតបង្ហោះនៅលើទំព័រហ្វេស ប៊ុករបស់លោកនាយករដ្ឋមន្ត្រី។
លោកបានមានប្រសាសន៍ថា៖ «ខ្ញុំគិតថា វាមិនអាចធ្វើឱ្យរដ្ឋាភិបាលផ្លាស់ប្តូរឥរិ យាបថរបស់ខ្លួននៅក្នុងកាលៈទេសៈទាំងនេះទេ»។ ដោយលោកបន្ថែមថា៖ «រដ្ឋាភិបាលនិងមេដឹកនាំគណបក្សប្រជាជនកម្ពុជាបច្ចុប្បន្នគ្មានជំហរបន្ទន់ ឥរិយាបថរបស់ខ្លួននិងបាត់បង់អំណាចរបស់ខ្លួនឡើយ»។
លោកមានប្រសាសន៍ថា៖ «ខ្ញុំជឿជាក់ថា រដ្ឋាភិបាលកម្ពុជានិងតុលាការនឹងពិចារ ណាលើបញ្ហាទាំងនេះ»។
លោកបានមានប្រសាសន៍ថា៖ «កម្ពុជាគួរតែបង្ហាញជំហរច្បាស់លាស់របស់ខ្លួន បើមិនដូច្នេះទេ ប្រទេសនេះអាចប្រឈមនឹងឧបសគ្គយ៉ាងធំចំពោះគោលនយោ បាយការបរទេសរបស់ខ្លួនជាមួយសហរដ្ឋអាមេរិកនិងបណ្តាប្រទេសលោកខាង លិច»។ ដោយលោកបន្ថែមថា៖ «ជាទូទៅ ប្រទេសកម្ពុជាត្រូវការការគាំទ្រពីបណ្តាប្រទេសលោកខាងលិចច្រើនជាងប្រទេសចិន ដូចជាវិស័យពាណិជ្ជកម្ម ដូច្នេះការព្រួយបារម្ភណាមួយដែលលើកឡើងដោយប្រទេសលោកខាងលិច រួមទាំងសហរដ្ឋអាមេរិកផង មិនគួរព្រងើយកន្តើយឡើយ»។
លោកបានមានប្រសាសន៍ថា៖ «នៅពេលដែលប្រទេសកម្ពុជាកាន់តួនាទីជាប្រ ធានអាស៊ានក្នុងឆ្នាំ២០១២ ប្រទេសកម្ពុជាបានឈរនៅខាងចិនទាក់ទងនឹងសមុទ្រចិនខាងត្បូង។ ជាថ្មីម្តងទៀត នៅឆ្នាំ២០២២ សហរដ្ឋអាមេរិកនិងបណ្តាប្រទេសលោកខាងលិចក៏មានការព្រួយបារម្ភផងដែរជុំវិញជំហររបស់ប្រទេសកម្ពុជា ខណៈបច្ចុប្បន្ននេះ ប្រទេសនេះបានបង្ហាញយ៉ាងច្បាស់រួចហើយថា ខ្លួនឈរជាមួយប្រទេសចិន»៕
រោងចក្រកាត់ដេរដូចជានៅខេត្តកណ្តាល ជាសសរស្តម្ភ សម្រាប់កំណើនសេដ្ឋកិច្ច របស់ប្រទេសកម្ពុជា មុនពេលមានការរាតត្បាត។ រូបភាពថតក្នុងខែធ្នូ ឆ្នាំ២០១៨។ខេមបូចា/ ព្រីង សំរាំង
របាយការណ៍របស់ធនាគារអភិវឌ្ឍន៍អាស៊ីបានព្យាករថា សេដ្ឋកិច្ចជាតិក្នុងឆ្នាំនេះ នឹង មានកំណើន៤ភាគរយ។ ប៉ុន្តែនៅពេលនេះ អ្នកជំនាញបាននិយាយថា វាចាំបាច់ត្រូវរង់ចាំមើលស្ថានការណ៍បិទខ្ទប់ដែលកំពុងបន្តនេះ ហើយដែលបានធ្វើឲ្យឧស្សាហកម្មធំៗ ផ្អាកសកម្មភាពនៅ មជ្ឈមណ្ឌលសេដ្ឋកិច្ច របស់ប្រទេសនេះ មុនពេលធ្វើការវាយតម្លៃឲ្យបានត្រឹមត្រូវ។
កាលពីថ្ងៃចន្ទ រដ្ឋាភិបាលបានប្រកាសពន្យារការបិទខ្ទប់មួយសប្តាហ៍បន្ថែមទៀត ដែលវិធានការណ៍បិទខ្ទប់នេះបានចាប់ផ្តើមតាំងពីយប់ថ្ងៃទី១៥ ខែមេសា មកម៉្លេះ។ ទោះបីជាគេពិបាកនិយាយថា នឹងមានអ្វីកើតឡើងបន្ទាប់ ការព្យាករ របស់ធនាគារ អភិវឌ្ឍន៍អាស៊ីក៏បានបញ្ជាក់បន្ថែមទៀតផងដែរថា កំណើន នេះនឹង ត្រូវវិល ត្រឡប់ មកវិញ។
លោកស្រីបានបន្តថា៖ «ហានិភ័យសំខាន់ៗចំពោះទស្សនវិស័យនេះ រួមមានការឆ្លងរីករាលដាលជំងឺកូវីដ-១៩ក្នុងសហគមន៍ទូលំទូលាយ កំណើន យឺតជាងការរំពឹងទុកសម្រាប់ដៃគូពាណិជ្ជកម្មធំៗរបស់កម្ពុជា ដូចជាសហរដ្ឋអាមេរិក និងសហភាពអឺរ៉ុប ការបន្តភាពទន់ខ្សោយ នៅក្នុងតម្រូវការ ក្នុងស្រុកនិង ភាពតាន តឹងលើសេវាកម្មហិរញ្ញ វត្ថុនិងធនាគារ»។ «រដ្ឋាភិបាលចាំបាច់ត្រូវរក្សាជំហរ គោលនយោបាយសារពើពន្ធសម្របសម្រួលរបស់ខ្លួននៅឆ្នាំនេះនិងឆ្នាំបន្ទាប់ ដើម្បីគាំទ្រកំណើនសេដ្ឋកិច្ច»។
ធនាគារអភិវឌ្ឍន៍អាស៊ីបានលើកឡើងថា វិធានការណ៍សង្គ្រោះក្នុងរយៈពេលខ្លីទាំង នេះ អាចមានឥទ្ធិពលយូរអង្វែង។ របាយការណ៍បាន លើកឡើងថា៖ «យុទ្ធសាស្រ្តទាំង នេះបានកាត់បន្ថយការប្រើប្រាស់ប្រចាំគ្រួសាររួចទៅហើយ ហើយអាចមានផលប៉ះពាល់យូរអង្វែងទៅលើសុខុមាលភាព ផលិតភាព ប្រសិនបើវានៅតែបន្តដល់ឆ្នាំ ២០២១»។
កាលពីល្ងាចថ្ងៃចន្ទ រដ្ឋាភិបាលបានប្រកាសថា ខ្លួននឹងពន្យារការបិទខ្ទប់ដល់ថ្ងៃទី៥ ខែឧសភានៅទីក្រុងភ្នំពេញនិងក្រុងតាខ្មៅនៃខេត្តកណ្តាល ដើម្បីទប់ស្កាត់ការរីករាល ដាលជំងឺកូវីដ-១៩ ។ ក្នុងសេចក្តីជូនដំណឹងថ្មីស្តីពីការបិទខ្ទប់ រដ្ឋាភិបាលបានពង្រីកតំបន់ក្រហម និង កំណត់តំបន់ផ្សេងទៀតមាន ពណ៌លឿងទុំ និងពណ៌លឿង។
លោក Hiroshi Suzuki ប្រធានសេដ្ឋវិទូនៅវិទ្យាស្ថានស្រាវជ្រាវសេដ្ឋកិច្ចកម្ពុជា (BRIC) បានមានប្រសាសន៍ថា ការបិទខ្ទប់នេះអាចជះឥទ្ធិពលអវិជ្ជមានដល់អត្រា កំណើន ឆ្នាំ២០២១ ប៉ុន្តែក៏បានចង្អុលបង្ហាញពីកត្តាសកល ក្រៅពីការគ្រប់គ្រង របស់កម្ពុជា ផងដែរ ។
លោក Suzuki បន្តថា សាច់ប្រាក់ដែលផ្តល់ជូនដល់ ក្រុមគ្រួសារងាយរងគ្រោះ និងក្រីក្រ គឺជាវិធានការណ៍ដ៏ល្អមួយ ដើម្បីកាត់បន្ថយផលប៉ះពាល់ នៃការឆ្លងរាលដាល។ ការជំនួយដល់សហគ្រាសធុនតូច និងមធ្យម ក៏ចាំបាច់ផងដែរ ដែលមិនត្រឹមតែ ដើម្បីទប់ស្កាត់ផលប៉ះពាល់ដ៏អាក្រក់បំផុតប៉ុណ្ណោះទេ ប៉ុន្តែថែមទាំងជួយ ជំរុញដល់សេដ្ឋកិច្ចនិងចាប់ផ្តើមការងើបឡើងវិញផងដែរ។
លោក មាស សុខសេនសាន អ្នកនាំពាក្យក្រសួងសេដ្ឋកិច្ចនិងហិរញ្ញវត្ថុបានមានប្រ សាសន៍ថា ក្នុងរយៈពេលដ៏លំបាកសម្រាប់ផលិតកម្ម និងការនាំចេញ រដ្ឋាភិបាលមិន ទាន់បានធ្វើការកែប្រែការព្យាករណ៍កន្លងមកពីកំណើន៤ភាគរយនៅក្នុងឆ្នាំ២០២១ នៅឡើយទេ។ លោកថ្លែងថា លោក នាយករដ្ឋមន្រ្តី ហ៊ុន សែន នឹងដាក់ចេញនូវ ផែនការស្តារសេដ្ឋកិច្ចថ្មីមួយ ដើម្បីឆ្លើយតបនឹងកាលៈទេសៈបច្ចុប្បន្ន។
ធនាគារអភិវឌ្ឍន៍អាស៊ីបានព្យាករណ៍ថា ផលិតកម្មឧស្សាហកម្ម នឹងមានកំណើនខ្លាំង ដោយកើនឡើង៧,១ភាគរយនៅឆ្នាំ២០២១នេះ និង៧,០ ភាគរយនៅឆ្នាំ២០២២ ដែលជំរុញដោយវិស័យកាត់ដេរសម្លៀកបំពាក់ ស្បែកជើងនិងសម្ភារៈធ្វើដំណើរក៏ដូច ជាកំណើនផលិតកម្មធុនស្រាល។
ធនាគារអភិវឌ្ឍន៍អាស៊ីជឿជាក់ថា ផលិតផលសេវាកម្មនឹងងើបឡើងវិញយឺតៗ ដោយ សម្រេចបានកំណើន៣,៣ភាគរយក្នុងឆ្នាំ២០២១ និង៦,២ភាគរយនៅឆ្នាំ២០២២ នៅពេលការរឹតបន្តឹងការធ្វើដំណើរធូរស្រាល។ វិស័យអចលនទ្រព្យត្រូវបានគេរំពឹងថា នឹងងើបឡើងវិញជាបណ្តើរៗ ពីការធ្លាក់ចុះ កាលពីឆ្នាំមុន ស្របតាមនិន្នាការស្រដៀងគ្នាសម្រាប់ឧស្សាហកម្មសំណង់ដែរ។
លោកបន្តថា សេវាកម្មទេសចរណ៍ ដែលពឹងផ្អែកលើភ្ញៀវទេសចរអន្តរជាតិ បានស្លាប់ អស់រយៈពេលមួយឆ្នាំហើយ ហើយមិនទំនងជាវិលត្រឡប់មកវិញនៅចុងឆ្នាំនេះទេ។ លោកបន្តថា កម្មករដែលត្រូវបានបញ្ឈប់ពីការងារបានស្វែង រកការងារផ្សេងទៀតរួច ទៅហើយ។
លោក សុផល បន្ថែមថា ដើម្បីជួយដល់ការងើបឡើងវិញនៃវិស័យសេដ្ឋកិច្ចក្រោយ វិបត្តិកូវីដ បរិយាកាសពាណិជ្ជកម្ម និងការសម្របសម្រួលពាណិជ្ជកម្ម គួរតែត្រូវបាន កែលម្អឆាប់ជាងនេះនិងហ្មត់ចត់ជាងពេលមុនៗ។
អ្នកស្រីបាននិយាយថា៖ «ខ្ញុំ មាន ភ័យបារម្ភពី កូន ខ្ញុំណាស់ បន្ទាប់ ពី បាន ទទួល ដំណឹង ហ្នឹង។ ខ្ញុំ បារម្ភ វា នឹង ប៉ះពាល់ ដល់ សុខភាព កូន ខ្ញុំ ព្រោះ ខ្ញុំ បាន ប្រើ វា ជិត ពីរ ឆ្នាំ ហើយ»។
អ្នកស្រីបានបន្ត ថា ៖« ប្រជាជន រំពឹង លើ ក្រសួងហ្នឹងហើយ បើ អនុញ្ញាត ឱ្យ នាំ ចូល បាន ន័យ ថា មាន ការ ត្រួត ពិនិត្យ ត្រឹមត្រូវ។ ពួកគាត់ដូចជាមានការធ្វេសប្រហែសត្រួតពិនិត្យផលិតផលនាំចូល»។
កញ្ញាបាននិយាយថា៖ «ខ្ញុំប្រើម្សៅនេះជាមួយគ្រួសារខ្ញុំ។ ខ្ញុំ ខ្លាច ថា វា អត់ ឈឺ ឥឡូវ នេះ ប៉ុន្តែ វា នឹង ប៉ះពាល់ ដល់ ខ្ញុំ ទៅ ថ្ងៃ អនាគត»។
ប៉ុន្តែលោកបានបញ្ជាក់បន្ថែមថា អ្នក ប្រើ ម្សៅលាបខ្លួន ទារកនិងកុមារ អាច នឹង ប្រឈមខ្លាំង បន្ទាប់ ពី បាន ប្រើ ម្សៅ អស់ រយៈពេល ប្រាំ ឆ្នាំ ឬ លើសពី នេះ ។
លោក បាន បន្ត ថា ៖ « ម្សៅ លាបខ្លួនទារក ទាំងអស់ ដែល អាច មាន សារធាតុ អាសបេស្តុស ត្រូវ បាន បញ្ជា ឱ្យ ប្រមូល មក វិញ ពី ទីផ្សារ ដោយ អ្នក នាំចូលនិង អ្នក ចែកចាយ » ។
ពលរដ្ឋស្រុកបន្ទាយស្រីធ្វើការតវ៉ានៅខាងក្រៅសាលាខេត្តសៀមរាបកាលពីថ្ងៃចន្ទ ដោយស្នើឲ្យមានដំណោះស្រាយសមស្របចំពោះវិវាទដីធ្លី ដែលមានតាំងពីឆ្នាំ ២០០៥មក ជាមួយនឹងអាជ្ញាធរជាតិអប្សរា។ ខេមបូចា/ បញ្ញា ឆព័ណ្ណ
អ្នក ភូមិ ប្រមាណ ៤០ នាក់ មក ពី២១ គ្រួសារ បាន ធ្វើការ តវ៉ា នៅ ខាង ក្រៅ រដ្ឋបាល ខេត្ត សៀមរាប ដោយ បដិសេធ មិន ទទួល សំណង របស់ អាជ្ញាធរ អប្សរា នូវ ដី ទំហំ ២០ x៣០ ម៉ែត្រ នៅ ក្នុង ឃុំ តែ មួយ ដែល ពួកគេ កំពុង ស្នាក់ នៅ។ អ្នក ភូមិ និយាយ ថា ពួកគេ កំពុង រស់ នៅ លើ ដី ធំ ជាង នេះ និងមាន ដីស្រែ របស់ ខ្លួន។
លោក ហ៊ន់ រ៉ាវុធ អាយុ ៤០ ឆ្នាំ ជា ពលរដ្ឋ ម្នាក់ ដែល បាន ធ្វើការ តវ៉ា កាល ពី ថ្ងៃ ចន្ទ ហើយ កំពុង ប្រឈម នឹង ការ បាត់បង់ ដី ចំនួន ១,៥ ហិចតា ប្រសិន បើ អាជ្ញាធរ អប្សរាធ្វើតាម សេចក្តី បង្គាប់។ លោក បាន និយាយ ថា ដី នោះ ជា កេរ្តិ៍ បន្សល់ ទុក និង មាន សារៈសំខាន់ សម្រាប់ រូបលោក ធ្វើ កសិកម្ម ដើម្បី ជីវភាព។
វា តូច ខ្លាំង ណាស់ បើ ប្រៀប ជាមួយ នឹង ដី យើង នា ពេល បច្ចុប្បន្ន»។
លោក បាន លើកឡើង ថា លោក បដិសេធ មិន ទទួល សំណង ពី អាជ្ញាធរ អប្សរា ក្នុង ការ ទិញ ដី ក្នុង តម្លៃ ៥០០ ទៅ៧០០ ដុល្លារ ក្នុង មួយ ហិចតា ក៏ដូចជា ដំណោះស្រាយ មួយ ទៀត ដែល តម្រូវ ឲ្យ លោក ផ្លាស់ ទៅ ឃុំ ត្បែង ក្នុង ស្រុក ដូចគ្នា ជា ទី ដែល មិនមាន ដី ល្អ សម្រាប់ កសិកម្ម។
មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា ដែល បាន ផ្តោត លើ ជម្លោះ ដីធ្លី នេះ និយាយ ថា ខណៈ អាជ្ញាធរ អប្សរា បាន ធ្វើការ សន្យា ជា ពាក្យ សម្តី ក្នុង ការ ផ្តល់ ឲ្យ អ្នកភូមិ នូវ សំណង ៥០០ ទៅ ៧០០ ដុល្លារ ក៏ ដោយ អ្នក ភូមិ មួយ ចំនួន បាន ផ្តិត មេដៃ លើ ឯកសារ ដែល មាន សំណង តិច ជាង អ្វី ដែល បាន សន្យា។
លោក ឡុង កុសល អ្នកនាំពាក្យ អាជ្ញាធរ អប្សរា បាន និយាយ ថា អាជ្ញាធរ បាន ចរចា ជាមួយ នឹង អ្នកភូមិ ជា ច្រើន លើក ដោយ សុំ ទិញ ដី ឬ ស្នើ ឲ្យ ផ្លាស់ទី ទៅ ទីតាំង ថ្មី ប៉ុន្តែ អ្នក ភូមិ បាន បដិសេធ ជម្រើស សំណង ទាំងពីរ។
លោក បាន ថ្លែង ថា៖ «ប្រសិន បើ អាជ្ញាធរ ចាត់វិធានការ ផ្លូវ ច្បាប់ ខ្ញុំ នឹង តតាំង ហើយ ដាក់ ពាក្យ បណ្តឹង ទៅ តុលាការ ពីព្រោះ ខ្ញុំ រស់នៅ លើ ដី នេះ ជា យូរ មក ហើយ។ ប្រសិន បើ ពួកគេ ចង់ បាន ដី ខ្ញុំ សូម ឲ្យ ច្បាប់ សម្រេច តាម ហ្នឹង ចុះ»។
ការអនុវត្តច្រកទ្វារអ៊ីនធឺណិតជាតិដ៏ចម្រូងចម្រាសត្រូវបានពន្យារពេល។ នេះបើតាមការបញ្ជាក់កាលពីថ្ងៃអង្គារពីមន្ត្រីរបស់ក្រសួងដែលគ្រប់គ្រងការអនុវត្តគម្រោងនេះ។
ចាប់តាំងពីការប្រកាសដំបូង អនុក្រឹត្យនេះបានទទួលការរិះគន់ពីក្រុមសង្គមស៊ីវិលក្នុងស្រុក និងអន្តរជាតិ ជុំវិញការព្រួយបារម្ភដែលថាវានឹងត្រូវប្រើដើម្បីតាមដានការបញ្ចេញមតិតាមអ៊ីនធឺណិត និងពង្រឹងបច្ចេកទេសឃ្លាំមើលដែលត្រូវបានប្រើរួចហើយដើម្បីកំណត់គោលដៅអ្នកប្រឆាំង។
លោក បាន បន្ត ថា ៖ « ក្រសួង បាន សម្រេច ផ្អាក ការ អនុវត្ត ដោយ មិន កំណត់ ពេល វេលា ជាក់លាក់ទេ រហូត ដល់ មាន ការ ជូន ដំណឹង ថ្មី»។ «វាមិនមែនត្រឹមតែ ច្រកទ្វារអ៊ីនធឺណិតជាតិប៉ុណ្ណោះទេ ប៉ុន្តែការងារមួយចំនួនទៀត ក៏ត្រូវបានពន្យារពេលដោយសារតែកូវីដ នេះ ផងដែរ»។
ក្រសួងក៏បានបដិសេធផងដែរពីការចោទប្រកាន់ដែលថាអនុក្រឹត្យនេះអនុញ្ញាតឱ្យអាជ្ញាធរត្រួតពិនិត្យ និងតាមដានរាល់សកម្មភាពតាមអ៊ីនធឺណិត។ រដ្ឋាភិបាល អះអាងថា ខ្លួនដើរតាមប្រទេសផ្សេងៗនៅលើពិភពលោកដែលមានច្រកទ្វារអ៊ីនធឺណិតរួចហើយ ប៉ុន្តែមិនបានបញ្ជាក់ច្បាស់ថាប្រទេសណានោះទេ។
អនុក្រឹត្យស្តីពីច្រកទ្វារអ៊ីនធឺណិតនឹងតម្រូវឱ្យប្រតិបត្តិករ ឬអ្នកផ្តល់សេវាអ៊ីនធឺណិត ផ្តល់របាយការណ៍ប្រចាំខែ ត្រីមាស និងប្រចាំឆ្នាំដល់រដ្ឋាភិបាល។ អនុក្រឹត្យនេះក៏ផ្តល់សិទ្ធិដល់រដ្ឋាភិបាលក្នុងការត្រួតពិនិត្យហេដ្ឋារចនាសម្ព័ន្ធ និងឧបករណ៍របស់ក្រុមហ៊ុនផងដែរ។
យោងតាមអង្គការសហប្រជាជាតិ ច្បាប់នេះក៏នឹងអនុញ្ញាតឱ្យអាជ្ញាធរបិទការចូលប្រើអ៊ីនធឺណិតតាមអំពើចិត្ត ឬបិទគេហទំព័រ ឬ domains មួយចំនួនផងដែរ។
អ្នកជំនាញបានលើកឡើងថា៖«ការត្រួតត្រាយ៉ាងទូលំទូលាយបែបនេះអាចបណ្តាលឱ្យមានការថយក្រោយនៃការការពារសិទ្ធិមនុស្ស និងការធានាជាច្រើនដែលសម្រេចបានក្នុងរយៈពេលជាច្រើនទសវត្សរ៍មុន ហើយនៅពេលដែលការអនុវត្តអនុក្រឹត្យនេះកើតមានឡើង វាពិតជាលំបាកណាស់ក្នុងការធ្វើឱ្យវាវិលត្រលប់មកភាពដើមវិញ »។
លោកស្រី ចក់ សុភាព នាយិកាប្រតិបត្តិនៃមជ្ឈមណ្ឌលសិទ្ធិមនុស្សកម្ពុជា មានប្រសាសន៍ថា ការធានារបស់រដ្ឋាភិបាលថា ខ្លួននឹងមិនប្រើប្រាស់ច្បាប់សម្រាប់ការរឹតត្បិតសិទ្ធិកាន់តែច្រើននោះ គឺរឿងមិនគួរឱ្យជឿនោះទេ។ លោកស្រី សុភាព មានប្រសាសន៍ថា រដ្ឋមិនបានឆ្លើយតបពីកង្វល់ពាក់ព័ន្ធនឹងការបង្កើតច្រកទ្វារនេះទេ ខណៈដែលប៉ុន្មានឆ្នាំថ្មីៗនេះលោកស្រី លោក ឃើញថារដ្ឋមានការមិនអត់ឱនចំពោះការរិះគន់ និងការមិនយល់ស្រប។
សហជីពប្រចាំណាហ្គាវើលដ៍ដាក់ពាក្យបណ្ដឹងទៅក្រសួងការងារ ស្នើឲ្យក្រុមហ៊ុនបញ្ចប់ការបញ្ឈប់បុគ្គលិក
ចំនួនបុគ្គលិកដែលត្រូវបញ្ឈប់នេះមានចំនួនប្រហែលជាមួយភាគប្រាំមួយនៃចំនួនបុគ្គលិកសរុបប្រហែល៨ ០០០នាក់។ ការសម្រេចរបស់កាស៊ីណូមួយនេះបានប្រកាសឲ្យដឹងកាលពីថ្ងៃទី៨ ខែមិថុនា ឆ្នាំ២០២១ ដោយអ្នកគ្រប់គ្រងអះអាងថាមកពីការធ្លាក់ចុះចំណូលដោយសារតែវិបត្តិកូវីដ១៩។ ការរាលដាលជាសកលរបស់វីរុសកូវីដ១៩ បានធ្វើឲ្យប៉ះពាល់ដល់ប្រតិបត្តិការរបស់ក្រុមហ៊ុនជិតមួយឆ្នាំ មុនមានការបិទដំណើរការជាបណ្ដោះអាសន្នកាលពីខែមីនា បន្ទាប់ពីមានបុគ្គលិកតេស្តវិជ្ជមានកូវីដ១៩។
បណ្ដឹងដែលខេមបូចាទទួលបាន សហជីពទាមទារចំនួនប្រាំចំណុច ទីមួយទាមទារឲ្យបញ្ឈប់ការបញ្ឈប់បុគ្គលិក បញ្ឈប់ការគំរាមកំហែងបុគ្គលិកដោយហៅអ្នកទាំងនោះទៅនិយាយម្ដងម្នាក់អំពីការបញ្ឈប់ពីការងារ និងត្រូវផ្ដល់ប្រាក់អតីតភាពការងារឲ្យបានសមរម្យចំពោះអ្នកដែលត្រូវបញ្ឈប់ពីការងារ។ ក្នុងញត្តិនោះក៏បានទាមទារឲ្យមានការទូទាត់ប្រាក់សំណងដូចដែលមានចែងក្នុងច្បាប់ ហើយសម្រាប់ក្រុមហ៊ុនណាហ្គាវើលដ៍ត្រូវអនុវត្តតាមវិធានការក្រសួងសុខាភិបាលដើម្បីការពារកុំឲ្យមានការឆ្លងរាលដាលជំងឺកូវីដ១៩។
អ្នកស្រីនិយាយថា៖ «ស្នាមមេដៃទាំងនេះបានប្រមូលមកពីបុគ្គលិកក្រុមហ៊ុនណាហ្គាវើលដ៍ ពីព្រោះពួកគាត់មិនយល់ស្របជាមួយនឹងការបញ្ឈប់បុគ្គលិក»។ អ្នកស្រីថា ការបញ្ឈប់បុគ្គលិកនេះមិនមានហេតុផលសមរម្យទេ ដែលក្រុមហ៊ុនថាមកពីធ្លាក់ចុះចំណូលដោយសារកូវីដ១៩ ខណៈដែលរបាយការណ៍បង្ហាញថាក្រុមនហ៊ុននៅតែទទួលបានប្រាក់ចំណេញ និងជាពិសេសគម្រោងតម្លៃបួនពាន់លានរបស់គម្រោងណាហ្គា៣ នៅកំពុងបន្តសាងសង់នៅឡើយ។
ណាហ្គាវើលដ៍ បានចាប់ផ្ដើមដំណើរការផ្នែកខ្លះរបស់ខ្លួនឡើងវិញក្នុងខែកក្កដា បន្ទាប់ពីលោកនាយករដ្ឋមន្ត្រី ហ៊ុន សែន ប្រកាសថាកាស៊ីណូទូទាំងប្រទេសអាចបើកដំណើរការឡើងវិញបាននៅពេលនោះ។ យ៉ាងណា មិនមែនគ្រប់បុគ្គលិកទាំងអស់វិលចូលធ្វើការវិញនោះទេ នៅមានបុគ្គលិកជាច្រើនពាន់នាក់ទៀតនៅទាមទារជំនួយសង្គ្រោះបន្ទាន់។
លោក និន វណ្ណៈ អគ្គលេខាធិការរងគណៈកម្មមាធិការដោះស្រាយវិវាទ និងកូដកម្មនៃក្រសួងការងារ បានបញ្ជាក់ប្រាប់ខេមបូចាថា ក្រសួងបានទទួលពាក្យបណ្ដឹងរបស់បុគ្គលិកណាហ្គាវើលដ៍ហើយ។
លោកបន្ថែមថាក្រសួងកំពុងធ្វើការដើម្បីទប់ស្កាត់ការឆ្លងរាលដាលជំងឺកូវីដ១៩ ប៉ុន្តែលោកមិន បានអត្ថាធិប្បាយបន្ថែមលើជម្លោះនៅណាហ្គាវើលដ៍ទេ។
តាមរយៈសារជាអក្សរនោះលោកបន្ថែមថា៖ «យើងមិនអាចធ្វើអ្វីបានក្រៅពីធ្វើតាមនិវិធីទេ មិនថាជាជម្លោះអ្វីនោះទេ ពួកគេមិនអាចត្រូវវាយតម្លៃរហ័សពេកទេ»។
សកម្មជនសហជីពទ្រទ្រង់សិទ្ធិការងារបុគ្គលិកកម្មករខ្មែរនៃក្រុមហ៊ុនណាហ្គាវើលដ៍ អ្នកស្រី ហៃ សុភាព មានវ័យ៣៣ឆ្នាំ ជាបុគ្គលិកម្នាក់ក្នុងចំណោមបុគ្គលិកផ្សេងទៀតដែលនឹងត្រូវបញ្ឈប់ពីការងារ បន្ទាប់ពីបានទទួលសារជូនដំណឹងពីថ្នាក់គ្រប់គ្រង។ អ្នកស្រីបានធ្វើការជាអ្នកគ្រប់គ្រប់ផ្នែកលេងល្បែងអស់រយៈពេល១៤ឆ្នាំ នៅកាស៊ីណូណាហ្គាវើលដ៍។ អ្នកស្រី ប្រាប់ខេមបូចា ថាអ្នកស្រីសង្ឃឹមថាក្រសួងការងារនឹងអន្តរាគមន៍ជួយដោះស្រាយលើជម្លោះនេះ។
និយាយទាំងទឹកភ្នែក អ្នកស្រី បូ លាភ អាយុ៤៥ឆ្នាំបានប្រាប់ខេមបូចាថា ប្តីនិងកូនប្រុសអាយុ១៧ឆ្នាំរបស់អ្នកស្រីត្រូវបានចាប់ខ្លួនបន្ទាប់ពីត្រូវនរគបាលវាយដំយ៉ាងធ្ងន់ធ្ងរ។
លោក ណៃ ភន ដែលឥឡូវនេះបានរត់ចេញពីផ្ទះ ដោយសារខ្លាចការចាប់ខ្លួន បាននិយាយថា សមាជិកគ្រួសាររបស់គាត់បីនាក់រួមទាំងប្រពន្ធរបស់គាត់ត្រូវបានចាប់ខ្លួនអំឡុងពេលតវ៉ា។
លោក ណៃ ភន បាននិយាយថា ទាំងអាជ្ញាធរនិងក្រុមហ៊ុនកំពុងគាបសង្កត់ឲ្យប្រជាពលរដ្ឋទទួលយកសំណងដែលក្រុមហ៊ុនផ្តល់ជូនដែលអ្នកភូមិមួយចំនួនបានបដិសេធមិនទទួលយកអស់រយៈពេលជាងបីឆ្នាំមកហើយ។
ចុះអ្នកផ្សេងទៀតដែលដីរបស់ពួកគាត់ត្រូវបានឈូសឆាយរួចហើយនោះ?»។ ដោយបន្ថែមថា៖ «នៅដំណាក់កាលនេះយើងត្រូវបានគេចាប់ជំរិត ប៉ុន្តែខ្ញុំនៅតែមិនព្រមទទួលយកការផ្តល់ជូននេះ។ ឥឡូវនេះ អ្នកភូមិនៅបែកខ្ញែកដោយសារតែនគរបាលតាមស្វែងរកពួកគាត់»។
អ្នកភូមិម្នាក់ទៀតឈ្មោះ ទួន វណ្ណៈ បាននិយាយថា អាជ្ញាធរកំពុងតម្រូវឲ្យប្រជាពលរដ្ឋ ដែលពួកគេបានចាប់ខ្លួនថតចម្លង បណ្ណកម្មសិទ្ធិដីរបស់ពួកគាត់ជាភស្តុតាងបញ្ជាក់ពីកម្មសិទ្ធិ។ លោកបានចោទប្រកាន់ថា នគរបាលប្រាប់ពួកគាត់ថា ពួកគាត់នឹងមិនត្រូវបានដោះលែងទេ លុះត្រាតែពួកគាត់ព្រមទទួលយកតម្លៃដែលក្រុមហ៊ុនផ្តល់ជូន។
លោក វណ្ណៈ ដែលកំពុងរត់គេចខ្លួនពីអាជ្ញាធរបាននិយាយថា នគរបាលស្លៀកពាក់ស៊ីវិលបានដើរល្បាតក្នុងភូមិ ទាំងយប់និងថ្ងៃ
លោកនិយាយថា ការចាប់ខ្លួននេះកំពុងដាក់សម្ពាធយ៉ាងខ្លាំងទៅលើប្រជាពលរដ្ឋឲ្យលក់ដីរបស់ខ្លួនទៅឲ្យក្រុមហ៊ុន។
អ្នកស្រី បូ លាភ បាននិយាយថា ដោយមិនអាចចូលទៅដល់ដីស្រែរបស់ខ្លួនបាន អ្នកស្រីមិនប្រាកដថា ដីជាង២ហិកតារបស់អ្នកស្រីត្រូវបាន ឈូសឆាយរួច ហើយឬយ៉ាងណានោះទេ។
លោក គង់ សោភ័ណ្ឌ អភិបាលខេត្តកណ្តាលបានបដិសេធមិនធ្វើអត្ថាធិប្បាយទេ ដោយអះអាងថា លោកជាប់រវល់។ លោក ឡាក់ ម៉េងធី ប្រធានការិយាល័យព្រហ្ម ទណ្ឌកម្រិតស្រាលនៃស្នងការដ្ឋាននគរបាល ខេត្តកណ្តាលបាននិយាយថា មនុស្ស ទាំង៣០នាក់ដែលត្រូវបានចាប់ខ្លួនកំពុងត្រូវបានសាកសួរនៅស្នងការដ្ឋាននគរបាលខេត្ត។
សេចក្តីថ្លែងការណ៍ដដែលបានសរសេរថា៖ «រដ្ឋបាលខេត្តកណ្តាលពិតជាមានការសោកស្តាយចំពោះទង្វើជ្រុលនិយមរបស់ក្រុមមនុស្ស ដែលបានប្រព្រឹត្តខុសច្បាប់ ដែលអំពើនេះអាចនាំឲ្យប៉ះពាល់សណ្តាប់ធ្នាប់សន្តិសុខ និងការបំផ្លិចបំផ្លាញផលប្រ យោជន៍ធំរបស់ប្រទេសជាតិ»។
អ្នកកាសែតពលរដ្ឋម្នាក់ឈ្មោះ ច្រាយ នីម ក៏ត្រូវបានឃាត់ខ្លួនអស់រយៈពេលប្រាំបីម៉ោង ផងដែរកាលពីថ្ងៃចន្ទ ខណៈកំពុងថតរូបនិង ថតវីដេអូសាច់ញាតិរបស់អ្នកដែលត្រូវ បានឃាត់ខ្លួន ដែលបានមកស្នងការដ្ឋាននគរបាលខេត្ត ដើម្បីជួបសមាជិកគ្រួសារ របស់ពួកគាត់។
អ្នកស្រីបាននិយាយថា៖ «នៅពេលខ្ញុំថតរូបមួយចំនួន ពួកគេបានមកហើយស្នើឲ្យខ្ញុំ ទៅប៉ុស្តិ៍នគរបាល ហើយពួកគាត់ប្រាប់ខ្ញុំឲ្យសុំការអនុញ្ញាតសិនមុនពេលរាយការណ៍ ព័ត៌មានឬថតរូប។ នេះគឺជាការគំរាមកំហែងដល់សេរីភាពសារព័ត៌មាន»។
លោកមានប្រសាសន៍ថា៖ «មានការព្រួយបារម្ភថា បើគ្មានដំណោះស្រាយប្រកបដោយ តម្លាភាពនិងយុត្តិធម៌និងដោយសន្តិវិធីទេ អំពើហិង្សានិងការចាប់ខ្លួនអាចកើន ឡើង ហើយអាចឈានទៅដល់ការដាក់ពន្ធនាគារ»។ ដោយលោកបន្ថែមថា៖ «ហើយវានឹងធ្វើឲ្យជីវិតរបស់ ប្រជាពលដ្ឋកាន់តែលំបាកជាងនេះ និងនាំឲ្យមានការរិះគន់ធ្ងន់ធ្ងរអំពីបញ្ហាសិទ្ធិមនុស្សនៅក្នុង ប្រទេស»៕
មានចម្ងាយមិនដល់កន្លះគីឡូម៉ែត្រពីផ្ទះអ្នកភូមិ ក្នុងឃុំបឹងខ្យាង គឺទៅដល់គម្រោងទីតាំងផ្លូវយន្តហោះរត់ដែលមានប្រវែង ៤ ០០០ម៉ែត្រ មានទង់ជាច្រើនត្រូវបានដោតនៅវាលស្រែ ដែលបង្ហាញពីខ្សែបន្ទាត់នៃគម្រោងអភិវឌ្ឍន៍អាកាសយានដ្ឋានអន្តរជាតិភ្នំពេញថ្មី។
អគ្គនាយកដ្ឋានការពារអ្នកប្រើប្រាស់ កិច្ចការប្រកួតប្រជែង និងបង្រ្កាបការក្លែងបន្លំ (ក.ប.ប) បានប្រកាសកាលពីថ្ងៃចន្ទ ថាម្សៅទាំង១២ម៉ាកត្រូវបានអនុញ្ញាតឱ្យលក់ឡើងវិញក្នុងទីផ្សារបន្ទាប់ពីលទ្ធផលពិនិត្យនិងវិភាគនៅអូស្រ្តាលីនិងសហរដ្ឋអាមេរិកបង្ហាញថាម្សៅទាំងនោះមិនមានសារធាតុរ៉ែ carcinogen ដែលធ្វើឱ្យប៉ះពាល់ធ្ងន់ធ្ងរដល់សុខភាពមនុស្សទេ។
លោក បាន បន្ត ថា ៖ « យើង អាច ជឿជាក់ បាន ថា វា ត្រឹមត្រូវ »។ ទោះយ៉ាងណាក៏ដោយលោកយល់ថា ទំនុក ចិត្ត អ្នក ប្រើ ប្រាស់នៅតែមិនអាចដូចមុននោះទេ។
ខណៈពេលរដូវវស្សាចាប់ផ្តើម ប្រជាពលរដ្ឋរស់នៅលើ និងជុំវិញបឹងទន្លេសាប និយាយថា ពួកគាត់បារម្ភអំពីការទទួលបានផលនេសាទទាបនិងកម្រិតទឹកទាបដ៏គ្រោះថ្នាក់បែបនេះ នៅឆ្នាំបន្ទាប់ទៀតនៅអាងទឹកសាបដែលធំបំផុតក្នុងតំបន់។
លោកបាននិយាយថា៖ «យើងពឹងផ្អែកលើរបរនេសាទ។ យើងគ្មានជំនាញអ្វីផ្សេងទេ បើមិនដូច្នេះទេ យើងនឹងទៅធ្វើការជាកម្មករសំណង់នៅពេលដែលយើងមិនអាចរកត្រីទៀត។ ខ្ញុំមិនអាចរកត្រីបរិភោគបានទៀតទេ ហើយខ្ញុំត្រូវទិញត្រីពីផ្សារយកមកហូប »។
លោកបាននិយាយថា៖ «ប្រសិនបើយើងប្រើឧបករណ៍នេសាទធម្មតា យើងមិនអាចចាប់ត្រីបានទេ ប៉ុន្តែប្រសិនបើយើងប្រើឧបករណ៍នេសាទហាមឃាត់ យើងត្រូវបង់លុយឲ្យ ។ ប្រជាពលរដ្ឋគ្មានលុយបង់ឲ្យពួកគេទេ»។
បឹងទន្លេសាបលាតសន្ធឹងនិងរួមតូចទៅតាមរដូវ ដោយទឹកហូរ ចូលពីទន្លេមេ គង្គតាមទន្លេសាបនៅដើមរដូវវស្សា និងហូរចេញមកវិញនៅចុង រដូវវស្សា។ ដោយកម្ពស់ទឹកទន្លេបានធ្លាក់ចុះ នៅទន្លេមេគង្គដោយសារទំនប់វារីអគ្គិសនី ការហូរចូលទន្លេសាបហាក់ដូចជាអូសបន្លាយជាងពេលមុននៅប៉ុន្មានឆ្នាំចុងក្រោយនេះ។
នៅក្នុងរបាយការណ៍ស្ថានភាពប្រចាំសប្តាហ៍របស់ខ្លួន គណៈកម្មការទន្លេមេគង្គ (MRC) បង្ហាញថា លំហូរទឹកចេញពីបឹងទន្លេសាបវិញ បានចាប់ផ្តើមតាំងពីថ្ងៃ ទី១៥ ខែវិច្ឆិកា ឆ្នាំ២០២០។
លោក ហ៊ុត ហាន តំណាងប្រជានេសាទនៅសហគមន៍ព្រែកឆ្តោ ស្រុកឯកភ្នំខេត្ត បាត់ដំបងបានលើកឡើងថា កម្រិតទឹកទន្លេទាបក្នុងរយៈពេល២ឆ្នាំចុង ក្រោយនេះ មានន័យថា គ្មានត្រីណាចូលទៅតាមព្រែក បឹងបួរ នៅក្បែរនោះទេ។ ជាទីកន្លែងដែលធ្លាប់តែសម្បូរត្រី ឥឡូវនេះគេមើលឃើញថា កង្វះត្រីនៅ តាមដៃទន្លេតូចៗបានក្លាយជាផលប៉ះពាល់ដល់អ្នកស្រុក ដែលពឹងផ្អែកលើការនេសាទដើម្បីចិញ្ចឹមជីវិត។
ត្រីគឺជាផ្នែកសំខាន់មួយនៃរបបអាហាររបស់ប្រជាពលរដ្ឋកម្ពុជាក៏ដូចជារបរចិញ្ចឹមជីវិតដ៏សំខាន់ផងដែរ។ យោងតាមរដ្ឋបាលជលផល ប្រូតេអ៊ីនជាង៧៥ ភាគរយគឺបានមកពីត្រី ខណៈមនុស្ស១,៥ លាននាក់ធ្វើការងារ ពេញម៉ោងក្នុង របរនេសាទ ចំណែក៦លាននាក់ទៀតពឹងផ្អែកលើការងារ ក្រៅម៉ោងឬដោយប្រយោលនៅក្នុងវិស័យនេះ។
លោក ហ៊ុត ហាន បាននិយាយថា មានប្រជាជនជាង៣០០ គ្រួសារនៅក្នុង ភូមិ ព្រែកឆ្តោ ដែលភាគច្រើនពឹងផ្អែកលើការនេសាទ និងកសិកម្មផ្សេងទៀត ។ លោកបាននិ យាយថា ក្រៅពីកម្រិតទឹកទាប ការនេសាទខុសច្បាប់មាន ការរីករាលដាលខ្លាំងអំឡុងពេលមានការឆ្លងរាលដាលជំងឺកូវីដ-១៩។
លោក ជូង សុភា នាយខណ្ឌរដ្ឋបាលជលផលខេត្តបាត់ដំបងបានមានប្រសាសន៍ថា ទោះបី កម្ពស់ទឹកឆ្នាំនេះខ្ពស់ជាងឆ្នាំមុនបន្តិច តែវាទាបច្រើនជាងកាលពីពេលកន្លងមក។
លោកបន្តថា ការធ្លាក់ចុះនៃកម្រិតទឹកបានបណ្តាលឲ្យផលនេសាទធ្លាក់ចុះ។ នៅឆ្នាំ២០២០ ខេត្តបាត់ដំបងប្រមូលបានត្រីជាង២ម៉ឺនតោន ធ្លាក់ចុះ១៥ភាគរយធៀបនឹងឆ្នាំមុន។
លោក អ៊ុំ សាវ៉ាត នាយកប្រតិបត្តិនៃអង្គការសម្ព័ន្ធភាពដើម្បីអភិរក្សធនធានជលផល (FACT) បានមានប្រសាសន៍ថា ការថយចុះនៃធនធានជល ផល ធម្មជាតិគឺបណ្តាលមកពីកត្តាជាច្រើន រួមមានការប្រែប្រួលអាកាសធាតុ ការនេសាទខុសច្បាប់ និងទំនប់វារីអគ្គិសនីនៅតាមដងទន្លេមេគង្គ។
លោកបន្តថា ឆ្នាំ២០១៩ និងឆ្នាំ២០២០ កម្ពស់ទឹកនៅទន្លេសាបមានពី៦ម៉ែត្រទៅ ៧ម៉ែត្រ ទាបជាងកម្រិតមធ្យម ដែលមានចន្លោះពី៨ម៉ែត្រទៅ១១ម៉ែត្រក្នុង រយៈពេលពីរបីឆ្នាំកន្លងមកនេះ។
លោកបន្ថែម ថា នៅពេលត្រីកាន់តែខ្សត់ ក្រុមការងាររបស់លោកកំពុងលើកទឹក ចិត្តឲ្យអ្នកនេសាទកែច្នៃផលិតផលនេសាទ ដើម្បីបន្ថែមតម្លៃជាជាងផ្តោតលើការលក់តែត្រីស្រស់ មួយមុខ។
លោក អ៊ុត ឡុង ប្រធានបណ្តាញសហគមន៍នេសាទក្នុងខេត្តពោធិ៍សាត់បាន មានប្រសាសន៍ថា ការធ្លាក់ចុះផលត្រីនាំឱ្យមានការកើនឡើងនៃបទល្មើសនេសាទ ដោយអ្នកនេសាទចូលទៅក្នុងតំបន់អភិរក្ស ពីព្រោះកន្លែងផ្សេងទៀតរកត្រីមិនបាន។
សិស្សប្រុសកាន់តែច្រើនប្រឈមនឹងការបោះបង់ការសិក្សានៅថ្នាក់អនុវិទ្យាល័យ
សុខា ជាកូន ទី ពីរ ក្នុង គ្រួសារ មួយ របស់ ជនជាតិ ដើម ភាគ តិច ចារ៉ាយ និង កំពុង រស់ នៅ ស្រុក បកែវ ខេត្ត រតនគិរី។ សុខា ជា សិស្ស ប្រុស ម្នាក់ ក្នុង ចំណោម សិស្ស ប្រុស ជា ច្រើន ទៀត នៅ កម្ពុជា ដែល ត្រូវ បង្ខំ ចិត្ត បោះ បង់ ការសិក្សា ដោយសារ តែមានការ លំបាក ផ្នែក សេដ្ឋកិច្ច គ្រួសារ ។
ក្នុង របាយការណ៍ សកល មួយ ស្ដី ពី ការ មិន បាន ចូល រៀន របស់ ក្មេង ប្រុស បាន ចុះ ផ្សាយ នៅ ខែ នេះ អង្គការ យូណេស្កូ បាន រក ឃើញ ថា ថ្វី បើ សិស្ស ស្រី ប្រឈម នឹង ការ លំបាក ច្រើន ក្នុង ការ ទទួល បាន ការ អប់ រំ និង មាន ចំនួន ច្រើន សម្រេច ចិត្ត បោះ បង់ ការ សិក្សា នៅកម្រិត បឋមសិក្សា សិស្ស ប្រុសឯណោះវិញ ក៏មាន ការ ប្រឈម ច្រើន ដែរ នៅ កម្រិត អនុវិទ្យាល័យ ។
លោក បន្ត ថា កម្ពុជា ត្រូវ ធ្វើ ឱ្យ ប្រាកដ ថា គ្រប់ គោលនយោបាយ និង កម្មវិធី អប់ រំ ផ្សេងៗ មានការ តាម ដាន ដល់ វឌ្ឍនភាព របស់ ក្មេង ប្រុស ឲ្យ បាន ច្រើនដូច ក្មេង ស្រី ដែរ ហើយ តម្រូវ ការ របស់ ក្មេង ប្រុស ក៏ គួរ ត្រូវ ពិចារណា ដែរ ។ បើ តាម តួលេខ របស់ ក្រសួង អប់ រំ ក្នុង ឆ្នាំ ២០២០-២០២១ លោក ថា អត្រា សិស្ស ស្រី បោះ បង់ ការ សិក្សា នៅ ថ្នាក់ អនុវិទ្យាល័យ មាន ប្រហែល ១៦,៩ភាគ រយ ខណៈ សិស្ស ប្រុស វិញ មាន ដល់ទៅ ជា ១៩ ភាគ រយ ។
លោក បានបន្ថែមថា៖ «កម្ម វិធី នេះ គាំទ្រ ដល់ សិស្ស បោះបង់ ការសិក្សា ឱ្យ បាន បញ្ចប់ កម្រិត អប់ រំ មូល ដ្ឋាន តាម រយៈ ការសិក្សា អនឡាញ ដែល ការ សិក្សា នេះ មិន ប៉ះពាល់ ដល់ ការ ងារ ប្រចាំ ថ្ងៃ របស់ ពួកគេ ហើយ អាច ទទួលបាន សញ្ញាបត្រ និង អាច ចុះឈ្មោះ ចូល រៀន វគ្គ ជំនាញ បច្ចេក ទេស នៅ វិទ្យាស្ថាន បណ្ដុះ បណ្ដាល ជំនាញ វិជ្ជាជីវៈ របស់ ក្រ សួង ការងារ បាន »។
មជ្ឈមណ្ឌលសិទិ្ធមនុស្សកម្ពុជាបានចាប់ផ្តើមយុទ្ធនាការដោយចោទជាសំណួរថា តើប្រជាពលរដ្ឋចង់និយាយអ្វីខ្លះទៅកាន់លោក ឈុត វុទ្ធី ដែលជាអ្នកអភិរក្សគ្មានការ ភ័យខ្លាច ហើយជារឿយៗធ្វើឲ្យអាជ្ញាធរមិនសប្បាយចិត្តអស់រយៈពេលជាច្រើនឆ្នាំរហូតដល់លោកត្រូវបានសម្លាប់ដោយមន្រ្តីកងរាជអាវុធហត្ថ ខណៈពេលកំពុងធ្វើដំណើរជាមួយអ្នកយកព័ត៌មានកាសែត ឌឹខេមបូឌា ដេលី នៅតំបន់ជួរភ្នំក្រវាញក្នុងខេត្តកោះកុង។
ក្រុមអ្នកឃ្លាំមើលមានការសង្ស័យជាយូរមកហើយចំពោះការបកស្រាយរបស់រដ្ឋាភិ បាល ដែលថា លោក អ៊ិន រតនា បានបាញ់សម្លាប់លោក ឈុត វុទ្ធី ដោយចៃដន្យមុនពេលលោកបាញ់សម្លាប់ខ្លួនឯង អំឡុងពេលមានជម្លោះនៅប៉ុស្តិ៍ត្រួតពិនិត្យដែលកង រាជអាវុធហត្ថនិងទាហានបានរឹបអូសម៉ាស៊ីនថតពីលោក វុទ្ធី និងអ្នកយកព័ត៌មាន។
លោកស្រី ចក់ សុភាព នាយកប្រតិបតិ្តនៃមជ្ឈមណ្ឌលសិទ្ធិមនុស្សកម្ពុជាមានប្រសា សន៍ថា៖ «តាមរយៈយុទ្ធនាការរបស់យើងសម្រាប់លោក ឈុត វុទ្ធី យើងសង្ឃឹមថា នឹងរក្សារូបលោកនៅក្នុងស្មារតីរួមរបស់យើង ប៉ុន្តែក៏បង្ហាញពីការដឹងគុណនិងការគោរពរបស់យើងចំពោះសកម្មជនបរិស្ថានដទៃទៀត ដែលប្រថុយជីវិតរបស់ពួកគេដើម្បីប្រយោជន៍ដ៏ធំធេងរបស់ប្រជាជនកម្ពុជា»។
លោកស្រីបានមានប្រសាសន៍ថា៖ « ការងារដែលសកម្មជនកំពុងធ្វើនេះគួរតែត្រូវបានគេកោតសរសើរជាជាងរារាំង ហើយសម្លេងរបស់ពួកគេគួរតែត្រូវបានស្តាប់ជាជាងបំបិទមាត់ពួកគេ» ។
ទោះយ៉ាងណា លោក ខឹម សុផារី ចៅក្រមសាលាដំបូងខេត្តកោះកុងភា្លមៗនោះបានព្យួរទោសភាគច្រើនដោយគ្មានការពន្យល់ ហើយឃាតករដែលត្រូវបានផ្តន្ទាទោសត្រូវបានដោះលែងឲ្យរួចខ្លួនផងដែរ។
កូនប្រុសរបស់ វុទ្ធី គឺលោក ឆឺយ ឧត្តមរស្មី ដែលសព្វថ្ងៃរស់នៅសហរដ្ឋអាមេរិកបាននិយាយថា លោកមានភស្តុតាងថ្មីនិងមានហត្ថលេខា៧ម៉ឺន ដើម្បីបង្ហាញទៅការិយា ល័យសិទ្ធិមនុស្សរបស់អង្គការសហប្រជាជាតិនិងតុលាការឧក្រិដ្ឋកម្មអន្តរជាតិ។
លោកបានអំពាវនាវឱ្យរដ្ឋាភិបាលបង្ហាញថា តើមន្ត្រីជាន់ខ្ពស់ណាខ្លះ ដែលពាក់ព័ន្ធនឹងករណីនេះ ហើយបានអំពាវនាវដល់សហគមន៍អន្តរជាតិឱ្យជួយបញ្ចប់និទណ្ឌភាពនៅប្រទេសកម្ពុជា។
