មហាវិទ្យាល័យវេជ្ជសាស្រ្តទី 4
ក្នុង 1887, អគារពិសេសមួយត្រូវបានកសាងឡើងសម្រាប់ល្ខោនកាយវិភាគវិទ្យារបស់មហាវិទ្យាល័យវេជ្ជសាស្ត្រ (ឥឡូវនេះវាជាម្ចាស់កាយវិភាគសាស្ត្រមនុស្សនាយកដ្ឋាននៃសាលាខ្ពស់របស់យើង); ក្នុង 1896, គ្លីនិកសាកលវិទ្យាល័យឯករាជ្យចំនួនបួនត្រូវបានសាងសង់ឡើង, គឺ: ព្យាបាល, ការវះកាត់, ផ្នែកបង្កើតកូននិង ophthalmological.
ក្នុង 1920 មហាវិទ្យាល័យវេជ្ជសាស្ត្រនៃសាកលវិទ្យាល័យ Kharkiv ត្រូវបានរួបរួមជាមួយវិទ្យាស្ថានពេទ្យស្ត្រី, វេជ្ជបណ្ឌិតសភានិង Kharkiv ត្រូវបានបង្កើតឡើង; មួយឆ្នាំក្រោយមកក្រោយនេះត្រូវបានផ្តល់ឈ្មោះមួយផ្សេងទៀត: វិទ្យាស្ថានវេជ្ជសាស្រ្ត Kharkiv.
ក្នុង 1994, ដោយសេចក្តីសម្រេចរបស់គណៈរដ្ឋមន្រ្តីរដ្ឋមន្រ្តីនៃអ៊ុយក្រែន, វិទ្យាស្ថានវេជ្ជសាស្រ្ត Kharkiv បានបម្រើជាមូលដ្ឋានសម្រាប់ស្ថាបនិកសាកលវិទ្យាល័យវេជ្ជសាស្ត្រ Kharkiv រដ្ឋ; ក្រោយមកទៀតបានទទួលប្រភេទទី 4 ខ្ពស់បំផុតដោយលទ្ធផលនៃការទទួលស្គាល់គុណភាពអប់រំរបស់ខ្លួននិង justifies យ៉ាងពេញលេញនៅថ្ងៃនេះ.
នេះរដ្ឋ Wisconsin ទន្សាយប្រកួតប្រជែងនៅក្នុងការច្រើនជាង 20 កីឡាបោះផ្នែកខ្ញុំនិងជាផ្នែកមួយនៃសន្និសិទធំដប់នាក់.
