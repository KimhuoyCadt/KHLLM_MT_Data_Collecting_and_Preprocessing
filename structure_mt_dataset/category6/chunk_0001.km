បានទ្រង់យល់រដ្ឋធម្មនុញ្ញ នៃព្រះរាជាណាចក្រកម្ពុជា
បានទ្រង់យល់ព្រះរាជក្រមលេខ ០២/នស/៩៤ ចុះថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ១៩៩៤ ដែលប្រកាសឱ្យប្រើច្បាប់ ស្ដីពីការរៀបចំ និងការប្រព្រឹត្តទៅនៃគណៈរដ្ឋមន្ត្រី
បានទ្រង់យល់សេចក្ដីក្រាបបង្គំទូលថ្វាយ របស់សម្ដេចនាយករដ្ឋមន្ត្រី នៃរាជរដ្ឋាភិបាលនៃព្រះរាជាណាចក្រកម្ពុជា
ប្រកាសឱ្យប្រើ
ច្បាប់នេះ មានគោលដៅ កំណត់ការបង្ការ និង ការប្រយុទ្ធទប់ស្កាត់ការរីក រាលដាល មេរោគអេដស៍/ជំងឺអេដស៍នៅក្នុងព្រះរាជាណាចក្រកម្ពុជា ។
ជំងឺអេដស៍ គឺជាជំងឺឆ្លងរីករាលដាលមួយបង្កឡើងដោយមេរោគអេដស៍ និងដែល ទទួល ស្គាល់ថា គ្មានព្រំដែន ផ្នែកដែនដី សង្គម នយោបាយ និង សេដ្ឋកិច្ច ហើយជំងឺនេះ ពុំទាន់មាន ថ្នាំព្យាបាលឱ្យជាសះស្បើយទេ ។
ការរាតត្បាតនៃជំងឺនេះបាននិងកំពុងធ្វើឱ្យប៉ះពាល់យ៉ាងធ្ងន់ធ្ងរ ទៅលើ សន្តិសុខស្ថិរភាព និងការអភិវឌ្ឍន៍ សេដ្ឋកិច្ចសង្គម និងទាមទារឱ្យរដ្ឋចាត់វិធានការ ឆ្លើយតបជាពហុវិស័យ ដើម្បី ៖
ជំរុញឱ្យមានការយល់ដឹង ជាសាធារណៈដល់ប្រជាពលរដ្ឋគ្រប់រូប ស្ដីពីមូលហេតុ របៀប នៃការចំលង ផលវិបាក មធ្យោបាយបង្ការ និងការប្រយុទ្ធទប់ ស្កាត់ការរីករាលដាលមេរោគអេដស៍/ ជំងឺអេដស៍ តាមរយៈកម្មវិធីអប់រំ និងយុទ្ធនាការផ្សព្វផ្សាយទូលំទូលាយទូទាំងប្រទេស ។
ហាមឃាត់ការរើសអើងគ្រប់ប្រភេទ ចំពោះរាល់បុគ្គលណា ដែលត្រូវបានសង្ស័យ ឬត្រូវបានដឹងថាមានមេរោគ អេដស៍/ជំងឺអេដស៍។
ជំរុញឱ្យមានការប្រុងប្រយ័ត្នជាសកល ចំពោះវិធីសាស្ត្រ និងការអនុវត្តទាំងឡាយ ដែលអាច បង្កឱ្យមានគ្រោះថ្នាក់ ក្នុងការឆ្លងមេរោគ អេដស៍/ជំងឺអេដស៍។
ចាត់វិធានការសមស្រប ចំពោះរាល់កត្តាទាំងឡាយ ដែលធ្វើឱ្យកាន់តែធន់ធរដល់ការរីករាលដាលមេរោគ អេដស៍/ជំងឺអេដស៍។
លើកទឹកចិត្តឱ្យមានតួនាទី ជាសក្ដានុពលរបស់បុគ្គល ដែលមានមេរោគអេដស៍/ ជំងឺអេដស៍ក្នុងការលាតត្រដាងព័ត៌មាន និងបទពិសោធន៍របស់ពួកគេ ដើម្បីចង្អុលបង្ហាញដល់ សាធារណជន។
បញ្ចូលកម្មវិធីបង្ការ និងការប្រយុទ្ធទប់ស្កាត់ការរីករាលដាល មេរោគអេដស៍/ ជំងឺ អេដស៍ ជាកម្មវិធីអាទិភាព ទៅក្នុងផែនការអភិវឌ្ឍន៍ជាតិ ។
ការអប់រំ និង ការផ្សព្វផ្សាយព័ត៌មាន
រដ្ឋត្រូវជំរុញការអនុវត្តន៍មួយចំនួនដូចខាងក្រោម ៖
រៀបចំ ឱ្យមានការបញ្ជ្រាបបញ្ចូលចំណេះដឹង ស្ដីពីមេរោគអេដស៍/ជំងឺអេដស៍ នៅក្នុងសាលារៀន ។
ការអប់រំនេះ ត្រូវបញ្ចូលការបង្រៀនស្ដីពី មូលហេតុរបៀបនៃការចម្លងនិងការបង្ការផលវិបាកនៃមេរោគ អេដស៍/ជំងឺអេដស៍ ព្រមទាំងជំងឺកាមរោគដទៃទៀត ជាពិសេសផ្ដោតលើបំណិនជីវិត ស្របនិងសីលធម៌ សង្គម តាមរូបភាពការបញ្ជ្រាបបញ្ចូល នៅក្នុងកម្មវិធីសិក្សាតាមគ្រប់គ្រឹះស្ថានសិក្សា ភូមិសិក្សារួមទាំង ការអប់រំ ក្រៅប្រព័ន្ធ។
រៀបចំឱ្យមានសិក្ខាសាលា និងការបណ្ដុះបណ្ដាល បង្ហាត់បង្រៀន ស្ដីពីការបង្ការ និងការប្រយុទ្ធទប់ស្កាត់ការរីករាលដាល មេរោគអេដស៍/ជំងឺអេដស៍ ដល់គ្រូបង្រៀន និងអ្នកបង្ហាត់បង្រៀនផ្សេងទៀត ដែលត្រូវបានចាត់តាំងឱ្យទៅបង្រៀនបន្ត។
រៀបចំឱ្យមានការផ្ដល់យោបល់ ពីសំណាក់សហគមន៍ សមាគម អង្គការនានា ក្នុងការអប់រំ ស្ដីអំពីមេរោគអេដស៍ នឹងជំងឺអេដស៍។
រដ្ឋ រៀបចំឱ្យមានការអប់រំ ស្ដីពីមេរោគអេដស៍ និង ជំងឺអេដស៍ បញ្ចូលជាផ្នែកមួយនៃការ ផ្ដល់សេវាសុខាភិបាល តាមរយៈគ្រូពេទ្យ និងមន្ត្រីសុខាភិបាល។
ចំណេះដឹង និងសមត្ថភាព របស់គ្រូពេទ្យ និងមន្ត្រីសុខាភិបាល ទាំងនេះត្រូវបានទទួលការបំពាក់បំប៉នបន្ថែម រួមមានជំនាញ សម្រាប់ផ្សព្វផ្សាយព័ត៌មាន និងការអប់រំ ស្ដីពី មេរោគ អេដស៍ និងជំងឺអេដស៍ ។
ការអប់រំផ្សព្វផ្សាយ ស្ដីពីមេរោគអេដស៍ និង ជំងឺអេដស៍ ព្រមទាំងការបំពាក់បំប៉នបន្ថែម ជាភារកិច្ចរបស់អ្នកផ្ដល់សេវា ថែទាំសុខភាព នៅក្នុងផ្នែកឯកជន ដើម្បីរួមចំណែកក្នុងការបង្ការ និង ការប្រយុទ្ធទប់ ស្កាត់ការរីករាលដាលមេរោគអេដស៍ និង ជំងឺអេដស៍។
ការបំពាក់បំប៉នបន្ថែម ត្រូវរួមបញ្ចូលការពិភាក្សាអំពីបញ្ហាក្រមសីលធម៌ ដែលទាក់ទង ទៅនឹង មេរោគអេដស៍ និងជំងឺអេដស៍ជា ពិសេសការរក្សាភាពសំងាត់ ការគោរពសិទ្ធិបុគ្គល។
រៀបចំឱ្យមានការផ្សព្វផ្សាយព័ត៌មាន និងកម្មវិធី សិល្បៈអប់រំ នៅតាមប្រព័ន្ធផ្សព្វផ្សាយ របស់រដ្ឋ ដោយឥតបង់ថ្លៃដើម្បីឱ្យបានជ្រួតជ្រាបដល់សាធារណជន ។
ការផ្សព្វផ្សាយនេះ ត្រូវប្រើប្រាស់វិធីសាស្ត្រ និងពេលវេលាសមស្រប ដើម្បីធានានូវប្រសិទ្ធភាព។
រដ្ឋរៀបចំឱ្យមានការអប់រំពិសេស ផ្ដោតទៅលើក្មេងស្រី ស្ត្រីជាមេគ្រួសារ ដោយត្រូវយក ចិត្តទុកដាក់សំខាន់អំពីតួនាទីរបស់ស្ត្រីនៅក្នុងសង្គម និងបញ្ហាយេនឌ័រ ។
ឯកសារអប់រំនេះ ត្រូវបោះពុម្ពជាភាសាខ្មែរ និង ភាសាផ្សេងៗទៀត តាមការចាំបាច់ ។
រដ្ឋរៀបចំផ្ដល់ព័ត៌មាន ឯកសារអប់រំ ឬ ការចូលរួមក្នុងសិក្ខាសាលាជូនដល់គ្រប់កម្មករខ្មែរ មន្ត្រីការទូត មន្ត្រីរាជការ ស្ដីពីមូលហេតុ របៀបនៃការចម្លង ការបង្ការនិងផលវិបាក នៃមេរោគអេដស៍/ ជំងឺអេដស៍ មុននឹងចេញទៅធ្វើការនៅបរទេស។
គ្រប់ស្ថាប័ន គ្រប់សហគ្រាស សិប្បកម្ម ត្រូវសហការជាមួយ អាជ្ញាធរជាតិប្រយុទ្ធនឹង ជំងឺអេដស៍ រៀបចំឱ្យមានកម្មវិធីអប់រំមេរោគអេដស៍/ជំងឺអេដស៍ នៅកន្លែងធ្វើការដោយត្រូវបញ្ចូលទាំងប្រធានបទ ចំពោះការរក្សាភាពសំងាត់នៅកន្លែងធ្វើការនិងឥរិយាបថចំពោះអ្នកមាន មេរោគអេដស៍/ អ្នកជំងឺអេដស៍ ។
ជាមួយគ្នានឹងការអបរំស្ដីពី មេរោគអេដស៍/ជំងឺអេដស៍ គ្រប់ស្ថាប័ន គ្រប់សហគ្រាស សិប្បកម្ម ត្រូវរៀបចំអោយមានផែនការទៅតាមអាណត្តិ ការងាររបស់ខ្លួន ក្នុងការរួមចំណែកទប់ស្កាត់ការរីករាលដាលនៃជំងឺអេដស៍ ។
រដ្ឋត្រូវចលនាពង្រឹងការចូលរួមរបស់ប្រជាពលរដ្ឋ គ្រួសារ អង្គការនានា ព្រះសង្ឃ ក្រុមបព្វជិតសាសនានិងក្រុមអ្នកដែលប្រឈមនឹងគ្រោះថ្នាក់បំផុត ដើម្បីរៀបចំផ្ដល់ព័ត៌មាននិងការអប់រំ នៅគ្រប់លំដាប់ថ្នាក់ទូទាំងព្រះរាជាណាចក្រកម្ពុជា។
សម្ភារៈឬវត្ថុធាតុសម្រាប់បង្ការការចម្លងមេរោគអេដស៍ ដែលផ្ដល់ដោយលក់ ឬ អំណោយ ត្រូវភ្ជាប់នូវឯកសារអប់រំ ដែលបោះពុម្ពជាភាសាខ្មែរ និងជាភាសាផ្សេងទៀត តាមការចាំបាច់ ហើយក្នុងនោះ មាននិយាយពីវិធីប្រើប្រាស់ត្រឹមត្រូវនូវសម្ភារៈ ឬ វត្ថុធាតុទាំងនោះ និងប្រសិទ្ធភាពរបស់វា ប្រឆាំង នឹងការឆ្លងមេរោគអេដស៍ ។
ហាមដាច់ខាតរាល់ការឃោសនា ឬ ផ្សព្វផ្សាយពាណិជ្ជកម្ម ដែលអះអាងលើការព្យាបាល ព្រមទាំង វិធីបង្ការមេរោគអេដស៍/ជំងឺអេដស៍ដែលផ្ទុយនឹងវិធានការនានា របស់អាជ្ញាធរជាតិប្រយុទ្ធ នឹងជំងឺអេដស៍ និងគោលការណ៍បច្ចេកទេស វេជ្ជសាស្ត្រ ។
វិធីសាស្ត្រ និង ការអនុវត្តដែលមានសុវត្ថិភាព
រាល់វិធីសាស្ត្រ និងការអនុវត្តន៍ទាំងឡាយ ត្រូវធ្វើទៅតាមគោលការណ៍ ណែនាំរបស់អាជ្ញាធរជាតិ ប្រយុទ្ធនឹងជំងឺអេដស៍ ។
អាជ្ញាធរជាតិ ប្រយុទ្ធនឹងជំងឺអេដស៍ ត្រូវពិគ្រោះពិភាក្សា និងសំរបសំរួលជាមួយក្រសួង សុខាភិបាល អង្គភាពជំនាញ ដែលពាក់ព័ន្ធ ដើម្បីកំណត់ និងផ្សព្វផ្សាយនូវគោលការណ ណៃនាំ ស្ដីពីការ ប្រុងប្រយ័ត្នជាសកល ចំពោះការឆ្លងមេរោគអេដស៍ និងជំងឺអេដស៍ ជាពិសេស ក្នុងកំឡុងពេលវះកាត់ ជាពិសេសក្នុងអំឡុងពេលវះកាត់ កែសម្ជស្ស ធ្វើធ្មេញ អប់សព សាក់ ឬការងារ ដទៃទៀត ដែលមានលក្ខណៈស្រដៀងគ្នា។
រាល់ការប្រើប្រាស់ ឈាម ជាលិកា ឬ សរីរាង្គ ត្រូវធ្វើតេស្ត មេរោគអេដស៍បញ្ជាក់ជាមុន។
មិនអនុញ្ញាតឱ្យមន្ទីរពិសោធន៍ ឬ អង្គភាពណាមួយ យកឈាម ជាលិកា ឬ សរីរាង្គ ទុកសម្រាប់ ប្រើប្រាស់ដោយពុំបានធ្វើតេស្តមេរោគអេដស៍ បញ្ជាក់ជាមុនឡើយ ។
សាច់ញាតិ ឬអ្នកទទួលឈាម ជាលិកា ឬសរីរាង្គ មានសិទ្ធិសុំធ្វើតេស្តសាជាថ្មី មុននឹងធ្វើការ ចាក់បញ្ចូលឈាមបណ្ដុះជាលិកា ឬ ប្ដូរសរីរាង្គ លើកលែងតែក្នុងករណីសង្គ្រោះបន្ទាន់ ។
ឈាម ជាលិកា និង សរីរាង្គ ដែលមានមេរោគអេដស៍ ត្រូវតែកំទេចចោលតាមគោលការណ៍ អនាម័យត្រឹមត្រូវបំផុត។
ក្នុងករណីចាំបាច់ ឈាម ជាលិកា ឬ សរីរាង្គ ដែលមានមេរោគអេដស៍ អាចទទួលយកបានសម្រាប់តែសិក្សាស្រាវជ្រាវវិទ្យាសាស្ត្រប៉ុណ្ណោះ។
ហាមឃាត់ដាច់ខាតចំពោះអ្នកដែលដឹងថាខ្លួនមាន មេរោគអេដស៍/ជំងឺអេដស៍ទៅប្រព្រឹត្តក្នុងចេតនាចំលងទៅអ្នកដទៃ ។
ការធ្វើតេស្ត និង ការផ្ដល់កិច្ចប្រឹក្សា
ការធ្វើតេស្តមេរោគអេដស៍/ជំងឺអេដស៍ ត្រូវធ្វើឡើងដោយស្ម័គ្រចិត្តនិងត្រូវមានការយល់ ព្រម ជាមុនពីសាមីជនផ្ទាល់ ។
ចំពោះសាមីជនជាអនីតិជន តម្រូវឱ្យមានការយល់ ព្រមជាលាយលក្ខណ៍អក្សរពីអាណាព្យាបាលស្របច្បាប់ ។
បើការយល់ព្រមជាលាយលក្ខណ៍អក្សរពីអាណាព្យាបាលស្របច្បាប់ ពុំអាចធ្វើបានការធ្វើតេស្ត មេរោគអេដស៍/ជំងឺអេដស៍ អាចប្រព្រឹត្តទៅបានដោយគ្រាន់តែមានការព្រមព្រៀងពីអនីតិជន ប្រសិនបើការធ្វើតេស្តនេះផ្ដល់អត្ថប្រយោជន៍ផ្ទាល់ចំពោះអនីតិជន នោះ។
ចំពោះជនវិកលចរិត រដ្ឋត្រូវយកចិត្តទុកដាក់ ។
ហាមដាច់ខាតចំពោះការដាក់លក្ខខ័ណ្ឌឱ្យធ្វើតេស្ត មេរោគអេដស៍/ជំងឺអេដស៍ មុននិងក្រោយការ អនុញ្ញាត ឱ្យចូលបម្រើការងារចូលសិក្សានៅក្នុងគ្រឹះស្ថានសិក្សានានា ក៏ដូចជាសម្រាប់ការអនុវត្តសេរីភាព ស្នាក់នៅសិទ្ធិ ធ្វើដំណើរការផ្ដល់សេវាកម្មផ្នែកវេជ្ជសាស្ត្រ ឬ សេវាកម្មផ្សេងទៀត ។
ការធ្វើតេស្ត មេរោគអេដស៍/ជំងឺអេដស៍ ដោយបង្ខំត្រូវអនុញ្ញាតតែក្នុងករណី មានសេចក្ដីបង្គាប់ របស់តុលាការ។
រាល់ការធ្វើតេស្ដ មេរោគអេដស៍/ជំងឺអេដស៍ ត្រូវធ្វើដោយអនាមិក ។
ក្រសួងសុខាភិបាល ត្រូវរៀបចំផ្ដល់នូវយន្តការសម្រាប់ធ្វើតេស្ត មេរោគអេដស៍/ជំងឺអេដស៍ ហើយត្រូវធានាភាពអនាមិក និងរក្សាភាពសំងាត់ផ្នែកវេជ្ជសាស្ត្រនៅក្នុងដំណើរការធ្វើតេស្ត ។
គ្រប់កន្លែងធ្វើតេស្តមេរោគអេដស៍ អាចផ្ដល់សេវានេះបាន លុះត្រាតែមានច្បាប់ អនុញ្ញាត ពីក្រសួងសុខាភិបាល។
ក្រសួងសុខាភិបាលត្រូវសហការជាមួយអាជ្ញាធរជាតិប្រយុទ្ធនឹងជំងឺអេដស៍ ដើម្បីកំណត់និងរក្សានូវស្តង់ដារសេវាមួយសមស្រប ។
គ្រប់កន្លែងធ្វើតេស្តមេរោគអេដស៍/ជំងឺអេដស៍ ត្រូវផ្ដល់កិច្ចប្រឹក្សាមុននិងក្រោយការធ្វើតេស្តដល់ជន ដែលមកសុំធ្វើតេស្តមេរោគអេដស៍/ជំងឺអេដស៍ ។
អ្នកផ្ដល់កិច្ចប្រឹក្សានេះ ត្រូវមានសមត្ថភាព គ្រប់គ្រាន់ សមស្របតាម ស្តង់ដារកំណត់ដោយក្រសួងសុខាភិបាល។
អាជ្ញាធរជាតិ ប្រយុទ្ធនឹងជំងឺអេដស៍ និង ក្រសួងសុខាភិបាល ត្រូវសហការគ្នា រៀបចំ និង លើកកម្ពស់សមត្ថភាពសម្រាប់ការធ្វើតេស្តមេរោគអេដស៍/ជំងឺអេដស៍ ដល់គ្រប់កន្លែងធ្វើតេស្ត ដែលមាន ច្បាប់អនុញ្ញាត ហើយធានាឱ្យមានការបណ្ដុះបណ្ដាល បុគ្គលិកជំនាញ សម្រាប់ផ្ដល់សេវាបែបនេះ នៅក្នុងទីកន្លែងធ្វើតេស្តមេរោគអេដស៍/ជំងឺអេដស៍។
សេវាសុខាភិបាល និង សេវាគាំទ្រ
រដ្ឋ ត្រូវធានាឱ្យអ្នកដែលមានមេរោគអេដស៍ និង អ្នកជំងឺអេដស៍ ទទួលបាននូវសេវាថែទាំ សុខភាពបឋម ដោយឥតបង់ថ្លៃតាមបណ្ដាញសុខាភិបាលទាំងអស់របស់រដ្ឋ និង ត្រូវលើកទឹកចិត្ត ឱ្យមានការចូលរួមពីផ្នែកឯកជន។
រដ្ឋត្រូវចលនាពង្រឹង ការចូលរួម របស់ប្រជាពលរដ្ឋ គ្រួសារ អង្គការនានា ព្រះសង្ឃ ក្រុមបព្វជិតសាសនា និងក្រុមអ្នកដែលប្រឈមនឹងគ្រោះថ្នាក់បំផុត សំដៅឧបត្ថម្ភ ថែទាំ និងព្យាបាល អ្នកមានមេរោគអេដស៍ និង ជំងឺអេដស៍នៅគ្រប់លំដាប់ថ្នាក់ ទូទាំងព្រះរាជាណាចក្រកម្ពុជា។
រដ្ឋ ត្រូវយកចិត្តទុកដាក់ជំរុញឱ្យមានការបណ្ដុះបណ្ដាលវិជ្ជាជីវៈ ដល់អ្នកមានមេរោគអេដស៍ និង អ្នកជំងឺអេដស៍ដើម្បីប្រកបរបរចិញ្ចឹមជីវិត និង កម្មវិធីជួយខ្លួនឯង។
អ្នកមានមេរោគអេដស៍ និងអ្នកជំងឺអេដស៍ ត្រូវមានសិទ្ធិចូលរួមពេញលេញនៅក្នុងកម្មវិធីបណ្ដុះបណ្ដាលវិជ្ជាជីវៈ និង កម្មវិធី ជួយខ្លួនឯង ដើម្បីជាមធ្យោបាយចិញ្ចឹមជីវិត។
រដ្ឋ ត្រូវយកចិត្តទុកដាក់បន្តជំរុញការបង្ការទប់ស្កាត់ និងការគ្រប់គ្រងជំងឺកាមរោគ ក្នុងគោលដៅជួយទប់ស្កាត់ការឆ្លងរាលដាល នៃមេរោគអេដស៍/ជំងឺអេដស៍ ។
រដ្ឋ ត្រូវបង្កើតកម្មវិធីតាមដានត្រួតពិនិត្យមេរោគអេដស៍ និងជំងឺអេដស៍ ឱ្យបានទូលំទូលាយមួយ ដើម្បីកំណត់អំពីទំហំ ភាពងាយប្រឈមមុខនឹងគ្រោះថ្នាក់របស់ប្រជាពលរដ្ឋ ការប្រព្រឹត្តរួមភេទ។
កម្មវិធី នេះ មានគោល បំណងផ្ទៀងផ្ទាត់ វាយតម្លៃពីភាពគ្រប់គ្រាន់ ប្រសិទ្ធភាព និងនិរន្តរភាព នៃវិធានការបង្ការ និង ការប្រយុទ្ធទប់ស្កាត់ការរីករាលដាល មេរោគអេដស៍ និងជំងឺអេដស៍ នៅក្នុងប្រទេស។
គ្រប់កន្លែងធ្វើតេស្តមេរោគអេដស៍ និងជំងឺអេដស៍ ត្រូវកំណត់យកវិធានការ ក្នុងការធានាចំពោះការរក្សាភាពសំងាត់នៃរបាយការណ៍ កំណត់ត្រាវេជ្ជសាស្ត្រ ព័ត៌មានផ្ទាល់ខ្លួន រួមបញ្ចូលទាំងព័ត៌មានទាំងអស់ ដែលអាចទទួលបានពីប្រភពព័ត៌មានផ្សេងៗ ក្នុងការអនុវត្តន៍កម្មវិធីតាមដានត្រួតពិនិត្យ ។
កម្មវិធីតាមដាន ត្រួតពិនិត្យនេះ ត្រូវប្រើប្រាស់នូវប្រព័ន្ធលេខកូដ ដើម្បីធានាឱ្យមានភាពអនាមិក។
ការតាមរកប្រភពចម្លងមេរោគអេដស៍/ជំងឺអេដស៍ និងសកម្មភាពស្រាវជ្រាវសំងាត់ផ្សេងៗ ទាក់ទង នឹងសុខភាពអាចត្រូវបន្តតាមដានដោយក្រសួងសុខាភិបាល និងស្ថាប័នពាក់ព័ន្ធប្រសិនបើ សកម្មភាព ទាំងអស់នោះ មិនផ្ទុយទៅនឹងគោលបំណងទូទៅនៃច្បាប់នេះ ។
ព័ត៌មានដែលទទួលបានត្រូវរក្សា ភាព សំងាត់ និងត្រូវទុកដាក់ ឱ្យបានត្រឹមត្រូវ ។
ការរក្សាភាពសំងាត់
អ្នកមាន មេរោគអេដស៍ /ជំងឺអេដស៍ ត្រូវទទួលបាននូវការរក្សាភាពសំងាត់។
អ្នកមានអាជីពផ្នែកវេជ្ជសាស្ត្រ កម្មករ និយោជក ទីភ្នាក់ងារជ្រើសរើសបុគ្គលិកនានា ក្រុមហ៊ុនធានា រ៉ាប់រង អ្នកបញ្ចូលទិន្នន័យ អ្នករក្សាសំណុំឯកសារទាក់ទងនឹងមេរោគអេដស៍/ជំងឺអេដស៍ និងអ្នកដែលមាន ភារកិច្ចពាក់ព័ន្ធផ្សេងៗទៀត ត្រូវបានទទួលការណែនាំ ឱ្យមានការយកចិត្តទុកដាក់ ពីការរក្សាភាពនៅក្នុងទំនាក់ទំនងការងារ ជាពិសេសអត្តសញ្ញាណ និងស្ថានភាពផ្ទាល់ខ្លួន របស់ជនដែលមានមេរោគអេដស៍ ។
ការរក្សាភាពសំងាត់ផ្នែកវេជ្ជសាស្ត្រ ត្រូវលើកលែងនៅក្នុងករណី ៖
តម្រូវឱ្យធ្វើរបាយការណ៍ ដែលស្របទៅនឹងកម្មវិធីតាមដាន ត្រួតពិនិត្យរក មេរោគអេដស៍ /ជំងឺអេដស៍ ដូចដែលបានចែងក្នុងមាត្រា៣០នៃច្បាប់នេះ ។
ផ្ដល់ព័ត៌មានទៅដល់បុគ្គលិកសុខាភិបាល ដែលធ្វើការព្យាបាល ឬថែទាំអ្នកមាន មេរោគអេដស៍ /ជំងឺអេដស៍ ដោយផ្ទាល់ ឬ ដោយប្រយោល ។
ចម្លើយតបទៅនឹងដីកាចេញដោយតុលាការ ចំពោះបញ្ហាសំខាន់ទាក់ទងទៅនឹងការមាន មេរោគអេដស៍/ជំងឺអេដស៍ របស់បុគ្គលណាម្នាក់។
ភាពសំងាត់នៃកំណត់ត្រាវេជ្ជសាស្ត្រ ត្រូវដាក់ក្នុងស្រោមបិទឱ្យ បានត្រឹមត្រូវដោយអ្នកគ្រប់គ្រងឯកសារ បន្ទាប់ពីត្រូវត្រួតពិនិត្យ យ៉ាងហ្មត់ចត់ ដោយអ្នកមាន ភារៈទទួលខុសត្រូវ ព្រមទាំងប្រគល់ឱ្យដោយផ្ទាល់ដៃ និង បើកជាផ្លូវការ ដោយចៅក្រម នៅចំពោះមុខអង្គជំនុំជម្រះក្ដីសំងាត់។
លទ្ធផលនៃការធ្វើតេស្ដមេរោគអេដស៍/ជំងឺអេដស៍ អាចផ្ដល់ឱ្យ ៖
ក. ជនដែលសុំធ្វើតេស្ដមេរោគអេដស៍/ជំងឺអេដស៍ ដោយស្ម័គ្រចិត្ត ។
គ. ជនដែលត្រូវបានអនុញ្ញាតឱ្យទទួលលទ្ធផលនេះ សម្រាប់កម្មវិធីតាមដានត្រួតពិនិត្យមេរោគអេដស៍/ជំងឺអេដស៍ ដូចដែលមានចែងក្នុងមាត្រា៣០នៃច្បាប់នេះ និង
គោលនយោបាយ និង សកម្ម ភាពនៃការរើសអើង
គ្រប់ស្ថាប័នអប់រំបណ្ដុះបណ្ដាលទាំងអស់ មិនត្រូវបដិសេធបណ្ដេញ ដាក់វិន័យដាក់ ឱ្យនៅដាច់ដោយឡែក ឬ មិនអនុញ្ញាតឱ្យចូលរួមទទួលផលប្រយោជន៍ ឬសេវាផ្សេងៗ ចំពោះសិស្ស និស្សិតណាម្នាក់ ដោយ សារតែការដឹង ឬសង្ស័យថា សិស្ស និស្សិតនោះ ឬក្រុមគ្រួសាររបស់សិស្ស និស្សិតនោះមាន មេរោគអេដស៍ /ជំងឺអេដស៍។
អ្នកមានមេរោគអេដស៍/ជំងឺអេដស៍មានសិទ្ធិពេញលេញក្នុងការស្នាក់នៅនិងធ្វើដំណើរ។
ហាមដាច់ខាតការរើសអើងចំពោះអ្នក មានមេរោគអេដស៍/ជំងឺអេដស៍ ក្នុងការ ទទួលតំណែងសាធារណៈ ។
ហាមឃាត់ដាច់ខាតការរើសអើងចំពោះអ្នកមានមេរោគអេដស៍/ជំងឺអេដស៍ ក្នុងការទទួល ឥណទាន និងការខ្ចីបុល ទាំងអស់ រួមទាំងការធានារ៉ាប់រងសុខភាព គ្រោះថ្នាក់និងអាយុជីវិត ក្នុងករណីដែល សាមីជន បំពេញបាននូវលក្ខខណ្ឌ បច្ចេកទេស ដូចពលរដ្ឋធម្មតាដែរ។
ហាមដាច់ខាតនូវការរើសអើងចំពោះអ្នកមានមេរោគអេដស៍/ជំងឺអេដស៍ នៅក្នុងមន្ទីរពេទ្យ និង អង្គភាពសុខាភិបាលនានា។
អ្នកមានមេរោគអេដស៍/ជំងឺអេដស៍ មានសិទ្ធិដូចជាប្រជាពលរដ្ឋធម្មតា ដូចដែលមានចែងនៅ ក្នុងជំពូកទី៣នៃរដ្ឋធម្មនុញ្ញព្រះរាជាណាចក្រកម្ពុជា ។
ត្រូវបានបង្កើតអាជ្ញាធរជាតិប្រយុទ្ធនឹងជំងឺអេដស៍ ដើម្បីដឹកនាំ និង អនុវត្តការងារបង្ការ និងការប្រយុទ្ធទប់ស្កាត់ការរីករាលដាល មេរោគអេដស៍/ជំងឺអេដស៍ នៅក្នុងព្រះរាជាណាចក្រកម្ពុជា ។
នាយករដ្ឋមន្ត្រី ត្រូវបានតែងតាំងជាប្រធានអាជ្ញាធរជាតិ ប្រយុទ្ធនឹងជំងឺអេដស៍ ។
ក្នុងករណី ដែលនាយក រដ្ឋមន្ត្រី មិនអាចបំពេញមុខនាទីនេះដោយផ្ទាល់បាន នាយករដ្ឋមន្ត្រីអាច ចាត់តាំង សមាជិក រាជរដ្ឋាភិបាលម្នាក់ ជំនួស ។
ការរៀបចំ និងការប្រព្រឹត្តទៅរបស់អាជ្ញាធរជាតិ ប្រយុទ្ធនឹងជំងឺអេដស៍ ត្រូវកំណត់ ដោយអនុក្រឹត្យ ។
រដ្ឋ ត្រូវបញ្ចូលកម្មវិធីប្រយុទ្ធនឹងជំងឺអេដស៍ ជាការងារអាទិភាព នៃកម្មវិធីអភិវឌ្ឍជាតិ នឹងត្រូវ ជំរុញ និង សម្រួលក្នុងការផ្ដល់ថវិកាប្រចាំឆ្នាំ ឱ្យបានទាន់ពេលវេលា ដើម្បីឱ្យកម្មវិធីនេះ ទទួលបាននូវប្រសិទ្ធភាព។
ថវិការបស់អាជ្ញាធរជាតិ ប្រយុទ្ធនឹងជំងឺអេដស៍ ត្រូវបានរៀបចំសម្រាប់ក្រសួងពាក់ព័ន្ធ ខេត្ត-ក្រុង ទូទាំងព្រះរាជាណាចក្រកម្ពុជា និងត្រូវបានចាត់ជាថវិកាឧបសម្ព័ន្ធ របស់ក្រសួងសុខាភិបាល និង ត្រូវបានបញ្ចូលទៅក្នុងជំពូកថវិកាអាទិភាព ។
ដើម្បីធានាប្រសិទ្ធភាពនៃការឆ្លើយតបជាពហុវិស័យ អាជ្ញាធរជាតិប្រយុទ្ធនឹងជំងឺអេដស៍ត្រូវទទួល បន្ទុកក្នុងការកៀរគរប្រភពធនធានទាំងក្នុងប្រទេស សម្របសម្រួល និងតម្រង់ការប្រើប្រាស់ ប្រភពធនធានទាំងនេះដល់ស្ថាប័នពាក់ព័ន្ធស្របទៅតាមស្ថានភាព និង តម្រូវការជាក់ស្ដែង នៃកម្មវិធីផែនការយុទ្ធសាស្ត្រជាតិ ។
ក្នុងករណីពុំរាងចោល ត្រូវផ្ដន្ទាទោសទ្វេមួយជាពីរ ។
ឯមន្ត្រីរាជការ ត្រូវទទួល ទណ្ឌកម្មបន្ថែមផ្នែករដ្ឋបាល ។
ករណីពុំរាងចោល ត្រូវផ្ដន្ទាទោស ទ្វេជាពីរ ។
ទោសនេះ ពុំទាន់រាប់បញ្ចូលនូវការទទួលខុសត្រូវ លើសំណងផ្នែករដ្ឋប្បវេណី និងការដកហូត អាជ្ញាប័ណ្ណប្រកបវិជ្ជាជីវៈ ដែលពាក់ព័ន្ធ។
ឯមន្ត្រីរាជការត្រូវទទួលទណ្ឌកម្មបន្ថែមផ្នែករដ្ឋបាល ។
ករណីពុំរាងចាលត្រូវផ្ដន្ទាទោស ទ្វេមួយជាពីរ។
ឯមន្ត្រីរាជការ ត្រូវទទួលទណ្ឌកម្មបន្ថែមផ្នែករដ្ឋបាល ។
ករណីពុំរាងចាល ត្រូវផ្ដន្ទាទោសទ្វេមួយជាពីរ ។
អវសានប្បញ្ញត្តិ
បទប្បញ្ញត្តិទាំងឡាយណាដែលផ្ទុយនឹងច្បាប់នេះ ត្រូវទុកជានិរាករណ៍។
បានទ្រង់យល់ រដ្ឋធម្មនុញ្ញនៃព្រះរាជាណាចក្រកម្ពុជា
