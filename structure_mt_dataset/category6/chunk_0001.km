ឈឺសព្វសព៌ាង្គកាយ
ឈឺសព្វសព៌ាង្គកាយ
មនុស្សម្នាកាលបើឃើញសភាពមិនស្រួលក៏នាំគ្នារត់អស់ទៅរកជម្រកលាក់ខ្លួនបាត់អស់ដែរ
សមគ្មានថ្នាំ គ្មានគ្រូពេទ្យទៀតផង ម្ល៉ោះហើយកូនក្មេងស្លាប់អស់ច្រើនណាស់ ។
ប្ដីប្រពន្ធសមគ្នា
សមតែយើងទៅសួរសុខទុក្ខនឹងគាត់ ។
សមនឹងចៅហ្វាយមិនយកចិត្តទុកដាក់ កូនចៅក៏មិនរវល់ដែរ ។
សមបីខ្ញុំខំធ្វើការប៉ុណ្ណឹងហើយ សឹងចិញ្ចឹមខ្លួនពុំរស់ ។
បានសម្រេច ប្រយោជន៍សមបំណង
មិនសមមាត់នឹងនិយាយទៅរក
មានមូលហេតុសមស្របនឹងជឿថា
ហួសពីសមត្ថភាពច្បាប់របស់ខ្លួន
រោងចក្រទាំងអស់ជារបស់សមូហភាព ។
រថយន្តថ្មីទាល់តែផុតកំណត់ សម្និទ្ធទើបបើកលឿនបាន ។
ស្រីខ្មែរច្រើនមានសម្បុរសណ្ដែកបាយ ។
អាហារណាដែលសម្បូរជាតិការ៉ូតែន
សម្ភារៈដែលបាត់បង់ មានតម្លៃសរុបចំនួន ១.០៦៥ ដុល្លារ ។
យើងបានឆ្លងកាត់ភូមិតូចៗជាច្រើន ហើយសសៀរតាមផ្លូវរថភ្លើងភ្នំពេញ កំពត។
កុកសាប់រកស៊ីដោយវាលត្រាញ់ សស្រាក់សស្រាញ់គ្មានចាប់ភ្លឹក
ខឹងក្នុងចិត្តត្បិតម្ដាយសហាយនឹងពស់ ។
នេះជាឱកាសមួយគួរតែសាកល្បងនូវការ ព្យាបាលដោយម្ជុលវិទ្យាសាស្ត្រ ។
របបខ្មែរក្រហមបានសាងទុកនូវសោកនាដកម្មដល់ជនជាតិខ្មែរគ្រប់ជាន់ថ្នាក់ ។
ជនជាតិខ្មែរគ្រប់មជ្ឈដ្ឋានបាននាំគ្នាសាងទុកនូវវត្តមួយជានិមិត្តរូបនៃព្រលឹងជាតិរបស់ខ្លួននៅសហរដ្ឋអាមេរិក ។
ស្រីនោះរកស៊ីលក់សាច់ឆៅ ។
សៀវភៅសាធុក្រឹត
សាមគ្គីភាពរវាងជនជាតិអាស៊ី
ចំពោះពពួកក្រុមចោរសាមាន្យ
ការរីកសាយភាយអាវុធនុយក្លេអ៊ែរ
ជួយការពារកោសិកាក្នុងរាងកាយដែលត្រូវបំផ្លាញដោយសារធាតុសេរី ។
នៅក្នុងពិធីមង្គលការ មានមនុស្សម្នាចាស់ទុំក្មេងចាស់ប្រុសស្រី ព្រមទាំងនូវគ្រប់សារពើភាពផង ។
ការរួមសិចទាំងនេះ
ចាំខ្ញុំងូតទឹកសិន ។
នៅទីនោះមានម៉ាស៊ីនកិនថ្មរាប់ សិបគ្រឿងដែលកែច្នៃពីម៉ាស៊ីនកិនស្រូវ ។
ដើម្បីពិភាក្សាស៊ីជម្រៅ
ក្ដៅស៊ីរាក់ ត្រជាក់ស៊ីជ្រៅ
ក្នុងចំណោមយុវនារីទាំងអស់ កូនស្រីលោក មានសម្ផស្សស៊ីដាច់គេ ។
ខ្ញុំចង់ទៅលេងស្រុកខ្មែរ ប៉ុន្តែស៊ីសងតែខ្ញុំមាន ប្រាក់ហើយនិងពេលទំនេរដែរ ។
ធ្វើស្រែនិងទឹក ធ្វើសឹកនិងបាយ
តាមខ្ញុំស្មាន សៀវភៅខ្មែរសឹងក៏មានដែរនៅឯបណ្ណាល័យក្នុងទីក្រុងវ៉ាស៊ីនតោនឌីស៊ី ។
សមាជិកទាំងអស់ ព្រមទាំងប្រជាជនចាស់ក្មេង សុទ្ធតែចេះស្ដាប់សូរសម្លេងយន្តហោះសឹងតែគ្រប់ធុន ដែលមានហោះហើរនៅក្នុងទឹកដីខ្មែរ ។
ខ្ញុំសុខចិត្តដើរទៅរកនាងយ៉ាងរហ័ស ។
យើងសុទ្ធតែជាសិស្សទាំងអស់គ្នា ។
នៅថ្ងៃនោះ សុទ្ធតែបងប្អូនខ្ញុំទាំងអស់ធ្វើពិធីបុណ្យកាន់បិណ្ឌ ។
ព្រោះតំបន់ប៉ៃលិនមានសុទ្ធតែមីនដេរដាសក្រាស់ឃ្មឹក ដែលជារបាំងការពារ ។
សៀវភៅនេះដូចជាសៀវភៅខ្ញុំសុទ្ធសាធ ។
សិស្សត្រូវមានសុវចភាព ទើបសម្រេចប្រយោជន៍ក្នុងការរៀនសូធ្យ ។
មានកិត្តិនាមល្បីសុសសាយទួទៅទាំងពិភពលោក
ស៊ូស្លាប់ជាជាងរស់នៅជាខ្ញុំគេ ។
ទ្រង់នឹកឃើញដល់គុណូបការៈសេនាមឿង ដែលស៊ូប្ដូរជីវិតចំពោះព្រះអង្គ
ប៉ុន្តែ ក្នុងខែកញ្ញាកន្លងទៅនេះ គឺសូន្យតែម្ដងរកមួយគ្រាប់ធ្វើថ្នាំគ្មាន ។
សូមជម្រាបមកលោកឪពុកនិងអ្នកម្ដាយសូមជ្រាប
នៅស្រុកគេៗខំធ្វើការណាស់ សូម្បីថ្ងៃសៅរ៍អាទិត្យក៏គេធ្វើដែរ ។
ពួកវាមានចិត្តឃោរឃៅ ណាស់ សូម្បីតែកូនក្មេងក៏វាសម្លាប់ដែរ ។
សូម្បីតែគាត់មានចិត្តអំណត់ដល់ម្ល៉ឹងហើយ សឹងទ្រាំនឹងម្ដាយក្មេកពុំបាន ។
ខ្ញុំសូវស្លាប់ ខ្លួន កុំឲ្យរស់នៅគ្មានកិត្តិយស ។
ផ្លែឈើនេះមិនសូវល្អទេ ។
ខ្ញុំមិនសូវចេះអង់គ្លេសទេ ។
ខ្ញុំមិនសូវចូលចិត្តអ្នកស្រីនោះប៉ុន្មានទេ ។
តែងយកចិត្តទុកដាក់ដល់ផលប្រយោជន៍សួនតួ
ដើរសៀរតាមមាត់ស្ទឹង
ថ្ងៃមួយកុមារឧទេនចូលសេពគប់នឹងពួកហ្មដំរី
ប្រជាពលរដ្ឋខ្មែរ ថាសភាពការណ៍ចោរប្លន់ដែលមាននោះ ឥឡូវនៅតែមានសេសសល់ ដដែល
តាមតែស្ថានភាពអាក្រក់ល្អសោតណាចុះ ខ្ញុំនឹងជួយលោកឲ្យទាល់តែបានសម្រេច ។
នៅតាមផ្លូវទៅប្រាសាទអង្គរមានសោតសឹងតែព្រៃ ។
ថាក្មេងៗចុះវាមិនដឹងអីសោត ឯប្អូនប្រុសខ្ញុំក៏អញ្ចឹងដែរ ។
តាមតែសោតណាចុះ ខ្ញុំត្រូវតែឲ្យកូនខ្ញុំរៀនទាល់តែសម្រេច ។
តាមតែស្ថានភាពល្អអាក្រក់សោតណាចុះ ខ្ញុំនឹងជួយគាត់ ។
លោកត្រូវមានប្រាក់គ្រប់គ្រាន់ បើពុំនោះសោតគេមិនលក់ផ្ទះនោះឲ្យលោកទេ ។
លុះចប់ព្រះគាថាហើយ ស្រីទាំងប្រាំរយនោះ ក៏បានដល់នូវសោតាបត្តិផល
មកដល់ពេលមួយរវាង គ.ស.១៩២៧ ដែលធ្វើបុណ្យអភិសេកហ្លួង មុនិវង្ស ឡើងសោយរាជ្យ
ខ្ញុំចង់ទៅទស្សនាប្រាសាទអង្គរវត្ត តែខ្ញុំគ្មានសោហ៊ុយធ្វើដំណើរ ។
រាជការសុំឲ្យអស់បណ្ដារាស្ត្រយកចិត្តទុកដាក់ខំប្រឹងធ្វើការនេះឲ្យបានសម្រេចឆាប់ ។
ឈ្មោះរបស់សារពាង្គកាយមួយផ្សំឡើងដោយពាក្យពីរម៉ាត់ ពាក្យទីមួយសំគាល់ពួក ឯពាក្យទីពីរសំគាល់ប្រភេទ
ល្វ ល្ព សំដែងនូវគំនិតទាក់ទងនឹងអ្វីដែលទន់ភ្លន់ សុខដុម ។
យើងដើរសំដៅទៅមាត់បឹង ។
ពេលទៅដល់ខេត្តកោះកុង ខ្ញុំដើរសំដៅទៅផ្ទះបងធម៌របស់ខ្ញុំតែម្ដង
ក្រុមនោះបាញ់ សំដៅកង់រថយន្តតែមិនត្រូវកង់ទេ គឺទៅត្រូវធុងសាំង
ជម្លោះប្រាសាទព្រះវិហាររវាងខ្មែរថៃ សំដៅលើការដែលខ្មែរដាក់ប្រាសាទនេះជាបេតិកភណ្ឌពិភពលោក ។
មានការគាំទ្រយ៉ាងពេញទំហឹងពីសំណាក់អង្គការប្រឆាំងរបបកុម្មុយនិស្ត
ជាសំណាងល្អ គាត់អាចគេចផុត ពីការប៉ុនប៉ងចាប់រំលោភនោះ ។
អាស្រ័យហេតុនេះ យើងខ្ញុំសូមសំណូមពរដល់ប្រធាននាយកដ្ឋានផ្នែកភាពយន្តគ្រប់ជាន់ថ្នាក់
ប្រាក់ប៉ុណ្ណឹងមិនសំនួនដល់ការទេ ។
អាការសាហាវមួយសំបក
ខ្ញុំមានតែសំបកខ្លួន ។
វត្ថុនេះមានទិដ្ឋភាពជាសំយោគគិន ។
នាងសម្រក់ទឹកភ្នែកចំពោះមុខខ្ញុំ
គេប្រើម៉ាស៊ីនសម្រាប់បូមទឹក ។
មន្ទីរឬក្រុមនេះ មានភារៈសម្រាប់ ចាត់ចែងដឹកជញ្ជូនឥវ៉ាន់ពីតំបន់ស្អាងកោះធំយកទៅភូមិភាគពិសេស
ខោអាវមួយសម្រាប់
ស្បែកជើងមួយសម្រាប់
ម្ដាយខ្ញុំរៀបសម្រាប់ប្រគេនលោក ។
សូមឲ្យបានសំរឹទ្ធិដូចសេចក្ដីប្រាថ្នា !
ចំណាប់និងមិត្តភក្តិនារីៗ ទាំងអស់គេនាំគ្នាជួយសម្រួលចិត្តដាលីន ។
ស្រីពេស្យាខកខ្លួនមួយរូបបានធ្វើអត្តឃាត ប៉ុន្តែមិនបានសម្រេច
ឆ្កឺះថ្នាំជ្រាយលាបអណ្ដាតជាដើម ដើម្បីឲ្យសះជារោគ ។
អ្នកទាំងពីរមិនចង់បែកឃ្លាតឃ្លាពីគ្នាសោះ
បងប្អូនខ្ញុំទាំងអស់បានទៅក្នុងពិធីបុណ្យបញ្ចុះសីមា តែខ្ញុំមិនបាន ទៅធ្វើនឹងគេសោះ ។
បានម្ដាយនិងបងស្រីគាត់មិនទៅរាល់គ្នាស្រួលហើយ សោះខ្ញុំនឹងទៅ ។
ទន្លេដប់មិនស្កប់នឹងសមុទ្រមួយ ។
ខ្សែភាពយន្តវីដេអូនេះ ខ្ញុំចូលចិត្តណាស់ ខ្ញុំមើលច្រើនដងទាល់តែស្កល់ ។
នៅជាមួយគ្នាជាសុខឥតដែលស្កៀបរមាស់ទេ
ម្ហូបប៉ុណ្ណឹងមិនស្កៀបជើងធ្មេញខ្ញុំទេ ។
កុំនិយាយធ្វើជាល្អអញ្ចឹងនោះ គេស្គាល់ក្រយៅលោក អស់ហើយ ។
ព្យុះសង្ឃរាបានស្ងប់ទៅវិញហើយ ។
ហ្វូង ត្រីនាំគ្នារកស៊ីចំណីស្ញែស្ញុកនៅក្រោមស្ពាន ។
ព្រោះឈាមដែលស្តុកទុកសម្រាប់សង្គ្រោះ ទើបតែផ្ដល់ឲ្យអ្នកជំងឺមុននេះ
ក៏ធ្វើជាស្លាប់ ដេកស្ដូកស្ដឹងនៅកណ្ដាលផ្លូវ ។
ក្មេងនេះចំជាស្ដេចខូច ។
ពីរនាក់នេះ អង្គុយឲ្យស្ទាប់គ្នា ។
គេញ៉ាំត្រសក់ស្ទាប់ជាមួយប្រហុក ។
តាមមាត្រា ៣០ ស្ទួននៃរដ្ឋធម្មនុញ្ញ
ស្ទើរតែដេកមិនលក់ទាល់ភ្លឺ ។
នាងស្ទុះឡើងទៅបន្ទប់យ៉ាងលឿន ហើយប្រាសខ្លួនទៅលើគ្រែពូក
កើតស្នឹមក្នុងផ្ទះ ។
ស្រីនេះសំបូរស្នេហ៍ ។
នេះមកពីក្នុងប្រទេសយើង សម្បូរទៅដោយអ្នកស្នេហាសិល្បៈភាពយន្តវីដេអូ
គាត់មិនស្ម័គ្រចិត្តធ្វើការទេ ។
ស្ម័គ្រចិត្តស្ម័គ្រកាយដើម្បីបម្រើជួរកងទ័ព
មានបុរសម្នាក់និងស្រីម្នាក់ជាស្មន់អន្ធករផងគ្នា
កូនស្រីសោះស្មានថាជាប្រុស ។
មានរាងស្មើចុងស្មើដើម
បន្ទប់គេងខ្ញុំទាំងពីរមានទំហំស្មើគ្នា ។
ស្រះទាំង ៤ នោះសឹងមានចម្ងាយនោះស្មើគ្នា ។
ខ្ញុំ ស្រឡាញ់ឪពុកម្ដាយខ្ញុំស្មើដោយជីវិត ។
មកដល់ស្រករគ្នា
ខ្លួនឯងស្រកាកមិនគិត គិតតែទូន្មានប្រដៅ គេឲ្យកាន់សីល ។
សត្វលាមាន រូបរាងស្រដៀងនឹងសត្វសេះ ប៉ុន្តែលាមានត្រចៀកវែងជាង ។
ស្របតាមសំណូមពររបស់អ្នកស្រុក រដ្ឋការត្រូវចាត់ឲ្យមានគ្រូពេទ្យធំប្រចាំស្រុកយ៉ាងតិចណាស់ក៏ម្នាក់ដែរ ។
អាយុស្របាក់ស្របាលគ្នា
ស្រមៀនអៀនប្រៀនឃើញខ្លា មុខដូចខ្មោចណ៎ា មមឹសក្នុងអណ្ដូងខ្មី ។
ចេះតែ្រមៃឃើញវង់ភក្ត្រដ៏ផូរផង់ និងស្នាមញញឹមយ៉ាងស្រស់របស់នាង
ភ្នែកខ្ញុំស្រវាំងកាន់តែខ្លាំង ។
នៅកន្លែងសម្រាកខាងមុខ មានគេលក់ម្ហូបឆ្អិនស្រាប់ ។
ខ្ញុំមិនមែនជាមេទាហានជាវិជ្ជាជីវៈអីទេ ខ្ញុំពីដើមដឹងស្រាប់ហើយ ពីដើមខ្ញុំជាគ្រូបង្រៀន
ព្រោះដើមឈើធម្មជាតិមានស្រាប់ពេញផ្ទៃដីក្នុងខេត្ត យើងគ្រាន់តែ ចំណាយប្រាក់ពង្រីកការថែរក្សាវាជាការល្អបំផុត ។
លោកឃើញស្រាប់ហើយ វាមិនធ្វើការអ្វីសោះគិតតែពីដើរលេងប៉ុណ្ណោះ ។
ព្រឹកមិញខ្ញុំស្រួលខ្លួនសោះ ស្រាប់តែ ឥឡូវខ្ញុំបែកញើសដង្ហើមថប់ៗស្រឺតៗ តែម្ដង ។
វេលាដែលខ្យល់គចាប់នាង សូយាដួលស្រ៊ុបទៅលើព្រះធរណី
ស្រូបប្រាក់ច្រើនទៅលើជំនួញស្រូវ
សេដ្ឋកិច្ចចុះថយហើយ ស្រួលមិនស្រួលលោកប្រធានាធិបតីមិនជាប់ឆ្នោតទៀតទេ ។
ខ្លួនចាស់ហើយនៅតែស្រើបស្រាល ។
រឿងបណ្ដឹងក្ដីនេះត្រូវស្រេចសេចក្ដីដោយចៅក្រម ។
បានជាមកហើយ ធ្វើឲ្យហើយស្រេចតែម្ដងទៅ កុំឲ្យពិបាកច្រើនដង ។
បាយសម្លដួសដាក់ចានស្រេចហើយ គ្រួសារទាំងអស់ចូលអង្គុយជុំវិញតុ ។
នាងវីន ឃើញរំដួលស្លឺអញ្ចឹងសួរភ្លាម
សូមស្លេះត្រឹមណេះសិន ។
រឿងនេះ ខ្ញុំសូមស្លេះរំខានលោកទាំងអស់គ្នាប៉ុណ្ណេះសិន ចាំថ្ងៃក្រោយនិយាយទៀត ។
កងកម្លាំងយើងបានខំតស៊ូយ៉ាងស្វិតស្វាញ ។
ផ្ទៃក្នុងប្រទេសក៏ដូចជានៅលើឆាកអន្តរជាតិ កងកម្លាំងប្រដាប់អាវុធយើងរួមសហការស្អិតល្មួតជាមួយគ្រប់
គាត់បាននិយាយថា គណបក្សដាក់ឈ្មោះខ្លួនឯងជាឈ្មោះគណបក្ស តើជាគណបក្សប្រជាធិបតេយ្យស្អីទៅ ?
ភ្នែកអានេះស្អុយមែន ។
ខ្ញុំសង្កេតឃើញអ្នកម៉ែដាលីនធ្វើមុខស្អុយប៉ែ ហើយមិនសូវនិយាយស្ដីឡើយ ។
មើលពីចម្ងាយទៅ ឃើញហាក់ដូចជាសង់ជាប់ផ្ទាល់នឹងទឹក
រីឯមហិទ្ធិឫទ្ធិ ហាក់បីដូចជាពុំដឹងមកពីណា
ហាច់ជាស្រេចទៅហើយ ។
ជក់បារីពីរឬបីហឺត
ឃើញថាពេលវេលាហុចឲ្យ
គេរត់ហុយបែកផ្សែង ។
ធ្វើការហួសកម្លាំង
ជិះឡានហួសផ្ទះ
និយាយមិនហើបមាត់
មិត្តខ្ញុំនិងខ្ញុំ ហើយគ្នាតែប៉ុណ្ណោះ ។
មិត្តខ្ញុំហើយគ្នានឹងប្រពន្ធគាត់ ។
ធ្វើការមិនទាន់ហើយទេ ។
យើងសង្ឃឹមថាសាធារណរដ្ឋខ្មែរច្បាស់ជាមានរដ្ឋធម្មនុញ្ញហើយនៅពេលបន្តិចទៀត ។
សំដីហើរតាមខ្យល់
ហៀបនឹងទៅដល់ស្រាប់តែខូចឡានតែម្ដង ។
ពេលហៀបភ្លឺ ខ្ញុំតែងតែឮសូរសំឡេងបក្សាបក្សីយំខ្ញៀវខ្ញារលើចុងព្រឹក្សានាមាត់បន្ទប់គេងខ្ញុំ ។
ឮស្អីបន្តិចមិនបានទេ ប្អូនស្រីខ្ញុំរត់ហេទៅទូលពិតម៉ាក់ ។
ក្រោយពីបូជាសពម្ដាយគេរួចហើយ អ្នកកំឡោះនៅតែហេងហាងធីងធោងដដែល
ហេតុតែបញ្ហាថៃឈ្លានពានបូរណភាពខ្មែរនេះហើយ បានជាខ្ញុំឈប់មើលកុនថៃ ។
ប្រើឡានមិនមើលទឹកមើលប្រេង ហេតុនេះបាន ជាខូចយ៉ាងហ្នឹង ។
ខ្មែរក្រហមក៏ដូចជាខ្មែរខៀវ ហេតុនេះបានជាប្រទេសខ្មែរធ្លាក់ក្នុងសភាពយ៉ាងហ្នឹង ។
ពួករដ្ឋការសម័យថ្មីរឹតតែពុករលួយជាងមុនទៅទៀត ហេតុនេះហើយបានជាពួកខ្មែរក្រហមកាន់តែវាយយ៉ាងខ្លាំងតទៅទៀត ។
ហេតុភូតនៃជម្លោះគឺមកពីខ្សែបន្ទាត់ព្រំដែនមិនច្បាស់លាស់ ។
គាត់និងខ្ញុំមានហេតុនឹងគ្នា ។
ធាតុអាកាសថ្ងៃនេះ ក្ដៅហែង ។
ចប់តែប៉ុណ្ណេះហោង ។
គំលាតរវាងអ្នកមាននឹងអ្នកក្រនៅកម្ពុជាហៅមិនឮ ។
និយាយយ៉ាងម៉េច ហ៎ះ ?
ផ្សារហ្នឹងឈ្មោះផ្សារអង្គរ ។
ហ្នឹងហើយ ខ្ញុំព្រមហើយ ។
ជំងឺឪពុកខ្ញុំបានធូរស្បើយ ស្រាប់តែឡប់មកវិញ ។
ស្អែកយើងឡើងអូតូរ៉ៃទៅបាត់ដំបង
បបូរមាត់ឡើងស្វាយ ស្ទើរគ្មានឈាមមួយដំណក់
ដល់មានរងាវកឺត ប្រុសៗភ្ញាក់ឡើងឃើញផ្កាយព្រឹករះ
ពន្លឺសន្តិភាពនៅស្រុក ខ្មែរមានរូបរាងកាន់តែច្បាស់ឡើងហើយ ។
ពិធីនេះបានរៀបចំឡើងដោយរដ្ឋលេខាធិការដ្ឋានកិច្ចការនារី ។
សុំមើលសេចក្ដីនេះឡើងវិញ ។
យើងអស់មានឧបសគ្គអ្វីមករារាំងក្នុងដំណើរយើងទៅកាន់ការចាប់កំណើតរស់ឡើងវិញនៃប្រជាជាតិយើង ទៀតហើយ ។
មាសសព្វថ្ងៃ មានតម្លៃឡើងចុះៗ ។
ខ្ញុំរវល់ធ្វើការ ខ្ញុំមិនដែលមានពេលទំនេរសោះឡើយ ។
សត្វទាំងឡាយតែងឡែឡប់កើតស្លាប់ឥតឈប់ឥតស្រាក ។
លោកអញ្ជើញមកពីប្រទេសខ្មែរវិញពីអង្កាល់ ?
មិនគិតធ្វើការធ្វើងារនឹងគេ អង្គុយចាំតែស៊ីដោយសារគេ ។
អង្រៀតនឹងស្លាប់គាត់ដកចង្កាមាន់ ។
សែសិបអង្សាក្រោមសូន្យ
អញ្ចឹងទើបសមនឹងនាងឯង ។
ថ្ងៃនេះជាថ្ងៃអាទិត្យ អញ្ចឹងយើងសំអាតផ្ទះឲ្យហើយទៅ ។
ម្នាក់ថាអញ្ចេះ ម្នាក់ទៀតថាអញ្ចុះ ។
ខ្ញុំអញ្ជើញអ្នកនាងនិងអ្នកគ្រូពេទ្យឡើងលើផ្ទះ
អង្គុយតាមអណ្ដាប់អណ្ដោយ
អង្គុយតាមអណ្ដាប់អណ្ដោយ
ជនអន្តោប្រវេសន៍ខុសច្បាប់ដែលកំពុងហូរចូលយ៉ាងអនាធិបតេយ្យ
គួរឲ្យអនិច្ចាណាស់ ។
ខ្ញុំបានសុំការអនុញ្ញាតពីមេបនត្រឡប់មកស្រុកកំណើតវិញ
អន្តរាគមន៍ទៅលើក្រុមមនុស្សដែលប្រឈមមុខនឹងគ្រោះថ្នាក់
ប្រទេសខ្មែរចំរើនរុងរឿងដោយសំបូរណ៍ សម្បត្តិធម្មជាតិមួយអន្លើ ដោយមានអ្នកចេះដឹងច្រើនផង ។
ក្នុងការធ្វើទឹកត្នោតជូរប្រភេទនេះ បំពង់ដែលប្រើសម្រាប់ត្រង់មិនចាំបាច់អប់ទេ ។
ប្រជុំសន្និបាតដើម្បីរកសន្តិភាពឲ្យខ្មែរអស់ច្បាប់ហើយ នៅតែពួក ខ្មែរក្រហមពុំពេញចិត្ត ។
អស់ទាំងនិស្សិត
ខ្ញុំអស់ប៉ុន្មានក៏អស់ទៅ ឲ្យតែបានស្អាតប៉ុណ្ណឹងៗ
ម្ហូបនេះឆ្ងាញ់អស់យ៉ាង ។
នៅផ្សារធំមានរបស់អស់យ៉ាង ។
អស់អំបាលមិត្តខ្ញុំ មានតែវណ្ណាទេដែលស្គាល់ចិត្តខ្ញុំ ។
អស់អំបាលកិច្ចការខាងមុខ សុទ្ធសឹងជាកិច្ចការចាំបាច់ ។
ដើម្បីបំបាត់ចោលបញ្ហាអសកម្មនេះ
អាការខ្លាចនេះ ខ្លាចនោះ របស់មនុស្សយើង
យើងយល់ថាចម្លើយទាំងអស់នេះអាចមានប្រសិទ្ធភាពខ្លះ តែមិនអាចបន្ថយកម្លាំងខ្មែរ ក្រហមបានទេ ហើយក៏មិនដោះស្រាយបញ្ហាខ្មែរបានដែរ ។
តាមមតិខ្ញុំ ខ្ញុំយល់ថាយើងអាចចម្អិនដោយវិធី អាំងក្នុងចង្ក្រាន ។
ចំពោះអាត្មាភាពទាំងបួនអង្គ
ឲ្យអាទិភាពជាដំបូង
ទន្ទឹមនឹងការបរាជ័យដ៏អាម៉ាស់តាមបណ្ដោយព្រំដែនថៃកម្ពុជា
ព្រះពុទ្ធអង្គទ្រង់ឈ្វេងយល់ច្បាស់នូវផលប្រយោជន៍នៃអាមិស ទើបទ្រង់ ទើបទ្រង់អនុញ្ញាតឲ្យបព្វជិតបរិភោគ ប្រើប្រាស់អាមិស តាមការគួរ ។
ការអ្វីមិនទាន់ប្រាកដ កុំអាលហើបមាត់ថា ។
កុំអាល អាសន្នពេក ។
គ្រួសារនិមួយៗត្រូវមានប្រអប់ថ្នាំប្រចាំគ្រួសារ ក្រែងមានអាសន្នអន្ធ ក្រយប់ថ្ងៃ ។
ជនបរទេសដែល នៅអាស្រ័យប្រកបរបរក្នុងប្រទេសដទៃ
អាស្រ័យដោយសារការប្រើថ្នាំ បន្ថែមដែលសំបូរវីតាមីនអា
អីក៏ប្រញាប់ខ្លាំងម្ល៉េះអ្នកនាង ?
អ្នកទាំងអស់គ្នាចេះមេរៀននេះហើយ អ៊ីចឹងខ្ញុំបង្រៀនមេរៀនថ្មីមួយទៀត ។
គាត់មានទីលំនៅនៅភ្នំពេញ បើអ៊ីចុងសុំឲ្យគាត់ធ្វើតំណាងយើងនៅទីនោះតែម្ដងទៅ ។
កុមារឧទេនបង្គាប់ឲ្យរៀបពិធីបួងសួងសែនព្រេនអ៊ឹកអធឹក ។
ខ្ញុំសើចអឺយ សើច
ខ្ញុំសើចអឺយ សើច
ផ្លូវដែលធ្លាប់តែអ៊ូអរ
វានៅក្រមុំអូឡាក់យ៉ិន ។
ទោះជាឃើញសិស្សឯទៀតរវល់បោសសំអាតថ្នាក់ក៏ដោយ ក្មេងនោះអង្គុយអៀងហ៊ើយ ។
អូនក៏សុំពាក្យលុបអេតាស៊ីវិលចោលទៅ
កូនប្រុសខ្ញុំបានចូលជាសញ្ជាតិអាម៉េរិកាំងហើយ អំណឹះតទៅកូនចៅរបស់គេនឹងទៅជាអាម៉េរិកាំងដែរ ។
របស់ទាំងអំបាលម៉ាន នៅក្នុងវត្ត គឺជារបស់ព្រះសង្ឃ ។
ដែលជាអម្រែកធ្ងន់
សុខនអេះអុញមិនចង់និយាយ ។
មានកូនប្រុសប្រកបកិត្តិគុណនឹងចិត្តសទ្ធាដល់អ្នកផង
អ្វីដែលគេចង់ដឹងដំបូងបំផុតគឺទិដ្ឋភាព ទូទៅនៃពិភពលោក ។
កុំឲ្យ អាគីង្គក់អណ្ដើកធ្វើអ្វីបាន ។
ល្បែងអ្វី ដែលអាចធ្វើឲ្យខ្ញុំសប្បាយខ្ញុំនឹង លេងល្បែងនោះ ។
កុំធ្វើអ្វីៗដែលនាំឲ្យសុខភាពយើងអន់ថយ ។
ប្រយ័ត្នអ្ហឺ !
ខ្ញុំឥតមានការរវល់ទេ ។
ខ្ញុំសូមឧបមាឲ្យឃើញ
រកកលឧបាយសម្លាប់ព្រះអង្គច័ន្ទរាជាដែលជាស្ដេចសោយរាជ្យនាពេលនោះ
កិច្ចព្រមព្រៀងឧភតោភាគី
កូនលោកឧស្សាហ៍រៀនណាស់ ។
បងស្រីខ្ញុំឧស្សាហ៍និយាយប្រាប់ ខ្ញុំពីការឧស្សាហ៍ធ្វើការរបស់លោកណាស់ ។
ម្ដាយរបស់ខ្ញុំគាត់បានពោលសរសើរនូវសម្រស់យ៉ាងស្អាត និងឫកពាយ៉ាងសុភាពរាបសាររបស់នាង
សំឡេងធនញ្ជ័យយំខ្លាំងៗពេកក៏ឮទៅដល់មហាសេដ្ឋី
ហើយហាក់ដូច ជាគ្មានសញ្ញាឯណាបញ្ជាក់ថាសង្គ្រាមនេះនឹងឈប់ស្លេះ។
ខ្ញុំទៅឯណាបានពីព្រោះថ្ងៃនេះខ្ញុំត្រូវជួបវេជ្ជបណ្ឌិត។
កាត់ទោសនៅស្រុកខ្មែរដោយផ្អែកលើច្បាប់ខ្មែរ ពិតជាធូរស្រាលដែលប្រទេសខ្លះរហូតដល់ប្រហារជីវិតឯណោះ ។
ដោយឡែកនៅខេត្តកំពង់ស្ពឺឯណោះវិញ អ្នកដែល យល់ដឹងអំពីគ្រឿងញៀនមានតែមេៗប៉ុន្មាននាក់ប៉ុណ្ណោះ ។
ខ្មែរនៅឯនាយសមុទ្រមិនដឹងរឿងក្នុង ប្រទេសទេ ។
កោះមួយនោះ ស្ថិតនៅតែឯកឯងកណ្ដាលសមុទ្រ ។
បើ សមាជិកកងអាវុធហត្ថជាតិណាម្នាក់ធ្វើអ្វីមួយខុសពីវិន័យពីច្បាប់ ទីមួយអ្នកនោះឯងត្រូវទទួលទោសតាមច្បាប់
ប្រាក់អឺរ៉ូបានឡើងថ្លៃថ្មីថែមទៀតជាឯតទគ្គកម្មប្រវត្តិសាស្ត្រទល់នឹងប្រាក់ដុល្លារ
ខ្ញុំសូមយកឱកាសនេះ
ខ្ញុំ ឲ្យប្រាក់ទៅកូនប្រុសខ្ញុំដើម្បីបង់ថ្លៃសាលា ។
ជាភ័ព្វសំណាងល្អមួយទៀតដែរ ដែលធម្មជាតិបានបង្កលក្ខណៈឲ្យប្រទេសយើងសំបូរមច្ឆាជាតិទាំងផ្នែកទឹកសាបនិងទាំងផ្នែកទឹកប្រៃ ។
សុំបណ្ដេញខ្មែរក្រហមពីអង្គការសហប្រជាជាតិ ហើយទុកកៅអីខ្មែរឲ្យនៅទំនេរ ។
លោកគ្រូខ្ញុំព្រះករុណាឲ្យខ្ញុំព្រះករុណាយកសំបុត្រនេះមកប្រគេនលោក ។
បើអញ្ចឹងមិនអីទេ យើងឲ្យបាវព្រាវទៅធ្វើផ្ទះឲ្យមួយ
ថាឲ្យខ្លាំងបន្តិច
លោកធ្វើអ្វីក៏ដោយ ឲ្យតែប្រាប់ខ្ញុំ ខ្ញុំមកជួយ។
ខ្ញុំឲ្យបានតែត្រឹមកម្រិតប៉ុណ្ណេះ ។
សូមអញ្ជើញទៅឲ្យបានសេចក្ដីសុខ ។
គាត់ខំយកគាប់គួរដើម្បីឲ្យបានឡើងបុណ្យស័ក្ដិ ។
យើងបើកទូលាយការនាំចូលឲ្យស្របទៅតាមក្រុម ហ៊ុនដែលយើងបានបង្កើតឡើង ។
ដើម្បីឲ្យអស់ចិត្តម្ដាយខ្ញុំ ខ្ញុំត្រូវតែរៀនធម៌ទៅវត្តកាន់សីលធ្វើទាន ។
គិតតែធ្វើយ៉ាងម៉េចអោយបានប្រាក់ភ្លាមៗ
ប៉ុន្តែ ដោយយោលទៅតាមការវិវត្តន៍នៃសភាពការណ៍នោះ យើងយល់ឃើញថាគេមិនត្រូវទុកឲ្យការ ខ្វែងទំនាស់គ្នាស្តីពីទិដ្ឋភាពផ្ទៃក្នុងមួយទៅជាឧបសគ្គមួយចំពោះដំណោះស្រាយនៃទិដ័ភាពអន្តរជាតិនោះឡើយ ។
ក្រោយចេញពីមន្ទីរពេទ្យ គាត់បានសេចក្ដីសុខរហូតមកដល់ឥឡូវ ។
ប៉ុន្តែ ចាំបាច់ត្រូវពុះពារឲ្យបានជ័យជំនះលើរាល់បញ្ហាស្ថិរភាពនយោបាយដើម្បីទទួលវិនិយោគទុន...។
ម្សិលមិញឡានខ្ញុំខូចនៅកណ្ដាលផ្លូវថ្ងៃនេះប៉ូលិសចាប់រាសីចុះណាស់ខែនេះ ។
ភូមិភាគបូព៌ាទិស រួមបញ្ចូលខេត្តក្រចេះស្វាយរៀងព្រៃវែងនិងកំពង់ចាម ។
ត្រូវគេរំពឹងថានឹងបានធ្វើចប់សព្វគ្រប់នៅដំណាច់ឆ្នាំនេះ ។
ដែលរំលោភលើសិទ្ធិមូលដ្ឋានរបស់ប្រជាជនកម្ពុជា ។
ពន្លឺក៏ចែងចាំងហាក់ដូចជាព្រះចន្ទ្រនឹងព្រះអាទិត្យ ១ពាន់រះឡើង ។
មជ្ឈដ្ឋានមួយចំនួនបានរិះគន់ចំពោះអំពើពុករលួយនៅក្នុងសាលាក្ដីខ្មែរក្រហម ...។
ជនកុម្មុយនិស្តត្រូវតែលត់ដំខ្លួននៅក្នុងការងារពលកម្មជាចាំបាច់ ។
ប្រជាជនកម្ពុជាបានលត់ដំនិងពុះពារគ្រប់ឧបសគ្គ ។
សូមលោកគ្រូមេត្តាពិនិត្យ និងយកឈាមខ្ញុំដើម្បីសង្គ្រោះគាត់ចុះ ។
ចាក ៩ ឆ្នាំមកហើយដែលយើងបានឃើញ កុម្មុយនិស្តយួនខិតខំជំរិតយក បុរាណវត្ថុមាសប្រាក់ទ្រព្យសម្បត្តិនិងភោគផលធម្មជាតិគ្រប់បែបយ៉ាងពីក្នុងទឹកដីខ្មែរ ជញ្ជូនយកទៅស្រុកវា រូចលបបញ្ជូនប្រជាពលរដ្ឋវាឲ្យមកជ្រៀតជ្រែក
ឈ្មោះមាន់មួយប្រភេទស្ទើគកស្ទើរចែ ។
ខ្ញុំក៏ធ្វើការដែរ
ខ្ញុំទៅទីនោះក៏ដោយសារតែខ្ញុំយល់ដល់សំឡាញ់ខ្ញុំ ។
ធ្វើដូច្នេះក៏បាន
ប៉ុន្តែខ្មែរក្រហមមកតាមផ្លូវការមកកកូរកកាយហើយ ចូលមកក្រុងភ្នំពេញ។
ទាំងអស់នេះចាត់ទុកថាជាកញ្ចក់សម្រាប់ ឲ្យបណ្ដាជនល្មើសទាំងអស់ឆ្លុះបញ្ចាំងពីទោសកំហុសរបស់ខ្លួន ។
ស្បូវមួយកណ្ដប
ក្រុងព្រះសីហនុកតលិករនៃការចំរើនលូតលាស់
ត្រីងៀតបីកន្ទុយ
បានហើយប្អូន ប្រុសអ្វីៗកន្លងផុតទៅហើយឲ្យវាកន្លងទៅចុះ ។
ពីរទសវត្សរ៍កន្លងមកនេះ
ស្ថានីយ ៥ កន្លែង
សូផាតប្រព្រឹត្តឥតឆ្គងកន្លែងណាសោះ ។
ទឹកមួយដបកន្លះ
មានជំងឺជាច្រើនដែលបានកបជាមួយការព្យាបាលដោយម្ជុលវិទ្យាសាស្ត្រ ។
កាច់ជាពីរកំណាត់
អរុន្នីដាច់ចិត្តកាត់អាល័យពីថងដាសង្សារចាស់ភ្លាម។
កន្ទេលមួយកាប់
ការចរចាសន្តិភាព
ការត្រួតត្រាសព្វាវុធ
មានការទាស់ទែងខ្វែងគំនិតគ្នា
ការបញ្ឈប់ការសាកល្បងអាវុធបរមាណូ
ចាក់ថ្នាំការពារជំងឺ
កាលខ្ញុំនៅពីយុវវ័យ ខ្ញុំចូលចិត្តលេងកីឡាបាល់បោះ
ខ្ញុំភ្ញាក់ព្រើតកាលបើឮមិត្តចាន់ប្រាប់ថា
ប្រការទាំងនេះបានផ្ដល់កាលានុវត្តភាពកាន់តែខ្លាំងឡើងសម្រាប់កិច្ចសហប្រតិបត្តិការពាណិជ្ជកម្ម
នៅពេលមានច័ន្ទគ្រាស គេសង្កេតឃើញមានកាឡភាគនៅមណ្ឌលព្រះចន្ទ្រ ។
នាងក្រមុំនារី ឈានជើងឡើងជណ្ដើរមួយៗ ភ្នែកសម្លឹងមើលចៅចិត្រដោយកិរិយាឆ្មើងឆ្មៃបន្តិច
រថយន្តដឹកកុងតឺន័រមួយគ្រឿង
អ្នកប្រើប្រាស់ភ្លើងដែលទិញកុងទ័រទិញខ្សែភ្លើងបន្តចូលផ្ទះដោយខ្លួនឯងនឹងបង់ថ្លៃទឹកតែពី ២ ទៅ ៤ ម៉ឺនរៀល
មនុស្សល្មោភបុណ្យស័ក្ដិតែងតែប្រើ កូដោបាយដើម្បីសម្រេចបំណងរបស់ខ្លួន ។
លោកបញ្ជាការកងពលធំព្រមទាំងកូនចៅរបស់លោក
កើតជាអ័ព្ទងងឹតជតសព្វទិសានុទិស។
សង្គ្រាមកើតឡើងនៅក្នុងស្រុកខ្មែរ ។
និយាយៗទៅស្រាប់តែកើលសព្ទកណ្ដាលចំណោម
ព្រោះពេលវេលាកៀកណាស់
ស្រែកេររបស់ខ្ញុំ
កេរ្តិ៍ឈ្មោះល្អ
នៅទីនោះមានម៉ាស៊ីនកិនថ្មរាប់សិបគ្រឿងដែលកែច្នៃពីម៉ាស៊ីនកិនស្រូវ ។
សហរដ្ឋជាប្រទេសមហាអំណាច កោតតែនៅមានអ្នកគ្មានទីលំនៅទៀត ។
ខ្ញុំកោតតែគាត់ធ្វើអញ្ចឹងកើតជាមួយម្ដាយគាត់ ។
កុំគិតសង្ស័យធ្វើអ្វី គាត់ជាមនុស្សត្រឹមត្រូវណាស់ ។
ពេលនោះកុំតែលោកប្រាប់ផ្លូវម្ល៉េះ ខ្ញុំវង្វេងបាត់ទៅហើយ ។
នៅតាមផ្លូវកុំបានតែប្អូនប្រុសខ្ញុំជួយ ខ្ញុំត្រូវស្លាប់ហើយ ។
សូមអ្នកទាំងអស់គ្នាកុំអាលប្រញាប់ប្រញាល់ចេញទៅក្រៅ ភ្លៀងមិនទាន់រាំងនៅឡើយទេ ។
ថ្ងៃនេះយើងកុំអាលទាន់ទិញបន្លែ ចាំថ្ងៃស្អែកបន្លែថោក ។
កុំឲ្យតែមានរឿងអ្វីបន្តិចតាំងនាំគ្នានិយាយបែកសាយាមោពាសពេញភូមិ ។
ត្រូវលៃលកចំណាយ ប្រាក់ឲ្យកូនរៀនចំណេះវិជ្ជា ត្រូវទិញគ្រឿងប្រដាប់ឲ្យកូនប្រើ ...ឲ្យប្រាក់កាសចាយវាយខ្លះ មិនកំបុតកំបួញហួសប្រមាណ ។
ពិបាកដល់កំបោរ
ប៉ុន្តែក្នុងចិត្តរបស់នាងហាក់ដូចជាបង្កប់នូវអាថ៌កំបាំងអ្វីម៉្យាង ។
ហើយទះខ្ញុំមួយកំផ្លៀងយ៉ាងដំណំ ហើយស្រែកជេរថា ស្រីថោកទាប ស្រីបោកប្រាស់ !
ថ្វីត្បិតតែកំពុងមានទំនាស់ផ្ទាល់ខ្លួននឹងលោក
ងាប់និងសំដី ដូចត្រីកំភ្លាញ ។
យើងកម្រជួបប្រទះភូមិជនបទអ្នកស្រុកណាមួយនៅតាមផ្លូវលំ ។
ខ្ញុំ ចេះមួយកម្រិតឡើងទៀត
តើអន្តរជាតិគេឈឺឆ្អាលជាមួយរឿងខ្មែរដល់កម្រិតណា ?
សូផាតទ្រាំមិនបាន ស្ទុះដេញកម្លាក្មេងទាំងនោះចេញ ។
កម្លាំង ១.០០០.០០០,០០ គីឡូវ៉ាត់
កុំកេះខ្ញុំ ។
កុំក្បាច់ក្បូរពេក !
សូមឲ្យមានដោះក្បំកុំឲ្យសណ្ដាយ
អត់ក្រញឹមក្រញ៉ុមជាមួយគាត់ទេ ។
កុំធ្វើឲ្យហួសក្របខ័ណ្ឌរបស់ខ្លួន ។
ឫស្សីមួយក្រមាល់
តរុណដើរទៅអង្គុយលើសាឡុងធ្វើមុខក្រមូវ ។
ខ្ញុំស្គាល់តែមួយក្រវល់ កន្លែងដែលខ្ញុំរស់នៅ ។
វាស្ថិតនៅក្រោមក្រសែភ្នែកត្រួតពិនិត្យនៃស្ថាប័នច្រើន ។
ទារកនេះចេះក្រឡាប់ ។
នាងដើរក្រឡឹងខ្ញុំពីរបីត្រឡប់ទើបឈប់
កាលនោះមានព្រាហ្មណ៍២នាក់ ក៏ខំធ្វើដំណើរទៅដល់ព្រះស្រីវេស្សន្ដរក្រាបបង្គំទូលសុំដំរី ព្រះអង្គក៏ប្រោសព្រះរាជទានឥតរួញរាឡើយ
ឡើងមួយក្រឺតទៀត
កំពុងធ្វើ ដំណើរតាមយន្តហោះដើម្បីទៅក្រេបទឹកឃ្មុំនៅប្រទេស អារ៉ាប៊ីសាអ៊ូឌី
ក្រែងវាចេញទៅលេងយកខ្យល់អាកាសទាំងព្រលឹម
ខ្ពស់ក្រៃណាខ្ពស់
ស្ករឃ្មុំឯងហើយ ផ្អែមក្រៃលែងផ្អែម ។
គេនិយាយហើយ ក៏ក្រោកក្រេសដើរឡើងទៅបន្ទប់ទទួលភ្ញៀវ ។
អ្នកគ្រូក៏អូស ដៃខ្ញុំចូលទៅក្នុងក្រោមសំណើចរបស់លោកគ្រូទាំងពីរ ។
ធម៌នេះស្មើក្សីរ អម្រឹតធារា ។
ញ៉ាំទឹកមួយក្អឿក
ពួកគាត់ត្រូវខកខានមិនបានធ្វើស្រែអស់មួយឆ្នាំ ព្រោះនៅវាលស្រែរបស់ពួកគាត់ គ្មានប្រព័ន្ធធារាសាស្ត្រទេ ។
តែបន្តិចក្រោយមក ស្ករក៏ចាប់ផ្ដើមខាប់
នៅក្នុងពិភពលោកមនុស្សយើងនិយាយភាសាខុសៗគ្នា ។
ចាស់ៗខ្មែរតែងប្រដៅកូនចៅប្រុសស្រីថា កុំស្រឡាញ់លួចលាក់ប្រយ័ត្នខុសមេបា។
ខ្ញុំខ្ជិលទៅ ។
មានសត្វបក្សីបក្សាកញ្ជ្រៀវខ្ញៀវខ្ញារ ។
ខ្ទង់ ១ លានដុល្លារ
ខ្ទង់តែមួយឆ្នាំមកហើយ
ម្ដាយខ្ញុំដេរចីពរតាមខ្នាតដែលត្រូវតាមពុទ្ធបញ្ញត្តិ ។
ឆ្កែបោលដាក់ស្លឹកត្រចៀកខ្នឺប ។
ការធ្វើវចនានុក្រមខ្មែរ អង់គ្លេសត្រូវខ្នួចខ្ញុំហើយ ។
ម្ហូបនេះមិនត្រូវខ្នួចនឹងស្រីឆ្លងទន្លេទេ ។
កាប់ក្បាលតែមួយខ្ពាប់
កុំចូលចិត្តនិយាយបន្តុះបង្អាប់ធ្វើឲ្យគេខ្មាសដូច្នេះ!
ឆ្កែស៊ីខ្មុកគ្មានសល់ ។
ខ្ញុំត្រូវខ្មោចសង្កត់ ។
ស្រុកកើតខ្យល់ព្យុះ ។
ខ្ញុំរកគ្រប់កន្លែងសឹងអស់ខ្យល់ ។
គាត់អស់ខ្យល់ហើយ ។
ព្រោះរាជរដ្ឋាភិបាលខ្លួនឯងពុំមានមូលនិធិគ្រប់គ្រាន់
ធ្លាក់ខ្លួនក្រ
ខ្លះទៅខ្លះនៅ
ព្រឹកឡើង របួសខ្ញុំហាក់ដូចជាធូរស្រាលខ្លះ
សរសេរមួយខ្វិច
បណ្ដាញទូរស័ព្ទប្រមាណពី ៥០០ ទៅ ៦០០ ខ្សែ
រទេះភ្លើងយួនមួយខ្សែ
សាស្ត្រាបីខ្សែ
សាស្ត្រាបីខ្សែ
នៅក្រោមខ្សែបន្ទាត់ចិន
តាមខ្សែបន្ទាត់មនោគមវិជ្ជា
នៅលើសមរភូមិដ៏ក្ដៅគគុកនេះ
មានក្រុមហ៊ុន ៤ កំពុងធ្វើសកម្មភាពកាយយកដីលក់យ៉ាងគគ្រឹកគគ្រេង ។
ក្នុងដំណើរតាមផ្លូវ មានពួកព្រាហ្មណ៍ទៅតាម សុំទ្រព្យសម្បត្តិ សេះនឹងរាជរថដែលព្រះអង្គគង់ប្រថាប់ ព្រះអង្គក៏ប្រទានទៀត ហើយយាងផ្ទាល់ព្រះបាទទៅ ។
វាគង់តែចាស់ទេទោះបីវាខំ ប្រើថ្នាំប៉ូវយ៉ាងណាក៏ដោយ ។
ម៉ោងប្រាំបួនគត់
នាឡិកានេះគត់នឹងទឹក
ស្រីស្រាលប្រចណ្ឌ រែងស្អប់ខ្ញុំគាប់ ។
ទើបចៅទាំង៤នាំគ្នាទៅគាល់ព្រះមហាក្សត្រ
ឱសថ ៤ ប្រភេទគិតជាទឹកប្រាក់ចំនួន ៤០.០០០ ដុល្លារអាមេរិកបានប្រគល់រួចជាស្រេច
គិតទៅសង្គ្រាមធ្វើឲ្យបាត់បង់ជីវិតមនុស្សច្រើនណាស់ ។
គិតពីសង្គ្រាមទៅ គាត់ត្រូវរបួស ។
កងក្រវែល គឺកងល្បាត,ពួកអ្នកយាមល្បាត ។
ដំណើរឃ្លាតចាកទេវលោក គឺដំណើរទទួលមរណភាពរបស់ទេវតា ។
រស់នៅក្នុង ប្រទេសនេះអស់រយៈពេលប្រហែលជាពីរ ឆ្នាំជាមួយប្រជាជនកម្ពុជាមក គឺខ្ញុំបានដឹង ច្បាស់អំពីប្រទេសកម្ពុជានេះ ។
គឺគាត់ហើយដែលបានសរសេរសំបុត្រនេះ
ស្ពានជ្រោយចង្វា គឺជាស្ពានដ៏ធំមួយនៅរាជាណាចក្រកម្ពុជា
ជីឡាវនេះមានរាងក្រឡូមស្រួចផ្នែកខាងគូថ
គ្រាន់តែរឿងតូចតាចប៉ុណ្ណឹងសោះ គួរបើគាត់ខឹងដល់ម្ល៉ឹងឡើយ ។
ស្លាប់មនុស្សអស់មួយគំនរ ។
អាប្ដីគម្រក់ចោលម្សៀតរបស់អូនឯងនោះ
ខ្ញុំនឹងបន្ថែមទាហាន៣នាក់ទៀត ដើម្បីជាគម្រប់កម្លាំង ។
ដើរទៅគោះកែវជាមួយមិត្តសំឡាញ់របស់ខ្ញុំ ។
ពួកវាមានគ្នាប៉ុន្មាននាក់?
កងទ័ពខ្មែរក្រហមមួយក្រុមមានគ្នាប្រមាណ ៥០ នាក់
នាងគ្រងសំលៀកបំពាក់ពណ៌សំបកពងមាន់មួយឈុត កំពុងដើរតម្រង់មករកខ្ញុំ ។
ស្រែបានគ្របដណ្ដប់ទីនេះ ។
ឯកសារនេះ ត្រូវបកប្រែគ្រប់ជ្រុងជ្រោយ ។
គ្រប់តែមាតាក្នុងលោក កូនរបស់ខ្លួនជាទ្រព្យថ្លៃវិសេស ។
គេនិយាយគ្រប់មាត់ ។
នឹងបុរសម្នាក់ទៀតមានរាងមាំខ្មៅសក់ក្រញាញ់ភ្នែកគ្រលួង ។
ជាពិសេសនៅពេលសែនពែ គេតែងយកអង្ករមកគ្រវាស បញ្ជាខ្មោចឲ្យចេញពីអ្នកជំងឺ ។
ចៅចិត្រគ្រវីក្បាលដោយអាការបដិសេធ
បើធ្វើម្ហូបប៉ុណ្ណេះ តើគ្រាន់ទេ?
ខ្ញុំគ្រាន់តែនិយាយលេងបន្តិចបន្តួច ស្រាប់តែគាត់ខឹង ។
គ្រាន់តែបានដំណឹងនេះភ្លាម ខ្ញុំស្រងាកចិត្តយ៉ាងខ្លាំង ។
ខ្ញុំបានប្រាក់បន្ថែមដូច្នេះ គ្រាន់នឹងចាយល្មមក្នុងខែនេះ ។
យន្តហោះមួយគ្រឿង
លោកប្រាប់ខ្ញុំទាន់ គ្រោះជាខ្ញុំចេញដំណើរនៅប៉ះខ្យល់ព្យុះសង្ឃរានោះ ។
គ្រោះមហន្តរាយធម្មជាតិ
សំពត់នេះស្លៀកឲ្យឃ្លិប ។
ទូកនោះក៏ឃ្លេងឃ្លោងផ្អៀងក្រឡាប់លិចទៅ ។
ឃ្លោកលិច អំបែងអណ្ដែត
គ្រីស្លេរ៍បានបោលមកឈប់ង៉ក់ពីមុខរានអាហារ ។
បានស្រឡាញ់ងប់ងុលនិងបវរកញ្ញាម្នាក់
ងាកមកមើលការដឹកជញ្ជូនតាមផ្លូវដែកវិញ
ងាប់ចិត្តលើស្រីម្នាក់
ងាប់ចិត្តលើស្រីម្នាក់
ភ្ជួរស្រែមួយព្រឹកបានពីរងារ
មុខឡើងក្រហមងាំងដូចផ្លែបាសទុំ
កសាងប្រជាជន ចងក្រងឲ្យទៅជាស្នូលគ្រប់ផ្នែក ។
ខ្ញុំចង់តែស្រែកយំ
កិច្ចការនេះពិបាកចង់ងាប់ ។
ប្រទេសខ្មែរចង់បាត់ឈ្មោះពីផែនទីពិភពលោក ។
ចង្កាក់សាច់គោច្រនួចមួយចង្កាក់
ផ្លែឈើមួយចង្កោម
មានតែខោអាវមួយចង្កេះ
ចិតជាចង្វាមូល
សង្គមខ្មែរនិងលទ្ធិកុម្មុយនិស្តមិនស៊ីចង្វាក់គ្នាទេ ។
សំណាបប្រាំចង្អួរ
លោកមិនហ៊ានស្ដីបន្ទោសសិស្សលោកដែលចចេសទៅភ្នំពេញនោះទេ ។
វចនានុក្រមខ្មែរមួយចប់
សាស្ត្រាមួយចប់
នាងមានចរិយាមារយាទល្អប្រសើរ ដែលធ្វើឲ្យរូបខ្ញុំគោរពនាងខ្លាំងណាស់ ។
ឲ្យចេះស្ដាប់ចលនាសួតនិងចលនាបេះដូង
ចាក់ទឹកមួយដប
សម្លចាស់អំបិល ។
ចាស់ៗកំពុងនិយាយ រាក់ទាក់លេងក្នុងបន្ទប់ទទួលភ្ញៀវ ។
ប្រជាជនអ្នកស្រុកអ្នកភូមិក៏នាំគ្នាមកវាយសំពងខ្លាយ៉ាងចាស់ដៃរហូតដល់ខ្លាសន្លប់ ។
ផ្កាយដ៏ភ្លឺចិញ្ចាចចិញ្ចែងមួយដែលបានបង្ហាញខ្លួនលើផ្ទៃមេឃ
ឪពុកម្ដាយចិញ្ចឹម
ព្រះចន្ទ្ររះចិញ្ចែងចាំងរស្មីច្រាលមកលើពសុធា
ខ្ញុំសូមអម្ចាស់កែវទាំង ៣ ចូរគយពិចារណាមើលទោស គឺមានក្នុងចិត្តនៃយើងខ្ញុំទាំងឡាយ
នៅចុងឆ្នាំ ១៩៧៨ យួនក៏បានលើកទ័ពរបស់ខ្លួនចូលរំលោភទឹកដីខ្មែរ វាយកម្ចាត់ក្រុមខ្មែរក្រហមប៉ុលពតក្នុងរយៈពេលតែមួយអាទិត្យគត់ ។
ចាស់ចើកជិះ ស្នូកអណ្ដើកបំបោលតាមសេះ
ខ្ញុំធ្លាប់ទទួលទានចំណីហ្នឹងចៀមជាំហើយ ។
ខ្ញុំចូលចិត្តញ៉ាំគ្រឿងសមុទ្រ ចៀសតែគ្រែងនិងងាវ ។
លោកប៊ីល ប្ល៉ាសបានចេញម៉ូតថ្មីជាច្រើន
លោកសង្ឃត្រូវកោរព្រះកេសពុកចង្កានិងរោមចិញ្ចើមទាំងអស់ចេញ ។
ខ្មែរក្រហមកាលពីថ្មីៗនេះបានដកខ្លួនចេញពីរដ្ឋធានី
ក្រសួងការបរទេសបាននិយាយថា ការធ្វើបែបបទ សុំលិខិតឆ្លងដែនគួរតែធ្វើចំពោះជនណាដែលមានផែនការបន្ទាន់ចង់ចេញទៅបរទេស ។
សភាធម្មនុញ្ញដែលទើបតែចេញមកពីការបោះឆ្នោតរបស់អ៊ុនតាក់
ខ្ញុំគ្មានចេតនាបុកលោកទេ ។
អគ្គសេនាធិការដ្ឋានកងទ័ពសាធារណរដ្ឋចែកកងទ័ពជាអ្វីខ្លះ?
ក្រៅពីប្រព័ន្ធម៉ាស៊ីនភ្លើង ប្រទេសជាតិនេះក៏ត្រូវការផង ដែរនូវការកសាងប្រព័ន្ធចែកចាយអគ្គិសនី ដែលមានតម្លៃពី ៣ ដងទៅ ៤ ដងលើសតម្លៃម៉ាស៊ីនភ្លើងទាំងនោះទៅទៀត ។
ការចោទប្រកាន់ មកលើយើង
បើយើងដាក់ទានឲ្យម្នាក់ មនុស្សប្រហែលម្ភៃនាក់រត់មកចោមដណ្ដើមគ្នាដើម្បីសុំទាន
ព្រះអង្គក៏បានអំពាវនាវផងដែរ សូមឲ្យជនរួមជាតិរបស់ព្រះអង្គទាំងអស់លះបង់ចោលនូវអាជីពជាចោរប្លន់ប្រដាប់អាវុធឬចោរលួចផ្សេងៗ
អាស្លាប់ចោលស្រុក
សកម្មជន គណបក្សប្រឆាំងរត់ចោលស្រុកព្រោះខ្លាចរដ្ឋាភិបាលចាប់ឆ្កោត ។
មនុស្ស ខ្វាក់អង្គុយមិនចំកៅអី ។
លោកគ្រូហៅចំឈ្មោះខ្ញុំឲ្យសូធ្យមេរៀន ។
ចំណង់បើថាធ្វើទានត្រូវធ្វើឲ្យស្មោះ ។
បើចង់ការពារតំបន់នេះឲ្យបានគង់វង្ស ទាល់តែចំណាយកម្លាំងប្រដាប់អាវុធឈរជើងនៅទីនោះជាប្រចាំតែម្ដង ។
ម្ល៉ោះហើយខ្មែរក្រហមចំណេញទាំងអស់ ។
ចំណេរតមកបិតាក៏ផ្ទេររាជ្យថ្វាយទៅព្រះវេស្សន្ដរ
ដោះខ្លួនរួចចេញពីចំណោមទ័ពសត្រូវ
និយាយក្អេងក្អាងកណ្ដាលចំណោម
ចំណេះជាអាហារ ប្រាជ្ញាជាអាវុធ
ការលក់ដីស្រែជាមូលហេតុចម្បងបំផុតដែលនាំឲ្យជីវភាពគ្រួសារគាត់កាន់តែយ៉ាប់យ៉ឺនខ្លាំងជាងមុនទៅទៀត
ចំបួរខាងម្ដាយ
វាចំពាក់ប្រកាសឲ្យគណបក្សនេះឈ្នះ ។
ការងារចំពោះមុខរបស់យោធាគឺការពារទឹកដី ។
មានភារកិច្ចចំពោះ មុខដូចជាការងារនៅរោងពុម្ពជាដើម ។
បានស្នើមកទស្សនកិច្ចនៅកម្ពុជាពេល ចំពោះមុខនេះ ។
បង្ហាញនូវវិធីផ្សេងៗដែលធ្វើព្រះពុទ្ធសាសនាឲ្យចំរើនតទៅអនាគត ។
ក្នុងពេលដែលឆាន់ ព្រះសង្ឃត្រូវចំរើនបច្ចវេក្ខណៈពិចារណាម្ហូបអាហារនោះឲ្យទៅជាអាហារបដិកូលសញ្ញា ទើបឆាន់បាន ។
លុះបុត្រចំរើនព្រះជន្ម ១៦ វស្សាហើយ
ម្លូមួយចម្រៀក
ទន្លេមេគង្គហូរចុះពីភ្នំទីបេត៍ ។
បើយើងចុះនៅផ្សារក្រោមកំពង់ឆ្នាំងយើង ត្រូវចុះពីកាណូតនៅកំពង់នៃផ្សារក្រោម ។
លោកសុខសប្បាយ ចុះអ្នកផ្ទះលោកសុខសប្បាយដែរ?
ជំងឺអាសន្នរោគជាជំងឺសាហាវណាស់ ធ្វើឲ្យអ្នកជំងឺចុះផងក្អួតផង ។
ពួកខ្មែរក្រហមខ្លះបានមកចុះចូលនឹងរដ្ឋាភិបាលថ្មី ។
ដាក់ទោសឲ្យពេញច្បាប់
ច្បាមយកទីផ្សារប្រេងក្នុងប្រទេសកម្ពុជា បានដល់ទៅ៧០ភាគរយទៅហើយ
មានម្នាក់បាន ចូលមកកម្ពុជាតាមច្រកពោធិចិនតុង
បណ្ដាលអោយជនល្មើសនោះដួលផ្ងារជើងច្រងាង
កុំនិយាយច្រងេងច្រងាងទៅគាត់ ។
កុំដាក់ឥវ៉ាន់ ច្រងេងច្រងាងអញ្ចឹង ។
សូយាដួលស្រ៊ុបទៅលើព្រះធរណី អ្នកស្រុកផ្អើលឆោឡោ រត់ច្រវាត់មកជួយយកអាសានាង។
ទ្វារនរកច្រហចេញអណ្ដាតភ្លើង
កុំច្រឡាសលើរៀមច្បង ។
វិស័យជំនួយសម្រាប់ក្រុមតស៊ូក៏មានការរបូតរលូតច្រើនណាស់
ដាក់ឲ្យឆក់ដោយចរន្តអគ្គិសនី
ពួករ៉ាឌីកាល់នេះបានធ្វើពហិការមិនចូលរួមក្នុងការបោះឆ្នោត ហើយថែមទាំងប៉ុនប៉ងឆាឆៅរំខានការបោះឆ្នោត ដោយធ្វើការវាយប្រហារទៅលើទីតាំងរបស់រដ្ឋាភិបាលហើយនិងបុគ្គលិករបស់អ៊ុនតាក់ទៀតផង ។
ភ្លើងសង្គ្រាមឆាបឆេះសន្ធោសន្ធៅ
បាយឆួលភ្លើង ។
សូយាដួលស៊្រុបទៅលើព្រះធរណី អ្នកស្រុកផ្អើលឆោឡោ រត់ច្រវាត់មកជួយយកអាសានាង។
ពួកវាប៉ិនប្រសប់ណាស់ ហើយជាមនុស្សប្រកបដោយគ្រោះថ្នាក់ផង ដោយពួកវាមានទីដៅយ៉ាងវែងឆ្ងាយឆ្ពោះទៅរកការធ្វើប្រទេសយើងក្លាយទៅជារណបយៀកណាមខាងជើង ។
កុមារប្រមាណជា ៣០ លាននាក់ដែលរស់នៅក្នុងប្រទេសកំពុងលូតលាស់ទាំង ៨៣ ប្រទេសបានទទួលរងជំងឺឆ្លងដ៏គ្រោះថ្នាក់ធំបំផុតដោយសារតែកង្វះវីតាមីនA ។
វេទរសភាពនឹងរយៈពន្លឺគឺជាការឆ្លើយតបរបស់រុក្ខជាតិ ទៅនឹងបម្រែបម្រួលនៃប្រវែងថ្ងៃ
យើងឆ្លុះមើលគ្រប់សកម្មភាពរបស់យួនក្នុងកំឡុងជាង ៩ ឆ្នាំមកនេះ
ត្មាតហើរឆ្វៀលឆ្វាត់លើនភ ។
យន្តហោះហោះឆ្វែលនៅលើអាកាស ។
ក្សត្រីយាត្រាជជាយជជួរទងវង។
វាឡើងបុណ្យស័ក្ដិតាមជណ្ដើរក្រោយ
ក៏ប៉ុន្តែ ជលផលខេត្តហាក់ដូចជាមិនទាន់យកចិត្តទុកដាក់ពីបញ្ហានេះនៅឡើយ ។
មានមនុស្សពីរនាក់ជាបងថ្លៃប្អូនថ្លៃនឹងគ្នា
ស្លឹកត្នោតចាស់ៗប្រើសម្រាប់ ប្រក់ផ្ទះត្បាញជាកន្ទេល ។
ជាបឋមសារព័ត៌មានត្រូវផ្សាយអ្វីដែលសាធារណជនចង់ដឹង ។
ខ្ញុំខំតែគោរពរាប់អានគាត់ មិនដឹងជាគាត់ជាមនុស្ស ចោលម្សៀតសោះ ។
បើចង់ការពារតំបន់នេះឲ្យបានគង់វង្ស ទាល់តែចំណាយកម្លាំង ប្រដាប់អាវុធឈរជើងនៅទីនោះជាប្រចាំតែម្ដង ។
យើងឆ្លុះមើលគ្រប់សកម្មភាពរបស់យួនក្នុងកំឡុងជាង ៩ ឆ្នាំមកនេះ
អ្នកស្រីបាននិយាយទៀតថា ថ្វីត្បិតតែប្រទេសនេះមានប្រជាជនចំនួនតែជាង ៩ លាននាក់ក៏ដោយ
ប្រទេសជាតិរបស់យើង មានមនុស្សពិការដៃឬជើងដោយសារមីន ច្រើនជាងប្រទេសណាៗទាំងអស់នៅក្នុង ពិភពលោក ។
ជាងនេះទៀតការនាំទំនិញចេញទំនិញចូលត្រូវចំណាយប្រាក់ក្រោមតុអស់ច្រើនពាន់ដុល្លារ
ប្រជាជនគ្រប់ជាន់ថ្នាក់
ឈ្មោះជាតិមនុស្សមួយពួកក្នុងមជ្ឈិមប្រទេសជាន់ពុទ្ធកាល ។
អ្នកនយោបាយជាន់កគ្នាយកអំណាច
ព្រោះពេលនោះយួនជាប់ច្បាំងនឹងអាម៉េរិកាំង
ខ្មែរខ្លះៗដែលនៅជាប់ទីនោះបានឲ្យដឹងថា បើត្រូវការវត្ថុអ្វីៗសម្រាប់ប្រើប្រាស់គេច្រើនឆ្លងទៅដាឡាត់
ពីព្រោះ គេយល់ថាជាប្រជាជន មួយនៅជាប់ព្រំដែនវៀតណាមហើយ មាននិន្នាការទៅ វៀតណាម
ខ្ញុំបានជាប់ជាវិស្វករទទួលបន្ទុកពិនិត្យលើការសាងសង់សំណង់
ធាតុថ្មដែលរឹងហើយជាប់
ថ្ងៃ ១០ ខែមិថុនាខាងមុខនេះ ខ្ញុំមិនអាចទៅក្នុងពិធីបុណ្យលោកបានទេ ជាប់ជួនថ្ងៃនោះខ្ញុំរវល់ក្នុងពិធីមង្គលការប្អូនខ្ញុំដែរ
មនុស្សដែលគេសង្ស័យថាជាប់ពាក់ព័ន្ធក្នុងរឿងនេះ
ជនជាតិខ្មែរត្រូវប្រើវាក្យសព្ទដោយឡែក ដែលពុំមែនជាវាក្យសព្ទប្រើសម្រាប់មនុស្ស ទូទៅហើយដែលជាវាក្យសព្ទជិតទៅភាសាក្នុងវាំង ។
សូមអ្នកនាង ជូនខ្ញុំទៅមន្ទីរពេទ្យ
ពស់វែកឲ្យជួញកង្កែប ។
ការជួញដូរគ្រឿងញៀន
ពេលណាខ្ញុំទំនេរ ជួនកាលខ្ញុំមើលសៀវភៅ ជួនកាលខ្ញុំមើលទូរទស្សន៍ ។
ខ្ញុំឮដំណឹងថាលោកឈឺខ្លាំងជួនជាខ្ញុំកំពុងធ្វើការហើយគ្មានយាន ជំនិះដើម្បីទៅសួរសុខទុក្ខ ។
ខ្ញុំបានជួបគាត់តាមទូរស័ព្ទមុនខ្ញុំចាប់
បានជាគេហៅថា អ្នកគ្រូដាលីន ព្រោះនាងជើងតេក្វាន់ដូស្មោះ ។
មាត់ទ្វារកំពតជើងកបណាស់ មានភ្លូកឡានរៀងរាល់ឆ្នាំ ។
នៅពេលមាន គ្រោះថ្នាក់ចរាចរម្ដងៗមានមនុស្សមកជៀវជុំ ។
គាត់ធ្លាប់បានទទួលជោគជ័យនៅប្រទេសខ្មែរក្នុងការពិនិត្យនិងព្យាបាលជំងឺទូទៅ
ដើម្បីទទួលព័ត៌មានជុំវិញបញ្ហា
ជំនោររំភើយបានបក់មកពីភ្នំស្វាយ ធ្វើឲ្យខ្ញុំត្រជាក់ចិត្ត នឹកភ្នកចង់ដើរលេងផ្សារស្វាយ ។
ការផ្អាកសកម្មភាពរបស់រោងចក្រនេះកំពុងជះឥទ្ធិពលយ៉ាងខ្លាំងដល់ជីវភាពរបស់កម្មករ
ភ្នាក់ងារប៉ូលិសច្រានពួកកូនសិស្សដួលជ្រហិតជ្រហម ។
មិនបានគ្រប់ជ្រុងជ្រោយទេ
មិនបានគ្រប់ជ្រុងជ្រោយទេ
ស្រាប់តែមាននារីស្រស់ក្មេងម្នាក់ជិះម៉ូតូ ពណ៌ព្រីងទុំសិរីថ្មី ជ្រុលចង្កូតមកបុកខ្ញុំ
ការតស៊ូប្រឆាំងភាពជ្រុលនិយម
រស្មីព្រះសុរិយាក៏ជ្រៀងជ្រេចូលកាន់សន្ធ្យារាត្រី
កំពុងតែធ្វើបុណ្យ ស្រាប់តែមានមារមកជ្រែក ។
សព្វថ្ងៃនេះឈប់លែងប្រើហើយ ប្រើជា បង ជាជំនួស។
ខ្ញុំឈឺចាប់ស្ទើរតែសន្លប់បាត់ស្មារតី ។
ពីព្រោះនាងជឿជាក់ពាក្យលោកសួនពីរោះឈ្ងុយឆ្ងាញ់ចូលចុកក្នុងត្រចៀកនាង ។
ពួកចក្រពត្តិចង់យកឥណ្ឌូចិន ធ្វើជាឈ្នាន់របស់វា ។
ដែលមាននាមជានិស្សិតតែឈ្មោះ
ព្រះមហាក្សត្រទ្រង់ពិចារណាឈ្វេងយល់ ដោយដំណើរសេចក្ដីបុរសទាំង ៤ នោះ
ចក្រពត្តិញាក់ពួកបរិវារឲ្យធ្វើតាមវា ។
សំឡេងស៊ីរ៉ែនរថយន្តសង្គ្រោះជាបន្ទាន់បានបន្លឺឡើងយ៉ាងញាប់រន្ថើន ។
គ្រូញ៉ាំងសិស្សឲ្យរៀន ។
ក្នុងពេល ដ៏ខ្លីនេះ
ទន្លេមេគង្គ ជាទន្លេដ៏ធំមួយក្នុងចំណោមទន្លេធំៗទាំងឡាយក្នុងពិភពលោក ។
ប្រាសាទដ៏ហើយដោយថ្ម
គឺតំបន់ជុំវិញបឹងទន្លេសាបហើយនិងតំបន់តាមដងទន្លេមេគង្គ ។
ផ្សែងហុយដង្គោល ។
ចាប់បានមួយដង្ហើមចង្រិតប៉ុណ្ណោះរួចខ្លួនវិញទៅហើយ ។
ដោយឃើញមានឈាមធ្លាក់ពីមាត់ពីច្រមុះផង និងដង្ហើមចង្រិតផង
រហូតដល់ចុងឆ្នាំ ១៩៩៤ អគ្គិសនីកម្ពុជាកំពុងប្រើប្រាស់ម៉ាស៊ីនភ្លើងចាស់ៗដដែល ។
មានរាងកាយស្គាំងស្គម ឥតសាច់ឈាម មានតែស្បែកដណ្ដប់ឆ្អឹង
លុះឃ្លោកផ្លែមានបុរសម្នាក់ដទៃមកដណ្ដឹងទិញឃ្លោកនោះ
គេត្រូវតែទៅចាត់ចែងរឿងអស់ទាំងនេះដល់កន្លែង ។
ឲ្យតែខ្ញុំជួបមុខនាងម្ដងណា នាងប្រើសំដីទ្រគោះបោះបោកដាក់ខ្ញុំជានិច្ច ។
កញ្ញាយើងញញឹមស្រស់ដាក់ខ្ញុំ ។
ពេលខ្យល់បក់ខ្លាំង អ្នកប្រើទូកក្ដោងដាក់ក្ដោងចុះ ។
ខ្ញុំសូមដាក់ខ្លួន ជូនអង្គការប្រជុំដើម្បីធ្វើការទិតៀន ។
ត្រីក្រឹមពីរនេះកំពុងអួតដាក់គ្នា ។
រោងចក្រអំបោះពោធិចិនតុងបានដាក់ជួលឲ្យក្រុមហ៊ុននោះ តាំងពីចុងឆ្នាំ ១៩៩១ ក្នុង កិច្ចសន្យារយៈពេល ២០ ឆ្នាំ
បក្សបានដាក់ទិសឲ្យប្រជាជនលក់ស្រូវជូនរដ្ឋ ។
ក្រុមបុរសនិយាយចំអន់ ដាក់ផ្លែផ្កាទៅក្រុមនារី
ខ្ញុំដាក់ពាក្យចូលបម្រើការងារ នៅក្រុមហ៊ុនសំណងមួយ ។
ព្រមទាំងសួររកម្ចាស់ហាង តែម្ចាស់ហាងដាក់ មេប្រូចបាត់ ។
ឥវ៉ាន់ចាស់ៗលក់មិនដាច់ទេ ។
នៅក្នុងពិធីបុណ្យរំលឹកឯករាជ្យ មានមនុស្សដើរដាសដាពាសពេញវិមានឯករាជ្យ ។
កែវភ្នែករបស់សោភ័ណដិតដាមដោយទឹកភ្នែក ។
នាងនីមិនដឹងខ្លួនជាប្ដីគិតសម្លាប់
ដូចមមាចចូលភ្លើង ។
អ្នកត្រូវតែគោរពលោកដូចអ្នកគោរពព្រះពុទ្ធអង្គ ។
បន្ទប់ខ្ញុំមានទំហំដូចជាបន្ទប់លោកដែរ ។
ខ្ញុំមានសៀវភៅមើលច្រើនណាស់ដូចជាច្បាប់ផ្សេងៗ រឿងល្បើក ប្រលោមលោក ជាដើម ។
យោបល់អ្នកស្រីមានទំនងដូចជាម្យ៉ាងដែរ ។
ខ្ញុំមិនអាចមកជួយលោកបានទេ ដូចដឹងស្រាប់ ខ្ញុំត្រូវតែធ្វើការនៅថ្ងៃនោះ ។
នយោបាយថ្មីនៃសហរដ្ឋអាមេរិកចំពោះប្រទេសចិនគឺធ្វើដូចម្ដេចឲ្យមានប្រទេសចិនពីរនៅក្នុងអង្គការអន្តរជាតិនេះ ។
ប្រជាជនក្នុងប្រទេសនោះខិតខំធ្វើការណាស់ ដូច្នោះឯងបានជាគេចំរើន ។
កូនត្រូវខំរៀន ដើម្បីអនាគតដ៏ភ្លឺស្វាង ។
ដើម្បីជួយឧបត្ថម្ភក្នុងការខ្វះខាតសៀវភៅសិក្សា នឹងដើម្បីរក្សាទុកនូវស្នាដៃដ៏ថ្លៃថ្លារបស់ដូនតាយើង
លោកបានលះ បង់អ្វីៗទាំងអស់ដើម្បីឲ្យប្រទេសបាន ឯករាជ្យ ។
ហើយដើរតម្រង់ទៅមហាវិថី
ឡានតាក់ស៊ីដើរផ្លូវភ្នំពេញ កំពង់សោម ។
បណ្ដាលឲ្យដេកដួលស្លាប់មួយរំពេច
ពេលយប់ចិញ្ចៀនពេជ្រនេះ ដេញភ្លើងចាំងភ្នែក ។
ម្ល៉ោះហើយព្រះនាងរក ដណ្ដឹងបុរសដែលមានរូបជាទីគាប់ព្រះទ័យ មកធ្វើជាព្រះស្វាមីវិញ ។
ក្នុងរយៈពេល ១៥ ឆ្នាំដែលខ្មែរជាប់ដៃ ច្បាំងនេះ សៀមបានចំណេញ ច្រើនទៅលើ រឿងខ្មែរ ។
រៀងរាល់ថ្ងៃចាប់ពីថ្ងៃ ១ រោចទៅ ព្រលឹមស្រាងៗឡើងសំឡេងសូត្រធម៌ បរាភវសូត្រឮសូរគ្រលួចដោតជាប់នឹង វិញ្ញាណខ្មែរ
បច្ចាមិត្តបានបាញ់រំខានដោយកាំភ្លើងត្បាល់ ។
ជាប្រទេសមួយសំបូរដោយត្រីទឹកសាប ។
បានធ្វើដំណើរមកដល់ភ្នំពេញដោយ សុវត្ថិភាព ។
ខ្ញុំស្ដាយណាស់ដោយមិនបានសួរឈ្មោះនាង។
លោកជី គិមអាន ស្លាប់ដោយ ធ្វើអត្តឃាតខ្លួនឯងនៅភូមិ ស្រែអណ្ដូង ។
ខ្ញុំចុះចូលដោយសារសម្ដេចសីហនុ ។
អ្នកស្រីនោះគាត់ចង់ទៅប្រទេសខ្មែរ ប៉ុន្តែដោយសារកូនស្រីគាត់ឈឺ គាត់ក៏ ផ្អាកសិន ។
ពុំអាចដំណើរការបានល្អ
ហើយនាំគ្នាធ្វើការ ពិភាក្សារកដំណើរហេតុ
ហើយទះខ្ញុំមួយកំផ្លៀងយ៉ាងដំណំហើយស្រែកជេរថាស្រីថោកទាបស្រីបោកប្រាស់
ដំណោះស្រាយសព្វមុខយុត្តិធម៌និងត្រឹមត្រូវ
វាយត្រូវដំបន់ធ្ងន់ណាស់
ដំបៅសង្គមគឺការប្រកាន់បក្សពួកនិងអំពើពុករលួយ ។
ក្រោយដែលខ្ញុំបានអានសៀវភៅនេះរួច ខ្ញុំក៏ដុះចិត្តប្រាថ្នាចង់ធ្វើបុណ្យទាន ។
គាត់លែងសួរនាំខ្ញុំ ហើយបង្ខំឲ្យខ្ញុំដោះអាវទ្រនាប់
គាត់សុំគេធ្វើការជាអ្នកលាងចាន ដើម្បីដោះដូរយកបាយហូប
ខ្ញុំផ្ញើប្រាក់ចងដៃដែរ ដ្បិតតែខ្ញុំពុំបានចូលរួមក្នុងពិធីមង្គលការលោក ។
ប៉ុន្មានកន្លះឆ្នាំមុនអាធីឌីតកូនលោកសក្តិ៤កន្លះម្នាក់ធ្វើសង្សារបានយ៉ាងស្រួល ។
ទៅប្រទេសណាក៏ដោយ ឲ្យតែមិនមែនជាប្រទេសកុម្មុយនិស្តមួយនេះ។
ប្រាប់អញមកណាមួយដែលឯងស្រឡាញ់ ។
គ្មាន អំណោយណាមួយប្រសើរថ្លៃថ្លានិងឧត្ដុង្គ ឧត្ដមជាងការផ្ដល់ឈាមនោះឡើយ ។
ហើយណាមួយខ្ញុំត្រូវចុះទៅស្រុកខ្មែរ ។
បាញ់កាំភ្លើងពីរណាត់
បន្ទាប់ធ្វើពិធីកាត់សក់ហើយ តមកទៀត មានធ្វើពិធីចំរើនព្រះបរិត្ត ។
ក្នុងគណិតសាស្ត្រមុមតថានុរូបមាន ទំហំស្មើគ្នា
គ្រូពេទ្យប្រាប់ថាជំងឺនេះត្រូវតមខ្លាញ់ ។
ព្រឹកនេះនាយពុំបានតាមដានព្រឹត្តិការណ៍ឃាតកម្មអាថ៌កំបាំងទេ ។
តាមតែធំក៏ដោយតូចក៏ដោយ ។
ការទាក់ទងរវាងឯកជនជាមួយក្រុមមនុស្សផ្សេងទៀតតាមរយៈសារព័ត៌មាន
ស្ថានការណ៍តឹងតែងណាស់
ម្នាក់តឺនុយប៉ារ៉ា
គាត់រអិលជ្រុលតើតៗ ។
វាមានតម្លៃតែប៉ុណ្ណោះ ។
ខ្ញុំចេះដាំបាយតែមួយមុខប៉ុណ្ណោះ ។
គឺថាភក់បែកភក់ទាំងគោទាំងក្របីទាំងអស់ហ្នឹង វាច្របូកច្របល់តែម្ដង ។
តែយ៉ាងណាក៏ដោយ ខ្ញុំមិនអាចបំភ្លេចគាត់បានឡើយ !
គេខំរកស៊ីតែសព្វខ្លួន មិនបានគិតពីរឿង បោះឆ្នោតទេ ។
តោងប្រយ័ត្នសំដីបន្តិចគាត់ឯង ។
គ្មានភ្លៀងមួយតំណក់សោះ ។
តាព្រាហ្មណ៍ក៏តម្រង់ទៅព្រះរាជវាំងព្រះបាទស្រីសញ្ជ័យសិន
ការដែលរាជការតម្រូវឲ្យត្រឡប់ទៅស្រុកវិញជាការប្រសើរណាស់ ។
ឃើញស្រីកំពុងជីកត្បូងម្នាក់ឯង ក៏មានតម្រេកតណ្ហាកើតឡើង
ស្ដេចទ្រង់ព្រះតម្រិះ ។
រ៉ែមាសនៅតំបន់អូរត្រូនមានតាំងពីយូរយារណាស់មកហើយ ។
ដើម្បីបន្តការតាំងទីវៀតណាមលើកម្ពុជា
អញ្ចឹង តោះ លោកទៅមន្ទីរពេទ្យ ឈាមលោកហូរច្រើនណាស់ ។
កុំអី ត្មាតផ្លុំខ្លុយ ។
លុះនាងដួលបាត់ស្មារតី ទើបព្រះវេស្សន្ដរត្រកងលើកឡើងហើយ
នាងមកត្រកងខ្ញុំឲ្យក្រោកហើយសួរទាំងតក់ស្លុត ។
ប្ដីជាមនុស្សចិត្តត្រង់ តែគ្មានប្រាជ្ញា ឯនាងប្រពន្ធនោះ ជាស្រីចិត្តមិនត្រង់នឹងប្ដី
មធ្យោបាយត្រជាក់
ជំនោររំភើយបានបក់មកពីភ្នំស្វាយ ធ្វើឲ្យខ្ញុំត្រជាក់ចិត្ត នឹកភ្នកចង់ដើរលេងផ្សារស្វាយ
ផ្គរលាន់ទិសបូព៌សូរត្រដុក ។
នៅខាងឆ្វេងយើង ភ្នំអូរ៉ាល់បានលេចរូបរាងខ្ពស់ត្រដែត ។
មនុស្សម្នាដើរត្រសងតាមមាត់សមុទ្រ
ជាតិខ្មែរត្រឡាំង មិនសមបីបើមិនស្គាល់ព្រះពុទ្ធសាសនាសោះ ។
កុំត្រាប់មាត់គេ ។
ព្រះអង្គ...ទ្រង់ត្រាស់សំដែងនូវព្រះធម៌ទេសនា
គាត់ចេះភាសាបារាំងនិយាយត្រិល ។
ស្ពានទាំងអស់នៅលើផ្លូវលេខ ១ ត្រូវវៀតកុងបំផ្លាញទាំងអស់ ។
ឆ្នាំនេះត្រូវលើនាទីខ្ញុំដើម្បីរៀបចំពិធីចូលឆ្នាំខ្មែរ ។
បុណ្យរំលឹកថ្ងៃខួបកំណើតលោកប្រធានាធិបតីវ៉ាស៊ីនតោន ត្រូវលើថ្ងៃចន្ទទី ២០ ខែកុម្ភៈ ។
ត្រៀមនឹងទទួលមុខ តំណែងជាប្រធាននគរបាលខេត្តត្រៀមខេត្តបាត់ដំបង
នាងសម្លក់ត្លែរស្ទើរចង់ស៊ីសាច់ខ្ញុំទាំងរស់ ។
ថីដោយប៉ូលិសបង្គាប់ភ្នាក់ងារឲ្យនៅឈរយាមក្នុងទីនេះ
នៅភោជនីយដ្ឋាននេះមានម្ហូបចិនគ្រប់មុខ ថែមទាំងមានម្ហូបខ្មែរថែមទៀតផង ។
ដោយបានវិលថ្កានស្ថានមាតា
ខ្ញុំនឹងធ្វើអ្វីមួយថ្នាសតែមានជោគជ័យ ។
ធ្វើថ្នាញនៅនាជើងវាំង
ហាក់ដូចជាថ្មនៅនឹងថ្កល់
មុននឹងនិយាយត្រូវថ្លឹងថ្លែងពាក្យសំដី ។
ថ្វីត្បិតតែស្រុកខ្មែរវាចប់សង្គ្រាមមែន ក៏ប៉ុន្តែនៅតែមានសញ្ញា ឲ្យឃើញថាអ្នកដឹកនាំខ្មែរបច្ចុប្បន្ននៅតែស្ថិតនៅក្រោមឥទ្ធិពលនយោបាយរបស់ យួនខាងជើង ។
ថ្វីបើប៉ុន្មានឆ្នាំនេះ ប្រទេសវៀតណាមត្រូវខូចខាតខ្ទេចខ្ទីសឹងតែទាំងអស់នូវសង្ខារណៈ
ខ្ញុំទៅទទួលគាត់ពីកន្លែងធ្វើការ ។
មានមនុស្សជាច្រើនបានមកទទួលស្វាគមន៍លោកនៅវាលយន្តហោះ ។
ខ្ញុំហ៊ានទទួលចាប់ដំរីនោះបាន
រដ្ឋមន្ត្រីទទួលបន្ទុកក្រសួងការពារប្រទេស
គឺការទទួលរងនូវមហាវិនាសកម្ម ។
ប្រទេសកម្ពុជាទទួលរងនូវបញ្ហារាលដាលនៃការជួញដូរ និងការប្រើប្រាស់គ្រឿងញៀន
ក្រសួងពាណិជ្ជកម្ម ... ទន់ភ្លន់ជាមួយអ្នករកស៊ី
កូនទន្ទឹមស្មា
ប្រាំទល់នឹងមួយ
មួយទល់នឹងមួយ
ខ្លួនអ្នកជាកូនប្រុសត្រូវតែទល់នឹងវិស័យលោកិយទៅមុខទៀតច្រើនណាស់
នៅដើមខែសីហានេះស្របពេលដែលសន្និសីទអន្តរជាតិនៅប៉ារីស៍ស្ដីពីបញ្ហាកម្ពុជាកំពុង តែដំណើរការ ខ្សែភាពយន្តវាលពិឃាតត្រូវបាននាំយកមកបញ្ចាំងតាមផ្លូវការជាសាធារណនៅទីក្រុងភ្នំពេញដោយមានទស្សនិកជនជាច្រើនកុះករចូលទស្សនា
ប៉ុន្តែនោះគ្រាន់តែជាតម្លៃដែលខ្មែរក្រហមត្រូវការនៅក្នុងការបើកផ្លូវរកស៊ីដើម្បីទាក់ម៉ូយបរទេសតែប៉ុណ្ណោះទេ ។
ព្រះ សង្ឃប្រើជាវេទិកាដោះស្រាយបញ្ហាដែលទាក់ទងដល់ការគោរពប្រតិបត្តិធម៌វិន័យក្នុងព្រះពុទ្ធសាសនា
ដំណើរផ្ដាច់ការទាក់ទងខាងផ្លូវទូត
ខ្ញុំសូមទាក់ទាញការយកចិត្តទុកដាក់របស់បណ្ដាប្រតិភូនានាដែលចូលរួមនៅក្នុងសន្និសីទនេះទៅលើ
ពីព្រោះនៅពេលខាងមុខ ភារកិច្ចរបស់កង អាវុធហត្ថជាតិត្រូវទាក់ទិនទៅនឹងការថែរក្សាសន្តិសុខសង្គម ... មានជាប់ទាក់ទិនទៅនឹងអំពើភេរវកម្មចោរកម្ម
ព្រះតេជព្រះគុណជ្រាបទេ ទានប្រោស ?
ថ្នាំនេះមិនអាចលក់បានទូទៅទេ ទាល់តែមានអាណាប័ណ្ណ ។
បើចង់ការពារតំបន់នេះឲ្យ បានគង់វង្សទាល់តែចំណាយកម្លាំងប្រដាប់ អាវុធឈរជើងនៅទីនោះជាប្រចាំតែម្ដង ។
តាមពិតខ្ញុំគ្មានចេតនាទាល់តែសោះ ។
ព្រះករុណា គ្មានទាស់អ្វីទេ ។
ទៅទីណាៗ ដែលមានបរិយាកាសនិងទិដ្ឋភាពល្អៗ ដើម្បីឲ្យនាងសប្បាយចិត្ត ។
ខ្ញុំមិនស្គាល់ផ្ទះគាត់នៅទីណាទីណីទេ ។
ទីបញ្ជាការស្រុកព្រៃក្ដីមានទីតាំងនៅ អណ្ដូងទឹក ។
ជនជាតិអាម៉េរិកាំងជាជនជាតិដែលមកពីប្រទេសទីទៃៗ ។
ខ្ញុំចង់បានអ្វីពីប៉ាខ្ញុំ ខ្ញុំពឹងបង ប្រុសខ្ញុំពីព្រោះគាត់មានទឹកមាត់ប្រៃ ។
អ្នកក្រទឹកមាត់សាប អ្នកមានទឹកមាត់ប្រៃ ។
លោកប្រុសបិទទ្វារបន្ទប់ដោយទឹកមុខគួរឲ្យខ្លាច
ប្រជាជនទូទៅក្នុងពិភព លោកបានទទួលស្គាល់ថាប្រាសាទអង្គរវត្តជាអច្ឆរិយវត្ថុទី ៧ ក្នុងលោក ។
គេឬទូទៅ គ្រប់ទិសទីថាព្រះអង្គមានជំងឺមហារីក ។
បច្ចេកវិជ្ជានេះគឺមានភាពសាំញ៉ាំជាទីបំផុត ហើយម៉ាស៊ីនទូរសារ នេះធ្វើប្រតិបត្តិការបញ្ជាតាមកម្រិតនៃម៉ូលេគុល ។
ហើយសន្យាថាក្នុងរយៈពេល ៦ ខែទើបខ្ញុំមានសិទ្ធិត្រឡប់ទៅស្រុកកំណើត ។
គាត់ទើបតែនឹងមកដល់បានប្រាំពីរប្រាំបីថ្ងៃមុននេះ ។
សហរដ្ឋអាមេរិកត្រូវធ្វើការកៀបសង្កត់ចិនក្រហមតាមផ្លូវទូតហើយ សុំកុំឲ្យចិនជួយផ្ដល់អាវុធទៅខ្មែរក្រហមទៀត ។
មនុស្សដែលមានទេវធម៌ត្រូវមានហិរិនិងឱត្តប្បៈ ។
បាញ់ទៅលើប្រជាជន
មនុស្សធ្វើការឬខ្ជិលស្រេចទៅលើទង្វើមនុស្សនោះ ។
ឥឡូវវាក្រហមទៅវិញ
ចំពោះសិស្សឬនិស្សិតដែលជាទំពាំងស្នង ឫស្សីរបស់ប្រទេសជាតិ
ខ្ញុំក៏បានធាក់ទម្លាយទ្វារចូលទៅក្នុង ។
ទំហំប៉ុន្មាន ?
ត្រីអាំងទាំងស្រស់ឆ្ងាញ់ណាស់
នាងមកត្រកងខ្ញុំឲ្យក្រោកហើយសួរទាំងតក់ស្លុត ។
ទាំងប្រុសទាំងស្រី
ទ្រព្យសម្បត្តិទាំងប៉ុន្មានៗបានមកដោយកម្លាំងញើសរបស់ប្រជាជន ។
ហើយថែមទាំងដុតបំផ្លាញទីក្រុងទាំងមូល ។
គឺអ្នកម៉ែដាលីនទាំងសាច់ទាំងឈាមទាំងឆ្អឹង
អ្នកទាំងអំបាល សុំខំរៀនសូធ្យឡើង ។
ទោះគាត់ចូលចិត្តក្ដី មិនចូលចិត្តក្ដី យើងត្រូវតែជម្រាបគាត់តាមការពិត ។
សមាជិកម្នាក់ៗទោះប្រុសក្ដី ស្រីក្ដី
ទោះជារហូតដល់ថ្ងៃស្លាប់ក៏ដោយ ខ្ញុំលែង ត្រូវការសេចក្ដីមេត្តាគាត់ទៀតហើយ ។
ទោះបីក្រយ៉ាងណាក៏ដោយ ក៏ខ្មែរនៅតែឆ្លៀតធ្វើបុណ្យដែរ ។
ទោះបីមានតិចតួចក្ដី គេចែកម្ហូបស្មើគ្នាទាំងអស់ ។
នៅពេលនោះ ទ្រង់ប្អូននៅមានប្រជាប្រិយភាពនៅឡើយ ហើយប្រជារាស្ត្រក៏ស្រឡាញ់ទ្រង់ប្អូនដែរ ។
ព្រះបាទជ័យវរ្ម័នទី ៧ ទ្រង់មានកិច្ចការធំសំបើមអស្ចារ្យណាស់
ព្រះពុទ្ធអង្គទ្រង់ឈ្វេងយល់ច្បាស់នូវផលប្រយោជន៍នៃអាមិស ទើបទ្រង់អនុញ្ញាតឲ្យបព្វជិតបរិភោគ ប្រើប្រាស់អាមិស តាមការគួរ ។
ព្រះអង្គម្ចាស់ក្សត្រីទ្រង់ព្រះភូសាពណ៌ស្វាយស្រងាំ ។
ប្រទេសដែលទ្រទ្រង់នូវទឹក
ស្រាប់តែឬសូរមាត់ក្មេងស្រែកទ្រហឹងអឺងកង ។
កុំទ្រាបលើសៀវភៅ ។
ដើម្បីទ្រោល សភាពការណ៍សព្វសារពើរបស់ជាតិ។
ក្រុមហ៊ុនវិនិយោគទុនជាច្រើនកំពុងក្ស័យធនហើយ បានបិទទ្វារជាបណ្ដើរៗ ។
កាំភ្លើងធុន ៧៥ មិនធាក់ថយក្រោយ
ព្រឹកឡើង របួសខ្ញុំហាក់ដូចជាធូរស្រាលខ្លះ
ម្ដាយខ្ញុំស្រឡាញ់បងស្រីខ្ញុំធ្ងន់ជាងខ្ញុំ ។
ផ្សោតងើបធ្ងោលពីក្នុងទឹក ។
ដំរីធ្វើស្លឹកត្រចៀកធ្មាំង ។
រោគផ្នែកបុរសភេទដូចជាទឹកកាមធ្លាក់រហ័ស។
ឆគាត់ទាល់តែធ្លាក់អស់នូវអាថ៌កំបាំងទាំងប៉ុន្មាន ។
ខ្ញុំធ្លាក់ខ្លួនទៅជាឈឺគ្រុនចាញ់ស្រមៃ ឃើញតែព្រំដែនស្អីៗនោះយ៉ាងម៉េច ។
ទ្វារ ច្រហធ្លុង ។
គាត់ធ្វើជាគ្រូ ។
មហាសន្និបាតដែលនឹងធ្វើឡើងនៅក្នុងសាលារៀន
បុណ្យនេះធ្វើឡើង ដើម្បី
សន្និសីទបានធ្វើឡើងក្រោម អធិបតីភាពនៃលោកនាយករដ្ឋមន្ត្រីផាំយ៉ាំងដុង ។
ការច្រូតកាត់ដោយដៃ តែងធ្វើឡើងដោយប្រើប្រាស់កណ្ដៀវ
កញ្ចាស់នេះធ្វើឡើងអំពីបន្ទោះឫស្សីតូច ។
នរូអ្នកណានឹងស្វែងប្រាជ្ញា ជារស្មីប្រាណ ឲ្យគិតជញ្ជឹង រំពឹងលែងបាន កុំធ្វើបំពានប្រទូស្តវឹងស្នង ។
នាងខ្ញុំមិនស្រួលខ្លួន ។
ជានាទីពេទ្យ ។
សព្វថ្ងៃនៅប្រទេស ខ្មែរក្រៅពីប្រជាជនខ្មែរមានជនជាតិនានា ទៀត ។
បើខ្ញុំមានប្រាក់គ្រប់គ្រាន់ខ្ញុំ នឹងដើរលេងកម្សាន្តនៅនានាប្រទេស ក្នុងពិភពលោក ។
នានាជនជាតិមានថៃជាដើមតែង តែតិះដៀលប្រជាជនខ្មែរថាជាជនជាតិ ល្ងង់ ។
នានាភាពសេនេទិច
ឬនិមន្តលោកមកប្រគេនចង្ហាន់ ប្រគេនទេយ្យវត្ថុផ្សេងៗនៅឯគេហដ្ឋានរបស់ខ្លួន ។
លោកសង្ឃនិមន្តទៅបិណ្ឌបាត ។
ពិធីចូលឆ្នាំធ្វើតាមការគន់ គូរក្បួនហោរាសាស្ត្របែបបុរាណ គឺក្បួនមហាសង្ក្រាន្តទើបខ្មែរនិយមចូលឆ្នាំក្នុងខែចេត្រឬជួនកាលក្នុងខែពិសាខ
ពាណិជ្ជកម្មយើង អត់និយាយពីរឿងនយោបាយទេ ។
ឥតដែលមានភ្នកនឹកនាដល់ជរា ព្យាធិ មរណៈ នឹងសេចក្ដីព្រាត់ប្រាស
ជំនោររំភើយបានបក់មកពីភ្នំស្វាយ ធ្វើឲ្យខ្ញុំត្រជាក់ចិត្ត នឹកភ្នកចង់ដើរលេងផ្សារស្វាយ
ភ្នែកមានចក្ខុប្បសាទសម្រាប់មៀងមើលនូវរូបារម្មណ៍ដូចកែវយឹត ។
ប្រាសាទដ៏ពេញនូវមាស
ក្រាបនៅលើមែក
បញ្ហានោះនៅតែមិនទាន់ដោះស្រាយនៅឡើយទេ ។
ចំពោះគ្រោះថ្នាក់នោះ គេពុំទាន់ដឹងខុសត្រូវនៅឡើយទេ ។
គាត់លែងសួរនាំខ្ញុំ ហើយបង្ខំឲ្យខ្ញុំដោះអាវទ្រនាប់
ចំណាប់និងមិត្តភក្តិនារីៗ ទាំងអស់គេនាំគ្នាជួយសម្រួលចិត្តដាលីន ។
គេនាំគ្នាសំអាតតុបតែងលំអគេហដ្ឋាននិងកាត់សំលៀកបំពាក់ថ្មីសម្រាប់គ្រួសារ ។
ចូរបំពេញឃ្លាខាងក្រោមនេះ ។
សៀវភៅនេះឯងដែលខ្ញុំកំពុងរក ។
ខ្ជិលនេះខ្ជិល
ឯគីង្គក់និងអណ្ដើកខំតាមដានទៅ បាត់ដានត្រង់ដើមឈើនោះ ។
ខ្លះទៀតបំផ្លាញជីវិតបង់
ប៉ុន្តែក្នុងចិត្តរបស់នាងហាក់ដូចជាបង្កប់នូវអាថ៌កំបាំងអ្វីម៉្យាង
ពួកយួនបង្កប់និងអាយ៉ង
នាងក៏ដើរទៅក្បែរមាត់បង្អួច ទាញស្លាបព្រិល បង្ហើបឡើងឈរគយគន់ដួងចន្ទ្រ ព្រមទាំងវាចាតែម្នាក់ឯង ។
ព្រះទិនករបានបង្អួតខ្លួនក្នុងនភាល័យជាថ្មី ។
ដែលសូមមិនបញ្ចេញឈ្មោះ។
អត្ថបទនេះបញ្ចាំងឡើងពីការប្ដេជ្ញាចិត្តរបស់ប្រជាជន ។
ហើយបញ្ឆេះម៉ូតូចេញបាត់មួយរំពេច ។
ឲ្យកម្មករចេះបញ្ជាម៉ាស៊ីន។
ក្នុងរបាយការណ៍របស់លោក បានបញ្ជាក់ថានៅខេត្តបាត់ដំបងមានមន្ទីរឃុំឃាំងសំងាត់ចំនួន២ ។
ដឹកគោបញ្ជ្រកក្នុងម្លប់ឈើ
បានធ្វើសេចក្ដីអំពាវនាវដល់ពួកខ្មែរក្រហមឲ្យបញ្ឈប់ការដាក់មីនសម្លាប់ ប្រជាពលរដ្ឋស្លូតត្រង់
លោកលេខាបក្សក្រុងភ្នំពេញត្រូវបញ្ឈរជើង ។
ក្នុងបណ្ដាភ្ញៀវដែលអញ្ជើញមកក្នុងពិធីមង្គលការក្មួយស្រីខ្ញុំ ច្រើនជាអ្នកមានបណ្ដាស័ក្ដិ ។
គ្រប់បណ្ដាកម្មករតែងតែធ្វើកូដកម្មដើម្បីទាមទារដំឡើងបៀវត្ស ។
ស្កន្ទគ្រាះ ដំណើរចាប់ជំងឺដែលបណ្ដាលពីបិសាចស្កន្ទ ។
បណ្ដាលមកពីបញ្ហាគមនាគមន៍
ទើបតាជូជកបណ្ដើរយកទៅ ទោះបីកុមារទាំងពីរយំស្រែកយ៉ាងណា
រៀនបណ្ដើរ ធ្វើការបណ្ដើរ។
ចាប់បានដាក់គុកបណ្ដោយ
ឈើងាប់តែងតែអណ្ដែត បណ្ដោយទឹក ។
ចូរកុំបណ្ដោយឲ្យជនទុច្ចរិតទាំងខ្មែរ ទាំងខ្មែរ ឥស្លាម ទាំងយួនធ្វើការបំផ្លាញសម្បត្តិធម្មជាតិនេះបន្តទៅទៀតឲ្យសោះ ។
ប្អូនអាចឡើងគ្រងរាជ្យសម្បត្តិបន្តពីឪពុកប្អូន បានយ៉ាងស្រួល
សុំផ្អាកការពិភាក្សាប៉ុណ្ណេះបន្តតទៅទៀត នេះយើងធ្វើសេចក្ដីសម្រេចរបស់អង្គប្រជុំ ។
ស្រុកយើងចូលចិត្តធ្វើបុណ្យណាស់ បន្តិចធ្វើបុណ្យនេះ បន្តិចធ្វើបុណ្យនោះ ។
យើងមានអំបិលល្មមចែកគ្នាបានបន្តិចម្នាក់ៗ ។
អ្នករងរបួសត្រូវបញ្ជូនទៅកាន់បន្ទប់សង្គ្រោះជាបន្ទាន់ ។
លោកអភិបាលខេត្តទៅភ្នំពេញដើម្បីសុំជំនួយជាបន្ទាន់ ។
អ្នករបួសត្រូវការវះកាត់ជាបន្ទាន់ ។
បន្ទប់បន្ទាប់បន្ទប់ខ្ញុំជាបន្ទប់ប្អូនខ្ញុំបន្ទាប់ ។
បន្ទាប់ពីប្រជុំរួច គេនាំគ្នាទៅហាងបាយ ។
ក្នុងពិធីបុណ្យនេះមានធ្វើពិធីតាមព្រះពុទ្ធសាសនា បន្ទាប់មកមានធ្វើការជប់លៀងភ្ញៀវ ។
ខិតខំប្រឹងប្រែងយ៉ាងពេញបន្ទុក
ក្ដារមួយបន្ទះ
កំណាត់សំពត់មួយបន្ទះ
ឪពុកបានផឹកមកច្រើនលើកហើយ មិនឃើញមានគុណវិសេសអ្វី ដែលអាចជួយបន្ធូរបន្ថយជំងឺឲ្យបានស្រាកស្រាន្តសោះឡើយ
ខ្មែរក្រហមបន្សល់ទុកនូវសោកនាដកម្មដល់ប្រជាជនខ្មែរ ។
ថ្ងៃប៉ប្រះមាត់ព្រៃ
សក់ប៉ប្រះស្មា
បាយពុះប៉ផ្អែប ។
សំបុត្រធ្វើដំណើរនេះប៉មទេ ។
ដើម្បីឲ្យមានខ្យល់អាកាសចេញចូលបរិបូរ។
អារម្មណ៍របស់យើងបាញ់ផ្ដោតលើពាក្យស្លោកនៅលើបដាក្រហម ។
បាញ់រំខានដោយកាំភ្លើងត្បាល់
បាញ់រះនឹងកាំភ្លើងស្វ័យប្រវត្តិ
គាត់បានប្រាប់ខ្ញុំពីព្រឹកមិញថាគាត់នឹងបានធ្វើជាវិស្វករ ។
ខ្ញុំរៀន ភាសាខ្មែរបានពីរឆ្នាំហើយ ។
ខ្ញុំមើលសៀវភៅបានបីក្បាល ។
គាត់ជាមនុស្សម៉ត់ចត់ណាស់គាត់ ធ្វើអ្វីតែងតែបានការ ។
ក្រុមហ៊ុនអាកាសចរណ៍អន្តរជាតិកម្ពុជា CIA ត្រូវបិទទ្វារជាស្ថាពរ
ឮសូរសន្ធឹកហ៊ោកញ្ជ្រៀវបីដូចជាសំឡេងផ្គរលាន់
ការផ្សាយព័ត៌មានរបស់យើងនៅពេលនេះចប់តែប៉ុណ្ណេះ ។
ខ្ញុំយកតែប៉ុណ្ណេះទេ ។
ប៉ុន្មានខែមុននេះ
ស្អប់គេប៉ុន្មាន ស្រឡាញ់គេប៉ុន្មានទុកតែ ក្នុងចិត្តបានហើយ។
បុព្វលាភធានារ៉ាប់រង
គាត់ធ្វើការខាងប៉ុស្តិ៍ ។
ខ្ញុំបានជួយគាត់ច្រើនណាស់ បើកុំប៉ុណ្ណោះ គាត់មិនស្គាល់ខ្ញុំទេ ។
គាត់បានចុះដើមទុនច្រើនណាស់ បើម្ល៉េះហើយកិច្ចការនោះត្រូវតែបានសម្រេច ។
ប៉ូលិសត្រូវខំបង្ក្រាបឧក្រិដ្ឋកម្ម បើម៉្លោះសម គេនឹងថាប៉ូលិសគ្មានសមត្ថភាព ។
កាំមីញ៉ុងណែត ម៉ាកនីសាន់ ពណ៌សមួយគ្រឿងមានគ្នា២ នាក់បានបើកកៀរម៉ូតូរបស់អ្នកទាំងបី
សន្ទនាគ្នាមួយសន្ទុះ គេបំបែកគ្នារៀងខ្លួន ។ មុននឹងបែកកញ្ញាថាវី ក៏វាចាទៅកាន់កំលោះវឌ្ឍនា
គួរកត់សំគាល់ថា ក្រោយពីជោគជ័យរបស់យួនខាងជើងលើសហរដ្ឋអាមេរិកមក ប្លុកកុម្មុយនិស្តបានបែកគ្នាជា ពីរបក្សដាច់ ។
ពួកខ្មែរក្រហមបានបែកសំបុកដោយសារក្រុមប៉ូលិសសំងាត់ ។
នាងដែងនេះច្រើនមានក្នុងខែត្រកំពតប៉ែកខាងលិច
កុំ បោកទ្វារខ្លាំងពេក ។
ផ្ទះនោះត្រូវភ្លើងឆេះបោស ។
ខ្ញុំមិនមែនក្មេងបៅដោះទេ ។
ខ្ញុំមិនមែនក្មេងបៅដោះទេ ។
សន្ទនាគ្នាមួយសន្ទុះ គេបំបែកគ្នារៀងខ្លួន ។ មុននឹងបែកកញ្ញាថាវី ក៏វាចាទៅកាន់កំលោះវឌ្ឍនា
បំប្លោងគ្រាប់កាំភ្លើងត្បាល់ទៅលើប៉ុស្តិ៍សត្រូវ ។
បច្ចុប្បន្ន អាចផ្ដោតខ្លាំងទៅលើការការពារតាមការបង្ក្រាបភ្នាក់ងារចំលង ដូចជាបន្ថយអត្រាឈឺតាមរយៈការបំផុសពីការ ប្រើថ្នាំជ្រលក់មុង ។
ភ្លើងភ្លឺបំផ្លុងកណ្ដាលព្រៃ
បំពាក់ពណ៌ក្រហម
ការបំពុលខ្យល់
ខែរះបំព្រាង ។
ដែលកើតចេញពីការបំភាយឧស្ម័នកាបូនិច។
អំពីបម្រែបម្រួលអាកាសធាតុ
លោកបាំងមុខខ្ញុំ ។
ឆ្នាំនេះ ថ្ងៃបុណ្យរំលឹកឯករាជ្យមិនប៉ះចំថ្ងៃអាទិត្យទេ ។
រថយន្តបានបោះពួយ តាមដងវិថីមុនីវង្សយ៉ាងលឿនស្លេវសំដៅទៅកាន់មន្ទីរពេទ្យកាល់ម៉ែត ។
មានកូនប្រុសប្រកបកិត្តិគុណនឹងចិត្តសទ្ធាដល់អ្នកផង
សំណើប្រកបដោយន័យស្ថាបនានិងទទួលខុសត្រូវ របស់រដ្ឋកម្ពុជា
សូមទោសចា៎ះ បើសិនជាខ្ញុំរំខានឬក៏សួរអ្វី សូមលោកកុំប្រកាន់
ប្រការទី ៤ ក្នុងរដ្ឋធម្មនុញ្ញ
ប្រចាំប្រទេសកម្ពុជា
ការជួបគ្នា នេះបានប្រព្រឹត្តទៅក្នុងស្ថានទូតចិនប្រចាំក្រុងបាងកក ។
រឿងព្រេងនិទានប្រចាំភ្នំនោះមានដូចតទៅ
ហានិភ័យនៃការចោទប្រកាន់និងដាក់ទណ្ឌកម្ម ដែលប្រឈមដោយចុងទោសនៅក្នុងការជម្រះក្ដី ព្រហ្មទណ្ឌមួយ។
ដើម្បីជំរុញការអនុវត្តន៍បណ្ដាគម្រោងនិងយន្តការមួយចំនួនសម្រាប់ប្រឈមនឹងការដោះស្រាយបញ្ហាទាំងអស់នេះ ។
តុកៅអីមួយប្រដាប់
ប៉ាន់ពែងមួយប្រដាប់
ប្រដាប់ដោយអាវុធ
ក្នុងដំណើរតាមផ្លូវ មានពួកព្រាហ្មណ៍ទៅតាម សុំទ្រព្យសម្បត្តិ សេះនឹងរាជរថដែលព្រះអង្គគង់ប្រថាប់ ព្រះអង្គក៏ប្រទានទៀត ហើយយាងផ្ទាល់ព្រះបាទទៅ ។
ភូមិសាស្ត្រនៅទីនោះមានគ្រោះថ្នាក់ច្រើនណាស់ ប្រសិនជាគេទៅទាំងប្រថុយប្រថាន ។
ព្រះឥន្ទបានប្រទានពរដប់ប្រការតាមសេចក្ដីសុំរបស់នាង
ផ្ទះខ្ញុំនៅប្របស្ទឹង ។
ថ្ងៃប្រផាត់មាត់ព្រៃ ។
តាមបទល្មើសកំហុសដែលពួកគេបានប្រព្រឹត្ត ។
ការជួបគ្នានេះបានប្រព្រឹត្តទៅក្នុងស្ថានទូតចិនប្រចាំក្រុងបាងកក ។
កងកម្លាំងទាំងបីប្រភេទ
គីង្គក់ខំប្រវេប្រវាឡើងទៅជិតប្រគាបមែកឈើ
ប្រហែលមិនយូរទេ ខ្មែរក្រហមនឹងសុខចិត្តចុះចាញ់ហើយ ។
អាចំណាប់ពួកម៉ាកខ្ញុំនិងខ្ញុំបានប្រឡងជាប់ជាវិស្វករ ។
ប្ដីប្រពន្ធ គេឈ្លោះគ្នាយើងអ្នកក្រៅកុំចូលប្រឡូក ។
ប្រហែលជាពំនូកនេះដែលពស់ថ្លាន់នោះបានប្រាប់យើង ។
បញ្ញត្តិនេះជាសាធារណៈឥតប្រារព្ធ ឈ្មោះណាមួយដោយដាច់ខាតទេ ។
ឯកឧត្ដមហួសអាយុចូលនិវត្តអើយ បើបំណាច់ចេះប្រូ ប្រូអោយមានក្បួនផង
គ្រឿងស្អិតស្អាងខ្លួន ដូចជាក្រាស់ កញ្ចក់ ប្រេងម្សៅ កន្ត្រៃ កាំបិតកោរ
គេមិនត្រូវប្រែក្លាយប្រជាជនកម្ពុជាឲ្យទៅជាចំណាប់ខ្មាំងរបស់ពួកខ្មែរក្រហម
បញ្ហាប្រែប្រួលអាកាសធាតុ
ការប្រែប្រួលអាកាសធាតុ
ប្រជារាស្ត្រខ្មែរចាប់ពីអាយុសាមប្លាយឡើងទៅ
អាយុម្ភៃប្លាយ
នៅក្នុងពិធីបុណ្យឈាបនកិច្ច គ្រួសារសពតែងរៀបប្រដាប់ប្រដាសព្វសារពើសម្រាប់ដាក់ប្លុងដល់អ្នកដែលស្លាប់ ។
ខ្វាក់ផងថ្លង់ផង។
ដើមត្នោតជាដំណាំឲ្យផលជាងគេក្នុងប្រទេសកម្ពុជា ។
ហ្វូស្វាត សម្រាប់ផលិតជីផ្សេងៗ
អ្នកជំងឺនោះទើបនឹងផុតដង្ហើមអំបាញ់មិញនេះ ។
យើងផុតពីគ្រោះថ្នាក់ហើយ ។
ខ្ញុំចេញផុតបន្តិចលោកអញ្ជើញមកដល់ ។
អ្នកធ្លាក់ទឹកនោះលង់ទឹកហើយ ពីព្រោះគាត់ផុតដៃផុតជើង ។
សាស្ត្រាមួយផូក
ចេះតែស្រមៃឃើញវង់ភក្ត្រដ៏ផូរផង់ និងស្នាមញញិមយ៉ាងស្រស់របស់នាង
ព្រានផ្ចោតកាំភ្លើងពីលើធ្នះបាញ់សំដៅជ្រូកព្រៃ ។
រថយន្តតូចបានបរផ្ដាច់ រថយន្តដឹកទំនិញឆ្ងាយណាស់ហើយ។
ជំងឺគ្រុនចាញ់បានត្រូវផ្ដាច់ផ្តិលហើយ ។
អណ្ដាតភ្លើងកំហឹងផ្ដួចឡើង ។
ត្រូវខិតខំធ្វើដោយខ្លួនឯងកុំផ្ដេកផ្ដួលទៅលើអ្នកដទៃពេក ។
ផែនការនេះផ្ដោតទៅលើការផ្សព្វផ្សាយព័ត៌មានស្ដីពីជំងឺអេដស៍
ជំហររបស់រដ្ឋាភិបាលខ្ញុំគឺចង់ឲ្យមានដំណោះស្រាយនយោបាយមួយ ដែលផ្ដោតឡើងព្រមគ្នាទាំងទិដ្ឋភាពផ្ទៃក្នុង និងទាំងទិដ្ឋភាពអន្តរជាតិនៃបញ្ហា ។
ខ្ញុំទៅនេះដើម្បីផ្ទញ់ផ្ទាល់ប្រាជ្ញាលោកសេដ្ឋី ។
ភាគល្អិត ដែលមានផ្ទុកបន្ទុកអគ្គិសនី
រាជ្យបល្ល័ង្កសុខចិត្តផ្ទេរតំណែងទៅឲ្យសាធារណរដ្ឋដោយស្មោះស្ម័គ្រ ។
កុំធ្វើតាមផ្នត់ចាស់ ។
ខ្ញុំមិនស្គាល់ទីក្រុងញីវយ៉ក តែខ្ញុំមិនខ្លាចទេ ពី ព្រោះផ្លូវនៅនឹងមាត់។
អស់ផ្លូវទាមទារ
មានអង្គហេតុដែលអាចផ្សំបានជាឧក្រិដ្ឋកម្ម
អង្គធាតុដែលផ្សំពីកាបូន និង អ៊ីដ្រូហ្សែន
ផ្អែកតាមសំដីរបស់មន្ត្រីយោធានៃក្រសួងការពារជាតិបានឲ្យដឹងថា
ស្រីៗខ្លះចូលចិត្តអង្គុយផ្អែមផ្ទះគេ ។
ផ្សែងហុយផ្អោង ។
ប្រសិនបើគ្មានវៀតណាមម្ល៉េះ សមចិនពង្វក់ខ្មែរក្រហមឲ្យសម្លាប់ប្រជាជនអស់រលីងបាត់ទៅហើយ ។
ម៉ូតូហុងដាពណ៌ទឹកប៊ិច
ពណ៌នាអំពីទស្សនកិច្ចរបស់គណៈប្រតិភូនៅទីក្រុងភ្នំពេញ
ក្នុងមួយពន្លឺ
ពពួកអាហារទាំងនេះច្រើនតែធ្វើឲ្យមនុស្សងងុយគេងក្នុងពេលថ្ងៃត្រង់ ។
មួយពព្រិចភ្នែក
ពួករ៉ាឌីកាល់នេះបានធ្វើពហិការមិនចូលរួមក្នុងការបោះឆ្នោត ហើយថែមទាំងប៉ុនប៉ង ឆាឆៅរំខានការបោះឆ្នោតដោយធ្វើការវាយប្រហារទៅលើទីតាំងរបស់រដ្ឋាភិបាលហើយនិងបុគ្គលិករបស់អ៊ុនតាក់ ទៀតផង ។
ពាក់ព័ន្ធនឹងមូល ហេតុនៃការវិលមកកាន់ស្រុកកំណើតជា អតីតវាលពិឃាត លោកហាំងង៉ោបានលើកឡើងពីមនោសញ្ចេតនាស្នេហាមាតុភូមិ
ខ្ញុំនិយាយពិត
ខ្ញុំពិបាកឆ្លើយ ណាស់រឿងហ្នឹង ។
កើតពីព័ន្ធពិសអារឹស
មនុស្សអាក្រក់មិនដែលរួចពីដៃប៉ូលិស ។
គឺប្អូនបានពឹងផ្អែកទាំងស្រុងទៅលើចិននិងយួនខាងជើង
ពុតគ្រូកុំឲ្យត្រាប់ ។
កើតទុក្ខ រកពុទ្ធោ
ផ្ទុកពេញទូកលុះទាល់តែពៀប ។
មានសៀវភៅពេញបន្ទប់
ដល់ម៉ោង ដប់កន្លះ មនុស្សម្នាកុះករពេញអាវាសវត្ត ចាប់ផ្ដើមរាប់បាត្រធ្វើពិធីមហាបង្សុកូលរួមរួប
ដូច្នេះ បើយើងក្រឡេកមើលល្បឿននៃការស្រុះ ស្រួលគ្នាដោយត្រួសៗទៅលើបញ្ហាខ្មែរ ឃើញថាមានដំណើរល្អគួរឲ្យពេញចិត្ត
គាត់ពេញជាឧបាសិកាពិតប្រាកដ ។
កូនសិស្សនេះពេញជា ក្មេងឆ្លាតមែន ។
នាងមានកិរិយាសុភាពរម្យទមជាទីពេញភ្នែកខ្ញុំ ។
ពោលឲ្យខ្លី គឺជ័យជំនះរបស់លទ្ធិកុម្មុយនិស្តមកលើលទ្ធិសេរីនិយម ។
ខ្ញុំពុំគាប្បីនិយាយអញ្ចឹង ។
មនុស្សពុំជាបើសេពគប់
ដោះស្រាយបញ្ហាជីវភាពដោយខ្លួនឯង ពុំសូវពឹងផ្អែក លើប្រជាជនកសិករពេក
ព្យាករណ៍សេដ្ឋកិច្ច
កីឡាករបាល់ទាត់ពីររូបត្រូវព្យួរជើងមួយឆ្នាំ ។
កំបៃជាគ្រឿងយន្ត ដែលមានផ្នែកកាត់ បោកបែន នឹងសំអាតក្នុងពេលព្រមគ្នាតែម្ដង ។
ប្រទេសនេះបានជួយច្បាំងខ្មែរក្រហមប្រឆាំងនឹងរបបលន់នល់ ព្រមទាំងបានជួយជំនួយគ្រប់បែបយ៉ាងទៀត ។
យើងអាចមើលឃើញផ្កាយច្រើនពាន់ដួង ខ្លះភ្លឺខ្លាំង ខ្លះភ្លឺព្រាលៗ ។
នាងអេតឃើញពស់ ក៏ភ័យខ្លាច ព្រឺស្ញើបអស់ទាំងខ្លួន
គ្រាន់តែឮឈ្មោះ អញព្រឺក្បាលចង់ជ្រុះសក់ទៅហើយ
វាយោអើយ អ្នកបក់មកត្រសៀវគួរឲ្យព្រឺព្រួចអារម្មណ៍ខ្លាំងណាស់ ។
អរុន្នីភ្ញាក់ខ្លួនព្រើត ។
រាត្រីស្ងាត់ជ្រងំអំពិលអំពែកហើរព្រោងព្រាត ឃើញកូនពន្លឺភ្លឹបភ្លែតៗ ។
អតីតព្រះមហាក្សត្រសម្ដេចនរោត្តមសីហនុទ្រង់មានព្រះជន្មនៅឡើយ ។
សម្ដេចមានព្រះរាជឱង្ការថា
ព្រះរាជាណាចក្រអង់គ្លេស
ព្រះអង្គបានយល់ព្រមតាមពាក្យអង្វររបស់ព្រះមាតាចិញ្ចឹមរបស់ព្រះអង្គ
ភាពយឺតត្រូវគណនាដោយរូបមន្ត
ភ្លៀងកំពុងតែធ្លាក់ខ្លាំងដូចកំហឹងព្រះភិរុណ ។
មានភូមាម្នាក់នៅទីផ្សារ
ដើម្បីការពារភូមិលេខរបស់ស្រុកនិង ភូមិលេខរបស់ខែត្រ
កុំត្រាប់កុកស ភោរភាវសព្វថ្ងៃ ។
ប៉ូលិសភ្ជង់កាំភ្លើង ដាក់ត្រចៀកចោរ ។
យកកាំភ្លើងខ្លីភ្ជង់ខ្នង
ដល់មាន់រងាវកឺត ប្រុសៗភ្ញាក់ឡើងឃើញផ្កាយព្រឹករះក៏លាន់មាត់ថា
អរុន្នីភ្ញាក់ខ្លួនព្រើត ។
យើងភ្ញាស់គម្រោងការណ៍មួយ ។
ភ្នែកមនុស្សធំរលីង ភ្នែកជញ្ជីងគេចុចល្អិត ។
នឹងទៅជួយកូនខ្មែរយើងដែលទើបតែងើបពីល្ងឹតល្ងង់ ឲ្យបានភ្លឺច្បាស់ខ្លះៗ
គេទាំងឡាយបាក់ភ្លូកទឹកភ្លូកដី សំដៅទៅវាលខ្សាច់
នាងហ្នឹងមុននឹងបានជាប្រពន្ធថៅកែមិនដឹងប៉ុន្មានភ្លើងហើយ ។
ជាឥទ្ធិពលមួយ ដ៏ខ្លាំងក្លាអូសទាញយុវជនខ្មែរ អោយលង់លក់ទៅក្នុងអំពើពាលាអាវាសែភ្លើតភ្លើនកាមតណ្ហា ។
ភ្លៀងដូចគេចាក់ទឹកតែម្ដង ។
មេឃចង់ភ្លៀង ។
ភ្លេចខ្លួនដាច់ឆ្នាំទៅហើយ ។
ខ្ញុំបានរៀបអាពាហ៍ពិពាហ៍អស់រយៈពេល ១០ ឆ្នាំមកហើយ ។
នាងរុណ្ណាកំពុងនៅរង់ចាំតែស្ដេចមច្ចុរាជយាងមកផ្ដាច់ជីវិតគាត់តែប៉ុណ្ណោះ។
មនោសញ្ចេតនាបដិវត្តន៍យ៉ាងជ្រាលជ្រៅបំផុត
ស្រីទាំងនោះក៏ភិតភ័យរន្ធត់តក់ស្លុតមហិមា
គ្រាន់តែម៉ាសប្បាយ
កុំនិយាយម៉ាត់ណាម៉ាត់នោះ !
ស្គាល់មាត្រាអក្សរ
ខ្ញុំត្រូវធ្វើដំណើរទៅស្រុកបាកាណ នាងមានដឹងថាមានអ្នកណាគេត្រូវធ្វើដំណើរទៅស្រុកនោះទេ
ក្រសួងយុត្តិធម៌ រហូតមកដល់ពេលនេះ មាន មធ្យោបាយនៅមានកម្រិតនៅឡើយក្នុងការដោះស្រាយចំពោះការរំលោភនេះ
ខ្មែរយើងប្រើពាក្យនេះចំពោះតែវត្ថុមានមាសប្រាក់ជាដើមដែលមានម្ចាស់។
តាមទ្រឹស្ដីសម្ភារនិយម មានតែពួកកម្មករកម្មាជីពទេ ដែលជាអ្នកកសាងពិភពលោក
នៅក្នុងពិធីបុណ្យនោះ ខ្ញុំបានឃើញមនុស្សម្នាប្រុសស្រីតូចធំជាច្រើននាក់ មានថែមទាំងលោករដ្ឋមន្ត្រីក្រសួងធម្មការ បានអញ្ជើញមកជាអធិបតីផង។
កំណាត់សំពត់នេះមានផ្ទៃខ្មៅផ្កាពណ៌ក្រហម ។
កុំធ្វើមាយាដកខ្ញី !
លោកស៊ឺនសានថាដើម្បីឲ្យរាស្ត្របោះឆ្នោត បានរាស្ត្រហ្នឹងត្រូវមានលិខិតបញ្ជាក់ត្រឹមត្រូវថាមានសញ្ជាតិជាខ្មែរកើតនៅស្រុកខ្មែរ មានគំនិតមារយាទល្អត្រឹមត្រូវ មានអាយុយ៉ាងតិច ១៨ ឆ្នាំ ។
មិនល្អប៉ុន្មានទេ
ម្ហូបនេះខ្ញុំមិនចូលចិត្តប៉ុន្មានទេ ។
តាមខ្ញុំស្មាន ឡាននេះថ្លៃមិនដល់ប៉ុណ្ណឹងទេ ។
វាមិនត្រឹមតែល្ងង់ប៉ុណ្ណោះទេ ថែមទាំងខ្ជិលទៀតផង ។
កិច្ចការទាំងនោះមិនមែនធ្វើតែឪពុកខ្ញុំម្នាក់ឯងទេ ។
៥០ រៀលនេះមិនជាអ្វីទេចំពោះថៅកែឬកម្មាភិបាលផឹកស៊ីស្រីញីអូនបងមួយចំនួន
លោកសុខមានប្រសាសន៍ថាគាត់មិនអញ្ជើញមកទេក្នុងពិធីប្រជុំនេះ ស្រាប់តែឥឡូវ មកធ្វើមុខក្រមឹមម៉ឹមនៅពេលនេះដែរ។
ប្ដេជ្ញាចិត្តមុតមាំ
ក្នុងវេលាប៉ុន្មាន ឆ្នាំមុននេះ
កាត់សក់ខ្លីបែបម៉ូតបុរស
គាត់មានគំនិតមូលស្លុងជាមួយប្រពន្ធគាត់ ។
ជីវិតរស់នៅក្នុងរបបខ្មែរក្រហមមួយថ្ងៃកាត់មួយថ្ងៃកោរ រង់ចាំតែថ្ងៃស្លាប់ ។
កោះប្រជុំពួកសេនាបតីមួយរំពេច ។
មើលមើល៍ អ្នកណាគោះទ្វារ ។
លោកនិយាយខ្មែរមើលតែ ខ្មែរអញ្ចឹង ។
ម៉ាក់ខ្ញុំកំពុងតែសម្រាន្តហើយមើលទៅ ។
ជាមួយគ្នានេះ មិនត្រូវមើលស្រាលការចំលងតាមឈាមទេ ។
ខ្ញុំឈឺក្បាលផង វិលមុខធីងធោងផង រងាស្រៀវស្រាញឈឺចុកចាប់គ្រប់សន្លាក់ដៃជើងរសេះរសោះ ក្ដៅ ខ្លួនទៀតផង យ៉ាងដូច្នេះហាក់ដូចជាមានមេរោគគ្រុនចាញ់ពីរបីមេមកយាយីខ្ញុំឲ្យស្លាប់តែម្ដង ។
ម៉េចក៏បានមួយដុល្លារដែរ
គ្មានហេតុម៉េចអ្វីទេ ។
សូមមេត្តាប្រោស
លីងអង្ករមួយមែញ
ភាសាខ្មែរស្រួលរៀនមែន ។
ភាសាខ្មែរស្រួលរៀនមែន ។
របៀបគ្រប់គ្រងរបស់ក្រុង ដែលផ្ដល់អោយអតិថិជនម៉ៅផ្ដាច់តំបន់ភ្លើង
កុំម៉ាំងខាំងពេក។
ក្ដារនេះសុំម្ច៉ានហើយ ។
គេអាចម្ចាស់ការលើការងារជំនាញ ។
របស់អស់នេះ ខ្ញុំបានរៀបចំទុកដាក់ត្រឹមត្រូវអស់ហើយ ម្ដេចក៏ទៅជាអញ្ចឹងវិញ !
ខ្ញុំផ្ញើទៅជូនហើយ ម្ដេចក៏ទៅជាអញ្ចឹង?
ទោះបីជាយូរម្ដេចម្ដា ខ្ញុំប្រាថ្នាថាយើងនឹងបានជួបទៀត ។
ម្នាលកូនសំឡាញ់
ឲ្យជ្រើសរើសរកសេនា ជឿចិត្តចិន្ដា ម្នីម្នាគិតការឲ្យឆាប់។
តាព្រាហ្មណ៍ក៏ម្នីម្នាទៅតាមបង្គាប់ប្រពន្ធ
មេអំបៅធ្វើស្លាបម្រីកៗ ។
ម្ល៉ោះហើយ ខ្មែរក្រហមចំណេញទាំងអស់ ។
ច្បាប់នេះមានគោលដៅការពារ និងលើកកម្ពស់សិទ្ធិជនពិការក្នុងព្រះរាជាណាចក្រកម្ពុជា។
ការពារសិទ្ធិ និងសេរីភាពរបស់ជនពិការ
ការពារផលប្រយោជន៍ជនពិការ
ទប់ស្កាត់ កាត់បន្ថយ និងលុបបំបាត់ការរើសអើងជនពិការ
ស្ដារកាយសម្បទា សតិបញ្ញា និងវិជ្ជាជីវៈ ដើម្បីធានាលទ្ធភាពក្នុងការចូលរួមដ៏ពេញលេញ និងដោយស្មើភាពនៃជនពិការក្នុងសកម្មភាពនានារបស់សង្គម។
ច្បាប់នេះ មានវិសាលភាពអនុវត្តចំពោះជនពិការ និងសកម្មភាពទាំងឡាយណាដែលទាក់ទងនឹងជនពិការនៅព្រះរាជាណាចក្រកម្ពុជា។
ទីកន្លែងសាធារណៈ
គ្រឹះស្ថានសិក្សាសាធារណៈ
សំដៅដល់សាលាសាធារណៈ ដែលបានធ្វើការអប់រំ បណ្ដុះបណ្ដាលសិស្សគ្រប់វ័យ។ គ្រឹះស្ថានសិក្សាសាធារណៈ រាប់បញ្ចូលចាប់ពីកម្រិតមត្តេយ្យសិក្សាឡើងទៅ។
គ្រឹះស្ថានសិក្សាឯកជន សំដៅដល់សាលាឯកជន ឬ អង្គការទាំងឡាយណាដែលបានទទួលការអនុញ្ញាតឱ្យ បង្កើត សម្រាប់ធ្វើការអប់រំបណ្ដុះបណ្ដាលសិស្សគ្រប់វ័យ។
ក្រុមប្រឹក្សាសកម្មភាពជនពិការនិងរដ្ឋបាលសិទ្ធិជនពិការ
ក្រុមប្រឹក្សាសកម្មភាពជនពិការ មានភារកិច្ចដូចខាងក្រោម
ជំរុញការអនុវត្តគោលនយោបាយ ច្បាប់ និងបទបញ្ជាផ្សេងៗពាក់ព័ន្ធនឹងបញ្ហាពិការភាព និងការស្ដារលទ្ធភាពពលកម្ម
លើកសំណើកែសម្រួល បំពេញបន្ថែម ធ្វើវិសោធនកម្មគោលនយោបាយច្បាប់ និង បទបញ្ជាផ្សេងៗ ពាក់ព័ន្ធនឹងបញ្ហាពិការភាព
តាមដាន វាយតម្លៃការអនុវត្តគោលនយោបាយ ផែនការជាតិ ច្បាប់ និងបទបញ្ជាផ្សេងៗពាក់ព័ន្ធនឹងបញ្ហាពិការភាព
ទំនាក់ទំនងជាមួយសហគមន៍ជាតិ-អន្តរជាតិ ដើម្បីផ្លាស់ប្ដូរបទពិសោធន៍ កៀរគរប្រភពធនធានទាំងក្នុង និងក្រៅប្រទេស។
ក្រុមប្រឹក្សាសកម្មភាពជនពិការរួមមាន
រដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យសង្គមកិច្ច ឬ តំណាង ជាប្រធាន
តំណាងក្រសួង ស្ថាប័នពាក់ព័ន្ធ
តំណាងអង្គការនិយោជិក និងអង្គការមិនមែនរដ្ឋាភិបាលដែលធ្វើសកម្មភាពជួយដល់ជនពិការ
ការរៀបចំសមាសភាព និងការប្រព្រឹត្តទៅនៃក្រុមប្រឹក្សាសកម្មភាពជនពិការ ត្រូវកំណត់ដោយអនុក្រឹត្យ
ក្រសួងទទួលបន្ទុកវិស័យសង្គមកិច្ច ត្រូវបង្កើតរដ្ឋបាលសិទ្ធិជនពិការដែលជាអង្គភាពចំណុះនាយកដ្ឋានស្ដារលទ្ធភាពពលកម្ម។
ក្រសួងទទួលបន្ទុកវិស័យសង្គមកិច្ច ដោយសហការជាមួយក្រសួង ស្ថាប័ន និងអង្គការពាក់ព័ន្ធ មានភារកិច្ចរៀបចំទិវាជនពិការកម្ពុជា និងទិវាកីឡាជនពិការកម្ពុជា ក្នុងគោលបំណងបំផុសការយល់ដឹងជាសាធារណៈអំពីសុខុមាលភាពនៃជនពិការ និងលើកទឹកចិត្តជនពិការ ដើម្បីចូលរួមក្នុងសកម្មភាពសេដ្ឋកិច្ច សង្គមកិច្ច វប្បធម៌ និងសកម្មភាពផ្សេងៗទៀត។
រដ្ឋត្រូវយកចិត្តទុកដាក់ ជួយលើកតម្កើងជីវភាពរស់នៅរបស់ជនពិការឱ្យ បានសមរម្យស្របតាមស្ថានភាពសេដ្ឋកិច្ចជាតិ។
រដ្ឋត្រូវមានថវិកាប្រចាំឆ្នាំ ដើម្បីធ្វើសមាហរណកម្មជនពិការទៅក្នុងសហគមន៍។
រដ្ឋត្រូវរៀបចំកម្មវិធីស្ដារកាយសម្បទា និងសតិបញ្ញា សំដៅជួយដល់ជនពិការឱ្យអាចបំពេញមុខងារ និងប្រើប្រាស់សមត្ថភាព ទេពកោសល្យ ក្នុងជីវភាពសង្គម។
មជ្ឈមណ្ឌលស្ដារកាយសម្បទា និងសតិបញ្ញា
សាលាសម្រាប់បណ្ដុះបណ្ដាល អ្នកបច្ចេកទេសផលិត ឧបករណ៍ទ្រទ្រង់រាងកាយ
មជ្ឈមណ្ឌលផលិតគ្រឿងផ្សំ ឧបករណ៍ទ្រទ្រង់រាងកាយ ដើម្បីធានាសេចក្ដីត្រូវការនៃមជ្ឈមណ្ឌលស្ដារកាយសម្បទានានា ក្នុងការផ្ដល់ឧបករណ៍ទ្រទ្រង់រាងកាយដល់ជនពិការ។
ការបង្កើតមជ្ឈមណ្ឌលស្ដារកាយសម្បទា សតិបញ្ញា និងមជ្ឈមណ្ឌលផលិតគ្រឿងផ្សំឧបករណ៍ទ្រទ្រង់រាងកាយ ត្រូវកំណត់ដោយប្រកាសរបស់រដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យសង្គមកិច្ច។
ក្រសួងទទួលបន្ទុកវិស័យសង្គមកិច្ច សហការជាមួយក្រសួងទទួលបន្ទុកវិស័យសុខាភិបាល ត្រូវរៀបចំកម្មវិធីបណ្ដុះបណ្ដាលបច្ចេកទេសព្យាបាលដោយចលនា និងព្យាបាលសតិបញ្ញា នៅតាមសាលាបច្ចេកទេសថែទាំវេជ្ជសាស្ត្រនានា ហើយបញ្ចូលផ្នែកនេះឱ្យ មានគ្រប់មន្ទីរពេទ្យ ដើម្បីព្យាបាលអ្នកជំងឺកុំឱ្យ ធ្លាក់ខ្លួនពិការ
ពង្រីកសេវាស្ដារលទ្ធភាពពលកម្ម តាមសហគមន៍ សេវាពិគ្រោះយោបល់ព្យាបាលជំងឺផ្លូវចិត្ត និងសតិបញ្ញាខ្សោយ
រដ្ឋត្រូវបង្កើតកម្មវិធីបង្ការពិការភាព ដល់ពលរដ្ឋគ្រប់រូបតាមរយៈ
ការថែទាំសុខភាពក្នុងពេលមានគភ៌
ការផ្ដល់អាហារទ្រទ្រង់រាងកាយ
ការព្យាបាលតាមវិធីវេជ្ជសាស្ត្រ និងការអប់រំកាយសម្បទាឡើងវិញឱ្យទាន់ពេលវេលា។
ក្រសួង ស្ថាប័នមានសមត្ថកិច្ចពាក់ព័ន្ធ ត្រូវបង្កលក្ខណៈឱ្យជនពិការ បានចូលរួមរៀបចំរាល់គម្រោងអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គមកិច្ច និងវប្បធម៌ ដែលប៉ះពាល់ដល់ផលប្រយោជន៍ជនពិការ។
ក្រសួង ស្ថាប័នពាក់ព័ន្ធ ត្រូវដាក់បញ្ចូលសេចក្ដីត្រូវការរបស់ជនពិការទៅក្នុងកម្មវិធី អភិវឌ្ឍនានា។
គោលនយោបាយជួយឧបត្ថម្ភ សេវាពិនិត្យថែទាំសុខភាព ព្យាបាលនិងស្ដារលទ្ធភាពពលកម្មកាយសម្បទា ដល់ជនពិការដែលមានពិការភាពធ្ងន់ធ្ងរ ឬ ក្រីក្របំផុតគ្មានទីពឹង ត្រូវកំណត់ដោយអនុក្រឹត្យ។
លក្ខណវិនិច្ឆ័យប្រភេទ និងកម្រិតនៃពិការភាព ត្រូវកំណត់ដោយប្រកាសរួមរបស់រដ្ឋមន្ត្រីបន្ទុកវិស័យសង្គមកិច្ច និងរដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យសុខាភិបាល។
ការកំណត់លក្ខណវិនិច្ឆ័យ និងកម្រិតនៃពិការភាពរបស់យោធិន ត្រូវមានការចូលរួមពីក្រសួងទទួលបន្ទុកវិស័យការពារជាតិ។
ការចេញចូលទីកន្លែងសាធារណៈ
ក្រសួងមានសមត្ថកិច្ចដែលផ្ដល់លិខិតអនុញ្ញាតលើគម្រោងសាងសង់ ការសាងសង់និងត្រួតពិនិត្យសំណង់ ទីកន្លែងសាធារណៈ ត្រូវធានាលក្ខណៈងាយស្រួលចេញចូលរបស់ជនពិការ ដូចមានចែងក្នុងមាត្រា ២១ នៃច្បាប់នេះ។
ជនពិការមានសិទ្ធិទទួលប័ណ្ណបើកបរយានយន្ត។
សមត្ថភាពបើកបរយានយន្តនៃជនពិការ ព្រមទាំងប្រភេទយានយន្តសម្រាប់ជនពិការ ត្រូវកំណត់ដោយប្រកាសរួមរបស់រដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យសាធារណការ និងដឹកជញ្ជូន និងរដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យសុខាភិបាល។
ក្រសួងទទួលបន្ទុកវិស័យសាធារណការ និងដឹកជញ្ជូន ត្រូវចេញប័ណ្ណសម្គាល់យានយន្ត និងប័ណ្ណបើកបរពិសេសដល់ជនពិការ។
រាល់ទីកន្លែងសាធារណៈ ដែលមានចំណតយានយន្ត ត្រូវរៀបចំឱ្យ មានចំណតយានយន្តពិសេសសម្រាប់ជនពិការ។
រាល់ទីកន្លែងសាធារណៈ ដែលមានបន្ទប់អនាម័យ ត្រូវរៀបចំឱ្យ មានបន្ទប់អនាម័យសម្រាប់ជនពិការ។
ការរៀបចំចំណតយានយន្តសម្រាប់ជនពិការ ត្រូវកំណត់ដោយប្រកាសរបស់រដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យសាធារណការ និងដឹកជញ្ជូន។
សិស្ស-និស្សិតពិការគ្រប់រូប មានសិទ្ធិចូលសិក្សាក្នុងគ្រឹះស្ថានសិក្សាសាធារណៈ និងឯកជន និងមានសិទ្ធិទទួលអាហារូបករណ៍ដូចសិស្ស-និស្សិតដទៃទៀតដែរ លើកលែងតែមានបញ្ញត្តិផ្ទុយពីនេះ។
រដ្ឋត្រូវបង្កើតគោលនយោបាយ និងយុទ្ធសាស្ត្រជាតិ សម្រាប់អប់រំសិស្ស-និស្សិតពិការដូចជា
ការបង្កើតថ្នាក់រៀនពិសេស សម្រាប់ឆ្លើយតបនឹងសេចក្ដីត្រូវការនៃសិស្សនិស្សិតពិការ។
ក្រសួងទទួលបន្ទុកវិស័យអប់រំ ត្រូវរៀបចំកម្មវិធីសម្រាប់គ្រឹះស្ថានសិក្សានានាក្នុងការ សម្របសម្រួលដល់សិស្ស-និស្សិតពិការនូវផ្នែកមួយចំនួន ដូចជា
ភាសាសញ្ញា និងអក្សរស្ទាប
សម្ភារៈសិក្សា ឬ ឧបករណ៍ផ្សេងៗ សម្រាប់ជំនួយដល់សិស្ស-និស្សិតពិការ
សម្ភារៈឧបទេសសម្រាប់គ្រូបង្រៀន ឬ សាស្ត្រាចារ្យ និងផ្នែកផ្សេងៗទៀតតាមការជាក់ស្ដែងរបស់សិស្ស-និស្សិតពិការម្នាក់ៗ។
ក្រសួងទទួលបន្ទុកវិស័យអប់រំ ត្រូវយកចិត្តទុកដាក់ជាពិសេសដល់សេចក្ដីត្រូវការផ្នែកអប់រំរបស់សិស្ស-និស្សិតពិការ។
សិស្ស-និស្សិតពិការក្នុងគ្រួសារក្រីក្រ ឬ ជាយោធិនពិការ ត្រូវបានទទួលដោយឥតគិតថ្លៃនូវការចូលសិក្សានៅតាមគ្រឹះស្ថាន សិក្សាសាធារណៈគ្រប់កម្រិតសិក្សា និងសៀវភៅសិក្សាព្រមទាំងសម្ភារៈសិក្សា។
គ្រឹះស្ថានសិក្សាឯកជន ត្រូវមានគោលការណ៍ពិសេសចុះថ្លៃការសិក្សា សៀវភៅសិក្សានិងសម្ភារៈសិក្សាសម្រាប់សិស្ស-និស្សិតពិការ ឬ ជាយោធិនពិការ។
ការកំណត់ការចុះថ្លៃការសិក្សា និងសម្ភារៈសិក្សា ត្រូវចែងដោយប្រកាសរួមរបស់រដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យសង្គមកិច្ច និងរដ្ឋមន្ត្រីទទួលបន្ទុកវិស័យអប់រំ។
ក្រសួងទទួលបន្ទុកវិស័យអប់រំ ត្រូវមានកម្មវិធីគរុកោសល្យអំពីពិការភាពសម្រាប់បំពាក់បំប៉នគ្រូ និងសាស្ត្រាចារ្យគ្រប់រូបឱ្យ យល់ដឹងពីពិការភាព និងវិធីសាស្ត្រាបង្រៀនសិស្ស-និស្សិតពិការ។
