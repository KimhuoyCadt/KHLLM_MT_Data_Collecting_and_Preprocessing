ប្រទេសផលិតធំៗ ចង់បន្តកាត់បន្ថយប្រេង
ពេលវេលា នៃ ការ ប្រកាស កាត់បន្ថយ ទិន្នផល ប្រេង មុន កិច្ចប្រជុំ ផ្លូវ ការ លើក ក្រោយ របស់ អង្គការ OPEC នៅ ថ្ងៃ ទី ២៥ ខែ ឧសភា ខាង មុខ នេះ និង ការ ប្រើប្រាស់ ពាក្យពេចន៍ នៅ ក្នុង សេចក្តី ថ្លែងការណ៍ នេះ បានធ្វើ ឲ្យ ទីផ្សារ ភ្ញាក់ផ្អើល ហើយ វិធានការ នេះ អាច នឹង អនុវត្ត មួយ រយៈ ដើម្បី ធានា ថា ប្រទេស ជា សមាជិក របស់ អង្គការ OPEC និង ប្រទេស ផលិត ប្រេង ផ្សេង ទៀត ដែល បាន ចូលរួម ក្នុង វគ្គ ដំបូង នៃ កម្មវិធី កាត់បន្ថយ ទិន្នផល ប្រេង នេះ នឹង ចូលរួម ។
សេចក្តី ថ្លែងការណ៍ ដដែល នេះ បាន ឲ្យ ដឹង ថា រដ្ឋមន្ត្រី ទាំង ពីរ បាន សន្យា « ធ្វើ កិច្ចការ អ្វី ដែល ចាំបាច់ » ដើម្បី កាត់ បន្ថយ សន្និធិ ប្រេង ពិភពលោក ឲ្យ មក នៅ ត្រឹម កម្រិត ជា មធ្យម ក្នុង រយៈពេល ៥ ឆ្នាំ របស់ ខ្លួន ហើយ បាន បង្ហាញ ពី ភាព សុទិដ្ឋិនិយម ថា ពួកគេ នឹង ទទួល បាន ការ គាំទ្រ ពី ក្រុម ប្រទេស ផលិត ប្រេង ដែល មិន បាន ចូលរួម នៅ ក្នុង កិច្ចព្រមព្រៀង កាត់ បន្ថយ ទិន្នផល ប្រេង នាពេល បច្ចុប្បន្ន នេះ » ។
« យើង បាន សម្រេច ថា កិច្ចព្រមព្រៀង កាត់ បន្ថយ ទិន្នផល ប្រេង នេះ ចាំបាច់ ត្រូវ តែ អនុវត្ត បន្ត ទៀត » ។
លោក ឲ្យ ដឹង ថា ក្រុមហ៊ុន នឹង ទទួល ប្រាក់ បន្ថែម ពី ៥០ ០០០ ដុល្លារ ដល់ ១០០ ០០០ ដុល្លារ ពី ក្រុមហ៊ុន OBOR ក្នុង ដំណាក់ កាល ចុង ក្រោយ ផ្អែក លើ ប្រតិបត្តិការ របស់ ខ្លួន ខណៈ ក្រុមហ៊ុន នេះ កំពុង ពិភាក្សា ជាមួយ ក្រុម វិនិយោគិន អន្តរជាតិ មួយ ចំនួន ផង ដែរ ។
លោក បន្ត ថា មូលនិធិ នេះ នឹង ត្រូវ បាន ប្រើប្រាស់ ដើម្បី កែលម្អ កម្មវិធី និង ការ ធ្វើ ពិពិធ កម្ម លើ មូលដ្ឋាន ប្រាក់ ចំណូល របស់ ខ្លួន ដែល ជា ជំហាន សំដៅ ដាក់ ទីតាំង ក្រុមហ៊ុន នេះ នៅ ទីផ្សារ ដឹក ជញ្ជូន ក្នុង តំបន់ ។
« គំនិត នេះ នឹង កែ លម្អ ផលិតផល និង បច្ចេកវិទ្យា ដែល មាន ស្រាប់ ដែល យើង មាន ទាក់ទង នឹង របៀប ដែល ក្រុមហ៊ុន គ្រប់គ្រង ការ កក់ សំបុត្រ ជា របៀប ដែល យើង គ្រប់គ្រង ប្រតិបត្តិការ និង ជា របៀប ដែល យើង ធ្វើ របាយ ការណ៍ » ។
លោក ពន្យល់ ថា មូលនិធិ នេះ នឹង ត្រូវ បាន ប្រើប្រាស់ សម្រាប់ ទីផ្សារ និង បង្កើន ការ យល់ ដឹង ពី យីហោ ពិសេស ដើម្បី ទាក់ទាញ អ្នក ប្រើ ប្រាស់ ក្នុង ស្រុក ។
លោក Tripathi បន្ថែម ថា ទិដ្ឋភាព បច្ចេកវិទ្យា នៃ អាជីវកម្ម នេះ គឺជា កន្លែង ដែល ក្រុមហ៊ុន អាច ប្រកួត ប្រជែង ជាមួយ អ្នក រក ស៊ី ធំៗ នៅ ក្នុង ឧស្សាហ កម្ម នេះ នៅ តាម បណ្ដា ប្រទេស ផ្សេង ទៀត ដោយ ក្រុមហ៊ុន សម្លឹង មើល ទៅ ប្រទេស មីយ៉ាន់ម៉ា ឡាវ និង វៀតណាម ជា ទីតាំង ដំបូង សម្រាប់ ការ ពង្រីក ។
រដ្ឋមន្ត្រីព្រមាន ការនាំចូលជ្រូកដោយខុសច្បាប់
ក្រុម ការងារ ពិសេស ថ្មី ដែល នឹង ត្រួត ពិនិត្យ លើ ការ នាំ ចូល សត្វ ជ្រូក នឹង ចាប់ ផ្ដើម ភារកិច្ច របស់ ខ្លួន បន្ទាប់ ពី ក្រុម ការងារ នេះ ត្រូវ បាន យល់ព្រម និង បាន គាំទ្រ ដោយ ក្រសួង កសិកម្ម កាលពី ម្សិលមិញ ដែល វា នឹង ត្រួត ពិនិត្យ លើ ការ រត់ពន្ធ សត្វ ជ្រូក និង កសិដ្ឋាន ចិញ្ចឹម សត្វ ជ្រូក ខុស ច្បាប់ តាម ព្រំ ដែន ដែល កំពុង បំផ្លាញ ដល់ ការ ចិញ្ចឹម ក្នុង ស្រុក ។
លោក វេង សាខុន រដ្ឋ មន្ដ្រី ក្រសួង កសិកម្ម ដែល បាន ដឹក នាំ កិច្ច ប្រជុំ កាលពី ម្សិលមិញ ជាមួយ វិស័យ ឯកជន ពាក់ព័ន្ធ នឹង អាជីវកម្ម ជ្រូក របស់ កម្ពុជា និង ក្រសួង ពាក់ព័ន្ធ បាន លើក ឡើង ពី បញ្ហា និង ការ ប្រឈម របស់ ឧស្សាហ កម្ម នេះ ។
លោក វេង សាខុន ថ្លែងថា ៖
« យើង ស្វាគមន៍ កិច្ចប្រតិបត្តិការ ជាមួយ វិស័យ ឯកជន ដើម្បី បង្ក្រាប ការ នាំ ចូល សត្វ ជ្រូក ខុស ច្បាប់ និង កសិដ្ឋាន សិប្ប និមិត្ត នៅ តាម បណ្ដោយ ព្រំដែន » ។
កសិដ្ឋាន សិប្ប និមិ្មត នេះ គឺ សំដៅ លើ កសិដ្ឋាន របស់ ក្រុម ឈ្មួញ នៅ តាម ព្រំដែន ដែល នាំ ចូល ជ្រូក ពី ប្រទេស ជិត ខាង មក ដាក់ ក្នុង កសិដ្ឋាន ក្នុង រូបភាព ជាការ ចិញ្ចឹម ក្នុង ស្រុក ។
ថ្មីៗ នេះ មាន សកម្មភាព នាំ ចូល ជ្រូក ទាំង ឡានៗ ពី ប្រទេស វៀតណាម ចូល មក កម្ពុជា ខណៈ មាន អន្តរាគមន៍ ពី អ្នក មាន លុយ នៅ ពេល ពលរដ្ឋ បាន នាំ គ្នា បញ្ឈប់ សកម្មភាព នេះ ដែល នាំ ឲ្យ មាន ការ រិះគន់ លើ អាជ្ញាធរ ថា បណ្តែត បណ្តោយ ឲ្យ មាន ការ នាំ ចូល ជ្រូក ពី វៀតណាម យ៉ាង អនាធិបតេយ្យ ។
ក្រុម ការងារ ពិសេស នេះ ត្រូវ បាន បង្កើត ឡើង កាលពី ថ្ងៃទី ២៧ ខែ មេសា ចូលរួម ពី វិស័យ ឯកជន និង កសិករ ។
ខណៈ ការ នាំ ចូល សត្វ ជ្រូក ខុស ច្បាប់ នៅ តែ បន្ត ដែល នឹង សម្លាប់ អាជីវកម្ម អ្នក ចិញ្ចឹម ក្នុង ស្រុក វត្តមាន របស់ ក្រុម ការងារ នេះ សង្ឃឹម ថា នឹង ពង្រឹង ការ គ្រប់ គ្រង ការ នាំ ចូល ជ្រូក ដើម្បី លុប បំបាត់ ពាណិជ្ជកម្ម សត្វ ជ្រូក ឆ្លង ព្រំដែន ខុស ច្បាប់ ។
ប៉ុន្តែ បើ ក្រឡេក មើល តួនាទី របស់ ក្រុម ការងារ នេះ គឺ គ្រាន់ តែ រាយការណ៍ ពី បញ្ហា ទៅ ភាគី ពាក់ព័ន្ធ ប៉ុណ្ណោះ ។
លោក ម៉ុង ឫទ្ធី ស្ថាបនិក ក្រុម ការងារ នេះ បាន ឲ្យ ដឹង ថា ៖
« ក្រុម ការងារ ដែល ផ្ដួច ផ្ដើម នេះ នឹង ត្រួត ពិនិត្យ លើ សកម្មភាព រត់ ពន្ធ ហើយ រាយការណ៍ ឧប្បត្តិហេតុ ណា មួយ នៃ ការ ធ្វើ ពាណិជ្ជកម្ម ខុស ច្បាប់ ទៅ ក្រសួង ពាក់ព័ន្ធ និង នគរបាល គយ ដើម្បី ចាត់ វិធានការ » ។
របាយការណ៍ ពី ក្រសួង កសិកម្ម បង្ហាញ ថា ការ ផ្គត់ផ្គង់ សាច់ ដោយ ក្រុមហ៊ុន ផលិត ក្នុង ស្រុក កាល ពី ឆ្នាំ ២០១៦ មាន គោ និង ក្របី ចំនួន ១២៨ ៩០៤ ក្បាល និង ជ្រូក ៨៩៤ ១០៨ ក្បាល ។
លោក បន្ត ថា បច្ចុប្បន្ន ក្រសួង កសិកម្ម ប្រកាស រឹត បន្តឹង លើ ក្រុមហ៊ុន នាំ ចូល សត្វ ជ្រូក ហើយ គ្រប់គ្រង លើ ការ រត់ ពន្ធ សត្វ ជ្រូក តាម បណ្ដោយ ព្រំដែន និង មិន អនុញ្ញាត ឲ្យ មាន ការ នាំ ចូល សត្វ ជ្រូក លើស ពី ១ ២៥០ ក្បាល ក្នុង មួយ ថ្ងៃ ឡើយ ។
