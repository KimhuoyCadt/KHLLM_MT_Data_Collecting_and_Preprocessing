លោក ផែង សុវិជ្ជានោ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹក ជញ្ជូន បាន ឲ្យ ដឹង ថា ការ សហការ រយៈពេល ៦ ខែ ជាមួយ ក្រុមហ៊ុន Uber បាន បង្ហាញ ពី ការ ប្ដេជ្ញា ចិត្ត របស់ រដ្ឋាភិបាល ក្នុង ការ ជំរុញ ឲ្យ មាន ប្រព័ន្ធ ដឹក ជញ្ជូន ដ៏ ទំនើប ប្រកប ដោយ សុវត្ថិភាព និង ជឿ ទុក ចិត្ត សម្រាប់ ប្រទេស នេះ » ។
លោក បន្ថែម ថា ព័ត៌មាន លម្អិត បន្ថែម នៃ ភាព ជា ដៃគូ នេះ នឹង ត្រូវ បាន ប្រកាស ក្នុង ពេល ឆាប់ៗ នេះ ។
« ប្រទេស កម្ពុជា មាន ការ តភ្ជាប់ ទូរស័ព្ទ ចល័ត ដ៏ ល្អ ដែល ជា កំណើន នៃ អ្នក ចេះ ប្រើប្រាស់ បចេ្ចក វិទ្យា ហើយ បាន រក្សា កំណើន សេដ្ឋកិច្ច ប្រកប ដោយ ស្ថិរភាព » ។
« ដំបូង យើង ចាំបាច់ ត្រូវ ធានា ឲ្យ ប្រាកដ ថា អ្នក បើក បរ ទាំង អស់ របស់ ក្រុមហ៊ុន Uber អាច ឆ្លើយ តប តាម លក្ខណ សម្បត្តិ គ្រប់គ្រាន់ សម្រាប់ លក្ខខណ្ឌ សុវត្ថិភាព ជាក់ លាក់ ដែល យើង មាន ប៉ុន្តែ យើង ជឿជាក់ ថា មាន សក្ដានុពល ទីផ្សារ ដ៏ ធំ សម្រាប់ ក្រុមហ៊ុន នេះ » ។
ក្នុង ពេល ឆាប់ៗ នេះ Uber អាច ប្រឈម នឹង ការ ប្រកួត ប្រជែង យ៉ាង ខ្លាំង ពី ក្រុមហ៊ុន Grab ជា កម្មវិធី ហៅ រថយន្ត ជិះ ធំ ជាង គេ របស់ អាស៊ី អាគ្នេយ៍ ដែល បាន បង្ហាញ ចំណាប់ អារម្មណ៍ របស់ ខ្លួន ក្នុង ការ ចូល ក្នុង ទីផ្សារ កម្ពុជា ភ្លាមៗ បន្ទាប់ពី កិច្ចប្រជុំ ជាមួយ មន្ដ្រី រដ្ឋាភិបាល កាលពី ដើម សប្ដាហ៍ នេះ ដើម្បី ពិភាក្សា លើ បទ ប្បញ្ញត្តិ ក្នុង ស្រុក និង នីតិវិធី ផ្ដល់ អាជ្ញាប័ណ្ណ ៕
កម្ពុជានឹងនាំចេញអង្ករទៅបង់ក្លាដែសខែ ១១
បង់ក្លាដេស បាន ចុះ ហត្ថលេខា លើ អនុស្សរណៈ ការ យោគយល់ ជាមួយ ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា កាល ពី ដើម ខែ សីហា សម្រាប់ ការ ទិញ អង្ករ ១ លាន តោន ពី កម្ពុជា ក្នុង រយៈពេល ៥ ឆ្នាំ ។
លោក ហ៊ុន ឡាក់ ដែល បដិសេធ បញ្ជាក់ តម្លៃ នៃ កិច្ច ព្រម ព្រៀង នេះ ឲ្យ ដឹងថា បង់ក្លាដែស បាន ចុះ កិច្ច ព្រម ព្រៀង លើ តម្លៃ ជា ផ្លូវ ការ ជាមួយ រដ្ឋាភិបាល កម្ពុជា រួច ហើយ កាលពី ពាក់ កណ្ដាល ខែ កញ្ញា ៕
សព្វ ថ្ងៃ នេះ មាន អ្នក សរសេរ កម្មវិធី ចំនួន ២០ ម៉ឺន នាក់ និង អ្នក ប្រើ ប្រាស់ ជាង ៦០០ លាន នាក់ កំពុង ប្រើ ប្រាស់ កម្មវិធី នេះ ដើម្បី ប្រតិបត្តិការ ហិរញ្ញវត្ថុ។
ប្រធាន ផ្នែក ទំនាក់ ទំនង សាធារណៈ រូប នេះ បាន ឲ្យ ដឹង ថា៖
« យើង ចង់ ទាក់ទាញ អ្នក ប្រើ ប្រាស់ នៅ ក្នុង ពិភពលោក ទាំង មូល ឲ្យ ប្រើ ប្រាស់ សេវាកម្ម របស់ យើង ។
ក្រុមហ៊ុន ផលិត សម្លៀក បំពាក់ កីឡា ធំ ជាង គេ របស់ ពិភពលោក មួយ នេះ ពឹង ផ្អែក ខ្លាំង លើ កំណើន លក់ នៅ បរទេស ខ្ពស់ ជា ពិសេស នៅ ប្រទេស ចិន ដើម្បី ទ្រទ្រង់ អាជីវកម្ម ដែល កំពុង ធ្លាក់ ចុះ នៅ សហរដ្ឋ អាមេរិក និង ជួយ ក្រុមហ៊ុន ឲ្យ ប្រកាស ពី ប្រាក់ ចំណេញ នៅ ត្រី មាស ទីមួយ ដែល មាន កម្រិត ខ្ពស់ ជាង ការ ព្យាករ ។
ក្រុមហ៊ុន Nike ក៏ លើក ឡើង វិធានការ ដើម្បី បង្កើន ប្រសិទ្ធភាព ប្រតិបត្តិការ ទូទាំង ពិភពលោក របស់ ខ្លួន ផង ដែរ ដើម្បី ជួយ បង្កើន ប្រាក់ ចំណេញ ក្រុមហ៊ុន ។
ការ ធ្លាក់ ចុះ នេះ ត្រូវ បាន ប៉ះប៉ូវ ដោយ កំណើន លក់ ៥ ភាគរយ នៅ អាមេរិក ឡាទីន និង អាស៊ី ប៉ាស៊ីហ្វិក ខណៈ ការ លក់ នៅ ប្រទេស ចិន វិញ កើន ឡើង ៩ ភាគរយ ៕
ប្រទេស សិង្ហបុរី បាន ឈ្នះ ទីក្រុង ញូវយ៉ក ជា លើក ដំបូង ក្នុង រយៈ ពេល ៣ ឆ្នាំ។
ភ្ញៀវ ទេសចរ ប្រមាណ ៣ ភាគ ៤ នៃ ចំនួន ភ្ញៀវ ទេសចរ មក ទស្សនា សិង្ហបុរី មាន បំណង កម្សាន្ត ចំណែក ឯ ១ ភាគ ៤ ទៀត ដើម្បី ធ្វើ ធុរកិច្ច។
ក្រុងហុងកុង ហាមនាំចូលសាច់និងស៊ុតបក្សីពីបារាំង
« មជ្ឈមណ្ឌល ដើម្បី សុវត្ថិភាព ស្បៀង អាហារ បាន ទាក់ ទង ទៅ កាន់ អាជ្ញាធរ បារាំង រួច ហើយ ពី បញ្ហា នេះ ហើយ នឹង ពិនិត្យ តាម ដាន យ៉ាង ហ្មត់ ចត់ ពី ព័ត៌មាន ដែល ត្រូវ បាន ចេញ ផ្សាយ ដោយ អង្គការ សុខភាព សត្វ ពិភពលោក ស្តីពី ការ រីក រាល ដាល នៃ ជំងឺ គ្រុន ផ្តាសាយ បក្សី»។
លោក ស្រី ជា សិរី អគ្គនាយក បច្ចេកទេស ធនាគារ ជាតិ នៃ កម្ពុជា (NBC) បាន ឲ្យ ដឹង ថា តាម រយៈ ការ ដំណើរ ការ ប្រព័ន្ធ ទិន្នន័យ អត្រា ប្តូរ ប្រាក់ រៀល យន់ នេះ ធនាគារ កណ្ដាល របស់ ប្រទេស ចិន ប្រចាំ ខេត្ត គ័ង ស៊ី នឹង អាច កំណត់ អត្រា ប្តូរ ប្រាក់ យន់ និង រៀល ហើយ បន្ទាប់មក ធនាគារ ពាណិជ្ជ ជាច្រើន នៅ ខេត្ត នេះ អាច យក អត្រា នេះ ដើម្បី ជា មូលដ្ឋាន នៃ ការកំណត់ អត្រា ប្តូរ ប្រាក់ ផ្ទាល់ របស់ ពួកគេ ។
កត្តា នេះ អាច អនុញ្ញាត ឲ្យ អ្នក កាន់ ប្រាក់រៀល ខ្មែរ អាច យក ប្រាក់ រៀល ទៅ ប្តូរ ប្រាក់ យន់ ចិន ដោយ ផ្ទាល់ ។
លោក ស្រី បញ្ជាក់ ថា កាល ពី មុន ការដាក់ តម្លៃ នេះ ត្រូវ បាន ធ្វើ តាម រយៈ រូបិយប័ណ្ណ មួយ ទៀត គឺ ប្រាក់ ដុល្លារ អាមេរិក ដែល មាន ន័យ ថា អ្នក កាន់ ប្រាក់ រៀល ត្រូវ យក ប្រាក់ រៀល ទៅ ប្តូរ យក ដុល្លារ សិន ដើម្បី ទិញ ប្រាក់ យន់ ប៉ុន្តែ នា ពេល នេះ ដោយ សារ តែ ទំហំ នៃ ការ ទូទាត់ ពាណិជ្ជកម្ម ជា រូបិយប័ណ្ណ ក្នុង ស្រុក កើន ឡើង យើង នឹង អាច កំណត់ ការដាក់ តម្លៃ ដោយ ផ្ទាល់ ដោយ មិនបាច់ តាម រយៈ ប្រាក់ ដុល្លារ ។
« យើង ចង់ លើក កម្ពស់ ការ ទូទាត់ ពាណិជ្ជ កម្ម ជា រូបិយប័ណ្ណ នៃ ដៃ គូ ពាណិជ្ជកម្ម ។
កត្តា នេះ បាន រួម ចំណែក កាត់ បន្ថយ ហានិភ័យ រូបិយប័ណ្ណ ដែល ប្រជាជន ចិន នឹង មិន ត្រូវ តែ ប្តូរប្រាក់ ដុល្លារ ទៅ ជា ប្រាក់ យន់ វិញ នោះទេ ហើយ កម្ពុជា ក៏ មិន ចាំបាច់ ត្រូវតែ ប្តូរ ប្រាក់ ដុល្លារ ទៅជា ប្រាក់ រៀល ខ្មែរ ទេ ។
អាកាសចរណ៍ដើរតួសំខាន់ជំរុញកំណើនសេដ្ឋកិច្ច
យោង តាម របាយការណ៍ ស្តីពី អត្ថប្រយោជន៍ អាកាសចរណ៍ ឆ្នាំ ២០១៧ ក្រុមហ៊ុន អាកាសចរណ៍ នៅ ទូទាំង ពិភពលោក បាន ដឹក អ្នក ដំណើរ ប្រមាណ ៣,៨ ពាន់ លាន នាក់ និង ទំនិញ ចំនួន ៥៣ លាន តោន នៅ ទូទាំង ពិភពលោក កាលពី ឆ្នាំ មុន ។
របាយការណ៍ នេះ បាន ឲ្យ ដឹង ថា ៖
« តាមរយៈ ការ ជំរុញ វិស័យ ទេសចរណ៍ និង ពាណិជ្ជកម្ម ខណៈ វិស័យ នេះ បន្ត រីកចម្រើន នោះ វិស័យ អាកាសចរណ៍ ចូលរួម ចំណែក ដល់ ការ កើនឡើង ផ្នែក ផលប្រយោជន៍ និង ជម្រើស របស់ អតិថិជន និង ការ បង្កើត ការងារ » ។
របាយការណ៍ នេះ បាន ឲ្យ ដឹង ថា ការ ធ្លាក់ ចុះ ជា លំដាប់ នៃ ការ ចំណាយ ជាក់ស្តែង លើ ការ ធ្វើ ដំណើរ តាម ផ្លូវ អាកាស ដែល បាន ធ្លាក់ ចុះ ៦០ ភាគរយ គិត ចាប់ តាំងពី ឆ្នាំ ១៩៧០ មក គឺជា កត្តា ជំរុញ ដ៏សំខាន់ មួយ ចំពោះ កំណើន ចរាចរណ៍ អ្នក ដំណើរ ផ្លូវអាកាស ។
ការ ធ្វើ ដំណើរ តាម ផ្លូវ អាកាស កំពុង តែ ផ្តល់ លទ្ធភាព កាន់តែ ខ្លាំង ដល់ ប្រទេស ដែល កំពុង អភិវឌ្ឍន៍ ដោយ មាន ជម្រើស ធ្វើ ដំណើរ ក្នុង តម្លៃ ទាប សម្រាប់ មនុស្ស កាន់តែ ច្រើន » ។
ប្រទេស កម្ពុជា គឺជា ទីផ្សារ មួយ ក្នុង ចំណោម ទីផ្សារ ធ្វើ ដំណើរ និង ទេសចរណ៍ ដែល កំពុង រីកចម្រើន ខ្លាំង បំផុត នៅ តំបន់ អាស៊ី / ប៉ាស៊ីហ្វិក ដោយ បាន កត់ត្រា កំណើន ចរាចរណ៍ អ្នក ដំណើរ តាម ផ្លូវ អាកាស ៨,៥ ភាគរយ និង កំណើន ដឹក ជញ្ចូន ទំនិញ តាម ផ្លូវ អាកាស ១៩ ភាគរយ កាលពី ឆ្នាំ មុន ។
និន្នាការ ទេសចរណ៍ ប្រចាំ តំបន់ ការ តភ្ជាប់ ផ្លូវ អាកាស ដែល បាន កើនឡើង និង ការ ធ្លាក់ ចុះ តម្លៃ សំបុត្រ យន្តហោះ គឺជា កត្តា ជំរុញ ដ៏សំខាន់ ចំពោះ កំណើន អ្នក ដំណើរ ខណៈ បរិមាណ ទំនិញ ដឹក ជញ្ជូន តាម ផ្លូវ អាកាស កំពុង កើនឡើង ដោយសារ ទិន្នផល រោងចក្រ កាន់តែ ខ្ពស់ ជាពិសេស វិស័យ កាត់ដេរ សម្លៀកបំពាក់ ។
ក្រុមហ៊ុន អាកាសចរណ៍ ពាណិជ្ជកម្ម សរុប ៤៣ ប្រតិបត្តិការ ជើង ហោះហើរ ប្រចាំ នៅ កម្ពុជា ដោយ បាន ចូលរួម ចំណែក ចំពោះ កំណើន ចរាចរណ៍ អ្នក ដំណើរ ២៥ ភាគរយ ក្នុង រយៈពេល ៨ ខែ ដំបូង ក្នុង ឆ្នាំ នេះ ធៀប នឹង រយៈពេល ដូច គ្នា កាលពី ឆ្នាំ មុន ។
បរិមាណ ទំនិញ ដឹក ជញ្ជូន តាម ផ្លូវ អាកាស ក៏ បាន កើនឡើង ខ្លាំង ផង ដែរ ដោយ មាន ក្រុមហ៊ុន ដឹក ជញ្ចូន ទំនិញ តាម ផ្លូវ អាកាស ចំនួន ៧ ដែល កំពុង ប្រតិបត្តិការ នាពេល បច្ចុប្បន្ន និង ដឹក ទំនិញ ពោល គឺ បាន កើនឡើង ៣៤ ភាគរយ ក្នុង ឆមាស ទី មួយ ក្នុង ឆ្នាំ ២០១៧ ធៀប នឹង រយៈពេល ដូច គ្នា កាលពី ឆ្នាំ មុន ។
ឥទ្ធិពល ធំ ជាង គេ គឺ នៅ ក្នុង ឧស្សាហកម្ម ទេសចរណ៍ ដែល បាន រីកចម្រើន ខ្លាំង ជាមួយ នឹង វិស័យ ទេសចរណ៍ ដោយសារ ក្រុមហ៊ុន អាកាសចរណ៍ កាន់តែ ច្រើន បាន បន្ថែម ប្រទេស កម្ពុជា ទៅ ក្នុង ផែនទី ផ្លូវ ហោះហើរ របស់ ខ្លួន ។
លោក ម៉ែន ភិរម្យ នាយក រៀបចំ ផែនការ នៅ ក្រសួង ទេសចរណ៍ បាន ឲ្យ ដឹង ថា ៖
ដោយសារ ភ្ញៀវទេសចរ បរទេស ៥៤ ភាគរយ បាន មក ដល់ កម្ពុជា តាម ផ្លូវ អាកាស នោះ អាកាសយានដ្ឋាន នៅ កម្ពុជា ដើរ តួនាទី សំខាន់ ក្នុង សេដ្ឋកិច្ច ទេសចរណ៍ របស់ ប្រទេស នេះ ។
« បើ កម្ពុជា ពុំ មាន អាកាសយានដ្ឋាន សេដ្ឋកិច្ច ទេសចរណ៍ របស់ យើង នឹង បាត់បង់ ផលប្រយោជន៍ ច្រើន » ។
« ដូច្នេះ វា ជា កត្តា សំខាន់ ដែល យើង ពង្រីក និង ទាក់ទាញ វិនិយោគិន បន្ថែម ឲ្យ អភិវឌ្ឍ អាកាសយានដ្ឋាន » ។
លោក ថ្លែង ទៀត ថា ហេដ្ឋារចនាសម្ព័ន្ធ អាកាសចរណ៍ គឺជា វិស័យ អាទិភាព មួយ ចំពោះ រដ្ឋាភិបាល ដែល មាន បំណង ធានា ឲ្យ បាន ថា មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការ ទទួល ការ មក ដល់ របស់ ភ្ញៀវទេសចរ អន្តរជាតិ ៧ លាន នាក់ ក្នុង មួយ ឆ្នាំ នៅ ឆ្នាំ ២០២០ ខាង មុខ ។
« សមត្ថភាព បន្ថែម គឺជា កត្តា ចាំបាច់ ដោយសារ អាកាសយានដ្ឋាន របស់ យើង នៅ មិន ទាន់ ធំ គ្រប់គ្រាន់ ដើម្បី ទទួល យន្តហោះ ធំៗ ឬ ចរាចរណ៍ ជើង ហោះហើរ កាន់តែ ច្រើន នោះ ទេ ហើយ ការ វិនិយោគ ក៏ នៅ មាន កម្រិត ដែរ » ។
NBC នឹងបញ្ចូលចំណេះដឹងហិរញ្ញវត្ថុក្នុងកម្មវិធីសិក្សា
ថ្លែង កាលពី ម្សិលមិញ នៅ ក្នុង សិក្ខាសាលា បច្ចេកទេស ស្ដីពី ការ អប់រំ ហិរញ្ញវត្ថុ នៅ ក្នុង គម្រោង កម្មវិធី សិក្សា សាលា របស់ ប្រទេស កម្ពុជា លោក ស្រី ជា សិរី អគ្គនាយិកា បច្ចេកទេស នៃ ធនាគារ ជាតិ នៃ កម្ពុជា (NBC) បាន ឲ្យ ដឹងថា ឯកសារ ព្រាង ត្រូវ បាន រៀបចំ ដែល ជា ដំណាក់ កាល ដំបូង ហើយ វា ត្រូវ ការ ពេលវេលា ក្នុង ការ បញ្ចប់ សម្រាប់ សិស្ស ក្នុង ការ សិក្សា ។
លោក ស្រី បាន បន្ថែម ថា បន្ទាប់ពី ការ បង្កើត មេរៀន និង ឯកសារ នឹង មាន សិក្ខា សាលា ពិភាក្សា និង ការ ពិគ្រោះ យោបល់ ជាច្រើន ក្នុងការ ទទួល ធាតុ ចូល ដើម្បី កែលម្អ គុណភាព មេរៀន ខណៈ នឹង មាន តម្រូវ ការ វគ្គ បណ្ដុះ បណ្ដាល ជាច្រើន ដល់ គ្រូ ក្នុង ការ ធានា ឲ្យ ប្រាកដ ថា ពួក គេ យល់ ដឹង ពី មេរៀន ច្បាស់ លាស់ មុន ពេល បង្រៀន សិស្ស ។
លោកស្រី បញ្ជាក់ ថា ក្នុង ចំណោម ប្រជាជន សរុប នៅ កម្ពុជា យុវជន ដែល មាន អាយុ ក្រោម ៣០ ឆ្នាំ មាន ប្រមាណ ៦៥ ភាគរយ នៃ ប្រជាជន សរុប ដែល យុវជន ទាំង នេះ នឹង ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង សកម្មភាព សេដ្ឋកិច្ច និង វិស័យ ហិរញ្ញវត្ថុ ។
« ខណៈដែល វិស័យ ហិរញ្ញវត្ថុ កាន់ តែ រីក ធំធាត់ និង ទទួល បាន ការ ចាប់ អារម្មណ៍ ចូលរួម ពី យុវជន ជំនាន់ ក្រោយ យុវជន គួរ តែ ត្រូវ បាន ទទួល ការ បណ្តុះ បណ្តាល នូវ ផ្នត់ គំនិត នៃ ការ គ្រប់គ្រង និង ចាត់ចែង ប្រាក់ កាស របស់ ខ្លួន ឲ្យ បានល្អ » ។
មន្ដ្រី NBC កំពុង សហការ ជាមួយ មន្ដ្រី មក ពី ក្រសួង អប់រំ យុវជន និង កីឡា និង ដៃគូ អភិវឌ្ឍន៍ ក្នុង ការ បង្កើត កម្មវិធី សិក្សា ហើយ វា នឹង ត្រូវ បាន បង្រៀន ដល់ សិស្ស ចាប់ ពី សាលា បឋម សិក្សា ដល់ វិទ្យាល័យ ស្ដីពី គំនិត ទាក់ទង នឹង ការ សន្សំ ប្រាក់ ការ ផ្ដល់ កម្ចី និង ការ គ្រប់គ្រង ហិរញ្ញវត្ថុ ។
លោក ម៉ុក សារុំ អគ្គនាយករង នៃ អគ្គនាយក ដ្ឋាន អប់រំ នៅ ក្រសួង អប់រំ បាន ឲ្យ ដឹង ថា កម្មវិធី សិក្សា នេះ នឹង ត្រូវ បាន ដាក់ បញ្ចូល នៅ ក្នុង កម្មវិធី សិក្សា ដែល មាន ស្រាប់ ដ៏ សំខាន់ ៣ ដែល រួម មាន គណិតវិទ្យា គេហ សេដ្ឋកិច្ច វិទ្យា និង បំណិន ជីវិត ក្នុង សង្គម ។
« យើង កំពុង ព្យាយាម បង្កើន ចំណេះ ដឹង ស្ដីពី វិស័យ ហិរញ្ញវត្ថុ នៅ តាម សាលា រៀន តាម រយៈ ការ បង្រៀន ក្មេងៗ ក្នុង ការ គ្រប់គ្រង ប្រាក់ របស់ ពួកគេ បាន ល្អ ហើយ អប់រំ ដល់ ពួក គេ ឲ្យ ចង់ សន្សំ ប្រាក់ » ។
ទៅ ដល់ សាលា បឋម សិក្សា នៅ ទូទាំង ប្រទេស ។
គម្រោង រយៈពេល ៥ ឆ្នាំ ដែល បាន ផ្ដល់ មូលនិធិ ដោយ រដ្ឋាភិបាល អាមេរិក តាម រយៈ USAID មាន បំណង ជំរុញ កំណើន ការ ធ្វើ ពាណិជ្ជកម្ម ដំណាំ កសិកម្ម របស់ កម្ពុជា នៅ ខេត្ត ពោធិ៍សាត់ បាត់ដំបង សៀមរាប និង កំពង់ធំ ។
« ដំបូង យើង ស្វែងរក អ្នក ទិញ ដែល ផ្ដល់ តម្រូវការ និង ធ្វើ ការងារ ជាមួយ ថ្នាក់ ខេត្ត គ្រប់ កម្រិត ក៏ ដូចជា សហការ ជាមួយ ម្ចាស់ គម្រោង ដែល កំពុង ធ្វើ ការ ងារ លើ ការ ផលិត » ។
កាលពី ឆ្នាំ មុន រដ្ឋាភិបាល បាន ផ្ដល់ មូលនិធិ ២០ លាន ដុល្លារ ក្នុង ការ លើក កម្ពស់ វិស័យ ដំណាំ កសិកម្ម នេះ នៅ ក្នុង ខេត្ត តាម បណ្ដោយ ទន្លេ មេគង្គ ដែល អ្នក ជំនាញ ជឿថា វា នឹង ជួយ កាត់ បន្ថយ ការនាំ ចូល បន្លែ បាន រហូត ដល់ ៥០ ភាគរយ ។
បច្ចុប្បន្ន កម្ពុជា នាំ ចូល បន្លែ និង ផ្លែឈើ ប្រហែល ៣០០ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ពី បណ្ដា ប្រទេស ជិត ខាង ។
« យើង នឹង សម្រប សម្រួល រួមគ្នា ម្នាក់ ផ្ដោត លើ ទីផ្សារ ហើយ យើង ផ្ដោតលើ កម្រិត ការ ផលិត ដូច នេះ វា នឹង បង្កើន ទម្រង់ ដ៏ រឹងមាំ សម្រាប់ ការ ដាំដុះ ដើម្បី ចូល ដល់ ទីផ្សារ » ។
លោក ស្រី ចាន់ ផល លឿន អគ្គនាយករង នៃ អគ្គនាយក ដ្ឋាន កសិកម្ម នៅ ក្រសួង កសិកម្ម បាន ឲ្យ ដឹង ថា វិស័យ ដំណាំ បន្លែ នៅ តែ កំពុង ប្រឈម នឹង បញ្ហា ជាច្រើន ហើយ ការ ចែកចាយ មិន ទៅ ដល់ ទូទាំង ប្រទេស ទេ ដែល ចាំបាច់ ត្រូវ នាំចូល ប្រហែល ៤០ ភាគរយ មាន តម្លៃ ប្រហែល ២០០ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ដែល ភាគច្រើន នាំចូល ពី ប្រទេស វៀតណាម ។
« យើង កំពុង ព្យាយាម ស្វែងរក មធ្យោបាយ ក្នុង ការ ស្វែងរក ដំណោះ ស្រាយ សម្រាប់ កសិករ ដោយ សារ តែ ការ ផលិត និង ការ ចែកចាយ របស់ យើង ប្រឈម នឹង បញ្ហា ជាច្រើន ក្នុង ការ ចូល ដល់ ទីផ្សារ » ។
លោក ច័ន្ទ សុផល នាយក មជ្ឈមណ្ឌល សិក្សា គោល នយោបាយ បាន ឲ្យ ដឹង ថា បញ្ហា ប្រឈម នៃ ផលិតផល ដំណាំ បន្លែ មិនអាច ផលិត និង ផ្គត់ផ្គង់ ដល់ តម្រូវការ ទីផ្សារ បាន ទៀងទាត់ ទេ ហើយ មិន អាច ស្វែងរក និង ធានា ដល់ អតិថិជន ថា ផលិតផល ត្រូវ ផលិត ដោយ ប្រទេស កម្ពុជា នោះ ទេ ។
« បញ្ហា ប្រឈម គឺ ផលិតផល របស់ យើង មិនអាច ផ្គត់ផ្គង់ បាន ទៀងទាត់ ឬ កង្វះ អ្នកទិញ ។
គន្លឹះ ដ៏ សំខាន់ គឺ ត្រូវ ញែក រវាង ផលិតផល កម្ពុជា និង ផលិតផល នាំចូល ដូច្នេះ យើង ចាំបាច់ ត្រូវ កំណត់ ឈ្មោះ ស្ថិត ក្រោម ការគ្រប់គ្រង គុណភាព និង សុវត្ថិភាព អាហារ ទោះបីជា វា ខ្ពស់ បន្តិច ក៏ដោយ តម្រូវ ការ នៅ តែ មាន » ។
ទាំង ប្រទេស កាណាដា និង ចក្រភព អង់គ្លេស គឺជា ទីកន្លែង ដែល គ្រឿង បង្គុំ យន្តហោះ មួយ ចំនួន ត្រូវ បាន ផលិត ឡើង នោះ បាន ព្យាយាម បញ្ចុះបញ្ជូល សហរដ្ឋ អាមេរិក ឲ្យ បោះបង់ ករណី ហូត ពន្ធ នេះ ។
« សហរដ្ឋ អាមេរិក ផ្តល់ តម្លៃ ទំនាក់ ទំនង របស់ ខ្លួន ជាមួយ នឹង ប្រទេស កាណាដា តែ បើ ទោះ ជា សម្ព័ន្ធមិត្ត ជិត ស្និទ្ធ បំផុត របស់ យើង ក៏ដោយ ក៏ ត្រូវ គោរព ច្បាប់ ដែរ » ។
« ការ ផ្តល់ ការ ឧបត្ថម្ភ ធន ទំនិញ ដោយ រដ្ឋាភិបាល បរទេស គឺជា អ្វី មួយ ដែល រដ្ឋាភិបាល លោក ត្រាំ យក ចិត្ត ទុកដាក់ យ៉ាង ខ្លាំង ហើយ យើង នឹង បន្ត វាយតម្លៃ និង បញ្ជាក់ ពី ភាព ត្រឹមត្រូវ ចំពោះ ការ សម្រេច ចិត្ត ជា បឋម នេះ » ។
ការ សម្រេច ជា បឋម ដែល នឹង ត្រូវ សម្រេច ចុង ក្រោយ ថ្ងៃ ទី ១២ ខែ ធ្នូ និង អាច បន្ត ធ្វើ តេស្ត ពី ទំនាក់ទំនង រវាង រដ្ឋាភិបាល ក្រុង អូតាវ៉ា និង ក្រុង វ៉ាស៊ីនតោន ដែល បាន ល្អក់កករ រួច ទៅ ហើយ ដោយសារ ការ ចរចា ឡើង វិញ ជា បន្ត នៃ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី អាមេរិក ខាង ជើង ដែល រួមទាំង ម៉ិកស៊ិក ផង ដែរ នោះ ។
« កាណាដា ពិតជា មិន យល់ ស្រប នោះ ទេ ចំពោះ ការ ស៊ើបអង្កេត លើ ការ ហូត ពន្ធ ប្រឆាំង ការ លក់ បង្ខូច តម្លៃ ទីផ្សារ នេះ និង ពន្ធគយ ទូទាត់ ចំពោះ ការ នាំ ចូល យន្តហោះ ស៊ីវិល ខ្នាត ធំ របស់ កាណាដា ។
« ការ បញ្ជា ទិញ ដែល ជា សញ្ញា បង្ហាញ ពី ការ ពង្រីក អាជីវកម្ម ជា បន្ត របស់ ក្រុមហ៊ុន និង ជា ការ ចូលរួម ចំណែក ចំពោះ សេដ្ឋកិច្ច សហរដ្ឋ អាមេរិក នឹង បង្កើន បន្ថែម ទៅលើ ចំនួន យន្តហោះ ខ្នាត ធំ បច្ចុប្បន្ន របស់ ក្រុមហ៊ុន ដែល មាន ជិត ១០០ គ្រឿង»។
ការ សម្រេច ទិញ យន្ត ហោះ ថ្មី នេះ អាច ត្រូវ បាន ចាត់ ទុក ថា ជា យុទ្ធសាស្រ្ត ក៏ ដូច ជា សារៈ សំខាន់ ផ្នែក សេដ្ឋកិច្ច។
ប្រទេស កាតា កំពុង ស្វែង រក កាលានុវត្តភាព វិនិយោគ បន្ត នៅ អាមេរិក។
ADB រក្សាការព្យាករកំណើនសេដ្ឋកិច្ចកម្ពុជា
លោក បន្ថែម ថា ការ រក្សា បាន កំណើន ខ្ពស់ ចាំបាច់ ត្រូវ កាត់ បន្ថយ ភាព ក្រីក្រ ប៉ុន្តែ ត្រូវ ពឹង ផ្អែក លើ សមត្ថភាព របស់ កម្ពុជា ក្នុង ការ រក្សា សមត្ថភាព ប្រកួត ប្រជែង ដោយ បង្កើន ផលិតភាព កម្លាំង ពលកម្ម ដែល ADB នឹង ជួយ ផ្នែក ហិរញ្ញប្បទាន ។
លោក បាន ថ្លែង នៅ ក្នុង សេចក្ដី ប្រកាស ព័ត៌មាន នេះ ថា ៖
« ADB កំពុង បង្កើន ជំនួយ ឧបត្ថម្ភ របស់ ខ្លួន ដល់ រាជរដ្ឋាភិបាល កម្ពុជា ដែល ចាប់ ផ្ដើម ពី ឆ្នាំនេះ ដើម្បី គាំទ្រ រដ្ឋាភិបាល ក្នុង ការ កែលម្អ ផលិតភាព និង អភិវឌ្ឍ ចង្វាក់ តម្លៃ នៅ ក្នុង វិស័យ កសិកម្ម កែលម្អ ផលិតភាព កែលម្អ មូលដ្ឋាន អប់រំ និង ជំនាញ វិជ្ជាជីវៈ និង បង្កើន ការ ចំណាយ លើ ការ អភិវឌ្ឍ ដើម្បី កែលម្អ ការ ផ្ដល់ សេវា សាធារណៈ បន្ថែម ទៀត » ។
រដ្ឋាភិបាលបង្ហាញគម្រោងគាំទ្រសហគមន៍សន្សំប្រាក់
ថ្លែង នៅ ក្នុង ពិធី បើក សន្និសីទ ស្ដីពី « សមាគមន៍ សន្សំ ប្រាក់ ការ អភិវឌ្ឍន៍ ថ្មី លើស ពី ធុរកិច្ច ធម្មតា » កាលពី ម្សិលមិញ លោក អ៊ុក រ៉ាប៊ុន រដ្ឋ មន្ដ្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ (MRD) បាន ឲ្យ ដឹង ថា គំនិត ក្រុម សន្សំ ប្រាក់ របស់ សហគមន៍ បាន ជំរុញ ឲ្យ ប្រជាជន ក្រីក្រ សន្សំ និង វិនិយោគ ដែល ទាំង នេះ គឺជា មូលដ្ឋាន គ្រឹះ ដ៏ សំខាន់ ក្នុង ការ ជំរុញ កំណើន សេដ្ឋកិច្ច របស់ ប្រទេស ។
យោង តាម លោក រដ្ឋ មន្ដ្រី ក្រសួង នឹង ផ្ដល់ ការ គាំទ្រ ជា បន្ត ដល់ ការ អភិវឌ្ឍ ក្រុម សន្សំ ប្រាក់ សហគមន៍ ទាក់ទង នឹង ការ គាំទ្រ ផ្នែក ច្បាប់ ការ គាំទ្រ ផ្នែក បច្ចេក ទេស និង ការ គាំទ្រ ផ្នែក ហិរញ្ញវត្ថុ ។
« ការ គាំទ្រ ផ្នែក ផ្លូវ ច្បាប់ ក្រសួង កំពុង តែ សិក្សា ពី លទ្ធភាព និង យន្តការ ជាក់ លាក់ ដើម្បី គាំទ្រ សហគមន៍ ឲ្យ ដំណើរ ប្រតិបត្តិការ របស់ ខ្លួន មាន ភាព ស្រប ច្បាប់ » ។
« ក្រសួង ក៏ គ្រោង នឹង វិភាជន៍ ថវិកា រដ្ឋ ទៅ ឲ្យ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ រាជធានី ខេត្ត គោល ដៅ មួយ ចំនួន សម្រាប់ បំពេញ ការងារ គាំទ្រ សហគមន៍ សន្សំ ប្រាក់ ទាំង នេះ ផង ដែរ » ។
លោក រ៉ាប៊ុន មិន បាន ផ្ដល់ ព័ត៌មាន លម្អិត ពេល វេលា និង លក្ខខណ្ឌ ជាក់ លាក់ ដើម្បី អាច ឲ្យ ក្រុម នេះ ទទួល បាន ភាព ស្រប ច្បាប់ នោះ ទេ ។
មិន មាន ទិន្នន័យ ផ្លូវ ការ អំពី សមាជិក ក្រុម សន្សំ ប្រាក់ សហគមន៍ នៅ ក្នុង ប្រទេស នេះ ទេ ដោយ សារ តែ វិស័យ នេះ នៅ ពេល នេះ កំពុង ដំណើរ ការ ក្រៅ ផ្លូវ ការ និង គ្មាន ច្បាប់ ។
ប៉ុន្តែ យោង តាម លោក អ៊ុក រ៉ាប៊ុន ក្រសួង បាន ចុះ ហត្ថលេខា លើ អនុស្សរណៈ យោគ យល់ ជាមួយ អង្គការ មិន មែន រដ្ឋាភិបាល ចំនួន ១១ ដើម្បី ជួយ សម្រួល ដល់ ប្រតិបត្តិការ របស់ ក្រុម សន្សំ ប្រាក់ សហគមន៍ ដែល បាន បង្កើត ឡើង សរុប ១២ ៤៧៥ ដែល មាន សមាជិក ២២២ ៥៤៣ នាក់ ។
លោក ស្រី លឹម សូលីន នាយក ប្រចាំ ប្រទេស របស់ អង្គការ Oxfam បាន ឲ្យ ដឹង កាលពី ម្សិលមិញ ថា លោកស្រី ស្វាគមន៍ គំនិត ផ្ដួចផ្ដើម របស់ ក្រសួង ក្នុង ការ ធ្វើ ឲ្យ ស្រប ច្បាប់ ដល់ ក្រុម សន្សំ ប្រាក់ សហគមន៍ ដោយ សារ តែ វា នឹង បង្កើន ទំនុក ចិត្ត និង ភាព ជឿជាក់ សម្រាប់ សមាជិក ក្រុម ជា ពិសេស នៅ ពេល ក្រុម សន្សំ ប្រាក់ កើនឡើង កាន់តែ ធំ ទាក់ទង នឹង សមាជិក និង មូលនិធិ សន្សំ ។
ប៉ុន្តែ លោក ស្រី បាន ស្នើ ថា បទ ប្បញ្ញត្តិ ថ្មី មិន គួរ រាប់ បញ្ចូល ប្រតិបត្តិ ករ ក្រុម សន្សំ ប្រាក់ តូចៗ ដែល មាន សមាជិក មិន ដល់ ៥០ នាក់ ទេ ដើម្បី ឲ្យ ក្រុម សន្សំ ប្រាក់ តូចៗ នឹង រក្សា ការ រីក ចម្រើន ដោយ សេរី ។
លោក ស្រី សូលីន បាន ថ្លែង ថា ទោះ បីជា ប្រជាជន ក្រីក្រ នៅ ក្នុង ប្រទេស កម្ពុជា ក៏ អាច សន្សំ ប្រាក់ បាន ប្រហែល ៦៦ ដុល្លារ ជា មធ្យម ក្នុង មួយ ឆ្នាំ នៅ ពេល ពួក គេ ចូលរួម ជាមួយ ក្រុម សន្សំ ប្រាក់ សហគមន៍ នេះ ។
« មាន ជោគ ជ័យ ជាច្រើន រហូត មក ទល់ ពេល នេះ តាម រយៈ ការ អនុវត្ត គម្រោង នេះ ដូច ជា ការ ពង្រឹង ភាព អង់ អាច ផ្នែក សេដ្ឋកិច្ច របស់ ស្ត្រី ក្នុង វិស័យ កសិកម្ម ការ ទទួល បាន សេវាកម្ម ហិរញ្ញវត្ថុ បន្ថែម »៕
របាយការណ៍ បាន បន្ថែម ថា ៖
« ខណៈ កំណើន សេដ្ឋកិច្ច របស់ កម្ពុជា នៅ តែ មាន ស្ថិរភាព បទពិសោធ កន្លង មក បាន បង្ហាញ ថា ពេល វេលា មុន ពេល បោះឆ្នោត តែង តែ បាន បង្ហាញ បញ្ហា ប្រឈម សម្រាប់ សកម្មភាព សេដ្ឋកិច្ច របស់ កម្ពុជា » ។
ការ ស្ទង់មតិ នេះ បាន លើក ឡើង ថា ឧបសគ្គ ដ៏ សំខាន់ ក្នុង ការ ធ្វើ អាជីវកម្ម នៅ តែ អនុវត្ត ដោយ មិន មាន តម្លាភាព តម្លៃ ក្រៅ ផ្លូវ ការ និង « បញ្ហា ជា ប្រព័ន្ធ រយៈពេល វែង » នៃ ការ ប្រកួត ប្រជែង មិន ស្មើភាព ដែល ត្រូវ បាន កើន ឡើង ក្នុង អំឡុង ការ ផ្លាស់ ប្តូរ បទ ប្បញ្ញតិ្ត ជា ពិសេស ទាក់ទង នឹង ការ ផ្លាស់ ប្តូរ ពន្ធ ។
វា គ្រាន់ តែ ថា រៀងរាល់ ៥ ឆ្នាំ ក្រុមហ៊ុន បាន ផ្អាក ជា បណ្ដោះ អាសន្ន ខណៈ ការ រង់ចាំ សញ្ញា នៃ ស្ថិរភាព » ។
សៀវភៅ ស នៅ ឆ្នាំ នេះ រៀបចំ អនុសាសន៍ ថ្មី ចំនួន ៧៨ ដែល បាន ធ្វើ បច្ចុប្បន្នភាព និង ការ ប្រើ ប្រាស់ អនុសាសន៍ ដែល នឹង ត្រូវ បាន ដោះស្រាយ ដោយ ក្រុម ការងារ របស់ សភា ពាណិជ្ជកម្ម ។
យោង តាម លទ្ធផល នៅ ឆមាស ទីមួយ ឆ្នាំ នេះ និង និន្នាការ ប្រមូល ចំណូល នៅ ឆមាស ទី ២ របាយ ការណ៍ របស់ ក្រសួង សេដ្ឋកិច្ច រំពឹង ថា ការ អនុវត្ត ចំណូល ក្នុង ប្រទេស ឆ្នាំ ២០១៧ អាច នឹង សម្រេច បាន លើស ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការ គ្រប់គ្រង ឆ្នាំ ២០១៧ ប្រមាណ ៤,២ ភាគរយ ។
នេះ បើ តាម របាយការណ៍ ៕
បារាំងប្រកាសមូលនិធិវិនិយោគទំហំជាង ៦៧ ពាន់លានដុល្លារ
ក្នុង គោលបំណង កាត់ បន្ថយ ការ បំពុល បរិស្ថាន អ្នក បើកបរ ជនជាតិ បារាំង នឹង ត្រូវ បាន ផ្តល់ ជា ថវិកា លើក ទឹក ចិត្ត ចំនួន ១ ពាន់ អឺរ៉ូ ដើម្បី លក់ ចេញ រថយន្ត ប្រើប្រាស់ ប្រេង ម៉ាស៊ូត ដែល ត្រូវ បាន ផលិត នៅ មុន ឆ្នាំ ១៩៩៧ ឬ ឆ្នាំ ២០០១ មក ទិញ រថយន្ត ថ្មី ដែល អាច សន្សំ សំចៃ ប្រេង បាន ច្រើន ជាង ។
ធនាគារ អភិវឌ្ឍន៍ អាស៊ី បាន ឲ្យ ដឹង ថា ពាណិជ្ជកម្ម កំពុង ស្ទុះ ងើប ឡើង បន្ទាប់ ពី ការ នាំ ចេញ បាន ធ្លាក់ ចុះ រយៈ ពេល ២ ឆ្នាំ ដោយ បាន ជួយ ជំរុញ ចក្ខុ វិស័យ កំណើន សេដ្ឋកិច្ច របស់ ប្រទេស ចំនួន ៤៥ នៅ ក្នុង របាយ ការណ៍ នេះ។
ធនាគារ នេះ បាន បន្ត ឲ្យ ដឹង ទៀត ថា វិធានការ ជំរុញ សារពើពន្ធ របស់ រដ្ឋាភិបាល ក្រុង ប៉េកាំង និង តម្រូវ ការ បរទេស ដែល កំពុង កើន ឡើង កំពុង ជួយ ផ្តល់ សម្ទុះ ខ្លាំង ដល់ សេដ្ឋកិច្ច ធំ ជាង គេ នៅ តំបន់ អាស៊ី មួយ នេះ។
របាយ ការណ៍ ដដែល នេះ បាន បន្ត ឲ្យ ដឹង ថា កំណើន សេដ្ឋកិច្ច ខ្ពស់ នៅ អាមេរិក ជប៉ុន និង តំបន់ ប្រើ ប្រាស់ ប្រាក់ អឺរ៉ូ ដែល ជា ប្រភព តម្រូវ ការ ធំ ជាង គេ ចំពោះ ផលិតផល នាំ ចេញ ដែល ត្រូវ បាន ផលិត នៅ តំបន់ អាស៊ី ដែល កំពុង អភិវឌ្ឍន៍ នេះ ក៏ កំពុង ជំរុញ កំណើន សេដ្ឋកិច្ច ប្រចាំ តំបន់ ផង ដែរ។
ធនាគារ មួយ នេះ បាន បន្ត ឲ្យ ដឹង ទៀត ថា ហានិភ័យ ចំពោះ ការ ព្យាករ របស់ ខ្លួន នៅ ពេល នេះ មាន តុល្យភាព ខ្លាំង ជាង របាយការណ៍ ដំបូង របស់ ខ្លួន កាល ពី ខែ មេសា ជា ពេល ដែល ធនាគារ នេះ បាន លើក ឡើង ពី គោល នយោបាយ របស់ រដ្ឋបាល លោក ដូណាល់ ត្រាំ ដែល មិន ទាន់ មាន ភាព មិន ប្រាកដ ប្រជា ដែល អាច នឹង ប៉ះពាល់ ដល់ កំណើន សេដ្ឋកិច្ច។
បច្ចុប្បន្ន កត្តា មួយ ចំនួន ដូច ជា ផែនការ របស់ ធនាគារ កណ្តាល អាមេរិក ក្នុង ការ ដំឡើង អត្រា ការ ប្រាក់ នៅ អាមេរិក នៅ តែ ជា ហានិភ័យ មួយ តាម រយៈ ការ ស្រូប យក សាច់ ប្រាក់ ចេញ ពី តំបន់ អាស៊ី និង ការ ដាក់ សម្ពាធ លើ ធនាគារ និង ក្រុមហ៊ុន នានា នៅ តំបន់ អាស៊ី ដែល មាន កម្រិត បំណុល ខ្ពស់។
តែ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី បាន ឲ្យ ដឹង ថា «ការ ប្រាស្រ័យ ទាក់ទង ច្បាស់ លាស់ និង ដោយ តម្លាភាព » របស់ ធនាគារ កណ្តាល អាមេរិក អំពី ផែនការ របស់ ធនាគារ នេះ ក្នុង ការ ដំឡើង អត្រា ការ ប្រាក់ មក កម្រិត ធម្មតា វិញ នឹង ផ្តល់ ពេល ឲ្យ ទីផ្សារ ត្រៀម ខ្លួន៕
ឥណ្ឌា អូម៉ង់ និងអ៊ីរ៉ង់ពិភាក្សាកិច្ចសហប្រតិបត្តិការថាមពល
យោង តាម ប្រភព មួយ ចំនួន បាន ឲ្យ ដឹង ថា លោកស្រី Swaraj បាន ពិភាក្សា ពី បញ្ហា មួយ ចំនួន ជាមួយ សមភាគី របស់ លោកស្រី មកពី ប្រទេស អ៊ីរ៉ង់ និង អូម៉ង់ ជាពិសេស កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច ត្រីភាគី ។
ប្រទេស ទាំង នេះ យល់ ថា ប្រទេស របស់ ខ្លួន នឹង អាច ឆ្លើយតប តម្រូវការ ថាមពល របស់ ប្រទេស នីមួយៗ ទៅវិញ ទៅមក បាន តាមរយៈ ការ ពង្រឹង ការ នាំ ចូល និង ការ នាំ ចេញ ។
« កិច្ចប្រជុំ នេះ បាន ផ្លាស់ប្តូរ ទស្សនៈ ស្តីពី មធ្យោបាយ ប្រើប្រាស់ និង ទទួល បាន ផលប្រយោជន៍ ពី ឧស្ម័ន របស់ ប្រទេស អ៊ីរ៉ង់ និង យន្តការ កិច្ចសហប្រតិបត្តិការ ដើម្បី សម្រេច ឲ្យ បាន នូវ គម្រោង សាងសង់ បំពង់ ចែកចាយ ឧស្ម័ន និង ប្រេង ឆ្លងកាត់ សមុទ្រ ទឹក ជ្រៅ នៅ សមុទ្រ របស់ អូម៉ង់ និង មហាសមុទ្រ ឥណ្ឌា » ។
កិច្ចប្រជុំ នេះ សន្មត ថា មាន សារៈសំខាន់ ដោយសារ វា បាន ធ្វើ ឡើង រយៈពេល ប៉ុន្មាន ថ្ងៃ បន្ទាប់ពី លោក ដូណាល់ ត្រាំ ប្រធានាធិបតី អាមេរិក បាន បង្ហាញ ថា លោក អាច លុប ចោល កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ រវាង ប្រទេស អ៊ីរ៉ង់ និង មហាអំណាច លោក ខាង លិច ដោយ បាន ជំរុញ ឲ្យ មាន ក្តីបារម្ភ ថា លោក អាច ដាក់ ទណ្ឌកម្ម ថ្មី ប្រឆាំង នឹង ប្រទេស អ៊ិស្លាម មួយ នេះ ។
ប្រទេស ឥណ្ឌា ទំនង ជា នឹង បន្ត ស្វែងរក និង ការពារ ផលប្រយោជន៍ សេដ្ឋកិច្ច របស់ ខ្លួន នៅ តំបន់ អាស៊ី ខាង លិច ទន្ទឹម នឹង នោះ បាន ឃ្លាំ មើល គោលនយោបាយ របស់ សហរដ្ឋ អាមេរិក ចំពោះ រដ្ឋាភិបាល ក្រុង តេអេរ៉ង់ ។
