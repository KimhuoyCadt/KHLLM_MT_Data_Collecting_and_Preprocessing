លក្ខន្តិកៈ នៃ ការ ប្រកួត តម្រូវ ឲ្យ ក្រុម ចុងភៅ នីមួយ ៗ ចម្អិន ម្ហូប ចម្បង ៣ មុខ បូក រួម ទាំង ឈុត អាហារ ប៊ូហ្វេ ដោយ រាប់ បញ្ចូល នូវ ញាំ បន្លែ អាហារ បើក វគ្គ ប្រភេទ ត្រជាក់ ៗ ស៊ុប បង្អែម ត្រជាក់ ២ មុខ បង្អែម ធម្មតា ២ មុខ និង នំ មួយ មុខ ។
ក្នុង ការ ប្រកួត នេះ ផង ដែរ មេចុងភៅ សុខ គីមសាន បាន ឲ្យ ដឹង ថា ចុងភៅ ទាំងឡាយ ត្រូវ ច្នៃប្រឌិត មុខ ម្ហូប និង គ្រឿង ផ្សំ ដោយ ខ្លួន ឯង ហើយ ពួកគេ ត្រូវ សហការ គ្នា ក្នុង ក្រុម ដើម្បី ធានា ថា រាល់ មុខ ម្ហូប ដែល ពួកគេ ចម្អិន ទាំងអស់ គឺ ស៊ីសង្វាក់ គ្នា ទៅវិញ ទៅមក មិន ថា រសជាតិ និង សោភ័ណភាព នោះ ទេ ។
ភ្លក្សបុកល្ហុងក្ដាមសេះល្បីពីហាងសម្ផស្សនៅម្ដុំទួលស្វាយព្រៃ
ហាង សម្ផស្ស ល្បីល្បាញ បុកល្ហុង ក្តាមសេះ មួយ នេះ មិន ត្រឹម តែ មាន បុកល្ហុង នោះ ទេ គឺ មាន បុក មីសួ បុក នំបញ្ចុក បុក ផ្លែឈើ ស្លាបមាន់អាំង បាយដំណើប និង ភ្លៅមាន់អាំង ជាដើម ។
យើង បាន ទៅ កុម្ម៉ង់ បុកល្ហុង ក្តាមសេះ បុក មីសួ បុក ល្ហុង ក្តាមប្រៃ ធម្មតា ដើម្បី ទទួលទាន ជាមួយ ស្លាបមាន់អាំង និង បាយដំណើប ដាក់ ក្នុង ស្មុគ ។
អង្គុយ ចាំ ប្រមាណ ជា ១០ នាទី អ្នក បម្រើ សេវា នៅ ទី នោះ បាន លើក បុកល្ហុក ក្តាមសេះ មក មុន គេ គ្រាន់ តែ ក្លិន ឈ្ងុយ កាពិ និង ក្តាមសេះ គឺ ធ្វើ ឲ្យ យើង ទាំងអស់ គ្នា ទប់ ទឹកមាត់ ស្ទើរ តែ មិន បាន ។
រសជាតិ របស់ វា ហឹរ រីឯ សាច់ ល្ហុង វិញ ទន់ ស្រួយ បន្តិច ជាមួយ ។
ក្តាម សេះ ឆៅ រួម ផ្សំ គ្រឿង កាពិ ស្ករស ទឹកត្រី ខ្ទឹមស និង សណ្តែកដី គឺ ពិតជា មាន រសជាតិ ឆ្ងាញ់ មែន ទែន នៅ ពេល ដែល ញ៉ាំ វា ផ្ទាប់ ជាមួយ សាច់មាន់ និង បាយដំណើប ។
ចំណែកឯ បុកល្ហុង ធម្មតា ក្តាមប្រៃ វិញ គឺ ប្រមាណ ជា ១ ដុល្លារ ។
ហាង សម្ផស្ស មាន ទីតាំង ស្ថិត នៅ ផ្លូវ ៣៣៨ នៅ ក្បែរ វិទ្យាល័យ ទួលស្វាយព្រៃ ៕
គុយទាវសាច់ចម្រុះបន្លែសណ្ដែកបណ្ដុះលាយត្រកួននៅបាក់ទូក
ការ ស្រស់ស្រូប អាហារ ពេល ព្រឹក ដោយ មាន គុយទាវ ១ ចាន នោះ ត្រូវ ចំណាយ មិន ក្រោម ៦ ពាន់ រៀល ទេ បើ ទោះ ជា យើង ទៅ ទទួលទាន នៅ អាហារដ្ឋាន តូចតាច តាម ចិញ្ចើម ផ្លូវ ក្ដី ។
យ៉ាង ណា មិញ នៅ ម្ដុំ ក្រោយ សាលារៀន បាក់ទូក ទល់មុខ ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល ផ្សារអូរឫស្សី ២ អាហារដ្ឋាន មួយ ដែល មិន មាន ស្លាក យីហោ អ្វី ធំ ដុំ នោះ បាន ទាក់ទាញ មនុស្សម្នា មក ទទួលទាន គុយទាវ ដ៏ ពិសេស របស់ ខ្លួន ក្នុង តម្លៃ មួយ ចាន ត្រឹម តែ ៥ ពាន់ រៀន ប៉ុណ្ណោះ ។
ខុស ប្លែក ពី គុយទាវ នៅ ភោជនីយដ្ឋាន ទូទៅ ដែល ប្រើ តែ សណ្ដែកបណ្ដុះ ជា បន្លែ ផ្សំ ចម្បង នោះ អាហារដ្ឋាន ស្ថិត នៅក្នុង ផ្ទះ មួយ ល្វែង នេះ មាន បច្ចេកទេស ស្រុស គុយទាវ ជាមួយ នឹង បន្លែ ត្រកួន និង សណ្ដែកបណ្ដុះ អម ដោយ សាច់ ចម្រុះ ជាច្រើន មុខ បើ ទោះ ជា វា មាន តម្លៃ ត្រឹម តែ ៥ ពាន់ រៀល ក្នុង ១ ចាន ក៏ ពិត មែន ។
នៅ ក្នុង ចាន គុយទាវ យើង ឃើញ មាន ប្រហិត សាច់គោមូល ប្រហិត សាច់ជ្រូក បន្ទះ ស្ដើង ៗ ពោះវៀនជ្រូក ផាក់ឡូវ ស្លឹកត្រចៀក ជ្រូក ផាក់ឡូវ ថ្លើម ជ្រូក សាច់ជ្រូក និង សាច់ចិញ្ច្រាំ អណ្ដែត ពាស ទឹកស៊ុប ជាមួយ នឹង ស្លឹកខ្ទឹម ចិញ្ច្រាំ ដ៏ច្រើន ផង ដែរ ។
ក្រៅ ពី គុយទាវ អាហារដ្ឋាន នេះ ក៏ មាន ជម្រើស មីដុំ មីកញ្ចប់ និង មីសួ ស្រុស ជាមួយ ទឹកស៊ុប ផង ដែរ ។
អ្វី ដែល ពិសេស ជាង នេះ ទៅ ទៀត ភ្ញៀវ ក៏ អាច កុម្ម៉ង់ មីគាវ ដែល មាន រសជាតិ ឈ្ងុយឆ្ងាញ់ ផង ដែរ ។
ប៉ុន្តែ មាន ភ្ញៀវ មួយ ចំនួន យល់ ថា ទឹកស៊ុប គុយទាវ នេះ ហាក់ ប្រៃ និង ផ្អែម បន្តិច ។
ដូច្នេះ ភ្ញៀវ គួរ តែ ភ្លក្ស ទឹកស៊ុប ជាមុន សិន មុន នឹង បន្ថែម ទឹកសៀង ឬ គ្រឿងផ្សំ ប្រៃ ដទៃ ទៀត ។
ប្រសិន បើ លោក អ្នក ចង់ ភ្លក្ស គុយទាវ នៅ ទី នោះ សូម ព្យាយាម ធ្វើ ដំណើរ ដោយ ថ្មើរជើង ឬ ជិះ ទោចក្រយាន ក៏ បាន ព្រោះ អាហារដ្ឋាន នេះ មិន មាន កន្លែង ចត រថយន្ត ឡើយ ។
ដូច្នេះ ហើយ ទើប ភ្ញៀវ មួយ ចំនួន និយម ខ្ចប់ គុយទាវ នេះ ទៅ ទទួលទាន នៅឯ ផ្ទះ វិញ ។
នៅ ទីនោះ ក៏ ល្បី ថា មាន ទឹកសណ្ដែកខៀវ ឈ្ងុយឆ្ងាញ់ ពិសា ផង ដែរ ៕
នៅ ពេល ដែល បង ថា ចាប់ ផ្ដើម ធ្វើ មីញាំ លើក ដំបូង ដើម្បី ឲ្យ មិត្តភក្ដិ បងប្អូន ភ្លក្ស នោះ គាត់ មិន នឹកស្មាន ថា អាហារ នេះ នឹង ក្លាយ ជា អាជីវកម្ម របស់ ខ្លួន នា ថ្ងៃ អនាគត ទេ ។
កាល នោះ បង ថា បាន ធ្វើ មីញាំ ដែល មាន រសជាតិ ហឹរ និង មាន លក្ខណ ពិសេស ដោយ វា ផ្សំ គ្រឿង ពី សាច់មឹក កញ្ឆែត និង ស្ពៃក្ដោប ហើយ មិត្តភក្ដិ របស់ គាត់ បាន កោតសរសើរ ថា ថ្វីដៃ ចម្អិន អាហារ នេះ ពិតជា ពិសេស អាច យក ទៅ បើក អាជីវកម្ម អាហារដ្ឋាន បាន ។
បង ថា ដែល ជា ម្ចាស់ ហាង នោះ ក៏ បាន ធ្វើ ឲ្យ ក្ដី សុបិន នេះ ក្លាយ ជា ការពិត ដោយ រំលេច ចេញ ជា រូបរាង អាហារដ្ឋាន មួយ នៅ ផ្ទះ ល្វែង ម្ដុំ ខាង ជើង សាកលវិទ្យាល័យ ន័រតុន ។
តើ មីញាំ នេះ មាន អាថ៌កំបាំង ក្នុង ការ ចម្អិន ដូច ម្ដេច ?
គ្រឿងផ្សំ ចម្បង :
មីកញ្ចប់ កញ្ឆែត ស្ពៃក្ដោប ម្ទេស មឹក សាច់គោ ទឹកត្រី ស្ករស ម្សៅស៊ុប ម្ទេសម៉ដ្ឋ និង គ្រឿង តុំយ៉ាំ ។
ចំណែកឯ ស្ពៃក្ដោប និង កញ្ឆែត ត្រូវ កាត់ ជា កង់ តូច ៗ រួច ស្រុស ឲ្យ ឆ្អិន ល្មម ។
ដំណាក់កាល បន្ទាប់ ត្រូវ យក មី ដែល ស្រុស រួច ដាក់ ចូល ក្នុង ចាន គោម ធំ ដើម្បី ងាយស្រួល ក្នុង ការ ញាំ ច្របល់ ជាមួយ បន្លែ សាច់ ។
បន្ទាប់ មក ត្រូវ ដាក់ គ្រឿង តុំយ៉ាំ ចូល រួច ដាក់ ស្ករស ទឹកត្រី ម្ទេសម៉ដ្ឋ ម្ទេសហាន់ និង គ្រឿង ស៊ុប ។
ចុង ក្រោយ ត្រូវ ដាក់ បន្លែ កញ្ឆែត ស្ពៃក្ដោប មឹក និង សាច់គោ ចូល ហើយ ចាប់ ផ្ដើម កូរ ច្របល់ ចូល គ្នា ឲ្យ ចូលជាតិ នោះ ជា ការ ស្រេច ។
ភ្ញៀវ ទាំងឡាយ ក៏ អាច ជ្រើសរើស យក ការ អង្គុយ ជុំវិញ អាង ហែល ទឹក ពណ៌ ខៀវ ស្រងាត់ ខណៈ ទទួលទាន អាហារ ខ្មែរ និង បរទេស ជាច្រើន មុខ ផង ដែរ។
ថ្ងៃ នេះ ភ្នំពេញ ប៉ុស្ដិ៍ នឹង នាំ លោក អ្នក ទៅ ភ្លក្ស រសជាតិ ម្ហូប ត្រីចៀន ជូរអែម បន្លែ គ្រប់ មុខ នៅ ភោជនីយដ្ឋាន Le Coco ព្រម ទាំង លាតត្រដាង នូវ អាថ៌កំបាំង ក្នុង ការ ចម្អិន ដូច ខាងក្រោម នេះ។
គ្រឿងផ្សំ រសជាតិ :
ម្សៅឆា ទឹក ប៉េងប៉ោះ ម្សៅស៊ុប អំបិល និង ស្ករ។
ត្រីរ៉ស់ ត្រូវ យក ទៅ ចៀន ខ្លាញ់ ឲ្យ ឆ្អិន ល្មម ហើយ ទុក មួយ អន្លើ សិន ។
យក បន្លែ ដែល ចិត រួច ហើយ យក មក ឆា ជាមួយ នឹង គ្រឿងផ្សំ រសជាតិ ដូចជា ស្ករស ម្សៅស៊ុប អំបិល ទឹក ប៉េងប៉ោះ និង ម្សៅឆា ដើម្បី ឲ្យ ខាប់ ទឹក បន្តិច ហើយ ភ្លក្ស សាប ប្រៃ តាម ចំណូល ចិត្ត ។
លោក អ្នក ត្រូវ រៀប សាលាដ រួច ដួសត្រី ចៀន ដាក់ចាន មុន នឹង ស្រូប ទឹក បន្លែ ជូរអែម ហើយ រោយ ស្លឹក ខ្ទឹម និង ជីរវ៉ាន់ ស៊ុយ នោះ ជា ការ ស្រេច។
ប៊ីប៊ីឃ្យូមួយចម្អែតសម្រាប់គ្នា២នាក់ចំណាយមិនដល់៧ដុល្លារ
ការ ទទួលទាន សាច់អាំង ប៊ីប៊ីឃ្យូ និង ក្រេប ស្រាបៀរ គឺជា ទំនោរ ជួបជុំ មិត្តភក្តិ បងប្អូន សម្រាប់ អាហារ ពេល ល្ងាច ដ៏ ពេញនិយម មួយ សម្រាប់ មនុស្ស គ្រប់ វ័យ តែ ម្ដង។
ដូច្នេះ ហើយ ទោះ ភោជនីយដ្ឋាន សាច់អាំង បាន រីក ព្រោងព្រាត ដូច ផ្សិត នៅ រាជធានី ភ្នំពេញ ហើយ ឲ្យ តែ ពេល ល្ងាច ព្រះសូរ្យសែង អស្ដង្គត ភ្លាម ពន្លឺ ភ្លើង អគ្គិសនី នឹង ចែងចាំង ចេញ ពី ហាង ទាំងនោះ ដែល មាន ផ្សែង អាំង សាច់ ភាយ ចេញ មក អម ជាមួយ នឹង ក្លិន ឈ្ងុយ គួរ ឲ្យ ចង់ ស្រក់ទឹក មាត់។
ជាទូទៅ ការ ទទួលទាន សាច់អាំង នៅ ភោជនីយដ្ឋាន ទូទៅ មនុស្ស ២ នាក់ ត្រូវ ចំណាយ ប្រាក់ ជា មធ្យម ក៏ ២០ ដុល្លារ ដែរ បូករួម ទាំង ភេសជ្ជៈ ។
ស្ថិត នៅក្នុង ដីឡូត៍ដ៏ ធំ មួយ ដែល មាន រុក្ខជាតិ ហូប ផ្លែ រួម ទាំង ដើមដូង មួយ គូ ផង នោះ ភោជនីយដ្ឋាន នេះ មាន ដាក់ តុដែក ភ្លឺរលោង និង កៅអីជ័រ ពណ៌ ក្រហម តម្រៀប គ្នា យ៉ាង មាន សណ្ដាប់ធ្នាប់ ។
លោកអ្នក ក៏ អាច ជ្រើសរើស អង្គុយ លើ តុ កៅអី ឈើ ជា លក្ខណៈ គ្រួសារ ផង ដែរ ។
នៅ រដូវ ប្រាំង អ្នក អាច ទទួលទាន សាច់អាំង ក្រោម ដំបូល មេឃ ខណៈ ដែល នៅ រដូវវស្សា ដែល សម្បូរ ភ្លៀង ភោជនីយដ្ឋាន ក៏ មាន រៀបចំ ដំបូល រូត ការពារ កុំ ឲ្យ ភ្ញៀវ ទទឹក ភ្លៀង ផង ដែរ ។
ភោជនីយដ្ឋាន ម្លប់ ដូង ភ្លោះ ស្ថិត នៅ លើ ផ្លូវ ៥៦៦ ក្បែរ អាផាតមិន ជ័យភូមិន្ទ ។
លោក អ្នក អាច ធ្វើ ដំណើរ ពី មជ្ឈមណ្ឌល ទួលគោក ឆ្ពោះ ទៅ សាលារៀន បឋមសិក្សា ហ្សាមែន រួច បត់ ឆ្វេង ប្រមាណ ជាង ១០០ ម៉ែត្រ នោះ នឹង ប្រទះ ឃើញ ភោជនីយដ្ឋាន នោះ នៅ ខាង ឆ្វេង ដៃ ជា មិន ខាន ៕
បាយសាច់ចិញ្ច្រាំស៊ុតចៀនជាម្ហូបអត្តសញ្ញាណរបស់ក្រុងម៉ាកាវ
ទីក្រុង ចិន ដែល ស្ថិត ក្រោម អាណានិគម ព័រទុយហ្គាល់ ទទួល ឥទ្ធិពល ពី វប្បធម៌ អា្រហ្វិក ឥណ្ឌា និង អង់គ្លេស បាន បន្សល់ ទុក នូវ រសជាតិ អាហារ និង វប្បធម៌ រស់នៅ ដ៏ អស្ចារ្យ។
សាច់ចិញ្ច្រាំ នោះ ធ្វើ ពី សាច់គោ ឬ សាច់ជ្រូក និង ផ្សំគ្រឿង ដោយ ទឹកស៊ីអ៊ីវ ស្ករ របស់ ជនជាតិ ព័រទុយហ្គាល់ ធ្វើ ឡើង ពី អំពៅ ទំពាំងបាយជូរ និង មើម ដំឡូងបារាំង។
បាយ សាច់ចិញ្ច្រាំ នេះ មាន បន្ថែម នូវ ដំឡូង បារាំង ដែល ស័ក្ដិសម ជា អាហារ សម្រាប់ រដូវរងា នៅ ទីនោះ ណាស់។
គ្រឿងផ្សំ របស់ បាយ មីនឈី រួមមាន សាច់គោចិញ្ច្រាំ ម៉ដ្ឋ ២,៥ ខាំ សាច់ជ្រូក ម៉ដ្ឋ ២,៥ ខាំ ដំឡូងបារាំង ៣ មើម កាត់ ជា ដុំ បួន ជ្រុង តូច ៗ ខ្ទឹម បារាំង ១ មើម ចិញ្ច្រាំ ឲ្យ ម៉ដ្ឋ ខ្ទឹមស ២ កំពឹស ស្លឹក bay leaf ១ សន្លឹក ទឹកស៊ីអ៊ីវ ធម្មតា ២ ស្លាបព្រា កាហ្វេ ទឹកស៊ីអ៊ីវ ខាប់ ២ ស្លាបព្រាកាហ្វេ ស្ករ ១ ស្លាបព្រា កាហ្វេ ម្រេច ១ កូន ស្លាបព្រា អំបិល ១ កូន ស្លាបព្រា និង ប្រេងអូលីវ ២ ស្លាបព្រាបាយ ។
ដំបូង ត្រូវ យក ដំឡូង បារាំង ទៅ បំពង ឲ្យ ឆ្អិន ល្មម រួច ស្រង់ ទុក ឲ្យ ស្រក់ ប្រេង អស់ មួយ អន្លើ សិន ។
ចាប់ ផ្ដើម ដាក់ ម្រេច ទឹកស៊ីអ៊ីវ ទាំង ២ មុខ និង ស្ករ បន្តិច ចូល បន្ថែម ចំណិត ដំឡូង បារាំង ដែល បំពង រួច ។
ចាប់ ផ្ដើម កូរ ឲ្យ ចូល ជាតិ គ្នា ស្មើសាច់។
បាយស រោយ ស្លឹកខ្ទឹម និង ជីរវ៉ាន់ស៊ុយ ត្រូវ ដួស ដាក់ ចាន រួច ស្រូប ឆា សាច់ចិញ្ច្រាំ ពី លើ ដោយ បន្ថែម ស៊ុតចៀន ទាំង មូល ទៀត នោះ ជា ការ ស្រេច៕
ភោជនីយដ្ឋានម្ហូបម៉ិកស៊ិកបម្រើអាហារទំហំប៉ុនកូនង៉ែត
ក្រុងឡូសអេនជឺលេស :
ប៊ូរីតូស ជា ម្ហូប ពិសេស ម្យ៉ាង របស់ ម៉ិកស៊ិក ដែល មាន បម្រើ នៅឯ ភោជនីយដ្ឋាន ហ្គ័រឌីតូស ដោយ វា អាច មាន ទម្ងន់ ប្រមាណ ជា ២ គីឡូក្រាម ឯណោះ ។
ចំពោះ ប៊ូរីតូស ទំហំ ធំ គេ បាន ប្រើ សំបក រុំ ពីរ ស្រទាប់ ដោយ ប្រើ សាច់ គ្រឿង សមុទ្រ សាច់ជ្រូក សាច់ ប្រូម៉ាត សាលាដ និង ម្សៅក្រេម លាយ ផង ដែរ ជាមួយ នឹង តម្លៃ ១ ចាន ត្រឹម តែ ៩ ដុល្លារ ប៉ុណ្ណោះ។
ប៉ុន្តែ ភោជនីយដ្ឋាន នៅ តែ រក្សា ខ្នាត ទំហំ អាហារ ប្រចាំ ហាង របស់ ខ្លួន ដដែល ដោយ លើក ទឹកចិត្ត ឲ្យ ភ្ញៀវ ណា បរិភោគ សល់ ខ្ចប់ អាហារ នោះ ទៅ ញ៉ាំ បន្ត នៅ ផ្ទះ។
ដោយសារ តែ ចុងភៅ ចម្អិន អាហារ ប៊ូរីតូស ឲ្យ មាន ទំហំ ប៉ុន ទារក វ័យ ១ ខែ នោះ ទើប ម្ចាស់ ភោជនីយដ្ឋាន បាន ប្រកាស ថា ភ្ញៀវ ណា ដែល យក កូនង៉ែត របស់ ខ្លួន ដេក ផ្ទឹម នឹង ចាន អាហារ រួច ថតរូប អនុស្សាវរីយ៍ ទុក នោះ ពួកគេ នឹង បាន ញ៉ាំ ម្ហូប ម៉ិកស៊ិក នេះ មួយ ចាន ដោយ ឥត គិត ថ្លៃ។
បង្គាបំពងអំពិលទុំពីភោជនីយដ្ឋានម៉ារីណាវីឡា នៅប្រទេសថៃ
ក្រោយ ពី គយគន់ ទេសភាព ហើយ មួយ សន្ទុះ ក្លិន ម្ហូប គ្រឿងសមុទ្រ បាន ភាយ ចេញ ពី ចង្ក្រាន របស់ ភោជនីយដ្ឋាន ម៉ារីណាវីឡា ស្ថិត ក្នុង ក្រុង ក្រាប៊ី ប្រទេស ថៃ ។
ហាង នេះ តុបតែង បែប សាមញ្ញ ជាមួយ ការ លាប ពណ៌ ផ្ទៃមេឃ ជាមួយ នឹង កៅអី ពណ៌ ស និង អំពូលភ្លើង ភ្លឺ ស្រទន់ តិច ។
អង្គុយ បាន មួយ សន្ទុះ បុគ្គលិក ហាង យ៉ាង ស្រស់ស្អាត ស្លៀក សំពត់ ខ្លី និង អាវ យឺត បែប ទង់ជាតិ អាមេរិក បាន កាន់ បញ្ជី រាយនាម មុខ ម្ហូប ដោយ ពេល នោះ ខ្ញុំ បាន កុម៉្មង់ ត្រី ចំហុយ ម្ទេស សម្ល ការីខៀវ គ្រឿងសមុទ្រ ញ៉ាំស្វាយ ពងសត្វ ប្រឡាំងកាស បុកល្ហុង បង្គាស្រស់ និង ម្ហូប ពិសេស ដ៏ ពេញនិយម នៅ ទី នោះ បំផុត គឺ «បង្គា បំពង ទឹកអំពិលទុំ»។
បង្គា បំពង ទឹកអំពិលទុំ គឺជា មុខម្ហូប បែប ថៃ ដែល មាន រសជាតិ ឆ្ងាញ់ ប្លែក មាត់ មែន ហើយ វា ក៏ ងាយស្រួល ចម្អិន ថែម ទៀត ផង ។
គ្រឿងគ្រៅ របស់ វា រួម មាន បង្គា ស្រស់ ធំ ៗ ទឹកអំពិល សាលាដ ត្រសក់ ការ៉ុត ម្សៅ បំពង ស្ករស អំបិល និង គ្រឿង ស៊ុប ។
ចំណែក របៀប ធ្វើ វិញ គឺ មុន ដំបូង ត្រូវ យក បង្គា ទៅ លាង ទឹក បេះ សម្បក ឲ្យ ស្អាត រួច ជ្រលក់ ជាមួយ ម្សៅ បំពង។
បន្ទាប់មក ត្រូវ យក អំពិល ទៅ ត្រាំ ទឹក ឲ្យ ចេញ ជាតិ ឲ្យ អស់ បន្ទាប់មក ចាក់ ចូល ខ្ទះ ឆា ជាមួយ អំបិល ស្ករ និង ម្សៅស៊ុប។
នៅ ពេល ដែល ឆ្អិន ស្រង់ បង្គា បំពង ដាក់ ចាន ជាមួយ សាលាដ ត្រសក់ ការ៉ុត រួច សឹម ស្រោច ទឹកអំពិល ចូល ជា ការ ស្រេច៕
« ការ បង្កើត ភោជនីយដ្ឋាន នេះ ជា ក្តីស្រមៃ និង ជា ការ ខិតខំ ប្រឹងប្រែង រួម គ្នា ។
ចំនួន ពលករ នេប៉ាល់ នៅ ក្រៅ ប្រទេស បាន នឹង កំពុង ធ្លាក់ ចុះ ក្នុង រយៈពេល វែង ។
លំហូរ ចេញ ពលករ បាន ធ្លាក់ ចុះ ១ ភាគរយ ក្នុង រយៈពេល ៤ ខែ ដំបូង ក្នុង ឆ្នាំ សារពើពន្ធ នេះ ដោយសារ ការ ធ្លាក់ ចុះ តម្រូវការ ពលករ នៅ ប្រទេស អារ៉ាប៊ីសាអូឌីត ដែល ជា ទីផ្សារ ដ៏សំខាន់ មួយ របស់ ពលករ នេប៉ាល់ ។
« ចំនួន ពលករ នេប៉ាល់ ចេញ ទៅ ក្រៅ ប្រទេស ទំនង ជា ធ្លាក់ ចុះ បន្ថែម ទៀត ខណៈ ដែល ការ បញ្ចប់ ការ បោះឆ្នោត ដោយ ជោគជ័យ បាន ធ្វើឲ្យ ប្រជាជន មាន ភាព សុទិដ្ឋិនិយម និង ជំរុញ ឲ្យ មនុស្ស ជាច្រើន រស់នៅ និង ធ្វើការ នៅ ទី នេះ » ។
ប្រាក់ បញ្ញើ មក ផ្ទះ នេះ ដើរ តួនាទី ដ៏សំខាន់ មួយ ក្នុង ការ ជំរុញ ពលរដ្ឋ នេប៉ាល់ ឲ្យ ងើប ផុត ពី អន្ទាក់ ភាព ក្រីក្រ និង ជំរុញ តម្រូវការ ប្រើប្រាស់ ក្នុង ស្រុក ដែល មាន ទំហំ ជិត ៩០ ភាគរយ នៃ ផ.ស.ស កាលពី ឆ្នាំ សារពើពន្ធ មុន ។
ប្រាក់ បញ្ញើ មក ផ្ទះ នេះ ក៏ បាន ដើរ តួនាទី ដ៏សំខាន់ មួយ ផង ដែរ ក្នុង ការ រក្សា កំណើន ប្រាក់ បម្រុង ជា រូបិយប័ណ្ណ បរទេស របស់ ប្រទេស នេះ ៕
ក្រុម អ្នក វិភាគ បាន ឲ្យ ដឹង ថា ចំណាត់ ថ្នាក់ ប្រចាំ តំបន់ ខ្ពស់ ក្នុង វិស័យ អប់រំ រួម ជាមួយ នឹង ប្រាក់ ឈ្នួល អប្បរមា ទាប នៅ ប្រទេស នេះ កំពុង ជួយ ទាក់ទាញ វិនិយោគ បរទេស ។
របាយការណ៍ ដែល ទទួល បាន ពី ទីភ្នាក់ងារ វិនិយោគ បរទេស ស្ថិត ក្រោម ក្រសួង រៀបចំ ផែនការ និង វិនិយោគ របស់ វៀតណាម បាន បង្ហាញ ថា ក្នុង ចំណោម មូលធន វិនិយោគ សរុប នេះ មូលធន ចំនួន ២១,២៧ ពាន់ លាន ដុល្លារ បាន មកពី គម្រោង វិនិយោគ ថ្មី ២៥៩១ គម្រោង កើនឡើង ៤២,៣ ភាគរយ ធៀប នឹង ឆ្នាំ មុន ។
មូលធនវិនិយោគ ចំនួន ៨,៤១ ពាន់ លាន ដុល្លារ ទៀត ត្រូវ បាន បន្ថែម លើ គម្រោង វិនិយោគ ដែល មាន ស្រាប់ ចំនួន ១១៨៨ គម្រោង ខ្ពស់ ជាង ការវិនិយោគ កាលពី ឆ្នាំ មុន ៤៩,២ ភាគរយ ។
មូលធនវិនិយោគ ដែល នៅ សេសសល់ នៃ ការ វិនិយោគ ផ្ទាល់ ពី បរទេស ដែល មាន ទំហំ ស្មើនឹង ៦,១៩ ពាន់ លាន ដុល្លារ បាន មកពី កិច្ចព្រមព្រៀង ចំនួន ៥០០២ ដែល ត្រូវ បាន ធ្វើ ឡើង ដោយ វិនិយោគិន បរទេស ដើម្បី ផ្តល់ វិភាគទាន មូលធន ឬ ទិញ ភាគហ៊ុន ក្នុង ក្រុមហ៊ុន របស់ វៀតណាម ដែល បាន កើនឡើង ៤៥,១ ភាគរយ ធៀប នឹង ឆ្នាំ មុន ។
ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ មុន លំហូរ ចូល មូលធន បាន កើនឡើង ដល់ ត្រឹមតែ ១១ ទៅ ១២ ពាន់ លាន ដុល្លារ ប៉ុណ្ណោះ ។
ក្នុង ចំណោម ប្រទេស ចំនួន ១១៥ ដែល វិនិយោគ នៅ ប្រទេស វៀតណាម ក្នុង ឆ្នាំ នេះ ប្រទេស ជប៉ុន ស្ថិត នៅ ចំណាត់ថ្នាក់ កំពូល ដោយ មាន ទំហំ វិនិយោគ ៩,១១ ពាន់ លាន ដុល្លារ ស្មើនឹង ២៥,៤ ភាគរយ នៃ ការ វិនិយោគ ផ្ទាល់ ពី បរទេស ដែល បាន សន្យា វិនិយោគ នៅ ប្រទេស វៀតណាម ។
ក្នុង ចំណោម គម្រោង វិនិយោគ ធំៗ ក្នុង ឆ្នាំ ២០១៧ មាន គម្រោង « កសាង ប្រតិបត្តិការ និង ផ្ទេរ » លើ វិស័យ ផលិត ថាមពល ពី កម្ដៅ ក្នុង ផែនដី ចំនួន ៣ គម្រោង ៕
រដ្ឋាភិបាលថៃ នឹងអនុវត្តដំណាក់កាលទី ៣ នៃផែនការជួយអ្នកក្រីក្រ
មូលនិធិ នេះ ទទួល ខុស ត្រូវ ជា ឧបករណ៍ របស់ រដ្ឋាភិបាល ក្នុង ការ ផ្ដល់ ឧបត្ថម្ភធន និង សុខុមាល ភាព ដល់ ក្រុម អ្នក ទទួល ផែន ការ រដ្ឋ ។
ក្រុមហ៊ុនចិន នឹងអភិវឌ្ឍអណ្តូងប្រេងនៅទីក្រុងបាកដាដ
ទិន្នផល ប្រេង នេះ នឹង ត្រូវ ប្រើ ប្រាស់ សម្រាប់ រោង ចក្រ ចម្រាញ់ ប្រេង Dora នៅទីក្រុង បាកដាដ និង រោង ចក្រ ផលិតថាមពលអគ្គិសនី ក្បែរទីក្រុង នេះ។
ក្រោម កិច្ចព្រមព្រៀង នេះ ក្រុមហ៊ុនចិននឹង សាង សង់ លំនៅឋាន ឲ្យកម្ម ករ សាលា រៀន មើលថែកុមារ និងគ្លីនិក។
ពលរដ្ឋអុីរ៉ាក់ នឹង មាន ចំនួន ៥០ ភាគ រយនៃកម្លាំង ពលកម្ម ដែល ជា តួលេខ មួយ ដែលនឹង កើនឡើង ដល់ ៨០ ភាគ រយ៕
លោក Pisit មាន ប្រសាសន៍ បន្តថា ការ ផ្តល់ កម្ចី របស់ ធនាគារ របស់ លោក នឹង ផ្តោត លើ ក្រុម ហ៊ុន នាំចេញ ទៅកាន់ទិសដៅនានា ក្នុង តំបន់ អាស៊ី ជា ពិសេស កម្ពុជា ឡាវ មីយ៉ាន់ម៉ា និង វៀត ណាម និងក្រុមហ៊ុន ដែលពង្រីក អាជីវកម្ម របស់ ខ្លួនទៅកាន់ ប្រទេស ជិត ខាង ។
ចំនួន អ្នក ខ្ចី បានកើនឡើង ២០ ភាគ រយ ក្នុង រយៈ ពេលដូចគ្នា កាល ពី ឆ្នាំមុន។
មូលនិធិ រូបិយវត្ថុ អន្តរ ជាតិ បាន ព្យាករ នាពេលថ្មីៗនេះ ថា សេដ្ឋកិច្ចពិភពលោក អាច នឹង កើនឡើង ៣,៧ ភាគ រយ នៅ ឆ្នាំ ២០១៨ ខាងមុខ នេះ ពោលគឺ ជា អត្រា កំណើន ខ្ពស់ បំផុត ក្នុង រយៈ ពេល ៧ ឆ្នាំ ខណៈ កំណើន ពាណិជ្ជកម្មពិភពលោក នឹង កើនឡើង ដល់ ៤ ភាគ រយ ពោលគឺ ខ្ពស់ ជាង កំណើន សេដ្ឋកិច្ច សកលក្នុង រយៈ ពេល ៧ ឆ្នាំ ជាប់គ្នា៕
យោង តាម លោក ផៃ ស៊ីផាន ក្នុង រយៈពេល ៣ ឆ្នាំ នៃ ការ អនុវត្ត នេះ ក្រសួង ស្ថាប័ន ថ្នាក់ ក្រោម ជាតិ ដែល ពាក់ព័ន្ធ បាន រៀបចំ ផែនការ សកម្មភាព និង ថវិកា កំណត់ ការងារ ដែល ត្រូវ ធ្វើ ចំពោះ មុខ ដើម្បី ជំរុញ ការ អភិវឌ្ឍ វិស័យ កសិ ឧស្សាហកម្ម ការ ជំរុញ សហគ្រាស ធុន តូច និង មធ្យម ការ បណ្តុះ បណ្តាល ជំនាញ និង ធនធាន មនុស្ស និង ការ ជំរុញ ការ អភិវឌ្ឍ ប្រព័ន្ធ ដឹក ជញ្ជូន និង ភ័ស្តុភារ ។
ក្នុង កិច្ច ប្រជុំ គណៈ រដ្ឋ មន្ត្រី កាលពី ថ្ងៃ សុក្រ លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន បាន អនុម័ត សេចក្តី ព្រាង របាយការណ៍ នេះ ។
លោក ហ៊ីង ថូរ៉ាស៊ី រដ្ឋ លេខាធិការ ទីស្តី ការ គណៈ រដ្ឋ មន្ត្រី ដែល បាន ចូលរួម ក្នុង កិច្ច ប្រជុំ កាល ពី ថ្ងៃ សុក្រ បាន ឲ្យ ដឹង ថា ការ អនុវត្ត គោល នយោបាយ នេះ រយៈពេល ៣ ឆ្នាំ នេះ សម្រេច បាន ស្ទើរ ១០០ ភាគរយ ទៅ ហើយ ។
« ផែនការ នីមួយៗ សម្រេច បាន ៩០ ភាគរយ ប៉ុន្តែ ក៏ មាន ការ ពន្យារ ច្បាប់ ខ្លះ ដូចជា ច្បាប់ វិនិយោគ ថ្មី និង ច្បាប់ តំបន់ សេដ្ឋកិច្ច ពិសេស ដែល មិន សម្រេច បាន ទៅ តាម ផែនការ ផង ដែរ » ។
គោល នយោបាយ អភិវឌ្ឍន៍ ឧស្សាហកម្ម ត្រូវ បាន រដ្ឋាភិបាល ដាក់ ឲ្យ អនុវត្ត ចាប់ តាំង ពី ឆ្នាំ ២០១៥ ដែល មាន រយៈពេល ១០ ឆ្នាំ រហូត ដល់ ឆ្នាំ ២០២៥៕
ចក្ខុ វិស័យ របស់ យើង តែងតែ ត្រូវបាន ជំរុញ ឲ្យ អាស៊ី អាគ្នេយ៍ ឆ្ពោះ ទៅ មុខ ។
កាល ពី ៦ ខែ មុន ខ្ញុំ បាន ជួប លោក ស៊ុន ចាន់ថុល រដ្ឋ មន្ដ្រី ក្រសួង សាធារណការ និង ដឹក ជញ្ជូន ជា លើក ដំបូង ដើម្បី និយាយ អំពី របៀប ដែល ប្រទេស កម្ពុជា អាច ឆ្ពោះទៅមុខ ក្នុងការ ទទួលយក បច្ចេក វិទ្យា ថ្មី ។
នៅ ពេល នេះ យើង មាន សេចក្ដី សប្បាយរីករាយ យ៉ាងខ្លាំង ដែល បាន ចូល នៅ ក្នុង ភាព ជា ដៃគូ សហការ យូរ អង្វែង ។
ទី ១ នឹង កែលម្អ សុវត្ថិភាព ផ្លូវថ្នល់ ទី ២ នឹង ត្រួស ត្រាយ ផ្លូវ សម្រាប់ ការ រួម បញ្ចូល សេវា ហិរញ្ញវត្ថុ និង ទី ៣ នឹង កែលម្អ ការ គ្រប់គ្រង ចរាចរណ៍ ដែល សហការ ជាមួយ ក្រសួង ដោយ ប្រើប្រាស់ បច្ចេកវិទ្យា និង ទិន្នន័យ ដែល យើង មាន លើ កម្មវិធី របស់ យើង ។
ទាក់ទង នឹង សេវា ដែល យើង ផ្ដល់ យើង កំពុង ស្វែងរក ការ ផ្ដល់ សេវា រ៉ឺម៉ក ម៉ូតូ និង ម៉ូតូឌុប នៅ ទីនេះ ផង ដែរ ដោយ សារ តែ ប្រភេទ សេវា ទាំង នោះ ជួយ ធ្វើ ឲ្យ ប្រទេស កម្ពុជា ក្លាយ ជា ប្រទេស ដែល មាន សេវា នោះ ។
យើង ធ្លាប់ ប្រើ ពេលវេលា ច្រើន ជាង នេះ មុន ពេល យើង អាច ដំណើរ ការ ជា ផ្លូវ ការ ប៉ុន្តែ ដោយ សារ ចំណេះ ដឹង ផ្នែក ស្ថាប័ន ទាំង អស់ ដែល យើង បាន បង្កើត ឡើង នៅ ពេល នេះ យើង អាច បង្កើន ល្បឿន ដែល យើង អាច ចូល ក្នុង ទីក្រុង ថ្មីៗ ជាច្រើន បាន ។
តើ អ្នក នឹង ពិចារណា ការ ធ្វើ ជា ដៃគូ ជាមួយ កម្មវិធី ណា មួយ ក្នុងស្រុក ទាំងនេះ ទេ ?
ចំពោះ ពួក យើង ភាព ជា ដៃគូ គឺជា ផ្លូវ ឆ្ពោះ ទៅ មុខ ល្អ បំផុត ជា ពិសេស ប្រសិន បើ វា មាន ការ យល់ដឹង សម្រាប់ ដៃគូ ទាំងអស់ ដែល ចូលរួម ។
ប្រសិន បើ នរណា ម្នាក់ អាច ផ្ដល់ សេវា តម្លៃ កាន់ តែ ទាប កាន់ តែ មាន ប្រសិទ្ធភាព ជាង យើង នៅ ពេល នេះ យើង តែង តែ បើកចំហ ចំពោះ ភាពជា ដៃគូ ទោះបីជា យើង នឹង មិន ពិចារណា ការធ្វើជា ដៃគូ ជាមួយ ក្រុម ផ្សេងទៀត បើ ទីបំផុត ភាពជា ដៃគូ នឹងមិន បន្ថែម តម្លៃ ដល់ សេវា របស់ យើង ក៏ដោយ ។
ពិសេស ទោះបីជា វា ជា កិច្ច ព្រម ព្រៀង មួយ ដើម្បី ពង្រឹង ការ ប្ដេជ្ញា ចិត្ត របស់ យើង ប្រកប ដោយ និរន្តរភាព ក៏ ដោយ ក៏ ប្រធាន បទ ដ៏ សំខាន់ ច្បាស់ ណាស់ នឹង កាត់ បន្ថយ ឧស្ម័ន ផ្ទះ កញ្ចក់ និង ការ ពិភាក្សា របៀប ដែល យើង អាច ធ្វើបាន ប្រសើរ អំពី ការងារ នោះ ។
ដើម្បី ធានា ដល់ សុវត្ថិភាព ផ្លូវ ថ្នល់ យើង ត្រួតពិនិត្យ គ្រប់ អ្នក បើក បរ មុន ពេល ពួក គេ ត្រូវ បាន អនុញ្ញាត ឲ្យ បើក បរ សម្រាប់ កម្មវិធី របស់ យើង ។
យើង ត្រួត ពិនិត្យ រថយន្ត នីមួយៗ ផង ដែរ ដើម្បី ធានា ឲ្យ ប្រាកដ ថា វា ឆ្លើយតប នឹង ស្ដង់ដារ សុវត្ថិភាព ។
ការ ប្រើ ប្រាស់ ទិន្នន័យ និង បច្ចេកវិទ្យា GPS ដែល យើង តាម ដាន ឥរិយាបថ របស់ អ្នក បើកបរ ដូច្នេះ ប្រសិន បើ អ្នក បើកបរ របស់ យើង មិន មាន សុវត្ថិភាព យើង អាច បណ្ដុះ បណ្ដាល ជាថ្មី ដល់ ពួក គេ ឬ ស្នើ ឲ្យ ពួក គេ ចាក ចេញពី កម្មវិធី នេះ ។
