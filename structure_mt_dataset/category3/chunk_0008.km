ក្រុមហ៊ុន កែច្នៃ អង្ករ កម្ពុជា ត្រូវ បាន គេ មើល ឃើញ ថា មិន ទាន់ បាន បំពេញ តាម ស្តង់ដារ អនាម័យ និង ភូតគាម អនាម័យ ដើម្បី ឆ្លើយ តប តម្រូវ ការ ទីផ្សារ ក្រៅ ប្រទេស នៅ ឡើយ ទេ ។
អនុ រដ្ឋ លេខាធិការ ក្រសួង កសិកម្ម បាន លើក ឡើង ពី កិច្ច ប្រឹង ប្រែង របស់ រដ្ឋាភិបាល ដើម្បី ធ្វើ ឲ្យ ផលិតផល កសិកម្ម កម្ពុជា បំពេញ តាម ស្តង់ដារ ទាំង នេះ ។
ខាង ក្រោម នេះ ជា ការ សាក សួរ របស់ អ្នក យក ព័ត៌មាន ភ្នំពេញ ប៉ុស្តិ៍ ជាមួយ លោក ហ៊ាន វណ្ណហន អំពី បញ្ហា នេះ ។
គ្រាន់ តែ គុណភាព រូបរាង មិន មែន ជា អ្វី ដែល យើង ចរចា ជាមួយ រដ្ឋាភិបាល របស់ ប្រទេស ចិន ទេ ។
សត្វ ល្អិត ចង្រៃ អាច បំផ្លាញ វិស័យ កសិកម្ម នៅ ក្នុង ប្រទេស ចិន វា ត្រូវបាន ហាម ឃាត់ និង គ្រប់គ្រង យ៉ាង តឹងរ៉ឹង នៅ តាម ព្រំ ដែន របស់ ប្រទេស ចិន ។
គុណភាព ដែល ត្រូវ បាន បង្កើត ឡើង ដោយ រដ្ឋាភិបាល និង រដ្ឋាភិបាល ខុស គ្នា ពី គុណភាព ដែល បាន តម្រូវ ពី អ្នក ទិញ និង អ្នក លក់ ឬ ក្រុមហ៊ុន និង ក្រុមហ៊ុន ។
តើ ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ គួរ តែ ផ្ដោត លើ អ្វី ជា សំខាន់ ដើម្បី ឆ្លើយតប នឹង តម្រូវ ការ របស់ ប្រទេស ចិន ?
ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ គួរ តែ ផ្ដោត លើ ទាំង គុណភាព រូបរាង រូបវន្ត និង គុណភាព ផ្នែក SPS ដើម្បី ឆ្លើយ តប បាន តាម លក្ខណ វិនិច្ឆ័យ របស់ រដ្ឋាភិបាល ចិន និង គ្រប់ គ្រង លើ ហានិភ័យ ។
ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ ត្រូវ តែ អនុវត្ត តាម បញ្ជី ត្រួត ពិនិត្យ តាម ស្តង់ដារ ។
នេះ អាច ការពារ កេរ្ដិ៍ ឈ្មោះ ក្រុមហ៊ុន របស់ ពួកគេ បាន ។
ពួក គេ មាន ឯកសារ គ្រប់គ្រាន់ ក្នុងការ បញ្ជាក់ ថា ផលិតផល របស់ ពួកគេ គោរព តាម ស្តង់ដារ SPS ដែល យើង មិន អាច បដិសេធ ការនាំ ចូល បានទេ ប៉ុន្តែ នៅពេល យើង នាំចេញ យើង ចាំបាច់ ត្រូវមាន ឯកសារ ដើម្បី បង្ហាញ ដល់ ពួកគេ ដើម្បី ចូលក្នុង ទីផ្សារ របស់ ពួក គេ ប៉ុន្តែ សមត្ថភាព SPS របស់ យើង នៅ មាន កម្រិត ហើយ យើង ត្រូវការ ពេលវេលា ក្នុងការ បង្កើន សមត្ថភាព និង ពង្រឹង លើ ផ្នែក SPS នេះ ។
សក្តានុពលពាណិជ្ជកម្មអនឡាញ កម្ពុជានៅធំ នៅឡើយ
ការ រួម បញ្ចូល គ្នា ជាមួយ នឹង កម្រិត នៃ ការ ប្រើ ប្រាស់ ប្រព័ន្ធ ធនាគារ ទាប របស់ ប្រជាជន កង្វះ ចំណេះ ដឹង ឌីជីថល និង ប្រព័ន្ធ ទូទាត់ ប្រាក់ នៅ ពេល បញ្ជូន ទំនិញ (COD) បាន ធ្វើ ឲ្យ ការ ទូទាត់ តាម អន ឡាញ ជា អាទិភាព ទាប សម្រាប់ ក្រុមហ៊ុន ក្នុង ស្រុក ជាច្រើន និង អតិថិជន របស់ ពួក គេ ។
ទោះបី ជាមាន កិច្ចការ ជាច្រើន ត្រូវ បាន ធ្វើ ដោយ សហព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន វិទ្យា និង ទូរគមនាគមន៍ (ICT) និង ក្រសួង ទូរគមនាគមន៍ ក៏ ដោយ ក៏ យើង មាន អារម្មណ៍ ថា នៅ តែ មាន គម្លាត ដែល ប្រជាជន ប្រកាន់ ប្រពៃណី អនុវត្ត តាម តម្រាប់ ដូនតា របស់ ពួក គេ » ។
« ច្បាស់ ណាស់ យើង ទាំង អស់ គ្នា ចង់ រក ប្រាក់ និង ធ្វើ ឲ្យ ប្រាកដ ដល់ អាជីវកម្ម របស់ យើង ប៉ុន្តែ ជារួម យើង ចង់ ឲ្យ ប្រជាជន កម្ពុជា មិន គ្រាន់ តែ នៅ ក្នុង ទីក្រុង ភ្នំពេញ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ សម្រាប់ អ្នក នៅ តាម បណ្ដា ខេត្ត អាច យល់ដឹង ពី វិធី ងាយៗ ដល់ ប្រតិបត្តិការ សាច់ ប្រាក់ ជា រៀង រាល់ ថ្ងៃ » ។
« ពិត ហើយ ទីក្រុង ភ្នំពេញ នៅ ពេល នេះ កំពុង ឆ្ពោះ ទៅ មុខ ទាក់ទង នឹង ការ យល់ ដឹង របស់ ប្រជាជន នៃ អ្វី ដែល ពាណិជ្ជកម្ម អេឡិច ត្រូនិក និង អ្វីដែល វា ជា មធ្យោបាយ ទូទៅ ក្នុង ការ ប្រតិបត្តិការ ការទិញ ទំនិញ ឬ ការទិញ តាម អន ឡាញ ប៉ុន្តែ នៅ តាម ខេត្ត ស្ថានភាព គឺ នៅ តែ មិន ត្រូវ បាន អភិវឌ្ឍ ខ្លាំង នោះ ទេ » ។
សារៈ សំខាន់ ចំពោះ បញ្ហា នៃ ការ ទូទាត់ តាម អន ឡាញ គឺ ច្បាប់ ពាណិជ្ជកម្ម អេឡិចត្រូនិក ដែល ពន្យារ ពេល ជា យូរ ត្រូវ បាន រំពឹង ថា នឹង ដាក់ ជូន រដ្ឋ សភា នៅ អំឡុង ពេល ឆ្នាំ ២០១៧ គឺ មាន រយៈពេល ៨ ឆ្នាំ បន្ទាប់ ពី ច្បាប់ នេះ ត្រូវ បាន ប្រកាស ជា លើក ដំបូង ។
លោក Kagay មើល ឃើញ ការ អនុម័ត ច្បាប់ នេះ ជា ផ្នែក មួយ ដ៏ សំខាន់ សម្រាប់ ជំរុញ ការ ទូទាត់ តាម អន ឡាញ ការពារ អតិថិជន និង ក្រុមហ៊ុន ព្រម ទាំង កាត់ បន្ថយ ភាព មិន ច្បាស់ លាស់ ជុំវិញ ពាណិជ្ជកម្ម អេឡិច ត្រូនិក ដែល មាន បច្ចុប្បន្ន ។
លោក បាន ពន្យល់ ថា ក្រុមហ៊ុន ទូរគមនាគមន៍ ផ្សេង ទៀត បាន ប្រតិបត្តិការ តាម រយៈ ការ ទូទាត់ ដោយ ផ្អែក លើ ក្រដាស ស្នាម ដែល តម្រូវ ឲ្យ មាន បណ្ដាញ ភ្នាក់ងារ ដ៏ ធំ ទូទាំង ប្រទេស ដែល ចែក ចាយ កាត កោស ដល់ អតិថិជន សម្រាប់ ការ ទូទាត់ ហើយ នេះ ជា អ្វីដែល Sabay កំពុង ចៀស វាង ។
លោក បន្ថែម ថា ទំនុក ចិត្ត ដែល កំពុង កើន ឡើង នៅក្នុង គ្រឹះស្ថាន ហិរញ្ញវត្ថុ របស់ ប្រទេស នេះ កំពុង បង្កើន ចំនួន មូលនិធិ ដែល អាច ត្រូវបាន ប្រើប្រាស់ សម្រាប់ ការទូទាត់ តាមរយៈ ឌីជីថល ។
លោក បន្ថែម ថា តួលេខ នេះ រួមបញ្ចូល ទាំង ប្រាក់ បញ្ញើ បុគ្គល និង ក្រុមហ៊ុន ។
លោក បញ្ជាក់ ថា លើស ពី នេះ ដំណើរ ការ អនុវត្ត ប្រព័ន្ធ ទូទាត់ តាម អន ឡាញ សម្រាប់ ក្រុមហ៊ុន ជាមួយ ធនាគារ អេស៊ីលីដា មាន រយៈពេល វែង និង មាន បញ្ហា បច្ចេកទេស ដែល ធ្វើ ឲ្យ ក្រុម ហ៊ុន តូចៗ មានការ ពិបាក ក្នុង ការ មាន លទ្ធភាព ប្រើប្រាស់ ប្រព័ន្ធ ដូច នោះ ។
យោង តាម លោក នរិន្ទដា ការងារ កែលម្អ កំពុង ត្រូវ បាន អនុវត្ត ជា ផ្នែក មួយ នឹង ការ វិនិយោគ មាន តម្លៃ ២ ពាន់ លាន ដុល្លារ ដើម្បី អភិវឌ្ឍ ព្រលាន យន្ត ហោះ អន្តរជាតិ ៣ របស់ កម្ពុជា រហូត ដល់ ឆ្នាំ ២០៤០ ។
ការងារ កែ លម្អ នេះ ក៏ ដើម្បី ពង្រីក ផ្លូវ រត់ ប្រវែង ២ ៥០០ ម៉ែត្រ របស់ ព្រលាន នេះ ដើម្បី កែលម្អ សមត្ថភាព ផ្នែក នៃ ព្រលាន យន្ត ហោះ និង ការ សម្រួល ដល់ យន្តហោះ ធំៗ » ។
វិធានការបន្ថយបំណុលក្រិក អាចកើតមាននៅខែក្រោយ
«ខ្ញុំ បាន ទទួល លិខិត មួយ ដែល សហការី ក្រិក របស់ ខ្ញុំ បាន បញ្ជាក់ អំពី ការ ប្តេជ្ញា ចិត្ត ចំពោះ កិច្ចព្រមព្រៀង កន្លង មក»។
ការ ប្រកាស ទាំង នេះ បាន ធ្វើ ឲ្យ រដ្ឋាភិបាល ក្រុង ប៊ែរឡាំង ខឹងសម្បា ហើយ ក៏ បាន បង្ហាញ ឲ្យ ឃើញ ពី ការ បែកបាក់ គ្នា ផង ដែរ នៅ តំបន់ អឺរ៉ូ ដោយ ប្រទេស បារាំង ការពារ ទង្វើ របស់ ក្រុង អាថែន ក្នុង សកម្មភាព ប្រឆាំង ដ៏កម្រ មួយ។
ការ កាត់ បន្ថយ បំណុល ដែល ស្ថិត ក្នុង មន្ទិល សង្ស័យ នេះ ត្រូវ បាន ឯកភាព ដោយ ក្រុម រដ្ឋមន្រ្តី របស់ តំបន់ អឺរ៉ូ កាលពី ថ្ងៃ ទី ៥ ខែ ធ្នូ៕
អ្នក នាំ ពាក្យ ក្រុមហ៊ុន បាន ឲ្យ ដឹង កាលពី ម្សិល មិញ ថា ៖
អ្នក នាំ ពាក្យ រូប នោះ បញ្ជាក់ ថា ៖
ថៃបង្កើតទីផ្សារកណ្តាលសម្រាប់ជួញដូរអង្ករ
កាល ពី ថ្ងៃ ម្សិល មិញ រដ្ឋាភិបាល ថៃ បាន បង្ហាញ ពី ផែនការ បង្កើត ទីផ្សារ កណ្ដាល ដែល ជា បណ្ដាញ ចែក ចាយ មួយ សម្រាប់ ពាណិជ្ជករ អង្ករ និង កសិករ បន្ទាប់ ពី ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ និង ក្រុមហ៊ុន នាំ ចេញ បាន យល់ ព្រម លើ សំណើ នេះ ។
នៅ ក្នុង ជំហាន បន្ទាប់ ក្រសួង ពាណិជ្ជកម្ម ថៃ នឹង អំពាវនាវ ឲ្យ មាន កិច្ច ប្រជុំ ផ្សេង ទៀត ជាមួយ ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ និង ក្រុម ហ៊ុន នាំ ចេញ ដើម្បី ពិភាក្សា អំពី ផែនការ វិនិយោគ ការ រៀបចំ ទីផ្សារ ទីតាំង ការ ដឹក ជញ្ជូន និង ប្រព័ន្ធ ទូទាត់ ។
ទីផ្សារ ដូច នេះ នឹង អាច ឲ្យ ក្រុមហ៊ុន នាំ ចូល ក្រុមហ៊ុន លក់ ដុំ និង ក្រុមហ៊ុន លក់ រាយ ទៅ ទិញ អង្ករ ខុសៗ គ្នា ។
បច្ចុប្បន្ន ប្រទេស ថៃ មាន តែ ទីផ្សារ កណ្ដាល សម្រាប់ ស្រូវ ប៉ុណ្ណោះ ។
លោក ស្រី ឲ្យ ដឹង ថា វត្តមាន ទីផ្សារ កណ្ដាល សម្រាប់ អង្ករ នឹង ពង្រឹង បន្ថែម ទៀត ដល់ សេដ្ឋកិច្ច ក្នុង ស្រុក ដូច ដែល រដ្ឋាភិបាល បាន គ្រោង ទុក ។
ទីស្ដីការ គណៈ រដ្ឋ មន្ដ្រី ថៃ ថ្មីៗ នេះ បាន អនុម័ត សំណើ របស់ ការិយាល័យ ថវិកា ដើម្បី លៃ ទុក មូលនិធិ ពាក់ កណ្ដាល ឆ្នាំ បន្ថែម ទៀត សម្រាប់ សារពើពន្ធ ឆ្នាំ ២០១៧ មាន តម្លៃ ១៩០ ពាន់ លាន បាត ។
គម្រោង ទឹក ប្រាក់ ប្រហែល ៥០ ម៉ឺន បាត សម្រាប់ ក្នុង មួយ ភូមិ ត្រូវ បាន រៀបចំ ឲ្យ ស្ថិត ក្រោម ផែន ការ នេះ ។
សំណើ នេះ នឹង ត្រូវ បាន ដាក់ ឲ្យ ពិនិត្យ នៅក្នុង ខែ មករា សម្រាប់ ការ ត្រួត ពិនិត្យ ដោយ សភា ។
ចេញ សេចក្តី ប្រកាស ព័ត៌មាន ចេញ ផ្សាយ កាលពី ថ្ងៃ ម្សិលមិញ បាន ពន្យល់ អំពី បន្ទុក បំណុល ជាក់ ស្តែង ដែល កម្ពុជា ជាប់ ជំពាក់ បរទេស គឺមាន ចំនួន ៥,៦ ពាន់ លាន ដុល្លារ គិត ត្រឹម ឆ្នាំ ២០១៥ ហើយ បាន អះអាង ថា ជា ទំហំ សុវត្ថិភាព និង អាច គ្រប់គ្រង បាន ។
ការ ចេញ សេចក្តី ប្រកាស ព័ត៌មាន នេះ បាន ធ្វើ ឡើង បន្ទាប់ពី បណ្តាញ ព័ត៌មាន ក្នុង ស្រុក មួយ ចំនួន កាល ពី ពេល ថ្មីៗ នេះ បាន ផ្សព្វផ្សាយ ថា បន្ទុក បំណុល បរទេស របស់ រដ្ឋាភិបាល កម្ពុជា បាន កើន ដល់ ជិត ១០ ពាន់ លាន ដុល្លារ នៅ ត្រឹម ដំណាច់ ឆ្នាំ ២០១៥ ដែល ជា អ្វី ដែល ក្រសួង បាន ចាត់ ទុក ថា មាន ការ បកស្រាយ ខុស អត្ថន័យ បច្ចេកទេស ស្តីពី « បំណុល ក្រៅ ប្រទេស » ។
យោង តាម ព័ត៌មាន ពី ក្រសួង សេដ្ឋកិច្ច ក្នុង ចំណោម បំណុល ក្រៅ ប្រទេស ជិត ១០ ពាន់ លាន ដុល្លារ បំណុល ដែល ខ្ចី ដោយ ស្ថាប័ន ឯកជន មាន ជិត ៤ ពាន់ លាន ដុល្លារ ដែល ទំហំ នេះ គឺជា ការ ទទួល ខុស ត្រូវ របស់ ស្ថាប័ន ឯកជន សុទ្ធសាធ មិន ពាក់ព័ន្ធ នឹង រដ្ឋាភិបាល នោះ ទេ ។
« រាជរដ្ឋាភិបាល បាន និង កំពុង គ្រប់គ្រង បំណុល សាធារណៈ ប្រកប ដោយ ស្មារតី ប្រយ័ត្ន ប្រយែង ខ្ពស់ » ។
ព័ត៌មាន ពី ខាង ក្រសួង សេដ្ឋកិច្ច ក៏ បាន បញ្ជាក់ បន្ថែម ថា រដ្ឋាភិបាល តែង ទទួល កម្ចី ដោយ ប្រកាន់ យ៉ាង ម៉ឺងម៉ាត់ នូវ គោល ការណ៍ គន្លឹះ ទាំង ៤ រួម មាន ការ ទទួល កម្ចី ក្នុង ទំហំ សម ស្រប តាម ស្ថានភាព ថវិកា និង សេដ្ឋកិច្ច ទទួល កម្ចី ដែល មាន អត្រា ការ ប្រាក់ ទាប និង លក្ខខណ្ឌ អនុគ្រោះ ខ្ពស់ សម្រាប់ អភិវឌ្ឍន៍ វិស័យ អាទិភាព ដើម្បី បង្កើន ផលិតភាព សេដ្ឋកិច្ច និង តែង ប្រើប្រាស់ កម្ចី ដោយ តម្លាភាព និង ប្រសិទ្ធ ភាព ។
«បន្ទាប់ពី រយៈពេល ប៉ុន្មាន ឆ្នាំ នៃ ការ ចរចា ដើម្បី ឈាន ទៅ ដល់ កិច្ចព្រមព្រៀង ដែល គ្របដណ្តប់ លើ ការ ប្រើប្រាស់ ប៉ាតង់ ទាំង នេះ ពី សំណាក់ ក្រុមហ៊ុន Apple ឥឡូវ នេះ យើង កំពុង តែ ចាត់ វិធានការ ដើម្បី ការពារ សិទ្ធិ របស់ យើង»។
ទីភ្នាក់ងារ នេះ បន្ត ថា៖
កោះ តៃវ៉ាន់ បាន ដាក់ ពាក្យ បណ្តឹង កាលពី ឆ្នាំ ២០១៤ ប្រឆាំង នឹង ប្រទេស កាណាដា ជុំវិញ ការ យក ពន្ធ លើ ដែក បំពង់ ទីប ដែល រដ្ឋាភិបាល ក្រុង អូតាវ៉ា បាន អះអាង ថា ត្រូវ បាន ទម្លាក់ ទាប ជាង តម្លៃ ទីផ្សារ របស់ ខ្លួន។
គណៈកម្មាធិការ មួយ របស់ អង្គការ WTO ដែល ត្រូវ បាន បង្កើត ឡើង នៅ ឆ្នាំ ២០១៥ ដើម្បី ដោះស្រាយ វិវាទ នេះ បាន រកឃើញ ថា វិធានការ ជាច្រើន របស់ ប្រទេស កាណាដា បាន រំលោភ ទៅ លើ ច្បាប់ ពាណិជ្ជកម្ម អន្តរជាតិ។
អង្គការ WTO ដែល ត្រួតត្រា លើ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សកលលោក និង ត្រូវ បាន ទាមទារ ឲ្យ ផ្តល់ ឱកាស ស្មើ គ្នា ទៅ ឲ្យ ប្រទេស ជា សមាជិក ទាំង ១៦៤ របស់ ខ្លួន បាន ជំរុញ កាណាដា ឲ្យ «អនុវត្ត វិធានការ របស់ ខ្លួន ដោយ អនុលោម តាម កាតព្វកិច្ច របស់ ខ្លួន»។
កោះ តៃវ៉ាន់ និង កាណាដា មាន រយៈពេល ៦០ ថ្ងៃ ដើម្បី ដាក់ បណ្តឹង ឧទ្ធរណ៍។
ស្ថាប័ន ដោះស្រាយ វិវាទ របស់ អង្គការ WTO ដែល បណ្តុំ ទៅ ដោយ អ្នក ជំនាញ ផ្នែក ពាណិជ្ជកម្ម និង ច្បាប់ មាន អំណាច ចាត់ ឡើង នូវ វិធានការ តបត ក្នុង ពាណិជ្ជកម្ម ប្រឆាំង ទៅ នឹង ប្រទេស ណា មួយ ដែល ខ្លួន រកឃើញ ថា បាន ធ្វើ ខុស។
សំណុំ រឿង វិវាទ ជា ញឹកញាប់ ចំណាយ ពេល ជាច្រើន ឆ្នាំ ដើម្បី ដោះស្រាយ៕
ការ សម្រេច ចិត្ត នេះ ត្រូវ បាន ធ្វើ ឡើង ដោយ ក្រុម ប្រឹក្សា ភិបាល របស់ ធនាគារ នេះ នៅ ថ្ងៃ ពុធ។
នៅ ពេល បញ្ចប់ គម្រោង នេះ នឹង ដឹក ជញ្ជូន ឧស្ម័ន ធម្មជាតិ ពី អណ្ដូង ឧស្ម័ន នៅក្នុង ប្រទេស អាស៊ែបៃហ្សង់ កាត់ តាម ប្រទេស តួកគី បន្ទាប់ មក បន្ត ទៅ ទីផ្សារ នៅ ក្នុង តំបន់ អឺរ៉ុប ខាង ត្បូង ។
ការ សាងសង់ បំពង់ បង្ហូរ ឧស្ម័ន នេះ នឹង បង្កើត ការងារ នៅក្នុង ប្រទេស អាស៊ែបៃហ្សង់ និង ប្រទេស តួកគី ។
ការ អនុម័ត កម្ចី នឹង ធ្វើ ឲ្យ ឥណទាន សរុប ដែល ធនាគារ នេះ បាន បញ្ចេញ នៅ ក្នុង ឆ្នាំ ប្រតិបត្តិការ ដំបូង របស់ ខ្លួន កើនឡើង ដល់ ទៅ ១,៧៣ ពាន់ លាន ដុល្លារ នៅក្នុង គម្រោង ហេដ្ឋារចនាសម្ព័ន្ធ ចំនួន ៩ នៅក្នុង ប្រទេស ចំនួន ៧។
សេដ្ឋីចិន ផ្លាស់រោងចក្រមួយផ្នែកទៅអាមេរិក
នេះ បើ យោង តាម អ្នក រកស៊ី នៅក្នុង ឧស្សាហកម្ម នេះ ។
ការ រៀបចំ នេះ មិន ដំណើរការ បាន ល្អ ទេ ដែល បណ្ដាល ឲ្យ ក្រុមហ៊ុន នេះ បញ្ឈប់ ជើង ហោះហើរ នៅ មជ្ឈិមបូព៌ា ទាំងអស់។
អឺរ៉ុបស្នើពង្រីកកិច្ចព្រមព្រៀងពាណិជ្ជកម្មជា មួយតួកគី
គណៈកម្មការ អឺរ៉ុប ដែល ជា ស្ថាប័ន នីតិ ប្រតិបត្តិ ក្នុង សហភាព អឺរ៉ុប បាន ឲ្យ ដឹង ថា ការ ធ្វើ បច្ចុប្បន្នភាព លើ ទំនាក់ ទំនង ពាណិជ្ជកម្ម នឹង ធ្វើ ឡើង ស្រប គ្នា ជាមួយ នឹង កិច្ចព្រមព្រៀង ដ៏ ផុយស្រួយ កាលពី ខែ មីនា ដែល តម្រូវ ឲ្យ ប្រទេស តួកគី ទប់ស្កាត់ ជនអន្តោប្រវេសន៍ ដែល ចូល មក ក្នុង តំបន់ អឺរ៉ុប។
គណៈកម្មការ អឺរ៉ុប បាន ឲ្យ ដឹង ថា ខ្លួន បាន ស្នើសុំ ក្រុម ប្រឹក្សា អឺរ៉ុប នូវ អំណាច មួយ ដើម្បី ធ្វើ ការ ចរចា ជាមួយ នឹង ប្រទេស តួកគី ដើម្បី ធ្វើ ទំនើប នីយកម្ម លើ សហភាព ពន្ធគយ ដែល មាន អាយុកាល ជាង ២ ទសវត្សន៍ នេះ។
គណៈកម្មការ នេះ បាន ឲ្យ ដឹង នៅក្នុង សេចក្តី ថ្លែងការណ៍ មួយ ថា៖
«តាមរយៈ ការ ធ្វើ សេចក្តី ស្នើសុំ នេះ គណៈកម្មករ សូម បន្ត ធ្វើ តាម ការ ប្តេជ្ញា ចិត្ត ដែល ខ្លួន បាន ធ្វើ ឡើង»។
គណៈកម្មការ បន្ថែម ថា៖
«ការ ធ្វើ ទំនើប នីយកម្ម លើ សហភាព ពន្ធគយ ដើម្បី ឆ្លុះ បញ្ចាំង ពី ទំនាក់ ទំនង ពាណិជ្ជកម្ម រវាង សហភាព អឺរ៉ុប និង តួកគី នឹង នាំ មក នូវ អត្ថប្រយោជន៍ សេដ្ឋកិច្ច យ៉ាងច្រើន ទៅ ដល់ ដៃគូ ទាំង ពីរ»។
ស្ថាប័ន នេះ បន្ត ថា៖
« ការ ធ្វើ ទំនើប នីយកម្ម និង ការ បន្លាយ ពេល ការ អនុវត្ត សហភាព ពន្ធគយ នេះ អាច នឹង ផ្តល់ នូវ ឱកាស បន្ថែម ទៀត សម្រាប់ បណ្តា ក្រុមហ៊ុន អឺរ៉ុប ក្នុង វិស័យ កសិកម្ម ចំនី អាហារ សេវាកម្ម ក៏ ដូចជា ទីផ្សារ លទ្ធកម្ម សាធារណៈ»។
ផ្អែក តាម គណៈកម្មការ អឺរ៉ុប តួកគី គឺជា ដៃគូ ធំ ទី ប្រាំ របស់ អឺរ៉ុប ហើយ សហភាព អឺរ៉ុប គឺជា ដៃគូ ពាណិជ្ជកម្ម ចម្បង របស់ ប្រទេស តួកគី៕
ទ្រី ភាព ដាក់សំណើ $៤០០ លានបង្កើតរោងចក្រចម្រាញ់ប្រេង និងកំពង់ផែអន្តរជាតិ
លោក សំ សេរី រ័ត្ន អនុ រដ្ឋ លេខាធិការ ក្រសួង ពាណិជ្ជកម្ម បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា តំបន់ សេដ្ឋកិច្ច ថ្មី ដែល មាន តម្លៃ ៤០០ លាន ដុល្លារ ស្ថិត នៅ ក្នុង ស្រុក ទឹក ឈូ ខេត្ត កំពត លើ ផ្ទៃដី ទំហំ ២៦៨ ហិកតា កំពុង ត្រូវ បាន សាងសង់ យ៉ាង រហ័ស ទោះ បីជា មិន មាន ការ យល់ ព្រម ជា ផ្លូវ ការ ក៏ ដោយ ។
លោក ទ្រី ភាព ដែល ល្បីល្បាញ ខាង ជំនួញ ឈើ និង ត្រូវ បាន រិះគន់ ថា បាន រួម ចំណែក ធ្វើ ឲ្យ ហិន ហោច ព្រៃឈើ នៅ កម្ពុជា នោះ ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុង ក្រោយ នេះ បាន បង្វែរ ពី អាជីវកម្ម ឈើ ទៅ វិនិយោគ ផ្សេងៗ ជាច្រើន ទៀត ដូចជា វិស័យ ថាមពល ជាដើម ។
« ក្រុមហ៊ុន កំពុង ដំណើរ ការ សាងសង់ តំបន់ សេដ្ឋកិច្ច ពិសេស និង រោងចក្រ ចម្រាញ់ ប្រេង លើ ផ្ទៃដី ៥១ ហិកតា » ។
« យើង គ្រាន់តែ ត្រូវបាន ប្រគល់ ភារកិច្ច ឲ្យ ត្រួត ពិនិត្យ ទីតាំង វិនិយោគ នេះ ថា តើ វា បាន ត្រៀម ខ្លួន ហើយ ឬទេ ?
ប៉ុន្តែ ប្រធាន កិច្ចការ ក្រុមហ៊ុន បាន ឲ្យ ដឹង តាម អ៊ីមែល ថា ៖
ចំណែក ឯ រោងចក្រ ចម្រាញ់ ប្រេង ទំនាក់ ទំនង របស់ លោក ទ្រី ភាព ហាក់ ដូច ជា កាន់ តែ ជ្រៅ នៅ ពេល ទាក់ទាញ ក្រុម វិនិយោគិន ដ៏ មាន សក្ដានុពល ។
មិន អាច ទាក់ទង លោក ឌិត ទីណា អ្នក នាំ ពាក្យ ក្រសួង រ៉ែ និង ថាមពល ដែល គ្រប់គ្រង លើ សំណើ សុំ ការ អនុញ្ញាត អាជីវកម្ម ប្រេង រោងចក្រ ចម្រាញ់ បាន ទេ ។
ប៉ុន្តែ លោក ម៉េង ស័ក្ត ធារ៉ា អ្នក នាំ ពាក្យ ក្រសួង បាន ឲ្យ ដឹង ថា លោក មិន បាន ដឹង ពី ការ ស្វែង រក ការ យល់ ព្រម ពី រដ្ឋាភិបាល របស់ ក្រុមហ៊ុន ទ្រី ភាព ដើម្បី សាងសង់ រោងចក្រ ចម្រាញ់ ប្រេង នេះ ទេ ។
លោក សែម សុធា ប្រធាន ខុទ្ទកាល័យ ខេត្ត កំពត បាន ឲ្យ ដឹង ថា ក្រុមហ៊ុន កំពុង ឈូស ឆាយដី យ៉ាង រហ័ស និង កំពុង សាងសង់ ស៊ីទែន ស្តុក ប្រេង យ៉ាង លឿន គួរ ឲ្យ ចាប់ អារម្មណ៍ ។
ក្រសួងរឹតបន្តឹងលើអាជីវកម្ម គ្រឿងអលង្ការ
សេចក្តី ជូន ដំណឹង នេះ ធ្វើ ឡើង បន្ទាប់ ក្រសួង បាន ទទួល ដំណឹង ពី ករណី ក្លែង បន្លំ និង ឆបោក មួយ ចំនួន ពី ក្រុម ពាណិជ្ជករ ទៅ អតិថិជន ហើយ បារម្ភ ថា ករណី នោះ អាច ប៉ះពាល់ ដល់ កេរ្តិ៍ ឈ្មោះ របស់ អាជីវកម្ម នេះ ប្រសិន បើ មិន មាន វិធានការ កែ លម្អ ណា មួយ ។
សេចក្តី ជូន ដំណឹង របស់ ក្រសួង ពាណិជ្ជកម្ម ដែល ចេញ ផ្សព្វផ្សាយ កាលពី ម្សិលមិញ បាន ព្រមាន ថា អាជីវករ ទាំង ឡាយ ណា ដែល លក់ ដូរ ឬ ផ្សព្វផ្សាយ ពាណិជ្ជកម្ម គ្រឿង អលង្ការ ត្បូង មាន តម្លៃ និង វត្ថុ អនុស្សាវរីយ៍ ដោយ មានការ ក្លែងបន្លំ ដល់ អ្នក ប្រើ ប្រាស់ ត្រូវ ចាត់ ទុក ជា បទ ល្មើស ហើយ ត្រូវ ទទួល ទណ្ឌកម្ម ជាក់ ស្តែង ទៅតាម ប្រភេទ នៃ បទល្មើស ក្នុង ច្បាប់ ស្តីពី សុវត្ថិភាព លើ ផលិតផល ទំនិញ និង សេវា ។
អ្នក ស្រី សឹង សុផារី អ្នក នាំ ពាក្យ ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា បាន លើក ឡើង ថា កន្លង មក មាន ករណី ឆបោក មួយ ចំនួន ទៅ លើ ភ្ញៀវ ក្នុង ស្រុក និង ភ្ញៀវ បរទេស ដោយ ម្ចាស់ ហាង មួយ ចំនួន បាន លក់ គ្រឿង អលង្ការ និង ត្បូង មាន តម្លៃ ក្នុង តម្លៃ ខ្ពស់ តែ ផ្តល់ ជូន ផលិតផល ទៅ អតិថិជន ដោយ គ្មាន គុណភាព ។
« មាន ករណី មួយ ចំនួន ភ្ញៀវ ទេសចរ បរទេស ត្រូវ គេ បន្លំ ប្រាក់ រាប់ ម៉ឺន ដុល្លារ ។
« វិធានការ នេះ ជា ចំណែក មួយ រក្សា កេរ្តិ៍ ឈ្មោះ ប្រទេស តាម រយៈ ការពង្រឹង តម្លាភាព ក្នុង អាជីវ កម្ម នេះ ដើម្បី ការពារ អត្ថប្រយោជន៍ ភ្ញៀវ ទេសចរ ក៏ ដូច ជា អ្នក ប្រើ ប្រាស់ ក្នុង ស្រុក » ។
យោង តាម ការ អះអាង ពី តំណាង ក្រសួង ពាណិជ្ជកម្ម សកម្មភាព ត្រួត ពិនិត្យ របស់ ក្រសួង នឹង មិន ប៉ះពាល់ ដល់ ដំណើរការ អាជីវកម្ម របស់ អាជីវករ ទេ ហើយ រំពឹង ថា បន្ទាប់ ពី ក្រសួង ធ្វើ កិច្ចការ នេះ ក្រុម ការងារ នឹង មាន លទ្ធភាព គ្រប់គ្រង ទិន្នន័យ បាន ច្បាស់ លាស់ ជាង មុន ដើម្បី ងាយ ស្រួល ក្នុង ការ គ្រប់គ្រង ។
សេចក្តី ជូន ដំណឹង របស់ ក្រសួង ពាណិជ្ជកម្ម បាន លើក ឡើង ថា មន្ត្រី ជំនាញ របស់ អគ្គនាយក ដ្ឋាន កាំកុង ត្រូល នឹង ចាប់ ផ្តើម ចុះ ត្រួត ពិនិត្យ សុចរិត ភាព របស់ អាជីវករ លក់ គ្រឿង អលង្ការ និង ត្បូង មាន តម្លៃ ហើយ តម្រូវ ឲ្យ អាជីវករ លក់ដូរ និង ផ្សព្វផ្សាយ ផលិតផល របស់ ខ្លួន ដោយ ផ្អែកលើ ព័ត៌មាន ពិតប្រាកដ និង ត្រូវ ចេញ វិក្កយបត្រ បរិយាយ ពី គុណភាព ផលិតផល និង ខ្លឹម សារ ជាក់ លាក់ ដល់ អ្នក ប្រើប្រាស់ ។
បន្ថែម លើ នេះ អាជីវករ ត្រូវ បិទ ស្លាក ថ្លៃ លើ គ្រឿង អលង្ការ ត្បូង និង វត្ថុ អនុស្សាវរីយ៍ មាន តម្លៃ ឲ្យ បាន ត្រឹម ត្រូវ សម្រាប់ អតិថិជន ។
ម្ចាស់ ហាង លក់ គ្រឿង អលង្ការ នៅ ភ្នំពេញ ជាច្រើន ដែល ភ្នំពេញ ប៉ុស្តិ៍ បាន សាកសួរ កាលពី ម្សិលមិញ បាន ស្វាគមន៍ ចំពោះ វិធានការ របស់ ក្រសួង ពាណិជ្ជកម្ម នេះ ដោយ រំពឹងថា នឹង បង្កើន ទំនួល ខុសត្រូវ របស់ ពាណិជ្ជករ និង តម្លាភាព ក្នុង ពាណិជ្ជ កម្មនេះ ។
ប៉ុន្តែ ទន្ទឹមនេះ ពួកគេ ក៏បាន លើកឡើង ពី បញ្ហា ប្រឈម ដែរ ។
លោក សំ ប៊ុន ណា ម្ចាស់ ហាង លក់ គ្រឿង អលង្ការ សុវណ្ណ សម្ឆស្ស មាន ទីតាំងនៅ ភ្នំពេញ បាន លើក ឡើង ថា ខណៈ ដែល ទីផ្សារ គ្រឿង អលង្ការ កំពុង កើន ឡើង ការ ក្លែង បន្លំ ផលិតផល នេះ ក៏ កើត មាន កាន់ តែ ច្រើន ក្នុង អាជីវកម្ម នេះ ដែល កត្តា នេះ ទាមទារ ឲ្យ មាន ការ ត្រួត ពិនិត្យ ច្បាស់ លាស់ និង ត្រឹម ត្រូវ ។
« យើង ជា អ្នក រក ស៊ី ត្រឹម ត្រូវ និង ស្មោះត្រង់ ចំពោះ អតិថិជន អ៊ីចឹង យើង ចង់ ឲ្យ អ្នក គ្រប់ គ្នា ស្មោះត្រង់ ដូចគ្នា ។
ខ្ញុំ ស្វាគមន៍ នឹង សហការ ជាមួយ ក្រសួង ដើម្បី ធ្វើ ការងារ នេះ ដើម្បី ពង្រឹង ទំនុក ចិត្ត ដល់ អតិថិជន » ។
លោក ខោល វុន អាជីវករ លក់ គ្រឿង អលង្ការ ម្នាក់ ទៀត បាន អះអាង ស្រដៀង គ្នា តែ បាន លើក ឡើង ថា ដោយ សារ តម្លៃ គ្រឿង អលង្ការ ឬ មាស ជាដើម តែង មាន ការ ប្រែប្រួល លឿន ក្នុង មួយ ថ្ងៃ ដូច្នេះ ការ តម្រូវ ឲ្យ អាជីវករ បិទ ស្លាក ថ្លៃ លើ គ្រឿង អលង្ការ ត្បូង ជា ប្រចាំ គឺ បញ្ហា ប្រឈម ។
ខណៈ លោក នឹង សហការ ជាមួយ ក្រសួង លោក វុន លើក ជា ការ បារម្ភ ទាក់ទង នឹង និរន្តរភាព នៃ ការ អនុវត្ត ។
ប្រទេស បេឡារុស ក៏ កំពុង ស្វែង រក អ្នក ផ្គត់ ផ្គង់ កៅស៊ូ ធម្ម ជាតិ របស់ កម្ពុជា ផង ដែរ ខណៈ ដែល ការ ផ្គត់ ផ្គង់ ពី វៀតណាម ទៅ កាន់ ប្រទេស នេះ មិន គ្រប់ គ្រាន់។
នេះ បើ តាម ព័ត៌ មាន ពី ក្រសួង ពាណិជ្ជ កម្ម កម្ពុជា ។
ក្រុមហ៊ុនមូលបត្រ យាន់តា ត្រូវបានចុះឈ្មោះជាសមាជិកសន្ទនីយភាពមូលបត្រ
អនុបាត ប្រាក់ ចំណេញ សរុប បាន ថយ ចុះ នៅ ទូទាំង ក្រុមហ៊ុន នៅ ក្នុង ត្រីមាស ទី ២។
ប្រទេស ថៃ ចង់ ទាក់ទាញ ក្រុម វិនិយោគិន ចិន កាន់តែ ច្រើន នៅ ក្នុង ឧស្សាហកម្ម ជា ទិសដៅ ទាំង ១០ ដែល ខ្លួន មាន បំណង ក្នុង ការ លើក កម្ពស់ ដែល រំពឹង ថា ការ ផ្ទេរ បច្ចេកវិទ្យា ថ្មី អាច ជួយ កែលម្អ ឧស្សាហកម្ម របស់ ប្រទេស ថៃ បាន ។
លោកស្រី បន្ថែម ថា ឧស្សាហកម្ម របស់ ប្រទេស ចិន មួយ ចំនួន បាន ចាប់ អារម្មណ៍ ក្នុង ការ ចាប់ផ្ដើម ការ វិនិយោគ ក្នុង ប្រទេស ថៃ គឺ ជីវគីមី មនុស្សយន្ត វិស័យ ឌីជីថល និង គ្រឿងចក្រ បច្ចេកវិទ្យា ខ្ពស់ ។
ប្រទេស ថៃ រំពឹង ថា ការ ផ្ទេរ បច្ចេកវិទ្យា នឹង ជួយ លើក កម្ពស់ រោងចក្រ ផលិត រថយន្ត អគ្គិសនី។
លោក ថ្លែង ក្នុង សន្និសីទ មួយ ថា៖
« យើង ជឿជាក់ យ៉ាង រឹងមាំ ថា ការ ផ្លាស់ប្តូរ ឆ្ពោះ ទៅ គំរូ អាជីវកម្ម សូហ្វវែរ នឹង មាន ភាព វិជ្ជមាន សម្រាប់ កំណើន ប្រាក់ ចំណូល ដែល កំពុង កើនឡើង ប្រាក់ ចំណេញ ប្រកប ដោយ ស្ថិរភាព និង តម្លៃ ភាគទុនិក រួម » ។
ក្រុមហ៊ុន នេះ បាន ឲ្យ ដឹង កាលពី ខែ កញ្ញា ថា ខ្លួន កំពុង ចាកចេញ ពី អាជីវកម្ម ផលិត ទូរស័ព្ទ ស្មាតហ្វូន ដែល ខ្លួន ធ្លាប់ បាន នាំ មុខ គេ ។
ផ្ទុយ ទៅ វិញ ក្រុមហ៊ុន បាន ចុះ កិច្ចព្រមព្រៀង ជាមួយ ក្រុមហ៊ុន ផលិតកម្ម នៅ ក្នុង ប្រទេស ចិន និង ឥណ្ឌូនេស៊ី និង រាយការណ៍ ថា កំពុង ចរចា ជាមួយ រោងចក្រ ផ្សេង ទៀត នៅ ក្នុង ប្រទេស ឥណ្ឌា ផលិត ឧបករណ៍ អេឡិចត្រូនិក នានា ស្ថិត ក្រោម យីហោ របស់ ខ្លួន ។
សវនាការ មួយ ទៀត នៅ ថ្ងៃ ព្រហស្បតិ៍ នេះ នឹង អាច ផ្តល់ ព័ត៌មាន លម្អិត បន្ថែម ទៀត លើ ករណី នេះ។
អ្នក នាំពាក្យ របស់ ក្រុមហ៊ុន VW បាន ឲ្យ ដឹង ក្នុង សេចក្តី ថ្លែងការណ៍ មួយ ថា កិច្ចព្រមព្រៀង ថ្មី នេះ «គឺជា ជំហាន ឆ្ពោះ ទៅ មុខ ដ៏សំខាន់ មួយ នៃ កិច្ចប្រឹងប្រែង របស់ យើង ដើម្បី កែតម្រូវ ឲ្យ អតិថិជន យើង វិញ»។
បច្ចេកវិទ្យា នេះ អាច ដឹង បាន នៅ ពេល រថយន្ត ត្រូវ បាន គេ ធ្វើ តេស្ត ហើយ វា នឹង បើក មុខងារ គ្រប់គ្រង ឧស្ម័ន ដែល រថយន្ត បញ្ចេញ ដើម្បី ឲ្យ ធ្វើ តេស្ត ឃើញ ថា រថយន្ត បញ្ចេញ ឧស្ម័ន តាម កម្រិត កំណត់ ក៏ ប៉ុន្តែ វា បិទ មុខងារ នេះ វិញ នៅ ពេល បើកបរ ក្នុង លក្ខខណ្ឌ ធម្មតា។
នេះ មាន ន័យ ថា រថយន្ត នេះ នឹង បញ្ចេញ ឧស្ម័ន ពុល កាបូន លើស កម្រិត កំណត់ ខ្លាំង៕
ក្រុមហ៊ុន CCBA បាន ប្រតិបត្តិការ នៅ ក្នុង អាហ្វ្រិក ខាង ត្បូង ណាមីប៊ី កេនយ៉ា អ៊ូហ្គង់ដា តង់ហ្សានី អេត្យូពី ម៉ូហ្សំប៊ិក ហ្គាណា ម៉ាយ៉ូត និង កូម៉ូរ៉ូស ។
ប៉ុន្តែ សេចក្ដី ប្រកាស ព័ត៌មាន ឲ្យ ដឹង ថា គោល បំណង តែ មួយ គត់ របស់ ក្រុមហ៊ុន ឈាន មុខ គេ របស់ អាមេរិក មួយ នេះ ដើម្បី គ្រប់គ្រង លើ ប្រតិបត្តិការ ទាំង នេះ បណ្ដោះ អាសន្ន « រហូត ដល់ ពួក គេ អាច ត្រូវ បាន ផ្ដល់ សិទ្ធិ ធ្វើ អាជីវកម្ម ជាថ្មី ដល់ ដៃគូ ផ្សេង ទៀត » ។
