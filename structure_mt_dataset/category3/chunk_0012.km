ចំណែក ប្រមាណ ៩០ ភាគរយ ជា រថយន្ត ជជុះ។
ពឹងផ្អែកការនាំចូលជាការបម្រើសេដ្ឋកិច្ចបរទេស
លោក បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ ម្សិលមិញ ថា លោក មាន គំនិត កែច្នៃ ផលិតផល ចេញ ពី ទឹក ត្នោត តាំង ពី ឆ្នាំ ១៩៩២ ដោយ កាល នោះ ប្រទេស កម្ពុជា ចាប់ ផ្តើម កសាង សន្តិភាព បន្ទាប់ ពី កិច្ច ព្រម ព្រៀង ទីក្រុង ប៉ារីស ឆ្នាំ ១៩៩១ តែ រហូត ដល់ ឆ្នាំ ២០០១ ទើប ផលិតផល ដំបូង គឺ ស្ករ ត្នោត បាន លេច រូប រាង ឡើង។
ការ ប្រើ ប្រាស់ ពេល វេលា ដ៏ វែង នោះ គឺ ដោយ សារ លោក ត្រូវ យក ផលិតផល ស្ករ ត្នោត ទៅ ពិសោធ នៅ ប្រទេស បារាំង ហើយ បន្ទាប់ ពី ឃើញ ភាព វិជ្ជមាន នៃ គុណភាព ខ្ពស់ ទើប លោក សម្រេច ចិត្ត អភិវឌ្ឍ ផលិតផល នេះ។
រហូត ដល់ ឆ្នាំ ២០០១ ទើប ផលិតផល ផ្តើម ដំណើរការ ចេញ ជា រូបរាង បន្ទាប់ ពី ផលិតផល ស្ករ ត្នោត យក ទៅ ពិសោធ នៅ ប្រទេស បារាំង បាន ទទួល ជោគជ័យ និង មាន សារ ប្រយោជន៍ ខ្លាំង ពី ស្ករ ត្នោត នេះ ។
ជំនឿ លើ អត្តសញ្ញាណ របស់ យើង លើ វប្បធម៌ របស់ យើង និង កម្លាំង របស់ យើង។
ផលិតផល ទាំង នេះ នឹង ក្លាយ ជា ផលិតផល យូរ អង្វែង របស់ ប្រទេស កម្ពុជា យើង ព្រោះ នៅ ស្រុក ស្រែ ដើម ត្នោត តែង តែ មាន ជានិច្ច»។
លោក បញ្ជាក់ ថា លោក ចាប់ ផ្តើម គម្រោង នេះ ដោយ មាន ថវិកា ផ្ទាល់ ខ្លួន ចំនួន ៦ ម៉ឺន ដុល្លារ ហើយ លោក ត្រូវ ចំណាយ ថវិកា ជា បន្ត បន្ទាប់ ទៅ លើ ដំណើរ យក ផលិតផល ទៅ ធ្វើ ពិសោធ នៅ ប្រទេស បារាំង ជាដើម រហូត មក ដល់ ពេល នេះ លោក បាន ចំណាយ អស់ ជាង ២ លាន ដុល្លារ សម្រាប់ ផែនការ អភិវឌ្ឍន៍ ផលិតផល ចេញ ពី តោ្នត នេះ។
ការ កត់ សម្គាល់ របស់ ម្ចាស់ សហគ្រាស ដែល វិល ត្រឡប់ ពី ប្រទេស បារាំង ក្រោយ សន្ធិ សញ្ញា ក្រុង ប៉ារីស រូប នេះ បាន លើក ឡើង ថា ៖
«ការ ប្រើ ប្រាស់ និង ពឹង ផ្អែក លើ ផលិតផល នាំ ចូល ពី បរទេស គឺជា ការ បម្រើ សេដ្ឋកិច្ច បរទេស ហើយ ប្រទេស កម្ពុជា គ្មាន ឱកាស កសាង សុខ សន្តិភាព ដោយ ខ្លួន ឯង ទេ»។
បើ យើង ចង់ ឲ្យ សេដ្ឋកិច្ច យើង សម្បូរ បែប យើង ត្រូវ ឲ្យ ផលិតផល ប្រទេស របស់ យើង មាន តម្លៃ និង បង្កើត តម្លៃ បន្ថែម។
ប្រសិន យើង រង់ចាំ ផលិតផល ដែល ឈ្មួញ ជា អ្នក សម្រេច ដំឡើង ថ្លៃ ឬ បញ្ចុះ ថ្លៃ ប្រជាជន យើង មិន អាច ឆ្លង រួច ពី ភាព ក្រីក្រ បាន ទេ»។
លោក ថ្លែង ថា ពេល នេះ ក្រុមហ៊ុន មាន ផលិតផល គ្រប់ គ្រាន់ ហើយ ដោយ ត្រូវ ផ្តោត លើ ទីផ្សារ ក្នុង ឆ្នាំ ក្រោយ។
ឆ្នាំ ២០១៤ ខាង មុខ ជា ឆ្នាំ ដែល ក្រុមហ៊ុន នឹង ពង្រីក ឲ្យ កាន់ តែ ខ្លាំង ថែម ទៀត ពិសេស តម្លៃ បន្ថែម ឲ្យ ដល់ កសិករ ជា អ្នក ឡើង ត្នោត តែ ម្តង៕
ប្រាក់ចំណេញពីល្បែងបង្ហាញថាធ្លាក់ចុះ
«ប្រាក់ ចំណេញ ប្រចាំ ត្រី មាស បាន ពី ការ រួម ចំណែក យ៉ាង ខ្លាំង ពី ប្រតិបត្តិការ នៅ ណាហ្គាវើល។
លោក លើក ឡើង ថា ដំណើរការ ហិរញ្ញវត្ថុ មាន ដំណើរការ យឺត»។
«ជាមួយ នឹង កាស៊ីណូ ចំនួន ៨ ដែល មាន ស្រាប់ ក្នុង ការ ប្រតិបត្តិការ នៅ ប៉ោយប៉ែត គឺជា ទីផ្សារ បើក ដំណើរការ មួយ និង ជា ទីផ្សារ ល្បែង ក្នុង តំបន់ កំពុង កើន ឡើង។
ប្រាក់ ចំណេញ បាន ពី ល្បែង ស្លត់ ម៉ាស៊ីន នៅ ណាហ្គាវើល បាន ផ្ដល់ ចំណូល ដ៏ ច្រើន ដល់ ក្រុមហ៊ុន សម្រាប់ ឧស្សាហកម្ម ល្បែង ពី កម្ពុជា ដែល ជួយ បង្កើន ប្រាក់ ចំណូល ៣,៧ លាន ដុល្លារ និង ជា មធ្យម ២៥៦ ដុល្លារ ក្នុង ម៉ាស៊ីន មួយ គ្រឿង ក្នុង មួយ ថ្ងៃ នៅ ត្រីមាស ទី២។
តម្លៃស្រូវបានធ្លាក់ចុះយ៉ាងគំហុក
បន្ទាយមានជ័យៈ មន្ត្រី និង ឈ្មួញ អះអាង ថា តម្លៃ ស្រូវ នៅ ខេត្ត ភាគ ពាយព្យ កំពុង ធ្លាក់ ចុះ យ៉ាង ខ្លាំង ខណៈ ការ ប្រមូល ស្រូវ ដើមរដូវ កំពុង ចាប់ផ្តើម ។
លោក បាន បន្ត ថា ជាមួយ គ្នា នេះ ប្រជាជន ខិតខំ ប្រមូលផល ដើម្បី ចៀសវាង ការ ខូចខាត ច្រើន ហើយ តម្លៃ ស្រូវ ដែល ទើប ប្រមូលផល រួច បាន ធ្លាក់ ថ្លៃ ជា បន្តបន្ទាប់ គឺ នៅ ត្រឹម ប្រមាណ ៧០០ រៀល ក្នុង មួយ គីឡូក្រាម ។
អ្នកស្រី ចៅ ម៉ីលួយ ម្ចាស់ រោង ម៉ាស៊ីន កិនស្រូវ ឈ្មោះ សាន់ទី នៅ ភូមិ រហាល ឃុំ រហាល ស្រុក ព្រះនេត្រព្រះ ខេត្ត បន្ទាយមានជ័យ បាន និយាយ ថា តម្លៃ ស្រូវ បាន ធ្លាក់ ចុះ ខ្លាំង ណាស់ ហើយ ក៏ គ្មាន ឈ្មួញ សម្រុក ទិញ ដែរ ក្នុង រយៈពេល នេះ ព្រោះ ថៃ បាន ទប់ស្កាត់ មិន ឲ្យ នាំ ចូល ពី កម្ពុជា ។
អ្នកស្រី បន្ថែម ថា ឈ្មួញ ដែល ធ្លាប់ តែ បញ្ជា ទិញ អង្ករ ពី រោង ម៉ាស៊ីន អ្នកស្រី បាន ផ្អាក ហើយ រោង ម៉ាស៊ីន ក៏ បាន បង្អង់ សកម្មភាព ដែរ ។
លោក បញ្ជាក់ ថា ប្រភេទ ស្រូវ IR បាន ធ្លាក់ ថ្លៃ ខ្លាំង ព្រោះ ទីផ្សារ អង្ករ ប្រភេទ នេះ កម្ពុជា ប្រកួត មិន ឈ្នះ ប្រទេស ជិត ខាង ទេ ជាពិសេស ប្រទេស វៀតណាម ។
អ្នកស្រី ជី រ៉ាណាន់ វង្សមង្គល អគ្គទីប្រឹក្សា ពាណិជ្ជកម្ម ប្រចាំ ស្ថាន ឯកអគ្គរាជទូត ថៃ ប្រចាំ នៅ ប្រទេស កម្ពុជា ឲ្យ ដឹង ថា ការ នាំ ចេញ ស្រូវ-អង្ករ ទៅ កាន់ ទីផ្សារ ថៃ ត្រូវ បាន ហាមឃាត់ យ៉ាង តឹងរ៉ឹង ហើយ ការ នាំ ចូល កន្លង មក ធ្វើ ឡើង ដោយ លួចលាក់ ប៉ុណ្ណោះ៕
ការប្រឈមនៃចង្វាក់ផលិតកម្មរោងចក្រ
ភ្នំពេញៈ ចង្វាក់ ផលិតកម្ម រោងចក្រ កាត់ដេរ មួយ ចំនួន នៅ ក្នុង រាជធានី ភ្នំពេញ នៅ មិន ទាន់ ត្រឡប់ មក រក សភាព ដើម ដូច កាល ពី មុន ពេល បោះឆ្នោត វិញ នៅ ឡើយ ទេ ដោយ សារ កម្មករ មួយ ចំនួន មិន ទាន់ ហ៊ាន ត្រឡប់ មក ធ្វើ ការងារ ដែល ធ្វើ ឲ្យ ផ្នែក ខ្លះ ត្រូវ រាំង ស្ទះ។
លោក អាត់ ធន់ ប្រធាន សហជីព ការងារ កម្ពុជា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា មាន កម្មករ ច្រើន ជាង ១០ ភាគរយ មិន ទាន់ ត្រឡប់ មក ចូល ធ្វើ ការ វិញ នៅ ឡើយ បន្ទាប់ ពី ថ្ងៃ បោះឆ្នោត ថ្នាក់ ជាតិ ដែល ធ្វើ ឡើង កាល ពី ថ្ងៃ ទី២៨ កក្កដា ដោយ សារ ពួក គាត់ មួយ ចំនួន មាន ការ ព្រួយ បារម្ភ ពី កា រប្រែ ប្រួល នៃ ស្ថានភាព នយោបាយ ។
កត្តា នេះ គឺជា បញ្ហា ប្រឈម ដែល អាច ប៉ះពាល់ ដល់ ចង្វាក់ ផលិតកម្ម ក្នុង រោងចក្រ។
រោងចក្រ ដែល ជួប បញ្ហា អាច ត្រូវ បង្ខំ ចិត្ត ផ្អាក ទទួល ការ កុម្ម៉ង់ ពី អ្នក ទិញ បណ្តោះ អាសន្ន សិន ព្រោះ ពួក គេ ខ្លាច មិន អាច ផលិត បាន ទាន់ ពេល កំណត់»។
លោក ខេន លូ អគ្គ លេខាធិការ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា បាន និយាយ កាល ពី ម្សិលមិញ ថា រោងចក្រ មួយ ចំនួន អាច ជួប ប្រទះ បញ្ហា ប្រឈម ខាង លើ តែ លោក បាន បញ្ជាក់ ថា វា មិន បាន កើត ឡើង ជា ទូទៅ ទេ។
គម្រោងរួមគ្នារបស់កម្ពុជាអ៊ែរឡាញត្រូវពន្យារពេល
ភ្នំពេញៈ ភាគី ពាក់ព័ន្ធ ឲ្យ ដឹង ថា ការ វិនិយោគ រួម គ្នា ក្នុង ការ បង្កើត ក្រុមហ៊ុន កម្ពុជា អ៊ែរឡាញ នឹង ត្រូវ ពន្យារពេល ៣ ខែ ទៀត ។
របាយការណ៍ កាលពី លើក មុន ផ្ញើ ទៅ កាន់ ផ្សារហ៊ុន ដដែល កាលពី ចុង ខែ ឧសភា ឲ្យ ដឹង ថា ក្រុមហ៊ុន អាកាសចរណ៍ ហ្វីលីពីន អ៊ែរឡាញ នឹង វិនិយោគ ជា ទឹកប្រាក់ ១០ លាន ដុល្លារ សម្រាប់ ភាគហ៊ុន ៤៩ ភាគរយ នៅ ក្រុមហ៊ុន កម្ពុជា អ៊ែរឡាញ ។
« មាន ការងារ ជា ច្រើន ជាប់ ពាក់ព័ន្ធ នៅក្នុង ការ រៀបចំ ដំណើរការ ក្រុមហ៊ុន អាកាសចរណ៍ មួយ ប៉ុន្តែ រាល់ អ្វី ៗ កំពុង មាន ការ រីកចម្រើន យ៉ាង រលូន »។
ក្រុមហ៊ុន អាកាសចរណ៍ កម្ពុជា អ៊ែរឡាញ បាន ចូល មក បំបែក ទីផ្សារ ផ្តាច់មុខ ក្នុង ស្រុក ដែល នៅ បច្ចុប្បន្ន មាន តែ ក្រុមហ៊ុន កម្ពុជា អង្គរអ៊ែរ (CAA) មួយ ប៉ុណ្ណោះ ។
របាយការណ៍ របស់ មជ្ឈមណ្ឌល អាកាសចរណ៍ បាន រក ឃើញ កាលពី ខែ មករា ថា ក្រុមហ៊ុន ផ្ដាច់មុខ CAA បង្កើន តម្លៃ សំបុត្រ ខ្ពស់ មិន ធម្មតា ដែល បណ្ដាល ឲ្យ ការ ធ្វើ ដំណើរ តាម ផ្លូវ អាកាស ក្នុង ស្រុក ធ្លាក់ ចុះ ប្រហែល ១៥ ភាគរយ ៕
ក្រុមហ៊ុនចំណីអាហារបានបង្កើនការផលិត
ភ្នំពេញៈ សហគ្រាស ផលិត ចំណីអាហារ ក្នុង ស្រុក បាន បង្កើន ការ ផលិត របស់ ខ្លួន សម្រាប់ ផ្គត់ផ្គង់ ឲ្យ មាន ប្រសិទ្ធភាព និង ទប់ស្កាត់ ការ កើនឡើង តម្លៃ នៅ ក្រោយ ការ បោះឆ្នោត ។
លោក លើក ឡើង ថា ការ ផលិត លើស ផែនការ នេះ បណ្តាល មកពី មូលហេតុ សំខាន់ ៗ រួម មាន ស្ថានភាព នយោបាយ បច្ចុប្បន្ន បាន នាំ ឲ្យ ប្រជាជន ភ័យខ្លាច បន្ទាប់ពី ការ បោះឆោ្នត រួច និង ក្រោយ មក ទៀត កម្ពុជា នឹង ប្រឈម គ្រោះ ទឹកជំនន់ ដែល ត្រូវ ការ មីកញ្ចប់ សម្រាប់ ចែកចាយ ។
ប្រសិន យើង ធ្វើ បែប នេះ វា ហាក់ ដូចជា សម្លាប់ ប្រជាជន យើង អ៊ីចឹង »។
ប៉ុន្តែ តម្លៃ ហក់ ឡើង ខ្ពស់ នេះ មាន តែ តាម កន្លែង លក់ រាយ ប៉ុណ្ណោះ ។
លោក ប៊ុន សុង ប្រធាន ទីផ្សារ នៃ សិប្បកម្ម ផលិត គុយទាវ អនាម័យ ដែល ទើប បង្កើត ឡើង ថ្មីថ្មោង បាន និយាយ ថា ស្ថានភាព លក់ ចេញ ពី សិប្បកម្ម មួយ នេះ បាន កើនឡើង ខ្លាំង ណាស់ ក្នុង មួយ រយៈ ចុង ក្រោយ នេះ ហើយ តាម ការ កត់សម្គាល់ សិប្បកម្ម របស់ លោក បាន លក់ កើនឡើង រហូត ដល់ ទៅ ២០ ឬ ៣០ ភាគរយ ។
លោក ម៉េង ស័ក្តិ ធារ៉ា អគ្គនាយករង នៃ អគ្គនាយកដ្ឋាន ឧស្សាហកម្ម នៃ ក្រសួង ឧស្សាហកម្ម រ៉ែ និង ថាមពល បាន និយាយ ថា ស្ថានភាព កើតឡើង ក្នុង រយៈពេល ខ្លី បែប នេះ លំបាក ប្រើប្រាស់ ជា ឧបករណ៍ សម្រាប់ វិភាគ ស្ថានភាព សេដ្ឋកិច្ច រយៈពេល វែង ណាស់ ។
« ការ ផ្គត់ផ្គង់ ត្រូវ តែ ឆ្លើយតប តាម តម្រូវការ ហើយ ខ្ញុំ គិតថា អ្នក ផលិត យល់ ច្បាស់ ពី ស្ថានភាព នេះ ព្រោះ គេ ជា អ្នក វិនិយោគ ៕
ការ ពង្រីក ទំហំ កម្ចី ទៅ លើ សេវាកម្ម ប្រាក់កម្ចី ដែល មាន រយៈពេល វែង នា ពេល នេះ អាច ជា សញ្ញា បង្ហាញ ថា ធនាគារ មាន ការ ជឿ ទុក ចិត្ត ពី ស្ថិរភាព សង្គម និង បង្ហាញ ពី លទ្ធភាព របស់ ធនាគារ ក្នុង ការ ផ្តល់ ជូន សេវា ហិរញ្ញ វត្ថុ ដល់ សាធារណជន ឲ្យ កាន់ តែ ទូលំទូលាយ ។
« ក្នុង ស្ថានភាព សេដ្ឋកិច្ច បច្ចុប្បន្ន យើង បាន ទទួល ការ សាកសួរ ពី សំណាក់ អតិថិជន ជាច្រើន ដែល ត្រូវការ ឥណទាន សម្រាប់ ទិញ ផ្ទះ ដែល ស័ក្តិសម នឹង តម្រូវការ ហិរញ្ញវត្ថុ របស់ គាត់ ផ្សេង ៗ គ្នា ។
ស្ថានភាព វិស័យ ធនាគារ កម្ពុជា ហាក់ មិន ទទួល សញ្ញា អវិជ្ជមាន ណាមួយ ទាក់ទង នឹង ព្រឹត្តិការណ៍ បោះឆ្នោត ទេ មក ដល់ ពេល នេះ បើ ទោះ បី ក្រោយ ការ បោះឆ្នោត ភ្លាម មាន ភាព ជ្រួលច្របល់ រយៈពេល ខ្លី ដែល នាំ ទៅ ការ ដក លុយ ជាច្រើន លាន ដុល្លារ ពី ម៉ាស៊ីន អេធីអឹម ក្តី ។
កាលពី យប់ ថ្ងៃ ទី ២៨ កក្កដាក្រោយ ការ បោះឆ្នោត មាន មនុស្ស ជាច្រើន បាន តម្រង់ ជួរ គ្នា ដើម្បី ដក ប្រាក់ ពី ម៉ាស៊ីន អេ ធី អឹម តាម ធនាគារ ។
លោក អ៊ិន ចាន់នី ប្រធាន នាយកប្រតិបត្តិ ធនាគារ អេស៊ីលីដា បាន អះអាង ថា ស្ថានភាព ផ្តល់ កម្ចី និង ដាក់ ប្រាក់ បញ្ញើ សន្សំ នៅ អេស៊ីលីដា កំពុង មាន ដំណើរ ល្អ ជា ធម្មតា ។
ប៉ុន្តែ លោក បញ្ជាក់ ថា កម្ចី ខ្នាត ធំ និង ជា ប្រភេទ កម្ចី រយៈពេល វែង ដូចជា កម្ចី ទិញ ផ្ទះ ហាក់ មាន សន្ទុះ យឺត ជាង ពេល មុន។
កំណើនសេដ្ឋកិច្ចនឹងរងផលប៉ះពាល់
ភ្នំពេញៈ មន្ត្រី ជាន់ ខ្ពស់ កម្ពុជា បាន ព្រមាន ថា កំណើន សេដ្ឋកិច្ច កម្ពុជា នឹង រង ផល ប៉ះពាល់ ពី មាន ភាព វិកវរ នយោបាយ ក្រោយ ពី ការ បោះឆ្នោត នេះ។
លោក ចម ប្រសិទ្ធ រដ្ឋ មន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន ថ្លែង ក្នុង ឱកាស បើក ពិព័រណ៍ ឧស្សាហកម្ម ប្រចាំ ឆ្នាំ ចំនួន ពីរ កាល ពី ថ្ងៃ ម្សិលមិញ ថា សេដ្ឋកិច្ច កម្ពុជា និង រក្សា កំណើន បាន ដូច ឆ្នាំ កន្លង ទៅ បើ គ្មាន កលយុគ កើត ឡើង ក្រោយ ថ្ងៃ បោះឆ្នោត។
លោក ចម ប្រសិទ្ធ ទំនង ជា ចង់ សំដៅ ដល់ លទ្ធភាព ដែល អាច កើត មាន ការ ធ្វើ មហា បាតុកម្ម របស់ បក្ស ប្រឆាំង ជំទាស់ នឹង លទ្ធផល បោះឆ្នោត ដែល នឹង ឈាន ទៅ ដល់ អស្ថិរភាព សង្គម និង ធ្វើ ឲ្យ ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច ធ្ងន់ ធ្ងរ ។
«បើ សិន គេ ចង់ បំផ្លាញ សេដ្ឋកិច្ច គេ ត្រូវ ធ្វើ បាតុកម្ម ឲ្យ ច្រើន ដើម្បី បំផ្លាញ ។
ដូច យើង ឃើញ រួច ហើយ កាល ណា មាន បាតុកម្ម មាន អ្នក ធ្វើ បាតុកម្ម ពិត ប្រាកដ និង អ្នក ឆ្លៀត ឱកាស ពី បាតុកម្ម។
អ្នក ដែល ទាមទារ ធ្វើ បាតុកម្ម អត់ បាន គិត ដល់ ផល នៃ បាតុកម្ម នោះ ទេ។
កាល ណា បាតុកម្ម បែក មនុស្ស ចូល ប្លន់ តាម ហាង»។
«គោលការណ៍ របស់ យើង គឺ រដ្ឋាភិបាល ស្នើ ឲ្យ មាន ស្ថិរភាព និង អំពាវនាវ ឲ្យ ដោះស្រាយ ដោយ សន្តិវិធី»។
លោក លើក ឡើង ថា ការ កើន ឡើង សេដ្ឋកិច្ច ក្នុង ពេល កន្លង មក ជា លទ្ធផល នៃ តម្រូវ ការ ក្រៅ ប្រទេស កើន ឡើង និង សក្តានុពល សម្រាប់ ឱកាស ធុរកិច្ច នៅ ក្នុង ប្រទេស មាន ភាព ទូលំ ទូលាយ ។
លោក បន្ត ថា គោល នយោបាយ រដ្ឋាភិបាល មិន មែន ផ្តោត ទៅ លើ ទំនិញ នាំ ចេញ តែ មួយ នោះ ទេ ប៉ុន្តែ គោល នយោបាយ ធ្វើ ពិពិធកម្ម ទំនិញ នាំ ចេញ ឲ្យ បាន ច្រើន ប្រភេទ។
លោក កង ច័ន្ទតារារ័ត្ន នាយក វិទ្យាស្ថាន សិក្សា ការ អភិវឌ្ឍ កម្ពុជា បាន និយាយ តាម រយៈ បទ ពិសោធ ដែល ទទួល បាន ពី ការ បោះឆ្នោត ក្នុង អាណត្តិ កន្លង មក ទំនុក ចិត្ត វិនិយោគិន មាន មិន ខ្ពស់ ទេ សម្រាប់ ទីផ្សារ កម្ពុជា ។
លោក បន្ថែម ថា បើ បញ្ហា នយោបាយ នៅ តែ បន្ត បន្ទាប់ ពី ការ បោះឆ្នោត ការ បញ្ជា ទិញ ផលិតផល វាយនភ័ណ្ឌ ពី ទីផ្សារ អាមេរិក អាច នឹង ធ្លាក់ ចុះ ក្នុង វិស័យ កាត់ដេរ នៅ ក្នុង ករណី អាមេរិក លូក ដៃ នៅ ក្នុង កិច្ចការ នយោបាយ ចុង ក្រោយ នេះ ព្រោះ ទីផ្សារ ធំ របស់ កម្ពុជា ពឹង ទីផ្សារ សហរដ្ឋ អាមេរិក។
វិស័យ កាត់ដេរ របស់ យើង មិន ទាន់ បាន ទទួល ការ ប្រកួត ក្នុង ទីផ្សារ អាមេរិក ក្នុង ស្ថានភាព ពេញ លេញ ដូច គេ ដូច ឯង នៅ ឡើយ ទេ ព្រោះ យើង ស្ថិត ក្នុង ប្រព័ន្ធ អនុគ្រោះ នៅ ឡើយ»។
លោក បន្ថែម ថា ជំហរ អាមេរិក មាន ឥទ្ធិពល ដល់ សហភាព អឺរ៉ុប ផង ដែរ ។
«បើ អាមេរិក មិន ត្រូវ សហគមន៍ អឺរ៉ុប នឹង ដើរ តាម។
ពេល នោះ ហើយ វា ធ្វើ ឲ្យ អារម្មណ៍ អ្នក វិនិយោគ ក្នុង វិស័យ កាត់ដេរ មិន ទាន់ កក់ក្តៅ ទេ»។
លោក សុន ឆ័យ ប្រធាន ក្រុម អ្នក តំណាង រាស្ត្រ គណបក្ស សង្គ្រោះ ជាតិ បាន ថ្លែង ថា វិស័យ សំខាន់ នៃ សេដ្ឋកិច្ច ដូចជា វិស័យ ទេសចរណ៍ កសិកម្ម និង វិស័យ កាត់ដេរ។
«ប៉ុន្តែ ស្ថិរភាព របស់ កម្ពុជា មិន អាច ជា បញ្ហា នោះ ទេ សេដ្ឋកិច្ច របស់ ប្រទេស អាច មាន ភាព ប្រសើរ ឡើង ប្រសិន បើ គណបក្ស ប្រឆាំង ឈ្នះ ការ បោះឆ្នោត ហើយ កាន់ តំណែង ក្នុង រដ្ឋាភិបាល»។
«ដូច្នេះ យើង នឹង ប្ដេជ្ញា ចិត្ត ប្រយុទ្ធ ប្រឆាំង អំពើ ពុករលួយ ប្ដេជ្ញា ចិត្ត លើ ការ ផលិត កាន់ តែ ល្អ ប្រសើរ ឡើង ។
គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា សេដ្ឋកិច្ច របស់ រដ្ឋាភិបាល ពឹង លើ ការ នាំ ចូល ទំនិញ និង ពឹង លើ កម្ចី ពី ចិន»៕
ការនាំចេញរបស់កម្ពុជាទៅជប៉ុនកើនឡើង ៣១ ភាគរយ
ការ នាំ ចេញ នេះ ជា អត្រា ខ្ពស់ ជាង គេ បង្អស់ បើ ប្រៀប ធៀប នឹង កំណើន នាំ ចេញ របស់ ប្រទេស សមាជិក ក្នុង តំបន់ អាស៊ាន ទៅ ទីផ្សារ ប្រទេស ជប៉ុន។
ទិន្នន័យ ពី អង្គការ ពាណិជ្ជកម្ម ក្រៅ ប្រទេស ជប៉ុន (JETRO) បាន បង្ហាញ ថា ការ នាំ ចេញ ទៅ ទីផ្សារ ជប៉ុន របស់ ប្រទេស ក្នុង តំបន់ អាស៊ាន ក្នុង ឆមាស ទីមួយ ឆ្នាំ នេះ រួម មាន ថៃ វៀតណាម សិង្ហបុរី និង ម៉ាឡេស៊ី ជាដើម បាន ធ្លាក់ ចុះ យ៉ាង ខ្លាំង ក្នុង អត្រា មធ្យម ១៥ ភាគរយ ធៀប នឹង ឆ្នាំ មុន។
ប៉ុន្តែ ទំហំ ទឹក ប្រាក់ សរុប នៃ ការ នាំ ចេញ របស់ កម្ពុជា នៅ មាន ចំណែក តូច ជាង ឆ្ងាយ បើ ធៀប នឹង ទំហំ នាំ ចេញ របស់ ប្រទេស នានា ក្នុង តំបន់។
អ្នក ស្រី តាកាយ៉ូស៊ិ គុរ៉ូមីយ៉ា ទីប្រឹក្សា ប្រចាំ ស្ថានទូត ជប៉ុន នៅ កម្ពុជា បាន បង្ហាញ ការ សារទរ ចំពោះ ការ សម្រេច បាន នូវ កំណើន ទំហំ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង ជប៉ុន ហើយ រំពឹង ថា និន្នាការ នេះ នឹង នៅ បន្ត ដំណើរការ ល្អ ថែម ទៀត។
«យើង រំពឹង ថា កិច្ច សហ ប្រតិបត្តិការ ផ្នែក សេដ្ឋកិច្ច រវាង ជប៉ុន កម្ពុជា នឹង នៅ បន្ត កំណើន ថែម ទៀត»។
ទិន្នន័យ JETRO បង្ហាញ ថា ផលិតផល សំខាន់ៗ ដែល កម្ពុជា បាន នំា ចេញ ទៅ ជប៉ុន មាន ដូច ជា ស្បែក ជើង សម្លៀក បំពាក់ និង គ្រឿង ម៉ាស៊ីន អគ្គិសនី ហើយ កម្ពុជា ក៏ បាន នាំ ចូល ពី ជប៉ុន វិញ ដូច ជា គ្រឿង ម៉ាស៊ីន សម្រាប់ ដំណើរការ រោងចក្រ រថយន្ត កប៉ាល់ និង ទូក ជាដើម។
កម្ពុជា ជា ប្រទេស ទី៩ ក្នុង តំបន់ ដែល បាន នាំ ចេញ ទៅ ជប៉ុន ច្រើន ជាង ប្រទេស ឡាវ ដែល មាន ៦១ លាន ដុល្លារ និង បន្ទាប់ ពី មីយ៉ាន់ម៉ា ដែល មាន ទឹក ប្រាក់ ២៨៧ លាន ដុល្លារ។
លោក គីយ៉ូតាកា ដូហូ តំណាង JETRO នៅ កម្ពុជា ធ្លាប់ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ការ នាំ ចេញ របស់ កម្ពុជា ទៅ ទីផ្សារ ប្រទេស ជប៉ុន កំពុង មាន កំណើន ហើយ នៅ ពេល នេះ កម្ពុជា មិន ត្រឹម តែ នាំ ចេញ ផលិត ផល សម្លៀក បំពាក់ ប៉ុណ្ណោះ ទេ ថែម ទាំង បាន បន្ថែម ការ នាំ ចេញ ផលិតផល ដែល មាន តម្លៃ បន្ថែម ខ្ពស់ ជា មុន ដូច ជា គ្រឿង ម៉ាស៊ីន អគ្គិសនី ដែល ដំឡើង ដោយ ក្រុមហ៊ុន ជប៉ុន នៅ កម្ពុជា ផង ដែរ។
លោក បន្ថែម ថា មាន រោងចក្រ ឧស្សាហកម្ម កាន់ តែ ច្រើន មក វិនិយោគ នៅ កម្ពុជា ដើម្បី ដំឡើង យានយន្ត និង ត្រៀម នាំ ចេញ ត្រឡប់ ទៅ ជប៉ុន វិញ។
ពាណិជ្ជកម្ម ទ្វេ ភាគី កម្ពុជា ជប៉ុន នៅ ឆមាស ទីមួយ ឆ្នាំ នេះ សម្រេច បាន ៣៤៧ លាន ដុល្លារ កើន ឡើង ពី ២៩២ លាន ដុល្លារ នៅ ឆមាស ទីមួយ កាល ពី ឆ្នាំ មុន៕
ក្រសួងចាប់ផ្តើមត្រួតពិនិត្យទីផ្សារនៅទូទាំងប្រទេស
ភ្នំពេញៈ នាយកដ្ឋាន ត្រួត ពិនិត្យ គុណភាព ក្រសួង ពាណិជ្ជកម្ម បាន និយាយ ថា មន្រ្តី រដ្ឋាភិបាល បាន ចាប់ ផ្ដើម ត្រួត ពិនិត្យ ទីផ្សារ ទូទាំង ប្រទេស កាល ពី ម្សិលមិញ ក្នុង ការ ស្រាវជ្រាវ រក ម្សៅ ទឹក ដោះ គោ កូន ក្មេង មាន គ្រឿង ផ្សំ ពី ក្រុមហ៊ុន Fonterra ដែល គួរ ឲ្យ សង្ស័យ។
លោក ឃួន សាវុធ មន្រ្តី នៅ នាយកដ្ឋាន កាំកុងត្រូល ដែល ជា នាយកដ្ឋាន ត្រួត ពិនិត្យ គុណភាព របស់ ក្រសួង ពាណិជ្ជកម្ម បាន និយាយ ថា៖
«យើង បាន ជូន ដំណឹង ដល់ មន្រ្តី របស់ យើង ទាំង អស់ ឲ្យ ចុះ ប្រមូល ដោយ ផ្ទាល់ នូវ ផលិតផល ក្នុង ចំនួន ច្រើន ដែល ក្រុមហ៊ុន បាន ផ្ដល់ ដំណឹង ដល់ យើង នៅ ទូទាំង ប្រទេស»។
ផលិតផល ទឹក ដោះ គោ ថ្លា មាន មេរោគ ដែល អាច បណ្ដាល ឲ្យ ពុល អាច ធ្វើ ឲ្យ ខ្វិន ធ្ងន់ធ្ងរ និង មាន ជំងឺ បណ្ដាល ឲ្យ ស្លាប់ បាន។
លោក ម៉ម ប៊ុនហេង រដ្ឋ មន្រ្តី ក្រសួង សុខាភិបាល បាន និយាយ ថា ថ្មីៗ នេះ ក្រុម ការងារ បច្ចេកទេស នៅ នាយកដ្ឋាន ឱសថ និង អាហារ កំពុង សហការ គ្នា យ៉ាង ជិត សិ្នទ្ធ ជាមួយ ក្រុមហ៊ុន។
ថូល ចាប់ផ្តើមសេវាដឹកជញ្ជូនអង្ករ
ភ្នំពេញៈ ក្រុមហ៊ុន ដឹក ជញ្ជូន តាម ផ្លូវ ដែក ថូល រ៉ូយ៉ាល់ បាន ចាប់ ផ្តើម ដំណើរការ សេវា ដឹក ជញ្ជូន អង្ករ ពី ភ្នំពេញ ទៅ កំពង់ផែ ខេត្ត ព្រះសីហនុ ជា លើក ដំបូង។
នេះ ជា ការ ចាប់ ផ្តើម ដឹក ទំនិញ ពី ភ្នំពេញ ទៅ កំពង់ផែ អន្តរជាតិ ជា លើក ដំបូង របស់ ក្រុមហ៊ុន ចាប់ តាំង ពី ក្រុមហ៊ុន នេះ បាន ដំណើរការ ជា ផ្លូវ ការ កាល ពី ចុង ឆ្នាំ ២០១០ មក ដោយ សារ កាល ពី មុន ទំនិញ ភាគ ច្រើន ដែល ក្រុមហ៊ុន ដឹក ជញ្ជូន ជា ប្រភេទ ទំនិញ នាំ ចូល ឬ ទំនិញ ដែល ដឹក ពី ខេត្ត ចូល ភ្នំពេញ។
«នេះ ជា សកម្មភាព ថ្មី មួយ ទៀត របស់ ក្រុមហ៊ុន ថូល ដែល បាន ដឹក ជញ្ជូន អង្ករ តាម រយៈ រថភ្លើង ។
នៅ ពេល ឆាប់ៗ បន្ទាប់ ពី មន្រ្តី គយ និង កាំកុងត្រូល មាន ការិយាល័យ នៅ ទី នេះ ដំណើរការ បែប បទ នាំ ចេញ ផ្សេងៗ នឹង ត្រូវ សម្រួល ឲ្យ កាន់ តែ ល្អ ដូច្នេះ យើង នឹង អាច ទាក់ ទាញ ក្រុមហ៊ុន នាំ ចេញ ផលិតផល កាត់ ដេរ តាម រថភ្លើង ផង ដែរ»។
ជំហាន ដំបូង ក្រុមហ៊ុន បាន ដឹក ជញ្ជូន អង្ករ ពីរ ដង ក្នុង មួយ សប្តាហ៍ ។
ក្នុង មួយ កុងតឺន័រ អាច ផ្ទុក អង្ករ បាន ២៤ តោន។
កន្លង មក ក្រុមហ៊ុន បាន ដឹក ជញ្ជូន តែ ទំនិញ ពី ខេត្ត ចូល រាជធានី ប៉ុណ្ណោះ ។
នៅ ចុង ឆ្នាំ ២០០៩ ក្រុមហ៊ុន បាន ផ្តើម ដឹក ជញ្ជូន ស៊ីម៉ងត៍ ប្រមាណ ៩ ០០០ តោន ក្នុង មួយ ខែ ពី ស្រុក ទូកមាស ខេត្ត កំពត មក ភ្នំពេញ ហើយ ចាប់ ពី ដើម ឆ្នាំ ២០១៣ ក្រុមហ៊ុន ក៏ ចាប់ ផ្តើម ដឹក ប្រេង ឥន្ធនៈ ១,២ លាន លីត្រ រៀង រាល់ ពីរ ថ្ងៃ ម្តង ពី ខេត្ត ព្រះសីហនុ មក ភ្នំពេញ។
ក្រុមហ៊ុន ក៏ បាន ដឹក ជញ្ជូន ធ្យូង ថ្ម ៩០០ តោន រៀង រាល់ ពីរ ថ្ងៃ ម្តង ពី ខេត្ត ព្រះ សីហនុ ទៅ ស្រុក ទូកមាស ខេត្ត កំពត។
លោក គឹម សាវុធ អគ្គ នាយក ក្រុមហ៊ុន នាំ ចេញ អង្ករ ធំ មួយ ដែល មាន រោងចក្រ នៅ ភ្នំពេញ ដែល មិន ទាន់ បាន ដឹក ជញ្ជូន អង្ករ តាម រយៈ ក្រុមហ៊ុន ថូល នោះ បាន បង្ហាញ ពី ចំណាប់ អារម្មណ៍ ក្នុង ការ ដឹក ជញ្ជូន តាម ផ្លូវ ដែក។
ប៉ុន្តែ លោក បញ្ជាក់ ថា ដំណើរការ ក្នុង ការ ដឹក ជញ្ជូន តាម រថភ្លើង នា ពេល នេះ មាន ភាព ស្មុគស្មាញ ជា ច្រើន និង មាន តម្លៃ ខ្ពស់ ផង ដែរ។
«វា មាន ការ ស្មុគស្មាញ បន្តិច ហើយ វា ធ្វើ ឲ្យ តម្លៃ ដឹក ជញ្ជូន កាន់ តែ ខ្ពស់។
លោក ពន្យល់ ថា ដំបូង គេ ត្រូវ ជញ្ជូន អង្ករ ដាក់ រថយន្ត ដឹក ទំនិញ បន្ទាប់ មក ត្រូវ ដឹក ពី រោងចក្រ ទៅ ដល់ ផែស្ងួត។
នៅ ពេល ទៅ ដល់ ផែ ស្ងួត ត្រូវ ផ្ទេរ អង្ករ ពី រថយន្ត ដឹក ទំនិញ ទៅ ដាក់ ក្នុង កុងតឺន័រ រថភ្លើង។
នៅ ពេល រថភ្លើង ទៅ ដល់ កំពង់ផែ ព្រះ សីហនុ ត្រូវ ផ្ទេរ អង្ករ ពី ទូ រថភ្លើង ទៅ ដាក់ លើ រថយន្ត ដឹក ទំនិញ ម្ដង ទៀត ដើម្បី ចូល ម៉ាស៊ីន ស្កេន មុន នឹង នាំ ចេញ៕
ដំឡើងរថយន្តហ៊ីយ៉ាន់ដាយកើន
កោះកុងៈ បន្ទាប់ ពី ដំណើរការ រោងចក្រ ដំឡើង រថយន្ត ម៉ាក ហ៊ីយ៉ាន់ដាយ នៅ កម្ពុជា រយៈ ពេល ពីរ ឆ្នាំ មក ផលិតកម្ម របស់ ក្រុមហ៊ុន នេះ កំពុង មាន ការ កើន ឡើង ហើយ ក្រុមហ៊ុន គ្រោង នឹង សម្រេច ឲ្យ បាន ៨០០ គ្រឿង នៅ ឆ្នាំ ២០១៣។
យើង ក៏ រំពឹង ដែរ ថា និន្នាការ ទីផ្សារ នឹង បន្ត ស្ថានភាព ល្អ ថែម ទៀត ពេល អនាគត»។
ក្រុមហ៊ុន នេះ គ្រោង នឹង សាង សង់ ឃ្លាំង ថ្មី មួយ ទៀត ដើម្បី ស្ដុក ទុក កាន់ តែ ច្រើន ព្រម ទាំង ការ ពង្រីក ហាង តាំង បង្ហាញ លក់ និង ធ្វើ សិក្ខាសាលា ផ្សព្វ ផ្សាយ ក្នុង ការ បង្កើន ទំហំ នៃ ការ លក់ របស់ ខ្លួន។
ប៉ុន្តែ លោក វិសាល បាន ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ ថា ក្រុមហ៊ុន នេះ កំពុង គិត ធ្វើ ការ កែ សម្រួល មួយ ចំនួន សម្រាប់ នាំ ចេញ។
អ្នក រក ស៊ី នៅ ក្នុង ឧស្សាហកម្ម នេះ បាន និយាយ ថា ដោយសារ តម្លៃ ផលិត បាន កើន ឡើង នៅ តាម បណ្ដា ប្រទេស មួយ ចំនួន ដូចជា ប្រទេស ចិន ថៃ និង វៀតណាម ក្រុមហ៊ុន កាន់ តែ ច្រើន អាច ប្តូរ ទីតាំង ថ្មី មក ប្រទេស កម្ពុជា ដែល មាន តម្លៃ ផលិត ទាប ហើយ នឹង រួម ចំណែក ក្នុង ការ ជំរុញ ឧស្សាហកម្ម កម្ពុជា ពី ឧស្សាហកម្ម បន្ថែម តម្លៃ ទាប ទៅ ជា ឧស្សាហកម្ម បន្ថែម តម្លៃ ខ្ពស់។
លោក ចម ប្រសិទ្ធ រដ្ឋ មន្រ្តី ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា បាន ឲ្យ ដឹង ថា ឧស្សាហកម្ម ដំឡើង រថយន្ត នឹង បន្ត កើន ឡើង កាន់ តែ ច្រើន នៅ កម្ពុជា បន្ទាប់ ពី សមាហរណកម្ម សេដ្ឋកិច្ច តំបន់ អាស៊ាន ដោយ សារ កម្ពុជា មាន ភាព ប្រកួត ប្រជែង ខ្លាំង ក្នុង ការ ផ្តល់ ទីតាំង វិនិយោគ មាន ថ្លៃ ដើម ផលិត ទាប។
ថ្លែង ក្នុង ពិធី តាំង ពិព័រណ៍ រថយន្ត ខ្នាត អន្តរជាតិ នៅ ភ្នំពេញ កាល ពី ព្រឹក ថ្ងៃ ទី១៥ ខែ មីនា លោក ចម ប្រសិទ្ធ បាន មាន ប្រសាសន៍ ថា ពេល ខាង មុខ បន្ទាប់ ពី សមាហរណកម្ម សេដ្ឋកិច្ច ក្នុង តំបន់ ចាប់ ផ្តើម ដែល អនុញ្ញាត ឲ្យ មាន លំហូ ដោយ សេរី នៃ ទំនិញ និង សេវាកម្ម នៅ ក្នុង តំបន់ កម្ពុជា នឹង ទទួល បាន អត្ថ ប្រយោជន៍ ពី ផលិតកម្ម នេះ។
«ក្រុមហ៊ុន អាច នំា ចូល កង់ ឡាន ពី ម៉ាឡេស៊ី កញ្ចក់ ពី ឥណ្ឌូនេស៊ី ឬ ក៏ គ្រឿង បន្លាស់ ពី ប្រទេស ជា សមាជិក ផ្សេង ទៀត ដែល មាន ជំនាញ ផលិត ផ្សេងៗ គ្នា ហើយ យក មក ដំឡើង នៅ កម្ពុជា ដែល អាច ផ្គត់ ផ្គង់ ថ្លៃ ដើម ផលិត ថោក ជាង។
មាន ក្រុមហ៊ុន ជប៉ុន នៅ ថៃ និង វៀតណាម មួយ ចំនួន កំពុង សម្លឹង មើល ឱកាស វិនិយោគ បែប នេះ នៅ កម្ពុជា»៕
អាជីវកម្មនៅសហគមន៍អ៊ិស្លាមបានប្រយោជន៍ពីបុណ្យ រ៉ាម៉ាដន
ភ្នំពេញៈ អាជីវកម្ម លក់ រាយ ក្នុង ផ្សារ សហគមន៍ មាន ខ្មែរ-អ៊ិស្លាម ទទួល បាន ប្រយោជន៍ ជា ច្រើន ពី ការ លក់ ខណៈ បុណ្យ របស់ សាសនិក អ៊ិស្លាម ឬ «បុណ្យ រ៉ាម៉ាដន» ចាប់ ផ្តើម នៅ ថ្ងៃ នេះ។
អាជីវករ លក់ រាយ ជាច្រើន នៅ ផ្សារ ច្រាំងចំរេះ ក្នុង ខណ្ឌ ឫស្សីកែវ អះអាង ថា អាជីវកម្ម របស់ ខ្លួន ហាក់ ដូច ជា កាក់ កប ខ្លាំង ក្នុង រយៈ ពេល ពីរ ថ្ងៃ។
អាជីវករ ឈ្មោះ លី ទាង បាន ឲ្យ ដឹង ថា ទំនិញ សម្រាប់ ធ្វើ ម្ហូប លក់ ដាច់ ខ្លាំង ក្នុង រយៈ ពេល ពីរ ថ្ងៃ ចុង ក្រោយ មុន ពិធី បុណ្យ រ៉ាម៉ាដន ចូល មក ដល់ ។
លោក ឧស្មាន់ ហាសាន់ ប្រធាន សមាគម ខ្មែរ អ៊ិស្លាម នៅ កម្ពុជា ឲ្យ ដឹង ថា ប្រជាជន ខ្មែរ-អ៊ិស្លាម មាន ប្រមាណ ៦០ ម៉ឺន នាក់ ទូទាំង ប្រទេស ហើយ ពួក គេ តែង តែ ត្រៀម ខ្លួន ចំណាយ ច្រើន ខុស ពី ថ្ងៃ ធម្មតា នៅ ថ្ងៃ ចុង ក្រោយ បុណ្យ រ៉ាម៉ាដន៕
បង្កើតក្រុមការងារលើបញ្ហាម្សៅទឹកដោះគោ
ភ្នំពេញៈ រដ្ឋាភិបាល កម្ពុជា បាន បង្កើត ក្រុម ការងារ បច្ចេកទេស មួយ ដើម្បី វាយតម្លៃ ពី វិសាលភាព នៃ ការ ព្រួយ បារម្ភ ទៅ លើ សុខភាព បន្ទាប់ ពី ម្សៅ ទឹកដោះ គោ កូន ក្មេង ត្រូវ គេ រក ឃើញ ថា មាន ជាតិ ពុល។
លោក ម៉ម ប៊ុនហេង រដ្ឋ មន្រ្តី ក្រសួង សុខាភិបាល បាន ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ ថា៖
លោក ស្រី សុខ សោភ័ណ ស្ត្រី មេផ្ទះ មាន កូន ពីរ នាក់ នៅ សង្កាត់ ព្រែកប្រា ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ បាន និយាយ ថា អ្នក ស្រី បាន ឮ ដំណឹង នេះ ពី ប្តី អ្នក ស្រី កាល ពី ព្រឹក ម្សិលមិញ។
លោក បន្ត ថា បុគ្គលិក របស់ លោក កំពុង ធ្វើ ការ យ៉ាង សកម្ម ក្នុង ការ ស្វែង រក ដល់ ទីកន្លែង ដើម្បី ប្រមូល ត្រឡប់ នូវ ផលិតផល ពី បណ្ដា ក្រុមហ៊ុន លក់ រាយ។
ផលិតផល ឌុយមិច ក្រៅ ពី នេះ មិន មាន ផល ប៉ះពាល់ ទេ។
ប៉ុន្តែ លោក បញ្ជាក់ ថា មិន មែន ម្សៅ ទឹក ដោះ គោ ទាំងអស់ សុទ្ធ តែ នៅ ក្នុង ដៃ អតិថិជន នោះ ទេ។
លោក បាន បន្ត ថា អតិថិជន អាច ប្រគល់ ផលិតផល របស់ ពួកគេ ឲ្យ ទៅ ក្រុមហ៊ុន លក់ រាយ ដើម្បី យក ប្រាក់ វិញ។
ពីអ្នករត់ម៉ូតូឌុបក្លាយជាសហគ្រិនជោគជ័យម្នាក់
ភ្នំពេញៈ នៅ អាយុ ២៤ឆ្នាំ លោក សាង ខាវី បាន ក្លាយ ជា អ្នក រត់ ម៉ូតូ ឌុប ដឹក ភ្ញៀវ ទេសចរ ឲ្យ ផ្ទះ សំណាក់ មួយ ក្រោយ មក ផ្ទះ សំណាក់ នោះ ត្រូវ បាន បិទ ទ្វារ ខណៈ គោល បំណង របស់ លោក គឺ បើក ផ្ទះ សំណាក់ ដោយ ខ្លួន ឯង។
ប៉ុន្តែ មិន យូរ ប៉ុន្មាន គោល បំណង របស់ លោក សាង ខាវី ក៏ បាន ក្លាយ ជា ការ ពិត។
ផ្ទះ សំណាក់ របស់ លោក ខាវី មាន ពីរ អគារ ទល់ មុខ គ្នា ទីតាំង នៅ តាម បណ្តោយ ផ្លូវ លេខ ២៥៨ សម្រាប់ ជា លក្ខណ គ្រួសារ និង ភ្ញៀវ ទេសចរ សម្ពាយ។
បន្ទប់ ធំ សម្រាប់ មនុស្ស ពីរ ឬ បី នាក់ មាន ម៉ាស៊ីន ត្រជាក់ និង មាន យ៉ មាន តម្លៃ ១៥ ដុល្លារ អាមេរិក ក្នុង មួយ យប់។
ការ ប្រកួត ប្រជែង ជាមួយ ផ្ទះ សំណាក់ ដែល មាន តម្លៃ ទាប ជាង ២៥០ ក្នុង ទីក្រុង ភ្នំពេញ ត្រូវ បាន លោក ខាវី និយាយ ថា ទីផ្សារ ប្រមូល ផ្ដុំ នេះ មិន មាន បញ្ហា នោះ ទេ។
គុណភាព បន្ទប់ របស់ លោក គឺ អាច ប្រៀប ធៀប ជាមួយ នឹង ផ្ទះ សំណាក់ ផ្សេង ទៀត នៅ ក្នុង តំបន់ ប៉ុន្តែ លោក បញ្ចុះ អត្រា តម្លៃ ពីរ បី ដុល្លារ អាមេរិក ទាប ជាង ដើម្បី រក្សា បាន ការ ប្រកួត ប្រជែង។
លោក បាន បើក ដំណើរការ ផ្ទះ សំណាក់ របស់ លោក ដោយ មិន មាន អាជីវកម្ម ផ្លូវ ការ ឬ ការ បណ្ដុះ បណ្ដាល ពី របៀប បដិសណ្ឋារកិច្ច នោះ ទេ។
លោក ចាប់ ផ្ដើម ធ្វើ ការងារ នៅ ផ្ទះ សំណាក់ អូខេ ក្នុង ឋានៈ ជា អ្នក រត់ ម៉ូតូ ដឹក ទេសចរ។
ជំនាញ ភាសា អង់គ្លេស របស់ លោក ខាវ អាច ឲ្យ លោក រក ប្រាក់ សម្រាប់ តែ ទិញ អាហារ ហូប តែ ប៉ុណ្ណោះ។
មួយ ឆ្នាំ កន្លះ ក្រោយ មក ការ រត់ ឌុប ដឹក ភ្ញៀវ នៅ ផ្ទះ សំណាក់ អូខេ លោក ត្រូវ បាន គេ ផ្ដល់ ការងារ ជា អ្នក បម្រើ។
លោក បាន ចំណាយ ពេល មួយ ឆ្នាំ ធ្វើ ជា អ្នក រត់ រ៉ឺម៉ក ម៉ូតូ បន្ទាប់ ពី ឈប់ ធ្វើការ នៅ ផ្ទះ សំណាក់ អូខេ ខណៈ រង់ចាំ ការ វិនិយោគ ខាង ដី ធ្លី របស់ លោក។
«ទីតាំង មាន សារៈ សំខាន់ បំផុត គ្មាន នរណា ម្នាក់ នឹង ស្នាក់នៅ ទីនោះ ទេ ប្រសិន បើ អ្នក សាង សង់ ផ្ទះ សំណាក់ មួយ នៅ ក្នុង ទីតាំង មិន ត្រឹម ត្រូវ នោះ។
ធ្វើ ជា អ្នក រត់ រ៉ឺម៉ក ម៉ូតូ ខ្ញុំ គិត ឃើញ ពី កន្លែង ដែល ខ្ញុំ ត្រូវ សាង សង់ ផ្ទះ សំណាក់ នេះ»។
«ខ្ញុំ មាន កាត អាជីវកម្ម និង គេហទំព័រ ជា ភាសា អង់គ្លេស មាន ឈ្មោះ លេខ ទូរស័ព្ទ និង សារ អេឡិច ត្រូនិក របស់ ខ្ញុំ។
លោក បាន បន្ថែម ថា លោក មាន ការ មមាញឹក ច្រើន និង បាន កំណត់ ពេល វេលា ជា ថ្មី ចំពោះ ការងារ មួយ ចំនួន។
ការ រត់ រ៉ឺម៉ក ម៉ូតូ របស់ លោក បាន បង្កើត បណ្ដាញ របស់ អ្នក រត់ រ៉ឺម៉ក ម៉ូតូ ជា មិត្តភក្ដិ ក្នុង ការ នាំ ភ្ញៀវ នៅ ក្នុង ផ្ទះ សំណាក់ ផង ដែរ។
លោក បន្ត ផ្ដល់ ថ្លៃ ទឹក តែ ដល់ អ្នក រត់ រ៉ឺម៉ក ម៉ូតូ ជា ច្រើន ដែល បាន នាំ ភ្ញៀវ ទេសចរ មក ស្នាក់នៅ ផ្ទះ សំណាក់ របស់ លោក។
ផែនការ ទីផ្សារ របស់ លោក បាន ដំណើរការ យ៉ាង ល្អ ប្រសើរ ជាង ការ សង្ឃឹម ទុក។
លោក និយាយ ថា ផ្ទះ សំណាក់ នេះ គឺ ស្ទើរ តែ ពេញ ជានិច្ច នៅ ក្នុង ពេល បើក ដំណើរការ លើក ដំបូង។
លោក ត្រូវ ត្រឡប់ ទៅ រក ភ្ញៀវ ទេសចរ ឆ្ងាយៗ ដែល មាន សក្ដានុពល។
ក្រៅ ពី ការ រត់ រ៉ឺម៉ក ម៉ូតូ ជុំវិញ ទីក្រុង ភ្នំពេញ លោក បាន ប្រើ ឈ្មោះ សាង ធ្វើ ជា អ្នក បើកបរ រថយន្ត ឈ្នួល ក្នុង ការ ធ្វើ ដំណើរ កម្សាន្ត ទៅ កាន់ ក្រុង ព្រះសីហនុ ខេត្ត កំពត និង កែប។
ក្នុង អំឡុង ការ ធ្វើ ដំណើរ នេះ មិត្តភក្ដិ ថ្មីៗ ជាច្រើន បាន ពិភាក្សា គ្នា អំពី លទ្ធភាព ផែនការ របស់ លោក និង ការ វិនិយោគ ក្នុង ការ បង្កើត ផ្ទះសំណាក់ នេះ។
លោក សាង ខាវី និយាយ ថា ពេល នោះ លោក ដំណើរការ ផ្ទះ សំណាក់ ផ្ទាល់ របស់ លោក ដោយ លើក ឡើង ថា សុបិន បន្ទាប់ មក ទៀត គឺ ទិញ អចលន ទ្រព្យ នៅ ក្បែរ នោះ ដើម្បី ចាប់ ផ្ដើម ធ្វើ ជា សណ្ឋាគារ ថ្នាក់ ផ្កាយ ៣។
កែបៈ មន្រ្តី មន្ទីរ ទេសចរណ៍ ខេត្ត កែប រំពឹង ថា ភ្ញៀវ ទេសចរ និង អ្នក ដំណើរ យ៉ាង ហោច ណាស់ ២០ ម៉ឺន នាក់ នឹង ចូល រួម ពិធី បុណ្យ សមុទ្រ នៅ ចុង ឆ្នាំ នេះ។
ពិធី បុណ្យ សមុទ្រ ត្រូវ បាន អាក់ ខាន មួយ ឆ្នាំ ក្នុង ឆ្នាំ កន្លង ទៅ ដោយ សារ ប្រជារាស្រ្ត ខ្មែរ កាន់ ទុក្ខ ការ ចូល ទិវង្គត អតីត ព្រះ ករុណា ព្រះ មហាវីរក្សត្រ ក្នុង ខែ តុលា ឆ្នាំ ២០១២។
រដ្ឋាភិបាល បាន រៀបចំ ពិធី បុណ្យ សមុទ្រ លើក ទី មួយ នៅ ខេត្ត ព្រះ សីហនុ ដែល ទាក់ ទាញ មនុស្ស រាប់ ម៉ឺន នាក់ ទៅ ចូល រួម កម្សាន្ត ដោយ គ្រាន់ តែ ថ្ងៃ ទីមួយ មនុស្ស ប្រមាណ ៥ ម៉ឺន នាក់ ត្រូវ គេ ប៉ាន់ ស្មាន ថា បាន ចូល រួម។
លោក សោម ចិន្តា ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត កែប បាន និយាយ ថា ពិធី បុណ្យ សមុទ្រ ដែល នឹង ប្រារព្ធ ធ្វើ នៅ ខេត្ត កែប ក្នុង ឆ្នាំ នេះ មិន មាន អ្វី ប៉ះពាល់ ទៀត នោះ ទេ។
រដ្ឋាភិបាល បាន សម្រេច ប្រារព្ធ ពិធី បុណ្យ នៅ ថ្ងៃ ទី៧ និង ទី៨ ខែ ធ្នូ ឆ្នាំ នេះ ។
«យើង បាន ត្រៀម ខ្លួន ចំពោះ ការ ខ្វះខាត នេះ ដោយ ផ្សព្វ ផ្សាយ ឲ្យ ប្រជា ពលរដ្ឋ ចូល រួម ដើម្បី សម្រួល ដល់ ការ ស្នាក់នៅ របស់ ភ្ញៀវ»។
លោក បន្ថែម ថា ពិធី បុណ្យ សមុទ្រ នេះ នឹង ត្រូវ ប្រារព្ធ ឡើង ស្រប ពេល ដែល កម្ពុជា ប្រារព្ធ មហា សន្និបាត ឆ្នេរ សមុទ្រ ស្អាត នៅ រមណីយដ្ឋាន ស្ថានសួគ៌ បូកគោ ដែល មាន ប្រទេស ជា សមាជិក ក្លិប ឆ្នេរ ស្អាត ក្នុង ពិភពលោក មក ចូល រួម ផង ដែរ។
លោក ថោង ខុន រដ្ឋ មន្រ្តី ក្រសួង ទេសចរណ៍ បាន ថ្លែង កាល ពី ខែ ឧសភា ថា មហា សន្និបាត នឹង មាន ការ ចូល រួម ពី មន្រ្តី ជាច្រើន មក ពី បណ្ដា ប្រទេស ជាច្រើន នៅ លើ ពិភពលោក។
លោក បន្ថែម ថា រហូត មក ដល់ ពេល នេះ ឆ្នេរ សមុទ្រ ដែល បាន ក្លាយ ជា សមាជិក របស់ ឆ្នេរ ស្អាត បំផុត លើ ពិភពលោក មាន ចំនួន ៣៩ ឆ្នេរ ក្នុង ប្រទេស ចំនួន ៣០ លើ ពិភពលោក។
ឆ្នេរ កម្ពុជា ត្រូវ បាន ទទួល ស្គាល់ ជា ផ្លូវ ការ ថា ជា សមាជិក ក្លិប ឆ្នេរ ស្អាត បំផុត របស់ ពិភពលោក នៅ ថ្ងៃ ទី២៦ ខែ ឧសភា ឆ្នាំ ២០១១។
លោក អ៊ុយ វុនលី ម្ចាស់ ផ្ទះ សំណាក់ ចំប៉ី ស ដែល មាន ១៣ បន្ទប់ នៅ ខេត្ត កែប បាន និយាយ ថា លោក រំពឹង ថា កំណើន ភ្ញៀវ នឹង កើន ឡើង ខ្លាំង នៅ ថ្ងៃ ប្រារព្ធ ពិធី បុណ្យ នោះ ហើយ ភ្ញៀវ មួយ ចំនួន នឹង ទៅ រក កន្លែង ស្នាក់នៅ ខេត្ត កំពត ដែល មាន ចម្ងាយ មិន ឆ្ងាយ ប៉ុន្មាន ពី កន្លែង ប្រារព្ធ ពិធី នោះ៕
តាម លទ្ធផល ឆមាស ទី១ ឆ្នាំ នេះ ដែល ចេញ ផ្សាយ ពី ម្សិលមិញ បង្ហាញ ថា ប្រាក់ ចំណេញ ប្រតិបត្តិការ សម្រាប់ ៦ ខែ ដំបូង បាន កើន ដល់ ៣៣៨ លាន ដុល្លារ ធៀប នឹង ២៨១ លាន ដុល្លារ កាល ពី ឆ្នាំ ទៅ។
អ្នក នាំ ពាក្យ របស់ សណ្ឋាគារ នេះ និយាយ ថា ពួក គេ មិន អាច បង្ហាញ ពី ព័ត៌មាន លម្អិត ស្ដី ពី ដំណើរការ ហិរញ្ញវត្ថុ របស់ សាខា ក្នុង ស្រុក បាន ទេ។
លោក បន្ត ថា សរុប តាម ការ ប៉ាន់ ប្រមាណ មាន សណ្ឋាគារ ចំនួន ៥១០ ត្រូវ បាន ចុះ បញ្ជី នៅ ក្នុង ប្រទេស ធៀប នឹង ផ្ទះ សំណាក់ ដែល មាន ប្រហែល ១ ២០០៕
យោងតាម ទិន្នន័យ ពី លេខាធិការដ្ឋាន ច្រកចេញ ចូល តែ មួយ សម្រាប់ បំពេញ បែបបទ នាំ ចេញ អង្ករ កម្ពុជា បាន នាំ ចេញ អង្ករ សរុប ចំនួន ២០៧ ៣៧០ តោន ក្នុង រយៈពេល ៧ ខែ ដំបូង ដែល ចំនួន សម្រេច បាន លើស ពី ការ នាំ ចេញ សរុប ក្នុង មួយ ឆ្នាំ ពេញ កាលពី ឆ្នាំ មុន ដែល មាន ត្រឹម តែ ២០៥- ៧១៧ តោន តែ ប៉ុណ្ណោះ ។
លោក បាន អះអាង ថា ម្យ៉ាង ទៀត អ្នក នាំ ចេញ អង្ករ នៅ កម្ពុជា ជាច្រើន ក៏ បាន សម្រុក បញ្ចេញ អង្ករ ដែល នៅក្នុង ស្តុក ដោយសារ ការ ប្រមូល ផល នៅ រដូវកាល ថ្មី ក៏ ជិត ចូល មក ដល់ ។
ទីផ្សារ សំខាន់ សម្រាប់ នាំ ចេញ អង្ករ កម្ពុជា មាន ភាគច្រើន ទៅ ទីផ្សារ សហគមន៍ អឺរ៉ុប ដែល តំណាង ប្រមាណ ៦០ ភាគរយ នៃ ចំណែក ទីផ្សារ សរុប របស់ កម្ពុជា ។
លោក គឹម សាវុធ អគ្គនាយក ក្រុមហ៊ុន នាំ ចេញ អង្ករ ខ្មែរហ្វូត និង ជា ប្រធាន សម្ព័ន្ធ អ្នក នំា ចេញ អង្ករ កម្ពុជា បាន ឲ្យ ដឹង ថា ការ នាំ ចេញ អង្ករ នៅ កម្ពុជា នៅ ក្នុង ឆ្នាំ នេះ មាន ស្ថានភាព ល្អ ខ្លាំង ជាង កាលពី ឆ្នាំ មុន ហើយ ទីផ្សារ នាំ ចេញ ថ្មី ៗ ជាច្រើន ក៏ មាន ការ កើនឡើង ផង ដែរ ។
អ្នកផ្គត់ផ្គង់កូនបង្កងកំពុងប្រឈមបញ្ហា
ភ្នំពេញៈ កង្វះ បច្ចេកទេស និង ដើមទុន បាន ធ្វើឲ្យ ម្ចាស់ កសិដ្ឋាន ចិញ្ចឹម បង្កង មួយ ចំនួន បោះបង់ ការ ចិញ្ចឹម ។
ម្ចាស់ កសិដ្ឋាន ផ្គត់ផ្គង់ កូន បង្កង សម្រាប់ កសិករ យក ទៅ ចិញ្ចឹម បន្ត ជាច្រើន បោះបង់ ការ ភ្ញាស់ កូនបង្កង ដោយ អះអាង ថា គ្មាន ការ បញ្ជា ទិញ ពី កសិករ ទេ នៅ ឆ្នាំ នេះ ។
លោក សង្កេត ឃើញ ថា កសិករ ភាគច្រើន ដែល ធ្លាប់ បញ្ជា ទិញ កូន បង្កង បាន បោះបង់ ការ ចិញ្ចឹម បង្កង ព្រោះ គេ បាន សាកល្បង ក្នុង ឆ្នាំ កន្លង មក តែ ពុំ ទទួល បាន ផល ។
លោក និយាយ ថា តម្រូវការ កូនបង្កង បាន កើតឡើង ប្រមាណ ពីរ-បី ឆ្នាំ ប៉ុណ្ណោះ ប៉ុន្តែ បន្ទាប់ ពី ការ បរាជ័យ របស់ កសិករ ។
យោង តាម របាយការណ៍ របស់ ក្រសួង កសិកម្ម ដែល ចេញ ក្នុង ទិវា មច្ឆាជាតិ ក្នុង ខែ កក្កដា ប្រទេស កម្ពុជា មាន កន្លែង ភ្ញាស់ ត្រី ជា លក្ខណៈ គ្រួសារ ចំនួន ២៨០ កន្លែង ស្ថិត ក្រោម ការ ផ្តល់ និង បណ្តុះបណ្តាល ផ្នែក បច្ចេកទេស ពី រដ្ឋបាល ជលផល លើ ការ ចិញ្ចឹម និង ភ្ញាស់ ដល់ កសិករ ។
« អ្នក ចិញ្ចឹម មិន ប្រាកដ ថា គាត់ ចិញ្ចឹម បាន ទទួល ជោគជ័យ ទាំងអស់ គ្នា ទេ ។
អ្នក ខ្លះ ចិញ្ចឹម គ្រាន់ ជា ការ សាកល្បង ប៉ុណ្ណោះ » ។
កម្ពុជារៀបចំពិព័រណ៍គ្រឿងយន្ត
ពិព័រណ៍ នេះ នឹង មាន ក្រុមហ៊ុន តាំង ពិព័រណ៍ ជាង ២០០ មកពី បណ្ដា ប្រទេស ចំនួន ២០ ដែល មាន ស្តង់ ពិព័រណ៍ ចំនួន ៣៦០ ស្ដង់ ។
ព្រឹត្តិការណ៍ នេះ រួម មាន វិស័យ សំខាន់ ចំនួន ១០ ដូចជា វិស័យ កៅស៊ូ និង ថង់ប្លាស្ទិក បោះពុម្ព និង ការ វេចខ្ចប់ វិស័យ កែច្នៃ ម្ហូបអាហារ កសិកម្ម ពេទ្យ និង ឱសថ ការងារ លោហធាតុ និង ស្វ័យប្រវត្តិកម្ម ឧបករណ៍ និង ផ្នែក រឹង វាយនភ័ណ្ឌ និង សម្លៀកបំពាក់ ស្បែកជើង និង ផលិតផល ស្បែក សត្វ និង សម្ភារ សំណង់ ។
លោក ចម ប្រសិទ្ធ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម បាន និយាយ ថា ពិព័រណ៍ នេះ គឺ បម្រើ មិន គ្រាន់ តែ ជា វេទិការ នាំ យក ផលិតផល និង បច្ចេកវិទ្យា ថ្មី ៗ ដល់ វិស័យ ឧស្សាហកម្ម របស់ ប្រទេស ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែម ទាំង ផ្ដល់ ឱកាស ដល់ ការ ទាក់ទាញ ការ វិនិយោគ និង សម្រាប់ ប្រជាជន ក្នុង តំបន់ ដើម្បី ស្វែងយល់ និង ស្វែងរក ដៃគូ ។
« ការ រៀបចំ ពិព័រណ៍ នេះ គឺ សំដៅ លើក កម្ពស់ ការ អភិវឌ្ឍ ឧស្សាហកម្ម និង ការ វិនិយោគ បរទេស នៅ កម្ពុជា ជាពិសេស ដើម្បី បង្កើន សកម្មភាព នាំចូល នាំចេញ »។
« ជាមួយ គ្នា នេះ ដែរ ដើម្បី បង្កើត ឱកាស សម្រាប់ អ្នក រកស៊ី ក្នុង វិស័យ ឧស្សាហកម្ម ក្នុង ការ ធ្វើ ឲ្យ ប្រសើរ ឡើង នូវ ឧបករណ៍ ចាស់ ៗ ការ ស្វែងរក កិច្ចសហប្រតិបតិ្តការ រួម និង ការ ស្វែងរក ឱកាស ក្នុង ការ ធ្វើ អាជីវកម្ម »។
« កម្ពុជា ចាំបាច់ ត្រូវ ធ្វើ ពិពិធកម្ម សកម្មភាព សេដ្ឋកិច្ច និង លើក កម្ពស់ ការ នាំ ចេញ ដើម្បី សម្រេច បាន កំណើន សេដ្ឋកិច្ច ខ្ពស់ ប្រកប ដោយ ស្ថិរភាព និង ផលិតផល បន្ថែម តម្លៃ កាន់ តែ ខ្ពស់ »៕
ប្រាក់ប្រមាណ ៤ លានដុល្លារត្រូវដកចេញពីធនាគារ អេស៊ីលីដា
ការ ដក ប្រាក់ ភាគ ច្រើន បាន កើត ឡើង នៅ ទីក្រុង ភ្នំពេញ កាល ពី ថ្ងៃ អាទិត្យ ដោយ មាន ការ តម្រង់ ជួរ ដ៏ វែង នៅ ចាំ ដក ប្រាក់ ពី ម៉ាស៊ីន អេធីអឹម។
ខណៈ បរិយាកាស បាន ស្ងាត់ ស្ងៀម ចក្ខុ វិស័យ នៅ មិន ទាន់ ច្បាស់ លាស់។
លទ្ធផល បឋម របស់ គណបក្ស ប្រជាជន កម្ពុជា គឺ គណបក្ស នេះ ឈ្នះ ៦៨ ហើយ គណបក្ស សង្គ្រោះ ជាតិ បាន ៥៥ អាសនៈ ប៉ុន្តែ លទ្ធផល របស់ បក្ស សង្គ្រោះ ជាតិ គឺ គណបក្ស ប្រឆាំង ធំ មួយ នេះ ឈ្នះ បាន ៦៣ អាសនៈ។
លោក អ៊ិន ចាន់នី ប្រធាន ធនាគារ អេស៊ីលីដា ឲ្យ ដឹង ថា កាល ពី ថ្ងៃ អាទិត្យ ពេល ការ ដក ប្រាក់ បាន កើន ឡើង ម៉ាស៊ីន អេធីអឹម ជាច្រើន អស់ ប្រាក់។
«ដោយ សារ នៅ ក្នុង ម៉ាស៊ីន អេធីអឹម យើង មាន ប្រាក់ រៀល និង ដុល្លារ អតិថិជន ភាគ ច្រើន ដក យក តែ ប្រាក់ ដុល្លារ ដូច្នេះ យើង នៅ មាន ប្រាក់ រៀល។
វិស័យ ទេសចរណ៍ កម្ពុជា គ្មាន រង ផល ប៉ះពាល់ ដោយសារ ការ បោះ ឆ្នោត ទេ។
អង់តែនអឹមហ្វូនត្រូវគេដាក់លក់
ភ្នំពេញៈ ទោះបី ក្រុមហ៊ុន អឹមហ្វូន ត្រូវ បាន ក្ស័យធន ហើយ ក្តី ប៉ុន្តែ គេ នៅ ឃើញ មាន អង់តែន ជាច្រើន លើ ដំបូល អគារ នៅ រាជធានី ភ្នំពេញ ដែល មិន ដំណើរការ និង ត្រូវ បាន ប្រកាស ដាក់ លក់ ។
បច្ចុប្បន្ន លោក អ៊ុក រី អភិបាល បណ្តោះអាសន្ន ក្រុមហ៊ុន អឹមហ្វូន កំពុង ស្វែងរក អ្នក ទិញ សម្ភារ និង ឧបករណ៍ ផ្សេង ៗ របស់ ក្រុមហ៊ុន ដែល នៅ សល់ រួម ទាំង អង់តែន ផង ដើម្បី សង លុយ ម្ចាស់ បំណុល ។
« អង់តែន របស់ ក្រុមហ៊ុន ទូរស័ព្ទ ជាច្រើន បាន ដំឡើង នៅ ជិត ៗ គ្នា ដូច្នេះ ក្រុមហ៊ុន ផ្សេង ទៀត ប្រហែល ជា មិន ចាំបាច់ ត្រូវការ អង់តែន ទាំងនោះ ដើម្បី បន្ថែម លើ ប្រព័ន្ធ ដំណើរការ របស់ ពួកគេ ឡើយ » ។
បន្ថែម ពី នេះ គាត់ មិន ដែល មាន ព័ត៌មាន ឬ កិច្ចពិភាក្សា ណា មួយ នៅ ឡើយ ទាក់ទង បញ្ហា នេះ នោះ ដែរ ។
ម្ចាស់ ផ្ទះ ម្នាក់ ទៀត សូម មិន បញ្ចេញ ឈ្មោះ ដែល មាន ទីតាំង នៅ ខណ្ឌ ទួលគោក និង បាន ជួល ទីតាំង លើ ដំបូល ផ្ទះ របស់ គាត់ ទៅ ឲ្យ ក្រុមហ៊ុន អឹមហ្វូន ដែរ នោះ បាន លើក ឡើង ថា កិច្ចសន្យា នេះ បាន បញ្ចប់ តាំងពី ខែ តុលា មក ម្ល៉េះ ហើយ បាន ធ្វើ កិច្ចសន្យា ថ្មី ក្នុង តម្លៃ ៥០០ ដុល្លារ ក្នុង មួយ ខែ។
តែ ចាប់ តាំងពី មាន កិច្ចសន្យា ថ្មី នេះ មក អ្នកស្រី មិន ដែល បាន ទទួល ប្រាក់ ពី ការ ជួល នេះ ឡើយ ។
« ខាង ក្រុមហ៊ុន អត់ មាន ផ្តល់ ដំណោះស្រាយ អ្វី សោះ គឺ ស្ងាត់ ឈឹង ។
ក្រុមហ៊ុន អឹមហ្វូន បាន ជំពាក់ បំណុល ដល់ ម្ចាស់ បំណុល សរុប ១៦០ លាន ដុល្លារ ។
« ក្រុមហ៊ុន អឹមហ្វូន គឺ ហាក់ ដូច មាន ភាព លំបាក ក្នុង ការ ចរចា លក់ អង់តែន ដែល នៅ សេសសល់ ទាំងនោះ ។
ខ្ញុំ អាច និយាយ បាន ថា វា ជា កិច្ចការ ដ៏ លំបាក មួយ សម្រាប់ អ្នក ទទួល ខុសត្រូវ ចំពោះ បញ្ហា នេះ »។
ក្តីព្រួយបារម្ភធ្វើឲ្យកម្មកររោងចក្រមកធ្វើការយឺត
ភ្នំពេញៈ នៅ ពេល រោងចក្រ កាត់ដេរ បាន បើក ទ្វារ វិញ បន្ទាប់ ពី ការ បោះឆ្នោត កាល ពី ថ្ងៃ អាទិត្យ ចាន់ នឿន កម្មការិនី មក ពី ខេត្ត ព្រៃវែង មិន បាន ត្រឡប់ មក ធ្វើ ការ វិញ នៅ ឡើយ ទេ។
កម្មការិនី រូប នេះ និយាយ ថា៖
«ខ្ញុំ មិន បាន ទៅ ធ្វើ ការ ដោយ សារ តែ ឪពុក របស់ ខ្ញុំ មិន អនុញ្ញាត ឲ្យ ខ្ញុំ មក ទីក្រុង ភ្នំពេញ។
អ្នក ជិត ខាង បាន ប្រាប់ ថា នៅ ទី នោះ មាន នគរបាល និង ទាហាន ជា ច្រើន កំពុង ឈរ យាម ក្នុង ទីក្រុង ភ្នំពេញ ហើយ ផ្លូវ សំខាន់ៗ មួយ ចំនួន ត្រូវ បាន បិទ»។
ការ ធ្វើ កុបកម្ម និង ការ បង្ក្រាប ដ៏ ខ្លាំង ក្លា ដោយ យោធា គឺ គ្រាន់ ជា ពាក្យ ចចាម អារ៉ាម តែ ប៉ុណ្ណោះ និង បញ្ជូន ចេញ កាល ពី ថ្ងៃ អាទិត្យ ដោយ សារ កម្ពុជា បាន រង់ចាំ ការ ប្រកាស លទ្ធផល នៃ ការ បោះឆ្នោត ដែល នឹង មក ដល់។
ពាក្យ ចចាម អារ៉ាម ពី ភាព ចលាចល របស់ ប្រជាជន ភាគ ច្រើន បាន និយាយ បំផ្លើស ដែល បាន ឮ ដល់ កម្មករ រោងចក្រ កាត់ដេរ ដូច្នេះ ពួក គេ ភាគ ច្រើន បាន ជ្រើស រើស យក ការ មិន មក ធ្វើ ការ ជា ជាង ប្រថុយ ការ ដើរ ចូល ក្នុង ស្ថានភាព ដ៏ មាន គ្រោះថ្នាក់ នេះ។
ទោះ បី សារាចរ របស់ ក្រសួង ការងារ តម្រូវ ឲ្យ ថៅកែ រោងចក្រ ជាច្រើន ត្រូវ ឲ្យ កម្មករ សម្រាក សម្រាប់ ធ្វើ ដំណើរ ទៅ ស្រុក ចាប់ ពី ថ្ងៃ ទី ២៧ ដល់ ថ្ងៃ ទី ២៩ ខែ កក្កដា ក៏ ការ ដឹក ជញ្ជូន ត្រឡប់ មក វិញ និង ការ ភ័យ ខ្លាច ពី អស្ថិរភាព បាន ធ្វើ ឲ្យ កម្មករ ជាច្រើន ត្រឡប់ មក វិញ មិន ទាន់ ពេល។
លោក បន្ថែម ថា នៅ ថ្ងៃ សម្រាក ដូច ជា បុណ្យ ចូល ឆ្នាំ ខ្មែរ និង បុណ្យ អុំទូក មាន តែ កម្មករ តិច ជាង ១៥ ភាគរយ ប៉ុណ្ណោះ ដែល ត្រឡប់ មក ធ្វើ ការ យឺត។
លោក សង្ឃឹម ថា បុគ្គលិក ទាំង អស់ របស់ លោក អាច ត្រឡប់ មក វិញ ចុង សប្ដាហ៍ នេះ។
សុផារី និយាយ ពេល ត្រឡប់ មក ពី ខេត្ត ស្វាយរៀង តាម តាក់ស៊ី កាល ពី ថ្ងៃ អង្គារ ថា ៖
«ខ្ញុំ ក៏ មាន ការ ភ័យ ខ្លាច និង ការ ព្រួយ បារម្ភ ផង ដែរ អំពី សុវត្ថិភាព នៅ ក្នុង ទីក្រុង ភ្នំពេញ ។
លោក រ៉ុង ឈុន ប្រធាន សហភាព សម្ព័ន្ធ កម្ពុជា បាន បញ្ជាក់ ពី អវត្តមាន របស់ កម្មករ រោងចក្រ ក្នុង កម្រិត ខ្ពស់ ថា មក ពី ការ ភ័យ ខ្លាច អំពើ ហិង្សា ដែល ជាប់ ទាក់ ទង ជាមួយ នឹង ការ បោះឆ្នោត។
បើ ពួកគេ ត្រឡប់ មក ក្នុង រង្វង់ ពីរ ថ្ងៃ បន្ទាប់ ពេល នោះ វា គ្រាន់ តែ ជា រឿង ធម្មតា ប៉ុណ្ណោះ»៕
ទេសចរឆ្លងកាត់ច្រកព្រំដែនមិនប្រែប្រួល
ភ្នំពេញៈ បើ ទោះ បី ស្ថានភាព ក្នុង ប្រទេស កម្ពុជា មាន ភាព អាប់អួ ខ្លះៗ ក្រោយ ថ្ងៃ បោះឆ្នោត ជ្រើស រើស តំណាង រាស្រ្ត ទើប បាន បញ្ចប់ ទៅ ក្តី ក៏ ចំនួន ភ្ញៀវ ទេសចរ ដែល ចូល មក កាន់ កម្ពុជា មិន មាន ភាព ប្រែ ប្រួល នៅ ប៉ុន្មាន ថ្ងៃ ចុង ក្រោយ នេះ។
នេះ បើ យោង តាម ការ អះអាង របស់ មន្ត្រី នៅ តាម ច្រក ព្រំដែន។
មន្ត្រី នគរបាល នៅ តាម ច្រក អន្តរជាតិ បាវិត ក្នុង ខេត្ត ស្វាយរៀង ដែល ថ្លែង ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ ម្សិលមិញ ថា កាល ពី ថ្ងៃ ទី៣០ ខែ កក្កដា ចំនួន អ្នក ធ្វើ ដំណើរ ឆ្លង កាត់ ចូល តាម ច្រក នេះ មាន ចំនួន ១ ៩៩០ នាក់ ហើយ ចំនួន អ្នក ដំណើរ ចាក ចេញ មាន ចំនួន ១ ៨៤៦ នាក់។
លោក បាន លើក ឡើង ថា សា្ថនភាព ភ្ញៀវ ធ្វើ ដំណើរ ហាក់ មិន មាន ភាព ប្រែប្រួល នោះ ទេ រួម ទាំង អ្នក ដំណើរ ជនជាតិ វៀតណាម ចូល មក កាន់ កម្ពុជា ក្នុង រយៈ ពេល នេះ បើ ទោះ បី ជា ប្រទេស កម្ពុជា ទើប បញ្ចប់ ការ បោះឆ្នោត សកល ដែល មិន ទាន់ ប្រកាស លទ្ធផល ឈ្នះ ចាញ់ ជា ផ្លូវការ ក្តី។
នៅ ព្រំដែន ជាប់ គ្នា ជាមួយ ភាគី ថៃ វិញ ការ ធ្វើ ដំណើរ ចូល មក កាន់ កម្ពុជា ក៏ មិន មាន ការ ប្រែប្រួល ដែរ បន្ទាប់ ពី ការ បោះឆ្នោត បាន បញ្ចប់ ទៅ ថ្មីៗ នេះ។
