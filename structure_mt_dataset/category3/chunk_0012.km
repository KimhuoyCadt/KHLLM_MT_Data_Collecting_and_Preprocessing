រដ្ឋាករទឹកដំឡើងផ្ទាំងសូឡាបន្ថយការចំណាយ
ភ្នំពេញៈ ក្រុមហ៊ុន រដ្ឋាករទឹក ស្វយ័ត ក្រុង ភ្នំពេញ (PPWSA) បាន បើក ដំណើរការ ជា ផ្លូវការ ផ្ទាំង ផលិត អគ្គិសនី ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ កាលពី សប្តាហ៍ មុន សម្រាប់ ផ្គត់ផ្គង់ អគ្គិសនី ប្រើប្រាស់ ផ្ទាល់ ខ្លួន និង ដើម្បី កាត់ បន្ថយ ចំណាយ លើ ថ្លៃ អគ្គិសនី ដែល រំពឹង ថា ធ្វើឲ្យ ចំណាយ ថយ ចុះ ២០ ម៉ឺន ដុល្លារ ក្នុង មួយ ឆ្នាំៗ។
តំណាង ក្រុមហ៊ុន បាន លើក ឡើង ថា និន្នាការ ចំណាយ លើ ថ្លៃ ដើម នឹង នៅ តែ បន្ត ថយ ចុះ ខណៈ ដែល ប្រាក់ ចំណេញ ពី ប្រតិបត្តិការ អាជីវកម្ម មាន កំណើន ដែល កត្តា នេះ ជា ផលវិជ្ជមាន មួយ សម្រាប់ ភាគហ៊ុនិក ដែល កំពុង ចូលរួម វិនិយោគ ក្នុង PPWSA។
លោក រស់ គឹមលាង អគ្គនាយក រង PPWSA ទទួល បន្ទុក ហិរញ្ញកិច្ច និង ទីផ្សារ មូលបត្រ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា ប្រភព អគ្គិសនី ពី ពន្លឺ ព្រះអាទិត្យ នេះ នឹង រួម ចំណែក កាត់បន្ថយ ការ ពឹងផ្អែក លើ ការ ចំណាយ លើ ថ្លៃ អគ្គិសនី ដើម្បី ធ្វើឲ្យ ថ្លៃ ដើម ក្នុង ការ ផលិត របស់ PPWSA ថយ ចុះ ជាង មុន។
« មួយ ផ្នែក វា បាន ជួយ កាត់បន្ថយ ចំណាយ ការ ប្រើប្រាស់ ។
លោក បាន បន្ត ថា ចំណាយ លើ ការ ដំឡើង និង ថ្លៃ ផ្ទាំង ផលិត អគ្គិសនី មាន ទឹកប្រាក់ សរុប ប្រមាណ ៧ លាន ដុល្លារ វិនិយោគ ក្រោម ជំនួយ ឥត សំណង របស់ រដ្ឋាភិបាល ប្រទេស ជប៉ុន ។
ផ្ទាំង អគ្គិសនី ដើរ ដោយ ពន្លឺ ព្រះអាទិត្យ នេះ មាន ទីតាំង នៅ ភូមិ ព្រែក សង្កាត់ ស្រះចក ខ័ណ្ឌ ដូនពេញ ។
ប្រភព ថាមពល ជា លក្ខណៈ ធម្មជាតិ នេះ អាច ផ្តល់ អគ្គិសនី ដែល មាន អានុភាព ប្រមាណ ១ លាន គីឡូវ៉ាត់ ម៉ោង ក្នុង មួយ ឆ្នាំ ហើយ តាមរយៈ ប្រភព អគ្គិសនី ផ្ទាល់ ខ្លួន នេះ PPWSA អាច កាត់បន្ថយ ការ បំភាយ កាបូនឌីអុកស៊ីដ ប្រមាណ ៦៤០ តោន ក្នុង មួយ ឆ្នាំៗ និង អាច សន្សំ ពី ការ ចំណាយ លើ ថ្លៃ អគ្គិសនី បាន ប្រមាណ ២០ ម៉ឺន ដុល្លារ ក្នុង មួយ ឆ្នាំ។
PPWSA គឺជា ក្រុមហ៊ុន តែ មួយ គត់ ដែល ផ្គត់ផ្គង់ ទឹក ដល់ ប្រជាជន ក្នុង រាជធានី ភ្នំពេញ ហើយ បច្ចុប្បន្ន ក្រុមហ៊ុន មាន អតិថិជន ជិត ២ លាន គ្រួសារ ។
លោក ស្វាយ ហៃ អគ្គនាយក ក្រុមហ៊ុន អេស៊ីលីដា ស៊ិឃ្យូរីធី បាន ឲ្យ ដឹង ថា ការ បង្ហាញ ពី កំណើន ប្រាក់ ចំណេញ របស់ PPWSA និង នីតិវិធី នានា ទាក់ទង នឹង ការ កាត់បន្ថយ ថ្លៃ ដើម គឺជា ការ ល្អ ដើម្បី បង្ហាញ ពី ប្រសិទ្ធភាព ប្រតិបត្តិការ និង សម្រាប់ លើក ទឹកចិត្ត ដល់ ភាគហ៊ុនិក ដែល កំពុង កាន់ ហ៊ុន PPWSA ក្នុង ដៃ។
« ពេល មាន ក្រុមហ៊ុន បោះ ផ្សាយ កាន់តែ ច្រើន ហើយ ក្រុមហ៊ុន បច្ចុប្បន្ន ដែល បាន ចុះ បញ្ជី បាន ទទួល ប្រាក់ចំណេញ កើនឡើង អ៊ីចឹង វិនិយោគិន គាត់ អាច ទិញ ភាគហ៊ុន មាន ស្រាប់ ដែល បាន បោះ ផ្សាយ ហើយ និង មាន ទឹកចិត្ត ត្រៀម ទិញ ភាគហ៊ុន ថ្មី»៕
នៅក្នុង បទ បង្ហាញ កាល ពី ថ្ងៃ ម្សិលមិញ វិនិ យោគិន ជា ច្រើន បាន លើកឡើង ពី បញ្ហាប្រឈម នានា នៅក្នុងឧស្សាហកម្មកាត់ ដេរ របស់កម្ពុជា ក្នុង រយៈ ពេល ថ្មី ៗ នេះ ផង ដែរ។
មានក្រុម ហ៊ុន អាកាសចរ ណ៍ កាន់ តែ ច្រើន កាន់តែ ល្អ ប្រសើរ ។
ប៉ុន្តែ ខ្ញុំ គិតថា យើង មិនធ្វើ ការងារ តាម របៀប នោះទេ ។
ក្រសួង ទេសចរ ណ៍ កំពុង ព្យា យាម ដើម្បី លើក កម្ពស់ តំបន់ ឆ្នេរ សមុទ្រ តាម រយៈ ការត ភ្ជាប់ ពី ខេត្ត សៀមរាប ជា ទី ក្រុង បុរាណ។
យកស្តុកស្រូវជាវត្ថុបញ្ចាំនៅតែជាបញ្ហាសម្រាប់ទទួលបានកម្ចី
ភ្នំពេញៈ ការ ទទួល យក ស្រូវ ក្នុង ស្តុក ជា ទ្រព្យ បញ្ចាំ ដើម្បី ទទួល បាន កម្ចី នៅ តែ ជា ឧបសគ្គ សម្រាប់ វិស័យ ស្រូវ អង្ករ នៅ កម្ពុជា ខណៈ អ្នក ជំនាញ និយាយ ថា ដំណើរការ របស់ រោង ម៉ាស៊ីន កិន ស្រូវ នៅ មិន ទាន់ ឆ្លើយតប ទៅ នឹង តម្រូវការ របស់ ស្ថាប័ន ហរិញ្ញវត្ថុ នៅ ឡើយ ទេ ។
លោក លឹម ប៊ុនហេង អគ្គនាយក ក្រុមហ៊ុន ឡូរ៉ង់ និង ជា សហប្រធាន នៃ ក្រុម ការងារ វិស័យឯកជន ផ្នែក ស្រូវ អង្ករ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា កត្តា ខ្វះ ទុន ក្នុង ការ ទិញ ស្រូវ ស្តុក ទុក នៅ តែ ជា ឧបសគ្គ សម្រាប់ រោង ម៉ាស៊ីន កិន ស្រូវ ក្នុង ស្រុក ជាច្រើន ។
លោក បន្ត ថា ធនាគារ ទទួល យក តែ អចលនទ្រព្យ ជា របស់ បញ្ចាំ ប៉ុណ្ណោះ ហើយ ការ វាយតម្លៃ លើ អចលនទ្រព្យ នោះ មាន កម្រិត ទាប ។
ពាក់ព័ន្ធ នឹង បញ្ហា ប្រាក់កម្ចី នេះ ដែរ លោក អ៊ិន ចាន់នី អគ្គនាយក និង នាយក ប្រតិបត្តិ ធនាគារ អេស៊ីលីដា បាន ឲ្យ ដឹង ថា ស្ថាប័ន របស់ លោក ធ្លាប់ អនុវត្ត កន្លង មក ហើយ ក្នុង ការ ទទួល យក ស្តុក ស្រូវ ជា ទ្រព្យបញ្ចាំ ។
ទោះ យ៉ាង ណា លោក បញ្ជាក់ ថា អតិថិជន ត្រូវ ភ្ជាប់ មក ជាមួយ របាយការណ៍ ហរិញ្ញវត្ថុ ដែល បង្ហាញ ពី ស្ថានភាព ហរិញ្ញវត្ថុ រយៈពេល ៣ ឆ្នាំ ចុងក្រោយ របស់ ក្រុមហ៊ុន នោះ ។
លោក បាន ពន្យល់ ដូច្នេះ ថា អចលនទ្រព្យ ដូចជា ដី ផ្ទះ អគារ ជាដើម គឺជា ទ្រព្យបញ្ចាំ សំខាន់ ទី មួយ ក្នុង ការ ទទួល បាន ប្រាក់កម្ចី ពី ធនាគារ ។
ទោះ ជា យ៉ាង នេះ ក្តី លោក មិន លើក ទឹកចិត្ត ឲ្យ រោង ម៉ាស៊ីន កិនស្រូវ ពឹងផ្អែក លើ ការ យក ស្រូវ ជា ទ្រព្យ បញ្ចាំ នោះ ទេ។
លោក បន្ថែម ថា កន្លង មក មិន មាន ធនាគារ ច្រើន ដែល ទទួល យក ស្រូវ ជា ទ្រព្យ បញ្ចាំ ព្រោះ ស្រូវ ជា ទ្រព្យ ដែល ប្រឈម នឹង ហានិភ័យ ខ្ពស់ មាន ដូចជា ការ ឆេះ ការ ងាយស្រួល ក្នុង ការ ដឹក ពី កន្លែង មួយ ទៅ កន្លែង មួយ ហើយ ស្រូវ អាច នឹង ស្រក ទម្ងន់ ប្រសិន បើ ទុក ក្នុង ឃ្លាំង យូរ។
លោក អ៊ិន ចាន់នី បន្ត ថា ក្នុង ករណី ធនាគារ ត្រូវ យក ស្រូវ ក្នុង ស្តុក ទាំងអស់ ជា ទ្រព្យ បញ្ចាំ គឺ ស្រូវ ទាំងអស់ នឹង ត្រូវ បញ្ជូន ទៅ ដាក់ នៅក្នុង ឃ្លាំង ដាច់ ដោយឡែក ដែល នឹង ស្ថិត ក្រោម ការ គ្រប់គ្រង របស់ ស្ថាប័ន ឯករាជ្យ មួយ ដែល មាន ជំនាញ និង ទទួល សេវាកម្ម ទុក ដាក់ ស្រូវ ហើយ ថ្លៃ ការ គ្រប់គ្រង អតិថិជន ជា អ្នក ចំណាយ ។
លោក បន្ត ថា កន្លង មក ឧបសគ្គ គឺ រោង ម៉ាស៊ីន កិនស្រូវ ក្នុង ស្រុក មិន អាច ផ្តល់ របាយការណ៍ ហរិញ្ញ វត្ថុ ដល់ ធនាគារ ។
លោក ថា កត្តា នេះ នឹង ជួយ ដល់ អ្នក កិន ស្រូវ នៅ កម្ពុជា បើ រោង ម៉ាស៊ីន កិន ស្រូវ នីមួយៗ មាន ការ រៀបចំ របាយការណ៍ ហរិញ្ញវត្ថុ ត្រឹមត្រូវ ។
លោក បាន បន្ត ថា កម្ពុជា នៅ មាន រោងម៉ាស៊ីន កិន ស្រូវ និង ក្រុមហ៊ុន នាំ អង្ករ ចេញ ច្រើន ដែល អនុវត្ត អាជីវកម្ម បែប ប្រពៃណី នៅ ឡើយ។
លោក ហៅ ការ ទទួល ស្រូវ ជា ទ្រព្យ បញ្ចាំ មាន លក្ខណៈ ជា ទ្រឹស្តី ប៉ុន្តែ ដើម្បី ទទួល ហរិញ្ញ ប្បទាន ពី ការ យក ឃ្លាំង ជា ទ្រព្យ បញ្ចាំ វា ទាមទារ ឲ្យ មាន អ្នក ជំនាញ ការ មាន អ្នក មើលការ ខុស ត្រូវ លើ ឃ្លាំង នោះ និង ត្រូវ ទាមទារ ឲ្យ មាន បទដ្ឋាន គតិយុត្ត ដ៏ ត្រឹមត្រូវ ៕
ដោយ មាន ជំនួយ ពី ភ្នាក់ងារ ធានា ទិញ មូលបត្រ ភ្នំពេញ ស៊ីឃ្យូរីធី ក្រុមហ៊ុន បាន ចាប់ផ្ដើម ប្រមូល ចំណាប់ អារម្មណ៍ អ្នក ទិញ កាលពី ម្សិលមិញ ដោយ មាន ការ ធ្វើ បទ បង្ហាញ នៅ ភ្នំពេញ ។
តាម ឯកសារ ដែល បង្ហាញ ដល់ វិនិយោគិន នៅក្នុង ការ ធ្វើ បទ បង្ហាញ មួយ កាលពី ម្សិលមិញ មូលនិធិ រក បាន តាមរយៈ ការ បោះ I PO នឹង ត្រូវ បាន ប្រើ ក្នុង ការ សង បំណុល រ៉ាប់រង លើ ការ ចំណាយ ក្នុង ការ ចុះ បញ្ជី និង ការ ផ្ដល់ មូលនិធិ ដល់ ផែនការ ពង្រីក នៅពេល អនាគត របស់ ក្រុមហ៊ុន ។
« បច្ចុប្បន្ន យើង មាន តែ វិនិយោគិន មាន ការ ចាប់ អារម្មណ៍ ២០០ នាក់ ប៉ុណ្ណោះ ក្នុង ការ បោះ IPO នេះ ចំណែកឯ ៥០ នាក់ ទៀត ចុះ ឈ្មោះ បង្ហាញ ចំណាប់ អារម្មណ៍ របស់ ខ្លួន នៅក្នុង ការ ធ្វើ ទីផ្សារ កាលពី ម្សិលមិញ ។
« យើង មិន បាន កំណត់ កាលបរិច្ឆេទ ពិតប្រាកដ សម្រាប់ ការ ចុះបញ្ជី នៅ ឡើយ ទេ »។
« ពួកគេ ចាំបាច់ ត្រូវ ធ្វើឲ្យ ចប់ សព្វ គ្រប់ ពីរ ដំណាក់កាល ប៊ុកបៀលឌីង និង ការ ទិញ មុន ពេល ពួកគេ មាន សិទ្ធិ ចុះ បញ្ជី និង ចាប់ផ្ដើម ការ ជួញដូរ »។
តម្លៃប្រាក់រៀលនៅតែមានស្ថិរភាពបើធៀបនឹងប្រាក់ដុល្លារ
ភ្នំពេញៈ បើ ទោះ បី ជា ស្ថានភាព អាជីវកម្ម នៅ កម្ពុជា រង ផល ប៉ះពាល់ ខ្លះៗ កាល ពី ចុង ឆ្នាំ ២០១៣ បន្ទាប់ ពី បោះឆ្នោត តែ អត្រា ប្តូរ ប្រាក់ រៀល ប្រចាំ ឆ្នាំ ធៀប នឹង ដុល្លារ អាមេរិក នៅ តែ មាន ស្ថិរភាព ល្អ។
តម្លៃ ប្រាក់ រៀល កាល ពី ម្សិលមិញ បាន កើន ឡើង បន្តិច ធៀប នឹង អត្រា ប្តូរ ប្រាក់ កាល ពី ខែ មករា ឆ្នាំ ២០១៣។
តម្លៃ ប្រាក់ រៀល កាល ពី ឆ្នាំ មុន មាន ការ ប្រែ ប្រួល ជា មធ្យម ប្រចាំ ឆ្នាំ ៤ រៀលបើ ធៀប នឹង ដុល្លារ អាមេរិក។
លោក ស្រី សូ ផនណារី អនុ ប្រធាន នាយក ប្រតិបត្តិ ធនាគារ អេស៊ីលីដា បាន ឲ្យ ដឹង ថា អត្រា ប្តូរ ប្រាក់ នៅ កម្ពុជា បាន រក្សា ស្ថិរភាព ល្អ ពី ឆ្នាំ មុន ហើយ ក៏ ដូចជា រយៈ ពេល ជិត ១០ ឆ្នាំ ចុង ក្រោយ នេះ ដែល ជា សញ្ញា ល្អ បង្ហាញ ពី មាន ការ កើន ឡើង នៃ ទំនុក ចិត្ត របស់ សាធារណជន មក លើ រូបិយប័ណ្ណ ជាតិ។
តាម របាយ ការណ៍ ធនាគារ ជាតិ ជា ទូទៅ តម្លៃ ប្រាក់ រៀល តែង កើន ឡើង ធៀប នឹង ប្រាក់ ដុល្លារ នៅ ដើម ឆ្នាំ ហើយ ផ្តើម ធ្លាក់ ថ្លៃ បន្តិច នា ខែ មេសា បន្ទាប់ ពី តម្រូវ ការ ប្រាក់ រៀល សម្រាប់ ប្រើ ប្រាស់ ក្នុង ពិធី ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ ត្រូវ បាន បញ្ចប់។
ចាប់ ពី ខែ ឧសភា តម្លៃ ប្រាក់ រៀល មាន ស្ថិរភាព រហូត ដល់ ខែ កញ្ញា។
នៅ ចុង ឆ្នាំ តម្លៃ ប្រាក់ រៀល ចាប់ ផ្តើម កើន បន្តិច វិញ ដោយ សារ រដូវ ប្រមូលផល ចូល មក ដល់ ដែល ធ្វើ ឲ្យ តម្រូវការ ក្នុង ការ ចាយវាយ ប្រាក់ រៀល កើន ឡើង៕
អំពើពុករលួយនៅកម្ពុជាកំពុងតែគំរាមកំហែងដល់ការធ្វើអាជីវកម្ម
ភ្នំពេញៈ របាយការណ៍ ពី សមាគម និយោជក ឈាន មុខ គេ នៅ កម្ពុជា បង្ហាញ ថា ប្រព័ន្ធ អំពើ ពុករលួយ បាន រុញច្រាន ឲ្យ ការ ធ្វើ ពាណិជ្ជកម្ម ស្ថិត ក្នុង ភាព គ្មាន ការ ការពារ។
កិច្ចប្រជុំ រួម មួយ ជាមួយ អង្គការ ពលកម្ម អន្តរជាតិ (ILO) និង សហព័ន្ធ និយោជក កម្ពុជា (CAMFEBA) នៅ ទីក្រុង ភ្នំពេញ កាលពី ម្សិលមិញ តំណាង និយោជក បាន អំពាវនាវ ឲ្យ រដ្ឋាភិបាល ផ្ដល់ ការ ការពារ កាន់តែ ខ្លាំង សម្រាប់ អ្នក និយាយ ថា មាន អំពើ ពុករលួយ និង ស៊ើបអង្កេត អំពើ ពុករលួយ នៅក្នុង ប្រព័ន្ធ យុត្តិធម៌ កម្ពុជា ។
« វា ពិតជា ល្បី ណាស់ ថា ពិតជា មាន អំពើ ពុករលួយ ច្រើន នៅក្នុង ប្រព័ន្ធ តុលាការ »។
« ផ្នែក មួយ ក្នុង ចំណោម ផ្នែក ដែល គួរ ឲ្យ បារម្ភ គឺ សិទ្ធិ មិន ស្នើភាព គ្នា នៅក្នុង តុលាការ កំពុង រារាំង ដល់ អាជីវកម្ម »។
លោក អ៊ិត សំហេង រដ្ឋមន្ដ្រី ក្រសួង កាងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ បាន បដិសេធ មិន ឆ្លើយ ដោយ ផ្ទាល់ ពី បញ្ហា នៃ ការ ស៊ើបអង្កេត របស់ តុលាការ ទេ ប៉ុន្តែ លោក បាន ស្វាគមន៍ ដល់ ការ ពង្រឹង តួនាទី របស់ ACU នៅ ក្នុង ការ ដោះស្រាយ អំពើ ពុករលួយ ។
« បរិយាកាស វិនិយោគ និង អាជីវកម្ម ត្រូវ តែ មាន តម្លាភាព ដើម្បី ធានា ឲ្យ មាន ការ រីកចម្រើន និង ការ អភិវឌ្ឍ »។
CAMFEBA បាន អំពាវនាវ ឲ្យ មាន បទប្បញ្ញត្តិ ការពារ អ្នក រាយការណ៍ ពី អំពើ ពុករលួយ ត្រូវ សរសេរ នៅក្នុង ច្បាប់ និង សម្រាប់ ការ ផ្សព្វផ្សាយ កាន់តែ ទូលំទូលាយ ពី ច្បាប់ ប្រឆាំង អំពើ ពុករលួយ ដើម្បី លើក ទឹកចិត្ត មនុស្ស ឲ្យ បន្ត ធ្វើ ទៀត ។
នៅពេល ទាក់ទង តាម ទូរស័ព្ទ កាលពី ថ្ងៃ ពុធ លោក ឱម យ៉ិនទៀង ប្រធាន អង្គភាព ប្រឆាំង អំពើ ពុករលួយ មិន ធ្វើ អត្ថាធិប្បាយ លើ បញ្ហា នេះ ទេ ៕
លោក ហ៊ុន សែន ជំរុញបើកប្រាក់ខែគ្រូបង្រៀនតាមធនាគារ
ភ្នំពេញៈ លោក នាយក រដ្ឋ មន្ដ្រី ហ៊ុន សែន កាល ពី ថ្ងៃ អង្គារ បាន ជំរុញ ឲ្យ ក្រសួង អប់រំ យុវជន និង កីឡា បង្កើន ល្បឿន ដំណើរការ នៃ ការ បើក ប្រាក់ បៀវត្សរ៍ គ្រូ បង្រៀន តាម រយៈ ធនាគារ នៅ ក្នុង ឆ្នាំ នេះ។
វិធានការ នេះ ជា ជំហាន មួយ ដើម្បី ប្រឆាំង នឹង ការ កាត់ ប្រាក់ ខែ ដែល មិន សម ហេតុ ផល។
លោក នាយក រដ្ឋ មន្ដ្រី បាន អំពាវនាវ ក្នុង អំឡុង ពេល ការ ចែក សញ្ញាបត្រ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ កាល ពី ម្សិលមិញ ដោយ លើក ឡើង ថា ការណ៍ នេះ នឹង ជួយ ក្នុង ការ កាត់ បន្ថយ ការ លំបាក មួយ ចំនួន នៅ ក្នុង ការ ដឹក ជញ្ជូន ប្រាក់ ទូទាំង ប្រទេស និង ការ កាត់ ប្រាក់ ខែ ក្រៅ ផ្លូវ ការ។
«ប៉ុន្តែ យើង ចាំបាច់ ត្រូវ ដំណើរការ ជា ជំហានៗ តាម រយៈ ការ កែ ទម្រង់ រដ្ឋាភិបាល»។
លោក រ៉ុង ឈុន ប្រធាន សមាគម គ្រូ បង្រៀន កម្ពុជា ឯករាជ្យ បាន យល់ ស្រប នឹង គំនិត ផ្ដួច ផ្ដើម នេះ៖
«សមាគម របស់ ខ្ញុំ បាន ស្នើ ទៅ រដ្ឋាភិបាល តាំង ពី ឆ្នាំ ២០១២។
«ប៉ុន្តែ រដ្ឋាភិបាល ត្រូវ តែ ធានា ឲ្យ ប្រាកដ ថា នៅ ពេល ណា ទើប ប្រាក់ លែង បើក យឺត។
លោក បាន លើក ឡើង ថា កន្លង មក ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិ សម្បទា បាន ធ្វើ រួច ហើយ ចំពោះ និវត្តជន ប៉ុន្តែ ការ បើក នៅ តែ មាន ភាព យឺត យ៉ាវ នៅ ឡើយ។
លោក ហ៊ុន សែន កាល ពី ម្សិលមិញ ក៏ បាន ធ្វើ ការ ជំរុញ ឲ្យ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង រតនាគារ ជាតិ ពន្លឿន ការ បើក ប្រាក់ ខែ ដល់ មន្ដ្រី រាជការ ឲ្យ ទាន់ ពេល នៅ ក្នុង ខែ។
លោក ហង់ ជួនណារ៉ុន រដ្ឋ មន្ដ្រី ក្រសួង អប់រំ យុវជន និង កីឡា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ កាល ពី ថ្ងៃ អង្គារ ថា ក្រសួង បាន អនុវត្ត រួច ហើយ នៅ ទីក្រុង ភ្នំពេញ និង ខេត្ត កណ្ដាល ហើយ ខ្លួន នឹង ពង្រីក បន្ថែម ទៀត ក្នុង ពេល ឆាប់ៗ នេះ។
ដូច្នេះ ប្រាក់ ខែ មន្ដ្រី របស់ យើង នឹង លែង មាន ការ យឺត យ៉ាវ ទៀត ហើយ។
«ខ្ញុំ មាន ជំនឿ យ៉ាង ខ្លាំង ថា បញ្ហា នេះ នឹង ជា ការ លើក ទឹក ចិត្ត មួយ ក្នុង ការ ពង្រឹង ប្រសិទ្ធភាព ការងារ របស់ មន្រ្តី របស់ ខ្ញុំ»។
លោក បញ្ជាក់ ថា បច្ចុប្បន្ន ក្រសួង អប់រំ យុវជន និង កីឡា មាន បុគ្គលិក ប្រហែល ១១២ ០០០ នាក់។
លោក ហង់ ជួនណារ៉ុន បញ្ជាក់ ថា មិន មាន ការ កាត់ ប្រាក់ ខែ ពី មន្ដ្រី និង គ្រូ បង្រៀន របស់ លោក ទេ។
ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចុះ អនុស្សរណៈ ស្តីពី ការ ព្រម ព្រៀង ផ្តល់ សេវា នេះ កាល ពី ដើម ខែ ធ្នូ ឆ្នាំ មុន និង ប្រតិបត្តិករ បី រួម មាន ធនាគារ អេស៊ីលីដា ធនាគារ កាណាឌីយ៉ា និង ក្រុមហ៊ុន សេវាកម្ម ផ្ទេរ ប្រាក់ វីង។
ក្នុង ការ ផ្តល់ សេវា នេះ ដល់ មន្រ្តី រាជការ ៤ សែន នាក់ នៅ តាម ក្រសួង មន្ទីរ នានា ទូទាំង ប្រទេស នឹង អាច បើក ប្រាក់ បៀវត្សរ៍ តាម រយៈ ប្រព័ន្ធ ធនាគារ ចាប់ ពី ខែ មករា ឆ្នាំ ២០១៤ តទៅ។
លោក អ៊ិន ចាន់នី ប្រធាន នាយក ប្រតិបត្តិ ធនាគារ អេស៊ីលីដា បាន ពន្យល់ ពី ដំណើរការ សេវាកម្ម នេះ កាល ពី មុន ថា៖
«រតនាគារ ជាតិ នឹង ដាក់ ប្រាក់ នៅ តាម ធនាគារ ទាំង ពីរ និង ក្រុមហ៊ុន មួយ ហើយ ប្រតិបត្តិករ មាន តួនាទី ក្នុង ការ បម្រើ សេវា បើក ប្រាក់ បៀវត្សរ៍ ដល់ មន្ត្រី រាជការ នៅ ទូទាំង ប្រទេស ទៅ តាម ដំណាក់កាល។
អនុស្សរណៈ នេះ ជា ការ បើក ទ្វារ ដល់ ធនាគារ អ្នក ផ្តល់ សេវា»។
លោក បាន ឲ្យ ដឹង ថា មន្ត្រី រាជការ អាច ជ្រើស រើស ប្រតិបត្តិករ ណា មួយ ក្នុង ចំណោម ប្រតិបត្តិករ ទាំង បី ក្នុង ការ ដក ប្រាក់ បៀវត្សរ៍ របស់ ពួក គាត់ ជា រៀងរាល់ ខែ៕
នេះ បើ យោង តាម សេចក្តី ប្រកាស ព័ត៌មាន របស់ ក្រុមហ៊ុន កាល ពី ថ្ងៃ ១០ មីនា។
«គម្រោង នេះ ផ្តោត សំខាន់ លើ ការ សាង សង់ បណ្តាញ បញ្ជូន អគ្គិសនី ដែល មាន ប្រវែង ប្រមាណ ១៩៨ គីឡូម៉ែត្រ ហើយ ប្រើ សម្រាប់ បញ្ជូន អគ្គិសនី ពី ខេត្ត ព្រះ សីហនុ មក ភ្នំពេញ ពី រោងចក្រ ផលិត អគ្គិសនី ដែល កំពុង ដំណើរការ និង រោងចក្រ ដែល នឹង អាច ផលិត បាន នា ពេល ខាង មុខ»។
កាល ពី ចុង ខែ កុម្ភៈ រដ្ឋាភិបាល បាន បើក ដំណើរការ រោងចក្រ អគ្គិសនី ដុត ធ្យូង ថ្ម ដំបូង គេ នៅ កម្ពុជា នៅ ខេត្ត ព្រះ សីហនុ ដែល មាន អនុភាព ផលិត ថាមពល ១០០ មេហ្គាវ៉ាត់ ក្នុង មួយ ឆ្នាំ សម្រាប់ ផ្គត់ ផ្គង់ អគ្គិសនី មក ភ្នំពេញ ដែល ជា ប្រភព ថាមពល សំខាន់ មួយ ដើម្បី ដោះស្រាយ បញ្ហា កង្វះ ចរន្ត អគ្គិសនី នៅ ភ្នំពេញ នា ពេល បច្ចុប្បន្ន។
ក្រុមហ៊ុន ក៏ បាន វិនិយោគ លើ គម្រោង តភ្ជាប់ ខ្សែ បណ្តាញ បញ្ជូន អគ្គិសនី ២៣០ គីឡូវ៉ុល ភ្នំពេញ-កំពង់ចាម ក្នុង គម្រោង សម្បទាន ២៨ឆ្នាំ ផង ដែរ។
មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង រ៉ែ និង ថាមពល ជាច្រើន រូប កាល ពី ម្សិលមិញ បដិសេធ ធ្វើ អត្ថាធិប្បាយ ដោយ លើក ឡើង ថា មិន ត្រូវ នឹង តួនាទី។
គម្រោង នេះ ជា ការ វិនិយោគ តាម រយៈ កិច្ច សហការ រវាង រដ្ឋាភិបាល និង ក្រុមហ៊ុន ឯកជន ក្នុង ទម្រង់ សាងសង់ ដំណើរការ និង ផ្ទេរ (BOT)៕
កម្ពុជាជួយស្វែងរកយន្តហោះបាត់
ភ្នំពេញៈ មន្ដ្រី កម្ពុជា បាន ថ្លែង ថា អាជ្ញាធរ អាកាសចរណ៍ កម្ពុជា បាន បង្កើន បុគ្គលិក ហើយ កំពុង ទំនាក់ ទំនង ជា ប្រចាំ ជាមួយ សម ភាគី វៀតណាម ក្នុង កិច្ច ខិតខំ ប្រឹង ប្រែង ក្នុង ការ រួម ចំណែក ដើម្បី ស្រាវជ្រាវ រក ជើង យន្តហោះ ៣៧០ ម៉ាឡេស៊ី អ៊ែរឡាញ (MAS)។
លោក ឈុន ស៊ីវន ប្រធាន ផ្នែក បង្ហាញ ទិសដៅ ហោះ ហើរ និង ស្ដង់ដារ នៅ រដ្ឋ លេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល (SSCA) ថ្លែង ថា តំបន់ នោះ មាន ចម្ងាយ ជាង ៣០០ គីឡូម៉ែត្រ ភាគ ខាង ត្បូង ស្ថានីយ គ្រប់ គ្រង ចរាចរណ៍ ផ្លូវ អាកាស ក្រុង ភ្នំពេញ ដែល មិន ឆ្ងាយ ពី ផ្នែក ខាង ក្រៅ ដែន អាកាស កម្ពុជា។
លោក បន្ត ថា SSCA បាន បង្កើន ចំនួន បុគ្គលិក ក្នុង ការ ត្រួត ពិនិត្យ ដែន អាកាស កម្ពុជា ផង ដែរ ហើយ កំពុង ធ្វើ វិភាគ ក្នុង តំបន់ ឈូង សមុទ្រ ថៃ ដើម្បី ស្វែង រក ភ្លើង ប្រាប់ សញ្ញា គ្រោះថ្នាក់ ពី ស្ថានីយ គ្រប់ គ្រង ការ ហោះ ហើរ នៅ ព្រលាន យន្តហោះ អន្តរជាតិ ភ្នំពេញ និង នៅ មហា វិថី ព្រះ នរោត្តម។
«យើង បាន ដាក់ បុគ្គលិក បន្ថែម ប្រចាំ ការ ២៤ ម៉ោង លើ ២៤ ម៉ោង ក្នុង មួយ ថ្ងៃ ដើម្បី ត្រួត ពិនិត្យ រូបភាព ផ្កាយ រណប របស់ យើង និង ប្រព័ន្ធ រ៉ាដា»។
ការ ប្រកាស ចុង ក្រោយ បំផុត ពី អាកាសចរណ៍ ម៉ាឡេស៊ី អ៊ែរឡាញ ដែល បាន ចេញ ផ្សាយ នៅ លើ គេហទំព័រ របស់ ខ្លួន រយៈ ពេល ៤៨ ម៉ោង បន្ទាប់ ពី យន្តហោះ បាន បាត់ ដាន នេះ បាន ថ្លែង អំណរគុណ ដល់ ក្រុម ស្រាវជ្រាវ និង ក្រុម ជួយ សង្គ្រោះ មក ពី ប្រទេស អូស្ដ្រាលី ចិន ថៃ ឥណ្ឌូនេស៊ី សិង្ហបុរី វៀតណាម ហ្វីលីពីន និង អាមេរិក ដែល កំពុង ជួយ ស្រាវជ្រាវ ស្វែង រក។
ទោះ បី ជា តំបន់ ស្រាវជ្រាវ នៅ ជាប់ ព្រំ ប្រទល់ ដែន អាកាស កម្ពុជា-វៀតណាម ក៏ ដោយ ក៏ លោក ស៊ីវន បាន បញ្ជាក់ ថា ជា ធម្មតា កម្ពុជា មិន មាន ធនធាន ដើម្បី ចូល រួម ក្នុង កិច្ច ខិតខំ ប្រឹង ប្រែង នៅ លើ ផ្ទៃ សមុទ្រ ទេ។
«ដូច្នេះ យើង កំពុង ខិតខំ ប្រឹង ប្រែង ឲ្យ អស់ ពី សមត្ថភាព ដើម្បី ជួយ ជាមួយ អ្វី ដែល យើង មាន»។
«យន្តហោះ ទាំង អស់ បាន ដំឡើង ឧបករណ៍ បញ្ជូន សារ បន្ទាន់។
បើ យន្តហោះ ធ្លាក់ នៅ ខាង ក្នុង ដែន អាកាស កម្ពុជា ឬ នៅ ក្នុង រង្វង់ ផ្កាយ រណប របស់ យើង និង ប្រព័ន្ធ រ៉ាដា យើង នឹង សង្ឃឹម ថា នឹង ចាប់ សញ្ញា បាន»។
លោក បន្ថែម ថា កប៉ាល់ នេសាទ ដ៏ ច្រើន និង បំណែក សំណល់ កំពុង អណ្ដែត នៅ ជុំវិញ ឈូង សមុទ្រ ថៃ អាច ធ្វើ ឲ្យ ការ ផ្ដល់ ដំណឹង មិន ពិត សម្រាប់ ប្រតិបត្តិករ រ៉ាដា។
អ្នកជំនាញកសិកម្មអាស៊ានពិភាក្សាពីគោលនយោបាយកសិកម្ម
ភ្នំពេញៈ អ្នក ជំនាញ កសិកម្ម មក ពី ប្រទេស អាស៊ាន ទាំង ១០ បាន ជួប ពិភាក្សា គ្នា អំពី ចីរភាព ប្រព័ន្ធ កសិ-ចំណី អាហារ ក្នុង តំបន់។
ការ ជួប ប្រជុំ ដែល ធ្វើ ឡើង នៅ រាជធានី ភ្នំពេញ កាល ពី ថ្ងៃ ម្សិលមិញ នេះ ផ្តោត សំខាន់ ទៅ លើ វិធានការ ជីវសាស្រ្ត ក្នុង បំណង បង្កើត ផែនការ យុទ្ធសាស្រ្ត គោល នយោបាយ និង សេចក្តី ណែនាំ ក្នុង កម្មវិធី កសិកម្ម ថ្នាក់ ជាតិ រួម រវាង ប្រទេស អាស៊ាន ដើម្បី ធានា សុវត្ថិភាព ចំណី អាហារ ក្នុង តំបន់ ខណៈ សមាហរណកម្ម សេដ្ឋកិច្ច អាស៊ាន កាន់ តែ ខិត ចូល មក ដល់។
លោក ហ៊ាន វណ្ណហន អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន កសិកម្ម នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ដែល ចូល រួម ក្នុង កិច្ច ពិភាក្សា នោះ មាន ប្រសាសន៍ ថា កម្ពុជា ត្រូវ យក ចិត្ត ទុក ដាក់ ក្នុង ការ ពង្រឹង ស្តង់ដារ សុវត្ថិភាព ចំណី អាហារ របស់ ខ្លួន ដើម្បី តៀម ខ្លួន ប្រជែង ក្នុង ការ នាំ ចេញ ផលិត ផល កសិកម្ម នៅ ពេល សមាហរណកម្ម សេដ្ឋកិច្ច អាស៊ាន ចូល មក ដល់។
«ដោយ សារ ទំនិញ នឹង ហូរ ដោយ សេរី ក្នុង សមាហរណកម្ម សេដ្ឋកិច្ច អាស៊ាន ដូច្នេះ វា នឹង មាន ការ ពិបាក ក្នុង ការ គ្រប់ គ្រង បើ ប្រទេស នីមួយៗ តម្រូវ ឲ្យ បំពេញ លក្ខខណ្ឌ ខុសៗ គ្នា។
វា បង្ហាញ ឲ្យ ឃើញ ច្បាស់ ថា តម្រូវការ និយាម ផលិតកម្ម កសិកម្ម រួម សម្រាប់ ប្រើ ប្រាស់ ក្នុង តំបន់ គឺជា ការ ចាំ បាច់»។
លោក គាម មករាឌី នាយក កម្មវិធី បរិស្ថាន និង សុខភាព នៃ អង្គការ សេដាក និយាយ ថា មក ដល់ ពេល នេះ មាន កសិករ ជាង ២ ០០០ នាក់ ជា អ្នក ផលិត ស្រូវ សរីរាង្គ និង ជាង ១០០ នាក់ ជា អ្នក ផលិត បន្លែ សរីរាង្គ។
ក្នុង នោះ ផលិត ផល ស្រូវ សរីរាង្គ ដែល មាន បញ្ជាក់ ពី សុវត្ថិភាព ចំណី អាហារ ត្រូវ បាន នាំ ចេញ ទៅ ប្រទេស អាល្លឺម៉ង់ និង សហរដ្ឋ អាមេរិក។
នេះ ជា កិច្ច ប្រជុំ លើក ទី៤ ហើយ រវាង គណៈកម្មការ ប្រតិបត្តិ នៃ ប្រទេស អាស៊ាន បន្ទាប់ ពី គម្រោង នេះ ត្រូវ បាន បង្កើត ឡើង នៅ ក្នុង ឆ្នាំ ២០១១។
កិច្ច ប្រជុំ លើក នេះ ធ្វើ ឡើង ដើម្បី បូក សរុប សមិទ្ធផល ដែល សម្រេច បាន ក្នុង រយៈ ពេល ៤ឆ្នាំ ដំណាក់ កាល ទី១ នៃ គម្រោង និង បន្ត ពិភាក្សា លើ ការ អនុវត្ត គម្រោង ដំណាក់ កាល ទី២៕
ការវិនិយោគដែលលាយឡំភាពចម្រូងចម្រាស
រថយន្ត ទាំង នោះ គឺ សំដៅ ទៅ រោងចក្រ ចម្រាញ់ ស្ករ ស របស់ ក្រុមហ៊ុន។
ស្ករ ស មួយ ចំនួន ត្រូវ បាន នាំ ចេញ ទៅ អឺរ៉ុប ប៉ុន្តែ ភាគ ច្រើន ត្រូវ បាន លក់ ឲ្យ ទីផ្សារ ក្នុង ស្រុក។
ប៉ុន្តែ វា មិន មែន ជា ដំណើរការ កសិ-ឧស្សាហកម្ម ឬ បច្ចេកវិទ្យា ថ្មី ដែល ត្រូវ បាន ដាក់ ឲ្យ ប្រើ ប្រាស់ ក្នុង ប្រទេស កម្ពុជា សម្រាប់ ក្រុមហ៊ុន នេះ ទេ។
អស់ រយៈ ពេល ជាច្រើន ឆ្នាំ ក្នុង ការ ប្រតិបត្តិការ របស់ ខ្លួន គម្រោង មាន តម្លៃ ២២០ លាន ដុល្លារ បាន បែង ចែក ជាច្រើន។
ម្ចាស់ ក្រុមហ៊ុន នេះ និយាយ ថា ក្រុមហ៊ុន នេះ គឺជា ប្រយោជន៍ មួយ សម្រាប់ អ្នក ក្រីក្រ របស់ ប្រទេស នេះ ជា ផ្លូវ មួយ ឆ្ពោះ ទៅ រក ភាព រុង រឿង កាន់ តែ ខ្លាំង។
បន្ទាប់ ពី រយៈ ពេល ជាច្រើន ឆ្នាំ នៃ របាយ ការណ៍ រិះគន់ យ៉ាង ខ្លាំង ចាប់ ពី ការ ចាប់ យក ដី រហូត ដល់ ប្រើ ពលកម្ម កុមារ ក្រុមហ៊ុន ភ្នំពេញ ស៊ូហ្គើរ ដែល គ្រប់ គ្រង ដោយ លោក លី យ៉ុងផាត់ សមាជិក ព្រឹទ្ធសភា របស់ គណបក្ស កាន់ អំណាច បាន បើក ទ្វារ ឲ្យ អ្នក យក ព័ត៌មាន ភ្នំពេញ ប៉ុស្ដិ៍ ចូល ទៅ ដល់ ទី នោះ កាល ពី សប្ដាហ៍ មុន។
លោក សេង ញ៉ាក់ ប្រធាន គ្រប់ គ្រង ក្រុមហ៊ុន ភ្នំពេញ ស៊ូហ្គើរ បាន និយាយ ពី ទីតាំង សាលារៀន មួយ ដែល ក្រុមហ៊ុន កំពុង សាងសង់ នៅ ជាប់ ព្រំ ប្រទល់ នៃ ដី សម្បទាន នេះ ថា៖
លោក និយាយ ពី អត្ថ ប្រយោជន៍ នៃ ការ វិនិយោគ របស់ ក្រុមហ៊ុន នេះ ថា៖
«នៅ ពេល ក្រុមហ៊ុន មក ទី នេះ ហើយ អភិវឌ្ឍ អ្នក មិន គ្រាន់ តែ បង្កើត តម្លៃ ដី ប៉ុណ្ណោះ ទេ វា កំពុង ផ្ដល់ ឱកាស ការងារ ដល់ ប្រជាជន ផង ដែរ ព្រម ទាំង សាង សង់ ហេដ្ឋា រចនា សម្ព័ន្ធ មូលដ្ឋាន សម្រាប់ ប្រជាជន កំពុង រស់ នៅ ជុំវិញ តំបន់ នេះ»។
លោក អៀង វុទ្ធី ប្រធាន ប្រតិបត្តិ នៅ អង្គការ សមធម៌ កម្ពុជា បាន ថ្លែង ថា ប្រជាជន មាន ប្រតិកម្ម ផ្សេង គ្នា។
មន្ដ្រី រដ្ឋាភិបាល បាន ប្រាប់ អ្នក ម៉ៅ ការ បន្ត ថា ច្បាប់ ក្នុង ស្រុក អនុញ្ញាត ឲ្យ ក្មេងៗ មាន អាយុ លើស ពី ១២ឆ្នាំ អាច ធ្វើ ការងារ ស្រាល ក្រៅ ម៉ោង បាន ដរាប ណា ការងារ នេះ មិន បាន យក ពួកគេ ចេញ ឆ្ងាយ ពី សាលារៀន។
ប៉ុន្តែ ដោយ មិន គិត ពី ច្បាប់ ក្នុង ស្រុក លោក ញ៉ាក់ បាន ប្រាប់ ដល់ អ្នក ទាំង អស់ គ្នា ថា មិន មាន ក្មេងៗ ត្រូវ បាន អនុញ្ញាត ឲ្យ ធ្វើ ការងារ នោះ ទេ។
លោក បញ្ជាក់ ថា ក្រុមហ៊ុន នេះ កំពុង ធ្វើ ការងារ ស្ដីពី ការ ផ្តួច ផ្ដើម ដូចជា ការ បង្កើត ទារកដ្ឋាន និង សាលារៀន ដើម្បី យក ឈ្នះ លើ «វប្បធម៌» របស់ កម្មករ ដែល ពួកគេ ភាគ ច្រើន តែង តែ នាំ យក កូនៗ របស់ ពួកគេ មក ធ្វើ ការ។
រដូវ ប្រមូល ផល ចាប់ ពី ខែ វិច្ឆិកា ដល់ ខែ ឧសភា។
លោក ញ៉ាក់ និយាយ ថា ការ រក្សា រោងចក្រ ទាំង ពីរ និង ចម្ការ នៅ ក្រៅ រដូវ ប្រមូល ផល អាច រក្សា ការងារ ដល់ ប្រជាជន ពេញ មួយ ឆ្នាំ លើ ដី សម្បទាន នេះ។
ឆ្នាំ ដែល ចម្រូង ចម្រាស តាំង ពី ការ ចាប់ ផ្ដើម ដំបូង កាល ពី ឆ្នាំ ២០១០ ទីតាំង នេះ គឺជា កន្លែង ជម្លោះ ដី ធ្លី ដ៏ រ៉ាំរ៉ៃ ក្នុង រយៈ ពេល ជាច្រើន ឆ្នាំ។
មនុស្ស រាប់ រយ គ្រួសារ ត្រូវ បាន គេ បង្ខំ ឲ្យ ចេញ ពី ដី និង ប្តូរ ទៅ ទីតាំង ថ្មី។
ប្រជាជន ជាច្រើន ត្រូវ បាន គេ ចាប់ ឃុំ ខ្លួន ក្នុង ការ ការពារ ដី របស់ ពួក គេ ដែល បាន ជំរុញ ឲ្យ មាន ការ តវ៉ា ប្រឆាំង នៅ ក្នុង រយៈ ពេល ប៉ុន្មាន ឆ្នាំ ជាប់ៗ គ្នា នេះ។
អង្គការ សិទ្ធិ មនុស្ស ជាច្រើន និយាយ ថា ពួក គេ រស់ នៅ ក្នុង ស្ថានភាព កាន់ តែ លំបាក និង ក្រីក្រ បំផុត។
លោក ញ៉ាក់ ថ្លែង ថា៖
ការ ទទួល ខុស ត្រូវ របស់ ក្រុមហ៊ុន ភ្នំពេញ ស៊ូហ្គើរ លោក ញ៉ាក់ បាន បន្ត ថា៖
វា គឺជា បញ្ហា មួយ ដ៏ សំខាន់ ដែល ជា ការ ពិបាក ក្នុង ការ ដោះស្រាយ ប៉ុន្តែ យើង កំពុង ធ្វើ ការងារ នេះ ដើម្បី ស្វែង រក ដំណោះស្រាយ មួយ»។
ខណៈ ឯកសារ សវនកម្ម បរិស្ថាន លេច ធ្លាយ ដែល ភ្នំពេញ ប៉ុស្តិ៍ ទទួល បាន កាល ពី ខែ មករា ហើយ ត្រូវ បាន ផ្ដួច ផ្ដើម ដោយ អ្នក ផ្ដល់ មូលនិធិ មួយ ក្នុង ចំណោម អ្នក ផ្ដល់ មូលនិធិ ដល់ ចម្ការ ជាច្រើន ធនាគារ ANZ Royal បង្ហាញ ថា ចាប់ តាំង ពី ឆ្នាំ ២០១០ ដល់ ឆ្នាំ ២០១៣ ក្រុមហ៊ុន ភ្នំពេញ ស៊ូហ្គើរ មិន អើពើ ពី ការ ផ្ដល់ អនុសាសន៍ របស់ ក្រុមហ៊ុន សវនកម្ម ស្ដី ពី បញ្ហា ផ្សេងៗ ជាច្រើន ដល់ ៦០ ភាគរយ រាប់ តាំង ពី ការ ត្រួត ពិនិត្យ សុខភាព សុវត្ថិភាព របស់ អ្នក តាំង លំនៅ ថ្មី និង កម្មករ។
លោក ញ៉ាក់ បញ្ជាក់ ថា ចម្លើយ ក្រុមហ៊ុន ភ្នំពេញ ស៊ូហ្គើរ គឺ «ឧស្សាហកម្ម ស្ករស ពិត ប្រាកដ ណាស់ គឺជា ឧស្សាហកម្ម ថ្មី មួយ នៅ កម្ពុជា ហើយ ប្រទេស នេះ កំពុង ព្យាយាម ធ្វើ ការ យ៉ាង ខ្លាំង ក្លា ដើម្បី ដោះស្រាយ បញ្ហា នេះ វា គឺ ដូច ជា កូន ក្មេង ទើប នឹង កើត អ៊ីចឹង ដូច្នេះ វា ត្រូវ ការ ពេល វេលា សម្រាប់ ឲ្យ កូន ក្មេង នេះ ធំ ពេញ វ័យ អ្នក មិន អាច រំពឹង ថា កូន ក្មេង ទើប កើត ចេះ និយាយ ពាក្យ គួរសម ឬ និយាយ បាន ល្អ នោះ ទេ វា ត្រូវ តែ ធ្វើ ឡើង ជា ជំហានៗ»៕
ការចិញ្ចឹមក្រពើនៅដើមឆ្នាំ ២០១៤ បានកើនឡើង
នេះ បើ តាម របាយ ការណ៍ ប្រចាំ ខែ ពី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ។
មន្ត្រី ជំនាញ និយាយ ថា ការ កើន ឡើង នេះ គឺ ដោយ សារ បច្ចុប្បន្ន កសិករ ភាគ ច្រើន ងាក មក ចិញ្ចឹម ក្រពើ ដើម្បី យក ស្បែក ជំនួស ឲ្យ ការ លក់ កូន ក្រពើ ទៅ ឲ្យ ប្រទេស ជិត ខាង ខណៈ ការ ចុះ ស្រង់ ស្ថិតិ នៃ ចំនួន ចិញ្ចឹម ក្រពើ ដែល មាន ក្នុង កសិដ្ឋាន មាន ភាព ត្រឹម ត្រូវ ជាង មុន។
លោក ហេង សុវណ្ណារ៉ា ប្រធាន ផ្នែក អភិវឌ្ឍន៍ ក្រពើ នៃ អគ្គ នាយកដ្ឋាន រដ្ឋបាល ជលផល មាន ប្រសាសន៍ ថា៖
«យើង ចុះ ធ្វើ ស្ថិតិ ដើម្បី អនុវត្ត ទៅ តាម ប្រកាស រួម ស្តី ពី ការ ចិញ្ចឹម ក្រពើ ដែល ម្ចាស់ ត្រូវ បង់ សេវា សាធារណៈ ហើយ អ្នក ចិញ្ចឹម ក៏ ងាក មក ចិញ្ចឹម ដើម្បី យក ស្បែក វិញ ដូច្នេះ ចំនួន ក្រពើ យើង កើន ឡើង ជា ពិសេស អ្នក ចិញ្ចឹម នៅ ខេត្ត សៀមរាប»។
លោក សេន រិទ្ធ អនុ ប្រធាន សមាគម អភិវឌ្ឍន៍ ការ ចិញ្ចឹម ក្រពើ កម្ពុជា ខេត្ត សៀមរាប បញ្ជាក់ ថា តម្រូវ ការ ស្បែក ក្រពើ កម្ពុជា ពិត ជា មាន តម្លៃ ក្នុង ទីផ្សារ អន្តរជាតិ។
ស្បែក ក្រពើ យើង មាន ទីផ្សារ ណាស់។
បច្ចុប្បន្ន ឈ្មួញ ពី ប្រទេស ចិន កំពុង ចាប់ អារម្មណ៍ ការ នាំ ចូល សាច់ ក្រពើ ពី កម្ពុជា។
រដ្ឋាភិបាល បាន អំពាវនាវ ដល់ អ្នក ចិញ្ចឹម ក្រពើ ឲ្យ បញ្ឈប់ ការ នាំ ចេញ កូន ក្រពើ ទៅ បណ្ដា ប្រទេស ជិត ខាង តាំង ពី ឆ្នាំ ២០០៥។
បញ្ហា កង្វះ ទុន និង ការ ព្រួយ បារម្ភ ពី ទីផ្សារ សម្រាប់ ស្បែក ក្រពើ នៅ តែ ជា ឧបសគ្គ សម្រាប់ កម្ពុជា ក្នុង ការ ក្លាយ ជា ប្រទេស នាំ ចេញ ស្បែក ក្រពើ។
កម្ពុជា នាំ ចេញ កូន ក្រពើ ស្បែក ក្រពើ និង សាច់ ក្រពើ ទៅ ប្រទេស វៀតណាម ប្រទេស ថៃ និង ប្រទេស ចិន។
លោក ហេង សុវណ្ណារ៉ា អំពាវនាវ ឲ្យ កសិករ មក ចិញ្ចឹម ដើម្បី យក ស្បែក សម្រាប់ នាំ ចេញ វិញ ដែល ទីផ្សារ និង តម្លៃ មាន ស្ថិរភាព ជាង។
«តម្លៃ ស្បែក ក្រពើ នៅ ទីផ្សារ ពិភពលោក មិន ធ្លាក់ ចុះ ទេ។
សំខាន់ គឺ គុណភាព ស្បែក របស់ យើង។
អ្នក ចិញ្ចឹម កុំ បារម្ភ ថា មិន មាន ទីផ្សារ ឲ្យ សោះ»។
លោក អ៊ុង វិសាល អនុ ប្រធាន សមាគម ចិញ្ចឹម ក្រពើ សៀមរាប អង្គរ បាន ឲ្យ ដឹង ថា ក្រពើ ដែល មាន ក្នុង កសិដ្ឋាន ក្នុង ចំណោម សមាជិក សមាគម របស់ លោក មាន អាយុ ត្រឹម ១ ឆ្នាំ ទៅ ២ ឆ្នាំ ប៉ុណ្ណោះ។
លោក រំពឹង ថា នឹង អាច នាំ ចេញ ស្បែក ក្រពើ នៅ ឆ្នាំ ក្រោយ។
របាយ ការណ៍ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ព្យាករ ថា ចំនួន ក្រពើ នៅ កម្ពុជា នឹង កើន ដល់ ៣ សែន ក្បាល សម្រាប់ ការ នាំ ចេញ គិត ត្រឹម ដំណាច់ ឆ្នាំ នេះ៕
ភ្នំពេញៈ រដ្ឋាភិបាល កម្ពុជា កំពុង សិក្សា ពី លទ្ធភាព រៀបចំ បើក ច្រក ទ្វារ អន្តរជាតិ ស្ទឹង បត់ នៅ ក្រុង ប៉ោយប៉ែត ដើម្បី ជួយ សម្រួល ដល់ ការ ចេញ-ចូល រថយន្ត ដឹក ទំនិញ ធុន ធំ ខណៈ ច្រក ព្រំដែន អន្តរជាតិ ប៉ោយប៉ែត ដែល មាន ស្រាប់ មាន ភាព មមាញឹក និង មាន ចរាចរណ៍ កក ស្ទះ កាន់ តែ ខ្លាំង។
ច្រក ទ្វារ អន្តរជាតិ ថ្មី នេះ មាន ទីតាំង នៅ លើ កំណាត់ ផ្លូវ ជាតិ លេខ ៥ ក្នុង ភូមិ ស្ទឹង បត់ សង្កាត់ ប៉ោយប៉ែត ខេត្ត បន្ទាយ មាន ជ័យ ដែល មាន ចម្ងាយ ប្រមាណ ៤ គីឡូម៉ែត្រ ពី ច្រក ទ្វារ អន្តរជាតិ ប៉ោយប៉ែត។
រដ្ឋាភិបាល បាន សម្រេច កាល ពី ថ្ងៃ ទី១៨ ខែ កុម្ភៈ ឲ្យ បង្កើត គណៈកម្មការ ចម្រុះ ដើម្បី រៀបចំ បើក ច្រក ព្រំដែន អន្តរជាតិ ស្ទឹង បត់ ដែល មាន សមាសភាព ១២ រូប។
លោក កឹម បូរី អគ្គ នាយក សាធារណការ នៃ ក្រសួង សាធារណការ និង ដឹក ជញ្ជូន និង ជា សមាជិក មួយ រូប ទទួល បន្ទុក ទំនាក់ ទំនង ជាមួយ ភាគី ថៃ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិលមិញ ថា ការ សិក្សា ពី គម្រោង បើក ច្រក អន្តរជាតិ ថ្មី នេះ គឺ ដើម្បី ត្រៀម ខ្លួន សម្រាប់ ការ ត ភ្ជាប់ កាន់ តែ ល្អ ជាមួយ បណ្តា ប្រទេស ក្នុង តំបន់ អាស៊ាន ក្នុង គោលដៅ ដោះ ដូរ ទំនិញ កាន់ តែ ងាយ ស្រួល នៅ ពេល សមាហរណកម្ម សេដ្ឋកិច្ច តំបន់ ចូល មក ដល់។
តាម របាយ ការណ៍ បូក សរុប ការងារ ឆ្នាំ ២០១២-២០១៣ របស់ ក្រសួង ទេសចរណ៍ កម្ពុជា មក ទល់ ពេល នេះ កម្ពុជា និង ថៃ មាន ច្រក ទ្វារ អន្តរជាតិ ចំនួន ៧ ដែល បូក បញ្ចូល ទាំង ច្រក ទ្វារ ថ្មី មួយ ទៀត ទើប នឹង ដំណើរការ គឺ ច្រក ជប់ គគីរ នៅ ខេត្ត ឧត្តរ មាន ជ័យ។
លោក លី អ៊ុតនី ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត បន្ទាយ មាន ជ័យ និង ជា ប្រធាន ក្រុមហ៊ុន លី អ៊ុតនី អឹមផត អិចផត បាន លើក ឡើង ថា រដ្ឋាភិបាល មាន គម្រោង បង្កើត ច្រក ទ្វារ អន្តរជាតិ ស្ទឹង បត់ នេះ ជា យូរ មក ហើយ តែ កន្លង មក មិន ទាន់ ចេញ ជា រូប រាង ច្បាស់ លាស់។
ដូច្នេះ ការ បង្កើត ឲ្យ មាន គណៈកម្មការ ចម្រុះ ដើម្បី សិក្សា ពី ការ រៀបចំ នា ពេល នេះ ជា ដំណើរ វិវឌ្ឍន៍ មួយ ដែល យើង សង្ឃឹម ថា ទ្វារ អន្តរជាតិ ស្ទឹង បត់ នឹង មាន ដំណើរការ ពិត ប្រាកដ នា ពេល ឆាប់ៗ ខាង មុខ។
«ច្រក ទ្វារ អន្តរជាតិ ថ្មី នេះ នឹង ជួយ សម្រួល ដល់ ការ ចរាចរ ទំនិញ និង ទេសចរ ចូល កម្ពុជា»។
លោក បន្ត ថា ច្រក ទ្វារ ប៉ោយប៉ែត ដែល កំពុង ដំណើរការ បច្ចុប្បន្ន តែង មាន ការ កក ស្ទះ ដោយ ភាព គ្មាន សណ្តាប់ធ្នាប់ នៃ ក្រុម រទេះ រុញ ធំៗ និង រថយន្ត ដឹក ហ្គាស ជាច្រើន៕
របាយការណ៍ បាន បង្ហាញ ថា ប្រាក់ ចំណូល របស់ ធនាគារ នេះ បាន កើនឡើង ៧៣ ភាគរយ ធៀប នឹង រយៈពេល ដូច គ្នា កាលពី ឆ្នាំ មុន ដល់ ៧,៨ លាន ដុល្លារ អាមេរិក។
លោកស្រី ហេង ធីតា នាយក ផ្នែក សេវា ហិរញ្ញវត្ថុ បុគ្គល បាន ថ្លែង ថា ៖
លោកស្រី ធីតា បន្ថែម ថា ៖
យើង រំពឹង ថា យើង នឹង បន្ត រីកលូតលាស់ កាន់តែ ខ្លាំង បន្ថែម លើ លទ្ធផល ឆ្នាំ ២០១៣ »។
សព្វថ្ងៃ ធនាគារ CIMB មាន សាខា ចំនួន ១១ កំពុង បម្រើ សេវាកម្ម និង ផលិតផល ជូន អតិថិជន នៅក្នុង ទីក្រុង សំខាន់ៗ ជាច្រើន មាន ដូចជា ទីក្រុង ភ្នំពេញ សៀមរាប ក្រុង ព្រះសីហនុ ខេត្ត បាត់ដំបង និង ខេត្ត កំពង់ចាម ។
លោក ឧបនាយករដ្ឋមន្ដ្រី ម៉ាឡេស៊ី បាន ថ្លែង នៅក្នុង ជំនួប ប្រជុំ មួយ នៅ រាជធានី ភ្នំពេញ កាលពី ចុង ខែ កុម្ភៈ ថា ទាំង ទំនាក់ទំនង ពាណិជ្ជកម្ម និង វិនិយោគ រវាង ប្រទេស ទាំង ពីរ គឺ មាន សភាព កាន់តែ រលូន ហើយ លោក ក៏ ស្នើ ឲ្យ ភាគី ទាំង ពីរ ខិតខំ បន្ត ទៀត ។
លោក បាន ឲ្យ ដឹង ថា ពាណិជ្ជកម្ម ទ្វេភាគី ប្រទេស ម៉ាឡេស៊ី ជាមួយ កម្ពុជា បាន កើនឡើង ១៣,៨ ភាគរយ ដល់ ៤២៩,៥៤ លាន ដុល្លារ អាមេរិក កាលពី ឆ្នាំ មុន ធៀប ជាមួយ នឹង ឆ្នាំ ២០១២ ហើយ ការ នាំ ចេញ របស់ ប្រទេស ម៉ាឡេស៊ី មក កាន់ ប្រទេស កម្ពុជា មាន ដូចជា វាយនភ័ណ្ឌ ផលិតផល លោហធាតុ អាហារ កែច្នៃ និង សារធាតុ គីមី ខណៈ ការ នាំ ចូល ពី កម្ពុជា មាន ដូចជា កៅស៊ូ និង អង្ករ ។
ភាគច្រើន ក្រុមហ៊ុន ម៉ាឡេស៊ី វិនិយោគ ខាង វិស័យ ហិរញ្ញវត្ថុ និង វិស័យ សេវាកម្ម ដែល ជា វិនិយោគិន បរទេស ឈាន មុខ គេ នៅ កម្ពុជា ។
ក្រសួងនឹងជួបប្រជុំបង្កើតសម្ព័ន្ធស្រូវអង្ករថ្នាក់ជាតិ
ភ្នំពេញៈ ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា នឹង ជួប ប្រជុំ ជាមួយ ក្រុម ពាណិជ្ជករ ស្រូវ-អង្ករ នៅ ថ្ងៃ ពុធ សប្តាហ៍ នេះ ដើម្បី ពិភាក្សា ពី ការ បង្កើត សហព័ន្ធ ស្រូវ-អង្ករ កម្ពុជា ដែល ជា ស្ថាប័ន ថ្នាក់ ជាតិ សម្រាប់ ជា ដៃគូ របស់ រដ្ឋាភិបាល ក្នុង ការ អភិវឌ្ឍ ឧស្សាហកម្ម នេះ ។
ការ រៀបចំ បង្កើត សហព័ន្ធ នេះ ធ្វើ ឡើង បន្ទាប់ពី មាន ការ ឯកភាព ពី លោក នាយករដ្ឋមន្រ្តី ហ៊ុន សែន ដែល កាលពី ថ្ងៃ អង្គារ សប្តាហ៍ មុន បាន សម្រេច អនុញ្ញាត ឲ្យ មាន ការ បង្កើត សហព័ន្ធ ស្រូវ-អង្ករ ដើម្បី ឲ្យ មាន ភាព ងាយស្រួល ក្នុង ការ សហការ ជាមួយ សហព័ន្ធ ស្រូវ អង្ករ ពី បណ្តា ប្រទេស ក្នុង តំបន់ អាស៊ាន និង ដើម្បី ត្រៀម ខ្លួន ក្នុង ការ ចូលរួម ប្រកួតប្រជែង នៅក្នុង សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ឆ្នាំ ២០១៥ ។
តំណាង ពាណិជ្ជករ ស្រូវ-អង្ករ នៅ កម្ពុជា ដែល បច្ចុប្បន្ន នៅ មាន ក្រុម ដោយ ឡែកៗ ពី គ្នា បាន លើក ឡើង ថា ការ រៀបចំ សហព័ន្ធ រួម គ្នា ថ្នាក់ ជាតិ មួយ គឺជា ការ ចាំបាច់ ដើម្បី ធ្វើឲ្យ ការ សហការ ក្នុង ចំណោម ពាណិជ្ជករ មាន ភាព រឹងមាំ ខណៈ បេសកកម្ម កន្លង មក ធ្វើ ឡើង ដាច់ ដោយឡែក ពី គ្នា។
លោក ដេវីដ វ៉ាន់វិចិត្រ អគ្គលេខាធិការ រង សម្ព័ន្ធ អ្នក ផលិត ស្រូវ និង នាំ ចេញ អង្ករ កម្ពុជា បាន ឲ្យ ដឹង ថា ការ បង្កើត សហព័ន្ធ ថ្នាក់ ជាតិ គឺជា ជំហាន នៃ ការ វិវត្ត មួយ ដើម្បី បង្កើត បរិយាកាស ឲ្យ ក្រុម ពាណិជ្ជករ ទាំងអស់ ធ្វើការ ចុះ សម្រុង គ្នា ឲ្យ បាន ល្អ ជាង មុន ដើម្បី ផលប្រយោជន៍ រួម។
« យើង គាំទ្រ វិធានការ ណា មួយ ដើម្បី ឲ្យ មាន ការ បង្រួបបង្រួម គ្នា ក្នុង វិស័យ ស្រូវ-អង្ករ។
កាល ណា មាន សហព័ន្ធ បង្កើត ថ្មី ពួកយើង ទាំងអស់ នឹង ស្ថិត ក្រោម ឆត្រ តែ មួយ របស់ សហព័ន្ធ»។
សមាគម នាំ ចេញ អង្ករ កម្ពុជា ដែល មាន លោក លឹម ប៊ុនហេង ជា ប្រធាន សម្ព័ន្ធ អ្នក ផលិត ស្រូវ និង នាំ ចេញ អង្ករ កម្ពុជា របស់ លោក ដេវីដ វ៉ាន់វិចិត្រ និង សហព័ន្ធ អ្នក នាំ ចេញ អង្ករ កម្ពុជា ដែល មាន លោក គឹម សាវុធ ជា ប្រធាន។
ការ មាន សមាគម បែកខ្ញែក គ្នា នា ពេល កន្លង មក ហាក់ ធ្វើឲ្យ ពាណិជ្ជករ ក្រុម នីមួយៗ មិន សហការ គ្នា បាន ល្អ ។
ពេល ដែល អង្ករ កម្ពុជា ត្រូវ បាន ជ្រើសរើស ជា អង្ករ មាន គុណភាព ល្អ ជាង គេ របស់ ពិភពលោក ជា លើក ទី ពីរ កាលពី ឆ្នាំ មុន ក្រុមហ៊ុន នាំ ចេញ អង្ករ មួយ ចំនួន អះអាង តាមរយៈ សារព័ត៌មាន ក្នុង ស្រុក ជាច្រើន ថា សមិទ្ធផល នោះ ជា របស់ ក្រុមហ៊ុន ខ្លួន។
ការ ប្រកាស របស់ ក្រុមហ៊ុន ទាំងនោះ គឺជា ការ ប្រាស់ចាក ពី ការ ព្រមព្រៀង មុន ពេល ចេញ ដំណើរ ទៅ ប្រកួត ខណៈ កាល នោះ តំណាង សមាគម សហព័ន្ធ និង ក្រុមហ៊ុន សុទ្ធតែ យល់ព្រម ថា ពួកគេ តំណាង ដល់ អង្ករ កម្ពុជា ហើយ រាល់ ជោគជ័យ ទាំងឡាយ ជា កេរ្តិ៍ឈ្មោះ និង ការ សម្រេច បាន របស់ កម្ពុជា ។
លោក គឹម សាវុធ ប្រធាន សម្ព័ន្ធ អ្នក នាំ ចេញ អង្ករ កម្ពុជា បាន ឲ្យ ដឹង ថា សម្ព័ន្ធ ស្រូវ-អង្ករ កម្ពុជា ដែល នឹង បង្កើត ឡើង នា ពេល ឆាប់ៗ នឹង ធ្វើឲ្យ ពាណិជ្ជករ ស្រូវ-អង្ករ ទាំងអស់ មាន កិច្ចសហការ គ្នា បាន ល្អ។
« ខ្ញុំ គិត ថា សហព័ន្ធ នេះ នឹង ធ្វើការ មាន ប្រសិទ្ធភាព ល្អ ហើយ ជួយ ពង្រឹង ភាព ប្រកួតប្រជែង របស់ អង្ករ កម្ពុជា កាន់តែ ខ្លាំង » ។
លោក លឹម ប៊ុនហេង ប្រធាន សមាគម នាំ ចេញ អង្ករ កម្ពុជា លើក ឡើង ស្រដៀង គ្នា នេះ ដែរ ។
តម្លៃគ្រាប់ស្វាយចន្ទីនៅតែពឹងលើប្រទេសជិតខាង
កំពង់ធំៈ កសិករ ខេត្ត កំពង់ធំ សម្តែង ការ ព្រួយបារម្ភ ពី ភាព មិន ប្រាកដប្រជា នៃ ទីផ្សារ និង តម្លៃ គ្រាប់ ស្វាយចន្ទី ខណៈ ការ ប្រមូល ផល ឆ្នាំ នេះ អាច នឹង កើនឡើង ។
អ្នក ជំនាញ និយាយ ថា ភាព មិន ប្រាកដប្រជា នៃ ទីផ្សារ និង តម្លៃ បណ្តាល មកពី ការ ពឹងផ្អែក ទៅលើ ទីផ្សារ ក្រៅ ស្រុក ។
លោក ពូ សុវណ្ណ ប្រធាន អង្គការ ស្រែ ខ្មែរ ជា អង្គការ ស្រាវជ្រាវ ពី ដំណាំ ស្វាយចន្ទី ពន្យល់ ថា ការ ធ្លាក់ ចុះ ទាំង បរិមាណ នាំ ចេញ និង តម្លៃ គ្រាប់ ស្វាយ ចន្ទី ក្នុង ឆ្នាំ ២០១៣ បណ្តាល មកពី ការ ធ្លាក់ ចុះ តម្រូវការ ពី ប្រទេស វៀតណាម និង ថៃ ដែល ជា ឈ្មួញ សំខាន់ សម្រាប់ ទីផ្សារ គ្រាប់ ស្វាយចន្ទី កម្ពុជា ។
អ្នកស្រី ថន រ៉េន កសិករ ដំណាំ ស្វាយចន្ទី នៅក្នុង ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ រំពឹង ថា ទិន្នផល គ្រាប់ ស្វាយចន្ទី នៅ រដូវ នេះ នឹង កើន លើស ឆ្នាំ មុន តែ និយាយ ថា តម្លៃ មាន ការ ធ្លាក់ ចុះ ។
