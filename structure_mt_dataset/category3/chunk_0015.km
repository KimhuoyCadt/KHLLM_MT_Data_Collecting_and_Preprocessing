ក្រោយពី អាន និង បង្ហាញ វត្ថុតាង ចប់ ចៅក្រម ជំរះ ប្រកាស សុំ ផ្អាក សវនាការ សិន ដោយ ទុកឲ្យ ព្រះរាជអាជ្ញា និង មេធាវី ធ្វើ សេចក្តីសន្និដ្ឋាន បញ្ចប់ រឿង នេះ នៅ ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០១៩ វេលា ម៉ោង ៨ ព្រឹក វិញ ។
ចំណែក សំណុំរឿង ទី ពីរ គឺ បទ « ផលិត វីដេអូ អាសអាភាស » ចៅក្រម ជំរះ បញ្ជាក់ ថា នឹង ជំរះ បន្ត នៅ ថ្ងៃ ដដែល ក្រោយពី ព្រះរាជអាជ្ញា និង មេធាវី ធ្វើ សេចក្តីសន្និដ្ឋាន ចប់ ។
ក្រោយពី ស្តាប់ ការសួរ ដេញដោល ក្នុង អង្គ សវនាការ ពេញ មួយ ព្រឹក នេះ ប្រធាន គ្រប់គ្រង ផ្នែក អង្កេត នៃ អង្គការ ការពារ សិទ្ធិ មនុស្ស លីកាដូ លោក អំ សំអាត កត់សំគាល់ ថា ភស្តុតាង ដែល មន្ត្រី នគរបាល យុត្តិធម៌ និង មន្ត្រី តុលាការ យកមក បង្ហាញ មិន មាន ទំងន់ ដាក់ បន្ទុក ដល់ អតីត អ្នកសារព័ត៌មាន ទាំងនោះ ទេ ។
អតីត បុគ្គលិក អាស៊ី សេរី លោក អ៊ួន ឈិន និង លោក យាង សុធារិន្ទ ត្រូវបាន តុលាការ សម្រេច ដោះលែង ឲ្យនៅ ក្រៅ ឃុំ កាលពី ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០១៨ បន្ទាប់ពី ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន កាលពី ពាក់កណ្ដាល ខែវិច្ឆិកា ឆ្នាំ ២០១៧ ។
បន្ទាប់ពី ការចាប់ខ្លួន ពួកគេ ត្រូវបាន តុលាការ ចោទប្រកាន់ ចំនួន ពីរ បទល្មើស ដោយ ទី មួយ បទ « ផ្តល់ ឱ្យ រដ្ឋ បរទេស នូវ ព័ត៌មាន ជាអាទិ៍ ដែល នាំឱ្យ អន្តរាយ ដល់ ការការពារ ជាតិ » និង ទី ពីរ បទ « ផលិត វីដេអូ អាសអាភាស » ៕
លោក គីម ប្តេជ្ញា ផលិត អាវុធ ឱ្យ ខ្លាំងក្លា បំផុត
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » លោក គីម ប្តេជ្ញា ផលិត អាវុធ ឱ្យ ខ្លាំងក្លា បំផុត មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន ប្តេជ្ញា ផលិត អាវុធ ដែល មាន ឥទ្ធិពល ខ្លាំងក្លា បំផុត ដើម្បី ការពារ សន្តិសុខ ប្រទេស ហើយ ព្រមាន ដល់ កូរ៉េ ខាងត្បូង ចំពោះ ការសហការ ធ្វើ សមយុទ្ធ យោធា ជាមួយ សហរដ្ឋ អាមេរិក ។
លោក គីម ជុង អ៊ុន ថ្លែង ថា កូរ៉េ ខាងជើង មិន ត្រឹមតែ មិន បញ្ឈប់ ទេ ថែមទាំង ប្រឹងប្រែង ផលិត ប្រព័ន្ធ អាវុធ ឱ្យ បាន ខ្លាំងក្លា បំផុត ដើម្បី លុបបំបាត់ ការគំរាមកំហែង ដល់ សន្តិសុខ ជាតិ ដែល អាច បង្កឡើង ដោយ ផ្ទាល់ ពី កូរ៉េ ខាងត្បូង ។
កាលពី ថ្ងៃព្រហស្បតិ៍ ម្សិលមិញ កូរ៉េ ខាងជើង បាន បាញ់ អាវុធ មីស៊ីល ចំនួន ពីរ គ្រាប់ ចូល ក្នុង សមុទ្រ ដោយសារ ខឹងសម្បារ ចំពោះ ការធ្វើ សមយុទ្ធ រួមគ្នា រវាង សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង ដែល គ្រោង ធ្វើឡើង នៅ ខែ ក្រោយ ។
កូរ៉េ ខាងជើង តែងតែ ចោទប្រកាន់ ថា កូរ៉េ ខាងត្បូង និង សហរដ្ឋ អាមេរិក មាន បំណង ផ្តួលរំលំ រដ្ឋាភិបាល កូរ៉េ ខាងជើង ។
ក្រសួង ការបរទេស សហរដ្ឋ អាមេរិក បាន អំពាវនាវ ចំពោះ ករណី នេះ ឱ្យ កូរ៉េ ខាងជើង បញ្ឈប់ ជាបន្ទាន់ ចំពោះ សកម្មភាព ណា ដែល បង្ក ជម្លោះ កាន់តែ ខ្លាំង ហើយ ងាក មក រក ការចរចា ដើម្បី លុបបំបាត់ អាវុធ នុយក្លេអ៊ែ ។
ចំណែក កូរ៉េ ខាងត្បូង ចាត់ទុក សកម្មភាព បាញ់ សាកល្បង អាវុធ ដែល គំរាមកំហែង ផ្នែក យោធា នេះ ថា វា មិន មាន ផលប្រយោជន៍ អ្វី ទេ ហើយ ផ្ទុយទៅវិញ វា បង្ក ភាពតានតឹង កាន់តែ ធ្ងន់ធ្ងរ ។
ទោះ យ៉ាងណា នៅក្នុង សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស ដែល ធ្វើឡើង ដោយ មេដឹកនាំ កូរ៉េ ខាងជើង នេះ គឺ លោក គីម ជុង អ៊ុន មិន បាន ភ្ជាប់ ឈ្មោះ អាមេរិក ទេ គឺ ថ្កោល ទោស តែ កូរ៉េ ខាងត្បូង ដែល ចូលរួម ធ្វើ សមយុទ្ធ ។
នៅ ខែ ក្រោយ នេះ កូរ៉េ ខាងត្បូង ធ្វើ សមយុទ្ធ ជាមួយ អាមេរិក ហើយ ប្រទេស ទាំង ពីរ តែងតែ ធ្វើ សមយុទ្ធ ជាមួយគ្នា ជាប្រចាំ ។
លោក គីម បាន រំឭក ដល់ កូរ៉េ ខាងត្បូង ឱ្យ បញ្ឈប់ សកម្មភាព នាំឱ្យ ស្លាប់ ខ្លួនឯង នេះ ដោយសារតែ ការបង្ក កំហុស ម្តង ហើយ ម្តង ទៀត ហើយ មិន ខ្វល់ខ្វាយ ជាមួយ សារ ព្រមាន របស់ កូរ៉េ ខាងជើង ។
ក្រសួង ការពារ ជាតិ កូរ៉េ ខាងត្បូង បាន លើកឡើង ថា ការបាញ់ មីស៊ីល កាលពី ម្សិលមិញ នេះ គឺ ស្ថិត នៅក្នុង ចម្ងាយ ៤៣០ គីឡូម៉ែត្រ ពី ទីក្រុង វ៉ុង សាន របស់ កូរ៉េ ខាងជើង ហើយ បាន បាញ់ ចូល ក្នុង សមុទ្រ ចម្ងាយ ៦៨៨ គីឡូម៉ែត្រ ។
ក្រុមប្រឹក្សា សន្តិសុខ ជាតិ របស់ កូរ៉េ ខាងត្បូង បញ្ជាក់ ថា អាវុធ មីស៊ីល ដែល កូរ៉េ ខាងជើង បាញ់ កាលពី ម្សិលមិញ ជា ប្រភេទ អាវុធ ថ្មី មិន ដែល ឃើញ ។
លោក ឈុំ សុជាតិ ថា ព្រលានយន្តហោះ នៅ តារាសាគរ ខេត្ត កោះកុង មិន ពាក់ព័ន្ធ នឹង សកម្មភាព យោធា ទេ
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » លោក ឈុំ សុជាតិ ថា ព្រលានយន្តហោះ នៅ តារាសាគរ ខេត្ត កោះកុង មិន ពាក់ព័ន្ធ នឹង សកម្មភាព យោធា ទេ អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ លោក ឈុំ សុជាតិ បញ្ជាក់ ថា ការស្ថាបនា ព្រលានយន្តហោះ នៅ តារាសាគរ ខេត្ត កោះកុង មិន ពាក់ព័ន្ធ នឹង ការបម្រើ សកម្មភាព យោធា ឡើយ ។
ការបញ្ជាក់ នេះ គឺ ដើម្បី ឆ្លើយតប ទៅនឹង សារព័ត៌មាន នានា ដែល ចុះផ្សាយ ពី លទ្ធភាព ដែល អាចនឹង មាន មូលដ្ឋាន កងទ័ព ចិន នៅលើ ទីតាំង នោះ ។
លោក ឈុំ សុជាតិ មានប្រសាសន៍ ថា ព្រលានយន្ដហោះ នៅ តារាសាគរ ដែល ស្ថាបនា ដោយ ក្រុមហ៊ុន ចិន នោះ ជា កម្មសិទ្ធិ ឯកជន ដែល សង់ ឡើង ដើម្បី បម្រើ វិស័យ ដឹកជញ្ជូន ផ្លូវ អាកាស ឯកជន មិន អាច ចុះចត យន្តហោះ យោធា ជាដាច់ខាត ។
លោក បញ្ជាក់ ថា ក្រសួង ការពារ ជាតិ នឹង បើក ចំហ បើសិន មាន ការសាកសួរ ឬ ទូត បរទេស ណា មាន គម្រោង ទស្សនកិច្ច នៅ មូលដ្ឋាន ជើង ទឹក កម្ពុជា នោះ ។
ចំណែក អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល លោក ផៃ ស៊ីផាន លើកឡើង ថា រដ្ឋធម្មនុញ្ញ កម្ពុជា កំណត់ ច្បាប់ ហាម មិន អោយ ដាក់ ទ័ព លើ ដី បរទេស ឬ យក ទ័ព បរទេស មក ដាក់ នៅក្នុង ស្រុក ឡើយ ។
រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ លោក ហ៊ុន សែន ក៏ គ្មាន គម្រោង វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ នោះ ដែរ ។
លោក ផៃ ស៊ីផាន ឯកភាព លើ ពាក្យ ដែល ថា ការបង្កើត មូលដ្ឋាន ទ័ព ចិន លើ ដី កម្ពុជា នឹង នាំអោយ មាន ភាពតានតឹង ក្នុង តំបន់ ។
ក្នុង ការចុះផ្សាយ នោះ ការសែត នេះ ក៏ បាន លើកឡើង អំពី ព្រលានយន្តហោះ តារាសាគរ ក្នុង ខេត្ត កោះកុង ដែល កំពុង សាងសង់ ផងដែរ ដោយ ថា ព្រលានយន្តហោះ នេះ អាច មាន លទ្ធភាព ផ្ទុក យន្តហោះ ចម្បាំង ធុន ធ្ងន់ ដែល អាច អនុញ្ញាតឱ្យ យោធា ចិន អាច ធ្វើ ប្រតិបត្តិការ បាន លឿន ក្នុង តំបន់ អាស៊ាន ។
ប៉ុន្តែ ត្រូវបាន ភាគី កម្ពុជា និង ចិន ចេញមុខ បាន បដិសេធ ចោល ជាបន្តបន្ទាប់ ។
នៅ ថ្ងៃ នេះ លោក ផៃ ស៊ីផាន និង លោក ឈុំ សុជាតិ បាន នាំ អ្នកកាសែត ជាង ៧០ នាក់ មកពី ៣៨ អង្គភាព អោយ ធ្វើ ទស្សនកិច្ច នៅ មូលដ្ឋាន កងទ័ព ជើងទឹក រាម ដោយ បាន បង្ហាញ ដល់ អ្នកកាសែត នូវ ទីតាំង ចំនួន ២ គឺ អគារ គណៈកម្មការ លំហរ សមុទ្រ ដែល ជា ជំនួយ របស់ សហរដ្ឋ អាមេរិក ដែល បាន សាងសង់ ក្នុង ឆ្នាំ ២០១៧ ៕
អាជ្ញា ថៃ ចាប់ខ្លួន ជនជាតិ ខ្មែរ ៩ នាក់ ព្រោះ មិន មាន ឯកសារ ត្រឹមត្រូវ
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » អាជ្ញា ថៃ ចាប់ខ្លួន ជនជាតិ ខ្មែរ ៩ នាក់ ព្រោះ មិន មាន ឯកសារ ត្រឹមត្រូវ សមត្ថកិច្ច ថៃ កាលពី ម្សិលមិញ បាន ចាប់ខ្លួន ពលរដ្ឋ ខ្មែរ ចំនួន ៩ នាក់ ដោយសារតែ ពួកគេ មិន មាន ឯកសារ ឆ្លង ដែន ត្រឹមត្រូវ ។
ប្រភព ដដែល ឲ្យដឹង ថា ក្រៅពី អ្នក ចំណាកស្រុក ជនជាតិ ខ្មែរ អាជ្ញាធរ ខេត្ត ស្រះកែវ ក៏ បាន ចាប់ខ្លួនអ្នកបើក រថយន្ត ដែល ជា ជនជាតិ ថៃ ផងដែរ ក្រោម បទ ចោទ ថា ជា មេខ្យល់ នាំ ពលករ ខ្មែរ ទាំងនោះ ចូល ទឹកដី ថៃ ។
អ្នកស្លាប់ ដោយសារ បាក់ ស្រុត ដី នៅ ចិន កើនឡើង ដល់ ២០ នាក់
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » អ្នកស្លាប់ ដោយសារ បាក់ ស្រុត ដី នៅ ចិន កើនឡើង ដល់ ២០ នាក់ ចំនួន អ្នកស្លាប់ នៅក្នុង ហេតុការណ៍ បាក់ ស្រុត ដី នៅក្នុង ភូមិ មួយ នៅ ភាគ អាគ្នេយ៍ នៃ ប្រទេស ចិន កើនឡើង ដល់ ២០ នាក់ គិត ត្រឹម ថ្ងៃសុក្រ នេះ ខណៈ អ្នកភូមិ ចំនួន ២៥ នាក់ ផ្សេង ទៀត កំពុង បាត់ខ្លួន ។
ចំណែក មនុស្ស ចំនួន ១១ នាក់ ត្រូវបាន ជួយសង្គ្រោះ ចាប់តាំងពី ការបាក់ ស្រុត ដី ដែល កើតឡើង តាំងពី ថ្ងៃអង្គារ ។
នៅ ប្រទេស ចិន តែងតែ ជួប បញ្ហា គ្រោះថ្នាក់ ដោយសារ ហេតុការណ៍ បាក់ ស្រុត ដី នៅ តំបន់ ដាច់ស្រយាល និង តំបន់ ភ្នំ ក្រោយពេល ដែល មាន ភ្លៀង ធ្លាក់ ខ្លាំង ។
តំណាង ពលរដ្ឋ មាន ជម្លោះ ដីធ្លី ៤ នាក់ ត្រូវ តុលាការ កោះកុង ហៅ សួរ ចំលើយ តាម បណ្តឹង ឧកញ៉ា ហេង ហ៊ុយ
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » តំណាង ពលរដ្ឋ មាន ជម្លោះ ដីធ្លី ៤ នាក់ ត្រូវ តុលាការ កោះកុង ហៅ សួរ ចំលើយ តាម បណ្តឹង ឧកញ៉ា ហេង ហ៊ុយ តំណាង ប្រជាពលរដ្ឋ ៤ នាក់ ដែល អះអាង ថា កំពុង មាន ជម្លោះ ដីធ្លី ជាមួយ ក្រុមហ៊ុន ហេង ហ៊ុយ អេ គ្រី ខាល់ ឈ័រ គ្រុប ក្នុង ស្រុក ស្រែ អំបិល ខេត្ត កោះកុង ត្រូវបាន តុលាការ កោះហៅ សួរ ចំលើយ តាម បណ្តឹង របស់ ប្រធាន ក្រុមហ៊ុន ។
ក្នុង ដីកា កោះ ចុះ ថ្ងៃ ផ្សេង ៗ គ្នា ក្នុង ខែកក្កដា ដូចគ្នា តំណាង អយ្យការ អម សាលាដំបូង ខេត្ត កោះកុង លោក អ៊ង រី បាន កោះហៅ តំណាង ពលរដ្ឋ ៤ នាក់ ឲ្យ ឆ្លើយ បំភ្លឺ ជាបន្តបន្ទាប់ ចាប់ពី ចុង ខែកក្កដា ដល់ ខែសីហា តាម បណ្តឹង របស់ លោក ហេង ហ៊ុយ ដែល ប្តឹង ពី បទ បរិហារ កេរ្តិ៍ ជាសាធារណៈ បទ បរិហារ បង្កាច់ កេរិ៍្ត និង ញុះញង់ ឲ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ ។
តំណាង ពលរដ្ឋ រូប នេះ បាន បង្ហាញ ការខកចិត្ត និង ថា វា ជា រឿង អយុត្តិធម៌ បំផុត ដែល គ្រួសារ គាត់ ត្រូវបាន ក្រុមហ៊ុន ហេង ហ៊ុយ រំលោភ យក ដីធ្លី អស់ ហើយ ថែមទាំង ត្រូវ ម្ចាស់ ក្រុមហ៊ុន មួយ នេះ ប្តឹង ទៅ តុលាការ ទៀត ។
អ្នកស្រី មានប្រសាសន៍ ថា ៖ « អយុត្តិធម៌ ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ ពួក ខ្ញុំ ព្រោះ ដី ខ្លួនឯង ត្រូវបាន លោក ឧកញ៉ា គាត់ រំលោភបំពាន ហើយ គាត់ ប្តឹង ពួក ខ្ញុំ ទៅ តុលាការ ទៀត ។
ហើយ ការកោះហៅ គឺជា ការគំរាមកំហែង ខ្ញុំ និង ប្រជាពលរដ្ឋ ពួក ខ្ញុំ ទាំងអស់ គ្នា មិន ឲ្យ តវ៉ា ជាដើម » ។
តំណាង ពលរដ្ឋ ម្នាក់ ទៀត អ្នកស្រី អិន ធូ និយាយ ថា ទោះបី អ្នកស្រី បារម្ភ ពី សុវត្ថិភាព និង មិន សង្ឃឹម ឈ្នះ ក្តី ជាមួយ ម្ចាស់ ក្រុមហ៊ុន ហេង ហ៊ុយ ក៏ដោយ អ្នកស្រី នឹង ចូល បំភ្លឺ តាម ដីកា កោះ របស់ តុលាការ ពេល ដែល រក មេធាវី មក ការពារ ក្តី បាន ។
អ្នកស្រី អះអាង ថា គាត់ និង ពលរដ្ឋ ផ្សេង ទៀត ក៏ មិន បោះបង់ ការតវ៉ា ទាមទារ ដីធ្លី មកវិញ នោះ ដែរ ។
មន្រ្តី ការពារ សិទ្ធិ មនុស្ស រូប នេះ បាន ស្នើ តុលាការ ឲ្យ ធ្វើ ការ ដោយ ឯករាជ្យ និង ត្រូវ ស៊ើប ឲ្យបាន ច្បាស់លាស់ ដើម្បី ចៀសវាង ធ្វើ ការសម្រេច មិន ត្រឹមត្រូវ ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សិទ្ធិ ប្រជាពលរដ្ឋ ។
ពួកគាត់ និយាយ អ្វី ដែល ជា រឿង ពិត ។
អ៊ីចឹង តុលាការ ត្រូវតែ ត្រួតពិនិត្យ ឲ្យ មែនទែន ចំពោះ បណ្តឹង នេះ ព្រោះ មិន មែន ថា ឧកញ៉ា ហេង ហ៊ុយ ចោទប្រជាពលរដ្ឋ ហើយ តុលាការ ធ្វើ ទៅ បណ្តឹង ឧកញ៉ា ហេង ហ៊ុយ នោះ ទេ ។
តុលាការ ត្រូវ មើល ពី មូលហេតុ ជាក់ស្តែង របស់ ប្រជាពលរដ្ឋ ថា គាត់ និយាយ ហ្នឹង ចេញពី មូលហេតុ ណាមួយ ឲ្យ ជាក់លាក់ ថា គាត់ និយាយ ភូតភរ ជាសាធារណៈ ដែរ អត់ » ។
ក្នុង ខែកក្កដា នេះ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន ចេញ សេចក្តីប្រកាស ពីរ ដង ដោយ ច្រាន សំណើ របស់ តំណាង ពលរដ្ឋ ប្រហែល ១០០ នាក់ នៅ ខេត្ត កោះកុង ដែល អះអាង ថា កំពុង មាន ជម្លោះ ដីធ្លី ជាមួយ ក្រុមហ៊ុន ហេង ហ៊ុយ នៅ ស្រុក ស្រែ អំបិល ខេត្ត កោះកុង ។
ក្រសួង រៀបចំ ដែនដី បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ប្រហែលជា ១០០ នាក់ ដែល អះអាង ថា តំណាង ឲ្យ ពលរដ្ឋ ១៩៧ គ្រួសារ មកពី ឃុំ ជីខ លើ និង ជីខ ក្រោម ស្រុក ស្រែ អំបិល ខេត្ត កោះកុង ដែល នាំគ្នា ឡើង មក ភ្នំពេញ ដើម្បី ស្នើ ទៅ ក្រសួង ជួយ ដោះស្រាយ បញ្ហា ជម្លោះ ដីធ្លី នោះ មិន ជាប់ពាក់ព័ន្ធ នឹង ករណី វិវាទ ដីធ្លី ទេ និង មិន ទទួល ដោះស្រាយ ឡើយ ។
ក្រសួង មួយ នេះ បាន ស្នើ ទៅ អាជ្ញាធរ ពាក់ព័ន្ធ ចាត់ វិធានការ ផ្លូវ ច្បាប់ លើ ពលរដ្ឋ ទាំងនោះ ទៀតផង ៕
ក្រសួង យុត្តិធម៌ ផ្អាក មុខងារ ព្រះរាជអាជ្ញា ខេត្ត រតនគិរី ជា បណ្ដោះអាសន្ន ពាក់ព័ន្ធ អំពើ ផិត ក្បត់
ក្នុង លិខិត នោះ សរសេរ ថា ៖ « យោង តាម មាត្រា ៥៨ និង មាត្រា ១០០ នៃ ច្បាប់ ស្ដីពី លក្ខន្ដិកៈ នៃ ចៅក្រម និង ព្រះរាជអាជ្ញា ក្រសួង យុត្តិធម៌ ផ្អាក មុខងារ របស់ លោក ជា ពេជ្រ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី ជា បណ្ដោះអាសន្ន រហូតដល់ មាន សេចក្តីសម្រេច របស់ តុលាការ អំពី ទោស ជា ស្ថាពរ » ។
អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ លោក ជិន ម៉ាលី ន មានប្រសាសន៍ ថា ការផ្អាក ជា បណ្ដោះអាសន្ន នេះ គឺជា ការផ្អាក មុខងារ ប៉ុណ្ណោះ ដែល មាន ន័យ ថា លោក ជា ពេជ្រ នៅ អាច ទទួលបាន ប្រាក់ បៀវត្ស និង ប្រាក់ អត្ថប្រយោជន៍ ផ្សេង ទៀត បាន ។
ប៉ុន្តែ លោក បញ្ជាក់ ថា ប្រាក់ បៀវត្ស និង តួនាទី នេះ ក៏ នឹង បាត់បង់ ផងដែរ ប្រសិនជា តុលាការ រកឃើញ កំហុស ដូច ដែល បាន ចោទប្រកាន់ មែន នោះ ។
អ្នកឯកទេស ឯករាជ្យ ផ្នែក សិទ្ធិ មនុស្ស លោក សួន ប៊ុន ស័ក្កិ គាំទ្រ ចំពោះ ចំណាត់ ការ ច្បាប់ នេះ ដោយ ថា ដើម្បី ជួយ កែទម្រង់ ប្រព័ន្ធ យុត្តិធម៌ ក្នុង ប្រទេស ។
លោក សួន ប៊ុន ស័ក្កិ ៖ « ដើម្បីឱ្យ មាន យុត្តិធម៌ ទាល់តែ មន្ត្រី យុត្តិធម៌ ហ្នឹង ធ្វើឱ្យ ត្រឹមត្រូវ ហើយ បើ មន្ត្រី យុត្តិធម៌ ធ្វើ មិន ត្រឹមត្រូវ តើ ធ្វើ ម៉េច នឹង អាច រក យុត្តិធម៌ ភាពត្រឹមត្រូវ ជូន ប្រជាពលរដ្ឋ ទៅ ។
ទី មួយ បើ ច្បាប់ ឱ្យ អំណាច ហើយ ក្រសួង យុត្តិធម៌ គាត់ ធ្វើ ចុះ ឲ្យ តែ ធ្វើ តាម នីតិវិធី ច្បាប់ ដែល ច្បាប់ ផ្ដល់ អំណាច ឱ្យ ក្នុង គោលបំណង កែលំអ ប្រព័ន្ធ យុត្តិធម៌ ដូច ខ្ញុំ ថា អញ្ចឹង ! ដើម្បី កែប្រព័ន្ធ យុត្តិធម៌ ត្រូវ កែច្បាប់ ទម្លាប់ ឲ្យ ល្អ ហើយ ត្រូវ កែទម្រង់ ចរិត មនុស្ស មនុស្ស ហ្នឹង គឺ មន្ត្រី យុត្តិធម៌ ឱ្យ ដើរ ឱ្យ ល្អ ដែរ » ។
ក្រោយ ការដក បញ្ឈរ ជើង លោក ជា ពេជ្រ ជា បណ្ដោះអាសន្ន នេះ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ក៏ សម្រេច ផ្លាស់ ព្រះរាជអាជ្ញា រង នៃ អយ្យការ សាលាដំបូង រាជធានី ភ្នំពេញ លោក ងិន ពេជ ឲ្យ ទៅ បំពេញ មុខងារ ជា ព្រះរាជអាជ្ញា ស្ដី ទី នៃ ខេត្ត រតនគិរី រហូតដល់ មាន ការតែងតាំង ផ្លូវការ ផងដែរ ៕
រដ្ឋាភិបាល បញ្ជាក់ ថា ការលើក ពេល ប្រជុំ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃស្អែក គឺ មកពី គ្មាន កិច្ចការ ចាំបាច់ ដែល ត្រូវ ប្រជុំ
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » រដ្ឋាភិបាល បញ្ជាក់ ថា ការលើក ពេល ប្រជុំ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃស្អែក គឺ មកពី គ្មាន កិច្ចការ ចាំបាច់ ដែល ត្រូវ ប្រជុំ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ថា ការលើក ពេល ប្រជុំ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃស្អែក នេះ គឺ បណ្ដាល មកពី មិន មាន កិច្ចការ ណា ដែល តម្រូវ ចាំបាច់ ឱ្យ មាន ការសម្រេច ពី រដ្ឋាភិបាល និង គ្មាន របៀបវារៈ គ្រប់គ្រាន់ ដើម្បី ប្រជុំ ។
ការលើកឡើង នេះ គឺ បន្ទាប់ពី មាន អ្នកប្រើប្រាស់ ហ្វេសប៊ុក មួយចំនួន បាន វាយតម្លៃ ពី ការលើក ពេល ប្រជុំ នេះ ទៅនឹង ស្ថានភាព សុខភាព របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ដែល ទើបតែ មកពី ព្យាបាល គ្រេច ស្មា នៅ ប្រទេស សឹង្ហបុរី ។
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល លោក ផៃ ស៊ីផាន មានប្រសាសន៍ ក្នុង សន្នី សិទ្ន សារព័ត៌មាន នៅ ព្រឹក នេះ ថា ស្ថានភាព សុខភាព របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន គឺ មាន សុខភាព ល្អ និង ប្រក្រតី មិន ដូច ការលើកឡើង របស់ អ្នក មាន និន្នាការ ប្រឆាំង ដែល បាន សរសេរ អាក្រក់ ពី ស្ថានភាព លោក នាយក រដ្ឋមន្ត្រី នោះ ទេ ។
សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន លោក នៅតែ បំពេញ ភារកិច្ច របស់ លោក ប្រក្រតី សុខ មាលភាព របស់ លោក ប្រក្រតី កាលពី ម្សិលមិញ ខ្ញុំ ផ្ទាល់ ក៏ បាន ទាក់ទង ទៅ សម្ដេច ដោយ ផ្ទាល់ ដែរ ដូច្នេះ គ្មាន អ្វី ដែល ស្ថិត នៅក្នុង ការវាយតម្លៃ អាក្រក់ ពី មជ្ឈដ្ឋាន ខាងក្រៅ នោះ ទេ » ។
នៅ ថ្ងៃ នេះ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ក៏ បាន សរសេរ លើ ហ្វេសបុក របស់ ផងដែរ ថា សុខភាព របស់ លោក គឺ រឹងមាំ ធម្មតា ខណៈ នៅ ថ្ងៃស្អែក នេះ លោក នឹង ទទួល ជួប ភ្ញៀវ អន្តរជាតិ នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី ទៀតផង ។
ក្នុង លិខិត មួយ កាលពី ម្សិលមិញ រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី លោក ប៊ិន ឈិន បាន សម្រេច លើក ពេល នៃ កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី នា ថ្ងៃទី ២៦ ខែកក្កដា ស្អែក នេះ ទៅ លើក ក្រោយ វិញ ដោយ តាម លិខិត នោះ គឺ ធ្វើឡើង តាម សំណើ របស់ ខុទ្ទកាល័យ របស់ លោក នាយក រដ្ឋមន្ត្រី ។
កាលពី ថ្ងៃទី ១២ ខែកក្កដា កន្លងទៅ ក្រោយ ត្រឡប់ មកពី សម្រាក ព្យាបាល ជំងឺ គ្រេច ស្មា នៅ ប្រទេស សឹង្ហបុរី លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ព្រមាន ចាត់ វិធានការ លើ បុគ្គល ទាំងឡាយ ណា ផ្សព្វផ្សាយ បំផ្លើស ពី ស្ថានភាព សុខភាព របស់ លោក ដោយ ថា ទង្វើ នេះ ជា បទល្មើស ព្រហ្មទណ្ឌ ៕
រដ្ឋាភិបាល បញ្ជាក់ ថា ការលើក ពេល ប្រជុំ គណរដ្ឋមន្ត្រី នៅ ថ្ងៃស្អែក គឺ មកពី គ្មាន កិច្ចការ ចាំបាច់ ដែល ត្រូវ ប្រជុំ
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » រដ្ឋាភិបាល បញ្ជាក់ ថា ការលើក ពេល ប្រជុំ គណរដ្ឋមន្ត្រី នៅ ថ្ងៃស្អែក គឺ មកពី គ្មាន កិច្ចការ ចាំបាច់ ដែល ត្រូវ ប្រជុំ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ថា ការលើក ពេល ប្រជុំ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃស្អែក នេះ គឺ បណ្ដាល មកពី មិន មាន កិច្ចការ ដែល តម្រូវ ចាំបាច់ ឱ្យ មាន ការសម្រេច ពី រដ្ឋាភិបាល និង គ្មាន របៀបវារៈ គ្រប់គ្រាន់ ដើម្បី ប្រជុំ ។
ការលើកឡើង នេះ គឺ បន្ទាប់ពី មាន អ្នកប្រើប្រាស់ ហ្វេសបុក មួយចំនួន បាន វាយតម្លៃ ពី ការលើក ពេល ប្រជុំ នេះ ទៅនឹង ស្ថានភាព សុខភាព របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ដែល ទើបតែ មកពី ព្យាបាល គ្រិច ស្មា នៅ ប្រទេស សឹង្ហបុរី ។
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល លោក ផៃ ស៊ីផាន មានប្រសាសន៍ ក្នុង សន្នី សិទ្ន សារព័ត៌មាន នៅ ព្រឹក នេះ ថា ស្ថានភាព សុខភាព របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន គឺ មាន សុខភាព ល្អ និង ប្រក្រតី មិន ដូច ការលើកឡើង របស់ អ្នក មាន និន្នាការ ប្រឆាំង ដែល បាន សរសេរ អាក្រក់ ពី ស្ថានភាព លោក នាយក រដ្ឋមន្ត្រី នោះ ទេ ។
នៅ ថ្ងៃ នេះ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ក៏ បាន សរសេរ លើ ហ្វេសបុក របស់ ផងដែរ ថា សុខភាព របស់ លោក គឺ រឹងមាំ ធម្មតា ខណៈ នៅ ថ្ងៃស្អែក នេះ លោក នឹង ទទួល ជួប ភ្ញៀវ អន្តរជាតិ នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី ទៀតផង ។
ក្នុង លិខិត មួយ កាលពី ម្សិលមិញ រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី លោក ប៊ិន ឈិន បាន សម្រេច លើក ពេល នៃ កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី នា ថ្ងៃទី ២៦ កក្កដា ស្អែក នេះ ទៅ លើក ក្រោយ វិញ ដោយ តាម លិខិត នោះ គឺ ធ្វើឡើង តាម សំណើ របស់ ខុទ្ទ ការល័យ របស់ លោក នាយក រដ្ឋមន្ត្រី ។
កាលពី ថ្ងៃទី ១២ កក្កដា កន្លងទៅ ក្រោយ ត្រឡប់ មកពី សម្រាក ព្យាបាល ជំងឺ គ្រេច ស្មា នៅ ប្រទេស សឹង្ហបុរី លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ព្រមាន ចាត់ វិធានការ លើ បុគ្គល ទាំងឡាយ ណា ផ្សព្វផ្សាយ បំផ្លើស ពី ស្ថានភាព សុខភាព របស់ លោក ដោយ ថា ទង្វើ នេះ ជា បទល្មើស ព្រហ្មទណ្ឌ ៕
NGOs ជំរុញ រដ្ឋាភិបាល ឲ្យ ចាត់ការ ក្រុមហ៊ុន លក់ ម្សៅ ទឹកដោះគោ រំលោភ ប្បញ្ញត្តិ ច្បាប់
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » NGOs ជំរុញ រដ្ឋាភិបាល ឲ្យ ចាត់ការ ក្រុមហ៊ុន លក់ ម្សៅ ទឹកដោះគោ រំលោភ ប្បញ្ញត្តិ ច្បាប់ ក្រុម មន្ត្រី សង្គម ស៊ីវិល ដែល ជំរុញ ការបំបៅ កូន ដោយ ទឹកដោះ ម្ដាយ បាន ទាមទារ ទៅ រដ្ឋាភិបាល ឲ្យ ចាត់ វិធានការ ទៅលើ ក្រុមហ៊ុន ដែល ត្រូវបាន រកឃើញ ថា បាន រំលោភ ទៅលើ សេចក្ដីណែនាំ អំពី ការចែកចាយ ផលិតផល ម្សៅ ទឹកដោះគោ ខណៈ ដែល ពួកគេ លើកឡើង ថា ការបំបៅ ទារក ដោយ ទឹកដោះ ម្ដាយ ធ្លាក់ចុះ ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ។
ក្រុម មន្ត្រី សង្គម ស៊ីវិល ទាំងនោះ បាន ទាមទារ បែប នេះ នៅក្នុង សិក្ខាសាលា មួយ ជាមួយ ក្រុម អ្នកសារព័ត៌មាន កម្ពុជា ដែល ត្រូវបាន រៀបចំឡើង នៅ រាជធានី ភ្នំពេញ នៅ ថ្ងៃ នេះ ។
មន្ត្រី សង្គម ស៊ីវិល រូប នេះ ឲ្យដឹង ទៀត ថា ការបំបៅ ទារក ដោយ ម្សៅ ទឹកដោះគោ បាន បង្កឲ្យ ទារក ប្រឈមមុខ នឹង ជំងឺ រាគរូស ហើយ ស្ត្រី ជា ម្ដាយ ប្រឈមមុខ នឹង ជំងឺ ទឹកនោម ផ្អែម ដែល នាំឲ្យ កម្ពុជា ខាតបង់ ប្រាក់ ដល់ ទៅ ជាង ១ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ចំណាយ ទៅលើ ការព្យាបាល ទាំង ម្ដាយ និង ទារក ។
បើ តាម លោក ហ៊ូ ក្រើន គ្រួសារ ពលរដ្ឋ កម្ពុជា ក៏ ខាតបង់ ប្រាក់ ដល់ ទៅ ជាង ១០០ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ សម្រាប់ ចំណាយ ទៅ លើ ផលិតផល ម្សៅ ទឹកដោះគោ ផងដែរ ។
លោក ហ៊ូ ក្រើន បាន ឲ្យដឹង ទៀត ថា កុមារ ដែល ពុំ ទទួលបាន ការបំបៅ ដោយ ទឹកដោះ ម្ដាយ ឲ្យបាន គ្រប់គ្រាន់ ប្រឈមមុខ នឹង កម្រិត លូតលាស់ ខាង បញ្ញា ស្មារតី និង រាងកាយ និង ងាយ នឹង ប្រឈមមុខ នឹង ជំងឺ នានា ដែល ធ្វើឲ្យ កម្ពុជា ប្រឈមមុខ នឹង ការខាតបង់ ប្រាក់ សម្រាប់ ព្យាបាល ដល់ ទៅ ជាង ៣២៦ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ៗ ។
ដោយសារ ការផ្សព្វផ្សាយ ហ្នឹង វា បំប៉ោង ខ្លាំង ពេក ធ្វើឲ្យ សហគមន៍ ឬ ម្ដាយ ៗ ហ្នឹង គិត ថា ទឹកដោះគោ ហ្នឹង មាន គុណភាព គុណ តម្លៃ ហើយនិង សារធាតុ ចិញ្ចឹម ហ្នឹង ល្អ ជាង ទឹកដោះ ម្ដាយ » ។
ការផ្សព្វផ្សាយ ផលិតផល ម្សៅ ទឹកដោះគោ ត្រូវបាន រដ្ឋាភិបាល ហាមឃាត់ ហើយ ការចែកចាយ ផលិតផល បែប នេះ ត្រូវបាន កំណត់ ឲ្យ ភ្ជាប់ ជាមួយ សារ « គ្មាន អ្វី ប្រសើរ ជាង ទឹកដោះ ម្ដាយ » និង សារ ព្រមាន ដទៃ ទៀត នៅលើ សំបក វេចខ្ចប់ នៃ ផលិតផល របស់ ពួកគេ ។
នេះ បើ តាម អនុក្រឹត្យ លេខ ១៣៣ ស្ដីពី ការផ្សព្វផ្សាយ លក់ ផលិតផល សម្រាប់ ចិញ្ចឹម ទារ ក និង កុមារ ចេញ រដ្ឋាភិបាល កាលពី ឆ្នាំ ២០០៥ ។
មន្ត្រី ជាន់ ខ្ពស់ គោលនយោបាយ នៃ អង្គការ ទស្សនៈ ពិភពលោក អ្នកស្រី សាំង រ៉ាន្នី បាន លើកឡើង នៅឯ សិក្ខាសាលា នោះ ដែរ ថា អង្គការ មួយ នេះ បាន រកឃើញ ផលិតផល ម្សៅ ទឹកដោះ ជាច្រើន ប្រភេទ ត្រូវបាន ចែកចាយ និង លក់ បន្ត នៅ ទូទាំង ប្រទេស កម្ពុជា ដោយ មិន បាន អនុវត្ត តាម បទប្បញ្ញត្តិ នេះ នោះ ឡើយ ។
អ្នកស្រី សាំង រ៉ាន្នី បាន លើកឡើង បន្ថែម ទៀត ថា ក្រុម អ្នកតស៊ូ មតិ ពី ក្រុម អង្គការ សង្គម ស៊ីវិល បាន ទាមទារ ទៅ រដ្ឋាភិបាល ឲ្យ បញ្ចេញ ឈ្មោះ ក្រុមហ៊ុន ដែល បាន រំលោភ លើ សេចក្ដីណែនាំ នេះ ប៉ុន្តែ អ្នកស្រី ថា រដ្ឋាភិបាល ពុំ បង្ហាញ ឲ្យ សាធារណជន ដឹង នោះ ឡើយ ។
អ្នកស្រី រ៉ាន្នី ជំរុញ ទៅ រដ្ឋាភិបាល ឲ្យ បង្កើន ចំនួន ទឹកប្រាក់ ផាក ពិន័យ ទៅលើ ក្រុមហ៊ុន នាំចូល និង ចែកចាយ ផលិតផល ម្សៅ ទឹកដោះ នៅ កម្ពុជា ដោយ អ្នកស្រី ចាត់ទុក ប្រាក់ ផាក ពិន័យ ត្រឹមតែ ២ លាន រៀល ជា ចំនួន តិចតួច មិន អាច ឲ្យ ក្រុមហ៊ុន រាងចាល នោះ ឡើយ ។
អ្នកស្រី សាំង រ៉ានី មានប្រសាសន៍ ថា ៖ « ប៉ុន្តែ យើង សំណូមពរ ទៅដល់ ខាងក្រសួង ប្រសិនបើ អាច សូមឲ្យ បញ្ចេញ ឈ្មោះ ក្រុមហ៊ុន អ្នក ដែល ប្រព្រឹត្ត ខុស ទៅនឹង អនុក្រឹត្យ លេខ ១៣៣ ហ្នឹង ណ៎ា ។
អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល លោក លី សូវ៉ាន់ បាន បដិសេធ បកស្រាយ លម្អិត ជុំវិញ បញ្ហា នេះ ដោយ លោក ប្រាប់ ថា « ជាប់រវល់ ប្រជុំ » ។
របាយការណ៍ អង្គការ សុខភាព ពិភពលោក កាលពី ឆ្នាំ មុន បាន រកឃើញ ថា ការបំបៅ ទារក ដោយ ទឹកដោះគោ បាន ធ្វើឲ្យ ខាតបង់ ថវិកា ដល់ ទៅ ៣៤១ ពាន់ លាន ដុល្លារ នៅ ទូទាំង ពិភពលោក ក្នុង មួយ ឆ្នាំ ៗ ។
អង្គការ សុខភាព ពិភពលោក បាន ឲ្យដឹង ទៀត ថា ការបំបៅ ទារក ដោយ ទឹកដោះ ម្ដាយ អាច ជួយសង្គ្រោះ ជីវិត មនុស្ស ជា អ ៨២ ម៉ឺន នាក់ និង ជួយសង្គ្រោះ ស្ត្រី ដល់ ទៅ ២ ម៉ឺន នាក់ ពី ជំងឺ មហារីក សុដន់ ក្នុង មួយ ឆ្នាំ ៗ ។
រដ្ឋាភិបាល គ្រោង នាំ អ្នកសារព័ត៌មាន ទៅ ពិនិត្យមើល ទីតាំង ដែល កាសែត អាមេរិក មួយ ចោទ ថា មាន មូលដ្ឋាន ទ័ព ចិន
ក្នុង សន្នី សិទ្ធ សារព័ត៌មាន នៅ ព្រឹក នេះ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល លោក ផៃ ស៊ីផាន បាន បញ្ជាក់ ថា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ លោក ទៀ បាញ់ បាន សម្រេច ឲ្យ មន្ត្រី របស់ ខ្លួន នាំ អ្នកកាសែត ទៅ ពិនិត្យមើល ទីតាំង ក្នុង ខេត្ត ព្រះសីហនុ លើ មូលដ្ឋាន កងទ័ព ជើងទឹក រាម នៅ ថ្ងៃស្អែក ដោយ នឹង អនុញ្ញាតឲ្យ អ្នក ការសែត សួរ សំណួរ ទៅកាន់ មន្ត្រី ដែល ដឹកនាំ ទស្សនកិច្ច នោះ ផងដែរ ។
តែ កម្ពុជា គឺ យើង ស្មោះស្ម័គ្រ ជាមួយ អ្នកសារព័ត៌មាន រហូត គួរ សប្បាយរីករាយ ជាមួយ កម្ពុជា ទោះបីជា គេ ថា អត់ មាន សេរីភាព ។
ប៉ុន្តែ ការចុះផ្សាយ នេះ ត្រូវបាន ភាគី កម្ពុជា និង ចិន បាន បដិសេធ ចោល ជាបន្តបន្ទាប់ ៕
អង្គការ អន្តរជាតិ អំពាវនាវ ឲ្យ ទម្លាក់ បទ ចោទ អតីត អ្នកយកព័ត៌មាន អាស៊ី សេរី
អង្គការ អ្នកសារព័ត៌មាន គ្មាន ព្រំដែន ហៅ សវនាការ ដែល នឹង ត្រូវ ធ្វើឡើង នៅ ថ្ងៃស្អែក ថា ជា ការកើនឡើង នៃ ការយាយី លើ អ្នកសារព័ត៌មាន ដោយ ប្រើប្រាស់ ប្រព័ន្ធ តុលាការ ។
អង្គការ ដដែល នេះ បាន លើកឡើង ថា ការចោទប្រកាន់ កន្លងមក របស់ តុលាការ ទៅ លើ អ្នក ទាំង ពីរ ក៏ មិន មាន ភស្តុតាង រឹងមាំ ឡើយ ។
លោក ថា ពួកគេ ត្រូវបាន ទទួលរង ការឈឺចាប់ រួច មកហើយ នៅក្នុង ពន្ធនាគារ រយៈពេល ៩ ខែ ហើយ នៅ ពេល នេះ កំពុង ប្រឈម នឹង ការចោទប្រកាន់ ដ៏ អយុត្តិធម៌ ទៀត ។
អ្នក ពាក្យ រូប នេះ អះអាង ទៀត ថា ជា ការឆ្លើយតប របស់ ក្រសួង បើ ស្ថាប័ន អន្តរជាតិ ទាំងនោះ ចង់ ជួយ ជន ត្រូវ ចោទ ទាំង ពីរ នេះ មាន តែ ចូលក្នុង ដំណើរការ នីតិវិធី របស់ តុលាការ កម្ពុជា ក្នុង ការផ្តល់ ជំនួយ ផ្នែក ច្បាប់ ។
អីចឹង ការអំពាវនាវ ឲ្យ រដ្ឋាភិបាល ដោះលែង ជា ការអំពាវនាវ មួយ មិន ស្រប តាម ក្របខណ្ឌ ច្បាប់ និង រដ្ឋធម្មនុញ្ញ របស់ កម្ពុជា ហើយ ជា ការអំពាវនាវ មួយ ផ្អែក ទៅលើ ចរិត នយោបាយ មិន ផ្អែក ទៅលើ ទិដ្ឋភាព ច្បាប់ និង រដ្ឋធម្មនុញ្ញ របស់ កម្ពុជា ទាល់តែសោះ » ។
ប្រធាន គ្រប់គ្រង ផ្នែក អង្កេត នៅ អង្គការ លីកាដូ លោក អំ សំអាត មានប្រសាសន៍ ថា តាម ការអង្កេត របស់ អង្គការ សង្គម ស៊ីវិល លោក អ៊ួន ឈិន និង លោក យាង សុធារិន្ទ គួរតែ ត្រូវបាន ទម្លាក់ បទ ចោទ ដោយ ថា ពួកគេ ទាំង ពី ហាក់ មិន បាន ធ្វើ អ្វី ខុស ដូច ការចោទប្រកាន់ ទេ ។
អ្នកឃ្លាំមើល សិទ្ធិ មនុស្ស រូប នេះ អះអាង ថា តែ ផ្ទុយទៅវិញ ការឃុំខ្លួន អ្នក ទាំង ពី កន្លងទៅ វា បាន ជំរុញឲ្យ មាន ការរិះគន់ ថា រំលោភ សេរីភាព អ្នកសារព័ត៌មាន បំពាន សិទ្ធិ មនុស្ស ទៅ វិញ ទេ ។
អតីត បុគ្គលិក អាស៊ី សេរី លោក អ៊ួន ឈិន និង លោក យាង សុធារិន្ទ ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន កាលពី ពាក់កណ្ដាល ខែវិច្ឆិកា ឆ្នាំ ២០១៧ នៅពេល ពួកគាត់ បង្កើត ស្ទូឌីយូថត ចម្រៀង នៅ ផ្ទះ ជួល ដែល អាជ្ញាធរ ចោទ ថា គ្មាន ការអនុញ្ញាត ។
ករណី នេះ ព្រះរាជអាជ្ញា បាន ចោទប្រកាន់ ពី បទ « ប្រគល់ឲ្យ រដ្ឋ បរទេស នូវ ព័ត៌មាន ជាអាទិ៍ ដែល បង្កឲ្យ មាន ការអន្តរាយ ដល់ ការការពារ ជាតិ » តាម មាត្រា ៤៤៥ នៃ ក្រម ព្រហ្មទណ្ឌ ។
ការចាប់ ឃុំខ្លួន និង ចោទប្រកាន់ អ្នក ទាំង ពីរ នា ពេល នោះ ខណៈ ដែល ស្ថាន ការ នយោបាយ ឡើង កម្តៅ ដូចជា មាន ការចាប់ ឃុំខ្លួន អតីត មេដឹកនាំ បក្ស ប្រឆាំង លោក កឹម សុខា ការបណ្តេញ អង្គការ NDI របស់ អាមេរិក ចេញ ពី កម្ពុជា បិទ ប្រព័ន្ធ ផ្សព្វផ្សាយ ឯករាជ្យ និង រំលាយ គណបក្ស ប្រឆាំង ជាដើម ។
ប៉ុន្តែ ក្រោយ ឃុំខ្លួន ក្នុង ពន្ធនាគារ អស់ រយៈពេល ជាង ៩ ខែ លោក អ៊ួន ឈិន និង លោក យាង សុធារិន្ទ ត្រូវបាន តុលាការ ដោះលែង ឱ្យ នៅ ក្រៅ ឃុំ បណ្ដោះអាសន្ន ។
ទោះជា យ៉ាងណា ក្នុង កិច្ចប្រជុំ សភា ពេញ អង្គ កាលពី ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ លោក ប៉ែន បញ្ញា ជា សមាជិក សភា និង ជា ប្រធាន គណៈកម្មការ នីតិកម្ម និង យុត្តិធម៌ នៃ រដ្ឋសភា បាន រំឭក រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ លោក អង្គ វង្ស វឌ្ឍា នា ឱ្យ ពិនិត្យ ឡើងវិញ ពី ការអនុវត្ត ច្បាប់ ទប់ស្កាត់ កុំ ឱ្យ តុលាការ កាត់ក្តី ធ្វើ តាម ការបង្គាប់ ពី បុគ្គល ណាមួយ ដើម្បី ធានា ថា តុលាការ ជា ស្ថាប័ន ឯករាជ្យ ដូច មាន ចែង ក្នុង រដ្ឋធម្មនុញ្ញ ។
សមាជិក សភា កូតា មកពី គណបក្ស ប្រជាជន កម្ពុជា រូប នេះ បន្ថែម ទៀត ថា ក្រសួង យុត្តិធម៌ គួរ ធ្វើ យ៉ាងណា ឱ្យ ស្ថាប័ន តុលាការ ជា កន្លែង ផ្តល់ យុត្តិធម៌ ជូន ពលរដ្ឋ ប្រកបដោយ ការទុកចិត្ត ដើម្បី លុបបំបាត់ ស្រមោល ភ័យខ្លាច របស់ ពលរដ្ឋ ពេល ឮ ឈ្មោះ តុលាការ ៕
កូរ៉េ ខាងជើង បាញ់ មីស៊ីល ប្រភេទ ថ្មី ២ គ្រាប់
ទំព័រ ដើម » ព័ត៌មាន ទាន់ ហេតុការណ៍ » កូរ៉េ ខាងជើង បាញ់ មីស៊ីល ប្រភេទ ថ្មី ២ គ្រាប់ អ្នកជំនាញ របស់ អាមេរិក និង កូរ៉េ ខាងត្បូង អះអាង ថា កូរ៉េ ខាងជើង បាញ់ សាកល្បង អាវុធ មីស៊ីល ២ គ្រាប់ ទៀត ដែល ហោះ បាន ចម្ងាយ ៦៩០ គីឡូម៉ែត្រ ជា ប្រភេទ មីស៊ីល ដែល គេ មិន ធ្លាប់ បាន ឃើញ នៅពេល កន្លងមក ។
ប្រធាន គណៈកម្មការ បុគ្គលិក រួម របស់ កូរ៉េ ខាងត្បូង ប្រកាស ថា កូរ៉េ ខាងជើង បាញ់ សាកល្បង នៅ ព្រឹក នេះ ។
ការបាញ់ នេះ ចាប់ផ្តើម ចេញ ពី ទីក្រុង វ៉ុង សាន ឆ្នេរ ភាគ ខាងកើត របស់ កូរ៉េ ខាងជើង ។
ក្នុង សេចក្តីថ្លែងការណ៍ ដាច់គ្នា របស់ អ្នកជំនាញ សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង បញ្ជាក់ ថា មីស៊ីល ដែល កូរ៉េ ខាងជើង បាញ់ លើក នេះ គឺជា មីស៊ីល ប្រភេទ ថ្មី ដែល មិន ធ្លាប់ ឃើញ កន្លងមក ។
នេះ ជា លើក ទី ១ ហើយ ដែល កូរ៉េ ខាងជើង បាញ់ មីស៊ីល បន្ទាប់ពី មេដឹកនាំ កូរ៉េ ខាងជើង និង មេដឹកនាំ សហរដ្ឋ អាមេរិក ជួបគ្នា កាលពី ខែ មុន ហើយ បាន ព្រមព្រៀង គ្នា ក្នុង ការជជែក ពី ដំណើរការ រំសាយ ចោល អាវុធ នុយក្លេអ៊ែ ។
ការបាញ់ សាកល្បង អាវុធ មីស៊ីល របស់ កូរ៉េ ខាងជើង នៅ ពេល នេះ ជា ការបង្ហាញ ថា កូរ៉េ ខាងជើង ខឹងសម្បារ លើ គម្រោង របស់ សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង ដែល ធ្វើ សមយុទ្ធ រួមគ្នា នៅ ខែ ក្រោយ ។
កាលពី ខែឧសភា កូរ៉េ ខាងជើង ក៏ បាន បាញ់ សាកល្បង អាវុធ មីស៊ីល កម្រិត ខ្លី ប៉ុន្តែ លោក ត្រាំ ថ្លែង ថា ករណី នេះ មិន ប៉ះពាល់ ដល់ ទំនាក់ទំនង រវាង លោក ជាមួយ លោក គីម ជុង អ៊ុន នោះ ទេ ។
មេដឹកនាំ ទាំង ពីរ បាន ជួបគ្នា ដោយ មិន បាន ព្រាង ទុក កាលពី ថ្ងៃទី ៣០ ខែមិថុនា នៅ តំបន់ មិន មាន យោធា រវាង កូរ៉េ ខាងជើង និង កូរ៉េ ខាងត្បូង ។
ភាគី ទាំង ពីរ បាន ព្រមព្រៀង ចាប់ យក ការជជែកគ្នា ឡើងវិញ ដើម្បី ដោះស្រាយ បញ្ហា អាវុធ នុយក្លេអ៊ែរបស់ កូរ៉េ ខាងជើង បន្ទាប់ពី បរាជ័យ ក្នុង ការជជែកគ្នា នៅ ទីក្រុង ហាណូយ នៅក្នុង ប្រទេស វៀតណាម ។
យន្តហោះ កូរ៉េ ខាងជើង ហោះ ផ្ទាល់ ទៅ ម៉ាកាវ ប្រទេស ចិន
តាម សេចក្តីប្រកាស របស់ អាជ្ញាធរ អាកាសចរណ៍ ស៊ីវិល នៅ ដែនដី ម៉ាកាវ បញ្ជាក់ ថា ប្រតិបត្តិការ ហោះហើរ រវាង ព្យុងយ៉ាង និង ម៉ាកាវ ចាប់ផ្តើម ពី ថ្ងៃទី ២ ខែសីហា គឺ ហោះហើរ ពីរ ដង ក្នុង ១ សប្តាហ៍ ។
ការបើក សម្ពោធ ជាថ្មី ទៀត នៃ ការភ្ជាប់ ផ្លូវ អាកាស រវាង ដែនដី ទាំង ពីរ នេះ គឺ ធ្វើឱ្យ ម៉ាកាវ អាច ហោះហើរ ទៅកាន់ ទីតាំង បាន បួន គឺ ទៅ ប៉េកាំង រដ្ឋធានី របស់ ចិន សេន យ៉ាង ក្នុង ប្រទេស ចិន ផ្លាឌីវ៉ូស្តុក ក្នុង ប្រទេស រុស្ស៊ី និង ព្យុងយ៉ាង ប្រទេស កូរ៉េ ខាងជើង ។
ម៉ាកាវ គឺជា ដែនដី ស្វយ័ត មាន ការលេង ល្បែង ធំ ជាង គេ នៅ អាស៊ី ដែល ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ រដ្ឋអំណាច ចិន ប៉េកាំង ។
លោក គីម ជុង ណាម បងប្អូន ម្តាយ ផ្សេង ៗ គ្នា ជាមួយ លោក គីម ជុង អ៊ុន ធ្លាប់ បាន គេចខ្លួន ទៅ រស់នៅ ជាមួយ ប្រពន្ធ និង កូន នៅ ម៉ាកាវ មុន ត្រូវ ថ្នាំ បំពុល សម្លាប់ ក្នុង ទីក្រុង កូឡាឡាំពួ នៅ ព្រលានយន្តហោះ កាលពី ឆ្នាំ ២០១៧ ។
