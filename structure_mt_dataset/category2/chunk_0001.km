សារសេចក្តីជូនដំណឹង
ពុម្ពសំឡេងរោទិ៍
ការស្វែងរកបញ្ជីសេចក្តីជូនដំណឹង
ដើម្បីមិនធ្វើការផ្លាស់ប្តូរចុងក្រោយវិញ ជ្រើស កែសម្រួល មិនធ្វើវិញ ។ ដើម្បីធ្វើការផ្លាស់ប្តូរចុងក្រោយវិញ ជ្រើស កែសម្រួល ធ្វើវិញ.
ការស្វែងរកបញ្ជីសេចក្តីជូនដំណឹង
ការស្វែងរកអ្វីដែលបានបង្ហាញដូចតទៅនេះ ៖
មានតែសេចក្តីជូនដំណឹងបច្ចុប្បន្នទេត្រូវបានបង្ហាញក្នុងបញ្ជីសេចក្តីជូនដំណឹងហើយក៏អាចត្រូវបានជ្រើសសម្រាប់ស្វែងរកផងដែរ & # 160; ។ ដូច្នេះបើអ្នកចង់ស្វែងរកសេចក្តីជូនដំណឹងដែលផុតកំណត់ ជាដំបូងអ្នកត្រូវតែបង្ហាញពួកវាដែលបានរៀបរាប់នៅក្នុងសម័យខាងលើជាមុនសិន ។
ការបង្កើត និងការអនុវត្តសំឡេងរោទិ៍
ការបង្កើតសំឡេងរោទិ៍ថ្មី
ដោយការជ្រើសរើស អ្នកអាចបង្កើតសំឡេងរោទិ៍ថ្មីមួយដែលបានកំណត់រចនាសម្ព័ន្ធជាមុនពីប្រភពខុសៗគ្នា ៖
ការកែប្រែសំឡេងរោទិ៍ដែលមានរួចហើយ
ដើម្បីកែប្រែសំឡេងរោទិ៍មិនទាន់ស្រេចដែលមាន ( សំឡេងរោទិ៍ដែលផុតកំណត់មិនអាចកែប្រែ) ត្រូវធ្វើតាមជំហានដូច ខាងក្រោម ៖
បង្ហាញ ប្រអប់កែសម្រួលសំឡេងរោទិ៍នេះ ។
លុប ឬធ្វើឲ្យសំឡេងរោទិ៍សកម្មឡើងវិញ
បើក ឬបិទសំឡេងរោទិ៍
ការទទួលស្គាល់សំឡេងរោទិ៍
ពុម្ពសំឡេងរោទិ៍
ដើម្បីបង្កើតសំឡេងរោទិ៍ ពឹងផ្នែកលើពុម្ព បើក ប្រអប់កែសម្រួលសំឡេងរោទិ៍ ការកំណត់ស្រេចជាមួយពុម្ពលម្អិត ៖
ការកំណត់រចនាសម្ព័ន្ធពុម្ព
ដើម្បីបង្កើតពុម្ពសំឡេងរោទិ៍ថ្មី ត្រូវធ្វើតាមជំហានដូចខាងក្រោម ៖
ប្រអប់កែសម្រួលពុម្ព
ដេមិនការជូនដំណឹង
ពុម្ពសំឡេងរោទិ៍
ការនាំចូលសំឡេងរោទិ៍ពីប្រតិទិនខាងក្រៅ
ការនាំចូលសំឡេងរោទិ៍ពីប្រតិទិនខាងក្រៅ
ដើម្បីមិនធ្វើការផ្លាស់ប្តូរចុងក្រោយវិញ ជ្រើស កែសម្រួល មិនធ្វើវិញ ។ ដើម្បីធ្វើការផ្លាស់ប្តូរចុងក្រោយវិញ ជ្រើស កែសម្រួល ធ្វើវិញ.
មិនធ្វើវិញ ឬធ្វើវិញ
ដើម្បីមិនធ្វើការផ្លាស់ប្តូរចុងក្រោយវិញ ជ្រើស កែសម្រួល មិនធ្វើវិញ ។ ដើម្បីធ្វើការផ្លាស់ប្តូរចុងក្រោយវិញ ជ្រើស កែសម្រួល ធ្វើវិញ.
ផ្លាស់ប្តូរការធ្វើវិញក្រៅពីការផ្លាស់ប្តូរចុងក្រោយដែលបានធ្វើរួចប្រហាក់ប្រហែលគ្នា ប្រើប្រាស់ ប៊ូតុងរបារឧបករណ៍ ធ្វើវិញ & # 160; ។
ប្រអប់កែសម្រួលសំឡេងរោទិ៍
រូបថតអេក្រង់ប្រអប់កែសម្រួលសំឡេងរោទិ៍
រូបថតអេក្រង់ប្រអប់កែសម្រួលសំឡេងរោទិ៍
អំពើសំឡេងរោទិ៍
នៅក្នុងប្រអប់ក្រុម អំពើ ជ្រើសប្រភេទសំឡេងរោទិ៍ ៖
បិទការជូនដំណឹង
ជ្រើស សំឡេង អាចឲ្យអ្នកស្តាប់សំឡេងរោទិ៍ ពេលសារសំឡេងរោទិ៍ត្រូវបានបង្ហាញ ៖ ជ្រើស
នៅក្នុងប្រអប់ឯកសារសំឡេង
ការជូនដំណឹងនៃពាក្យបញ្ជា
បើកការជូនដំណឹង
កំណត់ជម្រើសដូចខាងក្រោមនេះ ៖
នៅក្នុងប្រអប់ក្រុម ពេលវេលា ក៏ជ្រើសវាដែរ
បើសំឡេងរោទិ៍កើតឡើងដដែលៗ ធីក កម្មវិធីរំលឹកសម្រាប់តែការកើតឡើងគ្រាដំបូង បើអ្នកចង់ឲ្យកម្មវិធីរំលឹកមុនការកើតឡើងដដែលៗដំបូងរបស់សំឡេងរោទិ៍ & # 160; ។ បើដោះធីកកម្មវិធីរំលឹកកំណត់រយៈពេលចាប់ផ្តើមតិចជាងចន្លោះពេលកើតឡើងដដែលៗ ។
ជម្រើសការបោះបង់ចោលពេលក្រោយកំណត់របៀបដំណើរការបន្ទាប់ពីពេលវេលាកំណត់ពេលរបស់វា ៖
ធីកប្រអប់ បិទបង្អួចស្វ័យប្រវត្តិបន្ទាប់ពីពេលនេះ បើអ្នកចង់បានបង្អួចសំឡេងរោទិ៍វានឹងបិទស្វ័យប្រវត្តិបើវានៅបង្ហាញពេលផុតកំណត់នៃពេលវេលាការបោះបង់យឺត & # 160; ។
ការកើតឡើងដដែលៗ
ក្នុងប្រអប់ក្រុម ច្បាប់កើតឡើង កំណត់ប្រភេទការកើតឡើងដដែលៗ ឬរយៈដូចខាងក្រោយនេះ ៖
បើអ្នករៀបចំការកើតឡើងដដែលៗប្រចាំឆ្នាំ នៅថ្ងៃទី ២៩ ខែកុម្ភៈបញ្ជាក់ថាតើវានឹងត្រូវដោះស្រាយដោយរបៀបណាបើវាមិនមែនជាឆ្នាំបង្គ្រប់ ដោយជ្រើសយមួយតាមជម្រើសដូចខាងក្រោមនេះ ៖
នៅក្នុងប្រអប់ក្រុម បញ្ចប់ការកើតឡើងដដែលៗ កំណត់វិសាលភាពពេលវេលានៃការកើតឡើងដដែលៗទាំងអស់ដូចខាងក្រោមនេះ ៖
ធីក កើតឡើងរៀងរាល់ ដើម្បីរៀបចំពាក្យដដែលៗ ឬដោះធីកវាដើម្បីយកពាក្យដដែលៗចេញ ។ បើបានធីក កើតឡើងរៀងរាល់ រៀបចំពាក្យដដែលៗដូចតទៅនេះ ៖
បញ្ជាក់ពាក្យដដែលៗក៏បាន ឬថេរវេលារបស់វាក៏បាន ៖
ការត្រួតពិនិត្រដដៃទៀត
បង្អួចសារការជូនដំណឹង
បង្អួចសារការជូនដំណឹងផ្តល់នូវជម្រើសដែលអាចប្រើសម្រាប់បង្ហាញការជូនដំណឹងដូចខាងក្រោមនេះ ៖
បង្អួចសារការជូនដំណឹង
ប្រតិបត្តិការថាសប្រព័ន្ធ
ចុចកណ្តុរ ស្តាំ លើរូបតំណាងថាសប្រព័ន្ធដើម្បីបង្ហាញម៉ឺនុយបរិបទរបស់វា ៖
បើកការជូនដំណឹង
ការបិទ និងបើកការជូនដំណឹង
ការជូនដំណឹងថ្មីបានមកពីពុម្ព
ស្តារ ឬបង្រួមអប្បបរមា
ស្ថានភាពបិទ ឬបើកឯកជនរបស់ការជូនដំណឹងចង្អុរបង្ហាញដោយពណ៌នៅក្នុងបញ្ជីការជូនដំណឹង( ពណ៌ដែលអាចចាប់ផ្តើមកំណត់រចនាសម្ព័ន្ធក្នុងផ្ទាំង ពុម្ពអក្សរ និង ពណ៌ នៃប្រអប់ចំណូលចិត្ត) & # 160; ។
ធ្វើឲ្យការជូនដំណឹងស្រស់
ការបិទ និងបើកការជូនដំណឹង
ស្ថានភាពបិទ ឬបើកឯកជនរបស់ការជូនដំណឹងចង្អុរបង្ហាញដោយពណ៌នៅក្នុងបញ្ជីការជូនដំណឹង( ពណ៌ដែលអាចចាប់ផ្តើមកំណត់រចនាសម្ព័ន្ធក្នុងផ្ទាំង ពុម្ពអក្សរ និង ពណ៌ នៃប្រអប់ចំណូលចិត្ត) & # 160; ។
សម្រាប់ការកេះការជូនដំណឹង វាត្រូវតែបើកការគ្រប់គ្រងការជូនដំណឹងដោយដៃ ។
បើកការត្រួតពិនិត្យ
ស្ថានភាពបិទ ឬបើកឯកជនរបស់ការជូនដំណឹងចង្អុរបង្ហាញដោយពណ៌នៅក្នុងបញ្ជីការជូនដំណឹង( ពណ៌ដែលអាចចាប់ផ្តើមកំណត់រចនាសម្ព័ន្ធក្នុងផ្ទាំង ពុម្ពអក្សរ និង ពណ៌ នៃប្រអប់ចំណូលចិត្ត) & # 160; ។
បើការត្រួតពិនិត្យការជូនដំណឹងបច្ចុប្បន្នបានបិទបច្ចុប្បន្ន អនុវត្តតាមជំហានបើកការជូនដំណឹងដូចខាងក្រោមនេះ ៖
បិទការត្រួតពិនិត្យសេចក្តីជូនដំណឹង
