ខ្ញុំ ដឹង បន្តិច អំពី អំពើហិង្សា និង សង្គ្រាម ។
អ្នក ជាទីគោរព ស្រឡាញ់ របស់ ព្រះ និង ទេវតា ។
កាតព្វកិច្ច តំណាង ឱ្យ ខ្លួន ឯង ក្នុង លក្ខណៈ គំរូ ។
បុរសចំណាស់នោះបានប្រាប់ខ្ញុំឱ្យឱ្យអ្នក នូវរូបថតនេះ។
យើងធ្វើការ ទាំងយប់ទាំងថ្ងៃដើម្បីយកពួកគេ មក វិញ » ។
ចូរធ្វើចំពោះពួកគេ ដូចអ្នកបានធ្វើចំពោះ ជន ជាតិម៉ាឌាន ឬដូចដែលអ្នកបានធ្វើចំពោះ ស៊ី សេរ៉ា និងយ៉ាប៊ីន នៅទន្លេគី សុន ។
ខ្ញុំចង់ដឹងអំពីអ្នកមើលរបស់ខ្ញុំ ។
អ្នកដែលមិនអាចទទួល យកបាន ក៏មិនអាចទទួលស្គាល់ថាខ្លួន ជាអ្នកទទួល ការ អនុគ្រោះពីអ្នក ដទៃដែរ ។
លោកមាន ប្រសាសន៍ទៅគាត់ ថា៖ « ចូរក្រោកឡើងទៅ ជំនឿរបស់អ្នកបានធ្វើឲ្យអ្នក ជា សះស្បើយហើយ » ។
អ្នកចាស់ជាងខ្ញុំមួយឆ្នាំ !
ទាំងនេះទំនងជាកើតឡើងនៅពេលខ្ញុំក្រោកឡើងភ្លាម ។
ជនភៀសខ្លួន វ័យ ក្មេង និង ជន ចំណាកស្រុក នៅ ប្រទេស ក្រិក៖ « កុំ ភ្លេច ពួកយើង »
នៅ ពេល ដែល ពួកគេ មាន អារម្មណ៍ ថា មាន ការគំរាមកំហែង នោះ ពួកគេ អាច ចាត់ វិធានការបាន ។
ស្រមោល នឹង រះ ពេញ ពិភពលោក
តើមានអ្វីកើតឡើងជាមួយក្រុមអាល់កៃដា ?
គាត់ ជឿ ថា ការផ្ទេរ អាចនឹង កើតឡើង នៅ ឆ្នាំ ក្រោយ ។
វា បង្រួម ជួរ ដែល សេះ បង្កង់ នឹង ត្រូវបាន គេ មើលឃើញ ។
ប្រយោគ ដែល តែងតែ នៅក្នុង ចិត្ត របស់ ខ្ញុំ គឺ៖
ឪពុក ម្តាយ ណា ម្នាក់ នឹង ប្រាប់ អ្នក ថា សុវត្ថិភាព របស់ កូន របស់ ពួកគេ គឺជា រឿង សំខាន់ បំផុត នៅក្នុង ពិភពលោក សម្រាប់ ពួកគេ ។
រក្សាពួកគេក្នុងការ ថែទាំ ជាប្រចាំរបស់អ្នក ហើយ នាំពួកគេទៅកន្លែងសុវត្ថិភាព ។
មិនមែនរដ្ឋ តែមួយទេ » ។
ព្រះយេស៊ូមានព្រះបន្ទូលទៅនាង ថា៖ « តើខ្ញុំមិនបានប្រាប់អ្នក រាល់គ្នាថា បើអ្នក ជឿ អ្នកនឹងឃើញសិរី រុងរឿងរបស់ព្រះជាម្ចាស់ ? » ។
« គឺម្នាក់ក្នុងចំណោមដប់ ពីរនាក់ ដែលជ្រលក់ចានជាមួយខ្ញុំ ។
ខ្ញុំចង់ឲ្យខ្ញុំប៉ោងបែបហ្នឹង » ។
ច្រើន ទៀត នៅក្នុង សៀវភៅ កិច្ចការ
មនុស្សជាតិ ទាំងមូល ស្ថិត នៅក្រោម ច្បាប់ របស់ ព្រះ។ គ្មាន នរណា ម្នាក់ អាច គេចផុត ពី វា បាន ទេ ។
ពេលរកឃើញគាត់ គាត់បានក្លាយទៅជាអស់ សង្ឃឹម និងអាក្រក់ ។
មាន ច្រើន ទៀត ប៉ុន្តែ នោះ គឺជា រឿង ធំ បំផុត ។
ចេញ ពី ផ្លូវ របស់ អ្នក ដើម្បី យក សមាជិក ថ្មី នៅក្រោម ស្លាប របស់ អ្នក ។
ដើម្បី ជួយ ក្នុង ការគណនា ថ្លៃ ដើម ស្តង់ដារ ។
ចងចាំ អំណាច នៃ ការអធិស្ឋាន ; ចងចាំ ពី គ្រោះថ្នាក់ នៃ ការអធិស្ឋាន ។
គាត់បាននិយាយថា៖ « ពេលមកដល់យើងបានរកឃើញដីហើយជាន់ទីមួយមានពន្លឺ។
វា ល្អ ប្រសិនបើ អ្នក ដើរ ដោយ ដំបង ។
ទាំងនេះគឺជាថ្នាំសម្រាប់កម្ចាត់មេរោគ ហើយវានឹងទាក់ទាញពួកវា។
អ្នក មកឆ្ងាយហើយជិតដល់ហើយ !
ពួកគេ ធ្វើ ដូច្នេះ ដោយ បញ្ឆោត អ្នក ដោយ ជឿ ថា ពួកគេ អាច ផ្តល់ឱ្យ អ្នក នូវ ប្រភេទ នៃ ទំនាក់ទំនង ដែល អ្នក ចង់បាន ។
អ្នក នៅ ទីនេះ ហើយ គ្មាន នរណា ម្នាក់ ក្នុង ចំណោម ពួកយើង នាំ អ្នក មក ទេ ។
ពេលសួរថាអ្នក ណានៅក្នុងនោះ គាត់ឆ្លើយ ថា៖ « នោះជាម៉ាក់ខ្ញុំ » ។
រាត្រី សួស្តី រាត្រី សួស្តី វា មាន មន្តស្នេហ៍
គាត់អំពាវនាវចំពោះសេចក្ដី សុចរិតរបស់ព្រះអម្ចាស់ និងសេចក្ដី មេត្តា ក រុណារបស់ទ្រង់ ។
ពាក្យ គន្លឹះ៖ ការព្យាបាល គ្រួសារ ។
ខ្ញុំ មានអារម្មណ៍ ខ្សោយ ជារៀងរាល់ ថ្ងៃ ។
លើកទឹកចិត្ត និង លើកតម្កើង អ្នក ដែល មាន ជំនាញ ឱ្យដឹង ពី វា ។
ក្រោយពីភ្ញាក់ពីដំណេក នាងបានបញ្ចុះ បញ្ចូលខ្លួនឯងថា វាគ្រាន់ តែជាសុបិនឆ្កួត ៗប៉ុណ្ណោះ ។
ពេលវាកើតឡើង យើងនឹងដឹងថា វាគ្មាននរណាក្រៅពីព្រះ។
ហើយអត់ទេ ខ្ញុំមាន ន័យថា ... ឬដំឡើងពន្ធ ។
វា គ្រប់គ្រាន់ ដើម្បី ធ្វើឱ្យ ក្មេងស្រី ចង់ ដើរ ។
" មាន រឿង ជាច្រើន ដែល អ្នក មិន អាច ទទួលបាន នៅក្នុង ទីក្រុង កាប៊ុល ។
ហើយ ការបោះឆ្នោត មិន មែន សម្រាប់ អ្នកទេ ។
ពេលនេះគាត់មិនដែលបានដឹងពី ភាពសុខសាន្តមួយម៉ោងឡើយ រហូតដល់ថ្ងៃមួយ គាត់តាំង ចិត្តរត់ចេញពីផ្ទះ ដោយបន្សល់ទុកនូវអ្វី ៗទាំងអស់ដែលគាត់មាន ។
ពួកគេចូលទៅក្នុងព្រៃទាំងកណ្តាលយប់ ជាកន្លែងដុតភ្លើង រួចវាយទាត់ធាក់ និងចាក់លោក Lauwers រហូតដល់ស្លាប់ ។
4 ពេត្រុសសម្លឹងមើលគាត់យ៉ាងយកចិត្តទុកដាក់ ដូចលោក យ៉ូហាន ហើយនិយាយថា៖ « មើលមកយើង » ។
ដោយសារតែ អ្នក បាន និយាយ ថា អ្នក មិន ចង់បាន អ្វី ទាំងអស់ ។
ទាំងយប់ទាំងថ្ងៃ ពួកគេតាមច្រកទ្វារក្រុង ដើម្បីសម្លាប់លោក ។
មុនការ ប្រយុទ្ធ យ៉ូស្វេបានឃើញ « មេទ័ពរបស់ព្រះអម្ចាស់ » ( ប្រហែលជាព្រះអម្ចាស់ផ្ទាល់ ) ឈរ ទល់ មុខគាត់ដោយ កាន់ដាវរបស់ទ្រង់ក្នុងដៃរបស់ទ្រង់ ។
មិន អាច រង់ចាំ សម្រាប់ ផ្តាច់ មុខ បាន ទេ ។
សូមទុកគាត់ឲ្យនៅក្បែរខ្ញុំគ្រប់ពេលក្នុងជីវិតរបស់ខ្ញុំ ។
4 - ហើយ ទំនុកចិត្ត បែប នេះ យើង មាន តាមរយៈ ព្រះគ្រីស្ទ ចំពោះ ព្រះ។
ខ្ញុំ សង្ឃឹម ថា អ្នក ទាំងអស់ គ្នា បាន ឃើញ ពី អ្វី ដែល បាន កើតឡើង នៅ ទីក្រុង វ៉ាស៊ីនតោន កាលពី ថ្ងៃសុក្រ ។
សាការីជាបូជាចារ្យនៃគ្រួសារអើរ៉ុន ។
សេចក្តីសង្ខេប៖ អ្នក មាន សិទ្ធិ កែតម្រូវ ទិន្នន័យ របស់ អ្នក ។
« សូមលើក ត ម្កើងព្រះអម្ចាស់ ជាព្រះ នៃ ជន ជាតិអ៊ីស្រាអែល ដែលបានចាត់អ្នកឲ្យមកជួបខ្ញុំនៅថ្ងៃនេះ ។
ហើយពួកគេបានបន្តយ៉ាងយូរជាមួយពួកសិស្ស ។
អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាស្លាប់ក៏ដោយ ក៏អ្នកនោះនឹងមានជីវិត » ។
យើង មិន ចង់ ប៉ះទង្គិច ជាមួយ អ្នកទេ ។
... អ័ ប្រាហាំមាន ប្រសាសន៍ទៅគាត់ ថា៖ « គេមានម៉ូសេ និងហោរា ។ អនុញ្ញាតឱ្យ ពួកគេ ស្តាប់ ពួកគេ ។
ពេល យ៉ូសែបបានឮដូច្នេះ គាត់ចាប់ផ្ដើមយំ ។
« ជំហានដំបូងរបស់យើងគឺយកមនុស្សតាមដងទន្លេ ។
ខ្ញុំ នឹង ព្យាយាម បំបែក ខ្សែ សង្វាក់
ខ្ញុំ បាន ហៀរ ទឹកមាត់ គ្រប់គ្រាន់ ហើយ មែន ទេ ?
ការប្រើប្រាស់ នៅ ដំណាក់កាល នេះ អាច ប៉ះពាល់ ដល់ ទារក ។
៨ ប៉ុន្តែ បើយើងមានអាហារ និងសម្លៀក បំពាក់ នោះយើងនឹងស្កប់ ចិត្ត ។
ដូច្នេះ ថា ការចាកចេញ នៃ ការមកដល់ របស់ ពួកគេ ។
ដូច្នេះ ស្ងប់ស្ងាត់ សម្រាក និង ការដឹកជញ្ជូន ដោយ រលូន ។
“ មិត្ត ម្នាក់ បាន ប្រាប់ ខ្ញុំ ដែល គាត់ បាន ឮ ថា ម៉ូនីកា ពិតជា បុរស ផ្លាស់ប្តូរ ភេទ ។
ហើយជាការ ពិត ពួកគេមានការ ភ្ញាក់ផ្អើល ។
ខ្សែប្រយុទ្ធកំពុង តែលេងក្នុងលក្ខខ័ណ្ឌ ខ្ចីជើងឲ្យ Flamengo FC ដែលស៊ុតបាន ៣៤ គ្រាប់ក្នុងការ បង្ហាញខ្លួន ៤០ លើក !
ភ្នំពេញ ប៉ុស្តិ៍ - តើនរណាជាវិចិត្រករ ?
គ្រួសារ បង ស្រី ខ្ញុំ កំពុង ផ្លាស់ ទីលំនៅ ប៉ុន្តែ គ្មាន បន្ទប់ ទេ - ប្លុក
ពីវា អ្នកត្រូវប្រគល់វិភាគទានរបស់ព្រះអម្ចាស់ដល់បូជាចារ្យ អើរ៉ុន ។
ការស្តីបន្ទោស ត្រូវបាន ដាក់ លើ អ្នក ដែល មិន នាំ អ្នក ឬ ចៅហ្វាយ របស់ អ្នក ទៅក្នុង គណនី ។
« ហើយទ្រង់យកនំបុ័ងអរព្រះគុណ ហើយកាច់ប្រទានដល់គេ ដោយមាន បន្ទូលថា
« ហើយគាត់យកនំបុ័ងអរព្រះគុណហើយកាច់វាហើយប្រទានទៅពួកគេដោយនិយាយថា
ប៉ុន្តែ អ្នក អាច ធ្វើ កិច្ចការ ជាច្រើន ដើម្បី ជួយ កូន របស់ អ្នក ។
ហ្គាសៀស ។ ចូលចិត្ត ។
ដោយ ពន្លឺ នៃ ដើមឈើ
15 ប៉ុន្តែឃើញបុរសក្រីក្រម្នាក់មានប្រាជ្ញានៅ ទីនោះ ហើយគាត់បានរំដោះទីក្រុងដោយប្រាជ្ញា ប៉ុន្តែគ្មានអ្នក ណានឹកឃើញបុរសក្រីក្រនោះឡើយ ។
ជាថ្មី ម្តង ទៀត ម្តាយ ដែល មាន ពរ ជ័យ ការពារ ខ្ញុំ ។
ពេលនោះខ្ញុំនឹងដឹងថា អ្នកមិនមែនជាអ្នកស៊ើបការណ៍ទេ ប៉ុន្តែអ្នក ជាមនុស្ស ស្មោះត្រង់ ។
« យើងចង់មានតម្លាភាព យើងចង់មានការ បើកចំហ ហើយខ្ញុំទន្ទឹងរង់ចាំជួបជាមួយ Rod នៅពេលនោះ » ។
ម្នាក់ ទៀត ស្ថិត ក្នុង ស្ថានភាព ធ្ងន់ធ្ងរ ។
ផលិតផល ទាំងអស់ របស់ ពួកគេ បាន ធ្វើឱ្យ ខ្ញុំ ចាប់អារម្មណ៍ ។
ថត ប្រសិនបើ មាន វិធី ផ្សេង ទៀត ។
ប៉ុន្តែវា ជាហ្គេម សប្បាយមួយយ៉ាង ណាក៏ដោយ ជាពិសេសជាមួយមិត្តភ័ក្ដិ ។
គាត់ផ្អៀងទៅនឹងដើមឈើ ហើយច្រកចូលសម្ងាត់ត្រូវបានបើកបង្ហាញ ។ ]
សហ អ្នកនិព ន្ធ៖ ប្រសិនបើ អ្នក ត្រូវការហ្គេម បន្ថែម ?
ពួកគេ បាន នៅ ជាមួយ ព្រះ។
ម្លប់ ត្រូវបាន ផ្តល់ ដោយ ដើមឈើ ដែល ព័ទ្ធ ជុំវិញ ស្មៅ និង ដោយ ឆ័ត្រ ជាច្រើន ។
ដុត ពួកវា ពួក វា ជា មេធ្មប់ គឺជា រឿង ធម្មតា បំផុត ។
ព្រះបាន បង្កើត គ្រួសារ មួយ ។
គាត់ត្រូវបានគេផ្ទេរទៅ Real Madrid ក្នុងតម្លៃមិនបញ្ចេញឈ្មោះក្នុងឆ្នាំ ២០១៤ ។
ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលអំពីមនុស្សទុច្ចរិតថា គ្មានសន្តិភាពទេ ។
នេះ ជា ការចិញ្ចឹម ជីវិត របស់ យើង ហើយ យើង នឹង តស៊ូ រហូតដល់ ទី បញ្ចប់ ។
ប៉ុន្តែ វា យឺត ពេល ទៅ ហើយ សម្រាប់ មនុស្ស មួយចំនួន ជាពិសេស ស្ត្រី ។
ខ្ញុំស្មានថានាងបានស្លាប់យូរមកហើយ។
ហេតុ អ្វី បានជា អ្នកសម នឹង ត្រូវបាន ភ្ជាប់ ទៅ ?
«បង្រៀនទាសករឲ្យចុះ ចូលនឹងចៅហ្វាយ នាយក្នុងគ្រប់កិច្ចការទាំងអស់ ព្យាយាមផ្គាប់ ចិត្តពួកគេ មិនត្រូវនិយាយឡើយ
សមាជិកគ្រួសារខ្ញុំជាច្រើននាក់ត្រូវបានគេសម្លាប់ !» ។
ព្រះបាទសូល តបទៅដាវីឌ ថា៖ « អ្នកមិនអាច ត ទល់នឹងជនភីលី ស្ទីននេះទេ ។
នៅក្នុង សន្និសីទ នោះ យើង នឹង ធ្វើការ ជាមួយ អ្នកដទៃ
ប៉ុន្តែ គាត់មិនបានចូលទៅក្នុងព្រះវិហារនៃព្រះ យេហូវ៉ាទេ ។
ប្តី ខ្ញុំ ឈឺ ។
ទទួលបាន ច្បាប់ ចម្លង នៃ ការបង្ហាញ របស់ អ្នក ( ភស្តុតាង ) ដូច្នេះ អ្នក អាច យល់ ពី ការចោទប្រកាន់ ប្រឆាំង នឹង អ្នក ។
សម្រាប់ អ្នក ដែល មាន ការប្តេជ្ញាចិត្ត
ជឿជាក់លើសុបិនរបស់អ្នក ត្រូវមានជំនឿ ហើយបន្ត តស៊ូ » ។
ការ លាង ដៃ៖ នេះគឺជាការ ធំ ។
យើងប្រាប់ថា បើសង្គម ជារបស់អ្នក រដ្ឋាភិបាល ជារបស់យើង តើអ្នកនឹង រត់ទៅណា ?
សមាសភាព នៅ អូក្លាហូម៉ា ។
ផ្លែ ឈើ ដូច្នេះ ខ្ញុំ សប្បាយ ចិត្ត ។
តែភ្លើងជិតដល់ហើយ ...
ភាពយន្ត ដែល ផលិត ឡើង សម្រាប់ កុមារ គឺជា រឿង ផ្ទាល់ខ្លួន របស់ ពួកគេ ។
ហើយរាប់ចំនួនអ្នកស្លាប់ និងអ្នកជាប់ឃុំឃាំង ។
ដូច្នេះគាត់នឹងទៅប្រាប់មនុស្សដែលគាត់បានដេកជាមួយអ្នក » ។
ប៉ុន្តែ កុំ បញ្ចប់ វា វា នឹង បង្ហាញ នៅលើ ចង្កេះ របស់ អ្នក ។
បានបើកដំណើរការ ប៉ុន្តែត្រូវបានគេកម្ទេចចោលក្នុងមួយរយៈពេល » ។
ម្យ៉ាងទៀត ច្បាប់មិនទទួលស្គាល់យើងទេ ។
ចន បាន និយាយ ទាំងអស់ ។
វា ជា អាកាសធាតុ ក្តៅ ក្នុង រដូវកាល នេះ ។
ប៉ុន្តែការចារឹកយ៉ាងជ្រៅនៅក្នុងពួកគេនីមួយ ៗគឺជាកំហុសដែលប្រើ ប្រាស់ទាំងអស់ ។
ខុសគ្នា ពី ពួកគេ ; មាន ពួក ប្រូតេស្តង់ ដ៏ ថ្លៃថ្នូ ហើយ នៅ តាម ទីក្រុង នានា
លោក បាន មានប្រសាសន៍ ថា “ ប្រសិនបើ លោកស្រី មិន អនុវត្ត តាម នេះ ទេ ខ្ញុំ នឹង កោះ ប្រជុំ គណៈកម្មាធិការ មួយ ទៀត ដើម្បី ចាត់ វិធានការ ទៅ តាម អ្វី ដែល លោកស្រី បាន ធ្វើ និង ដើម្បី ការពារ ភាព ជឿជាក់ របស់ ថ្នាក់ដឹកនាំ គណបក្ស ” ។
ប៉ុន្តែព្រះ អាចយកវាចុះ ។
ខ្ទើយញាក់សាច់ពូ របស់មិត្តសម្លាញ់គេ ។
ដើម្បីឲ្យអ្នក ណាដែលជឿលើខ្ញុំ មិនត្រូវនៅក្នុងសេចក្ដីងងឹតឡើយ » ។
( រួមទាំងអ្នកដែលមិនទាន់ជឿ ប៉ុន្តែ ជាអ្នកដែលព្រះវរ បិតាកំពុងទាញ មក រកទ្រង់ផ្ទាល់ !)
13 កុំហាមឃាត់ការប្រៀន ប្រដៅពីកុមារ ។ ទោះបីអ្នកវាយគាត់ដោយដំបងក៏គាត់មិនស្លាប់ដែរ ។
ដោយ ផ្ទាល់ ទៅកាត មេម៉ូរី ។
នាងឆ្លើយ តបវិញថា៖ « តើអ្នកជា សាសន៍យូដាសុំភេសជ្ជៈពីខ្ញុំដោយរបៀប ណាជាស្ត្រី សាសន៍សាម៉ារី ?
អារម្មណ៍ និងការ ភ័យខ្លាចបំផុតរបស់ពួកគេនឹងមិនត្រូវបានគេនិយាយឮ ៗឡើយ ។
