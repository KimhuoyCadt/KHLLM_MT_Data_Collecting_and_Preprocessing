ប៉ុន្តែ សាខា ក្រុម អាល់កៃដា ដែល មាន មូលដ្ឋាន នៅ យែម៉ែន បាន ទះដៃ សាទ រ ការ សម្លាប់ ក្រុម អ្នកការទូត អាមេរិក នៅ លីប៊ី និង បាន ជំរុញ ឱ្យ ក្រុម មូស្លីម ធ្វើ ការសម្លាប់ ថែម ទៀត ដោយ ហៅ វីដេអូ ដែល គេ បាន បង្ហោះ តាម អ៊ីនធឺណិត ថា ជា សករាជ មួយ ទៀត ក្នុង សង្គ្រាម សាសនា ប្រឆាំង នឹង អ៊ិស្លាម ។
លោក អគ្គ លេខាធិការ អូឡាំពិក ក៏ បាន ព្រមាន ដែរ ថា សិក្ខាកាម ទាំងអស់ ត្រូវ គោរព ពេលវេលា សិក្សា ឱ្យ បាន ទៀងទាត់ ដាច់ខាត ។
សំរាប់ ខ្ញុំ ពេល បាន ឃើញ រូបភាព ទាំងអស់ នេះ ឡើងវិញ ខ្ញុំ ទៅជា មានអារម្មណ៍ រសាយ ពី ការឈឺចាប់ ទៅ វិញ ។
រហូតមកដល់ ពេលនេះ លោក បាន ដាំ ដំឡូង ខ្នុរ ស្វាយ និង ទៀប នៅលើ ដី នោះ ។
ការច្នៃប្រឌិត រូបភាព នៅក្នុង កម្មវិធី នេះ គឺ មាន ល្បឿន លឿន និង មិន ធ្វើឱ្យ រូបភាព ខូច ទ្រង់ទ្រាយ ដើម ។
ចំនួន ជាតិ កាហ្វេអ៊ីន ដែល ផលិតផល មួយ ផ្ទុក វា នោះ មិន ត្រូវបាន ដាក់ បង្ហាញ នៅក្នុង ធាតុ ផ្សំ របស់ ផលិតផល នោះ ឡើយ ។
គេ យក ទាំងអស់ តាម រាជ ពង្សាវតា ព្រះពុទ្ធ រាជ ពង្សាវតា អក្សរ ជា ភាសា ខ្មរ យែើង ហ្នឹង ។
រហូតមកដល់ ពេលនេះ វិទ្យាស្ថាន ជាតិ ប្រជាធិបតេយ្យ NDI នៅ មិន ទាន់ ឆ្លើយតប ចំពោះ ចំណាត់ការ របស់ រដ្ឋាភិបាល នេះ នៅឡើយ ទេ ។
នៅ ថ្ងៃ បុណ្យ ប្រពៃណី ផ្សេង ៗ
មិន ដឹង គ្នា វេទនា ប៉ុណ្ណា ទេ ល្មម ស្លាប់ នោះ កើតឡើង នៅ ប្រទេស ថៃ ។
ប្រសិនបើ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ជួយ ដាក់ អំពូលភ្លើង នៅពេល រាត្រី ទៀត កាន់តែ ប្រសើរ ។
គួរ រំលឹក ថា ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ គេ សង្កេតឃើញ ថា រដ្ឋ តិចសាស់ បាន ជួបប្រទះ គ្រោះមហន្តរាយ ធម្មជាតិ ជារឿយ ៗ
ជា ក្តីស្រឡាញ់ ដែល មិន អាច រំលាយ បាន មិន ទ្រាំទ្រ នឹង ការទាស់ ប្រឆាំង ហើយក៏ ផ្តល់ ជីវិត និង អំណរ ដ៏ ឥត ឈប់ឈរ ដែល នៅ យ៉ាង អស់ កល្ប ជានិច្ច ។
ហើរ ឆាប មក ជិត នាង ពេក យុវតីតក់ស្លុត គេច រក ជម្រក ពួន ភ័យ នា ដើមទ្រូង នាយក ម្លោះ ។
តែ យើង មិន បោះបង់ ចោល ទណ្ឌកម្ម ជា ថ្នូរ ឡើយ ។
ហេរី ផោតធ័រ គឺជា រឿង មួយ ដែល ទទួលបាន ការគាំទ្រ យ៉ាង ខ្លាំង នៅ ជុំវិញ ពិភពលោក ។
វា អាស្រ័យ ទៅ លើ រចនាសម្ព័ន្ធ រដ្ឋាភិបាល និង រចនាសម្ព័ន្ធ សេដ្ឋកិច្ច ។
