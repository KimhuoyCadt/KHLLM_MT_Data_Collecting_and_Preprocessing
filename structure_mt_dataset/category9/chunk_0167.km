ដែល ខ្ញុំ ក្រើន រំលឹក ព្រោះ ខ្ញុំ នឹក ជាតិ ខេមរា
ចំណែក សមត្ថកិច្ច ចាត់ វិធានការ ផ្លូវ ច្បាប់ កម្រិត ស្រាល ទាក់ទិន អំពើ ល្មើស ច្បាប់ របស់ ពលរដ្ឋ វៀតណាម ទាំងនោះ ។
លើស ពី នេះ ក៏ ត្រូវ មាន ការពិនិត្យ តាមដាន ឱ្យ បាន ល្អិតល្អន់ លើ ផល ប៉ះពាល់ ជា អវិជ្ជមាន ដែល អាច កើត មាន ឡើង ដោយសារ ការធ្លាក់ចុះ វិស័យ វាយន ភណ្ឌ និង សំណង់ ។
ដូច ចិត្ត អ្នកភូមិ ចង់បាន នោះ ទេ ។
បរិមាណ វីតាមីន ដែល អ្នក ត្រូវការវា អាស្រ័យ ទៅ លើ អាយុ និង ភេទ របស់ អ្នក ។
វិធី បង្រៀន កូន ១០យ៉ាង ដែល ធ្វើឱ្យ ជនជាតិ ជ្វីស ឆ្លាត ជាង គេ លើ ពិភពលោក !
កំលោះ ក្រមុំ នៅ ថ្ងៃ នេះ វិញ ឃើញ ថា មាន បញ្ហា ប្រទាំង ប្រទើស ច្រើន តែ ភាពផ្អែមល្ហែម ក៏ កើតមាន ច្រើន ដែរ ៕
មាន អ្នកប្រើប្រាស់ មួយចំនួន បាន ប្រើប្រាស់ ដើម្បី បង្អាក់ ដំណើរការផ្សព្វផ្សាយ ដៃគូ ប្រកួតប្រជែង ។
ក្រុម មន្ត្រី ដដែល បាន បន្ត ថា ពួកគាត់ ចាំ មើល របៀប ដឹកនាំ ឯកឧត្តម ឃួង ស្រេង អភិបាល នៃ គណអភិបាល រាជធានី ភ្នំពេញ ទើបតែ ឡើង កាន់ តំណែង ថ្មី ៗ
ព្រះអង្គ ទម្លាក់ ស្តេច នានា ពី រាជ បល្ល័ង្ក
ប្រាសាទ ទាំង ពីរ ប្រភេទ ខាងលើ នេះ សុទ្ធតែ ជា ទេវល័យ ឬ លំនៅ ស្ថាន របស់ ព្រះអាទិទេព នៃ លទ្ធិ ព្រហ្មញ្ញ សាសនា ។
អាធាង ត្នោត និយាយ ថា ប្តី គេ មាន បទពិសោធ ន៏ កាមសាស្ត្រ ច្រើន ជាង កំឡោះ !
កន្លង់ គម្រក់ ញក់ ញី បុប្ផា ។
ទាំង នេះ នឹង ដើរ ទៅ មុខ នោះ វា នឹង ទាមទារ ឱ្យ មាន ក្រុម វិនិយោគ ថ្មី ទាំងស្រុង លេចឡើង នៅក្នុង ទីផ្សារ ។
ចង ឬ ស្រាយ ស្រេច លើ សម្តេច តេជោ សែន រឿង បាតុកម្ម ប្រឆាំង នឹង ឯកឧត្តម កឹម សុខា
យ៉ាងណា ក៏ដោយ ការតវ៉ា ទាមទារ របស់ ក្រុម បណ្តាញ ព្រះសង្ឃ ឯករាជ្យ មិន បាន សម្រេច នោះ ទេ ។
អ្វី ដែល គណបក្ស សង្គ្រោះ ជាតិ គ្មាន និង អន់ !
នៅក្នុង ឱកាស នោះ ដែរ សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ ថា អ្នកសារព័ត៌មាន ទាំងអស់ ត្រូវ ចូលរួម ផ្សព្វផ្សាយ ពី អំពើ អសកម្ម នានា ក្នុង សង្គម និង អំពើពុករលួយ ផ្សេង ៗ
ធ្វើការ តាម អារម្មណ៍ ផ្ទាល់ខ្លួន ។
លោក ដូណាល់ ត្រាំ ប្រកាស ពី ការសម្រេចចិត្ត របស់ លោក ក្នុង ថ្ងៃអង្គារ ទី ៨ឧសភា
បញ្ចស តំសា៥ ភាគរយ
ទោះជា យ៉ាងណា លោក មិន ទាន់ អាច បញ្ជាក់ ពី មូលហេតុ នៃ អគ្គិភ័យ នេះ បាន ទេ ។
មិន មាន វិធីសាស្ត្រ បំបាត់ ភាពធុញទ្រាន់ ណា លឿន ជាង ការគេច ទៅ វិស្សមកាល នោះ ទេ ។
ដំណើរការ ប្រជាធិបតេយ្យ មិន អាច ត្រូវបាន អនុញ្ញាតឱ្យ បង្វែរ តាមរយៈ ការតវ៉ា ខុស ច្បាប់ ទេ ។
ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ដ៏ រន្ធត់ នេះ បាន កើតឡើង …
ច្បាប់ នេះ ក៏ មិន មាន ការ ការពារ តាម ច្បាប់ ចំពោះ ករណី រំលោភ សេពសន្ថវៈ ក្នុង ចំណោម ប្តី ប្រពន្ធ ស្រប ច្បាប់ ដែរ ។
ចំណែកឯ ទឹកឃ្មុំ វិញ នឹង ផ្តល់ ជាតិ សំណើម ហើយក៏ ជួយ ផ្តល់ ភាពភ្លឺ ចែងចាំង ដល់ ស្បែក របស់ អ្នក ផងដែរ ។
៣១ ពួក កូន បាន ឆ្លើយ វិញ ថា យើងខ្ញុំ ជា មនុស្ស ទៀង ត្រង់ យើងខ្ញុំ មិន មែន ជា អ្នក ស៊ើបការណ៍ ទេ ។
នេះ ជា សណ្ឋាគារ ដ៏ ប្រណីត ដែល កីឡាករ រូប នេះ បាន ស្នាក់ នៅក្នុង កំឡុង ពេល ឃុំ ខ្លួន
យើង រួមគ្នា ធ្វើ ការងារ នៅ ទូទាំង សាកលលោក ដើម្បី ជួយ សិស្ស និស្សិត ឱ្យ សម្រេចបាន នូវ ភាពជោគជ័យ របស់ ពួក ៕
ប្អូន ថ្លៃ បាន ទូរស័ព្ទ ទៅ សួរ អ្នក ត្រូវ ចាប់ បញ្ជូន ទៅ វៀតណាម វិញ ។
ជីវិត របស់ ពលករ ចំណាកស្រុក ទៅ ធ្វើការ នៅឯ ប្រទេស គេ មិន មែន ជា រឿង លេងសើច នោះ ទេ ។
ទៀត ដែល យើង អាច និយាយប្រាប់ ដល់ កូនសិស្ស តាម សាលា ពេល ខ្ញុំ ត្រឡប់ ទៅវិញ ។
តាមពិត ទៅ កីឡាករ ថៃ ខាងលើ ធ្លាប់ បរាជ័យ ដោយ ពិន្ទុ ក្រោម ថ្វី ដៃ របស់ ពេជ្រ សីហា ម្តង ហើយ ។
អស់ រយៈពេល ជិត មួយ ឆ្នាំ ហើយ ដែល ពលរដ្ឋ ទន្ទឹងរង់ចាំ ប្រើ ប្រព័ន្ធ លូមេ ថ្មី តាម ផ្លូវ ជាតិ លេខ ៤នោះ ។
គាត់ បាន ប្រាប់ ពួក អ្នកគាំទ្រ ថា គាត់ នឹង ជិះ យន្តហោះ របស់ ក្រុមហ៊ុន អាកាសចរណ៍ ដទៃ ជំនួស វិញ ហើយ នឹង រក្សា ការសន្យា លក់ វា ចោល គឺ តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី ចូលកាន់ តំណែង ។
លោក បញ្ជាក់ ថា ភាពកំសាក និង ភាពទន់ជ្រាយ មិន អាច មាន ឡើយ ។
លោក ក្លាយទៅជា អ្នក បំភ្លឺ ព្រះសហគមន៍ នៅ ទ្វីប អាហ្វ្រិក ។
លោក ស្នងការបាន និយាយ ថា លោក ស្គាល់ ឈ្មោះ ជនសង្ស័យ ប៉ុន្តែ មិន ទាន់ និយាយ បាន ទេ ។
សារធាតុ ទាំង ពីរ នេះ មាន អត្ថប្រយោជន៍ ច្រើន ប្រសិនបើ លោកអ្នក ផឹក វា បន្តិចបន្តួច ។
បទពិសោធន៍ ១៩ ឆ្នាំ
ញចិត្ត និង ផូស អត្ថបទ
គឺ បណ្តាល មកពី ធ្វើ ការងារ ច្រើន ក្នុង ពេលវេលា កំណត់ មួយ ដ៏ ខ្លី ។
មាន អារម្មណ៍ ថា អស់ កម្លាំង ពី ខ្លួន បន្ទាប់ពី ចូលរួម កម្មវិធី ទាំងអស់ នោះ មែន ទេ ?
នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ថាមពល ដ៏ ធំ ត្រូវបាន ចាប …
បើ តាម មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ បាន ឱ្យដឹង ថា ការសាងសង់ ស្ពាន នេះ ត្រូវបាន បែងចែក ជា៣ ផ្នែក គឺ ៖
ដោយឡែក មាន គេហទំព័រ មួយ ថ្មី ដែល អាច ជួយ ដោះស្រាយ បញ្ហា លោក អ្នក បាន …
៣ចំណុច នៃ ភីហ្សា ដែល ស្ត្រី មាន ផ្ទៃពោះ គួរ ចៀសវាង
ទាំងអត្ថន័យ ទាំង បទភ្លេង ខ្ញុំ ពេញចិត្ត ទាំងអស់ !
ទោះជា យ៉ាងណា ក៏ដោយ នៅ មាន បញ្ហា មួយចំនួន ទៀត ដូចជា មូលធន ភាគ ច្រើន ស្ថិត ក្នុង កណ្តាប់ដៃ ជន បរទេស ។
នៅក្នុង សរសៃ ឈាម បាន ចាប់ផ្តើម មាន សុខភាព ប្រសើរឡើង ។
ខ្ញុំ ខ្លាច ចង់ ងាប់ ហើយ តែ មិន ហ៊ាន ស្រែក ម៉ាម៉ាត់ ផង ។
ការកាត់ទោស លោក សម រង្ស៊ី ជា ការកាត់ទោស មាន លក្ខណៈ នយោបាយ មិន មែន ជា ការកាត់ទោស មាន លក្ខណៈ បទ ព្រហ្មទណ្ឌ ទេ ។
តែងតែ ប្រើ គ្រប់ ឧបាយកល់ ដើម្បី លួងលោម ឬ ទិញ ទឹកចិត្ត ព្រះសង្ឃ ក៏ ដូចជា ពលរដ្ឋ ខ្មែរ ក្រោម ឱ្យ ចូលរួម បម្រើ ការ នយោបាយ ជាមួយ ពួកគេ ។
ឃាត់ខ្លួន ស្ត្រី ម្នាក់ ពាក់ព័ន្ធ ករណី ជួញដូរ មនុស្ស គឺ នាំ ក្មេងស្រី ឱ្យ តា ៗ
