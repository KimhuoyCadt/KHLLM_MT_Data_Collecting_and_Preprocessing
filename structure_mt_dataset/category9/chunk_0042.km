៣៤ ក្រោយពីអភិបាលបានអានសំបុត្រហើយ គាត់សួរថាគាត់ មកពីខេត្តណា ។
ប៉ុន្តែពេត្រុសនិងសាវ័ក ឯទៀតបានឆ្លើយ ថា៖ « យើងគួរតែស្តាប់បង្គាប់ព្រះជាជាងមនុស្ស » ។
ដ្បិតមនុស្សទាំងអស់បានប្រព្រឹត្តអំពើ បាប ហើយខ្វះសិរីរុងរឿងរបស់ព្រះ។
យោង តាម Bai មិត្តភក្តិ ជាច្រើន បាន សម្រេចចិត្ត ចាកចេញ ពី ទីក្រុង ដើម្បី ស្វែងរក ឱកាស នៅ កន្លែង ផ្សេង ។
ប្រទេស ស្វីស គឺជា ប្រទេស ដែល អ្នក កំពុង គិត ។
វានឹងមានអ្នកគ្រប់គ្រង តែមួយលើពួកគេ ហើយពួកគេនឹងលែងមាន ជាតិពីរ ឬត្រូវបានបែងចែកជាពីរនគរទៀតហើយ …» ។
ខ្ញុំចង់លោតបែបនេះ » ។
ហើយបានដើរជាជ័យជំនះជាមួយនឹងម្ចាស់របស់ព្រះ។
អ្នកមិនបានឃើញនាងទេ មាន តែខ្ញុំបានឃើញនាង ។
ពួកគេមិនស្មើគ្នា ឬមិនត្រូវកំណត់អត្តសញ្ញាណគ្នាទៅវិញទៅមក ។
បន្ទាប់មក គាត់នឹងត្រូវអ្នក កាន់ទុក្ខផ្សេងទៀតដេញចេញ ។
បន្ទាប់ពី សិក្សា និង ធ្វើ សមាធិ អស់ រយៈពេល ប្រាំមួយ ឆ្នាំ ទីបំផុត ព្រះអង្គ បាន រកឃើញ ផ្លូវ កណ្តាល ហើយ បាន ត្រាស់ដឹង ។
ពួកគេទាំងអស់គ្នាទទួលបានឋានៈដែលខ្លួន សមនឹងទទួលស្របតាមស្នាដៃរបស់ខ្លួន ។
ក្នុង អំឡុង ពេល ថ្ងៃ អ្នក នឹង ផលិត ភេសជ្ជៈ ជាច្រើន ប្រភេទ រួម មាន :
ដំបូង អ្នក ត្រូវ បញ្ចូល បទភ្លេង ។
មាន តែមិត្តភ័ក្ដិល្អបំផុតដែលដឹងរឿងបែបនោះអំពី គ្នាទៅវិញទៅមក ។
បំពេញ តាម តម្រូវការ នៃ កម្មវិធី ថាមពល ទាប និង មធ្យម ។
ខ្ញុំនឹងអង្វរអ្នក ហើយខ្ញុំនឹងចេញមកឲ្យ ពរអ្នក » ។
ទាហាន អាច សង្ស័យ អ្វី ដែល អ្នក និយាយ ប៉ុន្តែ ពួកគេ នឹង ជឿ អ្វី ដែល អ្នក ធ្វើ ។
ពេត្រុសចាត់គេទាំងអស់ចេញពីបន្ទប់ ហើយលុតជង្គង់អធិស្ឋាន ។
នេះ ពន្យល់ ពី មូលហេតុ ដែល មនុស្ស ជាច្រើន មិន មាន ជំនឿ
១៧ ព្រោះថ្ងៃដ៏ធំនៃសេចក្ដី ក្រោធរបស់ទ្រង់បានមកដល់ ។ ហើយ អ្នកណា អាច ឈរ បាន ?
អ្នក ណាដែលសំខាន់សម្រាប់ខ្ញុំនឹង យល់ » ។
គាត់ នៅតែ មិន ក្លាយជា មនុស្ស ប្រភេទ ដែល ខ្ញុំ ត្រូវការ ។
អ្នក បំរើ របស់ ទ្រង់ ទាំងអស់ ។
28 ខ្ញុំចង់ដឹងថាហេតុអ្វីបានជាគេចោទប្រកាន់គាត់ ដូច្នេះខ្ញុំក៏នាំគាត់ទៅក្រុម ប្រឹក្សារបស់គេ ។
ពួកគេ សមនឹងទទួលបានការ ជេរប្រមាថពី សំណាក់អ្នកគាំទ្ររបស់ពួកគេ ហើយពួកគេគឺជា ។
ពេលទៅដល់ពួកគេបានអធិស្ឋានឲ្យពួកគេ ដើម្បីឲ្យពួកគេបានទទួលព្រះវិញ្ញាណបរិសុទ្ធ ។
ខ្ញុំឈ្នះ ជាលើកទីពីរ » ។
១២ ដូច្នេះ បងប្អូនអើយ យើងមានកាតព្វកិច្ចមួយ ប៉ុន្តែ វាមិនមែនសម្រាប់ធម្មជាតិដែលមាន បាបនោះទេ គឺត្រូវរស់ នៅតាមវា ។
ហើយ ការផ្គត់ផ្គង់ ថាមពល របស់ អ្នក កំពុង ធ្លាក់ចុះ ។
ប្រសិនបើ មាន ការសង្ស័យ ជាប់ នឹង ជ្រលង ភ្នំ និង ផ្លូវ ថ្មើរជើង ដែល មាន ស្លាកសញ្ញា ជាច្រើន ។
រឿងដែលខ្ញុំខ្លាចបានកើតឡើង ។
អ្នក ណាបំបែកត្រូវទទួល ទោស ។
អ្នក ប្រាកដជា នឹង ជា មនុស្ស ម្នាក់ ដែល រស់ នៅ ប្រកបដោយ ភាព សម្បូរសប្បាយ ។
ផ្ទុយទៅវិញ គាត់បាននិយាយថា « ហើយពេលខ្ញុំឈឺ គាត់បានប្រោសខ្ញុំឲ្យជា » ។
៩ ខ្ញុំដឹងអំពីទុក្ខលំបាករបស់អ្នក និង ភាព ក្រីក្ររបស់អ្នក ( ប៉ុន្តែអ្នក ជាអ្នកមាន ) ហើយការ បង្កាច់បង្ខូចពួកអ្នកដែលថាពួកគេជា សាសន៍យូដា ទោះបីជាពួកគេមិនមែនជាសាលា ប្រជុំរបស់សាតាំង បាន អះអាង ថា ជា ក្រុម ជំនុំ នៃ រាស្ដ្រ របស់ ព្រះ ប៉ុន្តែ តាមពិត កំពុង បម្រើ សាតាំង ] ។
អ្នក ណាដែលជឿលើខ្ញុំនឹងមានជីវិត ទោះបីគាត់ស្លាប់ក៏ដោយ ។ ហើយអ្នក ណាដែលមានជីវិត ហើយជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ » ។
អង្គុយ ជាមួយ អ្នក ដែល ឈឺ ។
កុំ ភ្លេច ផ្គត់ផ្គង់ ទឹក សម្រាប់
វាជាពេលវេលាដ៏លំបាកសម្រាប់ពួកគេនៅពេលនេះ ។
នៅទី ណាដែលអ្នក ចាំឈ្មោះខ្ញុំ ខ្ញុំនឹងជូន ពរអ្នក » ។
នេះ ជាទី បន្ទាល់ចំពោះ ភាព ស្មោះត្រង់នៃ ការ គាំទ្ររបស់ព្រះ
ដែល បង្ហាញ ពី ការសន្យា ដ៏ អស្ចារ្យ លើកលែងតែ វា នៅតែ បន្ត គាំង ។
ដូច្នេះ យើងនឹងមិនធ្វើវាឡើងវិញទេ ។
* វគ្គ សិក្សា នេះ នឹង ធ្វើឡើង ទាំងស្រុង ជា ភាសា ព័រទុយហ្គាល់ ។
យើង បាន ឃើញ សិរី រុងរឿង របស់ ព្រះអង្គ ជា សិរី រុងរឿង របស់ ព្រះអង្គ តែ មួយ ដែល បាន មកពី ព្រះបិតា ពោរពេញ ដោយ ព្រះគុណ និង សេចក្តីពិត ។
« ពួកគេនិយាយថាវាត្រឹមត្រូវហើយមិនសំខាន់ថាពួកគេធ្វើ អ្វីជាមួយវាទេ » ។
គាត់ បាន រមៀល វា ឆ្ពោះទៅ ដី ព្រះអាទិត្យ ហើយ វា មិន ត្រឡប់ មកវិញ ទេ ។
ប្រសិនបើ អ្នក ចង់ បង់លុយ ត្រូវ បង់ ជា សាច់ប្រាក់ ។
ជា ការពិត ណាស់ នេះ គ្រាន់តែ ជា ពេល ដែល គាត់ ត្រូវការ គ្រួសារ ដើម្បី មើល ថែ គាត់ ប៉ុណ្ណោះ ។
ហេហេហេហេ សម្រាក
នេះជាពេលវេលាដែល ភាពងងឹតនឹងគ្រប ដណ្តប់លើផែនដី » ។
នាង បាន និយាយ អំពី វា នៅក្នុង កម្មវិធី ពេលព្រឹក ។
ពេលពួកគេងើបមុខទៅរកមិនឃើញនរណាក្រៅពីព្រះយេស៊ូឡើយ ។
មិន ទាក់ទង នឹង ព្រះបន្ទូល របស់ ព្រះជាម្ចាស់ អ្វី ទាំងអស់ ។
១០ ព្រោះដេម៉ាសបានបោះបង់ខ្ញុំចោល ដោយស្រឡាញ់ពិភពលោកនេះ ហើយគាត់បានទៅក្រុងថែស្សា ឡូនីច ។
សកម្មភាព ឬ ការលុបចោល និង ការដោះ សារ ណាមួយ សម្រាប់ ពួកគេ ។
វាមានអារម្មណ៍ថាខ្ញុំមិនត្រូវបានគេបំភ្លេចចោល » ។
បែងចែក ប៉ុន្តែ ដើម្បី បង្រួបបង្រួម ពួកគេ : នៅក្នុង នោះ ពួកគេ បាន រៀបការ ។
៧ កាលគេដាក់គេនៅ កណ្ដាលគេហើយ គេសួរ ថា៖ « តើអ្នកធ្វើការ នេះដោយឫ ទ្ធានុភាពអ្វី ? » ។
“ ខ្ញុំ កំពុង ស្នើសុំ ឱ្យ ពួកគេ ធ្វើ ការស៊ើបអង្កេត ដែល ពួកគេ កំពុង ធ្វើ រួចហើយ ហើយ ថា អ្នក ផ្សេង ទៀត កំពុង ប្រាប់ ពួកគេ ឱ្យ បញ្ឈប់ ។
