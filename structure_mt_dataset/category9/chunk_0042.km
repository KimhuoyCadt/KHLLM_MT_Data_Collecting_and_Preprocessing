សួស្តី បងប្អូន ខ្លាឃ្មុំ បាន មកដល់ ហើយ ។
« ពេលមកដល់កន្លែងដែលហៅថា កាល់វ៉ារី គេឆ្កាងគាត់នៅ ទីនោះ ហើយចោរម្នាក់នៅខាងស្ដាំ និងម្នាក់ទៀតនៅខាងឆ្វេង » ។
« មើលចុះ ខ្ញុំកំពុងនាំគាត់ចេញមក ឯអ្នក ដើម្បីឲ្យអ្នក រាល់គ្នាដឹងថាខ្ញុំរកមិនឃើញ
រង់ចាំ ការមកដល់ នៃ ទុន បំរុង ។ វា ជា កាតព្វកិច្ច របស់ អ្នក ក្រោយ
ខ្ញុំ ឃើញ ទីបញ្ចប់ នៃ ពូជ មនុស្ស
ជាជាង ពិនិត្យមើល ការបង្រៀន របស់ លោក ម៉ូសេ និង ព្យាការី ។
មិន ដឹង ទេ ថា ជីវិត កូន ខ្ញុំ មាន គ្រោះថ្នាក់
43 ប្រជាជនទាំងអស់បានងឿង ឆ្ងល់ចំពោះឫ ទ្ធានុភាពដ៏ អស្ចារ្យរបស់ព្រះ។
មាន តែ ស្ត្រី មួយ ភាគ បួន ប៉ុណ្ណោះ ដែល សប្បាយ ចិត្ត នឹង ទម្ងន់ របស់ ពួកគេ ។
ព្រះជាម្ចាស់ សង្គ្រោះ ។
ព្រះអង្គមានព្រះបន្ទូលទៅគេ ថា៖ « ខ្ញុំឃើញសាតាំងធ្លាក់មកដូចផ្លេកបន្ទោរពីស្ថាន សួគ៌ ។
20 ដូច្នេះ អ្នកនឹងស្គាល់ពួកគេដោយ ផលផ្លែរបស់ពួកគេ ។
ទ្រង់ នៅតែ ជា អ្នក ដែល តម្រង់ ផ្លូវ កោង ហើយ ផ្តល់ ផ្លូវ ចេញពី ទីរហោស្ថាន ។
« ពេលឪពុកម្ដាយរបស់គាត់បានឃើញគាត់ ពួកគេមានការ ងឿង ឆ្ងល់ ។
ការ នឹកឃើញដល់មនុស្សសុចរិតជា ពរមួយ តែឈ្មោះបើមនុស្សអាក្រក់ រលួយ ។
ឯងនឹង ស៊ីផឹកនៅតុ អញក្នុងរាជាណាចក្រអញ ហើយឯងនឹងអង្គុយលើបល្ល័ង្កដប់ ពីរដែលវិនិច្ឆ័យកុលសម្ព័ន្ធអ៊ីស្រា ‌ អែល » ។
ចូរយកម៉ាកុស មកជាមួយចុះ ដ្បិតគាត់មានប្រយោជន៍ចំពោះខ្ញុំក្នុង កិច្ចបម្រើផ្សាយ ។
វាគឺជាអ្វីដែលចេញពីមាត់របស់គាត់ » ។
ចេញ ទៅ ហើយ សមាជិក ថ្មី
ដូច្នេះហើយ ពួកគេសម្រេច ចិត្តមិនជិះសត្វទោច ។
នៅពេល ពួកគេ ថ្លែង ទី បន្ទាល់ ទីតាំង លំនាំ ដើម គឺ ថា វា ជា ការពិត ។
ចូរប្រាប់រឿងមួយនៅថ្ងៃជំនុំ ជំរះចំពោះមនុស្សអាក្រក់គ្រប់រូប
« នាងជាដើមជីវិតសម្រាប់អ្នកដែល កាន់នាង ហើយអស់អ្នកដែលគាំទ្រនាងមានសុភមង្គល ។
« ខ្ញុំបានប្រាប់អ្នក រាល់គ្នានូវសេចក្ដី ទាំងនេះ ដើម្បីឲ្យអ្នកបានសេចក្ដី សុខក្នុងខ្ញុំក្នុងលោកនេះ អ្នកអាចនឹងមានបញ្ហា តែត្រូវយក ចិត្តទុកដាក់ចុះ ខ្ញុំបានឈ្នះពិភពលោកហើយ !» ។
ហើយមិនមានអ្វីដែលគេប្រាប់អ្នកបន្តទៀតឡើយ ។
១៦ ហើយខ្ញុំនឹងទូលសូមដល់ព្រះវរ បិតា ហើយទ្រង់នឹងប្រទានឲ្យអ្នក នូវទីប្រឹក្សាម្នាក់ទៀតឲ្យនៅ ជាមួយអ្នក ជារៀងរហូត ។
អ្នកមានអារម្មណ៍ថាអ្នកអាចប្រាប់មនុស្សនេះបានអ្វីក៏ដោយ ។
ខ្ញុំគិតតាមអ្វីដែលខ្ញុំយល់ គាត់ពិតជាមិននៅខាង ណាទេ ។
ចាប់តាំងពី គាត់ បាន ធ្វើ សមយុទ្ធ ដប់ បួន នៃ ថ្ងៃ របស់ គាត់ ។
ដ្បិត ក្រឹត្យ វិន័យរបស់លោកម៉ូសេ បានត្រូវប្រកាសនៅគ្រប់ក្រុង តាំងពីដើមរៀងមក ហើយត្រូវអាននៅក្នុងសាលា ប្រជុំនៅរៀងរាល់ថ្ងៃ ស ប្ប័ទ » ។
៣៧ ព្រោះថា៖ « នៅពេលបន្តិចទៀត អ្នក ណានឹង មកដល់ ហើយមិន បង្អង់យូរឡើយ » ។
ប៉ុន្តែ ពួកគេបានស្តាប់បង្គាប់យ៉ាងខ្លាំង ហើយបានបំពេញគ្រប់ការបញ្ជា ។
អ្នក ប្រហែលជាធ្លាប់បាន ឮអំពីរឿងនេះ ប៉ុន្តែវាជារឿងថ្មីសម្រាប់ខ្ញុំ ។
បាន បង្កើត បងប្អូន ស្រី នៃ សាក្រាម៉ង់ ដែល មាន ពរ ។
បេះដូង បាន បន្ត វិល ។
២៣ ពេលលោកចុះទូកហើយ ពួកសិស្សក៏ដើរតាម លោក ។
អ្នកម៉ៅការ អាច ជា មិត្ត របស់ អ្នក ឬ អ្នក ដែល ស្គាល់ ។
" សិទ្ធិមនុស្សរបស់ប្រទេសចិនស្ថិតក្នុងរយៈពេលដ៏ល្អបំផុតមិនធ្លាប់មាន " ។
“ ខ្ញុំគិតថាវាអស្ចារ្យណាស់ដែលបានឃើញក្មេង
ដាក់ បន្លែ ក្នុង ស្រទាប់ តែ មួយ នៅលើ សន្លឹក ដុត នំ នីមួយ ៗ ។
នៅ ពេល ដែល សត្រូវ ត្រូវបាន បង្ខំ
ចូរប្រាប់អ្វី ៗទាំងអស់ដែលអ្នកកំពុងឃើញដល់ជន ជាតិអ៊ីស្រាអែល » ។
អ្នកបង្កើតសន្តិភាពមាន ពរហើយ ដ្បិតគេនឹងត្រូវហៅថាជាកូនរបស់ព្រះ។
ប៉ុន្តែពួកគេនឹងមិនទៅឆ្ងាយទេព្រោះដូចជាករណីបុរសទាំងនោះដែរ ភាពល្ងង់ខ្លៅរបស់ពួកគេនឹងច្បាស់ចំពោះអ្នក រាល់គ្នា ។
និងការ ថ្វាយដែលមានឋានៈខ្ពង់ខ្ពស់ក្នុងការ បង្ហាញពីព្រះវិញ្ញាណបរិសុទ្ធនៃស្ថាន សួគ៌
ទាំងការងារនៃការ គោរពនិងការងារនៃសេចក្ដី មេត្តា ក រុណា។
អ្នក ភាគ ច្រើន ប្រហែលជា មាន ការគាំទ្រ ខ្លះ ។
លោកបានឆ្លងកាត់ស្រុកស៊ីរី និងក្រុង ស៊ីលីគា ដោយបញ្ជាក់អំពីក្រុមជំនុំ ។
ខ្ញុំ សង្ឃឹម ថា ថ្ងៃ នេះ គ្រប់ គ្នា ចង់ ឆ្លុះបញ្ចាំង ពី ជីវិត ដ៏ វិសេសវិសាល របស់ គាត់ និង វិធី ជាច្រើន ដែល គាត់ បាន ធ្វើឱ្យ ពិភពលោក ក្លាយជា កន្លែង ប្រសើរ ជាង មុន ។
នឹង ត្រូវបាន ជន់ លិច ដោយ ទឹក ។
ព្រះ ប្រាប់ដានី យ៉ែលអំពីអ្វីដែលនឹងកើតឡើងនៅពេលអនាគត ។
ពួកគេបាន សន្យាថានឹងនៅ តែជាអ្នក បម្រើរបស់លោក ប្រសិនបើអ្នកមិនស្តាប់បង្គាប់ ។
ខ្ញុំ នឹង នឹក អ្នក នៅក្នុង អត្ថបទចម្រៀង បេះដូង
កន្លែងដែលសិស្សភាគ ច្រើនញ៉ាំអាហារប្រចាំ ថ្ងៃ ។
នៅលើ ជញ្ជាំង ទាំង បួន ដែល ព័ទ្ធ ជុំវិញ នាង ។
កាលលោកមាន ប្រសាសន៍ដូច្នេះហើយ លោកក៏ចេញទៅរកជន ជាតិយូដាម្ដងទៀត ហើយមាន ប្រសាសន៍ទៅពួកគេ ថា៖ « ខ្ញុំ រកមិនឃើញមូលហេតុសម្រាប់ចោទប្រកាន់គាត់ទេ ។
ពេលនោះ សេចក្ដី សុខសាន្តរបស់អ្នកនឹងបានដូចជាទន្លេ ហើយសេចក្ដី សុចរិតរបស់អ្នកដូចជា រលកសមុទ្រ ។ (ESV)
11 ដូច្នេះ ខ្ញុំបានស្បថដោយកំហឹងរបស់ខ្ញុំថា ពួកគេនឹងមិនចូលទៅក្នុងកន្លែងសម្រាករបស់ខ្ញុំឡើយ ។
ព្រះអម្ចាស់បានប្រទានជ័យជំនះដល់ដាវីឌគ្រប់ទីកន្លែងដែលគាត់ទៅ ។
នៅ ពេល ដែល មនសិការ ត្រូវបាន បំពាន វា ត្រូវបាន ប្រកាស ថា មាន ទោស ។
ការចូលរួម ជាមួយ សហភាព អឺរ៉ុប ។
« យើងមិនបានចូល ជ្រៀតជ្រែកក្នុងកិច្ចការផ្ទៃក្នុងរបស់ប្រទេស ណាមួយទេ ។
ដូច្នេះ ខ្ញុំព្យាយាមអង្គុយមើលគាត់ពេញមួយយប់ ។
11 កាលគេ ឮថាទ្រង់មានព្រះ‌ជន្មរស់ ហើយបានឃើញនាង នោះគេមិនជឿឡើយ ។
18 លុះព្រឹកឡើង ពេលគាត់ត្រឡប់ទៅទីក្រុង គាត់ឃ្លាន ។
ឱ ព្រះអម្ចាស់ ជា ខែល របស់ អ័ ប្រាហាំ សូម សរសើរ តម្កើង ព្រះអង្គ ។
ពួកគេ ជា មនុស្ស ដែល សប្បាយ បំផុត នៅក្នុង ពិធី ជប់លៀង ។
ការថ្វាយបង្គំ សំណល់ របស់ វា ដែល ត្រូវ បង្កើតឡើង ។
វាជាការ ចាប់ ផ្តើ មថ្មីសម្រាប់ខ្ញុំឥឡូវនេះ » ។
រថយន្ត ដែល ភ្ជាប់ ។
ប៉ុន្តែ វាមិនមានឥទ្ធិពលលើថាតើអ្នកគួរញ៉ាំវាឬអត់ទេ ។
មិនថាពេលវេលាល្អ ឬមិនល្អនោះទេ ព្រះទ្រង់បានប្រទានឲ្យខ្ញុំ ។
នាងបាននិយាយថា៖ « យើងស្ថិតនៅកន្លែងដ៏អាក្រក់នៅ ទីនេះ។
២២ ដ្បិតកូនមនុស្សទៅតាមការ កំណត់ហើយ ប៉ុន្តែវេទនា ដល់អ្នក ណាដែលគេក្បត់ !» ។
« ខ្ញុំមិនដឹងថា ហេតុអ្វីបានជាប្ដីខ្ញុំធ្វើបែបនេះមកលើខ្ញុំ » ។
រាល់ថ្ងៃខ្ញុំខ្លាចគេទម្លាក់ចោល ។
វា អនុញ្ញាតឱ្យ អ្នកធ្វើ ការងារ របស់ អ្នក ដោយ ស្ងប់ស្ងាត់ ។
នាងមកស្រុកចិន កាលពីមួយឆ្នាំមុន ។
កាន់តែ ច្រើន ដែល អ្នក បាន ទទួល ពី ព្រះ កាតព្វកិច្ច របស់ អ្នក ចំពោះ ទ្រង់ កាន់តែ ធំ ។
ដូច្នេះ ពេលដែល អ័ ប្រាហាំក្លាយជាឪពុករបស់អ៊ីសាក គាត់បានកាត់ស្បែកគាត់ប្រាំបីថ្ងៃបន្ទាប់ពី កំណើតគាត់ ។
ទោះគាត់ជានាយករដ្ឋមន្ត្រីក៏គាត់មិនមកស្រុកយើងដែរ » ។
« តើយើងត្រូវធ្វើអ្វីដើម្បីឲ្យយើងបានធ្វើ កិច្ចការរបស់ព្រះ? » ។
គាត់បាននិយាយថា៖ « ប្រជាជនទាំងមូលមិនពេញ ចិត្ត ។
Ben និងខ្ញុំស្គាល់គ្នាតាម រយៈសហគមន៍ ជជែកពិភាក្សា ។
« យើងចង់ឲ្យក្រុមហ៊ុនទាំងនេះត្រឡប់មកវិញ ។
យ៉ាកុប ១: ២៤; ហើយបន្ទាប់ពីសម្លឹងមើលខ្លួនឯងហើយក៏ដើរចេញទៅបាត់ភ្លាមៗក៏ភ្លេចថាខ្លួនមានរូបរាងយ៉ាងណា ។
៦ លើកទឹក ចិត្តយុវជនឲ្យចេះគ្រប់គ្រងខ្លួន ឯង ។
គាត់បានគិតថានឹងបំផ្លាញទីក្រុងសូដុំ ម និងកូម៉ូរ៉ា ហើយមាន ប្រសាសន៍ ថា៖ « ខ្ញុំនឹងចុះទៅមើលថា តើការ ដែលពួកគេបានធ្វើនោះអាក្រក់ដូចការ ស្រែកដែលបានមកដល់ខ្ញុំឬអត់ » ។
នៅ ផ្ទះ ប្រសិនបើ ពួកគេ ឈឺ ។
ដូច្នេះ សាសនា ចក្រគួរ តែនិយាយថា « ត្រូវបន្ទោសយ៉ាងធ្ងន់ធ្ងរដល់អ្នកដែលមិនជឿ ឬអ្នកដែលមិនស្តាប់តាម ។
បងប្អូន របស់ ខ្ញុំ ទោះបីជា ខ្ញុំ មិន បាន ធ្វើ អ្វី ប្រឆាំង នឹង ប្រជាជន របស់ យើង ឬ ប្រឆាំង នឹង ទំនៀមទម្លាប់ របស់ បុព្វបុរស របស់ យើង ក៏ដោយ ក៏ ខ្ញុំ ត្រូវបាន គេ ចាប់ខ្លួន នៅ ក្រុង យេរូសាឡឹម ហើយ ប្រគល់ ទៅ ឱ្យ ជនជាតិ រ៉ូម ។
សេចក្តី អំណរនិងសេចក្តី រីករាយនឹង មកដល់អ្នក ហើយមនុស្សជាច្រើននឹងអរ សប្បាយនៅពេលកំណើតរបស់គាត់
បន្ទាប់មក គាត់ដាស់តឿនយើងថា៖ « ដូចជាខ្ញុំបានស្រឡាញ់អ្នក ហើយ ចូរស្រឡាញ់គ្នាទៅវិញទៅ មក » ។
« តើអ្នក រាល់គ្នាមិនដឹងថាមនុស្សទុច្ចរិតនឹងមិនទទួលរាជាណាចក្ររបស់ព្រះជា ម ត៌កឬ ?
៤៤ ដូច្នេះ លោកម៉ូសេ បានប្រកាសប្រាប់ជន ជាតិអ៊ីស្រាអែលអំពីពិធីបុណ្យរបស់ព្រះអម្ចាស់ ។
ចូរស្រឡាញ់គេឲ្យដូចខ្លួនឯង ដ្បិតឯងជាជនបរទេសនៅស្រុកអេស៊ីព្ទ ។
ហើយពេលថ្ងៃចូលទៅក្នុងពេលយប់
អាហារ និង ទឹក មាន សារៈសំខាន់ ណាស់ ។
ចិញ្ចៀន មួយ ភ្ជាប់ ទៅនឹង ចុង នៃ ការនិយាយ នីមួយ ៗ ;
ហើយ អ្វី ៗ ទាំងអស់ នឹង ត្រូវ បំផ្លាញ ។
ដូច្នេះ អ្វី ៗ ទាំងអស់ នឹង ត្រូវបាន បង្ហាញ នៅ ទីនោះ ។
សរសៃ ឈាម វ៉ែន ត្រូវបាន កើនឡើង និង លេចធ្លោ នៅ ខាងក្រោម ។
ដើរ តាម ប្រភព នៃ អំពើ អាក្រក់ ។
« កុំចាប់ខ្ញុំឡើយ ដ្បិតខ្ញុំមិនទាន់បានឡើងទៅ ឯព្រះវរ បិតាទេ ។
« ប៉ុន្តែ សូម្បីតែឥឡូវនេះ ខ្ញុំដឹងថាអ្វីដែលអ្នក សុំពីព្រះ នឹងប្រទានដល់អ្នក » ។
លោកុប្បត្តិ 24:42 ខ្ញុំបានមកដល់រដូវផ្កា រីកនៅថ្ងៃនេះ ហើយទូល ថា៖ « ប ពិត្រព្រះ‌ អម្ចាស់ ជាព្រះ របស់លោកអប្រាហាំ ជាម្ចាស់របស់ទូលបង្គំ បើឥឡូវនេះ ទ្រង់នឹងសម្រេចបាន តែផ្លូវដែលទូលបង្គំទៅ !
ដ្បិតអ្នកបានឲ្យគាត់មានអំណាចលើមនុស្សទាំង អស់ ដើម្បីឲ្យគាត់បានជីវិតអស់ កល្ប ជា និច្ចដល់អស់អ្នកដែលអ្នកបានឲ្យគាត់ ។
ប្រសិនបើ អ្នក មិន ញ៉ាំ បន្ទាប់ពី រំលាយ ទេ វា នឹង ងាយ ឆេះ បំពង់ អាហារ ។
៥ហើយគាត់មិនអាចធ្វើអព្ភូតហេតុ ណាមួយនៅ ទីនោះបានឡើយ លើកលែង តែគាត់បានដាក់ដៃលើអ្នកជំងឺពីរបីនាក់ ហើយបានប្រោសពួកគេឲ្យជា ។
តើ អ្នក នឹង រកឃើញ នៅក្នុង ភាពរញ៉េរញ៉ៃ នេះ ទេ ?
តើអ្នកមិនបានឮការ ចោទប្រកាន់ដែលបានដាក់ មកលើអ្នក?
ពួកគេ បាន ធ្វើការ ដើម្បី សេចក្តីស្រឡាញ់ របស់ អ្នកដទៃ ។
« ទ្រង់មិនមែនជាព្រះ នៃមនុស្សស្លាប់ទេ គឺជាព្រះ នៃមនុស្ស រស់ » ។
និងគួរឱ្យទុក ចិត្តជាដាច់ខាត » ។
ដើម្បី ស្តាប់ គាត់ ហើយ គាត់ ព្រងើយ កន្តើយ នឹង
ដោយសារតែ ភាព បរិសុទ្ធ ខ្ពស់ របស់ វា
ព្រះ យេស៊ូមាន បន្ទូលថា៖ « គ្មានអ្នក ណាអាចមក ឯខ្ញុំបានឡើយ លើកលែង តែព្រះវរ បិតាដែលចាត់ខ្ញុំឲ្យទាញគាត់មក » ។
14 ពីព្រោះខ្ញុំដឹងថាមិនយូរប៉ុន្មានខ្ញុំនឹងទុកវាមួយ ឡែក ដូចជាព្រះ‌ យេស៊ូគ្រិស្ដជាព្រះ‌ អម្ចាស់នៃយើងបានបញ្ជាក់ប្រាប់ខ្ញុំ ។
នៅ ទីនោះ គេអាចបញ្ជូនអ្នកទៅគុក » ។
ដែល គាត់ បាន លើកឡើង ។
ការ ឃើញពួកគេតាមផ្លូវនឹងធ្វើឱ្យអ្នកអាណិតអាសូរពួកគេ ហើយអ្នកនឹងលែងខ្លាច វត្តមានរបស់ពួកគេទៀតហើយ » ។
ធម៌របស់អ្នក ទោស
បណ្ឌិត ហ្វាន នឹង ត្រូវ បូជា ។
ហើយ អ្នក កំពុង ហៅ ខ្ញុំ ចេញ ដូចជា
ហើយ អ័ ប្រាហាំ បាន និយាយ ថា ពួកគេ មាន ការព្រមាន ជាច្រើន ពី លោក ម៉ូសេ និង ពួក ហោរា ។
នេះ ជា អ្វី ដែល អ្នក នឹង ឃើញ នៅ ខាងក្នុង
បាទ ខ្ញុំ គ្រាន់តែ ព្យាយាម ជួយ !
តើអ្នកអាចគិតអំពីពេលវេលាមួយដែលវាមាន ( ឬមិនទាន់ ) ផ្លាស់ប្តូររបៀបដែលអ្នកដោះស្រាយករណីមួយដែរឬទេ ?
១៧ ដរាបដល់ខ្ញុំបានចូលទៅក្នុងទី សក្ការៈនៃព្រះ ហើយបានដឹងថាពួកគេនឹងត្រូវ បញ្ចប់ ។
ខ្ញុំមិនបានសរសេរទៅ កាន់អ្នក នូវ បញ្ញត្តិថ្មីមួយចំនួនទេ ។ វា ជា អ្វី ដែល យើង បាន ទទួល តាំងពី ដើម ដំបូង ពី ព្រះអម្ចាស់ របស់ យើង ។
