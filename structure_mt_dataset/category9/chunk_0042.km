ការទទួលខុសត្រូវ របស់ ម្ចាស់ ថ្មី ។
៣១ ដោយនិយាយដូច្នេះ អ្នក រាល់គ្នាធ្វើជាសាក្សីទាស់នឹងខ្លួនថា អ្នក ជាកូនរបស់អ្នកដែលបានសម្លាប់ព្យាការី ។
រឿង គឺ អ្នក ស្គាល់ មិត្ត របស់ អ្នក ។
ពួកគេ មិន ត្រូវបាន អនុញ្ញាតឱ្យ សម្លាប់ ពួកគេ ទេ ប៉ុន្តែ ត្រូវ ធ្វើ ទារុណកម្ម ពួកគេ រយៈពេល ប្រាំ ខែ ។ ទុក្ខ វេទនារបស់ពួកគេប្រៀបដូចជាទារុណកម្មដែលកើតឡើងដោយ ខ្យា ដំរីពេលវាវាយមនុស្ស » ។
ប្រភព ទាំងអស់ របស់ ខ្ញុំ គឺ នៅក្នុង អ្នក ។
ខ្ញុំមិនដែលឃើញពួកគេទេតាំងពីពេលនោះ មក » ។
ខ្ញុំ ត្រូវការ ថ្មី ឬ ជួសជុល ។
ដកខ្លួនចេញពីអ្នកដែលខ្ញុំតោងជាប់ ។
