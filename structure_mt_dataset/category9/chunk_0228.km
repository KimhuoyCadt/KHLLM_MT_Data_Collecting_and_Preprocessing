( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . ឧកញ៉ា ទៀ វិចិត្រ និង លោកជំទាវ បរិច្ចាគ ថវិកា ១២.៣៤០ ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
អ្នក ឧកញ៉ា លី ហួរ និង លោកជំទាវ បរិច្ចាគ ថវិកា ១០០.០០០ ដុល្លារ ជូន រាជ រដ្ឋាភិបាល ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . អ្នក ឧកញ៉ា លី ហួរ និង លោកជំទាវ បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ១០០.០០០ ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
អ្នក ឧកញ៉ា ស៉ី គង់ ទ្រីវ និង លោកជំទាវ ឧកញ៉ា ហុង ស៊ួន បរិច្ចាគ ថវិកា ៥០០.០០០ ដុល្លារ ជូន រាជ រដ្ឋាភិបាល ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . អ្នក ឧកញ៉ា ស៉ី គង់ ទ្រីវ និង លោកជំទាវ ឧកញ៉ា ហុង ស៊ួន បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ៥០០.០០០ ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
អ្នក ឧកញ៉ា កុក អាន និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥០០.០០០ ដុល្លារ ជូន រាជ រដ្ឋាភិបាល ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . អ្នក ឧកញ៉ា កុក អាន និង លោកជំទាវ បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ២.០០០ ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
( ប៉េកាំង ) ៖ ថ្ងៃទី១ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ជា ថ្ងៃ អបអរសាទរ ខួប ទី២៥ ឆ្នាំ ដែល ហុងកុង វិលត្រឡប់ ចូល ប្រទេស ចិន វិញ និង ថ្ងៃ ធ្វើ ពិធី ចូលកាន់ មុខ តំណែង របស់ អភិបាល នៃ តំបន់ រដ្ឋបាល ពិសេស ហុងកុង អាណត្តិ ទី៦ ។
ក្នុង ពិធី លោក Xi Jinping ប្រធាន រដ្ឋ ចិន បាន បង្ហាញ ពី ការសួរសុខទុក្ខ ការជូនពរ និង ការថ្លែងអំណរគុណ លោក បាន គូសបញ្ជាក់ ថា កម្មវត្ថុ មូលដ្ឋាន នៃ « ប្រទេស មួយ ប្រព័ន្ធ គ្រប់គ្រង ពីរ » គឺ គាំពា ប្រជាធិបតេយ្យ សន្តិសុខ ផលប្រយោជន៍ អភិវឌ្ឍន៍ របស់ ជាតិ ក្រោម បរិវេណ នេះ ហុងកុង និង ម៉ាកាវ មាន សិទ្ធិ ស្វ័យភាពកម្រិត ខ្ពស់ ។ ៥ឆ្នាំ ខាងមុខ នេះ ជា អំឡុង ពេល គន្លឹះ សម្រាប់ ហុងកុង បើក អនាគត ថ្មី និង លោត ហោះហើរ កាន់តែ ខ្ពស់ ។ តើ គួរ ប្រកាន់ខ្ជាប់ កាលានុវត្តភាព នេះ តាម របៀប ណា ?
តាំងពី ត្រឡប់ ចូល មាតុ ប្រទេស វិញ ហុងកុង ជា តំបន់ រដ្ឋបាល ពិសេស មួយ របស់ ចិន ដែល ក្រោម ការគ្រប់គ្រង ផ្ទាល់ ដោយ រដ្ឋាភិបាល មជ្ឈិម ចិន ដែល ស្ថិត ក្នុង ប្រព័ន្ធ អភិបាលកិច្ច ជាតិ ចិន ។ ក្នុង សន្ទរកថា ថ្ងៃទី ១កក្កដា លោក Xi Jinping ប្រធាន រដ្ឋ ចិន បាន គូសបញ្ជាក់ ថា ចាំបាច់ ត្រូវ អនុវត្ត « អ្នកស្នេហាជាតិ គ្រប់គ្រង ហុងកុង » ។ នៅលើ លោក គ្មាន ប្រជាជន ប្រទេស ណាមួយ ឬ តំបន់ ណាមួយ អនុញ្ញាតឱ្យ កម្លាំង ឬ ជន ដែល មិន ស្នេហាជាតិ រហូតដល់ ក្បត់ ជាតិ ចូល កាន់អំណាច ឡើយ ។
ការអភិវឌ្ឍ ជា មូលដ្ឋានគ្រឹះ នៃ ហុងកុង និង កូនសោ មាស សម្រាប់ ដោះស្រាយ បញ្ហា គ្រប់ មុខ នៅ ហុងកុង ផងដែរ ។ ក្នុង កំឡុង ពេល នៅ ហុងកុង លើក នេះ លោក Xi Jinping បាន ចុះ ត្រួតពិនិត្យ ការងារ នៅ សួន វិទ្យាសាស្ត្រ ហុងកុង ជាពិសេស ដើម្បី បង្ហាញ ពី ការគាំទ្រ ដ៏ ច្បាស់ ខ្លាំង ចំពោះ ការច្នៃប្រឌិត ថ្មី ផ្នែក បច្ចេកវទ្យា ។ រួមចំណែក ក្នុង ស្ថានភាព ចិន ហុងកុង មុខ ជា នឹង បន្ត សរសេរ រឿងរ៉ាវ អភិវឌ្ឍ ថ្មី និង ភាពរុងរឿង ថ្មី ៕
ក្នុង សន្និសីទ សារព័ត៌មាន មួយ លោក ស៊ុយ ហ្គូ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « កងទ័ព រុស្ស៉ី កំពុង ផ្តល់ ការគាំទ្រ គ្រប់ ជ្រុងជ្រោយ ដល់ ប្រជាជន នៅ តាម តំបន់ ដែល ស្ថិត ក្រោម ការត្រួតត្រា កំលុង ប្រតិបត្ត ការយោធា ពិសេស ។ កិច្ចប្រឹងប្រែង ដើម្បី ធានា ឲ្យ ការរស់នៅ ប្រព្រឹត្តទៅ ដោយ សន្តិភាព នៅ តាម ដែនដី ដែល គ្រប់គ្រង ដោយ រុស្ស៉ី នឹង នៅតែ បន្ត » ។
លោក ប្រមុខ ការពារ ជាតិ រុស្ស៉ី បាន សង្កត់ធ្ងន់ ថា « អាទិភាព ចម្បង របស់ កងកម្លាំងប្រដាប់អាវុធ រុស្ស៉ី សព្វ ថ្ងៃ នេះ គឺ អាយុជីវិត និង សុខភាព របស់ ទាហាន ក៏ ដូចជា សុវត្ថិភាព របស់ ជន ស៉ី វិល ផងដែរ ។ ប្រតិបត្តិការ នឹង បន្ត រហូតដល់ កិច្ចការ ដែល កំណត់ ដោយ អគ្គ មេបញ្ជាការកំពូល ត្រូវបាន បំពេញ យ៉ាង ពេញលេញ » ។
ឆក់ ទូរស័ព្ទ ២ គ្រឿង បាន សម្រេច ត្រូវ ប្រជាពលរដ្ឋ ចាប់ ប្រគល់ឲ្យ សមត្ថកិច្ច នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ ស្រ្តី ជា អ្នកដឹកជញ្ជូន ម្នាក់ កំពុង អង្គុយ ចុច ទូរស័ព្ទ នៅលើ ម៉ូតូ ស្រាប់តែ មាន ជនសង្ស័យ ម្នាក់ ជិះ ម៉ូតូ មក ជិត រួច ធ្វើ សកម្មភាព ឆក់ ទូរស័ព្ទ ពី ស្ត្រី រូប នោះ បាន ចំនួន ២គ្រឿង បាន សម្រេច រួច ជិះ គេចខ្លួន តែ នារី រងគ្រោះ បាន ស្រែក ថា ចោរ ៗ ភ្លាម ៗ នោះ ជនសង្ស័យ បាន ជិះ ម៉ូតូ គេចខ្លួន សំណាង មិន ល្អ ក៏ ដួល ត្រូវបាន បងប្អូន និង ជនរងគ្រោះ ក្របួច ជាប់ រួច បញ្ជូន មក ប្រគល់ឲ្យ សមត្ថកិច្ច ចាត់ការ តាម ផ្លូវ ច្បាប់ ។
សមត្ថកិច្ច បាន ប្រាប់ ឲ្យដឹង នៅ ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ ថា ករណី ខាងលើ បាន កើតឡើង នៅ វេលា ម៉ោង ៣៖៣០ នាទី ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០២២ ចំណុច ផ្លូវ បេតុង ភូមិ គោក ចំបក់ សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា ដំណើរ រឿង នៅ មុនពេល កើត ហេតុ ជនរងគ្រោះ កំពុងតែ អង្គុយ ចុច ទូរស័ព្ទ នៅលើ ម៉ូតូ លើ ផ្លូវ បេតុង កែង ផ្លូវ ឌួង ងៀប ពេល នោះ ស្រាប់តែ មាន ជនសង្ស័យ ខាងលើ ជិះ ម៉ូតូ ម្នាក់ឯង ចេញ ពី ផ្លូវ ចោម ចៅ ។ ទៅដល់ ចំណុច កើត ហេតុ ជនសង្ស័យ បាន ឃើញ ជនរងគ្រោះ កំពុងតែ អង្គុយ ចុច ទូរស័ព្ទ ម្នាក់ឯង ហើយ មាន ស្ថានភាពស្ងាត់ ពេល នោះ ជនសង្ស័យ បាន ជិះ ម៉ូតូ ទៅ ក្បែរ ជនរងគ្រោះ ហើយ បាន ធ្វើ សកម្មភាព ឆក់ ទូរស័ព្ទ ពី ជនរងគ្រោះ បាន សម្រេច ចំនួន ២គ្រឿង ។
ក្រោយ កើត ហេតុ ជនសង្ស័យ ជិះ ម៉ូតូ គេចខ្លួន បាន ប្រហែល ១០ ម៉ែត្រ ជនសង្ស័យ បាន ជិះ ម៉ូតូ ទៅ បុក និង បង ប្រុស របស់ ជនរងគ្រោះ បណ្តាលឲ្យ ដួល ម៉ូតូ ខណៈ នោះ ជនសង្ស័យ ក៏ ត្រូវបាន ជនរងគ្រោះ និង បង ប្រុស ឃាត់ខ្លួន ប្រគល់ជូន សមត្ថកិច្ច ប៉ុស្តិ៍ ចោម ចៅ ទី១ចាត់ការ តាម ផ្លូវ ច្បាប់ ។
សមត្ថកិច្ច បាន បន្ត ទៀត ថា នៅ ចំពោះមុខ សមត្ថកិច្ច ជនសង្ស័យ បាន សារភាព ថា ខ្លួន ពិតជា បាន ធ្វើ សកម្មភាព ឆក់ ទូរសព្ទ័ ដៃ ពី ជនរងគ្រោះ ពិតប្រាកដ មែន ។ បច្ចុប្បន្ន ជនសង្ស័យ ខាងលើ ត្រូវបាន កម្លាំង ប៉ុស្តិ៍ ចោម ចៅ ទី១ បញ្ជូន មកកាន់ ជំនាញ ផ្នែក ព្រហ្មទណ្ឌ នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី កសាង សំណុំរឿង បន្ត តាម នីតិវិធី ច្បាប់ ៕
ក្រុមការងារ ចុះ ជួយ ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ អំពាវនាវ ពលរដ្ឋ បន្ដ រក្សា សន្ដិភាព និង ប្រឆាំង ជន ណា ដែល ចង់ បំផ្លាញ សន្ដិភាព នេះ
( ព្រះវិហារ ) ៖ លោក ចាន់ នន់ វិទ្យា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ និង លោក សំ លាង ទ្រី សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ និង ជា ប្រធាន ក្រុមការងារ ខេត្ត ចុះ ជួយ ស្រុក សង្គម ថ្មី នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ប្រមាណ ៥០០ នាក់ រៀបចំ ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៧១ ថ្ងៃ បង្កើត គណបក្ស ប្រជាជន កម្ពុជា ( ២៨ មិថុនា ១៩៥១ - ២៨ មិថុនា ២០២២ ) ។
ក្នុង ឱកាស នោះ លោក វ៉ា សេដ្ឋា អនុប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ស្រុក សង្គម ថ្មី បាន អាន សុន្ទរកថា ទាំងស្រុង របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ក្នុង ពិធី រំលឹក ខួប អនុស្សាវរីយ៍ លើក ទី ៧១ ទៅកាន់ សមាជិក - សមាជិកា ប្រមាណ ៥០០ នាក់ ដោយ បាន លើក យក ប្រវត្តិ សង្ខេប នៃ ការចាប់បដិសន្ធិ របស់ គណបក្ស ប្រជាជន កម្ពុជា គឺ នៅ ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ១៩៥១ ដោយ មាន ឈ្មោះ ដើម ថា « គណបក្ស ប្រជាជន បដិវត្តន៍ ខ្មែរ » បន្ទាប់មក នៅ ឆ្នាំ ១៩៩១ បាន ប្តូរ ឈ្មោះ មក ជា « គណបក្ស ប្រជាជន កម្ពុជា » ។
លោក បាន បន្ថែម ថា គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន ជោគជ័យ យ៉ាង ធំធេង នូវ ដំណើរការសន្តិភាវូបនីយកម្ម តាមរយៈ ការអនុវត្ត គោល នយោបាយ ឈ្នះ - ឈ្នះ ដែល បាន បញ្ចប់ ទាំងស្រុង នូវ សង្គ្រាម ស៊ីវិល រាំ រ៉ៃ បង្កើត បាន សុខ សន្តិភាព នៅ ទូទាំង ផ្ទៃ ប្រទេស ។
ដោយឡែក លោក សំ លាង ទ្រី ប្រធាន ក្រុមការងារ ខេត្ត ចុះ ជួយ ស្រុក សង្គម ថ្មី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ប្រជាពលរដ្ឋ ស្រុក សង្គម ថ្មី ដែល ស្រឡាញ់ ជឿជាក់ គណបក្ស ប្រជាជន កម្ពុជា ស្រឡាញ់ សម្តេច តេជោ ហ៊ុន សែន ធ្វើ ការបោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ធ្វើឲ្យ គណបក្ស ឈ្នះ ឆ្នោត ភ្លូក ទឹក ភ្លូក ដី ក្នុង ឱកាស បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ កន្លងទៅ ថ្មី ៗ នេះ ។
លោក ក៏ បាន លើកឡើង ពី គម្រោង អភិវឌ្ឍន៍ នៅ តាម មូលដ្ឋាន នានា នៅក្នុង ខេត្ត ព្រះវិហារ នា ថ្ងៃ ខាងមុខ ក្រោម ការដឹកនាំ របស់ លោក មាស សុភា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ និង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ក្នុង ទិសដៅ រួម បម្រើ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ។
លោក សំ លាង ទ្រី បាន ថ្លែង បញ្ជាក់ ជូន សមាជិក ឬ សមាជិកា បន្ថែម ថា គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ប្តេជ្ញា បន្ត ខិតខំ កសាង ការពារ និង អភិវឌ្ឍ ជាតិ ឲ្យ មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ឆ្លើយតប តាម សេចក្តីត្រូវការ របស់ ប្រជាជន ក្នុង អាណត្តិ ២០១៨ - ២០២៣ និង សម្រេច ឲ្យបាន នូវ គោលដៅ អភិវឌ្ឍ គ្រប់ វិស័យ ប្រកបដោយ ប្រសិទ្ធ ភាព សមធម៌ និង និរន្តរភាព ។
( ភ្នំពេញ ) ៖ ក្នុង នាម ជា សំណង់ ស្ថាបត្យកម្ម ក្នុង សតវត្ស ទី ៩ ប្រកបដោយ រចនាបថ គួរឲ្យ ស្ញប់ស្ញែង របស់ ស្ថាបត្យករ ខ្មែរ ជំទើត ខ្លួន នៅលើ កំពូល ចំណោទ ភ្នំ ដងរែក ប្រាសាទ ព្រះវិហារ បាន បង្ហាញ រូបរាង ប្រកបដោយ អានុភាព មហស្ចារ្យ តាំងពី សម័យ អង្គរ ដ៏ មហា រុងរឿង រហូតដល់ បច្ចុប្បន្ន ។
ក្រោម ព្រះរាជ បូជនីយកិច្ច របស់ ព្រះបរម រតន កោដ្ឋ និង ការដឹកនាំ ដ៏ ប៉ិនប្រសព្វ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ប្រាសាទ ព្រះវិហារ បាន ចុះបញ្ជី សម្បត្តិ បេតិភណ្ឌ ពិភពលោក របស់ អង្គការ យូណេស្កូ កាលពី ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០០៨ ។
សូម ទស្សនា វីដេអូ របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ស្តីពី ការអបអរសាទរ ខួប ១៤ ឆ្នាំ នៃ ការចុះបញ្ជី ប្រាសាទ ព្រះវិហារ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក៖
អភិបាល ខេត្ត ត្បូងឃ្មុំ នាំយក ទៀន ព្រះវស្សា បច្ច័យ និង ទេយ្យ ទាន ជាច្រើន មុខ ប្រគេន ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៅ វត្ត វត្ត សីលា រង្សី ( ហៅ វត្ត ថ្កូវ ) និង វត្ត វិហារ ទន្ទឹម
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ និង លោកស្រី ព្រមទាំង បុត្រ គឺជា ពុទ្ធ សាសនិក ដែល មាន ជំនឿ យ៉ាង មុតមាំ ចំពោះ ព្រះពុទ្ធ សាសនា តែងតែ នាំយក ទៀន ព្រះវស្សា និង ទេយ្យ ទាន ប្រគេន ព្រះសង្ឃ នៅ តាម ទី អាវត្ត នានា ជារៀងរាល់ ឆ្នាំ ពេល គង់ ចាំ ព្រះវស្សា រយៈពេល ៣ខែ នេះ ។
ពិធី ប្រគេន ទៀន ព្រះវស្សា បច្ច័យ និង ទេយ្យ ទាន ត្រូវបាន ធ្វើឡើង តាម លំអាន ព្រះពុទ្ធ សាសនា ក្នុង នោះ ក៏ មាន ការសូត្រ មន្ត ប្រោស ព្រំ ប្រសិទ្ធ ពរ ជ័យ ជូន លោក បណ្ឌិត និង លោកស្រី ព្រមទាំង បុត្រ ក៏ ដូចជា ថ្នាក់ដឹកនាំ ខេត្ត មន្ត្រីរាជការ ដែល បាន អញ្ជើញ ចូលរួម ផងដែរ ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ធ្វើ ការសំណេះសំណាល សួរសុខ ទក្ខ ព្រមទាំង អំពាវនាវ ដល់ លោកតា លោកយាយ ប្រជាពលរដ្ឋ បន្ត រួមគ្នា ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការថែរក្សា ការពារ សមិទ្ធផល នានា របស់ រាជ រដ្ឋាភិបាល ទាំង វិស័យ ពុទ្ធ ចក្រ និង អណាចក្រ ពិសេស ថែរក្សា សន្តិភាព ឱ្យ បាន គង់វង្ស ទាំងអស់ គ្នា ទោះ ត្រូវ ចំណាយ តម្លៃ ណា ក៏ដោយ ពោលគឺ « ប្រសិនបើ គ្មាន សុខ សន្តិភាព ទេ នោះ ក៏ គ្មាន ការអភិវឌ្ឍ រីកចំរើន ដូច សព្វ ថ្ងៃ នេះ ដែរ » ។
ពិធី ដ៏ មាន អត្ថន័យ នោះ ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ក្រោម អធិបតីភាព លោក បណ្ឌិត ហ៊ុន ម៉ាណែត តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បន្ទាប់ពី ពិធី បុណ្យ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា រយៈពេល ៤យប់ ៥ ថ្ងៃ រួច មក ។
លោក អ៊ូច ភា អភិបាល ខេត្ត តាកែវ បាន បញ្ជាក់ ថា ព្រះវិហាមរតក ប៊ុន ស៊ាង លី គឺជា មហាសមិទ្ធផល ថ្មី មួយ ទៀត ដែល កើត ចេញ ពី មរតក និង បញ្ញា ញាណ របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី មាតា បង្កើត សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន មក ចូលរួម ដឹកនាំ និង កសាង ផ្នែក ពុទ្ធ ចក្រ ក្នុង ទី អារាម វត្ត ស្លែង នេះ កាលពី ៨ឆ្នាំ មុន ។
លោក សង្កត់ធ្ងន់ ថា គ្រប់ កាលៈទេសៈ ទាំងអស់ សម្តេច តេជោ ហ៊ុន សែន មិន ដែល រត់ ចោល ប្រជាជន និង ទុកឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ រងគ្រោះ នោះ ដែរ ជាក់ស្តែង ក្នុង ព្រឹត្តិការណ៍ នៃ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ សម្តេច តេជោ បាន ឈរ នៅ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន ខិតខំ ប្រឹងប្រែង ស្វែងរក វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ចាក់ ជូន ប្រជាជន កម្ពុជា និង ជន បរទេស ដោយ មិន យក កម្រៃ និង បាន ចាក់ ស្រោច ជូន ប្រជាជន កម្ពុជា ជាង ៩០ ភាគរយ គ្រប់ ដណ្តប់ នៅ ទូទាំង ប្រទេស កម្ពុជា ។
បន្ថែម ពី នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ធ្វើ ការអំពាវនាវ ជូន ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត តាកែវ ពិសេស ប្រជាពលរដ្ឋ ក្នុង ស្រុក គីរី វង់ សូមអញ្ជើញ ទៅ ចូលរួម ចាក់ វ៉ាក់សាំង ដូស ជំរុញ ទី៣ ទី៤ និង ទី៥ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី ប្រជាជន កម្ពុជា គ្រប់ រូប រួច ចាក ផុត ពី ជំងឺ ដ៏ កាច សាហាវ កូវីដ១៩ ។
សូម បញ្ជាក់ ថា វត្ត ស្លែង ជា វត្ត ចាស់ បុរាណ មួយ ក្នុង ចំណោម វត្ត ចាស់ ៗ ក្នុង ស្រុក គីរី វង់ ខេត្ត តាកែវ មាន អាយុកាល ជាង ៣០០ ឆ្នាំ មកហើយ ដែល មាន ទទឹង ១៥០ ម៉ែត្រ បណ្តោយ ២៤០ ម៉ែត្រ មាន ទីតាំង ភូមិសាស្រ្ត ស្ថិត ក្នុង ភូមិ ស្លែង ឃុំ គោក ព្រេច ស្រុក គីរី វង់ ខេត្ត តាកែវ ។
វត្ត ស្លែង គឺជា ទី អារាម ដ៏ មាន វ័យ ចំណាស់ មួយ ក្នុង ចំ ណោម ទី អារាម ចាស់ ៗ ក្នុង ស្រុក គីរី វង់ ត្រូវបាន កសាងឡើង នៅ ចុង សតវត្ស ទី ១៦ នៃ គ្រឹៈ សករាជ ១៦២២ នេះ បើ យោង តាម សិលា ចារិក លើ ចេតីយ៍ បុរាណ និង វត្ថុ បុរាណ មួយចំនួន ដូចជា ប្រាក ឌួង និង ដុំ សីមា ចាស់ ដែល ប្រទះឃើញ នៅក្នុង អន្លង សីមា ព្រះវិហា ចាស់ សម័យ ដើម ដែល បុព្វបុរស ជំនាន់ នោះ បាន បញ្ចុះ ព្រមទាំង ឯកសារ រស់ ពី ព្រឹទ្ធាចារ្យ ចាស់ទុំ ដំណាលត ៗ គ្នា ។
មូលហេតុ ដែល ហៅ ថា វត្ត ស្លែង ដោយសាវត្ត នេះ កសាងឡើង លើ កំពូល ភ្នំ មួយ មាន ឈ្មោះ ថា ភ្នំ ជីង ចក់ ហើយ ភ្នំ នេះ សំបូរ ទៅ ដោយ ដើម ស្លែង ធំ ៗ ទើប ព្រះគ្រូ ចៅអធិការ ព្រមទាំង ចាស់ ព្រឹទ្ធាចារ្យ ដែល ជា ស្ថាបនិក វត្ត នេះ ដំបូង ឯកភាព គ្នា ប្រសិទ្ធ នាម ឈ្មោះ វត្ត ស្លែង ចាប់តាំងពី ពេល នោះ រហូតមកដល់ បច្ចុប្បន្ន ។
ចាប់តាំងពី បដិសន្ធិ ឡើង ទី អារាម បុរាណ នេះ បាន ឆ្លងកាត់ នូវ ព្រះគ្រូ ចៅអធិការ ជាច្រើន ប៉ុន្តែ គិត ចាប់តាំងពី ក្រោង ថ្ងៃ រំដោះ ៧មករា ឆ្នាំ ១៩៧៩ ទី អារាម វត្ត ស្លែង ក៏ ដូចជា ទី អារាម នានា នៅ ទូទាំង ប្រទេស បាន បើក ឲ្យ ដំណើរការគោរព ប្រតិបត្តិ ឡើងវិញ ទៅ តាម ជំនឿ សាសនា ក៏ ដូចជា ការរស់រាន មាន ជីវិត របស់ ប្រទេស និង ប្រជាជន កម្ពុជា ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
( ឧត្តរមានជ័យ )៖ លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្ដរ មានជ័យ បាន ថ្លែង ណែនាំ ដល់ ក្រុមប្រឹក្សា សង្កាត់ អូរ ស្មាច់ និង សង្កាត់ សំរោង ដែល ទើប ជាប់ ឆ្នោត ថ្មី ត្រូវ ខិតខំ បំពេញ តួនាទី ភារកិច្ច ពិសេស លើ ការបម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ។
ការថ្លែង បែប នេះ ក្នុង ឱកាស ដែល លោក ប្រកាស សុពលភាព សមាជិក ក្រុមប្រឹក្សា សង្កាត់ អូរ ស្មាច់ និង សង្កាត់ សំរោង នៅ ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ។ នៅក្នុង ឱកាស នោះ ដែរ លោក អភិបាល ខេត្ត ឧត្តរមានជ័យ បាន ថ្លែង លើកឡើង ថា ចាប់តាំងពី ឆ្នាំ ២០០២ ព្រះរាជាណាចក្រ កម្ពុជា បាន ដំណើរការ រៀបចំ ការបោះឆ្នោត ជ្រើសរើស ក្រុម ប្រឹក្សា ឃុំ សង្កាត់ តាម គោលការណ៍ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស សរុប ចំនួន ០៥ លើក រួច មកហើយ ។
ការបោះឆ្នោត ដើម្បី បង្កើតឡើង នូវ ក្រុម ប្រឹក្សា នៅ ថ្នាក់ ឃុំ សង្កាត់ មាន អត្ថន័យ យ៉ាង ជ្រាលជ្រៅ មក លើ ប្រព័ន្ធ នយោបាយ និង រដ្ឋបាល នៅ កម្ពុជា គឺ៖
លោក ប៉ែន កុសល្យ បាន ថ្លែង បន្ត ទៀត ថា ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា នៅ ថ្នាក់ ឃុំ សង្កាត់ មាន សារៈសំខាន់ ណាស់ ក្នុង ការជំរុញ កិច្ច ដំណើរការ អនុវត្ត កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ នៅ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ដែល កំណែទម្រង់ នេះ បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការ លើកកម្ពស់ អភិបាលកិច្ច នៅ ថ្នាក់ ឃុំ សង្កាត់ តាម គោលការណ៍ អភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ មូលដ្ឋាន ។
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ទួលគោក និង ជា សមាជិក ក្រុម លេខា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ចាត់ ឱ្យ អភិបាល រង ខណ្ឌ នាយក និង នាយក រង រដ្ឋបាល ខណ្ឌ អញ្ជើញ ប្រកាស សុពលភាព ចូលកាន់ តំណែង សមាជិក ក្រុមប្រឹក្សា សង្កាត់ ថ្មី ដែល ទើប ជាប់ ឆ្នោត ក្នុង អាណត្តិ ទី៥ ស្ថិត នៅ តាម បណ្ដា សាលា សង្កាត់ ចំនួន ៧ផ្សេង ៗ គ្នា ក្នុង ចំណោម សង្កាត់ ចំនួន ១០ ។
លោក ជា ពិសី បាន ចាត់ចែង យ៉ាង ដូច្នេះ បន្ទាប់ពី លោក ជាប់រវល់ ក្នុង ការអញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស សុពលភាព ចូលកាន់ តំណែង សមាជិក ក្រុមប្រឹក្សា សង្កាត់ ថ្មី ដែល ទើប ជាប់ ឆ្នោត ក្នុង អាណត្តិ ទី៥ ស្ថិត នៅ សាលា សង្កាត់ បឹងសាឡាង ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២២ ។
គួរ បញ្ជាក់ ថា អ៉ីតាលី កំពុង ប្រឈម នឹង រលក កំដៅ ខុសពី ធម្មតា និង ការខ្វះខាត ទឹកភ្លៀង ជាពិសេស នៅឯ តំបន់ ភាគ ខាងជើង នៃ ជ្រលង ភ្នំ ប៉ូ (Po) ដែល បាន ទទួលរង ផល ប៉ះពាល់ ខ្លាំង មិន ធ្លាប់ មាន ក្នុង រយៈពេល ជាច្រើ ឆ្នាំ មក នេះ ៕
អភិបាល ខេត្ត ព្រះសីហនុ ទទួល ជួប សម្ដែង ការគួរសម ជាមួយ ប្រតិភូកងទ័ព ជើងទឹក ភូមិន្ទ ថៃ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា
លោក បន្ដ ថា ថ្ងៃ នេះ ជា បេសកកម្ម របស់ កងទ័ព ជើងទឹក ភូមិន្ទ ថៃ បាន បញ្ជូន នាវា មក ធ្វើ ទស្សនកិច្ច នៅ កម្ពុជា ជា លើក ដំបូង បន្ទាប់ពី ជំងឺ កូវីដ បាន ធូរស្បើយ ។ ទោះបី មាន ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ ក៏ប៉ុន្តែ កងទ័ព ជើងទឹក នៃ ប្រទេស ទាំង ពីរ បាន បើក កិច្ចប្រជុំ ពី ចំងាយ ជាមួយគ្នា ជា បន្តបន្ទាប់ តាមរយៈ ប្រព័ន្ធ អនឡាញ ។
ជា ការឆ្លើយតប លោក គួច ចំរើន បាន ស្វាគមន៍ គណៈប្រតិភូកងទ័ព ជើងទឹក ភូមិន្ទ ថៃ ដែល បាន ធ្វើដំណើរ ពី ប្រទេស ថៃ មក បំពេញ ទស្សន កិច្ច នៅ កម្ពុជា ជា លើក ដំបូង បន្ទាប់ពី ការរាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ រយៈពេល ពីរ ឆ្នាំ កន្លងមក នេះ ។
កម្ពុជា ក៏ បាន ទទួល នាវា កងទ័ព ជើងទឹក ភូមិន្ទ ថៃ ចំនួន ៩លើក ស្មើនឹង ១៣ គ្រឿង រួច មកហើយ ដែល បាន ចូល ចត នៅ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ ហើយ ដំណើរទស្សនកិច្ច នា ពេលនេះ ដើម្បី ពង្រឹង ចំណង សាមគ្គីភាព មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ រវាង កងទ័ព ជើងទឹក នៃ ប្រទេស ទាំង ពីរ កាន់តែ រឹងមាំ បន្ថែម ទៀត ។ កម្ពុជា និង ថៃ ជា ប្រទេស ស្ថិត នៅក្នុង តំបន់ អាស៊ាន តែ មួយ ម្យ៉ាងទៀត ឆ្នាំ នេះ កម្ពុជា ត្រូវ ធ្វើជា ប្រធាន នៃ កិច្ចប្រជុំ អាស៊ាន ផងដែរ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ទោះបី នៅក្នុង ឆ្នាំ ២០២០ កន្លងមក កម្ពុជា ក៏ ដូចជា ពិភពលោក ស្ថិត ក្នុង ស្ថានភាព ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ក៏ប៉ុន្តែ ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ឆ្លង ដែន កម្ពុជា និង ថៃ បាន សហការ គ្នា បាន ល្អ ដោយ រើស បាន កញ្ចប់ គ្រឿងញៀន ជាច្រើន នៅក្នុង លំហ សមុទ្រ ហើយ លទ្ធផល នេះ ឆ្លុះបញ្ចាំង ពី សកម្មភាព ពួក ឧក្រិដ្ឋ ជន គ្មាន ឱកាស រត់ ពន្ធ គ្រឿងញៀន បាន សម្រេច យើង ត្រូវ បន្ត ខិតខំ បន្ថែម ទៀត ដើម្បី ទប់ស្កាត់ ការរត់ ពន្ធ គ្រឿងញៀន និង ការរត់ ពន្ធ មនុស្ស ឆ្លង ដែន ដោយ ខុស ច្បាប់ ។
ក្នុង ដំណើរទស្សនកិច្ច របស់ កងទ័ព ជើងទឹក ភូមិន្ទ ថៃ នា ពេលនេះ និង បាន ចូលរួម ចែករំលែក បទពិសោធន៍ រវាង កងទ័ព ជើងទឹក នៃ ប្រទេស ទាំង ពីរ កម្ពុជា និង កងទ័ព ជើងទឹក ភូមិន្ទ ថៃ ។ យើង ជា ប្រទេស ស្ថិត ក្នុង តំបន់ អាស៊ាន តែ មួយ មាន ប្រជាជន ថៃ បាន មក ធ្វើ កានៅ ខេត្ត ព្រះសីហនុ ហើយ ប្រជាជន កម្ពុជា ក៏ ទៅ ធ្វើការ នៅ ប្រទេស ថៃ មាន ចំនួន ច្រើន ផងដែរ ។
លោក គួច ចំរើន បាន ជូន ពរ ដំណើ ទស្សនកិច្ច និង ដំណើកម្សាន្ត របស់ ប្រតិភូកងទ័ព ជើងទឹក ភូមិន្ទ ថៃ នៅលើ ទឹកដី ខេត្ត ព្រះសីហនុ ទទួលបាន សេចក្តីសុខ និង ទទួលបាន ជោគជ័យ គ្រប់ ៗ គ្នា ។
ការចូល ចត នៅ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ នេះ ក្នុង គោលបំណង រឹត ចំណង មិត្តភាព និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង កងទ័ព ជើងទឹក នៃ ប្រទេស ទាំង ពីរ ចាប់ពី ថ្ងៃទី៥ ដល់ ថ្ងៃទី ៩ ខែកក្កដា ឆ្នាំ ២០២២ ( រយៈពេល ៤ ថ្ងៃ )៕ ប្រកាស សុពលភាព ក្រុមប្រឹក្សា សង្កាត់ បឹង ទំពន់ទី១ ខណ្ឌ មានជ័យ . អភិបាល រង ខណ្ឌ ណែនាំ មន្ត្រី ទទួល តំណែង ថ្មី បន្ត បម្រើ ពលរដ្ឋ ឱ្យ មាន តម្លាភាព
( ភ្នំពេញ ) ៖ ប្រកាស សុពលភាព ក្រុមប្រឹក្សា សង្កាត់ បឹង ទំពន់ទី១ អាណត្តិ ទី៥ ខណ្ឌ មានជ័យ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ លោក ឌី រ័ត្ន ខេមរុណ អភិបាល រង ខណ្ឌ បាន ណែនាំ ដល់ ប្រធាន ក្រុមប្រឹក្សា សង្កាត់ សមាជិក សមាជិកា ទាំងអស់ ដែល ទើបតែ ជាប់ ឆ្នោត អាណត្តិ ទី៥ ត្រូវ យកចិត្តទុកដាក់ បំពេញ តម្រូវការ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ដែល គាត់ មក ស្នើសុំ ដូចជា ធ្វើ សំបុត្រ កំណើត សំបុត្រ អាពាហ៍ពិពាហ៍ សំបុត្រ មរណភាព និង សេវា ផ្សេង ទៀត ឱ្យ ទាន់ ពេលវេលាន និង មាន តម្លាភាព ។
លោក អភិបាល រង ខណ្ឌ មានជ័យ បាន ក្រើន រំឮក បន្ថែម ដល់ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ ពង្រឹង លើក ការងារ សន្តិសុខ ក្នុង មូលដ្ឋាន ភូមិ ឃុំ មាន សុវត្ថភាព ត្រូវ ចុះល្បាត ពូន ស្ទាក់ ឬ ច្បាម យក នូវ បទល្មើស ដូច ជា៖ ចោរ គាស់ ផ្ទះ លួច ឆក់ និង ត្រូវ សហការ ជាមួយ ប៉ុស្តិ៍ មូលដ្ឋាន លប់ បំបាត់ ក្មេង ទំនើង និង បញ្ហា គ្រឿងញៀន ក្នុង មូលដ្ឋាន សង្កាត់ ។
ក្នុង នោះ ដែរ លោក សួស សារិន ដែល បាន ជាប់ ជា ប្រធាន ក្រុមប្រឹក្សា សង្កាត់ បឹង ទំពន់ទី១ នៃ អាណត្តិ ទី៥ បាន ប្តេជ្ញាចិត្ត ខិតខំ អនុវត្ត ឱ្យ បាន ម៉ឺងម៉ាត់ នូវ រដ្ឋធម្មនុញ្ញ ច្បាប់ លិខិត បទដ្ឋាន គតិយុត្តិ ជាធរមាន និង គោលការណ៍ ណែនាំ នានា របស់ ថ្នាក់ដឹកនាំ . ពង្រឹង ថែរក្សា សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ក្នុង ជួរ ក្រុមប្រឹក្សា មន្ត្រី សង្កាត់ មន្ត្រី ភូមិ និង អ្នក ពាក់ព័ន្ធ ផ្សេង ៗ ទៀត ។
បន្ថែម នេះ ប្រធាន ក្រុមប្រឹក្សា សង្កាត់ ដែល ទើប ជាប់ ឆ្នោត បាន សន្យា ជំរុញ ការអនុវត្ត គោល នយោបាយ ភូមិ - សង្កាត់ មាន សុវត្ថិភាព ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ដើម្បី រក្សា សន្តិសុខ សុវត្ថិភាព និង សុខដុមនីកម្ម ជូន ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ខិតខំ ប្រើប្រាស់ ថវិកា វិភាជ របស់ រាជដ្ឋាភិបាល និង គៀង គរ ថវិកា បន្ថែម ពី សប្បុរសជន នានា ប្រកបដោយ តម្លាភាព និង ប្រសិទ្ធភាព ដើម្បី ចូលរួម អភិវឌ្ឍ ន៏ មូលដ្ឋាន ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ។
លោក នឹង ជំរុញ ការផ្តល់ សេវា សាធារណៈ ទាំង សេវា តម្រូវការ និង សេវា សំណូមពរ ឱ្យ កាន់តែ កៀក នឹង ប្រជាពលរដ្ឋ ដើម្បី ចូលរួមចំណែក លើកកម្ពស់ ជីវភាព រស់ នៅ និង សុខា មាលភាព របស់ ប្រជាពលរដ្ឋ . ខិតខំ ពង្រឹង យន្តការដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ដើម្បី ទទួលបាន ជំនឿ ទុកចិត្ត ពី ប្រជាពលរដ្ឋ ព្រមទាំង ត្រៀម កម្លាំង អន្តរាគមន៍ សម្រាប់ ការដោះស្រាយ គ្រោះ មហន្តរាយ និង បញ្ហា ផ្សេង ៗ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ នៅក្នុង មូលដ្ឋាន ។
ក្រោយ បញ្ចប់ ពិធី ប្រកាស ការប្រជុំ លើក ដំបូង របស់ ក្រុមប្រឹក្សា សង្កាត់ អាណត្តិ ថ្មី រួច មក លោក ឌី រ័ត្ន ខេមរុណ រួមទាំង សមាជិក សមាជិកា ក្រុមប្រឹក្សា ប្រជាពលរដ្ឋ លោកគ្រូ អ្នកគ្រូ មន្រ្តី សង្កាត់ ជួបជុំគ្នា បន្ត ហូប នំបញ្ចុក ជាមួយ ក្រុមការងារ ក្រោម បរិយាកាស ស្និតស្នាល និង រីករាយ យ៉ាង ក្រៃលែង ក្រោម ដំបូល សន្តិភាព ៕
របាយការណ៍៖ រន្ទះ បាញ់ សម្លាប់ មនុស្ស ១០នាក់ និង របួស ៩នាក់ ក្នុង ខែមិថុនា
របាយការណ៍ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « រយៈពេល ១ខែមិថុនា ឆ្នាំ ២០២២ មាន ករណី គ្រោះ ធម្មជាតិ រន្ទះ បាញ់ បាន កើតឡើង ចំនួន ១៣លើក នៅ មូលដ្ឋាន ខេត្ត ចំនួន ៩ បណ្តាលឱ្យ មនុស្ស ស្លាប់ ១០នាក់ ( ស្រី ៥) របួស ០៩ នាក់ និង ងាប់ គោ ក្របី ១៦ក្បាល » ។
គួរ បញ្ជាក់ ថា វា គឺជា ការចល័ត យន្តហោះ ចម្បាំង អាមេរិក F-35 លើក ដំបូង បង្អស់ មកកាន់ ឧបទ្វីប កូរ៉េ ដែល ត្រូវបាន ប្រកាស ឱ្យដឹង ជាសាធារណៈ បើ គិត ចាប់តាំងពី ចុង ឆ្នាំ ២០១៧មក ។ កំលុង សមយុទ្ធ រួមគ្នា ដែល មាន រយៈពេល ១០ ថ្ងៃ ក្រុម យន្តហោះ ចម្បាំង F-35 គ្រោង នឹង ហោះ ធ្វើ ប្រតិបត្តិការ ជាមួយ ក្រុម យន្តហោះ ចម្បាំង អាមេរិក និង កូរ៉េ ខាងត្បូង ដទៃ ទៀត នៅលើ ដែន អាកាស កូរ៉េ ខាងត្បូង ព្រមទាំង នៅលើ ដែន សមុទ្រ ជុំវិញ នោះ ៕
អភិបាល ខេត្ត កំពង់ស្ពឺ ដាស់តឿន ប្រធាន ក្រុមប្រឹក្សា មេឃុំ ទើប ជាប់ ឆ្នោត ត្រូវ បម្រើ ពលរដ្ឋ កុំ ឱ្យ មាន ភាព ស្ពឹក ស្រពន់ ឱ្យ សោះ
( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ដាស់តឿន បន្ថែម ដល់ ប្រធាន ក្រុមប្រឹក្សា ឃុំ មេឃុំ និង សមាជិក សមាជិក ដែល ទើបនឹង ជាប់ ឆ្នោត ក្នុង ការប្រកួតប្រជែង ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ត្រូវ បម្រើ ប្រជាពលរដ្ឋ ឱ្យ ទាន់ ពេលវេលា សូម កុំ មាន ភាព ស្ពឹក ស្រពន់ លើ ការផ្តល់ សេវា នានា ជូន ប្រជាពលរដ្ឋ ឱ្យ សោះ ។
ការដាស់តឿន បែប នេះ របស់ លោក វ៉ី សំណាង បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ក្នុង ឱកាស លោក បាន អញ្ជើញ ជា អធិបតី ប្រកាស សុពលភាព សមាជិក ក្រុមប្រឹក្សា ឃុំ ត្រែង ត្រយឹង និង ឃុំ យាយ ម៉ៅ ពេជ្រ និល ក្នុង ស្រុក ភ្នំ ស្រួច ។
ក្នុង ពិធី នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោកស្រី ក្រុមការងារ រដ្ឋបាល ខេត្ត លោក ប្រធាន ក្រុមប្រឹក្សា ស្រុក លោក លោកស្រី អភិបាល រង ស្រុក ក្រុមការងារ រដ្ឋបាល ស្រុក លោក ដូច ស្រី មេភូមិ អនុភូមិ និង សមាជិក ភូមិ ប្រធាន អនុប្រធាន និង សមាជិក បណ្ដាញ ក្រុម បញ្ញវ័ន្ត ឃុំ ផងដែរ ។
នា ឱកាស នោះ អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ណែនាំ បន្ថែម ដល់ ដែល មន្ត្រី ឃុំ ដែល ទើប ចូលកាន់ តំណែង ថ្មី ថា « ចាប់ពី ពេលនេះ ត្រូវ បម្រើ ប្រជាពលរដ្ឋ ឱ្យ បាន ត្រឹមត្រូវ ហើយ យកចិត្តទុកដាក់ ឱ្យ ប្រសើរ លើស មុន ។ ក្នុង នោះ កិច្ចការ សាធារណៈ លើ ឯកសារ ផ្សេង ៗ ត្រូវ បម្រើ ពួកគាត់ ឱ្យ បាន ឆាប់ រហ័ស ជៀសវាង យឺតយ៉ាវ ដែល ធ្វើ គាត់ ធុញទ្រាន់ ខាត ពេលវេលា រកស៊ី របស់ គាត់ » ។
សូម បញ្ជាក់ ថា ឃុំ យាយ ម៉ៅ ពេជ្រ និល ក្នុង ស្រុក ភ្នំ ស្រួច ដែល ជា ឃុំ ទើបតែ បង្កើត ថ្មី នឹង ត្រូវ ដំណើរការ ព្រមទាំង បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ចាប់តាំងពី ពេលនេះ តទៅ ផងដែរ ៕
( កណ្ដាល ) ៖ ក្នុង ពិធី ប្រកាស សុពលភាព ក្រុមប្រឹក្សា សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ អាណត្ដិ ទី៥ នៅ រសៀល ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០២២ នេះ អភិបាល ខេត្ត កណ្ដាល លោក គង់ សោភ័ណ្ឌ បាន ប្រាប់ ឲ្យ តួអង្គ សំខាន់ ចំនួន ៥ នៅក្នុង មូលដ្ឋាន ខិតខំ យកចិត្តទុកដាក់ អនុវត្ត តួនាទី ភារកិច្ច របស់ ខ្លួន ក្នុង ការបម្រើ សេវា សាធារណៈ នានា ប្រកបដោយ ប្រសិទ្ធភាព ជូន ប្រជាពលរដ្ឋ របស់ ខ្លួន ឲ្យ អស់ ពី សមត្ថភាព ។
លោក អភិបាល ខេត្ត បាន គូសបញ្ជាក់ ថា ការផ្តល់ សេវា សាធារណៈ លើ គ្រប់ វិស័យ ជូន ប្រជាពលរដ្ឋ គឺជា តួនាទី និង ការទទួលខុសត្រូវ ដ៏ សំខាន់ មួយ ក្នុង ចំណោម តួនាទី និង ការទទួលខុសត្រូវ សំខាន់ ៗ នានា របស់ រដ្ឋបាល ឃុំ សង្កាត់ នីមួយ ៗ ដើម្បី ឆ្លើយតប និង ដោះស្រាយ នូវ សំណើ សំណូមពរ និង តម្រូវ ការចាំបាច់ នានា ជូន ប្រជាពលរដ្ឋ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ទៀត ថា ដើម្បី ធានា បាន នូវ ការផ្ដល់ សេវា នានា ក្នុង មូលដ្ឋាន បញ្ហា គន្លឹះ សំខាន់ គឺ ការបំពេញ តួនាទី ភារកិច្ច របស់ តួអង្គ ស្នូល ចំនួន ៥គឺ៖
ទន្ទឹមនឹង នេះ ដែរ ក្រុមប្រឹក្សា សង្កាត់ ដែល ទើប ជាប់ ឆ្នោត ថ្មី ត្រូវ យកចិត្តទុកដាក់ លើ ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង អំឡុង ពេល ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ប្រកបដោយ តម្លាភាព គណនេយ្យភាព និង មិន មាន ការរើសអើង ស្រប តាម គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល ។
ជាមួយគ្នា នេះ ដែរ លោក ជៀម ខូយ ចៅសង្កាត់ តា ខ្មៅ បាន ឡើង ប្ដេជ្ញាចិត្ត ចំពោះ ការបំរើ ពលរដ្ឋ ក្នុង សង្កាត់ តា ខ្មៅ ឲ្យ សក្ដិសម ជា អ្នក បំរើ រាស្ត្រ និង សម្រួល រាល់ ការលំបាក នានា របស់ ប្រជាជន ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ព ជា ៕ អភិបាល ខេត្ត ស្វាយរៀង ជំរុញ ដល់ ចៅសង្កាត់ ស្វាយរៀង និង ក្រុមប្រឹក្សា សង្កាត់ ត្រូវ បម្រើ ប្រយោជន៍ ពលរដ្ឋ ឱ្យ បាន ល្អ ក្នុង អាណត្តិ របស់ ខ្លួន
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន ជំរុញ ដល់ ចៅសង្កាត់ និង ក្រុមប្រឹក្សា សង្កាត់ ស្វាយរៀង ត្រូវ អនុវត្ត តួនាទី ភារកិច្ច ឱ្យ បាន ល្អ ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ និង បម្រើ ផលប្រយោជន៍ ព្រមទាំង សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ទាំងអស់ ដោយ ស្មើភាព ដោយ យុត្តិធម៌ និង មិន ត្រូវ ប្រកាន់ និន្នាការ នយោបាយ នោះ ឡើយ ។
ការជំរុញ បែប នេះ របស់ អភិបាល ខេត្ត ស្វាយរៀង បាន ធ្វើឡើង ក្នុង ពិធី ប្រកាស សុពលភាព សមាជិក ក្រុមប្រឹក្សា សង្កាត់ ស្វាយរៀង អាណត្តិ ទី៥ ឆ្នាំ ២០២២ នា ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២២ ដោយ មាន ការចូលរួម ពី មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន នាក់ ផងដែរ ។
នា ឱកាស នោះ ដែរ លោក អភិបាល ខេត្ត បាន ស្នើ ឱ្យ ក្រុមប្រឹក្សា សង្កាត់ អាណត្តិ ទី៥នេះ ក៏ ដូចជា គណបក្ស នយោបាយ នានា និង ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ខិតខំ រួមគ្នា លើកកម្ពស់ វប្បធម៌ នៃ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ដើម្បី រស់ នៅ និង បំពេញ ការងារ ប្រកបដោយ ភាពសុខដុមរមនា ក្នុង សង្គម សម្រាប់ ជា មូលដ្ឋាន ក្នុង ការធានា ចីរភាព ដំណើរការលទ្ធិ ប្រធាធិបតេយ្យ សេរី ពហុ បក្ស ការបោះឆ្នោត និង ការអភិវឌ្ឍ សង្គម ឱ្យ កាន់តែ មាន ការអភិវឌ្ឍ រីកចម្រើន បន្ត ទៀត ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត ត្ត បាន ថ្លែងអំណរគុណ ចំពោះ ក្រុមប្រឹក្សា អាណត្តិ ចាស់ ពិតជា មាន ឆន្ទៈ ប្រកបដោយ ភាពសប្បាយរីករាយ ក្នុង ការផ្ទេរ តំណែង ជូន ក្រុមប្រឹក្សា សង្កាត់ អាណត្តិ ទី៥ តាមរយៈ ការប្រគល់ ទទួល ត្រា បញ្ជី សម្ភារៈ ប្រាក់កាស និង ឯកសារ នានា នៅក្នុង ឱកាស នេះ ៕ ក្រសួង អប់រំ និង JICA ដាក់ ឱ្យ ប្រើប្រាស់ កម្មវិធី «Think!Think» របស់ ជប៉ុន នៅ សាលា បឋមសិក្សា វត្ត បូព៌
ក្រុមប្រឹក្សា ខេត្ត រតនគិរី បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៣៧ អាណត្តិ ទី៣ ដើម្បី ពិនិត្យ ពិភាក្សា កែលម្អ លើ របាយការណ៍ មួយចំនួន
( រតនគិរី ) ៖ ក្រុមប្រឹក្សា ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី ៣៧ អាណត្តិ ទី៣ ដើម្បី ពិនិត្យ ពិភាក្សា កែលម្អ របាយការណ៍ ប្រចាំ ខែ ពិនិត្យ លទ្ធផល ការងារ ដែល បាន អនុវត្តន៍ កន្លងមក ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ណាប់ ប៊ុន ហេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ចំណុះ ឱ្យ រដ្ឋបាល ខេត្ត យ៉ាង ច្រើន ផងដែរ ។
សម្ដេច តេជោ ហ៊ុន សែន ចេញ អនុក្រឹត្យ ផ្លាស់ប្ដូរ អភិបាល ស្រុក កៀនស្វាយ និង អភិបាល ស្រុក ស្អាង ខេត្ត កណ្ដាល
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ចេញ អនុក្រឹត្យ តែងតាំង មន្ដ្រីរាជការ ចំនួន ២រូប ដោយ ម្នាក់ ឲ្យ កាន់ តំណែង ជា អភិបាល ស្រុក ស្អាង និង ម្នាក់ កាន់ តំណែង ជា អភិបាល ស្រុក កៀនស្វាយ ខេត្ត កណ្ដាល ។ នេះ បើ តាម អនុក្រឹត្យ តែងតាំង មន្ដ្រីរាជការ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ ។
មន្ដ្រីរាជការ ២រូប ដែល ត្រូវបាន សម្ដេច តេជោ ហ៊ុន សែន ចេញ អនុក្រឹត្យ តែងតាំង នោះ រួម មាន៖
បទ អត្ថាធិប្បាយ៖ ការបង្កើន ជើងហោះហើរ ត្រង់ រវាង ចិន និង កម្ពុជា ជា សញ្ញា ល្អ សម្រាប់ វិស័យ ទេសចរណ៍ និង សេដ្ឋកិច្ច កម្ពុជា
( ភ្នំពេញ ) ៖ មន្ត្រី ជាន់ ខ្ពស់ នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល និង អ្នកធ្វើការ ក្នុង វិស័យ ទេសចរណ៍ នៅ កម្ពុជា បាន រំពឹង ថា ការបើក « ជើងហោះហើរ » ដោយ ត្រង់ រវាង កម្ពុជា និង ចិន ឡើងវិញ នឹង ជំរុញ កំណើន ភ្ញៀវ ទេសចរ ព្រមទាំង អ្នក វិនិយោគ ឱ្យ មក កម្ពុជា កាន់តែ ច្រើន បន្ទាប់ពី មាន ការ កាត់បន្ថយ អស់ មួយ រយៈ ដោយសារតែ ការវាយលុក ពី ជំងឺ កូវីដ - ១៩ នៅលើ សកលលោក ។
ការផ្តល់ ក្តី រំពឹង បែប វិជ្ជមាន នេះ ក្រោយពី មាន ការប្តេជ្ញាចិត្ត រវាង ឯកឧត្តម ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ប្រទេស កម្ពុជា និង ឯកឧត្តម វ៉ាង យី ទីប្រឹក្សា រដ្ឋ និង ជា រដ្ឋមន្រ្តី ក្រសួង ការបរទេស នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន នៅ ប្រទេស មីយ៉ាន់ម៉ា កាលពី ថ្ងៃទី ៣ ខែកក្កដា ថ្មី ៗ នេះ ។
លោកស្រី ឆាយ ស៊ីវលីន ប្រធាន ទីភ្នាក់ងារ ទេសចរណ៍ កម្ពុជា បាន ប្រាប់ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ថា ការឯកភាព គ្នា របស់ ប្រមុខ ការទូត កម្ពុជា ចិន ក្នុង ការបង្កើន ជើងហោះហើរ ត្រង់ រវាង ប្រទេស ទាំង ពីរ ឡើងវិញ ជា សញ្ញា ល្អ មួយ សម្រាប់ វិស័យ ទេសចរណ៍ និង កំណើន សេដ្ឋកិច្ច កម្ពុជា ។
លោកស្រី បញ្ជាក់ ថា កន្លងមក ភ្ញៀវ ទេសចរ ចិន មាន ការជួប លំបាក ក្នុង ការធ្វើដំណើរ ទៅ វិញ ទៅមក ដោយសារតែ សំបុត្រ យន្តហោះ ថ្លៃ និង ពិបាក កក់ សំបុត្រ ថែម ទៀត ផង ព្រោះតែ ជើងហោះហើរ រវាង ប្រទេស ទាំង ពីរ មាន ចំនួន តិច និង មាន លក្ខខណ្ឌ តឹងរឹង សម្រាប់ អ្នកធ្វើដំណើរ ចូល ប្រទេស ចិន ។
លោកស្រី ឆាយ ស៊ីវលីន បាន និយាយ ដូច្នេះ ថា៖ « ភ្ញៀវ ទេសចរ ខ្វះ មធ្យោបាយ ធ្វើដំណើរ ធ្វើឱ្យ សំបុត្រ យន្តហោះ ក៏ ឡើង ថ្លៃ ហើយ មិន ត្រឹមតែ ថ្លៃ ទេ ពិបាក ក្នុង ការកក់ទៅ ទៀត ។ ដូច្នេះ បើ យើង មាន ជើងហោះហើរ ឱ្យ កាន់តែ សម្បូរបែប បន្តិច ទៅ គឺ ជំរុញ ឱ្យ លំហូរ ភ្ញៀវ ទេសចរ ក៏ ដូចជា ការធ្វើដំណើរ របស់ ធុរៈ កិច្ច ផ្សេង ៗ កាន់តែ ច្រើន ហើយ អាច ជំរុញ កំណើន សេដ្ឋកិច្ច ឱ្យ កើន ជាង មុន ផងដែរ » ។
ឯកឧត្តម អ្នកនាំពាក្យ ជឿជាក់ ថា ពេល ភាគី ចិន បាន បង្កើន ជើងហោះហើរ ឱ្យ កាន់តែ ច្រើន ព្រមទាំង កាត់បន្ថយ ការធ្វើចត្តាឡី ស័ក សម្រាប់ អ្នកធ្វើដំណើរ ឱ្យ មក រយៈពេល ខ្លី នឹង ធ្វើឱ្យ វិស័យ ដឹកជញ្ជូន តាម ផ្លូវ អាកាស រវាង កម្ពុជា ចិន នឹង កើនឡើង ជាពិសេស ភ្ញៀវ ទេសចរ និង អ្នក វិនិយោគ ។
ឯកឧត្តម បាន និយាយ ដូច្នេះ ថា៖ « ទំនាក់ទំនង ផ្នែក វិនិយោគ សេដ្ឋកិច្ច រដ្ឋា បាល ជាពិសេស ភ្ញៀវ ទេសចរ នឹង មាន ភាពល្អ ប្រសើរ ឡើងវិញ ពេល ដែល យើង បាន បើក ទូលាយ នូវ ការទទួល ភ្ញៀវ ទេសចរ តាម ផ្លូវ អាកាស នេះ ។ សម្រាប់ អ្នក ចាក់ វ៉ាក់សាំង រួចរាល់ ។ ការបង្កើន ជើងហោះហើរ នេះ គឺជា សញ្ញាណ ឈាន ទៅរក ភាពល្អ ប្រសើរ ច្រើន » ។
បើ តាម ការព្យាករណ៍ របស់ អង្គការ អាកាសចរ ស៊ីវិល អន្តរជាតិ និង អង្គការ ទេសចរណ៍ អន្តរជាតិ បាន ឱ្យដឹង ថា នៅ ចុង ឆ្នាំ ២០២៤ ឬ ដើម ឆ្នាំ ២០២៥ ចំនួន ភ្ញៀវ ដែល ធ្វើដំណើរ តាម ផ្លូវ អាកាស នឹង មាន ការកើនឡើង ប្រហាក់ប្រហែល ទៅនឹង កាលពី ឆ្នាំ ២០១៩ គ្រា ដែល មិន ទាន់ មាន ការផ្ទុះ កូវីដ - ១៩ នៅលើ ពិភពលោក ។
កូន ឈើ ជាង ២ពាន់ ដើម ត្រូវបាន ដាំ ឡើងវិញ ក្នុង បុណ្យ រុក្ខ ទិវា នៅ ខេត្ត សៀមរាប
លោក បន្ថែម ថា ព្រៃឈើ ជា សម្បត្តិ ធម្មជាតិ ដ៏ មាន តម្លៃ បំផុត និង ជា អាយុជីវិត មនុស្ស និង សត្វ ដែល ទាមទារ ឲ្យ មាន ការគ្រប់គ្រង និង ការប្រើប្រាស់ ធនធាន ធម្មជាតិ ប្រកបដោយ វិចារណញ្ញាណ សមហេតុសមផល ដើម្បី ធានា នូវ តុល្យភាព បរិស្ថាន ហើយ ផ្ដល់ ឱកាស ឲ្យ កូន ចៅ ជំនាន់ ក្រោយ ទទួលបាន ផលប្រយោជន៍ ពី ធនធាន ទាំងអស់ នេះ ដើម្បី បំពេញ នូវ សេចក្ដីត្រូវការ និង ភាពសុខដុមរមនា ផងដែរ ។
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា វាយតម្លៃ ខ្ពស់ ចំពោះ គំនិត ផ្តួចផ្តើម អភិវឌ្ឍន៍ សកល និង សន្តិសុខ សកល របស់ ប្រធាន រដ្ឋ ចិន Xi Jinping ជា គំរូ នៃ សេចក្តីសង្ឃឹម របស់ មនុស្សជាតិ
( ភ្នំពេញ ) ៖ គំនិត ផ្តួចផ្តើម អភិវឌ្ឍន៍ សកល ត្រូវបាន ស្នើ ឡើង ដោយ ប្រធាន រដ្ឋ ចិន Xi Jinping ក្នុង មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ លើក ទី៧៦ នាទីក្រុង ប៉េកាំង ក្នុង ពេល កន្លងមក ។ លោក Xi បាន ដាក់ចេញ នូវ គំនិត ផ្តួចផ្តើម នេះ ដើម្បី ប្រកាន់ខ្ជាប់ នូវ អាទិភាព នៃ ការអភិវឌ្ឍ ប្រកាន់ខ្ជាប់ នូវ ប្រជាជនជា កណ្តាល ប្រកាន់ ខ្ចាប់ នូវ បរិយាប័ន្ន និង បរិយាប័ន្ន ប្រកាន់ខ្ជាប់ នូវ ការច្នៃប្រឌិត ថ្មី ព្រមទាំង ប្រកាន់ខ្ជាប់ នូវ ភាព សុខដុមរមនា របស់ មនុស្ស និង ធម្មជាតិ ។
ទាក់ទង នឹង ចំណុច នេះ ឯកឧត្តម ផៃ ស៊ីផាន រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន ប្រាប់ វិទ្យុ មិត្តភាព កម្ពុជា - ចិន ដែរ ថា ការនិយាយ លើកឡើង ពី សន្តិសុខ សកល គឺជា ការគិតគូរ ពី តម្លៃ របស់ មនុស្សជាតិ មិន ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ ខណៈ ដែល ចិន បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង គោល នយោបាយ ពហុ ភាគី គ្មាន យក នរណា ជា សត្រូវ មិន យក និន្នាការ ជា សត្រូវ ប៉ុន្តែ ប្រកាន់ យក តែ សុភមង្គល របស់ មនុស្សជាតិ ទាំងអស់ លើ ពិភពលោក គឺ ផ្តល់ តម្លៃ សន្តិភាព ។
សូម បញ្ជាក់ ថា វេទិកា ជាន់ ខ្ពស់ នៃ ធនាគារ គំនិត និង ប្រព័ន្ធ សារព័ត៌មាន ក្រោម ប្រធានបទ « អភិវឌ្ឍន៍ សកល៖ ភារកិច្ច រួម និង តម្លៃ ប្រតិបតិ្ត » ដែល ផ្តួចផ្តើម រៀបចំ ដោយ ការិយាល័យ ព័ត៌មាន នៃ ក្រុមប្រឹក្សា កិច្ចការ រដ្ឋ ចិន និង សហការរៀបចំ ដោយ បណិ្ឌ ត្យ សភា វិទ្យាសាស្ត្រ សង្គម ប្រទេស ចិន មជ្ឈមណ្ឌល សិក្សា ស្រាវជ្រាវ ពី ការអភិវឌ្ឍ របស់ ក្រុមប្រឹក្សា កិច្ចការ រដ្ឋ ចិន និង អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន បាន ប្រារព្ធ ធ្វើ នៅ ក្រុង ប៉េកាំង នៅ ថ្ងៃ ដដែល ៕
លោក សុក ហៃ ណែនាំ ដល់ មេឃុំ ថ្មី នៅ ឃុំ ចំណា ក្រោម ស្រុក ស្ទោង ត្រូវ បម្រើ ប្រជាពលរដ្ឋ ប្រកបដោយ ទំនួល ខុសត្រូវ
( កំពង់ធំ )៖ លោក សុក ហៃ អភិបាល រង ខេត្ត កំពង់ធំ នា ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចុះ ទៅ ប្រកាស សុពលភាព សមាជិក ក្រុមប្រឹក្សា ឃុំ ចំណា ក្រោម ស្រុក ស្ទោង ខេត្ត កំពង់ធំ និង បាន ណែនាំ ដល់ មេឃុំ ថ្មី នៅ ឃុំ ចំណាក្រោម នេះ ត្រូវ ធ្វើ កិច្ចការ ប្រកបដោយ គណនេយ្យភាព តម្លាភាព និង ទំនួល ខុសត្រូវ មិន ត្រូវ ជិះ សេះ លែង ដៃ ដាច់ខាត ។
លោក សុក ហៃ បាន បញ្ជាក់ ថា ក្រុមប្រឹក្សា ឃុំ អាណត្តិ ទី៥ របស់ ឃុំ ចំណាក្រោម ត្រូវ សហការ ជាមួយ រដ្ឋបាល ស្រុក ស្ទោង និង អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ក្នុង ការសិក្សា លើ ស្ថានភាព ដី នៅ តំបន់ បី ក្នុង ឃុំ ចំណាក្រោម ជូន ប្រជាពលរដ្ឋ ដែល បាន អាស្រ័យ ផល ពី យូរ មកហើយ ស្រប តាម ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បីឱ្យ គាត់ បាន អាស្រ័យ ផល បន្ត ទៀត ។
លោក បាន បញ្ជាក់ បន្ថែម ថា តួអង្គ សំខាន់ ៗ ៥រូប ដែល មាន សក្តានុពល ក្នុង ការផ្តល់ សេវា ជូន ពលរដ្ឋ របស់ ខ្លួន ត្រូវ រៀបចំ ឥរិយាបថ ឱ្យ បាន ល្អ ប្រសើរ ហើយ ស្មៀន ឃុំ ពិតជា មាន សារសំខាន់ ណាស់ ក្នុង ការជួយ ឱ្យ រដ្ឋបាល ឃុំ មាន និរន្តរភាព ប្រកបដោយ ការទទួលខុសត្រូវ កិច្ចសហការ និង ផ្តល់ សេវា ជូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន របស់ ខ្លួន ដោយ មាន ការជឿទុកចិត្ត ពី ប្រជាពលរដ្ឋ ។
លោក សុក ហៃ បាន ជំរុញ ដល់ មេឃុំ ថ្មី ត្រូវ ធ្វើ បច្ចុប្បន្នភាព អ្នក ចាក់ វ៉ាក់សាំង បង្ការ មេរោគ កូវីដ - ១៩ ប្រតិទិន ចាក់ វ៉ាក់សាំង ឱ្យ បាន ជាក់លាក់ និង គ្រប់ ភូមិ នៅក្នុង ឃុំ ដើម្បី ចាក់ វ៉ាក់សាំង ជូន គាត់ ឱ្យ បាន គ្រប់ ៗ គ្នា ហើយ ប្រជាពលរដ្ឋ ត្រូវ ត្រៀមខ្លួន ទៅ ចុះឈ្មោះ បោះឆ្នោត ដែល នឹង ប្រព្រឹត្តទៅ នៅពេល ឆាប់ ៗ នេះ ៕
ចាស់ជរា គ្មាន ទីពឹង ក្នុង ខេត្ត ប៉ៃលិន ៥៥នាក់ ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែកក្កដា ឆ្នាំ ២០២២ ពី មូលនិធិ ចាស់ជរា របស់ លោកស្រី បាន ស្រី មុំ អ៉ី ឈាន
( ប៉ៃលិន) ៖ នៅ ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ លោកស្រី ពៅ សុខ ក្នុង នាម លោកស្រី បាន ស្រី មុំ អភិបាល ខេត្ត ប៉ៃលិន អម ដំណើរ ដោយ ក្រុមការងារ បាន សំណេះសំណាល សួរសុខទុក្ខ លោក តា លោកយាយ ចាស់ជរា គ្មាន ទីពឹង និង មាន ជីវភាព ខ្វះខាត ចំនួន ៥៥នាក់ ដែល មក ទទួល ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែកក្កដា ឆ្នាំ ២០២២ ពី ក្រុមការងារ របស់ មូលនិធិ ចាស់ជរា របស់ លោកស្រី បាន ស្រី មុំ អ៉ី ឈាន ។
លោកស្រី ពៅ សុខ បាន ថ្លែង ថា មូលនិធិ នេះ បាន បង្កើតឡើង ក្នុង គោលបំណង ជួយ ដល់ លោកយាយ លោក តាចាស់ជរា គ្មាន ទីពឹង មាន ជីវភាព ខ្សត់ខ្សោយ និង មាន អាយុ ចាប់ពី ៧០ ឆ្នាំ ឡើង ទៅ ដែល ពុំ មាន លទ្ធភាព អាច ចេញ ទៅ ប្រកប មុខរបរ ចិញ្ចឹម ជីវិត បាន ក៏ ដូចជា ការជួយ លើក កំពស់ កម្រិត ជីវភាព និង បំប៉ន ថែទាំ សុខភាព លោកយាយ លោក តា ដោយ មិន ប្រកាន់ បក្សពួក និង និន្នាការ នយោបាយ ឡើយ ព្រោះ មនុស្ស ចាស់ គឺ មាន គុណ បំណាច់ ធំ ធេង ណាស់ ក្នុង ការជួយ អប់រំ ប្រៀន ប្រដៅ ដល់ កូន ចៅ ជំនាន់ ក្រោយ ៗ ឲ្យ ប្រព្រឹត្តិ តែ អំពើ ល្អ ។
ក្នុង ឱកាស នោះ ដែរ លោកស្រី ក៏ បាន អំពាវនាវ ដល់ លោកយាយ លោក តា ទាំងអស់ ចូលរួម ប្រយុទ្ធ ប្រឆាំង បង្ការ ទប់ស្កាត់ ការពារ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ដោយ ត្រូវ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ចូលរួម គោរព អនុវត្តន៍ នូវ វិធាន ចាំបាច់ នានា របស់ រាជ រដ្ឋាភិបាល ៕
បទ អត្ថាធិប្បាយ៖ ឱ្យ តែ យើង ប្រកាន់ខ្ជាប់ យ៉ាង មុតមាំ មិន ងាករេ នូវ « ប្រទេស មួយ ប្រព័ន្ធ គ្រប់គ្រង ពីរ » នោះ អនាគត របស់ ហុងកុង មុខ ជា នឹង មាន ភាព កាន់តែ ល្អ បវរ ជាក់ ជា មិន ខាន
នៅពេល អនាគត ពិភពលោក នឹង ធ្វើជា សាក្សី ថា ការអនុវត្ត ជាក់ស្តែង នៃ គោលការណ៍ « ប្រទេស មួយ ប្រព័ន្ធ គ្រប់គ្រង ពីរ » នឹង ទទួលបាន ជោគជ័យ កាន់តែ ធំ ធេង នៅ តំបន់ ហុងកុង !
ទេសរដ្ឋមន្រ្តី លី ធុជ ដឹកនាំ គណៈប្រតិភូ ទស្សនកិច្ច ស្វែងយល់ អំពី សកម្មភាព ហ្វឹកហ្វឺន ការងារ បោសសម្អាត មីន និង សុន ខ រាវ មីន នៅ វិទ្យាស្ថាន បច្ចេកទេស សកម្មភាព មីន របស់ ស៊ីម៉ាក់ ក្នុង ខេត្ត កំពង់ឆ្នាំង
ក្នុង ដំណើរទស្សនកិច្ច លោក ទេសរដ្ឋមន្រ្តី បាន ថ្លែងអំណរ ចំពោះ កិច្ច ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ ពី លោក ហេង រតនា អគ្គ នាយក នៃ មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា ( ស៊ីម៉ាក់ ) និង សហការី ព្រមទាំង បាន វាយតម្លៃ ខ្ពស់ សកម្មភាព ហ្វឹកហ្វឺន សមត្ថភាព ជំនាញ និង បច្ចេកទេស របស់ អ្នកដោះ មីន ដែល ទទួលបាន មកពី វិទ្យាស្ថាន នេះ ។
លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន លើកឡើង ថា ស៊ីម៉ាក់ គឺជា មជ្ឈមណ្ឌល បោសសម្អាត មីន ជាតិ ដ៏ លេចធ្លោ មួយ និង មាន សមត្ថភាព ខ្ពស់ ព្រមទាំង បាន ចូលរួម រំដោះ ផ្ទៃដី ពី ការគម្រាមកំហែង ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ច្រើន ជាង គេ នៅ កម្ពុជា ។
ទេសរដ្ឋមន្រ្តី បាន បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី តែងតែ យកចិត្តទុកដាក់ ខ្ពស់ ដល់ សុវត្ថិភាព និង ត្រូវ បោសសម្អាត មីន ឲ្យ អស់ ពី កម្ពុជា ដើម្បី ផ្តល់ នូវ ស្នាមញញឹម ជូន ប្រជាពលរដ្ឋ ។
លោក បន្ត ទៀត ថា ថ្មី ៗ នេះ សម្តេច តេជោ បាន ផ្តល់ បេសកកម្ម ឲ្យ អាជ្ញាធរ មីន ដឹកនាំ និង រៀបចំ វិស័យ សកម្មភាព មីន ជាមួយ ប្រតិបត្តិករ ជាតិ ដើម្បី រៀបចំ ផែនការ និង ដាក់ពង្រាយ កម្លាំង បោសសម្អាត មីន ក្រោម « គម្រោង សម្តេច តេជោ សម្រាប់ សកម្មភាព មីន » ដំណាក់កាល ដំបូង ក្នុង នោះ ត្រូវការ ជា ចំបាច់ នូវ កម្លាំង មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា ចូលរួម ផងដែរ ដែល ត្រូវ អនុវត្ត តាម ស្ត ង់់ដា សកម្មភាព កំចាត់ មីន កម្ពុជា ៕
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែកក្កដា៖ បង្ក្រាប ១៥ករណី ឃាត់ខ្លួន ៣៤ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៥ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៨ករណី . ដឹកជញ្ជូន រក្សាទុក ២ករណី និង ជួញដូរ ៥ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣៤ នាក់ ។
ព្រឹក ស្អែក សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ សំណេះសំណាល និង ផ្តល់ ដំបូន្មាន ដល់ ប្រតិភូ កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម មុន ចេញ ទៅ ប្រកួត នៅ ឥណ្ឌូនេស៊ី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃពុធ ទី ០៦ ខែកក្កដា ឆ្នាំ ២០២២ ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នឹង អញ្ជើញ ជួប សំណេះសំណាល ក៏ ដូចជា ផ្តល់ នូវ ដំបូន្មាន មួយចំនួន ជូន ដល់ ប្រតិភូ កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម មុននឹង ពួកគេ ចេញ ទៅ ប្រកួត កីឡា ពិការ អាស៊ាន ឬ អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១១ នៅ ទីក្រុង សូឡូ ប្រទេស ឥណ្ឌូនេស៊ី ។
ដោយឡែក ការប្រកួត លើក ទី ១១ នេះ តាមពិត ត្រូវ ធ្វើ នៅ ប្រទេស វៀតណាម តែ វៀតណាម សុំ លើក ពេល ក្រោម ហេតុផល វិបត្តិ ជំងឺ កូវីដ១៩ ទើប លើក ទៅ រៀបចំ នៅ ប្រទេស ឥណ្ឌូនេស៊ី ជំនួស វិញ ។
សូម បញ្ជាក់ ថា គណៈកម្មាធិការ ជាតិ ប៉ារ៉ាឡាំពិក កម្ពុជា ត្រូវបាន បង្កើតឡើង នៅ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ១៩៩៧ ដោយ មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន ។ គណៈកម្មាធិការ ប៉ារ៉ាឡាំពិក កម្ពុជា ជាំ សមាជិក ពេញ សិទ្ធិ នៃ គណៈកម្មាធិការ ប៉រ៉ាឡាំពិក អន្តរជាតិ (IPC) សមាជិក ពេញ សិទ្ធិ នៃ គណៈកម្មាធិការ ប៉ារ៉ាឡាំពិក អាស៊ី និង ជា សមាជិក ស្ថាបនិក និង ពេញ សិទ្ធិ នៃ សហព័ន្ធ កីឡា ពិការ អាស៊ាន ។
ធនាគារ ជាតិ នៃ កម្ពុជា មាន ផែនការបង្កើត ឲ្យ មាន ការទូទាត់ ឆ្លង ដែន តាមរយៈ ប្រព័ន្ធ KHQR
( ភ្នំពេញ ) ៖ លោកស្រី ជា សិរី ឧបការី ទេសាភិបាល និង ជា អគ្គ នាយក បច្ចេកទេស ធនាគារ ជាតិ នៃ កម្ពុជា បាន ឲ្យដឹង ថា ការបង្កើត ប្រព័ន្ធ KHQR នេះ មិន ត្រឹមតែ ពង្រឹង ការទូទាត់ ក្នុង ស្រុក ឲ្យ កាន់តែ មាន ភាពងាយស្រួល សុវត្ថិភាព និង ឆាប់រហ័ស ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ ធនាគារ ជាតិ នៃ កម្ពុជា មាន បំណង ពង្រឹង ការទូទាត់ ឆ្លង ដែន ទៅកាន់ ប្រទេស ក្នុង តំបន់ ឲ្យ មាន ភាពងាយស្រួល តាមរយៈ ប្រព័ន្ធ KHQR នេះ ផងដែរ ។
ការលើកឡើង របស់ លោកស្រី ជា សិរី ធ្វើឡើង ក្នុង កម្មវិធី ដាក់ ឲ្យ ប្រើប្រាស់ ប្រព័ន្ធ KHQR ជា ផ្លូវការ នៅ ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០២២ ។
សូម ជម្រាប ថា យោង តាម របាយការណ៍ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា បាន ឲ្យដឹង ថា មាន គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ចំនួន ៣៧ ជា សមាជិក បាគង បាន ចូលរួម អភិវឌ្ឍ មុខងារ KHQR ក្នុង នោះ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ចំនួន ២៩ បាន បំពេញ មុខងារ ដោយ ជោគជ័យ ជាមួយ KHOR និង បាន ដាក់ ឱ្យ ប្រើប្រាស់ និង ទូទាត់ ទំនិញ ជាមួយនឹង ដៃគូ ពាណិជ្ជករ នៅ ទូទាំង ប្រទេស ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៤១៩ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក និង អត់ ស្លាកលេខ ។ ដោយឡែក រថយន្ត ល្បឿន ល្មើស ល្បឿន ឆៀក ស្រវឹង ឆៀក និង អត់ ប័ណ្ណ បើកបរ ជាដើម ។
ប្រកាស សមាសភាព ក្រុមប្រឹក្សា ឃុំ ចំការអណ្តូង ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម . អភិបាល ខេត្ត ក្រើន រំឮក ឱ្យ សហការ គ្នា ធ្វើ ការ ដើម្បី ប្រយោជន៍ ពលរដ្ឋ
( កំពង់ចាម ) ៖ ក្នុង ពិធី ប្រកាស សុពលភាព សមាជិក ក្រុមប្រឹក្សា ឃុំ ចំការអណ្តូង ស្រុក ចំការលើ នា ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២២. លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន ប្រាប់ ឱ្យ បេក្ខជន ជាប់ ឆ្នោត មកពី គណបក្ស នយោបាយ នានា ជា សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ត្រូវ រួម សហការ គ្នា ធ្វើ ការ ដើម្បី ប្រយោជន៍ ប្រជាពលរដ្ឋ ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា បន្ទាប់ពី ការប្រកាស លទ្ធផល ជា ផ្លូវការ បេក្ខជន ជាប់ ឆ្នោត មកពី គណបក្ស នយោបាយ នានា នឹង ក្លាយជា ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ជា អាជ្ញាធរ សាធារណៈ ដែល មាន កាតព្វកិច្ច តាម ផ្លូវ ច្បាប់ ធ្វើជា តំណាង ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ នៅក្នុង មូលដ្ឋាន ។ ហេតុ នេះ សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល មកពី គណបក្ស ផ្សេង ៗ គ្នា ត្រូវ ខិតខំ រួបរួម សាមគ្គី សហការ ធ្វើការ ជាមួយគ្នា ប្រក ដោយ ការទទួលខុសត្រូវ ដើម្បី បម្រើ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ឱ្យ បាន ល្អ ប្រសើរ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ការផ្តល់ សេវា សាធារណៈ លើ គ្រប់ វិស័យ ជូន ប្រជាពលរដ្ឋ គឺជា តួនាទី និង ការទទួលខុសត្រូវ ដ៏ សំខាន់ មួយ ក្នុង ចំណោម តួនាទី និង ការទទួលខុសត្រូវ សំខាន់ ៗ នានា របស់ រដ្ឋបាល ឃុំ សង្កាត់ នីមួយ ៗ ដើម្បី ឆ្លើយតប និង ដោះស្រាយ នូវ សំណើ សំណូមពរ និង តម្រូវ ការចាំបាច់ នានា ជូន ប្រជាពលរដ្ឋ ។
ជាមួយគ្នា នេះ ដែរ លោក អ៊ុន ចាន់ ដា បាន បញ្ជាក់ ថា តួអង្គ ស្នូល ចំនួន ៥រួម មាន ទី ១៖ មេឃុំ ចៅសង្កាត់ . ទី ២៖ ស្មៀន ឃុំ សង្កាត់ . ទី ៣៖ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ សង្កាត់ . ទី ៤៖ មណ្ឌល សុខភាព ឬ ប៉ុស្តិ៍ សុខភាព និង ទី ៥៖ មេភូមិ ជា តួអង្គ យ៉ាង សំខាន់ ដើម្បី ធ្វើឱ្យ មូលដ្ឋាន មាន ការអភិវឌ្ឍ និង មាន សន្តិសុខ សណ្តាប់ធ្នាប់ ល្អ ។
លោក អភិបាល ខេត្ត បាន គូសបញ្ជាក់ ថា ដូច្នេះ សូម ឱ្យ តួអង្គ ទាំង៥ ខាងលើ នេះ ខិតខំ យកចិត្តទុកដាក់ អនុវត្ត តួនាទី ភារកិច្ច របស់ ខ្លួន ក្នុង ផ្តល់ សេវា សាធារណៈ នានា ជូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន របស់ ខ្លួន ឱ្យ បាន ល្អ ប្រសើរ ប្រកបដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ និង កែលម្អ ឥរិយាបថ ក្នុង ការប្រាស្រ័យទាក់ទង ជាមួយ ប្រជាពលរដ្ឋ ប្រកបដោយ តម្លាភាព គណនេយ្យភាព និង យុត្តិធម៌ ដោយ មិន ត្រូវ មាន ការរើសអើង ការបែងចែក បក្សពួក គ្រួសារនិយម និង និន្នាការ នយោបាយ ឡើយ ៕
ថ្លែង នៅក្នុង ឱកាស « បុណ្យ រុក្ខ ទិវា » នេះ លោក ស្វាយ សំអ៊ាង បាន ឱ្យដឹង ថា ការប្រារព្ធ បុណ្យ រុក្ខ ទិវា នា ថ្ងៃ នេះ ពិតជា រួមចំណែក ដល់ ការអភិរក្ស និង ការពារ ព្រៃឈើ ដែល ជា កាតព្វកិច្ច និង ការទទួលខុសត្រូវ រួម របស់ យើង ទាំងអស់ គ្នា ។
លោក ស្វាយ សំអ៊ាង ក៏ បាន ស្នើឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម បណ្តុះ គំនិត នៃ ការស្រឡាញ់ ដើមឈើ ថែរក្សា ការពារ ព្រៃឈើ និង បរិស្ថាន ធម្មជាតិ ឲ្យបាន គ្រប់ ៗ គ្នា និង ចូលរួម ដាំ កូន ឈើ នៅ តាម សហគមន៍ ទី អារាម ភូមិដ្ឋាន តាម ដងផ្លូវ រមណីយដ្ឋាន និង កន្លែង ផ្សេង ៗ ទៀត ដើម្បី ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការការពារ ការអភិរក្ស និង ជា ប្រយោជន៍ ដល់ ការរស់នៅ ផង សហគមន៍ ផង និង ជីវិត សត្វ ព្រៃ គ្រប់ ប្រភេទ ព្រមទាំង ប្រព័ន្ធ ជីវៈ ចម្រុះ ផងដែរ ។
ក្រសួង សុខាភិបាល ដាក់ ចេញ ផែនការរុករក ជំងឺ របេង លើ កុមារ បន្ថែម ទៀត សំដៅ កាត់បន្ថយ អត្រា ឆ្លង និង ស្លាប់ ឱ្យ លែង ជា បញ្ហា សុខភាព សាធារណៈ នៅ ឆ្នាំ ២០៣០ (Video inside) ( ភ្នំពេញ ) ៖ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ថ្លែង ថា ដើម្បី សម្រេចបាន គោលដៅ ដែល បាន កំណត់ សម្រាប់ បណ្ដា ឆ្នាំ ខាងមុខ និង ឆ្ពោះ ទៅ ការសម្រេច បាន គោលដៅ អភិវឌ្ឍ ប្រកបដោយ ចីរភាព នា ឆ្នាំ ២០៣០ ក្រសួង សុខាភិបាល បាន ដាក់ចេញ នូវ ផែន ការរុករក ជំងឺ របេង លើ កុមារ បន្ថែម ទៀត ដោយ កន្លងមក រក តែ លើ មនុស្ស ចាស់ ដោយ
រក ឱ្យ ឃើញ កាន់តែ លឿន ដាក់ ឱ្យ ព្យាបាល កាន់តែ រហ័ស និង ប្រកបដោយ ប្រសិទ្ធភាព ។
លោក សាស្ដ្រាចារ្យ ថ្លែង បន្ដ ថា « គោលដៅ យើង ចង់ ស្វែងរក ឱ្យ បាន អស់ នូវ អ្នក កើត ជំងឺ របេង ទូទាំង ប្រទេស កាន់តែ ឆាប់រហ័ស យកមក ព្យាបាល ឱ្យ ឆាប់ ជា ទើប ប្រសិទ្ធ មាន ខ្ពស់ សម្រាប់ គោលដៅ យើង ។ តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល រាល់ ការព្យាបាល ជំងឺ របេង ជូន ប្រជាពលរដ្ឋ គឺ មិន គិត ប្រាក់ ទេ » ។
រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង ក៏ អំពាវនាវ ដល់ សេវា ឯកជន ត្រូវ សហការ ផងដែរ បើ មាន អ្នកជំងឺ ទៅ រក សេវា ព្យាបាល ហើយ ពិនិត្យ ទៅ ឃើញ មាន ជំងឺ របេង សូម បញ្ជូន ពួកគាត់ មក ពេទ្យ រដ្ឋ ព្រោះ ជំងឺ នេះ គឺ ព្យាបាល ក្នុង រយៈពេល វែង ៤ទៅ៦ ខែ ដែល ធ្វើឱ្យ អ្នកជំងឺ ចំណាយ ថវិកា អស់ ច្រើន ។
លើស ពី នោះ លោក រដ្ឋមន្ដ្រី បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ជាពិសេស មនុស្ស ចាស់ ណា ដែល មាន សភាព ស្គម ឡើង កំដៅ នៅ ពេល យប់ ក្អក ញឹម ញាប់ ច្រើន ជាង ២០ ដង ក្នុង មួយ ថ្ងៃ ហើយ សម្រាប់ កុមារ ក៏ ដូចគ្នា ពិសេស កង្វះ អាហារូបត្ថម្ភ សូមអញ្ជើញ មកកាន់ មន្ទីរពេទ្យ និង មណ្ឌល សុខភាព ដែល នៅក្បែរ លោក អ្នក ។
គម្រោង សិក្សា នេះ ជា ការស្រាវជ្រាវ ខ្នាត អន្ដរជាតិ ដែល មាន ប្រទេស ចូលរួម ចំនួន ៧៖ មាន កម្ពុជា កាមេរូន កូដ ឌីវ រ័ដ មូហ្សំា ប៊ិក សៀរ៉ា លេអូន អ៊ូហ្គង់ ដា និង ហ្សាំប៊ី យ៉ា ហើយ ដែល មាន សារៈសំខាន់ បំផុត ចំពោះ ការស្រាវជ្រាវ និង ធ្វើ រោគវិនិច្ឆ័យ ជំងឺ របេង កុមារ ដែល អន្ដរជាតិ ពុំ ដែល ធ្លាប់ បាន ធ្វើ និង បណ្ដា ប្រទេស ជាច្រើន ទន្ទឹងរង់ចាំ លទ្ធផល ដើម្បី យក ទៅ អនុវត្ដ ។
លោក បាន ថ្លែង បន្ដ ថា ករណី ជំងឺ របេង កុមារ ថ្មី ប្រមាណ ជាង ១លាន ករណី ក្នុង ឆ្នាំ ២០២០ នៅ ទូទំាង ពិភពលោក ប៉ុន្ដែ មាន ករណី ជំងឺ របេង កុមារ ថ្មី តែ ៤០០.០០០ ករណី ប៉ុណ្ណោះ ដែល ត្រូវបាន រាយការណ៍ ។ ជាង ពាក់កណ្ដាល នៃ កុមារ និង ក្មេង ជំទង់ ដែល មាន ជំងឺ របេង ប្រឈមមុខ នឹង ឧបសគ្គ ក្នុង ការទទួលបាន ការណែនាំ ដោយសារ ការលំបាក ក្នុង ការធ្វើ រោគវិនិច្ឆ័យ និង ការព្យាបាល ៕
( ភ្នំពេញ ) ៖ អគ្គិភ័យ បាន លេប ត្របាក់ ឃ្លាំង ជួសជុល មួយ កន្លែង បណ្ដាលឲ្យ ឆេះ រថយន្ត អស់ ចំនួន ៣គ្រឿង នៅ វេលា ម៉ោង ១១៖៣០ នាទី ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ តាម បណ្ដោយ ផ្លូវ លេខ ៥៩៨ ក្នុង ភូមិ ទួល ថ្ងាន់ សង្កាត់ ទួល សង្កែ ទី២ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន បាន អះអាង ថា ចំពោះ ករណី គ្រោះ អគ្គិភ័យ ខាងលើ នេះ បាន ឆាបឆេះ រថយន្ត ចំនួន ៣គ្រឿងអស់ ទាំងស្រុង ម៉ាក ធុន ត្រា ១គ្រឿង . ម៉ាក ឡិចស៊ីស NX200T ១គ្រឿង និង ម៉ាក CRV ១គ្រឿង ។ ចំពោះ មូលហេតុ ដែល បណ្តាលឲ្យ កើតមាន គ្រោះ អគ្គិភ័យ ខាងលើ នេះ គឺ ដោយសារតែ ការឆ្លង ចរន្ត អគ្គីសនី បង្ក ជា អគ្គិភ័យ ៕
ដើម្បី រឹត ចំណង មិត្តភាព លោកស្រី ឃួន ឃុន ឌី សមាជិក ព្រឹទ្ធសភា ដឹកនាំ ក្រុម នារី អមតៈ ជាង ៧០ នាក់ ទៅ កម្សាន្ត ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ ដើម្បី រឹត ចំណង មិត្តភាព ជាមួយ អតីត មិត្ត រួម ជំនាន់ សិក្សា និង រំលឹក អនុស្សាវរីយ៍ កាល នៅ វ័យ សិក្សា ផង នោះ លោកស្រី ឃួន ឃុន ឌី សមាជិក ព្រឹទ្ធសភា បាន កៀរគរ អតីត មិត្តភក្តិ រួម ជំនាន់ សិក្សា ជាមួយគ្នា នៅ ខេត្ត កំពង់ធំ ឆ្នាំ ១៩៨២ - ១៩៨៥ គឺ « ក្រុម នារី អមតៈ » ជាង ៧០ នាក់ ធ្វើដំណើរ ទៅ កម្សាន្ត នៅ ខេត្ត ព្រះសីហនុ ស្ដែង ឱ្យ ឃើញ បរិយាកាស សប្បាយរីករាយ ។
ដំណើរកម្សាន្ត ជាមួយ មិត្តភក្តិ រួម ជំនាន់ « ក្រុម នារី អមតៈ » នេះ ធ្វើឡើង រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២- ៤ ខែកក្កដា ឆ្នាំ ២០២២ ដោយ ធ្វើដំណើរ ចេញ ពី ខេត្ត កំពង់ធំ ឆ្ពោះ ទៅកាន់ កន្លែង កម្សាន្ត នានា នៅ ខេត្ត ព្រះសីហនុ ដូចជា រង្វង់ មូល ព្រះថោង តោង ស្បៃ នាង នាគ ខ្មែរ ធ្វើ បាន ឆ្នេរ អូរ ឈើ ទាល ឆ្នេរ អូរ ត្រេះ ឆ្នេរ រាម ឆ្នេរ មាស ឆ្នេរ ប្រាក់ កោះ រាជ បុត្រ ជាដើម ។
នា ឱកាស នោះ ដែរ លោកស្រី ឃួន ឃុន ឌី បាន លើកទឹកចិត្ត ដល់ អតីត មិត្ត រួម ជំនាន់ ឱ្យ បង្កើន ការរាប់អាន រឹត ចំណង ទំនាក់ទំនង មិត្តភាព ឡើងវិញ ប្រសិនបើ អ្នកណា មាន បញ្ហា ក្នុង ជីវភាព ឬ បញ្ហា ណាមួយ សូម ទំនាក់ទំនង ជួយ គ្នា ទៅ វិញ ទៅ មក ហើយ ក្រុម នារី អមតៈ នេះ ធ្លាប់ បាន ជួយសង្គ្រោះ ដល់ មិត្ត រួម ជំនាន់ ដែល បាន ឆេះ ផ្ទះ និង បាន កសាង នូវ សមិទ្ធផល នានា ជាមួយ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី ដែល បាន ធ្វើឲ្យ ប្រទេស មាន សុខ សន្តិភាព និង មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ផងដែរ ។
បរិយាកាស នៃ ដំណើរកម្សាន្ត នេះ គឺ ពោរពេញ ដោយ ភាពសប្បាយរីករាយ ដែល អាច ជា គំរូល្អ មួយ សម្រាប់ សិស្សានុសិស្ស ក៏ ដូចជា អតីត មិត្ត សិក្សា រួម ជំនាន់ ផ្សេង ទៀត ដើម្បី រួមគ្នា រឹត ចំណង មិត្តភាព បន្ត ការស្រលាញ់ រាប់អាន គ្នា និង រំលឹក អនុស្សាវរីយ៍ ល្អ ៗ កាល នៅ សិក្សា ។
គួរ ជម្រាប ថា លោកស្រី ឃួន ឃុន ឌី គឺជា អតីត សិស្ស ដែល ធ្លាប់ សិក្សា រៀនសូត្រ នៅ វិទ្យាល័យ កំពង់ធំ ហើយ នា ពេល បច្ចុប្បន្ន លោកស្រី បាន ក្លាយជា សមាជិក ព្រឹទ្ធសភា មួយ រូប ប្រចាំ នៅ មណ្ឌល ខេត្ត កំពង់ធំ ផងដែរ ៕ ករណី វិវាទ រវាង ប្រជាពលរដ្ឋ ១៣៦ គ្រួសារ ជាមួយ ក្រុមហ៊ុន អចលន ទ្រព្យ នៅ ស្រុក ព្រៃនប់ ត្រូវបាន អភិបាល ខេត្ត ព្រះសីហនុ សម្របសម្រួល បញ្ចប់
( ព្រះសីហនុ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ដោះស្រាយ ករណី វិវាទ រវាង ប្រជាពលរដ្ឋ ចំនួន ១៣៦ គ្រួសារ និង ក្រុមហ៊ុន អ. អិន វី អាយ ភី រៀល អ៊ីស្ទេត ឯ . ក ពាក់ព័ន្ធ ការអនុវត្ត កិច្ចសន្យា ទិញ លក់ ផ្ទះល្វែង / វីឡា កូន កាត់ មាន ទីតាំង ស្ថិត នៅ ភូមិ អូរ តា សេក ឃុំ អូរ ឧកញ៉ា ហេង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
លោក គួច ចំរើន បាន ឯកភាព ដាក់ កម្មវិធី ដើម្បី ដោះស្រាយ បញ្ហា វិវាទ ការសាងសង់ ការបញ្ចប់ កិច្ចសន្យា សាងសង់ នៃ ក្រុមហ៊ុន បុរី VIP ជាមួយ ប្រជាពលរដ្ឋ ដែល ជា អតិថិជន និង បាន បើក ឱកាស ឲ្យ ភាគី តំណាង ប្រជាពលរដ្ឋ និង តំណាង ក្រុមហ៊ុន លើកឡើង ជា មតិ យោបល់ ដើម្បី ធ្វើ ការដោះស្រាយ ។
ក្នុង កិច្ចប្រជុំ នា ពេលនេះ ភាគី ទាំង សងខាង បាន ឯកភាព ព្រមព្រៀង គ្នា គោរព និង អនុវត្ត តាម លក្ខខណ្ឌ ដូច ខាងក្រោម៖
* ទី២៖ ភាគី ក្រុមហ៊ុន បុរី VIP នឹង ប្រគល់ ប័ណ្ណ កម្មសិទ្ធិ រួមទាំង ឯកសារ ផ្ទេរ កម្មសិទ្ធិ ជូន ទៅ អតិថិជន ណា ដែល បាន បង់ប្រាក់ គ្រប់ ចំនួន ១០០ % តាម កិច្ចសន្យា ក្នុង រយៈពេល ០៨ ខែ គិត ចាប់ពី ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០២២ត ទៅ ។
* ទី៣៖ ភាគី ទាំង សងខាង យល់ព្រម ជូន អាជ្ញាធរ មាន សមត្ថកិច្ច ដើម្បី តាមដាន ការអនុវត្ត ការងារ សាងសង់ របស់ ក្រុមហ៊ុន បុរី VIP ។
* ទី៤៖ ភាគី ក្រុមហ៊ុន បុរី VIP ត្រូវ បន្ត ការសាងសង់ សំណង់ ចាប់ពី ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០២២ និង អនុញ្ញាតឲ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច ចុះ ត្រួតពិនិត្យ វាយតម្លៃ ពី វឌ្ឍនភាព នៃ សំណង់ នៅ អំឡុង ដើម ខែកញ្ញា ឆ្នាំ ២០២២ ដើម្បីឲ្យ អតិថិជន បន្ត ការបង់ប្រាក់ ជូន បុរី តាម ការឯកភាព ជា រួម រវាង ក្រុមហ៊ុន បុរី VIP . អតិថិជន និង ក្រុមការងារ រដ្ឋបាល ខេត្ត ។
* ទី៥៖ ចំពោះ អតិថិជន ដែល មិន ទាន់ បាន បង់ប្រាក់ គ្រប់ ចំនួន ត្រូវ បន្ត បង់ប្រាក់ តាម កិច្ចសន្យា នៅ ពេល ដែល ក្រុមហ៊ុន បុរី VIP សាងសង់ សំណង់ សម្រេចបាន តាម សមាមាត្រ នៃ ទំហំ ទឹកប្រាក់ ដែល អតិថិជន បាន បង់ ( តាម ការវាយតម្លៃ របស់ មន្ត្រី ជំនាញ ) ។
* ទី៦៖ ភាគី ក្រុមហ៊ុន បុរី VIP និង ភាគី អតិថិជន យល់ព្រម អនុវត្ត តាម ការព្រមព្រៀង ខាងលើ ក្នុង ករណី ភាគី ណាមួយ មិន អនុវត្ត តាម ការព្រមព្រៀង ខាងលើ នេះ ភាគី នោះ សុខចិត្ត ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ៕
លោក បន្ត ថា ការនាំចេញ ម្រេច របស់ កសិករ នៅ ឆ្នាំ នេះ ងាយស្រួល ជាង ឆ្នាំ មុន បន្ទាប់ ការរាត ត្បាត ជំងឺ កូវីដ១៩ បាន ធូរស្បើយ ដោយ ទីផ្សារ ធំ របស់ កម្ពុជា គឺ វៀតណាម ដែល មាន ចំណែក នាំចេញ ម្រេច កម្ពុជា ប្រមាណ ៨០ % ក្រៅពី នោះ នាំចេញ ទៅ ថៃ និង អឺរ៉ុប ។ តែ យ៉ាងណា សម្រាប់ តម្លៃ វិញ ហាក់ មិន ប្រែប្រួល ល្អ ជាង ឆ្នាំ មុន នោះ ទេ គឺ រង្វង់ ១៣ ០០០ រៀល ក្នុង មួយ គីឡូក្រាម ។
កញ្ញា បន្ត ថា សម្រាប់ ទីផ្សារ ម្រេច និង តម្លៃ ម្រេច នៅ តំបន់ មេមត់ នៅ ឆ្នាំ នេះ ល្អ ជាង ឆ្នាំ មុន ដោយ មាន ឈ្មួញ មក ប្រមូល ទិញ ដល់ ចម្ការ សម្រាប់ នាំចេញ ។ នៅ តំបន់ មេមត់ នេះ កាលពី ឆ្នាំ មុន កសិករ លក់ ម្រេច បាន តែ ជា មធ្យម ១០០០០ រៀល ប៉ុណ្ណោះ តែ នៅ ឆ្នាំ នេះ អាច លក់ បានជា មធ្យម ជាង ១២០០០ រៀល ទៅ ១៣០០០ រៀល និង ដើម រដូវ លក់ បាន រហូត ១៥០០០ រៀល ក្នុង មួយ គីឡូក្រាម ។
របាយការណ៍ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ឱ្យដឹង ថា រយៈពេល ៥ ខែ ដើម ឆ្នាំ ២០២២ ការនាំចេញ ម្រេច សម្រេចបាន ជាង ៥ ៥៥៨ តោន ថយចុះ ២៥.៥ ភាគរយ ។ ក្នុង នោះ នាំចេញ ទៅ វៀតណាម ជាង ៥ ១៣១ តោន . អាល្លឺម៉ង់ ៣៥៥ តោន . កោះ តៃវ៉ាន់២១ តោន . ម៉ាឡេស៊ី ជាង ១៣ តោន . បារាំង ជាង ១០តោន និង ទៅ ប្រទេស មួយចំនួន ទៀត ដូចជា បែលហ្ស៊ិក ជប៉ុន ឆេក ស៊ុយ អ៊ែត កាណាដា អាមេរិក ឥណ្ឌា ចក្រភព អង់គ្លេស កាហ្សាក់ ស្ថាន កូរ៉េ និង ប្រទេស អូស្ត្រាលី ៕
ដើមឈើ ជិត ៤០០ ដើម និង ជាង ២ពាន់ ដើម ត្រូវបាន ដាំ និង ចែកជូន ពលរដ្ឋ ក្នុង ឱកាស ប្រារព្ធ ពិធី បុណ្យ រុក្ខ ទិវា ៩ កក្កដា នៅ ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក ចាន់ រ៉ាន់ អភិបាល រង ខេត្ត ព្រៃវែង តំណាង លោក ជា សុមេធី អភិបាល ខេត្ត នៅ ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ប្រារព្ធ ពិធី បុណ្យ រុក្ខ ទិវា ៩ កក្កដា ២០២២ ក្នុង នោះ រដ្ឋបាល ខេត្ត និង មន្ត្រីរាជការ បាន ដាំ កូន ឈើ ចម្រុះ ចំនួន ៣៥០ ដើម ព្រមទាំង បន្ត ចែក កូន ឈើ ជាង ២.០០០ ដើម ដល់ ប្រជាពលរដ្ឋ ដើម្បី ដាំ បន្ត ។
ពិធី នេះ មាន ការចូលរួម ពី លោក អ៊ុក សំណាង ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត និង ខណ្ខ រដ្ឋបាល ព្រៃឈើ ព្រមទាំង មន្ទីរ អង្គភាព អាជ្ញាធរ ពាក់ព័ន្ធ សិស្សានុសិស្ស ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ដែល បាន ធ្វើឡើង នៅ ស្នាក់ការសាខា កាកបាទ ក្រហម ស្រុក បាភ្នំ ក្នុង ភូមិ ឈើ កាច់ ឃុំ ឈើ កាច់ ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង ។
លោក បាន បន្ត ថា ក្នុង ទិសដៅ បន្ត វេន ដ៏ ប្រពៃ នេះ ក្រសួង កសិកម្ម ដែល មាន រដ្ឋបាល ព្រៃឈើ ជា សេនាធិការ បាន រួម សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន អង្គការ ជាតិ អន្តរជាតិ និង អង្គការ ក្រៅ រដ្ឋាភិបាល នានា លើកកម្ពស់ ស្មារតី ជុំ រុញ និង អនុវត្ត ការងារ ដាំ ឈើ ឡើងវិញ នៅលើ ដី ទំនេរ ដី ព្រៃ រិច រិល ព្រមទាំង ចលនា ប្រជាពលរដ្ឋ ដាំ ដើមឈើ នៅ គ្រប់ ទីកន្លែង ក្នុង នោះ ខេត្ត ព្រៃវែង ក៏ ជា ខេត្ត មួយ ដែល ត្រូវ ធ្វើ ការដាំដុះ ព្រៃឈើ ឡើងវិញ ផងដែរ ។
លោក អភិបាល រង ខេត្ត បាន លើកឡើង បន្ត ទៀត ថា ដើមឈើ មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ មនុស្ស សត្វ និង ផែនដី ក្នុង ការទាក់ទាញ នៅ ទឹកភ្លៀង កាត់បន្ថយ កំដៅ និង ជួយ បន្សុទ្ធ ជាតិ ពុល បង្កើន នូវ ខ្យល់ បរិសុទ្ធ សម្រាប់ មនុស្ស សត្វ នៅលើ ផែនដី យើង នេះ ។
លោក ចាន់ រ៉ាន់ ក៏ បាន អំពាវនាវ ដល់ ព្រះសង្ឃ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ បន្ត ចូលរួម ដាំ ដើមឈើ នៅ តាម ទី វត្តអារាម និង នៅ តាម ផ្ទះ ឱ្យ បាន គ្រប់ គ្នា ដើម្បី ចូលរួមចំណែក ក្នុង ការបង្កើន នៅ បរិស្ថាន នៅ តាម ទី វត្តអារាម និង នៅ តាម ផ្ទះ ក៏ ដូចជា ការចូលរួមចំណែក កាត់បន្ថយ ការកើនឡើង នូវ កំដៅ នៅលើ ផែនដី ផងដែរ ៕ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រកាស គាំទ្រ ការប្រសាសន៍ របស់ សម្តេច តេជោ ក្នុង ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស
( បន្ទាយមានជ័យ )៖ ឧប នាយក រដ្ឋមន្រ្តី កែ គឹម យ៉ាន ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ និង ជា អនុប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា បាន ប្រកាស គាំទ្រ នូវ ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា កាលពី ថ្ងៃទី១ ខែកក្កដា ឆ្នាំ ២០២២ ក្នុង ការដោះស្រាយ បញ្ហ មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
ការប្រកាស គាំទ្រ បែប នេះ របស់ ឧប នាយក រដ្ឋមន្រ្តី កែ គឹម យ៉ាន បាន ធ្វើឡើង ក្នុង ឱកាស ប្រារព្ធ ខួប លើក ទី ១៥ ទិវា អតីត យុទ្ធជន កម្ពុជា ថ្ងៃទី ២១ ខែមិថុនា ២០០៧ - ២០២២ នៅ ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២២ នៅ ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្រ្តី កែ គឹម យ៉ាន បាន ពាំនាំ នូវ ការ សួរសុខទុក្ខ និង ថ្លែងអំណរគុណ ជូនពរ ជ័យ ពី ថ្នាក់ដឹកនាំ ជាតិ ជាពិសេស សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ថ្វាយ ប្រគេន និង ជូន ចំពោះ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ បងប្អូន អតីត យុទ្ធជន គ្រួសារ អតី យុទ្ធជន ពលី មរណៈ ជន ពិការ ដោយសារ សង្រ្គាម កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ក្នុង ខេត្ត បន្ទាយមានជ័យ ទាំងអស់ សូម ជួបប្រទះ តែ នឹង សេចក្តីសុខ និង សុភមង្គល នៅក្រោម ដំបូល នៃ សន្តិភាព ។
ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្រ្តី គន់ គីម បាន ថ្លែងអំណរគុណ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ដែល តែងតែ បាន ចូលរួម ចំណែក ដឹកនាំ សមាគម អតីត យុទ្ធជន ឱ្យ បំពេញ ការងារ ពង្រឹង ពង្រីក បាន នៅ តួនាទី អតីត យុទ្ធជន កែលម្អ បាន នូវ ជីវភាព រស់ នៅ ពង្រឹង សាមគ្គីភាព ជា ធ្លុង មួយ បង្កើន ស្មារតី ជួយ គ្នា ទៅ វិញ ទៅ មក ពិសេស ក្នុង គ្រា លំបាក ជួប គ្រោះថ្នាក់ ឬ ទទួលមរណភាព ជាដើម ។
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . លោក ខេង ស៊ុម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បន្ទាយមានជ័យ . លោក អ៊ុ រាត្រី អភិបាល ខេត្ត ព្រមទាំង ថ្នាក់ដឹកនាំ ខេត្ត បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ១០០ លាន រៀល ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
នៅក្នុង សន្និសីទ សារព័ត៌មាន មួយ លោក ឡារ៉ូវ បាន ថ្លែង ថា « យើង កំពុង ស្វែងរក ការពិត ពី អំពើ ឃោឃៅ ដែល ប្រព្រឹត្ត ដោយ របប ទីក្រុង កៀវ ដើម្បី បង្ហាញ ជាសាធារណៈ ប៉ុន្តែ ប្រទេស លោក ខាងលិច បាន រារាំង មិន ឲ្យ មាន ការចេញផ្សាយ របាយការណ៍ មិន លំអៀង ស្តីពី ស្ថានភាព នៅ ទីនោះ » ។
លោក ឡារ៉ូវ បាន ពិពណ៌នា ថា គោល នយោបាយ ដ៏ គ្រោះថ្នាក់ បំផុត មួយ ដែល ដំណើរការ អស់ រយៈពេល ជាច្រើន ឆ្នាំ គឺ ដើម្បី ប្រែក្លាយ អ៊ុយក្រែន ទៅជា ប្រទេស ជ្រុលនិយម ឬ ប្រទេស ណាហ្ស៉ី ថ្មី ហើយ បង្កើត មូលដ្ឋាន យោធា នៅ ទីនោះ សម្រាប់ គំរាមកំហែង សន្តិសុខ របស់ រុស្ស៉ី ។
គួរ បញ្ជាក់ ថា ជារឿយ ៗ ប្រធានាធិបតី រុស្ស៉ី លោក វ្ល៉ាឌីមៀ ពូទីន តែង បាន សង្កត់ធ្ងន់ ចំពោះ សកម្មភាព របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន គឺ មិន មាន ផែការកាន់កាប់ ទឹកដី អ៊ុយក្រែន ឡើយ ប៉ុន្តែ គោលដៅ គឺ ដើម្បី បោស សំអាត ពួក ជ្រុលនិយម ដ៏ គ្រោះថ្នាក់ និង ជួយ រំដោះ ប្រជាជន នៅ តំបន់ ដុន បាស់ ៕
( ភ្នំពេញ ) ៖ សន្តិសុខ យាម ផ្ទះ វីឡា មួយ កន្លែង ត្រូវបាន ខ្មាន់ កាំភ្លើង មិន ស្គាល់ អត្តសញ្ញាណ ជិះ ម៉ូតូ មក បាញ់ រះ ជាច្រើន គ្រាប់ បណ្ដាលឲ្យ ស្លាប់ ភ្លាម ៗ នៅ ប៉ុស្ដិ៍ យាម ខាងមុខ ផ្ទះ ។ ហេតុការណ៍ នេះ បាន បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល នៅ វេលា ម៉ោង ២រសៀល ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ស្ថិត នៅក្នុង ផ្ទះ វីឡា មួយ កន្លែង តាម បណ្ដោយ ផ្លូវ ៣២២ សង្កាត់ បឹងកេងកង១ ខណ្ឌ បឹងកេងកង ។
យ៉ាងណាមិញ មូលហេតុ នៃ អំពើ បាញ់ប្រហារ នេះ មិន ទាន់ ត្រូវបាន គេ ដឹង នៅឡើយ ទេ ។ ប៉ុន្ដែ នៅ កន្លែង កើត ហេតុ ត្រូវបាន គេ បញ្ជាក់ ថា បណ្ដាលឲ្យ ជនរងគ្រោះ ម្នាក់ អាយុ ប្រហែល ៥០ ឆ្នាំ បាន ស្លាប់ ក្នុង ថ្លុក ឈាម ។
សេចក្ដីរាយការណ៍ ជំហាន ដំបូង អះអាង ថា ខ្មាន់ កាំភ្លើង បាន បាញ់ រះ ទៅ ជនរងគ្រោះ ប្រមាណ ១០គ្រាប់ ហើយ ជិះ ម៉ូតូ គេចខ្លួន បាត់ ។ នៅ ពេល នេះ សមត្ថកិច្ច ជំនាញ ជាច្រើន នាក់ បាន ចុះ ទៅដល់ កន្លែង កើត ហេតុ និង កំពុង ធ្វើ កោសល្យវិច្ច័យ ស្រាវជ្រាវ បន្ដ ទៀត ៕
បើ តាម ការរំពឹងទុក ច្បាប់ នោះ ទំនងជា នឹង ត្រូវ អនុម័ត កំលុង សម័យ ប្រជុំ បច្ចុប្បន្ន របស់ សភា អង់គ្លេស តាមរយៈ ការធ្វើ វិសោធនកម្ម មួយ ដើម្បី ចង ភ្ជាប់គ្នា រវាង ច្បាប់ សន្តិសុខ ជាតិ ហើយនិង ច្បាប់ សុវត្ថិភាព អនឡាញ ។ រីឯ និយតករ ផ្នែក ព័ត៌មាន របស់ អង់គ្លេស ហៅ ថា អូហ្វ ខុម (Ofcom) នឹង រៀបចំ ក្រម ប្រតិបត្តិ ដើម្បី ជួយ ក្រុមហ៊ុន បណ្តាញ សង្គម ឱ្យ គោរព តាម ច្បាប់ ថ្មី នោះ ហើយ អូហ្វ ខុម ក៏ នឹង មាន អំណាច ដើម្បី ចេញការផាកពិន័យ ចំពោះ ក្រុមហ៊ុន ដែល ល្មើស ច្បាប់ ផងដែរ ។
គួរ បញ្ជាក់ ថា ក្រោយ ការធ្វើតេស្ត លើ គ្រាប់ កាំភ្លើង ដែល បាន បាញ់ សម្លាប់ លោកស្រី Abu Akleh ជា ពលរដ្ឋ អាមេរិក ដើមកំណើត ប៉ាឡេ ស្ទីន ដែល ប្រព្រឹត្តទៅ ក្រោម វត្តមាន ក្រុម អ្នកជំនាញ មកពី អាមេរិក លទ្ធផល បាន បង្ហាញ ថា ការបាញ់ប្រហារ មកពី ខាង អ៉ី ស្រាអែល ទំនងជា មូលហេតុ ដែល បណ្តាលឱ្យ លោកស្រី Abu Akleh បាត់បង់ជីវិត ប៉ុន្តែ មិន មាន ការរកឃើញ ថា ការបាញ់ សម្លាប់ នេះ គឺជា ទង្វើ ដោយ ចេតនា របស់ អ៉ី ស្រាអែល នោះ ទេ ៕
