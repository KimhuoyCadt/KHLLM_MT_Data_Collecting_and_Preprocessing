( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . លោក ឧកញ៉ា ថោង សារ៉ាត់ និង លោកជំទាវ ទាវ ធីតា បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ៥ម៉ឺន ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
ការអំពាវនាវ របស់ សម្តេច ធ្វើឡើង បន្ទាប់ពី សម្តេច ទទួលបាន របាយការណ៍ ពី ស្ថានភាព នៃ ការគំរាមកំហែង យ៉ាង ខ្លាំង ដោយ គ្រាប់ មីន ចំពោះ ប្រជាពលរដ្ឋ ក្នុង ឱកាស សម្តេច អញ្ជើញ លែង កូន ត្រី នៅ ឃុំ ប៉ោយ ចារ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ នៅ ព្រឹក ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២២៕ វិទ្យាស្ថាន បណ្ដុះបណ្ដាល ពាណិជ្ជកម្ម និង ស្រាវជ្រាវ រៀបចំ សិក្ខាសាលា ស្ដីពី ការចូលរួម របស់ និសិ្សត ក្នុង ការសិក្សា ស្រាវជ្រាវ វិស័យ ពាណិជ្ជកម្ម នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២២ វិទ្យាស្ថាន បណ្ដុះបណ្ដាល ពាណិជ្ជកម្ម និង ស្រាវ ជា្រវ បាន រៀបចំ សិក្ខាសាលា ស្ដីពី « ការចូលរួម របស់ និសិ្សត ក្នុង ការសិក្សា ស្រាវជ្រាវ វិស័យ ពាណិជ្ជកម្ម នៅ កម្ពុជា » ក្រោម អធិបតីភាព លោកស្រី ចម និម្មល រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម តំណាង លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ដោយ មាន ការចូលរួម ពី និសិ្សត សាស្រ្តាចារ្យ ចំនួន ១៥០ នាក់ ដែល មកពី សាកលវិទ្យាល័យ ចំនួន ១០ ក្នុង រាជធានី ភ្នំពេញ ។
វគ្គ សិក្ខាសាលា នេះ មាន គោលបំណង ផ្តល់ នូវ ចំណេះដឹង អំពី ដំណើរការចរចា និង អត្ថប្រយោជន៍ នៃ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា ការពង្រឹង សមត្ថភាព ស្រាវជ្រាវ ដើម្បី ផ្ដល់ ឱកាស ដល់ អ្នកសិក្សា ស្រាវជ្រាវ ទាំង ក្នុង និង ក្រៅ ក្របខ័ណ្ឌ ក្រសួង ពាណិជ្ជកម្ម ក្នុង ការផ្សព្វផ្សាយ និង ចែករំលែក បទពិសោធន៍ ចំណេះដឹង និង មតិ យោបល់ ក្នុង ការជំរុញ វិស័យ ពាណិជកម្ម នៅ កម្ពុជា ។
ក្នុង ន័យ នេះ វិទ្យាស្ថាន ដែល ជា សេនាធិការ របស់ ក្រសួង បាន និង កំពុង ដើរ តួនាទី ស្នូល ក្នុង ការពង្រឹង កិច្ចការ ស្រាវ ជា្រវ និង បណ្ដុះបណ្ដាល ទាំង ក្នុង ក្របខ័ណ្ឌ មន្ត្រីរាជការ បណ្ដា ធុរ ជន និង បញ្ញា វន្ត អ្នកស្រាវជ្រាវ ដើម្បី គាំទ្រ ការអនុវត្ត គោល នយោបាយ ច្បាប់ និង បទប្បញ្ញត្តិ ទាំងនេះ ប្រកបដោយ ប្រសិទ្ធភាព និង បរិយាប័ន្ន ខ្ពស់ ។
សូម បញ្ជក់ ផងដែរ ថា iTrade Bulletin គឺជា គម្រោង ថ្មី មួយ របស់ វិទ្យាស្ថាន ដែល ធ្វើ ការប្រមូលផ្តុំ និង បោះពុម្ភផ្សាយ នូវ បណ្តុំ អត្ថបទ ស្រាវជ្រាវ សំខាន់ ៗ ពាក់ព័ន្ធ នឹង វិស័យ ពាណិជ្ជកម្ម ដែល ធ្វើ ការបោះពុម្ភផ្សាយ ឈរ លើ គោលការណ៍ គុណភាព ឯករាជ្យភាព និរន្តភាព និង ភាពជា ស្នាដៃ ដើម ។
បន្ថែម ពី នេះ គម្រោង iTrade Bulletin ជា ឱកាស សម្រាប់ និសិ្សត ចូលរួម វគ្គ បណ្តុះបណ្តាល ស្រាវជ្រាវ ជាមួយ វិទ្យាស្ថាន ក្នុង ការយល់ដឹង ពី របៀប នៅក្នុង សិក្សា ស្រាវជ្រាវ ការប្រមូល និង វិភាគ ទិន្នន័យ ដើម្បី បង្កើត និង អនុវត្ត គោល នយោបាយ សម្រាប់ មន្រ្តី រាជការ ក្រសួង ពាណិជ្ជករ វិនិយោគិន និស្សិត និង សាធារណជន ទូទៅ យក ទៅ ប្រើប្រាស់ ជា អត្ថប្រយោជន៍ ក្នុង ការគ្រប់គ្រង អាជីវកម្ម ការសិក្សា របស់ ខ្លួន និង លើកស្ទួយ វិស័យ ពាណិជ្ជកម្ម នៅ កម្ពុជា ។
លើស ពី នេះ និស្សិត និង អ្នកសិក្សា ស្រាវជ្រាវ ក៏ អាច ចែករំលែក ជា អត្ថបទ វិចារណក ថា និង បទ វិភាគ សម្រាប់ ការបោះពុម្ភផ្សាយ ដោយ ផ្តល់ ជា ការលើកទឹកចិត្ត តាមរយៈ ការទទួលស្គាល់ ស្នាដៃ ការពង្រឹង សមត្ថភាព ស្រាវជ្រាវ ដល់ និស្សិត ឱកាស ការងារ កម្មសិក្សា ព័ត៌មាន អាហារូបករណ៍ និង ការផ្តល់ ជា រង្វាន់ នានា ៕
សមាគម ជំរុញ ឧស្សាហកម្ម វប្បធម៌ និង ទេសចរណ៍ កម្ពុជា - ចិន ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ ជូន ដល់ សិស្សសាលា មធ្យម វិចិត្រ សិល្បៈ ក្នុង ការបង្កើត ស្នាដៃ ថ្មី
( ភ្នំពេញ ) ៖ សមាគម ជំរុញ ឧស្សាហកម្ម វប្បធម៌ និង ទេសចរណ៍ កម្ពុជា - ចិន នៅ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នា២០២២ បាន ចុះ ជួប សំណេះសំណាល និង ឧបត្ថម្ភ ថវិកា ចំនួន ១០.០០០ ដុល្លារ អាមេរិច ជូន ដល់ សិស្សសាលា មធ្យម វិចិត្រ សិល្បៈ ក្នុង ការបង្កើត ស្នាដៃ ថ្មី ។
ពិធី ប្រគល់ និង ទទួល បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត ហ៉ឺ វីរៈ រដ្ឋលេខាធិការ តំណាង លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា រដ្ឋមន្រ្តី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង ប្រធាន សមាគម ជំរុញ ឧស្សាហកម្ម វប្បធម៌ និង ទេសចរណ៍ កម្ពុជា - ចិន នៅ សាលា មធ្យម វិចិត្រ សិល្បៈ ។
សមាគម ជំរុញ ឧស្សាហកម្ម វប្បធម៌ និង ទេសចរណ៍ កម្ពុជា - ចិន ក៏ ជួយ សម្ភារ ផ្នែក ល្ខោន បាសាក់ និង ទិញ ម៉ូតូ ចំនួន ១គ្រឿង និង កង់ ចំនួន ៤០ គ្រឿង សម្រាប់ ចែកជូន ដល់ សិស្ស ដែល មាន ជីវភាព ក្រីក្រ ខ្វះខាត ក្នុង ពេល សិក្សា ។ ចំណែកឯ លោក បណ្ឌិត ហ៉ឺ វីរៈ បាន ឧត្ថម្ភ សិស្សសាលា មធ្យម វិចិត្រ សិល្បៈ ចំនួន ១លាន រៀល ផងដែរ ។
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . អ្នក ឧកញ៉ា ឃុន សៀ ប្រធាន ក្រុមហ៊ុន ធី ភី ម៉ូរ៉ា គ្រុប ឯ . ក បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ៥០ម៉ឺន ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ ថ្លែងអំណរគុណ កាកបាទ ក្រហម កម្ពុជា ដែល ចូលរួម បរិច្ចាគ ថវិកា ២លាន ដុល្លារ គាំទ្រ ការបោសសំអាត មីន និង គ្រាប់ មិន ទាន់ ផ្ទុះ នៅ កម្ពុជា
សម្តេច តេជោ ហ៊ុន សែន បាន សម្ដែង ការកោតសរសើរ ដោយ ស្មោះ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ស្មារតី រួមចំណែក ដ៏ មាន អត្ថន័យ ជ្រាលជ្រៅ របស់ កាកបាទ ក្រហម កម្ពុជា ដែល ពិតជា បាន ផ្ដល់ នូវ សេចក្តីសុខ និង ភាពសុខសាន្ត ព្រមទាំង ស្នាមញញឹម ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស និង បាន ជូន ពរ ឱ្យ ជាប់ ប្រទះ តែ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
( ភ្នំពេញ ) ៖ លោក ច្រឹក សុខ នីម ប្រធាន សមាគម អ្នក វាយតម្លៃ និង ភ្នាក់ងារ អចលន វត្ថុ កម្ពុជា បាន ឲ្យដឹង ថា ការលក់ អចលន ទ្រព្យ តម្លៃ ក្រោម ទីផ្សារ ហាក់ កើនឡើង នា ពេល ថ្មី ៗ នេះ ប៉ុន្ដែ មិន បាន ផ្ដល់ ផល ប៉ះពាល់ ដល់ វិស័យ អចលន ទ្រព្យ ឡើយ ដោយសារតែ កម្រិត នៃ ការលក់ មាន ភាពតូច ប៉ុណ្ណោះ មិន តែ ប៉ុណ្ណោះ សន្ទុះ នៃ ការលក់ នេះ បាន ជួយ ជំរុញ ចរន្ដ លក់ ឲ្យ កាន់តែ ផុស ផុល ថែម ទៀត ។
លោក បន្ដ ទៀត ថា ទោះជា យ៉ាង នេះ ក្ដី បើ ការលក់ អចលន ទ្រព្យ តម្លៃ ក្រោម ទីផ្សារ បន្ដ រយៈពេល យូរ និង មាន ទំហំ ធំ នោះ នឹង ផ្ដល់ ផល ប៉ះពាល់ ចំពោះ វិស័យ អចលន ទ្រព្យ ទាំងមូល ដោយ អាច ឈានដល់ ការដួលរលំ ឬ ការជាប់គាំ ដោយ ប្រការ ណាមួយ ជា ពុំ ខាន ប៉ុន្ដែ បើ ស្ថិត ក្នុង ទំហំ តូច ដូច ពេល បច្ចុប្បន្ន នេះ មិន ត្រឹមតែ មិន ផ្ដល់ ផល ប៉ះពាល់ នោះ ទេ ថែមទាំង ផ្ដល់ អត្ថប្រយោជន៍ ទៀតផង ។
លោក បាន បន្ដ ថា « រហូតមកដល់ ពេលនេះ ខ្ញុំ មិន ទាន់ មើលឃើញ ពី ការធ្លាក់ ថ្លៃ នៃ វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា នោះ ឡើយ ប៉ុន្ដែ ការលក់ តម្លៃ ក្រោម ទីផ្សារ គឺ មាន ដោយសារតែ ជា តម្រូវ ការចាំបាច់ និង ផ្ទាល់ខ្លួន របស់ សាធារណជន ដែល ត្រូវ បង្ខំ លក់ ដើម្បី ដោះស្រាយ បញ្ហា ជីវភាព ឬ ការទូរទាត់ ចាំបាច់ ដែល មិន អាច អាកខាន បាន » ។
រាជ រដ្ឋាភិបាល បាន ព្យាករ ថា វិស័យ អចលន ទ្រព្យ រំពឹង ថា នឹង បន្ត ងើបឡើង ក្នុង អត្រា ៥.២ភាគរយ ក្នុង ឆ្នាំ ២០២៣ ដោយសារ ការរំពឹងទុក នូវ ការ ងើប ឡើងវិញ នៃ សកម្មភាព ទិញ - លក់ និង ជួល អចលន ទ្រព្យ ថ្លៃ ខ្ពស់ ខុនដូ និង អាផាតមិន ស្រប ពេល ការវិនិយោគ និង តម្រូវការ ក្នុង ស្រុក លើ អចលន ទ្រព្យ ផ្នែក លំនៅឋាន ថ្លៃ ទាប និង មធ្យម ត្រូវបាន រំពឹងទុក ថា បន្ត រក្សា កំណើន ល្អ ។
ក្នុង នោះ ផងដែរ លោក ឧកញ៉ា ចេង ខេង អគ្គ នាយក ក្រុមហ៊ុន អចលន ទ្រព្យ CPL បាន លើកឡើង ថា ដោយសារតែ ការបើកប្រទេស ឡើងវិញ សកម្មភាព សេដ្ឋកិច្ច នានា ចាប់ផ្ដើម ដំណើរការ ការទិញ ដូរ អចលន ទ្រព្យ ចាប់ផ្ដើម មាន ហូរហែ ឡើងវិញ ចំណែក វិនិយោគិន បរទេស ក៏ ចាប់ផ្ដើម ចូលមក ជា បណ្ដើរ ៗ ធ្វើឲ្យ មាន សកម្មភាព ទិញ លក់ដូរ ជាច្រើន ៕ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ ថ្លែងអំណរគុណ អ្នក ឧកញ៉ា គិត ម៉េង និង លោកជំទាវ ដែល ចូលរួម បរិច្ចាគ ថវិកា ១លាន ដុល្លារ គាំទ្រ ការបោសសំអាត មីន និង គ្រាប់ មិន ទាន់ ផ្ទុះ នៅ កម្ពុជា
អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ និង លោកជំទាវ ប្រកាស បរិច្ចាគ ថវិកា ១លាន ដុល្លារ ជូន រាជ រដ្ឋាភិបាល ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ និង លោកជំទាវ ប្រកាស បរិច្ចាគ ថវិកា ១លាន ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
កំណើន ចំនួន ភ្ញៀវ ទេសចរ បរទេស នេះ បង្ហាញ ពី សញ្ញា ល្អ នៃ ការវិលត្រឡប់ របស់ ភ្ញៀវ ទេសចរ បន្ទាប់ពី អាក់ខាន ដើរ ហើរ អស់ រយៈពេល ជាង ២ ឆ្នាំ ដោយសារ វិបត្តិ នៃ ជំងឺ រាតត្បាត កូវីដ១៩ ៕ មិន ត្រូវ បើកបរ លើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៦នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០១ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ០១ ខែកក្ត ដា ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ០៨៧. ៨៥៧ នាក់ ។ ក្នុង នោះ រួម មាន៖
លោក គង់ គឹម នី បាន បញ្ជាក់ ថា អាជ្ញាធរ ខេត្ត ក្រចេះ នឹង ចាត់ វិធានការក្តៅ លើ មេ ខ្យល់ និង បក្ខពួក ដែល បាន កៀង គរ ពលរដ្ឋ ចូលមកកាប់ រៀន ដី របស់ រដ្ឋ ។ ការអះអាង របស់ អាជ្ញាធរ ធ្វើឡើង បន្ទាប់ពី មាន ពលរដ្ឋ ជាច្រើន គ្រួសារ មាន កាន់ កាំបិត ពូ ថៅ វាស់វែង ដី ជាដើម បាន ប្រមូល គ្នា ចូលកាប់ ទន្ទ្រាន ដី សម្បទាន សេដ្ឋកិច្ច របស់ ក្រុមហ៊ុន CHPB និង វាស់វែង បោះ បង្គោល ព្រំ ក្បាល ដី ចែក គ្នា ធ្វើជា កម្មសិទ្ធិ ដោយ ពលរដ្ឋ ទាំងនោះ សំអាង ថា ដី នេះ ជា ដី របស់ រដ្ឋ ។
លោក បាន លើកឡើង ថា ក្នុង នាម ជា អាជ្ញាធរ ខេត្ត មិន បណ្ដែតបណ្ដោយ ឲ្យ បុគ្គល រូប នេះ និង បក្ខពួក ធ្វើ សកម្មភាព តាម តែ ចិត្ត ចង់បាន តាម អំពើចិត្ត បាន ឡើយ ។ លោក ថា យើង ត្រូវ អនុវត្ត ទៅ តាម បរិបទ សង្គម និង បរិបទ មាតុភូមិ តើ ត្រូវ ដោះស្រាយ ឬ សម្របសម្រួល បែប ណា ឲ្យ ច្រើន ជាង ការអនុវត្ត ច្បាប់ ពោលគឺ ដោះស្រាយ បញ្ហា ពី ធំ បង្រួម ទំនាស់ ពង្រីក ការដោះស្រាយ ។
សូម បញ្ជាក់ ថា ក្រុមហ៊ុន ស៊ី អេច ភី ប៊ី ឌីវេឡុប មេន បាន ទទួលគោលការណ៍ អនុញ្ញាត វិនិយោគ ដី សម្បទាន សេដ្ឋកិច្ច ពី រាជ រដ្ឋាភិបាល លើ ផ្ទៃដី ទំហំ ៨. ៦៨៦ ហិកតា តាម លិខិត លេខ ៥១០ ស ជណ ចុះ ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០០៨ របស់ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី នៅសល់ ផ្ទៃដី ប្រហែល ២. ៦៨៦ហិកតា ។
អាជ្ញាធរ ភូមិ ឃុំ បាន ស្នើសុំ ឲ្យ អាជ្ញាធរ ខេត្ត ឲ្យ មាន ចំណាត់ការ យ៉ាង ម៉ឹង ម៉ាត់ ទៅ លើ បុគ្គល ឈ្មោះ កែន អុល និង បក្ខពួក ដែល កំពុងតែ កាប់ ទន្ទ្រាន យក ដី ក្រុមហ៊ុន យ៉ាង អនាធិបតេយ្យ ដោយ ដើរ ប្រមូល យក លុយ ពី ប្រជាពលរដ្ឋ ជា ថ្នូរ ក្នុង ១ ក្បាល ដី ទំហំ ៥០ម៉ែត្រ តម្លៃ ចាប់ពី ១លាន ទៅ៣ លាន រៀល និង ជេរ ប្រមាថ មក លើ អាជ្ញាធរ ដោយ ចោទ ថា យក ដី លក់ ឲ្យ ក្រុមហ៊ុន ថែមទាំង អះអាង ថា ខ្លួន ជា អ្នក រំដោះ ដី យក ចែកជូន ឲ្យ ប្រជាពលរដ្ឋ ដែល ខ្វះខាត ដី ថែម ទៀត ផង ។
អាជ្ញាធរ ខេត្ត បាន បញ្ជាក់ ទៀត ថា ករណី ប្រជាពលរដ្ឋ ក្រីក្រ អត់ ដី ខ្វះខាត់ ដី សម្រាប់ ប្រកបរបរ កសិកម្ម ជា លក្ខណៈ គ្រួសារ ពិតប្រាកដ សូមអញ្ជើញ ដាក់ពាក្យ ស្នើរ សុំ ដី សម្បទាន សង្គមកិច្ច នៅ តាម ភូមិ ឃុំ ដើម ដែល ខ្លួន រស់ នៅ ហើយ គណៈកម្មាធិការ ប្រើប្រាស និង បែងចែក ដី ថ្នាក់ ខេត្ត បាន កំណត់ ទីតាំង ដី សម្បទាន សង្គមកិច្ច ស្ថិត នៅ ភូមិ ស្រែ ភ្នី ឃុំ កំពង់ចាម ស្រុក សំបូរ ខេត្ត ក្រចេះ ៕
