( នូវ៉ែលហ្សេឡង់ ) ៖ សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ចំនួន ៣ទីក្រុង រួម មាន នៅ រដ្ឋធានី វែល្លីង តុន ទីក្រុង ផាម មើស្តុនណតស៍ និង ទីក្រុង ក្រៃឈើ ច ប្រទេស នូវ៉ែ លហ្សេឡង់ នៅ ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន រៀបចំ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៧១ ថ្ងៃ បង្កើត គណបក្ស ប្រជាជន កម្ពុជា ( ២៨ មិថុនា ១៩៥១ - ២៨ មិថុនា ២០២២ ) ក្នុង រដ្ឋធានី វែល្លីង តុន ។
ពិធី នេះ ដឹកនាំ ដោយ លោក បណ្ឌិត គឹម សន្តិភាព សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស និង ជា ប្រធាន ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស នៅ ប្រទេស អូស្ត្រាលី និង នូវ៉ែលហ្សេឡង់ និង លោក ចាន់ រតនា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រចាំ ប្រទេស អូស្ត្រាលី និង នូវ៉ែលហ្សេឡង់ ។
ព្រមទាំង មាន ការចូលរួម ពី លោក វង្ស ប៊ុន ឥន្ទ្រា វុធ អនុប្រធាន ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស នៅ ប្រទេស អូស្ត្រាលី និង នូវ៉ែលហ្សេឡង់ និង ជា ប្រធាន តំបន់ ៩ លោក លោក លោកស្រី កញ្ញា ដែល ជា អនុប្រធាន សមាជិក - សមាជិកា នៃ ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង គណៈកម្មាធិការ សាខា គណបក្ស និង ក្រុមការងារ យុវជន ជាច្រើន រយ នាក់ ផងដែរ ៕ យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៥ ខែមិថុនា៖ បង្ក្រាប ១៨ករណី ឃាត់ខ្លួន ៣៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៦ករណី . ដឹកជញ្ជូន រក្សាទុក ២ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣៥ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៣. ១១០ ករណី ឃាត់ មនុស្ស ៧. ៣៨០ នាក់ ( ស្រី ៤៥០ នាក់ )៕ លោក បណ្ឌិត អ៉ិត សំហេង ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា គណបក្ស ប្រចាំ ខេត្ត ឆៈ ឈើង សៅ ប្រទេស ថៃ
( ថៃ )៖ ដើម្បី ចូលរួម អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៧១ ថ្ងៃ បង្កើត គណបក្ស ប្រជាជន កម្ពុជា លោក បណ្ឌិត អ៉ិត សំហេង ប្រធាន ក្រុមការងារ កសាង ពង្រឹង គណបក្ស ប្រចាំ ប្រទេស ថៃ នា ព្រឹក ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ បាន អញ្ជើញ ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា គណបក្ស ប្រចាំ ខេត្ត ឆៈ ឈើង សៅ ប្រទេស ថៃ ដោយ មាន ការចូលរួម ពី តំណាង សមាជិក សមាជិកា សាខា គណបក្ស ទូទាំង ប្រទេស ថៃ ប្រមាណ ជាង ៥០០ នាក់ ។
ក្នុង នាម ក្រុមការងារ កសាង ពង្រឹង គណបក្ស ប្រជាជន កម្ពុជា ប្រចាំ ប្រទេស ថៃ លោក បណ្ឌិត អ៉ិត សំហេង បាន សម្តែង នូវ ការគោរព និង ដឹងគុណ ជា ទីបំផុត ចំពោះ បងប្អូន ជន រួម ជាតិ នៅ គ្រប់ ទិសទី ដែល តែងតែ គាំទ្រ និង ជឿជាក់ លើ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ធ្វើឲ្យ គណបក្ស បាន សម្រេច ជោគជ័យ ដ៏ ត្រចះត្រចង់ ក្នុង ការបំពេញ បេសកកម្ម បម្រើ ជាតិ រយៈពេល ៤៣ ឆ្នាំ មក នេះ ។
លោក បាន បន្ថែម ថា រាល់ សមិទ្ធផល ដែល គណបក្ស បាន សម្រេច ជូន ជាតិ ក្នុង រយៈពេល ៤៣ ឆ្នាំ មក នេះ គឺ អាស្រ័យ ដោយ គណបក្ស មាន ភាពត្រឹមត្រូវ ខាង នយោបាយ មាន ការគាំទ្រ ពេញ ទំហឹង ពី ប្រជាជន មាន រចនាសម្ព័ន្ធ រឹងមាំ និង ធនធាន មនុស្ស ប្រកបដោយ គុណធម៌ និង សមត្ថភាព មាន សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង រឹងមាំ និង របៀបរបប ធ្វើ ការងារ ត្រឹមត្រូវ ។
គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ ភាពឈ្លាសវៃ និង ប៉ិនប្រសព្វ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស និង ជា នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ស្តារ និង អភិវឌ្ឍ ប្រទេសជាតិ រហូត ទទួលបាន ការរីកចម្រើន ឥត ឈប់ឈរ លើ គ្រប់ វិស័យ ។
២០ ឆ្នាំ ក្រោយ ប្រទេស BRICS បាន ក្លាយជា ក្បាល ម៉ាស៊ីន ដ៏ សំខាន់ នៃ កំណើន សេដ្ឋកិច្ច ទូទាំង ពិភពលោក បច្ចុប្បន្ន នេះ ប្រទេស BRICS មាន ចំនួន ២៥ % នៃ ទំហំ សេដ្ឋកិច្ច សរុប ទូទាំង ពិភពលោក ១៨% នៃ ទំហំ ពាណិជ្ជកម្ម និង ២៥% នៃ ការវិនិយោគ បរទេស ។ យន្តការសហប្រតិបត្តិការ BRICS គឺជា វេទិកា ដ៏ សំខាន់ នៃ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទីផ្សារ ដែល កំពុង រីកចម្រើន និង ប្រទេស កំពុង អភិវឌ្ឍន៍ បច្ចុប្បន្ន នេះ កិច្ចសហប្រតិបត្តិការ BRICS បាន ឈានចូល ដំណាក់កាល ថ្មី នៃ ការអភិវឌ្ឍ ប្រកបដោយ គុណភាព ខ្ពស់ ។
សង្ឃឹម ថា សហគ្រិន នឹង បន្ត នូវ ស្មារតី ឈាន នៅ ជួរ មុខ យ៉ាង ក្លាហាន ធ្វើជា អ្នកជំរុញ ការអភិវឌ្ឍន៍ បើក ទូលាយ អ្នកដឹកនាំ ក្នុង ការច្នៃប្រឌិត និង ការអភិវឌ្ឍ អ្នកចែករំលែក ការអភិវឌ្ឍ ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ BRICS ៕
ប៉ុន្មាន ឆ្នាំ មក នេះ ខ្ញុំ បាន ធ្វើដំណើរ ទៅដល់ ទីក្រុង និង ទី ជនបទ ទូទាំង ប្រទេស ចិន ហើយ បាន ធ្វើ ទស្សនកិច្ច នៅ ប្រទេស ជាច្រើន ។ ខ្ញុំ មានអារម្មណ៍ យ៉ាង ជ្រាលជ្រៅ ថា មាន តែ ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ទើប អាច សម្រេចបាន នូវ ក្តី សុបិន របស់ ប្រជាជន ចំពោះ ជីវភាព រស់ នៅ ដ៏ សម្បូរសប្បាយ និង សង្គម ដ៏ សុនសាន្ត ៕
យុវជន ខ្វះខាត មា្នក់ ទទួលបាន ម៉ូតូ និង ទូរស័ព្ទ ថ្មី ពី ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក រវៀង ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ យុវជន ម្នាក់ ដែល មាន ជីវភាព ក្រីក្រ ខ្វះខាត រស់ នៅ ភូមិ រំចេក ឃុំ រម្មណីយ៍ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ទទួលបាន ម៉ូតូ១ គ្រឿង ទូរស័ព្ទ១ គ្រឿង និង ថវិកា មួយ ចំនួន ពី លោក ជា សែ ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ។
យុវជន ទេព វិចិត្រ ក៏ បាន ថ្លែងអំណររគុណ ដល់ លោក ជា សែ និង ក្រុមគ្រួសារ ដែល បាន ផ្តល់ ម៉ូតូ ទូរស័ព្ទ និង ថវិកា ដល់ រូបលោក ។ យុវជន រូប នេះ ថា « ក្នុង មួយ ជីវិត ខ្ញុំ នេះ មិន អាច ភ្លេច គុណ លោក ជា សែ និង ក្រុមគ្រួសារ បាន ទេ ពិសេស គឺ មិន អាច បំភ្លេច គុណ គណបក្ស ប្រជាជន កម្ពុជា ហើយ សូម ជូនពរ លោក ជា សែ និង ក្រុមគ្រួសារ សូម ជួប តែ សេចក្តីសុខ សុភមង្គល ត រៀង ទៅ » ៕
សាលា ភូមិន្ទ រដ្ឋបាល និង អាជ្ញាធរ មូលដ្ឋាន ស្រុក ចិត្រ បុរី បើក យុទ្ធនាការដាំ កូន ឫស្សី ផ្អែម ជាង ១ ពាន់ ដើម
( ក្រចេះ ) ៖ លោក យក់ ប៊ុន ណា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង មុខងារ សាធារណៈ និង ជា នាយក សាលា ភូមិន្ទ រដ្ឋបាល នៅ ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ ក្រុមការងារ អញ្ជើញ ចុះ ពិនិត្យមើល សមិទ្ធផល នានា និង បើក យុទ្ធនាការ សហគមន៍ បៃតង ដាំ កូន ឫស្សី ផ្អែម ជាង ១ ពាន់ ដើម ស្ថិត ក្នុង ឃុំ ច ង្ក្រង់ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
ការចុះ ពិនិត្យមើល សមិទ្ធផល នានា និង ដាំ ដើម ឫស្សី ផ្អែម ដោយ មាន ការចូលរួម ពី លោក យិន វណ្ណៈ អភិបាល ស្រុក ចិត្រ បុរី អភិបាល រង ស្រុក អាជ្ញាធរ មូលដ្ឋាន លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង មាតាបិតា សិស្ស ជាង ៥០០ នាក់ ។
លោក យក់ ប៊ុន ណា បាន ដឹកនាំ មន្ត្រី ក្រម ការងារ នៃ សាលា ភូមិន្ទ រដ្ឋបាល ប្រជាពលរដ្ឋ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ដាំ កូន ឫស្សី ផ្អែម ចំនួន ១ ពាន់ ដើម នៅក្នុង បរិវេណ សាលា បឋមសិក្សា ត្រពាំង ទ្រាំង និង ក្នុង ភូមិ ល្អ និង បាន ចែក ពូជ កូន ឫស្សី ផ្អែម ដល់ ប្រជាពលរដ្ឋ ស្ថិត ក្នុង ឃុំ ច ង្ក្រង់ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។ បន្ទាប់ពី ដាំ កូន ឫស្សី ផ្អែម រួច មក លោក ក៏ បាន អញ្ជើញ ចុះ ពិនិត្យមើល សមិទ្ធផល នានា នៅ សាលា បឋមសិក្សា ត្រពាំង ទ្រាំង ។
លោក បញ្ជាក់ ថា តាមរយៈ មូនិធិ កម្មវិធី មនុស្សធម៌ ដើម្បី ការងារ សង្គម នៃ សាលា ភូមិន្ទ រដ្ឋបាល បាន ផ្ដល់ ទីតាំង ផ្ទៃដី ទំហំ ៣. ២០ ហិកតា ដល់ អាជ្ញាធរ មូលដ្ឋាន ព្រមទាំង បាន សាងសង់ អគារ ស្នាក់ នៅ ម្រាប់ គ្រូបង្រៀន ១ខ្នង ចំនួន ៧ បន្ទប់ បន្ទប់ អនាម័យ ២បន្ទប់ ស្រះ ទឹក ១កន្លែង អណ្តូង ទឹក១ និង អគ្គីសនី ប្រើប្រាស់ ដោយ ពន្លឺ ព្រះអាទិត្យ ឬ ផ្ទាំង សូរ ឡា ដែល បច្ចុប្បន្ន សាងសង រួចរាល់ ជា ស្ថាពរ ។
លោក នាយក បាន បញ្ជាក់ បន្ថែម ថា នេះ គឺជា ការចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ ក៏ ដូចជា ចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍន៍ នៅក្នុង សហគមន៍ ទាំងមូល ឲ្យ កាន់តែ រីកចម្រើន ។
សូម បញ្ជាក់ ថា ក្នុង កម្មវិធី នោះ លោក យក់ ប៊ុន ណា ព្រមទាំង ក្រុមការងារ នៃ សាលា ភូមិន្ទ រដ្ឋបាល ចែកជូន នូវ សម្ភារៈ សិក្សា មួយចំនួន ដល់ ក្មួយ ៗ សិស្សានុសិស្ស និង ឧបត្ថម្ភ ថវិការ ដល់ លោកគ្រូ អ្នកគ្រូ ម្នាក់ ចំនួន ៣ម៉ឺន រៀល ចំពោះ អ្នកគ្រូ មាន ផ្ទៃពោះ ឧបត្ថម្ភ ១០ម៉ឺន រៀល ៕ កម្មករ កម្មការិនី ជិត ៣០នាក់ រងរបួស ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ក្រឡាប់ រថយន្ត នៅ ស្រុក ឧដ្ដុង្គ ខេត្ត កំពង់ស្ពឺ . អភិបាល ខេត្ត អំពាវនាវ ម្ចាស់ រថយន្ត ឱ្យ ប្រុងប្រយ័ត្ន ខ្ពស់ ពេល បើកបរ
( កំពង់ស្ពឺ ) ៖ យ៉ាងហោចណាស់ មាន កម្មករ កម្មការិនី ចំនួន ២៧ នាក់ ក្នុង ចំណោម កម្មករ ៥០ នាក់ បាន រងរបួស ធ្ងន់ និង ស្រាល ក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ក្រឡាប់ រថយន្ត នៅ វេលា ម៉ោង ៦ និង ១៥នាទី ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ នៅ ចំណុច ភូមិ ពពូល ឃុំ ជំពូរ ព្រឹក្ស ស្រុក ឧដ្ដុង្គ ខេត្ត កំពង់ស្ពឺ ។
ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បាន កើតឡើង រវាង រថយន្ត ដឹក កម្មករ១ គ្រឿង ម៉ាក កូរ៉េ ចំណុះ ២តោន កន្លះ ដឹក កម្មករ ចំនួន ៥០ នាក់ មកពី ឃុំ អម លាំង ស្រុក ថ្ពង បាន ក្រឡាប់ ដោយសារ ផ្លូវ កោង ដោយសារតែ អ្នកបើក ក្នុង ល្បឿន លឿន ពេក ។ ក្នុង គ្រោះថ្នាក់ ខាងលើ នេះ បណ្តាលឱ្យ កម្មករ រងរបួស ចំនួន ២៧ នាក់ ( ស្រី ២៦ នាក់ ) ក្នុង នោះ របួស ធ្ងន់ ១១នាក់ ស្រី ១០នាក់ ។
ក្រោយពី ទទួលបាន ព័ត៌មាន ភ្លាម ៗ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ របស់ កាកបាទ ក្រហម កម្ពុជា ប្រគល់ ជូន កម្មករ កម្ម ការិនី ដែល កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ នា ឱកាស នោះ ដែរ លោក បាន សម្តែង ការសោកស្តាយ និង អាណិត ជា ពន់ពេក ចំពោះ បងប្អូន កម្មករ - កម្មាការិនី បាន ជួប គ្រោះថ្នាក់ ជា យថាហេតុ បណ្តាលឲ្យ មាន ការរងរបួស ធ្ងន់ ស្រាល បែប នេះ ។
លោក អភិបាល ខេត្ត បាន អំពាវនាវ យ៉ាង ទទូច ដល់ អ្នកបើកបរ សូម មេត្តា កុំ វ៉ា ជែង ក្នុង ស្ថានភាព មិន ល្អ កុំ បើកបរ លើស ល្បឿន កំណត់ ពីព្រោះ បងប្អូន កូនក្មួយ ដែល ជា ម្ចាស់ រថយន្ត ឬក៏ អ្នកបើកបរ រថយន្ត ទាំងអស់ ត្រូវបាន កម្មករ កម្ម ការិនី រាប់ សិប នាក់ បាន ស្ម័គ្រ ផ្ញើ អាយុជីវិត នៅលើ យើង អ្នកបើកបរ តែ ម្នាក់ គត់ ។
លោក លើកឡើង ថា « ខ្ញុំ អាច បង្រៀន អ្នក ទាំងអស់ គ្នា ទៅ លើ ការសរសេរ ឲ្យបាន ត្រឹមត្រូវ គ្រប់ ជ្រុងជ្រោយ និង បង្ហាញ ពី ក្រមសីលធម៌ នៃ អ្នកសារព័ត៌មាន ។ ប៉ុន្តែ មាន តែ អ្នក ខ្លួន ឯង ទេ ជា អ្នកសម្រេច ក្នុង ការអនុវត្ត បែប ណា នៅពេល ធ្វើ កិច្ចការ ព័ត៌មាន នេះ ប៉ុណ្ណោះ » ។
នៅក្នុង ថ្នាក់ សិក្សា វា សប្តាហ៍ នេះ សិក្ខាកាម ជាច្រើន បាន ចាប់អារម្មណ៍ យ៉ាង ខ្លាំង លើ ក្រមសីលធម៌ វិជ្ជាជីវៈ អ្នក សាព័ត៌មាន ។ ដោយ មាន ការជជែក សួរ ដេញដោល យ៉ាង ខ្លាំង ក្នុង ន័យ ឈ្វេងយល់ ឲ្យ ច្បាស់ ពី ភាព ដែល អាច និង មិន អាច ធ្វើ ទៅ បាន របស់ អ្នកសារព័ត៌មាន ។
លោក ម៉ារ យ៉ារិទ្ធ បាន សង្កត់ធ្ងន់ ផងដែរ ថា ការគោរព ក្រមសីលធម៌ របស់ អ្នកសារព័ត៌មាន គឺជា ការផ្ដល់ តម្លៃ ឲ្យ ខ្លួន ឯង ប្រភព ក៏ ដូចជា ស្ថាប័ន ខ្លួន ឯង ផងដែរ ។ បន្ថែម ពី នេះ លោក ក៏ បាន បញ្ជាក់ ដែរ នៅ ពេល ដែល យើង យល់ ពី ក្រមសីលធម៌ នោះ ការធ្វើ អត្ថាធិប្បាយ របស់ យើង ក្នុង នាម ជា អ្នកសារព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ គឺជា ការ ដែល អាច ធ្វើឲ្យ អ្នក អាន និង អ្នកស្ដាប់ អាច ជឿ ទុកចិត្ត បាន ។
សូម បញ្ជាក់ ថា នេះ ជា សប្ដាហ៍ ទី៣ហើយ នៃ ការដំណើរការបង្រៀន ដល់ សិក្ខា សម្រាប់ ថ្នាក់ សិក្សា FTC ជំនាន់ ទី៣នេះ ។ បន្ទាប់ពី FTC បាន ទទួល ជោគជ័យ យ៉ាង ខ្លាំង លើ ការបណ្ដុះបណ្ដាល២ ជំនាន់ រួច មក ដោយ មាន ការចាប់អារម្មណ៍ ពី សិស្ស ចុះឈ្មោះ ចូលរៀន ពេញ ថ្នាក់ មុន ការ កំណត់ ។
កយកា និង មជ្ឈមណ្ឌល សាកលវិទ្យាល័យ វេជ្ជសាស្ត្រ ស៊ុន ជុន យ៉ាង រៀបចំ សិក្ខាសាលា រួម កម្ពុជា - កូរ៉េ លើក ទី២ ស្តី អំពី ជំងឺ ត្រចៀក ច្រមុះ បំពង់ ក
( ភ្នំពេញ ) ៖ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ កូរ៉េ ( កយកា-KOICA) និង មជ្ឈមណ្ឌល សាកលវិទ្យាល័យ វេជ្ជសាស្ត្រ ស៊ុន ជុន យ៉ាង នៃ សាធារណរដ្ឋ កូរ៉េ បាន រៀបចំ សិក្ខាសាលា រួម កម្ពុជា - កូរ៉េ លើក ទី២ ស្តី អំពី ជំងឺ ត្រចៀក ច្រមុះ បំពង់ ក ជាមួយ ក្រសួង សុខាភិបាល និង មន្ទីរពេទ្យ ព្រះអង្គ ឌួង នៅ ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ នៅ សណ្ឋាគារ ហៃ យ៉ាតរី ជិន ស៊ី ភ្នំពេញ ។
អង្គភាព ពាក់ព័ន្ធ និង ភ្ញៀវ កិត្តិយស ជាច្រើន រូប រួមទាំង តំណាង ក្រសួង សុខាភិបាល រួមទាំង មន្ត្រី មកពី ការិយាល័យ កយកា មន្ទីរពេទ្យ ព្រះអង្គ ឌួង និង មជ្ឍ មណ្ឌល សាកលវិទ្យាល័យ វេជ្ជសាស្ត្រ ស៊ុន ជុន យ៉ាង ដែល មាន អ្នកចូលរួម សរុប ជាង ១២០ នាក់ រួម មាន វេជ្ជបណ្ឌិត កូរ៉េ ចំនួន ៧នាក់ និង គិលានុបដ្ឋាយិកា កូរ៉េ ចំនួន ៥នាក់ បាន ចូលរួម នៅក្នុង សិក្ខាសាលា នេះ ។
លោក គីម ខ្វាង វុក បាន អះអាង ថា គោលបំណង នៃ សន្និសីទ លើក ទី២នេះ គឺ ដើម្បី គឺ ចែករំលែក និង ផ្លាស់ប្តូរ បទពិសោធន៍ គ្នា ទៅ វិញ ទៅមក និង ជំនាញ របស់ ប្រទេស នីមួយ ៗ ( កម្ពុជា កូរ៉េ ) នៅក្នុង វិស័យ ត្រចៀក ច្រមុះ និង បំពង់ ក ជាពិសេស ក្នុង ការពង្រឹង ប្រសិទ្ធភាព នៃ ការព្យាបាល រួមគ្នា រវាង ផ្នែក ត្រចៀក ច្រមុះ បំពង់ ក ក្បាល និង ក ដោយ ប្រើ វិធីសាស្ត្រ ពហុ ជំនាញ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក សាស្ត្រាចារ្យ វេជ្ជបណ្ឌិត ម៉ម ប៊ុន ហេង បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ កូរ៉េ ដែល បាន ផ្តល់ អគារ ថ្មី និង ជំនួយ បច្ចេកទេស សម្រាប់ ជំងឺ ត្រចៀក ច្រមុះ និង បំពង់ ក នៅ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង តាមរយៈ ភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ កូរ៉េ ( កយកា-KOICA) និង មជ្ឈមណ្ឌល សាកលវិទ្យាល័យ វេជ្ជសាស្ត្រ ស៊ុន ជុន យ៉ាង នៃ សាធារណរដ្ឋ កូរ៉េ ។
ក្នុង អំឡុង ពេល នៃ សិក្ខាសាលា ភាគី កូរ៉េ បាន ពន្យល់ អំពី ទី ១៖ ការវះកាត់ កែកុន ក្បាល និង ក . ទី២៖ ករណី សំខាន់ ៗ នៅ មជ្ឍ មណ្ឌល សាកលវិទ្យាល័យ វេជ្ជសាស្ត្រ ស៊ុន ជុន យ៉ាង ទាក់ទង ទៅ នឹង ត្រចៀក ច្រមុះ បំពង់ ក . ទី៣៖ ករណី សិក្សា ត្រចៀក ច្រមុះ បំពង់ ក ( ច្រៀក ) និង ការសិក្សា ត្រៀក ច្រមុះ បំពង់ ក ( ក្បាល និង ក) និង ទី៤៖ ការពិភាក្សា លើ បច្ចេកទេស វះកាត់ ចុងក្រោយ ទាក់ទង ទៅ នឹង ត្រចៀក ច្រមុះ បំពង់ ក ។
ចំណែក ខាង ភាគី កម្ពុជា បាន ធ្វើ បទបង្ហាញ អំពី ទី ១៖ ការចែករំលែក ចំណេះដឹង ផ្នែក ត្រចៀក ច្រមុះ បំពង់ ក ក្បាល និង ក . ទី ២៖ ការចែករំលែក ចំណេះដឹង ផ្នែក វះកាត់ កែ សម្ផស្ស . ទី ៣៖ ករណី សំខាន់ ៗ នៅ ផ្នែក ត្រចៀក នៅ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង និង ទី៤៖ ករណី សំខាន់ ៗ នៅ ផ្នែក ក្បាល និង ក នៅ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង ។
សូម រំលឹក ថា រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ កូរ៉េ តាមរយៈ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ កូរ៉េ (KOICA-ក យកា) បាន ផ្តល់ ជំនួយ ឥត សំណង ក្នុង ទឹកប្រាក់ ចំនួន ប្រាំបី លាន ដុល្លារ សហរដ្ឋ អាមេរិក សម្រាប់ « គម្រោង ការកសាង សមត្ថភាព សម្រាប់ មជ្ឍ មណ្ឌល ត្រចៀក ច្រមុះ បំពង់ ក (ENT) នៅ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង » ដែល បាន អនុវត្ត ចាប់ពី ឆ្នាំ ២០១៨ រហូតដល់ ឆ្នាំ ២០២២ នេះ ។
ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ អង្គរសរ ស្រុក មេសាង ខេត្ត ព្រៃវែង ប្រគល់ ផ្ទះ ជូន ពលរដ្ឋ គ្មាន ទី ជំរក ស្នាក់ មួយ គ្រួសារ
( ព្រៃវែង ) ៖ នៅ ថ្ងៃសៅរ៍ ១១រោច ខែ ជេស្ឋ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស ២៥៦៦ ត្រូវ នឹង ទី២៥ ខែមិថុនា ឆ្នាំ ២០២២ លោក បេ ទាឡេង អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ អង្គរសរ អម ដំណើរ ដោយ លោកស្រី ព្រំ ចន្ថា . លោក អ៊ុច ពង្ស និង ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ អង្គរ ស ព្រមទាំង អាជ្ញាធរ ឃុំ អង្គរ ស ចូលរួម ប្រគល់ ផ្ទះ ជូន គ្រួសារ គ្មាន ទី ជំរក ស្នាក់ នៅ ឈ្មោះ ភុន ត្រង ។
( ព្រះសីហនុ) ៖ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា ក្រុម ខ្មាន់ កាំភ្លើង ដែល បាញ់ អធិការ រង នៃ អធិការដ្ឋាន នគរបាល ក្រុង ព្រះសីហនុ ម្នាក់ បណ្ដាលឲ្យ រងរបួស ពេល បើក ប្រតិបត្តិការ បង្ក្រាប បទល្មើស នោះ ត្រូវបាន បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ព្រះសីហនុ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ ដើម្បី ផ្ដន្ទាទោស តាម ច្បាប់ ។
សូម ជម្រាប ថា ជន ដៃ ដល់ ដែល បាញ់ អធិការ រង នៃ អធិការដ្ឋាន នគរបាល ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ត្រូវបាន កម្លាំង ជំនាញ រួម សហការ គ្នា បង្ក្រាប បាន ជា បន្ដ បន្ទាប់ សរុប ៦នាក់ ក្នុង នោះ មាន ទាំង អ្នកលក់ កាំភ្លើង ឲ្យ ជន ដៃ ដល់ ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន អះអាង ថា ជន ដៃ ដល់ និង បក្ខពួក ព្រមទាំង ដែល លក់ដូរ អាវុធ ត្រូវ បង្ក្រាប បាន សរុប ៦នាក់ ក្នុង នោះ មាន ជនជាតិ ខ្មែរ ៣នាក់ និង ជនជាតិ វៀតណាម ( ដៃ ដល់ ) ៣នាក់ ផងដែរ ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ប្រតិបត្តិការ នេះ ធ្វើឡើង ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង លោក គួច ចំរើន អភិបាល ខេត្ត និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត ព្រះសីហនុ ដោយ មាន ការកិច្ចការ ពី នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ . ស្នងការដ្ឋាន នគរបាល ខេត្ត ឧត្តរមានជ័យ . ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ។
សមត្ថកិច្ច បាន បញ្ជាក់ ទៀត ថា នៅពេល ឃាត់ខ្លួន ជនសង្ស័យ បាន ហើយ នោះ កម្លាំង ជំនាញ ក៏ បាន សួរនាំ និង ស្រាវជ្រាវ ស្វែងប្រភព នៃ ការផ្ដល់ អាវុធ ឲ្យ ជនសង្ស័យ ដែល បាន ធ្វើ សកម្មភាព ជា លទ្ធផល ចាប់ខ្លួន បាន ៣នាក់ ( ឈ្មោះ ខាងលើ ) ព្រមទាំង ឈានដល់ ការឆែកឆេរ រកឃើញ អាវុធ ជាច្រើន ដើម ទៀត ផងដែរ ។
