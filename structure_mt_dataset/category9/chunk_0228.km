( ភ្នំពេញ ) ៖ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២២ នេះ គឺជា រយៈពេល ៤៥ ឆ្នាំ ហើយ ដែល សម្តេច តេជោ ហ៊ុន សែន និង យុទ្ធ មិត្ត រួម អាវុធ ដ៏ ស្មោះស្ម័គ្រ ៤រូប បាន រួមគ្នា យក ជីវិត ធ្វើជា ដើមទុន ចេញ ទៅកាន់ ប្រទេស វៀតណាម ស្វែងរក ការគាំទ្រ ដើម្បី តស៊ូ រំដោះ ជាតិ និង ប្រជាជន កម្ពុជា ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ដ៏ ឃោរឃៅ របស់ ខ្មែរ ប៉ុល ពត និង បក្ខពួក ។
កម្ពុជា និង វៀតណាម រួមគ្នា ប្រារព្ធ ពិធី ដ៏ មហោឡារិក ដើម្បី អបអរសាទរ និង រំលឹក ដល់ ដំណើរតស៊ូ ដ៏ អង់អាច ក្លាហាន ក្នុង ការរំដោះ ជាតិ និង ប្រជាជន កម្ពុជា កាលពី ៤៥ ឆ្នាំ មុន នេះ ។ ពិធី ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក ផាម មិញ ជីញ នាយក រដ្ឋមន្ត្រី វៀតណាម នៅ ព្រំដែន កម្ពុជា និង វៀតណាម តំបន់ X16 ក្នុង ឃុំ ទន្លូង ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ដែល ជា ទីតាំង សម្តេច តេជោ និង យុទ្ធ មិត្ត បាន ឆ្លង ទៅកាន់ ប្រទេស វៀតណាម ទាំង កណ្តាល អាធ្រាត្រ កាលពី ៤៥ ឆ្នាំ មុន នោះ ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែងអំណរគុណ ដល់ នាយក រដ្ឋមន្រ្តី វៀតណាម ដែល អនុញ្ញាតឲ្យ សម្តេច បាន ទៅ អ៊ុច ធូប និង ថ្លែងអំណរគុណ ពលរដ្ឋ វៀតណាម ដែល បាន ជួយ សម្តេច កាលពី ៤៥ ឆ្នាំ មុន
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប្រសិនបើ ខ្ញុំ មិន ធ្វើ សកម្មភាព កាលពី ៤៥ ឆ្នាំ មុន ប្រាកដ ណាស់ ខ្ញុំ ពិតជា ស្លាប់ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច មាន ជម្រើស ចំនួន ៤ កាលពី ៤៥ ឆ្នាំ មុន ប៉ុន្តែ ទីបំផុត សម្តេច ជ្រើសរើស ជម្រើស ទី២
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នៅពេល ទទួលបាន ជំនួយ ពី វៀតណាម កងទ័ព វៀតណាម ច្រើន ជាង កម្ពុជា ហើយ កងទ័ព វៀតណាម ជា អ្នក ច្បាំង ជាមួយ ប៉ុល ពត
* សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក អំពី ការចេញ ទៅ វៀតណាម ដោយ ជ្រើសរើស ត្រូវតែ មនុស្ស ៥នាក់ ដោយ មិន នាំ កងទ័ព ទាំងមូល ទៅ
* សម្តេច តេជោ ហ៊ុន សែន ស្រក់ ទឹកភ្នែក នៅពេល រំលឹក អំពី ការតស៊ូ ចូល ទៅកាន់ ប្រទេស វៀតណាម ដើម្បី ស្វែងរក ជំនួយ
* សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក ថា រឿង ដែល ពិបាក បំផុត គឺ ការសរសេរ សំបុត្រ ជូន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត កាលពី ៤៥ ឆ្នាំ ដោយសារតែ មិន អាច បង្ហាញ ទីតាំង របស់ ខ្លួន
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ទង្វើ របស់ វៀតណាម ដោយ ចូលមក ជួយ រំដោះ ប្រជាជន កម្ពុជា កាលពី ៤៥ ឆ្នាំ មុន ជា រឿង ត្រឹមត្រូវ ដោយ កាត់ក្តី ដោយ តុលាការ កូន កាត់ ដែល ទទួលស្គាល់ ដោយ អង្គការ សហ ប្រជាជាតិ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ពេលនេះ វៀតណាម បាន ទទួលបាន យុត្តិធម៌ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា តាមរយៈ ជោគជ័យ នៃ ការកាត់ទោស ខ្មែរ ក្រហម
* សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា វៀតណាម មិន មែន ដក កងទ័ព ចេញ ពី កម្ពុជា ក្រោយ កិច្ចព្រមព្រៀង ក្រុង ប៉ារីស នោះ ទេ គឺ វៀតណាម បាន ដក កងទ័ព ទាំងស្រុង តាំងពី ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ១៩៨៩ ម្ល៉េះ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្នក និយាយ ថា ដោយសារ កិច្ចព្រមព្រៀង ក្រុង ប៉ារីស បាន វៀតណាម ដក ទ័ព គឺជា ការនិយាយ ខុសពី សភាពការណ៍ ជាក់ស្តែង
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ជំនាញ ការវៀតណាម ត្រូវបាន ដក ចេញ ពី កម្ពុជា មុន ដក កងទ័ព មួយ ឆ្នាំ ហើយ វៀតណាម បាន ដក កងទ័ព ចេញ ពី កម្ពុជា ២ឆ្នាំ មុន កិច្ចព្រមព្រៀង ក្រុង ប៉ារីស
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រយៈពេល ៤៥ ឆ្នាំ មក នេះ ស្ថានការណ៍ បាន ផ្លាស់ប្តូរ ប៉ុន្តែ តួអង្គ ហ៊ុន សែន មិន បាន ផ្លាស់ប្តូរ ទេ
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ថា ខ្ញុំ គ្មាន សិទ្ធិ ដើម្បី ប្រគល់ ដី ឱ្យ វៀតណាម សូម្បី មួយ មីលីម៉ែត្រ ហើយក៏ មិន ចង់បាន ដី វៀតណាម សូម្បី ១មីលីម៉ែត្រ សូម ឱ្យ តែ ដោះស្រាយ ត្រឹមត្រូវ តាម ផែនទី បារាំង ទៅ បាន ហើយ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គោលដៅ របស់ សម្តេច គឺ កែប្រែ តំបន់ ព្រំដែន កម្ពុជា - វៀតណាម ទៅជា តំបន់ សន្តិភាព និង អភិវឌ្ឍ
* សម្តេច តេជោ ហ៊ុន សែន បាន ស្នើ ឱ្យ បង្ក លក្ខណៈ ងាយស្រួល ដល់ ប្រជាជន កម្ពុជា និង វៀតណាម ចូល ទស្សនា ទៅ វិញ ទៅ មក តំបន់ ប្រវត្តិសាស្រ្ត X16 ដោយ មិន ចាំបាច់ ប្រើប្រាស់ លិខិត ឆ្លង ដែន
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បាយ មួយ ពេល ដែល ប្រជាជន វៀតណាម ឱ្យ សម្តេច ទទួលទាន ពេល ចូលទៅ វៀតណាម កាលពី ៤៥ ឆ្នាំ មុន មាន តម្លៃ ជាង អង្ករ រាប់ ម៉ឺន តោន ដែល កម្ពុជា មាន ពេលនេះ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការអភិវឌ្ឍ របស់ កម្ពុជា ពេលនេះ មិន មែន ជា សមិទ្ធផល ផ្តាច់ មុខ របស់ សម្តេច នោះ ទេ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា យើង បាន ឈ្នះ សង្គ្រាម ដែល តា . អាល់ហ្វា និង អូមី ក្រុង ប៉ុន្តែ មិន ទាន់ ឈ្នះ ទាំងស្រុង នូវ សង្គ្រាម កូវីដ១៩ នៅឡើយ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បើ ទោះបីជា កម្ពុជា ត្រូវ ចាក់ ដល់ ដូស ទី២០ ក៏ រាជ រដ្ឋាភិបាល មិន យក ប្រាក់ ពី ប្រជាជន សម្រាប់ ការចាក់ វ៉ាក់សាំង ឡើយ
នៅក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ នេះ គណបក្ស សាធារណរដ្ឋ ប្រចាំ រដ្ឋ តិចសាស់ បាន គូសបញ្ជាក់ ដូច្នេះ ថា « យើង បដិសេធ បញ្ជាក់ លទ្ធផល បោះឆ្នោត ប្រធានាធិបតី កាលពី ឆ្នាំ ២០២០ ហើយ យើង ចាត់ទុក ថា ប្រធានាធិបតី បណ្ដោះអាសន្ន លោក ចូ បៃ ដិន មិន បាន ជាប់ ឆ្នោត ដោយ ស្រប ច្បាប់ ពីសំណាក់ ប្រជាជន អាមេរិក នោះ ទេ » ។
គួរ បញ្ជាក់ ថា លោក ចូ បៃ ដិន បាន ទទួល សន្លឹក ឆ្នោត Popular Vote ច្រើន ជាង លោក ដូណាល់ ត្រាំ ៧លាន សំឡេង និង ទទួលបាន សំឡេង ប្រតិភូ ចំនួន ៣០៦ លើស ពី សំឡេង ប្រតិភូ ចំនួន ២៧០ ដែល ត្រូវការ ជា ចាំបាច់ ដើម្បី ជាប់ ឆ្នោត ជា ប្រធានាធិបតី ។ តិចសាស់ គឺជា រដ្ឋ ដ៏ សំខាន់ មួយ ដែល មាន ប្រតិភូ សរុប ៣៨ ច្រើន បំផុត បន្ទាប់ពី រដ្ឋ កាលីហ្វ័រញ៉ា ហើយ ក្នុង រយៈពេល ជាង ៤ទសវត្សរ៍ មក នេះ រដ្ឋ មួយ នេះ តែងតែ បោះឆ្នោត គាំទ្រ បេក្ខជន ប្រធានាធិបតី មកពី គណបក្ស សាធារណរដ្ឋ ៕
ក្នុង សុន្ទរកថា តាម វីដេអូ មួយ កាលពី ថ្ងៃអាទិត្យ ចុង សប្តាហ៍ កន្លងទៅ នេះ លោក ហ្សេលេន ស្គី បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « តាម ការសន្និដ្ឋាន . រុស្ស៉ី អាចនឹង បង្កើន ការវាយប្រហារ កាន់តែ ខ្លាំង ថែម ទៀត ក្នុង សប្តាហ៍ នេះ ។ តែ យើង បាន ត្រៀម ខ្លួន រួចរាល់ ដើម្បី ទប់ទល់ » ។
កាលពី ថ្ងៃសុក្រ សប្តាហ៍ មុន ប្រធានាធិបតី រុស្ស៉ី លោក វ្ល៉ាឌីមៀ ពូទីន បាន និយាយ ថា ទីក្រុង មូស្គូ មិន មាន អ្វី ជំទាស់ នឹង សមាជិកភាព របស់ អ៊ុយក្រែន ទេ ប៉ុន្តែ អ្នកនាំពាក្យ វិមាន ក្រឹមឡាំង បាន សង្កត់ធ្ងន់ ថា រុស្ស៉ី នឹង តាមដាន យ៉ាង ដិត ដល់ ចំពោះ សំណើ របស់ ទីក្រុង កៀវ ក្នុង ការចូល ជា សមាជិក របស់ សហភាព អឺរ៉ុប ជាពិសេស នៅ ពេល ដែល អ៊ុយក្រែន មាន កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ការពារ ជាតិ ជាមួយ ប្រទេស ជា សមាជិក ផ្សេង ទៀត ។
គួរ បញ្ជាក់ ថា ថ្មី ៗ នេះ គណៈកម្មការ អឺរ៉ុប បាន ផ្តល់ អនុសាសន៍ ថា អ៊ុយក្រែន គួរតែ ទទួលបាន « ឋានៈ ជា បេក្ខភាព » ដើម្បី ក្លាយជា សមាជិក សហភាព អឺរ៉ុប ហើយ ប្រសិនបើ មិន មាន ការប្រែប្រួល នោះ ទេ មេដឹកនាំ នៃ ប្រទេស សមាជិក EU ទាំង ២៧ នឹង លើក យក បញ្ហា នេះ មក ពិភាក្សា គ្នា ក្នុង កិច្ចប្រជុំ កំពូល ដែល គ្រោង នឹង រៀបចំឡើង នៅ ថ្ងៃព្រហស្បតិ៍ និង ថ្ងៃសុក្រ សប្តាហ៍ នេះ ប៉ុន្តែ ដំណើរការ ដើម្បី ឈានទៅ សម្រេចបាន គឺ អាច ចំណាយ ពេល ជាច្រើន ឆ្នាំ ទៀត ឯណោះ ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៩ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៤៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២០ ខែមិថុនា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៩ នាក់ នោះ មាន ០៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ០៦ ករណី និង ជនសង្ស័យ ៤២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៣ករណី ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន ចេញផ្សាយ កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ នេះ ក្រសួង ការពារ ជាតិ ចិន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ប្រព័ន្ធ ស្ទាក់ ចាប់ ប្រឆាំង មីស៊ីល ផ្លោង ត្រូវបាន ធ្វើតេស្ដ នៅ យប់ នេះ ( ថ្ងៃអាទិត្យ ) ហើយ ការធ្វើតេស្ដ នេះ បាន សម្រេច តាម គោលដៅ រំពឹងទុក ។ ប៉ុន្តែ ធ្វើតេស្ដ នេះ គឺជា មធ្យោបាយ ការពារ ខ្លួន សុទ្ធសាធ មិន មាន ចេតនា សំដៅ លើ ប្រទេស ណាមួយ នោះ ទេ » ។
គួរ បញ្ជាក់ ថា ចិន ក៏ ធ្លាប់ បាន ធ្វើតេស្ដ ប្រព័ន្ធ ស្ទាក់ ចាប់ មីស៊ីល ពីមុន មក ដែរ កាលពី ឆ្នាំ ២០២១ និង ២០១៨ ខណៈ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ចិន បាន ឱ្យដឹង ថា ទីក្រុង ប៉េកាំង បាន ចាប់ផ្ដើម ធ្វើតេស្ដ ប្រព័ន្ធ ប្រឆាំង មីស៊ីល ផ្លោង ចាប់តាំងពី ឆ្នាំ ២០១០មក ៕
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃសុក្រ សប្ដាហ៍ មុន គណៈកម្មការ អឺរ៉ុប បាន ផ្ដល់ អនុសាសន៍ ថា អ៊ុយក្រែន គួរតែ ទទួលបាន « ឋានៈ បេក្ខភាព » ដើម្បី ក្លាយជា សមាជិក សហភាព អឺរ៉ុប ។ ប៉ុន្តែ ការទទួលយក អ៊ុយក្រែន ជា សមាជិក ត្រូវបាន គេ រំពឹង ថា អាចនឹង ចំណាយ ពេល រាប់ ឆ្នាំ ខណៈ មេដឹកនាំ អឺរ៉ុប នឹង ត្រូវ ជួបប្រជុំគ្នា ដើម្បី ពិភាក្សា លើ បញ្ហា នេះ នៅក្នុង សប្ដាហ៍ នេះ ៕
