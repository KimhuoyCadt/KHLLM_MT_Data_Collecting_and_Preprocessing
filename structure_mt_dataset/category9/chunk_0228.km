ក្រុម អ្នកប្រវត្តិសាស្ត្រ ខ្មែរ បាន មើលឃើញ ប្រសិនបើ គ្មាន ការចាប់ផ្តើម ចេញ តស៊ូ របស់ សម្តេច តេជោ ហ៊ុន សែន និង ឥស្សរជន ខ្មែរ ស្នេហាជាតិ នាំគ្នា ងើប ប៉ះ បោរ រំដោះ ជាតិ ឡើង ទេ នោះ ជាតិ និង ប្រជាជន កម្ពុជា គ្មាន ឱកាស រួចផុត ពី របប ដ៏ ប្រល័យ របស់ ប៉ុល ពត នោះ ឡើយ ៕ តៃវ៉ាន់ ថា មិន ចង់ បិទ ទ្វារ ទំនាក់ទំនង ជាមួយ ចិន ទេ ក្រោយ ប៉េកាំង ព្រមាន ប្រើ កម្លាំង យោធា បើ ហ៊ាន ផ្ដាច់ ខ្លួន
ការលើកឡើង ខាងលើ របស់ លោក ស៊ូ សេង ចាង ធ្វើឡើង បន្ទាប់ពី រដ្ឋមន្ត្រី ការពារ ជាតិ ចិន បាន ថ្លែង នៅក្នុង កិច្ចប្រជុំ សន្តិសុខ សាង គ្រី - ឡា (Shangri-La) នៅ ប្រទេស សិង្ហបុរី ថា រដ្ឋាភិបាល ចិន បាន ស្វែងរក ការបង្រួបបង្រួម ដោយ សន្តិភាព ជាមួយ តៃវ៉ាន់ ប៉ុន្តែ តៃវ៉ាន់ បែរជា ជ្រើសរើស យក ជម្រើស ផ្សេង ទៀត ហើយ ថា នឹង មិន ស្ទាក់ស្ទើរ ឡើយ ក្នុង ការប្រើ កម្លាំង យោធា បើ តៃវ៉ាន់ ហ៊ាន ប្រកាស ឯករាជ្យ ។
គួរ បញ្ជាក់ ថា ទំនាក់ទំនង រវាង ទីក្រុង តៃ ប៉ិ និង ទីក្រុង ប៉េកាំង ស្ថិត ក្នុង កម្រិត ទាប បំផុត ក្នុង រយៈពេល ជាច្រើន ទសវត្សរ៍ មក នេះ ដោយ ចិន បាន ព្រមាន ជារឿយ ៗ ថា ខ្លួន នឹង ប្រើ កម្លាំង យោធា លើ តៃវ៉ាន់ ភ្លាម ៗ បើ ទីក្រុង តៃ ប៉ិហ៊ាន ប្រកាស ឯករាជ្យ ផ្ដាច់ ខ្លួន ពី ចិន ៕
សម្ដេច តេជោ ហ៊ុន សែន អះអាង ថា ក្រុម ប្រឆាំង តែង មាន គំនិត ទុច្ចរិត លើ នយោបាយ វ៉ាក់សាំង តែ ត្រូវ បរាជ័យ ដោយសារ សិល្បៈ ដោះស្រាយ របស់ រាជ រដ្ឋាភិបាល (Video inside) ( ភ្នំពេញ ) ៖ បើ ទោះបី នយោបាយ វ៉ាក់សាំង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ដាក់ចេញ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដើម្បី ចាក់ ស្រាច លើ ប្រជាពលរដ្ឋ ដើម្បី កាពារ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ទទួលបាន ជោគជ័យ យ៉ាងណា ក្ដី តែ ក្រុម អ្នក ប្រឆាំង តែងតែ មាន គំនិត ពុត ត្បុត ទុច្ចរិត លើ នយោបាយ មួយ នេះ ។
គំនិត ទុច្ចរិត របស់ ក្រុម អ្នកប្រឆាំង ទាំងនោះ ត្រូវបាន លាតត្រដាង ដោយ សម្ដេច តេជោ ហ៊ុន សែន នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន ឲ្យដឹង ថា គំនិត ទុច្ចរិត របស់ ក្រុម នោះ ដំបូង ហាមឃាត់ ប្រជាពលរដ្ឋ មិន ឲ្យ ទៅ ទទួល វ៉ាក់សាំង ដោយ លើក ហេតុផល ថា វ៉ាក់សាំង របស់ ចិន ចាក់ ទៅ អាច មាន បញ្ហា ដល់ សុខភាព ក្រោយមក ពួកគេ បាន បំផុស ទៀត ថា វ៉ាក់សាំង មិន អី ទេ និង រុញ ឲ្យ ប្រជាពលរដ្ឋ ទៅដណ្ដើម ចាក់ វ៉ាក់សាំង គ្រា ដែល ពេលនេះ កម្ពុជា កំពុង ខ្វះ ចាក់ វ៉ាក់សាំង ។
យ៉ាងណា ក៏ដោយ ភាពពិស ឧបាយកល ទុច្ចរិត របស់ ក្រុម ប្រឆាំង លើ ការចាក់ វ៉ាក់សាំង ត្រូវ បរាជ័យ ព្រោះតែ សិល្បៈ នៃ ការដោះស្រាយ បញ្ហា របស់ រាជ រដ្ឋាភិបាល ។ នេះ បើ តាម អ្វី ដែល សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ។
សម្ដេច តេជោ ហ៊ុន សែន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ចំណុច ទាំងអស់ យើង បាន មើលឃើញ ដំបូង គេ រាំង ស្កាត់ បន្ទាប់ពី រាំង ស្កាត់ គេ បំផុស ឲ្យ មនុស្ស ទៅ ទទួល វ៉ាក់សាំង ក្នុង ពេល យើង ខ្វះ វ៉ាក់សាំង រឿង ពិត យ៉ាង ដូច្នេះ កុំ ឃើញ គេ ថា ទៅ ចាក់ ទៅ ថា ជា គំនិត ល្អ មិន មែន ។ ខ្ញុំ បាន វាយតម្លៃ ទុក ជាមុន ខ្ញុំ វាយតម្លៃ ត្រូវ ២អាទិត្យ មុន នៅពេល ចលនា ទៅ ទទួល វ៉ាក់សាំង ភ្លាម ខ្ញុំ ថា បន្ដិច ទៀត នឹង មាន អ្នក និយាយ ថា សូម ទៅ ទទួល វ៉ាក់សាំង ព្រោះ ពេល ណុង យើង កំពុង ខ្វះ វ៉ាក់សាំង » ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី នៅតែ បន្ដ អះអាង ថា ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា មិន មាន និន្នាការ នយោបាយ នោះ ឡើយ ។ ពោល គ្រប់ និន្នាការ នយោបាយ សុទ្ធតែ បាន ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ហើយ ប្រជាពលរដ្ឋ ជឿ បក្ស នយោបាយ ឬ សាសនា ណា សម្តេច មិន ខ្វល់ នោះ ទេ អ្វី ដែល ខ្វល់ គឺ ការការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ។
សូម ជម្រាប ថា សម្ដេច តេជោ ហ៊ុន សែន នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ ក៏ បាន បង្ហាញ អំពី តួលេខ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដែល កម្ពុជា មាន នៅក្នុង ឃ្លាំង ជាង ១១លាន ដូស ខណៈ វ៉ាក់សាំង ប្រមាណ ជាង ២០លាន ដូស បន្ថែម ទៀត ត្រៀម បញ្ជូន មក កម្ពុជា ជា បន្ដ បន្ទាប់ ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ សំដៅ បង្កើន នូវ ការកង ការពារ ជំងឺ ដ៏ កាច សាហាវ មួយ នេះ ។
សម្តេច តេជោ ហ៊ុន សែន ថ្លែង បែប នេះ ក្នុង ឱកាស អញ្ជើញ ចែក សញ្ញាបត្រ ជូន សិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ ពាន់ នាក នៅ ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ ។
ប្រមុខ ដឹកនាំ កំពូល រាជ រដ្ឋាភិបាល កម្ពុជា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « អ្វី ដែល ខ្ញុំ ចង់ ដាស់តឿន សម្រាប់ មន្ត្រី របស់ យើង នោះ គឺ ត្រូវ ចាំ ឲ្យបាន រំលឹក ខ្លួន ឯង ឲ្យបាន ជាប់ ជាប្រចាំ យើង ជា មន្ត្រី ត្រូវតែ បម្រើ ប្រជាពលរដ្ឋ ដោយ ស្មោះត្រង់ មិន មែន ជា ចៅហ្វាយ របស់ ប្រជាពលរដ្ឋ ទេ ។ សុំ ក្តាប់ ចំណុច នេះ ឲ្យបាន » ។
បើ តាម ប្រសាសន៍ សម្តេច តេជោ ហ៊ុន សែន មន្ត្រី ត្រូវ ចាត់ទុក ថា ការបម្រើ ប្រជាពលរដ្ឋ ជា គោលដៅ ត្រូវ ធ្វើ ។ សម្តេច សង្កត់ធ្ងន់ ៗ ថា ធ្វើជា មន្ត្រី បើ មិន ចាត់ទុក ការបម្រើ ប្រជាពលរដ្ឋ ជា គោលដៅ មិន បាច់ មក ធ្វើជា មន្ត្រី ទេ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បន្ត ក្រើន រំលឹក ដល់ មន្ត្រី ចៀស ឲ្យបាន នូវ ប្បធម៌ « ប្រពន្ធ ស័ក្តិ៣ ប្តី ស័ក្តិ៤ កូន ស័ក្តិ ៥» ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ទៀត ថា ការលេចឡើង នៃ កត្តា ចៃដន្យ ក្នុង ការអនុវត្ត ផែនការ នឹង ធ្វើឱ្យ លេចឡើង មន្ត្រី ចំនួន ពីរ គឺ មន្ត្រី ល្អ ប្រឹងប្រែង ដោះស្រាយ បញ្ហា និង មន្ត្រី មិន ល្អ ចេះ ត្រឹម ស្តីបន្ទោស ឱ្យ ថ្នាក់ ក្រោម និង រាយការណ៍ ។ សម្តេច តេជោ ក៏ បាន ក្រើន រំលឹក ដល់ មន្ត្រី ត្រូវ ចៀសវាង ឱ្យ បាន ដាច់ខាត នូវ ងារ ជា មន្ត្រី គ្រាប់ ល្ពៅ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ដែរ ថ្លែង ថា នឹង មាន ការដំឡើង ប្រាក់ បៀវត្សរ៍ មន្ត្រីរាជការ នៅក្នុង ឆ្នាំ ២០២២ នេះ បន្ទាប់ពី ខកខាន អស់ រយៈពេល ពីរ ឆ្នាំ ។ ក្នុង នោះ អ្នកប្រាក់ បៀវត្សរ៍ តិច ដំឡើង ច្រើន អ្នក ប្រាក់ បៀវត្សរ៍ ច្រើន ដំឡើង តិច ៕ បទ អត្ថាធិប្បាយ៖ ប្រទេស ចិន មាន សមត្ថភាព និង មាន លក្ខខណ្ឌ រក្សា សេដ្ឋកិច្ច ឱ្យ ទទួលបាន ការអភិវឌ្ឍ ប្រកបដោយ ស្ថិរភាព និង រឹងមាំ
( ប៉េកាំង ) ៖ នា ពេល ថ្មី ៗ កន្លងទៅ នេះ អគ្គ រដ្ឋបាល គយ នៃ ប្រទេស ចិន បាន ចេញផ្សាយ ទិន្នន័យ ស្ថិតិ ថ្មី បំផុត អំពី ពាណិជ្ជកម្ម ជាមួយ បរទេស របស់ ចិន ដោយ បាន បង្ហាញ ថា បើ គិត តាម ដុល្លារ អាមេរិក នៅ ខែឧសភា ទំហំ ពាណិជ្ជកម្ម សរុប ខាងការនាំចេញ និង នាំចូល នៃ ប្រទេស ចិន បាន ឡើង ដល់ ៥៣.៧៧៤ លាន ដុល្លារ អាមេរិក ដែល បាន កើនឡើង ១១.១ ភាគរយ ។ ក្នុង នោះ ការនាំចេញ បាន កើនឡើង ១៦. ៩ភាគរយ ។
លើស ពី នេះ ទៅ ទៀត ទំហំ ពាណិជ្ជកម្ម នាំចូល បាន កើនឡើង ៤ភាគរយ ។ ក្រោម បរិបទ ដែល ជំងឺ កូវីដ ១៩ កំពុង រាតត្បាត យ៉ាង ធ្ងន់ធ្ងរ នៅ ទូទាំង ពិភពលោក ក្នុង រយៈពេល ៥ខែ ដំបូង ឆ្នាំ នេះ ទំហំ ពាណិជ្ជកម្ម សរុប ជាមួយ បរទេស នៃ ប្រទេស ចិន សម្រេចបាន នូវ កំណើន យ៉ាង នឹង នរ គឺ បាន មក ដោយ មិន ងាយ ទេ ដែល បាន បង្ហាញ ទៅកាន់ ពិភពលោក ឱ្យ ឃើញ ម្តង ទៀត នូវ ភាពធន់ និង សមត្ថភាព ងើប ឡើងវិញ របស់ ប្រទេស ចិន យ៉ាង ខ្លាំងក្លា ។
គួរ រំលឹក ដែរ ថា ចិន ត្រូវការ ពិភពលោក រីឯ ពិភពលោក វិញ ក៏ មិន អាច ឃ្លាត ពី ប្រទេស ចិន ដែរ ។ មិន ថា អ្នកនយោបាយ សហរដ្ឋ អាមេរិក និង ប្រទេស ប៉ែក ខាងលិច មួយចំនួន តូច ញុះញង់ សហគ្រាស ពហុ ជាតិ ឱ្យ « ផ្តាច់ ទំនាក់ទំនង » ជាមួយ ប្រទេស ចិន យ៉ាងណា ក៏ដោយ ក៏ វា នៅតែ ជា រឿង ដែល មិន អាច សម្រេចបាន នោះ ទេ ។
ពាណិជ្ជកម្ម ជាមួយ បរទេស របស់ ចិន ត្រូវ គេ ចាត់ទុក ជា ឧបករណ៍ សម្រាប់ សង្កេតមើល ពី សេដ្ឋកិច្ច ចិន ។ ក្នុង រយៈពេល ៥ខែ កន្លងទៅ ពាណិជ្ជកម្ម ជាមួយ បរទេស របស់ ចិន ទទួលបាន សមិទ្ធផល គួរឱ្យ កត់សម្គាល់ ដែល បាន ឆ្លុះបញ្ចាំង ពី ភាពធន់ យ៉ាង ខ្លាំងក្លា នៃ សេដ្ឋកិច្ច ចិន ។ ប្រការ ទាំង នេះ មិន ត្រឹមតែ ជា ព័ត៌មាន ល្អ ចំពោះ ប្រទេស ចិន ប៉ុណ្ណោះ ទេ ថែមទាំង ក៏ បាន បញ្ចេញ ភាព កក់ក្តៅ និង រស់រវើក ដ៏ កម្រ មាន ចំពោះ ពិភពលោក ផងដែរ ។
ពេលវេលា នឹង បញ្ជាក់ ថា ប្រទេស ចិន មាន សមត្ថភាព និង មាន លក្ខខណ្ឌ រក្សា សេដ្ឋកិច្ច ឱ្យ ទទួលបាន ការអភិវឌ្ឍ ប្រកបដោយ ស្ថិរភាព និង រឹងមាំ ហើយ នឹង ក្លាយជា កម្លាំង គន្លឹះ សម្រាប់ លំនឹង ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ ជា សកល និង ជំរុញ ការងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច ពិភពលោក ជា បន្តបន្ទាប់ ផងដែរ ៕
គួរ បញ្ជាក់ ថា បើ តាម ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី . គោលដៅ ជា យុទ្ធសាស្រ្ត របស់ រុស្ស៉ី មិន ផ្លាស់ប្តូរ ទេ ហើយ នៅ ពេល នេះ កងទ័ព រុស្ស៉ី កំពុង សម្រុក វាយប្រហារ ទីក្រុង ស៉ីវី យេរ៉ូដូណេត ដោយ ការប្រយុទ្ធ គ្នា យ៉ាង ធ្ងន់ធ្ងរ កំពុង បន្ត នៅ ទីនោះ ស្រប ពេល ទាហាន រុស្ស៉ី ព្យាយាម ដាក់ពង្រាយ កម្លាំង បម្រុង ទៅកាន់ តំបន់ ដុន បាស់ ៕
សម្របសម្រួល ការងារ បង្ការ និង គ្រប់គ្រង ការរីករាលដាល នៃ ជំងឺ COVID-19 ជាមួយនឹង ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម រក្សា ស្ថិរភាព សេដ្ឋកិច្ច និង សង្គម ជំរុញ អភិបាលកិច្ច ខេត្ត Sichuan ឱ្យ ឡើង ដល់ កម្រិត ថ្មី ដើម្បី ខិតខំ ចារ ទំព័ថ្មី ក្នុង ការអភិវឌ្ឍ របស់ ខេត្ត Sichuan ក្នុង ដំណើរ ថ្មី នៃ ការកសាង ប្រទេស សង្គម និយម ទំនើប ដោយ គ្រប់ ជ្រុងជ្រោយ ក្នុង ន័យ ប្រារព្វ សមាជ បក្ស កុម្មុយនិស្ត ចិន លើក ទី ២០ ដោយ ជោគជ័យ តាមរយៈ សកម្មភាព ជាក់ស្តែង ៕
គួរ បញ្ជាក់ ថា ស៊ុយអែត និង ហ្វាំងឡង់ បាន ដាក់ពាក្យ សុំ ចូល ជា សមាជិក NATO កាលពី ខែ មុន ដើម្បី ឆ្លើយតប ទៅនឹង ការឈ្លានពាន របស់ រុស្ស៉ី លើ អ៊ុយក្រែន ។ ប៉ុន្តែ ពួកគេ បាន ប្រឈមមុខ នឹង ការប្រឆាំង ពី តួកគី ដែល បាន ចោទប្រកាន់ ប្រទេស ទាំង ២ថា បាន គាំទ្រ និង ផ្ដល់ អាវុធ ព្រមទាំង ជម្រក ដល់ ក្រុម សកម្ម ប្រយុទ្ធ ឃើដ និង ក្រុម ផ្សេង ទៀត ដែល ខ្លួន ចាត់ទុក ថា ជា ក្រុម ភេរវករ ៕
នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន យោធា កូរ៉េ ខាងត្បូង មិន បាន បញ្ជាក់ អ្វី លម្អិត បន្ថែម នោះ ទេ ដោយ គ្រាន់តែ ឱ្យដឹង ថា ការបាញ់ កាំភ្លើង ធំ របស់ កូរ៉េ ខាងជើង គឺជា សកម្មភាព ធម្មតា នៃ ការបាញ់ សាកល្បង កាំភ្លើង ធំ រយៈ ចម្ងាយ ខ្លី និង រយៈកម្ពស់ ទាប ។
គួរ បញ្ជាក់ ថា ការបាញ់ កាំភ្លើង ធំ ខាងលើ របស់ កូរ៉េ ខាងជើង កើត មាន ឡើង បន្ទាប់ពី លោក គីម ជុង អ៊ុន បាន បង្ហើប ពី គោលបំណង បន្ត អភិវឌ្ឍ និង ពង្រឹង សមត្ថភាព យោធា ដើម្បី ការពារ អធិបតេយ្យភាព នៃ ប្រទេស របស់ លោក ខណៈ លោក បិទ បញ្ចប់ កិច្ចប្រជុំ ពេញ អង្គ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស ពលករ កូរ៉េ ចំពោះមុខ ការបារម្ភ ថា ទីក្រុង ព្យុងយ៉ាង អាចនឹង ធ្វើតេស្ដ អាវុធ នុយក្លេអ៊ែរ ឡើងវិញ ឆាប់ ៗ នេះ ៕
បើកបរ សូម កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៦នាក់ និង របួស ៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១២ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ៥នាក់ ។
សេចក្តីសម្រេច នេះ បាន បើក ផ្លូវ សម្រាប់ ការផ្លាស់ ទីលំនៅ ដ៏ ធំ បំផុត មួយ ចាប់តាំងពី អ៊ីស្រាអែល បាន ដណ្តើម កាន់កាប់ ទឹកដី នៅក្នុង សង្គ្រាម មជ្ឈិមបូព៌ា ឆ្នាំ ១៩៦៧ ។ ប៉ុន្តែ អ្នកស្រុក មិន ព្រម ចាកចេញ ទេ ដោយ សង្ឃឹម ថា ភាពធន់ របស់ ពួកគេ និង សម្ពាធ អន្តរជាតិ នឹង រារាំង អ៊ីស្រាអែល ពី ការអនុវត្ត ច្បាប់ បណ្តេញ ចេញ នេះ ។
គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ព្រែក ព្នៅ បេីក កិច្ចប្រជុំ បូកសរុប លទ្ធផល បណ្តោះអាសន្ន ការបោះឆ្នោត ក្រុមប្រឹក្សា សង្កាត់ អាណត្តិ ទី៥
( ភ្នំពេញ )៖ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ព្រែក ព្នៅ នៅ ថ្ងៃទី ១២ ខែ មិថុនា ឆ្នាំ ២០២២ នេះ បាន រៀបចំ បេីក កិច្ចប្រជុំ ប្រកាស បូកសរុប លទ្ធផល បណ្តោះអាសន្ន ការបោះឆ្នោត ក្រុមប្រឹក្សា សង្កាត់ អាណត្តិ ទី៥ និង លេីក ទឹកចិត្ត ទៅដល់ ថ្នាក់ដឹកនាំ គណៈកម្មាធិការ គណ ប្រជាជន កម្ពុជា សង្កាត់ ទាំង៥ ព្រមទាំង ប្រធាន សាខា បក្ស ភូមិ ទាំង ៥៩ ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការអញ្ជេីញ ចូលរួម ពី ក្រុមការងារ ចុះ ជួយ ខណ្ឌ ព្រែក ព្នៅ គណៈ អចិន្ត្រៃយ៍ គណបក្ស ខណ្ឌ សមាជិក សមាជិកា គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ សរុប ចំនួន ១៥២ នាក់ ។
សូម ជម្រាប ថា សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្ត ទី៥ កាលពី ថ្ងៃអាទិត្យ កន្លងទៅ នេះ មាន ប្រជាពលរដ្ឋ ប្រមាណ ជាង ៨០ .១៩ ភាគរយ បាន ទៅ បោះឆ្នោត ក្នុង ចំណោម ប្រជាពលរដ្ឋ ជាង ៩.២លាន នាក់ ដែល មាន ឈ្មោះ នៅក្នុង បញ្ជី បោះឆ្នោត ។
គណបក្ស នយោបាយ ចំនួន ១៧ បាន ចូលរួម ប្រកួតប្រជែង ក្នុង ការបោះឆ្នោត នៅ មូលដ្ឋាន នេះ ខណៈ ដែល គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស កាន់អំណាច ទទួលបាន សំឡេង នាំមុខ គេ នៅ គ្រប់ បណ្តា រាជធានី ខេត្ត ទូទាំង ប្រទេស ៕ ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ វាល ម្លូរ ស្រុក ពញា ក្រែក ថ្លែងអំណរគុណ ពលរដ្ឋ ដែល បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា កើនឡើង ចំនួន ២អាសនៈ
( ត្បូងឃ្មុំ ) ៖ លោក ប៉ា ម៉េង ហុក ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ វាល ម្លូរ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ និង កោតសរសើរ ចំពោះ អាជ្ញាធរ មូលដ្ឋាន ឃុំ វាល ម្លូរ ដែល បាន ខិតខំ យ៉ាង សស្រាក់សស្រាំ ចុះ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ដោយ មិន ខ្លាច នឿយហត់ ទើប ទទួលបាន ការគាំទ្រ ពី ប្រជាពលរដ្ឋ យ៉ាង ច្រើន លើសលប់ ដូច អាណត្តិ នេះ កើនឡើង៦ លើ ៧ អាសនៈ ។
ការថ្លែងអំណរគុណ បែប នេះ របស់ លោក ប៉ា ម៉េង ហុក បាន ធ្វើឡើង ក្នុង ឱកាស លោក អញ្ជើញ ជួប សំណេះសំណាល និង ប្រគល់ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ជូន លោកគ្រូ អ្នកគ្រូ និង អាជ្ញាធរ ឃុំ វាល ម្លូរ នៅ ស្នាក់ការបក្ស ឃុំ វាល ម្លូរ នា ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២២ នេះ ។
លោក ប៉ា ម៉េង ហុក សង្ឃឹម យ៉ាង មុតមាំ ថា សម្រាប់ អាណត្តិ ថ្មី នេះ គណបក្ស ប្រជាជន កម្ពុជា នឹង មាន ប្រជាពលរដ្ឋ គាំទ្រ ច្រើន ខណៈ សមាជិក យើង បាន ខិតខំ ប្រឹងប្រែង បំពេញ តួនាទី ភារកិច្ច បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ និង ឈានដល់ យក ជ័យលាភី ឈ្នះ នៅ ថ្ងៃ បោះឆ្នោត សកល ក្នុង អាណត្តិ ទី៥ ខាងមុខ នេះ ។
គូសបញ្ជាក់ ថា ជា លទ្ធផល ក្នុង ឃុំ វាល ម្លូរ នៃ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ អាណត្តិ ទី៥នេះ មាន ប្រជាពលរដ្ឋ ចំនួន ៤.៣៤០ នាក់ បាន អញ្ជើញ ទៅ បោះឆ្នោត ចំនួន ៧២. ១៥% ភាគរយ នៃ ចំនួន សមាជិក បក្ស សរុប ។ ជា លទ្ធផល ក្នុង ទូទាំង ឃុំ វាល ម្លូរ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន ៦/ ៧អាសនៈ ។
ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ វាល ម្លូរ បាន ប្រគល់ អំណោយ របស់ ក្រុមហ៊ុន REVLON ជូន ដល់ លោកគ្រូ អ្នកគ្រូ ចំនួន ៧០ នាក់ ក្នុង ម្នាក់ ទទួលបាន មួក សុវត្តិភាព១ ឆាត១ ច្រាស ដុះ ធ្មេញ៣០ ទឹក អប១ ប្រអប់ កាតាប ស្ទាយ១ ថ្នាំ លាប សក់ ៣ ប្រអប់ ព្រមទាំង ប្រគល់ ឃីត ចំនួន ២៥៨៥ កញ្ចប់ ជូន ដល់ អាជ្ញាធរ ភូមិ យក ទៅ ចែកជូន សមាជិក បក្ស នៅ មូលដ្ឋាន រៀង ៗ ខ្លួន ផងដែរ ៕
ការនាំចេញ គ្រាប់ ធញ្ញជាតិ អ៊ុយក្រែន តាមរយៈ ប្រទេស ប៉ូឡូញ និង រ៉ូមានី ប្រឈម នឹង ឧបសគ្គ រាំងស្ទះ
( កៀវ) ៖ អនុ រដ្ឋមន្ត្រី ការបរទេស អ៊ុយក្រែន បាន ឲ្យដឹង នៅ អាទិត្យ នេះ ថា អ៊ុយក្រែន បាន បង្កើត ផ្លូវ ពីរ ឆ្លងកាត់ ប្រទេស ប៉ូឡូញ និង រូម៉ានី ដើម្បី នាំចេញ គ្រាប់ ធញ្ញជាតិ និង បញ្ចៀស វិបត្តិ ស្បៀងអាហារ សកល ទោះបីជា មាន ឧបសគ្គ រាំងស្ទះ បាន ធ្វើឱ្យ ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ មាន ការយឺតយ៉ាវ ក៏ដោយ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី ១២ ខែមិថុនា ឆ្នាំ ២០២២ ។
គួរ បញ្ជាក់ ថា អ៊ុយក្រែន គឺជា ប្រទេស នាំចេញ គ្រាប់ ធញ្ញជាតិ ធំ ជាង គេ ទី បួន របស់ ពិភពលោក ខណៈ នា ពេល បច្ចុប្បន្ន មាន គ្រាប់ ធញ្ញជាតិ ប្រហែល ៣០លាន តោន កំពុង ជាប់គាំង នៅក្នុង ប្រទេស អ៊ុយក្រែន ដែល អាជ្ញារ ធរ ប្រទេស នេះ កំពុង ព្យាយាម នាំចេញ តាម ផ្លូវថ្នល់ ទន្លេ និង ផ្លូវ ដែក ។
ទោះជា យ៉ាងណា ក្នុង របាយការណ៍ ថ្ងៃអាទិត្យ នេះ ដែរ វៀតណាម ពុំ បាន រកឃើញ ករណី អ្នកស្លាប់ ថ្មី ទេ ។
( ភ្នំពេញ ) ៖ លោក អៀង សុធារ៉ា ពាណិជ្ជករ ល្បី ឈ្មោះ មួយ រូប នៅក្នុង ប្រទេស កម្ពុជា បាន ពន្យល់ ពី « ឥទ្ធិបាទ ធម៌ » ដែល មាន ន័យ ថា ធម៌ ឬ គោលការណ៍ មាន លក្ខណៈ ដូចជា ជំហាន ឆ្ពោះ ទៅរក សេចក្ដីសម្រេច សេចក្ដីចម្រើន និង ជោគជ័យ ក្នុង អាជីវកម្ម ។
( ៣) ចិត្តៈ គឺ ការយកចិត្តទុកដាក់ លើ គោលបំណង និង សកម្មភាព នានា ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់
( ៤) វីមំសា គឺ ការពិចារណា . ការវិភាគ ការប្រើ បញ្ញា ដើម្បី សម្រេចបាន នូវ ឆន្ទ
ក្រុមហ៊ុន ណា ដែល អនុវត្ដ តាម « ឥទ្ធិបាទ ធម៌ » នឹង ជួយ ឲ្យ អាជីវកម្ម ទទួលបាន ជោគជ័យ ត្រូវបាន លោក អៀង សុធារ៉ា ពន្យល់ យ៉ាង ដូច្នេះ៖
* ឆន្ទៈ៖ ការងារ ទាំងឡាយ ទាំងពួង ត្រូវ មាន ឆន្ទៈ ដែល និយាយ ឲ្យ ខ្លី គឺជា បំណងប្រាថ្នា ពិតប្រាកដ របស់ ខ្លួន ឯង ។ ឧទាហរណ៍៖ ចង់បាន អ្វី មួយ ប្រកបដោយ គុណធម៌ ។
* វិរិយៈ៖ ជា ការព្យាយាម ដោយ ឧស្សាហ៍ ប្រឹងប្រែង ទាំង យប់ ទាំង ថ្ងៃ ដោយ ត្រូវ ព្យាយាម អ្វី ដែល ល្អ សម្រាប់ ខ្លួន ឯង ។ ឧទាហរ ណ៍៖ ខ្លួន យើង កំពុង ធ្វើការ នៅ កន្លែង ណាមួយ ត្រូវតែ ឧស្សាហ៍ ព្យាយាម កុំ ខ្ចិល ។
* ចិត្តៈ៖ គឺ ការយកចិត្តទុកដាក់ លើ គោលបំណង និង សកម្មភាព នានា ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ មិន បោះបង់ ការងារ នោះ ដោយ ងាយ ៗ មាន ចិត្ត ស្ងប់ ក្នុង ការដោះស្រាយ បញ្ហា ចិត្ត មាន សមាធិ ក្នុង ការងារ ។ ឧទាហណ៍៖ នៅពេល យើង ធ្វើ អ្វី មួយ មាន ចិត្ត អត់ធ្មត់ មិន ខឹង ផ្តេសផ្តាស មាន សតិ គ្រប់ ពេលវេលា
* វីមំសា៖ ជា ការធ្វើ អ្វី មួយ ដោយ មាន ការវាយតម្លៃ ស្រប ពេល គ្នា និង ធ្វើ អ្វី មួយ ត្រូវ គិត រក ហេតុផល ថា អ្វី ដែល កំពុង ធ្វើ ជួប ការលំបាក អ្វី ហើយ ត្រូវ រក វិធី ដោះស្រាយ យ៉ាងណា ។ ឧទាហរណ៍៖ យើង ធ្វើការ នៅ កន្លែង ណាមួយ ហើយ កន្លែង នោះ ដាក់ ការងារ មក ឲ្យ យើង ធ្វើ យើង ត្រូវ ចេះ គិត ភ្លាម ៗ ថា អ្វី ដែល ធ្វើ នោះ ធ្វើ យ៉ាងណា ឲ្យ មាន ភាពងាយស្រួល និង ឆាប់រហ័ស ។
លោក អៀង សុធារ៉ា បាន គូសបញ្ជាក់ ថា កាលណា ក្រុមហ៊ុន ក្នុង គ្រប់ ផ្នែក ទាំងអស់ អនុវត្ដ តាម ឥទ្ធិបាទធម៌ ទាំង ៤យ៉ាង នេះ គឺ ក្រុមហ៊ុន ទាំងអស់ នឹង មាន ការសម្រេច ជោគជ័យ ជាក់ ជា មិន ខាន ខណៈ ក្រុមហ៊ុន ធំ ៗ នៅលើ ពិភពលោក គឺ បាន អនុវត្ដ តាម ឥទ្ធិបាទធម៌ ទាំង ៤យ៉ាង នេះ ហើយ ទទួលបាន ជោគជ័យ ជាច្រើន ក្រុមហ៊ុន ។
លើស ពី នោះ ទៀត លោក អៀង សុធារ៉ា បាន លើកឡើង ថា បើសិនជា សង្គមជាតិ ទាំងមូល ប្រជាពលរដ្ឋ មាន ឆន្ទៈ រួម ដែល មាន នៅក្នុង « ឥទ្ធិបាទ ធម៌ » ដោយ មាន គំនិត ថា កុំ ធ្វើ អ្វី មិន ល្អ ដោយ នាំគ្នា ធ្វើ អ្វី ដែល នាំឲ្យ តែ សុខ ចម្រើន និង មាន ប្រយោជន៍ ទៅ វិញ ទៅ មក លោក គិត ថា នឹង ជួយ ដល់ ប្រទេស កម្ពុជា បាន ច្រើន ដែល នាំឲ្យ បាន ចម្រើន ទាំង ចំណេះ និង ទ្រព្យសម្បត្ដិ ៕ គ្រឿងញៀន ជា សត្រូវ បំផ្លាញ អនាគត ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១២ ខែមិថុនា៖ បង្ក្រាប ១៤ករណី ឃាត់ខ្លួន ២១ នាក់
