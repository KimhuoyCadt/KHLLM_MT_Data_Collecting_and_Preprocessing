( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៣ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ដឹកជញ្ជូន រក្សាទុក ៤ករណី និង ជួញដូរ ៦ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥៣ នាក់ ។
ព្រឹក ស្អែក នាយក រដ្ឋមន្ត្រី កម្ពុជា និង វៀតណាម អញ្ជើញ ប្រារព្ធ ពិធី អបអរសាទរ ខួប ៤៥ ឆ្នាំ នៃ ដំណើរ ឆ្ពោះ ទៅរក ការតស៊ូ រំដោះ ជាតិ
( ភ្នំពេញ ) ៖ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២២ ស្អែក នេះ គឺជា រយៈពេល ៤៥ ឆ្នាំ ហើយ ដែល សម្តេច តេជោ ហ៊ុន សែន និង យុទ្ធ មិត្ត រួម អាវុធ ដ៏ ស្មោះស្ម័គ្រ ៤រូប បាន រួមគ្នា យក ជីវិត ធ្វើជា ដើមទុន ចេញ ទៅកាន់ ប្រទេស វៀតណាម ស្វែងរក ការគាំទ្រ ដើម្បី តស៊ូ រំដោះ ជាតិ និង ប្រជាជន កម្ពុជា ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ដ៏ ឃោរឃៅ របស់ ខ្មែរ ប៉ុល ពត និង បក្ខពួក ។
ក្រុម អ្នកប្រវត្តិសាស្ត្រ ខ្មែរ បាន មើលឃើញ ប្រសិនបើ គ្មាន ការចាប់ផ្តើម ចេញ តស៊ូ របស់ សម្តេច តេជោ ហ៊ុន សែន និង ឥស្សរជន ខ្មែរ ស្នេហាជាតិ នាំគ្នា ងើប ប៉ះ បោរ រំដោះ ជាតិ ឡើង ទេ នោះ ជាតិ និង ប្រជាជន កម្ពុជា គ្មាន ឱកាស រួចផុត ពី របប ដ៏ ប្រល័យ របស់ ប៉ុល ពត នោះ ឡើយ ។
ពី ទីតាំង កោះ ថ្ម នា រាត្រី ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ១៩៧៧ បាន ក្លាយជា ទិវា មួយ ដ៏ សំខាន់ នៃ របត់ ប្រវត្តិសាស្រ្ត ប្រទេស កម្ពុជា ជា ពេលវេលា ដែល សម មិត្ត ហ៊ុន សែន បាន ចាប់ផ្តើម ដំណើរ ឆ្ពោះ ទៅកាន់ ការផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ... ៕ ជនសង្ស័យ ដែល ជា មុខសញ្ញា ឆក់ ទូរស័ព្ទ ៣នាក់ ត្រូវ នគរបាល ឃាត់ខ្លួន ក្នុង ខណ្ឌ កំបូល
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល នៃ អធិការដ្ឋាន ខណ្ឌ កំបូល ខណៈ ចេញ ល្បាត បាន ប្រទះឃើញ យុវជន ២នាក់ កំពុង ឈរ តាម ផ្លូវ គួរសង្ស័យ ក៏ បាន ធ្វើ ការចាប់ខ្លួន រួច បាន នាំ ទៅ ធ្វើ ការសាកសួរ ភ្លាម ៗ ។
ពេល នោះ ជនសង្ស័យ បាន សារភាព ថា ពួក ខ្លួន រួម ជាមួយ បក្សពួ ម្នាក់ ទៀត សរុប មាន គ្នា ៣នាក់ បាន ធ្វើ សកម្មភាព ឆក់ យក ទូរស័ព្ទ១ គ្រឿង ពី ស្រ្តី ម្នាក់ កាលពី ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ វេលា ម៉ោង ប្រហែល ៦៖៣០ នាទី ល្ងាច ។
យោង តាម របាយការណ៍ របស់ នគរបាល ខណ្ឌ កំបូល បាន ឲ្យដឹង ថា ជនសង្ស័យ ទាំង ៣នាក់ នោះ ទី ១៖ ឈ្មោះ ហ៊ុន ហុង អាយុ ១៨ ឆ្នាំ ទី២៖ ឈ្មោះ ម៉ូវ ធារ៉ា អាយុ ១៩ ឆ្នាំ ទី៣៖ ឈ្មោះ ហ៊ុន ហេង អាយុ ១៩ ឆ្នាំ ។ ពួកគេ ទាំង ៣នាក់ សុទ្ធតែ មាន សារធាតុ ញៀន ក្នុង ខ្លួន ហើយ មាន ទីលំនៅ ផ្ទះ គ្មាន លេខ ស្ថិត នៅ តាម ផ្លូវ លំ ភូមិ ត្មាត ពង សង្កាត់ បឹង ធំ ខណ្ឌ កំបូល ។
របាយការណ៍ ដដែល បាន បញ្ជាក់ ថា ក្រុម ជនសង្ស័យ បាន ឆក់ ទូរស័ព្ទ ពី ស្រ្តី ម្នាក់ មិន ស្គាល់ អត្តសញ្ញា នៅ តាម ផ្លូវ ជាតិ លេច៤ ត្រង់ ចំណុច មុខ ស្ថានីយ៍ ប្រេងឥន្ធនៈ តេលា ស្ថិត នៅក្នុង ភូមិ ស្ងួន ពេជ្រ សង្កាត់ កន្ទោក ខណ្ឌ កំបូល កាលពី វេលា ម៉ោង ប្រហែល ៦៖៣០ នាទី ល្ងាច ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ ។ បន្ទាប់មក បាន គេចខ្លួន បាត់ ស្រមោល ចំណែកឯ ស្រ្តី រងគ្រោះ ពុំ បាន ដាក់ពាក្យបណ្ដឹង ទេ លុះ ក្រោយពេល កើត ហេតុ ស្រ្តី រូប នោះ ក៏ បាន ចាកចេញ ពី កន្លែង កើត ហេតុ ទៅ បាត់ តែ ផងដែរ ។
ប្រភព ដដែល បាន បន្ត ថា រហូតដល់ ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០២២ នគរបាល ខណ្ឌ កំបូល បាន ចុះល្បាត ហើយ បាន ប្រទះឃើញ ជនសង្ស័យ ២នាក់ គឺ ឈ្មោះ ហ៊ុន ហុង និង ឈ្មោះ ម៉ូវ ធារ៉ា កំពុង ឈរ លេង នៅមុខ ផ្ទះ នៅ ត្រង់ ចំណុច ភូមិ ត្មាត ពង សង្កាត់ បឹង ធំ ។ ពេល នោះ ដោយ មាន ការសង្ស័យ ក៏ បាន នាំ ខ្លួន ទៅ ធ្វើ ការសួរនាំ នៅ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល កន្ទោក ។ ប៉ុន្តែ នគរបាល ពុំ បាន ចម្លើយ សារភាព ពី ជន ទាំង ២នាក់ ភ្លាម ៗ ឡើយ ។
រហូតដល់ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០២២ ទើប ជនសង្ស័យ ទាំង ២នាក់ នេះ សារភាព ថា ពួកគេ ទាំង ២នាក់ រួម ជាមួយ បក្សពួក ម្នាក់ ទៀត ឈ្មោះ ហ៊ុន ហេង បាន សកម្មភាព ឆក់ ទូរស័ព្ទ ពី ស្រ្តី ម្នាក់ ត្រង់ ចំណុច មុខ ស្ថានីយ៍ ប្រេងឥន្ធនៈ តេលា ស្ថិត នៅក្នុង ភូមិ ស្ងួន ពេជ្រ សង្កាត់ កន្ទោក ខណ្ឌ កំបូល កាលពី ល្ងាច ថ្ងៃទី ១៣ ខែមិថុនា ។
បន្ទាប់មក នគរបាល ក៏ បាន បន្ត ទៅ ឃាត់ខ្លួន ឈ្មោះ ហ៊ុន ហេង នៅ ចំណុច ភូមិ ត្មាត ពង សង្កាត់ បឹង ធំ រួច កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ចាត់ការ តាម ផ្លូវ ច្បាប់ ៕
ក្រុមការងារ និង គណបក្ស ខេត្ត ក្រចេះ ប្រជុំ បូកសរុប លទ្ធផល ការងារ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២
( ក្រចេះ ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ ខេត្ត ក្រចេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ នៅ ខេត្ត ក្រចេះ ។
គណបក្ស ប្រជាជន កម្ពុជា កាន់ តំណែង ជា មេឃុំ និង ចៅសង្កាត់ ទាំងអស់ ក្នុង ឃុំ សង្កាត់ ទាំង ៤៨ ប្រៀប នឹង ឆ្នាំ ២០១៧ គណបក្ស ប្រជាជន កម្ពុជា ធ្លាប់ បាត់ តំណែង មេឃុំ ចៅសង្កាត់ ចំនួន ៩ ។
លើក នេះ គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ ដាច់ ៧ឃុំ គឺ ៣ឃុំ ក្នុង ស្រុក សំបូរ មាន ឃុំ បឹង ចារ ឃុំ រលួសមានជ័យ ឃុំ អូរ គ្រៀង សែន ជ័យ និង ៣ឃុំ ក្នុង ស្រុក ឆ្លូង មាន ឃុំ ព្រែក សាម៉ាន់ ឃុំ កំពង់ដំរី និង ឃុំ ខ្សាច់ អណ្ដែត ព្រមទាំង ឃុំ កោះ ជ្រែង ១ ទៀត នៅ ស្រុក ចិត្រ បុរី ។
បន្ទាប់ពី តំណាង អង្គប្រជុំ បាន ចូលរួម ពិភាក្សា យ៉ាង ផុល ផុស បំពេញ បន្ថែម លើ ការវាយតម្លៃ លទ្ធផល នៃ ការងារ បោះឆ្នោត រួច មក លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ ខេត្ត ក្រចេះ បាន ថ្លែង មតិ បូកសរុប ដក ពិសោធន៍ ការងារ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ នៅ ខេត្ត ក្រចេះ ដោយ បាន សង្កត់ធ្ងន់ លើ ខ្លឹមសារ សំខាន់ ៣ចំណុច៖
២៖ ជ័យ ជំនះ ដ៏ ត្រចះត្រចង់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្រោម មគ្គុទេសក៍ ដ៏ ថ្លៃថ្លា របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ដែល ទទួលបាន ការគាំទ្រ ភ្លូក ទឹក ភ្លូក ដី ពី ប្រជាជន សបញ្ជាក់ ច្បាស់ ពី ឆន្ទៈ រួម ដែល ជា បំណងប្រាថ្នា តែ មួយ គត់ របស់ ប្រជាជន កម្ពុជា គឺ សុខ សន្តិភាព វឌ្ឍនភាព វិបុលភាព សម្រាប់ អនាគត រុងរឿង របស់ កម្ពុជា ។
៣៖ ដើម្បី ឆ្លើយតប ចំពោះ ជំនឿ ទុកចិត្ត របស់ ប្រជាជន មក លើ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្រុមការងារ និង គណបក្ស គ្រប់ លំដាប់ថ្នាក់ ត្រូវ ពុះពារ សំរេច ភារកិច្ច នយោបាយ ក្នុង បន្ទុក ទទួលខុសត្រូវ រៀង ៗ ខ្លួន បន្ត ចូលរួមចំណែក កាន់តែ ខ្លាំងក្លា ថែម ទៀត ដើម្បី រក្សា ឧត្ដមភាព ប្រៀប ឈ្នះ របស់ គណបក្ស ប្រជាជន កម្ពុជា ឈាន ទៅ ដណ្ដើម ជ័យ ជំនះ សម្រាប់ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្ត្រ អាណត្តិ ទី៧ នា ឆ្នាំ ២០២៣ ខាងមុខ ទៀត ៕
បើ តាម ក្រុម មន្ត្រី អ៊ុយក្រែន ក្រុម អ្នក ពន្លត់ អគ្គិភ័យ នៅតែ បន្ត ព្យាយាម ពន្លត់ ភ្លើង ដែល ឆាបឆេះ ដោយសារតែ ការវាយប្រហារ ដោយ មីស៊ីល ខាងលើ ពីសំណាក់ ទាហាន រុស្ស៉ី ដែល កំពុង បង្កើន ការវាយលុក លើ តំបន់ ដុន បាស់ ភាគ ខាងកើត ប្រទេស អ៊ុយក្រែន ។
គួរ បញ្ជាក់ ថា ការវាយប្រយុទ្ធ គ្នា រវាង រុស្ស៉ី និង អ៊ុយក្រែន នៅក្នុង តំបន់ ដុន បាស់ បាន ឈានដល់ ដំណាក់កាល ដ៏ សំខាន់ នៅឯ ទីក្រុង ស៊ីវី យេរ៉ូដូណេត ដែល លោក ហ្សេលេន ស្គី ចាត់ទុក ថា ជា ទីក្រុង យុទ្ធសាស្ត្រ ដ៏ សំខាន់ អាច កំណត់ អ្នក ឈ្នះ អ្នកចាញ់ ក្នុង សង្រ្គាម នៅ ភាគ ខាងកើត ប្រទេស ។ រុស្ស៉ី ត្រូវបាន គេ រាយការណ៍ ថា កំពុង វាយ រុល ទៅ មុខ ដោយ សន្សឹម ៗ រីឯ អ៊ុយក្រែន កំពុង ទទូច ឱ្យ បណ្ដា ប្រទេស ខាងលិច បញ្ជូន អាវុធ បន្ថែម មក ឱ្យ ទីក្រុង កៀវ ជាបន្ទាន់ ៕
ខួប លើក ទី ១៥ ទិវា អតីត យុទ្ធជន កម្ពុជា ! នាយ ឧត្តមសេនីយ៍ គន់ គីម៖ ១៥ឆ្នាំ កន្លងទៅ នេះ សម្ដេច តេជោ ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា បាន គិតគូរ យ៉ាង ខ្លាំង ពី សុខ ទុក្ខ របស់ អតីត យុទ្ធជន កម្ពុជា
ស្ថិត នៅក្នុង ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល . លោក ឧត្តមសេនីយ៍ ត្រី នៃ និយម មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត កណ្ដាល . លោក ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត ស្នងការ នគរបាល ខេត្ត កណ្ដាល . លោក ឧត្តមសេនីយ៍ ត្រី សំ តុលា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កណ្ដាល និង មន្ត្រី ជាច្រើន អ្នក ព្រមទាំង បងប្អូន អតីត យុទ្ធ សរុប ៣៦០ នាក់ ផងដែរ ។
ជាមួយគ្នា នេះ ដែរ នាយ ឧត្តមសេនីយ៍ គន់ គីម បាន ពាំនាំ នូវ ការ សួរសុខទុក្ខ និង សេចក្តីនឹក រឭក ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ដល់ លោកយាយ លោក តា បងប្អូន មីង មា និង សាច់ញាតិ ទាំងអស់ របស់ អតីត យុទ្ធជន ដែល សម្ដេច មាន សេចក្តីនឹក រឭក ជាខ្លាំង និង សូម ជូនពរ អោយ បងប្អូន អតីត យុទ្ធជន យើង ទាំងអស់ មាន សុខភាពល្អ ទាំងអស់ គ្នា ផងដែរ ។
វេទិកា ពិភាក្សា តុ មូល នេះ មាន វាគ្មិន ចូលរួម ដូច ជា៖ លោក នួន ផារ័ត្ន សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( សសយក ) . លោក ពុយ គា អ្នកឆ្លើយឆ្លង ទីភ្នាក់ងារ ព័ត៌មាន ក្យូ ដូ ជប៉ុន ប្រចាំ កម្ពុជា . លោក ប៉ែន បុណា ប្រធាន ក្លឹប អ្នកកាសែត កម្ពុជា . បណ្ឌិត ឌៀប សុផល សាស្ត្រាចារ្យ ប្រវត្តិសាស្ត្រ នយោបាយ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ។ ចំណែក លោក ជុំ កុសល រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ជា អ្នកសម្របសម្រួល ។
អភិបាល ខេត្ត ស្វាយរៀង ចុះ ពិនិត្យមើល វឌ្ឍនភាព នៃ ការអភិវឌ្ឍ នៅ ស្រុក ចន្ទ្រា និង គ្រោង ធ្វើ ផ្លូវ បេតុង ៤០០០ ម៉ែត្រ និង ស្ពាន ប្រវែង ២០ម៉ែត្រ និង ដាក់ លូរំដោះ ទឹក ប្រវែង ៨០០ ម៉ែត្រ
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង អម ដំណើរ ពីសំណាក់ លោក អភិបាល រង ខេត្ត លោក ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត លោក នាយក ទី ចាត់ការ ហិរញ្ញវត្ថុ សាលា ខេត្ត នៅ ថ្ងៃទី ១៨ ខែមិថុនា ឆ្នាំ ២០២២ បាន ចុះ ពិនិត្យ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ នៅ មូលដ្ឋាន ស្រុក ចន្ទ្រា ។
មន្ត្រី សាលា ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង ថា នៅ ថ្ងៃ ម្សិលមិញ នេះ លោក អភិបាល ខេត្ត ស្វាយរៀង បាន ចុះ ពិនិត្យមើល វឌ្ឍនភាព នៃ ការអភិវឌ្ឍន៍ របស់ ខេត្ត នៅ ស្រុក ចន្ទ្រា និង រៀបចំ ធ្វើ ផ្លូវ ចាក់ បេតុង ប្រវែង ៤០០០ ម៉ែត្រ ចាប់ពី សង្កាត់ ព្រៃ អង្គុញ ក្រុង បាវិត ដល់ ឃុំ ព្រៃ គគី ស្រក ចន្ទ្រា ។
បន្ថែម លើស ពី នេះ គ្រោង រៀបចំ ធ្វើ ស្ពាន ថ្មី ( ស្ពាន តាអឹម ) ស្ថិត នៅ ភូមិ ដីក្រហម ឃុំ មេស ថ្ង ក ជា ស្ពាន បេតុង មាន បណ្តោយ ប្រវែង ២០ម៉ែត្រ ទទទឹង ៨ម៉ែត្រ និង គ្រោង រៀបចំ ធ្វើ ផ្លូវ ចាក់ បេតុង និង ដាក់ លូរំដោះ ទឹក ប្រវែង ៨០០ ម៉ែត្រ នៅ ភូមិ ចេក ឃុំ សំរោង ស្រុក ចន្ទ្រា ដល់ ព្រំដែន ប្រទេស វៀតណាម ។
លោក មិត្ត ការ៉េន សម្ពោធ ឆ្លង កុដិ របង និង សមិទ្ធផល នានា ក្នុង វត្ត សិរី ចន្ទា រាម ( បាស្រី ) ក្នុង ស្រុក ព្រះស្តេច
( ព្រៃវែង ) ៖ នា ព្រឹក ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២២ លោក មិត្ត ការ៉េន អគ្គ លេខាធិការ រង រដ្ឋសភា និង លោកស្រី សោម សុគន្ធា បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី សម្ពោធ ឆ្លង កុដិ របង និង សមិទ្ធផល នានា ក្នុង បរិវេណ វត្ត សិរី ចន្ទា រាម ( បាស្រី ) ស្ថិត នៅក្នុង ឃុំ ជៃ កំពក ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ។
អម ដំណើរ គណៈអធិបតី នា ឱកាស នោះ រួម មាន លោក ហង្ស វិចិត្រ សមាជិក គណ:កម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ជៃ កំពក និង ភរិយា ក្រុមការងារ ចុះ ជួយ ឃុំ ជៃ កំពក អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ប្រមាណ ៤០០ នាក់ ។
លោក អភិបាល ស្រុក ក៏ បាន សម្តែង នូវ ការការដឹង គុណ ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ព្រមទាំង ថ្នាក់ដឹកនាំ ទាំងអស់ ដែល តែងតែ យកចិត្ត ទុក្ខ ខ្ពស់ ចំពោះ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ក៏ ដូចជា ប្រជាពលរដ្ឋ ក្នុង ស្រុក ព្រះស្តេច ដែល ទទួលបាន នូវ សមិទ្ធផល នានា ជា បន្តបន្ទាប់ ទាំង ផ្នែក ពុទ្ធ ចក្រ និង អាណាចក្រ ឲ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ។
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ចុះ ពិនិត្យ វឌ្ឍនភាព និង សំណេះសំណាល ជាមួយ មន្ត្រី នៃ មន្ទីរព័ត៌មាន ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញារីទ្ធ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ចុះ ពិនិត្យមើល វឌ្ឍនភាព និង សំណេះសំណាល ជាមួយ មន្ត្រី នៃ អង្គភាព មន្ទីរព័ត៌មាន ខេត្ត កំពង់ចាម ។
ទន្ទឹមនឹង នេះ ដែរ អង្គភាព មន្ទីរព័ត៌មាន ខេត្ត បាន ផលិត កម្មវិធី ផ្សាយ បន្ត ផ្ទាល់ តាម ទូរទស្សន៍ ក្នុង មួយ ថ្ងៃ ២ ម៉ោង ផងដែរ ។
លោកស្រី សម ផល្លា បាន បញ្ជាក់ ថា អ្វី ៗ ដែល ធ្វើឲ្យ មាន ការរីកចម្រើន ដល់ មន្ទីរព័ត៌មាន ខេត្ត កំពង់ចាម ដូច ពេលនេះ គឺ ដោយសារ មាន ការសហការ ល្អ ពី អាជ្ញាធរ និង មន្ទីរ ស្ថាប័ន គ្រប់ ជំនាញ ដែល រួម សហការ ក្នុង ការផ្សព្វផ្សាយ ព័ត៌មាន តាមរយៈ នាទី សន្ទនាមតិ ជាដើម ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា កន្លងទៅ នេះ មន្ទីរព័ត៌មាន ខេត្ត កំពង់ចាម ផលិត ព័ត៌មាន បាន លឿន និង បាន ល្អ ។
ទន្ទឹមនឹង នេះ លោក រដ្ឋមន្ត្រី ក៏ បាន ណែនាំឲ្យ អង្គភាព មន្ទីរព័ត៌មាន ខេត្ត ត្រៀម រៀបចំ ផលិត ព័ត៌មាន អំពី ការអភិវឌ្ឍ ៥ឆ្នាំ របស់ ខេត្ត ដែល មាន រយៈពេល យ៉ាង ច្រើន ត្រឹម ៣០នាទី ដើម្បី ទុក ចូលរួម ផ្សព្វផ្សាយ ក្នុង ពិធី បិទ សន្និបាត បូកសរុប ការងារ របស់ ក្រសួង ព័ត៌មាន នា ពេល ខាងមុខ ៕យល់ដឹង ពី ជំនួញ៖ ប្រធាន សមាគម អះអាង ពី ភាពរឹងមាំ នៃ វិស័យ ធានារ៉ាប់រង និង ប្រាប់ ពលរដ្ឋ កុំ បារម្ភ រឿង ប្រាក់ សំណង (Video inside)
( ភ្នំពេញ ) ៖ លោក ហ៊ុយ វ៉ាថា រ៉ូ ប្រធាន សមាគម ធានារ៉ាប់រង កម្ពុជា បាន អះអាង ពី ភាពរឹងមាំ នៃ វិស័យ ធានារ៉ាប់រង នៅក្នុង ប្រទេស កម្ពុជា និង ប្រាប់ ឲ្យ ប្រជាពលរដ្ឋ កុំ បារម្ភ រឿង ប្រាក់ សំណង ដោយ បាន គូសបញ្ជាក់ ថា ក្រុមហ៊ុន ធានារ៉ាប់រង នៅ កម្ពុជា សុទ្ធតែ មាន ភាពរឹងមាំ ផ្នែក ហិរញ្ញវត្ថុ ដែល អាច បំពេញ កាតព្វកិច្ច របស់ ខ្លួន បាន ។
អ្វី ជា ជំនឿចិត្ដ សម្រាប់ អ្នកប្រើប្រាស់ ធានារ៉ាប់រង នៅពេល ផ្ដល់ លុយ ឲ្យ ក្រុមហ៊ុន ធានារ៉ាប់រង ហើយ ពេល ជួប បញ្ហា ទទួលបាន សំណង ត្រឡប់ មកវិញ ? ត្រូវបាន លោក ហ៊ុយ វ៉ាថា រ៉ូ បាន ឲ្យដឹង ថា វិស័យ ធានារ៉ាប់រង ជា វិស័យ មួយ ស្ថិត នៅក្រោម ការគ្រប់គ្រង ត្រួតពិនិត្យ ដោយ អាជ្ញាធរ មាន សមត្ថកិច្ច ច្បាស់លាស់ និង មាន បទបញ្ញត្ដិ ត្រឹមត្រូវ ។
លោក ហ៊ុយ វ៉ាថា រ៉ូ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ក្រុមហ៊ុន ធានារ៉ាប់រង គឺ តម្រូវឲ្យ អនុវត្ដ តាម បទបញ្ញត្ដិ ដែល ចេញ ដោយ និយ័តករ ធានារ៉ាប់រង នៃ អាជ្ញាធរ សេវា ហិរញ្ញវត្ថុ មិន មែន ធនាគារ ដើម្បី សំដៅ ជា គោលការណ៍ មួយ ក្នុង ចំណោម បទបញ្ញត្ដិ គឺ ធានា ថា ក្រុមហ៊ុន ធានារ៉ាប់រង ទាំងអស់ មាន ភាពរឹងមាំ ផ្នែក ហិរញ្ញវត្ថុ ដែល អាច បំពេញ កាតព្វកិច្ច របស់ ខ្លួន បាន នា ពេល អនាគត » ។
លោក ហ៊ុយ វ៉ាថា រ៉ូ បាន គូសបញ្ជាក់ ថា អតិថិជន ដែល ទិញ ប័ណ្ណ ធានារ៉ាប់រង គឺ ត្រូវបាន ទទួល ការការពារ ដែល មាន ន័យ ថា នៅ ពេល ដែល មាន ហេតុការណ៍ អ្វី កើតឡើង ដែល ត្រូវ ទទួល សំណង ត្រូវ មាន យុទ្ធ ការ ច្បាស់លាស់ សម្រាប់ ក្រុមហ៊ុន ធានារ៉ាប់រង ទូទាត់ សំណង ទៅឲ្យ អតិថិជន ។
បន្ថែម ពី នោះ ទៀត ថា លោក បាន បញ្ជាក់ ថា រាល់ ការទិញ សន្យា ធានារ៉ាប់រង នៅក្នុង ប័ណ្ណ សន្យា ធានារ៉ាប់រង ក្រុមហ៊ុន ធានា រ៉ប់ រង តែងតែ ដាក់ បង្ហាញ មួយ ថា តើ ហានិភ័យ អ្វី ខ្លះ ដែល គេ គ្របដណ្ដប់ នៅក្នុង កិច្ចសន្យា ធានារ៉ាប់រង ហើយ ប្រសិនជា មាន ហានិភ័យ កើតឡើង ស្រប តាម អ្វី ដែល កំណត់ ទៅ តាម លក្ខខណ្ឌ កិច្ចសន្យា ត្រូវ មាន ព័ត៌មាន បន្ថែម ពាក់ព័ន្ធ នឹង ទាមទារ សំណង ។
ទន្ទឹម គ្នា នេះ លោក ហ៊ុយ វ៉ាថា រ៉ូ បាន ឲ្យដឹង ថា នៅ ពេល ដែល បុគ្គល ធានា ខ្លួន ឯង បាន ទិញ ធានារ៉ាប់រង អាយុជីវិត ហើយ ជួយ រឿង អកុសល បាន ស្លាប់ បាត់បង់ជីវិត គឺ នៅក្នុង ប័ណ្ណ ធានារ៉ាប់រង តែងតែ មាន អ្នកទទួល ផល ជំនួស ដូច្នេះ នៅពេល គាត់ ទិញ ប័ណ្ណ ធានារ៉ាប់រង អាយុជីវិត សូម ប្រាប់ ទៅដល់ អ្នក ដែល ទទួល ផល ជំនួស ឲ្យបាន ដឹង ផងដែរ ។
ទោះបីជា អ្នកទទួល ផល មិន បាន ដឹង ជា គោលការណ៍ មួយ របស់ ក្រុមហ៊ុន ធានារ៉ាប់រង តែងតែ ព្យាយាម រក ហេតុផល មួយ ល្អ ៗ ដើម្បី សង សំណង ហើយ ជាទូទៅ ក្រុមហ៊ុន ធានារ៉ាប់រង មិន ព្យាយាម រក ហេតុផល មួយ ដើម្បី មិន សង សំណង នោះ ឡើយ ដែល នេះ សុទ្ធតែ គោលការណ៍ និង វិជ្ជាជីវៈ របស់ ក្រុមហ៊ុន ធានារ៉ាប់រង នីមួយ ៗ ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ហ៊ុយ វ៉ាថា រ៉ូ ។
សូម បញ្ជាក់ ថា សំណង ធានារ៉ាប់រង ដែល ក្រុម ធានារ៉ាប់រង បាន ទូទាត់ សង ជូន អតិថិជន ក្នុង ឆ្នាំ ២០២១ មាន ៤១. ២លាន ដុល្លារ អាមេរិក ក្នុង នោះ សំណង ធានារ៉ាប់រង អាយុជីវិត ១០.៦លាន ដុល្លារ អាមេរិក ( សំណង លើ ការស្លាប់ ប្រមាណ ៨.៣លាន ដុល្លារ ). សំណង ធានារ៉ាប់រង ទូទៅ ២៩. ៧លាន ដុល្លារ អាមេរិក និង សំណង ធានារ៉ាប់រង ខ្នាត តូច ៧៦ ម៉ឺន ដុល្លារ អាមេរិក ។
មកដល់ ពេលនេះ អ្នក ដែល ផ្ដល់ សេវា ធានារ៉ាប់រង ផ្ទាល់ គឺ ក្រុមហ៊ុន ធានារ៉ាប់រង មាន ចំនួន ៣៩ ក្រុមហ៊ុន ក្នុង នោះ បែងចែក ជា៣ ប្រភេទ រួម មាន៖ ក្រុមហ៊ុន ធានារ៉ាប់រង ទូទៅ មាន ចំនួន ១៨ ក្រុមហ៊ុន . ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត មាន ចំនួន ១៤ ក្រុមហ៊ុន . ក្រុមហ៊ុន ធានារ៉ាប់រង ខ្នាត តូច មាន ចំនួន ៧ក្រុមហ៊ុន និង ក្រុម ធានារ៉ាប់រង បន្ដ ចំនួន ១ ។
ក្រៅពី ក្រុមហ៊ុន ធានារ៉ាប់រង គឺ មាន អន្ដរ ការី ធានារ៉ាប់រង ដែល ជា អ្នក ផ្ដល់ សេវា ជំនួស ឲ្យ ក្រុមហ៊ុន ធានារ៉ាប់រង ដោយ មាន ក្រុមហ៊ុន ជើង សារធានារ៉ាប់រង ចំនួន ១៨ ក្រុមហ៊ុន . ក្រុមហ៊ុន ភ្នាក់ងារ ធានារ៉ាប់រង ចំនួន ៣១ ក្នុង នោះ ចំនួន គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ដែល ផ្តល់ សេវា ភ្នាក់ងារ ធានារ៉ាប់រង មាន ចំនួន ២៧ ។
គួរ បញ្ជាក់ ថា កូរ៉េ ខាងជើង បាន រាយការណ៍ ពី ករណី ជំងឺ ពោះវៀន ដំបូង កាលពី ថ្ងៃព្រហស្បតិ៍ កន្លងទៅ នេះ នៅក្នុង បរិបទ ដែល ប្រទេស មួយ នេះ កំពុង ប្រយុទ្ធត ស៊ូ នឹង ការឆ្លង រាលដាល នៃ ជំងឺ COVID-១៩ ស្រាប់ រួមទាំង បញ្ហា ខ្វះខាត ចំណីអាហារ ជាដើម ៕
