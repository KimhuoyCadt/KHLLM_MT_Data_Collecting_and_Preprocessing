( ភ្នំពេញ ) ៖ ក្នុង រយៈពេល ៥ខែ ឆ្នាំ ២០២២ នេះ ការដោះដូរ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង ទីផ្សារ អន្តរជាតិ មាន ចំនួន ២២ ពាន់ លាន ដុល្លារ អាមេរិក កើនឡើង ១៩. ៧% បើ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ ២០២១ មាន ទឹកប្រាក់ ១៨ ៧៦៨ លាន ដុល្លារ ។ នេះ បើ យោង តាម របាយការណ៍ ពី អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ។
របាយការណ៍ របស់ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន បញ្ជាក់ ថា ចាប់ពី ខែមករា ដល់ ខែឧសភា ការធ្វើ ពាណិជ្ជកម្ម របស់ កម្ពុជា ជាមួយ ទីផ្សារ អន្តរជាតិ មាន ទំហំ ២២ ៤៦៩ លាន ដុល្លារ កើនឡើង ប្រមាណ ១៩. ៧% ក្នុង នោះ ការនាំចេញ មាន តម្លៃ ៩៤១២ លាន ដុល្លារ កើនឡើង ៣៤. ៥% និង នាំចូល មកវិញ មាន តម្លៃ ១៣ ០៥៧ លាន ដុល្លារ កើនឡើង ១១% ។
ឧស្សាហកម្ម កាត់ដេរ សម្លៀកបំពាក់ និង ស្បែកជើង គឺជា វិស័យ ដែល រក ចំណូល ឱ្យ កម្ពុជា ច្រើន ជាង គេ ពោលគឺ រយៈពេល ៥ខែ នេះ ការនាំចេញ សម្លៀកបំពាក់ មាន តម្លៃ ជាង ៣ ៦៤២ លាន ដុល្លារ និង ស្បែកជើង មាន តម្លៃ ជាង ៧០២ លាន ដុល្លារ . ការនាំចេញ កៅស៊ូ រួមចំណែក ជាង ១៨៣ លាន ដុល្លារ កើនឡើង ២១.៦% . ម៉ាស៊ីន និង ឧបករណ៍ អគ្គិសនី ជាង ៦៣៩ លាន ដុល្លារ រួមទាំង ផលិត កសិកម្ម មួយ ចំនួន ទៀត ៕
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន ទទួល ជួប រដ្ឋលេខាធិការ ក្រសួង ការបរទេស និង ពាណិជ្ជកម្ម អូស្រ្តាលី
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា នៅ ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ បាន អនុញ្ញាតឲ្យ លោកស្រី Kathryn Campbell រដ្ឋលេខាធិការ នៃ ក្រសួង ការបរទេស និង ពាណិជ្ជកម្ម អូស្រ្តាលី ចូល ជួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ ។
ជំនួប នេះ បាន ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង ក្នុង ឱកាស ដែល លោកស្រី អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ៕ ក្រសួង សុខាភិបាល និង UNAIDS ប្ដេជ្ញា បន្ត ធ្វើការ ជា ដៃគូ យ៉ាង ជិតស្និទ្ធ ឆ្ពោះទៅ សម្រេចបាន គោលដៅ បញ្ចប់ ជំងឺ អេដស៍ នៅ កម្ពុជា ឆ្នាំ ២០២៥
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល និង អង្គការ UNAIDS បាន ប្ដេជ្ញា បន្ត ធ្វើការ ជា ដៃគូ យ៉ាង ជិតស្និទ្ធ ជាមួយគ្នា ឆ្ពោះទៅ សម្រេចបាន គោលដៅ នៃ ជំងឺ អេដស៍ សកល ឆ្នាំ ២០២៥ និង ការបញ្ចប់ ជំងឺ អេដស៍ ដែល ជា ការគំរាមកំហែង សុខភាព សាធារណៈ នា ឆ្នាំ ២០២៥ នៅ កម្ពុជា ។
លោកស្រី នាយី កា អង្គការ UNAIDS បាន សម្តែង នូវ ការកោតសរសើរ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ និង ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ដឹកនាំ គ្រប់គ្រង ការរីករាលដាល នៃ ជំងឺ កូរី ដ ១៩ អាច ឱ្យ បើក ដំណើរការប្រទេស បាន ឡើងវិញ ។
បន្ថែម ពី នេះ ទៀត លោកស្រី នាយិកា បាន គូស រំលេច សមិទ្ធផល សំខាន់ ៗ នៃ ការឆ្លើយតប នឹង មេរោគ អេដស៍ នៅ កម្ពុជា រួម មាន សេវា បង្ការ មេរោគ អេដស៍ ប្រកបដោយ ន វានុវត្តន៍ និង ខុស ៗ ប្លែក គ្នា ក្នុង ការផ្តល់ សេវា ធ្វើតេស្ត រក មេរោគ អេដស៍ និង សេវា ព្យាបាល ជូន ដល់ អ្នក ផ្ទុក មេរោគ អេដស៍ និង សហគមន៍ ប្រជាជន គន្លឹះ ។
លោកស្រី នាយិកា អង្គការ ប្ដេជ្ញា បន្ត ការចូលរួម ជាមួយ ក្រសួង សុខាភិបាល និង ដៃគូ ទាំងអស់ ក្នុង ដំណើរ ឆ្ពោះ ទៅរក ការឆ្លើយតប នឹង មេរោគ អេដស៍ ប្រកបដោយ និរន្តរភាព និង ការបញ្ចប់ ជំងឺ អេដស៍ នៅ កម្ពុជា ៕ ទីភ្នាក់ងារ បារាំង សម្រាប់ ការអភិវឌ្ឍ និង សហគមន៍ អឺរុប កំពុង ផ្តោត លើ ការរៀបចំ គម្រោង អនុត្តរភាព ប្រព័ន្ធ ធារាសាស្ត្រ មួយចំនួន នៅ កម្ពុជា . រដ្ឋមន្រ្តី ធនធាន ទឹក វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហការ នេះ
ទន្ទឹម នេះ លោក រដ្ឋមន្រ្តី ក៏ សូម កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល ជាច្រើន ដែល លោកស្រី សម្រេចបាន ក្នុង អាណត្តិ បំពេញ បេសកម្ម នៅ ទីនេះ ជាពិសេស គឺ ការធ្វើឲ្យ កាន់តែ ប្រសើរ នូវ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស យើង ទាំង ពីរ ដែល មាន ទំនាក់ទំនង ល្អ ជា ប្រវត្តិសាស្ត្រ យូរ លង់ មកហើយ និង សូម កោតសរសើរ ចំពោះ ការគាំទ្រ របស់ រដ្ឋាភិបាល បារាំង តាមរយៈ AFD ចំពោះ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា លើ ការអភិវឌ្ឃ វិស័យ ធន ធន ទឹក ។
ជាមួយគ្នា នេះ ៣កិច្ចសន្យា នៃ អនុគម្រោង បាន ដេញថ្លៃ រួចរាល់ និង កំពុង បន្ត កិច្ច ដំណើរការចុះហត្ថលេខា ហើយ ៦ អនុគម្រោង កំពុង ដំណើរការដេញថ្លៃ ។ ទន្ទឹមនឹង នេះ ដែរ ដើម្បី បន្ត កិច្ច ដំណើរការជំហាន ទី២ ភាគី ទាំង ពីរ បាន ផ្តោត លើ ការរៀបចំ គម្រោង អនុត្តរភាព ប្រព័ន្ធ ធារាសាស្ត្រ មួយចំនួន នៅក្នុង ខេត្ត សៀមរាប ឧត្តរមានជ័យ ព្រះវិហារ បាត់ដំបង កំពង់ធំ កំពង់ចាម ត្បូងឃ្មុំ កណ្តាល និង ខេត្ត កំពង់ស្ពឺ ៕
ឯកឧត្តម ងួន ស្តេច ភក្តី ផ្ញើ សារ អបអរសាទរ ឧកញ៉ា អនាថ បិណ្ឌិក សេដ្ឋី បណ្ឌិត ម៉ម វណ្ណឌី ក្នុង ឱកាស ដែល ព្រះមហាក្សត្រ កម្ពុជា ត្រាស់បង្គាប់ ផ្តល់ គោរ ម្យ៍ងារ ជា « អ្នក ឧកញ៉ា »
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន ចេញ សេចក្ដីថ្លែងការណ៍ នៅ ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ សម្ដែង ការសោកស្ដាយ ជាខ្លាំង ចំពោះ ពលរដ្ឋ ខ្មែរ អាមេរិកកាំង មួយចំនួន ដែល បាន ប្រឌិត ព័ត៌មាន និង វាយប្រហារ តាមរយៈ បណ្ដាញ ផ្សព្វផ្សាយ បរទេស ជា ខេមរភាសា ដោយ វោហារ សាស្រ្ដ ខុសពី ការពិត គ្មាន ការទទួលខុសត្រូវ ស្ដីពី ការអនុវត្ត រដ្ឋធម្មនុញ្ញ ជា ច្បាប់ កំពូល នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
តាមរយៈ សេចក្ដីថ្លែងការណ៍ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន ចាត់ទុក ថា វោហារ សាស្រ្ដ គ្មាន តម្លៃ ជា ប្រជាពលរដ្ឋ ថ្លៃថ្នូរ ជាពិសេស ជា អ្នក រស់ នៅក្នុង អរិយ ប្រទេស រួច ទៅហើយ នោះ គឺ បញ្ជាក់ បង្ហាញ ពី ចេតនា ទុច្ចរិត បង្កាច់បង្ខូច និង ឥរិយាបទ ប្រទូសរ៉ាយ ជាមួយ មាតុ ប្រទេស របស់ ខ្លួន ។
អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល សូម សម្ដែង នូវ មោទកភាព ចំពោះ ការអនុវត្ត រដ្ឋធម្មនុញ្ញ ជាប្រចាំ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ស្ថាប័ន កំពូល ៗ របស់ ជាតិ ដទៃ ទៀត ដែល រួមគ្នា រក្សា បាន នូវ សុខ សន្ដិភាព ជៀស ផុត ពី វិបត្តិ រដ្ឋធម្មនុញ្ញ ធានា បាន ស្ថិរភាព នយោបាយ ព្រម ជាមួយ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម កម្ពុជា ប្រកបដោយ ភាពស្មើ មុខ ស្មើ មាត់ ជាមួយ បណ្ដា ប្រទេស នានា ក្នុង សាកលលោក ។
រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា ព្រមទាំង ឥស្សរជន ខ្មែរ គ្រប់ រូប បាន ធ្វើ ពលិកម្ម គ្រប់ បែបយ៉ាង ដើម្បី ផលប្រយោជន៍ ជាតិ និង ការរស់រាន មាន ជីវិត របស់ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ កាលៈទេសៈ និង គ្រប់ ស្ថានភាព ស្រប តាម ខ្លឹមសារ ដូច ដែល បាន ចែង ក្នុង រដ្ឋធម្មនុញ្ញ ៕ ក្រុម ក្មេង ទំនើង បង្ហោះ ម៉ូតូ និង កែច្នៃ បំពង់ ស៉ី ម៉ាំង ឮ ខ្លាំង ក្រុង សិរី សោភ័ណ ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន ៣៣ នាក់
( បន្ទាយមានជ័យ )៖ ក្មេង ទំនើង បង្ហោះ ម៉ូតូ និង កែច្នៃ បំពង់ ស៉ី ម៉ាំង លឺ ខ្លាំង រំខាន ដល់ ប្រជាពលរដ្ឋ ត្រូវបាន កម្លាំង នគរបាល ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ឃាត់ខ្លួន ចំនួន ៣៣ នាក់ ជាមួយ ម៉ូតូ ២១ គ្រឿង រយៈពេល ពីរ ថ្ងៃ នៅ ថ្ងៃទី ០៩ - ១០ ខែមិថុនា ឆ្នាំ ២០២២ ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ និង ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក សុី ឌី អធិការ នគរបាល ក្រុង សេរី សោភ័ណ សហការ ជាមួយ ជំនាញ ផ្នែក ប្រឆាំង គ្រឿងញៀន ផ្នែក ព្រហ្មទណ្ឌ និង ផ្នែក សណ្តាប់ធ្នាប់ នៃ អធិការដ្ឋាន នគរបាល ក្រុង សិរី សោភ័ណ និង កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល សង្កាត់ ទឹក ថ្លា សង្កាត់ កំពង់ស្វាយ និង សង្កាត់ អូរ អំបិល ។
ក្នុង នោះ សមត្ថកិច្ច បានះ បង្ក្រាប ក្មេង ទំនើង ៣៣ នាក់ ជាមួយ ម៉ូតូ ២៦ គ្រឿង ដែល កែច្នៃ ដាក់ សុី ម៉ាំង លឺ ខ្លាំង ៗ ២១ គ្រឿង បង្ហោះ ២គ្រឿង ជិះ អម ពីក្រោយ ចាំ ថត២ គ្រឿង ជិះ បែមុខ ពីក្រោយ១ គ្រឿង ក្នុង នោះ ១០ គ្រឿងអត់ ពន្ធ ។
លោក វរសេនីយ៍ ឯក ស៊ី ឌី បាន បញ្ជាក់ ថា ចំពោះ ក្មេង ទំនើង ទាំង ៣៣ នាក់ នោះ នគរបាល បាន ឲ្យ អនុវត្ត ៣ ចំណុច ចំណុច ទី ១៖ ឲ្យ ម្ចាស់ អ្នក ជិះ ម៉ូតូ អត់ ពន្ធ យក ទៅ បង់ ពន្ធ ខ្លួន ឯង ពេល ធ្វើ កិច្ចសន្យា រួច . ចំណុច ទី ២៖ ម្ចាស់ ម៉ូតូ កែ សុី ម៉ាំង ដាក់ បំពង សំលេង លឺ ខ្លាំង ៗ បង្ក រំខាន ដល់ ប្រជាពលរដ្ឋ ឲ្យ ដាក់ សុី ម៉ាំង ធម្មតា ឡើងវិញ និង ចំណុច ទី ៣៖ ក្រោយពី ធ្វើ កិច្ចសន្យា រួច ចំពោះ ម្ចាស់ ម៉ូតូ ទាំងអស់ ត្រូវ ធ្វើ ការ ផាពិន័យ ទៅតាម រដ្ឋបាល ច្បាប់ ចរាចរណ៍ ។
លុះ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ នៅ អធិការដ្ឋាន នគរបាល ក្រុង សិរី សោភ័ណ បាន ឲ្យ ក្មេង ទំនើង ណា កែ បំពង់ ស្រី ម៉ាំង ឲ្យ យក សុី ម៉ាំង ដើម យកមក ដាក់ វិញ ឲ្យបាន ត្រឹមត្រូវ ក្នុង នោះ ក៏ បាន ឃើញ មាន វត្តមាន ម្តាយ ឪពុក ក្មេង ទំនើង ពេញ ត្រៀប ត្រា ក្នុង អធិការដ្ឋាន ក្រុង សិរី សោភ័ណ ដើម្បី មក ទទួល កូន យក ទៅ ផ្ទះ វិញ ដោយ មាន ជាប់ លិខិតស្នាម យក ជាប់ និង ខ្លួន ផងដែរ ។
ក្រោយពី ធ្វើ ការអប់រំ ធ្វើ កិច្ចសន្យា បញ្ឈប់ មិន ឲ្យ ប្រព្រឹត្ត ជា លើក ទី២បន្ត ទៀត បើ មិន រៀង ចាល ចាប់ បាន ជា លើក ទី២ នឹង អនុវត្ត តាម វិធានការ រដ្ឋបាល ។ បន្ទាប់ មក កោះហៅ ឪពុក ម្តាយ ឬ អាណាព្យាបាល មក ធានាយក កូន ៗ ទៅ អប់រំ បន្ត ហើយ ម៉ូតូ ដែល ពាក់ព័ន្ធ នឹង បំពង់ ស៊ីម៉ាំង លឺ ខ្លាំង តម្រូវឲ្យ ម្ចាស់ ដាក់ បំពង់ ស៊ីម៉ាំង ឲ្យ ត្រូវ តាម លក្ខណៈ ដើម វិញ ដោយឡែក ម៉ូតូ ដែល អត់ ពន្ធ នោះ សមត្ថកិច្ច អនុវត្ត តាម ច្បាប់ ឲ្យ ម្ចាស់ យក ទៅ បង់ ពន្ធ ខ្លួន ឯង ។
ជាមួយគ្នា នោះ លោក អធិការ នគរបាល ក្រុង បាន អំពាវនាវ ដល់ ឪពុក ម្តាយ ឬ អាណាព្យាបាល មេត្តា ណែនាំ ដល់ កូន ចៅ របស់ ខ្លួន កុំ ឲ្យ ប្រព្រឹត្ត នូវ អំពើ ដែល សង្គម ស្អប់ខ្ពើម ដូចជា ការបង្ហោះ ម៉ូតូ ជិះ រេចុះ ឡើង ពេញ ផ្លូវ នេះ វា បង្ក គ្រោះថ្នាក់ ខ្លួន ឯង និង អ្នកដទៃ ដែល ប្រើប្រាស់ ផ្លូវ ជាមួយ ។ ចំពោះ ម៉ូតូ កែច្នៃ បំពង់ ស៊ីម៉ាំង លឺ ខ្លាំង វា រំខាន ដល់ អារម្មណ៍ និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ទៀត ផង ៕ ចុង សប្តាហ៍ ទី២ នៃ ខែមិថុនា ខេត្ត ពោធិ៍សាត់ មាន ភ្ញៀវ ទេសចរ មក លេង កម្សាន្ត ជាង ១ម៉ឺន នាក់
( ពោធិ៍សាត់ )៖ ចុង សប្តាហ៍ ទី២ នៃ ខែមិថុនា ពោលគឺ ចាប់ពី ថ្ងៃទី ០៦ - ១២ ខែមិថុនា ឆ្នាំ ២០២២ នៅ ទូទាំង ខេត្ត ពោធិ៍សាត់ មាន ភ្ញៀវ ទេសចរ បាន មក ដើរលេង កម្សាន្ត តាម រមណីយដ្ឋាន នានា ទាំង ៣៥ កន្លែង សរុប មាន ចំនួន ១២. ៦០២ នាក់ ក្នុង នោះ ភ្ញៀវ ជាតិ មាន ចំនួន ១២. ៦០១ នាក់ និង ភ្ញៀវ អន្តរជាតិ ផ្ទៃក្នុង មាន ចំនួន ០១ នាក់ ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ល្មើស សញ្ញា អត់ ស្លាកលេខ និង ទូរស័ព្ទ ដៃ ។ ដោយឡែក រថយន្ត ល្បឿន ខ្សែក្រវ៉ាត់ ទូរស័ព្ទ ដៃ ឆៀក និង ល្មើស សញ្ញា ជាដើម ។
អ្នក ចម្ការ ដាំ ទុរេន មួយ កន្លែង នៅ ស្រុក សំឡូត សប្បាយរីករាយ ដោយសារ តម្លៃ ខ្ពស់ និង ចាប់ផ្តើម ប្រមូល ផល
( បាត់ដំបង ) ៖ អ្នក ចម្ការ ដាំ ទុរេន មួយ កន្លែង នៅ ស្រុក សំឡូត ខេត្ត បាត់ដំបង បាន បង្ហាញ ក្តីរីករាយ ជាខ្លាំង និង ចាប់ផ្តើម ប្រមូល ផល ហើយ ខណៈ តម្លៃ ក៏ លក់ បាន ថ្លៃ ខ្ពស់ ជាង ឆ្នាំ មុន ។
បើ តាម ម្ចាស់ ចម្ការ យីហោ ប៉ា ម៉ាក់ ខ្ញុំ លោក ថាក់ លីលីន រស់ នៅ ភូមិ កន្ទួត ឃុំ សំឡូត ស្រុក សំឡូត ខេត្ត បាត់ដំបង បាន ប្រាប់ ឲ្យដឹង ថា ហេតុផល នៃ ការដាំដុះ ដើម ធុរេន ដោយសារ តំបន់ មួយ ភាគ របស់ ស្រុក សំឡូត ដី មាន ជីវជាតិ ហើយ អំណោយផល និង សម្លឹង ឃើញ ថា ដំណាំ ទុរេន មាន តម្លៃ ល្អ អាច បង្កើន ជីវភាព គ្រួសារ បាន កាន់តែ ប្រសើ ឡើង ។
ក្រោយ ការពង្រីក ផ្ទៃដី ដាំដុះ ពី ១ហិកតា មកដល់ បច្ចុប្បន្ន ចំនួន ៧ហិកតា ស្មើនឹង ជិត ២.០០០ ដើម ក្នុង នោះ ដើមទុរេន ចំនួន ជិត ២.០០០ ដើម កំពុង ប្រមូល ផល លក់ដូរ បាន កាក់ កបល្អ ប្រសើរ ។ ក្នុង មួយ ឆ្នាំ ទុរេន ហុច ផល បាន ប្រាក់ ប្រមាណ ជាង ១០០ លាន រៀល ។
លោក មាន ភាពជឿជាក់ ខ្លួន ព្រោះថា ទុរេន ដែល កសិករ ផលិត បាន គឺ គាត់ ជា អ្នក កំណត់ តម្លៃ ដោយ ខ្លួន ឯង ។
ម្ចាស់ ចម្ការ ដដែល បាន បន្ត ថា បច្ចុប្បន្ន ផ្លែ ទុរេន ចាស់ ជិត ទុំ លក់ បាន តម្លៃ ២០.០០០ រៀល ក្នុង មួយ គីឡូក្រាម រីឯ ទុរេន នទុំ លក់ បាន តម្លៃ ២២.០០០ រៀល និង កាលពី ដើម រដូវ លក់ បាន ក្នុង តម្លៃ ២៥០០០ រៀល ក្នុង មួយ គីឡូក្រាម ។ ក្រៅពី អតិថិជន ជា អាជីវករ បញ្ជាទិញ នៅ មាន ភ្ញៀវ ដើរ លំហែរ ក្នុង ស្រុក មួយចំនួន ធំ ទៀត បាន ចុះ មក ទិញ ដល់ ចម្ការ ផ្ទាល់ ។
ទុរេន របស់ លោក ក៏ មាន ទីផ្សារ ចែកចាយ ២៥ ខេត្ត ក្រុង តាម ការបញ្ជាទិញ តាម ផេក ហ្វេសប៊ុក ជាច្រើន ផងដែរ ពិសេស អ្នក រស់ នៅក្នុង ខេត្ត បាត់ដំបង រាជធានី ភ្នំពេញ បន្ទាយមានជ័យ និង ខេត្ត សៀមរាប ជាដើម ។
ម៉្យាងទៀត ផ្លែ ទុរេន សំឡូត ចាប់ផ្តើម ទុំ នៅ អំឡុង ដើម ខែមិថុនា ដល់ ចុង ខែសីហា ជារៀងរាល់ ឆ្នាំ ។ ក្រៅពី នេះ ជា ទុរេន នាំចូល ពី ក្រៅ ប្រទេស ទេ ទាំង គុណភាព ក៏ មិន ដូច ទុរេន ក្នុង ស្រុក ដែរ ហើយ ចំពោះ សាច់ ទុរេន ខ្មែរ វិញ មាន ពណ៌ ទឹកដោះគោ ចំណែក សាច់ ទុរេន នាំចូល ពី ក្រៅ ប្រទេស មាន ពណ៌ លឿង មិន ឈ្ងុយ និង រសជាតិ មិន ឈ្ងុយ ដូច ខ្ទឹះ ដូង ឡើយ ៕
រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម៖ ប្រទេស អភិវឌ្ឍន៍ តិចតួច ត្រួវ រួមគ្នា ទាមទារ ជំនួយ កសាង សមត្ថភាព និង បច្ចេកទេស
( ហ្សឺណែវ. ស្វីស) ៖ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម លោក ប៉ាន សូរស័ក្តិ បាន ជំរុញ ឱ្យ ប្រទេស អភិវឌ្ឍន៍ តិចតួច (LDCs) រួមគ្នា ទាមទារ ជំនួយ ពី កម្មវិធី អភិវឌ្ឍន៍ ផ្សេង ៗ ដើម្បី កសាង សមត្ថភាព និង បច្ចេកទេស ។
ក្នុង កិច្ចប្រជុំ នោះ លោក រដ្ឋមន្ដ្រី បាន លើកឡើង អំពី បញ្ហា មួយចំនួន ដែល ធ្វើឱ្យ ប្រទេស អភិវឌ្ឍន៍ តិចតួច (LDCs) មិន ទាន់ ទាញយក ប្រយោជន៍ ពេញលេញ ពី ប្រព័ន្ធ អនុគ្រោះ ។ លោក រដ្ឋមន្ត្រី បន្ត ថា នៅក្នុង កិច្ចប្រជុំ MC12 និង ឱកាស បន្តបន្ទាប់ ទៀត ប្រទេស LDCs ទាំងអស់ ត្រូវតែ បន្ត ទាមទារ ជំនួយ កសាង សមត្ថភាព និង បច្ចេកទេស តាមរយៈ ក្របខណ្ឌ ផ្សេង ៗ ។
លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន គូសបញ្ជាក់ ថា ការទាមទារ ជំនួញ នេះ មិន ត្រឹមតែ ជួយ ឱ្យ ប្រទេស អភិវឌ្ឍន៍ តិចតួច អាច ទាញយក ប្រយោជន៍ ឱ្យ បាន ពេញលេញ ពី ប្រព័ន្ធ អនុគ្រោះ និង អាច ធ្វើ សមាហរណកម្ម យ៉ាង ពេញលេញ ជាមួយ ប្រព័ន្ធ ពាណិជ្ជកម្ម ពហុ ភាគី ប៉ុណ្ណោះ ទេ ថែមទាំង អាច ជួយ ដល់ បរិវត្តកម្ម នៃ រចនាសម្ព័ន្ធ កាន់តែ ធំ ទូលំទូលាយ ដែល ប្រទេស LDCs ត្រូវការ ដើម្បី អាច រក្សា នូវ ភាព ប្រកួតប្រជែង សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ប្រកបដោយ បរិយា បន្ន និង ភាពធន់ ។
លោក រដ្ឋមន្ដ្រី ក៏ បាន ជំរុញ ប្រទេស LDCs បន្ត ទាមទារ ប្រព្រឹត្តកម្ម និង ការអភិវឌ្ឍ ពិសេស និង ដោយឡែក ឱ្យ ក្លាយជា គោលការណ៍ ចម្បង នៃ ប្រព័ន្ធ ពាណិជ្ជកម្ម ពិភពលោក ។
គួរ បញ្ជាក់ ថា បញ្ហា ខាងលើ ក៏ បាន និង កំពុង បង្កើន ក្តីបារម្ភ ជាថ្មី អំពី ទស្សនវិស័យ សម្រាប់ ប្រទេស ដែល មាន សេដ្ឋកិច្ច ធំ ទី ពីរ របស់ ពិភពលោក មួយ នេះ ខណៈ ចិន ទើបតែ ងើប ឡើងវិញ ពី ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ដែល បណ្តាល មកពី ការអនុវត្ត វិធានការបិទ ខ្ទប់ រយៈពេល ពីរ ខែ នៅ ទីក្រុង សៀងហៃ ដែល ជា ទីក្រុង មាន ប្រជាជន ច្រើន បំផុត និង ជា មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម ដ៏ សំខាន់ របស់ ខ្លួន ៕
ក្រសួង សុខាភិបាល ប្រគល់ សម្ភារៈ អប់រំ និង ការិយាល័យ របស់ គម្រោង អាហារូបត្ថម្ភ នៅ កម្ពុជា ដល់ ខេត្ត គោលដៅ ទាំង៧ និង អង្គភាព អនុវត្តន៍ គម្រោង
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន រៀបចំ ពិធី ប្រគល់ សម្ភារៈ អប់រំ និង ការិយាល័យ របស់ គម្រោង អាហារូបត្ថម្ភ នៅ កម្ពុជា ដល់ ខេត្ត គោលដៅ ទាំង៧ និង អង្គភាព អនុវត្តន៍ គម្រោង ។
លោកស្រី វជ្ជបណ្ឌិត យក់ សម្បត្តិ បាន បន្ដ ថា សម្ភារៈ អប់រំ ដែល ចែកជូន មូលដ្ឋាន សុខាភិបាល សាធារណៈ មាន ខេត្ត គោលដៅ ទាំង៧ នា ថ្ងៃ នេះ រួម មាន៖ ខេត្ត រតនគិរី . ខេត្ត មណ្ឌលគិរី . ខេត្ត ស្ទឹងត្រែង . ខេត្ត ក្រចេះ . ខេត្ត ព្រះវិហារ . ខេត្ត កោះកុង . ខេត្ត និង កំពង់ឆ្នាំង ។
បន្ថែម ពី នេះ ទៀត លោកស្រី សង្ឃឹម ថា សម្ភារៈ ទាំងអស់ នេះ និង ជួយ មួយចំណែក ដល់ ការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង មួយចំនួន ក៏ ដូចជា ការលើ ស្ទួយ ដល់ សុខភាព មាតា និង ទារក ក្នុង ការផ្ដល់ អាហារ រូបត្ថម្ភ បន្ថែម និង ការអប់រំ សុខភាព មាតា ក៏ ដូចជា ការចិញ្ចឹម បីបាច់ ថែរក្សា ទារក របស់ ខ្លួន ឲ្យ មាន សុខភាព ល្អ រហូត ឈាន ទៅដល់ ការអភិវឌ្ឃន៍ ធនធាន មនុស្ស ។
គួរ បញ្ជាក់ ថា ហ្វាំងឡង់ និង ស៊ុយអែត បាន សម្រេច នាំគ្នា ដាក់ពាក្យ ស្នើសុំ ចូល ជា សមាជិក NATO បន្ទាប់ពី សង្រ្គាម បាន ផ្ទុះឡើង រវាង អ៊ុយក្រែន និង រុស្ស៉ី ។ ខណៈ ប្រទេស ទាំង ពីរ បាន រក្សា ចំណង ទាក់ទង និង កិច្ចសហប្រតិបត្តិការ ផ្នែក យោធា ជិតស្និទ្ធ ជាមួយ អង្គការ NATO រាប់ ទសវត្សរ៍ មក ហើយ នោះ ជា ផ្លូវការ ពួកគេ ត្រូវបាន ទទួលស្គាល់ ថា ជា ប្រទេស ដែល ប្រកាន់ ជំហរ អព្យាក្រឹត ៕
សហរដ្ឋ អាមេរិក កើត ហេតុការណ៍ បាញ់ប្រហារ ចំនួន ២៥ លើក ក្នុង មួយ ថ្ងៃ បណ្តាលឱ្យ មនុស្ស យ៉ាងហោច៦នាក់ ស្លាប់ និង ៤០ នាក់ ទៀត រងរបួស
( ប៉េកាំង ) ៖ យោង ទៅតាម ទិន្នន័យ ស្ថិតិ នៃ « បណ្ណ សារ អំពើហឹង្សា ដោយ កាំភ្លើង » ដែល ជា អង្គការ មិន ស្វែងរក ប្រាក់ ចំណេញ របស់ អាមេរិក កាលពី ថ្ងៃទី ១២ ខែមិថុនា ឱ្យដឹង ថា គិត មក ទល់ វេលា ម៉ោង ១៦ ថ្ងៃទី ១២ ខែមិថុនា តាម ម៉ោង តំបន់ ភាគ ខាងកើត នៃ សហរដ្ឋ អាមេរិក តំបន់ ជាច្រើន នៅ ទូទាំង អាមេរិក បាន កើត ហេតុការណ៍ បាញ់ប្រហារ ចំនួន ២៥លើ ក បណ្តាលឱ្យ មនុស្ស យ៉ាងហោចណាស់ ៦នាក់ ស្លាប់ និង ៤០ នាក់ ទៀត រងរបួស ។
នៅ ថ្ងៃទី ១២ ខែមិថុនា តាម ម៉ោង ក្នុង តំបន់ រដ្ឋសភា អាមេរិក បាន ចេញ សេចក្តីថ្លែងការណ៍ ថា បក្ស ទាំង ពីរ បាន ឈានដល់ កិច្ចព្រមព្រៀង អំពី ក្របខណ្ឌ សេចក្តីស្នើ ច្បាប់ ស្តីពី វិធានការ ថ្មី សម្រាប់ ដោះស្រាយ អំពើហិង្សា ដោយ កាំភ្លើង រួចហើយ ។
ទាក់ទិន នឹង រឿង នេះ លោក បៃ ដិន ប្រធានាធិបតី អាមេរិក ក៏ បាន ថ្លែង ថា សង្ឃឹម ឱ្យ ចុះហត្ថលេខា ក្នុង ពេល ឆាប់ ៗ លើ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការដាក់កំហិត អំពើហិង្សា ដោយ កាំភ្លើង ដើម្បី ជំរុញ ដល់ សុវត្ថិភាព ផ្នែក កាំភ្លើង ។ ប៉ុន្តែ តើ ត្រូវ ធ្វើ យ៉ាងណា ទើប អាច ធ្វើឱ្យ តម្រូវការ និង ផលប្រយោជន៍ របស់ ភាគី នានា មាន តុល្យភាព ព្រម និង ដំណើរ ធ្វើ សេចក្តីសម្រេចចិត្ត ដ៏ វែង សុទ្ធតែ នឹង ប៉ះពាល់ ដល់ បញ្ហា ថា តើ នឹង តាក់តែង ច្បាប់ ដោយ រលូន នៅ ទីបំផុត ឬ អត់ ៕
ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន បទ អត្ថាធិប្បាយ៖ កម្ពុជា គឺជា គំរូ ថ្មី នៃ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ស្តីពី គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ »
សូម បញ្ជាក់ ថា ក្នុង នាម ជា ប្រទេស ដ៏ មាន សារសំខាន់ ចំពោះ ប្រទេស ចិន ក្នុង ការជំរុញ កិច្ច កសាង « ខ្សែក្រវាត់ និង ផ្លូវ » និង « យុទ្ធសាស្ត្រ ចតុកោណ » សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ជាតិ របស់ កម្ពុជា មាន ភាពស៊ីសង្វាក់ គ្នា ខ្ពស់ ជាមួយនឹង គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » ជាពិសេស គឺ ការតភ្ជាប់គ្នា ក្នុង វិស័យ កិច្ច កសាង ហេដ្ឋារចនាសម្ព័ន្ធ ។
ទន្ទឹមនឹង ការពន្លឿន ការជំរុញ រួមគ្នា កសាង គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » កិច្ចសហប្រតិបត្តិការ ក្នុង គ្រប់ វិស័យ រវាង ប្រទេស ទាំង ពីរ ចិន និង កម្ពុជា មាន ភាព កាន់តែ ស៊ីជម្រៅ ជា បន្តបន្ទាប់ ហើយ ប្រទេស ចិន ក៏ បាន បណ្តាក់ទុន យ៉ាង ច្រើន សន្ធឹក ក្នុង វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ របស់ កម្ពុជា ដូចជា ផ្លូវថ្នល់ និង ស្ពាន វិស្វកម្ម ធារាសាស្ត្រ គម្រោង បណ្តាញ អគ្គិសនី កំពង់ផែ និង ព្រលានយន្តហោះ ជាដើម ។
គួរ រំលឹក ថា រយៈពេល ៩ ឆ្នាំ បាន កន្លងផុត ទៅ យ៉ាង ឆាប់រហ័ស ទន្ទឹមនឹង គំនិត ផ្តួចផ្តើម « ខ្សែ ក្រាវាត់ និង ផ្លូវ » ដែល បាន ដាក់ចេញ ហើយ ឈានចូល ឆ្នាំ ទី៩ តើ កម្ពុជា កើតមាន ការផ្លាស់ប្តូរ និង ការអភិវឌ្ឍ យ៉ាងណា ខ្លះ ? ទី១ គឺ កំណើន នៃ ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី រវាង ចិន និង កម្ពុជា ។
ក្នុង រយៈពេល ជិត ២ឆ្នាំ កន្លងមក នេះ ការនាំចេញ កសិផល របស់ កម្ពុជា ទៅកាន់ ប្រទេស ចិន ដូចជា ផែ្ល ចេក និង អង្ករ ជាដើម បាន កើនឡើង យ៉ាង ឆាប់រហ័ស ។ ឧទាហរណ៍ ដូចជា បរិមាណ នាំចេញ ផ្លែ ចេក របស់ កម្ពុជា ទៅកាន់ ប្រទេស ចិន ក្នុង ឆ្នាំ ២០២០ ដល់ ទៅ ២៧ម៉ឺន តោន ឯ តួលេខ ទាំងនេះ បាន ឡើង ដល់ ៣២ម៉ឺន តោន ក្នុង ឆ្នាំ ២០២១ ។ ហេតុ នេះ ហើយ បានជា ប្រទេស ចិន បាន រក្សា ឋានៈ ជា ទីផ្សារ នាំចេញ ធំ បំផុត របស់ កសិផល កម្ពុជា ។
ទី២ គឺ ការអភិវឌ្ឍ ខាង វិស័យ ទេសចរណ៍ ។ វិស័យ ទេសចរណ៍ គឺជា ឧស្សាហកម្ម ធំ មួយ ក្នុង ចំណោម សសរ ទ្រទ្រង់ ផ្នែក សេដ្ឋកិច្ច ធំ ទាំង៤ របស់ កម្ពុជា ។ ចាប់ពី ឆ្នាំ ២០១៤ ដល់ ឆ្នាំ ២០១៩ ចំនួន ភ្ញៀវ ទេសចរ ចិន ដែល ទៅ ទស្សនា កម្ពុជា បាន កើនឡើង ពី ចំនួន ៥៦ម៉ឺន នាក់ ឡើង ដល់ ២លាន ៣សែន ៦ម៉ឺន នាក់ ដូចនេះ ប្រទេស ចិន បាន ក្លាយជា ប្រភព ភ្ញៀវ ទេសចរណ៍ ធំ បំផុត របស់ ប្រទេស កម្ពុជា ។
លោក ភិន វិជ្ជាវឌ្ឍនា អគ្គកុងស៊ុល នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រចាំ នៅ ទីក្រុង ក្វាង ចូវ ប្រទេស ចិន បាន លើកឡើង ថា ផ្លូវ ល្បឿន លឿន ដែល កំពុង សាងសង់ ទាំងនេះ នឹង ដើរ តួនាទី ជំរុញ ក្នុង ការបង្កបង្កើត ជា រង្វង់ សេដ្ឋកិច្ច នៃ រាជធានី ព្រមទាំង ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច របស់ ប្រទេស តាម បណ្តោយ ។
លោក បណ្ឌិត នាក់ ចិន្តារិទ្ធិ នាយក មជ្ឈមណ្ឌល កម្ពុជា សម្រាប់ ស្រាវជ្រាវ ផ្លូវ សូត្រ សមុទ្រ សតវត្ស ទី ២១ នៃ ប្រទេស កម្ពុជា បាន ថ្លែង ថា គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » បាន រួមចំណែក យ៉ាង ធំធេង ដល់ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ របស់ កម្ពុជា ប្រការ នេះ នឹង ជួយ កម្ពុជា ឱ្យ សម្រេចបាន នូវ គោលដៅ ដ៏ មហិមា របស់ ខ្លួន ពោលគឺ ដល់ ឆ្នាំ ២០៣០ នឹង ក្លាយជា ប្រទេស ចំណូល កម្រិត មធ្យម និង ខ្ពស់ ហើយ ដល់ ឆ្នាំ ២០៥០ នឹង ក្លាយជា ប្រទេស ចំណូល ខ្ពស់ ។
សហគ្រាស ទុន ចិន បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការជំរុញ អភិវឌ្ឍ ថាមពល អគ្គិសនី របស់ កម្ពុជា ដែល ពាក់ព័ន្ធ ដល់ ការសាងសង់ រោងចក្រ អគ្គិសនី ដើរ ដោយ ថាមពល គ្រប់ ប្រភេទ ដូចជា អគ្គិសនី ដើរ ដោយ ឧស្ម័ន ធម្មជាតិ វារី អគ្គិសនី និង ថាមពល ពន្លឺ ព្រះអាទិត្យ ជាដើម ។ ដោយសារ គិត ពិចារណា ពី បញ្ហា អំពី ការប្រើប្រាស់ ថាមពល ស្អាត ដើម្បី កាត់បន្ថយ ការបំពុល បរិស្ថាន និង បម្រែបម្រួល អាកាសធាតុ បានជា រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេចចិត្ត ថា ចាប់ពី ឆ្នាំ ២០១៩ ត ទៅ បាន ប្រែ ការប្រើប្រាស់ ថាមពល ទៅជា ថាមពល កាបូន ទាប ។
មិន ថា ការលើកឡើង នៃ គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » ឬ ការចុះហត្ថលេខា និង អនុវត្ត កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី រវាង ចិន និង កម្ពុជា ក៏ដោយ ក៏ សុទ្ធតែ សមស្រប នឹង ផលប្រយោជន៍ រួម របស់ ប្រទេស ទាំង ពីរ ។ ប៉ុន្តែ មួយ រយៈពេល កន្លងទៅ នេះ អ្នកនយោបាយ លោក ខាងលិច និង ស្ថាប័ន សិក្សា ស្រាវជ្រាវ មួយចំនួន ដែល ប្រកាន់ ទស្សនៈ លំអៀង ខាង នយោបាយ ចំពោះ ប្រទេស ចិន បាន អះអាង ថា ប្រទេស ចិន បាន ឆ្លៀត ប្រើ ខ្ចី ឥណទាន ដើម្បី ដាក់ អន្ទាក់ បំណុល សម្រាប់ ប្រទេស នៅ តំបន់ អាស៊ី និង អាហ្រ្វិក ។
ខណៈពេល ផ្តល់ បទសម្ភាសន៍ ជាមួយ ប្រព័ន្ធ សារព័ត៌មាន ស្តីពី សំណួរ ដែល ថា « ហេដ្ឋារចនាសម្ព័ន្ធ និង គម្រោង អភិវឌ្ឍន៍ ផ្សេង ទៀត របស់ កម្ពុជា គឺ ពឹងផ្អែក ខ្លាំង លើ ប្រទេស ចិន តើ កម្ពុជា នឹង ធ្លាក់ ចូល ក្នុង អន្ទាក់ បំណុល របស់ ចិន នៅពេល អនាគត ឬ អត់ ? » សម្តេច ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ឆ្លើយតប ថា « ខ្ញុំ សូម បញ្ជាក់ ដាច់ខាត យើងខ្ញុំ មិន អាច ក្លាយទៅជា កូន បំណុល តែ មួយ គត់ ហើយ ជាប់ អន្ទាក់ បំណុល ចិន ឡើយ ហើយ ចិន ក៏ គ្មាន បំណង ដាក់ អន្ទាក់ បំណុល ចំពោះ កម្ពុជា នោះ ដែរ ។ »
ខ្ញុំ សម្គាល់ ថា ឱ្យ តែ យើង មើល ពី បញ្ហា នេះ ដោយ អាកប្បកិរិយា សត្យានុម័ត និង យុត្តិធម៌ បន្តិច នោះ ក៏ អាច ឃើញ ថា ពាក្យ សម្តី នេះ គ្មាន ភស្តុតាង អ្វី ទាល់តែសោះ ។
មេឃុំ ជាប់ ឆ្នោត ថ្មី នៅ ឃុំ ផ្លូវ ទូក ខេត្ត កំពង់ឆ្នាំង ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ដែល បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា . លោក ប្ដេជ្ញា ដឹកនាំ ភូមិ ឃុំ កាន់តែ រីកចម្រើន ថែម ទៀត (Video inside) ( កំពង់ឆ្នាំង ) ៖ លោក មេឃុំ ជាប់ ឆ្នោត ថ្មី ក្នុង ឃុំ ផ្លូវ ទូក ស្រុក កំពង់លែង ខេត្ត កំពង់ឆ្នាំង បាន ថ្លែងអំណរគុណ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា និង ប្រជាពលរដ្ឋ ដែល បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ បន្ត ដឹកនាំ និង ធ្វើ ការអភិវឌ្ឍ ក្នុង ឃុំ ជា បន្ត ទៀត ។
លោក ប៉ាត់ គន មេឃុំ ជាប់ ឆ្នោត ថ្មី ក្នុង ឃុំ ផ្លូវ ទូក របស់ គណបក្ស ប្រជាជន កម្ពុជា នៅ រសៀល ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២២ បាន ថ្លែងអំណរគុណ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា និង ប្រជាពលរដ្ឋ ក្នុង ឃុំ ផ្លូវ ទូក ទាំងអស់ ដែល បាន ខិតខំ ដោយ មិន គិត ពី ការនឿយហត់ និង បាន ចំណាយ ពេលវេលា ដ៏ មាន តម្លៃ មក ចូលរួម បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន រូបលោក ជា បេក្ខភាព ឈឈ្មោះ ជា មេឃុំ បាន ធ្វើឲ្យ ឃុំ ផ្លូវ ទូក នេះ ទទួលបាន ៤អសនៈ ក្នុង ចំណោម ៥អាសនៈ ។
ក្នុង នាម លោក ជា មេឃុំ ជាប់ ឆ្នោត របស់ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ជា កិច្ចតបស្នង សង គុណ ដល់ ប្រជាពលរដ្ឋ ដែល បាន ផ្ដល់ ទំនុកចិត្ត ដល់ គណបក្ស ប្រជាជន កម្ពុជា លោក នឹង ខិតខំ យក អស់ ពី កម្លាំង កាយ ចិត្ត បម្រើ ដល់ ប្រជាពលរដ្ឋ ក្នុង ឃុំ ដោយ មិន គិត ពី ផលប្រយោជន៍ ផ្ទាល់ខ្លួន នោះ ឡើយ ។
ជា គោលការណ៍ របស់ រដ្ឋបាល ឃុំ របស់ លោក ជា ចម្បង គឺ យកចិត្តទុកដាក់ អំពី ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ដោយ រក ទីផ្សារ លក់ កសិផល កសិកម្ម មាន ដូចជា សណ្ដែក . ល្ង . ពោត . ស្រូវ . ។ល ។ ពិសេស គឺ ធ្វើ ការអភិវឌ្ឍន៍ ក្នុង ឃុំ មាន ដូចជា ហេដ្ឋារចនាសម្ព័ន្ធ ជាដើម ។
ជា ចុងក្រោយ នេះ លោក មេឃុំ បាន ធ្វើ ការប្ដេជ្ញាចិត្ត បន្ត ដឹកនាំ ប្រជាពលរដ្ឋ ក្នុង ឃុំ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការជ្រើសរើស តំណាងរាស្រ្ត នៅ ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដើម្បី ផ្ដល់ ឧកាស ជូន សម្ដេច នាយក រដ្ឋមន្ត្រី បន្ត ដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន សុខ សន្តិភាព ដូច សព្វ ថ្ងៃ ហើយ សុខ សន្តិភាព នេះ នឹង មាន តកូន ត ចៅ ជារៀងរហូត ។
ជប៉ុន ផ្តល់ ជំនួយ ឥត សំណង ដល់ កម្ពុជា ជាង ៣លាន ដុល្លារ ដើម្បី អនុវត្ត គម្រោង « អាហារូបករណ៍ អភិវឌ្ឍន៍ ធនធាន មនុស្ស »
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា និង លោក មិកា មិ ម៉ាសាហ៊ីរ៉ូ (MIKAMI Masahiro) ឯក អគ្គ រដ្ឋទូត ជប៉ុន ប្រចាំ កម្ពុជា បាន ចុះហត្ថលេខា លើ លិខិត ប្ដូរ សារ និង ឯកសារ ពាក់ព័ន្ធ ស្ដីពី ការផ្ដល់ ហិរញ្ញប្បទាន ឥត សំណង របស់ ជប៉ុន មួយ នេះ នា នៅ ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នៅ ទីស្តីការ ក្រសួង ។
ក្រសួង ការបរទេស បាន បញ្ជាក់ ថា ហិរញ្ញប្បទាន ឥត សំណង ដែល ផ្ដល់ ដោយ រដ្ឋាភិបាល ជប៉ុន នេះ នឹង ចូលរួមចំណែក យ៉ាង សំខាន់ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម និង ធនធាន មនុស្ស នៅ កម្ពុជា ព្រមទាំង ពង្រឹង បន្ថែម ទៀត នូវ កិច្ចសហប្រតិបត្តិការ ល្អ ដែល មាន ស្រាប់ និង ចំណង មិត្តភាព ជា ប្រពៃណី រវាង ប្រទេស ទាំង ពីរ ៕
ព្រះសង្ឃ និង ពុទ្ធ បរិស័ទ កម្ពុជា - ថៃ រៀបចំ បុណ្យ មហា ផ្កា ប្រាក់ សាមគ្គី ដ៏ ធំ មួយ ដើម្បី កសាង ព្រះវិហារ វត្ត ពារាណ សី សិរី មង្គល ស្រុក ស្វាយអន្ទរ
( កំពត ) ៖ ព្រះសង្ឃ និង ពុទ្ធ បរិស័ទ មកពី ប្រទេស ថៃ និង កម្ពុជា បាន រៀបចំ បុណ្យ មហា ផ្កា ប្រាក់ សាមគ្គី ដ៏ ធំ មួយ ក្នុង ទិសដៅ ដើម្បី បាន បច្ច័យ កសាង ព្រះវិហារ វត្ត ពារាណ សី សិរី មង្គល ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង ដែល បាន នឹង កំពុង ដំណើរការ កសាង រាល់ ថ្ងៃ ជួប បញ្ហា រខ្វះខាត ថវិកា ។
ពិធី នេះ ផ្តួចផ្តើម ឡើង ដោយ ព្រះគ្រូ ឥន្រ្ទិយ ធម្មញាណ ចាន់ វិសាល ជា ព្រះអធិការ វត្ត ពារាណ សី សិរី មង្គល គង់ នៅ ភូមិ អូរ កណ្តោល ឃុំ ដំរី ពួន ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង ។ ការរៀបចំ ពិធី នេះ បាន ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ឋានសួគ៌ បូក គោ ខេត្ត កំពត នា ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២២ ម្សិលមិញ ។
តាម ព្រះគ្រូ ឥន្រ្ទិយ ធម្មញាណ ចាន់ វិសាល មាន សង្ឃ ដីកា ឱ្យដឹង ថា ពិធី បុណ្យ ដ៏ ធំ នេះ មាន ការនិមន្ត និង អញ្ជើញ ចូលរួម របស់ សង្ឃ និង ពុទ្ធ បរិស័ទ គ្រប់ ខេត្ត ក្រុង ក្នុង ព្រះរាជាជាណាចក្រ កម្ពុជា និង ព្រះសង្ឃ ពុទ្ធ បរិសទ្យ ពី ប្រទេស ថៃ ផងដែរ ។
ព្រះគ្រូ ឥន្រ្ទិយ ធម្មញាណ ចាន់ វិសាល មាន សង្ឃ ដីកា បន្ត ថា ព្រះសង្ឃ និមន្ត ពី ប្រទេស ថៃ ដឹកនាំ ដោយ ព្រះគ្រូ សុី អនុគុណ ក្នុង ស្រុក ហួយ ថាប់ ថាន់ ខេត្ត សុី សាកេត និង ដឹកនាំ ដោយ ព្រះមហេស កោ ហៅ លោក តា សាវេង នៃ ក្រុង បាងកក និង ដឹកនាំ ដោយ ព្រះមហា សំរ៉ាន នៃ ខេត្ត ឧប៊ុន ។
ព្រះគ្រូ ឥន្រ្ទិយ ធម្មញាណ ចាន់ វិសាល មាន សង្ឃ ដីកា ថា ពិធី បុណ្យ មហា ផ្កា ប្រាក់ សាមគ្គី នេះ ទិសដៅ ដើម្បី បាន បច្ច័យ កសាង ព្រះវិហារ វត្ត ពារាណ សី សិរី មង្គល ដែល បាន នឹង កំពុង ដំណើរការ កសាង រាល់ ថ្ងៃ ជួប បញ្ហា រខ្វះខាត ថវិកា ។ មួយ ចំណែក ទៀត ជា ការចូលរួម អភិវឌ្ឍន៍ កសាង វត្ត អារាម ឱ្យ បាន រីកចម្រើន ក្នុង ព្រះពុទ្ធ សាសនា ជា សម្បត្តិ មរតក ជាតិ ក៏ គឺជា ការចូលរួមចំណែក អភិវឌ្ឍន៍ ជាមួយ ប្រមុខ រាជ រដ្ឋាភិបាល ជួយ ដល់ សង្គមជាតិ របស់ ខ្លួន ឱ្យ បាន រីកចម្រើន ថ្កើន ថ្កាន ផងដែរ ។
ព្រះគ្រូ ឥន្រ្ទិយ ធម្មញាណ ចាន់ វិសាល មាន សង្ឃ ដីកា បញ្ជាក់ ថា៖ ពិធី បុណ្យ ខាងលើ ក៏ មាន ការប្រកាស សម្តែង ព្រះធម៌ ទេសនា ទាំង ១៤គ្រែ ដើម្បី អប់រំ ឱ្យ មនុស្ស គ្រប់ គ្នា៖
សម្តេច តេជោ បញ្ជាក់ ថា ការពិត ដែល នឹង កើតឡើង នៅពេល ខាងមុខ គឺ ការថមថយចុះ នៃ សេដ្ឋកិច្ច សាកល រួមទាំង ប្រទេស កម្ពុជា ផងដែរ ហើយ នៅពេល ខាងមុខ វិបត្តិ ស្បៀងអាហារ ក៏ នឹង ក្លាយជា វិបត្តិ សាកល ។
ការថ្លែង បែប នេះ របស់ សម្តេច តេជោ ធ្វើឡើង នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ ។
សម្តេច ប្រមុខ រាជ រដ្ឋាភិបាល បាន ជំរុញ ឲ្យ មាន ការ សន្សំ សំចៃ នូវ ចំណូល ថវិកា ជាតិ ដើម្បី ត្រៀម ទុក ជាមុន នូវ សភាពការណ៍ ឬ វិបត្តិ ផ្សេង ៗ ដែល អាច កើត មាន ឡើង មិន អាច វាយតម្លៃ ដឹង មុន ។
សម្តេច តេជោ បាន បញ្ជាក់ ជាថ្មី ថា បើ ទោះបីជា ជួប នូវ វិបត្តិ កូវីដ១៩ ជាង ២ ឆ្នាំ និង ការចូលមក នៃ សង្គ្រាម រុស្ស៉ី - អ៊ុយក្រែន ក្តី ក៏ ស្ថានភាព សេដ្ឋកិច្ច កម្ពុជា មិន មាន ហានិភ័យ នៃ ការដួលរលំ នោះ ទេ ការនាំចេញ របស់ កម្ពុជា នៅ ដើម ឆ្នាំ ២០២២ នេះ មាន កំណើន គួរឲ្យ គត់ សម្គាល់ ខណៈ វិស័យ កសិកម្ម មាន ការអតិរេក ស្រូវ មាន ការចិញ្ចឹម សត្វ ចិញ្ចឹម ត្រី ដែល ធានា បាន នូវ សន្តិសុខ ស្បៀង សម្រាប់ ប្រជាជន ។
សម្តេច តេជោ បញ្ជាក់ ថា បច្ចុប្បន្ន សេដ្ឋកិច្ច ពិភពលោក កំពុង ជួបប្រទះ នូវ វិបត្តិ ថាមពល ដោយសារ ការកើនឡើន នៃ តម្លៃ ប្រេង ហើយ នា ពេល ខាងមុខ នះ វិបត្តិ ស្បៀង នឹង កើតឡើង សម្រាប់ សាកលលោក ដោយសារតែ ជង្រុក ស្រូវ សាលី ពិភពលោក គឺ ស្ថិត នៅ ប្រទេស រុស្ស៉ី និង អ៊ុយក្រែន . អ៊ុយក្រែន ខ្ទេចខ្ទាំ ដោយ សង្គ្រាម រុស្ស៉ី រង ទណ្ឌកម្ម មិន អាច នាំចេញ បាន ។
សូម ជម្រាប ថា ធនាគារ ពិភពលោក ទើប ចេញផ្សាយ របាយការណ៍ ព្យាករ សេដ្ឋកិច្ច សេដ្ឋកិច្ច កម្ពុជា ថា នៅ ឆ្នាំ ២០២២ នេះ នឹង មាន កំណើន ៤.៥% និង ឆ្នាំ ២០២៣ កើន ត្រឹម ៥. ៨% ខណៈ រាជ រដ្ឋាភិបាល កម្ពុជា រំពឹង ថា សេដ្ឋកិច្ច នឹង កើតឡើង ៥.២ភាគរយ សម្រាប់ ឆ្នាំ ២០២២ ។
សម្រាប់ ធនាគារ អភិវឌ្ឍន៍ អាស៉ី (ADB) វិញ ព្យាករ ថា សេដ្ឋកិច្ច កម្ពុជា នឹង ហក់ ឡើង ៥.៣% ក្នុង ឆ្នាំ នេះ និង ៦. ៥% ក្នុង ឆ្នាំ ២០២៣ ខណៈ មូលនិធិ រូបិយវត្ថុ អន្តរជាតិ រំពឹង ថា កើនឡើង រង្វង់ ៥.១% និង ឆ្នាំ ២០២៣ នឹង មាន កំណើន ខ្ពស់ ក្នុង អត្រា ៦.២% ៕ ប្រមុខ ការទូត កម្ពុជា៖ កម្ពុជា ទទួលបាន អត្ថប្រយោជន៍ ពី គម្រោង ជាក់ស្ដែង ៨០ តាមរយៈ មូលនិធិ ពិសេស នៃ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ឡាន ឆាង
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្រ្ដី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ កម្ពុជា បាន ថ្លែង ថា កន្លងមក តាមរយៈ មូលនិធិ ពិសេស នៃ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ឡាន ឆាង កម្ពុជា ទទួលបាន អត្ថប្រយោជន៍ ពី គម្រោង ជាក់ស្ដែង ចំនួន ៨០ ។
ក្រោម ក្របខ័ណ្ឌ មូលនិធិ ពិសេស នៃ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ឡាន ឆាង គម្រោង កម្ពុជា ចំនួន ១៣ នឹង ត្រូវបាន គាំទ្រ និង ផ្តល់ មូលនិធិ ដែល មាន ទឹកប្រាក់ ចំនួន ៤.៣៣៥. ៩០០ ដុល្លារ អាមេរិក ភាគ ច្រើន គ្របដណ្តប់ លើ សកម្មភាព ក្នុង វិស័យ បច្ចេកវិទ្យា ព័ត៌មាន អភិវឌ្ឍន៍ ជនបទ ទេសចរណ៍ បរិស្ថាន ការប្រយុទ្ធ ប្រឆាំង នឹង ព័ត៌មាន ក្លែងក្លាយ អន្តោប្រវេសន៍ និង ការគ្រប់គ្រង ព្រំដែន ការស្រាវជ្រាវ អាកាសចរណ៍ ក៏ ដូចជា ការអភិរក្ស បេតិកភណ្ឌ ក្នុង ចំណោម វិស័យ ដទៃ ទៀត ។
ប្រមុខ ការទូត កម្ពុជា បាន ថ្លែង ថា « រយៈកាល កន្លងទៅ តាមរយៈ មូលនិធិ ពិសេស នៃ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ឡាន ឆាង នេះ កម្ពុជា ទទួលបាន អត្ថប្រយោជន៍ ពី គម្រោង ជាក់ស្ដែង ចំនួន ៨០ ដែល មាន ឥទ្ធិពល វិជ្ជមាន យ៉ាង ធំធេង ទៅ លើ ការរស់នៅ របស់ ប្រជាជន តាមរយៈ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ដ៏ រឹងមាំ និង ធន់ ក៏ ដូចជា រួមចំណែក ដល់ ការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាជន នៅ ទូទាំងអនុ តំបន់ ផងដែរ » ។
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការបន្ត រួមចំណែក និង ការគាំទ្រ របស់ ប្រជាជន និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ផ្តល់ ជូន រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោក បន្ថែម ថា នៅ ខែ ក្រោយ លោក នឹង ធ្វើដំណើរ ទៅកាន់ ទីក្រុង បាហ្កាន ប្រទេស មីយ៉ាន់ម៉ា ដើម្បី ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស នៃ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ឡាន ឆាង លើក ទី៧ ហើយ ភាគី ទាំងអស់ នឹង បន្ត រិះរក គ្រប់ មធ្យោបាយ ថែម ទៀត ដើម្បី សម្រេច នូវ លទ្ធផល ជាក់ស្ដែង សម្រាប់ ប្រទេស មេគង្គ ៕
ក្រុម ក្មេង ស្ទាវ ភាគ ច្រើន ជា សិស្សសាលា ១៤នាក់ និង ម៉ូតូ ១១ គ្រឿង ត្រូវ នគរបាល ក្រុង សិរី សោភ័ណ បង្ក្រាប ក្រោយ បើក បង្ហោះ ពេញ ផ្លូវ និង កែច្នៃ បំពង់ ស៊ីម៉ាំង ឮ ខ្លាំង ៗ
( បន្ទាយមានជ័យ )៖ កម្លាំង នគរបាល ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ បាន ឃាត់ខ្លួន ក្រុម ក្មេង ស្ទាវ ភាគ ច្រើន ជា សិស្សសាលា ១៤នាក់ និង ម៉ូតូ ១១ គ្រឿង ព្រោះ ពូកែ ជិះ ម៉ូតូ បង្ហោះ ពេញ ផ្លូវ និង កែច្នៃ បំពង់ ស៊ីម៉ាំង ឮ ខ្លាំង ៗ បង្កឲ្យ ប្រជាពលរដ្ឋ ភិតភ័យ ដែល ការឃាត់ខ្លួន នេះ ធ្វើឡើង នៅ ម៉ោង ៥ល្ងាច នៅ ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២២ ។
លោក ស៊ី ឌី បាន ប្រាប់ បន្ត ទៀត ថា ក្រុម ក្មេង ស្ទាវ ទាំង ១៤នាក់ រួម មាន៖
លោក វរសេនីយ៍ ឯក ស៊ី ឌី បាន បញ្ជាក់ ឲ្យដឹង បន្ត ទៀត ថា ចំពោះ ក្មេង ទំនើង ទាំងនោះ នគរបាល ឲ្យ រត់ ចំនួន ២០ជុំ ដង ទង់ជាតិ រួច ធ្វើ ការអប់រំ ធ្វើ កិច្ចសន្យា បញ្ឈប់ មិន ឲ្យ ប្រព្រឹត្ត ជា លើក ទី២បន្ត ទៀត បើ មិន រៀង ចាល ចាប់ បាន ជា លើក ទី២ នឹង អនុវត្ត តាម វិធានការ រដ្ឋបាល ។
បន្ទាប់មក សមត្ថកិច្ច បាន កោះហៅ ឪពុក ម្តាយ ឬ អាណាព្យាបាល មក ធានាយក ទៅ អប់រំ បន្ត ហើយ ម៉ូតូ ដែល ពាក់ព័ន្ធ នឹង បំពង់ ស៊ីម៉ាំង ឮ ខ្លាំង តម្រូវឲ្យ ម្ចាស់ ដាក់ បំពង់ ស៊ីម៉ាំង ត្រូវ តាម លក្ខណៈ ដើម វិញ ដោយឡែក ម៉ូតូ ដែល អត់ ពន្ធ នោះ សមត្ថកិច្ច អនុវត្ត តាម ច្បាប់ ។
ជាមួយគ្នា នេះ លោក អធិការ នគរបាល ក្រុង បាន អំពាវនាវ ដល់ ឪពុក ម្តាយ ឬ អាណាព្យាបាល មេត្តា ណែនាំ ដល់ កូន ចៅ របស់ ខ្លួន កុំ ឲ្យ ប្រព្រឹត្ត នូវ អំពើ ដែល សង្គម ស្អប់ខ្ពើម ដូចជា ការបង្ហោះ ម៉ូតូ ជិះ រេចុះ ឡើង ពេញ ផ្លូវ នេះ វា បង្ក គ្រោះថ្នាក់ ខ្លួន ឯង និង អ្នកដទៃ ដែល ប្រើប្រាស់ ផ្លូវ ជាមួយ ។ ចំពោះ ម៉ូតូ កែច្នៃ បំពង់ ស៊ីម៉ាំង ឮ ខ្លាំង វា រំខាន ដល់ អារម្មណ៍ និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ជាខ្លាំង ៕
ក្រុម គ្រូពេទ្យ ស្ម័គ ចិត្ត អាមេរិក និង សមាគម ប្រឹក្សា សុខភាព ប្រជាជន ចុះ បំពាក់ ដៃ ជើង សិប្បនិម្មិត ដោយ ឥត គិត ថ្លៃ ជូន ជន ពិការ ចាប់ពី ថ្ងៃទី ១២ - ២៤ នៅ ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត អាមេរិកកាំង សហការ ជាមួយ សមាគម ប្រឹក្សា សុខភាព ប្រជាជន នៅ ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន ចុះ ធ្វើ សកម្មភាព បំពាក់ ដៃ ជើង សប្បនិម្មិត ជូន ជន ពិការ នៅ ខេត្ត ព្រះវិហារ និង ខេត្ត ជាប់ ជាមួយ ខេត្ត ព្រះវិហារ ដោយ ឥត គិត ថ្លៃ នៅ ទីស្នាក់ការ រដ្ឋសភា មណ្ឌល ព្រះវិហារ ក្រោម ការសម្របសម្រួល ពី លោក សួស យ៉ារ៉ា អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រះវិហារ ។
លោក គង់ ពុទ្ធិការ អគ្គ នាយក អាជ្ញាធរ ជាតិ ព្រះវិហារ តំណាង លោក សួស យ៉ារ៉ា អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រះវិហារ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ដោយ ក្តី នឹករលឹក យ៉ាង ជ្រាលជ្រៅ ពី លោក សួស យ៉ារ៉ា អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រះវិហារ ជូន ចំពោះ បងប្អូន ជន ជន ពិការ ដែល បាន ធ្វើដំណើរ មកកាន់ មណ្ឌល តំណាងរាស្ត្រ ទទួល សេវា សុខភាព នៅ ព្រឹក នេះ ។
លោក គង់ ពុទ្ធិ ការ បាន ថ្លែង ថា បញ្ហា សង្គ្រាម បាន បង្ក ផលលំបាក ដល់ ប្រជាជន មិន ត្រឹមតែ អំឡុង ពេល សង្គ្រាម នោះ ទេ ប៉ុន្តែ បញ្ហា ក្រោយ សង្រ្គាម ក៏ នៅតែ ផ្តល់ ការលំបាក ដល់ ប្រជាពលរដ្ឋ ។ លោក ថា សង្ក្រាម ស៊ីវិល រយៈពេល ៣០ ឆ្នាំ នៅក្នុង ប្រទេស កម្ពុជា មិន ត្រឹមតែ បាត់បង់ នូវ ហេដ្ឋារចនាសម្ព័ន្ធ សេដ្ឋកិច្ច ទេ ប៉ុន្តែ ប្រជាជន ស្ទើរតែ គ្រប់ ក្រុមគ្រួសារ ត្រូវបាន បាត់បង់ សមាជិក ក្រុមគ្រួសារ និង រង ផល ប៉ះពាល់ ពិការភាព ដោយ សង្គ្រាម ។
សមាជិក គណបក្ស ភ្លើង ទៀន ដែល សូម ចូលរួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា បាន បញ្ជាក់ និង សំដែង ការដឹងគុណ ជូន ដល់ គណបក្ស ប្រជាជន កម្ពុជា តាមរយៈ ឧកញ៉ា ឡូវ ហ៊ឺង និង ក្រុមការងារ ដែល ស្ថាបនា នូវ សមិទ្ធិផល ជាច្រើន ដូចជា ផ្លូវ ថ្នល់ សាលារៀន បណ្ណាល័យ វត្តអារ៉ាម អណ្តូង ទឹក សាលា ឃុំ មន្ទី បក្ស បុស្តិ៍ នគរបាល ឃុំ ម៉ាស៊ីនភ្លើង និង សាខា កាកបាទ ក្រហម ស្រុក ស្រីសន្ធរ ។
បើ តាម KCNA លោក គីម និង លេខាធិការ ជាន់ ខ្ពស់ ផ្សេង ទៀត របស់ គណបក្ស បាន ពិភាក្សា អំពី « ការតស៊ូ កាន់តែ ខ្លាំង ឡើង ប្រឆាំង នឹង ទង្វើ ដែល មិន សមរម្យ និង មិន ស្រប តាម មាគ៌ា បដិវត្តន៍ រួមទាំង ការរំលោភបំពាន លើ អំណាច និង ការិយាធិបតេយ្យ ដែល បាន បញ្ចេញ ឱ្យ ឃើញ ក្នុង ចំណោម ក្រុម មន្ត្រី បក្ស មួយចំនួន » ។
លោក គីម បាន បញ្ជា ឱ្យ អាជ្ញាធរ នៃ គណៈកម្មការ សវនកម្ម របស់ គណបក្ស និង ប្រព័ន្ធ ត្រួតពិនិត្យ វិន័យ ក្នុង ស្រុក ផ្សេង ទៀត ពង្រឹង សមត្ថភាព ដើម្បី លើកកម្ពស់ « ការដឹកនាំ និង សកម្មភាព នយោបាយ ដ៏ ទូលំទូលាយ របស់ គណបក្ស តាមរយៈ ប្រព័ន្ធ ត្រួតពិនិត្យ វិន័យ ដ៏ រឹងមាំ » ។
អ្នកជំនាញ បរទេស មាន ការសង្ស័យ ថា វា គឺជា ការផ្ទុះឡើង លើក ទី១ របស់ ប្រទេស នេះ ហើយ ពួកគេ ជឿ ថា ស្ថិតិ ដែល ត្រូវបាន បង្ហាញ នៅក្នុង ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ត្រូវបាន រៀបចំ ដើម្បី ការពារ ការខូចខាត ផ្នែក នយោបាយ របស់ លោក គីម ខណៈ រូប លោក កំពុង ព្យាយាម ពង្រឹង ការគ្រប់គ្រង ផ្ទៃក្នុង និង ការលើកកម្ពស់ ការដឹកនាំ របស់ លោក ៕
ជូនដំណឹង ! បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្ត្រីរាជការ ស៊ីវិល នឹង បើក ប្រាក់ ប្រចាំ ខែមិថុនា សម្រាប់ ២សប្តាហ៍ លើក ទី១ ចាប់ពី ថ្ងៃទី ១៤ ខែមិថុនាត ទៅ
( ភ្នំពេញ ) ៖ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ប្រាក់ ប្រចាំ ខែមិថុនា សម្រាប់ ២សប្តាហ៍ លើក ទី១ ជូន និវត្ត ជន និង អតីត មន្ត្រីរាជការ ស៊ីវិល ចាប់ពី ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២២ត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
យោង តាម សេចក្តីជូនដំណឹង របស់ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ ស៊ីវិល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន បញ្ជាក់ ថា « ប្រាក់ គោល នយោបាយ របប សន្តិសុខ សង្គម ប្រចាំ ខែមិថុនា សម្រាប់ ២សប្តាហ៍ លើក ទី១ ជូន និវត្ត ជន និង ជន បាត់បង់ សម្បទា វិជ្ជាជីវៈ និង អតីត មន្ត្រីរាជការ ស៊ីវិល នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២២ត ទៅ » ។
ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ សម្ដេច តេជោ ហ៊ុន សែន បាន អះអាង ថា វ៉ាក់សាំង ដែល នៅ ក្រៅ ប្រទេស ប្រមាណ ជាង ២០លាន ដូស ហើយ ត្រៀម បញ្ជូន មក កម្ពុជា នោះ រួម មាន នៅ ប្រទេស ចិន ចំនួន ១៥លាន ដូស . នៅ សហរដ្ឋ អាមេរិក ចំនួន ៥. ៥លាន ដូស និង ប្រទេស អូស្ដ្រាលី ចំនួន ៥សែន ដូស ។ វ៉ាក់សាំង នេះ ត្រៀម សម្រាប់ ប្រើប្រាស់ ក្នុង ឆ្នាំ ២០២២ និង ឆ្នាំ ២០២៣ ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន បន្ដ ទៀត ថា បច្ចុប្បន្ន កម្ពុជា កំពុង ដំណើរការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូស ទី៥ជូន មន្ដ្រីរាជការ ជួរ មុខ និង ក្រុម គោលដៅ អាទិភាព ខណៈ សម្ដេចក៏ ត្រៀម ចាក់ ដូស ទី៥នេះ ដូចគ្នា ផងដែរ ប៉ុន្ដែ ប៉ុន្មាន ថ្ងៃ មុន នេះ សម្ដេច បាន យក ឈាម ទៅ ពិនិត្យ ឃើញ អង់ទី គ័រ នៅ ខ្ពស់ ដែល នៅសល់ ដូស ទី៤។ សម្ដេច បាន បង្ហើប ថា សម្ដេចក៏ បាន ចាក់ វ៉ាក់សាំង ការពារ សួត ផងដែរ ។
បន្ថែម ពី នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ បន្ដ មក ទទួលយក នូវ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ។ សម្ដេច នៅតែ បន្ដ អះអាង ថា ចាក់ វ៉ាក់សាំង បង្ការ ជំងឹកូវីដ១៩ នេះ រដ្ឋ មិន គិត ថ្លៃ ពី ប្រជាពលរដ្ឋ នោះ ឡើយ កុំ ថា ឡើយ ត្រឹម ចាក់ ដូស ទី៥ ទោះបី ត្រូវ ចាក់ ដល់ ដូស ទី២០ ក៏ នៅតែ មិន យក លុយ នោះ ទេ ហើយ សម្ដេច ថា ការចាក់ វ៉ាក់សាំង យក លុយ ពី ប្រជាពលរដ្ឋ ក៏ មិន អាច ធ្វើឲ្យ កម្ពុជា ក្លាយជា ប្រទេស អ្នក មាន បាន ដែរ ។
សម្ដេច តេជោ ហ៊ុន សែន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ អាច ប្រកាស សារជាថ្មី ម្ដង ទៀត កុំ ថា ឡើយ ដូស ទី៥ ដល់ ដូស ទី២០ ក៏ នៅតែ មិន យក លុយ នោះ ដែរ ។ ព្រោះ នេះ ជា តម្រូវការ ហើយ ប្រសិនបើ យក លុយ សម្រាប់ អ្នក ដែល មិន ចង់ ចាក់ វ៉ាក់សាំង ស្រាប់ ផង ក៏ មិន ទៅ អ្នក ដែល ចង់ ចាក់ វ៉ាក់សាំង បែរជា ត្រូវ សូកប៉ាន់ លុយកាក់ បង្កើត ជា អំពើពុករលួយ ពេញ ប្រទេស ដូច្នេះ ត្រូវ គិត ឲ្យ ច្បាស់ » ។
នាយក រដ្ឋមន្ដ្រី ដែល តម្កល់ ប្រយោជន៍ ជាតិ និង ប្រជាជនជា ធំ រូប នេះ បាន សង្កត់ធ្ងន់ ទៀត ថា នៅ ពេល នេះ ប្រជាពលរដ្ឋ ត្រូវការ ឲ្យ រាជ រដ្ឋាភិបាល ជួយ មិន មែន ត្រូវការ ឲ្យ យក លុយ ពី ពួកគាត់ នោះ ទេ ដូច្នេះហើយ មិន ថា អ្នក មាន ឬ អ្នកក្រ គឺ ត្រូវ ចាក់ វ៉ាក់សាំង ហើយ ចាក់ មិន យក លុយ ដូចគ្នា ។
សូម ជម្រាប ថា គិត ត្រឹម យប់ ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ០៥៦. ៥៨០ នាក់ ។ ក្នុង នោះ រួម មាន៖
គួរ បញ្ជាក់ ថា បើ តាម សេតវិមាន ដំណើរទស្សនកិច្ច របស់ លោក ចូ បៃ ដិន នឹង មាន គោលបំណង ពង្រឹង ទំនាក់ទំនង ជាមួយ អារ៉ាប៊ី សាអូឌីត ខណៈ លោក បៃ ដិន កំពុង ព្យាយាម រក វិធីសាស្រ្ត ដើម្បី បញ្ចុះ តម្លៃ ប្រេងឥន្ធនៈ នៅ សហរដ្ឋ អាមេរិក ផងដែរ ៕
ការថ្លែងអំណរគុណ បែប នេះ របស់ សម្តេច តេជោ ហ៊ុ ន សែន បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ គួរតែ យក ពេលនេះ អរគុណ ចំពោះ ប្រជាជន កម្ពុជា ជាង ៨០ ភាគរយ នៃ អ្នក ដែល បាន ចុះឈ្មោះ បោះឆ្នោត ហើយ បាន ទៅ បោះឆ្នោត ប្រកបដោយ ភាពស្ងាត់ ស្ងៀម អព្យាក្រឹត្យភាព ខាងន យោនាយ សេរី និង យុត្តិធម៌ ទោះបី អ្នកណា ថា ម៉េច ក៏ ថា ទៅ ប៉ុន្តែ ការជាក់ស្តែង វា បាន បង្ហាញ មក អញ្ចឹង កម្ពុជា ហែ ក្បួន អត់ មាន ការប៉ះទង្គិត គប់ គ្នា វ៉ៃ គ្នា ជេរ បញ្ចោរ គ្នា ក៏ អត់ មាន ... !» ។
បន្ថែម ពី នេះ នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក៏ បាន រំឮក ថា បើ ទោះបី មាន ករណី គប់ គ្រាប់បែក កែច្នៃ មួយ នៅ ទី រួម ខេត្ត សៀមរាប ដោយសារតែ មាន គុំនុំ នឹង គ្នា ដូច្នេះ ចំពោះ ករណី នេះ វា អត់ មាន ទំនាក់ទំនង លើ ដំណើរ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ នោះ ទេ ។ ចំពោះ ករណី នេះ បើ ទោះបី មិន មាន ដំណើរការបោះឆ្នោត ក៏ បញ្ហា នេះ វា នឹង កើតឡើង ដែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្រាប់ ដំណើរការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ នេះ គឺ មាន គណបក្ស នយោបាយ ចំនួន ១៧ បាន ចូលរួម ប្រកួតប្រជែង ដោយ ក្នុង នោះ គ្រប់ គណបក្ស នយោបាយ សុទ្ធតែ ទទួលបាន សំលេង គាំទ្រ ទាំងអស់ ទោះ តិច ក្តី ច្រើន ក្តី ។
ជាមួយគ្នា នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន « ខ្ញុំ អរគុណ ប្រជាពលរដ្ឋ ដែល បាន អនុវត្តន៍ សិទ្ធិ របស់ ខ្លួន នោះ គឺ សិទ្ធិ ជ្រើសរើស មេដឹកនាំ ដែល ខ្លួន ពេញចិត្ត » ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ និង កោតស សើរ ដល់ គណៈកម្មការគ្រប់គ្រង សន្តិសុខ ការពារ ការបោះឆ្នោត ដែល ដឹកនាំ ដោយ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ដែល បាន ធ្វើ កិច្ចការ ដ៏ ល្អ សម្រាប់ ដំណើរ នៃ ការបោះឆ្នោត ដោយ រក្សា បាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ បាន យ៉ាង ល្អ ប្រសើរ ក្រោម ការបញ្ជា និង ចាត់ចែង របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ បោះឆ្នោត ( គ.ជ. ប) ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ និង អបអរសាទរ ចំពោះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ដែល បាន រៀបចំ ដំណើ ការបោះឆ្នោត បាន ល្អ ប្រសើរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ដែល បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ។ សម្តេច ចាត់ទុក ការបោះឆ្នោត របស់ ប្រជាជន ជូន គណបក្ស ប្រជាជន កម្ពុជា គឺជា ការបោះឆ្នោត ជ្រើសរើស យក សន្តិភាព និង ការអភិវឌ្ឍ ។
គួរ ជម្រាប ថា សម្រាប់ លទ្ធផល បឋម នៃ ការបោះឆ្នោត ជ្រើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ នឹង ត្រូវ បិទ ប្រកាស តាម មូលដ្ឋាន នានា នៅ តាម ឃុំ សង្កាត់ ទូទាំង ប្រទេស និង ផ្សព្វផ្សាយ តាម បណ្តាញ ផ្លូវការ របស់ គ.ជ. ប ចំណែក លទ្ធផល ផ្លូវការ នឹង ត្រូវ ប្រកាស នៅ ថ្ងៃទី ២៦ ខែមិថុនា ឆ្នាំ ២០២២ ខាងមុខ នេះ ។
សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្ត ទី៥ កាលពី ថ្ងៃអាទិត្យ ទី៥ ខែមិថុនា កន្លងទៅ នេះ មាន ប្រជាពលរដ្ឋ ប្រមាណ ជាង ៨០ .១៩ ភាគរយ បាន ទៅ បោះឆ្នោត ក្នុង ចំណោម ប្រជាពលរដ្ឋ ជាង ៩.២លាន នាក់ ដែល មាន ឈ្មោះ នៅក្នុង បញ្ជី បោះឆ្នោត ។
វិធានការ នានា ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ពិសេស នៅ ព្រឹត្តិការណ៍ ២០កុម្ភៈ ឆ្នាំ ២០២១ រួម មាន ដោយ មាន ការបិទ ខ្ទប់ ទីក្រុង វិធានា ការ ចាក់ វ៉ាក់សាំង រួមទាំង ការឧបត្ថម្ភ ប្រាក់ ជូន ប្រជាពលរដ្ឋ ជាង ៣លាន នាក់ ជាដើម ។
ការថ្លែង យ៉ាង ដូច្នេះ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី អញ្ជើញ ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ ។
សម្តេច តេជោ បាន ថ្លែង បន្ត ថា ក្នុង រយៈពេល ២ឆ្នាំ កន្លងមក នេះ កម្ពុជា បាន រៀនសូត្រ ច្រើន ពី វិបត្តិ កូវីដ១៩ ហើយ ចាត់ទុក ជា ភាពជោគជ័យ របស់ កម្ពុជា ដែល គ្រប់គ្រង លើ ជំងឺ រាតត្បាត កូវីដ១៩ បាន យ៉ាង ល្អ ទាំង រាជ រដ្ឋាភិបាល និង ប្រជាជន បាន ខិតខំ ប្រឹងប្រែង យ៉ាង ខ្លាំង ដើម្បី យកឈ្នះ លើ សមរភូមិ កូវីដ១៩ តាមរយៈ វិធានការ របស់ បុគ្គល ម្នាក់ និង វិធានការ ដែល ដាក់ចេញ ដោយ រាជ រដ្ឋាភិបាល រួមទាំង ការដាក់ចេញ នូវ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ។
សម្តេច តេជោ ហ៊ុន សែន បន្ថែម ថា រហូតមកដល់ ពេលនេះ កម្ពុជា បាន យកឈ្នះ លើ សមរភូមិ កូវីដ១៩ ទាំង សមរភូមិ ដែល តា សមរភូមិ អាល់ហ្វា និង សមរភូមិ អូមី ក្រុង ប៉ុន្តែ មិន ទាន់ យកឈ្នះ សង្គ្រាម កូវីដ១៩ នៅឡើយ នោះ ទេ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន រំលឹក ផងដែរ ថា បើ និយាយ ពី ពេលនេះ ឆ្នាំ ទៅ គឺ រាជ រដ្ឋាភិបាល កំពុង ដាក់ចេញ នូវ វិធានការបន្ទាន់ ខ្លាំង គឺ ការពន្លឿន ការរៀបចំ ក្តាម ឈូស ព្រោះតែ ពេល នោះ អត្រា ស្លាប់ មាន កម្រិត ខ្ពស់ ។ ប៉ុន្តែ សម្រាប់ ពេលនេះ ដោយសារតែ វិធានការចាំបាច់ ចាំ គោលដៅ របស់ រាជ រដ្ឋាភិបាល និង មាន ការចូលរួម ពី ប្រជាជន គ្រប់ រូប ធ្វើឲ្យ កម្ពុជា អាច បើក សេដ្ឋកិច្ច ឡើងវិញ លើ គ្រប់ វិស័យ តាម បែប គន្លង ថ្មី ។
សម្តេ តេជោ ហ៊ុន សែន បាន ថ្លែង បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « វិធានការ របស់ រាជ រដ្ឋាភិបាល នៅ ពេល នោះ គឺ ដើម្បី ពេលនេះ ឯង ដែល ពេល នោះ រាជ រដ្ឋាភិបាល ត្រូវ បង្ខំ ចិត្ត បិទ ទីក្រុង ភ្នំពេញ តា ខ្មៅ ខេត្ត ព្រះសីហនុ បន្ទាប់ ទៅ យើង ក៏ បាន ដាក់ចេញ នូវ ការបិទ ខ្ទប់ តាម គោលដៅ ដែល មាន ការបែងចែក ជា តំបន់ ក្រហម និង ពណ៌ ផ្សេង ៗ ។ ការបែងចែក តំបន់ ទាំងនេះ ឬ ការដាក់ចេញ វិធានការ ទាំងឡាយ គ្មាន អ្វី ក្រៅពី សេចក្តីសុខ របស់ ប្រជាជន នោះ ទេ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ទៀត ថា ពី ពេលនេះ ដល់ ២ ឬ ៣ឆ្នាំ ខាងមុខ ប្រធានបទ នៃ ជំងឺ កូវី១៩ នៅតែ ជា បញ្ហា សាំ ញាំ និង ស្មុគស្មាញ ព្រោះ កូវីដ១៩ មិន ទាន់ ចប់ ទេ ហើយក៏ មិន ទាន់ ទៅ ណា ឆ្ងាយ ពី ប្រជាជន ដែល ទាមទារ ឲ្យ បន្ត ប្រុងប្រយ័ត្ន ខ្ពស់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា មិន មាន និន្នាការ នយោបាយ នោះ ឡើយ ។ ពោល គ្រប់ និន្នាការ នយោបាយ សុទ្ធតែ បាន ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ។ សម្តេច បញ្ជាក់ ថា ទោះ ប្រជាពលរដ្ឋ ជឿ បក្ស នយោបាយ ឬ សាសនា ណា សម្តេច មិន ខ្វល់ នោះ ទេ អ្វី ដែល ខ្វល់ គឺ ការការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ។
សូម ជម្រាប ថា ដោយសារតែ វិធានការចាំបាច់ និង ចាំ គោលដៅ របស់ រាជ រដ្ឋាភិបាល ពិសេស យុទ្ធនាការ ស្រោច វ៉ាក់សាំង កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ បាន ធ្វើឲ្យ កម្ពុជា បើក ប្រទេស ធម្មតា ឡើងវិញ ខណៈ អ្នក ឆ្លង ដោយសារ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា មិន មាន នោះ ទេ ក្នុង រយៈពេល ជាង ១ ខែ មក នេះ ។
ប្រទេស ចិន និង សហរដ្ឋ អាមេរិក ជា ប្រទេស ធំ សំខាន់ ទាំង ពីរ លើ ពិភពលោក ការសម្រេចបាន នូវ សន្តិភាព និង ការអភិវឌ្ឍ នៃ ពិភពលោក គឺ មិន អាច ខ្វះ ពី កិច្ចសហប្រតិបត្តិការ រវាង ចិន និង អាមេរិក នោះ ទេ ការប្រឈមមុខ ដាក់ គ្នា គឺ គ្មាន ប្រយោជន៍ ទេ សម្រាប់ ប្រទេស ទាំង ពីរ និង ពិភពលោក ។ ប្រទេស ចិន ប្រឆាំង ចំពោះ ការប្រើប្រាស់ ការប្រកួតប្រជែង ដើម្បី កំណត់ ទំនាក់ទំនង ចិន - អាមេរិក ប្រសិនបើ អាមេរិក ទទូច ចាត់ទុក ប្រទេស ចិន ជា ការគំរាមកំហែង គូ ប្រជែង ឬ សត្រូវ វា នឹង ធ្វើ កំហុស ជា យុទ្ធសាស្ត្រ និង ប្រវត្តិសាស្ត្រ ។
ក្រៅពី នេះ យោធា នៃ ប្រទេស ទាំង ពីរ គួរតែ ពង្រឹង ទំនុកចិត្ត យុទ្ធសាស្ត្រ ទៅ វិញ ទៅ មក ជៀសវាង ការយល់ ច្រឡំ និង ការវិនិច្ឆ័យ ខុស គ្រប់គ្រង ហានិភ័យ និង វិបត្តិ និង ការពារ ការកកិត និង ការប៉ះទង្គិច ។ ប្រទេស ចិន រំពឹងទុក ថា នឹង អាច បង្កើត ទំនាក់ទំនង ភាពជា ប្រទេស ធំ ដែល វិវឌ្ឍ រីកចម្រើន ទៅ មុខ យ៉ាង ល្អ ប្រសើរ និង ប្រកបដោយ ស្ថិរភាព ជាមួយ សហរដ្ឋ អាមេរិក ហើយ នឹង ការពារ យ៉ាង ម៉ឺងម៉ាត់ នូវ ផលប្រយោជន៍ និង សេចក្តីថ្លៃថ្នូរ របស់ ជាតិ ចិន ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ក្នុង ឱកាស អញ្ជើញ ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ បន្ទាប់ពី ពួកគេ បាន បញ្ចប់ ការសិក្សា ដោយ ជោគជ័យ ។ សិស្សសាលា ភូមិន្ទ រដ្ឋបាល ដែល បញ្ចប់ ការសិក្សា វិជ្ជាជីវៈ ជា មន្ត្រី និង ទទួល សញ្ញាបត្រ ក្រោម អធិបតីភាព សម្តេច តេជោ នៅ ថ្ងៃ នេះ រួម មាន៖ សិស្ស កម្មសិក្សា ការី និង សិក្ខាកាម សរុប ២. ៣៨៨នាក់ ។
នៅក្នុង ឱកាស ចែក ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង សុន្ទរកថា សំណេះសំណាល ប្រមាណ ជិត ២ ម៉ោង ៣០នាទី . ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ៖
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ព្រោះតែ ការរាត ត្បាត ជំងឺ កូវីដ១៩ នាំឱ្យ ខកខាន ការរៀបចំ កម្មវិធី ផ្តល់ សញ្ញាបត្រ សម្រាប់ សិស្សសាលា ភូមិន្ទ រដ្ឋបាល កាលពី ឆ្នាំ ២០២១ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ពេលនេះ កម្ពុជា បាន យកឈ្នះ លើ ជំងឺ កូវីដ១៩ ហើយ អនុញ្ញាតឱ្យ មាន ការរៀបចំ កម្មវិធី ឡើងវិញ តាម បែប គន្លង ថ្មី ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ការអបអរសាទរ និង កោតសរសើរ ចំពោះ សិស្សសាលា ភូមិន្ទ រដ្ឋបាល ដែល បាន បញ្ចប់ ការសិក្សា ដោយ ជោគជ័យ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បើ ទោះបី ជំងឺ កូវីដ១៩ បាន រាតត្បាត នៅ កម្ពុជា តែ មិន បាន បង្អាក់ ការអប់រំ របស់ កម្ពុជា នោះ ឡើយ ។ ទាំង ថ្នាក់ដឹកនាំ សាលា សាស្ត្រាចារ្យ និង សិស្ស បាន ប្រឹងប្រែង រួមគ្នា ជម្នះ ការលំបាក ដើម្បី ការអប់រំ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការកែទម្រង់ ដែល ល្អ ប្រសើរ គឺ ផ្តើម ចេញ ពី ការបណ្តុះបណ្តាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គ្រប់ ក្រសួង ស្ថាប័ន អាច ដំណើរការបាន ល្អ ប្រសើរ គឺ ទាមទារ ចាំបាច់ នូវ ធនធាន មនុស្ស ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បច្ចុប្បន្ន និង ទៅ ខាងមុខ ច្រើន ឆ្នាំ ទៀត កូវីដ១៩ នៅតែ ជា បញ្ហា ស្មុគស្មាញ សម្រាប់ សង្គម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ មិន មែន ជា រឿង សាមញ្ញ នោះ ទេ ម្នាក់ ៗ បាន ប្រឹងប្រែង ខ្លាំង ណាស់ ក្នុង ការប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា វិធានការ ទាំងឡាយ ដែល រាជ រដ្ឋាភិបាល ដាក់ចេញ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ គឺ ដើម្បី ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រាប់ ទៅ អគ្គ រដ្ឋទូត សភាព អឺរ៉ុប ថា សម្រាប់ អឺរ៉ុប ផ្តល់ សិទ្ធិ អ្វី ជា អាទិភាព មិន ដឹង ទេ តែ សម្រាប់ កម្ពុជា ផ្តល់ អាទិភាព លើ សិទ្ធិ រស់ រៀន មាន ជីវិត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ដើម្បី យកឈ្នះ លើ សមរភូមិ ជំងឺ កូវីដ១៩ កម្ពុជា បាន ប្រមូលផ្តុំ គ្រប់ កម្លាំង ទាំងអស់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា មិន មាន និន្នាការ នយោបាយ នោះ ឡើយ ។ ពោល គ្រប់ និន្នាការ នយោបាយ សុទ្ធតែ បាន ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប្រជាពលរដ្ឋ ជឿ បក្ស នយោបាយ ឬ សាសនា ណា សម្តេច មិន ខ្វល់ នោះ ទេ អ្វី ដែល ខ្វល់ គឺ ការការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ ពុត ត្បុត ទុច្ចរិត របស់ ក្រុម ប្រឆាំង លើ នយោបាយ វ៉ាក់សាំង ។ ដំបូង គេ ហាម ពលរដ្ឋ មិន ឱ្យ ទៅ ទទួល វ៉ាក់សាំង បន្ទាប់មក គេ រុញ ពលរដ្ឋ ឱ្យ ទៅ ដណ្តើម វ៉ាក់សាំង នៅពេល កម្ពុជា កំពុង ខ្វះ វ៉ាក់សាំង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ភាព ពិស ពុល ឧបាយកល ទុច្ចរិត របស់ ក្រុម ប្រឆាំង លើ ការចាក់ វ៉ាក់សាំង ត្រូវ បរាជ័យ ព្រោះតែ សិល្បៈ នៃ ការដោះស្រាយ បញ្ហា របស់ រាជ រដ្ឋាភិបាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នយោបាយ ទម្លាក់ អំណាច ទៅ ថ្នាក់ ក្រោម ជាតិ ជា ការរួមចំណែក ធ្វើឱ្យ កម្ពុជា អាច គ្រប់គ្រង និង យកឈ្នះ លើ សមរភូមិ កូវីដ១៩ ។
* ផ្តើម ចេញ ពី បទពិសោធន៍ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន លើកទឹកចិត្ត ដល់ ក្រសួង ស្ថាប័ន នានា ទម្លាក់ អំណាច ទៅ មន្ត្រី ថ្នាក់ ក្រោម ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ដំណាក់កាល ដឹកនាំ របស់ សម្តេច និង ឥស្សរជន របស់ ជាតិ ជាច្រើន ទៀត បាន បន្សល់ទុក មរតក ជាច្រើន សម្រាប់ អ្នកជំនាន់ ក្រោយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រាប់ ឯក អគ្គ រដ្ឋទូត សហភាព អឺរ៉ុប ថា ក្រុម ប្រឆាំង បាន ប្រមាថ មើលងាយ សម្តេច ខ្លាំង ណាស់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គេ គួរតែ ផ្តល់ តម្លៃ ចំពោះ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា ដែល មិន មាន ការប្រកាន់ និន្នាការ នយោបាយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ប្រជាពលរដ្ឋ បន្ត ទៅ ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូស ជំរុញ ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ឱ្យ ប្រជាពលរដ្ឋ រួមគ្នា ទប់ទល់ នឹង វិបត្តិ សេដ្ឋកិច្ច សាកល កើត ចេញ ពី ជំងឺ កូវីដ១៩ និង សង្គ្រាម រុស្ស៉ី - អ៊ុយក្រែន ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ទប់ស្កាត់ អតិផរណា ហើយ ជំរុញ ការប្រើប្រាស់ ប្រាក់ រៀល ដើម្បី ទប់ទល់ នឹង វិបត្តិ សេដ្ឋកិច្ច សាកល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា វិបត្តិ ស្បៀង នឹង ក្លាយទៅជា វិបត្តិ សាកល នា ពេល ខាងមុខ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នឹង មាន ការដំឡើង ប្រាក់ បៀវត្សរ៍ មន្ត្រីរាជការ នៅក្នុង ឆ្នាំ ២០២២ នេះ បន្ទាប់ពី ខកខាន អស់ រយៈពេល ពីរ ឆ្នាំ ។ ក្នុង នោះ អ្នកប្រាក់ បៀវត្សរ៍ តិច ដំឡើង ច្រើន អ្នក ប្រាក់ បៀវត្សរ៍ ច្រើន ដំឡើង តិច ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ ជាង ៨០ ភាគរយ នៃ អ្នក ចុះឈ្មោះ បោះឆ្នោត ដែល បាន អញ្ជើញ ទៅ បោះឆ្នោត កាលពី ថ្ងៃទី ០៥ ខែមិថុនា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន អរគុណ ប្រជាពលរដ្ឋ ដែល បាន អនុវត្តន៍ សិទ្ធិ របស់ ខ្លួន ក្នុង ការជ្រើសរើស មេដឹកនាំ ខ្លួន ពេញចិត្ត ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ដល់ គណៈកម្មការគ្រប់គ្រង សន្តិសុខ ក្នុង កំលុង ពេល បោះឆ្នោត ដែល រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ បាន យ៉ាង ល្អ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ និង អបអរសាទរ ចំពោះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ដែល បាន រៀបចំ ដំណើ ការបោះឆ្នោត បាន ល្អ ប្រសើរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ដែល បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ចាត់ទុក ការបោះឆ្នោត របស់ ប្រជាជន ជូន គណបក្ស ប្រជាជន កម្ពុជា គឺជា ការបោះឆ្នោត ជ្រើសរើស យក សន្តិភាព និង ការអភិវឌ្ឍ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការបាត់បង់ អាសនៈ មួយចំនួន ទៅ ក្រុម ប្រឆាំង គ្រាន់តែ ជា រឿង ធម្មតា នៃ ដំណើរការ ប្រជាធិបតេយ្យ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការទទួលបាន អាសនៈ មេឃុំ / ចៅសង្កាត់ ជាង ៩០ ភាគរយ . ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ ជាង ៨០ ភាគរយ គឺ គ្រប់គ្រាន់ ហើយ សម្រាប់ គណបក្ស ប្រជាជន កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច មិន ខ្វល់ ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ មកពី បក្ស នយោបាយ ណាមួយ នោះ ទេ គឺ ត្រូវ រួមគ្នា ធ្វើ ការ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង អំពាវនាវ កុំ ឱ្យ ដំណើរការបោះឆ្នោត ទៅជា ការបែកបាក់ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា មន្ត្រី ត្រូវ ក្រើន រំលឹក ខ្លួន ឯង ឱ្យ ជាប់ ជាប្រចាំ ថា ខ្លួន ជា អ្នកបម្រើ ប្រជាពលរដ្ឋ មិន មែន ជា ចៅហ្វាយ ពលរដ្ឋ នោះ ទេ ហើយ គោលដៅ របស់ ខ្លួន គឺ ការបម្រើ ប្រជាពលរដ្ឋ ដោយ ស្មោះត្រង់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ដើម្បី សម្រេច ការងារ មួយ បាន ត្រូវ ឈរ លើ ដំណាក់កាល ចំនួន ៣ រួម មាន៖ ការរៀបចំ ផែនការ ការចាត់តាំង អនុវត្តន៍ និង ការដោះស្រាយ លើ កត្តា ចៃដន្យ លេចឡើង ពេល អនុវត្តន៍ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការលេចឡើង នៃ កត្តា ចៃដន្យ ក្នុង ការអនុវត្តន៍ ផែនការ នឹង ធ្វើឱ្យ លេចឡើង មន្ត្រី ចំនួន ពីរ គឺ មន្ត្រី ល្អ ប្រឹងប្រែង ដោះស្រាយ បញ្ហា និង មន្ត្រី មិន ល្អ ចេះ ត្រឹម ស្តីបន្ទោស ឱ្យ ថ្នាក់ ក្រោម និង រាយការណ៍ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នៅ ថ្ងៃទី ១៦ និង ១៧ ខែកក្កដា គណបក្ស ប្រជាជន នឹង ធ្វើ សន្និបាត វិសាមញ្ញ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង កោតសរសើរ ដល់ អាជ្ញាធរ ដែល ប្រឹងប្រែង ដោះស្រាយ ការងារ ក្នុង កំលុង ពេល វិបត្តិ កូវីដ១៩ ដោយ មិន រង់ចាំ បទបញ្ជា ។
* សម្តេច តេជោ ហ៊ុន សែន ក្រើន រំលឹក ដល់ មន្ត្រី ត្រូវ ចៀសវាង ឱ្យ បាន ដាច់ខាត នូវ ងារ ជា មន្ត្រី គ្រាប់ ល្ពៅ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្នកស្នេហាជាតិ មិន ស្ថិត លើ ការនិយាយ នោះ ទេ តែ ស្ថិតលើ សកម្មភាព ជាក់ស្តែង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា មន្ត្រី គ្រាប់ ល្ពៅ ប្រភេទ ទី១ គួរ យក ឱ្យ ដំរី ជាន់ ហើយ មន្ត្រី គ្រាប់ ល្ពៅ ប្រភេទ ទី៤ គួរ លើកទឹកចិត្ត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច និង នាយក រដ្ឋមន្ត្រី វៀតណាម នឹង អញ្ជើញ ប្រារព្ធ ខួប ៤៥ ឆ្នាំ នៃ ដំណើរ តស៊ូ រំដោះ ជាតិ នៅ ព្រឹម ដែន កម្ពុជា - វៀតណាម នា ថ្ងៃទី ២០ ខែមិថុនា ។
* នាយក រដ្ឋមន្ត្រី ឡាវ ហៅ ទូរស័ព្ទ មកកាន់ សម្តេច តេជោ ពេល កំពុង ថ្លែង លើ វេទិកា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច នឹង ត្រៀម សួរ មនុស្ស ម្នាក់ ពាក់ព័ន្ធ កន្លងមក ធ្លាប់ លើកឡើង ថា មាន ការចាប់ មនុស្ស រាប់ រយ នាក់ នៅពេល មាន វិបត្តិ កូវីដ១៩ ។
គួរ បញ្ជាក់ ថា បើ តាម វិទ្យាស្ថាន SIPRI រុស្ស៉ី គឺជា ប្រទេស ដែល មាន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ ច្រើន ជាង គេ បំផុត នៅលើ ពិភពលោក ដោយ មាន ៥. ៩៧៧ គ្រាប់ ឬ ច្រើន ជាង សហរដ្ឋ អាមេរិក ៥៥០ គ្រាប់ ។ ចំនួន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ សកល បាន ធ្លាក់ចុះ ពី ១៣. ០៨០ គ្រាប់ ក្នុង ខែមករា ឆ្នាំ ២០២១ មក នៅ ត្រឹម ១២. ៧០៥ គ្រាប់ ក្នុង ខែមករា ឆ្នាំ ២០២២ នេះ ហើយ ក្បាល គ្រាប់ នុយក្លេអ៊ែរ ៣. ៧៣២ គ្រាប់ ត្រូវបាន បំពាក់ លើ មីស៊ីល និង យន្ដហោះ ចម្បាំង រួច ជាស្រេច ៕
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ១. ៧៩៥ ករណី ជា ករណី ឆ្លង ក្នុង ស្រុក និង ៦ករណី ទៀត ជា ករណី នាំចូល ពី ក្រៅ ប្រទេស ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ១៥នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ២. ៣៣០នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃចន្ទ ទី១៣ ខែមិថុនា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា អញ្ជើញ ចែក សញ្ញាបត្រ ជូនសិស្សសាលា ភូមិន្ទ រដ្ឋបាល ជាង ២ពាន់ នាក់ បន្ទាប់ពី ពួកគេ បាន បញ្ចប់ ការសិក្សា ដោយ ជោគជ័យ ។
យោង តាម របាយការណ៍ បាន ឱ្យដឹង ថា សិស្សសាលា ភូមិន្ទ រដ្ឋបាល ដែល បញ្ចប់ ការសិក្សា វិជ្ជាជីវៈ ជា មន្ត្រី និង ទទួល សញ្ញាបត្រ ក្រោម អធិបតីភាព សម្តេច តេជោ នៅ ថ្ងៃស្អែក នេះ រួម មាន៖ សិស្ស កម្មសិក្សា ការី និង សិក្ខាកាម សរុប ២. ៣៨៨នាក់ ។
សាលា ភូមិន្ទ រដ្ឋបាល គឺជា សាលា បណ្តុះបណ្តាល វិជ្ជាជីវៈ ជូន ដល់ មន្ត្រីរាជការ ។ សាលា ភូមិន្ទ រដ្ឋបាល បាន បើក ដំណើរការ ឡើងវិញ នៅក្នុង ឆ្នាំ ១៩៩២ ។ ចាប់តាំងពី ឆ្នាំ ១៩៩២ មកដល់ ពេល បច្ចុប្បន្ន សាលា ភូមិន្ទ រដ្ឋបាល បណ្តុះបណ្តាល សិស្ស បាន ចំនួន ១៦. ៦០៦ នាក់ ក្នុង នោះ មាន នារី ៣. ៨០៧ នាក់ ស្មើនឹង ២៣ភាគរយ ។
ក្នុង ចំណោម ករណី ឆ្លង ខាងលើ មាន ១៥៤ ករណី ជា ករណី នាំចូល ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង ស្រុក ទាំងអស់ ។
អ្នកជំនាញ អារ្យធម៌ ខ្មែរ៖ ស្រាវជ្រាវ នឹង បោះពុម្ព សៀវភៅ « សន្ដិភាព » ជា ម្ដុដ របស់ ព្រះនគរ ខ្មែរ
( ភ្នំពេញ ) ៖ លោក រត្ន័ សណ្ដាប់ អ្នកជំនាញ អារ្យធម៌ ខ្មែរ និង ជា អ្នកនិពន្ធ សៀវភៅ ប្រវត្ដិ ទង់ជាតិ ភ្លេង ជាតិ នគរ រាជ បាន ថ្លែង ថា បើ និយាយ អំពី សង្គម ខ្មែរ យើង ហើយនិយាយ អំពី សន្ដិភាព ដែល សម្ដេច តេជោ ហ៊ុន សែន បាន ពុះពារ គ្រប់ ឧបសគ្គ នាំយក មកវិញ ជូន ជាតិ មាតុភូមិ ដ៏ បវរ នៃ យើង បន្ទាប់ពី ត្រូវបាត់បង់ អស់ រយ: ពេល ប្រមាណ ៥០០ ឆ្នាំ ក្រោយពី ការធ្លាក់ចុះ នៃ អារ្យធម៌ អង្គរ កន្លងមក នេះ ។
អ្នកជំនាញ អារ្យធម៌ ខ្មែរ កំពុង ស្រាវជ្រាវ នឹង បោះពុម្ព សៀវភៅ « សន្ដិភាព » ជា ម្ដុដ របស់ ព្រះនគរ ខ្មែរ ព្រោះ លោក យល់ ថា បើ ខេមរជន ខ្មែរ ថែរក្សា បាន « សន្ដិភាព » ដ៏ ប្រពៃ ថ្លៃថ្លា ដែល មាន ស្រាប់ នេះ បាន ឋិតថេរ គង់វង្ស នោះ គឺ ខ្មែរ និង ខ្លំាង ម្ដង ទៀត ។
ដោយ ឈរ លើ ប្រវត្ដិ សិល្ប: ក្រិក - រ៉ូមុំាង នេះ មាន អ្នកប្រាជ្ញ ជាច្រើន បាន សិក្សា អំពី សារ: សំខាន់ « ទេព នៃ សន្តិភាព » ក្នុង គោលបំណង ស្វែងរក ពី មូលហេតុ សង្គ្រាម និង សន្តិភាព សម្រាប់ មនុស្ស ក្នុង ពិភពលោក ទាំងមូល ដោយ មិន គិត ពី ពណ៌ សំបុល ពូជសាសន៍ ជំនឿ សាសនា រហូត ចុង សតវត្សរ៍ ទី១៩ ឈានដល់ ការបង្កើត ពានរង្វាន់ ណូបែល « សន្តិភាព » សម្រាប់ « សន្តិភាព » អន្តរជាតិ និង ឧត្តម គតិ កី ទ្បា អូឡាំពិក ទៀតផង ។
នេះ សបញ្ជាក់ ឲ្យ យើង ឃើញ ថា តាំងពី បុរាណត រៀងមក « សន្តិភាព » គឺជា គំនិត ផ្សះផ្សា គ្នា សំដៅ ដល់ អវត្ដមាន នៃ សង្រ្គាម អវត្តមាន នៃ ការសម្លាប់ រង្គាល និង ភាពស្ងៀមស្ងាត់ នៃ អាវុធ អវត្តមាន នៃ អរិភាព ហើយ ធ្វើឲ្យ ស្រុក ទេស មាន ភាពសុខដុមរមនា ផ្ដល់ នូវ ការអភិវឌ្ឍន៍ យ៉ាង ឆាប់រហ័ស លើ គ្រប់ វិស័យ កិច្ចសហប្រតិបត្តិការ រវាង ជាតិ និង ប្រជាជាតិ និង មាន អត្ថប្រយោជន៍ ជា មូលដ្ឋាន ដល់ វឌ្ឍនភាព នៃ អរិយធម៌ ។
ត្រង់នេះ ហើយ បាន ជា ក្រោយ សង្រ្គាម លោក លើក ទី២ បន្ទាប់ពី ការបង្កើត អង្គការ សហ ប្រជាជាតិ នា ឆ្នាំ ១៩៤៥មក ពិភពលោក បាន កំណត់ យក ថ្ងៃទី ២១ វិច្ឆិកា ជា ថ្ងៃ បុណ្យ « សន្ដិភាព » សម្រាប់ មនុស្សជាតិ លើ ភព ផែនដី ទាំងមូល ។
១៖ អំពី ផ្លូវ លោក « សន្ដិភាព » គឺជា « ទេព នៃ សន្ដិភាព » ជា អវត្ដមាន នៃ សង្រ្គាម ជា និមិត្ត សញ្ញា នៃ ភាពសុខដុមរមនា របស់ មនុស្សជាតិ ដែល អនុញាតិ ឲ្យ សង្គមជាតិ និមួយ ៗ មាន ឱកាស់ បាន កសាង និង ស្ថាបនា ឡើងវិញ គ្រប់ រចនាសម្ព័ន្ធ សង្គម ដើម្បី ជាតិ របស់ ខ្លួន រៀង ៗ ខ្លួន ។
នៅក្នុង ច្បាប់ ប្រពៃណី របស់ ជនជាតិ យូដា បុគ្គល ត្រូវបាន ហាមឃាត់ មិន ឱ្យ និយាយ ថា «Shalom» នៅពេល ពួកគេ នៅក្នុង បន្ទប់ទឹក ដោយសារ មាន ការហាមឃាត់ មិន ឱ្យ និយាយ ព្រះនាម ណាមួយ នៅក្នុង បន្ទប់ទឹក ដោយ មិន គោរព ចំពោះ ព្រះនាម ដ៏ ទេវភាព ។ ការអធិដ្ឋាន ដ៏ សំខាន់ នៅក្នុង សាសនា យូដា ដែល ត្រូវបាន សូត្រ បី ដង ក្នុង មួយ ថ្ងៃ និង បញ្ចប់ ដោយ ការអង្វរ សុំ « សន្តិភាព » និង ពរ ជ័យ ។
ក្នុង ទស្សនវិជ្ជា នយោបាយ « សន្តិភាព » គឺជា ការដាច់ខាត ប្រឆាំង នឹង អាកប្បកិរិយា ហិង្សា ក្នុង គ្រប់ កាលៈទេសៈ រួមទាំង ការការពារ ខ្លួន ដូចជា ទស្សនះ ប្រធានាធិបតី អាមេរិក ទី១ លោក ចច វ៉ាស៊ីនតោន ជា បិតា សហរដ្ឋ អាមេរិក បាន មានប្រសាសន៍ ថា « សន្ដិភាព » ត្រូវ ត្រៀម ធ្វើ សង្រ្គាម ។ បាន សេចក្ដី ថា « សន្ដិភាព » ត្រូវបាន គេ ចាត់ទុក ជា ម្ដុដ របស់ ព្រះនគរ របស់ គេ ដើម្បី ថែរក្សា ឲ្យបាន ឋិតថេរ គង់វង្ស ត រៀង ទៅ គឺ គេ ត្រូវ ត្រៀម ធ្វើ ការលុបបំបាត់ នូវ ការបះបោរ នាំឲ្យ បែកបាក់ ជាតិ របស់ អាមេរិក ខ្លួន ។
ជា ចុងក្រោយ លោក រត្ន័ សណ្ដាប់ ដែល ជា អ្នកជំនាញ អារ្យធម៌ ខ្មែរ និង ជា អ្នកនិពន្ធ សៀវភៅ ប្រវត្ដិ ទង់ជាតិ ភ្លេង ជាតិ នគរ រាជ យល់ ថា ដោយ « សន្ដិភាព » ជា ទេព មាន គុណ តម្លៃ ដ៏ ធំធេង សំរាប់ គ្រប់ ជាតិ សាសន៍ លើ ពិភពលោក ទាំងមូល តាំងពី បុរាណត រៀង មក នេះ ដូច្នេះ លោក ធ្វើ ការស្រាវជ្រាវ ដើម្បី នឹង បោះពុម្ព ជា សៀវភៅ ទុកឲ្យ ខេមរជន ខ្មែរ បាន ឈ្វេងយល់ ជា ឧត្ដម ប្រយោជន៍ ជាតិ ខ្លួន ត រៀង ទៅ ៕
( កណ្តាល ) ៖ សង្វែក ណាស់ ! ស្ត្រី វ័យ វ័យ ៦៩ ឆ្នាំ ម្នាក់ រស់ នៅ ភូមិ ព្រៃ ធំ ឃុំ វិហារ សួគ៌ ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្តាល បាន យំ សម្រក់ ទឹកភ្នែក បង្ហើយ សុំ ជំនួយ ពី សប្បុរសជន នានា សម្រាប់ ព្យាបាល ជំងឺ ប្តី ដែល កំពុង សម្រាក ព្យាបាល នៅ ផ្ទះ ខណៈ កូនប្រុស ម្នាក់ បាន ជួប គ្រោះថ្នាក់ ចរាចរណ៍ របួស ធ្ងន់ កំពុង សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ ។
រៀបរាប់ ទាំង ទឹកភ្នែក រលីងរលោង លោកស្រី សរ សម្បត្តិ បាន ឱ្យដឹង ថា គាត់ បាន យក ប្តី របស់ ខ្លួន ឈ្មោះ អយ ជុច អាយុ ៧១ ឆ្នាំ ទៅ ព្យាបាល នៅ មន្ទីរ មួយ កន្លែង នា រាជធានី ភ្នំពេញ ដោយ គាត់ និង ប្តី សម្រាក រយៈ ១៩ ថ្ងៃ ប៉ុន្តែ ក្រុម គ្រូពេទ្យ មិន បាន បញ្ជាក់ ថា ប្តី របស់ គាត់ មាន ជំងឺ អ្វី ឱ្យ ច្បាស់ នោះ ទេ ដោយ ជើង ប្តី របស់ គាត់ កាន់តែ រីក ធំ ឡើង ៗ ។
លោកស្រី សរ សម្បត្តិ បាន បន្ត ថា បច្ចុប្បន្ន នេះ គាត់ និង ប្តី គ្មាន ផ្ទះសម្បែង ទេ គឺ ពួកគាត់ រស់ នៅ ជាមួយ កូន ដែល មាន ជីវភាព ខ្វះខាត ។
ជាមួយនឹង ភាពខ្វះខាត យ៉ាង ខ្លាំង បែប នេះ លោកស្រី សរ សម្បត្តិ បាន ទទូច ដង្ហើយ ស្វែងរក សប្បុរសជន ជិត ឆ្ងាយ មេត្តា ជួយ ឧបត្ថម្ភ ជា ថវិកា និង សម្ភារៈ បន្តិចបន្តួច សម្រាប់ ព្យាបាល ជំងឺ ប្តី និង ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ ។
បើ តាម លោក ហឿន ហៀង មេភូមិ ព្រៃ ធំ ឃុំ វិហារ សួគ៌ ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្តាល បាន បញ្ជាក់ ថា សម្រាប់ ក្រុមគ្រួសារ របស់ លោក អយ ជុច និង លោកស្រី សម្បត្តិ គឺ មាន ស្ថានភាពលំបាក យ៉ាង ខ្លាំង ដោយ បច្ចុប្បន្ន នេះ គាត់ មិន មាន ផ្ទះ សម្រាប់ ស្នាក់ នោះ ទេ គឺ គាត់ ទាំង ពីរ នាក់ រស់ នៅ ផ្ទះ ជាមួយ កូនប្រុស ច្បង ដែល កំពុង មាន ជីវភាព ទីទ័ល ក្រ ។
លោក មេភូមិ បាន បន្ត ថា ក្នុង នាម ជា អាជ្ញាធរ ភូមិ លោក តែងតែ ផ្តល់ នូវ ថវិកា និង អំណោយ បន្តិចបន្តួច ជូន ក្រុមគ្រួសារ របស់ គាត់ សម្រាប់ ដោះស្រាយ ការលំបាក បាន មួយ គ្រា ៗ ។ ក្នុង នាម អាជ្ញាធរ ភូមិ លោក សូម អំពាវនាវ ដល់ សប្បុរសជន នានា មេត្តា ឧបត្ថម្ភ ធនធាន បន្តិចបន្តួច ដល់ ក្រុមគ្រួសារ ពួកគាត់ ផង ដើម្បី ទទួលបាន ថវិកា ខ្លះ សម្រាប់ ព្យាបាល ជំងឺ របស់ គាត់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ដូចនេះ ថា « ការទទួល សំលេង ៧៤ % ហើយ ទទួល អសនៈ ប្រធាន ឃុំ ជាង ៩៩ % ទទួល អសនៈ សមាជិក ក្រុមប្រឹក្សា ចៅសង្កាត់ ជាង ៨០ % វា ជា ការគ្រប់គ្រាន់ ណាស់ ហើយ សម្រាប់ គណបក្ស ប្រជាជន នោះ ហើយ ខ្ញុំ មិន ខ្វល់ ថា មកពី គណបក្ស ណា នោះ ទេ សូម រួមគ្នា ធ្វើ ការ ទៅ ហើយ ប្រឆាំង កូវីដ ទាំងអស់ គ្នា ព្រោះ ប្រសិនបើ អត់ ចូលរួម ប្រឆាំង កូវីដ១៩ ទេ អ្នក ដែល ស្លាប់ គឺ អ្នក ដែល មិន ព្រម អនុវត្តន៍ វិធានការ សុខាភិបាល ខ្លួន ឯង » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បញ្ជាក់ ទៀត ថា បច្ចុប្បន្ន នេះ គណកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត មិន ទាន់ បាន ប្រកាស លទ្ធផល ផ្លូវការ នៅឡើយ ទេ ហើយ នឹង ប្រកាស លទ្ធផល ផ្លូវការ នៅ ថ្ងៃទី ២៦ ខែមិថុនា ខាងមុខ នេះ បន្ទាប់ពី ប្រកាស លទ្ធផល ផ្លូវការ និង ប្រការ ចំនួន អសនៈ ហើយ នឹង ប្រកាស អ្នក ជាប់ ឆ្នោត តែម្តង ស្រប ជាមួយគ្នា នោះ រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ជា អ្នក ចុះហត្ថលេខា ដើម្បីឱ្យ ចូលកាន់ ដំណែង ផងដែរ ។
