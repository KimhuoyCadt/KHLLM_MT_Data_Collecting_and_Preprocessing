- ឈឺចាប់ ខាងស្ដាំ ខាងលើ នៃ ពោះ
វា អាច កើតឡើង បាន ដោយសារ តែ វា នៅ ជិត នឹង មជ្ឈមណ្ឌល នៃ ការសប្បាយ ខាង រាងកាយ ។
ធម្មតា មនុស្ស ទាំង អស់ តែងតែ ចង់ ទៅ កន្លែង ណា ដែល វា ស្រួល ។
រូបភាព ទាំងនោះ ត្រូវ បាន ថត ទាំង ពី ថ្ងៃអាទិត្យ មួយ ថ្ងៃ បន្ទាប់ ពី យន្តហោះ បាត់ តែ ទើបតែ ត្រូវបាន ផ្សព្វផ្សាយ នៅ ថ្ងៃ ពុធ ម្សិលមិញ ។
កុំ ធ្វើ អាក្រក់ ដល់ សាំ ត្រូវតែ ស្គាល់ កម្ម កុំ ខាំ ក្តី ទុក្ខ ។
ទាំងអស់ ទាក់ទង នឹង អចលន ទ្រព្យ ។
ប្រហែល ជា ខ្ញុំ ត្រូវ ទៅ នៅ ជាមួយ កូន បណ្តើរ សិន ។
និង កូន ចៀម ទ្រង់ ព្រះពិរោធ នោះ
ហេតុ នេះ ហើយ ខ្ញុំ ប៉ូល ជា អ្នក ទោស ដោយ ព្រោះ ព្រះគ្រិស្ដ យេស៊ូ សម្រាប់ អ្នក រាល់គ្នា ដែល ជា សាសន៍ ដទៃ
វា មាន នៅ ក្នុង សហរដ្ឋ អាមេរិក ប៉ុន្តែ ក៏ មាន ផង ដែរ នៅ ក្នុង ប្រទេស កាណាដា ។
អ្នក ត្រូវ ចេះ បញ្ចូល គ្នា្ន នៅ ពាក្យ សម្តី របស់ អ្នក ។
ដូច្នេះ ក្នុង លោក យើង នេះ មិន អាច មាន
ខ្លួន ក្នុង ការផ្តល់ សេវា សារ ធា រណៈ ក្នុង វិស័យ សុខាភិបាល ។
តែ បើ សិន នៅតែ មិន ឯកភាព គ្នា រួម ទេ ចៅក្រម នឹង ដាក់ សំណុំរឿង ដើម្បី ជំនុំជម្រះ តែម្ដង ។
វត្តមាន កំពូល តារាចម្រៀង តារា សម្តែង ល្បី ៗ
ពេល ព្រះជា អម្ចាស់ មាន ព្រះបន្ទូល
ការដាក់ពាក្យ : លើក ។
ហើយ អ្នក វង្វេង ផ្លូវ
ព្រះអង្គ បន្ត ថា រាល់ ពាក្យ បណ្ដឹង ត្រូវ មាន ភាព ស្អាតស្អំ ហើយ អ្នក ដែល ប្ដឹង ត្រូវ សុំ ថត រូប មួយ ប៉ុស្តិ៍ ទុក ផង ។
លទ្ធផល ស្វែងរក ពាក្យ គន្លឹះ ( អ្នកកាសែត )
មនុស្ស ស្លាប់ នឹង រស់ ឡើង វិញ ការ ដាក់ ទោស មនុស្ស ដែល ប្រព្រឹត្ត អំពើ ទុច្ចរិត
ពួកគេ បាន រត់ ទៅ កាន់ ទីកន្លែង ទួល ខ្ពស់ ៗ
បាយ ក្រៅ ផ្ទះ ពេល ថ្ងៃ អាច ឲ្យ បុរស ក្បត់ ប្រពន្ធ
ក្រសួង អ៊ិនធឺណេត - ព្រះដ៏ អស្ចារ្យ
ក្នុង រយៈពេល ៧ ថ្ងៃ ខាង មុខ អ្នក នឹង អាច ប្រើ វិធី ខ្លួន ឯង ដើម្បី ចំណេញ ប្រាក់ ។
សម្រាប់ ការពារ ក្នុង រឿង ក្តី នេះ ៕
១២ មនុស្ស ចាប់ ផ្តើម ក្រអឺត ក្រទម នៅ ពេល គេ ឃ្លាត ចេញ ឆ្ងាយ ពី ព្រះ អម្ចាស់ ហើយ ប្រឆាំង នឹង ព្រះ អង្គ ដែល បាន បងើ្កត ខ្លួន ។
ជាមួយ តារាង ពង្រីក ១២០០ ម ។
កសាង ជាតិ ថែរក្សា ជាតិ គង់ វង់ តទៅ ។
ជាច្រើន ហើយ ចង់ ដឹង ណាស់ ថា តើ នរណា
និង ជា ញឹក ញាប់ នៅ ពេល ដែល យើង ខ្ញុំ ធ្វើ ទំនាក់ ទំនង ជាមួយ នឹង ប្រជារាស្ដ្រ ។
ខ្ញុំ បាន មក ចូល រួម បាតុកម្ម ដើម្បី ស្វែង រក យុត្តិធម៌ ។
ជន ប្រុស ស្រី ណា ប្រព្រឹត្ត បាន ធ្វើ ខ្លួន ទៅ តាម សេចក្តី ល្អ ទាំង ដប់ ប្រការ នេះ លោក ហៅ ថា ជា មនុស្ស គំរូ ដល់ អ្នកផង ទាំងពួង ។
វា ជា រឿង គួរ ឲ្យ ខ្មាស់ ប្រសិនបើ អ្នក មាន ក្លិន ខ្យល់ ដង្ហើម មិន ល្អ ។
ដោយ ចាត់ ទុក ថា នេះ ជា មោទនភាព មួយ សម្រាប់ ពួកគាត់ និង ក្រុមគ្រួសារ ផងដែរ ។
គ្នា នេះ គេ អាច ទាយ ដឹង ពី អត្តចរិត របស់ ម្ចាស់ បាន ដូចត ទៅ៖
ព្រះយេស៊ូវ គង់ នៅ ផ្ទះ នាង ម៉ាថា និង នាង ម៉ារា
ស្រាប់តែ គាត់ ឆ្លើយ ថា ប៉ា ៗ
ចំនួន សិស្ស ភាគ ច្រើន មក ពី ប្រទេស ចិន ។
ចាប់តាំងពី ការដុត សម្លាប់ ខ្លួន ឯង ដំបូង បំផុត កាល ពី ឆ្នាំ ២០០៩ ប្រជាពលរដ្ឋ ទី បេ ជាង ៤០ នាក់ បាន ធ្វើ អត្តឃាត នៅក្នុង ប្រទេស ចិន ។
តែ មិន មែន ដោយសារ កម្លាំង របស់ ខ្លួន ផ្ទាល់ ទេ ។
ដោយ លោក បាន លើកឡើង ថា " ខ្ញុំ នឹង ស៊ើបអង្កេត ករណី នេះ ហើយ នឹង បញ្ជូន អ្នក ទាំងនោះ ទៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ ដើម្បី ចាត់ការ តាម ច្បាប់ " ។
និង រហូត មកដល់ ក្មួយ ៗ
គាត់ ត្រូវតែ ទទួលខុសត្រូវ ចំពោះ អ្វី ដែល កើត មាន ឡើង
ខ្ញុំ មាន អារម្មណ៍ ថា គាត់ ស្រឡាញ់ ខ្ញុំ ជាង មុន ទៅ ទៀត ។
ទូលបង្គំ ស្អប់ ខ្ពើម អស់ អ្នក ដែល ឃុបឃិត ប្រឆាំង
តាម សាក្សី ទាំងឡាយ ថា ពេល អគារ នោះ បាក់ លាន់ ស្នូរ ដូច ការ រញ្ជួយ ដី ។
សូម លោក លោកស្រី បន្ត ចូលរួម ថែរក្សា អនាម័យ ក្នុង ទី សារ ធា ណៈ ទាំងអស់ គ្នា ៕
នេះ គួរ ប្រាប់ ដល់ គាត់ ជា ជាង ការរក្សាទុក ជា ភស្តុតាង ដើម្បី ប្រឆាំង នឹង គាត់ វិញ ។
៥៨ នៅ ទី នោះ ព្រះយេស៊ូ ពុំ បាន ធ្វើ ការ អស្ចារ្យ ច្រើន ឡើយ ព្រោះ គេ គ្មាន ជំនឿ ។
ចំណែក លោក ហេង បុរី ថា វិហារ បូរាណ នឹង មាន គំនូរ ល្អ វិចិត្រ ដូច គ្នា ។
សមិទ្ធផល ទាំង នេះ ធ្វើ ឲ្យ សាមី ខ្លួន មាន មោទកភាព ណាស់ ចំពោះ អ្វី ដែល នាង សម្រេច បាន ។
ហ្នឹង ដូច មិន អាច ដល់ ថ្នាក់ បញ្ជូន គាត់ ទៅ វិញ ទេ ព្រោះ ធម្មតា ប្រជាពលរដ្ឋ គាត់ មាន សិទ្ធិ រស់ នៅ ត្រង់ណា ក៏ បាន ដែរ ។
ពិត ណាស់ អ្នក អាច ផ្តល់ អោយ នាង នូវ ការអធិប្បាយ ពី របៀប ដែល នាង ធ្វើអោយ អ្នក មាន អារម្មណ៍ ល្អ ចំពោះ នាង ។
ក្នុង ពេល ដែល ខ្ញុំ ជួប វិប្រតិបត្តិ គ្រួសារ ខ្ញុំ អស់ រលីង ពី ខ្លួន សល់ តែ កូន ពីរ នាក់ ។
វាយ មេ ក្រុម ហ្នឹង ឲ្យ បាន បើ អ្នកឯង ហ៊ាន ធ្វើ ពិតប្រាកដ ។
មិន ចាំបាច់ វះកាត់ ទទួលទាន អាហារ ទាំង នេះ ក៏ សុដន់ ធំ ដែរ
នេះ ជា អ្វី ដែល យើង បាន ដឹង រហូតមកដល់ ពេលនេះ និង គន្លឹះ មួយចំនួន ដើម្បី រក្សា គំនិត របស់ អ្នក ឱ្យ ច្បាស់ ។
លោកស្រី បាន បន្ថែម ថា ការស្លាប់ របស់ កូនប្រុស លោកស្រី បាន បង្ហាញ ថា រូប គេ គឺជា សុភាពបុរស ចិត្ត ល្អ មួយ រូប ដែល ព្យាយាម សង្គ្រោះ ចំណាប់ខ្មាំង ម្នាក់ ទៀត ។
ហេតុ អ្វី បាន ជា ព្រះអង្គ បោះ បង់ ចោល យើង ខ្ញុំ
ព្រះអង្គ នឹង ធ្វើ អោយ ដី ហួត ហែង នេះ
ទៀតផង គឺ តាំងពី ក្បាល រហូតដល់ ចុង ជើង ។
នាង បង្ហាញ ឲ្យ អ្នក ដឹង ថា នាង ស្រឡាញ់ និង ត្រូវការ អ្នក គ្រប់ ពេល វេលា ។
ម្យ៉ាង ទៀត មុខ វិជ្ជា រៀន សិស្ស អាច ជ្រើសរើស ដោយ ខ្លួន ឯង បាន ។
ឲ្យ ពួកយើង ចេះ វិជ្ជា មិត្ត ល្អ ។
ខណៈ ដែល ឪពុក ម្តាយ របស់ ពួកគេ ជាប់រវល់ ទៅ បំពេញ ការងារ ។
ហើយ មាន សេចក្តី ក្រោធ ចំពោះ មរដក ទ្រង់
