ខាងក្រោម នេះ អាច ឱ្យ អ្នក ដឹង បាន ៖
ត្រូវ ធ្វើ មាន ច្រើន ទៀត ផ្ទៃក្នុង ដាច់ខាត ត្រូវតែ សាមគ្គី គ្នា
ភាគ ច្រើន លើសលប់ បាន ពេញចិត្ត និង គាំទ្រ ចំពោះ ការប្រកួត
ទៀត មិន ថា តែ រី រុស កូវីដ១៩ នោះ ទេ ដូច្នេះ ត្រូវការពារ ខ្លួន ឱ្យ បាន ជាប់ ជានិច្ច ៕
ជនជាតិ អ៊ីស្រាអែល ពុំ បាន សម្លាប់ ពួកគេ ទេ ។
កម្មករ ដែល ត្រូវបាន សមត្ថកិច្ច បង្ក្រាប ដោយ ហិង្សា កន្លងមក ។
យ៉ាងណាមិញ បច្ចុប្បន្ន នេះ រូប គេ កំពុង ស្វែងរក ក្លឹប ដើម្បី លេង បន្ត ទៀត ។
ដូច្នេះ នៅ ពេល ដែល អ្នក កំពុង សរសេរ អ្វី ៗ
បាន ឆ្តោមក ស្ល ចាំ រង់ អស់ គ្នា ច្រូត ស្បូវ ។
ប្រាកដ ណាស់ ប្រមុខរបប យោធា លោក ប្រាយុទ្ធ ចាន់ អូចា នឹង នៅតែ ជា អ្នកកាន់ តំណែង នោះ គ្រាន់តែ រដ្ឋាភិបាល ថ្មី ជា រដ្ឋាភិបាល ស៊ីវិល ៕
ជា ការពិត ណាស់ តារា ស្រី ខាលើ រូប នេះ មិន ត្រឹមតែ មាន ទេពកោសល្យ សិល្បៈ អាច ច្រៀង រាំ សម្តែង បាន នោះ ទេ ក្រៅពី នេះ អ្នកនាង ក៏ មាន រូប សម្បត្តិ ស្អាត ស្រាប់
ទស្សន របស់ ពួក ។
ប្រឹងប្រែង រៀនសូត្រ ដើម្បី ចេញ ទៅ បន្ត ការសិក្សា នៅ បរទេស ទោះបីជា នៅ ប្រទេស ណាក្តី ៕
លោក ថ្លែង ថា គេ គួរតែ សម្រេច ហៅ ថា កែទម្រង់ ហ្នឹង ឱ្យ ចប់ នៅ ថ្ងៃ ណា ដើម្បី ទុក ពេលវេលា រៀបចំ ជាក់ស្តែង ។
ខ្ញុំ ដែល បាន បង្ហាញ នៅក្នុង លទ្ធផល នៃ ការសិក្សា ស្រាវជ្រាវ
តើ កត្តា អ្វី ខ្លះ ដែល អ្នកស្រី សម្រេចចិត្ត បែប នេះ ?
ទៀត ដើម្បី ជួយ រក្សា ភាព ស្រងូតស្រងាត់ នេះ ។
ជា ឧទាហរណ៍ នៅ ប្រទេស សិង្ហបុរី ទិដ្ឋាការ យូរ បំផុត ដែល ពលករ ប្រាក់ខែ ទាប អាច ទទួលបាន គឺ ២ឆ្នាំ ។
អ្នក ទាំង ៤នេះ នឹង ធ្វើជា គណៈកម្មការ ក៏ ដូចជា គ្រូបង្វឹក ប្រចាំ កម្មវិធី នេះ ផងដែរ ក្នុង រដូវកាល ទី១ នេះ ។
ចូរ មាន អំណរ ចូរ ឱ្យ បាន គ្រប់ លក្ខណ៍ ចូរ ទទួល ការលើកទឹកចិត្ត ចូរ មាន គំនិត តែ មួយ ចូរ រស់នៅ ដោយ សុខសាន្ត ចុះ នោះ ព្រះជាម្ចាស់ នៃ សេចក្តីស្រឡាញ់ និង សេចក្តីសុខសាន្ត នឹង គង់ នៅ ជាមួយ អ្នក រាល់គ្នា
ខ្ញុំ គិត ថា អ្វី ដែល កំពុង កើតឡើង នៅ កម្ពុជា នឹង មិន អាច កើតឡើង នៅ កន្លែង ផ្សេង ឡើយ ។
ក្រុមហ៊ុន បាន បង្ហើប ថា ទូរស័ព្ទ ចេញ ថ្មី នេះ នឹង អាច រក ទិញ ប្រើប្រាស់ បាន នៅលើ ទីផ្សារ ផ្សេង ៗ
ព្រាប សុវត្ថិ - កេសរ
ចិន ប្រកែក ថា មិន បាន ឃុំឃាំង ជនជាតិ អ៊ុយហ្គួ១លាន នាក់
រ៉ន ចាន់ ឌីន ក្រមុំ ហើយ តែង ខ្លួន លេចធ្លោ មើល សឹង មិន ស្គាល់
នេះ រួច មកហើយ ដោយ អាជ្ញាធរ ពុំ បាន ដោះស្រាយ សំណង ជូន ពួកគាត់ នៅឡើយ ។
តក្កវិទ្យា - អ្នកបកប្រែ កំរិត អក
ខ្ញុំ ចាប់ផ្តើម មេ ចុងភៅ កំពូល
ចូលចិត្ត ការសប្យាយ ដូចគ្នា ប៉ុន្តែ ការសប្បាយ របស់ ក៏ ត្រូវតែ គិត …
ទៀត ថា នាង ប្រាក់ សុគន្ធ អាចនឹង ត្រូវ លើក ពាន នៅ រដូវកាល នេះ ផងដែរ ។
ដូច ក្ងោក ពិត ស្អាត ៗ
មាន តែ រង់ចាំ មើល ទាំងអស់ គ្នា ។
ខ្ញុំ អាណិត គាត់ ខ្លាំង ណាស់ ។
ប្រជាពលរដ្ឋ ងឿងឆ្ងល់ ពេល ឃើញ គេ ដើរ សុំ ស្នាម …
តើ ពាក្យ អាព្យាក្រឹត្យ មាន ន័យ លុះត្រាតែ ដាក់ ពួកគាត់ មកកាន់ការណ៍ នោះ ឬ យ៉ាងណា ?
គាត់ ស្តាយ ក្រោយពេល គាត់ ជិត ស្លាប់ ៕
ភាព ស្រុះស្រួល គ្នា នឹង ធ្វើឱ្យ អ្នក ទាំង ពីរ ទទួលបាន អារម្មណ៍ ផ្លូវភេទ កាន់តែ មាន សេចក្តីសុខ ។
ការសង សំណង បែប នេះ មិន គ្រប់គ្រាន់ ទេ ។
កាសែត ដដែល ក៏ បាន រកឃើញ ថា មន្ត្រី សុខាភិបាល កំពូល ជាង ៥០០ នាក់ បាន ចាកចេញ ពី ការងារ ក្នុង រយៈពេល ១៩ ខែ ចុងក្រោយ នេះ ។
និង ពលរដ្ឋធម្មតា ចំពោះ អត្ថាធិប្បាយ របស់ ពួកគេ ដែល ត្រូវបាន ចាត់ទុក ថា មាន លក្ខណៈ នយោបាយ ។
ករណី កសិផល នៅ ស្រុក យើង ធ្លាក់ ថ្លៃ កើតឡើង យូរ ឆ្នាំ មកហើយ និង ស្ទើរតែ រាល់ ពេល ប្រមូល ផល ។
ក្រោយពី ទទួលបាន បទពិសោធន៍ លោក យល់ ថា ការចិញ្ចឹម កង្កែប ឆាប់ ទទួលបាន ផល ដោយ ប្រើ ពេល តែ ៤៥ ថ្ងៃ ប៉ុណ្ណោះ នឹង ទទួលបាន ផល ។
កញ្ញា ថន តារា ក៏ ជា ពិធីការិនី ម្នាក់ ដែរ ប៉ុន្តែ នាង ហាក់ មិន សូវ ចាប់ អាជីព ពេញលេញ ដូច ប្អូន ស្រី របស់ នាង ទេ ។
ក្នុង នោះ លោក ក៏ បាន បង្ហាញ ពី បំណងប្រាថ្នច ងា់ត្រឡប់មក ជំនាញ ចាស់ របស់ ខ្លួន ផងដែរ ប៉ុន្តែ មិន មែន ប្រដាល់ នៅលើ សង្វៀន ទេ គឺ ចង់ បើក ក្លិប ប្រដាល់ ប្រសិនបើ ខ្លួន មាន លទ្ធភាព ។
តើ នឹង មាន អ្វី កើតឡើង ចំពោះ ស្តេច ឆ្នាំ រោង និង ម្សាញ់ ឆាប់ ៗ
កុំ ឱ្យ ទន់ខ្សោយ នៅ អំឡុង ពេល ពពោះ ។
បើក ចេញ តែ កោះសន្តិភាព ដដែល ហ្នឹង !
ហេង នាង រូបភាព ឯកសារ
នៅ ចំពោះ ភ្នែក ទូលបង្គំ ឡើយ
គ្រាន់តែ មាន ន័យ ថា ជា មូលដ្ឋាន ខ្ញុំ ពេញចិត្ត ពេញ ថ្លើម ចំពោះ ខ្លួន ឯង ជានិច្ច ។
បុរស ម្នាក់ នេះ ប្រឆាំង នឹង ប្រទេស អ៊ីរ៉ង់ ដល់ ឆ្អឹង ដូច្នេះ លោក គ្មាន សិទ្ធី ដើម្បី គាំទ្រ ពលរដ្ឋ អ៊ីរ៉ង់ នោះ ទេ ៕
អត់ ទាន់ បាន ពិនិត្យមើល ឥវ៉ាន់ ក្នុង ផ្ទះ ផង ទេ
ទៀត ដែល ឃាតករ បាញ់ សម្លាប់ ។
ប្រាប់ មក ចុះ ច្រៀង ដោយ ៖
ស្តាប់ មួយ ភ្លែត ពិតជា ពីរោះ ពិតជា ត្រឹមត្រូវ ណាស់ ។
៨ - ប្តី មិន ញ៉ាំង ទ្រព្យសម្បត្តិ គ្រប់ យ៉ាង ឱ្យ កើតមាន
អ្នក ប្រកបរបរ រកស៊ី ជួញដូរ វិញ មាន ការទិញ ចូល លក់ ចេញ គ្រាន់ កម្រើក ជាង មុន បន្តិច វិញ ឯ បើ លោកអ្នក ចង់ រើ ទីកន្លែង លក់ដូរ ក៏ ជា ឱកាស ល្អ ប្រពៃ ។
គួរ បញ្ជាក់ ថា លោក តារងគ្រោះ ជា មនុស្ស មាន ជម្ងឺ លើស ឈាម ប្រចាំ កាយ ៕
តង់ រថយន្ត ដំបូល សម្រាប់ មនុស្ស ២នាក់
នៅក្នុង ជំនួប ទាំងនោះ លោក ស៊ូបែឌី អះអាង ថា លោក បាន ទទួល ព័ត៌មាន សំខាន់ ៗ
មែន ហើយ យើង ត្រូវការ ទិញ ដូចគ្នា ។
លោក អ្នក ចាំបាច់ ត្រូវ ទទួលទាន អាហារ ដូច ខាងក្រោម នេះ ៖
