ប៉ុន្តែ ទោះ យ៉ាង ណា ក្តី ទិន្នន័យ ដែល មាន ស្រាប់ សម្រាប់ ការ បកប្រែ ភាសា អង់គ្លេស និង ខ្មែរ មិន ទាន់ មាន ច្រើន ដូច ទិន្នន័យ សម្រាប់ ការ បកប្រែ រវាង ភាសា អង់គ្លេស និង បារាំង ទេ ។
លោក បន្ថែម ថា សុក្រឹតភាព នៃ ការ បកប្រែ នេះ នឹង កាន់ តែ មាន ភាព ច្បាស់លាស់ ទៅ តាម ពេលវេលា អភិវឌ្ឍន៍ គម្រោង ការ ។
ក្រុម អ្នក ជំនាញ បាន ថ្លែង ថា កម្មវិធី នេះ នឹង រួម ចំណែក ដល់ ការ យល់ ដឹង ទូលំទូលាយ ជាង មុន សម្រាប់ ទាំង ក្នុង និង ក្រៅ ប្រទេស កម្ពុជា ។
កម្មករដែល តវ៉ាពីរថ្ងៃមកហើយព្រមចូលធ្វើការ វិញនៅថ្ងៃនេះ
លោក រី សិទ្ធីណែត មន្ត្រី ដោះ ស្រាយ វិវាទ ការងារ នៃ សហជីព សេរី កម្មករ ដែល បាន ចរចា ជា មួយ ក្រុម មន្ត្រី ក្រុមហ៊ុន រយៈ ពេល ប្រហែល ៥ ម៉ោង បាន ឲ្យ ដឹង កាល ពី ម្សិលមិញ ថា បន្ទាប់ ពី ពិភាក្សា គ្នា ការ ទាម ទារ របស់ កម្មករ ត្រូវ បាន គេ ទទួល យក ។
លោក ស្រី ណា រ៉េន មន្រ្តី សម្រប សម្រួល របស់ អង្គការ សិទ្ធិ មនុស្ស អាដហុក ប្រចាំ ខេត្ត ឧត្តរ មាន ជ័យ បាន ថ្លែង ថា របាយការណ៍ បឋម បាន កំណត់ អត្ត សញ្ញាណ ថា បង ប្អូន ប្រុស ទាំង ពីរ នាក់ នេះ មាន ឈ្មោះ ឈីវ ឈាង អាយុ ៤០ ឆ្នាំ និង ឈីវ ទូច អាយុ ២៥ ឆ្នាំ ។
ដោយ ថ្លែង សុំ មិន បញ្ចេញ ឈ្មោះ អតីត មន្រ្តី យោធា ម្នាក់ ក្នុង ខេត្ត ឧត្តរ មានជ័យ បាន អះអាង ថា បង ប្អូន ប្រុស ទាំង ពីរ នាក់ នោះ ត្រូវ បាន បាញ់ ស្លាប់ ហើយ ។
លោក វណ្ណា បាន បន្ថែម ថា៖
លោក ម៉ែន ផល មន្ត្រី បម្រើ ការងារ នៅ មជ្ឈ មណ្ឌល ឱកាស ខ្ញុំ ប្រាប់ ភ្នំ ពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ អង្គារ ថា តាម របាយការណ៍ មជ្ឈមណ្ឌល ចំនួន ជន រងគ្រោះ ដោយ សារ គ្រឿង ញៀន ដែល មក ទទួល សេវា ព្យាបាល នៅ មណ្ឌល ឱកាស ខ្ញុំ ក្នុង ឆ្នាំ ២០១២ នេះ មាន ចំនួន ១១៣៨ នាក់ ក្នុង នោះ ស្រី ១៣៩ នាក់ គឺ កើន ជាង កាល ពី ឆ្នាំ ២០១១ ដែល មាន ត្រឹម តែ ១០៥៨ នាក់ ។
កំពង់ស្ពឺៈ កាល ពី បួន ឆ្នាំ មុន ក្រុម គ្រួសារ អ្នក ភូមិ អន្លង់ ជ្រៃ ស្រុក ថ្ពង បាន ឃើញ ទំនប់ វារី អគ្គិសនី តូច មួយ ដែល គេ កំពុង បង្កើត ឡើង នៅ ម្ដុំ ក្រោយ ផ្ទះ របស់ ពួក គាត់ ។
ប្រជា ពលរដ្ឋ ១២០០ គ្រួសារ នៅ ភូមិ អន្លង់ ជ្រៃ និង ជុំវិញ តំបន់ ក្បែរ នោះ ក៏ នឹង បាន ទទួល អគ្គិសនី ពី ទំនប់ នេះ ដែល គេ នឹង ប្រគល់ ឲ្យ រដ្ឋាភិបាល នៅ សប្ដាហ៍ នេះ ដើម្បី បើក សម្ពោធ ឲ្យ ដំណើរ ការ ជាមួយ មជ្ឈ មណ្ឌល សហគមន៍ ដែល គេ បង្កើត ឡើង ថ្មី មួយ កន្លែង ផង ដែរ ។
នោះ ជា ក្ដី សង្ឃឹម របស់ អ្នក ស្រី រ័ត្ន ចន្ធូ អាយុ ៣៥ ឆ្នាំ ម្ចាស់ ភោជនីយដ្ឋាន តូច មួយ ដែល នៅពេល យប់ មាន មនុស្ស ច្រើន ចូល ទៅ ផឹក កាហ្វេ ។
អ្នក ស្រី បន្ថែម ថា៖
ចំពោះ អគ្គិសនី លោក ពិសិដ្ឋ បាន ថ្លែង ថា ភ្លើង នោះ នឹង ត្រូវ តភ្ជាប់ ឲ្យ អ្នក ភូមិ ប្រើ ប្រាស់ ដោយ មិន បង់ ប្រាក់ រយៈ ពេល មួយ ខែ ។
អៀង សារី ដល់ដំណាក់កាលចុងក្រោយខណៈបុគ្គលិក ជាតិអត់ប្រាក់ខែបន្ត ព ហិការ
ខ្ញុំ ពុំ មាន សង្ឃឹម ទេ ។
លោក សេង រ៉ន ថ្លែង ថា លោក បាន ដំណឹង ពី សមាជិក គ្រួសារ ថា ឪពុក ក្មេក លោក ស្ថិត ក្នុង ស្ថានភាព ធ្ងន់ ប៉ុន្តែ លោក ពុំ មាន ព័ត៌មាន បន្ថែម ទៀត ឡើយ ។
លោក នេត្រ ភក្រ្តា មន្រ្តី នាំ ពាក្យ សាលា ក្តី បាន ថ្លែង ថា បន្ទាប់ ពី ការ ពិនិត្យ សុខ ភាព នៅ ថ្ងៃ ទី២៥ ខែ មីនា អង្គ ជំនុំ ជម្រះ នឹង បើក សវនាការ លើ សម្បទា លោក ។
ប្រតិចារឹក ដែល ប្រាប់ ឈ្មោះ ថា តារា ថ្លែង ថា ពី ថ្ងៃ អង្គារ មន្រ្តី ២ នាក់ នៅ អង្គ ភាព គ្រប់គ្រង តុលាការ ត្រូវ កោះ ទៅ ព្រមាន ថា ពួក គេ អាច នឹង បាត់ បង់ ការ ងារ ដោយ សារ តែ បញ្ចេញ ព័ត៌មាន ពី ការ ធ្វើ កូដកម្ម ទៅ ឲ្យ ប្រព័ន្ធ ផ្សព្វផ្សាយ ។
លោក តារា ជា មនុស្ស ដែល បន្ត ធ្វើ ពហិការ រហូត ទាល់ តែ ការ ទាមទារ នេះ ត្រូវ គេ ធ្វើ ការ ដោះ ស្រាយ និយាយ ថា៖
ហើយ បន្ទាប់ ពី ខ្ញុំ ធ្វើ ការ អត្ថាធិប្បាយ នោះ គេ ចោទ ថា ខ្ញុំ រំលោភ លើ លក្ខខណ្ឌ ការងារ ។
អង្គជំនុំ ជម្រះតុលាការកំពូលសាលា ក្តី ទាមទារឯកសារសំណុំរឿង០០២
លោក សម រង្ស៊ី ដែល ដឹក នាំ គណបក្ស សង្គ្រោះ ជាតិ កម្ពុជា ដែល គេ ទើប តែ បង្កើត នៅ ពេល ថ្មី ៗ នេះ បាន មាន ប្រសាសន៍ ថា លោក នៅ តែ មាន សង្ឃឹម ជុំវិញ ការ ឈរ ឈ្មោះ បោះឆ្នោត សម្រាប់ ខែ កក្កដា ហើយ បាន សម្តែង ទំនុក ចិត្ត ថា គណបក្ស របស់ លោក អាច បញ្ចប់ ការ ក្តោបក្តាប់ អំណាច ២៨ ឆ្នាំ របស់ លោក ហ៊ុន សែន ។
លោក សម រង្ស៊ី ដែល បាន រៀន សូត្រ នៅ ប្រទេស បារាំង ជា ឥស្សរជន រិះគន់ ឥត សំចៃ បំផុត ម្នាក់ ក្នុង ចំណោម ឥស្សរជន ជាច្រើន ក្នុង នយោបាយ កម្ពុជា ប៉ុន្តែ បាន រស់ នៅ និរទេស នៅ ស្រុក បារាំង ចាប់ តាំង ពី ឆ្នាំ ២០០៩ ហើយ បាន ប្រឈម មុខ ជាប់ ពន្ធនាគារ សរុប ១១ ឆ្នាំ ប្រសិន បើ លោក ត្រឡប់ មក វិញ ។
ការ ផ្តន្ទាទោស ផ្សេង ទៀត រួម មាន ការ ចោទ ប្រកាន់ រដ្ឋ មន្ត្រី ក្រសួង ការ បរទេស ថា ជា សមាជិក នៃ របប ខ្មែរ ក្រហម ឃោរឃៅ កាលពី ចុង ទសវត្សរ៍ ឆ្នាំ ១៩៧០ ។
ប៉ុន្តែ លោក ទេព នី ថា បាន បញ្ជាក់ ថា៖
រឿង ក្តី នេះ លោក ហោ ណាំ ហុង បាន ឈ្នះ ក្តី នៅ តុលាការ សាលា ដំបូង បារាំង ប៉ុន្តែ ក្រោយ មក តុលាការ កំពូល របស់ បារាំង បាន ច្រានចោល សាលក្រម នោះ វិញ ដោយ សម្រេច ឲ្យ លោក សម រង្ស៊ី ឈ្នះ ក្តី វិញ ។
សហគមន៍ អន្តរជាតិ ជា ច្រើន បាន ធ្វើ អន្តរាគមន៍ រក ផ្លូវ ឲ្យ លោក សម រង្ស៊ី បាន ចូល ស្រុក វិញ ប៉ុន្តែ មិន ទាន់ មាន លទ្ធផល ទេ ៕
អ្នកបុរីកីឡាចូលទៅ សង់រោងលើអតីតដីផ្ទះរបស់ខ្លួនវិញ
លោក សៀ ភារម្យ ប្រធាន លេខាធិការដ្ឋាន នៃ ក្រុម បេសកកម្ម ពិសេស សិទ្ធិ លំនៅ ដ្ឋាន បាន ថ្លែង ថា ជា ទូទៅ នៅ ពេល ប្រជា ពលរដ្ឋ ចូល ទៅ សាង សង់ លំនៅដ្ឋាន បណ្ដោះ អាសន្ន លើ អតីត ដី របស់ ខ្លួន វិញ ដើម្បី រង់ចាំ ដំណោះស្រាយ ពួក គេ តែង ទទួល រង ការ គំរាម កំហែង ចាប់ ចង និង ដាក់ ពន្ធនាគារ ។
មន្រ្តី រដ្ឋបាល រោងចក្រ ដែល សុំ មិន បញ្ចេញ ឈ្មោះ បាន និយាយ កាលពី ថ្ងៃ ម្សិលមិញ ថា ថៅកែ បាន ព្រម ដំឡើង ប្រាក់ ឈ្នួល អប្បបរមា ដល់ កម្មករ ដល់ ទៅ ៧១ ដុល្លារ ក្នុង មួយ ខែ ប៉ុន្តែ កម្មករ មិន ទទួល យក ហើយ និយាយ ថា ពួក គេ នឹង ធ្វើ កូដកម្ម ម្តង ទៀត នៅ ថ្ងៃ នេះ ។
លោក ប៊ឿយ យ៉ា ប្រធាន មន្ទីរ ដែនដី ត្រូវ បាន ផ្លាស់ ចេញ កាល ពី ថ្ងៃសុក្រ ទី ៨ មីនា ក្រោយ ពេល លោក បាន ប្រារព្ធ ធ្វើ ពិធី សិទ្ធិ នារី រួច នៅ មន្ទីរ របស់ លោក ហើយ អនុ ប្រធាន ឈ្មោះ គឹម ពិ សិទ្ធ ធ្វើ ជា ប្រធាន ស្តី ទី ជំនួស សិន ។
ស្ថិតិអំពី ការ បង្ក្រាបគ្រឿងញៀននៅតែពុំបានបង្ហាញរូបភាពទាំងមូល
លោក ឡុង បញ្ញា វុធ មន្រ្តី កម្មវិធី នៃ អង្គ ការ គំនិត ផ្តួច ផ្តើម យុតិ្តធម៌ កម្ពុជា បាន ថ្លែង ថា៖
លោក ចៅក្រម សំ ប៊ុន ពៅ អ្នក កាន់ សំណុំ រឿង ជនសង្ស័យ ទាំង ៧នាក់ បាន ប្រាប់ ម្សិលមិញ ថា ចំពោះ ករណី នេះ លោក បាន ចាត់ ការ ទៅ តាម នីតិវិធី ហើយ ។
លោក សំរិទ្ធ សុខុន ព្រះរាជអាជ្ញា រង ខេត្ត បាន ឲ្យ ដឹង ដែរ ថា តុលាការ បាន សម្រេច ចេញ ដីកា ឃុំ ខ្លួន បណ្តោះ អាសន្ន ដល់ ជន ទាំង ៧នាក់ កាលពី ថ្ងៃទី ១០ មីនា នៅ ពន្ធនាគារ ខេត្ត ដើម្បី ស៊ើប អង្កេត បន្ត ។
លោក ណុល រ៉ុង នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ ខេត្ត បាន រំឭក ឲ្យ ដឹង ថា ជន សង្ស័យ ពាក់ព័ន្ធ នឹង ការ សម្លាប់ បង ប្អូន ប្រុស ស្រី ២នាក់ នៅ ចម្ការ ឈូក ព្រៃ រ នាម មាត់ បឹង ទន្លេ សាប ក្នុង ឃុំ អន្លង់ សំណ ស្រុក ជីក្រែង ខេត្ដ សៀមរាប ត្រូវ ចាប់ បាន ជា បន្ដ បន្ទាប់ កាលពី សប្តាហ៍ មុន នៅ ក្នុង ស្រុក ភូមិ របស់ ពួក គេ ហើយ ត្រូវ តុលាការ បាន បញ្ជូន ទៅ ពន្ធនាគារ ហើយ ។
ប៉ុស្តិ៍ត្រួតពិនិត្យចរាចរណ៍ចល័តនៅ តែមិនអាចពង្រឹងច្បាប់ឲ្យមានប្រសិទ្ធភាព
នគរបាល ដែល បំពាក់ ដោយ ឧបករណ៍ ពិនិត្យ ជាតិ ស្រវឹង និង នគរបាល ចរាចរ ២៣ នាក់ បាន ដាក់ បារ៉ាស់ លើ ផ្លូវ និង តុ តូច មួយ សម្រាប់ សរសេរ វិក្កយបត្រ ផាក ពិន័យ ប៉ុស្តិ៍ ចល័ត នេះ ត្រៀម អ្វី ៗ ជាច្រើន ក្នុង ការងារ ហើយ ពុំ មាន ខ្វះខាត អ្វី ឡើយ ។
ទោះជា យ៉ាង ណា ដោយ គ្មាន ការ ព្រមាន ទុក ជា មុន ការ បើកបរ មាន សភាព ធ្វេស ប្រហែស យ៉ាង ច្រើន ។
នៅ យប់ នោះ អាច កើត មាន គ្រោះថ្នាក់ ប្រសិន បើ មន្ត្រី ម្នាក់ នោះ មិន ទាញ បារ៉ាស់ មក វិញ ឲ្យ ទាន់ ទេ ។
គាត់ ទុក ឲ្យ ម៉ូតូ នោះ បើក ផុត ប៉ុន្តែ គាត់ បាន បញ្ចៀស ផុត នូវ អ្វី ដែល អាច ជា គ្រោះថ្នាក់ ក្នុង សោកនាដកម្ម ។
អ្នក ជំនាញ ថ្លែង ថា ប៉ុន្តែ កម្លាំង ទាំង នេះ មិន មែន ព្រលឹង វិញ្ញាណ ឬ ក៏ វត្ថុ ក្រៅ លោក ឡើយ ប៉ុន្តែ សុទ្ធ ជា កត្តា មនុស្ស ទាំងអស់ ។
ការ ដោះស្រាយ បញ្ហា មួយ បង្ហាញ នូវ បញ្ហា មួយ ទៀត ហើយ វា កើត ឡើង ជា បន្តបន្ទាប់ ដូច ការ បើក ប្រអប់ មួយ ហើយ ឃើញ ប្រអប់ ជា បន្ត បន្ទាប់ គ្នា អ៊ីចឹង ដែរ ។
ប៉ុន្តែ ការ បើកបរ ពេល ស្រវឹង កើតឡើង នៅ ពេល យប់ ជា ពេល មនុស្ស តិចតួច ពាក់ មួក សុវត្ថិភាព ។
ប៉ុន្តែ ការ ចាប់ ពួក គេ ជា ការ ពិបាក ព្រោះ មាន នគរបាល តិចតួច ធ្វើ ការ ដាក់ ពិន័យ អ្នក បើកបរ ពេល យប់ ។
គឺ ព្រោះ តែ គ្មាន ប្រាក់ បន្ថែម ម៉ោង ឲ្យ នគរបាល ។
លោកស្រី អៀ ចរិយា អ្នក គ្រប់គ្រង កម្មវិធី សុវត្ថិភាព ផ្លូវ ថ្នល់ នៅ អង្គការ ជន ពិការ អន្តរជាតិ បាន ថ្លែង ថា ប្រជាជន មិន គោរព ច្បាប់ ចរាចរណ៍ ទេ « ដោយ សារ តែ គេ គិត ថា បើ ពួកគេ ផ្តល់ ប្រាក់ ខ្លះ ឲ្យ នគរបាល ពួក គេ អាច រំលោភ ច្បាប់ ចរាចរណ៍ បាន គេ អាច បើកបរ ដោយ មិន ពាក់ មួក សុវត្ថិភាព ឬ បើកបរ គ្មាន ពាក់ ខ្សែ ក្រវាត់ ដោយ គ្រាន់ តែ បង់ប្រាក់ តិច តួច ឲ្យ ទៅ នគរបាល ហើយ បន្ទាប់ មក បន្ត បើកបរ ត ទៅ ទៀត » ។
បើ ទោះជា ការ សិក្សា បង្ហាញ ថា មនុស្ស ប្រមាណ ៥ នាក់ បាន ស្លាប់ រៀងរាល់ ថ្ងៃ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ក៏ គ្មាន អ្នក ណា អាច រក ឃើញ ដំណោះស្រាយ ជាក់លាក់ នៅ ឡើយ ។
ពី ឆ្នាំ ២០០៥ ដល់ ២០១១ ចំនួន អ្នក ស្លាប់ កើនឡើង ទ្វេ ដង បើ តាម ប្រព័ន្ធ ព័ត៌មាន ជន រងគ្រោះ និង គ្រោះថ្នាក់ ចរាចរណ៍ នៅ កម្ពុជា ។
ប៉ុន្តែ គ្រោះថ្នាក់ សាហាវ មាន លើ ទំព័រ សារព័ត៌មាន នា ពេល ថ្មី ៗ នេះ មាន ជន រងគ្រោះ ជា តារា ល្បី ខណៈ លោក នាយក មន្ត្រី ហ៊ុន សែន លើកឡើង នោះ ផ្តល់ ឱកាស ដ៏ កម្រ ក្នុង ការ ផ្លាស់ ប្តូរ ។
គ្រោះថ្នាក់ ចរាចរណ៍ កើត ឡើង នៅ សប្តាហ៍ ទី១ ក្នុង ខែ នេះ បាន ធ្វើ ឲ្យ សាធារណជន ក្តៅ ក្រហាយ ធ្វើ ឲ្យ សកម្មជន ខឹង សម្បា និង ផ្តល់ ឱកាស ដល់ អ្នក ត ស៊ូ មតិ លើ ច្បាប់ ចរាចរណ៍ ថ្មី ធ្វើ ការ រំឭក រដ្ឋាភិបាល ពី ពេលវេលា ដ៏ ត្រឹម ត្រូវ នៃ ច្បាប់ ថ្មី នេះ ។
នៅ ថ្ងៃ ទី១ ខែ មីនា នគរបាល ថ្លែង ថា និស្សិត ពេទ្យ ម្នាក់ ឈ្មោះ គាម ពិសិដ្ឋ ម៉ារីតា បាន បើក រថយន្ត បុក ម៉ូតូ អ្នក ដំណើរ និង អ្នក ជិះ កង់ ជាច្រើន តាម មហាវិថី ព្រះ នរោត្តម ជា ការ រត់ គេច ពី នគរបាល បន្ទាប់ ពី បាន បុក ម៉ូតូ មួយ គ្រឿង លើ ផ្លូវ តែ មួយ នេះ ។
អ្នក ឆ្លើយ ត ប នឹង គ្រោះថ្នាក់ កំពុង តែ ពិនិត្យ គ្រោះថ្នាក់ លើក ទី ១ ដែល មាន រថយន្ត កុងតឺន័រ ក្រឡាប់ ពេល នោះ រថយន្ត ដឹក ស្រាបៀរ អង្គរ បាន បើក មក បុក អ្នក ជួយ សង្គ្រោះ ។
ករណី គ្រោះថ្នាក់ នេះ បាន ឮ ទៅ ដល់ ថ្នាក់ លើ ។
លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន បាន ថ្លែង នៅ ឯ វិទ្យាស្ថាន ជាតិ អប់រំ កាលពី ម្សិលមិញ ថា លោក សូម ចូលរួម រំលែក ទុក្ខ ជាមួយ នឹង ក្រុម គ្រួសារ ដែល បាត់បង់ អ្នក ជា ទីស្រឡាញ់ នៅ តាម បណ្តោយ មហាវិថី ព្រះ នរោត្តម និង ផ្លូវ ជាតិ លេខ ៤ ហើយ លោក ស្នើ សុំ ឲ្យ អ្នក រាល់គ្នា ផ្តោត លើ ការ ធ្វើ ឲ្យ ថ្ងៃ នេះ និង ថ្ងៃ ស្អែក គ្មាន គ្រោះថ្នាក់ ចរាចរណ៍ ។
មន្ត្រី បាន ខិតខំ កាលពី ម្សិលមិញ ដើម្បី អនុវត្ត តាម អនុសាសន៍ របស់ លោក ហ៊ុន សែន ។
ទោះ យ៉ាង ណា លោក ប៉ែន សង្ហា អ្នក នាំ ពាក្យ ព្រះ អង្គ ម្ចាស់ នរោត្តម រណឫទ្ធិ បាន ច្រាន ចោល ការ ចោទ ប្រកាន់ នេះ ដោយ អះអាង ថា នេះ ជា ការ ចោទ ប្រកាន់ របស់ ក្រុម មេ ដឹក នាំ គណ បក្ស ហ្វុ៊ន ស៊ិន ប៉ិច បច្ចុប្បន្ន ដែល គ្មាន មូល ដ្ឋាន ពិត ប្រាកដ និង គ្មាន គុណ ធម៌ ទាល់ តែ សោះ ។
លោក ឧត្តម សេនីយ៍ ភូង ម៉ាល័យ ស្នងការ រង នគរបាល រាជធានី ភ្នំពេញ បាន ថ្លែង នៅ ក្នុង កិច្ច ប្រជុំ មួយ នៅ ស្នងការ រាជធានី កាល ពី ម្សិលមិញ ថា ខណ្ឌ ពោធិ៍សែនជ័យ កើត មាន បទ ឧក្រិដ្ឋ ច្រើន បំផុត ក្នុង ចំណោម ខណ្ឌ ផ្សេង ទៀត ។
លោក បាន សង្កត់ ធ្ងន់ ថា ក្នុង ចំណោម ខណ្ឌ ទាំង ៩ នៅ ភ្នំពេញ ខណ្ឌ ទួលគោក ជា ខណ្ឌ ល្អ បំផុត ដែល បំពេញ តួនាទី ល្អ ក្នុង ការ បង្ការ និង បង្ក្រាប បទឧក្រិដ្ឋ ឬ បទល្មើស ដទៃ ទៀត ។
ទោះ ជា យ៉ាង ណា លោក ជួន សុវណ្ណ បាន បញ្ជាក់ ថា បើ ទោះ បី ជា មាន បទ ឧក្រិដ្ឋ ភាគ ច្រើន កើត ក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ ក៏ ដោយ ប៉ុន្តែ ជា ទូទៅ នគរបាល បាន បំពេញ តួនាទី និង ការងារ បាន ល្អ ក្នុង ការ ផ្តល់ សន្តិភាព សន្តិសុខ សុវត្ថិភាព ចរាចរណ៍ និង សណ្តាប់ ធ្នាប់ សាធារណៈ ដល់ ប្រជា ជន ក្នុង រាជ ធានី ភ្នំពេញ ។
លោក បាន សង្កត់ ធ្ងន់ ថា យោង តាម របាយការណ៍ របស់ ស្នង ការដ្ឋាន នគរបាល រាជ ធានី ភ្នំពេញ ក្នុង ឆ្នាំ ២០១២ បទល្មើស ទូទៅ បាន ថយ ចុះ ១៤,៨២ ភាគរយ ក្នុង នោះ ករណី រំលោភ សេព សន្ថវៈ បាន ថយ ចុះ ៤៤,៤៤ ភាគរយ ។
បញ្ហាដំឡើងប្រាក់ឈ្នួលឲ្យកម្មកររុញទៅរដ្ឋាភិបាលវិញ
លោក ខេន លូ អគ្គ លេខាធិការ សមាគម រោងចក្រ កាត់ ដេរ នៅ កម្ពុជា ក៏ លើក ឡើង ដែរ ថា រដ្ឋាភិបាល ចាំបាច់ ត្រូវ ប្រកាន់ ជំហរ លើ បញ្ហា នេះ ប៉ុន្តែ លោក បាន បន្ថែម ថា កិច្ច ពិភាក្សា នឹង បន្ត ក្នុង ពេល ឆាប់ ៗ នា សប្តាហ៍ ក្រោយ នេះ ។
ដើម្បីកាត់ បន្ថយគ្រោះថ្នាក់ចរាចរណ៍គ្រប់ គ្នាត្រូវតែគោរពច្បាប់
ត្រូវ ដឹង ថា នរណា ៗ ក៏ ចង់ ប្រញាប់ ដែរ ក៏ ប៉ុន្តែ សូម កុំ ភ្លេច ថា គ្រោះថ្នាក់ អាច កើត ឡើង គ្រប់ ពេលវេលា និង គ្រប់ ទីកន្លែង ៕
ដូច្នេះ ដើម្បី កុំ ឲ្យ មាន គ្រោះថ្នាក់ កើត ឡើង គឺ ត្រូវ ចាប់ ផ្តើម ពី បុគ្គល ម្នាក់ ឡើង ទៅ សំខាន់ គឺ ទាំង អស់ គ្នា ចាំបាច់ ត្រូវ តែ គោរព ច្បាប់ ចរាចរណ៍ ឲ្យ បាន ខ្ជាប់ ខ្ជួន នៅ ពេល បើកបរ ៕
មាន ក្មេង ស្ទាវ ខ្លះ ពេល ត្រូវ ប៉ូលិស ចាប់ បើក បុក ប៉ូលិស ថែម ទៀត ។
ដូច្នេះ ខ្ញុំ យល់ ថា ការ គោរព ច្បាប់ និង ការ អនុ វត្ត ច្បាប់ ចរា ចរណ៍ នៅ ក្នុង ប្រទេស កម្ពុជា នៅ មាន កម្រិត នៅ ឡើយ ៕
លោក បាន កត់ សម្គាល់ ថា សេដ្ឋកិច្ច ដ៏ តូច របស់ កម្ពុជា ក៏ ធ្វើ ឲ្យ វា កាន់ តែ ពិបាក ក្នុង ការ បាត់ បង់ ការ ចាប់ អារម្មណ៍ លើ ប្រតិបតិ្តការ ហិរញ្ញវត្ថុ ធំ ៗ ផង ដែរ ។
ទោះ ជា យ៉ាង ណា លោក ស្រី ងួន សុខា អគ្គ នាយក ធនាគារ ជាតិ កម្ពុជា ថ្លែង ថា លោកស្រី « ពុំ ព្រួយ បារម្ភ អំពី ហានិភ័យ នៃ ការ លាង លុយ កខ្វក់ និង ភេរវកម្ម ហិរញ្ញវត្ថុ ទេ ព្រោះ យើង បាន បង្កើត អង្គភាព ព័ត៌មាន ហិរញ្ញវត្ថុ ជា ស្ថាប័ន រឹង មាំ មួយ ដើម្បី ឃ្លាំ មើល បញ្ហា នេះ » ។
ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ជា លក្ខណៈ សហគមន៍ នេះ ត្រូវ បាន ផ្តល់ ទៅ ឲ្យ សហគមន៍ ចំនួន ពីរ គឺ ភូមិ អូរ ច្រា និង ភូមិ ហ្គាទី ក្នុង ឃុំ ស្រែ ព្រះ ស្រុក កែវ សីមា ដែល មាន ប្រជាពលរដ្ឋ ចំនួន ជាង ៧០ គ្រួសារ ។
លោក បាន ថ្លែង ថា ដំណើរ ការ ផ្តល់ ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ត្រូវ បាន ធ្វើ ឲ្យ បាន លឿន ជាង មុន ដោយ អនុ ក្រឹត្យ ឆ្នាំ ២០០៩ ស្តីពី នីតិវិធី នៃ ការ ចុះ បញ្ជី ដី សហគមន៍ ជន ជាតិ ដើម ភាគ តិច ៕
ប្រតិ ចារឹក ម្នាក់ ដែល ប្រាប់ ឈ្មោះ ត្រឹម តែ តារា បាន យល់ ស្រប នឹង ទស្សនៈ របស់ ក្រុម អ្នក បកប្រែ ដែរ ដោយ ថា អ្នក បកប្រែ គឺ សំខាន់ ណាស់ សម្រាប់ ដំណើរ ការ នីតិវិធី សវនាការ ។
លោក បន្ត ថា សហគមន៍ អឺរ៉ុប កំពុង ធ្វើ ការ ពាក់ព័ន្ធ នឹង ថវិកា ប្រមាណ ៣០ ម៉ឺន ដុល្លារ ដែល គេ សន្យា ផ្តល់ ឲ្យ ដែល នឹង ប្រើ សម្រាប់ បើក ប្រាក់ ខែ សម្រាប់ ខែ ធ្នូ របស់ បុគ្គលិក ៕
ផ្ទះ ប្រជា ពលរដ្ឋ ២១ គ្រួសារ នៅ ឃុំ កែវ ផុស ស្រុក ស្ទឹង ហាវ ត្រូវ បាន ឈូស កម្ទេច កាលពី ថ្ងៃ ទី៥ មីនា ដោយ កម្លាំង សមត្ថកិច្ច ជាង ១០០ នាក់ មក ចុះ អនុវត្ត សាលក្រម សាលា ដំបូង ខេត្ត ចេញ កាល ពី ខែ មេសា ឆ្នាំ ២០១២ ដែល កាត់ ក្តី ឲ្យ លោក ជៀម ផែន ប្រធាន ក្រុមហ៊ុន ស្រា បៀរ លីអូ ឈ្នះ ក្តី ។
ចំពោះ ករណី ឈូស ឆាយ និង ការ ស្វះ ស្វែង ប្តឹង ផ្តល់ ទាម ទារ សំណង របស់ ពលរដ្ឋ លោក ប៊ុន ណារិទ្ធ បាន ថ្លែង ថា៖
ចាប់ខ្លួនជនក្លែង ធ្វើ ប៉េអឹម២នាក់
លោក ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ ចន្ទ ថា ៖
ថៅកែហាងមានខ្ចូសបិទបាំងបានកោះហៅមកចុះ ខសន្យា
លោក កុយ ហៀង នាយ ការិយាល័យ ប្រឆាំង បទល្មើស ជួញដូរ មនុស្ស នេះ អះអាង ថា ក្រោយ ការ ពិនិត្យ សិស្ស ជាច្រើន នាក់ ប្រព្រឹត្ត អំពើ មិន គប្បី សមត្ថកិច្ច ក៏ បាន កោះ ហៅ អាណា ព្យាបាល សិស្ស ១៧ នាក់ ក្នុង នោះ ស្រី ៧ នាក់ ឲ្យ មក ទូន្មាន អប់រំ កូន ។
រីឯ ថៅកែ ហាង ម៉ាន់ សូនី ត្រូវ កោះ ហៅ មក អប់រំ និង ឲ្យ ចុះ កិច្ច សន្យា រុះរើ ខ្ចូស ដែល បាន បិទបាំង នោះ វិញ ប្រសិន បើ ថ្ងៃ មុខ ម្ចាស់ ហាង នេះ នៅ តែ បន្ត ប្រព្រឹត្ត ខុស ពី ការ ណែនាំ របស់ សមត្ថកិច្ច នោះ ថៅកែ នឹង ត្រូវ ប្រឈម ចំពោះ មុខ ច្បាប់ ។
មេ គណបក្សប្រឆាំង សន្យាចុះចេញពីអំណាច បើខ្លួនដឹកនាំហើយដំឡើងប្រាក់ខែកម្មករនិងមន្ត្រីមិនបាន
មន្រ្តី ពី ធនាគារ កណ្តាល ចៅក្រម ព្រះ រាជ អាជ្ញា មន្រ្តី អនុវត្ត ច្បាប់ និង មន្រ្តី អធិការ កិច្ច ពន្ធដារ ស្ថាប័ន បញ្ញត្តិកម្ម និង វិស័យ ឯកជន ត្រូវ បាន អញ្ជើញ ដើម្បី ចូល រួម ក្នុង ការ បណ្តុះ បណ្តាល ។
ក្នុង សេចក្តី ប្រកាស ព័ត៌ មាន នេះ ឲ្យ ដឹង ថា ៖
ក្រោម ច្បាប់ ស្តីពី ការ ប្រឆាំង ការ លាង លុយ និង ការ ប្រយុទ្ធ ប្រឆាំង ការ ផ្តល់ ហិរញ្ញ ប្បទាន ដល់ ភេរវកម្ម ឆ្នាំ ២០០៧ ស្ថាប័ន ហិរញ្ញ វត្ថុ របស់ ប្រទេស នេះ ត្រូវ តម្រូវ ឲ្យ អនុ - វត្ត កម្មវិធី ជួយ ការ ពារ និង ស្វែង រក អំពើ លាង លុយ ។
លោក បាន មាន ប្រសាសន៍ ថា ៖
បច្ចុប្បន្ន ស្ថាន ភាព យុវជន ៣ នាក់ ត្រូវ បាន ក្រុម គ្រូ ពេទ្យ យក បង់ ពណ៌ ស រុំ ត្រង់ កន្លែង របួស ចាប់ ពី ក្បាល រហូត ដល់ កំភួន ជើង ។
យោង តាម អ្នក ផ្ទៃ ក្នុង ឧស្សាហកម្ម ដែល ពុំ ចង់ បញ្ចេញ ឈ្មោះ បាន ឲ្យ ដឹង ថា ពុំ មាន លទ្ធភាព ដែល សមាគម រោងចក្រ កាត់ ដេរ នៅ កម្ពុជា ត្រូវ បាន លួង លោម ឲ្យ ផ្តល់ ប្រាក់ ខែ ដល់ កម្មករ លើ ស ពី ៩ ដុល្លារ អាមេរិក ឡើយ ក្នុង អំឡុង កិច្ច ប្រជុំ ថ្ងៃ នេះ ។
លោក បាន បន្ថែម ថា រដ្ឋាភិបាល នឹង ចាត់ វិធានការ ប្រសិន បើ មិន ឈាន ដល់ ការ ព្រមព្រៀង ទេ នោះ ។
លោក សម រង្ស៊ី ដែល ជា គូ ប្រជែង ចម្បង ជាមួយ លោក នាយក រដ្ឋ មន្រ្តី ហ៊ុន សែន កំពុង រស់ នៅ ប្រទេស បារាំង ដើម្បី គេច ពី ទោស ពន្ធនាគារ ដោយ សារ តែ ការ ផ្តន្ទាទោស ជាច្រើន ករណី ដែល អ្នក រិះ គន់ ហៅ ថា ជា ករណី នយោបាយ ។
មន្រ្តី គណបក្ស របស់ លោក រង្ស៊ី បាន ថ្លែង នៅ ភ្នំពេញ ថា លោក រង្ស៊ី បាន ទៅ ដល់ ទីក្រុង យ៉ាំងហ្គោន នៅ ថ្ងៃ សុក្រ ដើម្បី ចូល រួម សមាជ លើក ទី ១ របស់ គណបក្ស សម្ព័ន្ធ ជាតិ ដើម្បី ល ទិ្ធ ប្រជាធិបតេយ្យ ហើយ បាន ជួប ប្រជុំ ជាមួយ នឹង លោក ស្រី ស៊ូជី នៅ ព្រឹក ថ្ងៃ សៅរ៍ ។
តុលាការកោះហៅកម្មករនិងសហជីព៨នាក់
ស្រ្តី រងគ្រោះ ត្រូវ បាន គេ បញ្ជូន ភ្លាម ៗ ទៅ សង្រ្គោះ នៅ មន្ទីរ ពេទ្យ កាល់ម៉ែត ក្នុង រាជធានី ភ្នំពេញ ប៉ុន្តែ បាន ស្លាប់ នៅ ពេល បញ្ជូន ទៅ ដល់ មន្ទីរពេទ្យ ។
លោក ទូជ ស៊ុន បាន បញ្ជាក់ ថា៖
កាលពី ថ្ងៃពុធ ក្រុម អ្នក ភូមិ អះអាង ថា សមត្ថកិច្ច បាន ប្រើ អាវុធ បាញ់ គំរាម ប្រជាជន ចំនួន ពីរ គ្រាប់ ខណៈ អ្នកភូមិ ប្រមាណ ៧០ នាក់ ឈរ ប្រទាក់ ដៃ គ្នា ការពារ មិន ឲ្យ មាន ការ រុះរើ ផ្ទះ សម្បែង តែ មិន បង្ក របួស មនុស្ស ទេ ខណៈ អាជ្ញាធរ ថា ជា ការ បាញ់ ការពារ ខ្លួន ពី ការ ប្រើ ដំបង កាំបិត ពី សំណាក់ អ្នកតវ៉ា ។
អ្នកស្រី សំ សេរី ដែល អះអាង ថា មាន ឈ្មោះ នៅ ក្នុង បញ្ជី ដាក់ ញ ត្តិ សុំ កិច្ច អន្តរាគមន៍ ពី អាជ្ញាធរ ខេត្ត កោះ កុង ដើម្បី បាន សិទ្ធិ រស់ នៅ និង ប្រកប របរ កសិកម្ម ចិញ្ចឹម ជីវិត ក្នុង តំបន់ ជម្លោះ នេះ តាំង ពី អំឡុង ឆ្នាំ ២០០៤ និង ទើប តែ ចូល ទៅ សង់ ផ្ទះ នៅ ពី ឆ្នាំ មុន កាល ពី ម្សិលមិញ បាន ប្រាប់ ថា៖
លោក សុខ ស៊ុយ ដែល កាលពី ថ្ងៃ ពុធ ត្រូវ សមត្ថកិច្ច គំរាម ចាប់ ខ្លួន ដែរ នោះ ថា ក្រោយ ពី អ្នកភូមិ ឈ្មោះ ឡឹក សុខ ផែ អាយុ ៤៥ ឆ្នាំ ត្រូវ សមត្ថកិច្ច ឃាត់ ខ្លួន ភ្លាម ៗ នោះ គាត់ ក៏ ត្រូវ គេ គំរាម ព្រមាន ថា នឹង សុំ ដីកា ពី តុលាការ ខេត្ត កោះ កុង ឲ្យ ចាប់ ខ្លួន ផងដែរ ។
លោក ផាន់ កណ្ណារ៉ាត់ អភិបាល រង ក្រុង ខេមរ ភូមិន្ទ ថែ្លង ថា មក ដល់ ថ្ងៃ ទី បី នៃ ប្រតិបត្តិការ រុះរើ សំណង់ អនាធិបតេយ្យ នេះ សមត្ថកិច្ច សម្រេច រុះរើ ផ្ទះ សរុប បាន ជិត ១៥០ ខ្នង ហើយ ។
រដ្ឋាភិបាល កម្ពុជា ទទួល បន្ទុក ផ្តល់ មូលនិធិ ខាង ភាគី ជាតិ សាលា ក្តី ប៉ុន្តែ បច្ចុប្បន្ន កំពុង ប្រឈម នឹង កង្វះ ថវិកា ៧ លាន ដុល្លា រ សម្រាប់ ឆ្នាំ ២០១៣ ហើយ បាន ខក ខាន ដល់ ការ បើក ប្រាក់ ខែ បុគ្គលិក ។
បន្ទាប់ ពី ដឹង អំពី គម្រោង ធ្វើ កូដ កម្ម នេះ ផ្នែក រដ្ឋ បាល បាន ផ្ញើ សេចក្តី ណែ នាំ ទៅ មន្រ្តី ទទួល បន្ទុក ផ្នែក បក ប្រែ ឲ្យ ព្រមាន ថា ទង្វើ នេះ គឺ ជា គំនិត អាក្រក់ ។
ក្រុម អ្នក រៀប ចំ ស្នូល បាន ប្រជុំ គ្នា ១០ ថ្ងៃ ជា មុន ដើម្បី ដាក់ ចេញ នូវ យុទ្ធសាស្រ្ត នេះ រាប់ ទាំង ការ រៀប ចំ សំណើ ទាមទារ ។
កូដកម្ម ជា លើក ទី១ ក្នុង ប្រវតិ្តសាស្រ្ត តុលាការ នេះ កំពុង ដំណើរ ការ រៀប ចំ ហើយ ។
លោក បាន បន្ថែម ថា លោក សង្ឃឹម ថា ជំនួយ ដែល សន្យា ពី សហភាព អឺរ៉ុប នឹង មក ដល់ ក្នុង ពេល ឆាប់ ៗ ដើម្បី បើក ប្រាក់ ខែ សម្រាប់ ខែ ធ្នូ ហើយ ដោះ ស្រាយ ស្ថានការណ៍ ជា បណ្តោះ អាសន្ន ។
លោកនាយករដ្ឋ មន្ត្រីព្រមាន មន្ត្រីឲ្យចៀសពីបក្ខពួកនិយម
ថ្លែង ទៅ កាន់ និស្សិត បញ្ចប់ ការ សិក្សា ពី សាលា ភូមិន្ទ រដ្ឋបាល លោក នាយក រដ្ឋ មន្រ្តី បាន ព្រមាន ថា លោក នឹង ធ្វើ ការ ពិនិត្យ បញ្ជី នោះ ដោយ ខ្លួន លោក ផ្ទាល់ ដើម្បី ពិនិត្យ ថា តើ មាន អំពើពុក រលួយ ឬ អត់ ។
លោក បន្ត ថា បញ្ហា សាច់ ញាតិ និយម មិន ត្រឹម តែ កើត មាន ក្នុង គណបក្ស កាន់ អំណាច ទេ ប៉ុន្តែ ថែម ទាំង កើត មាន ក្នុង គណបក្ស ប្រឆាំង រួម មាន ដូច ជា គណបក្ស សម រង្ស៊ី និង គណបក្ស សិទ្ធិ មនុស្ស ។
លោក ហ៊ុន សែន បាន ចង្អុល បង្ហាញ ថា ៖
ប៉ុន្តែ យុទ្ធសាស្រ្ត នេះ គ្មាន ប្រសិទ្ធភាព ទេ ពីព្រោះ មាន តែ ប្រជា ជន ទេ ដែល នឹង វិនិច្ឆ័យ ថា តើ គណបក្ស ណា មួយ ដែល ប្រព្រឹត្ត អំពើ ពុករលួយ សាច់ ញាតិ និង បក្ខ ពួក និយម » ។
លោក គល់ បញ្ញា នាយក ប្រតិបត្តិ នៃ គណៈកម្មាធិការ ដើម្បី ការ បោះឆ្នោត ដោយ សេរី និង យុត្តិធម៌ នៅ កម្ពុជា ហៅ កាត់ ខុម ហ្វ្រែល បាន ថ្លែង ថា ស្ថានភាព នយោបាយ នៅ មុន ការ បោះ ឆ្នោត គឺ នៅ មាន សភាព ស្ងប់ ស្ងាត់ ដូច ធម្មតា ។
ឆេះ ផ្ទះស្លាប់៧នាក់នៅមណ្ឌលគិរីអ្នក រង របួស សង្ស័យ មកពីភ្លើង កន្ទុយបារី
លោក អធិការ បន្ត ថា អ្នក រង របួស បាន បញ្ជូន មក សង្គ្រោះ នៅ មន្ទីរ ពេទ្យ ខេត្ត មណ្ឌល គិរី ខណៈ សព ដែល ឆេះ ខ្លោច ស្ទើរ បាត់ រូបរាង ត្រូវ សមត្ថកិច្ច ប្រមូល ចេញ ពី គំនរ ភ្លើង និង ផេះ ដើម្បី ប្រគល់ ឲ្យ សាច់ ញាតិ យក ធ្វើ បុណ្យ ។
លោក ចាន់ យឿន អភិបាល ខេត្ត មណ្ឌល គិរី បាន ថ្លែង ថា លោក មាន ការ សោកស្តាយ ជា ខ្លាំង ចំពោះ ឧប្បត្តិហេតុ ភ្លើង ឆេះ ផ្ទះ ដែល បណ្តាល ឲ្យ មនុស្ស ស្លាប់ ជាច្រើន រួមទាំង កុមារ ផង ។
លោក បន្ត ថា ខាង កាក បាទ ក្រហម ខេត្ត បាន ចាត់ ចែង ផ្តល់ ជំនួយ សង្គ្រោះ បន្ទាន់ ដល់ គ្រួសារ សព កាល ពី ម្សិលមិញ ។
អង្គ ការ លីកាដូ បាន អំពាវ នាវ ឲ្យ រដ្ឋាភិបាល ពិចារណា ឡើង វិញ លើ ការ ឃុំ ខ្លួន ស្រ្តី និង ក្មេង ស្រី ដោយ សារ តែ បទ ល្មើស គ្រឿង ញៀន និង ចោរ កម្ម តូច តាច ដោយ អង្គ ការ បាន បញ្ជាក់ ថា ស្រ្តី ជា ច្រើន នាក់ ដែល ចិញ្ចឹម កូន ឬ មាន ផ្ទៃ ពោះ ក្នុង ពន្ធនាគារ កម្ពុជា ត្រូវ បាន ចាប់ ខ្លួន ដោយ សារ បទល្មើស គ្រឿង ញៀន ។
លោក សុខ ជួរ បាន ថ្លែង ឲ្យ ដឹង ទៀត ថា ស្រ្តី មាន ផ្ទៃពោះ នៅ ក្នុង ពន្ធនាគារ ទទួល បាន ការ ត្រួត ពិនិត្យ វេជ្ជសាស្រ្ត ជា រៀង រាល់ ថ្ងៃ ហើយ និង ការ ព្យាបាល ពី វេជ្ជបណ្ឌិត ប្រសិន បើ ពួក គេ ត្រូវ ការ ការ ព្យាបាល ៕
នៅ ក្នុង លិខិត របស់ លោក ចម ប្រសិទ្ធ ដែល ភ្នំពេញ ប៉ុស្តិ៍ ទទួល បាន ដដែល នោះ លោក បាន រៀបរាប់ អំពី សមត្ថកិច្ច របស់ ប្រទេស វៀតណាម ធ្វើ ការ ចាប់ ខ្លួន ជនជាតិ កម្ពុជា នៅ ជិត ព្រំ ដែន និង រឹប អូស យក ប្រាក់ ជា ច្រើន របស់ ពួក គេ ដែល ចូល ទៅ លក់ ដូរ ផលិតផល នៅ តាម ព្រំ ដែន ។
លោក សំរិទ្ធ សុវិទ្យា អគ្គ នាយក រង នៃ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ ទទួល បន្ទុក ផែន ការ និង វិនិយោគ បាន ឲ្យ ដឹង ថា ថ្មី ៗ នេះ មាន ឃុំ ចំនួន ២០ នៅ ក្នុង ខេត្ត កណ្តាល បាន កាត់ ចូល មក រាជ ធានី ភ្នំពេញ បណ្តាល ឲ្យ តម្រូវ ការ ផ្គត់ ផ្គង់ ទឹក ស្អាត ក្នុង រាជធានី កើន ឡើង ។
ក្នុង នោះ ហិរញ្ញ ប្ប ទាន សហប្រតិបត្តិការ ផ្តល់ ឲ្យ រដ្ឋាករ ទឹក ស្វយ័ត មាន ១១៧ លាន ដុល្លារ គិត ត្រឹម ឆ្នាំ ២០១២ ៕
បើ តាម លោក គីម សុទ្ធ រថយន្ត ត្រូវ បាន រក ឃើញ នៅ ឃុំ ខ្ចាស់ ស្រុក សូទ្រ និគម ហើយ ពុំ មាន ស្លាក លេខ ទេ ប៉ុន្តែ ត្រូវ បាន រក្សា ទុក ជា ភ័ស្តុតាង ដើម្បី ស្វែង រក អ្នក បើកបរ និង ម្ចាស់ ឈើ ប្រណីត ។
ទោះ ជា យ៉ាង ណា លោក សុន ឆ័យ តំណាង រាស្រ្ត គណបក្ស សម រង្ស៊ី បាន ថ្លែង ថា ពាណិជ្ជកម្ម ខុស ច្បាប់ កំពុង បន្ត អាច ធ្វើ ទៅ បាន តាម រយៈ ទំនាក់ ទំនង រវាង អ្នក មាន និង មន្ត្រី ក្នុង ជួរ រដ្ឋាភិបាល ។
លោក ច័ន្ទ សារុន រដ្ឋ មន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង លោក ឆេង គីម ស៊ុន ប្រធាន រដ្ឋ បាល ព្រៃឈើ ពុំ អាច ទាក់ ទង ដើម្បី សុំ ការ អត្ថាធិប្បាយ បាន ទេ ៕
លោក អ៊ិត សំហេង បាន គូស បញ្ជាក់ ថា កម្ពុជា ស្ថិត ក្នុង ប្រទេស ដែល មាន អត្រា អ្នក ជក់ បារី ខ្ពស់ ក្នុង ចំណោម បុរស គឺ ៤២ ភាគ រយ ។
អង្គការ សិទ្ធិ មនុស្ស លីកាដូ កាល ពី ម្សិល មិញ បាន ទៅ ចែក អំណោ យ ស្បៀង អាហារ ថ្នាំ សង្កូវ និង តង់ កៅ ស៊ូ ដល់ ក្រុម គ្រួសារ ប្រជា ពលរដ្ឋ រងគ្រោះ ដែល កំពុង រស់ នៅ ដោយ គ្មាន ផ្ទះ ទាំង នោះ ៕
អ្នក ពាក់ព័ន្ធនឹងថ្នាំញៀន ៦នាក់ចាប់ខ្លួននៅព្រៃវែង
ដើម បណ្តឹង មិន បាន ដាក់ បន្ទុក លោក ម៉ម សូណង់ ដូ ដើម បណ្តឹង ៣ នាក់ ដែល មាន វត្តមាន លោក ឆេង ឆាត់ សមាជិក ក្រុម ប្រឹក្សា ឃុំ កំពង់ ដំរី លោក ជា ជីន មេ ភូមិ ប្រមា និង លោក កុល ពន្លឺ នគរបាល ប៉ុស្តិ៍ ឃុំ កំពង់ ដំរី ត្រូវ បាន អង្គ សវនាការ សួរ ដេញ ដោល ពេញ មួយ ព្រឹក ម្សិលមិញ ។
លោក កុល ពន្លឺ នគរបាល ប៉ុស្តិ៍ ឃុំ កំពង់ ដំរី ថ្លែង ក្នុង សវនាការ ថា រាល់ លើក មាន តែ ឈ្មោះ ប៊ុន រដ្ឋា ដែល តាំង ខ្លួន ជា មេ ក្លោង មកពី សមាគម អ្នក ប្រជាធិបតេយ្យ ចេ ញ មុខ ជួប ពលរដ្ឋ ហើយ បំផុស បំផុ ល បញ្ជា ពលរដ្ឋ ឲ្យ កាន់ កាំបិត ពូ ថៅ ស្នា ធ្វើ បាតុ កម្ម ត វ៉ា រឿង ដីធ្លី ។
សញ្ញា វិជ្ជមាន ពី សវនាការ ការ សាលា ឧទ្ធរណ៍ បាន យល់ ព្រម ទទួល យក ការវិភាគ ឯករាជ្យ មួយ របស់ មជ្ឈ មណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា ទៅ ពិចា រណា ក្នុង ការ កាត់ ក្តី ហើយ ត្រូវ បាន ចៅ ក្រម លោក ឃុន លាង ម៉េង អាន ក្នុង អង្គ សវនាការ ។
លោក ថ្លែង ថា វា ជា ការ វិភាគ តាម ផ្លូវ ច្បាប់ នូវ សិទ្ធិ សេរីភាព អ្នក សារ ព័ត៌មាន ដែល មិន គួរ រំលោភ បំពាន លើ ផ្នែក បញ្ចេញ មតិ ។
លោក រំពឹង ថា សាលាដំបូង ២៤ ខេត្ត ក្រុង នឹង ទទួល យក ការ វិភាគ លើ បញ្ហា ផ្សេង ៗ ក្នុង ការ ពិចារណា រឿង ក្តី ។
លោក វីរៈ មាន ប្រសាសន៍ ថា ៖
នៅ ពេល ទាក់ ទង មក កា សែត ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិលមិញ បុរស ម្នាក់ ដែល អះអាង ថា ខ្លួន ឈ្មោះ ប៊ុន រដ្ឋា បាន គំរាម ធ្វើ មហា បាតុកម្ម បើ តុលាការ កម្ពុជា គ្រប់ ជាន់ ថ្នាក់ មិន ផ្តល់ យុត្តិធម៌ ឲ្យ លោក សូណង់ ដូ ។
ប៉ុន្តែ សំណាង ភ្លាម ៗ នោះ នគរបាល កម្ពុជា នៅ ប៉ុស្តិ៍ ព្រំ ដែន បាន អន្តរាគមន៍ ជួយ ទាន់ ។
លោក អះអាង ថា ប្រាក់ ៤៨.០០០ ដុល្លារ អាមេរិក របស់ គាត់ ត្រូវ គេ រឹប អូស ជា ទ្រព្យ សម្បត្តិ រដ្ឋ វៀតណាម ។
អភិបាល ខេត្ត កំពង់ចាម លោក ហ៊ុន ណេង បាន ថ្លែង កាលពី ម្សិលមិញ ថា អាជ្ញាធរ វៀតណាម បាន ធ្វើ ការ ចាប់ ខ្លួន ជន ជាតិ កម្ពុជា ទាំង នោះ គឺ ត្រឹមត្រូវ តាម ច្បាប់ ដោយ លោក បាន អះអាង ថា ពួក គេ មួយ ចំនួន កាន់ លុយ ច្រើន ដើម្បី ចៀស ពី ការ ចុះ បញ្ជី ទិដ្ឋាការ នៅ តាម ប៉ុស្តិ៍ ព្រំដែន អន្តរជាតិ ។
សុខភាពរបស់លោកអៀង សារី កាន់ តែធ្ងន់ធ្ងរ
ពេល ខ្ញុំ និយាយ ជាមួយ គាត់ គាត់ គ្រាន់ តែ ងក់ ក្បាល ប៉ុន្តែ ខ្ញុំ មិន គិត ថា គាត់ យល់ អំពី អ្វី ដែល ខ្ញុំ និយាយ ទេ ។
អ្នក បក ប្រែ ម្នាក់ ដែល ធ្វើ កូដកម្ម ដែល ស្នើ សុំ មិន បញ្ចេញ ឈ្មោះ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា៖
ក្រុម អ្នក ភូមិ ឲ្យ ដឹង ថា កម្លាំង ចម្រុះ ប្រមាណ ជិត ៥០ នាក់ ដែល ចុះ ប្រតិបត្តិការ បន្ត រុះរើ ផ្ទះ ពលរដ្ឋ ម្សិលមិញ បាន បាញ់ គំរាម ធ្វើ ឲ្យ អ្នក ភូមិ ភិតភ័យ រត់ ចែក ជើង គ្នា ខណៈ ផ្ទះ ជាង ៤០ ខ្នង ត្រូវ រុះរើ បំផ្លាញ ខ្ទេច ពី ថ្ងៃ អង្គារ និង បាន ឃាត់ អ្នក ភូមិ ម្នាក់ ឲ្យ ធ្វើ កិច្ច សន្យា ផង មុន នឹង ដោះ លែង វិញ ។
អ្នក ស្រី អ៊ុក ណេង ជា អ្នក ភូមិ ម្នាក់ ប្រាប់ ថា អ្នក ភូមិ ជាង ៧០ នាក់ បាន ផ្តុំ គ្នា ខ្លះ កាន់ ប ដា ពាក្យ ស្លោក និង រូបថត លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ផង បាន រារាំង មិន ឲ្យ កម្លាំង ចម្រុះ ចូល ទៅ រុះរើ ផ្ទះ ពួក គាត់ ប៉ុន្តែ នៅ ម៉ោង ប្រហែល ១០ ព្រឹក អ្នក ភូមិ មិន អាច ទប់ស្កាត់ កង កម្លាំង ទាំង នោះ បាន ទេ ព្រោះតែ គេ គំរាម ថា៖
លោក អ៊ិន គង់ ជិត មន្ត្រី ស៊ើប អង្កេត សិទ្ធិ មនុស្ស លីកាដូ ខេត្ត កោះ កុង ឲ្យ ដឹង ថា ទំនាស់ ដី មាន ៣៦ ហិកតា រដ្ឋបាល ព្រៃឈើ កំពុង ដាំ ដើម អាកាស្យា តែ ពលរដ្ឋ ថា គ្មាន ផ្ទះ សម្បែង និង ដី ធ្លី បាន ចូល ទៅ សង់ ផ្ទះ ក្រោយ ពី បាន ដាក់ លិខិត ជូន លោក ហ៊ុន ម៉ាណែត កាលពី ថ្ងៃទី ២៥ កុម្ភៈ ។
ភ្លាម ៗ នោះ លោក វណ្ណៈ បាន ទៅ ស្ថាន ទូត កម្ពុជា ប្រចាំ ប្រទេស មីយ៉ាន់ម៉ា ដើម្បី សុំ អន្តរាគមន៍ ជួយ ចេញ លិខិត មួយ អាច ជិះ យន្ត ហោះ បាន ជំនួស លិខិត ឆ្លង ដែន ដែល បាត់ ។
លោក វណ្ណៈ បាន និយាយ នៅ ចំពោះ មុខ ឯក អគ្គ រដ្ឋ ទូត មីយ៉ាន់ម៉ា នៅ ភ្នំពេញ កាល ពី ម្សិលមិញ ថា៖
លោក វណ្ណៈ បាន ឲ្យ លុយ ចំនួន ១ ពាន់ ដុល្លារ តប ស្នង ដល់ អំពើ ល្អ របស់ អ្នក រត់ តាក់ស៊ី មីយ៉ាន់ម៉ា រូប នេះ វិញ ។
តុលាការកំពូលប្តូរ បទចោទអតីតព្រះរាជ អាជ្ញាតុ ប ច័ន្ទសេរី វុឌ្ឍ តែតម្កល់ទោស
លោក ចៅក្រម បន្ថែម ថា លោក តុ ប ច័ន្ទ សេរី វុឌ្ឍ ត្រូវ បាន តុលាការ ខេត្ត ពោធិ៍សាត់ ផ្ដន្ទា ទោស កាល ពី ថ្ងៃ ទី ១២ ឧសភា ២០១១ ឲ្យ ជាប់ ពន្ធនាគារ ១៩ ឆ្នាំ និង ពិន័យ ជា ប្រាក់ ៤ លាន រៀល ឈ្មោះ ឈិត វុទ្ធី ត្រូវ ជាប់ ពន្ធនាគារ ១៦ ឆ្នាំ រស់ សំណាង ជាប់ ពន្ធនាគារ ១៥ ឆ្នាំ និង ពេជ្យ គង់ យូ ជាប់ ពន្ធនាគារ ១៨ ឆ្នាំ ។
សត្វ កែះមួយក្បាលត្រូវចាប់ប្រគល់ឲ្យសួនសត្វភ្នំតាម៉ៅ
មន្រ្តី របស់ អង្គការ នេះ ម្នាក់ បាន បញ្ជាក់ ថា ៖
លោក ហ៊ុន សែន បាន គូសបញ្ជាក់ នៅ ក្នុង សារាចរ នោះ ថា បច្ចុប្បន្ន ជំងឺ ផ្តា សាយ បក្សី នៅ តែ កំពុង បន្ត កើត ឡើង នៅ បណ្តា ប្រទេស មួយ ចំនួន ក្នុង តំ បន់ នៃ ពិភព លោក ។
លោក កែវ សុភ័ត្រ្តា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត បន្ទាយ មាន ជ័យ បាន បញ្ជាក់ ប្រាប់ ថា ៖
បក្សប្រឆាំងដេញ ដោលរឿងទុកឲ្យម្តាយ - ទារកស្លាប់
សកម្មភាព នេះ កើត ឡើង បន្ទាប់ ពី មាន ព័ត៌មាន លម្អិត ដ៏ ខ្ពើម រអើម អំពី ករណី មួយ កាល ពី សប្តាហ៍ មុន នៅ ពេល បុគ្គលិក នៅ មន្ទីរ ពេទ្យ សម្ភព រាជធានី ភ្នំពេញ មួយ បាន បដិសេធ មិន សម្រាល កូន ដោយ សារ ស្រ្តី មាន ផ្ទៃ ពោះ និង ប្តី ក្រីក្រ ខ្លាំង ពេក មិន អាច បង់ ប្រាក់ ឲ្យ ឆ្មប បាន ។
លោក ស្រី មូរ សុខ ហួរ តំណាង រាស្រ្ត គណបក្ស ប្រឆាំង បាន ថ្លែង ថា មាន ករណី ស្រដៀង គ្នា យ៉ាង ហោច ណាស់ ចំនួន ៣ ផ្សេង ទៀត ក្នុង រយៈ ពេល ៦ ខែ កន្លង មក នេះ នៅ ខេត្ត ប៉ៃលិន ភ្នំពេញ និង បន្ទាយ មានជ័យ ដែល ម្តាយ ក្រីក្រ ឬ ទារក បាន ស្លាប់ ដោយ សារ តែ ការ ប្រព្រឹត្ត ខុស ឬ អំពើ ពុករលួយ ។
លោក ស្រី បន្ថែម ថា លោក ស្រី បាន ទទួល ដំណឹង ថា ក្នុង ករណី កាល ពី សប្តាហ៍ មុន ប្តី ក្រីក្រ ត្រូវ បាន ជេរ និង ប្រមាថ ដោយ គិលានុបដ្ឋាយិកា ពេល គាត់ ទៅ សុំ ឲ្យ គ្រូ ពេទ្យ ជួយ ។
មុន ពេល បិទ ទូរស័ព្ទ លោក ស្រី ថ្លែង ថា៖
លោក ស្រី មូរ សុខ ហួរ គ្រោង នឹង ដាក់ លិខិត ដែល ចុះ ហត្ថលេខា ដោយ សមាជិក សភា គណ បក្ស សម រង្ស៊ី និង គណបក្ស សិទិ្ធ មនុស្ស យ៉ាង ហោច ណាស់ ១០ នាក់ ដោយ ស្នើ សុំ ឲ្យ រដ្ឋ មន្រ្តី សុខាភិបាល ចូល ទៅ ឆ្លើយ សំណួរ អំពី ករណី ចុង ក្រោយ នេះ និង ករណី ដទៃ ទៀត ។
ក្នុង ករណី មួយ ចំនួន ការ បណ្តេញ បុគ្គលិក ដែល ធ្វើ បែប នេះ ពុំ គ្រប់ គ្រាន់ ទេ ។
លោក ម៉ម ប៊ុន ហេង រដ្ឋ មន្រ្តី ក្រសួង សុខាភិបាល ពុំ អាច ទាក់ទង សុំ ការ ពន្យល់ បាន ទេ កាល ពី ថ្ងៃ ម្សិលមិញ ៕
អ្នកស្រុកម៉ាឡៃភ្ជួរដី រ បើកគ្រាប់ ១២,៧ ម. ម ចំនួន៥ កេស
លោក អធិការ បន្ត ថា គ្រាប់ ខូច ទាំង នោះ នឹង ត្រូវ ប្រគល់ ទៅ ឲ្យ ខាង ក្រុម អង្គភាព ដោះ មីន ស៊ីម៉ាក់ នៅ ខេត្ត បន្ទាយមានជ័យ យក ទៅ កម្ទេច ចោល ។
អ្នក ទាំង នោះ ផ្តល់ ចម្លើយ ដាក់ បន្ទុក ធ្ងន់ធ្ងរ លើ កូន ក្តី លោក ដែល ទាមទារ ឲ្យ កូន ក្តី លោក ត តាំង នៅ មុខ តុលាការ ។
ខ្ញុំ គ្មាន ពាក់ព័ន្ធ ឬ ស្គាល់ ភូមិ ឃុំ នេះ ទេ ។
លោក ថា មិន ស្គាល់ ម៉ម សូណង់ ដូ និង មិន មែន ជា សមាជិក សមាគម អ្នក ប្រជាធិបតេយ្យ អ្វី ឡើយ ។
ដោយ ទឹក ចិត្ត ពុះ កញ្ជ្រោល ពលរដ្ឋ រាប់ រយ នាក់ បាន កាន់ បដា រូប ពាក់ មួក ក្រដាស សរសេរ អក្សរ ដោះ លែង លោក ម៉ម សូណង់ ដូ ខាង ក្រៅ តុលាការ និង ស្រែក តាម មេក្រូ មក បន្ទប់ សវនាការ សុំ ឲ្យ មាន ការ កាត់ ក្តី យុត្តិធម៌ មិន លុះ ដោយ អំណាច អ្នក នយោបាយ ។
នេះ ជា ការ សាក ល្បង ប្រព័ន្ធ តុលាការ នៅ សាលា ឧទ្ធរណ៍ យើង ចាំ មើល ប្រព័ន្ធ តុលាការ កាត់ រឿង នេះ ។
លោក សូវ៉ាន បន្ត ថា៖
ប្រជាជន រង ការ បំផ្លាញ ផ្ទះ សម្បែង អះ អាង ថា នេះ គឺ ជា ការ អនុវត្ត សាល ក្រម មិន ត្រឹមត្រូវ ធ្វើ បាប ប្រជាជន ទន់ ខ្សោយ និង បំពេញ ចិត្ត អ្នក មាន លុយ និង មាន អំណាច ឧកញ៉ា ជៀម ផែន ។
ដើម្បី បុគ្គល ម្នាក់ គេ សម្លាប់ ប្រជាជន ២១ គ្រួសារ » ។
គាត់ បន្ត ថា គាត់ គ្មាន ជម្រើស ចាកចេញ ពី ទីនេះ ទេ ដូច្នេះ នឹង នៅ តែ រឹង ទន្ទឹង រស់ នៅ បណ្តោះ អាសន្ន ជា បន្ត រង់ ចំា ដំណោះស្រាយ ។
លោក ប៊ុន ណារិទ្ធ មន្រ្តី សម្រប សម្រួល នៅ អង្គការ សិទ្ធិ មនុស្ស លីកាដូ បាន ថ្លែង ថា តុលាការ មិន គួរ អនុវត្ត សាលក្រម នេះ ទេ គួរ ទុក ឲ្យ ឧទ្ធរណ៍ ដោះស្រាយ តាម នីតិវិធី សិន ពីព្រោះ ការ អនុវត្ត បែប នេះ ធ្វើ ឲ្យ បាត់បង់ ភ័ស្តុតាង ខណៈ សំណុំ រឿង នេះ កំពុង តែ ពិចារណា ដោយ សាលា ឧទ្ធរណ៍ ៕
នេះ មាន ន័យ ថា ប្រជា ពលរដ្ឋ ចំនួន ៧១ ភាគរយ មិន ទាន់ មាន បង្គន់ អនាម័យ ប្រើប្រាស់ ទេ ។
បើ តាម របាយការណ៍ ប្រចាំ ឆ្នាំ ២០១២ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ កម្មវិធី លើក កម្ពស់ អនាម័យ ជន បទ គាំទ្រ ដោយ ថវិកា ជាតិ ឆ្នាំ ២០១២ ដែល មាន ចំនួន ១៣៣៣ លាន រៀល ដោយ អនុវត្ត នៅ ក្នុង ភូមិ ចំនួន ១០០ នៅ ក្នុង ខេត្ត ចំនួន ១០ ដែល សម្រេច បាន បង្គន់ អនាម័យ ចំនួន ២៦៣០ ។
គម្រោង ចេញ អនុក្រឹត្យ នេះ ធ្វើ ឡើង បន្ទាប់ ពី លោក នាយក រដ្ឋ មន្រ្តី ហ៊ុន សែន បាន មាន ប្រតិកម្ម ខ្លាំង ៗ កាល ពី ខែ មុន ចំពោះ ការ ដឹក លើ ស ទម្ងន់ បណ្តាល ឲ្យ ខូច ផ្លូវ ហើយ អ្នក ប្រព្រឹត្ត ត្រូវ បាន ដោះ លែង ។
លោក ចាន់ ដារ៉ុង បាន ឲ្យ ដឹង ថា ក្រសួង អភិវឌ្ឍន៍ ជន បទ និង ក្រសួង សារធារណ ការ និង ដឹក ជញ្ជូន កំពុង ធ្វើ ការ ងារ ពាក់ព័ន្ធ នឹង ផ្លូវ ថ្នល់ នៅ ទូទាំង ប្រទេស ។
បើ តាម លោក ចាន់ ដារ៉ុង ក្រសួង សារធារណការ មាន ជញ្ជីង ថ្លឹង ប្រភេទ អចល័ត ដែល ដាក់ នៅ តាម ដង ផ្លូវ ជាតិ នានា ចំណែក ក្រសួង អភិវឌ្ឍន៍ ជន បទ ក្រោម ការ ផ្តល់ ហិរញ្ញប្បទាន ដោយ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី នឹង ទិញ ជញ្ជីង ថ្លឹង ចល័ត ដើម្បី ធ្វើ ការ ទប់ ស្កាត់ ការ ផ្ទុក លើ ស ទម្ងន់ នេះ នៅ ក្រោយ ពេល អនុក្រឹត្យ នេះ ចេញ ។
ការ តវ៉ា នោះ ត្រូវ បាន លោក ហ៊ុន ណេង អភិបាល ខេត្ត កំពង់ចាម ចេញ មុខ ជួយ អន្តរាគមន៍ ៕
តំបន់ គោលដៅ របស់ ភ្ញៀវ ទេសចរ នៅ កម្ពុជា ភាគ ច្រើន ពុំ មាន ចរន្ត អគ្គិសនី ឡើយ បន្ទាប់ ពី គ្រោះ ថ្នាក់ ចរាចរណ៍ មួយ នៅ ខេត្ត បន្ទាយមានជ័យ កាល ពី ថ្ងៃ ព្រហស្បតិ៍ បាន ផ្តួល រំលំ បង្គោល អគ្គិសនី ចំនួន ១១ ដើម ។
ខ្ញុំ ដឹង ថា សណ្ឋាគារ ដទៃ ទៀត បាត់ បង់ ភ្ញៀវ ។
អ្នក លក់ ប្រេង ម៉ាស៊ូត បាន ដំឡើង តម្លៃ ហើយ រក បាន ចំណេញ ពី ស្ថាន ការណ៍ ដាច់ ភ្លើង នេះ ។
ភ្ញៀវ មួយ ចំនួន បាន ចាក ចេញ ពី ទីក្រុង សៀមរាប ដោយ សារ វិបតិ្ត គ្មាន ភ្លើង អគ្គិសនី នេះ ដោយ មនុស្ស ជា ច្រើន នាក់ បាន ធ្វើ ដំណើរ ឆ្ពោះ ទៅ ខេត្ត បាត់ដំបង ។
លោក លឿង ណារិន អ្នក រដ្ឋបាល នៅ អគ្គិសនី ខេត្ត សៀមរាប បាន ថ្លែង ថា ថាមពល បម្រុង ពុំ គ្រប់ គ្រាន់ ទេ ដើម្បី រក្សា ភ្លើង ជា ប្រចាំ ទូទាំង ក្រុង នោះ ។
លោក ស្រី នុង សៀង អ្នក គ្រប់គ្រង ផ្ទះ សំណាក់ អង្គរ ធំ បាន ថ្លែង ថា លោក ស្រី ពុំ មាន ប្រភព ថាមពល ផ្សេង ទេ ពេល ដាច់ អគ្គិសនី ។
បង្គោល ភ្លើង ចុង ក្រោយ ត្រូវ បាន ប្តូរ កាល ពី ថ្ងៃ អាទិត្យ ហើយ អគ្គិសនី បាន វិល ត្រឡប់ មក ទីក្រុង វិញ រវាង ម៉ោង ១១ និង ១២ ថ្ងៃ ត្រង់ កាល ពី ថ្ងៃ ចន្ទ ។
លោក វង្ស សុវណ្ណ បាន ថ្លែង បន្ត ថា ក្នុង កិច្ច ប្រជុំ ជាមួយ រដ្ឋាភិបាល កាលពី ថ្ងៃ ចន្ទ សមាគម រោងចក្រ កាត់ ដេរ នៅ កម្ពុជា បាន ដំឡើង សំណើ ដល់ ៧០ ដុល្លារ ឬ ៧៥ ដុល្លារ ដោយ បូក ជាមួយ ប្រាក់ ឧបត្ថម្ភ ទ្រទ្រង់ សុខភាព ។
អគ្គ លេខាធិការ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា លោក ខេន លូ ថ្លែង ថា សមាគម គ្មាន លទ្ធភាព ផ្តល់ ឲ្យ ៩០ ដុល្លារ ទេ ។
លោក អាត់ ធន ប្រធាន សម្ព័ន្ធ សហជីព ប្រជាធិបតេយ្យ កម្មករ កាត់ ដេរ កម្ពុជា ហៅ ស៊ី ខៅ ឌូ បាន ថ្លែង ថា សហជីព នឹង ប្រកាន់ ជំហរ ១០០ ដុល្លារ ក្នុង ១ខែ ហើយ កម្មករ នឹង ធ្វើ កូដកម្ម បើ សំណើ នេះ មិន ត្រូវ បាន ផ្តល់ ឲ្យ នោះ ។
ឃាត់ខ្លួនក្រុមយុទ្ធនាការ សម្លៀក បំពាក់ស្អាត ៥ នាក់
លោក នូវ សាខ ន អនុ ប្រធាន នគរបាល អន្តោ ប្រវេសន៍ ខេត្ត កណ្តាល បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា មាន ស្រ្តី បួន នាក់ និង បុរស ម្នាក់ មក ពី ប្រទេស ន័រវែស បែលហ្ស៊ិក អង់គ្លេស និង ប្រទេស អូទ្រីស ត្រូវ ឃាត់ ខ្លួន នៅ ខាង ក្រៅ រោងចក្រ អ៊ីហ្គាមេន បន្ទាប់ ពី ពួក គេ ប្រើប្រាស់ មីក្រូហ្វូន ដើម្បី និយាយ ទៅ កាន់ កម្មករ ដែល កំពុង នាំ គ្នា ធ្វើ កូដកម្ម ។
លោក មឿន តុលា ប្រធាន កម្មវិធី ការងារ នៅ មជ្ឈមណ្ឌល អប់រំ ច្បាប់ សម្រាប់ សហគមន៍ បាន ធ្វើ ការ ចោទ សួរ ទៅ នឹង សំណួរ របស់ នគរបាល ដែល ទាមទារ សុំ លិខិត ឆ្លង ដែន របស់ ពួក គេ ។
លោក បន្ថែម ថា ពុំ ទាន់ មាន បុគ្គលិក ផ្សេង ទៀត ចូល រួម ជាមួយ ពួក គេ ទេ ប៉ុន្តែ លោក កត់ សម្គាល់ ថា៖
តាម កិច្ច ព្រមព្រៀង អង្គការ សហ ប្រជាជាតិ និង កម្ពុជា ដែល បាន បង្កើត តុលាការ ឆ្នាំ ២០០៣ ប្រាក់ ខែ បុគ្គលិក ជាតិ ទទួល ខុស ត្រូវ ដោយ រដ្ឋាភិបាល កម្ពុជា ។
ប៉ុន្តែ ការិយាល័យ ប្រឆាំង បទ ល្មើស ជួញ ដូរ មនុស្ស និង ការពារ អនីតិជន ខេត្ត កំពង់ឆ្នាំង នៅ បន្ត ការ ស៊ើប អង្កេត លើ សំណុំ រឿង នេះ ដែរ ។
អ្នក បកប្រែសាលា ក្តីខ្មែរក្រហមធ្វើកូដ កម្មផ្អាកការងារទាមទារបើកប្រាក់ខែ
លោក នេត្រ ភក្ត្រា មន្ត្រី នាំ ពាក្យ នៅ សាលា ក្តី ខ្មែរ ក្រហម បាន ថ្លែង ថា កិច្ច ប្រជុំ រវាង អ្នក បកប្រែ ប្រហែល ៣០ នាក់ និង ថ្នាក់ គ្រប់គ្រង របស់ សាលា ក្តី នេះ ក្នុង ម៉ោង នៅ សល់ មិន មាន ដំណោះស្រាយ ទេ មាន ន័យ ថា សវនាការ ត្រូវ ពន្យារ ពេល ដោយ គ្មាន កំណត់ ។
សេចក្តី ប្រកាស នេះ និង សេចក្តី ថ្លែង បញ្ចប់ របស់ តុលាការ ត្រូវ បាន បកប្រែ ដោយ អ្នក បកប្រែ គ្រា អាសន្ន ពីរ នាក់ ដែល មិន ធ្វើ កូដកម្ម ដែល បាន ផ្តល់ សេវា បកប្រែ សវនាការ រវាង ភាសា អង់គ្លេស និង ខ្មែរ ក្នុង ពេល ២០ នាទី តែ ប៉ុណ្ណោះ ។
មុន ផ្អាក ចៅក្រម បដិសេធ សំណើ របស់ លោក នួន ជា ដែល សុំ ចេញ ពី សវនាការ ដោយ សារ មូលហេតុ សុខភាព ដោយ ថ្លែង ថា លោក មាន សុខភាព ល្អ គ្រប់គ្រាន់ នឹង ចូលរួម ពី បន្ទប់ ឃុំឃាំង ។
លោក ត្រូវ បញ្ជូន យ៉ាង ប្រញាប់ ទៅ មន្ទីរពេទ្យ ដោយ សារ អាការ ក្អួត និង រាក » ។
តែ លោក កត់ សម្គាល់ ថា កូដកម្ម អ្នក បក ប្រែ អាច ធ្វើ ឲ្យ បញ្ហា មិន មែន ជា បញ្ហា ពាក់ព័ន្ធ ។
ដោយ ពុំ មាន ថវិកា បន្ថែម ឲ្យ បុគ្គលិក សាលា ក្តី ខ្មែរ ក្រហម ឯ ទៀត នៅ ផ្នែក ខាង កម្ពុជា ទាំងអស់ ២៧០ នាក់ ដែល មិន បាន ទទួល ប្រាក់ ខែ បី ខែ ហើយ នឹង ចូលរួម កូដកម្ម ជាមួយ ក្រុម បុគ្គលិក ផ្នែក បក ប្រែ ឆាប់ ៗ នេះ ។
បុគ្គលិក ខាង ជាតិ បាន អំពាវនាវ ទៅ ប្រទេស ម្ចាស់ ជំនួយ ឲ្យ ធ្វើ ការ ផ្តល់ ជំនួយ ដូច ដែល ពួក គេ បាន សន្យា កាល ពី ខែ មុន សម្រាប់ ថវិកា ឆ្នាំ ២០១៣ ។
លោក ឯក ថា អ្នក នាំ ពាក្យ ម្នាក់ នៅ អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ទីស្ដីការ គណៈ រដ្ឋ មន្ត្រី បាន ថ្លែង ថា ថវិកា នេះ ធ្វើ ឲ្យ ខាង កម្ពុជា ខ្វះ ប្រហែល ៧លាន ដុល្លារ ។
លោក អ៊ុយ វ៉ន សមាជិក ក្រុម ប្រឹក្សា ឃុំ ត្រពាំង គង ខេត្ត កំពង់ស្ពឺ បាន ថ្លែង ថា៖
ជំរឿន ចុង ក្រោយ បាន ធ្វើ ឡើង ក្នុង ឆ្នាំ ២០០៨ ហើយ ជំរឿន បន្ទាប់ នឹង ធ្វើ ឡើង ក្នុង ឆ្នាំ ២០១៨ ។
ជំរឿន នេះ នឹង ប្រមូល ព័ត៌មាន ស្តីពី ជីវភាព រស់ នៅ សុខភាព និង ចំណាក ស្រុក ក្នុង ចំណោម បញ្ហា ដទៃ ទៀត ។
លោក បន្ថែម ថា ភាព រុងរឿង និង សុខុមាលភាព របស់ ប្រជាជន គឺ ពឹង ផ្អែក ទៅ លើ សេចក្តី សម្រេច របស់ រដ្ឋាភិបាល ក្នុង ការ គ្រប់គ្រង ថវិកា ជាតិ ដោយ តាម រយៈ ការ ប្រមូល ប្រាក់ ចំណូល និង ការ ចំណាយ បាន ត្រឹមត្រូវ ។
តំណាង រាស្រ្ត គណបក្ស សម រង្ស៊ី លោក សុន ឆ័យ បាន ថ្លែង ថា តំណាង រាស្រ្ត គណបក្ស ប្រឆាំង មិន ត្រូវ បាន អញ្ជើញ ឲ្យ ចូល រួម សិក្ខា សាលា នេះ ទេ ហើយ ជាង នេះ ទៀត ប្រទេស ដែល ត្រូវ បាន អញ្ជើញ ឲ្យ ចូល រួម គឺជា ប្រទេស ដែល មិន មែន ជា គំរូ ល្អ សម្រាប់ រដ្ឋាភិបាល ដែល មាន តម្លាភាព ទេ ។
ជំនុំ ជម្រះសំណុំរឿងអ្នក កាសែត វរ ជនខ្មែរ
លោក ឆាយ ធី អ្នក សម្រប សម្រួល សមាគម សិទ្ធិ មនុស្ស អាដហុក បាន ថ្លែង ថា សវនាការ ពេញ ១ ថ្ងៃ នេះ មាន កម្លាំង នគរបាល ប្រមាណ ៣០ នាក់ យាម កាម ហើយ មាន ការ សាកសួរ ជន ត្រូវ ចោទ ពីរ នាក់ ប្តី ប្រពន្ធ ដើម ចោទ ២នាក់ ជា ភរិយា អ្នក កាសែត និង ម្តាយ ជន រងគ្រោះ នគរបាល ស្រា វ ជ្រាវ រឿង ក្តី ព្រម ទាំង សាក្សី ចំនួន ៥ នាក់ ដែល ពាក់ព័ន្ធ រឿង នេះ ។
អ្នក កាសែត ហង្ស សេរី ឧត្តម អាយុ ៤៤ ឆ្នាំ ត្រូវ គេ ប្រទះ ឃើញ សាកសព មាន ស្នាម កាប់ របួស ជាច្រើន លើ មុខ និង ដង ខ្លួន នៅ ក្នុង គូទ រថយន្ត ម៉ាក តូយ៉ូតា កាមរី ស៊េរី ១៩៩៦ ពណ៌ ស្លែ របស់ លោក នៅ ក្នុង ចម្ការ ស្វាយ ចន្ទី ក្នុង ឃុំ ចា អ៊ុង ស្រុក អូរ ជុំ ប្រមាណ ១០ គីឡូ ម៉ែត្រ ពី ទី រួម ខេត្ត រតនគិរី ។
លោក ឆាយ ធី បន្ត ថា ចៅក្រម ក៏ សាកសួរ លោក គឹង ស៊ាង ឡៃ មន្ត្រី រាជ អាវុធហត្ថ ដែល ជា កូន មេ បញ្ជាការ រាជ អាវុធ ហត្ថ ខេត្ត ដែល ចម្លើយ គាត់ មាន ការ ខុស គ្នា នឹង ចម្លើយ ក្នុង កំណត់ ហេតុ របស់ ចៅក្រម ស៊ើបសួរ ។
បន្ទាប់ មក គណកម្មការ ចម្រុះ បាន ចុះ មក ពិនិត្យ ដល់ កន្លែង កើត ហេតុ ហើយ បាន ស្រុះ ស្រួល គ្នា ឲ្យ ក្រុមហ៊ុន នេះ បញ្ឈប់ ការ ឈូស ដី លុប បឹង នេះ ។
អគ្គ លេខាធិការ សមាគម អ្នក ប្រជាធិបតេយ្យ លោក ហួន បញ្ញា រី បាន ថ្លែង ថា មនុស្ស ជាង ១០០០ នាក់ ត្រូវ បាន រំពឹង ថា នឹង មក ចូល រួម គាំទ្រ លោក ម៉ម សូណង់ ដូ ។
សហរដ្ឋ អាមេរិក បារាំង និង សហគមន៍ អឺរ៉ុប បាន ធ្វើ ការ ទាម ទារ ម្តង ហើយ ម្តង ទៀត ឲ្យ ធ្វើ ការ ដោះ លែង លោក សូណង់ ដូ ដោយ គ្មាន លក្ខខណ្ឌ ។
លោក សូណង់ ដូ ត្រូវ បាន ចោទ ប្រកាន់ ថា ជា មេ គំនិត បង្កើត ចលនា តំបន់ អបគមន៍ ក្នុង ខេត្ត ក្រចេះ ប៉ុន្តែ ក្រុម អ្នក រិះគន់ បាន ហៅ ការ ចោទ ប្រកាន់ នេះ ថា ជា លេស លើក ឡើង ដោយ អាជ្ញាធរ ដើម្បី បណ្តេញ ប្រជាជន រាប់ រយ គ្រួសារ ចេញ ពី ដី ធ្លី នៅ ក្នុង ការ ចុះ បង្ក្រាប កាល ពី ខែ មេសា ដែល បាន បណ្តាល ឲ្យ ក្មេង ស្រី អាយុ ១៤ ឆ្នាំ ម្នាក់ បាន ស្លាប់ ។
សាលា ដំបូង រាជធានី បាន បើក សវនាការ រយៈ ពេល បី ថ្ងៃ ដោយ ហៅ សាក្សី រាប់ សិប នាក់ ចូល រួម ផ្តល់ សក្ខីកម្ម ប៉ុន្តែ ត្រូវ បាន ក្រុម សិទ្ធិ មនុស្ស បញ្ជាក់ ថា ជា ភ័ស្តុតាង ដែល មិន អាច ជឿជាក់ បាន ។
នៅ ក្នុង សេចក្តី ថ្លែងការណ៍ មួយ ចេញ កាល ពី មិ្សល មិញ អង្គការ លើក លែង ទោស អន្តរជាតិ បាន ហៅ ការ កាត់ ទោស នោះ ថា « មាន លក្ខណៈ មិន ធម្មតា ចម្លែក និង គ្មាន មូលដ្ឋាន » ហើយ បាន ជំរុញ ឲ្យ សាលា ឧទ្ធរណ៍ ច្រានចោល សេចក្តី សម្រេច របស់ សាលា ដំបូង រាជធានី ។
ខ្ញុំ សង្ឃឹម ថា សាលា ឧទ្ធរណ៍ នឹង ពិនិត្យ ភ័ស្តុតាង និង ឯកសារ ទាំង អស់ ឡើង វិញ ។
ខ្ញុំ សង្ឃឹម ថា សាលា ឧទ្ធរណ៍ នឹង ដំណើរ ការ សវនាការ របស់ ខ្លួន ឲ្យ មាន ភាព យុត្តិធម៌ » ។
លោក សោម សុវណ្ណ នី អាយុ ៤៧ ឆ្នាំ តំណាង ពលរដ្ឋ បាន ថ្លែង ថា ពួក លោក មក ស្នើ សុំ ឲ្យ ជួយ ទប់ស្កាត់ ការ បណ្តេញ ចេញ ពី លំនៅដ្ឋាន ។
លោក ស ចំរ៉ុង អភិបាល ខេត្ត ក្រចេះ បាន ថ្លែង កាលពី ម្សិលមិញ ថា លោក បាន ប្រគល់ ភារកិច្ច នេះ ឲ្យ លោក ខាត់ ចំណាន អភិបាល រង ខេត្ត ទទួល បន្ទុក ដោះស្រាយ ។
លោក ចាន់ សូវ៉េត មន្ត្រី ស៊ើប អង្កេត អង្គការ អាដហុក បាន ថ្លែង ថា អាជ្ញាធរ គួរ ដោះស្រាយ តាម របៀប មាន ការ ព្រមព្រៀង ទាំង សង ខាង មិន គួរ មាន ការ បង្ខិតបង្ខំ ទៅ លើ ប្រជាពលរដ្ឋ នោះ ទេ ៕
លោកនាយករដ្ឋមន្ត្រីរិះគន់អង្គការ សហ ប្រជាជាតិ
បន្ទាប់ ពី វៀតណាម បាន ចូល កម្ពុជា ដើម្បី ផ្តួល រំលំ ខ្មែរ ក្រហម ក្នុង ឆ្នាំ ១៩៧៩ បាន ធ្វើ ឲ្យ ប្រទេស លោក ខាង លិច ជា ច្រើន ដាក់ ទណ្ឌកម្ម សេដ្ឋកិច្ច ជាង មួយ ទស្សវត្សរ៍ មក លើ ប្រទេស កម្ពុជា ។
ដោយ មាន ការ គាំទ្រ ពី អាមេរិក អង់គ្លេស និង ប្រទេស ផ្សេង ទៀត អង្គការ សហ ប្រជា ជាតិ បាន អនុញ្ញាត ឲ្យ ខ្មែរ ក្រហម បន្ត កាន់ កាប់ អាសនៈ កម្ពុជា នៅ អង្គការ សហ ប្រជាជាតិ អស់ ជា ច្រើន ឆ្នាំ បន្ទាប់ ពី របប ប្រល័យ ពូជ សាសន៍ ដួល រលំ ។
ប៉េអឹមឃាត់ខ្លួនជន សង្ស័យពាក់ព័ន្ធករណីរំលោភបូក
លោក ទេព វណ្ណឌីណា ជា នគរបាល ប៉ុស្តិ៍ កោះ ដាច់ បាន ប្រាប់ ថា ពាក់ព័ន្ធ នឹង ករណី រំលោភ នារី វ័យ ២០ ឆ្នាំ នេះ កាល ពី រសៀល ថ្ងៃ ទី៣ ខែ មីនា សមត្ថកិច្ច នគរបាល ប៉ុស្តិ៍ សង្កាត់ កោះ ដាច់ ខណ្ឌ ឫស្សីកែវ បាន ធ្វើ ការ ឃាត់ ខ្លួន ជន សង្ស័យ ចំនួន ៣ នាក់ មក សាក សួរ ដែល ក្នុង ជន សង្ស័យ ទាំង នោះ ត្រូវ បាន នារី រង គ្រោះ ចង្អុល ទៅ លើ តែ ជន ម្នាក់ ថា បាន ចាប់ រំលោភ នាង ។
លោក ទូច គង្គា នាយ ការិយាល័យ ព័ត៌មាន ទូទៅ និង សន្តិសុខ កងរាជ អាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ពី ម្សិលមិញ បាន ឲ្យ ដឹង ថា ទំនិញ ដែល សមត្ថកិច្ច ចម្រុះ ឃាត់ បាន ចំនួន ៤ ឡាន យីឌុប កាលពី ថ្ងៃទី ៣ មីនា នៅ ក្នុង ស្រុក កំពង់ សិលា ខេត្ត ព្រះសីហនុ ត្រូវ គណៈកម្មការ ចម្រុះ មាន កងរាជ អាវុធហត្ថ លើ ផ្ទៃ ប្រទេស មន្ត្រី គយ ស្រុក កំពង់ សិលា និង ព្រះរាជអាជ្ញា បើក ការ ស៊ើប អង្កេត រួច រាល់ ពី ម្សិលមិញ ។
ដូច្នេះ បន្ទាប់ ពី គណៈកម្មការ ចម្រុះ ពិនិត្យ ហើយ ក៏ បាន រក្សា ទុក នៅ ស្នាក់ ការ គយ ក្នុង ស្រុក ស្រែ អំបិល ដើម្បី ឲ្យ ខាង ក្រុមហ៊ុន ចូល បង់ ពន្ធ ទៅ តាម នីតិវិធី ច្បាប់ » ។
មិន អាច ទាក់ទង លោក ឧត្តម សេនីយ៍ ផ្កាយ បី ឡុង ម៉េង ដែល មន្ត្រី កង រាជអាវុធហត្ថ អះអាង ថា ម្ចាស់ ទំនិញ គេច ពន្ធ នេះ បាន ទេ កាលពី ម្សិលមិញ ៕
គោ យន្តកិនមីន តោននៅអន្លង់វែងផ្ទុះ របួសបួននាក់
ក្មេង ស្រី រង ការ រំលោភ បាន និយាយ ថា នាង ជា អតីត ក្មេង អនាថា នៅ ក្នុង រាជ ធានី ភ្នំពេញ ហើយ ត្រូវ អង្គការ មិត្ត សម្លាញ់ នាំ យក មក ចិញ្ចឹម និង ស្នាក់ នៅ ក្នុង មណ្ឌល អង្គការ នេះ កាល ពី ដើម ឆ្នាំ ២០០៥ ។
នាង រៀប រាប់ ថា៖
ព្រះសង្ឃ និមន្ត ប្រោះព្រំកម្ចាត់ឧបទ្រពខណៈតុលាការ សម្រេចឃុំនិស្សិតស្រីបង្កហេតុ
តាម ការ ឲ្យ ដឹង ពី សមត្ថកិច្ច ប៉ូលិស កាន់ សំណុំ រឿង ថា និស្សិត ពេទ្យ គាម ពិសិដ្ឋ ណារី តា ជា កូន របស់ លោក គាម ពិសិដ្ឋ អនុប្រធាន មន្ទីរពេទ្យ ខេត្ត កណ្តាល ដែល បាន មក អះអាង ថា កូន គាត់ មាន បញ្ហា សរសៃ ប្រសាទ និង ធ្វើ ទុក្ខ ម្តង ម្កាល ប៉ុន្តែ តាម ខាង សមត្ថកិច្ច ពិនិត្យ ដូច ជា គ្មាន បញ្ហា អ្វី ទេ ។
តាម សមត្ថកិច្ច រំឭក ឲ្យ ដឹង ថា និស្សិត ពេទ្យ ឆ្នាំ ទី៦ ឈ្មោះ គាម ពិសិដ្ឋ ណារី តា ភេទ ស្រី អាយុ ២៣ ឆ្នាំ បាន បើក ឡាន បុក រះ ម៉ូតូ ៩ គ្រឿង និង កង់ ៤ គ្រឿង បណ្តាល ឲ្យ កុមារ ៣នាក់ ស្លាប់ ភ្លាម និង របួស មនុស្ស ៨នាក់ ផ្សេង ទៀត ។
កញ្ញា វត្តី និស្សិត សាកល វិទ្យាល័យ បៀល ប្រាយ និយាយ ថា៖
លោក បន្ថែម ថា ការ អភិវឌ្ឍ ប្រទេស ត្រូវ តែ មាន ផ្នែក វប្បធម៌ រួម បញ្ចូល ក្នុង ការ អភិវឌ្ឍ ប្រទេស ។
ទន្ទឹម នេះ លោក ហ៊ុន សែន ក៏ បាន ជំរុញ ទៅ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បើក វគ្គ បណ្តុះ បណ្តាល សម្រាប់ ផលិត ករ អ្នក ផលិត ភាពយន្ត អ្នក និពន្ធ ឬ សិល្បករ ដើម្បី ឲ្យ មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការ សរសេរ និង ផលិត ខ្សែ ភាព យន្ត ឲ្យ ប្រសើរ ជាង មុន ដើម្បី ទប់ មិន ឲ្យ មាន ការ ហូរ ចូល វប្បធម៌ ពី ប្រទេស ដទៃ ៗ ។
ទន្ទឹម នេះ លោក ហ៊ុន សែន បាន អះអាង ថា រដ្ឋាភិបាល នៅ តែ រក្សា ជំហរ បង្រួប បង្រួម ខ្មែរ ទាំង អស់ ពី គ្រប់ និន្នាការ នយោបាយ ដើម្បី រក្សា ការពារ និង អភិវឌ្ឍ វប្បធម៌ ដើម្បី ឲ្យ កម្ពុជា មាន កេរ្តិ៍ ឈ្មោះ ត្រ ចេះ ត្រចង់ លើ ឆាក អន្តរ ជាតិ ។
លោក បន្ថែម ថា ទាំង ស្ថានីយ ទូរទស្សន៍ រដ្ឋ និង ឯក ជន ចាំបាច់ ត្រូវ ចូល រួម ក្នុង ការ លើក កម្ពស់ វប្បធម៌ ជាតិ តាម រយៈ ការ ផលិត កម្មវិធី រាប់ បញ្ចូល នូវ ចម្រៀង ប្រពៃណី របាំ និង ការ សម្តែង យ៉ាង ហោច ណាស់ ពី១ ទៅ ២ ម៉ោង ក្នុង មួយ សប្តាហ៍ ។
លោក នាយក រដ្ឋ មន្រ្តី ថ្លែង ថា កម្ពុជា មាន មោទនភាព ចំពោះ វប្បធម៌ របស់ ខ្លួន ព្រោះ បេតិកភណ្ឌ វប្បធម៌ រូបី អរូបី ជាច្រើន មាន កេរ្តិ៍ ឈ្មោះ ល្បីល្បាញ ជា អន្តរជាតិ ហើយ បេតិកភណ្ឌ មួយ ចំនួន ត្រូវ បាន ចុះ បញ្ជី ជា បេតិកភណ្ឌ ពិភពលោក ដូច ជា ឧទ្យាន អង្គរ ល្ខោន ស្បែក ធំ និង ប្រាសាទ ព្រះវិហារ ។
ទន្ទឹម នឹង នេះ លោក ហ៊ុន សែន បាន ប្រាប់ អ្នក និពន្ធ និង សិល្បករ ថា ចាំបាច់ ត្រូវ ខិតខំ បង្ការ ការ ហូរ ចូល នូវ វប្បធម៌ បរទេស អវិជ្ជមាន និង ជំរុញ ពួក គេ ចៀស វាង លួច ចម្លង សិទិ្ធ អ្នក និពន្ធ ព្រោះ វា ជា បទល្មើស ។
ដើម្បី រៀន ឲ្យ បាន ទាន់ គេ សុវណ្ណារ៉ា ត្រូវ នៅ ដល់ ពាក់ កណ្តាល អ្រធាត្រ ដើម្បី រំឭក មេ រៀន ឡើង វិញ ។
សុវណ្ណារ៉ា បាន ថ្លែង ថា៖
ការ វិនិយោគ ទាំង នេះ ផ្តោត ភាគ ច្រើន លើ វិស័យ ថាមពល ធនធាន រ៉ែ រោងចក្រ កាត់ ដេរ ធនាគារ ហិរញ្ញវត្ថុ អចលន វត្ថុ ទេសចរណ៍ និង កសិកម្ម ។
ទេសចរណ៍ ជា វិស័យ មួយ ទៀត ដែល ត្រូវ ការ មគ្គុទ្ទេសក៍ និយាយ ភាសា ចិន ។
ការ លក់ ឡៃ ឡុង ទ្រព្យ សម្បតិ្ត របស់ ក្រុមហ៊ុន ដែល គាំទ្រ ដោយ រដ្ឋាភិបាល ត្រូវ បាន រំពឹង ថា នឹង បាន ប្រាក់ ប្រហែល ៦០០០០ ដុល្លារ ដែល នឹង បង់ សង ប្រាក់ ឈ្នួល នៅ សល់ ដល់ ក្រុម កម្មករ ។
លោក បាន បន្ថែម ថា គណៈ កម្មាធិការ នោះ មាន សមាជិក ជា តំណាង មក ពី មជ្ឈមណ្ឌល អាមេរិក ដើម្បី សាមគ្គី ភាព ពលកម្ម អន្តរជាតិ អង្គការ ពលកម្ម អន្តរជាតិ និង មជ្ឈមណ្ឌល អប់រំ ច្បាប់ សម្រាប់ សហគមន៍ ហើយ នឹង វាយ តម្លៃ ពាក្យ ទាមទារ ប្រាក់ ឈ្នួល ហើយ លោក បាន បន្ត ថា ប្រាក់ នឹង ត្រូវ បែង ចែក ក្នុង រយៈ ពេល ២ សប្តាហ៍ ។
ផ្លូវ ច្បាប់ តឹងរ៉ឹង ពុំ នាំ យើង ទៅ ទីណា ឡើយ ។
វា ជា ប្រវតិ្តសាស្រ្ត ប៉ុន្តែ វា មិន មែន ជា វិធី ល្អ បំផុត ក្នុង ការ ធ្វើ ដំណើរ ឆ្ពោះ ទៅ មុខ ទេ ។
លោក បន្ថែម ថា មជ្ឈមណ្ឌល អប់រំ ច្បាប់ សម្រាប់ សហគមន៍ មាន បញ្ជី កម្មករ ចំនួន ១៦១ នាក់ ប៉ុន្តែ ជឿ ជាក់ ថា កម្មករ ជាង ២០០ នាក់ បាន ធ្វើ ការ នៅ រោងចក្រ នេះ ។
សមាគម រោងចក្រ កាត់ ដេរ នៅ កម្ពុជា ពុំ បាន ចូល រួម ក្នុង កិច្ច ប្រជុំ នេះ ទេ ។
ចាប់ឃុំខ្លួនបុរស ៣ នាក់ពី បទកាប់ រានដីព្រៃរដ្ឋ
ការ ចុះ បង្រ្កាប ករណី កាប់ រាន ដី ព្រៃ រដ្ឋ កាល ពី ថ្ងៃ ព្រហស្បតិ៍ ត្រូវ បាន ធ្វើ ឡើង ដោយ កម្លាំង ចម្រុះ ។
លោក ពន្យល់ ថា តាម ធម្ម នុញ្ញ អង្គការ សហ ប្រជាជាតិ សកម្ម ភាព បែប នេះ បាន បំពាន សិទ្ធិ កុមារ ហើយ ដែល ត្រូវ រាជ រដ្ឋាភិបាល កម្ពុជា ហាម ឃាត់ ផង ដែរ ។
ឈ្មោះ ទួន បុរាណ ប្រធាន អង្គការ កុមារ មួយ នេះ មិន អាច ទាក់ ទង បញ្ជាក់ ជុំវិញ ការ ចោទ ប្រកាន់ រូប លោក បាន ទេ កាល ពី ម្សិល មិញ ៕
លោក នេត វន្ថា បន្ត ថា ករណី នេះ បណ្តាល ម ក ពី ការ ទុស្សេ ខ្សែ ភ្លើង ព្រោះ នៅ តំបន់ នោះ ការ ត ចរន្ត ខ្សែ ភ្លើង គ្មាន សណ្តាប់ធ្នាប់ មាន ភាព រញ៉េរញ៉ៃ ដូច្នេះ ងាយ បង្ក ឲ្យ ករណី នេះ កើត ឡើង ។
របាយការណ៍ ក៏ បញ្ជាក់ ដែរ ថា នៅ មាន ពលករ ចំណាក ស្រុក ជនជាតិ កម្ពុជា ចំនួន ៤០ ម៉ឺន នាក់ បាន ឆ្លង ដែន ចូល ទៅ រក ការងារ ធ្វើ ក្នុង ប្រទេស ថៃ ក្នុង ឆ្នាំ ២០១២ ។
បើ យោង តាម របាយការណ៍ ដដែល នោះ អង្គការ សិទ្ធិ មនុស្ស អាដហុក បាន ដោះស្រាយ ករណី ទទួល រង ការ ជួញដូរ ក្នុង ផ្នែក ការងារ ចំនួន ៧៤ ករណី ក្នុង ឆ្នាំ ២០១២ គឺ កើន ឡើង ចំនួន ២០ ករណី ជាង ពី ឆ្នាំ ២០១១ ។
អ្នកស្រី វង្ស ធារី ដែល រស់ នៅ ក្នុង ខណ្ឌ ឫស្សីកែវ បាន ថ្លែង នៅ ក្នុង សន្និសីទ កាសែត របស់ សមាគម សិទ្ធិ មនុស្ស អាដហុក ពី ម្សិលមិញ ថា ប្តី គាត់ នៅ តែ វ៉ៃ ដំ បើ ទោះ ជា គាត់ ពិការ ជើង ហើយ ក្តី ។
លោក អោ សុគង់ តំណាង កម្មករ បាន ថ្លែង កាល ពី ម្សិលមិញ ថា ៖
លោក សឹង ម៉ុន សមាជិក គណៈ កម្ម ការ ដោះ ស្រាយ កូដកម្ម បាតុកម្ម គ្រប់ មុខ សញ្ញា ថ្លែង ថា រដ្ឋាភិបាល ក៏ មិន ចង់ ឲ្យ មាន បញ្ហា កូដកម្ម ដូច្នេះ ដែរ តែ នេះ ជា សិទ្ធិ របស់ កម្មករ ពីព្រោះ ថៅ កែ បាន រត់ ចោល រោងចក្រ ។
មាត្រា ២ នៃ សំណើ ច្បាប់ នេះ បាន កំណត់ ប្រាក់ បៀវត្សរ៍ អប្បបរមា ចំនួន ១ លាន រៀល ( ២៥០ ដុល្លារ អាមេរិក ) ក្នុង មួយ ខែ សម្រាប់ មន្រ្តី រាជ ការ គ្រូ បង្រៀន និង កង ប្រដាប់ អាវុធ ហើយ តួលេខ ត្រូវ ដំឡើង ជា បន្ត បន្ទាប់ ផ្អែក លើ ស្ថានការណ៍ អភិវឌ្ឍ សេដ្ឋកិច្ច និង តម្រូវ ការ ចាំបាច់ ក្នុង ការ រស់ នៅ ។
ចំពោះ ប្រាក់ ឈ្នួល កម្មករ វិញ មាត្រា ៤ បាន កំណត់ ប្រាក់ ឈ្នួល អប្បបរមា ចំនួន ៦០ ម៉ឺន រៀល ( ១៥០ ដុល្លារ អាមេរិក ) ក្នុង មួយ ខែ សម្រាប់ រាល់ កម្មករ ទាំង អស់ ។
នា ពេល បច្ចុប្បន្ន ប្រាក់ ខែ គោល របស់ កម្មករ គឺ ៦១ ដុល្លារ ក្នុង មួយ ខែ ហើយ ប្រាក់ បៀវត្សរ៍ មន្រ្តី រាជការ ជា មធ្យម ប្រហែល ពីរ ៧០ ទៅ ១៥០ ដុល្លារ ក្នុង មួយ ខែ ខណៈ តម្លៃ ទំនិញ នៅ លើ ទីផ្សារ និង តម្លៃ ប្រេង សាំង បាន ហក់ ឡើង ឥត ឈប់ ឈរ ។
លោក យឹម សុវណ្ណ អ្នក នាំ ពាក្យ គណបក្ស សម រង្ស៊ី បាន ថ្លែង ថា គណបក្ស ប្រឆាំង បាន ពិចារណា យ៉ាង ហ្មត់ចត់ ក្នុង ការ ទាមទារ ឲ្យ រដ្ឋាភិបាល ដំឡើង ប្រាក់ ឈ្នួល សម្រាប់ កម្មករ ។
លោក បាន បន្ថែម ថា ការ ដំឡើង ប្រាក់ ឈ្នួល ដល់ កម្មករ ពុំ ប៉ះពាល់ ដល់ ថវិកា ជាតិ ទេ តែ វា កាត់ បន្ថយ ប្រាក់ ចំណេញ របស់ ម្ចាស់ រោងចក្រ តែ ប៉ុណ្ណោះ ។
លោក បាន លើក ឡើង ថា រដ្ឋាភិបាល លោក ហ៊ុន សែន បាន ដំឡើង ប្រាក់ បៀវត្សរ៍ ២០ ភាគរយ ដល់ មន្រ្តី រាជ ការ រៀងរាល់ ឆ្នាំ ។
ចំណែក ទំនិញ ឡើង ថ្លៃ គឺ ដោយ សារ តែ ការ ប្រកួត ប្រជែង ក្នុង ទីផ្សារ ។
លោក បន្ត ថា ជា សមាជិក គណៈ កម្មាធិការ អចិន្រៃ្តយ៍ រដ្ឋ សភា លោក នឹង រង់ចាំ មើល សំណើ ច្បាប់ របស់ គណបក្ស ប្រឆាំង ហើយ នឹង បញ្ជូន វា ទៅ អ្នក ជំនាញ ដើម្បី សិក្សា ។
លោក បញ្ជាក់ ថា ប្រសិន បើ មើល ឃើញ ថា សំណើ នេះ ពុំ ស្រប នឹង ស្ថានការណ៍ បច្ចុប្បន្ន សំណើ នេះ នឹង ត្រូវ ច្រាន ចោល ៕
លោក បាន បន្ត ថា មាន សត្វ ត្មាត ៤ ប្រភេទ គឺ ត្មាត ភ្លើង ត្មាត ប្រផេះ ត្មាត ត្នោត និង ត្មាត ខ្មៅ ។
ហេតុ នេះ ទើប ខិតខំ រក ជំនួយ និង សហការ ជាមួយ នឹង អង្គការ នានា ដើម្បី បង្វែ ការ បរ បាញ់ របស់ ពលរដ្ឋ មក អភិរក្ស ជាមួយ គ្នា វិញ ។
លោក ស៊ូ ម៉េត ត្រូវ បាន គេ ជឿ ថា បាន គ្រប់គ្រង មជ្ឈមណ្ឌល សន្តិសុខ និង ត្រួត ពិនិត្យ លើ ការ សាង សង់ អាកាស យានដ្ឋាន កំពង់ ឆ្នាំង ដែល នៅ ទីនោះ កម្មករ បាន ស្លាប់ ដោយ សារ ភាព អត់ ឃ្លាន និង ការ បាក់ កម្លាំង ហើយ ការ ធ្វើ អត្តឃាត បាន កើត ឡើង ជា រៀង រាល់ សប្តាហ៍ ។
ថ្លែង ទៅ កាន់ មន្រ្តី រដ្ឋាភិបាល ជាន់ ខ្ពស់ និង ព្រះ សង្ឃ ចំនួន ប្រមាណ ៥០០ អង្គ ក្នុង អំឡុង ពិធី បិទ សន្និសីទ ពុទ្ធសាសនា ប្រចាំ ឆ្នាំ នៅ មហោស្រព ចតុមុខ លោក នាយក រដ្ឋ មន្រ្តី បាន កត់ សម្គាល់ ថា ប្រជាជន កម្ពុជា ជា ច្រើន ជា ធម្មតា មិន មាន ពេលវេលា ស្តាប់ ធម៌ ទេសនា ដែល ចាក់ ផ្សាយ ជា រៀង រាល់ ថ្ងៃ នៅ តាម ទូរទស្សន៍ ឬ វិទ្យុ ទេ ។
លោក នាយក រដ្ឋ មន្រ្តី បន្ទាប់ មក បាន សុំ ឲ្យ ក្រសួង ព័ត៌មាន និង ក្រសួង ធម្មកា និង សាសនា រួម ទាំង ស្ថាប័ន រដ្ឋាភិបាល ពាក់ព័ន្ធ ផ្សេង ទៀត ស្វែង រក វិធី អនុវត្ត តាម អនុសាសន៍ របស់ លោក ។
លោក រ៉ុង ឈុន ប្រធាន សមាគម គ្រូ បង្រៀន កម្ពុជា ឯករាជ្យ បាន ថ្លែង ថា លោក គាំទ្រ គំនិត នេះ ប៉ុន្តែ បាន ជំរុញ ឲ្យ លោក នាយក រដ្ឋ មន្រ្តី ទទួល យក ការ អប់រំ នៅ ក្នុង ធម៌ ទេសនា ចូល ទៅ ក្នុង បេះដូង របស់ ខ្លួន ។
ក្រុម គ្រួសារ ជន រងគ្រោះ មិន អាច ទាក់ទង សុំ ការ បញ្ជាក់ ជុំវិញ ករណី នេះ បាន ទេ កាល ពី ម្សិល មិញ ៕
បុគ្គលិក ក្រុមហ៊ុន ម្នាក់ ឈ្មោះ ពៅ បាន ប្រាប់ អ្នក ភូមិ ថា ទីតាំង ដី ដែល ពួក គេ កំពុង ធ្វើ ការ សាង សង់ នេះ គឺជា ដី របស់ ក្រុមហ៊ុន ទិញ ពី ប្រជាជន ហើយ ក្រុមហ៊ុន ក៏ ទទួល បាន ប្លង់ កម្មសិទ្ធិ ស្រប ច្បាប់ ពី អាជ្ញាធរ រួច ហើយ ដែរ ។
ស្ត្រី រងគ្រោះ ដែល ជា ដើម បណ្តឹង និង ជន សង្ស័យ មិន អាច ទាក់ទង សុំ ការ ពន្យល់ បន្ថែម បាន ទេ កាលពី ថ្ងៃ ម្សិលមិញ ហើយ ក៏ មិន អាច ស្វែងរក ប្រភព ឯករាជ្យ ណា មួយ ដើម្បី បញ្ជាក់ លើ បញ្ហា នេះ បាន ដែរ ៕
ចំនួនជនមាតុភូមិនិវត្តន៍ពីសហរដ្ឋអាមេរិកមានការ ធ្លាក់ចុះ៤២% នៅក្នុងឆ្នាំ២០១២
លោក គិត ថា ការ បោះឆ្នោត លោក ប្រធានាធិបតី បារ៉ាក់ អូបាម៉ា ឆ្នាំ ២០១២ អាច បង្ហាញ អត្រា នេះ ជា បណ្តោះ អាសន្ន ឬ អាជ្ញាធរ កម្ពុជា ជាប់ រវល់់ នឹង ការ រៀបចំ ពិធី បុណ្យ ព្រះ បរម សព សម្តេច ឪ នរោត្តម សីហនុ ។
វា មិន អាច ដោយ សារ តែ រដ្ឋាភិបាល លោក អូបាម៉ា ជំរុញ កំណែ ទម្រង់ អន្តោប្រវេសន៍ កាល ពី ឆ្នាំ មុន ឡើយ ដែល បាន អនុវត្ត តែ ចំពោះ កូន របស់ ជន អន្តោប្រវេសន៍ ប៉ុណ្ណោះ ព្រោះ កំណែ ទម្រង់ នេះ បាន រំលង អ្នក ទាំង ឡាយ ដែល ត្រូវ បាន ផ្តន្ទាទោស ពី បទឧក្រិដ្ឋ ។
មនុស្ស ជាច្រើន ត ស៊ូ ជាមួយ នឹង គ្រឿង ញៀន និង គ្រឿង ស្រវឹង ។
លោក កឹម វីឡា សហនាយក ហិរញ្ញវត្ថុ នៃ មណ្ឌល បាន ថ្លែង ថា៖
ប្រាក់ ប្រតិបតិ្ត ការ គឺ ៤ ដុល្លារ អាមេរិក ក្នុង មួយ ថ្ងៃ ។
ជន មាតុ ភូមិ និវត្តន៍ ម្នាក់ ដែល ហៅ ខ្លួន ថា សុង បាន ថ្លែង ថា៖
បន្ទាប់ ពី សវនាការ អសាធារណៈ អស់ រយៈពេល ជាង ៥ ម៉ោង នោះ លោក ឃុន លាង ម៉េង បាន ថ្លែង ថា សវនាការ នេះ នឹង ត្រូវ បើក បន្ត ទៀត នៅ ថ្ងៃ ព្រហស្បតិ៍ នេះ ពីព្រោះ មាន សាក្សី ជា ច្រើន ដែល នឹង ត្រូវ ធ្វើ ការ សាក សួរ បន្ត ទៀត ។
លោក ឈូក បណ្ឌិត ពុំ ព្រម ផ្តល់ ការ អត្ថាធិប្បាយ ដល់ អ្នក សារព័ត៌មាន ឡើយ បន្ទាប់ ពី បាន ដើរ ចេញ ពី បន្ទប់ សវនាការ ដោយ ដើរ សំដៅ ទៅ រថយន្ត ឡិច ស៊ីស ពណ៌ ខ្មៅ ស៊េរី ទំនើប ថ្មី មួយ គ្រឿង ផ្សេង ទៀត ដោយ គ្រាន់ តែ មាន ប្រសាសន៍ យ៉ាង ខ្លី ថា ៖
បទ ចោទ ប្រកាន់ នេះ បាន ធ្វើ ឲ្យ មាន ការ រិះគន់ យ៉ាង ខ្លាំង ពី កម្ម ការិនី រងគ្រោះ និង អង្គការ សិទ្ធិ មនុស្ស ជាតិ និង អន្តរជាតិ ។
បន្ទាប់ ពី មាន ការ រិះគន់ យ៉ាង ខ្លាំង ពី មជ្ឈ ដ្ឋាន ជាតិ និង អន្តរ ជាតិ ជា ច្រើន នៅ ថ្ងៃ ទី ២១ ខែ ធ្នូ ឆ្នាំ ២០១២ អគ្គ ព្រះ រាជ អាជ្ញា សាលា ឧទ្ទរណ៍ បាន ដាក់ ពាក្យ បណ្តឹង ប្តឹង ជំទាស់ ទៅ នឹង ការ សម្រេច របស់ សាលា ដំបូង ខេត្ត ស្វាយរៀង ដែល បាន ទម្លាក់ ចោល ការ ចោទ ប្រកាន់ អតីត អភិបាល ក្រុង បាវិត រូប នេះ ។
អ្នក ស្រី ទេព វន្នី ជា តំណាង ពលរដ្ឋ នៅ តំបន់ បឹងកក់ បាន ថ្លែង ថា យុត្តិធម៌ ត្រូវ តែ មាន សម្រាប់ ប្រជាជន ទូទៅ ហើយ ពលរដ្ឋ ទាំង អស់ គ្នា ត្រូវ ការ យុត្តិធម៌ ។
សង្គ្រោះក្មេងស្រី ២រូបពីទារុណកម្មប្រពន្ធឧកញ៉ា
ជន រងគ្រោះ ទាំង ពីរ នាក់ បាន រំដោះ ចេញ ពី ផ្ទះ ដ៏ ស្តុកស្តម្ភ របស់ ឧកញ៉ា រូប នោះ ដែល គេ ជឿ ថា ជា ម្ចាស់ អាផាតមិន មួយ ដែល មាន ប្រជាប្រិយ បំផុត នៅ ភ្នំពេញ បន្ទាប់ ពី ពួក គេ រស់ នៅ ជាមួយ គ្រួសារ នេះ រយៈ ពេល ជាង ៧ឆ្នាំ ។
លោក ថុល យុធា មន្ត្រី នគរបាល ប្រឆាំង ការ ជួញ ដូរ មនុស្ស និង ការពារ អនីតិជន ខេត្ត បាត់ដំបង បាន បង្ហាញ អំពី អត្តសញ្ញាណ ជន រងគ្រោះ ថា ក្មេង ស្រី ម្នាក់ ឈ្មោះ ស៊ុង គន្ធា អាយុ ១៧ ឆ្នាំ មក ពី ខេត្ត បាត់ដំបង និង ម្នាក់ ទៀត ត្រូវ ស្គាល់ ថា ឈ្មោះ ផល្លី អាយុ ១៧ ឆ្នាំ មក ពី ខេត្ត តាកែវ ។
ក្រោយ មក សមត្ថកិច្ច លោក ក៏ នាំ ពួក គេ យក ទៅ ការិយាល័យ នគរបាល ដើម្បី សាកសួរ ពាក់ព័ន្ធ នឹង ការ ធ្វើ ទារុណកម្ម ពី សំណាក់ ស្ត្រី ម្ចាស់ ផ្ទះ ម្នាក់ នោះ ។
លោក បាន ថ្លែង ទៀត ថា នគរបាល បាន រក ឃើញ គ្រួសារ របស់ ពួក គេ ហើយ បាន ជំរុញ ឲ្យ ពួក គេ ដាក់ ពាក្យ បណ្តឹង ផ្លូវ ការ ហើយ នគរបាល ខេត្ត បាត់ដំបង បាន បញ្ជូន ករណី នេះ ទៅ នាយក ដ្ឋាន ប្រឆាំង ការ ជួញដូរ មនុស្ស និង ការពារ អនីតិជន នៃ ក្រសួង មហាផ្ទៃ រួច ហើយ ដើម្បី ធ្វើ ការ ស៊ើប អង្កេត បន្ថែម ទៀត ខណៈ ដែល ករណី នោះ កើត នៅ រាជធានី ។
អ្នក ស្រី ថា ពេល នេះ កំពុង រៀបចំ បណ្តឹង ទៅ រាជធានី ភ្នំពេញ ។
តាម មន្ត្រី នគរបាល សុំ មិន ប្រាប់ ឈ្មោះ បាន ឲ្យ ដឹង ថា ជន រងគ្រោះ ទាំង ពីរ រៀបរាប់ ប្រាប់ នគរបាល អំពី ស្ថានភាព រស់ នៅ ជាមួយ គ្រួសារ ឧកញ៉ា នោះ និង បាន ប្រាប់ ថា ពួក គេ ត្រូវ បាន បង្ខំ ឲ្យ ធ្វើ ការ យ៉ាង ហត់នឿយ និង រង ការ វាយ ដំ ស្ទើរ រាល់ ថ្ងៃ ។
លោក យិន ម៉េង លី អ្នក សម្រប សម្រួល នៅ អង្គការ សិទ្ធិ មនុស្ស អាដហុក ប្រចាំ ខេត្ត បាត់ដំបង ថ្លែង ថា ៖
បុគ្គលិកណាហ្គាវើលព្រមចូលធ្វើការ វិញថ្ងៃនេះ
ទោះ យ៉ាង ណា នៅ មាន ចំណុច សេស សល់ ចំនួន ៤ ទៀត មិន ទាន់ ត្រូវ បាន ដោះស្រាយ នៅ ឡើយ ទេ ក្នុង នោះ គឺ ការ សុំ ឲ្យ ក្រុមហ៊ុន គោរព សេចក្តី បង្គាប់ របស់ អាជ្ញា កណ្តាល ការ សុំ ដំឡើង ប្រាក់ ឈ្នួល ឲ្យ បាន អប្បបរមា ១៥០ ដុល្លារ ការ ផ្តល់ ប្រាក់ រង្វាន់ ប្រចាំ ឆ្នាំ និង ការ សុំ ឲ្យ ក្រុមហ៊ុន ពិចារណា ពី អត្តចរិត ថ្នាក់ ដឹក នាំ បី រូប ដែល តែង តែ បង្ក បញ្ហា ជា មួយ បុគ្គលិក ។
ក្នុង កិច្ច ប្រជុំ ផ្សះផ្សា កាល ពី ម្សិលមិញ មាន រយៈ ពេល ប្រមាណ ៤ ម៉ោង នៅ ទីស្តីការ ក្រសួង ការ ងារ មាន មន្ត្រី នាយកដ្ឋាន វិវាទ ការងារ ដើរ តួ សម្រប សម្រួល រវាង តំណាង និយោជក និង សហជីព បុគ្គលិក កាស៊ីណូ ណាហ្គា ព្រម ទាំង មាន ការ ចូលរួម ពី នគរបាល ក្រសួង មហាផ្ទៃ និង នគរបាល រាជធានី ភ្នំពេញ ។
ក្រុម បុគ្គលិក ព្រម ចូល ធ្វើ ការ វិញ ដោយ បញ្ចប់ កូដកម្ម តែ សំណូម ពរ ឲ្យ និយោជក កុំ កាត់ ប្រាក់ ថ្ងៃ ដែល ពួក គេ ធ្វើ កូដកម្ម ប៉ុន្តែ សំណើ នេះ ត្រូវ បាន ទាត់ ចោល ។
បើ តាម លោក សុខ ណារិទ្ធ អគ្គ លេខាធិការ រង សហព័ន្ធ សហជីព កម្មករ និយោជិត វិស័យ ទេសចរណ៍ និង សេវាកម្ម កម្ពុជា ថ្លែង ថា ចំណូល របស់ កាស៊ីណូ ណាហ្គា មាន ប្រមាណ ២៣០ លាន ដុល្លារ ក្នុង ឆ្នាំ ២០១១ និង ក្នុង ឆមាស ទី ១ ឆ្នាំ ២០១២ មាន ១៣០ លាន ដុល្លារ ដូច្នេះ ក្រុមហ៊ុន គួរ គិត គូរ ដំឡើង ប្រាក់ ខែ ដល់ បុគ្គលិក ឲ្យ បាន សមរម្យ ៕
លោក បាន ថ្លែង បន្ថែម ថា ករណី ជំងឺ គ្រុន ចាញ់ ក្នុង ចំណោម ពលករ ចំណាក ស្រុក គឺ បង្ក លក្ខណៈ ប៉ះពាល់ ខ្លាំង ណាស់ ខណៈ ពេល ដែល ពួក គេ ជា ញឹកញាប់ មិន ទទួល បាន ការ ព្យាបាល តាម បច្ចេកទេស ត្រឹមត្រូវ ដោយ សារ ខ្វះ លទ្ធភាព ទទួល បាន សេវា គាំពារ សុខាភិបាល ។
លោក វេជ្ជបណ្ឌិត ច ម៉េង ជួ បាន ថ្លែង បន្ត ទៀត ថា រដ្ឋាភិបាល ក៏ សង្ឃឹម ផង ដែរ ថា នឹង ធ្វើ កិច្ច ខិតខំ ប្រឹង ប្រែង សហការ ស្រដៀង គ្នា នេះ នៅ តាម ព្រំដែន វៀតណាម និង ឡាវ ផង ដែរ ។
ចំនួន ករណី ស្លាប់ ដោយ សារ ជំងឺ គ្រុន ចាញ់ កាលពី ឆ្នាំ មុន បាន ធ្លាក់ ចុះ យ៉ាង ច្រើន គឺ ពី ៩៣ ករណី ក្នុង ឆ្នាំ ២០១១មក ត្រឹម ៤៥ ករណី ក្នុង ឆ្នាំ ២០១២ ។
បុគ្គលិក ក្រុមហ៊ុន ទូរគមនាគមន៍ កម្ពុជា ចោទ ប្រកាន់ លោក ឡៅ សារឿន ថា បាន រស់ នៅ យ៉ាង ស្តុកស្តម្ភ ខណៈ ដែល លុយ នៅ ក្នុង ក្រុមហ៊ុន បាន បាត់បង់ ។
លោក ទឹម ច័ន្ទ ណារិទ្ធ មន្រ្តី ម្នាក់ ថ្លែង ថា៖
បុគ្គលិក ដែល ចូល ប្រជុំ ពី ម្សិលមិញ ថា ពួក គេ ព្រម រង់ចាំ មើល លទ្ធផល ៕
លោក ឧប នាយក រដ្ឋ មន្ត្រី ប៊ិន ឈិន ប្រធាន អាជ្ញាធរ ជាតិ ដោះ ស្រាយ ទំនាស់ ដី ធ្លី ដែល ចូល រួម ក្នុង សន្និបាត នោះ ថ្លែង ថា ការងារ វាស់ វែង ដី ធ្លី គឺជា ការងារ ដ៏ សំខាន់ ដែល មាន ក្នុង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការ កាត់ បន្ថយ ភាព ក្រីក្រ ។
