លោកសៅ សុខា បញ្ជាឲ្យ បញ្ច ប់បណ្តឹងជាមួយលោ ក ជួនសុវណ្ណ
លោក ឧត្ដម សេនីយ៍ ត្រី ហុង វិ ណាល់ មេ បញ្ជា ការ កង រាជ អាវុធ ហត្ថ រាជ ធានី ភ្នំពេញ ទទួល បន្ទុក ផ្នែក សន្ដិ សុខ បាន បដិសេធ មិន ធ្វើ អធិប្បាយ ទេ នៅពេល កាសែត ភ្នំ ពេញ ប៉ុស្តិ៍ សាក សួរ ពី ថ្ងៃ ម្សិលមិញ ។
លោក ឧត្តម សេនីយ៍ ឯក ជួន សុវណ្ណ បាន មាន ប្រសាសន៍ ពី ថ្ងៃ ម្សិលមិញ ថា ករណី នេះ ឥឡូវ ត្រូវ បាន បញ្ចប់ ហើយ ។
ក្នុង ព្រះរាជ សារ ព្រះ អង្គ ទាំង ទ្វេ ឡាយ ថា៖
នៅក្នុង ព្រះរាជ សារ នោះ សម្តេច ព្រះមហាក្សត្រិយ៍ ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ជន រួម ជាតិ និង ភ្ញៀវ អន្តរជាតិ ទាំងអស់ ដែល បាន ចំណាយ ពេលវេលា ចូលរួម ក្នុង ព្រះរាជ ពិធី នោះ ។
ព្រះរាជ ពិធី បុណ្យ ថ្វាយ ព្រះ ភ្លើង ព្រះបរម សព សម្តេច ព្រះ មហា វីរក្សត្រ មាន រយៈពេល ៧ ថ្ងៃ គឺ ចាប់ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី ៧ ខែកុម្ភៈ ដោយ មាន ការដង្ហែ ព្រះ បរ ម សព ចេញ ពី ព្រះ បរម រាជ វាំង នា ថ្ងៃទី ១កុម្ភៈ និង ថ្វាយ ព្រះភ្លើង នៅ ថ្ងៃ ទី៤ កុម្ភៈ ឆ្នាំ ២០១៣ ។
រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ គ្រោង កសាង ព្រះបរម រូប ព្រះបរម រតន កោដ្ឋ សម្ដេច ព្រះ នរោត្ដម សីហនុ នៅលើ សួនច្បារ ខាង កើត វិមាន ឯករាជ្យ ទុក ជា ព្រះ គុ ណូបការៈ ដ៏ ធំ ធេង ថ្វាយ ដល់ ព្រះករុណា ព្រះមហា វីរក្សត្រ ដែល ទ្រង់ បាន បូ ជា ព្រះ កាយ ពល ជូន ប្រជាជាតិ ប្រជារាស្ត្រ កម្ពុជា ដើ ម្បី ចងចាំ ជាដរាប នូវ ព្រះភក្ត្រ របស់ ព្រះអង្គ ។
លោក សុក សំអឿន មេ ធាវី ការពារ ក្តី របស់ លោក ចាន់ សុវេត បាន ប្រាប់ ភ្នំ ពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ សុក្រ ថា ៖
កាល ពី ថ្ងៃទី ២៦ មករា ឆ្នាំ ២០១៣ មន្ត្រី អង្គការ លីកាដូ បាន ប្រ ទះ ឃើញ ពល ការិនី ជន រង គ្រោះ ម្នាក់ ឈ្មោះ ម៉ៅ ឡេត ទី នៅ ឯ ព្រលាន យន្ត ហោះ ភ្នំពេញ អន្តរ ជាតិ ដោយ វង្វេង ស្មារតី ។
កាល ពី ខែ តុលា ឆ្នាំ ២០១១ រដ្ឋា ភិបាល កម្ពុជា បាន ហាមឃាត់ មិន ឲ្យ បញ្ជូន កម្មករ ទៅ ធ្វើ ការ នៅ ប្រទេស ម៉ាឡេស៊ី បន្ទាប់ ពី មាន របាយ ការណ៍ មួយ ចំនួន ស្ដីពី ការ រំលោភ បំពាន ខាង រាង កាយ ៕
គណៈមេ ធាវីធ្វើការ ស៊ើបអង្កេតករណីមេ ធាវីទិញពេ ស្យាចារកុមារ
សំណុំ រឿង ដែល ស្ថិត នៅ ក្នុង ដៃ ស្ថាប័ន តុលាការ ខេត្ត សៀម រាប គណៈ មេធាវី មិន មាន ការលូក លាន់ ឡើយ ព្រោះ រឿង នេះ ស្ថិត ក្នុង ដំណាក់កាល ស៊ើប អង្កេត ថា តើ « មេធាវី ម៉ៅ តាន់ អៀម ប្រព្រឹត្ត ដូច ការ ចោទ ប្រកាន់ របស់ ក្មេង ប្រុស ឬ យ៉ាងណា ?
អ្នក នាំ ពាក្យ គណៈ មេធាវី រូប នេះ បន្ត ថា៖
ដូច្នេះ លោក ត្រូវ ការ ស៊ើប អង្កេត អ្នក ពាក់ព័ន្ធ ឬ អាច មាន អ្នក នៅ ពីក្រោយ ការ ប្រព្រឹត្ត របស់ កុមារ ។
លោក ឈូក កុម៉ុល អធិការ ក្រុង ស្ទឹង ត្រែង បាន មាន ប្រសាសន៍ ថា មាន ក្មេង ស្រី អាយុ ៦ ឆ្នាំ ម្នាក់ និង អាយុ ១៤ ឆ្នាំ រួម ទាំង ក្មេង ប្រុស អាយុ ៩ ឆ្នាំ ម្នាក់ បាន លង់ ទឹក ស្លាប់ យ៉ាង អាណោច អាធ័ម នៅ ក្នុង បឹង ឈូក ក្បែរ វត្ត ភូមិ គីឡូ ៨ ស្ថិត នៅ ក្នុង សង្កាត់ សាមគ្គី ក្រុង - ខេត្ត ស្ទឹង ត្រែង ។
លោក បាន បន្ថែម ថា ពលរដ្ឋ ទាំង នោះ ភាគ ច្រើន មក ពី ឃុំ អូរ ស្វាយ ស្រុក ត្រពាំង ប្រសាទ និង សង្កាត់ ដង ទង់ ក្រុង សំរោង ខេត្ត ឧត្តរ មាន ជ័យ ។
លោក សេង ច័ន្ទ ថន ប្រធាន ផ្នែក វាស់ វែង គ្រោះ ថ្នាក់ ចរាចរ ណ៍ តាម កំណាត់ ផ្លូវ សាធារណៈ នៅ រាជធានី បាន ឲ្យ ដឹង ថា សមត្ថកិច្ច ជំនាញ កំពុង ក សាង សំណុំរឿង និង បន្ត ការ ស្រា វ ជ្រាវ ដើម្បី ស្វែង រក អ្នក បើក បរ រថយន្ត ក្រុម ហ៊ុន រិទ្ធី មុនី ដែល បាន រត់ គេ ច ខ្លួន បាត់ ។
លោក គុយ សុខ ប្រធាន មន្ទីរ សុខា ភិបាល ខេត្ត បាន ថ្លែង ថា មន្រ្តី ក្រសួង សុខាភិបាល និង មន្រ្តី អង្គ ការ សុខ ភាព ពិភព លោក បាន ចុះ ទៅ កន្លែង នោះ ដើម្បី ពិនិត្យ មើល អ្នក ភូមិ និង យក ប៉ាន់ គំរូ មក ធ្វើ តេស្ត ដើម្បី ស្វែង រក មូល ហេតុ ពិត ប្រាកដ ។
លោក បាន ប្រាប់ ភ្នំ ពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ អាទិត្យ ថា ៖
អាជ្ញាធរខេត្ត បន្ទាយមានជ័យ រកឃើញយុទ្ធ ភណ្ឌមិនទាន់ផ្ទុះចំនួន ៤៧គ្រាប់
លោក បាន មានប្រសាស ន៍ បញ្ជា ក់ ថា៖
ករណី ស្លាប់ នេះ មាន ចំនួន ដូច គ្នា នៅ ឆ្នាំ ២០១១ ៕
ការសង់ទំនប់វារីអគ្គិសនីអារ៉េងបង្ក ផលប៉ះពាល់ទាំងមនុស្ស ព្រៃឈើ និងសត្វ
លោក យ៉ា ថៃ មាន រឿង ជាច្រើន គាត់ ជា ខ្មែរ ម្នាក់ ក្នុង ចំណោម ពីរ បី នាក់ ដែល រត់ ឆ្លង ព្រំដែន ចូល ទៅ ប្រទេស ថៃ ក្នុង សម័យ ខ្មែរ ក្រហម លោក យ៉ាង ថៃ ថ្លែង ថា វា ជា ទំនួល ខុស ត្រូវ របស់ លោក ដែល ត្រូវ ប្រាប់ ពិភពលោក អំពី ការ ជម្លៀស ប្រជាជន ការ បង្ខំ ឲ្យ ធ្វើ ការងារ ដ៏ លំបាក និង ការ ស្លាប់ ក្រោម របប ខ្មែរ ក្រហម ។
ខ្ញុំ ត្រូវ គេ ដាក់ ពន្ធនាគារ ដោយ សារ ពុំ មាន លិខិត ឆ្លង ដែន ហើយ ពួក គេ បាន ឃុំ ខ្លួន ខ្ញុំ មួយ សប្តាហ៍ ។
ទស្សនៈ លោក មិន យូរ ប៉ុន្មាន បាន ផ្លាស់ ប្តូរ នៅ ខែ កញ្ញា គ្រួសារ លោក និង គ្រួសារ ដទៃ ៗ ទៀត ប្រមាណ ៥ ពាន់ គ្រួសារ ត្រូវ គេ ឲ្យ រស់ នៅ កណ្តាល ព្រៃ ក្នុង ស្ថានភាព ដ៏ លំបាក ជាមួយ ការ អត់ ឃ្លាន ។
មេធាវី ដើម បណ្តឹង រដ្ឋ ប្បវេណី ក៏ បាន ផ្តល់ ឲ្យ លោក យ៉ា ថៃ នូវ ការ រំឭក ស្រដៀង គ្នា នៅ ក្នុង អំឡុង ការ ពិនិត្យ ដោយ មេធាវី របស់ អៀង សារី ប៉ុន្តែ លោក យ៉ា ថៃ ប្រាប់ ថា ៖
ភ្នំពេញៈ អង្គការ សង្គម ស៊ីវិល ដែល ឃ្លាំ មើល ការ បោះឆ្នោត កំពុង ជំរុញ ឲ្យ មាន ចំនួន ស្ត្រី កើន ឡើង ដល់ ៣០ ភាគរយ នៅ ក្នុង វិស័យ នយោបាយ សម្រាប់ ការ បោះឆ្នោត នា ពេល ខាង មុខ ។
នេះ ជា អ្វី ដែល ជា ការ ចង់ បាន របស់ អង្គ ការ សង្គម ស៊ីវិល ដែល បាន ធ្វើ ការ ពិភាក្សា នៅ ក្នុង កិច្ច ពិភាក្សា តុ មូល មួយ កាលពី ម្សិល មិញ រៀបចំ ឡើង ដោយ មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា ដែល មាន ការ ចូលរួម ពី តំណាង ចំនួន ៤០ រូប នៃ គណបក្ស នយោបាយ លើក លែង តែ គណបក្ស ប្រជាជន កម្ពុជា កាន់ អំណាច ដែល មិន បាន ចូលរួម ។
កត្តា សង្គម កត្តា គ្រួសារ កត្តា ជីវភាព ធ្វើ ឲ្យ ស្ត្រី កម្ពុជា នៅ តែ មាន ឧបសគ្គ ក្នុង ការ ចូល ប្រឡូក ក្នុង បញ្ហា នយោបាយ ។
ទ្រង់ រណឫទ្ធិ ប្រទានអំណោយដល់អ្នកធាក់ ស៊ី ក្លូ វ័យចាស់
នៅ ប៉ុន្មាន ម៉ោង ក្រោយ ពី បាន ដង្ហែ ព្រះ បរម អដ្ឋិ របស់ ព្រះ បរម រតន កោដ្ឋ ទៅ តម្កល់ លើ មហា បញ្ចា រួច មក ព្រះអង្គ ម្ចាស់ ន រោត្ដម រណឫទ្ធិ ទ្រង់ បាន យាង ទៅ ចែក អំណោយ ដល់ ក្រុម អ្នក ធាក់ ស៊ី ក្លូ មាន វ័យ ចំណាស់ ៗ ប្រមាណ ១៣០ នាក់ ដែល ឈប់ សំចត នៅ តាម ដង ផ្លូវ ខាង ជើង ជាប់ របង ស្ថាន ទូត រុស្ស៊ី ប្រចាំ កម្ពុជា ដែល ស្ថិត នៅ ក្នុង សង្កាត់ ទន្លេ បាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ។
លោក បន្ត ឲ្យ ដឹង ទៀត ថា មនុស្ស វ័យ ចំណាស់ ៗ នៅ ក្នុង ប្រទេស បារាំង គឺ ទទួល បាន ការ ថែទាំ និង ការ ទំនុក បម្រុង យ៉ាង កក់ក្តៅ ពី រដ្ឋាភិបាល និង ពី អង្គការ សមាគម មនុស្ស ចាស់ ។
អ្នក ធាក់ ស៊ី ក្លូ វ័យ ចំណាស់ ម្នាក់ ក្នុង ចំណោម ១៣៥ នាក់ ដែល ម ក ពី តាម បណ្ដា ខេត្ត នានា ក្នុង ប្រទេស កម្ពុជា គឺ លោក លាន លឹម អាយុ ៨០ ឆ្នាំ មកពី ភូមិ ត្នោត រ លើង ឃុំ វត្ត អង្គ ខាង ជើង ស្រុក ទូក មាស ខេត្ត កំពត បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ក្រោយពី ច្រូត កាត់ រួច គាត់ តែងតែ មក ភ្នំពេញ ដើម្បី ប្រក ប មុខ របរ ធាក់ ស៊ី ក្លូ រក ប្រាក់ កម្រៃ ដើម្បី ផ្គត់ផ្គង់ ជីវភាព គ្រួសារ ដែល ក្រីក្រ ។
លោក តា លឹម មាន រាង ស្គម ទាប សម្បុរ ខ្មៅ បាន បង្ហាញ នូវ ស្នាមញញឹម លើ ផ្ទៃ មុខ ដ៏ ជ្រីវ ជ្រួញ របស់ គាត់ បាន មាន ចំណាប់ អារម្មណ៍ បន្ទាប់ពី ទទួល បាន អំណោយ ទាំង នេះ ដោយ សំឡេង គ្រលរ ៗ មិន សូវ ច្បាស់ តាម សភាព គ្រហុប របស់ គាត់ ថា ៖
រឿងជំរិតថៃពីរនាក់នៅប៉ោយ ប៉ែត ទៅជារឿងពាល ស៊ី ពាល
សាលា ឧទ្ធរណ៍ជម្រះរឿងឈូកបណ្ឌិតបាញ់កម្មករនៅចុងខែនេះ
រីឯ ក្រុមហ៊ុន ដែល ត្រូវ បាន កាត់ ដី ចេញ ក្នុង ចំណោម ក្រុម ហ៊ុន ទាំង ៣៧ នោះ ក៏ មាន ក្រុម ហ៊ុន ធី ធី វ៉ាយ ក្រុមហ៊ុន កាសូទី ម ក្រុមហ៊ុន ភាពី ម៉ិច និង ក្រុមហ៊ុន អាន ម៉ាឌី ដែល ក្រុម អ្នក ភូមិ តែង តែ ធ្វើ ការ តវ៉ា ប្រឆាំង នឹង ក្រុម ហ៊ុន ទាំង នេះ ជា ញឹកញាប់ ផង ដែរ ។
នៅ ថ្ងៃ ទី ១៤ មិថុនា លោក ហ៊ុន សែន ក៏ បាន ថ្លែង ជា សាធារណៈ បញ្ជា ឲ្យ អាជ្ញាធរ ទូទាំង ប្រទេស ធ្វើ ការ វាស់ វែង បែង ចែក ដីធ្លី ឲ្យ ប្រជាពលរដ្ឋ ដែល មាន ទំនាស់ ដី ធ្លី ជាមួយ ក្រុម ហ៊ុន ព្រៃ សម្បទាន ដី សម្បទាន សេដ្ឋកិច្ច ។
បន្ទាប់ មក នៅ ថ្ងៃទី ២៨ ខែ កញ្ញា ឆ្នាំ ២០១២ ទីស្តីការ គណៈ រដ្ឋ មន្ត្រី ក៏ បាន ចេញ សេចក្តី ប្រកាស ព័ត៌មាន មួយ ថា ការ ផ្អាក ផ្តល់ សម្បទាន ដី សេដ្ឋកិច្ច ត្រូវ បន្ត ក្នុង រយៈ ពេល វែង ហើយ អាច នឹង ឈាន ទៅ ដល់ ពេល ដែល លោក នាយក រដ្ឋ មន្ត្រី ដល់ ពេល ដែល ចូល និវត្តន៍ ពី ឆាក នយោបាយ ។
រីឯ លោក ច័ន្ទ សារុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម ក៏ ពុំ អាច ទំនាក់ ទំនង ដើម្បី សុំ ការ អត្ថាធិប្បាយ បាន ដែរ ។
លោក អំ សំអាត មន្ត្រី ស៊ើប អង្កេត ជាន់ ខ្ពស់ អង្គការ ការ ពារ សិទ្ធិ មនុស្ស លីកាដូ ថ្លែង ថា នេះ ជា ការ ល្អ មួយ ដែល រដ្ឋាភិបាល បាន ផ្តល់ ដី និង ប័ណ្ណ កម្មសិទ្ធិ ដល់ ប្រជា ពលរដ្ឋ ធ្វើ ឲ្យ ប្រជា ពលរដ្ឋ មាន សុវត្ថិភាព ក្នុង ការ គ្រប់គ្រង ដី របស់ ខ្លួន ។
អ្នក នៅបឹងឈូក មក តវ៉ាមុខតុលាការភ្នំពេញ
នៅ មុខ តុលាការ លោក ឈឹម សុផុន និង ពលរដ្ឋ ជា ច្រើន ទៀត មក ពី ភូមិ បឹង ឈូក សង្កាត់ គីឡូម៉ែត្រ ៦ ខណ្ឌ ឫស្សី កែវ បាន ប្រាប់ ថា ពួក គាត់ កំពុង ត្រូវ ឈ្មួញ ដីធ្លី មិន ស្គាល់ ម្នាក់ គំរាម កំហែង តាម រយៈ ប្រព័ន្ធ តុលាការ ។
ពោធិ៍សាត់ៈ សាលា ដំបូង ខេត្ត ពោធិ៍សាត់ កាល ពី ថ្ងៃ ពុធ បាន កាត់ ទោស មន្រ្តី យោធា ឈ្មោះ ប៉ោង ពុទ្ធារិទ្ធិ ឲ្យ ជាប់ ពន្ធនាគារ ចំនួន ពីរ ឆ្នាំ តែ អនុវត្ត ទោស តែ ៦ខែ ពី បទ គំរាម កំហែង និង រារាំង ការងារ មន្រ្តី រដ្ឋបាល ព្រៃឈើ ។
លោកសូណង់ ដូ ដែលកំពុងជាប់ឃុំទំនងនឹងទទួលពាន រង្វាន់សិទ្ធិ មនុស្សអន្តរជាតិ
លោក សូណង់ ដូ គឺជា មនុស្ស ម្នាក់ ក្នុង ចំណោម សកម្មជន ៦ នាក់ ដែល ស្ថិត ក្នុង បញ្ជី ជ្រើសរើស សម្រាប់ ពាន រង្វាន់ នេះ ។
ចំពោះ ពាន រង្វាន់ នេះ អ្នក ដែល ត្រូវ បាន ជ្រើសរើស រួម មាន សកម្មជន មក ពី ប្រទេស អ៊ូស បេគីស្ថាន ម៉ូរី តានី អ៊ីរ៉ង់ កេន យ៉ា និង កូឡុំប៊ី ។
អ្នក ស្រី ហួន បញ្ញា រី លេខា នៅ សមាគម អ្នក ប្រជាធិបតេយ្យ របស់ លោក ម៉ម សូណង់ ដូ បាន ថ្លែង ថា ការ ទទួល បាន ពាន រង្វាន់ នេះ នឹង ជា កិត្តិយស មួយ សម្រាប់ លោក ម៉ម សូណង់ ដូ ហើយ ដែល នេះ នឹង ជា កិត្តិយស ទី មួយ ចាប់ តាំង ពី លោក ត្រូវ បាន កាត់ ទោស ឲ្យ ជាប់ ពន្ធនាគារ កាល ពី ខែ តុលា ប៉ុន្តែ វា មាន ឥទ្ធិពល តិចតួច សម្រាប់ ករណី ជាក់ ស្តែង របស់ លោក ដែល កំពុង ជាប់ ពន្ធនាគារ នៅ កម្ពុជា ។
លោក ផៃ ស៊ីផាន អ្នក នាំ ពាក្យ ទីស្តីការ គណៈ រដ្ឋ មន្រ្តី មិន អាច ទាក់ទង សុំ ការ ធ្វើ អត្ថាធិប្បាយ បាន ទេ ។
ប៉ុន្តែ យ៉ាង ណា ក្តី នា ពេល កន្លង មក មន្ត្រី រដ្ឋាភិបាល មួយ ចំនួន បាន ហៅ អ្នក ដែល ឈឺ ឆ្អាល ចំពោះ ការ ផ្តន្ទាទោស លោក ម៉ម សូណង់ ដូ ថា ជា ក្រុម ការពារ អ្នក ទោស ៕
ការ ប៉ះទង្គិចគ្នាក្នុងការតវ៉ារបស់កម្មកររោងចក្រ អ៊ីហ្គាមេន កម្មករ ៧ នាក់បានរង របួស
តំណាង កម្មករ លោក ចាន់ ពៅ កាលពី ថ្ងៃ ម្សិលមិញ បាន ប្រាប់ ថា មាន កម្មករ ប្រហែល ២០០ នាក់ បាន នាំ គ្នា ធ្វើ កូដកម្ម តវ៉ា នៅ ខាង មុខ រោងចក្រ ទាមទារ ឲ្យ សមាជិក សម្ព័ន្ធ សហជីព ប្រជាធិបតេយ្យ កម្មករ កាត់ ដេរ កម្ពុជា ( ស៊ី ខៅ ឌូ ) ចំនួន ៤១ នាក់ ដែល ត្រូវ បាន បណ្ដេញ ចេញ ចាប់ តាំងពី ឆ្នាំ ២០០៧ និង ២០១០ ចូល ធ្វើ ការ វិញ ។
លោក សេង សុជាតិ អធិការ នគរបាល ស្រុក ស្អាង បាន ធ្វើ ការ បដិសេធ ការ ចោទ ប្រកាន់ របស់ តំណាង កម្មករ ដែល ថា មន្ត្រី របស់ លោក ប្រើ អំពើ ហិង្សា លើ ពួក គេ ។
ថៃបន្តស្វះ ស្វែង ឲ្យមានការ ដោះ ដូរអ្នក ទោស ជាកញ្ចប់
អ្នក ទាំង ពីរ ត្រូវ បាន តុលាការ កម្ពុជា កាត់ ទោស ឲ្យ ជាប់ ពន្ធនាគារ ពី ៦ ឆ្នាំ ទៅ ៨ ឆ្នាំ ពី បទ ចារកម្ម ។
កាល ពី ឆ្នាំ ២០០៩ រដ្ឋាភិបាល កម្ពុជា និង ថៃ បាន ចុះ កិច្ច ព្រមព្រៀង ផ្លាស់ ប្ដូ រ អ្នក ទោស គ្នា ទៅ វិញ ទៅ មក ។
ដី ព្រៃ ជិត មួយ ពាន់ ហិកតា នោះ ប្រជាជន បម្រុង សុំ អាជ្ញាធរ ខេត្ត សម្រាប់ រក្សា ទុក ជា ដី សហគមន៍ ឲ្យ ប្រជា សហគមន៍ ចារ៉ាយ អាស្រ័យ ផល ។
មនុស្ស ម្នាក់ ៗ មាន សុខភាព រឹងមាំ ល្អ ប្រសើរ ទៅ បាន ក៏ អាស្រ័យ ដោយ សរីរៈ មាត់ ធ្មេញ មាន សុខភាព ល្អ ផង ដែរ ។
កាល ពី ខែ មករា ប្រជាជន កម្ពុជា ៤ នាក់ ត្រូវ បាន គេ រាយការណ៍ ថា បាន ស្លាប់ ដោយ សារ តែ ជំងឺ គ្រុន ផ្តាសាយ បក្សី ៕
ព្រះរាជពិធីថ្វាយព្រះភ្លើងព្រះបរមរតន កោដ្ឋ បញ្ចប់ទៅទាំងក្តីអាឡោះ អាល័យ
ខ្ញុំ សូម ជូនពរ បង ប្អូន គ្រប់ ៗ រូប ប្រកប ដោយ សេចក្តី សុខ គ្រប់ ប្រការ អាយុ យឺន យូរ សុខភាព បរិបូរណ៍ ។
សូម បង ប្អូន បាន ទទួល ជោគជ័យ ដរាប គ្រប់ ការងារ ទាំង ឡាយ ដែល ត្រូវ បំពេញ នៅ ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ។
សូម បង ប្អូន គ្រប់ គ្នា ទាំង ខ្ញុំ ព្រះ មាតា រាជ រដ្ឋាភិបាល ប្រជារាស្ត្រ ទូទាំង ប្រទេស យើង លើក ដៃ ទូល ថ្វាយ លើក ដៃ ប្រណម្យ ថ្វាយ ព្រះរាជ កុសល ដ៏ ច្រើន បំផុត ថ្វាយ ព្រះ រាជ បិតា ជា ទីគោរព សក្ការៈ សូម ព្រះអង្គ បាន យាង ទៅ គ្រង រាជ្យ ទិព្វ សម្បត្តិ ឋានសួគ៌ និង សម្បត្តិ និព្វាន គង់ ប្រថាប់ នៅ ឋាន និព្វាន ជាមួយ ព្រះពុទ្ធ ជា អម្ចាស់ ជា រៀង រហូត » ។
ខ្ញុំ ស្តាយ ព្រះអង្គ ណាស់ ខ្ញុំ លែង បាន ឃើញ ស្នាម ញញឹម របស់ ព្រះអង្គ ទៀត ហើយ » ។
ព្រះរាជ ពិធី ថ្វាយ ព្រះ ភ្លើង ដល់ ព្រះ បរម សព បាន បញ្ចប់ ជាមួយ នឹង ការ ចែក អំណោយ ដល់ ទណ្ឌិត ដែល ត្រូវ ដោះ លែង បន្ទាប់ពី ព្រះមហាក្សត្រ និង សម្តេច ម៉ែ បាន ថ្វាយ ព្រះ ភ្លើង ដល់ ព្រះ បរម សព ព្រះអង្គ ទាំង ទ្វេ ក៏ បាន ព្រះរាជ ប្រទាន ជា វត្ថុ អនុស្សាវរីយ៍ ដល់ ភ្ញៀវ កិត្តិយស បរទេស ដែល បាន ជម្រាប លា ផង ដែរ ហើយ ពិធី ទាំង មូល ត្រូវ បាន បញ្ចប់ នៅ ម៉ោង ប្រមាណ ជា ៨ យប់ ។
លោក ហ៊ុន សែនជួបសវនា ការ ជាមួយឥស្សរជនប្រទេសនានា
ភ្នំពេញៈ ឥស្សរជន អ្នក នយោបាយ បរទេស ជាន់ ខ្ពស់ និង ថ្នាក់ ដឹក នាំ កំពូល ៗ នៃ បណ្តា ប្រទេស ជា មិត្ត កាល ពី ព្រឹក ថ្ងៃ ចន្ទ ម្សិលមិញ បាន សម្តែង នូវ សមាន ទុក្ខ និង សម្តែង ការ សោក ស្តាយ និង ទុក្ខ ក្រៀមក្រំ ជាមួយ ប្រជាជន កម្ពុជា នៅ ក្នុង ជំនួប ដាច់ ដោយ ឡែក ជាមួយ នឹង លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន នៅ វិមាន សន្តិភាព មុន នឹង អញ្ជើញ ចូលរួម ព្រះរាជ ពិធី ថ្វាយ ព្រះ ភ្លើង ព្រះ បរម សព ព្រះ បរម រតន កោដ្ឋ ដែល ចាប់ ផ្តើម ប្រារព្ធ ជា ផ្លូវ ការ នៅ វេលា ម៉ោង ៦ ល្ងាច ម្សិលមិញ ។
លោក អ៊ាង សុផល្លែត បាន ឲ្យ ដឹង ថា ព្រះអង្គ ម្ចាស់ ជប៉ុន អាគីស៊ីណូ ដែល ជា ព្រះអង្គ ម្ចាស់ ទី ២ របស់ ព្រះ ចៅ អធិរាជ ជប៉ុន បាន មាន ព្រះ រាជ បន្ទូល ទៅ កាន់ លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន ថា ទស្សនកិច្ច របស់ ព្រះអង្គ ម្ចាស់ នៅ ពេល នេះ គឺ ដឹក នាំ ប្រតិភូ មក ចូលរួម ថ្វាយ ព្រះ ភ្លើង ដល់ ព្រះ មហា វីរក្សត្រ ខ្មែរ ។
ដោយ ឡែក លោក ង្វៀន តាន់ យុង នាយក រដ្ឋ មន្ត្រី វៀតណាម បាន មាន ប្រសាសន៍ ថា ៖
ឆ្លៀត ឱកាស នេះ រដ្ឋាភិបាល វៀតណាម សូម ឆ្លៀត ជូនពរ និង ប្រសិទ្ធពរ ដល់ ប្រជាជន និង រដ្ឋាភិបាល កម្ពុជា ឲ្យ ទទួល បាន ជោគជ័យ និង ជម្នះ រាល់ ការ លំបាក ទាំង ឡាយ » ។
កាលពី ថ្ងៃ អាទិត្យ គណៈ ប្រតិភូ បរទេស មួយ ចំនួន បាន មក ដល់ កម្ពុជា ដែរ មាន ដូចជា នា យក រដ្ឋ មន្រ្តី ប្រទេស បារាំង មន្រ្តី ជាន់ ខ្ពស់ មក ពី សាធារណ រដ្ឋ កូរ៉េ ហ្វីលីពីន ឥណ្ឌា ម៉ាឡេស៊ី កាណាដា និង ប្រ៊ុយណេ ជាដើម ។
លោក ឆាយ ធី អ្នក សម្រប សម្រួល សមាគម ការពារ សិទ្ធិ មនុស្ស អាដ ហុក ខេត្ត រតនគិរី ក៏ បាន ឲ្យ ដឹង ផងដែរ ថា ក្រុមហ៊ុន ៧២ និង ក្រុម ហ៊ុន ជា ច័ន្ទ រិទ្ធ មាន ពាក់ ព័ន្ធ ការ កាប់ រាន ព្រៃ ឈើ ។
តំណាង ក្រុមហ៊ុន ជា ច័ន្ទ រិទ្ធ លោក ចាន់ ម៉ាប់ បាន ឲ្យ ដឹង ថា រហូត មក ដល់ ពេល នេះ ក្រុមហ៊ុន បាន ធ្វើ ការ ដាំដុះ ដំណាំ កៅស៊ូ បាន ប្រមាណ ៦០០ ហិកតា ហើយ ។
លោក ស្លៃ ម៉ាន់ ហាសាន់ បាន បញ្ជាក់ ថា ៖
លោក អនុ សេនីយ៍ ឯក វង្ស ប៊ុណ្ណា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ខណៈ កំពុង ឈរ យាម ប្រចាំ ការ នៅ ក្បែរ ព្រះ បរម រាជ វាំង នៅ ក្នុង ព្រះ រាជ ពិធី ថ្វាយ ព្រះ ភ្លើង ព្រះ បរម សព សម្តេច ឪ កាល ពី ម្សិលមិញ ថា លោក ត្រូវ បាន លោក ជួន សុវណ្ណ វាយ នៅ កណ្តាល ចំណោម សាធារណជន កាល ពី ព្រឹក ថ្ងៃ អាទិត្យ ។
លោក បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា៖
អារម្មណ៍ ក្តុកក្តួល នេះ គេ អាច មើល ឃើញ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ នានា តាម រយៈ ទឹក មុខ ការ សង្រួម កាយ ចិត្ត ការ ស្លៀក ពាក់ ការ នាំ គ្នា ទៅ គោរព ព្រះ បរម សព និង ការ លះ បង់ កម្លាំង កាយ ចិត្ត និង ទ្រព្យ ពី សំណាក់ ពលរដ្ឋ ទូទៅ ។
អ្នក ប្រើ ហ្វេសប៊ុក ម្នាក់ ទៀត បាន ថ្វាយ ព្រះ ពរ ជូន ព្រះ បិតា ជាតិ ថា៖
ខណៈ ម្នាក់ ទៀត បង្ហាញ ក្តី សោកស្តាយ ថា ៖
ប្រជា ពលរដ្ឋ គ្រប់ ៗ រូប រួម ទាំង រូប ខ្ញុំ ផ្ទាល់ កំពុង តែ សម្រក់ ទឹក ភ្នែក នឹក ស្តាយ ស្រណោះ ព្រះមហា វីរក្សត្រ ដ៏ ឆ្នើម ។
លោក ហូ វុទ្ធី អគ្គ នាយក នៃ ក្រសួង ការងារ បាន បញ្ជាក់ ថា នេះ នឹង ជា លើក ទី មួយ ហើយ ដែល ស្រ្តី បម្រើ ការងារ តាម ផ្ទះ ជនជាតិ កម្ពុជា នឹង ត្រូវ បញ្ជូន ទៅ ប្រទេស សិង្ហបុរី ។
ការ ផ្តល់ សិទ្ធិ ដល់ ស្រ្តី បម្រើ ការងារ តាម ផ្ទះ របស់ ប្រទេស សិង្ហបុរី ត្រូវ បាន គេ រិះគន់ ជា យូរ មក ហើយ ។
លោក ស្រី រា ម៉ាណា អ្នក សម្រប សម្រួល ផ្នែក សេរីភាព បញ្ចេញ មតិ នៃ មជ្ឈមណ្ឌល សិទិ្ធ មនុស្ស កម្ពុជា បាន ថ្លែង ថា មូល ហេតុ របស់ នគរបាល ក្នុង ការ មក រឹប អូស បែប នេះ គឺ មិន សម ស្រប ទេ ។
គាត់ គ្រាន់ តែ សម្តែង សេរីភាព បញ្ចេញ មតិ នៅ ផ្ទះ របស់ គាត់ ។
លោក ស្រី បាន បន្ត ឲ្យ ដឹង ថា មាន តែ ពលរដ្ឋ ពីរ គ្រួសារ ប៉ុណ្ណោះ នៅ ក្នុង ខេត្ត កណ្តាល ដែល មាន បិទ ប្រតិទិន យុតិ្តធម៌ របស់ លោក ម៉ម សូណង់ ដូ ។
វា ជា សមត្ថកិច្ច របស់ ក្រុម ប្រឹក្សា ឃុំ ៕
លោក រី សិទ្ធីណែត បាន បន្ថែម ថា លោក ជា មុនី ប្រធាន សហជីព សេរី កម្មករ បាន ចុះ ទៅ ចរចា ជាមួយ នឹង មន្រ្តី រោង ចក្រ ដើម្បី ឲ្យ ទទួល យក សកម្មជន សហជីព ចំនួន ៥ នាក់ ចូល ធ្វើ ការ វិញ ។
កម្មករ ម្នាក់ ឈ្មោះ ហោ រ៉ា បាន ថ្លែង កាល ពី ម្សិលមិញ ថា ក្រុមហ៊ុន បាន កាត់ ប្រាក់ ឈ្នួល ប្រចាំ ថ្ងៃ ៥០ ភាគរយ ចាប់ តាំង ពី ពេល លោក ចូល រួម ធ្វើ កូដកម្ម ។
ស្ត្រី ចំណាស់ ម្នាក់ ឈ្មោះ ពិន ណយ អាយុ ៧១ ឆ្នាំ មក ពី ខេត្ត ព្រៃវែង បាន ថ្លែង ថា៖
ប៉ុន្តែ មិន អនុញ្ញាត ឲ្យ យក ទៀន ធូប ផ្កា ទឹក សុទ្ធ ចូល ទីតាំង វាល ព្រះ មេរុ ឡើយ ។
លោក សុខ សុគន្ធ ប្រធាន មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ បាន ឲ្យ ដឹង ថា នៅ ក្នុង រយៈ ពេល បី ថ្ងៃ កន្លង មក នេះ មាន ប្រជា ពលរដ្ឋ ប្រមាណ ជាង ១០០០ នាក់ បាន វិល មុខ ឈឺ ក្បាល ខ្យល់ ចាប់ ជា ដើម ។
ទិដ្ឋភាព នៅ ខាង ក្រៅ ព្រះ បរម រាជ វាំង កាល ពី ព្រឹក ថ្ងៃ សុក្រ មាន សភាព ស្រងូត ស្រងាត់ ។
សម្តេច ឪ បាន ធ្វើ អ្វី ៗ គ្រប់ យ៉ាង ដើម្បី ប្រជានុរាស្រ្ត ព្រះ អង្គ ដូច ជា ដណ្តើម ឯករាជ្យ ពី បារាំង » ។
អ្នក ស្រី សេង ស អាយុ ៦៧ ឆ្នាំ អង្គុយ លើ ដី ក្បែរ ទីលាន ថ្វាយ ព្រះ ភ្លើង ហើយ បាន រង់ចាំ ក្បួន ដង្ហែ ។
មន្រ្តី បាន អង្គុយ លើ ចិញ្ចើម ផ្លូវ នៅ ជុំ វិញ ព្រះ បរម រាជ វាំង ចំណែក ឯ អ្នក មក ពី ខេត្ត នានា អង្គុយ ក្រោម ម្លប់ ប៉ាណូ មាន ព្រះឆាយាល័ក្ខណ៍ សម្តេច ឪ ។
លោក ឡេស អ៊ីត្រេស មន្រ្តី ពី ក្រសួង សុខាភិបាល ដែល ត្រៀម បម្រុង នៅ ក្នុង តង់ មុខ រដ្ឋ សភា ចាស់ បាន ថ្លែង ថា លោក បាន ព្យាបាល អ្នក សន្លប់ តែ ពីរ នាក់ ប៉ុណ្ណោះ ។
ខ្ញុំ សោកស្តាយ ចំពោះ ការ បាត់ បង់ សម្តេច ឪ ។
ភ្លេង ស្គរ ត្រែ បាន បន្លឺ តាម ផ្លូវ រាជធានី ភ្នំពេញ ខណៈ ដែល ព្រះ រាជ ដង្ហែ ធ្វើ ដំណើរ យឺត ៗ ពី ព្រះបរម រាជ វាំង ។
មន្រ្តី បាន ព្យាករ ថា ប្រជាជន មក កាន់ ទុក្ខ ប្រមាណ មួយ លាន នាក់ នឹង មក ចូល រួម ពិធី ដង្ហែ កាល ពី ថ្ងៃ សុក្រ ប៉ុន្តែ ចំនួន ពិត ប្រាកដ មាន ច្រើន ជាង នេះ ។
អេក្រង់ ទូរទស្សន៍ ត្រូវ បាន ដាក់ បញ្ចាំង នៅ ជុំវិញ រាជធានី ក្នុង គោល បំណង កុំ ឲ្យ មាន ចំនួន ប្រជាជន ណែន ខ្លាំង ពេក ប៉ុន្តែ ប្រជា ជន ដែល ឈប់ ដំណើរ មើល តាម អេក្រង់ នោះ គឺ មាន ចំនួន មិន ច្រើន ទេ ។
តាម បណ្តោយ មហា វិថី នរោត្តម ស្ត្រី ចំណាស់ ឈ្មោះ សុធា អាយុ ៧៦ ឆ្នាំ បាន ដើរ ដោយ ថ្មើរ ជើង ឆ្ពោះ ទៅ វិមាន ឯករាជ្យ ដើម្បី មើល ក្បួន ដង្ហែ ជា មួយ នឹង កូន ស្រី និង ចៅ ស្រី ។
ខ្ញុំ សង្ឃឹម ថា មន្រ្តី នៅ ក្នុង រដ្ឋាភិបាល នឹង យក គំរូ តាម ព្រះ អង្គ ហើយ យើង សូម បន់ ស្រន់ ឲ្យ ព្រះ អង្គ នាំ សេចក្តី សុខ វិបុលភាព និង ការ អភិវឌ្ឍ មក ដល់ ប្រទេស កម្ពុជា ។
បរិយាកាស ទូទៅ ប្រកប ដោយ សេចក្តី ក្រៀមក្រំ ប្រជាជន ជាច្រើន មាន អារម្មណ៍ កាន់ តែ ក្តុក ក្តួល ទៅ ៗ ខណៈ ការ កាន់ ទុក្ខ កំពុង បន្ត ។
ឈ្មោះ កម្ពុជា ដ៏ ល្អ គឺ សំខាន់ ខ្លាំង ណាស់ ចំពោះ ព្រះ អង្គ គឺ សំខាន់ ដូច នឹង បូរណភាព ទឹក ដី និង ឯកភាព កម្ពុជា ដែរ ។
ជាង នេះ ផង ដែរ វា ចាំបាច់ ត្រូវ បង្ហាញ ឲ្យ ឃើញ ថា ប្រទេស លោក ខាង លិច ភាគ ច្រើន បំផុត និង ប្រទេស អាស៊ាន ទាំង អស់ បែរ ជា ប្រឆាំង នឹង ព្រះ អង្គ ជា បន្ត បន្ទាប់ ចាប់ តាំង ពី រដ្ឋ ប្រហារ ១៩៧០ ដូច្នេះ អ្នក ដែល គាំទ្រ ព្រះ អង្គ គឺ មាន តែ ពួក ក្រុម កុម្មុយនីស្ត ឬ ប្រទេស មិន ចូល បក្ស សម្ព័ន្ធ តែ ប៉ុណ្ណោះ ។
ព្រះ អង្គ គឺជា បុរស សីហនុ ដែល មិន បាន ចាប់ អារម្មណ៍ នឹង ប្រាក់ ទេ គឺ ចាប់ អារម្មណ៍ តែ ប្រទេស កម្ពុជា របស់ ព្រះ អង្គ ប៉ុណ្ណោះ ៕
អនាគតសកម្មជនថៃម្នាក់ទៀតមិនទាន់ច្បាស់
ព្រះមហាក្សត្រ នរោត្តម សីហមុនី បុត្រា ព្រះ បាទ ន រោត្តម សីហនុ នឹង លើក លែង ទោស អ្នក ជាប់ ពន្ធនាគារ ជិត ៤០០ នាក់ ទៀត នៅ ថ្ងៃ នេះ ពេល ថ្វាយ ព្រះ ភ្លើង ។
អ្នក ទាំង ពីរ ត្រូវ បាន ចាប់ ខ្លួន ក្នុង ខេត្ត បន្ទាយ មានជ័យ កាល ពី ឆ្នាំ ២០១០ ខណៈ ពេល កំពុង ត្រួត ពិនិត្យ តំបន់ ព្រំដែន ដែល ទាមទារ ដោយ ថៃ ។
លោក បញ្ជាក់ កាល ពី ថ្ងៃ សៅរ៍ ថា៖
ក្រុម ប្រឹក្សាស្រុកឈូកបដិសេធលិខិត ACU ព្រមានលោកជា ប៉ូច
ប្រធាន អង្គភាព ប្រឆាំង អំពើ ពុករលួយ សរសេរ ថា ដោយ សារ មាន ព័ត៌មាន ខាង លើ ទើប មន្ត្រី នគរបាល យុត្តិធម៌ អង្គភាព បាន ទាក់ទង ទៅ សាក្សី ទាំង បួន មក ធ្វើ ការ បញ្ជាក់ បំភ្លឺ ដើម្បី មាន ភស្តុតាង កសាង បែប បទ នីតិវិធី ច្បាប់ ។
លោក ប្រធាន អង្គភាព សរសេរ ថា ៖
លោក ឱម យ៉ិនទៀង មិន អាច ទាក់ទង សុំ ការ អធិប្បាយ បាន ទេ កាលពី ថ្ងៃ អាទិត្យ ម្សិលមិញ ៕
សមាគមអ្នក សារព័ត៌មាន តវ៉ាការ ផ្តន្ទាទោសអ្នក កាសែតបារាំង
អង្គការ អាដហុក បាន ថ្លែង នៅ ក្នុង សេចក្តី ថ្លែងការណ៍ របស់ ខ្លួន ថា ខ្សែភាព យន្ត ឯកសារ នោះ បាន ធ្វើ ឲ្យ មន្រ្តី ខឹង ផង ដែរ ដែល ចាត់ ទុក ថា បាន រៀប រាប់ មិន ល្អ អំពី ប្រទេស កម្ពុជា ។
ផ្សោត ២ ក្បាលឃើញងាប់នៅឆ្នេរសមុទ្រកំពត
ដោយ បដិសេធ ថា មិន មែន ជា ផ្សោត ក្នុង ដែន ទឹក កម្ពុជា លោក នាយ ខណ្ឌ រដ្ឋបាល ជល ផល រូប នេះ និយាយ ថា អាជ្ញាធរ តែង តែ ធ្វើ ការ អប់រំ ណែនាំ ប្រជា នេសាទ ឲ្យ យល់ ពី ការ អភិរក្ស ត្រី ផ្សោត និង សត្វ ងាយ រង គ្រោះ ថ្នាក់ មួយ ចំនួន ដូចជា សត្វ ជ្រូក ទឹក និង អណ្តើក សមុទ្រ ជាដើម ដែល មាន នៅ ក្នុង រង្វង់ ដែន អភិរក្ស ស្មៅ សមុទ្រ ស្ថិត ក្នុង ទឹក ដី នៃ ខេត្ត កែប និង កំពត លាត សន្ធឹង លើ ផ្ទៃ សមុទ្រ ប្រមាណ ៣០០០ ហិកតា ។
ព្រះបរមរាជ វាំងបិទទ្វារមិនទទួលភ្ញៀវទេសចរ ៧ ថ្ងៃ
សេចក្តី ប្រកាស នេះ ត្រូវ បាន ធ្វើ ឡើង តាម រយៈ ការ សរសេរ អក្សរ នៅ លើ ក្តារ ឆ្នួន ដាក់ នៅ មាត់ ច្រក ចូល ព្រះវិហារ ព្រះ កែវ មរក ត ឬ ព្រះ បរម រាជ វាំង ក្នុង រាជធានី ភ្នំពេញ ដែល មាន ជា ភាសា ខ្មែរ និង ភាសា អង់គ្លេស ។
មន្ត្រី នគរបាល យាម ព្រះ បរម រាជ វាំង បាន និយាយ ក្នុង លក្ខខណ្ឌ សុំ មិន បញ្ចេញ ឈ្មោះ បាន ឲ្យ ដឹង ថា ព្រះ បរម រាជ វាំង ចង់ រក្សា បរិយាកាស ស្ងប់ស្ងាត់ នៅ ក្នុង អំឡុង ពេល ចូល រួម កាន់ ព្រះ បរម មរណ ទុក្ខ លើក ទី ពីរ ដើម្បី សម្ដែង ការ គោរព ជា លើក ចុង ក្រោយ ចំពោះ សម្ដេច ព្រះ មហា វីរក្សត្រ ។
ទន្ទឹម នឹង ការ បិទ តំបន់ ទេសចរណ៍ នេះ មន្ទីរ កសិកម្ម រាជធានី ភ្នំពេញ បាន ធ្វើ ការ ហាម ឃាត់ យានយន្ត គ្រប់ ប្រភេទ មិន ឲ្យ ដឹក សត្វ មាន់ ទា ចាប់ ពី រង្វង់ មូល ចោម ចៅ ដែល ស្ថិត នៅ លើ មហា វិថី សហព័ន្ធ រុស្ស៊ី ព្រះ នរោត្ដម ព្រះ សីហនុ និង មហា វិថី ព្រះស៊ីសុវត្ថិ ។
លោក ស៊ាង បូរិន ប្រធាន មន្ទីរ កសិកម្ម រាជធានី ភ្នំពេញ បាន ឲ្យ ដឹង ពី ថ្ងៃ ព្រហស្បតិ៍ ថា ក្រុម មន្ត្រី របស់ លោក នៅ ខណ្ឌ ទាំង ៩ ចាប់ ផ្ដើម ចុះ ពិនិត្យ មើល គ្រប់ ផ្លូវ ធំ ៗ ទាំង អស់ ក្រែង លោ មាន អ្នក លក់ មាន់ ទា ដឹក ឆ្លង កាត់ ផ្លូវ ដែល បាន ហាម ឃាត់ ទាំង នេះ ។
រីឯ ទង់ ជាតិ នៅ ទូទាំង ប្រទេស ត្រូវ បង្ហូត ត្រឹម ១ភាគ បី នៃ ដង ចំណែក សកម្មភាព កម្សាន្ត សប្បាយ នានា រួម ទាំង នៅ តាម កញ្ចក់ ទូរទស្សន៍ និង វិទ្យុ ជាដើម ត្រូវ ផ្អាក មួយ រយៈ សិន ។
សូម រំឭក ថា ក្នុង ព្រះ រាជ ពិធី បុណ្យ ដង្ហែ និង ថ្វាយ ព្រះ ភ្លើង ព្រះ បរម សព ព្រះបរម រតន កោដ្ឋ សម្តេច ព្រះ នរោត្តម សីហនុ រាជ រដ្ឋាភិបាល ក៏ បាន អនុញ្ញាត ឲ្យ មន្ត្រី រាជការ និង កម្មករ រោង ចក្រ កាត់ ដេរ ឈប់ សម្រាក រយៈ ពេល ពីរ ថ្ងៃ នៅ ថ្ងៃ ទី ១ និង ថ្ងៃ ទី ៤ ខែកុម្ភៈ នេះ ផង ដែរ ។
អគ្គ ស្នងការ នគរបាល ជាតិ ក៏ បាន សម្រេច ដាក់ ពង្រាយ កង កម្លាំង សមត្ថកិច្ច ចម្រុះ មាន នគរបាល ជាតិ កង រាជ អាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង យោធា សរុប ចំនួន ជាង ១ ម៉ឺន នាក់ នៅ តាម គោលដៅ សំខាន់ ៗ ដើម្បី ធានា សន្តិសុខ សុវត្ថិភាព និង សណ្ដាប់ ធ្នាប់ សាធារណៈ ចាប់ ពី ថ្ងៃ ទី ១ ដល់ ថ្ងៃ ទី ៧ ខែ កុម្ភៈ ឆ្នាំ ២០១៣ ខាង មុខ នេះ ។
គួរ រំឭក ថា អតីត ព្រះមហាក្សត្រ ព្រះបរម រតន កោដ្ឋ ព្រះ មហា វីរក្សត្រ ព្រះបាទ ន រោត្តម សីហនុ បាន សោយ ទិវង្គត នៅ ថ្ងៃទី ១៥ ខែ តុលា ២០១២ វេលា ម៉ោង ១:
គណបក្ស សង្គ្រោះ ជាតិកម្ពុជានឹងលើកស្លាក ១ម៉ឺន
លោក យឹម សុវណ្ណ អ្នក នាំ ពាក្យ គណបក្ស សម រង្ស៊ី បាន ថ្លែង ថា៖
គណបក្ស សម រង្ស៊ី និង គណបក្ស សិទិ្ធ មនុស្ស ជា គណបក្ស ប្រឆាំង ពីរ ដែល បង្រួប បង្រួម គ្នា ដើម្បី បង្កើត គណបក្ស សង្គ្រោះ ជាតិ កម្ពុជា បាន ប្រកាស កាល ពី ម្សិលមិញ ថា ពួក គេ នឹង រៀប ចំ កិច្ច ប្រជុំ សំខាន់ ៗ នៅ ក្នុង ខែ មេសា ខាង មុខ នេះ ដើម្បី ធ្វើ ការ បង្រួប បង្រួម ផ្លូវ ការ និង សម្រាប់ ត្រួសត្រាយ ឆ្ពោះ ទៅ រំលាយ គណបក្ស រៀង ៗ ខ្លួន ឲ្យ ទៅ ជា បក្ស ប្រឆាំង តែ មួយ វិញ នៅ កម្ពុជា ។
លោក ប៉ុល ហំម អ្នក នាំ ពាក្យ គណបក្ស សិទិ្ធ មនុស្ស បាន ឲ្យ ដឹង ថា បន្ទាប់ ពី មហា សន្និបាត របស់ គណបក្ស សិទិ្ធ មនុស្ស នៅ ថ្ងៃ ទី ៦ ខែ មេសា លោក កឹម សុខា នឹង ក្លាយ ជា អនុប្រធាន គណបក្ស សង្គ្រោះ ជាតិ កម្ពុជា ជា ផ្លូវ ការ៕
ចៅក្រមសម្រេចឲ្យ នួន ជាសម្រាកថែមមួយ អាទិត្យ
ភ្នំពេញៈ ចៅក្រម នៃ អង្គ ជំនុំ ជម្រះ ដំបូង របស់ សាលា ក្តី ខ្មែរ ក្រហម បាន ប្រកាស ជា សាធារណៈ កាល ពី ម្សិល មិញ ថា លោក នួន ជា បាន ចេញ ពី មន្ទីរ ពេទ្យ ពី ថ្ងៃ ព្រហស្បតិ៍ បន្ទាប់ ពី បាន ដេក ព្យាបាល ជំងឺ រលាក ទង សួត ធ្ងន់ធ្ងរ អស់ ២ សប្តាហ៍ កន្លះ ប៉ុន្តែ តុលាការ បាន បង្គាប់ ឲ្យ សម្រាក ២ សប្តាហ៍ ជា បន្ត ទៀត ។
លោក និល ណុន ប្រធាន អង្គ ជំនុំ ជម្រះ បាន ផ្អាក សវនាការ លើ ឯកសារ ភស្តុតាង កាល ពី ម្សិលមិញ ពេល ជិត ដល់ ម៉ោង សម្រាក ព្រោះ ចៅក្រម ត្រូវ ពិភាក្សា គ្នា ។
ក្រុម មេធាវី ការ ពារ ក្តី លោក អៀង សារី ទទូច ម្តង ហើយ ម្តង ទៀត ថា កូន ក្តី ពុំ មាន ស្មារតី គ្រប់គ្រាន់ ក្នុង ការ តាម ដាន អង្គ សវនាការ ទេ ។
លោក សុន អារុណ សហ មេធាវី ការពារ ក្តី លោក នួន ជា បាន ថ្លែង បន្ទាប់ ពី សវនាការ ថា លោក នួន ជា មាន សុខភាព ល្អ ប្រសើរ ជាង ពី ម្សិលមិញ បន្តិច ប៉ុន្តែ សុខភាព គាត់ មិន ល្អ ប្រសើរ ច្រើន ប៉ុន្មាន ទេ ។
មុន ពេល ចៅក្រម បង្អាក់ សវនាការ ព្រះ រាជ អាជ្ញា បង្ហាញ ឯកសារ បន្ថែម កាល ពី ម្សិលមិញ ទាក់ ទង នឹង តួនាទី លោក ខៀវ សំផន ក្នុង របប ខ្មែរ ក្រហម រាប់ ទាំង ជា ប្រមុខ រដ្ឋ និង ក្រសួង ពាណិជ្ជកម្ម ។
ក្នុង ចំណោម ឯកសារ ដែល ពិភាក្សា អំពី ការ ធ្វើ វិសុទ្ធកម្ម ការ សម្លាប់ និង ភាព អត់ ឃ្លាន ព្រះ រាជ អាជ្ញា ស្រង់ ពី ឯកសារ មួយ ដែល ក្រសួង ពាណិជ្ជកម្ម របស់ លោក ខៀវ សំផន សន្យា នៅ ឆ្នាំ ១៩៧៨ ថា នឹង នាំ ចេញ ស្រូវ រាប់ ពាន់ តោន កាហ្វេ ម្រេច និង សណ្តែក ទៅ ម៉ាដាហ្គាស្កា យូហ្គូ ស្លាវី និង ចិន ដែល ជា ប្រទេស ប្លុក កុម្មុយនីស្ត ដូច គ្នា ។
លោក និល ណុន បាន ថ្លែង ថា តុលាការ នឹង ចាប់ ផ្តើម សវនាការ ឡើង វិញ នៅ ថ្ងៃ អង្គារ សប្តាហ៍ ក្រោយ លោក ខៀវ សំផន នឹង មាន វត្តមាន ក្នុង សវនាការ ស្តីពី ឯកសារ ដែល នៅ សល់ ទាក់ទង នឹង រូប លោក ចំណែក ឯ លោក អៀង សារី ត្រូវ តាម ដាន សវនាការ ពី បន្ទប់ ឃុំ ឃាំង មក ៕
សៀវភៅលើកសរសើរសម្តេចឪ ចេញលក់ហើយ
លោក ដឺ លុច បាន បន្ថែម ទៀត ថា សៀវភៅ អនុស្សាវរីយ៍ នេះ គឺ បាន បង្ហាញ នូវ ចំណាប់ អារម្មណ៍ របស់ មេ ដឹក នាំ ទូទាំង ពិភពលោក ដែល បាន ផ្តោត មក លើ សម្តេច ឪ ប្រជាពលរដ្ឋ កម្ពុជា គ្រប់ ស្រទាប់ វណ្ណៈ បាន សំដែង ទឹក ចិត្ត សោកស្តាយ ព្រះអង្គ ។
មិន ត្រឹម តែ អ្នក សារព័ត៌ មាន មួយ ក្រុម នេះ ទេ ដែល ខិតខំ ចង ក្រង អនុវស្សា វរីយ៍ អំពី អង្គ សម្តេច ឪ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន បោពុម្ព ក្រដាស ប្រាក់ ១០០០ រៀល ប្រភេទ ថ្មី ដែល មាន ព្រះ ឆាយា លក្ខណ៍ របស់ សម្តេច ឪ និង បុស្បុក ដែល ដឹក ព្រះ មញ្ជូសា ពី ប្រទេស ចិន ក៏ បាន ដាក់ ឲ្យ ចរាចរ ប្រើប្រាស់ ផង ដែរ ដើម្បី រំឭក ពី គុណូ បការៈ និង ស្នា ព្រះហស្ត របស់ ព្រះ អង្គ ។
ប្រជា សហគមន៍ថ្មគោលទៅដាក់ ញត្តិនៅទូតបារាំង
ភ្នំពេញៈ ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ ថ្ម គោល ជាប់ ព្រលាន យន្ត ហោះ អន្តរជាតិ ភ្នំពេញ រួម នឹង សហគមន៍ ក្រីក្រ មួយ ចំនួន ទៀត ក្នុង រាជធានី ភ្នំពេញ ប្រមាណ ជាង ១០០ នាក់ បាន នាំ គ្នា ទៅ តវ៉ា នៅ ស្ថាន ទូត បារាំង នៅ ភ្នំពេញ ដើម្បី ដាក់ ញ តិ្ត សុំ កិច្ច អន្តរាគមន៍ ពី លោក ឯក អគ្គ រដ្ឋទូត ជួយ បញ្ឈប់ គម្រោង បណ្តេញ ប្រជាជន ចេញ ពី គម្រោង អភិវឌ្ឍន៍ ព្រលាន យន្ត ហោះ របស់ ក្រុមហ៊ុន បារាំង ។
អ្នក ស្រី ច្រាយ នីម អ្នក តំណាង ម្នាក់ របស់ ពលរដ្ឋ ១៨២ គ្រួសារ បាន ប្រាប់ ថា៖
អ្នក ស្រី បន្ត ថា បច្ចុប្បន្ន ប្រជា សហគមន៍ កំពុង ព្រួយ បារម្ភ ជា ខ្លាំង តាំង ពី ទទួល បាន លិខិត ជូន ដំណឹង ពី អាជ្ញាធរ ដែនដី កាល ពី ថ្ងៃ ទី ២៥ ខែ កក្កដា ឆ្នាំ មុន ដែល បាន បង្គាប់ ឲ្យ អ្នក មាន ផ្ទះ ១០ ម៉ែត្រ ពី របង ព្រលាន យន្ត ហោះ អន្តរជាតិ ភ្នំពេញ រុះរើ ផ្ទះ ចេញ ក្នុង រយៈ ពេល ៧ ថ្ងៃ ឲ្យ រួច ដោយ មិន បញ្ជាក់ ពី ការ ផ្ដល់ សំណង អ្វី ទាំងអស់ ។
ក្នុង អំឡុង ពេល នោះ រូប គាត់ និង អ្នក ភូមិ ៧នាក់ ផ្សេង ទៀត ត្រូវ សមត្ថកិច្ច ចាប់ ឃាត់ ខ្លួន ជាង ១០ ម៉ោង ។
តំណាង ប្រជា ពលរដ្ឋ ម្នាក់ ទៀត អ្នក ស្រី ខៀវ សាវី បាន និយាយ ថា គាត់ នៅ តែ បារម្ភ ពី ការ បណ្ដេញ ចេញ ពី លំនៅដ្ឋាន នា អនាគត ដ៏ ខ្លី នេះ បើ ទោះ ជា ក្នុង អំឡុង ប្រទេស កម្ពុជា ជាប់ រវល់ ក្នុង ពិធី កាន់ ទុក្ខ ព្រះបរម សព សម្តេច ឪ អាជ្ញាធរ បាន នៅ ស្ងាត់ ស្ងៀម មិន ចាត់ ការ រុះរើ លំនៅដ្ឋាន ពួក គាត់ ក្ដី ។
ពន្យារប្រកាសសាល ដីការឿងក្តី ម៉ឹក ដារ៉ា ជាលើកទី២
យោង តាម លោក រ៉ៃ ប៊ុន ធឿន មេធាវី ការពារ លោក ម៉ឹក ដារ៉ា បាន បញ្ជាក់ ឲ្យ ដឹង ថា សាលា ឧទ្ធរណ៍ បាន ប្រកាស ថា តុលាការ នៅ មិន ទាន់ ប្រកាស សេចក្តី សម្រេច រឿង ក្តី នេះ ក្នុង គោល បំណង ដើម្បី បន្ត ពិនិត្យ សំណុំ រឿង ដ៏ ច្រើន នេះ ឲ្យ បាន ល្អិត ល្អន់ និង ច្បាស់ លាស់ ។
រឿង ក្តី លោក ម៉ឹក ដារ៉ា ត្រូវ អាន ៧៥០០ ទំព័រ ។
កាល ពី ខែ មក រា ឆ្នាំ ២០១២ លោក ម៉ឹក ដារ៉ា និង លោក ជា ឡេង ត្រូវ បាន ផ្តន្ទាទោស ឲ្យ ជាប់ ពន្ធនាគារ មួយ ជីវិត ដោយ សាលា ដំបូង ខេត្ត បន្ទាយ មានជ័យ ពី បទ ប្រព្រឹត្ត ពុករលួយ និង ជួញ ដូរ គ្រឿង ញៀន ច្រើន ករណី ។
លោក ចៅក្រម ចាយ ច័ន្ទ តារា វណ្ណ និង លោក ព្រះរាជ អាជ្ញា ង៉ែត សារ៉ាត ពុំ អាច ទាក់ទង សុំ ការ អត្ថាធិប្បាយ បាន ទេ កាល ពី ម្សិលមិញ ៕
តុលាការកោះហៅពលរដ្ឋ បីនាក់ឲ្យបំភ្លឺរឿងក្លែងឯកសារ
លោក បាន ឲ្យ ដឹង ទៀត ថា នៅ ក្នុង ខែ មិថុនា លោក បាន ដើរ ប្រមូល ស្នាម មេដៃ ពី ពលរដ្ឋ ចំនួន ៥២ នាក់ ដើម្បី ដាក់ ទៅ ក្រសួង កសិកម្ម ទីស្តីការ គណៈ រដ្ឋ មន្ត្រី និង ក្រសួង បរិស្ថាន ដើម្បី សួរ នាំ រឿង ដី ព្រៃ សហគមន៍ ប៉ុន្តែ បែរ ជា មាន ចេញ លិខិត កោះ ហៅ ទៅ វិញ ។
រីឯ លោក តន់ សីហតេជៈ ព្រះរាជអាជ្ញា អម សាលា ដំបូង ខេត្ត ក៏ ពុំ អាច ទាក់ទង ដើម្បី ធ្វើ ការ អត្ថាធិប្បាយ បាន ដែរ ៕
សមត្ថកិច្ចពាក់ព័ន្ធត្រៀម ជា ស្រេចក្នុងការ ការពារក្បួន ដង្ហែនិងថ្វាយព្រះភ្លើងព្រះបរម សព
ប៉ុន្តែ ថា តើ អាជ្ញាធរ មាន បំណង បញ្ចៀស គ្រោះ ថ្នាក់ ដូច ជា គ្រោះ ថ្នាក់ ស្លាប់ មនុស្ស ៣៥៣ នាក់ ក្នុង អំឡុង ពិធី បុណ្យ អុំ ទូក កាល ពី ឆ្នាំ ២០១០ នោះ ដោយ របៀប ណា គឺជា សេចក្តី លម្អិត មួយ ដែល មន្រ្តី ជាន់ ខ្ពស់ ពុំ បាន បក ស្រាយ ច្បាស់ លាស់ ឡើយ ។
ដោយ គ្មាន សេចក្តី លម្អិត ទាំង នេះ នគរបាល ទាហាន និង ក្រុម គ្រូ ពេទ្យ បាន ប្រចាំ ការ តាម ផ្លូវ ក្បែរ ព្រះ បរម រាជ វាំង កាល ពី ម្សិល មិញ បាន បង្ហាញ អំពី ការ ហ្វឹកហាត់ និង ការ អប់រំ ដែល ពួក គេ បាន ឆ្លង កាត់ ចាប់ តាំង ពី សម្តេច ឪ សោយទិវង្គត ក្នុង ជន្ម នាយុ ៩០ ព្រះ វស្សា នៅ ទីក្រុង ប៉េកាំង កាល ពី ថ្ងៃ ទី១៥ ខែ តុលា ។
មន្រ្តី ម្នាក់ នេះ ជា មនុស្ស ម្នាក់ ស្ថិត ក្នុង ចំណោម កង កម្លាំង ប្រដាប់ អាវុធ ប្រហែល ១២០០០ នាក់ ដែល នឹង ដើរ ល្បាត លើ វិថី ក្នុង រាជ ធានី ភ្នំពេញ រាប់ ទាំង ផ្លូវ ប្រវែង ៦ គីឡូម៉ែត្រ សម្រាប់ ពិធី ដង្ហែ នៅ ថ្ងៃ សុក្រ ផង ដែរ ។
សមាជិក អង្គភាព ប្រឆាំង ភេវកម្ម នៃ កង យោធពល ខេមរភូមិន្ទ ដែល ចូល រួម ហ្វឹកហាត់ ល្បាត នៅ ផ្លូវ ព្រះស៊ីសុវត្ថិ បាន ថ្លែង ថា លោក នឹង កាន់ កាំភ្លើង ស្វ័យ ប្រវត្តិ ផលិត នៅ ចិន ដែល បាញ់ ចេញ ១០០ គ្រាប់ ក្នុង មួយ នាទី ។
មន្រ្តី នគរបាល ដែល ដើរ ល្បាត នៅ ព្រះ បរម រាជ វាំង បាន ថ្លែង ថា ការ ការ ពារ សន្តិសុខ ត្រូវ បាន កំណត់ លម្អិត រួច ហើយ ប៉ុន្តែ លោក មិន រៀបរាប់ លម្អិត ឡើយ ។
អ្នក បើក បរ រថយន្ត សាមុយ ម្នាក់ ឈរ ជើង ក្បែរ នោះ ដែល ជា រថយន្ត មួយ ក្នុង ចំណោម រថយន្ត ២៥ គ្រឿង ដែល ក្រសួង សុខាភិបាល នឹង ដាក់ ពង្រាយ ក្នុង អំឡុង ពិធី ដង្ហែ និង ថ្វាយ ព្រះភ្លើង បាន និយាយ ថា លោក ត្រៀម ខ្លួន សម្រាប់ ការ ហូរ ចូល របស់ ប្រជាជន ប៉ុន្តែ លោក សង្ឃឹម ថា ហ្វូង មនុស្ស នឹង បើក ផ្លូវ ក្នុង គ្រា អាសន្ន ។
លោក យឹម ដេត ប្រធាន នៅ តង់ គ្រូ ពេទ្យ ក្បែរ ព្រះ បរម រាជ វាំង ពី មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ បាន ថ្លែង ថា អាជ្ញាធរ មាន ផែន ការ បម្រុង ដើម្បី ដឹក ជញ្ជូន ជន រង គ្រោះ ទៅ មន្ទីរ ពេទ្យ ។
លោក ដេង បាន បន្ត ថា មន្រ្តី សុខាភិបាល ប្រហែល ៣០០ នាក់ ស្ថិត ក្រោម ការ បញ្ជា របស់ លោក ហើយ បាន ត្រៀម ខ្លួន ជា ច្រើន សម្រាប់ បញ្ហា ប្រឈម ខាង មុខ ។
អាជ្ញាធរ បាន រៀន សូត្រ ពី សោនាកដកម្ម នោះ និង ពី ការ ដោះ ស្រាយ មនុស្ស ១០០ នាក់ ដែល សន្លប់ ក្នុង អំឡុង ពេល ព្រះ បរម សព យាង ត្រឡប់ ពី ទីក្រុង ប៉េកាំង កាល ពី ថ្ងៃ ទី ១៨ ខែ តុលា ពេល នោះ មនុស្ស ប្រហែល ១ លាន នាក់ បាន ឈរ តាម ផ្លូវ ពី អាកាស យានដ្ឋាន ទៅ ព្រះ បរម រាជ វាំង ដើម្បី សម្តែង គាវរកិច្ច ។
លោក គៀត ចន្ទ ថា រិទ្ធ អ្នក នាំ ពាក្យ អគ្គ ស្នងការ នគរបាល ជាតិ បាន ថ្លែង ថា កង កម្លាំង ប្រដាប់ អាវុធ នឹង ស្ថិត ក្រោម បញ្ជា របស់ ឧបនាយ រដ្ឋ មន្រ្តី ស ខេង ។
លោក ខៀវ សុភ័គ អ្នក នាំ ពាក្យ ក្រសួង មហាផ្ទៃ បាន ថ្លែង ថា មាន ការ យក ចិត្ត ទុក ដាក់ ខ្លាំង លើ សន្តិសុខ ។
ក្នុង សុន្ទរកថា នៅ កោះ ពេជ្រ កាល ពី ថ្ងៃ ទី ២៩ ខែ មករា លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន បាន ជំរុញ ប្រជាជន ឲ្យ ប្រុងប្រយ័តុ្ន នៅ ក្នុង អំឡុង ពិធី ដង្ហែ ព្រះ បរម សព ។
អ្នក ទោសថាការ លើកលែងទោសមិនប្រក្រតី
ស្ត្រី ចំនួន ១២ នាក់ ដែល បាន ទូរស័ព្ទ ទាំង យប់ ទាំង ថ្ងៃ មក កាន់ កាសែត ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ អង្គារ និង ថ្ងៃ ពុធ ម្សិលមិញ ដែល ប្រាប់ ថា ពួក គេ គឺជា ទណ្ឌិត កំពុង ជាប់ ឃុំ នៅ ក្នុង ពន្ធនាគារ ព្រៃ ស បាន អះអាង ដូច ៗ គ្នា ដោយ ចោទ ប្រកាន់ មន្ត្រី ពន្ធនាគារ ព្រៃ ស ថា បាន ប្រព្រឹត្ត អំពើ ពុករលួយ ក្នុង ការ ស្រង់ ឈ្មោះ ទណ្ឌិត ដែល ត្រូវ ដោះ លែង និង បន្ធូរ បន្ថយ ទោស ដោយ ប្រព្រឹត្ត ផ្ទុយ ទៅ នឹង សេចក្តី ប្រកាស របស់ រដ្ឋាភិបាល ។
អ្នក ទូរស័ព្ទ មក ដែល សុទ្ធ តែ បដិសេធ សុំ មិន បញ្ចេញ ឈ្មោះ ទាំង នោះ បាន អះអាង ថា អ្នក ទោស ដែល មាន ឈ្មោះ ត្រូវ ដោះ លែង ឬ បន្ធូរ បន្ថយ ទោស គឺ ត្រូវ បង់ ប្រាក់ ចាប់ពី ១៥០០ ទៅ ២០០០ ដុល្លារ ឲ្យ ទៅ មន្ត្រី ពន្ធនាគារ ។
ចំណែក ពួក គាត់ ចំនួន ៤៥ នាក់ ដែល សុទ្ធ តែ មាន លក្ខណ សម្បត្តិ គ្រប់គ្រាន់ ត្រូវ ដោះ លែង មិន មាន ឈ្មោះ ក្នុង បញ្ជី ត្រូវ ដោះ លែង ឬ បន្ធូរ បន្ថយ ទោស នោះ ទេ ដោយ សារ តែ គ្មាន ប្រាក់ បង់ ។
ស្ត្រី ទណ្ឌិត ដែល បដិសេធ មិន បញ្ចេញ ឈ្មោះ រូប នេះ និយាយ ថា ៖
អ្នក ស្រី បន្ត ថា ពួក អ្នក ស្រី កំពុង តែ មាន ការ ជ្រួល ច្របល់ ដោយ សារ តែ មាន ភាព មិន ប្រក្រតី យ៉ាង ខ្លាំង ក្នុង រឿង នេះ ធ្វើ ឲ្យ ប៉ះពាល់ ដល់ អារម្មណ៍ របស់ ទណ្ឌិត ។
ទណ្ឌិត ម្នាក់ ទៀត ក៏ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ តាម ទូរស័ព្ទ កាល ពី ម៉ោង ១១ ថ្ងៃ ត្រង់ ម្សិលមិញ ដែរ ថា អ្នក ស្រី បាន ស្តាប់ ឮ តាម វិទ្យុ គេ ផ្សាយ ថា រដ្ឋាភិបាល នឹង លើក លែង ទោស ដល់ ទណ្ឌិត ដែល មាន ជំងឺ ចាស់ ជរា និង មាន កូន តូច នៅ ជាមួយ តែ នៅ ពេល មន្ត្រី ពន្ធនាគារ ប្រកាស ឈ្មោះ បែរ ជា គ្មាន ឈ្មោះ របស់ ពួក អ្នក ស្រី ដែល មាន លក្ខណ សម្បត្តិ ត្រូវ លើក លែង ទោស ទៅ វិញ ។
វា អយុត្តិធម៌ ណាស់ សម្រាប់ ពួក ខ្ញុំ ។
ស្រ្តី ជា ទណ្ឌិត ម្នាក់ ទៀត ដែល ទូរស័ព្ទ មក ភ្នំពេញ ប៉ុស្តិ៍ កាលពី វេលា ម៉ោង ១០ និង ៣០ នាទី យប់ ថ្ងៃ អង្គារ ថ្លែង ថា ក្នុង ចំណោម ទណ្ឌិត ដែល មាន ជំងឺ ជា ច្រើន នាក់ គឺ មាន តែ ម្នាក់ គត់ ដែល មាន ឈ្មោះ ត្រូវ លើក លែង ទោស ក្រៅ ពី នោះ គឺជា ទណ្ឌិត ដែល មាន កម្លាំង មាំ មួន ។
លោក គុយ ប៊ុន សន អគ្គ នាយក នៃ អគ្គ នាយក ដ្ឋាន ពន្ធនាគារ ក្រសួង មហាផ្ទៃ ពុំ អាច ទាក់ ទង សុំ ការ អត្ថាធិប្បាយ បាន ទេ កាល ពី ថ្ងៃ ម្សិលមិញ ។
កាល ពី ថ្ងៃ ទី ១០ ខែ មករា រាជ រដ្ឋាភិបាល បាន សម្រេច លើក លែង ទោស ទណ្ឌិត នៅ ទូទាំង ប្រទេស ចំនួន ៤១២ នាក់ និង បន្ធូរ បន្ថយ ទោស ដល់ ទណ្ឌិត ៨៤ នាក់ នៅ ក្នុង ព្រះ រាជ ពិធី ថ្វាយ ព្រះ ភ្លើង ដល់ ព្រះ បរម រតន កោដ្ឋ ព្រះ មហា វីរក្សត្រ នរោត្តម សីហនុ ។
ចំណែក លោក វីរ៉ា ស៊ុម ខ្វាម ឃីត នឹង ត្រូវ បន្ធូរ បន្ថយ ទោស នៅ ថ្ងៃទី ៤ ខែ កុម្ភៈ ត្រូវ នឹង ថ្ងៃ ថ្វាយ ព្រះ ភ្លើង ។
ប្រពន្ធអ្នកជាប់ទោសរឿងអប គមន៍ សង្ឃឹមលើព្រះរាជ ទាន
កាល ពី ខែ តុលា លោក ម៉ម សូណង់ ដូ ម្ចាស់ វិទ្យុ ឯករាជ្យ ត្រូវ បាន ផ្តន្ទាទោស ២០ ឆ្នាំ ចំពោះ បទល្មើស ដែល ពុំ មាន បង្ហាញ អំពី ភស្តុតាង ដែល គួរ ឲ្យ ជឿ ជាក់ នៅ ឡើយ ទេ ។
ប៉ុន្តែ លោក សុវណ្ណ ត្រូវ ជាប់ ពន្ធនាគារ ៣ ឆ្នាំ លោក រិន ត្រូវ ជាប់ ៥ ឆ្នាំ និង លោក ស្រឿន ត្រូវ ជាប់ ១០ ខែ ។
ពួក គេ មិន មែន ជា សមាជិក សមាគម អ្នក ប្រជាធិបតេយ្យ របស់ លោក ម៉ម សូណង់ ដូ ទេ ។
អ្នក ស្រី ភូ ប្រពន្ធ លោក សុវណ្ណ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ៖
ចំពោះ គ្រួសារ ការ ចាប់ ខ្លួន មាន ផល ប៉ះពាល់ ។
អ្នក ស្រី ផាត់ ភីន ប្រពន្ធ លោក ស្រឿន បាន និយាយ ថា ៖
អង្គុយ នៅ ផ្ទះ អ្នក ជិត ខាង អ្នក ស្រី ភីន ប្រឡែង ជាមួយ នឹង កូន ស្រី តូច ខណៈ កំពុង ពន្យល់ អំពី ស្ថានការណ៍ ដែល កូន ច្បង របស់ គាត់ កំពុង តែ ប្រឈម សព្វ ថ្ងៃ ។
ចំណែក អ្នក ស្រី សុខ គា ដើម្បី ចិញ្ចឹម គ្រួសារ គាត់ បាន ផ្លាស់ ទៅ នៅ ជាមួយ ឪពុក ម្តាយ បន្ទាប់ ពី លោក រិន ជា ប្តី ត្រូវ ចាប់ ខ្លួន ។
ភាគ ច្រើន ពួក គេ មិន អាច បន្ត ទាក់ ទង ជាមួយ នឹង ប្តី ឡើយ ដោយ សារ គ្មាន លុយ សូកប៉ាន់ ឆ្មាំ គុក ដើម្បី ខ្ចី ទូរស័ព្ទ ។
លោក សុវណ្ណ និង លោក រីន រង់ចាំ សវនាការ បណ្តឹង ឧទ្ធរណ៍ រីឯ លោក ស្រឿន វិញ មិន ខ្វល់ ទេ ព្រោះ នីតិវិធី បណ្តឹង ឧទ្ធរណ៍ អាច ត្រូវ ការ ពេល យូរ ជាង ទោស ។
ពួក គេ ជួយ បង្កើត រដ្ឋ ក្នុង រដ្ឋ ។
ពួក គេ ប្រមូល ប្រជាជន រាប់ រយ គ្រួសារ បែង ចែក ដី ក្នុង ចំណោម ពួក គេ ហើយ បង្កើត ចលនា បំបែក រដ្ឋ ហិង្សា ។
ពេល ឧទ្ធម្ភាគចក្រ ហោះ ពីលើ ហើយ កង សន្តិសុខ បាន បាញ់ សម្លាប់ ក្មេង ស្រី អាយុ ១៤ ឆ្នាំ ម្នាក់ លោក សុវណ្ណ រិន និង ស្រឿន បាន វាយ បក ក្នុង ចំណោម អ្នក ដទៃ ទៀត ។
ទោះ ជា យ៉ាង ណា ទាំង នេះ គឺជា ការ ពន្យល់ របស់ រដ្ឋាភិបាល ។
ពេល ខ្លះ ខ្ញុំ ចូល រួម កិច្ច ប្រជុំ របស់ ប៊ុន រដ្ឋា ជា ប្រជាជន សាមញ្ញ ។
ក្នុង ករណី នោះ ប៊ុន រដ្ឋា ក៏ គ្មាន ពិរុទ្ធ ដែរ ។
ពេល ស្រ្តី ទាំង នោះ និយាយ ចប់ ក្មេង ស្រី រិន ចន្ធី អាយុ ៦ ឆ្នាំ បាន រត់ តាម អ្នក យក ព័ត៌មាន ដើម្បី និយាយ ផ្តាំ ផ្ញើ បន្ថែម ថា៖
កម្មករ ៦ នាក់ចូលសវនាការករណីក្រុមហ៊ុនប្តឹង
សវនាការ នេះ បាន ប្រព្រឹត្ត ទៅ ដោយ មាន កម្មករ ប្រមាណ ៥០ នាក់ កាន់ បដា ឈរ តវ៉ា នៅ ខាង ក្រៅ សាលា ដំបូង រាជធានី ភ្នំពេញ ។
លោក សុខ ណា បាន បញ្ជាក់ ថា៖
ដូច្នេះ ខ្ញុំ មិន ទាន់ អាច កំណត់ កាល បរិច្ឆេទ ការ ប្រកាស សាលក្រម នេះ នៅ ឡើយ ទេ ។
លោក នង មានន់ បាន ថ្លែង ថា កម្មករ គួរ តែ រក ដំណោះ ស្រាយ ឲ្យ អស់ ពី លទ្ធភាព ជាមួយ នឹង ថៅកែ របស់ ខ្លួន មុន ពេល ពួក គេ សម្រេច ចិត្ត ធ្វើ កូដកម្ម ដូច្នេះ ។
លោក បាន បន្ត ថា ចង្វាក់ ផលិតកម្ម របស់ ក្រុម ហ៊ុន បាន ជាប់ គាំង ធ្វើ ឲ្យ មាន ការ យឺតយ៉ាវ ដល់ ការ ផលិតផលិត ផល ទៅ ឲ្យ អតិថិជន ហើយ អតិថិជន ខ្លះ បាន លុប ចោល ការ បញ្ជា ទិញ ។
ការ តវ៉ា នៅ មុខ រោង ចក្រ នៅ ក្នុង សង្កាត់ ចោម ចៅ ខណ្ឌ ពោធិ៍សែនជ័យ នេះ កម្មករ បាន ទាមទារ លក្ខខណ្ឌ ការងារ បន្ថែម ១៦ ចំណុច ។
មួយ ខែ ក្រោយ មក ថៅកែ ក្រុមហ៊ុន បាន ប្ដឹង កម្មករ ទៅ កាន់ តុលាការ ។
បន្ទាប់ ពី ចេញ ពី បន្ទប់ សវនាការ លោក អាត់ ធន់ ប្រធាន សហជីព ស៊ី ខៅ ឌូ ដែល បាន តាម ដាន សវនាការ នេះ រំពឹង ថា តុលាការ នឹង ពិចារណា ពី ករណី នេះ ហើយ ផ្ដល់ យុត្តិធម៌ ដល់ កម្មករ ។
លោកហ៊ុន ណេងជួយអន្តរាគមន៍រថយន្តដឹកលើសចំណុះ
កិច្ច អន្តរាគមន៍ របស់ លោក ហ៊ុន ណេង បាន ធ្វើ ឲ្យ ក្រុម បង្ក្រាប រថយន្ត ដឹក ទំនិញ លើ ស ចំណុះ ប្រគល់ ប្រាក់ ៣៧,៩៣ លាន រៀល ទៅ ឲ្យ ម្ចាស់ រថយន្ត ដែល ស៊ី ឈ្នួល ដឹក ជញ្ជូន ដំឡូង មី ពី កំពង់ធំ ទៅ ប្រទេស វៀតណាម ទាំង នោះ វិញ ។
លោក ប៉ែន បូរ៉ាន់ តំណាង គណៈកម្មការ អចិន្រៃ្តយ៍ ដឹក ជញ្ជូន លើ ស ទម្ងន់ នៃ ក្រសួង សាធារណការ និង ដឹក ជញ្ជូន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិល មិញ ថា ក្រុម សមត្ថកិច្ច របស់ លោក បាន ចុះ បង្ក្រាប រថយន្ត ដឹក ទំនិញ លើ ស ទំងន់ ចំនួន ១១ គ្រឿង ក្នុង ទឹក ដី ខេត្ត កំពង់ចាម ដែល ក្នុង មួយ គ្រឿង ៗ បាន ផ្ទុក លើ ស ចំណុះ ចន្លោះ ពី ១៦ តោន ដល់ ជិត ៤០ តោន ។
លោក បន្ត ថា ក្នុង ការ ត្រួត ពិនិត្យ នេះ កម្លាំង របស់ លោក បាន ផាក ពិន័យ ម្ចាស់ រថយន្ត ចំនួន បី គ្រឿង បាន ថវិកា សរុប ចំនួន ៣៧,៩៣ លាន រៀល ប៉ុន្តែ ក្នុង ពេល ដែល លោក កំពុង ឲ្យ ពួក គេ បំពេញ បែបបទ ម្ចាស់ រថយន្ត ចំនួន ៨ គ្រឿង ផ្សេង ទៀត បាន ឆ្លៀត ឱកាស បើក រត់ ។
អ្នក ស្រី ឲ្យ ដឹង ទៀត ថា នៅ ល្ងាច ថ្ងៃ ម្សិល មិញ ក្រោយ ពី ពួកគាត់ បាន លើក គ្នា ត វ៉ា សុំ កិច្ច អន្តរាគមន៍ ពី អភិបាល ខេត្ត កំពង់ចាម ខាង សមត្ថកិច្ច ក៏ បាន ប្រគល់ លុយ ឲ្យ ពួក គាត់ វិញ គ្រប់ តាម ចំនួន ។
លោក គឹម សេង អធិការ រង ក្រុង កំពង់ចាម បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា ក្រោយ ពី មាន ក្រុម ត្រួត ពិនិត្យ ជញ្ជីង ចល័ត បាន ចុះ ប្រតិបត្តិការ ត្រួត ពិនិត្យ និង ផាក ពិន័យ ធ្ងន់ ធ្ងរ លើ រថយន្ត ដឹក ទំនិញ លើ ស ចំណុះ នេះ បាន ធ្វើ ឲ្យ ក្រុម ម្ចាស់ រថយន្ត ដឹក ទំនិញ កើត ទុក្ខ មិន សុខចិត្ត ហើយ បាន លើក គ្នា ប្រមាណ ជាង ៥០ នាក់ មក តវ៉ា ទាមទារ ឲ្យ ប្រធាន មន្ទីរ សាធារណការ ខេត្ត ដោះស្រាយ ៕
សាលា ក្តីប្រាប់បុគ្គលិកឲ្យរង់ចាំប្រាក់ខែដែលយឺត
បើ តាម អ្នក នាំ ពាក្យ សាលា ក្តី ខ្មែរ ក្រហម លោក នេត្រ ភក្ត្រា បាន ឲ្យ ដឹង ថា ការិយាល័យ នេះ បាន ប្រកាស ថា បន្ទាប់ ពី ការ ពិភាក្សា រវាង ផ្នែក ហិរញ្ញវត្ថុ និង ថវិកា ( ផ្នែក ជាតិ ) និង ភាគី ពាក់ ព័ន្ធ ការ ផ្ទេរ ថវិកា សម្រាប់ ប្រាក់ ខែ ខែ ធ្នូ ឆ្នាំ ២០១២ នឹង ត្រូវ ពន្យារ ពេល បន្ថែម ទៀត ។
ជាង នេះ ទៀត លោក បាន និយាយ ថា ផ្នែក ជាតិ របស់ សាលា ក្តី ខ្មែរ ក្រហម មិន បាន ទទួល ការ សន្យា ផ្តល់ ថវិកា ថ្មី សម្រាប់ ឆ្នាំ ២០១៣ ទេ ប៉ុន្តែ ប្រទេស មួយ ចំនួន នឹង ចាប់ ផ្តើម ពិចារណា ផ្តល់ ជំនួយ នៅ ពេល ដែល គម្រោង ថវិកា ត្រូវ បាន អនុម័ត ដោយ ម្ចាស់ ជំនួយ សំខាន់ ៗ នៅ ទីក្រុង ញូវយ៉ក ។
លោក ភក្រ្តា បាន ថ្លែង តាម អ៊ីមែល ថា៖
កម្មកររោងចក្រកាត់ដេរចំនួន ២ នៅផ្លូវ ជាតិលេខ ៤ ដួលសន្លប់ជិត ៨០នាក់
កម្ម ការិនី រងគ្រោះ ឲ្យ ដឹង ថា ខ្លួន កំពុង ធ្វើ ការ ស្រាប់ តែ ឃើញ អ្នក ផ្សេង ដួល សន្លប់ ខ្លួន ក៏ ចាប់ ទន់ ដៃ ជើង ដែរ ត្រូវ មិត្ត ភក្តិ ជួយ គ្រាហ៍ និង ត្រូវ បាន បញ្ជូន មក កាន់ មន្ទីរពេទ្យ រដ្ឋ ។
ក្រោយ ពី បាន ព្យួរ សេរ៉ូម និង ផ្តល់ ការ ព្យាបាល ពី គ្រូ ពេទ្យ ខេត្ត កញ្ញា ប្រាប់ ថា៖
លោក ឈា វិនុត ប្រធាន សម្ព័ន្ធ សហជីព ប្រជាធិបតេយ្យ កម្មករ កាត់ ដេរ កម្ពុជា ហៅ កាត់ ស៊ី ខៅ ឌូ ប្រចាំ រោងចក្រ សាប្រ៊ីណា ឲ្យ ដឹង ថា លោក បាន មាន វត្តមាន នៅ រោង ចក្រ និង សង្កេត ឃើញ ថា មិន មាន បញ្ហា បរិស្ថាន ក្នុង រោងចក្រ បណ្តាល ឲ្យ កម្មករ សន្លប់ ឡើយ តែ រឿង សន្លប់ នេះ កើត មក ពី កម្ម ការិនី ម្នាក់ ទើប ចូល ធ្វើ ការ វិញ បន្ទាប់ ពី ឈប់ សម្រាក ឈឺ នៅ ផ្ទះ ។
កម្ម ការិនី រូប នោះ មិន ទាន់ មាន កម្លាំង គ្រប់គ្រាន់ ធ្វើ ការ ក៏ សន្លប់ មុន គេ រួច ពីរ នាក់ ទៀត ជិត នាង ក៏ សន្លប់ ។
លោក បន្ត ថា ករណី សន្លប់ របស់ កម្ម ការិនី ទាំង ៣៥ នាក់ លោក សង្កេត ឃើញ ផ្ទាល់ គឺ ករណី នេះ ដូច ជា មិន មាន ពាក់ព័ន្ធ លក្ខខណ្ឌ ការងារ ឬ បរិស្ថាន ក្នុង រោងចក្រ ឡើយ ប៉ុន្តែ ជា ករណី ដែល កម្មករ ខ្លួន ឯង មិន បាន សម្រាក គ្រប់គ្រាន់ ។
លោក ប៉ុក វណ្ណ ថា អនុប្រធាន នាយក ដ្ឋាន ពេទ្យ ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះ បណ្តាល វិជ្ជាជីវៈ ទទួល បន្ទុក ប្រធាន គណៈ កម្ម ការ ស្រា វ ជ្រាវ ទប់ ស្កាត់ ករណី ដួល សន្លប់ កម្មករ កម្ម ការិនី តាម រោងចក្រ សហគ្រាស ឲ្យ ដឹង ថា ក្រុម ការងារ បាន រក ឃើញ នូវ មូលហេតុ ពីរ គឺ ខ្វះ ជាតិ ស្ករ និង បរិយាកាស ការងារ មាន បញ្ហា ទៅ វិញ ដែល ផ្ទុយ ពី ក្រុម សហជីព ទោះ បី លោក ថា មាន ការ កែប្រែ បរិស្ថាន បាន ច្រើន យ៉ាង ណា ក៏ ដោយ ។
លោក ប៉ុក វណ្ណ ថាត ឲ្យ ដឹង បន្ត ថា រោងចក្រ សាប្រ៊ីណា មាន ករណី សន្លប់ ចំនួន ៣ដង គិត ចាប់ ពី ឆ្នាំ ២០១១ មក ។
នៅ ថ្ងៃ ព្រហស្បតិ៍ ស្អែក ទើប ក្រុម លោក ចុះ ទៅ ពិនិត្យ ៕
ពលករត្រូវគេបោកឲ្យធ្វើការ លើទូកនេសាទថៃរួច មកស្រុកវិញ
ខ្ញុំ គ្មាន អាហារ គ្រប់ គ្រាន់ ទេ ។
ចំណែក លោក អ៊ឹម សុគន្ធា អាយុ ៣៨ ឆ្នាំ មក ពី ខេត្ត តាកែវ ប្រាប់ ថា គាត់ ចង់ ប្រាប់ ដល់ ប្រជាជន កម្ពុជា ថា សូម កុំ ទៅ ធ្វើ ការ នៅ លើ ទូក នេសាទ តាម ការ ចាញ់ បោក មេខ្យល់ ពីព្រោះ ការងារ លើ ទូក នេសាទ ពិត ជា ធ្ងន់ធ្ងរ ខ្លាំង ណាស់ ។
លោក ហ៊ុយ ពេជ្រ សុវណ្ណ មន្ត្រី កម្មវិធី នៃ មជ្ឈមណ្ឌល អប់រំ ច្បាប់ សហគមន៍ បាន ឲ្យ ដឹង ថា មក ដល់ ភ្លាម ពួកគេ ត្រូវ បញ្ជូន ទៅ នាយកដ្ឋាន ប្រឆាំង ការ ជួញ ដូរ មនុស្ស ក្រសូង មហាផ្ទៃ ដើម្បី សាកសួរ ក្នុង បំណង វែក មុខ ស្វែង រក ចាប់ ខ្លួន មេខ្យល់ ៕
ក្មេងអាយុ ៦ ឆ្នាំលង់ទឹកស្លាប់ពុំមែនឃាតកម្មទេ
លោក ហ៊ីង ហាន អធិការ រង ស្រុក មង្គល បុរី មាន ប្រសាសន៍ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ថ្ងៃ ពុធ ថា ក្មេង ប្រុស រង គ្រោះ នៅ ក្នុង ហេតុការណ៍ នេះ មាន ឈ្មោះ ដន វីត អាយុ ៦ ឆ្នាំ រស់ នៅ ភូមិ ស្ទឹង ចាស់ ឃុំ គយ មែង ស្រុក មង្គល បុរី ខេត្ត បន្ទាយ មានជ័យ ។
គួរ រំឭក ថា កាល ពី ខែ មុន ក្មេង ប្រុស ស្រី ២នាក់ ចុះ ទៅ ងូត ទឹក ស្រះ ខាង ក្រោយ ផ្ទះ ចម្ងាយ ៥០ម៉ែត្រ ស្ថិត ក្នុង ភូមិ អូរ ស្រឡៅ ឃុំ អូរ ស្រឡៅ ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ បាន លង់ ស្លាប់ ទាំង ពីរ នាក់ ។
មេធាវីថាសុខភាព នួន ជា មិនល្អដូចប្រធានអង្គជំនុំ ជម្រះលើកទេ
លោក បន្ត ថា តាម របាយការណ៍ របស់ គ្រូពេទ្យ នួន ជា ក្អក យូរ ៗ ម្តង និង នៅ មាន ស្ថានភាព ខ្សោយ នៅ ឡើយ ប៉ុន្តែ កម្តៅ ខ្លួន របស់ គាត់ គឺ ធម្មតា ហើយ គាត់ កំពុង បន្ត ប្រសើរ ឡើង ។
លោក ថ្លែង បន្ត ថា ក្រុម មេធាវី ការពារ ក្តី របស់ នួន ជា គ្រោង នៅ ព្រឹក នេះ ធ្វើ ការ ជំទាស់ ទៅ នឹង ផែន ការ ឲ្យ គាត់ ចេញ ពី មន្ទីរពេទ្យ និង សុំ ឲ្យ ពេទ្យ ផ្តល់ អនុសាសន៍ ថ្មី ទៀត ។
ពេលវេលា នៅ សល់ សម្រាប់ សវនាការ ស្តីពី ឯកសារ កាលពី ម្សិលមិញ បាន ផ្តោត ទៅ លើ តួនាទី របស់ អៀង សារី និង ខៀវ សំផន នៅ ក្នុង របប កម្ពុជា ប្រជាធិបតេយ្យ របស់ ខ្មែរ ក្រហម ក្នុង ឋានៈ ពួក គេ ជា រដ្ឋ មន្ត្រី ការ បរទេស និង ប្រមុខ រដ្ឋ ។
ខណៈ របាយការណ៍ មួយ ចំនួន របស់ ខៀវ សំផន អាន កាលពី ម្សិលមិញ បង្ហាញ ពី វិធានការ ដូចជា ការ ជម្លៀស ប្រជាជន ចេញ ពី ទីក្រុង ភ្នំពេញ និង ការ លុប ចោល រូបិយប័ណ្ណ ឯក សារ អំពី អៀង សារី បាន បង្ហាញ អំពី វិធីសាស្ត្រ យ៉ាង អាក្រក់ ជា ពិសេស លើ អ្នក ដែល ត្រូវ បាន ចាត់ ទុក ថា « ចារកម្ម និង ជន ក្បត់ »៕
បាញ់អ្នកបើកឡានព្រោះលុយ ២ ពាន់រៀលត្រូវដកពីនគរបាល
លោក ឌី វិចិត្រ អាយុ ២៩ ឆ្នាំ ជា ជន រងគ្រោះ ដោយ អំពើ បាញ់ ប្រហារ រងរបួស ត្រូវ គ្រាប់ ចំ ដើម ទ្រូង ខាង ឆ្វេង លើ បេះដូង បន្តិច បាន ថ្លែង ដោយ អាការ អស់ កម្លាំង ខណៈ កំពុង សម្រាក ព្យាបាល របួស នៅ មន្ទីរពេទ្យ កាល់ម៉ែត កាលពី ថ្ងៃ ម្សិលមិញ ថា លោក មាន ការ ឈឺ ចុក ចាប់ ខ្លាំង ត្រង់ មុខ របួស ក្រោយ ពី គ្រូ ពេទ្យ បាន វះ យ ក ក្បាល គ្រាប់ ចេញ ដែល បាន បាញ់ ធ្លុះ ពី មុខ ទៅ ក្រោយ បៀម ជាប់ នៅ ក្នុង ខ្លួន ។
លោក បាន ថ្លែង ទាំង ទឹក មុខ ស្លេកស្លាំង ថា៖
លោក ទៀង ច័ន្ទ សា អធិការ នគរបាល ខណ្ឌ ឫស្សីកែវ បាន ឲ្យ ដឹង ថា កម្លាំង សមត្ថកិច្ច របស់ លោក ក្រោម បទ បញ្ជា របស់ លោក ស្នងការ និង ស្នងការ រង រាជធានី បាន ធ្វើ ការ ស្រាវជ្រាវ យ៉ាង យក ចិត្ត ទុក ដាក់ និង ឈាន ទៅ ដល់ ការ ចាប់ ឃាត់ ខ្លួន ជន សង្ស័យ ទាំង ពីរ នាក់ នេះ ដែល ជា មន្ត្រី នគរបាល ក្រោយ ពី បាន បាញ់ ម្ចាស់ រថយន្ត ទួរី ស ដឹក ម្ទេស បណ្តាល ឲ្យ រងរបួស ធ្ងន់ កាល ពី ថ្ងៃ ចន្ទ ដោយ សារ តែ តាម ទារ លុយ មិន បាន ។
លោក បាន បន្ត ថា ដូច ករណី មន្ត្រី នគរបាល មន្ត្រី មាន អំណាច ព្រម ទាំង កូន អ្នក មាន អំណាច ផង ដែរ បាន ប្រើប្រាស់ កាំភ្លើង បាញ់ គំរាម អ្នក ដទៃ ដែល ទង្វើ បែប នេះ វា ជា គំរូ មួយ អាក្រក់ និង ធ្វើ ឲ្យ ប៉ះពាល់ ទៅ ដល់ កិត្តិយស និង សេចក្តី ថ្លៃថ្នូរ របស់ កង កម្លាំង គ្រប់ ប្រភេទ ដែល មាន ឆន្ទៈ និង កិច្ច ការពារ រក្សា សណ្តាប់ ធ្នាប់ ជូន ប្រជា ពលរដ្ឋ និង ការពារ សេចក្តី ថ្លៃថ្នូរ ពិត ប្រាកដ របស់ ជាតិ ។
ការ សាង សង់ទីលានបូជាព្រះបរម សពបាន បញ្ចប់
អ្នក លាប ថ្នាំ ឥដ្ឋ ដដែល បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃ ចុង ក្រោយ នៅ ឯ កន្លែង បូជា ព្រះ បរម សព នេះ ថា៖
ចំពោះ លោក សំណាង កិច្ចការ នេះ គឺ ស្វិតស្វាញ ណាស់ ហើយ ស៊ី ពេល យូរ ទៀត ។
គាត់ ជា កម្មករ ម្នាក់ ដែល បាន សម្រាក នៅ កន្លែង នេះ ផ្ទាល់ នៅ ក្នុង ពេល សាងសង់ ប៉ុន្តែ គាត់ គ្មាន អ្វី ដើម្បី តបស្នង ចំពោះ គ្រា ចុង ក្រោយ របស់ អតីត ព្រះ មហា វីរក្សត្រ ដែល ព្រះ អង្គ បាន សោយ ទិវង្គត នៅ ប្រទេស ចិន ថ្ងៃទី ១៥ តុលា ២០១២ ក្នុង ព្រះជន្ម ៩០ ព្រះ វស្សា នោះ ទេ ។
លោក សំណាង បាន និយាយ ថា៖
លោក សំណាង បាន បន្ត ថា៖
ការ ជួប ព្រះ មហាក្សត្រ នរោត្តម សីហមុនី និង ព្រះ មហាក្សត្រិយ៍ ន រោត្ដម មុនី នា ថ ដែល ទ្រង់ យាង ទត កន្លែង សាង សង់ នេះ ដើម្បី ផ្ដល់ រង្វាន់ ដល់ ក្រុម កម្មករ នោះ បាន បន្ថែម សារ សំខាន់ នៃ គម្រោង នេះ សម្រាប់ លោក សំណាង ។
លោក សំណាង បាន បញ្ជាក់ ថា៖
លោក ចែម សឿន បាន និយាយ ថា៖
លោក សំណាង បាន បន្ថែម ថា ៖
ព្រះ អង្គ ម្ចាស់ ស៊ីសុវត្ថិ ធម្មិកោ អតីត ជំនួយ ការ សម្ដេច ឪ បាន សរសើរ ក្រុម សាង សង់ ចំពោះ អ្វី ដែល ពួក គេ បាន សម្រេច ជា ស្ថាពរ តាំង ពី ការ ចាប់ ផ្ដើម ការ ងារ ដំបូង ក្នុង ខែ វិច្ឆិកា ។
លោក សឺន ស៊ូប៊ែរិ៍ ទីប្រឹក្សា ព្រះ មហាក្សត្រ ក៏ បាន សម្ដែង ការ ពេញ ចិត្ត ចំពោះ អ្វី ដែល លោក បាន ឃើញ នេះ ដែរ ដោយ លោក បាន មាន ប្រសាសន៍ ថា៖
អាជ្ញាធរហាមពលរដ្ឋធ្វើស្រែប្រាំងនៅបឹងកំពីង ពួយ
លោក ម៉ៅ ដែល មាន ជីវភាព ពឹង ផ្អែក លើ ការ បង្ក បង្កើន ផល ស្រូវ និង ចិញ្ចឹម សត្វ បាន ថ្លែង ថា៖
លោក ឡុង ផល្គុន ប្រធាន មន្ទីរ ធន ធាន ទឹក ខេត្ត បាត់ដំបង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិលមិញ ថា ផ្ទៃ ដី ស្រែ នៅ តំបន់ ផ្នែក ខាង ក្រោម អាង ទឹក កំពីង ពួយ សរុប ចំនួន ជាង ១៣ ០០០ ហិកតា របស់ ប្រជា កសិករ ប្រមាណ ជាង ២០០០ គ្រួសារ ក្នុង ស្រុក បាណន់ អាច ប្រឈម នឹង កង្វះ ទឹក ស្រោចស្រព នៅ ពេល ដែល គេ ចាប់ ផ្ដើម បើក បង្ហៀរ ទឹក ចេញ ពី ផ្ទៃ អាង ដើម្បី អនុវត្ត គម្រោង ស្ដារ និង ស្ថាបនា ទំនប់ អាង នេះ ឡើង វិញ ។
គម្រោង នេះ រួម មាន ការ សាងសង់ ទំនប់ បង្ហៀរ ប្រវែង ៣០០ ម៉ែត្រ ពង្រឹង ជើង ទំនប់ ( ផ្នែក ខាង ក្នុង អាង ) ដោយ ចាក់ បេតុង ប្រវែង៦ ៥០០ ម៉ែត្រ និង ជីក ស្តារ ប្រឡាយ មេ នាំ ទឹក មកពី ស្ទឹង បវេល ប្រវែង ១៣ គីឡូ ម៉ែត្រ ដោយ អនុវត្ត រយៈ ពេល ពីរ ឆ្នាំ ២០១៣ និង ២០១៤ ហើយ ក្នុង រយៈពេល គម្រោង នេះ កំពុង អនុវត្ត ទឹក នៅ ក្នុង អាង កំពីង ពួយ ត្រូវ បង្ហូរ ចោល ទាំង អស់ ។
លោក ផល្គុន បាន ឲ្យ ដឹង ទៀត ថា បច្ចុប្បន្ន ទំនប់ អាង ទឹក កំពីង ពួយ អាច ស្តុក ទឹក បាន ចំនួន ប្រមាណ ជា ៨០ លាន ម៉ែត្រ គូប នៅ ក្នុង រដូវ វស្សា សម្រាប់ ការ ផ្គត់ផ្គង់ ការ បង្ក បង្កើន ផល របស់ ប្រជា កសិករ ក្នុង តំបន់ នោះ នា រដូវ ប្រាំង ប៉ុន្តែ នៅ ពេល គម្រោង ត្រូវ បាន អនុវត្ត ចប់ ជា ស្ថាពរ នោះ គេ រំពឹង ថា ទំនប់ អាង នេះ នឹង អាច ស្តុក ទឹក បាន រហូត ដល់ ១១០ លាន ម៉ែត្រ គូប ដោយសារ ទំនប់ អាង នេះ ក្រៅ ពី ពង្រឹង ជា ច្រាំង បេតុង គឺ ដំឡើង កម្ពស់ ខ្នង ទំនប់ ០,៦០ ម៉ែត្រ ថែម ទៀត ។
លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល រង ខេត្ត បាត់ដំបង បាន មាន ប្រសាសន៍ ថា ដើម្បី ផល ប្រយោជន៍ ទាំង បច្ចុប្បន្ន និង អនាគត ប្រជា កសិករ គប្បី ចូល រួម សហការ អនុវត្ត តាម ការ ណែ នាំ របស់ មន្ត្រី ជំនាញ ។
បច្ចុប្បន្ន បឹង នេះ មើល ទៅ មាន ទំហំ ធំ ល្វឹងល្វើយ ធ្វើ ឲ្យ មាន ការ ទាក់ទាញ យ៉ាង ខ្លាំង ពី ក្រុម អ្នក ទេសចរ ៕
ជន ជាតិដើមភាគតិចជួប កង្វល់លើសិទ្ធិដីធ្លី
កង្វល់ ត្រូវ បាន លើក ឡើង ក្នុង វេទិកា តុ មូល កាលពី ម្សិលមិញ នៅ ទី រួម ខេត្ត ក្រចេះ ដែល មាន អ្នក ចូលរួម ប្រមាណ ៣០ នាក់ ជា ជន ជាតិ ដើម ភាគ តិច ខេត្ត ក្រចេះ និង ខេត្ត មណ្ឌលគិរី ព្រម ទាំង មាន ការ បកស្រាយ ពី តំណាង រាស្រ្ត ក្នុង អាណត្តិ ទី៤ ពី គណបក្ស បី គឺ គណបក្ស សិទ្ធិ មនុស្ស ហ៊្វុនស៊ិនប៉ិច និង ជាតិ និយម ។
លោក វណ្ណ សុផាត អ្នក សម្រប សម្រួល កម្មវិធី កំណែ ទម្រង់ ដីធ្លី មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា ជា អ្នក សម្រប សម្រួល កម្មវិធី បាន ឲ្យ ដឹង ថា ដំណើរ ការ កម្មវិធី នៅ ពេល ព្រឹក មាន តំណាង ជន ជាតិ ដើម ភាគ តិច ឡើង ថ្លែង ពី កង្វល់ នៃ សិទ្ធិ ដីធ្លី របស់ ពួក គេ ។
លោក កូយ សុខារិទ្ធ អគ្គ លេខាធិការ រង គណបក្ស ជាតិ និយម និង ជា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ចូល រួម ជា តំណាង គណបក្ស ក្នុង វេទិកា មួយ នេះ ថ្លែង ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា អាណត្តិ ថ្មី គណបក្ស ជាតិ និយម នឹង បញ្ចូល គ្នា ក្លាយ ជា គណបក្ស ហ៊្វុនស៊ិនប៉ិច វិញ និង មាន គោល នយោបាយ ដោះស្រាយ ដីធ្លី ដែល នៅ សេស សល់ ឲ្យ រួចរាល់ រួម ទាំង បញ្ហា នៅ តំបន់ បឹងកក់ ផង ។
លោកនាយករដ្ឋ មន្ត្រីអះអាងពីការ ស្មានត្រូវរឿងជំរិតធនាគារ
ភ្នំពេញៈ លោក នាយក រដ្ឋ មន្រ្តី ហ៊ុន សែន បាន សម្តែង ការ កោត សរសើរ ចំពោះ កម្លាំង នគរបាល ដែល ចាត់ វិធានការ បញ្ហា របស់ ធនាគារ អេស៊ីលីដា កាល ពី សប្តាហ៍ មុន ប៉ុន្តែ បាន ខិត ខំ រំឭក ថា ស្ថានការណ៍ ចំណាប់ ខ្មាំង មិន បាន បោក ប្រាស់ លោក មួយ នាទី សោះ ឡើយ ។
ថ្លែង ក្នុង ពិធី ចែក សញ្ញាបត្រ និស្សិត នៅ កោះ ពេជ្រ កាល ពី ម្សិលមិញ លោក នាយក រដ្ឋ មន្រ្តី បាន ថ្លែង ថា លោក បាន បញ្ជា លោក នេត សាវឿន អគ្គ ស្នង ការ នគរបាល ជាតិ ឲ្យ ធ្វើ តាម ការ ទាម ទារ គ្រប់ យ៉ាង របស់ អ្នក ប្លន់ ធនាគារ ដោយ សារ តែ ដឹង ថា ការ ចាប់ ចំណាប់ ខ្មាំង ជា ការ ងារ ស៊ី រូង ផ្ទៃ ក្នុង ហើយ កំហុស ក្នុង ការ បង្ក្រាប លើ ចោរ នឹង បណ្តាល ឲ្យ បាត់ បង់ ទាំង ភ័ស្តុតាង និង មុខ មាត់ របស់ សមត្ថកិច្ច ។
លោក ថ្លែង ថា លោក បាន ទាក់ទង លោក នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ឲ្យ បញ្ជា ទៅ កម្លាំង ចុះ បង្ក្រាប និង ផ្តល់ ដល់ ពួក គេ នូវ អ្វី ក៏ ដោយ ដែល ពួក គេ ចង់ បាន ព្រោះ ចោរ ប្លន់ និង ចំណាប់ ខ្មាំង ជា ក្រុម តែ មួយ ហើយ កង កម្លាំង នឹង ត្រូវ ថ្កោល ទោស ដោយ ធនាគារ និង គ្រួសារ របស់ ចំណាប់ ខ្មាំង ប្រសិន បើ ពួក គេ ប្រតិបតិ្តការ ដោយ មិន មាន ការ ប្រុងប្រយ័ត្ន ទេ នោះ ។
លោក នាយក រដ្ឋ មន្ត្រី បាន មាន ប្រសាសន៍ ថា៖
លោក ហ៊ុន សែន បាន បន្ថែម ថា វា សំណាង ល្អ ដែល គ្មាន អ្នក ណា ម្នាក់ ស្លាប់ ក្នុង អំឡុង ប្រតិបតិ្តការ ជា កំហុស ដែល នឹង ធ្វើ ឲ្យ មាន ការ រិះគន់ យ៉ាង ខ្លាំង ក្នុង ពេល ដែល នៅ តែ មិន ច្បាស់ ថា ពុំ មាន ចំណាប់ ខ្មាំង នោះ ។
លោក ហួត វុទ្ធី ព្រះ រាជ អាជ្ញា ខេត្ត កំពង់ចាម បាន ថ្លែង ថា តុលាការ កំពុង ស្វែងរក ជន សម គំនិត បន្ថែម ទៀត ដែល អាច ពាក់ ព័ន្ធ នឹង ស្ថានការណ៍ រយៈ ពេល ជិត ៣០ ម៉ោង នោះ ប៉ុន្តែ លោក បាន បដិសេធ មិន ផ្តល់ ការ អត្ថាធិប្បាយ លម្អិត ទេ ។
ស្ថានទូត ១ - អ.ស.ប. ឲ្យបុគ្គលិកត្រៀមអាហារនិងទឹកក្នុងពិធីថ្វាយព្រះ ភ្លើង
ក្នុង អ៊ីមែល ផ្ញើ ទៅ បុគ្គលិក និង គ្រួសារ របស់ ពួក គេ ហើយ ដែល ភ្នំពេញ ប៉ុស្តិ៍ ទទួល បាន កាល ពី ម្សិលមិញ ស្ថានទូត ណែ នាំ បុគ្គលិក ឲ្យ មាន ការ ផ្គត់ផ្គង់ គ្រប់គ្រាន់ សម្រាប់ រយៈ ពេល ៧ ថ្ងៃ ហើយ ស្នើ ឲ្យ មាន ប្រុង ប្រយ័តុ្ន ជាមួយ នឹង សន្តិសុខ បន្ថែម នៅ ក្នុង គេហដ្ឋាន ។
សារ ក្នុង អ៊ីមែល នោះ បាន បន្ត ថា៖
