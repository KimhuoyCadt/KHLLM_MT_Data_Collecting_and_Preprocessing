អ.ស.ប ៖ ក្រុម ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ចាត់តាំង ធ្វើ សកម្មភាព ខ្លាំងក្លា ហួស ពី សមត្ថភាព របស់ អាជ្ញាធរ នៅ អាស៊ី អាគ្នេយ៍
អង្គការ សហ ប្រជាជាតិ បាន និយាយ នៅ ថ្ងៃព្រហស្បតិ៍ ទី ១៨ កក្កដា នេះ ថា ក្រុម ឧក្រិដ្ឋកម្ម ឆ្លង ដែន កំពុង កើន ឥទ្ធិពល ខ្លាំង ឡើង នៅ អាស៊ី អាគ្នេយ៍ និង ទទួលបាន ផល ចំណេញ កប់ ក្តោង ដោយ ការកេងប្រវ័ញ្ច លើ អំពើពុករលួយ ដែល កំពុង រីករាលដាល ការអនុវត្ត ច្បាប់ ដ៏ កម្សោយ និង ការត្រួតពិនិត្យ ព្រំដែន ធូរ រលុង ។
អ.ស. បាន បន្ថែម ថា ក្រុម ឧក្រិដ្ឋ ជន ទាំងនោះ បាន បង្កើត ប្រាក់ ចំណេញ រាប់ សិប ពាន់ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ៗ ពី កំណើន នៃ ការជួញដូរ គ្រឿងញៀន ទំនិញ និង ឱសថ ក្លែងក្លាយ ការរត់ ពន្ធ មនុស្ស និង ការជួញដូរ សត្វ ព្រៃ និង ឈើ ។
ប៉ូលិស បាន និយាយ ថា ការឆេះ ដ៏ ខ្លាំង នេះ ទំនងជា ត្រូវបាន គេ បង្កឡើង ដោយ ចេតនា តែ នៅ មិន ទាន់ មាន ព័ត៌មាន ភ្លាម ៗ អំពី ហេតុផល នៅ ពីក្រោយ ការវាយប្រហារ នេះ ទេ ។
មន្ត្រី អគ្គិភ័យ ម្នាក់ បាន និយាយ ថា ការរកឃើញ សាកសព មនុស្ស នៅ ជាន់ ទី ២ នៃ អាគារ និង លើ ជណ្តើរ ទៅកាន់ ដំបូល បាន ធ្វើអោយ ចំនួន អ្នកស្លាប់ កើន ដល់ យ៉ាងតិច ២៤ នាក់ ។
ក្នុង ពេល ជាមួយគ្នា ទូរទស្សន៍ NHK បាន រាយការណ៍ ថា បុរស ម្នាក់ ត្រូវបាន ចាប់ខ្លួន ពាក់ព័ន្ធ នឹង អគ្គិភ័យ នេះ និង បន្ទាប់មក ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ។
បើ តាម ប៉ូលិស ជនសង្ស័យ បាន បង្ក អគ្គិភ័យ នៅ ម៉ោង ១០ កន្លះ ព្រឹក ក្រោយពី បាន ជះ ស្រោច វត្ថុ រាវ ទំនងជា ប្រេងកាត នៅក្នុង និង ជុំវិញ អាគារ ។
