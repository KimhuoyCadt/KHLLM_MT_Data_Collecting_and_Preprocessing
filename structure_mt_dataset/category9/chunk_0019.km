កាលពី ឆ្នាំ ២០១៨ កន្លងមក ដើម្បី ទ្រទ្រង់ កំណើន ភ្ញៀវ ទេសចរ មក កម្សាន្ត នៅ ខេត្ត សៀមរាប រាជ រដ្ឋាភិបាល បាន សម្រេច បង្កើត ក្រុមការងារ អន្តរ ក្រសួង មួយ ដើម្បី សិក្សា រៀបចំ ផែនការ មេអភិវឌ្ឍ ទេសចរណ៍ ខេត្ត សៀមរាប ដែល មាន ក្រសួង ទេសចរណ៍ ជា ប្រធាន ហើយ ច្ចុប្បន្ន ក្រុមការងារ ជំនាញ បាន កំពុង សិក្សា រៀបចំ ផែនការ មេនេះ យ៉ាង សកម្ម ។
ផែនការ មេ នេះ នឹង ផ្តោត ជា សំខាន់ លើ ការអភិវឌ្ឍ ខេត្ត សៀមរាប ជាពិសេស ក្រុង សៀមរាប ជា ទីក្រុង ទេសចរណ៍ ជា ទីក្រុង បេតិកភណ្ឌ និង ជា ទីក្រុង ដែល គិតគូរ ពី បរិស្ថាន (Eco-City) ដែល ត្រូវ ធ្វើ សមាហរណកម្ម ទាំង លើ ទិដ្ឋភាព សេដ្ឋកិច្ច សង្គម វប្បធម៌ បរិស្ថាន និង ស្ថាបត្យកម្ម និង ការធ្វើ សមាហរណកម្ម ជាមួយ ផែនការគ្រប់គ្រង តំបន់ អង្គរ (TMP) របស់ អាជ្ញាធរ ជាតិ អប្សរា ផងដែរ ។
ទន្ទឹមនឹង នេះ ក្រសួង ទេសចរណ៍ បាន និង កំពុង សហការ ជាមួយ ភាគី ពាក់ព័ន្ធ រៀបចំ ការងារ មួយចំនួន ដើម្បី ជំរុញ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ខេត្ត សៀមរាប រួម មាន៖
* ការជំរុញ ការអភិវឌ្ឍ តំបន់ ទេសចរណ៍ ជុំវិញ ក្រុង សៀមរាប ជាពិសេស តំបន់ ព្រែក ទាល់ បឹង ទន្លេ សាប ភ្នំ គូលែន និង សហគមន៍ ទេសចរណ៍ នានា ដើម្បី បង្កើត ផលិតផល ទេសចរណ៍ ថ្មី ៗ និង ពន្យារ ពេល ស្នាក់នៅ របស់ ភ្ញៀវ ទេសចរ ។
* ជំរុញ ឲ្យ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ នានា ក្នុង ខេត្ត ដោយ ត្រូវ ធ្វើ ការជួសជុល ផ្លូវ សិក្សា រៀបចំ ប្រព័ន្ធ ផ្គត់ផ្គង់ ទឹក និង អគ្គីសនី ឲ្យបាន គ្រប់គ្រាន់ និង ត្រូវ រៀបចំ ប្រព័ន្ធ គ្រប់គ្រង សំណល់ រឹង និង រាវ ឲ្យបាន ត្រឹមត្រូវ តាម ស្តង់ដា បរិស្ថាន រៀបចំ ចំណត រថយន្ត បង្គន់ អនាម័យ សាធារណៈ គ្រប់គ្រង មធ្យោបាយ ដឹកជញ្ជូន សណ្តាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ ក្នុង ទីក្រុង ។ល ។
* ការពង្រឹង គុណភាព សេវាកម្ម ទេសចរណ៍ និង ធនធាន មនុស្ស ក្នុង វិស័យ ទេសចរណ៍ ឆ្លើយតប នឹង កំណើន ភ្ញៀវ ទេសចរ ដោយ ត្រូវ ពង្រឹង គុណភាព សាលា បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ការបណ្តុះបណ្តាល ផ្ទៃក្នុង និង ជំរុញ ការអនុវត្ត ស្តង់ដា អាស៊ាន ក្នុង វិស័យ ទេសចរណ៍ ជាដើម ។
លោក សាស្រ្តាចារ្យ ក៏ បាន ស្នើ ឱ្យ មាន កិច្ចសហប្រតិបត្តិការ ល្អ លើ ការរៀបចំ ផែនការគ្រប់គ្រង តំបន់ អង្គរ មាន ជាអាទិ៍ បញ្ជរ គ្រប់គ្រង ភ្ញៀវ មុន ចូល ទស្សនា ប្រាសាទ ការបែងចែក ខ្សែ ទស្សនកិច្ច ចំណត នៅមុខ ប្រាសាទ អង្គរវត្ត បណ្ដាញ គមនាគមន៍ នៅ ប្រាសាទ បាយ័ន្ត លាន ជល់ ដំរី ប្រាសាទ ព្រះពិធូ និង នៅ តំបន់ ភ្នំ គូលែន ក៏ ដូចជា ការរៀបចំ ប្រព័ន្ធ អ៉ីនធើណេត Wifi ការរៀបចំ គម្រោង ព្រលានយន្តហោះ អន្តរជាតិ ថ្មី នៅ ខេត្ត សៀមរាប ផងដែរ ។
ព្រម ជាមួយ នោះ លោក រដ្ឋមន្ត្រី និង សហការី ក៏ បាន រាយការណ៍ ជូន យ៉ាង ក្បោះក្បាយ ដល់ ប្រតិភូ ICC-Angkor និង អាជ្ញាធរ ជាតិ អប្សរា អំពី ចក្ខុវិស័យ និង ទស្សនទាន នៃ ការរៀបចំ ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ នៅ សៀមរាប អង្គរ ពី ឆ្នាំ ២០២០ - ២០៣៥ ដោយ ប្តេជ្ញា រួមគ្នា អភិវឌ្ឍ តំបន់ សៀមរាប អង្គរ និង តំបន់ ជុំវិញ ប្រកបដោយ និរន្តរភាព និង ការទទួលខុសត្រូវ ខ្ពស់ ។
( ភ្នំពេញ ) ៖ ស្ថានភាព អាជីវកម្ម ទេសចរណ៍ នៅ រាជធានី ភ្នំពេញ ត្រូវបាន ដាក់ចុះ ដើម្បី ពិភាក្សា គ្នា រវាង ក្រសួង ទេសចរណ៍ រដ្ឋបាល រាជធានី ភ្នំពេញ និង មន្ទីរ ទេសចរណ៍ រាជធានី ភ្នំពេញ សំដៅ រួមគ្នា ជំរុញ ការស្នើសុំ អាជ្ញាបណ្ណ អាជីវកម្ម ទេសចរណ៍ និង ការពង្រឹង សេវាកម្ម ទេសចរណ៍ ឱ្យ កាន់តែ មាន ភាពប្រសើរឡើង ។
ការពិភាក្សា ថ្នាក់ បច្ចេកទេស នេះ ត្រូវបាន ធ្វើឡើង នា ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០១៩ នៅ ទីស្នាក់ការ គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា (NOCC) ដែល ដឹកនាំ ដោយ លោក ណេប សាមុត អគ្គ នាយក គ្រប់គ្រង ឧស្សាហកម្ម ទេសចរណ៍ តំណាង ក្រសួង ទេសចរណ៍ និង លោក ហួត ហៃ អភិបាល រង រាជធានី ភ្នំពេញ តំណាង រដ្ឋបាល រាជធានី ភ្នំពេញ និង មាន ការចូលរួម ពី មន្ត្រីរាជការ ប្រមាណ ៥០ នាក់ ។
កិច្ចប្រជុំ នេះ ក៏ មាន គោលបំណង ពិភាក្សា រិះរក ដំណោះស្រាយ ដើម្បី ឆ្លើយតប ទៅនឹង បញ្ហា ប្រឈម ដែល បាន ស្នើ ឡើង ដោយ មន្ទីរ ទេសចរណ៍ រាជធានី ភ្នំពេញ ដើម្បី ពង្រឹង យន្តការគ្រប់គ្រង និង ពង្រឹង គុណភាព អាជីវកម្ម ទេសចរណ៍ ។
លោក ម៉ម វាសនា ប្រធាន មន្ទីរ ទេសចរណ៍ រាជធានី ភ្នំពេញ បាន លើកឡើង ថា នៅ មាន មូលដ្ឋាន អាជីវកម្ម ទេសចរណ៍ ច្រើន ណាស់ ដែល មិន ទាន់ មក ស្នើសុំ អាជ្ញាបណ្ណ គេចវេស ពី ការស្នើសុំ អាជ្ញាបណ្ណ ឬ អនុវត្ត ផ្ទុយ ពី គោលការណ៍ ណែនាំ ជាដើម ។
ក្នុង ឱកាស នោះ លោក ហួត ហៃ បាន បញ្ជាក់ ជូន អង្គប្រជុំ ឱ្យ បាន ជ្រាប អំពី លទ្ធផល ការងារ ដែល រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បំពេញ និង ទិសដៅ ការងារ មួយចំនួន រួម មាន៖
* ការអនុវត្ត កាតព្វកិច្ច ស្នើសុំ អាជ្ញាបណ្ណ ទេសចរ ណ៍៖ កន្លងមក រដ្ឋបាល រាជធានី ភ្នំពេញ ធ្លាប់ បាន រៀបចំ វេទិកា ផ្សព្វផ្សាយ ស្ដីពី ការស្នើសុំ អាជ្ញាបណ្ណ ទេសចរណ៍ ក៏ប៉ុន្តែ វិស័យ ដែល ត្រូវ ផ្ដល់ សេវា រដ្ឋបាល ជូន ប្រជាពលរដ្ឋ មាន ចំនួន ប្រភេទ ១៤ សេវា ដូច្នេះ ត្រូវការ ពេលវេលា ដើម្បី ផ្សព្វផ្សាយ បន្ថែម ទៀត ។
* រដ្ឋបាល រាជធានី ភ្នំពេញ គ្រោង នឹង ធ្វើ ការផ្សព្វផ្សាយ ដល់ មន្ត្រី បម្រើ ការងារ ខណ្ឌ ទាំង ១៤ និង សង្កាត់ ទំាង ១០៥ បន្ថែម ទៀត ។
* ការងារ ពិនិត្យ ស្លាក យីហោ អាជីវកម្ម ទេសចរ ណ៍៖ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បង្កើត ក្រុមការងារ ដើម្បី ចុះ ពិនិត្យ និង រុះរើ បាន មួយចំនួន ។
* ជំរុញ ការងារ អប់រំ ផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ ផ្នែក ឯកជន មន្ត្រី បម្រើ ការងារ ក្នុង វិស័យ ទេសចរណ៍ ដើម្បី បាន យល់ដឹង ច្បាប់ ស្ដីពី ទេសចរណ៍ ឱ្យ កាន់តែ ច្បាស់ ។
លោក អគ្គ នាយក ណេប សាមុត បាន លើកឡើង ថា លោក រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ គ្រោង នឹង រៀបចំ កិច្ចប្រជុំ រៀងរាល់ ត្រី មាស ដើម្បី ពិនិត្យ និង ដោះស្រាយ បញ្ហា ប្រឈម ទេសចរណ៍ ក្នុង រាជធានី ភ្នំពេញ ។
អាមេរិក សូម កុំ ដើម្បី ផលប្រយោជន៍ ភូមិសាស្ត្រ នយោបាយ និង ផលប្រយោជន៍ សេដ្ឋកិច្ច និង មហិច្ឆតា គ្រប់គ្រង ពិភពលោក របស់ ខ្លួន ហ៊ាន លើក ដៃ បំផ្លាញ សេចក្តីសុខ ប្រជាជាតិ មួយ ដែល កំពុង រស់ សុខសាន្ត ក្នុង សុខ សន្តិភាព និង ការអភិវឌ្ឍ ។ បទពិសោធ ពី អតីតកាល បាន បង្រៀន កម្ពុជា គ្រប់គ្រាន់ ហើយ ក្នុង នោះ បន្ទូល របស់ ព្រះអង្គម្ចាស់ ស៊ីសុវត្ថិ សិរិមតៈ ថា ព្រះអង្គ សោកស្តាយ ដែល ជឿ ទុកចិត្ត លើ អាមេរិក ពេក ក៏ នៅតែ ដក់ ជាប់ ក្នុង ស្មារតី និង ជម្រៅ ដួងចិត្ត ប្រជាជន កម្ពុជា ។
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ រៀបចំ ហ្វឹកហ្វឺន បាញ់ គ្រាប់ ពិត នៅ វរសេនា តូច នគរបាល អន្ដរាគមន៍ នៃ នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន គោក
( ព្រះវិហារ ) ៖ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន រៀបចំ ការហ្វឹកហ្វឺន បាញ់ គ្រាប់ ពិត នៅ ទីលាន ហ្វឹកហាត់ ដល់ សិក្ខាកាម នគរបាល ជាតិ នៅ វរសេនា តូច នគរបាល អន្តរាគមន៍ នៃ នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន គោក ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា មេបញ្ជាការ នគរបាល ជាតិ ប្រចាំ ទិស ភូមិភាគ ទី ៤ និង ទី ៥ តំណាង នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ។ ក្នុង នោះ ក៏ មាន ការចូលរួម ពី មេបញ្ជាការ មេបញ្ជាការ រង និង ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ នៃ នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន គោក ផង ដែរ ។
ថ្លែង ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ បាន បញ្ជាក់ ថា ពិត ណាស់ ការហ្វឹកហាត់ បើ គ្រាន់តែ រៀន ទ្រឹស្ដី នោះ មិន គ្រប់គ្រាន់ នោះ ទេ ពោល ត្រូវតែ ហាត់ នៅ ទីលាន ជាក់ស្ដែង តែម្ដង ដើម្បី បង្កើន ប្រសិទ្ធភាព នៅពេល បំពេញ ការងារ តាម គោលដៅ ឬ ភូមិសាស្ដ្រ ដែល ថ្នាក់ដឹកនាំ ប្រគល់ជូន ។
នាយ ឧត្ដមសេនីយ៍ ខេង សុមេធ ក៏ បាន ផ្ដាំផ្ញើ ដល់ សិក្ខាកាម ទាំងអស់ ត្រូវ យក អស់ កម្លាំង កាយ ចិត្ត ប្រាជ្ញា ស្មារតី ផ្ដោត ទៅ លើ ការរៀនសូត្រ ដើម្បី ទទួលបាន ចំណេះ និង ជំនាញ គ្រប់គ្រាន់ តាម អ្វី ដែល ជា ការចង់បាន របស់ ថ្នាក់ដឹកនាំ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ក្រសួង មហាផ្ទៃ និង រាជ រដ្ឋាភិបាល ផ្ទាល់ តែម្ដង ៕
១៖ សម្តេច តេជោ ហ៊ុន សែន ដាក់ ចេញ វិធានការចាំបាច់ ៦ ចំណុច ឲ្យ ស្ថាប័ន ពាក់ព័ន្ធ ទប់ស្កាត់ ការនាំចូល ជ្រូក សាច់ ជ្រូក និង ផលិតផល មាន ដើមកំណើត ពី សត្វ ជ្រូក គ្រប់ ប្រភេទ ដោយ ខុស ច្បាប់ ( ចុច អាន )
២៖ គណៈ រដ្ឋមន្ត្រី នឹង បើក កិច្ចប្រជុំ នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ ដើម្បី ពិភាក្សា និង ឆ្លង របៀបវារៈ ចំនួន ៣ ( ចុច អាន )
៥៖ លិខិត មិត្ត អ្នកអាន៖ អាមេរិក ចោទ កម្ពុជា និង ចិន ដើម្បី បិទបាំង ផែនការសម្ងាត់ របស់ ខ្លួន បង្កើត មូលដ្ឋាន ទ័ព ជាមួយ ស ( ចុច អាន )
៧៖ តុលាការ នឹង បន្ត នីតិវិធី លើ សំណុំរឿង បណ្តឹង របស់ សម្តេច ក្រឡាហោម ស ខេង ប្តឹង លោក សម រង្ស៉ី លើករណី ញុះញង់ ( ចុច អាន )
៨៖ សម្តេច តេជោ ហ៊ុន សែន មាន សុខភាព រឹងមាំ ពេញលេញ វិញ ហើយ ដែល នឹង ដឹកនាំ កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី នៅ ថ្ងៃទី២ ខែសីហា ( ចុច អាន )
៩៖ ទូរទស្សន៍ ហង្ស មាស សុំទោស ចំពោះ កំហុសឆ្គង ក្នុង កម្មវិធី « ឋានសួគ៌ ឬ ឋាននរក » និង ទទួលស្គាល់ ថា ខ្លួន ពិតជា មាន ការភ័ន្ដច្រឡំ ដោយ ខ្លូន ឯង លើ សំណួរ ពាក់ព័ន្ធ ផ្លូវគោក នៅ កម្ពុជា ( ចុច អាន )
១០៖ តុលាការ ចេញ ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន ជន បោក លុយ ពលរដ្ឋ ប្រមាណ ៣០លាន ដុល្លារ ម្នាក់ ទៀត ក្រោម រូបភាព ដាក់ ប្រាក់ វិនិយោគ ( ចុច អាន )
១១៖ សមត្ថកិច្ច បញ្ជូន បុរស នី សេរីយ៉ា៣នាក់ ទៅ តុលាការ ករណី ជួញដូរ ថ្នាំ ញៀន ២១ គីឡូក្រាម ( ចុច អាន )
១២៖ ព័ត៌មាន លម្អិ ត៖ គ្រោះថ្នាក់ ចរាចរណ៍ រថយន្ត ដឹក កម្មករ បុក គ្នា នៅ ក្រុង ស្វាយរៀង បណ្តាលឲ្យ របួស ៤៣ នាក់ ( ចុច អាន )
១៖ ក្រោយ ការបាញ់ តេស្ត មីស៊ីល ថ្មី៖ កូរ៉េ ខាងត្បូង កោះ ប្រជុំ ផ្នែក សន្តិសុខ បន្ទាន់ ខណៈ ជប៉ុន ចង់ បើក កិច្ចប្រជុំ កំពូល ជាមួយ កូរ៉េ ខាងជើង ដោយ គ្មាន លក្ខខណ្ឌ ! ( ចុច អាន )
២៖ លោក ដូណាល់ ត្រាំ ចង់បាន កិច្ចព្រមព្រៀង ថ្មី លើ ការគ្រប់គ្រង សព្វាវុធ ជាមួយ រុស្ស៊ី ( ចុច អាន )
៤៖ សហរដ្ឋ អាមេរិក ស្នើ ជា ផ្លូវការ ឱ្យ អង់គ្លេស បារាំង និង អាលឺ្ល ម៉ង់ ចូលរួម ក្នុង បេសកកម្ម យោធា ទប់ទល់ នឹង អ៊ីរ៉ង់ ( ចុច អាន )៥៖ ហុងកុង៖ ក្រុម អ្នកតវ៉ា សរុប ៤៤ នាក់ « ប្រឈមមុខការជាប់ ពន្ធនាគារ ១០ឆ្នាំ » ពាក់ព័ន្ធ នឹង អំពើ កុប្បកម្ម ( ចុច អាន )
៦៖ អតីត អភិបាល ក្រុង តេហេរ៉ង់ ត្រូវបាន ផ្តន្ទាទោស ប្រហារជីវិត ពី បទ សម្លាប់ ប្រពន្ធ ខ្លួន ឯង ( ចុច អាន )
៩៖ រុស្ស៊ី រិះគន់ អង់គ្លេស ដែល បាន បញ្ចេញ ប្រតិកម្ម លើ ការចាប់ខ្លួន ក្រុម អ្នកតវ៉ា នៅ ម៉ូស្គូ ជាង ១ ពាន់ នាក់ ( ចុច អាន )
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បើក កិច្ចប្រជុំ ពិគ្រោះយោបល់ លើ ការរៀបចំ មហាសន្និបាត និង ការបោះឆ្នោត សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា អាណត្តិ ទី៣
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន រៀបចំ កិច្ចប្រជុំ មួយ ក្រោម អធិបតីភាព លោក សុខ ពុទ្ធិ វុធ ប្រធាន ក្រុមប្រឹក្សាភិបាល ដើម្បី ពិគ្រោះយោបល់ លើ ការរៀបចំ កម្មវិធី មហាសន្និបាត និង ការបោះឆ្នោត សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា អាណត្តិ ទី៣ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ។ កិច្ចប្រជុំ នេះ បាន រៀបចំ ធ្វើឡើង នា ព្រឹក ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០១៩ ។
បន្ទាប់ពី បាន ពិភាក្សា គ្នា យ៉ាង ផុសផុក រួច មក អង្គប្រជុំ បាន សម្រេច លើ ការកែសម្រួល រចនាសម្ព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ថ្មី សម្រាប់ អាណត្តិ ទី៣ និង នីតិវិធី បោះឆ្នោត សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា អាណត្តិ ទី៣ ដោយ ទទួលបាន ការឯកភាព ១០០% ។
នៅ រសៀល ថ្ងៃ ដដែល សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន រៀបចំ កម្មវិធី ពិគ្រោះយោបល់ ជាមួយ សមាជិក សមាជិកា និង ចាស់ ព្រឹទ្ធាចារ្យ ដែល មាន បទពិសោធន៍ ក្នុង វិស័យ ស្រូវ អង្ករ កម្ពុជា លើ រចនាសម្ព័ន្ធ ថ្មី និង នីតិវិធី ការបោះឆ្នោត សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា អាណត្តិ ទី៣ ។
