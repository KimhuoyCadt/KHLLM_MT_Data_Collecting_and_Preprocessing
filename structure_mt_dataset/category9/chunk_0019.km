( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង២.៦៣១ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៩៣៥ គ្រឿង ( ម៉ូតូ ៧៥ %) អប់រំ៣៧៦ គ្រឿង និង ផាក ពិន័យ ៥៥៩ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២១ ខែសីហា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១. ៧០១ គ្រឿង . អប់រំ២៥០ គ្រឿង និង ផាក ពិន័យ ៤៤៩ គ្រឿង ។
តែងតាំង លោក ជិន ប៊ុន ធឿន ជា នាយក ប្រតិបត្តិ សាខា កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ . លោក ឃួង ស្រេង ប្តេជ្ញា បន្ត ការងារ ឲ្យ មាន ប្រសិទ្ធភាព ជួយ ដល់ ជនរងគ្រោះ ទាន់ ពេលវេលា
( ភ្នំពេញ ) ៖ ប្រធាន កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ បាន បេ្តជ្ញាចិត្ត ពង្រីក សកម្មភាព មនុស្សធម៌ របស់ ខ្លួន ឲ្យ កាន់តែ ខ្លាំងក្លា ដើម្បី ធានា ប្រសិទ្ធភាព នៃ ការផ្តល់ កិច្ចអន្តរាគមន៍ ជួយសង្គ្រោះ ជនរងគ្រោះ និង ជន ងាយ រងគ្រោះ នានា ឲ្យបាន ទាន់ ពេវេលា ។
លោក អភិបាល រាជធនី ភ្នំពេញ បាន ថ្លែង ថា កិច្ច ខំប្រឹងប្រែង ក្នុង សកម្មភាព មនុស្សធម៌ នេះ ក្នុង ន័យ ជួយ ពនឿន ការ កាត់បន្ថយ អត្រា ភាពក្រីក្រ ការអភិវឌ្ឍ សហគមន៍ និង ការលើកកម្ពស់ កម្រិត ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន រាជធានី ភ្នំពេញ ឱ្យ កាន់តែ មាន ភាពប្រសើរឡើង ។
លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា បាន កោតសរសើរ ដល់ កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ ដែល បាន បំពេញ បេសកកម្មភាព មនុស្ស ក្នុង មូលដ្ឋាន របស់ ខ្លួន បាន យ៉ាង ល្អ ប្រសើរ និង មាន ប្រសិទ្ធិភាព ខ្ពស់ ក្នុង ការជួយសង្គ្រោះ ដល់ ជនរងគ្រោះ និង ជន ងាយ រងគ្រោះ ។
( ភ្នំពេញ ) ៖ បុគ្គលិក អង្គការ « សុវណ្ណ កុមារ » កម្ពុជា នាំគ្នា តវ៉ា តាម ផ្លូវ ច្បាប់ ទៅដល់ ក្រុម មេធាវី ការពារ ក្តី ហើយ បន្ទាប់ពី ពួកគេ ជាង ២០ នាក់ ត្រូវបាន គេ បញ្ឈប់ ពី ការងារ ដោយ គ្មាន មូលហេតុ ច្បាស់លាស់ ។ ការប្រមូលផ្តុំ គ្នា ធ្វើ ការតវ៉ា នេះ ធ្វើឡើង កាលពី ថ្ងៃទី ១៨ ខែសីហា កន្លងទៅ ថ្មី ៗ នេះ ។
មណ្ឌល ថែទាំ កុមារ « សុវណ្ណ កុមារ » កម្ពុជា មាន ទីតាំង តាម បណ្តាយ ផ្លូវ ជាតិ លេខ១ ភូមិ ក្តី តា កុយ សង្កាត់ វាល ស្បូវ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។ មជ្ឈមណ្ឌល នេះ មាន កុមារ ប្រមាណ ជាង ៥០ នាក់ កំពុង ស្នាក់ នៅ នា ពេល បច្ចុប្បន្ន ហើយ បាន ចុះ អនុស្សរណៈ នៅ ក្រសួង ការបរទេស កាលពី អំឡុង ខែមករា ឆ្នាំ ២០០៤ ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ហែម ថេង អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ ក្រសួង មហាផ្ទៃ បាន អញ្ជើញ ដឹកនាំ បើក កិច្ចប្រជុំ ដ៏ សំខាន់ មួយ ដើម្បី ជំរុញ អនុវត្ត ផ្ដោត សំខាន់ លើ ការស្រាវជ្រាវ ករណី បណ្ដឹង តវ៉ា ជា ខ្មែរ របស់ ជន អន្តោប្រវេសន្ដ ដែល បាន ប្រព្រឹត្ត ឡើង នៅ សាលា ខណ្ឌ ឫស្សីកែវ ពេញ មួយ ព្រឹក ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០១៩ ។
កិច្ចប្រជុំ នេះ មាន ការអញ្ជើញ ចូលរួម ពី លោក ឧត្តមសេនីយ៍ ត្រី ស សំណាង ស្នងការ រង នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ លោក វរសេនីយ៍ ទោ គល់ យី អធិការ នគរបាល ខណ្ឌ ឫស្សីកែវ នាយ ប៉ុស្ដិ៍ រដ្ឋបាល និង អាជ្ញាធរ សង្កាត់ - ភូមិ ផងដែរ ។
ក្នុង កិច្ចប្រជុំ នេះ ដែរ លោក ឧត្តមសេនីយ៍ ត្រី ស សំណាង បាន ធ្វើ របាយការណ៍ ជំរាប ជូន ដោយ សង្ខេប លើក ការងារ គ្រប់គ្រង ជន អន្តោប្រវេសន៍ នៅ រាជធានី ភ្នំពេញ ដែល ក្រុមការងារ ជំនាញ ប្រើប្រាស់ ក្រម នីតិវិធី របស់ ខ្លួន ក្នុង ការចុះ ធ្វើ ការស្រាវ ដល់ មូលដ្ឋាន ផ្ទាល់ ដើម្បី ស្វែងរក ការពិត ចំពោះ ករណី បណ្ដឹង តវ៉ា ជា ខ្មែរ របស់ ជន អន្តោប្រវេសន្ដ ឃើញ ថា សម្រេចបាន ជោគជ័យ យ៉ាង ល្អ ប្រសើរ ជា បណ្ដើរ ៗ ហើយ សម្រាប់ ជូន ថ្នាក់ដឹកនាំ និង សង្គមជាតិ ។
លោក ឧត្តមសេនីយ៍ ឯក ហែម ថេង បាន ថ្លែងអំណរគុណ ចំពោះ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដែល បាន រៀបចំ កិច្ចប្រជុំ នេះ ឡើង ប្រកបដោយ ភាពរលូន ព្រោះ បើ ត្រឹម អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ មួយ មិន អាច ទទួលបាន ជោគជ័យ នោះ ទេ ក្នុង ការគ្រប់គ្រង ជន អន្តោប្រវេសន្ដ និង ការស៉ើប អង្កេត លើ ករណី បណ្ដឹង តវ៉ា ជា ខ្មែរ របស់ ជន អន្តោប្រវេសន្ដ លុះត្រាតែ មាន កិច្ចសហការ ល្អ ពី ភាគី ពាក់ព័ន្ធ មាន ស្នងការដ្ឋាន អធិការដ្ឋាន រដ្ឋបាល ប៉ុស្ដិ៍ និង អាជ្ញាធរ សង្កាត់ - ភូមិ ។
លោក ឧត្តមសេនីយ៍ ឯក ហែម ថេង បាន គូសបញ្ជាក់ ថា បន្ទាប់ពី បញ្ចប់ ការជំរឿន ជន បរទេស រយៈពេល ៥ ឆ្នាំ នៃ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ក្រោម អធិបតី សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋ រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ សំខាន់ ៗ នូវ ទូទាំង ប្រទេស គឺ អ្វី ដែល យើង ត្រូវ ចាប់អារម្មណ៍ នៅ ថ្ងៃ នេះ គឺ មាន បណ្ដឹង តវ៉ា ជនជាតិ ខ្មែរ របស់ ជន បរទេស អន្តោបរវេសន្ដ ក្រោយពី រាជធានី ភ្នំពេញ ក៏ ត្រូវបាន បញ្ចប់ នៃ ការធ្វើ ជំរឿន ជន បរទេស ទាំងស្រុង ។
លោក ឧត្តមសេនីយ៍ ឯក បាន គូសបញ្ជាក់ ទៀត ថា ដើម្បីឲ្យ ការងារ លើ ករណី ស្រាវជ្រាវ ស្វែងយល់ រក ការពិត រាល់ បណ្ដឹង តវ៉ា ជា ខ្មែរ របស់ ជន អន្តោប្រវេសន្ដ ប្រកបដោយ ភាពរលូន និង ជោគជ័យ បាន យ៉ាង ល្អ ប្រសើរ ចាំបាច់ ណាស់ ទាមទារ ឲ្យ មាន កិច្ចសហការ ល្អ ក្នុង ការចូល អនុវត្ត រួមគ្នា ពី អាជ្ញាធរ និង សមត្ថកិច្ច ពាក់ព័ន្ធ ៕ ឱសថ Carbactive មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង ការបំបាត់ អាការៈ ហើម ពោះ និង ពិបាក រំលាយ អាហារ
មូលហេតុ ដែល នាំឱ្យ មាន ការ លើក ពេល លើ ការប្រកាស សាលា ក្រម នេះ ត្រូវបាន មន្រ្តី តុលាការ បញ្ជាក់ ថា ដោយសារ សំណុំរឿង នេះ មាន កាស្មុគស្មាញ ច្រើន នាំឲ្យ ក្រុមប្រឹក្សា ពិបាក ក្នុង ការសម្រេច ហេតុ ដូច្នេះ តុលាការ លើក ពេល ទៅ ប្រកាស នៅ ពេល ក្រោយ ។
ជនជាប់ បទ ចោទ នៅក្នុង សំណុំរឿង នេះ រួម មាន៖ ឈ្មោះ ឡាយ វណ្ណ : អតីត អភិបាល ខេត្ត តាកែវ . ឈ្មោះ ឡាយ ណារិទ្ធ អតីត ស្នងការ រង ខេត្ត តាកែវ ( បង ប្រុស លោក ឡាយ វណ្ណៈ ) ត្រូវបាន តុលាការ ចោទប្រកាន់ ពី បទ ឃាតកម្ម ចំណែក ឈ្មោះ ម៉េន សាម៉ៃ និង ជឹម វុធ ត្រូវបាន តុលាការ ចោទប្រកាន់ ពី លាក់ កំបាំង តម្រុយ ។
សូម រំលឹក ថា ជនរងគ្រោះ ឈ្មោះ ចែវ សុវឌ្ឍនា ដែល ជា នារី កំណាន់ របស់ លោក ឡាយ វណ្ណៈ ត្រូវ គេ ប្រទះឃើញ ចងក ស្លាប់ ក្នុង បន្ទប់ គេង របស់ នាង នៅក្នុង ផ្ទះ ជួល ដ៏ ធំ មួយ ដែល លោក ឡាយ វណ្ណៈ ជា អ្នក ជួល ឲ្យ នៅក្នុង ភូមិ ផ្សារ តា កោរ សង្កាត់ រការ ក្នុង ក្រុង ដូន កែវ ខេត្ត តាកែវ កាលពី ល្ងាច ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០១៨ កន្លងទៅ ។
ភ្លាម ៗ ករណី ឃាតកម្ម នេះ ត្រូវ សមត្ថកិច្ច សន្និដ្ឋាន ថា ជា រឿង អត្តឃាត ព្រោះតែ វិបត្តិ ស្នេហា ប៉ុន្ដែ ក្រោយពី បើក ការស្រាវជ្រាវ សមត្ថកិច្ច ជំនាញ របស់ នាយកដ្ឋាន ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ បាន រកឃើញ ថា ករណី ខាងលើ មិន មែន ជា រឿង អត្តឃាត ឡើយ ពោលគឺជា រឿង ឃាតកម្ម ដោយ មាន អ្នកបញ្ជា និង រៀបចំ ទុក សម្លាប់ ជនរងគ្រោះ ។
ក្រោយពី បើក ការស៊ើបអង្កេត សមត្ដ កិច្ច ជំនាញ បាន ឃាត់ខ្លួន ក្រុម ជន ជាប់ចោទ ទាំង ៤នាក់ ខាងលើ នេះ បញ្ជូន ទៅ តុលាការ ចាត់ការ តាម ច្បាប់ តែម្តង ៕ តួកគី ប្រកាស ទុក ពេល ២ខែ ឲ្យ ជនភៀសខ្លួន ស៊ីរី ខុស ច្បាប់ ចាកចេញ ពី ទីក្រុង អ៊ីស្តង់ប៊ុល
( អ៊ីស្តង់ប៊ុល) ៖ រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ តួកគី លោក ស៊ូឡៃ ម៉ាន សយ លូ (Suleyman Soylu) បាន បញ្ជាក់ ប្រាប់ ទូរទស្សន៍ ក្នុង ស្រុក មួយ កាលពី ល្ងាច ថ្ងៃអង្គារ សប្តាហ៍ នេះ ថា ប្រទេស តួកគី ទុក ពេល ឲ្យ ២ខែ បន្ថែម ទៀត ពោល រហូតដល់ ថ្ងៃទី ៣០ ខែតុលា សម្រាប់ ជនភៀសខ្លួន ស៊ីរី ដែល មិន បាន ចុះបញ្ជី ដើម្បី ចាកចេញ ពី ទីក្រុង អ៊ីស្តង់ប៊ុល ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នា ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី២២ ខែសីហា ឆ្នាំ ២០១៩ ។
កាលពី ខែកក្កដា កន្លងទៅ នេះ អភិបាល ក្រុង អ៊ីស្តង់ប៊ុល បាន ប្រកាស ថ្ងៃ ផុត កំណត់ ដែល ត្រូវនឹង ថ្ងៃទី ២០ ខែសីហា សម្រាប់ ឲ្យ ជនភៀសខ្លួន ស៊ីរី វិលត្រឡប់ ទៅ ខេត្ត ដែល ពួកគេ បាន ចុះឈ្មោះ ដំបូង វិញ វិញ បើ ពុំ ដូច្នោះ ទេ នឹង ត្រូវ ប្រឈមមុខ នឹង ការបណ្តេញ ចេញ ដោយ បង្ខំ ។ ប៉ុន្តែ កាលពី ល្ងាច ថ្ងៃអង្គារ សប្តាហ៍ នេះ អាជ្ញាធរ តួកគី បាន ប្រកាស ពន្យា ពេល ២ខែ បន្ថែម ទៀត សម្រាប់ ពួកគេ ពោល រហូតដល់ ថ្ងៃទី ៣០ ខែតុលា ខាងមុខ ។
គួរ ជម្រាប ថា សង្រ្គាម នៅ ប្រទេស ស៊ីរី ដែល បាន អូសបន្លាយជាង ០៨ ឆ្នាំ មក នេះ បាន បណ្តាលឲ្យ មាន ការហូរ ចូល ជនភៀសខ្លួន រាប់ លាន នាក់ ទៅកាន់ ប្រទេស តួកគី លី បង់ និង ប្រទេស ជិតខាង ដទៃ ទៀត ។ ដោយឡែក បច្ចុប្បន្ន ជនភៀសខ្លួន ស៊ីរី ប្រមាណ ៣.៦លាន នាក់ កំពុង ស្នាក់ នៅក្នុង ប្រទេស តួកគី ។ ពួកគេ ត្រូវបាន ផ្តល់ ជូន « ការការពារ បណ្តោះអាសន្ន » ហើយ តម្រូវឲ្យ រស់ នៅ កន្លែង ដែល ពួកគេ បាន ចុះឈ្មោះ ដំបូង ហើយ ការធ្វើដំណើរ ទៅ ខេត្ត ផ្សេង ទៀត តម្រូវឲ្យ មាន ការយល់ព្រម ពី អាជ្ញាធរ ជាមុន សិន ។
ទិន្នន័យ ជា ផ្លូវការ បាន បង្ហាញ ថា ទីក្រុង អ៊ីស្តង់ប៊ុល មាន ជនភៀសខ្លួន ស៊ីរី ដែល បាន ចុះឈ្មោះ ស្រប ច្បាប់ ជិត ៥៤៨.០០០ នាក់ ។ តែ ទោះជា យ៉ាងណា បើ យោង តាម ការប៉ាន់ស្មាន របស់ អភិបាល ក្រុង អ៊ីស្តង់ប៊ុល តួលេខ នេះ អាច លើស ពី ១ លាន នាក់ ទៅ ទៀត ៕
ប្រមុខ ការពារ ជាតិ កម្ពុជា អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ប្រុងប្រយ័ត្ន ក្រុម ខិល ខូច ដែល ចង់ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ប្រុងប្រយ័ត្ន ជន ខិលខូច ដែល ចង់ មក ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ របស់ កម្ពុជា ដែល កើត ចេញពី ការបោះឆ្នោត ។
