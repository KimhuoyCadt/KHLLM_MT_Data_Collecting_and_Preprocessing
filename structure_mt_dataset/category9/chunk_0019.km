( ប៊ុលហ្គារី ) ៖ លោក កែវ រ៉េមី រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី ប្រធាន សហព័ន្ធ កីឡា តេក្វាន់ ដូ ITF អាស៊ី អាគ្នេយ៍ និង ជា ប្រធាន សហព័ន្ធ កីឡា តេក្វាន់ ដូ ITF កម្ពុជា បាន បង្ហាញ ពី មោទកភាព ថា តំណែង ជា អនុប្រធាន សហព័ន្ធ កីឡា តេក្វាន់ ដូអន្តរជាតិ ក្នុង ចំណោម ប្រទេស ១២០ ជា សមាជិក នេះ គឺជា សក្ខីភាព យ៉ាង ច្បាស់ បង្ហាញ ពី កិត្យានុភាព របស់ កម្ពុជា នៅលើ ឆាក អន្តរជាតិ ទាំងមូល ឱ្យ ស្គាល់ ពី កម្ពុជា ។
ការបង្ហាញ មោទកភាព របស់ លោក កែវ រ៉េមី បាន ធ្វើឡើង បន្ទាប់ពី លោក ត្រូវបាន អង្គ សមាជ តេក្វាន់ ដូ នៅ ប្រទេស ប៊ុលហ្គារី ជ្រើសតាំង ជា អនុប្រធាន សហព័ន្ធ កីឡា តេក្វាន់ ដូអន្តរជាតិ នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ ។
លោក កែវ រ៉េមី បាន បន្ថែម យ៉ាង ដូច្នេះ ថា៖ « កម្រិត សាក្សី ចំនួន ៧៤ ប្រទេស ដែល បាន ចូលរួម នេះ បង្ហាញ ឱ្យ ឃើញ ថា កម្ពុជា មាន កិត្យានុភាព បង្ហាញ នូវ កេរ្តិ៍ឈ្មោះ ឱ្យ គេ ស្គាល់ កម្ពុជា ហើយ ឱ្យ គេ ដឹង ថា យើង ស្ថិត នៅក្នុង លំដាប់ មាន សមត្ថភាព មួយ នៅក្នុង ថ្នាក់ដឹកនាំ » ។
( ភ្នំពេញ ) ៖ ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ជាទីគោរព សក្តារៈ ដ៏ ខ្ពង់ខ្ពស់ និង ព្រះមហាក្សត្រី នរោត្តម មុនី នា ថ សីហនុ នៅ ថ្ងៃចន្ទ ទី២៦ ខែសីហា ឆ្នាំ ២០១៩ស្អែក នេះ នឹង យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន ។
លោក គុយ សុផល អ្នកនាំពាក្យ ក្រសួង ព្រះបរម រាជ វាំង បាន ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ ថា ការយាង ទៅកាន់ ទីក្រុង ប៉េកាំង ប្រទេស ចិន របស់ ព្រះមហាក្សត្រ ខ្មែរ និង ព្រះមហាក្សត្រី ធ្វើឡើង តាម ការយាង របស់ ក្រុម គ្រូពេទ្យ ចិន ដើម្បី ពិនិត្យ ព្រះរាជ សុខភាព ដែល តែងតែ ធ្វើឡើង ជា ទៀងទាត់ ពីរ ដង ក្នុង មួយ ឆ្នាំ ។
តារាចម្រៀង ទាំង ៤ដួង ដែល រួមគ្នា បកស្រាយ ចម្រៀង « ទទា យំ ឆ្លង ២០១៩» នេះ រួម មាន៖ អ្នកនាង ឆោម ឆ ពុំ . កញ្ញា សុខ សីឡាលីន . កញ្ញា ចំរើន សុភក្ត្រ និង កញ្ញា រ័ត្នរចនា ដែល សុទ្ធតែ ជា តារា ម្រៀង មាន សំនៀង ពិរោះ រណ្តំចិត្ត ហើយ មាន ឈ្មោះ បោះ សំឡេង លើ វិថី សិល្បៈ ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ថ្ងៃអាទិត្យ ទី២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន និពន្ធ បទចម្រៀង ថ្មី មួយ បទ ទៀត ដោយ ដាក់ ចំណងជើង ថា « ទទា យំ ឆ្លង ២០១៩» ។ សម្តេច តេជោ បាន គូសបញ្ជាក់ ថា បទចម្រៀង ថ្មី មួយ បទ នេះ សម្តេច និពន្ធ ឡើង ដើម្បីឱ្យ ស្រប ជាមួយ សភាពការណ៍ ថ្មី ។
លោក កែវ រ៉េមី ត្រូវបាន អង្គ សមាជ តេក្វាន់ ដូ ជ្រើសតាំង ជា អនុប្រធាន សហព័ន្ធ កីឡា តេក្វាន់ ដូអន្តរជាតិ
ការសម្រេច ជ្រើសរើស លោក កែវ រ៉េមី ធ្វើជា អនុប្រធាន សហព័ន្ធ កីឡា តេក្វាន់ ដូអន្តរជាតិ នេះ បាន ធ្វើឡើង ស្រប ពេល ដែល លោក បាន ដឹកនាំ គណៈប្រតិភូ តេក្វាន់ ដូកម្ពុជា ចូលរួម បើក មហាសន្និបាត លើក ទី ២៧ នៃ ព្រឹតិ្តការណ៍ តេក្វាន់ ដូ ពិភពលោក ប្រទេស ប៊ុលហ្គារី នា ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ ( ពេលវេលា នៃ កម្ពុជា ) ។
ការប្រកួត កីឡា តេក្វាន់ ដូ មាន បណ្ដា ប្រទេស ចូលរួម ចំនួន ៧៤ អត្តពលិក តេក្វាន់ ដូ ITF ជម្រើសជាតិ ១៧នាក់ ( ស្រី ២នាក់ ) ពី កម្ពុជា ចូលរួម ក្នុង ព្រឹត្តិការណ៍ ពិភពលោក នេះ ផងដែរ ៕ បទល្មើស នេសាទ ខុស ច្បាប់ មួយ កន្លែង នៅ ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម ត្រូវ កម្លាំង នគរបាល ចុះបង្ក្រាប
( កំពង់ចាម ) ៖ បទល្មើស នេសាទ ខុស ច្បាប់ មួយ កន្លែង ( លូស្បៃ មុង ) នៅ ចំណុច អាងទឹក អណ្ដូង អាង ស្ថិង ក្នុង ភូមិ គោក ស្រឡៅ ឃុំ បារាយណ៍ ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម ត្រូវ កម្លាំង នគរបាល ចុះបង្ក្រាប បាន នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ ។
ស្នងការ នគរបាល ខេត្ត កំពង់ចាម លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ឲ្យដឹង ថា ក្រោយពី បាន ទទួល ព័ត៌មាន ពី ប្រជាពលរដ្ឋ លោក បាន ចាត់ ជំនាញ ការិយាល័យ នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច សហការ ជាមួយ ជំនាញ អធិការដ្ឋាន នគរបាល ស្រុក ព្រៃឈរ អាជ្ញាធរ មូលដ្ឋាន ឃុំ បារាយរណ៍ និង កម្លាំង ប្រជាការពារ ចុះ ប្រតិបត្តិការ បង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ នេះ តែម្ដង ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ជា លទ្ធផល បង្ក្រាប បាន លូស្បៃ មុង ចំនួន ១៥មាត់ . សាច់ របាំង រត់ ចំនួន ១.២០០ ម៉ែត្រ . ចម្រឹង បង្គោល ឫស្សី ចំនួន ៣៥០ ដើម ហើយ ចំពោះ វត្ថុតាង ដែល រឹបអូស ជំនាញ បាន ធ្វើ ការកាប់បំផ្លាញ និង ដុត ចោល នៅ កន្លែង កើត ហេតុ ដោយ មាន ការឯកភាព ពី លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ចាម ៕ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៥ ខែសីហា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ១.៥៩១ គ្រឿង និង ផាក ពិន័យ ១. ៣៥៨ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង ៣.២៩៥ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ១.៥៩១ គ្រឿង ( ម៉ូតូ ៨៥%) . អប់រំ២៣៣ គ្រឿង និង ផាក ពិន័យ ១. ៣៥៨ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៥ ខែសីហា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ២. ០៣៤ គ្រឿង . អប់រំ ១៤១ គ្រឿង និង ផាក ពិន័យ ១.៣១៣ គ្រឿង ។
លោកស្រី គួច ណាវី បាន លើកឡើង ថា បច្ចុប្បន្ន CASIO កំពុង ទទួលបាន ការគាំទ្រ ជាខ្លាំង ក្នុង ប្រទេស កម្ពុជា ហើយ ស្រប ពេល កំណើន សេដ្ឋកិច្ច ជាតិ កំពុង មាន ការរីកចម្រើន ប្រជាពលរដ្ឋ មាន ជីវភាព សមរម្យ បាន រស់ នៅ ជាមួយ ភាពទាប់ សម័យ បាន ធ្វើឱ្យ អត្រា នៃ ការប្រើប្រាស់ ផលិតផល នាឡិកា ម៉ាក ល្បី ៗ កាន់តែ មាន ការកើនឡើង យ៉ាង ច្រើន ផងដែរ ជាមួយនឹង កំណើន នេះ លោកស្រី បាន រំពឹង ថា នៅ ថ្ងៃ អនាគត CASIO នឹង មាន ការប្រើប្រាស់ កាន់តែ ច្រើន ជាមួយ ការជឿជាក់ លើ គុណភាព និង តម្លៃ របស់ នាឡិកា ដ៏ ទំនើប របស់ ជប៉ុន មួយ នេះ ។
លោក រំពឹង ថា ដោយសារ ការ រស់នៅ ប្រកបដោយ សុខ សន្តិភាព និង ភាពរីកចម្រើន របស់ កម្ពុជា ដូច បច្ចុប្ប នេះ ប្រជាពលរដ្ឋ ខ្មែរ និង គាំទ្រ ផលិតផល CASIO កាន់តែ ច្រើន បន្ថែម ទៀត ។
ប្រជាពលរដ្ឋ ក្រីក្រ ២៥០ គ្រួសារ នៅ ស្រុក កំពង់រោទិ៍ ខេត្ត ស្វាយរៀង ទទួលបាន អំណោយ មនុស្សធម៌
ពិធី នេះ បាន ធ្វើឡើង មាន ការចូលរួម ពី លោក តឹក ពិសិដ្ឋ អភិបាល រង ស្រុក កំពង់រោទិ៍ ព្រះសង្ឃ ព្រមទាំង ក្រុមប្រឹក្សា ឃុំ ថ្មី ជាច្រើន រូប ផងដែរ ។
លោក លីម គឹម សេង បាន លើកឡើង ថា ក្នុង នាម ជា ប្រធាន ក្រុមហ៊ុន ពិតជា មាន ក្តីរំភើប និង សប្បាយរីករាយ ដែល បាន ឃើញ ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
លោក បាន បន្ត ទៀត ថា នឹង ខិតខំ បន្ត ទៀត ក្នុង ការជួយ ពលរដ្ឋ ក្រីក្រ ជួប ការខ្វះខាត ទៅ តាម លទ្ធភាព ដែល អាច ធ្វើ ទៅ បាន ។ ការធ្វើ ទាន ឬ ដាក់ ទាន សម្រាប់ នរណា ម្នាក់ ដែល កំពុង ជួប ការលំបាក និង ខ្វះខាត ពិតជា បាន បុណ្យ ។
ក្នុង ឱកាស នោះ ដែរ លោក លីម គឹម សេង បាន ថ្លែងអំណរគុណ ដល់ ក្រុមការងារ ព្រមទាំង អាជ្ញាធរដែនដី ជាពិសេស ព្រះតេជគុណ សុវណ្ណ រិទ្ធ ដែល បាន ខិតខំ រៀបចំ ឲ្យ មាន កម្មវិធី នេះ ឡើង ដើម្បី បាន សំណេះសំណាល និង បាន ធ្វើ ទាន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ នៅ ពេល នេះ និង មាន ចែក ទាន ជា បន្តបន្ទាប់ នៅលើ ក ៗ ក្រោយ ទៀត ។
លោក តឹក ពិសិដ្ឋ បាន អំនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ថែរក្សា សុខភាព ដោយ ហូប ស្អាត ផឹក ស្អាត និង រស់ នៅ ស្អាត និង មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ខណៈ ដែល មាន ភ្លៀង ផ្គរ ន្ទះ ខ្យល់ កន្ត្រាក់ ត្រូវ រក កន្លែង ដែល មាន សុវត្ថិភាព បញ្ចៀស គ្រោះថ្នាក់ ផ្សេង ៗ ដែល កើតឡើង ជា យថាហេតុ ។ ជាពិសេស ត្រូវ មើល ថែ ក្មេង ៗ ឲ្យបាន ល្អ កុំ ឲ្យ លេង ទឹក នា រដូវ វស្សា នេះ ដែល នាំ លង់ទឹក និង ប្រុងប្រយ័ត្ន ខ្ពស់ នូវ ជំងឺ គ្រុន ឈាម ដែល កំពុង មាន ការផ្ទុះឡើង គួរឲ្យ កត់សម្គាល់ ចំពោះ កុមារ និង មនុស្ស ធំ ពេញ វ័យ ។
អំណោយ ដែល ផ្ដល់ជូន ប្រជាពលរដ្ឋ មាន អង្ករ មី ប៊ី ចេង ប្រេង ឆា ទឹកស៊ីអ៊ីវ ទឹកត្រី មុង ភួយ ស្បែកជើង និង ថវិកា មួយ ចំនួន ក្នុង មួយ គ្រូ សារ ។ សម្រាប់ ក្មេង ៗ វិញ ទទួល កាតាប សៀវភៅ ប៊ិច ព្រមទាំង ថវិកា មួយចំនួន ផងដែរ ៕ ទិញ គោ ជល់ ទុក ឱ្យ កូន ពេល ប្រឡង បាក់ឌុប ចប់ មាន សំណាង ឈ្នះ រង្វាន់ ម៉ូតូ មួយ គ្រឿង !
កសិករ ឈ្នះ រង្វាន់ មាន ឈ្មោះ យ៉ែម ស្រី ថុល អាយុ ៤០ ឆ្នាំ រស់ នៅ ភូមិ ពូន ភ្នំ ស្រុក បាទី ខេត្ត តាកែវ ។
ក្រោយមក ប្ដី គាត់ ឱ្យ ទូរស័ព្ទ មក ក្រុមហ៊ុន ដើម្បី សួរនាំ និង ផ្ទៀងផ្ទាត់ លេខ កូដ ។ ក្រោយមក ក្រុមហ៊ុន បាន ប្រាប់ គាត់ មកវិញ ថា កូដ នោះ ត្រឹមត្រូវ នឹង រង់ចាំ បើក រង្វាន់ ក្នុង ពេល ឆាប់ ៗ នេះ ។
លោក សុខ ចិន្តា សោភា ប្រាប់ ធុរ ជន កូរ៉េ និង ចិន ពី ការតាំងចិត្ត របស់ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ក្នុង ការផ្តល់ កិច្ច សម្រួល ដល់ អ្នក វិនិយោគ
លោក សុខ ចិន្តា សោភា បាន សម្ដែង នូវ សេចក្តី សោមនស្ស រីករាយ និង ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ វត្តមាន របស់ គណៈប្រតិភូ ដែល នេះ ជា លើក ទី មួយ នៃ ការរៀបចំ បេសកកម្ម ក្រៅ ប្រទេស រួមគ្នា ចិន និង កូរ៉េ ក្រោម ក្របខណ្ឌ នៃ កិច្ចសហប្រតិបត្តិការ « ចិន កូរ៉េ បូក មួយ » ស្រប តាម ការផ្តួចផ្តើម គំនិត របស់ លោក ប្រធានាធិបតី ចិន និង ប្រធានាធិបតី នៃ សាធារណរដ្ឋ កូរ៉េ ។
ជំនួប ពិភាក្សា ការងារ នេះ ក៏ ជា ផ្នែក មួយ នៃ ការអនុវត្ត អនុស្សារណៈ យោគយល់ គ្នា រវាង ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា និង ភ្នាក់ងារ ជំរុញ វិនិយោគ និង ពាណិជ្ជកម្ម កូរ៉េ (KOTRA) ស្តីពី កិច្ចសហប្រតិបត្តិការ សម្រួល ការវិនិយោគ ដែល ត្រូវបាន ចុះហត្ថលេខា កាលពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក មូន ជេអ៊ីន (Moon Jae In) ប្រធានាធិបតី នៃ សាធារណរដ្ឋ កូរ៉េ ។
លោក សុខ ចិន្តា សោភា បាន ជម្រាប ជូន គណៈប្រតិភូ អំពី គោល នយោបាយ បើក ចំហ ចំពោះ ការ វិនិយោគ បរទេស របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង បាន ឆ្លើយ បំភ្លឺ ចំពោះ សំនួរ នានា របស់ គណៈប្រតិភូ ពាក់ព័ន្ធ នឹង បរិយាកាស វិនិយោគ នៅ កម្ពុជា ។
លោក ក៏ បាន បាន ជម្រាប ជូន គណៈប្រតិភូ ចិន និង កូរ៉េ ពី ការព្យាយាម និង ការតាំងចិត្ត របស់ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ក្នុង ការផ្តល់ កិច្ចសម្រួល វិនិយោគ ដល់ អ្នក វិនិយោគ ចិន និង កូរ៉េ ក្នុង ក្របខណ្ឌ វិធានការ កំណែទម្រង់ មុត ស្រួច ទាំង ១៧ ចំណុច ដែល បាន ដាក់ចេញ ដោយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នា ឱកាស វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ ។
តំណាង គណៈប្រតិភូ ចិន និង កូរ៉េ បាន ថ្លែងអំណរគុណ ចំពោះ លោក សុខ ចិន្តា សោភា និង តំណាង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដែល បាន ចំណាយ ពេលវេលា ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ គណៈប្រតិភូ នា ពេលនេះ និង បាន ជម្រាប ពី បំណង អញ្ជើញ លោក និង តំណាង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ចូលរួម វេទិកា ធុរកិច្ច ចិន - កូរ៉េ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ៕
ទីប្រឹក្សា នាយក រដ្ឋមន្ដ្រី លោក ឡូវ ហ៊ឹង ទទូច ឲ្យ ប្រជាពលរដ្ឋ ចូលរួម សហការ ជាមួយ សមត្ថកិច្ច លុបបំបាត់ គ្រឿងញៀន និង ភាពអសកម្ម នៅ តាម មូលដ្ឋាន ដែល ជះឥទ្ធិពល យ៉ាង ខ្លាំង ដល់ ក្មេង
ក្នុង ពិធី នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ តំណាង ក្រុមហ៊ុន KH NIROT និង លោក អ៊ែល សារ៉ុម បាន លើកឡើង ថា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន តាមរយៈ លោក ហ៊ុន ម៉ាណែត បាន កំពុង បន្ត ស្ថាបនា ឡើង ពី មួយ ថ្ងៃ ទៅ ថ្ងៃ ធ្វើឲ្យ មាន សមិទ្ធផល ជាច្រើន បាន កើតឡើង ដូចជា ផ្លូវ ថ្នល់ សាលារៀន បណ្ណាល័យ វត្តអារ៉ាម អណ្តូង ទឹក សាលា ឃុំ មន្ទី បក្ស ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល ឃុំ ម៉ាស៊ីនភ្លើង និង សាខា កាកបាទ ក្រហម ស្រុក ស្រីសន្ធរ ដែល បាន ឧបត្ថម្ភ ការកសាងឡើង ដោយ ឧកញ៉ា ឡូវ ហ៉ឹង ទាំងស្រុង ។
លិខិត ជូន ដំណឹង នេះ ចេញ ដោយ លោក កូយ សៅ ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ និង ជា អនុប្រធាន សាលាដំបូង រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០១៩ បន្ទាប់ពី បាន បញ្ជូន សំណុំរឿង ទៅ ជំនុំជម្រះ កាលពី ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០១៩ ។
មន្រ្តី តុលាការ បាន និយាយ ថា ក្នុង សំណុំរឿង នេះ លោក សម រង្ស៉ី ត្រូវបាន ចោទប្រកាន់ ចំនួន ២បទល្មើស រួម មាន បទ ប្រមាថ និង បទ ញុះញង់ ឲ្យ ប្រព្រិត បទឧក្រិដ្ឋ ជាអាទិ៍ តាម បញ្ញត្តិ មាត្រា ៤៩៥ និង ៥០២ នៃ ក្រម ព្រហ្មទណ្ឌ ។ ជន ត្រូវ ចោទ បាន ប្រព្រឹត្ត បទល្មើស ក្នុង កំឡុង ខែមេសា ដល់ តុលា ឆ្នាំ ២០១៨ ។ ពាក់ព័ន្ធ នឹង សំណុំរឿង នេះ ជន ត្រូវ ចោទ មាន ៤នាក់ ក្នុង នោះ មាន លោក សម រង្សុី . លោក គង់ ម៉ាស់ លោក ហូ វ៉ាន់ និង កាក់ កុម្ភារ ។
មន្រ្តី ដដែល បាន និយាយ ថា រហូតមកដល់ ពេលនេះ មាន សំណុំរឿង មួយចំនួន ទៀត របស់ លោក សម រង្ស៉ី កំពុង ស្ថិត នៅ ដំណាក់កាល ស៊ើបសួរ នៅឡើយ ទេ ។
ការអញ្ជើញ ទៅ ចូលរួម ខួប អនុស្សាវរីយ៍ លើក ទី២០ នៃ ការធ្វើ ប្រជាមតិ របស់ ប្រជាជន ទីម័រ ឡេស្តេ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ លោក ទួរ ម៉ាតាន់ រូអាក់ នាយក រដ្ឋមន្រ្តី នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ទីម័រ ឡេស្តេ ។ តំណាង មកពី បណ្តា ប្រទេស សមាជិក អាស៊ាន ប្រទេស និយាយ ភាសា ព័រទុយហ្គាល់ ប្រទេស អូស្រ្តាលី និង អង្គការ សហ ប្រជាជាតិ ក៏ នឹង ចូលរួម ពិធី នោះ ដែរ ផងដែរ ។
សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ទីម័រ ឡេស្តេ បាន ភ្ជាប់ ទំនាក់ទំនង ការទូត ជាមួយ កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០០២ ក្រោយពី បាន ធ្វើ ការបោះឆ្នោត ប្រជាមតិ ទាមទារ ឯករាជ្យ ក្រោម ការឧបត្ថម្ភ របស់ អង្គការ សហ ប្រជាជាតិ កាលពី ថ្ងៃទី ៣០ ខែសីហា ឆ្នាំ ១៩៩៩ ៕
យោង តាម សេចក្ដីរាយការណ៍ ជាច្រើន ក្រុម ប្រតិភូ អាមេរិក មាន ការភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ចំពោះ ដំណើរ ទស្សនកិច្ច រយៈពេល ខ្លី របស់ លោក Zarif ដ្បិត ពួកគេ មិន បាន ដឹង ជាមុន ពី ដំណើរទស្សនកិច្ច នេះ ទេ ខណៈ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ កំពុង មាន ភាពតានតឹង ខ្លាំង បំផុត មួយ មិន ធ្លាប់ មាន មុន មក ។ តែ ទោះជា យ៉ាង នេះ ក្ដី ប្រធានាធិបតី បារាំង លោក ម៉ាក្រុង បាន បញ្ជាក់ ថា ក្រុម ប្រតិភូ ទាំងអស់ ត្រូវបាន គេ ជូនដំណឹង ជាមុន រួច អស់ ហើយ ពី វត្តមាន របស់ រដ្ឋមន្ត្រី ការបរទេស អ៊ីរ៉ង់ ។
មេទ័ព អ៊ីរ៉ង់ ប្រកាស ត្រៀមខ្លួន រួចស្រេច ដើម្បី ទៅ ការពារ កប៉ាល់ ដឹក ប្រេង ដែល អាមេរិក ចង់ តាម ចាប់ ក្រោយ អង់គ្លេស ដោះលែង
