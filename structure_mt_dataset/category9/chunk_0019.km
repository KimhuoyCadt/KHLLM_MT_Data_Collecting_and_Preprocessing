( កំពង់ចាម ) ៖ អនុវត្ត តាម ផែនការ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ លើក ទី៤ របស់ រាជ រដ្ឋាភិបាល និង បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន ជំរុញ ឲ្យ មាន វិធានការបង្ក្រាប សកម្មភាព គ្រឿងញៀន កម្លាំង នគរបាល ខេត្ត កំពង់ចាម បាន បន្ដ ប្រតិបត្តិការ ត្រួតពិនិត្យ រក សារធាតុ ញៀន លើ អ្នកបើកបរ ។
ដោយឡែក មួយ គោលដៅ ទៀត នៅ ចំណុច មុខ ក្លឹប ហ្គោល តាម បណ្តោយ ជាតិ លេខ ៧ ស្ថិត នៅ ភូមិ បឹង ស្នាយ ឃុំ សំបួរ មាស ក្រុង កំពង់ចាម ជំនាញ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន ដឹកនាំ ដោយ លោក វរសេនីយ៍ ទោ ជីវ សេង រស់ នាយ ការិយាល័យ សហការ ជាមួយ ជំនាញ ការិយាល័យ នគរបាល ចរាចរណ៍ ផ្លូវគោក ជំនាញ ស្រុក ជើង ព្រៃ និង ជំនាញ ក្រុង កំពង់ចាម ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ជា លទ្ធផល នៃ ការចុះ ត្រួតពិនិត្យ កម្លាំង ជំនាញ បាន ត្រួតពិនិត្យ រថយន្ត ចំនួន ៦១ គ្រឿង ម៉ូតូ ចំនួន ០៦ គ្រឿង ធ្វើតេស្ត ទឹក ម៉ូត សរុប ៦៧ នាក់ ។ រកឃើញ អ្នក ជាប់ សារធាតុ ញៀន ចំនួន ០៦ នាក់ ។
យ៉ាងណាមិញ លោក ស្នងការ បាន បញ្ជាក់ ថា មុនពេល ឃាត់ខ្លួន ជនសង្ស័យ ២នាក់ ឈ្មោះ ធី ពុទ្ធា និង ឈ្មោះ ដើង ណា ឃីន បាន ដេញ កាប់ គ្នា មក ដល់ ចំណុច គោលដៅ កន្លែង ត្រួតពិនិត្យ សមត្ថកិច្ច បាន បញ្ជា ឲ្យ ឈប់ តែ ជន ទាំង ពីរ មិន ព្រម ឈប់ ហើយក៏ ជិះ ម៉ូតូ បំបុក បារ៉ាស របស់ សមត្ថកិច្ច បង្កឲ្យ មាន របួស លើ សមត្ថកិច្ច ឈ្មោះ វរសេនីយ៍ ត្រី សេង លីណូ អធិការ រង ទទួល ផែនការងារ គ្រឿងញៀន ស្រុក ជើង ព្រៃ ។
ក្នុង ប្រតិបត្តិការ នេះ កម្លាំង សមត្ថកិច្ច ជំនាញ បាន ឃាត់ រថយន្ត រក្សាទុក បណ្តោះអាសន្ន ចំនួន ០៣ គ្រឿង និង ម៉ូតូ ចំនួន ០៣ គ្រឿង នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម ៕ សហរដ្ឋ អាមេរិក កំពុង ពន្លឿន ការលក់ យន្ដហោះ ចម្បាំង F-16 ក្នុង តម្លៃ ៨ពាន់ លាន ដុល្លារ ឱ្យ កោះ តៃវ៉ាន់
ប៉ុន្តែ ការលក់ សព្វាវុធ ឱ្យ កោះ តៃវ៉ាន់ គឺជា រឿង មួយ ដែល ចិន ជំទាស់ ជាដាច់ខាត ដោយ ទីក្រុង ប៉េកាំង ចាត់ទុក ថា តៃវ៉ាន់ ត្រឹមតែ ជា ខេត្ត មួយ របស់ ខ្លួន ប៉ុណ្ណោះ ។ លើស ពី នេះ ទៅ ទៀត ចិន ធ្លាប់ បាន ព្រមាន ជាច្រើន លើក ថា ខ្លួន នឹង មិន ស្ទាក់ស្ទើ ឡើយ ក្នុង ការប្រើប្រាស់ កម្លាំង យោធា បើសិនជា មាន កងកម្លាំង បរទេស ណាមួយ ហ៊ាន បំបែក តៃវ៉ាន់ ចេញពី ចិន ដី គោក ៕
១៖ កម្ពុជា ចេញ សេចក្តីថ្លែងការណ៍ គាំទ្រ រាល់ ចំណាត់ ការ ចាំបាច់ នានា របស់ រដ្ឋាភិបាល ចិន ដើម្បី រក្សា សន្តិភាព សណ្តាប់ធ្នាប់ និង សន្តិសុខ នៅ ហុងកុង ( ចុច អាន )
២៖ អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌៖ សមត្ថកិច្ច នឹង ចាប់ខ្លួន ទណ្ឌិត សម រង្ស៉ី ទោះជា វិល មក ក្នុង ថ្ងៃ ឈប់សម្រាក ៩វិច្ឆិកា ក៏ដោយ ( ចុច អាន )
៣៖ តុលាការ ខេត្ត ក្រចេះ ចេញ ដីកា ឃុំ ខ្លួន ឧកញ៉ា គង់ គ្រឹង និង កូនប្រសា ដាក់ ពន្ធនាគារ ពាក់ព័ន្ធ បទល្មើស ព្រៃឈើ នៅ ស្រុក ស្នួល ( ចុច អាន )
៤៖ កម្ពុជា ដាក់ របាយការណ៍ វឌ្ឍនភាព សិទ្ធិ មនុស្ស និង ប្រជាធិបតេយ្យ ជូន គណៈកម្មការ អឺរ៉ុប ដើម្បី ទប់ទល់ ការព្យួរ EBA ( ចុច អាន )
៩៖ ចាប់ ជនជាតិ ចិន ១២៧ នាក់ នៅ ខេត្ត ព្រះសីហនុ ពាក់ព័ន្ធ ករណី ជម្រិត ទារ ប្រាក់ តាម ប្រព័ន្ធ អ៊ីនធ័រណែត ( ចុច អាន )
១០៖ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស សម្រេច បង្កើត ក្រុមប្រឹក្សា អ្នក ច្បាប់ និង មេធាវី សិទ្ធិ មនុស្ស ( ចុច អាន )
ក្រសួង អប់រំ ក្រើន រំលឹក ជាថ្មី ឲ្យ បេក្ខជន ដែល ត្រូវ ប្រឡង បាក់ឌុប នៅ ថ្ងៃស្អែក សូម ទៅ ពិនិត្យ លេខ តុ លេខ បន្ទប់ នៅ មណ្ឌល ប្រឡង នា ព្រឹក នេះ កុំបី អាក់ខាន !
ការជំរុញ ឲ្យ បេក្ខជន ទៅ ពិនិត្យមើល លេខ តុ លេខ បន្ទប់ នេះ ដើម្បី ងាយស្រួល សម្រាប់ ការប្រឡង នៅ ថ្ងៃទី ១៩ ខែសីហា ស្អែក នេះ ។
លោក ប៉ាន សូរស័ក្តិ កត់សម្គាល់ ពី វឌ្ឍនភាព កីឡា ទូក ប្រពៃណី ខ្នាត អន្តរជាតិ « ទូក នាគ » ទូក កានូ និង ទូក រ៉ូអ៉ីង នៅ កម្ពុជា
( ពោធិ៍សាត់ ) ៖ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម លោក ប៉ាន សូរស័ក្តិ បាន កត់សម្គាល់ អំពី វឌ្ឍនភាព កីឡា ប្រណាំង ទូក ប្រពៃណី ខ្នាត អន្តរជាតិ ឬ « ទូក នាគ » ទូក កានូ និង ទូក រ៉ូអ៉ីង នៅក្នុង ប្រទេស កម្ពុជា ចាប់តាំងពី សហព័ន្ធ កីឡា ទូក កានូ និង រ៉ូអ៉ីង កម្ពុជា បាន កែទម្រង់ រចនាសម្ព័ន្ធ គ្រប់គ្រង របស់ ខ្លួន ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការអភិវឌ្ឍ វិស័យ កីឡា នេះ សំដៅ ចូលរួម ប្រកួត ក្នុង ព្រឹត្តិការណ៍ SEA Games ឆ្នាំ ២០២៣ ខាងមុខ ។
ការលើកឡើង របស់ លោក រដ្ឋមន្ត្រី បាន ធ្វើឡើង នា ឱកាស អញ្ជើញ ជា អធិបតីភាព ពិធី បិទ ការប្រកួត កីឡា ទូក ប្រពៃណី ខ្នាត អន្តរជាតិ « ទូក នាគ » ជ្រើសរើស ជើងឯក ភូមិភាគ បឹង ទន្លេ សាប ដែល រៀបចំឡើង នៅ តាម ដងស្ទឹង ពោធិ៍សាត់ កាលពី រសៀល ថ្ងៃសៅរ៍ ទី១៧ ខែសីហា ឆ្នាំ ២០១៩ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ នៃ រដ្ឋបាល សាលា ខេត្ត ពោធិ៍សាត់ មន្ត្រី ជាន់ ខ្ពស់ សហព័ន្ធ កីឡា ទូក កានូ និង រ៉ូអ៉ីង កម្ពុជា តំណាង វិស័យ ឯកជន និង ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
នៅក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សហព័ន្ធ កីឡា ទូក កានូ និង រ៉ូអ៉ីង កម្ពុជា ដែល បាន សហការ ជាមួយ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ ក្នុង ការរៀបចំ ព្រឹត្តិការណ៍ ខាងលើ រហូត ទទួលបាន ជោគជ័យ ដើម្បី ផ្តល់ ឱកាស ជូន កីឡាករ - កីឡាការិនី ធ្វើ ការបញ្ចេញ ទេពកោសល្យ វាស់ស្ទង់ សមត្ថភាព បច្ចេកទេស ដែល បាន ហ្វឹកហាត់ កន្លងមក ក៏ ដូចជា ផ្តល់ ការកម្សាន្ត ជូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ គ្រប់ ជាតិ សាសន៍ ដែល ចូលមក ទស្សនា និង ធ្វើដំណើរ ឆ្លងកាត់ ទី រួម ខេត្ត ពោធិ៍សាត់ ។
លោក ប៉ាន សូរស័ក្តិ បាន គូសបញ្ជាក់ ថា « ជ័យជម្នះ ដែល កីឡាករ - កីឡាការិនី ទទួលបាន នា ពេលនេះ ពិតជា មិន អាច កាត់ផ្តាច់ ពី ការខិតខំ ហ្វឹកហាត់ ជាប្រចាំ បូក ផ្សំ ការតស៊ូព្យាយាម គោរព វិន័យ ក្រមសីលធម៌ ល្អ និង បទដ្ឋាន បច្ចេកទេស បាន ត្រឹមត្រូវ ក្នុង ការប្រកួត » ។
លោក រដ្ឋមន្ត្រី ក៏ បាន ជម្រាប ជូន អង្គ ពិធី អំពី វឌ្ឍនភាព កំណើន សេដ្ឋកិច្ច ជាតិ និង សមិទ្ធផល ផ្នែក សង្គម នៅក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ដែល ជា បច្ច័យ នាំឱ្យ កម្ពុជា ទទួលបាន ការកោតសរសើរ និង ទំនុកចិត្ត ខ្ពស់ ពី មជ្ឈដ្ឋាន អន្តរជាតិ ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ (SEA Games) នៅក្នុង ឆ្នាំ ២០២៣ ខាងមុខ ។
បន្ទប់ ពិនិត្យ និង ព្យាបាល មាត់ ធ្មេញ នេះ មាន ការគាំទ្រ ពី លោក ទន្ត បណ្ឌិត ទិត ហុង យឺ ក្រុម គ្រូពេទ្យ និង បុគ្គលិក ទាំងអស់ នៃ មន្ទីរពេទ្យ ទន្តសាស្ត្រ រំចង់ ក្នុង ការជួយ ឧបត្ថម្ភ និង ជួយ រៀបចំ ឲ្យ មាន បន្ទប់ ព្យាបាល មាត់ ធ្មេញ បំពាក់ ឧបករណ៍ សម្ភារ ពិនិត្យ និង ព្យាបាល មាត់ ធ្មេញ ដ៏ ទំនើប ព្រមទាំង បាន ដាក់ កម្មវិធី ចុះ មក ជួយ ពិនិត្យ អប់រំ និង ព្យាបាល ជំងឺ មាត់ ធ្មេញ ដល់ កងកម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ ជា ប្រចាំ រៀងរាល់ សប្តាហ៍ ។
ក្នុង ឱកាស នេះ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន បង្ហាញ ការចាប់អារម្មណ៍ ខ្ពស់ ចំពោះ ការថែទាំ ការការពារ និង ការព្យាបាល ជំងឺ មាត់ ធ្មេញ ជាពិសេស ចំពោះ មន្ត្រី ក្រោម ឱវាទ គ្រប់ រូប ដោយ លោក តែង លើក យក បញ្ហា សុខភាព មក ដាស់តឿន ដល់ មន្ត្រី ក្រោម ឱវាទ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ តាមដាន និង ពិនិត្យ សុខភាព ជាប្រចាំ ត្រូវ ដុស សម្អាត ធ្មេញ រៀងរាល់ ក្រោយពេល ញុំា អាហារ រួច និង កុំ ញុំា អាហារ ភេសជ្ជ ផ្អែម ញឹកញាប់ ពេក ។
លើស ពី នេះ ទៅ ទៀត ការថែទាំ ព្យាបាល ធ្មេញ នៅ ដំណាក់កាល ដំបូង កុំ ឲ្យ បាត់បង់ ធ្មេញ អាច បញ្ឈប់ បញ្ហា ធ្ងន់ធ្ងរ ផ្សេង ៗ នៅពេល ខាងមុខ បាន ដូចជា ជំងឺ ក្រពះ ថ្លើម បេះដូង តំរងនោម សរសៃ ប្រសាទ ទឹកនោម ផ្អែម ជាដើម ដែល ទាំងអស់ នេះ សុទ្ធតែ ជា ជំងឺ ដែល ត្រូវ ចំណាយ ប្រាក់កាស ច្រើន ដើម្បី ព្យាបាល ដូច្នេះ ការថែទាំ សុខភាព មាត់ ធ្មេញ ឲ្យបាន ល្អ គឺជា ការចាំបាច់ ខ្លាំង ណាស់ ៕
ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ៖ មរណភាព លោក ស៊ើយ កែវ ជា ការបាត់បង់ ឥស្សរជន បូជា កម្លាំង កាយ ចិត្ត ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ
( ភ្នំពេញ ) ៖ ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ លោក អ៉ឹម ឈុន លឹម បាន សម្តែង នូវ មរណទុក្ខ យ៉ាង ក្រៀម និង សោកស្តាយ ជា អនេក ចំពោះ មរណភាព របស់ នាយ ឧត្តមសេនីយ៍ ស៊ើយ កែវ សមាជិក ព្រឹទ្ធសភា ។
ក្នុង លិខិត រំលែក មរណទុក្ខ ផ្ញើ ជូន ក្រុមគ្រួសារ នៅ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ លោក អ៉ឹម ឈុន លឹម ចាត់ទុក មរណភាព របស់ លោក ស៊ើយ កែវ គឺជា ការបាត់បង់ ឥស្សរជន មួយ រូប ដែល បាន បូជា កម្លាំង កាយ ចិត្ត បញ្ញា ស្មារតី ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ ។
សព របស់ លោក ត្រូវបាន តម្កល់ ធ្វើ បុណ្យ នៅ គេហឋាន ក្នុង សង្កាត់ បឹង កន្សែង ក្រុង បាន លុង ខេត្ត រតនគិរី ៕
( ភ្នំពេញ ) ៖ អគ្គិភ័យ មួយ បាន កំពុង ឆេះ ផ្ទះ ប្រជាពលរដ្ឋ យ៉ាង ខ្លាំង នៅ ភូមិ កោះ ក្របី សង្កាត់ ព្រែក ថ្មី ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ នា ម៉ោង ជាង ៨ យប់ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ ។
TOP NEWS: កម្ពុជា ចេញ សេចក្តីថ្លែងការណ៍ គាំទ្រ រាល់ ចំណាត់ ការ ចាំបាច់ នានា របស់ រដ្ឋាភិបាល ចិន ដើម្បី រក្សា សន្តិភាព សណ្តាប់ធ្នាប់ និង សន្តិសុខ នៅ ហុងកុង
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៅ ល្ងាច ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្តីថ្លែងការណ៍ មួយ ដោយ បង្ហាញ ការគាំទ្រ រាល់ ចំណាត់ ការ ចាំបាច់ នានា របស់ រដ្ឋាភិបាល ចិន ដើម្បី រក្សា សន្តិភាព សណ្តាប់ធ្នាប់ សាធារណៈ និង សន្តិសុខ នៅ ទីក្រុង ហុងកុង ។
សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង ការបរទេស បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖
១៖ ប្រទេស កម្ពុជា គោរព « គោល នយោបាយ ចិន មួយ » ហើយ ចាត់ទុក ស្ថានការណ៍ ដែល កំពុង វិវត្ត នៅក្នុង ទីក្រុង ហុងកុង ជា កិច្ចការ ផ្ទៃក្នុង របស់ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
២៖ ប្រទេស កម្ពុជា គាំទ្រ នូវ រាល់ ចំណាត់ ការ ចាំបាច់ នានា របស់ រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន និង តំបន់ រដ្ឋបាល ពិសេស ទីក្រុង ហុងកុង ដើម្បី រក្សា សន្តិភាព សណ្តាប់ធ្នាប់ សាធារណៈ សន្តិសុខ ជាតិ និង ការរួមរស់ នៅ ជាមួយគ្នា ប្រកបដោយ ភាពសុខដុមរមនា ក្នុង សង្គម ដោយ អនុលោម ទៅតាម ច្បាប់ និង បទប្បញ្ញត្តិ ទាំងឡាយ របស់ ប្រទេស និង ការប្រតិបត្តិ ជា អន្តរជាតិ ។
៣៖ ប្រទេស កម្ពុជា ចង់ ឃើញ ការត្រឡប់មក រក ប្រក្រតី ភាព ឱ្យ បាន ឆាប់ នូវ ជីវភាព រស់ នៅ ប្រកបដោយ សុខ សន្តិភាព របស់ ប្រជាជន ហុងកុង ទាំងមូល ។
សេចក្តីថ្លែងការណ៍ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង ស្រប ពេល ដែល ទីក្រុង ហុងកុង កំពុង ផ្ទុះ នូវ បាតុកម្ម តវ៉ា ដ៏ ធ្ងន់ធ្ងរ ប្រឆាំង នឹង ការធ្វើ បត្យាប័ន រហូតដល់ មាន ការសង្ស័យ ថា ជា ការជំរុញឱ្យ មាន បដិវត្ត ពណ៌ នៅ តំបន់ នេះ ផងដែរ ៕
ខាងក្រោម នេះ ជា សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង ការបរទេ ស៖
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ចុះ សួរសុខទុក្ខ ព្រឹទ្ធាចារ្យ ប៊ូ ថង ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ កាល់ម៉ែត
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន ដឹកនាំ ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ អញ្ជើញ សួរសុខទុក្ខ និង សម្តែង ការគួរសម ជាមួយ ព្រឹទ្ធាចារ្យ ប៊ូ ថង ទីប្រឹក្សា សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា នៃ កម្ពុជា នៅ មន្ទីរពេទ្យ កាល់ម៉ែត រាជធានី ភ្នំពេញ ។
ក្នុង ឱកាស នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន សម្តែង នូវ ការ នឹករលឹក ចំពោះ លោក ព្រឹទ្ធាចារ្យ ប៊ូ ថង ជា ឥស្សរជន ម្នាក់ ដែល មួយ ជីវិត របស់ លោក ព្រឹទ្ធាចារ្យ បាន លះបង់ កម្លាំង កាយ កម្លាំងចិត្ត ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ ព្រមទាំង នាំប្រសាសន៍ សាកសួរ សុខទុក្ខ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ផងដែរ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ជូន ពរ លោក ព្រឹទ្ធាចារ្យ សូម ឱ្យ មាន សុខភាពល្អ ឆាប់ ជា ពី ជំងឺ រោគា ព្យាធិ ទាំងឡាយ ទាំងពួង និង មាន ជន្មាយុ យឺន យូរ ព្រមទាំង ជួបប្រទះ តែ សេចក្តីសុខ សេចក្តី ចម្រើន ត រៀង ទៅ ។
ជា កិច្ច ឆ្លើយតប លោក ព្រឹទ្ធាចារ្យ ប៊ូ ថង បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ដែល បាន ឆ្លៀត ឱកាស ដ៏ មមាញឹក អញ្ជើញ មក សួរ សុខទុក្ខ រូប លោក ដល់ មន្ទីរពេទ្យ ដែល នេះ សបញ្ជាក់ ឱ្យ ឃើញ ពី ទឹកចិត្ត គោរព ស្រឡាញ់ គ្នា ទៅ វិញ ទៅមក ។
ទោះបីជា កំពុងតែ សម្រាក នៅលើ គ្រែ ក្នុង មន្ទីរពេទ្យ យ៉ាងណា ក្តី ក៏ ព្រឹទ្ធាចារ្យ ប៊ូ ថង មិន ដែល បំភ្លេច ពី ស្ថានភាព នយោបាយ នៅ ប្រទេស និង ដំណើរ វិវត្តន៍ នានា នៅ តាម ព្រំដែន ជាមួយ ប្រទេស ជិតខាង កម្ពុជា ទាំងនេះ បាន បង្ហាញ ពី ទឹកចិត្ត ស្នេហាជាតិ មាតុភូមិ របស់ លោក តា ព្រឹទ្ធាចារ្យ ចំពោះ កម្ពុជា និង ប្រជាពលរដ្ឋ ខ្មែរ ទាំងមូល ផងដែរ ៕
សម្តេច ក្រឡាហោម ស ខេង នឹង ដឹកនាំ រដ្ឋមន្រ្តី ៣រូប បំពេញ ទស្សនកិច្ច នៅ អាល្លឺម៉ង់ ចុង ខែ ក្រោយ នេះ ដើម្បី ផ្លាស់ប្តូរ បទពិសោធន៍ លើ ការផ្ទេរ អំណាច ទៅ ថ្នាក់ ក្រោម ជាតិ
( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ នឹង ដឹកនាំ គណៈប្រតិភូ អន្តរ ក្រសួង ក្នុង នោះ មាន រដ្ឋមន្រ្តី ៣រូប ផ្សេង ទៀត ទៅ បំពេញ ទស្សនកិច្ច នៅ សហព័ន្ធ អាល្លឺម៉ង់ នា ចុង ខែកញ្ញា ខាងមុខ នេះ ដើម្បី ស្វែងយល់ និង ផ្លាស់ប្តូរ បទពិសោធន៍ ពាក់ព័ន្ធ នឹង ការផ្ទេរ អំណាច ទៅ ថ្នាក់ ក្រោម ជាតិ ។
រដ្ឋមន្រ្តី ៣រូប ដែល ចូលរួម ដំណើរទស្សនកិច្ច នេះ រួម មាន លោក ហង់ ជួនណារ៉ុន រដ្ឋមន្ត្រី ក្រសួ ង បរិស្ថាន លោក សាយ សំអាល់ និង លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ។ ក្រៅពី នោះ មាន មន្រ្តី ជាន់ ខ្ពស់ មួយចំនួន ទៀត ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ គោលបំណង សំខាន់ នៃ ដំណើរទស្សនកិច្ច របស់ គណៈប្រតិភូ អន្តរ ក្រសួង កម្ពុជា ទៅ សហព័ន្ធ អាល្លឺម៉ង់ នេះ គឺ ដើម្បី ផ្លាស់ប្តូរ បទពិសោធន៍ ពាក់ព័ន្ធ នឹង ការធ្វើ កំណែទម្រង់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា កំពុង ខិតខំ អនុវត្ត នា ពេល បច្ចុប្បន្ន នោះ គឺ កំណែទម្រង់ វិមជ្ឈិកា និង វិសហមជ្ឈិកា ។
ក្នុង ដំណើរទស្សនកិច្ច នេះ គណៈប្រតិភូ ជាន់ ខ្ពស់ កម្ពុជា ក៏ ជួប នឹង ពិភាក្សា ការងារ មន្រ្តី ជាន់ ខ្ពស់ មួយចំនួន របស់ សហព័ន្ធ អាល្លឺម៉ង់ ជួប សមាជិក សភា មួយចំនួន ដែល ពាក់ព័ន្ធ នឹង ការងារ វិមជ្ឈិកា វិសហមជ្ឈិកា ជួប អភិបាល រដ្ឋ អភិបាល ក្រុង មួយចំនួន ដើម្បី ស្វែងយល់ ជាក់ស្តែង អំពី ការអនុវត្ត របស់ ពួកគាត់ សម្រាប់ ដកស្រង់ អ្វី ដែល ល្អ មក អនុវត្ត ឱ្យ ការងារ វិមជ្ឈិកា វិសហមជ្ឈិកា នៅក្នុង ប្រទេស កម្ពុជា ប្រកបដោយ ប្រសិទ្ធភាព ។
ក្រៅពី នោះ ក៏ មាន ដំណើរទស្សនកិច្ច ទៅកាន់ ទីតាំង មួយចំនួន ដើម្បី ស្វែងយល់ ជាក់ស្តែង អំពី ការងារ គ្រប់គ្រង វិស័យ សុខាភិបាល វិស័យ អប់រំ បណ្តុះបណ្តាល វិជ្ជាជីវៈ វិស័យ ធនធាន ធម្មជាតិ ការគ្រប់គ្រង ព្រៃឈើ ការគ្រប់គ្រង បរិស្ថាន តាម តំបន់ នីមួយ ៗ ដែល កំពុង អនុវត្ត នៅ អាល្លឺម៉ង់ ផងដែរ ៕
ស្លាប់ ប្រពន្ធ ឯ ប្តី របួស ធ្ងន់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ រវាង រថយន្ត បើក ដោយ ជនជាតិ ចិន និង ម៉ូតូ នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ ប្រពន្ធ បាន ស្លាប់ នៅនឹង កន្លែង កើត ហេតុ រីឯ បុរស ជា ប្តី រងរបួស ធ្ងន់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ មួយ កើតឡើង រវាង រថយន្ត និង ម៉ូតូ លើ ផ្លូវ ជាតិ លេខ ០៤ នៅ ភូមិ អូរ តា សេក ឃុំ អូរ ឧកញ៉ា ហេង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ នៅ រសៀល ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ ។
មន្ត្រី មូលដ្ឋាន រូប នោះ បាន បញ្ជាក់ ទៀត ថា អ្នកបើកបរ ម៉ូតូ ឈ្មោះ ហេម ហ៊ាន អាយុ ៥០ ឆ្នាំ ត្រូវ ជា ប្តី ( របួស ធ្ងន់ ) និង អ្នក រួម ដំណើរ ឈ្មោះ ឆែម ខុម អាយុ ៤៩ ឆ្នាំ ជា ប្រពន្ធ បាន ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុតែម្តង ។ អ្នក ទាំង ពីរ មាន ទីលំនៅ ភូមិ ស្មាច់ ដែង ឃុំ រាម ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
ចំណែក សាកសព ជនរងគ្រោះ សមត្ថកិច្ច បាន ប្រគល់ឲ្យ គ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ឯ ជនរងគ្រោះ បាន បញ្ជូន មក សង្រ្គោះ នៅ គ្លីនិក ឯកជន ខណៈ វត្ថុតាង រថយន្ត និង ម៉ូតូ រួម ជាមួយ អ្នកបើកបរ រថយន្ត និង អ្នក រួម ដំណើរ លើ រថយន្ត នាំ ខ្លួន យកមក រក្សាទុក និង សួរនាំ នៅ អធិការដ្ឋាន នគរបាល ស្រុក ព្រៃនប់ បណ្តោះអាសន្ន ។
អធិការ រង ស្រុក ព្រៃនប់ ទទួល ផែន ចរាចរណ៍ បាន ប្រាប់ Fresh News នៅ ល្ងាច ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ ថា កម្លាំង ជំនាញ របស់ លោក កំពុង កសាង សំណុំរឿង បញ្ជូន អ្នកបើកបរ រថយន្ត និង អ្នក រួម ដំណើរ ជាមួយ វត្ថុតាង ទៅកាន់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ដើម្បី ដោះស្រាយ បន្ត ៕
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៧ ខែសីហា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៦៩១ គ្រឿង និង ផាក ពិន័យ ៣០៧ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង៣.៥៥៤ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៦៩១ គ្រឿង ( ម៉ូតូ ៦៣ %) អប់រំ៣៨៤ គ្រឿង និង ផាក ពិន័យ ៣០៧ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ១៧ ខែសីហា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១. ៨០២ គ្រឿង . អប់រំ២៥៨ គ្រឿង និង ផាក ពិន័យ ៣០៧ គ្រឿង ។
ក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ទាំងអស់ លោកស្រី អគ្គ លេខាធិការ រង ទី១ បាន ពាំនាំ នូវ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ផ្ដាំផ្ញើ សួរសុខទុក្ខ ក្តី នឹករលឹក អាណិត ស្រឡាញ់ យ៉ាង ជ្រាលជ្រៅ និង ការគិតគូរ ជានិច្ច ចំពោះ សុខ ទុក្ខ ជាពិសេស ក្តី សោមនស្ស រីករាយ ជាមួយ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល រស់ នៅ តំបន់ ធ្លាប់ ជា សមរភូមិ ប្រយុទ្ធ ប្រែក្លាយជា មាន សន្តិភាព ស្ថិរភាព និង អភិវឌ្ឍ ដូច សព្វ ថ្ងៃ នេះ ។
ទន្ទឹមនឹង នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល មាន ខ្លឹមសារ ដូច ខាងក្រោម ៖
* សូម ថែទាំ សុខភាព ឱ្យ បាន ល្អ ដេីម្បី កាត់បន្ថយ ការចំណាយ ក្នុង គ្រួសារ ដោយ ត្រូវ រស់ នៅ មាន អនាម័យ ពិសា ទឹក ដាំ ឆ្អិន និង បរិភោគ អាហារូបត្ថម្ភ ឱ្យ បាន ត្រឹមត្រូវ ជៀសវាង ជំងឺ លេីស ឈាម ជំងឺ បេះដូង ឈឺ សន្លាក់ ឬ ទឹកនោម ផ្អែម ។ល ។
* សូម សម្អាត បរិស្ថាន ជុំវិញ ផ្ទះ លុបបំបាត់ ជម្រក សត្វ មូស គេង ក្នុង មុង ជានិច្ច ជៀសវាង ជំងឺ គ្រុន ឈាម - គ្រុនចាញ់ ហេីយ ប្រសិនបេី ក្តៅ ខ្លួន ឬ ចេញ រោគសញ្ញា ណាមួយ ត្រូវ ប្រញាប់ ទៅ មន្ទីរពេទ្យ ដេីម្បី ព្យាបាល ជាបន្ទាន់ ជៀសវាង បណ្តែត បណ្តោយ ពេលវេលា ធ្វេី ឱ្យ ប៉ះពាល់ ដល់ អាយុជីវិត ។
* សូម ស្ត្រី មាន ផ្ទៃពោះ អញ្ជេីញ ទៅ ពិនិត្យ ផ្ទៃពោះ ឱ្យ បាន ទៀងទាត់ អនុវត្ត តាម ការណែនាំ របស់ គ្រូពេទ្យ និង ទៅ សម្រាល កូន នៅ មណ្ឌល សុខភាព ដែល នៅជិត បំផុត ។ - សូម ស្ត្រី មាន ផ្ទៃពោះ ដែល មាន ផ្ទុក មេរោគ អេដស៍ ត្រូវ ទៅ ពិនិត្យ សុខភាព និង ពិគ្រោះ ជាមួយ គ្រូពេទ្យ ដេីម្បី បង្ការ ការឆ្លង មេរោគ ពី ម្តាយ ទៅ កូន ។
* សូម ចូលរួមចំណែក ទាំងអស់ គ្នា លុបបំបាត់ គ្រឿងញៀន គ្រឿងស្រវឹង និង ល្បែងស៊ីសង គ្រប់ ប្រភេទ ដេីម្បី លេីក កម្ពស់ គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ។
* សូម ប្រជាពលរដ្ឋ គិតគូរ ពី សុវត្ថិភាព ចរាចរណ៍ ដែល ជា បញ្ហា ប្រឈម បង្កឱ្យ មាន ការស្លាប់ និង ពិការភាព ជារៀងរាល់ ថ្ងៃ ។
សូម បញ្ជាក់ ថា អំណោយ ដែល បាន ចែកជូន គ្រួសារ នីមួយ ៗ រួម មាន ៖ អង្ករ ៣០ គីឡូក្រាម មី១ កេស ត្រីខ ១០កំប៉ុង ឃីត១ ( មុង ភួយ សារុង ក្រមា អាវយឺត ) និង ថវិកា ថ្លៃ ធ្វេី ដំណេីរ ចំនួន ១ម៉ឺន រៀល ៕ អ្នកជំនាញ ខាង អាហារ កម្ពុជា៖ ដើម្បី កែច្នៃ អាហារ ឱ្យ មាន គុណភាព ខ្ពស់ ចាំបាច់ ត្រូវតែ ដឹង ពី សារធាតុ ចិញ្ចឹម នៅក្នុង វត្ថុធាតុ ដើម ជាមុន សិន
( ភ្នំពេញ ) ៖ លោក ជ្រុន រិទ្ធី ប្រធានបច្ចេកទេស និង ធនធាន មនុស្ស នៃ សមាគម បច្ចេកវិទ្យា និង វិទ្យាសាស្ត្រ អាហារ កម្ពុជា បាន ថ្លែង ថា ដើម្បី ធ្វើ ការកែច្នៃ អាហារ មួយ ឱ្យ មាន គុណភាព ខ្ពស់ យើង ចាំបាច់ ណាស់ ត្រូវតែ ដឹង ពី សារធាតុ នៅក្នុង ផលិតផល ដែល ត្រូវ កែច្នៃ នោះ ជាមុន សិន ព្រោះ ការកែច្នៃ អាហារ ត្រូវ ធ្វើ យ៉ាងណា ឱ្យ មាន សារធាតុ ចិញ្ចឹម គ្រប់គ្រាន់ មាន សុវត្ថិភាព និង មាន ប្រយោជន៍ ចំពោះ អ្នក បរិភោគ ។
លោក ជ្រុន រិទ្ធី បាន លើកឡើង យ៉ាង ដូចនេះ នា រសៀល ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា វាគ្មិន ក្នុង វេទិកា ផ្គូផ្គង អាជីវកម្ម សម្រាប់ សហគ្រាស កែច្នៃ ចំណីអាហារ និង ផលិតផល កសិកម្ម ឆ្នាំ ២០១៩ នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ កោះ ពេជ្រ អគារ A ។ វេទិកា នេះ ក៏ មាន ការចូលរួម ពី លោក បណ្ឌិត ផេង វុត្ថា នាយក រង សាលា កសិកម្ម ព្រែក លៀប . បណ្ឌិត ស្រេង ណាវីន ប្រធាន មន្ទីរពិសោធន៍ បរិស្ថាន និង សុវត្ថិភាព ចំណីអាហារ រូម ទាំង វា គ្មិន និង អ្នកចូលរួម ជាច្រើន ទៀត ផងដែរ ។
លោក បាន បន្ថែម ថា បើសិនជា យើង ធ្វើ ការកែច្នៃ ដោយ មិន បាន ដឹង ពី របៀប ក្នុង កែរ ច្នៃ ច្បាស់លាស់ នោះ ទេ គឺ វា នឹង ធ្វើ បាត់បង់ នូវ សារធាតុ ចិញ្ចឹម និង វីតាមីន ផ្សេង ៗ ដោយ មិន បាន ផ្តល់ ដល់ អ្នក បរិភោគ អាហារ ដែល យើង ធ្វើ ការកែច្នៃ នោះ ទេ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ចេញ ប្រកាស ព័ត៌មាន ច្រានចោល ការផ្សាយ របស់ VOA ករណី ចាប់ និង បញ្ជូន ជនជាតិ ចិន ត្រឡប់ ទៅកាន់ ប្រទេស ចិន វិញ
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន មួយ ដោយ ច្រានចោល ការផ្សព្វផ្សាយ របស់ វិទ្យុសម្លេង សហរដ្ឋ អាមេរិក (VOA) ពាក់ព័ន្ធ ការចាប់ បញ្ជូន ជនជាតិ ចិន ដែល ជាប់ពាក់ព័ន្ធ នឹង ការប្រព្រឹត្ត បទល្មើស ទៅ ប្រទេស ចិន វិញ ។ នេះ បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃ នេះ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន បញ្ជាក់ ជូន ជូន សាធារណជនជាតិ - អន្តរជាតិ ឲ្យបាន ជ្រាប ដូចត ទៅ៖
* ទី១៖ ការចាប់ខ្លួន ជនជាតិ ចិន ដែល ជាប់ពាក់ព័ន្ធ នឹង ការប្រព្រឹត្ត បទល្មើស និង ការបណ្តេញ ជនជាតិ ចិន ទាំង នេះ ចេញ ពី ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវបាន ធ្វើឡើង ផ្អែក តាម ស្មារតី នៃ អនុស្សារណៈ រវាង ក្រសួង មហាផ្ទៃ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ក្រសួង សន្តិសុខ សាធារណៈ នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន និង ស្រប តាម ច្បាប់ ស្តីពី អន្តោប្រវេសន៍ របស់ ព្រះរាជាណាចក្រ កម្ពុជា ។
* ទី២៖ ជនល្មើស ដែល ត្រូវបាន ចាប់ខ្លួន និង បញ្ជូន ចេញ ពី ព្រះរាជាណាចក្រ កម្ពុជា គឺជា ជន ដែល មាន ដីកា ស្វែងរក ចាប់ខ្លួន ពី អាជ្ញាធរ មាន សមត្ថកិច្ច នៃ ប្រទេស ចិន ដែល នឹង ត្រូវ យក ទៅ អនុវត្ត នីតិវិធី បន្ត តាម ផ្លូវ ច្បាប់ ដើម្បី ស្វែងរក យុត្តិធម៌ ជូន ជនរងគ្រោះ នៅ ប្រទេស ចិន ពោលគឺ មិន ដោះលែង ឲ្យ រួច ខ្លួន នោះ ទេ ។
* ទី៣៖ ជនល្មើស បរទេស ទាំងឡាយ ដែល ត្រូវបាន ចាប់ខ្លួន និង បណ្តេញ ចេញ ពី ព្រះរាជាណាចក្រ កម្ពុជា ស្រប តាម ច្បាប់ ស្តីពី អន្តោប្រវេសន៍ នឹង ត្រូវ ដាក់បញ្ចូល ឈ្មោះ ក្នុង បញ្ជីខ្មៅ (Black List) នៃ ប្រព័ន្ធ គ្រប់គ្រង អន្តោប្រវេសន៍ ហើយ មិន ត្រូវបាន អនុញ្ញាតឲ្យ ធ្វើដំណើរ ចូលមក កម្ពុជា ជាថ្មី ទៀត ឡើយ ។
* ទី៤៖ កន្លងមក អាជ្ញាធរ មាន សមត្ថកិច្ច កម្ពុជា ធ្លាប់ បាន ចាប់ បញ្ជូន ខ្លួន ជន បរទេស ផ្សេង ទៀត ដែល ពាក់ព័ន្ធ នឹង ការប្រព្រឹត្ត បទល្មើស នៅក្នុង ប្រទេស របស់ ខ្លួន ឲ្យ ទៅ ប្រទេស ខ្លួន វិញ ផងដែរ ស្រប តាម ស្មារតី នៃ អនុស្សារណៈ រវាង ប្រទេស ទាំង ពីរ ។ ចាប់ពី ឆ្នាំ ២០១៤ ដល់ ខែកក្កដា ឆ្នាំ ២០១៩ អាជ្ញាធរ មាន សមត្ថកិច្ច កម្ពុជា បាន បណ្តេញ ចេញ ជនជាតិ ចិន ប្រមាណ ជាង ២. ៧០០នាក់ ដែល ចំនួន នេះ អាច ជា អម្រែក ដ៏ ធ្ងន់ មួយ នៃ ថវិកា ជាតិ ប្រសិនបើ ជន ទាំង នេះ ត្រូវបាន ឃុំឃាំង នៅ ប្រទេស កម្ពុជា ។
* ទី៥៖ រាល់ ការចុះ ប្រតិបត្តិការ បង្ក្រាប បទល្មើស និង ចាប់ខ្លួន ជនល្មើស ទោះបីជា ជនល្មើស នោះ ជា ពលរដ្ឋ ខ្មែរ ឬ ជា ជន បរទេស ក្តី អាជ្ញាធរ មាន សមត្ថកិច្ច នៃ ព្រះរាជាណាចក្រ កម្ពុជា តែងតែ ធ្វើ ការស៊ើបអង្កេត ស្រាវជ្រាវ ប្រមូល ភស្តុតាង ឲ្យបាន គ្រប់ តាម ផ្លូវ ច្បាប់ ជាមុន ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ សូម ធ្វើ ការបដិសេធ ទាំងស្រុង ចំពោះ ការលើកឡើង របស់ អ្នកវិភាគ មួយចំនួន ចំពោះ បញ្ហា នេះ ដែល បាន លើកឡើង ដោយ ខ្វះ មូលដ្ឋាន ព័ត៌មាន និង មូលដ្ឋាន ផ្លូវ ច្បាប់ ច្បាស់លាស់ ដែល អាច បណ្តាលឲ្យ សាធារណមតិ ជាតិ - អន្តរជាតិ មាន ការភ័ន្តច្រឡំ ចំពោះ វិធានការ និង ដំណើរការ នីតិវិធី របស់ អាជ្ញាធរ មាន សមត្ថកិច្ច នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ សូម បញ្ជាក់ ថា ក្រសួង មហាផ្ទៃ នឹង បន្ត កិច្ចសហការ ជិតស្និទ្ធ ជាមួយ ភាគី ពាក់ព័ន្ធ ដើម្បី ធានា រក្សា នូវ សន្តិសុខ សុវត្ថិភាព សង្គម និង សណ្តាប់ធ្នាប់ សាធារណៈ ជូន ប្រជាពលរដ្ឋ គ្រប់ រូប ៕
