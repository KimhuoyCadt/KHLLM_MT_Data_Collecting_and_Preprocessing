( កំពង់ចាម ) ៖ លោក ហ៊ុន ម៉ានិត នាយក រង ខុទ្ទកាល័យ សម្ដេច ហ៊ុន សែន អម ដោយ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ បាន អញ្ជើញ បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ ក្រាល កៅស៊ូ១ ខ្សែ មាន ប្រវែង ៩០០០ ម៉ែត្រ ចាប់ពី ភូមិ តា អុង ឆ្ពោះទៅ ភូមិ សំព័រ ក្នុង ឃុំ តា អុង ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម ។
លោក អ៊ុន ចាន់ ដា ថ្លែង ថា ដើម្បី សម្រួល ក្នុង ការធ្វើចរាចរណ៍ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា បង្ក ភាពងាយស្រួល ឲ្យបាន ដឹកជញ្ជូន កសិផល និង ទំនិញ ផ្សេង ៗ ដើម្បី រក ចំណូល បង្កើន ជីវភាព នៅក្នុង គ្រួសារ ឲ្យ មាន ការរីកចម្រើន ថែម មួយ កម្រិត ទៀត ទើប រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ បាន យកចិត្តទុកដាក់ អភិវឌ្ឍ ផ្លូវថ្នល់ ស្ទើរ គ្រប់ ទិសទី ពី តំបន់ ប្រជុំជន រហូតដល់ ទី ជនបទ ។
តាម លោក អភិបាល ខេត្ត ផ្លូវ ក្រាល កៅស៊ូ មួយ ខ្សែ ប្រវែង ៩គីឡូម៉ែត្រ ដែល កំពុង ចាប់ផ្ដើម ស្ថាបនា នេះ គឺជា សមិទ្ធផល ថ្មី មួយ ទៀត ដើម្បី ទុក ជូន ប្រជាពលរដ្ឋ ប្រើប្រាស់ ក្នុង ពេល ខាងមុខ នេះ ។ លោក ថា សមិទ្ធផល នេះ គឺជា ទ្រព្យសម្បត្តិ របស់ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ហេតុ ដូច្នេះ សូម ប្រជាពលរដ្ឋ ប្រើប្រាស់ ជួយ ថែរក្សា ឲ្យ ផ្លូវ មួយ ខ្សែ នេះ ស្ថិតស្ថេរ គង់វង្ស បាន យូរអង្វែង ផងដែរ ។
លោក ហ៊ុន ម៉ានិត បាន ថ្លែង ដែរ ថា នា ពេល កន្លងទៅ បើ តាម របាយការណ៍ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ផ្លូវថ្នល់ នៅក្នុង ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម គឺ ទទួលបាន ច្រើន ជាង តាម បណ្ដា ខេត្ត ផ្សេង ៗ ។ លោក ថា នៅក្នុង ឆ្នាំ ២០១៨ ក្នុង ស្រុក ចំការលើ គឺ ទទួលបាន ការស្ថាបនា ផ្លូវ ប្រមាណ ជា ប្រវែង ៥០ គីឡូម៉ែត្រ ។ ប្រវែង ផ្លូវ នេះ ផងដែរ លោក បាន ចាត់ ឱ្យ អភិបាល ស្រុក ចំការលើ ធ្វើ ការបែងចែក ទៅដល់ ភូមិ ដែល មាន អាទិភាព ទទួលបាន ផ្លូវ សម្រាប់ ប្រើប្រាស់ ។
លោក ហ៊ុន ម៉ានិត បាន បញ្ជាក់ ផងដែរ ថា សមិទ្ធផល ដែល ប្រជាពលរដ្ឋ ទទួលបាន ជារៀងរាល់ ឆ្នាំ នេះ គឺ ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថេរភាព ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ដូច្នេះ សូម ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា មេត្តា ចូលរួម ដើម្បី ថែរក្សា សុខ សន្តិភាព ឲ្យបាន គង់វង្ស ។
ជាមួយគ្នា នេះ លោក អ៊ុន ចាន់ ដា បន្ទាប់ ចូលរួម បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ នៅ ស្រុក ចំការលើ លោក បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យមើល ការបូម ខ្សាច់ ទប់ស្កាត់ ការបាក់ ច្រាំង ទន្លេ នៅក្នុង ឃុំ ពាម កោះ ស្នា ស្រុក ស្ទឹងត្រង់ ផងដែរ ៕
( បង់ក្លាដែស ) ៖ ថ្ងៃអាទិត្យ នេះ ជនជាតិ រ៉ូហ៊ីងយ៉ា ប្រមាណ ២០០.០០០ នាក់ បាន ប្រមូលផ្តុំ គ្នា ទាំង កណ្តាល កម្តៅ ថ្ងៃ នៅឯ ជំរំភៀសខ្លួន ក្នុង ប្រទេស បង់ក្លាដែស ដើម្បី រំលឹក ខួប ពីរ ឆ្នាំ គិត ចាប់តាំងតែពី ពួកគេ បាន រត់គេចខ្លួន ពី ការបង្រ្កាប យ៉ាង ហិង្សា ដោយ យោធា របស់ ប្រទេស មីយ៉ាន់ម៉ា នៅ រដ្ឋ Rakhine ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន CNA នៅ រសៀល ថ្ងៃអាទិត្យ ទី២៥ ខែសីហា ឆ្នាំ ២០១៩ ។
ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៧ គឺជា ថ្ងៃ ដែល ក្រុម សកម្ម ប្រយុទ្ធ រ៉ូហ៊ីងយ៉ា បាន ធ្វើ សកម្មភាព វាយប្រហារ ទៅ លើ ប៉ុស្តិ៍ យាម កាម របស់ ប៉ូលិស មីយ៉ាន់ម៉ា ជាច្រើន កន្លែង នៅ រដ្ឋ Rakhine ជាប់ នឹង ប្រទេស បង់ក្លាដែស ដែល បណ្តាលឲ្យ កម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា ១២នាក់ បាត់បង់ជីវិត ។
ចាប់តាំងពី ពេល នោះ មក យោធា មីយ៉ាន់ម៉ា ក៏ បាន ដឹកនាំ យុទ្ធនាការ ឆ្លើយតប ទៅវិញ ។ បើ ទោះបីជា កងទ័ព មីយ៉ាន់ម៉ា អះអាង ថា ខ្លួន មាន គោលដៅ តែ ទៅ លើ ក្រុម សកម្ម ប្រយុទ្ធ រ៉ូហ៊ីងយ៉ា ក៏ដោយ ក្តី ប្រជាជន រ៉ូហ៊ីងយ៉ា បាន បញ្ជាក់ ថា យោធា និង ក្រុម ប្រជាពលរដ្ឋ ដែល ជា ពុទ្ធ សាសនិក នៅ រដ្ឋ Rakhine បាន ធ្វើ សកម្មភាព បង្រ្កាប យ៉ាង ហិង្សា ទៅ លើ ជនជាតិ មូស្លីម រ៉ូហ៊ីងយ៉ា ជា រួម តែម្តង ។
គួរ ជម្រាប ថា តាំងតែពី ថ្ងៃ នោះ មក ជនជាតិ រ៉ូហ៊ីងយ៉ា សរុប ប្រហែល៧៤០ .០០០ នាក់ បាន នាំគ្នា ចាកចេញ ពី រដ្ឋ Rakhine ហើយ មក ចូលរួម ជាមួយ ជនភៀសខ្លួន រ៉ូហ៊ីងយ៉ាង ប្រមាណ ២០០.០០០ នាក់ ដែល បាន រត់គេចខ្លួន មុន ពេល នោះ ទៅ ទៀត នៅ តាម តំបន់ ជំរំភៀសខ្លួន ដែល ស្ថិត នៅ ភាគ អាគ្នេយ៍ ប្រទេស បង់ក្លាដែស ។
ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ លោក ជា ម ច័ន្ទ សោភ័ណ និង ភរិយា ព្រមទាំង សហការី បាន ចុះ ពិនិត្យ ដល់ ផ្ទះ ក្មេង ៗ តែ ម្តង នៅ ភូមិ ជើងឡង សង្កាត់ សួង ក្រុង សួង និង បាន នាំយក គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា មួយ ចំនួន ផ្ដល់ជូន គ្រួសារ ពួកគេ ។
លោក ជា ម ច័ន្ទ សោភ័ណ និង ភរិយា បាន ធានារ៉ាប់រង លើ ការចំណាយ ចាយវាយ ឲ្យ ក្មេង ៗ ចូលរៀន វិញ ព្រមទាំង ឧបត្ថម្ភ អង្ករ ៥០ គីឡូក្រាម ក្នុង ១ខែ ដល់ គ្រួសារ ក្មេង ៗ យក ម្តាយ ក្មេង ៗ ដែល ឈឺ រាំ រ៉ៃ និង ជីដូន ទៅ ព្យាបាល ទិញ រទេះ រុញ ០១ គ្រឿង ជូន ដល់ ជីដូន ដើរ មិន រួច ។
ជាមួយគ្នា នេះ លោក អភិបាល និង ភរិយា បាន សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ នៅ ទីនោះ ដោយ ផ្តល់ ថវិកា ដល់ ពួកគាត់ ពោរពេញ ដោយ ស្នាមញញឹម និង បេះដូង មនុស្សធម៌ ដ៏ សែន កក់ក្តៅ ។
ក្រុមគ្រួសារ ក្មេង ៗ ទាំងអស់ នេះ មាន ស្រុក កំណើត នៅ អ្នកលឿង ខេត្ត ព្រៃវែង តែ បាន ផ្លាស់ លំនៅ មក រស់ នៅ ក្រុង សួង ខេត្ត ត្បូងឃ្មុំ ៕
ពិធី នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ នៅ ពហុកីឡដ្ឋាន អូឡាំពិក រាជធានី ភ្នំពេញ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ អតីត សិស្ស គុន ដែល បាន ហ្វឹកហ្វឺន នៅក្នុង សាលា គុន ដោយ ភាពស្និត សាល នឹង ដឹង គុណ ចំពោះ លោកគ្រូ ដែល បាន ខិតខំ បង្ហាត់ បង្រៀន នូវ ក្បាច់គុន ដល់ កូនសិស្ស កន្លងមក ហើយ នៅក្នុង ពិធី ជួបជុំគ្នា នេះ ដែរ លោក ក៏ បាន បង្ហាញ ក្បាច់គុន មួយចំនួន ដល់ អតីត កូនសិស្ស គុន ឱ្យ កាន់តែ ជ្រាប ច្បាប់ បន្ថែម ពី ក្បាច់គុន ដែល ហ្វឹកហាត់ កន្លងមក ដែរ ។
នៅក្នុង ឱកាស នោះ ដែរ លោកគ្រូ គុន លាង សុវណ្ណ បាន ឱ្យដឹង ថា អាជីព ជា គ្រូបង្ហាត់ ក្បាច់គុន ការ៉ាតេនេះ លោកគ្រូ បាន ចាប់ផ្តើម តាំងពី ឆ្នាំ ១៩៧០ ដល់ ឆ្នាំ ១៩៧៥ ក្រោយ ថ្ងៃ រំដោះ ឆ្នាំ ១៩៧៩ ហើយ នៅ ឆ្នាំ ១៩៨២ លោកគ្រូ បាន បង្កើត សាលា គុន ការ៉ាតេ មុន គេ បង្អស់ នៅក្នុង រាជធានី ភ្នំពេញ ហើយ រហូតដល់ ពេលនេះ សាលា នេះ មាន ឈ្មោះ ថា « ការ៉ាតេហ្សិន សេរី យូ និង ថៃ ដូ» ការហាត់ គុន មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ សុខភាព ព្រមទាំង ជា ជំនាញ មួយ ដែល អាច ជួយ ការពារ ខ្លួន លើ ការប៉ន ប៉ង ធ្វើបាប ពី ចំណាក់ សត្រូវ ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ លោកគ្រូ គុន លាង សុវណ្ណ បាន អំពាវនាវ ដល់ យុវជន ខ្មែរ គ្រប់ រូប ឆ្លៀត ពេល ទំនេរ ពី ការសិក្សា និង ការងារ សូម ចូលរួម ហាត់ ក្បាច់គុន និង កីឡា នានា ទាំងអស់ ដើម្បី ធ្វើឱ្យ សុខភាព មាំមួន ចៀស ឱ្យ ឆ្ងាយ ពី អំពើ អបាយ មុខ ផ្សេង ៗ ជាពិសេស ត្រូវ ចៀស ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន ដែល ធ្វើឱ្យ បាត់បង់ អនាគត កិត្តិយស គ្រួសារ និង សង្គមជាតិ ទាំងមូល ផងដែរ ។
ក្បាច់គុន ការ៉ាតេ គឺជា សិល្បៈ របស់ ជប៉ុន ដែល មាន ដើមកំណើត នៅ កោះ អូគីណា វ៉ា ដែល ផ្តោត លើ បច្ចេកទេស សកម្មភាព ដោយ ប្រើ ដៃ និង ជើង ។ រចនាបថ ភាគ ច្រើន នៃ ក្បាច់គុន ការ៉ាតេ នេះ ក៏ រួមបញ្ចូល ផងដែរ ដូចជា សកម្មភាព មនុស្ស គាស់ កកាយ និង ធ្វើ ការងារ ធ្ងន់ ៗ ។ ដើម ឡើយ មាន សិល្បៈ ក្បាច់គុន ចិន មួយ ខណៈ ដែល កោះ អូគីណា វ៉ា ធ្លាប់ មាន ប្រវត្តិសាស្ត្រ ទាក់ទង យូរអង្វែង ជាមួយ ប្រទេស ចិន កាលពី សម័យ មុន ។
នៅ ឆ្នាំ ១៩៣០ ការ៉ាតេ បាន រីករាលដាល យ៉ាង ឆាប់រហ័ស ទៅកាន់ ប្រទេស ជប៉ុន ។ បន្ទាប់ពី សង្គ្រាម លោក លើក ទី២ ត្រូវបាន បញ្ចប់ ការ៉ាតេ បាន ក្លាយជា វប្បធម៌ សកល ដែល គ្រប់ ខ្សែភាពយន្ត ការ៉ាតេនីមួយ ៗ ត្រូវបាន ធ្វើជា ភាពយន្ត ហូលីវូដ ដែល មាន អ្នកគាំទ្រ ដ៏ អស្ចារ្យ ហើយ នៅ ឆ្នាំ ១៩៦០ ពាក្យ ការ៉េ តេ បាន ក្លាយជា ពាក្យ រួម មួយ នៅក្នុង ភាសា អង់គ្លេស និង ភាសា ច្រើន ទៀត ៕
របាយការណ៍ លម្អិត របស់ សមត្ថកិច្ច ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន បញ្ជាក់ ថា សម្រាប់ ហេតុការណ៍ គ្រោះ អគ្គិភ័យ ដែល មិន ធ្លាប់ មាន នៅក្នុង រាជធានី ភ្នំពេញ នេះ បណ្ដាលឲ្យ អគារ សិប្បកម្ម និង សម្ភារ ឧបករណ៍ ផលិត ពូក ជាច្រើន គ្រឿង ត្រូវបាន ខូចខាត ទាំងស្រុង សរុប ទឹកប្រាក់ ចំនួន ៣.៣៥០.០០០ ដុល្លារ អាមេរិក ក្នុង នោះ រួម មាន៖
ដោយឡែក សម្រាប់ ប្រតិបត្តិការ ពន្លត់ អគ្គិភ័យ នេះ សមត្ថកិច្ច បាន ប្រើប្រាស់ រថយន្ដ ពន្លត់ អគ្គិភ័យ ចំនួន ៤៥ គ្រឿង ប្រើប្រាស់ ទឹក អស់ ចំនួន ២៦១ ឡាន ស្មើនឹង ទឹក១.៤៧៦ ម៉ែត្រ គូប រួម មាន៖
សមត្ថកិច្ច បាន អះអាង ទៀត ថា ករណី អគ្គីភ័យ នេះ បណ្តាល មកពី ឆ្លង ចរន្ត អគ្គីសនី មិន មាន ការឆេះ រាលដាល ដល់ ផ្ទះ របស់ អ្នកជិតខាង និង មិន មាន អ្នកណា ម្នាក់ រងរបួស ឬ បាត់បង់ អាយុជីវិត ឡើយ ។ ប៉ុន្តែ ចំពោះ ផ្លូវ មួយចំនួន ដែល ត្រូវ ឆ្លងកាត់ មក កន្លែង កើត ហេតុ រួមទាំង ផ្ទះ របស់ ប្រជាពលរដ្ឋ ស្ថិត នៅជាប់ នឹង បរិវេណ នៃ កន្លែង កើត ហេតុ ត្រូវបាន ក្រុមការងារ មិន អនុញ្ញាតឲ្យ មាន ការឆ្លងកាត់ និង ស្នាក់ នៅ តាម ផ្ទះ ឡើយ ដើម្បី បង្ការ ករណី គ្រោះថ្នាក់ កើតឡើង ពី ការបាក់ រលំអគារ ដែល អគ្គីភ័យ ឆាបឆេះ ខាងលើ នេះ ។
នៅ ថ្ងៃ បន្ទាប់ នា ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០១៩ កម្លាំង អន្តរាគមន៍ គ្រប់ ផ្នែក ទាំងអស់ រួម ជាមួយ អាជ្ញាធរដែនដី ពាក់ព័ន្ធ នៅតែ បន្ត សហការអន្តរាគមន៍ ដោះស្រាយ បញ្ហា នៅ កន្លែង កើត ហេតុ ដដែល ដោយ រក នីតិវិធី កាយ រលំអគារ ដែល បាន ឆាបឆេះ នោះ ចេញ ដើម្បី បង្ក លក្ខណៈ ឲ្យ ប្រជាពលរដ្ឋ បាន ធ្វើដំណើរ ឆ្លងកាត់ និង ចូល ស្នាក់ នៅ តាម ផ្ទះ របស់ គាត់ វិញ ។
ជាមួយគ្នា នេះ ក៏ មាន វត្តមាន របស់ ថ្នាក់ដឹកនាំ សំខាន់ ៗ បាន ចុះ មកដល់ ទីតាំង កើត ហេតុ ដើម្បី ដឹកនាំ បញ្ជា រួម មាន៖ ទេសរដ្ឋមន្ដ្រី គន់ គីម អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ . លោក ប៉ា សុជាតិ វង្ស ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ . លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ . លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ និង ថ្នាក់ដឹកនាំ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
យ៉ាងណាមិញ រហូតមកដល់ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ អាជ្ញាធរ និង សមត្ថកិច្ច បាន និង កំពុង បន្ដ ប្រតិបត្តិការ ឈូសឆាយ សម្អាត គំនរ អគារ រោងចក្រ ដែល បាក់ រលំ ដោយសារ ភ្លើង ឆេះ ភូមិ ចំរើន ផល សង្កាត់ បឹង ទំពុន ទី១ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ដើម្បី ត្រៀម កម្ទេច អគារ កម្ពស់ ៦ជាន់ មួយ ទៀត ដែល មាន ការ ប្រេះស្រាំ យ៉ាង ខ្លាំង ដែល នៅជាប់ នោះ ៕
លោក មាស សុភា ត្រូវបាន តែងតាំង ជា ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ លោក មាស សុភា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ ត្រូវបាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា តែងតាំង ជា ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះវិហារ ។
ចំណែក លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ ត្រូវបាន អង្គ សន្និបាត បោះឆ្នោត គាំទ្រ ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះវិហារ ជំនួស លោកស្រី ចឹង ហេង ដែល ត្រូវ អង្គ សន្និបាត បោះឆ្នោត ជាប់ ជា អនុប្រធាន ប្រចាំ ការ ។
អង្គ សន្និបាត សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះវិហារ អណត្តិ ទី៥នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០១៩ ក្រោម វត្តមាន លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា តំណាង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង មាន ការអញ្ជើញ ចូលរួម ពី គណៈ កិត្តិយស សាខា គណៈកម្មាធិការ សាខា អាណត្តិ ទី៤ សមាជិក - សមាជិកា ពេញ សិទ្ធិ មន្ត្រី បច្ចេកទេស ទីស្នាក់ការ កណ្តាល ក្រុម ប្រតិបត្តិ សាខា យុវជន កាកបាទ ក្រហម កម្ពុជា និង អ្នកស្ម័គ្រចិត្ត សរុប ចំនួន ២៦១ នាក់ ។
គោលបំណង សំខាន់ នៃ អង្គ សន្និបាត នេះ គឺ៖
១៖ ពិនិត្យ និង អនុម័ត របាយការណ៍ សកម្មភាព ការងារ ក្នុង អាណត្តិ ទី៤ និង ផែនការ ទិសដៅ អាណត្តិ ទី៥ ( ២០១៩ - ២០២៥) ២៖ ពិនិត្យ និង អនុម័ត របាយការណ៍ ហិរញ្ញវត្ថុ ក្នុង អាណត្តិ ទី៤ និង ផែនការ ទិសដៅ អាណត្តិ ទី៥ ( ២០១៩ - ២០២៥) ៣៖ បោះឆ្នោត ជ្រើសរើស គណៈកម្មា ធិការ សាខា អាណត្តិ ទី៥៤៖ ប្រកាស សេចក្ដីសម្រេច តែងតាំង ប្រធាន អនុប្រធាន កិត្តិយស សាខា អាណត្តិ ទី៥ ។
ក្នុង ឱកាស នោះ លោក ប្រាក់ សុវណ្ណ បាន ធ្វើ ការប្តេជ្ញា ចិត្ត យ៉ាង មុតមាំ ដូច ខាងក្រោម៖
១៖ ពង្រឹង អភិបាលកិច្ច ល្អ ២៖ ពង្រឹង និង ពង្រីក សមត្ថភាព គៀរ គរ រក មូលនិធិ និង គ្រប់គ្រង មាន គណនេយ្យភាព និង តម្លាភាព ៣៖ ខិតខំ ពង្រឹង សមត្ថភាព គ្រប់គ្រង គ្រោះមហន្តរាយ ប្រកបដោយ ប្រសិទ្ធភាព ៤៖ ខិតខំ ពង្រឹង ពង្រីក អភិវឌ្ឍ កម្លាំង ចលករ រួម មាន យុវជន និង អ្នកស្ម័គ្រចិត្ត កាកបាទ ក្រហម ឱ្យ កាន់តែ សកម្ម ថែម ទៀត ៥៖ ខិតខំ អភិវឌ្ឍ សាខា អនុសាខា ឱ្យ នៅជា សាខា មាន ដំណើរការ ល្អ លើ គ្រប់ វិស័យ ៕ ដាច់ចរន្ត អគ្គិសនី នៅ សង្កាត់ សំរោង ខណ្ឌ ព្រែក ព្នៅ ដោយសារ រថភ្លើង បើក ទាក់ ខ្សែ បណ្តាញ តង់ស្យុង ទាប
អគ្គិសនី កម្ពុជា បាន ឲ្យដឹង ថា អតិថិជន នឹង មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ វេលា ម៉ោង ១៤៖៣០ នាទី រសៀល ។
អគ្គិសនី កម្ពុជា សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ នៅពេល បំពេញ ការងារ នៅជិត គន្លង ខ្សែ បណ្ដាញ អគ្គិសនី ពីព្រោះ អាច បណ្ដាលឲ្យ មាន ការរអាក់រអួល ក្នុង ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី និង គ្រោះថ្នាក់ ជា យថាហេតុ ៕ រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម ចុះ ពិនិត្យ ការវិនិយោគ ដាំ ដំណាំ អំពៅ របស់ ក្រុមហ៊ុន មួយ នៅ ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង លោក សុខ រស់ អភិបាល រង ខេត្ត ស្វាយរៀង រួម ជាមួយ សហការី នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ចុះ មក ពិនិត្យ វឌ្ឍនភាព នៃ ការវិនិយោគ លើ ដំណាំ អំពៅ របស់ ក្រុមហ៊ុន NKVC នៅ ភូមិ ត្រពាំង ស្គន់ ឃុំ គគី ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង និង ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ កម្មករ ប្រមាណ ១០០ នាក់ ។
នាយក ក្រុមហ៊ុន បាន ឲ្យដឹង ថា បច្ចុប្បន្ន ក្រុមហ៊ុន ដាំ បាន ៥៥០ ហិកតា លើ ផ្ទៃដី សរុប ៧៦៧ ហិកតា ដែល ជា សម្បទាន ដី សេដ្ឋកិច្ច ទទួលយកមកវិនិយោគ ពី រាជ រដ្ឋាភិបាល តាមរយៈ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នា ឆ្នាំ ២០១០ ។ ជា មធ្យម អាច ទទួលបាន ផល ពី ៨០ - ១២០តោន / ហិកតា ។ បច្ចុប្បន្ន តម្លៃ អំពៅ មាន ការធ្លាក់ចុះ បន្តិច មក ទៅ ត្រឹម ៣៥ ដុល្លារ / តោន ។
ដោយសារ តំបន់ នេះ មាន សក្តានុពល លើ ដំណាំ អំពៅ និង ដំឡូង មី លោក នាយក ក្រុមហ៊ុន ស្នើសុំ ក្រសួង កសិកម្ម ជួយ រក ដៃគូ វិនិយោគ សាងសង់ រោងចក្រ កែច្នៃ ស្ករ អំពៅ និង ដំឡូង មី ដើម្បី ស្រូបយក វត្ថុធាតុ ដើម ទាំង នេះ មក ប្រើប្រាស់ ឲ្យ អស់ លទ្ធភាព និង ជាពិសេស ជួយ បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន នេះ ។
ភ្ជាប់ ជាមួយ សមិទ្ធផល ដែល ក្រុមហ៊ុន សម្រេចបាន លោក រដ្ឋមន្ត្រី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការខិតខំ ប្រឹងប្រែង យក អស់ ស្មារតី ទទួលខុសត្រូវ ក្នុង ការវិនិយោគ លើសម្បទាន ដី សេដ្ឋកិច្ច នេះ ។
ទន្ទឹម នេះ លោក រដ្ឋមន្ត្រី ស្នើឲ្យ ក្រុមហ៊ុន គួរ បង្កើន ទុន វិនិយោគ ធ្វើ យ៉ាងណា ប្រើប្រាស់ ដី នេះ ឲ្យ អស់ លទ្ធភាព ដើម្បី បង្កើត ជា ពហុ ប្រយោជន៍ ឲ្យ អស់ សក្តានុពល និង ជាពិសេស ចូលរួម បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ យើង មាន ការងារ ទទួលបាន ប្រាក់ ចំណូល សមរម្យ ធ្វើឲ្យ កម្រិត ជីវភាពល្អ ប្រសើរ ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី ដែល បាន ដាក់ចេញ កន្លងមក ។
នៅ ព្រឹក ថ្ងៃ ដដែល នោះ លោក រដ្ឋមន្ត្រី និង អភិបាល រង ខេត្ត រួម ជាមួយ សហការី បាន បន្ត មក ស្រុក ស្វាយទាប ឃុំ ស្វាយ រំពារ ភូមិ ស្វាយ ធំ ដើម្បី ពិនិត្យ ការងារ ដាំដុះ បន្លែ សុវត្ថិភាព របស់ កសិករ នួន តុលា ដែល កំពុង ដាំ បន្លែ ស្ពៃ ក្រញាញ់ និង ស្ពៃ ចង្កឹះ ។
លោក ប្រធាន មន្ទីរ បាន ឲ្យដឹង ថា បច្ចុប្បន្ន បាន រៀបចំ ចង ក្រង ក្រុម ផលិត បន្លែ សុវត្ថិភាព បាន ៤៩ គ្រួសារ មាន ផ្ទៃដី ដាំដុះ ៨. ៥ហិកតា ហើយ កំពុងតែ រៀបចំ កម្មវិធី ដាំដុះ ទៅ តាម តម្រូវការ ទីផ្សារ និង អនុវត្ត កម្មវិធី GAP ( ការអនុវត្ត កសិកម្ម ល្អ ) ធ្វើ យ៉ាងណា បង្កើន ការជឿទុកចិត្ត ពី អតិថិជន តាម រយ : គុណភាព និង សុវត្ថិភាព នៃ ផលិតផល ។
នា ឱកាស នេះ រដ្ឋមន្ត្រី បាន ណែនាំឲ្យ កសិករ ដាំ ដំណាំ ឆ្លះ ចៀសវាង ផលិតផល ជន់ លើ ទីផ្សារ និង ជាពិសេស ការឆ្លង រាលដាល ជំងឺ ។
( ភ្នំពេញ ) ៖ បុរស ម្នាក់ បើក រថយន្ត លឿន ជ្រុល បុក របាំង ថ្ម ចែក ទ្រូងផ្លូវ លាន់ ដូច រន្ទះ បណ្ដាលឲ្យ រថយន្ត ជាប់ លើ របាំង រង ការខូចខាត យ៉ាង ដំណំ តែ សំណាង ល្អ គ្រោះថ្នាក់ ចរាចរណ៍ នេះ មិន បណ្ដាលឲ្យ មាន អ្នករបួស នោះ ទេ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ១០៖ ៥០ នាទី យប់ ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០១៩ ដែល មាន ទីតាំង ស្ថិត នៅ តាម បណ្ដោយ ផ្លូវ ម៉ៅ សេ ទុង កែង ផ្លូវ លេខ ១៩៣ ស្ថិត ក្នុង សង្កាត់ ទួល ស្វាយ ព្រៃទី១ ខណ្ឌ បឹងកេងកង រាធានី ភ្នំពេញ ។
ក្រោយពេល កើត ហេតុ សមត្ថកិច្ច មូលដ្ឋាន បាន ចុះ មកដល់ រួច ធ្វើ ការទាក់ទង ទៅ សមត្ថកិច្ច ជំនាញ ចរាចរណ៍ ដើម្បី ចុះ មក ធ្វើ ការវាស់វែង និង យក រថយន្ត ខាងលើ ទៅ រក្សាទុក នៅ ការិយាល័យ ចរាចរណ៍ ផ្លូវគោក រាជធានី ភ្នំពេញ ដើម្បី រងចាំ ដោះស្រាយ តាម ផ្លូវ ច្បាប់ នៅ ពេល ក្រោយ ៕ រថយន្ត ដឹក ដី បុក រះ ផ្ទះ ពលរដ្ឋ ៤ខ្នង បណ្តាលឲ្យ ស្លាប់ ក្មេង តូច ម្នាក់ ខណៈ ម្តាយ ក្មេង និង អ្នកបើកបរ របួស ធ្ងន់ធ្ងរ នៅ ស្រុក មណ្ឌល សីមា ខេត្ត កោះកុង (Video inside)
( កោះកុង) ៖ រថយន្ត ដឹក ដី មួយ គ្រឿង បាន បើក បុក រះ ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ៤ខ្នង បណ្តាលឲ្យ ស្លាប់ ក្មេង តូច ម្នាក់ អាយុ ប្រហែល៣ ឆ្នាំ ខណៈ ម្តាយ របស់ ក្មេង រងគ្រោះ រង និង អ្នកបើកបរ របួស ធ្ងន់ធ្ងរ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ។
ហេតុការណ៍ គ្រោះថ្នាក់ ដ៏ រន្ធត់ នេះ បាន កើត នៅ ម៉ោង ជាង ៧ព្រឹក ថ្ងៃទី ២៥ ខែសីហា នេះ ស្ថិត នៅក្នុង ភូមិ ចាំ យាម ( ភូមិ ថ្មី ) ឃុំ បាក់ ខ្លង ស្រុក មណ្ឌល ខេត្ត កោះកុង ។
សេចក្តីរាយការណ៍ បឋម ពី ភ្នាក់ងារ Fresh News បាន បញ្ជាក់ ថា រថយន្ត ដឹក ដី កង់ ដប់១ គ្រឿង នេះ បាន បើក បុក រះ បណ្តាលឲ្យ ខូចខាត ផ្ទះ ចំនួន ៤ខ្នង នៅ ជាប់ ផ្លូវ ហើយ ផ្ទះ ធ្ងន់ ជាង គេ គឺ ផ្ទះ លក់ អីវ៉ាន ចាប់ ហួយ បណ្តាលឲ្យ ក្មេង តូច ម្នាក់ អាយុ ប្រហែល៣ ឆ្នាំ ស្លាប់ ម្តាយ ក្នុង ផ្ទះ របួស ធ្ងន់ ។ ចំណែក អ្នកបើកបរ រង បួស ធ្ងន់ធ្ងរ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ។
យោង តាម ការសន្និដ្ឋាន បឋម ពី សមត្ថកិច្ច អាច បណ្តាល មកពី ដាច់ ហ្វ្រាំង រថយន្ត ដឹក ដី នោះ ៕
៤៖ ទីបំផុត សម្តេច តេជោ ហ៊ុន សែន និង លោក ឌី វិជ្ជា ដាក់ពាក្យ ប្តឹង លោក សម រង្ស៉ី ទៅកាន់ តុលាការ ទីក្រុង ប៉ារីស ប្រទេស បារាំង ( ចុច អាន )
៥៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ បង្កើត សាលាឧទ្ធរណ៍ ភ្នំពេញ និង សាលាឧទ្ធរណ៍ តំបន់ ត្បូងឃ្មុំ តំបន់ បាត់ដំបង និង តំបន់ ព្រះសីហនុ ( ចុច អាន )
៦៖ ចិន ប្រកាស គាំទ្រ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ឈប់ ផ្តល់ អាជ្ញាប័ណ្ណ ល្បែងស៊ីសង តាម ប្រព័ន្ធ អ៉ីនធើណិត ( ចុច អាន )
៧៖ ក្រុមហ៊ុន ជុង យៀន ដឹក សំណល់ ផ្លាស្ទីក ១៤កុងតឺន័រ ត្រឡប់ ទៅវិញ ហើយ នៅសល់ ៦៩ ទៀត សុំ ពន្យារ ពេល ដោយសារ បញ្ហា អាកាសធាតុ ( ចុច អាន )
៩៖ កម្ពុជា បដិសេធ សំណើ សុំ ផ្តល់ សញ្ជាតិ ដល់ ពលរដ្ឋ វៀតណាម សម្រាប់ ការរស់នៅ និង រកស៊ី នៅ តំបន់ អភិវឌ្ឍន៍ ត្រីកោណ ( ចុច អាន )
១០៖ ការប្រឡង សញ្ញាបត្រ បាក់ ឌុប ថ្ងៃទី១ បាន បញ្ចប់ ប្រកបដោយ ភាពស្ងប់ស្ងាត់ និង រលូន ល្អ ( ចុច អាន )
យល់ដឹង ផ្នែក ច្បាប់៖ យន្ដ ការដោះស្រាយ វិវាទ ដីធ្លី នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន យកចិត្ដទុកដាក់ ខ្ពស់ ក្នុង ការគោរព នូវ សិទ្ធិ មនុស្ស ជាពិសេស សិទ្ធិ ឯកជន ភាព របស់ បងប្អូន ប្រជាពលរដ្ឋ ។
ជាក់ស្ដែង នៅ អំឡុង ឆ្នាំ ១៩៩២ កម្ពុជា បាន អនុវត្ត ច្បាប់ ភូមិបាល មួយ ដែល ច្បាប់ នេះ បាន បញ្ជាក់ ពី ការទទួលបាន នូវ សិទ្ធិ កម្មសិទ្ធិ នៅលើ ដីធ្លី តាមរយៈ សន្ត តិកម្ម កិច្ចសន្យា ឬ ដោយ ការផ្លាស់ប្ដូរ ពី « ការកាន់កាប់ បណ្តោះអាសន្ន » ទៅជា « កម្មសិទ្ធិ ពេញលេញ » ជា អាទិ៍ ។
ក្រោយមក នៅ ឆ្នាំ ២០០១ ច្បាប់ ភូមិបាល បច្ចុប្បន្ន ត្រូវបាន ប្រកាស ឱ្យ ប្រើ ដែល ច្បាប់ នេះ អនុញ្ញាតឱ្យ មាន កម្មសិទ្ធិ ឯកជន លើ ដីធ្លី ពេញលេញ នៅ កម្ពុជា ព្រមទាំង បាន បង្កើត ឱ្យ មាន នូវ ប្រព័ន្ធ បញ្ជី ឈ្មោះ ដីធ្លី និង មាន ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ជូន ប្រជាពលរដ្ឋ ។
ទន្ទឹម នឹង នោះ កម្ពុជា បាន ទទួល ជំនួយ ពី ធនាគារ ពិភពលោក ក្នុង ការរៀបចំ ការចុះបញ្ជី ដីធ្លី លក្ខណៈ ជា ប្រព័ន្ធ ដើម្បី ចេញ ប័ណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ផងដែរ ។ នៅក្នុង អំឡុង ពេល ចុះបញ្ជី ដីធ្លី នេះ យើង បាន ប្រឈម នឹង បញ្ហា ចម្បង ធំ គឺ វិវាទ ដីធ្លី ដែល ទាមទារ ចាំបាច់ ឱ្យ មាន ការ ដោះស្រាយ ជាបន្ទាន់ ជូន បងប្អូន ប្រជាពលរដ្ឋ ផងដែរ ។ តើ កម្ពុជា មាន យន្ដ ការអ្វី ខ្លះ ក្នុង ការដោះស្រាយ វិវាទ ដីធ្លី ?
ដើម្បី ស្វែងយល់ ឱ្យ កាន់តែ ច្បាស់ អំពី « យន្ដ ការដោះស្រាយ វិវាទ ដីធ្លី នៅ កម្ពុជា » កម្មវិធី យល់ដឹង ផ្នែក ច្បាប់ របស់ អង្គភាព ព័ត៌មាន FRESH NEWS សហការ ជាមួយ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្ដិការ អន្ដរជាតិ សូម លើក យក ប្រធានបទ នេះ មក ធ្វើ ការបកស្រាយ ជូន បងប្អូន ប្រជាពលរដ្ឋ ដូច ខាងក្រោម ៖
១៖ ការដោះស្រាយ វិវាទ របស់ គណៈកម្មការ សុរិយោដី
គណៈកម្មការ សុរិយោដី ត្រូវបាន បង្កើតឡើង តាម អនុក្រឹត្យ លេខ ៤៧ អន ក្រ. បក ចុះ ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០០២ ដែល ក្នុង នោះ រួម មាន គណៈកម្មការ សុរិយោដី ៣ ( បី ) ថ្នាក់ គឺ គណៈកម្មការ សុរិយោដី ថ្នាក់ ក្រុង ស្រុក ខណ្ឌ គណៈកម្មការ សុរិយោដី ថ្នាក់ រាជធានី ខេត្ត និង គណៈកម្មការ សុរិយោដី ថ្នាក់ ជាតិ ។
ចំពោះ វិធាន ស្ដីពី នីតិវិធី ផ្សេង ៗ របស់ គណៈកម្មការ សុរិយោដី ត្រូវបាន កំណត់ នៅក្នុង ប្រកាស លេខ ១១២ ដនស / ប្រក ចុះ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០០២ ស្ដីពី គោលការណ៍ ណែនាំ និង នីតិវិធី របស់ គណៈកម្មការ សុរិយោដី ។
ដោយ នៅក្នុង នោះ គណៈកម្មកាសុរិយោដី មាន បេសកកម្ម ដោះស្រាយ វិវាទ ដីធ្លី ( ដី គ្មាន ប័ណ្ណ ចេញ ដោយ រដ្ឋបាល សុរិយោដី ) ដែល មិន ទាន់ ចុះបញ្ជី សុរិយោដី ដែល ស្ថិត នៅ ក្រៅ តំបន់ វិនិច្ឆ័យ ឬ ក្នុង តំបន់ វិនិច្ឆ័យ ដែល មិន អាច សម្រុះសម្រួល បាន ដោយ គណៈកម្មការ រដ្ឋបាល និង មិន មែន ជា វិវាទ ដីធ្លី ដែល ពាក់ព័ន្ធ នឹង បណ្តឹង ទាមទារ បែងចែក មរតក ឬ វិវាទ អំពី កិច្ចសន្យា ទិញ លក់ ជួល ឬ បញ្ចាំ ជាដើម ។
គណៈកម្មការ សុរិយោដី ធ្វើ ការដោះស្រាយ វិវាទ ដីធ្លី នីមួយ ៗ ដោយ ចាប់ផ្តើម ពី ថ្នាក់ ស្រុក ខណ្ឌ ឡើង ទៅ ថ្នាក់ រាជធានី ខេត្ត និង ចុងក្រោយ ទៅ គណៈកម្មការ រសុរិយោដី ថ្នាក់ ជាតិ ៖
ក / . ការដោះស្រាយ វិវាទ ដោយ គណៈកម្មការ សុរិយោដី ថ្នាក់ ស្រុក ខណ្ឌ ការទទួល ពាក្យបណ្តឹង និង ឆ្លើយតប ពាក្យបណ្តឹ ង៖ បុគ្គល គ្រប់ រូប ដែល មាន វិវាទ ពាក់ព័ន្ធ នឹង ដីធ្លី មិន ទាន់ ចុះបញ្ជី សុរិយោដី មាន សិទ្ធិ ដាក់ ពាក្យ បណ្តឹង ដោយ ផ្ទាល់ ទៅ គណៈកម្មការ សុរិយោដី ថ្នាក់ ស្រុក ខណ្ឌ ។ បន្ទាប់មក គណៈកម្មការ នឹង ជូន ដំណឹង អំពី បណ្តឹង ទៅ ភាគី ចុងបណ្តឹង ឬ បុគ្គល ដែល មាន ផលប្រយោជន៍ ពាក់ព័ន្ធ នឹង ដី វិវាទ ដើម្បី ឆ្លើយតប ក្នុង រយៈពេល ៣០ ថ្ងៃ បន្ទាប់ពី ទទួលបាន សេចក្តីជូនដំណឹង ។
ការស៊ើបអង្កេត បន្ទាប់ពី ទទួល ពាក្យបណ្តឹ ង៖ គណៈកម្មការ សុរិយោដី ថ្នាក់ ស្រុក ខណ្ឌ នឹង ចាត់ មន្ត្រី ឱ្យ ចុះ ស៊ើបអង្កេត ដើម្បី ជួប ជាមួយ គូ ភាគី វិវាទ សាក្សី អាជ្ញាធរ មូលដ្ឋាន និង ធ្វើ ការវាស់វែង កំណត់ ទំហំ ដី និង ព្រំប្រទល់ ដី វិវាទ ឱ្យ បាន ច្បាស់លាស់ ។
បន្ទាប់ពី បញ្ចប់ ការស៊ើបអង្កេត គណៈកម្មការ សុរិយោដី នឹង ពិនិត្យមើល ថា តើ ករណី វិវាទ នោះ ស្ថិត ក្នុង សមត្ថកិច្ច ដោះស្រាយ របស់ ខ្លួន ឬ ទេ ? ករណី មិន ស្ថិត ក្នុង សមត្ថកិច្ច បណ្តឹង នោះ ត្រូវបាន ច្រានចោល ហើយ ត្រូវ ជូនដំណឹង ដល់ ភាគី វិវាទ ជា លាយ ល័ក្ខណ៍ អក្សរ ។
ករណី ភាគី វិវាទ មិន ពេញចិត្ត ចំពោះ ការច្រានចោល នោះ ភាគី វិវាទ នោះ អាច ប្តឹង ទៅ គណៈកម្មការ សុរិយោដី ថ្នាក់ លើ បន្ទាប់ ក្នុង រយៈពេល ៣០ ថ្ងៃ បន្ទាប់ពី ភាគី ទទួលបាន សេចក្តីជូនដំណឹង ឬ ទម្រង់បែបបទ ច្រានចោល ពាក្យបណ្តឹង នោះ ។
អំពី កិច្ចប្រជុំ រដ្ឋបាល៖ គណៈកម្មការ សុរិយោដី ថា្នក់ ស្រុក ខណ្ឌ ត្រូវ អញ្ជើញ គូ ភាគី វិវាទ ចូលរួម ប្រជុំ រដ្ឋបាល ដើម្បី ណែនាំ អំពី ដំណើរការ និង នីតិវិធី នៃ ការដោះស្រាយ វិវាទ ។
ភាគី ត្រូវ ធ្វើ ការជ្រើសរើស អ្នកសម្រុះសម្រួល ៣ រូប និង ទទួល ព័ត៌មាន អំពី សិទ្ធិ របស់ ខ្លួន ក្នុង ការជ្រើសរើស បុគ្គល ណា ម្នាក់ ដែល ភាគី ជឿជាក់ ថា អាច ជួយ ខ្លួន បាន ក្នុង នាម ជា ជំនួយការភាគី ។ ទន្ទឹម នោះ គូ ភាគី ត្រូវ កំណត់ ពេលវេលា ទីកន្លែង ដោះស្រាយ ជាមួយនឹង អ្នសម្រុះសម្រួល ឬ គូ ភាគី អាច ជូនដំណឹង អំពី ការសុំ ជំទាស់ ពី វិវាទ ផលប្រយោជន៍ រវាង ភាគី ណាមួយ ជាមួយ គណៈកម្មការ សុរិយោដី ។
ការសម្រុះសម្រួល៖ ក្រោយពេល បញ្ចប់ ការស៊ើបអង្កេត យ៉ាងតិច ៣០ ថ្ងៃ គិត ចាប់ពី ថ្ងៃ បិទ ផ្សាយ បណ្ដឹង គណៈកម្មការ សុរិយោដី ថា្នក់ ស្រុក ខណ្ឌ ត្រូវ បើក កិច្ចប្រជុំ ដើម្បី សម្រេច លើ ដំណើរការសម្រុះសម្រួល វិវា ទ ហើយ កិច្ចប្រជុំ ត្រូវ ធ្វើឡើង នៅ ទីតាំង វិវាទ ឬ នៅ កន្លែង ដែល ជិត នឹង ទីតាំង វិវាទ នោះ ។
ការសម្រុះសម្រួល និង / ឬ ការសម្រេច របស់ គណៈកម្មការ សុរិយោដី ធ្វើឡើង ដោយ គ្មាន ការបង្ខិតបង្ខំ គ្មាន ការគំរាមកំហែង មាន ន័យ ថា ជា ការដោះស្រាយ មួយ ដោយ យក ការសម្រុះសម្រួល ជា មូលដ្ឋាន ពោលគឺ យក ឆន្ទៈ របស់ គូ ភាគី វិវាទ ដែល សុខចិត្ត ចែករំលែក ផលប្រយោជន៍ ឱ្យ គ្នា ទៅ វិញ ទៅ មក ក្រោម ការខិតខំ ប្រឹងប្រែង រក វិធី ដោះស្រាយ ពី អ្នកសម្រុះសម្រួល ។ ភាគី វិវាទ និង អ្នកជំនួយការភាគី ត្រូវ ចូលរួម ក្នុង កិច្ចប្រជុំ សម្រុះសម្រួល នេះ ហើយ ដំណើរការប្រជុំ សម្រុះសម្រួល ត្រូវ ស្ថិត ក្រោម វិធាន នៃ ការសម្រុះសម្រួល មួយ ។
ប្រសិនបើ ការដោះស្រាយ ទទួលបាន ជោគជ័យ ភាគី ទាំង ពីរ ត្រូវ ផ្តិត មេដៃ លើ ទម្រង់បែបបទបញ្ចប់ វិវាទ តាម ខ្លឹមសារ ដែល បាន ព្រមព្រៀង ។ ប្រសិនបើ ករណី វិវាទ មិន អាច ធ្វើ ការដោះស្រាយ ដោយ ការសម្រុះ សម្រួល បាន ទេ នោះ គណៈកម្មការ សុរិយោដី ថ្នាក់ ស្រុក ខណ្ឌ នឹង បញ្ជូន ករណី វិវាទ នោះ ទៅ គណៈកម្មការ សុរិយោដី ថ្នាក់ រាជធានី ខេត្ត ដើម្បី ធ្វើ ការដោះស្រាយ បន្ត ។
ការវាស់វែង ត្រៀម ចេញ ប័ណ្ណ៖ ក្រោយពេល វិវាទ ត្រូវបាន ដោះស្រាយ បញ្ចប់ ដោយ ជោគជ័យ ទាំង ការសម្រុះ សម្រួល ឬ សម្រេច គណៈកម្មការ សុរិយោដី ថ្នាក់ ស្រុក ខណ្ឌ នឹង ចុះ ធ្វើ ការវាស់វែង កំណត់ ទំហំ ដី និង ព្រំប្រទល់ តាម ការព្រមព្រៀង របស់ គូ ភាគី ឬ តាម សេចក្តីសម្រេច ចូល ជា ស្ថាពរ ។ បន្ទាប់មក មន្ទី រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង ភូមិបាល ក្រុង ស្រុក ខណ្ឌ នឹង ចាប់ផ្តើម នីតិវិធី ចុះបញ្ជី ក្បាល ដី តាម ការស្នើសុំ របស់ ភាគី វិវាទ ។
ខ / . ការដោះស្រាយ វិវាទ ដោយ គណៈកម្មការ សុរិយោដី រាជធានី ខេត្ដ បន្ទាប់ពី ទទួលបាន ការបញ្ជូន ករណី វិវាទ ពី គណៈកម្មការ សុរិយោដី ថា្នក់ ស្រុក ខណ្ឌ គណៈកម្មការ សុរិយោដី ថ្នាក់ រាជធានី ខេត្ត នឹង ព្យាយាម ធ្វើ ការសម្រុះសម្រួល បន្ត ទៀត តាម នីតិវិធី ដែល ន កំណត់ ។ ក្នុង រយៈពេល ៦០ ថ្ងៃ បន្ទាប់ពី បាន ទទួលបណ្ដឹង វិវាទ គណៈកម្មការ សុរិយោដី រាជធានី ខេត្ដ ត្រូវ រៀបចំ កិច្ចប្រជុំ រដ្ឋបាល រវាង គណៈកម្មការ សុរិយោដី ខេត្ដ ក្រុង និង ភាគី វិវាទ ។
បើ ការសម្រុះសម្រួល មិន អាច ទទួលបាន ជោគជ័យ ទេ នោះ គណៈកម្មការ សុរិយោដី ថ្នាក់ រាជធានី ខេត្ត ត្រូវ ធ្វើ នីតិវិធី ដោយឡែក ផ្សេង ទៀត គឺ ការធ្វើ សេចក្តីសម្រេច ។ បើ ភាគី ណាមួយ មិន សុខចិត្ត ចំពោះ សេចក្ដីសម្រេច របស់ គណៈកម្មការ សុរិយោដី ថ្នាក់ រាជធានី ខេត្ត ក្នុង រយៈពេល ៣០ ថ្ងៃ នៃ ថ្ងៃ ធ្វើ ការបន្ទាប់ពី ទទួលបាន សេចក្តីសម្រេច ឬ ទទួលបាន ព័ត៌មាន អំពី សេចក្តីសម្រេច ភាគី វិវាទ នោះ មាន សិទ្ធិ ប្តឹង សុំ ឱ្យ គណៈកម្មការ សុរិយោដី ថ្នាក់ ជាតិ ធ្វើ សវនាការ ជាថ្មី បាន ។
គ/ . ការដោះស្រាយ វិវាទ ដោយ គណៈកម្មការ សុរិយោដី ថ្នាក់ ជាតិ គណៈកម្មការ សុរិយោដី ថ្នាក់ ជាតិ មាន សិទ្ធិ សម្រេច លើ វិវាទ ទាំងឡាយ ណា ដែល ស្ថិត នៅ ក្រៅ តំបន់ វិនិច្ឆ័យ ហើយ ដែល មិន អាច ដោះស្រាយ បាន ដោយ គណៈកម្មការ សុរិយោដី ថា្នក់ ស្រុក ខណ្ឌ និង គណៈកម្មការ សុរិយោដី ថ្នាក់ រាជធានី ខេត្ដ និង រាល់ វិវាទ ដែល កើតមាន ក្នុង តំបន់ វិនិច្ឆ័យ ដែល មិន អាច ដោះស្រាយ បាន ដោយ គណៈកម្មការ រដ្ឋបាល ។
ក្នុង ករណី ដែល បាន ទទួល ការបញ្ជូន ករណី វិវាទ ពី គណៈកម្មការ សុរិយោដី ថ្នាក់ រាជធានី ខេត្ដ ឬ គណៈកម្មការ រដ្ឋបាល គណៈកម្មការ សុរិយោដី ថ្នាក់ ជាតិ នឹង ព្យាយាម ធ្វើ ការសម្រុះសម្រួល បន្ត តែ បើ ការសម្រុះសម្រួល មិន អាច ទទួលបាន ជោគជ័យ ទេ គណៈកម្មការ សុរិយោដី ថ្នាក់ ជាតិ នឹង បើក សវនាការ សម្រេច ។ គូ ភាគី មាន សិទ្ធិ ប្តឹង តវ៉ា នឹង សេចក្ដីសម្រេច របស់ គណៈកម្មការ សុរិយោដី ថ្នាក់ ជាតិ ទៅ តុលាការ ក្នុង រយៈពេល ៣០ ថ្ងៃ ក្រោយពី បាន ទទួល សេចក្តីសម្រេច នេះ ។
២៖ ការដោះស្រាយ វិវាទ ដោយ ស្ថាប័ន តុលាការ
តុលាការ មាន សមត្ថកិច្ច ដោះស្រាយ លើ ទំទាស់ ដីធ្លី ណា ដែល បាន ចុះបញ្ជី និង ដី ដែល បាន ផ្ដល់ ប័ណ្ណ កម្មសិទ្ធិ រួចរាល់ហើយ បើ យោង តាម ប្រកាស រួម លេខ ០៣ ចុះ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០០៣ របស់ ក្រសួង យុត្ដិធម៌ និង ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ។
សរុប ជា រួម មកវិញ ចំពោះ យន្ដ ការ សម្រាប់ ដោះស្រាយ វិវាទ ដីធ្លី នៅ កម្ពុជា មាន ពីរ ប្រភេទ គឺ យន្ដ ការដោះស្រាយ វិវាទ ដោយ គណៈកម្មការ សុរិយោដី ចំពោះ ដី ដែល មិន ទាន់ បាន ចុះបញ្ជី និង ការដោះស្រាយ ដោយ ស្ថាប័ន តុលាការ ចំពោះ ដី ដែល បាន ចុះបញ្ជី រួចរាល់ និង មាន ប័ណ្ណ កម្មសិទ្ធិ ។ ហេតុ ដូចនេះ សូម បញ្ជាក់ ថា រាល់ វិវាទ ដីធ្លី ដែល មិន ទាន់ ចុះបញ្ជី ត្រូវតែ បញ្ជូន ទៅ ដោះស្រាយ នៅ គណៈកម្មការ សុរិយោដី ជាមុន សិន មុននឹង ប្ដឹង មក តុលាការ ។
