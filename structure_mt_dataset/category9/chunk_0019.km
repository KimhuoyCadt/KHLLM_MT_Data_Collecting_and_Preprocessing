( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នៅ ថ្ងៃទី ០៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន ចុះ សម្របសម្រួល ដោះស្រាយ សំណូមពរ បញ្ហា ប្រឈម ទំនាស់ ដីធ្លី រួមទាំង ទំនាស់ ផ្សេង ៗ ទាំង ៧ករណី ដោយ បាន បញ្ចប់ ដោយ ជោគជ័យ នៅ ក្រៅ ប្រព័ន្ថ តុលាការ ដោយ គ្មាន អ្នក ចាញ់ គឺ ឈ្នះ ទាំងអស់ គ្នា ។
ការចុះ ដោះស្រាយ នេះ បាន ធ្វើឡើង នៅ សាលា ឃុំ ខ្នារ ទទឹង ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ ដោយ បាន ការចូលរួម ពី លោកស្រី ឯម ប៉ុណ្ណា តំណាងរាស្ត្រ មណ្ឌល ពោធិ៍សាត់ អភិបាល រង ខេត្ត សមាជិក ក្រុមប្រឹក្សា ខេត្ត ប្រធាន ការិយាល័យ ប្រជាពលរដ្ឋ អាជ្ញាធរ ស្រុក ក្រុមប្រឹក្សា ឃុំ មេ ប៉ុស្តិ៍ មេភូមិ និង ភាគី ដែល មាន ការពាក់ព័ន្ធ ជាច្រើន នាក់ ទៀត ។
ដោយឡែក អាជ្ញាធរ ស្រុក ឃុំ ភូមិ រួមទាំង មេ ប៉ុស្តិ៍ ត្រូវ ប្រើប្រាស់ តួនាទី ជា ឪពុក ម្តាយ ដ៏ ល្អ ចូលរួម សម្របសម្រួល ដោះស្រាយ សំណូមពរ បញ្ហា ប្រឈម ជូន ប្រជាពលរដ្ឋ ដើម្បី ជា ភាព សុខសាន្ត នៅ មូលដ្ឋាន របស់ យើង ។
សូម បញ្ជាក់ ថា ក្នុង កិច្ច ដំណោះស្រាយ ខាងលើ លោក ម៉ៅ ធ និន ក៏ បាន ចែកជូន អាហារ សម្រន់ រួម មាន មី កញ្ចប់ និង ទឹក បរិសុទ្ធ សម្រាប់ ពិសា ជួបជុំគ្នា ព្រមទាំង បាន ប្រគល់ ថវិកា អង្ករ និង សារុង ជូន ដល់ គ្រួសារ អតីត យុទ្ធជន ជន ចាស់ជរា ដែល ជា ភាគី ទំនាស់ ទៅ តាម ទម្លាប់ ផងដែរ ៕ ទេសរដ្ឋមន្ត្រី មាស សុភា៖ ខេត្ត ព្រះវិហារ គ្មាន ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក ឡើយ និង អំពាវនាវ ឱ្យ ពលរដ្ឋ បរិភោគ សាច់ ជ្រូក ធម្មតា ឡើងវិញ
( ព្រះវិហារ ) ៖ លោក មាស សុភា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ០៧ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន អំពាវនាវ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ព្រះវិហារ នាំ បរិភោគ សាច់ ជ្រូក ឡើងវិញ និង សូម កុំ មាន ការព្រួយបារម្ភ ឱ្យ សោះ ព្រោះ នៅក្នុង ខេត្ត ព្រះវិហារ មិន មាន ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក នោះ ទេ ។
នៅក្នុង ពិធី ពិសា សាច់ ជ្រូក សុវត្ថិភាព ដែល រៀបចំ ដោយ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា បាន លើកឡើង ថា មកដល់ ពេលនេះ ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក នៅក្នុង ខេត្ត ព្រះវិហារ គឺ មិន មាន ទេ ហើយ ជំងឺ នេះ គឺ កើត មាន ឡើង នៅ តាម បណ្តាល ប្រទេស មួយចំនួន ប៉ុន្តែ ប្រទេស យើង វា មិន មាន បញ្ហា ទេ ។
ជាមួយគ្នា នេះ ដែរ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ក៏ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម កុំ មាន ការខ្លាច រអា ចំពោះ ការបរិភោគ សាច់ ជ្រូក ដែល ចិញ្ចឹម នៅក្នុង ខេត្ត និង សូម អំពាវនាវ ឱ្យ កសិករ របស់ យើង បន្ត ចិញ្ចឹម ជ្រូក ឱ្យ កាន់តែ បាន ច្រើន ថែម ទៀត ដើម្បី ផ្គត់ផ្គង់ ទីផ្សារ ឱ្យ ខេត្ត របស់ យើង ផង និង អាច មាន លទ្ធភាព នាំចេញ ទៅ ខេត្ត ផ្សេង និង ចេញ ទៅ ក្រៅ ប្រទេស ផងដែរ ។
លោក ពឹង ទ្រី ដា ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង ថា ដើម្បី លើកទឹកចិត្ត ដល់ ប្រជាកសិករ ដែល ជា អ្នក ចិញ្ចឹម ជ្រូក អ្នកលក់ សាច់ ជ្រូក និង លើកទឹកចិត្ត ឱ្យ ប្រជាពលរដ្ឋ មក ទទួលទាន សាច់ ជ្រូក ឡើងវិញ នៅ ព្រឹក នេះ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត បាន សហការ ជាមួយ ក្រុមហ៊ុន CP បាន រៀបចំ ពិធី ហូប សាច់ ជ្រូក ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក ទេសរដ្ឋមន្ត្រី មាស សុភា និង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រមទាំង ថ្នាក់ដឹកនាំ ជាច្រើន រូប ទៀត ។
ប្រធាន មន្ទីរ បាន បញ្ជាក់ ទៀត ថា ការរៀបចំ ពិធី ពិសា សាច់ ជ្រូក ដែល មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ នេះ គឺ ចង់ បញ្ជាក់ ជូន បងប្អូន ប្រជាពលរដ្ឋ យើង ថា ការពិសា សាច់ ជ្រូក គឺ មិន ប៉ះពាល់ ដល់ សុខភាព យើង ទេ ហើយ ជំងឺ ប៉េស្ត ជ្រូក ក៏ មិន អាច ឆ្លង មក មនុស្ស យើង តាមរយៈ ការបរិភោក សាច់ ជ្រូក ដែរ ម្យាង វិញ ទៀត ខេត្ត របស់ យើង ក៏ មិន មាន ជំងឺ ប៉េស្ត ជ្រូក នោះ ទេ ដែល ករណី នេះ លោក សូម អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ យើង ត្រូវ ពិសា សាច់ ជ្រូក ឡើងវិញ និង កុំ មាន ការព្រួយបារម្ភ ឱ្យ សោះ ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង នៅក្នុង ឱកាស អញ្ជើញ ចូលរួម វេទិកា ធុរកិច្ច កម្ពុជា - ស្រីលង្កា
* សម្តេច តេជោ ហ៊ុន សែន សម្តែង ការស្វាគមន៍ យ៉ាង កក់ក្តៅ បំផុត ចំពោះ វត្តមាន លោក ម៉ៅ ទ្រី ប៉ាឡា ស៊ីរី សេនា ប្រធានាធិបតី ស្រីលង្កា ក្នុង ដំណើរ ទស្សនកិច្ច ផ្លូវ រដ្ឋ របស់ លោក និង គណៈប្រតិភូ ធុរ ជន និង អ្នក វិនិយោគ ស្រីលង្កា ដែល បាន អម ដំណើរ មក ធ្វើ ការសិក្សា ស្វែងយល់ ដោយ ផ្ទាល់ ពី ការរីកចម្រើន របស់ កម្ពុជា ។
* សម្តេច តេជោ បាន ថ្លែង ថា វេទិកា ធុរកិច្ច កម្ពុជា - ស្រីលង្កា ផ្តល់ ឱកាស ឱ្យ សម្តេច បាន ចែករំលែក ព័ត៌មាន អំពី ការវិវត្ត សំខាន់ ៗ នៅ កម្ពុជា ពាក់ព័ន្ធ កាលានុវត្តភាព និង សក្តានុពល ធុរកិច្ច និង វិនិយោគ ក៏ ដូចជា ការដាក់ចេញ នូវ វិធានការ ថ្មី ៗ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នា ពេល បច្ចុប្បន្ន សំដៅ ធ្វើឱ្យ កាន់តែ ប្រសើរឡើង នូវ បរិយាកាស ធុរកិច្ច និង វិនិយោគ នៅ កម្ពុជា ។
* សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា កម្ពុជា និង ស្រីលង្កា បាន ចាប់ផ្តើម មាន ទំនាក់ទំនង ការទូត ជាមួយគ្នា តាំងពី ជាង ៦ទសវត្សរ៍ មុន មក ម្ល៉េះ ពោលគឺ ចាប់ពី ឆ្នាំ ១៩៥២ ប៉ុន្តែ ចំណង ការទូត នេះ ត្រូវបាន ផ្អាក មួយ រយៈ ដោយសារ សង្គ្រាម ស៊ីវិល នៅ កម្ពុជា ចាប់ពី ឆ្នាំ ១៩៧៥ ។
* សម្តេច តេជោ បាន ថ្លែង ថា កម្ពុជា - ស្រីលង្កា បាន បង្កើត ទំនាក់ទំនង ការទូត ជា ផ្លូវការ ឡើង វិញ កាលពី ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ១៩៩៦ ហើយ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ មាន លក្ខណៈ ជា មិត្តភាព កាន់តែ ស្និទ្ធស្នាល តាមរយៈ ការផ្លាស់ប្តូរ ទស្សនកិច្ច របស់ ថ្នាក់ដឹកនាំ នៃ ប្រទេស យើង ទាំង ពីរ ។
* សម្តេច តេជោ បាន ថ្លែង ថា កាលពី ឆ្នាំ ១៩៧៩ នៅពេល សម្តេច នៅ ជា រដ្ឋមន្ត្រី ក្រសួង ការបរទេស សម្តេច បាន ដឹកនាំ គណៈប្រតិភូ ចូលរួម កិច្ចប្រជុំ ចលនា មិន ចូល បក្ស សម្ព័ន្ធ នៅ ទីក្រុង កូឡំ បូ ដែល នោះ ជា ទស្សនកិច្ច លើក ដំបូង របស់ សម្តេច នៅ ប្រទេស ស្រីលង្កា ។
* សម្តេច បាន ថ្លែង ថា ដំណើរទស្សនកិច្ច របស់ ប្រធានាធិបតី ស្រីលង្កា នា ពេលនេះ បាន បង្ហាញ ពី ការពង្រឹង ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ប្រសើរឡើង ជាពិសេស ក្នុង វិស័យ ការទូត ពាណិជ្ជកម្ម និង ទេសចរណ៍ ។
* សម្តេច តេជោ នាយក រដ្ឋ បាន ថ្លែង ថា ដើម្បី ជា សក្ខីភាព តាម រយៈ ដំណើរទស្សនកិច្ច នេះ នា ថ្ងៃស្អែក នឹង មាន ការចុះហត្ថលេខា លើ អនុស្សារណៈ នៃ ការយោគយល់ គ្នា ស្តីពី កិច្ចពិគ្រោះយោបល់ នយោបាយ រវាង ក្រសួង ការបរទេស នៃ ប្រទេស ទាំង ពីរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ក្នុង រយៈពេល ជាង ពីរ ទស្សវត្សរ៍ ចុងក្រោយ នេះ កម្ពុជា សម្រេចបាន កំណើន សេដ្ឋកិច្ច ប្រចាំ ឆ្នាំ ជា មធ្យម ក្នុង រង្វង់ ៧.៧% ហើយ បាន ចាកចេញ ពី ឋានៈ ជា ប្រទេស មាន ចំណូល ទាប ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប ក្នុង ឆ្នាំ ២០១៥ ។ នៅក្នុង ឆ្នាំ ២០១៨ សេដ្ឋកិច្ច កម្ពុជា មាន កំណើន ក្នុង អត្រា ៧.៥% ដែល អត្រា កំណើន នេះ ជា មូលដ្ឋាន នៃ ការបន្ត ភាព រឹងមាំ នៅក្នុង ឆ្នាំ ២០១៩ ។
* សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា សូចនាករ នេះ បង្ហាញ ថា កម្ពុជា កំពុង ស្ថិត នៅលើ គន្លង នៃ ការឈានទៅ សម្រេចបាន ឋានៈ ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ ត្រឹម ឆ្នាំ ២០៣០ តាម ការកំណត់ ក្នុង របៀបវារៈ នៃ គោល នយោបាយ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ក្នុង ក្របខណ្ឌ នៃ ការវិនិយោគ កម្ពុជា នៅតែ ជា ប្រទេស គោលដៅ ដែល មាន សក្តានុពល សម្រាប់ អ្នក វិនិយោគ ទាំង ក្នុង ស្រុក និង ទាំង បរទេស ។ ជាក់ស្តែង ផ្អែក តាម ការកត់ត្រា របស់ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា សម្រាប់ រយៈពេល ៥ឆ្នាំ កន្លងទៅ ( ២០១៤ - ២០១៨ ) ស្ថានភាព វិនិយោគ របស់ កម្ពុជា មាន លក្ខណៈ ល្អ ប្រសើរ ដោយ កម្ពុជា បាន អនុម័ត គម្រោង វិនិយោគ ចំនួន ៩៥៩ គម្រោង ក្នុង ទុន វិនិយោគ សរុប ចំនួន ប្រមាណ ២៣ប៊ីលាន ដុល្លារ អាមេរិក ដែល អាច បង្កើត ការងារ ចំនួន ១លាន កន្លែង ។
* សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា តួលេខ វិនិយោគ ក្នុង ឆមាស ទី១ ឆ្នាំ ២០១៩ គម្រោង វិនិយោគ ត្រូវបាន អនុម័ត មាន ចំនួន ១៥៣ គម្រោង ក្នុង ទុន វិនិយោគ ប្រមាណ ៥.២ ពាន់ លាន ដុល្លារ អាមេរិក បើ ប្រៀបធៀប នឹង រយៈពេល ដូចគ្នា ក្នុង ឆមាស ទី១ ឆ្នាំ ២០១៨ ចំនួន គម្រោង មាន ការកើនឡើង ៤៨ គម្រោង ខណៈ ដែល ទុន វិនិយោគ មាន ការកើនឡើង ប្រមាណ ២ពាន់ លាន ដុល្លារ អាមេរិក ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ នូវ គោល នយោបាយ អភិវឌ្ឍន៍ វិស័យ ឧស្សាហកម្ម កម្ពុជា ឆ្នាំ ២០១៥ - ២០២៥ ដែល ជា យុទ្ធសាស្ត្រ កំណើន សេដ្ឋកិច្ច ថ្មី សំដៅ ធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច និង កែប្រែ រចនាសម្ព័ន្ធ ឧស្សាហកម្ម កម្ពុជា ពី ឧស្សាហកម្ម អតិពលកម្ម ទៅជា ឧស្សាហកម្ម ផ្អែក លើ ជំនាញ ត្រឹម ឆ្នាំ ២០២៥ ។
* សម្តេច តេជោ បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល ចាត់ទុក វិស័យ ឯកជនជា ក្បាល ម៉ាស៊ីន នៃ កំណើន សេដ្ឋកិច្ច និង ជា ដៃគូ ដ៏ ពិតប្រាកដ ក្នុង ការអភិវឌ្ឍ ប្រទេស ។
* សម្តេច តេជោ បាន បញ្ជាក់ ថា កាលពី ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ កន្លងទៅ សម្តេច បាន ដឹកនាំ វេទិកា រាជ រដ្ឋាភិបាល ។ ផ្នែក ឯកជន លើក ទី១៨ ដែល ក្នុង ឱកាស នោះ ខ្ញុំ បាន ដាក់ចេញ នូវ វិធានការ មុត ស្រួច មួយចំនួន សំដៅ ១) បង្កើន ភាពប្រកួតប្រជែង នៃ សេដ្ឋកិច្ច កម្ពុជា . ២) កែលម្អ និង លើកស្ទួយ ថែម ទៀត នូវ បរិយាកាស វិនិយោគ និង ធុរកិច្ច និង ៣) ធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច ជាតិ និង បង្កើត ការងារ ប្រកបដោយ គុណភាព កាន់តែ ច្រើន ថែម ទៀត ជូន ប្រជាជន កម្ពុជា ។
* សម្តេច តេជោ បាន បញ្ជាក់ ថា បច្ចុប្បន្ន វិធានការ ទាំង នេះ ត្រូវបាន និង កំពុង អនុវត្ត យ៉ាង ហ្មត់ចត់ ដោយ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ហើយ រាជ រដ្ឋាភិបាល ក៏ បាន រៀបចំ ឱ្យ មាន យន្តការ មួយ ច្បាស់លាស់ សម្រាប់ ពិនិត្យ និង ធ្វើការតាមដាន ការអនុវត្ត វិធានការ ទាំង នេះ ដើម្បី ធានា បាន នូវ ប្រសិទ្ធភាព នៃ ការសម្រេច គោលដៅ ទាំង៣ ខាងលើ ។
* សម្តេច តេជោ បាន ថ្លែង ស្វាគមន៍ រាល់ ការសម្រេចចិត្ត ដ៏ ឈ្លាសវៃ របស់ អ្នក វិនិយោគ បរទេស ទាំងអស់ ជាពិសេស អ្នក វិនិយោគ ស្រីលង្កា ដែល មាន បំណង ជ្រើសរើស កម្ពុជា ជា គោលដៅ វិនិយោគ ដ៏ មាន សក្តានុពល ខ្ពស់ ក្នុង ការចាប់ផ្តើម ឬ ពង្រីក អាជីវកម្ម របស់ ខ្លួន ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន លើកទឹកចិត្ត ដល់ អ្នក វិនិយោគ កម្ពុជា ដែល មាន បំណង ចង់ ពង្រីក អាជីវកម្ម របស់ ខ្លួន នៅ ក្រៅ ប្រទេស ពិចារណា យក ប្រទេស ស្រីលង្កា ជា ប្រទេស គោលដៅ របស់ ខ្លួន ។ សម្តេច តេជោ បាន រំលឹក ថា កាលពី ប៉ុន្មាន ឆ្នាំ មុន កម្ពុជា តែងតែ អំពាវនាវ ឱ្យ អ្នក វិនិយោគ បរទេស មក កម្ពុជា ប៉ុន្តែ នៅ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ កម្ពុជា អ្នក វិនិយោគ កម្ពុជា ក៏ បាន ចេញ ទៅ វិនិយោគ នៅ ឡាវ មីយ៉ាន់ម៉ា ទីម័រ និង ប្រទេស ដទៃ ទៀត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ជម្រាប ធុរ ជន និង អ្នក វិនិយោគ ស្រីលង្កា អំពី សក្តានុពល វិនិយោគ និង ឧត្តមភាព សំខាន់ ៗ របស់ កម្ពុជា លើ ៥ចំណុច រួម មាន៖
ទី៤៖ កម្ពុជា ស្ថិត នៅលើ ទីតាំង ជា យុទ្ធសាស្ត្រ ក្នុង តំបន់ អាស៊ាន ដែល តំបន់ នេះ បាន និង កំពុង ក្លាយជា « រោងចក្រ នៃ អាស៊ី » ។ ទំនិញ ផលិត នៅ កម្ពុជា អាច ផ្គត់ផ្គង់ ទីផ្សារ នៅក្នុង ស្រុក . ទីផ្សារ អនុ តំបន់ មេគង្គ . ទីផ្សារ អាស៊ាន និង ទីផ្សារ សំខាន់ ៗ ដទៃ ទៀត ក្នុង ពិភពលោក ។
ទី៥៖ កម្ពុជា មាន សក្តានុពល សម្រាប់ ការអភិវឌ្ឍ ទេសចរណ៍ « វប្បធម៌ និង ធម្មជាតិ » រួម មាន សម្បត្តិ វប្បធម៌ ធនធាន ធម្មជាតិ កេរ្តិ៍ តំណែល ប្រវត្តិសាស្ត្រ ព្រមទាំង ទេសភាព ដ៏ ស្រស់ ត្រកាល នៃ ឆ្នេរសមុទ្រ ទន្លេ បឹងបួរ និង ព្រៃ ព្រឹក្សា របស់ ជាតិ ដែល ទាំងនេះ មាន ភាពទាក់ទាញ សម្រាប់ ទីផ្សារ ទេសចរណ៍ ទាំង ក្នុង ស្រុក និង អន្តរជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្នក វិនិយោគ បរទេស ទទួលបាន ផលប្រយោជន៍ និង ការគាំពារ ដូចគ្នា នឹង អ្នក វិនិយោគ ក្នុង ប្រទេស ហើយ មាន លទ្ធភាព ដាក់ ទុន វិនិយោគ ១០០ ភាគរយ មិន ចាំបាច់ មាន ការចូលរួម ពី អ្នក វិនិយោគ នៅក្នុង ប្រទេស នោះ ទេ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្នក វិនិយោគ បរទេស នៅ កម្ពុជា មិន ត្រឹមតែ សម្រាប់ ទីផ្សារ នៅ កម្ពុជា នោះ ទេ តែ អាច ចែកចាយ ទៅ ផ្សារ ប្រទេស ដទៃ ទៀត ដែល មាន ប្រជាពលរដ្ឋ ប្រមាណ ៣ពាន់ លាន នាក់ ជាមួយ ប្រទេស សមាជិក អាស៊ាន និង ប្រទេស ដៃ គូ ពាណិជ្ជកម្ម ដទៃ ទៀត ដូចជា ចិន ឥណ្ឌា និង ប្រទេស ដទៃ ទៀត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន លើកទឹកចិត្ត ដល់ អ្នក វិនិយោគ ស្រីលង្កា ដែល មាន វត្តមាន នៅ ទីនេះ ធ្វើ ការពិភាក្សា បន្ថែម ជាមួយ ធុរ ជន កម្ពុជា និង តំណាង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បី សិក្សា ស្វែងយល់ ពី សក្តានុពល និង កាលានុវត្តភាព វិនិយោគ នៅ កម្ពុជា ព្រមទាំង សម្រេចចិត្ត បណ្តាក់ទុន វិនិយោគ នៅ កម្ពុជា ។
* សម្តេច តេជោ បាន ប្រកាស ថា ក្នុង នាម រាជ រដ្ឋាភិបាល សម្តេច ធានា ជូន អ្នក វិនិយោគ គ្រប់ រូប នូវ បរិស្ថាន គ្រប់ បែបយ៉ាង ដែល អនុគ្រោះ និង ជួយ ជំរុញ ដល់ ការវិនិយោគ ពិសេស គឺ សន្តិភាព សន្តិសុខ និង ស្ថិរភាព នយោបាយ ក៏ ដូចជា ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច ក្របខណ្ឌ ច្បាប់ និង ស្ថាប័ន ដែល ប្រកបដោយ ប្រសិទ្ធភាព តម្លាភាព គណនេយ្យភាព និង ភាព អាច ប៉ាន់ប្រមាណ បាន ។
លោក ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល បាន ថ្លែង ថា ក្រុមហ៊ុន ត្រួតពិនិត្យ គុណភាព ផ្លូវ ដែល ជា ភ្នែក ច្រមុះ របស់ ក្រសួង ត្រូវតែ ខិតខំ ធ្វើការ ដោយ ឯករាជ្យ អព្យាក្រិត្យ ត្រូវ ធ្វើឱ្យ ក្រុមហ៊ុន សាង់ សង់ ខ្លាច ដោយ មិន ត្រូវ ខ្លាច ក្រុមហ៊ុន សាងសង់ នោះ ទេ ហើយ បើ ការចុះ ធ្វើការ មិន បាន ដិតដល់ នៅតែ បន្ត មាន ក្រុមហ៊ុន សាង់ សង់ មិន បាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស ទៀត មិន ត្រឹមតែ មាន ក្រុមហ៊ុន ពិនិត្យ គុណភាព បរទេស ត្រូវ ដក ចេញ ទេ មន្ត្រី ក្រសួង សាធារណការ ក៏ ត្រូវតែ ដក ចេញ ដែរ ។
រដ្ឋមន្ត្រី ក្រសួង សាធារណការ ក៏ បាន ជំរុញ ឱ្យ ក្រុមហ៊ុន ត្រួតពិនិត្យ គុណភាព ផ្លូវ ដែល ជា ភ្នែក ច្រមុះ របស់ ក្រសួង ត្រូវតែ ខិតខំ ធ្វើការ និង ឯករាជ្យ អព្យាក្រិត្យ ត្រូវ ធ្វើឱ្យ ក្រុមហ៊ុន សាង់ សង់ ខ្លាច ដោយ មិន ត្រូវ ខ្លាច ក្រុមហ៊ុន សាងសង់ នោះ ទេ ។ ក្រសួង បាន ដក មន្ត្រី ប្រឹក្សា យោបល់ បរទេស ៦នាក់ រួច មកហើយ ហើយ បើ នៅតែ មាន បញ្ហា ទៀត មន្ត្រី ក្រសួង ក៏ ត្រូវតែ ដក ចេញ ដែរ បើសិនជា ធ្វើការ មិន បាន ដិតដល់ គឺ ត្រូវតែ មាន ការផ្លាស់ប្តូរ បើ ឃើញ ខុស ត្រូវតែ ហ៊ាន រាយការណ៍ មិន ត្រូវ ខ្លាច ក្រុមហ៊ុន សាងសង់ ទេ ។
លោក អះអាង ថា ក្រសួង សាធារណការ នឹង បង្កើត ក្រុម ត្រួតពិនិត្យ ពិសេស ដើម្បី ទៅ ឆ្មក់ លើ ក្រុម ត្រួតពិនិត្យ បរទេស និង ក្រុម ត្រួតពិនិត្យ ខ្មែរ បន្ថែម ទៀត ដោយ មិន ឱ្យដឹង មិន មុន ទេ ជាមួយនឹង គ្រឿង សម្ភារៈ គ្រប់គ្រាន់ ដើម្បី ធ្វើ ការងារ ទាំងអស់ នេះ ចាំ មើល ថា ធ្វើ បាន ល្អ ឬ អត់ បើ មិន បាន ទេ នឹង ដក ចោល តែម្តង ។
យោង តាម ធនាគារ កណ្ដាល ចិន តម្លៃ ប្រាក់ យ័ន នៅពេល ទីផ្សារ ភាគហ៊ុន បើក ទ្វារ កាលពី ថ្ងៃអង្គារ ស្ថិត នៅ អាត្រា ៦.៩៩៩៦ យ័ន ក្នុង មួយ ដុល្លារ អាមេរិក ហើយ នេះ គឺជា ការធ្លាក់ចុះ តម្លៃ ទាប បំផុត មួយ ចាប់តាំងពី ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០០៨ ។ ដោយឡែក ទីក្រុង វ៉ាស៊ីនតោន បាន ចោទប្រកាន់ ចិន ថា កំពុង កេង ចំណេញ ពាណិជ្ជកម្ម ពី សហរដ្ឋ អាមេរិក តាមរយៈ ការទម្លាក់ តម្លៃ ប្រាក់ យ័ន នេះ រហូតដល់ ក្រសួង រតនាគារ ជាតិ អាមេរិក បញ្ចូល ចិន ទៅក្នុង បញ្ជីខ្មៅ នៃ « ប្រទេស បំភ្លៃ រូបិយវត្ថុ » ។
ជា ការឆ្លើយតប នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន ធនាគារ កណ្ដាល ចិន បាន ថ្កោលទោស យ៉ាង ខ្លាំង ចំពោះ ការសម្រេចចិត្ត របស់ សហរដ្ឋ អាមេរិក ហើយ អះអាង ថា ការចាត់ទុក ចិន ជា ប្រទេស បំភ្លៃ រូបិយវត្ថុ មាន តែ នឹង បំផ្លាញ ដល់ សណ្ដាប់ធ្នាប់ នៃ ទីផ្សារ ហិរញ្ញវត្ថុ ព្រមទាំង សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ពិភពលោក តែ ប៉ុណ្ណោះ ។ ការទម្លាក់ តម្លៃ រូបិយវត្ថុ ជាទូទៅ ត្រូវបាន ប្រទេស មួយ អនុវត្តន៍ ក្នុង គោលបំណង បង្កើន ការនាំចេញ ទៅកាន់ ទីផ្សារ អន្តរជាតិ និង ធ្វើឱ្យ ទំនិញ របស់ ខ្លួន មាន តម្លៃ ទាក់ទាញ ជាង គូ ប្រជែង ៕
