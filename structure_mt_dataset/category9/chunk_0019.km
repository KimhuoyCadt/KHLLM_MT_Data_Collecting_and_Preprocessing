( ភ្នំពេញ ) ៖ លោក នុត ពុធ ដារ៉ា ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន និង ជា អភិបាល ខណ្ឌ ដង្កោ នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ បន្ដ ចុះ វេទិកា សាធារណៈ និង សំណេះសំណាល សួរសុខទុក្ខ ប្រជាពលរដ្ឋ ចំនួន ៦ ក្នុង សង្កាត់ ដង្កោ ដើម្បី ទទួលយក សំណើ សំណូមពរ និង បញ្ហា ផ្សេង ៗ របស់ ប្រជាពលរដ្ឋ មក ដោះស្រាយ ឱ្យ បាន ទាន់ ពេល វេលា ។
ក្នុង វេទិកា សាធារណៈ នេះ ក៏ មាន ការចូលរួម ពី លោក លោកស្រី អភិបាល រង លោក អធិការ រង នគរបាល ខណ្ឌ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខណ្ឌ មន្ត្រីរាជការ ខណ្ឌ ចៅសង្កាត់ នាយ ប៉ុស្តិ៍ មេភូមិ និង មន្ដ្រី ពាក់ព័ន្ធ ជាច្រើន ទៀត ផងដែរ ។
តាមរយៈ វេទិកា សាធារណៈ នេះ លោក នុត ពុធ ដារ៉ា បាន ផ្ដល់ ឱកាស ឱ្យ ប្រជាពលរដ្ឋ លើ ក យក សំណើ និង សំណូមពរ ផ្សេង ដែល ជា បញ្ហា កង្វល់ របស់ ពួកគាត់ ក៏ ដូចជា តម្រូវការ ផ្សេង ៗ ផងដែរ ។ បន្ថែម ពី នេះ លោក អភិបាល ខណ្ឌ ក៏ បាន ណែនាំ ដល់ មន្ដ្រី ទាំងអស់ ត្រូវតែ ក្ដោប ក្ដាប់ ឱ្យ បាន នូវ អ្វី ដែល ជា តម្រូវការ របស់ ប្រជាពលរដ្ឋ ៕
វេទិកា បរិស្ថាន និស្សិត អាស៉ី លើក ទី៨ រៀបចំឡើង នៅ កម្ពុជា ៦ ថ្ងៃ
ASEP ត្រូវបាន បង្កើតឡើង ដើម្បី អភិវឌ្ឍ ធនធាន មនុស្ស ដែល មាន សកម្មភាព ជាមួយនឹង ទស្សនវិស័យ ពិភពលោក នៅក្នុង បរិស្ថាន ធម្មជាតិ និង ពិចារណា អំពី ទីតាំង ដែល មាន សារៈសំខាន់ នៃ សកម្មភាព ពាណិជ្ជកម្ម នា ពេល អនាគត ។
វេទិកា នេះ មាន និស្សិត ៨០ នាក់ មកពី សាកលវិទ្យាល័យ ផ្សេង ៗ គ្នា ក្នុង ចំណោម ប្រទេស ចំនួន ១០ ដែល នឹង ត្រូវ ចូលរួម នៅក្នុង ការងារ ដែល មាន សារៈសំខាន់ នេះ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត សៀមរាប ។ វេទិកា ឆ្នាំ ២០១៩ នេះ ត្រូវបាន ប្រារព្ធ ឡើង ក្រោម ប្រធានបទ « ការកសាង សន្តិភាព ប្រកបដោយ ចីរភាព » ។
( បន្ទាយមានជ័យ )៖ យោធ ភូមិភាគ ទី៥ នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន បើក វគ្គ ហ្វឹកហ្វឺន ជំនាញ អន្តរាគមន៍ ពិសេស និង ក្បាច់គុន របស់ កងយោធពល ខេមរភូមិន្ទ ដល់ កងពល តូច ថ្មើរជើង លេខ ៥១ ដើម្បី ពង្រឹង ពង្រីក សមត្ថភាព ឱ្យ កាន់តែ មាន គុណភាព ដែល អាច ពង្រឹង ប្រៀបការពារ ជាតិ ការពារ បូរណភាព ទឹកដី កម្ពុជា ឱ្យ កាន់តែ រឹងមាំ ។
ពិធី បើក វគ្គ ហ្វឹកហ្វឺន នេះ ធ្វើឡើង ក្រោម វត្តមាន ឧត្តមសេនីយ៍ ទោ សេង ធារិន មេបញ្ជាការង នាយ សេនាធិការ យោធ ភូមិភាគ ទី៥ ឧត្តមសេនីយ៍ ទោ ឈុន ម៉ៅ មេបញ្ជាការ រង យោធភូមិភាគ ទី៥ មេបញ្ជាការ ទិសទី១ ខេត្ត បន្ទាយមានជ័យ លោក យូ ស៊ីណែត ប្រធាន សហព័ន្ធ យុទ្ធ ក្រម ខម កម្ពុជា មេបញ្ជាការ តាម បណ្តា អង្គភាព ចំណុះ ទិសទី១ ស្ថិត នៅ ភូមិ ភ្នំ ជញ្ជាំង ឃុំ ជប់វ៉ារី ស្រុក ព្រះនេត្រ ព្រះ ខេត្ត បន្ទាយមានជ័យ ។
ឧត្តមសេនីយ៍ សេង ធារិន បាន បញ្ជាក់ ថា នេះ ជា លើក ទី១ យោធ ភាគ ទី៥ បាន ដាក់ បញ្ជូល កម្មវិធី យុទ្ធ គុន ក្នុង កម្មវិធី ហ្វឹកហ្វឺន សំដៅ លើកកម្ពស់ សមត្ថភាព និង កាយសម្បទា រឹងមាំ របស់ យោធិន ក្នុង តួនាទី ភារកិច្ច ពិសេស ចូលរួមចំណែក ថែរក្សា កេរ្តិ៍ដំណែល សម្បត្តិ វប្បធម៌ ជាតិ ក្បាច់គុណ បូរាណ ខ្មែរ ដែល ជា មរតក អមតៈ មិន អាច កាត់ ថ្លៃ ស្នាដៃ របស់ បុព្វបុរស ខ្មែរ ។
លោក បន្ត ថា ចំពោះ កិច្ចខិតខំ បំពេញ ការងារ របស់ ថ្នាក់ដឹកនាំ យោធាចារ្យ បុគ្គលិក បម្រើ ការ និង នាយ ទាហាន ទាំងអស់ ត្រូវ សហការ គ្នា យ៉ាង ល្អ ក្នុង ការរៀបចំ ឱ្យ មាន កម្មវិធី សក្សា និង កិច្ច ដំណើ ការ នូវ វគ្គ ហ្វឹកហ្វឺន ជាច្រើន សំដៅ ពង្រឹង ពង្រីក សមត្ថភាព កងទ័ព របស់ យើង ឱ្យ កាន់តែ មាន គុណភាព ដែល អាច ពង្រឹង ប្រៀបការពារ ជាតិ ការពារ បូរណភាព ទឹកដី កម្ពុជា ឱ្យ កាន់តែ រឹងមាំ ។
សូម បញ្ជាក់ ថា សិក្ខាកាម វគ្គ ហ្វឹកហ្វឺន នេះ សរុប ចំនួន ១៣៩ នាក់ គ្រូបង្ហាត់ មកពី សហន្ធ័ យុទ្ធ ក្រម ខម ចំនួន ២រូប រយៈពេល ៩០ ថ្ងៃ កម្លាំង នេះ ក៏ ជា ផ្នែក មួយ សម្រាប់ ត្រៀម ចល័ត អន្តរាគមន៍ តាម ផែនការ របស់ ថ្នាក់ លើ ផងដែរ ៕
នា វេលា ទាប ភ្លឺ នៅ មុន ករណី ផ្ទុះ គ្រាប់បែក ទាំងនេះ ក៏ មាន សេចក្តីរាយការណ៍ អំពី គ្រោះ អគ្គីភ័យ តូច ៗ ចំនួន ០៤ កើតឡើង ផងដែរ នៅ ទីក្រុង បាងកក ខណ ហេតុការណ៍ ទាំងអស់ នេះ ទៀតសោត កើតមាន មួយ ថ្ងៃ ក្រោយ ការរកឃើញ គ្រាប់បែក ក្លែងក្លាយ នៅ ពីមុខ ស្នងការ ប៉ូលិស ជាតិ ថៃ ដោយ ជនសង្ស័យ ពីរ នាក់ ត្រូវបាន ចាប់ខ្លួន ។
គួរ ជម្រាប ថា សកម្មភាព ទាំងអស់ ខាងលើ ទំនងជា មាន គោលដៅ បង្ក ភាពអាម៉ាស់ ដល់ រដ្ឋាភិបាល ថៃ ខណៈ ទីក្រុង បាងកក កំពុង បើក កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស មកពី បណ្តា ប្រទេស ជា សមាជិក អាស៊ាន និង មកពី បណ្តា ប្រទេសជា មហាអំណាច ធំ ៗ ដូចជា អាមេរិក ចិន និង រុស្ស៊ី ដោយ ហាក់ គ្មាន គោលបំណង ដើម្បី បង្កឲ្យ មាន មនុស្ស ស្លាប់ នោះ ឡើយ ៕
ឃាត់ខ្លួន ក្រុម ជួញដូរ គ្រឿងញៀន ៣នាក់ និង ដកហូត វត្ថុតាង មួយចំនួន នៅ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ កម្លាំង ការិយាល័យ ប្រឆាំង គ្រឿងញៀន សហការ ជាមួយ កម្លាំង នគរបាល ស្រុក ឆ្លូង ខេត្ត ក្រចេះ បាន បើក ប្រតិបត្តិការ បង្ក្រាប និង ឃាត់ខ្លួន ជនសង្ស័យ ៣នាក់ ដែល ជា មុខសញ្ញា ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន ដ៏ សកម្ម ព្រមទាំង ដកហូត បាន វត្ថុតាង មួយចំនួន ។
ប្រតិបត្តិការ ចុះបង្ក្រាប នេះ បាន ធ្វើឡើង នៅ វេលា ម៉ោង ៦៖ ៥នាទី ល្ងាច ថ្ងៃទី១ ខែសីហា ឆ្នាំ ២០១៩ ម្សិលមិញ នៅ ចំណុច ភូមិ ពង្រ២ ឃុំ ពង្រ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
បើ តាម លោក សៀន សុភក្រ័ ប្រធាន ការិយាល័យ ប្រឆាំង គ្រឿងញៀន បាន ឱ្យដឹង ថា ប្រតិបត្ត ការ បង្រ្កាប ករណី ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សាធាតុ ញៀន នេះ ក្រោម បញ្ជា ឧត្ដមសេនីយ៍ ទោ លន់ សុផាត ស្នងការ នគរបាល ខេត្ត សម្របសម្រួល ដោយ លោក កែវ សុជាតិ ព្រះរាជអាជ្ញា សាលាដំបូង ខេត្ត ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៣នាក់ ដែល ជា មុខសញ្ញា សកម្ម រួម និង វត្ថុតាង គ្រឿងញៀន ផងដែរ ។
លោក បាន បន្ត ទៀត ថា ជនសង្ស័យ ទី១៖ ឈ្មោះ ញ៉េប រ៉សែត ភេទ ប្រុស អាយុ ២៣ ឆ្នាំ ជនជាតិ ខ្មែរ ឥស្លាម រស់ នៅ ភូមិ ឃុំ កើត ហេតុ ខាង លើ . ទី ២៖ ឈ្មោះ ស្លេះ អារី ហ្វីន ភេទ ប្រុស អាយុ ៣១ ឆ្នាំ ជនជាតិ ខ្មែរ ឥស្លាម រស់ នៅ ភូមិ អំពិល ឃុំ ប៉ឹស ស្រុក ក្រូចឆ្មា ខេត្ត ត្បូងឃ្មុំ និង ទី៣៖ ឈ្មោះ សារី ម៉ូស្លីម ភេទ ប្រុស អាយុ ២៧ ឆ្នាំ ជនជាតិ ខ្មែរ ឥស្លាម រស់ នៅ ភូមិ ពង្រ១ ឃុំ ពង្រ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
វត្ថុតាង ដកហូត បាន រួម មាន៖ ម្សៅ ក្រាម ពណ៌ ស ចំនួន ៦កញ្ចប់ ( ធំ ២កញ្ចប់ តូច ៤កញ្ចប់ ) ថង់ ប្លាស្ទិច សម្រាប់ ច្រក រំលែក គ្រឿងញៀន មួយចំនួន ទូយោចូក រំលែក គ្រឿងញៀន ចំនួន ១ ដាវ សាម៉ូរ៉ៃ ១ ដើម កាំភ្លើង កែច្នៃ ១ដើម ទូរស័ព្ទ ចំនួន ២គ្រឿង និង សម្ភារ សម្រាប់ ប្រើប្រាស គ្រឿងញៀន មួយចំនួន ។
បច្ច ប្បន្ន ជនសង្ស័យ ទាំង ៣នាក់ និង វត្ថុតាង កំពុង ឃាត់ខ្លួន និង រក្សាទុក បណ្ដោះអាសន្ន នៅ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ក្រចេះ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ៕
ប្រតិកម្ម ខាងលើ របស់ យោធា វេណេស៊ុយអេឡា កើត មាន ឡើង ក្រោយ ទីក្រុង ការ៉ាកាស់ បាន ចោទប្រកាន់ យន្ដហោះ ស៊ើបការណ៍ អាមេរិក EP3 បាន រំលោភ ចូលក្នុង ដែន អាកាស វេណេស៊ុយអេឡា កាលពី ថ្ងៃពុធ កន្លងទៅ ។ ប៉ុន្តែ នេះ មិន មែន ជា លើក ទី មួយ ឡើយ ដែល ទីក្រុង ធ្វើ ការចោទប្រកាន់ បែប នេះ ខណៈ សហរដ្ឋ អាមេរិក ជារឿយ ៗ តែងតែ ទាត់ ចោល ការចោទប្រកាន់ បែប នេះ ដោយ អះអាង ថា យន្ដហោះ យោធា របស់ ខ្លួន ធ្វើ ការហោះហើរ នៅក្នុង ដែន អាកាស អន្តរជាតិ តែ ប៉ុណ្ណោះ ។
( ប៉េកាំង ) ៖ ផ្កាយ រណប ខ្នាត តូច មួយ គ្រឿង របស់ ចិន ត្រូវបាន អ្នកវិទ្យាសាស្រ្ត បញ្ជា ឲ្យ ទម្លាក់ ខ្លួន ចោល នៅ ផ្ទៃ ព្រះច័ន្ទ ក្រោយពី វា បាន បញ្ចប់ បេសកកម្ម របស់ ខ្លួន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃសុក្រ ទី ០២ ខែសីហា ឆ្នាំ ២០១៩ ។
លើស ពី នោះ ក៏ មាន ការបញ្ចុះ តម្លៃ ស្រាបៀរ ២០% ដដែល ចាប់ពី ម៉ោង ៦ល្ងាច តទៅ ដែល ជា ឱកាស ដ៏ ល្អ មួយ សម្រាប់ អតិថិជន ដែល និយម គាំទ្រ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការងារ៖ ច្បាប់ សហជីព បាន ធានា ភាពសុខដុមរមនា ក្នុង ទំនាក់ទំនង វិជ្ជាជីវៈ លើកកម្ពស់ សិទ្ធិ សេរីភាព អង្គការ វិជ្ជាជីវៈ
( ភ្នំពេញ ) ៖ លោក ម៉ម វណ្ណៈ រដ្ឋលេខាធិការ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន អះអាង ថា ក្រោយពី ចូល ជាធរមាន ច្បាប់ ស្តីពី សហជីព បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការធានា ភាពសុខដុមរមនា នៅក្នុង ទំនាក់ទំនង វិជ្ជាជីវៈ និង បាន ចូលរួម លើកកម្ពស់ សិទ្ធិ សេរីភាព អង្គការ វិជ្ជាជីវៈ ។
ការលើកឡើង របស់ លោក រដ្ឋលេខាធិការ យ៉ាង ដូច្នេះ ត្រូវបាន ធ្វើឡើង ក្នុង ពិធី បើក សិក្ខាសាលា ពិគ្រោះយោបល់ ត្រី ភាគី ថ្នាក់ ជាតិ លើក ទី២ លើ សេចក្តីព្រាង វិសោធនកម្ម ច្បាប់ ស្តីពី សហជីព នា ព្រឹក ថ្ងៃទី ២ ខែសីហា ឆ្នាំ ២០១៩ នៅ សណ្ឋាគារ សាន់ វេ។
លោក ម៉ម វណ្ណៈ បាន បង្ហាញ ចំនួន សហជីព ដែល បាន ចុះបញ្ជី នៅ ក្រសួង ការងារ មាន ការកើនឡើង រៀងរាល់ ឆ្នាំ នៅ គ្រប់ ថ្នាក់ ទាំង ថ្នាក់ សហជីព មូលដ្ឋាន សហព័ន្ធ សហជីព និង សហភាព សហជីព ។ ជាក់ស្តែង គិត ត្រឹម ឆមាស ទី១ ឆ្នាំ ២០១៩ នេះ អង្គការ វិជ្ជាជីវៈ ដែល ចុះបញ្ជី នៅ ក្រសួង ការងារ មាន ចំនួន ៥០៤៥ ក្នុង នោះ សហជីព មូលដ្ឋាន មាន ចំនួន ៤៨១១ សហព័ន្ធ សហជីព មាន ចំនួន ១៩៥ សហភាព សហជីព មាន ចំនួន ២៩ សមាគម និយោជក មាន ចំនួន ១០ ។
បន្ថែម លើ នេះ ចំនួន វិវាទ ការងារ រួម និង កូដកម្ម - បាតុកម្ម ក៏ មាន ការធ្លាក់ចុះ គួរឱ្យ កត់សម្គាល់ ផងដែរ ដែល បណ្តាល មកពី ប្រសិទ្ធភាព នៃ ការអនុវត្ត ច្បាប់ ស្តីពី សហជីព និង ការពង្រឹង ប្រព័ន្ធ អធិការ កិច្ចការងារ កាន់តែ ល្អ ប្រសើរ ។
លោក ម៉ម វណ្ណៈ លើកឡើង បន្ត ថា ទន្ទឹម នឹង វឌ្ឍនភាព ទាំងនេះ ក៏ នៅ មាន សហជីព និង ស្ថាប័ន អន្តរជាតិ មួយចំនួន មិន ទាន់ មាន ការយល់ដឹង ច្បាស់ អំពី ខ្លឹមសារ នៃ បទប្បញ្ញត្តិ ច្បាប់ ស្តីពី សហជីព ដោយ បាន បន្ត លើកឡើង អំពី កង្វល់ មួយចំនួន ក្នុង ការចុះបញ្ជី សហជីព និង ការស្នើសុំ បញ្ជាក់ ភាព ជា តំណាង បំផុត របស់ សហជីព ។
លោក រដ្ឋលេខាធិការ បញ្ជាក់ បន្ថែម ថា សេចក្តីព្រាង ច្បាប់ វិសោធនកម្ម នេះ គឺជា សេចក្តីព្រាង ដែល ត្រូវបាន ធ្វើ ការកែសម្រួល ដោយ ក្រុមការងារ បច្ចេកទេស ច្បាប់ របស់ ក្រសួង ការងារ បន្ទាប់ពី បាន ទទួល ធាតុ ចូល ពី ភាគី ពាក់ព័ន្ធ នៅក្នុង សិក្ខាសាលា ត្រី ភាគី កាលពី ថ្ងៃទី ២៥ ខែមេសា ឆ្នាំ ២០១៩ និង មតិ យោបល់ មួយចំនួន ទៀត ដែល ភាគី ពាក់ព័ន្ធ បាន ផ្ញើ មក ក្រសួង តាមរយៈ លិខិត ផ្លូវការ ជា លាយលក្ខណ៍ អក្សរ កន្លងមក ។
ទាំងនេះ គឺជា លទ្ធផល ដែល កើត ចេញ ពី ធាតុ ចូល ដែល គ្រប់ ភាគី ពាក់ព័ន្ធ បាន ផ្តល់ មក ក្រសួង ដើម្បី ជា មូលដ្ឋាន ឱ្យ ក្រសួង យកមក ពិនិត្យ ពិចារណា ថ្លឹងថ្លែង និង ផ្ទៀត ផ្ទាត់ គ្រប់ ជ្រុងជ្រោយ កែសម្រួល លើ សេចក្តីព្រាង វិសោធនកម្ម នេះ សម្រាប់ ដាក់ ជូន សិក្ខាកាម ទាំងអស់ បាន ពិនិត្យ បន្ថែម នា ពេលនេះ ។
ច្បាប់ ស្តីពី សហជីព គឺជា ក្របខ័ណ្ឌ គតិយុត្ត មួយ ដែល មាន គោលដៅ ១ - ការពារ សិទ្ធិ និង ផលប្រយោជន៍ ស្រប ច្បាប់ របស់ បងប្អូន កម្មករ និយោជិត ២ - ធានា នូវ សិទ្ធិ សេរីភាព ក្នុង ការចរចា ជា សមូហភាព រវាង កម្មករ និយោជិត និង និយោជក ៣ - ជំរុញ ឱ្យ មាន សុខដុមរមនា ក្នុង ទំនាក់ទំនង វិជ្ជាជីវៈ និង ៤ - រួមចំណែក ក្នុង ការអភិវឌ្ឍ ការងារ សមរម្យ បង្កើន ផលិតភាព និង ការវិនិយោគ ៕
អភិបាល ខេត្ត កំពង់ធំ៖ « ទឹក ត្រជាក់ ត្រី កុំ » បើ ក្រុមហ៊ុន ល្អ ទើប កម្មករ - កម្ម ការិនី ស្រលាញ់ និង ខិតខំ ធ្វើ ការងារ ឲ្យ ក្រុមហ៊ុន
លោក សុខ លូ បាន ថ្លែង យ៉ាង ដូចនេះ នា រសៀល ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស ដែល លោក បាន ចុះ ជួប សំណេះសំណាល ជាមួយ បងប្អូន កម្មករ ក្រុមហ៊ុន ចម្ការ កៅស៊ូ តាន់ បៀន និង ប្រជាពលរដ្ឋ រស់ នៅ បរិវេណ ជុំវិញ ចម្ការ កៅស៊ូ របស់ ក្រុមហ៊ុន នេះ ។ ពិធី សំណេះសំណាល នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ខេត្ត អភិបាល រង ខេត្ត ប្រធាន មន្ទីរ / អង្គភាព ពាក់ព័ន្ធ មន្ត្រីរាជការ អាជ្ញាធរដែនដី កម្មករ កម្ម ការិនី និង ប្រជាពលរដ្ឋ ប្រមាណ ជាង ៨០០ នាក់ ។
លោក សុខ លូ ក៏ បាន បាន ស្នើ ឱ្យ ក្រុមហ៊ុន ទាំងអស់ ត្រូវ ខិតខំ គោរព តាម កិច្ចសន្យា ដែល មាន ហើយ ព្រោះ វា ជា ការសំខាន់ ណាស់ មិន អាច ប្រើ តែ កម្មករ ហើយ មិន មាន ផ្ទះ ស្នាក់ នៅ ប្រព័ន្ធ ទឹក ស្អាត សាលារៀន មណ្ឌល សុខភាព សម្រាប់ ពួកគាត់ នោះ ទេ ។
( ពោធិ៍សាត់ )៖ កម្លាំង នគរបាល ក្រុង ពោធិ៍សាត់ សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ ស្វាយ អាត់ និង កម្លាំង ប្រជាការពារ ក្រោម ការដឹកនាំ បញ្ជា ផ្ទាល់ ពី លោក វរសេនីយ៍ ឯក យឹម ស៊ាង ហៃ អធិការ នគរបាល ក្រុង បាន ចុះ ប្រតិបត្តិការ ឃាត់ខ្លួន ជាក់ស្តែង ជនសង្ស័យ ៣នាក់ ពី បទ រក្សាទុក និង ចរាចរណ៍ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង នៅ វេលា ម៉ោង ១១៖ ៤៨ នាទី នៅ ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០១៩ នៅ ចំណុច ភូមិ អូរ ស្តៅ សង្កាត់ ស្វាយ អាត់ ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។
លោក វរសេនីយ៍ ឯក យឹម ស៊ាង ហៃ អធិការ នគរបាល ក្រុង ពោធិ៍សាត់ បាន ឲ្យដឹង ថា ដោយ មាន ការសម្របសម្រួល ពី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត សមត្ថកិច្ច បាន ធ្វើ ការចាប់ខ្លួន ជនសង្ស័យ ចំនួន ៣នាក់ រួម មាន៖
១៖ ឈ្មោះ ឡាច មុន្នី ភេទ ប្រុស អាយុ ២៨ ឆ្នាំ រស់ នៅ ភូមិ បាក់ រទេះ សង្កាត់ ព្រៃ ញី ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។ ២៖ ឈ្មោះ ជា ហូស៊ីម ភេទ ប្រុស អាយុ ២៣ ឆ្នាំ រស់ នៅ ភូមិ បាក់ រទេះ សង្កាត់ ព្រៃ ញី ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។ ៣៖ ឈ្មោះ អ៊ឹម ឆៃលី ភេទ ស្រី អាយុ ៤៩ ឆ្នាំ រស់ នៅ ភូមិ អន្លង់ ហា ប ឃុំ កោះ ជុំ ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ ។
បច្ចុប្បន្ន ជនសង្ស័យ រួមទាំង វត្ថុតាង សមត្ថកិច្ច កំពុង កសាង សំណុំរឿង បញ្ជូន មកកាន់ ការិយាល័យ ជំនាញ ដើម្បី ចាត់ការ បន្ត ទៅ តាម និតិវិធី ច្បាប់ ៕
ការចេញមក ថ្លែងអំណរគុណ របស់ លោក ផៃ ស៊ីផាន បាន ធ្វើឡើង បន្ទាប់ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក បាន ស្វាគមន៍ ចំពោះ ការបកស្រាយ និង អះអាង យ៉ាង ច្បាស់ របស់ កម្ពុជា ថា មិន មាន វត្តមាន មូលដ្ឋាន ទ័ព ចិន នៅ កម្ពុជា នោះ ឡើយ ។
