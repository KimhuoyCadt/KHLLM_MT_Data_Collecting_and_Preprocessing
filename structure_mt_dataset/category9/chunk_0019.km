( កំពង់ចាម ) ៖ ក្មេងស្រី ជំទង់ អាយុ ១៤ ឆ្នាំ ម្នាក់ បាន លង់ទឹក ស្លាប់ យ៉ាង អាណោច អាធម ខណៈ កំពុង មុជទឹក ទន្លេ លេង ជាមួយ មិត្តភក្តិ ៦នាក់ ទៀត ទាំង ដែល រូប គេ មិន ចេះ ហែលទឹក ជា ហេតុ បង្ក នូវ ក្ដី វិប្បយោគ ដល់ ក្រុមគ្រួសារ យ៉ាង សោក សង្រេង ។
តាម សមត្ថកិច្ច មូលដ្ឋាន បាន ឲ្យដឹង ថា ហេតុការណ៍ នេះ បាន កើតឡើង នា រសៀល ថ្ងៃទី ២៧ ខែកក្កដា ឆ្នាំ ២០១៩ នៅ ចំណុច មុខ វត្ត មុនី រង្សី ស្ថិត ក្នុង ភូមិ អូរ រុន ឃុំ ខ្ពប តា ងួន ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម ។
ក្មេងស្រី រងគ្រោះ ខាងលើ នេះ មាន ឈ្មោះ ភាន ហង្ស លី អាយុ ១៤ ឆ្នាំ មាន ទីលំនៅ ភូមិ ដី លើ ឃុំ ពាម កោះ ស្នា ស្រុក ស្ទឹងត្រង់ ។ មុន កើត ហេតុ ក្មេងស្រី រងគ្រោះ និង ក្មេងស្រី ជា មិត្តភក្តិ ចំនួន ៦នាក់ ទៀត បាន នាំគ្នា ទៅ លេង ទឹក ទន្លេ នៅ ចំណុច កើត ហេតុ ខាង លើ តែ ក្មេងស្រី រងគ្រោះ មិន ចេះ ហែលទឹក ទេ ទើប បណ្តាលឱ្យ លង់ទឹក ស្លាប់ យ៉ាង បែប នេះ ទៅ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា ក្រោយពី ពិនិត្យ សាកសព ឃើញ ថា ក្មេងស្រី រងគ្រោះ ពិតជា ស្លាប់ ដោយសារ លង់ទឹកប្រាកដ មែន និង បាន ប្រគល់ សាកសព ឱ្យ ក្រុមគ្រួសារ ដើម្បី យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ៕
អតីត សិស្ស វិទ្យាល័យ ជា ស៊ីម តាកែវ ឆ្នាំ ១៩៨៦ ធ្វើ ពិធី រំលឹក គុណ គ្រូ ព្រមទាំង អភិសេក បដិមា ព្រះបាទ ជ័យ វរ្ម័ន ទី៧ និង ហ្លួង ព្រះស្ដេច កន
( តាកែវ )៖ ក្រុម អតីត សិស្ស វិទ្យាល័យ ជា ស៊ីម តាកែវ ជំនាន់ ឆ្នាំ ១៩៨៦ បាន រៀបចំ ពិធី រំលឹក គុណ គ្រូ ពិធី សម្ពោធ សួនច្បារ និង បង់ អង្គុយ របស់ សិស្ស ព្រមទាំង អភិសេក បដិមា ព្រះបាទ ជ័យ វរ្ម័ន ទី៧ និង បដិមា ហ្លួង ព្រះស្ដេចកន ( ព្រះបាទ ស្រី ជេដ្ឋា ) ផងដែរ នៅ សួនច្បារ នៃ វិទ្យាល័យ ជា ស៊ីម តាកែវ ។
លោក រិន រ៉ាវី តំណាង ឱ្យ ក្រុម សិស្ស ទាំងអស់ បាន ថ្លែង ឱ្យដឹង ថា កាលពី ៣០ ឆ្នាំ មុន ពួកយើង ដែល ជា កូន កសិករ មកពី ស្រុក ទាំង១០ របស់ ខេត្ត តាកែវ មាន គ្នា ជាង ២០០ នាក់ បាន មក បន្ត រៀនសូត្រ ប្រឡង យក សញ្ញាបត្រ មធ្យមសិក្សា កម្រិត ២ ដោយ សិស្ស ខ្លះ ធ្វើ តូប ស្នាក់ នៅ ខ្លះ ទៀត រស់ នៅ មណ្ឌលកុមារ កំព្រា និង ស្នាក់ នៅក្នុង វត្ត អារាម ជាដើម ។
លោក ថា ដោយ មាន ឆន្ទៈ ក្នុង ការចង់ ចេះ ចង់ ដឹង និង ដោយ មាន ការខិតខំ ប្រឹងប្រែង អប់រំ ណែនាំ និង បង្រៀន ពីសំណាក់ លោកគ្រូ អ្នកគ្រូ ផងដែរ បាន ធ្វើឱ្យ សិស្ស ទាំងអស់ បាន ទទួល ជោគជ័យ រហូតដល់ ពេល បច្ចុប្បន្ន នេះ ។
លោក រិន រ៉ាវី បាន បន្ថែម ថា ក្រុម អតីត សិស្ស វិទ្យាល័យ ជា ស៊ីម ជំនាន់ ឆ្នាំ ១៩៨៦ និង បន្ត ជួបជុំ ពិធី រំលឹក គុណ លោកគ្រូ អ្នកគ្រូ តទៅទៀត ហើយក៏ នឹង រៃ អង្គាស ថវិកា ជួយ ជួសជុល កសាង សាលា ។ ម្យ៉ាងទៀត សកម្មភាព នេះ ក៏ ជា គំរូ ដ៏ ល្អ សម្រាប់ សិស្សានុសិស្ស ជំនាន់ ក្រោយ យក តម្រាប់ តាម ផងដែរ ៕ នគរបាល នឹង បញ្ជូន លោក ហង្ស ពេជ្រ ទៅ តុលាការ នៅ រសៀល នេះ ករណី បោះ បង្គោល រំលោភ យក ដី ស្រះ ព្រះទន្លេរ ជាង ៣ហិចតា
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ នគរបាល ព្រហ្មទណ្ឌ នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ នឹង បញ្ជូន បុរស ម្នាក់ ឈ្មោះ ហង្ស ពេជ្រ ទៅកាន់ តុលាការ ពាក់ព័ន្ធ នឹង ករណី បោះ បង្គោល រំលោភ យក ដី ស្រះ ព្រះទន្លេរ វត្ត គោក បញ្ជាន់ ជាង ទំហំ ជិត ៤ហិចតា ។
អំឡុង ពេល សួរចម្លើយ លោក ហង្ស ពេជ្រ បាន ប្រាប់ សមត្ថកិច្ច ថា គាត់ បាន ធ្វើ តាម ការពឹងពាក់ ពី លោក ហេង ចេស្តា ដែល ជា ម្ចាស់ ក្រុមហ៊ុន ហេង ចេស្តា ទើប បើក ថ្មី រយៈពេល ជាង ៦ខែ ដោយ យក លុយ ពី លោក ហេង ចេស្តា ផ្ញើ តាម វីង ចំនួន ៤ម៉ឺន យក ទៅឲ្យ ថ្លៃ បាយ កម្មករ បោះ និង ដាំ បង្គោល នៅ ទីតាំង ស្រះ ព្រះទន្លេរ នោះ តែ ប៉ុណ្ណោះ ។
លោក ហង្ស ពេជ្រ ឲ្យដឹង ទៀត ថា លោក មិន ដែល ស្គាល់ លោក ហេង ចេស្តា ពីមុន មក ទេ ដោយ បាន ស្គាល់ ដោយ ចៃដន្យ នៅ ហាង ហូបចុក មួយ កន្លែង ហើយក៏ បាន មាន ទំនាក់ទនង ស្គាល់ គ្នា បាន រយៈពេល ជាង ១ខែ តែ ប៉ុណោះ ត្រូវបាន លោក ហេង ចេស្តា បាន ពឹងពាក់ រូប លោក ឲ្យ យក លុយ មក ឲ្យ ថ្លៃ បាយ របស់ កម្មករ ដែល កំធ្វើ ការបោះ បង្គោល នៅ ទីតាំង ខាងលើ តែម្តង ។
លោក ហង្ស ពេជ្រ បាន បន្ត ថា ក្នុង នោះ លោក ហេង ចេស្តា បាន ផ្ញើ លុយ តាមរយៈ វីង វេលុយ ចំនួន ៣លើក និង ទទួល ផ្ទាល់ ចំនួន ២ដង ពី លោក សុខ សំអាត អាយុ ៤២ ឆ្នាំ មុខរបរ ជា វិរៈ សេនីយ៍ ត្រី នៅ អង្គភាព អគ្គ បញ្ជាការ អង្គរក្ស យក លុយ មក ឲ្យ រូប លោក ដើម្បីឲ្យ ថ្លៃ បាយ កម្មករ ចំនួន ២លើក ទៀត ផងដែរ ។
ប្រភព មួយ ទៀត បាន លួច បង្ហើប ថា ក្រោយពេល លោក ហង្ស ពេជ្យ ត្រូវ ចាប់ខ្លួន គឺ មាន បុគ្គល ធ្វើ ការអន្តរាគមន៍ យក លុយ ៤០០០ ដុល្លារ ដើម្បី រត់ ការដោះលែង ឲ្យ លោក ហង្ស ពេជ្រ បាន រួច ខ្លួន មាន សេរីភាព ប៉ុន្តែ ការអន្តរាគមន៍ នេះ តាម ប្រភព បាន លួច បង្ហើប ថា គឺ ត្រូវបាន បរាជ័យ ហើយ ។
សូម បញ្ជាក់ ថា ករណី ជន មិន ស្គាល់ មុខ ប្រើ កូន ចៅ ទៅ បោះ បង្គោល របង ព័ទ្ធ យក ដី វត្ត គោក បញ្ជាន់ មាន ទំហំ ជិត ៤ហិកតា មាន តម្លៃ ខ្ទង់ ជិត ២០លាន ដុល្លារ កាលពី ពេល ថ្មី ៗ នេះ ឥឡូវ មន្ត្រី អាជ្ញាធរ បាន ស្គាល់ អត្តសញ្ញាណ ជន ខាងលើ នេះ ហើយ បន្ទាប់ពី ឃាត់ខ្លួន បុរស ម្នាក់ ដែល ជា អ្នក ទៅ ចូលរួម បោះ បង្គោល និង ឈរ ការពារ បង្គោល ដែល ពួកគេ បោះ រំលោភ យក ដី វត្ត តាម បញ្ជា មេ កើយ របស់ គេ រួច មក ។
កាលពី ពេល ថ្មី ៗ នេះ មាន មនុស្ស មួយ ក្រុម មាន គ្នា ជិត ១០នាក់ បាន នាំគ្នា យក បង្គោល ទៅ បោះ រំលោភ យក ដី ស្រះ ទឹក វត្ត គោក បញ្ជាន់ មាន ទំហំ ជាង ៣ហិកតា មាន ទីតាំង ស្ថិត នៅក្នុង សង្កាត់ ចោម ចៅ ទី២ ខណ្ឌ ពោធ៏សែន ជ័យ រាជធានី ភ្នំពេញ ហើយ បោះ ទីតាំង ឈរជើង នៅ ទី នោះ ដើម្បី ការពារ បង្គោល និង ដី ដែល ពួកគេ អះអាង ថា ធ្វើ តាម បញ្ជា មេ របស់ ពួកគេ ។
ក្រោយ មាន ករណី បែប នេះ បាន ធ្វើអោយ អ្នកភូមិ ផ្ទុះ ប្រតិកម្ម ឡើង ហើយ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៩ មន្ត្រី អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ បាន លើក គ្នា ចុះ ទៅដក បង្គោល ស៊ីម៉ង់ត៍ នោះ ចេញ វិញ រួមទាំង ឃាត់ខ្លួន មនុស្ស ចំនួន ២នាក់ យក ទៅ សាកសួរ ផងដែរ តែ ក្រោយមក បុរស ម្នាក់ មិន មាន ពាក់ព័ន្ធ ក៏ ដោះលែង វិញ ដោយ ឃាត់ខ្លួនអ្នក ពាក់ព័ន្ធ ម្នាក់ ឈ្មោះ ហង្ស ពេជ្រ តែ ប៉ុណ្ណោះ ។
( ភ្នំពេញ ) ៖ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ផ្ញើ សារ រំលែក ទុក្ខ ជូន ចំពោះ គ្រួសារ សព របស់ លោកស្រី ស៉ឹង ស៉ី យុត សមាជិក ព្រឹទ្ធសភា និង ជា លេខាធិការ គណៈកម្មការ អប់រំ យុវជន កីឡា វិចិត្រ សិល្បៈ និង ទេសចរណ៍ ដែល បាន ទទួលមរណភាព ក្នុង ជន្មាយុ ៧១ ឆ្នាំ ដោយ រោគា ពាធ ។
លោក អ៉ិត សំហេង បាន ចូលរួម រំលែក នូវ មរណទុក្ខ ដ៏ ក្រៀមក្រំ នេះ ចំពោះ ក្រុមគ្រួសារ ញាតិមិត្ត ទាំងអស់ នៃ សព និង សូម ឧទ្ទិស បួងសួង ដល់ វិញ្ញាណក្ខន្ធ សព លោកស្រី ស៉ឹង ស៉ី យុត ឱ្យ បាន សោយ សុខ ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម បញ្ជាក់ ថា លោកស្រី ស៉ឹង ស៉ី យុត បាន ទទួលមរណភាព ក្នុង ជន្មាយុ ៧១ ឆ្នាំ ដោយ រោគា ពាធ នា វេលា ម៉ោង ១០៖៣០ នាទី ព្រឹក ថ្ងៃសៅរ៍ ទី ២៧ ខែកក្កដា ឆ្នាំ ២០១៩ ។ សព លោកស្រី ត្រូវបាន តម្កល់ ធ្វើ បុណ្យ ទក្ខិណា នុប្បទាន តាម ប្រពៃណី សាសនា នៅ វត្ត បុទុមវតី សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ។ ពិធី បូជា សព នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃច័ន្ទ ទី២៩ ខែកក្កដា ឆ្នាំ ២០១៩ វេលា ម៉ោង ០៨៖៣០ ព្រឹក នៅ ទី វាល មុច វត្ត បុទុមវតី ៕
( សៀមរាប ) ៖ ទេសរដ្ឋមន្រ្តី គន់ គីម អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្ដរាយ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ របស់ គណកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ របស់ ខេត្ត សៀមរាប ។
ក្នុង កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី មន្ត្រីរាជការ តាម មន្ទីរ ស្ថាប័ន ពាក់ព័ន្ធ កម្លាំងប្រដាប់អាវុធ អង្គការ ជា ដៃគូរ និង អាជ្ញាធរ ទូទាំង ខេត្ត ចំនួន ៣៩១ នាក់ ។
តាម របាយការណ៍ របស់ លោក លី សំរិទ្ធ អភិបាល រង ខេត្ត បាន ឲ្យដឹង ថា ខេត្ត សៀមរាប ទទួលរងគ្រោះ រាំងស្ងួត បណ្តាលឲ្យ ប៉ះពាល់ ដល់ ដំណាំ ស្រូវ របស់ ប្រជាពលរដ្ឋ ចំនួន ៤.៥៩២ ហិកតា ក្នុង នោះ ខេត្ត បាន ជួយ សង្រ្គោះ បាន ចំនួន ២.៥៧១ ហិកតា នឹង កំពុង សង្គ្រោះ បន្ត ។ ខ្យល់ កន្រ្តាក់ ប៉ះពាល់ ដល់ លំនៅដ្ឋាន ប្រជាពលរដ្ឋ ៣៤២ ខ្នង . រន្ទៈ បាញ់ ស្លាប់ មនុស្ស ចំនួន ៦នាក់ ។
ប៉ុន្តែ លទ្ធភាព នៃ ការឆ្លេី យតប របស់ ខេត្ត នៅ មាន កម្រិត និង សុំឲ្យ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ជួយ ដេីម្បី ខេត្ត មាន លទ្ធភាព ឆ្លេីយត ប បាន ទាន់ ពេល វេលា ។ ការឆ្លើយតប ទៅ និង គ្រោះមហន្តរាយ កន្លងមក ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ដោយ មាន ការគាំទ្រ ពី គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ សប្បុរសជន នានា ព្រមទាំង មាន កិច្ចសហការ ជាមួយ សាខា កាកបាទ ក្រហម ខេត្ត និង កាកបាទ ក្រហម កម្ពុជា បាន ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ដល់ គ្រួសារ រងគ្រោះ បាន ទាន់ ពេល វេលា ។
អង្គប្រជុំ ក៏ បាន ស្តាប់ នូវ បទបង្ហាញ របស់ បណ្តា នាយកដ្ឋាន ចំណុះ គណកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ( គ.ជ. គ.ម ) ជុំវិញ ការផ្តល់ ព័ត៌មាន ការត្រៀម បង្ការ និង វិធានការ ឆ្លេីយ តប គ្រោះមហន្តរាយ ។
ដេីម្បី ធ្វេី បាន ដូច ខាង លេី ទេសរដ្ឋមន្ដ្រី គន់ គីម បាន ណែនាំ ដល់ គ្រប់ ថ្នាក់ ត្រូវ ពង្រឹង សមត្ថភាព របស់ មន្ត្រី ជំនាញ ដេីម្បី មាន គ្រប់ លក្ខណៈ សម្បត្តិ ក្នុង ការឆ្លេី យតប បាន ទៅ គ្រប់ សភាពការណ៍ ដែល កេីត ឡេីង ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង អនុ រដ្ឋលេខាធិការ និង ទីប្រឹក្សា ក្រសួង ធម្មការ ៥រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី នៃ ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង ធម្មការ និង សាសនា ចំនួន ៤រូប ព្រមទាំង តែងតាំង ទីប្រឹក្សា ដែល មាន ឋានៈ ស្មើ អនុ រដ្ឋលេខាធិការ ចំនួន ១រូប ផងដែរ ។
លោក ហ៊ឹម និមល អ្នកនាំពាក្យ ក្រសួង ធម្មការ បាន ឱ្យដឹង ថា ការតែងតាំង អនុ រដ្ឋលេខាធិការ ក្រសួង នេះ គឺ ដើម្បី បន្ថែម ថ្នាក់ដឹកនាំ ទទួលបន្ទុក ការងារ ធ្វើឱ្យ ប្រសិទ្ធភាព ការងារ កាន់តែ មាន ភាព រលូន ។
លោក បាន បន្ត ថា បូករួម ទាំង ថ្នាក់ដឹកនាំ ដែល ត្រូវបាន តែងតាំង ខាងលើ នេះ ក្រសួង ធម្មការ និង សាសនា មាន រដ្ឋលេខាធិការ ចំនួន ១២រូប ខណៈ អនុ រដ្ឋលេខាធិការ មាន ចំនួន ២០ នាក់ ។
អង្គភាព ប្រឆាំង អំពើពុករលួយ (ACU) បាន ឲ្យដឹង ថា ប្រធាន អនុប្រធាន និង មន្ត្រី មន្ទីរ សុរិយោដី ខេត្ត ពោធិ៍សាត់ ដែល ត្រូវ ចាប់ខ្លួន ៣នាក់ រួម មាន៖
* ទី ១៖ ឈ្មោះ លៀម ប៊ុន រឿន ប្រធាន មន្ទីរ សុរិយោដី ខេត្ត ពោធិ៍សាត់ * ទី ២៖ ឈ្មោះ ជាង វុទ្ធី អនុប្រធាន មន្ទីរ ទទួល ការងារ សំណង់ * ទី ៣៖ ឈ្មោះ តែ ប៊ុន ថេង មន្ត្រី សុរិយោដី ខេត្ត ទទួលបន្ទុក ច្រក ។
ការចាប់ខ្លួន ប្រធាន មន្ទីរ និង អនុប្រធាន បាន ធ្វើឡើង នៅ ភោជនីយដ្ឋាន មហា លាប ក្រុង ពោធិ៍សាត់ នៅ វេលា ម៉ោង ប្រមាណ ៩៖ ៣៥ នាទី ព្រឹក ម្សិលមិញ ទី ដែល លោក និង ម្ចាស់ ដី ជួបគ្នា ដើម្បី ប្រគល់ លុយ និង មន្រ្តី ម្នាក់ ទៀត ចាប់ខ្លួន នៅក្នុង ពេល នោះ តែម្តង ។
ការចាប់ខ្លួន អ្នក ទាំង ៣នេះ ត្រូវបាន មន្រ្តី រាជ រដ្ឋាភិបាល ក៏ ដូចជា មន្រ្តី នៃ ស្ថាប័ន ពាក់ព័ន្ធ បាន លួច បង្ហើប ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News ឲ្យដឹង ថា សង្ស័យ ពាក់ព័ន្ធ ការ ឃុបឃិត គ្នា ប្រព្រឹត្ត អំពើពុករលួយ ទារ លុយ ពី ប្រជាពលរដ្ឋ ជា ម្ចាស់ ដី ដោយ ខុស ច្បាប់ ចំនួន ១០ម៉ឺន ដុល្លារ ជា ថ្នូរ ចេញ ច្បាប់ សាងសង់ ។
១៖ អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ ជាង ៧០ នាក់ ចុះ ពិនិត្យ មូលដ្ឋាន កងទ័ព ជើងទឹក រាម . ឃើញ ថា មិន មាន អ្វី ប្រែប្រួល ដូច សារព័ត៌មាន បរទេស ចុះផ្សាយ ទេ ( ចុច អាន )
២៖ អគ្គ ស្នងការ នគរបាល ជាតិ នឹង ប្រើ គ្រប់ មធ្យោបាយ ដើម្បី តាម ចាប់ខ្លួន ទណ្ឌិត សម រង្ស៊ី និង បក្ខពួក យកមក ផ្តន្ទាទោស តាម ច្បាប់ ( ចុច អាន )
៦៖ លោក ផៃ ស៊ីផាន ច្រានចោល ការបំភ្លៃ ព័ត៌មាន អំពី ការលើក ពេល ប្រជុំ គណៈ រដ្ឋមន្រ្តី ( ចុច អាន )
៧៖ កម្ពុជា ប្រាប់ អាមេរិក កុំ ឲ្យ យក រឿង នយោបាយ មក វាយតម្លៃ ការងារ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស ( ចុច អាន )
៩៖ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ប្រតិកម្ម នឹង ការប្រកាស របស់ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស អំពី សិទ្ធិ មនុស្ស នៅ កម្ពុជា ( ចុច អាន )
១០៖ តុលាការ នឹង បន្ត ជំនុំជម្រះ រឿងក្ដី អតីត បុគ្គលិក វិទ្យ អាស៊ី សេរី ទាំង ពីរ រូប នៅ ថ្ងៃទី ០៩ ខែសីហា ( ចុច អាន )
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង មន្ត្រី ការទូត ជាន់ ខ្ពស់ នៃ ក្រសួង ការបរទេស ៦រូប . លោក កុយ គួង ត្រូវបាន តែងតាំង ជា អនុ រដ្ឋលេខាធិការ
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង មន្ត្រី ការទូត ជាន់ ខ្ពស់ នៃ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ចំនួន ៦រូប ក្នុង នោះ មាន ទាំងអនុ រដ្ឋលេខាធិការ អគ្គ លេខាធិការ អគ្គ នាយក និង ទីប្រឹក្សា ដែល មាន ឋានៈ ស្មើ អគ្គ នាយក ផងដែរ ។
