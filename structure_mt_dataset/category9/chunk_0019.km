( ត្បូងឃ្មុំ ) ៖ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ថ្លែង ថា មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ចិន ត្បូងឃ្មុំ ដែល មាន តម្លៃ ប្រមាណ ៥០ លាន ដុល្លារ នឹង បញ្ចប់ ការសាងសង់ ជា ស្ថានពរ នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២១ ខាងមុខ ។
គម្រោង សាងសង់ នេះ នឹង អនុវត្ដ បញ្ចប់ ទៅ តាម គម្រោង ផែនការ ដែល បាន ចុះ កិច្ចព្រមព្រៀង ជាមួយ កម្ពុជា ។ ជាពិសេស នៅ ថ្ងៃទី ០១ ខែកុម្ភៈ ឆ្នាំ ២០២០ ភាគី ចិន - កម្ពុជា នឹង ធ្វើ ការត្រួតពិនិត្យ ឡើងវិញ នូវ ពាក់កណ្ដាល កិច្ចសន្យា ឬ ពាក់កណ្ដាល នៃ ការសាងសង់ ដើម្បី ដឹង ពី គុណភាព សំណង់ ទាំងនេះ ។
ការថ្លែង បែប នេះ របស់ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ក្នុង ឱកាស ចុះ ទៅ ត្រួតពិនិត្យ ការសាងសង់ មន្ទីរពេទ្យ នេះ . ការចុះ សួរសុខទុក្ខ និង ពិនិត្យ ព្យាបាល ផ្ដល់ ឱសថ និង មុង ជ្រលក់ ថ្នាំ ជូន ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ តាម ទី ទួល មាន សុវត្ថិភាព នៅ ខេត្ដ រតនគីរី នៅ ថ្ងៃទី ១១ - ១២ ខែសីហា ឆ្នាំ ២០១៩ នេះ ។
ក្នុង ឱកាស នោះ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល ចិន ប្រជាជន និង ក្រុមហ៊ុន ចិន ដែល បាន គាំទ្រ លើ ស្ទួយ វិស័យ សុខាភិបាល នៅ កម្ពុជា ។ លោក រដ្ឋមន្ដ្រី បាន បញ្ជាក់ ថា គម្រោង សាងសង់ មន្ទីរពេទ្យ នេះ គឺជា គម្រោង ធំ ទី២ ដែល ជា ជំនួយ ឥត សំណង របស់ រដ្ឋាភិបាល សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល គម្រោង ទី១ គឺ មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ចិន ព្រះកុសុម : ដែល ទើប ធ្វើ ពិធី បញ្ចុះ បឋមសិលា សាងសង់ កាលពី ខែតុលា ឆ្នាំ ២០១៨ កន្លងទៅ ថ្មី ៗ នេះ ។
សូម ជម្រាប ថា មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ចិន ត្បូងឃ្មុំ នេះ បាន សាងសង់ ឡើង នា ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០១៩ និង បញ្ចប់ ទៅ វិញ នៅ ចុង ខែតុលា ឆ្នាំ ២០២១ ដែល សាងសង់ លើ ផ្ទៃដី ទំហំ ២៤.៣០០ ម៉ែត្រ ការ៉េ លើ ទំហំ ផ្ទៃដី សរុប ៥៥.៨១៥ ម៉ែត្រ ការ៉េ ។ គម្រោង នេះ សាងសង់ ក្នុង រយ: ពេល ៤០ ខែ ។
ជាមួយគ្នា នេះ មន្ទីរពេទ្យ ថ្មី នេះ នឹង ក្លាយជា មន្ទីរពេទ្យ ប្រចាំ តំបន់ គ្រប់ ដណ្តប់ ប្រជាជន មួយចំនួន នៃ ខេត្ត ក្រចេះ រតនគិរី ស្ទឹងត្រែង និង មណ្ឌលគិរី ។ មន្ទីរពេទ្យ ធំ ថ្មី នេះ មាន តំរូវការ បុគ្គលិក ជំនាញ ប្រមាណ ៤៥៦ នាក់ បន្ថែម ទៀត ។ គួរ រំលឹក ផងដែរ ថា ខេត្ត ត្បូងឃ្មុំ ជា ខេត្ត ទើប បង្កើត ថ្មី ដោយ កាត់ ចេញ ពី ខេត្ត កំពង់ចាម កាលពី ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០១៣ ដោយ គ្រប់ ហេដ្ឋារចនាសម្ព័ន្ធ ត្រូវបាន បង្កើត ថ្មី ទាំងអស់ ៕
ក្រសួង ការងារ រៀបចំ ការប្រកួតប្រជែង កម្មករ និយោជិត ឆ្នើម ឆ្នាំ ២០១៩. ការទទួល ពាក្យ រហូតដល់ ថ្ងៃទី ១០ ខែតុលា
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ សហការ ជាមួយ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា នឹង រៀបចំ កម្មវិធី ប្រកួតប្រជែង បុគ្គលិក កម្មករ និយោជិត ឆ្នើម ឆ្នាំ ២០១៩ ដើម្បី ជំរុញ ការយល់ដឹង និង លើកកម្ពស់ ផលិតភាព នៅ កម្ពុជា ព្រមទាំង ចូលរួម អបអរ កម្មវិធី ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ ឆ្នាំ ២០១៩ ដែល នឹង ប្រព្រឹត្តទៅ នៅ មជ្ឈមណ្ឌល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ នា ថ្ងៃទី ០២ - ០៣ វិច្ឆិកា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ។
ក្រុមហ៊ុន រោងចក្រ សហគ្រាស ដែល មាន បំណង ចូលរួម សូម បញ្ជូន ឈ្មោះ និង ប្រវត្តិ រូប សង្ខេប របស់ បុគ្គលិក កម្មករ របស់ ខ្លួន មកកាន់ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ឬ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា ដើម្បី ចូលរួម ប្រកួតប្រជែង ដោយ ចាប់ ទទួល ពាក្យ ពី ថ្ងៃទី ០១ ខែសីហា រហូតដល់ ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០១៩ ។
ការប្រកួតប្រជែង បុគ្គលិក កម្មករ និយោជិត ឆ្នើម នេះ មាន មុខតំណែង ចំនួន ៥ប្រភេទ ដូច ជា៖
កម្ពុជា រកឃើញ បេក្ខ នារី ជ័យលាភី ៣រូប ដើម្បី ចូលរួម ការតស៊ូ មតិ ថ្នាក់ តំបន់ របស់ យុវជន អាស៊ាន « ស្តីពី សិទ្ធិ មនុស្ស ឆ្នាំ ២០១៩ » នៅ ប្រទេស ថៃ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា និង តំណាង គណៈ កម្ពុជា ប្រចាំ គណៈកម្មការ អន្តរ រដ្ឋាភិបាល ទទួលបន្ទុក សិទ្ធិ មនុស្ស ( អាយ ឆា - កម្ពុជា ) នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន សហការ គ្នា រៀបចំ « ការស៊ូមតិ ថ្នាក់ ជាតិ របស់ យុវជន ស្តីពី សិទ្ធិ មនុស្ស ឆ្នាំ ២០១៩ » ដោយ រកឃើញ បេក្ខ នារី ជ័យលាភី ៣រូប ដែល នឹង ត្រូវ ចូលរួម ការតស៊ូ មតិ ថ្នាក់ តំបន់ របស់ យុវជន អាស៊ាន « ស្តីពី សិទ្ធិ មនុស្ស ឆ្នាំ ២០១៩ » ទីក្រុង បាងកក ប្រទេស ថៃ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក កែវ រ៉េមី រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ជំរុញ ដល់ បេក្ខ នារី ទាំង ៣រូប ត្រូវ ខិតខំ ហ្វឹកហាត់ យក ចំណេះ ដឹង ផ្សេង ៗ បន្ថែម ទៀត ដើម្បី ដណ្តើមយក ជ័យ ជំនៈ ជូន មាតុភូមិ ឱ្យ បាន ហើយ ត្រូវ តាំងចិត្ត ឱ្យ រឹងមាំ ថា ការចេញ ទៅ ប្រកួត នេះ មិន មែន ដើម្បី ខ្លួន ឯង និង ក្រុមគ្រួសារ នោះ ទេ គឺជា តំណាង ឱ្យ ជាតិ ទាំងមូល ផងដែរ ។
លោក កែវ រ៉េមី បាន បន្ត ថា ទោះបី ការប្រកួតប្រជែង មិន ទទួលបាន ជ័យជំនៈ ក៏ដោយ ក្នុង នាម រដ្ឋាភិបាល និង គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា នឹង បន្ត លើកទឹកចិត្ត ដល់ ក្មួយ ៗ ដែល បាន ខិតខំ ប្រឹងប្រែង អស់ ពី សមត្ថភាព ទាំង កម្លាំង កាយ ប្រាជ្ញា ស្មារតី ។
ទន្ទឹមនឹង នេះ លោកស្រី ហ៊ាន ប៉ូលីណេ តំណាង កម្ពុជា ប្រចាំ អាយ ឆា ( អាយ ឆា - កម្ពុជា ) នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី និង ជា អនុប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ថ្លែង ថា « ការស៊ូមតិ ថ្នាក់ ជាតិ របស់ យុវជន ស្តីពី សិទ្ធិ មនុស្ស ឆ្នាំ ២០១៩ » នឹង ធ្វើ នៅ ថ្ងៃទី ១៨ ដល់ ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៩ ខាងមុខ នេះ លោកស្រី បញ្ជាក់ ថា សម្រាប់ ប្រធានបទ ដែល នឹង ត្រូវ លើក យក ពិភាក្សា នោះ គឺ មិន ទាន់ ដឹង នៅឡើយ ទេ ព្រោះ ភាគី ម្ចាស់ ផ្ទះ តម្រូវឱ្យ បេក្ខជន បេក្ខ នារី ចាប់ ឆ្នោត ។
ដោយឡែក បេក្ខ នារី ទាំង ៣រូប បាន បង្ហាញ ក្តី រំពឹង និង ការប្តេជ្ញាចិត្ត ខ្ពស់ ធ្វើ យ៉ាងណា ប្រឹងប្រែង ឱ្យ អស់ ពី សមត្ថភាព ដើម្បី ដណ្តើម កិត្តិយស ជូន ជាតិ មាតុភូមិ ជាពិសេស លើកឡើង ពី សិទ្ធិ សេរីភាព ការបញ្ចេញមតិ របស់ ប្រជាជន កម្ពុជា ក្រោម ដំបូល នៃ សន្តិភាព បច្ចុប្បន្ន នេះ ប្រាប់ ដល់ យុវជន យុវនារី ដែល បាន ចូលរួម ប្រកួត ជែង នេះ ឱ្យ បាន ដឹង កាន់តែ ច្បាស់ ពី ស្ថានភាព របស់ កម្ពុជា នៅក្នុង វេទិកា នោះ ផងដែរ ។
បេក្ខ នារី ទាំង ៣រូប បាន បន្ត ថា ចូលរួម ការតស៊ូ មតិ ថ្នាក់ តំបន់ របស់ យុវជន អាស៊ាន « ស្តីពី សិទ្ធិ មនុស្ស ឆ្នាំ ២០១៩ » ដែល ធ្វើឡើង នៅ ប្រទេស ថៃ គឺជា កក្តា សំខាន់ មួយ ដែល ធ្វើឱ្យ យុវជន នៅក្នុង តំបន់ អាស៊ាន ទាំងមូល កាន់តែ យល់ដឹង ច្បាស់ ពី បញ្ហា សិទ្ធិ មនុស្ស តាមរយៈ ការជជែក ពិភាក្សា គ្នា នេះ ៕
ក្រសួង ការងារ ព្រមាន ម្ចាស់ សិប្បកម្ម ឥដ្ឋ ទាំងឡាយ ណា ដែល ប្រើ កុមារ ឱ្យ ធ្វើ ការ នឹង ចាត់ វិធានការ តាម ក្រម ព្រហ្មទណ្ឌ ភ្លាម
( ភ្នំពេញ ) ៖ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ បាន ព្រមាន ជាថ្មី ថា បើ មាន ករណី ណាមួយ ប្រើប្រាស់ ពលកម្ម កុមារ ក្រសួង នឹង ធ្វើ ការដាក់កំហិត បើសិនជា កម្រិត ធ្ងន់ធ្ងរ ក្រសួង នឹង ធ្វើ ការពិន័យ យក តែម្តង បើ ករណី គ្រោះថ្នាក់ អាច បាត់បង់ សារ ពាង្គកាយ ឬ ឈានដល់ ការបាត់បង់ អាយុជីវិត ណាមួយ ក្រសួង នឹង ធ្វើ កិច្ចសហការ ជាមួយ អាជ្ញាធរ ដែល ពាក់ព័ន្ធ អនុវត្ត ក្រម ព្រហ្មទណ្ឌ ភ្លាម ។
នេះ ជា ការបញ្ជាក់ របស់ លោក វ៉េង ហៀង អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ ជាតិ ប្រឆាំង ពលកម្ម កុមារ និង ជា ប្រធាន នាយកដ្ឋាន កុមារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្នុង ឱកាស ដែល លោក ដឹកនាំ ក្រុម អធិការ របស់ ក្រសួង ការងារ ចុះ ទៅដល់ កន្លែង សិប្បកម្ម ផលិត ឥដ្ឋ ដោយ ផ្ទាល់ ស្ថិត នៅ តាម បណ្តាយ ផ្លូវ ជាតិ លេខ ៦អា សង្កាត់ បាក់ខែង ខណ្ឌ ជ្រោយ ចង្វា នា ព្រឹក ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០១៩ ។
លោក បាន លើកឡើង ថា យុទ្ធនាការចុះ ផ្សព្វផ្សាយ ការលុបបំបាត់ ពលកម្ម កុមារ នៅក្នុង វិស័យ ផលិត ឥដ្ឋ នេះ គឺជា ប្រសិទ្ធភាព ធំធេង មួយ នៅក្នុង វិធានការណ៍ ទប់ស្កាត់ និង ការផ្លាស់ប្តូរ ឥរិយាបថ របស់ កម្មករ និយោជិត និយោជក ព្រមទាំង សហគមន៍ ដើម្បី ធានា ថា កុមារ ទាំងអស់ បាន ទទួល ការការពារ ហើយ កុមារ ដែល មាន អាយុ ពេញ វ័យ ទទួលបាន ការងារ សមរម្យ មិន ប្រកបដោយ គ្រោះថ្នាក់ ។
លោក ថា « អ្វី ដែល យើង រំពឹងទុក ក្នុង កម្រិត ប្រសិទ្ធភាព បែប នេះ គឺ កម្មករ និយោជិត និយោជក ទាំងអស់ គ្នា មាន ការយល់ដឹង ពី ការប្រើប្រាស់ ពលកម្ម កុមារ ការទប់ស្កាត់ កុមារ មិន ឱ្យ ចូល ទៅក្នុង សិប្បកម្ម ផលិត ឥដ្ឋ និង ការសហការ ល្អ ជាមួយ ស្ថាប័ន ដើម្បីឱ្យ កុមារ ទទួលបាន ការរៀនសូត្រ និង ទទួលបាន ការបណ្តុះបណ្តាល ជំនាញ ដែល ជា អនាគត ក្នុង ការចូលរួមចំណែក នៅក្នុង ការប្រកួត ប្រជែង សេដ្ឋកិច្ច នៅ កម្ពុជា » ។
លោក វ៉េង ហៀង បាន បញ្ជាក់ ថា យុទ្ធនាការ នេះ គឺ ក្រុម អធិការកិច្ច ចុះ ជាច្រើន លើក ច្រើន សារ មកហើយ ប៉ុន្តែ បើ នៅក្នុង កម្រិត ថ្នាក់ ជាតិ ក្រុមការងារ ចុះ បាន ចំនួន ៤លើក លើក ទី មួយ នៅ ឆ្នាំ ២០០៨ លើក ពីរ នៅក្នុង ឆ្នាំ ២០១៦ លើក ទី បី នៅ ឆ្នាំ ២០១៩ និង យុទ្ធនាការ នេះ នឹង បន្ត នៅ ឆ្នាំ ២០២០ទៀត ដើម្បី ជំរុញ ការធានា និង ការទប់ស្កាត់ ពលកម្ម កុមារ នេះ ក្នុង កម្រិត មួយ នៅក្នុង គ្រោះថ្នាក់ សឹងតែ គ្មាន ឬ អាច និយាយ បាន ថា គ្មាន ពលកម្ម កុមារ នៅក្នុង សិប្បកម្ម ផលិត ឥដ្ឋ នោះ ឡើយ ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន អគ្គ លេខាធិការដ្ឋាន ទទួលបន្ទុក កិច្ចការពារ ស៊ីវិល ក្រិក បាន បញ្ជាក់ ថា ក្រុម ពន្លត់ អគ្គិសនី ចំនួន ១៣៣ នាក់ និង យានយន្ដ ពន្លត់ អគ្គីភ័យ ៤២ គ្រឿង ត្រូវបាន បញ្ជូន ទៅកាន់ តំបន់ កំពុង រង ការគំរាមកំហែង ដោយសារ ភ្លើង ឆេះ ព្រៃ ហើយ ដើម្បី ពន្លត់ និង ទប់ស្កាត់ កុំ ឱ្យ អណ្ដាត ភ្លើង រីករាលដាល ទៅកាន់ តំបន់ ក្បែរខាង ។
គួរ ជម្រាប ថា កាលពី ថ្ងៃសៅរ៍ អាជ្ញាធរ ក្រិក បាន ប្រកាស អាសន្ន នៃ ភ្លៀង ធ្លាក់ ដល់ កម្រិត ពណ៌ ក្រហម ដោយសារតែ រលក កម្ដៅ កើន ដល់ ៤០ អង្សា សេ ជាមួយ ខ្យល់ បក់ ខ្លាំង ។ ប៉ុន្តែ ទោះបីជា មាន ការវិធានការ បង្ការ ក៏ដោយ ក៏ ភ្លើង ឆេះ ព្រៃ ៥៩ កន្លែង នៅ កើតឡើង ដដែល កាលពី ថ្ងៃសៅរ៍ និង ៦៣ កន្លែង បន្ថែម ទៀត កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ ។
ភ្លើង ឆេះ ព្រៃ កាលពី ខែកក្កដា ឆ្នាំ ២០១៨ នៅឯ ភូមិ ម៉ាទី (Mati) ក្បែរដ្ឋធានី អាតែ ន ប្រទេស ក្រិក បាន ផ្ដាច់ ជីវិត មនុស្ស ១០០ នាក់ ។ ក្រៅពី ប្រទេស ក្រិក ប្រទេស ផ្សេង ៗ ទៀត នៅ អឺរ៉ុប ដូចជា អ៊ីតាលី អេស្ប៉ាញ អង់គ្លេស និង ជាពិសេស នោះ គឺ បារាំង តែម្តង បាន និង កំពុង ទទួលរង រលក កម្តៅ ដ៏ អាក្រក់ ជា កំណត់ត្រា ថ្មី ក្នុង ប្រវត្តិសាស្ត្រ របស់ ទ្វីប អឺរ៉ុប តែម្តង ។
ស្នងការ ខេត្ត កំពង់ចាម ប្រជុំ ត្រៀម និង បែងចែក ភារកិច្ច សម្រាប់ ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ការប្រឡង បាក់ឌុប
( កំពង់ចាម ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ត្រៀម និង បែងចែក ភារកិច្ច ក្នុង ផែនការ ការពារ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ក្នុង កម្មវិធី ប្រឡង សញ្ញាប័ត្រ មធ្យមសិក្សា ទុតិយភូមិ ( បាក់ឌុប ) និង ប្រជុំ ពង្រឹង លើ ការងារ ជំនាញ និង ទិសដៅ អនុវត្ត បន្ត ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី លោក លោកស្រី ស្នងការ រង លោក លោកស្រី នាយ ការិយាល័យ លោក អធិការ នគរបាល ស្រុក - ក្រុង ទាំង១០ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ណែនាំ ដល់ កម្លាំង នគរបាល ទាំងអស់ ត្រូវ ធ្វើ យ៉ាងណា រក្សា សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សម័យ ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ នេះ ឲ្យបាន ជោគជ័យ ស្រប តាម ការណែនាំ របស់ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ។
គួរ ជម្រាប ថា អគ្គ ស្នងការ នគរបាល ជាតិ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន បញ្ជាក់ ទៀត ថា សម្រាប់ ការការពារ សុវត្ថិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ សម័យ ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ នេះ អាជ្ញាធរ នឹង ប្រើប្រាស់ តែ កងកម្លាំង នគរបាល ជាតិ និង កងរាជអាវុធហត្ថ រីឯ កម្លាំង យោធា គ្រាន់តែ ត្រៀម សម្រាប់ អន្តរាគមន៍ ក្នុង ករណី មាន បញ្ហា ចាំបាច់ កើតឡើង ។
នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បន្ត ថា ស្នងការ រាជធានី - ខេត្ត ដែល មាន ក្រុមហ៊ុន សន្តិសុខ ឯកជន ត្រូវ រៀបចំ កម្លាំង សន្តិសុខ ឯកជន និង ប្រជាការពារ ដើម្បី ជា កម្លាំង ជំនួយ ផងដែរ ក្នុង ករណី កម្លាំង មិន គ្រប់គ្រាន់ ហើយ សម្រាប់ កិច្ចការពារ នេះ កម្លាំង សមត្ថកិច្ច ទាំងអស់ មាន ភារកិច្ចការពារ តែ នៅ ខាងក្រៅ បរិវេណ មណ្ឌល ប្រឡង តែ ប៉ុណ្ណោះ ប៉ុន្តែ កម្លាំង អាច ចូលក្នុង បរិវេណ មណ្ឌល ប្រឡង បាន នោះ លុះត្រា មាន ការហៅ ជួយ អន្តរាគមន៍ ពី ប្រធាន មណ្ឌល ក្នុង ករណី មាន ការចាំបាច់ ៕
អភិបាល ខេត្ត កំពង់ចាម ដឹកនាំ គ្រូពេទ្យ ចាក់ ថ្នាំ វ៉ាក់សាំង ការពារ ជំងឺ លើ គោ ក្របី
( កំពង់ចាម ) ៖ នៅក្នុង ពិធី ចាក់ ថ្នាំ វ៉ាក់សាំង សត្វ គោ ក្របី ដើម្បី ការពារ ពី ជំងឺ ផ្សេង ៗ នៅ ព្រឹក ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ភូមិ ទី ៣ ឃុំ កោះ សំរោង ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន ថ្លែង ថា បើ ទោះជា សម័យ បច្ចុប្បន្ន នេះ សំបូរ ទៅ ដោយ គ្រឿងចក្រ ផ្សេង ៗ ច្រើន ក៏ដោយ ប៉ុន្តែ សត្វ គោ ក្របី នៅតែ ជា កម្លាំង អូសទាញ យ៉ាង សំខាន់ សម្រាប់ ប្រជាកសិករ ប្រកប មុខរបរ កសិកម្ម នៅក្នុង ខេត្ត កំពង់ចាម ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង បន្ត ថា ដោយសារតែ សត្វ គោ ក្របី នៅតែ មាន សារៈសំខាន់ សម្រាប់ ប្រកប មុខរបរ កសិកម្ម របស់ បងប្អូន ប្រជាពលរដ្ឋ ទើប អាជ្ញាធរ ខេត្ត កំពង់ចាម រួម ជាមួយ មន្ទីរ កសិកម្ម ខេត្ត កំពង់ចាម និង មន្ត្រី ជំនាញ ពេទ្យ សត្វ បាន រៀបចំ ពិធី នេះ ឡើង ដើម្បី ការពារ និង លើក គុណភាព សុខភាព ជីវិត របស់ សត្វ ។
លោក អភិបាល ខេត្ត កំពង់ចាម បាន ឱ្យដឹង ទៀត ថា នៅ ទូទាំង ខេត្ត កំពង់ចាម នេះ មាន សត្វ គោ ក្របី ប្រមាណ ជាជាង ២៣ម៉ឺន ក្បាល ដែល ត្រូវ ចាក់ ថ្នាំ វ៉ាក់សាំង បង្ការ ជំងឺ ហើយ យុទ្ធនាការ នេះ ដែរ នឹង ធ្វើជា បន្តបន្ទាប់ ទៅ តាម ខ្នង ផ្ទះ របស់ ប្រជាពលរដ្ឋ តាម ដំណាក់កាល នីមួយ ៗ ។ ថ្នាំ វ៉ាក់សាំង បង្ការ ជំងឺ សត្វ គោ ក្របី នេះ មិន មែន ការពារ សម្រាប់ តែ ជំងឺ សារ ទឹក នោះ ទេ គឺ អាច ការពារ ដូចជា ជំងឺ អុត ក្តាម និង ជំងឺ បូស ខ្យល់ ក៏ ដូចជា ជម្ងឺ ផ្សេង ៗ ទៀត ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព សត្វ គោ ក្របី របស់ ប្រជាកសិករ ។
លោក អភិបាល ខេត្ត កំពង់ចាម បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ប្រសិនបើ មាន សត្វ គោ ក្របី កើត ជំងឺ សូម ប្រញាប់ រាយការណ៍ ទៅ អាជ្ញាធរ ភូមិ ឃុំ ឲ្យ បាន ឆាប់ រហ័ស ដើម្បី មាន ព័ត៌មាន ដល់ មន្ត្រី ជំនាញ ពេទ្យ សត្វ ចុះ មក ចាក់ ថ្នាំ ជួយសង្គ្រោះ សត្វ គោ ក្របី ឲ្យបាន ទាន់ ពេលវេលា ផងដែរ ៕ ក្រុមហ៊ុន ចិន មួយ ចង់ វិនិយោគ លើ ប្រពន្ធ លូ ទឹកភ្លៀង និង លូ ទឹក កខ្វក់ នៅ ក្រុង ព្រះសីហនុ . លោក គួច ចំរើន ស្វាគមន៍ តែ ក្រុមហ៊ុន ត្រូវ មាន ផែនការ និង គម្រោង ប្លង់ គោល ច្បាស់លាស់
លោក Lu Guo Bing អគ្គ នាយក ក្រុមហ៊ុន Yunnan ចិន បាន លើកឡើង ថា ក្រុមហ៊ុន មាន គោលបំណង វិនិយោគ លើ ប្រពន្ធ លូ ទឹកភ្លៀង និង លូ ទឹក កខ្វក់ ក្នុង ក្រុង ព្រះសីហនុ ស្រប ពេល ដែល ខេត្ត ព្រះសីហនុ កំពុង មាន ការអភិវឌ្ឍ យ៉ាង ឆាប់រហ័ស នា ពេល បច្ចុប្បន្ន ទាមទារ នូវ ហេដ្ឋារចនាសម្ពន្ធ ជាច្រើន ពិសេស ប្រពន្ធ លូ ទឹកភ្លៀង និង លូ ទឹក កខ្វក់ ដើម្បី លើកកម្ពស់ សោភណ័ បរិស្ថាន ទីក្រុង ពាណិជ្ជកម្ម ឧស្សាហកម្ម កសិកម្ម និង ទេសចរណ៍ ។
( កំពង់ធំ )៖ ថ្លែង ក្នុង ពិធី អបអរសាទរ ខួប លើក ទី២០ នៃ ទិវា អន្តរជាតិ សម្រាប់ យុវជន ១២ សីហា ឆ្នាំ ២០១៩ ក្រោម ប្រធានបទ « ការអប់រំ ដែល នាំឲ្យ មាន ការផ្លាស់ប្ដូរ » នៅ ព្រឹក ថ្ងៃទី ១២ សីហា ឆ្នាំ ២០១៩ នេះ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន លើកឡើង ថា ការអប់រំ គឺ ឲ្យ មាន ការផ្លាស់ប្ដូរ មាន ការ ពង្រឹង សមត្ថភាព ដើម្បីឲ្យ ក្លាយ ខ្លួន ជា ទំពាំង ស្នង ឬស្សី ល្អ ក្នុង ការគ្រប់គ្រង ប្រទេសជាតិ ។
លោក សុខ លូ បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « ការអប់រំ គឺ ឲ្យ មាន ការផ្លាស់ប្ដូរ ពិនិត្យ ដោយ មាន ការ ពង្រឹង សមត្ថភាព ដើម្បីឲ្យ ក្លាយ ខ្លួន ជា ទំពាំង ស្នង ឬស្សី ល្អ ក្នុង ការគ្រប់គ្រង ប្រទេសជាតិ » ។
ជា ចុងក្រោយ លោក បាន ជំរុញ ដល់ យុវជន ត្រូវ ខិតខំ ប្រឹងប្រែង រៀនសូត្រ ស្ដាប់ លោកគ្រូ អ្នកគ្រូ ឪពុក ម្ដាយ អាណាព្យាបាល ចាស់ ព្រឹទ្ធាចារ្យ នឹង ចៀស ឆ្ងាយ ពី គ្រឿងញៀន ព្រមទាំង ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ដើម្បីឲ្យ ប្រទេសជាតិ ចៀស ផុត ពី ការបាត់បង់ជីវិត ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ ។
រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ឧស្សហកម្ម និង ថាមពល កូរ៉េ ខាងត្បូង លោក ស៊ុង យុន ម៉ូ (Sung Yun-mo) ក៏ បាន បញ្ជាក់ ឱ្យដឹង ដែរ ថា ការចាត់ វិធានការ ខាងលើ គ្រោង នឹង ត្រូវ ចូល ជាធរមាន នៅ ខែកញ្ញា ខាងមុខ ជា ការឆ្លើយតប ទៅនឹង ជប៉ុន ដែល បាន ប្រកាស ដក ទីក្រុង សេអ៊ូល ចេញ ពី បញ្ជី ស និង រឹតត្បិត លើ ការនាំចេញ វត្ថុធាតុ ដើម សំខាន់ ៗ ដល់ ក្រុមហ៊ុន បច្ចេកវិទ្យា កូរ៉េ ខាងត្បូង នោះ តែម្តង ។
ក្រុមការងារ នេះ ត្រូវបាន បង្កើតឡើង ដោយ មាន សមាសភាព ចូលរួម ពីសំណាក់ ក្រុម មេធាវី និង អ្នក ច្បាប់ ដែល ជា អនុប្រធាន សមាជិក សមាជិកា នៃ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា រួមទាំង អ្នក ច្បាប់ និង មេធាវី ស្ម័គ្រចិត្ត មួយចំនួន ទៀត ដែល មាន តួនាទី ភារកិច្ច ដូច ខាងក្រោម៖
* ផ្តល់ យោបល់ ផ្នែក ច្បាប់ លើ ការរៀបចំ បទដ្ឋាន គតិយុត្ត ផ្សេង ៗ ដល់ ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បីឱ្យ ស្រប តាម បទដ្ឋាន សិទ្ធិ មនុស្សជាតិ និង អន្តរជាតិ
* ផ្តល់ ប្រឹក្សា ផ្នែក ច្បាប់ ដល់ ជន ក្រីក្រ ដែល ពុំ មាន លទ្ធភាព ពាក់ព័ន្ធ នឹង ការរំលោភ សិទ្ធិ
បន្ថែម ពី ខាងលើ នេះ ក្នុង ចំណោម ជនរងគ្រោះ ទាំង ០៦ នាក់ ខាងលើ គេ ឃើញ មាន បុរស អាយុ ២៥ ឆ្នាំ ម្នាក់ និង ស្រី្ត ០៥ នាក់ ដែល មាន អាយុ ចន្លោះ ពី ២៧ - ៣៧ ឆ្នាំ ពួកគេ បាន រងរបួស ធ្ងន់ ខណៈ ទាំង ០៦ នាក់ នេះ ត្រួវ បាន បញ្ជូន ទៅ ព្យាបាល មន្ទីរពេទ្យ មួយ ក្នុង តំបន់ ប៉ុន្តែ ពួកគេ ទំនងជា មិន អាច មាន បញ្ហា ដល់ អាយុជីវិត ឡើយ ។
គួរ បញ្ជាក់ ថា ទីក្រុង ឈីកាហ្គោ នេះ ក៏ ធ្លាប់ បាន ពើបប្រទះ នឹង ការបាញ់ប្រហារ ដ៏ អាក្រក់ បំផុត មួយ កាលពី ចុង សប្តាហ៍ មុន ផងដែរ ដែល បាន បណ្តាលឲ្យ មនុស្ស ស្លាប់ ០៧ នាក់ និង ៥២ នាក់ ផ្សេង ទៀត បាន រងរបួស ។ ករណី បាញ់ប្រហារ នៅ សហរដ្ឋ អាមេរិក នា មួយ រយៈពេល ចុងក្រោយ នេះ បាន បង្ក ជា បញ្ហា ព្រួយបារម្ភ កាន់តែ ខ្លាំង ពី ក្នុង សង្គម អាមេរិក ជាពិសេស សម្ពាធ ត្រូវ ធ្លាក់ លើ រដ្ឋបាល លោក ដូណាល់ ត្រាំ ជាពិសេស ក្រោយ ករណី បាញ់ប្រហារ កាលពី សប្តាហ៍ មុន ដែល បាន ផ្តាច់ ជីវិត មនុស្ស ជាង ៣០ នាក់ ៕
ក្រសួង ទេសចរណ៍ និង ភាគី ចិន រួមគ្នា បណ្ដុះបណ្ដាល សិក្ខាកាម បន្ថែម ផ្តោត លើ ការប្រើ បច្ចេកវិទ្យា ឌីជីថល ក្នុង វិស័យ ទេសចរណ៍
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ហៃ ណាន នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន បើក វគ្គ បណ្ដុះបណ្ដាល ស្តីពី ការអភិវឌ្ឍ និង ការគ្រប់គ្រង ឧស្សាហកម្ម ទេសចរណ៍ កម្ពុជា ឆ្ពោះទៅ ឧស្សាហកម្ម ៤.០ ដើម្បី រួមចំណែក បំពេញ តម្រូវ ធនធាន មនុស្ស ក្នុង វិស័យ ទេសចរណ៍ ធ្វើ យ៉ាងណា ឱ្យ ពួកគេ ទទួលបាន នូវ ចំណេះដឹង ពាក់ព័ន្ធ នឹង ការរីកចម្រើន នៃ បច្ចេកវិទ្យា ឌីជីថល នេះ ។
លោក ហ័ង បាន ឱ្យដឹង ថា ការពង្រឹង និង អភិវឌ្ឍន៍ សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស កំពុង អភិវឌ្ឍន៍ គឺជា ទស្សនៈ មូលដ្ឋាន នៃ គោល នយោបាយ ការបរទេស របស់ រដ្ឋាភិបាល ចិន ក្នុង នោះ ការផ្ដល់ ជំនួយ លើ ការបណ្តុះបណ្តាល ក៏ ជា ខ្លឹមសារ សំខាន់ របស់ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ហៃ ណាន ផងដែរ ដែល ស្រប ទៅនឹង យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ « ខ្សែក្រវាត់ និង ផ្លូវ » របស់ រដ្ឋាភិបាល ចិន ។
លោក បាន លើកឡើង ថា « លក្ខណៈ នៃ ការអភិវឌ្ឍ ឧស្សាហកម្ម ទេសចរណ៍ ក្នុង បរិបទឧស្សាហកម្ម ៤.០ នឹង ត្រូវ យកមក បង្រៀន ដល់ សិក្ខាកាម កម្ពុជា ដោយ ផ្អែក លើ មូលដ្ឋាន នៃ បណ្តាញ ទិន្នន័យ ធំ ៗ និង ការប្រើប្រាស់ បច្ចេកវិទ្យា បញ្ញា សិប្បនិម្មិត និង ពាណិជ្ជកម្ម អេឡិចត្រូនិច ដែល ជា បច្ចេកវិទ្យា ស្នូល ក្នុង ការគ្រប់គ្រង សេវាកម្ម ទេសចរណ៍ » ។
លោក ហោ មុនីរ័ត្ន បាន រំលឹក ថា កាលពី ឆ្នាំ ២០១៨ ភាគី កម្ពុជា - ចិន បាន សហការ រៀបចំ វគ្គ បណ្តុះបណ្តាល សម្រាប់ ការអភិវឌ្ឍ ឧស្សាហកម្ម ទេសចរណ៍ កម្ពុជា នៅ ខេត្ត ព្រះសីហនុ ម្ដង រួច មកហើយ ដោយ មាន សិក្ខាកាម ចូលរួម ចំនួន ៥០នាក់ មកពី ស្ថាប័ន រដ្ឋ និង ឯកជន ។
លោក ថា នា ឆ្នាំ ២០១៨ កម្ពុជា ទទួលបាន ទេសចរ អន្តរជាតិ ជាង ៦.២លាន នាក់ កើនឡើង ១០.៧% និង នាំមក នូវ ប្រាក់ ចំណូល ប្រមាណ ៤.៣៥៦ លាន ដុល្លារ ។ នៅ ឆ្នាំ ២០១៩ កម្ពុជា រំពឹង ថា នឹង ទទួល ភ្ញៀវ ទេសចរ អន្តរជាតិ ប្រមាណ ៦.៧លាន នាក់ ហើយ នៅ ឆ្នាំ ២០២០ ប្រមាណ ជាង ៧លាន នាក់ ។
( រតនគិរី ) ៖ លោកស្រី វេជ្ជបណ្ឌិត អ៊ឹង កន្ថា ផាវី រដ្ឋមន្ត្រី ក្រសួង កិច្ចការ នារី នៅ ព្រឹក ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពីធី ប្រកាស ចូលកាន់ តំណែង ប្រធាន មន្ទីរ កិច្ចការ នារី ខេត្ត រតនគិរី ថ្មី ដោយ លោកស្រី វ៉ាត់ អៀង ហេង ត្រូវ ចូលកាន់ តំណែង ជា ប្រធាន មន្ទីរ កិច្ចការ នារី ជំនួស លោកស្រី ចក់ មើល ដែល ត្រូវ ទៅកាន់ ដំណែង ជា សមាជិក ក្រុមប្រឹក្សា ខេត្ត រតនគិរី វិញ ។
ពី ធី នេះ ក៏ មាន ការចូលរួម ពី លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី . លោក ណាប់ ប៊ុន ហេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត រតនគិរី រួមទាំង មាន ការចូលរួម ពី លោក លោកស្រី ថ្នាក់ដឹកនាំ ក្រសួង កិច្ចការ នារី លោកស្រី អភិបាល រង ខេត្ត លោក លោកស្រី នាយក រង រដ្ឋបាល សាលា ខេត្ត តំណាង សាលាដំបូង ខេត្ត តំណាង ព្រះរាជអាជ្ញា ខេត្ត លោក មេបញ្ជាការ កងកម្លាំងប្រដាប់អាវុធ ទាំង បី អភិបាល ក្រុង អភិបាល ស្រុក ប្រធាន មន្ទីរ - អង្គភាព នានា ជុំវិញ ខេត្ត ជាច្រើន រូប ផងដែរ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក អ៊ុក គឹម លេខ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ បាន លើកឡើង ថា បន្ទាប់ពី ការស្រាវជ្រាវ និង សិក្សា ដោយ មន្ដ្រី ជំនាញ ផ្នែក បង្ការ និង ពន្លត់ អគ្គិភ័យ បាន រកឃើញ ថា អគារ ខ្ពស់ ៗ មួយចំនួន ដែល កំពុង សាងសង់ និង ដំណើរការ នៅក្នុង ប្រទេស កម្ពុជា មិន មាន ច្រក សុវត្ថិភាព សម្រាប់ គេចខ្លួន នៅពេល មាន គ្រោះ អគ្គិភ័យ កើតឡើង នោះ ឡើយ ។
លោក អ៊ុក គឹម លេខ បាន គូសបញ្ជាក់ ថា ក្រៅពី ច្រក សម្រាប់ គេចខ្លួន នៅពេល មាន គ្រោះ អគ្គិភ័យ កើតឡើង គ្រប់ អគារ ទាំងអស់ នោះ ក៏ ត្រូវតែ បំពាក់ សម្ភារ សម្រាប់ បង្ការ និង ពន្លត់ អគ្គិភ័យ ដោយ ខ្លួន ឯង ផងដែរ ដើម្បី ងាយស្រួល ក្នុង ការអន្ដរាគមន៍ នៅពេល មាន គ្រោះថ្នាក់ កើតឡើង ជា យថាហេតុ ។ លើស ពី នេះ គ្រប់ អគារ ទាំងអស់ ក៏ ត្រូវតែ បំពាក់ នូវ ស៊ីរ៉ែន ប្រកាស អាសន្ន ដើម្បី ផ្ដល់ ដំណឹង ដល់ អ្នក នៅ ខាងក្នុង អគារ បាន ដឹង នៅពេល មាន ហេតុការណ៍ កើតឡើង ។
ឆ្លើយតប ទៅនឹង បញ្ហា នេះ មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ដែល ទទួលបន្ទុក លើ ការងារ សុវត្ថិភាព អគ្គិភ័យ រូប នេះ ក៏ បាន បង្ហាញ នូវ វិធានការ ចំពោះ មុខ ចំនួន ៣ចំណុច ផងដែរ សម្រាប់ ម្ចាស់ ទីតាំង អគារ ផ្សេង ៗ ត្រូវតែ អនុវ ត្ត៖
ទី១៖ ដើម្បី បង្ការ គ្រោះថ្នាក់ អគ្គិភ័យ៖ ការសាងសង់ អគារ ត្រូវតែ គោរព បទដ្ឋាន បច្ចេកទេស របស់ អគ្គិភ័យ មាន ន័យ ថា នៅពេល សាងសង់ ត្រូវ បំពាក់ សម្ភារ ទាំងឡាយ ដែល អ្នកជំនាញ អគ្គិភ័យ បាន កំណត់ ។
ទី២៖ សម្រាប់ ប្រតិបត្តិការ សង្គ្រោះ៖ អគារ ខ្ពស់ ត្រូវតែ មាន ច្រក សម្រាប់ គេចខ្លួន នៅពេល មាន គ្រោះ អគ្គិភ័យ កើតឡើង ខណៈ មកទល់ ពេលនេះ អគារ ខ្ពស់ ៗ មួយចំនួន មិន ទាន់ មាន ច្រកសង្គ្រោះ នេះ ទេ ហើយ ស៊ីរ៉ែន ប្រកាស អាសន្ន ក៏ មិន ទាន់ បំពាក់ ដែល ជា ហេតុ នាំឲ្យ អ្នក នៅ ខាងក្នុង អគារ មិន ដឹង នៅពេល មាន គ្រោះថ្នាក់ កើតឡើង ។
ទី៣៖ ការត បណ្ដាញ អគ្គិសនី ត្រូវតែ រក អ្នក ដែល មាន ជំនាញ ច្បាស់លាស់ លើ បញ្ហា នេះ ដើម្បី ជៀសវាង មាន គ្រោះថ្នាក់ អគ្គិភ័យ កើតឡើង ដោយសារ ការ ឆ្លង ចរន្ដ អគ្គិសនី ។ ប្រសិនបើ ក្រសួង រកឃើញ ថា អ្នក ដែល ត បណ្ដាញ ទាំងអស់ នោះ មិន មាន ជំនាញ ច្បាស់លាស់ ហើយ ពេល មាន គ្រោះថ្នាក់ កើតឡើង បុគ្គលិក នឹង ត្រូវ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ជាធរមាន ។
លោក អ៊ុក គឹម លេខ បាន សង្កត់ធ្ងន់ ទៀត ថា រាល់ ម្ចាស់ ទីតាំង អគារ ទាំងឡាយ ណា មិន គោរព ទៅ តាម បទដ្ឋាន ដែល បាន ដាក់ចេញ ដោយ ក្រសួង មហាផ្ទៃ ក៏ ដូចជា អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ម្ចាស់ ទីតាំង អស់ នោះ នឹង ត្រូវ ប្រឈមមុខ ជាមួយ ការទទួលខុសត្រូវ ដែល កំណត់ ដោយ ច្បាប់ ។
យ៉ាងណា ក៏ដោយ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ រូប នេះ ក៏ បាន លើកឡើង អំពី បញ្ហា ប្រឈម មួយ ចំនួន ផងដែរ សម្រាប់ ក្រុម ប្រតិបត្តិការ បង្ការ និង ពន្លត់ អគ្គិភ័យ នៅក្នុង ប្រទេស កម្ពុជា ដោយ ហេតុ ថា បច្ចុប្បន្ន អគារ ខ្ពស់ មាន ការកើនឡើង យ៉ាង ច្រើន គួរឲ្យ កត់សម្គាល់ និង ឆាប់រហ័ស ខណៈ ដែល សម្ភារ សម្រាប់ សង្គ្រោះ របស់ សមត្ថកិច្ច នៅ មាន កម្រិត នៅឡើយ ដូច្នេះហើយ ទើប តម្រូវឲ្យ ម្ចាស់ អគារ ត្រូវតែ គោរព ទៅ តាម បទដ្ឋាន នៅពេល សាងសង់ ។
គួរ ជម្រាប ថា យោង តាម របាយការណ៍ របស់ លោក ឧត្តមសេនីយ៍ ឯក សេក ភូមី អគ្គ ស្នងការ រង នគរបាល ជាតិ បាន ឲ្យដឹង ថា ឆមាស ទី១ ឆ្នាំ ២០១៩ គ្រោះ អគ្គិភ័យ បាន កើតឡើង នៅ ទូទាំង ប្រទេស ចំនួន ៤២៩ លើក / ៣៥១ លើក បើ ធៀប នឹង រយៈពេល ដូចគ្នា ឆ្នាំ ២០១៨ មាន ការកើនឡើង ៧៨ លើក ។
រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ បើក វេទិការសន្ទនា រវាង ថ្នាក់ដឹកនាំ ខណ្ឌ ជាមួយ ក្រុមប្រឹក្សា ខណ្ឌ សង្កាត់ កងកម្លាំង មន្រ្តី ការិយាល័យ ជំនាញ និង មេភូមិ
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ នៅ ព្រឹក ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន បើក វេទិការសន្ទនា រវាង ថ្នាក់ដឹកនាំ ខណ្ឌ ជាមួយ ក្រុមប្រឹក្សា ខណ្ឌ សង្កាត់ កងកម្លាំង មន្រ្តី ការិយាល័យ ជំនាញ និង មេភូមិ ក្រោម អធិបតីភាព លោក អ៊ុ ម៉ារ៉េត ប្រធាន ក្រុមប្រឹក្សា ខណ្ឌ និង លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ ។
លោក ចេង មុនីរ៉ា បាន ឲ្យដឹង ថា នេះ ជា លើក ទី២ ហើយ ដែល រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ បាន បើក វេទិការ សាធារណៈ ជាមួយ ក្រុមប្រឹក្សា ខណ្ឌ សង្កាត់ កងកម្លាំង មន្រ្តី ការិយាល័យ ជំនាញ និង មេភូមិ ទាំង៨ ដែល ជា មន្រ្តី ក្រោម ឱវាទ របស់ សាលា ខណ្ឌ ខុសប្លែក ពី ពេល មុន ៗ ដែល យើង ធ្វើ តែ ជាមួយ ប្រជាពលរដ្ឋ ។
ការធ្វើ វេទិការ នេះ ក្នុង គោលបំណង ដើម្បីឲ្យ មន្រ្តី អនុវត្ត ការងារ ក្រោម ឱវាទ ទាំងអស់ លើកឡើង ពី កង្វល់ និង ការលំបាក នានា ដែល ខ្លួន កំពុង អនុវត្ត ។ ជាមួយគ្នា នេះ វេទិការ ក៏ បាន ផ្តោត ឲ្យ មាន ការពិភាក្សា វែកញែក លើ ការងារ សំខាន់ ៗ មួយចំនួន ដូច ជា៖ ការអនុវត្ត គោល នយោបាយ ភូមិ សង្កាត់ មាន សុវត្ថិភាព . ការផ្តល់ សេវា សាធារណៈ . អនាម័យ បរិស្ថាន . និង ការងារ អភិវឌ្ឍ ហេដ្ឋារចនាស ម័្ពន្ធ ។
លោក អភិបាល ខណ្ឌ បាន បញ្ជាក់ ថា តាមរយៈ វេទិកា នេះ យើង ទាំងអស់ គ្នា នឹង រកឃើញ នូវ បញ្ហា សំខាន់ ៗ ជា អាទិភាព សម្រាប់ ឲ្យ រដ្ឋបាល ខណ្ឌ យក ទៅ ពិចារណា ធ្វើ ការកែទម្រង់ ក្នុង ការអនុវត្ត សកម្មភាព របស់ ខ្លួន ដើម្បី លើកកម្ពស់ គុណភាព នៃ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង ខណ្ឌ ជាពិសេស ប្រជាពលរដ្ឋ ក្រីក្រ ក្នុង មូលដ្ឋាន សង្កាត់ ទាំង៨ ឲ្យ កាន់តែ ល្អ ទ្វេរ ឡើង ថែម ទៀត ។
ការចូលរួម ផ្តល់ មតិ យោបល់ របស់ មន្រ្តី ទាំងអស់ បាន នាំមក នូវ ត្រី វិស័យ និង សក្តានុពល ដ៏ ធំធេង ដើម្បីឲ្យ រដ្ឋបាល ខណ្ឌ ធ្វើ ការឆ្លុះបញ្ចាំង បាន នូវ ចំណុច ខ្វះខាត និង ចំណុច អសកម្ម ដែល បាន អនុវត្ត កន្លងមក និង អាច ឲ្យ គណៈ អភិបាល ខណ្ឌ យក ទៅ ពិចារណា ដើម្បី ធ្វើ ការកែលម្អ ឡើងវិញ ឲ្យបាន សមស្រប ឆ្លើយតប បាន តាម សេចក្តីត្រូវការ របស់ បងប្អូន ប្រជាពលរដ្ឋ ។
សូម បញ្ជាក់ ថា នៅក្នុង វេទិកា នេះ មាន មន្រ្តី មូលដ្ឋាន ជាច្រើន បាន លើកឡើង ពី កង្វល់ ផ្សេង ៗ ដូចជា បញ្ហា ឡាន ដឹក ខ្សាច់ តាម ផ្លូវ ជាតិ លេខ ១ ក្នុង ធ្វើឲ្យ ដីខ្សាច់ ធ្លាក់ មក លើ ផ្លូវថ្នល់ . បញ្ហា សំរាម មាន ការយឺត យូរ ដឹក យក ចេញ និង បញ្ហា ប្រើប្រាស់ គ្រឿងញៀន ជាដើម ៕
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន នេះ បាន ឱ្យដឹង បន្ថែម ថា ដោយ អនុលោម តាម មាត្រា ៤ និង មាត្រា៥ នៃ ច្បាប់ ស្ដីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម បាន ស្នើសុំ ឱ្យ ព្រឹទ្ធសភា ជ្រើសរើស សមាជិក ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ចំនួន ១រូប ។
លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន អះអាង ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ថា ការជន លិច ក្រុង ព្រះសីហនុ នា ពេល កន្លងទៅ នេះ មាន មូល ចម្បង ៗ មួយចំនួន ដូចជា កម្រិត ទឹកភ្លៀង ខ្ពស់ មាន រហូតដល់ ជិត ៣០០ មីល្លីម៉ែត្រ ដែល ជា កម្រិត មួយ ខ្ពស់ មិន ធ្លាប់ មាន ក្នុង រយៈពេល ប្រមាណ ២០ - ៣០ ឆ្នាំ ចុងក្រោយ . ការបាត់បង់ ផ្ទៃ រង ទឹកភ្លៀង ដោយសារ កំណើន សំណង់ និង មូលហេតុ មួយ ទៀត នោះ គឺ ការហូរ រំដោះ ទឹក នៅ តាម ប្រឡាយ និង អូរ មិន បាន លឿន ដោយសារ ប្រព័ន្ធ ប្រឡាយ និង អូរ នោះ ត្រូវបាន រួម តូច ឬ គោក រាក់ ជាដើម ។
បើ តាម លោក អភិបាល ខេត្ត ព្រះសីហនុ ប្រឡាយ និង អូរ ធម្មជាតិ នៅក្នុង ក្រុង ព្រះសីហនុ ដែល ជា កន្លែង ហូរ រំដោះ ទឹក ដ៏ សំខាន់ នោះ ត្រូវបាន គោក រាក់ ខ្លាំង ហើយ កន្លែង ខ្លះ ត្រូវបាន គេ សង់ សំណង់ ផ្សេង ៗ រំលោភ យក ចំណី ប្រឡាយ ជា ហេតុ ធ្វើឱ្យ ប្រឡាយ និង អូរ បាត់បង់ សមត្ថភាព ក្នុង ការហូរ រំដោះ ទឹក ។
ពាក់ព័ន្ធ ការសង់ សំណង់ រំលោភ យក ប្រឡាយ និង អូរ នេះ គេ បាន រកឃើញ ថា ទាំង សំណង់ លំនៅដ្ឋាន របស់ ប្រជាពលរដ្ឋ និង សំណង់ អគារ សណ្ឋារ អគារ ពាណិជ្ជកម្ម ផ្សេង ៗ បាន សង់ រំលោភ យក ចំណី ប្រឡាយ ទឹក និង អូរ អស់ ជាច្រើន ។ ការសង់ សំណង់ រំលោភ យក ចំណី ប្រឡាយ និង អូរ ធ្វើឱ្យ ការបង្ហូត រំដោះ ទឹក មិន បាន លឿន នោះ ឡើយ ហើយ ពេល មាន ភ្លៀង ខ្លាំង ទឹក ចាល លិច ក្រុង ទាំងម្តង ។
ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង ដែនដី នគរូបនីយកម្ម និង សំណង់ ព្រមទាំង លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន កាលពី ថ្ងៃទី ១០ ខែសីហា កន្លងទៅ នេះ ក្រោយពី ការជន លិច ក្រុង យ៉ាង ដំណំ បាន នាំគ្នា ចុះ ដល់ ក្រុង ព្រះសីហនុ សិក្សា ស្វែងយល់ និង រិះរក វិធី ក្នុង ស្តារ ប្រឡាយ អូរ ឡើងវិញ ដើម្បី បង្កើន សមត្ថភាព ការបង្ហូរ រំដោះ ទឹក នេះ ។
បច្ចុប្បន្ន គ្រឿងចក្រ ជាច្រើន គ្រឿង របស់ ក្រសួង ធនធាន ទឹក ក្រសួង សាធារណការ និង ជា របស់ ក្រុមហ៊ុន សាងសង់ ផ្លូវថ្នល់ របស់ ចិន ផង នោះ កំពុង ដាក់ពង្រាយ នៅ តាម ប្រឡាយ និង អូរ ក្នុង ក្រុង ព្រះសីហនុ ដើម្បី កាយ ពង្រីក និង ស្តារ ប្រឡាយ អូរ ឡើងវិញ ។
លោក គួច ចំរើន បាន អះអាង ដោយ មាន ការបើក ភ្លៀង ខៀវ ពី ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា នោះ ការស្តារ ប្រឡាយ នេះ នឹង ធ្វើឱ្យ ទៅ តាម ទំហំ ដើម របស់ ឡាយ ឬ អូរ ពោល កន្លែងណា ដែល មាន សំណង់ សង់ រំលោភ លើ ប្រឡាយ អូរ គឺ ត្រូវ ស្នើ ឱ្យ មាន ការរុះរើ ហើយ បើ មិន មាន ការរុះរើ ទេ ក៏ នឹង ចាត់ វិធានការ ទៅ ច្បាប់ ផងដែរ ។
មន្រ្តី ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ ថា សម្រាប់ ការងារ នៅសល់ អនុវត្តន៍ បន្ត គឺ ពង្រឹង កន្លែង ដាច់ ឲ្យ បាន រឹងមាំ បន្ថែម តែ ប៉ុណ្ណោះ ។
ដោយសារ ក្នុង រយៈពេល ១០ថៃ្ង មក នេះ មាន ភ្លៀង ធ្លាក់ ជា បន្តបន្ទាប់ ពិសេស នៅ យប់ ថៃ្ង ទី១០ ខែសីហា ដែល មាន បរិមាណ រហូត ទៅដល់ ១៣៩មម ( សរុប ភ្លៀង បន្តបន្ទាប់ មាន ដល់ ៣៥០ - ៤០០ ម៉ែត្រ ) ធ្វើឲ្យ មាន ការស៊ី រូង ដី នៅ ផែ្នក ក្បាល ទំនប់ ប្រវែង ១៥ម៉ែត្រ និង តួ ទំនប់ បង្ហៀរ ១៥ម៉ែត្រ សរុប ប្រមាណ ៣០ម៉ែត្រ ។
ការព្រមាន ខាងលើ របស់ លោក Tangsiri កើត មាន ឡើង បន្ទាប់ពី មាន សេចក្ដីរាយការណ៍ ថា អ៊ីស្រាអែល បាន ស្ម័គ្រចិត្ត ផ្ដល់ ជំនួយ ផ្នែក ស៊ើបការណ៍ សំងាត់ ដល់ ក្រុម ចំរុះ អន្តរជាតិ ដឹកនាំ ដោយ សហរដ្ឋ អាមេរិក ប្រឆាំង នឹង អ៊ីរ៉ង់ ។ មេបញ្ជាការ រូប នេះ បាន គូសបញ្ជាក់ យ៉ាង ខ្លី ដូច្នេះ ថា៖ « រាល់ សកម្មភាព ឬ វត្តមាន ខុស ច្បាប់ របស់ អ៊ីស្រាអែល នៅក្នុង ដែន ទឹក នៃ ឈូង សមុទ្រ ពែក អាចនឹង បង្ក ទៅជា សង្រ្គាម » ។
គួរ បញ្ជាក់ ថា នេះ មិន មែន ជា លើក ទី មួយ ឡើយ ដែល អ៊ីរ៉ង់ ព្រមាន ពី សង្រ្គាម បែប នេះ ។ ពោលគឺ កាលពី ខែកក្កដា កន្លងទៅ ទីក្រុង តេហេរ៉ង់ ក៏ ធ្លាប់ បាន ព្រមាន ដែរ ថា បើ សហរដ្ឋ អាមេរិក ហ៊ាន បើក ការវាយប្រហារ ណាមួយ លើ ខ្លួន នោះ អ៊ីស្រាអែល នឹង ត្រូវ កម្ទេច ត្រឹមតែ ពេល កន្លះ ម៉ោង ប៉ុណ្ណោះ ក្រោម កណ្ដាប់ដៃ យោធា អ៊ីរ៉ង់ ៕
រដ្ឋសភា បើក សម័យ ប្រជុំ ជា វិសាមញ្ញ ដើម្បី បោះឆ្នោត ជ្រើសតាំង សមាជិក ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ១រូប
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃចន្ទ ទី១២ ខែសីហា ឆ្នាំ ២០១៩ នេះ រដ្ឋសភា បាន បើក សម័យ ប្រជុំ ជា វិសាមញ្ញ នីតិកាល ទី៦ ដើម្បី បោះឆ្នោត ជ្រើសតាំង សមាជិក ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ១ រូប សម្រាប់ អាណត្តិ ថ្មី ជំនួស សមាជិក ចាស់ ដែល ផុត អាណត្តិ ។ កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា ។
លោក អ៊ិត រ៉ាឌី ជា បេក្ខជន សមាជិក ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម សម្រាប់ អាណត្តិ ថ្មី ដែល ត្រូវ រដ្ឋសភា បោះឆ្នោត នា ពេលនេះ ៕ រដ្ឋមន្ដ្រី សុខាភិបាល បន្ត អំពាវ ដល់ ពលរដ្ឋ ត្រូវ គេង ក្នុង មុង គ្រប់ ពេល ដើម្បី ការពារ ជំងឺ គ្រុន ឈាម និង គ្រុនចាញ់ ក្នុង រដូវ វស្សា និង ទឹក ជំនន់
( រតនគីរី) ៖ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ថ្លែង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ បន្ដ គេង ក្នុង មុង ជានិច្ច ដើម្បី ការពារ ជំងឺ គ្រុន ឈាម និង គ្រុនចាញ់ នៅក្នុង រដូវ វស្សា និង ទឹក ជំនន់ នេះ ។
ការថ្លែង បែប នេះ របស់ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ក្នុង ឱកាស ដឹកនាំ ប្រតិភូ និង ក្រុម គ្រូពេទ្យ ចុះ ពិនិត្យ ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ស្រុក លំផាត់ និង ស្រុក កូនមុំ ខេត្ដ រតនគីរី ដោយ ឥត គិត ថ្លៃ នៅ រសៀល ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៩ នេះ ។
រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង ក៏ បាន ណែនាំ ប្រជាពលរដ្ឋ ពី របៀប ការពារ និង រោគសញ្ញាណ នៃ ជំងឺ គ្រុនចាញ់ ជាពិសេស ក្រៅពី ផ្ដល់ សេវា ព្យាបាល ជូន ពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ហើយ ថែមទាំង ចែកជូន សម្ភារ ផ្សេង ៗ ទៀត ដើម្បី ការពារ ពី ជំងឺ ដង្កាត់ ក្នុង អំឡុង ពេល ទឹក ជំនន់ និង ទឹក ស្រក ទៅ វិញ ។
លោក ក៏ បាន ចែក មុង ជ្រលក់ ថ្នាំ ដល់ ប្រជាពលរដ្ឋ គ្រូពេទ្យ និង ទាហាន ដែល ឈរ ជើង ដើម្បី សង្គ្រោះ ពលរដ្ឋ រងគ្រោះ ធម្មជាតិ ដោយ ទឹក ជំនន់ ទៅ រក ទី ទួល មាន សុវត្ថិភាព ផងដែរ ។
បើកបរ សូម ប្រុងប្រយ័ត្ន គ្រប់ វិនាទី ! ស្លាប់ ៤នាក់ និង របួស ១៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១១ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឱ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៤នាក់ . របួស ស្រាល ៥នាក់ និង របួស ធ្ងន់ ៩នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ៩លើក នេះ បណ្ដាលឱ្យ ខូត ខាត ម៉ូតូ ចំនួន ១៣ គ្រឿង . រថយន្ត តូច ៦គ្រឿង . រថយន្ដ ធំ១ គ្រឿង និង ថ្មើរជើង ២នាក់ . ហើយ មូលហេតុ ដែល បណ្ដាលឱ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . ប្រជែង . បត់ គ្រោះថ្នាក់ និង ស្រវឹង ។
លោក តឹករ៉េត សំរេច ប្រកាស ដាក់ ឲ្យ អនុវត្ត គម្រោង ស្តារ និង កែលម្អ ប្រព័ន្ធ រំដោះ ទឹកភ្លៀង ជំហាន ទី១ នៅ សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ លោក តឹករ៉េត សំរេច ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ក្រុង ព្រះសីហនុ តំណាង លោក សាយ សំអាល់ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជេីញ ប្រកាស ដាក់ ឲ្យ ដំណើរការ គម្រោង ស្តារ និង កែលម្អ ប្រព័ន្ធ រំដោះ ទឹកភ្លៀង ជំហាន ទី១ នៅ ភូមិ ៥ សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
នា ឱកាស នេះ លោក បាន ជម្រាប ជូន បងប្អូន ប្រជាពលរដ្ឋ អំពី សារៈសំខាន់ នៃ គម្រោង នេះ ដែល នឹង ជួយ សម្រួល និង បង្កេីន ល្បឿន នៃ លំហូរ ទឹកភ្លៀង និង កាត់បន្ថយ ការជន់ លិច ផ្ទះសម្បែង របស់ ពួកគាត់ ដោយសារ ជំនន់ ទឹកភ្លៀង នា ពេល ខាងមុខ ។
លោក បាន សំណូមពរ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម សហការ និង គាំទ្រ គម្រោង នេះ ដេីម្បីឲ្យ មាន ដំណេីរការ ទៅ មុខ ដោយ រលូន និង ទទួលបាន ជោគជ័យ តាម ផែនការ ។
សូម បញ្ជាក់ ជូន ថា គម្រោង ស្តារ និង កែលម្អ ប្រព័ន្ធ រំដោះ ជំនន់ ទឹកភ្លៀង ជំហាន ទី១ នេះ គឺជា លទ្ធផល នៃ ការសិក្សា រួមគ្នា រវាង ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ក្រុង ព្រះសីហនុ និង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ នានា នៅក្នុង ខេត្ត ព្រមទាំង មាន ការចូលរួម គាំទ្រ ដោយ រដ្ឋបាល ខេត្ត និង ក្រុង ព្រះសីហនុ ផងដែរ ។
គម្រោង នេះ ប្រើប្រាស់ ថវិកា របស់ ក្រសួង បរិស្ថាន អនុវត្ត ការងារ ដោយ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ និង មាន ៣ ផ្នែក សំខាន់ គឺ៖
* ទី៣៖ បោះ បង្គោល ព្រំ អូរ និង ស្តារ អូរ ឈើ ទាល ពី ស្ពាន ម្លប់ តា ប៉ាង មកដល់ ស្ថានីយ ច្រោះ សម្អាត ទឹក ប្រវែង ២. ១៥០ម៉ែត្រ ។ បន្ទាប់ពី កែលម្អ ប្រឡាយ នេះ ចប់ នឹង ដាក់ ផែនការស្តារ នៅ ភូមិ ផ្សេង ទៀត ផងដែរ ។
លោក ក៏ បាន លេីក ទឹកចិត្ត ឲ្យ អាជ្ញាធរ និង ប្រជាពលរដ្ឋ យោគយល់ គ្នា រួម សហការ គ្នា និង គោរព គ្នា ទៅ វិញ ទៅ មក ដេីម្បី ជំរុញ ការអភិវឌ្ឍ ភូមិ សង្កាត់ និង ក្រុង ព្រះសីហនុ និង ដេីម្បី ផលប្រយោជន៍ រួម របស់ យេីង ទាំងអស់ គ្នា ។
ក្រោយ ពិធី ប្រកាស ដាក់ ឲ្យ ដំណើរការ តាម សំណូមពរ របស់ ប្រជាពលរដ្ឋ ភូមិ ៥នៃ សង្កាត់ លេខ ៤ លោក តឹករ៉េត សំរេច រួម ជាមួយ អ្នកចូលរួម បាន ដេីរ លុយ ទឹក ចុះ ទៅ ពិនិត្យ ទីតាំង ប្រឡាយ ដែល រួម តូច ចង្អៀត និង ពិនិត្យ ស្ថានភាព ផ្ទះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ លិច លង់ ដោយសារ ជំនន់ ទឹកភ្លៀង កាលពី ថ្ងៃទី ៩សីហា កន្លងទៅ នេះ ។
ប្រជាពលរដ្ឋ មាន អារម្មណ៍ កក់ក្តៅ និង រីករាយ ដែល ថ្នាក់ដឹកនាំ បាន ចុះ ទៅ ពិនិត្យ ផ្ទាល់ ដល់ ទីតាំង ព្រមទាំង ស្តាប់ ការលំបាក និង បញ្ហា ប្រឈម របស់ ពួកគាត់ ។ ពួកគាត់ យល់ព្រម ចូលរួម សហការ និង គាំទ្រ គម្រោង ស្តារ និង កែលម្អ ប្រព័ន្ធ រំដោះ ទឹកភ្លៀង នៅ ភូមិ ៥ សង្កាត់ លេខ ៤នេះ ៕ អបអរ ពិធី បុណ្យ Eid Adha! ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ ផ្តល់ សាច់ គោ និង ពពែ សរុប ជិត ១.៣០០ ក្បាល ដល់ អ្នក ខ្វះខាត ទូទាំង ប្រទេស
ក្នុង ពិធី សំណេះសំណាល លោក ទេសរដ្ឋមន្ដ្រី អូស្មាន ហាស្សាន់ បាន ចូលរួម អបអរសាទរ ជាមួយ ប្រជាពលរដ្ឋ ក្នុង ពិធី បុណ្យ មួយ នេះ និង ផ្តាំផ្ញើ ក្តីរលឹក ដល់ បងប្អូន ខ្មែរ ឥស្លាម ដែល កំពុង បំពេញ កាតព្វកិច្ច ពិធី បុណ្យ ហាជ្ជ ជាង ១. ២០០ នាក់ ដែល កំពុង មាន វត្តមាន នៅ ទឹកដី ក្រុង ម៉ាកាស ប្រទេស អារ៉ាប៊ី សាអូឌីត ជាមួយ អ្នក កាន់ សាសនា ឥស្លាម ដែល មក ប្រារព្ធ ពិធី បុណ្យ ជាមួយគ្នា ក្នុង ទីតាំង តែ មួយ ជាង ២លាន នាក់ មកពី ជុំវិញ ពិភពលោក ។
លោក បន្ត ថា ពិធី បុណ្យ ហាជ្ជជា កាតព្វកិច្ច ស្នូល ទី៥ របស់ សាសនិក ឥស្លាម ត្រូវ ទៅ អនុវត្ត បើ មាន លទ្ធភាព ហើយ សម្រាប់ អ្នក ដែល ប្រារព្ធ ពិធី បុណ្យ នៅក្នុង ប្រទេស ឬ ក្នុង ស្រុក វិញ ការចំណាយ ទ្រព្យសម្បត្តិ ផ្ទាល់ខ្លួន ទិញ គោ ឬ ចៀម សម្រាប់ ធ្វើ ពិធី បូជា គួរ ប៉ាន ផ្តល់ សាច់ ចែកជូន ដល់ អ្នក ខ្វះខាត នៅ ជុំវិញ ក៏ ជា កាតព្វកិច្ច ផងដែរ បើ មាន លទ្ធភាព ។
ផ្អែក លើ ទិដ្ឋភាព ជាក់ស្តែង និង លទ្ធភាព សេដ្ឋកិច្ច គ្រួសារ ក្នុង សហគមន៍ ខ្មែរ ឥស្លាម សព្វ ថ្ងៃ លោក ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ បាន អំពាវនាវ ដល់ បងប្អូន ដែល មាន លទ្ធភាព ត្រូវ ចូលរួម ធ្វើ ការបរិច្ចាគ តាម លទ្ធភាព ខ្លួន ឯង ជំនួស ដោយ ពឹងផ្អែក តែ ការទទួល ជំនួយ ជា ថវិកា ឬ ការឧបត្ថម្ភ សាច់ សម្រាប់ បរិភោគ ពី សប្បុរសជន ក្រៅ ប្រទេស ៕
សម្ដេច សង្ឃ នាយក រង ណយ ច្រឹក ទទួលបាន គ្រឿង ឥស្សរិយយស មេត្តិ យិស្សរជន ពិភពលោក ពី UN
នេះ ជា មោទនភាព មួយ ទៀត សម្រាប់ វិស័យ ព្រះពុទ្ធ សាសនា របស់ កម្ពុជា ៕ រដ្ឋមន្ដ្រី សុខាភិបាល ដឹកនាំ ក្រុម គ្រូពេទ្យ ចុះ ពិនិត្យ ព្យាបាល ជំងឺ និង ផ្ដល់ សម្ភារ ផ្សេង ៗ ជូន ដល់ ពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ខេត្ដ រតនគីរី
( រតនគីរី) ៖ នៅ រសៀល ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៩ នេះ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ដឹកនាំ ប្រតិភូ និង ក្រុម គ្រូពេទ្យ អញ្ជើញ ចុះ ទៅ ពិនិត្យ ព្យាបាល ជំងឺ និង ផ្ដល់ សម្ភារ ផ្សេង ៗ ដោយ ផ្ទាល់ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ស្រុក លំផាត់ និង ស្រុក កូនមុំ ខេត្ដ រតនគីរី ដោយ ឥត គិត ថ្លៃ ។
ក្នុង ឱកាស អញ្ជើញ ចុះ ទៅ ពិនិត្យ ព្យាបាល ជំងឺ នេះ រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង បាន អប់រំ សុខភាព ដើម្បី ចៀស ផុត ពី ជំងឺ ផ្សេង ៗ និង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ ប្រុងប្រយ័ត្ន គ្រោះថ្នាក់ ដោយសារ ពស់ ចឹក ឬ សត្វ អសិរពិស ផ្សេង ៗ ដោយ ពិនិត្យ ឱ្យ បាន ត្រឹមត្រូវ មុន ទៅកាន់ ទី ទួល សុវត្ថិភាព ឬ មុន ទៅ ធ្វើ ការជិត គំនរ អុស និង គំនរ ឈើ ។
ជាពិសេស ពេល ធ្វើដំណើរ ពេលយប់ ឬ ពេល ធ្វើ ការងារ ត្រូវ ស្លៀក ខោ ជើង និង ពាក់ ស្បែកជើង កវែង ជៀសវាង កន្លែង ដែល មាន ស្មៅ ស៊ុប ទ្រប់ និង ដាច់ខាត មិន ត្រូវ យក ដៃ ទៅ ចាប់ ពស់ បួស ភ្នំ អសិរពិស ក្នុង ករណី មាន សមាជិក គ្រួសារ ឬ នរណា ម្នាក់ មាន គ្រោះថ្នាក់ ដោយសារ ពស់ ចឹក ឬ សត្វ អសិរពិស ទិច ឬ ខាំ ត្រូវ បញ្ជូន ញាប់ ទៅ មណ្ឌល សុខភាព ឬ មន្ទីរពេទ្យ ដែល នៅជិត លោក អ្នក បំផុត ដើម្បី ទទួល ការពិនិត្យ និង ព្យាបាល ។
