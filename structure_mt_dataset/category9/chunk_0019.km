( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ លៀង ភារម្យ ប្រធាន នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន គោក តំណាង នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ អគ្គ ស្នងការ រង នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន ចុះ សួរសុខទុក្ខ និង យក អំណោយ ជូន កម្លាំង វរ អន្តរាគមន៍ ដែល គ្រោះថ្នាក់ ចរាចរណ៍ នៅ មន្ទីរពេទ្យ សម្តេច តេជោ ស្រអែម ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ លៀង ភារម្យ ក៏ ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ ជូន មន្ដ្រី នគរបាល ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ ផងដែរ ។
ជាមួយគ្នា នោះ ប្រធាន នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន ក៏ បាន យក អំណោយ របស់ នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ ជូន មន្ដ្រី ដែល ជួប គ្រោះថ្នាក់ ផងដែរ រួម មាន មី ត្រីខ ទឹក សុទ្ធ ទឹកដោះគោ ឆៅ និង ថវិកា ១០ម៉ឺន ម្នាក់ ព្រមទាំង ជូន មន្ទីរពេទ្យ សម្តេច តេជោ ស្រអែម ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ថវិកា ១លាន រៀល សារ៉ូម ២កេស មី ៥កេស ត្រីខ ១កេស ធំ ទឹក សុទ្ធ Oral ២កេស ។
ដោយ មើលឃើញ ពី តម្រូវការ នៃ ការប្រើប្រាស់ ឈើ កែច្នៃ ទាំង ក្តារ បន្ទះ ក្តារ កុងផ្លាកេ និង គ្រឿង សង្ហារិម នៅ កម្ពុជា កំណើន ខ្ពស់ នៅ ឆ្នាំ ២០១១ រាជ រដ្ឋាភិបាល បាន ផ្តល់ ផ្ទៃដី ទំហំ ៣៤.០០០ ហិកតា នៅក្នុង ស្រុក សំបូរ ខេត្ត ក្រចេះ និង ស្រុក សៀម បូក ខេត្ត ស្ទឹងត្រែង ឱ្យ ក្រុមហ៊ុន ស៉ីង បាយ អូ ថេក ( ខេមបូឌា ) ខូ អិលធីឌី ដើម្បី ដាំ ដើម ដើមឈើ យកមក កែច្នៃ ជា ក្តារ កុងផ្លាកេ និង គ្រឿង សង្ហារិម ។
ដោយ មើលឃើញ ពី តម្រូវការ ប្រើប្រាស់ ឈើ ក្នុង វិស័យ ឧស្សាហកម្ម កែច្នៃ ឈើ ក្រុមហ៊ុន បាន ដាក់ ផែនការដាំ កូន ឈើ គ្រប់ ប្រភេទ លើ ផ្ទៃដី ទំហំ ១០ម៉ឺ ហិកតា បន្ថែម ទៀត ក្នុង រយៈពេល ១០ ឆ្នាំ គិត ចាប់ពី ឆ្នាំ ២០១៩ ដល់ ឆ្នាំ ២០២៨ ។
លោក វេង សា ខុន បាន ឱ្យដឹង ថា ផ្ទៃ ដែល អនុញ្ញាតឱ្យ ក្រុមហ៊ុន ដាំដុះ ឈើ នេះ គឺជា ផ្ទៃដី ដែល រាជ រដ្ឋាភិបាល បាន ត្រៀម បម្រុងទុក សម្រាប់ ការដាំ ដើមឈើ នៅ ឆ្នាំ ២០០៨ ។ តែ ដោយសារ ថវិកា រដ្ឋ មាន កម្រិត ក៏ បាន ចាប់ដៃគូ ជាមួយ វិស័យ ឯកជន ដើម្បី ធ្វើការលើ ការដាំដុះ កូន ឈើ ដើម្បី បម្រើ ដល់ ការកែច្នៃ ធ្វើ គ្រឿង សង្ហារិម និង វិស័យ សំណង់ ។ ដោយ បាន គិតគូរ លើ ការដាំ ដើម អាកាស ស្យា និង ដើម ប្រេង ខ្យល់ ដែល អាច យក ច្នៃ ទៅជា គ្រឿង សង្ហារិម និង ប្រើប្រាស់ លើ វិស័យ សំណង់ ។
មិន ត្រឹមតែ បាន ឈូសឆាយ ដី និង ដាំដុះ កូន ឈើ នោះ ដើម្បី គាំទ្រ ដល់ គម្រោង ដាំដុះ ឈើ គាំទ្រ ដល់ ឧស្សាហកម្ម កែច្នៃ ឈើ ក្រុមហ៊ុន ក៏ បាន បង្កើត វិទ្យាស្ថាន ស្រាវជ្រាវ និង បង្កាត់ ពូជ ឈើ តាម បែប វិទ្យាសាស្ត្រ ដ៏ ធំ មួយ នៅក្នុង ខេត្ត កំពង់ធំ លើ ផ្ទៃដី ប្រមាណ ៣៧ហិកតា ។ វិទ្យាស្ថាន នេះ មាន គម្រោង ផលិត កូន ឈើ ឱ្យ បាន ប្រមាណ ១០លាន ដើម ក្នុង មួយ ឆ្នាំ ។
ក្រៅពី ធ្វើ សកម្មភាព ប្រឹងប្រែង ក្នុង ដាំដុះ ឈើ ក្នុង ពេល បច្ចុប្បន្ន ក្រុមហ៊ុន ក៏ មាន រោងចក្រ កែច្នៃ ឈើ កម្ទេចកម្ទី ឈើ ទៅជា ក្តារ កុងផ្លាកេចំនួន ពីរ កន្លែង ផងដែរ ។ មួយ កន្លែង ស្ថិត នៅក្នុង រាជធានី ភ្នំពេញ និង មួយ កន្លែង ទៀត ស្ថិត នៅក្នុង ខេត្ត កំពង់ចាម ។
រោងចក្រ ទាំង ពីរ កន្លែង នេះ កំពុង ធ្វើ សកម្មភាព យ៉ាង សកម្មភាព ក្នុង ការកែច្នៃ កម្ទេចកម្ទី ឈើ ឬ ដើម គរ ជាដើម ទៅជា ក្តារ កុងផ្លាកេ សម្រាប់ ផ្គត់ផ្គង់ ទីផ្សារ នៅក្នុង ប្រទេស ដែល កំពុង មាន តម្រូវការ ខ្ពស់ នោះ ។
លោក លូ ឈូឆាង បាន ឱ្យដឹង ថា បច្ចុប្បន្ន កម្ពុជា ត្រូវការក្តារ កុងផ្លាកេប្រមាណ ២ម៉ឺន ម៉ែត្រ គូប ក្នុង មួយ ខែ ។ ក្នុង នោះ ក្រុមហ៊ុន របស់ លោក អាច ផលិត បំពេញ ទីផ្សារ បាន ចន្លោះ ពី ៣៥០០ ម៉ែត្រ គូប ទៅ ៥ ពាន់ ម៉ែត្រ គូប ប៉ុណ្ណោះ ក្រៅពី នោះ ត្រូវ នាំចូល ពី ខាងក្រៅ ។
តាម ការប៉ាន ប្រមាណ របស់ លោក លូ ឈូឆាង តម្រូវការក្តារ កុងផ្លាកេ អាចនឹង កើនឡើង ប្រមាណ ២០ ភាគរយ ក្នុង មួយ ឆ្នាំ ប្រសិន កំណើន សំណង់ នៅ កម្ពុជា បន្ត កើនឡើង ដូច ពេល បច្ចុប្បន្ន នេះ ។
រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម លោក វេង សា ខុន បាន បង្ហាញ ការគាំទ្រ ទៅ លើ គម្រោង អភិវឌ្ឍន៍ របស់ ក្រុមហ៊ុន ដែល បាន ដាំ ដើមឈើ ដើម្បី យកមក កែច្នៃ ជា គ្រឿង សង្ហារិម ជា ក្តារ កុងផ្លាកេជាដើម នោះ ។ លោក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា ក្នុង មួយ ឆ្នាំ ៗ មាន ការនាំចូល ឈើ ជា ប្រភេទ សង្ហារិម និង ក្តារ កុងផ្លាកេរាប់ ម៉ឺន ម៉ែត្រ គូប ពី ខាងក្រោម ដើម្បី បំពេញ តម្រូវ ក្នុង ប្រទេស ។
តាមរយៈ គម្រោង អភិវឌ្ឍន៍ ដាំ ដើមឈើ និង កែច្នៃ នេះ ក្រុមហ៊ុន ស៊ីង បាយ អូ ថេក មិន ត្រឹមតែ បាន រួមចំណែក រក ថវិកា ចូល ដល់ សេដ្ឋកិច្ច ជាតិ និង លើកកម្ពស់ ឧស្សាហកម្ម កែច្នៃ ឈើ នៅ កម្ពុជា ប៉ុណ្ណោះ ទេ តែ ក្រុមហ៊ុន បាន ផ្តល់ ការងារ ជាច្រើន កន្លែង ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ផងដែរ ។
ទាំង នៅ កន្លែង ដាំដុះ ឈើ នៅ ខេត្ត ក្រចេះ និង ស្ទឹងត្រែង . បណ្តុះ កូន ឈើ នៅ កំពង់ធំ ក៏ ដូចជា នៅ រោងចក្រ កែច្នៃ ឈើ នៅ ខេត្ត កំពង់ចាម និង រាជធានី ភ្នំពេញ ក្រុមហ៊ុន ផ្តល់ ការងារ ជិត ២ពាន់ កន្លែង ដោយ ទទួលបាន បាន ប្រាក់ខែ ចន្លោះ ពី ២៥០ ដុល្លារ រហូតដល់ ជាង ១ពាន់ ដុល្លារ ៕ លោក វេង សាខុន ប្រគល់ ផ្ទះ និង គ្រឿង ឧបភោគ បរិភោគ ជូន លោកយាយ ៨០ ឆ្នាំ ម្នាក់ រស់ នៅ ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម
ផ្ទះ នេះ ត្រូវបាន លោក និង លោកស្រី និង ព្រះតេជ ព្រះគុណ ព្រះមុនី សោភ័ណ ប៊ត តាំង ឆេង ព្រះមេ គណ ខេត្ត កំពង់ចាម ព្រះសទ្ធម្មញណ គង់ វិច្ឆិកា ព្រះមេ គណស្រុក កំពង់សៀម លោក ចាយ បូរិន និង លោកស្រី លោក យឹម លៀង ឯកឧត្តម ចាន់ សារុទ្ធ ព្រម ជាមួយ សហការី ហើយ និង សប្បុរស ជន ជាច្រើន ទៀត បាន ជួយ ឧបត្ថម្ភ ថវិកា ចំនួន ជាង ៨លាន រៀល សម្រាប់ ធ្វើ ការកសាង ផ្ទះ ថ្មី មួយ ខ្នង នេះ ។
លោកយាយ ហ៊ុន ស្រី ន បាន សម្តែង នូវ ទឹកចិត្ត រំភើប សប្បាយរីករាយ ឥត ឧបមា និង បាន ថ្លែងអំណរគុណ ជូន ចំពោះ លោក លោកស្រី និង សមាជិក ក្រុមការងារ ទាំងអស់ ចំពោះ សណ្តានចិត្ត មនុស្សធម៌ ដ៏ ប្រពៃ នេះ និង បាន ជូនពរ ឲ្យ ជួប តែ ពុទ្ធ ពរ ទាំង៤ ប្រការ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
លោក ប៊ិន ឡាដា អភិបាល ស្រុក បាន រាយការណ៍ ជូន អង្គ ពិធី ជ្រាប ពី ដំណើរការ សាងសង់ និង សកម្មភាព ការងារ សប្បុរសធម៌ សំខាន់ ៗ មួយចំនួន ទៀត ដែល លោក ប្រធាន ក្រុមការងារ លោកស្រី និង សហការី បាន យកចិត្តទុកដាក់ និង គិតគូ ដោះស្រាយ ជូន បងប្អូន បាន ទាន់ ពេលវេលា ដូចជា គ្រោះថ្នាក់ ចរាចរ រន្ទះ បាញ់ ខ្យល់ កន្រ្តាក់ ភ្លើង ឆេះ ផ្ទះ ចាស់ជរា ក្មេង កំព្រា ជន ពិការ និង ស្រ្តី មេ មាយ ទី ទាល់ ក្រ ។
កាយវិការ ប្រកបដោយ សប្បុរស ធម៌ ដ៏ ប្រពៃ នេះ និង ជាពិសេស ស្មារតី ទទួល ខុស ត្រូវ ខ្ពស់ ក្នុង នាម ជា ប្រធាន ក្រុមការងារ ធ្វើឲ្យ ប្រជាពលរដ្ឋ ស្រុក កំពង់សៀម រំភើប សប្បាយ រីករាយ ចងចាំ និង ប្តេជ្ញា គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ត រៀង ទៅ ។
ភ្ជាប់ ជាមួយ សមិទ្ធផល នេះ លោក បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លោក និង សមាជិក ក្រុមការងារ ទាំងអស់ រួមទាំង អាជ្ញាធរ មូលដ្ឋាន ពាក់ព័ន្ធ ដែល បាន យកចិត្ដទុកដាក់ គិត គូ ពី ទុក្ខលំបាក របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន របស់ ខ្លួន និង ជាពិសេស បាន ចុះ ដោះស្រាយ បញ្ហា ជូន លោកយាយ បាន ទាន់ ពេលវេលា ហើយ កាយវិការ សប្បុរសធម៌ នេះ បាន បង្ហាញ ពី ការទទួលខុស ត្រូវ ខ្ពស់ របស់ ក្រុមការងារ និង អាជ្ញាធរ មូលដ្ឋាន ចំពោះ បញ្ហា ជីវភាព ប្រចាំ ថ្ងៃ របស់ បងប្អូន ។
ភ្ជាប់ ទៅនឹង ការងារ មនុស្សធន៌ នេះ លោក បាន លើកទឹកចិត្ត និង គាំទ្រ គ្រប់ សកម្មភាព ទាំងអស់ ដែល ចូល រួម ដោះស្រាយ ទុក្ខលំបាក និង បញ្ហា ជីវភាព ប្រចាំ ថ្ងៃ ដើម្បី ចូលរួម កែលម្អ កម្រិត ជីវភាព និង អភិវឌ្ឍ មូលដ្ឋាន ផ្ទាល់ របស់ បងប្អូន កាន់តែ រីកចម្រើន ជាលំដាប់ ក្រោម ម្លប់ សុខ សន្តិភាព ស្ថិរភាព និង ការ អភិវឌ្ឍ របស់ ប្រទេសជាតិ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី និង សំណូមពរ ឲ្យ ប្រជាពលរដ្ឋ ថែរក្សា និង ការពារ ឲ្យបាន នូវ សុខ សន្តិភាព នេះ ។
( កាប៊ុល) ៖ អាជ្ញាធរ អាហ្វហ្គានីស្ថាន បាន ឱ្យដឹង ថា មនុស្ស យ៉ាងហោចណាស់ ៦៣ នាក់ បាន ស្លាប់ និង ច្រើន ជាង ១៨០ នាក់ ផ្សេង ទៀត រងរបួស នៅក្នុង ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក នៅឯ សាល រៀប អាពាហ៍ពិពាហ៍ មួយ កន្លែង ក្នុង រដ្ឋធានី កាប៊ុល ។ នេះ បើ តាម ការដកស្រង់ ចេញផ្សាយ ដោយសារព័ត៌មាន BBC នៅ ថ្ងៃអាទិត្យ ទី១៨ ខែសីហា ឆ្នាំ ២០១៩ ។
យោង តាម អាជ្ញាធរ អាហ្វហ្គានីស្ថាន ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក ខាងលើ អាច ជា ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក អត្តឃាត ដែល កើតឡើង នៅ ម៉ោង ១០៖ ៤០ នាទី យប់ នៅ ថ្ងៃសៅរ៍ ចុង សប្ដាហ៍ នេះ ( ម៉ោង ក្នុង តំបន់ ) កំឡុង ពិធី មង្គលការ នៅឯ សាល រៀបអាពាហ៍ពិពាហ៍ មួយ កន្លែង ក្នុង រដ្ឋធានី កាប៊ុល ។
ដោយឡែក ភ្លាម ៗ មិន ទាន់ មាន ក្រុម ណា មួយ ចេញមុខ ទទួលខុសត្រូវ ចំពោះ ការវាយប្រហារ ដ៏ អាក្រក់ នេះ នៅឡើយ ទេ ប៉ុន្តែ វា បាន កើតឡើង នៅ ពេល ដែល គេ រំពឹង ថា សហរដ្ឋ អាមេរិក និង ក្រុម តាលី បង់ នឹង ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង មួយ សំដៅ បញ្ចប់ ជម្លោះ ដ៏ រុំារ៉ៃ នៅក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ៕ ទស្សនា ទិដ្ឋភាព ទូទៅ នៃ ការប្រឡង បាក់ឌុប ឆ្នាំ ២០១៩ នៅ ទូទាំង ប្រទេស (Photo inside)
