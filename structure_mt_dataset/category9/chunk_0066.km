អេសេគាល 8:5 ព្រះអង្គមានព្រះបន្ទូលមកខ្ញុំ ថា៖ « កូនមនុស្សអើយ សូមក្រឡេកមើលទៅទិសខាងជើង » ។
វា ជា ថ្ងៃ ដែល មនុស្ស និយាយ ប្រយោគ ពេញលេញ ។
២៤ ហើយខ្ញុំមានទំនុក ចិត្តពីព្រះ អម្ចាស់ថា ខ្លួនខ្ញុំផ្ទាល់នឹង មកជួបអ្នកក្នុងពេលឆាប់ ៗ ។
តើ អ្នក ទទួលបាន បរិមាណ ប្រូតេអ៊ីន ពេញលេញ ទេ ?
ដូច្នេះ ទីតាំង ដែល ចង់បាន មិន ត្រូវបាន ឈានដល់ ហើយ ថា
វា ហាក់ដូចជា ទូរស័ព្ទ របស់ អ្នក ត្រូវបាន ឫសគល់ ។
ដូច្នេះ ព្រះ មិនមែនជាប្រភពនៃរឿងអាក្រក់ទាំងអស់ដែលយើងឃើញកើតឡើងជុំវិញខ្លួនយើងនោះទេ ។
ដែនដី សន្យា មិន មែន ជា រង្វាន់ សម្រាប់ ការខិតខំ របស់ ពួកគេ ទេ ប៉ុន្តែ ជា អំណោយ ដ៏ សប្បុរស របស់ ព្រះ។
« តែអ្នក ណាដែលចូលរួមជាមួយនឹងព្រះ យេហូវ៉ា នោះជាអ្នកដែលមានវិញ្ញាណ ជាមួយនឹងទ្រង់ » ។
« សូមកុំឲ្យជនស្លូតត្រង់ ណាម្នាក់ត្រូវគេ ប្រហារជីវិត ។
២៤ អ្នក រាល់គ្នាបាន សង់ទីធ្លាសម្រាប់ខ្លួនអ្នកផ្ទាល់ ហើយបានធ្វើខ្លួនអ្នក ជាកន្លែងដ៏ខ្ពស់នៅគ្រប់ផ្លូវ ។
ទាំងអស់ ត្រូវបាន បំផ្លាញ ចេញ ពី ដី ។
ខ្ញុំធ្វើការ នៅរោងចក្រដបរបស់ឪពុកខ្ញុំ » ។
មាន មោទនភាព ចំពោះ ការពិត ដែល ថា យើង រស់ នៅ ដោយ ងងឹតងងុល ដោយ ជំនឿ ។
ស្កប់ស្កល់ ដូច ម្ចាស់ក្សត្រី
អ្នកត្រូវបានអនុញ្ញាតឱ្យបុកការ បង្ហោះរបស់អ្នក បន្ទាប់ពី 12 ម៉ោង ។
ពន្លឺ នៅលើ កាមេរ៉ា នោះ ។
នេះគេហៅថា កូនប្រុសរបស់ខ្ញុំវាយឈ្នះខ្ញុំ ។
នេះ ជាធម្មតា កើតឡើង នៅក្នុង កថា ខណ្ឌ មួយ ។
ប្រឆាំង នឹង ការដក ការគំរាមកំហែង ?
មនុស្ស ម្នាក់ មិន តែងតែ ច្រៀង ចេញ ពី សុភមង្គល ទេ ។
អនីតិជនទាំង ២ នាក់ជាបងប្អូននឹងគ្នា ហើយបានចេញ ពីលំនៅដោយថ្មើរជើង ។
ពេលវេលា នៃ ការត្រឡប់ ទៅ ផ្ទះ របស់ យើង ។
« គណៈកម្មការសិទ្ធិមនុស្ស ជាតិពាក់ព័ន្ធនឹងករណីនោះ ។
'ហេតុអ្វីបានជាអ្នកឈរ ?
ខ្ញុំ ដឹង ខ្ញុំ ដឹង វា ធ្វើឱ្យ មនុស្ស និយាយ អំពី វា ។
ពូទីន បញ្ចប់ រឿង ទាំងអស់ ។
តើអ្នកនឹកដល់គាត់ជាកូនមនុស្សដែលអ្នក យក ចិត្តទុកដាក់នឹងគាត់យ៉ាង ណា ? » ។
ពេលគេលើកឡើងពីផែនដី កង់ក៏ត្រូវលើកឡើង
“ ខ្ញុំបានឃើញពួកគេ ហើយបានដឹងថារូបថតពីរក្នុងចំណោមបីសន្លឹកនោះជារបស់បងប្រុសខ្ញុំ ។
ប្រសិនបើ អ្នក មិន អាច ចូល ប្រើ កម្មវិធី រុករក តាម អ៊ីនធឺណិត បាន ទេ ។
ដូច ដែល យើង បាន រៀន រួចហើយ នោះ គឺ ការទទួលខុសត្រូវ ។
នេះ គឺជា ថ្នាក់ នៃ វត្ថុ ដែល នឹង ត្រូវបាន សាងសង់ ។
មាន កម្មវិធី ឥត គិត ថ្លៃ និង កម្មវិធី បង់ប្រាក់ ។
ធ្វើការ ជាមួយ ខ្សែ ។
ខ្ញុំនឹងបានដូចអ្នកដែលធ្លាក់ទៅក្នុង រណ្ដៅ ។
ឥឡូវនេះ ប្រទេស ឥណ្ឌា កំពុង នាំចេញ រូបរាង និង រចនាប័ទ្ម របស់ ខ្លួន ទៅកាន់ ពិភពលោក ទាំងមូល
( ព. កា. ) ដូច្នេះហើយ ចូរ អ្នក បញ្ចាំអវយវៈនៃរូបកាយរបស់អ្នកទៅនឹងអំពើប្រាសចាកសីលធម៌ខាងផ្លូវភេទ ភាពមិនបរិសុទ្ធ តណ្ហា សេចក្តី ប្រាថ្នាអាក្រក់ និងលោភៈ ដែល ជាការ ថ្វាយបង្គំរូប ព្រះ។
ប៉ុន្តែ គាត់បានដាក់ដៃស្តាំ មកលើខ្ញុំ ហើយនិយាយថា “ កុំខ្លាចអី ។
គាត់ត្រូវបានផ្តល់សិទ្ធិជ្រកកោនកាលពីឆ្នាំមុននៅប្រទេសបែលហ្សិក ។
សង្ឃឹម ថា អ្នក ទាំងអស់ គ្នា នឹង មាន ថ្ងៃ ដ៏ អស្ចារ្យ ។
ការគណនា នេះ អាច ចំណាយ ពេល ពីរ បី វិនាទី សូម អត់ធ្មត់ ។
« ថ្ងៃនេះជាព្រឹត្តិការណ៍សំខាន់មួយក្នុងទំនាក់ទំនងរវាងសហភាពអឺរ៉ុបនិងតួកគី ។
មនុស្ស គ្រប់ រូប មាន វិធី ផ្សេង គ្នា នៃ ការបញ្ចេញមតិ
