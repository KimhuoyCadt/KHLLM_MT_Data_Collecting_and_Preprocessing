ដោយមើលឃើញស្ថាន ភាពធ្ងន់ ធ្ងរ យើងបានសម្រេច ចិត្តហាមកីឡាករទាំងពីរដោយគ្មានកំណត់ » ។
ដូច្នេះ ស្តាប់ កូន របស់ អ្នក ហើយ ដឹង ពី ចំណុច ខ្លាំង និង ចំណុច ខ្សោយ របស់ គាត់ ។
វា ពិតជា អស្ចារ្យ ណាស់ ដែល បាន ឃើញ អ្នក ទាំងអស់ គ្នា ។
គ្មានកន្លែង ណាមួយក្នុងសង្គមយើងសម្រាប់ពាក្យ សម្ដីដែលអាច បញ្ឆេះភ្លើងនៃ ភាពមិនចុះ សម្រុងនោះទេ » ។
គេដូចស្នាមមេដៃអីចឹងហ្មង !
អ្នកមានកូនប្រុសម្នាក់ឈ្មោះពូរ៉ាន់ តើមានរឿងអ្វីកើតឡើងចំពោះគាត់ ?
គម្របត្រូវបានកម្រាលឥដ្ឋ ហើយមានស្នាមប្រឡាក់ស្រាល ។
ល្ងាច ផ្តល់ ជូន អតិថិជន នៃ ខ្ទម ។
គំនិតនេះបានមកពីប្រវត្តិសាស្ត្របុរាណនៃបូព៌ា ។
ដូច្នេះ យើង ត្រូវតែ រៀបចំ សម្រាប់ កិច្ចប្រជុំ ។
• អនុញ្ញាតឱ្យមានរហូតដល់ 120 លេខកូដអ្នកប្រើបុគ្គល
៥. គ្មានភ្នែក ណាអាណិតអ្នកធ្វើការ ទាំងនេះដើម្បីអ្នកដោយអាណិតអ្នកទេ ប៉ុន្តែអ្នកត្រូវគេបោះចោលទៅក្នុងវាលចំហរ ព្រោះអ្នកស្អប់នៅថ្ងៃកើត ។
តោះ ប្រឈមមុខ មួយ ។
អគារ ដើម្បី បម្រើ តម្រូវការ របស់ ពួកគេ ។
ខ្ញុំបានឃើញមនុស្សម្នាក់ឈរនៅកណ្តាលផ្លូវ ហើយខ្ញុំបានឮសំឡេងបាញ់នោះ » ។
ខ្ញុំ ឈប់ ផឹក រាល់ ថ្ងៃ ។
ដោយ សារ តែឈាមច្រើនក៏ហូរដែរ ។
នៅក្នុង ពន្លឺ នៃ សេចក្តីប្រមាថ ។
បន្ទាប់មក ម្តង ទៀត នាង អាច មាន បញ្ហា នៅ កន្លែង ផ្សេង ។
នេះជាដំណឹងដែលអ្នក រាល់គ្នាបានឮតាំងពីដើមមក គឺយើងគួរតែធ្វើ
គាត់បានសួរថា “ តើកូនក្រមុំឬកូន កំលោះសន្លប់ឬ ?
នៅ ទីនេះ ពួកគេ ត្រូវបាន ភ្ជាប់ និង ចាក់សោ ។
ដូច ដែល ខ្ញុំ បាន និយាយ នៅ ពេល ដែល បទប្បញ្ញត្តិ ប្រឆាំង អំពើ អាសអាភាស នៃ វិក័យប័ត្រ នេះ គឺ
រីករាយនឹងការ នៅជាមួយអ្នក ដទៃព្រោះពួកគេមិនមានអារម្មណ៍ថាមានសុវត្ថិភាព ។
មួយក្នុងចំណោមពួកគេគឺជាពាក្យមនុស្សពេញវ័យ , ពីរនៃពួកគេជាពាក្យធម្មតា , និងមួយនៃពួកគេគឺជាពាក្យដែលមាន ន័យ។
ការចាប់ផ្តើម ឬ ចុងបញ្ចប់ នៃ រយៈពេល ។
១៦ ខ្ញុំសួរថា តើនរណាជាអ្នកដែលធ្វើ ស ក្ខីកម្មនៃច្បាប់ ?
សិស្សរបស់គាត់សុទ្ធតែជា វណ្ណៈដូច គ្នា៖ ឃាតក !
ខ្ញុំមិនចង់ឱ្យពួកគេ បញ្ចប់របបអាហារ Emirates ដែលសម្បូរបែបរបស់ពួកគេទេ » ។
ខ្ញុំចង់បានចង្រៃមួយនេះ !
ហើយពួកគេបានរួចជីវិតរហូតដល់សព្វថ្ងៃនេះនៅ តែមាន...
ខ្ញុំ មាន ជីវិត ជាច្រើន ។
នាងត្រូវបានគេបោកបញ្ឆោតដោយគ្មានមេត្តា » ។
រដ្ឋ៖ រូបរាង មួយ ។
អ្វីដែលល្អគឺខ្ញុំគ្រាន់ តែ តស៊ូនិងមិនដែលចុះចាញ់ » ។
នៅក្នុង ការអធិស្ឋាន , លើក ពួកគេ ឡើង ឆ្ពោះ ទៅរក គាត់ ។
តើ អ្នកណា និយាយ ថា បរិយាកាស ថ្មី របស់ អ្នក នឹង ទៅជា យ៉ាងណា ?
នាងត្រូវដឹងថានាងមានឥទ្ធិពលបែប ណាមកលើគាត់ ។
តើអ្វីទៅជាអ្វីដែលធ្វើឱ្យអ្នកមានអារម្មណ៍ក្តុកក្តួល ?
៣៦ កូន ចៅរបស់អ្នក បម្រើរបស់ទ្រង់នឹងទទួល មរតក ហើយអស់អ្នកដែលស្រឡាញ់ព្រះនាមទ្រង់នឹង រស់នៅក្នុងនោះ ។
តើ អ្នក មានអារម្មណ៍ យ៉ាងណា ចំពោះ អ្វី ដែល បាន កើតឡើង នៅ ទីនេះ ?
សូម ក្រឡេក មើល ស្ថានភាព អនាម័យ មាត់ នេះ ។
អ្នកគួរតែមានមោទនភាព និងរំភើបចំពោះអ្វីដែលអ្នកបានសម្រេច ។
អស់ លោក លោកស្រី ដល់ ពេល ស្តាប់ ហើយ ព្រោះ ការពិត នៃ ទំនាក់ទំនង នេះ ហួស ពេល យូរ ហើយ ។
អ្នកលេង អាច ទាញយក ។
សេចក្តី សុចរិតរបស់មនុស្សសុចរិតនឹងមាន
២ ព្រះយេស៊ូមានព្រះបន្ទូលទៅគាត់ ថា៖ « តើអ្នក ឃើញអគារធំ ៗទាំងនេះទេ ?
អាប៊ី៖ បទ នេះ ពិរោះ ណាស់ ព្រោះ សម្រាប់ អ្នក មាន ស្នេហា ។
ទោះបីជា វា ជា ការពិត ក៏ដោយ វា ត្រូវបាន ប្រកាស នៅក្នុង នោះ ។
ទៅ មើល ហើយ ភ្ញាក់ផ្អើល ។
សង្ឃឹម ថា យើង នឹង មាន កិច្ចសហប្រតិបត្តិការ ដ៏ អស្ចារ្យ និង យូរអង្វែង នា ពេល អនាគត ។
ព្រះយេស៊ូមានព្រះបន្ទូលទៀត ថា៖ « ពេលវេលាបានមកដល់ » ។
ស្គាល់សត្វរបស់អ្នក៖ ប្រសិនបើឥរិយាបថសត្វរបស់អ្នកផ្លាស់ប្តូរ សូមមើលសញ្ញានៃជំងឺ ។
បាន ផ្តល់ មេឃ និង ទឹក សម្រាប់ ពួកយើង ។
គាត់មិនបានចាកចេញពីព្រះវិហារបរិសុទ្ធទាំងថ្ងៃទាំងយប់ ដោយបម្រើព្រះ ដោយការតមអាហារ និងការ អធិស្ឋាន ។
ទោះបីជាយ៉ាង ណាក៏ដោយ ការ រង របួសផ្ទាល់ខ្លួនភាគច្រើនអះអាងថាកើតចេញពីគ្រោះថ្នាក់ ...
ថ្ងៃ ជំនុំ ជំរះ នឹង ជា ថ្ងៃ នៃ ការលាតត្រដាង ដែល រាល់ សកម្មភាព និង អំពើ របស់ យើង ត្រូវបាន ដាក់ចេញ សម្រាប់ ទាំងអស់ គ្នា បាន ឃើញ ។
ពេលចេញទៅញ៉ាំអីប្រើក្បាល !
អ្នក បាន និយាយ ថា យើង ធ្លាប់ មាន កិត្តិយស ក្នុង នយោបាយ និង ច្បាប់ ។
អ្នក គួរតែ ទទួលបាន វិញ្ញាបនបត្រ ឬ ក្រុមប្រឹក្សាភិបាល .. .
អ្នក កំពុង ជ្រៀត ជ្រែក ច្រើន ណាស់ សព្វ ថ្ងៃ នេះ ។
រុះរើ ខ្ញុំ ចង់អោយ រជ្ជកាល មកដល់ ។
គាត់គិតក្នុង ចិត្តថា ឥឡូវនេះ គ្មានអ្នក ណាយកឈ្នះខ្ញុំទេ ។
នៃ ការផុត រលត់ អដ្ឋិធាតុ នៃ រូប ព្រះ។
គំរាមសម្លាប់ចោល បើហ៊ានប្រាប់នរណាម្នាក់ ។
ជា ការប្រសើរ ណាស់ យើង អាច ប្រមូល ចំណត ពេញលេញ មួយចំនួន ទៀត ខណៈពេល ដែល យើង នៅ ទីនេះ ។
សុំទោសចំពោះអ្នកដែលខ្ញុំត្រូវបដិសេធ ព្រោះខ្ញុំបាន កក់ទុកហើយ ។
គ្រូ បុរាណ ទាំង នេះ បាន ប្រើ ចំណេះដឹង ដែល បន្សល់ទុក មក ពួកគេ តាម ជំនាន់ ប៉ុន្តែ បាន រក្សា ពួកគេ ទុក ជា អាថ៌កំបាំង ដែល ការពារ យ៉ាង ជិតស្និទ្ធ ។
បាន សង្គ្រោះ គាត់ បន្ទាប់ពី គាត់ មិន ស្តាប់ បង្គាប់
ខ្ញុំ នឹង ត្រូវ បង្ហោះ រឿង របស់ ខ្ញុំ នៅ ទីនេះ ផងដែរ ប៉ុន្តែ មិន មែន ឥឡូវនេះ ទេ ។
ម្យ៉ាង វិញ ទៀត ប្រសិនបើ អ្នក នៅតែ សង្ស័យ លើ ការសម្រេចចិត្ត នេះ អ្នក គួរតែ រង់ចាំ មួយ រយៈ សិន ។
ពួកគេ អធិស្ឋាន ដល់ ព្រះអម្ចា ស់៖
ជា អកុសល នាង អស់ ពេល ដើម្បី បញ្ជាក់ មហិច្ឆតា របស់ នាង ។
តើមានយោបល់អ្វីខ្លះអំពី ហ្គេមដែលខ្ញុំគួរទទួលបានកូនប្រុសរបស់ខ្ញុំ ?
វាពិបាកណាស់សម្រាប់យើងក្នុងការ រួមគ្នា » ។
ខ គម្ពីរ ទាំង ពីរ នេះ បញ្ជាក់ យ៉ាង ច្បាស់ ថា អ្នក ជឿ នឹង មាន វត្តមាន ក្នុង អំឡុង ពេល គ្រា ទុក្ខវេទនា ហើយ ពួកគេ ជាច្រើន នឹង ត្រូវ ធ្វើ ទុក្ករកម្ម សម្រាប់ ជំនឿ របស់ ពួកគេ ។
ប៉ុន្តែគាត់ស្ថិតនៅក្រោមអំណាចរបស់មនុស្សខ្វាក់ភ្នែក ដូចជាត្រូវបានគេធ្វើពុតជា » ។
តើព្រះ នៃប្រជាជាតិ ណាបានរំដោះទឹកដីរបស់ខ្លួនពីកណ្ដាប់ដៃរបស់ស្ដេចស្រុកអាស្ស៊ី រីឬ ?
ពលបាលដែលដឹកនាំការ វាយប្រហារនេះត្រូវបានកាត់ទោស ។
បន្ទាប់មក រង់ចាំ បន្តិច ទៀត ក្នុង មួយ ថ្ងៃ ដើម្បី បាញ់ ។
គាត់បាននិយាយថា៖ « គាត់បានឃើញបុរសពីរនាក់នៅតាមផ្លូវទាំងពីរ ប្រដាប់ដោយកាំបិត » ។
តើ សេរីភាព របស់ ខ្ញុំ សម្រាប់ អ្វី ?
អ្នកជំងឺ ថោក បំផុត គឺ ស្លាប់ ។
ក្រោយមក គាត់ បាន ផ្លាស់ ទៅ រដ្ឋ កាលីហ្វ័រញ៉ា ជា កន្លែង ដែល គាត់ រស់ នៅ សព្វ ថ្ងៃ នេះ ។
ចំពោះ សេចក្តីស្រឡាញ់ របស់ ព្រះ តើ មនុស្សជាតិ នៅ ឯណា ?
ការឆ្លើយតប របស់ ហ្សក ហ្ស៊ី នឹង មកដល់ ថ្ងៃ នេះ ។
គាត់ ជាអ្នកដែលបានបញ្ឈប់ពួកគេ ដោយ កាន់ដៃម្ខាង ។
ប្រសិនបើ អ្នក កំពុង ជួបប្រទះ ការឈឺចាប់ នៅក្នុង
សិទ្ធិមនុស្សក្នុង ន័យទន់ខ្សោយ ដូចអន្តរជាតិអ៊ីចឹង » ។
១៦ ប៉ុន្តែនៅពេលល្ងាច ពួកសិស្សបានចុះទៅសមុទ្រ
ហើយខ្ញុំនិយាយថា “ ខ្ញុំនឹងយក តង្វាយ ” ។
តើមានអ្វីដ៏ថ្លៃថ្នូរដែលអ្នកមិន ...
៨យ៉ាង ណាក៏ដោយ ពួកគេនឹងក្លាយទៅជាអ្នក បម្រើរបស់ទ្រង់ ដើម្បីពួកគេអាចដឹងអំពីអ្វីដែលជាការ បម្រើយើង និងដើម្បីបម្រើនគរនៃប្រជាជាតិនានា ។
ក្នុងករណីដែលអ្នកនៅ តែមិនដឹងថាហេតុអ្វីបានជានាងបានទទួល មរណភាពកាលពីម្សិលមិញ។
ទំហំ ច្រក ចូល កាន់តែ ធំ ។
គឺ ដោយសារតែ ការគ្រប់គ្រង ដ៏ អស្ចារ្យ
ហេតុអ្វីបានជាខ្ញុំអាចធ្វើក្រសួងនេះបានក្លាយទៅជា " អ្នកមិនសមនឹងយើង " ?
“ ការ ក្លាយជាបុរសមានបំផុតក្នុងទី បញ្ចុះ សពមិនមានអ្វីសំខាន់សម្រាប់ខ្ញុំទេ ។
ហើយ ដូចជា អ្នក នាង មិន ត្រូវបាន គេ បៀតបៀន ខ្លាំង ពេក ទេ ។
ទោះជា យ៉ាង នោះ ក៏ដោយ ព្រះអម្ចាស់ បាន គង់ នៅ ជាមួយ ខ្ញុំ ហើយ បាន ពង្រឹង កម្លាំង ខ្ញុំ ដើម្បីឲ្យ ខ្ញុំ ស្គាល់ ការអធិប្បាយ យ៉ាង ពេញលេញ និង ដើម្បីឱ្យ សាសន៍ ដទៃ ទាំងអស់ បាន ឮ ហើយ ខ្ញុំ ត្រូវបាន គេ ដោះលែង ចេញ ពី មាត់ របស់ សត្វ តោ ។
បន្ទាប់មកវាបានចេញទៅក្រៅក្រុងដោយ សារ តែពួកគេមានកូនតូច ។
ភ្លាមនោះ ខ្ញុំបានឃើញយុវជនបួននាក់ ។
ពួកគេ ពិតជា គួរតែ បម្រើ ជនជាតិ អាមេរិក ឱ្យ បាន ត្រឹមត្រូវ ជាជាង ការហក់ ច្រមុះ ក្នុង កិច្ចការ របស់ ប្រទេស ដទៃ ហើយ ធ្វើពុត ជា ចៅក្រម សិទ្ធិ មនុស្ស » ។
ពួកគេ បាន និយាយ អំពី ជីវិត មុនពេល ផ្ទុះ ។
« ប៉ុន្តែ ចក្ខុវិស័យរបស់យើងចំពោះរដ្ឋរបស់យើងមិនអាចសម្រេចបានទេ ប្រសិនបើយើងមិនរក្សាសុវត្ថិភាពប្រជាជន។
ហើយគេបានបញ្ចុះបញ្ចូលដោយគាត់ ហើយហៅសាវ័ក មកវាយដំ ពួកគេ ហើយបានហាមមិនឱ្យនិយាយក្នុងព្រះនាមនៃព្រះ យេស៊ូវហើយបានបណ្តេញពួកគេទៅ។
វា ផ្តល់ឱ្យ អ្នក នូវ ការមើលឃើញ នៅក្នុង គំនិត ( និង សូម្បីតែ បេះដូង ) នៃ ទស្សនិកជន គោលដៅ របស់ អ្នក ។
បើមិនអ៊ីចឹងទេ ខ្ញុំថាគាត់បោកយើងទាំងអស់គ្នា ..
« នេះជាឱកាសមួយដែលយើងគួរចាប់យកភ្លាម ៗ ។
វាល្អជាងការ មិនប្រណាំង » ។
នោះ អាច កំណត់ អ្នក សម្រាប់ ការសង្ស័យ លើ ខ្លួន ឯង ដ៏ សំខាន់ មួយចំនួន ។
សាវកប៉ុលបានព្រមានអំពី « ព្រះយេស៊ូវមួយអង្គទៀត ដែលយើងមិនបាន អធិប្បាយទេ » ( កូរិន ថូស ទី២ ១១:៤ ) ។
ដែល ក្នុង នោះ មាន កន្ទួល ជាច្រើន ។
គម្រោង ថ្មី បាន មកដល់ ហើយ ។
វា ហាក់ដូចជា អ្នក បាន រៀបចំ យ៉ាង ល្អ សម្រាប់ មេរៀន របស់ អ្នក !
ពួកគេ បាន លាតសន្ធឹងក របស់ ពួកគេ ។
បង ប្រុស របស់ គាត់ និយាយ ថា គាត់ កំពុង ប្រើ ពេលវេលា នោះ ដើម្បី រៀន ពី កំហុស របស់ គាត់ ។
ម៉ាឌី សុន៖ ខ្ញុំបួននាក់ ។
រាងកាយរបស់ខ្ញុំចាប់ផ្ដើមទាក់ទងនឹងខ្ញុំថាខ្ញុំមានសុខភាពមិន ល្អ ។
ពួកគេនឹងឆ្លង ផុតវា ព្រោះពួកគេនឹងគ្មានជម្រើស ។
ពេលពួកធម្មយាត្រាមកដល់ ដីនៅ ចន្លោះព្រែកត្រូវបាន ហ៊ុំព័ទ្ធដោយវាល ភក់យ៉ាងធំ ។
បន្ទប់ ជជែកកំសាន្ត ..
ដើមឈើ ណាដែលមិនផ្ដល់ផ្លែល្អ ត្រូវកាប់រំលំចោលក្នុងភ្លើង ។
ខ្ញុំមានទំនុក ចិត្តច្រើនជាងពីរឬបីឆ្នាំមុន ។
វានឹងត្រូវអ្នកផ្សេងប្រើដើម្បីការ សប្បាយរបស់ខ្លួន .. ?
បាន និយាយ ថា ប្រសិនបើ អ្នក គិត ថា ពួកគេ ធ្វើឱ្យ អ្នក មានអារម្មណ៍ ល្អ ជាង យក ពួកគេ ។
« គាត់ប្រាប់នាងថា ‹ ចូរចេញពីប្រទេសនេះ › ។
ពេលព្រះ យេស៊ូចាត់សិស្សទាំងដប់ពីររូបឲ្យទៅផ្សព្វផ្សាយអំពីរាជាណាចក្ររបស់ព្រះ នោះទ្រង់បានប្រទានអំណាច និងសិទ្ធិអំណាចឲ្យពួកគេដើម្បីបណ្ដេញអារក្សទាំងអស់ ហើយព្យាបាលជំងឺ ។
ហើយតួអង្គមួយទៀតនិយាយថា “ ខ្ញុំមិនទុក ចិត្តពួកគេទេ ។
ហើយ ទោះបីជា អ្នក មិន អាច មើលឃើញ ទ្រង់ ក៏ដោយ ក៏ ទ្រង់ ឃើញ អ្នក ។
បន្ទាប់មក ថ្ងៃ មួយ គាត់ បាន ឈ្លោះគ្នា នៅ តាម ផ្លូវ ជាមួយ បុរស ស្បែក ស ។
បន្ទាប់មកអ្នកព្យាយាមស្រែក តែវាចេញមកដូចជាយំ » ។
ព្រះអម្ចាស់មានព្រះបន្ទូល ថា៖ « កុំរៀនតាមមាគ៌ារបស់ សាសន៍ ដទៃឡើយ ហើយកុំខ្លាច ទី សំគាល់នៃស្ថាន សួគ៌ ដែល សាសន៍ ដទៃខ្លាច » ។
បានទៅធ្វើ កិច្ចការដ៏ធំរបស់គេ ហើយជាច្រើននាក់បានស្លាប់ ។
ជាមួយនឹង ភាពផ្អែមល្ហែម របស់ ខ្ញុំ ,
ហើយខ្ញុំបានធ្វើអ្វីមួយដែលខ្ញុំបានស្បថថាខ្ញុំមិនដែលធ្វើ - ខ្ញុំបាន សន្យាថានឹងមានការ សោក សៅ ។
