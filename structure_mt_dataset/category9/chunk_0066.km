ខ្ញុំ មាន ន័យ ថា ខ្ញុំ ចង់ ដឹង
រក មិន ឃើញ អត្ថន័យ ត្រឹមត្រូវ នៃ ផ្ទៃក្នុង ទេ ?
ប្រាំបី ឆ្នាំ គឺជា ជីវិត មួយ នៅក្នុង សន្និសីទ ពាក់កណ្តាល អាមេរិក ។
សេចក្តីស្រឡាញ់ និង ការគោរព របស់ ខ្ញុំ ចំពោះ អ្នក គឺ មិន អាច វាស់វែង បាន ទេ ។
ពោលគឺនៅពេលថ្ងៃ ព្រះអាទិត្យមិនដុតអ្នករាល់យប់ ឬនៅពេលយប់ឡើយ ។
" កន្លែង ជាច្រើន នៅក្នុង ប្រទេស អេត្យូពី និង កន្លែង ជាច្រើន នៅ ទ្វីប អាហ្រ្វិក ដែល ពួកយើង បាន និង កំពុង ធ្វើ ការ មនុស្ស ពិតជា រក្សា សត្វ ចិញ្ចឹម របស់ ពួកគេ នៅក្នុង ផ្ទះ ។
គាត់ត្រូវបានត្រឡប់ទៅអាមេនីវិញនៅព្រឹកនេះ ។
បើមិនលើកស្នែងខ្លួន ឯង តើជានរណា ?
អារម្មណ៍ ឈឺចាប់ នៅ ស្មា ខាងស្តាំ
ដូច្នេះ ជន ជាតិយូដាទូលព្រះអង្គ ថា៖ « តើព្រះអង្គបង្ហាញ សញ្ញាអ្វីដល់យើងខ្ញុំ ដោយឃើញព្រះអង្គធ្វើការ ទាំងនេះ ? » ។
អ្នកគួរបញ្ចេញវារហូតដល់ភ្នែកអ្នកហូរឈាម ។
នាង មិន បាន បង្ហោះ ក្នុង មួយ ឆ្នាំ ។
ដោយមានជំនួយពីមិត្តភ័ក្តិរបស់អ្នក សូម បង្រួមវាឱ្យត្រឹមដប់ ប្រាំ ដែលប្រាំនាក់នឹងត្រូវបានជ្រើសរើសដោយអ្នកសម្រាប់ថ្ងៃនេះ ។
ហើយទ្រង់ធ្វើបែបនោះ ដើម្បីរក្សា ចិត្តរបស់យើងទាំង ស្រុងទៅលើទ្រង់ ។
ឬមួយខ្ញុំគួរប្រាប់អ្នកពីស្លាក សញ្ញាមួយចំនួនដែលជាប់នឹងខ្ញុំ ?
នេះជាមូលហេតុដែលពួក ម៉ៅនិយមត្រូវសម្លាប់ ។
ឥឡូវនេះ ចូរស្តាប់នូវអ្វីដែលព្រះអម្ចាស់មានព្រះបន្ទូលអំពីអ្នក៖ ប្រពន្ធរបស់អ្នកនឹងក្លាយទៅជាស្រីពេស្យា នៅក្នុងទីក្រុង កូនប្រុសកូនស្រីរបស់អ្នកនឹងត្រូវគេសម្លាប់ក្នុងសង្គ្រាម ហើយទឹកដីរបស់អ្នកនឹងត្រូវបែងចែក ជាមួយអ្នក ដទៃ ។
ដូច្នេះតើឯក សិទ្ធិនេះជារបស់ខ្ញុំដោយរបៀប ណាដែលមានមាតានៃព្រះអម្ចាស់ មករកខ្ញុំ ?
ហើយ ទ្រព្យសម្បត្តិ មិន ត្រូវបាន ដកហូត ពី ពួកគេ ទេ ។
ច្រក សុវត្ថិភាព កំណត់ ចំនួន អាសយដ្ឋាន MAC ត្រឹមត្រូវ ដែល ត្រូវបាន អនុញ្ញាត នៅលើ ច្រក ។
ទាំងអស់ អំពី បេន យ៉ាមីន ។
ចំណុច ប្រហាក់ប្រហែល ដូច នៅក្នុង ទិដ្ឋភាព ។
ដើម្បីឲ្យអ្នកអាចបង្កើតមនុស្ស ជាតិទាំងអស់
ដូច្នេះវាជាការ ផ្តល់ជូន ចំអក ។
អ្នក ណាប្រព្រឹត្តយ៉ាងនេះហើយជាកូនមនុស្សដែល កាន់សីលនេះ កាន់ថ្ងៃសប្ប័ ទ ហើយមិនបង្អាប់ទេ កាន់ដៃ ហើយមិនប្រព្រឹត្តអំពើអាក្រក់នោះមានសុភមង្គល ។
ទ្រង់ នឹង ប្រែក្លាយ ការសាកល្បង របស់ អ្នក ទៅជា ទីបន្ទាល់ ដែល នឹង ជា ប្រភព នៃ ជីវិត ដល់ មនុស្ស ជាច្រើន ។
លើកលែងតែ អ្នក ត្រូវ មើល អ្វី ដែល ត្រូវបាន បង្ហាញ នៅ ទីនេះ ។
អស្ចារ្យ ជាង ភោជនីយដ្ឋាន ផ្សេង ទៀត ក្នុង តំបន់ !
នាងចិញ្ចឹមវាម្តងទៀតនៅពេលព្រឹក ពេលថ្ងៃត្រង់ និងពេលចូលគេង ហើយម្តង ទៀតនៅពេលយប់ ។
ប៉ុន្តែមានម្នាក់ទៀតដែលបានទទួល បន្ទុកដូចគ្នា ។
អ្នក គួរតែ យកចិត្តទុកដាក់ លើ សក់ របស់ អ្នក ព្រោះ វា នៅ រស់ ។
ប្រពន្ធខ្ញុំមិនត្រូវដឹងទេ » ។
ដែលគ្មាន សង្ឃឹម ។
« ឥឡូវនេះ ច្បាប់តម្រូវឲ្យកូនចៅលេវីដែលក្លាយជា សង្ឃប្រមូលមួយភាគ ដប់ពីប្រជាជន ពោលគឺបងប្អូនរបស់ពួកគេ ទោះជាបងប្អូនរបស់ពួកគេមានពូជ ពង្សពី អ័ ប្រាហាំក៏ដោយ ។
មានអ្នកដែលស្វែងរកបំផ្លាញអាណាព្យាបាលទាំងនេះ ហើយយកអំណាចសម្រាប់ខ្លួនគេ ។
តើអ្នកនឹងនិយាយទៅ កាន់អ្នក បម្រើនៅពេលដែលគាត់ មកពីវាលថា៖ « មកឥឡូវនេះហើយអង្គុយញ៉ាំ » ?
ប្រាប់ នាង ថា នាង ត្រូវ ទះ កំផ្លៀង និង ធ្វើបាប ។
អ្នក នឹង រត់ ទៅ មាត់ទ្វារ ។
៥ ហើយមានសំឡេងចេញពីបល្ល័ង្ក ថា៖ « សរសើរ ត ម្កើងព្រះ នៃយើង អស់អ្នក បម្រើដែលកោតខ្លាចទ្រង់ ទាំងតូចទាំងធំ !» ។
គាត់ ត្រូវបាន គេ សន្មត់ ថា ដើម្បី ការពារ កូនប្រុស របស់ គាត់ ពី អន្ទាក់ នៃ ពិភពលោក ហើយ លើក គាត់ ឱ្យ ត្រង់ និង រឹងមាំ ។
សូម ជ្រើសរើស ខ្ញុំ ទោះ ថ្ងៃ នេះ ឬ ថ្ងៃ ណាមួយ ក៏ដោយ ។
ពេលទៅដល់ក្រុងយេរូសាឡិម លោកព្យាយាមចូលរួមជាមួយសិស្ស ប៉ុន្តែគេខ្លាចលោកទាំងអស់ ព្រោះមិនជឿថាលោកជាសិស្ស ។
អ្នក ប្រហែលជាចាំពាក្យទាំងនោះថា៖ « មែនហើយ ទោះបីខ្ញុំដើរកាត់ជ្រលងភ្នំនៃស្រមោលសេចក្ដី ស្លាប់ក៏ដោយ ក៏ខ្ញុំនឹងមិនខ្លាចអំពើអាក្រក់ដែរ ត្បិតទ្រង់នៅ ជាមួយនឹងខ្ញុំ ។
ដូច្នេះ ដើម្បីកុំឲ្យអ្នក ណាធ្វើ បាបព្រះ‌បន្ទូលរបស់ព្រះ ឡើយ ។ "
ការហូរ ឈាម គឺជា រឿង ធម្មតា ជាមួយនឹង ព្រឹត្តិការណ៍ ទាំងនេះ ។
កម្ចាត់សត្វចង្រៃទាំងអស់ឥឡូវនេះ !
កាលពី ប៉ុន្មាន ឆ្នាំ មុន ស្ត្រី ម្នាក់ បាន មក រក ខ្ញុំ ដើម្បី ប្រឹក្សា យោបល់ ។
ពួកគេ ប្តេជ្ញា ជួយ កម្មវិធី របស់ យើង ឱ្យ កាន់តែ ប្រសើរឡើង ។
តើឡានដឹកទំនិញ ណាខ្លះទៀតដែលមិនអាចដាក់បាន ?
នៅ ទូទាំង តំបន់ ដែល វា ប្រកួតប្រជែង ។
ដូច ដែល នរណា ម្នាក់ អាច រកឃើញ នៅក្នុង ពិភព នៃ មនុស្ស ។
គាត់ បាន ចំណាយ ពេល មួយ ឆ្នាំ បន្ទាប់ លើ គ្រែ ។
វាជាយប់ស្លាប់ ហើយភ្លៀងនឹងធ្លាក់មកក្នុងពេលឆាប់ ៗ ។
បន្ទាប់មក ជ្រើសរើស ល្បឿន សមរម្យ ដោយ ខ្លួន ឯង ។
ប៉ុន្តែ វា ត្រូវបាន ស្អប់ ដោយ មនុស្ស ជាច្រើន ក្នុង អំឡុង ពេល សាងសង់ របស់ វា ។
Rex ខ្ញុំ យល់ព្រម ហើយ ខ្ញុំ ប្រាកដ ថា ប្រធានាធិបតី ថ្មី របស់ យើង នឹង ដោះស្រាយ បញ្ហា ទាំងនេះ ។
បុគ្គលិក រដ្ឋាភិបាល មួយចំនួន ( ទោះបីជា មិន មែន ទាំងអស់ )
នោះជាមនុស្សឆ្កួតដូចគ្នាដែល រត់មកទីនេះធ្វើពុតជាអ្នក ដទៃ ។
ពួកគេនឹងមានឥទ្ធិពលលើបទ គម្ពីរ សញ្ញាថ្មី ។
« គ្មានអ្វីដែលចូល មកពីខាងក្រៅអាចធ្វើឲ្យគាត់ ‹ មិនស្អាត › បានឡើយ ។
ប្រជាពលរដ្ឋប្រមាណ ៤០០នាក់រស់ នៅក្រុងសេ ណា។
កុំ ដាក់ ខ្លួន ឯង នៅ គ្រប់ ទីកន្លែង ។
ទោះ ជាយ៉ាង ណា អ្នក ប្រហែលជាធ្លាប់បានឮពាក្យមួយ ឃ្លាថា “ រូបភាពមួយមានតម្លៃមួយពាន់ពាក្យ ” ។
បុរស មិន ចូលចិត្ត ស្ត្រី ទេ ។
