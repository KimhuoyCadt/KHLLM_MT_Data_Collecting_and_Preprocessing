7 នៅលើភ្នំនេះ ទ្រង់នឹងបំផ្លាញវាំងននដែលគ្រប មុខគ្រប់ទាំង សាសន៍ គឺវាំងននដែលគ្រប ដណ្ដប់គ្រប់ទាំង សាសន៍ ។
តើ អ្នក ធ្លាប់ មាន អាថ៌កំបាំង ដែល អ្នក គិត ថា អ្នក មិន អាច ប្រាប់ ពី សេចក្តីស្រឡាញ់ នៃ ជីវិត របស់ អ្នក បាន ទេ ?
ការកើនឡើង នៃ ការខូចខាត :
អ្នកត្រូវ សង្គ្រោះខ្លួនឯងជាមុនសិន ទើបគាត់នឹងធ្វើតាម ។
ជាពិសេស សម្រាប់ ការប្រកួត បាល់ទាត់ ពិភពលោក ។
វា ពិបាក ណាស់ ក្នុង ការដោះស្រាយ រឿង ទាំងអស់ នេះ ក្នុង ពេល តែ មួយ ។
ជាមួយនឹងមិត្តប្រុសពាក់កណ្តាល សន្យានឹងឆាប់ត្រូវបានបោះចោល។
ដាល់ ខ្ញុំ ត្រូវតែ ស្វែងយល់
អស់អ្នកដែល ចំអកឲ្យលោកពោលថា៖ « ប្រសិនបើអ្នក ជាបុត្ររបស់ព្រះ ចូរចុះពីឈើឆ្កាងចុះ !» ។
តើការងាររបស់ក្រុមប្រឹក្សាមកដល់ពេលនេះមានឥទ្ធិពលលើរដ្ឋមន្ត្រី ឬច្បាប់ទេ ?
ជីវិត គឺជា សុបិន នៃ ការហែលទឹក ទៅកាន់ សមុទ្រ
សកលលោក ដែល ផ្តល់ កំណើត ដល់ យើង ។
ឆ្លើយតប មក ខ្ញុំ ម្តង ទៀត ។
ក្រុម ជំនុំ រាប់ ពាន់ បាន ជួបជុំគ្នា ថ្វាយបង្គំ ព្រះតែ មួយ ។
គាត់ មិន ចូលចិត្ត គំនិត បោះបង់ បាល់បោះ នៅ មហាវិទ្យាល័យ ទេ ។
បុព្វបុរស របស់ យើង បាន បរិភោគ នំ ម៉ាណា នៅ វាលរហោស្ថាន ។ ដូចមានចែងទុកមកថា៖ ‹ លោកបានឲ្យនំប៉័ងពីស្ថាន សួគ៌ឲ្យគេបរិភោគ › ។ "
ទោះ យ៉ាងណា ក៏ដោយ បន្ទះ ស្មា ត្រូវបាន ណែនាំ យ៉ាង ខ្លាំង ព្រោះ វា កាន់តែ មាន ផាសុកភាព សម្រាប់ អ្នកប្រើប្រាស់ ពេល កំពុង រត់ ។
សត្វ តិរច្ឆាន មិន បាន ស្លាប់ ទេ ។
« ព្រះអម្ចាស់ ជាព្រះ នៃ ជន ជាតិហេព្រើរមានព្រះបន្ទូលថា ' តើអ្នកនឹងបដិសេធមិនបន្ទាបខ្លួននៅចំពោះខ្ញុំដល់ពេលណា ? » ។
ស្ពាន ចិន ទី ១៣
ហើយសេចក្តី សុចរិតនោះជាម៉ាកនៃការ សម្លាប់ ។
គាត់បាននិយាយថា៖ « ឪពុកម្ដាយនិយាយថាពួកគេមានអារម្មណ៍ភ្លេច។
ខ្ញុំ ដឹង ថា មនុស្ស មកពី ហុងកុង មិន ចាត់ទុក ខ្លួន ឯង ជា ចិន ទេ ប៉ុន្តែ ពួកគេ តាម បច្ចេកទេស ។
នៅ តាម ផ្លូវ គឺជា វិហារ មេតូឌីស ឥត គិត ថ្លៃ
បញ្ញវន្តនៅថ្ងៃនេះនៃចៅហ្វាយ នាយដ៏ អស្ចារ្យនៃ ចិត្តមនុស្ស ,
“ មិន មែនថាឥឡូវនេះយើងមានពេលតិចនោះទេ ប៉ុន្តែយើងស្រក់ច្រើន។
2 ហើយដោយ សារការ ដែលអ្នកបាន សង្គ្រោះ បើអ្នកប្រកាន់ ខ្ជាប់នូវអ្វីដែលខ្ញុំបាន អធិប្បាយដល់អ្នក ដរាប ណាអ្នកមិនបានជឿដោយឥតប្រយោជន៍ ។
ជា ការប្រសើរ ណាស់ , បំពេញ តាម តម្រូវការ
នៅ ពេល ដែល អ្នក ត្រូវបាន ប្រមូលផ្តុំ គ្នា នៅក្នុង ព្រះនាម នៃ ព្រះអម្ចាស់ យេស៊ូវ របស់ យើង ហើយ ខ្ញុំ នៅ ជាមួយ អ្នក ដោយ វិញ្ញាណ ហើយ អំណាច នៃ ព្រះអម្ចាស់ យេស៊ូវ របស់ យើង មាន វត្តមាន សូម ប្រគល់ បុរស នេះ ទៅ សាតាំង ដើម្បី អោយ ធម្មជាតិ ដ៏ មាន បាប ត្រូវបាន បំផ្លាញ ហើយ វិញ្ញាណ របស់ គាត់ បាន សង្រ្គោះ នៅលើ ភព ផែនដី ។ ថ្ងៃ នៃ ព្រះអម្ចាស់
ប៉ុន្តែ អ្វី ដែល នាង មាន នៅក្នុង ពិភពលោក ដើម្បី ផ្តល់ឱ្យ គឺ មួយ កាក់ មួយ ។
អាវធំ របស់ ស្ត្រី ដែល មាន ខ្សែ រ៉ូត ។
៤ គ្មានអ្នក ណាចង់ក្លាយជាបុគ្គល សាធារណៈប្រព្រឹត្តដោយសម្ងាត់ឡើយ ។
មកក្រុង ប្រាកប៉ុន្មានឆ្នាំ មកនេះមិនមានមហោស្រពតន្ត្រីធំ ?
កូនស្រី របស់ គាត់ មាន សន្តិភាព ។
មាន តែអ្នកដែលអ្នកបានជួបក្នុងការ ឆ្លងកាត់ និងអ្នកដែលអ្នកអាចទទួលបានប្រយោជន៍ពីពេលនោះ ។
ពេលនោះ ព្រះ អម្ចាស់បានយាងចុះ មកដល់ផែនដី ហើយទេវតាទាំងអស់បានទៅជាមួយទ្រង់ ។
គេមិនត្រូវបានគេអនុញ្ញាតឱ្យទៅលេងផ្សារ ឬកន្លែងធ្វើការ ទេ ។
អង្គុយ នៅ សៀវភៅ ពិសិដ្ឋ ។
យ៉ាង ណាក៏ដោយ ខ្ញុំបានទម្លាក់ក្មេងស្រីទៅផ្ទះក្នុងស្ថានភាពដែលខ្ញុំមិនចង់ពណ៌នានៅទីនេះ ។
ប៉ុន្តែ ប្រាប់ ខ្ញុំ បន្តិច ទៀត ។
ប៉ុន្តែ គ្រឿងស្រវឹង មិន មាន នៅក្នុង ប្រទេស ឥណ្ឌា ពេញ មួយ ឆ្នាំ ទេ ។
នៅពេល អ្នក ទៅ ភោជនីយដ្ឋាន មនុស្ស តែងតែ ចងចាំ ម្ហូប ដំបូង ។
“ បទ ចម្រៀងរបស់យើងភាគច្រើនមានច្រើនណាស់ ។
៤) ទុក ពេល ទំនេរ ដើម្បី ផ្តោត លើ សកម្មភាព អាជីវកម្ម ស្នូល
ហើយ បន្ទាប់មក អ្នក ត្រូវ ឆ្លើយ យ៉ាង រហ័ស ។
គាត់បានឃើញថានេះជាអំពើអាក្រក់ខ្លាំងជាង ។
គ្រាន់ តែឃើញការ សម្ដែងរបស់មនុស្សនៅលើរថភ្លើង ...
រូបវិទ្យា អាតូ មិច ផងដែរ ។
ជោគវាសនា របស់ ពិភពលោក ឥឡូវនេះ ស្ថិត នៅក្នុង ដៃ វ័យ ក្មេង របស់ ពួកគេ ” ។
អ្នក មិន អាត្មា និយម ទេ ប្រសិនបើ អ្នក ធ្វើ រឿង ទាំងនោះ ។
ថែរក្សា កូន របស់ ពួកគេ នៅ ពេល ពួកគេ ភ្ញាក់ ។
ចាប់គាត់ទៅឃុំខ្លួន ..
ខ្ញុំ បាន ធ្វើ វា គ្រាន់តែ ជា ភស្តុតាង នៃ វិធីសាស្រ្ត គំនិត ប៉ុណ្ណោះ ។
មនុស្ស ចាស់ របស់ កូនស្រី របស់ ស៊ីយ៉ូន អង្គុយ លើ ដី
មុខ របស់ ក្មេងប្រុស និង បុរស បាន លាយឡំ គ្នា យ៉ាង ជិតស្និត ជុំវិញ ពួកគេ ។
« គ្មានអ្នក ណាម្នាក់បាត់បង់ជីវិតទេ មាន តែ កប៉ាល់ប៉ុណ្ណោះដែលត្រូវបាត់បង់ » ។
ព័ត៌មាន លំអិត តិចតួច នៃ ថ្ងៃ របស់ ខ្ញុំ ។
ឪពុកនិងម្ដាយរបស់ខ្ញុំមិនពេញ ចិត្តទេពេលបាន ឮអំពីរឿងនេះ ។
ពួកគេ បាន ដើរ ទៅ ខាងក្រោយ ។
៦ បន្ទាប់មក ប្រជាជនចាប់ផ្ដើមកើនឡើងនៅលើផែនដី ហើយកូនស្រីបានកើតមកលើពួកគេ ។
ប្រឆាំង នឹង ការបំផ្លាញ ធម្មជាតិ !
ខ្ញុំមិនបោះបង់ទេ ហើយអរគុណអ្នកដែលបានជួយ ។
របស់ទាំងនោះបានធ្វើឲ្យខ្ញុំមានជីវិត » ។
ទេពកោសល្យ ដែល អ្នក នឹង ត្រូវការ ក្នុង រយៈពេល ប្រាំ ឆ្នាំ ខាងមុខ
ប្រហែលជា ភ្នំ នេះ ត្រូវបាន គេ ហៅ ថា
ដោយសារតែ យើង ប្តេជ្ញា ចំពោះ និរន្តរភាព ។
និយាយ អំពី កង្វល់ របស់ ពួកគេ ។
គ្រួសារនិងក្រុមហ៊ុនក្នុងពេលដ៏ខ្លី ។
ទស្សនា សារមន្ទីរ ខ្យល់អាកាស បើក ចំហ
បន្ទះ ជាមួយ កម្មវិធី ។
« ទោះនិយាយបែបនេះក៏គ្មាន សញ្ញាបើកទ្វារដែរ !
« គឺប្រជាជនរបស់អ្នក និងជាមហាបូជាចារ្យដែលបានប្រគល់អ្នក មកឲ្យខ្ញុំ ។
ធ្វើ ការងារ នេះ ឥឡូវនេះ ដូច្នេះ ពួកគេ មិន គ្រប់គ្រង រយៈពេល 10 ឆ្នាំ ខាងមុខ របស់ អ្នកទេ ។
តើ អ្នក ចង់ឱ្យ ខ្ញុំ សរសើរ អ្នកទេ ?
កុំព្រួយព្រោះខ្ញុំមានការ ពិនិត្យផ្សេងទៀតសម្រាប់អ្នក !
ខ្ញុំ សង្ឃឹមថាពេលខ្ញុំត្រឡប់មកផ្ទះវិញយប់នេះគាត់នឹងមិនអីទេ ។
ខ្ញុំ ជឿ ថា នារី នឹង ចាប់ផ្តើម ដាក់ នៅ ថ្ងៃស្អែក ។
ក្បាច់គុន បុរាណ ជប៉ុន ដែល អ្នកណា ក៏ អាច ធ្វើ បាន !
ហើយ នៅក្នុង កិច្ចការ 4:4 « ប៉ុន្តែអស់ អ្នកដែលបានឮព្រះបន្ទូលជាច្រើនបានជឿ ហើយចំនួននៃមនុស្សបានកើនឡើងប្រហែលប្រាំពាន់នាក់ហើយ » ។ ពីព្រះ អម្ចាស់យេស៊ូវ ហើយព្រះគុណដ៏ អស្ចារ្យបានមកលើពួកគេទាំងអស់គ្នា » ។
ខ្ញុំ ប៉ូល ប្រាប់ អ្នក ថា ប្រសិនបើ អ្នក បាន កាត់ ស្បែក ដោយ ខ្លួន ឯង នោះ ព្រះគ្រីស្ទ នឹង មិន មាន ប្រយោជន៍ សម្រាប់ អ្នកទេ ។
គ្មាន នរណា ម្នាក់ ចង់ ឮ រឿង ទាំងនេះ ទេ៖
ពេលនាងមិនឃើញគេ មក រកនាង ។
ភ្ញៀវ កិត្តិយស បាន មកដល់ ហើយ !
លុយ គ្រាន់តែ ជា តួលេខ សម្រាប់ អ្នក ។
ឪពុករបស់គាត់ក៏និយាយអ្វីម្យ៉ាងដែរ មុននឹងគេនឹកឃើញនាង ។
ខ្ញុំពិតជា សង្ឃឹមថាវានឹងត្រឡប់មកខ្ញុំវិញ ព្រោះវាជារឿងល្អបំផុតដែលនឹងកើតឡើងសម្រាប់ខ្ញុំក្នុង រយៈពេលយូរ ។
ពេល ផ្សេងទៀត វា នឹង មិន ដូចនេះ ទេ ។
បង្ហាញឱ្យពួកគេនូវអារម្មណ៍នៃការ ទទួលខុសត្រូវរបស់អ្នក។
សង្ខេប៖ អ្វីទៅជាមនុស្សដែលអ្នកនឹកឃើញដល់គាត់ ហើយកូនមនុស្សដែលអ្នក មកសួរសុខទុក្ខគាត់ ?
សូម អរគុណ សម្រាប់ ការទិញ អេដឌី ។
អ្នកសុំ ទាន បាន ស្លាប់ ហើយ ត្រូវបាន ទេវតា នាំ ទៅ នៅ ជាមួយ អ័ ប្រាហាំ នៅ ស្ថាន សួគ៌ ។
