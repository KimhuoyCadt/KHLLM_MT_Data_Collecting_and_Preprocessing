ព្រះអង្គយាងចេញម្ដងទៀតនៅម៉ោងប្រាំមួយ និងម៉ោងប្រាំបួន ហើយក៏ធ្វើដូច្នោះដែរ ។
ខ្ញុំ មកអង្គុយនៅចំពោះព្រះភក្ត្រព្រះអម្ចាស់
វាជាអ្វីដែលខ្ញុំគិតថាត្រូវដោះស្រាយ ហើយខ្ញុំគិតថារដ្ឋាភិបាលត្រូវបង្ហាញថាពួកគេកំពុងចាត់វិធានការ ដើម្បីធ្វើឱ្យប្រាកដថារឿងទាំងនេះត្រូវបានដោះស្រាយ » ។
ខ្សែ ដៃ មាស និង ប្រាក់ នេះ ស័ក្តិសម សម្រាប់ ស្ត្រី និង បុរស ។
ឥឡូវនេះ ពួកគេ អាច ត្រឡប់ ទៅ ជឿ នៅ ថ្ងៃ ជំនុំ ជំរះ វិញ
ខទី ២៣៖ ព្រះយេស៊ូមានព្រះបន្ទូលទៅនាង ថា៖ « បងប្រុសរបស់អ្នកនឹង រស់ឡើង វិញ » ។
តើ ពួកគេ បាន ស្តាប់ រឿង នេះ ទេ បន្ទាប់ពី ពួកគេ បាន ធ្វើ វា ។
« ឥឡូវនេះគាត់ស្ថិតក្នុងស្ថានភាពធ្ងន់ធ្ងរដែលមានហានិភ័យខ្ពស់នៃជំងឺបេះដូង និងជំងឺទឹកនោមផ្អែម » ។
បុរស ខ្លះ នៅក្នុង ភូមិ សម្រេចចិត្ត
៤ត្បិត ព្រះ អម្ចាស់មានព្រះបន្ទូលដូច្នេះថា ៖ ‹ មើលចុះ យើងនឹងធ្វើឲ្យអ្នក ភ័យខ្លាច ដល់ខ្លួនឯង និងដល់មិត្ត ភក្ដិរបស់អ្នកទាំង អស់ ។ ពួកគេ នឹង ដួល ដោយ ដាវ របស់ ខ្មាំង សត្រូវ ហើយ ភ្នែក របស់ អ្នក នឹង ឃើញ វា ។
ប្រសិនបើ នរណា ម្នាក់ ចង់ ពិភាក្សា អំពី ភាពខុសគ្នា
ខ្ញុំ សូម ចាប់ផ្តើម ដោយ ការសុំទោស ចំពោះ តម្លៃ នៃ ការផ្ញើ ស្នាដៃ សិល្បៈ របស់ ខ្ញុំ ។
ប្តូរ វេន លើ កាតព្វកិច្ច ។
ភ្លៀង ធ្លាក់ រាយប៉ាយ នៅ ពេលព្រឹក បន្ទាប់មក មាន ភ្លៀង ធ្លាក់ រាយប៉ាយ និង មាន ផ្គរ រន្ទះ នៅ ពេលល្ងាច ។
សង្ឃឹម ថា អ្នក ទាំងអស់ គ្នា នឹង មាន ថ្ងៃ ដ៏ អស្ចារ្យ ។
នៅពេលដែលអ្នកចង់បង្កើតអាជីពឱ្យបានយូរ អ្នកមិនអាចឈ្នះបានឡើយ ជាអកុសល » ។
ព្រះអម្ចាស់ អើយ សូម ប្រទាន នំបុ័ង នេះ មក យើង ជានិច្ច ។
ខ្ញុំភ្ញាក់ផ្អើល ជាខ្លាំង ហើយសួរថា « ហេតុអ្វីបានជាអ្នកដាក់ម្រាមដៃក្នុងអន្ទាក់ ?
២ ធី ម៉ូថេ 1:18 ព្រះ‌ អម្ចាស់ប្រទានដល់គាត់ដើម្បីស្វែង រកសេចក្ដី មេត្តា ក រុណាពីព្រះ‌ អម្ចាស់នៅថ្ងៃនោះ ហើយអ្នកដឹងយ៉ាងច្បាស់ថា តើគាត់បានបម្រើអ្វីនៅក្រុងអេភេសូរ ។
មេរៀន ចុងក្រោយ នៃ ជីវិត របស់ ឪពុក ខ្ញុំ
ខ្ញុំ មិន បាន ធ្វើ បច្ចុប្បន្នភាព វា ទេ ។
គេងើបមុខឡើងឃើញគាត់ ។
ពួកគេ ត្រូវបាន បំផ្លាញ ដោយ ព្រះ។
នេះ គឺជា សេចក្តីស្រឡាញ់ របស់ ព្រះគ្រីស្ទ ចំពោះ យើង ។
ខណៈពេលដែលគេនិយាយថា៖ « នៅថ្ងៃនេះ បើអ្នក រាល់គ្នានឹងឮសំឡេងទ្រង់ កុំធ្វើឲ្យ ចិត្តរឹងប៉ឹងដូចនៅក្នុងការ បះបោរឡើយ » ។
ប្រធានបទ៖ ហើយ សម្រាប់ កិច្ចពិភាក្សា ថ្ងៃ នេះ ...
ចំណង់ចំណូលចិត្ត នៃ ជីវិត ដែល ពួកគេ កំពុង បង្កើត ។
ហើយ សរសេរ ឈ្មោះ របស់ គាត់ នៅលើ វា
១១ ពួកគេបានយកឈ្នះលើលោកដោយឈាមរបស់កូនចៀម និងដោយពាក្យ សម្ដីនៃ ទី បន្ទាល់របស់ពួកគេ ហើយពួកគេមិនបានស្រឡាញ់ជីវិតរបស់ពួកគេនៅពេលដែលប្រឈមមុខនឹងការ ស្លាប់នោះទេ ។
អ្នកត្រូវដឹងថាអ្នក ជាមនុស្សមាន បាបដែលវង្វេង ។
ទោះជា យ៉ាងណា ក៏ដោយ ប្រសិនបើ អ្នក ត្រូវបាន គេ រកឃើញ ថា កំពុង ប្រើប្រាស់ ទម្រង់ ណាមួយ នៃ កំហុស អ្នក នឹង ត្រូវ ពិន័យ
នេះគេដឹងហើយ តាចាស់ចេញថ្លៃ។
យើងនឹងឃើញ ហើយ ឮគ្រប់យ៉ាងនៅថ្ងៃរស់ឡើងវិញ ។
ដូច្នេះ ខ្ញុំប្រាប់អ្នកពីការ នេះ ហើយទទូចក្នុងព្រះអម្ចាស់ថា អ្នក រាល់គ្នាមិនត្រូវរស់នៅដូច សាសន៍ ដទៃទៀតឡើយ ដោយឥតប្រយោជន៍នៃការ គិតរបស់ពួកគេ ។
អ្នក ណាមករកខ្ញុំនឹងមិនស្រេកឡើយ ហើយអ្នក ណាដែលជឿលើខ្ញុំក៏មិនស្រេកដែរ ។
ពួកគេ មិន ត្រូវការ បុរស ដើម្បី ផ្គត់ផ្គង់ ពួកគេ ទេ ។
ប៉ុន្តែប្រសិនបើអាក្រក់បំផុតកើតឡើង តើអ្វីដែលល្អបំផុតត្រូវធ្វើ ?
" ប្រសិនបើ មនុស្ស ត្រូវបាន ផ្តល់ឱ្យ ស្រប តាម ការទាមទារ របស់ ពួកគេ បុរស នឹង ទាមទារ ទ្រព្យសម្បត្តិ និង ជីវិត របស់ មនុស្ស ប៉ុន្តែ កាតព្វកិច្ច នៃ ភស្តុតាង គឺ ស្ថិត នៅលើ អ្នក ទាមទារ ហើយ ការស្បថ គឺជា បន្ទុក លើ អ្នក ដែល បដិសេធ " ។
សង្កាត់ ចំនួន ១៣ នៃ ទីក្រុង ។
ខ្ញុំបានចាប់ផ្តើមយ៉ាងល្អពីចំណាត់ថ្នាក់លេខ ៦» ។
វា អាក្រក់ សម្រាប់ ធ្មេញ របស់ អ្នក និង ផ្នែក ផ្សេង ៗ នៃ រាងកាយ របស់ អ្នក ។
ក្រុមហ៊ុន ក៏ បាន ចូលរួម វិភាគទាន រូបិយវត្ថុ មួយចំនួន ផងដែរ រហូតមកដល់ បច្ចុប្បន្ន ដើម្បី ជួយ សហគមន៍ កសាងឡើងវិញ ។
‹ គាត់នឹងចាប់ផ្ដើមរំដោះអ៊ីស្រាអែលចេញពីកណ្ដាប់ដៃរបស់ពួកភីលី ស្ទីន ។
ហើយ បន្ទាប់មក ខ្ញុំ បាន ដឹង ថា នាង គឺជា ខ្ញុំ ។
កន្លែងដែលខ្ញុំចាប់អារម្មណ៍ចង់ទៅ តាំងពីនៅរៀន ។
124 សូមប្រព្រឹត្តចំពោះអ្នក បម្រើរបស់ព្រះអង្គ តាមសេចក្ដី ស្រឡាញ់របស់ព្រះអង្គ ហើយបង្រៀនទូលបង្គំអំពីច្បាប់របស់ព្រះអង្គ ។
រាល់ ថ្ងៃ ខ្ញុំ ប្រឈមមុខ នឹង បញ្ហា និង បញ្ហា ផ្សេង ៗ ។
គាត់ត្រូវបានគេចាប់បាននៅថ្ងៃសប្ប័ ទ ហើយគាត់ត្រូវបាននាំមកចំពោះមុខ ម៉ូសេ និងអើរ៉ុនដើម្បីវិនិច្ឆ័យ ។
បាន រង ទុក្ខ ឯកឧត្តម អភិបាល ខេត្ត
បំផ្លាញ បញ្ជារបស់ផារ៉ោនឲ្យសម្លាប់
“ នេះជាលើកទីមួយហើយដែលខ្ញុំ មកទីនេះ ។
ហើយគាត់បានឆ្លើយ ថា៖ « វាបានក្លាយទៅជាទ្រង់មិនបានធ្វើឱ្យស្លាប់មកលើខ្លួនគាត់ក៏ប៉ុន្តែមិនបានគេចចេញផងដែរ។
ខ្ញុំ សង្ឃឹម ថា អ្នក ទាំងអស់ គ្នា មាន ថ្ងៃ ដ៏ អស្ចារ្យ ។
តើ អ្នកណា បាន យកឈ្នះ ពិភពលោក ទាំងមូល ?
អ្នកនឹងត្រូវទទួល ទានច្រើនដូចខាងក្រោម៖
ទី មួយ មាន រឿង ពីរ ដែល មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ភាវៈ រស់ ។
នាង ចូលចិត្ត រៀន ជំនាញ ថ្មី ៗ ។
ដោយសារតែ អ្នក នឹង មិន ដែល ត្រលប់ មកវិញ ទេ ។
ប៉ុន្តែ ការសួរនាំ អាច នាំទៅ រក អំពើ បាប នៃ ការ មិន ជឿ ។
កុំ នាំយក ធាតុ របស់ អ្នក ទៅ ព្រឹត្តិការណ៍ នេះ ។
ឈ្មោះ កម្មវិធី ត្រូវបាន សរសេរ ដោយ អក្សរ ធំ ។
ប្រពន្ធ ខ្ញុំ ធ្វើ អ្វី ?
« បើកមាត់ជំនួសមនុស្សល្ងង់ ហើយដើម្បីសិទ្ធិទុគ៌ត ចូរបើកមាត់កាត់សេចក្តី សុចរិត ការពារជនទុគ៌ត និងអ្នក ក្រ ។
ជាថ្មីម្តងទៀត ប្រសិនបើអ្នកមិនធ្លាប់ធ្វើបែបនេះពីមុនមក វាជាគំនិតល្អក្នុងការ ពិភាក្សាជាមួយអ្នកជំនាញយុទ្ធសាស្ត្រអាជីវកម្ម ។
នៅលើ អេក្រង់ នៅ ពីមុខ អ្នក អ្នក ឃើញ
នេះ មកពី មេរោគ ។
នេះមិនមែនជាតំបន់ដែលពួកគេ រស់នៅនោះទេ » ។
រំខាន ដោយ ការរំពឹងទុក ថា ពួកគេ ពាក់ ឬ មិន ពាក់ ខ្សែក្រវ៉ាត់ សុវត្ថិភាព ជាង ខ្ញុំ
អ្នកអាចត្រឡប់រូបថតនៅម្ខាងទៀត ។
« ពិតណាស់ ទឹកដែលខ្ញុំឲ្យគាត់នឹងក្លាយទៅជាប្រភពទឹកដែល នាំឲ្យមានជីវិតអស់ កល្ប ជានិច្ច » ។
លោកបានបន្ថែមថា៖ « នាងបានចូលនិវត្តន៍ ហើយឥឡូវនេះកំពុងប្រឈមនឹងបំណុលដ៏ច្រើន » ។
គាត់យោង ទៅលើសិទ្ធិអំណាច៖ « ដោយព្រះវិញ្ញាណ » ។
ម្នាក់ កាន់ ម៉ាស៊ីន បូម ធូលី ។
ជារឿងថ្មីមួយដែលគ្រប់គ្នាបានអានហើយរីករាយ ។
តាមពិត ពួកគេ មាន អាយុ ២២ ឆ្នាំ ។
មិនត្រូវបានមនុស្សជំនាន់បច្ចុប្បន្នបដិសេធឡើយ ។
៣២ ជាពន្លឺដល់វិវរណៈនៃ សាសន៍ ដទៃ និងសិរីល្អនៃ សាសន៍អ៊ីស្រាអែល ជាប្រជារាស្ត្ររបស់ទ្រង់ ។
ពី តំបន់ ឆ្នេរ ខាងកើត ត្រូវបាន លក់ ដេញថ្លៃ ។
៨ ប៉ុន្តែវាជាវិញ្ញាណនៅក្នុងមនុស្ស
ប៉ុន្តែថ្ងៃនៃព្រះ‌ អម្ចាស់នឹងមកដូចចោរ ហើយពេលនោះផ្ទៃមេឃនឹងបាត់ទៅដោយសំឡេងគ្រហឹម ហើយរូបកាយនៅស្ថាន សួគ៌នឹងត្រូវឆេះ ហើយ រលាយទៅ ហើយផែនដី និងកិច្ចការដែលបានធ្វើនៅលើវានឹងត្រូវ ឆេះ ។ លាតត្រដាង
ឥឡូវនេះ មាន មកុដ នៃ ភាពសុចរិត សម្រាប់ ខ្ញុំ ដែល ព្រះអម្ចាស់ ជា ចៅក្រម ដ៏ សុចរិត ទ្រង់ នឹង ប្រទាន មក ខ្ញុំ នៅ ថ្ងៃ នោះ ហើយ មិន ត្រឹមតែ ចំពោះ ខ្ញុំ ប៉ុណ្ណោះ ទេ ថែមទាំង ដល់ អស់ អ្នក ដែល ចង់បាន ការលេច មក របស់ ទ្រង់ ផងដែរ » ។
សោកស្ដាយ ដែល ខ្ញុំ ដឹង រឿង នេះ ។
ការងារ សំខាន់ បំផុត របស់ រដ្ឋាភិបាល គឺ ការពារ សិទ្ធិ របស់ មនុស្ស គ្រប់ គ្នា ។
អ្នកណា ចាប់ យក ផែនដី
អ្នក មិន ដឹង ឬ ពន្យល់ អ្វី ទាំងអស់ ។
( យ៉ូហាន 4:14) ប៉ុន្តែ អ្នក ណាដែលផឹកទឹកដែលខ្ញុំនឹងឲ្យនោះ អ្នក នោះនឹងមិនស្រេកឡើយ ។ ប៉ុន្តែទឹកដែលខ្ញុំនឹងឲ្យគាត់នឹងក្លាយទៅជាអណ្ដូងទឹកដែលផុសឡើងដល់ជីវិតអស់ កល្ប ជានិច្ច » ។
កុំឲ្យឆ្ងាយជាងដប់ ហ្វីតពីខ្ញុំ » ។
គាត់ ប្រហែលជា កវី ដ៏ ល្អ បំផុត ដែល ចាប់ផ្តើម ជាមួយ មនុស្ស ដែល គិត ថា ពួកគេ ។
បើអ្នកចង់សិក្សាអ្នកទៅអូស្ត្រាលី អង់គ្លេស ឬអាមេរិក ។
ការងារមួយក្នុងចំណោមការងារទាំងអស់របស់ពួកគេលើអាពាហ៍ពិពាហ៍គឺជាស្ថាប័ន ។
អ្នក នៅ ទីនោះ តែ ម្នាក់ឯង អ្នក នៅ ទីនោះ ។
ពី ណា ប៉ូឡេអុង បូណា ផាត ។
៣៦ ប៉ុន្តែ ដូចខ្ញុំបានប្រាប់អ្នក រាល់គ្នាថា អ្នក រាល់គ្នាបានឃើញខ្ញុំ ហើយនៅ តែមិនជឿ ។
៧ ខ្ញុំនិយាយអំពីប្រាជ្ញាសម្ងាត់របស់ព្រះ ជាអាថ៌កំបាំងមួយដែលព្រះ បានលាក់ទុក ហើយកំណត់ទុកជាមុនសម្រាប់សិរីល្អរបស់យើង មុនពេលវេលាចាប់ផ្ដើម ។
« ហើយគាត់បានឆ្លងកាត់ស្រុកស៊ីរី និងក្រុង ស៊ីលីគា ដោយបញ្ជាក់ក្រុមជំនុំ » ។
ខ្ញុំគ្រាន់តែគោរពតាម បញ្ជាពេលបំពេញកាតព្វកិច្ច ។
ក្នុងរបៀបដែលខ្ញុំនៅ តែ ស្មោះត្រង់នឹងខ្ញុំ
សារ៉ា សង្ឃឹមលើព្រះ ហើយនាង « ចាត់ទុកថាជាអ្នក ស្មោះត្រង់ដែលបាន សន្យា » ( ហេព្រើរ ១១: ១១) ។
ឃើញហើយគាត់និយាយហើយដើរចេញ ។
ការ ពាក់មួយប្រាកដជាប៉ះពាល់ដល់របៀបដែលអ្នកពាក់ខ្លួន ឯង ។
ជាពិសេសក្នុងអំឡុងពេលបោះឆ្នោតឆ្នាំ នេះ ។
ដូច្នេះ ជាទូទៅអ្នកគិតថាគាត់បោកព្រោះគាត់មានសុបិនអាក្រក់ ?
វា នឹង មាន ការស្វែងរក មួយចំនួន ដែល កំពុង ដំណើរការ ។
នេះជាគម្ពីរដែលឆ្លើយសំណួរអំពីថ្ងៃ ស ប្ប័ទ ។
៨ លោកម៉ូសេ បានប្រញាប់ប្រញាល់ ហើយអោនក្បាល មកដី ហើយថ្វាយបង្គំ ។
លោកុប្បត្តិ 27:35 ប៉ុន្តែ គាត់មាន ប្រសាសន៍ ថា៖ « បងប្រុសរបស់អ្នកបានបោកបញ្ឆោត ហើយទទួល ពរពីអ្នក » ។
25 ហើយរាល់ពេលដែលពួកគេឈប់ នោះមានសំឡេងមួយ មកពីលើមេឃដែលមានគ្រីស្តាល់នៅពីលើពួកគេ ។
ខ្ញុំគិតថាមិនមានស្ត្រី ណាម្នាក់មានវត្តមានសម្រាប់រឿងនេះទេ ។
សូម ព្រះជា ម្ចាស់ ប្រទាន ជីវិត ដ៏ ពេញលេញ ដល់ គាត់ នៅលើ ផែនដី នេះ ។
អស់ ជាច្រើន ឆ្នាំ ត្រូវបាន ពាក់ ដោយ អ្នក ដែល អង្គុយ លើ បល្ល័ង្ក នៃ
ឆ្លាក់ ផ្លូវ បង្ហូរ ឈាម តាម ពោះវៀននរក ។
បន្ទាប់មក ប្រាកដ ណាស់ ពួកគេ ក៏ ដូចគ្នា ដែរ ។
“ កូនជាម្តាយអើយ តើកូនមិនអាចគិតអ្វីតាម ចិត្តបានទេ ហើយទុកវាឲ្យខ្លួនឯងចុះ នោះកូនមិនស្លាប់ទេ ” ។
" វាមិនមានអារម្មណ៍ល្អគ្រប់គ្រាន់សម្រាប់ខ្ញុំក្នុងការ ឈានមុខខ្លួនឯងនោះទេ " ។
៤ « ចំពោះខ្ញុំ មើលចុះ សេចក្ដី សញ្ញារបស់យើងនៅ ជាមួយនឹងអ្នក ហើយអ្នកនឹងក្លាយទៅជាបិតានៃប្រជាជាតិជាច្រើន
បុរស ម្នាក់ រស់ នៅ យូរ នៅក្នុង ស្រុក កំណើត របស់ គាត់ ។
ទាំងអស់ នេះ គឺ មកពី ព្រះដែល បាន ផ្សះផ្សា យើង ជាមួយ ទ្រង់ ផ្ទាល់ តាមរយៈ ព្រះគ្រីស្ទ ហើយ បាន ប្រទាន ឱ្យ យើង នូវ កិច្ច បម្រើ នៃ ការផ្សះផ្សា ។
ប៉ុន្តែបើខ្ញុំធ្វើអ៊ីចឹង ខ្ញុំមិនធ្វើ តែម្នាក់ឯងទេ ហើយជួលក្រុមអ្នក និពន្ធ និងអ្នកដឹកនាំរឿង ។
អ្នកដឹកនាំ : ( ក ឋិន ) ទូ បានដល់អាយុប្រាំមួយព្រះ ច័ន្ទហើយ ដល់ពេលដែលអ្នកត្រូវបង្ហាត់ហើយ ។
បំពេញ ដោយ បុរស ។
៩ ដូច្នេះហើយបានជាមានការ សម្រាកដល់រាស្ដ្រនៃព្រះ។
ហើយខ្ញុំចង់ត្អូញត្អែរឥឡូវនេះជំនួសឲ្យម៉ោង ១០: ១៥ ពេលខ្ញុំដឹងថាខ្ញុំនឹងចង់ តវ៉ា » ។
បង្កើត ពួកវា ទៅក្នុង កុំព្យូទ័រ ដោយ ខ្លួន ឯង ។
ធ្វើបែបនោះប្រហែលពីរសប្តាហ៍ជាប់គ្នា ហើយគាត់នឹងទទួលបានរូបភាព ។
នៅពេល ខ្ញុំ ធ្វើការ ជាមួយ មនុស្ស ទាំងនោះ ខ្ញុំ មាន ការលំបាក ច្រើន ។
អ្នក កំពុង បន្ត នៅក្នុង ទី ងងឹត ។
ខ្ញុំ រៀបការ ខ្ញុំ មាន កូនប្រុស ម្នាក់ ។
លូកា កត់ត្រាថា មានជម្លោះក្នុងចំណោមពួកគេទាក់ទងនឹងអ្នក ណាត្រូវចាត់ទុកថាជាអ្នកធំជាងគេ ។
ការពិត ឬ ភាព មិន ពិត នៃ សក្ខីកម្ម របស់ សាក្សី ណា ម្នាក់ ដែល ប្រកាន់ ជំហរ ។
គាត់បានចាប់ ផ្តើ មថា : « ខ្ញុំនិងភរិយាមានមុនពេលរៀបអាពាហ៍ពិពាហ៍។
គាត់នឹងឃើញថាអ្នក យក ចិត្តទុកដាក់ចំពោះ ភាពមានប្រសិទ្ធភាពរបស់គាត់ ហើយអ្នកមើលឃើញគាត់ជាបុរសដែលមានមនោសញ្ចេតនា ។
កុំឲ្យមានអ្នក ណាចង់បានឡើយ ដ្បិតខ្ញុំមាន យញ្ញ បូជាដ៏ធំដើម្បីធ្វើដល់ព្រះ‌ យេហូវ៉ា ។
សូម កុំ បដិសេធ ថា សត្វ ស្លាប មាន ស្លាប ។
១៤ ដូច្នេះ ព្រះអម្ចាស់បានចាត់ទុកអស់អ្នកដែលផ្សាយដំណឹងល្អគួររស់នៅពីដំណឹងល្អ
ព្រោះ វា ពិសិដ្ឋ ។
វា អាច ជា កន្សោម ដែល ដោះស្រាយ ក្នុង បញ្ជី មួយ៖
មិនមែនបំផ្លាញវាទេ ប៉ុន្តែត្រូវឱបក្រសោបវា ។
បច្ចុប្បន្ន នាង គឺជា តារា ម៉ូដែល ។
ប៉ុន្តែ មានដំណឹងល្អថា អ្នកចុងក្រោយនឹងទៅជាមុន ហើយអ្នក ដំបូងនឹងទៅជាចុងក្រោយ ។
អ៊ីចឹងខ្ញុំដកវាភ្លាម » ។
ដំបូង អ្នក គួរតែ ប្រាប់ អ្នកជិតខាង របស់ អ្នក អំពី បញ្ហា ។
អនុញ្ញាតឱ្យ ព្រះយេស៊ូវ ធ្វើជា ប្រមុខ នៃ ជីវិត របស់ អ្នក ។
បងប្អូនអើយ អ្នក ដឹងហើយថាមួយ រយៈមុនព្រះ បានជ្រើស រើសខ្ញុំឲ្យផ្សាយទៅ កាន់ សាសន៍ ដទៃ ដូច្នេះពួកគេនឹងឮ សារដំណឹងល្អ ហើយជឿ ។
បើ ខ្ញុំ មាន ដាវ នៅក្នុង ដៃ ខ្ញុំ នឹង សម្លាប់ អ្នក ឥឡូវនេះ ។
វា ជា សិទ្ធិ របស់ សមាជិក ព្រឹទ្ធសភា ។
ពេល ខ្ញុំ នៅ ជាមួយ គាត់ ខ្ញុំ មានអារម្មណ៍ ថា មាន ជីវិត ។
អ្នកណា ដើរ តាម នាង ត្រូវ សម្លាប់ ដោយ ដាវ ។
ហើយគ្មានអ្នក ណានឹងស្លាប់ដោយមិនដល់ថ្ងៃស្លាប់នោះឡើយ ។
ជន ជាតិគីបៀនត្រូវបានគេហៅមកពីទីក្រុងសំខាន់របស់ខ្លួន ។ ប៉ុន្តែ ពួកគេជាជន ជាតិហេវីដូច ជា ។ សមាជិក នៃ កុលសម្ព័ន្ធ នោះ ។
វា ហាក់បីដូចជា វា ប្រែប្រួល ក្នុង ចំណោម ព្រះវិហារ ដទៃ ទៀត ។
ត្រូវ ប្រាកដ ថា អ្នក កំពុង កាប់ ពួក វា ក្រោម អាយុ មួយ ឆ្នាំ ។
ច្បាប់ ស្តីពី ការងារ និង លំនៅឋាន យុត្តិធម៌ រដ្ឋ កាលីហ្វ័រញ៉ា (FEHA) ផ្តល់ ការការពារ បន្ថែម ។
បង្ហាញ ខ្លួន សម្រាប់ នាង ។
ខ្យល់ បក់ បោក ខ្លាំង ។
គ្មាន ជាតិ ពុល និង អាច ប្រើ បាន ដោយ កុមារ
សៀវភៅ យ៉ូហានប្រាប់យើងអំពីរឿងនោះ ។
ហើយបន្ទាប់មកវាបិទថា “ យើងជាព្រះ‌ អម្ចាស់បានបង្កើតវាហើយ ” ។
កូនមនុស្សអើយ តើអ្នកបានឃើញនូវអ្វីដែលពួក វង្សអ៊ីស្រាអែលពីដើមធ្វើឬ ? .. .
ស្តេច អើយ 12 ដូច្នេះ ប្រាជ្ញា និង ចំណេះដឹង នឹង ប្រទាន មក អ្នក
« បន្ទប់មួយចំនួននេះជាការ សិក្សារបស់ឪពុកម្ដាយខ្ញុំ ។
« ប៉ុន្តែយើងនឹងត្រូវទិញសម្លៀក បំពាក់ព្រោះខ្ញុំមិនគិតថាគេនឹងឲ្យវាដល់យើងទេ » ។
ទោះបីជា អ្នក មិន មានអារម្មណ៍ ឈឺ ក៏ដោយ ក៏ អ្នក មិន គួរ ចង់ ញ៉ាំ អាហារ ច្រើន ដែរ ។
គាត់មិនអាចត្រូវបានចុះ ហត្ថលេខានិងជិះលេងជាកីឡាករ បម្រុង។
ប្រជាសាស្រ្ត នៃ រដ្ឋ អនុញ្ញាតឱ្យ មាន ក្រុម ផ្សេង ទៀត ។
ដើម្បី ស្តាប់ បុរស ។
“ វា ប្រហែលជា មិន ត្រូវបាន រកឃើញ ថា មាន រឿង អ្វី កើតឡើង ដែល មិន ល្អ នៅ ទីនេះ សម្រាប់ ហេតុផល ដែល ថា មិន មាន ការប្រកួតប្រជែង នៅ ទីនេះ ។
ហើយមិនមានការសង្ស័យក្នុង ចិត្តរបស់ Mariana ដែលពួកគេកំពុងតែបាញ់ព្រួញសម្រាប់ទីតាំងនេះ ។
ឈ្មោះ , ភាគរយ ជារៀងរាល់ ថ្ងៃ ។
កាលពួកខាងគណៈ ផារី ស៊ី ឃើញដូច្នោះ ក៏និយាយទៅ កាន់ពួកសិស្សថា
ហេ - បាន បន្ត ស្វែងយល់ អំពី ប្រាក់ ភ្នាល់
ខ្ញុំ សង្ឃឹមថារឿងបែបនេះនឹងត្រូវបិទនៅពេលកូនប្រុសខ្ញុំទៅដល់នោះ ។
ទោះ យ៉ាងណា ក៏ដោយ អ្នកនយោបាយ NY មួយចំនួន បាន សម្តែង ការគាំទ្រ ចំពោះ ផែនការ នេះ ។
ជាមួយនឹង អំណាច ទាំងអស់ នៃ ទីផ្សារ ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម មិន មាន មនុស្ស គ្រប់គ្រាន់ បាន ទាញយក ប្រយោជន៍ ពី វា ទេ ។
- បង្វែរ ទូរស័ព្ទ របស់ អ្នក ទៅជា របៀប ជិះ យន្តហោះ ។
ប្រសិនបើ អ្នក ផ្លាស់ប្តូរ ឬ បន្ថែម លក្ខខណ្ឌ មួយ នៃ ការផ្តល់ ជូន នោះ អ្នក បាន ធ្វើ ការប្រឆាំង ។
ពេលអ្នកឈានដល់ឧបសគ្គ ចូរ ប្រែវាទៅជាឱកាស ។
ជូនពរ ថ្ងៃ កំណើត ដល់ ខ្ញុំ ខ្ញុំ មាន អាយុ មួយ រយ បី
និក្ខម នំ 1:3 គឺជាបំណងប្រាថ្នារបស់ខ្ញុំ នៅពេលដែលខ្ញុំបានបន្តទៅស្រុក ម៉ា សេដូន ដើម្បីឲ្យអ្នក រាល់គ្នាឈប់នៅក្រុងអេភេសូរ ដើម្បីបង្គាប់ដល់មនុស្សខ្លះកុំឲ្យធ្វើការ បង្រៀនផ្សេង ៤.
ព្រះជា ព្រះនៃ សកលលោក !
ខ្ញុំមានស្បែកស្អាតរាល់ថ្ងៃ » ។
នោះ ហើយ ជា របៀប ដែល យើង បាន ទៅដល់ អូស្ទីន
អ្នកស្អប់ក៏រំខានដែរ ។
បុរសនោះសួរលោកម្ចាស់ !
ពាក់កណ្តាល ទៀត នឹង ត្រូវបាន ប្រើ សម្រាប់ អំណោយទាន ប្រតិបត្តិការ របស់ មជ្ឈមណ្ឌល ប្រវត្តិសាស្រ្ត ។
អ្នក៖ អ្នកម្តាយ ញូវយ៉ក ថា មស៍ បាន និយាយ ថា ខ្ញុំ ភ្លឺ ។
នៅក្នុង ឈុត របស់ គាត់ ប៉ា បាន ក្រោក ឡើង ដើម្បី ចាកចេញ ។
ចាប់តាំងពី ខ្ញុំ ខ្លាច ស្រឡាញ់ អ្នក ។
« តែឯងមិនអាចមើលមុខខ្ញុំបានទេ ព្រោះគ្មានអ្នក ណាឃើញខ្ញុំរស់ទេ » ។
« ដោយសេចក្ដី ជំនឿ ម៉ូសេ ដល់អាយុច្រើនឆ្នាំ នោះមិនព្រមហៅជាកូនរបស់ព្រះចៅផារ៉ោនឡើយ » ( ខ២៤ ) ។
- តើ យើង អាច រៀបចំ ព្រះវិហារ បរិសុទ្ធ ថ្មី នៃ ព្រះវិញ្ញាណ បរិសុទ្ធ ដោយ របៀប ណា ?
ប៉ុន្តែរហូតមកដល់ពេលនេះ ក្រុមគ្រួសារនិយាយថា មិនទាន់មានការ ចាប់ខ្លួននោះទេ ។
