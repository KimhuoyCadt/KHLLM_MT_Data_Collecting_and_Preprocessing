តម្លៃ នៃ ភាគហ៊ុន នេះ បច្ចុប្បន្ន មាន សរុប ៤៥ ពាន់ លាន ដុល្លារ ។
មួយចំនួន គេ ស្តុក ទុក អត់ ទាន់ លក់ ។
ជីវិត មនុស្ស ខ្ទើយ 1
បណ្តាលឱ្យ ក្រុមហ៊ុន នោះ រង ការខូចខាត សម្ភារៈ យ៉ាង …
សេចក្តី ព្រួយបារម្ភ ពីរ ទៀត គឺ បរិយាកាស នយោបាយ មិន ច្បាស់លាស់ និង ភាពលំបាក ក្នុង ការប្រកួតប្រជែង ជាមួយ ក្រុមហ៊ុន ក្នុង ស្រុក ។
មាន អ្នក អភិវឌ្ឍន៍ ជាង ៤០ នាក់ នៅលើ គេហទំព័រ ។
ការស្វែងរក មធ្យោបាយ ធ្វើដំណើរ ក្នុង ស្រុក កាន់តែ ពិសេស ព្រោះ កម្មវិធី ទូរស័ព្ទ នេះ នឹង បញ្ជាក់ ពី តម្លៃ និង ទីតាំង យ៉ាង ច្បាស់លាស់ ។
គ្រាន់តែ កម្រិត នៃ … អាន លម្អិត
អ្នកចូលរួម ទាំងអស់ ត្រូវ បង់ វិភាគទាន ចំនួន ១០ដុល្លារ ដែល ថវិកា ទាំង នេះ នឹង យក ទៅ ប្រើប្រាស់ ក្នុង ការធ្វើដំណើរ និង អាហារ ។
អោក សុម៉ាវត្តី តារាចម្រៀង ត្រកូល អោក ដែល ស្ងប់ស្ងាត់ ពី សិល្បៈ
នេះ ទូក នានា បាន មកដល់ ប្រទេស ក្រិក ដោយ ដឹក មនុស្ស ប្រហែល ១៥០ នាក់ ជារៀងរាល់ ថ្ងៃ ។
ជជុះ អ្វី ដែល ត្រូវ គិត ជាមុន គឺ តម្លៃ ។
កញ្ញា វីក គី គ្រីន ហល
គួរ កុំ ភ្លេច ប្រើ ក្រែម លាប ពីលើ ក្រោយពេល ដុស លាង ហើយ ។
អ្នកជំនាញ ខាង សុខភាព បាន ឱ្យដឹង ថា ការហាត់ប្រាណ មិន ចាំបាច់ អាស្រ័យ …
ខ្ញុំ បាន និយាយ រួចហើយ ថា ទោះជា អ្នកណា ឈ្នះ ក៏ដោយ ស្រុក យើង និង ប្រទេស របស់ យើង នឹង បាន ទទួល ផលប្រយោជន៍ ពី លោក ទាំង ពីរ នៅក្នុង រដ្ឋសភា ។
ប៉ូលិស បាន ចាប់ខ្លួន មនុស្ស ចំនួន ៥នាក់ ដែល ជាប់ពាក់ព័ន្ធ ទៅនឹង ការវាយប្រហារ នោះ បណ្តាញ ផ្សព្វផ្សាយ បាន និយាយ ដូច្នេះ ។
គួរ បញ្ជាក់ ថា នៅក្នុង សេចក្តីថ្លែងការណ៍ ដោយ ប្រើ ពាក្យ សម្តី ធ្ងន់ ៗ
មជ្ឈមណ្ឌល កីឡា ប្រដាល់ យុវជន ជំនាន់ ថ្មី ទទួល សិស្ស ចូល ហាត់ ១២នាក់ ដំបូង
ការសាក ថ្ម ទូរស័ព្ទ ដៃ គួរ ឆ្ងាយ ពី ខ្លួន មិន តិច ជាង ៣០សង់ទីម៉ែត្រ ហើយ មិន គួរ ដាក់ នៅក្បែរ គ្រែ ដេក ទេ ខណៈ ដែល កំពុង ដេកលក់
បង្កើត កូន មក ភ្លាម សម្លាប់ ចោរ ភ្លាម … មាន វីដេអូ
ក៏ មាន ការស្រលាញ់ និង ចូលចិត្ត ។
មនុស្ស ពីរ នាក់ អាច ជួបប្រទះ នឹង ហេតុការណ… ច្រើន ទៀត
សូម ជម្រាប ថា ចាប់ពី កំឡុង ខែសីហា ភាគី នីមួយ ៗ
ចំនួន ជាង ៥០០ រឿង ប៉ុន្តែ ទើប ប្រមូល បាន ប្រមាណ ជិត ៤០ រឿង តែ ប៉ុណ្ណោះ ។
មន្ត្រី សាលា រាជធានី ថា មិន អាច លុបបំបាត់ ការយក ចិញ្ចើមផ្លូវ សម្រាប់ ប្រកបរបរ រកស៊ី បាន ទេ
លោក និង ក្រុមគ្រួសារ កំពុង ព្យាយាម ដោះ បំណុល នេះ ។
អ្នក បន្ត វេន នៅ កម្ពុជា អាច ប្រឈម បញ្ហា សុខភាព ខ្លាំង ?
បទ ភាជនីយ និយាយ អំពី ទី មិន មាន សេចក្តី អន្តរាយ ជាដើម ១៩៩
ក្រោយមក កម្លាំង ជំនាញ ខណ្ឌ និង ប៉ុស្តិ៍ បាន ធ្វើ ការស្រាវជ្រាវ រហូតដល់ វេលា ម៉ោង ៣ ៖
ទាក់ទង នឹង ផល ប៉ះពាល់ នៃ ការ មិន ពេញចិត្ត របស់ ពលរដ្ឋ ខ្មែរ ទៅ លើ ជនជាតិ ចិន លោក មាស នី ក៏ បាន មានប្រសាសន៍ ដែរ ថា ៖
ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការបំពេញ តម្រូវការ បញ្ជាទិញ ទំនិញ គ្រប់ ប្រភេទ របស់ ប្រជាពលរដ្ឋ ក្នុង តំបន់ ក៏ ដូចជា តំបន់ ជិតខាង ផងដែរ ។
ល្អ សម្រាប់ អនាគត ដែរ ។
ពលរដ្ឋ ខ្មែរ សាមញ្ញ គិត ថា បំណុល ទាំងអស់ នេះ មិន មែន រឿង របស់ ពួកគាត់ ទេ ជា រឿង រដ្ឋាភិបាល ។
ក្រសួង ការងារ សហការ ជាមួយ ក្រុមហ៊ុន ធំ ៗ
៤ខ្ញុំ ដើរ ហួស ពួក អ្នកយាម ល្បាត បន្តិច ទៅ
ស្រវឹង ធ្លាក់ ភ្នែក លូកលាន់ នារី អូតេស លើ យន្តហោះ
អាកញ្ចាស់ ឆ្កែ ជុំ ម៉ី អា អាច ម៌
សប្បុរសជន ដែល បាន ចូលរួម ឧបត្ថម្ត ថវិកា ដល់ លោក ចាន់ មុនី រួម មាន ៖
យ៉ាងណា ក៏ដោយ ការអត់ អាហារ នៅតែ មាន ដោយសារ មនុស្ស ជាច្រើន នាក់ គ្មាន លុយ គ្រប់គ្រាន់ ដើម្បី ទិញ អាហារ បរិភោគ ឬ ដី សំរាប់ ដាំ ដំណាំ ។
លោក ថា ចង់ ដូរ នាយក រដ្ឋមន្ត្រី ឬ រដ្ឋាភិបាល នោះ រង់ចាំ ការបោះឆ្នោត នៅ ៥ឆ្នាំ ខាងមុខ ទៀត មិន អាច បោះឆ្នោត មុន បាន ទេ ។
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក ភ្នំ គូលែន ៖
ខេត្ត នេះ ជា តំបន់ ដ៏ មាន ប្រជាប្រិយ ដែល ទាក់ទាញ ភ្ញៀវ ទេសចរ បរទេស …
តាមពិត កន្លែង ទាំងអស់ នេះ ជា របស់ លោក ឧកញ៉ា ពង់ ឃាវ សែ ដែល ជា មហាសេដ្ឋី ដ៏ មាន ឥទ្ធិពល នៅ កម្ពុជា មិន ចាញ់ ឧកញ៉ា ផ្សេង ៗ
យើង សង្ឃឹម ថា ព្រះមហាក្សត្រ នឹង ជួយ អន្តរាគមន៍ ដោះលែង គាត់ ។
របាយការណ៍ ក៏ បាន លើកឡើង ពី ការរៀបចំ ដែល រដ្ឋ កាត់បន្ថយ ពន្ធ ឱ្យ ក្រុមហ៊ុន រឺក៏ ការគេច ពន្ធ យក ប្រាក់ ចំណេញ ទៅ លាក់ ជាដើម ។
គោលដៅ ផ្សេង ទៀត របស់ លោក ត្រាំ បន្ទាប់ពី កាណាដា និង ម៉ិកស៊ិក
គេ ទាំង ពីរ ក៏ នាំគ្នា ដើរ សំដៅ ទៅ វត្ត វិញ ដែល មិត្តភ័ក្រ ទាំងពួង នឹង ឪពុក ម្តាយ របស់ គេ កំពុង រងចាំ ។
បន្ទាប់ពី មាន រដ្ឋប្រហារ នៅក្នុង ប្រទេស ថៃ កាលពី ឆ្នាំ ២០១៤ មាន ការបញ្ជូន ពលករ កម្ពុជា ចេញ ពី ប្រទេស ថៃ យ៉ាង ច្រើន ត្រឡប់មក កម្ពុជា វិញ ។
ទាំងនេះ តើ បទ ណា ដែល ធ្លាប់ ធ្វើឱ្យ ប្រិយមិត្តងប់ ងល់ ជាង គេ ?
ភាព ឆប គ្នា ចិញ្ចៀន
អាស្រ័យ ដូច ខាងលើ នាងខ្ញុំ ឈាង តៃ ស្រ៊ី ន និង ប្រជាពលរដ្ឋ ក្នុង ស្រុក កែវសីមា ទាំងមូល ដាក់ ពាក្យ បណ្តឹង ទៅ តុលាការ ដើម្បី ជួយ រក យុត្តិធម៌ ដល់ នាងខ្ញុំ និង ប្រជាពលរដ្ឋ ផង ចុះ ។
រឿងរ៉ាវ ខ្លះ នៃ អគារ សេតវិមាន សហរដ្ឋ អាមេរិក និង រូបភាព ដ៏ កម្រ បាន ឃើញ មួយចំនួន
បំបាត់ ចោល របប ចាប់ បង្ខំឱ្យ ធ្វើ រួម ហូប រួម
ស្ត្រី សម្រស់ ប្រើ រូបមន្ត១ នេះ រួច ស្បែក នឹង មិន ជ្រួញ ថែមទាំង តឹង ទៀតផង
នៅ មាន ភាព មិន ប្រក្រតី ជាច្រើន ទៀត ក្នុង ដំណើរការ សវនាការ ។
ឆ្នាំ នេះ សុខភាព មនុស្ស ឆ្នាំ កុរ រាង ចោទ បន្តិច ។
ទាំងនោះ ដល់ អ្នកដទៃ ។
លោក ឯ យ៉ិន អាយុ ៥៨ ឆ្នាំ មកពី ស្រុក មេសាង ខេត្ត ព្រៃវែង ។
ហើយក៏ ស្គាល់ សំឡេង របស់ មេទ័ព
