ប៉ុន្តែ ចូរយករបស់ដែលនៅក្នុងចាននោះទៅអ្នក ក្រ នោះអ្វី ៗនឹងបានបរិសុទ្ធចំពោះអ្នក
ដើម្បីឲ្យអ្នកមាន ប្រាជ្ញា ហើយកុំធ្វេសប្រហែស ។
គាត់និងក្រុមគ្រួសារទាំងមូលរីក រាយដោយ សារពួកគាត់ទាំងអស់គ្នាជឿលើព្រះ។
នេះ ត្រូវបាន ធ្វើ ដូច្នេះ ថា តំណ ភ្ជាប់ មិន បំបែក តាម ពេលវេលា ;
វាគឺជាដំណាក់របស់ព្រះ និងជាទ្វារនៃ ស្ថានសួគ៌ !» ។
ព្រះ មានព្រះហឫទ័យមេត្តា ក រុណាចំពោះអំពើទុច្ចរិតរបស់ខ្ញុំ ។
ចូរប្រាប់ជន ជាតិអ៊ីស្រាអែលថា ‹ អ្នក រាល់គ្នាជាមនុស្សរឹង ចចេស › ។
អ្នក នឹង ឃើញ ការមើល ជាមុន នៃ ធាតុ នោះ នៅក្នុង មជ្ឈមណ្ឌល បញ្ជា ។
ពួកគេមានអាថ៌កំបាំងដែលពួកគេមិនចែករំលែកជាមួយខ្ញុំ ។
ហើយ កុំ សុំ អង្គុយ ខាងក្រោយ ។
ព្រះ បានប្រទាន ពរដល់គាត់ ហើយប្រទាន រង្វាន់ដល់គាត់ ហើយបាននិយាយយ៉ាងខ្លាំងអំពីគាត់ ។
ហេតុអ្វីបានជាមិនគ្រាន់តែបង្ហាញខ្លួនដល់គ្រប់គ្នា ហើយទុកឱ្យអ្នក ជឿ និងអ្នកមិនជឿឃើញទ្រង់ដូចគ្នា ?
ពួកគេបានចាត់ទុកគាត់ដូចជាមនុស្សស្អប់ខ្ពើម ។
ឆ្ពោះ ទៅរក ព្រះ ដែល ជា កាតព្វកិច្ច ខ្ពស់ បំផុត នៃ សេចក្តីជំនឿ ។
“ អ្នកមិនដែលដឹងថាអ្នកពិតជាជឿអ្វីនោះទេ រហូតដល់ការ ពិត ឬការ មិនពិតក្លាយជាបញ្ហានៃជីវិត និងសេចក្តី ស្លាប់ ។
ដើម្បី ជួប អ្នក និង ដើម្បី មើលឃើញ ភាព ពេញលេញ នៃ ការអភ័យទោស របស់ អ្នក ។
តើគាត់នៅចាំទេថា គាត់បានចាប់អាជីពរបស់គាត់ដោយមិនយល់ស្របជាមួយឪពុកគាត់ទេ ?
អ៊ីចឹងបានដល់ពេលថ្ងៃ ជាកម្រិតខ្ពស់ដែលមិនអាចទៅរួច
មិន មែន និយាយ អំពី ការចង របស់ អ៊ីសាក ទេ ។
ឃាតកបាននិយាយថា គាត់បានរកឃើញព្រះ ហើយ ។
៣៦ ហើយកុំស្បថដោយក្បាលអ្នកឡើយ ព្រោះអ្នកមិនអាចធ្វើសក់មួយពណ៌ ស ឬខ្មៅបានឡើយ ។
ដូច្នេះ គេបានប្រព្រឹត្តចំពោះអ្នកតាមរបៀបដែលពួកគេបានធ្វើ ដោយសារ តែទំនាក់ទំនងរបស់យើងជាមួយពួកគេ ។
១២ ៤ ស្ដេចស្រុកអេស៊ីបមាន ប្រសាសន៍ទៅគេ ថា៖ « លោកម៉ូសេ និងលោកអើរ៉ុន ហេតុអ្វីបានជាអ្នកធ្វើឲ្យប្រជាជនឈប់ធ្វើការ ?
ពួកគេមានជីវិតឡើងវិញ ហើយនឹងធ្វើឲ្យពួកគេមិនអាច រលួយបាន
ធ្វើ ការងារ របស់ អ្នក ដោយ ស្ងប់ស្ងាត់ ។
« អ្នក ណាដែលតូចជាងគេនៅក្នុងនគរស្ថាន សួគ៌ នោះធំជាងគាត់ ។
គាត់បាននិយាយថា ហេតុអ្វីបានជាត្រូវរង់ចាំថ្ងៃអនាគត ?
បន្ទាប់មក គាត់ ត្រូវបាន គេ ផ្តល់ឱ្យ យ៉ាង ច្បាស់ ។
ពេត្រុសទូល ថា៖ « ទេ ព្រះ‌ អម្ចាស់អើយ ទូលបង្គំមិនដែលបរិភោគអ្វីដែលមិនបរិសុទ្ធ ឬមិនបរិសុទ្ធឡើយ » ។
ដូច្នេះយើងអាច កាន់កញ្ចក់ ដល់សហគមន៍របស់យើង ហើយពួកគេអាចមើលឃើញខ្លួនគេបានផ្លាស់ប្តូរដោយពន្លឺនៃព្រះ។
ដូចជាសម្គាល់ពីការ សប្បាយឬ ?
ប្រសិនបើ អ្នក មាន ភាពជឿជាក់ និង មាន ទំនុកចិត្ត លើ ខ្លួន ឯង នោះ អ្នក គឺជា បុរស ដែល សក្តិសម ធ្វើ អ្វី គ្រប់ យ៉ាង សម្រាប់ គាត់ ។
បេះដូងបានក្លាយជា ច្របូកច្របល់ ។
គាត់ប្រាប់ខ្ញុំថា មិន មែនតែអ្នកទេដែលឈឺចាប់ ។
« ខ្ញុំជឿថា លោក ហ៊ុន សែ នឹងជាប់ពន្ធនាគារ អស់មួយជីវិត ។
ហើយ បន្ទាប់មក អ្នក ត្រូវតែ កើត ជាថ្មី !
« ហើយពេលដែលខ្ញុំមក ឯបងប្អូនអើយ ខ្ញុំមិនបានមកដូចជាអ្នកពូកែខាងការ និយាយ ឬប្រាជ្ញា ដូចខ្ញុំបានប្រកាសដល់អ្នក រាល់គ្នានូវទី បន្ទាល់នៃព្រះ នោះទេ ។
សូមឲ្យអំពើ បាបរបស់អ្នកត្រូវបានសម្អាតដោយភ្លើង » ។
ពួកគេ ទាំងអស់ គ្នា មាន ពេលវេលា ដ៏ រីករាយ ជាមួយគ្នា ។
ប៉ុន្តែពេត្រុសនិងសាវ័កឆ្លើយ ថា៖ « ត្រូវស្តាប់បង្គាប់ព្រះជាជាងមនុស្ស ។
គ្មានអ្វីនៅសេសសល់ឲ្យអ្នកធ្វើឡើយ លើកលែង តែដើរតាមគាត់ ។
10 ពេលដែលអ្នក ដំបូង មកដល់ គេស្មានថានឹងទទួលបានច្រើនជាង ។ ពួកគេក៏ទទួលបានប្រាក់មួយដួងដែរ ។
ព្រះនឹង ផ្តល់ កំណើត ដល់ អ្វី ៗ ជាច្រើន នៅ ថ្ងៃ នេះ ។
យើង ស្គាល់ ពួកគេ ហើយ ចែករំលែក ជាមួយ ពួកគេ ។
នាងក៏ជាដៃឆ្វេង !
សេចក្តីថ្លៃថ្នូរ ; ហើយយើងនឹងមិនត្រូវបានគេបដិសេធនូវក្តីសុបិនរបស់យើងឡើយ ។
គ្រាន់តែ ទូរស័ព្ទ និង អ៊ីនធឺណិត ។
ហើយកូនចៅអ៊ីស្រាអែលជាច្រើននឹងគាត់ ( គឺ យ៉ូហាន ) បែរទៅរកព្រះអម្ចាស់ ជាព្រះ របស់ពួកគេ ។
កំណត់ ថា តើ ការទាមទារ ត្រូវបាន គ្របដណ្តប់ ក្រោម ការធានា
គាត់មាន ប្រសាសន៍មកខ្ញុំថា កុំត្រាប់តាមពាក្យទំនាយក្នុងសៀវភៅនេះឡើយ ដ្បិតពេលវេលាជិត មកដល់ហើយ ។
២៦ អ្នក រាល់គ្នាមិនជឿទេ ព្រោះអ្នកមិនមែនជាចៀមរបស់ខ្ញុំ ។
ចូរឲ្យភ្នែកគេងងឹតមើលមិនឃើញ ហើយឱនក្បាលចុះជានិច្ច ។
មានចែងទុកក្នុងគម្ពីរព្យាការីថា៖ « ហើយគេនឹងទទួលបានគ្រប់យ៉ាងពីព្រះ» ។
ពួកយើង ជាច្រើន បង្វែរ សេះ របស់ យើង ចេញ នៅពេល ថ្ងៃ នៅ ពេល ដែល អាកាសធាតុ អនុញ្ញាត ប៉ុន្តែ នាំ វា ត្រឡប់ ទៅជា ក្រោល វិញ នៅ ពេល យប់ ។
ឬថាភ្នែករបស់មនុស្សដែលទន់ខ្សោយនឹងបើកចំហ ហើយគ្មានអ្នក ណាឃើញពួកគេជាមនុស្សនៃព្រះ ទៀតទេ ?
២០ នៅ គ្រា នោះ លោក ម៉ូសេ បាន កើត មក ។ គាត់មានសម្រស់ស្រស់ស្អាតខ្លាំងណាស់ ហើយបានចិញ្ចឹមបីខែនៅផ្ទះឪពុកគាត់ ។
ប៉ុន្តែវាដូចជាវាកំពុងបង្កើតផ្លូវ ។
នាំគេឲ្យវង្វេង ហើយ នាំឲ្យដើរលើភ្នំ ។
អេសេគាលត្រូវផ្ដល់ការ ព្រមានពីព្រះដល់ពួកគេ ។
ហើយ ពួកគេ មាន ទម្រង់ សរសេរ ដោយ ដៃ ទាំងនេះ ច្រើន ក្រៃលែង ។
មានព័ត៌មានមួយចំនួន
ថែរក្សា នាង រហូតដល់ ខ្ញុំ ត្រលប់ មកវិញ ” ។
នៅ ពេល ដែល ដំណឹង មកដល់ ពួកគេ ។
ទោះ ជាយ៉ាង ណា អ្នក ណាដែលតូចជាងគេនៅក្នុងនគរស្ថាន សួគ៌ នោះធំជាងអ្នក នោះ ។
ទោះ ជាយ៉ាង ណា អ្នក ណាដែលតូចជាងគេនៅក្នុងនគរស្ថាន សួគ៌ នោះធំជាងអ្នក នោះ ។
ប៉ុន្តែ ព្រះបន្ទូលរបស់ព្រះ បានបន្តកើនឡើងជា លំដាប់ ។
អ្វីដែល បន្ទាប់មកគឺការ រៀបការ ជាមួយនឹងសេចក្ដី ស្រឡាញ់ក្នុងជីវិតរបស់ខ្ញុំនិង កំណើតនៃកូនប្រុសដ៏ អស្ចារ្យពីរនាក់។
តើបុរសនៅក្នុង ភាពគ្មានដែនកំណត់ជាអ្វី ? » ។
និង ការរំលឹក ផ្សេង ទៀត អំពី ភាពអស្ចារ្យ របស់ អ្នក ។
ពួកគេ ដឹង ពី អ្វី ដែល ធ្វើឱ្យ ពួកគេ បើក និង អ្វី ដែល ធ្វើឱ្យ ពួកគេ បិទ ។
« បន្ទាប់មក យ៉ូសែបបានចាត់គេឲ្យទៅ ហើយ អញ្ជើញយ៉ាកុបជាឪពុករបស់គាត់ និងញាតិសន្ដានទាំងអស់របស់គាត់ឲ្យមក ឯគាត់ សរុបទាំងអស់ចិត សិបប្រាំនាក់ ។
ពួកគេទាំងអស់គ្នានឹងបានដឹងពីសេចក្ដី ពិត ។
អ្នក នឹង ត្រូវបាន បង្ហាញ រូប ព្រះជាមួយនឹង តម្លៃ ផ្សេង ៗ ។
ប៉ុន្តែ បើសិនជាព្រះហឫទ័យព្រះ នោះត្រូវរងអំពើល្អ ជាជាងធ្វើអំពើអាក្រក់ ។
កូន មនុស្ស ត្រូវ រង ទុក្ខ យ៉ាង ខ្លាំង ។
យើង ត្រូវការ ពួកគេ ហើយ ពួកគេ ត្រូវការ យើង ។ '
គាត់បានឈ្លក់វង្វេងនឹងរឿងមួយដែលគាត់មិនបានយល់ ។
« ហើយពួកគេបាននិយាយព្រះបន្ទូលនៃព្រះ អម្ចាស់ទៅគាត់ជាមួយនឹងអស់អ្នកដែលនៅក្នុងផ្ទះរបស់គាត់ » ។
ដូច្នេះ វា ស្ថិត នៅក្នុង ទំនុកតម្កើង ។
សៀវភៅសុភាសិតបង្រៀនយើងថា៖ « អ្នក ណាដែល រកប្រពន្ធ នោះនឹងបានរបស់ល្អ ហើយបានការ ពេញ ចិត្តពីព្រះ យេហូវ៉ា » ។
ហើយចាក់ប្រេងវាចោល ។
ដកដង្ហើម ចេញ ពេល ពត់ ខ្លួន ហើយ មើល ទៅ ខាងស្តាំ ។
ដូច្នេះហើយ ពួកគេ បំផ្លាញ ។
ប៉ុន្តែ ស្នេហា គឺ អស្ចារ្យ បំផុត ។
នេះមិន មែនជាការ និយាយថាយើងមិនដោះស្រាយជាមួយអ្នកដែលនៅជុំវិញយើងដែលមិនជឿថាជាអ្នកមិនជឿនោះទេ ។
តើអ្វីជា សញ្ញានៃ គ្រាដែលអ្នកនឹង មកដល់ ?
យើង នឹង កំណត់ ដោយ យើង ម្នាក់ ៗ សម្រាប់ ខ្លួន គាត់
ដោយ សារជំនឿ ម៉ូសេ បានធំ ឡើង គាត់មិនព្រមទទួលស្គាល់ថាជាកូនរបស់ព្រះចៅផារ៉ោនទេ ។
សេចក្តី ល្អ ដែល ព្រះបាន បង្កើត ។
បច្ចុប្បន្ន កំពុង បើក ប៉ុន្តែ នឹង មាន
ទូលព្រះ‌ យេស៊ូ ថា៖ « ប្រសិនបើអ្នកនៅ ទីនេះ ប្អូនខ្ញុំមិនស្លាប់ទេ ។
ប៉ុន្តែអ្នកដែលព្រះ បានប្រោសឲ្យ រស់ឡើងវិញមិនឃើញការ ខូចខាតឡើយ ›» ។
ពួកគេបានចេញទៅផ្សព្វផ្សាយថា មនុស្សត្រូវការប្រែ ចិត្ត ។
អូ ទេ ទេ ទេ ទេ ។ ចក្រភពអង់គ្លេស សង្ឃឹមថានឹងបោះបង់ចោលទាំងស្រុង ។
ហើយ ភាគ ច្រើន នៃ ពួកគេ ចូល ទៅក្នុង ថ្ងៃ ជាមួយនឹង បញ្ជី ដែល ត្រូវ ធ្វើ ។
ហើយ បន្ទាប់មក បុរស លេង ប៉ាហី ត្រូវបាន គេ រកឃើញ ថា ត្រូវបាន គេ ចាក់ សម្លាប់ ។
ហើយ ពួកគេ បាន នាំយក មក ជាមួយ ពួកគេ វិញ នូវ ចង្កោម ទំពាំងបាយជូរ ដែល មាន ទំហំ ពិសេស ។
វា កំពុង បំផ្លាញ ភាពរីករាយ នៃ ការផ្សាយ ឡើងវិញ នៅពេល រសៀល ។
ដូចជា អ្នក ទាំងនេះ មិន ស្គាល់ សេចក្តីពិត នៃ បទបញ្ញត្តិ របស់ ខ្ញុំ ហើយ មិន រស់ នៅ តាម ពួកគេ ។
នៅ ឆ្នាំ ១៩៧៨ គាត់ បាន ក្លាយជា ប្រធាន កង វរសេនា តូច អង្គរក្ស ផ្ទាល់ របស់ ព្រះមហាក្សត្រ ។
វា មាន បួន ពណ៌ ពី ទិស ទាំង បួន ; គាត់សួរប្រជាជនថាតើនេះមកពីណា ?
ទុក វា ចោល - បន្ទាប់មក អ្នក មាន កន្លែង ដើម្បី បង្កើត អ្វី ដែល អ្នក ចង់បាន ។
ដូច្នេះ ចូរប្រយ័ត្នកុំឲ្យពន្លឺដែលនៅក្នុងខ្លួនទៅជាងងឹតឡើយ ។
តាមពិតលោក ពូទីន និយាយថា ស្នូដិន ជាមនុស្សមានសេរីភាព ។
ពួកគេ ទាំងអស់ សុទ្ធតែ ជា មនុស្ស ហើយ ពួកគេ ខ្លះ បាន ធ្វើបាប និង ធ្វើ ខុស ។
១១ អ្នក រាល់គ្នាដឹងហើយថា យើងបានប្រព្រឹត្តចំពោះអ្នក រាល់គ្នា ដូចជាឪពុកប្រព្រឹត្តចំពោះកូនរបស់ខ្លួន ។
មិនមែនម្នាក់ទៀតទេដែលគាត់សម្លាប់ ត្រាមួយទៅមួយដូចគាត់
« ប៉ុន្តែ ព្រះអម្ចាស់ទ្រង់មានព្រះហឫទ័យស្មោះត្រង់ ហើយទ្រង់នឹងពង្រឹង និងការពារអ្នកពីមេកំណាច ។
ប្រទេស ចិន ត្រូវបាន រៀបចំ ។
ខ្ញុំមិនគិតថាអ្នក ជាអ្នកសម្លាប់សត្វទេ !» ។
លទ្ធផល៖ « ដ្បិតអ្នក រាល់គ្នាបានបំភាន់ពាក្យរបស់ព្រះ ដ៏មានព្រះជន្មរស់ នៃព្រះ នៃពិភពទាំងមូល ជាព្រះ នៃយើង » ។
នាងបាននិយាយថា៖ « ខ្ញុំស្ថិតក្នុង ភាព តក់ស្លុត ពេញលេញ និង តក់ស្លុត ជាខ្លាំង ។
និងអ្នកស្គាល់គ្នាក្នុងសង្គម និងភរិយារបស់គាត់ ដែលបានផ្តល់ ស ក្ខីកម្មទាំងអស់
វា មិន ធ្វើឱ្យ មនុស្ស ក្លាយជា សត្វ ដែល គួរឱ្យ ស្អប់ បំផុត នៅលើ ផែនដី នោះ ទេ ។
នេះបើតាម សញ្ញាដែលលោកបានជួសជុល
ហើយដើម្បីឱ្យពួកគេអាចងើបឡើងវិញពីអន្ទាក់នៃអារក្សដែលត្រូវបានចាប់យកដោយគាត់តាមឆន្ទៈរបស់គាត់។
ដ្បិតខ្ញុំច្រណែននឹងអ្នក ដោយ ចិត្តច្រណែនព្រះ។ ដ្បិតខ្ញុំបានចាប់អ្នក ជាប្ដីតែមួយ ដើម្បីឲ្យខ្ញុំបានបង្ហាញអ្នក ជាស្ត្រីព្រហ្ម ចារីបរិសុទ្ធដល់ព្រះ គ្រីស្ទ ។
( ផ្ទុយទៅវិញ ) អ្នកដាំវានៅ ទីនោះដោយសេចក្ដី ជំនឿ និងដោយមានទំនុក ចិត្តថាវានឹងរីក ចម្រើន » ។
« ហើយគាត់នឹងបំប្លែងកូនចៅអ៊ីស្រាអែលជាច្រើនឲ្យទៅ ជាព្រះអម្ចាស់ ជាព្រះ របស់ពួកគេ » ។
« តើទ្រង់មានបំណងទៅ ណាដែលយើងមិនអាច រកទ្រង់ឃើញ ?
នៅពេលនៃការ ដាក់ពាក្យបណ្តឹងដើមនៃពាក្យបណ្តឹង qui tam ។
ហើយបានផ្ដល់ដំបូន្មានដល់ចៅហ្វាយ និង សង្ឃ ។
« តើអ្នក ទាំង ពីរនាក់ ណាចង់ឲ្យខ្ញុំដោះលែងអ្នក? »
គាត់នឹង បង្វែរកូនចៅអ៊ីស្រា ‌ អែលជាច្រើនមក ឯព្រះ‌ អម្ចាស់ ជាព្រះ របស់ពួកគេ ។
44 « តើអ្នក រាល់គ្នាអាចជឿបានយ៉ាងដូចម្ដេចបានជាអ្នកដែលទទួលសិរី ‌ រុងរឿងពីគ្នាទៅវិញទៅមក ហើយមិនស្វែង រកសិរី ‌ ល្អដែល មកពីព្រះតែមួយ ?
ព្រះ យេស៊ូមាន បន្ទូលថា៖ « ប៉ុន្តែអ្នក រាល់គ្នាមិនត្រូវហៅថា «រ៉ាប៊ីទេ » ដ្បិតអ្នក រាល់គ្នាមានចៅហ្វាយ តែមួយគត់ ហើយអ្នកទាំងអស់គ្នាជាបងប្អូននឹងគ្នា » ។
ហើយគេនិយាយថា ' សម្រាប់ការ ដាក់ទោស ពួកគេកំពុង តែព្យាយាមដាក់ទោសពួកយើង » ។
តើអ្នកឈឺនឹងការ ធ្វើជាទាសកររបស់សាតាំង ហើយអ្នកចង់បានសេរីភាពនៃកូនព្រះ ឬ ?
នឹង ត្រូវបាន ផ្ទុកពី និង រក្សាទុក ទៅ តាម លំនាំ ដើម ។
ដូច្នេះ លោកម៉ូសេ បានលាតដៃទៅ កាន់វា នោះវាក្លាយទៅជាដំបងនៅក្នុងដៃ ។
ជាប្រយោជន៍ដល់អស់អ្នកដែលគាត់រៀបនឹងទាក់ ទងនឹងអ្នក បន្ទាប់មក ។
ក្មេងស្រី ទី 3 ក្នុង គ្រួសារ របស់ ពួកគេ ។
“ ខ្ញុំនឹងចេញទៅ ហើយអ្នកនឹងស្វែង រកខ្ញុំ ហើយអ្នកនឹងស្លាប់ក្នុងអំពើ បាបរបស់អ្នក ។
ការនិយាយ នៅក្នុង ព្រះវិហារ គឺ ត្រឹមត្រូវ ។
បងប្អូន បាន ជួបជុំគ្នា វិញ នឹង មាន សន្តិភាព ។
ហើយ ដាក់ វា នៅ ខាងស្តាំ ខាងលើ នៃ ទម្រង់ របស់ អ្នក ។
ឆ្អឹងរបស់អ្នកដែលបានស្លាប់ជាច្រើនខែមុន ដែលសាច់មាន
អ្នកណា ដែល ប្រុងប្រៀប ហើយ មាន ប្រាជ្ញា ( ជំនឿ ) ហើយ ធ្វើ ( សេចក្តីស្មោះត្រង់ ) នោះ សេចក្តីស្មោះត្រង់ នោះ រមែង បាន រង្វាន់ ។
ភ្លៀង បាន បង្អុរ ចុះ មក ។ ពិតណាស់វាពិតជាណាស់ ។
ដប់ ប្រាំមួយ ឆ្នាំ មុន ក្រសួង ការពារ ជាតិ អាមេរិក បាន រង ការវាយប្រហារ ។
១១ ព្រះ យេហូវ៉ាមាន ប្រសាសន៍មកខ្ញុំថា៖ « កុំអធិដ្ឋានសុំសេចក្ដី ល្អពីមនុស្សទាំងនេះឡើយ ។
គាត់បានរង់ចាំរហូតដល់សំឡេងគ្រហឹមបានស្ងប់ ។
តាម ផ្លូវ ទៅ ផ្ទះ ខ្ញុំ ប្រាប់ គាត់ ថា ខ្ញុំ ស្រលាញ់ គាត់ ។
ចំពោះអ្នកឯទៀត ៗ ខ្ញុំសូមនិយាយ ( ខ្ញុំមិន មែន ជាព្រះអម្ចាស់ទេ ) ថាប្រសិនបើបងប្អូន ណាមានប្រពន្ធជាអ្នកមិនជឿ ហើយនាងយល់ព្រមរស់ នៅជាមួយគាត់ នោះគាត់មិនត្រូវលែងលះគ្នាឡើយ ។
ចំពោះអ្នកឯទៀត ៗ ខ្ញុំសូមជម្រាបថា បើបងប្អូន ណាមានប្រពន្ធជាអ្នកមិនជឿ ហើយយល់ព្រមរស់ នៅជាមួយគាត់ នោះគាត់មិនគួរលែង លះគ្នាឡើយ ។
បងប្អូន ជាទីគោរព សុំ ការអត់ទោស របស់ ទ្រង់ ដើម្បីឲ្យ អ្នក បាន អត់ទោស ព្រោះ អ្នក ដែល ត្រូវបាន លើកលែង ទោស នឹង ក្លាយជា អ្នក ជោគជ័យ ។
6 ប៉ុន្តែអ្នកមានរបស់នេះ ដែលអ្នកស្អប់ការ ប្រព្រឹត្តរបស់ពួក នីកូឡាស ដែលខ្ញុំក៏ស្អប់ដែរ ។
ម្យ៉ាងទៀត យើងជា រាស្ដ្ររបស់ព្រះនាំ មកនូវសេចក្ដី សុខសាន្តដល់អ្នកដែលមិនទាន់បានឮដំណឹង ល្អ ។
នឹង មាន អ្នក ដែល និយាយ ទៅកាន់ អ្នក ថា
មិនអាចតាមយើងទាំងពីរបានទេ ដូច្នេះគាត់ក៏ដើរតាមខ្ញុំ ។
បុរស ម្នាក់ ទៀត ស្ថិត ក្នុង ស្ថានភាព ធ្ងន់ធ្ងរ ។
« ព្រះអម្ចាស់ អើយ ទូលបង្គំ មិន សម នឹង ព្រះអង្គ មក នៅក្រោម ដំបូល ទូលបង្គំ ទេ សូម និយាយ តែ ពាក្យ ប៉ុណ្ណោះ នោះ អ្នក បំរើ របស់ ព្រះអង្គ នឹង បាន ជាសះស្បើយ » ។
អ្នក ទាំងនោះមកពីកុលសម្ព័ន្ធយូដា ។
បានក្លាយទៅជា សញ្ញាអាក្រក់ ខណៈដែលថ្ងៃ ស ប្ប័ទនៅពាក់ ក ណ្តា លនៃខែ ត្រូវបានធ្វើឡើងមួយ
ដូច្នេះ ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « ពេលវេលាត្រឹមត្រូវសម្រាប់ខ្ញុំមិនទាន់ មកដល់ទេ ដ្បិតអ្នក រាល់គ្នាត្រូវពេល ណាក៏ដោយ » ។
ក៏ ដូចជា ប្រជាជន ; ទ្រព្យសម្បត្តិ របស់ ពួកគេ ។
11 វេទនា ដល់មនុស្សអាក្រក់ នោះនឹងទៅជាអាក្រក់ចំពោះគេ ដ្បិតអំពើដែលគេបានធ្វើនឹងកើតដល់គេ ។
គាត់បាននិយាយថា ‹ នេះ ជារបៀបដែលខ្ញុំត្រូវបានបង្គាប់ឲ្យប្រព្រឹត្តជាមួយនឹងប្រជាជននៃផ្ទះរបស់ហោរា› ។ "
« ខ្ញុំប្រាប់អ្នក រាល់គ្នាជាប្រាកដថា អ្នកកំពុងស្វែង រកខ្ញុំ មិនមែនដោយ សារអ្នក រាល់គ្នាបានឃើញទីសំគាល់ទេ ប៉ុន្តែដោយ សារអ្នកបាន ស៊ីនំបុ័ងពេញហើយ ។
សេចក្តីសុចរិត - ខ្ញុំ ចង់ ស្វែងរក សេចក្តីសុចរិត ។
ដើម្បីដឹងថាតើព្រះសព្វព្រះទ័យនឹងអ្នក កាន់សាសនាឬអត់ ?
ទាំងប្រាំពីរយ៉ាងនេះហើយជាព្រះនេត្ររបស់ព្រះ អម្ចាស់ ដែលធ្វើដំណើរពាសពេញផែនដី » ។— សាការី ៤:១០
តើ អ្នកណា នឹង បង្រៀន ខ្ញុំ អំពី ពិភពលោក ?
ហើយពួកគេបានបង្កើត ជាកងទ័ព ហើយតាំង ចិត្តយកគាត់ចុះ ។
17 ប៉ុន្តែសូមអរព្រះគុណដល់ព្រះ ដែលអ្នក រាល់គ្នាជាអ្នក បម្រើនៃអំពើ បាប ប៉ុន្តែបានស្តាប់តាមអស់ពី ចិត្ត ដល់ទម្រង់នៃគោល លទ្ធិនោះ ដែលអ្នកត្រូវបានរំដោះ ។
បកប្រែ ជា សៀវភៅ ភាសា អង់គ្លេស ។
យើង នៅ ទីនេះ ដើម្បី ស្នាក់ នៅ រយៈពេល យូរ ។
ខ្ញុំ បាន ដឹង ថា វា គឺ ដោយសារតែ ព្រះនៅក្នុង ខ្ញុំ ។
និង មួយ ថ្ងៃ នៅក្នុង ទី ជ្រៅ ; ក្នុង ដំណើរ -! នៅក្នុងសួនច្បារគែត សេម៉ានី នៅពេលនោះ ។
មិនថាពួកគេបានធ្វើអ្វី ឬមិនបានធ្វើនៅក្នុងជីវិតរបស់ពួកគេឡើយ ។
ពេលនិយាយពី ភាពបរិសុទ្ធ តើអ្នក ជាអ្នកដើរតាមច្បាប់ឬ ?
« ហេតុអ្វីបានជាអ្នកស្វែង រកខ្ញុំ ? ... តើអ្នកមិនដឹងថាខ្ញុំត្រូវនៅក្នុងដំណាក់បិតារបស់ខ្ញុំឬ ? »
៦ ប៉ុន្តែ សេចក្ដី សុចរិតដែល មកពីសេចក្ដី ជំនឿពោលថា « កុំនិយាយក្នុង ចិត្តថា ‹ តើអ្នក ណានឹងឡើងទៅស្ថាន សួគ៌ › ។ ( នោះ គឺ នាំ ព្រះមេស្ស៊ី ចុះ )
ចូរប្រាប់អស់អ្នកដែលទាយតាមការស្រមៃរបស់ខ្លួនថា ចូរស្ដាប់ព្រះ‌បន្ទូលរបស់ព្រះ‌ អម្ចាស់ !
ប៉ុន្តែ បន្ទាប់ពីពួកវាឈានដល់ទំហំជាក់លាក់មួយ ផ្លែក៏ចាប់ផ្ដើម ។
តោះ ចាប់ផ្តើម ត្រូវការ
ហើយសូមព្រះប្រទានឲ្យគាត់នូវការ បម្រើជាច្រើនឆ្នាំទៀតដល់សហគមន៍របស់យើង ។
« ចូរចាកចេញពីខ្ញុំ អ្នកត្រូវបណ្ដា សា ឬមក ឯខ្ញុំ ហើយទទួល ពរ » ។
គ្មាននរណាម្នាក់នៅស្ថាន សួគ៌ ឬនៅលើផែនដី ឬនៅក្រោមផែនដីអាចបើកក្រាំងនោះ ឬសូម្បីតែមើលទៅក្នុងវាបានឡើយ ។
គាត់បានពន្យល់ ថា៖ « ពេលវេលានឹងប្រាប់ ។
ខ្ញុំមិនមែនមកហៅមនុស្សសុចរិតទេ គឺមកហៅមនុស្សមាន បាបឲ្យ ប្រែ ចិត្ត » ( លូកា ៥: ៣២) ។
ជន ជាតិអេស៊ីបបាន រត់ទៅរកវា ហើយព្រះ‌ អម្ចាស់បានវាយពួកគេទៅក្នុងសមុទ្រ ។
ហើយ ពួកគេ បាន ជឿ លើ ទីបន្ទាល់ របស់ ពួកគេ ។
« មានហ្វូងមនុស្សយ៉ាងច្រើនដើរតាមទ្រង់ពីស្រុកកាលីឡេ » ។
