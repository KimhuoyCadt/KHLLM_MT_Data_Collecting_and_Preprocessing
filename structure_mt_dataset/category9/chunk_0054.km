ចាប់ពីថ្ងៃនោះមក ជីវិត ដៃជើង និងកិត្តិយសរបស់ផែនដី ។
កំហុស ដែល ជៀស មិន រួច នឹង ត្រូវបាន គូសបញ្ជាក់
ព្រះអង្គដែលចាត់ខ្ញុំឲ្យមក គង់នៅ ជាមួយខ្ញុំ ។ ទ្រង់មិនបានទុកឲ្យខ្ញុំនៅម្នាក់ឯងឡើយ ដ្បិតខ្ញុំតែងតែធ្វើអ្វីដែលគាប់ព្រះហឫទ័យទ្រង់ » ។
៩ ដូច្នេះ តើពរ ជ័យនេះមាន តែលើអ្នកកាត់ស្បែក ឬក៏បានមកលើអ្នកមិនកាត់ស្បែក ? យើងនិយាយថា ជំនឿបានចាត់ទុកលោកអប្រាហាំថាជាសេចក្ដី សុចរិត ។
៤២ ព្រះយេស៊ូត្រាស់ហៅគេមក ហើយមានព្រះបន្ទូលទៅគេ ថា៖ « អ្នក រាល់គ្នាដឹងហើយថា អ្នកដែលចាត់ទុកជាអ្នកគ្រប់គ្រងរបស់ សាសន៍ ដទៃ ត្រួតត្រាលើគេ ហើយអ្នកដែលមានឋានៈខ្ពស់ កាន់អំណាចលើគេ ។
វា មិន សំខាន់ ទេ ប្រសិនបើ អ្នក បរាជ័យ ។
គាត់ឆ្លើយថា ពេលនោះ មានភ្លើងមករកខ្ញុំ ។
តើ អ្នក ចូលចិត្ត ផ្តល់ ការណែនាំ និង ការណែនាំ ដល់ អ្នកដទៃ ទេ ?
ខ្ញុំ បាន បោះឆ្នោត ឱ្យ កាតា ព្រោះ វា ដល់ ពេល ទៅ ប្រទេស មួយ នៅក្នុង ផ្នែក នៃ ពិភពលោក នោះ ។
គ្មាន អ្នកណា ដឹង ពី ចំណេះដឹង និង ជំនាញ របស់ អ្នក ល្អ ជាង អ្នក នោះ ទេ ។
ឱ ព្រះអម្ចាស់ អើយ យើងខ្ញុំ បាន ទាយ ក្នុង នាម ព្រះអង្គ ហើយ ដេញ អារក្ស ក្នុង ព្រះនាម ព្រះអង្គ ហើយ បាន ធ្វើអព្ភូតហេតុ ជាច្រើន ក្នុង នាម ព្រះអង្គ ។
42 ដ្បិតមនុស្សសុចរិតនឹងឃើញ ហើយនឹងអរ សប្បាយ ហើយមនុស្សអាក្រក់ទាំងអស់នឹងបិទថ្គាម ។
ហើយអ្នកបាននិយាយទៅ កាន់គាត់ថា : « ប៉ុន្តែបានតាំងស្តេចលើយើង » ។
ទ្រង់ គឺជា អ្នក ដែល ស្បៃ មុខ ពី ការបរបាញ់ របស់ ទ្រង់ ហើយ ពន្យល់ អ្នកដទៃ ។
៤ ខ្ញុំនិយាយដូច្នេះ ដើម្បីកុំឲ្យអ្នក ណាបោកបញ្ឆោតអ្នកដោយអំណះអំណាងដែលបញ្ចុះបញ្ចូល ។
ការបង្រៀន របស់ ខ្ញុំ មិន មែន ជា របស់ ខ្ញុំ ទេ ។ គឺទ្រង់ដែលបានចាត់ខ្ញុំ មក » ។
ធ្លាក់ចូលនឹងមិនស្រួល ប៉ុន្តែមិនបណ្តាលឲ្យស្លាប់យ៉ាងសាហាវនោះទេ ។
ប្រឆាំង នឹង អស់ អ្នក ដែល លះបង់ ទ្រង់ ។
ដល់ ចំណុច កំពូល នៃ ភាពជោគជ័យ ដែល មិន អាច ប្រៀបផ្ទឹម បាន ។
អ្វីដែលធ្វើឲ្យពួកគេដាច់ពីមនុស្សគឺថាពួកគេគ្មានវិញ្ញាណ ។
ច្បាប់របស់លោកម៉ូសេ ដល់មនុស្សទាំងអស់ ។
តើយើងនឹងចាប់ផ្ដើមរើសអើងពួកគេដោយ សារ តែជំនឿរបស់ពួកគេឬ ? » ។
ទ្រង់បាន នាំខ្ញុំទៅក្នុង ភាពងងឹត មិនមែនទៅក្នុងពន្លឺទេ ។
ដើមអូលីវទាំងពីរនេះ គឺជាជើង ចង្កៀងពីរ ដែលឈរនៅចំពោះព្រះ‌ អម្ចាស់នៃផែនដី ។
ដែលបានប្រកាសខ្លួនគាត់ថាបានសម្រេចតាមទំនាយរបស់អេសាយ ។
ឥឡូវនេះ ខ្ញុំ ត្រូវការ ងូតទឹក ។
បឹង ភ្លើង គឺជា ការស្លាប់ ទី ពីរ ។
ខ្ញុំដឹងថាអ្នក ជានរណា ; អ្នក គឺជាព្រះ ដ៏វិសុទ្ធរបស់ព្រះ!» ។
គេមើលទៅគាត់ ហើយនៅស្ងៀម ។
« ចិននឹងមិនអាចក្លាយជាអាមេរិកផ្សេងទៀតឡើយ » ។
ពួកគេ មិន មែន ជា សាសនា ត្រឹមត្រូវ ទេ ។
( លូកា ១:១៦ ) ហើយកូនចៅអ៊ីស្រាអែលជាច្រើននឹងបែរទៅរកព្រះ យេហូវ៉ាជាព្រះ របស់ពួកគេ ។
ពីព្រោះពួកគេបាន លះចោលសម្ពន្ធ មេត្រីនៃព្រះអម្ចាស់ ជាព្រះ របស់ពួកគេ ។
19 ប៉ុន្តែដោយ សារមានហ្វូងមនុស្ស ពួកគេមិនអាច នាំគាត់ទៅ ឯព្រះ យេស៊ូបានទេ ។
ដ្បិតគេបានបង្ហូរឈាមពួកបរិសុទ្ធ និងពួកហោរារបស់ទ្រង់ ហើយទ្រង់បានឲ្យឈាមគេផឹកតាមដែលពួកគេ សម » ។
23 បើឯងធ្វើ បាបគេ គេនឹងស្រែក រកអញ ហើយអញនឹងឮសំរែករបស់គេ
ទំនុកតម្កើង 62:11 ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលម្ដងហើយ ទូលបង្គំបានឮពាក្យនេះពីរ ដង៖ ឫ ទ្ធានុភាព ជារបស់ព្រះ។
យើងនឹង នាំពួកគេចេញពីស្រុកដែលគេ រស់នៅ ប៉ុន្តែគេមិនចូលទៅក្នុងទឹកដីអ៊ីស្រា ‌ អែលឡើយ ។
ហេតុ អ្វី បានជា អ្នក ចង់ ឃើញ ការរីកលូតលាស់ , រីកចម្រើន ,
សម្រាប់ សូម្បីតែ អ្នក ដែល ត្រូវបាន កាត់ ស្បែក មិន រក្សា ច្បាប់ នោះ ទេ ប៉ុន្តែ ពួកគេ ចង់ឱ្យ អ្នកកាត់ ស្បែក ដើម្បីឱ្យ ពួកគេ អាច មាន អំនួត តាមរយៈ សាច់ របស់ អ្នក ។
" តើវានឹងត្រូវការ អ្វីសម្រាប់ប្រជាជនដើម្បី ទុក្ខលំបាករបស់ប្រជាជននៅ មជ្ឈិមបូព៌ា? "
៤ ព្រោះសេចក្ដី ស្រឡាញ់របស់ខ្ញុំ គេ ជា ស ត្រូវរបស់ខ្ញុំ ប៉ុន្តែខ្ញុំលះបង់ខ្លួនខ្ញុំដើម្បីអធិស្ឋាន ។
« សូមឲ្យពួកគេដឹងពីអំពើគួរស្អប់ខ្ពើមរបស់ឪពុកគេ » ។
18 ដូច្នេះ គេសួរថា តើនេះជាអ្វីដែលគាត់និយាយថា បន្តិចទៀត ? យើង មិន អាច យល់ ពី អ្វី ដែល គាត់ និយាយ បាន ទេ ។
ព្រះ បានដាក់ពួកគេនៅក្នុងឋានៈជាសិទ្ធិអំណាចសម្រាប់ពួកគេដើម្បីមើលថែប្រជាជនរបស់ពួកគេ ។
រថយន្តក្រុង ទាំងអស់ មាន លក្ខណៈ សម្បត្តិ ដូចគ្នា ប៉ុន្តែ តម្លៃ អចលន ទ្រព្យ ខុសគ្នា ពី រថយន្ត មួយ ទៅ រថយន្ត មួយ ។
ជារៀងរាល់ថ្ងៃ ហើយពួកគេមានគណៈ កម្មាធិការមួយពិនិត្យមើលបញ្ហានោះក្នុងសហគមន៍ ។
ជំហាន ឆ្ពោះ ទៅរក ស្តេរ៉េ អូ ។
ប៉ុន្តែ វា ច្បាស់ ណាស់ ថា ពួកគេ បាន លះបង់ ចំពោះ គ្នា ទៅ វិញ ទៅមក ។
ទ្រង់បានលេចមកឲ្យគេឃើញក្នុង រយៈពេលសែសិបថ្ងៃ ហើយមាន បន្ទូលអំពីព្រះរាជ្យនៃព្រះ» ។
លោកបានមាន ប្រសាសន៍ថា៖ « ខ្ញុំនឹងដាក់ឲ្យប្រាកដនៅថ្ងៃនេះថា គ្រោងឆ្អឹងទន្សាយ ណាមួយត្រូវបានយកចេញជា បន្ទាន់ » ។
ពី អ្វី ដែល ទាំងអស់ កើតឡើង ។
អ៊ីស្រា ‌ អែលអើយ បើឯងចង់ស្តាប់ខ្ញុំ !
ហើយត្រូវផ្សព្វផ្សាយដល់សត្វលោកទាំងអស់ ។
អ្វីដែលពួកគេត្រូវនិយាយ៖ « យើងមានជំនឿលើលោក ។
គឺជាកូនរបស់ព្រះ ដោយការ គោរព និង ភាពបរិសុទ្ធ ។
ប្រហែលជាអ្នកធ្លាប់ឮពីឪពុកគាត់ ?
នេះ គឺជា បុរស ដែល អ្នក ទុកចិត្ត ។
កុំធ្វើដូចគេឡើយ ព្រោះបិតារបស់អ្នកដឹងច្បាស់
ម៉ូសេ និងអើរ៉ុនបានទៅជួបព្រះចៅផារ៉ោន ...
« គាត់លេចធ្លោដោយសារចំណេះដឹងរបស់ គាត់ ។
គ្មានខ្មាំង ស ត្រូវ ណាម្នាក់អាចទប់ទល់នឹងពួកគេបានឡើយ ដ្បិតព្រះអម្ចាស់បានប្រគល់ខ្មាំង ស ត្រូវទាំងអស់មកក្នុងកណ្ដាប់ដៃរបស់ពួកគេ ។
