“ គ្រួសារខ្ញុំគឺជាមិត្ត ភក្តិ តែមួយគត់របស់ខ្ញុំ ហើយខ្ញុំស្រឡាញ់ពួកគេយ៉ាងខ្លាំង ។
ដូច្នេះកុំបោះ បង់ចោលនូវទំនុក ចិត្តរបស់អ្នក វានឹងទទួលបានរង្វាន់យ៉ាងខ្លាំង ។
ទ្រង់ យេស៊ូវ / ព្រះយេស៊ូវ គឺជា ការសម្រេច នៃ ទំនាយ ពី បុរាណ ទាំងអស់ អំពី ទ្រង់ ។
ខ្ញុំ ជឿគ្រប់យ៉ាងដែលស្របនឹងក្រឹត្យ វិន័យ និងដែលមានចែងទុកក្នុងគម្ពីរព្យាការី ហើយខ្ញុំមាន សង្ឃឹមលើព្រះ ដូចមនុស្សទាំងនេះដែរ ថានឹងមានជីវិតរស់ឡើងវិញទាំងមនុស្សសុចរិត និងមនុស្សទុច្ចរិត » ។
គាត់បាននិយាយថា “ មិនមែនជាអ្នកបោះបង់ចោលក្នុងគ្រួសារនេះទេ ។
' អ្នកអស្ចារ្យ ទាំងអស់ នៅ ពេល ដែល ពួកគេ ឆ្លងកាត់ វា គឺជា ការបើក ភ្នែក ។
នេះ បាន ដើរ តួយ៉ាង សំខាន់ ក្នុង ការអនុវត្ត ផលិតផល ចិន ទូទាំង ពិភពលោក ហើយ ពួកគេ មិន ទន់ខ្សោយ ដូច ពីមុន នោះ ទេ ។
ត្រូវធ្វើតាមសេចក្ដី ទាំងប៉ុន្មានដែលមានចែងទុកអំពីយើង » ។
ហើយម្នាក់ ៗនឹងមិនចាំ បាច់បង្រៀនជន ជាតិរបស់ខ្លួន ឬបង្រៀនបងប្រុសថា “ ស្គាល់ព្រះ‌ អម្ចាស់ ” ព្រោះគេនឹងស្គាល់ខ្ញុំទាំងអស់គ្នា ចាប់តាំងពីតូចរហូតដល់ធំបំផុត ។
ធ្វើដូច្នេះ ដោយ សារគេមិនបានស្គាល់ព្រះបិតា ឬខ្ញុំ ។
ហើយខ្ញុំបានឃើញ ហើយខ្ញុំបានធ្វើជាសាក្សីថា នេះជាព្រះរាជ បុត្រានៃព្រះ» ។
អ្នក តែងតែ អាច រៀន បន្ថែម ពី អ្នកដទៃ ។
ចូរដេញតាមសេចក្ដី សុចរិត សេចក្ដី ជំនឿ សេចក្ដី ស្រឡាញ់ និងសេចក្ដី សុខ សាន្ដ រួមជាមួយនឹងអស់អ្នកដែលអំពាវនាវដល់ព្រះអម្ចាស់ដោយ ចិត្តបរិសុទ្ធ ។
អ្នកប្រើប្រាស់ ជា root មាន សិទ្ធិ ចូល ទៅកាន់ ក្របខ័ណ្ឌ ប្រព័ន្ធ ប្រតិបត្តិការ ទាំងមូល ហើយ អាច ធ្វើ អ្វី បាន ទាំងអស់ ។
រង្វាស់ របស់ មនុស្ស ឬ ចំនួន មនុស្ស ស្មើនឹង ទេវតា ។
ពួកគេបានជ្រើស រើសយកទោសរបស់ខ្លួនចំពោះអំពើ បាប ។
[ នេះជា កិច្ចការផ្ទាល់ខ្លួនរបស់ព្រះ ដែល ជាមនុស្ស
គ្មាននរណាម្នាក់បានឡើងទៅស្ថាន សួគ៌ឡើយ លើកលែង តែព្រះអង្គដែលយាងចុះពីស្ថាន សួគ៌ ជាបុត្រមនុស្ស ។
ហើយទ្រង់ផ្ដួលរំលំពាក្យរបស់អ្នក រំលង ។
អ្នក នឹង ក្លាយជា ស្តេច នៅ ពេល ក្រោយ ។
ដូច្នេះ យើង អាច ថ្វាយបង្គំ គាត់ បាន ។
និង បាន កត់សម្គាល់ នៅលើ ផែនការថែទាំ ថែទាំ ។
ពេលព្រឹកនិងពេលល្ងាច ហើយមិនត្រូវប្រយ័ត្នឡើយ ។
គាត់គឺជាខ្សែប្រយុទ្ធអាត់ ដែលសមត្ថភាពត្រូវបានគេទទួលស្គាល់ដោយអ្នក ណាក៏ដោយ » ។
" សូម ប្រាប់ កូន របស់ អ្នក ថា ពិភពលោក កំពុង ផ្លាស់ប្តូរ ជារៀងរាល់ ថ្ងៃ ហើយ គ្មាន នរណា ម្នាក់ នឹង រង់ចាំ អ្នក ពី អតីតកាល នោះ ទេ ។
គុណ វុឌ្ឍិ ដែលត្រូវហៅថាជាពួកបរិសុទ្ធគឺការ ទទួលបានព្រះ។
មុន គាត់ ទៅ គ្រប់ ទីក្រុង និង កន្លែង ដែល គាត់ ត្រូវ ទៅ ។
ពួកគេ នឹង ត្រូវបាន យល់ ហើយ ពួកគេ នឹង អនុវត្ត
ប្រាប់ ខ្ញុំ អាប ។ អ្នក
លោកបាននិយាយថា៖ « មុននឹងបន្តទៅទៀត ខ្ញុំចង់ផ្ញើ មរណទុក្ខ ដល់បងប្រុសរបស់ខ្ញុំ។
ពួកគេ បាន ក្លាយជា បុរស ដ៏ អស្ចារ្យ នៃ ការអធិស្ឋាន ។
28 ប៉ុន្តែទ្រង់មានព្រះ‌បន្ទូល ថា៖ « ដូច្នេះទៀត អ្នក ណាដែលឮព្រះ‌បន្ទូលនៃព្រះ ហើយ កាន់តាមនោះ មាន ពរហើយ !
បទគម្ពីរចែងថា៖ « អ្នក ណាដែលជឿលើទ្រង់នឹងមិនត្រូវអាម៉ាស់ឡើយ » ។
ខ្ញុំ បាន ញ៉ាំ អ្វី ដែល ខ្ញុំ ចូលចិត្ត ។
ដូច្នេះអ្នកដែលគេងមិនលក់ស្រួល និងមានបញ្ហាពេលយប់ ។
ការ យល់ពីខ្លឹមសារនៃអាយ៉ាតនីមួយ ៗគឺដូចជាការ បង្ហូរឈាម ។
ម៉េចមិនឲ្យភ្លើង និងទឹកដល់គេ ? » ។
ហើយយើងធ្វើខ្លួន ជាអ្នក រំលង ។
ពិតប្រាកដ ណាស់ យើង ខ្លួន ឯង គឺជា សាក្សី ដ៏ សំខាន់ ចំពោះ ទ្រង់ ។
ជួយ ខ្ញុំ ផង បងប្អូន ។
« ចូរប្រយ័ត្នកុំឲ្យវង្វេងឡើយ ដ្បិតនឹងមានមនុស្សជាច្រើនមកក្នុងនាមខ្ញុំ ហើយនិយាយថា ' ខ្ញុំនេះហើយ !' « ជិត ដល់ ពេល ហើយ !'
បងប្អូនរបស់លោកយេស៊ូមាន ប្រសាសន៍ទៅគាត់ ថា៖ « អ្នកត្រូវចាកចេញពីទីនេះទៅស្រុកយូដា ដើម្បីឲ្យអ្នក កាន់តាមបានឃើញការ អស្ចារ្យដែលអ្នកធ្វើ ។
25 គេសួរគាត់ ថា៖ « ចុះ ហេតុអ្វីបានជាអ្នកធ្វើបុណ្យជ្រមុជទឹក បើអ្នកមិនមែនជាព្រះ‌គ្រិស្ដ ឬអេលីយ៉ា ឬជាព្យាការី » ។
៣១ ពេលគាត់ចេញទៅ នោះព្រះយេស៊ូមានព្រះបន្ទូល ថា៖ « ឥឡូវនេះកូនមនុស្សបាន ត ម្កើងឡើង ហើយព្រះជាម្ចាស់ក៏សំដែងសិរី រុងរឿងក្នុងព្រះអង្គ ។
វា បែងចែក រវាង គោលការណ៍ ទាំង ពីរ ។
ពេលនោះ ទ្រព្យ សម្បត្តិរបស់ប្រជាជាតិជុំវិញនឹងប្រមូល ផ្ដុំគ្នា មានមាស ប្រាក់ និងសម្លៀក បំពាក់ ជាបរិបូរ ។ អានបន្ថែម ។
វា ដូចជា សួនច្បារ នៅក្នុង កែវ ។
បើមិនដូច្នោះទេ ថ្ងៃនោះនឹងក្លាយទៅ ជាក្រៀមក្រំ ។
« ហេតុអ្វីបានជាសិស្សរបស់អ្នកមិនរស់នៅតាមទំនៀម ទម្លាប់របស់អ្នកចាស់ទុំ ជាជាងបរិភោគអាហារដោយដៃមិនស្អាត ?
ខ្ញុំ បាន នៅ ជាមួយ គាត់ កាលពី ប្រាំពីរ ឆ្នាំ មុន ។
ដូច្នេះ ម៉ូសេ ក៏ដាក់ដៃក្នុងហោប៉ៅរបស់គាត់ ហើយពេលគាត់ដកវាចេញ វាកើតឃ្លង់ ។
តើយើងគួរបន្តរស់នៅក្នុងអំពើ បាបដើម្បីឲ្យព្រះគុណរបស់ព្រះ កើនឡើងឬ ?
ក្រោយមក ពួកគេក៏ឈប់ ស៊ី នស្លាប់។
« យើងទាំងអស់គ្នាត្រូវរង់ចាំបន្តិចទៀតរហូតដល់ថ្ងៃទី ២៤ ខែ មីនា ។
34 កាលព្រះ‌ យេស៊ូបានឃើញថាទ្រង់ឆ្លើយដោយប្រាជ្ញា ( ដោយប្រាជ្ញានិងប្រាជ្ញា ) នោះទ្រង់មានព្រះ‌បន្ទូលទៅគាត់ ថា៖ « អ្នកនៅមិនឆ្ងាយប៉ុន្មានពីនគរព្រះ ទេ ។
ស្តេច នៃ ផែនដី បាន ក្រោក ឈរ ឡើង ហើយ ពួក អ្នកគ្រប់គ្រង បាន ប្រមូលផ្តុំ គ្នា ប្រឆាំង នឹង ព្រះអម្ចាស់ ( ព្រះ ដ៏ មាន មហិទ្ធិ ឫទ្ធិ ) និង ប្រឆាំង នឹង ព្រះគ្រីស្ទ របស់ ទ្រង់ ។
ថា ពួកគេ នឹង គ្មាន ការភ័យខ្លាច នៅ ថ្ងៃ ជំនុំ ជំរះ ឡើយ ។
វា មិន ត្រូវបាន គេ បាញ់ សម្លាប់ នៅក្នុង វិហារ របស់ អ្នកទេ ។
ទទួល បន្ទុកការពារពួកគេ » ។
« បើអ្នកអត់ទោសឲ្យអ្នក ដទៃចំពោះកំហុសដែលគេធ្វើចំពោះអ្នក នោះព្រះវរ បិតារបស់អ្នកដែលគង់នៅស្ថាន សួគ៌នឹងអត់ទោសឲ្យអ្នក ។
មានចែងទុកក្នុងគម្ពីរព្យាការីថា « ហើយពួកគេទាំងអស់គ្នានឹងត្រូវបានបង្រៀនដោយព្រះ» ។
បងប្អូនស្រីទាំងពីរចោទដូចគ្នាថា៖ « លោកម្ចាស់ បើលោកនៅ ទីនេះ ប្អូនខ្ញុំមិនស្លាប់ទេ » ។
តើអ្នកមានហេតុផលល្អដើម្បីអះអាងថាព្រះបន្ទូលរបស់ព្រះជាប្រភពដែលមានសិទ្ធិអំណាចនៃដំណឹងល្អឬទេ ?
និង ចំណេះដឹង ទូលំទូលាយ នៃ វត្ថុ បុរាណ ។
ហើយគាត់សួរគាត់ថា " ហេតុអ្វីបានជាអ្នកឈរនៅ ទីនេះពេញមួយថ្ងៃដោយមិនបានធ្វើអ្វី ? "
ព្រះអង្គបានប្រតិបត្តិតាមព្រះបន្ទូលដែលព្រះអង្គបានបង្គាប់នៅជំនាន់ដើម ។
បឹង ភ្លើង គឺជា ការស្លាប់ ទី ពីរ ។
ហើយគាត់នឹងបំប្លែងកូនចៅអ៊ីស្រា ‌ អែលជាច្រើនឲ្យទៅជាព្រះ‌ អម្ចាស់ ជាព្រះ របស់ពួកគេ ។
ហើយបានឲ្យឈ្មោះដែលលើសជាងគ្រប់នាមដល់គាត់
នោះគឺជាការ ពិតដែលបុរសនិងស្ត្រីទាំងនេះបានធ្វើជាសាក្សី ។
ដូច្នេះ ជំនឿ គឺជា បណ្តុំ នៃ ចំណេះដឹង ។
ប្រជាជនទាំងអស់បានឃើញគាត់ដើរ ហើយសរសើរ ត ម្កើងព្រះជាម្ចាស់ » ។
១៧ត្បិតដល់ពេលហើយ ដែលការជំនុំ ជម្រះត្រូវចាប់ផ្ដើមនៅ ឯដំណាក់នៃព្រះ។ បើវាចាប់ផ្ដើមពីយើង តើនឹងមានលទ្ធផលយ៉ាង ណាចំពោះអ្នកដែលមិនគោរពតាមដំណឹងល្អរបស់ព្រះ?
៦ ខ្ញុំនឹងច្រៀងថ្វាយព្រះ យេហូវ៉ា ពីព្រោះទ្រង់បានប្រព្រឹត្តចំពោះខ្ញុំយ៉ាងបរិបូណ៌ ។
ហើយ ហូរ តាម បំពង់ ទាំងនេះ ។
ហើយពួកគេបាននិយាយព្រះបន្ទូលរបស់ព្រះអម្ចាស់ដល់គាត់ និងដល់អ្នកដែលនៅក្នុងផ្ទះរបស់គាត់ ។
ទាំងអស់ ដោយ មិន ចាំបាច់ យក ភ្នែក របស់ អ្នក ចេញ ពី ផ្លូវ ។
18 ដ្បិតអ្នក ណាដែលបម្រើព្រះ‌គ្រិស្ដតាមរបៀបនេះ អ្នកនោះគាប់ព្រះហឫទ័យព្រះជាម្ចាស់ ហើយមនុស្សក៏ពេញ ចិត្ត ។
