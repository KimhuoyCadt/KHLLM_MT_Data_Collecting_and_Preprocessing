លោកម៉ូសេ រត់ចេញពីមុខព្រះចៅផារ៉ោន ហើយទៅរស់នៅក្នុងស្រុក
ដឹកនាំ ដោយ ព្យាការី វេលែន ។
ទាំង នេះ គឺជា ផល ប៉ះពាល់ ដែល បាន ពិភាក្សា ដែល អាច ធ្វើ ទៅ បាន ជាមួយ របាំង ខ្មៅ ។
១៣ « គាត់នឹងយកកូនស្រីរបស់អ្នក មកដែរ ។
« បងប្អូនអើយ ប្រសិនបើអ្នក ណាម្នាក់វង្វេងចេញពីសេចក្ដី ពិត ហើយមានអ្នក ណាបែរមកវិញ ... » ។
គេប្រាប់ខ្ញុំថា បើខ្ញុំចង់រស់នៅ ទីនោះមានសុភមង្គល ខ្ញុំត្រូវ តែរៀបការ ជាមួយបុរសចិន » ។
ភាពក្រីក្រ និង កុមារ ដែល រស់ នៅក្នុង ផ្ទះ ឪពុក ម្តាយ តែ មួយ ឬ ជាមួយ អាណាព្យាបាល ។
យើងពិតជាធ្វើ ប៉ុន្តែយើងមើលឃើញថាវាជាផ្លូវទៅរកសិរី រុងរឿង ។
បាន រកឃើញ អ្វី ដែល ខ្ញុំ កំពុង ស្វែងរក សូម អរគុណ ។
ពេលនោះ សន្តិភាពរបស់អ្នកនឹងបានដូចជាទន្លេ និងសេចក្ដី សុចរិតរបស់អ្នកដូចជា រលកសមុទ្រ !» ។
នៅ កណ្តាល ជុំវិញ បល្ល័ង្ក មាន សត្វ មាន ជីវិត ចំនួន បួន ហើយ ពួកវា ត្រូវបាន បិទបាំង ដោយ ភ្នែក ទាំង ខាងមុខ និង ខាងក្រោយ ។
តើវាជាការ ធានា រ៉ាប់រងលើអាយុជីវិតរបស់អ្នកសមរម្យឬ ?
ហើយសូម្បីតែសក់ក្បាលរបស់អ្នកក៏ជាប់លេខដែរ ។ ដូច្នេះ កុំ ភ័យខ្លាច ; អ្នក មាន តម្លៃ ជាង ចាប ជាច្រើន ។
ដល់ ព្រះ សម្រាប់ ជា ប្រយោជន៍ ដល់ ព្រះអង្គ សង្គ្រោះ របស់ ខ្ញុំ
មើល ចុះ ពួកគេ ទាំងអស់ នឹង អស់ ដូចជា សម្លៀកបំពាក់ ។
« នេះជាកូនជាទី ស្រឡាញ់របស់ខ្ញុំ ដែលខ្ញុំពេញ ចិត្តហើយ សូមស្តាប់គាត់ !» ។
រតនាគារ ក្រុង ដើម្បី ថ្លឹងថ្លែង ការចំណាយ ។
ពេលវេលា ជិត មកដល់ ហើយ បងប្អូន ។
ដូច្នេះ មនុស្សនៃព្រះ អាចនឹងត្រូវបានបំពាក់ដោយគ្រប់កិច្ចការដ៏ល្អ ។
ដូច្នេះពួកគេមាន កម្លាំងសម្រាប់ពួកគេ ប៉ុន្តែមិនធ្ងន់នោះ ទេ ។
សូម អរ ព្រះគុណ និង លើកតម្កើង សិរី រុងរឿង របស់ ព្រះជាម្ចាស់ ដ៏ មាន មហិទ្ធិ ឫទ្ធិ បាន បង្កើត ស្ថាន បរម សុខ និង ផែនដី ជា ព្រះដ៏ មាន អំណាច សព្វគ្រប់ និង ជា សកល និង សន្តិភាព ដល់ យើង រាល់ សត្វលោក ។
វាមានចម្ងាយប្រហែល 29 គីឡូម៉ែត្រពីទីក្រុង Chokwe ជាកន្លែងដែលនាងរស់ នៅ និងធ្វើ ការ មុនទឹក ជំនន់ ។
១១ យើងនឹងធ្វើក្រវិលមាសជូនអ្នក ។
វាស្រេកឃ្លាន ហើយលេបត្របាក់អ្វី ៗទាំងអស់តាមផ្លូវរបស់វា ។
ចង្អុល ជើង របស់ អ្នក ឆ្ពោះ ទៅរក ភ្លើង ។
នាង លែង ត្រូវការ គាត់ ទៀត ហើយ ។
ផ្ទុយទៅវិញ វា នឹង ជួយ អ្នក ឱ្យ ជាសះស្បើយ លឿន ជាង មុន ។
តើ ធ្វើ ដូចម្តេច ដើម្បី ចាប់ផ្តើម ថវិកា ផ្អែក លើ សូន្យ ?
អ្នកនឹងខ្ចីទៅប្រជាជាតិជាច្រើន ប៉ុន្តែអ្នកមិនត្រូវខ្ចីទេ ។
យើង នឹង វិនិច្ឆ័យ ពួកគេ តាម គុណសម្បត្តិ របស់ ពួកគេ ។
តើគាត់នឹងទៅកន្លែងដែលជនជាតិយូដាខ្ចាត់ខ្ចាយក្នុងចំណោមក្រិក ហើយបង្រៀនជនជាតិក្រិចឬ ?
« ហើយគាត់នឹង បង្វែរកូនចៅអ៊ីស្រាអែលជាច្រើនមក ឯព្រះអម្ចាស់ ជាព្រះ របស់ពួកគេ » ។
ប៉ុន្តែ ខ្ញុំបានអង្វរព្រះ នៃ ស្ថាន បរម សុខ
មួយគឺជាស្ដេចនៃការ បោកបញ្ឆោត , មួយទៀតគឺជាការ ពិត ,
នៅ ទីនេះ អ្នក នឹង ឃើញ ភាពរីករាយ កាន់តែ ច្រើន ។
ផ្លូវ ទៅ សាតាំង មាន មោទនភាព ចំពោះ អ្នក ។
បើគេបង្ហាញខ្លួនថា សក្ដិសមថ្ងៃ ណាមួយគេអាចនឹងក្លាយជាកាឡា ។
នៅ កន្លែង ផ្សេង ទៀត និង ធ្វើ ការឆ្ពោះ ទៅរក អ្វី ដែល អ្នក បាន រកឃើញ ។
ទោះ យ៉ាងណា ក៏ដោយ ពួកគេ នឹង ស្វែងរក កន្លែង ថ្មី បន្ថែម ពីលើ កន្លែង ដែល ពួកគេ បាន រកឃើញ រួចហើយ ។
ក្រៅពីនេះ គ្មានអ្នក ណាឃើញអ្នកទេ » ។
ហើយនេះជាប្រភេទនៃអំពើអាក្រក់ និងអយុត្តិធម៌ ។
ហើយអំពើអាក្រក់នឹងត្រូវបាក់ដូចដើមឈើ » ។
បុរសនេះមិនឈប់និយាយទាស់នឹងទី សក្ការៈ និងប្រឆាំងនឹងក្រឹត្យ វិន័យឡើយ ។
វាជាការ ច្រៀង រីឯមួយទៀតគឺអំពីប្រយោគអះអាង
ចាប់ បាន រវាង ស្ត្រី ទាំង ពីរ នាក់
« យើងដឹងថានេះជាកូនរបស់យើង ហើយគាត់កើតមកខ្វាក់ ។
« អ័ដាមមិនមែនជាអ្នកបោកបញ្ឆោតទេ វាគឺជាស្ត្រីដែលត្រូវបានគេបញ្ឆោត ហើយក្លាយជាមនុស្សមាន បាប ។
មិនមែនជាទាសករដែល រត់គេចខ្លួនទេ អ្នកក្រោយមកមានចំនួនច្រើន
ខ្ញុំ ក៏ ចូលចិត្ត លេង ហ្គេម អនឡាញ ដែរ ។
ពួកគេបានបន្តប្រកាសព្រះបន្ទូលរបស់ព្រះដល់គាត់ និងដល់អ្នក រាល់គ្នាក្នុងផ្ទះរបស់គាត់ ។
2 អ្នកនេះនៅ ជាមួយនឹងព្រះកាលពីដើមដំបូង ។
២៤ ហើយពួកគេបានលើក ត ម្កើងព្រះ ដោយព្រោះខ្ញុំ ។
ដូច្នេះ កុំ គ្រាន់តែ ប្រាប់ ពួកគេ អំពី វា ; បង្ហាញ វា ដល់ ពួកគេ ។
បន្ទាប់មក គាត់និយាយទៅ កាន់នារីវ័យក្មេង ថា៖ « អ្នកបាននៅម្នាក់ឯងជាលើកដំបូង ។
ស្តាប់ នេះ មិន មែន ជា អ្វី ដែល ខ្ញុំ ចង់បាន សម្រាប់ អ្នកទេ ហើយ ខ្ញុំ ដឹង ថា វា មិន មែន ជា អ្វី ដែល អ្នក គួរ ចង់បាន សម្រាប់ ខ្លួនអ្នក ។
បន្ទាប់មក ទ្រង់ នឹង វាយ ខ្មាំង សត្រូវ ។
កិត្តិយសដែលបានជាប់ពាក់ព័ន្ធនឹងគាត់ » ។
ពួកគេពោលថា៖ « យើងជឿលើព្រះ‌ អម្ចាស់របស់ អើរ៉ុន និងលោកម៉ូសេ» ។
គ្មានខ្មាំង ស ត្រូវ ណាម្នាក់ទប់ទល់នឹងពួកគេឡើយ ។ ព្រះអម្ចាស់បានប្រគល់ខ្មាំង ស ត្រូវទាំងអស់ទៅពួកគេ ។
វា ជា ថ្ងៃ នៃ សេចក្តីអំណរ ដ៏ អស្ចារ្យ ។
2 គាត់ នៅ ជាមួយ ព្រះជាម្ចាស់ តាំងពី ដើម ដំបូង ។
ដូច្នេះ ពួកគេ បាន បង្រៀន ពួកគេ ពី ការអធិស្ឋាន របស់ ព្រះអម្ចាស់៖ ផ្តល់ឱ្យ យើង នូវ ត្រា ប្រចាំ ថ្ងៃ របស់ យើង ។
៥ « មើលមកខ្ញុំ ហើយងឿង ឆ្ងល់ ហើយយកដៃបិទមាត់អ្នក ។
យ៉ូហាន 13:16-17 - ខ្ញុំប្រាប់អ្នក រាល់គ្នាតាមពិតថា អ្នក បម្រើមិនធំជាងម្ចាស់ទេ ហើយក៏មិនមែនជាអ្នក នាំ សារធំជាងអ្នកដែលចាត់គាត់ឲ្យ មកដែរ ។
ទាំងយប់ទាំងថ្ងៃ ពួកគេមិនឈប់និយាយថា៖ « ព្រះ ដ៏វិសុទ្ធ បរិសុទ្ធ បរិសុទ្ធជាព្រះ អម្ចាស់ ។
33 គេទូលព្រះអង្គ ថា៖ « យើងខ្ញុំជាកូនចៅរបស់លោកអប្រាហាំ ហើយមិនដែលធ្វើជាខ្ញុំបម្រើរបស់អ្នក ណាឡើយ តើព្រះអង្គមានព្រះ‌បន្ទូលថា ព្រះអង្គនឹងមានសេរីភាពយ៉ាងដូចម្ដេច ?
យុត្តិកម្ម ដែល អ្នក មិន អាច ទទួលបាន នៅក្រោម ច្បាប់ របស់ លោក ម៉ូសេ ។
សម្រាប់អ្នកដែលបានបាត់ បង់ » ។
តាមដាន ព្រឹត្តិការណ៍ ។
ប៉ុន្តែ មនុស្ស ទាំងអស់ នៅលើ ផែនដី ត្រូវបាន បង្កើតឡើង ពី ពន្លឺ ។
ហើយវាយដាវនៃសេចក្ដី សុចរិត ។
ហើយ ផែនដី បាន ផ្តល់ កំណើត ដល់ មនុស្ស ។
« ខ្ញុំនឹងធ្វើខ្លួនឲ្យដូចជាព្រះ ដ៏ខ្ពង់ខ្ពស់បំផុត » ។
២៣ នៅ គ្រានោះ មានការ រំខានយ៉ាងខ្លាំងអំពីផ្លូវ ។
អំណាច របស់ អ្នក គឺ នៅក្នុង អ្វី ដែល អ្នក ធ្វើ ដោយ ប្រាជ្ញា របស់ អ្នក ។
ខ្ញុំ ជាអ្នក បម្រើជាមួយនឹងអ្នក និងជាបងប្អូនរបស់អ្នក ជាព្យាការី និងជាមួយអ្នកដែល កាន់តាមពាក្យនៃសៀវភៅនេះ ។
អ្នកក៏នឹងធ្វើបន្ទាល់ដែរ ព្រោះអ្នកនៅជាមួយខ្ញុំតាំងពីដើមដំបូង មក ។
« ខ្ញុំឈរនៅកន្លែងជំនុំ ជំរះរបស់សេសារ ជាកន្លែងដែលខ្ញុំត្រូវកាត់ ទោស ។
ខ្ញុំ គ្រាន់តែ អាច អាន ពាក្យ របស់ គាត់ បាន ។
s ខណៈពេល ដែល កំពុង រង់ចាំ ការមកដល់ របស់ អ្នកដទៃ ។
5 គេនឹងមិនដើរតាមអ្នក ដទៃទេ គេនឹង រត់ចេញពីគេ ព្រោះគេមិនស្គាល់សំឡេងរបស់ជនបរទេស » ។
មាន ការព្រមាន យ៉ាង ធ្ងន់ធ្ងរ ចំពោះ អ្នក ដែល នាំ មនុស្ស ឱ្យ វង្វេង ពី ការពិត ។
ចំពោះព្រះអង្គដែលអាចធ្វើបានច្រើនលើសពីអ្វីដែលយើងសុំ ឬ ស្រមៃតាមអំណាចរបស់ព្រះអង្គដែលមាននៅក្នុងខ្លួនយើង ។
ពួកគេ ត្រូវបាន ហៅ ពី ព្រះ។
ដល់ សម័យ បុរាណ ។
បាន និយាយ ថា គាត់ បាន លាតត្រដាង អាថ៌កំបាំង ។
គាត់ ចូលចិត្ត នៅក្បែរ អ្នក ។
« តែអ្នក ណាដែលតូចជាងគេនៅក្នុងនគរស្ថាន សួគ៌ នោះធំជាងគាត់ ។
ប៉ុន្តែពួកគេដឹងយុត្តិធម៌ ហើយពួកគេត្រឡប់មកវិញជាមួយសាលក្រមត្រឹមត្រូវថាមិនមាន ទោស ។
គាត់ក៏ចង់ឲ្យយើងមានជីវិតល្អបំផុតដែរ ។
កន្លែង ស្នាក់ នៅជា កម្មសិទ្ធិ របស់ អង្គការ សប្បុរសធម៌ និង ធ្វើឡើង សម្រាប់ គោលបំណង សប្បុរសធម៌ ។
ការរំឮក ពី អ្នកអស្ចារ្យ ពីមុន ។
ព្រះជាម្ចាស់ គឺជា ថ្ងៃ នេះ ដែល ពង្រីក ព្រះគុណ របស់ ព្រះជា ម្ចាស់ ដល់ យើង ។
យើងប្រកែកថា ព្រះ នឹងបំផ្លាញទីក្រុង ។
ពួកគេបានថ្វាយបង្គំព្រះអម្ចាស់ សរសើរទ្រង់ចំពោះការ រៀបចំរបស់ទ្រង់ ហើយជឿលើការសន្យារបស់ទ្រង់ ។
ទី បន្ទាល់នេះគឺជាការ ដែលព្រះ បានប្រទានជីវិតអស់ កល្ប ជា និច្ចដល់យើង ហើយជីវិតនេះគឺនៅក្នុងព្រះរាជ បុត្រារបស់ទ្រង់ ។
រឿងប្រៀប ប្រដូចនៃស្ត្រីព្រហ្ម ចារីដប់នាក់មិនស្ថិតនៅ ចន្លោះអ្នកបាត់ បង់ និងអ្នកដែលបាន សង្គ្រោះនោះទេ ។
តើអ្នកចង់ដឹងការ ពិតដែល មកពីព្រះ ទេ ?
ដូច្នេះ អ្នក គឺជា ព្រះ។
« ឥឡូវនេះ ពួក សង្ឃអើយ បញ្ញត្តិនេះគឺសម្រាប់អ្នក រាល់គ្នា ។
ហើយ ចែកជូន ជន ក្រីក្រ ។
30 កាលពីដើម អ្នក រាល់គ្នាមិនស្តាប់បង្គាប់ព្រះ ប៉ុន្តែឥឡូវនេះ អ្នក បានទទួលសេចក្ដី មេត្តា ក រុណាហើយ ព្រោះគេមិនស្តាប់បង្គាប់ ។
មនុស្ស ជាច្រើន អាច ងាក ទៅ រក ប៉ុន្តែ ពួកគេ មិន មែន ជា អ្នក ដែល ត្រឹមត្រូវ ។
បរិភោគ និង ផឹក ដែល វា ត្រូវបាន ហាមឃាត់ មិន ឱ្យ តម អាហារ
ហើយ ប្រសិនបើ ពួកគេ ទាំងអស់ ជា សមាជិក តែ មួយ តើ រូបកាយ នៅ ឯណា ។
បន្ទាប់មក អ្នក អាច អង្គុយ នៅ កន្លែង ផ្សេង ។
បន្ទាប់មកពួកគេនឹងជ្រើស រើសវា » ។
ខ្ញុំនឹងសងគេតាមការ ប្រព្រឹត្តរបស់គេ …» ។
ហើយ ពួកគេ បាន អធិស្ឋាន សម្រាប់ គាត់ ។
គេសួរគាត់ ថា៖ « ប្រាប់យើងខ្ញុំថា អ្នក ធ្វើការ ទាំងនេះដោយអាងអំណាចអ្វី តើអ្នក ណាបានឲ្យអំណាចនេះ មក » ។ ( ២០: ២) ។
ជួយ ខ្ញុំ ផង បងប្អូន នៅ ទីនេះ ។
កុំ រៀបការ ជាមួយ នាង រហូតដល់ នាង ទទួលខុសត្រូវ ចំពោះ ស្ថានភាព របស់ នាង ។
នៅថ្ងៃចុងក្រោយ រាល់ជង្គង់នឹងក្រាបនៅចំពោះទ្រង់ ។
តែពេលមកដល់ខ្លួនយើង
« ប្រសិនបើអ្នកនៅជាប់នឹងខ្ញុំ ហើយពាក្យរបស់ខ្ញុំនៅជាប់នឹងអ្នក អ្នកអាចសួរពីអ្វីដែលអ្នកចង់បាន ហើយអ្នកនឹងទទួលបាន » ។
អា ប្រាហាំគ្មានកូនច្រើនឆ្នាំ មកហើយ ។
18 នៅពេលនោះ ខ្ញុំបានបង្គាប់អ្នករាល់ការ ទាំងអស់ដែលអ្នកត្រូវធ្វើ ។
ប្រាប់ ពួកគេ ថា អ្នក នឹង ក្លាយជា អ្នកដឹកនាំ ។
២០ ពេលលោកឃើញជំនឿរបស់ពួកគេ លោកមាន ប្រសាសន៍ ថា៖ « សម្លាញ់ !
« ប្រាប់អ្នកដែល ចិត្តភ័យខ្លាចថា ចូរខ្លាំងឡើង កុំខ្លាចអី !
ព្រះបន្ទូល របស់ ព្រះកើនឡើង និង រីករាលដាល ។
ព្រះអម្ចាស់ នៃ វាល ទំនាប
ដាក់ នៅក្នុង ទ្រូង នៃ ព្រះអង្គ សង្គ្រោះ របស់ យើង ។
ប៉ុន្តែ ពេលជន ជាតិយូដានិយាយប្រឆាំងនឹងខ្ញុំ ខ្ញុំត្រូវ បង្ខំ ចិត្តប្តឹងទៅសេសារ ។
ហើយ គ្មាន នរណា ម្នាក់ នឹង ផ្តល់ឱ្យ យើង នូវ ក្រឹត្យ មួយ ទេ ។
