( ភ្នំពេញ ) ៖ នា ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ នេះ មាន គ្រោះ អគ្គិភ័យ បាន ឆាបឆេះ ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ២ខ្នង អស់ ទាំងស្រុង នៅ ផ្លូវ សុធារស ភូមិ ទី៩ ក្រុម ទី៥០ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ។ នេះ បើ តាម របាយការណ៍ របស់ ការិយាល័យ នគរបាល ពន្លត់ អគ្គិភ័យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ ការិយាល័យ នគរបាល ពន្លត់ អគ្គិភ័យ បាន បន្ត ថា ក្រៅពី ឆេះ ផ្ទះ ទាំង ២ខ្នង នេះ ហើយ អគ្គិភ័យ បាន បន្ត ឆេះ រាលដាល ដល់ ផ្ទះ អ្នកជិតខាង អស់ ប្រហែល ២០ % ចំនួន ៣ផ្ទះ ទៀត ។
បើ តាម របាយការណ៍ ខាងលើ ក្នុង ប្រតិបត្តិការ ពន្លត់ អគ្គិភ័យ នេះ គឺ ប្រើ រថយន្ត ការិយាល័យ នគរបាល ពន្លត់ អគ្គិភ័យ ចំនួន ២៣ គ្រឿង ប្រើប្រាស់ ទឹក អស់ ចំនួន ១១៥ ឡាន ស្មើនឹង ៤៦០ ម៉ែត្រ គូប ។ រហូតដល់ ម៉ោង ១៖៣០ នាទី រសៀល ថ្ងៃ ដដែល ទើប ពន្លត់ អស់ ជា ស្ថាពរ ៕
( កំពត ) ៖ យ៉ាងហោចណាស់ មាន ព្រឹត្តិការណ៍ កម្សាន្ត្រ សប្បាយ ដល់ ទៅ ៣៤ ទីតាំង ដែល ត្រូវបាន រៀបចំ នៅ ទូទាំង ខេត្ត កំពត ពិសេស នៅ ក្រុង កំពត ក្រុង បូក គោ និង តំបន់ ជុំវិញ ក្រុង សម្រាប់ ទទួល ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ នា ឱកាស បុណ្យ ចូល ឆ្នាំ សកល ២០២២ ឈាន ចូល ២០២៣ ។ នេះ បើ តាម លោក ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត ។
លោក បាន ឱ្យដឹង ថា នៅក្នុង ក្រុង កំពត និង តំបន់ ជុំវិញ ក្រុង អាជ្ញាធរ បាន រៀបចំ ឱ្យ មាន កម្មវិធី ឆ្លង ឆ្នាំ ជាមួយនឹង ការប្រគំ តន្ត្រី ចំនួន ២កន្លែង កីឡា ប្រដាល់ ក្បាច់គុន បុរាណ ខ្មែរ ការប្រណាំង ទូក ប្រពៃណី ( ទូក នេសាទ ) ។ មិន តែ ប៉ុណ្ណោះ មាន ទាំង ការរៀបចំ ផ្សារ លក់ដូរ សម្រាប់ ភ្ញៀវ ទេសចរ និង មាន ការបាញ់ កាំជ្រួច អបអរសាទរ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ផងដែរ ។
លោក អភិបាល ខេត្ត បាន បន្ត ទៀត ថា ទីតាំង ទាំង ៣៤កន្លែង នោះ គឺ សុទ្ធតែ មាន ការរៀបចំឡើង ជាមួយនឹង លក្ខណៈ ខុស ៗ គ្នា ដូចជា នៅ ជាប់ តំបន់ ឆ្នេរ នៅ តាម ដង ព្រែក តំបន់ ភ្នំ តំបន់ ក សិទេសចរណ៍ ដែល តំបន់ ទាំងនេះ គឺ ល្អ ប្រណិត សម្រាប់ ទទួល ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ដែល មាន បំណង មក កម្សាន្ត នៅក្នុង ខេត្ត កំពត ។
ដោយឡែក សម្រាប់ នៅលើ ភ្នំ បូកគោ ក៏ ដូចជា ក្រុង បូក គោ វិញ រដ្ឋបាល ខេត្ត កំពត និង អាជ្ញាធរ មូលដ្ឋាន ក៏ បាន សហការរៀបចំ ការបោះ តង់ ជូន ភ្ញៀវ ទេសចរ យ៉ាង ច្រើន ជាមួយនឹង ទេសភាព សោភ័ណភាព អាកាសធាតុ និង សក្ដានុពលធម្មជាតិ ដ៏ ល្អ ឯក ។ ម្យ៉ាងទៀត នៅលើ ភ្នំ ក៏ មាន សណ្ឋាគារ សម្រាប់ បំពេញ តម្រូវការស្នាក់នៅ របស់ ភ្ញៀវ ទេសចរ ព្រមទាំង មាន ទី គោលដៅ កម្សាន្ត ជាច្រើន ទៀត ផងដែរ ។
លោក ប្រធាន មន្ទីរ ទេសចរណ៍ សយ ស៉ី ណុល បាន បន្ត ថា មកដល់ ពេលនេះ ដែរ សណ្ឋាគារ ផ្ទះសំណាក់ ប៊ូទិក និង សេវាកម្ម ស្នាក់ នៅ នានា ក្នុង ខេត្ត គឺ មាន ការកក់ បន្ទប់ ស្នាក់ នៅ ស្ទើរតែ គ្រប់ ១០០ ភាគរយ ហើយ ក្នុង ចំណោម បន្ទប់ ស្នាក់ នៅ សរុប ជាង ៤. ៧០០ បន្ទប់ ប៉ុន្តែ ទោះជា យ៉ាងណា ក៏ មិន មាន ការខ្វះខាត រឿង បន្ទប់ ស្នាក់ នៅ នេះ ឡើយ ពោលគឺ នៅតែ មាន គ្រប់ តាម តម្រូវការ របស់ ភ្ញៀវ ទេសចរ ។
ជា ការកត់សម្គាល់ របស់ លោក ប្រធាន មន្ទីរ ទេសចរណ៍ ភ្ញៀវ ទេសចរ បាន ទៅ លេង កម្សាន្ត យ៉ាង ច្រើន កុះករ នៅ ឆ្នេរ ខ្សាច់ កោះ ស្មៅ ( ចេញ ពី ទី រួម ខេត្ត ឆ្ពោះទៅ កំពង់ផែ ទេសចរណ៍ ) ដែល ជា ឆ្នេរ រៀបចំ ថ្មី ដោយ នៅ ទីនោះ មាន ការប្រណាំង ទូក នេសាទ ប្រពៃណី ប្រដាល់ បុរាណ គុន ខ្មែរ ខណៈ អ្នក ខ្លះ ក៏ កំពុង អង្គុយ លេង លម្ហែ កម្សាន្ត ខ្លះ ក៏ កំពុង ធ្វើដំណើរ ទៅកាន់ ទីនោះ ព្រោះ មាន ព្រឹត្តិការណ៍ កម្សាន្ត ទាំង ពេល ថ្ងៃ និង ពេល យប់ ។
គួរ ជម្រាប ដែរ ថា កាលពី ពេល បុណ្យ អុំ ទូក កន្លងទៅ នោះ មាន ភ្ញៀវ ទេសចរ មក លេង ខេត្ត កំពត ប្រមាណ ជាង ៥៩ម៉ឺន នាក់ រីឯ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ សកល នេះ លោក អភិបាល ខេត្ត ម៉ៅ ធ និន រំពឹង ថា នឹង មាន ភ្ញៀវ ទេសចរ ប្រហាក់ប្រហែក ឬ ក៏ លើស កាលពី បុណ្យ អុំ ទូក នោះ ទៀត ៕ សម្ដេច តេជោ ហ៊ុន សែន ចេញ អនុក្រឹត្យ តែងតាំង លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ជា ជំនួយការ ឋានៈ ស្មើ អគ្គ នាយក រង
( កំពង់ចាម ) ៖ ក្នុង នាម កងកម្លាំង នគរបាល ជាតិ ចាប់ពី ថ្នាក់ដឹកនាំ រហូតដល់ មន្រ្តី នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម ពិតជា មាន សេចក្ដីសោមនស្ស រីករាយ យ៉ាង ក្រៃលែង និង សូម ចូលរួ អបអរសាទរ គោរព ជូន ចំពោះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម ត្រូវ ទទួលបាន ទំនុកចិត្ត ដ៏ ខ្ពង់ខ្ពស់ ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ចេញ អនុក្រឹត្យ ស្ដីពី ការតែងតាំង ជា ជំនួយការ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា មាន ឋានៈ ស្មើ អគ្គ នាយក រង ។
រយៈពេល ៤០ ឆ្នាំ ក្នុង ការបំពេញ តួនាទី ភារកិច្ច មួយ នេះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ខិតខំ លះបង់ ត ស៊ូ ជូន សង្គមជាតិ ព្រមទាំង យក អស់ កំលាំង កាយ ចិត្ត ក្នុង កិច្ចការពារ រាជ រដ្ឋាភិបាល កម្ពុជា និង បម្រើ នូវ កិច្ចការពារ សន្តិសុខ សុវត្ថិភាព សណ្ដាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន របស់ ខ្លួន គួរ ជាទីមោទនភាព ។
ការលះបង់ ទាំងអស់ នេះ ហើយ ដែល ប្រមុខ រាជ រដ្ឋាភិបាល បាន មើលឃើញ អំពី គំរូវីរភាព ដ៏ អង់អាច ក្លាហាន បាន ផ្ដល់ ឋានៈ ដ៏ គាប់ ប្រសើរ និង ឧត្តុងឧត្តម ថ្លៃថ្លា ជូន លោក ឧត្ដមសេនីយ៍ ទោ ឯ ម កុសល ដើម្បី បន្ត ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី អភិវឌ្ឍ ប្រទេសជាតិ ឲ្យបាន តែ រីកចម្រើន ឥត ឈប់ឈរ បន្ថែម ទៀត ។
ជាថ្មី ម្ដង ទៀត ក្នុង នាម កងកម្លាំង ទាំងអស់ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម សូម គោរព ជូនពរ លោក ឧត្ដមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម និង ក្រុមគ្រួសារ ទទួលបាន សេចក្ដីសុខ សុខភាព ល្អ បរិបូរណ៍ អាយុ យឺន យូរ កម្លាំង ពលំមាំ មួន បញ្ញា ញាណ ភ្លឺ ថ្លា ចៀស ផុត ពី រោគា ចង្រៃ និង ជោគជ័យ ថ្មី ៗ បន្ត ក្នុង បេសកកម្ម ពិសេស ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង មុខ តំណែង និង តួនាទី ថ្មី ជានិច្ច និរន្តរ៍ ត រៀង ទៅ ៕
( យូ អិន ) ៖ មហាសន្និបាត អង្គការ សហ ប្រជាតិ បាន បោះឆ្នោត អនុម័ត លើ ដំណោះស្រាយ មួយ ដែល អំពាវនាវ ឱ្យ តុលាការ យុត្តិធម៌ អន្តរជាតិ (ICJ) ផ្ដល់ មតិ យោបល់ ស្ដីពី ផល ប៉ះពាល់ ផ្នែក ច្បាប់ ដែល បង្កឡើង ដោយ ការគ្រប់គ្រង ដោយ ខុស ច្បាប់ របស់ អ៉ី ស្រាអែល លើ ទឹកដី ប៉ាឡេស្ទីន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ ។
នៅក្នុង ការបោះឆ្នោត មួយ កាលពី ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ( ម៉ោង នៅ ទីក្រុង ញូវយ៉ក ) មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ បាន អនុម័ត ដំណោះស្រាយ ខាងលើ ក្នុង សំឡេង គាំទ្រ ៨៧ ទល់ នឹង ២៦ សំឡេង ជំទាស់ ខណៈ ៥៣ ប្រទេស ផ្សេង ទៀត បោះឆ្នោត អនុប វាទ ។ ការបោះឆ្នោត នេះ ក៏ បាន បង្ហាញ ផងដែរ ពី ការខ្វែងគំនិត គ្នា ក្នុង ចំណោម បណ្ដា ប្រទេស លោក ខាងលិច និង ការគាំទ្រ ភាគ ច្រើន នៅក្នុង ចំណោម ប្រទេស កាន់ សាសនា អ៉ី ស្លាម ក្នុង នោះ រួម មាន ទាំង ប្រទេស អារ៉ាប់ ដែល បាន ចុះ កិច្ចព្រមព្រៀង សន្តិភាព ជាមួយ អ៉ី ស្រាអែល ។
ប៉ាឡេស្ទីន នៅ ថ្ងៃសៅរ៍ នេះ បាន បង្ហាញ ការសាទរ ចំពោះ ការអនុម័ត ដំណោះស្រាយ នេះ ដែរ ដោយ ចាត់ទុក ថា ជា ការឆ្លុះបញ្ចាំង ពី ជ័យជម្នះ មួយ នៃ ការទូត របស់ ប៉ាឡេ ស្ទីន ៕
សប្បុរសជន ឧបត្ថម្ភ ថវិកា ជិត ៣លាន ដុល្លារ ទៀត សម្រាប់ ការផលិតភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី »
( ភ្នំពេញ ) ៖ សប្បុរសជនជា អ្នក ឧកញ៉ា ឧកញ៉ា ព្រមទាំង មន្ត្រី ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល កម្ពុជា ផងដែរ បាន ឧបត្ថម្ភ ថវិកា ផ្ទាល់ខ្លួន សរុប ជិត ៣លាន ដុល្លារ បន្ថែម សម្រាប់ ការលិតភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី » ។
ការឧបត្ថម្ភ នេះ បាន ធ្វើឡើង នៅក្នុង ពិធី សំណេះសំណាល រវាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាក បាត ក្រហម កម្ពុជា នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ។
នៅ ព្រឹក មិញ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ ផលិត ខ្សែភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី » ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន បញ្ជាក់ ថា ជំនួប នេះ ធ្វើឡើង ដើម្បី លើកទឹកចិត្ត ដល់ ក្រុមការងារ ផលិត ក៏ ដូចជា អ្នកសម្តែង ទាំងអស់ ដែល បាន ប្រឹងប្រែង អស់ កម្លាំង កាយ ចិត្ត ក្នុង ការផលិត ខ្សែភាពយន្ត បែប ប្រវត្តិសាស្ត្រ ពាក់ព័ន្ធ ដំណើរ ជីវិត តស៊ូ ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ។
ក្រៅតែ ពី ការលើកទឹកចិត្ត ជំនួប នេះ ក៏ ជា ការតម្រង់ ទិស បន្ថែម ដល់ ក្រុមការងារ ផលិត ដើម្បីឱ្យ ខ្សែភាពយន្ត មាន ភាពទាក់ទាញ និង កាន់តែ ល្អ ប្រសើរ ។ ជាពិសេស មិន ប្រាស់ ចាក ពី ប្រវត្តិ ពិត ដែល សម្តេច និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ឆ្លងកាត់ ។
មកដល់ ពេលនេះ ឈុត ឆាក ជាច្រើន ត្រូវបាន បញ្ចប់ ការថត ហើយ ។ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ទម្លាយ ឈុត ឆាក សម្តែង នោះ ជាច្រើន ឃ្លីប រួចហើយ ផងដែរ ។ ឈុត សម្តែង ដែល សម្តេច តេជោ បាន បង្ហាញ ទទួលបាន ការចាប់អារម្មណ៍ ខ្លាំង ពី សាធារណជន ៕
( កំពត ) ៖ លោក ម៉ៅ ធ និន អភិបាល នៃ គណៈអភិបាល ខេត្ត កំពត បាន ផ្តួចផ្តើម រៀបចំ ឱ្យ មាន ការប្រណាំង ទូក នេសាទ បំពាក់ ម៉ាស៊ីន ជា លើក ដំបូង នៅក្នុង ខេត្ត ដើម្បី អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ឆ្នាំ សកល និង ដើម្បី បង្កើត បរិយាកាស រីករាយ ជូន ប្រជាពលរដ្ឋ ប្រកបរបរ នេសាទ ។
ពិធី ប្រណាំង ទូក នេសាទ បំពាក់ ម៉ាស៊ីន ត្រូវបាន រៀបចំឡើង នៅ តាម ឆ្នេរ ខ្សាច់ ប្រវែង ប្រមាណ ២ពាន់ ម៉ែត្រ ក្នុង ក្រុង កំពត ដែល ជា ឆ្នេរ បង្កើត ថ្មី ដោយ លោក អភិបាល ខេត្ត ផ្ទាល់ តែម្តង ។
ពិធី ប្រណាំង ទូក នេសាទ បំពាក់ ម៉ាស៊ីន នេះ ត្រូវបាន រៀបចំ ជា លើក ដំបូង ហើយ នៅក្នុង ខេត្ត កំពត ។ ការប្រណាំង ទូក នេសាទ នេះ ធ្វើឡើង រយៈពេល ពីរ ថ្ងៃ គឺ ចាប់ផ្តើម នៅ ថ្ងៃទី ៣០ ហើយ បញ្ចប់ នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ ។
ពិធី ប្រណាំង ទូក នេសាទ បាន ចាប់ផ្តើម នៅ រសៀល ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ក្រោម អធិបតីភាព របស់ លោក ម៉ៅ ធ និន ហើយ មាន ការ អញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ព្រមទាំង ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពត យ៉ាង ច្រើន កុះករ ។
យោង តាម គណៈកម្មការរៀបចំ ការប្រណាំង ទូក បាន ឱ្យដឹង ថា ទូក ដែល ចូលរួម ប្រណាំង នេះ មាន ចំនួន ប្រមាណ ២០៨ ទូក ស្មើនឹង ១០៤គូ ។ ក្នុង នោះ ទូក អុំ មាន ចំនួន ៤៩ គូ ប្រកួត គ្នា លើ ចម្ងាយ ប្រមាណ ៥០០ ម៉ែត្រ ហើយ ទូក នេសាទ បំពាក់ ម៉ាស៊ីន គោយន្ត មាន ចំនួន ៥៥គូ ប្រកួត គ្នា លើ ចម្ងាយ ប្រមាណ ១ពាន់ ម៉ែត្រ ។
ថ្លែង ក្នុង ពិធី បើក ការប្រកួត ក្រោម បរិយាកាស ដ៏ សែន រីករាយ លោក ម៉ៅ ធ និន បាន គូសបញ្ជាក់ ថា ការៀបចំ ពិធី ប្រណាំង កាណូត និង ទូក នេសាទ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ដើម្បី ទាក់ទាញ អ្នកទេសចរ ជាតិ អន្តរជាតិ ក៏ ដូចជា ការកម្សាន្ត របស់ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត ។
បន្ថែម ពីលើ នោះ ក៏ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ជា អ្នកនេសាទ មាន ឱកាស បង្ហាញ អត្តសញ្ញាណ និង របរ ជា អ្នកនេសាទ ដែល ជា អត្តសញ្ញាណ មួយ សម្រាប់ អ្នកសមុទ្រ ហើយក៏ ជា ឱកាស ឱ្យ ពួកគាត់ បាន កម្សាន្ត សប្បាយ ជាមួយ មុខរបរ របស់ ខ្លួន ។
មិន ត្រឹម នាំ ភាពសប្បាយរីករាយ ទាក់ទាញ អ្នកទេសចរ បង្ហាញ អត្តសញ្ញាណ អ្នកនេសាទ នោះ ទេ តែ ការរៀបចំ ពិធី ប្រណាំង កាណូត និង ទូក នេសាទ នេះ លោក ម៉ៅ ធ និន ក៏ ចង់ បញ្ជ្រាបសារ ឱ្យ ប្រជាពលរដ្ឋ បាន ជ្រូត ជ្រាប អំពី គុណ តម្លៃ សុខ សន្តិភាព ដែល កម្ពុជា រក បាន រយៈពេល ២៤ ឆ្នាំ មក នេះ ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
លោក ម៉ៅ ធ និន បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ការសប្បាយរីករាយ នេះ អាច ដំណើរការ ទៅ បាន គឺ ដោយសារ សន្តិភាព ហើយក៏ ចង់ ជម្រាប ដល់ ពុក ម៉េ បងប្អូន ប្រជានេសាទ របស់ យើង ដែរ ថា យើង សប្បាយរីករាយ ដោយ តម្លៃ សន្តិភាព ។ តម្លៃ សន្តិភាព បាន ពី នរណា ? ដោយសារ សម្តេច តេជោ ហ៊ុន សែន លោក យកមក ដោយ លំបាក ដោយ ជីវិត ដោយសារ គោល នយោបាយ ឈ្នះ - ឈ្នះ របស់ សម្តេច ទើប យើង មាន ថ្ងៃ នេះ ប្រកបដោយ ភាពសុខដុម និង សប្បាយរីករាយ ។ ដូច្នេះ បងប្អូន ពុក ម៉ែ ចូលរួម ចងចាំ ហើយ ថែរក្សា និង ការពារ សុខ សន្តិភាព ដែល សម្តេច បាន នាំមក នេះ » ។
ប្រជា នេសាទ ដែល បាន ចូលរួម ក្នុង កម្មវិធី ប្រណាំង កាណូត និង ទូក នេសាទ នេះ ជា លើក ដំបូង បាន បង្ហាញ ការសប្បាយរីករាយ ជាខ្លាំង ។ ពួកគាត់ បាន លើកឡើង ថា ព្រឹត្តិការណ៍ នេះ មិន ដែល មាន ទេ នៅលើ ទឹកដី ខេត្ត កំពត ហើយ ពួកគាត់ បាន ពេញចិត្ត ជាខ្លាំង ចំពោះ លោក ម៉ៅ ធ និន សម្រាប់ ការផ្តួចផ្តើម កម្មវិធី សប្បាយ ៗ នេះ ឡើង ។
លោក ម៉ៅ ធ និន បាន គូសបញ្ជាក់ ថា លោក នឹង បន្ត រៀបចំ ព្រឹត្តិការណ៍ នេះ នៅ ឆ្នាំ បន្តបន្ទាប់ ទៀត ហើយ ឱ្យ មាន សភាព ធំ ជាង ឆ្នាំ នេះ ។
សូម បញ្ជាក់ ថា ដើម្បី ចូលរួម អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ឆ្នាំ សកល ២០២៣ ក៏ ដូច បង្ក បរិយាកាស សប្បាយរីករាយ ជូន ប្រជាពល រដ្ឋ ក្នុង ខេត្ត និង អ្នកទេសចរ ជាតិ អន្តរជាតិ នោះ ក្រៅតែ ពី ការរៀបចំ ពិធី ប្រណាំង ទូក នេសាទ ហើយ នោះ រដ្ឋបាល ខេត្ត កំពត បាន រៀបចំ ព្រឹត្តិការណ៍ កម្សាន្ត សប្បាយ ជាច្រើន ទៀត ។ ព្រឹត្តិការណ៍ ទាំងនោះ មាន ដូចជា ការប្រគំ តន្ត្រី ចំនួន ពីរ ទីតាំង ការប្រកួត ប្រដាល់ គុន ខ្មែរ ការសម្តែង ក្បាច់គុន ល្បុក្កតោ សម្តែង លោត ឆ័ត្រ យន្តហោះ លើ អាកាស និង ការបាញ់ កាំជ្រួច អបអរ ឆ្នាំ ថ្មី ផងដែរ ។
រដ្ឋបាល ខេត្ត ក៏ បាន រៀបចំ ពិធី តាំង ពិព័រណ៍ លក់ ផលិត និង ម្ហូប អាហារ នានា ជាច្រើន ស្តង់ ផងដែរ ៕ គណៈកម្មការ ជាតិ ដើម្បី ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ បំភ្លឺ ជុំវិញ ការដុត បំផ្លាញ រថយន្ត ដែល បង្ក្រាប បាន ក្នុង បទល្មើស បំផ្លាញ ធនធាន ធម្មជាតិ
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ គណៈកម្មការ ជាតិ ដើម្បី ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ បាន ឃើញ និង តាមដាន បណ្ដាញ ព័ត៌មាន សង្គម មាន គណនី ហ្វេសប៊ុក ឈ្មោះ « សុខ ទូច » បាន ចុះផ្សាយ កាលពី ថ្ងៃទី ៨ ខែធ្នូ ឆ្នាំ ២០២២ នូវ អត្ថបទ មួយ ថា « ដុត រថយន្ត ចោល ដោយសារ ដឹក ឈើ មនុស្ស ទេជា អ្នកធ្វើ ទុក ទាំង ឈើ ទុក ទាំង រថយន្ត ចាប់ មនុស្ស ខុស ច្បាស់ នោះ ដាក់ គុក វិញ ទើប ត្រូវ រថយន្ត គ្មាន វិញ្ញាណ និង មិន មាន ជីវិត ទេ » ។
ជុំវិញ ចំណុច នេះ មាន ការបញ្ចេញ យោបល់ នៅក្នុង នោះ មាន (76 Comments) គណៈកម្មការ ជាតិ បាន តាមដាន មើល ការបញ្ចេញ យោបល់ នីមួយ ៗ ហើយ យោបល់ ទាំងនោះ ភាគ ច្រើន មាន ការបំផ្លើស ញុះញង់ យោបល់ គ្មាន វិជ្ជាជីវៈ និង អសីលធម៌ ដោយសារ បញ្ចេញ យោបល់ មិន ថ្លឹងថ្លែង រក ការពិត និង មិន ទាន់ យល់ ច្បាស់ ពី ច្បាប់ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ផងដែរ ។
មធ្យោបាយ ដែល គណៈកម្មការ ជាតិ បំផ្លាញ ចោល តាម ច្បាប់ កន្លងទៅ ជា មធ្យោបាយ កែច្នៃ ខុស លក្ខណៈ បច្ចេកទេស សម្រាប់ ដឹក ឈើ ខុស ច្បាប់ តែ ប៉ុណ្ណោះ និង ល្មើស ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ហើយ មិន មែន ជា មធ្យោបាយ អាច ប្រើប្រាស់ ជា ប្រយោជន៍ សង្គមជាតិ នោះ ទេ ។ សូម បុគ្គល ដែល បញ្ចេញ យោបល់ ទាំងអស់ មេត្តា យក ចំណេះ វិជ្ជា ដែល បាន រៀនសូត្រ ពិចារណា សិន មុននឹង បញ្ចេញ យោបល់ ក្នុង ន័យ ស្ថាបនា ។
កាលពី ថ្ងៃទី ២៦ ខែធ្នូ ឆ្នាំ ២០២២ គណៈកម្មការ ជាតិ បាន បើក កិច្ចប្រជុំ ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ ដោយ បូកសរុប លទ្ធផល ការងារ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ ចាប់ពី ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ដល់ ថ្ងៃទី ១៥ ខែធ្នូ ឆ្នាំ ២០២២ ធ្វើ របាយការណ៍ ជូន ប្រមុខ រាជ រដ្ឋាភិបាល ។
លោក វរសេនីយ៍ ឯក សាន សុខ សីហា អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ព្រលប់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ ថា សម្រាប់ កងកម្លាំង ទាំងនេះ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ព្រមទាំង សម្រួល ចរាចរណ៍ ក្នុង រាជធានី ភ្នំពេញ និង ការធ្វើដំណើរ ចេញ - ចូល រាជធានី ភ្នំពេញ របស់ ប្រជាពលរដ្ឋ ។ បន្ថែម ពី នេះ កម្លាំង នគរបាល ទាំងអស់ នេះ ក៏ បាន ដាក់ពង្រាយ នៅ តាម ទីតាំង កម្សាន្ត នានា ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ផងដែរ ។
ទន្ទឹមនឹង នេះ ដែរ អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ឱ្យដឹង ថា សម្រាប់ រក្សា ឱ្យ បាន សណ្តាប់ និង ការបន្ថយ ការកក់ ស្ទះ ចរាចរណ៍ គឺ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ប្រើប្រាស់ កម្លាំង មន្ត្រី នគរបាល ចរាចរណ៍ យ៉ាង ច្រើន នៅ តាម គោលដៅ និង តាម ដងផ្លូវ នានា ជាដើម ។
លោក វរសេនីយ៍ ឯក សាន សុខ សីហា បាន គូសបញ្ជាក់ ថា ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ក៏ បាន ត្រៀម កម្លាំង អគ្គីភ័យ និង រថយន្ត ពន្លត់ អគ្គិភ័យ ២៤ ម៉ោង លើ ២៤ ម៉ោង ដើម្បី ប្រតិបត្តិការ ភ្លាម ៗ ប្រសិនបើ មាន ករណី អគ្គីភ័យ ណាមួយ កើតឡើង ជា យថាហេតុ ។
បន្ថែម ពី នេះ លោក វរសេនីយ៍ ឯក សាន សុខ សីហា បាន ឱ្យដឹង ថា ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ត្រៀម កម្លាំង កង អន្តរាគមន៍ ជាប្រចាំ ក្នុង ករណី មាន បាតុភាព ផ្សេង ៗ ជា យថាហេតុ ។
ក្រុម អ្នក សង្កេត ស្ថានការណ៍ កូរ៉េ ខាងជើង បាន លើកឡើង ថា វា ទំនងជា សកម្មភាព ឆ្លើយតប មួយ ទៀត ចំពោះ ការធ្វើតេស្ត របស់ កូរ៉េ ខាងត្បូង កាលពី ថ្ងៃសុក្រ ក្នុង ការបាញ់ សាកល្បង គ្រាប់ រ៉ុក្កែត អវកាស ដែល ប្រើប្រាស់ ឥន្ធនៈ រឹង និង ផលិត នៅក្នុង ស្រុក ផ្ទាល់ ។ កាលពី ថ្ងៃ ព្រឹក សៅរ៍ កូរ៉េ ខាងជើង ក៏ បាន បាញ់ សាកល្បង មី ស៉ីល បាលិស្ទី គ SRBM ចំនួន ៣គ្រាប់ ចេញ ពី ស្រុក ជុង វ៉ា (Chunghwa) ភាគ ខាងត្បូង ទីក្រុង ព្យុងយ៉ាង ទៅ ធ្លាក់ ចូល ក្នុង សមុទ្រ ខាងកើត ផងដែរ ។
រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ ចេញ សេចក្ដីបំភ្លឺ ព័ត៌មាន ទាក់ទង នឹង ការផ្សព្វផ្សាយ វីដេអូ ឃ្លីប ពី គ្រួសារ កងទ័ព ចំនួន ៣០ គ្រួសារ បាន មក រស់ នៅ លើ ទីតាំង ថ្ម ដា តូច
( ពោធិ៍សាត់ )៖ នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ គេហទំព័រ ឈ្មោះ ជីវិត និង កីឡា បាន ផ្សព្វផ្សាយ វីដេអូ ឃ្លីប ពី គ្រួសារ កងទ័ព ចំនួន ៣០ គ្រួសារ បាន មក រស់ នៅ លើ ទីតាំង ថ្ម ដា តូច ចំណុច គីឡូម៉ែត្រ លេខ ១៦៣ - ១៦៤ ជាច្រើន ឆ្នាំ មកហើយ ហើយ បច្ចុប្បន្ន នេះ ត្រូវ ប្រឈម នឹង ការ បណ្ដេញចេញ ។
ជាមួយ នេះ នៅក្នុង ឱកាស សាកសួរ សុខទុក្ខ កងកម្លាំង ឈរជើង នៅ ខ្សែ បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ឯកឧត្តម បាន ប្រកាស ជូន កងកម្លាំង គ្រប់ អង្គភាព ពិនិត្យមើល គ្រួសារ កងទ័ព ដែល ខ្វះខាត ដី ពិតប្រាកដ ដើម្បី ពិនិត្យ លទ្ធភាព ដោះស្រាយ បញ្ហា ជូន ពួកគាត់ ។ រដ្ឋបាល ខេត្ត សូម បញ្ជាក់ ជូន សាធារណជន បន្ថែម ឱ្យ បាន ជ្រាប ដូចត ទៅ៖
ទោះបី យ៉ាងណា ក្តី រដ្ឋបាល ខេត្ត នៅតែ គិតគូរ និង ពិនិត្យ លទ្ធភាព រក ទីតាំង ដី សមស្រប ណាមួយ ដើម្បី ដោះស្រាយ ជូន ពួក គាត់ ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។ រដ្ឋបាល ខេត្ត សូម ថ្លែងអំណរគុណ គ្រប់ បណ្ដា សារព័ត៌មាន ទាំងអស់ ដែល ចូលរួម ផ្សព្វផ្សាយ ឆ្លុះបញ្ចាំង យ៉ាង ត្រឹមត្រូវ ជាក់ស្ដែង ចំពោះ យន្តការដឹកនាំ របស់ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ នា ពេល បច្ចុប្បន្ន ។
ខាងក្រោម នេះ ជា សុន្ទរកថា របស់ លោក៖
សម មិត្ត មិត្តភ័ក្ត លោក លោកស្រី អ្នកនាង កញ្ញា ជា ទី មេត្រី៖ រាត្រី សួស្តី ឆ្នាំ ២០២៣ ជិត នឹង ខិត ចូល មក ហើយ ។ ខ្ញុំ សូម ជូនពរ អ្នក ទាំងអស់ គ្នា រីករាយ ឆ្នាំ ថ្មី ! ឆ្នាំ ២០២២ យើង បាន បើក ធ្វើ សមាជ បក្ស កុម្មុយនីស្ត ចិន លើក ទី២០ ដោយ ជោគជ័យ ដែល បាន គ្រោង ផែនការ សម្រាប់ ការកសាង ដោយ គ្រប់ ជ្រុងជ្រោយ នូវ ប្រទេស សង្គម និយម ទំនើប ជំរុញ ផែនការស្តារ ភាព រុងរឿង របស់ ប្រជាជាតិ ចិន ឡើងវិញ តាមរយៈ ការធ្វើ ទ នើបកម្ម តាម បែបផែន ចិន យើង បាន ចាប់ផ្តើម យុគសម័យ នៃ ដំណើរ ខិតខំ តស៊ូ ដ៏ ថ្មី ។
បច្ចុប្បន្ន នេះ ការបង្ការ និង គ្រប់គ្រង នឹង ជំងឺ កូវីដ១៩ បាន ឈានចូល ដំណាក់កាល ថ្មី តែ នៅតែ ស្ថិត ក្នុង ខណៈពេល ដ៏ ពិបាក យើង សុទ្ធតែ ខិតខំ តស៊ូ យ៉ាង មុតមាំ អនាគត ដ៏ ភ្លឺស្វាង គឺ នៅ ខាងមុខ ហើយ យើង គួរ ខិតខំ ថែម មួយ កម្រិត ទៀត ការប្រកាន់ខ្ជាប់ គឺជា ជ័យជម្នះ សាមគ្គីភាព គឺជា ជ័យជម្នះ !
ប្រទេស ចិន នា ថ្ងៃស្អែក ក្តីសង្ឃឹម ពឹង លើ យុវជន ។ យុវជន មាន ភាព ក្លៀវក្លា ទើប ប្រទេសជាតិ មាន ភាពរុងរឿង ការអភិវឌ្ឍ ប្រទេស ចិន ពឹង លើ យុវជន ទាំងឡាយ ដែល រ៉ាប់រង បេសកកម្ម យ៉ាង សកម្ម ។ យុវជន ពោរពេញ ទៅ ដោយ កម្លាំង រស់រវើក យុវវ័យ បង្កប់ នូវ ក្តីសង្ឃឹម ។ យុវជន ទាំងឡាយ គួរ បណ្តុះ មនោសញ្ចេតនា ចំពោះ គ្រួសារ និង ប្រទេសជាតិ លត់ ដំអត្តចរិត ឈាន ទៅ មុខ យ៉ាង ក្លាហាន ខិតខំ បំពេញ ការងារ ដើម្បី មិន ខ្ជះខ្ជាយ យុគសម័យ មិន ខ្ជះខ្ជាយ យុវវ័យ ។
នៅ ពេល នេះ មាន មនុស្ស ជាច្រើន កំពុងតែ ជាប់រវល់ នឹង ការងារ អ្នក ទាំងអស់ គ្នា នឿយហត់ ហើយ ! ស្នូរ ជួង ឆ្នាំ ថ្មី នឹង បន្លឺ ឡើង យើង រួមគ្នា អបអរ ទទួល ថ្ងៃទី មួយ នៃ ឆ្នាំ ២០២៣ ដោយ បំណងប្រាថ្នា ដ៏ ល្អ បវរ ចំពោះ អនាគត ។ សូម ជូនពរ មាតុភូមិ មាន ភាពរុងរឿង ប្រទេស ជាតិ សុខសាន្ត ប្រជាជន មាន សុភមង្គល សូម ជូនពរ ពិភពលោក មាន សន្តិភាព និង ភាពស្រស់បំព្រង មាន សុភមង្គល និង ភាពសុខសាន្ត សូម ជូនពរ អ្នក ទាំងអស់ គ្នា រីករាយ ឆ្នាំ ថ្មី សម្រេច អ្វី ៗ ដូច ក្តី បំណង ៕ សូម អរគុណ !
មិន ត្រូវ បើកបរ ក្នុង ស្ថានភាពងងុយដេក ជាដាច់ខាត ! ស្លាប់ ៦នាក់ និង របួស ១៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៣១ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ១៦ នាក់ ។
( ភ្នំពេញ ) ៖ រយៈពេល ៨៧៦០ ម៉ោង នៃ ឆ្នាំ ២០២២ បាន រសាត់ ផុត ទៅទៀត ហើយ ហើយ កាលវេលា ថ្មី នៃ ឆ្នាំ ២០២៣ ក៏ បាន ចូល មកដល់ ។ រយៈពេល ពេញ មួយ ឆ្នាំ ២០២២ ដែល ជា ឆ្នាំ ចាស់ នេះ ប្រាកដ ណាស់ រឿងរ៉ាវ ជីវិត គ្រប់ រសជាតិ ទាំង ផ្អែម ប្រៃ ល្វីង ជូរ ចត់ សប្បាយរីករាយ ទុក្ខសោក សុទ្ធតែ បាន ចូលមក ប្រលែង លេង ក្នុង ជីវិត មនុស្ស គ្រប់ រូប ទៅ តាម កត្តា កំណត់ របស់ ធម្មជាតិ នៃ ជីវិត ក្នុង វាលវដ្ត សង្សារ នេះ ។
រយៈពេល ៣៦៥ ថ្ងៃ នៃ ឆ្នាំ ២០២២ មើល ទៅ ហាក់ យូរ អើយ សែន យូរ សម្រាប់ អ្នក អង្គុយ ទន្ទឹងរង់ចាំ ពេលវេលា និង ចំពោះ អ្នក ជួប រឿងរ៉ាវ មិន ល្អ ៗ ទាំងឡាយ ដែល ចង់ឱ្យ រឿងរ៉ាវ មិន ល្អ ទាំងនោះ កន្លងផុត ទៅ តាម ពេលវេលា នោះ ។ ពេលវេលា នេះ វា ហាក់ មាន ល្បឿន លឿន លយ ទៅ វិញ នៅពេល យើង ប្រឹង ធ្វើ អ្វី មួយ ប្រជែង ជាមួយ វា ឬ កំពុង ជាប់ ចិត្ត ជាមួយ ជីវិត និង សកម្មភាព ដ៏ រីករាយ និង ពេញចិត្ត ណាមួយ នោះ ។
ពេញ មួយ ឆ្នាំ ២០២២ នេះ គ្រួសារ ខ្មែរ ខ្លះ ក៏ បាន ជួប រឿង សប្បាយរីករាយ សុភមង្គល ជាមួយ ភាពជោគជ័យ ក្នុង ជីវិត ក៏ ដូចជា ការងារ និង ការសិក្សា ។ តែ ក៏ មាន គ្រួសារ ខ្លះ ទៀត ប្រហែល មិន បាន ជួប រឿង ល្អ ដែល ជា ភាពសប្បាយរីករាយ ដូច ខ្លួន ប៉ង ប្រថ្នា នោះ ដែរ ពោលគឺ ត្រូវ ញ៉ាំ ញី ដោយ រឿងរ៉ាវ មិន ល្អ ជាច្រើន ដូច ខ្សែ អំបោះជំពាក់ មុខ ស្រាយ មិន ចេញ ។ តែ ណ្ហើយ ចុះ សូម ឱ្យ រឿងរ៉ាវ មិន ល្អ ទាំងឡាយ បាន រសាត់ បាត់ ទៅ តាម ពេលវេលា កន្លងផុត ទៅ នេះ ហើយ សូម រឿង ល្អ ៗ ចូលមក ជំនួស នៅក្នុង ឆ្នាំ ថ្មី ។
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ចំណាត់ការ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដក តំណែង លោក ភូ លិ អភិបាល រង ខេត្ត កែប ដែល បាន ប្រព្រឹត្ត ទង្វើ ដ៏ គួរឱ្យ ស្អប់ខ្ពើម និង អសីលធម៌ ដោយ បាន ប្រើ អំពើហិង្សា និង បៀតបៀន លើ ស្ត្រី ២រូប ។
ក្នុង នោះ ស្រ្តី មួយ រូប គឺជា មន្ត្រីរាជការ ពន្ធដារ ថ្នាក់ ប្រធាន ការិយាល័យ នៃ សាខា ពន្ធដារ ខេត្ត កែប ត្រូវ ទទួលរង របួស ស្នាម យ៉ាង ធ្ងន់ធ្ងរ រហូតដល់ ត្រូវបាន បញ្ជូន ទៅ មន្ទីរពេទ្យ ដើម្បី ទទួល ការសង្គ្រោះ បន្ទាន់ ដោយ មាន ការដេរ មុខរបួស រហូតដល់ ចំនួន ១៦ ថ្នេរ ។ ចំណាត់ការ ដ៏ ត្រឹមត្រូវ និង ទាន់ ពេលវេលា នេះ គឺជា ការស្វែងរក យុត្តិធម៌ ជូន ស្ត្រី រងគ្រោះ ទាំង ពីរ រូប រួមទាំង ស្ត្រី មួយ រូប ដែល ជា មន្ត្រីរាជការ ពន្ធដារ ផងដែរ ។
យើងខ្ញុំ ទាំងអស់ គ្នា សូម គោរព ថ្លែងអំណរគុណ ដ៏ ជ្រាលជ្រៅ ចំពោះ ចំណាត់ការ របស់ សម្ដេច តេជោ ហ៊ុន សែន លើ ករណី នេះ ដែល បង្ហាញ អំពី ការយកចិត្តទុកដាក់ ខ្ពស់ លើ សុខុមាលភាព មន្ត្រីរាជការ ក៏ ដូចជា ប្រជាពលរដ្ឋ គ្រប់ លំដាប់ថ្នាក់ ។
ទន្ទឹមនឹង នេះ យើងខ្ញុំ សូម សំណូមពរ ដល់ អាជ្ញាធរ ពាក់ព័ន្ធ សូម បន្ត ចាត់ វិធានការ បន្តបន្ទាប់ តាម ច្បាប់ ចំពោះ បុគ្គល រូប នេះ ដើម្បី ស្វែងរក យុត្តិធម៌ បន្ថែម ជូន ជនរងគ្រោះ ក៏ ដូចជា គាំទ្រ ដល់ ការលើកកម្ពស់ សមភាព យេនឌ័រ នៅ កម្ពុជា ទប់ស្កាត់ និង បង្ការ ការប្រើប្រាស់ អំពើហិង្សា និង ធានា ភាពយុត្តិធម៌ សុខ សន្តិភាព ស្ថិរភាព វិបុលភាព សេចក្តីសុខ និង សុភមង្គល របស់ ប្រជាជន កម្ពុជា »៕
យោង តាម ស្ថិតិ ចេញផ្សាយ ដោយ ក្រសួង សុខាភិបាល ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ខាងលើ មាន ចំនួន ៨៩ ករណី បច្ចុប្បន្ន កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ក្នុង នោះ ១៤ ករណី ស្ថិត នៅក្នុង បន្ទប់ ថែទាំ ។
គ្មាន ការស្លាប់ ដោយសារ កូវី ដ១៩ ត្រូវបាន គេ រាយការណ៍ នោះ ទេ ថ្ងៃសៅរ៍ នេះ ដែល ធ្វើឲ្យ ចំនួន អ្នកស្លាប់ សរុប មិន ផ្លាស់ប្តូរ នៅ ត្រឹម ១. ៧១១ នាក់ ៕
សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បើក ទំព័រ ឆ្នាំ ថ្មី ជាមួយ ការផ្តល់ ក្តីស្រឡាញ់ ជូន កុមារី និង យុវតី រងគ្រោះ ដោយ ការរំលោភ និង ជួញដូរ នៅ អង្គការ អាហ្វេ ស៊ីប
( ភ្នំពេញ ) ៖ ជាមួយ ការបើក ទំព័រ ឆ្នាំ ថ្មី ២០២៣ នា ព្រឹក ថ្ងៃអាទិត្យ ទី០១ ខែមករា ឆ្នាំ ២០២៣ ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នឹង អញ្ជើញ សាកសួរ សុខទុក្ខ កុមារី និង យុវតី ដែល រងគ្រោះ ដោយ ការរំលោភបំពាន និង ជួញដូរ ផ្លូវភេទ នៅ អង្គការ អាហ្វេ ស៊ីប កម្ពុជា ស្ថិត នៅ សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
កាលពី ថ្ងៃទី ១០ ខែមីនា ឆ្នាំ ២០១៩ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ធ្លាប់ បាន អញ្ជើញ ជួប សំណេះសំណាល និង សួរសុខទុក្ខ ដោយ ផ្ទាល់ ជាមួយ យុវនារី និង កុមារី ដែល កំពុង ទទួល ការគាំពារ នៅក្នុង មណ្ឌល ស្តារ នីតិសម្បទា របស់ អង្គការ អាហ្វេ ស៊ីប កម្ពុជា រួច ម្តង មក ហើយ ។
ស្ថានទូត ចិន បង្ហាញ ព័ត៌មាន សំខាន់ ៗ ទាំង១០ ស្តី អំពី ទំនាក់ទំនង ចិន និង កម្ពុជា ប្រចាំ ឆ្នាំ ២០២២
* ទី ១៖ លោក ប្រធានាធិបតី ចិន បាន ពិភាក្សា ការងារ ជាមួយ សម្ដេច តេជោ តាមរយៈ ទូរស័ព្ទ
( ប៉េកាំង ) ៖ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ គណៈកម្មាធិការ សភា ប្រឹក្សា នយោបាយ ប្រជាជន ទូទាំង ប្រទេស ចិន បាន ធ្វើ ពិធី សំណេះសំណាល ជូនពរ ឆ្នាំ ថ្មី ឆ្នាំ សកល ។ លោក Xi Jinping អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន ប្រធាន រដ្ឋ ចិន ប្រធាន គណៈកម្មាធិការ យោធា មជ្ឈិម ចិន បាន អញ្ជើញ ចូលរួម និង ថ្លែង សុន្ទរកថា គន្លឹះ ដោយ បាន គូសបញ្ជាក់ ថា ឆ្នាំ ២០២៣ជា ឆ្នាំ ចាប់ផ្តើម អនុវត្ត ដោយ គ្រប់ ជ្រុងជ្រោយ នូវ ស្មារតី សមាជ បក្ស កុម្មុយនីស្ត ចិន លើក ទី២០ ។
យើង ត្រូវ ខិតខំ ផ្តល់ មូលដ្ឋាន ដ៏ ល្អ ប្រសើរ ដល់ ការសម្រេច គោលដៅ តស៊ូ មួយ រយ ឆ្នាំ ទី ពីរ ។ លោក Xi Jinping បាន តាំង នាម គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន ក្រុមប្រឹក្សា កិច្ចការ រដ្ឋ ចិន និង គណៈកម្មាធិការ យោធា មជ្ឈិម ចិន សូម សួរសុខទុក្ខ និង ជូនពរ យ៉ាង ស្មោះស្ម័គ្រ ចំពោះ ឥស្សរជន បណ្តា បក្ស ប្រធាធិបតេយ្យ ឥស្សរជនសភា ឧស្សាហកម្ម ពាណិជ្ជកម្ម ឥស្សរជន មិន ចូល បក្ស ប្រជាជន គ្រប់ ជនជាតិ ទូទាំង ប្រទេស បងប្អូន ជន រួម ជាតិ នៅ ហុងកុង ម៉ាកាវ តៃវ៉ា ន និង ក្រៅ ប្រទេស
ក៏ ដូចជា ប្រិយមិត្ត គ្រប់ ប្រទេស ដែល យកចិត្តទុកដាក់ និង គាំទ្រ ការកសាង ទំនើបកម្ម បែបផែន ចិន ។ នៅ ឆ្នាំ ថ្មី សភា ប្រឹក្សា នយោបាយ ប្រជាជន ចិន ត្រូវ បន្ត សម្រួល គាំទ្រ ការដឹកនាំ របស់ បក្ស រណសិរ្ស រួបរួម ជាតិ ធ្វើ ប្រជាធិបតេយ្យ ដោយ ពិគ្រោះ ពិភាក្សា គ្នា ដើម្បី ផ្តល់ ជា កម្លាំង និង ប្រាជ្ញា ដល់ ការសម្រេច ភារកិច្ច និង គោលដៅ នៃ យុគសម័យ ថ្មី និង ដំណើរការ ថ្មី ៕ អតីត សម្ដេច សង្ឃ កាតូលិក ប៉ាប Benedict សុគត ហើយ ក្នុង ព្រះជន្ម ៩៥ ព្រះវស្សា
សភា តំណាង ប្រជាជន ទូទាំង ប្រទេស ចិន បាន អនុម័ត លើ « សម្រាយ អំពី មាត្រា ទី ១៤ និង មាត្រា ទី៤៧ នៃ ច្បាប់ គាំពារ សន្តិសុខ ជាតិ របស់ រដ្ឋបាល ពិសេស ហុងកុង នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន » ព្រមទាំង ប្រកាស ជាសាធារណៈ
( ប៉េកាំង ) ៖ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ កិច្ចប្រជុំ លើក ទី ៣៨ នៃ គណកម្មាធិការ អចិន្ត្រយ៍ សភា តំណាង ប្រជាជន ទូទាំង ប្រទេស ចិន នីតិកាល ទី ១៣ បាន អនុម័ត លើ « សម្រាយ អំពី មាត្រា ទី ១៤ និង មាត្រា ទី៤៧ នៃ ច្បាប់ គាំពារ សន្តិសុខ ជាតិ របស់ តំបន់ រដ្ឋបាល ពិសេស ហុងកុង នៃ សាធារណរដ្ឋ ប្រជានាមិត ចិន » ព្រមទាំង ចេញផ្សាយ សេចក្តីប្រកាស ជាសាធារណៈ ។
យប់ ថ្ងៃទី ៣០ធ្នូ លោក Li Jiachao អភិបាល តំបន់ រដ្ឋបាល ពិសេស ហុងកុង ចេញ លិខិត សម្ដែង ការស្វាគមន៍ និង ថ្លែងអំណរគុណ ចំពោះ សេចក្ដីប្រកាស នេះ ។ ស្ថាប័ន យុត្តិធម៌ ហុងកុង បាន ថ្លែង ការគោរព និង ស្វាគមន៍ ចំពោះ ការពន្យល់ បកស្រាយ ។ អ្នកនាំពាក្យ ការិយាល័យ សន្តិសុខ ជាតិ ចិន ប្រចាំ នៅ ហុងកុង បាន លើកឡើង ថា ការពន្យល់ បកស្រាយ បាន ដោះស្រាយ បញ្ហា ដែល បាន ជួបប្រទះ ក្នុង ពេល អនុវត្ត ច្បាប់ សន្តិសុខ ជាតិ របស់ ហុងកុង ដែល មាន សារៈសំខាន់ ចំពោះ ការអនុវត្ត ច្បាប់ ដោយ ត្រឹមត្រូវ និង ជាក់លាក់ ៕
សម្តេច តេជោ ហ៊ុន សែន ជំរុញ ឱ្យ ផលិត ករ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូរណ៌ មី» ចុះ ថត ដោយ ផ្ទាល់ នៅ តាម ទីតាំង ប្រវត្តិសាស្រ្ត មួយចំនួន
សម្តេច តេជោ បន្ត ថា ដំណើរ សាច់រឿង មួយចំនួន ធំ យើង គួតែ ចុះ ថត ដោយ ផ្ទាល់ នៅ តាម ទីតាំង ប្រវត្តិសាស្រ្ត មួយចំនួន ឯ សាច់រឿង មួយចំនួន យើង ត្រូវ ថត ក្នុង ស្ទីឌីយោ ហើយ តួ ស ម្លែង ទៀតសោត ត្រូវតែ មាន ការហ្វឹកហាត់បណ្តុះបណ្តាលឲ្យ មាន យល់ដឹង ច្បាស់លាស់ និង ស៊ី ជំរៅ ទៅនឹង ប្រវត្តិសាស្រ្ត ពិត របស់ ដែល បាន កើតឡើង ទាក់ទិន ទៅនឹង សាច់រឿង ទាំងមូល ។
ការលើកឡើង នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ ផលិតភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូរណ៌ មី » នៅ មុន បំណាច់ ឆ្នាំ ចាស់ ២០២២ ឈាន ចូល ឆ្នាំ ២០២៣ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែធ្នូ នេះ ។
គិត ចាប់តាំងពី ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២២ រហូតមកដល បច្ចុប្បន្ន នេះ មាន រយៈពេល ១១ខែ ហើយ គណៈកម្មការ សម្រេច ផលិត បាន ចំនួន ៤៨២ ឈុត ឆាក ស្មើនឹង ៤៥ ភាគរយ នៃ សាច់រឿង សរុប ។ ឈុត ឆាក ដែល នៅ សេសសល់ គណៈកម្មការ នឹង ខិតខំ យកចិត្តទុកដាក់ ថត បំពេញ បន្ថែម ដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
( កំពង់ធំ )៖ ខ្នង ផ្ទះ ទី ២៣៦ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន ប្រគល់ ជូន អតីត យុទ្ធជន សោធន និវត្តន៍ នៅ ភូមិ ជី មាស ឃុំ ម្សា ក្រង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ នា ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ ។
ការប្រគល់ ផ្ទះ នេះ ធ្វើឡើង តាមរយៈ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ។
ក្នុង ពិធី ប្រគល់ ផ្ទះ ថ្មី នៅ ពេល នេះ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន អំពាវនាវ ដល់ ក្រុមគ្រួសារ អតីត យុទ្ធ និង ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ខិតខំ ថែរក្សា សុខភាព និង សូមអញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង ដូស ទី៤និង ដូស ទី៥ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ តាម មណ្ឌល សុខភាព តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
ក្នុង ពិធី ប្រគល់ ផ្ទះ ថ្មី នេះ ក្រុមការងារ អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ បាន នាំយក អំណោយ របស់ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ផ្ដល់ជូន គាត់ បន្ថែម ទៀត មាន អង្ករ ចំនួន ១០០ គីឡូក្រាម មី ចំនួន ២កេស ទឹកត្រី - ទឹកស៊ី អ៉ីវ ចំនួន ២យួរ និង សម្ភារ សម្រាប់ ប្រើប្រាស់ ក្នុង ផ្ទះ បាយ មួយចំនួន ព្រមទាំង ថវិកា មួយ ចំនួន ផងដែរ ។
លោក ព្រិន្ទ បាល ទោ ហេង ជាន អតីត យុទ្ធជន សោធន និវត្តន៍ និង ក្រុមគ្រួសារ បាន ថ្លែងអំណរគុណ ជូនពរ ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង លោក ហ៊ុន ម៉ាណែត និង លោកស្រី រួមទាំង គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង អប់រំ បន្ត ជំរុញ ឱ្យ មាន ការបង្កើត ភាពជាដៃគូរ វាង សាកលវិទ្យាល័យ និង សាលារៀន ជំនាន់ ថ្មី ខាង ផ្នែក បច្ចេកទេស ឱ្យ បាន ច្រើន
ជាមួយគ្នា នោះ លោក បណ្ឌិត សាន វឌ្ឍនា ក៏ បាន ណែនាំ ឱ្យ សិស្សានុសិស្ស និសិ្សត គួរ រៀន ភាសា ឱ្យ បាន ពីរ ទៅ បី ភាសា ពិសេស ផ្តោត ជា សំខាន់ លើ ភាសា អង់គ្លេស និង កុំព្យូរ ទ័រ ផង ។ បន្ថែម ពី នេះ លោក ក៏ បាន គាំទ្រ ក្នុង ការធ្វើជា សក្ខីភាព ក្នុង ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ នេះ ផងដែរ ។
ជា ចក្ខុវិស័យ របស់ លោក បណ្ឌិត ឃៀង សុធី សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ខេម តិច គឺ ចង់ ប្រែក្លាយជា សាកលវិទ្យាល័យ ឈាន មុខ គេ ក្នុង វិស័យ បច្ចេកវិទ្យា និង វិទ្យាសាស្ត្រ ដើម្បី រួមចំណែក ដល់ ការអភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព នៅ កម្ពុជា ផងដែរ ។
លោក មានប្រសាសន៍ ថា៖ « ខ្ញុំ សប្បាយ ចិត្ត ដែល បាន ឃើញ បងប្អូន យើង ទទួលបាន ភោគផល ត្រី ពី បឹង ទន្លេ សាប មក ហើយក៏ បាន ឃើញ ដែរ ថា នេះ ជា លទ្ធផល នៃ ការខំប្រឹងប្រែង ក្នុង រដូវ ទឹក ឡើង កន្លងទៅ ដែល បាន អនុវត្ត ច្បាប់ បាន ល្អ ថែរក្សា ត្រី សម្រាប់ ឱ្យ បងប្អូន យើង អាច ទទួលបាន នូវ ភោគផល នេះ បាន ទាំងអស់ គ្នា » ។
ពលរដ្ឋ រូប នេះ បាន ឱ្យដឹង ទៀត ថា លោក មាន បំណង នឹង ទិញ ត្រី ប្រហែល ១០០ គីឡូក្រាម សម្រាប់ ធ្វើ ផ្អក និង ប្រហុក ទុក បរិភោគ ក្នុង គ្រួសារ រហូតដល់ រដូវ ប្រមូល ផល ឆ្នាំ ក្រោយ ទៀត ។
ចំណែក ពលរដ្ឋ មួយ រូប ទៀត ដែល កំពុង មមាញឹក កាត់ ក្បាល ត្រី សម្រាប់ ធ្វើ ផ្អក ប្រហុក បាន កត់សម្គាល់ ថា ពលរដ្ឋ មកពី ខេត្ត មួយចំនួន ដូចជា កំពង់ស្ពឺ កំពង់ឆ្នាំង តាកែវ កណ្តាល ជាដើម បាន ចាប់ផ្តើម មក ទិញ ត្រី ជា ហូរហែ ដើម្បី យក ទៅ ធ្វើ ផ្អក ប្រហុក ឬ ត្រី ឆ្អើរ សម្រាប់ ទុក ផ្គត់ផ្គង់ គ្រួសារ និង សម្រាប់ លក់ដូរ ។
ក្រឹត្យ ខាងលើ ដដែល បាន បញ្ជាក់ ទៀត ថា កងទ័ព រុស្ស៉ី ដែល កំពុង ប្រយុទ្ធ នៅក្នុង ប្រទេស អ៊ុយក្រែន ក៏ មាន សិទ្ធិ ទទួលបាន អំណោយ និង រង្វាន់ លើកទឹកចិត្ត ផងដែរ ប្រសិនបើ ពួកគេ ប្រកាន់ភ្ជាប់ នូវ អត្តចរិត មនុស្សធម៌ ឬ ក៏ ទទួលបាន រង្វាន់ ទាំងនេះ នៅក្រោម ក្របខណ្ឌ នូវ អ្វី ដែល វិមាន ក្រឹមឡាំង ហៅ ជា ប្រតិបត្តិការ យោធា ពិសេស នៅ អ៊ុយក្រែន ដែល លោក ខាងលិច និង ទីក្រុង កៀវ ចាត់ទុក ថា ជា សង្រ្គាម ឈ្លានពាន ។
គួរ បញ្ជាក់ ថា សារព័ត៌មាន Moscow Times បាន រាយការណ៍ ថា លោក ប្រធានាធិបតី ពូទីន បាន ចុះហត្ថលេខា លើ ក្រឹត្យ មួយ កាលពី ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ ដោយ លុបចោល ការតម្រូវ ឱ្យ មន្ត្រី រដ្ឋាភិបាល បង្ហាញ ព័ត៌មាន ពី ប្រាក់ ចំណូល អំឡុង សង្រ្គាម របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន សំដៅ ទប់ស្កាត់ អំពើពុករលួយ ៕
មន្ត្រីរាជការ ២០ រូប នៅ ខេត្ត កំពង់ធំ ត្រូវបាន ប្រកាស ចូលកាន់ មុខតំណែង នាយក រង រដ្ឋបាល សាលា ខេត្ត និង រចនាសម្ព័ន្ធ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត
( កំពង់ធំ )៖ កាលពី រសៀល ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ និង លោក ឈុន ឈន់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពង់ធំ និង លោក ងួន រតនៈ អភិបាល ខេត្ត បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង មន្ត្រីរាជការ ចំនួន ២០ រូប ជា នាយក រង រដ្ឋបាល សាលា ខេត្ត និង រចនាសម្ព័ន្ធ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត នៅ សាល ប្រជុំ សាលា ខេត្ត កំពង់ធំ ។
ថ្លែង នៅក្នុង ពិធី ប្រកាស នោះ លោក ងួន រតនៈ ថ្លែង ថា ការប្រកាស មុខតំណែង មន្ត្រីរាជការ ទាំង ២០ រូប នេះ រួម មាន ៧ អង្គភាព៖ សាលា ខេត្ត កំពង់ធំ ០៥រូប . មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ចំនួន ០២ រូប . មន្ទីរ អប់រំ យុវជន និង កីឡា ចំនួន ០៣ រូប . មន្ទីរ កិច្ចការ នារី ចំនួន ០៣ រូប . មន្ទីរ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ចំនួន ០១ រូប . មន្ទីរ ពាណិជ្ជកម្ម ចំនួន ០១ រូប និង មន្ទីរ ផែនការ ចំនួន ០៤ រូប ។
លោក បាន បញ្ជាក់ ថា ពិធី ប្រកាស មន្ត្រីរាជការ ឲ្យ កាន់ មុខតំណែង នៅក្នុង អង្គភាព មន្ទីរ អង្គភាព នា ពេលនេះ ដើម្បីឲ្យ ការដឹកនាំ និង គ្រប់គ្រង មាន ភាពត្រឹមត្រូវ និង យុត្តិធម៌ ប្រកបដោយ គុណភាព ប្រសិទ្ធភាព ខ្ពស់ សម្រាប់ ជា ផ្លូវ ឈាន ទៅរក ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ។ ក្នុង នោះ ចូលរួម ធ្វើ ការងារ ដោយ មាន ការទទួលខុសត្រូវ ទៅ តាម បំណែង ចែក ភារកិច្ច ហ៊ាន ធ្វើ ហ៊ាន សម្រេច ដើម្បីឲ្យ មាន ភាពច្បាស់លាស់ ឱ្យ មន្ទីរ អង្គភាព ក៏ មាន ការរីកចម្រើន ជឿនលឿន បន្ត ទៀត ដែរ ។
សូម បញ្ជាក់ ដែរ ថា កម្មវិធី ដក ពិន្ទុ បណ្ណ បើកបរ និង ការបង់ប្រាក់ ពិន័យ អន្តរការណ៍ នេះ បាន ដាក់ ឱ្យ អនុវត្តន៍ សាកល្បង កាលពី ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២២ កន្លងទៅ នៅ តាម គោលដៅ មួយចំនួន ដែល គិត មកទល់ ពេលនេះ មាន រយៈពេល ៤ខែ ហើយ និង មាន បណ្ណ បើកបរ ប្រមាណ ២៣ ០១៥ បណ្ណ ត្រូវបាន ដក ពិន្ទុ ផងដែរ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរ រាចរណ៍ ផ្លូវគោ ក៖
សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ ផលិត ខ្សែភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី »
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ ផលិត ខ្សែភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី » ។
នៅ ព្រឹក ថ្ងៃ នេះ មុនពេល អញ្ជើញ សំណេះសំណាល សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក៏ បាន អញ្ជើញ កាត់ ខ្សែបូរ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ អគារ សាល ប្រជុំ របស់ ទី បញ្ជាការដ្ឋាន អង្គរក្ស ផងដែរ ។
ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ៩នាក់ និង របួស ៨នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី៣០ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៩នាក់ និង របួស ធ្ងន់ ស្រាល ៨នាក់ ។
ការដក តំណែង នេះ ធ្វើឡើង តប តាម សំណើ របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ។
សូម បញ្ជាក់ ថា ការសម្រេច ដក លោក ភូ លិ ចេញ ពី អភិបាល រង ខេត្ត កែប បាន កើតមាន ក្រោយពេល ផ្ទុះ រឿង អាស្រូវ ប្រើ ហិង្សា លើ មន្ត្រី សាខា ពន្ធដារ ខេត្ត កែប ។
សូម រំលឹក ថា កាលពី យប់ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ លោក ភូ លិ និង ស្រ្តី រង អំពើហិង្សា ឈ្មោះ ខូវ ហ៊ុយ ឡាំង បាន ទៅ ចូលរួម កម្មវិធី ពិសារ អាហារ សាមគ្គី អបអរសាទរ ការចូលកាន់ មុខតំណែង ប្រធាន មន្ទីរ បរិស្ថាន ខេត្ត ។
លុះ ម៉ោង ប្រហែល ៧៖៣០ នាទី យប់ បន្ទាប់ពី បាន ក្រេប ដឹក ប្តូរ និស្ស័យ រហូត ស្រវឹង ហើយ នោះ លោក ភូ លិ បាន ថើប ក្បាល នារី ម្នាក់ ជា សាច់ញាតិ របស់ ឈ្មោះ លោកស្រី ខូវ ហ៊ុយ ឡាំង ដែល មើល ទៅ មិន សាកសម នោះ ឡើយ ។
អ្នក ឃើញ ហេតុការណ៍ បន្ត ថា ក្រោយ នារី រង ការបៀតបៀន និយាយ បែប នេះ លោក ភូ លិ ក៏ បាន ដើរ ចេញ ទៅ តុ របស់ លោក វិញ ។ មួយ សន្ទុយ ក្រោយមក ស្រាប់តែ ដើរ ត្រលប់មក ម្ដង ទៀត ទើប ជនរងគ្រោះ ឈ្មោះ ខូវ ហ៊ុយ ឡាំង និង ស្ត្រី រង ការបៀតបៀន ព្រមទាំង អ្នក រួម តុ ដទៃ ទៀត ក្រោក ដើរ ចេញ ពី តុ អាហារ បម្រុង ត្រលប់ ទៅ ផ្ទះ ស្រាប់តែ លោក ភូ លិ យក កែវ ស្រា គប់ លើ ឈ្មោះ ខូវ ហ៊ុយ ឡាំង បែក ក្បាល ឈាម ស្រោច ខ្លួន ដេរ ប្រមាណ ១៦ថ្នេរ ។
ប្រភព បន្ត ថា ក្រោយពេល កើត ហេតុ ហិង្សា និង ការបៀតបៀន នេះ លោក ភូ លិ មិន ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន នោះ ឡើយ ។
លោក ភូ លិ មាន អតីតភាព ជា អភិបាល រង ខេត្ត កំពត តែ ព្រោះតែ ភាព មិន ចុះសម្រុង ការងារ ជាមួយ មន្ត្រី ក្នុង ខេត្ត ក៏ ត្រូវបាន ប្តូរ ទៅកាន់ ខេត្ត កែប វិញ ។
អ្នក ដែល ធ្លាប់ ស្គាល់ លោក ភូ លិ បាន អះអាង ថា លោក ភូ លិ ជា មនុស្ស មាន ចរិត មិន ថ្លៃថ្នូរ ជាពិសេស នៅពេល ស្រវឹង តែង ធ្វើ ទង្វើ មិន គប្បី មួយចំនួន បំបៀបំពាន លើ កិត្តិយស របស់ ស្ត្រី ៕ ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ បេឡារុស កោះហៅ ឯក អគ្គ រដ្ឋទូត អ៊ុយក្រែន ក្រោយ បាញ់ ទម្លាក់ មីស៊ីល មួយ គ្រាប់
២៖ ប្រមុខ ការទូត រុស្ស៉ី ព្រមាន ថា យោធា របស់ ខ្លួន នឹង កាត់ផ្ដាច់ ការផ្គត់ផ្គង់ អាវុធ ពី លោក ខាងលិច ទៅ ឱ្យ អ៊ុយក្រែន
៤៖ លោកស្រី អោង សាន ស៊ូជី ត្រូវ តុលាការ មីយ៉ាន់ម៉ា កាត់ទោស ដាក់ ពន្ធនាគារ ៧ឆ្នាំ បន្ថែម ក្នុង សំណុំរឿង ចុងក្រោយ បង្អស់
៥៖ អ៉ីរ៉ង់ ធ្វើ សមយុទ្ធ យោធា ជើង គោក ជើង អាកាស និង ជើងទឹក ចម្រុះ គ្នា
ខេត្ត បាត់ដំបង រៀបចំ ព្រឹត្តការណ៍ ពិព័រណ ម្ហូប ខ្មែរ អបអរសាទរ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ២០២៣
ឆ្លៀត នៅក្នុង ឱកាស នោះ លោក សុខ លូ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ នាំគ្នា ទៅ ចាក់ វ៉ាក់សាំង ដោយ ស្ម័គ្រចិត្ត ជា ដូស ជំរុញ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី ការពារ ឆ្លង រោគ កូវីដ១៩ ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ក្នុង ព្រឹត្តការណ៍ ពិព័រណ ម្ហូប ខ្មែរ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ២០២២ - ២០២៣ នៅ ខេត្ត បាត់ដំបង មាន ជាង ៩០ ស្តង់ រយ : ពេល ពីរ ថ្ងៃទី ៣០ - ៣១ ខែធ្នូ ឆ្នាំ ២០២២ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ២០២២ - ២០២៣ នៅ ខេត្ត បាត់ដំបង នា ពេលនេះ ។
លោក អភិបាល ខេត្ត បន្ត ថា « ព្រឹត្តិការណ៍ នេះ គឺជា ការជួបជុំ ប្រចាំ ឆ្នាំ ក្នុង ន័យ សាមគ្គីភាព មិត្តភាព ប្រកបដោយ ស្មារតី កិច្ចសហប្រតិបត្តិការ និង ការទទួលខុសត្រូវ រួមគ្នា ក្នុង ការជំរុញ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ និង ព្រឹត្តិការណ៍ នានា ក្នុង ភាព ជា ម្ចាស់ ជា ខ្មែរ ជា អ្នក បាត់ដំបង ប្រកបដោយ និរន្តរភាព ពិសេស ជំរុញ សកម្មភាព រួមគ្នា អនុវត្ត ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការស្ដារ សេដ្ឋកិច្ច ជាតិ ឡើងវិញ បន្ទាប់ពី វិបត្តិ ជម្ងឺ ឆ្គង សកល បណ្តាល មកពី កូវីដ១៩ កន្លងមក នេះ » ។
លោក បាន បន្ត ទៀត ថា ដោយ មើលឃើញ ពី លក្ខណៈ ពិសេស និង ល្អ ឯក នេះ រដ្ឋបាល ខេត្ត បាត់ដំបង សម្រាប់ ឆ្នាំ ២០២៣ ស្នើ ឱ្យ ភាគី ពាក់ព័ន្ធ ពិសេស មន្ទីរ ទេសចរណ៍ ត្រូវ ផ្តោត ទៅ លើ៖
* ទី១៖ ការអភិវឌ្ឍ ផលិតផល ទេសចរណ៍ ការវិនិយោគ និង ការពង្រឹង ការឃោសនា ផ្សព្វផ្សាយ ទេសចរណ៍ ពិសេស ការផ្សព្វផ្សាយ ពី ម្ហូប អ្នក បាត់ដំបង ( ធូរ ថ្លៃ អនាម័យ ឆ្ងាញ់ និង សេវា ល្អ )* ទី ២៖ ការគ្រប់គ្រង និង ពង្រឹង គុណភាព ឧស្សាហកម្ម ទេសចរណ៍ ក្នុង ខេត្ត បាត់ដំបង ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ *ទី ៣៖ រៀបចំ នូវ យន្តការទ្រទ្រង់ វិស័យ ទេសចរណ៍ និង ការសម្រួល ការធ្វើដំណើរ និង ដឹកជញ្ជូន ទេសចរណ៍ ក្នុង ខេត្ត បាត់ដំបង ឈរ លើ គោលការណ៍ ធូរ ថ្លៃ សុវត្ថិភាព ផ្តល់ ភាពកក់ក្ដៅ និង ស្នាមញញឹម ។
លោក សូម ថ្លែងអំណរគុណ កោតសរសើរ និង វាយតំលៃ ខ្ពស់ ចំពោះ ក្រុមការងារ គ្រប់ ផ្នែក ទាំងអស់ ដែល បាន រួមគ្នា រៀបចំ នូវ ព្រឹត្តិការណ៍ នេះ ឡើង បាន ទាន់ ពេលវេលា មាន សោភ័ណភាព ការគិត គួរ គ្រប់ ជ្រុងជ្រោយ និង មាន ការទទួលខុសត្រូវ ខ្ពស់ ចំពោះ តួនាទី ភារៈកិច្ច ដែល រដ្ឋបាល ខេត្ត បាត់ដំបង បាន ប្រគល់ជូន ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក បាន លើកឡើង អំពី គំនិត ផ្តួចផ្តើម ដែល ជា ធាតុ ចូល សំខាន់ ៗ ចំនួន ១២ ចំណុច សម្រាប់ វិស័យ ទេសចរណ៍ ពិសេស គឺ ផ្នែក ម្ហូប អាហារ នៅ ខេត្ត បាត់ដំបង ដូច ខាងក្រោម៖
លោក ក៏ បាន ក្រើន រំលឹក អស់ លោក លោកស្រី ភ្ញៀវ ទេសចរ ជាតិ អន្តរជាតិ អាជីវករ និង ប្រជាពលរដ្ឋ ដែល មក កំសាន្ត ក្នុង ព្រឹត្តិការណ៍ សូម ជួយ ថែរក្សា អនាម័យ បរិស្ថាន កុំ បោះចោល សំរាម ក្រៅ ធុង និង សូម ចូលរួម អនុវត្តន៍ នូវ វិធានការណ៍ សុខាភិបាល ដើម្បី ជៀស ឆ្ងាយ ពី ជំងឺ កូវីដ១៩ ទាំងអស់ គ្នា ។ លោក សង្ឃឹម ថា ព្រឹត្តិការណ៍ ម្ហូប អាហារ ខ្មែរ ខេត្ត បាត់ដំបង នឹង បន្ត មាន ការចូលរួម ជារៀងរាល់ ឆ្នាំ ផងដែរ ៕
ចំណេះដឹង ទូទៅ៖ ក្រៅពី សមុទ្រ ទឹក ពណ៌ ខៀវ និង ពណ៌ ល្អៀង បៃតង ក៏ សមុទ្រ ខ្មៅ ក្រហម លឿង និង សដែរ ?
ឈ្មោះ សមុទ្រ ទាំងអស់ នេះ មិន ត្រូវបាន គេ ដឹង ច្បាស់ ថា មាន ដើមហេតុ ពិតប្រាកដ យ៉ាងណា ឡើយ ប៉ុន្តែ មាន ទ្រឹស្តី ល្បី ៗ មួយចំនួន ក្នុង នោះ រួម មាន៖១. សមុទ្រ ខ្មៅ
សមុទ្រ លឿង គឺជា សមុទ្រ ដែល ស្ថិត នៅ ចន្លោះប្រទេស ចិន និង ឧបទ្វីប កូរ៉េ ។ មូលហេតុ ដែល នាំឱ្យ វា មាន ឈ្មោះ បែប នេះ គឺ ទំនង ដោយសារ ទឹក ពណ៌ លឿង ត្នោត ដែល ហូរ ចូលមកពី ទន្លេ លឿង ខណៈ ទឹក របស់ ទន្លេ នោះ គឺ ផ្ទុក ទៅ ដោយ ដី និង ខ្សាច់ មកពី តំបន់ ទំនាប ។
សមុទ្រ ស ស្ថិត នៅ ភាគ ពាយព្យ នៃ ប្រទេស រុស្ស៉ី និង ស្ថិត ក្រោម ដែន សមត្ថកិច្ច របស់ រុស្ស៉ី ទាំងស្រុង ។ ដោយសារតែ វា ស្ថិត នៅក្បែរ តំបន់ អាក់ទិច នៃ ប៉ូល ខាងជើង ដូច្នេះហើយ សមុទ្រ នេះ ក៏ គ្របដណ្តប់ ដោយ ផ្ទាំង ទឹកកក ចន្លោះ ចាប់ពី ៦ - ៧ខែ ជារៀងរាល់ ឆ្នាំ ។ ទ្រឹស្តី មួយ បាន លើកឡើង ថា វា ជាប់ ឈ្មោះ ជា សមុទ្រ ស ដោយសារតែ មូលហេតុ នេះ ឯង ៕ លោក ថោង ខុន៖ អាណត្តិ ទី៨ NOCC រឹតតែ សំខាន់ ដើម្បី ធានា ជោគជ័យ នៅ ស៊ីហ្គេម - ស៊ាន ប៉ារ៉ាហ្គេម ឆ្នាំ ២០២៣
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ថោង ខុន រដ្ឋមន្ដ្រី ក្រសួង ទេសចរណ៍ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា (NOCC) បាន បញ្ជាក់ ថា អាណត្តិ ទី៧ របស់ NOCC ពិតជា មាន សារៈសំខាន់ ក្នុង ការត្រៀម រៀបចំ ធ្វើ ម្ចាស់ ផ្ទះ កីឡា ស៊ីហ្គេម - អាស៊ាន ប៉ារ៉ាហ្គេម ឆ្នាំ ២០២៣ ប៉ុន្ដែ អាណត្តិ ទី៨ រឹតតែ មាន សារៈសំខាន់ ថែម ទៀត ក្នុង ដំណាក់ការរៀបចំ ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្ដ្រ លើក ដំបូង នៅ កម្ពុជា នេះ ឲ្យ ទទួលបាន ជោគជ័យ ត្រចះត្រចង់ តាម ការគ្រោងទុក ។
១៖ គណៈកម្មាធិការ ជាតិ អូឡាំពិក អាច បន្ត អាណត្តិ ជា ស្វ័យប្រវត្តិ ក្នុង ពេល ប្រទេសជាតិ មាន សង្គ្រាម ( ឧទាហរណ៍៖ គណៈកម្មាធិការ ជាតិ អូឡាំពិក អ៊ុយក្រែន ត្រូវ បញ្ចប់ អាណត្តិ ឆ្នាំ ២០២១ ត្រូវ បន្ត ជា ស្វ័យប្រវត្តិ រហូតដល់ បញ្ចប់ សង្រ្គាម ឬ មាន គ្រោះ ធម្មជាតិ ធ្ងន់ធ្ងរ មាន ចលនា សង្គម ជាដើម ) ។
២៖ គណៈកម្មាធិការ ជាតិ អូឡាំពិក អាច ផ្ដល់ សេចក្តីទុកចិត្ត ពី សមាជិក ក្នុង ករណី ដែល គណៈកម្មាធិការ ជាតិ អូឡាំពិក នោះ កំពុង ធ្វើ ម្ចាស់ ផ្ទះ ការប្រកួត ពហុកីឡា ជា ហ្គេម ។ ករណី នេះ គឺ អាច បន្ដ អាណត្តិ ដោយ ផ្ដល់ តែ សេចក្ដីទុកចិត្ត តែ ប៉ុណ្ណោះ ។
លោក រដ្ឋមន្ដ្រី បន្ដ ថា « បញ្ហា ទាំងអស់ នេះ គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា ក៏ បាន ទទួល ការគាំទ្រ និង យល់ព្រម ដ៏ ខ្ពង់ខ្ពស់ បំផុត ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា លើ សមាសភាព ថ្នាក់ដឹកនាំ និង អនុញ្ញាតឲ្យ រៀបចំ បោះឆ្នោត បន្ត អាណត្តិ ជា កញ្ចប់ ដោយ រក្សា គណៈកម្មាធិការ ប្រតិបត្តិ ចាស់ និង បញ្ចូល គណៈកម្មាធិការ ប្រតិបត្តិ ថ្មី ២រូប យ៉ាង កក់ក្តៅ ជា ទីបំផុត ផងដែរ ។
