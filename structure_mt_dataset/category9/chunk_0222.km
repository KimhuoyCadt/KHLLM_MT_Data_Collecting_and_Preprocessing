ខាងក្រោម នេះ ជា លិខិត របស់ រដ្ឋមន្ដ្រី ក្រសួង មុខងារ សាធារណៈ ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖
លោក បណ្ឌិត កៅ គឹម ហួន ត្រូវបាន កិច្ចប្រជុំ កំពូល អាស៊ាន ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ប្រកាស តែងតាំង ជា អគ្គ លេខាធិការ អាស៊ាន ចាប់ពី ឆ្នាំ ២០២៣ ត ទៅ ដែល អាណត្តិ នៃ អគ្គ លេខាធិការ អាស៊ាន នេះ មាន រយៈពេល ៥ឆ្នាំ ។
លោក បណ្ឌិត កៅ គឹម ហួន ជា មនុស្ស ម្នាក់ ក្នុង ចំណោម មនុស្ស ៣នាក់ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា ស្នើ ធ្វើជា អគ្គ លេខាធិការ អាស៊ាន ឆ្នាំ ២០២៣ នៅ ពេល ដែល ដល់ វេន ប្រទេស កម្ពុជា ។ នេះ ជា លើក ទី១ ហើយ ដែល កម្ពុជា មាន ឱកាស ធ្វើជា អគ្គ លេខាធិការ អាស៊ាន បន្ទាប់ពី កម្ពុជា បាន ចូល ជា សមាជិក អាស៊ាន កាលពី ឆ្នាំ ១៩៩៩ ។
ប្រសិនបើ វា ពិតជា ទាក់ទង នឹង យុទ្ធនាការ បោសសំអាត អំពើពុករលួយ មែន នោះ លោក មិញ និង លោក ដាំ គឺជា មន្រ្តី ជាន់ ខ្ពស់ ជាង គេ បង្អស់ ដែល ត្រូវបាន ដកហូត តំណែង គិត មកទល់ ពេល បច្ចុប្បន្ន ដ្បិត កន្លងមក គឺ មាន ការចាប់ខ្លួន រដ្ឋមន្រ្តី សុខាភិបាល ក៏ដូចជា មន្រ្តី ជាន់ ខ្ពស់ និង អ្នកការទូត ដទៃ ទៀត រួច ជាស្រេច ទៅ ហើយ ។
លោក ផាំ បិញ មិញ អាយុ ៦៣ ឆ្នាំ បាន កាន់ តួនាទី ជា រដ្ឋមន្រ្តី ការបរទេស វៀតណាម កាលពី ចន្លោះ ឆ្នាំ ២០១១ - ២០២១ ហើយ ជា ឧប នាយក រដ្ឋមន្រ្តី ចាប់ពី ឆ្នាំ ២០១៣ ។ ចំណែក លោក វូ ឌុក ដាំ អាយុ ៥៩ ឆ្នាំ ដែល ត្រូវបាន តែងតាំង ជា ឧប នាយក រដ្ឋមន្រ្តី កាលពី ឆ្នាំ ២០១៣ ដូចគ្នា គឺ ត្រូវ គេ ស្គាល់ យ៉ាង ទូលំទូលាយ សម្រាប់ កិច្ចប្រឹងប្រែង របស់ លោក ក្នុង ការដឹកនាំ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង វិបត្តិ កូវីដ - ១៩ របស់ ប្រទេស វៀតណាម ។
រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ ស្នើ អគ្គ ស្នងការ នគរបាល ជាតិ ទប់ស្កាត់ ការផ្សព្វផ្សាយ ចម្រៀង « ឈាម បាតុករ » មាន ចេតនា ញុះញង់ បង្ក អសន្តិសុខ ក្នុង សង្គម
( ភ្នំពេញ ) ៖ លោកស្រី ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ស្នើ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ចាត់ វិធានការ ទប់ស្កាត់ ការផ្សព្វផ្សាយ បទចម្រៀង ដែល មាន ចំណងជើង ថា « ឈាម បាតុករ » ។
បទចម្រៀង បែប រ៉េប មាន ចំណងជើង ថា « ឈាម បាតុករ » កំពុង នឹង ត្រូវបាន ផ្សព្វផ្សាយ យ៉ាង ផុល ផុស ពីសំណាក់ អង្គការ និង ក្រុម មនុស្ស មាន និន្នាការ ប្រឆាំង រាជ រដ្ឋាភិបាល ។
បើ តាម លោកស្រី ភឿង ស កុណា បទចម្រៀង នេះ និពន្ធ ទំនុក ច្រៀង និង ច្រៀង ដោយ ឈ្មោះ គា សុគន្ធ ។ បទចម្រៀង នេះ ត្រូវបាន ក្រសួង មហាផ្ទៃ ចាត់ វិធានការបិទ និង ផ្តន្ទាទោស អ្នកនិពន្ធ និង អ្នក ច្រៀង ម្តង រួចហើយ មក ហើយ ។ តែ នៅ ពេល ថ្មី ៗ នេះ បទចម្រៀង នេះ ត្រូវបាន ផ្សព្វផ្សាយ ឡើងវិញ ។
ជា ការកត់សម្គាល់ ការផ្សព្វផ្សាយ ឡើងវិញ នូវ បទចម្រៀង « ឈាម បាតុករ » ត្រូវបាន ធ្វើឡើង ក្រោម សេនារី យោមួយ ច្បាស់លាស់ ។ ក្រុម អង្គការ មាន និន្នាការ ប្រឆាំង រាជ រដ្ឋាភិបាល មាន ដូចជា អង្គការ លីកាដូ និង សង់ត្រាល់ ជាដើម បូករួម ជាមួយ ក្រុម អ្នកនយោបាយ ប្រឆាំង បាន នាំគ្នា គាស់ រំលើង និង ផ្សព្វផ្សាយ ព្រម ៗ គ្នា លើ បណ្តាញ សង្គម ។
តាមរយៈ ការផ្សព្វផ្សាយ ដោយ មាន ផែនការ ច្បាស់លាស់ នេះ បាន បង្ហាញ ឱ្យ ឃើញ ច្បាស់ នូវ ចេតនា ទុច្ចរិត របស់ អង្គការ ប្រឆាំង រាជ រដ្ឋាភិបាល ដូចជា លីកាដូ និង សង់ត្រាល់ ក៏ ដូចជា អ្នកនយោបាយ ប្រឆាំង ក្នុង បំណង ដុង កំហឹង វណ្ណៈ បង្កើត ចលាច ល និង អសន្តិសុខ នានា ក្នុង សង្គម នៅ មុនពេល ការបោះឆ្នោត ឈាន មកដល់ ៕
( ភ្នំពេញ ) ៖ ក្នុង រយៈពេល ៤៤ ឆ្នាំ ចាប់តាំងពី ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ក្រោយពេល ដែល របប ខ្មែរ ក្រហម ដួលរលំ ប្រទេស កម្ពុជា បាន ដើរ លើ ផ្លូវ ដ៏ សែន លំបាក និង គ្រោះថ្នាក់ បំផុត ប៉ុន្តែ វា ជា ផ្លូវ ដ៏ ត្រឹមត្រូវ ដើម្បី ធានា បាន នូវ ភាពរីកចម្រើន យូរអង្វែង និង ប្រកបដោយ វិបុលភាព សម្រាប់ មាតុភូមិ កម្ពុជា ។
ក្រោម រជ្ជកាល របស់ ព្រះមហាក្សត្រ កម្ពុជា និង ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី បាន ដឹកនាំ នាវា កម្ពុជា ឱ្យ សម្រេចបាន សមិទ្ធផល សំខាន់ ៗ ជាច្រើន ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ជាពិសេស ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ប្រកបដោយ ជោគជ័យ ការបើក ដំណើរការ ប្រទេស ឡើងវិញ និង ការស្តារ សេដ្ឋកិច្ច យ៉ាង ឆាប់រហ័ស ។
ទំនាក់ទំនង រវាង កម្ពុជា - វៀតណាម មាន ការរីកចម្រើន លើ វិស័យ ជាច្រើន ដោយ នាំមក នូវ ផលប្រយោជន៍ ជាក់ស្តែង ជូន ប្រជាជន នៃ ប្រទេស នីមួយ ៗ ហើយ ជា ទំនាក់ទំនង ដែល មិន មែន គ្រាន់តែ ជា ទំនាក់ទំនង តាម បែប ប្រពៃណី នោះ ទេ ប៉ុន្តែ ក៏ ជា ទំនាក់ទំនង ក្នុង ភាព បងប្អូន និង ជា សម មិត្ត រួម សមរភូមិ ដែល បាន រួម សុខ រួម ទុក្ខ ជាមួយគ្នា ក្នុង បុព្វហេតុ រំដោះ ជាតិ និង ការបង្រួបបង្រួម ជាតិ ក៏ ដូចជា ក្នុង ការកសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ រៀង ៗ ខ្លួន ។
កាលពី ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ សាលា ក្តី ខ្មែរ ក្រហម ដែល គាំទ្រ ដោយ អង្គការ សហ ប្រជាជាតិ បាន បើក សម័យ ប្រជុំ ចុងក្រោយ របស់ ខ្លួន ដោយ បដិសេធ ការប្តឹង ឧទ្ធរណ៍ របស់ មេដឹកនាំ របប ខ្មែរ ក្រហម ដែល នៅ មាន ជីវិត ចុងក្រោយ គេ បង្អស់ ( លោក ខៀវ សំផន ) នៃ របប ឃោរឃៅ ដែល បាន គ្រប់គ្រង ប្រទេស កម្ពុជា ពី ឆ្នាំ ១៩៧៥ - ១៩៧៩ និង ជា បុរស តែ ម្នាក់ គត់ ក្នុង ចំណោម បី នាក់ ដែល ត្រូវបាន កាត់ទោស ពី បទ ប្រល័យ ពូជសាសន៍ នៅក្នុង របប ខ្មែរ ក្រហម ដែល បាន ដំណើរ អស់ រយៈពេល ១៦ ឆ្នាំ កន្លងទៅ ។
អង្គ ជំនុំជម្រះ វិសាមញ្ញ ក្នុង តុលាការ កម្ពុជា ( អ. វ.ត .ក ) បាន សម្រេច ឱ្យ លោក ខៀវ សំផន ជាប់ ពន្ធនាគារ អស់ មួយ ជីវិត គឺ ដោយ ផ្អែក លើ អំពើ ឃោរឃៅ ដែល បាន ប្រព្រឹត្ត មក លើ មនុស្សជាតិ ក្នុង រជ្ជកាល នៃ អំពើ ប្រល័យ ពូជសាសន៍ របស់ របប ខ្មែរ ក្រហម ហើយ ជា ការសម្រេច ជា ស្ថាពរ និង បិទ ផ្លូវ តវ៉ា ។ មាន ន័យ ថា របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ត្រូវបាន បិទ បញ្ចប់ ជាស្តាពរ ។
ដូច្នេះ ៤៤ ឆ្នាំ បន្ទាប់ពី បើក ទំព័រ នៃ សករាជ ថ្មី ក្រោយ ការផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ព្រះរាជាណាចក្រ កម្ពុជា បាន ក្លាយជា ប្រទេស មួយ ដែល ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ លទ្ធិ ប្រជាធិបតេយ្យ នីតិរដ្ឋ រក្សា បាន នូវ សន្តិភាព ស្ថិរភាព នយោបាយ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម និង មាន ភាពឯកភាព ជាតិ ។
ប្រទេស កម្ពុជា សម្រេចបាន នូវ កំណើន សេដ្ឋកិច្ច ខ្ពស់ និង មាន និរន្តរភាព ក្នុង រយៈពេល ពីរ ទស្សវត្សរ៍ កន្លងមក ហើយ បាន ផ្លាស់ប្តូរ ពី ប្រទេស ដែល មាន ចំណូល ទាប ទៅជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ទាប ហើយ កំពុង ខិតខំ សម្រេច ឱ្យ បាន នូវ ចក្ខុវិស័យ នៃ ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ ខាងមុខ ដោយ ផ្អែក លើ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ បន្ត រីកចម្រើន ជាលំដាប់ និង មាន ភាពស្មើ មុខ ស្មើ សិទ្ធិ គ្នា ជាមួយ ប្រទេស នានា នៅ ជុំវិញ ពិភពលោក ៕
ដោយ៖ លោក អ៊ុច លាង អ្នកសិក្សា ស្រាវជ្រាវ នៃ នាយកដ្ឋាន សិក្សា អាស៊ី អាហ្វ្រិក និង មជ្ឈិមបូព៌ា នៃ វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ព្រះមហាក្សត្រ ផ្តល់ គោរមងារ ជា « អ្នក ឧកញ៉ា » ជូន ឧកញ៉ា ចាប ហុង លី
ព្រះរាជ ក្រឹត្យ ផ្តល់ គោរមងារ នេះ ត្រូវបាន ធ្វើឡើង ដោយ យោង តាម ការក្រាបបង្គំទូល ថ្វាយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
ការត្រាស់បង្គាប់ ផ្តល់ គោរព ងារ ជា « អ្នក ឧកញ៉ា » នេះ ដោយ ព្រះករុណា ជា អម្ចាស់ តម្កល់ លើ ត្បូង យាង ទត ឃើញ ថា ឧកញ៉ា ចាប ហុង លី បាន ចូលរួម ធ្វើ សកម្មភាព ជាច្រើន ដើម្បី រួមចំណែក អភិវឌ្ឍន៍ សង្គមជាតិ បម្រើ នូវ ឧត្តម ប្រយោជន៍ សម្រាប់ ជាតិ និង ប្រជាជន ពិសេស ការងារ មនុស្សធម៌ ៕
ផ្ទះ ១ខ្នង ជា អំណោយ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវ បន្ត ប្រគល់ ជូន គ្រួសារ អតីត យុទ្ធជន ពលី នៅ ឃុំ ព្រៃ គុយ ស្រុក កំពង់ស្វាយ
ក្នុង ពិធី ប្រគល់ ផ្ទះ ថ្មី នៅ ពេល នេះ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន អំពាវនាវ ដល់ ក្រុមគ្រួសារ អតីត យុទ្ធជន និង ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ខិតខំ ថែរក្សា សុខភាព និង សូមអញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង ដូស ទី៤ និង ដូស ទី៥ ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ តាម មណ្ឌល សុខភាព តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
ក្នុង ពិធី ប្រគល់ ផ្ទះ ថ្មី នេះ ក្រុមការងារ អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ បាន នាំយក អំណោយ របស់ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ផ្ដល់ជូន គាត់ បន្ថែម ទៀត មាន៖ អង្ករ ចំនួន ៧៥ គីឡូក្រាម មី ចំនួន ២កេស ទឹកត្រី ទឹកស៊ី អ៉ីវ ចំនួន ២យួរ និង សម្ភារៈ សម្រាប់ ប្រើប្រាស់ ក្នុង ផ្ទះ បាយ មួយចំនួន ព្រមទាំង ថវិកា មួយ ចំនួន ផងដែរ ។
ពិធី នេះ មាន ការចូលរួម ពី លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង ព្រមទាំង លោក លោកស្រី មន្ទីរ ជុំវិញ ខេត្ត ក្រុមការងារ និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ផងដែរ ។
សូម បញ្ជាក់ ថា អាស្រម ថ្មី បារមី « លោក តា លោកយាយ ព្រះពោធិ៍ ព្រឹក » ដែល បាន រៀបចំ ពិធី សែន ក្រុង ពាលី នា ព្រឹក នេះ គឺជា ទីគោរព សក្ការៈបូជា សម្រាប់ ថ្នាក់ដឹកនាំ ខេត្ត និង ប្រជាពលរដ្ឋ មក បន់ស្រន់ សុំ សេចក្តីសុខ ច ម្រេីន ហើយ សួនច្បារ លោក ហុក ឡង ឌី ( សួន ពោធិ៍ ព្រឹក្សា ) ក៏ ជា ទីកន្លែង សម្រាប់ ប្រជាពលរដ្ឋ ខេត្ត ស្វាយរៀង ហាត់ប្រាណ និង ដើរលេង កម្សាន្ត ផងដែរ ។
ដំបូង ឡើយ ព្រះអង្គម្ចាស់ ហារី បម្រើការ ជា អ្នកតាមដាន ផ្លូវ អាកាស សម្រាប់ ការវាយឆ្មក់ តាម អាកាស ពី ឆ្នាំ ២០០៧ ដល់ ឆ្នាំ ២០០៨ នៅ ប្រទេស អាហ្វហ្គានីស្ថាន ។ បន្ទាប់មក ធ្វើជា ពី ឡុត បើក ឧទ្ធម្ភាគចក្រវាយប្រហារ នៅ ចម្លោះ ឆ្នាំ ២០១២ ដល់ ឆ្នាំ ២០១៣ ។
គួរ បញ្ជាក់ ថា ខ្លឹមសារ ដ៏ រសើប នៃ សៀវភៅ ស្តីពី ជីវប្រត្តិ របស់ ព្រះអង្គម្ចាស់ ហារី ដែល នឹង ត្រូវ បោះពុម្ព នៅ ថ្ងៃទី ១០ ខែមករា បាន បង្ហាញ អំពី ចំនួន ក្រុម អ្នក ប្រយុទ្ធ តាលី បង់ ដែល ទ្រង់ បាន សម្លាប់ ក្នុង អំឡុង ពេល បម្រើ ការងារ របស់ ទ្រង់ និង រឿងរ៉ាវ ផ្ទាល់ខ្លួន ផ្សេង ទៀត ដែល បាន កើតឡើង ក្នុង ត្រកូល រាជ វង្ស ជាដើម ៕
សេតវិមាន កាលពី ចុង ខែធ្នូ ឆ្នាំ ២០២២ បាន ឲ្យដឹង ថា ក្រុម Wagner Group បាន ទទួលយក ការដឹកជញ្ជូន អាវុធ ពី កូរ៉េ ខាងជើង ដើម្បី ជួយ ពង្រឹង កងកម្លាំង រុស្ស៊ី នៅ អ៊ុយក្រែន ។ កន្លងមក សហរដ្ឋ អាមេរិក បាន ចោទប្រកាន់ ទាហាន ស៊ីឈ្នួល រុស្ស៊ី ថា បាន កេងប្រវ័ញ្ច ធនធាន ធម្មជាតិ នៅ សាធារណរដ្ឋ អាហ្រ្វិក កណ្តាល ម៉ាលី ស៊ូ ដង់ និង កន្លែង ផ្សេង ទៀត ដើម្បី ជួយ ផ្តល់ មូលនិធិ ដល់ សង្គ្រាម រុស្ស៉ី អ៊ុយក្រែន ជា ការចោទប្រកាន់ ដែល រុស្ស៊ី បាន ច្រានចោល ។
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ត្រាស់បង្គាប់ ផ្តល់ គោរមងារ « ឧកញ៉ា » ជូន លោក រ៉ាត់ ដារ៉ារ័ត្ន និង លោកស្រី ជា ឡាក់ គី ។
ការត្រាស់បង្គាប់ ផ្តល់ គោរព ងារ ជា « ឧកញ៉ា » នេះ ដោយ ព្រះករុណា ជា អម្ចាស់ តម្កល់ លើ ត្បូង យាង ទត ឃើញ ថា លោក រ៉ាត់ ដារ៉ារ័ត្ន និង លោកស្រី ជា ឡាក់ គី បាន ចូលរួម ធ្វើ សកម្មភាព ជាច្រើន ដើម្បី រួមចំណែក អភិវឌ្ឍន៍ សង្គមជាតិ បម្រើ នូវ ឧត្តម ប្រយោជន៍ សម្រាប់ ជាតិ និង ប្រជាជន ពិសេស ការងារ មនុស្សធម៌ ៕
សូម បញ្ជាក់ ផងដែរ ថា កិច្ចពិភាក្សា សំណួរ - ចម្លើយ ប្រធាន សាលាដំបូង ខេត្ត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត បាន លើកឡើង អំពី បញ្ហា ប្រឈម មួយ ចំនួន បញ្ហា ការបញ្ជូន សំណុំរឿង ដីកា សម្រេច សាលក្រម ផ្សេង ៗ ដោយ ទទួលបាន ការបកស្រាយ រក ដំណោះស្រាយ ពី ឯកឧត្តម ប្រធាន សាលាឧទ្ធរណ៍ ។
ថ្លែង បិទ អង្គ សន្និបាត លោក ម៉ុង មុនី ចរិយា ប្រធាន សាលាឧទ្ធរណ៍ ត្បូងឃ្មុំ បាន មានប្រសាស ន៏ លើកឡើង អំពី លទ្ធផល ដែល សាលាឧទ្ធរណ៍ និង មហា អយ្យការ អម សាលាឧទ្ធរណ៍ ត្បូងឃ្មុំ សម្រេចបាន នា ពេល កន្លងមក ពិតជា មាន ការរីកចម្រើន គួរឱ្យ កត់សម្គាល់ ព្រម ជាមួយនឹង កិច្ចពិភាក្សា ផ្លាស់ប្តូរ មតិ យោបល់ គ្នា ទៅ វិញ ទៅ មក ដើម្បី រក ធាតុ ចូល នូវ ចំណុច ថ្មី ៗ បន្ថែម ទៀត នូវ ចំណុច ខ្លាំង និង ចំណុច ខ្សោយ របស់ ស្ថាប័ន ។
លោក ប្រធាន សាលាឧទ្ធរណ៍ បាន ណែនាំ បន្ថែម ទៅដល់ ក្រឡាបញ្ជី គ្រប់ រូប ក្នុង ស្ថាប័ន សាលាឧទ្ធរណ៍ និង មហា អយ្យការ សូម បន្ត ខិតខំ ប្រឹងប្រែង ដោយ ប្តេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការចូលរួម ការអនុវត្ត នូវ តួនាទី ភារកិច្ច របស់ ខ្លួន ឱ្យ បាន សកម្ម ។
នាយ ឧត្តមសេនីយ៍ បញ្ជាក់ ថា « នៅ ឆ្នាំ ២០២២ កន្លងទៅ នេះ ការចាប់ យក បាន នូវ សារធាតុ ញៀន ក្នុង ករណី ខ្លះ គឺ មួយ ករណី មាន បរិមាណ ច្រើន តោន ដោយសារតែ ក្រុម ឧក្រិដ្ឋ ជន គ្រឿងញៀន អន្តរជាតិ ប៉ុនប៉ង ធ្វើ ការដឹកជញ្ជូន គ្រឿងញៀន ក្នុង បរិមាណ ច្រើន ទៅ ប្រទេស ទី បី ដោយ យក កម្ពុជា ជា កន្លែង ឆ្លងកាត់ » ។
ក៏ប៉ុន្តែ នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ អ្នកនាំពាក យស្ថានទូត ចិន ប្រចាំ ទីក្រុង វ៉ាស៊ីនតោន បាន និយាយ ថា ទីក្រុង ប៉េកាំង ជំទាស់ ជាដាច់ខាត ទៅនឹង សកម្មភាព បែប នេះ និង ជំរុញ ឱ្យ សហរដ្ឋ អាមេរិក បញ្ឈប់ ជាបន្ទាន់ នូវ ទង្វើ ចលាចល បង្កើន ភាពតានតឹង និង បំផ្លាញ សន្តិភាព ក៏ ដូចជា ស្ថិរភាព នៅ ទូទាំង តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ ។
គួរ បញ្ជាក់ ថា ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ នាវា ចម្បាំង អាមេរិក ក្នុង នោះ ម្ដង ម្កាល នាវា ចម្បាំង នៃ បណ្ដា ប្រទេស ជា សម្ព័ន្ធមិត្ត ដូចជា អង់គ្លេស និង កាណាដា ជាដើម បាន ធ្វើដំណើរ ឆ្លងកាត់ តាម ច្រក សមុទ្រ តៃវ៉ាន់ ដែល តែងតែ បង្ក ការខឹងសម្បារ ដល់ ចិន ដែល ចាត់ទុក តៃវ៉ាន់ ត្រឹមតែ ជា ខេត្ត មួយ របស់ ខ្លួន ៕
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្រ្តី វ៉ា គឹម ហុង ប្រធាន អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន បាន ផ្ញើ សារលិខិត ថ្លែងអំណរគុណ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព សព ញាណ ធាន ណារី ដែល ត្រូវ ជា ភរិយា ។
ខ្ញុំបាទ សូម គោរព និង សូម សម្តែង នូវ កតញ្ញុតាធម៌ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ជូន ចំពោះ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល បាន ចូលរួម រំលែក ទុក្ខ ដ៏ សែន ក្រៀមក្រំ ជាមួយ ខ្ញុំបាទ នេះ ជា សក្ខីភាព បញ្ជាក់ នូវ ទឹកចិត្ត ស្រឡាញ់ រាប់អាន ដ៏ ជ្រាលជ្រៅ របស់ សម្ដេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ ខ្ញុំបាទ និង ក្រុមគ្រួសារ ដែល ធ្វើឱ្យ យើងខ្ញុំ ទាំងអស់ គ្នា មិន អាច បំភ្លេច បាន ឡើយ » ។
លោក ទេសរដ្ឋមន្ត្រី សូម គោពរ ជូនពរ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង ក្រុមគ្រួសារ សូម ទទួលបាន នូវ ពុទ្ធ ពរ ទាំង ប្រាំ ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ និង បដិភាណៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៥៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៥ ខែមករា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៥៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០៦ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង៥៩ នាក់ នោះ មាន ២២ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្ន បទល្មើស ព្រហ្មទណ្ឌ ១៣ករណី និង ជនសង្ស័យ ៣៧នាក ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ១៤ករណី ។
( ភ្នំពេញ ) ៖ ថ្ងៃ៧ ខែមករា ឆ្នាំ ២០២៣ ឆ្នាំ នេះ គឺជា ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ ឆ្នាំ នៃ ទិវា ជ័យជម្នះ លើ របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ។ ក្នុង បរិបទ ដែល កម្ពុជា កំពុង ធ្វើដំណើរ លើ គន្លង វិថី ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ពហុ មតិ ទៅ លើ បញ្ហា នានា ក៏ មាន ទៅ តាម នោះ ដែរ ។ អត្ថន័យ នៃ ថ្ងៃ៧ មករា ហាក់ ត្រូវបាន កំណត់ ដោយ ផ្អែលើ ទស្សនៈ និង គោលជំហរ នយោបាយ ជាជាង តម្លៃ នៃ សច្ច ភាព ប្រវត្តិសាស្ត្រ ។
បើ យើង ពិបាក ក្នុង ការប្រៀបធៀប អំពី ការរីកចម្រើន របស់ ប្រទេសជាតិ ទាំងមូល សូម ប្រៀបធៀប តែ នៅក្នុង រង្វង់ គ្រួសារ យើង នីមួយ ៗ ទៅ ក៏ យើង អាច ដឹង បាន ដែរ ថា តើ ពី ឆ្នាំ ១៩៧៩ មកដល់ ឥឡូវ មាន ការប្រែប្រួល ផ្លាស់ប្តូរ អ្វី ខ្លះ នៅក្នុង សង្គម គ្រួសា របស់ ខ្លួន ?
សព្វ ថ្ងៃ នេះ យើង មាន សិទ្ធិ សេរីភាព សព្វ បែប យ៉ាង រាប់ តាំងពី សិទ្ធ គោរព ប្រតិបត្តិ តាម ប្រពៃណី ទំនៀមទម្លាប់ សាសនា សព្វ បែប យ៉ាង ដែល នៅក្នុង សម័យ ខ្មែរ ក្រហម មិន មាន ឡើយ សូម្បី ការអប់រំ ។ ការអប់រំ យើង មាន តាំងពី កម្រិត កុមារ តូច ថ្នាក់ បឋម រហូតដល់ ឧត្តម សិក្សា និង ក្រោយ ឧត្តម សិក្សា ។ ទាំងអស់ នេះ គឺជា អ្វី ដែល យើង បាន ឃើញ អំពី ការប្រែប្រួល នៃ សិទ្ធិ ផ្នែក ស្មារតី ។
រីឯ ផ្នែក រូបវ័ន្ត វិញ អ្វី ៗ ដែល យើង បាន ឃើញ នៅ ពេល នេះ រួម មាន ស្ពាន ផ្លូវ ថ្នល់ សាលារៀន មន្ទីរពេទ្យ វត្តអារ៉ាម សំណង់ អគារ តូច ធំ រីក ដូច ផ្សិត ភាពស៊ីវិល័យ នៃ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ជាដើម គឺ មិន មែន ជា ការប្រទាន របស់ អាទិទេព ទេ តែ វា កើតឡើង ពី ការខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ។
ពីមុន នៅ ពេល ដែល យើង ចង់ ធ្វើដំណើរ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ពី តំបន់ មួយ ទៅ តំបន់ មួយ នៅ ទូទាំង ប្រទេស ឬ សូម្បីតែ ការធ្វើដំណើរ ពី ផ្ទះ ទៅ សាលារៀន តើ យើង ត្រូវ ចំណាយ ពេល ប៉ុន្មាន ? ឥឡូវនេះ ការធ្វើដំណើរ ទៅ គ្រប់ ខេត្ត ទាំងអស់ នៅ ទូទាំង ប្រទេស គឺ សុទ្ធតែ អាច វិល ល្ងាច បាន ។ ស្ពាន ផ្លូវ ថ្នល់ សាលារៀន មន្ទីរពេទ្យ វត្តអារ៉ាម សំណង់ អគារ នានា គឺជា ភស្តុតាង ដែល មិន អាច បដិសេធ នូវ សមិទ្ធផល ក្រោយ ៧ មករា ១៩៧៩ ។
កម្ពុជា ដែល ពីមុន ជា ប្រទេស ត្រូវ ទទួលរង ការហ៊ុមព័ទ្ធ និង ឯកោ ទាំង ខាង នយោបាយ និង សេដ្ឋកិច្ច ឥឡូវ បាន ក្លាយជា ប្រទេស មួយ ដែល កំពុង សមាហរណ ខ្លួន យ៉ាង សកម្ម ទៅក្នុង រចនាសម្ព័ន្ធ និង និម្មាប នកម្ម តំបន់ និង ពិភពលោក និង ជា ប្រទេស ដែល កំពុងតែ ដើរ តួនាទី យ៉ាង សកម្ម ដោយ ស្មើ សិទ្ធិ និង ស្មើភាព ក្នុង គ្រប់ កិច្ចការ តំបន់ និង នៅលើ ឆាក អន្តរជាតិ ។
ទាំងអស់ នេះ គឺជា សូចនាករ ដែល អាច វាស់វែង បាន អំពី ការរីកចម្រើន និង ការអភិវឌ្ឍ របស់ ប្រទេស កម្ពុជា ក្រោយ ថ្ងៃ រំដោះ ៧ មករា ១៩៧៩ ។ ដូច្នេះ ថ្ងៃ៧ មករា ជា សច្ច ភាព ប្រវត្តិសាស្ត្រ និង ជា មេរៀន ដែល ត្រូវ ចងចាំ . ចងចាំ ពី ស្ថាបនិក ៧ មករា ដែល ជា ទេវតា រំដោះ ជាតិ និង ប្រជាជន . អ្នកស្តារ កសាង និង អភិវឌ្ឍ ជាតិ . ត្រូវ ចងចាំ ពី ទស្សនវិជ្ជា ឯកភាព ផ្សះផ្សា និង បង្រួបបង្រួម ជាតិ . ត្រូវ ចងចាំ បិតា ស្ថាបនិក សន្តិភាព និង ចារឹក ទុក នូវ វប្បធម៌ សន្តិភាព យូរអង្វែង តទៅ មុខ ទៀត ។
ទន្ទឹម នឹង នោះ ដែរ អ្នក ស្នង មរតក ៧ មក រា ត្រូវតែ បន្ត រក្សា នូវ សមិទ្ធផល ៧ មករា ឱ្យ បាន គង់វង្ស ក៏ប៉ុន្តែ គេ ក៏ មិន ត្រូវ ស្កប់ស្កល់ តែ នឹង សមិទ្ធផល ៧ មករា បច្ចុប្បន្ន ហើយ នាំគ្នា សូត្រ មេសូត្រ រត់ មាត់ ៧មករា រហូត ទេ ។ អ្នក ស្នង មរតក ៧ មក រា ត្រូវតែ ដាក់ចេញ នូវ ទស្សនវិស័យ ថ្មី យុទ្ធសាស្ត្រ ថ្មី និង ចក្ខុវិស័យ ថ្មី ឱ្យ ស្រប តាម ការវិវត្ត នៃ ចរន្ត សាកល ភា វូប និយកម្ម ដើម្បី បង្កើត មរតក និង សមិទ្ធផល ថ្មី ៗ បន្ថែម ទៀត សម្រាប់ អ្នកជំនាន់ ក្រោយ ៕
ដោយ៖ បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា
អំណោយ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន លោក សេង ទៀង ជំនួយការ ផ្ទាល់ សម្តេច តេជោ អញ្ជើញ នាំយក ទៅ ប្រគល់ ជូន គ្រួសារ សម្រាល ទារក ភ្លោះ ៣នាក់ ជា គ្រួសារ ទី៣៩៥ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
គ្រួសារ ដែល ទទួលបាន អំណោយ ដ៏ ថ្លៃថ្លា នេះ ប្រសូត្រ នៅ ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០២២ ជា កូន លើក ដំបូង ប្រុស ៣នាក់ ដែល មាន ឪពុក ឈ្មោះ ហាក់ លី ហៃ អាយុ ៤១ ឆ្នាំ មុខរបរ មន្រ្តី រាជការ និង ម្តាយ ឈ្មោះ អំ គន្ធី អាយុ ៤២ ឆ្នាំ មុខរបរ គ្រូបង្រៀន មាន ទីលំនៅ រស់ នៅ ភូមិ ព្រែក យាយ ហាយ ឃុំ ព្រែក ថ្មី ស្រុក កោះ ធំ ខេត្ត កណ្តាល ។
លោក សេង ទៀង បាន ឱ្យដឹង ថា ចាប់តាំងពី ឆ្នាំ ១៩៩៩ រហូតមកដល់ បច្ចុប្បន្ន នេះ ពោលគឺ រយៈពេល ជាង ២៣ឆ្នាំ កន្លងមក នេះ មាន គ្រួសារ ប្រសូត្រ ទារក ភ្លោះ ៣នាក់ ឬ ៤នាក់ ចំនួន ៣៩៥ គ្រួសារ រួចហើយ បាន ទទួល អំណោយ ឧបត្ថម្ភ ដ៏ សប្បរសធម៌ ពី សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក្នុង ការជួយ ទំនុកបម្រុង ដល់ ការលំបាក ខ្វះខាត ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ពិសេស ការចិញ្ចឹម បីបាច់ ទារក ភ្លោះ បី នាក់ ត្រូវ ជា ចៅ ៗ របស់ សម្តេច ទាំង ទ្វេ នៅពេល ឆ្លង ទន្លេ រួច ។
បន្ថែម ពី នេះ លោក សេង ទៀង បាន បន្ត ថា ជំនួយ ឧបត្ថម្ភ ទាំងអស់ នេះ មិន មែន ជា អំណោយ របស់ រាជ រដ្ឋាភិបាល . អំណោយ របស់ កាកបាទ ក្រហម កម្ពុជា ឬ អំណោយ របស់ គណបក្ស ដែល បម្រើ ឱ្យ សកម្មភាព នយោបាយ នោះ ទេ ផ្ទុយទៅវិញ អំណោយ ទាំងអស់ នេះ គឺជា អំណោយ ទាន កើត ចេញ ពី ទឹកចិត្ត ជ្រះថ្លា ប្រកបដោយ ការគិត គួរ ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល បាន ឈ្វេងយល់ ពី ការលំបាក ពិតប្រាកដ ចំពោះ ប្រជាពលរដ្ឋ ដែល មាន ប្រសូត្រ ទារក ភ្លោះ ៣ ឬ ៤នាក់ ។
ដោយសារ ស្ថានភាព សុខភាព របស់ មាតា និង ទារក មិន ទាន់ មាន ភាពល្អ ប្រសើរ និង ម្យ៉ាងទៀត ដោយសារ កូន ត្រូវ រក្សា ក្នុង កែវ បំប៉ន សុខភាព . លោក សេង ទៀង បាន ផ្តាំផ្ញើ ជូន ដល់ ក្រុមគ្រួពេទ្យ ឯកទេស បន្ត យកចិត្តទុកដាក តាមដាន សុខភាព ជូន ដល់ គ្រួសារ កូន ភ្លោះ ៣នាក់ នោះ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ និង បន្ត ស្នាក់ នៅ ថែទាំង សុខភាព ក្នុង មន្ទីរពេទ្យ ឱ្យ មាន រយៈពេល យូរ មុនពេល ចេញ ទៅកាន់ លំដៅ ដ្ឋាន វិញ ។
ទន្ទឹមនឹង នេះ ដែរ លោក ក៏ បាន ផ្តាំផ្ញើ ដល់ គ្រួសារ កូន ភ្លោះ ៣ នាំយក អំណោយ ទាំងអស់ នេះ ចិញ្ចឹម បីបាច់ និង ខិតខំ ថែរក្សា កូន ភ្លោះ ទាំង៣ ឱ្យ មាន សុខភាព និង មាន អនាគត ល្អ ទៅ ថ្ងៃ ខាងមុខ ។
