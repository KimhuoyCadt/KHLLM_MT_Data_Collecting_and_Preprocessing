( ភ្នំពេញ ) ៖ នៅ ថ្ងៃ ៧មករា ឆ្នាំ ២០២៣ នេះ ជា ខួប លើក ទី៤៤ នៃ ការរស់រាន មាន ជីវិត ឡើងវិញ យើង ឃើញ ប្រជាជាតិ ខ្មែរ ទំាង ក្នុង និង ក្រៅ ប្រទេស ប្រុស - ស្រី ក្មេង - ចាស់ បាន ប្រារព្វ ពិធី រំឭក ខួប នៃ ការរស់រាន មាន ជីវិត ឡើងវិញ ដែល រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត យ៉ាង អធិកអធម និង សប្បាយរីករាយ ។ ទន្ទឹមនឹង នេះ ក៏ មាន អ្នកនយោបាយ ក៏ ដូចជា សកម្មជន នយោបាយ ខ្លះ តែង ប្រកាស ក្ដែង ៗ ដោយ ចាត់ទុក ថ្ងៃ ៧ មករា ជា ថ្ងៃ វៀតណាម ចូល ឈ្លានពាន កម្ពុជា ទៅ វិញ ។
បាន ន័យ ថា ពួកគេ បដិសេធន៍ ចោល អំពី រឿងរ៉ាវ ជីវិត ខ្លួន ឯង ក៏ ដូចជា ជីវិត ប្ដី ប្រពន្ធ ឪពុក ម្ដាយ កូន ចៅ បងប្អូន ក្រុមគ្រួសារ សាច់ញាតិ របស់ ខ្លួន និង ប្រជាជាតិ ខ្មែរ ទូទាំង ប្រទេស ដែល បាន ស្លាប់ ក្នុង របប ខ្មែរ ក្រហម ។ បើ ពោល ឲ្យ ចំ ទៅ គឺ ពួកគេ បាន បដិសេធន៍ ចោល ទាំង ងងឹតងងុល អំពី ប្រវត្ដិសាស្រ្ដ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ហ្នឹង ឯង ។
ដូច្នេះ ថ្ងៃ៧ មករា បាន ផ្តល់ កំណើត ទី ពីរ ដល់ ប្រជាជន កម្ពុជា និង បាន ផ្តល់ ក្តីសង្ឃឹម ចំពោះ អនាគត របស់ ប្រទេសជាតិ នេះ ជា សច្ចធម៌ ប្រវត្តិសាស្រ្ត ដែល គ្មាន កម្លាំង ណា អាច មក បំភ្លៃ បំផ្លើស និង បំផ្លាញ បាន ឡើយ ៕ អគារមន្ទីរពិសោធន៍ ថ្មី នៃ អគ្គ នាយកដ្ឋាន « ក. ប. ប. » ត្រូវបាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ
( ភ្នំពេញ ) ៖ អគារមន្ទីរពិសោធន៍ ថ្មី នៃ អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ « ក. ប. ប. » នៃ ក្រសួង ពាណិជ្ជកម្ម ត្រូវបាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ហើយ នៅ ថ្ងៃទី ០៦ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
ពិធី ធ្វើឡើង ក្រោម អធិបតីភាព លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម និង មាន ការអញ្ជើញ ចូលរួម ពី លោក លោកស្រី រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ប្រតិភូ រាជ រដ្ឋាភិបាល អគ្គ នាយក អគ្គាធិការ ព្រមទាំង មន្ត្រីរាជការ នៃ អគ្គ នាយកដ្ឋាន ក . ប. ប . ជាច្រើន រូប ។
ក្នុង ឱកាស នោះ លោក ផាន អូន ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ក . ប. ប . បាន អគារមន្ទីរពិសោធន៍ ថ្មី នេះ បាន បើក ការដ្ឋាន សាងសង់ កាលពី ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២១ និង បញ្ចប់ ការសាងសង់ ទាំងស្រុង នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ដោយ ចំណាយ ពេលវេលា សាងសង់ ប្រមាណ ១៧ខែ ក្នុង ដំណាក់កាល ដ៏ លំបាក នៃ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។
លោក ប៉ាន សូរស័ក្តិ បាន កោតសរសើរ ចំពោះ ថ្នាក់ដឹកនាំ និង មន្ត្រី គ្រប់ លំដាប់ថ្នាក់ នៃ ក្រសួង ពាណិជ្ជកម្ម ។ ជាពិសេស ក្រុមការងារ សាងសង់ ដែល បាន ខិតខំ ប្រឹងប្រែង រៀបចំ គម្រោង និង ដំណើរការ សាងសង់ រហូត សម្រេចបាន អគារមន្ទីរពិសោធន៍ ដ៏ ស្រស់ស្អាត នេះ ។
លោក រដ្ឋមន្ត្រី បន្ត ថា អគារមន្ទីរពិសោធន៍ នេះ គឺជា សមិទ្ធផល ថ្មី មួយ ទៀត របស់ ក្រសួង ពាណិជ្ជកម្ម ពិសេស អគ្គ នាយកដ្ឋាន ក . ប. ប. ទទួលបាន នា ដើម ឆ្នាំ ២០២៣ នេះ ។
លោក រដ្ឋមន្ត្រី បន្ត ថា ដើម្បី អនុវត្ត បាន ដោយ ជោគជ័យ នូវ គោលដៅ យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ចាំបាច់ ត្រូវ មាន និង បន្ត អភិវឌ្ឍ នូវ កត្តា ៣ សំខាន់ គឺ៖ រចនាសម្ព័ន្ធ រឹង រចនាសម្ព័ន្ធ ទន់ និង ធនធាន មនុស្ស ។
ពាក់ព័ន្ធ នឹង រចនាសម្ព័ន្ធ រឹង លោក រដ្ឋមន្ត្រី បញ្ជាក់ ថា ក្រសួង ពាណិជ្ជកម្ម បាន យកចិត្តទុកដាក់ និង ប្រឹងប្រែង ធ្វើការអភិវឌ្ឍ តាមរយៈ ការកសាង បាន នូវ អគារ រដ្ឋបាល និង មន្ទីរពិសោធន៍ នៅ ថ្នាក់ កណ្តាល និង អគារ រដ្ឋបាល និង មន្ទីរពិសោធន៍ ខ្នាត តូច នៅ តាម បណ្តា ខេត្ត ដែល រហូតមកដល់ បច្ចុប្បន្ន នេះ ខេត្ត ចំនួន ១៦ មាន អគារ ដែល ទើប សាងសង់ ថ្មី សម្រាប់ បំពេញ ការងារ រួចហើយ ។
ក្រៅពី នេះ ក៏ មាន ការបំពាក់ រថយន្ត ពិសោធន៍ ចល័ត ផ្នែក ប្រេងឥន្ធនៈ និង ម្ហូប អាហារ ចំនួន ៩គ្រឿង និង ឧបករណ៍ សម្រាប់ បម្រើ ឱ្យ ការងារ ត្រួតពិនិត្យ និង វិភាគ ក្នុង មន្ទីរពិសោធន៍ មួយចំនួន ទៀត ។
ចំពោះ ធនធាន មនុស្ស វិញ លោក រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ ថា ក្រសួង ពាណិជ្ជកម្ម បាន ផ្តល់ ការយកចិត្តទុកដាក់ បំពាក់ បំប៉ន ជំនាញ បច្ចេកទេស ដល់ មន្រ្តី រាជការ គ្រប់ លំដាប់ថ្នាក់ តាមរយៈ ការបញ្ជូន ទៅ ចូលរួម បណ្តុះបណ្តាល នៅក្នុង និង ក្រៅ ការរៀបចំ វគ្គ បណ្តុះបណ្តាល ជំនាញ និង សិក្ខាសាលា ផ្ទៃក្នុង អង្គភាព និង អន្តរ ស្ថាប័ន ជាដើម ។
បន្ទាប់ពី ពិធី សម្ពោធ អគារមន្ទីរពិសោធន៍ ថ្មី រួចហើយ នោះ លោក រដ្ឋមន្ត្រី និង ថ្នាក់ដឹកនាំ គ្រប់ ជាន់ ថ្នាក់ ព្រមទាំង មន្ត្រីរាជការ ក៏ បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី សូត្រ មន្ត និង ចែក ទាន ជូន យាយ ជី តា ជី ចំនួន ១២៣ នាក់ ផងដែរ ៕
ក្រោយ បទបញ្ជា របស់ សម្តេច តេជោ . អភិបាល ខេត្ត ក្រចេះ ប្រជុំ ដាក់ ចេញ ពី វិធានការ ទប់ស្កាត់ និង ពង្រឹង ការពារ អភិរក្ស សត្វ ផ្សោត ទន្លេ មេគង្គ
( ក្រចេះ ) ៖ កាលពី ថ្ងៃទី២ ខែមករា ឆ្នាំ ២០២៣ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លងកាត់ ទន្លេ មេគង្គ ខេត្ត ក្រចេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បញ្ជា ឲ្យ អភិបាល ខេត្ត ក្រចេះ និង ខេត្ត ស្ទឹងត្រែង បង្កើន ការយកចិត្តទុកដាក់ អភិរក្ស សត្វ ផ្សោត ដោយ មិន ត្រូវ ពឹងផ្អែក តែ លើ ក្រសួង កសិកម្ម នោះ ឡើយ និង បាន ណែនាំ ឱ្យ បង្កើត តំបន់ ស្នូល អចិន្ត្រៃយ៍ ដើម្បី អភិរក្ស សត្វ ផ្សោត ។
បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន បន្ទាប់ មាន របាយការណ៍ ពី ករណី សត្វ ផ្សោត ដែល ជា ប្រភេទ សត្វ ជិត ផុត ពូជ បាន ងាប់ ជាបន្ទាប់ ដោយសារតែ ជាប់ មង សន្ទូច និង បទល្មើស សនេសាទ ខុស ច្បាប់ មួយចំនួន នៅ តំបន់ សត្វ ផ្សោត ទន្លេ មេគង្គ រស់ នៅ ។
ក្រោយ ទទួលបាន បទបញ្ជា នេះ នៅ ល្ងាច ថ្ងៃទី ៦ ខែមករា ឆ្នាំ ២០២៣ នេះ អភិបាល ខេត្ត ក្រចេះ បាន បើក កិច្ចប្រជុំ បន្ទាន់ ជា មន្ត្រី ពាក់ព័ន្ធ ស្ដីពី វិធានការ ទប់ស្កាត់ និង ពង្រឹង ការពារ អភិរក្ស សត្វ ផ្សោត ទន្លេ មេគង្គ ឲ្យ ឋិតថេរ គង់ វង់ មន្រ្តី ពាក់ព័ន្ធ ទាំងអស់ ត្រូវតែ ចូលរួម ទប់ស្កាត និង បង្រ្គាប បទល្មើស នេសាទ ក្នុង តំបន់ អភិរក្ស សត្វ ផ្សោត ។
ក្នុង ពិធី ប្រជុំ នោះ មាន ការចូលរួម ពី អភិបាល រង ខេត្ត ស្នងការ នគរបាល ខេត្ត មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ប្រធាន មន្ទីរ កសិកម្ម ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត នាយ ខណ្ឌ រដ្ឋបាល ជលផល អភិបាល ស្រុក ទាំង៣ ( ស្រុក ព្រៃ ប្រសព្វ ស្រុក ចិត្ត បុរី ស្រុក សំបូរ ) អធិការ នគរបាល ស្រុក ទាំង៣ រួមទាំង នាយ ប៉ុស្តិ៍ និង មេឃុំ ពាក់ព័ន្ធ ទាំងអស់ ផងដែរ ។
ក្នុង ឱកាស នោះ លោក វ៉ា ថន បាន គូសបញ្ជាក់ ថា « យើង ជួបជុំគ្នា ពេលនេះ គឹយើង ត្រូវ រៀបចំ វិធានការ ទប់ស្កាត់ ការពារ អភិរក្ស សត្វ ផ្សោត របស់ យើង ដែល កំពុង រង នូវ ការ ជិត ផុត ពូជ ដោយសារ ការ ជាប់ មង ការឆក់ ត្រី ពីសំណាក់ អ្នកនេសាទ ត្រី ដោយ ប្រើ ឧបករណ៍ ខុស ច្បាប់ នៅក្នុង ដែន អភិរក្ស សត្វ ផ្សោត ទន្លេ មេគង្គ ក្នុង ខេត្ត ក្រចេះ ហើយ កម្លាំង ត្រូវ ចុះល្បាត ចាប់ពី ចំណុច ក្បាល កោះ ទ្រង់ ឡើង ទៅដល់ ព្រំប្រទល់ ខេត្ត ស្ទឹងត្រែង » ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បង្ហាញ នូវ ការជឿជាក់ ថា ប្រជាពលរដ្ឋ នឹង ចូលរួម អភិរក្ស ដោយ មិន ត្រូវ ចូល នេសាទ នៅ តំបន់ ដែល មាន ការហាមឃាត់ នោះ ទេ ប៉ុន្តែ ដើម្បីឱ្យ បាន ច្បាស់លាស់ ត្រូវតែ បោះ ពោង ដោយ បោះ យុទ្ធថ្កា និង ដាក់ ផ្ទាំង សូឡា ដើម្បី បំភ្លឺ ក្នុង តំបន់ អភិរក្ស សត្វ ផ្សោត តែម្តង ដើម្បី ធានា ការពារ សត្វ ផ្សោត នេះ ជាដើម ។
