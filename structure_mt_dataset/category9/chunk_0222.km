( ភ្នំពេញ ) ៖ លោក យូ សិរី វុឌ្ឍ ក្រុមការងារ ពិសេស របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង លោក ភឺន ផល្លា ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ជួប សំណេះសំណាល ព្រមទាំង ស្រស់ ស្រូប អាហារ សាមគ្គី ជាមួយ អ្នកសារព័ត៌មាន ប្រមាណ ២០០ នាក់ ។
ក្នុង ជំនួប សំណេះសំណាល និង ស្រស់ ស្រូប អាហារ សាមគ្គី នៅ រាត្រី ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ នេះ លោក យូ សិរី វុឌ្ឍ បាន ថ្លែងអំណរគុណ ដល់ អ្នកសារព័ត៌មាន ដែល បាន ប្រឹងប្រែង យកចិត្តទុកដាក់ ក្នុង ការផ្សព្វផ្សាយ បង្ហាញ ព្រឹត្តិការណ៍ នានា នៅក្នុង សង្គម កម្ពុជា ។
សម្រាប់ លោក យូ សិរី វុឌ្ឍ អ្នកសារព័ត៌មាន និង ប្រព័ន្ធ ផ្សព្វផ្សាយ បាន ដើរ តួនាទី យ៉ាង សំខាន់ បំផុត សម្រាប់ ជា កញ្ចក់ ឆ្លុះបង្ហាញ នូវ តថ ភាព ពិត ក្នុង សង្គម ហើយក៏ ជា កញ្ចក់ ជួយ កែលំអរ ការផ្តល់ សេវា សាធារណៈ ឱ្យ បាន កាន់តែ ប្រសើរ ។ កាន់តែ ពិសេស ទៀត នោះ សារព័ត៌មាន ដើរ តួនាទី សំខាន់ ក្នុង ការរួមចំណែក ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម បញ្ចៀស ចលនា ទុច្ចរិត ទាំងឡាយ ដែល ចង់ បង្ក ភាពចលាចល ក្នុង សង្គម ឬ ចង់ បំផ្លាញ សុខ សន្តិភាព ។
លោក យូ សិរី វុឌ្ឍ បាន លើកទឹកចិត្ត ដល់ អ្នកសារព័ត៌មាន ទាំងអស់ ឱ្យ បន្ត ប្រឹងប្រែង បំពេញ ការងារ របស់ ខ្លួន ឈរ លើ ភាពសុច្ចរិត ផ្សាយ ការពិត ប្រកបដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ ដោយ គោរព តាម អនុសាសន៍ របស់ សម្តេច តេជោ « កុំ បំពាន សិទ្ធិ អ្នកដទៃ កុំ បំភ្លៃ ការពិត » ។
លោក យូ សិរី វុឌ្ឍ ក៏ បាន លើកទឹកចិត្ត ឱ្យ អ្នកសារព័ត៌មាន រួមគ្នា ប្រឆាំង នឹង ព័ត៌មាន ក្លែងក្លាយ ព័ត៌មាន ទុច្ចរិត ដោយ ផ្សាយ ត្រឡប់ នូវ សភាព ពិត របស់ កម្ពុជា ដើម្បី រក្សា បាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ និង សុខ សន្តិភាព ក្នុង សង្គម កម្ពុជា ៕ ផ្ទះ ថ្មី ដែល ជា អំណោយ របស់ សម្ដេច តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន ប្រគល់ ជូន អតីត យុទ្ធជន នៅ ស្រុក បារាយណ៍
( កំពង់ធំ )៖ ផ្ទះ ថ្មី ដែល ជា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ត្រូវបាន ប្រគល់ ជូន អតីត យុទ្ធជន សោធន និវត្តន៍ នៅ ភូមិ សំរោង ឃុំ បារាយណ៍ ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ ។
ការប្រគល់ ផ្ទះ ខាងលើ នេះ ធ្វើឡើង តាមរយៈ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ នា រសៀល ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ ។
ឧត្ដមសេនីយ៍ ទោ សោម ស៊ុន បាន បញ្ជាក់ ថា ឧត្តមសេនីយ៍ ទោ សឺន ស័ព្ទ អតីត ជា អធិការ នគរបាល ស្រុក បារាយណ៍ ក្នុង ឆ្នាំ ១៩៨១ ដល់ ឆ្នាំ ១៩៨៩ ជា ស្នងការ នគរបាល ខេត្ត កំពង់ធំ ពី ១៩៩០ ដល់ ឆ្នាំ ១៩៩៤ និង ក្រោយមក ត្រូវបាន ផ្ទេរ ភារកិច្ច ទៅកាន់ ក្រសួង មហាផ្ទៃ ហើយ ត្រូវបាន ក្រសួង មហាផ្ទៃ ដាក់ ឲ្យ ចូលនិវត្ត តាម ការកំណត់ ។
លោក បាន បន្ត ថា ឧត្តមសេនីយ៍ ទោ សឺន ស័ព្ទ មាន ភរិយា និង កូន ក្នុង បន្ទុក ចំនួន ៥នាក់ ដោយ គាត់ មាន បញ្ហា សុខភាព ពុំ អាច ប្រកបរបរ អ្វី បាន ក្រៅ គោល របប ដែល ថ្នាក់ លើ កំណត់ ទើប ពុំ មាន លទ្ធភាព សាងសង់ ជម្រក ស្នាក់ នៅ សមរម្យ បាន ដោយ ខ្លួន ឯង នៅលើ ដី ដែល គាត់ មាន ។
ដោយ ឃើញ ពី ការលំបាក នេះ ក្រុមការងារ នៃ គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន ម្ពុជា ខេត្ត កំពង់ធំ សុំ ការសម្រេច សាងសង់ ផ្ទះ ថ្មី ខ្នង ទី ២៣២ ដែល ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន គាត់ ដោយ បាន សាងសង់ ផ្ទាល់ ដី ឆ្អឹង ដែក ចាក់ សាប ក្នុង ផ្ទះ និង ជុំវិញ ផ្ទះ ជញ្ជាំង ស្មាត បត ដំបូល ប្រក់ ស័ង្កសី កិន ភ្លី ។
ក្នុង ពិធី ប្រគល់ ផ្ទះ ថ្មី នៅ ពេល នេះ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន នាំយក នូវ អំណោយ របស់ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ផ្ដល់ជូន គាត់ បន្ថែម ទៀត មាន អង្ករ ចំនួន ២០០ គីឡូក្រាម មី ចំនួន ៥កេស ទឹក ផ្លែឈើ ៣កេស ទឹកត្រី ចំនួន ២យួរ ទឹកត្រី ទឹក ស៊ី អ៉ីវ ចំនួន ៥យួរ ទឹក បរិសុទ្ធ ២កេស និង ថវិកា មួយ ចំនួន ផងដែរ ។
លោក សឺន ស័ព្ទ និង ក្រុមគ្រួសារ បាន គោរព ថ្លែងអំណរគុណ និង សូម គោរព ជូនពរ ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង លោក ហ៊ុន ម៉ាណែត និង លោកស្រី រួមទាំង គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ៕
ពលរដ្ឋ ក្រីក្រ និង ចាស់ជរា ១០គ្រួសារ នៅ ឃុំ ព្រែក តា កូវ ស្រុក ខ្សាច់ កណ្ដាល ទទួលបាន អំណោយ ពី អនុ សាខា កាកបាទ ក្រហម ស្រុក
( កណ្ដាល ) ៖ ពលរដ្ឋ ក្រីក្រ និង ចាស់ជរា គ្មាន ទីពឹង ចំនួន ១០គ្រួសារ នៅ ឃុំ ព្រែក តា កូវ ស្រុក ខ្សាច់ កណ្ដាល ទទួលបាន អំណោយ ពី អនុ សាខា កាកបាទ ក្រហម ស្រុក ខ្សាច់ កណ្ដាល ដែល អំណោយ នេះ ត្រូវបាន លោក ថេង មករា ជួស មុខ លោក ចេង អភិបាល ស្រុក នាំយក ទៅ ប្រគល់ ជូន កាលពី ពេល ថ្មី កន្លងទៅ នេះ ។
លោក ថេង មករា តំណាង ឲ្យ លោក ចេង ឌីណា អភិបាល ស្រុក ខ្សាច់ កណ្តាល បាន ពាំនាំយក ប្រសាសន៍ ផ្តាំផ្ញើ របស់ លោក អភិបាល ស្រុក សួរសុខទុក្ខ ប្រជាពលរដ្ឋ ចាស់ជរា គ្មាន ទីពឹង និង ជន ងាយ រងគ្រោះ និង បាន ណែនាំឲ្យ មាន ការរស់នៅ ការហូបចុក ហូប ទឹក ស្អាត ប្រកបដោយ អនាម័យ ខ្ពស់ ជៀស វាស មាន បញ្ហា សុខភាព និង ជាពិសេស បាន ជំរុញ ឲ្យ មាន ការចាក់ វ៉ាក់សាំង ដូស ជំរុញ បន្ថែម ទៀត ដើម្បី ការពារ និង ជៀស ឆ្ងាយ ពី ជំងឺ កូន វីដ១៩ ផងដែរ ។
គួរ ជម្រាប ថា អំណោយ ដែល ប្រគល់ ជូន ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ១៥គីឡូក្រាម .មី ជាតិ ១កេស . ទឹកត្រី ៣ដប . ទឹកស៊ី អ៉ីវ៣ដប និង ថវិកា ៥ម៉ឺន រៀល ៕
សម្តេច តេជោ ទាយ ថា ម៉ារ៉ុក យកឈ្នះ ក្រូ អាត ដើម្បី គ្រង តំណែង លេខ ៣
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ទស្សន៍ទាយ ថា ក្រុម ជម្រើសជាតិ របស់ ម៉ារ៉ុក នឹង យកឈ្នះ ប្រទេស ក្រូ អាត ដើម្បី គ្រង តំណែង លេខ ៣ ក្នុង ការប្រកួត ពានរង្វាន់ ពិភពលោក ឆ្នាំ ២០២២ នេះ ។
សូម បញ្ជាក់ ថា នៅ វេលា ម៉ោង ១០ យប់ ថ្ងៃ នេះ ម៉ារ៉ុក និង ក្រូអាត នឹង បើក ការប្រកួត ជាមួយគ្នា ដើម្បី ដណ្តើមយក តំណែង លេខ ៣។
ដោយឡែក នៅ វេលា ម៉ោង ១០ យប់ ថ្ងៃទី ១៨ ខែធ្នូ គឺជា ជំនួប រវាង បារាំង និង អាហ្សង់ទីន ដែល ជា ការប្រកួត វគ្គ ផ្តាច់ព្រ័ត្រ ដើម្បី ដណ្តើមយក ពានរង្វាន់ បាល់ ពិភពលោក ។
សម្រាប់ ការប្រកួត វគ្គ ផ្តាច់ព្រ័ត្រ សម្តេច តេជោ បាន ទស្សន៍ទាយ ថា បារាំង នឹង បន្ត គ្រង តំណែង ម្ចាស់ ពាន បាល់ទាត់ ពិភពលោក ៕
អង្គ ពិធី បាន ប្រព្រឹត្ត ដំណើរការ ទៅ យ៉ាង រលូន តាម កម្មវិធី ដែល បាន គ្រោង ទុក ក្រោម បរិយាកាស យកចិត្តទុកដាក់ និង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។ សមាជិក សមាជិកា ដែល បាន ចូលរួម ទាំងអស់ បាន យល់ ជ្រួតជ្រាប និង សម្តែង ការគាំទ្រ ពេញ ទំហឹង ចំពោះ ខ្លឹមសារ ទាំង ១៨ ចំណុច របស់ សម្តេច តេជោ គ្រប់ ៗ គ្នា ។
ក្នុង ឱកាស នោះ សមាជិក ចូលរួម ទាំងអស់ បាន ទទួល នូវ អាហារ សម្រន់ ដែល លោក រ័ត្ន ស៊្រាង នាំយក មក បរិភោគ រួមគ្នា ប្រកបដោយ ភាពស្និទ្ធស្នាល រីករាយ កក់ក្តៅ គ្រប់ ៗ គ្នា ៕ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បន្ត ចុះ បំពេញ ការងារ មូលដ្ឋាន នៅ ភូមិ បឹង ជង្រុក តេជោ ឈ្នះ ឈ្នះ ឃុំ ទួល ពង្រ ស្រុក ម៉ាឡៃ
( បន្ទាយមានជ័យ )៖ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ នា ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ ប្រចាំ ការ នៅ ភូមិ បឹង ជង្រុក តេជោ ឈ្នះ ឈ្នះ ឃុំ ទួល ពង្រ ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ពាំនាំ បណ្តាំ សួរសុខទុក្ខ ពី ថ្នាក់ដឹកនាំ ជាតិ ពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី ដែល តែងតែ យកចិត្តទុកដាក់ ដល់ ក្រុមការងារ ប្រចាំ ការអភិវឌ្ឍ តំបន់ បឹង ជង្រុក តេជោ ឈ្នះ ឈ្នះ និង បាន កោតស សើរ ដល់ ក្រុមការងារ ទាំងអស់ ដែល បាន ចូលរួម ថែរក្សា សន្តិភាព និង អភិវឌ្ឍន៍ មូលដ្ឋាន បាន រីកចម្រើន ។
ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ថ្លែង បន្ត ថា រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ បាន ដឹកនាំ ប្រទេសជាតិ មាន សុខ សន្តិភាព រីកចម្រើន លើ គ្រប់ វិស័យ បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ ឱ្យ មាន ជីវភាព ធូរធា ជាក់ស្តែង តំបន់ បឹង ជង្រុក នេះ គឺ គ្មាន ហេដ្ឋារចនាសម្ពន្ធ ផ្លូវថ្នល់ ប្រជាពលរដ្ឋ រស់ នៅ ដោយ ការលំបាក ។
ជាមួយគ្នា នេះ ឧប នាយក រដ្ឋមន្រ្តី កែ គឹម យ៉ាន បាន នាំ អំណោយ ឧបត្ថម្ភ ក្រុមការងារ សម្ដេច តេជោ ក្រុមការងារ ស្រុក ម៉ាឡៃ ក្រុមការងារ កងកម្លាំង ប្រជាការពារ ភូមិ តេជោ ឈ្នះ ឈ្នះ អនុសាខា និង សាខា បក្ស ភូមិ ក្រុម គ្រូពេទ្យ លោកគ្រូ អ្នកគ្រូ យុវជន សម្ពន្ធ ស្រលាញ់ សន្តិភាព សឹក រង ស្រុក នរគ បាល ស្រុក អាវុធហត្ថ ស្រុក ផងដែរ ៕
មន្រ្តី ដែល រុស្ស៉ី លើក បន្តុប រូប នេះ បាន និយាយ ថា វា នឹង ការពារ ពី គ្រាប់ ផ្លោង ឬ ឧបករណ៍ បំផ្ទុះ ដែល គប់ ចេញ ពី យន្តហោះ ដ្រូន ហើយ វា នឹង មាន សារៈសំខាន់ នៅ ពេល ក្រោយ ។
គួរ បញ្ជាក់ ថា ការប្រយុទ្ធ គ្នា ជុំវិញ ស្ថានីយ៍ ថាមពល នុយក្លេអ៊ែរ ដ៏ ធំ បំផុត របស់ អឺរ៉ុប ក្នុង រយៈពេល ១០ខែ នៃ ជម្លោះ បាន បង្កើន ការភ័យខ្លាច នៃ គ្រោះមហន្តរាយ នុយក្លេអ៊ែរ ។ ទាំង ទីក្រុង កៀវ និង ទីក្រុង មូស្គូ បាន ចោទប្រកាន់ គ្នា ទៅ វិញ ទៅ មក ថា បាន បាញ់ ផ្លោង បណ្តាលឲ្យ ដាច់ ដំណើរការ ម៉ាស៊ីន រ៉េអាក់ទ័រ ចំនួន ៦ នៃ រោងចក្រ នេះ ៕
រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ ជួប សំណេះសំណាល ជាមួយនិស្សិត ជ័យលាភី អាហារូបករណ៍ រដ្ឋាភិបាល អូស្រា្តលី ឆ្នាំ ២០២៣ មុន ការចេញ ទៅ សិក្សា នៅ ប្រទេស អូស្រ្តាលី
( ភ្នំពេញ ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ នាទី ស្ដីការ ក្រសួង បាន អនុញ្ញាតឱ្យ ជ័យលាភី អាហារូបករណ៍ រដ្ឋាភិបាល អូស្រ្តាលី សម្រាប់ ឆ្នាំ ២០២៣ ដែល មាន អ្នកចូលរួម ចំនួន ៣៨នាក់ ( ស្រី ១៩ នាក់ ) ជួប សម្ដែង ការគួរសម និង ទទួលយក អនុសាសន៍ ណែនាំ មុន ការចេញដំណើរ ទៅ សិក្សា នៅ ប្រទេស អូស្រ្តាលី នា ពេល ខាងមុខ ។
ជាក់ស្តែង ក្រសួង មុខងារ សាធារណៈ បាន ធ្វើ ទំនើបកម្ម ប្រព័ន្ធ គ្រប់គ្រង មន្រ្តី រាជការ ស៊ីវិល ដោយ ផ្សារភ្ជាប់ នឹង កម្មវិធី ក្នុង ទូរស័ព្ទ ឆ្លាតវៃ (Mobile App) និង បាន បោះពុម្ព អត្តសញ្ញាណប័ណ្ណ មន្រ្តី រាជការ ស៊ីវិល ប្រភេទ ថ្មី និង ចាប់ផ្តើម ដំណើរការផ្តល់ ជូន មន្រ្តី រាជការ ដើម្បី ប្រើប្រាស់ ជា ផ្លូវការ សម្រាប់ ជា ប័ណ្ណ សម្គាល់ ខ្លួន ផង ជា ប័ណ្ណ អេធី អឹម (ATM) ដក ប្រាក់ បៀវត្ស ពី ធនាគារ ផង និង អាច ប្រើប្រាស់ ជា មធ្យោបាយ ចាំបាច់ ផ្សេង ទៀតផង ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ការចុះអនុស្សរណៈ យោគយល់ គ្នា នេះ ក្នុង គោលបំណង ជួយ លើកកម្ពស់ ជីវភាព របស់ ប្រជាកសិករ តាមរយៈ ការបរិច្ចាគ នូវ ម៉ាស៊ីន ស្ទូង ស្រូវ ចំនួន ២០ គ្រឿង និង ឧបករណ៍ សម្រាប់ បណ្តុះ គ្រាប់ ពូជ ដល់ សហគមន៍ កសិកម្ម ចំនួន ៥ ដែល មាន ទីតាំង នៅក្នុង ខេត្ត កំពង់ចាម កំពង់ធំ ព្រៃវែង និង ខេត្ត តាកែវ ។
ទីភ្នាក់ងារ សម្របសម្រួល កិច្ចសហប្រតិបត្តិការ របស់ ប្រទេស ទួរ គី (TIKA) បាន និង កំពុង អនុវត្តន៍ គម្រោង មួយចំនួន នៅក្នុង ប្រទេស កម្ពុជា ក្នុង វិស័យ អប់រំ គេហកិច្ច និង ការបណ្តុះបណ្តាល កសាង សមត្ថភាព ហើយ នេះ គឺជា គម្រោង ទី១ របស់ TIKA នៅក្នុង ប្រទេស កម្ពុជា លើ វិស័យ កសិកម្ម ដែល ទីភ្នាក់ងារ បាន ពិចារណា នឹង បន្ត ជួយ ដល់ សហគមន៍ កសិកម្ម បន្ថែម ទៀត នៅ កម្ពុជា ។
តាមរយៈ ម៉ាស៊ីន ស្ទូង ស្រូវ នេះ នឹង ជួយ ដល់ សហគមន៍ កសិកម្ម ឱ្យ មាន ភាពប្រសើរឡើង នូវ បច្ចេកទេស និង សមត្ថភាព ក្នុង ការផលិតកម្ម ពូជ ស្រូវ បន្ថែម ទៀត ។
នៅក្នុង កម្មវិធី ចុះហត្ថលេខា នេះ ដែរ ឧកញ៉ា ចាន់ សុឃាំង ប្រធាន សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា និង លោកជំទាវ ឯក អគ្គ រដ្ឋទូត បាន ពិភាក្សា លើ ការងារ ពាណិជ្ជកម្ម រវាង ប្រទេស កម្ពុជា និង ទួរ គី ដែល បង្ហាញ អំពី ការរីកចម្រើន យ៉ាង លឿន និង បាន បង្ហាញ លទ្ធផល ថា ការនាំចេញ អង្ករ កម្ពុជា ទៅកាន់ ទីផ្សារ ប្រទេស ទួរ គី បាន កើន ដល់ ៣ ០០០ តោន ក្នុង រយៈពេល ១១ខែ នៃ ឆ្នាំ ២០២២ ។
ភាគី ទាំង ពីរ បាន ឯកភាព ធ្វើ កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា បន្ត ទៀត លើ ការអភិវឌ្ឍ វិស័យ ពាណិជ្ជកម្ម និង ផលិតកម្ម ស្រូវ ៕ ចំណេះដឹង ទូទៅ៖ ការប្រកួត ទាំង១០ នៃ World Cup វគ្គ ផ្តាច់ព្រ័ត្រ ដែល មាន ចំនួន អ្នកចូលរួម ទស្សនា ផ្ទាល់ ច្រើន ជាង គេ
( មូស្គូ ) ៖ លោក ប្រធានាធិបតី វ្ល៉ាឌីមៀ ពូទីន បាន បើក កិច្ចប្រជុំ ជាមួយ មន្ត្រី យោធា កំពូល ៗ របស់ លោក ស្ដីពី យុទ្ធសាស្ត្រ សង្រ្គាម នៅ អ៊ុយក្រែន ខណៈ ទីក្រុង មូស្គូ កំពុង បង្កើន យុទ្ធនាការ ទម្លាក់ គ្រាប់បែក ក្នុង រដូវ រងា នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសៅរ៍ ទី១៧ ខែធ្នូ ឆ្នាំ ២០២២ ។
បន្ថែម ពីលើ នេះ នៅក្នុង សម្រង់ សម្ដី មួយ លោក ពូទីន ក៏ បាន កត់សម្គាល់ ដែរ ថា « ខ្ញុំ ចង់ ស្ដាប់ ការលើកឡើង នូវ សំណើ របស់ អ្នក ចំពោះ សកម្មភាព របស់ ពួកយើង នៅក្នុង រយៈពេល ខ្លី និង មធ្យម » ។
គួរ បញ្ជាក់ ថា រុស្ស៉ី កាលពី ថ្ងៃសុក្រ នោះ ដែរ បាន បើក ការវាយប្រហារ តាម ផ្លូវ អាកាស ដោយ បាញ់ ស្រោច មីស៊ីល លើ ទីក្រុង ជាច្រើន របស់ អ៊ុយក្រែន ដែល កំពុង ប្រឈមមុខ នឹង ការដាច់ចរន្ត អគ្គិសនី ខ្វះខាត ទឹក និង ប្រព័ន្ធ កម្ដៅ នៅ ចំពោះ មុខ សីតុណ្ហភាព ដ៏ ត្រជាក់ ។ ប្រទេស លោក ខាងលិច ចាត់ទុក ថា ទង្វើ បំផ្លិចបំផ្លាញ របស់ រុស្ស៉ី ដែល មាន ចេតនា បង្កក ប្រជាជន អ៊ុយក្រែន គឺជា ឧក្រិដ្ឋកម្ម សង្រ្គាម ៕ ឪពុក បង្កើត លោក ជិន ម៉ាលីន ទទួលមរណភាព ដោយ ជរា ពាធ ក្នុង វ័យ ៧៣ ឆ្នាំ
( ភ្នំពេញ ) ៖ លោក វេជ្ជបណ្ឌិត ជិន ស៊ុន តក់ ដែល ជា ឪពុក បង្កើត របស់ លោក ជិន ម៉ាលីន រដ្ឋលេខ ធិការ ក្រសួង យុត្តិធម៌ បាន ទទួលមរណភាព នា ថ្ងៃសុក្រ ទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ វេលា ម៉ោង ៨៖៣០ នាទី ព្រឹក ក្នុង ជន្មាយុ ៧៣ ឆ្នាំ ដោយ រោគា ពាធ ។
សព របស់ លោក វេជ្ជបណ្ឌិត ជិន ស៊ុន តក់ ត្រូវបាន តម្កល់ នៅ វត្ត ប្រជុំ ទី ក្រពើ ហា ផ្លូវ ជាតិ លេខ ២ សង្កាត់ ព្រែក ឫស្សី ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ដើម្បី រៀបចំ ធ្វើ បុណ្យ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា ។
មរណភាព របស់ លោក វេជ្ជបណ្ឌិត ជិន ស៊ុន តក់ គឺជា ការបាត់បង់ បិតា បិតា ក្មេក និង ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ។ ដំណឹង មរណភាព នេះ ចាត់ទុក ជា ការយាង និង អញ្ជើញ ញាតិមិត្ត ជិត ឆ្ងាយ ចូលរួម ពិធី បុណ្យ ៕
លោក ឃួង ស្រេង៖ ការពូន ជ្រុំ និង លើកកម្ពស់ ទំនាក់ទំនង ល្អ រវាង ភ្នំពេញ - ហូជីមិញ នឹង ក្លាយជា វឌ្ឍនភាព ថ្មី ដើម្បី ឈាន ទៅរក ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ
លោក ឃួង ស្រេង បាន ថ្លែង ថា ដំណើរទស្សនកិច្ច របស់ គណៈប្រតិភូ នៅ ពេល នេះ ជា ការរួមចំណែក នៃ ការពង្រឹង និង ពង្រីក ទំនាក់ទំនង ដ៏ ស្អិត រមួត និង កិច្ចសហប្រតិបត្តិការ ដ៏ ជិតស្និទ្ធ រវាង គណបក្ស រដ្ឋាភិបាល និង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ក្នុង នាម ជា អ្នកជិតខាង ល្អ មិត្តភាព ជា ប្រពៃណី កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ ស្ថិតស្ថេរ រឹងមាំ យូរអង្វែង ។
លោក បន្ត ថា « តាមរយៈ ជំនួប ពិភាក្សា ការងារ ក្នុង ពេល នេះ នឹង រួមចំណែក ពូន ជ្រុំ និង លើកកម្ពស់ ទំនាក់ទំនង ដ៏ ល្អ រវាង គណបក្ស និង ប្រជាជន នៃ ទីក្រុង យើង ទាំង ពីរ ភ្នំពេញ - ហូជីមិញ ចំពេល ខូប លើក ទី ៥៥ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត កម្ពុជា - វៀតណាម និង ជា ឆ្នាំ មិត្តភាព លើក ទី១៨ នៃ ការចង សម្ព័ន្ធ មេត្រីភាព រវាង រដ្ឋបាល នៃ ទីក្រុង ទាំង ពីរ ភ្នំពេញ - ហូជីមិញ ឱ្យ កាន់តែ រឹងមាំ ស៊ីជម្រៅ និង ក្លាយជា វឌ្ឍនភាព ថ្មី ដើម្បី ឈាន ទៅរក ការ អភិវឌ្ឍ លើ គ្រប់ វិស័យ » ។
លោក បញ្ជាក់ ថា ឈរ លើ មូល ដា្ឋ នន សុខ សន្តិភាព និង ស្ថិរភាព នយោបាយ ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដ៏ ឈ្លាសវៃ . កម្ពុជា បាន បន្ត ខិតខំ ពុះពារ ជម្នះ ការលំបាក ទាំងអស់ នេះ ធ្វើឱ្យ ដំណើរការ សេដ្ឋកិច្ច និង សង្គម មាន ភាពល្អ ប្រសើរ ជា បន្តបន្ទាប់ ហើយ ខិតខំ សម្រេច ឱ្យ បាន នូវ គោលដៅ អភិវឌ្ឍន៍ ដើម្បី ក្លាយជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ក្លាយជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
លោក ង្វៀន វ៉ាន់ នេន ក្នុង ឱកាស នោះ បាន សាទរ ចំពោះ សមិទ្ធផល ជាច្រើន ដែល កម្ពុជា ដែល សម្រេចបាន នៅ ពេល នេះ ។ លោក បាន មានប្រសាសន៍ ថា « សមិទ្ធផល ទាំងនេះ គឺ ពិតជា បាន មកពី ការដឹកនាំ ដ៏ ល្អ និង ឈ្លាសវៃ របស់ មេដឹកនាំ កំពូល ៗ របស់ កម្ពុជា ដោយ បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា មាន ការអភិវឌ្ឍ រីកចំរើន និង ធ្វើអោយ ជីវភាព ប្រជាពលរដ្ឋ កម្ពុជា ធូរធា » ។
លោក បន្ត ថា « យើង នឹង ពង្រឹង និង ពង្រីក សាមគ្គីភាព សហប្រតិបត្តិការ រវាង ទីក្រុង ហូជីមីង - រាជធានី ភ្នំពេញ កាន់តែ យូរអង្វែង ពិសេស កិច្ចសហប្រតិបត្តិការ គ្នា លើ វិស័យ សេដ្ឋកិច្ច ទេសចរណ៍ ដើម្បី ឈាន ទៅរក ការ អភិវឌ្ឍ រីកចំរើន ខ្លាំងក្លា ថែម ទៀត ។ យើង ចង់អោយ ទីក្រុង ទាំង២ ទីក្រុង ហូជីមីង - ភ្នំពេញ ជំរុញ និង គាំទ្រ ពាណិជ្ជករ អោយ គ្នា ទៅ វិញ ទៅ មក ជំរុញ វិស័យ ទេសចរណ៍ និង ការបង្កើត ទស្សនកិច្ច នៃ ទីក្រុង ទាំង២» ។
លោក ង្វៀន វ៉ាន់ នេន បាន បញ្ជាក់ ថា មន្ទីរពេទ្យ ជោរៃ ទទួលបាន ការជឿទុកចិត្ត ពី ប្រជាពលរដ្ឋ កម្ពុជា ក្នុង ការព្យាបាល ជំងឺ ដូច្នេះ ទីក្រុង ទាំង២ នឹង បន្ត ខិតខំ បន្ថែម ទៀត ដើម្បី បន្ត ជំហាន ទី២ ដោយ យើង ត្រូវ បណ្តុះបណ្តាល ធនធាន មនុស្ស បន្ថែម ដើម្បី បំរើ ការងារ នៅក្នុង ពេទ្យ នេះ ៕
រដ្ឋមន្ត្រី ហង់ ជួន ណារ៉ុន៖ ក្រសួង អប់រំ នឹង ប្រជុំ ពិនិត្យ ករណី លោក អ៉ិន ពៅ សម្បត្តិ ប្រធាន មន្ទីរ អប់រំ ខេត្ត ត្បូងឃ្មុំ បន្ទាប់ពី ចប់ ការងារ ប្រទ្បង បាក់ឌុប
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ តាម សារ អេឡិចត្រូនិច យ៉ាង ដូច្នេះ ថា « ក្រសួង នឹង ប្រជុំ ពិនិត្យ ករណី នេះ បន្ទាប់ពី ចប់ ការងារ ប្រទ្បង បាក់ឌុប » ។
ពលរដ្ឋ ១០០ គ្រួសារ នៃ សង្កាត់ ២ ក្នុង ខណ្ឌ ៧មករា បាន ទទួល អំណោយ ពី កាកបាទ ក្រហម កម្ពុជា
លោក ថេង សុថុល នៅក្នុង ពេល ចែក អំណោយ បាន ថ្លែង ដាស់តឿន អ៊ុំ ពូមីង យាយ តា យកចិត្តទុកដាក់ ថែរក្សា សុខភាព និង បញ្ហា អនាម័យ ល្អ ឲ្យបាន គ្រប់ ៗ គ្នា ខណៈ រដូវ នេះ ជា រដូវ រំហើយ ងាយ ប្រឈម នឹង ជំងឺ ផ្តាសាយ ជាពិសេស ជំងឺ គ្រុន ឈាម ។ លោក បាន ណែនាំ នូវ ការប្រកាន់ខ្ជាប់ ការហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត អនាម័យ បរិស្ថាន ល្អ ដែល ជា កត្តា ជា ឆ្ងាយ ពី មេរោគ នានា ។
អំណោយ មនុស្សធម៌ របស់ អនុ សាខា កាកបាទ ក្រហម ខណ្ឌ ៧មករា ដែល បាន ផ្តល់ ជូន ក្នុង មួយ គ្រួសារ រួម មាន៖ អង្ករ ២៥ គីឡូក្រាម . ទឹក បរិសុទ្ធ ១កេស . មី ១កេស . ទឹកត្រី ឬ ទឹកស៊ី អីវ ១យួរ និង ថវិកា ២ម៉ឺន រៀល ក្នុង មួយ គ្រួសារ ដើម្បី សម្រួល ដល់ ជីវភាព ប្រចាំ ថ្ងៃ ផងដែរ ៕ បុរស ចំណាស់ ម្នាក់ មាន ជំងឺ ប្រចាំ កាយ ជីវភាព ខ្វះខាត រស់ នៅ ស្រុក បាណន់ ទទួលបាន អំណោយ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ ដោយ ទទួល ដំណឹង ថា បុរស ចំណាស់ ម្នាក់ មាន ជំងឺ ប្រចាំ កាយ និង មាន នូវ ជីវភាព ខ្វះខាត លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាន ចាត់ តំណាង ឱ្យ នាំយក អំណោយ មនុស្សធម៌ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង ប្រគល់ ជូន បុរស ទុរគត រូប នោះ ដល់ ខ្នង ផ្ទះ នៅ ស្រុក បាណន់ ខេត្ត បាត់ដំបង ។
ការប្រគល់ អំណោយ នេះ ធ្វើឡើង នា រសៀល ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ តាមរយៈ លោក កង ប៊ន អនុប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត និង មន្រ្តី ប្រតិបត្តិ សាខា រួម ជាមួយ ក្រុម កាកបាទ ក្រហម ឃុំ ។
បុរស ចំណាស់ រូប នោះ មាន ឈ្មោះ ហេង អុយ អាយុ ៥២ ឆ្នាំ មាន ជំងឺ ប្រចាំ កាយ ធ្ងន់ធ្ងរ មាន ជីវភាព ខ្វះខាត ខ្លាំង ក្នុង គ្រួសារ មាន សមាជិក ៦នាក់ រស់ នៅ ភូមិ អូរ ពង់ មាន់ ឃុំ តា គ្រាម ស្រុក បាណន់ ខេត្ត បាត់ដំបង ។
ក្នុង ឱកាស នោះ លោក កង ប៊ន បាន នាំយក ប្រសាសន៍ របស់ លោក សុខ លូ ប្រធាន គណៈកម្មាធិការ សាខា ខេត្ត ជាពិសេស សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ក្តីអាណិតអាសូរ និង ការគិតគូរ ពី ជីវភាព រស់ នៅ របស់ ក្រុមគ្រួសារ លោក ហេង អុយ ។
អំណោយ របស់ សាខា ខេត្ត បាន ផ្ដល់ជូន រួម មាន អង្ករ ៥០ គីឡូក្រាម ទឹក បរិសុទ្ធ ៥កេស មី២កេស ត្រីខ២យួរ ទឹកត្រី ២យួរ ទឹកស៊ី អ៉ីវ២យួរ និង ថវិកា មួយ ចំនួន ផងដែរ ៕
សម្ពោធ កុដិ និង សមិទ្ធផល នានា ក្នុង វត្ត តាំង ក្រសាំង ខាងជើង ខណ្ឌ ពោធិ៍សែនជ័យ តម្លៃ ជាង ១៧ម៉ឺន ដុល្លារ . លោក កើត ឆែ៖ សន្តិភាព បាន នាំឲ្យ កម្ពុជា មាន ការអភិវឌ្ឍ ឥត ឈប់ឈរ ទាំង អាណាចក្រ និង ពុទ្ធ ចក្រ
( ភ្នំពេញ ) ៖ លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ បាន ថ្លែង ថា កត្តា សុខ សន្តិភាព បាន នាំឲ្យ កម្ពុជា មាន ការអភិវឌ្ឍ ឥត ឈប់ឈរ ទាំង អាណាចក្រ និង ពុទ្ធ ចក្រ ដែល ប្រជាពលរដ្ឋ ទាំងអស់ សប្បាយរីករាយ និង ប្រាថ្នា ចង់បាន គ្រប់ ៗ គ្នា ។
លោក កើត ឆែ បាន ថ្លែង ដូច្នេះ ក្នុង ឱកាស អញ្ជើញ ជា តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ក្នុង ពិធី សម្ពោធ កុដិ និង សមិទ្ធផល នានា ក្នុង វត្ត តាំង ក្រសាំង ខាងជើង ស្ថិត ក្នុង សង្កាត់ កាកាប ទី២ ខណ្ឌ ពោធិ៍សែនជ័យ ក្រោម អធិបតីភាព លោក កិត្តិសង្គហ បណ្ឌិត ទេព ង ន អនុប្រធាន ទី២ព្រឹទ្ធសភា តំណាង ឲ្យ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ។
លោក បាន បន្ត ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ផ្ដល់ជូន ប្រជាជន ខ្មែរ នូវ សុខ សន្តិភាព ស្ថិរភាព ការបង្រួបបង្រួម ជាតិ ប្រជាធិបតេយ្យ និង មាន ការ បើក ទូលាយ ក្នង ការប្រតិបត្តិ សាសនា ធ្វើឲ្យ ពុទ្ធ បរិស័ទ ទាំង នៅ រាជធានី ភ្នំពេញ និង តាម បណ្តា ខេត្ត នានា រស់ នៅ យ៉ាង សុខដុមរមនា ហើយ សមិទ្ធផល ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត វត្ត អារាម និង កន្លែង សក្ការៈបូជា នានា ត្រូវបាន កសាងឡើង ជា បន្តបន្ទាប់ ត្រប់ ទិសទី ពាសពេញ ផ្ទៃ ប្រទេស ។
លោក បាន បន្ត ថា សមិទ្ធផល ទាំងឡាយ ដែល ត្រូវបាន កសាងឡើង ក្នុង ទី វត្តតាំង ក្រសាំង ខាងជើង នា ពេលនេះ គឺ បាន កើត ចេញ ពី មនុញ្ញ ផល នៃ « សន្តិភាព និង ការអភិវឌ្ឍ ជាតិ មាតុភូមិ » ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន តាមរយៈ កម្លាំង មហាសាមគ្គី របស់ រាជ រដ្ឋាភិបាល អាជ្ញាធរដែនដី ព្រះសង្ឃ លោកយាយ លោក តា ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត បងប្អូន ប្រជាពលរដ្ឋ ព្រមទាំង សប្បុរសជន ទាំង ក្នុង និង ក្រៅ ប្រទេស ដើម្បី ទ្រទ្រង់ លើកស្ទួយ វិស័យ ពុទ្ធសាសនា ។
លោក ថា « សន្តិភាព » គឺជា កត្តា សារវន្ត និង មាន តម្លៃ មិន អាច កាត់ថ្លៃ បាន ហើយ ប្រសិនបើ ប្រទេសជាតិ របស់ យើង គ្មាន សុខ សន្តិភាព គ្មាន ការបង្រួបបង្រួម ជាតិ និង គ្មាន ការអភិវឌ្ឍ ម៉្លេះសម សមិទ្ធផល ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត វត្ត អារាម និង ទីកន្លែង សក្ការៈបូជា គ្រប់ ទិសទី ពាសពេញ ផ្ទៃ ប្រទេស ពិតជា មិន អាច កសាងឡើង ជាបន្ត បន្ទាប់ ច្រើន អនេក ដូច សព្វ ថ្ងៃ នេះ ឡើយ ។
នៅក្នុង ឱកាស នោះ លោក កិត្តិសង្គហ បណ្ឌិត ទេព ង ន បាន លើកឡើង ថា ការរីកចម្រើន ផ្នែក អាណាចក្រ និង ពុទ្ធ ចក្រ គួ ជា ទី មោទនៈ ដោយ ធានា បាន សុខដុមនីយកម្ម រវាង សាសនា ទាំងអស់ ក្នុង ប្រទេស កម្ពុជា ហើយ គ្មាន ការរើសអើង និង គ្មាន ជម្លោះ សាសនា ។ ដោយឡែក ការរីកចម្រើន ឥត ឈប់ឈរ ក្នុង វិស័យ ពុទ្ធសាសនា ដែល ជា សាសនា របស់ រដ្ឋ គឺ បាន កើត ចេញ អំពី ជំនឿ ដ៏ ជ្រះថ្លា និង មោះ មុត របស់ ពុទ្ធ សាសនិក កម្ពុជា នៅ ទូទាំង ប្រទេស និង ក្រៅ ប្រទេស ។
លោក បាន បន្ត ថា ការរីកចម្តើន ផ្នែក វិស័យ ពុទ្ធសាសនា គឺ បាន រួមចំណែក ដ៏ សំខាន់ ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម តាមរយៈ ការអប់រំ ការអភិវឌ្ឍ ធនធាន មនុស្ស និង បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការលើកកម្ពស់ ការអភិរក្ស វប្បធម៌ សន្តិភាព សាមគ្គីភាព និង មិត្តភាព ដែល ជា មាគ៌ា ដ៏ ប្រពៃ នាំឲ្យ សម្រេច គោលដៅ សង្គម គឺ បំបាត់ អំពើហិង្សា ប្រទូស្តរាយ ការប្រព្រឹត្តិ អំពើ ទុច្ចរិត និង អនាចារ្យ ផ្សេង ២។
សូម បញ្ជាក់ ថា សមិទ្ធផល នានា ដែល ត្រូវ សម្ពោធ ឆ្លង នា ពេលនេះ គឺ មាន កុដិ ថ្មី ១ខ្នង មាន ទំហំ ១២ម៉ែត្រ គុណ នឹង ១៤ម៉ែត្រ ជាន់ ផ្ទាល់ ដី ដែល អគារ នេះ បាន បញ្ចុះ បឋមសិលា សាងសង់ កាលពី ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ និង បាន បញ្ចប់ ការសាងសង់ ជា ស្ថាបពរ នៅ ថ្ងៃទី ១៨ ខែមីនា ឆ្នាំ ២០២១ ដោយ បានជា វ ពុទ្ធ បដិមា ថ្ម កែវ ចំនួន ២៨ អង្គ ទុក ជា ទី សក្ការៈបូជា សរុប ចំណាយ បច្ច័យ កសាង អស់ ចំនួន ១៧៣. ៦១៤ ដុល្លារ ។
ការបញ្ជាក់ ឲ្យដឹង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក តឹករ៉េត សំរេច អញ្ជើញ ក្នុង កម្មវិធី ជួបជុំ ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ ពី កិច្ចសហប្រតិបត្ដិការ របស់ ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ កម្ពុជា អង្គរ អ៊ែរ សម្រាប់ ពេល ឆ្នាំ ២០២៣ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ភ្នាក់ងារ ទេសចរណ៍ សំខាន់ ៗ ។ ការជួបជុំ នេះ ធ្វើឡើង នា សណ្ឋាគារ កាំបូឌីយ៉ាណា នា យប់ ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ ។
លោក តឹករ៉េត សំរេច បាន ថ្លែង ថា រយៈពេល ដ៏ លំបាក បំផុត សម្រាប់ ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ កម្ពុជា អង្គរ អ៊ែរ របស់ យើង បាន ឈានដល់ ទី បញ្ចប់ ហើយ យើង កំពុងតែ សម្លឹង ឆ្ពោះ ទៅកាន់ អនាគត ដ៏ ត្រចះត្រចង់ ការរីកចម្រើន កាន់តែ លឿន និង ពង្រីក ការហោះហើរ បន្ថែម ដោយ នាំយក នូវ វប្បធម៌ និង អរិយធម៌ ខ្មែរ ទៅកាន់ ពិភពលោក ។
ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ កម្ពុជា អង្គរ អ៊ែរ បាន បន្ថែម ជើងហោះហើរ ជាច្រើន ទៅកាន់ ខេត្ត សៀមរាប ខេត្ត ព្រះសីហនុ ទីក្រុង ហូជីមិញ ទីក្រុង ដាណាំង រាជធានី ហាណូយ នៃ ប្រទេស វៀតណាម និង ទីក្រុង ចិន ចូវ ទីក្រុង ណាន នីង នៃ ប្រទេស ចិន ។ ឆ្នាំ ២០២២ នេះ ក្រុមហ៊ុន អាកាសចរណ៍ ជាតិ កម្ពុជា អង្គរ អ៊ែរ រំពឹង ថា នឹង ដឹក អ្នកដំណើរ បាន ចំនួន ២១៤.០០០ នាក់ ។
វិមាន ក្រឹមឡាំង៖ លោក ពូទីន ផ្ដល់ មូលដ្ឋាន វាយតម្លៃ ពី សង្រ្គាម នៅ អ៊ុយក្រែន ឱ្យ លោក ម៉ូឌី
ដោយឡែក សារព័ត៌មាន ឥណ្ឌា ANI ដោយ ផ្អែក លើ ការស្រង់ សម្ដី ពី ការិយាល័យ លោក ម៉ូឌី បាន រាយការណ៍ ថា នៅក្នុង ជំនួប តាម ទូរស័ព្ទ ជាមួយ លោក ពូទីន លោក ម៉ូឌី បាន បញ្ជាក់ ឡើងវិញ ពី ការអំពាវនាវ របស់ លោក ឱ្យ មាន កិច្ចសន្ទនា និង ផ្លូវការ ទូត ដែល លោក ផ្ទាល់ យល់ ថា ជា មធ្យោបាយ តែ មួយ គត់ ដើម្បី ដោះស្រាយ ជម្លោះ បច្ចុប្បន្ន នៅ អ៊ុយក្រែន ។
គួរ បញ្ជាក់ ថា កាលពី ខែកញ្ញា កន្លងទៅ នៅឯ កិច្ចប្រជុំ អង្គការ កិច្ចសហប្រតិបត្តិការ សៀង ហៃ លោក ម៉ូឌី ធ្លាប់ បាន ប្រាប់ លោក ពូទីន ម្ដង រួច មកហើយ ថា សព្វ ថ្ងៃ មិន មែន ជា យុគសម័យ ត្រូវ ធ្វើ សង្រ្គាម នោះ ទេ ៕
អំណោយ របស់ លោក ហ៊ុន ម៉ានិត ត្រូវបាន យក ទៅ ប្រគល់ ជូន ពលរដ្ឋ ៧គ្រួសារ នៅ ឃុំ អារក្ស ត្នោត ស្រុក ស្ទឹងត្រង់
( កំពង់ចាម ) ៖ នៅ ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ នេះ លោក ហេង វុទ្ធី អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ស្រុក ស្ទឹងត្រង់ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ អារក្ស ត្នោត ព្រមទាំង សហការី បាន ចុះ ដល់ មូលដ្ឋាន ភូមិ គីឡូ៧ ឃុំ អារក្ស ត្នោត ស្រុក ស្ទឹងត្រង់ ដើម្បី នាំយក អំណោយ របស់ លោក ហ៊ុន ម៉ានិត ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ស្ទឹងត្រង់ ចំនួន ០៧ គ្រួសារ ។
បន្ថែម ពីលើ នេះ លោក ហេង វុទ្ធី និង ក្រុមការងារ បាន ឧបត្ថម្ភ ថវិការ ចំនួន ១.០០០.០០០ រៀល ជូន ដល់ អ្នកសង្កេតការណ៍ ការពិនិត្យ និង ចុះឈ្មោះ បោះឆ្នោត និង បាន ឧបត្ថម្ភ អង្ករ ចំនួន ០២ បេ ស្មើនឹង ១០០ គីឡូក្រាម និង ថវិកា ចំនួន ២៥០.០០០ រៀល ជូន ដល់ វិហារ ឥស្លាម សម្រាប់ ចិញ្ចឹម ចលនា បក្ស ។
ក្នុង ឱកាស នោះ លោក ហេង វុទ្ធី និង សហការី ក៏ បាន ចុះ សាកសួរ សុខទុក្ខ សមាជិក គណបក្ស តាម ខ្នង ផ្ទះ . ពង្រឹង ការធ្វើ បច្ចុប្បន្នភាព សមាជិក បក្ស ឲ្យបាន ល្អ ប្រសើរ . ពិនិត្យមើល អត្តសញ្ញាណប័ណ្ណ សមាជិក ដែល ហួស សុពលភាព ត្រូវ ប្តូរ ថ្មី សម្រាប់ ត្រៀម បោះឆ្នោត នា ពេល ខាងមុខ និង ពិនិត្យមើល ការកសាង សមាជិក បក្ស ថ្មី ផងដែរ ៕ សាលារៀន ចំនួន ៤ ក្នុង ខេត្ត សៀមរាប ជាប់ ជា សាលា គំរូ ខាង ផ្នែក ផ្តល់ សេវា សាធារណៈ ទាក់ទង នឹង វិស័យ អប់រំ
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប មន្ទីរ អប់រំ យុវជន និង កីឡា . មន្ទីរ មុខងារ សាធាណរៈ និង ស្ថាប័ន ពាក់ព័ន្ធ បាន វាយតម្លៃ និង ផ្តល់ ពិន្ទុ ដល់ សាលារៀន ចំនួន ៤ ក្នុង ខេត្ត សៀមរាប ជាប់ ជា សាលា គំរូ ខាង ផ្នែក ផ្តល់ សេវា សាធារណៈ ទាក់ទង នឹង វិស័យ អប់រំ ក្នុង ចំណោម សាលារៀន ជិត៣០ នៅក្នុង ខេត្ត ដែល នឹង ត្រៀម ចូលរួម ប្រកួតប្រជែង ថ្នាក់ ជាតិ ខាងមុខ នេះ ។
លោក លី ប៊ុណ្ណា បាន បន្ត ថា កាលពី ឆ្នាំ កន្លងទៅ ការវាយ សាលា គំរូ ខាង ផ្នែក ផ្តល់ សេវា សាធារណ: ទាក់ទង នឹង វិស័យ អប់រំ គឺ រៀបចំ ធ្វើ តែ នៅ វិទ្យាល័យ ប៉ុណ្ណោះ ហើយ វិទ្យ ល័យ ចំនួន ២ នៅក្នុង ខេត្ត សៀមរាប ក៏ បាន ជាប់ ជា វិទ្យាល័យ គំរូ ផងដែរ ក្នុង នោះ មាន៖ វិទ្យ ល័យ ពួក និង វិទ្យ ល័យ ហ៊ុន សែន ប្រាសាទ បាគង ។
លោក លី ប៊ុណ្ណា បាន បន្ត ទៀត ថា ចំពោះ ការវាយតម្លៃ និង ផ្ដល់ ពិន្ទុ ដល់ សាលារៀន គំរូ ទាំងនេះ គឺ មាន ការចូលរួម ពី អាជ្ញាធរ ខេត្ដ មន្ទីរ អប់រំ យុវជន និង កីឡា មន្ទីរ មុខងារ សាធារណ: និង ស្ថាប័ន ពាក់ព័ន្ធ ដោយ បាន ចុះ ទៅ ពិនិត្យ នៅ តាម សាលា នីមួយ ៗ ដោយ ផ្ទាល់ ដើម្បី ធ្វើ ការវាយតម្លៃ និង ផ្ដល់ ពិន្ទុ ផងដែរ ។
ជាមួយ នេះ ដែរ លោក លី ប៊ុណ្ណា ក៏ រំពឹង ថា សាលារៀន ទាំង៤ នេះ នឹង ទទួលបាន លទ្ធផល ល្អ ក្នុង ការប្រកួត ថ្នាក់ ជាតិ នា ពេល ខាងមុខ សម្រាប់ ការវាយតម្លៃ ជា សាលា គំរូ ផ្នែក សេវា សាធារណ: សម្រាប់ វិស័យ អប់រំ នៅ ទូទាំង ប្រទេស ផងដែរ ៕
ទេសរដ្ឋមន្ត្រី អៀង មូលី៖ « វិបត្តិ សកលលោក បាន ធ្វើឲ្យ វឌ្ឍនភាព នៃ ការប្រយុទ្ធ នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ បន្ត ធ្លាក់ចុះ ខណៈ មនុស្ស រាប់ លាន នាក់ ប្រឈម នឹង ហានិភ័យ »
ការឆ្លើយតប នឹង មេរោគ អេដស៍ ជា សាកល ក្នុង រយៈពេល ជាង ពីរ ឆ្នាំ ចុងក្រោយ នៃ បរិបទ កូវីដ - ១៩ រួម នឹង វិបត្តិ សកលលោក ផ្សេង ទៀត ដូចជា សង្គ្រាម រុស្សី - អ៊ុយក្រែន បាន ធ្វើឲ្យ វឌ្ឍនភាព នៃ ការប្រយុទ្ធ នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ បន្ត ធ្លាក់ចុះ ហើយ មនុស្ស រាប់ លាន នាក់ ត្រូវ ប្រឈម នឹង ហានិភ័យ ធ្វើឲ្យ ការឆ្លើយតប នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ កំពុង ស្ថិត ក្នុង ស្ថានភាព គ្រោះថ្នាក់ ។
លោក ទេសរដ្ឋមន្ត្រី បាន ថ្លែង បញ្ជាក់ ទៀត ថា ទិន្នន័យ ពី អង្គការ សហ ប្រជាជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ របស់ ពិភពលោក (UNAIDS) បាន បង្ហាញ ថា ការឆ្លើយតប នឹង មេរោគ អេដស៍ ជា សាកល ក្នុង រយៈពេល ជាង ពីរ ឆ្នាំ ចុងក្រោយ នៃ បរិបទ កូវីដ - ១៩ រួម នឹង វិបត្តិ សកលលោក ផ្សេង ទៀត ដូចជា សង្គ្រាម រុស្សី - អ៊ុយក្រែន បាន ធ្វើឲ្យ វឌ្ឍនភាព នៃ ការប្រយុទ្ធ នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ បន្ត ធ្លាក់ចុះ ហើយ មនុស្ស រាប់ លាន នាក់ ត្រូវ ប្រឈម នឹង ហានិភ័យ ។
ក្នុង ឱកាស នោះ ក្នុង ដំណើរ ឆ្ពោះទៅ លុបបំបាត់ ការឆ្លង រីករាលដាល មេរោគ អេដស៍ នៅ ឆ្នាំ ២០២៥ ដោយ ជោគជ័យ ក្នុង ឋានៈ ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ លោក ទេសរដ្ឋមន្ត្រី បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ កម្ពុជា ទាំងអស់ ចូលរួម ប្តេជ្ញាចិត្ត ដ៏ មោះ មុត ជាមួយ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ដូច ខាងក្រោម៖
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៨. ៣៧៩ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ១៨៥ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត បាត់ដំបង ប្រកាស សមាសភាព ក្រុមការងារ បក្ស ចុះ ជួយ សង្កាត់ និង ភូមិ ទាំង៥ ក្នុង សង្កាត់ ចំការសំរោង ក្រុង បាត់ដំបង
( បាត់ដំបង ) ៖ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត បាត់ដំបង បាន ប្រកាស សមាសភាព ក្រុមការងារ គណបក្ស ចុះ ជួយ សង្កាត់ ចំការសំរោង និង សមាសភាព ក្រុមការងារ ចុុះ តាម ភូមិ ទាំង៥ ក្នុង សង្កាត់ ចំការសំរោង ក្រុង បាត់ដំបង ដើម្បី រៀបចំ រចនាសម្ព័ន្ធ មុនដំណើរ បោះឆ្នោត ជ្រើង រើស តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ខាងមុខ ។
លោកស្រី កែវ ដាណា ក៏ បាន ផ្តាំផ្ញើ ដល់ អស់ លោក លោកស្រី ដែល មាន ឈ្មោះ ក្នុង សេចក្តីសម្រេច នេះ សូម យកចិត្តទុកដាក់ អនុវត្ត ការងារ ដែល គណបក្ស បាន ប្រគល់ ជូន ដើម្បី បំរើ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន របស់ ខ្លួន ទទួលខុសត្រូវ និង ត្រូវ សហការ គ្នា ជាមួយ ប្រធានបក្ស សង្កាត់ បក្ស ភូមិ សកម្មជន បក្ស សមាជិក បក្ស ឱ្យ បាន ល្អ ប្រសើ ។
លោកស្រី បាន ថ្លែង ថា ការប្រគល់ ភារកិច្ច ជូន ក្រុមការងារ នា ពេលនេះ គឺ ដើម្បី ពង្រឹង ការងារ បក្ស ពិសេស ចុះ ត្រួតពិនិត្យមើល ប្រជាពលរដ្ឋ នៅ តាម ខ្នង ផ្ទះ ដែល ជា សមាជិក បក្ស នូវ ជីវភាព រស់ នៅ របស់ ពួកគាត់ និង សមាជិក បក្ស ចាស់ ណា ដែល កំពុង ជួប ការលំបាក ត្រូវ ជួយ គាត់ ឱ្យ បាន ទាន់ ពេលវេលា និង ឆ្លើយតប តាម សំណូមពរ របស់ ពួកគាត់ ។
សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស សភា តំណាងរាស្រ្ត នីតិកាល ទី កាល ទី៧ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដើម្បី ទទួលបាន ជ័យជំនះ ជូន គណបក្ស ប្រជាជន ដែល មាន សម្តេច ជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី បន្ត ដឹកនាំ ប្រទេស ឆ្ពោះ ទៅការកសាង និង អភិវឌ្ឍ ជាតិ យើង កាន់តែ រីកចម្រើន ខ្លាំង និង ជឿនលឿន បាន រក្សា មរតក នេះ ទុក ជូន សម្រាប់ យុវជន បន្ត វេណ និង ប្រជាជន ជំនាន់ ក្រោយ ផងដែរ ៕
លោក ឡេង ប៉េង ឡុង ណែនាំ ដល់ ក្រុមការងារ ចុះ ជួយ សង្កាត់ វត្ត គរ បន្ត ពង្រឹង សេវា សាធារណៈ និង ដោះស្រាយ សំណូមពរ របស់ ពលរដ្ឋ ឱ្យ មាន ប្រសិទ្ធភាព
( បាត់ដំបង ) ៖ លោក ឡេង ប៉េង ឡុង សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ មុលដ្ឋាន សង្កាត់ វត្ត គរ និង សង្កាត់ អូរម៉ាល់ បាន ណែនាំ និង ក្រើន រំឮក ដល់ ថ្នាក់ដឹកនាំ និង អ្នក ពាក់ព័ន្ធ ចុះ ជួយ សង្កាត់ វត្ត គរ ក្រុង បាត់ដំបង ត្រូវ បន្ត ពង្រឹង សេវា សាធារណៈ និង បន្ត រួមគ្នា ដោះស្រាយ សំណើ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
ការណែនាំ បែប នេះ របស់ លោក ឡេង ប៉េង ឡុង បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ ក្រុមការងារ បើក កិច្ចប្រជុំ ដើម្បី ដោះស្រាយ សំណើ សំណូមពរ បញ្ហា ប្រឈម នានា របស់ ប្រជាពលរដ្ឋ នៅ ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ នៅ សង្កាត់ វត្ត គរ ក្រុង បាត់ដំបង ។
ក្រោយពី ស្តាប់ ការលើកឡើង របស់ ភូមិ និមួយ ៗ រួច មក លោក ឡេង ប៉េង ឡុងបាន ថ្លែង ថា បញ្ហា ប្រឈម របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន គឺជា បញ្ហា របស់ យើង ជា ថ្នាក់ដឹកនាំ ដែល តម្រូវ ឱ្យ យើង រួមគ្នា បន្ត ដោះស្រាយ ដើម្បី ភាពសុខដុមរមនា ភាព សុខសាន្ត និង ការអភិវឌ្ឍ មូលដ្ឋាន មាន ការរីកចម្រើន ទៅ មុខ ។
ជាមួយគ្នា នេះ លោក ឡេង ប៉េង ឡុង មិន ភ្លេច ថ្លែងអំណរគុណ ដល់ ក្រុមការងារ ទាំងអស់ ដែល បាន ខិតខំ បំពេញ តួនាទី របស់ ខ្លួន រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ធ្វើ ការដោះស្រាយ រាល់ បញ្ហា ប្រឈម សំណើ សំណូមពរ របស់ ប្រជាពលរដ្ឋ នា ពេល កន្លងមក និង សូម បន្ត ការងារ ដោះស្រាយ របស់ យើង ជាបន្ត ទៀត ឆ្ពោះទៅ ប្រជាពលរដ្ឋ ម្នាក់ សន្លឹក ឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន មួយ សន្លឹក ៕
ហេតុការណ៍ ខាងលើ បាន កើតឡើង ក្នុង រដ្ឋ សេឡាន់ ហ្គ័រ (Selangor) នៅ ជាយ ទីក្រុង គូឡាឡាំពួ នា វេលា មុន ម៉ោង ៣រំលង អធ្រាត្រ ឈានចូល ថ្ងៃសុក្រ នេះ ហើយ ត្រូវ ចំ តំបន់ កសិដ្ឋាន សម្រាប់ បោះជំរំកម្សាន្ត មួយ កន្លែង ដែល ស្ថិត នៅក្រោម ជម្រាល ភ្នំ ។ អាជ្ញាធរ ម៉ាឡេស៉ី បាន ឱ្យដឹង ថា មនុស្ស ជាង ៩០ នាក់ បាន រងគ្រោះ ក្នុង ហេតុការណ៍ ប៉ុន្តែ ៦១ នាក់ ត្រូវបាន រកឃើញ និង មួយចំនួន ទៀត នៅ បន្ត បាត់ខ្លួន ។
កសិដ្ឋាន ខាងលើ ដែល មិន មាន អាជ្ញាប័ណ្ណ រៀបចំ ការបោះជំរំកម្សាន្ត អាចនឹង រង ការពិភ័យ ប្រសិនបើ រង ឃើញ ថា បាន បំពាន ច្បាប់ ណាមួយ ហើយ រដ្ឋាភិបាល ម៉ាឡេស៉ី ក៏ បាន ប្រកាស ដែរ ពី ការផ្ដល់ ជំនួយ ហិរញ្ញវត្ថុ សម្រាប់ ក្រុមគ្រួសារ អ្នក ដែល បាន ស្លាប់ និង រងរបួស ក្នុង សោកនាដកម្ម នេះ ។
គួរ បញ្ជាក់ ថា គ្រោះ រអិល បាក់ ដី នៅក្នុង ប្រទេស ម៉ាឡេស៉ី តែងតែ កើតឡើង ជាញឹញាប់ ក្រោយ មាន ភ្លៀង ធ្លាក់ ខ្លាំង ដែល ជាទូទៅ នៅ ដំណាច់ ឆ្នាំ ។ ប៉ុន្តែ មិន មាន ភ្លៀង ធ្លាក់ ខ្លាំង ឬ គ្រោះ រញ្ជួយ ដី ត្រូវបាន រាយការណ៍ នៅពេល មាន គ្រោះ រអិល បាក់ ដី កើតឡើង នោះ ទេ ៕
( កូឡុំ បូ) ៖ សេដ្ឋកិច្ច របស់ ប្រទេស ស្រីលង្កា បាន ធ្លាក់ចុះ ១១.៨ភាគរយ នៅក្នុង ត្រីមាស ទី៣ ឆ្នាំ ២០២២ ធៀប នឹង រយៈពេល ដូចគ្នា នៅ ឆ្នាំ មុន ដែល ជា ការធ្លាក់ចុះ ប្រចាំ ត្រីមាស ខ្លាំង បំផុត ទី ពីរ មិន ធ្លាប់ មាន សម្រាប់ ប្រទេស ដែល ឆ្លងកាត់ វិបត្តិ ហិរញ្ញវត្ថុ ធ្ងន់ធ្ងរ នេះ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ។
ការគ្រប់គ្រង សេដ្ឋកិច្ច មិន ត្រឹមត្រូវ និង ផល ប៉ះពាល់ នៃ ជំងឺ រាតត្បាត កូវីដ - ១៩ បាន ធ្វើឱ្យ ប្រទេស ស្រីលង្កា ខ្វះខាត ប្រាក់ ដុល្លារ សម្រាប់ ការនាំចូល ទំនិញ សំខាន់ ៗ ដូចជា ម្ហូប អាហារ ប្រេងឥន្ធនៈ ជី និង ថ្នាំ ពេទ្យ ជាដើម ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ ទិន្នន័យ ដែល បាន ចេញផ្សាយ ដោយ នាយកដ្ឋាន ជំរឿន និង ស្ថិតិ ស្រីលង្កា នៅ ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ ថា វិស័យ កសិកម្ម បាន ធ្លាក់ចុះ ៨.៧ភាគរយ នៅក្នុង ត្រីមាស ទី៣ ហើយ ឧស្សាហកម្ម ធ្លាក់ចុះ ២១.២ភាគរយ ខណៈ ដែល សេវាកម្ម បាន ធ្លាក់ចុះ ២.៦ភាគរយ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ មុន ។
លោក មានប្រសាសន៍ ថា៖ « ការព្យាករ របស់ យើង គឺ ថា វា នឹង កាន់តែ អាក្រក់ ប្រហែលជា ការធ្លាក់ចុះ ប្រហែល ២០ ភាគរយ ប៉ុន្តែ ឥឡូវនេះ ការធ្លាក់ សរុប សម្រាប់ ឆ្នាំ នេះ អាច មាន ប្រហែល ៩ ភាគរយ » ។
ធនាគារ កណ្តាល របស់ ប្រទេស ស្រីលង្កា បាន ប៉ាន់ប្រមាណ ថា សេដ្ឋកិច្ច អាច ធ្លាក់ចុះ ប្រហែល ៨ ភាគរយ នៅ ឆ្នាំ ២០២២ នេះ ។
យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ រដ្ឋាភិបាល ស្រីលង្កា បាន ឱ្យដឹង ថា កត្តា ជាច្រើន រួម មាន អតិផរណា ខ្ពស់ ការដាច់ចរន្ត អគ្គិសនី អត្រា ការប្រាក់ ខ្ពស់ កង្វះ ការនាំចូល និង កង្វះ ប្រេងឥន្ធនៈ និង ជី បាន ជះ ឥទ្ធិពល ដល់ កំណើន សេដ្ឋកិច្ច ក្នុង ត្រី មាស ចុងក្រោយ ។
រដ្ឋាភិបាល បាន ឱ្យដឹង ថា៖ « ការថយចុះ តម្រូវការទំនិញ និង សេវាកម្ម សំខាន់ ៗ និង មិន សំខាន់ ដោយសារ ការថយចុះ ប្រាក់ ចំណូល ពិត របស់ ប្រជាជន បាន នាំឱ្យ សេដ្ឋកិច្ច ដើរ ឆ្ពោះ ទៅរក ការធ្លាក់ចុះ នេះ »៕
សហភាព អឺរ៉ុប ចង់ តភ្ជាប់ ឡើងវិញ ជាមួយ តំបន់ អាស៊ី អាគ្នេយ៍ ក្នុង គ្រា កើតមាន សង្រ្គាម នៅ អ៊ុយក្រែន
( ព្រុច សែល ) ៖ មេដឹកនាំ សហភាព អឺរ៉ុប (EU) បាន ជួប ជាមួយ សមភាគី របស់ ខ្លួន មកពី ប្រទេស ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ សម្រាប់ កិច្ចប្រជុំ កំពូល មួយ នៅ ទីក្រុង ព្រុច សែល នៅ ថ្ងៃពុធ សប្តាហ៍ នេះ ដោយ សម្លឹង ឆ្ពោះ ទៅរក ការពង្រឹង ទំនាក់ទំនង នឹង គ្នា ក្នុង គ្រា មាន សង្គ្រាម នៅ អ៊ុយក្រែន និង ការប្រឈម ពី ប្រទេស ចិន ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន AFP ។
អឺរ៉ុប មាន បំណង ជំរុញ ពាណិជ្ជកម្ម ជាមួយ សមាគម ប្រជាជាតិ អាស៊ី អាគ្នេយ៍ ( អាស៊ាន ) ដែល ជា តំបន់ មួយ ដែល ប្រមូលផ្តុំ ដោយ ប្រទេស មាន សេដ្ឋកិច្ច លូតលាស់ លឿន បំផុត មួយចំនួន របស់ ពិភពលោក ។
សហភាព អឺរ៉ុប បាន និង កំពុង ជំរុញ ផ្នែក ការទូត ដើម្បី ជំរុញ ពិភពលោក ឱ្យ ប្រឆាំង នឹង ទីក្រុង មូស្គូ ខណៈ ដែល ការលុកលុយ របស់ រុស្ស៊ី បាន បង្ក មាន ផល ប៉ះពាល់ ផ្នែក សេដ្ឋកិច្ច និង នយោបាយ ជុំវិញ ពិភពលោក ។
ប៉ុន្តែ ប្រទេស ទាំង១០ របស់ អាស៊ាន បាន បែកបាក់ គ្នា ក្នុង ការឆ្លើយតប ទៅនឹង សង្គ្រាម របស់ វិមាន ក្រឹមឡាំង លើ ប្រទេស អ៊ុយក្រែន ដោយ ប្រទេស ខ្លះ ប្រឆាំង នឹង ការឈ្លានពាន របស់ រុស្ស៊ី និង ខ្លះ ទៀត រក្សា ភាពអព្យាក្រឹត ។
ខណៈ ដែល អឺរ៉ុប ដាក់ សម្ពាធ ឱ្យ មាន ការឆ្លើយតប កាន់តែ តឹងរ៉ឹង ចំពោះ រុស្ស៊ី មាន ប្រទេស មហា អំណាច ពិភពលោក មួយ ទៀត កំពុង បង្ក ភាពអាប់ អួរ ក្នុង កិច្ចប្រជុំ កំពូល នេះ ។
ការទាមទារ របស់ ចិន ទៅ លើ សមុទ្រ ចិន ខាងត្បូង បាន បង្កឱ្យ មាន ប៉ះទង្គិច គ្នា ជាមួយ ប្រទេស ជិតខាង មួយចំនួន របស់ ខ្លួន និង បង្កឱ្យ មាន ការភ័យខ្លាច នៅ អឺរ៉ុប ជុំវិញ លំហូរ ពាណិជ្ជកម្ម តាមរយៈ ផ្លូវ ពាណិជ្ជកម្ម ពិភពលោក ដ៏ សំខាន់ មួយ នេះ ។
ប៉ុន្តែ ប្រទេស ចិន នៅតែ ជា ដៃគូ ពាណិជ្ជកម្ម ដ៏ ធំ បំផុត សម្រាប់ អាស៊ាន ហើយ ប្រទេស ជាច្រើន នៅក្នុង តំបន់ មាន ការប្រុងប្រយ័ត្ន ក្នុង ការងាកចេញ ឆ្ងាយ ពី ប្រទេស ជិតខាង ដ៏ ធំ របស់ ពួកគេ មួយ នេះ ។
យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន AFP សហភាព អឺរ៉ុប មាន បំណង ចង់ ក្លាយ ខ្លួន ជា ដៃគូ ដែល អាច ទុកចិត្ត បាន សម្រាប់ សេដ្ឋកិច្ច ប្រកបដោយ ថាមពល នៅ អាស៊ី អាគ្នេយ៍ ក្នុង គ្រា ដែល មាន ការប្រកួតប្រជែង កាន់តែ ខ្លាំង ឡើង រវាង ទីក្រុង ប៉េកាំង និង ទីក្រុង វ៉ាស៊ីនតោន ។
សហភាព អឺរ៉ុប និង អាស៊ាន គឺជា ដៃគូ ពាណិជ្ជកម្ម ធំ ទី៣ របស់ គ្នា ទៅ វិញ ទៅ មក ហើយ អឺរ៉ុប មើលឃើញ ថា តំបន់ នេះ ជា ប្រភព សំខាន់ សម្រាប់ វត្ថុធាតុ ដើម និង ចង់ បង្កើន លទ្ធភាព ចូល ទៅកាន់ ទីផ្សារ ដែល កំពុង រីកចម្រើន នានា របស់ ខ្លួន នៅក្នុង តំបន់ នេះ ។
បណ្តា ប្រទេស សហភាព អឺរ៉ុប កំពុង ជំរុញ ឆ្ពោះ ទៅរក ការធ្វើ ពិពិធកម្ម ខ្សែ ចង្វាក់ ផ្គត់ផ្គង់ សំខាន់ ៗ ឱ្យ ងាក ឆ្ងាយ ពី ប្រទេស ចិន ខណៈ ដែល សង្រ្គាម នៅ អ៊ុយក្រែន បាន បង្ហាញ ពី ភាពងាយ រងគ្រោះ របស់ អឺរ៉ុប ។
អាស៊ាន និង សហភាព អឺរ៉ុប បាន ផ្អាក ការជំរុញ របស់ ខ្លួន ក្នុង ការសម្រេច កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម រួមគ្នា មួយ កាលពី ជាង មួយ ទសវត្សរ៍ មុន ហើយ ទីក្រុង ព្រុច សែល បាន ផ្តោត លើ កិច្ចព្រមព្រៀង ដ៏ ទាក់ទាញ ជាមួយ សមាជិក នីមួយ ៗ របស់ អាស៊ាន ។
រហូតមកដល់ ពេលនេះ កិច្ចព្រមព្រៀង ជាមួយ ប្រទេស វៀតណាម និង សិង្ហបុរី កំពុង អនុវត្ត ប៉ុន្តែ សហភាព អឺរ៉ុប មាន បំណង ពន្លឿន ការបង្កើត កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ជាមួយ ប្រទេស ឥណ្ឌូណេស៊ី ដែល ជា ប្រទេស មាន សេដ្ឋកិច្ច ធំ ជាង គេ នៅ អាស៊ាន ហើយ នឹង បន្ត ការចរចា ជាមួយ ម៉ាឡេស៊ី ហ្វីលីពីន និង ថៃ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន AFP ៕
សមត្ថកិច្ច កម្ពុជា បន្ត ទទួលបាន បណ្តឹង ៥ទៀត ដែល ស្នើ ឱ្យ ជួយសង្គ្រោះ ជនជាតិ បរទេស ៩នាក់
បើ តាម អ្នកនាំពាក្យ បច្ចុប្បន្នភាព ស្រាវជ្រាវ តាម បញ្ជី តាមដាន គិត ត្រឹម ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២២ រួម មាន៖
១៖ សំណើ ក្នុង បញ្ជី តាមដាន របស់ សម្តេច ក្រឡាហោម សរុប ៦៤៥៤ ករណី មាន មនុស្ស ១. ៥៨២ នាក់ ២៖ បាន ស្រាវជ្រាវ ស៊ើបអង្កេត បឋម ៤១៨ សំណើ និង បិទ សំណុំរឿង ២១៤ សំណើ ( រកឃើញ មនុស្ស ៩៩៥ នាក់ . ឃាត់ខ្លួន ជនសង្ស័យ ១២០ នាក់ . បិទ ក្រុមហ៊ុន ៥ទីតាំង . និង ផ្អាក អាជីវកម្ម ក៏ ដូចជា ស្រាវជ្រាវ ក្រុមហ៊ុន ៤ទីតាំង ) ៣៖ កំពុង បន្ត បើក ប្រតិបត្តិការ ស្រាវជ្រាវ និង ស៊ើបអង្កេត ២២ករណី ។
អ្នក ឧកញ៉ា សុខ គង់៖ ពុទ្ឋ បរិស័ទ ជាតិ - អន្តរជាតិ អាច ចូលរួម ចាប់ មគ្គផល លើ ការកសាង ពុទ្ឋ បដិមា កំពស់ ១០៨ ម៉ែត្រ
( កំពត ) ៖ អ្នក ឧកញ៉ា សុខ គង់ ប្រធាន ក្រុមហ៊ុន សុខា អូតែល បាន អំពាវនាវ ដល់ ពុទ្ឋ បរិស័ទ ខ្មែរ ក្នុង និង ក្រៅ ប្រទេស ចូលរួម វិភាគទាន ចាប់ មគ្គផល ដើម្បី ចូលរួម សាងសង់ ពុទ្ឋ បដិមា ខ្ពស់ ជាង គេ ក្នុង ពិភពលោក នៅលើ ភ្នំ បូកគោ ។
ការសាងសង់ ពុទ្ឋ បដិមា នេះ នឹង ធ្វើឡើង នៅពេល ឆាប់ ៗ ខាងមុខ នេះ បន្ទាប់ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន អនុញ្ញាត្ត ឲ្យ អ្នក ឧកញ៉ា សុខ គង់ សាងស់ ពុទ្ឋ បដិមា កំពស់ ១០៨ ម៉ែត្រ ដែល ស្ថិត នៅ ចំណុវាល ស្រែ៥០០ នៅលើ កំពូល ភ្នំ ប បូកគោ ។
អ្នក ឧកញ៉ា សុខ គង់ បាន មានប្រសាសន៍ ឲ្យដឹង នា រសៀល ថ្ងៃទី ១៦ ធ្នូ ឆ្នាំ ២០២២ នេះ ថា គោលបំណង នៃ ការសាងសង់ រូបសំណាក ព្រះពុទ្ឋ បដិមា ដ៏ ធំ នេះ ដើម្បី ជា ទី សក្ការៈ ដ៏ ថ្លៃថ្លា ឧត្តុងឧត្តម សម្រាប់ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ យើង និង ដើម្បី ឧទ្ទិស សុំ សេចក្តីសុខ សេចក្តី ចម្រើ ន រុងរឿង និង សុខ សន្តិភាព ជានិច្ច និរន្តរ៍ ដល់ ប្រជាពលរដ្ឋ យើង ទាំងអស់ នៅក្នុង តំបន់ នេះ ក៏ ដូចជា នៅ ទូទាំង ព្រះរាជាណាចក្រ កម្ពុជា ទាំងមូល ។
អ្នក ឧកញ៉ា បាន បន្ថែម ថា ម្យ៉ាង វិញ ទៀត ព្រះពុទ្ឋ បដិមា ដ៏ ធំ ស្កឹមស្កៃ នេះ ក៏ ជា ការជួយ រួមចំណែក ទ្រទ្រង់ ដល់ វិស័យ ព្រះពុទ្ឋ សាសនា និង ការអភិវឌ្ឍ ទេសចរណ៍ វប្បធម៌ ហើយ ជាពិសេស ទៀត នោះ គឺជា ការទាក់ទាញ យ៉ាង ធំធេង ដល់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ រាប់ លាន នាក់ ក្នុង មួយ ឆ្នាំ ៗ ឱ្យ មកកាន់ តំបន់ នេះ យ៉ាង ច្រើន កុះករ ហើយក៏ ជា ប្រភព ចំណូល យ៉ាង ធំ ដែល នឹង ទទួលបាន ពី ភ្ញៀវ ទេសចរ ទាំងនោះ ។
អ្នក ឧកញ៉ា សុខ គង់ បាន ឱ្យដឹង ទៀត ថា ក្រុមហ៊ុន បាន រចនា ពុទ្ឋ បដិមា នេះ តាមរចនបទ ខ្មែរ រួចហើយ ដោយ បាន សហការ ពី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដើម្បី ធានា ថា រូបសំណាក ព្រះពុទ្ធ បដិមា ដ៏ ធំ នេះ ត្រូវបាន សាងសង់ ត្រឹមត្រូវ ស្រប ទៅតាម រចនាបទ របស់ ខ្មែរ យើង ។ គម្រោង ដ៏ ធំ នេះ គ្រោង នឹង ចំណាយ ថវិកា ប្រមាណ ពី៣០ ទៅ ៤០ លាន ដុល្លារ អាមេរិក ។
អ្នក ឧកញ៉ា សុខ គង់ បាន បន្ត ថា តាមរយៈ កិច្ចពិភាក្សា ក្នុង អង្គប្រជុំ អន្តរ ក្រសួង កន្លងមក គណៈកម្មការ អន្តរ ក្រសួង បាន គាំទ្រ ចំពោះ ការសាងសង់ ពុទ្ឋ បដិមា ខ្ពស់ ជាង គេ លើ ពិភព នេះ ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឱ្យ នាំគ្នា សិក្សា ឈ្វេងយល់ និង ត្រូវ ចងចាំ ចំពោះ នយោបាយ ឈ្នះ - ឈ្នះ ដែល ជា នយោបាយ មួយ នាំឱ្យ កម្ពុជា ចាក ឆ្ងាយ ពី ភ្លើង សង្គ្រាម នាំមក នូវ ការបង្រួបបង្រួម ជាតិ និង ការអភិវឌ្ឍ ដូច ពេល បច្ចុប្បន្ន ។
ការបិទ បញ្ចប់ សង្គ្រាម ទាំងស្រុង នៅ ឆ្នាំ ១៩៩៨ វា បាន ក្លាយជា ពេលវេលា ដែល កម្ពុជា រកឃើញ នូវ សុខ សន្តិភាព រកឃើញ ឯកភាព ជាតិ និង ទឹកដី ជាថ្មី ក្រោយ ការបែកបាក់ ចក្រភព អង្គរ ដែល មាន រយៈពេល យ៉ាងហោចណាស់ ៥០០ ឆ្នាំ ។
មកដល់ ឆ្នាំ ២០២២ នេះ មាន រយៈពេល ២៤ ឆ្នាំ ហើយ ដែល កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ ហើយ បាន ផ្តល់ ឱកាស ឱ្យ កម្ពុជា កសាង និង អភិវឌ្ឍ ខឿន សេដ្ឋកិច្ច ជាតិ ធ្វើឱ្យ កម្ពុជា ងើប ចេញ ពី ឋានៈ ប្រទេស ក្រីក្រ មក ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន គូសបញ្ជាក់ ថា វឌ្ឍនភាព ភាពរីកចម្រើន និង វិបុលភាព របស់ ជាតិ កម្ពុជា ដែល កំពុង មាន នេះ ក៏ ដោយសារតែ នយោបាយ ឈ្នះ - ឈ្នះ ។ សម្រាប់ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ សុខ សន្តិភាព គឺជា សមិទ្ធផល ដ៏ ធំ បំផុត កើត ចេញពី នយោបាយ ឈ្នះ - ឈ្នះ ។
នយោបាយ ឈ្នះ - ឈ្នះ មាន គុណូបការៈ យ៉ាង ធំធេង បំផុត សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ដើម្បីឱ្យ ស្មារតី នយោបាយ ឈ្នះ - ឈ្នះ នយោបាយ នាំមក នូវ សុខ សន្តិភាព បន្ត ចាក់ គ្រឹះ រឹងមាំ ក្នុង សង្គម កម្ពុជា នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ ប្រឹងប្រែង សិក្សា ឈ្វេងយល់ ពី នយោបាយ មួយ នេះ ។ នាយ ឧត្តមសេនីយ៍ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ត្រូវ ដឹង គុណ សម្តេច តេជោ ហ៊ុន សែន ស្ថាបនិក នយោបាយ ឈ្នះ - ឈ្នះ ក៏ ដូច ប្រតិបត្តិករ ដទៃ ទៀត ។
នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ រាជ រដ្ឋាភិបាល នឹង ប្រារព្ធ ពិធី អបអរសាទរ ខួប នយោបាយ ឈ្នះ - ឈ្នះ យ៉ាង មហោឡារិក នៅ វិមាន នយោបាយ ឈ្នះ - ឈ្នះ ។
នាយ ឧត្តមសេនីយ៍ បាន បញ្ជាក់ ថា អ្នកចូលរួម អបអរសាទរ ក្នុង ទិវា ជា ប្រវត្តិសាស្ត្រ នេះ មាន ចំនួន ប្រមាណ ៤.៦៨៨ នាក់ ។ ក្នុង នោះ គណៈអធិបតី ភ្ញៀវ ជាតិ និង អន្តរជាតិ សរុប ២៧២ នាក់ . ព្រះសង្ឃ ៧អង្គ. កងកម្លាំងប្រដាប់អាវុធ រួមទាំង កាយ រឹទ្ធិ ១៩ ផែន ស្មើនឹង ២. ៣១៥នាក់ . ផែន យុវជន មកពី សហភាព សហព័ន្ធ យុវជន កម្ពុជា កាយ រឹទ្ធិ កាកបាទ ក្រហម ៨៩៤ នាក់ ផែន ប្រជាពលរដ្ឋ ១. ២០០ នាក់ ។
ក្នុង ព្រឹត្តិការណ៍ នោះ ក៏ មាន ការរៀបចំ តាំងពិព័រណ៍ ស្តីពី ការអនុវត្តន៍ នយោបាយ ឈ្នះ - ឈ្នះ របស់ កងយោធពល ខេមរភូមិន្ទ ចំនួន ១៩ស្តង់ ។ ក្នុង នោះ ផែន ចំណុះ ក្រសួង ការពារ ជាតិ ១២ស្តង់ និង អគ្គ បញ្ជាការ ចំនួន ៧ស្តង់ ហើយ នៅពេល រាត្រី មាន បាញ់ កាំជ្រួច ថែម ទៀត ផង ។
សូម បញ្ជាក់ ផងដែរ ថា ដើម្បី អបអរសាទរ ទិវា នយោបាយ ឈ្នះ - ឈ្នះ កាលពី ខែមករា ឆ្នាំ ២០២២ កន្លងទៅ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចេញ សារាចរ កំណត់ យក ទិវា នយោបាយ ឈ្នះ - ឈ្នះ ថ្ងៃទី ២៩ ខែធ្នូ ទៅក្នុង ប្រតិទិន ប្រចាំ ឆ្នាំ ដោយ មិន ឈប់ សម្រាក នោះ ឡើយ ។
ក្នុង សារាចរ នោះ រាជ រដ្ឋាភិបាល បាន ណែនាំ ឱ្យ គ្រប់ ក្រសួង ស្ថាប័ន រាជធានី ខេត្ត និង គ្រឹះស្ថាន សាធារណៈ ឯកជន ត្រូវ រៀបចំ ចងប ដា ពាក្យស្លោក ដើម្បី អបអរសាទរ ទិវា នយោបាយ ឈ្នះ - ឈ្នះ ដែល មាន ខ្លឹមសារ ថា « អរគុណ សន្តិភាព ! អរគុណ នយោបាយ ឈ្នះ - ឈ្នះ ! ដឹង គុណ ស្ថាបនិក មគ្គុទ្ទេសក៍ ឯក និង ប្រតិបត្តិករ នយោបាយ ឈ្នះ ឈ្នះ ដែល នាំមក នូវ សន្តិភាព និង ការឯកភាព ជាតិ ពេញលេញ !» ៕ បើកបរ សូម កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ១នាក់ និង របួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៦ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១នាក់ និង របួស ធ្ងន់ ស្រាល ៩នាក់ ។
ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន សំណេះសំណាល ជាមួយ មនុស្ស ចាស់ ជន ពិការ និង អតីត យុទ្ធជន នៅ ភូមិ បឹង ជម្រុក តេជោ ឈ្នះ ឈ្នះ ឃុំ ទួល ពង្រ ស្រុក ម៉ាឡៃ
( បន្ទាយមានជ័យ )៖ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ប្រធាន កិត្តិយស សមាគម មូលនិធិ មនុស្ស ចាស់ ខេត្ត បន្ទាយមានជ័យ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ អម ដោយ ក្រុមការងារ នៅ ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ បាន ជួប សំណេះសំណាល ជាមួយ មនុស្ស ចាស់ ជន ពិការ និង អតីត យុទ្ធជន នៅ ភូមិ បឹង ជម្រុក តេជោ ឈ្នះ ឈ្នះ ឃុំ ទួល ពង្រ ស្រុក ម៉ាឡៃ ។
ក្នង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ពាំនាំ បណ្តាំ សួរសុខទុក្ខ ពី ថ្នាក់ដឹកនាំ ជាតិ ពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី ដែល តែងតែ យកចិត្តទុកដាក់ ជាប្រចាំ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ពិសេស អ្នក បឹង ជង្រុក តេជោ ឈ្នះ ឈ្នះ និង បាន កោតស សើរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន ចូលរួម ថែរក្សា សន្តិភាព និង អភិវឌ្ឍន៍ មូលដ្ឋាន បាន រីកចម្រើន ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ថ្លែង បន្ត ថា រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ បាន ចាត់ទុក បញ្ហា មនុស្ស ចាស់ ជា បញ្ហា ចម្បង អាទិភាព ដែល ត្រូវតែ គិតគូរ យកចិត្តទុកដាក់ មើល ថែ ជា ចាំបាច់ និង សូមឲ្យ កូន ចៅ ជំនាន់ ក្រោយ ត្រូវតែ មើល ថែ ឱ ពុក ម្តាយ របស់ ខ្លួន ឲ្យបាន ល្អ ។
ជាមួយគ្នា នេះ លោក កែ គឹម យ៉ាន បាន ចែក អំណោយ ចែកជូន អ្នកចូលរួម ចំនួន ៣៤៣ នាក់ ដោយ ម្នាក់ ៗ ទទួលបាន ឃីត ១ក ព្ចាប់ រួម មាន៖
ខាងក្រោម នេះ ជា ការថ្លែង បិទ កិច្ចប្រជុំ ពិគ្រោះយោបល់ របស់ លោក ទេព នីថា៖ បរធន បាលកិច្ច ដែល បាន ចុះបញ្ជី នៅ និយ័តករបរ ធន បាលកិច្ច កើន ដល់ ៣០០ ករណី ជាមួយ ទំហំ បរធន ៤២៦ លាន ដុល្លារ
ស្ថិតិ កំណើន នេះ ត្រូវបាន បង្ហាញ ក្នុង កិច្ចប្រជុំ បរធន បាលកិច្ច ប្រចាំ ឆ្នាំ ២០២២ ក្រោម ការដឹកនាំ របស់ លោក សុខ ដារ៉ា អគ្គ នាយក នៃ ន . ប.ធ . នៅ ទីស្តីការ របស់ អាជ្ញាធរ សេវា ហិរញ្ញវត្ថុ មិន មែន ធនាគារ នា ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២២ ។
ជាមួយគ្នា នេះ កិច្ចប្រជុំ ក៏ បាន ធ្វើ ការពិភាក្សា ផងដែរ អំពី បញ្ហា ប្រឈម ពាក់ព័ន្ធ ដូចជា ការយល់ដឹង ជាសាធារណៈ និង ការអនុវត្ត ច្បាប់ នៅ មាន កម្រិត ព្រមទាំង ស្នើ ឡើង នូវ ដំណោះស្រាយ គន្លឹះ សំខាន់ ៗ ដែល មាន ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ក្នុង គោលដៅ ជំរុញ ការអភិវឌ្ឍ វិស័យ បរធន បាលកិច្ច នៅ កម្ពុជា និង ក្នុង គោលដៅ ធ្វើ យ៉ាងណា ឲ្យ យន្តការ និង ប្រតិបត្តិការបរ ធន បាលកិច្ច អាច ក្លាយជា ឧបករណ៍ ចូលរួមចំណែក ក្នុង ការជំរុញ ការអភិវឌ្ឍ វិស័យ ពាក់ព័ន្ធ ផ្សេង ទៀត ផងដែរ ៕
វេទិកា និពន្ធ នាយ ក៖ សម្តេច តេជោ ហ៊ុន សែន ឲ្យ រួមគ្នា ប្រឆាំង ជន ឱកាស និយម ជ្រក ក្រោម ស្លាកសារព័ត៌មាន ដើម្បី រក្សា គុណ តម្លៃ និង សេចក្ដីថ្លៃថ្នូរ របស់ ស្ថាប័ន សារព័ត៌មាន (Video inside) ( ភ្នំពេញ ) ៖ ក្នុង វេទិកា និពន្ធ នាយក សារព័ត៌មាន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ផ្ដល់ អនុសាសន៍ ៥ ចំណុច ដើម្បី ធ្វើជា មូលដ្ឋាន ក្នុង ការសិក្សា និង រៀបចំ ទិសដៅ សម្រាប់ អនុវត្ត ដោយ ចំណុច សំខាន់ នោះ គឺ សម្តេច តេជោ ឲ្យ រួមគ្នា ប្រឆាំង ជន ឱកាស និយម ជ្រក ក្រោម ស្លាកសារព័ត៌មាន ។
តាមរយៈ សារលិខិត ដែល បាន ផ្ញើ ជូន វេទិកា និពន្ធ នាយក សារព័ត៌មាន កម្ពុជា លើក ទី១៩ នា ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ត្រូវ ពង្រឹង យន្ត ការប្រតិបត្តិ ក្រមសីលធម៌ និង វិជ្ជាជីវៈ ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ប្រឆាំង ជន ឱកាស និយម ជ្រក ក្រោម ស្លាកសារព័ត៌មាន ដើម្បី រក្សា គុណ តម្លៃ និង សេចក្ដីថ្លៃថ្នូរ របស់ ស្ថាប័ន សារព័ត៌មាន » ។
វេទិកា និពន្ធ នាយក សារព័ត៌មាន លើក ទី១៩ មាន ចាងហ្វាង និពន្ធ នាយក តំណាង សមាគម និង ថ្នាក់ដឹកនាំ សារព័ត៌មាន ជិត ១០០ នាក់ មកពី ៦០ ស្ថាប័ន ចូលរួម ពិភាក្សា ដើម្បី ឈានដល់ ការអនុម័ត សេចក្តីថ្លែងការណ៍ រួម ស្តីពី « ការពង្រឹង យន្ត ការប្រតិបត្តិ ក្រមសីលធម៌ វិជ្ជាជីវៈ សារព័ត៌មាន នៅ កម្ពុជា » ។
បើ តាម សារ លិខិត ដដែល សម្តេច តេជោ ហ៊ុន សែន ក៏ ផ្តល់ អនុសាសន៍ បណ្ដុះបណ្ដាល អ្នកសារព័ត៌មាន ទាំង ផ្នែក វិជ្ជាជីវៈ និង បច្ចេកវិទ្យា ប្រព័ន្ធ ផ្សព្វផ្សាយ ឌីជីថល ដើម្បីឱ្យ អ្នកសារព័ត៌មាន នៅ កម្ពុជា មាន សមត្ថភាព ដើរ ទាន់ ការវិវត្ត នៃ ប្រព័ន្ធ ផ្សព្វផ្សាយ ទំនើប នា ពេល បច្ចុប្បន្ន ។ សម្តេច តេជោ ក៏ ឲ្យ ចូលរួម ប្រយុទ្ធ ប្រឆាំង ព័ត៌មាន ក្លែងក្លាយ និង មិន ត្រូវ ធ្វើជា ភ្នាក់ងារ ចែកចាយ ព័ត៌មាន ក្លែងក្លាយ បំពុល សង្គម ដែល ធ្វើឱ្យ ប្រទេស ធ្លាក់ ទៅក្នុង ភាពចលាច ល បាត់បង់ សណ្ដាប់ធ្នាប់ សង្គម ។
បន្ថែម លើ នេះ សម្តេច តេជោ ហ៊ុន សែន ឲ្យ បន្ត ផ្សព្វផ្សាយ នូវ វិធានការ ការពារ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ឱ្យ កាន់តែ សកម្ម ថែម ទៀត និង ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ បាន ទៅ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ឱ្យ បាន គ្រប់ ៗ គ្នា ។ សម្តេច តេជោ ក៏ បាន ផ្តល់ អនុសាសន៍ ឲ្យ ផ្សព្វផ្សាយ ដំណើរ ឆ្ពោះ ទៅ ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៉ី ហ្គេម លើក ទី ៣២ ឆ្នាំ ២០២៣ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ឱ្យ បាន ទូលំទូលាយ និង ជ្រួតជ្រាប ដល់ គ្រប់ ស្រទាប់ មហាជន ៕
ក្នុង សារលិខិត ផ្ញើ ជូន វេទិកា និពន្ធ នាយក សារព័ត៌មាន កម្ពុជា លើក ទី១៩ ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន សម្ដេច តេជោ ហ៊ុន សែន បាន អះះ អាង ថា តាមរយៈ ការចូលរួម នេះ ហើយ ផ្ដល់ ឱកាស ឲ្យ រាជ រដ្ឋាភិបាល មាន លទ្ធភាព បើក ប្រទេស ឡើងវិញ និង ដាក់ ឲ្យ ដំណើរការលើ គ្រប់ វិស័យ ដែល ធ្វើឲ្យ សេដ្ឋកិច្ច កម្ពុជា មាន ដំណើរការ ល្អ ។
ក្រៅពី មាន ការ ឱកាស បើក ប្រទេស ឡើងវិញ ហើយ នោះ សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា ការទប់ស្កាត់ បាន ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ នេះ ធ្វើឲ្យ កម្ពុជា មាន លទ្ធភាព រៀបចំ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ - ៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ និង កិច្ចប្រជុំ អន្តរសភា អាស៊ាន (AIPA) លើក ទី ៤៣ បាន ទទួល ជោគជ័យ យ៉ាង ធំធេង ដែល ធ្វើឲ្យ កិត្យានុភាព កម្ពុជា កាន់តែ ល្បីរន្ទឺ នៅលើ ឆាក អន្តរជាតិ ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច តេជោ ហ៊ុន សែន សមិទ្ធផល ដ៏ ធំធេង និង ជា ប្រវត្តិសាស្ត្រ នេះ បាន បង្ហាញ ពី កិច្ចសហការ និង ភាពជាដៃគូរ វាង រាជ រដ្ឋាភិបាល កម្ពុជា ជាមួយ ស្ថាប័ន និង បងប្អូន អ្នកសារព័ត៌មាន ដែល បាន ពុះពារ ជំនះ រាល់ ឧបសគ្គ ចុះ យក ព័ត៌មាន និង ធ្វើ ការផ្សព្វផ្សាយ នឹង ចែករំលែក ព័ត៌មាន ជូន ប្រជាពលរដ្ឋ បាន ទូលំទូលាយ និង ទាន់ សភាពការណ៍ ទោះបីជា ប្រព័ន្ធ ផ្សព្វផ្សាយ របស់ យើង ទទួលរង នូវ ផល ប៉ះពាល់ ផ្នែក សេដ្ឋកិច្ច ពី វិបត្តិ នយោបាយ សកល ក៏ ដូចជា វិបត្តិ នៃ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក៏ដោយ ។
១៖ ពង្រឹង យន្ត ការប្រតិបត្តិ ក្រមសីលធម៌ និង វិជ្ជាជីវៈ ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ប្រឆាំង ជន ឱកាស និយម ជ្រក ក្រោម ស្លាកសារព័ត៌មាន ដើម្បី រក្សា គុណ តម្លៃ និង សេចក្ដីថ្លៃថ្នូរ របស់ ស្ថាប័ន សារព័ត៌មាន ។
២៖ បណ្ដុះបណ្ដាល អ្នកសារព័ត៌មាន ទាំង ផ្នែក វិជ្ជាជីវៈ និង បច្ចេកវិទ្យា ប្រព័ន្ធ ផ្សព្វផ្សាយ ឌីជីថល ដើម្បីឱ្យ អ្នកសារព័ត៌មាន នៅ កម្ពុជា មាន សមត្ថភាព ដើរ ទាន់ ការវិវត្ត នៃ ប្រព័ន្ធ ផ្សព្វផ្សាយ ទំនើប នា ពេល បច្ចុប្បន្ន ។
៣៖ ចូលរួម ប្រយុទ្ធ ប្រឆាំង ព័ត៌មាន ក្លែងក្លាយ និង មិន ត្រូវ ធ្វើជា ភ្នាក់ងារ ចែកចាយ ព័ត៌មាន ក្លែងក្លាយ បំពុល សង្គម ដែល ធ្វើឱ្យ ប្រទេស ធ្លាក់ ទៅក្នុង ភាពចលាច ល បាត់បង់ សណ្ដាប់ធ្នាប់ សង្គម ។
៤៖ បន្ត ផ្សព្វផ្សាយ នូវ វិធានការ ការពារ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ឱ្យ កាន់តែ សកម្ម ថែម ទៀត និង ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ បាន ទៅ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ឱ្យ បាន គ្រប់ ៗ គ្នា ។
៥៖ ផ្សព្វផ្សាយ ដំណើរ ឆ្ពោះទៅ ព្រឹត្តិការណ៍ ប្រកួត កីឡា ស៉ី ហ្គេម លើក ទី ៣២ ឆ្នាំ ២០២៣ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ឱ្យ បាន ទូលំទូលាយ និង ជ្រួតជ្រាប ដល់ គ្រប់ ស្រទាប់ មហាជន ។
គួរ ជម្រាប ថា ក្នុង ឱកាស អបអរសាទរ ចំពោះ វេទិកា និពន្ធ នាយក សារព័ត៌មាន កម្ពុជា លើក ទី១៩ ឆ្នាំ ២០២២ នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន បង្ហាញ នូវ មោទនភាព ចំពោះ ការរីកចម្រើន យ៉ាង ឆាប់រហ័ស នៃ ប្រព័ន្ធ ផ្សព្វផ្សាយ ព័ត៌មាន នៅ កម្ពុជា ស្រប ពេល មាន ការវិវត្ត យ៉ាង ឆាប់រហ័ស នៃ បច្ចេកវិទ្យា ប្រព័ន្ធ ផ្សព្វផ្សាយ ឌីជីថល នា ដំណាក់កាល បដិវត្ត ឧស្សាហកម្ម ជំនាន់ ទី៤នេះ ៕
ប្រមុខ ទីភ្នាក់ងារ ការពារ ជាតិ អឺរ៉ុប ព្រមាន ថា សហរដ្ឋ អាមេរិក មិន អាច ការពារ អឺរ៉ុប គ្រប់ ពេល នោះ ទេ
គួរ បញ្ជាក់ ថា វិស័យ ការពារ ជាតិ អឺរ៉ុប បាន ចំណាយ ជាង ២០០ ពាន់ លាន អឺរ៉ូ ជា លើក ដំបូង កាលពី ឆ្នាំ ២០២១ ឬ កើនឡើង ៦ភាគរយ បើ ធៀប ទៅនឹង ឆ្នាំ ២០២០ ខណៈ សង្រ្គាម របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន ក៏ បាន និង កំពុង ជំរុញ ឱ្យ ប្រទេស អឺរ៉ុប មួយចំនួន ស្វះស្វែង ពង្រឹង សមត្ថភាព យោធា និង បង្កើន កញ្ចប់ ថវិកា យោធា ផងដែរ ៕
ព្រះសង្ឃ និង គណៈកម្មាការ វត្ត សំឡាញ ខេត្ត ព្រះវិហារ យក ស្រូវ ដែល បាន មកពី ពុទ្ធ បរិស័ទ ពេល បុណ្យ ផ្កា សាមគ្គី ទុក លក់ សម្រាប់ កសាង វត្ត . លោក សំ លាង ទ្រី ប្រកាស ទិញ ទាំងអស់
( ព្រះវិហារ )៖ ស្រូវ ចំនួន ៣.៧៨៩ គីឡូក្រាម ដែល បាន មកពី សទ្ធា ជ្រះថ្លា របស់ ប្រជាពលរដ្ឋ ចូលរួម បុណ្យ ផ្កា ស្រូវ ដែល ផ្តួចផ្តើម ដោយ ព្រះសង្ឃ អាចារ្យ គណៈកម្មាការ វត្ត ទក្សិណ គីរី ហៅ វត្ត សំឡាញ ត្រូវបាន លោក សំ លាង ទ្រី ប្រធាន ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក សង្គម ថ្មី ទទួល ទិញ ទាំងអស់ នឹង តម្កល់ ទុក ក្នុង វត្ត សម្រាប់ ឱ្យ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត អាច ខ្ចី បរិភោគ បណ្តោះអាសន្ន បាន ។
ព្រះតេជគុណ នឿម គឹម សាន្ត ចៅអធិការ វត្ត ទក្សិណ គីរី ហៅ វត្ត សំឡាញ ស្ថិត ក្នុង ភូមិ សំឡាញ ឃុំ ត្បែង មួយ ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ បាន មាន សង្ឃ ដីកា ថា៖ « ក្នុង ទិសដៅ ដើម្បី រក បច្ច័យ សម្រាប់ កសាង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ក្នុង វត្ត ព្រះតេជគុណ រួម នឹង គណៈកម្មាការ វត្ត បាន ឯកភាព គ្នា ធ្វើ បុណ្យ ផ្កា ស្រូវ ដោយ ទទួលបាន ស្រូវ ចំនួន ៣.៧៨៩ គីឡូក្រាម ហើយ ស្រូវ ទាំងនេះ បាន ឯកភាព គ្នា ថា នឹង លក់ ដើម្បី យក បច្ខ័យ ដោះស្រាយ ការខ្វះខាត ការសាងសង់ វត្ត » ។
ឮ ដំណឹង ថា គណៈកម្មាការ វត្ត យក ស្រូវ ដែល បាន មកពី បុណ្យ ផ្កា ស្រូវ យក ទៅ លក់ លោក សំ លាង ទ្រី ប្រធាន ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក សង្គម ថ្មី បាន ទូល ព្រះសង្ឃ នឹង ប្រាប់ គណៈកម្មាការ វត្ត មិន ចាច់ យក ស្រូវ ដែល បាន មកពី បុណ្យ ផ្កា ស្រូវ យក ទៅ លក់ នៅ ខាងក្រៅ នោះ ទេ ដោយ លោក ទទួល ទិញ ទាំងអស់ តាម តម្លៃ ទីផ្សារ ហើយ តម្កល់ ស្រូវ នេះ ទុក នៅក្នុង វត្ត នឹង ធ្វើ ជង្រុក ទុកដាក់ ឱ្យ បាន ត្រឹមត្រូវ សម្រាប់ ឱ្យ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត អាច ខ្ចី ក្នុង ពេល ដាច់ ស្បៀង ម្តងម្កាល ។
គួរ បញ្ជាក់ ថា ជាធម្មតា វ៉ាក់សាំង ប្រឆាំង ជំងឺ អាសន្ន រោគ ៣៦ លាន ដូស មាន នៅក្នុង ស្ដុក ក្នុង រយៈពេល មួយ ឆ្នាំ ។ ប៉ុន្តែ ការខ្វះខាត វ៉ាក់សាំង នៅក្នុង ឆ្នាំ ២០២២ នេះ ក៏ បាន បង្ខំឱ្យ WHO ផ្អាក ជា បណ្ដោះអាសន្ន ផងដែរ នូវ យុទ្ធសាស្ត្រ ស្ដង់ដារ ចាក់ វ៉ាក់សាំង បង្ការ ចំនួន ២ដូស កាលពី ខែតុលា កន្លងទៅ ៕
សារលិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ ជូន វេទិកា និពន្ធ នាយក សារព័ត៌មាន កម្ពុជា លើក ទី ១៩
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២២ នេះ វេទិកា និពន្ធ នាយក សារព័ត៌មាន កម្ពុជា លើក ទី១៩ បាន រៀបចំឡើង នៅ សណ្ឋាគារ កាំបូឌីយ៉ាណា រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោក កឹម គុណ វឌ្ឍន៍ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន តំណាង លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ។
នៅក្នុង វេទិកា នោះ សម្តេច តេជោ ហ៊ុន សែន បាន ផ្ញើ សារលិខិត ជូន វេទិកា និពន្ធ នាយក សារព័ត៌មាន កម្ពុជា លើក ទី១៩ ចំនួន ៣ទំព័រ . ខាងក្រោម ខ្លឹមសារ ទាំងស្រុង របស់ សម្តេច តេជោ៖
ព្រះវិហារ ឦសាន្ត គិរី សាមគ្គី មាន ជ័យ ហៅ វត្ត ប្រយុទ្ធ នៅ ខេត្ត ព្រះវិហារ នឹង រៀបចំ បញ្ចុះ ខណ្ឌ សីមា ឆ្លង នា ចុង ខែមីនា ឆ្នាំ ២០២៣ ខាងមុខ
( ព្រះវិហារ ) ៖ ព្រះវិហារ វត្ត ឦសាន្ត គិរី សាមគ្គី មាន ជ័យ ហៅ វត្ត ប្រយុទ្ធ ស្ថិត នៅ ភូមិ ហ្ម សែត សង្កាត់ ប៉ាល ហាល ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ នឹង រៀបចំ ពិធី បុណ្យ បញ្ចុះ ខណ្ឌ សីមា ឆ្លង រយៈពេល ៣យប់ ៤ ថ្ងៃ ពោល ចាប់ពី ថ្ងៃទី ២៣ - ២៦ ខែមីនា ឆ្នាំ ២០២៣ ខាងមុខ នេះ បន្ទាប់ពី ព្រះវិហារ នេះ បាន កសាង រួចរាល់ ជា ស្ថាពរ ដោយ ប្រើ រយៈពេល រហូត១០ ឆ្នាំ ។
ព្រះតេជគុណ ព្រះវិរិយធ ម្មោ ហាន ធានី ព្រះគ្រូ ចៅអធិការ វត្ត ឦសាន្ត គិរី ហៅ វត្ត ប្រយុទ្ធ មាន សង្ឃ ដីកា ឱ្យដឹង ថា ព្រះវិហារ ឦសាន្ត គិរី សាមគ្គី មាន ជ័យ ហៅ វត្ត ប្រយុទ្ធ បាន ចំណាយ ពេលវេលា កសាង អស់ រយៈកាល១០ ឆ្នាំ នឹង រួចរាល់ ជា ស្ថាពរ ដោយ ចំណាយ បច្ច័យ អស់ ចំនួន ៣២. ០០០០ ដុល្លារ ។ តាំងពី ចាប់ផ្តើម ក សាង រហូត រួចរាល់ ជា ស្ថាពរ ព្រះតេជគុណ រួម ជាមួយ អាចារ្យ គណៈកម្មាការ វត្ត បាន ទូទាត់ សង ថ្លៃ ជាង និង គ្រឿង សំណង់ អស់ បច្ច័យ ៣០. ០០០០ ដុល្លារ នឹង នៅ ជំពាក់ ថ្លៃ ជាង គ្រឿង សំណង់ ចំនួន ២០.០០០ ដុល្លារ ទៀត ។
ព្រះតេជគុណ ព្រះគ្រូ ចៅអធិការ វត្តមាន សង្ឃ ដីកា ទៀត ថា ដោយសារ ព្រះវិហារ បាន កសាង រួចរាល់ ជា ស្ថាពរ ព្រះសង្ឃ អាចារ្យ គណៈកម្មាការ វត្ត និង អាជ្ញាធរ មូលដ្ឋាន បាន ឯកភាព គ្នា ជា ឯកច្ឆ័ន្ទ ប្រារព្ធ ធ្វើ បុណ្យ បញ្ចុះ ខណ្ឌ សីមា និង កាន់ អង្គ ២០០ អង្គ ដើម្បី វេរ តម្កល់ ព្រះវិហារ ទុក ជា សម្បត្តិ ព្រះពុទ្ធ សាសនា ។
( ប៉េកាំង ) ៖ ប្រទេស ចិន នឹង ផ្តោត លើ ស្ថិរភាព សេដ្ឋកិច្ច នៅ ឆ្នាំ ២០២៣ និង បង្កើន ការកែសម្រួល គោល នយោបាយ ដើម្បី ធានា នូវ ការសម្រេចបាន គោលដៅ សេដ្ឋកិច្ច សំខាន់ ៗ ។ នេះ បើ យោង តាម សេចក្តីថ្លែងការណ៍ មួយ ដែល ចេញផ្សាយ កាលពី ថ្ងៃសុក្រ បន្ទាប់ពី កិច្ចប្រជុំ របស់ មេដឹកនាំ និង អ្នកបង្កើត គោល នយោបាយ ។
យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ កិច្ចប្រជុំ បិទ ទ្វារ រយៈពេល ពីរ ថ្ងៃ ដែល ត្រូវបាន កោះ ប្រជុំ ដើម្បី កំណត់ ទិសដៅ សេដ្ឋកិច្ច នៅ ឆ្នាំ ២០២៣ នេះ ត្រូវបាន ឃ្លាំមើល យ៉ាង ជិតស្និទ្ធ ដោយ វិនិយោគិន ក្នុង គ្រា ដែល ពេល មាន ការរំពឹងទុក ថា ទីក្រុង ប៉េកាំង នឹង បង្កើន វិធានការ គាំទ្រ សេដ្ឋកិច្ច ។
ប្រទេស មហា អំណាច សេដ្ឋកិច្ច ទី ពីរ របស់ ពិភពលោក មួយ នេះ ប្រឈមមុខ នឹង បញ្ហា ជាច្រើន ដោយសារ ករណី ឆ្លង ជំងឺ កូវីដ - ១៩ កើនឡើង បន្ទាប់ពី ការបន្ធូរបន្ថយ ការរឹតត្បិត យ៉ាង ធ្ងន់ធ្ងរ ដែល ប៉ះពាល់ ដល់ អាជីវកម្ម និង អ្នកប្រើប្រាស់ ខណៈ ដែល ការថយចុះ កំណើន សេដ្ឋកិច្ច ពិភពលោក ប៉ះពាល់ ដល់ ការនាំចេញ របស់ ចិន ។
សេចក្តីថ្លែងការណ៍ ដដែល នេះ ដែល ត្រូវបាន ចេញ បន្ទាប់ពី សន្និសីទ ស្តីពី ការងារ សេដ្ឋកិច្ច មជ្ឈិម ប្រចាំ ឆ្នាំ និង ដែល ត្រូវបាន ចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួ បាន ឱ្យដឹង ថា ប្រទេស ចិន នឹង អនុវត្ត គោល នយោបាយ សារពើពន្ធ សកម្ម និង គោល នយោបាយ រូបិយវត្ថុ ប្រកបដោយ ការប្រុងប្រយ័ត្ន នៅ ឆ្នាំ ក្រោយ ។
ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួ បាន រាយការណ៍ ថា គោល នយោបាយ សារពើពន្ធ នឹង ត្រូវបាន បង្កើន និង កាន់តែ មាន ប្រសិទ្ធភាព ដោយ រក្សា បាន នូវ អនុភាព ការចំណាយ ចំបាច់ ខណៈ ដែល គោល នយោបាយ រូបិយវត្ថុ នឹង មាន ភាពច្បាស់លាស់ និង រឹងមាំ ដោយ រក្សា សាច់ប្រាក់ងាយស្រួល គ្រប់គ្រាន់ ។
សេចក្តីថ្លែងការណ៍ នេះ បាន ឱ្យដឹង ថា៖ « នៅ ឆ្នាំ ក្រោយ យើង នឹង ផ្តល់ អាទិភាព ដល់ ស្ថិរភាព និង ខិតខំ សម្រេចបាន វឌ្ឍនភាព » ។
សេចក្តីថ្លែងការណ៍ ដដែល នេះ បាន បន្ត ថា ប្រទេស ចិន គួរតែ សម្របសម្រួល វិធានការ បង្ការ និង គ្រប់គ្រង ការរីករាលដាល ជំងឺ រាតត្បាត និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ឱ្យ កាន់តែ ប្រសើរឡើង ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕ កូរ៉េ ខាងត្បូង នឹង ពន្លឿន ការបន្ធូរបន្ថយ បទប្បញ្ញត្តិ ទីផ្សារ អចលន ទ្រព្យ
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ សម្ដី លោក Yoon ដែល បាន ថ្លែង ក្នុង អំឡុង កិច្ចប្រជុំ តាម ទូរទស្សន៍ មួយ ដើម្បី ពិនិត្យមើល គោលបំណង គោល នយោបាយ របស់ រដ្ឋាភិបាល កូរ៉េ ថា៖ « ខណៈពេល ដែល តម្លៃ ផ្ទះ កំពុង ស្ថិត ក្នុង និន្នាការធ្លាក់ចុះ ដោយសារតែ អត្រា ការប្រាក់ ខ្ពស់ ( រដ្ឋាភិបាល ) នឹង លុបចោល បទប្បញ្ញត្តិ ខាង ផ្នែក តម្រូវការ ក្នុង ល្បឿន កាន់តែ លឿន សម្រាប់ ស្ថិរភាព ទីផ្សារ » ។
បន្ទាប់ពី ការថ្លែង សុន្ទរកថា ទៅកាន់ ប្រជាពលរដ្ឋ សាមញ្ញ ចំនួន ១០០ នាក់ លោក Kim Joo-hyun ប្រធាន ផ្នែក និយតករ ហិរញ្ញវត្ថុ បាន និយាយ ថា រដ្ឋាភិបាល កំពុង រៀបចំ ផែនការ ដើម្បី អនុញ្ញាតឱ្យ ផ្តល់ ប្រាក់ កម្ចី ទិញ ផ្ទះ បន្ថែម សម្រាប់ អ្នក ដែល បើក ដំណើរការ អាជីវកម្ម ជួល និង អ្នក ដែល មាន ផ្ទះ ច្រើន ។
ទីផ្សារ អចលន ទ្រព្យ របស់ ប្រទេស កូរ៉េ ខាងត្បូង កំពុង ទទួលរង នូវ ការធ្លាក់ ថ្លៃ ខ្លាំង បំផុត ក្នុង រយៈពេល យ៉ាងហោចណាស់ ពីរ ទសវត្សរ៍ ក្នុង ឆ្នាំ នេះ ក្នុង គ្រា ដែល មាន វដ្ត នៃ ការដំឡើង អត្រា ការប្រាក់ ដ៏ ខ្លាំងក្លា បំផុត របស់ ធនាគារ កណ្តាល កូរ៉េ ។
ធនាគារ កណ្តាល កូរ៉េ បាន ដំឡើង អត្រា ការប្រាក់ គោល នយោបាយ របស់ ខ្លួន ចំនួន ២៧៥ ពិន្ទុ មូលដ្ឋាន ឬ ស្មើនឹង ២. ៧៥ភាគរយ ដែល ធ្វើឱ្យ អត្រា ការប្រាក់ កើនឡើង ដល់ កម្រិត ខ្ពស់ បំផុត ក្នុង រយៈពេល មួយ ទសវត្សរ៍ ៣.២៥ ភាគរយ គិត ចាប់តាំងពី ខែ សីហា ឆ្នាំ មុន ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី ដោះស្រាយ អតិផរណា ដែល កំពុង កើនឡើង ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕ អាមេរិក នឹង ដក ក្រុមហ៊ុន ចិន មួយចំនួន ចេញ ពី បញ្ជី ទង់ ក្រហម ឆាប់ ៗ នេះ
មន្ត្រី អាមេរិក ម្នាក់ បាន ប្រាប់ ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ នៅ សប្តាហ៍ នេះ ថា ផែនការដក ក្រុមហ៊ុន ទាំងនោះ ចេញ ពី បញ្ជី ឈ្មោះ ដែល គេ ហៅ ថា ជា បញ្ជី គ្មាន ការផ្ទៀងផ្ទាត់ នេះ ហើយ ត្រូវបាន រំពឹង ថា នឹង ធ្វើឡើង ក្នុង ពេល ឆាប់ ៗ នេះ ត្រូវបាន ធ្វើឡើង ដោយសារ មាន ឆន្ទៈ កាន់តែ ខ្លាំង ពី រដ្ឋាភិបាល ចិន ក្នុង ការអនុញ្ញាតឱ្យ អាមេរិក ចូល ធ្វើអធិការកិច្ច ដល់ ទីតាំង ផ្ទាល់ ។
ក្រសួង ពាណិជ្ជកម្ម អាមេរិក បាន បដិសេធ មិន ធ្វើ អត្ថាធិប្បាយ អំពី បញ្ហា នេះ នេះ ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ មិន អាច កំណត់ ចំនួន ឬ ឈ្មោះ របស់ ក្រុមហ៊ុន ចិន ដែល គ្រោង នឹង ត្រូវបាន ដក ចេញ ពី បញ្ជី នេះ បាន ទេ ។ ការសម្រេចចិត្ត នេះ បង្ហាញ ពី កម្រិត នៃ កិច្ចសហប្រតិបត្តិការ រវាង ទីក្រុង វ៉ាស៊ីនតោន និង ទីក្រុង ប៉េកាំង ដែល ជា ប្រទេស ដែល មាន សេដ្ឋកិច្ច ធំ ជាង គេ ទាំង ពីរ លើ ពិភពលោក ដែល បាន ជាប់គាំង នៅក្នុង សង្គ្រាម ពាណិជ្ជកម្ម និង បច្ចេកវិទ្យា ដ៏ ក្តៅ គគុក ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ថា ក្រុមហ៊ុន នានា ដែល ត្រូវបាន បញ្ចូល ទៅក្នុង បញ្ជី គ្មាន ការផ្ទៀងផ្ទាត់ នេះ គឺ ដោយសារ សហរដ្ឋ អាមេរិក មិន អាច ចូលទៅ ធ្វើ អធិការកិច្ច ដល់ ទីកន្លែង ផ្ទាល់ បាន ដើម្បី កំណត់ ថា តើ ក្រុមហ៊ុន ទាំងនោះ អាច ជឿ ទុកចិត្ត បាន ឬ អត់ ក្នុង ការទទួលបាន ការនាំចេញ បច្ចេកវិទ្យារ សើប ពី សហរដ្ឋ អាមេរិក ។
ការធ្វើ អធិការកិច្ច របស់ អាមេរិក ទៅ លើ ក្រុមហ៊ុន ចិន ទាមទារ ឱ្យ មាន ការយល់ព្រម ពី ក្រសួង ពាណិជ្ជកម្ម របស់ ប្រទេស ចិន ។
នៅ សប្តាហន៍ ផងដែរ លោក Biden បាន បន្ថែម ក្រុមហ៊ុន ផលិត បន្ទះ ឈីប ចិន YMTC និង ក្រុមហ៊ុន ធំ ៗ ចំនួន ២១ ទៀត របស់ ចិន នៅក្នុង ឧស្សាហកម្ម បន្ទះ ឈីប បញ្ញា សិប្បនិម្មិត ទៅក្នុង បញ្ជីខ្មៅ ពាណិជ្ជកម្ម ដោយ ពង្រីក ការបង្ក្រាប របស់ ខ្លួន លើ ឧស្សាហកម្ម បន្ទះ ឈីប របស់ ប្រទេស ចិន ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕
ការឈ្លានពាន របស់ រុស្ស៉ី ជិត ចូល ដល់ ខែ ទី១០ហើយ ចាប់តាំងពី លោក ពូទីន បញ្ជា ឱ្យ កងទ័ព របស់ លោក វាយលុក ចូល អ៊ុយក្រែន កាលពី ថ្ងៃទី ២៤ ខែកុម្ភៈ មក រីឯ ទីក្រុង កៀវ ក៏ បាន វាយ រំដោះ ទឹកដី របស់ ខ្លួន ជាច្រើន ត្រឡប់ មកវិញ ដែរ ។ ក៏ប៉ុន្តែ លោក ស្ដូលធិន បឺ គ បាន ព្រមាន ថា មិន មាន សញ្ញា ណាមួយ ដែល បង្ហាញ ថា លោក ពូទីន នឹង បោះបង់ ចោល មហិច្ឆតា គ្រប់គ្រង អ៊ុយក្រែន ទាំងមូល នោះ ទេ ។
គួរ បញ្ជាក់ ថា បើ តាម លោក ស្ដូលធិន បឺគ លោក ពូទីន បាន ត្រៀម ខ្លួន ជាស្រេច សម្រាប់ សង្រ្គាម រយៈពេល វែង និង ការបើកប្រតិបត្តិការ វាយលុក សា ជា ថ្មី ៕
ជំហរ គាំទ្រ លើ នយោបាយ បៃតង របស់ កម្ពុជា ពីសំណាក់ រដ្ឋាភិបាល អាល្លឺម៉ង់ បាន ធ្វើឡើង នៅក្នុង ជំនួប ពិភាក្សា ការងារ ទ្វេ ភាគី រវាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក អូឡាហ្វ ឆុលស៍ អធិការបតី អាល្លឺម៉ង់ នៅ ទីក្រុង ព្រុច សែល ប្រទេស បែល ហ្ស៉ិក កាលពី ថ្ងៃទី ១៤ ខែធ្នូ ឆ្នាំ ២០២២ កន្លងទៅ នេះ ។
យោង តាម ក្រសួង ការបរទេស កម្ពុជា បាន គូសបញ្ជាក់ ថា ក្នុង ជំនួប នោះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន សម្តែង នូវ សេចក្តី ពេញចិត្ត ចំពោះ វឌ្ឍនភាព ដែល កម្ពុជា និង អាល្លឺម៉ង់ សម្រេចបាន រួមគ្នា ក្នុង រយៈពេល ជាច្រើន ឆ្នាំ កន្លងមក ហើយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី សង្ឃឹម ថា កិច្ចសហប្រតិបត្តិការ នឹង បន្ត រីកចម្រើន លើ វិស័យ នានា ដែល មាន ផលប្រយោជន៍ ទៅ វិញ ទៅ មក ដូចជា ពាណិជ្ជកម្ម វិនិយោគ សេដ្ឋកិច្ច ឌីជីថល ធនធាន មនុស្ស និង សហគ្រាស ខ្នាត មីក្រូ ធុន តូច និង មធ្យម ជាដើម ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ឆ្លៀត ឱកាស ថ្លែងអំណរគុណ ដល់ អាល្លឺម៉ង់ ដែល បាន លក់ ម៉ាស៊ីនភ្លើង ២០០ មេហ្គាវ៉ាត់ មក ឱ្យ កម្ពុជា ក្នុង ឆ្នាំ ២០១៩ ដើម្បី បំពេញ តម្រូវការ ថាមពល ដោយសារ គ្រោះ រាំងស្ងួត ធ្ងន់ធ្ងរ ។ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ចែករំលែក ជូន លោក អូឡាហ្វ ឆ្លុលស៍ ថា បច្ចុប្បន្ន នេះ ថាមពល កកើត ឡើងវិញ ចូលរួមចំណែក ដល់ ទៅ ៦២ ភាគរយ នៃ ការផ្គត់ផ្គង់ ថាមពល របស់ កម្ពុជា ហើយ កម្ពុជា មាន ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ ឆ្ពោះ ទៅរក ថាមពល ស្អាត និង បៃតង នា ពេល អនាគត ដ៏ ខ្លី ខាងមុខ នេះ ។
ជា ការឆ្លើយតប លោក អូឡាហ្វ ឆុលស៍ បាន កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ កម្ពុជា ក្នុង ការជំរុញ ការអភិវឌ្ឍ និង ការកែលម្អ សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ ។ លោក អធិការបតី អាល្លឺម៉ង់ ក៏ បាន ស្វាគមន៍ ចំពោះ ការប្តេជ្ញាចិត្ត របស់ កម្ពុជា ឆ្ពោះ ទៅរក អនាគត បៃតង និង បាន បង្ហាញ ពី ការត្រៀមខ្លួន របស់ អាល្លឺម៉ង់ ដើម្បី គាំទ្រ ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង នេះ ។
ពាក់ព័ន្ធ នឹង បញ្ហា ថាមពល នេះ ដែរ លោក អធិការបតី បាន ចែករំលែក ជូន សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ថា អាល្លឺម៉ង់ កំពុង បង្កើន កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ខ្លួន ទ្វេ ដង ដើម្បី ក្លាយជា ប្រទេស ឯករាជ្យ ខាង ថាមពល ហើយ បាន លើកឡើង ថា កម្ពុជា បាន ធ្វើ ការសម្រេចចិត្ត ត្រឹមត្រូវ ពាក់ព័ន្ធ នឹង យុទ្ធសាស្ត្រ ថាមពល របស់ ខ្លួន ៕
ការចែល រំលែក នូវ ទស្សនៈ រវាង សម្តេច តេជោ និង លោក អធិការបតី អាល្លឺម៉ង់ ជុំវិញ សង្គ្រាម រុស្ស៉ី និង អ៊ុយក្រែន បាន ធ្វើឡើង នៅក្នុង ជំនួប ពិភាក្សា ការងារ ទ្វេ ភាគី នៅ ទីក្រុង ព្រុច សែល ប្រទេស បែល ហ្ស៉ិក ទី ដែល សម្តេច តេជោ អញ្ជើញ ជា សហ ប្រធាន កិច្ចប្រជុំ កំពូល អាស៊ាន - សហភាព អឺរ៉ុប កាលពី ថ្ងៃទី ១៤ ខែធ្នូ កន្លងទៅ នេះ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី មាន ជំនឿ ថា អាល្លឺម៉ង់ មាន តួនាទី សំខាន់ ក្នុង ការនាំមក នូវ ដំណោះស្រាយ ដោយ សន្តិវិធី ចំពោះ សង្គ្រាម នៅ អ៊ុយក្រែន ។ ជាង នេះ ទៅ ទៀត សម្តេច តេជោ បាន បង្ហាញ ក្តីសង្ឃឹម ថា ភាគី ពាក់ព័ន្ធ ទាំងឡាយ នឹង ចៀសវាង ពី សកម្មភាព នានា ដែល អាច បង្កើន អំពើហិង្សា ថែម ទៀត ហើយ នឹង មាន ការបង្កើត បរិយាកាស មួយ ដែល អំណោយផល សម្រាប់ ផ្តល់ ជំនួយ មនុស្សធម៌ ជូន អ្នក ដែល ត្រូវការ បំផុត ។
សម្តេច តេជោ ក៏ បាន ជម្រាប ជូន លោក អធិការបតី ផងដែរ ថា កម្ពុជា នឹង រៀបចំ វគ្គ បណ្តុះបណ្តាល ផ្តល់ ជូន អ្នកដោះ មីន អ៊ុយក្រែន ចំនួន ១៥នាក់ នៅ រាជធានី ភ្នំពេញ នៅក្នុង ខែមករា ឆ្នាំ ២០២៣ ខាងមុខ ហើយ កម្ពុជា នឹង បញ្ជូន ក្រុម ជំនាញ ការដោះ មីន ទៅ រៀបចំ វគ្គ បណ្តុះបណ្តាល សម្រាប់ អ្នកដោះ មីន អ៊ុយក្រែន បន្ថែម ទៀត នៅ ប៉ូឡូញ នៅក្នុង ខែមេសា ឆ្នាំ ២០២៣ ដោយ មាន ការគាំទ្រ ពី ប្រទេស ជប៉ុន ។
តាមរយៈ បណ្តាញ សង្គម ហ្វេសប៊ុក លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ដូច្នេះ « ក្នុង នាម ជា ក្មេង ជំនាន់ ក្រោយ ម្នាក់ ខ្ញុំ មិន នឹកស្មាន ថា លោក សម រង្សី គ្មាន ភាព ខ្មាស អៀន ដល់ ថ្នាក់ នេះ ។ ហ៊ាន ចេញ សារ លើ បណ្តាញ សង្គម របស់ ខ្លួន ជា ភាសា ខ្មែរ ផង ជា ភាសា អង់គ្លេស ផង រិះគន់ សម្តេច តេជោ ពាក់ព័ន្ធ ករណី ក្លែងបន្លំ តួនាទី ជា ប្រធាន អាស៊ាន ដែល ខ្លួន ទាំង មិន យល់ ច្បាស់ អំពី អាណត្តិ របស់ ប្រធាន អាស៊ាន ផង » ។
លោក បណ្ឌិត បាន បន្ថែម ថា « និយាយ ឱ្យ ខ្លី គឺ លោក សម រង្សី ចង់ បង្ហាញ ថា មាន តែ គាត់ ទេ ដែល ឆ្លាតវៃ ជាង គេ ហើយ យល់ អំពី អណត្តិ របស់ ប្រធាន អាស៊ាន ច្បាស់ជាង ប្រធានាធិបតី បារាំង ថ្នាក់ដឹកនាំ សហភាព អឺរ៉ុប និង ថ្នាក់ដឹកនាំ អាស៊ាន ។ ខ្ញុំ អាន សារ របស់ គាត់ ច្រើន ដង ហើយ នៅតែ ហួសចិត្ត ដែល គាត់ អាច សរសេរ សារ បែប នេះ ទៅ រួច ព្រមទាំង បង្ហោះ សារជា សាធារណៈ ជា ភាសា ខ្មែរ និង ភាសា អង់គ្លេស អោយ បរទេស អាច អាន ទៀត » ។
សូម បញ្ជាក់ ថា លោ សម រង្ស៉ី ជន ដែល សម្តេច តេជោ ប្រសិទ្ធ នាម ជន ក្បត់ ជាតិ ៣ជំនាន់ កាលពី ថ្ងៃទី ១៣ ខែធ្នូ ឆ្នាំ ២០២២ កន្លងទៅ បាន សរសេរ សារ លើ ហ្វេសប៊ុក របស់ ខ្លួន ថា សម្តេច តេជោ ហ៊ុន សែន លួច ប្រើ តួនាទី ជា ប្រធាន អាស៊ាន ដើម្បីឱ្យ ប្រធានាធិបតី បារាំង អេម៉ានុយ អែល ម៉ាក្រុង ទទួល ជា ផ្លូវការ នៅ ថ្ងៃ ១៣ ខែធ្នូ ឆ្នាំ ២០២២ ។ តាម ការពិត ប្រធានាធិបតី ឥណ្ឌូនេស៊ី ចូកូ វីដូដូ ទេ ដែល ជា ប្រធាន អាស៊ាន បច្ចុប្បន្ន ។
យោង តាម ធម្មនុញ្ញ របស់ អាស៊ាន បាន ចែង ថា ឋានៈ ជា ប្រធាន អាស៊ាន ត្រូវ ប្តូរ វេន ជារៀងរាល់ ឆ្នាំ តាម លំដាប់ អក្ខរ ក្រម នៃ ឈ្មោះ ជា ភាសា អង់គ្លេស របស់ រដ្ឋ សមាជិក ក្នុង រយៈពេល ពេញ មួយ ឆ្នាំ ប្រតិទិន « ពោលគឺ ចាប់ផ្តើម ពី ថ្ងៃទី ០១ ខែមករា នៃ ឆ្នាំ រហូតដល់ ថ្ងៃទី ៣១ ខែធ្នូ នៃ ឆ្នាំ ដដែល នោះ ។
ការប្រគល់ ញញួរ ប្រធាន អាស៊ាន ដែល ធ្វើឡើង នៅ មុន ដំណាច់ ឆ្នាំ ប្រតិទិន នោះ គ្រាន់តែ ជា ការប្រគល់ ទុក ជាមុន ជា និមិត្តរូប ក្នុង ពេល នៃ ការបិទ បញ្ចប់ កិច្ចប្រជុំ កំពូល អាស៊ាន ប៉ុន្តែ ពុំ មែន មាន ន័យ ថា ចប់ អាណត្តិ របស់ ប្រធាន អាស៊ាន កំពុង កាន់ នោះ ឡើយ ។ ដូច្នេះ ឋានៈ ជា ប្រធាន អាស៊ាន របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន ចាប់ផ្តើម ពី ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២២ រហូតដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ ទើប ចប់ អាណត្តិ ។
