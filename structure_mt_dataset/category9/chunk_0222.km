( ភ្នំពេញ ) ៖ មុននឹង បិទ បញ្ចប់ ទំព័រ ឆ្នាំ ចាស់ ឆ្នាំ ២០២២ នៅ ថ្ងៃសុក្រ ទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក វ៉ាង វិន ធៀន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ នៅ កម្ពុជា បន្ត ដឹក ដៃ គ្នា ធ្វើជា សហធិបតី បើក ការដ្ឋាន ស្តារ និង លើកកម្រិត គុណភាព ផ្លូវ ពីរ ខ្សែ ទៀត ស្ថិត ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពត និង ខេត្ត កែប ដែល ជា ចំណង ដៃ ដ៏ ពិសិដ្ឋ សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពត និង ខេត្ត កែប ។
គម្រោង ស្ថាបនា ផ្លូវ ជាតិ ទាំង ពីរ ខ្សែ នេះ ក៏ មាន រៀបចំ ផ្លាក សញ្ញា ចរាចរណ៍ គំនូស ចរាចរណ៍ បង្គោល គីឡូម៉ែត្រ បង្គោល សុវត្ថិភាព ទៅ តាម បទដ្ឋាន បច្ចេកទេស ផ្លូវថ្នល់ និង បំពាក់ កាំមេរ៉ា ត្រួតពិនិត្យ ល្បឿន ចំនួន ៥កន្លែង នៅលើ ខ្សែ ផ្លូវ នីមួយ ៗ ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ឱ្យ Fresh News ដឹង ថា ផ្លូវ ជាតិ ទាំង ពីរ ខ្សែ នេះ នឹង ត្រូវ អនុវត្ដ ការសាងសង់ ដោយ ក្រុមហ៊ុន សាជីវកម្ម ស្ពាន និង ថ្នល់ ចិន (CRBC) និង ត្រួតពិនិត្យ បច្ចេកទេស ដោយ ក្រុមហ៊ុន ទីប្រឹក្សា បច្ចេកទេស ក្វាង ចូវ វ៉ាន អាន ។ ផ្លូវ ទាំង ពីរ ខ្សែ គ្រោង ប្រើ ពេលវេលា សាងសង់ ចំនួន ៤០ ខែ ដោយ គ្រោង បញ្ចប់ ការសាងសង់ នៅក្នុង ឆ្នាំ ២០២៦ ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី គម្រោង ស្តារ និង លើកកម្ពស់ គុណភាព ផ្លូវ ជាតិ លេខ ៣១ គ្រោង ចំណាយ ថវិការ ជាង ៦០ លាន ដុល្លារ អាមេរិក និង ផ្លូវ ជាតិ លេខ ៣៣ គ្រោង ចំណាយ ជាង ៦១ លាន ដុល្លារ អាមេរិក ដែល ជា ឥណទាន សម្បទាន ពី រដ្ឋាភិបាល ចិន រួម ជាមួយ ថវិកា បដិភាគ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រាប់ ការដោះស្រាយ ផល ប៉ះពាល់ និង ពន្ធ អាករ ផ្សេង ៗ ។
ផ្លូវ ជាតិ ទាំង ពីរ ខ្សែ នេះ ក៏ នឹង ផ្តល់ អត្ថប្រយោជន៍ យ៉ាង ធំធេង ដល់ សេដ្ឋកិច្ច ជាតិ និង សេដ្ឋកិច្ច គ្រួសារ តាមរយៈ ការសម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ និង ការដឹកជញ្ជូន គ្រប់ ប្រភេទ ដែល នឹង ប្រែក្លាយ តំបន់ ឆ្នេរ ឱ្យ ក្លាយទៅជា តំបន់ ដែល មាន ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ល្អ ប្រសើរ និង ប្រទាក់ ក្រឡា គ្នា ដើម្បី រួមចំណែក នៅក្នុង ការជំរុញ ការផ្លាស់ប្តូរ ពាណិជ្ជកម្ម ការវិនិយោគ និង ទាក់ទាញ ភ្ញៀវ ទេសចរ បន្ថែម ទៀត ។
លោក ទេសរដ្ឋមន្ត្រី បាន សង្កត់ធ្ងន់ ថា ប្រជាពលរដ្ឋ ខ្មែរ ត្រូវតែ ចងចាំ គុណូបការៈ និង គំរូវីរភាព ដ៏ ឧត្តុង្គឧត្តម របស់ សម្ដេច តេជោ ដែល បាន ខិតខំ ប្រឹងប្រែង ស្វែងរក សន្តិភាព ជូន កម្ពុជា និង បាន លះបង់ ទាំង កម្លាំង កាយ និង កម្លាំងចិត្ត ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ ឱ្យ ទទួលបាន ការអភិវឌ្ឍ រីកចម្រើន ដូច នា ពេល បច្ចុប្បន្ន នេះ ៕
ខាងក្រោម នេះ ជា ព្រឹត្តិការណ៍ ពិភពលោក ធំ ៗ ប្រចាំ ២០២២៖
អភិបាល ខេត្ត កណ្ដាល ជួប សំណេះសំណាល និង ដោះស្រាយ រាល់ សំណូមពរ របស់ ក្រុម អង្គការ សង្គម ស៊ីវិល ជិត ៥០០ អង្គភាព ប្រកបដោយ ស្នាមញញឹម
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល នៅ រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ជួយ សំណេះសំណាល និង ធ្វើ ការពិគ្រោះយោបល់ រវាង រដ្ឋបាល ខេត្ត កណ្តាល ជាមួយ អង្គការ សមាគម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ជិត ៥០០ អង្គភាព អំពី សកម្មភាព ការងារ ដែល ស្ថិត ក្នុង ភូមិសាស្ត្រ ខេត្ត កណ្តាល សម្រាប់ ឆ្នាំ ២០២២ ក៏ ដូចជា ការទទួល ស្តាប់ សំណើរ និង យក បញ្ហា ប្រឈម នានា ដើម្បី ដោះស្រាយ ជូន ភ្លាម ៗ ។
លោក គង់ សោភ័ណ្ឌ បាន បន្ត ទៀត ថា សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ក្នុង ស្រុក ដែល មាន បំណង ធ្វើ សកម្មភាព នៅក្នុង ដែន សមត្ថកិច្ច រដ្ឋបាល រាជធានី - ខេត្ត ណាមួយ អាច ជូនដំណឹង មក ក្រសួង មហាផ្ទៃ អំពី ការបើក សាខា សម្រាប់ ប្រត្តិការ ឬ អនុវត្ត សកម្មភាព របស់ ខ្លួន នៅក្នុង រាជធានី - ខេត្ត នោះ ឬ អាច ជូនដំណឹង ដោយ ផ្ទាល់ ទៅ រាជធានី - ខេត្ត ក្នុង រយៈ ពេល ៣ ថ្ងៃ មុន ចាប់ផ្ដើម សកម្មភាព ដោយ ភ្ជាប់ ជាមួយ នូវ គម្រោង សកម្មភាព របស់ ខ្លួន ផង ។
គួរ បញ្ជាក់ ដែរ ថា ចំពោះ បញ្ហា ប្រឈម និង សំណូមពរ មួយចំនួន ដែល បាន លើកឡើង នៅក្នុង អង្គ ទិកា ត្រូវបាន ដោះស្រាយ ភ្លាម ៗ នៅក្នុង កិច្ចសន្ទនានា អង្គ វេទិកា ដោយ ផ្ទាល់ តែ ម្តង និង អ្វី ដែល នៅ សេសសល់ អាជ្ញាធរ ខេត្ត និង សមត្ថកិច្ច ពាក់ព័ន្ធ សន្យា ថា នឹង ពិភាក្សា រក ដំណោះស្រាយ ជា បន្តបន្ទាប់ ។
បង្ក្រាប បាន ជនសង្ស័យ ២នាក់ ដែល ជា មុខសញ្ញា ចោរ ឆក់ យ៉ាង សកម្ម នៅ ភូមិសាស្ត្រ ក្រុង ព្រះសីហនុ
ប្រភព ពី កម្លាំង សមត្ថកិច្ច បាន ឱ្យដឹង ថា ជនសង្ស័យ ចំនួន ០២ នាក់ មាន ឈ្មោះ គឹម នៅ ស៊ីណុច ហៅ ណុច ភេទ ប្រុស អាយុ ២២ ឆ្នាំ មុខរបរ និង ស្នាក់ នៅ មិន ពិតប្រាកដ និង ឈ្មោះ ឃួន ឧស្សាហ៍ ហៅ យក្ស ភេទ ប្រុស អាយុ ២០ ឆ្នាំ មុខរបរ និង ស្នាក់ នៅ មិន ពិតប្រាកដ និង ដកហូត បាន វត្ថុតាង ដកហូត បាន ម៉ូតូ ០១ គ្រឿង ម៉ាក ហុងដា សេ១២៥ ពណ៌ ខ្មៅ ស៊េរី ឆ្នាំ ២០២២ ។
ឈរ លើ ស្មារតី ខាង លើ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន សម្រេច ដាក់ ចេញ ផែនការចាក់ វ៉ាក់សាំង ដូស ជំរុញ ដូច ខាងក្រោម៖ ១៖ ចាក់ ដូស ជំរុញ ទី៤ ដល់ កុមារ អាយុ ពី ៣ ឆ្នាំ ដល់ ក្រោម ៥ឆ្នាំ ។ ២៖ ចាក់ ដូស ជំរុញ ទី៥ ដល់ កុមារ អាយុ ពី ៥ ឆ្នាំ ដល់ ក្រោម ១២ឆ្នាំ ។ ៣៖ ចាក់ ដូស ជំរុញ ទី៦ មន្ត្រីរាជការ ជួរ មុខ អាជ្ញាធរ និង ប្រជាជន ទូទៅ ។
សម្តេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា ផែនការចាក់ ដូស ជំរុញ ខាង លើ នេះ គឺជា រៀបចំ ដើម្បី ធានា សុវត្ថិភាព សុខភាព របស់ ប្រជាពលរដ្ឋ ។
ក្នុង សារជា សំឡេង នេះ សម្តេច តេជោ ក៏ បាន ឯកភាព ចេញ ជា គោលការណ៍ លើ ការចាក់ ដូស ជំរុញ បន្ត បន្ទាប់ ដោយ ធ្វើជា រៀងរាល់៦ ខែម្តង ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន សង្កត់ធ្ងន់ ថា ការធ្វើ បែប នេះ ទើប ធានា ដល់ ភាពសុាំ សហគមន៍ រឹងមាំ ។
សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ មិន ទាន់ បាន ទទួល ដូស ជំរុញ ទី៣ ទី៤ ទី៥ និង ទី៦ ឱ្យ នាំគ្នា ទៅ ទទួលយក ដូស ជំរុញ តាម គោលការណ៍ ណែនាំ របស់ ក្រសួង សុខាភិបាល ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ឱ្យ គណៈកម្មការ ចំពោះ កិច្ច រៀបចំ ផែនការផ្តល់ វ៉ាក់សាំង ដូស ជំរុញ តាម ការណែនាំ ខាងលើ នេះ ដើម្បី ធានា ដល់ ក្រវាត់ ការពារ សុខភាព ពលរដ្ឋ ពី ជំងឺ កូវីដ១៩ ។
សម្តេច តេជោ បាន គូសបញ្ជាក់ ថា ពេលនេះ កង្វល់ របស់ សម្តេច ក៏ ដូចជា រាជ រដ្ឋាភិបាល មិន មែន រឿង ខ្វះ វ៉ាក់សាំង ទេ តែ បារម្ភ ខ្លាច ពលរដ្ឋ មិន មក ទទួល វ៉ាក់សាំង ។ ទោះជា យ៉ាងណា សម្តេច មាន ការជឿជាក់ ថា កុមារ នឹង នាំគ្នា មក ទទួល វ៉ាក់សាំង ដូស ជំរុញ តាម ផែនការ ដូច បាន បញ្ជាក់ ខាងលើ ។
បើ តាម សម្តេច តេជោ ហ៊ុន សែន បច្ចុប្បន្ន កម្ពុជា មាន វ៉ាក់សាំង ៧លាន ដូស នៅក្នុង ឃ្លាំង និង មិន ទាន់ នាំចូល ជាច្រើន លាន ដូស ទៀត ។ ដូច្នេះ កម្ពុជា មិន ខ្វះ វ៉ាក់សាំង ចាក់ ជូន ប្រជាពលរដ្ឋ នោះ ឡើយ ៕
១៖ ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ បន្ត រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ១៣នាក់ ខណៈ អ្នក ជាសះស្បើយ ១៦ នាក់
២៖ អនុ រដ្ឋមន្ត្រី រុស្ស៉ី៖ លោក ខាងលិច ប្រើប្រាស់ អ៊ុយក្រែន ដើម្បី ចាប់ផ្តើម សង្គ្រាម អ៊ីនធឺណិត ប្រឆាំង នឹង រុស្ស៊ី
៣៖ សម្តេច តេជោ ហ៊ុន សែន អបអរសាទរ ខួប ២៤ ឆ្នាំ នៃ ការបញ្ចប់ សង្គ្រាម នៅ កម្ពុជា ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ
៤៖ វិមាន ក្រឹមឡាំង ថា រាល់ ផែនការ សន្តិភាព នៅ អ៊ុយក្រែន ត្រូវតែ មាន បញ្ចូល ទឹកដី ដែល រុស្ស៉ី កាត់ យក
៥៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ផ្តល់ អនុសាសន៍ ៧ ចំណុច ដើម្ប បន្ត លើកកម្ពស់ ស្មារតី ថែរក្សា សន្តិភាព និង រំឭក ខួប នៃ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ
៦៖ ប្រមុខ អង្គការ សហ ប្រជាជាតិ អំពាវនាវ ឱ្យ ប្រទេស ទាំងអស់ តម្កល់ « សន្តិភាព » ជា ធំ ទាំង ក្នុង ពាក្យសម្តី និង សកម្មភាព
៨៖ សហរដ្ឋ អាមេរិក យល់ព្រម លក់ ប្រព័ន្ធ អាវុធ ប្រឆាំង រថក្រោះ ឱ្យ តៃវ៉ាន់ ក្នុង តម្លៃ ១៨០ លាន ដុល្លារ
៩៖ បិទ ទំព័រ ឆ្នាំ ចាស់ ជាមួយ ការដ្ឋាន ស្តារ និង លើកកម្រិត គុណភាព ផ្លូវ ជាតិ លេខ ៣១ និង ៣៣ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន
១០៖ សហរដ្ឋ អាមេរិក សហភាព អឺរ៉ុប និង NATO ជំរុញ ឱ្យ មាន ការអត់ធ្មត់ ជា អតិបរមា ខណៈ ស៊ែរប៊ី និង កូសូវ៉ូ បិទ ព្រំដែន
១១៖ កំពង់ផែ សីហនុ រក ចំណូល បាន ប្រមាណ ៦៥ លាន ដុល្លារ ក្នុង រយៈពេល ៩ខែ ឆ្នាំ ២០២២
១២៖ លោក ហ្សេលេន ស្គី៖ អ៊ុយក្រែន ក្លាយជា មេដឹកនាំ ពិភពលោក មួយ ហើយ
១៣៖ ប្រមុខ ការទូត កម្ពុជា ជឿជាក់ ថា បណ្ឌិត កៅ គឹម ហួន ក្នុង ឋានៈ ជា អគ្គ លេខាធិការ អាស៊ាន នឹង ប្រឹង រក ផលប្រយោជន៍ រួម សម្រាប់ គ្រួសារ អាស៊ាន
១៤៖ សោកនាដកម្ម មនុស្ស ជាន់ គ្នា ស្លាប់ ធំ ៗ ពីរ ដែល បាន កើតឡើង ក្នុង ឆ្នាំ ២០២២
១៥៖ កម្ពុជា ផ្អាក នាំចូល អំបិល មក ផ្គត់ផ្គង់ តម្រូវការ ក្នុង ស្រុក ខណៈ រដូវ ប្រមូល ផល អំបិល ជិត ចូល មកដល់
១៦៖ រដ្ឋមន្ត្រី ការពារ ជាតិ អ៉ី ស្រាអែល មើលឃើញ ពី លទ្ធភាព វាយប្រហារ លើ អ៉ីរ៉ង់ ក្នុង ពេល ២ ទៅ ៣ឆ្នាំ ខាងមុខ
១៧៖ វិភាគ អន្តរជា តិ៖ ហេតុ អ្វី ប្រទេស ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ សម្រុក បញ្ជាទិញ នាវា មុជទឹក ?
៥នាក់ ស្លាប់ និង ៣៧ នាក់ រងរបួស ក្នុង គ្រោះ អគ្គិភ័យ រូង ក្រោម ដី នៅ កូរ៉េ ខាងត្បូង
អគ្គីភ័យ បាន ឆាបឆេះ នៅ ម៉ោង ប្រហែល ១: ៤៩រសៀល ម៉ោង ក្នុង ស្រុក បន្ទាប់ពី ឧបទ្ទវហេតុ បុក គ្នា រវាង រថយន្តក្រុង ដឹក អ្នកដំណើរ និង រថយន្ត ដឹក ទំនិញ ដែល បង្ករឲ្យ មាន ការឆាបឆេះ និង រាលដាល អណ្តាត ភ្លើង ទៅកាន់ ផ្លូវ រូង ក្រោម ដី តាម បណ្តោយ ផ្លូវ ល្បឿន លឿន Gyeongin ។
មនុស្ស ៥នាក់ ត្រូវបាន គេ ប្រទះឃើញ ស្លាប់ នៅក្នុង រថយន្ត ដែល បុក គ្នា ។ ចំនួន អ្នកស្លាប់ ដំបូង មាន ចំនួន ៦នាក់ ប៉ុន្តែ ត្រូវបាន កែសម្រួល មក នៅ ត្រឹម ៥នាក់ នៅ ពេល ក្រោយ ។
បី នាក់ ផ្សេង ទៀត ស្ថិត ក្នុង ស្ថានភាព ធ្ងន់ធ្ងរ ដែល បន្សល់ទុក លទ្ធភាព នៃ ការស្លាប់ បន្ថែម ខណៈ ដែល មនុស្ស ៣៤ នាក់ បាន រងរបួស ស្រាល បន្ទាប់ពី ស្រូប ផ្សែង ៕ ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែ ធ្នូ៖ បង្ក្រាប ២១ករណី ឃាត់ខ្លួន ៦៤ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ជួញដូរ ១២ករណី . ដឹកជញ្ជូន រក្សាទុក ៤ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៦៤ នាក់ ។
( ប៉េកាំង ) ៖ ឆ្នាំ ២០២២ លោក Xi Jinping ប្រធាន រដ្ឋ ចិន បាន ចេញ បំពេញ ទស្សនកិច្ច ជា៣លើ ក ហើយ ទៅកាន់ ប្រទេស ចំនួន ៥ ចេញផ្សាយ សម្លេង ប្រទេស ចិន ក្នុង ឆាក អន្តរជាតិ ព្រម និង ផ្តល់ គម្រោង ចិន និង រួមចំណែក ប្រាជ្ញា ចិន ដល់ ការគ្រប់គ្រង ពិភពលោក ។ដាន ជើង បំពេញ ទស្សនកិច្ច មិន គ្រាន់តែ កត់ត្រា រូបរាង ដ៏ មមាញឹក របស់ មេដឹកនាំ ប្រទេស ធំ ប៉ុណ្ណោះ ទេ ក៏ បញ្ជាក់ ពី សមិទ្ធផល ថ្មី នៃ ការទូត របស់ ប្រទេស ចិន ផងដែរ ។
អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ចេញ សេចក្ដីថ្លែងការណ៍ អបអរសាទរ ខួប ទិវា ជា ប្រវត្តិសាស្រ្ត របស់ ជាតិ « ទិវា នយោបាយ ឈ្នះ ឈ្នះ »
( ភ្នំពេញ ) ៖ នៅក្នុង ឱកាស នៃ ខួប ទិវា ជា ប្រវត្តិសាស្រ្ត របស់ ជាតិ « ទិវា នយោបាយ ឈ្នះ ឈ្នះ » អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន ចេញ សេចក្ដីថ្លែងការណ៍ សម្តែង នូវ អំណរ សារទរ និង គុណូបការៈ ខ្ពង់ខ្ពស់ បំផុត ចំពោះ ឥស្សរជន ជា វីរបុរស សម្រាប់ ប្រជាជាតិ ដែល បាន នាំមក នូវ សន្តិភាព ពេញលេញ ឯកភាព ទឹកដី និង ឯកភាព ជាតិ ក្រោម ម្លប់ ដ៏ ត្រជាក់ ត្រជុំ នៃ ព្រះមហាក្សត្រ រដ្ឋធម្មនុញ្ញា និង រាជ រដ្ឋាភិបាល ដែល កើតឡើង ចេញពី ការ បោះឆ្នោត ។
រយៈពេល ម្ភៃ បួន ឆ្នាំ ( ២៤ ឆ្នាំ ) កន្លងមក នេះ គឺ ចាប់ពី ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ដល់ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ ជា សម័យកាល នាំមក នូវ សុខ សន្តិភាព ដែល ជា មរតក ប្រវត្តិសាស្រ្ត របស់ ប្រជាជាតិ ក្រោម ការផ្តួចផ្តើម ទាំង គោល នយោបាយ និង ដឹកនាំ អនុវត្ត នូវ យុទ្ធសាស្រ្ត ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា រួម ជាមួយនឹង ឥស្សរជន ប្រតិបត្តិករ គ្រប់ ភាគី ដែល នាំមក នូវ យុគសម័យ ថ្មី របស់ កម្ពុជា ពុំ ធ្លាប់ មាន ក្នុង រយៈកាល ជាង ៥០០ ឆ្នាំ កន្លងមក ។
ការថ្លែង របស់ សម្តេច តេជោ ធ្វើឡើង នៅក្នុង ឱកាស អញ្ជើញ បើក ការដ្ឋាន ស្តារ និង លើកកម្រិត គុណភាព ផ្លូវ ពីរ ខ្សែ ទៀត ស្ថិត ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពត និង ខេត្ត កែប នា ព្រឹក ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ។
សម្តេច បាន ថ្លែង បន្ត ថា ការប្រមូល នូវ ចំណូល លើស ផែនការ នេះ គឺជា ការផ្តល់ ឱកាស ដល់ រាជ រដ្ឋាភិបាល ធ្វើ ការ វិនិយោគ ទៅ លើ ហេដ្ឋ រចនាសម្ព័ន្ធ ចាំបាច់ នានា ។
ជាមួយគ្នា នេះ សម្តេច បាន អំពាវនាវ ដល់ អាជ្ញាធរ គ្រប់ ផ្នែក និង គ្រប់ ជាន់ ថ្នាក់ បន្ត គាំទ្រ ផ្នែក គយ និង ពន្ធដារ បន្ថែម ទៀត ដើម្បីឱ្យ ការប្រមូល ចំណូល កាន់តែ ប្រសើរឡើង ។
អ៊ុយក្រែន៖ ប្រជាជន ក្នុង រដ្ឋធានី កៀវ ត្រូវបាន ណែនាំឲ្យ រត់ រក កន្លែង មាន សុវត្ថិភាព ខណៈ សំឡេង ស៉ី រ៉ែន បន្លឺ ឡើង ពេញ រដ្ឋធានី
( កៀវ ) ៖ ប្រជាជន នៃ រដ្ឋធានី កៀវ របស់ អ៊ុយក្រែន ត្រូវបាន ណែនាំឲ្យ រត់ រក កន្លែង មាន សុវត្ថិភាព នៅ ព្រឹក ថ្ងៃសុក្រ នេះ ខណៈ សំឡេង ស៊ីរ៉ែន បាន បន្លឺ ពេញ រដ្ឋធានី មួយ ថ្ងៃ បន្ទាប់ពី រុស្ស៊ី បើក ការវាយលុក ពីលើ អាកាស ដ៏ ធំ បំផុត ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង មក ។ នេះ បើ យោង តាម ការចុះផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសុក្រ ទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ ។
បើ តាម សាក្សី នៅ ចម្ងាយ ២០ គីឡូម៉ែត្រ ភាគ ខាងត្បូង នៃ ទីក្រុង កៀវ បាន ឮ ការផ្ទុះ ជាច្រើន លើក និង សំឡេង នៃ ការបាញ់ ទម្លាក់ យន្តហោះ ។ រីឯ ក្រសួង ការពារ ជាតិ អ៊ុយក្រែន បាន ឲ្យដឹង ថា អគារ លំនៅដ្ឋាន ជាង ១៨ ទីតាំង និង ការដំឡើង ហេដ្ឋារចនាសម្ព័ន្ធ សំខាន់ ៗ ចំនួន ១០ ត្រូវបាន បំផ្លាញ ក្នុង ការវាយប្រហារ ថ្មី ចុងក្រោយ នេះ ។
រដ្ឋមន្ត្រី លឹម គាន ហោ លើកទឹកចិត្ត ដល់ សិស្ស ប្រឡង បាក់ឌុប នៅ ស្រុក ពញា ឮ ខេត្ត កណ្តាល . សិស្ស និទ្ទេស A ទទួលបាន ម៉ូតូ១ គ្រឿង និង សិស្ស និទ្ទេស ផ្សេង ទៀត ព្រមទាំង សិស្ស ប្រឡង ធ្លាក់ ក៏ ទទួលបាន ថវិកា ឧបត្ថម្ភ ដែរ
( ភ្នំពេញ ) ៖ លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក ពញា ឮ ខេត្ត កណ្តាល នៅ ព្រឹក ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ បេក្ខជន ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ ២០២១ - ២០២២ និង គណៈ គ្រប់គ្រង លោកគ្រូ - អ្នកគ្រូ ថ្នាក់ ទ១២ សរុប ចំនួន ៨៦២ នាក់ ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី លឹម គាន ហោ ក៏ បាន ឧបត្ថម្ភ ខាងក្រោម៖
សូម ជម្រាប ជូន ថា ក្នុង សម័យ ប្រលង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ នា ថ្ងៃទី ៥ - ៦ ខែធ្នូ ឆ្នាំ ២០២២ លោក រដ្ឋមន្ត្រី លឹម គាន ហោ និង ក្រុមការងារ ក៏ បាន ជួយ ឧបត្ថម្ភ កន្លែង ស្នាក់ នៅ ការធ្វើដំណើរ និង ការហូបចុក ដល់ បេក្ខជន ទាំងអស់ ផងដែរ និង ដើម្បី ជា ការលើកទឹកចិត្ត ដល់ ក្មួយ ៗ ដែល ទើបនឹង ប្រលង ជាប់ និង ពុំ បាន ប្រលង ជាប់ គណៈ គ្រប់គ្រង លោកគ្រូ - អ្នកគ្រូ ថ្នាក់ ទី១២ សរុប ចំនួន ៨៦២ នាក់ ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស អញ្ជើញ បើក ការដ្ឋាន ស្តារ និង លើកកម្រិត គុណភាព ផ្លូវ ជាតិ លេខ ៣១ និង ៣៣
( ភ្នំពេញ ) ៖ មុននឹង បិទ បញ្ចប់ ទំព័រ ឆ្នាំ ចាស់ ឆ្នាំ ២០២២ នៅ ថ្ងៃសុក្រ ទី៣០ ខែធ្នូ ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក វ៉ាង វិន ធៀន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ នៅ កម្ពុជា បាន បន្ត ដឹក ដៃ គ្នា ធ្វើជា សហធិបតី បើក ការដ្ឋាន ស្តារ និង លើកកម្រិត គុណភាព ផ្លូវ ពីរ ខ្សែ ទៀត ស្ថិត ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពត និង ខេត្ត កែប ដែល ជា ចំណង ដៃ ដ៏ ពិសិដ្ឋ សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពត និង ខេត្ត កែប ។
* ជា កិច្ច ចាប់ផ្តើម សំណេះសំណាល សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បង្ហាញ ការនឹករលឹក ជូន ពលរដ្ឋ អ្នក ខេត្ត កំពត និង បាន អរគុណ ដល់ ពលរដ្ឋ ខេត្ត កំពត បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កាលពី ខែមិថុនា កន្លងទៅ ។ សម្តេច តេជោ រំពឹង ថា អ្នក ខេត្ត កំពត បន្ត បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា នៅ ខែកក្កដា ឆ្នាំ ២០២៣ ដើម្បី សម្តេច មាន ឱកាស បម្រើ ជាតិ និង ប្រជាជន ហើយ ជំរុញ ភាពលូតលាស់ របស់ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ពិតជា រីករាយ ដែល ពេលវេលា មិន ដល់ មួយ សប្តាហ៍ បាន អញ្ជើញ រួមគ្នា ជាមួយ ឯក អគ្គ រដ្ឋទូត ចិន ចំនួន ២លើក ដើម្បី បើក ការដ្ឋាន ស្តារ និង លើកកម្ពស់ គុណភាព ផ្លូវ ចំនួន ៣ខ្សែ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ការកសាងឡើងវិញ ផ្លូវ ជាង លេខ ៣១ និង ៣៣ គឺជា សមិទ្ធផល ថ្មី មួយ ទៀត សម្រាប់ បម្រើ ប្រយោជន៍ ជូន ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ឆ្នាំ ២០២២ ទំហំ ពាណិជ្ជកម្ម កម្ពុជា និង ចិន សម្រេចបាន ប្រមាណ ១៤ ពាន់ ៥០០ លាន ដុល្លារ កើនឡើង ប្រមាណ ១៩ ភាគរយ កំណើត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បង្ហាញ ក្តី រំពឹង ថា ទំនិញ និង ផលិតផល របស់ កម្ពុជា កាន់តែ ច្រើន នឹង បង្ហាញ វត្តមាន លើ ទីផ្សារ របស់ ចិន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង រំលឹក ថា កាលពី ១០ឆ្នាំ មុន មាន ស្ថាប័ន ហិរញ្ញវត្ថុ មួយ បាន បង្គាប់បញ្ជា កម្ពុជា លើ ការផ្តល់ កម្ចី ។ បើ តាម សម្តេច តេជោ ស្ថាប័ន ហិរញ្ញវត្ថុ បង្គាប់ កម្ពុជា យក កម្ចី ទៅ ផ្តល់ អាហារូបករណ៍ ជូន សិស្ស តែ សម្តេច ថា កម្ចី នេះ ត្រូវ ធ្វើ សាលា ។ ការបង្គាប់បញ្ជា នេះ ធ្វើឱ្យ សម្តេច ឈប់ ខ្ចី លុយ ពី ស្ថាប័ន ហិរញ្ញវត្ថុ នោះ រហូតមក ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នយោបាយ អាទិភាព ៤យ៉ាង ( ទឹក ផ្លូវ ភ្លើង និង មនុស្ស ) នៅតែ ជា នយោបាយ មួយ ដែល ត្រឹមត្រូវ សម្រាប់ ការអភិវឌ្ឍ នៅ កម្ពុជា យ៉ាងតិច រយៈពេល ៣០ ឆ្នាំ ទៀត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការសាងសង់ ផ្លូវ ឆ្ពោះ មកកាន់ ខេត្ត កំពត គឺជា ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ ព្រោះ ខេត្ត កំពត មាន លក្ខណៈ ពិសេស ខុស គេ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ស៊ីម៉ង់តិ៍ នៅ កម្ពុជា មាន តម្រូវការ ខ្ពស់ ដែល ទាមទារ ឱ្យ មាន ការវិនិយោគ ផលិត បន្ថែម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា វត្តមាន ផ្លូវ ជាតិ លេខ ៥៥ ក្រោម ការជួយ របស់ ចិន បាន ធ្វើឱ្យ វាល វែង ក្លាយជា តំបន់ ទេសចរណ៍ ដ៏ ទាក់ទាញ ។
* សម្តេច តេជោ ហ៊ុន សែន បន្ត ថ្លែង រំលឹក ថា បើ គ្មាន រដ្ឋប្រហារ ទម្លាក់ សម្តេច នរោត្តម សីហនុ នៅ ថ្ងៃទី ១៨ ខែមីនា ឆ្នាំ ១៩៧០ ទេ នោះ កម្ពុជា នឹង មាន ការអភិវឌ្ឍ និង រីកចម្រើន ខ្លាំងក្លា ណាស់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ទោះ អ្នក ចាស់ បង្កើត សង្គ្រាម តែ សម្តេច និង កូន ខ្មែរ ជំនាន់ ក្រោយ មាន កាតព្វកិច្ច ក្នុង ការពន្លត់ ភ្លើង សង្គ្រាម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង រំលឹក ថា ការ ដែល សម្តេច ទទួល ជួប មេដឹកនាំ ខ្មែរ ក្រហម កាលពី ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ដើម្បី ផ្ញើ សារ ទៅកាន់ គោលដៅ ចំនួន ៣រួម មាន៖ បង្ហាញ ទាហាន ខ្មែរ ក្រហម សេសសល់ ឱ្យ ទម្លាក់ អាវុធ . ជូន ប្រជាពលរដ្ឋ កម្ពុជា ថា សង្គ្រាម ២៨ ឆ្នាំ ត្រូវបាន បញ្ចប់ . ផ្ញើ ជូន អន្តរជាតិ សូមអញ្ជើញ ទស្សនកិច្ច និង វិនិយោគ នៅ កម្ពុជា ព្រោះ សង្គ្រាម បាន បញ្ចប់ ហើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ទើប ធ្វើឱ្យ កម្ពុជា មាន ព្រះមហាក្សត្រ តែ មួយ រាជ រដ្ឋាភិបាល តែ មួយ កងកម្លាំង តែ មួយ និង ការគ្រប់គ្រង តែ មួយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង រំលឹក ថា សុខ សន្តិភាព មាន សារៈសំខាន់ ខ្លាំង ណាស់ ត្រូវតែ រួមគ្នា រក្សា ឱ្យ បាន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ភាព មិន ត្រូវ គ្នា នៃ នយោបាយ សេដ្ឋកិច្ច រវាង សម្តេច និង អ្នកជំនាញ ការវៀតណាម ទើប សម្តេច ស្នើ ឱ្យ ដក ជំនាញ ការវៀតណាម ពី កម្ពុជា ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្នកជំនាញ ការ របស់ វៀតណាម បាន ដក ចេញ ពី កម្ពុជា នៅ ថ្ងៃទី២ ខែមិថុនា ឆ្នាំ ១៩៨៨ ហើយ កងទ័ព វៀតណាម ដក នៅ ឆ្នាំ ១៩៨៩ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង អរគុណ វៀតណាម បើ ទោះបី មក ជួយ កម្ពុជា តែ គោរព សេចក្តីសម្រេច របស់ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ ជនរងគ្រោះ ក្នុង គ្រោះ អគ្គិសភ័យ កាស៊ីណូ នៅ ប៉ោយប៉ែត បណ្តាលឱ្យ ស្លាប់ មនុស្ស ជិត ២០ នាក់ និង របួស ជាង ១០០ នាក់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ សម្តេច ក្រឡាហោម ស ខេង ដែល បាន ចុះ ទៅ ដឹកនាំ ប្រតិបត្តិការ រុករក និង សង្គ្រោះ គ្រោះ អគ្គិភ័យ នៅ កាស៊ីណូ ហ្គ្រេន ដាយ មិន ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែង កោតសរសើរ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន និង លោក អ៊ុំ រាត្រី ដែល បាន ដឹកនាំ ប្រតិបត្តិការ នោះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ ឱ្យ អាជ្ញាធរ ប្រញាប់ រៀបចំ សណ្តាប់ធ្នាប់ នៅ កន្លែង ឆេះ ដើម្បី សម្រួល ដំណើរ ឆ្លងកាត់ ច្រក ព្រំដែន ប៉ោយប៉ែត ។
* សម្តេច តេជោ ហ៊ុន សែន បន្ត អំពាវនាវ ប្រជាពលរដ្ឋ ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ជាពិសេស ទៅ ទទួលយក វ៉ាក់សាំង ដូស ជំរុញ ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រកាស កំណត់ គម្លាត ៦ខែ ក្នុង ការចាក់ វ៉ាក់សាំង ដូស ជំរុញ បន្ត បន្ទាប់
* សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ ក្តីរីករាយ ចំពោះ ការវិវឌ្ឍ ស្ថានភាព សេដ្ឋកិច្ច របស់ កម្ពុជា ក្រោយ វិបត្តិ ជំងឺ កូវីដ១៩ ។ សម្តេច តេជោ បាន បញ្ជាក់ ថា ទាំង គយ និង ពន្ធដារ ប្រមូល ចំណូល បាន លើស ផែនការ ជាង ២៥ ភាគរយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល នៅតែ រក្សា ការបើកប្រាក់ បៀវត្សរ៍ តាម ប្រព័ន្ធ ធនាគារ ហើយ មិន វិល ទៅរក ការបើកប្រាក់ បៀវត្សរ៍ ជា សាច់ប្រាក់ ផ្ទាល់ វិញ នោះ ឡើយ ។ សម្តេច តេជោ ហ៊ុន សែន ណែនាំ លោក សុខ ទូច ឱ្យ ពង្រឹង ការគ្រប់គ្រង មន្ត្រី នៅ រាជ បណ្ឌិត្យ សភា កម្ពុជា កុំ ចង់ឱ្យ រាជ រដ្ឋាភិបាល បើក ប្រាក់ បៀវត្សរ៍ ជា សាច់ប្រាក់ ។
* សម្តេច តេជោ ហ៊ុន សែន លើកទឹកចិត្ត អភិបាល ខេត្ត កំពត ឱ្យ ប្រឹងប្រែង ដោះស្រាយ ជម្លោះ ដីធ្លី ក្រៅ ប្រព័ន្ធ តុលាការ ។ សម្តេច តេជោ ហ៊ុន សែន លើកទឹកចិត្ត ឱ្យ ខេត្ត ដទៃ យក គំរូ លោក ម៉ៅ ធ និន ដោះស្រាយ ជម្លោះ ដីធ្លី ក្រៅ ប្រព័ន្ធ តុលាការ ឈរ លើ ភាពត្រឹមត្រូវ មិន លំអៀង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បើ មិន បាន ធ្វើការ ទេ ដូច ថ្ងៃ សំរាក ដូចជា ថ្ងៃសៅរ៍ ថ្ងៃអាទិត្យ អត់ មាន អ្នកធ្វើការ ជាមួយ យើង មាន អារម្មណ៍ ថា មិន ស្រួល ខ្លួន ដែល គេ ហៅ ថា សាច់ កម្ម . ទោះបី យ៉ាងណា រាជ រដ្ឋាភិបាល កម្ពុជា ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា មិន ឲ្យ ប្រជាពលរដ្ឋ កម្ពុជា ខកចិត្ត ដោយសារតែ ខ្វះ ការទទួលខុសត្រូវ នោះ ទេ ។
ជុំវិញ ឧទ្ទវហេតុ នេះ ដែរ ខាង អ្នកនាំពាក្យ ម្នាក់ របស់ យោធា អ៊ុយក្រែន បាន ទទួលស្គាល់ ថា នោះ ពិតជា មីស៊ីល របស់ អ៊ុយក្រែន មែន តែ ថា វា ជា រឿង ចៃដន្យ ដែល កើតឡើង កំឡុង ការបាញ់ ស្ទាក់ ចាប់ មីស៊ីល រុស្ស៉ី ។ រុស្ស៉ី កាលពី ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ បាញ់ ស្រោច មីស៊ីល ជាង ១០០ គ្រាប់ លើ ទីក្រុង ជាច្រើន នៅ ទូទាំង ប្រទេស អ៊ុយក្រែន ។
ក្នុង ចំណោម ជនរងគ្រោះ ដែល ស្លាប់ និង របួស មាន ទាំង ជនជាតិ ខ្មែរ និង ជន បរទេស ។ ក្នុង នោះ ជនរងគ្រោះ ខ្លះ ស្លាប់ នៅក្នុង បន្ទប់ ហើយ ជនរងគ្រោះ ខ្លះ ទៀត ស្លាប់ នៅ ផ្លូវ ដើរ នៅ ជណ្ដើរ ទំនង ពួកគេ កំពុង ជម្លៀស ខ្លួន ពី អគ្គិភ័យ តែ រត់ មិន រួច ដោយសារ ភ្លើង ឆេះ ខ្លាំង និង មាន ផ្សែង ខ្លាំង ខ្មួល ខ្មាញ់ ។
ជនរងគ្រោះ ដែល នៅ មាន ជីវិត ខ្លះ ត្រូវបាន បញ្ជូន ទៅ សង្គ្រោះ នៅ ប្រទេស ថៃ និង ខ្លះ ទៀត បញ្ជូន ទៅ មន្ទីរពេទ្យ ក្បែរ កន្លែង កើត ហេតុ នៅក្នុង ប្រទេស កម្ពុជា ។
សូម បញ្ជាក់ ថា អគ្គិភ័យ នេះ បាន កើតមាន តាំងពី វេលា ម៉ោង ១១៖៣០ នាទី យប់ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ខណៈ មូលហេតុ ត្រូវបាន គេ រាយការណ៍ ជំហ៊ាន ដំបូង ថា ឆ្លង ចរន្ដ អគ្គិសនី នៅ ទីតាំង ហ្គេម ជាន់ ក្រោម ហើយ បាន រីករាលដាល តែម្ដង ។ ទីតាំង ដែល ឆេះ នេះ មាន ពីរ អគារ ដោយ ក្នុង នោះ ឆេះ ផ្ដើម ដំបូង ចេញ ពី អគារ ហ្គេន ដាយ មិន និង រីករាលដាល ទៅកាន់ អគារ ប៉ោយប៉ែត រី សត ។
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន ! ស្លាប់ ៨នាក់ និង របួស ៧នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៩ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៨នាក់ និង របួស ធ្ងន់ ស្រាល ៧នាក់ ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ រដ្ឋមន្ត្រី ការពារ ជាតិ អ៉ី ស្រាអែល មើលឃើញ ពី លទ្ធភាព វាយប្រហារ លើ អ៉ីរ៉ង់ ក្នុង ពេល ២ ទៅ ៣ឆ្នាំ ខាងមុខ
២៖ វិមាន ក្រឹមឡាំង ថា រាល់ ផែនការ សន្តិភាព នៅ អ៊ុយក្រែន ត្រូវតែ មាន បញ្ចូល ទឹកដី ដែល រុស្ស៉ី កាត់ យក
៣៖ សហរដ្ឋ អាមេរិក សហភាព អឺរ៉ុប និង NATO ជំរុញ ឱ្យ មាន ការអត់ធ្មត់ ជា អតិបរមា ខណៈ ស៊ែរប៊ី និង កូសូវ៉ូ បិទ ព្រំដែន
">៤៖ អ៊ុយក្រែន អះអាង ថា រុស្ស៉ី ទើប បើក ការវាយប្រហារ ដោយ មីស៉ីល ជាង ១០០ គ្រាប់ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ
៥៖ សោកនាដកម្ម មនុស្ស ជាន់ គ្នា ស្លាប់ ធំ ៗ ពីរ ដែល បាន កើតឡើង ក្នុង ឆ្នាំ ២០២២
៦៖ ហ្វីលីពីន និង ចិន យល់ព្រម បង្កើត មធ្យោបាយ ទាក់ទង គ្នា ដោយ ផ្ទាល់ ដើម្បី ចៀសវាង ការគណនា ខុស ណាមួយ នៅឯ តំបន់ សមុទ្រ មាន វិវាទ
នាយក រដ្ឋមន្ត្រី៖ អ៊ីតាលី ត្រៀមខ្លួន ជាស្រេច ដើម្បី ក្លាយជា អ្នកធានា កិច្ចព្រមព្រៀង សន្តិភាព ជុំវិញ បញ្ហា អ៊ុយក្រែន
ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នេះ មាន ការចូលរួម ជា អធិបតី ពី លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ . អ្នក ឧកញ៉ា លាង ឃុន សហ ស្ថាបនិក និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល ក្រុមហ៊ុន ជី ប ម៉ុង ព្រមទាំង មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ អាជ្ញាធរ ពាក់ព័ន្ធ ថ្នាក់ដឹកនាំ ក្រុមហ៊ុន ជី ប ម៉ុង បុគ្គលិក ក្រុមហ៊ុន ជីប ម៉ុង អ៉ីន ដាស្រ្ទីស៍ និង ប្រជាពលរដ្ឋ សរុប ប្រមាណ ៨០០ នាក់ ។
លោក ក៏ បាន បញ្ជាក់ ទៀត ថា ឃុំ បាន ចាត់ទុក វិស័យ ឯកជនជា ដៃគូ ដ៏ សំខាន់ មិន អាច ខ្វះ បាន ក្នុង ការរួមចំណែក វិនិយោគ លើ វិស័យ នានា សំដៅ ធ្វើអោយ ប្រទេសជាតិ យើង មាន ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ។
សូម បញ្ជាក់ ផងដែរ ថា ផ្លូវ បេតង់ មួយ ខ្សែ ថ្មី នេះ ជា សមិទ្ធផល ដ៏ សំខាន់ មួយ ទៀត ក្នុង ឆ្នាំ ២០២២ នេះ របស់ ក្រុមហ៊ុន ជី ប ម៉ុង ។ មិន ត្រឹមតែ ប៉ុណ្ណោះ ក្រុមហ៊ុន ជី ប ម៉ុង នឹង បន្ត ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ វិស័យ សាធារណៈ ស្ដារ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ នានា ដើម្បី បំពេញ តម្រូវការ ប្រជាពលរដ្ឋ ក៏ ដូចជា ចូលរួមចំណែក ក្នុង ការលើកកម្ពស់ ដល់ វិស័យ សេដ្ឋកិច្ច និង សង្គមជាតិ ឱ្យ ប្រកបដោយ ចីរភាព នា ពេល អនាគត ៕
អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន ចែកជូន ដល់ ពលរដ្ឋ មាន ជីវភាព ខ្វះខាត ១៥០ គ្រួសារ នៅក្នុង ឃុំ ឈើ ទាល ស្រុក បាណន់
( បាត់ដំបង ) ៖ លោក ស្រេង សុខា អភិបាល ស្រុក បាណន់ នា ព្រឹក ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ ក្រុមការងារ នាំយក អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចុះ ចែកជូន បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ចំនួន ១៥០ គ្រួសារ នៅក្នុង ឃុំ ឈើ ទាល ស្រុក បាណន់ ខេត្ត បាត់ដំបង ។
នា ឱកាស នេះ ដែរ លោក ស្រេង សុខា ក៏ បាន នាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក សុខ លូ និង អភិបាល ខេត្ត បាត់ដំបង និង ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន និង កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល សម្តេច ទាំង ទ្វេ តែងតែ បាន គិតគូរ យកចិត្តទុកដាក់ ជាប់ ជានិច្ច ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ ក្រុមគ្រួសារ និង គ្រប់ ទីកន្លែង ដោយ មិន ប្រកាន់ ពី និន្នាការ នយោបាយ ជាតិ សាសន៍ សាសនា វណ្ណៈ ពណ៌ សម្បុរ អ្វី ឡើយ ជាពិសេស គឺ មិន ទុក ឱ្យ ពលរដ្ឋ ណា ម្នាក់ ជួយ ការលំបាក ដោយ មិន បាន ជួយ ដោះស្រាយ នោះ ឡើយ ។
ជាមួយគ្នា នោះ ដែរ លោក ស្រេង សុខា ក៏ បាន ស្នើសុំ ឲ្យ ប្រជាពលរដ្ឋ បន្ត គាំទ្រ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បន្ត រក្សា សន្តិភាព និង ការអភិវឌ្ឍ និង បាន អះអាង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល តែងតែ នៅ រួមរស់ ស្គាល់ ទុក្ខលំបាក និង ដោះស្រាយ រាល់ បញ្ហា ប្រឈម របស់ បងប្អូន ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ព្រមទាំង បាន កសាង នូវ សមិទ្ធផល យ៉ាង ច្រើន ចាប់ពី ទីប្រជុំជន រហូតដល់ មូលដ្ឋាន ដូច អ្វី ដែល បងប្អូន បាន ឃើញ យ៉ាង ច្បាស់ នា ពេល បច្ចុប្បន្ន នេះ ។
បន្ថែម ពី នេះ លោក ស្រេង សុខា ក៏ បាន ផ្តាំផ្ញើ ឱ្យ គ្រួសារ ទាំងអស់ មេត្តា ខិតខំ ថែរក្សា សុខភាព ដោយ ប្រកាន់ភ្ជាប់ នូវ អនាម័យ រស់ នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត ចូលរួម អនុវត្ត វិធានការ បង្ការ និង ការពារ ខ្លួន ពី ជំងឺ កូវីដ១៩ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ផងដែរ ។
( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន ផ្ញើ សារលិខិត ចូលរួម រំលែក ទុក្ខ ដល់ ក្រុមគ្រួសារ សព វរសេនីយ៍ ត្រី ម៉ិច ឆាយ ភីវ័យ នាយ រង ការិយាល័យ ផ្សព្វផ្សាយ អប់រំ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ដែល បាន បាត់បង់ជីវិត ក្នុង ករណី បង្ក្រាប គ្រឿងញៀន កាលពី ថ្ងៃទី ២៨ ខែធ្នូ ។
តាមរយៈ សារលិខិត ផ្ញើ ជូន លោកស្រី ចាន់ សុភី ព្រមទាំង ក្រុមគ្រួសារ សម្តេច ក្រឡាហោម និង ភរិយា ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រី នគរបាល ជាតិ មន្ត្រីរាជការ ស៊ីវិល និង មន្ត្រី ពន្ធនាគារ ន ក្រសួង មហាផ្ទៃ មាន សេចក្តីក្តុកក្តួល រន្ធត់ តក់ស្លុត និង សោកស្តាយ ឥត ឧបមា ចំពោះ មរណភាព របស់ លោក វរសេនីយ៍ ត្រី ម៉ិច ឆាយ ភី វ័យ ។
សម្តេច សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ លោក វរសេនីយ៍ ត្រី ម៉ិច ឆាយ ភី វ័យ បាន ទៅកាន់ ឋាន បរម សុខ ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ UPDATE: កម្លាំង សមត្ថកិច្ច ទាំង កម្ពុជា - ថៃ ផ្អាក រុករក ជនរងគ្រោះ ក្នុង ហេតុការណ៍ ភ្លើង ឆេះ កាស៉ី ណូបារម្ភ ខ្លាច អគារ បាក់ រលំ. ប្រតិបត្តិការ នឹង បន្ដ នៅ ព្រឹក ស្អែក
( បន្ទាយមានជ័យ )៖ នៅ វេលា ម៉ោង ប្រមាណ ៧យប់ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ទាំង កម្លាំង សមត្ថកិច្ច កម្ពុជា និង សមត្ថកិច្ច ថៃ បាន សម្រេច ផ្អាក សកម្មភាព រុករក សាកសព ជនរងគ្រោះ ក្នុង ហេតុការណ៍ ភ្លើង ឆេះ កាស៉ី ណូជា បណ្ដោះអាសន្ន សិន ដោយ បារម្ភ ខ្លាច អគារ បាក់ រលំ និង ម្យ៉ាង ស្ថានភាព ងងឹត ក្នុង ពិបាក ក្នុង ស្រាវជ្រាវ រក អ្នក រងគ្រោះ ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ នៅ ពេល នេះ កម្លាំង រុករក ទាំង កម្ពុជា និង ថៃ បាន សម្រេច ផ្អាក សកម្មភាព បណ្ដោះអាសន្ន សិន ដោយ ស្ថានភាពយប់ ងងឹត និង បារម្ភ ពី សុវត្ថិភាព ខ្លាចក្រែង អគារ បាក់ រលំ ជា យថាហេតុ បន្ទាប់ ត្រូវបាន អគ្គិភ័យ វាយប្រហារ ប៉ុន្មាន ម៉ោង យ៉ាង ធ្ងន់ធ្ងរ ។ ម្យ៉ាងទៀត កងកម្លាំង ប្រតិបត្តិការ ហាក់ អស់ កម្លាំង ផងដែរ ។ បើ តាម លោក អភិបាល ខេត្ត ប្រតិបត្តិការ បន្ដ នឹង ធ្វើឡើង នៅ ព្រឹក ស្អែក បន្ដ ទៀត ។
គួរ ជម្រាប ថា របាយការណ៍ ក្រុម សង្គ្រោះ គិត ត្រឹម ម៉ោង ៧យប់ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ឲ្យដឹង ថា អ្នកស្លាប់ ក្នុង ហេតុការណ៍ ភ្លើង ឆេះ កាស៉ី ណូ នៅ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ បាន កើន ដល់ ជិត ២០ នាក់ និង របួស ជិត ១០០ នាក់ ។
របាយការណ៍ ដដែល បាន បញ្ជាក់ ទៀត ថា ក្នុង ចំណោម ជនរងគ្រោះ ដែល ស្លាប់ និង របួស មាន ទាំង ជនជាតិ ខ្មែរ និង ជន បរទេស ។ ក្នុង នោះ ជនរងគ្រោះ ខ្លះ ស្លាប់ នៅក្នុង បន្ទប់ ហើយ ជនរងគ្រោះ ខ្លះ ទៀត ស្លាប់ នៅ ផ្លូវ ដើរ នៅ ជណ្ដើរ ទំនង ពួកគេ កំពុង ជម្លៀស ខ្លួន ពី អគ្គិភ័យ តែ រត់ មិន រួច ដោយសារ ភ្លើង ឆេះ ខ្លាំង និង មាន ផ្សែង ខ្លាំង ខ្មួល ខ្មាញ់ ។
សេចក្ដីរាយការណ៍ បាន បន្ថែម ទៀត ថា ជនរងគ្រោះ ដែល នៅ មាន ជីវិត ខ្លះ ត្រូវបាន បញ្ជូន ទៅ សង្គ្រោះ នៅ ប្រទេស ថៃ និង ខ្លះ ទៀត បញ្ជូន ទៅ មន្ទីរពេទ្យ ក្បែរ កន្លែង កើត ហេតុ នៅក្នុង ប្រទេស កម្ពុជា ។
សូម បញ្ជាក់ ថា អគ្គិភ័យ នេះ បាន កើតមាន តាំងពី វេលា ម៉ោង ១១៖៣០ នាទី យប់ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ខណៈ មូលហេតុ ត្រូវបាន គេ រាយការណ៍ ជំហា៊ន ដំបូង ថា ឆ្លង ចរន្ដ អគ្គិសនី នៅ ទីតាំង ហ្គេម ជាន់ ក្រោម ហើយ បាន រីករាលដាល តែម្ដង ។ ទីតាំង ដែល ឆេះ នេះ មាន ពីរ អគារ ដោយ ក្នុង នោះ ឆេះ ផ្ដើម ដំបូង ចេញ ពី អគារ ហ្គេន ដាយ មិន និង រីករាលដាល ទៅកាន់ អគារ ប៉ោយប៉ែត រី សត ។
( ឡុងដ៍ ) ៖ រដ្ឋមន្ត្រី ការបរទេស G7 កាលពី ថ្ងៃព្រហស្បតិ៍ បាន អំពាវនាវ ឱ្យ ក្រុម តាលី បង់ « ផ្លាស់ប្តូរ ជាបន្ទាន់ » នូវ បម្រាម លើ ស្ត្រី ដែល ធ្វើការ ក្នុង វិស័យ ផ្តល់ ជំនួយ មនុស្សធម៍ របស់ ប្រទេស អាហ្វហ្គានីស្ថាន ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៩ ខែធ្នូ ឆ្នាំ ២០២២ ។
រដ្ឋមន្ត្រី បាន និយាយ ថា ពួកគេ មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង ថា បទបញ្ជា ដែល មិន ប្រុងប្រយ័ត្ន និង គ្រោះថ្នាក់ របស់ ពួក តាលី បង់ ដែល រារាំង បុគ្គលិក ស្ត្រី នៃ អង្គការ មិន មែន រដ្ឋាភិបាល ជាតិ និង អន្តរជាតិ (NGOs) ពី កន្លែង ធ្វើការ នឹង ធ្វើឱ្យ មាន ហានិភ័យ ដល់ ប្រជាជន អាហ្វហ្គានីស្ថាន រាប់ លាន នាក់ ដែល ពឹងផ្អែក លើ ជំនួយ មនុស្សធម៌ សម្រាប់ ការរស់រាន មាន ជីវិត ។
ពួកគេ បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ ដែល ចេញ ដោយ ក្រសួង ការបរទេស របស់ ចក្រភព អង់គ្លេស ថា « យើង អំពាវនាវ ឱ្យ ពួក តាលី បង់ ផ្លាស់ប្តូរ ជាបន្ទាន់ នូវ ការសម្រេចចិត្ត នេះ » ។
ការហាម ប្រាម នេះ គឺជា ការវាយប្រហារ ចុងក្រោយ បំផុត ប្រឆាំង នឹង សិទ្ធិ ស្ត្រី នៅក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ចាប់តាំងពី ក្រុម តាលី បង់ បាន ដណ្តើម អំណាច មកវិញ កាលពី ឆ្នាំ មុន ។
តិច ជាង មួយ សប្តាហ៍ កន្លងទៅ ក្រុម និយម ជ្រុល ដែល បាន អះអាង ថា ខ្លួន ជា អ្នក កាន់ សាសនា អ៊ីស្លាម ទាំង នេះ ក៏ បាន រារាំង ស្ត្រី មិន ឱ្យ ចូល រៀន នៅ សកលវិទ្យាល័យ ផងដែរ ដែល បង្កឱ្យ មាន ការខឹងសម្បារ ជា សកល និង ការតវ៉ា នៅក្នុង ទីក្រុង មួយចំនួន របស់ អាហ្វហ្គានីស្ថាន ។
ការថ្លែង នេះ ធ្វើឡើង បន្ទាប់ពី ស្ថាប័ន ផ្តល់ ជំនួយ ចំនួន ប្រាំមួយ បាន ផ្អាក ប្រតិបត្តិការ ក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ក្នុង ការឆ្លើយតប នឹង បម្រាម នេះ ៕
ទោះជា យ៉ាងណា ក្នុង របាយការណ៍ ថ្ងៃព្រហស្បតិ៍ នេះ វៀតណាម ពុំ បាន រកឃើញ ករណី អ្នកស្លាប់ ថ្មី បន្ថែម ទៀត ទេ ។
ចំណេះដឹង ទូទៅ៖ ប្រទេស និង ដែនដី ដែល ឆ្លង ឆ្នាំ សកល មុន គេ និង ក្រោយ គេ
សេចក្ដីរាយការណ៍ ពី ទីតាំង សង្គ្រោះ បាន អះអាង ថា រហូតមកដល់ ពេលនេះ កម្លាំង ប្រតិបត្តិការ រុករក ជនរងគ្រោះ មិន ទាន់ បិទ បញ្ចប់ នៅឡើយ ទេ ពោល កំពុងតែ បន្ដ ស្រាវជ្រាវ រុករក ពី បន្ទប់ មួយ ទៅ បន្ទប់ មួយ ពី ជាន់ មួយ ទៅជាន់ មួយ បើ ទោះបី ស្ថានភាពលំបាក ងងឹង ហប់ ខ្យល់ យ៉ាងណា ក្ដី តែ ក្រុម សង្គ្រោះ កំពុង សស្រាក់សស្រាំ ក្នុង ប្រតិបត្តិការ សង្គ្រោះ ដដែល ។
របាយការណ៍ ដដែល បាន បញ្ជាក់ ទៀត ថា ក្នុង ចំណោម ជនរងគ្រោះ ដែល ស្លាប់ និង របួស មាន ទាំង ជនជាតិ ខ្មែរ និង ភាគ ច្រើន ជនជាតិ ថៃ ។ ក្នុង នោះ ជនរងគ្រោះ ខ្លះ ស្លាប់ នៅក្នុង បន្ទប់ ហើយ ជនរងគ្រោះ ខ្លះ ទៀត ស្លាប់ នៅ ផ្លូវ ដើរ នៅ ជណ្ដើរ ទំនង ពួកគេ កំពុង ជម្លៀស ខ្លួន ពី អគ្គិភ័យ តែ រត់ មិន រួច ដោយសារ ភ្លើង ឆេះ ខ្លាំង និង មាន ផ្សែង ខ្លាំង ខ្មួល ខ្មាញ់ ។
សូម បញ្ជាក់ ថា អគ្គិភ័យ នេះ បាន កើតមាន តាំងពី វេលា ម៉ោង ១១៖៣០ នាទី យប់ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ខណៈ មូលហេតុ ត្រូវបាន គេ រាយការណ៍ ជំហ៊ាន ដំបូង ថា ឆ្លង ចរន្ដ អគ្គិសនី នៅ ទីតាំង ហ្គេម ជាន់ ក្រោម ហើយ បាន រីករាលដាល តែម្ដង ។
នេះ ជា សកម្មភាព ក្រុម កង រុករក និង សង្គ្រោះ ៧០៥ របស់ យោធា ភូមិភាគ ទី៥
លោក Xi Jinping អគ្គ លេខាធិការ បក្ស បាន អញ្ជើញ ជា អធិបតី ព្រមទាំង ថ្លែង សុន្ទរកថា គន្លឹះ ។ លោក បាន លើកឡើង ថា ក្នុង កិច្ចប្រជុំ លើក នេះ សម មិត្ត នៃ ការិយាល័យ នយោបាយ បាន លើកឡើង មតិ យោបល់ និង សំណើ ល្អ ៗ ជាច្រើន បន្ទាប់ពី កិច្ចប្រជុំ យើង ត្រូវ រួសរាន់ ចាត់ វិធានការ ដើម្បី កែលម្អ ការងារ ក្នុង ន័យ ទទួលបាន សមិទ្ធផល ជាក់ស្តែង ៕
ក្នុង ដំណើរ ចូល ចត នោះ ដែរ លោក ហោ សារុន រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន អញ្ជើញ ទទួឡ ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ ដំណើរ ទេសចរណ៍ របស់ នាវា ក៏ ដូចជា ភ្ញៀវ ទេសចរណ៍ មកកាន់ ប្រទេស កម្ពុជា ក្នុង ទឹកដី ខេត្ត ព្រះសីហនុ ដែល សបញ្ជាក់ ឱ្យ ឃើញ ថា ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ស្ថេរភាព នយោបាយ ពេញលេញ ក្រោម ម្លប់ សន្តិភាព នៃ ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ត្រៀម ដាក់ សម្ពោធ ជា ផ្លូវការ នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ វេលា ម៉ោង ៥៖០០ នាទី រសៀល នៅ សាល សន្និសីទ ចតុមុខ ក្រោម អធិបតីភាព លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ។
« ទុក្ខ ស្រី ប្តី ព្រាត់ » គឺជា ចំណងជើង បទចម្រៀង ដែល និយាយ អំពី រឿងរ៉ាវ ពិត នៃ ជីវិត ស្នេហា ដ៏ ជូរចត់ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល ត្រូវ ព្រាត់ប្រាស់ គ្នា ក្នុង សម័យ ខ្មែរ ក្រហម ។ បុព្វហេតុ របស់ សម្តេច ត្រូវ ចាកចេញ ឆ្ងាយ ពី សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ពេល នោះ ដោយសារតែ បុព្វហេតុ ជាតិ មាតុភូមិ ខណៈ ដែល សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល បាន ស្លាប់ កូនទី១ ហើយ កំពុង មាន ផ្ទៃពោះ ៥ខែ កូន ទី២ ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន បញ្ជាក់ ថា « ទុក្ខ ស្រី ប្តី ព្រាត់ បាន ធ្វើឱ្យ សម្តេច និង ភរិយា ស្រក់ ទឹកភ្នែក រាប់ លាន ដំណក់ ។ ប៉ុន្តែ ទឹកភ្នែក នេះ គឺ បាន នាំមក នូវ ការ រស់រាន មាន ជីវិត សម្រាប់ ប្រជាជន ទូទាំង ប្រទេស »៕
អភិបាល រាជធានី ភ្នំពេញ អរគុណ អាជ្ញាធរ ខណ្ឌ និង គណៈកម្មការ ផ្សារ ដែល បាន យកចិត្តទុកដាក់ ក្នុង ការទប់ស្កាត់ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន សម្តែង នូវ ការអរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ អាជ្ញាធរ ខណ្ឌ ទាំង ១៤ និង ប្រធាន ផ្សារ ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ និង យក អស់ កម្លាំង កាយ ចិត្ត ក្នុង ការទប់ស្កាត់ កូវីដ - ១៩ រហូត បើក សេដ្ឋកិច្ច ប្រទេស ឲ្យ ដំណើរការជា ប្រក្រតី ឡើងវិញ រហូតមកដល់ ពេលនេះ ។
លោក អរគុណ បែប នេះ ខណៈ ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ សកម្មភាព ការងារ នៃ ការគ្រប់គ្រង ផ្សារ រដ្ឋ ក្នុង រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នៅ សាលា រាជធានី ភ្នំពេញ ។
លោក ឃួង ស្រេង បាន ថ្លែង ថា ក្នុង ដំណាក់កាល នៃ ការរីករាលដាល កូវីដ - ១៩ អាជ្ញាធរ ខណ្ឌ ទាំង ១៤ និង ប្រធាន គណៈកម្មការ ផ្សារ រដ្ឋ ក្នុង រាជធានី ភ្នំពេញ បាន លះបង់ ទាំង កម្លាំង កាយ និង កម្លាំងចិត្ត ដោយ មិន ខ្វល់ ថា ជា ពេល យប់ ឬ ថ្ងៃ ឡើយ សំខាន់ ធ្វើ យ៉ាងណា ប្រជាពលរដ្ឋ អាជីវករ បាន ឆ្លង ផុត ពី ជំងឺ ដ៏ កាច សាហាវ នេះ ។
គួរ បញ្ជាក់ ថា គិត មកដល់ ពេលនេះ ផ្សារ ក្នុង រាជធានី ភ្នំពេញ មាន ចំនួន ២៥ផ្សារ ហើយ ក្នុង ដំណាក់កាល នៃ ការរីករាលដាល កូវីដ - ១៩ គណៈកម្មការ ផ្សារ បាន ដើរ តួយ៉ាង សំខាន់ ក្នុង ការទប់ស្កាត់ ជំងឺ ដ៏ កាច សាហាវ នេះ ៕
និយ័តករបរ ធន បាលកិច្ច ចុះ ផ្សព្វផ្សាយ ពី គម្រោង លើកកម្ពស់ សុវត្ថិភាព កសិកម្ម ACSEP នៅ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ និយ័តករបរ ធន បាលកិច្ច ( ន. ប.ធ ) បាន រៀបចំ សិក្ខាសាលា ផ្សព្វផ្សាយ និង បណ្តុះបណ្តាល ពង្រឹង សមត្ថភាព ស្តីពី ដំណើរការ និង នីតិវិធី ក្នុង ការទទួលបាន ឥណទាន ក្រោម គម្រោង ប្រកួតប្រជែង ខ្សែ ច្រវាក់ តម្លៃ និង លើកកម្ពស់ សុវត្ថិភាព កសិកម្ម (ACSEP) សមាសភាគ ទី១ ដល់ មន្ត្រីរាជការ និង អាជ្ញាធរ ពាក់ព័ន្ធ នៅ ខេត្ត កំពង់ចាម ព្រមទាំង កសិករ ចិញ្ចឹម មាន់ នៅ ខេត្ត កំពង់ចាម ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត កំពង់ធំ ។
សិក្ខាសាលា នេះ ដែរ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ផ្សព្វផ្សាយ និង បញ្ច្រាប ការយល់ដឹង អំពី គម្រោង ACSEP ពាក់ព័ន្ធ នឹង ដំណើរការ និង នីតិវិធី ក្នុង ការទទួលបាន ឥណទាន បន្ថែម ដើម្បី ពង្រីក និង ពង្រឹង អាជីវកម្ម ដល់ សហគ្រាស កសិ- ឧស្សាហកម្ម សហគម កសិកម្ម និង កសិករ ចិញ្ចឹម មាន់ ស្រុក ជាពិសេស សហគ្រាស ផលិត ដែល មាន បំណង ស្វែងរក ទុន បន្ថែម សម្រាប់ គាំទ្រ ផែនការ អាជីវកម្ម របស់ ខ្លួន ៕
តុលាការ សម្រេច ផ្តន្ទាទោស ស្ត្រី អ្នកជំនួញ ពេជ្រ ស្រី មុំ កំណត់២ ឆ្នាំ រឿង ឆបោក លុយ គេ រាប់ លាន ដុល្លារ
សូម រំលឹក ថា ស្ត្រី រូប នេះ នៅពេល ត្រូវ សមត្ថកិច្ច អាវុធហត្ថ រាជធានី ភ្នំពេញ ចាប់ បញ្ជូន ទៅ តុលាការ ក៏ មាន ការអន្តរាគមន៍ មិន ឲ្យ មាន ការថត រូប ពោលគឺ អនុញ្ញាតឲ្យ រថយន្ដ ដឹក ស្ត្រី ជំនួញ ដល់ កាំ ជណ្ដើរ យន្ដ ក្នុង តុលាការ តែម្ដង ដោយ មិន ដាក់ចុះ ក្រៅ របង តុលាការ បណ្ដើរ ចូល ដូច ជនសង្ស័យ ផ្សេង នោះ ទេ ។
លោក ប្លង់ សុផល អ្នកនាំពាក្យ ស្ថាប័ន អយ្យការ បាន ប្រាប់ អ្នកយកព័ត៌មាន ថា តំណាង អយ្យការ បាន សម្រេច ចោទប្រកាន់ ស្ត្រី អ្នកជំនួញ ឈ្មោះ ពេជ្រ ស្រី មុំ ពី បទ « មិន បំពេញ កាតព្វកិច្ច ចំពោះ ឧបករណ៍ ដែល អាច ជួញដូរ បាន » ហើយ ត្រូវបាន ចៅក្រម សម្រេច ដេញ ដីកា ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ (PJ) ។
សូម បញ្ជាក់ ថា ស្ដ្រី ម្នាក់ ដែល គេ ស្គាល់ ថា ជា អ្នកជំនួញ ដ៏ ស៉ី វិល័យ ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ចាប់ខ្លួន ពាក់ព័ន្ធ អំពើ ឆបោក លើ ជនរងគ្រោះ ជាច្រើន នាក់ ហើយ ជនរងគ្រោះ ខាតបង់ ទឹកប្រាក់ រាប់ លាន ដុល្លារ ។
អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ស្ដ្រី ដែល ត្រូវបាន ចាប់ខ្លួន នេះ ឈ្មោះ ពេជ្រ ស្រី មុំ ។ ស្ដ្រី រូប នេះ ត្រូវបាន ចាប់ខ្លួន នៅ ចំណុច ផ្ទះ លេខ ៤ដេ ផ្លូវ ដាវីន បុរី វរ ជន ក្នុង កោះ ពេជ្រ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន តាម ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន របស់ លោក ច្រឹង ខ្មៅ ព្រះរាជអាជ្ញា នៃ អយ្យកាអម សាលាដំបូង រាជធានី ភ្នំពេញ លេខ ៤៨០ អ. យ. ក ចុះ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០២២ ពាក់ព័ន្ធ ករណី មិន បំពេញ កាតព្វកិច្ច ចំពោះ ឧបករណ៍ ដែល អាច ជូន ដូរ បាន ។
ការឃាត់ខ្លួន នេះ មាន ការដឹកនាំ អនុវត្ត និង សម្របសម្រួល ដោយ លោក ព្រះរាជអាជ្ញា រង គឹម ហុង សាន ។ ក្រៅពី នេះ ស្រ្តី ខាងលើ នៅ មាន ជាប់ពាក់ព័ន្ធ បណ្តឹង ជាច្រើន ទៀត ដែល បាន ប្តឹង ចូល ទាំង អាវុធហត្ថ នគរបាល និង តុលាការ ថែម ទៀត ផង ។
គួរ ជម្រាប ថា កាលពី ខែឧសភា ឆ្នាំ ២០២២ កន្លងទៅ នេះ ស្ដ្រី ពេជ្រ ស្រី មុំ ក៏ ធ្លាប់ ត្រូវបាន កម្លាំង នគរបាល រាជធានី ភ្នំពេញ ចាប់ខ្លួន ម្ដង រួច មកហើយ ពាក់ព័ន្ធ អំពើ ឆបោក ដូចគ្នា នោះ តាម បណ្ដឹង របស់ ពាណិជ្ជករ ម្នាក់ ដែល ការឆបោក នេះ មាន ទឹកប្រាក់ ប្រមាណ ជាង ៧៧ ម៉ឺន ដុល្លារ ៕
កំលុង ការវាយប្រហារ នោះ សំឡេង ផ្ទុះ ត្រូវបាន គេ លឺ នៅ តាម ទីក្រុង មួយចំនួន របស់ អ៊ុយក្រែន រួមទាំង រដ្ឋធានី កៀវ ផងដែរ ។ អភិបាល ទីក្រុង កៀវ បាន អះអាង ថា ការវាយប្រហារ មីស៉ីល របស់ រុស្ស៉ី បាន បណ្តាលឱ្យ មនុស្ស មួយចំនួន ទទួលរង របួស ខណៈ អភិបាល នៅ ទីក្រុង លីវ (Liv) បាន និយាយ ថា មួយ ផ្នែក ធំ នៃ ទីក្រុង បាន បាត់បង់ ថាមពល អគ្គិសនី ។
មន្រ្តី ជាន់ ខ្ពស់ សង្គមកិច្ច ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង រៀបចំ អាហារ សាមគ្គី ជូន ដល់ កុមារ នៅក្នុង មណ្ឌលកុមារ កំព្រា ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ លោក តូច ចាន់ នី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន សេវា សង្គមកិច្ច តំណាង លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ បាន ដឹកនាំ ក្រុមការងារ និង មន្ត្រី ជំនាញ ចុះ សួរសុខទុក្ខ និង រៀបចំ អាហារ សាមគ្គី ជូន ដល់ កុមារ នៅក្នុង មណ្ឌលកុមារ កំព្រា ខេត្ត ព្រះវិហារ ដើម្បី អបអរសាទរ បុណ្យ ឆ្លង ឆ្នាំ សកល ២០២៣ ខាងមុខ ។
ក្នុង ឱកាស នោះ លោក អគ្គ នាយក ក៏ បាន សម្តែង នូវ ការកោតសរសើរ ចំពោះ អ្នកគ្រប់គ្រង និង បុគ្គលិក ក្នុង មណ្ឌល ដែល បាន ខិតខំ ប្រឹងប្រែង មើល ថែទាំ កុមារ កំព្រា យ៉ាង យកចិត្តទុកដាក់ ផ្តល់ ភាពកក់ក្តៅ និង ចំណេះដឹង ទូទៅ ដើម្បី កែប្រែ ទំពាំង ស្នង ឬស្សី ក្លាយជា ធនធាន មនុស្ស ក្នុង ការជួយ អភិវឌ្ឍន៍ ប្រទេសជាតិ នា ពេល អនាគត ផងដែរ ។
ជាមួយគ្នា នេះ លោក តូច ចាន់ នី អគ្គ នាយក សេវា សង្គមកិច្ច បាន ពាំនាំ មតិ ផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ លោក រដ្ឋមន្ត្រី វង សូត ជូន ដល់ អ្នកគ្រប់គ្រង ម៉ែ ដោះ និង ក្មួយ ៗ កុមារ ដែល កំពុង ស្នាក់ នៅក្នុង មណ្ឌល ព្រមទាំង បាន នាំយក នូវ អំណោយ របស់ រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ចែកជូន ដល់ មណ្ឌល និង កុមារ កំព្រា រួម មាន អង្ករ ចំនួន ១៤បេ សៀវភៅ ៣៥០ ក្បាល ប៊ិច ខៀវ ២០០ ដើម ប៊ិច ក្រហម ២០០ ដើម ខ្មៅដៃ ឈើ ២០០ ដើម បន្ទាត់ ៣០០ គម្រប សៀវភៅ ៣០០ កាតាប ស្ពាយ ៨០ អាវ ៩០ និង ទឹកក្រូច ៦កេស ៕
( បន្ទាយមានជ័យ )៖ តុល្យការ ចុងក្រោយ នៅ វេលា ម៉ោង ២រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ករណី អគ្គិភ័យ វាយប្រហារ អគារ កាស៉ី ណូដាយ មិន ស្ថិត ក្នុង ភូមិ ប៉ោយប៉ែត សង្កាត់ អូរ ជ្រៅ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ កម្លាំង សមត្ថកិច្ច អាច គ្រប់គ្រង បាន ទាំងស្រុង ប៉ុន្ដែ ភ្លើង មិន ទាន់ អស់ រងើក នៅឡើយ ទេ ។
លោក អ៊ុំ រាត្រី អភិបាល ខេត្ដ បន្ទាយមានជ័យ បាន ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា កម្លាំង ជួយសង្គ្រោះ នៅ បន្ដ ប្រតិបត្តិការ ស្រាវជ្រាវ រុករក ជនរងគ្រោះ ដែល ជាប់គាំង ក្នុង អគារ ដែល ត្រូវ ភ្លើង ឆេះ ដដែល ដោយ មិន ទាន់ បិទ បញ្ចប់ នៅឡើយ ទេ ។
បើ តាម លោក អភិបាល ខេត្ត រហូតមកដល់ ពេលនេះ កម្លាំង រុករក បាន ប្រទះឃើញ សាកសព ជនរងគ្រោះ ជាង ១០នាក់ និង មនុស្ស ដែល របួស ជាង ៣០ នាក់ ។ ក្នុង មាន ទាំង ជនជាតិ ខ្មែរ និង ជន បរទេស ។
សេចក្ដីរាយការណ៍ ពី កន្លែង កើត ហេតុ បាន អះអាង ថា កម្លាំង ប្រតិបត្តិការ បាន រកឃើញ សាកសព ជនរងគ្រោះ ជា បន្ដ បន្ទាប់ ដែល ជាប់គាំង ក្នុង បន្ទប់ នៃ អគារ កាស៉ី ណូ ដែល ត្រូវ ភ្លើង ឆេះ ដូច្នេះ ចំនួន ជនរងគ្រោះ នឹង កើតឡើង បន្ថែម ទៀត ។
សូម បញ្ជាក់ ថា អគ្គិភ័យ នេះ បាន កើតមាន តាំងពី វេលា ម៉ោង ១១៖៣០ នាទី យប់ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ខណៈ មូលហេតុ ត្រូវបាន គេ រាយការណ៍ ជំហា៊ន ដំបូង ថា ឆ្លង ចរន្ដ អគ្គិសនី នៅ ទីតាំង ហ្គេម ជាន់ ក្រោម ហើយ បាន រីករាលដាល តែម្ដង ។
ប្រធាន គណបក្ស ស្រុក ចន្ទ្រា ជំរុញ ដល់ សមាជិបក្ស ត្រូវ ខិតខំ ពង្រឹង ការងារ គ្រប់គ្រង សមាជិក គណបក្ស និង បន្ត កសាង ពង្រីក សមាជិក ថ្មី កសាង អំពើ ល្អ ឲ្យបាន ច្រើន
( ស្វាយរៀង ) ៖ លោក ថ ន ថា វុទ្ធា ប្រធាន គណបក្ស ស្រុក ចន្ទ្រា បាន ជំរុញ ដល់ ប្រធាន គណបក្ស ឃុំ ព្រៃ គគីរ ព្រមទាំង សមាជិក បក្ស ទាំងអស់ ត្រូវ ខិតខំ ពង្រឹង ការងារ គ្រប់គ្រង សមាជិក គណបក្ស និង បន្ត កសាង ពង្រីក សមាជិក ថ្មី ជាពិសេស ក្នុង ជួរ យុវជន ដោយ យកចិត្ត ទុកដាក់ ថែទាំ ជានិច្ច ខាង នយោបាយ សតិអារម្មណ៍ និង ចាត់តាំង ដើម្បី ធានា ភាព ជឿជាក់ ខាង គុណភាប របស់ សមាជិក គណបក្ស ។
ការថ្លែង បែប នេះ របស់ លោក ប្រធាន គណបក្ស សុក ចន្ទ្រា បាន ធ្វើឡើង នៅក្នុង ពិធី ប្រកាស ប្រធាន អនុប្រធាន គណៈកម្មាធិការ គណបក្ស ឃុំ ព្រៃ គគីរ ស្រុក ចន្ទ្រា ខេត្ត ស្វាយរៀង នា ព្រឹក ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ ។ ពិធី មាន ការចូលរួម ពី លោក ធឿន រដ្ឋា ជា ក្រុមការងារ ចុះ ជួយ ឃុំ ព្រៃ គគីរ ព្រមទាំង សមាជិក សមាជិការ ជាច្រើន រូប ផងដែរ ។
លោក ប្រធាន គណបក្ស ស្រុក ចន្ទ្រា បាន ថ្លែង នូវ ការកោតសរសើរ ដល់ លោក ប្រធាន គណបក្ស ឃុំ ព្រៃ គគី ចាស់ ដែល មាន ជំងឺ ប្រចាំ កាយ មិន អាច ធ្វើ ការបន្ត បាន ព្រមទាំង សមាជិក សមាជិកា គណបក្ស ឃុំ ព្រៃ គគីរ ទាំងអស់ ដែល បាន ខិតខំ បម្រើ ការងារ បក្ស បាន ល្អ ប្រសើរ ជាពិសេស ត្រូវ បន្ត ក្នុង ការផ្តល់ សេវា រដ្ឋបាល និង សេវា សាធារណៈ និង ការអភិវឌ្ឈន៍ នៅ មូលដ្ឋាន ឲ្យ ទទួលបាន ការគាំទ្រ និង ជឿជាក់ មក លើ គណបក្ស បន្ត ទៀត ។
លោក បាន ជំរុញ ដល់ សមាជិក បក្ស ត្រូវ ខិតខំ ពង្រឹង ពង្រីក អំពើ ល្អ ក្នុង ការបំពេញ តួនាទី និង ភារកិច្ច របស់ ខ្លួន ក្នុង ការបម្រើ ប្រជាជន និង ត្រូវ លុបបំបាត់ ឲ្យបាន នូវ បាតុភាព អសកម្ម នានា ដែល ធ្វើឲ្យ ប្រជាជន មិន ពេញចិត្ត ចំពោះ គណបក្ស និង បន្ត ពង្រឹង សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង បក្ស ឲ្យបាន ល្អ ប្រសើរ ។
លោកស្រី ម៉ម សាបុន ប្រធាន គណបក្ស ឃុំ ព្រៃ គគីរ ដែល ទើបតែ តែងតាំង ថ្មី បាន ប្តេជ្ញា អនុវត្ត កម្មវិធី នយោបាយ របស់ គណបក្ស ឲ្យ កាន់តែ ទទួលបាន ការគាំទ្រ ពី ពលរដ្ឋ មាន ជំនឿ ជឿជាក់ មក លើ គណបក្ស ប្រជាជន កម្ពុជា កាន់តែ ច្រើន ឡើង បន្ថែម ទៀត និង ប្តេជ្ញា គាំទ្រ ពេញ ទំហឹង សម្តេច តេជោ ហ៊ុន សែន ជា បេក្ខជន នាយក រដ្ឋមន្ត្រី និង លោក ហ៊ុន ម៉ាណែត ជា បេក្ខជន នាយក រដ្ឋមន្តី សម្រាប់ ពេល អនាគត ៕ ក្មេង ទំនើង ៣នាក់ ត្រូវ នគរបាល ចាប់ខ្លួន ក្រោយ កាន់ កាំភ្លើង ខ្លី អុក ឡុក ក្នុង ហាង ស្រា មួយ កន្លែង នៅ ក្រុង ក្រចេះ
( ក្រចេះ ) ៖ នគរបាល ក្រុង ក្រចេះ ក្រោម ការចង្អុលបង្ហាញ ពី លោក លោក ឧត្ដមសេនីយ៍ ទោ អ៊ូ សុបុណ្ណា ស្នងការ នគរបាល ខេត្ត និង សម្របសម្រួល ដោយ លោក គឺ ប៊ុណ្ណារ៉ា ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៣នាក់ ពាក់ព័ន្ធ ករណី កាន់ អាវុធ ដោយ ខុស ច្បាប់ ។
ប្រត្តិបត្តិការ នេះ ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ស្ថិត នៅ ភូមិ ក្រចេះ សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ។
១៖ ឈ្មោះ ហ៊ន សុខ គាឧត្តម ភេទ ប្រុស មាន ទីលំនៅ ភូមិ ត្រពាំង ព្រីង សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ខេត្ត ក្រចេះ ២៖ ឈ្មោះ ណុត សុវណ្ណ រា ភេទ ប្រុស អាយុ ១៧ ឆ្នាំ មាន ទីលំនៅ ភូមិ ដូន ជ្រាំ សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ខេត្ត ក្រចេះ ៣៖ ឈ្មោះ សួន វិសាល ភេទ ប្រុស អាយុ ១៨ ឆ្នាំ មាន ទីលំនៅ ភូមិ ថ្ម គ្រែ លើ ឃុំ ថ្ម គ្រែ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
អ្នក ទាំង៣នេះ បាន ជិះ ម៉ូតូ១ គ្រឿង ម៉ាក ហុងដាឌ្រីម ( មិន ចាំ ស្លាកលេខ ) បាន មក ផឹក ស៊ី នៅ មាត់ ទន្លេ ចំណុច ហាង សុភក្រ្តា ស្រា ក្រឡុក និង បាន ធ្វើ ការអុក ឡុក នៅក្នុង ហាង ផឹក ស៊ី ព្រមទាំង កាន់ កាំភ្លើង ខ្លី ០១ ដើម ( មិន ចាំ ម៉ាក ) កាលពី វេលា ម៉ោង ០១៖៤០ រំលង អាធ្រាត្រ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២២ នៅ ចំណុច ហាង សុភក្រ្តា ស្រា ក្រឡុក ស្ថិត នៅ ភូមិ ក្រចេះ សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ខេត្ត ក្រចេះ ។
តាម របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ក្រោយពី ទទួលបាន ពត៌មាន សមត្ថកិច្ច បាន ធ្វើ ស្រាវជ្រាវ កំណត់ មុខ សញ្ញា ជនសង្ស័យ ទាំង ០៣ ខាងលើ និង នាំមក កន្លែង ដើម្បី សួរនាំ ជនសង្ស័យ ទាំង ០៣ បាន សារភាព ខ្លួន ពិតជា បាន កាន់ កាំភ្លើង និង បាន អុក ឡុក នៅក្នុង ហាង ស្រា ក្រឡុក ពិតប្រាកដ មែន ។
បច្ចុប្បន្ន ជនសង្ស័យ ខាងលើ កំពុង ឃាត់ខ្លួន ជា បណ្តោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ក្រុង ក្រចេះ ដើម្បី បំពេញ នីតិវិធី ៕ ព័ត៌មាន លម្អិត ក្នុង រង្វង់ ប្រតិបត្តិការ បង្ក្រាប ឧក្រិដ្ឋ ជន គ្រឿងញៀន នៅ ខណ្ឌ ដង្កោ ដែល បណ្ដាលឲ្យ នគរបាល ម្នាក់ ពលី . ឧក្រិដ្ឋ ជន ៣នាក់ ត្រូវបាន ចាប់ខ្លួន ជាមួយ ថ្នាំញៀន ២កញ្ចប់ ធំ
( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ ក៩ របស់ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន បើក ប្រតិបត្តិការ បង្ក្រាប ឧក្រិដ្ឋ ជន ពាក់ព័ន្ធ បទល្មើស ជួញដូរ និង ចែកចាយ គ្រឿងញៀន នៅ យប់ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ នៅ សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ដោយ ឃាត់ បាន ជនសង្ស័យ ជនជាតិ វៀតណាម ២នាក់ និង ជនជាតិ ខ្មែរ ម្នាក់ រួម ជាមួយ វត្ថុតាង គ្រឿងញៀន ២កញ្ចប់ ធំ ។
ប៉ុន្ដែ មុន ឈានដល់ ឃាត់ខ្លួន ឧក្រិដ្ឋ ជន ទាំង ៣នាក់ រួម ជាមួយ គ្រឿងញៀន នោះ ក៏ មាន ការប៉ះទង្កិច គ្នា ដោយ អាវុធ មួយ ប្រាវ ផងដែរ នៅពេល កម្លាំង ជំនាញ ចូល បង្ក្រាប ហើយ ជនសង្ស័យ ដឹងខ្លួន និង បាន បាញ់ ស្រោច មក លើ កម្លាំង សមត្ថកិច្ច ហើយ បាន បណ្ដាលឲ្យ នាយ នគរបាល ម្នាក់ ពាក់ ស័ក្ដិ៤ ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុ ដោយសារ គ្រាប់ កាំភ្លើង របស់ ឧក្រិដ្ឋ ជន ។ នគរបាល ដែល បាន ពលី គឺ លោក វរសេនីយ៍ ត្រី ម៉ិច ឆាយ ភិវ័យ តួនាទី នាយ រង ការិយាល័យ នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ។
របាយការណ៍ របស់ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន បន្ថែម នៅ រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ឲ្យដឹង ថា នៅពេល ជនសង្ស័យ ធ្វើ ការជួញដូរ គ្រឿងញៀន កម្លាំង ជំនាញ ក៏ ចូលទៅ បង្ក្រាប ប៉ុន្ដែ ពេល នោះ ក៏ មាន ការប្រតាយ ប្រតប់ គ្នា រវាង កងកម្លាំង និង ឧក្រិដ្ឋ ជន ។ ហើយ ឧក្រិដ្ឋ ជន ក៏ បាញ់ មក លើ លោក ម៉ិច ឆាយ ភិវ័យ ត្រូវ ចំគប់ ត្រចៀក បណ្ដាលឲ្យ ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុ ។
បច្ចុប្បន្ន កម្លាំង សមត្ថកិច្ច ជំនាញ ពាក់ព័ន្ធ កំពុង បើក ស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ ដើម្បី ឈាន ទៅ ចាប់ខ្លួន ជន ដៃ ដល់ ម្នាក់ ទៀត ៕
សូម ទស្សនា វីដេអូ ស្តីពី នយោបាយ ឈ្នះ ឈ្នះ មូលដ្ឋានគ្រឹះ នៃ សន្តិភាព ដូចតទៅ៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អញ្ជើញ ទទួល ទីតាំង អតីត សាលា ក្តី ខ្មែរ ក្រហម មក ក្រោម ការគ្រប់គ្រង របស់ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក បាន អញ្ជើញ ផ្ទេរ - ទទួល ទីតាំង អតីត សាលា ក្តី ខ្មែរ ក្រហម មក ក្រោម ការគ្រប់គ្រង របស់ បញ្ជាការដ្ឋាន កងទ័ព ជើង គោក កាលពី ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ។
នៅក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត បាន ចាត់ទុក ព្រឹត្តិការណ៍ ក្នុង ថ្ងៃ នេះ មិន មាន អត្ថន័យ ត្រឹមតែ ជា ការផ្ទេរ - ទទួល អគារ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ គឺជា សក្ខីភាព នៃ ការបិទ បញ្ចប់ ទាំងស្រុង នៃ ដំណើរការ របស់ សាលា ក្តី ខ្មែរ ក្រហម ដោយ ប្រែក្លាយ ពី ទីកន្លែង ផ្តល់ យុត្តិធម៌ ទៅជា ទីកន្លែង សម្រាប់ បន្ត ការងារ ការពារ ជាតិ វិញ បន្ទាប់ពី រាជ រដ្ឋាភិបាល បាន ប្រគល់ មួយ ផ្នែក នៃ ទីតាំង យោធា នេះ សម្រាប់ បម្រើ ឱ្យ ដំណើរការ កាត់ក្តី ខ្មែរ ក្រហម ចាប់តាំងពី ឆ្នាំ ២០០៦ មក ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ជំរុញ ឲ្យ រៀបចំ តំបន់ ខាងកើត នៃ វិមាន ឈ្នះ - ឈ្នះ ទៅជា តំបន់ មួយ ដែល មាន ទិសដៅ បង្កើត ជា សួន បៃតង និង ស្រះ ធម្មជាតិ
ថ្លែង ក្នុង ពិធិ អបអរសាទរ ខួប ២៤ ឆ្នាំ នៃ ការបញ្ចប់ សង្គ្រាម នៅ កម្ពុជា ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ នៅ វិមាន ឈ្នះ - ឈ្នះ ក្នុង សង្កាត់ ព្រែក តា សេក ក្នុង ខណ្ឌ ជ្រោយ ចង្វារ សម្តេច ពិជ័យ សេនា ក៏ បាន ជំរុញ ឲ្យ ដំណើរការ រៀបចំ តំបន់ ប្រវត្តិសាស្ត្រ យោធា នានា ឱ្យ បាន សកម្ម និង មមាញឹក តាម ការកំណត់ ចំនួន ៥៥ទីតាំង ដែល ក្រុមការងារ កំពុង បន្ត រៀបចំ អនុក្រឹត្យ តាម និតិវិធី ជាមួយ ស្ថាប័ន ពាក់ព័ន្ធ ។
សម្តេច ពិជ័យ សេនា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ដំណើរការ រៀបចំ តំបន់ ខាងកើត នៃ វិមាន ឈ្នះ - ឈ្នះ ទៅជា តំបន់ មួយ ដែល មាន ទិសដៅ បង្កើត ជា សួន បៃតង និង ស្រះ ធម្មជាតិ សម្រាប់ បង្កើន សោភណ្ឌភាព នៅ ទីតាំង វិមាន ឈ្នះ - ឈ្នះ និង រក្សា បាន ការផ្សារ ភ្ជាប់ ស្ថាបត្យកម្ម និង ធម្មជាតិ បៃតង សម្រាប់ តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្ត្រ » ។
បើ តាម ការថ្លែង របស់ សម្តេច ពិជ័យ សេនា ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ចូលរួមចំណែក រៀបចំ កិច្ចការ ទាំង នេះ ឱ្យ ក្លាយជា បេតិកភណ្ឌ ជាតិ និង តំបន់ អន្តរជាតិ តាម លក្ខណៈ វិនិច្ឆ័យ ។
ការបង្កើត គោលដៅ ទេសចរណ៍ ដែល មាន លក្ខណៈ ជា ទេសចរណ៍ ប្រវត្តិសាស្ត្រ វប្បធម៌ ក៏ ដូចជា គោ ដៅ សម្រាប់ ទស្សនកិច្ច សិក្សា ស្រាវជ្រាវ នានា គឺជា គោលដៅ ១ ក្នុង ចំណោម គោលដៅ ៥ ចំពោះ ការស្ថាបនា វិមាន ឈ្នះ - ឈ្នះ នៅ រាជធានី ភ្នំពេញ និង ស្ដូប វិមាន ឈ្នះ - ឈ្នះ នៅ តាម ខេត្ត នានា ។
ប្រទេស កម្ពុជា ធ្លាប់ បាន ជួប វិបត្តិ ភ្លើង សង្គ្រាម យ៉ាង ខ្លោចផ្សារ អស់ រយៈពេល ប្រមាណ ៣ទសវត្សរ៍ ក្រោយពេល នៃ ការធ្វើ រដ្ឋប្រហារ ដោយ ខុស ច្បាប់ នា ថ្ងៃទី ១៨ ខែមីនា ឆ្នាំ ១៩៧០ ។ ភ្លើង សង្គ្រាម ដែល បង្កាត់ ឡើង នៅ ថ្ងៃទី ១៨ ខែមីនា ឆ្នាំ ១៩៧០ បាន ឆេះ រោល រាល បំផ្លិចបំផ្លាញ នាវា កម្ពុជា ស្ទើរ ក្លាយជា ផេះ ផង់ ។
ភ្លើង សង្គ្រាម ដែល បង្កាត់ ឡើង ត្រឹម មួយ តែ មួយ ថ្ងៃ តែ បាន ឆេះ រោល រាល រហូតដល់ទៅ ៣ទសវត្សរ៍ ។ ភ្លើង សង្គ្រាម នេះ ត្រូវបាន បិទ បញ្ចប់ ទៅ វិញ ទាំងស្រុង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ថ្ងៃ ដែល មេដឹកនាំ ខ្មែរ ក្រហម មក សុំ រួមរស់ នឹង រាជ រដ្ឋាភិបាល ។ ភ្លើង សង្គ្រាម នេះ បាន ផុត រលត់ ទៅ ក្រោម ការដាក់ចេញ នូវ នយោបាយ ឈ្នះ - ឈ្នះ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ស្ថាបនិក ៕ អភិបាល ខេត្ត កណ្ដាល ប្រគល់ ប្លង់ រឹង ជូន ប្រជាពលរដ្ឋ ២ភូមិ ក្នុង ឃុំ ខ្ពប អា ទាវ ស្រុក លើក ដែក
ក្នុង ពិធី ចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលវត្ថុ នៅ រសៀល ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ លោក គង់ សោភ័ណ្ឌ បាន ថ្លែង ថា ការទទួលបាន ប័ណ្ណ នា ឱកាស នេះ គឺ មាន តម្លៃ ណាស់ សម្រាប់ បងប្អូន ប្រជាពលរដ្ឋ សូម ថែរក្សា ប័ណ្ណ នេះ ឲ្យបាន ល្អ ហើយ សូមឲ្យ ខិតខំ ថែរក្សា សារ ដី នេះ ទុក សម្រាប់ បង្កបង្កើន ផល និង ទុក ដល់ កូន ចៅ របស់ យើង ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ការចែក ប័ណ្ណ កម្មសិទ្ធ ជូន ប្រជាពលរដ្ឋ នៅ ពេល នេះ ជា ការឆ្លុះបញ្ចាំង ឲ្យ ឃើញ ពី ការយកចិត្តទុកដាក់ ខ្ពស់ របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធានា កម្មសិទ្ធ ដីធ្លី ស្រប ច្បាប់ ជូន ប្រជាពលរដ្ឋ សំដៅ លើកកម្ពស់ ជីវភាព សុខុមាលភាព និង ការកាត់បន្ថយ ភាពក្រីក្រ ព្រមទាំង រួមចំណែក ដល់ ការពង្រឹង យុត្តិធម៌ និង ស្ថេរភាព សង្គម ។
ដូច្នេះ ការផ្ដល់ កម្មសិទ្ធិ ដីធ្លី នេះ គឺ ពិតជា បាន រួមចំណែក ជំរុញ និង លើកទឹកចិត្ត ឲ្យ ប្រជាពលរដ្ឋ ខិតខំ បង្កើន ផលិតភាព ក៏ដូចជា ការវិនិយោគ ក្នុង វិស័យ កសិកម្ម ឲ្យ កាន់តែ កើនឡើង ថែម ទៀត ។ លោក ក៏ បាន ស្នើ ដល់ ក្រុមការងារ កំពុង សាងសង់ ផ្លូវ តាម តំបន់ ព្រំដែន ដែល បាន តប ភ្ជាប់ ពី ឃុំ ក្អម សំណរ ស្រុក លើក ដែក ទៅ ឃុំ ព្រែក ជ្រៃ ស្រុក កោះ ធំ សូម ពន្លឿន ការសាងសង់ ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ពិសេស ការដឹក ផល ដំណាំ ក៏ ដូចជា ទំនិញ នានា ។
លោក ទៀង កុស្យារៈ អនុប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សូរិយោដី ខេត្ត កណ្ដាល បាន ឲ្យដឹង ថា គិត មកដល់ ពេលនេះ រដ្ឋបាល ខេត្ត បាន ធ្វើ ការចែក ប័ណ្ណ ជូន ប្រជាពលរដ្ឋ សរុប ចំនួន ១៨១ លើក ស្មើនឹង ២៥៩ . ៦៧៩ប័ណ្ណ ហើយ ថ្ងៃ នេះ គឺជា លើក ទី១៨២ នៃ ការចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលវត្ថុ ដែល នឹង ត្រូវ ផ្ដល់ជូន ប្រជាពលរដ្ឋ មកពី ភូមិ បឹង ក្រោម និង ភូមិ បឹង កណ្ដាល ឃុំ ខ្ពប អា ទាវ ស្រុក លើក ដែក ខេត្ត កណ្ដាល សរុប ចំនួន ១. ០៩០ប័ណ្ណ ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ បាន ថ្លែងអំណរគុណ ដល់ លោក អភិបាល ខេត្ត និង ក្រុមការងារ ទាំងអស់ ដែល បាន បំពេញ បំណង ជូន ពួកគាត់ ដ្បិត ប្លង់ ដី នេះ ពិតជា មាន សារសំខាន់ ណាស់ សម្រាប់ ពួកគាត់ ៕
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ផ្តល់ អនុសាសន៍ ៧ ចំណុច ដើម្ប បន្ត លើកកម្ពស់ ស្មារតី ថែរក្សា សន្តិភាព និង រំឭក ខួប នៃ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ
គោលការណ៍ និង អនុសាសន៍ សំខាន់ ៗ ទាំងនោះ រួម មាន៖
៤៖ រៀបចំ សិក្ខាសាលា ថ្នាក់ ជាតិ ស្តីពី គោល នយោបាយ ឈ្នះ ឈ្នះ ដើម្បី បង្ហាញ ពី ដំណើរការ អនុវត្ត និង តឹក តាង អំណះអំណាង រួមទាំង សមិទ្ធផល នយោបាយ ឈ្នះ ឈ្នះ ឱ្យ បាន ឯកភាព គ្នា តែ មួយ និង ប្រុងប្រៀប រៀបចំ ខួប ២៥ ឆ្នាំ នៃ ទិវា នយោបាយ ឈ្នះ ឈ្នះ និង ខួប៥ ឆ្នាំ នៃ វិមាន ឈ្នះ ឈ្នះ នា ឆ្នាំ ២០២៣ ។ សម្តេច នៅតែ អះអាង ថា នៅ ទីនេះ គ្រប់ ទីកន្លែង ទាំងអស់ ជា កន្លែង សាធារណៈ ដោយ មិន យក ថ្លៃ ចូល ទស្សនា សិក្សា ស្រាវជ្រាវ និង មក បំពេញ ទស្សនកិច្ច សិក្សា ។
( ភ្នំពេញ ) ៖ លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្ដិ រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ ក្រុមការងារ សុខាភិបាល ដែល មាន អគ្គ នាយក បច្ចេកទេស . អគ្គ នាយក រដ្ឋបាល ហិរញ្ញវត្ថុ ដោយ មាន ការចូលរួម ពី មន្ដ្រី អាកាសដ្ឋា អន្ដរជាតិ ភ្នំពេញ . មន្ដ្រីច ត្ដាឡី ស័ក និង អាជ្ញាធរ ទាំងអស់ ចុះ ពិនិត្យ ម ស្ថានភាព អ្នកដំណើរ អញ្ជើញ ចូលមក ប្រទេស កម្ពុជា តាម អាកាសដ្ឋាន អន្ដរជាតិ ភ្នំពេញ ។
លោកស្រី វេជ្ជបណ្ឌិត បាន ថ្លែង ថា ក្រុមការងារ សុខាភិបាល និង មន្ដ្រី អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ បាន ចុះ មក ពិនិត្យ អាកាសដ្ឋាន អន្ដរជាតិ ភ្នំពេញ ដែល ជា ទីតាំង ទទួល អ្នកដំណើរ យ៉ាង ច្រើន អញ្ជើញ ចូលមក ប្រទេស កម្ពុជា ដើម្បី ពិនិត្យ ទីតាំង ដាក់ បន្ថែម នូវ ម៉ាស៊ីន ស្កេន កំដៅ ចំនួន ៣ គ្រឿង ទៀត នៅ ច្រក ចេញ ចូល VIP ចំនួន១ គ្រឿង និង ធម្មតា ចំនួន ២គ្រឿង ដើម្បី ធ្វើការតាមដាន សុខភាព អ្នកដំណើរ ដែល ចូលមក ប្រទេស យើង ។
លោកស្រី រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សុខាភិបាល បាន គូសបញ្ជាក់ ថា « យើង បាន ឯកភាព គ្នា ថា យើង នឹង ដាក់ នូវ ម៉ាស៊ីន ស្កេន កំដៅ នៅ កន្លែង ដែល ភ្ញៀវ អញ្ជើញ មកដល់ ហើយ នៅ ទីតាំង VIP ក៏ យើង នឹង ដាក់ ម៉ាស៊ីន ស្កេន កំដៅ ដើម្បីឱ្យ ប្រាកដប្រជា ថា អ្នកដំណើរ អញ្ជើញ ចូល ប្រទេស កម្ពុជា មាន កំដៅ ធម្មតា ឬ ក៏ មាន ការកើន កំដៅ ប្រសិនបើ មាន ការកើនឡើង កំដៅ ៣៧.៥អង្សា យើង នឹង អញ្ជើញ គាត់ ទៅ ពិនិត្យ សុខភាព ដើម្បី រក្សា សុខភាព ជូន គាត់ » ។
បន្ថែម លើស ពី នោះ ក្រសួង សុខាភិបាល ក៏ បាន ដាក់ នូវ ម៉ាស៊ីន ស្កេន កំដៅ នៅ ព្រលានយន្ដហោះ សៀមរាប និង នៅ តាម ព្រំដែន ផងដែរ ដើម្បី ប្រាកដប្រជា ថា អ្នកធ្វើដំណើរទស្សនៈកិច្ចមក កម្ពុជា មក លេង បងប្អូន នៅក្នុង ឱកាស ចូល ឆ្នាំ សកល គាត់ មាន សុខភាព ល្អ ឬ អការៈ ធម្មតា ។
លោកស្រី វេជ្ជបណ្ឌិត បាន ថ្លែង បន្ដ ថា ក្នុង នាម ក្រសួង សុខាភិបាល ក៏ ដូចជា ថ្នាក់ដឹកនាំ លោក តែងតែ យកចិត្ដទុកដាក់ ជាពិសេស សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា លោក តែងតែ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឱ្យ មាន ការប្រយ័ត្នប្រយែង ត្រូវតែ អនុវត្ដ វិធានការ ៣កុំ ៣ការពារ ជាពិសេស ប្រជាពលរដ្ឋ ដែល មិន ទាន់ បាន ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ក៏ សូមអញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង ដែល មាន នៅ គ្រប់ ទីកន្លែង តាម មណ្ឌល សុខភាព ឬ មន្ទីរពេទ្យ ដែល នៅជិត ផ្ទះ របស់ ពលរដ្ឋ យើង ។
ទន្ទឹម នឹង នោះ លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្ដិ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល អញ្ជើញ ទៅ កំសាន្ដ នៅ តាម រម្មណីយដ្ឋាន ផ្សេង ៗ ក៏ ត្រូវ ប្រយ័ត្នប្រយែង ទោះ យើង ដឹង ហើយ ថា ប្រទេស កម្ពុជា យើង មាន ការថមថយ នៃ អត្រា ឆ្លង ជំងឺ កូវីដ១៩ ក្ដី តែ យើង ក៏ ត្រូវតែ បន្ដ ការពារ ខ្លួន ដូច្នេះ ក្រសួង សុខាភិបាល នៅ បន្ដ ធ្វើ ការណែនាំ ដល់ ប្រជាជន ឱ្យ មាន ការយល់ដឹង កាន់តែ ច្រើន ព្រោះ កន្លងមក កម្ពុជា ទទួលបាន ជោគជ័យ ក្នុង ការប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ដោយសារតែ មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ យើង ៕
មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ចុះ ពិនិត្យ ទីតាំង គម្រោង របស់ អង្គការ ប៉ាដិក នៅ ខេត្ត ពោធិ៍សាត់
ក្នុង ដំណើរទស្សនកិច្ច នេះ លោក បាន ចាប់ផ្តើម ចុះ ពិនិត្យ ការសម្អាត និង ដើរ តាម ខ្នង ប្រឡាយ ក្បាល ហុង ដែល នៅជាប់ នឹង ភូមិ វាល ស្រុក កណ្តៀង និង ភូមិ ក្បាល ហុង សង្កាត់ ផ្ទះ ព្រៃ ដែល អង្គការ ប៉ាដិក បាន អនុវត្ត ការសម្អាត ប្រឡាយ ប្រវែង១. ៣៥ គីឡូម៉ែត្រ ដែល ពោរពេញ ទៅ ដោយ ប្លាស្ទិក និង សំរាម ជា ប្រភព នៃ មេរោគ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក បាន សំណេះសំណាល ជាមួយ មន្ត្រី មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ នោះ ដោយ បាន ស្នើ ឱ្យ សហគមន៍ ចូលរួម ជួយ ថែរក្សា សម្អាត ប្រឡាយ នេះ ឱ្យ បាន ស្អាត ល្អ ត ទៅ មុខ ទៀត ក្រោយ ការបិទ គ គម្រោង របស់ អង្គការ ប៉ាដិក ។
ប្រជា សហគមន៍ បាន គោរព ថ្លែងអំណរគុណ ជូន ដល់ ថ្នាក់ដឹកនាំ គ្រប់ ជាន់ ថ្នាក់ ពិសេស អង្គការ ពាក់ព័ន្ធ ដែល បាន ជួយ សម្អាត ប្រឡាយ សម្អាត ប្រឡាយ ក្បាល ហុង ធ្វើឱ្យ ប្រជាពលរដ្ឋ ទទួលបាន ប្រយោជន៍ ជាច្រើន ពី គម្រោង នេះ ។ ជាមួយគ្នា នោះ ពួកគាត់ ប្តេជ្ញា នឹង ចូលរួម ថែរក្សា សម្អាត ប្រឡាយ ក្បាល ហុង ចាប់ពី ពេលនេះ តទៅ ។
តំណាង អង្គការ ប៉ាដិក បាន ថ្លែងអំណរគុណ ដល់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន . ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ADB និង អាជ្ញាធរ ពាក់ព័ន្ធ ដែល បាន ផ្តល់ ការគាំទ្រ ក្នុង ការអនុវត្ត គម្រោង ហើយ សង្ឃឹម ថា សហគមន៍ នឹង រក្សា សមិទ្ធិផល ទាំងអស់ នេះ ឱ្យ បាន យូរអង្វែង បន្ទាប់ពី អង្គការ ប៉ាដិក នឹង ត្រូវ បញ្ចប់ គម្រោង នៅ ចុង ខែធ្នូ ឆ្នាំ ២០២២ នេះ ។
អាជ្ញាធរ និង ប្រជាពលរដ្ឋ ខណ្ឌ មានជ័យ រៀបចំ ពិធី ឡើង អ្នក តា ម្ចាស់ ស្រុក ដើម្បី សុំ សេចក្តីសុខ ចម្រើន
លោក ហែម ដារិទ្ធ និង ប្រជាពលរដ្ឋ បាន រៀបចំ ឲ្យ មាន ពិធី ជាច្រើន ទម្រង់ ឲ្យ ស្រប ទៅតាម គន្លង នៃ ព្រះពុទ្ធ សាសនា និង តាម បែប ជំនឿ អរូបិយ៍ ដែល ស្រប ទៅតាម ជំនឿ របស់ ប្រជាពលរដ្ឋ ដើម្បី សុំ សេចក្តីសុខ ចម្រើន ក្នុង ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក ហែម រិទ្ធ ធ្វើ ការបូជា ទៀន ធូប ថ្វាយ ជូន ដល់ ស្តេច ក្រុង ពាលី និង បាន ធ្វើ ការថ្វាយ សំណែន ថ្វាយ ជូន ដល់ អ្នកតា ម្ចាស់ ស្រុក ដើម្បី សុំ ពរ ជ័យ ពី ម្ចាស់ ទឹក ម្ចាស់ ដី ។ ក្នុង នោះ ក៏ មាន រៀបចំ នូវ ពិធី ពូន ភ្នំ ខ្សាច់ ច់ កម្មពារ ដែល បាន សាង នា ពេល កន្លងមក ការបញ្ចុះ ថ្ម ហៅ ថា ថ្ម អ្នកស្រុក ដើម្បី សុំ សេចក្តីសុខ ចម្រើន រឹងមាំ គង់វង្ស មាន សិរី សួស្តី ជូន ប្រជាពលរដ្ឋ ផងដែរ ។
សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ត្បូងឃ្មុំ បន្ត ចែក អំណោយ ជូន ពលរដ្ឋ ងាយ រងគ្រោះ ជិត ៤០០ គ្រួសារ នៅ ស្រុក អូរ រាំង ឪ
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត និង លោក ស៊ាក ឡេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត នា ព្រឹក ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន បន្ត ចុះ សំណេះសំណាល សួរសុខទុក្ខ នាំយក អំណោយ មនុស្សធម៌ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ទៅ ចែកជូន ដល់ ជន ងាយ រងគ្រោះ បំផុត ចំនួន ៣៩៤ គ្រួសារ នៅ បរិវេណ សាលា ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ ។
ក្នុង ពិធី ចែក អំណោយ មនុស្សធម៌ នោះ ដែរ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី អភិបាល រង ខេត្ត សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម ខេត្ត ថ្នាក់ដឹកនាំ និង សមាជិក សាខា កាកបាទ ក្រហម ខេត្ត ប្រធាន អនុសាខា កាកបាទ ក្រហម ស្រុក និង ប្រជាពលរដ្ឋ ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ពាំនាំ នូវ ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ផ្ដាំផ្ញើ ការសួរសុខទុក្ខ ដោយ ក្តីបារម្ភ នឹករលឹក អាណិត ស្រឡាញ់ យ៉ាង ជ្រាលជ្រៅ និង បាន នាំយក អំណោយ មួយចំនួន ដើម្បី ជួយ សម្រាល ដល់ ការលំបាក របស់ ប្រជាពលរដ្ឋ ។
ស្ថិត ក្នុង ឱកាស នោះ លោក បណ្ឌិត បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ជឿជាក់ មក លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ តែងតែ ខិតខំ លះបង់ កំលាំង កាយ ចិត្ត ត ស៊ូ នាំយក សន្តិភាព ថែរក្សា សន្តិភាព និង បន្ត អភិវឌ្ឍន៍ រីកចម្រើន រហូតដល់ សព្វ ថ្ងៃ នេះ ជា បន្ត ទៀត ដោយ ត្រូវ ទៅ បោះឆ្នោត នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ឲ្យបាន គ្រប់ ៗ គ្នា គាំទ្រ សម្តេច ជា នាយក រដ្ឋមន្ត្រី គ្រប់ ៗ អាណត្តិ ។
បន្ថែម ពី នេះ លោក បណ្ឌិត អភិបាល ខេត្ត បាន លើកឡើង ពី យុទ្ធសាស្ត្រ ស្រោច វ៉ាក់សាំង បាន យ៉ាង ល្អ របស់ សម្តេច តេជោ ដែល ធ្វើឲ្យ កម្ពុជា ជោគជ័យ លើ ការងារ ប្រយុទ្ធ ប្រឆាំង ជាមួយ កូវីដ១៩ បើ ប្រៀបធៀប ទៅនឹង ប្រទេស មួយចំនួន ធំ ។
ជា ចុងក្រោយ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ក៏ បាន ផ្តាំផ្ញើ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ជាប់ ជានិច្ច ចំពោះ គ្រោះ អគ្គិភ័យ និង គ្រោះ ធម្មជាតិ ដែល តែង កើត មាន ឡើង ជា យថាហេតុ និង ត្រូវ ចេះ អប់រំ កូន ចៅ ឱ្យ ចៀស ឆ្ងាយ ឧបាយ មុខ ផ្សេង ៗ ហើយ ត្រូវ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ឲ្យបាន ម៉ឺងម៉ាត់ ផងដែរ ។
បើ តាម លោក វ៉ង វ៉ាន់ នី នាយក ប្រតិបត្តិ សាខា កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ បាន ឲ្យដឹង ថា អំណោយ មនុស្សធម៌ ដែល សាខា កាកបាក្រហម ខេត្ត នាំយក មក ផ្តល់ ជូន ដល់ ជន ងាយ រងគ្រោះ ចំនួន ៣៩៤ គ្រួសារ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន អង្ក២៥ គីឡូក្រាម . មី១ កេស . ត្រីខ ១យួរ . ទឹកត្រី ១យួរ . ទឹក ស៉ី អ៉ីវ១យួរ និង ថវិកា មួយ ចំនួន ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៣៥០ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ទូរស័ព្ទ អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស ល្បឿន ខ្សែក្រវាត់ ឆៀក ទូរស័ព្ទ អត់ បណ្ណ បើកបរ និង សញ្ញា ជាដើម ។
រដ្ឋបាល ខេត្ត កំពង់ចាម៖ ផ្លូវ លំ មួយ ខ្សែ ជាង ១០គីឡូម៉ែត្រ ក្នុង ស្រុក កំពង់សៀម ត្រៀម រៀបចំ អភិវឌ្ឍន៍ ជា ផ្លូវ ក្រាល កៅស៊ូ
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ ក្រុមការងារ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ចុះ ពិនិត្យ ស្ថានភាព ផ្លូវ លំ មួយ ខ្សែ ប្រវែង ១១.៩៦០ ម៉ែត្រ តភ្ជាប់ ពី ភូមិ អន្លង់ ស្នូក ឃុំ អូរ ស្វាយ ទៅ ភូមិ ល្អាក ឃុំ ស្រក ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម ដើម្បី អភិវឌ្ឍន៍ ជា ផ្លូវ ក្រៅ កៅស៊ូ ។
តាម មន្ត្រី រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ឲ្យដឹង ថា បន្ទាប់ពី អភិបាល ខេត្ត កំពង់ចាម បាន ចុះ ពិនិត្យ ដោយ ផ្ទាល់ លោក យល់ឃើញ ថា ផ្លូវ មួយ ខ្សែ នេះ ជា ផ្លូវ យុទ្ធសាស្ត្រ សំខាន់ មួយ ដែល មាន ប្រជាពលរដ្ឋ ប្រើប្រាស់ ច្រើន ដូចជា ការដឹក កសិផល មកកាន់ ទីផ្សារ ( ស្រូវ ស្វាយ ចាន្ទី ដំឡូង មី ) ការធ្វើដំណើរ ទៅ ប្រកប អាជីវកម្ម ផ្សេង ៗ ដឹក អ្នកជំងឺ ទៅកាន់ មន្ទីរពេទ្យ រួមទាំង កុមារ ទៅ សាលារៀន ។ល ។
( កំពត ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន គូសបញ្ជាក់ ថា កត្តា សុខ សន្តិភាព ពេញលេញ និង ស្ថិរភាព នយោបាយ ដ៏ រឹងមាំ និង កំណើន សេដ្ឋកិច្ច ខ្ពស់ បាន ផ្តល់ កាលានុវត្តភាព ដ៏ វិសេសវិសាល សម្រាប់ កិច្ច គាំពារ បរិស្ថាន ការអភិរក្ស ជីវៈ ចម្រុះ និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព មិន ធ្លាប់ មាន ពីមុន មក សម្រាប់ ប្រទេស កម្ពុជា ។
ការគូសបញ្ជាក់ ថា របស់ លោក នេត្រ ភក្ត្រា បាន ធ្វើឡើង នៅក្នុង ឱកាស ចូលរួម ជា គណៈអធិបតី កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២២ និង ការលើក ទិសដៅ ការងារ សម្រាប់ ឆ្នាំ ២០២៣ របស់ មន្ទីរ បរិស្ថា ខេត្ត កំពត ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក នៃ គង់ អភិបាល រង ខេត្ត កំពត និង មន្ត្រី ពាក់ព័ន្ធ សរុប ប្រមាណ ៣០០ នាក់ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន រូប នេះ បាន លើកឡើង ថា នៅ ថ្ងៃទី ២៩ ខែធ្នូ គឺជា ខួប អនុស្សាវរីយ៍ ២៤ ឆ្នាំ នៃ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល នៅ កម្ពុជា តាមរយៈ ការអនុវត្ត នយោបាយ ឈ្នះ - ឈ្នះ ដែល ដាក់ចុះ ដោយ សម្តេច តេជោ ហ៊ុន សែន បញ្ចប់ សង្គ្រាម ស៊ីវិល និង នាំយក សុខ សន្តិភាព ពេញលេញ ជូន ជាតិ និង ប្រជាជន កម្ពុជា ។
« សុខ សន្តិភាព ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ នេះ គឺជា បុរេលក្ខខណ្ឌ មិន អាច ខ្វះ សម្រាប់ កិច្ចការពារ ធនធាន ធម្មជាតិ និង ការអភិរក្ស ជីវៈ ចម្រុះ នៅ កម្ពុជា និង បាន ផ្តល់ ឱកាស និង ធនធាន ដល់ មន្ទីរ បរិស្ថាន ខេត្ត កំពត បំពេញ ការងារ ដើម្បី បុព្វហេតុ បរិស្ថាន និង ធនធាន ធម្មជាតិ » ។ នេះ ជា ការលើកឡើង បន្ថែម របស់ លោក នេត្រ ភក្ត្រា ។
លោក រដ្ឋលេខាធិការ បាន បន្ថែម ថា ក្រោយពី កម្ពុជា ងើប ឡើងវិញ ពី ផេះ ផង់ សមុទ្រ ឈាម ទឹកភ្នែក និង គំនរ ឆ្អឹង នៃ សង្គ្រាម ស៊ីវិល កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន បាន បង្កើតឡើងវិញ នូវ តំបន់ ការពារ ធម្មជាតិ នៅក្នុង ឆ្នាំ ១៩៩៣ ដោយ មាន ឡាយ ព្រះហស្ត លេខា របស់ ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហនុ និង ការបង្កើត ស្ថាប័ន ទទួលបន្ទុក វិស័យ បរិស្ថាន ដែល ជា ការឆ្លុះបញ្ចាំង អំពី ការគិតគូរ ជា យុទ្ធសាស្ត្រ វែងឆ្ងាយ ក្នុង ការរៀបចំ កសាង សង្គមជាតិ ថ្មី ជឿនលឿន ។
ជាមួយគ្នា នេះ ដែរ លោក នេត្រ ភក្ត្រា បាន បន្ត ថា ដោយសារតែ កត្តា សុខ សន្តិភាព ពេញលេញ បាន ធ្វើឱ្យ ការគ្រប់គ្រង និង អភិរក្ស ធនធាន ធម្មជាតិ មាន ភាពល្អ ប្រសើរ ហើយ បច្ចុប្បន្ន នេះ កម្ពុជា បាន ផ្លាស់ប្តូរ បត់ ថ្មី ដោយ ប្រែក្លាយ ពី ប្រទេស កាប់ ឈើ ដើម្បី រក ចំណូល សេដ្ឋកិច្ច មក ជា ប្រទេស ដែល មាន សមត្ថភាព ពេញលេញ លើ ការថែរក្សា ព្រៃឈើ ឱ្យ នៅ ឈរ ដើម្បី រក ចំណូល សម្រាប់ សង្គម តាមរយៈ ការលក់ ឥណទាន កាបូន និង ទេសចរណ៍ ធម្មជាតិ បង្កើត ការងារ និង ចំណូល ជូន ប្រជាពលរដ្ឋ ។
* ហេតុការណ៍ មនុស្ស រត់ ជាន់ គ្នា ស្លាប់ នៅ ឥណ្ឌូណេស៉ី
អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ជូនដំណឹង ពី ការដាក់ ឲ្យ អនុវត្ត មុខងារ ទូទាត់ តាម មធ្យោបាយ អេឡិចត្រូនិក ជាមួយ ធនាគារ វីង
សេចក្ដីជូនដំណឹង បាន បញ្ជាក់ ថា ដើម្បី ពង្រឹង ប្រសិទ្ធភាព នៃ កិច្ច សម្រួល ពាណិជ្ជកម្ម ក៏ ដូចជា ជួយ សម្រួល បន្ថែម ទៀត ដល់ ធុរ ជន អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន រៀបចំ រួចរាល់ នូវ មុខងារ ទូទាត់ តាម មធ្យោបាយ អេឡិចត្រូនិក ជាមួយ ធនាគារ វឹង បន្ថែម ពីលើ ធនាគារ ដៃគូ ដែល មាន ស្រាប់ ។
សេចក្ដីជូនដំណឹង បាន គូសបញ្ជាក់ ថា « ក្នុង ន័យ នេះ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា សម្រេច ដាក់ ឲ្យ អនុវត្ត មុខងារ នេះ ចាប់ពី ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២៣ នេះ តទៅ » ។
ក្នុង សារ វីដេអូ របស់ លោក សម្រាប់ ឆ្នាំ ថ្មី ២០២៣ លោក ហ្គូតឺ រេស បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « នៅក្នុង ឆ្នាំ ២០២៣ ចូរ យើង ទាំងអស់ គ្នា តម្កល់ សន្តិភាព ឱ្យ នៅ ចំ កណ្តាល នៃ ពាក្យ សម្តី និង សកម្មភាព ទាំងឡាយ របស់ យើង ។ នៅ ឆ្នាំ ២០២៣ យើង ត្រូវការ សន្តិភាព ជាង ពេល ណា ៗ ទាំងអស់ ។ ចូរ បង្កើត សន្តិភាព ជាមួយគ្នា តាមរយៈ កិច្ចសន្ទនា ដើម្បី បញ្ចប់ ជម្លោះ ។ ចូរ បង្កើត សន្តិភាព ជាមួយ ធម្មជាតិ និង អាកាសធាតុ របស់ យើង ដើម្បី កសាង ពិភពលោក ដែល ប្រកបដោយ និរន្តរភាព ជាង មុន » ។
អគ្គ លេខាធិការ UN រូប នេះ បាន បន្ត ថា នៅក្នុង គ្រួសារ និង ផ្ទះសម្បែង ក៏ ត្រូវការ សន្តិភាព ដែរ ដើម្បីឱ្យ ស្រ្តី និង ក្មេងស្រី ៗ អាច រស់ នៅ ប្រកបដោយ សេចក្តីថ្លៃថ្នូរ និង សុវត្ថិភាព ហើយ បន្ថែម ពី នេះ គឺ សន្តិភាព នៅ តាម ដងផ្លូវ ដែល ជារឿយ ៗ បាន មើលឃើញ ការប្រើប្រាស់ អំពើហិង្សា ដោយ កងកម្លាំង សន្តិសុខ ប្រឆាំង នឹង ក្រុម អ្នកតវ៉ា ដែល ធ្វើ បាតុកម្ម ដោយ សន្តិវិធី ។
ជា ចុងក្រោយ លោក ប្រមុខ អង្គការ សហ ប្រជាជាតិ បាន លើកឡើង ថា « ទាំងអស់ គ្នា ចូរ ពួកយើង ធ្វើឱ្យ ឆ្នាំ ២០២៣ ក្លាយជា ឆ្នាំ មួយ ដែល សន្តិភាព ត្រូវបាន ស្តារ មកវិញ សម្រាប់ ជីវិត រស់ នៅ ផ្ទះសម្បែង និង ពិភពលោក របស់ យើង »៕
បណ្ណាល័យ ២កន្លែង សាងសង់ អស់ ជាង ១៨ ម៉ឺន ដុល្លារ ជា អំណោយ ប្រជាជន កូរ៉េ នៅ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ត្រូវបាន សម្ពោធ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ
ពិធី នោះ ដែរ ក៏ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ លោកគ្រូ អ្នកគ្រូ មាតាបិតា សិស្សានុសិស្ស ជិត ៥០០ នាក់ ។
ទន្ទឹម គ្នា នេះ អាជ្ញាធរ ហ្វីលីពីន ក៏ កំពុង នៅ បន្ត តាម ស្វែងរក មនុស្ស ជាង ២០ នាក់ ផ្សេង ទៀត ដែល បាន បាត់ខ្លួន ក្រោយ ការធ្លាក់ ភ្លៀង យ៉ាង ជោគជាំ កាលពី ចុង សប្តាហ៍ កន្លងទៅ ដែល បង្កឱ្យ មាន គ្រោះ រអិល បាក់ ដី និង ទឹក ជំនន់ ធ្ងន់ធ្ងរ នៅ ពាសពេញ តំបន់ ភាគ កណ្តាល និង ភាគ ខាងត្បូង ហ្វីលីពីន ផងដែរ ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ គឺជា ខួប លើក ទី៤ ឆ្នាំ នៃ ការសាងសង់ វិមាន ឈ្ន ឈ្នះ ដែល និមិត្តរូប នៃ ជោគជ័យ ក្នុង នយោបាយ ឈ្នះ ឈ្នះ ដែល ដាក់ចេញ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា កាលពី ២៤ ឆ្នាំ មុន ។
ទស្សនា វីដេអូ ស្តីពី ទស្សនទាន នៃ ការសាងសង់ វិមាន ឈ្នះ ឈ្នះ ដូចត ទៅ៖
ប្រកាស ផ្ទេរ ភារកិច្ច តែងតាំង មុខ តំណែង និង បំពាក់ ឋានន្ដរស័ក្ដិ ជូន មន្ដ្រី នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ចំនួន ២៦ រូប
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ បេង ដាណារ៉ា ស្នងការ រង និង លោក ឧត្តមសេនីយ៍ ទោ ប៊ុន សុសិក្ខា ស្នងការ រង តំណាង លោក ឧត្ដមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ប្រកាស ផ្ទេរ ភារកិច្ច តែងតាំង មុខ តំណែង និង បំពាក់ ឋានន្ដរស័ក្ដិ ជូន មន្ដ្រី នគរបាល ជាតិ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
( ព្រះសីហនុ) ៖ លោក ឧកញ៉ា ទៀ វិចិត្រ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា មូលដ្ឋាន ភ្នាក់ងារ ដឹកជញ្ជូន ទេសចរណ៍ ជល យាន ខេត្ត ព្រះសីហនុ បាន បញ្ជូន អូប័រ ពេទ្យ ល្បឿន លឿន និង ក្រុមការងារ សង្គ្រោះ ទៅ ទទួលយក ស្រ្តី មាន ផ្ទៃពោះ មួយ រូប ដែល មាន អាការៈ ធ្លាក់ ឈាម រស់ នៅក្នុង ក្រុង កោះ រ៉ុង យកមក ខេត្ត ព្រះសីហនុ ដើម្បី សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ ឯកជន នា ល្ងាច ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២២ ។
លោក ឧកញ៉ា ទៀ វិចិត្រ បាន ឲ្យដឹង ថា ស្រ្តី មាន ផ្ទៃពោះ ខាងលើ មាន ឈ្មោះ ជួ បុផ្ផា អាយុ ២២ ឆ្នាំ កំពុង មាន ផ្ទៃពោះ ៣ខែ ប្តី ឈ្មោះ កង ធារ៉ា អាយុ ២៤ ឆ្នាំ សព្វ ថ្ងៃ រស់ នៅ ភូមិ កោះ រ៉ុង សន្លឹម ( សារ៉ា សាន់ បេ) សង្កាត់ កោះ រ៉ុង សន្លឹម ក្រុង កោះ រ៉ុង ខេត្ត ព្រះសីហនុ ។
បច្ចុប្បន្ន ស្រ្តី មាន ផ្ទៃពោះ ខាងលើ ត្រូវបាន ក្រុមការងារ សង្គ្រោះ របស់ លោក បញ្ជូន តាម អូប័រ ពេទ្យ ល្បឿន លឿន មកកាន់ កំពង់ផែ នៅ ក្រុង ព្រះសីហនុ ដោយ សុវត្ថិភាព និង បន្ត ដឹក តាម រថយន្ត សង្គ្រោះ របស់ គណៈកម្មាធិការ គណបក្ស មូលដ្ឋាន ភ្នាក់ងារ ដឹកជញ្ជូន ទេសចរណ៍ ជល យាន ខេត្ត ព្រះសីហនុ យក ទៅ សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ ក្នុង ខេត្ត ព្រះសីហនុ ៕ តំណាង បណ្ឌិត ហ៊ុន ម៉ាណែត សួរសុខទុក្ខ នាយ ឧត្តមសេនីយ៍ ផាន់ ងួន
លោក ចាយ បូរិន បាន នាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ប្រធាន គណបក្ស សម្តេច ចក្រី ប្រធាន កិត្តិយស គណបក្ស សម្តេច អនុប្រធាន គណបក្ស ថ្នាក់ដឹកនាំ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ រួម ជាមួយ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជូន ចំពោះ នាយ ឧត្តមសេនីយ៍ ផាន់ ងួន និង ក្រុមគ្រួសារ ។
នាយ ឧត្តមសេនីយ៍ ផាន់ ងួន មាន ក្តីរំភើប យ៉ាង ខ្លាំង ឥត ឧបមា និង អរគុណ ជា អនេក ព្រមទាំង បាន សម្តែង នូវ ការដឹងគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ថ្នាក់ដឹកនាំ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ ជាពិសេស លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ដែល បាន ចាត់ លោក ចាយ បូរិន ជា តំណាង មក សួរ សុខទុក្ខ លោក នាយ ឧត្តមសេនីយ៍ និង ក្រុមគ្រួសារ ដល់ លំនៅដ្ឋាន ធ្វើឲ្យ នាយ ឧត្តមសេនីយ៍ និង ក្រុមគ្រួសារ ទទួលបាន នូវ ភាព កក់ក្តៅ និង ជា កិត្តិយស សម្រាប់ ក្រុមគ្រួសារ ។
នាយ ឧត្តមសេនីយ៍ ក៏ បាន បញ្ជាក់ ពី ការគាំទ្រ យ៉ាង ច្បាស់ ចំពោះ បេក្ខភាព សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ជារៀងរហូត និង ការគាំទ្រ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា អ្នក បន្ត វេន ដែល ពោរពេញ ទៅ ដោយ ចំណេះដឹង សមត្ថភាព សីលធម៌ គុណធម៌ សក្តិសម ជា អ្នក បន្ត វេន ដឹកនាំ ប្រទេសជាតិ នា ពេល អនាគត ។
នាយ ឧត្តមសេនីយ៍ ផាន់ ងួន ក៏ បាន រៀបរាប់ ពី ប្រវត្តិការងារ ថា ក្រោយ ថ្ងៃ រំដោះ ឆ្នាំ ១៩៧៩ បាន ចូល បម្រើ ការងារ នៅ ក្រសួង ការពារ ប្រទេស ផ្នែក កងទ័ព អាកាស ហើយ ទទួលបាន ដំណែង ជា អនុប្រធាន មន្ទីរ កងទ័ព អាកាស ជា ស្នងការរង ជា ស្នងការការពារ អាកាសចរណ៍ ជា អនុ រដ្ឋលេខាធិការ ជា រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា ទីប្រឹក្សា សម្តេច តេជោ ហ៊ុន សែន ( បច្ចុប្បន្ន ជា ទីប្រឹក្សា ក្រសួង ការពារ ជាតិ ) ។
នាយ ឧត្តមសេនីយ៍ ក៏ បាន លើកឡើង ផងដែរ ថា យុវជន ជំនាន់ មុន បាន យក ជីវិត ធ្វើជា ដើមទុន ដើម្បី បុព្វហេតុ ប្រជាជន និង ប្រទេសជាតិ ដើម្បី សុខ សន្តិភាព ហើយ ធ្វើ ការអភិវឌ្ឍ ប្រទេស ឲ្យ មាន ការរីកចម្រើន ឥត ឈប់ឈរ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ធ្វើឲ្យ ប្រទេសជាតិ មាន កេរ្តិ៍ឈ្មោះ ស្មើ មុខមាត់ ជាមួយ បណ្តា ប្រទេស នានា នៅលើ ពិភពលោក ដូច្នេះ យុវជន ជំនាន់ ក្រោយ ក្រៅពី បន្ត ថែរក្សា សមិទ្ធផល របស់ ថ្នាក់ដឹកនាំ ជំនាន់ មុន ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ចំណុច ២សំខា ន់៖
១៖ ត្រូវ ខិតខំ បន្ត ការរៀនសូត្រ យកចិត្តទុកដាក់ ស្រាវជ្រាវ ដើម្បី ឈាន ទៅ ចាប់ យក ជំនាញ និង ចំណេះដឹង ឱ្យ បាន ច្បាស់លាស់ ពិតប្រាកដ ដែល នេះ គឺជា ការកសាង នូវ មូលដ្ឋានគ្រឹះ មួយ ដ៏ រឹងមាំ ដើម្បី សម្រេចបាន ជោគជ័យ ក្នុង ការបំពេញ មុខងារ តួនាទី និង ភារកិច្ច នា ពេល អនាគត ។
២៖ ពង្រឹង ឆន្ទៈ ស្នេហាជាតិ សាមគ្គី ជាតិ របស់ យុវជន ជំនាន់ ក្រោយ ឱ្យ បាន កាន់តែ ខ្លាំងក្លា ។
លោក នាយ ឧត្តមសេនីយ៍ ក៏ បាន ជូន ពរ ដល់ គណបក្ស ប្រជាជន កម្ពុជា ឲ្យ ទទួលបាន ជ័យជន្នះ លើសលប់ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដើម្បី បន្ត ដឹកនាំ ប្រទេស ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍ រាប់ សិប ឆ្នាំ ត ទៅ មុខ ទៀត ។
ក្នុង ឱកាស ដ៏ មាន អត្ថន័យ នេះ ដែរ សមាជិក សមាជិកា ប្រតិភូ បាន ប្រគល់ ជូន វត្ថុអនុស្សារីយ៍ និង ថវិកា ជា អំណោយ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជូន ដល់ នាយ ឧត្តមសេនីយ៍ ផាន់ ងួន និង ជូនពរ ដល់ លោក នាយ ឧត្តមសេនីយ៍ មាន សុខភាព ល្អ កម្លាំង មាំ មួន និង មាន ជន្មាយុ យឺនយូរ ៕
មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា៖ របប ខ្មែរ ក្រហម បាន ប្រព្រឹត្ត ការបំពារបំពាន សិទ្ធិ មនុស្ស យ៉ាង ធ្ងន់ធ្ងរ នៅក្នុង ទសវត្សរ៍ ទី ២០
( ភ្នំពេញ ) ៖ របប ខ្មែរ ក្រហម បាន ប្រព្រឹត្ត ការបំពារបំពាន សិទ្ធិ មនុស្ស យ៉ាង ធ្ងន់ធ្ងរ នៅក្នុង ទសវត្សរ៍ ទី២០ ដែល បណ្តាលឲ្យ ប្រជាជន កម្ពុជា ប្រមាណ ជាង ពីរ លាន នាក់ បាត់បង់ជីវិត ។ នេះ គឺជា សោកនាដកម្ម ដ៏ សោក សង្វេង នៅក្នុង ប្រវត្តិសាស្ត្រ មនុស្សជាតិ ។
កម្ពុជា បាន ទទួលរង ទុក្ខ ទោម្នេញ ពី របប នេះ ដោយ ផ្ទាល់ ក៏ប៉ុន្តែ កម្ពុជា បាន ស្វះស្វែង ស្តារ ប្រទេស របស់ ខ្លួន ពី បាត ដៃ ទទេ រហូត មាន ថ្ងៃ នេះ ។ កម្ពុជា នឹង បន្ត អភិវឌ្ឍ ខ្លួន ឲ្យ ប្រសើរឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ដើម្បី មនុស្ស ជំនាន់ ក្រោយ និង ជា ផ្នែក មួយ នៃ ពិភពលោក ដ៏ ត្រចះត្រចង់ ។
មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា មាន មោទកភាព ក្នុង ការចងក្រង ឯកសារ អំពី ប្រវត្តិសាស្ត្រ ដ៏ លំបាក លំបិន នេះ ដើម្បី បុព្វហេតុ យុត្តិធម៌ . ការចងចាំ និង ការផ្សះផ្សា សម្រាប់ ប្រជាជាតិ របស់ ខ្លួន និង ពិភពលោក ៕ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា រៀបចំ ពិព័រណ៍ ស្តី អំពី អំពើ ប្រល័យ ពូជសាសន៍ និង ការរស់រាន មាន ជីវិត ឡើងវិញ របស់ ប្រជាជន កម្ពុជា
( ភ្នំពេញ ) ៖ ដើម្បី អបអរ ពិធី ខួប ២៤ ឆ្នាំ នៃ ទិវា នយោបាយ ឈ្នះ ឈ្នះ អបអរសាទរ ខួប ២៤ ឆ្នាំ នៃ ការបញ្ចប់ សង្រ្គាម ស៊ីវិល នៅ កម្ពុជា និង ការអនុវត្ត ប្រកបដោយ ជោគជ័យ នយោបាយ ឈ្នះ ឈ្នះ ( ២៩ ធ្នូ ១៩៩៨ - ២៩ ធ្នូ ២០២២ ) និង ខួប៥ ឆ្នាំ នៃ វិមាន ឈ្នះ ឈ្នះ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា អនុញ្ញាតឲ្យ រៀបចំ ការតាំងពិព័រណ៍ ស្តី អំពី អំពើ ប្រល័យ ពូជសាសន៍ និង ការរស់រាន មាន ជីវិត ឡើងវិញ របស់ ប្រជាជន កម្ពុជា រយៈពេល ៣ ថ្ងៃ ពី ថ្ងៃទី ២៩ ដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ នៅ វិមាន ឈ្នះ ឈ្នះ ។
ពិព័រណ៍ ស្តី អំពី អំពើ ប្រល័យ ពូជសាសន៍ និង ការរស់រាន មាន ជីវិត ឡើងវិញ របស់ ប្រជាជន កម្ពុជា បាន រួមចំណែក ដល់ នយោបាយ ឈ្នះ ឈ្នះ ដើម្បី បញ្ចប់ សង្គ្រាម ស៊ីវិល នៅ កម្ពុជា ។ ខ្លឹមសារជា កម្មវត្ថុ រួម នៃ ពិព័រណ៍ ប្រវត្ដិសាស្រ្ដ ខ្មែរ ក្រហម ដើម្បី បង្ហាញ ឲ្យ ឃើញ ពី ដំណើរ ដើមទង នៃ ការឡើង កាន់អំណាច របស់ ខ្មែរ ក្រហម ការដួលរលំ របស់ ខ្មែរ ក្រហម ការតស៊ូ ក្នុង សង្គ្រាម ស៊ីវិល ក្រោយ ការដួលរលំ របស់ របប ខ្មែរ ក្រហម ឆ្នាំ ១៩៧៩ រហូតដល់ មាន គោល នយោបាយ ឈ្នះ ឈ្នះ និង ការរស់ ឡើងវិញ នៃ ប្រទេស កម្ពុជា ។
នៅក្នុង ខ្លឹមសារ ពិព័រណ៍ ទាំងមូល មាន ៣ ផ្នែក សំខាន់ ៗ គឺ
* ទី ១៖ អង្គការ ចាត់តាំង របស់ ខ្មែរ ក្រហម ដែល មាន រូបភាព ចាប់ពី ឆ្នាំ ១៩៧៥ ដល់ ឆ្នាំ ១៩៧៩ ដែល ពី កម្មាភិបាល ខ្មែរ ក្រហម មេដឹកនាំ កំពូល ៗ បាន ថត នៅ ទីតាំង ព្រលានយន្ដហោះ តាម មន្ទីរ នានា នៅក្នុង រដ្ឋធានី ភ្នំពេញ ក្នុង របប ខ្មែរ ក្រហម ដែល បង្ហាញ អំពី វត្ដមាន របស់ ខ្មែរ ក្រហម នៅ ទីនោះ ខណៈ ដែល មេដឹកនាំ ក្នុង របប នេះ បាន ជម្លៀស ប្រជាជន ចេញ ពី ទីក្រុង ភ្នំពេញ ដោយ បារម្ភ ខ្លាច មាន ការទម្លាក់ គ្រាប់បែក ។ ទាំងនេះ គឺជា ការភូតកុហក មួយ ។
* ទី២៖ បទឧក្រិដ្ឋកម្ម ប្រល័យ ពូជសាសន៍ ដែល បង្ហាញ អំពី ការធ្វើ ការងារ របស់ ប្រជាជន នៅ តាម សហករណ៍ ការដ្ឋាន លើក ទំនប់ ជីក ប្រឡាយ និង ប្រព័ន្ធ ធារាសាស្រ្ដ ផ្សេង ៗ ដែល សុទ្ធតែ ការងារ ដោយ បង្ខំ និង ភ័ស្ដុតាង ដែល បាន កើតឡើង ។ នៅក្នុង ផ្នែក ដដែល នេះ ក៏ បង្ហាញ អំពី ទីតាំង បទឧក្រិដ្ឋ ដូចជា ការគាស់ រណ្ដៅ សាកសព ជនរងគ្រោះ ដែល ខ្មែរ ក្រហម សម្លាប់ នៅ តាម បណ្ដា ភូមិឋាន នានា នៅក្នុង ប្រទេស កម្ពុជា នៅ ពាក់កណ្ដាល ទសវត្សរ៍ ឆ្នាំ ១៩៨០ ។
ជា រួម ផ្នែក នេះ គឺ និយាយ អំពី ការរស់ ឡើងវិញ ក្រោយ ការដួលរលំ នៃ របប ប៉ុល ពត និង ការកសាង សង្គមជាតិ ឡើងវិញ បន្ដិច ម្ដង ៗ រហូតដល់ ប្រទេស កម្ពុជា ទទួលបាន ការរីកចម្រើន ក្រោម ដំបូល នៃ សុខ សន្ដិភាព ដូច នា ពេល បច្ចុប្បន្ន នេះ ។
នៅក្នុង ពិព័រណ៍ នេះ ក៏ មាន ការរំលេច នូវ រូបថត របស់ សម្ដេច តេជោ ហ៊ុន សែន នៅក្នុង ការដំណើរតស៊ូ ឆ្លងកាត់ តំបន់ អិច ១៦ ចូល ទៅក្នុង ប្រទេស វៀតណាម ដើម្បី ស្នើសុំ ជំនួយ ដែរ ។ នៅក្នុង រូបថត នេះ មជ្ឈមណ្ឌល ឯកសារ កម្ព ជា បង្ហាញ នូវ ពាក្យស្លោក មួយ ឃ្លា ដែល និយាយ អំពី « រវាង លំហរ មេឃ និង ផែនដី គឺ វិមាន ឈ្នះ ឈ្នះ នៃ មនុស្សជាតិ ដែល បាន ប្រសូត្រ ចេញ ពី ដំណើរ ឆ្ពោះ ទៅរក ការផ្ដួល រំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត » ៕
ក្រសួង សេដ្ឋកិច្ច និង រដ្ឋបាល ខេត្ត កំពង់ចាម រៀបចំ វគ្គ បណ្តុះបណ្តាល ពង្រឹង សមត្ថភាព ស្តីពី ដំណើរការ និង និតិវិធី ក្នុង ការទទួលបាន ឥណទាន របស់ គម្រោង ACSEP លើ វិស័យ កសិកម្ម
( កំពង់ចាម ) ៖ លោក ម៉ី វ៉ាន់ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញ និង លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង សិក្ខាសាលា ផ្សព្វផ្សាយ និង បណ្តុះបណ្តាល ពង្រឹង សមត្ថភាព ស្តីពី ដំណើរការ និង និតិវិធី ក្នុង ការទទួលបាន ឥណទាន របស់ គម្រោង ACSEP សមាសភាគ ទី១ ។
ពិធី នេះ ធ្វើឡើង នៅ សណ្ឋាគារ ភ្នំ ប្រុស ក្រុង កំពង់ចាម ដោយ មាន ការចូលរួម ពី តំណាង រដ្ឋបាល ខេត្ត កំពង់ធំ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ និង រដ្ឋបាល ខេត្ត កំពង់ចាម ព្រមទាំង អភិបាល ក្រុង ស្រុក ទាំង១០ តំណាង សហគមន៍ ដៃគូ អភិវឌ្ឍន៍ និង អ្នក ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
