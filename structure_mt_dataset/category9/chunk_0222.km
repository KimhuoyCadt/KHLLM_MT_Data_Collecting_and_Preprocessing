( ភ្នំពេញ ) ៖ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ បាន លើកឡើង អំពី សច្ចធម៌ ប្រវត្តិសាស្ត្រ និង សមិទ្ធផល កសាង ជាតិ ដែល កើតឡើង បន្ទាប់ពី ថ្ងៃ រំដោះ ៧ មក រា ១៩៧៩ ផ្សព្វផ្សាយ បញ្ជ្រាប ដល់ សហជីព ក៏ ដូចជា កម្មករ និយោជិត នៅ កម្ពុជា ។
ការរំលឹក អំពី សច្ចធម៌ ប្រវត្តិសាស្ត្រ នេះ ត្រូវបាន ធ្វើឡើង ក្នុង ឱកាស លោក អ៉ិត សំហេង អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ សហភាព សហព័ន្ធ សហជីព និង សមាជិក - សមាជិកា ប្រមាណ ៣០០ នាក់ និង ជា ការចូលរួម អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ ទិវា ជ័យជម្នះ ៧ មករា ( ១៩៧៩ - ២០២៣ ) ដែល រៀបចំ នៅមុខ ទីស្នាក់ការ នៃ អគ្គ សម្ព័ន្ធ សហភាព សហជីព កម្ពុជា (CGCU) ស្ថិត នៅ សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ៤ ខែមករា ឆ្នាំ ២០២៣ ។
នា ឱកាស នោះ លោកស្រី ទេព គឹម វណ្ណារី ប្រធាន អគ្គ សម្ព័ន្ធ សហភាព សហជីព កម្ពុជា បាន សម្ដែង នូវ កតញ្ញូតាធម៌ ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល បាន ធ្វើ ពលីកម្ម គ្រប់ បែបយ៉ាង ដើម្បី បុព្វហេតុ ជាតិ និង ប្រជាជន និង ជា មគ្គុទ្ទេស ដ៏ ឆ្នើម នៃ ប្រជាជន កម្ពុជា ដែល បាន ដឹកនាំ ប្រទេស ឆ្លងកាត់ ដំណាក់កាល ដ៏ សែន លំបាក នានា សម្រេចបាន ជោគជ័យ ដ៏ ត្រចេះ ត្រចង់ ជូន ជាតិ និង ប្រជាជន ។
លោក អ៉ិត សំហេង បាន បញ្ជាក់ ថា ថ្ងៃ រំដោះ និង ទិវា ជ័យជម្នះ ៧ មករា គឺជា សច្ចធម៌ ប្រវត្តិសាស្ត្រ របស់ ប្រទេស កម្ពុជា ដែល ប្រជាពលរដ្ឋ គ្រប់ រូប បាន ចាត់ទុក ថ្ងៃ នេះ ជា ថ្ងៃ កំណើត ទី២ របស់ ខ្លួន ពិសេស គឺជា ថ្ងៃ បើក ទំព័រ នៃ ការកសាង ប្រទេស កសាង ជីវភាព ប្រជាជន កសាង សន្តិភាព ក សាង ហេដ្ឋារចនាសម្ពន្ធ និង សមិទ្ធផល នានា សម្រាប់ ជាតិ និង ប្រជាជនជា បន្តបន្ទាប់ លើកស្ទួយ កិត្យានុភាព ជូន ជាតិ លើ ឆាក អន្តរជាតិ ដឹកនាំ កម្ពុជា ទៅ រក ភាព ភ្លឺស្វាង ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា ៧ មករា មិន មែន គ្រាន់តែ រំដោះ ទឹកដី រំដោះ ជាតិ ប៉ុណ្ណោះ នោះ ទេ ប៉ុន្តែ ក៏ ជា ថ្ងៃ ដ៏ សំខាន់ ក្នុង ការជួយសង្គ្រោះ អាយុជីវិត ប្រជាជន ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ដែល កាន់ កាប់ ប្រទេស កាប់ សម្លាប់ ប្រជាជន អស់ រយៈពេល ៣ឆ្នាំ ៨ ខែ២០ ថ្ងៃ បណ្ដាលឱ្យ ប្រជាជន ជាង ៣លាន នាក់ ស្លាប់ ដោយ អយុត្តិធម៌ ព្រមទាំង បំផ្លាញ ហេដ្ឋារចនាសម្ព័ន្ធ ខ្ទេចខ្ទី ទៀតផង ។
លោក បាន បន្ត ទៀត ថា អ្វី ដែល ជា ការចងចាំ និង ជា មេរៀន ប្រវត្តិសាស្ត្រ គឺ ចាំបាច់ ត្រូវតែ រំលឹក ដើម្បីឱ្យ ទាំងអស់ គ្នា ខិតខំ ទប់ស្កាត់ អំពើ ប្រល័យ ពូជសាសន៍ នេះ កុំ ឱ្យ កើតឡើង សា ជា ថ្មី ។
លោក អ៉ិត សំហេង បាន រំលឹក ថា ក្រោយ ថ្ងៃ រំដោះ ៧ មក រា ១៩៧៩ រហូតដល់ ដំណាក់កាល ថ្មី នេះ ប្រជាជន កម្ពុជា បាន ទទួល ភាពយុត្តិធម៌ តាមរយៈ ការបង្កើត តុលាការ កូន កាត់ ( រាជ រដ្ឋាភិបាល កម្ពុជា និង អង្គការ សហ ប្រជាជាតិ ) ដែល បាន ជំនុំជម្រះ កាត់ទោស មេដឹកនាំ ប្រល័យ ពូជសាសន៍ និង បាន បញ្ចប់ បេសកកម្ម របស់ ខ្លួន នា ពេល កន្លងទៅ ។ អ្វី ដែល ពិសេស នោះ តុលាការ នេះ បាន ទទួលស្គាល់ ថា រដ្ឋាភិបាល កម្ពុជា ប្រជាធិបតយ្យ គឺ បាន បង្កើត នូវ បន ប្រល័យ ពូជសាសន៍ កាប់ សម្លាប់ ប្រជាជន យ៉ាង ព្រៃផ្សៃ ។
លោក រដ្ឋមន្ត្រី បាន អំពាវនាវ ដល់ សហជីព នានា នៅ កម្ពុជា រួម ជាមួយ កម្មករ និយោជិត ត្រូវ ចូលរួម ទប់ស្កាត់ អំពើ ដ៏ ព្រៃផ្សៃ នេះ កុំ ឱ្យ វិលត្រឡប់ មកវិញ ម្តង ទៀត នៅ កម្ពុជា និង ត្រូវ ចងចាំ នូវ អ្វី ដែល ជា សច្ចធម៌ ប្រវត្តិសាស្ត្រ ក៏ ដូចជា សមិទ្ធផល ដែល កើតមាន បន្ទាប់ពី ថ្ងៃ រំដោះ ៧ មករា ពិសេស ត្រូវ ចងចាំ នូវ ស្មារតី ទិវា ជ័យជម្នះ ៧ មករា ជាប់ ក្នុង ចិត្ត ជានិច្ច ។ សមិទ្ធផល ក្រោយ ថ្ងៃ ៧ មករា គឺ មាន តម្លៃ លើស អ្វី ៗ ទាំងអស់ ៕
ឆេះ ស្ដូប មិត្តភាព កម្ពុជា - វៀតណាម នៅ ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ . អាជ្ញាធរ ជួសជុល ឡើងវិញ រួចរាល់ ទាំងស្រុង
( បន្ទាយមានជ័យ )៖ ស្ដូប មិត្តភាព កម្ពុជា - វៀតណាម ដែល មាន ទីតាំង ស្ថិត នៅ ខាងលិច គល់ ស្ពាន ទឹក ថ្លា ក្នុង ភូមិ ទឹក ថ្លា សង្កាត់ ទឹក ថ្លា ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ត្រូវបាន គេ លួច ដុត បំផ្លាញ ។
របាយការណ៍ របស់ លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន ឲ្យដឹង ថា ក្រោយ ទទួលបាន ព័ត៌មាន នេះ កម្លាំង អធិការដ្ឋាន នគរបាល ក្រុង សិរី សោភ័ណ និង កម្លាំង ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល បាន ចុះ អន្ដរាគមន៍ នាំគ្នា ពន្លត់ មិន ឲ្យ រីករាលដាល នៅ កន្លែង ផ្សេង ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ទីតាំង ស្ដូប មិត្តភាព កម្ពុជា - វៀតណាម ដែល ត្រូវ ភ្លើង ឆេះ នោះ គឺ ខូចខាត ផ្ទាំង អក្សរ ក្រោម រូបសំណាក ផ្នែក ខាងលិច នៃ ស្ដូប ។ ផ្អែក តាម លទ្ធផល ស្រាវជ្រាវ របស់ គណៈកម្មការ ជំនាញ បាន សន្និដ្ឋាន ថា នេះ ជា ករណី លួច ដុត បំផ្លាញ ទ្រព្យសម្បត្តិ សាធារណៈ ។
ក្រោយ ហេតុការណ៍ នេះ កើតឡើង និង ស្រាវជ្រាវ រួចរាល់ នោះ កម្លាំង សមត្ថកិច្ច និង អាជ្ញាធរ បាន ជួសជុល កែលម្អ រ ឡើងវិញ រួចរាល់ ផងដែរ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ២៩៧ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៦៤២ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥៧៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៦៩ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្លាកលេខ បត់ ជែង ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ខ្សែក្រវាត់ ឆៀក ល្បឿន អត់ ប័ណ្ណ បើកបរ និង ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១០លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៦ នាក់ របួស ចំនួន ១៥នាក់ ( របួស ធ្ងន់ ចំនួន ១៣នាក់ ) ។ រយៈពេល ៤ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៤៥ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ២៧ នាក់ របួស ៥០ នាក់ ( របួស ធ្ងន់ ៣៧នាក់ )៕
ឃាត់ រថយន្ត ដឹក អុស ជា ប្រភេទ ដើម ស្វាយចន្ទី បម្រុង ឆ្លង ដែន ទៅ វៀតណាម តែ ត្រូវ នគរបាល ឃាត់
( រតនគិរី ) ៖ កម្លាំង នគរបាល ការិយាល័យ ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី កាលពី ថ្ងៃទី ៣ ខែមករា ឆ្នាំ ២០២៣ បាន ឃាត់ រថយន្ត ដឹក អុស ដើម ស្វាយចន្ទី មួយ គ្រឿង ដែល កំពុង ដឹក បម្រុង ទៅកាន់ ប្រទេស វៀតណាម ។
លោក ឧត្តមសេនីយ៍ ត្រី នូវ ដារ៉ា ស្នងការ រង នគរបាល ទទួល ផែន ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច បាន ប្រាប់ ថា ពេល គាត់ ចុះ ទៅ ជាមួយ តំណាង អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី មិន បាន ឃាត់ រថយន្ត ដឹក អុសចន្ទី ទេ ប៉ុន្តែ មិន អនុញ្ញាតឲ្យ រថយន្ត នោះ ដឹក អុសចន្ទី ទៅ ក្រៅ ទេ ពោលគឺ គ្មាន បែប បទ ឯកសារ ត្រឹមត្រូវ ។
ទាក់ទិន ទៅនឹង ការឃាត់ រថយន្ត ដឹក អុសចន្ទី ខាងលើ នេះ លោក កែវ ភក្តី អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី បាន ប្រាប់ ថា ពាក់ព័ន្ធ ទៅនឹង បច្ចេកទេស ផ្លូវថ្នល់ ដឹក លើស ទំងន់ មិន ពាក់ព័ន្ធ និង អុសចន្ទី ទេ ។
គេ សង្កេតឃើញ រថយន្ត ដឹក អុសចន្ទី នៅ ទ្រឹង មួយ កន្លែង វិល កង់ មិន រួច ជិត ច្រកទ្វារ អន្តរជាតិ អូរ យ៉ាដាវ រយៈពេល ២ ថ្ងៃ គឺ ថ្ងៃទី ៣- ៤ មាន កម្មករ ចំនួន ៥នាក់ មាន ទឹកមុខ ស្រពាប់ស្រពោន ដាច់ បាយ ក្រហាយ ទឹក មិន ទាន់ ដឹង ជំនាញ ខាង ណា អ្នក ទទួលខុសត្រូវ ។
កម្មករ ដែល នៅលើ រថយន្ត បាន បញ្ជាក់ ថា ពួកគាត់ បាន ប្រមូល ទិញ អុសចន្ទី ក្នុង ភូមិសាស្ត្រ ឃុំ ប៉ក់ញ៉ៃ ស្រុក អូរយ៉ាដាវ ដោយ ម៉ៅ ក្នុង ១ហិកតា តម្លៃ ១០ - ១៥ ម៉ឺន រៀល និង ម្ចាស់ ចំការចន្ទី ខ្លះ ទៀត ឲ្យ មិន គិត លុយ ព្រោះ ដើម ចន្ទី ចាស់ ៗ គ្មាន ផ្លែ ទៀត ទេ ដោយ គ្រាន់តែ ម្ចាស់ ចំការ ទាំងនោះ ឲ្យ ប្រមូល ដើម និង មែកចន្ទី ឲ្យ ស្អាត ហើយ យក ដី ដាំ ដំណាំ ផ្សេង ៗ ទៀត ហើយ ការចាប់ផ្តើម រកស៊ី ពួកគាត់ ជើង ទី១ មិន ទាន់ ដឹក ដល់ វៀតណាម ជួប ឧបសគ្គ តែម្តង ។
មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ ខេត្ត សុំ ណូមពរ ថ្នាក់ដឹកនាំឲ្យ ពួកគាត់ បាន ដឹក អុសចន្ទី ទៅ លក់ នៅ វៀតណាម ដោយ រលូន ផង ព្រោះ ដើម ចន្ទី ចាស់ ៗ អស់ ផ្លែ កន្លងមក កាប់ ដុត ចោល ដោយ គ្មាន អ្នកទិញ ឥលូវ មាន អ្នកទិញ ពួកគាត់ សប្បាយ ចិត្ត ណាស់ បាន កម្រៃ ខ្លះ ធ្វើ ចំការ និង ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ ផងដែរ ៕ នាយក រដ្ឋបាល សាលា ខេត្ត ត្បូងឃ្មុំ ចេញ សេចក្តី បំភ្លឺ អំពី ការចុះ ស្រាវជ្រាវ លើ ករណី ប្រធាន មន្ទីរ អប់រំ ខេត្ត ត្បូងឃ្មុំ
( ភ្នំពេញ ) ៖ លោក សេង ជ័យ វុធ នាយក រដ្ឋបាល សាលា ខេត្ត ត្បូងឃ្មុំ នៅ ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្តី បំភ្លឺ អំពី ការចុះ ស្រាវជ្រាវ លើ ករណី ប្រធាន មន្ទីរ អប់រំ ខេត្ត ត្បូងឃ្មុំ ។
លោក បាន រៀបរាប់ ដូច្នេះ ថា៖
« កន្លងមក នេះ ខ្ញុំបាទ សេង ជ័យ វុធ នាយក រដ្ឋបាល សាលា ខេត្ត ត្បូងឃ្មុំ បាន ទទួល ព័ត៌មាន ដែល បាន ផ្សព្វផ្សាយ លើ បណ្តាញ សង្គម និង ចុះផ្សាយ លើ បណ្តាញ សារព័ត៌មាន មួយចំនួន ពាក់ព័ន្ធ នឹង ភាព មិន ប្រក្រតី ក្នុង ការអនុវត្ត ការងារ របស់ លោក ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ត្បូងឃ្មុំ ដោយ ចោទប្រកាន់ ដូច ខាងក្រោម៖
១៖ ការប្រើប្រាស់ ថវិកា គ្រូបង្រៀន ពីរ ថ្នាក់ ពីរ ពេល ថ្នាក់ គួប បាន ដាក់ សាច់ញាតិ បងប្អូន មិត្តភក្តិ ដែល មាន ថវិកា ចំនួន ២០២.៨៩៥.០០០ រៀល ( ពីរ រយ ពីរ លាន ប្រាំបី រយ កៅសិប ប្រាំ ពាន់ រៀល គត់ ) ។
២៖ ការកាត់ប្រាក់ ឧបត្ថម្ភ គ្រូបង្រៀន ជាប់ កិច្ចសន្យា នៅ ស្រុក មេមត់ នៅ ខែមករា ឆ្នាំ ២០២២ ចំនួន ៩៥ នាក់ ដែល មាន ទឹកប្រាក់ សរុប ចំនួន ៩៦. ៨៣៧.២៥០ រៀល ( កៅសិប ប្រាំមួយ លាន ប្រាំបី រយ សាមសិប ប្រាំពីរ ពាន់ ពីរ រយ ហាសិប រៀល គត់ ) ។
៣៖ គ្រូបង្រៀន ថ្នាក់ គួប ចំនួន ៧នាក់ និង គ្រូបង្រៀន ពីរ ថ្នាក់ ពីរ ពេល ចំនួន ៦នាក់ សរុប ១៣នាក់ ដែល ទទួល ប្រាក់ ឧបត្ថម្ភ ពុំ គ្រប់ ខែ ដែល បាន បង្រៀន ។
ឆ្លើយតប ទៅនឹង បញ្ហា ខាងលើ ខ្ញុំបាទ សូម បញ្ជាក់ បន្ថែម ថា ការអនុវត្ត ការងារ របស់ លោក ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា គឺ មិន ធ្វើឱ្យ ប៉ះពាល់ ដល់ ការអនុវត្ត ការងារ ប្រចាំ ថ្ងៃ របស់ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ត្បូងឃ្មុំ នោះ ទេ ប៉ុន្តែ ធ្វើឡើង ក្នុង គោលបំណង រក្សា ផលប្រយោជន៍ រួម របស់ អង្គភាព រក្សា ថវិកា រដ្ឋ ឱ្យ បាន ល្អ និង ប្រើប្រាស់ ចំ គោលដៅ ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការងារ នៅ តាម បណ្តា សាលារៀន ក្នុង ខេត្ត ត្បូងឃ្មុំ ពិសេស នៅ កម្រិត មតេ្តយ្យ សិក្សា និង កំរិត បឋមសិក្សា »៕
កាលពី ថ្ងៃអាទិត្យ សប្តាហ៍ មុន មនុស្ស ចំនួន ១៩ នាក់ បាន ស្លាប់ បន្ទាប់ពី ខ្មាន់ កាំភ្លើង បាន វាយប្រហារ ពន្ធនាគារ ដែល មាន ចម្ងាយ ប៉ុន្មាន គីឡូម៉ែត្រ ពី ភាគ ខាងត្បូង នៃ ទីក្រុង អេល ប៉ាសូ (El Paso) រដ្ឋ តិចសាស់ របស់ អាមេរិក ដោយ បាន ផ្តាច់ ជីវិត ឆ្មាំ ពន្ធនាគា និង អ្នកទោស ក៏ ដូចជា បង្កឲ្យ អ្នកទោស ជាច្រើន ទៀត រត់គេចខ្លួន ក្នុង នោះ រួម មាន មេក្លោង ក្រុម ជួញដូរ គ្រឿងញៀន ដែល ត្រូវបាន គេ ស្គាល់ ថា ជា អេល ណេតូ (El Neto) ទៀតផង ។
គួរ បញ្ជាក់ ថា ឧប្បត្តិហេតុ ខាង លើ នេះ បាន បណ្តាលឲ្យ មាន អ្នកស្លាប់ ច្រើន បំផុត ដោយ ពី អំពើហិង្សា ក្នុង ពន្ធនាគារ នៅ ប្រទេស ម៉ិកស៊ិក នា រយៈពេល ប៉ុន្មាន ឆ្នាំ ថ្មី ៗ នេះ ៕
លិខិត មិត្ត អ្នកអាន៖ លោក បណ្ឌិត សុខ ហាច ផ្ញើ សារ ប្រដៅ បក្ស ភ្លើង ទៀន និង ក្រុម ប្រឆាំង ជ្រុលនិយម អំពី វប្បធម៌ ជេរ ប្រមាថ
ឥឡូវនេះ លោក បណ្ឌិត សុខ ហាច ដែល ទើប ទទួល ការតែងតាំង ជា ឧត្តម ទីប្រឹក្សា បក្ស ភ្លើង ទៀន ក៏ បាន មើលឃើញ សារជាតិ ឥត ប្រែប្រួល របស់ ក្រុម ប្រឆាំង ដែល កំពុង បន្ត ដឹកនាំ ក្នុង បក្ស ភ្លើង ទៀន ក៏ ដូចជា អ្នក នៅ ពីក្រោយ ខ្នង ។ លោក សុខ ហាច ក៏ បាន យក វេទិកា សម្ភាសន៍ ភ្ញៀវ ប្រចាំ ថ្ងៃ របស់ វិទ្យុ បារាំង អន្តរជាតិ ដើម្បី ផ្ញើ សារ ត្រង់ ៗ និង ជាសាធារណៈ តែម្តង ទៅកាន់ បក្ស ភ្លើង ទៀន ។
ទំនងជា លោក បណ្ឌិត សុខ ហាច ខ្លាច ប្រឡាក់ វប្បធម៌ ជេរ ប្រមាថ និង លាប ពណ៌ ដែល កំពុង រីក ដុះដាល យ៉ាង ជោគជាំ នៅក្នុង បក្ស នេះ ទើប ប្រញាប់ បញ្ចេញ សារ នេះ ទុក ជាមុន ។
ខុស ស្រឡះ ពី អ្វី ដែល ក្រុម ប្រឆាំង ជ្រុលនិយម តែង លើកឡើង ជារៀងរាល់ ថ្ងៃ ថា ជា សង្គម អយុត្តិធម៌ និង ពោរពេញ ដោយ ការរើសអើង ។ លោក សុខ ហាច ក៏ ទទួលស្គាល់ ថា សង្គម ខ្មែរ បច្ចុប្បន្ន កំពុង មាន សន្ទុះ អភិវឌ្ឍន៍ ទៅ មុខ ដែល ខុស ស្រឡះ ពី ការអះអាង របស់ ក្រុម ប្រឆាំង ជ្រុលនិយម រាប់ ទាំង បក្ស ភ្លើង ទៀន ផង ដែល អះអាង ថា គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ យូរ ទៅ ធ្វើឲ្យ ប្រទេស និង ប្រជាពលរដ្ឋ កាន់តែ ក្រទៅ ។ និយាយ រួម ក្រុម ប្រឆាំង មិន ដែល ហ៊ាន ទទួលស្គាល់ ការពិត ឡើយ ។
ជា លទ្ធផល នៃ ការសាប ព្រួស វប្បធម៌ ជេរ ប្រមាថ បរិហារ គេ គណបក្ស ប្រឆាំង គឺ ចាញ់ រលាយ ចំណែកឯ មេដឹកនាំ បក្ស នេះ ជាច្រើន មាន ទោស ជាប់ ខ្លួន រាប់ មិន អស់ ។ ប្រជាពលរដ្ឋ ខ្មែរ មិន គាំទ្រ ខណៈ ដែល វិធានការ ផ្លូវ ច្បាប់ ត្រូវបាន អនុវត្ត ចំពោះ អ្នក បំពាន ច្បាប់ ។ ការយក រឿង នយោបាយ បក បិទបាំង កាឡៃ ដើម្បី ការពារ អ្នកនយោបាយ ឬ សកម្មជន ដែល បំពាន ច្បាប់ ក៏ គ្មាន ប្រសិទ្ធភាព ទៀត ដែរ ។
សរុប សេចក្តី មក សារ ប៉ុន្មាន ឃ្លា ដែល លោក បណ្ឌិត សុខ ហាច បាន បង្ហាញ ពីត ជា មាន អត្ថន័យ ធំធេង ដែល លោក ចង់ ប្រដៅ បក្ស ភ្លើង ទៀន និង អ្នក នៅ ពីក្រោយ បក្ស នេះ ឲ្យ ភ្លឺ ភ្នែក និង បញ្ឈប់ សកម្មភាព ចាស់ ដ៏ អាក្រក់ តាម ទម្លាប់ ដែល ពួកគេ ធ្លាប់ ធ្វើជា បន្ទាន់ ប្រសិនបើ ពួកគេ ចង់ មាន តម្លៃ ក្នុង ក្រសែភ្នែក ពលរដ្ឋ ខ្មែរ ។
កន្លងទៅ គណបក្ស ប្រជាជន កម្ពុជា ដែល កំពុង ដឹកនាំ ប្រទេស និង ដែល មាន សម្តេច ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី តែង ប្រាថ្នា ចង់ ឃើញ បក្ស នយោបាយ ប្រកួត គ្នា ដោយ គោល នយោបាយ ប៉ុន្តែ បក្ស ប្រឆាំង មិន ព្រម កែ ចរិត យក ការជេរប្រមាថ និង បរិហារ លាប ពណ៌ មក ធ្វើជា ដើមទុន នយោបាយ នោះ ឡើយ ។ សង្ឃឹម ថា លោក បណ្ឌិត សុខ ហាច អាច ក្លាយជា ចំណែក មួយ ក្នុង ការកែប្រែ អត្តចរិត របស់ ក្រុម ប្រឆាំង ដើម្បីឲ្យ ងាក មក ដើរ លើ ផ្លូវ ត្រូវ វិញ ។
សម្រាប់ ក្រសួង អប់រំ ចំពោះ សិស្ស ប្រឡង ធ្លាក់ ក្រសួង ផ្តល់ ឱកាស ឱ្យ ប្រឡង ឆ្នាំ ក្រោយ ទៀត និង លើកទឹកចិត្ត ឱ្យ ខិតខំ រៀនសូត្រ បន្ត ដោយ មាន ការជួយគាំទ្រ ពីសំណាក់ លោកគ្រូ អ្នកគ្រូ មាតា បិតា អ្នកអាណាព្យាបាល និង សហគមន៍ ដើម្បី ទទួលបាន ជោគជ័យ នៅ ឆ្នាំ ខាងមុខ ។ សូម អ្នកសិក្សា គ្រប់ រូបចងចាំ ថា ការព្យាយាម គង់ បាន សម្រេច ដូច បំណង ៕ ព្រះមហាក្សត្រ ប្រោស ព្រះរាជ ទាន គ្រឿង ឥស្សរិយសសហមេត្រី ថ្នាក់ មហាសេនា ជូន ឯក អគ្គ រដ្ឋទូត អូស្រ្តាលី ប្រចាំ កម្ពុជា ចប់ អាណត្តិ
នា ឱកាស នោះ លោក ប្រធានាធិបតី ម៉ិក ស៉ិក គ្រោង ស្នើ ឱ្យ លោក បៃ ដិន ផ្លាស់ប្តូរ គោល នយោបាយ ជ្រៀត ជ្រែក និយម របស់ អាមេរិក ក្នុង កិច្ចការ របស់ បណ្តា ប្រទេស នានា នៅ ទូទាំង ទ្វីប អាមេរិក ខាងជើង និង ខាងត្បូង ដែល មាន គោលដៅ ព្យាយាម គ្រប់គ្រង អឌ្ឍគោល ខាងលិច របស់ ពិភពលោក ។
គួរ បញ្ជាក់ ថា គោល លទ្ធិ ម៉ុន រ៉ូ ត្រូវបាន បង្កើតឡើង កាលពី ដើម ទសវត្សរ៍ ឆ្នាំ ១៨០០ ដោយ អតីត ប្រធានាធិបតី អាមេរិក លោក ជែមស៍ ម៉ុន រ៉ូ។ គោល លទ្ធិ នោះ កំណត់ ថា សកម្មភាព ជ្រៀត ជ្រែក ណាមួយ ដោយ កម្លាំង ខាងក្រៅ នៅក្នុង នយោបាយ នៃ បណ្តា ប្រទេស នានា ក្នុង តំបន់ អាមេរិក គឺ សុទ្ធតែ អាច មាន លទ្ធភាព បង្ក ការគំរាមកំហែង ប្រឆាំង សហរដ្ឋ អាមេរិក ខណៈ គោល លទ្ធិ នេះ បាន ផ្តល់ ហេតុផល សម្រាប់ ឱ្យ ទីក្រុង វ៉ាស៉ីនតោន រក្សា ឥទ្ធិពល គ្រប់គ្រង របស់ ខ្លួន នៅ តំបន់ អាមេរិក ឡាទីន ៕
លោក ហ៊ុន ម៉ានី អញ្ជើញ បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ បេតុង ១ខ្សែ ប្រវែង ជាង ៤គីឡូម៉ែត្រ នៅ ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ លោក ហ៊ុន ម៉ានី តំណាងរាស្ត្រ មណ្ឌល កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតីភាព បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ បេតុង ១ ខ្សែ មាន ប្រវែង ៤. ២០០ម៉ែត្រ និង ទទឹង ៦ម៉ែត្រ ស្ថិត នៅ ឃុំ វល្លិ៍ ស និង ឃុំ ត្រពាំងគង ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ ដែល ចំណាយ ថវិកា ១៤.០០០.០០០.០០០ រៀល ។
នា ឱកាស នោះ លោក ហ៊ុន ម៉ានី បាន លើកឡើង ថា ការដឹកនាំ របស់ គណបក្ស ប្រជាជន រយះពេល ៤៤ ឆ្នាំ ដែល និង មកដល់ ថ្ងៃ៧ មករា ខាងមុខ នេះ សមិទ្ធផល នានា ទាំងអស់ ជា បទពិសោធន៍ ដែល ត្រូវ បងប្អូន ប្រជាពលរដ្ឋ ចងចាំ នៃ ភាពរីកចម្រើន កន្លង ហើយ គណបក្ស ប្រជាជន នៅតែ បន្ត ដឹកនាំ ស្រប តាម ឆន្ទៈ ប្រជាពលរដ្ឋ ខណៈ ប្រជាពលរដ្ឋ នៅតែ ជឿជាក់ លើ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន ជានិច្ច ជា ការពិត ណាស់ ការដឹកនាំ តែងតែ មាន ការខ្វះខាត តិចតួច តែ គណបក្ស ប្រជាជន បាន ធ្វើ កំណែទម្រង់ ជាប្រចាំ ។
បើ តាម លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ឱ្យដឹង ថា ផ្លូវ បេតុង មួយ ខ្សែ នេះ ឆ្លងកាត់ ចំនួន ៦ភូមិ ( ភូមិ បាក់ ចញ្ចៀន ភូមិ ត្រ គៀត ភូមិ ថ្ម បាំង ឃុំ វល្លិ៍ ស និង ភូមិ កាំបិត ភូមិ គោក ព្នៅ ភូមិ ដក់ពរ ឃុំត្រពាំង គង ដែល មាន ប្រជាពលរដ្ឋ រស់ នៅ និង ទទួល ផល ចំនួន ៦៨៦ គ្រួសារ ស្មើនឹង ៣. ៣២០ នាក់ ហើយ មាន សាលារៀន ចំនួន ៤កន្លែង សាលា បឋមសិក្សា ទួលស្វាយ រ័ត្ន សាលា បឋមសិក្សា សំរោងទង . អនុវិទ្យាល័យ សំរោងទង និង អនុវិទ្យាល័យ ទន្លេ កន្ទិល និង វត្ត សំរោទង ផងដែរ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ការស្ថាបនា ផ្លូវ បេតុង នេះ គឺ ដើម្បី សម្រួល ដល់ ចរាចរណ៍ របស់ ប្រជាពលរដ្ឋ ដែល នៅ មូលដ្ឋាន ផ្ទាល់ ពិសេស សម្រួល ដល់ ការដឹកជញ្ជូន ផ្សេង ៗ និង ការធ្វើដំណើរ ទៅ មក របស់ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ មាន ភាពប្រសើរឡើង ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា តាមរយៈ សមិទ្ធផល ដែល ទទួលបាន ខាងលើ នេះ យើង ទាំងអស់ គ្នា មិន អាច បំភ្លេច នូវ តម្លៃ នៃ សន្តិភាព ហើយ សន្តិភាព មិន អាច កាត់ថ្លៃ បាន ឡើយ « អរគុណ សន្តិភាព » មាន សន្តិភាព មាន ការអភិវឌ្ឍ មាន ការអភិវឌ្ឍ ទើប ធ្វើឱ្យ ប្រទេសជាតិ មាន ការរីកចម្រើន ដូច សព្វ ថ្ងៃ ។ ដូចនេះ យើង ទាំងអស់ គ្នា ត្រូវតែ ចូលរួម ថែរក្សា ការពារ តម្លៃ នៃ សន្តិភាព នេះ ឱ្យ នៅ គង់វង្សត ជំនាន់ ៕
មូលនិធិ ឧកញ៉ា បណ្ឌិត ជា រតនា និង ឧកញ៉ា លី ហៀក រតនា ថ្លែងអំណរគុណ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ និង លោកជំទាវ នាំយក បច្ច័យ ជាង ៣ម៉ឺន ដុល្លារ និង ៣៣ លាន រៀល ពី បុណ្យ ខួប គម្រប់ ៣ឆ្នាំ របស់ ម្ដាយ ជួយ ដល់ ជន កំបុត ដៃ ទាំង ពីរ
ថវិកា នេះ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ និង លោកជំទាវ ខៀវ ព្រមទាំង បុត្រា បុត្រី និង ចៅ ៗ បាន ធ្វើ ការប្រគល់ជូន ដោយ ផ្ទាល់ ដល់ លោក ឧកញ៉ា បណ្ឌិត ជា រតនា និង ឧកញ៉ា លី ហៀក រតនា បន្ទាប់ពី រៀបចំ ពិធី បុណ្យ បាន ចប់ សព្វគ្រប់ នៅ ថ្ងៃទី ៤ ខែមករា ឆ្នាំ ២០២៣ ។
ទឹកចិត្ដ ដ៏ សប្បុរសធម៌ ខាងលើ នេះ បាន សរបញ្ជាក់ ឱ្យ ឃើញ ថា វប្បធម៌ នៃ ការចែករំលែក និង ជួយ ចុះ សម្រាល ទុក្ខលំបាក របស់ បងប្អូន ប្រជាពលរដ្ឋ យើង មាន ការរីកលូតលាស់ គួរឱ្យ កក់ សម្គាល់ ដែល ដើរ តាម មាគ៌ា ដ៏ ត្រឹមត្រូវ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ដ៏ រឹង មាន ឈ្លាសវៃ . សម្ដេច តែងតែ ធ្វើ ការណែនាំ ចេះ ជួយ ចែករំលែក គ្នា ទៅ វិញ ទៅ មក នៅក្នុង សង្គម ។
( កំពង់ធំ )៖ លោក ងួន រតនៈ ប្រធាន គណបក្ស ខេត្ត កំពង់ធំ នា ព្រឹក ថ្ងៃទី ៤ ខែមករា ឆ្នាំ ២០២៣ បាន ប្រកាស សម្រួល ភារកិច្ច និង តែងតាំង លោក ពេញ កែម ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្រុង ស្ទឹង សែន និង បាន ផ្ដាំផ្ញើ ឱ្យ មន្ត្រី គណបក្ស មូលដ្ឋាន បង្កើន ចំណង ទំនាក់ទំនង ជិតស្និទ្ធ រវាង គណបក្ស និង ប្រជាជន គ្រប់ ស្រទាប់ និង គ្រប់ មជ្ឈដ្ឋាន ។
នា ឱកាស នោះ ដែរ លោក ងួន រតនៈ បាន ផ្ដាំផ្ញើ ថា ក្នុង នាម ជា អ្នកដឹកនាំ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្រុង ស្ទឹង សែន ត្រូវ ចេះ សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ជាមួយ សមាជិក - សមាជិកា គណបក្ស ត្រូវ ធ្វើជា ស្នូល កំពុង ឈរ លើ មាគ៌ាភាពយុត្តិធម៌ ត្រឹមត្រូវ និង តម្លាភាព ។ ពង្រឹង បន្ថែម ពី សមត្ថភាព របស់ ខ្លួន និង យកចិត្តទុកដាក់ បម្រើការងារ គណបក្ស ក្នុង នាម ជា ថ្នាក់ដឹកនាំ មាន ក្រមសីលធម៌ មាន ភាពស្មោះត្រង់ ជាមួយ សមាជិក - សមាជិកា ដើម្បី រៀបចំ ផែនការប្រចាំ ខែ ប្រចាំ ឆ្នាំ ឱ្យ មាន ការរីកចម្រើន ។
លោក ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ បាន សង្កត់ធ្ងន់ ថា « ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្រុង ស្ទឹង សែន ត្រូវ បង្កើន ចំណង ទំនាក់ទំនង ជិតស្និទ្ធ រវាង គណបក្ស និង ប្រជាជន គ្រប់ ស្រទាប់ និង គ្រប់ មជ្ឈដ្ឋាន ដើម្បី រក្សា និង ពង្រីក រប្រៀប ឈ្នះ របស់ គណបក្ស លើ ការងារ អប់រំនយោបាយ សតិអារម្មណ៍ ខិតខំ កាត់បន្ថយ និង ឈាន ទៅ លុបបំបាត់ ការ ថ្នាំង ថ្នាក់ បាតុភាព អសកម្ម នានា បង្ក ជំនឿ ជឿជាក់ របស់ ប្រជាជន មក លើ ថ្នាក់ដឹកនាំ របស់ គណបក្ស ព្រមទាំង ចិញ្ចឹម ចលនា នៅ មូលដ្ឋាន និង ធ្វើ អំពើ ល្អ » ។
លោក ងួន រតនៈ បាន ផ្ដាំផ្ញើ ដល់ ប្រធាន គណបក្ស និង សមាជិក - សមាជិកា បក្ស ទាំងអស់ ត្រូវ ខិតខំ ធ្វើ ការដោះស្រាយ បញ្ហា ប្រឈម កង្វល់ សំណើ សំណូមពរ សេចក្តីត្រូវការ របស់ ប្រជាជន ដើម្បី ឆ្លើយតប ឱ្យ មាន ប្រសិទ្ធភាព តម្លាភាព និង គណនេយ្យភាព នៅក្នុង ការបម្រើ សេវា រដ្ឋបាល សេវា សាធារណៈ ជូន ប្រជាជន កម្ពុជា ។
លោក ពេញ កែម ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្រុង ស្ទឹង សែន បាន ឡើង ប្ដេជ្ញាចិត្ត ដែល មាន ខ្លឹមសារ សំខាន់ ៗ បំផុត គឺ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម លក្ខន្តិកៈ បទបញ្ជា ផ្ទៃក្នុង គណបក្ស គោលការណ៍ សេចក្តីសម្រេច មាគ៌ា និង កម្មវិធី បយោបាយ គណបក្ស សំដៅ ពង្រឹង ធ្លុង សាមគ្គី ឯកភាព ផ្ទៃក្នុង គណបក្ស មាន ភាពរឹងមាំ ទាំង ខាង នយោបាយ សតិអារម្មណ៍ និង ការចាត់តាំង ។
កសិករ ដាំ បន្លែ សរីរាង្គ នៅ ខេត្ត សៀមរាប អំពាវនាវ ពលរដ្ឋ គាំទ្រ កសិផល ក្នុង ស្រុក ដើម្បី លើកស្ទួយ វិស័យ កសិកម្ម នៅ កម្ពុជា និង កាត់បន្ថយ ការនាំចូល ពី ប្រទេស ជិតខាង
( សៀមរាប ) ៖ លោក ឡា សារ៉ន ដែល ជា កសិករ ដាំ បន្លែ សរីរាង្គ ជា លក្ខណៈ គ្រួសារ ក្នុង ភូមិ គោក ដូង សង្កាត់ ក្របី រៀល ក្រុង សៀមរាប ខេត្ត សៀមរាប បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ជួយ គាំទ្រ កសិផល របស់ ខ្មែរ ដើម្បី លើកស្ទួយ វិស័យ កសិកម្ម នៅ កម្ពុជា និង កាត់បន្ថយ ការនាំចូល ពី ប្រទេស ជិតខាង ផងដែរ ។
គួរ រម្លឹក ផងដែរ លោក ឡា សារ៉ន កាលពី លោក មិន ទាន់ រៀបការ គឺ លោក ប្រកបរបរ ជា កម្មករ សំណង់ អស់ រយៈ ជាង ៦ ឆ្នាំ ហើយក៏ មិន បាន សល់ អ្វី ជា ធំដុំ នោះ ដែរ ។ បន្ទាប់ពី រៀបការ រួច ភរិយា របស់ លោក មិន ឱ្យ ទៅ ធ្វើការ ជា កម្មករ សំណង់ ទៀត ឡើយ ដោយ គិតគូរ ពី សុវត្ថភាព និង យល់ ថា ការងារ សំណង់ មាន ការហត់ នឿយ ខ្លាំង ផង ទើប ឱ្យ លោក ប្រកបរបរ ផ្សេង វិញ ដូច្នេះហើយ ទើប សម្រេចចិត្ត ប្រកបរបរ ដាំ បន្លែ តាំងពី ពេល នោះ មក រហូតដល់ សព្វ ថ្ងៃ ។
លោក ឡា សារ៉ន បាន បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ លោក មាន ការសប្បាយ ចិត្ត ជាខ្លាំង នឹង ការងារ ដាំ បន្លែ នេះ ទោះបី ក្នុង អំឡុង ពេល វិបត្តិ ជំងឺ កូវីដ១៩ ក៏ដោយ ក៏ មិន បាន ខកខាន ក្នុង ការដាំ បន្លែ នោះ ដែរ ដោយ មាន ម៉ូយ មក ទិញ ដល់ ផ្ទះ ដើម្បី យក ទៅ លក់ បន្ត នៅ តាម ផ្សារ ឬ ក៏ កន្លែង ផ្សេង ៗ ទៀត ជារៀងរាល់ ថ្ងៃ ផងដែរ ។ ចំពោះ បន្លែ សរីរាង្គ ដែល លោក ដាំ រួម មាន៖ ខាត់ ណា សាឡាត់ ស្រួយ ត្រឡាច ត្រសក់ ន នោង ម្ទេស ហាវៃ ជី គ្រប់ មុខ ពោត បារាំង ត្រកួន និង ប៉េងបោះ ផងដែរ ។
ដោយឡែក ចំពោះ ជី ដែល យកមក ប្រើប្រាស់ ក្នុង ការដាំ បន្លែ សរីរាង្គ នេះ ទៀត គឺ លោក បាន ទិញ អាចម៍ គោ និង អាចម៍ ទា ឬ ក៏ មាន់ ពី ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ដោយ ក្នុង មួយ ការ៉ុង ៥ ពាន់ រៀល ហើយ ក្នុង មួយ រោង លោក ដាក់ ៥ការ៉ុង ហើយក៏ មិន បាញ់ ថ្នាំ គីមី ដើម្បីឱ្យ ឆាប់ បាន ប្រមូល ទិន្នផល នោះ ដែរ ដូច្នេះ ហើយ ទើប ធ្វើឱ្យ ដំណាំ របស់ លោក ទទួលបាន ទិន្នផល ល្អ និង មាន អតិថិជន មក ទិញ ជា ហូរហែ ផងដែរ ។
ជាមួយ នេះ ដែរ លោក ឡា សារ៉ន ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ ប្រសិនបើ មាន ដី សូម កុំ ទុក ដី នោះ ចោល ដោយ ងាក មក ដាំ បន្លែ ឬ ក៏ ប្រកបរបរ កសិកម្ម ផ្សេង ៗ គ្រាន់ បាន ចំណូល សម្រាប់ ផ្គ់ ផ្គង់ ជីវភាព នៅក្នុង គ្រួសារ និង ជៀសវាង ការទៅ ចំណាកស្រុក ខុស ច្បាប់ ផងដែរ ៕
ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នឹង រៀបចំ ការប្រកួត « ល្បែង ប្រពៃណី វាយប្រដំ» ក្នុង ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ៨ ខែមករា ខាងមុខ នេះ
( ភ្នំពេញ ) ៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង នឹង រៀបចំ ការប្រកួត « ល្បែង ប្រពៃណី វាយប្រដំ» រៀបចំឡើង នៅ ថ្ងៃទី ៨ ខែមករា ឆ្នាំ ២០២៣ ក្នុង ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង ។
បើ តាម ACU គិត ត្រឹម ថ្ងៃអង្គារ ទី ០៣ ខែមករា ឆ្នាំ ២០២៣ នាយកដ្ឋាន ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល បាន ទទួល ឯកសារ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល សរុប ចំនួន ១៣. ២៥៨ ច្បាប់ ។
វិមាន ក្រឹមឡាំង មិន បាន ឆ្លើយតប ភ្លាម ៗ ចំពោះ សំណើ សុំ ការអត្ថាធិប្បាយ លើ ការអំពាវនាវ ពី ក្រុម ស្ត្រី មេម៉ាយ ឡើយ ។ លោក ពូទីន បាន និយាយ កាលពី ខែ មុន ថា មិន ចាំបាច់ មាន ការកែន ទ័ព បន្ថែម នោះ ទេ ។
គួរ បញ្ជាក់ ថា ក្រោយពី លោក ពូទីន បាន ចេញ បញ្ជាឲ្យុ មាន កែន ទ័ព ចំនួន ៣០០.០០០ នាក់ កាលពី ខែកញ្ញា ឆ្នាំ ២០២២ បុរស រុស្ស៊ី រាប់ សែន នាក់ ទៀត បាន ភៀសខ្លួន ទៅ ក្រៅ ប្រទេស ដើម្បី ចៀសវាង ការចូលរួម ធ្វើ សង្រ្គាម ៕
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង មុខ តំណែង អនុ រដ្ឋលេខាធិការ និង ទីប្រឹក្សា ក្រសួង មហាផ្ទៃ ជូន អតីត ថ្នាក់ដឹកនាំ នគរបាល ចំនួន ៥រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង មុខ តំណែង និង ផ្ដល់ ឋានៈ ជា អនុ រដ្ឋលេខាធិការ និង ទីប្រឹក្សា ក្រសួង មហាផ្ទៃ ជូន អតីត ថ្នាក់ដឹកនាំ នគរបាល ចំនួន ៥រូប ។
* អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ចំនួន ៣រូប គឺ លោក ហ៊ូ សាគុណ . លោកស្រី យក់ សុខា និង លោក អ៉ិន បូរ៉ា * ទីប្រឹក្សា ក្រសួង មហាផ្ទៃ ឋានៈ ស្មើ អនុ រដ្ឋលេខាធិការ ចំនួន ២រូប គឺ លោក ចាន់ ស៉ី ថា និង លោក យិន ចំណាន ។
គ.ជ. ប នឹង រៀបចំ កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ពី ការបិទ ផ្សាយ បញ្ជី បោះឆ្នោត ដំបូង . បញ្ជី ឈ្មោះ អ្នកបោះឆ្នោត ដែល នឹង ត្រូវ លុប ចេញ ពី បញ្ជី បោះឆ្នោត នៅ ឃុំ សង្កាត់ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១២ ខែមករា ខាងមុខ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គជប) នឹង រៀបចំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្តីពី ការបិទ ផ្សាយ បញ្ជី បោះឆ្នោត ដំបូង និង បញ្ជី ឈ្មោះ អ្នកបោះឆ្នោត ដែល នឹង ត្រូវ លុប ចេញ ពី បញ្ជី បោះឆ្នោត នៅ ឃុំ សង្កាត់ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
* ការបិទ ផ្សាយ បញ្ជី បោះឆ្នោត ដំបូង និង បញ្ជី ឈ្មោះ អ្នកបោះឆ្នោត ដែល នឹង ត្រូវ លុប ចេញ ពី បញ្ជី បោះឆ្នោត នៅ ឃុំ សង្កាត់ ទូទាំង ប្រទេស * ការដាក់ ការទទួល និង ការដោះស្រាយ ពាក្យបណ្ដឹង តវ៉ា ឬ / និង ពាក្យបណ្ដឹង ជំទាស់ ទាក់ទង នឹង បញ្ជី បោះឆ្នោត ដំបូង * ការអញ្ជើញ ប្រជាពលរដ្ឋ ឱ្យ ទៅ មើល ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ដំបូង អ្នកបោះឆ្នោត ដែល នឹង ត្រូវ លុប ចេញ ពី បញ្ជី បោះឆ្នោត ។
គម្រោង ធានា ឥណទាន ដើម្បី ស្តារ អាជីវកម្ម ជា គម្រោង ធានា ឥណទាន ដែល មាន គោលដៅ គាំទ្រ អាជីវកម្ម ទាំង អាជីវកម្ម ខ្នាត មីក្រូ សហគ្រាស ខ្នាត តូច និង មធ្យម និង សហគ្រាស ខ្នាត ធំ ក្នុង ការបង្កើន លទ្ធភាព ទទួលបាន ហិរញ្ញប្បទាន ពី គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ចូលរួម (PFIs) សម្រាប់ ធ្វើជា ទុន បង្វិល . ការវិនិយោគ . និង ការពង្រីក អាជីវកម្ម ។
គម្រោង ធានា ឥណទាន ដើម្បី ស្តារ អាជីវកម្ម មាន ទំហំ ទឹកប្រាក់ ២០០ លាន ដុល្លារ ត្រូវបាន ដាក់ ឱ្យ ដំណើរការ ជា លើក ដំបូង ចាប់ពី ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ ។ គិត ត្រឹម ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២២ កន្លងទៅ កម្ចី ទំហំ ប្រមាណ ៨៩ លាន ដុល្លារ ដែល ភាគ ច្រើន ជា កម្ចី ដែល ខ្វះ ទ្រព្យ ធានា ត្រូវបាន ធានា ដោយ CGCC ក្រោម គម្រោង គម្រោង ធានា ឥណទាន ដើម្បី ស្តារ អាជីវកម្ម ។
សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ថា «CGCC បាន ទទួល ការឯកភាព ដ៏ ខ្ពង់ខ្ពស់ បំផុត ពី ឯកឧត្តម អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដើម្បី បន្ត ដាក់ ឱ្យ ដំណើរការ គម្រោង BRGS នេះ ដោយ កែសម្រួល លក្ខខណ្ឌ មួយ ចំនួន ឱ្យ មាន ភាពប្រសើរឡើង ដូចជា សុពលភាព នៃ គម្រោង . ការកំណត់ និយមន័យ នៃ អាជីវកម្ម ខ្នាត មីក្រូ សហគ្រាស ខ្នាត តូច និង មធ្យម និង សហគ្រាស ខ្នាត ធំ . និង ការកំណត់ ទំហំ ជា អតិបរមា សម្រាប់ កម្ចី នីមួយ ៗ » ។
អាជ្ញាធរ ខណ្ឌ ដូនពេញ បន្ត យុទ្ធនាការ ក្តៅ ចុះ រៀបចំ សណ្តាប់ធ្នាប់ និង សម្អាត បរិស្ថាន នៅ ជុំវិញ ចំណត ឡាន ផ្សារ ធំ ថ្មី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២៣ នេះ កម្លាំង គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ ដូនពេញ ដឹកនាំ ដោយ លោក ចាប ឌីណា អភិបាល រង ខណ្ឌ បាន បន្ត ដឹកនាំ កម្លាំង ចុះ រៀបចំ សណ្តាប់ តាម បណ្តោយ ផ្លូវ សំខាន់ ៗ និង បាន ធ្វើការបាញ់ លាង សម្អាត នៅ ជុំវិញ បរិវេណ ចំណត ផ្សារ ធំ ថ្មី ក្រោយពី មាន ពាក្យបណ្តឹង និង ការរអ៊ូរទាំ របស់ ប្រជាពលរដ្ឋ ជុំ បញ្ហា អនាម័យ ។
ការចុះ រៀបចំ សណ្តាប់ធ្នាប់ និង សម្អាត បរិស្ថាន នៅ ជុំវិញ បរិវេណ ចំណត ផ្សារ ធំ ថ្មី នេះ គឺ ធ្វើឡើង តាម ការបញ្ជា របស់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង មាន ការចង្អុលបង្ហាញ ពី លោក ជា ខេមា អភិបាល ខណ្ឌ ដូនពេញ ។
លោក ចាប់ ឌីណា បាន បញ្ជាក់ ថា សម្រាប់ យុទ្ធនាការ ក្តៅ ក្នុង ការរៀបចំ សណ្តាប់ធ្នាប់ និង សម្អាត បរិស្ថាន នេះ គឺ កម្លាំង កង ឯកភាព ខណ្ឌ នឹង ធ្វើ យ៉ាង ឱ្យ បរិវេណ ជុំវិញ ចំណត ផ្សារ ធំ ថ្មី នេះ មាន សណ្តាប់ធ្នាប់ សោភ័ណភាព និង មាន បរិស្ថាន ល្អ ដោយ មិន ឱ្យ មាន ធំ ក្លិន ឆ្អេះ ឆ្អាប បង្កឱ្យ ប៉ះពាល់ ប្រជាពលរដ្ឋ រស់ នៅ ជុំវិញ បរិវេណ ចំណត ផ្សារ ធំ ថ្មី និង ប្រជាពលរដ្ឋ ធ្វើដំណើរ បន្ត ទៀត ។
