( ភ្នំពេញ ) ៖ តម្លៃ ដឹកជញ្ជូន តាម ផ្លូវ ទឹក និង តាម ផ្លូវគោក ពី កម្ពុជា ទៅ ចិន បាន ធ្លាក់ចុះ មក ធម្មតា វិញ ហើយ បន្ទាប់ កើនឡើង ខ្ពស់ ក្រោយពេល ចិន អនុវត្ត វិធានការសូន្យ កូវីដ និង អំឡុង ពេល កើនឡើង ប្រេងឥន្ធនៈ កាលពី ឆ្នាំ មុន ដែល ធ្វើ ដែល ធ្វើឱ្យ ការនាំចេញ របស់ កម្ពុជា ទៅ ប្រទេស នេះ ជួប ឧសបគ្គ ។
អ្នកជំនាញ ក្នុង វិស័យ ដឹកជញ្ជូន និង នាំចេញ កសិផល យល់ ការធ្លាក់ចុះ នៃ តម្លៃ ដឹកជញ្ជូន និង ការប្រកាស បន្ធូរបន្ថយ វិធានការ កូវី ដ១៩ របស់ ប្រទេស ចិន គឺជា ឱកាស ដែល កម្ពុជា បង្កើន ការនាំចេញ ទំនិញ ឡើងវិញ ជាពិសេស កសិផល ។
លោក ជា ចាន់ ដារ៉ា ប្រធាន សមាគម ពាណិជ្ជករ ដឹកជញ្ជូន និង ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ បាន ឱ្យ បណ្តាញ ព័ត៌មាន Fresh News ដឹង ថា បច្ចុប្បន្ន តម្លៃ ដឹកជញ្ជូន តាម ផ្លូវ ទឹក ពី កំពង់ផែ ក្រុង ព្រះសីហនុ និង កំពង់ផែ រាជធានី ភ្នំពេញ ទៅ ប្រទេស ចិន បាន ធ្លាក់ មក តម្លៃ ជាង ២០០ ដុល្លារ ទៅ ៤០០ ដុល្លារ វិញ ខណៈ កាលពី មុន តម្លៃ ដឹកជញ្ជូន បាន ហក់ ឡើង ប្រមាណ ៦០០ ដុល្លារ ទៅ ៨០០ ដុល្លារ ក្នុង មួយ ទូកុងតឺន័រ ។
លោក បន្ថែម ការបើកប្រទេស ឡើងវិញ របស់ ចិន នឹង ជួយ ជំរុញ សកម្មភាព វិស័យ ដឹកជញ្ជូន របស់ កម្ពុជា ឱ្យ មមាញឹក ឡើងវិញ តាមរយៈ ការដឹកជញ្ជូន នាំចេញ និង នាំចូល នូវ ទំនិញ ផ្សេង ៗ ។
លោក បន្ត ទៀត ថា « ខ្ញុំ កត់សម្គាល់ មួយ ទៀត អ្នក វិនិយោគ ចិន បាន ទិញ នូវ ផលិតផល កសិកម្ម របស់ កម្ពុជា ដូចនេះ ខ្ញុំ គិត ថា ការនាំចេញ ផលិតផល កសិកម្ម របស់ កម្ពុជា នឹង កើនឡើង បន្ទាប់ពី មាន ការបើកប្រទេស ចិន ឡើងវិញ » ។
លោក ថា មិន មែន ការដឹកជញ្ជូន ទៅ ចិន ទេ ដែល ធ្លាក់ចុះ តម្លៃ ដឹកជញ្ជូន ពី កម្ពុជា ទៅ សហរដ្ឋ អាមេរិក និង អឺរ៉ុប ដែល កន្លងមក កើនឡើង ដល់ ពី ជាង ១ម៉ឺន ដុល្លារ ទៅ ២ម៉ឺន ដុល្លារ នោះ បាន ធ្លាក់ចុះ មក ចន្លោះ ជាង ១ពាន់ ដុល្លារ ទៅ ២ពាន់ ដុល្លារ ក្នុង មួយ ទូកុងតឺន័រ នា ពេល បច្ចុប្បន្ន នេះ ។
លោក បន្ត ថា « ខ្ញុំ មាន ក្តី រំពឹង ខ្ពស់ សម្រាប់ ការនាំចេញ ផលិតផល កសិកម្ម របស់ ប្រទេស កម្ពុជា យើង ផងដែរ ជាពិសេស មុន ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន នៅ ទីផ្សារ ប្រទេស ចិន មាន តម្រូវការ ខ្ពស់ ទៅ លើ ផលិតផល កសិកម្ម តែ ម្តង ដូចជា មៀន ចេក លឿង ផ្លែ ធុរេន ជាដើម » ។
លោក បណ្ឌិត សឹង សំណាង និង ប្រជាពលរដ្ឋ ស្រុក កំពង់លែង រួមគ្នា ប្រារព្ធ ពិធី អបអរសាទរ ខួប ៤៤ ឆ្នាំ នៃ ថ្ងៃ ជ័យជម្នះ « ៧មករា »
( កំពង់ឆ្នាំង ) ៖ នាយ ឧត្តមសេនីយ៍ សឹង សំណាង អគ្គ មេបញ្ជាការ រង មេបញ្ជាការ កងទ័ព ជើងអាកាស និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ស្រុក កំពង់លែង និង ភរិយា រួម ជាមួយ ក្រុមការងារ និង ប្រជាពលរដ្ឋ ក្នុង ស្រុក កំពង់លែង បាន រួមគ្នា ប្រារព្ធ ពិធី អបអរសាទរ ខួប ៤៤ ឆ្នាំ នៃ ថ្ងៃ ជ័យជម្នះ « ៧មករា » ( ៧ មករា ១៩៧៩ - ៧ មករា ២០២៣ ) ប្រកបដោយ ដោយ ភាពរីករាយ ក្រៃលែង ។
ក្នុង ពិធី នោះ លោក យ៉ែម លក្ខិណា អភិបាល ស្រុក កំពង់លែង បាន អាន សុន្ទរកថា ទាំងស្រុង របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ជូន អង្គ ពិធី ឱ្យ បាន យល់ ពី អត្ថន័យ និង យល់ ជ្រូត ជ្រាប គោល នយោបាយ និង ការប្តេជ្ញាចិត្ត របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី និង ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្នុង កិច្ច ដឹកនាំ កសាង និង អភិវឌ្ឍន៍ ជាតិ ។
នាយ ឧត្តមសេនីយ៍ សឹង សំណាង បាន គូស រំលេច អំពី សាវតារ មួយចំនួន ពាក់ព័ន្ធ នឹង ទុក្ខវេទនា ក៏ ដូចជា ការឈឺចាប់ ខ្លោចផ្សា របស់ ប្រជាពលរដ្ឋ ខ្មែរ នៅក្នុង របប កម្ពុជា ប្រជាធិបតេយ្យ ។ នាយ ឧត្តមសេនីយ៍ ក៏ បាន លើក បង្ហាញ ពី ប្រវត្តិ នៃ ការតស៊ូ របស់ អ្នកស្នេហា ជាតិ ក្រោម ការដឹកនាំ របស់ រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា រហូត រំដោះ ប្រទេស និង ប្រជាជន ដោយ ជោគជ័យ ពី របប ខ្មែរ ក្រហម នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។
« ចូរ យើង ចាំ ទុក ថា កាលពី ៤៤ ឆ្នាំ មុន របប ខ្មែរ ក្រហម ដ៏ ឃោរឃៅ បាន កាប់ សម្លាប់ ប្រជាជន ស្លូតត្រង់ ស្លាប់ និង រង ទុក្ខវេទនា ដូច សត្វ ធាតុ ។ ដោយសារ ទុក្ខវេទនា ទាំង នេះ ហើយ ទើប រណសិរ្ស សង្គ្រោះ ជាតិ កម្ពុជា បាន ងើប ឡើង ដឹកនាំ ចលនា តស៊ូ ផ្តួលរំលំ របប វាល ពិឃាដ រហូត បង្កើត បាន តុលាការ កាត់ទោស ថ្នាក់ដឹកនាំ របប កម្ពុជា ប្រជាធិបតេយ្យ » ។ នេះ ជា ការលើកឡើង របស់ នាយ ឧត្តមសេនីយ៍ សឹង សំណាង ។
នាយ ឧត្តមសេនីយ៍ សឹង សំណាង បន្ត ថា « នេះ ជា ជិវិត ទី២ នៃ ការរស់រាន ឡើងវិញ នៃ ជាតិ កម្ពុជា ជាពិសេស សភាព ការបច្ចុប្បន្ន សម្តេច តេជោ ហ៊ុន សែន បាន ជួយ ស្រោចស្រង់ ជិវិត ប្រជាជន យើង ជាថ្មី ម្តង ទៀត ឱ្យ រួចផុត ពី ជំងឺ ឆ្លង ដ៏ សាហាវ កូវីដ១៩ ដែល យើង អាច កំណត់ ថា ជា ជិវិត ទី៣ បន្ទាប់ពី ថ្ងៃ ជ័យជម្នះ ៧មករា » ។
លោក សឹង សំណាង បាន សង្កត់ធ្ងន់ ថា តាមរយៈ ស្នាដៃ និង សមិទ្ធផល ទាំងអស់ នេះ ប្រជាពលរដ្ឋ ត្រូវ ជឿជាក់ លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា របស់ សម្តេច តេជោ ហើយ ត្រូវ កម្ចាត់ ចោល រាល់ ការភូតកុហក ញុះញង់ របស់ ក្រុម ពួក អគតិឲ ។
នាយ ឧត្តមសេនីយ៍ សឹង សំណាង បាន ក្រើន រំលឹក ឱ្យ ប្រជាពលរដ្ឋ បន្ត ការចាក់ វ៉ាក់សាំង ដើម្បី ភាពសុាំ ជាមួយ មេរោគ កូវីដ១៩ ។ ម្យ៉ាងទៀត ប្រជាពលរដ្ឋ ត្រូវ អនុវត្ត តាម គោលការណ៍ រាជ រដ្ឋាភិបាល ទៅ ចាក់ វ៉ាក់សាំង ដូស ជំរុញ ឲ្យបាន គ្រប់ ៗ គ្នា ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ សឹង សំណាង បាន ថ្លែង សរសើរ ចំពោះ សិស្ស ប្រឡង ជាប់ សញ្ញាប័ត្រ ទុតិយភូមិ ចំនួន ១៧១ នាក់ ក្នុង នោះ សិស្ស ចំនួន ២នាក់ ទទួលបាន និទ្ទេស A ។ លោក បាន លើកទឹកចិត្ត ឱ្យ សិស្ស បន្ត ខិតខំ រៀនសូត្រ ឱ្យ បាន ខ្ជាប់ខ្ជួន ក្នុង ឱកាស ប្រទេស មាន សុខ សន្តិភាព ។
នៅ ព្រឹក ថ្ងៃចន្ទ ទី០៩ ខែមករា ឆ្នាំ ២០២៣ ស្អែក នេះ ដំណើរការអភិវឌ្ឍន៍ លើ ហេដ្ឋារចនាសម្ព័ន្ធ ចាប់ផ្តើម ទៀត ហើយ សម្រាប់ កិច្ច ស្វាគមន៍ ដើម ឆ្នាំ ២០២៣ ។ ការដ្ឋាន ពង្រីក និង លើកកម្ពស់ កម្រិត គុណភាព ផ្លូវ ជាតិ លេខ ៧ ចាប់ពី រង្វល់ មូល ស្គន់ ទី រួម ស្រុក ជើង ព្រៃ រហូតដល់ ទី រួម ខេត្ត កំពង់ចាម នឹង ចាប់ផ្តើម ដំណើរការ ។ ពិធី នេះ នឹង ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក វ៉ាង វិន ធៀន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ នៅ កម្ពុជា ។
ជាង នេះ ទៀត កំណាត់ ផ្លូវ ជាតិ នេះ នឹង សម្រួល ការតភ្ជាប់ ការដឹកជញ្ជូន ទំនិញ និង ផលិតផល របស់ ខេត្ត កំពង់ចាម និង ខេត្ត ជាប់ ព្រំប្រទល់ ទៅ កាន់ កំពង់ផែ ទន្លេ បិទ ដែល កំពុង សាងសង់ ដើម្បី នាំចេញ ទៅកាន់ ទីផ្សារ ក្នុង ស្រុក និង អន្តរជាតិ តាមរយៈ ការដឹកជញ្ជូន តាម ផ្លូវ ទឹក ៕ រុស្ស៉ី បញ្ចប់ បទ ឈប់ បាញ់ ឯកតោ ភាគី ជាមួយ ការសន្យា ប្រយុទ្ធ រហូតដល់ ឈ្នះ នៅ អ៊ុយក្រែន
( កៀវ ) ៖ ក្រុម មន្ត្រី អ៊ុយក្រែន បាន ឱ្យដឹង ថា ការវាយប្រហារ របស់ រុស្ស៉ី កាលពី ពាក់កណ្ដាល យប់ ថ្ងៃសៅរ៍ ឈានចូល ថ្ងៃអាទិត្យ នេះ បាន សម្លាប់ មនុស្ស ម្នាក់ បន្ទាប់ពី ទីក្រុង មូស្គូ បិទ បញ្ចប់ បទ ឈប់ បាញ់ បុណ្យ ណូអែល ឯកតោ ភាគី របស់ ខ្លួន ជាមួយ ការសន្យា ថា នឹង ប្រយុទ្ធ រហូត ទទួលបាន ជ័យជម្នះ នៅក្នុង សង្រ្គាម អ៊ុយក្រែន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃអាទិត្យ ទី៨ ខែមករា ឆ្នាំ ២០២៣ ។
គួរ បញ្ជាក់ ថា ប្រធានាធិបតី រុស្ស៉ី លោក ពូទីន បាន បញ្ជា ឱ្យ មាន បទ ឈប់ បាញ់ រយៈពេល ៣៦ ម៉ោង ដោយ ឯកតោ ភាគី នា ឱកាស ប្រារព្ធ ពិធី បុណ្យ ណូអែល អូតូ ដុក ។ បទ ឈប់ បាញ់ នេះ ចាប់ផ្ដើម កាលពី ថ្ងៃសុក្រ និង បញ្ចប់ នៅ ពាក់កណ្ដាល យប់ ថ្ងៃសៅរ៍ ឈានចូល ថ្ងៃអាទិត្យ នេះ ប៉ុន្តែ អ៊ុយក្រែន មិន បាន ទទួលយក បទ ឈប់ បាញ់ នេះ ឡើយ ៕
កម្រង ឯកសារ ប្រវត្តិសាស្រ្ត ស្តីពី កិច្ចប្រជុំ កំពូល អាស៊ាន ឆ្នាំ ២០២២ និង សកម្មភាព របស់ សម្តច តេជោ នៅ បរទេស មុន និង ក្រោយ កិច្ចប្រជុំ ត្រូវបាន ចេញផ្សាយ ជា ផ្លូវការ
( ភ្នំពេញ ) ៖ កម្រង ឯកសារ ប្រវត្តិសាស្រ្ត ជាង ៧៣០ ទំព័រ ស្តីពី សកម្មភាព ដែល ប្រទេស កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ៤១ ក្នុង ឆ្នាំ ២០២២ ( ៨ - ១៣ វិច្ឆិកា ២០២២ ) និង ដំណើរទស្សនកិច្ច របស់ សម្តច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង គណៈប្រតិភូ ទៅ បរទេស នៅមុន និង ក្រោយ កិច្ចប្រជុំ កំពូល អាស៊ាន ត្រូវបាន ចេញផ្សាយ ជា ផ្លូវការ ហើយ នៅ ចុង សប្តាហ៍ នេះ ។
លោក សុផល ក៏ បាន អះអាង ដែរ ថា អ្វី ដែល គួរឱ្យ មោទនៈ បន្ថែម ទៀត នោះ គឺ ដោយសារតែ កម្ពុជា មាន សន្តិភាព និង មាន សមត្ថភាព គ្រប់គ្រាន់ រួមទាំង ភាពប៉ិនប្រសប់ នៃ ការដឹកនាំ របស់ សម្តេច តេជោ ទើប ក្រុមប្រឹក្សា សហព័ន្ធ កីឡា អាស៊ី អាគ្នេយ៍ ប្រគល់ « ទង់ ស៊ីហ្គេម » ជា ផ្លូវការ ឱ្យ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ដើម្បី រៀបចំ ការប្រកួត កីឡា ស៊ីហ្គេម (SEA GAME) លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ នា ឆ្នាំ ២០២៣ ដែល កម្ពុជា ខកខាន ធ្វើ អស់ រយៈ ជាង ៦០ ឆ្នាំ កន្លងមក ។
លោក សុផល រ ម្លឹក ថា ពិតជា មិន ធម្មតា ទេ ដែល កម្ពុជា អាច រៀបចំ ព្រឹត្តិការណ៍ ពិភពលោក នេះ បាន ដោយ ជោគជ័យ ដោយ មាន ការសម្របសម្រួល ឱ្យ មេដឹកនាំ ប្រទេស មហា អំណាច ដែល កំពុង មាន ជម្លោះ នឹង គ្នា និង យក ប្រៀប លើ ភូមិសាស្រ្ត នយោបាយ លើ គ្នា ទាំង នៅ អឺរ៉ុប ខាងកើត នៅ អាស៊ី បូព៌ា និង នៅ តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក អាច មក អង្គុយ ក្នុង បន្ទប់ តែ មួយ ហូប ម្ហូប ខ្មែរ ដូចគ្នា ហើយ ស្តាប់ ការជជែកគ្នា ដោយ យកចិត្តទុកដាក់ និង ប្រុងប្រយ័ត្ន ។
សូម បញ្ជាក់ ថា កម្រង ឯកសារ នេះ ត្រូវបាន បោះពុម្ព ចំនួន ១ម៉ឺន ច្បាប់ ដោយ ក្នុង ១ច្បាប់ តម្លៃ ១០.២ដុល្លារ ហើយ នឹង ត្រូវ យក ទៅ ចែកជូន មិត្ត អ្នកអាន នៅ ក្រៅ ប្រទេស ដូចជា អាម៉េរិក កាណាដា បារាំង អាល្លឺម៉ង់ បែលហ្ស៊ិក អូស្រ្តាលី និង ញូវ ស្ស៊ី លែន ជាដើម ព្រមទាំង ជូន បណ្ណាល័យ ជាតិ និង សាកលវិទ្យាល័យ នានា នៅ ទូទាំង ប្រទេស រួមទាំង ដាក់ តាម បណ្ណាគារ ផង ។
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង លោក ស៊ាក ឡេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន អញ្ជើញ ប្រារព្ធ អបអរសាទរ ថ្ងៃ ជ័យជម្នះ ៧មករា លើក ទី៤៤ ឆ្នាំ ( ៧មករា ១៩៧៩ - ៧មករា ២០២៣ ) នៅ បរិវេណ រង្វង់ មូល មុខ បុរី រដ្ឋបាល ខេត្ត ស្ថិត នៅ និគម លើ ឃុំ ស្រឡប់ ស្រុក ត្បូងឃ្មុំ ។
ក្នុង ពិធី អបអរសាទរ នោះ មាន ការអញ្ជើញ ចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ខេត្ត អភិបាល រង ខេត្ត ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត កង កំលាំងប្រដាប់អាវុធ ទាំង៣ អភិបាល អភិបាល រង ក្រុង ស្រុក ទាំង៧ លោកគ្រូ អ្នកគ្រូ យុវជនសសយក ខេត្ត និង សិស្សានុសិស្ស យ៉ាង ច្រើន កុះករ ។
ក្រោយពី អាន សន្ទរកថា ចប់ លោក បណ្ឌិត អភិបាល ខេត្ត និង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន បង្ហោះ ប៉ោង ៗ និង ថត រូប ជាមួយ មន្ត្រីរាជការ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ យ៉ាង សប្បាយរីករាយ ៕ ប្រជាពលរដ្ឋ ក្នុង ស្រុក សន្ទុក ខេត្ត កំពង់ធំ អបអរសាទរ ទិវា ជ័យជម្នះ ៧មករា
( កំពង់ធំ )៖ ថ្នាក់ដឹកនាំ កងកម្លាំងប្រដាប់អាវុធ និង អង្គការ មហាជន ក្នុង ស្រុក សន្ទុក ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ បាន មក ជួបជុំគ្នា នៅ បរិវេណ រដ្ឋបាល ស្រុក សន្ទុក ប្រារព្វ មិទ្ទិញ អបអរសាទរ ខួប លើក ទី ៤៤ ទិវា ជ័យជម្នះ ៧មករា ( ៧មករា ១៩៧៩ - ៧មករា ២០២៣ ) ក្រោម ការចូលរួម ពី លោក ស៊ុំ សន្និសិទ្ធ សមាជិក កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក សន្ទុក ។
លោក បាន បន្ដ អាន សុន្ទរក របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្រ្ដី ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ថា ថ្ងៃ ៧មករាជា ថ្ងៃ កំណើត ទី២ របស់ យើង ទាំងអស់ គ្នា មាន ៧មករា មាន អ្វី ៗ ទាំងអស់ ដូច សព្វ ថ្ងៃ នេះ ហើយ ៧មករា បាន នាំមក នូវ ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ រួម មាន ផ្លូវថ្នល់ សាលារៀន មន្ទីរពេទ្យ ប្រព័ន្ធ ទឹក ភ្លើង វត្ត អារាម និង សមិទ្ធផល ដ៏ សំខាន់ ជាច្រើន ទៀត ។
ក្នុង ឱកាស នោះ លោក ស៊ុំ សន្និសិទ្ធ បាន ផ្ដល់ អំណោយ ជូន ដល់ និវត្តន៍ ជន ចំនួន ៣០ រូប ផងដែរ ៕ ប្រជាពលរដ្ឋ ខ្មែរ នៅ ទីក្រុង ម៉ែល ប៊ន នៃ ប្រទេស អូស្ត្រាលី ៧០០ នាក់ រៀបចំ ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ ទិវា ជ័យជម្នះ ៧មករា
បណ្ឌិត គឹម សន្តិភាព លើកឡើង ថា ការធ្វើ ទារុណកម្ម និង ការកាប់ សម្លាប់ ដ៏ សាហាវ ឃោរឃៅ ព្រៃផ្សៃយង់ឃ្នង របស់ ពួក បន ក្បត់ ប្រល័យ ពូជសាសន៍ បាន ធ្វើឱ្យ ប្រជាជន ខ្មែរ ជិត បី លាន នាក់ បាន បាត់បង់ជីវិត យ៉ាង ឈឺចាប់ ខ្លោចផ្សា បំផុត និង ធ្វើឱ្យ កម្ពុជា ក្លាយជា វាល ពិឃាត ពោរពេញ ទៅ ដោយ ភ្នំ ឆ្អឹង ស្ទឹង ឈាម ស្ទើរ ពាសពេញ ផ្ទៃ ប្រទេស ។ ប្រជាជន ខ្មែរ រាប់ លាន នាក់ ក្លាយជា ជនពិការ កុមារ កំព្រា បាត់បង់ ឪពុក ម្ដាយ ព្រាត់ប្រាស គ្រួសារ ប្តី ប្រពន្ធ កូន ចៅ និង បាន រស់ នៅ រង ទុក្ខសោក យ៉ាង វេទនា ជា ទីបំផុត ។
ទន្ទឹមនឹង នេះ លោក បណ្ឌិត បាន ថ្លែង សង្កត់ធ្ងន់ ថា ដោយសារ គណបក្ស ប្រជាជន កម្ពុជា ទើប ប្រជាជន និង ប្រទេស កម្ពុជា ត្រូវបាន សង្គោះ ឱ្យ រួចផុត ពី ជ្រោះ មរណៈ បន្ត រស់រាន មាន ជីវិត មាន សេរីភាព សុខ សន្តិភព បូរណភាព ទឹកដី និង ការអភិវឌ្ឍ ជារៀងរហូតមក ។ ដូចនេះ ហើយ ថ្ងៃ ៧មករា ជា ថ្ងៃ កំណើត ទី២ របស់ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ រួប ហើយ « សត្រូវ របស់ ថ្ងៃ ៧មករា មាន តែ បក្សពួក ក្រុម ប្រលៃ ពូជសាសន៍ តែ ប៉ុណ្ណោះ »៕
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ២៤៥. ០៣៩ នាក់ ។ ក្នុង នោះ រួម មាន៖
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ !
នាយ ឧត្តមសេនីយ៍ ហ៉ីង ប៊ុន ហៀង ចាត់ទុក សន្ដិភាព ជា ខ្យល់ អុក ស៉ី សែន ហើយ បើ គ្មាន សន្ដិភាព បៀប ដូច គ្មាន ខ្យល់ ដកដង្ហើម
( កណ្ដាល ) ៖ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការ រង និង ជា មេបញ្ជាការបញ្ជាការដ្ឋាន អង្គរក្ស បាន លើកឡើង ដោយ ចាត់ទុក សន្ដិភាព ជា ខ្យល់ អុក ស៉ី សែន សម្រាប់ មនុស្ស ដកដង្ហើម ហើយ បើ គ្មាន សន្ដិភាព ប្រៀប ដូច មនុស្ស យើង គ្មាន ខ្យល់ សម្រាប់ ដង្ហើម នោះ ដែរ ។
ការលើកឡើង របស់ នាយ ឧត្តមសេនីយ៍ ហ៉ីង ប៊ុន ហៀង ក្នុង ការអញ្ជើញ ជា អធិបតី ជាមួយ លោកស្រី បែន ចន្នី បិទ ការប្រកួត កីឡាករ បាល ទះ ដើម្បី អបអរសាទរ ទិវា ជ័យ ជំនះ ៧មករា នៅ រសៀល ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ នៅ ទីបញ្ជាការដ្ឋាន អង្គរក្ស តា ខ្មៅ ។
នាយ ឧត្តមសេនីយ៍ ហ៉ីង ប៊ុន ហៀង បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « យើង សូម អរគុណ ចំពោះ សុខ សន្តិភាព សន្តិភាព ប្រៀប បាន ទៅនឹង ខ្យល់ ឧកស៊ី សែន បើ គ្មាន ឧកស៊ី សែន យើង មិន អាច ដកដង្ហើម រស់រាន មាន ជីវិត បាន នោះ ទេ ។ ដោយសារ កត្តា សុខ សន្តិភាព នេះ ហើយ ដែល បាន ធ្វើឲ្យ យើង មាន អ្វី ៗ រហូតមកដល់ ពេលនេះ និង រៀបចំ កម្មវិធី នេះ ឡើង ផងដែរ » ។
នាយ ឧត្តមសេនីយ៍ បាន អះអាង ថា កម្ពុជា ពិតជា សំណាង ណាស់ ដែល មាន ប្រមុខ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ក្នុង ការដឹកនាំ ប្រទេសជាតិ ធ្វើឲ្យ មាន សុខ សន្តិភាព ពេញលេញ នៅ ទូទាំង ប្រទេស និង អភិវឌ្ឍន៍ រីកចម្រើន លើ គ្រប់ វិស័យ ។ លោក បាន ផ្តាំផ្ញើ ដល់ ក្រុម កីឡាករ ត្រូវ បន្ត ថែរក្សា សុខ សន្តិភាព និង ចូលរួម អនុវត្ត អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ សម្តេច តេជោ និង វិធានការ សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង បាន ឧបត្ថម្ភ សម្ភារ ថវិកា ដល់ កីឡាករ ទាំង ២០ ក្រុម ចំណាត់ថ្នាក់ លេខ ១ បាន ទៅ លើ កង អន្តរាគមន៍ ចល័ត ៩៩៩ ទទួលបាន ពាន១. មេដាយ ១៥ គ្រឿង . ទង់១. បាល់៣ ហ្វីឡេ១. ប័ណ្ណ សរសើរ១. ទឹក សុទ្ធ ១០កេស . ស្រាបៀរ ១០កេស និង ថវិកា ចំនួន ៤. ៧៥០ ដុល្លារ ។
នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន អះអាង ថា បទបញ្ជា នៃ ការស្រាវជ្រាវ នេះ គឺ ត្រូវ ធ្វើឡើង ព្រម គ្នា តែម្ដង ទាំង មន្ដ្រី ការិយាល័យ នគរបាល ចរាចរណ៍ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ និង សាមីខ្លួន ជនជាតិ ចិន ដែល បាន បង្ហោះ ខ្លឹមសារ នៅលើ បណ្ដាញ សង្គម ដើម្បី ធ្វើឲ្យ មាន តម្លាភាព និង ស្មើភាព គ្នា រវាង ភាគី ទាំង ពីរ ។
នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត អគ្គ ស្នងការ នគរបាល ជាតិ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ករណី ជនជាតិ ចិន បង្ហោះ សារ លើ បណ្ដាញ សង្គម ខ្ញុំ បាន បញ្ជាបន្ទាន់ ដល់ ស្នងការ នគរបាល ខេត្ត តាកែវ ដើម្បី បើក ការស្រាវជ្រាវ ស៊ើបអង្កេត ក្រោយ ផ្ទុះ ព័ត៌មាន និង បាតុភាព តាម បណ្ដាញ សង្គម » ។
នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បាន សង្កត់ធ្ងន់ ថា ការស្រាវជ្រាវ នេះ ត្រូវ ធ្វើឡើង ពីរ ព្រម គ្នា តែម្ដង ដោយ ក្នុង នោះ ទី ១៖ ការអនុវត្ត តួនាទី ភារកិច្ច អាប្បកិរិយា ពាក្យសម្ដី របស់ មន្ដ្រី នគរបាល ចរាចរណ៍ ហើយ បើ ឃើញ មាន កំហុស នឹង ដាក់ ពិន័យ រដ្ឋបាល វិន័យ កងកម្លាំង នគរបាល ជាតិ . ទី២៖ បុគ្គល ជនជាតិ ចិន ដែល បង្ហោះ សារ តាម បណ្ដាញ សង្គម ក្រោយ មាន ការលើកឡើង ថា បាន ប្រើប្រាស់ ពាក្យសម្ដី កាយវិការ ច្រងេង ច្រងា ក និង បើកបរ លើស ល្បឿន កំណត់ រហូតដល់ ជាង ១០០ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង ។
គួរ ជម្រាប ថា កម្លាំង ការិយាល័យ នគរបាល ចរាចរណ៍ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ គោលដៅ ផ្លូវ ជាតិ លេខ ៣ ស្ថិត ក្នុង ស្រុក ត្រាំ កក់ ត្រូវបាន ដក បញ្ឈរ ជើង ទាំងអស់ ដើម្បី ធ្វើ ការស្រាវជ្រាវ ស៉ើប អង្កេត បន្ទាប់ពី រង ការរិះគន់ ពាក់ព័ន្ធ ការចាប់ អ្នកធ្វើដំណើរ ជា ជនជាតិ បរទេស ផាក ពិន័យ លើស ច្បាប់ កំណត់ និង ឈានដល់ ការប្រើប្រាស់ អំពើហិង្សា រហូត ត្រូវបាន គេ ចែកចាយ ពេញ បណ្ដាញ សង្គម ។
ករណី នេះ គឺ ផ្ដើម ចេញ ពី ជនជាតិ ចិន ម្នាក់ ទំនងជា អ្នករក ស៉ី វិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា បាន បង្ហោះ សារ រិះគន់ យ៉ាង ចាស់ ដៃ លើ មន្ដ្រី នគរបាល ចរាចរណ៍ នៅ ផ្លូវ ជាតិ លេខ៣ គីឡូម៉ែត្រ លេខ ៦៨ ស្ថិត ក្នុង ស្រុក ត្រាំ កក់ ខេត្ត តាកែវ ( គីឡូម៉ែត្រ លេខ ៦៨ ) ដែល មុនដំបូង ផាក ពិន័យ រហូតដល់ ១០០ ដុល្លារ ដោយ ចោទប្រកាន់ ថា បើក រលើស ល្បឿន កំណត់ ទាំង ដែល រូប គេ អះអាង ថា មិន បាន បើកបរ ខុស ច្បាប់ និង ឈានដល់ ការប្រើប្រាស់ អំពើហិង្សា បណ្ដាល ឲ្យ បុរស ចិន រូប នេះ មាន របួស ស្នាម ថែម ទៀត ផង ។
លោក ឈួរ សុប ញ្ញា៖ ទិវា ជ័យ ជំនះ ៧មករា មាន គុណ តម្លៃ ជា សច្ចធម៌ ប្រវត្តិសាស្រ្ត សម្រាប់ ខ្មែរ គ្រប់ ជំនាន់ ពិសេស យុវជន
( ត្បូងឃ្មុំ ) ៖ លោក ឈួរ សុបញ្ញា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ មូលនិធិ ជាតិ ជំនួយ សង្គម នៅ រសៀល ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ បាន ដឹកនាំ ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ឃុំ ក្រែក រៀបចំ កម្មវិធី ជួប សំណេះសំណាល ជាមួយ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ដែល បាន ប្រឡង ជាប់ សញ្ញាបត្រ ទុតិយភូមិ នៅក្នុង ឃុំ ក្រែក ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ក្នុង គោលបំណង អបអរសាទរ ជាមួយនឹង ខួប ៤៤ ឆ្នាំ នៃ មហា ព្រឹត្តិការណ៍ ជ័យ ជំនះ ៧មករា ។
លោក បាន លើកឡើង ថា ថ្ងៃ៧ មក រា ១៩៧៩ ជា ព្រឹត្តិការណ៍ សច្ចធម៌ ប្រវត្តិសាស្រ្ត ដែល ពុំ អាច កាត់ថ្លៃ បាន សម្រាប់ ប្រជាជន ខ្មែរ គ្រប់ សម័យកាល ដោយ ចាត់ទុក ថា ជ័យ ជំនះ ៧មករា គឺជា ថ្ងៃ កំណើត ទី២ សម្រាប់ ជនរងគ្រោះ ជាច្រើន លាន នាក់ ផ្សេង ទៀត ឲ្យ រួចផុត ជីវិត ពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ។
ក្រៅពី ទទួលបាន ជីវិត ថ្មី គឺ គុណ តម្លៃ ៧មករា បាន នាំ មកវិញ នូវ ការ រស់នៅ ក្នុង សង្គម សន្តិភាព ទទួលបាន សិទ្ធិ គ្រប់ យ៉ាង និង មើលឃើញ ពី ការរីកចំរើន របស់ ជាតិ ឥត ឈប់ឈរ ។
ចាប់តាំងពី ពេល ដែល ប្រទេសជាតិ យើង ត្រូវបាន រំដោះ ពី របប ប្រល័យ ពូជសាសន៍ មកដល់ ពេលនេះ មាន រយៈពេល ៤៤ ឆ្នាំ ហើយ ដែល យើង បាន ពុះពារ ជម្នះ រាល់ ឧបសគ្គ និង ការលំបាក យ៉ាង ច្រើន ឥត គណនា ប្រឹងប្រែង ជម្នះ នូវ ផល វិបាក លើ គ្រប់ វិស័យ ដែល បន្សល់ទុក ពី សង្គ្រាម បំផ្លិចបំផ្លាញ ខិតខំ ស្តារ កសាង និង អភិវឌ្ឍ មាតុភូមិ ពុះពារ ស្វែងរក សន្តិ ភាព និង ការផ្សះផ្សារ ជាតិ ។
រាជ រដ្ឋាភិបាល បាន ខិតខំ អនុវត្ត កម្មវិធី នយោបាយ និង យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ ដោយ សម្រេចបាន នូវ សមិទ្ធផល ជាច្រើន គួរ ជា ទី មោទនៈ ដូចត ទៅ៖
១៖ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ ត្រូវបាន ធានា ធ្វើឱ្យ ប្រជាជន រស់ នៅ យ៉ាង សុខសាន្ត
២៖ ដំណើរការកែទម្រង់ យ៉ាង ស៊ីជម្រៅ និង ទូលំទូលាយ ត្រូវបាន ជំរុញ និង បន្ត អនុវត្ត ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង ប្រសិទ្ធផល
៤៖ ក្រៅពី នេះ រាជ រដ្ឋាភិបាល បាន កសាង ហេដ្ឋ រចនាសម្ព័ន្ធ ថ្មី ៗ រួម មាន ផ្លូវ ផ្នល់ ស្ពាន ឆ្លង ទន្លេ ស្ពាន អាកាស ព្រលានយន្តហោះ និង កែលម្អ ឱ្យ កាន់តែ ប្រសើរឡើង ទាំង បរិមាណ និង គុណភាព នូវ ហេដ្ឋារចនាសម្ព័ន្ធ ដែល មាន ស្រាប់ ក៏ ដូចជា កសាង សាលារៀន មន្ទីរពេទ្យ ប្រព័ន្ធ ធារាស្រ្ត ។ល ។ ដើម្បី ជា ប្រយោជន៍ ដល់ ប្រជាជន និង កំណើន សេដ្ឋកិច្ច
៥៖ រាជ រដ្ឋាភិបាល បាន យកចិត្តទុកដាក់ ដល់ គ្រួសារ និវត្តន៍ ជន អតី យុទ្ធជន ជន មាន ពិការភាព និង គ្រួសារ ក្នុង បន្ទុក តាម រយៈ ការបង្កើន ប្រាក់ របប សន្តិសុខ សង្គម ជារៀងរាល់ ឆ្នាំ ស ម្រាប់ និវត្ត ជន អតី យុទ្ធជន ជន មាន ពិការភាព និង អ្នកបម្រើ ជន មាន ពិការភាព ដើម្បី កាត់បន្ថយ គម្លាត រវាង អ្នកចូលនិវត្តន៍ មុន និង អ្នកចូលនិវត្តន៍ ក្រោយ
៦៖ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ និង កំពុង អនុវត្ត គោលនយោ បាយ ជាតិ គាំពារ សង្គម ដើម្បី លើកកម្ពស់ សុខុមាលភាព និង សាមគ្គីភាព សង្គម និង ដើម្បី កាត់បន្ថយ ភាពក្រីក្រ ជូន ប្រជា ជន ជាពិសេស គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ។
តាមរយៈ គោល នយោបាយ នេះ រាជ រដ្ឋាភិបាល បាន និង កំពុង អនុវត្ត កម្មវិធី ជំនួយ សង្គម ចំនួន ៤ គឺ៖
( ៣) . ផ្អែក តាម ភាព មិន ច្បាស់លាស់ ដែល បណ្តាល មកពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ភាពតានតឹង ផ្នែក ភូមិ សាន យោ បាយ និង សង្គ្រាម រវាង រុស្សី និង អ៊ុយក្រែន បាន បណ្តាលឱ្យ មាន និន្នាការកើនឡើង នៃ ថ្លៃ ទំនិញ និង ម្ហូប អាហារ នៅលើ ទីផ្សារ ជាពិសេស ប៉ះពាល់ ដល់ ជីវភាព រស់ នៅ របស់ ប្រជា ពលរដ្ឋ កម្ពុជា ក្នុង គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ រាជ រដ្ឋា ភិបាល បាន ដាក់ចេញ នូវ កម្មវិធី អន្តរាគមន៍ ជំនួយ សង្គម ថ្មី គឺ កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ រង ហានិភ័យ ក្នុង អំឡុង ពេល សម្ពាធ មាន អតិផរណា ។
ក្នុង បទសម្ភាសន៍ ជាមួយ ក្រុម អ្នកសារព័ត៌មាន បន្ទាប់ពី នាំយក ថវិកា ជិត ៥ម៉ឺន ដុល្លារ របស់ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ដែល បាន ពី សំណង ចំពោះ ការប្តឹង ទណ្ឌិត សម រង្ស៉ី ទៅ ប្រគល់ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា នៅ រសៀល ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ លោក គី តិច បាន បញ្ជាក់ ថា ថវិកា ដែល បាន មកពី ការរឹបអូស ទ្រព្យសម្បត្តិ របស់ លោក សម រង្ស៉ី ដើម្បី សង ដើម បណ្តឹង ត្រូវបាន យក ទៅ ប្រើប្រាស់ ដើម្បី បម្រើ ប្រយោជន៍ ជាតិ និង ប្រជាជន ដោយ ក្នុង នោះ រួម មាន ៖
« ការរឹបអូស ទ្រព្យសម្បត្តិ ជន ប្រព្រឹត្ត ល្មើស មិន មែន មាន តែ នៅក្នុង ប្រទេស កម្ពុជា ហើយក៏ មិន មែន តែ ទណ្ឌិត សម រង្ស៉ី មួយ នោះ ដែរ បុគ្គល ណា ក៏ដោយ ឱ្យ តែ ប្រព្រឹត្ត ល្មើស តែងតែ ទទួលរង នូវ ការផ្តន្ទាទោស ទាំង ផ្នែក ព្រហ្មទណ្ឌ និង ផ្នែក រដ្ឋប វេណី » ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក គី តិច ។
លោក បន្ត ថា « មូលហេតុ អ្វី បាន អនុវត្ត អញ្ចឹង គឺ ដើម្បី ព្រមាន ឬ ផ្តន្ទា ទៅ លើ បុគ្គល ដែល ចេះតែ និយាយ បរិហារ កេរ្តិ៍ គេ ប្រឌិត រឿង ខុសពី ការពិត យក ទៅ និយាយ ជាសាធារណៈ បរិហារ កេរ្តិ៍ ធ្វើឱ្យ ប៉ះពាល់ ដល់ តម្លៃ កិត្តិយស របស់ គេ គ្រប់ គ្នា ទើប ច្បាប់ ចែង ការពារ និង ផ្តន្ទាទោស ហ្នឹង » ។
លោក បាន គូសបញ្ជាក់ បន្ថែម អំពី ចេតនា របស់ សម រង្ស៉ី ក្នុង ការនិយាយ បរិហារ កេរ្តិ៍ ជាសាធារណៈ ចំពោះ ថ្នាក់ដឹកនាំ កន្លងទៅ គឺជា ចេតនា បង្ខូយ កិត្តិយស ខណៈ ដើម បណ្តឹង ដែល សុទ្ធសឹង ជា ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ មាន ប្រជាពលរដ្ឋ គាំទ្រ ពេញ ប្រទេស ។
លោក បន្ត ថា៖ « នេះ ជា ការសម្រេច របស់ តុលាការ ដោយ អនុវត្ត ទៅតាម ច្បាប់ ប្រទេស នីតិរដ្ឋ គឺ មិន បណ្តែត បណ្តោយ ឲ្យ បុគ្គល ដែល ប្រព្រឹត្ត ល្មើស ហ្នឹង រួច ខ្លួន នោះ ទេ ត្រូវតែ ប្តឹង សុំឲ្យ តុលាការ សម្រេច និង បង្ហាញ អំពី ការអនុវត្ត ច្បាប់ » ។
លោក កែវ ពិសិដ្ឋ បាន លើកឡើង បែប នេះ បន្ទាប់ពី លោក រួម ជាមួយ លោក គី តិច ប្រធាន ក្រុម មេធាវី រាជ រដ្ឋាភិបាល កម្ពុជា នាំយក ថវិកា សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា បាន ពី ការប្តឹង ទណ្ឌិត សម រង្ស៉ី ចំនួន ជិត ៥ម៉ឺន ដុល្លារ អាមេរិក ទៅ ប្រគល់ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា នា រសៀល ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
ថ្លែង ក្នុង កិច្ចសម្ភាសន៍ ជាមួយ ក្រុម អ្នកសារព័ត៌មាន លោក គី តិច បាន បញ្ជាក់ ដូច្នេះ ថា៖ « ការចោទប្រកាន់ ការមួល បង្កាច់ បំភ្លៃ បំផ្លើស មក លើ ការដឹកនាំ របស់ សម្តេច ពញា ចក្រី ក្នុង អំឡុង ទសវត្ស ជា ការចោទប្រកាន់ យ៉ាង អយុត្តិធម៌ មក លើ សម្តេច ឥឡូវនេះ តុលាការ បាន សម្រេច ផ្តល់ យុត្តិធម៌ ដល់ សម្តេច ពញា ចក្រី ... យុត្តិធម៌ ទាំង នេះ បាន ផ្តល់ នូវ ភាព ស្អាតស្អំ កិត្តិយស របស់ សម្តេច ក៏ បាន ត្រឡប់ មកវិញ » ។
បើ តាម លោក គី តិច . ចំពោះ ថវិកា ដែល តុលាការ បាន សម្រេច រឹបអូស អចលន ទ្រព្យ ពី កូន បំណុល ទណ្ឌិត សម រង្ស៉ី លក់ ឡៃ ឡុង ធានា សំណង ដល់ សហម្ចាស់ បំណុល ( ដើម បណ្តឹង ផ្នែក រដ្ឋប្បវេណី និង ម្ចាស់ បណ្តឹង អាជ្ញា ) ត្រូវបាន បរិច្ចាគ ដូច ខាងក្រោម៖
* ទី១៖ ថវិកា ចំណែក របស់ សម្តេច ពញា ចក្រី ហេង សំរិន ចំនួន ៤៨. ៤៤៨. ២៨ ដុល្លារ អាមេរិក ត្រូវបាន ប្រគល់ ជូន មន្ទីរពេទ្យ កុមារ គន្ធ បុប្ផា ។
* ទី២៖ ថវិកា ចំណែក របស់ សម្តេច តេជោ ហ៊ុន សែន ចំនួន ៧៧៥. ១៧២. ៧១ ដុល្លារ អាមេរិក ត្រូវបាន ប្រគល់ ជូន ក្រុម មេធាវី ស្ម័គ្រចិត្ត ទុក ក្នុង កញ្ចប់ ថវិកា សម្រាប់ ប្រតិបត្តិការ ការពារ ក្តី ជូន ស្រ្តី ងាយ រងគ្រោះ និង មាន ជីវភាពទន់ខ្សោយ ។
* ទី៣៖ ថវិកា ចំណែក របស់ សម្តេច ក្រឡាហោម ចំនួន ៣៨៧. ៥៨៦. ៣៥ ដុល្លារ អាមេរិក ត្រូវបាន ចាត់ចែង ប្រគល់ សម្រាប់ ការសាងសង់ សាលារៀន និង មណ្ឌលកុមារ កំព្រា តាម បណ្តា មូលដ្ឋាន ខេត្ត ។
ទស្សនា រូបភាព ពិធី សម្ពោធ ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ដែល បង្ហាញ ប្រវត្តិ ជីវិត ពិត របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត
( ភ្នំពេញ ) ៖ ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ដែល បង្ហាញ ប្រវត្តិ ជីវិត ពិត ដ៏ សោកសៅ និង ខ្លោចផ្សារ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ត្រូវបាន សម្ពោធ ចាក់បញ្ចាំង នៅ ល្ងាច ថ្ងៃសៅរ៍ ទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
លោក អាល់ បានីស បាន និយាយ ថា មន្រ្តី រដ្ឋាភិបាល របស់ គលោក កំពុង ធ្វើការ យ៉ាង សស្រាក់សសស្រាំ ជាមួយ រដ្ឋ អូស្ត្រាលី ខាងលិច លើ វិបត្តិ នៅក្នុង តំបន់ ដែល មាន ប្រជាជន តិច ដែល រួម បញ្ចូល ទីក្រុង រមណីយដ្ឋាន ប្រ៊ូម (Broome) ផងដែរ ។
គួរ បញ្ជាក់ ថា យន្តហោះ របស់ កងកម្លាំង ការពារ អូស្ត្រាលី កំពុង ត្រូវបាន ប្រើប្រាស់ ដើម្បី ជួយ ដល់ សហគមន៍ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ហើយ ឧទ្ធម្ភាគចក្រ ប្រភេទ តូច ៗ កំពុង ធ្វើដំណើរ ដើម្បី ជួយ អ្នកស្រុក ដែល រង ផល ប៉ះពាល់ ពី ការផ្លាស់ ទីលំនៅ ៕
រដ្ឋបាល រាជធានី ភ្នំពេញ រៀបចំ អាហារ សាមគ្គី ជូន ជន មាន ពិការ ភ្នែក ជន ងាយ រងគ្រោះ នៅ សមាគម តន្ត្រី សំនៀង ជន ពិការ ចាប តូ និង មណ្ឌល ឱកាស ខ្ញុំ ដើម្បី អបអរ ខួប ៤៤ ឆ្នាំ នៃ ទិវា ជ័យជម្នះ ៧ មករា
នា ឱកាស នោះ លោកស្រី មុំ ចាន់ ដានី បាន លើកឡើង ពី គុណ បំណាច់ របស់ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន រំដោះ ប្រទេស ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ការសម្លាប់ ប្រជាជន យ៉ាង រង្គាល រហូតដល់ មាន ថ្ងៃ រំដោះ ៧ មក រា ១៩៧៩ ព្រមទាំង បន្ត មក ព្រឹត្តិការណ៍ ស្វែងរក សន្តិភាព តាម រយៈ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ការកសាង ប្រទេសជាតិ ចាប់ពី បាត ដៃ ទទេ នាំមក នូវ ការអភិវឌ្ឍ ដូច ពេល បច្ចុប្បន្ន នេះ វា មិន មែន ជា ការបំភ្លៃ ប្រវត្តិសាស្ត្រ នោះ ឡើយ តែ ជា សច្ចធម៌ ប្រវត្តិសាស្ត្រ យ៉ាង ពិតប្រាកដ ។
លោកស្រី បាន បន្ត ថា ក្រោយ ថ្ងៃ រំដោះ ៧មករា ប្រសិនបើ គ្មាន ការ ដាក់ចេញ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន នោះ ទេ កម្ពុជា ក៏ គ្មាន សន្តិភាព ដូច ពេល បច្ចុប្បន្ន ដែរ ។ មកដល់ ឆ្នាំ ១៩៩៨ ទើប ខ្មែរ ទាំងអស់ ឈ្នះ ហើយ រួមរស់ នៅ សុខសាន្ត ជាមួយគ្នា រហូតដល់ សព្វ ថ្ងៃ ។
លោកស្រី បាន បន្ត ថា គណបក្ស ប្រជាជន កម្ពុជា គឺ បាន រួម កម្លាំង ជាមួយ ប្រជាជន ក្នុង ការរំដោះ ប្រទេសជាតិ ពីរ បប ខ្មៅ ងងឹត ប៉ុល ពត និង បាន ពួត ដៃ ជាមួយ ប្រជាជន ក្នុង ការកសាង ប្រទេស ដ៏ កម្សត់ មួយ នេះ មកដល់ ពេល បច្ចុប្បន្ន កម្ពុជា បាន ក្លាយជា ប្រទេស ស្មើ មុខ ស្មើ មាត់ លើ ឆាក អន្តរជាតិ មាន សក្ដានុពល គ្រប់ វិស័យ ។
លោកស្រី ថា៖ « សច្ចធម៌ ប្រវត្តិសាស្ត្រ មិន អាច មាន អ្នកណា ម្នាក់ ឬ ក្រុម ណា មួយ បំភ្លៃ បាន នោះ ឡើយ ។ ដូច្នេះ យើង ត្រូវ ចូលរួម ការពារ សន្តិភាព ទាំងអស់ គ្នា ដើម្បី ទប់ស្កាត់ កុំ ឱ្យ ប្រទេសជាតិ វិលត្រឡប់ ទៅ រក សង្គ្រាម និង បន ប្រល័យ ពូជសាសន៍ វិញ ដាច់ខាត កម្ពុជា មិន វិលត្រឡប់ ទៅ រក សង្គ្រាម វិញ នោះ ឡើយ » ។
លោកស្រី មុំ ចាន់ ដានី បាន ជម្រាប ជូន ដល់ ជន ពិការ ភ្នែក និង ជន ងាយ រងគ្រោះថា យើង ត្រូវ គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការបោះឆ្នោត នា ថ្ងៃ ខាងមុខ ព្រមទាំង បន្ត គាំទ្រ សម្ដេច តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សម្រាប់ អាណត្តិ ទី៧ និង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី នា ពេល អនាគត ។
« ទីក្រុង Tacoma ជា សហគមន៍ មួយ ដែល ពោរពេញ ទៅ ដោយ អ្នក កាន់ សាសនា និង ប្រកាន់ ជំនឿ ចម្រុះ ផ្សេង ៗ គ្នា ហើយ តែងតែ លើកកម្ពស់ មរតក វប្បធម៌ សកម្មភាព សុឆន្ទៈ និង ភាពរាប់អាន ស្និទ្ធស្នាល ព្រមទាំង ប្រឹងប្រែង ជានិច្ច ដើម្បី ផ្តល់ ការយោគយល់ ការគោរព និង កាលានុវត្តភាព សម្រាប់ សមាជិក ទាំងអស់ នៅក្នុង សហគមន៍ ។
ដោយឡែក នៅ ថ្ងៃទី ៧ ខែមករា ក៏ ត្រូវ ជា គម្រប់ ខួប ទី៤៤ នៃ ទិវា ជ័យជម្នះ ដែល រំឭក អំពី ការដួលរលំ នៃ របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ផងដែរ ហើយ យើង ស្ងើចសរសើរ ជាខ្លាំង ចំពោះ ភាពរឹងមាំ និង ការតស៊ូ ជម្នះ របស់ បុគ្គល ដូចជា Rady ជាដើម ដែល បាន ប្រឹងប្រែង រក្សា វប្បធម៌ របស់ ពួកគេ ឱ្យ នៅរស់រវើក ។
ការចូលរួម អបអរសាទរ និង បញ្ជាក់ អំពី ការទទួលស្គាល់ ថ្ងៃ ជ័យ ជំនះ ៧មករា នេះ ធ្វើឡើង បន្ទាប់ពី ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា នៅ រដ្ឋធានី វ៉ាស៉ីនតោន បាន រៀបចំ ពិធី ជួបជុំ ដើម្បី អបអរសាទរ ថ្ងៃ ដ៏ សំខាន់ មួយ នេះ ។ ទាំង នេះ គឺជា មោទនភាព មួយ ជាពិសេស សម្រាប់ ប្រជាជន ខ្មែរ ដែល រស់ នៅ សហរដ្ឋ អាមេរិក ផ្ទាល់ តែម្ដង ៕
លោក ថោង ខុន ដឹកនាំ សមាជិក បក្ស និង ប្រជាជន១ពាន នាក់ ប្រារព្ធ ទិវា ជាតិ ជ័យជម្នះ ៧ មករា នៅ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក
( កំពង់ធំ )៖ លោក ថោង ខុន អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន ដឹកនាំ សមាជិក - សមាជិកា គណបក្ស និង ប្រជាជន មូលដ្ឋាន ប្រមាណ ១ពាន នាក់ ប្រារព្ធ ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ ទិវា ជាតិ ជ័យជម្នះ ៧មករា ។
នា ឱកាស នោះ លោក ទិត ចន្ថា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក បាន ឡើង អាន សារលិខិត របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ជូន អង្គ ពិធី បាន ដឹង ។
លោក ថោង ខុន បាន បញ្ជាក់ ថា ប្រសិនបើ យើង គិត ចាប់ពី សម័យ ដែល កម្ពុជា ធ្លាក់ ក្នុង របប ប្រល័យ ពូជសាសន៍ ការរងទុក្ខវេទនា ការសម្លាប់ ប្រជាជន យ៉ាង រង្គាល រហូតដល់ មាន ថ្ងៃ រំដោះ ៧ មក រា ១៩៧៩ ព្រមទាំង បន្ត មក ព្រឹត្តិការណ៍ ស្វែងរក សន្តិភាព តាម រយៈ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ការកសាង ប្រទេសជាតិ ចាប់ពី បាត ដៃ ទទេ នាំមក នូវ ការអភិវឌ្ឍ ដូច ពេល បច្ចុប្បន្ន នេះ វា មិន មែន ជា ការបំភ្លៃ ប្រវត្តិសាស្ត្រ នោះ ឡើយ តែ ជា សច្ចធម៌ ប្រវត្តិសាស្ត្រ យ៉ាង ពិតប្រាកដ ។
លោក បាន បន្ត ថា ក្រោយ ថ្ងៃ រំដោះ ៧មករា ប្រសិនបើ គ្មាន ការ ដាក់ចេញ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន នោះ ទេ កម្ពុជា ក៏ គ្មាន សន្តិភាព ដូច ពេល បច្ចុប្បន្ន ដែរ ។ មកដល់ ឆ្នាំ ១៩៩៨ ទើប ខ្មែរ ទាំងអស់ ឈ្នះ ហើយ រួមរស់ នៅ សុខសាន្ត ជាមួយគ្នា រហូតដល់ សព្វ ថ្ងៃ ។
លោក បាន បន្ត ថា គណបក្ស ប្រជាជន កម្ពុជា គឺ បាន រួម កម្លាំង ជាមួយ ប្រជាជន ក្នុង ការរំដោះ ប្រទេសជាតិ ពីរ បប ខ្មៅ ងងឹត ប៉ុល ពត និង បាន ពួត ដៃ ជាមួយ ប្រជាជន ក្នុង ការកសាង ប្រទេស ដ៏ កម្សត់ មួយ នេះ មកដល់ ពេល បច្ចុប្បន្ន កម្ពុជា បាន ក្លាយជា ប្រទេស ស្មើ មុខ ស្មើ មាត់ លើ ឆាក អន្តរជាតិ មាន សក្ដានុពល គ្រប់ វិស័យ ។ លោក ថា « សច្ចធម៌ ប្រវត្តិសាស្ត្រ មិន អាច មាន អ្នកណា ម្នាក់ ឬ ក្រុម ណា មួយ បំភ្លៃ បាន នោះ ឡើយ » ។
ជា ការ សង្កត់ធ្ងន់ របស់ លោក ថោង ខុន ទៅដល់ សមាជិក - សមាជិក គណបក្ស និង ប្រជាជន នៅ មូលដ្ឋាន ស្រុក ទាំង២នេះ គឺ ត្រូវ ចូលរួម ការពារ សន្តិភាព ទាំងអស់ គ្នា ដើម្បី ទប់ស្កាត់ កុំ ឱ្យ ប្រទេសជាតិ វិលត្រឡប់ ទៅ រក សង្គ្រាម និង បន ប្រល័យ ពូជសាសន៍ វិញ ដាច់ខាត កម្ពុជា មិន វិលត្រឡប់ ទៅ រក សង្គ្រាម វិញ នោះ ឡើយ ។
លោក បាន បន្ត ទៀត ថា ដើម្បី ចូលរួម ការពារ សន្តិភាព ឱ្យ បាន គង់វង្ស យូរអង្វែង មាន តែ ការបោះឆ្នោត ជូណ គណបក្ស ប្រជាជន កម្ពុជា នោះ ទេ ដែល ជា គណបក្ស រំដោះ ប្រជាជន ស្វែងរក សន្តិភាព ក សាង ប្រទេស ការពារ សន្តិភាព ការពារ អាយុជីវិត ប្រជាជន និង ជា គណបក្ស ដែល ការពារ ប្រទេស កម្ពុជា មិន ឱ្យ វិលត្រឡប់ ទៅ រក សង្គ្រាម ជាដាច់ខាត ។
តំណាង សមាជិក - សមាជិកា គណបក្ស ក៏ បាន ឡើង ប្ដេជ្ញាចិត្ត ចូលរួម ការពារ សន្តិភាព ពង្រឹង សាមគ្គី ផ្ទៃក្នុង ពិសេស គឺ បន្ត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការបោះឆ្នោត នា ថ្ងៃ ខាងមុខ ព្រមទាំង បន្ត គាំទ្រ គាំទ្រ សម្ដេច តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សំរាប់ អាណត្តិ ទី៧ និង លោក ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី នា ពេល អនាគត ៕
មន្ត្រីរាជការ និង ពលរដ្ឋ ជាង ១ ពាន់ នាក់ នៅ ខេត្ត រតនគិរី ប្រារព្ធ ខួប ៤៤ ឆ្នាំ ទិវា ជ័យជម្នះ ៧ មករា ជាមួយនឹង ការប្តេជ្ញាចិត្ត រក្សា ឱ្យ បាន នូវ សន្តិភាព ឱ្យ បាន គង់វង្ស ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន
( រតនគិរី ) ៖ នា ព្រឹក ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ រដ្ឋបាល ខេត្ត រតនគិរី បាន រៀបចំ ពិធី មីទ្ទិញ រំឭក ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ទិវា ជ័យជម្នះ ៧មករា ( ០៧ មករា ១៩៧៩ - ០៧ មករា ២០២៣ ) និង ពិធី បញ្ចុះ បឋម សីលា ដើម្បី សាងសង់ វិមាន ឯករាជ្យ ក្នុង បរិវេណ អតីត ព្រលានយន្តហោះ ខេត្ត ស្ថិត នៅ ក្រុង បាន លុង ក្រោម អធិបតីភាព លោក ជៀង អំ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត រតនគិរី ។
លោក ជៀង អំ ក៏ បាន រំលេច ផងដែរ ថា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ នយោបាយ ដ៏ ធំ គួរឱ្យ កត់សម្គាល់ គឺ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា ។ ដូច្នេះ គណបក្ស ប្រជាជន កម្ពុជា បាន ត្រៀម ខ្លួន ជាស្រេច ក្នុង ការចូលរួម ប្រកួតប្រជែង ក្នុង ការបោះឆ្នោត នេះ រួចរាល់ ។ គណបក្ស ប្រជាជន ប្ដេជ្ញាចិត្ត នឹង ដណ្តើមយក ជ័យជម្នះ ឱ្យ បាន ជាដាច់ខាត ក្នុង ការបោះឆ្នោត នា ពេល ខាងមុខ នេះ ពីព្រោះ ការបោះឆ្នោត នា ពេល ខាងមុខ ពិតជា មាន សារៈសំខាន់ ណាស់ ចំនួន ២៖
គឺ ទី១៖ គឺ ការការពារ សុខ សន្តិភាព របស់ សង្គមជាតិ ក៏ ដូច ជា៖ ប្រទេសជាតិ របស់ យើង ទាំងមូល ឱ្យ បាន ស្ថិតស្ថេរ គង់វង្ស ។ ដូច ដែល យើង បាន ដឹង ច្បាស់ ហើយ មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ផ្ទុយទៅវិញ បើ គ្មាន សន្តិភាព ទេ នោះ យើង មិន មាន ការរីក ចម្រើន ឡើយ ។ ដូច ពាក្យស្លោក បាន ចែង ថា « អរគុណ សន្តិភាព » អរគុណ នយោបាយ ឈ្នះ - ឈ្នះ នេះ ពិតជា ត្រឹមត្រូវ ណាស់ ។
( ជប៉ុន ) ៖ លោក បណ្ឌិត អុិត សំហេង សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ កសាង ពង្រឹង គណបក្ស ប្រជាជន កម្ពុជា ប្រចាំ ប្រទេស ជប៉ុន បាន អញ្ជើញ ចូលរួម ពិធី រំលឹក ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ទិវា ជ័យជម្នះ ៧មករា ជាមួយ សមាជិក គណបក្ស នៅ ប្រទេស ជប៉ុន ប្រមាណ ជាង ២០០ នាក់ នា ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ នៅ ទីក្រុង តូក្យូ ។
នា ឱកាស នោះ លោក បណ្ឌិត បាន លើកឡើង ថា ថ្ងៃ នេះ ប្រជាជន កម្ពុជា ទាំង ក្នុង និង ក្រៅ ប្រទេស បាន និង កំពុង រៀបចំ អបអរសាទរ នូវ ការរំលឹក ខួប នៃ ទិវា ជ័យជម្នះ ជា ប្រវត្តិសាស្ត្រ ក្នុង ស្មារតី ចងចាំ ជានិច្ច នូវ គុណូបការៈ របស់ កម្មាភិបាល យុទ្ធជន យុទ្ធ នារី និង អ្នកស្នេហាជាតិ ទាំងអស់ ដែល បាន ចូលរួម ប្រយុទ្ធ និង ធ្វើ ពលីកម្ម ក្នុង បុព្វហេតុ រំដោះ ជាតិ មាតុភូមិ ចេញ ពី របប ប៉ុល ពត ដ៏ ខ្មៅ ងងឹត នេះ ។
ទន្ទឹម នឹង នោះ លោក បណ្ឌិត អ៉ិត សំហេង បាន ដាក់ចេញ នូវ ទិសដៅ មួយចំនួន សម្រាប់ ថ្នាក់ដឹកនាំ សាខា គណបក្ស និង សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ ដើម្បី អាច យក ទៅ ធ្វើ មូលដ្ឋាន ក្នុង ការធ្វើ សកម្មភាព ដើម្បី រួមគ្នា រក្សា ឱ្យ បាន នូវ ប្រៀប ឈ្នះ និង បន្ត ពង្រីក ប្រៀប ឈ្នះ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នា ពេល ខាងមុខ នេះ ផងដែរ ៕ កូនសិស្ស អាយុ៦ ឆ្នាំ ម្នាក់ យក កាំភ្លើង បាញ់ លើ អ្នកគ្រូ របស់ ខ្លួន ក្នុង ថ្នាក់ រៀន នៅ សហរដ្ឋ អាមេរិក
អាជ្ញាធរ អាមេរិក បាន ឱ្យដឹង ថា ក្មេង បុរស ខាងលើ មាន កាំភ្លើង ខ្លី មួយ ដើម នៅក្នុង ថ្នាក់រៀន កើត ហេតុ ហើយ ពួកគេ បាន ឃាត់ខ្លួន កូនសិស្ស នោះ ជា បណ្តោះអាសន្ន ។ ប៉ូលិស បាន អះអាង ថា វា មិន មែន ជា ករណី ផ្ទុះ អាវុធ ដោយ ចៃដន្យ ឡើយ ប៉ុន្តែ ក៏ មិន មែន ជា ស្ថានការណ៍ ដែល មាន មនុស្ស ម្នាក់ ដើរ ធ្វើ សកម្មភាព ប្រហារ នៅក្នុង សាលា នោះ ដែរ ។ នា ពេលនេះ ក្រុម អ្នក ស៉ើប អង្កេត កំពុង ព្យាយាម កំណត់ ថា តើ ក្មេងប្រុស នោះ បាន កាំភ្លើង មកពី ណា ។
គឺ ទី១៖ គឺ ការការពារ សុខ សន្តិភាព របស់ សង្គមជាតិ ក៏ ដូច ជា៖ ប្រទេសជាតិ របស់ យើង ទាំងមូល ឱ្យ បាន ស្ថិតស្ថេរ គង់វង្ស ។ ដូច ដែល យើង បាន ដឹង ច្បាស់ ហើយ មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ផ្ទុយទៅវិញ បើ គ្មាន សន្តិភាព ទេ នោះ យើង មិន មាន ការរីក ចម្រើន ឡើយ ។ ដូច ពាក្យស្លោក បាន ចែង ថា « អរគុណ សន្តិភាព » អរគុណ នយោបាយ ឈ្នះ - ឈ្នះ នេះ ពិតជា ត្រឹមត្រូវ ណាស់ ។
សម្ដេច ចៅហ្វា វាំង គង់ សំអុល ដឹកនាំ ប្រារព្ធ ទិវា ខួប លើក ទី ៤៤ ថ្ងៃ ជ័យ ជំនះ ៧មករា នៅ ខេត្ត កំពង់ឆ្នាំង និង ចែក ម៉ូតូ ម្នាក់១ គ្រឿង ជូន សិស្ស ប្រឡង ជាប់ បាក់ឌុប និទ្ទេស A ទាំង ២៧ នាក់ ផងដែរ
( កំពង់ឆ្នាំង ) ៖ សម្ដេច ចៅហ្វា វាំង គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ខេត្ត កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី ប្រារព្ធ ទិវា ខួប លើក ទី ៤៤ ថ្ងៃ ជ័យ ជំនះ ៧មករា ( ១៩៧៩ - ២០២៣ ) នៅ សាលា ខេត្ត កំពង់ឆ្នាំង ដោយ មាន មន្ត្រីរាជការ តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង ប្រជាពលរដ្ឋ ចូលរួម ចំនួន ៤៩៨៩ នាក់ ។
នៅក្នុង ទិវា អបអរសាទរ ខួប លើក ទី ៤៤ ថ្ងៃ ៧មករា នេះ ក្រុម សិល្បៈ នៃ មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ ខេត្ត កំពង់ឆ្នាំង ក៏ បាន សំដែង នូវ របាំ ជូនពរ និង របាំ យុវជន សន្តិភាព ដើម្បី អបអរសាទរ នៅក្នុង ពិធី នេះ ប្រកបដោយ ភាពរីករាយ ។
លោក ស៊ុន សុវណ្ណា រិទ្ធ បាន បន្ថែម ទៀត ថា ដូច្នេះ ដើម្បីឲ្យ កម្ពុជា មាន សុខ សន្តិភាព និង មាន ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ បន្ត ទៀត នោះ យើង ទាំងអស់ គ្នា ជា មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ សូម គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ បេក្ខភាព សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៅក្នុង អាណត្តិ ទី៧ ខាងមុខ នេះ និង សូម គាំទ្រ យ៉ាង ម៉ឺងម៉ាត់ ចំពោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត អនាគត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ផងដែរ ។
នា ឱកាស នោះ សម្ដេច ចៅហ្វា វាំង គង់ សំអុល និង អស់ លោក លោកស្រី រួមទាំង ក្រុមការងារ ដែល បាន អញ្ជើញ ចូលរួម នៅក្នុង កម្មវិធី ខាងលើ នេះ ក៏ បាន រាប់បាត្រ ប្រគេន ព្រះសង្ឃ ចំនួន ៤៤ អង្គ ទៅ តាម ប្រពៃណី សាសនា ដើម្បី ឧទ្ទិស កុសល ជូន ដល់ បុព្វបុរស អ្នកស្នេហាជាតិ គ្រប់ ជំនាន់ និង កម្មាភិបាល យុទ្ធជន យុទ្ធ នារី និង ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន បូជា ជីវិត ដើម្បី ជាតិ មាតុភូមិ កម្ពុជា ដោយ បាន បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ សម្ដេច ទ្រង់ ឯកឧត្តម លោក លោកស្រី ទាំងអស់ នោះ បាន សោយសុខ ក្នុង សុគតិភព កុំបី ឃ្លាង ឃ្លាត ឡើយ ។
សូម បញ្ជាក់ ថា សម្ដេច ចៅហ្វា វាំង គង់ សំអុល ក៏ បាន ចែក ម៉ូតូ ចំនួន ២៧ គ្រឿង ដល់ សិស្ស ប្រឡង ជាប់ សញ្ញាបត្រ ទុតិយភូមិ ទទួលបាន និទ្ទេស A ចំនួន ២៧ នាក់ នៅក្នុង ខេត្ត កំពង់ឆ្នាំង ផងដែរ ៕ ខួប ៤៤ ឆ្នាំ នៃ ទិវា ជ័យជម្នះ ៧ មករា . អភិបាល ខេត្ត បាត់ដំបង សូម ឧទ្ទិស ស្មារតី នេះ ស្ថិតស្ថេរ នៅក្នុង ក្រអៅបេះដូង ពលរដ្ឋ គ្រប់ ៗ រូប
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន ប្រារព្ធ ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ទិវា ជ័យជម្នះ ៧ មករា ( ៧ មករា ១៩៧៩ - ៧ មករា ២០២៣ ) លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង សូម ឧទ្ទិស ឱ្យ ស្មារតី ថ្ងៃ រំដោះ ជាតិ នេះ ស្ថិតស្ថេរ និង ចងចាំ នៅក្នុង ក្រអៅបេះដូង ពលរដ្ឋ គ្រប់ ៗ រូប និង ជា និមិត្តរូប នៃ សាមគ្គី ជាតិ និង មហា គ្រួសារ ខ្មែរ ស្ថិត នៅ ជា អមតៈក្រោម ម្លប់ សុខ សន្តិភាព ដែល រកបាន ដោយ លំបាក របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ពិធី អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ទិវា ជយ័ជម្នះ ៧ មករា បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក សុខ លូ អភិបាល ខេត្ត ព្រមទាំង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ខេត្ត ព្រះសង្ឃ ក្រុង ស្រុក ឃុំ សង្កាត់ អគ្គកុល ស៊ុល វៀតណាម ប្រចាំ ខេត្ត កងកម្លាំង មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ ចំនួន ៦. ១៦៣ នាក់ ផងដែរ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ទន្ទឹម នឹង នោះ កម្ពុជា ក៏ មាន កិត្យានុភាព និង មុខមាត់ សារជាថ្មី លើ ឆាក អន្តរជាតិ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ បំផុត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បច្ចុប្បន្ន ។
លោក បាន រម្លឹក ថា រណសិរ្ស សាមគ្គី សង្រ្គោះ ជាតិ កម្ពុជា ត្រូវបាន កើតឡើង ដោយ កម្លាំង មហាសាមគ្គី ប្រជាជន ទាំងមូល ទាំង ក្នុង និង ក្រៅ ប្រទេស ដែល មាន សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន សម្តេច អគ្គ មហា ធម្មពោធិសាល ជា ស៊ីម សម្តេច តេជោ ហ៊ុន សែន និង វីរ ជន ស្នេហាជាតិ ជាច្រើន រូប ទៀត ក្នុង ការរៀបចំ កម្លាំង ផ្ដួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង ទទួលបាន ជ័យជម្នះ លើ របប នេះ នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។
ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ រណសិរ្ស ប្រជាជន គ្រប់ ទិសទី បាន ក្រោក ឈរ រួបរួម គ្នា ជា កម្លាំង មហាសាមគ្គី ជាតិ ដោយ បាន ទទួល ការជួយ ឧបត្ថម្ភ យ៉ាង ធំធេង ពី កងទ័ព ស្ម័គ្រចិត្ដ វៀតណាម និង ការគាំទ្រ ពី មិត្ដភក្ដិ ជិត ឆ្ងាយ លើ សកលលោក ដើម្បី ផ្ដួលរំលំ របប កម្ពុជា ប្រជាធិបតេយ្យ រហូតដល់ ទទួលបាន ជ័យជម្នះ ដ៏ ត្រចះត្រចង់ នា ថ្ងៃ៧ ខែមករា ឆ្នាំ ១៩៧៩៕ រយៈ៤ ថ្ងៃ នេះ អភិបាល ខណ្ឌ ទួលគោក បន្ត ចុះ ស្វែងយល់ និង ទទួល សំណូមពរ ព្រមទាំង ចែក អំណោយ ជូន ពលរដ្ឋ នៅ តាម សង្កាត់ ចំនួន ៧
លោក ជា ពិសី និង មន្ត្រី ក្រោម ឱវាទ ស្ថិត ក្នុង សកម្មភាព ចុះ ស្វែងយល់ អំពី សុខ ទុក្ខ ក្ដីកង្វល់ និង ជីវភាព រស់ នៅ ហើយ នឹង ឆ្លៀត ទទួលយក សំណូមពរ មួយចំនួន ដើម្បី រិះរក ដំណោះស្រាយ ជូន ប្រជាពលរដ្ឋ នេះ ដែរ បាន ធ្វើឡើង យ៉ាង យកចិត្តទុកដាក់ ដើម្បី ឆ្លើយតប ឲ្យ ទាន់ ពេលវេលា នូវ រាល់ តម្រូវ ការចាំបាច់ ផ្សេង ៗ សម្រាប់ បម្រើ ប្រជាពលរដ្ឋ ក្នុង ន័យ « ធ្វើឱ្យ បាន ធ្វើឱ្យ លឿន និង តម្លាភាព » ស្រប តាម ការដឹកនាំ ប្រកបដោយ ភាពឈ្លាសវៃ និង គតិបណ្ឌិត ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ប្រាក់ ជិត ៥ម៉ឺន ដុល្លារ នេះ គឺជា ប្រាក់ សំណង ជំងឺ ចិត្ត បាន ពី ការប្តឹង ទណ្ឌិត សម រង្ស៉ី ក្នុង សំណុំរឿង បរិហាកេរ្តិ៍ កាលពី ឆ្នាំ ២០១៥ ។ នៅក្នុង ឱកាស នោះ ដែរ លោក មេធាវី គី តិច ក៏ បាន នាំយក ថវិកា ផ្ទាល់ខ្លួន ចំនួន ១០លាន រៀល ប្រគល់ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា ផងដែរ ។
ចំពោះ ថវិកា ដែល តុលាការ បាន សម្រេច រឹបអូស អចលន ទ្រព្យ ពី កូន បំណុល ទណ្ឌិត សម រង្ស៊ី លក់ ឡៃ ឡុង ធានា សំណង ដល់ សហម្ចាស់ បំណុល ( ដើម បណ្តឹង ផ្នែក រដ្ឋប្បវេណី និង ម្ចាស់ បណ្តឹង អាជ្ញា ) ត្រូវបាន លោក គី តិច បញ្ជាក់ ដូច ខាងក្រោម៖
លោក គី តិច បាន បន្ថែម ថា បញ្ហា នេះ កើតឡើង ដោយ ការអនុវត្ត ច្បាប់ នៅក្នុង ប្រទេស នីតិរដ្ឋ នៅក្នុង ប្រទេស ណា ក៏ដោយ ត្រូវតែ មាន វិធានការ បែប នេះ « បុគ្គល ដែល បាន ប្រព្រឹត្ត អំពើ ល្មើស នោះ ច្បាប់ ត្រូវ ចាប់បង្ខំ ឲ្យ ទទួលខុសត្រូវ ទាំង ផ្នែក ព្រហ្មទណ្ឌ និង ទាំង ផ្នែក សំណង នៃ ការខូចខាត របស់ ជនរងគ្រោះ » ។
លោក បាន គោរព និង ថ្លែង នូវ អំណរគុណ ចំពោះ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន . សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច ក្រឡាហោម ស ខេង ដែល ជានិច្ចកាល តែងតែ ខិតខំ ពុះពារ គ្រប់ ឧបសគ្គ ក្នុង ការដឹកនាំ ប្រទេស ទទួលបាន នូវ ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ និង នាំមក នូវ សន្តិភាព ពេញលេញ ដូច ពេលនេះ ។
គួរ ជម្រាប ថា ពិធី បុណ្យ ទន្លេ ត្រូវបាន រៀបចំ ចំនួន ៦លើក មក ហើយ ក្នុង នោះ នៅ ឆ្នាំ ២០១៥ ធ្វើ នៅ ខេត្ត ក្រចេះ . ឆ្នាំ ២០១៦ ធ្វើ នៅ ខេត្ត ស្ទឹងត្រែង . ឆ្នាំ ២០១៧ ធ្វើ នៅ ខេត្ត កំពង់ចាម និង ខេត្ត ត្បូងឃ្មុំ . ឆ្នាំ ២០១៨ ធ្វើ នៅ ខេត្ត កណ្ដាល . ឆ្នាំ ២០១៩ ធ្វើ នៅ ខេត្ត កំពង់ឆ្នាំង និង ឆ្នាំ ២០២០ ធ្វើ នៅ ខេត្ត បាត់ដំបង ។ ប៉ុន្តែ ដោយសារ ការរីករាលដាល ជំងឺ កូវីដ១៩ រាជ រដ្ឋាភិបាល ក៏ បាន ផ្អាក ការរៀបចំ ព្រឹត្តិការណ៍ ទេសចរណ៍ នេះ អស់ ពេល២ ឆ្នាំ គឺ នៅ ឆ្នាំ ២០២១ និង ឆ្នាំ ២០២២ ។
ក្រសួង ទេសចរណ៍ និង រដ្ឋបាល ខេត្ត កំពង់ធំ នា រសៀល ថ្ងៃទី ៦ ខែមករា ឆ្នាំ ២០២៣ ក៏ បាន ដឹកនាំ កិច្ចប្រជុំ ត្រៀម រៀបចំ ពិធី បុណ្យ ទន្លេ លើក ទី ៧នេះ ក្រោម អធិបតីភាព លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ និង លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ ព្រមទាំង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ មក ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ នៅ សាលា ខេត្ត កំពង់ធំ ។
នា ឱកាស នោះ លោក រដ្ឋមន្ត្រី ថោង ខុន បាន ឱ្យដឹង ថា ជាមួយនឹង ការគ្រប់គ្រង ស្ថានការណ៍ កូវីដ១៩ បាន ល្អ ប្រសើរ ឡើងវិញ រាជ រដ្ឋាភិបាល បាន សម្រេច រៀបចំ ពិធី បុណ្យ ទន្លេ ជា លើក ទី៧ នៅ ខេត្ត កំពង់ធំ ចាប់ពី ថ្ងៃទី ៨ - ១០ ខែមីនា ឆ្នាំ ២០២៣ ខាងមុខ ហើយក៏ អាច បន្ត ដល់ ថ្ងៃទី ១១និង ទី១២ ថែម ទៀត ព្រោះ ចំ ថ្ងៃសៅរ៍ និង ថ្ងៃអាទិត្យ ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា ការរៀបចំ បុណ្យ ទន្លេ នៅ ខេត្ត កំពង់ធំ នេះ ដែរ គឺ ដោយសារ មាន ស្ទឹង សែន ហូរ ឆ្លងកាត់ ចុះ ទៅ បឹង ទន្លេ សាប ពិសេស ខេត្ត កំពង់ធំ នេះ គឺ ស្ថិត នៅ ពាក់កណ្ដាល ផ្លូវ ធ្វើដំណើរ ពី រាជធានី ភ្នំពេញ និង ខេត្ត កំពង ចាម ឆ្លងកាត់ ទៅ ខេត្ត សៀមរាប និង ខេត្ត ព្រះវិហារ ដែល ជា គោលដៅ ទេសចរណ៍ សំខាន់ ៗ ។
លោក បាន សង្កត់ធ្ងន់ ទៀត ថា ត្រូវ រៀបចំ ឱ្យ មាន ការតាំងពិព័រណ៍ ផលិតផល ក្នុង ស្រុក ទាំងឡាយ ដែល បាន ពី ការផលិត របស់ ប្រជាពលរដ្ឋ ក្នុង ស្រុក ។ ចំពោះ ពិព័រណ៍ ផលិតផល ក្នុង ស្រុក នេះ ដែរ លោក ចង់ ជំរុញឱ្យ មាន ផលិតផល សិប្បកម្ម កសិកម្ម យកមក តាំង លក់ ក្នុង ព្រឹត្តិការណ៍ នេះ ឱ្យ បាន ច្រើន បំផុត ដើម្បី ជំរុញ ការនាំចេញ នៅនឹង កន្លែង ។
លោក បាន បន្ថែម ថា ក្រៅពី នេះ ក៏ ត្រូវ បង្ហាញ អំពី សក្ដានុពល វប្បធម៌ តំបន់ ប្រវត្តិសាស្ត្រ ដើម្បី បង្ហាញ ដល់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរ បាន យល់ ថា កម្ពុជា មាន ប្រវត្តិសាស្ត្រ មាន វប្បធម៌ យូរ លង់ មកហើយ « កម្ពុជា ជា ព្រះរាជាណាចក្រ វប្បធម៌ ព្រះរាជាណាចក្រ ទឹក » ។
លោក ប្រធាន នាយកដ្ឋាន បាន បន្ថែម ថា ពិសេស មួយ ទៀត ខេត្ត កំពង់ធំ គឺ នៅ ពាក់កណ្ដាល ផ្លូវ រវាង រាជធានី ភ្នំពេញ ខេត្ត កំពង់ចាម ខេត្ត ត្បូងឃ្មុំ ខេត្ត សៀមរាប ខេត្ត ព្រះវិហារ ដូច្នេះ ភ្ញៀវ ទេសចរ នឹង អាច ចូល លេង បុណ្យ ទន្លេ មុន បន្ត ទៅ លេង ខេត្ត សៀមរាប និង ទៅ គោលដៅ ទេសចរណ៍ ផ្សេង ទៀត ។
លោក បាន បន្ត ទៀត ថា ខេត្ត កំពង់ធំ ក៏ មាន គោលដៅ ទេសចរណ៍ ជាច្រើន ពិសេស គឺ តំបន់ បេតិកភណ្ឌ ប្រាសាទ សំបូរ ព្រៃ គុក ឬ អាច ភ្ជាប់ គោលដៅ ទេសចរណ៍ ទៅដល់ ខេត្ត ព្រះវិហារ និង ប្រាសាទ ព្រះវិហារ ទៀត ដែរ និង គោលដៅ ផ្សេង ទៀត ដូចជា តំបន់ អេកូ ទេសចរណ៍ ក សិទេសចរណ៍ រមណីយដ្ឋាន ទេសចរណ៍ ជាដើម ដែល សុទ្ធតែ ជា សក្ដានុពល សម្រាប់ បម្រើ ដល់ វិស័យ ទេសចរណ៍ ។
ទន្ទឹម នឹង នោះ លោក អភិបាល ខេត្ត ងួន រតនៈ ក៏ បាន ប្ដេជ្ញា សហការរៀបចំ ពិធី បុណ្យ ទន្លេ នេះ ឱ្យ បាន ល្អ ដោយ ហេតុ ថា លោក ក៏ ធ្លាប់ បទពិសោធន៍ សហការរៀបចំ ពិធី បុណ្យ ទន្លេ នៅ ខេត្ត បាត់ដំបង ម្ដង រួចហើយ កាលពី ឆ្នាំ ២០២០ កាល លោក នៅ ជា អភិបាល ខេត្ត បាត់ដំបង មុន ផ្លាស់ មក ខេត្ត កំពង់ធំ នេះ ។
បន្ទាប់ពី បញ្ចប់ កិច្ចប្រជុំ ពិភាក្សា ខាងលើ លោក រដ្ឋមន្ត្រី ថោង ខុន និង លោក ងួន រតនៈ ក៏ បាន ដឹកនាំ ក្រុម មន្ត្រី ចុះ ពិនិត្យ ទីតាំង ជាក់ស្ដែង មួយចំនួន តាម បណ្ដោយ ស្ទឹង សែន ដូចជា ទីតាំង រៀបចំ ឆាក ពិធី ទីតាំង ស្ដង់ ពិព័រណ៍ និង ទីតាំង កម្មវិធី កម្សាន្ត បន្ថែម ទៀត ៕
លោក ចាន់ កុលបុត្រ បាន បន្ត ថា ថ្ងៃ នេះ ជា ទិវា គម្រប់ ខួប លើក ទី ៤៤ នៃ ជ័យជម្នះ ជា ប្រវត្តិសាស្ត្រ របស់ ប្រជាជន កម្ពុជា លើ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត នា ថ្ងៃ ៧ មករា ឆ្នាំ ១៩៧៩ ដែល បាន សង្គ្រោះ ជាតិ ខ្មែរ ឱ្យ រស់រាន មាន ជីវិត ឡើងវិញ ទាន់ ពេលវេលា រួចផុត ពី ទារុណកម្ម និង ការកាប់ សម្លាប់ ដ៏ សាហាវ យង់ឃ្នង បំផុត ដែល ពុំ ធ្លាប់ មាន នៅក្នុង ប្រវត្តិសាស្ត្រ របស់ កម្ពុជា និង របស់ មនុស្សជាតិ ។
លោក បាន បន្ថែម ថា នៅ ឆ្នាំ ២០២៣ នេះ មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ ត្រូវបាន ដំឡើង ប្រាក់ បៀវត្ស មួយ កម្រិត ទៀត ព្រម ជាមួយ នេះ ប្រាក់ សោធន និវត្តន៍ របស់ អតីត មន្ត្រីរាជការ និង អតីត យុទ្ធជន ក៏ ត្រូវបាន កែសម្រួល និង ដំឡើង ផងដែរ . ដោយឡែក ប្រាក់ ឈ្នួល អប្បបរមា របស់ កម្មករ និយោជិត ផ្នែក វាយន ភណ្ឌ កាត់ដេរ ផលិត ស្បែកជើង និង សម្ភារៈ ធ្វើដំណើរ ក៏ ត្រូវបាន ដំឡើង ដល់ ២០០ ដុល្លារ រួមទាំង ការបន្ត ទទួលបាន អត្ថប្រយោជន៍ ផ្សេង ៗ ទៀត ពី ការអនុវត្ត គោល នយោបាយ គាំពារ សង្គម របស់ រាជ រដ្ឋាភិបាល ៕
លោកស្រី ម៉ុន តេស ដែល បច្ចុប្បន្ន មាន អាយុ ៦៥ ឆ្នាំ បាន សារភាព កំហុស ក្នុង ឆ្នាំ ២០០២ ពី បទ សម គំនិត ធ្វើ ចារកម្ម បន្ទាប់ពី ត្រូវ ចោទប្រកាន់ ថា បាន ប្រើប្រាស់ តំណែង ជា មន្ត្រី ទីភ្នាក់ងារ ស៊ើបការណ៍ សម្ងាត់ ការពារ ជាតិ (DIA) ដើម្បី ធ្វើឲ្យ បែក ធ្លាយ ព័ត៌មាន រួមទាំង អត្តសញ្ញាណ របស់ ចារ បុរស អាមេរិក មួយចំនួន ទៅឲ្យ ទីក្រុង ឡាហា វ៉ាន (Havana) ។ កាលពី អាយុ ៤៥ ឆ្នាំ លោកស្រី ត្រូវបាន កាត់ទោស ឱ្យ ជាប់ ពន្ធនាគារ រយៈពេល ២៥ ឆ្នាំ ។
ក្នុង នាម ជា ពលរដ្ឋ អាមេរិក ដែល មាន ដើមកំណើត ព័រ តូរីកា លោកស្រី ម៉ុន តេស បាន ចាប់ផ្តើម ធ្វើ ការ ឲ្យ ស្ថាប័ន DIA ក្នុង ឆ្នាំ ១៩៨៥ ហើយ បាន ឡើង ឋានៈ យ៉ាង ឆាប់រហ័ស ដើម្បី ក្លាយជា អ្នកវិភាគ កំពូល របស់ ទីភ្នាក់ងារ គុយ បា ។
គួរ បញ្ជាក់ ថា ក្រោម ការដឹកនាំ របស់ លោក ប្រធានាធិបតី ចូ បៃ ដិន សហរដ្ឋ អាមេរិក បាន បន្ធូរបន្ថយ ទណ្ឌកម្ម មួយ ចំនួន លើ ប្រទេស គុយ បា ប៉ុន្តែ បាន រក្សា ការហាមឃាត់ ក្នុង សម័យ សង្គ្រាម ត្រជាក់ របស់ ខ្លួន និង បង្កើន ការរឹតបន្តឹង លើ ជន ចំណាកស្រុក ខុស ច្បាប់ ៕
គួរ បញ្ជាក់ ថា វិមាន ក្រឹមឡាំង បាន ប្រកាស បទ ឈប់ បាញ់ រយៈពេល ៣៦ ម៉ោង បើ ទោះបីជា ទីក្រុង កៀវ បាន និយាយ ថា ខ្លួន នឹង មិន អនុវត្ត តាម សកម្មភាព ឯកតោ ភាគី ដែល ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី ពិពណ៌នា ថា ជា ការប៉ុនប៉ង របស់ ពូទីន ក្នុង ការពន្យឺត ការជឿនលឿន របស់ កងកម្លាំង អ៊ុយក្រែន និង បង្កើត ឱកាស សម្រាប់ រុស្ស៊ី ក្នុង ការបំពេញ បន្ថែម កងកម្លាំង របស់ ខ្លួន ៕
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៧ ខែមក រា៖ បង្ក្រាប ១២ករណី ឃាត់ខ្លួន ៣២ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ដឹកជញ្ជូន រក្សាទុក ៤ករណី និង ជួញដូរ ៣ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣២ នាក់ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៤១៣ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១.៩៧៩ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១.៧៤៦ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២៣៣ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្លាកលេខ បត់ ជែង ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ខ្សែក្រវាត់ ឆៀក ល្បឿន អត់ ប័ណ្ណ បើកបរ លើស ចំណុះ ស្រវឹង ទូរស័ព្ទ និង ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៧ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៣ នាក់ របួស ចំនួន ១០នាក់ ( របួស ធ្ងន់ ចំនួន ០៨ នាក់ ) ។ រយៈពេល ០៧ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៦៤ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៣៨ នាក់ របួស ៧០ នាក់ ( របួស ធ្ងន់ ៥១ នាក់ )៕
សូម រីករាយ ទស្សនា ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ដែល បង្ហាញ ប្រវត្តិ ជីវិត ពិត របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត
( ភ្នំពេញ ) ៖ ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ដែល បង្ហាញ ប្រវត្តិ ជីវិត ពិត ដ៏ សោកសៅ និង ខ្លោចផ្សារ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ត្រូវបាន សម្ពោធ ចាក់បញ្ចាំង នៅ ល្ងាច ថ្ងៃសៅរ៍ ទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ នៅ សាល ចតុមុខ រាជធានី ភ្នំពេញ ។
សូម ទស្សនា ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ទាំងស្រុង ដូចតទៅ៖ រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ ផ្តល់ រង្វាន់ ម៉ូតូ១ គ្រឿង ដល់ សិស្ស ប្រឡង់ ជាប់ និទ្ទេស A ម្នាក់ ក្នុង ស្រុក កោះ សូទិន
( កំពង់ចាម ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន និង ភរិយា បាន ប្រគល់ រង្វាន់ ម៉ូតូ ម៉ាក WAVE ស៊េរី ថ្មី ១គ្រឿង ជា រង្វាន់ លើកទឹកចិត្ត ដល់ សិស្ស ហយ ស្រី នាង រៀន នៅ វិទ្យាល័យ ជីហែ ស្រុក កោះ សូទិន ខេត្ត កំពង់ចាម ដែល សិស្ស ម្នាក់ គត់ ក្នុង ស្រុក ប្រឡង ជាប់ និទ្ទេស A ។
នា ឱកាស នោះ ដែរ លោក បាន សម្តែង នូវ ការរីករាយ និង អបអរសាទរ ចំពោះ ក្មួយ ស្រី ដែល ជាប់ និទ្ទេស A តែ ម្នាក់ គត់ ក្នុង ស្រុក កោះ សូទិន ហើយ ជាមួយ នេះ បាន ជំរុញ លើកទឹកចិត្ត ដល់ ក្មួយ ៗ សិស្សា និសិស្ស ទាំងអស់ ត្រូវ ប្រឹងប្រែង សិក្សា រៀនសូត្រ ឱ្យ បាន ពូកែ ហើយក៏ ត្រូវ យល់ ថា បើ ចង់ ចេញ ពី ភាពក្រីក្រ គឺ ត្រូវ ប្រឹង រៀន យក ចំណេះ ដើម្បី ឆ្ពោះទៅ អនាគត ល្អ អាច ជួយ គ្រួសារ និង សហគមន៍ ខ្លួន មាន ការរីកចម្រើន ។
នៅក្នុង ឱកាស នៃ ពិធី បុណ្យ ឆ្លង នេះ ដែរ លោក ខៀវ កាញារីទ្ធ និង លោកស្រី រួម ជាមួយ ថ្នាក់ដឹកនាំ មន្រ្តី ក្រោម ឱវាទ ក្រសួង ព័ត៌មាន បាន រួមគ្នា ចូល ជា បច្ច័យ សរុប បាន ចំនួន ៤៥ លាន រៀល សម្រាប់ ចូលរួម កសាង សមិទ្ធផល ក្នុង វត្ត មហា លាភ ។
យុវសិស្ស ហយ ស្រី នាង អាយុ ១៨ ឆ្នាំ មាន ទីលំនៅ ឃុំ មហា លាភ ស្រុក កោះ សូទិន ខេត្ត កំពង់ចាម គឺជា សិស្ស តែ ម្នាក់ គត់ ក្នុង ស្រុក កោះ សូទិន ដែល ប្រឡង ជាប់ បាក់ឌុប និទ្ទេស A នា ឆ្នាំ សិក្សា ២០២២ កន្លងមក នេះ ។
ដោយ ពិនិត្យ ឃើញ គ្រួសារ របស់ យុវសិស្ស ហយ ស្រី នាង មាន ជីវភាព ខ្វះខាត លោក រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ និង លោកស្រី បាន បាន ផ្តល់ ជូន នូវ ថវិកា ចំនួន ២០០ ដុល្លារ ផងដែរ ។
គួរ រំលឹក ដែរ ថា កាលពី ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២២ លោក ខៀវ កាញារីទ្ធ និង លោកស្រី បាន ប្រគល់ រង្វាន់ ម៉ូតូ លើកទឹកចិត្ត ជូន ដល់ សិស្ស ដែល បាន ប្រលង ជាប់ សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ និទ្ទេស A ចំនួន ០៨ រូប នៅក្នុង ស្រុក កោះ សូទិន ខេត្ត កំពង់ចាម ។
វត្ត មហា លាភ ស្ថិត នៅ ភូមិ មហា លាភ ជើង ឃុំ មហា លាភ ស្រុក កោះ សូទិន ខេត្ត កំពង់ចាម បាន កសាងឡើង នៅ ឆ្នាំ ១៨៨០ មាន ព្រះវិហារ បុរាណ ដែល ជា កេរ្ដិ៍ ដំណែល ពី ដូន តាមក បាន ឆ្លងកាត់ ព្រះចៅ អធិការ វត្ត ជាច្រើន អង្គ ហើយ បច្ចុប្បន្ន ត្រូវបាន រៀបចំ កសាងឡើងវិញ ដោយ ព្រះចៅ អធិការ វត្ត ព្រះនាម ឃីម ស្រស់ ដែល បាន ដឹកនាំ ជួសជុល និង សាងសង់ មាន ភាពរីកចំរើន ជា បន្តបន្ទាប់ ។
សរុប ថវិកា ចំណាយ ទាំងអស់ ១៤៣.៥០០ ដុល្លារ និង ៤១៥. ៩៥៥.០០ រៀល ទឹកប្រាក់ ទាំងអស់ នេះ បាន មកពី ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ជិត ឆ្ងាយ ដូចជា បុណ្យ ក ឋិន ទាន បុណ្យ ចូល ឆ្នាំ បុណ្យ ភ្ជុំ បុណ្យ ផ្កា ប្រាក់ និង បុណ្យ ផ្សេង ៗ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង ឧត្តមសេនីយ៍ ឯក ដួង ហេង ជា អនុ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ បន្ថែម លើ មុខងារ បច្ចុប្បន្ន
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង មុខ តំណែង លោក ឧត្តមសេនីយ៍ ឯក ដួង ហេង ជា អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង ការពារ ជាតិ បន្ថែម លើ មុខងារ បច្ចុប្បន្ន ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ ។
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ លោក ឧត្តមសេនីយ៍ ឯក ដួង ហេង មាន តួនាទី ជា មេបញ្ជាការ រង កង អង្គរក្ស ផងដែរ ៕
វា គឺជា កញ្ចប់ ជំនួយ យោធា ធំ បំផុត របស់ ទីក្រុង វ៉ាស៉ីនតោន សម្រាប់ ទីក្រុង កៀវ គិត មកទល់ ពេលនេះ ។ ក្នុង នោះ ថវិកា ២. ៨៥ពាន់ លាន ដុល្លារ គឺជា សព្វាវុធ ដែល ត្រូវ ដក ចេញ ពី ក្នុង ស្តុក របស់ មន្ទីរ បញ្ចកោណ ហើយ នឹង ត្រូវ បញ្ជូន ទៅកាន់ អ៊ុយក្រែន ផ្ទាល់ តែ ម្តង ដោយ មិន ចាំបាច់ មាន ការអនុញ្ញាត ពី សភា អាមេរិក ឡើយ ។ ដោយឡែក ថវិកា ២២៥ លាន ដុល្លារ ទៀត នឹង ត្រូវ ផ្តល់ នៅក្រោម កម្មវិធី ហិរញ្ញប្បទាន យោធា បរទេស ដើម្បី ជួយ កសាង សមត្ថភាព រយៈពេល វែង និង គាំទ្រ ដល់ ការធ្វើ ទំនើបកម្ម របស់ យោធា អ៊ុយក្រែន ។
កញ្ចប់ ជំនួយ យោធា ខាងលើ ក៏ រួមបញ្ចូល នូវ ការផ្តល់ ហិរញ្ញប្បទាន ផ្នែក យោធា ក្នុង ថវិកា ៦៨២ លាន ដុល្លារ សម្រាប់ សម្ព័ន្ធមិត្ត នៅ អឺរ៉ុប ផងដែរ ដើម្បី ជំនួស បរិក្ខារ យោធា និង សព្វាវុធ ដែល ពួកគេ បាន ជួយ បរិច្ចាគ ឱ្យ ទៅ អ៊ុយក្រែន ក៏ ដូចជា ដើម្បី ជំរុញ ឱ្យ មាន ការបរិច្ចាគ បន្ថែម ទៀត ។
( ភ្នំពេញ ) ៖ ក្រោម គំនិត ផ្តួចផ្តើម របស់ លោក កើត រិទ្ធ រដ្ឋមន្ដ្រី ក្រសួង យុត្តិធម៌ នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២២ នេះ ក្រសួង យុត្តិធម៌ បាន រៀបចំ កម្មវិធី បរិច្ចាគ ឈាម ដោយ ស្ម័គ្រចិត្ត ប្រចាំ ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ « ផ្តល់ ឈាម ផ្តល់ ក្តីសង្ឃឹម » ដើម្បី ចូលរួម អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ទិវា ជ័យជម្នះ លើ របប ប្រល័យ ពូជសាសន៍ ៧ មករា និង ដើម្បី ចូលរួមចំណែក ក្នុង សកម្មភាព សង្គម និង មនុស្សធម៌ ។
កម្មវិធី បរិច្ចាគ ឈាម ដោយ ស្ម័គ្រចិត្ត នេះ ត្រូវបាន រៀបចំឡើង ក្រោម កិច្ចសហការ រវាង ក្រសួង យុត្តិធម៌ ជាមួយ ស .ស .យ .ក . វិស័យ យុត្តិធម៌ . មជ្ឈមណ្ឌល ជាតិ ផ្តល់ ឈាម និង ក្លឹប សេនា យុត្តិធម៌ ព្រមទាំង មាន ការចូលរួម បរិច្ចាគ ឈាម ដោយ ស្ម័គ្រចិត្ត ពីសំណាក់ ថ្នាក់ដឹកនាំ ទីប្រឹក្សា ជំនួយការ និង មន្ត្រីរាជការ នៃ ក្រសួង យុត្តិធម៌ ព្រមទាំង សិស្ស នៃ រាជ បណ្ឌិត សភា វិជ្ជាជីវៈ តុលាការ និង អ្នកវិជ្ជាជីវៈ ក្នុង វិស័យ យុត្តិធម៌ ដែល មាន ចំនួន សរុប ប្រមាណ ជាង ៣០០ នាក់ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ បាន លើកឡើង ថា « ការបរិច្ចាគ ឈាម នេះ ធ្វើឡើង ក្នុង គោលបំណង តែ មួយ គត់ គឺ ជួយសង្គ្រោះ អាយុជីវិត មនុស្ស ។ តម្រូវការ ឈាម គឺជា តម្រូវ ការចាំបាច់ ជាក់ស្តែង នៅ ចំពោះមុខ ដោយ ហេតុ ថា មាន អ្នកជំងឺ ជាច្រើន ដែល សម្រាក ព្យាបាល នៅ តាម មន្ទីរពេទ្យ ហើយ កំពុង ត្រូវការ ឈាម ដើម្បី សង្គ្រោះ អាយុជីវិត របស់ ពួកគេ » ។
រដ្ឋមន្ត្រី បាន លើកឡើង ទៀត ថា រហូតមកដល់ ពេលនេះ ទោះបីជា បច្ចេកវិទ្យា ផ្នែក សុខាភិបាល មាន ការរីកចម្រើន យ៉ាងណា ក៏ដោយ ប៉ុន្តែ មិន មាន ប្រទេស ជឿនលឿន ណាមួយ ដែល អាច ផលិត ឈាម សិប្បនិម្មិត បាន ឡើយ ពោលគឺ ឈាម ត្រូវបាន ផលិត ដោយ សរីរាង្គ មនុស្ស ខ្លួន ឯង តែ ប៉ុណ្ណោះ ដូចនេះ ប្រសិនបើ មិន មាន ការបរិច្ចាគ ឈាម ទេ នោះ គឺ មិន មាន ឈាម សម្រាប់ យក ទៅ ជួយសង្គ្រោះ អាយុជីវិត អ្នក ដែល កំពុង ត្រូវការ ឈាម នោះ ឡើយ ។
ផ្សាភ្ជាប់ ទៅនឹង ការជ្រើសរើសយក ថ្ងៃទី ៧ ខែមករា សម្រាប់ រៀបចំ កម្មវិធី បរិច្ចាគ ឈាម ដោយ ស្ម័គ្រចិត្ត នេះ ផងដែរ លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា « ថ្ងៃ ៧មករា គឺជា ថ្ងៃ ប្រកបដោយ អត្ថន័យ ជា ប្រវត្តិសាស្រ្ត របស់ ប្រជាជន កម្ពុជា និង ជា ថ្ងៃ ដែល ប្រជាពលរដ្ឋ ខ្មែរ ទាំងមូល ចាត់ទុក ថា ជា ថ្ងៃ កំណើត ទី២ របស់ ខ្លួន »៕ អភិបាល ខេត្ត ក្រចេះ ជួប សំណេះសំណាល ជាមួយនិវត្ត ជន បុគ្គលិក និង មន្ដ្រីរាជការ នៃ មន្ទីរ សុខាភិបាល
( ក្រចេះ ) ៖ លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ និង ភរិយា នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ អញ្ជើញ ជួប សំណេះសំណាល ជាមួយនិវត្ត ជន បុគ្គលិក មន្រ្តី រាជការ នៅ មន្ទីរ សុខាភិបាល ខេត្ត ក្រចេះ ។
លោក អភិបាល ខេត្ត បន្ត ទៀត ថា ដើម្បី ថ្លែងអំណរគុណ ពី ការយកចិត្តទុកដាក់ របស់ មន្រ្តី រាជការ បុគ្គលិក និង និវត្ត ជន នៃ មន្ទីរ សុខាភិបាល និង រដ្ឋបាល ខេត្ត ដែល កន្លងទៅ បាន ខិតខំ ប្រឹងប្រែង បំពេញ ការងារ និង ការបម្រើ សេវា ជូន ប្រជាពលរដ្ឋ បាន ល្អ ប្រសើរ ជាពិសេស ក្នុង ដំណាក់កាល នៃ ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ រហូត សម្រេចបាន ការបើក ដំណើរការ សកម្មភាព សេដ្ឋកិច្ច សង្គម ក្នុង ខេត្ត ឡើងវិញ ។
តាម របាយការណ៍ បញ្ជាក់ ពី លោក ងី ប៊ុន ឡែន ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ថា មន្ទីរ សុខាភិបាល មាន ការិយាល័យ សុខាភិបាល ស្រុក ប្រតិបត្តិ ចំនួន ៣. មន្ទីរពេទ្យ បង្អែក ចំនួន ៥. មណ្ឌល សុខភាព ចំនួន ៣៩ និង ប៉ុស្តិ៍ សុខភាព ចំនួន ១៣ ។
មន្ត្រីរាជការ កំពុង បម្រើ ការងារ សរុប ចំនួន ៩៦០ នាក់ ក្នុង នោះ មន្ត្រី ជាប់ កិច្ចសន្យា ចំនួន ១១៦ នាក់ . វេជ្ជបណ្ឌិត ឯកទេស ចំនួន ១នាក់ . វេជ្ជបណ្ឌិត ជំនាញ ចំនួន ២នាក់ . វេជ្ជបណ្ឌិត ចំនួន ៤០ នាក់ . គ្រូពេទ្យ មធ្យម ចំនួន ១៧នាក់ . ឱសថការី ឧត្តម ចំនួន ១២នាក់ . ឱសថការី មធ្យម ចំនួន ១នាក់ . ទន្ត បណ្ឌិត ចំនួន ១នាក់ . ទន្ត ពេទ្យ ចំនួន ១នាក់ . ទន្ត គិលានុបដ្ឋាក ចំនួន ៦នាក់ . វិទ្យុសាស្ដ្រ ចំនួន ១នាក់ និង ព្យាបាល ដោយ ចលនា ចំនួន ៣នាក់ ។
សូម បញ្ជាក់ ថា នៅក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត និង លោកស្រី ក៏ បាន ផ្តល់ នូវ អំណោយ ជូន និវត្ត ជន ក្នុង ម្នាក់ ទទួលបាន សារ៉ុង១ និង ថវិកា ១០ ម៉ឹន រៀល ផងដែរ ៕ ទេសរដ្ឋមន្រ្តី លី ធុជ អញ្ជើញ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ថ្ងៃ ជ័យជម្នះ ៧ មករា
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន សម្តែង នូវ ការដឹង គុណ និង កត្តញ្ញូតា ធម៌ ដ៏ ជ្រាលជ្រៅ ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ ដូចជា ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ ដែល បាន ពលៈ សាច់ ស្រស់ ឈាម ស្រស់ និង យក ជីវិត ធ្វើ ដើមទុន ក្នុង ការរំដោះ ប្រទេសជាតិ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ដ៏ សែន ឃោឃៅ ព្រមទាំង បាន ផ្តល់ នូវ កំណើត ទី២ ជូន ដល់ ប្រជាជន កម្ពុជា កម្ពុជា ទាំងមូល ។
លោក ទេសរដ្ឋមន្រ្តី បាន បន្ត ទៀត ថា ជ័យជម្នះ ៧មករា គឹជា មហា ជោគជ័យ ដ៏ ឧត្តុង្គឧត្តម របស់ គណបក្ស ប្រជាជន កម្ពុជា និង ក៏ ជា ដំណើរ ចាប់ផ្តើម បង្កើត ឲ្យ មាន នយោបាយ ឈ្នះ ឈ្នះ នាំមក នូវ សុខ សន្តិភាព ពេញលេញ ទូទាំង ប្រទេស កម្ពុជា ជាពិសេស ការចាប់ផ្តើម អភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ពី ចំណុច សូន្យ រហូតដល់ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដូច សព្វ ថ្ងៃ ក៏ ដូចជា បាន ធ្វើឲ្យ កម្ពុជា ឈរ ស្មើ មុខ ស្មើ មាត់ ជាមួយ បណ្តា ប្រទេស ជុំវិញ ពិភពលោក ។
លោក ទេសរដ្ឋមន្រ្តី បាន រំលឹក បន្ថែម ទៀត ថា យើង ទាំងអស់ គ្នា ជា ប្រជាពលរដ្ឋ ខ្មែរ ត្រូវតែ ចងចាំ និង ដឹងគុណ ជាប់ ជានិច្ច នូវ គុណ តម្លៃ ៧មករា និង គុណ តម្លៃ សន្តិភាព ដែល ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា បាន ខិតខំ ស្វែងរក យ៉ាង លំបាក ដើម្បី ភាពសុខដុមរមនា របស់ ប្រជាជន កម្ពុជា ទូទាំង ប្រទេស ។ យើង ទាំងអស់ គ្នា ត្រូវ ប្រឆាំង ដាច់ខាត ចំពោះ ពួក អមិត្ត ទាំងឡាយ ណា ដែល តែងតែ មាន បំណង ចង់ បំផ្លាញ នូវ សុខ សន្តិភាព និង ផ្តួលរំលំ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល កើត ចេញ ពី ប្រជាជន និង ដើម្បី ប្រជាជន ។
( សៀមរាប ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត សៀមរាប នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ខួប លើក ទី៤៤ នៃ ទិវា ជ័យ ជំនះ ៧មករា នៅ ខេត្ត សៀមរាប ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក អ៊ាន ឃុន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក ទៀ សីហា អភិបាល ខេត្ត និង លោក លោកស្រី សមាជិក ក្រុមប្រឹក្សា ខេត្ត លោក លោកស្រី អភិបាល រង ខេត្ត និង មន្ត្រីរាជការ ជុំវិញ ខេត្ត ព្រមទាំង ប្រជាពលរដ្ឋ និង សិស្សានុសិស្ស ជាច្រើន ចូលរួម ផងដែរ ។
ថ្លែង ក្នុង កិច្ច ស្វាគមន៍ លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប បាន លើកឡើង ថា ការប្រារព្ធ កម្មវិធី នៅ ថ្ងៃ នេះ គឺ ដើម្បី សម្ដែង នូវ មនោសញ្ជេតនា និង ការដឹង គុណ និង អបអរសាទរ ខួប លើក ទី៤៤ នៃ ទីវា ជ័យ ជំនះ ៧មករា ដែល ជា ថ្ងៃ កំណើត ទី២ របស់ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ រូប ។
លោក ទៀ សីហា បាន បន្ត ខួប លើក ទី៤៤ នៃ ទីវា ជ័យ ជំនះ ៧មករា នៅ ឆ្នាំ នេះ បាន ប្រារព្ធកម្ម ឡើង ក្នុង ស្ថានភាព ដែល កម្ពុជា កំពុង ស្ថិត លើ មាគ៌ា អភិវឌ្ឍន៍ យ៉ាង ល្អ ប្រសើរ លើ គ្រប់ វិស័យ ហើយ កំពុង បន្ត អនុវត្តន៍ កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់ការ ទី៤ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៦ នៃ រដ្ឋសភា ក្នុង គោលដៅ អភិវឌ្ឍ ប្រទេស ជាតិ លើ គ្រប់ វិស័យ ឲ្យ កាន់តែ រីកចម្រើន ខ្លាំងក្លា ថែម ទៀត ដើម្បី ធានា ដល់ ការលើកកម្ពស់ ក្នុង គោលដៅ រស់ នៅ របស់ ប្រជាពលរដ្ឋ និង លិទ្ធ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ។
បន្ទាប់ពី អាន សារ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា . សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន លើកឡើង ថា នេះ ជា លើក ទី៤៤ ដែល បាន បាន ប្រារព្ធ ពិធី នេះ ជារៀងរាល់ ឆ្នាំ ប៉ុន្តែ ដោយសារ មាន ការរំខាន ពី ជំងឺ កូវីដ១៩ មាន ការខកខាន ខ្លះ ទោះជា យ៉ាងណា ក៏ដោយ ស្មារតី ៧មករា នៅ ដក់ ជាប់ ជានិច្ច ដល់ យើង ទាំងអស់ គ្នា ។
សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ បាន អះអាង ថា ថ្ងៃ ៧មករា ធ្វើឲ្យ យើង រស់ ឡើងវិញ ហើយក៏ ជា ថ្ងៃ កំណើត ទី២ របស់ យើង និង ត្រូវ ចង់ចាំ ជានិច្ច ព្រមទាំង អរគុណ សន្តិភាព ដែល ឲ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ផងដែរ ។
បន្ថែម ពី នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ បាន សម្តែង នូវ ការអរគុណ ចំពោះ ជន រួម ជាតិ ទាំង ក្នុង ប្រទេស និង ក្រៅ ទេស ដល់ ការគាំទ្រ និង ជឿជាក់ លើក ការដឹកនាំ របស់ គណបក្ស ប្រជាជន រយៈពេល ជាង ៤០ ឆ្នាំ មក នេះ ។ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ បាន ជំរុញ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដូស ទី៦ ឲ្យបាន គ្រប់ ៗ គ្នា ស្រប តាម ការអំពាវនាវ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ផងដែរ ។
លោក នួន ពុទ្ធារ៉ា បាន ប្តេជ្ញា ការពារ រាល់ សង្គមជាតិ ដែល បាន កសាង តាំងពី ថ្ងៃ រំដោះ ៧មក រា ១៩៧៩ រហូតដល់ បច្ចុប្បន្ន នឹង ទៅ អនាគត់ ប្ដេជ្ញា ការពារ ដាច់ខាត រដ្ឋធម្មនុញ្ញ ពង្រឹង សន្តិភាព ស្ថេរភាព នយោបាយ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ កម្ចាត់ នយោបាយ ជ្រុលនិយម ការពារ សន្តិសុខ ជូន ប្រជាជន ប្ដេជ្ញា ពង្រឹង សាមគ្គីភាព ឯកភាព ជាតិ ទាំងមូល យក កម្លាំង កាយ កម្លាំងចិត្ត ចូលរួម អនុវត្ត យ៉ាង សកម្ម ក្មុង កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល ។
លោក បាន ប្ដេជ្ញា ដណ្ដើម ជ័យ ជំនះ ក្នុង ការបោះឆ្នោត នីតិកាល ទី៧ នៅ ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្ត ដា ឆ្នាំ ២០២៣ ឲ្យបាន ជាដាច់ខាត ប្ដេជ្ញា លើកកម្ពស់ ស្មារតី ស្នេហាជាតិ ការពារ ប្រឆាំង ការជ្រៀត ជ្រែក ពី ខាងក្រៅ លើ គ្រប់ រូបភាព ប្តេជា បន្ត អនុវត្ត គោល នយោបាយ អភិវឌ្ឍ សេដ្ឋកិច្វ សង្គម ដើម្បី លើកកម្ពស់ ជីវភាព ប្រជាជន និង ប្តេជា គាំទ្រ សម្ដេច ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី សម្រាប់ នីតិកាល ទី៧ និង លោក ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី នា ពេល អនាគត ៕
សូម ជម្រាប ថា ថ្ងៃ ជ័យ ជំនះ ៧ មករា ជា មហា ជោគជ័យ ដ៏ ឧត្តុងឧត្តម របស់ គណបក្ស ប្រជាជន កម្ពុជា លើ របប អាវ ខ្មៅ ប៉ុល ពត និង ជា កំណើត ទី២ ដែល មិន អាច បំភ្លេច បាន របស់ ប្រជាជន កម្ពុជា គ្រប់ ៗ រូប ៕
ផ្លូវ ក្រាល គ្រួស ក្រហម ១ខ្សែ ត្រូវ បើក ការដ្ឋាន ជួសជុល ឡើងវិញ . អភិបាល ស្រុក ចុង កាល់ អំពាវនាវ ពលរដ្ឋ ចូលរួម គាំទ្រ កម្មវិធី គោល នយោបាយ នានា របស់ រដ្ឋាភិបាល ដើម្បីឱ្យ ប្រទេស កាន់តែ មាន ការអភិវឌ្ឍ
( ឧត្តរមានជ័យ ) ៖ រដ្ឋបាល ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ បាន បើក ការដ្ឋាន ជួសជុល ផ្លូវ ក្រាល គ្រួស ក្រហម ១ខ្សែ មាន ប្រវែង១.២៥៦ ម៉ែត្រ និង ដាក់ លូកាត់ ផ្លូវ ស្ថិត នៅ ភូមិ គោក ត្រាង ឃុំ ជើង ទៀន ស្រុក ចុង កាល់ ដែល ជា គម្រោង របស់ មូលនិធិ ឃុំ ឆ្នាំ ២០២២ ។
ពិធី នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ០៦ ខែមករា ឆ្នាំ ២០២៣ ម្សិលមិញ ក្រោម វត្តមាន លោក រិទ្ធី ប៉ាក់ អភិបាល ស្រុក ចុង កាល់ ព្រមទាំង មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ មួយចំនួន ផងដែរ ។
នា ឱកាស នោះ លោក អភិបាល ស្រុក បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ បន្ត ចូលរួម គាំទ្រ ពេញ ទំហឹង តាម កម្មវិធី គោល នយោបាយ នានា របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ដើម្បីឱ្យ ប្រទេសជាតិ យើង កាន់តែ មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ជឿនលឿន ថែម ទៀត ។
លោក អភិបាល ស្រុក ចុង កាល់ បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ លោក ស៊ី ប្រា សិទ្ធ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ទេសរដ្ឋមន្ត្រី កិត្តិសង្គហ បណ្ឌិត គន់ គីម ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ឧត្តរមានជ័យ ដែល ជានិច្ច ជាកាល តែង បាន គិតគូរ យកចិត្តទុកដាក់ ជាប្រចាំ ចំពោះ សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ស្រុក ចុង កាល់ និយាយ ដោយឡែក ប្រជាពលរដ្ឋ ភូមិ គោក ត្រាង ឃុំ ជើង ទៀន របស់ យើង ។
លោក រិទ្ធី ប៉ាក់ បាន បញ្ជាក់ ថា ការបើក ការដ្ឋាន ជួសជុល ផ្លូវ ក្រាល គ្រួស១ ខ្សែ នា ពេលនេះ គឺជា គម្រោង មូលនិធិ ឃុំ ឆ្នាំ ២០២២ ។
( ត្បូងឃ្មុំ ) ៖ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង ជា ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ខេត្ត នា រសៀល ថ្ងៃទី ៦ ខែមករា ឆ្នាំ ២០២៣ បាន ជួប សំណេះសំណាល និង ប្រគល់ ថវិកា របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជូន ដល់ ក្រុមការងារ គណបក្ស ឃុំ - សង្កាត់ ទាំង ៦៤ និង សកម្មជន យុវជន សាខា បក្ស ភូមិ ទាំង ៨៧៣ ភូមិ នៅ ទូទាំង ខេត្ត នៅ មន្ទីរ គណបក្ស ខេត្ត ត្បូងឃ្មុំ ស្ថិត នៅ ភូមិ និគម លើ ឃុំ ស្រឡប់ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
នា ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន ឱ្យដឹង ថា គោលការណ៍ និង គោល នយោបាយ របស់ គណបក្ស គឺ ពង្រឹង រចនាសម្ព័ន្ធ គណបក្ស រចនាសម្ព័ន្ធ ក្បាល ម៉ាស៊ីន យុវជន គណបក្ស នយោបាយ សតិអារម្មណ៍ របស់ មហាជន និង ប្រជាជន ក្នុង ស្ថានការណ៍ ត្រៀម បោះឆ្នោត នា ពេល ខាងមុខ និង ការអនុវត្តន៍ ផែនការ ឆ្ពោះ ទៅ រក ការបោះឆ្នោត ជ្រើសតាំង រដ្ឋសភា នីតិកាល ទី៧ នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ខេត្ត បាន ផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ជាពិសេស លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ប្រធាន យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ដែល តែងតែ យកចិត្តទុកដាក់ ដល់ យុវជន ដែល ជា ទំពាំង ស្នង ឬស្សី សម្រាប់ ប្រទេសជាតិ ។
លោក ជា ម ច័ន្ទ សោភ័ណ ក៏ បាន កោតសរសើរ ដល់ យុវជន ទាំងអស់ ដែល កន្លងមក បាន ខិតខំ អនុវត្តន៍ ការងារ តាម គោល មាគ៌ា នយោបាយ របស់ គណបក្ស សកម្ម ចូលរួម កការងារ សង្គម ដែល ធ្វើឱ្យ គណបក្ស ប្រជាជន កម្ពុជា គ្រប់ ថ្នាក់ គ្រប់ ផ្នែក ទទួលយក និង កោតសរសើរ និង សូម ឱ្យ យុវជន ទាំងអស់ បន្ត ខិតខំ រៀនសូត្រ ពង្រឹង នូវ សតិអារម្មណ៍ និង សមត្ថភាព ការងារ ចំណេះដឹង ដើម្បីឱ្យ ក្លាយជា ធនធាន មនុស្ស ដ៏ សំខាន់ សម្រាប់ កសាង ប្រទេសជាតិ ៕
UPDATE: នគរបាល ចរាចរណ៍ ខេត្ត តាកែវ គោលដៅ ផ្លូវ ជាតិ លេខ ៣ ស្រុក ត្រាំ កក់ ត្រូវ ដក បញ្ឈរ ជើង ដើម្បី ស៉ើប អង្កេត ក្រោយ រង ការរិះគន់ ពាក់ព័ន្ធ ការផាកពិន័យ និង ឈានដល់ ប្រើ អំពើហិង្សា លើ បុរស ជនជាតិ ចិន
( តាកែវ )៖ កម្លាំង ការិយាល័យ នគរបាល ចរាចរណ៍ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ គោលដៅ ផ្លូវ ជាតិ លេខ ៣ ស្ថិត ក្នុង ស្រុក ត្រាំ កក់ ត្រូវបាន ដក បញ្ឈរ ជើង ទាំងអស់ ដើម្បី ធ្វើ ការស្រាវជ្រាវ ស៉ើប អង្កេត បន្ទាប់ពី រង ការរិះគន់ ពាក់ព័ន្ធ ការចាប់ អ្នកធ្វើដំណើរ ជា ជនជាតិ បរទេស ផាក ពិន័យ លើស ច្បាប់ កំណត់ និង ឈានដល់ ការប្រើប្រាស់ អំពើហិង្សា រហូត ត្រូវបាន គេ ចែកចាយ ពេញ បណ្ដាញ សង្គម ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ រសៀល ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ លោក ឧត្តមសេនីយ៍ ត្រី ឆឹង រតនៈ ស្នងការ រង នគរបាល ខេត្ត តាកែវ បាន បញ្ជាក់ ថា មន្ដ្រី នគរបាល គោលដៅ ផ្លូវ ជាតិ លេខ ៣ ស្ថិត ក្នុង ស្រុក ត្រាំ កក់ បច្ចុប្បន្ន ការិយាល័យ ជំនាញ បាន កំពុង ធ្វើ ការសួរនាំ បន្ថែម និង បញ្ឈរ ជើង ជា បណ្ដោះអាសន្ន រង់ចាំ លទ្ធផល នៃ ការស៉ើប អង្កេត ជាក់លាក់ ដើម្បី មាន មូលដ្ឋាន រាយការណ៍ ជូន ថ្នាក់ដឹកនាំ និង មាន វិធានការ ឬ អនុវត្ត វិន័យ កងកម្លាំង ។
លោក ឧត្តមសេនីយ៍ ត្រី ឆឹង រតនៈ បាន អះអាង ថា ឆ្លងកាត់ ករណី នេះ ថ្នាក់ដឹកនាំ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ បាន សម្រេច បញ្ឈប់ ឲ្យ មាន គោលដៅ អនុវត្ត ច្បាប់ នៅ កន្លែង នេះ បន្ដ ទៀត ដើម្បី ជៀសវាង ការថ្នាំង ថ្នាក់ ជាមួយ ប្រជាពលរដ្ឋ ។
សូម រំលឹក ថា ជនជាតិ ចិន ម្នាក់ ទំនងជា អ្នករក ស៉ី វិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា បាន បង្ហោះ សារ រិះគន់ យ៉ាង ចាស់ ដៃ លើ មន្ដ្រី នគរបាល ចរាចរណ៍ នៅ ផ្លូវ ជាតិ លេខ៣ គីឡូម៉ែត្រ លេខ ៦៨ ស្ថិត ក្នុង ស្រុក ត្រាំ កក់ ខេត្ត តាកែវ ( គីឡូម៉ែត្រ លេខ ៦៨ ) ដែល មុនដំបូង ផាក ពិន័យ រហូតដល់ ១០០ ដុល្លារ ដោយ ចោទប្រកាន់ ថា បើក រលើស ល្បឿន កំណត់ ទាំង ដែល រូប គេ អះអាង ថា មិន បាន បើកបរ ខុស ច្បាប់ និង ឈានដល់ ការប្រើប្រាស់ អំពើហិង្សា បណ្ដាល ឲ្យ បុរស ចិន រូប នេះ មាន របួស ស្នាម ថែម ទៀត ផង ។
បន្ថែម ពី ការរៀបរាប់ រឿង នគរបាល គោលដៅ ផ្លូវ ជាតិ លេខ ៣ ស្ថិត ក្នុង ស្រុក ត្រាំ កក់ ខេត្ត តាកែវ ផាក ពិន័យ ដោយ គ្មាន ហេតុផល និង មិន ចេញ វិក្កិយបត្រ នេះ ជនជាតិ ចិន ខាងលើ ក៏ បាន គូសបញ្ជាក់ ថា សកម្មភាព របស់ បុគ្គល នគរបាល នេះ ហាក់ ធ្វើឲ្យ ប៉ះពាល់ ដល់ មុខមាត់ របស់ ប្រទេស កម្ពុជា ថែម ទៀត ផង ។
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ អម ដំណើរ ដោយ លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្តិ រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សុខាភិបាល និង មន្ត្រី បច្ចេក ទេស សុខាភិបាល ព្រមទាំង មាន ការចូលរួម ពី តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ក្រុមការងារ សាងសង់ ទាំងអស់ ចុះ ពិនិត្យ ពន្លឿន ការងារ នៅ មន្ទីរពេទ្យ ជាតិ « តេជោ សន្តិភាព » ។
លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្តិ បាន បន្ត ថា ក្រោម ការចង្អុលបង្ហាញ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា មន្ទីរពេទ្យ ជាតិ នេះ នឹង ត្រៀម បញ្ចប់ ការសាងសង់ ជា ស្ថាពរ នៅ ដំណាច់ ខែមិថុនា នឹង អាច ដាក់ ដំណើរការទទួល អ្នកជំងឺ មកពី បណ្តា ខណ្ឌ ទាំង៦ ក៏ ដូចជា ខណ្ឌ ផេ្សង ៗ ទៀត នៅក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត ជាប់ ព្រំប្រទល់ ផងដែរ ។
បន្ថែម ពី នេះ លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្តិ បាន បញ្ជាក់ ថា នៅ ចំពោះមុខ ដោយ ប្រឈម នឹង ស្ថានភាព មិន ទាន់ ប្រាកដប្រជា នៃ ការឆ្លង ជំងឺ កូវីដ១៩ លើ ពិភពលោក និង ការវិវត្តន៍ នៃ ភាពបំលែង ថ្មី របស់ មេរោគ ផ្នែក ខ្លះ នៃ មន្ទីរពេទ្យ នេះ នឹង ត្រូវ សម្រុក រៀបចំ ឱ្យ បាន ឆាប់ ដើម្បី ត្រៀម ទប់ទល់ នឹង សភាពការណ៍ អាក្រក់ ណាមួយ ដែល អាច កើតឡើង ដូច្នេះ សម្រាប់ ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ម៉ឺងម៉ាត់ និង ឈ្លៀសវៃ របស់ សម្តេច តេជោ យើង បាន ត្រៀម ជាស្រេច ក្នុង ការទប់ទល់ នឹង ការរាតត្បាត របស់ មេរោគ ដ៏ កាច សាហាវ នេះ ។
សូម បញ្ជាក់ ថា មន្ទីរពេទ្យ ជាតិ ដ៏ ធំ មួយ នេះ គឺជា ការផ្ដួច ផ្ដើម ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ៕
សមាជិក ព្រឹទ្ធសភា៖ ៤៤ ឆ្នាំ មុន ពលរដ្ឋ ខ្មែរ រស់នៅ រង់ចាំ តែ ថ្ងៃ ស្លាប់ . ៤៤ ឆ្នាំ ក្រោយ ពលរដ្ឋ កម្ពុជា មាន សិទ្ធិ សេរីភាព ពេញលេញ រស់ នៅ ដោយ ភាពកក់ក្តៅ ក្រោម ដំបូល នៃ សន្តិភាព
ការលើកឡើង បែប នេះ របស់ លោកស្រី ឃួន ឃុន ឌី បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដែល លោកស្រី បាន ដឹកនាំ ប្រារព្ធ ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ទិវា ជយ័ជម្នះ ៧ មករា ១៩៧៩ - ៧ មករា ២០២៣ នៅ ភូមិ តារាម ឃុំ ត្បែង ស្រុក ស្វាយ ខេត្ត កំពង់ធំ ដោយ មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ ជិត ១ ពាន់ នាក់ ។
លោកស្រី បាន បញ្ជាក់ ថា ក្រោយពី ប្រទេសជាតិ ត្រូវបាន រំដោះ ចេញ ផុត ពី របប ឃោរឃៅ ព្រៃផ្សៃ មួយ នេះ នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ប្រជាជន គ្រប់ រូប បាន រស់ នៅ មាន សិទ្ធ សេរីភាព ពេញលេញ ឡើងវិញ ហើយ ប្រទេសជាតិ ទាំង មូល មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ រីកចម្រើន គ្រប់ វិស័យ មក ទល់ សព្វ ថ្ងៃ ។
ជាមួយគ្នា នេះ លោកស្រី បាន អំពាវនា ដល់ ប្រជាពលរដ្ឋ ត្រូវ ចងចាំ នូវ ស្មារតី ថ្ងៃ រំដោះ ជាតិ នេះ ស្ថិតស្ថេរ និង ចងចាំ នៅក្នុង ក្រអៅបេះដូង ពលរដ្ឋ គ្រប់ រូប និង ជា និមិត្តរូប នៃ សាមគ្គី ជាតិ និង មហា គ្រួសារ ខ្មែរ ស្ថិត នៅ ជា អមតៈក្រោម ម្លប់ សុខ សន្តិភាព ជានិច្ច និរន្ត៍ ។
លោកស្រី ឃួន ឃុន ឌី បាន អំពាវនាវ ទៅដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម ចូលរួម ថែរក្សា សុខ សន្តិភាព សុខ សុវត្ថិភាព ឱ្យ បាន យូរអង្វែង ដើម្បីឱ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ៕ រដ្ឋមន្រ្តី វង សូត៖ ទិវា ជ័យ ជំនះ ៧មករា មាន គុណ តម្លៃ មិន អាច កាត់ថ្លៃ បាន
( ត្បូងឃ្មុំ ) ៖ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង ឃុំ ជា ច ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង បាន លើកឡើង នូវ គុណ តម្លៃ ៧មករា ដែល ពុំ អាច កាត់ថ្លៃ បាន ជូន សមាជិក របស់ ខ្លួន លោក ថា ជ័យ ជំនះ ៧មករា ពិត ណាស់ គឺជា ថ្ងៃ កំណើត ទី២ សម្រាប់ ខ្លួន គាត់ ក៏ ដូចជា ជនរងគ្រោះ ជាច្រើន លាន នាក់ ផ្សេង ទៀត ឲ្យ រួចផុត ជីវិត ពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ។
រដ្ឋមន្រ្តី វង សូត បាន បន្ថែម ថា ក្រៅពី ទទួលបាន ជីវិត ថ្មី គឺ គុណ តម្លៃ ៧មករា បាន នាំ មកវិញ នូវ ការ រស់នៅ ក្នុង សង្គម សន្តិភាព ទទួលបាន សិទ្ធិ គ្រប់ យ៉ាង និង មើលឃើញ ពី ការរីកចំរើន របស់ ជាតិ ឥត ឈប់ឈរ ។
លោក បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា បាន ដាក់ចេញ នូវ គោល នយោបាយ ឈ្នះ ៗ ជាច្រើន សម្រាប់ ជួយ ដល់ ជនរងគ្រោះ និង ងាយ រងគ្រោះ ជាពិសេស ក្នុង អំឡុង ពេល មាន វិបត្តិ នៃ ជម្ងឺ កូវីដ១៩ តាមរយៈ កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ រស់ នៅក្នុង បន្ទាត់ ក្រីក្រ និង ក្បែរ បន្ទាត់ ក្រីក្រ សំដៅ ជួយ សម្រួល ការលំបាក និង លើកកម្ពស់ ជីវភាព ពួកគាត់ អោយ មាន ភាពប្រសើរឡើង បាន មួយ កម្រិត ទៀត ។
ឆ្លៀត ក្នុង ឱកាស នោះ រដ្ឋមន្រ្តី វង សូត ក៏ បាន សំដែង នូវ ការអបអរសាទរ ចំពោះ ក្មួយ ៗ ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង រៀនសូត្រ រហូត ទទួលបាន ជោគជ័យ ជូន ដល់ គ្រួសារ និង សង្គមជាតិ ហើយក៏ បាន ផ្តាំផ្ញើ ដល់ ក្មួយ ៗ ដែល ពុំ បាន ប្រឡង ជាប់ ត្រូវ ធ្វើ ការសិក្សា រៀនសូត្រ ឱ្យ បាន ខ្លាំងក្លា បន្ថែម ទៀត ដើម្បី ទទួលបាន ជោគជ័យ នៅ ឆ្នាំ ក្រោយ ទៀត ។
លោក ប្រធាន ក្រុមការងារ បន្ត ថា ក្មួយ ៗ ទាំងអស់ គឺជា ទំពាំង ស្នង ឬស្សី សម្រាប់ ប្រទេសជាតិ និង ជា ធនធាន មនុស្ស ដ៏ សំខាន់ នា ថ្ងៃ ខាងមុខ ក្មួយ ៗ មិន ត្រឹមតែ រៀន ឱ្យ បាន តែ ជាប់ ប៉ុណ្ណោះ ទេ ត្រូវ រៀន ឱ្យ ចេះ សម្រាប់ ខ្លួន ឯង ហើយ ក្មួយ ៗ អាច មាន ឱកាស សិក្សា និង ប្រឡង ជាប់ នៅ ពេល នេះ ក៏ ដោយសារ ប្រទេស មាន សន្តិភាព ដូចនេះ យើង ទាំងអស់ គ្នា សូម អរគុណ សន្តិភាព ។ ស្ថិត ក្នុង បរិបទ នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ជា សកល សូម ក្មួយ ៗ ថែរក្សា សុខភាព និង សូម ប្រកាន់ខ្ជាប់ នូវ វិធានការ សុខាភិបាល ។
ដើម្បី ជា ការលើកទឹកចិត្ត ដល់ ក្មួយ ៗ ដែល បាន ប្រឡង ជាប់ ទទួលបាន និទ្ទេស ល្អ លោក ប្រធាន ក្រុមការងារ ក៏ បាន ឧបត្ថម្ភ នូវ សម្ភារៈ និង ថវិកា មួយ ចំនួន រួម មាន៖
( កំពង ស្ពឺ ) ៖ លោក យឹម សុខុម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ រួម នឹង មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រជាពលរដ្ឋ សិស្សានុសិស្ស ជិត ៦.០០០ នាក់ នៅ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០៣ នេះ បាន ប្រារព្ធ ពិធី អបអរសាទរ ខួប ៤៤ ឆ្នាំ នៃ ថ្ងៃ ជ័យជម្នះ ៧ មករា ( ០៧ មករា ១៩៧៩ - ០៧ មករា ២០២៣ ) នាមុខ សាលា ខេត្ត កំពង់ស្ពឺ ដ៏ មហាឡារឹក ក្រៃលែង ។
បន្ទាប់ពី បាន អាន សារ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា . លោក វ៉ី សំណាង បាន លើកឡើង ថា « ក្នុង នាម ប្រជាជន កម្ពុជា ទាំងអស់ គ្នា នាំគ្នា ថែរក្សា ការពារ នូវ សុខ សន្តិភាព របស់ ប្រទេស កម្ពុជា នៃ យើង ដែល មាន សព្វ ថ្ងៃ នេះ ហើយ ទប់ស្កាត់ និង កម្ចាត់ នយោបាយ ជ្រុលនិយម ដែល ចង់ បំផ្លាញ ដល់ សុខ សន្តិភាព របស់ ប្រទេសជាតិ » ។
សូម បញ្ជាក់ ថា ដើម្បី អបអរសាទរ ខួប ៤៤ ឆ្នាំ នៃ ថ្ងៃ ជ័យជម្នះ ៧ មករា រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បាន រៀបចំ ឱ្យ មាន ការលេង របាំ អបអរ និង ការប្រគុំតន្ត្រី ជូន អ្នកចូលរួម ទស្សនា មើល កម្សាន្ត យ៉ាង សប្បាយរីករាយ ផងដែរ ៕ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ប្រារព្ធ ខួប លើក ទី៤៤ ឆ្នាំ នៃ ទិវា ជ័យជន្នះ ៧ មករា
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន និង ថ្នាក់ដឹកនាំ នៃ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន អញ្ជើញ ឡើង ដុត ធូប គោរព ដល់ វិញ្ញាណក្ខន្ធ កម្មាភិបាល យុទ្ធជន យុទ្ធ នារី ដែល បាន ពលី ជីវិត ក្នុង ភ្លើង សង្គ្រាម ដើម្បី វាយ ផ្ដួល រំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ទទួលបាន ជ័យជន្នះ នៅ ថ្ងៃទី ៧ មក រា ១៩៧៩ និង បាន ការពារ មិន ឱ្យ របប ប្រល័យ ពូជសាសន៍ នេះ វិលត្រឡប់ មកកាន់អំណាច ជាថ្មី ឡើងវិញ បាន ។
នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ សូម គោរព ចងចាំ និង ដឹងគុណ ជានិច្ច នូវ គុណូបការៈ ដ៏ ថ្លៃថ្លា របស់ វិរៈ យុទ្ធជន យុទ្ធ នារ ដែល បាន បូជា ពលី ជីវិត ដើម បុព្វហេតុ ជាតិ មាតុភូមិ ហើយ យោធិន ដែល បាន ចូលរួម ក្នុង អង្គ មីទ្ទីង នៅ ពេល នេះ បាន អញ្ជើញ ទៅ ដុត ធូប គោរព វិញ្ញាណក្ខន្ធ នៅ តាម ផ្នូរសព របស់ កម្មាភិបាល យុទ្ធជន ពលី ដែល បាន តម្កល់ ទុក នៅ វិមាន រំលឹក គុណ យុទ្ធជន ពលី ផងដែរ ៕
( ភ្នំពេញ ) ៖ សមត្ថកិច្ច បាន បង្រ្កាប ជនសង្ស័យ ជា បន្តបន្ទាប់ ចំនួន ៣នាក់ និង បាន ដកហូត វត្ថុតាង ម្សៅ មាន សារធាតុ ញៀន ជិត ១គីឡូក្រាម ។ ហេតុការណ៍ នេះ កើតឡើង នា ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២៣ នៅ ចំណុច ផ្លូវ ៤៨៨ កែង ៩៩ ស្ថិត នៅ ភូមិ ៤ សង្កាត់ ផ្សារ ដើម ថ្កូវ ខណ្ឌ ចំការមន ។
លោក ផន អូន អធិការ រង ខណ្ឌ ចំការមន បាន ប្រាប់ ថា កម្លាំង នគរបាល របស់ លោក បាន សហការ ជាមួយ ផ្នែក ការិយាល័យ ប្រឆាំង គ្រឿងញៀន នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បង្រ្កាប ជាក់ស្ដែង កាលពី ម៉ោង ១៖០០ នាទី រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២៣ បាន ជនសង្ស័យ ចំនួន ២នាក់ ពី បទ ជួញដូរ នូវ សារធាតុ ញៀន រួម មាន៖
វត្ថុតាង ដកហូត ម្សៅ ក្នុង កញ្ចប់ ពណ៌ ក្រហម ( សង្ស័យ គ្រឿងញៀន ចំនួន ៥ កញ្ចប់ ) និង ម៉ូតូ ១ គ្រឿង ម៉ាក C ១២៥ ពណ៌ ខ្មៅ ស្លាកលេខ ១JO ៣៥៨០ភព និង ទូរស័ព្ទដៃ ៣គ្រឿង ម៉ាក សាំ សុង ២គ្រឿង អ៊ិន ចុច ពិល១ គ្រឿង ។ ជនសង្ស័យ ទាំង ២នាក់ និង វត្ថុតាង បាន នាំមក អធិការ ខណ្ឌ ចំការមន ដើម្បី ធ្វើ ការសាកសួរ បន្ត ។
រហូតដល់ រសៀល ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២៣ ឃាត់ បាន ជនសង្ស័យ ឈ្មោះ កែវ ដារ៉ូ ភេទ ប្រុស អាយុ ២៥ ឆ្នាំ មុខរបរ ចុង ភៅ ស្នាក់ នៅ សង្កាត់ ផ្សារ ដេប៉ូ៣ ខណ្ឌ ទួលគោក ដែល បាន ឲ្យ ជនសង្ស័យ ២នាក់ ខាងលើ មក ទិញ យកមក ឲ្យ តែ មិន យក ថ្នាំ ម្សៅ គ្រវី មិន ទាន់ បាន ក៏ សមត្ថកិច្ច ឃាត់ខ្លួន បាត់ ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ៣នាក់ បាន កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ចាត់ការ បន្ត តាម នីតិវិធី ច្បាប់ ៕ ថ្ងៃ ទិវា ជ័យជម្នះ ៧ មករា . អតីត អ្នកគាំទ្រ គណបក្ស នយោបាយ ផ្សេង ៗ ជាង ១ ពាន់ នាក់ នៅ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ស្ម័គ្រចិត្ត មក រួមរស់ ជាមួយ គណបក្ស គណបក្ស ប្រជាជន កម្ពុជា
( បន្ទាយមានជ័យ )៖ លោក បោន ប៊ិន សមាជិក អចិន្ត្រៃយ៍ គណបក្ស ខេត្ត បន្ទាយមានជ័យ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូល ដា្ឋ ន ស្រុក ភ្នំស្រុក នៅ ព្រឹក ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ពិធី ប្រកាស បញ្ចូល សមាជិក ថ្មី នៃ គណបក្ស ប្រជាជន កម្ពុជា ចំនួន ១. ០៣៤ នាក់ ដែល ជា អតីត អ្នកគាំទ្រ គណបក្ស នយោបាយ ផ្សេង ៗ នៅក្នុង ស្រុក ភ្នំស្រុក មក សុំ ចូលមក រួមរស់ ជីវភាព ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
ពិធី ប្រកាស បញ្ចូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ថ្មី ទាំង១. ០៣៤ នាក់ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ក្រុមការងារ ចុះ ជួយ ស្រុក ភ្នំស្រុក ប្រធាន គណៈកម្មការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក សមាជិក - សមាជិកា បក្ស នៅ មូលដ្ឋាន ផងដែរ ។
នា ឱកាស នោះ លោក បោន ប៊ិន ក៏ បាន ថ្លែង នូវ អំណរគុណ ចំពោះ សមាជិក ថ្មី ដែល បាន ស្ម័គ្រចិត្ត រួមរស់ ជីវភាព របស់ គណបក្ស ប្រជាជន កម្ពុជា ផងដែរ ។ ជាមួយគ្នា នោះ លោក បាន រំឮក ពី ប្រវិត្ត ការតស៊ូ របស់ កម្ពុជា ដែល បាន ហែល ឆ្លងកាត់ សង្រ្គាម រ៉ាំរ៉ៃ ការកាប់ សម្លាប់ ជាតិ សាសន៍ ឯង យ៉ាង សាហាវ ព្រៃ ជា ទីបំផុត ពី របប ខ្មែរ ក្រហម ប៉ុល ពត ។
សូម បញ្ជាក់ ថា សមាជិក - សមាជិកា ដែល បាន ស្ម័គ្រចិត្ត រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ទាំង ១. ០៣៤ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន៖ អង្ករ២៥ គីឡូក្រាម . សារ៉ុង ០១ រួម នឹង ថវិកា ចំនួន ២ម៉ឺន រៀល ។ ក្រុមការងារ មូលដ្ឋាន ស្រុក ចំនួន ២៦ នាក់ ក្នុង ម្នាក់ ទទួលបាន សារ៉ុង ០១. ទឹកក្រូច ០១យួរ . មី ០១កេស និង ថវិកា ចំនួន ៤ម៉ឺន រៀល ។ ដោយឡែក ក្រុមការងារ មូលដ្ឋាន ឃុំ - ភូមិ ចំនួន ៧១ នាក់ ក្នុង ម្នាក់ ទទួលបាន ទឹក ភេសជ្ជៈ ប៉ូវ កម្លាំង ចំនួន ០១កេស . សារ៉ុង ០១. ទឹកក្រូច ០១យួរ . មី ០១កេស និង ថវិកា ៤ម៉ឺន រៀល ផងដែរ ៕
ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » នឹង ចាក់បញ្ចាំង នៅ ល្ងាច ថ្ងៃ នេះ
( ភ្នំពេញ ) ៖ ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » បង្ហាញ ប្រវត្តិ ជីវិត ពិត ដ៏ សោកសៅ និង ខ្លោចផ្សារ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នឹង ត្រូវ ចាក់បញ្ចាំង នៅ ល្ងាច ថ្ងៃសៅរ៍ ទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ ហើយ ។
បទចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » រៀបរាប់ ពី ខ្សែ ជីវិត ពិត របស់ សម្តេច កិត្តិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ត្រូវ ជួប ការលំបាក និង ឃ្លាត ឆ្ងាយ ពី សម្តេច តេជោ ហ៊ុន សែន ទាំង ខ្លួន កំពុង មាន ផ្ទៃពោះ ប្រមាណ ៥ខែ កំណើត លោក ហ៊ុន ម៉ាណែត ។
ដើម្បី បុព្វហេតុ ជាតិ និង ប្រជាជន សម្តេច តេជោ ហ៊ុន សែន រួម នឹង យុទ្ធ មិត្ត ៤រូប ផ្សេង ទៀត នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ១៩៧៧ បាន ភៀស ខ្លួន ចេញ ពី បញ្ជាការដ្ឋាន ភូមិ កោះ ថ្មី ស្រុក មេមត់ ឆ្ពោះទៅ ប្រទេស វៀត ណាម ស្វែងរក ការគាំទ្រ ដើម្បី វាយ ផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
ការឃ្លាត ឆ្ងាយ ដើម្បី បុព្វហេតុ ជាតិ និង ប្រជាជន ជា ពេលវេលា ដ៏ លំបាក និង សោក សៅ ជា ទីបំផុត សម្រាប់ សម្តេច តេជោ ហ៊ុន សែន ព្រោះថា ការឃ្លាត ឆ្ងាយ នេះ មិន ដឹង ថា មិន ជោគវាសនា យ៉ាងណា ? មិន ដឹង ថា ត្រូវ ស្លាប់ ឬ រស់ ? ។ ជាពិសេស ការឃ្លាត នេះ ត្រូវ ចាកចោល ភរិយា ជា ទីស្រឡាញ់ ដែល កំពុង ពពោះ កូន ក្នុង ផ្ទៃ អាយុ ៥ខែ ។
ការឃ្លាត ឆ្ងាយ របស់ សម្តេច តេជោ ជា ទុក្ខលំបាក និង ជា ទារុណ ដួងចិត្ត មួយ ទៅ ហើយ ។ តែ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជា ភរិយា រស់ នៅក្នុង ស្រុក ក៏ រឹតតែ លំបាក ថែម ទៀត ។ ជា ស្ត្រី មាន ស្វាមី ក្បត់ អង្គការ ខ្មែរ ក្រហម ត្រូវ ប្រឹង រស់ ដោយ លាក់ ប្រវត្តិ ដើម្បី ធានា សុវត្ថិភាព ជីវិត ពី របប ខ្មែរ ក្រហម ទាំង ចិត្ត ឈឺ ផ្សារ នឹករលឹក ព្រួយបារម្ភ ពី ស្វាមី គ្រប់ ពេលវេលា ។ បន្ថែម ពីលើ នោះ ជា ស្ត្រី ទន់ខ្សោយ មាន ផ្ទៃពោះ ត្រូវ រង ពាក្យ និន្ទា នានា ហើយ ត្រូវ អង្គការ បង្ខំឱ្យ ធ្វើ ការ គ្មាន ត្រា ប្រណី អត់ ចំណីអាហារ ។
ទាំង នេះ ជា ខ្លឹមសារ ដែល បាន រំលេច ក្នុង បទចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ។ ខ្លឹមសារ បទចម្រៀង ក៏ បាន រំលេច ពី ការអត់ធ្មត់ និង ពុះពារ គ្រប់ ឧបសគ្គ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក្នុង ការប្រសូត បុត្រ ព្រមទាំង ប្រឹងប្រែង បី បាច់ ថែរក្សា បុត្រ ក្នុង ស្ថានភាព ដ៏ លំបាក រហូត បាន ជួបជុំ ជាមួយ សម្តេច តេជោ ឡើងវិញ នា ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ១៩៧៩ ។
បទចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ត្រូវបាន សមាគម មិត្ត សិល្បៈ ស្ម័គ្រចិត្ត ជួយ សង្គម យកមក ថត ជា ភាពយន្ត ដោយ បញ្ចូល ឈុត ឆាក សម្តែង ជាមួយ បច្ចេកទេស ថត បែប សម័យ ទំនើប បង្កើត ជា ភាពយន្ត ចម្រៀង មួយ ដែល មាន ការទាក់ទាញ កាន់តែ ខ្ពស់ ។ ជាពិសេស បាន បញ្ចូល នូវ ម នោរម្មណ៍ កាន់តែ ខ្ពស់ ទៅក្នុង តថ ភាព ពិត នៃ ជីវិត តស៊ូ និង ការលំបាក វេទនា របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក្នុង ដំណាក់កាល តស៊ូ នោះ ។
លោក ហេង ឡុង បាន ឱ្យដឹង ថា ភាពយន្ត ចម្រៀង « ទុក្ខ ស្រី ប្តី ព្រាត់ » ត្រូវបាន ផលិត ឡើង យ៉ាង សម្រិត សម្រាំង រយៈពេល ប្រមាណ ៩ខែ ដោយ ចំណាយ ថវិកា ប្រមាណ ១៣ម៉ឺន ដុល្លារ អាមេរិក ។
( ភ្នំពេញ ) ៖ អង្គភាព ប្រឆាំង អំពើពុករលួយ (ACU) បាន បន្ត ចេញ សេចក្តីជូនដំណឹង ស្តីពី លទ្ធផល នៃ ការទទួល ឯកសារ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល តាម របប ០២ឆាំ្ន សម្រាប់ ឆ្នាំ ២០២៣ ដោយ បញ្ជាក់ ថា នៅ ថ្ងៃសុក្រ ទី ០៦ ខែមករា ឆ្នាំ ២០២៣ ម្សិលមិញ នាយកដ្ឋាន ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល បាន ទទួល ឯកសារ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល សរុប ចំនួន ១៥៥៥ ច្បាប់ ទៀត ។
សេចក្តីជូនដំណឹង ដែល បណ្តាញ Fresh News ទទួលបាន ឲ្យដឹង ទៀត ថា គិត ត្រឹម ថ្ងៃសុក្រ ម្សិលមិញ នាយកដ្ឋាន ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល បាន ទទួល ឯកសារ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល សរុប ចំនួន ១៦. ២៤៩ ច្បាប់ ។
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៦ ខែមករា ឆ្នាំ ២០២៣៖
ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង ក្នុង ឱកាស សម្តេច អញ្ជើញ ប្រារព្ធ ពិធី អបអរសាទរ ខួប ៤៤ ឆ្នាំ នៃ ថ្ងៃ ជ័យជម្នះ « ៧មករា » នា ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២៣ នេះ ។
ជាមួយគ្នា នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ដល់ អាជ្ញាធរ មូលដ្ឋាន បន្ត យកចិត្តទុកដាក់ ពង្រឹង សន្តិសុខ សណ្តាប់ សង្គម និង ប្រឹងប្រែង ក្នុង ការផ្តល់ សេវា គាំពារ សង្គម ។
សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ យ៉ាង ដូច្នេះ ថា៖ « ព្រម ជាមួយ នេះ ខ្ញុំ សូម អំពាវនាវ ដល់ គ្រប់ គណបក្ស នយោបាយ អង្គការ នានា នៃ សង្គម ស៊ីវិល ប្រព័ន្ធ ព័ត៌មាន ក្រសួង ស្ថាប័ន អាជ្ញាធរ និង កងកម្លាំង មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ គោរព ខ្ជាប់ខ្ជួន តាម គោលការណ៍ ច្បាប់ ហើយ ចូលរួម ទាំងអស់ គ្នា ក្នុង ការពង្រឹង បរិយាកាស នយោបាយ សម្រាប់ ការបោះឆ្នោត ប្រកបដោយ លក្ខណៈ អព្យាក្រឹត គ្មាន ការគំរាមកំហែង និង សុវត្ថិភាព ដើម្បី ធានា ឱ្យ ការបោះឆ្នោត ប្រព្រឹត្តទៅ ដោយ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ » ។
នៅក្នុង បរិការណ៍ នេះ ក្នុង នាម គណបក្ស ប្រជាជន កម្ពុជា ដែល ប្រកាន់ខ្ជាប់ នូវ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស សម្តេច តេជោ ហ៊ុន សែន សូម ប្រកាស ជា ឱឡារិក នូវ ការចូលរួម របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការបោះឆ្នោត ខាងមុខ នេះ ដោយ គោរព យ៉ាង ម៉ឺងម៉ាត់ តាម ច្បាប់ ព្រមទាំង បទបញ្ជា និង នីតិវិធី របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ៕
ការគំរាម អំពី គ្រាប់បែក នោះ ត្រូវបាន ធ្វើឡើង តាម ខ្សែ ទូរស័ព្ទ អន្តរជាតិ មួយ ចេញ ពី ប្រទេស អាល្លឺម៉ង់ និង ជា ភាសា អង់គ្លេស ដោយ និយាយ ថា មាន គ្រឿងផ្ទុះ ទម្ងន់ ប្រហែល ១០០ គីឡូក្រាម ត្រូវបាន បង្កៃ នៅ កន្លែង ផ្ទុក ទំនិញ របស់ យន្តហោះ ។ រូបភាព និង ឃ្លីប វីដេអូ ពី សារព័ត៌មាន NHK បាន បង្ហាញ ឱ្យ ឃើញ អ្នកដំណើរ រាប់ សិប នាក់ ឈរ ត្រៀបត្រា នៅលើ ផ្លូវ រត់ របស់ យន្តហោះ ក្រោយ ពួកគេ ប្រញាប់ប្រញាល់ ចាកចេញ ពី ក្នុង យន្តហោះ ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ផ្តល់ គោរមងារ ដល់ ឧកញ៉ា លី ឃុន ថៃ ជា « អ្នក ឧកញ៉ា »
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ ព្រះមហាក្ស ត្រ៖ ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ខួប អនុស្សាវរីយ៍ លើក ទី៤៤ នៃ ថ្ងៃ ជ័យ ជំនះ៧ មករា
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការប្រារព្ធ ពិធី អបអរសាទរ ថ្ងៃ ជ័យជម្នះ ៧ មករា ធ្វើឡើង ក្នុង ស្មារតី ចងចាំ ជានិច្ច នូវ គុណូបការៈ ដ៏ ថ្លៃថ្លា បំផុត នៃ វីរយុទ្ធជន យុទ្ធ នារី នៃ រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ អ្នកស្នេហាជាតិ និង កងទ័ព ស្ម័គ្រចិត្ត វៀតណាម ក្នុង ការតស៊ូ វាយ ផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត រំដោះ យក ជីវិត ប្រជាពលរដ្ឋ ។
ខាងក្រោម នេះ ជា ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន នៅក្នុង ឱកាស ពិធី អបអរសាទរ ខួប ៤៤ ឆ្នាំ នៃ ថ្ងៃ ជ័យជម្នះ ៧មក រា៖
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការប្រារព្ធ ពិធី អបអរសាទរ ថ្ងៃ ជ័យជម្នះ ៧ មករា ធ្វើឡើង ក្នុង ស្មារតី ចងចាំ ជានិច្ច នូវ គុណូបការៈ ដ៏ ថ្លៃថ្លា បំផុត នៃ វីរយុទ្ធជន យុទ្ធ នារី នៃ រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ អ្នកស្នេហាជាតិ និង កងទ័ព ស្ម័គ្រចិត្ត វៀតណាម ក្នុង ការតស៊ូ វាយ ផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត រំដោះ យក ជីវិត ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការប្រារព្ធ ពិធី អបអរសាទរ ថ្ងៃ ជ័យជម្នះ ៧មករា ធ្វើឡើង ក្នុង ពេល ដែល កម្ពុជា មាន ការអភិវឌ្ឍ រីកចម្រើន និង មាន កិត្យានុភាព ខ្ពស់ ត្រដែត លើ ឆាក អន្តរជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បច្ចុប្បន្ន ប្រជាពលរដ្ឋ កំពុង រស់ នៅ យ៉ាង សុខដុមរមនាក្រោម ម្លប់ សុខ សន្តិភាព ហើយ បន្ត ប្រឹងប្រែង ក្នុង ការកសាង សង្គមជាតិ និង ជីវភាព ប្រកបដោយ ក្តីសង្ឃឹម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ភាពឈឺចាប់ និង សោក សៅ ដោយសារតែ ភាព ព្រៃផ្សៃ នៃ របប ខ្មែរ ក្រហម នៅតែ បន្ត ដក់ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ ខ្មែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ជ័យជម្នះ ៧ មករា បាន បិទ បញ្ចប់ នូវ ទំព័រ សករាជ ដ៏ ខ្មៅ នាំមក នូវ សករាជ ថ្មី នៃ ការរស់រៀន ការអភិវឌ្ឍ និង ផ្តល់ កំណើត ទី២ដល់ របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ថ្ងៃ ជ័យជម្នះ ៧មករា ទើប នាំឱ្យ មាន កម្ពុជា នា ពេល បច្ចុប្បន្ន ។ នេះ ជា សច្ច ភាព ប្រវត្តិសាស្ត្រ ដែល មិន អាច ប្រកែក បាន ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អ្នក មិន ទទួលស្គាល់ ថ្ងៃ ជ័យជម្នះ ៧មករា គឺ មាន តែ អ្នក ដែល គាំទ្រ របប ខ្មែរ ក្រហម ប៉ុណ្ណោះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ផ្តើម ចេញ ពី ថ្ងៃ ជ័យជម្នះ ៧មករា ធ្វើឱ្យ កម្ពុជា មាន ឱកាស រក បាន នូវ សុខ សន្តិភាព និង បិទ បញ្ចប់ ភ្លើង សង្គ្រាម ទាំងស្រុង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ហើយ ឈាន ឆ្ពោះ ទៅរក ការអភិវឌ្ឍ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ផ្តើម ពី ការយកឈ្នះ លើ ជំងឺ កូវីដ១៩ ធ្វើឱ្យ សេដ្ឋកិច្ច កម្ពុជា កើនឡើង ក្នុង រង្វង់ ៥.៥ភាគរយ នៅ ឆ្នាំ ២០២២ និង រំពឹង សម្រេចបាន ៦.៦ភាគរយ នៅ ឆ្នាំ ២០២៣ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ឈរ លើ ស្មារតី អភិវឌ្ឍ ជាតិ កម្ពុជា បាន និង កំពុង រីកចម្រើន ហើយ ប្រាក់ បៀវត្សរ៍ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ប្រាក់ សោធន និវត្សរ៍ សម្រាប់ អតីត យុទ្ធជន និង និវត្តន៍ ជន ប្រាក់ ឈ្នួល កម្មករ និយោជិត ក្នុង វិស័យ វេយណ ភណ្ឌ ត្រូវបាន ដំឡើង ជា បន្តបន្ទាប់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ស្មារតី ៧មករា បន្ត ស្ថិត ក្នុង បេះដូង ខ្មែរ គ្រប់ ជំនាន់ ហើយ ត្រូវ ពួន ជ្រុំ ស្មារតី ៧មករា ឱ្យ រឹងមាំ ទៅ មុខ បន្ត ទៀត ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ថ្ងៃ ជ័យជម្នះ ៧មករា បាន ប្រែក្លាយ ទឹកដី កម្ពុជា ពី ទឹកដី មរណៈ មក ជា ទឹកដី ដ៏ ស្រស់បំព្រង នា ពេល បច្ចុប្បន្ន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការបន្ត រួបរួម គ្នា ឈរ លើ មាគ៌ា ដ៏ ត្រឹមត្រូវ នឹង គ្មាន អ្វី មក បំផ្លិចបំផ្លាញ នូវ សមិទ្ធផល និង កិច្ចប្រឹងប្រែង របស់ កម្ពុជា បាន នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ ប្រជាជាតិ ខ្មែរ ឱ្យ រួមគ្នា ការពារ សុខ សន្តិភាព ការពារ សមិទ្ធផល របស់ កម្ពុជា ។ សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ឱ្យ រួមគ្នា ទប់ស្កាត់ និង កម្ចាត់ នយោបាយ ជ្រុលនិយម ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ត្រូវតែ ប្តូរផ្តាច់ ក្នុង ការកម្ចាត់ នយោបាយ ជ្រុលនិយម មិន ថា ឆ្វេង ឬ ស្តាំ ដើម្បី ធានា រក្សា បាន សុខ សន្តិភាព ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ ជន ពាក់ព័ន្ធ ក្រុម ទណ្ឌិត ជ្រុលនិយម ប្រញាប់ ដក ខ្លួន ដើម្បី គេច ផុត ពី សំណាញ់ ច្បាប់ ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ដល់ អាជ្ញាធរ មូលដ្ឋាន បន្ត យកចិត្តទុកដាក់ ពង្រឹង សន្តិសុខ សណ្តាប់ សង្គម និង ប្រឹងប្រែង ក្នុង ការផ្តល់ សេវា គាំពារ សង្គម ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ គណបក្ស នយោបាយ សង្គម ស៊ីវិល ព័ត៌មាន ក្រសួង ស្ថាប័ន នានា រួមគ្នា គោរព គោលការណ៍ ច្បាប់ ធ្វើឱ្យ ការបោះឆ្នោត ប្រព្រឹត្តទៅ ដោយ បរិយាកាស ល្អ ធានា បាន នូវ អព្យាក្រឹត្យ និង តម្លាភាព ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា ប្រកាន់ខ្ជាប់ នូវ ធម្មនុញ្ញ របស់ អង្គការ សហ ប្រជាជាតិ និង គោលការណ៍ អន្តរជាតិ នានា និង ប្រឆាំង ដាច់ខាត ការឈ្លានពាន នូវ រដ្ឋ អធិបតេយ្យ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ឆ្លង បទពិសោធន៍ អតីតកាល សម្រាប់ កម្ពុជា គឺ នៅតែ រក្សា ទស្សនទាន ថា មាន តែ ការចរចា ទើប បញ្ចប់ សង្គ្រាម បាន មិន អាច យក សង្គ្រាម ទៅ បញ្ចប់ សង្គ្រាម បាន នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ប្តេជ្ញា ថា នឹង ធ្វើ គ្រប់ យ៉ាង ដើម្បី ធានា បាន នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ សង្គម ៕
សមិទ្ធផល នានា របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ឧត្តរមានជ័យ ដែល ចំណាយ ថវិកា កសាង ជាង ៥០ ម៉ឺន ដុល្លារ ត្រូវបាន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ
( ឧត្តរមានជ័យ )៖ កាលពី រសៀល ថ្ងៃសុក្រ ត្រូវនឹង ថ្ងៃទី ៦ ខែមករា ឆ្នាំ ២០២៣ នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា មេបញ្ជាការ នគរបាល ជាតិ ប្រចាំ ភូមិភាគ ទី៤- ៥ ទី តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ . លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត និង លោក ស៊ី ប្រា សិទ្ធ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ សមិទ្ធផល នានា របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ឧត្តរមានជ័យ ។
ជា កិច្ច ចាប់ផ្តើម លោក ឧត្តមសេនីយ៍ ទោ ហួត សុធី ស្នងការ នគរបាល ខេត្ត ឧត្តរមានជ័យ បាន ឡើង ធ្វើ របាយការណ៍ ស្វាគមន៍ ដោយ សំដែង នូវ ភារវកិច្ច នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ ដែល បាន ចំណាយ ពេល ដ៏ តម្លៃ និង មមាញឹក ផ្ដល់ កិត្តិយស អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ សមិទ្ធផល នានា របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ឧត្ដរ មានជ័យ និង ពិធី សំណេះសំណាល សួរសុខទុក្ខ ដល់ កងកម្លាំង នគរបាល មន្រ្តី នគរបាល ចូលនិវត្តន៍ នា ឱកាស ដ៍ ថ្លៃថ្លា នេះ ។
ក្នុង ឱកាស ដ៍ វិសេសវិសាល នេះ លោក ឧត្តមសេនីយ៍ ទោ ហួត សុធី បាន រាយការណ៍ សង្ខេប អំពី សភាពការណ៍ និង កិច្ច ប្រតិបត្តិការ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ក្នុង ឆ្នាំ ២០២២ កន្លងមក ដូច ខាងក្រោម៖
ទី ១៖ សភាពការណ៍ សន្តិសុខ ស្ងប់ស្ងាត់ ធានា បាន សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សង្គម ល្អ ប្រសើរ ដោយឡែក ចំពោះ បញ្ហា វីរុស កូវីដ - ១៩ បាន ណែនាំ អប់រំ ដល់ កងកម្លាំង ក្រោម ឱវាទ ត្រូវតែ បន្ត គោរព តាម វិធានការ សុខាភិបាល និង តាម អនុសាសន៍ ដ៍ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ៣កុំ ៣ការពារ ជាប់ ជាប្រចាំ ហើយ បាន ធ្វើ ការផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ ចេះ រក្សា អនាម័យ ដើម្បី សុខភាព រៀង ៗ ខ្លួន ។
ទី ២៖ លទ្ធផល បង្ក្រាប បទល្មើស ព្រហ្មទណ្ឌ៖ បង្ក្រាប បាន ចំនួន ៣០ករណី លើ ៣២ ករណី ស្មើ ៩៤ % នៃ បទល្មើស រួម ធ្វើ ការឃាត់ខ្លួន ជនល្មើស ៥៣ នាក់ ស្រី ០១នាក់ និង បាន ដកហូត វត្ថុតាង រថយន្ត ០១ គ្រឿង ម៉ូតូ ០៤ គ្រឿង ទូរស័ព្ទ ដៃ ១២ គ្រឿង និង សម្ភារ ផ្សេង ៗ មួយចំនួន ទៀត បាន រៀបចំ សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ រួចរាល់ ។
ទី៤៖ ការបង្ក្រាប ក្មេង ទំនើង សរុប ចំនួន ១៣ លើក ឃាត់ខ្លួន ៥៣ នាក់ ស្រី ០២ នាក់ ក្នុង នោះ អនុវត្ត វិធានការ ច្បាប់ ១៦នាក់ និង វិធានការអប់រំ ៣៧ នាក់ ។
ទី៥៖ បង្ក្រាប ល្បែងស៊ីសង ខុស ច្បាប់ ០៨ លើក ឃាត់ខ្លួន ធ្វើ ការអប់រំ មនុស្ស ប្រុស - ស្រី ចំនួន ១៦នាក់ ។
ទី ៧៖ អំពី គ្រោះថ្នាក់ ផ្សេង ៗ៖ កើតឡើង ចំនួន ៤៥ លើ ៥៦លើ ក មាន ការថយចុះ ចំនួន ១១ លើក បណ្តាលឱ្យ មនុស្ស ស្លាប់ ចំនួន ២៩ នាក់ . របួស ០៩ នាក់ . ឆេះ ផ្ទះ ០៦ ខ្នង . រលំ ផ្ទះ និង របើក ដំបូល សរុប ១០ខ្នង គ្រោះថ្នាក់ ទាំងអស់ ខាងលើ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត និង ក្រុង - ស្រុក បាន ចុះ ជួយ ចែករំលែក ទុក្ខ និង ធ្វើ ការដោះស្រាយ ជូន ប្រជាពលរដ្ឋ រួចរាល់ ។
ទី៩៖ ការងារ អនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភា ព៖ បាន ធ្វើ ការផ្សព្វផ្សាយ គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព និង ធ្វើ វេទិកា សាធារណៈ ចំនួន ៩១៣ លើក អ្នកចូលរួម ៦៦១៤៨ នាក់ ស្រី ៣៥៨៧៣ នាក់ ។
ថ្ងៃ ជ័យជម្នះ « ៧មករា » ជា ថ្ងៃ ដែល ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស បាន សាទ រ យ៉ាង កង រំពង ព្រោះ ជា ថ្ងៃ ដែល ជីវិត របស់ ពួកគេ ត្រូវបាន រំដោះ ចេញ ពី អន្លង់ មរណៈ នៃ បន ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។ ប៉ុន្តែ ថ្ងៃ ជ័យជម្នះ មិន ត្រូវបាន សាទ រ ដោយ ក្រុម អ្នកនយោបាយ ដែល ប្រឆាំង នឹង គណបក្ស ប្រជាជន កម្ពុជា កំពុង ដឹកនាំ ប្រទេស នោះ ឡើយ ។ ពួកគេ បាន ព្យាយាម បំភ្លៃ និង ព្យាយាម សាប ព្រោះថា ថ្ងៃ ជ័យជម្នះ « ៧មករា » ជា ថ្ងៃ ដែល វៀតណាម ចូលមក ឈ្លានពាន ប្រទេស កម្ពុជា ទៅ វិញ ។
ក្នុង ពិធី សម្ពោធ សមិទ្ធផល ក្នុង វត្ត មួយ នៅ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ លោក បណ្ឌិត ហ៊ុន សែន សមាជិក អចិន្ត្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា និង ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី បន្ត វេន របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន លើក បង្ហាញ នូវ ទិដ្ឋភាព មួយចំនួន ដើម្បី វែកញែក ថា តើ ថ្ងៃ « ៧មករា » ជា ថ្ងៃ រំដោះ ឬ ជា ថ្ងៃ ដែល វៀតណាម ចូលមក ឈ្លានពាន ?
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ចោទសួរ ថា តើ នៅ មុនពេល រំដោះ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ តើ របប កម្ពុជា ប្រជាធិបតេយ្យ ឬ របប ខ្មែរ ក្រហម ឈប់ សម្លាប់ ប្រជាពលរដ្ឋ ហើយ ឬ នៅ ?
យោង តាម ការសាកសួរ ប្រជាពលរដ្ឋ ជា សាក្សី ឆ្លងកាត់ របប នោះ បាន គូសបញ្ជាក់ ថា រហូតដល់ ចុង ឆ្នាំ ១៩៧៨ របប ខ្មែរ ក្រហម គឺ នៅតែ បន្ត កាប់ សម្លាប់ ប្រជាពលរដ្ឋ មិន ទាន់ មាន គោល នយោបាយ បញ្ឈប់ ការសម្លាប់ ប្រជាពលរដ្ឋ នៅឡើយ នោះ ទេ ។ ដូច្នេះ បើ មិន មាន ចលនា រំដោះ ទេ នោះ ប្រជាពលរដ្ឋ ខ្មែរ នៅតែ រង ការកាប់ សម្លាប់ ឬ ស្លាប់ ដោយសារ ការធ្វើ ទារុណកម្ម នានា នៅក្នុង របប នោះ ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ « ការផ្តួលរំលំ ខ្មែរ ក្រហម បញ្ចប់ នូវ របប ប្រល័យ ពូជសាសន៍ បញ្ចប់ ការគ្រប់គ្រង ប្រទេស របស់ ប៉ុល ពត នៅ ឆ្នាំ ១៩៧៩ បាន ដេញ ខ្មែរ ក្រហម ឱ្យ ឈប់ សម្លាប់ មនុស្ស ស្មើនឹង ជួយសង្គ្រោះ ជីវិត មនុស្ស ជាង ៥លាន នាក់ ។ នេះ ជា ការពិត » ។
លោក បណ្ឌិត បន្ត ថា « ចង់ អ្នកឯង ថា ជា រឿង ចង កំហឹង ជា សិទ្ធិ របស់ អ្នកឯង ។ ប៉ុន្តែ សួរ ថា តើ ផល ពី ការផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ដោយ រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ គាំទ្រ ដោយ កងទ័ព វៀតណាម ស្ម័គ្រចិត្ត បាន ដេញ អាពត ចេញ ឱ្យ ឈប់ សម្លាប់ មនុស្ស ការពារ មនុស្ស ៥លាន នាក់ ទេ ? បើសិនជា ផល ការពារ ជីវិត ៥លាន នាក់ នេះ មិន ឱ្យ អាពត សម្លាប់ បន្ត ទៅ ទៀត ហ្នឹង ហើយ ជា ជោគជ័យ របស់ ជាតិ យើង » ។
លោក បណ្ឌិត បាន លើកឡើង ថា ការផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត មិន អាច ធ្វើ ទៅ បាន នោះ ឡើយ បើ គ្មាន ការជួយគាំទ្រ ពី ទ័ព ស្ម័គ្រចិត្ត វៀតណាម ទេ នោះ ព្រោះថា ពេល នោះ ចលនា តស៊ូ របស់ កម្ពុជា ដែល មាន រង្វង់ ត្រឹម ជាង ១ម៉ឺន នាក់ មិន អាច វាយ ផ្តួល របប ខ្មែរ ក្រហម បាន នោះ ឡើយ ។
ជាមួយគ្នា នេះ អង្គការ អន្តរជាតិ ក៏ មិន មាន គោល នយោបាយ លើកកម្លាំង វាយ ផ្តួលរំលំ របប ខ្មែរ ក្រហម នោះ ឡើយ បើ ទោះបី គេ ដឹង ពី ការរងគ្រោះ របស់ ពលរដ្ឋ ខ្មែរ តាម រយៈ ជនភៀសខ្លួន ក៏ដោយ នោះ ។ នេះ បើ យោង តាម អ្នកការទូត បរទេស មួយ រូប បញ្ជាក់ ប្រាប់ លោក ហ៊ុន ម៉ាណែត ។
លោក ហ៊ុន ម៉ាណែត បាន លើកឡើង ទៀត ថា ពេល នោះ កម្ពុជា គ្មាន ជម្រើស ណា ក្រៅពី ពឹង វៀតណាម ឬ ប្រទេស ថៃ ក្នុង ការជួយ វាយ ផ្តួល របប ខ្មែរ ក្រហម នោះ ឡើយ ។
