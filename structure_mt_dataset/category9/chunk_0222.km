( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៩នាក់ និង របួស ធ្ងន់ ស្រាល ៩នាក់ ។
ការវិនិយោគ ផ្ទាល់ នៅ បរទេស របស់ ប្រទេស កូរ៉េ ខាងត្បូង ធ្លាក់ចុះ ៥ភាគរយ នៅ ត្រីមាស ទី៣
( សេអ៊ូល ) ៖ ទិន្នន័យ របស់ រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង បាន បង្ហាញ កាលពី ថ្ងៃអង្គារ ថា ការវិនិយោគ ផ្ទាល់ នៅ បរទេស របស់ កូរ៉េ ខាងត្បូង បាន ធ្លាក់ចុះ ជា លើក ដំបូង ក្នុង រយៈពេល ៦ ត្រីមាស ក្នុង ត្រីមាស ទី បី ឆ្នាំ នេះ ។ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ិន ហួ ។
ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ិន ហួ បាន រាយការណ៍ ដោយ ដកស្រង់ ទិន្នន័យ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ កូរ៉េ ខាងត្បូង ថា ការវិនិយោគ ផ្ទាល់ នៅ បរទេស តាមរយៈ ការទិញ ភាគហ៊ុន បរទេស ឬ ការបង្កើត ការិយាល័យ បរទេស មាន ចំនួន ១៦. ៦១ ពាន់ លាន ដុល្លារ អាមេរិក ក្នុង ត្រីមាស ទី៣ ពោលគឺ ធ្លាក់ចុះ ៥ភាគរយ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ មុន ។
នេះ ជា ការធ្លាក់ចុះ លើក ដំបូង ក្នុង ៦ ត្រីមាស គិត ចាប់តាំងពី ត្រីមាស ទី១ ឆ្នាំ ២០២១ មក ដោយសារ ការកើនឡើង ភាព មិន ប្រាកដប្រជា ក្នុង ប្រទេស និង ក្រៅ ប្រទេស ដែល បណ្តាល មកពី ការដំឡើង អត្រា ការប្រាក់ យ៉ាង ឆាប់រហ័ស នៅក្នុង បណ្តា ប្រទេស ដែល មាន សេដ្ឋកិច្ច ធំ ៗ ។
ទីភ្នាក់ងារ ព័ត៌មាន ស៊ិន ហួ បាន រាយការណ៍ ថា ការវិនិយោគ ផ្ទាល់ របស់ កូរេ ខាងត្បូង នៅ ទ្វីប អាមេរិក ខាងជើង និង អាស៊ី បាន ធ្លាក់ចុះ ជា ពីរ ខ្ទង់ មក ត្រឹម ៦.៤៤ ពាន់ លាន ដុល្លារ និង ៣. ៥៨ ពាន់ លាន ដុល្លារ រៀង គ្នា ប៉ុន្តែ ការវិនិយោគ នៅ អឺរ៉ុប បាន កើនឡើង ៥៨. ៧ភាគរយ ដល់ ៣. ៣៦ ពាន់ លាន ដុល្លារ ។
ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ កូរ៉េ ខាងត្បូង បាន ឱ្យដឹង ទៀត ថា ការវិនិយោគ នៅ ក្រៅ ប្រទេស ក្នុង វិស័យ ហិរញ្ញវត្ថុ និង ធានារ៉ាប់រង និង ឧស្សាហកម្ម ផលិតកម្ម បាន កើនឡើង ដល់ ៧. ៥៨ ពាន់ លាន ដុល្លារ និង ៤. ១៧ពាន់ លាន ដុល្លារ រៀង គ្នា ប៉ុន្តែ ការវិនិយោគ ក្នុង វិស័យ អចលន ទ្រព្យ នៅ ក្រៅ ប្រទេស បាន ធ្លាក់ចុះ ៤៤.៩ ភាគរយ ដល់ ១. ២៧ ពាន់ លាន ដុល្លារ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន ស៊ិន ហួ ៕
រុស្សី អាច បង្កើន ការនាំចេញ ប្រេង ឆៅ បើ ការហាមឃាត់ របស់ អឺរ៉ុប កាត់បន្ថយ ការចម្រាញ់ ប្រេង របស់ ខ្លួន
ការហាម ប្រាម របស់ សហភាព អឺរ៉ុប លើ ការនាំចូល ផលិតផល ប្រេង ពី រុស្សី ចូល ជាធរមាន ចាប់ពី ថ្ងៃទី៥ ខែកុម្ភៈ ហើយ ស្ថិត នៅ អាទិភាព កំពូល នៃ ការរឹតបន្តឹង ការនាំចូល ប្រេង ឆៅ ដែល បាន ដាក់ តាំងពី ដើម ខែធ្នូ មក ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២២ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី ២៧ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ ប្រមុខ ការទូត រុស្ស៉ី ប្រាប់ អ៊ុយក្រែន៖ ចង់ បំពេញ តាម សំណើ របស់ មូស្គូ ដោយ ខ្លួន ឯង ឬ ចង់ឱ្យ កងទ័ព រុស្ស៉ី សម្រេច ជំនួស
៤៖ កូវីដ១៩៖ ចិន សម្រេច លុបចោល តម្រូវការ ធ្វើចត្តាឡី ស័ក សម្រាប់ អ្នកដំណើរ ចូលមក ក្នុង ប្រទេស
៥៖ កូរ៉េ ខាងជើង រៀបចំ កិច្ចប្រជុំ គណបក្ស កាន់អំណាច ដើម្បី ដាក់ ចេញ ផែនការ សម្រាប់ ឆ្នាំ ថ្មី
៦៖ ជើងហោះហើរ ជាង ៣. ៨០០ ទៀត នៅ សហរដ្ឋ អាមេរិក ត្រូវបាន លុបចោល ដោយសារ ព្យុះ ព្រិល
ជំនួប នេះ ធ្វើឡើង នៅ វិមាន សន្តិភាព រាជធានី ភ្នំពេញ ក្នុង គោលបំណង ដើម្បី ពង្រឹង និង ពង្រីក ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ កម្ពុជា - អាល់ហ្សេរី ។
លោក បណ្ឌិត អូស្មាន ហាស្សាន់ បាន សម្ដែង នូវ មនោសញ្ចេតនា សប្បាយរីករាយ និង ថ្លែងអំណរគុណ ចំពោះ ឯក អគ្គ រដ្ឋទូត នៃ ប្រទេស អាល់ហ្សេរី ប្រចាំ នៅ កម្ពុជា ដែល កន្លងទៅ ថ្មី ៗ នេះ បាន ខិតខំ ជួយ សម្របសម្រួល ដល់ ប្រតិភូ កម្ពុជា ក្នុង ការទៅ បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ប្រទេស អាល់ហ្សេរី ដែល ទទួលបាន លទ្ធផល ផ្លែ ផ្កា វិជ្ជមាន ជាច្រើន គួរ ជា ទី មោទនៈ ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត អូស្មាន ហាស្សាន់ បាន ជម្រាប ជូន ឯក អគ្គ រដ្ឋទូត ពី សន្តិភាព ស្ថេរភាព នយោបាយ សេដ្ឋកិច្ច ការអភិវឌ្ឍ ភាពរីកចម្រើន ជឿនលឿន សុខដុមនីយកម្ម ជាតិ សាសន៍ និង សាសនា នៅ កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក បាន បញ្ជាក់ ទៀត ថា សម្រាប់ សហគមន៍ ឥស្លាម នៅ កម្ពុជា រដ្ឋាភិបាល បាន ផ្ដល់ ឱកាស និង លទ្ធភាព ដោយ ស្មើ មុខ ស្មើ មាត់ ដូច ប្រជាពលរដ្ឋ ទូទៅ ។ សហគមន៍ ឥស្លាម កម្ពុជា មាន ឱកាស ចូលរួម បម្រើ ការងារ នៅ ស្ថាប័ន ព្រឹទ្ធសភា រដ្ឋសភា និង ក្នុង ជួរ រដ្ឋាភិបាល ចាប់ពី ថ្នាក់ ជាតិ ថ្នាក់ ក្រោម ជាតិ រហូតដល់ ថ្នាក់ មូលដ្ឋាន ជាច្រើន រូប ។
ក្នុង ឆ្នាំ ២០១៥ រាជ រដ្ឋាភិបាល ក៏ បាន ផ្តល់ ជូន សហគមន៍ ឥស្លាម កម្ពុជា នូវ គ្រូ ក្របខ័ណ្ឌ រដ្ឋ និង គ្រូ ជាប់ កិច្ចសន្យា ចំនួន ១. ៦៧៨ នាក់ ហើយ នៅ ពេល ថ្មី ៗ នេះ ទៀត ក៏ រដ្ឋាភិបាល កម្ពុជា បាន ផ្ដល់ជូន ដល់ បងប្អូន មុស្លិម បាន ធ្វើជា អភិបាល រង រាជធានី - ខេត្ត ១២ ចំនួន ១២រូប និង ជា អភិបាល រង ក្រុង ស្រុក ខណ្ឌ ៥០ ចំនួន ៥០ រូប ថែម ទៀត ផងដែរ ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត បាន ស្នើ ដល់ រដ្ឋាភិបាល អាល់ហ្សេរី សូម ផ្ដល់ អាហារូបករណ៍ ដល់ និស្សិត កម្ពុជា ក្នុង គោលបំណង ដើម្បី ផ្ដល់ ឱកាស ឲ្យ យុវជន ជំនាន់ ក្រោយ មាន ឱកាស កាន់តែ ទូលំទូលាយ ក្នុង ការពង្រឹង សមត្ថភាព របស់ ខ្លួន និង មាន លទ្ធភាព ខ្ពស់ ក្នុង ការចូលរួម អភិវឌ្ឍ ប្រទេសជាតិ នា ពេល អនាគត ។
ឯក អគ្គ រដ្ឋទូត បាន បន្ត ថា លោក សូម គាំទ្រ នូវ រាល់ សំណើ ទាំងអស់ ពី ភាគី កម្ពុជា ទាក់ទង នឹង ការអភិវឌ្ឍ សហគមន៍ ឥស្លាម កម្ពុជា ។ លោក បាន កោតសរសើរ ចំពោះ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន និង កំពុង ធ្វើឲ្យ មាន សុខដុមនីយកម្ម ជាតិ សាសន៍ និង ដឹកនាំ ប្រទេស ទទួលបាន សុខ សន្តិភាព គ្មាន អំពើហិង្សា គ្មាន ការរើសអើង មាន ការរីកចម្រើន ដែល ជា គំរូល្អ សម្រាប់ ពិភពលោក ទាំងមូល ។
សូម ជម្រាប ថា ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី រវាង កម្ពុជា និង អាល់ហ្សេរី មាន តាំងពី ឆ្នាំ ១៩៦២មក ម្ល៉េះ ។ ហើយ កាលពី អំឡុង ឆ្នាំ ១៩៧៣ សម្តេច ព្រះបាទ ន រោត្តម សីហនុ ព្រះបរម រតន កោដ្ឋ ទ្រង់ យាង ទៅ បំពេញ ព្រះរាជ ទស្សនកិច្ច ទៅ ប្រទេស អាល់ហ្សេរី ផងដែរ ៕
ករណី ឃាត់ខ្លួនអ្នកលេង មាន់ ជល់ ១២នាក់ នៅ ក្រុង តាខ្មៅ តំណាង អយ្យការសម្រេច ចោទប្រកាន់ តាម មាត្រា ៤ និង អនុញ្ញាតឲ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ជា បណ្តោះអាសន្ន
សូម ជម្រាប ថា មនុស្ស ១២នាក់ ត្រូវបាន ចាប់ខ្លួន កាលពី ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០២២ ក្នុង ដីឡូត៍ ចំការស្វាយ មួយ កន្លែង នៅក្នុង ភូមិ លេខ ៣ សង្កាត់ ស្វាយរលំ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
សូម បញ្ជាក់ ថា តាម ប្រភព សមត្ថកិច្ច បញ្ជាក់ ថា ក្រុម បញ្ជល់ មាន់ ទ្រង់ទ្រាយ ធំ ប្រចាំ សង្កាត់ ស្វាយរលំ ក្រុង តាខ្មៅ ត្រូវបាន កម្លាំង នគរបាល ការិយាល័យ ព្រហ្មទណ្ឌ កំរិត ស្រាល ខេត្ត កណ្តាល សហការ ជាមួយ កម្លាំង នគរបាល នៃ អធិការ ក្រុង តាខ្មៅ ក្របួច ជាប់ បាន ១២នាក់ ម៉ូតូ ជាង ២០ គ្រឿង រួម និង វត្ថុតាង មួយចំនួន ទៀត ។
សមត្ថកិច្ច ឱ្យដឹង ថា ជនសង្ស័យ មាន ចំនួន ១២នា ក់៖
យោង តាម ប្រភព ព័ត៌មាន បាន លួច បង្ហើប ថា ពួកគាត់ បាន ចាញ់បោក មេខ្យល់ ដោយ បង់ ថវិការ ទៅ គេ ម្នាក់ អស់ ៣០០ ដុល្លារ ជា ថ្នូរ នឹង ការដោះលែង តែ ធាតុ ពិត គ្មាន ច្បាប់ ណា ដាក់ទោស អ្នកលេង ល្បែងស៊ីសង ពោលគឺ គ្រាន់តែ ពិន័យ ប៉ុណ្ណោះ ដូច្នេះ ការបង់ ថវិការ អស់ ម្នាក់ ៣០០ ដុល្លារ គឺ ចាញ់បោក គេ យ៉ាង ពិតប្រាកដ ៕
លោក បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « វា មិន មែន ជា រឿង សម្ងាត់ សម្រាប់ នរណា ម្នាក់ ទេ ដែល គោលដៅ យុទ្ធសាស្ត្រ របស់ សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត ណា តូ គឺ កម្ចាត់ រុស្ស៊ី នៅលើ សមរភូមិ ដែល ជា យន្តការ មួយ សម្រាប់ ធ្វើឱ្យ ប្រទេស របស់ យើង ចុះខ្សោយ ឬ បំផ្លាញ ប្រទេស របស់ យើង » ។
គួរ បញ្ជាក់ ថា ប្រធានាធិបតី រុស្ស៉ី លោក វ្ល៉ាឌីមៀ ពូទីន បាន ចាប់ផ្តើម ការលុកលុយ របស់ លោក អ៊ុយក្រែន កាលពី ថ្ងៃទី ២៤ ខែកុម្ភៈ ដោយ ហៅ វា ថា ជា « ប្រតិបត្តិការ ពិសេស » ដើម្បី រំសាយ សព្វាវុធ អ៊ុយក្រែន ដែល លោក បាន និយាយ ថា ជា ការគំរាមកំហែង ដល់ រុស្ស៊ី ។ ចំណែកឯ ទីក្រុង កៀវ និង សម្ព័ន្ធមិត្ត លោក ខាងលិច បាន និយាយ ថា ការឈ្លានពាន របស់ ទីក្រុង ម៉ូស្គូ គ្រាន់តែ ជា ការដណ្តើមយក ទឹកដី របស់ ចក្រពត្តិនិយម ប៉ុណ្ណោះ ៕
លោក ឧកញ៉ា ទុយ គី ត្រូវបាន សមាជិក សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ ទាំង ចាស់ ទាំង ថ្មី បោះឆ្នោត ជ្រើសតាំង ជា ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត បន្ត សម្រាប់ អាណត្តិ ទី៣ លើក ទី១
( ពោធិ៍សាត់ )៖ លោក គឹម មាស សុខ សីហា អនុ រដ្ឋលេខាធិការ តំណាង លោក ម៉ៅ ថូរ៉ា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម . លោក ងួន ប៉ោសេង អភិបាល រង នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២២ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បោះឆ្នោត ជ្រើសរើស សមាជិក ជ្រើសតាំង សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ សម្រាប់ អាណត្តិ ទី៣ លើក ទី១ ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ សាលា មត្តេយ្យ ខេត្ត ពោធិ៍សាត់ ស្ថិត ក្នុង ភូមិ ពាល ញែក១ សង្កាត់ ផ្ទះ ព្រៃ ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ដែល រៀបចំឡើង ដោយ ក្រសួង ពាណិជ្ជកម្ម រដ្ឋបាល ខេត្ត និង សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ ដោយ បាន ការចូលរួម ពី លោកស្រី សេង សុម៉ុន ប្រធាន នាយកដ្ឋាន ទំនាក់ទំនង សភា ពាណិជ្ជកម្ម ខេត្ត - ក្រុង តំណាង ឯកឧត្តម ឧកញ៉ា ងួន ម៉េង តិច អគ្គ នាយក សភា ពាណិជ្ជកម្ម កម្ពុជា និង ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព មួយចំនួន ក្នុង ខេត្ត ។
ក្រោយពី ដំណើរការបោះឆ្នោត រាប់ សន្លឹក ឆ្នោត ដែល មាន ២ការិយាល័យ មាន អ្នក មក បោះឆ្នោត ចំនួន ១៥៩ នាក់ ស្មើនឹង ៧១. ៦២ % នៃ ចំនួន ក្នុង បញ្ជី បោះឆ្នោត ២២២ នាក់ . បេក្ខជន ឈរឈ្មោះ ចំនួន ១២រូប ក្នុង នោះ ជាប់ ឆ្នោត ចំនួន ៨រូប ។ ឆ្លង តាម លទ្ធផល នៃ ការបោះឆ្នោត នេះ សមាជិក ទាំង ចាស់ ទាំង ថ្មី ចំនួន ១៥ រូប បាន បោះឆ្នោត ជ្រើសតាំង លោក ឧកញ៉ា ទុយ គី ជា ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ សម្រាប់ អាណត្តិ ទី៣ លើក ទី១ ។
បន្ទាប់ពី លោក ឧកញ៉ា ទុយ គី ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ ថ្មី បាន ប្តេជ្ញា ថា នឹង ខិតខំ គៀង គរ រក អ្នក វិនិយោគ ដើម្បី មក អភិវឌ្ឍន៍ នៅក្នុង ខេត្ត ពោធិ៍សាត់ នោះ រួច មក . លោក ងួន ប៉ោសេង អភិបាល រង នៃ គណៈអភិបាល ខេត្ត និង លោក គឹម មាស សុខ សីហា អនុ រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម បាន សម្តែង ការអបអរសាទរ ដល់ សមាជិក ថ្មី នៃ សភា ពាណិជ្ជកម្ម ខេត្ត ព្រមទាំង បាន ជ្រើសរើស មេដឹកនាំ ដ៏ ល្អ របស់ ខ្លួន សម្រាប់ អាណត្តិ ទី៣ លើក ទី១ នា ពេលនេះ ។
ថ្នាក ដឹកនាំ ទាំង២ បាន លើកឡើង ថា ការរៀបចំ បោះឆ្នោត ជ្រើសរើស សមាជិក ជ្រើសតាំង សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ ស្រប តាម ការណែនាំ របស់ ក្រសួង ពាណិជ្ជកម្ម ព្រោះថា ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត គឺជា ក្បាល ម៉ាស៊ីន យ៉ាង សំខាន់ ក្នុង ការជួយ ដល់ ការអភិវឌ្ឍ វិស័យ ពាណិជ្ជកម្ម ឱ្យ កាន់តែ មាន ភាពរីកចម្រើន ពិសេស បាន ជួយ លើកស្ទួយ សេដ្ឋកិច្ច ក្នុង ខេត្ត តាមរយៈ ការគៀង គរ អ្នក វិនិយោគ មក បណ្តាក់ទុន ឬ ធ្វើ អាជីវកម្ម ដោយ ផ្ទាល់ ដើម្បី បង្កើត ការងារ និង បង្កើន ប្រាក់ ចំណូល ដល់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ។
ថ្នាក់ដឹកនាំ ទាំង ២ បាន បញ្ជាក់ ឱ្យដឹង ទៀត ថា សម្រាប់ ការបោះឆ្នោត សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ អាណត្តិ ទី៣ លើក១ បាន ប្រព្រឹត្តទៅ យ៉ាន រលូន ។ អ្នកចូលរួម បោះឆ្នោត បាន គោរព តាម លក្ខខណ្ឌ និង គោលការណ៍ ដែល ក្រសួង បាន កំណត់ ត្រឹមត្រូវ ៕
ក្រសួង រៀបចំ ដែនដី ចេញ សេចក្តីប្រកាស ព័ត៌មាន អំពី ទិសដៅ ដែល ដាក់ចេញ ដោយ សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ក្រសួង អនុវត្ត នៅ ឆ្នាំ ២០២៣
( ភ្នំពេញ ) ៖ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន ចេញ សេចក្តីប្រកាស អំពី លទ្ធផល នៃ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២២ និង លើក ទិសដៅ អនុវត្ត សម្រាប់ ឆ្នាំ ២០២៣ ។
សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២២ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៣ របស់ ក្រសួង រៀបចំ ដែនដី អ្នកចូលរួម សរុប ប្រមាណ ២ ០០០ នាក់ ដែល បាន ធ្វើឡើង ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ការណែនាំ របស់ សម្តេច តេជោ ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ របស់ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ រសៀល ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២២ ។
សម្តេច បាន ថ្លែង ថា « ត្រូវ បន្ត អនុវត្ត នូវ នយោបាយ ផ្តល់ ដី សម្បទាន សង្គមកិច្ច ជូន ចំពោះ ប្រជាពលរដ្ឋ ដែល ខ្វះ ដី ពិតប្រាកដ ហើយ ត្រូវ កំណត់ មុខ សញ្ញា នៃ ការផ្តល់ ដី ឲ្យ ដើម្បីឲ្យ ពួកគាត់ មាន ដី ពិតប្រាកដ ក្នុង ការកសាង ជីវភាព ។ ឯ មួយ ទៀត យើង បន្ត កសាង ផ្ទះ ជូន កម្លាំងប្រដាប់អាវុធ របស់ យើង ដែល ឈរជើង នៅ តាម ព្រំដែន ជាមួយ នោះ យើង ក៏ នឹង បន្ត កសាង ផ្ទះ សំរាប់ អតីត យុទ្ធជន ឲ្យ ពួកគាត់ មាន ផ្ទះ សំបែង កន្លែង ដែល ការពារ ព្រំដែន បាន ល្អ បំផុត គឺជា កន្លែង ដែល មាន ប្រជាជន រស់ នៅ នោះ ឯង » ។
សម្តេច នាយក រដ្ឋមន្ត្រី បាន ណែនាំ ក្រសួង រៀបចំ ដែនដី និង អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវ ជំរុញ ការអភិរក្ស នៅ តំបន់ រមណីយដ្ឋាន អង្គរ ស្រប គ្នា នឹង ការអភិវឌ្ឍ នៅ តំបន់ អភិវឌ្ឍ រុន តា ឯក និង តំបន់ ពាក់ ស្នែក ជូន បងប្អូន ប្រជាពលរដ្ឋ ដែល ស័្ម គ្រចិត្ត ចាកចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ ទៅ តាំង ទីលំនៅ ថ្មី នៅ តំបន់ នោះ ដោយ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ គោល នយោបាយ គាំទ្រ ផ្នែក សង្គមកិច្ច និង ផ្នែក ហេដ្ឋារចន សម្ព័ន្ធ ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ក្រសួង រៀបចំ ដែនដី និង អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវ បន្ត ដោះស្រាយ បញ្ហា ជូន ប្រជាជន ដែល រស់ នៅ ជា ភូមិករ នៅ ជុំវិញ បឹង ទន្លេ សាប ដោយ ធ្វើ បច្ចុប្បន្នភាព ផែនទី តាម ខេត្ត នីមួយ ៗ កែសម្រួល ព្រំប្រទល់ តំបន់ ៣ ព្រំប្រទល់ តំបន់ ២ និង កាត់ ឆ្វៀល ទីតាំង ដី ដែល ប្រជាជន រស់ នៅ ពី យូរ លង់ មកហើយ ក្នុង តំបន់ ៣ និង តំបន់ ២ ឱ្យ ចប់ នៅ ចុង ខែឧសភា ឆ្នាំ ២០២៣ ។
សម្តេច តេជោ សង្កត់ធ្ងន់ យ៉ាង ដូច្នេះ ថា « បណ្តា ខេត្ត ដែល ខ្ញុំ បាន ដើរ គ្រប់ ខេត្ត ហើយ ខេត្ត មួយ ៗ ត្រូវ ធ្វើ ផែន មួយ ៗ កន្លែងណា កាត់ ឆ្វៀល ឲ្យ ប្រជាជន រួមទាំង អ្នក រស់ នៅក្នុង តំបន់ ៣ រក វិធី ធ្វើ យ៉ាងណា កាត់ ឆ្វៀល ឲ្យ គាត់ ត្រូវ ធ្វើឲ្យ ស្រូត ។ ខ្ញុំ ដាក់ កំណត់ កុំ អូសបន្លាយ យូរ ពេក ព្រោះ ឆ្នាំ នេះ ខ្ញុំ បាន ចេញ បញ្ជា លើ បញ្ហា នេះ ក្នុង ខែ៥ ឥឡូវ ខ្ញុំ ដាក់ កណត់ ថា នៅ ចុង ខែឧសភា ឆ្នាំ ២០២៣ ត្រូវ ធ្វើឲ្យ រួចរាល់ គ្រប់ ខេត្ត និង ទូទាំង ប្រទេស ទាំងអស់ ក្នុង តំបន់ ទន្លេ សាប » ។
សម្តេច តេជោ បញ្ជាក់ ថា ការដោះស្រាយ បញ្ហា ជូន ប្រជាជន ដែល រស់ នៅ ជា ភូមិករ នៅ ជុំវិញ បឹង ទន្លេ សាប នេះ ជា ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ដែល អាច ដោះស្រាយ បាន ទាំង ពីរ ទិសដៅ ដោយ ទិស ម្ខាង រក្សា បាន នូវ បឹង ទន្លេ សាប និង ម្ខាង ទៀត គឺ ប្រជាពលរដ្ឋ ដែល រស់ នៅ យូរយា ហើយ ទទួលបាន សិទ្ធិ កាន់កាប់ ដីធ្លី របស់ ពួកគាត់ ។
* ខេត្ត កំពង់ឆ្នាំ ង៖ កាត់ ឆ្កៀល ផ្ទៃដី ទំហំ ២៥៣ ហិកតា ១៨អា ២៩សង់ទី អា ចេញ ពី តំបន់ ៣ និង ផ្តល់ ជា កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ចំនួន ១ ៦៨៨ គ្រួសារ និង កែសម្រួល ផ្ទៃដី ទំហំ ៣ ៣៩១ ហិកតា ចេញ ពី តំបន់ ៣បញ្ចូល មក ក្នុង តំបន់ ២ និង ផ្ដល់ ជា សិទ្ធិ ប្រើប្រាស់ និង អាស្រ័យ ផល ជូន ប្រជាពលរដ្ ឋ ១៦៨៨ គ្រួសារ ខាងលើ ស្ថិត នៅ ឃុំ សំរោងសែន និង ឃុំ ផ្លូវ ទូក ស្រុក កំពង់លែង
* ខេត្ត ពោធិ៍សាត់៖ បាន កែសម្រួល ផ្ទៃដី ទំហំ ៣ ៤៤៨ ហិកតា ៧៧ អា ចេញ ពី តំបន់ ៣បញ្ចូល មក ក្នុង តំបន់ ២ និង ផ្តល់ ជា សិទ្ធិ និង អាស្រ័យ ផល ជូន ប្រជាពលរដ្ឋ ចំនួន ១៦៥៨ គ្រួសារ ស្ថិត នៅ ឃុំ កំពង់ពោធិ៍ ឃុំ កំពង់ លួង ឃុំ អន្សា ចំបក់ និង ឃុំ អូរ សណ្តាន់ ស្រុក ក្រគរ . ឃុំ កញួរ ឃុំ រាំង ទិល ឃុំ ស្យា និង ឃុំ ស្រែ ស្ដូក ស្រុក កណ្ដៀង និង ឃុំ បឹង បត់ កណ្ដាល ឃុំ មេ ទឹក និង ឃុំ អូរតាប៉ោង ស្រុក បាកាន
* ខេត្ត កំពង់ធំ៖ បាន កែសម្រួល ផ្ទៃដី ទំហំ ១០ ០១៤ ហិកតា ១៦អា ចេញ ពី តំបន់ ២ បញ្ចូល មក ក្នុង តំបន់ ១ និង ផ្តល់ ជា កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ចំនួន ៩១៤៤ គ្រួសារ ស្ថិត នៅ ភូមិសាស្ត្រ ស្រុក ស្ទោង ស្រុក កំពង់ស្វាយ ស្រុក សន្ទុក និង ស្រុក បារាយណ៍ និង បាន កែសម្រួល ផ្ទៃដី ទំហំ ៦ ៣៨៥ ហិកតា ស្មើនឹង ២ ០២៥ ក្បាល ដី ចេញ ពី តំបន់ ៣ បញ្ចូល មក ក្នុង តំបន់ ២ និង ផ្តល់ សិទ្ធិ កាន់កាប់ និង អាស្រ័យ ផល ជូន ប្រជាពលរដ្ឋ ចំនួន ១ ៧៤៩ គ្រួសារ ស្ថិត នៅ ស្រុក តាំង គោក និង ស្រុក កំពង់ស្វាយ
* ខេត្ត បាត់ដំប ង៖ បាន កែសម្រួល ផ្ទៃដី ទំហំ ៤០២ ហិកតា ៤០ អា ចេញ ពី តំបន់ ៣បញ្ចូល មក ក្នុង តំបន់ ២ និង ផ្តល់ ជា សិទ្ធិ ប្រើប្រាស់ និង អាស្រ័យ ផល ជូន ប្រជាពលរដ្ឋ ចំនួន ១៩១ គ្រួសារ ស្ថិត នៅ ឃុំ ព្រែក ហ្លួង ឃុំ ព្រែក នរិន្ទ និង ឃុំ ពាម ឯក ស្រុក ឯក ភ្នំ និង បាន កែសម្រួល ផ្ទៃដី ទំហំ ៩៨៧ ហិកតា ៩៥ អា ចេញ ពី តំបន់ ២ បញ្ចូល មក ក្នុង តំបន់ ១ និង ផ្តល់ ជា កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ចំនួន ១២០៩ គ្រួសារ ស្ថិត នៅ ឃុំ ព្រៃ តូច ឃុំ ក កោះ ឃុំ តាលាស់ និង ឃុំ ជ្រៃ ស្រុក មោង ឬ ស្សី
ការណែនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២២ នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ចាស់ និង លើក ទិសដៅ ការងារ ឆ្នាំ ថ្មី របស់ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ដូចនេះ ថា « ត្រូវ បន្ត លើកទឹកចិត្ត ឱ្យ មាន ការ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ នៅ មូលដ្ឋាន ជាពិសេស វិវាទ ដីធ្លី ដើម្បី ពង្រឹង សុវត្ថិភាព នៃ ការកាន់កាប់ បង្កើត ភាព សុខសាន្ត សុខដុមរមនា ក្នុង សង្គម បង្ករ ភាព អនុគ្រោះ ដល់ ដំណើរការអភិវឌ្ឍ សង្គម សេដ្ឋកិច្ច នៅ តាម មូលដ្ឋាន និង ឈាន ទៅ បង្កើន ល្បឿន នៃ ការកាត់បន្ថយ ភាពក្រីក្រ ចំណុច នេះ ខ្ញុំ តែងតែ មាន សំណូមពរ ជា បន្តបន្ទាប់ ឱ្យ មាន ការយកចិត្តទុកដាក់ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ » ។
ពាក់ព័ន្ធ នឹង ជម្លោះ ដីធ្លី នា សម័យ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ដូចនេះ ថា « ក្នុង ជម្លោះ ដីធ្លី នេះ បាន លាតសន្ធឹង សូម្បីតែ ខ្លួនខ្ញុំ ធ្លាប់ បាន ដឹកនាំ ធ្វើ បាតុកម្ម ប្រឆាំង ចំពោះ លោកជំទាវ តុ ប ប្អូន របស់ សម្តេច ចក្រី ជូ ឡុង នៅ ចំការ ថ្មី ដែល បំពាន លើ ដីធ្លី របស់ ខ្ញុំ ហើយ ខ្ញុំ ក៏ ត្រូវ ប៉ូលីស ដេញ តាម ចាប់ រហូត ខ្ញុំ បាន ធ្លាក់ ទៅដល់ ខេត្ត ក្រចេះ ចឹង ពេល នោះ គឺ បាន សេចក្តី ថា ប្រទេស របស់ យើង មាន សន្តិភាព ប្រជាពលរដ្ឋ បាន ស្វះស្វែងរក ដី គ្រប់ កន្លែង » ។
សម្តេច តេជោ ហ៊ុន សែន បាន បន្ថែម ថា ដោយសារ កត្តា សន្តិភាព នៅ ពេល នោះ ហើយ ទើប ធ្វើឱ្យ ជម្លោះ ដីធ្លី បាន កើតឡើង ដែល រឿង ដីធ្លី នេះ គឺ មិន មែន ជា រឿង ថ្មី ថ្មោង នោះ ទេ ។ ប៉ុន្តែ ដី ទាំងនោះ ក៏ ត្រូវបាន បោះបង់ ចោល នៅ ពេល ដែល ប្រទេស បាន បាត់បង់ សន្តិភាព វិញ នៅក្នុង ឆ្នាំ ១៩៧០ នៅ ពេល ដែល ប្រទេស បាន ផ្ទុះ នូវ ភ្លើង សង្គ្រាម ឡើងវិញ គ្មាន អ្នកណា ចង់បាន ដី ទៀត នោះ ទេ ។
កាមេរ៉ា សុវត្ថិភាព មុខ ក្រោយ ម៉ូឌែល ថ្មី DashCam ជា ប្រភេទ កាមេរ៉ា ដែល បាន ភ្ជាប់ មក ជាមួយ វីដេអូ ច្បាស់ ត្រជាក់ ភ្នែក ធន់ ក្នុង ការប្រើប្រាស់ បាន រាប់ ឆ្នាំ មាន ការធានា ត្រឹមត្រូវ និង ផ្តោត លើ គុណភាព ជា ចម្បង ។
