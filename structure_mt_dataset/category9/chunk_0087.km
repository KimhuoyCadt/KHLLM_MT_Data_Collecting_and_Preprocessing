ខ្ញុំមិនដែលដឹងថាខ្ញុំអាចរៀនបានច្រើននោះទេ » ។
ប្រសិនបើ អ្នក ស្គាល់ ខ្ញុំ អ្នក នឹង ស្គាល់ ព្រះបិតា របស់ ខ្ញុំ ។
ដូចជាឧទាហរណ៍នេះ … តើជាកំហុសអ្នក ណា ?
គេដឹងថាខ្ញុំជាមេ» ។
ដោយមិនច្បាស់ គាត់បានឃើញស្លាប ។
ដែល ដាក់ វា នៅក្នុង កុន អរងឹង ។
ជា លទ្ធផល យើងជាមនុស្សធំ ហើយធ្ងន់ ។
គាត់ គួរតែ មាន ភ្នែក ច្រើន លើ គាត់ ។
ខ្ញុំ សូម អញ្ជើញ អ្នក ឱ្យ ស្តាប់ ផ្នែក ដំបូង នៃ កំណាព្យ ។
ខ្ញុំ ចង់ ចាប់ យក បុគ្គលិក លក្ខណៈ របស់ អ្នក តាមរយៈ កញ្ចក់ ។
វាជាបែបនេះតាំងពីខែ មករាមក » ។
មាន តែការ សារភាពដោយ ស្មោះត្រង់ចំពោះព្រះ ហើយស្រែកទាមទារការ អភ័យទោសពីព្រះ។
លេខ កូដ អាច សាកល្បង ដោយ ខ្លួន វា ហើយ ខ្ញុំ ពិតជា ភ្ញាក់ផ្អើល នឹង វា ។
កំពុងចោទប្រកាន់គាត់ ដូច្នេះ ខ្ញុំបាននាំគាត់ទៅ កាន់ក្រុមប្រឹក្សាជំនុំ ជម្រះរបស់ពួកគេ ។
« យើងចង់ឱ្យការ ពិតត្រូវបានលាត ត្រដាងទាក់ ទងនឹងអ្វីដែលបានកើតឡើង កាលពីឆ្នាំមុន » ។
អ្នកវិភាគ បាន និយាយ ថា ទោះជា យ៉ាងណា ក៏ដោយ ការបញ្ជាទិញ មួយចំនួន អាច ស្ថិត ក្នុង ចំណោម ជាង 300 ពី អ្នកទិញ ដែល មិន បាន បង្ហាញ ឱ្យ ឃើញ ដែល បាន បង្ហោះ នៅ ឆ្នាំ នេះ ហើយ វា មិន ទាន់ យល់ ថា ចំនួន ប៉ុន្មាន នៃ កិច្ចព្រមព្រៀង ចិន នឹង ក្លាយជា អាជីវកម្ម ថ្មី ទាំងស្រុង ។
ហើយ ប្រាកដ ណាស់ វា គឺ អំពី ការស្វែងរក សេចក្ដីមេត្តា ករុណា និង ព្រះគុណ របស់ ព្រះជាម្ចាស់ តាមរយៈ ព្រះអង្គ ដែល បាន យាង មក សង្គ្រោះ មនុស្ស ពី អំពើ បាប របស់ ពួកគេ ។
គាត់ ជា អ្នក បំរើ សាធារណៈ ។
ដោយមិនពេញ ចិត្តនឹងការ ធ្វើការ ដីនោះ គាត់បានចេញដំណើរឆ្មក់ចូលជាច្រើន ។
យើងចង់ឲ្យមាន ភាពត្រឹមត្រូវតាមប្រវត្តិសាស្ត្រនិងរឿងអាក្រក់ » ។
ហើយមានព្រះបន្ទូលថា ព្រះអម្ចាស់នឹងអត់ទោសអោយគាត់ ។
សំណួរ ទាំងអស់ នេះ នៅក្នុង ចិត្ត របស់ អ្នក នៅ ថ្ងៃ នេះ ។
ការ សម្របសម្រួលជាមួយអង្គភាពនានា ...
ព្រះពរ ជារបស់អ្នកតាម រយៈព្រះរាជបុត្រារបស់ខ្ញុំជាព្រះ មហាក្សត្រ ... .
ក្លាក សុន នៅក្នុង ពិធី សម្ពោធ លើក ទី ពីរ របស់ បារ៉ាក់ អូបាម៉ា ។
ការ ដែលពួកគេមិនមានសណ្តាប់ធ្នាប់រំខានខ្ញុំ ។
គាត់គេងមិនបានច្រើន មិនថាពេលថ្ងៃ ឬយប់ ។
គ្រួសារ របស់ គាត់ បាន ធ្វើ អន្តោប្រវេសន៍ ដើម្បី អាន បន្ថែម ។
នៅ ទីបំផុត ពួកគេ បាន រកឃើញ ក្រុមហ៊ុន ដែល យល់ព្រម ជាមួយ ពួកគេ ។
វា ត្រូវតែ កើតឡើង ហើយ វា បាន កើតឡើង ។
បញ្ឈប់ការ បង្កាត់ពូជ ព្រោះសត្វច្រើនពេកងាប់ជារៀងរាល់ថ្ងៃ ។
និយាយ អំពី ការបោះជំហាន ទៅ មុខ យ៉ាង ធំ ។
តួលេខ ទាំង នេះ គឺជា អាហារ សម្រាប់ ការគិត ខណៈ ដែល របាយការណ៍ ទីផ្សារ ការងារ ផ្លូវការ របស់ សហរដ្ឋ អាមេរិក ( បញ្ជី ប្រាក់ បៀវត្សរ៍ មិន មែន កសិកម្ម ) នឹង ត្រូវ ចេញផ្សាយ នៅ ថ្ងៃសុក្រ ។
អរគុណ ចំពោះ ជំនួយ ខ្ញុំ បាន ចាកចេញ ពី តំបន់ នោះ ។
គាត់ មិន បាន រត់ ដោយ មាន ទំនុកចិត្ត ជាពិសេស បី ជំហាន ដំបូង ។
ប្រាប់ ខ្ញុំ ប្រសិនបើ អ្នក មិន អាច យល់ បាន ។
តាមពិត ទៅ ខ្ញុំ ធ្លាប់ គិត ថា ខ្ញុំ នឹង មិន ប្រលង ជាប់ ទេ ព្រោះ ខ្ញុំ ធ្វើ ខុស ច្រើន ។
នៅថ្ងៃ បន្ទាប់ ខ្ញុំនិយាយទៅនាងថា ចូរឲ្យកូនរបស់អ្នកបរិភោគទៅ ប៉ុន្តែនាងបានលាក់ទុកកូនប្រុសរបស់នាងហើយ » ។
តើគាត់ចង់មានផ្លូវរបស់គាត់ដោយ សារ តែគាត់ចង់អះអាងខ្លួនឯងឬ ?
តើនេះមាន ន័យថាពួកគេនឹងព្យាយាម កាន់តំណែងជាឪពុកម្តាយរបស់កូនដែលកើតមកឬ ?
វាមិនធ្វើឱ្យអ្នកចង់ស្ទាបខ្នងនៃ រ៉ូប បន្ទាប់ក៏ដូចខាងមុខ ?
លាតត្រដាង យ៉ាងម៉េច !
ភាគ ច្រើន នៅក្នុង ភាពស្ងៀមស្ងាត់ ប៉ុន្តែ ពួកគេ កំពុង កើនឡើង ។
អ្វីដែលទ្រង់បាន សន្យាបានសម្រេចហើយ !
អ្នក បាន ឡើង ប្រទេស ។
គាត់បាននិយាយថា៖ “ ខ្ញុំបានលេងជាមួយគាត់ច្រើន ។
លោកយេស៊ូបានមាន ប្រសាសន៍ថា៖ « ប្រសិនបើព្រះរាជបុត្រាដោះលែងអ្នក រាល់គ្នា នោះអ្នកនឹងមានសេរីភាពយ៉ាងពិតប្រាកដ » ។
គ្មានការ ធ្វើឲ្យគាត់ខ្វិន ក្រវាត់មុខគាត់ ឬរារាំងគាត់ឡើយ ។
នោះជាអ្វីដែល យ៉ូហានសរសេរនៅក្នុងសំបុត្រទី ពីររបស់គាត់ទៅ កាន់ក្រុមជំនុំរបស់គាត់ ដោយសុំឲ្យពួកគេស្រឡាញ់គ្នាទៅវិញទៅមក ដោយគោរពតាមព្រះ ( ២យ៉ូហាន ១:៥ ៦) ។
កៅអី រញ្ជួយ ពីរ បាន បាក់ ខ្នង ។
គាត់ឆ្លើយ ថា៖ « បើអ្នកមានជំនឿតូចដូចគ្រាប់ ម្រុំ អ្នកអាចនិយាយទៅ កាន់ដើមស្វាយនេះថា ' ត្រូវកាត់ចេញ ហើយដាំនៅក្នុងសមុទ្រ ' នោះវានឹងស្តាប់តាមអ្នក ។
គាត់ឆ្លើយ ថា៖ « បើអ្នកមានជំនឿតូចដូចគ្រាប់ ស្ពៃនោះ អ្នកអាចនិយាយទៅ កាន់ដើមស្វាយនេះថា ' ត្រូវកាត់ចេញហើយដាំនៅក្នុងសមុទ្រ ' នោះវានឹងស្តាប់តាមអ្នក ។
ច្រាំង ទន្លេ នៃ បឹង ធំ ទាំង ប្រាំ គឺ សម្បូរ ទៅ ដោយ ភាពផ្ទុយ គ្នា ។
ផ្តល់ ភាពក្លាហាន និង កម្លាំង ដល់ ពួកគេ នៅ ថ្ងៃ ខាងមុខ ។
គាត់ជាមនុស្សសំខាន់ម្នាក់ក្នុងអាជីពរបស់ខ្ញុំ ហើយជាអ្នកដែលខ្ញុំចាត់ទុកបងប្រុសខ្ញុំ ។
តាំងពីពេលនោះមក តាំងពីដើមអាណត្តិដំបូងមក លោករងការ វាយ ប្រហារទាំងយប់ទាំងថ្ងៃ ។
ភ្នែកអ្នក ណាដែលសម្លឹងមើលខ្ញុំនឹងលែងឃើញខ្ញុំទៀតហើយ ។ ភ្នែកអ្នកនឹងសម្លឹងរកខ្ញុំ ប៉ុន្តែខ្ញុំនឹងបាត់ទៅ ។
បើអ្នក ណានិយាយថា “ ខ្ញុំស្រឡាញ់ព្រះ” ប៉ុន្តែស្អប់បងប្អូនខ្លួន នោះជាអ្នកកុហក ។
ថ្វីត្បិតតែ គ្រឿង តុបតែង លម្អ ទាំងអស់ ត្រូវបាន តុបតែង យ៉ាង ប្រណីត ក៏ដោយ ។
នាង រស់ នៅក្នុង ផ្ទះ តូច មួយ ជាមួយ គ្រួសារ របស់ នាង ហើយ មើល ទៅជា មនុស្ស ដែល មាន សុភមង្គល និង សម្រប ខ្លួន បាន ល្អ ។
ឈ្មោះ តារាង ត្រូវតែ សរសេរ ជា អក្សរ ធំ នៅក្នុង សំណួរ នេះ ។
អ្នក បានបង្ហាញខ្ញុំពីអ្វីដែលវាមានសេរីភាព ហើយតើការ ទទួលខុសត្រូវមាន ន័យ ដូចម្តេច ។
ក្នុង ន័យទំនើប លោកយេស៊ូមាន ប្រសាសន៍ថា៖ « ស្រឡាញ់ខ្ញុំឲ្យអស់ពី ចិត្ត » ។
យ៉ាង ណាមិញ នេះជាទង្វើគួរឲ្យ តក់ស្លុតសម្រាប់អ្នក ដទៃដែលនៅជុំវិញខ្លួន ។
យើងបានធ្វើវិស្សមកាលជាលក្ខណៈគ្រួសារពីរជាមួយមិត្តភ័ក្ដិរបស់យើង ។
ស៊េរី៖ ជីវិត សម័យ ទំនើប របស់ រ៉ុក កូ - ការប្រើប្រាស់ ១
ខ្ញុំអធិស្ឋានកុំឲ្យយើងជាហ្វូងអ្នកស្រុក ។
សូម កត់សម្គាល់៖ យើង ជា អ្នក ជឿ លើ លទ្ធិ ស៊ូហ្វី ។
លុយ មិន អាច ជា បញ្ហា ចម្បង នៅក្នុង ការសម្រេចចិត្ត ដ៏ សំខាន់ បែប នេះ ទេ ។
ហ្វូង មនុស្ស នៅ ខាងក្រោម មាន ន័យ ថា
" មុននឹងខ្ញុំសម្រេច ចិត្តថាតើវាសមនឹងបញ្ហារបស់ខ្ញុំឬអត់ ខ្ញុំចង់ស្តាប់រឿងទាំង ស្រុង " ។
ខ្ញុំ ត្រូវការ អ្នក ដើម្បី ផ្គាប់ ចិត្ត ខ្ញុំ ។
ដូចព្រះ យេស៊ូវបានឆ្លៀតពេលបើកភ្នែកមើលបុរសខ្វាក់ទាំងពីរនាក់ដែរ ។
ម៉ាថា យ 20:26 ក្នុងចំណោមអ្នក រាល់គ្នា វានឹងមិនដូច្នោះទេ ប៉ុន្តែអ្នក ណាដែលចង់ក្លាយជាអ្នកធំត្រូវធ្វើជាអ្នក បម្រើរបស់អ្នក ។
ប្រធានបទ៖ និយមន័យ នៃ វេទមន្ត ។
គាត់ក៏បាននិយាយថា “ ខ្ញុំបានផឹកស្រាបៀរជាមួយមិត្ត ភក្តិ …
យ៉ាង ណាមិញ មានមនុស្សមួយចំនួនមានអារម្មណ៍ថា …
យើង តំណាង ឱ្យ សង្កាត់ ទាំងអស់ នៅក្នុង ទីក្រុង នេះ ។
តើលុយដែលមិនគួរប្រើសម្រាប់អ្វីក្រៅពីប្រាក់បៀវត្សរ៍ទៅឯណា ?
ការ បញ្ឈប់ការ បាញ់ផ្លោងត្រូវបានរាយការណ៍នៅក្នុងទីក្រុង Donetsk ដែល កាន់កាប់ដោយក្រុមឧទ្ទាម បន្ទាប់ពីពាក់កណ្តាលអធ្រាត្រ ។
គាត់ ស្គាល់ ផ្លូវ របស់ ព្រះ។ គាត់ យល់ ពី ផែនការ និង គោលបំណង របស់ ព្រះ។
ផលិតផល ទាំងនេះ ត្រូវបាន ប្រើប្រាស់ ដោយ គ្រប់ ក្រុមហ៊ុន ស្បែកជើង ធំ ៗ ។
តើ អ្វី សំខាន់ សម្រាប់ ការបាញ់ ក្បាល ?
នៅពេល មួយ វា ជា កម្មសិទ្ធិ របស់ គ្រួសារ នីមួយ ៗ ។
ធ្វើបែបនេះ អ្នកអាចជួយជីវិតអ្នក ណាម្នាក់នៅថ្ងៃ ណាមួយ » ។
