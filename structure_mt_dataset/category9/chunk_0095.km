ខ្ញុំមិនប្រើខ្សែជីវិតទេ ទោះបីជាវាមានប្រយោជន៍សម្រាប់ជាងដេរប៉ាក់ខ្លះក៏ដោយ ។
ហើយមិនទាន់ រកឃើញដៃគូដែលអាចសម្រេចបាននៅឡើយទេ ។
៦ហើយទ្រង់បានប្រទានដល់មនុស្សដោយជំនាញ ដើម្បីទ្រង់នឹងបាន ត ម្កើងដោយការ ប្រព្រឹត្តដ៏ អស្ចារ្យរបស់ទ្រង់ ។
" មិនមែនពិតទេ ប៉ុន្តែជាអ្វីដែលមនុស្សស្រីភាគច្រើននិយាយ " ។
ឥឡូវនេះ ខ្ញុំ អាច មើល រឿង ភាគ ទូរទស្សន៍ !
មនុស្ស ភាគ ច្រើន មិន ចូលចិត្ត ភាព កខ្វក់ ទេ ។
ដើម្បី មើល អ្វី ដែល ពិភពលោក កំពុង ធ្វើ ។
វាជាការ ជិះយូរមក ទល់ ពេលនេះ ហើយខ្ញុំព្យាយាមរក្សា ភាព វិជ្ជមាន ។
ខ្ញុំចង់មាន ន័យថា តើមានយុត្តិធម៌ទេក្នុងលោក ?
ដៃម្ខាងទៀតត្រូវខ្សែអង្រឹង ហើយ រត់មក រកយើង
ក្រុមហ៊ុន ផលិត រថយន្ត ចុងក្រោយ បំផុត ដើម្បី ធ្វើ ការផ្លាស់ប្តូរ ។
អ្នកក្ររង ទុក្ខ ដោយសារ ភាពក្រីក្រ ។
៣៧ « ខ្ញុំដឹងថា អ្នក រាល់គ្នាជាកូនចៅរបស់លោកអប្រាហាំ ប៉ុន្តែ អ្នក រាល់គ្នារកសម្លាប់ខ្ញុំ ព្រោះពាក្យរបស់ខ្ញុំគ្មានកន្លែងនៅក្នុងអ្នកឡើយ ។
៤ អ្នកស្គាល់ផ្លូវទៅ កាន់កន្លែងដែលខ្ញុំទៅ ។
គាត់ នឹង មក នៅ ថ្ងៃស្អែក ។
ទោះបីជាអ្នកមានកាតព្វកិច្ចមើលថែរបស់គាត់ក៏ដោយ ។
« ហើយពេលដែលខ្ញុំត្រូវបានលើកឡើងពីផែនដីនឹងទាញមនុស្សទាំងអស់មក រកខ្លួនខ្ញុំ » ។
« ហើយពេលដែលខ្ញុំត្រូវបានលើកឡើងពីផែនដី នោះនឹងទាញមនុស្សទាំងអស់មក ឯខ្លួនខ្ញុំ » ។
តាម សម្ដីរបស់លោកបណ្ឌិត ហ្វីល « ពេលខ្លះ យើងត្រូវ តែផ្ដល់ឲ្យខ្លួនយើងនូវអ្វីដែលយើងសមនឹងទទួល ពីអ្នក ដទៃ » ។
« កុំបាក់ទឹកចិត្តឡើយ ដ្បិតព្រះអម្ចាស់ ជាព្រះ របស់អ្នក នឹងគង់នៅជាមួយអ្នកគ្រប់ទីកន្លែងដែលអ្នក ទៅ » ។
និង ឱសថ ផ្ទះ ; វាដូចជាពួកគេត្រូវបានគេធ្វើឱ្យក្លាយជាផ្នែកនៃអាហារ » ។
ដូច្នេះ ពួកគេ បាន បង្រៀន ព្រះបន្ទូល របស់ ព្រះ។
ដ្បិតភ្នែកទូលបង្គំបានឃើញសេចក្ដីសង្គ្រោះរបស់ទ្រង់ ។
53 ដូច្នេះ ចាប់ពីថ្ងៃនោះមក គេតាំង ចិត្តសម្លាប់គាត់ ។
វា ជា ច្បាប់ នៃ អំពើ បាប និង សេចក្តីស្លាប់ ។
តើខ្ញុំនឹង មក រកអ្នកដោយរំពាត់ ឬដោយ ចិត្តស្រឡាញ់ និងសុភាព ? › ។
៣៨:៤ ពេលខ្ញុំចាក់គ្រឹះផែនដី តើអ្នកនៅឯណា ?
លើសពីព្រះ យើងមិនសក្តិសមនឹងទ្រង់ទេ ។
16 បងប្អូនជាទី ស្រឡាញ់អើយ កុំត្រូវបោកបញ្ឆោតឡើយ ។
សម្រាប់ អ្នក ដែល ចំណាយ ពេល ច្រើន ក្នុង ការធ្វើដំណើរ ។
ចាំមើលថាអ្នក និយាយត្រូវអត់ល្អរបស់ខ្ញុំ !
ធ្វើឱ្យយើងក្លាយជាគំរូសម្រាប់អ្នកដែលបំពេញកាតព្វកិច្ចរបស់ខ្លួន » ។
វាជាដីកាមួយដែលបើអនុវត្ត
ហើយ អ្នក នឹង ឃើញ ពន្លឺ នៃ ថ្ងៃ
ត្រូវបាន តែងតាំង សម្រាប់ គាត់ ។
« ពេលដែលខ្ញុំបញ្ជូនអ្នកទៅដោយមិនមានកាបូបលុយ ឬស្បែកជើងមួយបាវ តើអ្នកត្រូវការ អ្វីទេ ?
យើងភ័យរន្ធត់ចំពោះក្រុម ISIS នៅអ៊ីរ៉ាក់ ។
ប្រហែលជានៅពេលអនាគត យើងអាចជួបជុំគ្នា ហើយឈានដល់ កិច្ចព្រមព្រៀងលើអ្វីដែលល្អបំផុតសម្រាប់ប្រជាជនអាមេរិក » ។
អាពាហ៍ពិពាហ៍លើកទីពីររបស់លោកកើតមានរយៈពេលបីឆ្នាំ បន្ទាប់ពីភរិយារបស់លោកបានស្លាប់ ។
ព្រះបាទដាវីឌ និងសាឡូម៉ូន ជាបុត្ររបស់ទ្រង់ក៏ដូច្នោះដែរ ។
តើ អ្នកណា កំពុង ព្យាយាម ចូល ទៅក្នុង ផ្ទះល្វែង របស់ យើង ?
ដ្បិតអ្នក ណាធ្វើតាមព្រះហឫទ័យរបស់ព្រះ អ្នក នោះជាបងប្អូនស្រី និងម្ដាយរបស់ខ្ញុំ » ១
ហើយ ដូច ដែល វា ត្រូវបាន សរសេរ បន្ទុក របស់ ពួកគេ គឺ ស្រាល ។
និង អាជីព , តាំងចិត្ត ដើម្បី រស់ នៅ ជាមួយគ្នា និង ស្រូបយក នៅក្នុង ការថ្វាយបង្គំ គ្នា ទៅ វិញ ទៅមក ។
សេចក្ដីសង្ឃឹមរបស់មនុស្សសុចរិតនាំ មកនូវ អំណរ តែសេចក្ដីសង្ឃឹមរបស់មនុស្សអាក្រក់នឹងត្រូវវិនាស ។
ប៉ុន្តែ បន្ទាប់មក វា មិន មែន ជា ការពិត ជាមួយ អ្នកទេ មែន ទេ ?
គាត់បាននិយាយថា៖ «វាគ្មានខ្លឹមសារអ្វីទេ ហើយក៏គ្មានយុត្តិធម៌ដែរ ។
នាងបាននិយាយថា៖ « ពួកគេមានធុង សំរាមពីរសម្រាប់សម្រាក។
អល់ ឡោះ បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា ទ្រង់ ចូលចិត្ត ការលើកឡើង ជាសាធារណៈ អំពី អំពើ អាក្រក់ ដោយ ពួក អ្នក ដែល ត្រូវ គេ ជិះ ជាន់ និង ធ្វើបាប ។
" នេះគឺជាការ ដែលអ្នកគូសរង្វង់។ "
១៤ កុំយក ចិត្តទុកដាក់នឹងពាក្យរបស់ព្យាការី ដែលលើកទឹក ចិត្តអ្នកមិនឲ្យបម្រើស្ដេចបាប៊ីឡូនឡើយ ព្រោះគេកុហកអ្នក ។
មិនត្រូវបានគេប្រាប់ដល់កូនមនុស្សក្នុងជំនាន់ផ្សេងទៀតទេ ដូចដែលវាត្រូវបានបើកសម្ដែងដល់សាវ័ក និងព្យាការីដ៏បរិសុទ្ធរបស់ទ្រង់ដោយព្រះវិញ្ញាណ ។
ចាប់បុរសនោះ និងអ្នកនៅ សល់ទាំងអស់ ។
ថ្ងៃ នេះ សូម បង្ហាញ ដៃគូ របស់ អ្នក ថា ពួកគេ គឺជា មនុស្ស តែ មួយ គត់ សម្រាប់ អ្នក ។
ប៉ុន្តែ បើយើងមិនដឹងថាព្រះសព្វព្រះហឫទ័យនឹងប្រទានឲ្យពួកគេទេ តើធ្វើដូចម្ដេចយើងអាចមានទំនុក ចិត្តទាំង ស្រុងថាទ្រង់នឹងធ្វើ ?
ហើយតើពួកគេនឹងអាច រក្សាអំណាចបានឬទេ ?
មាន មួយ ទៀត សម្រាប់ អ្នក ។
រ៉ូម 6:17 ប៉ុន្តែសូមអរព្រះ‌គុណដល់ព្រះ ដែលទោះ ជាអ្នក រាល់គ្នាធ្លាប់ធ្វើជាខ្ញុំបម្រើរបស់អំពើ បាបក៏ដោយ ក៏អ្នកបានគោរពតាមទម្រង់នៃការ បង្រៀនដែលអ្នកបានប្រគល់ឲ្យអស់ពី ចិត្ត ។
« ពីរថ្ងៃក្រោយមក ទ្រង់យាងទៅស្រុកកាលីឡេ ។
ខណៈពេល ដែល យើង ទាំងអស់ គ្នា នឹក គាត់ យ៉ាង ក្រៃលែង គាត់ នឹង រស់ នៅក្នុង បេះដូង របស់ យើង ជានិច្ច នៅក្នុង រឿង របស់ យើង និង តាមរយៈ អ្នកសារព័ត៌មាន ជាច្រើន ដែល គាត់ បាន បង្រៀន និង បំផុស គំនិត ដូចជា ខ្ញុំ ។
ត្រៀមខ្លួន សម្រាប់ អាជីវក ម្ម៖ ការរៀបចំ សម្រាប់ ការងារ ។
អ្នកដែលនិយាយថាគាត់ត្រូវខ្វាក់ភ្នែកដោយការ ស្អប់របស់ខ្លួន ។
