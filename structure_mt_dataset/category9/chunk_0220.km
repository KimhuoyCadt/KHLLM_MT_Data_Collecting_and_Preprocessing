( ស្វាយរៀង ) ៖ ដោយសារ មាន វិបត្តិ ស្នេហា គូស្នេហ៍ ដែល ស្រឡាញ់ គ្នា ខ្លាំង បាន សម្រេចចិត្ត ធ្វើ អត្តឃាត យក សាំង ដុត សម្លាប់ ទាំង ២នាក់ នៅក្នុង ផ្ទះសំណាក់ « ៧៧៧៧ » ក្នុង ភូមិ ជោរ ឃុំ សង្កែ ស្រុក រំដួល ខេត្ត ស្វាយរៀង ដែល នាំឱ្យ មាន ការភ្ញាក់ផ្អើល នៅ ព្រឹក ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
សមត្ថកិច្ច នគរបាល ស្រុក រំដួល បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ដោយ ដកស្រង់ ប្រភព ពី ប្រជាពលរដ្ឋ ថា នៅ វេលា ម៉ោង ៧៖ ៤០ នាទី នៅ ត្រង់ ចំណុច ផ្ទះសំណាក់ ៧៧៧៧ មាន អគ្គីភ័យ មួយ កើតឡើង និង មាន មនុស្ស ស្លាប់ ។ ក្រោយពី ទទួល ព័ត៌មាន ភ្លាម កម្លាំង ជំនាញ នគរបាល បច្ចេកទេស ស្រុក សហការ ជាមួយ នគរបាល ជំនាញ ខេត្ត និង លោក វេជ្ជបណ្ឌិត នៃ មន្ទីពេទ្យ បង្អែក សាមគ្គី រំដួល ក្រោម ការសម្របសម្រួល ពី លោក បូរា អង្គ ប្រទាន ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត ស្វាយរៀង ចុះ ដល់ កន្លែង កើត ហេតុ ដើម្បី ពិនិត្យ សាកសព ។
សមត្ថកិច្ច បាន បន្ត ថា សាកសព ដែល ប្រទះឃើញ ដុត សម្លាប់ ខ្លួន ឯង នេះ នៅក្នុង បន្ទប់ លេខ ១៩ ដែល មាន ជនរងគ្រោះ រួម មាន៖
ចំពោះ ករណី នេះ ក្រុមគ្រួពេទ្យ បាន សន្និដ្ឋាន ថា សាកសព ស្លាប់ ដោយសារ ធ្វើ អត្តឃាត ចាក់ សាំង ដុត ខ្លួន ឯង ពិតមែន និង ឈានដល់ ការចាក់ សាំង ដុត សម្លាប់ ខ្លួន ឯង នេះ ដោយសារ មាន វិបត្តិ ស្នេហា ។ បច្ចុប្បន្ន សាកសព ត្រូវបាន ប្រគល់ ឱ្យ ក្រុមគ្រួសារ យក ធ្វើ បុណ្យ តាម ប្រពៃណី ។
សូម បញ្ជាក់ ថា បើ តាម ការ ឱ្យដឹង ពី សាច់ញាតិ គ្រួសារ ជនរងគ្រោះ ខាង ប្រុស បាន ឱ្យដឹង ថា បុរស ដែល ស្លាប់ ក្នុង ហេតុការណ៍ ចាក់ សាំង ដុត សម្រាប់ ខ្លួន នេះ ធ្លាប់ រៀបការ និង មាន កូន ម្នាក់ រួច មកហើយ និង បាន ស្គាល់ ជាមួយ នារី រងគ្រោះ រយៈពេល ជាង ១ ឆ្នាំ តែងតែ ឈ្លោះប្រកែកគ្នា រហូតដល់ គិត ខ្លី ចាក់ សាំង សម្លាប់ ខ្លួន ស្លាប់ ទាំង ២នាក់ តែម្ដង ។
សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ដាក់ ចេញ យុទ្ធនាការ ដូចនេះ នៅក្នុង ពិធី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ « ទីក្រុង ស្អាត បដិសណ្ឋារកិច្ច ល្អ ម្ចាស់ ផ្ទះ កម្ពុជា ផ្តល់ ភាពកក់ក្តៅ » អម ជាមួយ ពិធី ប្រគល់ ជ័យលាភី ទីក្រុង ស្អាត លើក ទី៣ នៅ សណ្ឋាគារ៉េ ស៊ីដង់ សុខា ភ្នំពេញ ។
ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បន្ត ជំរុញ ការអភិវឌ្ឍ បៃតង នៅ តាម បណ្តា ក្រុង ខណ្ឌ រាជធានី ខេត្ត នៅ ទូទាំង ប្រទេស ឱ្យ ស្រប តាម គោល នយោបាយ និង យុទ្ធសាស្ត្រ អភិវឌ្ឍ ជាតិ របស់ រាជ រដ្ឋាភិបាល ដោយ ត្រូវ ជំរុញ ការរៀបចំ ផែនការ មេអភិវឌ្ឍ ទីក្រុង ដោយ រួមបញ្ចូល ទាំង ទិដ្ឋភាព នគរូបនីយកម្ម ប្រជាសាស្ត្រ ទេសចរណ៍ បរិស្ថាន សេដ្ឋកិច្ច និង សង្គម ។
សម្តេច តេជោ ក៏ បាន ណែនាំ ឱ្យ មន្ត្រី ជំនាញ ទាំងអស់ បន្ត អភិវឌ្ឍ ទីក្រុង ស្អាត ផ្សារភ្ជាប់ នឹង ទីក្រុង ឆ្លាត ដែល មាន លក្ខណៈ ប្រកួតប្រជែង ផ្នែក សេដ្ឋកិច្ច ភាព ទាក់ទាញ ផ្នែក ទេសចរណ៍ បរិស្ថាន ប្រកបដោយ ចីរភាព និង ការទទួលខុសត្រូវ សង្គម ដើម្បី លើកកម្ពស់ គុណភាព រស់ នៅ របស់ ប្រជាជន ប្រកបដោយ សុខុមាលភាព សុវត្ថិភាព សន្តិសុខ វិបុលភាព ភាពធន់ និង ផ្តល់ បដិសណ្ឋារកិច្ច ប្រកបដោយ ភាពកក់ក្តៅ ដល់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ផងដែរ ៕
សម្ដេច តេជោ ហ៊ុន សែន បាន អះអាង ថា ការផ្សព្វផ្សាយ តាមរយៈ សារព័ត៌មាន គឺ ធ្វើឡើង បាន ត្រឹមតែ មួយ រយៈពេល ប៉ុណ្ណោះ ប៉ុន្ដែ បើ ផ្សព្វផ្សាយ តាមរយៈ អ្នកទេសចរ វិញ ធ្វើឲ្យ អ្នក ដែល បាន មក ទស្សនា ហើយ ចង់ មក ទស្សនា ទៀត ហើយ លើស ពី អ្វី ដែល អ្នក ដែល ធ្លាប់ មក ទស្សនា បាន មក ម្ដង ទៀត ហើយ នោះ គឺ គេ ក៏ អាច នាំ ទាំង ក្រុមគ្រួសារ ឬ មិត្តភក្ដិ របស់ គេ មក ថែម ទៀត ផង ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច តេជោ ហ៊ុន សែន . ការដោះស្រាយ ពិតប្រាកដ នៅពេល ទេសចរណ៍ មក ទស្សនា នៅ កម្ពុជា គឺ ត្រូវ ទទួល ដោយ បដិសណ្ឋារកិច្ច ល្អ សន្ដិសុខ ល្អ អនាម័យ កន្លែង ទាក់ទាញ ដែល ធ្វើឲ្យ អ្នកទេសចរ ចង់ ទៅ ទស្សនា ដូច្នេះ ធ្វើឲ្យ ទេសចរណ៍ មក ហើយ ចង់ មក ទៀត ។ សម្ដេច បន្ដ ថា នៅពេល អ្នកទេសចរ មក លើ ក្រោយ មិន មែន មក ម្នាក់ឯង ទៀត នោះ ទេ ។
( ប៉េកាំង ) ៖ ចិន បាន ចេញមុខ មុខ ចោទប្រកាន់ សហរដ្ឋ អាមេរិក ភ្លាម ៗ ថា បាន បង្ក គ្រោះថ្នាក់ ចំពោះ សន្តិភាព និង ស្ថិរភាព នៅ ច្រក សមុទ្រ តៃវ៉ាន់ បន្ទាប់ពី យន្តហោះ ឈ្លប ការណ៍ និង ល្បាត ដែន សមុទ្រ ធុន P-8A មួយ គ្រឿង របស់ យោធា អាមេរិក បាន ធ្វើដំណើរកាត់ ពីលើ ដែន ទឹក ដែល ខណ្ឌ ចែក ចិន ដី គោក ហើយ និង កោះ តៃវ៉ាន់ នៅ ថ្ងៃចន្ទ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃចន្ទ ទី២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
ទីក្រុង ប៉េកាំង ជារឿយ ៗ ត្រូវបាន ធ្វើឱ្យ ក្តៅ ស្លឹក ត្រចៀក ដោយសារតែ បេសកកម្ម យោធា របស់ សហរដ្ឋ អាមេរិក ដែល ធ្វើដំណើរកាត់ តាម ច្រក សមុទ្រ តូច មួយ នេះ ។ ភាគ ច្រើន ទីក្រុង វ៉ាស៉ីនតោន បាន បញ្ជូន នាវា ចម្បាំង ខណៈ ម្តងម្កាល បាន បញ្ជូន យន្តហោះ យោធា ។ ចិន អះអាង ថា ខ្លួន មាន សិទ្ធិ អធិបតេយ្យ និង យុត្តាធិការ លើ ច្រក សមុទ្រ តៃវ៉ាន់ ដ្បិត កោះ តៃវ៉ាន់ ផ្ទាល់ ត្រូវបាន ចិន ចាត់ទុក ជា ផ្នែក នៃ ទឹកដី របស់ ខ្លួន ។ ក៏ប៉ុន្តែ តៃវ៉ាន់ និង អាមេរិក បាន អះអាង ប្រឆាំង វិញ ថា វា គឺជា ផ្លូវ ទឹក អន្តរជាតិ ។
ការលើកឡើង បែប នេះ របស់ សម្តេច ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ជា អធិបតី ប្រារព្ធ ពិធី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ដែល ប្រារព្ធ ធ្វើឡើង នៅ សណ្ឋាគារ សុខា រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « វិស័យ ទេសចរណ៍ នៅតែ ជា ចន្ទល់ កំណើន សេដ្ឋកិច្ច ជាតិ ដ៏ សំខាន់ មួយ ក្នុង នោះ សម្រាប់ ឆ្នាំ ២០២២ កម្ពុជា ទទួលបាន ភ្ញៀវ ទេសចរ អន្តរជាតិ ជាង ២. ២លាន នាក់ កើនឡើង ១០៥៩ % ធៀប ឆ្នាំ ២០២១ » ។
បន្ថែម ពី នោះ ទៀត សម្តេច តេជោ ហ៊ុន សែន បាន បន្ដ ថា ជាមួយ នេះ ភ្ញៀវ ទេសចរ ផ្ទៃក្នុង ធ្វើដំណើរកម្សាន្ត ក្នុង ប្រទេស មាន ទេសចរ ជាតិ ប្រមាណ ជិត ១៤លាន នាក់ កើនឡើង ១៩៩ % និង ទេសចរ បរទេស ផ្ទៃក្នុង ប្រមាណ ជិត ២លាន នាក់ កើនឡើង ៥៧២ % ធៀប ឆ្នាំ ២០២១ ។
បើ តាម សម្ដេច តេជោ ហ៊ុន សែន . តាម ការប៉ាន់ស្មាន ពេញ មួយ ឆ្នាំ ២០២៣ កម្ពុជា អាចនឹង ទទួលបាន ទេសចរ អន្តរជាតិ ប្រមាណ ៤លាន នាក់ និង ទេសចរ ជាតិ ប្រមាណ ១៥លាន នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ឲ្យដឹង ថា ដើម្បី ឆ្លើយតប នឹង ការវិវត្ត និង និន្នាការ នៃ ការអភិវឌ្ឍ ថ្មី ៗ កម្ពុជា ត្រូវ បន្ត យកចិត្តទុកដាក់ លើ ការដាក់ចេញ និង អនុវត្ត នូវ គោល នយោបាយ និង យុទ្ធសាស្ត្រ អភិវឌ្ឍ ជាតិ នានា ដោយ ឈរ លើ មូលដ្ឋាន សំខាន់២ ដែល ត្រូវ គិតគូរ ស្រប ពេល គ្នា គឺ ការបង្កើន ឧត្តមភាព ប្រកួតប្រជែង និង ការធានា ចីរភាព នៃ ការអភិវឌ្ឍ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ឲ្យដឹង ទៀត ថា ឈរ លើ មូលដ្ឋាន នេះ កម្ពុជា បាន ដាក់ចេញ នូវ យុទ្ធនាការ « ទីក្រុង ស្អាត រមណីយដ្ឋាន ស្អាត សេវា ល្អ បដិសណ្ឋារកិច្ច ល្អ » ដែល ជា យុទ្ធសាស្ត្រ មួយ ដ៏ សមស្រប ក្នុង ការចូលរួម អភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ ជា មាស បៃតង និង នាំ កម្ពុជា ឆ្ពោះ ទៅរក ភាព ស្អាត ប៉ៃតង និង ប្រកបដោយ សុវត្ថិភាព ខ្ពស់ ៕ ចំណេះដឹង ទូទៅ៖ តើ គេ លាង លុយក ខ្វក់ ដោយ របៀប ណា ?
ជា បឋម គេ គួរ ឈ្វេងយល់ ពី អត្ថន័យ នៃ ពាក្យ « ការលាង លុយក ខ្វក់ » ជាមុន សិន ។ ការលាង លុយក ខ្វក់ មាន ន័យ ថា គឺជា អំពើ អនីត្យានុកូល ( ខុស ច្បាប់ ) នៃ ការធ្វើឲ្យ ចំនួន លុយ ខុស ច្បាប់ ជាច្រើន ដែល បាន មកពី ឧក្រិដ្ឋកម្ម ដូចជា ការជួញដូរ គ្រឿងញៀន ការរត់ ពន្ធ ទំនិញ និង ការធ្វើ ភេរវកម្ម ឲ្យ មើល ទៅ ក្លាយទៅ លុយ នីត្យានុកូល ( ឬ ស្រប ច្បាប់ ) វិញ ។ ពួក ឧក្រិដ្ឋ ជន បាន ប្រើ វិធីសាស្ត្រ ជាច្រើន ដើម្បី លាង លុយក ខ្វក់ របស់ ខ្លួន ។
វិធីសាស្ត្រ យ៉ាង ពេញនិយម ដើម្បី លាង លុយក ខ្វក់ មាន អ្វី ខ្លះ ?
ការលាង លុយក ខ្វក់ អាច ត្រូវបាន ដំណើរការ តាមរយៈ ការដូរ រូបិយប័ណ្ណ និង ការនាំយក លុយ សុទ្ធ ឆ្លងកាត់ ព្រំដែន ដើម្បី ដូរ យក លុយ បរទេស នៅ ប្រទេស ផ្សេង ទៀត ដែល មិន សូវ យកចិត្តទុកដាក់ លើ សកម្មភាព លាង លុយក ខ្វក់ ។ មធ្យោបាយ ផ្សេង ទៀត នៃ ការលាង លុយក ខ្វក់ គឺ ពាក់ព័ន្ធ នឹង ការវិនិយោគ លើ វត្ថុ មាន តម្លៃ ដូចជា ត្បូង និង មាស និង ការវិនិយោគ ផ្សេង ទៀត ដូចជា អចលន ទ្រព្យ និង ការបើកបន ល្បែង ជាដើម ។
* វីធីសាស្ត្រ សាមញ្ញ ៗ មាន វិធីសាស្ត្រ ជាច្រើន ដើម្បី លាង លុយក ខ្វក់ ផ្តើម ចេញ វិធី សាមញ្ញ ទៅ វិធី សាំ ញ៉ាំ ។ ទិច និច សាមញ្ញ មួយ ក្នុង ចំណោម ទិច និច ជាច្រើន ទៀត នោះ គឺ ត្រូវ ប្រើ អាជីវកម្ម ស្រប ច្បាប់ ។ ឧទាហរណ៍ ប្រសិនបើ ឧក្រិដ្ឋ ជន បើក ហាង រក ស៉ី មួយ កន្លែង គាត់ អាច បំប៉ោង បង្កាន់ដៃ ទទួល ប្រាក់ ប្រចាំ ថ្ងៃ ដើម្បី យក លុយ ទាំងនោះ ទៅ ដាក់ ក្នុង គណនេយ្យ ហាង នោះ ។ ក្រោយមក ទៀត លុយ ទាំងនោះ អាច ដក យកមក ប្រើប្រាស់ តាម សេចក្តីត្រូវការ ។
គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត រៀបចំ វេទិកា ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ឆ្នាំ ២០២៣
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត នា ព្រឹក ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ វេទិកា ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ឆ្នាំ ២០២៣ ក្រោម ប្រធានបទ៖ « ទីក្រុង ស្អាត បដិសណ្ឋាកិច្ច ល្អ ម្ចាស់ ផ្ទះ កម្ពុជា ផ្តល់ ភាពកក់ក្តៅ » ដែល បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត និង លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន ។
ពិធី នេះ ដែរ បាន ធ្វើឡើង នៅ សណ្ឋាគារ រ៉េស៊ី ដង់ សុខា ភ្នំពេញ និង ដោយ មាន ការចូលរួម ពី លោក លោកស្រី អភិបាល នៃ គណៈអភិបាល រាជធានី ខេត្ត លោក លោកស្រី ជា តំណាង មកពី ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ អាជ្ញាធរ មូលដ្ឋាន និង វិស័យ ឯកជន សមាជិក សមាជិកា គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត រួមទាំង អ្នក ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ។
បន្ថែម ពី នេះ លោក រដ្ឋមន្ត្រី ក៏ បាន បញ្ជាក់ ទៀត ថា ចំពោះ បេក្ខភាព ដែល មិន ទាន់ ទទួលបាន ជ័យលាភី ត្រូវ ខិតខំ ពង្រឹង លក្ខណសម្បត្តិ របស់ ខ្លួន ដើម្បី ទទួលបាន ជ័យលាភី នា ពេល ខាងមុខ . ចំពោះ បេក្ខភាព ដែល មិន ទាន់ ទទួលបាន ចំណាត់ថ្នាក់ ផ្កា រំដួល ៣ទង ក៏ ត្រូវ បន្ត ខិតខំ អនុវត្ត ការងារ បន្ថែម ទៀត ដើម្បី ទទួល ចំណាត់ថ្នាក់ កាន់តែ ល្អ ប្រសើរ ហើយ ជ័យលាភី ផ្កា រំដួល ៣ទង ក៏ ត្រូវ បន្ត ការខិតខំ ដើម្បី រក្សា បាន នូវ ចំណាត់ថ្នាក់ ដ៏ ល្អ នេះ ។
គួរ បញ្ជាក់ ថា ព្យុះ ស៉ី ក្លូន ហ្គាប្រ៊ីល ដែល បាន វាយប្រហារ លើ ប្រទេស នូវែលសេឡង់ កាលពី ថ្ងៃទី ១២ ខែកុម្ភៈ កន្លងទៅ នេះ បាន នាំឲ្យ មាន ការប្រកាស អាសន្ន ថ្នាក់ ជាតិ ជា លើក ទី៣ នៅក្នុង ប្រវត្តិសាស្ត្រ របស់ ប្រទេស ហើយ នឹង បន្ត សម្រាប់ តំបន់ ដែល រងគ្រោះ ដោយ ព្យុះ នេះ ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ឱកាស សម្តេច អញ្ជើញ ជា អធិបតី ប្រារព្ធ ពិធី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃចន្ទ ទី២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា អញ្ជើញ ជា អធិបតី ប្រារព្ធ ពិធី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន អញ្ជើញ ថ្លែង សុន្ទរកថា៖
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ ល្អ បរិបូរណ៍ ពេល បច្ចុប្បន្ន នេះ គឺជា មូលដ្ឋាន ដ៏ រឹងមាំ គាំទ្រ ដល់ ការអភិវឌ្ឍន៍ និង ភាពរីកចម្រើន លើ គ្រប់ វិស័យ ហើយ ផ្តល់ នូវ កាលានុវត្តភាព យ៉ាង ធំធេង ដល់ ការកសាង អនាគត កម្ពុជា ប្រកបដោយ ភាពរុងរឿង ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា វិស័យ ទេសចរណ៍ នៅតែ ជា ចន្ទល់ កំណើន សេដ្ឋកិច្ច ជាតិ ដ៏ សំខាន់ មួយ ។ ក្នុង នោះ ឆ្នាំ ២០២២ កម្ុ ជា ទទួលបាន ភ្ញៀវ ទេសចរ អន្តរជាតិ ជាង ២.២លាន នាក់ កើនឡើង ១០៥៩ ភាគរយ ធៀប ឆ្នាំ ២០២២ ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា កម្ពុជា ត្រូវ គិតគូរ លើ ការបង្កើន ឧត្តមភាព ប្រកួតប្រជែង និង ការធានា ចីរភាព នៃ ការអភិវឌ្ឍន៍ ដើម្បី ឆ្លើយ នឹង ការវិវត្ត និង និន្នាការ នៃ ការអភិវឌ្ឍន៍ ថ្មី ៗ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ចលនា ប្រលងប្រណាំង ទីក្រុង ស្អាត គឺជា យន្តការវាយតម្លៃ និង ជា ការក្រើន រំលឹក ដល់ រដ្ឋបាល ដែនដី អាជ្ញាធរ មូលដ្ឋាន វិស័យ ឯកជន និង ប្រជាពលរដ្ឋ ភ្ញៀវ ទេសចរ ជាតិ អន្តរជាតិ អំពី សារៈសំខាន់ នៃ ការអភិវឌ្ឍ បៃតង ដោយ រក្សា តុល្យភាព នៃ ការអភិវឌ្ឍន៍ និង ការអភិរក្សា លើ ទិដ្ឋភាព សេដ្ឋកិច្ច សង្គម វប្បធម៌ និង បរិស្ថាន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការអនុវត្ត ចលនា ប្រលងប្រណាំង ទីក្រុង ស្អាត បាន ចូលរួម កាត់បន្ថយ ផល ប៉ះពាល់ ជា អវិជ្ជមាន លើ និរន្តរភាព នៃ សម្បត្តិ ធនធាន វប្បធម៌ ធម្មជាតិ និង បរិស្ថាន នៅ តាម បណ្តា ទីក្រុង និង ទីប្រជុំជន ព្រមទាំង ជួយ បង្កើន ភាពទាក់ទាញ និង ធានា ចីរភាព នៃ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ថែម ទៀត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប្រធានបទ « ទីក្រុង ស្អាត បដិសណ្ឋារកិច្ច ល្អ ម្ចាស់ ផ្ទះ កម្ពុជា ផ្តល់ ភាពកក់ក្តៅ » សម្រាប់ ទិវា ជាតិ ទីក្រុង ស្អាត នា ពេលនេះ បាន ឆ្លុះបញ្ចាំង យ៉ាង ច្បាស់ ថា ទីក្រុង ដែល មាន ភាពទាក់ទាញ គួរឱ្យ ចង់ ទស្សនា កម្សាន្ត និង ស្នាក់ នៅ សម្រាប់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ គឺជា ទីក្រុង ដែល ស្អាត មាន បរិស្ថាន ល្អ ធានា បាន នូវ សន្តិសុខ សុវត្ថិភាព ផ្តល់ បដិសណ្ឋារកិច្ច ល្អ ភាព រួសរាយ រាក់ទាក់ ជាមួយនឹង ភាពជា ម្ចាស់ ផ្ទះ ដែល ផ្តល់ នូវ ការស្វាគមន៍ ប្រកបដោយ ភាពកក់ក្តៅ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ត្រូវ បង្កើន ការអប់រំ ដល់ ប្រជាពលរដ្ឋ ឱ្យ យល់ ពី តម្លៃ អនាម័យ និង បរិស្ថាន ។ មិន មែន តែ អ្នក នៅ ទីក្រុង ប៉ុណ្ណោះ ទេ តែ តាម ទី ជនបទ ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការរស់ ប្រកបដោយ អនាម័យ មិន ត្រឹមតែ ធ្វើឱ្យ មាន សោភណ្ឌភាព ប៉ុណ្ណោះ ទេ តែ ក៏ បាន ជួយ ឱ្យ សុខភាព ពលរដ្ឋ ល្អ ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រយៈពេល ប្រមាណ ២៣ឆ្នាំ ហើយ កម្ពុជា មិន កើតមាន ជំងឺ ចុះ ក្អួត ក្រោយ ទឹក ជំនន់ នោះ ទេ ។ នេះ ការស្តែង ឱ្យ ឃើញ ពី ភាពប្រសើរ នៃ សុខភាព ប្រជាពលរដ្ឋ តាមរយៈ ការរស់នៅ ប្រកបដោយ អនាម័យ ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ដាក់ ចេញ យុទ្ធនាការ « ឆ្នាំ ទស្សនា កម្ពុជា ២០២៣ » ដើម្បី លើកកម្ពស់ កិត្តិនាម កម្ពុជា ទៅកាន់ ទីផ្សារ ទេសចរណ៍ ពិភពលោក និង បង្កើន ឧត្តមភាព ប្រកួតប្រជែង ទេសចរណ៍ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ ជំរុញ ការអភិវឌ្ឍន៍ បៃតង នៅ តាម បណ្តា ក្រុង ខណ្ឌ រាជធានី ខេត្ត នៅ ទូទាំង ប្រទេស តាម គោល នយោបាយ និង យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ជាតិ របស់ រាជ រដ្ឋាភិបាល ដោយ ត្រូវ ជំរុញ ការរៀបចំ ផែនការ មេអភិវឌ្ឍន៍ ទីក្រុង ដោយ រួមបញ្ចូល ទាំង ទិដ្ឋភាព នគរូបនីយកម្ម ប្រជាសាស្ត្រ ទេសចរណ៍ បរិស្ថាន សេដ្ឋកិច្ច និង សង្គម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ ឱ្យ បន្ត អភិវឌ្ឍ ទីក្រុង ស្អាត ផ្សារភ្ជាប់ នឹង ទីក្រុង ឆ្លាត ដែល មាន លក្ខណៈ ប្រកួតប្រជែង ផ្នែក សេដ្ឋកិច្ច ភាព ទាក់ទាញ ផ្នែក ទេសចរណ៍ បរិស្ថាន ប្រកបដោយ ចីរភាព និង ការទទួលខុសត្រូវ សង្គម ដើម្បី លើកកម្ពស់ គុណភាព រស់ នៅ របស់ ប្រជាជន ប្រកបដោយ សុខុមាលភាព សុវត្ថិភាព សន្តិសុខ វិបុលភាព ភាពធន់ និង ផ្តល់ បដិសណ្ឋារកិច្ច ប្រកបដោយ ភាពកក់ក្តៅ ដល់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ ឱ្យ បន្ត អភិវឌ្ឍ ទេសចរណ៍ ទីក្រុង ជា ផ្នែក ដ៏ សំខាន់ មួយ នៃ ការចូលរួម ដល់ ការជំរុញ ពិពិធកម្ម នៃ វិស័យ ទេសចរណ៍ កម្ពុជា ដែល ជា ទេសចរណ៍ វប្បធម៌ និង ធម្មជាតិ តាមរយៈ ការរៀបចំ ផែនការអភិវឌ្ឍ ទេសចរណ៍ ទីក្រុង ដែល មាន លក្ខណៈ សមាហរណកម្ម ជាមួយ អន្តរ វិស័យ និង ការប្រើប្រាស់ បច្ចេកវិទ្យា ជា ជំនួយ ឆ្ពោះ ទៅ ការអភិវឌ្ឍ ទេសចរណ៍ ឆ្លាត ដូចជា កម្មវិធី ទូរស័ព្ទ « ទស្សនា ទីក្រុង (City Tales App)» ជាដើម ។
* សម្តេច តេជោ ហ៊ុន សែន ចង់ ឃើញ សណ្ឋាគារ និង អាហារដ្ឋាន នានា ក្លាយទៅជា ប្រភព ទីផ្សារ សម្រាប់ កសិផល របស់ ខ្មែរ ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ឱ្យ ក្រសួង ទេសចរណ៍ ដាក់បញ្ចូល លក្ខខណ្ឌ នៃ ការប្រើប្រាស់ កសិផល ខ្មែរ សម្រាប់ ការវាយតម្លៃ សណ្ឋាគារ នានា ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ បន្ត លើកកម្ពស់ ការអភិវឌ្ឍន៍ ទីក្រុង ប្រកបដោយ ភាពធន់ ចីរភាព និង បរិយាប័ន្ន និង លើកស្ទួយ « វិស័យ ទេសចរណ៍ ជា ការនាំចេញ នៅនឹង កន្លែង » តាមរយៈ ការបង្កើន អន្តរកម្ម ខ្សែ ច្រវាក់ តម្លៃ នៃ វិស័យ ទេសចរណ៍ ជាមួយ វិស័យ គាំទ្រ ពាក់ព័ន្ធ ជាពិសេស វិស័យ កសិកម្ម សិប្បកម្ម ឧស្សាហកម្ម ច្នៃប្រឌិត និង ផលិតកម្ម ក្នុង ស្រុក ដើម្បី បង្កើន លទ្ធភាព នៃ ការបែងចែក ផ្លែ ផ្កា នៃ កំណើន តាមរយៈ ការអភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ ។
* សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ រួមគ្នា ថែរក្សា ធនធាន ធម្មជាតិ រួម មាន ព្រៃឈើ និង សត្វ ព្រៃ សម្រាប់ ទាក់ទាញ ទេសចរណ៍ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន សម្តែង នូវ ក្តីរីករាយ ដែល ក្លឹប ឆ្នេរ ស្អាត បំផុត លើ ពិភពលោក យក គំនិត ផ្តួចផ្តើម របស់ សម្តេច « ឆ្នេរសមុទ្រ ដែល ស្អាត គឺ ឆ្នេរ គ្មាន ប្លាស្ទិក » ដាក់ ក្នុង លក្ខខណ្ឌ វាយតម្លៃ របស់ ខ្លួន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការវាយប្រហារ លើ ក្រុម យុវជន បរិស្ថាន ដែល ធ្លាប់ គាំទ្រ បក្ស ប្រឆាំង បែរ មក គាំទ្រ រាជ រដ្ឋាភិបាល វិញ នោះ គឺ ខ្វះ នូវ ការគោរព គោលការណ៍ ប្រជាធិបតេយ្យ ។
( ភ្នំពេញ ) ៖ ដេីម្បី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ក្រោម ប្រធានបទ « ទីក្រុង ស្អាត បដិសណ្ឋារកិច្ច ល្អ ម្ចាស់ ផ្ទះ កម្ពុជា ផ្ដល់ ភាពកក់ក្ដៅ » ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត សូម បង្ហាញ ជូន នូវ ខ្លឹមសារ នៃ ស្តង់ដា ទីក្រុង ស្អាត៖ សូចនាករ គោល ទី៧ ស្ដីពី ហេដ្ឋារចនាសម្ព័ន្ធ និង សម្បទា ទេសចរណ៍ ដែល មាន ៦សូចនាករ លម្អិត និង ១៩ លក្ខណ វិនិច្ឆ័យ ស្មើនឹង ២១ ពិន្ទុ ។
សូម ទស្សនា វីដេអូ ដូចត ទៅ៖
( ភ្នំពេញ ) ៖ ដេីម្បី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ក្រោម ប្រធានបទ « ទីក្រុង ស្អាត បដិសណ្ឋារកិច្ច ល្អ ម្ចាស់ ផ្ទះ កម្ពុជា ផ្ដល់ ភាពកក់ក្ដៅ » ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត សូម បង្ហាញ ជូន នូវ ខ្លឹមសារ នៃ ស្តង់ដា ទីក្រុង ស្អាត៖ សូចនាករ គោល ទី៥ ស្ដីពី តំបន់ បៃតង និង ខ្សែក្រវាត់ បៃតង ដែល មាន ៧សូចនាករ លម្អិត និង ១៧លក្ខណ វិនិច្ឆ័យ ស្មើនឹង ១៨ ពិន្ទុ ។
( ភ្នំពេញ ) ៖ ដេីម្បី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ក្រោម ប្រធានបទ « ទីក្រុង ស្អាត បដិសណ្ឋារកិច្ច ល្អ ម្ចាស់ ផ្ទះ កម្ពុជា ផ្ដល់ ភាពកក់ក្ដៅ » ដែល បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត សូម បង្ហាញ ជូន នូវ ខ្លឹមសារ នៃ ស្តង់ដា ទីក្រុង ស្អាត៖ សូចនាករ គោល ទី៤ ស្ដីពី ការបញ្ជ្រាប ការយល់ដឹង ដែល មាន ៤សូចនាករ លម្អិត និង ១០លក្ខណ វិនិច្ឆ័យ ស្មើនឹង ១០ពិន្ទុ ៕
ប្រសិន បាន ឃើញ បក្សី ដូចជា មាន់ ទារ ឬ សត្វ ស្លាប ផ្សេង ទៀត ឈឺ ឬ ងាប់ មិន ត្រូវ ប៉ះពាល់ ឬ យក ទៅ ចម្អិន បរិភោគ ឡើយ គឺ ត្រូវ រាយការណ៍ ដល់ ពេទ្យ សត្វ គ្រូពេទ្យ ឬ អាជ្ញាធរ មូលដ្ឋាន ដើម្បី ត្រួតពិនិត្យ និង តាមដាន ឬ ទូរស័ព្ទ ទៅ លេខ 115 ៕
( ភ្នំពេញ ) ៖ ដេីម្បី អបអរសាទរ ទិវា ជាតិ ទីក្រុង ស្អាត លើក ទី ១១ ក្រោម ប្រធានបទ « ទីក្រុង ស្អាត បដិសណ្ឋារកិច្ច ល្អ ម្ចាស់ ផ្ទះ កម្ពុជា ផ្ដល់ ភាពកក់ក្ដៅ » ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត សូម បង្ហាញ ជូន នូវ ខ្លឹមសារ នៃ ស្តង់ដា ទីក្រុង ស្អាត សូចនាករ គោល ទី៣ ស្ដីពី ការគ្រប់គ្រង សំណល់ ដែល មាន ៥សូចនាករ លម្អិត និង ១១លក្ខណ វិនិច្ឆ័យ ស្មើនឹង ១១ពិន្ទុ ៕
សូម ទស្សនា វីដេអូ ដូចតទៅ៖ គ្រួសារ អតីត យុទ្ធ ជាង ៣០០ គ្រួសារ នៅ ឃុំ ដូន បា ស្រុក គាស់ ក្រឡ សប្បាយរីករាយ ក្រោយ ទទួលបាន ស្រះ ទឹក ធំ ៗ ២កន្លែង ជា អំណោយ សម្តេច តេជោ ហ៊ុន សែន និង បាន ជីក រួចរាល់ ហើយ
( បាត់ដំបង ) ៖ លោក ឡុង ផល គុណ ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត បាត់ដំបង នា ព្រឹក ថ្ងៃទី ២៧ ខែកុម្ភ : ឆ្នាំ ២០២៣ គ្រួសារ អតីត យុទ្ធ ចំនួន ៣២៥ គ្រួសារ នៅ ឃុំ ដូន បា ស្រុក គាស់ ក្រឡ នាំគ្នា សប្បាយរីករាយ ដែល ស្រះ ទឹក ធំ ៗ ២កន្លែង ជា អំណោយ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន បាន ជីក រួចរាល់ ហើយ នឹង ត្រូវ ប្រគល់ជូន ពួកគាត់ ទុក សម្រាប់ ប្រើប្រាស់ ជា ផ្លូវការ តាម ក្រោយ ប៉ុណ្ណោះ ។
លោក ឡុង ផល គុណ បាន ប្រាប់ ឲ្យដឹង ថា ក្រោម ការយកចិត្តទុកដាក់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន ដល់ គ្រួសារ អតីត យុទ្ធជន ចំនួន ៣២៥ គ្រួសារ នៅ ចំណុច ផ្ទះ អតីត យុទ្ធជន ស្ថិត ក្នុង ភូមិ គោក រ កា ឃុំ ដូន បា ស្រុក គាស់ ក្រឡ ខេត្ត បាត់ដំបង ដោយ មាន ការសម្របសម្រួល ពី នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម ទេសរដ្ឋមន្រ្តី និង ជា អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ។
សម្តេច តេជោ បាន ផ្តល់ ស្រះ ទឹក ធំ ៗ ចំនួន ២កន្លែង តាម រយ : លោក លឹម គាន ហោ រដ្ឋមន្រ្តី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដើម្បី ជីក ស្រះ ទាំង២នេះ ទុក ជូន គ្រួសារ អតីត យុទ្ធជន សម្រាប់ ប្រើប្រាស់ ជា សាធារណ: ផលប្រយោជន៍ រួមទាំងអស់ គ្នា ត ទៅ ។
លោក ប្រធាន មន្ទីរ បាន បន្ត ថា បន្ទាប់ពី មាន ការណែនាំ របស់ លោក រដ្ឋមន្រ្តី រួច មក មន្ទីរ ជំនាញ បាន នាំ កម្លាំង និង គ្រឿងចក្រ ចុះ អនុវត្ត ជីក ស្រះ ទី២ ខាងលើ ដោយ ស្រះទី១ ចាប់ ជីក តាំងពី ថ្ងៃទី ២៨ ខែសីហា ឆ្នាំ ២០២២ ដែល មាន ទំហំ បណ្តោយ ១៧០ ម៉ែត្រ ទទឹង ៧០ម៉ត្រ និង ជម្រៅ ៥ម៉ែត្រ បាន រួច ជា ស្ថាពរ ។
ស្រះ ទី២ បាន ជីក ចាប់ពី ថ្ងៃទី ១៩ ខែធ្នូ ឆ្នាំ ២០២២ ដល់ ចុង ខែកុម្ភ : ឆ្នាំ ២០២៣ នេះ ដែល មាន ទំហំ បណ្តោយ ១៨៥ ម៉ែត្រ ទទឹង ១០០ ម៉ត្រ និង ជម្រៅ៥ ម៉ែ ម៉ែត្រ គឺ ធ្វើ រួច ១០០ ភាគរយ ហើយ ស្រះ ទឹក នេះ ក្រោយពី ធ្វើ រួច ទាំងស្រុង គឺ ត្រូវ បន្ត ដាំ ដើមឈើ ប្រណិត ជុំវិញ មាត់ ស្រះ បន្ត ទៀត ។
លោក ថា ក្រោយ បាន ជីក រួចហើយ រដ្ឋបាល ព្រៃឈើ នឹង ផ្តល់ កូន ឈើ ប្រណិត មួយចំនួន យកមក ដាំ ជុំវិញ ស្រះ ទាំង២ នេះ នឹង ធ្វើ របង ជុំវិញ ស្រះ ការពារ សុវត្តិភាព បាក់ ដី មាត់ ជ្រាំង ស្រះ និង ដល់ មនុស្ស សត្វ ផ្សេង ៗ ចូល លុកលុយ ដែល ធ្វើឲ្យ ទឹក ស្រះ ថ្លា ល្អ នេះ ទៅជា ទឹកកក្វក់ ល្អក់ វិញ ផងដែរ ៕ ស្រោចស្រព សុគន្ធ វារី ថ្វាយ ព្រះគ្រូ អនុគណស្រុក ឆែប និង សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត ទ្រីស ទ្ធា រាម . អភិបាល ខេត្ត ថ្លែង ថា វិស័យ ពុទ្ធ ចក្រ នៅ កម្ពុជា រីកចម្រើន ឥត ឈប់ឈរ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន
( ព្រះវិហារ ) ៖ លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ បាន អញ្ជើញ ស្រោចស្រព សុគន្ធ វារី ប្រគេន ប្រកាស សនីយប័ត្រ ថ្វាយ ព្រះគ្រូ រដ្ឋានុរ័ក្ខ កោសល មឿង សុនិមិត្ត ជា ព្រះគ្រូ អនុគណស្រុក ឆែប វត្ត សុវណ្ណ គីរី ស្ថិត ក្នុង ភូមិ ឆែប លិច ឃុំ ឆែប មួយ និង អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការសាលា ឆាន់ និង សមិទ្ធផល នានា ក្នុង វត្ត ទ្រីស ទ្ធា រាម ស្ថិត ក្នុង ឃុំ សង្កែ ពីរ ស្រុក ឆែប នៅ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ។
នា ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ជម្រាប ជូន ប្រជាពលរដ្ឋ ពី ការរីកចម្រើន គ្រប់ វិស័យ ទាំង វិស័យ អាណាចក្រ និង ពុទ្ធ ចក្រ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រ នៃ កម្ពុជា ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា « ថ្ងៃ នេះ យើង ទាំងអស់ គ្នា ពិតជា មាន សេចក្តី សប្បាយរីករាយ ប្រកប ទឹកចិត្ត ជ្រះថ្លា បរិសុទ្ធ ក្នុង ព្រះពុទ្ធ សាសនា ដោយ បាន ប្រារព្ធ ពិធី បុណ្យ នៅក្រោម ម្លប់ ដ៏ ត្រជាក់ នៃ សន្តិភាព ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន នាំមក នូវ ការអភិវឌ្ឍ ឥត ឈប់ឈរ ប្រជាពលរដ្ឋ រស់ នៅ ប្រកបដោយ សុខដុមរម្យ នា » ។
( ព្រះវិហារ ) ៖ លោក ហោ ប៊ុន ហួរ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក រវៀង ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ២៦ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ម្សិលមិញ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋន នៅ តាម ខ្នង ផ្ទះ និង នាំ អំណោយ មួយចំនួន ចែកជូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត និង ប្រជាពលរដ្ឋ ដែល នឹង រៀបចំ ពិធី មង្គលការ កូន ចៅ នៅ តាម ភូមិ មួយចំនួន ក្នុង ឃុំ រមទម ។
នៅក្នុង ឱកាស នេះ ដែរ លោក ហោ ប៊ុន ហួរ បាន ប្រាប់ ប្រជាពលរដ្ឋ ពី ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន គណបក្ស និង ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្រៅពី បាន រំដោះ ប្រទេសជាតិ ចេញ ផុត ពី របប ប្រល័យ ពូជសាសន៍ កាលពី ថ្ងៃ៧ មករា ឆ្នាំ ១៩៧៩ មក បាន ធ្វើឱ្យ ប្រទេសជាតិ ទទួលបាន សុខ សន្តិភាព ពេញ ផ្ទៃ ប្រទេស និង ការអភិវឌ្ឍ រីកចម្រើន គ្រប់ វិស័យ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ។
ប្រធាន គណបក្ស ស្រុក បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក ដោយ ក្តី នឹករលឹក ពី លោក មាស សុភា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ ប្រធាន អនុប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ និង លោក មួង ឃីម លោក អ៊ុក គឹម សាន ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ថ្នាក់ ខេត្ត ចុះ មូលដ្ឋាន ស្រុក រវៀង ដែល ជានិច្ច ជាកាល តែង យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា សមាជិក បក្ស របស់ យើង ទូទាំង ស្រុក រវៀង ផងដែរ ។
លោក ហោ ប៊ុន ហួរ បាន ជម្រាប ជូន ប្រជាពលរដ្ឋ ផ្សព្វផ្សាយ ពី មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ គណបក្ស ប្រជាជន កម្ពុជា ដោយ បាន សម្រេច គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ និង គាំទ្រ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី នា ថ្ងៃ អនាគត ផងដែរ ។
ព្រមទាំង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទៅ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា បោះ ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី សម្តេច តេជោ ហ៊ុន សែន បន្ត ដឹកនាំ ប្រទេស ឱ្យ ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ រីកចម្រើន គ្រប់ វិស័យ តទៅទៀត ៕ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ឲ្យ ត្រៀម រៀបចំ ការប្រកួតប្រជែង រ៉ូបូត អន្តរជាតិ ឆ្នាំ ២០២៣ គ្រោង រៀបចំ ធ្វើឡើង នៅ ចុង ខែសីហា ឆ្នាំ ២០២៣ ដែល មាន ប្រទេស ជាច្រើន នឹង នាំយក រ៉ូបូត មក ចូលរួម ប្រកួត
( ភ្នំពេញ ) ៖ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន បាន ឲ្យ ត្រៀម រៀបចំ ការប្រកួតប្រជែង រ៉ូបូត អន្តរជាតិ ឆ្នាំ ២០២៣ គ្រោង រៀបចំ ធ្វើឡើង នៅ ចុង ខែសីហា ឆ្នាំ ២០២៣ នៅ រាជធានី ភ្នំពេញ ដែល បណ្តា ប្រទេស ជាច្រើន នាំយក រ៉ូបូត មក ចូលរួម ប្រកួត ប្រជែង ដើម្បី បង្ហាញ សមត្ថភាព ស្ថាដៃ និង ទេពកោសល្យ របស់ ខ្លួន រៀង ៗ ខ្លួន ។
ការបញ្ជាក់ នេះ របស់ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញារីទ្ធ ក្នុង ឱកាស នៃ កិច្ចប្រជុំ សាមញ្ញ ប្រចាំ សប្តាហ៍ របស់ ថ្នាក់ដឹកនាំ ក្រសួង ព័ត៌មាន ដោយ មាន ការចូលរួម ផ្ទាល់ និង តាមរយៈ ប្រព័ន្ធ វីដេអូ Zoom ដែល បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នា សាល ប្រជុំ ព្រះវិហារ ក្រសួង ព័ត៌មាន ។
តាមរយៈ អង្គ សន្និបាត បូកសរុប ការងារ រយៈពេល ៥ ឆ្នាំ នេះ ដែរ លោក រដ្ឋមន្រ្តី បាន ជម្រុញ ដល់ បណ្តា អគ្គ នាយកដ្ឋាន ទាំង៥ ចំណុះ អោយ ក្រសួង ព័ត៌មាន ធ្វើជា របាយការណ៍ សង្ខេប ខ្លី ពី ការងារ អ្វី ដែល ធ្វើ បាន និង ធ្វើ មិន បាន មូលហេតុ អ្វី ហើយ លើក គម្រោង ទិសដៅ ដើម្បី បន្ត អនុវត្តន៍ ទៅ មុខ ទៀត ។ ជាមួយ នេះ បណ្តា មន្ទីរព័ត៌មាន រាជធានី - ខេត្ត ក៏ ត្រូវ ធ្វើ របាយការណ៍ ខ្លី ដូចគ្នា នេះ ដែរ ។
កិច្ចប្រជុំ ប្រចាំ សាមញ្ញ ប្រចាំ សប្តាហ៍ នា ឱកាស នេះ បាន ធ្វើ ការពិនិត្យ លើ កិច្ចការងារ ដែល គ្រប់ ផ្នែក គ្រប់ ជំនាញ បាន អនុវត្ត នា ពេល កន្លងមក និង ដាក់ ចេញ ជា ផែនការ កិច្ចការងារ ព័ត៌មាន និង សោត ទស្សន៍ សម្រាប់ បំពេញ ព្រឹត្តការណ៍ អន្តរជាតិ សំខាន់ ៗ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ រៀបចំ ។
ថ្នាក់ដឹកនាំ តាម បណ្តា អគ្គ នាយកដ្ឋាន ទាំង ៥ចំណុះ ឲ្យ ក្រសួង ព័ត៌មាន រួម ជាមួយ រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ជា ប្រធាន គណ:កម្មការ និង អនុគណ:កម្មការ បាន ធ្វើ របាយការ ណ៏ លើកឡើង ពី វឌ្ឍនភាព ការងារ សំខាន់ ៗ នានា ដែល មន្រ្តី និង ថ្នាក់ដឹកនាំ គ្រប់ ផ្នែក គ្រប់ ជំនាញ សម្រេច អនុវត្តន៍ នា ពេល កន្លង នេះ ដោយ បាន ធ្វើអោយ រាល់ កិច្ចការងារ បាន ដំណើរ ដោយ រលូន ។
ទន្ទឹម គ្នា នេះ ដែរ ថ្នាក់ដឹកនាំ តាម បណ្តា ផ្នែក ជំនាញ នីមួយ ៗ ក៏ បាន លើក ពី ផែនការ សកម្មភាព ការងារ ដែល ត្រូវ បន្ត ធ្វើ សម្រាប់ សប្តាហ៍ បន្តបន្ទាប់ ទៀត ឲ្យបាន កាន់តែ ល្អ ប្រសើរ ។ រដ្ឋមន្រ្តី ខៀវ កាញារីទ្ធ បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ គ្រប់ លំដាប់ថ្នាក់ គ្រប់ ផ្នែក គ្រប់ ជំនាញ ដែល បាន ខិតខំ ប្រឹងប្រែង អស់ ពី សមត្ថភាព កំលាំង កាយ ចិត្ត ដើម្បី សម្រេចបាន លទ្ធផល ការងារ បាន យ៉ាង ល្អ ។
« កម្ពុជា ក្នុង ក្រសែភ្នែក ពិភពលោក » មិន មែន មាន ត្រឹមតែ ៣ ភាសា នេះ ទេ ជា ជំហាន បន្ទាប់ ទៀត មាន ការបកប្រែ និង បោះពុម្ព ជា ភាសា ចិន ជប៉ុន និង ភាសា អារ៉ាប់ ៕ អភិបាល ខេត្ត កំពង់ចាម ណែនាំ ឱ្យ មន្ទីរ អប់រំ លោកគ្រូ អ្នកគ្រូ បង្កើន សកម្មភាព ណែនាំ អប់រំ ដល់ សិស្សានុសិស្ស ដើម្បី ធ្វើ យ៉ាងណា ចូលរួម ទប់ស្កាត់ បញ្ហា ក្មេង ទំនើង ដែល កំពុង មាន ការកម្រើក ឡើងវិញ
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ណែនាំ ដល់ មន្ទីរ អប់រំ យុវជន និង កីឡា ក៏ ដូចជា លោកគ្រូ អ្នកគ្រូ មាន វិធានការ អប់រំ ដើម្បី ទប់ស្កាត់ ការកម្រើក ឡើងវិញ នៃ ក្មេង ទំនើង នៅក្នុង សហគមន៍ ។
លោក អភិបាល ខេត្ត បាន លើកឡើង ដូច្នេះ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ក្នុង ឱកាស លោក អញ្ជើញ ពិធី បើក សន្និបាត បុក សរុប លទ្ធផល ការងារ អប់រំ យុវជន និង កីឡា ឆ្នាំ សិក្សា ២០២១ - ២០២២ ឆ្លុះបញ្ចាំង អំពី សមិទ្ធផល រយៈពេល ៥ ឆ្នាំ នៃ ការអនុវត្ត ផែនការ យុទ្ធសាស្ត្រ វិស័យ អប់រំ ២០១៩ - ២០២៣ និង ទិសដៅ បន្ត ២០២២ - ២០២៣ ។
លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា « បច្ចុប្បន្ន បញ្ហា ក្មេង ទំនើង បាន កម្រើក ឡើងវិញ បន្ទាប់ពី មាន ការស្ងប់ស្ងាត់ មួយ រយៈ ។ អញ្ចឹង សូម ស្នើ ដល់ មន្ទីរ អប់រំ ក៏ ដូចជា លោកគ្រូ អ្នកគ្រូ ទាំងអស់ សូម យកចិត្តទុកដាក់ គ្រប់គ្រង ដល់ សិស្សានុសិស្ស របស់ យើង ធ្វើ យ៉ាងណា ចូលរួម ទប់ស្កាត់ កុំ ឱ្យ បញ្ហា ក្មេង ទំនើង កើតមាន នៅក្នុង សហគមន៍ មូលដ្ឋាន របស់ យើង » ។
( កំពង់ធំ )៖ លោក អ៊ុន បុត្ត អភិបាល រង ខេត្ត កំពង់ធំ បាន ជំរុញ អាជ្ញាធរ ក្រុង ស្រុក ឃុំ សង្កាត់ ត្រូវ ផ្សព្វផ្សាយ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ឱ្យ បាន ច្បាស់លាស់ ទៅដល់ ប្រជាពលរដ្ឋ ជា ពលរដ្ឋ របស់ កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ដល់ ស្ត្រី មាន ផ្ទៃពោះ កុមារ អាយុ ក្រោម ២ឆ្នាំ គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង អំឡុង ពេល ប្រយុទ្ធ នឹង ជំងឺ កូវីដ ឱ្យ បាន ផុសផុល ។
នា ឱកាស នោះ លោក អភិបាល រង ខេត្ត បាន បន្ត ថា ការងារ សង្គមកិច្ច គឺជា វិជ្ជាជីវៈ ផ្អែក លើ ការអនុវត្ត និង វិន័យ ដែល ជំរុញ ការផ្លាស់ប្តូរ និង ការអភិវឌ្ឍ សង្គម ការរួមគ្នា ក្នុង សង្គម និង ការផ្ដល់ សិទ្ធិ អំណាច ការជួយ មនុស្ស តាម គោលការណ៍ យុត្តិធម៌ និង ការទទួលខុសត្រូវ ជា សមូហភាព នេះ ជា ចំណុច ស្នូល នៃ ការងារ សង្គមកិច្ច ។
លោក អ៊ុន បុត្ត បាន ថ្លែង ថា ក្រោម ការដឹកនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ជា បិតា ស្ថាបនិក នៃ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ រយៈពេល ជាង ០៣ ឆ្នាំ កន្លងទៅ ទោះបី មាន ឧបសគ្គ ដែល បង្កឡើង ដោយ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ដល់ ប្រជាពលរដ្ឋ នៅក្នុង សហគមន៍ ទូទាំង ប្រទេស ។
បន្ថែម ពី នេះ លោក បាន បញ្ជាក់ ថា ប្រមុខ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ យុទ្ធសាស្ត្រ ជាច្រើន ដើម្បី ធ្វើ យ៉ាងណា ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ឱ្យ ទទួបាន ជោគជ័យ ដែល ធ្វើឱ្យ ស្ថានភាព ប្រទេស កម្ពុជា មាន ប្រក្រតី ភាព ឡើងវិញ ។
( ភ្នំពេញ ) ៖ លោក ម៉េង ហេង សមាជិក ចលនា មាតា ធម្មជាតិ ត្រូវបាន ក្រុម យុវជន ដូចគ្នា ទម្លាយ ថា កំពុង រៀបចំ បង្កើត អង្គការ ចលនា មាតា ធម្មជាតិ ឡើងវិញ ដើម្បី ចូលរួម លើកស្ទួយ វិស័យ បរិស្ថាន ការពារ សន្តិភាព និង ការអភិវឌ្ឍ ។
លោក មួង សុភ័ក្ត្រ អតីត ប្រធាន ក្រុម យុវជន ១០០រាត្រី បាន សរសេរ នៅលើ បណ្តាញ សង្គម របស់ លោក ដោយ សម្តែង ការអបអរសាទរ ចំពោះ លោក ម៉េង ហេង សមាជិក ចលនា មាតា ធម្មជាតិ ដែល សម្រេច បង្កើត អង្គការ មាតា ធម្មជាតិ ដើម្បី ចូលរួម លើកស្ទួយ វិស័យ បរិស្ថាន ការពារ សន្តិភាព និង ការអភិវឌ្ឍ ។
លោក មួង សុភ័ក្ត្រ បាន អះអាង ថា « លោក ( ម៉េង ហេង ) បាន អំពាវនាវ ឱ្យ សមាជិក ចលនា មាតា ធម្មជាតិ ក្រោម ការដឹកនាំ របស់ លោក អេឡិច ឱ្យ មក ចូលរួម ជាមួយ អង្គការ មាតា ធម្មជាតិ វិញ ដើម្បី បញ្ឈប់ ការចាញ់ កល នយោបាយ របស់ លោក អេឡិច ដែល យក បញ្ហា បរិស្ថាន ជា នយោបាយ ដើម្បី រក ជំនួយ ផ្សេង ៗ ដោយ មិន គិត ពី សមាជិក ដាក់ អន្ទាក់ ឱ្យ ធ្វើ រឿង ខុស ច្បាប់ ជាប់ ពន្ធនាគារ ជាដើម » ។
សូម ជម្រាប ថា អង្គការ មាតា ធម្មជាតិ ដែល ទីស្នាក់ការ កណ្តាល តាំង នៅ វត្ត ចំការឈូក ភូមិ ពោធិ៍ មាស ឃុំ ត្រពាំង ជោ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ដែល បង្កើតឡើង និង ដឹកនាំ ដោយ លោក អាឡិច នា ពេល កន្លងទៅ ធ្លាប់ ត្រូវបាន ក្រសួង មហាផ្ទៃ ចេញ សេចក្តីប្រកាស សម្រេច លុបចោល កាលពី ថ្ងៃទី ១៥ ខែកញ្ញា ឆ្នាំ ២០១៧ បន្ទាប់ពី បាន បណ្តេញ លោក អាឡិច ចេញ ពី ប្រទេស កម្ពុជា ៕
