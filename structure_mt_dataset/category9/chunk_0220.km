ប្រទេស ចិន បាន បង្កើន កិច្ចប្រឹងប្រែង របស់ ខ្លួន ដើម្បី ទប់ទល់ នឹង ហានិភ័យ ហិរញ្ញវត្ថុ ខណៈ ដែល សេដ្ឋកិច្ច បាន កើនឡើង ត្រឹមតែ ៣ភាគរយ ប៉ុណ្ណោះ កាលពី ឆ្នាំ មុន ដែល ជា កំណើន ទាប បំផុត ក្នុង រយៈពេល ជាច្រើន ទសវត្សរ៍ ។ សេដ្ឋកិច្ច ត្រូវបាន រង ការរំខាន់ ពី វិធានការរឹតបន្តឹង រយៈពេល ៣ឆ្នាំ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ វិបត្តិ ក្នុង វិស័យ អចលន ទ្រព្យ ការបង្រ្កាប លើ សហគ្រាស ឯកជន និង ការធ្លាក់ចុះ តម្រូវការ សម្រាប់ ការនាំចេញ របស់ ចិន ។
នាយក រដ្ឋមន្ត្រី ក៏ បាន សង្កត់ធ្ងន់ ផងដែរ ទៅ លើ កំណែទម្រង់ ស្ថាប័ន ធៀប នឹង ឆ្នាំ មុន ។ កត្តា នេះ បាន កើតឡើង បន្ទាប់ពី ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ បាន រាយការណ៍ កាលពី ថ្ងៃអង្គារ សប្តាហ៍ មុន ថា លោក ប្រធានាធិបតី ស៊ី ជីន ពីង គ្រោង រៀបចំ រចនា ឡើងវិញ ក្នុង ទ្រង់ទ្រាយ ធំ ចំពោះ សហគ្រាស រដ្ឋ (SOEs) និង អង្គភាព របស់ បក្ស កុម្មុយនិស្ត ។
ប្រភព ចំនួន ពីរ ប្រាប់ ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ថា លោក ស៊ី ដែល នឹង នៅតែ ជា ប្រធានាធិបតី សម្រាប់ អាណត្តិ ទី៣ ដែល មិន ធ្លាប់ មាន ពីមុន មក នោះ គ្រោង នឹង បង្កើត គណៈកម្មការ កិច្ចការ ហិរញ្ញវត្ថុ មជ្ឈិម ឡើងវិញ ។ កត្តា នេះ បង្ហាញ ពី ការជំរុញ របស់ លោក ស៊ី ក្នុង ការបង្កើន ការត្រួតពិនិត្យ លើ វិស័យ ហិរញ្ញវត្ថុ ។
ដើម្បី ជំរុញ កំណើន សេដ្ឋកិច្ច គណៈកម្មការ កំណែទម្រង់ និង អភិវឌ្ឍន៍ ជាតិ (NDRC) របស់ ប្រទេស ចិន ក៏ បាន ឱ្យដឹង កាលពី ថ្ងៃអាទិត្យ ផងដែរ ថា ប្រទេស ចិន នឹង ជំរុញ កំណែទម្រង់ លើ វិស័យ សំខាន់ ៗ និង បន្ត បើក ទូលាយ ដល់ ការវិនិយោគ បរទេស ។
គណៈកម្មការ NDRC បាន ឱ្យដឹង ថា៖ « យើង នឹង អនុវត្ត ការងារ កំណែទម្រង់ សំខាន់ ៗ ដើម្បី លុបបំបាត់ ចោល ឧបសគ្គ ស្ថាប័ន ដែល រារាំង ដល់ ការលើកកម្ពស់ ការអភិវឌ្ឍន៍ »៕
ជនសង្ស័យ គប់ រថយន្ដ អ្នកធ្វើដំណើរ នៅ ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ត្រូវ កម្លាំង នគរបាល ចាប់ខ្លួន
( កណ្ដាល ) ៖ កម្លាំង អធិការដ្ឋាន នគរបាល ក្រុង តាខ្មៅ បាន ឃាត់ខ្លួន យុវជន ញៀន ថ្នាំ ម្នាក់ ក្រោយ បាន ធ្វើ ការគប់ ដុំ ថ្ម ២ដុំ ចំរថយន្ត របស់ គេ បណ្ដាលឲ្យ ខូចខាត ។ ករណី នេះ បាន កើតឡើង នៅ យប់ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២៣ ចំណុច ជិត គល់ ស្ពាន ព្រែក ហូរ ភូមិ ព្រែក ហូរ លិច សង្កាត់ ព្រែក ហូរ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
ម្ចាស់ រថយន្ដ រងគ្រោះ ឈ្មោះ ត្រូ រតនា អាយុ ២៦ ឆ្នាំ ទីលំនៅ ភូមិ លេខ ២ សង្កាត់ ស្វាយរលំ ក្រុង តាខ្មៅ បាន ខូចខាត ទ្វារ រថយន្ត ខាងក្រោយ មួយ ផ្ទាំង ។ ខណៈ ជនសង្ស័យ ឈ្មោះ សុខ សារី អាយុ ៣៥ ឆ្នាំ នៅ ភូមិ ព្រែក ហូរ កើត សង្កាត់ ព្រែក ហូរ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល មុខរបរ មិន ពិតប្រាកដ ។
ក្រោយ កើត ហេតុ ជនរងគ្រោះ បាន បើក រថយន្ត រត់ មកដល់ ប៉ុស្តិ៍ ព្រែក ហូរ ដាក់ ពាក្យ បណ្តឹង ឲ្យ សមត្ថកិច្ច ជួយ ស្រាវជ្រាវ រហូត ប៉ុន្មាន ម៉ោង ក្រោយ ក៏ ឃាត់ខ្លួន ជនសង្ស័យ បាន រួមទាំង វត្ថុតាង យកមក សួរនាំ នៅ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល សង្កាត់ ព្រែក ហូរ ។ បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន ឃាត់ខ្លួន បណ្តោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ក្រុង តាខ្មៅ ដើម្បី កសាង សំណុំរឿង តាម នីតិវិធី ៕ គណៈប្រតិភូ រដ្ឋសភា កម្ពុជា នឹង ទៅ ចូលរួម « វេទិកា បាគូ សកល លើក ទី១០ » នៅ អាស៊ែ បៃហ្សង់ រយៈពេល ១ សប្តាហ៍
តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បាន ឱ្យដឹង ថា លោកស្រី កិត្តិសង្គហ បណ្ឌិត ក៏ នឹង បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ រដ្ឋសភា នៃ សាធារណរដ្ឋ អាស៊ែ បៃហ្សង់ ដើម្បី ពង្រឹង និង ពង្រីក មិត្តភាព កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង ការទូត សភា រវាង រដ្ឋសភា កម្ពុជា - អាស៊ែ បៃហ្សង់ ផងដែរ ។
ក្នុង អំឡុង ពេល ស្នាក់ នៅ លោកស្រី កិត្តិសង្គហ បណ្ឌិត នឹង មាន ជំនួប សម្ដែង ការគួរសម ជាមួយ លោក អាលី អាសាដូវ (Ali Asadov) នាយក រដ្ឋមន្រ្តី នៃ សាធារណរដ្ឋ អាស៊ែ បៃហ្សង់ និង ពាំនាំ ការសួរសុខទុក្ខ របស់ ថ្នាក់ដឹកនាំ នៃ រដ្ឋសភា ព្រឹទ្ធសភា និង សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ៕ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត អញ្ជើញ សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត អម រា នៅ ក្រុង ដូន កែវ ខេត្ត តាកែវ
( តាកែវ )៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត តំណាង របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី ពិធី សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត ក្នុង វត្ត អម រា ស្ថិត ក្នុង ភូមិ ស្នោរ សង្កាត់ រកា ក្នុង ក្រុង ដូន កែវ ខេត្ត តាកែវ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ចូលរួម អបអរសាទរ ចំពោះ សមិទ្ធផល ជាច្រើន ដែល បន្ត រីកលូតលាស់ ក្នុង ទី អារាម ដែល មាន វ័យ ជាង ២០០ ឆ្នាំ នេះ ដោយ កើត ទ្បើង ពី កិច្ច ខិតខំ ប្រឹងប្រែង កសាង កុសល ផល បុណ្យ របស់ ពុទ្ធ បរិស័ទ ប្រកបដោយ សទ្ធា ជ្រះថ្លា ក្នុង ព្រះពុទ្ធ សាសនា ជាមួយ ការបង្ក លក្ខណៈ គ្រប់ បែបយ៉ាង របស់ រាជ រដ្ឋាភិបាល ឲ្យ ប្រជាពលរដ្ឋ មាន ឱកាស ធ្វើ បុណ្យ ទាន ក្រោម ម្លប់ នៃ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ។
លោក បណ្ឌិត បាន បន្ដ ថា ជា ទស្សន ផ្ទាល់ខ្លួន វិទ្យាសាស្ត្រ និង សាសនា ត្រូវ ដើរ ទន្ទឹម គ្នា និង បំពេញ ឲ្យ គ្នា ទៅ វិញ ទៅ មក ដើម្បី ជួយ អភិវឌ្ឍន៍ សង្គម មួយ ឲ្យ មាន ការរីកចម្រើន លូតលាស់ ប្រកបដោយ គុណធម៌ និង សីលធម៌ ខ្ពស់ ។ ខណៈ ដែល វិទ្យាសាស្ត្រ អាច ជួយ ដោះស្រាយ និង បង្កើន កម្រិត ជីវភាព ប្រចាំ ថ្ងៃ ព្រមទាំង ជា ប្រភព ដ៏ សំខាន់ នៃ ចំណេះដឹង ថ្មី ៗ គឺ សាសនា អាច ជួយ បង្កើន នូវ គុណធម៌ និង សីលធម៌ ដែល ជា ជំនាញ ផ្នែក ទន់ ដ៏ ចម្បង ក្នុង ការលើកកម្ពស់ គុណ តម្លៃ របស់ បុគ្គល ម្នាក់ ៗ ក៏ ដូចជា សង្គមជាតិ ទាំងមូល ។
ក្នុង ន័យ នេះ ការបញ្ចូល ចំណេះដឹង ផ្នែក សាសនា បន្ថែម លើ ចំណេះដឹង ទូទៅ នៅក្នុង វិស័យ អប់រំ គឺជា កត្តា អាទិភាព ចម្បង ដើម្បី ធានា បាន នូវ ការ ផលិត មូលធន មនុស្ស កម្ពុជា ប្រកបដោយ សក្តានុពល ខ្ពស់ ដែល មូលដ្ឋាន នៃ ការរីកចម្រើន ផ្នែក សេដ្ឋកិច្ច - សង្គម របស់ កម្ពុជា នា ពេល អនាគត ។
( ស្វាយរៀង ) ៖ លោកគ្រូ អ៊ាម សំអ៊ីម បង្រៀន ជីវវិទ្យា នៅ វិទ្យាល័យ ហ៊ុន សែន ប្រសូតិ ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង បាន ទម្លាយ រឿង មួយ ដែល មិន អាច ទទួលយក បាន ពី មាតាបិតា អាណាព្យាបាល សិស្ស ក្រោយ នាយក វិទ្យាល័យ បាន រៃ អង្គាស ប្រាក់ ចំនួន ១០ដុល្លារ ពី សិស្ស ម្នាក់ ៗ ដើម្បី ធ្វើ សួនច្បារ ។
លោកគ្រូ បាន លើក ថា សម្រាប់ វិទ្យាល័យ ប្រសូតិ ថវិកា ដែល បាន មកពី ដេញថ្លៃ ផ្ញើ កង់ ម៉ូតូ ចំនួន ៦០ លាន រៀល និង ថ្លៃ តូប លក់ដូរ ចំនួន ៧លាន រៀល ទៀត ក្នុង ១ ឆ្នាំ ដូច្នេះ ១ ឆ្នាំ បាន ចំនួន ៦៧ លាន រៀល ដើម្បី យកមក អភិវឌ្ឍន៍ សាលារៀន ចុះ ហេតុ អ្វី នៅ ពេល នេះ លោក នាយក ចាន់ គឹម សែន មក រៃ លុយ សិស្ស ចំនួន ១០ដុល្លារ សម្រាប់ ធ្វើ សួនច្បារ ខាងមុខ អគារ បន្ថែម ទៀត ?
លោកគ្រូ បាន បន្ត ថា ក្នុង នាម ជា គ្រូបង្រៀន ម្នាក់ ក្នុង វិទ្យាល័យ នេះ និង ក្នុង នាម ជា អាណាព្យាបាល ដែល មាន កូន ចំនួន ៣នាក់ រៀន នៅក្នុង សាលា នេះ ដែរ សូម ជំទាស់ ចំពោះ ការរៃ អង្គាស ថវិកា ពី សិស្ស ព្រោះ សាលា មាន ប្រាក់ សម្រាប់ អភិវឌ្ឍន៍ រួចហើយ នោះ គឺ ប្រាក់ ផ្ញើ កង់ ម៉ូតូ និង ប្រាក់ ថ្លៃ តូប ជា ប្រចាំ ឆ្នាំ ប្រមាណ ៦៧ លាន រៀល ។
បើ តាម លោកគ្រូ ករណី នេះ ជា ករណី លើក ទី១ ផងដែរ សម្រាប់ ការរៃ អង្គាស ពី សិស្ស ចំនួន ១០ដុល្លារ ដោយ រយៈ កាល កន្លងមក លោក នាយក បាន ធ្វើ បុណ្យ ផ្កា សាមគ្គី ដើម្បី ប្រមូល បច្ច័យ ក សាង សាលា ដែរ ហើយ ក្នុង នោះ ក៏ បាន ដាក់កំហិត ដល់ សិស្ស ម្នាក់ ចំនួន ២ម៉ឺន រៀល និង លោកគ្រូ អ្នកគ្រូ ៥ម៉ឺន រៀល ព្រមទាំង មាន ការចូលរួម ពី សប្បុរ ជន ជាច្រើន ទៀត ដើម្បី យក ទៅ ធ្វើ សួនច្បារ តែ សួនច្បារ ទាំងនោះ មាន រូបសំណាក សុទ្ធសឹង ជា ចូលរួម ថវិកា របស់ លោកគ្រូ អ្នកគ្រូ ក្នុង ការកសាង ផងដែរ ។
លោកគ្រូ បាន បញ្ជាក់ ថា រាល់ ការប្រជុំ ក៏ ដូចជា ដឹក ការដឹកនាំ របស់ លោក នាយក សាលា ចាន់ គឹម សែន . លោក តែងតែ និយាយ ពាក្យ អាសុរោះ មិន សាកសម ជា គ្រូបង្រៀន លោកគ្រូ អ្នកគ្រូ មិន អាច និយាយ អំពី បញ្ហា កង្វល់ របស់ ខ្លួន នៅក្នុង អង្គប្រជុំ បាន ទេ ពោល គាត់ អនុម័ត តែ ខ្លួន ឯង ។ រាល់ ការអភិវឌ្ឍន៍ នៅក្នុង សាលា វិទ្យាល័យ លោកគ្រូ អ្នកគ្រូ តែងតែ ចូលរួម ជា ថវិកា ក្នុង ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ ក្នុង សាលា ជា បន្ត បន្តបន្ទាប់ ។
ក្នុង នាម ជា អាណាព្យាបាល ក៏ ដូចជា គ្រូបង្រៀន ម្នាក់ ក្នុង វិទ្យាល័យ ប្រសូតិ លោកគ្រូ អុីម សំណូមពរ អភិបាល ខេត្ត ស្វាយរៀង និង មន្ទីរ អប់រំ សូម មេត្តា មក ពិនិត្យមើល ការដឹកនាំ របស់ លោក ចាន់ គឹម សែន ជា នាយក វិទ្យាល័យ ហ៊ុន សែន ប្រសូតិ ដែល មាន ការរៃ អអង្គាស ប្រាក់ ពី សិស្ស ចំនួន ១០ដុល្លារ ។
ពាក់ព័ន្ធ នឹង ករណី ខាងលើ នេះ លោក ចាន់ គឹម សែន បាន បញ្ជាក់ ប្រាប់ ភ្នាក់ងារ អង្គភាព Fresh News ប្រចាំ ខេត្ត ស្វាយរៀង ថា ចំពោះ ការរិះគន់ ពាក់ព័ន្ធ នឹង ករណី នេះ គឺ មិន ពិត ទេ ។ លោក នឹង ធ្វើ ការបកស្រាយ ជូន អាណាព្យាបាល សិស្ស គ្រូបន្ទុក ថ្នាក់ គណៈកម្មការ អភិវឌ្ឍ ថ្នាក់រៀន និង គណៈកម្មការគ្រប់គ្រង សាលារៀន បាន ជ្រាប ទាំងអស់ គ្នា ។
ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ លោក ស៉ីន ចាន់ សិរី វុត្ថា អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ អាកាសចរ ស៊ីវិល បាន បញ្ជាក់ ឲ្យដឹង ថា ក្នុង ជំនួប នេះ ភាគី ទីម័រ ឡេស្តេ បាន ថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ផ្តល់ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង លើ ការចូល ជា សមាជិកភាព របស់ ទីម័រ ជា សមាជិក របស់ អាស៊ាន ។
ភាគី ទីម័រ ចង់ឲ្យ កម្ពុជា ជួយ ផងដែរ ក្នុង ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ វិស័យ អាកាសចរ ស៉ី វិល នៃ ប្រទេស ទាំង ពីរ ពិសេស ជួយ ផ្តល់ ជា បទពិសោធន៍ ល្អ ៗ ទាក់ទង ទៅ នឹង ការតភ្ជាប់ ជើងហោះហើរ ក្នុង តំបន់ អាស៊ាន ទាំងមូល ។
ជា ការឆ្លើយតប លោក រដ្ឋមន្ត្រី ម៉ៅ ហាវណ្ណាល់ បាន ចែករំលែក នូវ បទពិសោធន៍ អំពី វិស័យ អាកាសចរ ស៉ី វិល នៅ កម្ពុជា ដែល ចាប់ផ្តើម ពី ចំណុច សូន្យ ងើប ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត រហូតមកដល់ មាន ការរីកចម្រើ ដូច ពេល បច្ចុប្បន្ន នេះ ។
លោក រដ្ឋមន្ត្រី ក៏ បាន លើកឡើង ពី យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ដែល ការប្រើប្រាស់ ធនធាន ពី វិស័យ ឯកជន ក្នុង ដំណើរការ ពង្រីក សាងសង់ អាកាសយានដ្ឋាន ដែល ពីមុន អាកាសយានដ្ឋាន នៅ កម្ពុជា តូច ប៉ុន្តែ រាជ រដ្ឋាភិបាល មាន គោល នយោបាយ ល្អ ទើប អាច គៀង គរ ធនធាន យកមក ពង្រីក ហេដ្ឋារចនាសម្ព័ន្ធ អាកាសយានដ្ឋាន របស់ យើង បាន ល្អ ប្រសើរ ឆ្លើយ បត បាន តម្រូវការ របស់ សង្គម សេដ្ឋកិច្ច ។
បន្ទាប់ពី បាន ពិភាក្សា គ្នា រួច លោក រដ្ឋមន្ត្រី ប្រទេស ទាំង២ ក៏ បាន រៀបចំ ចុះហត្ថលេខា លើ អនុស្សារណៈ យោគយល់ គ្នា (MoU) ស្តីពី ប្រតិបត្តិការ ហោះហើរ រវាង ប្រទេស ទាំង២ ដែល អនុស្សារណៈ នេះ ឆ្លើយតប ទៅនឹង ដំណើរទស្សនកិច្ច របស់ លោក ប្រធានាធិបតី ទីម័រ ឡេស្តេ មក កម្ពុជា កាលពី ចុង ឆ្នាំ ២០២២ ដោយ ថ្នាក់ដឹកនាំ នៃ ប្រទេស កម្ពុជា - ទីម័រ ឡេស្តេ បាន ពិភាក្សា គ្នា ធ្វើ យ៉ាងណា ជំរុញ ឲ្យ ក្រុមការងារ នៃ ប្រទេស ទាំង ពីរ ពង្រឹង ទាំង ការងារ ផ្នែក បច្ចេកទេស និង ការអនុវត្ត កិច្ចព្រមព្រៀង ដឹកជញ្ជូន តាម ផ្លូវ អាកាស ៕
លោក គង់ វិបុល ថ្លែង បែប នេះ ធ្វើឡើង ក្នុង សិក្ខាសាលា ផ្សព្វផ្សាយ ស្តីពី « កាតព្វកិច្ច ពន្ធ លើ ប្រាក់ ចំណូល ការបំពេញ ទម្រង់ លិខិត ប្រកាស ពន្ធ លើ ប្រាក់ ចំណូល ប្រចាំ ឆ្នាំ ការស៊ើបអង្កេត បទល្មើស ពន្ធដារ និង ការប្រឆាំង ការសម្អាត ប្រាក់ » នា ថ្ងៃទី ៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ ។
បើ តាម លោក គង់ វិបុល ចាប់ពី ឆ្នាំ ២០១៩ ដល់ ឆ្នាំ ២០២៣ កម្ពុជា ត្រូវបាន ក្រុមការងារ ហិរញ្ញវត្ថុ ហៅ កាត់ ថា FATF មាន មូលដ្ឋាន នៅ ទីក្រុង ប៉ារីស បាន សម្រេច ដាក់ កម្ពុជា បញ្ជូល ក្នុង បញ្ជី ប្រផេះ ដែល ត្រូវ ចាត់ទុក ថា ជា ប្រទេស មាន ហានិភ័យ ខ្ពស់ ក្នុង ការលាង លុយក ខ្វក់ ។
លោក បាន លើកឡើង ថា ការដក កម្ពុជា ចេញ ពី បញ្ជី ប្រផេះ មក បញ្ជីស គឺជា ការខិតខំ ប្រឹងប្រែង របស់ អង្គភាព ទាំងអស់ របស់ រាជ រដ្ឋាភិបាល ដែល ក្នុង នោះ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ដើរ តួនាទី មួយ យ៉ាង សំខាន់ ដើម្បី បង្ហាញ ទៅ អង្គការ FATF ថា រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ ប្រឹងប្រែង កែទម្រង់ របស់ ខ្លួន សម្អាត ខ្លួន ឱ្យ មក សវិញ ។ ចំណែក ស្ថាប័ន តុលាការ ក៏ បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ដែរ ដោយ បាន ខិតខំ ប្រឹងប្រែង ជួយ និង ដាក់ ករណី ពន្ធដារ មួយចំនួន ជា អទិភាព នៅក្នុង ការបង្រ្កាប នៃ បទល្មើស ពន្ធដារ ។
លោក អះអាង ថា កម្ពុជា នឹង បន្ត ពង្រឹង ខ្លួន ឱ្យ ស្ថិត នៅក្នុង បញ្ជីស ឬ បញ្ជី ស្អាត រហូត ព្រមទាំង រួមគ្នា លុបបំបាត់ នូវ អំពើ គេចវេស ពន្ធ នៅ កម្ពុជា ខណៈ បច្ចុប្បន្ន នេះ ចំនួន អ្នក ដែល មាន អនុលោម ភាព មាន ការកើនឡើង ជាលំដាប់ ៕ អភិបាល ខេត្ត កំពត ស្នើ ឱ្យ សេវាករ អ្នកផ្គត់ផ្គង អគ្គិសនី ទូទាំង ខេត្ត ពង្រីក និង ត បណ្តាញ អគ្គិសនី ជូន ពលរដ្ឋ ឲ្យបាន គ្រប់ ខ្នង ផ្ទះ
( កំពត ) ៖ លោក បណ្ឌិត ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត បាន ស្នើឲ្យ សេវាករ អ្នកផ្គត់ផ្គង អគ្គិសនី ទូទាំង ខេត្ត ពង្រីក និង ត បណ្តាញ អគ្គិសនី ជូន ពលរដ្ឋ អោយ បាន គ្រប់ ខ្នង ផ្ទះ ។
ការស្នើ បែប នេះ ខណៈ លោក អភិបាល ខេត្ត ម៉ៅ ធ និន បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សេវាករ អ្នកផ្គត់ផ្គង់ អគ្គិសនី ដែល ទទួល អាជ្ញាប័ណ្ណ ទូទាំង ខេត្ត កំពត នា ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៣ នៅ សាល ប្រជុំ សាលា ខេត្ត កំពត ដោយ ចូលរួម ពីសំណាក់ បណ្ដា ជួរ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង អ្នក ពាក់ព័ន្ធ ជាច្រើន រូប ។
ការប្រជុំ នេះ ក្នុង គោលបំណង រក ដំណោះស្រាយ បញ្ហា ប្រឈម និង សំណូមពរ របស់ ប្រជាពលរដ្ឋ ទាក់ទង និង បញ្ហា ភ្លើង ប្រើប្រាស់ របស់ ប្រជាពលរដ្ឋ តាម ខ្នង ផ្ទះ ព្រមទាំង បញ្ហា ប្រឈម របស់ សេវាករ អគ្គិសនី កន្លងមក ។
លោក អភិបាល ខេត្ត ក៏ បាន លើកឡើង ទៀត ថា ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី បាន យក វិស័យ ចំនួន ៣ ជា អាទិភាព គឺ ផ្លូវ ទឹក ភ្លើង ។ វិស័យ ភ្លើង អគ្គិសនី គឺជា តម្រូវ ការចាំបាច់ ដែល មិន អាច ខ្វះ បាន នា ពេល បច្ចុប្បន្ន ដូច្នេះ សេវាករ ដែល ផ្គត់ផ្គង់ អគ្គិសនី ទាំងអស់ ត្រូវ រួម សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ក្នុង ការពង្រីក បណ្តាញ និង ត បណ្តាញ ជូន ពលរដ្ឋ អោយ បាន គ្រប់ ភូមិ និង គ្រប់ ខ្នង ផ្ទះ របស់ ពលរដ្ឋ ទៅ តាម តម្រូវការ ចង់បាន របស់ ពលរដ្ឋ ។
( ព្រះសីហនុ) ៖ ក្រុម អូរ បរ័ល្បឿន លឿន របស់ ឧកញ៉ា ទៀ វិចិត្រ ប្រធាន គណៈកម្មាធិការ គណបក្ស មូលដ្ឋាន ភ្នាក់ងារ ដឹកជញ្ជូន ទេសចរណ៍ ជល យាន ខេត្ត ព្រះសីហនុ បាន ជួយសង្គ្រោះ ជនរងគ្រោះ ចំនួន ១០នាក់ ដែល ជួប ហេតុការណ៍ ជាប់ នៅលើ ទូក កន្ទុយ វែង មួយ គ្រឿង ដោយសារ ទូក បាន ខូច ស្លាប ចាក់ ហើយក៏ រលក បោក ទូក នៅ កណ្ដាល សមុទ្រ មុខ កោះ ថា ស ខេត្ត ព្រះសីហនុ កាលពី ម៉ោង ជិត ៧ យប់ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៣ ។
ក្រោយពេល បាន ទទួល ដំណឹង នេះ ភ្លាម . ក្រុម អូរ បរ័ល្បឿន លឿន របស់ លោក ឧកញ៉ា ទៀ វិចិត្រ ក៏ បាន ចេញ ជួយសង្គ្រោះ ជនរងគ្រោះ នៅលើ ទូក នោះ ដោយ សុវត្ថិភាព ទាំង១០នាក់ នៅ វេលា ម៉ោង ជិត ៨ យប់ ថ្ងៃ ដដែល ។ បច្ចុប្បន្ន ជនរងគ្រោះ ទាំង១០នាក់ បាន ដឹក មកដល់ ផែ របស់ ក្រុមហ៊ុន GTVC វិញ ដោយ សុវត្ថិភាព ហើយ និង បាន រៀបចំ រថយន្ត របស់ ក្រុមហ៊ុន ជូន ទៅ ផ្ទះ វិញ ផងដែរ ៕
លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម៖ ទោះ ស្ថិត ក្នុង តម្លៃ ណា ក៏ដោយ ត្រូវតែ ប្តេជ្ញា រក្សា ស្ថានភាព កម្ពុជា ជា « កោះសន្តិភាព » ឱ្យ ដូច គោលបំណង ដែល មាន ចែង ក្នុង បុព្វក ថា នៃ រដ្ឋធម្មនុញ្ញ
នៅក្នុង ព្រះរាជ សារ ព្រះអង្គ មាន ព្រះសវនីយ៍ គាំទ្រ លើ មូល បទ « ស្ត្រី រួមគ្នា រក្សា សុខ សន្តិភាព ដើម្បី កិច្ចអភិវឌ្ឍ ក្នុង យុគសម័យ ឌីជីថល » និង រំលេច ពី គុណណូបការៈ របស់ « គោល នយោបាយ ឈ្នះ - ឈ្នះ » ដែល នាំឱ្យ ព្រះរាជាណាចក្រ កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ប្រជារាស្ត្រ ទទួលបាន នូវ ភាព សុខដុមរមនា ទទួលបាន នូវ សិទ្ធិ សេរីភាព ពេញ បរិបូរណ៍ ព្រមទាំង ទទួលបាន នូវ កិច្ច គាំពារ សង្គម ដ៏ ទូលំទូលាយ និង ដោយ ស្មើភាព គ្នា ។
លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម សូម គាំទ្រ យ៉ាង ពេញ ទំហឹង លើ មូល បទ « ស្ត្រី រួមគ្នា រក្សា សុខ សន្តិភាព ដើម្បី កិច្ចអភិវឌ្ឍ ក្នុង យុគសម័យ ឌីជីថល » ។
លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម បាន ថ្លែង ថា យុទ្ធនាការ អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មីនា ខួប ទី ១១២ ឆ្នាំ ២០២៣ នេះ ធ្វើឡើង ក្នុង បរិបទ ល្អ ប្រសើរ ជាង បី ឆ្នាំ កន្លងមក ដែល ក្នុង អំឡុង ពេល នោះ ពិភពលោក ទាំងមូល បាន ឆ្លងកាត់ រួមគ្នា នូវ វិញ្ញាសារ ដ៏ លំបាក បំផុត មួយ គឺ ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល គិត មក ត្រឹម ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ជំងឺ នេះ បាន បំផ្លាញ ជីវិត មនុស្ស អស់ ជាង ៦. ៨៧លាន នាក់ ហើយ ។
លោក កិត្តិនីតិកោសល បណ្ឌិត អ៉ឹម ឈុន លឹម បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា តែងតែ ចាត់ទុក ស្តី្រ ជា ឆ្អឹង ខ្នង នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គមជាតិ ។ ដោយ រក្សា នូវ ប្រពៃណី ទំនៀមទម្លាប់ ល្អ របស់ សង្គម ខ្មែរ ស្ត្រី ខ្មែរ នៅតែ ជា តួអង្គ សំខាន់ និង ចាំបាច់ មិន អាច ខ្វះ បាន នៅក្នុង ដំណើរការ ប្រព្រឹត្តទៅ នៃ ជីវភាព គ្រួសារ ។ ស្ត្រី ខ្មែរ នៅតែ រ៉ាប់រង ការងារ គេហកិច្ច អប់រំ ទូន្មាន កូនប្រុស ស្រី និង មនុស្ស ជុំវិញ ខ្លួន ឱ្យ គិត និង ប្រព្រឹត្ត នូវ ទង្វើ ជា កុសល និង មាន ប្រយោជន៍ ជូន ជាតិ និង សង្គម ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី៖ រដ្ឋាភិបាល ផ្តល់ អាទិភាព ខ្ពស់ ក្នុង ការជំរុញ កិច្ចការពារ ស្ត្រី និង លើកកម្ពស់ សមភាព យេនឌ័រ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អនុប្រធាន ទី២ អាជ្ញាធរ មីន និង ជា អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តល់ អាទិភាព ខ្ពស់ ក្នុង ការជំរុញ កិច្ចការពារ ស្ត្រី និង លើកកម្ពស់ សមភាព យេនឌ័រ ។
ការលើកឡើង បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អញ្ជើញ ជា អធិបតីភាព អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ឆ្នាំ ២០២៣ ខួប លើក ទី១១២ ក្រោម មូល បទ « ស្ត្រី រួមគ្នា រក្សា សុខ សន្តិភាព ដើម្បី កិច្ចអភិវឌ្ឍ ក្នុង យុគសម័យ ឌីជីថល » នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន បន្ត ថា ដើម្បី ឆ្លើយតប នឹង មូល បទ នេះ យើង ត្រូវ រួមគ្នា បន្ត លើកកម្ពស់ និង ជំរុញ ការអនុវត្ត គោល នយោបាយ សមភាព យេនឌ័រ របស់ រាជ រដ្ឋាភិបាល ដែល បាន ចាត់ទុក ស្រ្តី ជា ឆ្អឹង ខ្នង នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គមជាតិ និង ការងារ បញ្ច្រាប យេនឌ័រ ដែល ជា កិច្ចការ អន្តរ វិស័យ ក្នុង យុគសម័យ ឌីជីថល ដែល ជា ការងារ ចម្បង មួយ នៅក្នុង ការធានា បាន នូវ ចីរភាព នៃ សុខ សន្តិភាព និង ពន្លឿន ល្បឿន នៃ កិច្ចអភិវឌ្ឍ ជាតិ ទាំង នៅក្នុង និង ក្រៅ ប្រទេស ។
ប្រមុខ កងទ័ព មុខ ខៀវ កម្ពុជា បាន បញ្ជាក់ ថា យោធិន ជា ស្ត្រី របស់ កម្ពុជា បាន នឹង កំពុង ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការស្វែងរក សុខ សន្តិភាព ក្រោម ឆ័ត្រ អង្គការ សហ ប្រជាជាតិ របស់ កងកម្លាំង រក្សា សន្តិភាព កម្ពុជា និង ការប្តេជ្ញាចិត្ត យ៉ាង មោះមុត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការអនុវត្ត អនុសញ្ញា អន្តរជាតិ នៃ ការហាម ប្រាម ការប្រើប្រាស់ គ្រាប់ មីន ប្រឆាំង មនុស្ស នៅក្នុង ដំណើរ ឆ្ពោះ ទៅកាន់ កម្ពុជា អស់ ការគំរាមកំហែង ដោយសារ គ្រាប់ មីន ប្រឆាំង មនុស្ស ត្រឹម ឆ្នាំ ២០២៥ ។
ទន្ទឹមនឹង នេះ ដែរ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន ឱ្យដឹង ថា ក្នុង ភាពជាដៃគូ យោធិន មន្ត្រី បុគ្គលិក ទាំង ស្ត្រី និង បុរស បាន ចូលរួម ដោយ ស្មើភាពស្មើ សិទ្ធិ ជាមួយ បណ្តា ប្រទេស នានា ទាំង ក្នុង តំបន់ និង សកលលោក ជាពិសេស នៅក្នុង យុគសម័យ ឌីជីថល និង នៅក្នុង របៀបវារៈ ស្តារ សេដ្ឋកិច្ច - សង្គម ក្រោយ វិបត្តិ កូវីដ១៩ ក៏ ដូចជា ការកសាង ភាពធន់ ភាពរឹងមាំ និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
( ភ្នំពេញ ) ៖ យុវជន អង្គការ សង្គម ស៉ី វិល តាមរយៈ សេចក្ដីថ្លែងការណ៍ នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន ប្រកាស ជំហរ ប្រឆាំង ដាច់ខាត ចំពោះ បុគ្គល ណា សកម្មភាព ទាំងឡាយ ណា ដែល នាំឲ្យ មាន វិនាសកម្ម ដល់ ប្រទេស កម្ពុជា និង មើលឃើញ ថា បើ យើង ធ្វេសប្រហែល សន្តិភាព និង ការអភិវឌ្ឍ ដែល កំពុង មាន ក្នុង ពេល បច្ចុប្បន្ន នេះ អាចនឹង បាត់បង់ ហើយ ប្រទេសជាតិ ធ្លាក់ ក្នុង សង្គ្រាម ម្តង ទៀត ជាក់ ជា មិន ខាន ។
យុវជន អង្គការ សង្គម ស៊ីវិល ពិតជា មាន មោទនៈ ភាព ចំពោះ ការខិតខំ ប្រឹងប្រែង ឥត ឈប់ឈរ ទាំង យប់ ទាំង ថ្ងៃ ដើម្បី បុព្វហេតុ ជាតិ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។ រាជ រដ្ឋាភិបាល សព្វ ថ្ងៃ បាន ស្រោចស្រង់ ដឹកនាំឲ្យ កម្ពុជា បាន ងើប មុខ លើ ឆាក អន្តរជាតិ បង្ហាញ ពី ភាពរីកចម្រើន លើ គ្រប់ វិស័យ រក្សា បាន នូវ សុខ សន្តិភាព ឯករាជ្យភាព អធិបតេយ្យ បូរណភាព ទឹកដី យ៉ាង ពេញលេញ ។
កន្លងមក ប្រជាពលរដ្ឋ កម្ពុជា ធ្លាប់ គ្រោះ ដោយសារ សង្គ្រាម ស៊ីវិល រស់ នៅក្នុង ភាពភ័យខ្លាច អត់ឃ្លាន និង បែកបាក់ គ្រួសារ ហេដ្ឋារចនាសម្ព័ន្ធ ត្រូវបាន បំផ្លាញ គ្រប់ ទីកន្លែង ដែល បាន ដឹត ដាម ក្នុង ក្រអៅបេះដូង ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ រូប មិន អាច បំភ្លេង បាន និង មិន ចង់ឱ្យ កើតមាន សារជាថ្មី នោះ ទេ ។ ប្រវត្តិ ដ៏ ជូរចត់ កន្លងមក នេះ អាច ជា មេរៀន សម្រាប់ យើង ជា យុវជន គួរ គិតគូរ ឱ្យ បាន វែងឆ្ងាយ ដើម្បី បញ្ចៀស ការបែកបាក់ គា្ន ដោយសារ អ្នកនយោបាយ ជុល និយម ឬ បរទេស ខិល ខូច ជាដើម ។
យើងខ្ញុំ ទាំងអស់ គ្នា សូម អំពាវនាវ ដល់ បណ្តា អង្គការ សង្គម ស៊ីវិល សារព័ត៌មាន ជាតិ និង អន្តរជាតិ យុវជន ខ្មែរ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ មេត្តា ចូលរួម បន្ត រក្សា និង ការពារ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ដើម្បី ជនជាតិ ខ្មែរ ជំនាន់ ក្រោយ អាច បន្ត រស់ នៅ សុខសាន្ត ជាមួយនឹង សន្តិភាព ជានិច្ច និរន្ត៍៕ រដ្ឋមន្រ្តី សង្គមកិច្ច ស្នើ អង្គការ ដៃគូ ពង្រឹង កិច្ចសហការ ដើម្បី ធានា ការ ការពារ សិទ្ធិ និង ដើម្បី ឧត្តម ប្រយោជន៍ របស់ កុមារ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ផ្តល់ ការគាំទ្រ ដល់ គម្រោង របស់ អង្គការ និង ស្នើ ដល់ អង្គការ សង្គ្រោះ កុមារ និង អង្គការ ដៃគូ ដទៃ ទៀត ពង្រឹង កិច្ចសហការ គ្នា ក្នុង ការអនុវត្ត កម្មវិធី របស់ ខ្លួន ប្រកបដោយ ប្រសិទ្ធភាព សំដៅ ធានា ការ ការពារ សិទ្ធិ និង ដើម្បី ឧត្តម ប្រយោជន៍ របស់ កុមារ នៅ កម្ពុជា ។
ក្នុង ជំនួប នោះ រដ្ឋមន្រ្តី វង សូត ក៏ បាន សម្តែង ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហការ បាន យ៉ាង ល្អ របស់ អង្គការ ក្នុង ការរួមចំណែក យកចិត្តទុកដាក់ ចំពោះ កិច្ចការពារ កុមារ នៅ កម្ពុជា ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ហុង រស្មី នាយក អង្គការ សង្គ្រោះ កុមារ បាន ថ្លែង ឱ្យដឹង ថា អង្គការ មាន គម្រោង កម្មវិធី ធំ ៗ ចំនួន ៤រួម មាន ទី១ គម្រោង ពង្រឹង ប្រព័ន្ធ កិច្ចការពារ កុមារ នៅ សហគមន៍ . ទី២ គម្រោង កិច្ចការពារ កុមារ តាមរយៈ ការពង្រឹង ប្រព័ន្ធ និង ភ្តុស តាង . ទី៣ គម្រោង អភិបាលកិច្ច សិទ្ធិ កុមារ និង ទី៤ គម្រោង ថែទាំ កុមារ ក្នុង គ្រួសារ ជា អាទិភាព ចម្បង ។
លោក នាយក ក៏ បាន ស្នើសុំ បន្ត ចុះ កិច្ចព្រមព្រៀង ជាមួយ ក្រសួង លើ អនុវត្ត គម្រោង កម្មវិធី បន្ត តាម ផែនការ ដែល បាន គ្រោង ទុក ដើម្បី រួមចំណែក សម្រេច ផែនការ យុទ្ធសាស្រ្ត របស់ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ស្រប តាម គោល នយោបាយ រាជ រដ្ឋាភិបាល កម្ពុជា ។
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ប្រមាណ ៣រសៀល ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ មាន ករណី អគ្គិភ័យ មួយ កំពុង ឆេះ រោងចក្រ កាត់ដេរ យ៉ាង សន្ធោ សន្ធៅ នៅ ភូមិ ត្រពាំង ជ្រៃ សង្កាត់ កាកាប២ ខណ្ឌ ពោធិ៍សែនជ័យ ។ នៅ ពេល នេះ កម្លាំង សមត្ថកិច្ច កំពុង ចេញ អន្ដរាគន៍ ដើម្បី ជួយសង្គ្រោះ ។
នៅ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ចិន បាន បង្កើន សកម្មភាព របស់ យោធា ខ្លួន នៅ ជុំវិញ តៃវ៉ាន់ ដោយ រួម មាន ទាំង ការបញ្ជូន យន្តហោះ យោធា សឹងតែ ជារៀងរាល់ ថ្ងៃ ចូលមកកាន់ តំបន់ កំណត់ អត្តសញ្ញាណ សម្រាប់ ការពារ ដែន អាកាស ដែល ហៅ ថា ADIZ របស់ កោះ តៃវ៉ាន់ ។ យ៉ាងណាមិញ តៃវ៉ាន់ ពុំ ទាន់ បាន រាយការណ៍ អំពី ឧប្បត្តិហេតុ ណាមួយ ស្តីពី កងកម្លាំង យោធា ចិន ចូលមក ក្នុង តំបន់ សមុទ្រ តភ្ជាប់ ដែល លាតសន្ធឹង ចម្ងាយ ៤៤. ៤គីឡូម៉ែត្រ ពី បណ្តោយ ឆ្នេរ របស់ ខ្លួន នៅឡើយ ទេ ។
គួរ បញ្ជាក់ ថា ទីក្រុង ប៉េកាំង ចាត់ទុក កោះ តៃវ៉ាន់ ត្រឹម ជា ខេត្ត មួយ ប៉ុណ្ណោះ របស់ ប្រទេស ចិន ហើយ មិន ដែល ប្រកាស បោះបង់ ចោល ជម្រើស នៃ ការប្រើប្រាស់ កម្លាំង យោធា ដើម្បី បង្រួបបង្រួមគ្នា វិញ ជាមួយ តៃវ៉ាន់ ឡើយ ៕ រដ្ឋមន្រ្តី ក្រសួង កិច្ចការ នារី៖ ក្រោម ម្លប់ នៃ សន្តិភាព និង កិច្ចអភិវឌ្ឍ ស្រ្តី កម្ពុជា ជា កម្លាំង ចលករ ដែល បាន រួមចំណែក ក្នុង កំណើន សេដ្ឋកិច្ច
( ភ្នំពេញ ) ៖ លោកស្រី កិត្តិបណ្ឌិត អ៊ឹង កន្ថា ផាវី រដ្ឋមន្រ្តី ក្រសួង កិច្ចការ នារី នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន លើកឡើង ថា ក្រោម ម្លប់ នៃ សន្តិភាព និង កិច្ចអភិវឌ្ឍ ស្រ្តី កម្ពុជា ជា កម្លាំង ចលករ ដែល បាន រួមចំណែក ក្នុង កំណើន សេដ្ឋកិច្ច ហើយ បច្ចុប្បន្ន ស្ត្រី មាន កាលានុវត្តភាព ក្នុង ការអនុវត្ត សិទ្ធិ អភិវឌ្ឍ ចំណេះដឹង ជំនាញ និង បច្ចេកទេស ។
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោកស្រី កិត្តិបណ្ឌិត អ៊ឹង កន្ថា ផាវី ចូល ជួប សំដែង ការគួរសម សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រមុខរដ្ឋ ស្តីទី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ឱកាស ប្រារព្ធ ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មីនា ខួប ទី ១១២ ឆ្នាំ ២០២៣ ។ ជំនួប នេះ បាន រៀបចំ ធ្វើឡើង នៅ វិមាន ព្រឹទ្ធសភា នា ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៣ ។
លោកស្រី កិត្តិបណ្ឌិត អ៊ឹង កន្ថា ផាវី បាន បញ្ជាក់ ឲ្យដឹង ថា បច្ចុប្បន្ន ស្ត្រី មាន កាលានុវត្តភាព ក្នុង ការអនុវត្ត សិទ្ធិ អភិវឌ្ឍ ចំណេះដឹង ជំនាញ និង បច្ចេកទេស ដែល ជា មូលដ្ឋានគ្រឹះ ក្នុង ការចូលរួម ប្រកួតប្រជែង ប្រកប ដោយ សក្ដានុពល នៅក្នុង ទីផ្សារ សេដ្ឋកិច្ច ថ្នាក់ ជាតិ និង នៅក្នុង តំបន់ ។
លោកស្រី រដ្ឋមន្ដ្រី ក្រសួង កិច្ចការ នារី បាន បន្ថែម ទៀត ថា ស្ដ្រី ក៏ ជា អ្នក ទទួលបាន ភាគ ផល ពី កិច្ចអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដែល ធ្វើឲ្យ ជីវភាព រស់ នៅ របស់ គេ និង គ្រួសារ មាន ភាពប្រសើរឡើង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការកាត់បន្ថយ ភាព ភាពក្រីក្រ និង ភាពងាយ រងគ្រោះ ។
បើ តាម រដ្ឋមន្ដ្រី អ៊ឹង កន្ថា ផាវី គោល នយោបាយ និង យុទ្ធសាស្រ្ត លើកកម្ពស់ សមភាព យេនឌ័រ មាន ទស្សនៈ វែងឆ្ងាយ ដោយ អនុញាត ឲ្យ ប្រជាជនជា ស្ត្រី ដែល មាន ចំនួន ជាង ៥០% នៃ ប្រជាជន សរុប ទទួលបាន សិទ្ធិ មាន ជម្រើស ក្នុង ការដឹកនាំ ជីវិត របស់ ខ្លួន និង មាន កាលានុវត្តភាព ចូលរួម ប្រកបដោយ សក្តានុពល ក្នុង កិច្ចអភិវឌ្ឍ សង្គម និង សេដ្ឋ - កិច្ច ជាតិ ។
រដ្ឋមន្ដ្រី អ៊ឹង កន្ថា ផាវី បាន បញ្ជាក់ ថា ក្នុង ន័យ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចាត់ទុក ស្រ្តី ជា មូលធន មនុស្ស ដ៏ សំខាន់ និង មិន អាច ខ្វះ បាន ក្នុង កិច្ចអភិវឌ្ឍ ហើយ បាន រំលេច ក្នុង យុទ្ធសាស្រ្ត ចតុកោណ គ្រប់ ដំណាក់កាល ថា ស្រ្តី គឺជា ឆ្អឹង ខ្នង នៃ សេដ្ឋកិច្ច និង សង្គមជាតិ ។
ជាមួយគ្នា នេះ លោកស្រី អ៊ឹង កន្ថា ផាវី បាន គូសបញ្ជាក់ ថា ឆ្នាំ ២០២៣ នេះ ក្រសួង កិច្ចការ នារី សហការ ជាមួយ ក្រសួង - ស្ថាប័ន អង្គការ សង្គម ស៊ីវិល ដៃគូ អភិវឌ្ឍន៍ វិស័យ ឯកជន រួមទាំង បណ្តាញ ផ្សព្វផ្សាយ និង ដៃគូ ពាក់ព័ន្ធ បាន រៀបចំ ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មីនា ខួប ទី១១២ ក្រោម មូល បទ « ស្រ្តី រួមគ្នា រក្សា សុខ សន្តិភាព ដើម្បី កិច្ចអភិវឌ្ឍ ក្នុង យុគសម័យ ឌីជីថល » ក្នុង គោលបំណង បន្ត រំលេច៖
លោកស្រី បញ្ជាក់ ថា ចំណុច នេះ តម្រូវឲ្យ យើង គិតគូរ លើ សក្តានុពល និង កាលានុវត្តភាព នានា ដើម្បី ធានា ថា ស្រ្តី និង ក្លាយជា មូលធន មនុស្ស ដ៏ មាន សក្តានុពល ផ្អែក លើ ចំណេះដឹង អាច បន្ត ចូលរួម យ៉ាង ពេញលេញ និង ទទួល ភាគ ផល ពី កិច្ចអភិវឌ្ឍ នៅ គ្រប់ ជំនាន់ ដើម្បី កសាង មូលដ្ឋាន ឆ្ពោះទៅ សម្រេច ចក្ខុវិស័យ កម្ពុជា ឆ្នាំ ២០៥០ ដោយ មិន ទុក នរណា ម្នាក់ ឲ្យ នៅឯ កោ ។
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន សម្ដែង នូវ ការគាំទ្រ មូលបទ ដែល ក្រសួង កិច្ចការ នារី បាន កំណត់ យក ឆ្នាំ នេះ ពិតជា មាន សារៈសំខាន់ ដែល ឆ្លុះបញ្ចាំង ពី តម្លៃ និង វត្តមាន របស់ ស្រ្តី កម្ពុជា ក្នុង ការចូលរួ ម ថែរក្សា សុខ សន្តិភាព និង ការពន្លឿន កិច្ចអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
លើស ពី នោះ ទៀត ព្រមទាំង បាន ឆ្លុះបញ្ចាំង ពី ចក្ខុវិស័យ ទៅ អនាគត ក្នុង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ក្នុង យុគសម័យ ឌីជីថល ខណៈ ដែល យើង ទាំងអស់ គ្នា បាន ឆ្លងកាត់ វិបត្តិ កូវីដ - ១៩ និង ខិតខំ ប្រឹងប្រែង ស្តារ សង្គម សេដ្ឋកិច្ច ឡើងវិញ និង កសាង ភាពធន់ និង ភាពរឹងមាំ របស់ កម្ពុជា ក្រោម ម្លប់ នៃ សន្តិភាព ៕ សម្តេច ពញា ចក្រី ហេង សំរិន អនុញ្ញាតឱ្យ ឯក អគ្គ រដ្ឋទូត ថ្មី កូរ៉េ ចូល ជួប សម្តែង ការគួរសម
លោក បណ្ឌិត ផាក ជុង វ៉ូក បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដែល សម្តេច ប្រធាន បាន អនុញ្ញាតឱ្យ ចូល ជួប សម្តែង គួរ សម នា ឱកាស នេះ ។ លោក បណ្ឌិត បាន អបអរសាទរ និង ថ្លែង ការកោតសរសើរ ចំពោះ ការរីកចម្រើន នៃ កម្ពុជា នៅលើ គ្រប់ វិស័យ ។
ចំពោះ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ការទូត សភា វិញ សម្តេច បាន លើកឡើង ថា រដ្ឋសភា ប្រទេស ទាំង ពីរ បាន រួមចំណែក យ៉ាង សកម្ម ក្នុង ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ រវាង រដ្ឋាភិបាល ទំាង ពីរ តាមរយៈ ការចែករំលែក បទពិសោធន៍ ពី ការងារ នីតិកម្ម ការផ្លាស់ប្តូរ ទស្សនកិច្ច ថ្នាក់ដឹក នំា និង គណៈកម្មការ ជំនាញ នានា នៃ សភា ទាំង ពីរ ។ សភា ទាំង ពីរ តែង គាំទ្រ គ្នា ទៅ វិញ ទៅ មក លើ វេទិកា អន្តរសភា នានា ទាំង ក្នុង តំបន់ និង សកលលោក ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន សម្តែង ក្តីសង្ឃឹម យ៉ាង មុត មំា ថា ក្នុង អាណត្តិ បេសកកម្ម ការ ទូត ថ្មី របស់ លោក នៅ កម្ពុជា កិច្ចសហប្រតិបត្តិការ នានា នឹង បន្ត ពង្រឹង ពង្រីក ឥត ឈប់ឈរ លើ គ្រប់ វិស័យ ឱ្យ កាន់តែ ស្អិត រមួត បន្ថែម ទៀត ៕
គួរ បញ្ជាក់ ថា យន្តហោះ ខាងលើ ប្រភេទ Boeing 737 មាន ផ្ទុក អ្នកដំណើរ សរុប ១៤៧ នាក់ និង សហសេវិក យន្តហោះ ៦នាក់ ។ សត្វ បក្សី មួយ ហ្វូង បាន បុក ចំ ម៉ាស៉ីន មួយ គ្រឿង របស់ យន្តហោះ ក្រោយ វា ធ្វើដំណើរ ចេញពី អាកាសយានដ្ឋាន ក្នុង ទីក្រុង ឡាហាវ៉ាន់ បាន តែ បន្តិច ប៉ុណ្ណោះ ។ ក្រុម ពី ឡុត បាន នាំយក យន្តហោះ នោះ ត្រឡប់ ទៅ ចុះចត នៅ ទីតាំង ដើម វិញ ដោយ សុវត្ថិភាព ហើយ អ្នកដំណើរ ត្រូវបាន ជម្លៀស ចេញពី យន្តហោះ តាម ពោង ខ្យល់ រំអិល ដោយសារតែ ផ្សែង ៕
