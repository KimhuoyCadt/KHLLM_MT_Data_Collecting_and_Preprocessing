( ភ្នំពេញ ) ៖ ពេល ឃើញ អាជ្ញាធរ ប្រទេស ឥណ្ឌា ចុះ ឡោមព័ន្ធ និង ឆែកឆេរ ទីស្នាក់ការសារព័ត៌មាន BBC របស់ អង់គ្លេស ក្នុង ទីក្រុង មុម បៃ និង ញូវ ដេលី ក្រោយពី សារព័ត៌មាន នេះ ចេញផ្សាយ ឯកសារ វីដេអូ វាយប្រហារ លើ ប្រធានាធិបតី ឥណ្ឌា ធ្វើឲ្យ យើង នឹកឃើញ ដល់ ប្រតិបត្តិការ ក្តៅ គគុក ជា ទ្រង់ទ្រាយ ធំ របស់ សហរដ្ឋ អាមេរិក និង សហភាព អឺរ៉ុប ដែល មាន សមាជិក ២៧ ប្រទេស ក្នុង ការបិទ ខ្ទប់ សារព័ត៌មាន របស់ រុស្ស៊ី RT និង Sputnik ទាំងអស់ ឲ្យ លែង មើលឃើញ នៅលើ ទឹកដី របស់ ខ្លួន កាលពី ឆ្នាំ ទៅ មិញ ។
អត្ថបទ ដោយ៖ បញ្ញវន្ត ខ្មែរ
រដ្ឋមន្ត្រី ការពារ ជាតិ អ៊ុយក្រែន មាន ទំនុកចិត្ត ថា ប្រទេស ខាងលិច នឹង បញ្ជូន យន្តហោះ ចម្បាំង ដល់ ទីក្រុង កៀវ
លោក បាន បន្ត ថា យន្តហោះ ចម្បាំង ត្រូវបាន គេ ត្រូវការ ជា ផ្នែក មួយ នៃ ប្រព័ន្ធ ការពារ ដែន អាកាស ដ៏ ទូលំទូលាយ ដើម្បី ការពារ អ៊ុយក្រែន ពី ការវាយប្រហារ របស់ រុស្ស៊ី ។
ប្រទេស ផ្សេង ទៀត ដូចជា ប៉ូឡូញ បាន បង្ហាញ ថា ពួកគេ បើក ចំហ ចំពោះ គំនិត នេះ ប៉ុន្តែ នឹង ធ្វើ សកម្មភាព ដោយ ការគាំទ្រ របស់ លោក ខាងលិច ប៉ុណ្ណោះ ។ អង់គ្លេស បាន និយាយ ថា ខ្លួន នឹង ផ្តល់ ការបណ្តុះបណ្តាល សម្រាប់ អ្នកបើក យន្តហោះ ចម្បាំង អ៊ុយក្រែន ប៉ុន្តែ មិន ទាន់ សម្រេចចិត្ត ថា តើ ត្រូវ ផ្តល់ យន្តហោះ ដល់ ពួកគេ ឬ អត់ ៕
ក្រោយ បទ បញ្ជា សម្តេច តេជោ . ថ្ងៃ នេះ រដ្ឋមន្ត្រី សុខាភិបាល ចុះ រៀបចំ ភ្លាម ៗ កន្លែង ព្យាបាល ឥត គិត ថ្លៃ ដល់ កីឡាករ កីឡាការិនី នៅ មន្ទីរពេទ្យ តេជោ សន្ដិភាព
( ភ្នំពេញ ) ៖ បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន សម្រេច ឲ្យ ក្រសួង សុខាភិបាល រៀបចំ ទីកន្លែង សម្រាប់ ព្យាបាល កីឡាករ កីឡាការិនី ដែល រង របួស ក្នុង ការប្រកួត ដោយ ឥត គិត ថ្លៃ នៅ មន្ទីរពេទ្យ ជាតិ តេជោ សន្តិភាព កាលពី ព្រឹក ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នៅ រសៀល ថ្ងៃ ដដែល នេះ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ដឹកនាំ ក្រុមការងារ ចុះ រៀបចំ ភ្លាម ៗ ។
លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ថ្លែង ថា ដោយ គោរព តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា ថ្ងៃ នេះ ក្រុមការងារ របស់ យើង បាន ចុះ មក រៀបចំ ភ្លាម ៗ ទាំង បន្ទប់ វះកាត់ គ្រែ ចំនួន ២០០ និង ក្រុម គ្រូពេទ្យ រួមទាំង សម្ភារៈ បរិក្ខារ នានា ក្នុង នោះ ក៏ មាន នូវ រថយន្ដ គិលាន សង្គ្រោះ ចល័ត ដែល មាន សម្ភារៈ វះកាត់ ក្នុង នោះ ស្រាប់ ផងដែរ ដើម្បី តៀម សង្គ្រោះ ភ្លាម ៗ ២៤លើ ២៤ ដោយ ឥត គិត ថ្លៃ ដល់ កីឡាករ កីឡាការិរី ដែល របួស ។
រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន បន្ថែម ថា « ខ្ញុំ បាន ជំរុញ លើ ទឹកចិត្ដ ដល់ មន្ដ្រី របស់ ខ្ញុំ បំពេញ ការងារ ឱ្យ បាន ល្អ សមស្រប តាម គោលបំណង របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី កម្ពុជា ដែល លោក បាន ខិតខំ កសាង មន្ទីរពេទ្យ តេជោ សន្ដិភាព ដ៏ ធំ ដូច្នេះ ពេទ្យ ក៏ ធំ បេះដូង យើង ជា គ្រូពេទ្យ ក៏ ទូលាយ រួមគ្នា ខិតខំ ប្រឹងប្រែង ធ្វើការងារ ឱ្យ អស់ ពី លទ្ធភាព » ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ បាន សម្រេច ឲ្យ ក្រសួង សុខាភិបាល រៀបចំ ទីកន្លែង សម្រាប់ ព្យាបាល កីឡាករ កីឡាការិនី ដែល រង របួស ក្នុង ការប្រកួត ដោយ ឥត គិត ថ្លៃ នៅ មន្ទីរពេទ្យ ជាតិ តេជោ សន្តិភាព ។
ការសម្រេច នេះ ធ្វើឡើង បន្ទាប់ពី កន្លងមក សម្តេច មើលឃើញ ពី ការលំបាក របស់ បងប្អូន កីឡាករ កីឡាការិនី មួយចំនួន ដែល បាន រងរបួស ដោយ ការប្រកួត ហើយ លំបាក ក្នុង ការព្យាបាល នៅ តាម មន្ទីរពេទ្យ រដ្ឋ និង ឯកជន ដោយ រាប់ ទាំង ការលំបាក លើ ការចំណាយ ថវិកា ផងដែរ ។
ជាមួយគ្នា នេះ សម្តេច តេជោ បាន ជំរុញ ឲ្យ ក្រសួង សុខាភិបាល រៀបចំ ឲ្យ បាន ឆាប់ ដែល នឹង អាច ចូលរួម ផងដែរ ដល់ ការប្រកួត ស៊ីហ្គេម នា ពេល ខាងមុខ នេះ ៕ សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣
១៖ ប្រធានាធិបតី អាល្លឺម៉ង់ កោតសរសើរ ការដឹកនាំ របស់ សម្តេច តេជោ
២៖ រុស្ស៉ី កំពុង ត្រៀម ធ្វើ សង្រ្គាម អាកាស ទ្រង់ទ្រាយ ធំ ខណៈ សង្រ្គាម នៅលើ ដីកាន់តែ សាហាវ
៤៖ សម្តេច តេជោ ហ៊ុន សែន បញ្ជា ឲ្យ ក្រសួង សុខាភិបាល រៀបចំ កន្លែង ព្យាបាល ដោយ ឥត គិត ថ្លៃ ដល់ កីឡាករ កីឡាការិនី ដែល រង របួស
៥៖ អាមេរិក ផ្តល់ កិច្ចសន្យា តម្លៃ ជាង ៥០០ លាន ដុល្លារ ដល់ ក្រុមហ៊ុន ចំនួន ពីរ ដើម្បី ផលិត គ្រាប់ កាំភ្លើង ធំ ឱ្យ អ៊ុយក្រែន
៦៖ ប្រធានាធិបតី ចិន លោក ស៊ី ជិន ពីង បង្ហាញ សាមគ្គីភាព ជាមួយ អ៉ីរ៉ង់ ចំពោះ មុខ ភាពតានតឹង ជាមួយ អាមេរិក
៧៖ អាជ្ញាធរ ឥណ្ឌា ឆែកឆេរ ការិយាល័យ សារព័ត៌មាន អង់គ្លេស BBC ពីរ ថ្ងៃ ជាប់ គ្នា ក្រោយ ភាពចម្រូងចម្រាស ពាក់ព័ន្ធ វីដេអូ ឯកសារ ដែល រិះគន់ នាយក រដ្ឋមន្រ្តី ឥណ្ឌា
៩៖ ក្រុម សង្រ្គោះ បន្ត រកឃើញ អ្នក នៅ មាន ជីវិត ៩នាក់ ទៀត ខណៈ មនុស្ស ស្លាប់ ក្នុង គ្រោះ រញ្ជួយ ដី កើនឡើង លើស ៤១.០០០ នាក់ នៅ តួកគី និង ស៉ីរី
១០៖ កម្ពុជា កំពុង រក ដៃគូ វិនិយោគ គម្រោង ផ្លូវ ដែក ល្បឿន លឿន តម្លៃ ជាង ៤ពាន់ លាន ដុល្លារ ខណៈ ប្រធានាធិបតី ចិន គាំទ្រ ការតភ្ជាប់ ផ្លូវ ដែក ពី កម្ពុជា - ថៃ - ឡាវ ទៅ ចិន ដោយ ផ្តល់ ជំនួយ ៤៥ លាន ដុល្លារ ដល់ កម្ពុជា សម្រាប់ សិក្សា លំអិត
១១៖ រដ្ឋបាល លោក ចូ បៃ ដិន ប្រកាស ផ្តល់ ថវិកា ជាង ២៣០ លាន ដុល្លារ ដើម្បី គាំទ្រ ការ ទប់ស្កាត់ អំពើហិង្សា ដោយ កាំភ្លើង នៅក្នុង សហរដ្ឋ អាមេរិក
១២៖ ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល៖ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - បាវិត គ្មាន ការលុបចោល ឬ ពន្យារ ពេល នោះ ទេ . ក្រុមហ៊ុន សាងសង់ សន្យា ថា នឹង ចាប់ផ្ដើម នៅ ឆ្នាំ នេះ គ្រោង បញ្ចប់ នៅ ឆ្នាំ ២០២៧
១៣៖ យន្ដហោះ ចម្បាំង អាមេរិក ហោះ ប្រដេញ តាម យន្ដហោះ ចម្បាំង រុស្ស៉ី នៅក្បែរ រដ្ឋ អាឡា ស្កា
១៤៖ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ប្រមូល ចំណូល ចូល ថវិកា ជាតិ ប្រមាណ ១០លាន ដុល្លារ ពី ការលក់ ស្លាកលេខ ពិសេស ក្នុង ឆ្នាំ ២០២២
១៥៖ អាមេរិក កាណាដា និង មហា អំណាច អឺរ៉ុប ប្រឆាំងជំទាស់ គម្រោង ពង្រីក សំណង់ អាណានិគម ខុស ច្បាប់ របស់ អ៉ី ស្រាអែល
១៦៖ អភិបាល ខេត្ត ព្រះសីហនុ៖ សំណង់ ខ្ពស់ ៗ ចំនួន ៣០៣ អគារ កំពុង ដំណើរការ អាជីវកម្ម នៅ ខេត្ត ព្រះសីហនុ ខណៈ អគារ ៣៥៩កន្លែង ត្រូវបាន ទុកចោល ដោយសារ វិបត្តិ ជំងឺ កូវីត
១៧៖ អាជ្ញាធរ ឥណ្ឌា ឆែកឆេរ ការិយាល័យ សារព័ត៌មាន អង់គ្លេស BBC ពីរ ថ្ងៃ ជាប់ គ្នា ក្រោយ ភាពចម្រូងចម្រាស ពាក់ព័ន្ធ វីដេអូ ឯកសារ ដែល រិះគន់ នាយក រដ្ឋមន្រ្តី ឥណ្ឌា
លោក ថ្លែង បែប នេះ នា រសៀល ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ពេល អញ្ជើញ ធ្វើ សន្និសីទ សារព័ត៌មាន សង្ខេប អំពី លទ្ធផល នៃ ដំណើរទស្សនកិច្ច របស់ សម្តេច ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ប្រទេស ចិន ។
លោក វ៉ាង វិធាន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ « ខ្ញុំ សូម បញ្ជាក់ ថា កិច្ចសហប្រតិបត្តិការ វិស័យ ពាណិជ្ជកម្ម និង ការវិនិយោគ រវាង ចិន និង កម្ពុជា មាន ភាពស៉ី ជម្រៅ ហើយ មាន ភាពល្អ ប្រសើរ ។ ក្រោយពី សហភាព អឺរ៉ុប បាន ប្រកាស កាត់ EBA ពី ប្រទេស កម្ពុជា យើង ក៏ បាន ស្រាវជ្រាវ អំពី ស្ថានភាព មួយចំនួន ។ តាម ការស្រាវជ្រាវ របស់ ខ្ញុំ ខ្ញុំ គិត ថា ពិតជា មាន សហគ្រាស មួយចំនួន គេ បាន ប្រឈម បញ្ហា មួយចំនួន ប៉ុន្តែ ក៏ មាន សហគ្រាស កាន់តែ ច្រើន មក វិនិយោគ នៅ ប្រទេស កម្ពុជា » ។
លោក ឯក អគ្គ រដ្ឋទូត ក៏ បាន បង្ហាញ ភាពជឿជាក់ ថា ទោះ ប្រឈម នឹង បញ្ហា យ៉ាងម៉េច ក៏ កិច្ចសហប្រតិបត្តិការ ជាក់ស្តែង នៃ ប្រទេស ទាំង ពីរ នឹង អភិវឌ្ឍន កាន់តែ ល្អ ។ បន្ថែម លើ នេះ ការវិនិយោគ ពី ចិន មក កម្ពុជា បាន កើនឡើង ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ។
ក្រសួង សុខាភិបាល ជូនដំណឹង ពី ការប្រឡង ជ្រើសរើស មន្ត្រីរាជការ ចំនួន ២០០ នាក់ ចូល បម្រើ ការងារ នៅ មន្ទីរពេទ្យ ជាតិ តេជោ សន្តិភាព
( ភ្នំពេញ ) ៖ លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ពី ការប្រឡង ជ្រើសរើស មន្ត្រីរាជការ ចំនួន ២០០ នាក់ ចូល បម្រើ ការងារ នៅ មន្ទីរពេទ្យ ជាតិ តេជោ សន្តិភាព សម្រាប់ ឆ្នាំ ២០២៣ ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន នៅ ស្ថានទូត ចិន លោក វ៉ាង វិន ធាន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ « ចាប់ពី ឆមាស ទី២ ឆ្នាំ មុន ចិន និង កម្ពុជា បាន សហការ ជាមួយគ្នា ដើម្បីឲ្យ អ្នក ពាក់ព័ន្ធ នឹង ឧក្រិដ្ឋកម្ម ត្រលប់ ទៅវិញ ។ យើង អាច និយាយ បាន ទេ កិច្ចសហប្រតិបត្តិការ រវាង ចិន និង កម្ពុជា ធ្វើឲ្យ ឧក្រិដ្ឋកម្ម ដែល ពាក់ព័ន្ធ នឹង ជនជាតិ ចិន នៅ កម្ពុជា ត្រូវបាន កាត់បន្ថយ ដែល គួរឲ្យ កត់សម្គាល់ ហើយ បាន ផ្តល់ អំណោយផល ដល់ បរិយាកាស សន្តិសុខ និង សុវត្ថិភាព ដល់ សហប្រតិបត្តិការ សេដ្ឋកិច្ច ទេសចរណ៍ និង ពាណិជ្ជកម្ម » ។
បើ តាម លោក ឯក អគ្គ រដ្ឋទូត កិច្ចសហប្រតិបត្តិការ បង្ក្រាប ឧក្រិដ្ឋកម្ម ជួញដូរ មនុស្ស គឺជា កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អនុវត្ត ច្បាប់ ហើយ កិច្ចសហប្រតិបត្តិការ នេះ គឺជា ផ្នែក សំខាន់ សម្រាប់ ប្រទេស ទាំង ពីរ កសាង សហគមន៍ រួម វាសនា តែ មួយ ។ លោក រំលឹក ថា នៅ ឆ្នាំ ២០១៩ ចិន និង កម្ពុជា បាន បើក កិច្ចសហប្រតិបត្តិការ អនុវត្ត ច្បាប់ ដោយ ផ្តោត សំខន់ លើ ការប្រយុទ្ធ ប្រឆាំង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ហើយ បាន ផ្តោត សំខាន់ ទៅ លើ ឧក្រិដ្ឋកម្ម ដូចជា ការលេង ល្បែង ស៉ី សង តាម អនឡាញ ជាដើម ។
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១៣.០១៥ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១០.៨០៦ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២. ២០៩ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ល្មើស សញ្ញា ស្រវឹង ទូរស័ព្ទ និង ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ខ្សែក្រវាត់ ឆៀក ទូរស័ព្ទ អត់ ស្លាកលេខ ល្មើស ល្បឿន អត់ បណ្ណ បើកបរ និង ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១៧លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៩ នាក់ របួស ចំនួន ១៨នាក់ ( របួស ធ្ងន់ ចំនួន ១៣នាក់ ) ។ រយៈពេល ៤៦ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៣៩១ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១៩៩ នាក់ របួស ៤៨៣ នាក់ ( របួស ធ្ងន់ ៣២៩ នាក់ )៕
ប្រមុខរដ្ឋ ស្តីទី រៀបចំ ពិធី លៀង សាយ ភោជន៍ ជា កិត្តិយស ជូន ប្រធានាធិបតី អាល្លឺម៉ង់ និង លោកជំទាវ
ក្នុង ពិធី លៀង សាយ ភោជន៍ ក៍ មាន ការអញ្ជើញ ចូលរួម ពី សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ឥស្សរជន ជាន់ ខ្ពស់ មកពី ស្ថាប័ន ព្រឹទ្ធសភា រដ្ឋសភា និង រាជ រដ្ឋាភិបាល ជាច្រើន រូប ផងដែរ ។
ថ្លែង សន្ទរកថា នៅក្នុង ពិធី លៀង សាយ ភោជន៍ នេះ ក្នុង ព្រះបរម នាម ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន សម្ដែង នូវ សេចក្តីរំភើប រីករាយ និង ថ្លែងអំណរគុណ ចំពោះ លោក ប្រធានាធិបតី នៃ សាធារណរដ្ឋ សហព័ន្ធ អាឡឺម៉ង់ ដែល បាន ជ្រើសរើស ប្រទេស កម្ពុជា ជា គោលដៅ បំពេញ ទស្សនកិច្ច ជា ផ្លូវការ ចាប់ពី ថ្ងៃទី ១៤ ដល់ ថ្ងៃទី ១៦ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ។
សម្តេច បាន ថ្លែង ថា ផ្អែក លើ ប្រវត្តិសាស្ត្រ នៃ ប្រទេស ទាំង ពីរ ចាប់តាំងពី ថ្ងៃ បង្កើត ទំនាក់ ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ១៩៦៧ ពុំ ធ្លាប់ មាន ឥស្សរជន ជាន់ ខ្ពស់ ថ្នាក់ ប្រធានាធិបតី របស់ អាឡឺម៉ង់ មក បំពេញ ទស្សនកិច្ច នៅ ព្រះរាជាណាចក្រ កម្ពុជា ទេ មកទល់ ពេលនេះ ។ លោក ប្រធានាធិបតី គឺជា ឥស្សរជន ទី១ នៃ សាធារណរដ្ឋ សហព័ន្ធ អាឡឺម៉ង់ ដែល បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច ជា ផ្លូវការ ជា ប្រវត្តិសាស្ត្រ នៅ កម្ពុជា នៅ ថ្ងៃ នេះ ។
សម្តេច បាន បន្ត ថា ប្រជាជន កម្ពុជា ស្គាល់ ប្រទេស អាល្លឺម៉ង់ ច្បាស់ និង មាន មនោសញ្ចេតនា ស្រលាញ់ ដោយ ជ្រាលជ្រៅ ជាមួយ ប្រជាជន អាល្លឺម៉ង់ ជា យូរ ណាស់ មកហើយ ។ អាស្រ័យ ហេតុ នេះ សម្ដេច សូម លើកទឹកចិត្ត ដល់ រដ្ឋាភិបាល ទាំង ពីរ មេត្តា ខិតខំ ជំរុញ ការផ្លាស់ប្ដូរ រវាង ប្រជាជន និង ប្រជាជន បាន កាន់តែ ទូលំទូលាយ ទៅវិញ ទៅមក និង សូម លើកទឹកចិត្ត ដល់ រដ្ឋាភិបាល ទាំង ពីរ ខិតខំ បន្ថែម ទៀត នៅក្នុង ការផ្លាស់ប្ដូរ ពាណិជ្ជកម្ម សេដ្ឋកិច្ច វិនិយោគ ទេសចរណ៍ ដើម្បី កំណើន សេដ្ឋកិច្ច រួម ប្រកបដោយ វឌ្ឍនភាព ។
នៅក្នុង សន្ទរកថា នេះ ដែរ សម្ដេច ប្រមុខរដ្ឋ ស្តីទី បាន ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល អាឡឺម៉ង់ ដែល បាន ជួយ ផ្ដល់ ជំនួយ សម្រាប់ ការបោស សំអាត មីន នៅ កម្ពុជា ។ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ គោលដៅ កម្ពុជា គ្មាន មីន នៅ ឆ្នាំ ២០២៥ ។ បន្ថែម ពីលើ នេះ ក្នុង ស្មារតី ជំនួយ មនុស្សធម៌ កម្ពុជា បាន ជួយ បណ្ដុះបណ្ដាល អ្នកដោះ មីន មកពី ប្រទេស អ៊ុយក្រែន ក្រោម កិច្ចសហការ ជាមួយ ប្រទេស ជប៉ុន ។ ដូច្នេះ ជំនួយ របស់ អាល្លឺម៉ង់ សម្រាប់ ការបោសសម្អាត មីន ពិតជា មាន តម្លៃ យ៉ាង ធំធេង ។
ជាមួយ នេះ សម្ដេចក៏ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រៅ បំផុត ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន អាល្លឺម៉ង់ ដែល បាន ផ្ដល់ ជំនួយ អភិវឌ្ឍន៍ ដ៏ ធំធេង ចាប់តាំងពី ឆ្នាំ ១៩៩៤ រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការអភិ វឌ្ឍ សង្គម សេដ្ឋកិច្ច នៅ កម្ពុជា ។
សម្ដេច ប្រមុខរដ្ឋ ស្តីទី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចពិភាក្សា រវាង សម្ដេច ផ្ទាល់ ជាមួយនឹង លោក ប្រធានាធិបតី ក៏ ដូចជា កិច្ចពិភាក្សា រវាង លោក ប្រធានាធិបតី ជាមួយនឹង សម្ដេច នាយក រដ្ឋមន្ត្រី ប្រកបដោយ លទ្ធផល ផ្លែ ផ្កា ដ៏ ត្រចះត្រចង់ ក្រោម ស្មារតី មិត្តភាព ដ៏ ជ្រាលជ្រៅ ស្និទ្ធស្នាល បំផុត ។
ដោយឡែក លោក ប្រធានាធិបតី សាធារណរដ្ឋ សហព័ន្ធ អាល្លឺម៉ង់ បាន បញ្ជាក់ ថា លោក មាន សេចក្តីរីករាយ ណាស់ ដោយ លោក ជា ប្រធានាធិបតី សហព័ន្ធ អាឡឺម៉ង់ ទី មួយ ដែល បាន មក ធ្វើ ទស្សនកិច្ច នៅ ក្នុង ប្រទេស កម្ពុជា ហើយ មាន ឱកាស មក ស្គាល់ មក ដឹង អំពី ទឹកចិត្ត និង ដួង ព្រលឹង ជាតិ របស់ ប្រទេស កម្ពុជា ។
ជាមួយ នេះ លោក ប្រធានាធិបតី បាន សម្ដែង នូវ សេចក្តីរីករាយ ដោយសារ ប្រទេស អាល្លឺម៉ង់ និង ប្រទេស កម្ពុជា បាន ពង្រីក ភាព ជាដៃគូ គ្នា ជា បន្ត ទៀត ដោយ យើង ពុំ ចាំបាច់ ត្រូវតែ មាន មតិ ដូចគ្នា គ្រប់ រឿង ជានិច្ច នោះ ទេ ក៏ប៉ុន្តែ យើង អាច ធ្វើឲ្យ ការពិភាក្សា គ្នា ដែល ប្រកប ទៅ ដោយ ការគោរព ឲ្យ តម្លៃ គ្នា និង ដែល មាន លក្ខណៈ ស្មោះត្រង់ រវាង អ្នក ជា ដៃគូ និង គ្នា នោះ កាន់តែ ស៊ីជម្រៅ ថែម ទៀត ។
លោក បាន បន្ត ទៀត ថា នៅក្នុង ការពិភាក្សា គឺ យើង ពុំ មែន គ្រាន់តែ ផ្លាស់ប្តូរ មតិ គ្នា ត្រឹមតែ កម្រិត នយោបាយ តែ ប៉ុណ្ណោះ នោះ ទេ ទំនាក់ទំនង រវាង ផ្នែក សេដ្ឋកិច្ច និង សង្គម . ទំនាក់ទំនង រវាង ប្រជាពលរដ្ឋ នៃ ប្រទេស យើង ទាំង ពីរ ក៏ ជា កត្តា សំខាន់ ផងដែរ ។
ពិធី លៀង សាយ ភោជន៍ នេះ បាន ប្រព្រឹត្តិ ទៅ ប្រកបដោយ មនោសញ្ចេតនា ស្និតស្នាល និង រាក់ទាក់ បំផុត ៕ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ ចូលរួម រំលែក មរណទុក្ខ ចំពោះ មរណភាព របស់ លោក ខូយ សុខា
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ រសៀល ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន ផ្ញើ សារលិខិត ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ចំពោះ មរណភាព របស់ លោក ខូយ សុខា តំណាងរាស្ត្រ មណ្ឌល ខេត្ត ពោធិ៍សាត់ ។
ក្នុង សារលិខិត ផ្ញើ ជូន លោកស្រី ឡុង ម៉ារី ភរិយា សព លោក ខូយ សុខា . សម្តេច តេជោ ហ៊ុន សែន បាន សម្តែង នូវ ការសោកស្តាយ ចំពោះ មរណភាព របស់ លោក ខូយ សុខា ព្រោះ ជា ការបាត់បង់ នូវ ឥស្សរជន មួយ រូប ដែល បាន តស៊ូ លះបង់ កម្លាំង កាយ ចិត្ត ធនធាន និង បញ្ញា ស្មារតី បម្រើ ប្រទេសជាតិ គ្រប់ កាលៈទេសៈ ។ ជាពិសេស បាន រួមចំណែក យ៉ាង សកម្ម ជាមួយ ស្ថាប័ន នីតិប្បញ្ញត្តិ ក្នុង គោលដៅ បម្រើ ឧត្តម ប្រយោជន៍ ជាតិ មាតុភូមិ នា ពេល កន្លងមក ។
សូម បញ្ជាក់ ថា លោក ខូយ សុខា តំណាងរាស្ត្រ មណ្ឌល ខេត្ត ពោធិ៍សាត់ បាន ទទួលមរណភាព កាលពី វេលា ម៉ោង ១២៖៣០ នាទី ថ្ងៃត្រង់ ថ្ងៃអង្គារ ទី ១៤ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ក្នុង ជន្មាយុ ៧១ ឆ្នាំ ដោយ រោគា ពាធ ៕ យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៥ ខែកុម្ភៈ៖ បង្ក្រាប ១៥ករណី ឃាត់ខ្លួន ៥០ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៥ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ដឹកជញ្ជូន រក្សាទុក ២ករណី និង ជួញដូរ ៨ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥០ នាក់ ។
អាថ៌កំបាំង ក្រោយ ឆាក មួយ ត្រូវបាន លាតត្រដាង នូវ ឧបាយកល មិន ចង់ឱ្យ មាន សន្តិភាព នៅ អ៊ុយក្រែន
( មូស្គូ) ៖ នៅសល់ តែ ៩ ថ្ងៃ ទៀត តែ ប៉ុណ្ណោះ ខួប មួយ ឆ្នាំ នៃ សង្គ្រាម ក្នុ្ងង ប្រទេស អ៊ុយក្រែន នឹង ឈាន មកដល់ ។ ដំណើរការចរចា ដើម្បី រក ការបញ្ចប់ សង្គ្រាម មិន បាន ទទួល ជោគជ័យ នោះ ឡើយ ។ សហរដ្ឋ អាមេរិក និង អង្គការ ណា តូ បាន ជួបប្រជុំគ្នា ២ ថ្ងៃ ក្នុង សប្តាហ៍ នេះ ដោយ ជំរុញ ការបញ្ជូន អាវុធ កាន់តែ ឆាប់រហ័ស ដល់ អ៊ុយក្រែន ក្នុង ការធ្វើ សង្គ្រាម ប្រឆាំង នឹង រុស្ស៊ី ។
ប្រទេស រុស្ស៊ី បាន ថ្លែង ថា បើសិន ណា ជា ប្រទេស លោក ខាងលិច ធ្វើឱ្យ រុស្ស៊ី ចាញ់ សង្គ្រាម ភាគ ខាងកើត អ៊ុយក្រែន នោះ មែន . រុស្ស៊ី នឹង ប្រើ អាវុធ នុយក្លេអ៊េ័រ របស់ ខ្លួន ជា មិន ខាន ។ លោក វ្ល៉ាឌីមៀ ពូទីន បាន ថ្លែង ថា អ្នក ដែល ចង់ ចាប់ គំរាម រុស្ស៊ី ឱ្យ ប្រើ អាវុធ នុយក្លេអ៊េរ គប្បី ត្រូវ យល់ ថា ខ្យល់ នឹង បក់ ទៅ លើ ទិសដៅ របស់ ពួកគេ នោះ ៕
គួរ បញ្ជាក់ ថា ការធ្វើ ត្រួតពិនិត្យ សុខភាព របស់ លោក ចូ បៃ ដិន ត្រូវបាន ធ្វើឡើង លើក ចុងក្រោយ បំផុត កាលពី ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ជា ពេល ដែល លោក បាន ឆ្លងកាត់ ការត្រួតពិនិត្យ សុខភាព ពេញលេញ ក្នុង នោះ រួម មាន ទាំង ការត្រួតពិនិត្យ ផ្នែក ខាងក្នុង ពោះវៀន ក្រោម ការប្រើ ថ្នាំ សន្លប់ ផងដែរ ៕
គួរ បញ្ជាក់ ថា ខាង រុស្ស៉ី មិន ទាន់ បាន ធ្វើ អត្ថាធិប្បាយ អ្វី នៅឡើយ ទេ ឆ្លើយតប ទៅនឹង ការអះអាង របស់ អ៊ុយក្រែន ហើយ ឧប្បត្តិហេតុ បាឡុង នេះ បាន កើតឡើង បន្ទាប់ពី អាមេរិក បាន បាញ់ ទម្លាក់ បាឡុង មួយ របស់ ចិន កាលពី ពេល ថ្មី ៗ នេះ និង ចាប់ពី ពេលនេះ មក ដែរ ប្រទេស មួយចំនួន បាន រាយការណ៍ ជា បន្តបន្ទាប់ពី ការប្រទះឃើញ បាឡុង នៅក្នុង ដែន អាកាស របស់ ពួកគេ ៕
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី១៦ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បេក្ខភាព នាយក រដ្ឋមន្ត្រី បន្ត វេន ដ៏ មាន ប្រជាប្រិយភាព មកពី គណបក្ស ប្រជាជន កម្ពុជា បាន បង្ហោះ វីដេអូ ឃ្លីប ថ្មី មួយ រំលឹក ពី រឿង ទូត អាមេរិក ធ្លាប់ បាន សួរ លោក ពី កេរ ដំណែល របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី ។
ឆ្លើយតប នឹង សំណួរ នេះ លោក បណ្ឌិត បាន ចង្អុលបង្ហាញ អំពី ទិដ្ឋភាព នៃ ការអភិវឌ្ឍន៍ និង ការរីកចម្រើន នៅ តំបន់ កោះ ពេជ្រ និង តំបន់ ជុំវិញ ដែល បាន មើលឃើញ ពី អគារ កម្ពស់ ១០ជាន់ ដែល ទាំង លោក ទូត និង រូបលោក បណ្ឌិត កំពុង ជជែកគ្នា នោះ ។
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ប្រាប់ ទៅ លោក ទូត អាមេរិក ថា តំបន់ កោះ ពេជ្រ និង តំបន់ ជុំវិញ នោះ ពីមុន មិន មាន ការអភិវឌ្ឍន៍ អ្វី នោះ ទេ ។ ប៉ុន្តែ បច្ចុប្បន្ន មាន ការអភិវឌ្ឍន៍ មាន អគារ ទំនើប មាន ផ្សារទំនើប របស់ ជប៉ុន ជាដើម ។ ការអភិវឌ្ឍន៍ ទាំងនេះ បាន ផ្តល់ ការងារ ជូន ប្រជាពលរដ្ឋ ខ្មែរ ។
« ហ្នឹង ហើយ ជា កេរ ដំណែល របស់ សម្តេច តេជោ គឺ សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ ។ សុខ សន្តិភាព សេចក្តីសុខ ការវិនិយោគ ការរីកចម្រើន របស់ ប្រជាពលរដ្ឋ ហ្នឹង ហើយ ជា កេរ ដំណែល របស់ គាត់ » ។ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បញ្ជាក់ ទៅកាន់ ទូត អាមេរិក ។
ជាមួយ ការរំលឹក អំពី ការពន្យល់ នូវ កេរ ដំណែល របស់ សម្តេច តេជោ ទៅកាន់ ទូត អាមេរិក ហើយ នោះ ក្នុង វីដេអូ នេះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ក៏ បាន លើកឡើង ផងដែរ ថា កេរ ដំណែល របស់ តេជោ មិន បំផ្លាញ ចោល ទេ ។
លោក បាន លើកឡើង ទៀត ថា ៤៣ ឆ្នាំ ពី បាត ដៃ ទទេ ឆ្ពោះ មក ការរីកចម្រើន ដូច ពេល បច្ចុប្បន្ន នេះ សម្តេច តេជោ មិន បំផ្លាញ ចោល នូវ សមិទ្ធផល ស្នាដៃ របស់ ខ្លួន នោះ ទេ ។
លោក ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា សមិទ្ធផល ទាំងនេះ សម្តេច តេជោ រួម ជាមួយ ថ្នាក់ដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា គ្រប់ ជាន់ ថ្នាក់ បាន លះបង់ កម្លាំង កាយ ចិត្ត បំពេញ ភារកិច្ច ជួយ កសាង ទម្រាំ បាន ប៉ុណ្ណេះ គឺ មិន បំផ្លាញ ចោល ទេ ។ ជាពិសេស គឺ សន្តិភាព តែម្តង ៕ លោកស្រី ម៉ែន សំអន៖ បងប្អូន នារី បាន បង្ហាញ អំពី ការសប្បាយ ចិត្ត និង សូម គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សម្តេច តេជោ ដែល បាន គិតគូរ ដល់ ពួកគាត់
( ភ្នំពេញ ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង មួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋា រដ្ឋាភិបាល ចុះ មូលដ្ឋាន រាជធានី ភ្នំពេញ បាន ជួប សំណេះសំណាល ជាមួយ មេ ការ និង អ្នកគ្រប់គ្រង នៅ តាម សេវា កម្សាន្ត ចំនួន ៥ខណ្ឌ សរុប ចំនួន ៥៩៨ នាក់ ដែល រួម មាន ខណ្ឌ ដូនពេញ ខណ្ឌ ចំការមន ខណ្ឌ បឹងកេងកង ខណ្ឌ ៧មករា និង ខណ្ឌ ទួលគោក នៅ មជ្ឈមណ្ឌល ពិព៏ណ៌ កោះ ពេជ្រ នា រសៀល ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
ថ្លែង ក្នុង អង្គ ពិធី នោះ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន ផ្តាំផ្ញើ ជូន ដល់ អង្គ ពិធី នូវ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច ទាំង ទ្វេ រ នូវ ការ នឹករលឹក និង ការគិតគូរ អំពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ នៅ គ្រប់ ទីកន្លែង ។
ចំពោះ បងប្អូន នារី បាន បង្ហាញ អំពី ការសប្បាយ ចិត្ត និង សូម គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សម្តេច តេជោ ដែល បាន គិតគូរ ដល់ ពួកគាត់ ។
ក្នុង ឱកាស នោះ ផងដែរ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន នាំយក ថវិកា របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តាមរយៈ លោក ឃួង ស្រេង ជូន ដល់ បុគ្គលិក បម្រើ ការងារ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ចំនួន ៥៩៨ នាក់ ក្នុង ម្នាក់ ទទួលបាន ថវិកា ១០ម៉ឺន រៀល ៕
