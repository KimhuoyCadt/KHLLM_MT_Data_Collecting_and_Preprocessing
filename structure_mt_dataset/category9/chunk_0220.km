( ភ្នំពេញ ) ៖ លោក ឌិត ទីណា រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល បាន ប្រមាថ ជាថ្មី ដល់ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជារាស្ត្រ ខ្មែរ ទូទាំង ប្រទេស ។
( ភ្នំពេញ ) ៖ លោក លឹម ជា វុត្ថា អគ្គ នាយក បណ្តាញ ព័ត៌មាន Fresh News និង ថ្នាក់ដឹកនាំ ព្រមទាំង បុគ្គលិក ទាំងអស់ នៅ ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល បាន ប្រមាថ ជាថ្មី ដល់ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជារាស្ត្រ ខ្មែរ ទូទាំង ប្រទេស ។
លោក ស្វាយ ស៊ី ថា រដ្ឋមន្រ្តី ប្រតិភូ អម និង ជា ប្រធាន អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស ប្រកាស ថ្កោល ទោស ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល ប្រមាថ ម្តង ហើយ ម្តង ទៀត ដល់ អង្គ ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ លោក ស្វាយ ស៊ី ថា រដ្ឋមន្រ្តី ប្រតិភូ អម និង ជា ប្រធាន អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៅ ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន ថ្កោលទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល បាន ប្រមាថ ជាថ្មី ដល់ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជារាស្ត្រ ខ្មែរ ទូទាំង ប្រទេស ។
ថ្លែង ក្នុង ពិធី បើក ការដ្ឋាន ដាក់ ទុយោ ទំហំ ២០០០ មីលីម៉ែត្រ នេះ កិត្តិ សេដ្ឋ បណ្ឌិត ចម ប្រសិទ្ធ ទេសរដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្រ្ត បច្ចេកវិទ្យា និង ន វានុវត្តន៍ មានប្រសាសន៍ ថា នេះ ប្រវត្តិសាស្រ្ត មួយ សម្រាប់ ប្រទេស កម្ពុជា ដែល បាន ដាក់ នូវ បំពង់ មេ ដែល មាន ទំហំ ធំ បែប នេះ ព្រោះ នៅលើ ពិភពលោក មាន ប្រទេស តិច ណាស់ ដែល មាន ទុយោ ទំហំ រហូតដល់ ២០០០ មីលីម៉ែត្រ ដាក់ ចុះ ក្រោម ទឹក ។
នា ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ដែរ កិត្តិ សេដ្ឋ បណ្ឌិត ចម ប្រសិទ្ធ រួម នឹង គណៈប្រតិភូ មកពី ប្រទេស បារាំង ដែល រួម មាន សមាជិក សភា នៃ ប្រទេស បារាំង ប្រធាន សក្រុមប្រឹក្សាភិបាល នៃ ទីភ្នាក់ងារ អភិវឌ្ឍន៍ បារាំង (AFD) សហភាព អឺរ៉ុប និង តំណាង ធនាគារ វិនិយោគ អឺរ៉ុប បាន ចុៈទស្សនកិច្ចការដ្ឋាន សាងសង់ រោងចក្រ ផលិត ទឹក ស្អាត បាក់ ខែង ផងដែរ ដើម្បី ពិនិត្យមើល ពី ដំណើរការការ សាងសង់ មុននឹង រោងចក្រ ផលិត ទឹក ស្អាត បាក់ ខែង ដាក់ ឱ្យ ដំណើរការ ។
លោក ឡុង ណារ៉ូ បាន លើកឡើង ថា នេះ ជា លើក ទី១ ហើយ ដែល គណៈប្រតិភូ រួម មាន មន្រ្តី ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល និង សមាជិក សភា បារាំង រួម នឹង ដៃគូ អភិវឌ្ឍន៍ បាន ចុះ មក ទស្សនកិច្ច រោងចក្រ ប្រព្រឹត្តិកម្ម ទឹក ស្អាត បាក់ ខែង នេះ ។ ការចុះ ទស្សនកិច្ច របស់ មន្រ្តី ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល កម្ពុជា គណៈប្រតិភូ បារាំង នេះ ស្រប ដែល ព្រឹទ្ធសភា កម្ពុជា បាន អនុម័ត ច្បាប់ ស្តីពី ការគ្រប់គ្រង ទឹក ស្អាត ។
សូម ជម្រាប ថា គម្រោង រោងចក្រ ប្រព្រឹត្តិកម្ម ទឹក ស្អាត បាក់ ខែង ជំហ៊ាន ទី១ មាន សមត្ថភាព ផលិត ទឹក ស្អាត បាន មួយ ថ្ងៃ ១៩៥០០០ ម៉ែត្រ គូប ដោយ សម្រេច ការសាងសង់ បាន ៨៩% នៃ ទំហំ ការងារ ទាំងមូល ។
ក្រុម មេធាវី រាជ រដ្ឋាភិបាល ថ្កោល ទោស ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល ប្រមាថ ម្តង ហើយ ម្តង ទៀត ដល់ អង្គ ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ លោក គី តិច ប្រធាន ក្រុម មេធាវី រាជ រដ្ឋាភិបាល និង សមាជិក សមាជិការ ទាំងអស់ នៅ ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន ថ្កោលទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល បាន ប្រមាថ ជាថ្មី ដល់ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជារាស្ត្រ ខ្មែរ ទូទាំង ប្រទេស ។
យើងខ្ញុំ ទាំងអស់ គ្នា សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ យុទ្ធនាការ ដែល ប្រកាស ដោយ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ក្នុង ការកម្ចាត់ ចោល នយោបាយ ជ្រុល និយម របស់ ជន ក្បត់ ជាតិ បី ជំនាន់ ឲ្យ អស់ ពី កម្ពុជា ដើម្បី រក្សា សន្តិភាព ស្ថិរភាព សង្គម និង សេចក្តីសុខសាន្ត របស់ ប្រជាពលរដ្ឋ ខ្មែរ ៕ ក្រុមប្រឹក្សា ធម្មនុញ្ញ ប្រកាស ជ្រើសរើស មន្ត្រី ១៤ រូប ចូល បម្រើ ការងារ នៅ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ
( ភ្នំពេញ ) ៖ ក្រុមប្រឹក្សា ធម្មនុញ្ញ ប្រកាស ជ្រើសរើស មន្ត្រីរាជការ ចំនួន ១៤ រូប ចូល បម្រើ ការងារ នៅ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ សម្រាប់ ឆ្នាំ ២០២៣ ។
យោង គេហទំព័រ និង បណ្តាញ សង្គម របស់ អគ្គ លេខាធិការដ្ឋាន នៃ ក្រុមប្រឹក្សា ធម្មនុញ្ញ បាន ឱ្យដឹង ថា មន្ត្រីរាជការ ដែល ត្រូវ ជ្រើសរើស នេះ មាន មុខជំនាញ នីតិសាស្ត្រ ចំនួន ១២រូប និង ភាសា អង់គ្លេស ចំនួន ២នាក់ ។
បេក្ខជន ដែល មាន បំណង ដាក់ពាក្យ ប្រលង ចូល ក្របខណ្ឌ មន្ត្រីរាជការ នៅ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ បំពេញ លិខិត និង ដាក់ពាក្យ សុំ ចុះឈ្មោះ ប្រលង នៅ នាយកដ្ឋាន បុគ្គលិក ផែនការ និង អភិវឌ្ឍន៍ ធនធាន មនុស្ស នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ដែល មាន អាសយដ្ឋាន នៅ អគារ « ស» វិមាន រដ្ឋ ចំការមន មហាវិថី ព្រះនរោត្តម សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ចាប់ពី ថ្ងៃទី ១៧ ខែកុម្ភៈ ដល់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣ ៕
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នឹង អញ្ជើញ បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ប្រទេស ថៃ នៅ ថ្ងៃទី ២៣ - ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២៣ តប តាម ការអញ្ជើញ របស់ លោក ដន ប្រាម៉ាត់ វីណៃ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ការបរទេស ថៃ ។
តាម ការប្រកាស របស់ ក្រសួង ការបរទេស បាន ឱ្យដឹង ថា ឧប នាយក រដ្ឋមន្រ្តី ទាំង ពីរ នឹង មាន ជំនួប ទ្វេ ភាគី ដើម្បី ពិភាក្សា អំពី ទំនាក់ទំនង ទ្វេ ភាគី ដ៏ ល្អ ប្រសើរ និង កិច្ចសហប្រតិបត្តិការ កំពុង លូតលាស់ លើ គ្រប់ វិស័យ ដូចជា វិស័យ ពាណិជ្ជកម្ម វិនិយោគ ទេសចរណ៍ ការងារ ការតភ្ជាប់ អប់រំ សុខាភិបាល និង វប្បធម៌ ។ល ។ កិច្ចសហប្រតិបត្តិការ ក្នុង ក្របខ័ណ្ឌ អាស៊ាន ព្រមទាំង បញ្ហា តំបន់ និង អន្តរជាតិ ដែល ជា ផលប្រយោជន៍ និង ក្តីបារម្ភ រួម ក៏ នឹង ត្រូវ លើក យកមក ពិភាក្សា ផងដែរ ។
ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន ក៏ នឹង អញ្ជើញ ចូល ជួប សម្តែង ការគួរសម ជាមួយ នាយ ឧត្តមសេនីយ៍ ប្រាយុទ្ធ ច័ន្ទ អូឆា នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ ថៃ ផងដែរ ។
ក្រសួង ការបរទេស បាន កត់សម្គាល់ ថា មិត្តភាព ជា ប្រពៃណី ភាពជា អ្នកជិតខាង ល្អ និង កិច្ចសហប្រតិបត្តិការ ជិតស្និទ្ធ លើ គ្រប់ វិស័យ រវាង ប្រទេស ទាំង ពីរ ត្រូវបាន ពង្រឹង និង ពង្រីក ឥត ឈប់ឈរ និង បាន ឈានឡើង ដល់ កម្រិត « ភាពជាដៃគូ ដើម្បី សន្តិភាព និង វិបុលភាព »៕
គួរ បញ្ជាក់ ថា ចិន និង រុស្ស៉ី តែងតែ ជំទាស់ ទៅនឹង ការចំណាត់ការ របស់ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ដោយ អះអាង ថា ការដាក់ សម្ពាធ ឬ ទណ្ឌកម្ម បន្ថែម លើ កូរ៉េ ខាងជើង មិន មែន ជា ដំណោះស្រាយ ល្អ នោះ ទេ ហើយ ជារឿយ ៗ ប្រទេស ទាំង២ ក៏ តែងតែ បោះឆ្នោត វេតូ ដើម្បី ការពារ កូរ៉េ ខាងជើង ពី ការថ្កោលទោស និង ទណ្ឌកម្ម UN ផងដែរ ៕
មជ្ឈមណ្ឌល ឯកសារ ខេត្ត តាកែវ បន្ត ធ្វើ វេទិកា អប់រំ សហគមន៍ នៅ វត្ត ខ្នារក កោះ
( តាកែវ )៖ វេទិកា អប់រំ សហគមន៍ ស្តីពី ការចងចាំ ប្រវត្តិសាស្ត្រ ខ្មែរ ក្រហម ដែល ជា ការរៀបចំ ដោយ មជ្ឈមណ្ឌល ឯកសារ ខេត្ត តាកែវ ក្រោម កិច្ចសហការ ពី អាជ្ញាធរ មូលដ្ឋាន ឃុំ ដូង ខ្ពស់ និង គណៈកម្មការ វត្ត ខ្នារក កោះ ត្រូវបាន ប្រារព្ធ ធ្វើ នៅក្នុង បរិវេណ វត្ត ខ្នារក កោះ ភូមិ តា សៃ ឃុំ ដូង ខ្ពស់ ស្រុក បូរី ជលសារ ខេត្ត តាកែវ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
ដោយ មាន ការចូលរួម ពី ព្រះសង្ឃ អាចារ្យ គណៈកម្មការ វត្ត និង អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ១៦នាក់ ព្រមទាំង សិស្សានុសិស្ស មកពី វិទ្យាល័យ សុខ អាន ដូង ខ្ពស់ ចំនួន ២០ នាក់ ។ គោលបំណង នៃ ការប្រារព្ធ ធ្វើ វេទិកា អប់រំ នេះ គឺ ដើម្បី បង្កើត ឲ្យ មាន ការពិភាក្សា អន្តរ ជំនាន់ ស្តីពី ប្រវត្តិសាស្ត្រ ខ្មែរ ក្រហម និង ការទប់ស្កាត់ អំពើហិង្សា នៅ កម្រិត បុគ្គល និង សហគមន៍ ។ វេទិកា នេះ ក៏ បាន ពិភាក្សា ដែរ ពី បញ្ហា ប្រឈម ដែល កំពុងតែ កើតមាន នៅក្នុង សហគមន៍ នា ពេល បច្ចុប្បន្ន ។
ការជ្រើសរើស ទីតាំង សម្រាប់ ធ្វើ វេទិកា នៅ វត្ត ខ្នារក កោះ គឺ ដោយសារ វត្ត នេះ មាន ប្រវត្តិ ធ្លាប់ ជា មន្ទីរពេទ្យ ខ្មែរ ក្រហម ក្នុង អំឡុង ដើម ទសវត្ស ឆ្នាំ ១៩៧០ ហើយ ព្រះវិហារ ចាស់ ទ្រុឌទ្រោម ធ្លាប់ ជា កន្លែង ដាក់ អំបិល ក្នុង របប ខ្មែរ ក្រហម ។
លោក ទេស ណា វី ជា ក្រុមប្រឹក្សា ឃុំ ដូង ខ្ពស់ បាន ប្រាប់ ពី មូលហេតុ នៃ ការប្រារព្ធ ធ្វើ វេទិកា នៅ ពេល នេះ ថា ជា ការបង្កើត កិច្ចពិភាក្សា ពី ប្រវត្តិសាស្ត្រ ខ្មែរ ក្រហម និង បាន លើកទឹកចិត្ត អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ឲ្យ ចែករំលែក រឿងរ៉ាវ ជីវិត របស់ ខ្លួន ប្រាប់ ដល់ ក្មេង ៗ ជំនាន់ ក្រោយ ដើម្បី ការចងចាំ ព្រមទាំង បាន លើកទឹកចិត្ត ដល់ ក្រុម យុវជន ទាំងអស់ ឲ្យ យកចិត្តទុកដាក់ ស្តាប់ និង កត់ត្រា ពី ព្រឹត្តិការណ៍ សំខាន់ ៗ ដែល បាន កើតមាន លើ ជីវិត ផ្ទាល់ខ្លួន របស់ អ្នក រស់រាន មាន ជីវិត ម្នាក់ ៗ ។
ព្រះតេជគុណ អនុគណស្រុក បូរី ជលសារ ព្រះនាម សយ វុទ្ធី បាន ផ្តាំផ្ញើ បន្ថែម ដល់ យុវជន ទាំងអស់ ឲ្យ ត្រង់ត្រាប់ ស្តាប់ ការពន្យល់ និង ការចែករំលែក បទពិសោធន៍ ឆ្លងកាត់ របប ខ្មែរ ក្រហម ពីសំណាក់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ។
លោក ផេង ពង្ស រ៉ាស៊ី បាន ដាស់តឿន ម្តង ទៀត ដល់ ក្រុម យុវជន ជំនាន់ ទាំងអស់ អំពី វិធីសាស្ត្រ ដ៏ មាន សារសំខាន់ ខ្លះ ៗ ក្នុង ការទប់ស្កាត់ អំពើហិង្សា នានា ដែល អាចនឹង ឈានដល់ ការកកើត អំពើ ប្រល័យ ពូជសាសន៍ នៅពេល អនាគត ។ លោក ផេង ពង្ស រ៉ាស៊ី បាន បង្ហាញ ពី គន្លឹះ ខ្លះ ៗ ដែល យុវជន អាច ចូលរួម ទប់ស្កាត់ អំពើហិង្សា ក្នុង កម្រិត បុគ្គល បាន ដែល ការទប់ស្កាត់ នេះ គឺជា ឫសគល់ នៃ ការចូលរួម កសាង និង អភិវឌ្ឍ ប្រទេសជាតិ ដោយ គ្មាន សង្គ្រាម ។
ចំណែក ក្មេង ៗ ជំនាន់ ក្រោយ ដែល ជា សិស្សានុសិស្ស វិញ ក៏ បាន បង្ហាញ ពី ចំណាប់អារម្មណ៍ ខ្ពស់ ក្នុង ការ ត្រងត្រាប់ ស្តាប់ រឿងរ៉ាវ របស់ អ្នក រស់រាន មាន ជីវិត ទាំងអស់ ដែល បាន លើកឡើង ។ តំណាង សិស្សានុសិស្ស ចំនួន ពីរ នាក់ ដែល បាន លើកឡើង ពី ចំណាប់អារម្មណ៍ របស់ ខ្លួន បាន បង្ហាញ ថា ខ្លួន និង អ្នកឯទៀត មាន អារម្មណ៍ អាណិតអាសូរ ចំពោះ អ្នក រស់រាន មាន ជីវិត និង ខិតខំ រៀនសូត្រ បន្ថែម ទៀត ដើម្បី ចូលរួម ទប់ស្កាត់ អំពើហិង្សា ។
លោក អិន ឈឿន អនុប្រធាន ភូមិ រទេះ ភ្លូក បាន ផ្តល់ អនុសាសន៍ ទៅកាន់ សិស្សានុសិស្ស ទាំងអស់ ឲ្យ យកចិត្តទុកដាក់ រៀនសូត្រ បន្ថែម ទៀត ជាពិសេស រៀនសូត្រ ឲ្យបាន ស៊ីជម្រៅ ពី ប្រវត្តិសាស្ត្រ ដ៏ ជូរចត់ ដែល បាន កើតមាន ចំពោះ ជីដូន ជីតា របស់ ខ្លួន ។ មាន តែ ការរៀនសូត្រ ទេ ទើប អាច បំបាត់ អំពើហិង្សា និង ការកាប់ សម្លាប់ គ្នា បាន ។ ដូច្នេះ ក្មួយ ៗ ត្រូវតែ ខិតខំ រៀនសូត្រ និង ស្វែងយល់ ឲ្យ ស៊ីជម្រៅ លើ ប្រវត្តិសាស្ត្រ របស់ យើង ជាពិសេស រឿងរ៉ាវ ដែល បាន កើតឡើង លើ គ្រួសារ របស់ ក្មួយ ៗ ផ្ទាល់ ។
លោក ប៉ាញ់ ប៉ាល់ រស់ នៅ ភូមិ តា សៃ ឃុំ ដូង ខ្ពស់ ស្រុក បូរី ជលសារ បាន រៀបរាប់ ថា ក្រោយ រដ្ឋប្រហារ ឆ្នាំ ១៩៧០ ពោលគឺ ក្នុង ឆ្នាំ ១៩៧១ និង ១៩៧២ ព្រះសង្ឃ ដែល គង់ នៅក្នុង វត្ត នេះ ត្រូវបាន ជម្លៀស ចេញ ពី វត្ត ទាំងអស់ មិន ដឹង ជម្លៀស ទៅកាន់ កន្លែងណា ខ្លះ ទេ ។ ខ្ញុំ ក៏ នៅ មិន បាន ជាប់ លាប់ ដែរ ប៉ុន្តែ គ្រាន់តែ ដឹង ថា បរិវេណ វត្ត នេះ ត្រូវបាន ប្រើប្រាស់ ជា មន្ទីរពេទ្យ របស់ ខ្មែរ រំដោះ មាន ឈ្មោះ ថា មន្ទីរពេទ្យ ស្រុក ១០៨ ។
សិស្ស សួន ដេត ភេទ ប្រុស អាយុ ១៧ ឆ្នាំ បាន និយាយ ថា « ខ្ញុំ មាន ចំណាប់អារម្មណ៍ ខ្លាំង ណាស់ នៅ ពេល ដែល បាន ស្តាប់ ការលើកឡើង របស់ លោក តា ៗ ពី ប្រវត្តិ ឆ្លងកាត់ របប ខ្មែរ ក្រហម ។ ខ្ញុំ ជឿជាក់ មួយ រយ ភាគរយ ថា ពិតជា មាន របប ខ្មែរ ក្រហម កើតឡើង មែន ។ ខ្ញុំ មានអារម្មណ៍ អាណិតអាសូរ ចំពោះ លោក តា លោកយាយ ដែល មាន បទពិសោធន៍ កំសត់ ជូរ ចត់ ឆ្លងកាត់ របប ខ្មែរ ក្រហម ។ ខ្ញុំ នឹង ខិតខំ រៀនសូត្រ ដើម្បី ជួយ អភិវឌ្ឍ សង្គមជាតិ យើង » ។
សិស្ស ជួង លី អ៊ី ភេទ ស្រី អាយុ ១៨ ឆ្នាំ បាន និយាយ ថា « ខ្ញុំ ពិតជា មានអារម្មណ៍ សង្វេគ ពេល ដែល ខ្ញុំ បាន ឮ ពី ប្រវត្តិសាស្ត្រ ខ្មែរ នា សម័យ មុន ដែល ឆ្លុះបញ្ចាំង ពី ទិដ្ឋភាព យ៉ាង ជូរ ចត់ របស់ ប្រជាជន កម្ពុជា ។ ក្នុង នាម នាងខ្ញុំ ជា សិស្ស មួយ រូប ដែល កំពុង សិក្សា នៅ ថ្នាក់ ទី ១២ ខ្ញុំ ប្តេជ្ញាចិត្ត ខិតខំ សិក្សា ដើម្បីឲ្យ មាន អនាគត ល្អ និង ជួយ ឲ្យ ប្រទេសជាតិ មាន ភាពរីកចម្រើន តទៅ មុខ ។ ខ្ញុំ មិន ធ្វើឲ្យ ប្រទេសជាតិ ធ្លាក់ចុះ និង ឱន ថយ ដូច សម័យ មុន ឡើយ » ។
កុំ ឲ្យ ថ្ងៃ សប្បាយ ក្លាយជា ទុក្ខ ដោយសារ ការបើកបរ របស់ អ្នក ! ស្លាប់ ៧នាក់ និង របួស ៨នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែកុម្ភៈ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ និង របួស ធ្ងន់ ស្រាល ៨នាក់ ។
រដ្ឋមន្ត្រី ថោង ខុន ជំរុញ ឱ្យ បង្កើន ការលក់ កញ្ចប់ ទស្សនកិច្ច ទៅកាន់ សហគមន៍ អេកូ ទេសចរណ៍
( ភ្នំពេញ ) ៖ ដើម្បី រួមចំណែក ដល់ ការអភិវឌ្ឍ វិស័យ អេកូ ទេសចរណ៍ និង ទេសចរណ៍ សហគមន៍ ប្រកបដោយ ប្រសិទ្ធភាព និង ស័ក្តិសិទ្ធិភាព លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន ជំរុញ ឱ្យ ការី ទេសចរណ៍ បង្កើន ការលក់ កញ្ចប់ ទស្សនកិច្ច ទៅកាន់ សហគមន៍ អេកូ ទេសចរណ៍ អាស៊ាន និង សហគមន៍ នានា នៅ កម្ពុជា ជូន ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ឱ្យ បាន កាន់តែ ច្រើន ។
គួរ ជម្រាប ថា សហគមន៍ អេកូ ទេសចរណ៍ ចំនួន ២នៅ កម្ពុជា បាន ទទួល ពានរង្វាន់ ស្ដង់ដា សហគមន៍ អេកូ ទេសចរណ៍ អាស៊ាន ក្នុង នោះ រួម មាន សហគមន៍ អេកូ ទេសចរណ៍ សម្រស់ កោះ ហាន នៅ ខេត្ត ស្ទឹងត្រែង និង សហគមន៍ អេកូ ទេសចរណ៍ ព្រៃ ធំ អន្លង់ ធំ នៅ ខេត្ត សៀមរាប ។
លោក ជុក ជំនោរ បាន បន្ត ថា តាម ការវាយតម្លៃ របស់ អាស៊ាន សហគមន៍ អេកូ ទេសចរណ៍ ទាំង២ នេះ គឺ បាន ខិតខំ អភិវឌ្ឍ ធនធាន មនុស្ស ក្នុង សហគមន៍ ក សាង ហេដ្ឋារចនាសម្ពន្ធ នៅ មូលដ្ឋាន បង្កើន ផលិតផល ទេសចរណ៍ ថ្មី ៗ កែលម្អ ផលិតផល ទេសចរណ៍ ដែល មាន ស្រាប់ ព្រមទាំង ទទួលបាន ការពេញនិយម ច្រើន ពីសំណាក់ ភ្ញៀវ ទេសចរ ។
នា ឱកាស នោះ លោក រដ្ឋមន្ត្រី ថោង ខុន បាន ចូលរួម អបអរសាទរ ចំពោះ សហគមន៍ អេកូ ទេសចរណ៍ ទាំង២ របស់ កម្ពុជា ដែល ទទួលបាន ពានរង្វាន់ ស្ដង់ដា សហគមន៍ អេកូ ទេសចរណ៍ អាស៊ាន នេះ ។
លោក ក៏ បាន ស្នើ ឱ្យ ស្ថាប័ន ដៃគូ អភិវឌ្ឍ អង្គការ ជាតិ និង អន្តរជាតិ នានា បន្ត ផ្តល់ ការគាំទ្រ ដល់ ការអភិវឌ្ឍ តំបន់ សហគមន៍ ទាំង៥ នេះ ទាំង លើ ផ្នែក បច្ចេកទេស និង ហិរញ្ញវត្ថុ ។ មិន តែ ប៉ុណ្ណោះ សូម ជួយ ផ្តល់ ការគាំទ្រ ផ្នែក បច្ចេកទេស និង ហិរញ្ញវត្ថុ នានា ដល់ ក្រសួង ទេសចរណ៍ និង គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង និង អភិវឌ្ឍ សហគមន៍ ទេសចរណ៍ និង អេកូ ទេសចរណ៍ លើ ការអនុវត្ត គម្រោង នានា ពាក់ព័ន្ធ នឹង អេកូ ទេសចរណ៍ និង សហគមន៍ ។
Facebook ឈ្មោះ ដដែល នោះ បាន រៀបរាប់ ថា៖ ក្នុង ទិសដៅ ប្រើប្រាស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ ដើម្បី គាំទ្រ លើ ការផ្លាស់ប្តូរ រដ្ឋាភិបាល នៅ កម្ពុជា នេះ ហើយ បានជា រយៈពេល ២០ ឆ្នាំ មក នេះ វិទ្យុ វីអូឌី ដែល បង្កើតឡើង តាំងពី អំឡុង ឆ្នាំ ២០០៣ ដោយ ជ្រក ក្រោម មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា ដឹកនាំ ដោយ កឹម សុខា រហូតមកដល់ មុនពេល បិទ នៅ ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២៣ របស់ ប៉ា ងួន ទៀង បាន ទទួល ជំនួយ ថវិកា ជាច្រើន លាន ដុល្លារ ដើម្បី បំពេញ បេសកកម្ម របស់ ខ្លួន ។
លោក កឹម សុខា បាន និយាយ ហើយ ថា ដើម្បី ផ្តួលរំលំ រដ្ឋាភិបាល ដូច នៅ ប្រទេស យូហ្គោស្លាវី គឺ ត្រូវ ជីក គាស់ ពីក្រោម ។ ដូច្នេះ វិទ្យុ វីអូឌី នេះ គឺជា មធ្យោបាយ ការងារ សតិអារម្មណ៍ មួយ ដើម្បី បរទេស បាន រៀបចំឡើង និង បាន ផ្តល់ ការគាំទ្រ ថវិកា ។
ក្នុង ឱកាស នោះ សម្ដេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស និង សម្តេច ព្រះមហា សុមេធាធិបតី នន្ទ ង៉ែត បាន មាន ព្រះពុទ្ធ ដិការ ថ្លែងអំណរគុណ និង កោតសរសើរ ចំពោះ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បន្ដ យកចិត្ដទុកដាក់ គ្រប់ ពេលវេលា ។
សម្ដេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស និង សម្តេច ព្រះមហា សុមេធាធិបតី នន្ទ ង៉ែត បាន ជូន ពរ សព្ទ សាធុការ ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម ជួបប្រទះ តែ នឹង ព្រះពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ លោក គាត ហ៊ុល ប្រធាន គណបក្ស ក្រុង ប៉ោយប៉ែត បាន ដឹកនាំ ក្រុមការងារ គណបក្ស ក្រុង សង្កាត់ និង និមន្ត ចូលរួម ដោយ ព្រះតេជគុណ ព្រហ្ម មោលីណយ នេត ចៅអធិការ វត្ត រតនៈ សុខសាន្ត និង ជា អនុប្រធាន កិត្តិយស សមាគម សម្ព័ន្ធ ប្រជាជន ដើម្បី សន្តិភាព ខេត្ត បន្ទាយមានជ័យ នាំយក អំណោយ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ចែកជូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ចំនួន ១០០ គ្រួសារ រស់ នៅក្នុង ភូមិ សុខសាន្ត សង្កាត់ និមិត្ត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង ឱកាស នោះ ដែរ មន្ត្រី គណបក្ស ប្រជាជន កម្ពុជា បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា និង បោះឆ្នោត ជូន គណបក្ស ប្រជាកម្ពុជា ដើម្បី សន្តិភាព និង ការអភិវឌ្ឍ បន្ថែម ទៀត ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ១៖ កូរ៉េ ខាងជើង បាញ់ សាកល្បង មីស៊ីល បាលិស្ទី គរយៈ ចម្ងាយ ខ្លី ២គ្រាប់ ធ្លាក់ ចូល សមុទ្រ
២៖ លោក ចូ បៃ ដិន នឹង ពិភាក្សា ពី ការបង្កើន វត្តមាន កងទ័ព អាមេរិក ក្នុង ដំណើរទស្សនកិច្ច នៅ ប៉ូឡូញ
៣៖ គ្រោះ ទឹក ជំនន់ និង បំណាក់ ដី បង្កឡើង ដោយ ភ្លៀង ធ្លាក់ ខ្លាំង ផ្តាច់ ជីវិត មនុស្ស យ៉ាងហោច ៣៦ នាក់ នៅ ប្រេស៉ី ល
៤៖ អ៉ីរ៉ង់ បដិសេធ ការចម្រាញ់ សារធាតុ អ៊ុយញ៉ូម រហូតដល់ ៨៤ % ដែល លើកឡើង ដោយ IAEA និង ប្រព័ន្ធ ផ្សព្វផ្សាយ លោក ខាងលិច
៥៖ លោក វ៉ាង យី ទៅដល់ ទីក្រុង មូស្គូ សម្រាប់ កិច្ចពិភាក្សា ស្តីពី អ៊ុយក្រែន . នេះ បើ តាម កាសែត ក្នុង ស្រុក រុស្ស៉ី
( ភ្នំពេញ ) ៖ ភាគី កូរ៉េសន្យា ថា នឹង បង្កើន កូតា ពលករ កម្ពុជា ឱ្យ បាន លើស មួយ ម៉ឺន នាក់ ក្នុង ឆ្នាំ ២០២៣ និង កាន់តែ ច្រើន នៅ ឆ្នាំ បន្តបន្ទាប់ ទៅ មុខ ទៀត ខណៈពេល ក្នុង ឆ្នាំ ២០២២ កន្លងមក ថ្មី ៗ នេះ កម្ពុជា ទទួលបាន ចំណាត់ថ្នាក់ ល្អ ក្នុង វិស័យ បញ្ជូន ពលករ ទៅ ធ្វើការ នៅ កូរ៉េ ហើយ តាមរយៈ ការវាយតម្លៃ ពី ខាង ភាគី កូរ៉េ ឃើញ ថា ពលករ កម្ពុជា មាន ភាពស្មោះត្រង់ ឧស្សាហ៍ ព្យាយាម យកចិត្តទុកដាក់ នឹង ការងារ ធ្វើឱ្យ និយោជក កូរ៉េ ស្រលាញ់ ពេញចិត្ត ជាខ្លាំង ។
ការសន្យា នេះ ធ្វើឡើង ក្នុង កិច្ចពិភាក្សា រវាង លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ជាមួយ លោក UH SOOBONG ប្រធាន អង្គភាព អភិវឌ្ឍន៍ ធនធាន មនុស្ស នៃ សាធារណរដ្ឋ កូរ៉េ នា រសៀល ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នៅ ទីស្តីការ ក្រសួង ការងារ ។
នៅក្នុង ជំនួប នោះ លោក អ៉ិត សំហេង លើកឡើង ថា សាធារណរដ្ឋ កូរ៉េ ជា មិត្ត ដ៏ ល្អ ដែល បាន ចូលរួម អភិវឌ្ឍ ប្រទេស កម្ពុជា ជាពិសេស វិស័យ ការទូត និង កិច្ចសហប្រតិបត្តិការ របស់ ប្រទេស យើង ទាំង ពីរ បាន ក្លាយជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ។
លោក រដ្ឋមន្ត្រី គូសបញ្ជាក់ ដែរ ថា បើ ទោះ ស្ថិត ក្នុង ដំណាក់កាល កូវីដ - ១៩ ក្តី សាធារណរដ្ឋ កូរ៉េ នៅតែ បន្ត ជ្រើសរើស ពលករ កម្ពុជា ទៅ បម្រើ ការងារ នៅ ទីនោះ ព្រមទាំង មើល ថែទាំ និង គាំពារ ពលករ កម្ពុជា បាន យ៉ាង ល្អ ទៀតផង ។ ជាមួយ ការ ដែល ពលករ កម្ពុជា បាន វិលត្រឡប់ ពី បម្រើ ការងារ នៅ សាធារណរដ្ឋ កូរ៉េ វិញ លោក សង្កេតឃើញ ថា ពួកគាត់ មាន វឌ្ឍនភាព និង មាន ការប្រែប្រួល សេដ្ឋកិច្ច ជីវភាព យ៉ាង ខ្លាំង ដោយ អ្នក ខ្លះ ប្រែក្លាយជា សហគ្រិន ភាព និង ជា អ្នក វិនិយោគ ដ៏ ល្បីល្បាញ ។
ប្រធាន អង្គភាព អភិវឌ្ឍន៍ ធនធាន មនុស្ស នៃ សាធារណរដ្ឋ កូរ៉េ បាន បញ្ជាក់ ជូន លោក រដ្ឋមន្ត្រី ថា ភាគី កូរ៉េ នឹង រៀបចំ កម្មវិធី បណ្តុះបណ្តាល ជំនាញ ដល់ ពលករ បរទេស ដែល ចប់ អាណត្តិ ការងារ នៅ កូរ៉េ ដោយ ក្នុង នោះ កម្ពុជា អាចនឹង ក្លាយជា ប្រទេស អាទិភាព ដែល ទទួលបាន ពី គម្រោង ថ្មី នេះ ដោយ គម្រោង នេះ មាន គោលដៅ ផ្តល់ ប្រាក់ កម្ចី ជួយ ដល់ ពលករ ដើម្បី អាច បើក អាជីវកម្ម មួយ បាន សមរម្យ និង មាន ប្រាក់ ចំណូល បាន យ៉ាង ប្រសើរ ។
លោក អ៉ិត សំហេង ពិតជា រីករាយ ចំពោះ គម្រោង ដែល ភាគី កូរ៉េ ជួយ បណ្តុះបណ្តាល ជំនាញ ដល់ ពលករ បរទេស ដែល ចប់ អណត្តិការងារ នៅ កូរ៉េ ទទួលបាន ការបណ្តុះបណ្តាល ជំនាញ ដ៏ ជាក់លាក់ មួយ ដើម្បី មាន លទ្ធភាព គ្រប់គ្រាន់ ក្នុង ការបង្កើត អាជីវកម្ម ផ្ទាល់ខ្លួន ។ លោក រដ្ឋមន្ត្រី ចង់ឱ្យ ពលករ កម្ពុជា ស្ថិត ក្នុង អាទិភាព ខ្ពស់ មួយ ក្នុង ចំណោម ប្រទេស ដទៃ ទៀត ដែល កូរ៉េ គិត ថា នឹង ធ្វើ ការជ្រើសរើស ៕
កម្ពុជា និង អេមីរ៉ាត អារ៉ាប់ រួម ចាប់ផ្តើម ចរចា ជុំ ទី៣ នៃ កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ
តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រសួង ពាណិជ្ជកម្ម ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន ឲ្យដឹង ថា ការចរចា ជុំ ទី៣ នេះ នឹង ប្រព្រឹត្តទៅ រយៈពេល ៣ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ២០ ដល់ ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នៅ ទីក្រុង ឌុយ បៃ ប្រទេស អេមីរ៉ាត អារ៉ាប់ រួម និង មាន វត្តមាន ចូលរួម ពី ក្រុមការងារ ចរចា ពាណិជ្ជកម្ម របស់ ភាគី ទាំង ពីរ សរុប ប្រមាណ ១០០ រូប ។
ការចរចា ជុំ ទី៣នេះ រៀបចំឡើង បន្ទាប់ពី កម្ពុជា និង អេមីរ៉ាត អារ៉ាប់ រួម បាន បើក ការចរចា ជុំ ទី១ កាលពី ថ្ងៃទី ២៤ - ២៦ ខែតុលា ឆ្នាំ ២០២២ នៅ រដ្ឋធានី អាប៊ុយ ដាប៊ី អេមីរ៉ាត អារ៉ាប់ រួម និង ការចរចា ជុំ ទី២ កាលពី ថ្ងៃទី ១៩ - ២១ ខែធ្នូ ឆ្នាំ ២០២២ នៅ រាជធានី ភ្នំពេញ ព្រះរាជាណាចក្រ កម្ពុជា ប្រកបដោយ លទ្ធផល ជា ផ្លែ ផ្កា ។
សម្រាប់ ការចរចា នៅ ជុំ ទី៣ នេះ ភាគី ទាំង ពីរ នឹង បន្ត ការចរចា លើ ការបើក ច្រក ទីផ្សារ និង គ្រោង បញ្ចប់ ការចរចា លើ អត្ថបទ កិច្ចព្រមព្រៀង ដែល នៅ សេសសល់ ដែល ក្នុង នោះ រួម មាន ១៨ ជំពូក ពាក់ព័ន្ធ នឹង ពាណិជ្ជកម្ម ទំនិញ ពាណិជ្ជកម្ម សេវា របាំង ពាណិជ្ជកម្ម អនាម័យ និង ភូត គាម អនាម័យ កិច្ច សម្រួល ពាណិជ្ជកម្ម វិធាន ដើមកំណើត ទំនិញ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច ឧបាស្រ័យ ពាណិជ្ជកម្ម វិនិយោគ កម្មសិទ្ធិ បញ្ញា និង ច្បាប់ និង ស្ថាប័ន ។
ដោយ ទទួលស្គាល់ ពី កិច្ច ខិតខំ ប្រឹងប្រែង និង ការប្តេជ្ញាចិត្ត រួមគ្នា ក្រុមការងារ ចរចា ពាណិជ្ជកម្ម នៃ ភាគី ទាំង ពីរ សង្ឃឹម ថា កិច្ចព្រមព្រៀង នេះ នឹង ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការលើកកម្ពស់ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ទូលំទូលាយ រវាង ប្រទេស ទាំង ពីរ ដែល នឹង បង្កើត កាលានុវត្តភាព ថ្មី ៗ បន្ថែម ទៀត សំដៅ ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ និង វិបុលភាព សម្រាប់ ជាតិ និង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ។
ជាមួយនឹង ការទាមទារ អធិបតេយ្យភាព ត្រួតស៊ី គ្នា នៅក្នុង ផ្លូវ ទឹក យុទ្ធសាស្ត្រ ហ្វីលីពីន បាន បង្កើន វោហាសាស្ត្រ របស់ ខ្លួន ប្រឆាំង នឹង អ្វី ដែល ខ្លួន ពិពណ៌នា ថា ជា « សកម្មភាព ឈ្លានពាន » របស់ ចិន នៅក្នុង សមុទ្រ ចិន ខាងត្បូង ដែល បាន ក្លាយជា ចំណុច មួយ សម្រាប់ ភាពតានតឹង រវាង ចិន និង សហរដ្ឋ អាមេរិក លើ ប្រតិបត្តិការ ដែន សមុទ្រ ផងដែរ ។
គួរ បញ្ជាក់ ថា កាលពី ដើម ខែ នេះ ឆ្មាំ ឆ្នេរសមុទ្រ ហ្វីលីពីន បាន ចោទប្រកាន់ ឆ្មាំ ឆ្នេរសមុទ្រ របស់ ប្រទេស ចិន ថា បាន ប្រើប្រាស់ « ឡាស៊ែរ កម្រិត យោធា » ដើម្បី កំណត់ គោលដៅ នាវា របស់ ខ្លួន ដោយ ធ្វើឱ្យ ក្រុម នាវិក មើល អ្វី មិន ឃើញ ជា បណ្តោះអាសន្ន ដែល បង្កឱ្យ មាន ការព្រួយបារម្ភ នៅក្នុង ប្រទេស ផ្សេងទៀត រួមទាំង ប្រទេស ជប៉ុន អូស្ត្រាលី និង សហរដ្ឋ អាមេរិក ។ ប៉ុន្តែ ប្រទេស ចិន បាន ច្រានចោល ការអះអាង របស់ PCG ថា មិន ពិត នោះ ទេ ៕
សម្តេច តេជោ៖ កម្ពុជា ថ្កោល ទោស ការបាញ់ មីស៊ីល របស់ កូរ៉េ ខាងជើង ដែល ជា គំរាមកំហែង ដល់ សន្តិសុខ និង សន្តិភាព (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន គូសបញ្ជាក់ ថា កម្ពុជា ថ្កោល ទោស ចំពោះ ការបាញ់ មីស៊ីល ឥត ឈប់ឈរ ពីសំណាក់ កូរ៉េ ខាងជើង ព្រមទាំង ការបាញ់ នា ព្រឹក ថ្ងៃទី ២០ ខែកុម្ភៈ នេះ ផងដែរ ។ សម្តេច តេជោ បាន លើកឡើង ទៀត ថា ការបាញ់ នេះ បាន គំរាមកំហែង ដល់ សន្តិសុខ នៅ ឧបទ្វីប កូរ៉េ ព្រមទាំង ពិភពលោក ផងដែរ ។
បើ តាម លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា នៅក្នុង ជំនួប នេះ លោក ឯក អគ្គ រដ្ឋទូត កូរ៉េ ខាងត្បូង បាន ជម្រាប សម្តេច តេជោ ពី ក្តីបារម្ភ របស់ រដ្ឋាភិបាល កូរ៉េ ជុំវិញ ការបាញ់ មីស៊ីល របស់ កូរ៉េ ខាងជើង ។ លោក ឯក អគ្គ រដ្ឋទូត បាន លើកឡើង ថា ការបាញ់ មីស៊ីល នេះ ជា ការគំរាមកំហែង ដល់ សន្តិភាព ទាំង នៅ ឧបទ្វីប កូរ៉េ និង លើ ពិភពលោក ។
ឆ្លើយតប លើ បញ្ហា នេះ សម្តេច តេជោ បាន គូសបញ្ជាក់ ថា កម្ពុជា តែងតែ ថ្កោល ទោស ចំពោះ សកម្មភាព បាញ់ មីស៊ីល របស់ កូរ៉េ ខាងជើង ព្រោះ វា ជា ការរំលោភ សេចក្តីសម្រេច របស់ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ . បង្កើន ភាពតានតឹង ព្រមទាំង បាន គំរាមកំហែង សន្តិសុខ សន្តិភាព ទាំង នៅ ឧបទ្វីប កូរ៉េ និង នៅលើ ពិភពលោក ទាំងមូល ។
លោក អ៊ាង សុផល្លែត បាន ដកស្រង់ ប្រសាសន៍ សម្តេច តេជោ មក បញ្ជាក់ ដូច្នេះ « ចំពោះ បញ្ហា បាញ់ កាំជ្រួច របស់ កូរ៉េ ខាងជើង វិញ សម្តេច តេជោ បាន ជម្រាប ជូន លោក ផាក ថា កម្ពុជា ថ្កោល ទោស កូរ៉េ ខាងជើង ដែល បាន បាញ់ មីស៊ីល ម្តង ហើយ ម្តង ទៀត រួមទាំង ការបាញ់ មីស៊ីល ព្រឹក មិញ ផងដែរ ។ ការបាញ់ មីស៊ីល នេះ គឺជា រំលោភ សេចក្តីសម្រេច របស់ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ និង បង្កើន ភាពតានតឹង ព្រមទាំង បាន គំរាមកំហែង សន្តិសុខ សន្តិភាព ទាំង នៅ ឧបទ្វីប កូរ៉េ និង នៅលើ ពិភពលោក ទាំងមូល »៕
លោក ឯក អគ្គ រាជ ទូត ចក្រភព អង់គ្លេស បាន បង្ហាញ ការកោតសរសើរ និង ស្ញប់ស្ញែង ខាងលើ នេះ ក្នុង ពេល រូប លោក អញ្ជើញ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ មួយចំនួន ជាមួយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នៅ ល្ងាច ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ នៅ វិមាន សន្តិភាព ។
លោក អ៊ាង សុផល្លែត ជំនួយការផ្ទាល់ សម្ដេច តេជោ ហ៊ុន សែន បាន ឱ្យដឹង ថា នៅក្នុង ជំនួប នោះ លោក ឯក អគ្គ រាជ ទូត បាន សូម ការអនុញ្ញាត ពី សម្តេច តេជោ ប្រើប្រាស់ ភាសា ខ្មែរ ។
លោក ដូមីនិក បាន ជម្រាប ជូន សម្ដេច តេជោ ថា លោក ធ្លាប់ បាន មក ប្រទេស កម្ពុជា កាលពី ឆ្នាំ ២០១០ ។ ប្រៀបធៀប ពី ពេល នោះ នឹង ពេល បច្ចុប្បន្ន នេះ លោក បាន ពិនិត្យ ឃើញ ថា កម្ពុជា មាន ការរីកចម្រើន យ៉ាង ឆាប់រហ័ស ។
ក្នុង ជំនួប នេះ លោក ដូមីនិក បាន ជម្រាប ជូន សម្ដេច តេជោ ថា មហិច្ឆតា របស់ លោក គឺ នៅ ពីក្រោយ កម្ពុជា ជួយ កម្ពុជា លើ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វិនិយោគ អប់រំ ហិរញ្ញវត្ថុ ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល កកើត ឡើងវិញ បរិស្ថាន និង វិស័យ ដទៃ ទៀត ក្នុង គោលដៅ ពង្រីក ពង្រឹង ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ស៊ីជម្រៅ នឹង ខ្លាំង ឡើង ។
ជា ការឆ្លើយតប សម្ដេច តេជោ បាន ស្វាគមន៍ និង អបអរសាទរ ជូន ចំពោះ លោក ដូមីនិក ដែល ត្រូវបាន តែងតាំង ជា ឯក អគ្គ រាជ ទូត ចក្រភព អង់គ្លេស ប្រចាំ នៅ កម្ពុជា ។
សម្ដេច តេជោ ក៏ បាន ថ្លែងអំណរគុណ លោក ដូមីនិក ចំពោះ ការកោតសរសើរ ពី ភាពរីកចម្រើន នៅ កម្ពុជា ក៏ ដូចជា ការកត់សម្គាល់ លើ ការដឹកនាំ របស់ សម្តេច ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន កោតសរសើរ លោក ដូមីនិក ដែល បាន និយាយ ភាសា ខ្មែរ បាន យ៉ាង ល្អ ប្រសើរ ។ សម្ដេច តេជោ ក៏ បាន ថ្លៃអំណរគុណ ចំពោះ ចក្រភព អង់គ្លេស ដែល បាន ជួយ កម្ពុជា លើ ការដោះ មីន ។
សម្ដេច តេជោ បាន មានប្រសាសន៍ ថា កម្ពុជា បាន រង នូវ សោកនាដកម្ម ជាង ៤០ ឆ្នាំ មកហើយ ដោយសារ គ្រាប់ មីន ។ ពេលនេះ កម្ពុជា កំពុង ប្រើ ធនធាន យ៉ាង ច្រើន ជាមួយ ធនធាន សប្បុរសជន ក៏ ដូចជា ធនធាន របស់ ដៃគូ ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ កម្ពុជា ក្លាយជា ប្រទេស គ្មាន មីន នៅ ឆ្នាំ ២០២៥ ។
ក្នុង ឱកាស នោះ សម្តេច តេជោ ក៏ បាន បញ្ជាក់ ជូន លោក ដូមីនិក ពី បំណង ចង់ឱ្យ មាន សាកលវិទ្យាល័យ ចក្រភព អង់គ្លេស នៅក្នុង ប្រទេស កម្ពុជា ។
សម្តេច តេជោ ក៏ បាន លើកទឹកចិត្ត ឱ្យ មាន ការវិនិយោគ អង់គ្លេស មកកាន់ កម្ពុជា កាន់តែ ច្រើន ថែម ទៀត ៕
លោក ចូ បៃ ដិន សន្យា ផ្តល់ កញ្ចប់ ជំនួយ យោធា ថ្មី ដែល មាន តម្លៃ ៥០០ លាន ដុល្លារ អាមេរិក ដល់ អ៊ុយក្រែន ក្នុង ដំណើរទស្សនកិច្ច ដ៏ គួរឲ្យ ភ្ញាក់ផ្អើល នៅ ទីក្រុង កៀវ
( កៀវ ) ៖ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បាន ប្រកាស ផ្តល់ ជំនួយ យោធា ថ្មី ដល់ អ៊ុយក្រែន ក្នុង អំឡុង ពេល ទស្សនកិច្ច ដោយ មិន ប្រកាស ទុក មុន ទៅកាន់ រដ្ឋធានី អ៊ុយក្រែន នៅ ថ្ងៃចន្ទ ទី២០ ខែកុម្ភៈ នេះ ដោយ បង្ហាញ ពី សាមគ្គីភាព ជាមួយ ក្រុង កៀវ មុន ថ្ងៃ ខួប១ ឆ្នាំ នៃ ការលុកលុយ របស់ រុស្ស៊ី លើ អ៊ុយក្រែន ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃចន្ទ ទី២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
ស៊ីរ៉ែន បាន បន្លឺ សំឡេង ពេញ រដ្ឋធានី អ៊ុយក្រែន ខណៈ ដែល លោក បៃ ដិន បាន ទៅ បំពេញ ទស្សនកិច្ច នៅ ទីក្រុង កៀវ ដើម្បី ពិភាក្សា ជាមួយ ប្រធានាធិបតី អ៊ុយក្រែ លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី ប៉ុន្តែ មិន មាន របាយការណ៍ អំពី ការបាញ់ មីស៊ីល ឬ ការវាយប្រហារ តាម ផ្លូវ អាកាស របស់ រុស្ស៊ី ឡើយ ។
លោក ហ្សេលេន ស្គី បាន លើកឡើង ថា ដំណើរទស្សនកិច្ច របស់ លោក បៃ ដិន គឺជា សញ្ញា ដ៏ សំខាន់ បំផុត នៃ ការគាំទ្រ សម្រាប់ ប្រជាជន អ៊ុយក្រែន ទាំងអស់ ។
ដោយឡែក លោក បៃ ដិន បាន និយាយ ថា វ៉ាស៊ីនតោន នឹង ឈរ ជាមួយ អ៊ុយក្រែន គ្រប់ ស្ថានការណ៍ ទាំងអស់ ។ រហូតមកដល់ ពេលនេះ សហរដ្ឋ អាមេរិក គឺជា អ្នក ផ្តល់ ជំនួយ យោធា ដ៏ ធំ បំផុត ដល់ អ៊ុយក្រែន ការពារ ខ្លួន ប្រឆាំង នឹង ការឈ្លានពាន របស់ រុស្ស៊ី ។
នា ឱកាស នោះ ដែរ លោក បៃ ដិន សន្យា ថា ទីក្រុង វ៉ាស៊ីនតោន នឹង ផ្តល់ កញ្ចប់ ជំនួយ យោធា ថ្មី មួយ ដែល មាន តម្លៃ ៥០០ លាន ដុល្លារ ដល់ ទីក្រុង កៀវ ដែល នឹង ត្រូវ ប្រកាស នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ ដោយ នឹង រួមបញ្ចូល ទាំង គ្រាប់ រំសេវ បន្ថែម ទៀត សម្រាប់ ប្រព័ន្ធ មីស៊ីល កាំភ្លើង ធំ ចល័ត ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃចន្ទ នេះ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បាន ធ្វើដំណើរ ទៅដល់ ទីក្រុង កៀវ ដោយ ពុំ មាន ការប្រកាស ឱ្យដឹង ជាមុន នោះ ឡើយ មុន គម្រប់ ខួប ១ឆ្នាំ គត់ នៃ សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន ។ វា គឺជា ទស្សនកិច្ច លើក ដំបូង របស់ លោក បៃ ដិន មកកាន់ ទីក្រុង កៀវ គិត ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង ។ កាលពី ខែធ្នូ ឆ្នាំ ២០២២ លោក ហ្សេលេន ស្គី បាន បំពេញ ទស្សនកិច្ច ចេញ ប្រទេស ជា លើក ដំបូង កំលុង ពេល មាន សង្រ្គាម ទៅកាន់ រដ្ឋធានី វ៉ាស៉ីនតោន របស់ សហរដ្ឋ អាមេរិក ៕
និស្សិត អាហារូបករណ៍ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ៣៥ រូប ចេញ ទៅ សិក្សា នៅ ប្រទេស ចិន
( ភ្នំពេញ ) ៖ និស្សិត អាហារូបករណ៍ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចំនួន ៣៥ រូប បាន ធ្វើដំណើរ ចេញ ទៅ សិក្សា នៅ ប្រទេស ចិន ហើយ កាលពី ថ្ងៃទី ១៨ និង ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៣ កន្លងទៅ នេះ ។
និស្សិត ដែល ចេញ ទៅ សិក្សា នៅ សាកលវិទ្យាល័យ អាន ហ៊ួយ ប្រទេស ចិន នេះ ទទួលបាន ការយកចិត្តទុកដាក់ ខ្ពស់ ពីសំណាក់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ក៏ ដូចជា លោក ឡាវ វ៉ាន់ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ជា ប្រធាន ក្រុមការងារ គ្រប់គ្រង និស្សិត ក្រៅ ប្រទេស ប្រចាំ ចិន ព្រមទាំង លោក Liu Ren ប្រធាន សមាគម សភា ពាណិជ្ជកម្ម ខេត្ត អាន ហ៊ួយ នៅ កម្ពុជា ។
ក្នុង នោះ លោក ឡាវ វ៉ាន់ បាន អញ្ជើញ ជូនដំណើរ និស្សិត ដែល ចេញ ទៅ សិក្សា នៅ ប្រទេស ចិន នេះ ដោយ ផ្ទាល់ នៅ ព្រលានយន្តហោះ ថែម ទៀត ផង ។
សូម រំលឹក ថា មុននឹង ឡើង យន្តហោះ ចេញ ទៅ សិក្សា នៅ ប្រទេស ចិន កាលពី ថ្ងៃទី ១៤ ខែកុម្ភៈ កន្លងទៅ លោក ឡាវ វ៉ាន់ បាន រៀបចំ អាហារ មួយ ពេល ជូន និស្សិត ទាំង ៣៥ រូប នេះ ផងដែរ ។
ក្នុង ពេល នោះ លោក ឡាវ វ៉ាន់ បាន ផ្តាំផ្ញើ ដល់ និស្សិត ទាំង ៣៥ រូប ឱ្យ ប្រឹងប្រែង សិក្សា រៀនសូត្រ ក្រេប យក ចំណេះ វិជ្ជា មក បំពេញ ការងារ ចិញ្ចឹម ជីវិត ។ ជាពិសេស ត្រូវ យក ចំណេះ វិជ្ជា បទពិសោធន៍ ដែល បាន ឆ្លងកាត់ អំឡុង ពេល សិក្សា នៅ ក្រៅ ប្រទេស ត្រលប់មក តបស្នង សងគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ។
លោក ឡាវ វ៉ាន់ ក៏ បាន ផ្តាំផ្ញើ បន្ថែម និស្សិត ទាំង ៣៥ រូប កុំ មានអារម្មណ៍ ឯកោ ពេល ស្នាក់ នៅ និង សិក្សា នៅ ប្រទេស ចិន ព្រោះ ថ្នាក់ដឹកនាំ ជាពិសេស សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត យកចិត្តទុកដាក់ ជាប់ ជានិច្ច ។
គួរ បញ្ជាក់ ថា បើ តាម លោក កាវ៉ូសូគ្លូ ភាគី ទាំងអស់ នៅក្នុង បក្ស សម្ព័ន្ធ យោធា មួយ នេះ ត្រូវតែ បញ្ចុះបញ្ចូល ស៊ុយអែត ជាពិសេស ឲ្យ ចាត់ វិធានការ បន្ថែម ទៀត ដើម្បី ដោះស្រាយ កង្វល់ របស់ ទីក្រុង អង់ការ៉ា និង ទទួលបាន ការគាំទ្រ សម្រាប់ ដំណើរការ ចូល ជា សមាជិក អង្គការ ណា តូ ៕
អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន ធ្វើ បទបង្ហាញ អំពី សភាពការណ៍ ទាក់ទង គ្នា រវាង ចិន និង អាមេរិក
ពុទ្ធិក សកលវិទ្យាល័យ ព្រះសីហនុ រាជ រៀបចំ ពិធី ជួប សំណេះសំណាល ជាមួយនិស្សិត ស្រ្តី អបអរសាទរ ទិវា សិទ្ធិ នារី ៨មីនា
( ភ្នំពេញ ) ៖ ពុទ្ធិក សកលវិទ្យាល័យ ព្រះសីហនុ រាជ បាន រៀបចំ កម្មវិធី ជួប សំណេះសំណាល ជាមួយ បុគ្គលិក សមណ និស្សិត ជាពិសេស និស្សិត ជា ស្ត្រី នា ព្រឹក ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ក្នុង គោលបំណង ផ្តល់ ចំណេះដឹង និង ចែករំលែក បទពិសោធន៍ ជាមួយនិស្សិត ជា ស្ត្រី នៅឯ ពុទ្ធិក សកលវិទ្យាល័យ ព្រះសីហនុ រាជ ដើម្បី អបអរសាទរ ទិវា សិទ្ធិ នារី ៨ មីនា ។
ក្នុង ឱកាស នោះ លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ បាន ប្រាប់ ទៅ និស្សិត ស្រី ទាំងនោះ ថា ចូរ មោទនភាព ចំពោះ អ្វី ដែល ស្ត្រី ខ្មែរ មាន គឺ តាំងពី អតីតកាល រហូតម ដល់ បច្ចុប្បន្ន ហើយ ត្រូវ ចាប់ យក ឱកាស មាស នេះ សិក្សា រៀនសូត្រ ឱ្យ មាន ចំណេះ វិជ្ជា បរិបូរណ៍ ។
លោកស្រី បាន បន្ត ថា ឥឡូ នេះ ស្ត្រី ក៏ មាន ឱកាស សិក្សា រហូតដក់ ថ្នាក់ ឧត្តម ហើយ អាចនឹង បន្ត ទៅដល់ ក្រោយ ឧត្តម ទៀត តាម តែ ក្តី ប្រាថ្នា ដែល នេះ គឺជា ឱកាស ល្អ ឱកាស មាស និង ជា អ្វី ដែល គួរ មោទនភាព ចំពោះ ស្ថានភាព ដែល យើង មាន ។ ដូច្នេះ ត្រូវ ចេះ ចាប់ យក ឱកាស ដ៏ ប្រសើរ ថ្លៃថ្លា នេះ ដើម្បី ទាញយក ផលប្រយោជន៍ ឱ្យ បាន ច្រើន តាម ដែល អាច ហើយ អ្វី ដែល នៅ ចំពោះមុខ នេះ គឺ ត្រូវ ខិតខំ សិក្សា រៀនសូត្រ យក ចំណេះ វិជ្ជា ឱ្យ បាន បរិបូរណ៍ សូម កុំ គិត អំពី រឿង ភ្លើតភ្លើន ។
នេះ គឺជា ការលើកឡើង របស់ លោកជំទាវ ខៀវ ស៊ីណា ជា ចាន់ តូ នៅក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយ បុគ្គលិក សមណ និស្សិត ជាពិសេស និស្សិត ជា ស្ត្រី នៃ ពុទ្ធិក សកលវិទ្យាល័យ ព្រះសីហនុ រាជ នា ព្រឹក ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ។
( ព្រះវិហារ ) ៖ ព្រះវិហារ វត្ត សារា រាម ហៅ វត្ត ស្រះចក ស្ថិត ក្នុង ភូមិ កំពត ឃុំ រហ័ស ស្រុក រវៀង ខេត្ត ព្រះវិហារ ត្រូវបាន រៀបចំ ពិធី បញ្ចុះ ខណ្ឌ សីមា ឆ្លង ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ ក្រោម វត្តមាន លោក មួង ឃីម ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ស្រុក រវៀង ខេត្ត ព្រះវិហារ ដោយ មាន ការចូលរួម ពី លោក ហោ ប៊ុន ហួរ អភិបាល ស្រុក រវៀង ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ជាច្រើន រូប ទៀត ។
នៅក្នុង ឱកាស នេះ ដែរ លោក មួង ឃីម បាន ថ្លែង ប្រគេន ព្រះសង្ឃ និង ជម្រាប ជូន លោក តា លោកយាយ ពី ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ដោយ ក្តី នឹករលឹក ពី លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ខេត្ត ព្រះវិហារ ដែល ជានិច្ច ជាកាល តែង គិតគូរ យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ខេត្ត ព្រះវិហារ ។ ។
លោក មួង ឃីម បាន ថ្លែង ទៀត ថា ប្រទេស កម្ពុជា របស់ យើង ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញ ផ្ទៃ ប្រទេស និង ការអភិវឌ្ឍ រីកចម្រើន គ្រប់ វិស័យ ទាំង វិស័យ អាណាចក្រ និង ពុទ្ធ ចក្រ ។ លោក ក៏ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ បន្ត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ដើម្បីឱ្យ ប្រទេសជាតិ ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ រីកចម្រើន ថែម ទៀត ។
លោក មួង ឃីម ក៏ បាន នាំ ថវិកា ចំនួន ៩០០ ដុល្លារ របស់ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ចែកជូន ដល់ កម្លាំង ប្រជាការពារ ជា ការលើកទឹកចិត្ត ដែល បាន ខិតខំ ការពារ សន្តិសុខ រយៈពេល ៣ ថ្ងៃ នៃ ពិធី បុណ្យ នេះ ផងដែរ ៕
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ សេចក្តីសម្រេចចិត្ត នៃ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស និង គោល នយោបាយ ៨ ចំណុច របស់ គណបក្ស ជូន សមាជិក នៅ ស្រុក លើក ដែក
កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី អភិបាល ស្រុក លើក ដែក សមាជិក សមាជិកា គណៈកម្មាធិការ បក្ស ក្នុង ជួរ គណបក្ស ស្រុក - ឃុំ ក្រុមការងារ ស្រ្តី និង យុវជន ជុំវិញ ស្រុក ប្រមាណ ១៥៥ នាក់ នៅ ទីស្នាក់ការបក្ស ស្រុក លើក ដែក ។
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី បាន ចាប់ផ្តើម ថ្លែង ទៅកាន់ អ្នកចូលរួម ដោយ បាន ពាំនាំ នូវ ការសាកសួរ សុខទុក្ខ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រមទាំង បាន សម្តែង នូវ អំណរគុណ ជូន ប្រជាពលរដ្ឋ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា មន្រ្តី មូលដ្ឋាន បក្ស គ្រប់ ថ្នាក់ ទាំងអស់ ដែល បាន ពលី គ្រប់ បែបយ៉ាង ដើម្បី រួមចំណែក រក្សា ការពារ សន្តិភាព និង កសាង សេដ្ឋកិច្ច សង្គម ឱ្យ មាន ការរីកចម្រើន ដូច សព្វ ថ្ងៃ ។
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ក៏ បាន លើកឡើង នូវ ខ្លឹមសារ សេចក្តីសម្រេចចិត្ត នៃ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស និង គោល នយោបាយ ៨ ចំណុច របស់ គណបក្ស ក្នុង ការការពារ និង លើកស្ទួយ ផលប្រយោជន៍ របស់ ប្រជាជន ។ លោកស្រី បាន គូសបញ្ជាក់ ថា លទ្ធផល អង្គ មហាសន្និបាត បាន សម្រេច បន្ត គាំទ្រ យ៉ាង ពេញ ទំហឹង សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី នៅ អាណត្តិ បន្ទាប់ និង គាំទ្រ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សម្រាប់ ពេល អនាគត ។
ជា ទីបញ្ចប់ លោកស្រី កិតិ្ត សិង្គហ បណ្ឌិត ឃួន សុដារី បាន ក្រើន រំលឹក ពី ការងារ បោះឆ្នោត ជ្រើសរើស តំណាងរាស្រ្ត អាណត្តិ ទី៧ សូម ឱ្យ សមាជិក សមាជិកា គណបក្ស ទាំងអស់ ត្រូវ បន្ត ខិតខំ បំពេញ ការងារ ឱ្យ កាន់តែ សកម្ម ឡើង ដើម្បី ទទួលបាន ការគាំទ្រ និង ផ្តល់ ការជឿជាក់ ជូន ប្រជាពលរដ្ឋ ឱ្យ អស់ ពី បេះដូង និង ដណ្តើម ជ័យជម្នះ ជូន គណបក្ស ប្រជាជន ឱ្យ កាន់តែ ច្រើន ៕
ព្រះវិហារ នៃ វត្ត ព្រះធាតុ អាយុកាល ១៣៥ ឆ្នាំ ត្រូវបាន ជួសជុល និង កែលម្អ ឡើងវិញ . ថ្ងៃ នេះ មន្ត្រី គណបក្ស ប្រជាជន កម្ពុជា ធ្វើ ពី ធី បុណ្យ ឆ្លង និង បញ្ចុះ ខណ្ឌ សីមា
( សៀមរាប ) ៖ ដោយសារ វ័យ ចំណាស់ របស់ ព្រះវិហារ នៃ វត្ត ព្រះធាតុ ដែល មាន អាយុកាល ១៣៥ ឆ្នាំ វត្ត នេះ ត្រូវបាន ជួសជុល និង កែលម្អ ជា បន្តបន្ទាប់ ។ ជាក់ស្តែង ៣ឆ្នាំ ចុងក្រោយ នេះ ព្រះចៅ អធិការ គណៈកម្មការ វត្ត និង ប្រជាពុទ្ឋ បរិស័ទ ជិត ឆ្ងាយ បាន ជួសជុល និង កែលម្អ ឡើងវិញ ដោយ ចំណាយ ថវិកា អស់ ជិត ៤ម៉ឺន ដុល្លារ ។
ពី ធី បុណ្យ ឆ្លង និង បញ្ចុះ ខណ្ឌ សីមា ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព ឧកញ៉ា សៀង ណាំ អ្នកតំណាងរាស្ត្រ មណ្ឌល សៀមរាប មកពី គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក ក្រឡាញ់ នៅ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
ក្នុង ឱកាស នោះ ព្រះភិក្ខុ សាសន មុនី វិត វ៉ៃ ព្រះចៅ អធិការ វត្ត ព្រះធាតុ មាន សង្ឃ ដីកា ថា ព្រះវិហារ វត្ត ព្រះសារីរិក ធាតុ ហៅ វត្ត ព្រះធាតុ គឺ មាន បណ្តោយ ១៧ម៉ែត្រ និង ទទឹង ១២ម៉ែត្រ កម្ពស់ ៦ម៉ែត្រ ស្ថិត ក្នុង ភូមិ ព្រះធាតុ ឃុំ ខ្វាវ ស្រុក ជីក្រែង ខេត្ត សៀមរាប ដែល មាន អាយុកាល ១៥៣ ឆ្នាំ មកហើយ និង ជា អារាម មួយ ដែល សាងសង់ លើ បរិវេណ ប្រាសាទ បុរាណ ដែល បាន កសាង នៅ ចុង សតវត្ស ទី ១៥ ។ គិត ចាប់ពី កសាង វត្ត មកដល់ បច្ចុប្បន្ន វត្ត នេះ គេ ចាំ បាន ថា មាន ចៅអធិការ ចំនួន ២២ អង្គ មក ហើយ ។
ថវិកា ដែល បាន យកមក ជួសជុល កែលម្អ ព្រះវិហារ នេះ គឺ បាន មក ពី ការចូលរួមចំណែក របស់ ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ដ និង ពុទ្ធ បរិស័ទ ជិត ឆ្ញាយ និង សប្បុរសជន ជិត ឆ្ងាយ និង ការដឹកនាំ ធ្វើ បុណ្យ អង្គក ឋិន ទាន និង បុណ្យ ផ្សេង ៗ របស់ ព្រះចៅ អធិការ និង គណៈកម្មការ វត្ត ។ ព្រះអង្គ បាន មាន សង្ឃ ដីកា ថា វត្ត នៅ ជំពាក់ បច្ច័យ ថ្លៃ សម្ភារៈ សំណង់ និង ថ្លៃ ចាក់ ដី បំពេញ វត្ត ចំនួន ១២.៥៥៥ ដុល្លារ ផងដែរ ។
មាន មតិ សំណេះសំណាល ជាមួយ ពុទ្ធ បរិស័ទ ក្នុង ឱកាស នោះ ឧកញ៉ា សៀង ណាំ បាន លើកឡើង អំពី ការកសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ នា ពេល បច្ជុ ប្បន្ន ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី បាន ធ្វើឲ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ រីកចំម្រើន គ្រប់ វិស័យ ទាំង អាណាចក្រ និង ពុទ្ធ ចក្រ ហើយ ព្រះពុទ្ឋ សាសនា ត្រូវបាន កំណត់ ដោយ រដ្ឋធម្មនុញ្ញ ជា សាសនា របស់ រដ្ឋ ។
« ពិសេស ក្រោយពី សម័យ កម្ពុជា ប្រជាធិបតេយ្យ បាន ផុត រលត់ ទៅ ព្រះពុទ្ធ វិស័យ សាសនា ត្រូវបាន រស់រាន មាន ជីវិត និង ត្រូវបាន រដ្ឋ យកចិត្តទុកដាក់ ធ្វើឲ្យ មាន ការរីកចម្រើន ឡើងវិញ ទាំង វិស័យ ធនធាន មនុស្ស ធនធាន សម្ភារ រូបវន្ត ក្នុង ក្របខ័ណ្ឌ ទូទាំង ប្រទេស ដូច វិស័យ នានា ផងដែរ » ។ នេះ ជា ការបន្ថែម របស់ ឧកញ៉ា សៀង ណាំ ។
នៅក្នុង ពិធី នោះ ផងដែរ អ្នក ឧកញ៉ា សៀង ណាំ បាន ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួសុខ ទុក្ខ ពី សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត សៀមរាប ដែល សម្ដេច តែងតែ បាន យកចិត្ត ទុក្ខ ដាក់ ខ្ពស់ ចំពោះ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ នៅ គ្រប់ មូលដ្ឋាន ។
អ្នក ឧកញ៉ា បាន បន្ត បន្ត ថា « ជាក់ស្ដែង ថ្ងៃ នេះ សម្ដេច តេជោ បាន បន្ត ផ្ដល់ ថវិកា បន្ថែម សម្រាប់ ការស្ថាបនា ផ្លូវ មួយ ខ្សែ នេះ សម្រាប់ ទុក ជា ផលប្រយោជន៍ ដល់ លោកតា លោកយាយ ព្រះសង្ឃ សិស្សានុសិស្ស បងប្អូន ប្រជាពលរដ្ឋ និង សាធារណៈ ជន ទូទៅ ដើម្បី មាន ភាពងាយស្រួល ក្នុង ការធ្វើដំណើរ និង ដឹកជញ្ជូន នូវ ផលិតផល កសិកម្ម ព្រមទាំង ជា ផ្លូវ ដែល មាន សារៈសំខាន់ ក្នុង ការផ្សាភ្ជាប់ រវាង ពី មូលដ្ឋាន មួយ ទៅ មូលដ្ឋាន និង ពី តំបន់ មួយ ទៅ តំបន់ មួយ ទៀត ផងដែរ » ។
ឆ្លៀត ក្នុង ឱកាស នេះ អ្នក ឧកញ៉ា សៀង ណាំ បាន អំពាវនាវ ដល់ លោកតា លោកយាយ ប្រជាពលរដ្ឋ ដែល មាន អាយុ គ្រប់ និង មាន សិទ្ធិ បោះឆ្នោត ទៅ ចូលរួម បោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ នីតិកាល ទី៧ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃអាទិត្យ ទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ កុំបី ខាន ឡើយ ។
អ្នក ឧកញ៉ា ក៏ បាន អំពាវនាវ ឲ្ស ប្រជាពលរដ្ឋ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ថ្នាក់ដឹកនាំ ដើម្បី បន្ត ការអភិវឌ្ឍ និង ការរីកចម្រើន រុងរឿង លើ គ្រប់ វិស័យ និង ប្រកបដោយ សុខ សន្តិភាព និង ស្ថិរភាព នយោបាយ ផងដែរ ៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង អប់ រំ៖ បារី អេឡិចត្រូនិច នៅតែ បន្ត ធ្វើ សកម្មភាព បំភាន់ ស្មារតី របស់ យុវជន និង ចែកចាយ យ៉ាង សកម្ម លើ បណ្តាញ សង្គម
( ភ្នំពេញ ) ៖ ទោះបី មាន ការហាមឃាត់ ពីសំណាក់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា កម្លាំង សមត្ថកិច្ច ពាក់ព័ន្ធ យ៉ាងណា ក៏ដោយ ក៏ នៅតែ មាន ក្រុម បារី អេឡិចត្រូនិច បាន បន្ត បំភាន់ ស្មារតី របស់ យុវជន តាមរយៈ ការរចនា ប្រកបដោយ ភាពច្នៃប្រឌិត និង ទាក់ទាញ ដោយ បង្ហាញ ពី រូបរាង ថ្មី ៗ តូច ៗ ងាយស្រួល ដាក់ តាម ខ្លួន ព្រមទាំង មាន ក្លិន ក្រអូប និង រសជាតិ ប្លែក ៗ នៅលើ បណ្តាញ សង្គម ដោយ មិន មាន ការខ្លាចរអា នឹង ច្បាប់ នោះ ឡើយ ។ នេះ ជា ការលោកស្រី សឿ សុជាតា អនុ រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា ។
លោកស្រី បាន អះអាង ទៀត ថា បច្ចុប្បន្ន នេះ ក្រុមហ៊ុន ទាំងនោះ បាន បន្ត ផ្សព្វផ្សាយ យ៉ាង សកម្ម តាមរយៈ បណ្តាញ សង្គម ហើយ ជាពិសេស នោះ តាម បណ្តាញ សង្គម ដូចជា Facebook telegram និង បណ្តាញ សង្គម ផ្សេង ៗ ទៀត ស្រប ពេល ដែល ក្រសួង អប់រំ យុវជន និង កីឡា កំពុងតែ លើកទឹកចិត្ត ឱ្យ យុវជន ខ្មែរ ដើរ ឱ្យ ទាន់ និង បណ្តាញ ឌីជីថល កុំ ជឿ លើ ការបោកប្រាស់ របស់ ក្រុមហ៊ុន នោះ បាន ឱ្យ សោះ ហើយ ពេល ឃើញ សកម្មភាព ទាំងនោះ ត្រូវ រួមគ្នា ជួយ បន្ត ប្តឹង ទៅដល់ កម្លាំង សមត្ថកិច្ច ឱ្យ បាន ចាត់ វិធានការ ជាបន្ទាន់ ។
លោកស្រី សឿ សុជាតា ក៏ បាន បន្ត អំពាវនាវ ឱ្យ យុវជន ទាំងអស់ ចូលរួម លុបបំបាត់ បារី អេឡិចត្រូនិច នេះ ឱ្យ បាន គ្រប់ ៗ គ្នា ទាំង នៅក្នុង សាលា និង ក្រៅ សាលា ផងដែរ និង បាន បន្ត អំពាវនាវ ដល់ បណ្តា គណៈ គ្រប់គ្រង តាម សាលារៀន លោកគ្រូ អ្នកគ្រូ ចូលរួម ទាំងអស់ គ្នា បង្កើត សកម្មភាព លុបបំបាត់ ការប្រើប្រាស់ បារី អេឡិចត្រូនិច គ្រប់ ប្រភេទ ទាំងអស់ នៅ តាម គ្រឹះស្ថាន សិស្សា និង នៅក្នុង សហគមន៍ ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ធនធាន មនុស្ស របស់ យើង អាច ឆ្លើយតប ទៅនឹង តម្រូវការសង្គម ផងដែរ ។
ជាមួយគ្នា នោះ ដែរ យុវជន ឆ្នើម ដែល បាន ចូលរួម ប្រកួត វោហារ ស័ព្ទ នេះ បាន បញ្ជាក់ ថា ទោះបីជា បារី អេឡិចត្រូនិក បង្ក ផល ប៉ះពាល់ ខ្លាំង ដល់ សុខភាព ហើយ ត្រូវបាន រដ្ឋាភិបាល ចេញ សេចក្តីណែនាំ ហាមឃាត់ ការប្រើប្រាស់ ការលក់ និង ចែកចាយ រួចហើយ ប៉ុន្តែ សព្វ ថ្ងៃ នេះ ការលក់ និង ការចែកចាយ បារី អេឡិចត្រូនិក នៅតែ មាន យ៉ាង ចំហរ នៅ តាម ប្រព័ន្ធ បណ្ដាញ សង្គម និង ការនិយាយ ត ៗ គ្នា តាមរយៈ មិត្តភ័ក្រ ដែល នាំឱ្យ សិស្សសាលា ជាច្រើន បាន ទិញ មក ប្រើប្រាស់ ។
យុវជន ឆ្នើម រូប នេះ បាន លើកឡើង ទៀត ថា បារី អេឡិចត្រូនិច ត្រូវបាន ឈ្មួញ រចនា ប្រកបដោយ ភាពច្នៃប្រឌិត ស៊ីវីល័យ និង ទាក់ទាញ ដោយ បង្ហាញ ពី រូបរាង ស្អាត ៗ តូច ៗ ងាយស្រួល ដាក់ តាម ខ្លួន ព្រមទាំង មាន ក្លិន ក្រអូប និង រសជាតិ ប្លែក ៗ ដូចជា រសជាតិ ក្រូច ឳ ឡឹក ស្ត្រ បឺរី និង កាហ្វេ ជាដើម ។ មិន តែ ប៉ុណ្ណោះ ក្រុម អ្នកលក់ បារី អេឡិចត្រូនិក បាន ផ្សព្វផ្សាយ ថា វា ជា ឧបករណ៍ ផ្ដាច់ បារី និង គ្មាន ផល ប៉ះពាល់ ឡើយ ។
យុវជន រូប នេះ បាន បន្ថែម ថា ដើម្បី បង្ការ យុវជន ពី ការអូសទាញ ឱ្យ ប្រើប្រាស់ ផលិតផល ដ៏ គ្រោះថ្នាក់ នេះ សូម ស្នើសុំ ឱ្យ អាជ្ញាធរ ពាក់ព័ន្ធ បញ្ឈប់ ការនាំចូល ការចែកចាយ លក់ និង ការផ្សព្វផ្សាយ ផលិតផល នេះ ជាពិសេស លប់ បំបាត់ ការផ្សព្វផ្សាយ តាម ប្រព័ន្ធ បណ្ដាញ សង្គម ផងដែរ ។
គួរ បញ្ជាក់ ថា ទន្ទឹម គ្នា នេះ ក្រោយ ចុះ សួរ ទុក្ខ ផ្ទាល់ នៅ តាម បណ្តា សហគមន៍ ដែល រងគ្រោះ ធ្ងន់ធ្ងរ លោក គ្រីស ហ៉ីប គីន បាន និយាយ ថា ការប្រកាស អាសន្ន ថ្នាក់ ជាតិ ដែល ធ្វើឡើង កាលពី សប្តាហ៍ មុន គឺ ត្រូវ អូសបន្លាយ រយៈពេល មួយ សប្តាហ៍ ទៀត ។ វា គឺជា លើក ទី៣ ប៉ុណ្ណោះ នៅក្នុង ប្រវត្តិសាស្រ្ត របស់ ខ្លួន អាយុកាល ១៨៣ ឆ្នាំ ដែល នូវែលសេឡង់ បាន ប្រកាស អាសន្ន ថ្នាក់ ជាតិ បែប នេះ ។ សម្រាប់ ពីរ លើក ទៀត គឺ កាលពី គ្រោះ រញ្ជួយ ដី ឆ្នាំ ២០១១ និង ការផ្ទុះឡើង នៃ ជំងឺ កូវីដ១៩ កាលពី ឆ្នាំ ២០២០ ៕
ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា ប្រកាស ថ្កោល ទោស ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល ប្រមាថ ម្តង ហើយ ម្តង ទៀត ដល់ អង្គ ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ លោក ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ ទាំងអស់ របស់ ក្រសួង នៅ ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន ថ្កោលទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ ៣ជំនាន់ សម រង្ស៉ី ដែល បាន ប្រមាថ ជាថ្មី ដល់ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជារាស្ត្រ ខ្មែរ ទូទាំង ប្រទេស ។
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែកុម្ភៈ៖ បង្ក្រាប ២៦ ករណី ឃាត់ខ្លួន ៦៨ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៦ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១២ករណី . ដឹកជញ្ជូន រក្សាទុក ៤ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៦៨ នាក់ ។
( សៀមរាប ) ៖ នៅ រសៀល ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ជូន ដល់ លោក ព្រាល អ៊ិត អាយុ ២៩ ឆ្នាំ រស់ នៅ ភូមិ រាជ ជម្ទុល ឃុំ ស្រែ ខ្វាវ ស្រុក អង្គរ ជុំ ខេត្ត សៀមរាប ដែល បាន រងគ្រោះ ដោយសារ គ្រាប់ មិន ទាន់ ផ្ទុះ ។
ជនរងគ្រោះ បាន រងគ្រោះ កាលពី ថ្ងៃទី ១៦ ខែកុម្ភៈ ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៧ - ៣០នាទី នៅ ចំណុច ថ្គាម រមាស ស្ថិត នៅ ភូមិ សាមគ្គី ឃុំ ត្រពាំង ប្រីយ៍ ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ពេល ដែល ទៅ ធ្វើ ការស៊ីឈ្នួល ដក ដំឡូង មី ។ បច្ចុប្បន្ន លោក កំពុង សម្រាក ព្យាបាល ក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ។
លោក ស៊ុំ សំអន បាន បន្ត ថា អំណោយ មនុស្សធម៌ ដែល បាន នាំយក មក ជូន នា ពេលនេះ អាច ជួយ សម្រាល ទុក្ខ បាក បាន មួយ កម្រិត ហើយក៏ ជា ការបង្ហាញ នូវ ការយកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ គ្រប់ រូប ពីសំណាក់ ថ្នាក់ដឹកនាំ ពិសេស គឺ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន ដូច ដែល បាន លើកឡើង ថា កាកបាទ ក្រហម កម្ពុជា មាន គ្រប់ ទីកន្លែង សម្រាប់ គ្រប់ ៗ គ្នា - មិន ទុក នរណា ម្នាក់ ចោល និង ទីណា មាន ទុក្ខលំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា ។
ជាមួយ នេះ ដែរ អំណោយ មនុស្សធម៌ ដែល ផ្តល់ជូន រួម មាន អង្ករ ៣០ គីឡូក្រាម មុង១ ភួយ១ សារុង១ ក្រមា១ មី១ កេស ត្រីខ១យួរ និង ថវិកា ៤សែន រៀល ផងដែរ ៕ ក្រុម ក្មេង ទំនើង គប់ ដុំ ថ្ម លើ ប្រជាពលរដ្ឋ នៅ ផ្លូវ ជាតិ លេខ ៣ ក្នុង ស្រុក ដង ទង់ ខេត្ត កំពត ត្រូវ កម្លាំង នគរបាល ចាប់ខ្លួន
( កំពត ) ៖ ករណី ក្មេង ទំនើង បង្ក ការអុក ឡុក តាម ទី សាធារណៈ ដោយ ធ្វើ សកម្មភាព គប់ ដុំ ថ្ម លើ ប្រជាពលរដ្ឋ ដែល ជា អ្នកធ្វើដំណើរ តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៣ ស្ថិត ក្នុង ស្រុក ដង ទង់ ខេត្ត កំពត ត្រូវ កម្លាំង ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពត ស្រាវជ្រាវ ចាប់ខ្លួន បាន ពីរ នាក់ ។
