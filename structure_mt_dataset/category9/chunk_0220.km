( ភ្នំពេញ ) ៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត បាន បង្ហាញ ក្តីកង្វល់ លើ ការផលិត អំបិល របស់ សហគមន៍ ដោយសារតែ ត្រូវ ពឹងផ្អែក ទាំងស្រុង លើ កត្តា អាកាសធាតុ មាន ន័យ ថា ប្រសិនបើ អាកាសធាតុ អំណោយផល បរិមាណ អំបិល នឹង មាន កំណើន ក៏ប៉ុន្ដែ ប្រសិនបើ អាកាសធាតុ ប្រែប្រួល មាន ភ្លៀង ធ្លាក់ ច្រើន ការផលិត អំបិល ក៏ ធ្លាក់ចុះ ។
លោក ថា ក្នុង ឆ្នាំ នេះ ការផលិត អំបិល ក៏ មាន បញ្ហា ប្រឈម ដោយសារតែ កម្ពុជា រង នូវ ឥទ្ធិពល ព្យុះ ដូច្នេះ ការផលិត អំបិល កើនឡើង ឬ ថយចុះ ពឹង ទាំងស្រុង លើ អាកាសធាតុ ប្រសិនបើ មិន មាន ភ្លៀង ធ្លាក់ ទេ ការផលិត អំបិល នឹង ប្រព្រឹត្តិ ទៅ ដោយ ល្អ ប្រសើរ ប៉ុន្ដែ បើ មាន ភ្លៀង ធ្លាក់ បរិមាណ អំបិល ក៏ ថយចុះ ដូចគ្នា ។
ដោយសារតែ បញ្ហា អាកាសធាតុ បណ្ដាលឲ្យ ការផលិត អំបិល ឆ្នាំ ២០២២ ទទួលបាន ទិន្នផល តិចតួច បាន តែ ចំនួន ៣ម៉ឺន តោន ប៉ុណ្ណោះ ដូច្នេះ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច ឲ្យ មាន ការនាំចូល អំបិល ដើម្បី មក បំពេញ តម្រូវការ ក្នុង ស្រុក ប្រមាណ ជា ៦ម៉ឺន តោន ។
ខេត្ត កំពត និង ខេត្ត កែប ជា ទីតាំង ផលិត អបិល នៅ កម្ពុជា ដោយ អំបិល ចាប់ផ្ដើម ផលិត នៅ ចុង ខែធ្នូ រហូតដល់ ខែឧសភា ចំណែក ផ្ទៃដី សម្រាប់ ផលិត អំបិល វិញ គិត នៅក្នុង ខេត្ត កំពត មាន ចំនួន ៣ ៧២៦ ហិចតា ៕
ទូត ៤ប្រទេស នឹង ជំរុញ អ្នក វិនិយោគទុន របស់ ខ្លួន ឱ្យ មក បណ្តាក់ទុន នៅ កម្ពុជា បន្ថែម ទៀត
( ភ្នំពេញ ) ៖ ឯក អគ្គ រាជ ទូត និង រដ្ឋទូត ចំនួន ៤ប្រទេស នឹង ជំរុញ អ្នក វិនិយោគទុន របស់ ខ្លួន ឱ្យ មក បណ្តាក់ទុន នៅ កម្ពុជា បន្ថែម ទៀត ។ នេះ បើ តាម លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
( ភ្នំពេញ ) ៖ គ្រឿងញៀន នៅតែ ជា ក្ដីកង្វល់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បើ ទោះបី កន្លងទៅ ប្រទេស កម្ពុជា ធ្លាប់ តែ ជា ប្រទេស ឆ្លងកាត់ ក៏ដោយ តែ មួយ រយៈ ចុងក្រោយ នេះ កម្លាំង សមត្ថកិច្ច ជំនាញ បាន ស្រាវជ្រាវ និង ឈានដល់ ការបង្ក្រាប ទីតាំង មួយចំនួន ដែល លប លួច កែច្នៃ ផលិត ផងដែរ ។
ជា ការចូលរួមចំណែក ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង បទល្មើស គ្រឿងញៀន លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មុធរិទ្ធ ស្នងការ នគរបាល ខេត្ត កំពត បាន បង្ហាញ នូវ ការប្ដេជ្ញាចិត្ត និង តាំងចិត្ត ខ្ពស់ ក្នុង ការបោសសម្អាត គ្រឿងញៀន នៅក្នុង មូលដ្ឋាន ខេត្ត របស់ លោក ឲ្យ អស់ ដើម្បីឲ្យ ស្រប ទៅនឹង អ្វី ដែល រាជ រដ្ឋាភិបាល កម្ពុជា ចង់បាន ។
ក្នុង សន្និសីទ សារព័ត៌មាន របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា ស្ដីពី « ភាពជោគជ័យ រយៈពេល ៥ ឆ្នាំ របស់ រដ្ឋបាល ខេត្ត កំពត » នៅ ព្រឹក ថ្ងៃទី ១៦ ខែកុម្ភៈ ឆ្នាំ ២០២៣ នេះ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន អះអាង ថា ក្នុង មូលដ្ឋាន ខេត្ត របស់ លោក កម្លាំង ការិយាល័យ ជំនាញ ប្រឆាំង បទល្មើស គ្រឿងញៀន នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត គឺ តែងតែ ធ្វើ សកម្មភាព ជាប់ ជាប្រចាំ ក្នុង ការបង្ក្រាប បទល្មើស នេះ ។
លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ក្នុង ខេត្ត កំពត គឺជា រៀងរាល់ ថ្ងៃ កម្លាំង ការិយាល័យ ជំនាញ របស់ យើង បាន ចុះ ធ្វើ ការបង្ក្រាប ក្រោម ការណែនាំ របស់ ឯកឧត្តម អភិបាល ខេត្ត ព្រោះ ប្រជាពលរដ្ឋ មាន ក្ដីកង្វល់ » ។ លោក ឧត្តមសេនីយ៍ ស្នងការ មើលឃើញ ទៀត ថា គ្រឿងញៀន តែ មួយ មុខ បាន បង្ក នូវ បញ្ហា យ៉ាង ច្រើន នៅក្នុង សង្គម នា ពេល បច្ចុប្បន្ន នេះ ។
លោក បាន បន្ដ ទៀត ថា កាលពី មុន អ្នក ដែល ប្រើប្រាស់ គ្រឿងញៀន មាន តែ យុវវ័យ ប៉ុណ្ណោះ ប៉ុន្ដែ ពេលនេះ សូម្បី មនុស្ស វ័យ កណ្ដាល ក៏ ធ្លាក់ខ្លួន ប្រើប្រាស់ គ្រឿងញៀន នេះ ដែរ ។ បើ តាម លោក ស្នងការ អ្នក ដែល ប្រើប្រាស់ គ្រឿងញៀន គឺ តែង ធ្វើ សកម្មភាព ល្មើស ផ្សេង ៗ ដែល កន្លងមក សមត្ថកិច្ច ជំនាញ បង្ក្រាប បាន ហើយ ពិនិត្យ រកឃើញ មាន សារធាតុ ញៀន នៅក្នុង ខ្លួន ផងដែរ ។
យោង តាម របាយការណ៍ របស់ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន ឲ្យដឹង ថា ក្នុង ឆ្នាំ ២០២២ កន្លងទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពត បង្ក្រាប បាន ករណី ជួញដូរ និង ចែកចាយ ចំនួន ១១៥ ករណី និង ការប្រើប្រាស់ ចំនួន ១០ករណី ។ លោក បាន សង្កត់ធ្ងន់ ទៀត ថា សម្រាប់ នៅ ខេត្ត កំពត គឺ មិន មាន ទីតាំង ផលិត គ្រឿងញៀន នោះ ទេ ហើយ គ្រឿងញៀន ដែល បង្ក្រាប កន្លងមក នេះ ស្ថិត ក្នុង រូបភាព តូចតាច ប៉ុណ្ណោះ ។
ដោយឡែក សម្រាប់ សភាពការណ៍ ទូទៅ វិញ លោក ស្នងការ បាន បញ្ជាក់ ថា គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ក្រោម ការដឹកនាំ បញ្ហា ដោយ ផ្ទាល់ ពីសំណាក់ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ដោយ មាន ការចូលរួម ពី កងកម្លាំង អាជ្ញាធរ ក្រុង ស្រុក បាន យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង ការពារ សុវត្ថិភាព ជូន ថ្នាក់ដឹកនាំ ប្រតិភូ រាជ រដ្ឋាភិបាល ភ្ញៀវ ជាតិ អន្តរជាតិ និង បងប្អូន ប្រជាពលរដ្ឋ ទទួលបាន នូវ លទ្ធផល ល្អ ប្រសើរ ដោយ ពុំ មាន ហេតុការណ៍ ណាមួយ កើតឡើង គួរឲ្យ កត់សម្គាល់ ឡើយ ។
ក្នុង នោះ ករណី បទល្មើស មាន ការថយចុះ ហើយ រាល់ សកម្មភាព បទល្មើស ដែល កើត មាន ឡើង កម្លាំង អាជ្ញាធរ បាន ធ្វើ ការបង្ក្រាប ទាន់ ពេល លទ្ធផល ល្អ ប្រសើរ ទាំង នេះ បាន បង្ហាញ នៅក្នុង ចលនា ប្រឡង ប្រណាំង ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ។ ជាក់ស្ដែង ចលនា ប្រឡង ប្រណាំង ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ខេត្ត កំពត បាន ជាប់ ចំណាត់ថ្នាក់ ទាំង ៩៣ / ៩៣ ឃុំ សង្កាត់ ក្នុង នោះ ចំណាត់ថ្នាក់ លេខ ១ មាន ចំនួន ៨២ ឃុំ សង្កាត់ ចំណាត់ថ្នាក់ លេខ ២ មាន ចំនួន ១១ឃុំ សង្កាត់ ៕
លោក លី ដែល ធ្លាប់ ជា អតីត អភិបាល ក្រុង សេអ៊ូល ចាប់ពី ឆ្នាំ ២០១០ ដល់ ឆ្នាំ ២០១៨ បាន បដិសេដ ថា មិន បាន ប្រព្រឹត្ត ខុស នោះ ទេ ។ តុលាការ ក្រុង សេអ៊ូល ត្រូវការ សំលេង គាំទ្រ ពី សភា ដែល មាន សមាជិក សរុប ចំនួន ៣០០ នាក់ ហើយ គណបក្ស ប្រជាធិបតេយ្យ កាន់ កាប់ ១៦៩ អាសនៈ នោះ ដើម្បី ដក អភ័យ ឯក សិទ្ធិ របស់ លោក លី ។ ចំណែក គណបក្ស ប្រឆាំង វិញ បាន ថ្កោលទោស ចំណាត់ការ របស់ រដ្ឋអាជ្ញា កូរ៉េ ខាងត្បូង ថា មាន ចេតនា នយោបាយ ។
