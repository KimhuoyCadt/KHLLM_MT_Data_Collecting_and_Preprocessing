( ភ្នំពេញ ) ៖ អាស៊ាន បាន បើក កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស រួម ជាមួយ អគ្គ លេខាធិការ របស់ ខ្លួន គឺ លោក កៅ គឹម ហួន នៅ ទីក្រុង ហ្សាការតា កាលពី ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២៣ សម្រាប់ ការពិភាក្សា ស្តីពី សន្ធិសញ្ញា តំបន់ គ្មាន អាវុធ នុយក្លេអ៊ែរ អាស៉ី អាគ្នេយ៍ (SEANWFZ) ។
ចិន ជា ប្រទេស មហា អំណាច ដំបូង គេ ដែល បាន ប្រកាស ស្ម័គ្រចិត្ត ចុះហត្ថលេខា លើ ពិធីសារ SEANWFZ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋ ន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា ក្នុង សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន បញ្ជាក់ ឡើងវិញ នូវ ការគាំទ្រ របស់ កម្ពុជា ចំពោះ ការស្ម័គ្រចិត្ត របស់ ចិន ក្នុង ការចុះហត្ថលេខា លើ ពិធីសារ នេះ មុន គេ ដោយ គ្មាន « ខបម្រុង » ហើយ ដូច បាន ស្នើ ដោយ ប្រធាន អាស៊ាន ការចុះហត្ថលេខា លើ ពិធីសារ ខាងលើ អាចនឹង ធ្វើឡើង ក្នុង អំឡុង ពេល កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤៣ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នៅ ខែកញ្ញា ឆ្នាំ នេះ ។
សន្ធិសញ្ញា នេះ ត្រូវបាន គេ ស្គាល់ ថា ជា សន្ធិសញ្ញា បាងកក (Bangkok Treaty ។ តាមរយៈ សន្ធិសញ្ញា នេះ ដែរ អាស៊ាន បញ្ជាក់ សារជាថ្មី អំពី សារៈសំខាន់ នៃ សន្ធិសញ្ញា ស្តីពី ការ មិន រីកសាយភាយ នៃ អាវុធ នុយក្លេអ៊ែរ (NPT) ក្នុង ការទប់ស្កាត់ ការរីកសាយភាយ អាវុធ នុយក្លេអ៊ែរ និង ក្នុង ការរួមចំណែក ឆ្ពោះ ទៅរក សន្តិភាព និង សន្តិសុខ អន្តរជាតិ ។
( កំពង់ធំ )៖ ប្រជាពលរដ្ឋ ឃុំ កំពង់ស្វាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ សូម ថ្លែងអំណរគុណ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ផ្ដល់ ផ្លូវ ក្រាល គ្រួស ក្រហម ប្រវែង ៥.៥០០ ម៉ែត្រ ទទឹង ៧ម៉ែត្រ តាមរយៈ លោក គុយ លាង គី និង លោកស្រី ឃួន ឃុន ឌី សមាជិក ព្រឹទ្ធសភា ដើម្បីឲ្យ ប្រជាពលរដ្ឋ សិស្សានុសិស្ស ធ្វើដំណើរ ទៅ សាលា និង ដឹក កសិផល ទៅកាន់ ទីផ្សារ បាន ស្រួល ។
ប្រជាពលរដ្ឋ សម្តែង ភាពសប្បាយរីករាយ ប្តេជ្ញា គាំទ្រ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី ១៨ ពិសេស បន្ត គាំទ្រ សម្ដេច តេជោ ហ៊ុន សែន ធ្វើជា រដ្ឋ នាយក រដ្ឋមន្ត្រី និង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា អ្នក បន្ត វេន ។
ក្រោម ដំបូល សន្តិភាព ប្រជាជន ទាំងអស់ រស់ នៅ ដោយ សុខសាន្ត មិន មាន ការភ័យខ្លាច ក្តីបារម្មណ៍ ផ្សេង ៗ ដែល ជា កត្តា សំខាន់ ក្នុង ការរស់នៅ ទទួលទាន ប្រចាំ ថ្ងៃ របស់ យើង ទាំងអស់ គ្នា ។ កាលណា ប្រទេសជាតិ មាន សុខ សន្តិភាព នោះ ហេដ្ឋារចនាសម្ព័ន្ធ ក៏ ត្រូវ មាន ការអភិវឌ្ឍ ជា បណ្ដើរ ៗ ដូច្នេះហើយ មាន តែ សុខ សន្តិភាព តែ មួយ គត់ ទើប មាន ការអភិវឌ្ឍ ហើយ សុខ សន្តិភាព នេះ គឺ មិន មាន អ្វី អាច មក ដោះដូរ បាន ឡើយ ។
ដូចនេះ សូម ពុក ម៉ែ បងប្អូន ទាំងអស់ ត្រូវ នាំគ្នា ជួយ ថែរក្សា នៅ សុខ សន្តិភាព នេះ ព្រមទាំង ប្តាជ្ញា ការពារ សុខ សន្តិភាព នេះ ឲ្យបាន ១០០ ភាគរយ ៕ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ដឹកនាំ គណៈប្រតិភូ គោរព វិញ្ញាណក្ខន្ធ សព ឧត្តមសេនីយ៍ ឯក ណេប សន
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ បាន ដឹកនាំ គណៈប្រតិភូ អគ្គ បញ្ជាការដ្ឋាន ដាក់ កម្រង ផ្កា គោរព វិញ្ញាណក្ខន្ធ សព ឧត្តមសេនីយ៍ ឯក ណេប សន នាយ រង សេនាធិការ ចំរុះ និង ជា នាយក ទី ចាត់ការចល នូប្បត្ថម្ភ អគ្គ បញ្ជាការ ដែល បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២៣ ក្នុង ជន្មាយុ ៦៦ ឆ្នាំ ដោយ រោគា ពាធ ។
ក្នុង នាម ថ្នាក់ដឹកនាំ អគ្គ បញ្ជាការ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន សំដែង ការចូលរួម រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ នៃ សព ចំពោះ ការបាត់បង់ ឧត្តម ស្វាមី ឪពុក ជា ទីស្រឡាញ់ និង ជា ការបាត់បង់ នាយ ទាហាន ជាន់ ខ្ពស់ មួយ រូប ដែល កន្លងមក បាន លះបង់ បូជា ជីវិត ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន ។
ជាមួយគ្នា នេះ ដែរ នាយ ឧត្តមសេនីយ៍ ក៏ បាន ឧទ្ទិស បួងសួង ឱ្យ ដួង វិញ្ញាណក្ខន្ធ សព ឧត្តមសេនីយ៍ ឯក ណេប សន បាន ទៅកាន់ សុគតិភព និង ឋាន បរម សុខ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម បញ្ជាក់ ថា សព ឧត្តមសេនីយ៍ ឯក ណេប សន ត្រូវបាន ក្រុមគ្រួសារ សហការ ជាមួយ ក្រុមការងារ រៀបចំ បុណ្យ សព បាន រៀបចំ តម្កល់ ធ្វើ បុណ្យ ទក្ខិណា នុប្បទាន ទៅ តាម ប្រពៃណី ពុទ្ធសាសនា និង ពិធី ការកងទ័ព នៅ គេហដ្ឋាន នៃ សព ស្ថិត នៅ ភូមិ កន្ទោក ខាងជើង សង្កាត់ កន្ទោក ខណ្ឌ កំបូល រាជធានី ភ្នំពេញ ៕ លោក បណ្ឌិត ម៉ា ឈឿន៖ បោះឆ្នោត ជូន បក្ស ប្រជាជន កម្ពុជា លេខរៀង ទី ១៨ ដើម្បី ការពារ សន្តិភាព សេរីភាព លទ្ធិ ប្រជាធិបតេយ្យ និង ការអភិវឌ្ឍ
( កំពង់ចាម ) ៖ លោក បណ្ឌិត ម៉ា ឈឿន តំណាងរាស្ត្រ មណ្ឌល កំពង់ចាម និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ ជួយ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម រួម ដំណើរ ជាមួយ ប្រធាន អនុប្រធាន ក្រុមការងារ គណបក្ស ស្រុក ជើង ព្រៃ នៅ ថ្ងៃទី ១៣ ខែ កក្កដា ឆ្នាំ ២០២៣ បាន ចុះ ជួបប្រជាពលរដ្ឋ ក្នុង ឃុំ ព្រៃ ចារ ចំនួន ១.០០០ នាក់ ក្នុង ឱកាស យុទ្ធនាការណ៍ ឃោសនា បោះឆ្នោត នីតិកាល ទី៧ នៅ បរិវេណ វត្ត ព្រៃ ចារ ក្នុង ឃុំ ព្រៃ ចារ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក បណ្ឌិត បាន ណែនាំឲ្យ ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត ឲ្យបាន ច្រើន កុះករ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ និង ទៅឲ្យបាន ទាន់ ពេលវេលា ដែល គ.ជ. ប បាន កំណត់ ហើយ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី ១៨ មាន រូប ទេវតា បាច ផ្កា ជា សម្គាល់ ដើម្បី ការពារ សន្តិភាព សេរីភាព លទ្ធិ ប្រជាធិបតេយ្យ និង ការអភិវឌ្ឍ ។
គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស ធំ ជាង គេ បាន បើក យុទ្ធនាការ ឃោសនា នៅ មជ្ឈមណ្ឌល ពិព័រណ៌ និង សន្និបាត កោះ ពេជ្រ ដោយ មាន សមាជិក សរុប ជាង ៧ម៉ឺន នាក់ ដឹកនាំ ផ្ទាល់ ដោយ សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន កិត្តិយស គណបក្ស ប្រជាជន កម្ពុជា និង សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ៕
( ភ្នំពេញ ) ៖ កម្មវិធី ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ គ្រុន ផ្តាសាយ ធំ វគ្គ ២ ជូន សមាជិក កិត្តិយស និង សមាជិក សាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ក្រសួង ព័ត៌មាន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នាទីតាំង ទីស្តីការ ក្រសួង ព័ត៌មាន ក្រោម វត្តមាន អញ្ជើញ ពិនិត្យ ផ្ទាល់ ដោយ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន និង លោកស្រី សាស្រ្តាចារ្យ ឱសថ បណ្ឌិត ខៀវ ទេព រង្សី កាញារីទ្ធ ប្រធាន កិត្តិយស សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ សាខា ក្រសួង ព័ត៌មាន ។
តាម ការបញ្ជាក់ របស់ លោកស្រី ឆៃ ច័ន្ទ រិទ្ធី សូលីដា រដ្ឋលេខាធិការ និង ជា សមាជិក កិត្តិយស សមាគម នារី ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ សាខា ក្រសួង ព័ត៌មាន បាន ជម្រាប ជូន ពី ដំណើរការចាក់ វ៉ាក់សាំង ផ្តាសាយ ធំ ប្រភេទ A វគ្គ ២ នា ឧកាស នេះ ធ្វើឡើង ដោយ មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ពីសំណាក់ លោក រដ្ឋមន្រ្តី ខៀវ កាញារីទ្ធ និង លោកស្រី សាស្រ្តាចារ្យ ឱសថ បណ្ឌិត ខៀវ ទេព រង្សី កាញ្ញារីទ្ធ ដល់ ថ្នាក់ដឹកនាំ ជា នារី សមាជិក កិត្តិយស សមាជិក សមាជិកា សមាគម ដែល ស្ម័គ្រចិត្ត ទទួល យក វ៉ាក់ ទាំង វគ្គ ១ និង វគ្គ ២។
ដូច្នេះ វ៉ាក់សាំង ដែល យកមក ចាក់ ជូន នា ពេលនេះ នឹង រួមចំណែក កាត់បន្ថយ ហានិភ័យ នៃ ការឆ្លង ជំងឺ ផ្តាសាយ ធំ ប្រភេទ A តែ ទោះជា យ៉ាងណា ក៏ ត្រូវ ថែរក្សា និង ការពារ សុខភាព ដោយ ផ្ទាល់ខ្លួន ឯង និង ក្រុមគ្រួសារ អោយ បាន ល្អ បន្ថែម ទៀត ផងដែរ ។
សរុប ចំនួន អ្នក ដែល បាន មក ទទួល វ៉ាក់សាំង ការពារ ជំងឺ គ្រុន ផ្តាសាយ ធំ វគ្គ ២ ជា ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ សាខា ក្រសួង ព័ត៌មាន មាន ចំនួន ១៤០ ដូស ៕
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បេក្ខភាព នាយក រដ្ឋមន្ត្រី នា ពេល អនាគត នៃ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ បាន ចេញ វីដេអូ មួយ ដោយ ធ្វើ ការប្រៀបធៀប ពី ភាពខុសគ្នា ចំនួន ៣ ចំណុច រវាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក សម រង្ស៉ី ដែល ជា មេដឹកនាំ ក្រុម ឧទ្ទាម កំពុង រស់ នៅ ក្រៅ ស្រុក ។
៣ចំណុច ដែល លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ធ្វើ ការប្រៀបធៀប ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ពិចារណា រួម មាន៖
ទី ១៖ សម្តេច តេជោ ហ៊ុន សែន ខ្លាច ប្រទេស មាន សង្គ្រាម និង ខ្លាច ប្រទេស អស្ថិរភាព ខណៈ លោក សម រង្ស៉ី ខ្លាច ប្រទេស មាន ស្ថិរភាព ទើប បានជា លោក តែងតែ អំពាវនាវ ឲ្យ មាន ការបះបោរ ។
ទី ២៖ សម្តេច តេជោ ហ៊ុន សែន ខ្លាច ប្រជាពលរដ្ឋ អត់ មាន ការងារ ធ្វើ បានជា ខិតខំ ជំរុញ ឲ្យ គេ មក វិនិយោគ និង បង្កើត ការងារ ខណៈ លោក សម រង្ស៉ី ខ្លាច ប្រជាពលរដ្ឋ មាន ការងារ ល្អ បែរជា ទៅ អំពាវនាវ ឲ្យ បរទេស ដាក់ទណ្ឌកម្ម សេដ្ឋកិច្ច ក៏ ដូចជា ផ្តាច់ EBA និង GSP ។
ទី ៣៖ សម្តេច តេជោ ហ៊ុន សែន ខ្លាច ប្រជាពលរដ្ឋ ស្លាប់ ដោយសារ កូវី ដ១៩ បានជា ខិតខំ រក វ៉ាក់សាំង និង ដាក់ចេញ នូវ យន្តការ នានា តែ លោក សម រង្ស៉ី មិន ដែល អំពាវនាវ ឲ្យ បរទេស ផ្តល់ ជំនួយ វ៉ាក់សាំង ដល់ កម្ពុជា ទេ ពោល គិត តែ បន្ត អំពាវនាវ ឲ្យ បរទេស ដាក់ទណ្ឌកម្ម លើ កម្ពុជា ៕
សូម ទស្សនា វីដេអូ នៃ ការលើកឡើង របស់ បណ្ឌិត ហ៊ុន ម៉ាណែត ទាំងស្រុង ដូច ខាងក្រោម៖
លោក ប៉ាន សូរស័ក្តិ បន្ត ចុះ ជួប សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ឃុំ ស្រង៉ែ ស្រុក ព្រៃឈរ ដើម្បី ផ្សព្វផ្សាយ កម្មវិធី នយោបាយ របស់ បក្ស និង ណែនាំ អំពី របៀប គូស សន្លឹក ឆ្នោត គាំទ្រ បក្ស ប្រជាជន កម្ពុជា
( កំពង់ស្ពឺ ) ៖ ក្នុង ពិធី សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ក្នុង យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត នៅក្នុង ឃុំ វាល ពន់ ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ នា ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា បាន ការគាំទ្រ យ៉ាង ស្ម័គ្រស្មោះ ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ។
អ្នក មីង អៀម កាន បាន បង្ហាញ ពី ការដឹង គុណ បំណាច់ ដល់ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន នាំ កម្ពុជា ចេញ ពី ភ្លើង សង្គ្រាម ហើយ នាំមក នូវ វឌ្ឍនភាព ជា បន្តបន្ទាប់ ។ បើ គ្មាន គណបក្ស ប្រជាជន កម្ពុជា ប្រជាជន ទាំងអស់ ក៏ ដូចជា កូន ចៅ អ្នក មីង ក៏ មិន មាន ថ្ងៃ នេះ ដែរ ។
អ្នក មីង បន្ត ថា « យើង ទាំងអស់ គ្នា មិន ចង់ឱ្យ កម្ពុជា ធ្លាក់ ក្នុង ភ្លើង សង្គ្រាម មាន ការកាប់ សម្លាប់ ដូច របប ប្រល័យ ពូជសាសន៍ នោះ ទេ ។ ដូច្នេះ យើង នឹង បន្ត បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បីឱ្យ កូន ចៅ យើង ជំនាន់ ក្រោយ អាច បន្ត ជ្រក ក្រោម ដំបូល សន្តិភាព និង ភាពសម្បូរសប្បាយ » ។
« ឯករាជ្យភាព ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន នាំឱ្យ ក្មេង ៗ ជំនាន់ ក្រោយ មាន ឱកាស បាន រៀនសូត្រ បាន ដោយ ស្មើភាព ដែល បាន មកពី ការរីក ដុះដាល នៃ សាលារៀន គ្រប់ កម្រិត ថ្នាក់ ។ នេះ ជា មូលដ្ឋាន ដែល ធានា ឱ្យ កូន ចៅ តូច ៗ មាន ចំណេះដឹង មាន អនាគត ល្អ ដើម្បី ជួយ ជីវភាព ក្រុមគ្រួសារ និង សង្គមជាតិ ទាំងមូល » ។ នេះ ជា ការលើកឡើង របស់ អ៊ំ ស្រី ប្រាក់ សុខ លីម សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ម្នាក់ ទៀត ក្នុង ជំនួប ព្រឹក នេះ ។
( បាត់ដំបង ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ប្រធាន ក្រុមការងា រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត បាត់ដំបង នា ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការអគារ សិក្សា ថ្មី ១ខ្នង កម្ពស់ ២ជាន់ ចំនួន ១២ បន្ទប់ នៃ អនុវិទ្យាល័យ ព្រែក នរិទ្ទ ស្ថិត នៅ ឃុំ ព្រែក នរិន្ទ ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ។
សម្ដេច ក្រឡាហោម ស ខេង បាន ថ្លែង ថា យោង តាម របាយការណ៍ របស់ លោក អភិបាល ស្រុក បាន លើកឡើង ថា សមិទ្ធផល ដែល ដាក់ សម្ពោធ នា ពេលនេះ បាន ចំណាយ ថវិកា សរុប ចំនួន ២០ ម៉ឺន ដុល្លារ ហើយ ថវិកា ដែល បាន ចំណាយ នេះ បាន មក ពី ការចូលរួម បរិច្ចាគ ធនធាន ផ្ទាល់ខ្លួន របស់ ក្រុមការងា រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក ឯក ភ្នំ និង សប្បុរសជន ក្នុង ស្រុក និង ក្រៅ ស្រុក ផងដែរ ។
សម្ដេច បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក ឯក ភ្នំ និង សប្បុរសជន នានា ដែល បាន បរិច្ចាគ នូវ ធនធាន ជាច្រើន និង លះបង់ កម្លាំង កាយ ចិត្ត បញ្ញា ស្មារតី ក្នុង ការចូលរួម អភិវឌ្ឍ វិស័យ អប់រំ និង វិស័យ ផ្សេង ៗ ជាច្រើន ទៀត ដើម្បី អភិវឌ្ឍ មូលដ្ឋាន ស្រុក ឯក ភ្នំ ។
នា ឱកាស នោះ សម្ដេច ក្រឡាហោម ស ខេង បាន លើកឡើង ថា តាមរយៈ ជោគជ័យ នៃ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា បាន ធ្វើឱ្យ ប្រទេសជាតិ ទទួលបាន សុខ សន្តិភាព ឯកភាព ជាតិ ឯកភាព ទឹកដី ទាំងស្រុង ចាប់ពី ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ដែល បាន ផ្តល់ នូវ កាលានុវត្តភាព ដ៏ ធំធេង សម្រាប់ ការអភិវឌ្ឍ ប្រទេសជាតិ រហូតមកដល់ បច្ចុប្បន្ន និង តទៅ អនាគត ។
សម្ដេច ក្រឡាហោម បាន គូសបញ្ជាក់ ថា « សន្តិភាព គឺជា មូលដ្ឋានគ្រឹះ សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព លើ គ្រប់ វិស័យ ។ បើ គ្មាន សន្តិភាព គឺ ពុំ មាន ការអភិវឌ្ឍ ដូច បច្ចុប្បន្ន នេះ ឡើយ » ។
សម្ដេច ក្រឡាហោម បន្ដ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន បន្ត ថែរក្សា សន្តិសុខ ស្ថិរភាព នយោបាយ សណ្តាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាពសង្គម បាន រឹងមាំ ដែល ធានា បាន ប្រក្រតីភាព នៃ ការប្រព្រឹត្តទៅ នៃ ស្ថាប័ន ជាតិ ទប់ស្កាត់ ការប៉ុនប៉ង បង្ក ចលាចល វឹកវរ ក្នុង សង្គម ធានា ភាព សុខសាន្ត របស់ ប្រជាជន ដោយ ចាត់ទុក ការងារ ទាំង នេះ ជា ការងារ អាទិភាព ។
ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល ក៏ បាន យកចិត្តទុកដាក់ លើកកម្ពស់ ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ដើម្បី លើកកម្ពស់ ការចូលរួម របស់ ប្រជាពលរដ្ឋ ក្នុង ការធានា រក្សា សន្តិសុខ សុវត្ថិភាព នៅ តាម ភូមិ - ឃុំ - សង្កាត់ ទូទាំង ប្រទេស ។
ជាមួយគ្នា នេះ សម្ដេច ក្រឡាហោម ស ខេង ក៏ បាន ណែនាំ ដល់ សមត្ថកិច្ច ត្រូវ ខិតខំ ធ្វើ អំពើ ល្អ ក្នុង សង្គម ត្រូវ រួមគ្នា ពង្រឹង យុត្តិធម៌ សង្គម ខិតខំ លើកកម្ពស់ ការបម្រើ សេវា សាធារណៈ និង ដោះស្រាយ សំណើ សំណូមពរ នូវ សេចក្ដីត្រូវការ ជូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ប្រកបដោយ តម្លាភាព គណនេយ្យភាព និង មិន មាន ការរើសអើង ។
ឆ្លៀត ឱកាស នោះ សម្ដេច ក្រឡាហោម ស ខេង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ទាំងអស់ សូម ត្រៀមខ្លួន ឱ្យ បាន ល្អ ត្រឹមត្រូវ ដើម្បី ទៅ ចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ឱ្យ បាន គ្រប់ ៗ គ្នា ៕
លោក ប៉ាន សូរស័ក្តិ អំពាវនាវ ពលរដ្ឋ នៅ ឃុំ សំរោង ស្រុក ព្រៃឈរ បន្ត បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បន្ត រក្សា ការពារ សុខ សន្តិភាព ការអភិវឌ្ឍ និង បង្ហាញ ការដឹង គុណ ចំពោះ ការសង្រ្គោះ ពលរដ្ឋ ចេញ ពី របប វាល ពិឃាដ
ការអំពាវនាវ នេះ ធ្វើឡើង នា ឱកាស ដែល លោក ដឹកនាំ សហការី ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ឃុំ សំរោង ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម ប្រមាណ ជាង ៤៩២ នាក់ ដើម្បី ធ្វើ ការណែនាំ ខ្លួន . ផ្សព្វផ្សាយ កម្មវិធី នយោបាយ គណបក្ស និង បង្ហាញ អំពី របៀប គូស សន្លឹក ឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា ។
ជាមួយគ្នា នេះ លោក បាន សម្ដែង នូវ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី សម្រាប់ នីតិកាល ទី៧ នៃ រដ្ឋសភា ឆ្នាំ ២០២៣ និង គាំទ្រ លោក ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី សម្រាប់ ពេល អនាគត ។
សាកលវិទ្យាល័យ ការពារ ជាតិ ទទួល ដំណើរទស្សនកិច្ច ផ្លូវការ របស់ គណៈប្រតិភូ និស្សិត នាយ ទាហាន អនុវត្ត តាម បទបញ្ជា របស់ សម្តេច ពិជ័យ សេនា
នៅក្នុង ជំនួយ ដែល មាន សមាសភាព ៦០ + ៦០ នាក់ គណៈប្រតិភូ ចិន បាន ស្តាប់ បទ ស្វាគមន៍ និង បទបង្ហាញ ពី តួនាទី ភារកិច្ច របស់ ស.ក . ជ ពី នាយ ឧត្តមសេនីយ៍ សាស្រ្តាចារ្យ ជា តារា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ទទួលបន្ទុក ជា សាកលវិទ្យាធិការ សាកលវិទ្យាល័យ ការពារ ជាតិ និង បាន ផ្លាស់ប្តូរ ទស្សនៈ គ្នា ទៅ វិញ ទៅមក ដោយ ស .ក . ជ យោង ទៅ លើ ប្រធានបទ មួយ ចំនួន ។
ភាគី ចិន៖ បាន សម្តែង នូវ ក្តី សប្បាយរីករាយ ចំពោះ ជំនួប ជា លើក ទី១ ក្រោយពេល សាកលវិទ្យាល័យ ការពារ ជាតិ ទាំង ពីរ កម្ពុជា - ចិន បាន ចុះ អនុស្សារណៈ យោគយល់ (MOU) ជាមួយគ្នា ក្នុង ដំណាក់កាល កូវីដ ១៩ ។ ភាគី ចិន បាន ឆ្លើយ នូវ សំណួរ យោធាចារ្យ របស់ យើង ពាក់ព័ន្ធ ការបណ្តុះបណ្តាល ហ្វឹកហ្វឺន បំប៉ន ដល់ វិស័យ ការពារ ជាតិ ។
បន្ទាប់មក មាន កិច្ចប្រជុំ ចង្អៀត រវាង ថ្នាក់ដឹកនាំ ភាគី ទាំង២ ដែល មាន ១៦+ ១៦នាក់ ដើម្បី ពិនិត្យមើល សំណើ របស់ ស .ក . ជ កម្ពុជា ស្នើសុំ សាកលវិទ្យាល័យ ការពារ ជាតិ នៃ កងទ័ព រំដោះ ប្រជាជន ចិន ជា បងប្អូន ជួយ ដល់ ការអភិវឌ្ឍន៍ ការបណ្តុះបណ្តាល ធនធាន មនុស្ស ក្នុង វិស័យ ការពារ ជាតិ ដូចជា សំណើ សម្រួល ឲ្យ មាន ទស្សនកិច្ច សិក្សា ដក បទពិសោធន៍ ទៅ វិញ ទៅ មក រវាង ថ្នាក់ដឹកនាំ នាយ ទាហាន ជាន់ ខ្ពស់ សាស្ត្រាចារ្យ យោធាចារ្យ និង និស្សិត នៃ សាកលវិទ្យាល័យ ប្រទេស ទាំង ពីរ ។
សំណើ សុំ ជួយ សម្រួល បើក ថ្នាក់ បង្រៀន ភាសា ចិន កម្រិត មូលដ្ឋាន សម្រាប់ និស្សិត និង សិក្ខាកាម កម្ពុជា មុន ទៅ បន្ត ការសិក្សា នៅ ប្រទេស ចិន និង សុំ អាហារូបករណ៍ ថ្នាក់ បរិញ្ញាបត្រ ភាសា ចិន នៅ ប្រទេស ចិន និង សំណើ ចាំបាច់ មួយ ចំនួន ទៀត សំដៅ លើ ការងារ បណ្តុះបណ្តាល ធនធាន មនុស្ស ក្នុង វិស័យ ការពារ ជាតិ ។
ភាគី ចិន បាន ទទួលយក នូវ សំណើ របស់ សាកលវិទ្យាល័យ ការពារ ជាតិ កម្ពុជា មួយចំនួន សម្រេច ភ្លាម ៗ និង មួយចំនួន ទៀត នឹង ដាក់ ជូន សុំ ការសម្រេច ពី ក្រសួង ការពារ ប្រទេស ចិន ។ ក្នុង ឱកាស នោះ ដែរ លោក ស៊ាវ ធាន លៀង និង ប្រតិភូ បាន ដាំ ឈើ ប្រណិត ( ដើម នាង នួន មួយ ដើម ) ទុក ជា អនុស្សរីយ៍ នៅ សាកលវិទ្យាល័យ ការពារ ជាតិ យើង ផងដែរ ។
ក្រោយ ជំនួប ពិភាក្សា បាន បញ្ចប់ នៅ ម៉ោង ១១និង ៣០នាទី សាកលវិទ្យាល័យ ការពារ ជាតិ កម្ពុជា បាន អញ្ជើញ គណៈប្រតិភូ ចិន ទាំង ៥៤ រូប រួម និង អនុព័ន្ធ យោធា ពិសារ បាយ សាមគ្គី រហូតដល់ ម៉ោង ១៣ ក្រោម បរិយាកាស មិត្តភាព កិច្ចសហប្រតិបត្តិការ ល្អ រីករាយ និង ស្និទ្ធស្នាល ក្រៃលែង ។
លោកស្រី ម៉ារស៊ូឌី បាន គូសបញ្ជាក់ ថា « មាន តែ ពេល នោះ ទេ ដែល យើង អាច សម្រេចបាន នូវ កិច្ចសហប្រតិបត្តិការ ឈ្នះ - ឈ្នះ ដើម្បី ជា ប្រយោជន៍ ដល់ ការបង្កើត សន្តិភាព ស្ថិរភាព និង វិបុលភាព រួមគ្នា នៅក្នុង តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក » ។ ចំណែក លោក វ៉ាង ក៏ បាន គូសបញ្ជាក់ ផងដែរ ថា « ដោយ មើលឃើញ ពី ការផ្លាស់ប្តូរ ដ៏ ស្មុគស្មាញ និង ស៊ីជម្រៅ នៃ ស្ថានភាព អន្តរជាតិ និង តំបន់ ចិន បាន ត្រៀម ខ្លួន ជាស្រេច ក្នុង ការធ្វើការ ជាមួយ អាស៊ាន ដើម្បី ធ្វើឲ្យ ប្រសើរឡើង នូវ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី » ។
នាយ ឧត្តមសេនីយ៍ គៀត ច័ន្ទ ថា រិទ្ធ ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ឧបាសិកា លី ប៉េង គី ម្ដាយ បង្កើត នាយ ឧត្តមសេនីយ៍ កែវ វណ្ណ ថន
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ គៀត ច័ន្ទ ថា រិទ្ធ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ ឧបាសិកា លី ប៉េង គី ម្ដាយ បង្កើត របស់ នាយ ឧត្តមសេនីយ៍ កែវ វណ្ណ ថន អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ ។
នាយ ឧត្តមសេនីយ៍ គៀត ច័ន្ទ ថា រិទ្ធ បាន បញ្ជាក់ ថា « ខ្ញុំ និង ភរិយា ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រី នគរបាល នៃ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ មាន សេចក្តីក្តុកក្តួល រន្ធត់ តក់ស្លុត និង សោកស្ដាយ ឥត ឧបមា ចំពោះ ដំណឹង ដ៏ ក្រៀមក្រំ មរណភាព របស់ ឧបាសិកា លី ប៉េង គី ត្រូវ ជា ម្តាយ របស់ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ដែល ឧបាសិកា បាន ទទួលមរណភាព នា ថ្ងៃចន្ទ ៨រោច ខែ បឋម សាឍ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៧៖ ០៥ នាទី ក្នុង ជន្មាយុ ៩៤ ឆ្នាំ ដោយ ជរា ពាធ ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ដំណាក់ លោក លោកស្រី ជា អនុប្រធាន និង សមាជិក ក្រុមការងារ ចុះ ជួយ ស្រុក មោង ឫស្សី . ប្រធាន អនុប្រធាន និង សម ជិក នៃ ក្រុមការងារ ចុះ ជួយ តាម បណ្តា ឃុំ ទាំង ៩ នៃ ស្រុក មោង ឫស្សី . អាជ្ញាធរ ស្រុក ប្រជាពលរដ្ឋ យុវជន និង សិស្សានុសិស្ស ប្រមាណ ជាង ១២០០ នាក់ ។
លោក អង្គ វង្ស វឌ្ឍនា បាន មាន គូសបញ្ជាក់ ថា យុទ្ធនាការ « បៃតង សន្តិភាព មោង ឫស្សី » នេះ ត្រូវបាន រៀបចំឡើង ក្នុង ពេល ដែល ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ពេញ បរិបូរណ៍ និង មាន ការអភិវឌ្ឍ ឥត ឈប់ឈរ ។ កត្តា សន្តិភាព នេះ បាន ផ្តល់ ឱកាស ឱ្យ ក្រុមការងារ ចុះ ជួយ ស្រុក មោង ឫស្សី អាច រៀបចំ នូវ ព្រឹត្តិការណ៍ ជាច្រើន នៅក្នុង ស្រុក មោង ឫស្សី នា ពេល កន្លងមក និង រួមទាំង ព្រឹត្តិការណ៍ យុទ្ធនាការ « បៃតង សន្តិភាព មោង ឫស្សី » ។
លោក ក៏ បាន ស្នើ ឱ្យ ប្រជាពលរដ្ឋ ក្នុង ស្រុក មោង ឫស្សី ទាំងអស់ រួម សាមគ្គី គ្នា បន្ត ចូលរួម ការពារ និង ថែរក្សា សន្តិភាព កម្ពុជា ឱ្យ បាន គង់វង្ស ដើម្បីឱ្យ កម្ពុជា មាន ការអភិវឌ្ឍ បន្ត ទៅ មុខ ទៀត ។
ក្នុង ឱកាស នេះ ផងដែរ លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ និង ជា អនុប្រធាន ទី១ ក្រុមការងារ ចុះ ជួយ ស្រុក មោង ឫស្សី ក៏ បាន បញ្ជាក់ អំពី គោលបំណង នៃ ការបង្កើត ឱ្យ មាន យុទ្ធ ការ « បៃតង សន្តិភាព មោង ឫស្សី » នេះ ផងដែរ ថា ព្រឹត្តិការណ៍ នេះ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ចំនួន ៣សំខាន់ ៗ រួម មាន៖
ទី១៖ ដើម្បី ចូលរួម អបអរសាទរ ពិធី « រុក្ខ ទិវា ៩ កក្កដា » ឆ្នាំ ២០២៣ ដែល ទើប រៀបចំឡើង នៅ ខេត្ត កំពង់ឆ្នាំង ក្រោម ព្រះរាជា ធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា
ទី២៖ ដើម្បីឱ្យ ស្រុក មោង ឫស្សី មាន ទេ សភាព កាន់តែ ស្រស់ស្អាត ជាមួយនឹង ធម្មជាតិ ពណ៌ បៃតង និង ពណ៌ ក្រហម ឆ្អិនឆ្អៅ នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៥ និង តាម បណ្តោយ ផ្លូវ នានា តាម ភូមិ ឃុំ ព្រមទាំង ទី កន្លែង សាធារណៈ ផ្សេង ទៀត ក្នុង ភូមិសាស្ត្រ នៃ ស្រុក មោង ឫស្សី
និង ទី៣៖ ដើម្បី បំផុត ទឹកចិត្ត និង ស្មារតី ប្រជាពលរដ្ឋ ក្នុង ស្រុក មោង ឫស្សី និយាយ ជា រួម និង យុវជន ស្រុក មោង ឫស្សី និយាយ ដោយឡែក ឱ្យ ចេះ ស្រឡាញ់ បរិស្ថាន តាមរយៈ ការ មិន កាប់ ដើមឈើ ប៉ុន្តែ ថែមទាំង ចូលរួម ដាំ ដើមឈើ ឡើងវិញ ផងដែរ ។
លោក ក៏ បាន ស្នើ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ជាពិសេស យុវជន សូម ចូលរួម យុទ្ធនាការ នេះ ឱ្យ បាន ទាំងអស់ គ្នា ដើម្បី បង្កើន សម្រស់ ស្រុក មោង ឫស្សី ឱ្យ មាន ភាពស្រស់បំព្រង នៅពេល អនាគត ដែល នេះ ជា មោទនភាព សម្រាប់ ខ្លួន ឯង និង កូនចៅ ជំនាន់ ក្រោយ នៃ អ្នកស្រុក មោង ឫស្សី ។
បន្ថែម ពី នេះ លោក កើត រិទ្ធ បាន ស្នើ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង ស្រុក មោង ឫស្សី ត្រូវ ចេះដឹង គុណ អ្នក ដែល បាន ខិតខំ កសាង នូវ សមិទ្ធផល នានា នា ពេល បច្ចុប្បន្ន នេះ និង ជាពិសេស គឺ សុខ សន្តិភាព ដែល កម្ពុជា មាន សព្វ ថ្ងៃ តាមរយៈ ការធ្វើ ពលិកម្ម គ្រប់ បែបយ៉ាង របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ឆ្លៀង ក្នុង ឱកាស នេះ ដែរ លោក កើត រិទ្ធ ក៏ បាន ថ្លែងអំណរគុណ លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន ដែល បាន ផ្តល់ កូន ឈើ ដល់ ក្រុមការងារ ចុះ ជួយ ស្រុក មោង ឫស្សី សម្រាប់ រៀបចំ យុទ្ធនាការ នេះ ព្រមទាំង បាន ថ្លែង អំណរគុណ ដល់ ស្ថាប័ន ពាក់ព័ន្ធ ដែល បាន សហការ និង ក្រុមការងារ ចុះ ជួយ ស្រុក មោង ឫស្សី ដែល បាន ខិតខំ ទាំង ថ្ងៃ ទាំង យប់ ដើម្បី រៀបចំ ព្រឹត្តិការណ៍ នេះ ។
ជុំវិញ យុទ្ធនាការ « បៃតង សន្តិភាព មោង ឫស្សី » នេះ ប្រជាលរដ្ឋ សិស្សានុសិស្ស ក្នុង មូលដ្ឋាន ស្រុក មោង ឫស្សី ដែល បាន ចូលរួម ក្នុង យុទ្ធនាការ បាន បង្ហាញ ការសាទរ និង សប្បាយរីករាយ យ៉ាង ខ្លាំង ដែល ឃើញ ក្រុមការងារ ចុះ ជួយ ស្រុក មោង ឫស្សី បាន ផ្តួចផ្តើម នាំ កូន ឈើ មក ដាំ នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៥។ ចំណុច នេះ បាន បង្ហាញ ឱ្យ ឃើញ ពី ការខិតខំ យកចិត្ត ដាក់ គ្រប់ បែបយ៉ាង របស់ ក្រុមការងារ ដើម្បី បម្រើ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ។
( កណ្ដាល ) ៖ លោក ស៊ុយ ឆៃ លាង អតីត សកម្មជន គណបក្ស ភ្លើង ទៀន បាន ថ្លែង ពី គុណសម្បត្តិ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល ខិតខំ កសាង ប្រទេសជាតិ ពី ផេះ ផង់ មក ស្គាល់ ពី ការរីកចម្រើន ពិសេស គឺ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឱ្យ ទៅ ចូលរួម បោះឆ្នោត និង គូស សន្លឹក ឆ្នោត ឱ្យ បាន ត្រឹមត្រូវ ហើយ កុំ ជឿ ទៅ លើ ការញុះញង់ របស់ ក្រុម អគតិ មួយចំនួន ដែល ញុះ ឱ្យ បងប្អូន គូស សន្លឹក ឆ្នោត ដែល ផ្ទុយទៅនឹង ការណែនាំ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប) ។
ខាងក្រោម នេះ ជា វីដេអូ របស់ អតីត សកម្មជន គណបក្ស ភ្លើង ទៀន ប្រចាំ ខេត្ត កណ្ដា ល៖ បទ អត្ថាធិប្បាយ៖ ហេតុ អ្វី បានជា កិច្ចប្រជុំ កំពូល នៃ អង្គការ ណា តូ បង្ក រឿង ហេតុ ទៅ លើ ចិន ជារឿយ ៗ ?
គិត រហូតដល់ បច្ចុប្បន្ន នេះ ក្រោម កម្លាំង សម្ពាធ របស់ វ៉ាស៊ីនតោន អង្គការ ណា តូលែង ជា អ្នកតំណាង របស់ សន្តិសុខ អឺរ៉ុប យូរ ហើយ តែ បាន ក្លាយជា អ្នកគាំពារ ផលប្រយោជន៍ របស់ អាមេរិក រួចទៅហើយ ។ រីឯ អង្គការ ណា តូ ដែល ប៉ិនប្រសប់ ក្នុង ការបង្ក “ សត្រូវ ស្រមើស្រមៃ ” ទើប ជា “ ការប្រកួតប្រជែង ជា ប្រព័ន្ធ ” ដែល ពិភពលោក ទាំងមូល ត្រូវ ប្រុងប្រយ័ត្ន បំផុត ។
សូម យក វិបតិ្ត អ៊ុយក្រែន ជា ឧទាហរណ៍ បន្ទាប់ កើតមាន វិបតិ្ត អាមេរិក បាន ជំរុញ ឱ្យ រដ្ឋ សមាជិក អង្គការ ណា តូដឹ កជញ្ជូន អាវុធ ជាច្រើន ទៅកាន់ អ៊ុយក្រែន បណ្តាលឱ្យ ស្ថានការណ៍ ឡើង កម្តៅ ជា បន្តបន្ទាប់ ។ សង្គ្រាម លើក នេះ បាន កើតឡើង នៅ ទឹកដី អឺរ៉ុប ហើយ រដ្ឋ សមាជិក អង្គការ ណា តូ ភាគ ច្រើន គឺជា ប្រទេស អឺរ៉ុប ជា ការធម្មតា ណាស់ ក៏ ជា ប្រទេស រងគ្រោះ ដោយ ផ្ទាល់ ពី សង្គ្រាម លើក នេះ ផងដែរ ។ ប្រទេស ទាំងនេះ គ្រវី ទង់ ជួយ ស្រែក បន្ទរ ឱ្យ អាមេរិក ប៉ុន្តែ ខ្លួន បាន រង ការខូចខាត យ៉ាង ធ្ងន់ធ្ងរ ។
( ស្វាយរៀង ) ៖ លោក ព្រំ ជា អតីត សមាជិក ក្រុមប្រឹក្សា ស្រុក ចន្ទ្រា និង ជា ក្រុមការងារ ចុះ ជួយ ខេត្ត ស្វាយរៀង របស់ អតីត គណបក្ស សង្គ្រោះ ជាតិ បាន នាំ ក្រុមគ្រួសារ របស់ លោក មក សុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដោយ គ្មាន ការបង្ខិតបង្ខំ ។
លោក ព្រំ ជា និង ក្រុមគ្រួសារ បាន ស្នើសុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា តាមរយៈ លោក ម៉ឹង សំផន ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ចន្ទ្រា ។
លោក បាន ថ្លែង ថា បន្ទាប់ពី បាន តាមដាន ដោយ យកចិត្តទុកដាក់ អំពី ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង បាន វាយតម្លៃ ខ្ពស់ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ទេ ដែល មាន ឧត្តម គតិ ត្រឹមត្រូវ និង មាន គុណ បំណាច់ យ៉ាង ធំធេង ចំពោះ ជាតិ មាតុភូមិ និង មន្ត្រី ពោរពេញ ដោយ សមត្ថភាព បទពិសោធន៍ ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រធាន គណបក្ស ។
បន្ថែម លើស ពី នេះ លោក ព្រំ ជា បាន គាំទ្រ ទាំងស្រុង នូវ គោល នយោបាយ និង លក្ខន្តិកៈ របស់ គណបក្ស ប្រជាជន កម្ពុជា ហើយ ការចូលរួម ជីវភាព នយោបាយ នេះ គឺ ពុំ មាន ការបង្ខិតបង្ខំ នោះ ទេ ជា ការស្ម័គ្រចិត្ត របស់ លោក និង ក្រុមគ្រួសារ ។
ជាមួយគ្នា នេះ លោក មុឹង សំផន ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ចន្ទ្រា បាន ស្វាគមន៍ ចំពោះ ការចូលរួម ជីវភាព នយោបាយ របស់ លោក ព្រំ ជា និង ក្រុមគ្រួសារ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ចូលរួមចំណែក អភិវឌ្ឍន៍ មូលដ្ឋាន ឲ្យ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ក្រោម ដំបូល នៃ សុខ សន្តិភាព ។
( កំពង់ធំ )៖ លោក ជា ចាន់តូ សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ បាន អំពាវនាវ ដល់ សមាជិក សមាជិកាបក្ស ប្រជាជន ទាំងអស់ ឲ្យ បន្ត គាំទ្រ និង ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ធានា សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ ជាតិ ។
ការអំពាវនាវ របស់ លោក ជា ចាន់តូ ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ បន្ត ចុះ ឃោសនា រក សម្លេង ឆ្នោត នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ អណត្តិ ទី៧ និង ការបង្រៀន គូស សន្លឹក ឆ្នោត ដល់ សមាជិក សមាជិកា បក្ស នៅ សង្កាត់ ស្រយ៉ូវ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ នា ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ ។
អភិបាល ខេត្ត កែប៖ គោល នយោបាយ ដីធ្លី របស់ រាជ រដ្ឋាភិបាល គឺ សំដៅ កាត់បន្ថយ ភាពក្រីក្រ . ទំនាស់ ដីធ្លី នៅក្នុង សង្គម និង ជួយ ដល់ ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន
( កែប )៖ លោក បណ្ឌិត សោម ពិសិដ្ឋ អភិបាល ខេត្ត កំពត បាន ថ្លែង ថា គោល នយោបាយ ដីធ្លី របស់ រាជ រដ្ឋាភិបាល គឺ សំដៅ កាត់បន្ថយ ភាពក្រីក្រ . កាត់បន្ថយ ទំនាស់ ដីធ្លី នៅក្នុង សង្គម និង ជួយ ដល់ ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ។
ការថ្លែង បែប នេះ ខណៈ លោក អភិបាល ខេត្ត សោម ពិសិដ្ឋ បាន ចូលរួម ជា គណៈអធិបតី ក្នុង ពិធី ប្រកាស កំណត់ តំបន់ វិនិច្ឆ័យ ចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ដែល ពិធី នេះ បាន រៀបចំ ប្រព្រឹត្ត ធ្វើឡើង នៅក្នុង ភូមិ ចំការ បី ឃុំ ពង ទឹក ស្រុក ដំណាក់ ចង្អើរ ខេត្ត កែប នា ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ ដោយ ចូលរួម ពីសំណាក់ អភិបាល រង ខេត្ត ជួរ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំង ក្រឡាប់ អាវុធ អាជ្ញាធរ ពាក់ព័ន្ធ និង ប្រជាពលរដ្ឋ ជា ម្ចាស់ ក្បាល ដី ។
ទន្ទឹម នេះ លោក អភិបាល ខេត្ត ក៏ បាន កោតសរសើរ ដល់ ក្រុមការងារ មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោង ដី ខេត្ត ដែល បាន ខិតខំ ប្រឹងប្រែង សម្រេច លទ្ធផល ក្នុង ការចុះបញ្ជី ប្រមូល ទិន្នន័យ ក្បាល ដី ផ្សព្វផ្សាយ កំណត់ តំបន់ វិនិច្ឆ័យ ក្នុង ភូមិ នីមួយ ៗ ក្នុង ខេត្ត កែប ដើម្បី ចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ចេញ ប័ណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ បាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស និង មាន ទំនួល ខុសត្រូវ យ៉ាង ល្អ ប្រសើរ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត ក៏ សូម ស្នើឲ្យ អ្នក ដែល ជា ម្ចាស់ ក្បាល ដី ត្រូវ រៀបចំ ឯកសារ ពាក់ព័ន្ធ ឲ្យបាន រួចរាល ងាយស្រួល ដល់ ក្រុមការងារ បច្ចេកទេស ធ្វើ ប័ណ្ណ កម្មសិទ្ធិ ជូន បងប្អូន ។
ក្នុង នោះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន ផ្តល់ អនុសាសន៍ ដល់ ក្រុមការងារ បច្ចេកទេស ដូច ខាងក្រោម៖
សូម រំលឹក ថា ភូមិ ចំការបី ដែល ជា ភូមិ ធ្លាប់ ចុះបញ្ជី ដីធ្លី បទបញ្ជា លេខ ០១ប ប រួច មកហើយ កាលពី ឆ្នាំ ២០១២ ដែល មាន ក្រុម យុវជន ស្ម គ្រចិត្ត សម្តេច តេជោ ហ៊ុន សែន មក ជួយ វាស់វែង រួម ជាមួយ មន្ត្រី រដ្ឋបាល ក្រុង ស្រុក ផងដែរ តាម ការប៉ាន់ស្មាន ភូមិ ចំការបី មាន ក្បាល ដី ប្រមាណ ២.០០០ ក្បាល ដី ។
( ឧត្តរមានជ័យ )៖ លោក ឃិន ញ៉ាណ អនុប្រធាន ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ មូលដ្ឋាន ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ បាន ដឹកនាំ ក្រុមការងារ ចុះ តាម ទីតាំង ហាង បញ្ចាំ នានា ក្នុង ស្រុក ចុង កាល់ ដើម្បី ធ្វើ ការស្រាវជ្រាវ ក្រែង មាន ប្រជាពលរដ្ឋ យក អត្តសញ្ញាណ បណ្ណ សម្គាល់ ខ្លួន ទៅ ដាក់ ធានា បញ្ចាំ ទ្រព្យសម្បត្តិ ផ្សេង ៗ ធ្វើឱ្យ ពួកគាត់ មិន មាន ឱកាស ទៅ ចូលរួម បោះឆ្នោត នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក ឃិន ញ៉ាណ បាន ថ្លែង ប្រាប់ ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ ថា រយៈពេល ២ ថ្ងៃ ពោល ចាប់ពី ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២៣ លោក បាន ដឹកនាំ ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក ចុង កាល់ ដោយ មាន ការចូលរួម ពី អាជ្ញាធរ និង សមត្ថកិច្ច ពាក់ព័ន្ធ បាន ចុះ ពិនិត្យ តាម ទីតាំង ហាង បញ្ចាំ នានា ក្នុង ស្រុក ដើម្បី ធ្វើ ការស្រាវជ្រាវ ពិនិត្យ រក អត្តសញ្ញាណ បណ្ណ សម្គាល់ ខ្លួន ដែល ប្រជាពលរដ្ឋ បាន យក ទៅ ដាក់ ធានា បញ្ចាំ ទ្រព្យសម្បត្តិ ផ្សេង ៗ ។
លោក ឃិន ញ៉ាណ ថ្លែង ឱ្យដឹង ទៀត ថា ស្រប ពេល ដែល ថ្ងៃ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា ជិត ចូល មកដល់ ក៏ ដូចជា ផ្អែក តាម ច្បាប់ បោះឆ្នោត ដែល គ.ជ. ប បាន ជូន ដំណឹង គឺ ប្រជាពលរដ្ឋ ខ្មែរ ទាំង ពីរ ភេទ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត នឹង អាច ទៅ ចូលរួម បោះឆ្នោត បាន នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ លុះត្រាតែ ពួក គាត់ មាន អត្តសញ្ញាណ បណ្ណ សម្គាល់ ខ្លួន ។
លោក ក៏ បាន ថ្លែង លើកឡើង យ៉ាង ដូច្នេះ ទៀត ថា « អត្តសញ្ញាណ បណ្ណ សម្គាល់ ខ្លួន ជា បណ្ណ ដែល មាន តម្លៃ ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ ដែល អាច យក ទៅ ប្រើប្រាស់ បាន តាម តម្រូវការស្រប ទៅតាម ច្បាប់ ដូច្នេះ លោក គិត ថា ក្នុង ការសម្រួល ការរស់នៅ និង ភាពចាំបាច់ មួយ ចំនួន របស់ ប្រជាពលរដ្ឋ ពិតជា មាន ប្រជាពលរដ្ឋ យក អត្តសញ្ញាណ បណ្ណ សម្គាល់ ខ្លួន ទៅ ដាក់ ធានា បញ្ចាំ តាម ទីតាំង បញ្ចាំ ផ្សេង ៗ មិន ខាន ។
លោក ឃិន ញាណ បាន ថ្លែង បញ្ជាក់ ទៀត ថា សម្រាប់ ទីតាំង ហាង បញ្ចាំ ដែល ក្រុមការងារ បាន ចុះ រួម មាន៖ ហាង លក់ ទូរស័ព្ទ ដៃ ទីតាំង បញ្ចាំ ផ្សេង ៗ ទីតាំង លក់ ជី កសិកម្ម ទីតាំង លក់ ម៉ូតូ និង លក់ គោយន្ត កន្ត្រៃយ៍ ... ជាដើម ។
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ខ្មែរ អាមេរិកកាំង រស់ នៅ ទីក្រុង ឡាស វេហ្គាស រដ្ឋ នីវ៉ា ដា បាន ចេញមក អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត សូម ទៅ ចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ ឲ្យបាន គ្រប់ ៗ គ្នា និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា លេខរៀង ទី ១៨ ។
ប្រជាពលរដ្ឋ បើ ទោះ រស់ នៅ ក្រៅ ប្រទេស យ៉ាងណា ក្ដី ដែល បាន ប្រកាស ជំហរ អំពី ការគាំទ្រ បេក្ខភាព សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី សម្រាប់ អាណត្តិ ទី៧ និង អាណត្តិ ក្រោយ ៗ ទៀត និង គាំទ្រ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី បន្ត វេន នា ពេល អនាគត ។
ជាមួយគ្នា នេះ ពួកគាត់ ក៏ បាន ប្រកាស ពី ការប្រឆាំង ដាច់ខាត ចំពោះ ការលូក ដៃ ចូល កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ពីសំណាក់ ប្រទេស មួយចំនួន គ្រា ដែល កំពុង ដើរ ត្រូវបាន គន្លង លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ៕
សូម ទស្សនា វីដេអូ ខាងក្រោម៖ ក្រសួង ពាណិជ្ជកម្ម ជូនដំណឹង ពី ការដាក់ពាក្យ ស្នើសុំ លិខិត អនុញ្ញាត ឬ អាជ្ញា បណ្ណ ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការដាក់ពាក្យ ស្នើសុំ លិខិត អនុញ្ញាត ឬ អាជ្ញា បណ្ណ ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក តាម ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
សេចក្ដីជូនដំណឹង បាន ឲ្យដឹង ថា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដាក់ពាក្យ ស្នើសុំ លិខិត អនុញ្ញាត ឬ អាជ្ញា បណ្ណ សម្រាប់ ធ្វើ ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក ក្រសួង ពាណិជ្ជកម្ម កន្លងមក បាន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ប្រព័ន្ធ ស្វ័យប្រវត្តកម្ម ក្នុង ការស្នើសុំ លិខិត អនុញ្ញាត ឬ អាជ្ញា បណ្ណ ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក នៅ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០២៣ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖ ថ្ងៃទី ១៣យុទ្ធនាការ ឃោសនា រ សំឡេង ឆ្នោត ! ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ សំណេះសំណាល និង បង្រៀន ពី របៀប គូស សន្លឹក ឆ្នោត ដល់ សមាជិក សមាជិកា ជាង ១០០ នាក់ នៅ ឃុំ ញ៉ាង ខេត្ត រតនគិរី
( រតនគិរី ) ៖ លោក ទ្រេស សាមីន សមាជិក គណៈកម្មាធិការ បក្ស ខេត្ត រតនគិរី និង ជា ប្រធាន គណៈ ចលនា សាសនិក ឥស្លាម ខេត្ត និង លោក មាស សារ៉េត ប្រធាន គណបក្ស ស្រុក អណ្តូង មាស នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ បាន ដឹកនាំ ក្រុមការងារ ចុះ ជួប សំណេះសំណាល បង្រៀន ពី របៀប គូស សន្លឹក ឆ្នោត ផ្សព្វផ្សាយ ពី គោល នយោបាយ បង្ហាញ លេខរៀង រូប សញ្ញា បក្ស និង ចែក ខិតប័ណ្ណ ដល់ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា នៅ សាលា រោង ភូមិ កា ជូត ចំនួន ១១១ នាក់ ( ស្រី ៤៣ នាក់ ) ។
នា ឱកាស នោះ លោក ទ្រេស សាមីន និង លោក មាស សារ៉េត បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ឃុំ ញ៉ាង សកម្មជន និង អ្នកគាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា គ្រប់ ភូមិ និង ឃុំ ញ៉ាង ទាំងអស់ ដែល មាន ភក្ដី ភាព ជឿជាក់ និង គាំទ្រ ដោយ ឥត ងាក រេ មក លើ គណបក្ស ប្រជាជន កម្ពុជា ហើយ បាន អញ្ជើញ ចូលរួម ក្នុង យុទ្ធនាការ ឃោសនា បោះឆ្នោត យ៉ាង មហោឡារិក ។
លោក បាន ជំរុញ សមាជិក ទាំងអស់ ដែល គ្រប់ អាយុ បោះឆ្នោត និង មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ត្រូវ ទៅ ចូលរួម បោះឆ្នោត នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ឲ្យបាន គ្រប់ ៗ គ្នា ព្រោះ ការបោះឆ្នោត មាន សារៈសំខាន់ ណាស់ ដើម្បី ជ្រើសរើស ថ្នាក់ដឹកនាំ ដែល ពេញចិត្ត ដែល ជួយ ថែរក្សា សុខ សន្តិភាព និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ មាន ភាពជឿនលឿន បន្ត ទៀត ។
បន្ថែម លើ នេះ លោក ទាំង២ បាន រំលេច នូវ ស្នាដៃ ធំ ៗ ជាច្រើន ទៀត ដែល ជា សមិទ្ធិផល របស់ គណបក្ស ប្រជាជន កម្ពុជា បាន កសាង កន្លងមក ឲ្យ សមាជិក សមាជិកា កាន់តែ យល់ ច្បាស់ នូវ ស្នាដៃ ជា ប្រវត្តិសាស្ត្រ នេះ ដែល គណបក្ស ប្រជាជន កម្ពុជា សម្រេច ជូន ជាតិ និង ប្រជាជន កម្ពុជា ។
ចុងបញ្ចប់ លោក ទាំង២ បាន ផ្តាំផ្ញើ ដល់ ក្រុមគ្រួសារ សមាជិក សមាជិកា ទាំងអស់ សូមអញ្ជើញ ទៅ បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី ១៨ មាន រូប សញ្ញា « ទេវតា បាច ផ្កា » ជា សម្គាល់ ៕
មេទ័ព កម្ពុជា ចាត់ទុក ការជួយ កសាង វិទ្យាស្ថានទ័ព ជើងគោក ពីសំណាក់ កងទ័ព រំដោះ ប្រជាជន ចិន ជា និមិត្តរូប មួយ នៃ កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ រវាង កងទ័ព ប្រទេស ទាំង ពីរ
ក្នុង ជំនួប នា ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ជំនួស មុខ ឱ្យ ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ បាន សំដែង នូវ ការស្វាគមន៍ ចំពោះ វត្តមាន របស់ គណៈប្រតិភូ និស្សិត នាយ ទាហាន នៃ សាកលវិទ្យាល័យ ការពារ ជាតិ កងទ័ព រំដោះ ប្រជាជន ចិន មកកាន់ ប្រទេស កម្ពុជា នា លើក នេះ ។
តាមរយៈ នៃ ដំណើរទស្សនកិច្ច របស់ ប្រតិភូ និស្សិត នាយ ទាហាន សកលវិទ្យាល័យ ការពារ ជាតិ កងទ័ព រំដោះ ប្រជាជន ចិន នៅ កម្ពុជា នា លើក នេះ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន វាយតម្លៃ និង ចាត់ទុក ថា កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ រវាង សាកលវិទ្យាល័យ ការពារ ជាតិ កងទ័ព ប្រទេស ទាំង ពីរ កម្ពុជា - ចិន ពិតជា បាន ពង្រឹង ពង្រីក កាន់តែ ជិតស្និទ្ធ និង រឹងមាំ ថែម ទៀត លើ កិច្ចសហប្រតិបត្តិការ ជា ដៃគូ គ្រប់ ជ្រុងជ្រោយ និង ជា មិត្ត ដែល ថែប រវាង កងទ័ព ទាំង ពីរ ។
ឧត្តមសេនីយ៍ ឯក សៀវ ធៀន ឡាំង បាន ជូន ពរ ដល់ ប្រជាជន កម្ពុជា ក្នុង ដំណើរការ នៃ ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ សម្រាប់ នីតិកាល ទី៧ នៃ រដ្ឋសភា សូម ប្រព្រឹត្តទៅ ប្រកបដោយ សេរី យុត្តិធម៌ និង មាន តម្លាភាព ។ ឧត្តមសេនីយ៍ ឯក ថ្លែង ថា ឆ្នាំ នេះ គឺជា ឆ្នាំ ខួប ៦៥ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត ចិន - កម្ពុជា ហើយក៏ ជា ឆ្នាំ មិត្តភាព រវាង ចិន និង កម្ពុជា ផងដែរ ។
ឧត្តមសេនីយ៍ ឯក សៀវ ធៀន ឡាំង បាន បញ្ជាក់ ទៀត ថា កាល ខែកុម្ភៈ ឆ្នាំ ២០២៣ កន្លងទៅ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន អញ្ជើញ ទៅ បំពេញ ដំណើរទស្សនកិច្ច ជា ផ្លូវការ និង ផ្លូវ រដ្ឋ ជា លក្ខណៈ មិត្តភាព នៅ ប្រទេស ចិន ។ ដែល តាមរយៈ នៃ ដំណើរទស្សនកិច្ច នេះ របស់ សម្ដេច តេជោ ហ៊ុន សែន នៅ ប្រទេស ចិន បាន ធ្វើឱ្យ ទំនាក់ទំនង រវាង កងទ័ព និង ប្រជាជន ប្រទេស យើង ទាំង ពីរ ចិន - កម្ពុជា ឈាន ចូល ទៅក្នុង យុគ្គ សម័យ ថ្មី និង ក្នុង ដំណាក់កាល ថ្មី មួយ ។
ឧត្តមសេនីយ៍ ឯក សៀវ ធៀន ឡាំង បាន បន្ថែម ទៀត ថា សមិទ្ធផល ជាច្រើន នៅក្នុង វិទ្យាស្ថានទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ នៅក្នុង តំបន់ ភូមិសាស្ត្រ នៃ ខេត្ត កំពង់ស្ពឺ និង សមិទ្ធផល នានា ជាច្រើន ទៀត គ្រប់ ទីកន្លែង នៅ កម្ពុជា ដែល កងទ័ព រំដោះ ប្រជាជន ចិន បាន ជួយ កសាង គឺជា និមិត្តរូប នៃ ការពង្រឹង ពង្រីក ចំណង ទាក់ទង កិច្ចសហប្រតិបត្តិការ នៃ ការរឹត ចំណង សាមគ្គីភាព មិត្តភាព នៃ កងទ័ព ប្រទេស យើង ទាំង ពីរ ។
ឧត្តមសេនីយ៍ ឯក សៀវ ធៀន ឡាំង បាន ថ្លែង ថា គោលបំណង របស់ ប្រតិភូ និស្សិត នាយ ទាហាន សាកលវិទ្យាល័យ ការពារ ជាតិ នៃ កងទ័ព នៃ កងទ័ព រំដោះ ប្រជាជន ចិន មកកាន់ កម្ពុជា លើក នេះ គឺ ដើម្បី ធ្វើ ការផ្លាស់ប្ដូរ ទស្សនៈ បទពិសោធន៍ ពី គ្នា ទៅ វិញ ទៅ មក រវាង កងទ័ព ទាំង ពីរ ចិន - កម្ពុជា ពិសេស សាកលវិទ្យាល័យ ការពារ ជាតិ នៃ ប្រទេស ទាំង ពីរ ៕
លោក មឿង សឿង៖ តាម ការសង្កេត របស់ ខ្ញុំ ពុំ ធ្លាប់ ឃើញ បក្ស ណា ដែល រួម សុខ រួម ទុក្ខ និង បង្ហាញ ភាពច្បាស់លាស់ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ ដូច គណបក្ស ប្រជាជន កម្ពុជា នោះ ទេ
( កំពង់ស្ពឺ ) ៖ ក្នុង នាម ជា អ្នកគាំទ្រ ដ៏ ស្មោះស្ម័គ្រ ម្នាក់ របស់ គណបក្ស ប្រជាជន កម្ពុជា តាំងពី ឆ្នាំ ១៩៩៣មក លោក ពូ មឿង សឿង បាន ថ្លែង ថា « តាម ការសង្កេត របស់ ខ្ញុំ ពុំ ធ្លាប់ ឃើញ គណបក្ស ណា ដែល រួម សុខ រួម ទុក្ខ និង បង្ហាញ ភាពច្បាស់លាស់ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ ដូច គណបក្ស ប្រជាជន កម្ពុជា នោះ ទេ » ។
ការថ្លែង បែប នេះ របស់ លោល ពូ មឿង សឿង បាន ធ្វើឡើង ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ក្នុង យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត នៅ ឃុំ មនោរម្យ ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ ក្រោម អធិបតីភាព លោក ហ៊ុន ម៉ានី អនុប្រធាន ទី០១ ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ និង ជា អ្នកតំណាងរាស្រ្ត មណ្ឌល ខេត្ត កំពង់ស្ពឺ នា ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ ។
លោក ពូ មឿង សឿង បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ និង រំភើប យ៉ាង ក្រៃលែង ដែល បាន ជួបជុំ ជាមួយ សមាជិក សមាជិកា ក្រុមគ្រួសារ គណបក្ស ប្រជាជន កម្ពុជា នា ឱកាស នេះ ។
លោក ពូ បាន បន្ត ថា ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា កន្លងមក បាន កែប្រែ មុខមាត់ មូលដ្ឋាន ខេត្ត កំពង់ស្ពឺ ក៏ ដូចជា ប្រទេស កម្ពុជា ឱ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ដោយ សង្កេតឃើញ តាមរយៈ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ដូចជា ផ្លូវថ្នល់ សាលារៀន មន្ទីរពេទ្យ វត្ត អារាម និង ការរីកចម្រើន នៃ កម្រិត ជីវភាព ប្រជាជន ទូទៅ ។
លោក ពូ បាន គូសបញ្ជាក់ ថា « ចាប់តាំងពី កម្ពុជា រៀបចំ ការបោះឆ្នោត លើក ដំបូង ខ្ញុំ និង ក្រុមគ្រួសារ ពេញចិត្ត និង ស្រលាញ់ តែ គណបក្ស ប្រជាជន កម្ពុជា មួយ គត់ ហើយ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ខាងមុខ នេះ យើង នៅតែ បន្ត បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ធានា ភាព ឈ្នះ ជូន គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ មាន លទ្ធភាព បន្ត ការដឹកនាំ កម្ពុជា ឱ្យ កាន់តែ រីកចម្រើន ទៅ មុខ ទៀត ៕
ក្រសួង ការពារ ជាតិ រុស្ស៉ី បាន ប្រាប់ ថា មកទល់ ពេលនេះ ខ្លួន ទទួលបាន សម្ភារ យោធា សរុប ច្រើន ជាង ២.០០០ គ្រឿង ក្នុង នោះ រួម មាន ទាំង រថក្រោះ ប្រព័ន្ធ បាញ់ គ្រាប់ រ៉ុក្កែត និង ប្រព័ន្ធ ប្រឆាំង យន្តហោះ ចម្បាំង ជាដើម ។ ក្រៅពី នេះ ក្រសួង ការពារ ជាតិ រុស្ស៉ី ក៏ បាន ទទួលបាន គ្រាប់ រំសេវ ចម្រុះ ប្រភេទ គិត ជា ទម្ងន់ លើស ពី ២.៥០០តោន ហើយនិង អាវុធ ធុន តូច ប្រហែល ២០.០០០ ដើម ផងដែរ ។ សម្ភារ ទាំងនោះ ភាគ ច្រើន គឺ ហាក់ មិន ធ្លាប់ ត្រូវបាន ប្រើប្រាស់ លើ សមរភូមិ ពីមុន មក ទេ ។
ភ្លាម ៗ បន្ទាប់ពី បាន ឃើញ នូវ ការចែកចាយ ខ្លឹមសារ និង រូបភាព ដោយ លាយ លំ ជាមួយ មតិ រិះគន់ ដែល ធ្លាក់ មក ជា បន្ដ បន្ទាប់ . ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ធ្វើ ការស្រាវជ្រាវ និង ឈានដល់ កំណត់ អត្តសញ្ញាណ បុរស ជា អង្គរក្ស ម្ចាស់ រថយន្ដ ទំនើប ខាងលើ ដើម្បី ហៅ មក ធ្វើ ការសួរនាំ អំពី ដំណើរ រឿង ដែល បាន កើតឡើង ជាមួយ ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ តាម ដងផ្លូវ ដូចគ្នា ។
បន្ទាប់ពី កំណត់ អត្តសញ្ញាណ បាន ហើយ នោះ លោក ឧត្តមសេនីយ៍ ទោ ប៊ុន សុសិក្ខា ស្នងការ រង ទទួល ការងារ ផែន សន្តិសុខ នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ បាន កោះហៅ បុរស ទាំង ៤នាក់ នោះ មក ធ្វើ ការសួរនាំ ។ អ្នក ទាំង៤ នោះ រួម មាន៖ ទី១៖ ឈ្មោះ មិន សុជាតិ អាយុ ៣៧ឆ្នាំ . ទី ២៖ ឈ្មោះ កែវ សុវណ្ណូរ៉ា អាយុ ៣៤ឆ្នាំ . ទី ៣៖ ឈ្មោះ សោប ចាន់ ធូ អាយុ៣០ ឆ្នាំ និង ទី៤៖ ឈ្មោះ អ៉ិត ស៊ុន ណាត អាយុ ៣៤ ឆ្នាំ ។
ក្រុម អង្គរក្ស ម្ចាស់ រថយន្ដ ទំនើប ខាងលើ បាន ទទួលស្គាល់ រាល់ កំហុស ខុសឆ្គង ដែល ពួកគេ បាន ប្រព្រឹត្ត ដែល បាន ធ្វើឲ្យ ប៉ះពាល់ ដល់ អារម្មណ៍ សាធារណៈ ជន នៅ តាម ដងផ្លូវ និង ប្រជាពលរដ្ឋ ខ្មែរ ដែល បាន ឃើញ ហេតុការណ៍ ដោយ ផ្ទាល់ និង តាម បណ្តាញ សង្គម ព្រមទាំង សូម ប្រជាពលរដ្ឋ មាន ការយោគយល់ អធ្យាស្រ័យ ដល់ ពួកគេ ដោយ សន្យា ថា នឹង ខិតខំ កែប្រែ ខ្លួន ជា ពលរដ្ឋ ល្អ មិន ឲ្យ រឿងរ៉ាវ បែប នេះ ទៀត ឡើយ ។
គួរ បញ្ជាក់ ថា ជាមួយនឹង ការផ្ទុះ ក្នុង រដ្ឋធានី និង មជ្ឈមណ្ឌល ក្នុង តំបន់ ផ្សេង ទៀត ក្នុង រយៈពេល ជាង ៥០០ ថ្ងៃ នៃ ការឈ្លានពាន របស់ រុស្ស៉ី ក្រុម មន្ត្រី យោធា និយាយ ថា កងកម្លាំង អ៊ុយក្រែន កំពុង មាន វឌ្ឍនភាព លើ ប្រតិបត្តិការ វាយ បក របស់ ពួកគេ នៅ ជួរ មុខ ភាគ ខាងកើត និង ខាងត្បូង ។ ទាំងនោះ ក៏ រួមបញ្ចូល នៅជិត ទីក្រុង បាក មូត (Bakhmut) ផងដែរ ៕
រដ្ឋមន្ត្រី អ៉ិត សំហេង ប្រកាស ចូលកាន់ តំណែង ប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កំពង់ឆ្នាំង ថ្មី
( កំពង់ឆ្នាំង ) ៖ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នា ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង ប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កំពង់ឆ្នាំង គឺ លោក ស៊ឹម សុវឌ្ឍនៈ ជា ប្រធាន មន្ទីរ ថ្មី ព្រមទាំង មាន ការផ្ដាំផ្ញើ នូវ អនុសាសន៍ មួយចំនួន ។
លោក រដ្ឋមន្ត្រី សង្ឃឹម ជឿជាក់ ថា ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ គ្រប់ ថ្នាក់ ក្រោម ឱវាទ មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កំពង់ឆ្នាំង រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ អាជ្ញាធរដែនដី និង ស្ថាប័ន មាន សមត្ថកិច្ច ទាំងអស់ ក្នុង ខេត្ត កំពង់ឆ្នាំង នឹង ខិតខំ បំពេញ ការងារ រួមគ្នា សហការ គ្នា បាន ល្អ ដើម្បី សម្រេចបាន នូវ សមិទ្ធផល ថ្មី ៗ ជូន រាជ រដ្ឋាភិបាល បន្ថែម ទៀត ។
លោក អ៉ិត សំហេង បាន វាយតម្លៃ ខ្ពស់ និង កោតសរសើរ ចំពោះ រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង ដែល បាន ខិតខំ បំពេញ ភារកិច្ច នានា ដែល រាជ រដ្ឋាភិបាល ប្រគល់ ជូន ក៏ ដូចជា ខិតខំ ដោះស្រាយ នូវ រាល់ បញ្ហា នានា ពាក់ព័ន្ធ នឹង វិស័យ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព កន្លងមក ។
លោក អ៉ិត សំហេង បាន ស្នើ លោក ប្រធាន មន្ទីរ ថ្មី ត្រូវ បន្ត យកចិត្តទុកដាក់ ឲ្យបាន ម៉ឹង ម៉ាត់ ក្នុង ការបំពេញ ការងារ តាម តួនាទី ភារកិច្ច រៀង ៗ ខ្លួន ឱ្យ បាន ល្អ ព្រម ជាមួយ នោះ៖
មន្ត្រី ជាន់ ខ្ពស់ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ចន្ទ្រា ចុះ ពិនិត្យ លទ្ធផល ឃោសនា រក សំឡេង ឆ្នោត និង បង្រៀន គូស សន្លឹក ឆ្នោត ដល់ ពលរដ្ឋ
លោក ម៉ឺង កុម្ភៈ បាន ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង សម្ដេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន អនុប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត ស្វាយរៀង ជូន ដល់ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា នៅ ឃុំ សំរោង ផងដែរ ។
នៅក្នុង ឱកាស នោះ លោក ម៉ឺង កុម្ភៈ បាន ផ្សព្វផ្សាយ ពី គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា តាម ខ្នង ផ្ទះ របស់ ប្រជាពលរដ្ឋ និង បាន ផ្តាំផ្ញើ ដល់ សមាជិក សមាជិកា គណបក្ស និង ប្រជាពលរដ្ឋ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត សូម ពិនិត្យ និង ត្រៀម អត្តសញ្ញាណ បណ្ណ របស់ ខ្លួន និង ឯកសារ បម្រើ ឲ្យ ការបោះឆ្នោត ឲ្យបាន រួចរាល់ ។
លោក បាន បញ្ជាក់ ថា ក្នុង ករណី បាត់ ឬ ខូច អត្តសញ្ញាណ បណ្ណ សូម ប្រញាប់ រួសរាន់ ទៅ ធ្វើ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ បម្រើ ឲ្យ ការបោះឆ្នោត ( ឯ . អ) ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី បំពេញ តួនាទី ជា ពលរដ្ឋ ល្អ និង សូម ជ្រើសរើស គណបក្ស ដែល នាំមក នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ពិតប្រាកដ ជូន ប្រទេសជាតិ មាតុភូមិ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន អំពាវ ដល់ សមាជិក សមាជិកា គណបក្ស និង ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ គ្នា កុំបី ខាន និង បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី ១៨ និង មាន រូប សញ្ញា ទេវតា បាច ផ្កា នៅលើ សន្លឹក ឆ្នោត ជា សម្គាល់ ដើម្បី បន្ត គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្រ្តី និង លោក ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សម្រាប់ ពេល អនាគ ។
នៅក្នុង ឱកាស នោះ លោក ម៉ឺង កុម្ភៈ បាន ដឹកនាំ ក្រុមការងារ ចុះ តាម ខ្នង ផ្ទះ ដើម្បី សាកល្បង គូស សន្លឹក ឆ្នោត នៅក្នុង ប្រអប់ លេខរៀង ទី ១៨ ឲ្យបាន ត្រឹមត្រូវ ផងដែរ ៕ ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ មូលដ្ឋាន ឃុំ កណ្តោល ស្រុក បូទុម សាគរ ខេត្ត កោះកុង បន្ត ឃោសនា រក សំឡេង ឆ្នោត បង្រៀន ពលរដ្ឋ គូស សន្លឹក ឆ្នោត និង រាំ លេង កម្សាន្ត នៃ យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត
( កោះកុង ) ៖ លោក ឈឿន កុសល វីរៈ ប្រធាន ក្រុមការងារ គណបក្ស ថ្នាក់ កណ្តាល ចុះ មូលដ្ឋាន ឃុំ កណ្តោល ស្រុក បូទុម សាគរ ខេត្ត កោះកុង និង លោកស្រី សាំង សូរ ធូកា សប្បុរសជន គាំទ្រ គណបក្ស ឃុំ កណ្តោល នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ បាន ដឹកនាំ ក្រុមការងារ បន្ត ឃោសនា រក សំឡេង ឆ្នោត នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ អណត្តិ ទី៧ ឆ្នាំ ២០២៣ និង បង្រៀន គូស សន្លឹក ឆ្នោត មាន សមាជិក សមាជិកា បក្ស ចូលរួម ចំនួន ៥០០ នាក់ ។
លោក ឈឿន កុសល វីរៈ បាន ថ្លែង ថា ដើម្បី រក្សា សន្តិភាព និង គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា ពុំ មែន មាន តែ ក្នុង អាណត្តិ ទី៧ នោះ ទេ គឺ មាន តាំងពី អាណត្តិ១ មក ម្ល៉េះ និង បាន បន្ត ដាក់ ចេញ ជា បន្តបន្ទាប់ រហូតមកដល់ បច្ចុប្បន្នភាព ពង្រឹង ប្រសិទ្ធភាព នៃ ការអនុវត្ត ប្រកបដោយ គុណភាព តម្លាភាព សមធម៌ សំដៅ បម្រើ ប្រយោជន៍ ជា រួម ដល់ ប្រជាពលរដ្ឋ កម្ពុជា នៅ ទូទាំង ប្រទេស ។
លោក ឈឿន កុសល វីរៈ បាន បន្ថែម ថា រយៈកាល ជាង ៤៤ ឆ្នាំ មក នេះ គណបក្ស ប្រជាជន កម្ពុជា បាន ខិតខំ ថែរក្សា ការពារ សន្តិភាព សុខ សន្តិភាព ដែល រក បាន មក យ៉ាង លំបាក ហើយ បាន បន្ត ជំរុញ ការអភិវឌ្ឍ ប្រទេសជាតិ ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត ដែល មាន ចក្ខុវិស័យ វែងឆ្ងាយ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ធ្វើឲ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ព្រមទាំង ជា ប្រទេស ដែល ប្រកាន់ យក នូវ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ។
នៅក្នុង ឱកាស នោះ ក្រុមការងារ ក៏ បាន បង្រៀន សមាជិក សមាជិកា បក្ស ឲ្យ ចេះ គូស សន្លឹក ឆ្នោត ឲ្យ ត្រឹមត្រូវ ផងដែរ ៕
លោក សុខ សូកាន ណែនាំ ដល់ សកម្មជន បក្ស នៅ មូលដ្ឋាន ឱ្យ បន្ត ពង្រឹង និង ជំរុញ ការបង្រៀន គូស សន្លឹក ឆ្នោត ឱ្យ បាន ត្រឹមត្រូវ និង ឱ្យ បាន ច្រើន ដង ជូន ដល់ សមាជិក បក្ស នៅ ទូទាំង ស្រុក គិរី វង់
( តាកែវ )៖ ថ្ងៃទី ១១ និង ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២៣ លោក សុខ សូកាន ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក គិរី វង់ បាន ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា ជា សកម្មជន គណ បក្ស ប្រជាជន កម្ពុជា នៅ តាម ស្នាក់ការ គណបក្ស របស់ ឃុំ ទាំង៥ រួម មាន ឃុំ គោក ព្រេច ឃុំ អង្គ ប្រាសាទ ឃុំ ព្រះបាទ ជាន់ ជុំ ឃុំ តា អូរ និង ឃុំ ព្រៃ អំពក ដោយ បាន ជួប សមាជិក សមាជិកា សរុប ប្រមាណ ៧៩១ នាក់ ។
លោក សុខ សូកាន ក៏ បាន ក្រើន រំលឹក ដល់ សកម្មជន គណបក្ស នៅ មូលដ្ឋាន នៅ ឃុំ ទាំង៥ ត្រូវ ខិតខំ បំពេញ តួនាទី ភារកិច្ច ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម គោលការណ៍ ណែនាំ ដែល គណបក្ស ប្រគល់ ជូន ទាំង មុន ថ្ងៃ បោះឆ្នោត នៅ ថ្ងៃ បោះឆ្នោត និង ក្រោយពេល បោះឆ្នោត ដើម្បី ដណ្តើម ប្រៀប ឈ្នះ ជូន គណបក្ស ប្រជាជន កម្ពុជា ។
នៅក្នុង ឱកាស នោះ ផងដែរ លោក សុខ សូកាន បាន ផ្សព្វផ្សាយ អំពី គោល នយោបាយ ដឹកនាំ ប្រទេស របស់ គណបក្ស ប្រជាជន កម្ពុជា និង បាន បង្រៀន ដល់ ប្រជាពលរដ្ឋ និង អាជីវករ លក់ដូរ នៅ ផ្សារ ទាំង ពីរ នៃ ឃុំ ព្រះបាទ ជាន់ ជុំ គូស សន្លឹក ឆ្នោត ឱ្យ បាន ត្រឹមត្រូវ ។
សូម រំលឹក ផងដែរ ថា ផ្សារ កសិផល សុខ អាន ទន្លាប់ ភូមិ ១ ផលិតផល ១ ត្រូវបាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ កាលពី ឆ្នាំ ២០១១ ក្រោម គំនិត ផ្តួចផ្តើម របស់ សម្តេច វិបុល បញ្ញា សុខ អាន ក្នុង បំណង លើកស្ទួយ កម្រិត ជីវភាព រស់ នៅ របស់ ប្រជាជន នៅ ទូទាំង ស្រុក គិរី វង់ តាមរយៈ ការជំរុញ ការផលិត និង ផ្តល់ ជា ទីផ្សារ ជូន សហគមន៍ កសិកម្ម និង ប្រជាសិករ អាច យក ផលិតផល និង ដំណាំ កសិកម្ម មក លក់ នៅ ទីផ្សារ នេះ ដោយ គ្មាន បង់ កម្រៃ ណាមួយ ឡើយ ។
* តើ ការជ្រើសរើស នាយក រដ្ឋមន្ត្រី ដំណើរការ ទៅ យ៉ាងដូចម្ដេច ?
សមាជិក រដ្ឋសភា ជាប់ ឆ្នោត ថ្មី ៗ ទាំង ៥០០ រូប និង សមាជិក ព្រឹទ្ធសភា ២៥០ រូប ត្រូវ បោះឆ្នោត រួមគ្នា ដើម្បី ជ្រើសរើស នាយក រដ្ឋមន្ត្រី ថ្មី ។ នៅពេល សម័យ ប្រជុំ រួម ចាប់ផ្ដើម គណបក្ស នីមួយ ៗ នឹង ត្រូវបាន ស្នើ ឱ្យ តែងតាំង បេក្ខជន នាយក រដ្ឋមន្ត្រី របស់ ខ្លួន ។
* ពិធី ចុះហត្ថលេខា លើ សន្ធិសញ្ញា ស្តីពី មិត្តភាព និង សហប្រតិបត្តិការ នៅ អាស៊ី អាគ្នេយ៍ (TAC) ដោយ ព្រះរាជាណាចក្រ អារ៉ាប៊ី សាអូឌីត
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន ឆ្លៀត ឱកាស ទទួល ជួប ទ្វេ ភាគី ជាមួយ លោកស្រី ផិននី វង់ រដ្ឋមន្រ្តី ការបរទេស អូស្ត្រាលី ដើម្បី ពង្រឹង ទំនាក់ទំនង ទ្វេ ភាគី បន្ថែម ទៀត និង បាន ផ្លាស់ប្តូរ ទស្សនៈ អំពី បញ្ហា នានា ដែល ជា ក្តីបារម្ភ និង ផលប្រយោជន៍ រួម ៕ អគ្គ បញ្ជាការដ្ឋាន ជូនដំណឹង ពី ការទទួលមរណភាព របស់ ឧត្តមសេនីយ៍ ឯក ណេប សន នាយ រង សេនាធិការ ចម្រុះ នាយក ទី ចាត់ការចល នូប្បត្ថម្ភ
( ភ្នំពេញ ) ៖ ទី ចាត់ការចល នូប្បត្ថម្ភ នៃ អគ្គ បញ្ជាការដ្ឋាន កងយោធពល ខេមរភូមិន្ទ បាន ចេញ សេចក្ដីជូនដំណឹង អំពី ការទទួលមរណភាព របស់ លោក ឧត្តមសេនីយ៍ ឯក ណេប សន នាយ រង សេនាធិការ ចម្រុះ នាយក ទី ចាត់ការចល នូប្បត្ថម្ភ អគ្គ បញ្ជាការដ្ឋាន នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៨៖ ០១នាទី ដោយ រោគា ពាធ ។
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី បន្ត ចុះ ជួប សំណេះសំណាល និង អំពាវនាវ ឱ្យ អាជីវករ នៅ ផ្សារ ព្រែក ដាច់ ស្រុក ព្រែក ដាច់ ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន ឱ្យ បាន គ្រប់ ៗ គ្នា
( កណ្តាល ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី អនុប្រធាន ទី២ នៃ រដ្ឋសភា សមាជិកា គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈអចិន្រ្តៃយ៍ ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ចុះ មូលដ្ឋាន ស្រុក លើក ដែក នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ បាន បន្ត ដឹកនាំ សមាជិក សមាជិកា គណបក្ស ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ណែនាំឲ្យ ក្រុម អាជីវករ ទាំងអស់ ផ្សារ ព្រែក ដាច់ ស្ថិត នៅ ឃុំ ព្រែក ដាច់ ស្រុក លើក ដែក ខេត្ត កណ្តាល ។
នៅក្នុង ឱកាស នោះ លោកស្រី កិត្តិសង្គហ បណ្ឌិត បាន ជំរុញ ប្រជាពលរដ្ឋ ទាំងអស់ នាំគ្នា ទៅ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា និង បង្ហាញ អំពី របៀប គូស សន្លឹក ឆ្នោត ឱ្យ បាន ត្រឹមត្រូវ ដើម្បី ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នា ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០៣ ខាងមុខ នេះ ។
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី បាន ឆ្លៀត យក ឱកាស នោះ សម្តែង នូវ ការគោរព ដឹងគុណ និង សេចក្ដីស្រឡាញ់ ដ៏ ជ្រាលជ្រៅ បំផុត ចំពោះ បងប្អូន អាជីវករ ទាំងអស់ ក៏ ដូចជា ប្រជាពលរដ្ឋ ក្នុង ស្រុក លើក ដែក ដែល តែងតែ ផ្តល់ យុត្តិធម៌ និង ការគាំទ្រ យ៉ាង រឹងមាំ គ្រប់ ដំណាក់កាល បោះឆ្នោត ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ នៅ កម្ពុជា ។
នា ឱកាស នោះ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ក៏ បាន ក្រើន រំលឹក ឱ្យ បងប្អូន អាជីវករ នៅក្នុង ផ្សារ ព្រែក ដាច់ រួមទាំង ប្រជាពលរដ្ឋ ទាំងអស់ ត្រៀម ឯកសារ ឱ្យ បាន គ្រប់គ្រាន់ ជាមុន សម្រាប់ ការបោះឆ្នោត ដើម្បី បំពេញ តួនាទី ជា ពលរដ្ឋ ល្អ និង ជ្រើសរើស គណបក្ស ដែល នាំ នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ពិតប្រាកដ ជូន ប្រទេសជាតិ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៨. ៩៣៣ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៨៦៩ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ លោក ឈុំ សុជាត ដឹកនាំ ក្រុមការងារ ចុះ សំណេះសំណាល និង បង្ហាញ អំពី របៀប គូស សន្លឹក ឆ្នោត ជូន ដល់ ប្រជាពលដ្ឋ ក្នុង សង្កាត់ ផ្ទះ ព្រៃ ក្រុង ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ ក្នុង យុទ្ធនាការ ឃោសនា នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ លោក ឈុំ សុជាត សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា សមាជិក ក្រុមការងារ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត ពោធិ៍សាត់ បាន ដឹកនាំ ក្រុមការងារ ជួប សំណេះសំណាល និង បង្ហាញ អំពី របៀប គូស សន្លឹក ឆ្នោត ជូន ដល់ ប្រជាពលរដ្ឋ នៅ ភូមិ គក សង្កាត់ ផ្ទៃ ព្រៃ ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។
នៅក្នុង ឱកាស នោះ លោក ឈុំ សុជាត បាន លើកឡើង អំពី គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា សម្រាប់ ការដឹកនាំ និង អភិវឌ្ឍ ប្រទេស នៅក្នុង អាណត្តិ ថ្មី នេះ ដែល បន្ត ថែរក្សា សមិទ្ធផល ចាស់ និង បង្កើន សមិទ្ធផល ថ្មី ជា បន្តបន្ទាប់ កាន់តែ ច្រើន ក្រោម ការដឹកនាំ ប្រកបដោយ ភាពឈ្លៀសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។ លោក ក៏ បាន បង្ហាញ លេខរៀង របស់ គណបក្ស ប្រជាជន កម្ពុជា គឺ លេខរៀង ទី ១៨ ដល់ ប្រជាពលរដ្ឋ ដែល ងាយស្រួល ចំណាំ និង នៅ ចុងក្រោយ បង្អស់ ក្នុង សន្លឹក ឆ្នោត ។
លោក ឈុំ សុជាត បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ សង្កាត់ ផ្ទះ ព្រៃ ក្រុង ពោធិ៍សាត់ នេះ ទាំងអស់ ដែល តែង ស្រឡាញ់ ពេញចិត្ត និង គាំទ្រ ដល់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការដឹកនាំ ប្រទេស រយៈពេល ជាច្រើន អាណត្តិ កន្លងមក ដែល នេះ សបញ្ជាក់ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព និង ចូលរួម ថែរក្សា សន្តិភាព ។
នៅក្នុង ឱកាស នោះ ប្រជាពលរដ្ឋ នៅ ភូមិ គក សង្កាត់ ផ្ទះ ព្រៃ ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ បាន សម្តែង ភាពរីករាយ និង ថ្លែងអំណរគុណ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ ប្រទេស កម្ពុជា លើ គ្រប់ វិស័យ ។ ប្រជាពលរដ្ឋ បាន ប្តេជ្ញា គាំទ្រ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បន្ត ដឹកនាំ និង អភិវឌ្ឍ ប្រទេសជាតិ នៅក្នុង អាណត្តិ ថ្មី ជា បន្ត ។
ឧត្តមសេនីយ៍ ឯក កឹង ឃ ន អគ្គ ស្នងការ រង នគរបាល ជាតិ ដឹកនាំ ក្រុម ទី១ វេន ប្រចាំ បញ្ជា របស់ លេខាធិការដ្ឋាន នៃ គ.ស. អ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ លោក ឧត្តមសេនីយ៍ ឯក កឹង ឃ ន អគ្គ ស្នងការ រង នគរបាល ជាតិ តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ជា ប្រធាន លេខាធិការដ្ឋាន នៃ គ.ស. អ បាន ដឹកនាំ ក្រុម ទី១ វេន ប្រចាំ បញ្ជា របស់ លេខាធិការដ្ឋាន នៃ គ.ស. អ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នៅ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
* ជួយ ដល់ លេខាធិការដ្ឋាន នៃ គ .ស. អ ក្នុង ការតាមដាន ការអនុវត្ត ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ ដល់ ការបោះឆ្នោត ការអនុវត្ត បទបញ្ជា និង នីតិវិធី របស់ គ.ជ. ប ទាំង មុន ក្នុង និង ក្រោយ ការបោះឆ្នោត ។
ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន នៅឯ សភា មួយ ថ្ងៃ បន្ទាប់ពី តុលាការ ធម្មនុញ្ញ ថៃ ទទួលយក អនុសាសន៍ របស់ គណៈកម្មការរៀបចំ ការបោះឆ្នោត ដែល ស្នើ ឱ្យ ផ្អាក សមាជិកភាពសភា របស់ លោក ជា បណ្ដោះអាសន្ន លោក Pita បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ខ្ញុំ មាន ទំនុកចិត្ត លើ ខ្លួន ឯង ថា ខ្ញុំ នឹង ធ្វើ ការ ដោយ ពេញ សមត្ថភាព របស់ ខ្ញុំ ដើម្បី ឆ្លើយតប ទៅនឹង ក្ដីសង្ឃឹម របស់ ប្រជាជន និង ការគាំទ្រ ដែល ប្រជាជន បាន ផ្ដល់ឱ្យ ខ្ញុំ » ។
គួរ បញ្ជាក់ ថា ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ដែល បាន អនុម័ត ដំណោះស្រាយ ហាមឃាត់ ការអភិវឌ្ឍ មីស៊ីល និង កម្មវិធី អាវុធ នុយក្លេអ៊ែរ របស់ កូរ៉េ ខាងជើង នឹង បើក កិច្ចប្រជុំ បន្ទាន់ មួយ នៅ ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ ដើម្បី ពិភាក្សា គ្នា ការធ្វើតេស្ដមីស៊ីល របស់ ទីក្រុង ព្យុងយ៉ាង ៕
នៅក្នុង សេចក្ដីថ្លែងការណ៍ រួម របស់ ខ្លួន ដែល ចេញផ្សាយ នៅ កិច្ចប្រជុំ កំពូល រយៈពេល ២ ថ្ងៃ ក្នុង ទីក្រុង វីល នីញូ ស ប្រទេស លីទុយ អានី អង្គការ NATO បាន លើកឡើង ថា ចិន បាន និង កំពុង បង្ក បញ្ហា ប្រឈម ដល់ ផលប្រយោជន៍ សន្តិសុខ និង គុណ តម្លៃ របស់ NATO ដោយ សង្កត់ធ្ងន់ ពី មហិច្ឆតា និង គោល នយោបាយ សម្លុត គំរាម របស់ ទីក្រុង ប៉េកាំង ។
គួរ បញ្ជាក់ ថា កិច្ចប្រជុំ កំពូល NATO នៅក្នុង ទីក្រុង វីល នីញូស ក៏ មាន ការចូលរួម ផងដែរ ពីសំណាក់ មេដឹកនាំ មកពី តំបន់ អាស៊ី ក្នុង នោះ រួម មាន នាយក រដ្ឋមន្ត្រី ជប៉ុន នាយក រដ្ឋមន្ត្រី អូស្ត្រាលី នាយក រដ្ឋមន្ត្រី នូវែលសេឡង់ និង ប្រធានាធិបតី កូរ៉េ ខាងត្បូង ៕
( ភ្នំពេញ ) ៖ ក្រុម ជ្រុលនិយម ក្បត់ ជាតិ ក្នុង រយៈ ប៉ុន្មាន ថ្ងៃ មក នេះ បាន ព្យាយាម កាត់ បំភ្លៃប្រសាសន៍ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ធ្វើឱ្យ មាន ការយល់ ច្រឡំ ថា ដី ភូមិ កំណើត របស់ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ត្រូវបាន កាត់ ទៅ ឱ្យ វៀតណាម ។
វីដេអូ ដែល ក្រុម ជ្រុលនិយម ក្បត់ ជាតិ ចិត្ត អសិរពិស បាន កាត់ បំភ្លៃ គឺជា វីដេអូ ដែល សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ថ្លែង កាលពី ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២០ ពេល សម្ពោធ សួន ទឹក « ហ្គាឌិន ស៊ីធី » របស់ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ ។
ក្នុង វីដេអូ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ពី ជម្រើស ចំនួន ៣ លើ ការកំណត់ ព្រំដែន ជាមួយ ប្រទេស វៀតណាម ពាក់ព័ន្ធ នឹង ដី ភូមិ កំណើត របស់ សម្តេច ហេង សំរិន ។ ពាក់ព័ន្ធ ការកំណត់ ព្រំដែន រវាង កម្ពុជា និង វៀតណាម ដោយ យោង លើ ផែនទី បន្សល់ទុក ពី អាណានិគមន៍ បារាំង ដី ភូមិ កំណើត របស់ សម្តេច ហេង សំរិន ត្រូវបាន ទៅ លើ វៀតណាម ។
ប៉ុន្តែ កម្ពុជា និង វៀតណាម បាន ព្រមព្រៀង គ្នា រក្សា ដី ភូមិ កំណើត របស់ សម្តេច ហេង សំរិន នៅលើ ទឹកដី កម្ពុជា ដដែល ហើយ ទៅ យក ដី នៅ ទីតាំង ផ្សេង ដោះដូរ ជំនួស វិញ ។
ក្នុង វីដេអូ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បញ្ជាក់ ដែរ ថា ការវាស់វែង ព្រំដែន ដោយ យោង លើ ផែនទី បន្សល់ទុក ពី សម័យ អាណានិគមន៍ បារាំង កម្ពុជា ទទួលបាន ដី ដែល វៀតណាម កំពុង គ្រប់គ្រង ទំហំ ប្រមាណ ជា ២ពាន់ ហិកតា ។
អាស្រ័យ ហេតុ នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ជាពិសេស អ្នកលេង បណ្តាញ សង្គម ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ រាល់ វីដេអូ រាល់ ព័ត៌មាន ទាំងឡាយ របស់ ក្រុម ជ្រុលនិយម ក្បត់ ជាតិ ដែល មាន ជន ក្បត់ ជាតិត ជំនាន់ សម រង្ស៉ី ជា មេខ្លោង នោះ សុទ្ធសឹងតែ ជា រឿង មិន ពិត ជា រឿង ប្រឌិត ឡើង ក្នុង ចេតនា អាក្រក់ ពិស ពុល បង្ក បញ្ហា ក្នុង សង្គម យើង តែ ប៉ុណ្ណោះ ។
ខាងក្រោម នេះ គឺជា ប្រសាសន៍ ដើម ទាំងស្រុង របស់ សម្តេច តេជោ៖ រដ្ឋមន្ត្រី ព្រុំ សុខា ធ្វើបាឋ កថា ស្តីពី « ភាពជា អ្នកដឹកនាំ ន វានុវត្តន៍ និង គុណាធិបតេយ្យ ក្នុង រដ្ឋបាល សាធារណៈ » ដល់ នាយក នាយិកា វិទ្យាល័យ មកពី រាជធានី - ខេត្ត ទូទាំង ប្រទេស
( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២៣ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ ជា ប្រធាន គណ:កម្មាធិការ កែទម្រង់ រដ្ឋបាល សាធារណៈ និង ជា ប្រធាន ក្រុមប្រឹក្សា សាលា ភូមិន្ទ រដ្ឋបាល បាន អញ្ជើញ ផ្តល់ បាឋ កថា ស្ដីពី « ភាពជា អ្នកដឹកនាំ ន វានុវត្តន៍ និង គុណាធិបតេយ្យ ក្នុង រដ្ឋបាល សាធារណៈ » ជូន ដល់ លោក លោកស្រី ជា នាយក នាយិកា វិទ្យាល័យ មកពី រាជធានី - ខេត្ត ទូទាំង ប្រទេស សរុប មាន អ្នកចូលរួម ជាង ៦០០ នាក់ ។
មាតិកា សំខាន់ ៗ ចំនួន ៥ នៃ បាឋ កថា ដែល រៀបចំឡើង រយៈពេល ពេញ មួយ ថ្ងៃ នេះ រួម មាន៖ ទី១. ភាព ជា អ្នកដឹកនាំ និង ន វានុវត្តន៍ ទី២. គុណាធិបតេយ្យ ទី៣. កំណែទម្រង់ រដ្ឋបាល សាធារណៈ ទី៤. តួនាទី របស់ រដ្ឋាភិបាល និង ទី៥. សេចក្តីសន្និដ្ឋាន ។
សូម ជម្រាប ជូន ថា មកដល់ ពេលនេះ លោក រដ្ឋមន្រ្តី ព្រុំ សុខា បាន ផ្តល់ បាឋ កថា ជូន ដល់ មន្រ្តី រាជការ សាស្ត្រាចារ្យ លោកគ្រូ អ្នកគ្រូ សិស្ស និស្សិត បាន ចំនួន ប្រមាណ ជាង ១ម៉ឺន នាក់ រួច មកហើយ ៕
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ១៣ ខែកក្កដា នេះ លោក ប៉ែន សុវិជាតិ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន បញ្ជាក់ ថា ទីផ្សារ សំខាន់ ៗ ដែល កម្ពុជា បាន នាំចេញ កង់ រួម មាន៖ អាមេរិក អាល្លឺម៉ង់ បែលហ្ស៊ិក អង់គ្លេស និង ហូឡង់ ខណៈ កម្ពុជា នាំចូល កង់ មក វិញ ពី ជប៉ុន ចិន វៀតណាម ថៃ និង អាមេរិក ។
ទន្ទឹម គ្នា នេះ លោក ប៉ែន សុវិជាតិ បាន ឲ្យដឹង ថា ក្រសួង ក៏ រំពឹង ដែរ ថា នា ថ្ងៃ ខាងមុខ នៅពេល ការនាំចេញ កង់ មាន ការកើនឡើង អាច ជំរុញ ឲ្យ អ្នក វិនិយោគ ចាប់អារម្មណ៍ លើ ការបង្កើត រោងចក្រ ផលិត គ្រឿង បន្លាស់ ឬ ផលិតផល ពាក់កណ្តាល សម្រេច នៅ កម្ពុជា ដែល នឹង កាត់បន្ថយ ការនាំចូល បាន ខ្លះ ដែរ ។
គូសបញ្ជាក់ ថា បច្ចុប្បន្ន កម្ពុជា មាន រោងចក្រ សម្រាប់ ដំឡើង កង់ ចំនួន ៥ រួម មាន៖
ប្រទេស កម្ពុជា ជាប់ ចំណាត់ថ្នាក់ លេខ ១ នៅ តំបន់ អាស៊ាន ក្នុង ការនាំចេញ កង់ និង ជាប់ ចំណាត់ថ្នាក់ លេខ ៥ ក្នុង ពិភពលោក បន្ទាប់ពី ចិន តៃវ៉ាន់ ហូឡង់ និង អាល្លឺម៉ង់ ៕
បេក្ខជន ឈាន មុខ គេ សម្រាប់ តំណែង ជា នាយក រដ្ឋមន្ត្រី លោក Pita Limjaroenrat បាន និយាយ ថា លោក នៅតែ មាន ក្ដីសង្ឃឹម មួយ ថ្ងៃ បន្ទាប់ពី តុលាការ ធម្មនុញ្ញ ថៃ ទទួលយក អនុសាសន៍ របស់ គណៈកម្មការរៀបចំ ការបោះឆ្នោត ដែល ស្នើ ឱ្យ ផ្អាក សមាជិកភាពសភា របស់ លោក ជា បណ្ដោះអាសន្ន ពាក់ព័ន្ធ នឹង ការចោទប្រកាន់ បំពាន ច្បាប់ បោះឆ្នោត ។
( បាត់ដំបង ) ៖ ក្នុង យុទ្ធនាការ ឃោសនា គិត ត្រឹម ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ ជា ថ្ងៃ ក្រុមការងារ បាន បញ្ចប់ ជាស្ថាពរ នៃ ការចុះ ជួបប្រជាពលរដ្ឋ តាម ខ្នង ផ្ទះ . លោក មាស វិរិទ្ធ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង អនុប្រធាន ក្រុមការងារ រដ្ឋាភិបាល ចុះ ជួយ ក្រុង បាត់ដំបង បាន ដឹកនាំ ក្រុមការងារ ជួប សំណេះសំណាល និង បង្ហាញ អំពី របៀប គូស សន្លឹក ឆ្នោត ជូន ដល់ ប្រជាពលរដ្ឋ នៅ ភូមិ ភូមិ វត្ត គរ ភូមិ ច្រាប ក្រសាំង សង្កាត់ វត្ត គរ ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ។
លោក មាស វិរិទ្ធ បាន ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ភូមិ វត្ត គរ និង ភូមិ ច្រាប ក្រសាំង នៃ សង្កាត់ វត្ត គរ ក្រុង បាត់ដំបង ដែល បាន គាំទ្រ បោះឆ្នោត ជូន គណបក្ស ប្រជាជនជារៀងរហូតមក ហើយ សូម បងប្អូន បន្ត គាំទ្រ បន្ត ទៀត ដើម្បី ការរីកចម្រើន របស់ ប្រទេសជាតិ បន្ត រក្សា បាន នូវ សុខ សន្តិភាព ជីវភាព រស់ នៅ កាន់តែ ធូរធារ ។
( កំពង់ឆ្នាំង ) ៖ លោក ស៊ឹម សុវឌ្ឍនៈ អនុប្រធាន មន្ទីរ ត្រូវបាន ប្រកាស តែងតាំង ជា ប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កំពង់ឆ្នាំង ។ ពិធី នេះ ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ ក្រោម អធិបតីភាព លោក បណ្ឌិត អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង មាន ការចូលរួម ពី លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ។
យោង តាម ប្រកាស របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ត្រូវបាន ប្រកាស តែងតាំង លោក ស៊ឹម សុវឌ្ឍនៈ ជា ប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កំពង់ឆ្នាំង ជំនួស លោក សោម ស៊ីណាត ដែល ត្រូវបាន ទទួល ភារកិច្ច ថ្មី ។
លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា នៅ ខេត្ត កំពង់ឆ្នាំង ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល នា ពេល បច្ចុប្បន្ន បាន ធ្វើឲ្យ ខេត្ត មួយ នេះ មាន ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ លើ គ្រប់ វិស័យ ដោយ ធានា បាន នូវ សន្តិសុខ សុវត្ថិភាព ល្អ ប្រសើរ ទាក់ទាញ បាន នូវ អ្នក វិនិយោគិន ជាតិ អន្តរជាតិ មក បណ្តាក់ទុន ជំរុញ បាន នូវ កំណើន ការងារ ជូន ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត ដែល មកដល់ ពេលនេះ នៅ ខេត្ត កំពង់ឆ្នាំង មាន កម្មករ កម្ម ការិនី ប្រមាណ ជាង ៥ម៉ឺន នាក់ កំពុង បម្រើ ការងារ លើ វិស័យ វាយនភ័ណ្ឌ ។
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ លោក កែ គឹម យ៉ាន ឧប នាយក រដ្ឋមន្រ្តី សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ បាន បន្ត ជួប សំណេះសំណាល ជាមួយ សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ជាង ២៥០០ នាក់ នៅ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ចំ ថ្ងៃទី ១៣ នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៧ ។
( ភ្នំពេញ ) ៖ លោក ម៉ម ប៊ុន ហេង សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ខណ្ឌ សែនសុខ នៅ រសៀល ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ នេះ បាន បន្ត ដឹកនាំ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ចុះ ផ្សព្វផ្សាយ គោល នយោបាយ និង បង្រៀន គូស សន្លឹក ឆ្នោត ដល់ អាជីក រលក់ដូរ នៅ ផ្សារ បឹង បៃតង សង្កាត់ គោក ឃ្លាង ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
ក្នុង ឱកាស នោះ អាជីក រលក់ដូរ សម្តែង ការគាំទ្រ និង សប្បាយរីករាយ ស្វាគមន៍ យ៉ាង ខ្លាំង ចំពោះ ការចុះ សំណេះសំណាល និង ការបង្ហាញ នូវ គោល នយោបាយ របស់ បក្ស រួមទាំង ការបង្រៀន គូស សន្លឹក ឆ្នោត ដែល ដឹកនាំ ដោយ លោក ម៉ម ប៊ុន ហេង ។
( ភ្នំពេញ ) ៖ ចាប់តាំងពី ទទួល ជោគជ័យ ជា ប្រវត្តិសាស្រ្ត ក្នុង រំដោះ ប្រទេសជាតិ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី បាន ដាក់ចេញ នូវ មនោគម វិជ្ជា សេដ្ឋកិច្ច (Hunsenomics) និង ទស្សនវិស័យ វែងឆ្ងាយ ក្នុង ការដឹកនាំ សេដ្ឋកិច្ច កម្ពុជា ឲ្យ ឆ្លង ផុត ពី ការរាំងខ្ទប់ វិបត្តិ សន្តិសុខ ស្បៀង វិបត្តិ សេដ្ឋកិច្ច សកល និង វិបត្តិ សង្គម នានា ប្រកបដោយ ជោគជ័យ ហើយ ត្រូវបាន ទទួលស្គាល់ និង វាយតម្លៃ ខ្ពស់ ពី ថ្នាក់ តំបន់ និង ពិភពលោក ។
នេះ ជា លើកឡើង កាលពី ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ របស់ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ ប្រធាន គណៈកម្មាធិការ ជាតិ អេស្កាប់ ក្នុង កិច្ចពិគ្រោះយោបល់ គោល នយោបាយ លើ របាយការណ៍ សេដ្ឋកិច្ច និង សង្គម នៅក្នុង តំបន់ អាស៊ី និង ប៉ាស៊ីហ្វិក ឆ្នាំ ២០២៣ ដែល សហការរៀបចំ ដោយ UN ESCAP និង គណៈកម្មាធិការ ជាតិ អេស្កាប់ ។ កិច្ចពិគ្រោះយោបល់ នេះ មាន ការចូលរួម ពី ឧត្តម មន្ត្រី និង មន្ត្រី ជំនាញ របស់ រាជ រដ្ឋាភិបាល បញ្ញវ័ន្ត ដៃគូ អភិវឌ្ឍន៍ ព្រមទាំង មន្ត្រី ជំនាញ របស់ UN ESCAP ។
ទោះបី មាន វិបត្តិ សេដ្ឋកិច្ច សកល និង ថ្នាក់ តំបន់ សម្តេច តេជោ គឺ អ្នក សេដ្ឋកិច្ច ដ៏ ឆ្នើម ក្នុង ការដឹកនាំ និង ការគ្រប់គ្រង សេដ្ឋកិច្ច កម្ពុជា ប្រកប ទទួល ជោគជ័យ និង រួច ចាក ផុត ពី វិបត្តិ ទាំងនោះ បាន គ្រប់ កាលៈទេសៈ ព្រមទាំង ថែរក្សា បាន នូវ កំណើន សេដ្ឋកិច្ច ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ការងារ និង ជួយ សម្រាក បន្ទុក ដល់ ប្រជាជន ក្រីក្រ ដែល ទទួលរង ផល ប៉ះពាល់ ដោយ វិបត្តិ សង្គម នានា ដូចជា ជំងឺ សារ កូវីដ និង គ្រោះមហន្តរាយ ផ្សេង ៗ ជាដើម ។
ទេសរដ្ឋមន្រ្តី បាន បន្ត ទៀត ថា កំណើន សេដ្ឋកិច្ច ជាង ពីរ ទសវត្សរ៍ កន្លងទៅ នេះ ប្រទេស កម្ពុជា មាន ការផ្លាស់ប្តូរ រីកចម្រើន គួរឱ្យ កត់សម្គាល់ ព្រមទាំង ជួយ កម្ពុជា ឲ្យ ក្លាយជា ប្រទេស ឈានមុខ ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ ដោយ ឈាន ទៅ ទទួលបាន ឋានៈ ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប ក្នុង ឆ្នាំ ២០១៥ ហើយ ឈានទៅ សម្រេច ឱ្យ បាន នូវ ឋានៈ ជា ប្រទេស មាន ចំណូល មធ្យម ខ្ពស់ ត្រឹម ឆ្នាំ ២០៣០ ។
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ចេញ សេចក្ដីសម្រេច ស្ដីពី ការបង្កើត គណៈកម្មការ អន្ដរ ក្រសួង ដើម្បី ជំរុញ ដំណើរការអនុវត្ដ គម្រោង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ល្បឿន លឿន តភ្ជាប់ ពី រាជធានី ភ្នំពេញ ទៅ ខេត្ដ សៀមរាប ។ នេះ បើ តាម សេចក្ដីសម្រេច ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២៣ ។
គណៈកម្មការ អន្ដរ ក្រសួង ដើម្បី ជំរុញ ដំណើរការអនុវត្ដ គម្រោង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ល្បឿន លឿន តភ្ជាប់ ពី រាជធានី ភ្នំពេញ ទៅ ខេត្ដ សៀមរាប ខាងលើ នេះ ដោយ មាន លោក ស៊ុន ចាន់ថុល រដ្ឋមន្ដ្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ជា ប្រធាន ៕
លោក ជា ចាន់តូ និង ក្រុមការងារ ចុះបង្រៀន ប្រជាពលរដ្ឋ ក្នុង ស្រុក ប្រាសាទ បល្ល័ង្គ ខេត្ត កំពង់ធំ ពី របៀប គូស សន្លឹក ឆ្នោត ឲ្យបាន ត្រឹមត្រូវ និង អំពាវនាវ ឲ្យ ពលរដ្ឋ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា
( កំពង់ធំ )៖ លោក ជា ចាន់តូ សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ បាន អំពាវនាវ ឱ្យ សមាជិក សមាជិកា និង ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ គ្នា និង បន្ត គាំទ្រ បោះឆ្នោត ជូន គណ
បក្ស ប្រជាជន កម្ពុជា ដើម្បីឲ្យ កាន់តែ ច្បាស់ លោក ជា ចាន់តូ និង ក្រុមការងារ បាន ចុះបង្ហាត់ បង្ហាញ ប្រជាពលរដ្ឋ ស្ថិត ក្នុង ស្រុក ប្រាសាទ បាល្ល័ង្គ ខេត្ត កំពង់ធំ ពី របៀប គូស សន្លឹក ឆ្នោត ឲ្យបាន ត្រឹមត្រូវ ទៀតផង ។
