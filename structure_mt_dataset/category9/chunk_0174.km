ជាមួយគ្នា នេះ លោក រដ្ឋមន្ត្រី មាន សង្ឃឹម ជឿជាក់ ថា សិស្សានុសិស្ស ទាំងអស់ ពិតជា ទទួលបាន បទពិសោធន៍ ល្អ ៗ តាមរយៈ ការចូលរួម ការប្រកួតប្រជែង នេះ ដែល ជួយ ដល់ ការបង្កើន សមត្ថភាព ការយល់ដឹង ទំនុកចិត្ត និង ការសម្រេច ជោគជ័យ ក្នុង ការសិក្សា ក៏ ដូចជា ការប្រកួតប្រជែង ដទៃ ទៀត ទាំង ក្នុង ស្រុក និង អន្តរជាតិ ។
សូម ជម្រាប ជូន ថា ការប្រកួតប្រជែង នេះ រៀបចំឡើង ក្នុង គោលបំណង លើកកម្ពស់ សមត្ថភាព គំនិត ច្នៃប្រឌិត សិស្សានុសិស្ស លើ ការស្រាវជ្រាវ ទេពកោសល្យ ក្នុង ការសរសេរ ការវិភាគ លើ បញ្ហា ដោះស្រាយ បញ្ហា និង ស្វែងរក ដំណោះស្រាយ ព្រមទាំង អាច ស្វែងយល់ ពី ការប្រើប្រាស់ សេវា បញ្ញើ ប្រៃសណីយ៍ និង បញ្ញើ ឆាប់រហ័ស ។
ក្រោយពី ពិនិត្យ វាយតម្លៃ យ៉ាង យកចិត្តទុកដាក់ លើ សំណេរ របស់ បេក្ខជន សរុប ១០៥ រូប ដែល បាន ផ្ញើ មក តាមរយៈ សេវា ប្រៃសណីយ៍ រួច មក គណៈកម្មការ បាន សម្រេច ជ្រើសរើស សំណេរ មាន ខ្លឹមសារ ល្អ ជាង គេ និង សម្ភាសន៍ ផ្ទាល់ អំពី អត្ថន័យ នៃ សំបុត្រ របស់ បេក្ខជន គណៈកម្មការ បាន សម្រេច ជ្រើសរើស បេក្ខជន ជ័យលាភី ចំនួន ៣រូប ។
អគ្គ នាយកដ្ឋាន ពន្ធដារ លើកទឹកចិត្ត ដល់ អ្នក ប្រកប អាជីវកម្ម លក់ រថយន្ត ទាំងអស់ មក ចុះបញ្ជី និង បំពេញ កាតព្វកិច្ច ពន្ធ ឱ្យ បាន ត្រឹមត្រូវ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត កែន សម្បត្តិ អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន បង្ហាញ ពី អត្ថប្រយោជន៍ ដែល សហគ្រាស នឹង ទទួលបាន បន្ទាប់ពី បាន ចុះបញ្ជី ពន្ធដារ និង បាន លើកទឹកចិត្ត ដល់ អ្នក ប្រកប អាជីវកម្ម លក់ រថយន្ត ទាំងអស់ ចុះបញ្ជី ពន្ធដារ និង បំពេញ កាតព្វកិច្ច ឱ្យ បាន ត្រឹមត្រូវ ។
ការជំរុញ របស់ លោក បណ្ឌិត កែន សម្បត្តិ ធ្វើឡើង ក្នុង កម្មវិធី កិច្ចប្រជុំ ពិភាក្សា អំពី ការផ្តល់ សេវា ពន្ធដារ ជូន សហគ្រាស ទិញ - លក់ រថយន្ត ដើម្បី ជំរុញ ការចុះបញ្ជី ពន្ធដារ និង ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ នៅ ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២៣ ។
កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី លោក ហេង សុខ ណាង អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង មាន ការចូលរួម ពី លោក ឧកញ៉ា ឈុន គឹម ស្រ៊ុន ជា ប្រធាន សមាគម អ្នកលក់ យានយន្ត កម្ពុជា និង សមាជិក សមាជិកា នៃ សមាគម អ្នកលក់ យានយន្ត កម្ពុជា សរុប ចំនួន ៥០ រូប ។
បណ្ឌិត កែន សម្បត្តិ បាន បញ្ជាក់ ថា គិត មកដល់ ពេលនេះ មាន សហគ្រាស ប្រកប អាជីវកម្ម លក់ យានយន្ត ចំនួន ៥១៨ សហគ្រាស ហើយ ដែល បាន ចុះបញ្ជី ពន្ធដារ រួចរាល់ និង កំពុង បំពេញ កាតព្វកិច្ច សារពើពន្ធ នៅ កម្ពុជា ។
លោក បណ្ឌិត ក៏ បាន អំពាវនាវ ដល់ អ្នក ប្រកប អាជីវកម្ម លក់ រថយន្ត ទាំងអស់ ជា សមាជិក និង មិន មែន ជា សមាជិក សមាគម ព្យាយាម ឈ្វេងយល់ ឱ្យ កាន់តែ ច្បាស់ ថែម ទៀត នូវ បទប្បញ្ញត្តិ នីតិវិធី នៃ ការចុះបញ្ជី ពន្ធដារ ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ និង លើកទឹកចិត្ត អ្នក ប្រកប អាជីវកម្ម លក់ រថយន្ត ទាំងអស់ នៅ កម្ពុជា ចូល ខ្លួន ចុះបញ្ជី ពន្ធដារ និង បំពេញ កាតព្វកិច្ច ឱ្យ បាន ត្រឹមត្រូវ ដើម្បី លើកកម្ពស់ វប្បធម៌ បង់ ពន្ធ និង អនុលោម ភាព សារពើពន្ធ នៅ កម្ពុជា ។
លោក ហេង សុខ ណាង អគ្គ នាយក រង ពន្ធដារ បាន ថ្លែង ថា កិច្ចប្រជុំ នេះ ឆ្លុះបញ្ចំាង ឱ្យ ឃើញ ពី ការយកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការឈ្វេងយល់ ឱ្យ បាន កាន់តែ ស៊ីជម្រៅ ថែម ទៀត នូវ កាតព្វកិច្ច ចុះបញ្ជី ពន្ធដារ និង ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ របស់ អ្នកលក់ យានយន្ត នៅ កម្ពុជា ។
លោក សូម លើក លើកទឹកចិត្ត ដល់ សមាជិក នៃ សមាគម អ្នកលក់ យានយន្ត កម្ពុជា ឱ្យ ចូលរួម ជំរុញ និង ចង ក្រង ពង្រីក សមាជិក ឱ្យ បាន កាន់តែ ច្រើន ដើម្បី ចូលរួម ចុះបញ្ជី ពន្ធដារ និង បំពេញ កាតព្វកិច្ច សារពើពន្ធ ឱ្យ បាន ត្រឹមត្រូវ សំដៅ ធានា នូវ តម្លាភាព និង ការប្រកួតប្រជែង ដោយ ស្មើភាព រវាង អ្នក ប្រកប អាជីវកម្ម លក់ យានយន្ត ទាំងអស់ ៕
