បណ្តោយ ឱ្យ គេ កេង ចំណេញ ពី អាមេរិក ។
គ្រូ ស្នេហ៍ ភាគ ទី១ ចេញផ្សាយ ព្រឹក នេះ !
ជនរងគ្រោះ ស្លាប់ ដោយសារ ចាក់ និង កាប់ ចុង ស្រួច ។
វា ពិតជា គួរឱ្យ សោកស្តាយ ប៉ុន្តែ ក៏ សប្បាយ ចិត្ត ក្នុង ពេល តែ មួយ ព្រោះ ខ្ញុំ ទើបតែ ដឹង ថា គាត់ នឹង នៅ ជាមួយ ខ្ញុំ ជានិច្ច ។
អ្នកកាសែត ចំនួន ១២នាក់ ប៉ុណ្ណោះ នឹង ត្រូវ ជ្រើសរើស ឱ្យ ចូលរួម វគ្គ នេះ ។
ខណៈ គ្រប់ គ្នា កំពុងតែ ស្រមៃ ចង់បាន រថយន្ត ដ៏ ទំនើប ៗ
រួច ធ្វើការម៉ាស្សា ថ្នម ៗ
ខោ ប្រភេទ នេះ មាន ភាព
ទី៤ - ព្រះភិក្ខុ សង្ឃ ទាំងនោះ គឺជា ឯ ហិភិក្ខុ ដូចគ្នា ទាំងអស់ ៕
រៀន ស្តាប់ ពី អ្វី ដែល អ្នកដទៃ និយាយ ទាក់ទង នឹង បទពិសោធន៍ របស់ ពួកគេ ។
ព្រោះ ព្រះអម្ចាស់ ផ្ទាល់ ទ្រង់ យាង នាំមុខ គេ ។
ទន្ទឹម គ្នា ដែល តារា ចម្រៀង ជើង ចាស់ ម្ចាស់ បទ ទូរស័ព្ទ ប្រាប់ ផង លោក សាន ផានិត កាលពី ថ្មី ៗ
សម្តេច គ្រោង វិលត្រឡប់ មកវិញ នៅ ថ្ងៃទី ២៥ ខែឧសភា ៕
រហូតមកដល់ នឹង ពេល នេះ បុរស នោះ មាន ស្ថានភាពធូរស្រាល វិញ ហើយ ៕
ម្ចាស់ ស្ថាប័ន នានា ផ្តាច់ ចរន្ត អគ្គិសនី ១ ម៉ោង ដើម្បី ទប់ស្កាត់ ការប្រែប្រួល អាកាសធាតុ ។
ដួង ម៉ានិច ចាប់ផ្តើម ធ្វើ ហើយ …
ជំនាន់ ក្រោយ ឱ្យ បាន ចេះដឹង និង បន្ត រក្សា កេរ្តិ៍ តំណែល ទាំងអស់ នោះ បាន គង់វង្ស ល្អ រហូតដល់ សព្វ ថ្ងៃ … ។
ជា បន្ត សូម ស្តាប់ ការពន្យល់ បកស្រាយ ព…
វិធី កាត់បន្ថយ គួរតែ ព្យាយាម រក អ្វី សប្បាយ ៗ
សារឿន ងាក មក ឆ្លើយ ដោយ ម៉ឺងម៉ាត់ ៖
ម៉េច មិន ប្រាប់ គាត់ ផង ព្រោះ គាត់ ទើប ចាញ់បោក គេ ថ្មី ៗ
ខឹង គ្នា និយាយ ចេញមក ឈ្លោះគ្នា មួយ ប្រាវ មិន និយាយ រក គ្នា មួយ ថ្ងៃ ឬ ពីរ ថ្ងៃ បន្ទាប់មក ត្រូវ គ្នា វិញ មាន អី មិន ល្អ ។
ព្រមទាំង អោយ យើង រស់ នៅ បាន បរិសុទ្ធ
កំណត់ហេតុ នេះ បញ្ជាក់ ថា ៖
ធ្វើ ចិត្ត ឱ្យ ស្ងប់ ហើយ កុំ ធ្វើឱ្យ គាត់ កាន់តែ ឈឺចាប់ ។
ធ្វើអោយ យើង ខឹង នោះ យើង នឹង ដាក់ទោស នាង តាម អំពើ ដែល នាង ប្រព្រឹត្ត គឺ នាង បាន ប្រព្រឹត្ត អំពើ ដ៏ គួរអោយ ស្អប់ខ្ពើម ថែម ពីលើ អំពើ ដ៏ ថោក ទាប - នេះ ជា ព្រះបន្ទូល របស់ ព្រះជា អម្ចាស់ ។
ដូចនេះ បើ យក គេ ទៅ ប្រៀបធៀប ជាមួយ អ្នកដទៃ នឹង ធ្វើឱ្យ គេ មាន អារម្មណ៍ អាប់ ឱន មុខមាត់ មិន ខាន ។
ខ្លួន ព្រោះ ពួកគេ សុទ្ធតែ មាន ប្រពន្ធ កូន ដូចគ្នា មិន មែន ធ្វើ រួម បែប នេះ ទេ ។
នៅក្នុង ប្រទេស ដូចជា សហរដ្ឋ អាមេរិក កាណាដា បុគ្គល ម្នាក់ ៗ
គួរតែ ចៀស ឱ្យ ផុត ពី អាហារ ទាំង នេះ
ដែល ជន រោង គ្រោះ ជួប ឬ មិន ជួបប្រទះ
ការក្រើន រំឮក នេះ បាន ធ្វើឡើង ក្រោយ ការរកឃើញ កាលពី ពេល ថ្មី ៗ
ហេតុ ដូចនេះ សូម កុំ ទុក យូរ គួរ រក ការព្យាបាល ជាបន្ទាន់ ។
ប៉ុន្តែ ផ្លូវ ដើរ តាម
និង ការអភិវឌ្ឍ ថ្មី ។
បណ្តា អ្នក ដែល មាន ជំនឿ ទាំងឡាយ អល់ ឡោះ បាន ដាក់ កាតព្វកិច្ចបួស ទៅ លើ ពួក អ្នក ដូច ដែល ទ្រង់ បាន ដាក់ កាតព្វកិច្ច បួស នេះ ទៅ លើ មនុស្ស ជំនាន់ មុន ដែរ ។
លោក ថា បើ នៅតែ បណ្តោយ ឱ្យ បញ្ហា នេះ កើតមាន នឹង បង្ក ជា គុណវិបត្តិ ធ្ងន់ធ្ងរ ដល់ ជីវភាព ពលរដ្ឋ ជាដើម ៖
ពលរដ្ឋ មិន សាទរ ចំពោះ ជំលោះ រវាង អ្នកនយោបាយ ខ្មែរ សព្វ ថ្ងៃ
រាស្ត្រ ល្ងង់ខ្លៅ អ្នកដឹកនាំ មិន ច្បាស់លាស់ បូករួមគ្នា ជា បញ្ហា សង្គម ។
នៅក្នុង ភាគ ច្រើន ដង ធាតុ នេះ នឹង ឈានដល់ ភាគ ច្រើន នៃ ប្រទេស ក្នុង រយៈ៨ទៅ ១៥ ថ្ងៃ ធ្វើការ ។
គាត់ បាន ចូល បំពេញ កាតព្វកិច្ច យោធា នៅ អាយុ ១៩ ឆ្នាំ និង បញ្ចប់ នាទីនេះ ក្នុង ឆ្នាំ ២០១៤ ។
យ៉ាងណាមិញ ក្រោយពី ញ៉ាំ អាហារ ត្រាំ រួច ចូរ កុំ ភ្លេច លាង សម្អាត មាត់ ជាមួយ ទឹក និង ដុស សម្អាត ធ្មេញ យ៉ាងហោចណាស់ មួយ ម៉ោង ក្រោយ ។
របស់ ពួកគេ ឱ្យ លេង ជាមួយ មិត្តភក្តិ តាមរយៈ បច្ចេកវិទ្យា ។
ដែល បង្កឱ្យ មាន អស្ថិរភាព នយោបាយ ឬ ភាពវឹកវរ ក្នុង តំបន់ និង ពិភពលោក ។
នៅក្នុង វេបសាយ របស់ យើង និង អាច ដោន ឡូត ទុក ស្តាប់ បាន ដោយ គ្រាន់តែ ចុះ ឈ្នោះ ជាមួយ វេបសាយ យើង ប៉ុណ្ណោះ ។
នាយក រដ្ឋមន្ត្រី ស៊ើបអង្កេត ចៅក្រម ហើយ ។
ភាពតានតឹង ដែល កំពុង បន្ត នេះ បាន រារាំង ដល់ ការសិក្សា ស្រាវជ្រាវ ដ៏ គ្រប់ ជ្រុងជ្រោយ ទៅ លើ ស្រទាប់ ប្រេង និង ឧស្ម័ន ។
ទោះបី បែប ណា ពេលនេះ ពួកគេ មាន បំណង ចង់ បែងចែក ទ្រព្យសម្បត្តិ គ្នា ។
ការវាយប្រហារ និង ការគម្រាមកំហែង អ្នកការពារ សិទ្ធិ មនុស្ស នៅ ឆ្នាំ ២០០៧ កម្ពុជា លីកាដូ
ម្យ៉ាង ដែរ បើ សម័យ នេះ មាន នៅសល់ ប្រហែលជា មាន ស៊ុប ដាយណូស័រ ហើយ មើល ទៅ
មាន ន័យ ថា កម្មករ រោងចក្រ នឹង ទទួលបាន ៦០% នៃ ប្រាក់ខែ គោល របស់ ពួកគេ នៅពេល រោងចក្រ ប្រឈម នឹង ការរគ្មាន ដំណើរការ ។
ប្រជាពលរដ្ឋ នៅក្នុង តំបន់ ដែល រងគ្រោះ នេះ មិន មាន អគ្គិសនី ប្រើប្រាស់ នោះ ទេ ។
ខ្ពង់រាប នៅ រដ្ឋ អារី ហ្សូណា មាន សណ្ឋាន ចម្លែក ពី គេ គ្មាន ពីរ
វា ជា បច្ចេកវិទ្យា ដែល បង្កើតឡើង ដើម្បី សុវត្ថិភាព ៕
កញ្ញា សុថា រី ជា ម្ចាស់ សិប្បកម្ម ធុង បរិស្ថាន
ជួន គេ ថ្លោះ ធ្លោយ បង្ហាញ មក ដោយ អចេតនា ។
ក្រុមហ៊ុន បូម ខ្សាច់ បង្ក ការក្តៅក្រហាយ ដល់ ពលរដ្ឋ
ដើម្បី ធ្វើ ទំនាក់ទំនង ជាមួយ មនុស្ស និង និយោជក អោយ បាន ច្រើន នៅក្នុង រោងចក្រ របស់ ពួកគេ ។
ធ្វើ ចុះ ធ្វើឡើង ដូចនេះ ១សន្ទុះ នឹង បន្ថយ បាន ការឈឺ ឆ្មេញ យ៉ាង ច្រើន ។
គម្រោង ដទៃ ទៀត កំពុង ស្ថិត នៅ បន្ត កន្ទុយ គ្នា ។
ខ្ញុំ នឹង បន្ត រកមើល ទេសភាព ថ្មី ៗ
១ការខ្វែងគំនិត គ្នា
ន័រវេស - រីករាយ ឆ្នាំ ថ្មី
កុំ ឱ្យ វា បំផ្លាញ សន្តិភាព ។
