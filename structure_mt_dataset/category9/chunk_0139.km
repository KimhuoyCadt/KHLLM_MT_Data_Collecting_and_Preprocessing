តាមពិត កូនប្រុស សង្ហា ទាំង៣ របស់ ព្រាប សុវត្ថិ ទៅ លេង អង្គរ ដើម្បី តែ ធ្វើ រឿង មួយ នេះ
ព្រះអង្គ ចូលចិត្ត សក់ ខ្លី ធម្មតា ។
នាង និយាយ ថា បើ តាម ការ ឱ្យដឹង ពី ម្ចាស់ ផ្សៀន សៀរ បាន ប្រាប់ ថា គ្រាន់តែ ដឹង ថា ខ្ញុំ នឹង មាន វត្តមាន នៅ អូស្ត្រាលី បងប្អូន នៅ ទីនោះ បាន អន្ទះសា ចង់ ឃើញ រូប ខ្ញុំ ។
លុះ ដល់ ព្រះយេស៊ូ បាន សំដែង សិរី រុងរឿង ហើយ ទើប គេ នឹកឃើញ ថា ហេតុការណ៍ ទាំងនេះ មាន ចែង ទុក អំពី ព្រះអង្គ ហើយ មហាជន ក៏ បាន ធ្វើ កិច្ចការ ទាំង ប៉ុន្មាន ថ្វាយ ព្រះអង្គ ស្រប តាម គម្ពីរ ដែរ ។
វា អាច រកបាន នៅក្នុង ៖
ការប្រែប្រួល ផ្លូវចិត្ត របស់ ចោរ ម្នាក់ នេះ បាន ផ្តល់ កម្លាំងចិត្ត ជំរុញ ខ្ញុំ ឱ្យ ធ្វើ សប្បុរសធម៌ ច្រើន ជាង មុន ៕
ស្រលាញ់ ត្រង់ ពាក្យ ក្បាល វ៉ាល់ ហ្នឹង តែម្តង … និយាយ ដូច ខ្ញុំ អញ្ចឹង ហេហេហេ !
គឺ មាន ភាពច្នៃប្រឌិត រៀង ៗ
ឡ.ម និង គ.ល ជាមួយនឹង រូបថត របស់ អ្នកធ្វើ អង្កួច ម៉ុង គើយ
ឥទ្បូវ សាម៉ី ជន ឯកឧត្តម កឹម សុខា បាន បញ្ជាក់ ផ្ទាល់ខ្លួន ច្បាស់ ៗ
រំពេច នោះ ជឺ អ៊ីបាន ដឹង ថា ខ្លួន និយាយ ខុស និង កែប្រែ ពាក្យ វិញ ថា ថ្ងៃ នេះ ពិតជា រីករាយ ណាស់ ៗ
សម្រាប់ កុមារ ដើម្បី ដោះស្រាយ បញ្ហា នៅក្នុង មុខវិជ្ជា នោះ ។
គាត់ កំពុង ធ្វើ ការស្រាវជ្រាវ ។
វេទនា សញ្ញា សង្ខារ វិញ្ញាណ ក៏ ដូច្នោះ ដែរ ។
ប៉ុន្តែ ឥឡូវ ដឹង ច្បាស់ ហើយ ថា ខ្ញុំ អូខេ សម្រាប់ ការប្រកួត នេះ ឱ្យ ច្បាស់ ។
ក្មេងប្រុស ម្នាក់ ត្រូវបាន ឪពុក ម្តាយ យក ទៅ បោះបង់ ចោល …
៥១យន្តហោះ ក្នុង រយៈពេល ២នាទី ស្រុក ខ្មែរ ស្នេហ៍ ខ្ញុំ
ទ្វេ ភាគី លើ វិស័យ នានា ដូចជា ៖
ខ្ញុំ គេង លក់ ភ្លាម ៗ
តុលាការ ព្រហ្មទណ្ឌ អន្តរជាតិ បង្កើតឡើង ក្រោម លក្ខន្តិកៈ មួយ ដែល គេ បាន ព្រមព្រៀង គ្នា នៅ ទីក្រុង រ៉ូម ប្រទេស អ៊ីតាលី ។
ប៉ុន្តែ គេ ក៏ មិន សូវ យល់ ប៉ុន្មាន ដែរ ព្រោះ បើ តាម ទម្លាប់ នៃ ការសាងសង់ សំណង់ ថ្មី ៗ
ការតាំងចិត្ត និង ការតស៊ូ នាំមក នូវ ភាពជោគជ័យ
វា គឺ តារា ដែល តាម ស្វែងរក ការពិត ។
ណឹង ប្អូន ខ្ញុំ វា បាន លេខ ១ទូទាំង ប្រទេស តែ យើង មកពី ខេត្រ កំពង់ចាម ។
លោក ប៉ែន សុវិជាតិ បាន បញ្ជាក់ ទៀត ថា ការងារ នេះ ក៏ ត្រូវបាន អនុវត្ត ដើម្បី ឆ្លើយតប ភ្លាម ៗ
នោះ ជា ការបំពុល បរិយាកាស ដ៏ អាក្រក់ បំផុត ដែល ទីក្រុង ញូវ ដែល្លី ជួបប្រទះ រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ដែល ជារឿយ ៗ
របស់ និស្សិត ខ្មែរ ជារៀងរាល់ ឆ្នាំ ។
ការសិក្សា បាន បង្ហាញ ថា មនុស្ស ស្រី ជាច្រើន គិត ថា ការរំខាន ខាង ផ្លូវភេទ ក្លាយជា ចំណែក មួយ នៃ ជីវិត ប្រចាំ ថ្ងៃ ប៉ុន្តែ វា មិន មែន ជា ការពិត ទាំងអស់ ឡើយ ។
សូម ជម្រាប ថា ពាក្យ ស្រុក
ដូច្នេះ ខ្ញុំ មាន រឿង ច្រើន យ៉ាង ដែល ត្រូវ គិត ។
អ្នក តាម អ្នក តាម ហ្វេសប៊ុក ។
លោក អ្នក អាច ទំនាក់ទំនង មក យើងខ្ញុំ តាមរយៈ
តាម ការប៉ាន់ស្មាន រៀងរាល់ ៤០ វិនាទី នរណា ម្នាក់ នៅ សហរដ្ឋ អាមេរិក មាន ការគាំង បេះដូង ។
ពី អតីតកាល នោះ , ខ្ញុំ ក៏ សំរេច ចុះផ្សាយ ដើម្បី ចែករំលែក នៅ ទីនេះ តែម្តង ទៅ ។
ហិប បោះឆ្នោត គួរ បង្កើតឡើង នៅក្បែរ កន្លែង ដែល ពួកគេ ធ្វើការ ។
ចំពោះ បងប្អូន ខ្វះ ឯកសារ ឧទាហរណ៍ គេ តម្រូវ ឯកសារ ៥តែ យើង មាន តែ ៣ យើង គាត់ សម្រេច យ៉ាងម៉េច ។
៩ពេល ប្រជាជន ទាំងមូល ឮ ព្រះបន្ទូល ដែល មាន នៅក្នុង ក្រឹត្យ វិន័យ ពួកគេ នាំគ្នា យំ ។
ខ្អុំ ចង់ឱ្យ អ្នក ដាក់ ផ្សាយ ដូចជា ការបរិយាយធម៌ ជាដើម ។
បច្ចុប្បន្ន , ភាសា ខាងក្រោម អាច ប្រើ បាន ៖
យើង តែងតែ ប្រព្រឹត្ត ល្អ ចំពោះ លោក និង អោយ លោក ចាកចេញមក ដោយ សុខសាន្ត ហើយ ឥឡូវនេះ លោក ក៏ បាន ទទួល ព្រះពរ ពី ព្រះអម្ចាស់ ថែម ទៀត ផង ។
ដូច្នេះ ខ្ញុំ បាន បង្ហាត់ បង្រៀន ពួកគាត់ ឱ្យ ចេះដឹង ពី របៀប ដាំដុះ ចិញ្ចឹម សត្វ ពាហនៈ នានា និង ត្រី ជាដើម ។
ក្រោយមក ប៉ូលិស ក៏ បាន រកឃើញ អតីត សង្សារ ចាស់ របស់ បុរស នោះ ដែល គាត់ មាន អាយុ ៧១ ឆ្នាំ ហើយ ។
អាណានិគម បារាំង មិន ជួយ រហូត ថ្ងៃ មួយ
លោក បាន និយាយ ថា លោក គិត ថា អត្តសញ្ញាណ នយោបាយ នាំឱ្យ លោក និង ពួក មិត្តភក្តិ លោក មាន ជំនឿ ថា ពួកគេ ជា អ្នក ប្រជាធិបតេយ្យ ដែរ ។
បំផុត ពពោះ មាន ផ្ទៃពោះ កំពុង ពពោះ ?
ការងារ ល្អ ប្រសើរ សម្រេចបាន ភាព ឆ្នើម ក្នុង គ្រប់ ភារកិច្ច ។
ទាំងនេះ គឺជា ការចែករំលែក ទៅដល់ កុមារ ទាំងឡាយ និង មន្ទីរពេទ្យ ដែល កំពុង ដង្ហោយ រក ការជួយ ។
រថយន្ត ដឹក អេត ចាយ ផ្ទុក គ្រឿង ដែក ធ្ងន់ ពេក ក្រឡាប់ តាម ផ្លូវ
ព្រះស្រី សុរិយោ ពណ៌ មេទ័ព ខ្មែរ ឃើញ ដូច្នោះ ទ្រង់ ខ្ញាល់ ជាខ្លាំង ។
ការវាយប្រហារ នាយក រដ្ឋមន្ត្រី កម្ពុជា នា ពេល នោះ ត្រូវបាន គេ មើលឃើញ ថា បក្ស ណាមួយ ប្រតិកម្ម ឡើយ ។
តើ ការផ្លាស់ប្តូរ បែប ណា ដែល ល្អ បំផុត សម្រាប់ កម្ពុជា ?
យើង មិន អាច បញ្ចេញ សំឡេង អំពី ការខកចិត្ត របស់ យើង និង ត្អូញត្អែរ អំពី អ្វី ដែល ខុស ប្រក្រតី បាន ទេ បើ គ្មាន ការបោះឆ្នោត និង ការអនុវត្ត អំណាច របស់ យើង ដើម្បី ធ្វើឱ្យ វា ត្រឹមត្រូវ ឡើងវិញ ។
បេះដូង កូនក្មេង លោត ញាប់ ជាង បេះដូង មនុស្ស ចាស់ មែន ទេ ?
លោក ត្រូវបាន គេ ឃុំ ទុក នៅ កន្លែង សំងាត់ មួយ ។
ខ្ញុំ នឹង បន្ត ជួប ជាមួយនឹង អ្នក នេះ អ្នក នោះ ក្នុង ឋានៈ ខ្ញុំ ជា នាយក រដ្ឋមន្ត្រី នៃ រាជ រដ្ឋាភិបាល ។
ការសម្ងាត់ របស់ អ្នក គឺ មាន សារៈសំខាន់ សម្រាប់ យើង ។
ដែល មនុស្ស ស្រី ចង់បាន ក្នុង ពេល រួម ភេទ
មនោសញ្ចេតនា កុំ ឱ្យ ការងារ ឥទ្ធិពល មិន ល្អ ដល់ រឿង មនោសញ្ចេតនា ៕
កុំ ឱ្យ ប្រើ ទូរសព្ទ ស្មាតហ្វូន មុនពេល ពួកគេ ចូលរៀន ថ្នាក់ អនុវិទ្យាល័យ ។
ពួកគេ ដឹង អំពី បរាជ័យ របស់ ខ្លួន ដូច្នេះ គោលដៅ របស់ ពួកគេ គឺ ធ្វើឱ្យ មាន ការអន្តរាយ មិន គ្រាន់តែ ទៅ លើ កងកម្លាំង សន្តិសុខ អ៊ីរ៉ាក់ តែ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ ប្រព្រឹត្តទៅ លើ ជនរងគ្រោះ ដែល មិន ដឹង អ្វី សោះ ឬ ជន ណា ម្នាក់ ដែល ព្យាយាម គេចខ្លួន ចេញ ។
ចំណែកឯ កាលបរិច្ឆេទ ជាក់លាក់ សម្រាប់ ការបោះឆ្នោត ជាតិ នៅ មិន ទាន់ ត្រូវបាន គេ កំណត់ នៅឡើយ ទេ បើ ទោះបីជា របប យោធា ថៃ បាន សន្យា រៀបចំ ការបោះឆ្នោត ជាតិ នៅ ឆ្នាំ ២០១៧ នេះ ក៏ដោយ ។
កន្លែងណា គេ មិន បិទ ទីលាន ប្រជាធិបតេយ្យ គេ យកមក បិទ កើត ។
ព្រោះ វា នឹង ធ្វើឱ្យ អ្នក ងាយស្រួល ងងុយដេក នឹង រំខាន ពី អ្នកដទៃ ។
អាពូជ ឆ្កែ ដាក់ ឈ្មោះ ថា ប្រផ្នូល នេះ សូម្បីតែ ឈ្មោះ វា លែង ហាន ប្រើ បាត់ ទៅ ហើយ ។
ឥឡូវ ចូរ ផ្តាច់ ទំនាក់ទំនង សង្គម !
ហេតុ អ្វី បានជា អ្នក ទាំងនេះ មិន ព្រម ទៅ បោះឆ្នោត ?
ត្រូវ ជន មិន ស្គាល់ មុខ ច្រក ចូលក្នុង ថង់ ខ្មៅ មួយ ទាំង ខ្លួន គ្មាន ក្រណាត់ បិទបាំង រាងកាយ ឡើយ …
ខ្ញុំ ក៏ ចូលចិត្ត ឈ្មោះ នេះ ដែរ ។
វា គឺជា ពានរង្វាន់ តែ មួយ គត់ ដែល ភាពយន្ត នេះ ទទួលបាន បន្ទាប់ពី ចូលរួម ក្នុង ពិធី ប្រគល់ ពានរង្វាន់ ពេល ល្ងាច ជាមួយនឹង ការតែងតាំង សម្រាប់ ពានរង្វាន់ ដល់ ទៅ ប្រាំពីរ ។
នេះ មាន អ្នកស្រាវជ្រាវ ក្មេង ៗ
ប្រសិនបើ យើង អាច ទទួលបាន ការយកចិត្តទុកដាក់ និង ទទួលបាន ប្រាក់ កម្ចី ពី ប្រភព ទុន នៅក្នុង ស្រុក នោះ យើង សង្ឃឹម ថា អត្រា ការប្រាក់ របស់ នឹង អាច ចុះ ថោក ជាង នេះ បាន ទៀត ។
នា ថ្ងៃ ខាងមុខ នឹង មាន ផែនការ មេអភិវឌ្ឍន៍ បណ្តាញ លូ ទឹក កខ្វក់ និង លូ ទឹកភ្លៀង
វា ពិត ជា រឿង គួរឱ្យ ចាប់អារម្មណ៍ សម្រាប់ ខ្ញុំ ។
លោក ត្រាំ បាន ប្រកាស នៅ ថ្ងៃសុក្រ ថា នឹង បញ្ឈប់ ការ…
អ្នក ជឿ ឈរ នៅ ខាង ព្រះជា ម្ចាស់ ប្រឆាំង នឹង បាប ប៉ុន្តែ អ្នក មិន ជឿ ឈរ ខាងបាប ប្រឆាំង នឹង ព្រះជាម្ចាស់ ។
អញ នឹង ត្រឡប់មក លេង ទៀត ឱ្យ បាន ញឹកញាប់ ។
ឱសថ ទាំងឡាយ ណា ដែល ហួស ថ្ងៃបរិច្ឆេទ
វា គឺជា ល្បែង អុក ហើយ ខ្ញុំ មិន ចង់ឱ្យ អ្នកណា ម្នាក់ ដឹង ពី ការគិត របស់ ខ្ញុំ នោះ ទេ ។
ខ្ញុំ មិន ដែល រង សម្ពាធ ទោះ ដោយ ផ្ទាល់ ឬ មិន ផ្ទាល់ ក៏ដោយ ពី មន្ត្រី អង្គ នីតិប្រតិបត្តិ ណា ម្នាក់ ទេ ដែល ក្នុង នោះ មាន ទាំង អ្នក ដែល ធ្វើការ នៅ សេតវិមាន ឬ នៅ ទីភ្នាក់ងារ GSA ផងដែរ ទាក់ទិន ទៅនឹង ទម្ងន់ ឬ ក៏ ពេលវេលា នៃ ការសម្រេចចិត្ត របស់ ខ្ញុំ នេះ ៕
ខេត្ត បន្ទាយមានជ័យៈ បន្ទាប់ពី មាន អនុសាសន៍ ធ្ងន់ ៗ
ឪពុក សម្លាប់ កូនស្រី ខ្លួន ឯង ៣នាក់ រួច ចងក សម្លាប់ ខ្លួន តាម ក្រោយ
ជា លទ្ធផល កាលពី ដើម ខែ នេះ រឿងរ៉ាវ នេះ បាន លេចឮ ទៅដល់ កូនប្រុស របស់ ប្អូន ប្រុស ឡាន់ ។
ពេល សប្បាយ មិន ចេះ ការពារ ខ្លួន រហូត នាំ ទុក្ខ ដល់ គ្រួសារ បែប នេះ គឺ សប្បាយ មិន ចេះ គិត ។
សូម ព្រះអង្គ កុំ បោះបង់ និង បំភ្លេច ពួកយើង ចោល ឡើយ ។
ការប្រកប ការងារ នៅ ថ្ងៃ នេះ វិញ លោក អ្នក ត្រូវ មើល មុខ ក្រោយ ប្រយ័ត្ន ត្រូវ គេ ទម្លាក់ កំហុស ហើយ គេ បែរជា ទទួល ផលប្រយោជន៍ ទៅ វិញ ។
ពួកគេ កំពុង ធ្វើឱ្យ រដ្ឋ បាត់បង់ ថវិការ ជាតិ ។
គេង ដើម្បី ដាក់ពាក្យ ប្តឹង ជា ផ្លូវការ !
អ្នកភូមិ បាន ប្រាប់ ខ្ញុំ ថា ពួកគេ ឃើញ កូនប្រុស របស់ ខ្ញុំ ក្នុង ទូរទស្សន៍ ។
អាជ្ញាធរ បាន ចាប់ខ្លួន មនុស្ស ជាង ១០០០ នាក់ នៅ ទូទាំង ប្រទេស ។
នៅ ថ្ងៃ ដែល ទូលបង្គំ ជួប ទុក្ខលំបាក ។
នេះ បើ តាម ឱ្យដឹង ពី អគ្គ នាយកដ្ឋាន រដ្ឋបាល ជលផល ។
យើង មាន ទំនុកចិត្ត លើ កិច្ចប្រឹងប្រែង របស់ ឥណ្ឌូនេស៊ី ក្នុង ឋានៈ ជា ប្រធាន អាស៊ាន ។
គេ ឈប់ ទាក់ទង ជាមួយ ខ្ញុំ រហូតដល់ ថ្ងៃ នេះ ៕
ទោះបី យ៉ាងណា នោះ គ្រាន់តែ ជា សម្ម តិកម្ម របស់
សារ នេះ បាន ធ្វើឱ្យ អ្នកគាំទ្រ លោក និង អ្នកនាង ចន ចាន់ លក្ខិណា ចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ខណៈ ដែល ទំនាក់ រវាង លោក និង តារា សម្តែង ជើង ចាស់ រូប នេះ រាង យូរ ក្រែល ទៅ ហើយ នោះ ៕
បើ អ្នក ទទួលទាន អាហារ មិន ស្អាត អាច ធ្វើឱ្យ អ្នក រាក រូស បាន ប៉ុន្តែ ប្រសិនបើ អាហារ ទាំងនោះ មាន ប្រាប់ ពី ថ្ងៃ ផលិត និង ថ្ងៃ ផុត កំណត់ ច្បាស់លាស់ អ្នក ក៏ អាច ទទួលទាន បាន ខ្លះ ៗ
ខ្ញុំ ចង់ឱ្យ រដ្ឋាភិបាល ផ្តល់ ការពារ ល្អ ជាង ហ្នឹង ទៀត ។
របស់ ខ្លះ សូម្បីតែ មហាសេដ្ឋី ក៏ មិន មាន សមត្ថភាព ទិញ ដែរ !
១១ កាលពី ក្មេង ខ្ញុំ និយាយ ស្តី ដូច កូនក្មេង ខ្ញុំ មាន គំនិត ដូចជា កូនក្មេង ហើយ ខ្ញុំ រិះគិត ដូច កូនក្មេង ដែរ ។
ទៅ ថត កុន កាលពី ថ្ងៃអង្គារ ស្រលាញ់ មនុស្ស ម្នាក់ …
៦. បញ្ហា ការចងចាំ
ពួក ឈ្មួញ សុទ្ធតែ អះអាង ដោយ អោយ តំលៃ ខ្ពស់ តែ នៅ ពេល ដែល កសិករ ផលិត បាន
ប៉ុន្តែ កម្ពុជា ក៏ ចង់ ជិតស្និទ្ធ នឹង អាមេរិក ដែរ ។
សួរ ថា តើ ហេតុ អ្វី បានជា យើង ចាំបាច់ មាន សមភាព យេនឌ័រ គឺ ដោយសារតែ ប្រជាជន ជាង ពាក់កណ្តាល គឺជា មនុស្ស ស្រី ។
នេះ ជា ការខិតខំ ប្រឹងប្រែង នៃ រោង ល្ខោ …
គួរឱ្យ ស្តាយ នេះ មិន មែន ជា អំណោយ ដែល គ្រួសារ ខាង កូនកំលោះ មាន លទ្ធភាព ទិញ ជូន នោះ ទេ ។
អ្នក នៅជិត អង្គរ ខ្លះ លំបាក ទទួល ផល ពី ស្នាដៃ ឯក របស់ ដូនតា ខ្លួន
លោក ចាន់ ចេង វិល មក កម្ពុជា វិញ បន្ទាប់ពី ភៀសខ្លួន បាន ២ខែ
លោក ថា អាជ្ញាធរ ពិតជា បាន ជូន ដំណឹង ឱ្យ ពលរដ្ឋ ចាកចេញ ដោយ មិន បាន ប្រាប់ ពី សំណង មែន ។
ចូរ ស្វែងរក វា និង ប្រើប្រាស់ វា អោយ មាន ប្រសិទ្ធភាព ។
ក្រោយមក អ្នក ទាំងអស់ បាន ឡើង លើ ដំបូល យន្តហោះ ហើយ ទះដៃ លោក ត្រាំ ស្រែក ខ្លាំង ៗ
ខ្ងុំ គិត ថា អ្នក សំដែង ដូចជា អៀន អៀន ហើយនិយាយ អត់ សូវ សម ទៀត
អ្នកស្រី ភ័ណ្ឌ ឆ្លើយ យ៉ាង ខ្លី ថា ៖
បើសិនជា ជឿ ទុកចិត្ត ហ៊ុន សែន !
គ្រាន់តែ អនុវត្ត តាម វិធី សាមញ្ញ ៤យ៉ាង ស្បែក ស្រស់ថ្លា នឹង រត់ មក រក អ្នក យ៉ាង ពិតប្រាកដ ។
អំណោយទាន ដល់ មនុស្ស
លោក នឹង ធ្វើ កិច្ចការ នេះ រួម ជាមួយ អ្នកដទៃ ទៀត ដូចជា លោក ហេង ពុទ្ធិកា ។
កប់ បាត់ ជារៀងរហូត ហើយ អ្វី ដែល បាន ដឹង គ្រាន់តែ ដឹង តាម គ្នា ។
ពួកគេ ក៏ វ៉ៃ ល្អ ដែរ តែ អ្នក ប្រដាល់ ទាំង២រូប នេះ មិន សូវ មាន ស្នៀត ទេ គឺ អាង កម្លាំង សុទ្ធសាធ តែម្តង ។
តាម តែ ការ នឹកឃើញ របស់ ខ្លួន តទៅទៀត ឡើយ ។
ដោះស្រាយ ការកកស្ទះ ចរាចរ ទាមទារ ការចូលរួម ពី អ្នកប្រើប្រាស់ ទ្រូង ថ្នល់
លោកតា ដំបង គ្រញូង អត់ ឫទ្ធិ អំណាច និង ចុះចាញ់ អ្នក មាន …
នេះ កំពុង ស្ថិត ក្នុង ហានិភ័យ ។
កប៉ាល់ ទេសចរណ៍ បុក ទូក ប្រណាំង ២នាក់ លិច បាត់ ក្នុង ទន្លេ ពេលនេះ សព អណ្តែត ហើយ
តាមពិត តាម តែ យើង សំព គាល់ សង្គម ខ្មែរ នេះ យើង ឃើញ ថា ពួក ទុច្ចរិត ចូលចិត្ត ជ្រក ក្នង សំលៀកបំពាក់កងទ័ព និង នគរបាល ណាស់ ។
បច្ចុប្បន្ន នេះ នាង គឺជា និស្សិត រៀន នៅ វិទ្យាល័យ មួយ ។
គ្រួសារ ខ្ញុំ អត់ មាន កំហុស អ្វី ទេ ។
យើង គ្រាន់តែ ខ្វះ ការគាំទ្រ ពី សាធារណជន ។
ចោរ ម្នាក់ ដេកលក់ នៅក្នុង រថយន្ត ដែល ខ្លួន បាន លួច
ថ្ងៃ នេះ មិន សមស្រប សម្រាប់ ការបណ្តាក់ទុន រកស៊ី ។
ស្ទើរតែ ទាំងអស់ ក្នុង នោះ គឺ មិន យល់ព្រម ។
៣១ លោក ម៉ូសេងឿងឆ្ងល់ ចំពោះ ហេតុ ដ៏ អស្ចារ្យ ដែល លោក ឃើញ នោះ ណាស់ ។
តើ នាង ខាំ បបូរមាត់ របស់ អ្នក ដែរ ឬ ទេ ឬក៏ គ្រាន់តែ ជញ្ជក់ អណ្តាត របស់ អ្នក ប៉ុណ្ណោះ ?
ពួក ជន ទាំងនោះ បាន ធាក់ ជន្ទក់ ម៉ូតូ អូស នឹង ថ្នល់ ជាតិ ធ្វើឱ្យ ដាច់ និង ឆូត ហើយ បែក ផ្កា ភ្លើង ពេញ ផ្លូវ ។
ចន្លោះ នេះ ផ្លូវ នៅ ពុំ ទាន់ ចាក់ កៅស៊ូ
ឯផលកម្ម មិន សាបសូន្យ ទេ គ្រាន់តែ ទទួល យូរ ឬ ឆាប់ ប៉ុណ្ណោះ
ម៉ោន ការដាក់ ដៃ
លោក បាន បន្ថែម ថា ប្រតិបត្តិការ នេះ និង រួមបញ្ជូល ទាំង ភ្នាក់ងារ អនុវត្ត ច្បាប់ ទាំងអស់ ៕
លោក មានប្រសាសន៍ ថា នាយក រដ្ឋមន្ត្រី ត្រូវការពារ រដ្ឋមន្ត្រី របស់ ខ្លួន ។
អូហ្ស៊ីល បាន និយាយ ថា ជំហរ របស់ ខ្ញុំ គឺ ច្បាស់លាស់ ។
សូម ជម្រាប ថា ប្រាសាទ តូច ៗ
ដូច្នេះ ខ្ញុំ គិត ថា លោក ហ៊ុន សែន នឹង ទុក ចិន នៅជិត ខ្លួន សម្រាប់ ពេលណា លោក ត្រូវការ ។
ហើយ រស់ នៅ យ៉ាង សុខសាន្ត មក ទល់នឹង ពេលនេះ ។
ម៉ាល័យ ភ្លេច ខ្លួន ថ្ងូរ មួយ មាត់ យ៉ាង ខ្លាំង អាសស៊ឺត ៗ
ទ្រង់ ក្លាហាន ហើយ មិន ខ្លាច ប្រថុយ និង មិន ខ្លាច បញ្ហា នោះ ទេ ។
ភាគ ច្រើន នៃ ពួកយើង សុទ្ធតែ បាន ដឹង រួចទៅហើយ អំពី អត្ថប្រយោជន៍ ដ៏ ប្រសើរ នៃ ផ្លែ ចេក ចំពោះ សុខភាព ។
បុគ្គល ដែល មាន សេចក្តីមេត្តា ករុណា ប្រកបដោយ ចិត្ត រីករាយ ក្រៃលែង ប្រៀប បាន ដូចជា កំពូល ភ្នំ ដ៏ សែន ខ្ពស់
ពួកគេ សម្រប ខ្លួន តាម ការផ្លាស់ប្តូរ
តើ នរណា ជា អ្នក ចាប់ផ្តើម សង្គ្រាម អវកាស មុន ?
ល្បី គឹម លីហ្សា ស្នេហា រង្គោះរង្គើ ចង់ លក់ ចិញ្ចៀន រៀបការចាយ
រហូត បាន ទៅជា មហាសេដ្ឋី ។
វា ត្រូវបាន លក់ ៣ទៅ ៤ដង ចាប់តាំងពី ខ្ញុំ នៅ ទីនោះ ។
៥វិធី ជំរុញ ទឹកចិត្ត ខ្លួន ឯង កុំ រង់ចាំ ដល់ អ្នកដទៃ មក ជួយ គាំទ្រ
ការហាត់ នេះ មិន អាចនឹង កំណត់ ពេលវេលា បាន ទេ ។
ខ្ញុំ បើ ធ្វើការ យូរ ៗ
សម្រាប់ មនុស្ស ភាគ ច្រើន ការសរសើរ ដំកើង មិន មែន ជា ការឆ្លើយតប ទី មួយ ចំពោះ ទុក្ខលំបាក ឡើយ ។
ខ្ញុំ បាន ដេកលក់ ទៅ ហើយក៏ ភ្ញាក់ ឡើងវិញ ដ្បិត ព្រះយេហូវ៉ា ទ្រង់ ទប់ទល់ ខ្ញុំ
ខ្ញុំ សង្ឃឹម ថា បង ៗ
ខ្ញុំ ថា ខ្ញុំ គិត ឈប់ ហើយ អាណត្តិ នេះ ខ្ញុំ ចង់ សម្រាក ហើយ ព្រោះ ខ្ញុំ ចង់ ទ្រុឌទ្រោម ហើយ ។
អ្នកស្រី ប្រាប់ ថា លោក កែម ឡី គឺជា មនុស្ស ម្នាក់ ដែល មាន គំនិត ល្អ ៗ
ប៉ុន្តែ ការរៀបចំ ហ្នឹង គឺជា ទ្រង់ទ្រាយ ដែល មាន ការរៀបចំ ទុក ជាមុន ។
ដោយ ញញឹម ថា អាស្រ័យ តាម កាលៈទេសៈ នឹង មនុស្ស ដែរ ។
ស្រុក ស្រីសន្ធរ ៣នាក់
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ៧នាក់ ខាងលើ ត្រូវបាន សមត្ថកិច្ច កសាង សំណុំរឿង ចាត់កាតាម នីតិវិធី ៕
នេះ មនុស្ស ជាច្រើន រំពឹង ថា លោក អាចនឹង ទៅ ដឹកនាំ ក្រុម ជម្រើសជាតិ ហុល្លង់ យ៉ាងណា ក៏ដោយ ។
ក្លាយទៅជា អ្នកចាំ ទទួលយក ប្រាក់ខែ របស់ គង់ ក្រឹង អស់ ទៅ ហើយ ។
ទោះ មិន បាន ការ ប៉ុណ្ណា ក៏ គ្រាន់បើ ជាង មនុស្ស មួយចំនួន ។
ជាច្រើន ទាំង ការងារ នៅ ទូរទស្សន៍ ក៏ ដូចជា ការងារ ផ្ទាល់ខ្លួន ។
ការសិក្សា ដែល ធ្វើជាមួយនឹង អង្គការ ពលកម្ម អន្តរជាតិ ILO ក៏ បាន បង្ហាញ ថា ស្ទើរតែ បី ភាគ បួន នៃ អ្នក ដែល បាន ស្លាប់ បណ្តាល មកពី ធ្វើ ការ ច្រើន ម៉ោង គឺ បុរស ឬ មនុស្ស វ័យ ចំណាស់ ។
ពិព័រណ៌ ឧស្សាហកម្ម ចំណីអាហារ អន្តរជាតិ នៅ វៀតណាម ឆ្នាំ ២០១៦នឹង ក្លាយជា ព្រឹត្តិការណ៍ ដ៏ ធំ បំផុត សម្រាប់ អ្នក វិនិយោគ
៣. បង្កើន ម៉ាស ឆ្អឹង
ការងារ ពុំ មាន អ្វី ខុស ប្រក្រតី កើតឡើង ។
ជា ឈ្មោះ កូនប្រុស ពិតជា មាន ន័យ ណាស់ ។
ឈ្ងុយ ដល់ ផ្ទះ កើត ។
មន្ត្រីរាជការ និង ក្រុមហ៊ុន ឯកជន នានា តម្រូវ ឱ្យ ឈប់ សម្រាក នៅ ថ្ងៃ នេះ ៕
ខ្វះ ការគាំទ្រ គឺជា មូលហេតុ មួយ ដែល មនុស្ស យើង ផ្លាស់ប្តូរ ការងារ ។
គ្រោង នឹង មិន អនុញ្ញាតឱ្យ អ្នកគាំទ្រ ពី ក្រៅ ប្រទេស ចូលរួម ព្រឹត្តិការណ៍ អូឡាំពិក
យ៉ាងណា ពួកគេ នៅ ក្មេង នៅសល់ ពេលវេលា ច្រើន ជាង ខ្ញុំ ហាហា ហា ។
ផលប្រយោជន៍ សាច់ ត្រី មួយ ប្រភេទ នេះ ពិតជា ពិសេស ចំពោះ កែវភ្នែក ទាំង គូ របស់ លោក អ្នក …!
ពួកគេ ញ៉ាំ អាហារ ពេលល្ងាច ជាមួយគ្នា និង ចំណាយ ពេល នៅ ជាមួយគ្នា តែ មួយ យប់ ហើយ ពួកគេ ក៏ បាន ចាកចេញពី សណ្ឋាគារ វិញ នៅ ថ្ងៃ បន្ទាប់ ។
៥ក្រុម ជំនុំ នានា ក៏ មាន ជំនឿ កាន់តែ មាំ មួន រៀងរាល់ ថ្ងៃ ហើយ មាន គ្នា កាន់តែ ច្រើន ជាលំដាប់ ។
តាម ឪពុក ក្មេងប្រុស នេះ ៖
នៅ ពេល ដែល កូន យំ រក រឿង ឪពុក ម្តាយ ខ្លះ នឹង ប្រើ ទូរស័ព្ទ ដើម្បី បំបែរ អារម្មណ៍ កូន ។
ព្រះជាម្ចាស់ មិន ខ្វល់ ថា មនុស្ស ល្ងីល្ងើ ឬ អត់ នោះ ទេ ទ្រង់ គ្រាន់តែ ទាមទារ ឱ្យ គេ ស្មោះត្រង់
អ្នក គោរព ច្បាប់ ចេះតែ គោរព អ្នក មិន គោរព នៅតែ មិន គោរព ធ្វើ អត់ មាន តម្លាភាព ធ្វើឱ្យ តែ បាន ។
គាត់ មិន និយាយ អំពី រឿង អនាគត ជាមួយ អ្នក
ដាក់ កាបូប ដូចគ្នា នៅក្នុង ទូ ដែល អ្នក ទុក សំលៀកបំពាក់ ឬ ពូក របស់ អ្នក ។
ហេតុការណ៍ បាន កើតឡើង នៅ ចំណុច ក្នុង ទី …
គាត់ ជា កូន ច្បង ក្នុង គ្រួសារ ។
ជីវវិទ្យា - លោកគ្រូ ពៅ ប៊ុណ្ណា - រៀន តាមចិត្ត
ក៏ប៉ុន្តែ ព្រះអង្គ នឹង ទទួល ជួប ដោយ ក្រុម អ្នកតំណាងរាស្ត្រ បារាំង នៅ ព្រឹទ្ធសភា ។
លោក ជឿជាក់ ថា ម្ចាស់ រោងចក្រ អាច មាន លទ្ធភាព ធ្វើ បែប នេះ បាន ៖
វា ជា រឿង សំខាន់ ក្នុង ការបរិភោគ របប អាហារ មាន តុល្យភាព នៅពេល អ្នក មាន ផ្ទៃពោះ ។
ពីសំណាក់ សមត្ថកិច្ច ។
មកដល់ ពេលនេះ ហើយ មិន ទាន់ ឃើញ មាន នរណា ម្នាក់ រងគ្រោះថ្នាក់ ដោយសារ ស្ទីក ឃើនេះ ទេ ។
គ្នា ទើប ចរិត មនុស្ស ក៏ ខុសគ្នា តាម នោះ ដែរ ។
ឯកឧត្តម រស់ សុវាចា អ្…
មាន ការយល់ដឹង ច្រើន អំពី ការបោះឆ្នោត ជាង មនុស្ស ចាស់ ៗ
ប៉ុន្តែ អ្នកដទៃ ទៀត ខ្ញុំ អត់ ដឹង ទេ ។
ចេញ ចាក អំពី បុរីរដ្ឋា ឆ្ពោះទៅ សី មា
ក្រៅពី រឿង សោភ័ណភាព ហើយ នោះ ពណ៌ ថ្នាំ ក្រចក ដែល អ្នក ជ្រើសរើស លាប ក៏ បង្ហាញ ពី អត្តចរិត បាន ផងដែរ ។
កាលពី មុន មនុស្ស ម្នាក់ អាច មើល ការខុសត្រូវ ចំការបាន ត្រឹមតែ ២ហិចតា ប៉ុណ្ណោះ ។
អាន រឿង ទាំងមូល នៅក្នុង អត្ថបទ នេះ នៅលើ …
ហើយ ខ្ញុំ សង្ឃឹម ថា គោលដៅ របស់ លោក និង ខ្ញុំ គឺ ដូចគ្នា ចង់ ចែករំលែក អ្វី ដែល ខ្លួន ចេះ ខ្លួន ដឹង ។
គេហទំព៍រ របស់ យើង
យ៉ាង នេះ ក្តី បើ ទោះជា ត្រូវបាន អនុញ្ញាត គេ
អ្នកដំណើរ ទាំង ១៧២ នាក់ បាន ចាកចេញ ពី យន្តហោះ មុននឹង មាន ហេតុការណ៍ នេះ ។
ពីមុន ខ្ញុំ គិត សុវត្ថិភាព លោក លោក សម រង្ស៊ី តែ ឥឡូវ ដោយសារ លោក ថា មក ភ្លាម ខ្ញុំ ក៏ អុក ភ្លាម ដែរ ។
របប ផ្តាច់ការ មួយ ដ៏ សាហាវ ត្រូវបាន បញ្ចប់ ដោយ គ្មាន ការបង្ហូរ ឈាម ឡើយ ។
អម្បូរ បក្សី នេះ មាន ប្រភេទ ខ្នែង រាប់ សិប ឯណោះ តែ ពួកវា ទាំងអស់ សុទ្ធសឹង មាន រូបរាង ដ៏ ស្អាត ។
សម្បត្ត រិបស់ ពួកគេ ។
សាក្សី អះអាង ថា យន្តហោះ អ៊ុយក្រែន ដែល ធ្លាក់ នៅ តេហេរ៉ង់ មាន ភ្លើង ឆេះ មុននឹង ធ្លាក់
យើង ក៏ អាច សួរ អ្នក ដើម្បី បំពេញ ការស្ទង់ មតិ ដែល យើង ប្រើប្រាស់ សម្រាប់ គោលបំណង ស្រាវជ្រាវ , បើ ទោះបីជា អ្នក មិន មាន ការឆ្លើយតប ទៅ ពួកគេ .
ហើយ ខ្ញុំ គិត ថា នៅក្នុង កំឡុង ពេល នៃ ការកសាង សន្តិភាព ជាពិសេស នៅក្នុង ដំណាក់កាល ដំបូង ដូចជា ពេល ឥឡូវនេះ ដែរ ដែល បញ្ហា ទាំងនេះ ត្រូវបាន ដោះស្រាយ ។
គ្នា ដែរ អាស្រ័យ លើ អ្នក បញ្ជាទិញ ។
ជារៀងរាល់ ថ្ងៃ ជាមួយ ទឹក មិន ប្រើ សាប៊ូ ។
ម្ចាស់ អាជីវកម្ម ភាគ ច្រើន ចង់ ប្រើប្រាស់ ឱកាស នេះ ដើម្បី រំលឹក ក្មេង ៗ
ជូន ជ័យ សុខា ដល់ លោក អ្នក
នេះ គឺជា ទីតាំង អង្គុយ ដែល សមស្រប សម្រាប់ ទារក ៕
ស្តាប់ និង អនុវត្ត តាម សេចក្តីណែនាំ របស់ អាជ្ញាធរ មូលដ្ឋាន និង រដ្ឋ ដែល លោក អ្នក រស់ នៅ ។
កសិករ អាមេរិក ថា ដូណាល់ ត្រាំ កំពុង បំផ្លាញ ទីផ្សារ របស់ ខ្លួន
បញ្ហា ព្រំដែន គឺជា ប្រធានបទ ធំ របស់ …
បន្ទាប់មក គេ នាំគ្នា ទៅ មើល ក្នុង ផ្ទះ ស្ត្រី រូប នោះ ទើប គេ ដឹង ថា គាត់ បាន បាត់ខ្លួន ទៅ ហើយ ។
កៅអី រុញ និង ឈើច្រត់ នេះ គឺ ត្រូវបាន ប្រគល់ ឱ្យ ខ្ញុំ ដោយ មិន គិត ថ្លៃ ។
ដើម្បី ប្រាកដ ថា កូន របស់ អ្នកប្រើ អ៊ីនធើណេត ដោយ មាន សុវត្ថិភាព ។
វា ប្រហែលជា នឹង អាច នាំគ្រោះ ភ័យ ជាជាង សំណាង ។
ការរារាំង នេះ ដោយ ហេតុ ថា ដើម្បី ការពារ នូវ លួច ចូល លុកលុយ ណាមួយ លើ សន្តិសុខ ជាតិ អាមេរិក ។
តើ មាន ការ អ្វី ហ្នឹង បានជា ឡើង ទៅ លើ ដំបូល ផ្ទះ គ្រប់ គ្នា ដូច្នេះ
តើ មាន កត្តា ប្រជាសាស្ត្រ ចម្បង អ្វី ខ្លះ ដែល ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ដែល ជា ម្ចាស់ ឆ្នោត ទៅ បោះឆ្នោត ឱ្យ គណបក្ស ណាមួយ ដែល ខ្លួន ជឿជាក់ នោះ ?
មន្ត្រី អគ្គិសនី កម្ពុជា ចុះ ពិនិត្យ ហើយ ថា អ្វី ៗ
សង្សារ មួយ គូ ស្រឡាញ់ គ្នា ច្រើន ឆ្នាំ តែ គ្មាន ភាពផ្អែមល្ហែម ។
លោក បាន មានប្រសាសន៍ ថា គណបក្ស ប្រឆាំង ចង់ ឃើញ ការប៉ះទង្គិច គ្នា ។
អរគុណ ចំពោះ ការផ្តល់ នូវ ទំនុកចិត្ត របស់ លោក ដល់ រូប ខ្ញុំ ក្នុង ភាពជា អ្នក អភិបាល ។
នេះ រដ្ឋបាល ខេត្ត បាន ចេញ រុះរើ សំណង់ ជាបន្ទាន់ ។
ផ្ទុយទៅវិញ លោក ឆែ សុធា និង បក្ខពួក បាន ឃុបឃិត ឱ្យ ឈ្មួញ ធំ ៗ
ប៉ុន្តែ សំណើ នេះ ត្រូវបាន លោក ហ៊ុន សែន ច្រានចោល ភ្លាម ៗ
មុនពេល ចូល បម្រើ កងទ័ព ឪពុក របស់ ខ្ញុំ ធ្វើជា គ្រូបង្រៀន នៅ ខេត្ត កំពង់ចាម ។
ជា ការពិត ហើយ ដែល គេ ត្រូវ គិត ទៅដល់ ខ្ទង់ ចំណាយ ដែល បណ្តា ស្ថាប័ន ទាំងនោះ ត្រូវ ប្រើ ដើម្បី បំពាក់ ឧបករណ៍ ទាំងនេះ ។
គ.ជ. ប ប្រកាស លទ្ធផល សំខាន់ បី ចំណុច ក្រោយ កិច្ចប្រជុំ
វា ហួស ពេល ២ត្រៀម ចិត្ត សំរាប់ ទទួលយក ការពិត ពេល ដែល ការបាក់បែក មកដល់ នាង ដើរ ចេញ ទៅ ហើយ អ្នក មិន ឈឺចាប់ ដូច អ្នក មិន បាន ត្រៀម ជាមុន ។
ផឹក ទឹកក្រូច រាល់ ថ្ងៃ អាច មាន គ្រោះថ្នាក់
ខ្ញុំ អាច មក លេង ទ្វីប អាហ្វ្រិក បាន ញឹក ជាង ។
នារី ឆ្នាំ ជូត ម្សាញ់ និង កុរ ធាត់ មិន សំខាន់ សំខាន់ មាន លុយ ចូល ច្រើន
នេះ អ្នកស្រី ទទួលបាន ពានរង្វាន់ សេវាកម្ម ស្ម័គ្រចិត្ត ពី ចៅហ្វាយ ក្រុង វ៉ាស៊ីនតោន ។
ហើយ ជាថ្មី ម្តង ទៀត លោក បាន រិះគន់ យ៉ាង ខ្លាំង ដល់ ទីភ្នាក់ងារ ស៊ើបការណ៍ សម្ងាត់ របស់ សហរដ្ឋ អាមេរិក ។
ខ្លួន យ៉ាង តឹង សរសៃក ដាក់ គ្នា ទៅ វិញ ទៅ មក រហូត កើតមាន ជម្លោះ ឈានដល់ ប្រើ ហិង្សា ដាក់ គ្នា ។
អតីត អ្នកគាំទ្រ បក្ស ប្រឆាំង ចង់ឱ្យ បក្ស បណ្តេញ លោក យ៉ែ ម បុញ្ញ ឬទ្ធិ
ឋិតនៅ ទីណា ក៏ គេច មិន ផុត ពី ផលកម្ម
បើ មួយ អាណត្តិ ទៀត ចូល ដល់ ១២ឆ្នាំ ហើយ ។
ចៅក្រម កំពុង សួរ លោក វន់ ពៅ អំពី ព្រឹត្តិការណ៍ ដែល បាន កើតឡើង នៅ ថ្ងៃទី ២ខែមករា ។
អូន ពេញចិត្ត អង្គុយ នៅក្រោម ម្លប់ របស់ បង
ព្រឹត្តិការណ៍ វាយ មុង សាយ ជា ព្រឹត្តិការណ៍ មួយ ដែល បាន ដាក់ ដំណើរការ នៅ ពេល ថ្មី ៗ
ការប្តេជ្ញា នេះ ធ្វើឡើង នៅក្នុង ជំនួប រវាង លោក នាយ …
ដូច្នេះ ពួកគេ ត្រូវតែ បង្ហាញ សារ ដែល ល្អ ជាង នេះ ។
សហគ្រាស ខ្លះ មាន អំណាច ធំ ជាង ក្រសួង នានា របស់ រដ្ឋាភិបាល ទៅ ទៀត ។
យើង នឹង ស្នើ ឱ្យ មាន វិសោធនកម្ម លើ មាត្រា នីមួយ ៗ
ហេតុ នេះ ហើយ ទើប បានជា បណ្តា អ្នកគាំទ្រ ទាំងអស់ ក៏ កម្រ នឹង ដែល បាន ឃើញ ផ្ទៃ មុខ តារា ក្នុង ដួងចិត្ត របស់ ពួកគេ ដោយ គ្មាន លាប អ្វី លម្អរ នោះ ដែរ ។
មិន នឹកស្មាន ថា លីវ៉ាហេទ និង សោម៉ាវត្តី ហ៊ាន ធ្វើ រឿង បែប នេះ សោះ
ត្រូវ ឱ្យ ច្បាស់ កន្លែង ហ្នឹង ។
ខ្ញុំ ក រុណា ពិតជា មានអារម្ម ណ៏ រំភើប រីករាយ ណាស់ ដោយ បាន ដឹង ថា ទីនេះ នៅតែ បន្ត វត្តមាន នៅលើ បណ្តាញ អ៊ិនធើណែត ដូច គ្រា ដើម ។
តូច នារី របស់ យើង ក្រៅពី គាំង ចលនា សម្លឹង អ្នកកាសែត ស្រី ផ្នែក សេដ្ឋកិច្ច ម្នាក់ នោះ អស់ចិត្ត ក៏ ភ្លាត់ មាត់ បន្លឺ ខ្សាវ ៗ
ប្រសិនបើ អ្នក មិន ចាប់អារម្មណ៍ គេ ស្មាន ថា កីឡាករ រូប នេះ មិន មែន ជា អ្នក ប្រដាល់ ហើយ គឺជា អ្នក អនឡាញ យ៉ាង ផុសផុល ម្នាក់ ផង ។
នេះ ជា សម្រស់ រ៉ន ចាន់ ឌីន កាលពី ២ឆ្នាំ មុន និង បច្ចុប្បន្ន ។
មកកាប់ លក់ ហើយ អ្នកទិញ បាន ដឹង ពី ប្រវត្តិ ដែល គាត់ លក់ សាច់ ស្រស់ រយៈពេល ប្រមាណ ៤០ ឆ្នាំ មកហើយ ។
យ៉ាង ទទូច ជាថ្មី ម្តង ទៀត ដូច ខាងក្រោម ៖
ខាង ឪពុក ខ្ញុំ គាត់ រីករាយ ណាស់ ខ្ញុំ ក៏ រីករាយ ណាស់ ដែរ ព្រោះ ធ្លាប់
