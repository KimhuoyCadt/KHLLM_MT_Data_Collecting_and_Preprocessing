នរណា នៅលើ អ្នក នោះ ត្រូវ ទទួលខុសត្រូវ ។
២១ ខ្ញុំ មិន លុបបំបាត់ ព្រះគុណ របស់ ព្រះជាម្ចាស់ ឡើយ ប្រសិនបើ មនុស្ស យើង បាន សុចរិត ដោយសារ ក្រឹត្យ វិន័យ នោះ បាន សេចក្តី ថា ព្រះគ្រិស្ត សោយទិវង្គត ឥត បាន ការ អ្វី ទេ !
ពួកគេ ចង់បាន ឱ្យ ប្រជាជន ហុងកុង ត្រូវបាន គេ អនុញ្ញាតឱ្យ ជ្រើសរើស មេដឹកនាំ របស់ ពួកគេ តាមរយៈ ការបោះឆ្នោត នៅ ឆ្នាំ ២០១៧ ដោយ គ្មាន ការជ្រៀត ជ្រែក ពី រដ្ឋាភិបាល ក្រុង ប៉េកាំង ។
យើង គឺជា ប្រទេស សំខាន់ ក្នុង ពិភពលោក ហើយ វា ល្អ ដែល ដឹង ថា អ្នក កំពុង ប្រយុទ្ធ ។
បន្ទាប់មក ឱន ទៅ មុខ យឺត ៗ
ស្ត្រី បាន ឃើញ កូនស្រី ពិតប្រាកដ របស់ ពួកគេ តែ ពីរ បី ទសវត្សរ៍ ក្រោយមក ។
គូស្នេហ៍ កម្ពស់ ទាប ជាង គេ លើ លោក ចង់ មាន ឈ្មោះ ក្នុង សៀវភៅ កំណត់ ត្រា ពិភពលោក
កញ្ញា អ៊ុំ វណ្ណា ៖
ជា ការពិត ណាស់ អ្នកជំនាញ បាន ព្រមាន ថា អ្នក មិន គួរ បណ្តោល អោយ ក្មេង អង្គុយ បែប នេះ ឡើយ ។
ទឹកដី របស់ កម្ពុជា មិន តិច ដែរ ។
ចូរ បង្ហាញ ពួកគេ ដោយ ក្តីស្រឡាញ់ និង ការគោរព ហើយក៏ ណែនាំ ពួកគេ ឱ្យ ធ្វើ ដូចគ្នា ចំពោះ អ្នក ផងដែរ ។
ចាង យី ដកដង្ហើម វែង ហើយនិយាយ ថាៈ
ប្តឹង យួន - សំឡេង កម្ពុជា ក្រោម
ជន ស្លូតត្រង់ ទាំងអស់ នេះ កំពុងតែ ជាប់ ឃុំ ខ្លួន ។
នៅក្នុង ផ្ទាំង ផ្សព្វផ្សាយ នោះ អ្វី ដែល យើង មើលឃើញ ត្រឹមតែ រូបរាង បន្តិចបន្តួច ប៉ុណ្ណោះ ។
នៅ ពីរ ម៉ោង ក្រោយមក ទៀត អ្នកមុជទឹក បាន ចូល នៅក្នុង បន្ទប់ អ្នកបើកបរ មួយ តែ មិន បាន រកឃើញ មនុស្ស ទេ ។
យក អស់សម្បត្តិ បដិមារ ព្រះពួក នេះ ព្រលះ
មន្ត្រី ម្នាក់ បាន ថ្លែង ថា មនុស្ស ៦នាក់ ដែល គេ ជឿ ថា នៅក្នុង ផ្ទះ ដែល កប់ ក្នុង ដី នោះ បាន បាត់ខ្លួន ។
ការដ្ឋាន ស្ពាន អាកាស និង ផ្លូវ ក្រោម ដី រង្វង់ មូល ចោម ចៅ តាម ផែនការនឹង បញ្ចប់ នៅ ឆ្នាំ ២០២១ ។
ពាក្យស្លោក មិន មែន ជា ពាក្យ អី ជា ផ្លូវការ ធ្វើឱ្យ ពិបាក នឹង ដោះស្រាយ ទេ ប្រសិនបើ តុលាការ ឬ ក៏ ស្ថាប័ន មាន សមត្ថកិច្ច ពាក់ព័ន្ធ ថា ពាក្យស្លោក ឃោសនា ហ្នឹង វា ប៉ះពាល់ វា អត់ ត្រឹមត្រូវ អី ហ្នឹង គឺ គណបក្ស សង្គ្រោះ ជាតិ នឹង សម្រេច ទៅ តាម ហ្នឹង មិន រឹង ទទឹង ទេ ។
លោក បង្ហាញ ឆន្ទៈ នេះ ក្នុង ជំនួយ ជាមួយ …
នោះ ជា កូនសោ សម្រាប់ ការរស់នៅ បាន យូរអង្វែង និង មាន សុខភាពល្អ , យោង តាម ការស្រាវជ្រាវ មួយ ឱ្យដឹង ។
តម្លៃ ពិតប្រាកដ របស់ វា ក្រុមហ៊ុន មិន បាន បញ្ជាក់ ទេ ៕
ក្នុង រាជធានី ភ្នំពេញ ដែល មាន ដូចជា ៖
ភ្នំពេញ ជន់ លិច ពេល ភ្លៀង ម្តង ៗ
ការយល់ឃើញ បែប នេះ បាន ធ្វើឱ្យ គិត ថា នៅ ទីបញ្ចប់ គំនិត អំពី រូប សម្រស់ នេះ គឺ ពិតជា អាស្រ័យ ទៅតាម មនុស្ស ។
អ៊ីចឹង ត្រូវការ គណបក្ស សង្គ្រោះ ជាតិ ដែរ ។
មិន រង ការស្តីបន្ទោស ឡើយ ។
សម្រាប់ គណបក្ស មាន សារៈសំខាន់ ណាស់ ។
គេហទំព័រ បន្ត ថា ពេល ដែល ត្រូវ សម្រេច នូវ បញ្ហា សំខាន់ ៗ
ដូច្នេះ យើង ត្រូវតែ បន្ត និយាយ ក្នុង នាម ឱ្យ ជនរងគ្រោះ ហើយ នឹង ក្នុង នាម ជា ប្រទេស ដែល ជា សមាជិក សភា ។
ពាន ក្នុង ស្រុក របស់ អ៊ីតាលី នេះ ធ្វើឡើង ដំបូង ក្នុង ឆ្នាំ ១៩២២ ដែល មក ទល់ សព្វ ថ្ងៃ នេះ មាន អាយុ ជាង ៩៧ ឆ្នាំ មកហើយ ។
ទំងន់ - តារាង កម្ពស់ សម្រាប់ ក្មេងស្រី
៣៦ បើ មនុស្ស ម្នាក់ បាន លោកីយ៍ ទាំងមូល មក ធ្វើជា សម្បត្តិ របស់ ខ្លួន តែ បាត់បង់ជីវិត នោះ នឹង មាន ប្រយោជន៍ អ្វី ?
ហើយ បើ គេ នាំគ្នា ថែរក្សា បាន ល្អ នៅ ថ្ងៃ ខាងមុខ នឹង មាន ម្លប់ ឈើ សម្រាប់ ភ្ញៀវ អង្គុយ លេង កម្សាន្ត ក៏ ដូចជា ទាក់ទាញ អាកាសធាតុ ឱ្យ មាន លំនឹង ផងដែរ ៕
ស្រែក ចាប់ ឃាតករ យកមក កាត់ទោស ?
របស់ ប្រជាពលរដ្ឋ កម្ពុជា យើង ឬ ទេ ?
តែងតែ គិត ថា ហេតុអីក៏ ជីវិត ខ្ញុំ អភ័ព្វ ម្លេះ ?
បន្ថែម ទៀត នៅ រៀងរាល់ ម៉ោង ធ្វើការ ៕
តាវិច ទ័រ បង្ហាញ ពី ភាពសោកស្តាយ ដែល ធ្វើ ដាក់ កូនស្រី បែប នេះ …
ក្រោយមក ទើប យក កោសិកា កូន ទៅ ដាក់ ក្នុង ស្បូន ស្ត្រី ជា ម្តាយ វិញ ។
ព្រះយេស៊ូវ គ្មាន បាប ទេ តែ ព្រះអង្គ បាន ទទួល ទោស នៃ អំពើ បាប របស់ យើង នៅលើ ឈើ ឆ្កាង ហើយ បី ថ្ងៃ ក្រោយមក ព្រះអង្គ ក៏ បាន ឈ្នះ សេចក្តីស្លាប់ ដោយ មាន ព្រះជន្ម ឡើងវិញ ហើយ វាយ បំបាក់ អំណាច នៃ សេចក្តីស្លាប់ ។
លោក ផៃ ស៊ីផាន ថា លោក ជួយ ជ្រោមជ្រែង លោក សាន រី ច្ឆឺ ដោយសារតែ អ្នក ទាំង ពីរ ជា មិត្តភ័ក្តិ នឹង គ្នា ។
គាត់ មិន ប្រើ អំណាច មក គាបសង្កត់ ប្រជាជន ទេ ។
ប៉ុន្តែ ព្រះយេហូវ៉ា មិន ចង់ឱ្យ អ្នកណា ម្នាក់ ស្លាប់ ទេ ។
ដូច្នេះ គ្រប់ ពេលវេលា គេ អាច គំរាមកំហែង ដល់ ម្ចាស់ ខ្សែក្រវាត់ គ្រប់ ពេល ។
អង្គ តុលាការ របស់ អស់ លោក លោកស្រី មិន ព្រងើយ កន្តើយ ចំពោះ ពាក្យ បណ្តឹង នេះ នៅពេល ធ្វើ សេចក្តីសម្រេច ឡើយ ។
នេះ សោះ តែ ស្រាប់ ពេលនេះ មាន សភាព ប្រែប្រួល ខ្លាំង ធ្វើឱ្យ អ្នក រួម អាជីព និង មហាជន រំជួល ចិត្ត ជាខ្លាំង ។
ក៏ប៉ុន្តែ គម្រោង ដាក់ ស្នើ ឱ្យ មាន សញ្ជាតិ តែ មួយ មិន ទាន់ លើកឡើង ក្នុង តុចរចា នៅឡើយ ទេ ។
ចាប់ខ្លួន ចោរ លួច សម្ងំ នៅក្នុង ផ្ទះ ចង់ លួច ទ្រព្យសម្បត្តិ
អ៊ឹម ជីវ៉ា ហួសចិត្ត ខ្លាំង ក្រោយ ដឹង ថា ខ្មឹប ជា មុខសញ្ញា ជួញដូរ គ្រឿងញៀន
និង ទីផ្សារ បើកចំហ ៕
ឃាត់ខ្លួន ជនសង្ស័យ ជា ជនជាតិ ចិន ម្នាក់ ដកហូត ថ្នាំ ញៀន ៨កញ្ចប់
ជីវិត ដ៏ ខ្លី មួយ នេះ នឹង កន្លងផុត បាត់ ទៅ ប៉ុន្តែ នូវ រាល់ អ្វី ៗ
លោក ផោ គឹម ស្រ៊ុន និង ភរិយា
ក៏ប៉ុន្តែ យើង នឹង យក ពួកគេ ចេញ ពី ប្រទេស របស់ យើង ពួកគេ មក នៅ ទីនេះ ខុស ច្បាប់ ។
នោះ ទូលបង្គំ នឹង អំពាវនាវ ដល់ ទ្រង់ ពី ចុង ផែនដី ផង
សូម ទៅ ទីនេះ សាក មើល ក្រែងលោ មាន សង្ឃឹម ខ្លះ
អង្គការ គ្រាន់តែ ប្រមូល តា ៗ
អ្នក ប្រហែលជា ធ្លាប់ បាន ឮ កន្លងមក ហើយ ថា ការរៀន ដោយ ប្រើ ឧបករណ៍ អគ្គិសនី អាច ធ្វើឱ្យ អ្នក មិន ងងុយ គេង ។
សូម បញ្ជាក់ ថា អំណោយ ដែល ត្រូវ ចែកជូន នៅ ថ្ងៃ នេះ សម្រាប់ គ្រួសារ នីមួយ ៗ
អាហារ និង ភេសជ្ជៈ នៅ ទីនោះ មាន តម្លៃ ចាប់ពី ៤ដុល្លារ ឡើង ទៅ ។
វិមាន សភា សហរដ្ឋ អាមេរិក
ការលុប គ្រលុក សំបុក មាន់ នៅ ទូទាំង ២៥ រាជធានី ខេត្ត ។
ប្រវត្ត រូប របស់ អ្នក
ខ្ញុំ អត់ ដឹងខ្លួន ទេ នៅពេល ក្តៅ ពេក ដូច គេ កន្ទ្រាក់ សរសៃ ខ្ញុំ អោយ ភ្ញាក់ ឡើងវិញ ។
យើង ធ្លាប់ តែ បង្ហាញ ថា ស្វ៊ីត ជា ស្វ៊ីត ទាល់ ។
ទំនាក់ទំនង យើងខ្ញុំ ទទួលបាន ការគាំទ្រ
នេះ ដើម្បី ស៊ីឈ្នួល បេះ ផ្លែ ឈើ ដែល មាន រយៈពេល ២ខែ រៀងរាល់ ឆ្នាំ ។
នេះ ហើយ ជា មូលហេតុ ដែល យើង អាច ដឹង ពី ឥទ្ធិពល នៃ ព្រឹត្តិការណ៍ ទាំង ពីរ នេះ ទៅ លើ អាកាសធាតុ ថា ជា ព្រឹត្តិការណ៍ ពីរ ផ្សេង ពី គ្នា ។
អាសនៈ សភា ចំនួន ៦៨ ត្រូវបាន គេ រក្សាទុក សម្រាប់ ស្ត្រី ។
អរ ព្រះគុណ ព្រះសង្គ្រោះ ខ ៤៦
អ្នក មិន អាច បញ្ជូន ពួកគេ ទៅ ផ្ទះ បាន ទេ ព្រោះ ពួកគេ អាច ឆ្លង អ្នកដទៃ ប៉ុន្តែ អ្នក ក៏
ទៀត ដូចជា ទីផ្សារ នេះ ជាដើម ។
គ្រាន់ ចុច លើ ពាក្យ នៅ ខាងមុខ ទាញយក ទីនេះ ពេល នោះ អ្នកចូលទៅ គេហទំព័រ ថ្មី មួយ ទៀត ។
ប្រើ សម្រាប់ បេតុង ដែល មាន ភាព ច្រេះស៊ី ខ្លាំង ដូច ជាៈ
លទ្ធផល ស្វែងរក ពាក្យ គន្លឹះ ផ្លែ ទុរេន
នៅក្នុង កម្មវិធី បិទ នៅ ថ្ងៃស្អែក យើង នឹង ធ្វើ ការបូកសរុប ពី ផលិតផល ជា សរុប ដែល ទទួលបាន ពី ការពិភាក្សា ក្នុង វេទិកា នេះ ។
ជា រឿង ចាំបាច់ ដែល យើង ត្រូវ មាន ជំនាញ មួយ ជា ការឆ្លើយតប ចំពោះ ការវាយប្រហារ ទាំង នេះ ៕
តើ ហេតុ អ្វី បានជា មេម៉ាយ ក្រោយ លែងលះ ហើយ តែង បាន ប្តី ក្រោយ សុទ្ធតែ កម្លោះ ?
១១. គាត់ ធ្លាប់ និយាយ ថា ចង់ រៀបការ ជាមួយ អ្នក
គឺ កាល ហ្នឹង ខ្ញុំ បាន កសាង ស្នេហា ជាមួយ បង ប្រុស មិត្ត ថ្មី ម្នាក់ នៅ កន្លែង ធ្វើការ របស់ ខ្ញុំ ។
ការងារ មិន ត្រូវ ចូលរួម ក្នុង កិច្ចការ ពុំ មែន ជា ភារកិច្ច របស់ ខ្លួន ។
រីឯ អ្នក រាល់គ្នា ដែល សុទ្ធតែ ជា ទាហាន ដ៏ អង់អាច វិញ ត្រូវ ប្រដាប់អាវុធ ដើរ ខាងមុខ បងប្អូន របស់ អ្នក រាល់គ្នា ដើម្បី ជួយ គេ ១៥ រហូតដល់ ព្រះអម្ចាស់ ប្រទាន អោយ បងប្អូន របស់ អ្នក រាល់គ្នា បាន សំរាក ដូច អ្នក រាល់គ្នា ដែរ ហើយ អោយ ពួកគេ កាន់កាប់ ស្រុក ដែល ព្រះអម្ចាស់ ជា ព្រះរបស់ អ្នក រាល់គ្នា ប្រទាន អោយ ពួកគេ ។
សង្ឃឹម ថា បងប្អូន នឹង បាន ប្លែក ភ្នែក ប្លែក អារម្មណ៍ នឹង ទស្សនិ៍យ ភាព ខាងលើ នេះ ចា៎ ។
ទាំងឡាយ ពេម្តាយ នៅ រស់ ត្រូវ ប្រឹង ធ្វើឱ្យ គាត់ សប្បាយ សុភមង្គល ។
និង ខុសពី ការចរចា ជាមួយ សម្តេច ក្រុម ព្រះនរោត្តមរណឫទ្ធិ ។
គ្រប់គ្រង សម្ភារៈ ខ្សែភាពយន្ត ចម្លង ពេល ចូលមកដល់ និង ពេល បញ្ជូន ត្រឡប់ ទៅវិញ និង ការទទួល សម្ភារៈ ផ្សេង ៗ
ប៉ុន្តែ រឿង ដែល សំខាន់ នោះ ថា តើ មាន មូលហេតុ អ្វី ដែល បណ្តាលឱ្យ មាន ការសម្រេច បែប នេះ ?
តែ យ៉ាងណា ក៏ដោយ សម្រាប់ ពេលនេះ គឺ ភាគី ទាំង ចិន ទាំង អាមេរិក សុទ្ធតែ អះអាង ប្រកាស សម្តី យក ត្រូវ រៀង ៗ
ទិវា អន្តរជាតិ ,
សម្រាប់ រូបភាព និង វីដេអូ របស់ អ្នក
លុយ បាត ធៀប នឹង លុយ រៀល ខុសគ្នា ដូចម្តេច សម្រាប់ ថ្ងៃ នេះ និង ថ្ងៃ ម្សិលមិញ
អ្នក ត្រូវ កំណត់ ពី ការចំណាយ របស់ អ្នក ឱ្យ តិច ជាង ប្រាក់ ចំណូល ប្រចាំ ខែ របស់ អ្នក ដូចនេះ អ្នក នឹង អាច មាន គណនី សន្សំ ។
ពេលវេលា - ភ្លេច ពេលវេលា ល្អ បំផុត ដើម្បី ផ្ញើ សមហេតុសមផល ។
ប៉ុណ្ណឹង ហើយ ករណី ទី១ នៅតែ មាន ឡើង ។
នាង ប្រាក់ គន្ធា ល្បី ដោយសាអ៊ីណូ ?
តែ ក្នុង នាម ជា អ្នកដឹកនាំ គេ វា គឺជា កាតព្វកិច្ច របស់ អ្នក ក្នុង ការស្វែងរក ដំណោះស្រាយ សមស្រប ។
តើ អ្នក ធ្លាប់ មាន ចម្ងល់ ទេ ថា ហេតុ អ្វី បានជា ខែកុម្ភៈ មាន ត្រឹមតែ ២៨ ថ្ងៃ លើកលែងតែ រយៈពេល ៤ឆ្នាំ ម្តង ដែល មាន ខែ នេះ មាន រហូតដល់ ២៩ ថ្ងៃ ?
អ្នក ឆ្លង ម្នាក់ ទៀត ជា បុរស អាយុ ២៩ ឆ្នាំ ដែល បាន បម្រើការ ជា អ្នកដឹក ភ្ញៀវ ទេសចរ ចិន ។
គេ ត្រូវការកម្លាំង បងប្អូន ឱ្យ ធ្វើការ ឱ្យ បាន ច្រើន ម៉ោង ។
នៅ ពេល ដែល ព្រះច័ន្ទ វិល បន្តិច ម្តង ៗ
ព្រះទេវី បាន ឈរ ប្រថាប់ ទៀប ទ្វារ ទ្រង់ ព្រះកន្សែង ទួញ យំ ថា ប ពិត្រ ព្រះស្វាមី វេលា ដែល គេ នេះ ជា ក្មេង ព្រះអង្គ មិន អោយ ឱកាស សម្លាប់ គេ ទ្រង់ ចិញ្ចឹម សត្រូវ របស់ ព្រះអង្គ ទុក ដោយ ព្រះអង្គ ឯង ពិត ៗ
ជាង ១ សប្តាហ៍ ហើយនិង មាន កន្លែង សម្រាប់ ឱ្យ អង្គុយ លេង ជាច្រើន រោង ថែម ទៀត ជាមួយ នោះ អាច
ម តិ មួយចំនួន បាន និយាយ ថា នាង ពិតជា ស្អាត ណាស់ នៅក្នុង ឈុត សំលៀកបំពាក់ មួយ នេះ ។
ភាព ស្រដៀង គ្នា របស់ អ្នក ទាំង ពីរ ធ្វើឱ្យ ពួកគេ មើល ទៅ ដូចជា កូន ភ្លោះ អញ្ចឹង ។
អូ មនុស្ស មាន បាប អើយ សូម យក ព្រះលោហិត របស់ ព្រះគ្រិស្ត !
តើ កន្លែងណា មាន សេរីភាព ?
អរគុណ សម្រាប់ ការប្រាប់ ពួកយើង ពី មូលហេតុ ដែល អ្នក ឈប់ ប្រើ ។
ដួងចិត្ត លោក ច្របូកច្របល់ ណាស់ !
ថាមពល និង ឆន្ទៈ របស់ អ្នក នឹង ថយចុះ ទៅតាម ពេលវេលា ពេញ មួយ ថ្ងៃ ដូច្នេះ វា ជា គំនិត ល្អ ក្នុង ការប្រញាប់ និង បញ្ចប់ ការងារ សំខាន់ ៗ
នេះ គឺជា ការពិត គឺ ពេល ដែល អ្នក មាន ទំនាក់ទំនង កាន់តែ ស្និទស្នាល អ្នកកាន់តែ មានអារម្មណ៍ នៅ ជាមួយគ្នា រហូត ។
បងប្អូន យើង ឈឺចិត្ត យើង ឈឺចាប់ ណាស់ យើង អត់ នៅ ស្ងៀម បាន ទេ ។
ខ្ញុំ ជឿជាក់ ថា ពលរដ្ឋ ហុងកុង នឹង ដោះស្រាយ រឿងរ៉ាវ ទាំងឡាយ ដែល កើត មាន ឡើង ដោយ ប្រាជ្ញា វៀង វៃ របស់ ខ្លួន ។
