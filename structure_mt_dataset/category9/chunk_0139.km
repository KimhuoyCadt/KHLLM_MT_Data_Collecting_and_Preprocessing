៣ខែ ក្រោយមក មាន បុរស ម្នាក់ បាន មក តវ៉ា បុគ្គលិក អង្ការ ។
ដូចនេះ យើង ជា អ្នក ប្រជាធិបតេយ្យ ជា អ្នកស្នេហាជាតិ មិន អាច បណ្តោយ ឱ្យ រដ្ឋអំណាច សព្វ ថ្ងៃ ធ្វើ បែប នេះ តទៅទៀត បាន ឡើយ ។
ដូច្នេះ កត្តា ទាំងនេះ រួមចំណែក ដល់ ស្ថិរភាព នៃ ប្រាក់ រៀល ។
ព្រះយេស៊ូ គ្រីស្ត កិច្ចការ ២៣៨
តែ រុស្ស៊ី នៅតែ ជា ប្រទេស មហា អំណាច ដដែល ។
ក្នុង នេះ មាន បទសម្ភាស របស់ ខ្ញុំ ជាមួយ អ្នកនិពន្ធ ផង ។
វា មាន ការចាប់ផ្តើម មួយ ចំនុច កណ្តាល មួយ និង ទីបញ្ចប់ មួយ ។
នេះ ហើយ ជា មូលហេតុ ដែល គេ មិន អាច លុបបំបាត់ គ្រឿងញៀន បាន ។
លេខ ទាំងនេះ តំណាង ឱ្យ ថ្ងៃ កំណើត របស់ ពួកគេ ។
អា ហ្នឹង ទី១ ហើយ ទី២ ក្រៅពី អង្គហេតុ គឺ មាន អង្គ ច្បាប់ ។
និង របួស ធ្ងន់ ២នាក់ ទៀត
ពួកយើង មិន ចង់ឱ្យ គេ ប្រើប្រាស់ ប្រទេស យើង ជា ជណ្តើរ ឡើង មួយ ទេ ។
កិច្ច ខិតខំ ប្រឹងប្រែង នៅតែ គ្មាន ប្រសិទ្ធភាព ។
វា ជា ការសំខាន់ ណាស់ ដែល អ្នក ត្រូវ បំភ្លេច ចោល នូវ ការបារម្ភ និង ស្ត្រេស ។
ទាំងអស់ គ្នា … នរណា ខ្លះ ដូច ស្វាមី របស់ អ្នកនាង គង់ ចាន់ ស្រី មុំ
មនុស្ស មួយចំនួន ធំ មិន សប្បាយ ចិត្ត នឹង ការងារ កំពុង ធ្វើ គួរ ធ្វើ ម៉េច ដើម្បី បង្កើត ក្តី ស្រលាញ់ ចំពោះ ការងារ ?
អាច ឱ្យ អ្នកដំណើរ ឆ្លងកាត់បណ្តើរ គន់ ទេសភាព បណ្តើរ ។
វា មិន ត្រឹមត្រូវ ទេ ព្រោះ អី វា ខុស នឹង ច្បាប់ រដ្ឋធម្មនុញ្ញ ។
លុបបំបាត់ កំហុស កំពុង រង់ចាំ ការទាញយក នៅក្នុង ទីផ្សារ Play
តើ គួរ ឬ មិន គួរ ធ្វើ កំណែទម្រង់ លើ អង្គការ ពាណិជ្ជកម្ម ពិភពលោក ?
ស្រលាញ់ ដកចិត្ត មិន រួច ៕
ប៉ុន្តែ សំខាន់ ជាង ទេសចរណ៍ ប្រណីត ទាំងអស់ ។
ជ្រើស យក បបរ មួយ ចាន ដើម្បី ដឹង ថា អ្នកណា កំពុង តាមដាន បារម្ភ ពី អ្នក
នៅ ហុងកុង បាន ធ្វើឱ្យ គាត់ ខូចចិត្ត ។
មែន ហើយ ឥឡូវនេះ គាត់ កំពុង ប្រើ ពាក្យ ដែល ខ្ញុំ មាន ទម្លាប់ ប្រើ ។
វប៌្បធម ភាសា និង សំលៀកបំពាក់ របស់ ចាម ត្រូវបាន ហាមឃាត់ ។
ហើយ ចំពោះ ផែនដី ដែល មាន ព្រះពុទ្ធ ត្រាស់ ដឹង ៥ ព្រះអង្គ នេះ គឺ ថា ជា ការកម្រ រក បាន ណាស់
មន្ត្រី អតីត បក្ស ប្រឆាំង បង្កើត …
ជា ការចុះខ្សោយ ខ្លាំង ពុំ ធ្លាប់ ឃើញ មាន ទេ គិត ចាប់តាំងពី ១៦០០ ឆ្នាំ មក ។
ដូច្នេះ ពេល នេះ ជា ពេល ដែល ត្រូវ ដោះលែង ពួកគេ ។
លោក ប៉ូចេត ទី ណូ បាន និយាយ ថា វា ធ្វើឱ្យ ខ្ញុំ អស់ សំណើច នៅពេល គាត់ និយាយ អំពី ខេន ពីព្រោះ ខ្ញុំ មិន ដឹង ថា ហេតុ អ្វី អ្នក ផ្សេង យកចិត្តទុកដាក់ លើ កីឡាករ របស់ ខ្ញុំ និង ក្លឹប របស់ យើង ខ្លាំង ម្ល៉េះ ។
ថ្ងៃ ដែល ព្រះច័ន្ទ ចូល ជិត ផែនដី បំផុត
ការធ្វើ នូវ កម្ម មិន មែន ជាធម៌ ជាដើម ៣៧៣
អកម្ម បង់ប្រាក់ - បិទ
ខ្ញុំ គិត ថា វា ជា ការចាប់ផ្តើម អ្វី មួយវិជ្ជមាន ។
ព្រមទាំង នាវា ចត នៅ តាម កំពង់ផែ
ព្រះជ្រើសរើស ការអធិស្ឋាន ដើម្បី ធ្វើជា អត្ថន័យ នៃ ព្រះពរ វា មិន មែន ថា ការសម្រេច គោលបំណង របស់ ទ្រង់ ពឹងផ្អែក លើ យើង នោះ ទេ ប៉ុន្តែ ទ្រង់ ចង់ ជួយ យើង ឱ្យ រៀន ពី ការពឹងផ្អែក ទាំងស្រុង របស់ យើង ទៅ លើ ទ្រង់ ។
ជា ទីបញ្ចប់ ខ្ញុំ សូម ជូនពរ ដល់ ឯកឧត្តម លោកជំទាវ លោក លោកស្រី និង ក្មួយ ៗ
បើ ពិនិត្យមើល ទៅ ថង់ នេះ គ្រាន់តែ ជា ថង់ សំរែ ៗ
ទៀត ផងដែរ ដើម្បីឱ្យ បាន គ្រប់ ៧វត្ត ។
ប្រាក់ ដែល អ្នក ខ្ចី ពី ម្ចាស់ បំណុល ។
ទោះ ភ្លៀង ខ្លាំង យ៉ាងណា ក៏ ឆន សុវណ្ណ រាជ នៅតែ ធ្វើ បែប នេះ សម្រាប់ អ្នកគាំទ្រ
គ្នា ធ្វើឱ្យ ភ្លើង រលត់ ទៅ វិញ ទាំងស្រុង ដោយ មិន មាន រថយន្ត ពន្លត់ អគ្គិភ័យ ទេ ។
សូម លោក លោកស្រី ទំនាក់ទំនង យើងខ្ញុំ នៅ ម៉ោង ធ្វើការ ៖
ពី ខាងក្រៅ ទៅ ប៉ុណ្ណោះ ។
ពលរដ្ឋក៍ បាន ឱ្យដឹង ទៀត ថា នៅពេល សន្យា បាត់ ៗ
វា ជា រឿង របស់ ប្រជាជន កម្ពុជា ។
ក្បួន ទ័ព ទៅដល់ ទីណា ស្បៀង ធ្លាក់ ពីលើ មេឃ នៅ ទីនោះ ។
ការចុះ នេះ ដឹកនាំ លោក ម៉ុក ច័ន្ទ ករុណា
នោះ ឡើយ បន្ទាប់ពី ពន្លា រួច ។
១៣ខ្ញុំ ជួបប្រទះ នឹង គ្រោះថ្នាក់ ដល់ ជីវិត ជាញឹកញយ ប៉ុន្តែ ខ្ញុំ ដោះ ខ្លួន រួច ដោយសារ ការ ពិសោធ របស់ ខ្ញុំ ។
អន្សម ក៏ ឆៅ ទទួលទាន មិន កើត ដូចគ្នា ។
យើង នឹង យក ព្រំដែន របស់ យើង មកវិញ ។
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក ពោធិបក្ខិយ ធម៌ ៖
យើង នឹង បើក ការប្រជុំ នៅ ព្រឹក ស្អែង ហើយ នឹង សម្រេច ថា នឹង ធ្វើ យ៉ាងណា បន្ត ទៀត ។
អ្នក កំពុង រស់ នៅ សម្រាប់ អ្វី ដែល អ្នកដទៃ និយាយ ។
ហើយ បែរជា មិន ចូល លោភលន់ ចង់ ធ្វើ នាយក រដ្ឋមន្ត្រី ទៀត ទៅ មិន រួច
បើសិនជា ខ្ញុំ យឺត រយៈពេល ២ឬ ៣ ថ្ងៃ ខ្ញុំ នៅ មាន ឱកាស នៅឡើយ តែ ពេលវេលា កំណត់ បាន មកដល់ ហើយ ។
ទេវតា នោះ ក៏ និយាយ ទៅ ពួក ស្ត្រី ទាំងនោះ ថា ៖
បាន ឱ្យ ភត្តា ហារ ប្រចាំ ដល់ ខ្ញុំ ព្រះអង្គ ៤ចំណែក ខ្ញុំ ព្រះអង្គ សូម ថ្វាយ ដល់ ព្រះអង្គ ២ចំណែក ក្នុង ៤ចំណែក នោះ ឯ ខ្ញុំ ព្រះអង្គ នឹង បរិភោគ ខ្លួន ឯង ២ ចំណែក ។
សន្យា ហួស ផុត វា ជា ការឈឺចាប់ ។
ចំណាំ អ្នក មាន សិទ្ធិ ឆ្លើយ បាន តែ ម្តង គត់ ។
លោក ថា លោក បាន បញ្ជូន របាយការណ៍ នេះ ទៅ ថ្នាក់ លើ រួចហើយ ។
ព្រះនឹង បំផ្លាញ មនុស្ស អាក្រក់ ។
ការប្រឈមមុខ នេះ នឹង ថយចុះ វិញ នៅពេល ពួកគេ ឈប់ ប្រើ ថ្នាំ ទាំងអស់ នេះ ។
ដឹង ថា អាណិត នៅតែ ស្រលាញ់ - វៀតណាម លទ្ធផល
រឿង ១០យ៉ាង ដែល មនុស្ស ប្រុស មិន ហ៊ាន និយាយប្រាប់ ស្រី ៗ
ឃ្លាំង គំនិត សម្រាប់ កូន ខ្មែរ ចូរ ជឿ លើ ខ្លួន ឯង ជាមុន សិន មុននឹង ឱ្យ អ្នកដទៃ ជឿ អ្នក
អង្គការ គេ ហ្នឹង វា យ៉ាងម៉េច អី យ៉ាងម៉េច ក៏ ខ្ញុំ អត់ ដឹង ដែរ ។
ហើយ យើងខ្ញុំ នឹង សរសើរ តម្កើង
រឿង នេះ ដំណាល ថា នៅក្នុង ប្រទេស ចិន កាលពី យូរ លង់ ណាស់ មកហើយ មាន ព្រះអាទិត្យ ១០ នៅលើ មេឃ ។
ខ. លទ្ធិ នេះ មាន គោលការណ៍ សំខាន់ ៨យ៉ាង គឺ
បណ្តាំ ផ្ញើ របស់ កញ្ញា អ៊ឹង និមល
ប៉ុន្តែ ត្រូវបាន អាជ្ញារធរ ខណ្ឌ ឫស្សីកែវ ឱ្យ តំណាង សហគមន៍ ទៅតែ ៧នាក់ ប៉ុណ្ណោះ ។
ទីផ្សារ ធំ របស់ ផលិតផល កៅស៊ូ នៃ ក្រុមហ៊ុន ធំ ទាំង ពីរ នេះ គឺ ប្រទេស ចិន ។
ឥឡូវ យើង មក ស្គាល់ ទាំងអស់ គ្នា ថា រមណីយដ្ឋាន ថ្មី ៗ
ប្រសិនបើ យើង ជួយ មិន បាន ទេ យើង និយាយប្រាប់ ពី ហេតុផល ការពិត ។
គាត់ ជួយ សត្វ អស់ ពី សមត្ថភាព ខ្លួន គាត់ ។
បន្ទាប់ពី បាន អាន អត្ថបទ ជាច្រើន ដែល ណែនាំ ពី អាជីព យើង បាន ផ្លាស់ប្តូរ ការគិត របស់ យើង ។
ហេតុផល ៥យ៉ាង ដែល អ្នក មិន គួរ ពិសា បន្លែ គ្រប់ មុខ
តោះ ប្រិយមិត្ត ទៅ មើល ការបញ្ចេញ អាថ៌កំបាំង នៃ ការលេង សៀក ទាំងអស់ គ្នា
គ្រឿង ឧបភោគ បរិភោគ បាន ដែល ប្រគល់ មួយ គ្រួសារ នា ពេលនេះ មាន ៖
គ្នា ដល់ គណបក្ស នយោបាយ ទាំង ២០ ដើម្បី បង្ហាញ ពី គោល នយោបាយ របស់ ខ្លួន ។
ពួកគេ ក៏ ទាមទារ ឱ្យ លុបចោល រដ្ឋធម្មនុញ្ញ តាក់តែង ដោយ យោធា ដែល រួមបញ្ចូល ការកាត់បន្ថយ អំណាច ស្តេច ផងដែរ ។
ទៅ លើ ផលិតផល យ៉ាង ច្រើន ។
នោះ ជា កិច្ចការ របស់ ក្រពេញ ញើស ។
គឺជា ការរួមចំណែក ដល់ និង នាំមក នូវ កំណើន ភ្ញៀវ ទេសចរណ៍ កាន់តែ ច្រើន ។
ប្រសិនបើ កាលពី មុន អ្នក ធ្លាប់ មាន បញ្ហា ក ស្បូន មិន ប្រក្រតី អ្នក ត្រូវតែ ពិនិត្យ វា រៀងរាល់ ឆ្នាំ ។
១៧ អ្នក នោះ នឹង នាំមុខ ប្រជាជន ចេញ ទៅ ច្បាំង ហើយ នាំ ពួកគេ ត្រឡប់ មកវិញ ដើម្បី កុំ អោយ សហគមន៍ របស់ ព្រះអម្ចាស់ ប្រៀប បាន នឹង ហ្វូង ចៀម ដែល គ្មាន គង្វាល នោះ ឡើយ ។
ទៀត ទេ ដោយ សុទ្ធ ចិត្ត ធ្វើ អ្វី គ្រប់ យ៉ាង ដើម្បី តែ កូន មិន ខ្លាច សោះភាព ហត់នឿយ ទុក្ខ កង្វល់ ។
ទាំងនេះ ដើម្បី រួមចំណែក បំពេញ បន្ថែម សេចក្តីត្រូវការ ។
សំនួរ ទី៣. ខ្ញុំ មាន បំណង ចង់ ក្លាយជា អ្នកនិពន្ឋ ដែរ តែ ត្រូវ ធ្វើ ដូចម្តេច ទើប អាច សំរេច បំណង នេះ ?
ទី៤. មិន ស្គាល់ អត្តសញ្ញាណ រងរបួល ស្រាល ។
យ៉ាងណាមិញ រឿង នេះ គឺជា ការសិក្សា លើ សត្វ កណ្តុរ ប៉ុណ្ណោះ ដូច្នេះ យើង មិន ទាន់ សន្និដ្ឋាន បាន ថា វា មាន លក្ខណៈ ដូចគ្នា លើ មនុស្ស ឡើយ ៕
យើង សង្កេតឃើញ នាយ ចយ រួមទាំង ភរិយា មាន ទឹកមុខ រីករាយ ក្នុង ថ្ងៃ ពិសេស របស់ ខ្លួន ។
ពិភពលោក ប្រែប្រួល ខ្លាំង ណាស់ ២០ ឆ្នាំ ទៀត ។
បើសិន ផ្តល់ ការប្រាក់ ទាប វា ងាយស្រួល ពង្រីក អាជីវកម្ម ។
មិន មែន សេចក្តីទុក្ខ ផ្ទាល់ ព្រះអង្គ ទេ ដែល នាំឱ្យ ព្រះអង្គ ព្រួយ ។
រុក្ខជាតិ ទាំងមូល ប្រើ ស្រស់ ឬ ស្ងួត ។
បាន មក តាំង ទីលំនៅ តាម ដងទន្លេ ដូចគ្នា ហើយ ប្រើប្រាស់ មធ្យោបាយ ធ្វើដំណើរ តាម ដងទន្លេ ដោយ ប្រើ ទូក ។
ចូរ ចាំ ថា វិធីសាស្ត្រ មួយ នេះ មាន ពីរ ទម្រង់ ៖
សូម ប្រាកដ ថា អ្នក បាន ជ្រើស ប្រភេទ ខាងស្តាំ នៃ គណនី ។
ខំ ព្រូស ទាល់តែ ដាច់ខ្យល់ក៍ គ្មាន នរណា ជឿ !
ជំរាប សួរ មិត្ត សំឡាញ់
នៅ ជាមួយ បណ្ឌិត ដូចជា នៅ ជាមួយ ញាតិ ។
ខ្ញុំ មានអារម្ម ណ៏ ធុញ ថប់ នឹង អស់សង្ឃឹម បំផុត … ។
ក្នុង រយៈពេល ១ សប្តាហ៍ កន្លងមក មាន រដ្ឋមន្ត្រី ២រូប លា លែង ចេញ ពី តំណែង ។
លោក បាន បន្ថែម ថា ប្រសិនបើ យើង មាន ភ័ស្តុតាង គ្រប់គ្រាន់ ថា ពួកគេ ពាក់ព័ន្ធ នឹង អង្គការ ខុស ច្បាប់ នោះ យើង នឹង បញ្ជូន ពួកគេ ទៅ តុលាការ ៕
នៅក្នុង សារ ហ្វេសប៊ុក របស់ នាង បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថ … អាន បន្ត
តែ នៅ ពេល បច្ចុប្បន្ន បាន បាត់ នូវ ទំនៀមទម្លាប់ នេះ ខ្លះ ៗ
ឱ្យ សាកសព មុនពេល នាំ ដើរ ត្រលប់ ទៅ ផ្ទះ វិញ ព្រោះ មាន ជំនឿ ថា នឹង ធ្វើឱ្យ ការប្រមូល ផល ទទួលបាន ទិន្នផល ល្អ ។
ពួកគេ បាន ឈ្នះ ពានរង្វាន់ នោះ ។
ប៉ុន្តែ ប្រសិនជា អ្នក មាន បញ្ហា ងើប ពី ព្រលឹម អ្នក ក៏ ពុំ ចាំបាច់ បារម្ភ នោះ ទេ ។
យើង ភ្ញាក់ផ្អើល មែនទែន ដោយសារ យើង មាន លក្ខណៈ ដូចគ្នា ច្រើន ។
ដល់ ពេល ថវិកា ធ្លាក់ មក បាន យើង ធ្វើ ធំដុំ តែម្តង ។
មាន វិធី ៣យ៉ាង ដើម្បី ទទួលបាន វីតាមីន D ៖
ទៀត ក្នុង សង្គម ដែល មាន ឧត្តម គតិ ស្រប គ្នា ក្នុង ការអភិវឌ្ឍ ប្រទេស បម្រើ ផលប្រយោជន៍ ប្រជាជន ។
មនុស្ស ជាច្រើន ជាពិសេស អា…
ដូច្នេះ វិធី ដ៏ ល្អ បំផុត គឺ យើង ត្រូវ ដើរ ដោយ ចេះ ការពារ ខ្លួន ៖
ចង់ ដឹង ទេ ថា ក្មេងប្រុស ម្នាក់ នោះ រាំ យ៉ាងដូចម្តេច សូម ទស្សនា វីដេអូ ទាំងអស់ គ្នា ៖
ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ វៀតណាម ក៏ មាន ទំនាក់ទំនង ល្អ ជាមួយ អាមេរិក ដែរ ៕
គ្រាន់តែ ការចូលចិត្ត ទៅ តាម កាលៈទេសៈ តែ ប៉ុណ្ណោះ ៕
ប៉ុន្តែ អ្នកប្រើប្រាស់ បណ្តាញ សង្គម បាន ប្រតិកម្ម ទៅនឹង របាយការណ៍ នេះ ។
គ្នា ដោយសារ ដៃគូរ នៅក្នុង ឆាក ជីវិត របស់ ពួកគេ ។
និយាយ លែង ចេញ មាន វីដេអូ
ខ្ញុំ ខ្វល់ខ្វាយ ថា នឹង មាន ការកើនឡើង នៃ ការសាយភាយ ឧស្ម័ន ផ្ទះ កញ្ចក់ នៅពេល មាន ការកើនឡើង នៃ សេដ្ឋកិច្ច ។
នេះ ហើយ ជា ការចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ !
ជាមួយ វៀតណាម រហូតមក គ្មាន ចំណេញ អ្វី បន្តិច ទាល់តែសោះ !
បាន ចុះផ្សាយ ក្នុង បង្កើន សមត្ថភាព . ទំលាក់ មួយ វិចារ
លោក បាន មកដល់ ប្រទេស
លុយកាក់ មិន ត្រូវ បញ្ចេញ ប្រាក់ វិនិយោគ ក្នុង ថ្ងៃ នេះ ។
ខ្ញុំ យក វា មក ផ្ទះ វិញ ហើយ អង្គុយ សម្លឹងមើល ពេញ ១យប់ ។
មួយ រយ ម្ភៃ ថ្ងៃ មក នេះ ខ្ញុំ កើតទុក្ខ ច្រើន ជាង សប្បាយ ។
រើស អេត ចាយ បាន ព្រឹក ខ្វះ ល្ងាច ស្លាប់ ចោល ប្រពន្ធ កូន ដោយសារ គ្មាន លុយ ព្យ បាល ជម្ងឺ
នេះ សម្រស់ របស់ នាង ធ្វើឱ្យ កាមេរ៉ា ជាច្រើន បង្វែរ កាណុង រក ៕
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក កៀក ក ៖
ពិចារណា លើ ពាក្យ បេះ បិទ ។
កិច្ចន មស្ការ រត្តិកាល ០៩មីនា ២៥៦០ ថ្វាយ ប្រគេន ជូន បុណ្យ ធម្មមិត្ត គ្រប់ រូប !
ឥឡូវនេះ ទូលបង្គំ សូម មក
ពេលនេះ នាង កំពុងតែ នៅក្នុង បន្ទប់ទឹក ។
កំពូល អ្នក ខ្លាំង ទាំង៣ និង ទទួលបាន រង្វាន់ ដ៏ អស់ ចារ
សម្រាប់ ពត៌មាន បន្ថែម សូម ចូល ទៅកាន់ ៖
ខ្ញុំ នឹង មាន អារម្មណ៍ តូចចិត្ត ប្រសិនបើ ខ្ញុំ ធ្វើ មិន បាន ។
ម្យ៉ាងទៀត ពួកគាត់ ទាំង ពីរ ក៏ ជា ដៃគូ សម្តែង សក្តិសម បំផុត ប្រចាំ ឆ្នាំ ២០១៦ នេះ ផងដែរ ។
ដូច្នេះ អ្នក គួរ មើល ថែ ពួកគេ មិន មែន មិន អើពើ ដូចជាមួយ កូនប្រុស របស់ ខ្ញុំ ទេ ដែល រហូត បណ្តាលឱ្យ ស្លាប់ ។
ខ្ញុំ ត្រូវ បង្ខំ ចិត្ត រស់ នៅ យ៉ាង លំបាក ជាមួយ កូនប្រុស ។
ផ្សារភ្ជាប់ ជាមួយ អ្នកគាំទ្រ និង នៅ ជាមួយ អ្នកគាំទ្រ ជានិច្ច ។
នេះ ហើយ ដែល ធ្វើឱ្យ ខ្ញុំ ផ្ញើ បាត្រសខ ខ
ដូចនេះ ពួក សាវ័ក ក៏ បាន ប្រាប់ ពួកគេ ថា ចូរ រើស យក ៧នាក់ ក្នុង ពួក អ្នក រាល់គ្នា ជា អ្នក មាន ឈ្មោះ ល្អ ពេញ ជា ព្រះវិញ្ញាណ បរិសុទ្ធ និង ប្រាជ្ញា នោះ យើងខ្ញុំ នឹង តាំង គេ ឱ្យ ត្រួតត្រា លើ ការងារ នេះ ខ.៣ ។
នៅ ពាក់កណ្តាល ផ្លូវ នៅ ថ្ងៃចន្ទ នេះ បន្ទាប់ពី ទទួលបាន ការព្រមាន មួយ ។
វិនិយោគ នៅ មីយ៉ាន់ម៉ាតែ ៦ឆ្នាំ សោះ ធនាគារ អេស៊ីលីដា ពង …
កុំ ភ្លន់ កុំ លួច
សម្រាប់ ការស្អាង ចិត្ត តាម ដែល ត្រូវការ ដើម្បី ផ្តល់ ព្រះគុណ ដល់ អស់ អ្នក ដែល ស្តាប់ អេភេសូរ ៤២៩គគខ ។
ប៉ុន្តែ ព្រះពុទ្ធ ទ្រង់ មិន បាន បង្ខិតបង្ខំឱ្យ មនុស្ស ទាំងអស់ ត្រូវតែ ធ្វើ តាម នោះ ទេ ។
លោក បាន សរសេរ បញ្ចប់ ប្រយោគ របស់ គាត់ យ៉ាង ដូច្នេះ ថា កន្លែង ទាំងនេះ ត្រូវការ ការ ជួយ របស់ អ្នក យ៉ាង ខ្លាំង អ្នក មិន អាច ចាកចេញ ឱ្យ បាន លឿន ទេ អី ។
អ្នក ត្រូវតែ ពិសារ ពង មាន់ ផ្នែក លឿង ឱ្យ បាន ច្រើន រួមទាំង ឈីស ផងដែរ ។
ដើម្បី ជ្រាប ច្បាស់ សូមអញ្ជើញ លោក អ្នកស្តាប់ កិច្ច សម្ភារ វាង នាយ យ៉ាន នៃ សារព័ត៌មាន ថ្មី ៗ
បាន ដោយ រួមទាំង អត្ថប្រយោជន៍ នៃ ពន្ធ ផងដែរ ។
ដូច្នេះ ដើម្បី ជៀស ឆ្ងាយ ពី បញ្ហា នេះ តើ អ្នក គួរ ធ្វើ ដូចម្តេច ?
ពេល ដែល គ្រួសារ របស់ ពួកគេ ត្រូវបាន បណ្តេញ ចេញ ពួកគេ បាន ដាក់ បណ្តា សានៅលើ ដី ដែល ក្រុមហ៊ុន បាន ទទួល សិទ្ធអភិវឌ្ឍ ន៏ អោយ ជួប តែ សំណាង អាក្រក់ ។
បុរស ម្នាក់ ធ្វើ អត្តឃាត ចងក សម្លាប់ ខ្លួន ឯង នៅ ស្រុក មេសាង
ទៅ មិន គោរព សាសនា ព្រះសម្មាសម្ពុទ្ធ ប្តូរ ទៅ គោរព សាសនា ផ្សេង ៗ
គឺជា ការបាត់បង់ នូវ ជីវិត ពិតប្រាកដ ។
មាន ឋានៈ តួនាទី សិទ្ធិ អំណាច និង ការទទួលខុសត្រូវ ដូចគ្នា ។
សិស្សានុសិស្ស ត្រូវ នៅ ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន ។
តើ អ្នក ពិតជា បាន ឆ្លើយឆ្លង ផ្ទាល់ ជាមួយ នាយក រដ្ឋមន្ត្រី មែន ទេ ?
ដាក់ កាមេរ៉ា ថត ខ្មោច បែរជាជាប់ រូប កូនប្រុស កំពុង រួមរ័ក្ស ជាមួយ សង្សារ ខ្លួន ទៅ វិញ
ដល់ អតិថិជន នៅ កម្ពុជា ។
ទាញយក សម្រាប់ អ្នកប្រើ ៖
ខ្ញុំ យល់ ថា ពេល ដែល យើង និយាយ ទៅកាន់ ព្រះទ្រង់ សព្វ ព្រះទ័យ នឹង ការអធិស្ឋាន ដែល ច្បាស់ ៗ
ក្នុង ក្របខ័ណ្ឌ ពុទ្ធសាសនា បច្ចុប្បន្ន មាន អញ ចឹង ដែរ ឬ ?
វិធី ទី មួយ មិន ត្រូវ ប្រើប្រាស់ របស់របរ អាហារ ឬ ភេស្ជៈ ចូល គ្នា ឡើយ
អាល្វិង ផឹក មើល អត់ បាន
សម្រាប់ ទ្រទ្រង់ ដល់ រាងកាយ មនុស្ស យើង និង មិន អាច ខ្វះ បាន សម្រាប់ ជីវភាព រស់ … អាន បន្ត
គាត់ ជា កីឡាករ ម្នាក់ គត់ ខុសពី គេ ហើយ ពេលនេះ ខ្ញុំ ពិតជា ខកចិត្ត ។
ហើយ បេក្ខជន ហាក់ មាន ទំនុកចិត្ត ជាង មុន ។
បានជា គាត់ មានប្រសាសន៍ ថា ការបន្ថយ ល្បឿន បាន ក្លាយជា មេរៀន មួយ សំខាន់ បំផុត ដែល ខ្ញុំ រៀន បាន ពី បទពិសោធន៍ របស់ ខ្ញុំ ។
ជួនកាល ថ្នាំ បណ្តាល អោយ មាន បញ្ហា នៅ ពេល ដែល ពួកវា ត្រូវបាន គេ ប្រើ រួមគ្នា នេះ ត្រូវបាន គេ ហៅ ថា ប្រតិកម្ម ថ្នាំ ។
ដែល ជាប់ពាក់ព័ន្ធ បទល្មើស ហ្នឹង លោក មិន មាន ការភ័យខ្លាច ទៅនឹង ការអនុវត្ត ច្បាប់ ។
១៧វិថី ម៉ាក ខេន ឈុត ៣
ខ្ញុំ ចង់បាន កីឡាករ ដែល មក ចូលរួម ហើយ គិត ថា ៖
ទៀត ប្រហែលជា មាន ដូចជា ៖
អ្នក កំពង់ស្ពឺសល់ តែ ប៉ុន្មាន ថ្ងៃ ទៀត នឹង មាន ការដាច់ ភ្លើង ហើយ !
ពួកគេ ទាំង ៣នាក់ មកពី ប្រទេស ខុស ៗ
ពួក លោក ក៏ បាន រិះគិត ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ នេះ នឹង កើតមាន នៅ ជំនាន់ ណា ក្នុង កាលៈទេសៈ ណា ។
គណៈកម្មាធិការ នេះ ត្រូវ ធ្វើការ ឱ្យ បាន ហ្មត់ចត់ ។
ធ្វើ ដូចម្តេច បើ អ្នក បាន ឆ្លង រោគ ផ្សិត លើ ស្បែក រួចទៅហើយ ?
ខ្ញុំ សុខចិត្ត ធ្វើ តាម បទបញ្ជា របស់ ព្រះអង្គ
គាត់ បាន មក កម្ពុជា នៅ ថ្ងៃទី ១៤ ខែមីនា ។
មនុស្ស ស្រី មួយចំនួន បដិសេធ ការរួមភេទ ដោយសារ ខ្លួនប្រាណ នាង មិន ស្អាត ។
បើសិនជា ធ្វើ អញ្ចឹង ដាក់ មក លើ កូន របស់ ខ្ញុំ វា ប្រាកដជា ធ្វើអោយ ខ្ញុំ ខឹងសម្បារ យ៉ាង ខ្លាំង ។
សត្រូវ របស់ យើង កំពុង បន្ត រក វិធី ថ្មី ៗ
វា មាន ប្រវែង៦ម៉ែត្រ និង ទម្ងន់ ៥តោន ព្រោះ វា មាន សំបក កង់ ត្រាក់ទ័រ ធំ ៗ
ម្ចាស់ ពានរង្វាន់ ធំ ៖
មក ជួប នឹង ព្រះចៅ កាលិហ្វ ជាថ្មី ម្តង ទៀត ។
ទឹកមុខ ញញឹមញញែម អម ដោយ សម្តី មាត់ ៗ
ប្រការ មួយចំនួន របៀប ដាក់ ឈ្មោះ មនុស្ស វៀតណាម
លោកស្រី ណាវី ពី ឡៃ មានប្រសាស ន៏ ថា លោកស្រី បាន ឃើញ អ្វី ដែល លោកស្រី ហៅ ថា ការខូច ទឹកចិត្ត របស់ អ្នក ស្វះស្វែងសុំ សិទ្ធិ ជ្រកកោន ដែល បាន ចំណាយ ពេល រាប់ សិប ខែ រង់ចាំ ឱ្យ គេ ដោះលែង ។
អ៊ីម៉ែល នេះ គ្មាន ប្រយោជន៍ អី នោះ ទេ ។
អ្នកណា ហ៊ាន រំលោភ បញ្ជារ របស់ ខ្ញុំ ?
នៅក្នុង ការអធិប្បាយ និង ជីវិត ពួក ជំនុំ ។
ខ្ញុំ បាន និយាយ ជាមួយនឹង មេ ទាហាន ម្នាក់ ហើយ បាន ប្រាប់ គាត់ អំពី បញ្ហា របស់ យើង ។
ប្រសិនបើ អ្នក ធ្វើ ដូចនេះ អ្នក នឹង បាន ផល ដូចនេះ ហើយ បន្ទាប់មក គឺ ត្រូវ ធ្វើ អ្វី បន្ត ទៀត ។
ដោយ គាត់ ជិត មាន អាយុ ៣ឆ្នាំ នោះ គាត់ ចាប់ផ្តើម រៀន ចេះ និយាយ បាន ច្រើន ទៅ ៗ
ចិត្ត ស្រី ដូចគ្នា ?
ទោះ យ៉ាងណា ក្តី កិច្ច ខិតខំ ប្រឹងប្រែង ដ៏ វិជ្ជមាន មួយ កំពុង ធ្វើឡើង ក្នុង ប្រទេស កម្ពុជា ។
តាម លក្ខខណ្ឌ និង ការប្រឡង ជ្រើសរើស ដូច ខាងក្រោម ៖
អរគុណ ព្រះជាម្ចាស់ ដែល ខ្ញុំ មិន ដួល សន្លប់ មុន ចប់ កម្មវិធី !
ចំនួន ៦បាន បដិសេធ ហើយ បាន បន្ត ធ្វើ កូដកម្ម បាតុកម្ម នៅ ថ្ងៃ នេះ ទៀត ៕
ម្តង ទៀត ដើម្បី បង្រៀន ពួកគេ ពី លទ្ធិ ប្រជាធិបតេយ្យ ៕
ត្រូវ ព្យាយាម ឆ្លើយ នឹង សំណួរ នេះ ថា ខ្ញុំ នឹង ព្យាយាម ឬ ខ្ញុំ នឹង ប្រឹង ឱ្យ អស់ ពី សមត្ថភាព របស់ ខ្ញុំ ។
សាក្សី ខ្លះ ប្រាប់ មុនពេល អគារ នេះ រលំបាក់ …
ប្រទេស ចិន បាន ឈប់ ធ្វើ ការចរចា ស្តីពី ក្រម នេះ មុន ឆ្នាំ ២០១៦ ។
ដែល អាច ធ្វើឱ្យ កូន អ្នក អាច ឈ្លក់ បាន ។
ក្នុង រយៈពេល ចុងក្រោយ នេះ គឺ ចំនួន ទស្សនកិច្ច របស់ នាវា មាន ការកើនឡើង ជាលំដាប់ ។
កុំ វាទ អត្ថន័យ ប្រាំបី មីនា
នៅ ព្រឹក មិញ នេះ សាលាឧទ្ធរណ៍ …
មាន មន្ត្រី ជាច្រើន ហើយ ដែល ប្រឹងប្រែង ធ្វើការបម្រើ រាស្ត្រ ទាំង យប់ ទាំង ថ្ងៃ ។
ក្នុង រយៈពេល ពីរ បី ខែ ដំបូង នៃ ការណាត់ជួប ជាមួយ មនុស្ស ដែល អ្នក ចូលចិត្ត , សូម អនុវត្ត តាម វិធី ខាងក្រោម …
វា បាន ជួយ ផ្តល់ ការអប់រំ ដល់ មនុស្ស ទូទៅ អំពី កម្រិត នៃ បញ្ហា នៃ ការប្រកាន់ ពូជសាសន៍ នៅក្នុង សង្គម អាមេរិក ។
ពេលនេះ នាង បាន ក្លាយជា អ្នក ស៊ើបអង្កេត ទៅ ហើយ ។
គាត់ និយាយ ឱ្យ តែ ល្អ ស្តាប់ ពីរោះ ស្តាប់ ។
ចលនា សេរី និង បើក ចំហ
គាត់ ស្មាន តែ អ្នកធ្វើដំណើរ ធម្មតា ។
គ្នា វាយប្រហារ ដើម្បី បំបាក់ ក្រុម របស់ លោក ។
សំណុំរឿង នេះ កំពុង ស្ថិត នៅក្នុង វាំងនន ខ្មៅ នៅឡើយ ទេ ។
តើ នរណា ថា មនុស្ស ប្រុស មិន ចូលចិត្ត ការ ថ្នាក់ថ្នម ទៅ ?
បាន ការងារ អ្វី ធ្វើ ឬ នៅក្នុង អន្តរកាល នេះ មិន ទាន់ ទទួលបាន សញ្ញាបត្រ បណ្តោះអាសន្ន នៅឡើយ ។
ឱសថ ធម្មជាតិ អាច ព្យាបាល ជំងឺ ស្រែង ឱ្យ ជា ដូច គេ បេះ
លើស ពី នេទៅ ទៀត កម្មករ និយោជិត ប្រហែល៨ ភាគរយ ប្រឈម នឹង អាហារ គ្មាន សុវត្ថិភាព ធ្ងន់ធ្ងរ ។
កម្លាំង ទាហាន ការពារ ជាតិ អាមេរិក បាន ជួបជុំគ្នា នៅមុខ វិមាន រដ្ឋសភា កាលពី ថ្ងៃទី ១៣ ខែមករា ។
មាន ក្រុមហ៊ុន ជប៉ុន ជាង ១៥០០ ក្រុមហ៊ុន បាន ចុះបញ្ជី នៅក្នុង ប្រទេស កម្ពុជា
យើង គ្មាន ជំរើស ណា ឱ្យ ល្អ ជាង ការដាក់ចេញ នូវ នយោបាយ ឈ្នះ ឈ្នះ ដើម្បី បញ្ចប់ សង្គ្រាម នៅ កម្ពុជា នោះ ទេ ។
យ៉ូសែប គឺជា អ្នកតំណាង ។
កុមារ រពឹស ចូលចិត្ត លេង តែ ម្នាក់ឯង ។
ដូចជា មាន់ ស្ងោរសម្ល ម្ជូរ សាច់ គោ ជាដើម ។
សមាគម អង្គការ មិន មែន រដ្ឋាភិបាល ចុះបញ្ជី នៅ ក្រសួង …
ឧបទ្ទវហេតុ ទាំងមូល គឺ ច្បាស់ ណាស់ ជា សញ្ញា នៃ អន្ទាក់ ។
គេ ដូច ចង់ មើល ខ្ញុំ ឱ្យ ធ្លុះ រាងកាយ អញ្ចឹង ។
ឬ មន្ត្រី បោះឆ្នោត ក្នុង រដ្ឋ ទាំងនោះ ។
បងប្អូន ជួយ ខ្ញុំ ផង ។
ថ្ងៃសៅអាទិត្យ មាន អ្នក ទៅ លេង ច្រើន ។
រុស្ស៊ី ប្រមូលផ្តុំ កម្លាំង ទ័ព នៅ តាម ព្រំដែន ជាប់ ជាមួយ កូរ៉េ ខាងជើង ដែរ ?
គេ ជឿ ថា អាបធ្មប់ មាន ឥទ្ធិពល ម្យ៉ាង ដែល មាន អានុភាព មក លើ ជីវិត របស់ មនុស្ស ។
គ្មាន បុណ្យ ទេ ហើយ ប្រាកដជា គ្មាន អ្នកណា នឹកឃើញ រូប យើង ដែរ ។
អ្នក ផ្សេង ជាពិសេស ប្រធាន គាត់ ស្រួល ណាស់ ។
គ្នា យ៉ាង ផុសផុល រហូតមកទល់ ពេល ។
កម្លាំង ត្រៀម អស់ ហើយ កម្លាំង បាន ទទួល បទ បញ្ជា អស់ ហើយ ។
លោក លី ជាន ស្រឡាញ់ ការងារ នេះ ក្រៃលែង ។
ខណៈ ដែល ទណ្ឌកម្ម ផ្នែក ជាច្រើន ត្រូវបាន អាមេរិក និង បស្ចិម ប្រទេស ដក ជា បន្តបន្ទាប់ ៕
ដូច្នេះ ថ្នាក់ ជាតិ ថ្នាក់ ពាក់ព័ន្ធ ត្រូវតែ ដោះស្រាយ ឡើងវិញ ។
គឺ គ្រោះថ្នាក់ នៃ ការស្ងាប ជាប់ ថ្គាម ។
ផឹក ស្រា ច្រើន ពេក អាច បណ្តាល អោយ មាន បញ្ហា
ត្រឡប់ ទៅ លេង ស្រុក វិញ ឱ្យ ពិសេស អស្ចារ្យ ក្នុង ឆ្នាំ នេះ !
វាល សុបិន - អ្នកស្រី សួន ចន្ថា
ចលនាគភ៌ នឹង ចាប់ផ្តើម បង្ហាញ កាន់តែ ច្បាស់ ។
បញ្ហា មួយ ទៀត គឺ ខ្ញុំ ត្រូវការ សន្សំ លុយ ដោយ ខ្លួន ឯង បង្កើត អ្វី ៗ
តើ នរណា នឹង បង្ករ អស្ថិរភាព ដល់ ប្រជាជន និង កម្ពុជា ?
គឺ អ្នក មិន ប្រព្រឹត្ត អំពើហិង្សា ដើម្បី រក កំរៃ
ខ្ជិល ដាក់ ព្រោះ ខ្លាច ប៉ូលីស អត់ ការងារ ធ្វើ
គាត់ នឹង អាច ផ្តល់ឱ្យ យើង ដល់ ចំណុច កំពូល ដូចគ្នា ។
តើ ខ្ញុំ គ្រូ បាន ធ្វើឱ្យ មាន ការផ្លាស់ប្តូរ អ្វី ខ្លះ នៅ អនុវិទ្យាល័យ នរា នោះ ?
ធ្វើ បញ្ញា ដែល ឃើញ ច្បាស់ ក្នុង ចតុរារិយសច្ច ឱ្យ កើតឡើង នោះ បាន ខាង ការធ្វើ សេចក្តី ដឹង សេចក្តីឃើញ ក្នុង ទុក្ខ សច្ច , សមុទយសច្ច , និរោធ សច្ច , មគ្គសច្ច ឱ្យ កើតឡើង ។
គិត រហូតមកដល់ ពេលនេះ មាន រយៈពេល ជាង ២ឆ្នាំ ហើយ ដែល លោក ហុង
នៅក្នុង ឆ្នាំ ២០០១ អ្នកវិទ្យាសាស្ត្រ រកឃើញ ក្បាល ព្រួញ បាន ជាប់ ក្នុង ស្មា របស់ សព ។
របស់ ព្រះសង្ឃ ឡុង ចន្ថា ដែល ទេសនា រឿង លុយ តិច ។
អ្នកអង្គុយ ក្បែរ តាលីវ ទៅ ណា
ដែល កន្លងមក ដែល និយាយ នោះ វា ប៉ះពាល់ ដល់ គេ ។
ត្មាត ទុរទសី ជា ប្រធាន រដ្ឋមន្ត្រី ឆ្លើយ ប្រាប់ ថាៈ ទេវៈ !
ប៉ុន្តែ វា នៅតែ មិន ដឹងខ្លួន ដដែល ហ្នឹង ពួក អាមុខ ក្រាស់ អស់ ហ្នឹង នោះ …
គ្មាន នរណា មក បំភ័យ ពួកគេ ទៀត ឡើយ ។
ទោះ យ៉ាងណា ក៏ដោយ បញ្ហា គ្រោះថ្នាក់ ចរាចរ នេះ មិន មែន ជា បញ្ហា របស់ រាជ រដ្ឋាភិបាល តែ ម្នាក់ឯង នោះ ទេ ។
ជនរងគ្រោះ បាន ស្រែក ហៅ ឱ្យ កូន ៗ
មួយ ថ្ងៃ ដូចជា ៖
ដោយ មិន ខ្លាច ញញើត ច្បាប់ សូម្បីតែ បន្តិច ។
ហេតុ អ្វី បានជា ប៉ាគីស្ថាន ចេញមុខ ជួយ បន្ថយ ភាពតានតឹង រវាង អ៊ីរ៉ង់ និង អារ៉ាប៊ី សាអូឌីត ហើយ ថា តើ វា អាច ទៅ រួច ដែរ ឬ ទេ ?
ក្នុង គេហដ្ឋាន បន្ទប់ គេង ឬ ការិយាល័យ ផ្ទាល់ខ្លួន របស់ លោក អ្នក ។
ហើយ ក្រុមហ៊ុន របស់ អ្នក មាន ធនធាន គ្រប់គ្រាន់ ក្នុង ការជួយ បុគ្គលិក ខ្លួន ឱ្យ សម្រេច គោលដៅ ទាំងនោះ ឬ ទេ ?
វា ជា ការសំខាន់ ណាស់ ដែល អ្នក ត្រូវ រក អោយ ឃើញ នូវ ចំណង ទាក់ទង គ្នា រវាង ចំណង់ចំណូលចិត្ត និង ទេពកោសល្យ នេះ ។
តើ ចាំបាច់ អ្វី ដែល រដ្ឋាភិបាល ត្រូវ ញែកងារ ឧកញ៉ា ចេញ ពី កងកម្លាំងប្រដាប់អាវុធ នៅ ពេល នេះ ?
ភាសិត អក្ខរាវា ចាចិត្ត ខ្ញុំ
ចាប់ពី ដើម ឆ្នាំ ២០១៧ ដោយ មាន ការដាក ពង្រាយ កង វរសេនា តូច ចំនួន ៤ ដែល ក្នុង
ចុមងារ ចៅហ្វាយ ខេត្ត ក្រចេះ ជំនាន់ ណា ណ្នឹង បង បាន វែង ម៉េះ ?
បាទ ខ្ញុំ គាំទ្រ ចំពោះ ឆន្ទះ ក្នុង ការសរសេរ និង ចែករំលែក របស់ បង ។
អ្នក ត្រូវ នៅក្នុង ផ្ទះ កន្លែង ត្រជាក់ ជាមួយ កូន ។
ដែល លំបាក ពិតប្រាដក ហើយ បាន ឃើញ ពួកគេ ទទួល អំណោយ និង ញ៉ាំ អាហារ ដោយ ផ្ទាល់ ភ្នែក ។
ទៅកាល ឆ្នាំ មុន ខ្ញុំ ធ្លាក់ ទី ១២ហើយ ខ្ញុំ មិន ទាន់ មាន សញ្ញាបត្រ នៅឡើយ ។
បើ បងប្អូន មាន ចំណាប់អារម្មណ៍ សូម ផ្ញើរ CV មកកាន់ អ៊ីម៉ែល ៖
កម្មវិធី និង ទៅតាម ទម្រង់ មុខ
គ្រោះ ធម្មជាតិ ច្រើន ជាង ការអភិវឌ្ឍ !
គ្រាន់តែ ទីក្រុង នេះ បាន ជម្រុញ ទឹកចិត្ត ខ្ញុំ រួច មកហើយ ។
សម្រាប់ អាញ់ ស្តាញ់ ដែល តែងតែ មាន ក្តី ប្រាថ្នា ចង់ ធ្វើជា សាស្ត្រាចារ្យ រូប វិទ្យា តាំងពី យូរ ណាស់ មកហើយ នោះ នេះ គឺជា សុបិន្ត ក្លាយជា ការពិត ។
គាត់ ពិតជា មាន សំនៀង ពីរោះ ណាស់ ។
ការបញ្ចប់ គម្រោង ទាំងមូល និង ការប្រគល់ លំនៅដ្ឋាន គ្រោង ធ្វើឡើង នៅ ឆ្នាំ ២០២២ ។
ទៀត ដែល សមរម្យ សំរាប់ អ្នក ។
នេះ ដោយសារតែ អ្នករង ភាពតានតឹង ក្នុង អារម្មណ៍ ច្រើន ពេក ក្នុង ពេល សម្រាល កូន ។
ប៉ុន្តែ មិន មែន មាន ន័យ ថា អ្នក ត្រូវ កាត់ផ្តាច់ មិន ញ៉ាំ សាច់ ទាំងស្រុង នោះ ទេ ។
ទៅដល់ កម្លាំង យោធា និង ក្រុមគ្រួសារ របស់ គាត់ ។
ខែ ភ្លឺ អនុស្សាវរីយ៍
ប៉ុន្តែ យើង ត្រូវការ ពេលវេលា ។
មើល ចរិត បុរស មុនពេល សុំ រៀបការ
ជាតិ នេះ អូន មិន អាច អោយ បង ទៅ អ្នកណា ស្រុក ខ្មែរ ស្នេហ៍ ខ្ញុំ
ប៉ុន្តែ បើ ភាគី ចាញ់ ក្តី នៅ មិន សុខចិត្ត ហើយ បង្ក បញ្ហា នោះ គឺជា រឿង ផ្សេង មួយ ទៀត ៕
ក្នុង លោកិយ នេះ ច្រើន ជាង សរសើរ ដំកើង ព្រះអម្ចាស់ ?
ខ្ញុំ គិត ថា ខ្ញុំ គួរតែ ឈប់ ទាក់ទង នឹង មនុស្សលោក ទៀត ហើយ ។
យើង ទាំងអស់ គ្នា ដឹង ថា អក្ខរកម្ម គឺ មិន មែន គ្រាន់តែ ជា ការទទួលបាន នូវ បំនិន នៃ ការអាន ការសរសេរ និង គិត លេខ ជា មូល ដ្នាន នោះ ទេ ។
លោក ត្រាំ បញ្ជា ឱ្យ ពលរដ្ឋ អាមេរិក …
ទូលព្រះបង្គំ កើត សុធា ៖
មរណភាព របស់ អតីត រដ្ឋមន្ត្រី មិន ឃិន បាន ប្តូរ ម៉ោង !
១ ព្រះអម្ចាស់ មាន ព្រះបន្ទូល មកកាន់ លោក ម៉ូសេ នៅលើ ភ្នំ ស៊ីណៃ ថា ៖
ជាមួយ រូបរាង និង គុណភាព មិន ធម្មតា ។
វិធី ចម្រាញ់ ប្រេង ដូង បែប សរីរាង្គ ដែល លោក អ្នក អាច ធ្វើ បាន ដោយ ខ្លួន ឯង នៅ ផ្ទះ
ឯ ប្រុស ម្នាក់ ដែល ធ្វើជា អ្នកចាំ ឱ្យ ទឹក
សូម អ្នក ដែល មាន បទពិសោធន៍ ជួយ ដោះស្រាយ បញ្ហា នេះ ឱ្យ ខ្ញុំ ផង ខ្ញុំ ទាល់ គំនិត ហើយ ។
លោក កឹម សុខា ត្រូវបាន ចាប់ខ្លួន ពី បទ ក្បត់ ជាតិ
នាង មាន អាយុ ១៦ ឆ្នាំ ពេល បាត់ខ្លួន ។
ខ្ញុំ បាន ខិតខំ ធ្វើអស់ ពី លទ្ធភាព ដោយ លាប ថ្នាំ ទ្រនាប់ ហើយ លាប ថ្នាំ ថ្លៃ ៗ
ឆ្កែ អាក្រក់ បំផុត លើ ពិភពលោក ងាប់ ហើយ
កត់ត្រា នៅក្នុង ម៉ឹង ជី
តើ អ្នក ចង់ រៀន ជំនាញ និង បទពិសោធន៍ ថ្មី ៗ
លោកស្រី រង់ចាំ រហូតដល់ បុណ្យ អុំ ទូក ចប់ ៖
ព្រះអង្គ ក៏ បាន ប្រកាស អំពាវនាវ អ្នក ដែល ស្រឡាញ់ និង ភក្តីភាព ជាមួយ រាជានិយម ចូលមក រួម ជាមួយ ព្រះអង្គ ផងដែរ ៕
អ៊ីរ៉ង់ និយាយ ថា ខ្លួន ត្រូវតែ ស្ថាបនា កាំ ជ្រួច សំ…
ចូល ឆ្នាំ ចិន ឆ្នាំ មាន់ និយាយ ពី រូបចម្លាក់ ត្រាំ ជា សត្វ មាន់
ប៉ុន្តែ នាង បាន ឡើង គ្រែ ជាមួយ មិត្ត ប្រុស របស់ ខ្ញុំ ហេតុ នេះ ខ្ញុំ ក៏ បញ្ឈប់ នាង ភ្លាម ។
ខ្ញុំ បារម្ភ ថា សំឡេង ភាគ ច្រើន នឹង ជំរុញ ឱ្យ ធ្លាក់ វិញ ។
២៤ ម៉ោង សម្រាប់ អ្នក - កំដរ អ្នកគ្រប់ វិនាទី
ទឹកដី ប្រាក់ ទ្រព្យ និង ស្រូវ យ៉ាងណា គោ ទាំងឡាយ សម្រាប់ ប្រកប កិច្ចការ របស់ មនុស្ស ក៏ យ៉ាង នោះ ដែរ ព្រោះថា វត្ថុ មាន ទឹក ជាដើម នោះ ជា បរិក្ខារ របស់ ពួក សត្វ មាន ជីវិត សូម ព្រះអង្គ បូជា នូវ ទ្រព្យ ដ៏ វិចិត្រ ជាច្រើន របស់ ព្រះអង្គ សូម ព្រះអង្គ បូជា នូវ ធន សម្បត្តិ ដ៏ ច្រើន របស់ ព្រះអង្គ ។
ជាមួយ ទស្សនវិជ្ជា នេះ ពេល ដែល យើង មាន បទពិសោធ ផ្នែក អាហារ ប្រេស៊ីល យើង បាន នាំ ទៅកាន់ ប្រទេស សិង្ហបុរី ។
ចូលមក រក ខ្ញុំ ចុះ កុំ ឃាត់ ពួកគេ ឡើយ ដ្បិត ព្រះរាជ្យ នៃ ស្ថាន សួគ៌ ជា របស់ មនុស្ស ដូច ក្មេង ទាំងនេះ ឯង ។
មួយវិញទៀត សូម កុំ បរិភោគ រួម ជាមួយ ជន ប្រភេទ នេះ ឡើយ ។
ជំហរ អាមេរិក ចំពោះ ភូមា នា ពេល បច្ចុប្បន្ន
នាង បាន ធ្វើឱ្យ ជីវិត ខ្ញុំ ប្រសើរ ច្រើន ណាស់ ។
ប៉ុន្តែ អ្វី ដែល ជា ការព្រួយបារម្ភ របស់ ខ្ញុំ នោះ គឺ ការប្រើប្រាស់ ជំនួយ វា មិន ចំ គោលដៅ ។
ការផ្ទុះឡើង ជាថ្មី នៃ ជំងឺ នេះ ត្រូវបាន ប្រកាស កាលពី ថ្ងៃអង្គារ កន្លងទៅ ។
ក្រៅពី នេះ នៅ មាន ចំណុច មិន សម ហេតុផល មួយចំនួន ដូចជា ៖
នរណា នឹង អម ដំណើរ ជាមួយ មឿន សុខ ហ៊ុច ទៅដណ្តើម ខ្សែក្រវាត់ មាស នៅ ប្រទេស ថៃ
អ្នកនយោបាយ ភាគ ច្រើន កំពុង លាក់ ខ្លួន ។
ទូទាំង អាមេរិក !
ទោះបីជា យ៉ាងណា ក្តី មួយ រយៈពេល ក្រោយ នេះ គេ មិន ឃើញ មាន បទចម្រៀង ថ្មី ៗ
វា ដំណើរការ យ៉ាងម៉េច ដែរ ?
ព្រីម លីហ្សា សុខភាព មាន តម្លៃ ស្មើ ជីវិត
ដូច្នេះ ម្តងម្កាល អ្នក មិន ចាំបាច់ លាង សម្អាត សុដន់ នោះ ទេ ។
កាលណា មនុស្ស ហាត់ កីឡា គឺ អត់ សូវ មាន ជំងឺ ដង្កាត់ ទេ ។
ជួនកាល ខ្ញុំ មានអារម្មណ៍ ថា ពិបាក យល់ ផងដែរ ពេល ដែល ខ្ញុំ ពិចារណា អំពី របៀប ដែល ព្រះទ្រង់ ធ្វើការ ។
ចំពោះ អ្នក ប្រកបរបរ រកស៊ី ជួញដូរ វិញ លោក អ្នក មិន គួរ ទុកចិត្ត មនុស្ស ពេក ទេ ប្រយ័ត្ន ត្រូវ ចាញ់បោក គេ អសារ ឥត ការ ។
កាល នោះ នាង បាន និយាយ ថា គោលបំណង មួយ ដ៏ សំខាន់ របស់ នាង ក្នុង ជីវិត នេះ គឺ ចង់ មាន អាពាហ៍ពិពាហ៍ ពេញ ដោយ ក្តីស្រឡាញ់ និង ជីវិត ដ៏ រីករាយ ជាមួយនឹង គ្រួសារ របស់ នាង ។
ប្រសិនបើ រឿង នេះ កើត មាន ឡើង មែន នោះ អនាគត នៃ ប្រព័ន្ធ កេណ្ឌ ទាហាន ថ្មី ដ៏ ចម្រូងចម្រាស របស់ ប្រទេស កូរ៉េ ខាងត្បូង ដែល បង្ខំឱ្យ ជ្រើសរើស ដើម្បី បម្រើ ជាច្រើន ខែ នៅ កន្លែង ឆ្ងាយ ដាច់ស្រយាល នៅ តាម បណ្តោយ ព្រំដែន កងទ័ព ប្រហែលជា នឹង ត្រូវ គេ ធ្វើ ការជជែក វែកញែក ។
