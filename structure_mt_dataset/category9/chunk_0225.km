( ភ្នំពេញ ) ៖ លោក បណ្ឌិត គង់ ម៉ារី អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន គណៈកម្មាធិការ សេដ្ឋកិច្ច និង ធុរកិច្ច ឌីជីថល បាន ថ្លែង ថា និន្នាការ ថ្មី ៗ ដែល មាន សក្តានុពល ដូចជា Open Banking និង រូបិយប័ណ្ណ ឌីជីថល ធនាគារ កណ្ដាល គួរតែ ត្រូវបាន យកចិត្តទុកដាក់ បន្ថែម ទៀត ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សេដ្ឋកិច្ច ថ្លែង បែប នេះ នា រសៀល ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ ក្នុង ឱកាស គណៈកម្មាធិការ សេដ្ឋកិច្ច និង ធុរកិច្ច ឌីជីថល និង ធនាគារ ជាតិ នៃ កម្ពុជា បាន សហការរៀបចំ សិក្ខាសាលា ស្តីពី « តួនាទី នៃ វិស័យ ធនាគារ និង បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ ក្នុង សេដ្ឋកិច្ច ឌីជីថល កម្ពុជា » នៅ សណ្ឋាគារ ហៃ យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ ។
លោក បណ្ឌិត បាន លើកឡើង ថា សកម្មភាព ធំ ៗ ទាំង ក្នុង វិស័យ ធនាគារ ដែល រួម មាន ការទូទាត់ . ការសន្សំ . និង ការផ្តល់ កម្ចី គឺ មាន ភាពល្អ ប្រសើរ និង មាន ការអភិវឌ្ឍ ច្រើន គួរឱ្យ កត់សម្គាល់ ។
លោក បាន បន្ត ថា គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ទាំងអស់ បាន ដើរ តួនាទី ជា អន្តរការីយ៉ាង សំខាន់ ក្នុង ការផ្តល់ សេវា ហិរញ្ញវត្ថុ បែប ប្រពៃណី ហើយ គ្រឹះស្ថាន ខ្លះ បាន កំពុង ដាក់ ឱ្យ ប្រើប្រាស់ សេវា ធនាគារ បែប ឌីជីថល ជាពិសេស សេវា ទូទាត់ សង ប្រាក់ ជា អេឡិចត្រូនិក ដែល រួម មាន ដូចជា សេវា ធនាគារ តាម អ៉ីនធឺណិត ឬ សេវា ធនាគារ ចល័ត សេវា ទូទាត់ ចល័ត ប័ណ្ណ ទូទាត់ និង ការទូទាត់ តាម QR Code ជាដើម ៕ គណៈប្រតិភូ នៃ គណៈមេធាវី កម្ពុជា ចូលរួម កិច្ចប្រជុំ សន្និបាត ប្រធាន គណៈ មេធាវី អាស៉ី លើក ទី ៣២ នៅ ប្រទេស សឹង្ហបុរី
គណៈប្រតិភូ នៃ គណៈមេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ចូលរួម កម្មវិធី នេះ រួម មាន៖
១៖ លោក លី ច័ន្ទ តុលា ប្រធាន គណៈ មេធាវី ២៖ លោក មេធាវី យ៉ុន ប៊ុន ណា សមាជិក ក្រុមប្រឹក្សា ៣៖ លោក មេធាវី អាន សុវឌ្ឍនា អគ្គ លេខាធិការ រង ៤៖ លោក មេធាវី ស្រ៊ុន ធី រិទ្ធ ប្រធាន នាយកដ្ឋាន ទំនាក់ទំនង សាធារណៈ និង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ។
១៖ បញ្ហា ប្រឈម ដោយ ការិយាល័យ មេធាវី ក្រោយ ជំងឺ កូវីដ - ១៩២៖ អ្នកដឹកនាំ ជំនាន់ ថ្មី ( ភាព ចម្រុះ និង បរិយាប័ន្ន )៣៖ បញ្ហា ដែល មេធាវី វ័យ ក្មេង កំពុង ជួបប្រទះ ៤៖ ឧបករណ៍ ជំនាន់ ថ្មី - បច្ចេកវិទ្យា ៥៖ បញ្ហា ដែល ប្រឈម ជំនាន់ ថ្មី - សុខភាព ផ្លូវចិត្ត ។
កិច្ចប្រជុំ ប្រធាន គណៈ មេធាវី អាស៉ី លើក ទី ៣២ ត្រូវបាន បញ្ចប់ ទៅ ប្រកបដោយ ជោគជ័យ និង ផ្លែ ផ្កា ព្រមទាំង បរិយាកាស ស្និតស្នាល ប្រកបដោយ ភាតារភាព រវាង គណៈប្រតិភូ ទាំងអស់ ។ កិច្ចប្រជុំ ក៏ បាន ធ្វើ ការសម្រេច ផងដែរ ចំពោះ អាណត្តិ ប្រធានបន្ទាប់ នៃ កិច្ចប្រជុំ លើក ទី ៣៣ គឺ គណៈ មេធាវី ប្រទេស ម៉ាឡេស៉ី ដែល នឹង ប្រារព្ធ ធ្វើឡើង នៅ ប្រទេស ម៉ាឡេស៉ី ៕
តំណាងរាស្ត្រ ខេត្ត បន្ទាយមានជ័យ លោក សេរី កុសល ដឹកនាំ ក្រុមការងារ ចុះ ជួយ ប្រជាពលរដ្ឋ កំពុង រងគ្រោះ នូវ ទឹក ជំនន់ នៅក្នុង ស្រុក ភ្នំស្រុក
( បន្ទាយមានជ័យ )៖ លោក សេរី កុសល តំណាងរាស្ត្រ មណ្ឌល បន្ទាយមានជ័យ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ បាន ចុះ ជួយ បងប្អូន ប្រជាពលរដ្ឋ នៅ ឃុំ ស្ពាន ស្រែង នៅ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ដែល កំពុង រងគ្រោះ ដោយ ទឹក ជំនន់ ។
លោក សេរី កុសល បាន ឲ្យដឹង ថា ទឹក នៅ ឆ្នាំ ២០២២ នេះ ជាទូទៅ នៅ ឃុំ ស្ពាន ស្រែង ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ មាន សភាព ខ្លាំង ជាង ឆ្នាំ កន្លងទៅ នៅ ផ្នែក ខាងក្រោម ដោយសារតែ វា មាន ទឹក ហូរ ចូល ពី ខេត្ដ ឧត្ដរ មានជ័យ និង ខេត្ត ព្រះវិហារ ។
លោក សេរី កុសល បាន បន្ត ថា ការហូរ ទឹក នេះ ឃើញ ថា ធ្វើឲ្យ មាន ការ ទឹក លិច ពី កំណាត់ ផ្លូវ ឃុំ ស្ពាន ស្រែង ទៅកាន់ ទី រួម ស្រុក ភ្នំស្រុក ដោយឡែក ឃុំ ស្ពាន ស្រែង មាន ការលិច ទឹក ជំនន់ ទាំងស្រុង ដោយ មាន សភាព លឿន និង ធំ ជាង រៀង ឆ្នាំ មុន ៗ ។ លោក បញ្ជាក់ ថា កម្លាំង អាជ្ញាធរ បាន ជួយសង្គ្រោះ ជីវិត កុមារ ម្នាក់ ដែល ត្រូវ ទឹក ហូរ ទៅ ជាមួយ ។
តំណាងរាស្ត្រ មណ្ឌល បន្ទាយមានជ័យ បាន អះអាង ថា លោក បាន តាមដាន បញ្ហា ទឹក ជំនន់ នេះ តាំងតែពី ដើម មក មុនពេល មាន ទឹក ជំនន់ ទៅ ទៀត តាំងតែពី កើតមាន ទឹក ជំនន់ ខេត្ត ឧត្តរមានជ័យ ។
ក្នុង ឱកាស នោះ លោក ក៏ បាន នាំយក ទេយ្យ ទាន នំបញ្ចុក និង ថវិកា មួយ ចំនួន ប្រគេន ជូន ទៅ វត្ដ គោក ចារ និង វត្ដ រោគ ដែល មាន ចម្ងាយ ឆ្ងាយ នៅក្នុង ឃុំ ស្ពាន ស្រែង ស្រុក ភ្នំស្រុក ខេត្ដ បន្ទាយមានជ័យ ដោយ បាន លិច ទឹក ជំនន់ ទាំងស្រុង ផងដែរ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ផ្ដល់ ទូក និង ម៉ាស៊ីន ធុន ធំ មួយ គ្រឿង ដែល មាន តម្លៃ ៨៧០ ដុល្លារ ។
លោក បញ្ជាក់ ផងដែរ មកដល់ ពេលនេះ ឃុំ មួយចំនួន ក្នុង ស្រុក ភ្នំស្រុក ក៏ កំពុង រង ការលិចលង់ ផងដែរ រួម មាន ឃុំ ណាន់ តៅ ឃុំ ភ្នំ ដី ឃុំ ប៉ោយ ចារ ដែល ក្រុមការងារ កំពុង តាមដាន និង ជួយសង្គ្រោះ បឋម ដល់ បងប្អូន ប្រជាពលរដ្ឋ ។
លោក សេរី កុសល ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ លោក អ៊ុ រាត្រី ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត បន្ទាយមានជ័យ និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ រួមទាំង ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចាត់ចែង ខ្លាំង និង គ្រឿងចក្រ ដើម្បី ចុះ ទៅ ទីតាំង ទឹក លិច ដើម្បី សម្រួល ដល់ ប្រជាពលរដ្ឋ ផងដែរ ។ ជាពិសេស បាន រៀបចំ កម្លាំង និង ស្បៀងអាហារ ទាន់ ពេលវេលា ជួយ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ផងដែរ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ថ្លែងអំណរគុណ ដល់ ក្រុមការងារ របស់ លោក ដែល បាន ឧបត្ថម្ភ ជា ថវិកា ទោះ តិច ក្តី ច្រើន ក្តី ក្នុង ការជួយ ដល់ ប្រជាពលរដ្ឋ កំពុង រងគ្រោះ ដោយ ទឹក ជំនន់ ៕
លោកស្រី បណ្ឌិត ម៉ែន សំអន នាំយក អំណោយ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចែកជូន ប្រជាពលរដ្ឋ ១០០ គ្រួសារ នៅ ក្រុង បាវិត
( ស្វាយរៀង ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ប្រធាន គណៈ កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ស្វាយរៀង បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន ជួយ ដល់ ចាស់ជរា ជន ពិការ អ្នក រស់ នៅ ជាមួយ មេរោគ អេដស៍ កុមារ កំព្រា ស្ត្រី មេម៉ាយ មាន កូន ច្រើន អ្នក មាន ជំងឺ ប្រចាំ កាយ និង មាន ជីវភាព ខ្វះខាត នៅក្នុង ក្រុង បាវិត ចំនួន ១០០ គ្រួសារ នៅ ក្រុង បាវិត នៃ ខេត្ត ស្វាយរៀង ។
ក្នុង ពិធី ចែក អំណោយ នា ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ លោកស្រី ក៏ បាន ផ្តាំផ្ញើរ សាកសួរ ទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជានិច្ច ជាកាល សម្តេច តែងតែ គិតគូរ ជានិច្ច ពី សុខ ទុក្ខ សុខភាព និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ដោយ មិន ប្រកាន់ និន្ន ការ នយោបាយ ជំនឿ សាសនា ពណ៌ សម្បុរ នោះ ឡើយ ។ ទីណា មាន ការលំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា ដោយ មិន គិត ភាពលំបាក ជិត ឬ ឆ្ងាយ ព្យុះភ្លៀង កាកបាទ ក្រហម កម្ពុជា ទៅដល់ ទីនោះ ភ្លាម ដោយ មិន រួញរា ឡើយ ។
អាជ្ញាធរ ចុះ ផ្សព្វផ្សាយ ពី បញ្ហា គ្រឿងញៀន ជូន ពលរដ្ឋ នា ឱកាស ភ្ជុំ បិណ្ឌ
( ភ្នំពេញ ) ៖ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង មន្ត្រី នៃ សាលា រាជធានី ភ្នំពេញ បាន សហការ គ្នា ចុះ ផ្សព្វផ្សាយ អំពី បញ្ហា គ្រឿងញៀន ដល់ ប្រជាពលរដ្ឋ ឆ្លៀត ពេល ដែល ពួកគេ ប្រើប្រាស់ រថយន្ត មិន គិត ថ្លៃ របស់ សាលា រាជធានី ភ្នំពេញ ដើម្បី ធ្វើដំណើរ ទៅ លេង ស្រុក កំណើត នា ឱកាស ភ្ជុំ បិណ្ឌ នា ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ ។
លោក ឧត្តមសេនីយ៍ ទោ លឹម តុង ហួត បាន បញ្ជាក់ ថា អ្នក ទទួលបាន ខិត្ត បណ្ណ ផ្សព្វផ្សាយ នេះ ភាគ ច្រើន គឺ ប្រជាពលរដ្ឋ ដែល ប្រើប្រាស់ រថយន្ត មិន គិត ថ្លៃ របស់ សាលា រាជធានី ភ្នំពេញ ដើម្បី ធ្វើដំណើរ ទៅ លេង ស្រុក កំណើត នា ឱកាស ភ្ជុំ បិណ្ឌ ។
លោក ឧត្តមសេនីយ៍ ទោ លឹម តុង ហួត បាន បន្ថែម ថា សកម្មភាព ផ្សព្វផ្សាយ ពី បញ្ហា គ្រឿងញៀន ដល់ ប្រជាពលរដ្ឋ នេះ គឺ ដើម្បី ជា ទុន ដល់ ប្រជាជន ការពារ ខ្លួន ឯង និង ផ្សព្វផ្សាយ បន្ត ដល់ ក្រុមគ្រួសារ និង មនុស្ស ជា ទីស្រឡាញ់ កុំ ឱ្យ ទៅ ពាក់ព័ន្ធ នឹង បញ្ហា គ្រឿងញៀន គ្រប់ ប្រភេទ ។
លោក ឧត្តមសេនីយ៍ ទោ លឹម តុង ហួត បាន បន្ថែម ទៀត ថា សកម្មភាព នេះ ធ្វើឡើង ក្រោម ការចង្អុលបង្ហាញ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ អគ្គ លេខាធិការ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ។ លោក ឧត្តមសេនីយ៍ ទោ លឹម តុង ហួត ក្នុង នាម នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដែល បាន គាំទ្រ ដល់ សកម្មភាព ផ្សព្វផ្សាយ នេះ ។
គួរ ជម្រាប ថា អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នឹង ផ្តល់ ខិត្តប័ណ្ណ ប្រឆាំង គ្រឿងញៀន ទាំងនេះ ជូន គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន រាជធានី - ខេត្ត ទាំងឡាយ ណា ដែល រៀបចំ ពិធី ប្រណាំង ទូក ង និង កម្មវិធី ជួបជុំ ផ្សេង ៗ ក្នុង មូលដ្ឋាន រាជធានី - ខេត្ត នោះ ៕ ស្ថានទូត បារាំង និង ស្ថានទូត ជប៉ុន នៅ កម្ពុជា ចេញ សេចក្តីថ្លែងការណ៍ រួម ពាក់ព័ន្ធ សាលា ក្តី ខ្មែរ ក្រហម ក្រោយ តម្កល់ ការផ្តន្ទាទោស ដាក់ ពន្ធនាគារ អស់ មួយ ជីវិត លើ ជនជាប់ចោទ ខៀវ សំផន
កិច្ចប្រជុំ ខាងលើ ធ្វើឡើង មួយ ថ្ងៃ មុន ការប្រកាស សាល ដីកា លើ សំណុំរឿង ០០២ / ០២ ពាក់ព័ន្ធ នឹង ជនជាប់ចោទ ខៀវ សំផន អតីត គណៈ ប្រធាន រដ្ឋ នៃ កម្ពុជា ប្រជាធិបតេយ្យ ដែល ជា សំណុំរឿង ចុងក្រោយ នៅ ចំពោះ មុខ តុលាការ កំពូល នៃ អ. វ.ត .ក ។
ក្រុម មិត្ត នៃ អ. វ.ត. ក ដែល មាន ការប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ចំពោះ ការតស៊ូ ដើម្បី យុត្តិធម៌ និង ប្រឆាំង នឹង និទណ្ឌភាព សូម រំលឹក ឡើងវិញ អំពី ការគាំទ្រ របស់ ខ្លួន និង កិច្ច ខិតខំ ប្រឹងប្រែង ដ៏ ធំធេង របស់ តួអង្គ ពាក់ព័ន្ធ នានា ចាប់តាំងពី តុលាការ នះ ត្រូវបាន បង្កើត នៅ ឆ្នាំ ២០០៦ ហើយ សង្ឃឹម ថា អត្ថន័យ និង កេរ តំណែល នៃ អ. វ.ត. ក នឹង ត្រូវ បន្សល់ទុក ឱ្យ ពលរដ្ឋ ជំនាន់ ក្រោយ ទៀត ៕ ទស្សនា វីដេអូ បង្ហាញ ពី ការប្រើប្រាស់ ផ្លូវ ល្បឿន លឿន លើក ដំបូង នៅ កម្ពុជា និង ស្វែងយល់ ពី លក្ខខណ្ឌ ចាំបាច់ មួយ ចំនួន
លោក អគ្គ មេបញ្ជាការ យោធា អ៉ីរ៉ង់ បាន និយាយ យ៉ាង ដូច្នេះ ថា « សមយុទ្ធ យោធា ដែល រួម មាន វត្តមាន កងទ័ព ជើងទឹក អ៉ីរ៉ង់ . រុស្ស៉ី . និង ចិន នឹង ត្រូវ ប្រារព្ធ ធ្វើឡើង នៅឯ តំបន់ ភាគ ខាងជើង នៃ មហាសមុទ្រ ឥណ្ឌា កំលុង រដូវ ស្លឹកឈើ ជ្រុះ ឆ្នាំ នេះ » ។ លោក បាហ្គើរី ដែល ជា នាយ សេនាធិការ នៃ កងកម្លាំងប្រដាប់អាវុធ អ៉ីរ៉ង់ មិន បាន ផ្តល់ ព័ត៌មាន លម្អិត អ្វី ទៀត ឡើយ ពាក់ព័ន្ធ គម្រោង សមយុទ្ធ នេះ ប៉ុន្តែ លោក បាន បង្ហើប ឱ្យដឹង ថា ប្រទេស ដទៃ ទៀត ដូចជា អូម៉ង់ និង ប៉ាគីស្ថាន ក៏ ប្រហែលជា នឹង មក ចូលរួម ផងដែរ ។
ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង ក៏ បាន ថ្លែង ទៀត ថា កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ តំបន់ (RCEP) ត្រូវបាន ផ្តួចផ្តើម នៅក្នុង ប្រទេស កម្ពុជា ក្នុង ឆ្នាំ ២០១២ ខណៈពេល ដែល កម្ពុជា ធ្វើជា ប្រធាន អាស៊ាន លើក ទី២ ហើយ បាន ចូល ជាធរមាន នៅ ថ្ងៃទី១ ខែមករា ឆ្នាំ នេះ ។ RCEP បាន រួមចំណែក ដល់ ស្ថិរភាព នៃ ពាណិជ្ជកម្ម ពហុ ភាគី នៅក្នុង តំបន់ អាស៉ី - ប៉ាស៉ី ហ្វិក និង ធ្វើឲ្យ ប្រសើរឡើង ថែម ទៀត នូវ ខ្សែ សង្វាក់ ឧស្សាហកម្ម នៃ ពាណិជ្ជកម្ម និង ការវិនិយោគ រវាង រដ្ឋ ជា សមាជិក RCEP ទាំងអស់ ។
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ បាន បន្ត ក្រើន រំលឹក បង្ហាញ វីដេអូ ស្តីពី នីតិវិធី ប្រតិបត្តិ ស្ដង់ដា អប្បបរមា SOP សម្រាប់ អាជីវកម្ម ដឹក ជញ្ជូន ទេសចរណ៍ តាម ផ្លូវ ទឹក ឱ្យ បន្ត យកចិត្តទុកដាក់ បន្ថែម ទៀត ដើម្បី ត្រៀម ទទួល ភ្ញៀវ ទេសចរ ដែល នឹង ធ្វើដំណើរកម្សាន្ត ក្នុង ឱកាស ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ឈានចូល មកដល់ ខាងមុខ នេះ ពី ថ្ងៃទី ២៤ - ២៦ ខែកញ្ញា ឆ្នាំ ២០២២ ។
ដើម្បី ផ្ដល់ ភាពងាយស្រួល មួយ កម្រិត ទៀត ជូន ដល់ ម្ចាស់ អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ ប្រតិបត្តិករ ទេសចរណ៍ ក៏ ដូចជា ភ្ញៀវ ទេសចរ ក្រសួង ទេសចរណ៍ ក៏ បាន ចេញផ្សាយ ឯកសារ និង QR-Code សម្រាប់ ចូល មើល និង ទាញយក ឯកសារ រួចហើយ ពាក់ព័ន្ធ នីតិវិធី ប្រតិបត្តិ ស្ដង់ដា អប្បបរមា SOP សម្រាប់ អាជីវកម្ម ដឹក ជញ្ជូន ទេសចរណ៍ តាម ផ្លូវ ទឹក នេះ ផងដែរ ៕
ទស្សនា វិដេអូ៖ ទិដ្ឋភាព លិច ទូក ដឹក ជនជាតិ ចិន នៅ តំបន់ កោះ តាង ខេត្ត ព្រះសីហនុ សង្គ្រោះ មនុស្ស បាន ១៨នាក់ និង បាត់ខ្លួន ជាង ២០ នាក់ ( ព្រះសីហនុ) ៖ ទិដ្ឋភាព លិច ទូក ដឹក ជនជាតិ ចិន នៅ តំបន់ កោះ តាង ខេត្ត ព្រះសីហនុ សង្គ្រោះ មនុស្ស បាន ១៨នាក់ និង បាត់ខ្លួន ជាង ២០ នាក់ ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ ។ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ផ្តល់ អំណោយ ដល់ ពលរដ្ឋ ក្រីក្រ ជិត ៤០០ គ្រួសារ ដែល ប្រកបរបរ ជា អ្នក រើស អេត ចាយ នៅ ទីលាន ចាក់ សំរាម ខណ្ឌ ដង្កោ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ផ្តល់ អំណោយ មនុស្សធម៌ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៣៨០ គ្រួសារ ដែល ប្រកបរបរ ជា អ្នក រើស អេត ចាយ នៅ ទីលាន ចាក់ សំរាម ខណ្ឌ ដង្កោ នា ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ដើម្បី សម្រួល ដល់ ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ពួកគាត់ និង អាច យក ទៅ ធ្វើ បុណ្យ ទាន តាម គន្លង ព្រះពុទ្ធ សាសនា ។
លោក ឃួង ស្រេង បាន បន្ត ថា បងប្អូន អ្នក រើស អេត ចាយ នៅ ទីលាន ចាក់ សំរាម បាន ប្រកបការរកស៊ី ដោយ សុច្ចរិត ទៀង ត្រង់ មិន ប្រព្រឹត្ត នូវ បទល្មើស លួច ឆក់ ប្លន់ ដែល ជា បទល្មើស ខុស ច្បាប់ ដែល នេះ ពិតជា បាន បង្ហាញ ឱ្យ ឃើញ ថា បងប្អូន ជា ប្រជាពលរដ្ឋ ល្អ រស់ នៅក្នុង សង្គម ។
បន្ថែម ពី នេះ លោក ក៏ បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ ដែល ប្រកប មុខរបរ រើស អេត ចាយ ក្នុង ករណី រក អ្វី មិន បាន សម្រាប់ បរិភោគ បងប្អូន អាច ទៅ សាខា កាកបាទ ក្រហម ខណ្ឌ ដង្កោ ដើម្បី ទទួលបាន ស្បៀងអាហារ សម្រាប់ ដោះស្រាយ ក្នុង ជីវភាព ។
លោក អភិបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ការផ្តល់ អំណោយ មនុស្សធម៌ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ដល់ បងប្អូន ក្រីក្រ រើស សំរាម នា ពេលនេះ គឺ បាន បង្ហាញ ពី ការយកចិត្ត ទុក ដាក់ យ៉ាង ខ្លាំង ទៅ លើ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ក្រីក្រ នា ឱកាស រដូវ បុណ្យ ទាន នេះ ដែល អាច ឱ្យ ពួកគាត់ មាន ថវិកា និង សម្ភារ សម្រាប់ ធ្វើ បុណ្យ ទាន ឬ ជូន អ្នកមាន គុណ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ។
ក្នុង ឱកាស នោះ ដែរ លោក ឃួង ស្រេង បាន នាំ ការផ្តាំផ្ញើ ការសួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល សម្តេច ជានិច្ច ជាកាល តែងតែ គិតគូរ ដល់ បងប្អូន មាន ជីវភាព ខ្វះខាត « ហើយ តែងតែ ណែនាំ ដល់ យើង ទាំងអស់ គ្នា និង កៀគរ សប្បុរសជន ទាំងអស់ ឱ្យ យល់ ឱ្យ ឃើញ និង ធ្វើ ការចែករំលែក ជា អំណោយ ថវិកា សម្ភារៈ និង ស្បៀងអាហារ ជូន ដល់ បងប្អូន អ្នកក្រីក្រ ដែល នេះ ជា ទឹកចិត្ត មិន អាច ខ្វះ បាន របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ប្រមុខ កាកបាទ ក្រហម កម្ពុជា យើង » ។
ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ ដែល នឹង ត្រូវ បើក ឱ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ នៅ ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២២ ខាងមុខ នេះ មាន ប្រជាពលរដ្ឋ មួយ សម្តែង ការព្រួយបារម្ភ រឿង បើកបរ លំបាក នៅ ពេល យប់ ព្រោះតែ មិន មាន ការបំពាក់ ភ្លើង បំភ្លឺ ផ្លូវ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន អះអាង ថា ជា ស្តង់ដារ ផ្លូវ ល្បឿន លឿន នៅលើ ពិភពលោក អត់ មាន ការបំពាក់ អំពូលភ្លើង នោះ ឡើយ ព្រោះ ការធ្វើ បែប នោះ នឹង បន្ថែម បន្ទុក ចំណាយ កាន់តែ ច្រើន លើក ថ្លៃ អគ្គិសនី ។ ប៉ុន្តែ ជំនួស ឱ្យ ការបំពាក់ ភ្លើង បំភ្លឺ គឺ គេ រៀបចំ ប្រព័ន្ធ ចំណាំងផ្លាត នៅលើ ផ្លូវ ដែល ជួយ ឱ្យ ការបើកបរ មិន ជួប ការលំបាក នោះ ឡើយ ។
ដើម្បី ពិនិត្យ ឱ្យ បាន កាន់តែ ច្បាស់ ពី ការរៀបចំ ប្រព័ន្ធ ចំណាំងផ្លាត ក៏ ដូចជា ស្ថានភាព ជាក់ស្តែង ក្នុង ការបើកបរ នៅ ពេល យប់ មាន សភាព បែប ណា នោះ ? នៅ យប់ ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ដឹកនាំ ថ្នាក់ដឹកនាំ ក្រសួង ក៏ ដូចជា ក្រុម អ្នកសារព័ត៌មាន ធ្វើដំណើរ ទាំង យប់ ឆ្លងកាត់ ផ្លូវ ល្បឿន លឿ នេះ ពី ខាង ខេត្ត ព្រះសីហនុ ឆ្ពោះ មកកាន់ រាជធានី ភ្នំពេញ ។
ជាមួយ ការធ្វើដំណើរ នៅ ពេល យប់ បាន ធ្វើឱ្យ យើង បាន ជ្រាប ច្បាស់ ពី ស្ថានភាព បើកបរ ពេលយប់ នៅលើ ផ្លូវ ល្បឿន លឿន នេះ ហើយក៏ ជា ការផ្តល់ បទពិសោធន៍ ថ្មី ជាមួយ ការបើកបរ លើ ផ្លូវ ល្បឿន លឿន ជា លើក ដំបូង នៅ កម្ពុជា នា ពេល យប់ ផងដែរ ។
ដើម្បី សម្រួល ដល់ ការបើកបរ នៅ ពេល យប់ ក្រុមហ៊ុន សាងសង់ ផ្លូវ ល្បឿន លឿន បាន រៀបចំ ប្រព័ន្ធ ចំណាំងផ្លាត បាន យ៉ាង ល្អ នៅលើ ផ្លូវ ។ ពួកគេ បាន រៀបចំ បង្កប់ ប្រព័ន្ធ ចំណាង ផ្លាត នៅលើ ផ្លូវ ចំនួន ពីរ ខ្សែ ហើយក៏ មាន បង្កប់ ចំណាំងផ្លាត លើ របង ដែក នៅ ចិញ្ចើមផ្លូវ និង រណាំង ដែក លើ សួនច្បារ ពុះ ចែក ទ្រូងផ្លូវ ផងដែរ ។
ប្រព័ន្ធ ចំណាង ផ្លាត៤ខ្សែ នៃ គន្លង ផ្លូវ ទាំង សងខាង នេះ បាន បង្កើត ជា ចំណាំងផ្លាត យ៉ាង ច្បាស់ នៅពេល ប៉ះ ជាមួយ ភ្លើង រថយន្ត ។ ដូច្នេះ ធ្វើឱ្យ អ្នកបើកបរ មើលឃើញ ស្ថានភាព នៅលើ ផ្លូវ បាន យ៉ាង ច្បាស់ ក្នុង ចម្ងាយ យ៉ាង ឆ្ងាយ ដោយ មិន បង្ក ការលំបាក សម្រាប់ អ្នក បញ្ជា យានយន្ត នោះ ឡើយ ។
ក្រុម អ្នកបើកបរ ដែល បាន បើក រថយន្ត លើ ផ្លូវ ល្បឿន លឿន នា យប់ ថ្ងៃទី ២២ ខែ កញ្ញា សុទ្ធតែ បាន បង្ហាញ ពី បច្ចេកទេស រៀបចំ ប្រព័ន្ធ ចំណាំងផ្លាត នេះ ថា ពិតជា បាន បង្ក ភាពងាយស្រួល សម្រាប់ ការបើកបរ ព្រោះ ធ្វើឱ្យ មើលឃើញ ស្ថានភាព ផ្លូវ បាន ច្បាស់ មិន លំបាក បើកបរ នោះ ឡើយ បើ ទោះបី គ្មាន ភ្លើង បំភ្លឺ ផ្លូវ នៅ តាម លើ ទ្រូងផ្លូវ ឬ អម សងខាង ផ្លូវ ក៏ដោយ ចុះ ។
សូម បញ្ជាក់ ថា គម្រោង ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ មាន ប្រវែង ១៨៧. ០៥ គីឡូម៉ែត្រ បើក ការដ្ឋាន សាងសង់ កាលពី ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០១៩ ។ ផ្លូវ នេះ តភ្ជាប់ ពី ភូមិ១ សង្កាត់ សំរោង ក្រោម ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដល់ ភូមិ១ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
ផ្លូវ ជា ប្រវត្តិសាស្ត្រ នៅ កម្ពុជា មួយ ខ្សែ នេះ បាន សាងសង់ រួចរាល់ ស្ទើរ ទាំងស្រុង ហើយ ហើយ នឹង ដាក់ ឱ្យ ធ្វើដំណើរ នៅ ខែតុលា ជាមួយ ការ មិន យក ថ្លៃ រយៈពេល មួយ ខែ ។
ផ្លូវ ល្បឿន លឿន - ភ្នំពេញ ព្រះសីហនុ គឺជា គម្រោង ផ្លូវ ល្បឿន លឿន ទី១ និង ជា គម្រោង ផ្លូវ របៀង យុទ្ធសាស្ត្រ សំខាន់ បំផុត នៅ កម្ពុជា ជួយ កាត់បន្ថយ ពេលវេលា ធ្វើដំណើរ ពី រាជធានី ភ្នំពេញ ទៅ ផែ សមុទ្រ ក្រុង ព្រះសីហនុ ពី ចំនួន ប្រាំ ម៉ោង មក ត្រឹមតែ ពីរ ម៉ោង ប៉ុណ្ណោះ និង ជួយ កាត់បន្ថយ តម្លៃ ភស្តុភារកម្ម ផងដែរ ។
ជាមួយ ការធ្វើដំណើរ ពិនិត្យ ទាំង ពេល ថ្ងៃ និង ពេល យប់ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន កោតសរសើរ ថា ផ្លូវ ល្បឿន លឿន នៅ កម្ពុជា សាងសង់ ឡើង បាន យ៉ាង ល្អ និង ត្រឹមត្រូវ ទៅ តាម លក្ខណៈ បច្ចេកទេស ។ ធៀប នឹង ផ្លូវ ល្បឿន លឿន នៅ តាម បណ្តា ប្រទេស នានា ដែល លោក ធ្លាប់ បាន ធ្វើដំណើរ នោះ ផ្លូវ ល្បឿន លឿន នៅ កម្ពុជា មាន គុណភាព និង បច្ចេកទេស មិន ចាញ់ គេ នោះ ឡើយ ៕
ការប្រាប់ ទៅ អាហ្សង់ទីន ធ្វើឡើង តាមរយៈ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ក្នុង ឱកាស ជួប ពិភាក្សា ការងារ ទ្វេ ភាគី ជាមួយ លោក Santiago Cafiero រដ្ឋមន្រ្ដី ការបរទេស ពាណិជ្ជកម្ម អន្តរជាតិ និង ធម្មការ នៃ សាធារណរដ្ឋ អាហ្សង់ទីន នៅ ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០២២ នៅក្នុង ឱកាស នៃ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ លើក ទី ៧៧ នៅ ទីក្រុង ញូវយ៉ក សហរដ្ឋ អាមេរិក ។
រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ បាន បញ្ជាក់ ទៀត ថា ពិធី ប្រណាំង ទូក ថ្នាក់ ខេត្ត នេះ គឺ ដើម្បី អបអរសាទរ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ ។
ក្នុង លិខិត ដដែល នោះ បាន បន្ថែម ថា មុនពេល ពិធី ប្រណាំង ទូក ថ្នាក់ ខេត្ត នឹង រៀបចំឡើង គ្រប់ ក្រុង ស្រុក ត្រូវ ពិនិត្យ ជួសជុល កែលំអ និង តុបតែ ទូក នីមួយ ៗ និង រៀបចំ គណៈកម្មការគ្រប់គ្រង ទូក ប្រវត្តិ ទូក រួច បញ្ជូន មក សាលា ខេត្ត ( នាយក រដ្ឋបាល សាលា ខេត្ត ) ឲ្យបាន មុន ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០២២ ៕ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ជួប តំណាង អង្គការ UNESCAP ជជែក ពី ការធ្វើ ពាណិជ្ជកម្ម
ជំនួប បាន ធ្វើឡើង នៅ កោះ បាលី ប្រទេស ឥណ្ឌូនេស៊ី កំលុង ពេល ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម វិនិយោគ និង ឧស្សាហកម្ម របស់ ក្រុម ប្រទេស G20 កាលពី ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ ។
ក្នុង ជំនួប នេះ លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន សំដែង ការស្វាគមន៍ និង អរគុណ ចំពោះ លោកស្រី អគ្គ លេខាធិការ រង ដែល បាន ស្នើ ឡើង នូវ ជំនួប ពិភាក្សា ការងារ នេះ និង បាន លើកឡើង អំពី តួនាទី ដ៏ សំខាន់ របស់ អង្គការ UNESCAP នៅក្នុង សកម្មភាព ជំរុញ និង សម្រួល ពាណិជ្ជកម្ម ជាពិសេស លើ ការជំរុញ ក្របខ័ណ្ឌ ពាណិជ្ជកម្ម អេឡិចត្រូនិក ។
លោក រដ្ឋមន្ត្រី បន្ត ថា កម្ពុជា បាន ចូលរួម ក្នុង សកម្មភាព ជាច្រើន របស់ អង្គការ UNESCAP ដែល មាន ដូចជា ពាណិជ្ជកម្ម ឆ្លងកាត់ ព្រំដែន ដោយ មិន ប្រើ ក្រដាស ស្នាម ការត្រួតពិនិត្យ បទប្បញ្ញាតិ ពាណិជ្ជកម្ម ឌីជីថល និង សកម្មភាព ផ្សេង ៗ ទៀត ដែល ជួយ ជំរុញ ការអភិវឌ្ឍ របស់ កម្ពុជា ។
លោកស្រី អគ្គ លេខាធិការ រង ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក រដ្ឋមន្ត្រី ក្នុង ការផ្ដល់ ឱកាស ជួប ពិភាក្សា ចែករំលែក នូវ ទស្សនា ទាន ល្អ ៗ ចំពោះ វឌ្ឍនភាព ការអនុវត្ត របៀបវារៈ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ឆ្នាំ ២០៣០ ។ ជាពិសេស ទៅ លើ បញ្ហា ពាក់ព័ន្ធ វិស័យ ពាណិជ្ជកម្ម ដូចជា កិច្ច សម្រួល ពាណិជ្ជកម្ម និង សកម្មភាព សហប្រតិបត្តិការ ក៏ ដូចជា សមាហរណកម្ម តំបន់ ។
លោកស្រី អគ្គ លេខាធិការ រង អង្គកា សហ ប្រជាជាតិ បាន កោតសរសើរ ដល់ កម្ពុជា ចំពោះ ការចូលរួម យ៉ាង សកម្ម ក្នុង សកម្មភាព នានា ជាមួយ អង្គការ UNESCAP នា ពេល កន្លងមក ។
ភាគី ទាំង ទាំង ពីរ បាន រំលឹក ឡើងវិញ នូវ តួនាទី ដ៏ សំខាន់ របស់ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ - ១៩ និង ការរក្សា បាន នូវ លំហូរ ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ តំបន់ និង ពិភពលោក ក្នុង ការស្ដារ ឡើងវិញ នូវ សេដ្ឋកិច្ច សកល ជាពិសេស វិស័យ សេវាកម្ម និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
លោកស្រី អគ្គ លេខាធិការ រង ក៏ បាន បង្ហាញ ចំណាប់អារម្មណ៍ ក្នុង ការអញ្ជើញ កម្ពុជា ចូលួម ក្នុង គម្រោង ពាក់ព័ន្ធ ផ្សេង ៗ នា ពេល អនាគត ក្នុង ការជួយ ជំរុញ ការអភិវឌ្ឍ វិស័យ ពាណិជ្ជកម្ម កម្ពុជា ឱ្យ កាន់តែ រីកចម្រើន ឡើង បន្ថែម ទៀត ៕
ដោយ ចង្អុលបង្ហាញ ពី ការវាយប្រហារ តាម អាកាស របស់ យោធា ដែល បាន សម្លាប់ សិស្សសាលា ចំនួន ១១នាក់ ក្នុង ខែកញ្ញា នេះ ក៏ ដូចជា ការប្រហារជីវិត សកម្មជន ប្រជាធិបតេយ្យ ចំនួន ៤នាក់ កាលពី ខែកកក្កដា កន្លងទៅ ទីប្រឹក្សា ក្រសួង ការបរទេស អាមេរិក លោក ដេរ៉ិក ឆូឡេត (Derek Chollet) ដែល កំពុង ដឹកនាំ ផ្នែក ការទូត អាមេរិក លើ បញ្ហា ប្រទេស មីយ៉ាន់ម៉ា កំលុង មហាសន្និបាទ UN បាន ប្រាប់ AFP ឲ្យដឹង ថា មាន ការទទួលស្គាល់ យ៉ាង ទូលំទូលាយ ថា របប យោធា ក្នុង ប្រទេស មីយ៉ាន់ម៉ា គួរ ត្រូវតែ បាន បង្កើន សម្ពាធ ថែម ទៀត ។
លោក ឆូឡេត បាន គូសបញ្ជាក់ ថា យើង គិត ថា យើង ត្រូវតែ មាន ភាពប្រាកដ និយម លើ បញ្ហា ទាំងអស់ នេះ និង ថា តើ រុស្ស៉ី និង ចិន មាន ឆន្ទៈ ក្នុង ការអនុញ្ញាតឲ្យ ក្រុមប្រឹក្សា សន្តិសុខ ចាត់ វិធានការ យ៉ាងណា នោះ ដោយ ការលើកឡើង នេះ គឺ សំដៅ ទៅ លើ សិទ្ធិ វេតូ របស់ ប្រទេស ទាំង ពីរ ។ ជាមួយគ្នា នេះ យើង មិន គួរ ផ្តល់ ការជឿជាក់ ណាមួយ ដល់ ការបោះឆ្នោត ដែល រៀបចំ ដោយ យោធា ដែល គ្រោង នឹង ធ្វើឡើង នៅ ខែសីហា ឆ្នាំ ២០២៣ នោះ ទេ ។
លោក ឆូឡេត បាន បន្ថែម ថា យើង មើល មិន ឃើញ ថា ការបោះឆ្នោត អាច ប្រព្រឹត្តិ ទៅ ដោយ សេរី និង យុត្តិធម៌ នោះ ទេ ដោយសារតែ របប នេះ មិន បាន មើល ការខុសត្រូវ លើ ទឹកដី ច្រើន ជាង ពាក់កណ្តាល របស់ មីយ៉ាន់ម៉ា ឡើយ ខណៈ អ្នកទោស នយោបាយ ត្រូវបាន គេ ឃុំឃាំង ឬ សម្លាប់ ហើយ លោកស្រី អោង សាន ស៊ូជី កំពុង ស្ថិត នៅ ឯកោ និង គ្មាន នរណា ម្នាក់ បាន ឃើញ លោកស្រី អស់ រយៈពេល ជាង ២០ ខែ មក ហើយ ។
គួរ បញ្ជាក់ ថា កន្លងមក សហរដ្ឋ អាមេរិក បាន ដាក់ទណ្ឌកម្ម ជា បន្តបន្ទាប់ រួមទាំង ការកំណត់ គោលដៅ លើ មេដឹកនាំ របប យោធា មីយ៉ាន់ម៉ា ជាដើម ចាប់តាំងពី មាន រដ្ឋប្រហារ ។ ប៉ុន្តែ ជំហាន ខ្លះ មិន អាច សម្រេចបាន ដោយសារតែ ការជំទាស់ របស់ ក្រុម សកម្មជន ដោយ ផ្តោត លើ បញ្ហា ឧស្សាហកម្ម ប្រេង និង ឧស្ម័ន របស់ មីយ៉ាន់ម៉ា ចំពេល មាន ការប្រឆាំង ពី ប្រទេស ថៃ ដែល នាំចូល ថាមពល ពី ប្រទេស ជិតខាង របស់ ខ្លួន មួយ នេះ ៕
រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន បញ្ជាក់ ថា បន្ទាប់ពី ទទួលបាន ព័ត៌មាន កម្លាំង នាយកដ្ឋាន នគរបាល ការពារ ព្រំដែន ទឹក នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ដឹកនាំ កម្លាំង អង្គភាព បង្រ្កាប ចំនួន ១៦នាក់ និង មធ្យោបាយ ចំនួន ២គ្រឿង ( ១. ៦០០ សេស១ គ្រឿង និង ៧០០ សេស ១គ្រឿង ) ចេញ ទៅ ជួយ សង្រ្គោះ និង សង្រ្គោះ មនុស្ស បាន ចំនួន ១៨ នាក់ ខណៈ ២៣ នាក់ ទៀត រក មិន ទាន់ ឃើញ នៅឡើយ ទេ ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ក៏ បាន ប្រកាស ពី ការឧបត្ថម្ភ ថវិកា លើកទឹកចិត្ត ដល់ ក្រុម អ្នក ជួយសង្គ្រោះ និង ប្រជាទូក នេសាទ ជាដើម ក្នុង ករណី សង្គ្រោះ បាន ជនរងគ្រោះ ម្នាក់ នឹង ទទួលបាន ថវិកា លើកទឹកចិត្ត ចំនួន ២លាន រៀល ។
សូម ជម្រាប ថា ហេតុការណ៍ លិច ទូក ដែល ផ្ទុក មនុស្ស ចំនួន ៤១ នាក់ នេះ បាន កើត មាន ឡើង នៅ វេលា ម៉ោង ប្រមាណ ១០ព្រឹក ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ ម្សិលមិញ ក្រោយ ទទួលបាន ព័ត៌មាន នេះ កម្លាំង សមត្ថកិច្ច ជំនាញ លើ ផ្ទៃ ទឹក បាន រួម ដៃ គ្នា ចេញ ជួយ អន្ដរាគមន៍ សង្គ្រោះ មនុស្ស បាន ចំនួន ១៨ នាក់ ។
ជាមួយគ្នា នេះ កម្លាំង អង្គភាព បាន ធ្វើ ការឃាត់ ទូក ចំនួន ១ គ្រឿង ផ្សេង ទៀត មាន មនុស្ស ចំនួន ០២ នាក់ ជា ជនជាតិ ខ្មែរ ដោយ បាន ប្រគល់ ជូន អធិការដ្ឋាន នគរបាល ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ សួរនាំ តាម នីតិវិធី ដោយឡែក ទូក រក្សាទុក នៅ អង្គភាព ។ ប្រតិបត្តិការ នៃ ការស្វែងរក ជនរងគ្រោះ បាត់ខ្លួន ទាំង ២៣ នាក់ បាន និង កំពុង ធ្វើឡើង នៅ ផ្ទៃ សមុទ្រ ដែល ជា ទីតាំង លិច ទូក និង ភូមិសាស្ត្រ ជុំវិញ ទីតាំង កើត ហេតុ ៕
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៧. ៨២៧ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៤. ៦៩១ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ រដ្ឋមន្ដ្រី លឹម គាន ហោ ដឹកនាំ ក្រុមការងារ បច្ចេកទេស ចុះ ពិនិត្យ ស្ថានភាព ជំនន់ ទឹកភ្លៀង នៅ ខេត្ដ ភាគ ពាយព្យ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម អម ដំណើរ ដោយ ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត បាត់ដំបង បន្ទាយមាន ជ័យ ឧត្តរមានជ័យ និង ខេត្ត សៀមរាប ព្រមទាំង ក្រុមការងារ មន្រ្តី បច្ចេកទេស បាន ចុះ ពិនិត្យ ស្ថានភាព ជំនន់ ទឹកភ្លៀង នៅ បណ្តា ខេត្ត ភាគ ខេត្ត ពាយព្យ ប្រទេស ។
ទីតាំង ដែល លោក រដ្ឋមន្ដ្រី ដឹកនាំ ក្រុមការងារ បច្ចេកទេស នោះ រួម មាន៖ ទីតាំង ទី១ នៅ ទំនប់ ប្រឡាយ កុមារ ដែល ជា តំបន់ ប្រសព្វ គ្នា រវាង ខេត្ត បន្ទាយមាន ជ័យ ឧត្តរមានជ័យ និង សៀមរាប និង បន្ត ចុះ ពិនិត្យ នៅ ទីតាំង ទី២ ស្ថិត នៅ ភូមិ គោក រំចេក ឃុំ ស្រះ ជីក ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ។
លោក រដ្ឋមន្ដ្រី បាន អះអាង ថា ការចុះ ពិនិត្យ នេះ ធ្វើឡើង ក្នុង គោលបំណង ពីរ សំខា ន់៖
* ទី២៖ ត្រួតពិនិត្យ និង មាន វិធានការ ជា យុទ្ធសាស្រ្ត ដែល អាច អនុវត្ត ក្នុង រយៈពេល ខ្លី មធ្យម និង រយៈពេល វែង ដើម្បី បញ្ជៀស នូវ ការលិចលង់ នានា ដែល តែងតែ កើត មាន ឡើង ជា យថាហេតុ ។
ជាក់ស្តែង ចាប់តាំងពី ដើម រដូវ វស្សា ឆ្នាំ នេះ ក្រសួង បាន ត្រៀម នូវ គ្រប់ មធ្យោបាយ មាន ទាំង សម្ភារ គ្រឿងចក្រ និង កម្លាំង មន្រ្តី ប្រចាំ ការ នៅ គ្រប់ មុខ ព្រួញ រាជធានី - ខេត្ត ដើម្បី ត្រៀម អន្តរាគមន៍ ឲ្យបាន ទាន់ ពេល វេលា ។
កំលុង ពេល ចាប់ផ្តើម កិច្ចពិភាក្សា លោក បៃ ដិន បាន លើកឡើង ពី បញ្ហា សមុទ្រ ចិន ខាងត្បូង . ជំងឺ កូវីដ - ១៩ និង ថាមពល កកើត ឡើងវិញ ខណៈ លោក បាន អរគុណ ដល់ លោក ម៉ាកូស ដែល បាន បង្ហាញ ជំហរ ប្រឆាំង នឹង សង្គ្រាម របស់ រុស្ស៊ី នៅ អ៊ុយក្រែន ។ ចំណែក លោក ម៉ាកូស បាន សង្កត់ធ្ងន់ ថា តួនាទី របស់ សហរដ្ឋ អាមេរិក ក្នុង ការរក្សា សន្តិភាព ក្នុង តំបន់ គឺជា អ្វី ដែល គួរឲ្យ កោតសរសើរ យ៉ាង ខ្លាំង ពីសំណាក់ ប្រទេស ទាំងអស់ នៅក្នុង តំបន់ ជាពិសេស គឺ ហ្វីលីពីន តែម្តង ។
គួរ បញ្ជាក់ ថា ហ្វីលីពីន គឺជា សម្ព័ន្ធមិត្ត ដ៏ សំខាន់ របស់ សហរដ្ឋ អាមេរិក និង ត្រូវបាន គេ មើលឃើញ ថា ជា ដៃគូរ យុទ្ធសាស្ត្រ មួយ ក្នុង ករណី ដែល សហរដ្ឋ អាមេរិក ត្រូវការ ដើម្បី ការពារ តៃវ៉ាន់ តាមរយៈ ការផ្តល់ ទីតាំង ភូមិសាស្ត្រ ប្រសិនបើ ចិន ប្រើ កម្លាំង យោធា លើ កោះ នេះ ៕
គ.ជ. ប នឹង រៀបចំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ជាមួយ ភាគី ពាក់ព័ន្ធ ពី ការផ្សព្វផ្សាយ បញ្ជី បោះឆ្នោត ចុងក្រោយ នៅ ចុង ខែកញ្ញា
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នឹង រៀបចំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ជាមួយ ភាគី ពាក់ព័ន្ធ ក្រោម ប្រធានបទ ស្តីពី ការផ្សព្វផ្សាយ បញ្ជី បោះឆ្នោត ចុងក្រោយ . លទ្ធផល បណ្តោះអាសន្ន នៃ ការចែក លិខិត អញ្ជើញ អ្នក មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ផ្លូវការ ឆ្នាំ ២០២១ . ការផ្សព្វផ្សាយ ស្ថិតិ ប្រជាពលរដ្ឋ និង ចំនួន ការិយាល័យ បោះឆ្នោត ប៉ាន់ស្មាន ។
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប សម្រេច បិទ ចរាចរណ៍ រថយន្ត ដឹក ទំនិញ ធុន ធ្ងន់ គ្រប់ ប្រភេទ លើ កំណាត់ ផ្លូវ ក្នុង ភូមិសាស្ត្រ ខេត្ត សៀមរាប ជា បណ្តោះអាសន្ន ដើម្បី ទប់ស្កាត់ ការខូចខាត ផ្លូវ ដែល កំពុង រង់ ការជន់ លិច ដោយ ជំនន់ ទឹកភ្លៀង ។
ការបិទ ជា បណ្តោះអាសន្ន នេះ ធ្វើ ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ រហូតដល់ មាន សេចក្តីជូនដំណឹង សា ជា ថ្មី ។ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត សៀមរាប សង្ឃឹម និង ជឿជាក់ យ៉ាង មុតមាំ ចំពោះ ស្មារតី និង ឆន្ទៈ មនសិកា របស់ ម្ចាស់ រថយន្ត ដឹក ទំនិញ ធុន ធ្ងន់ ទាំងអស់ នឹង ចូលរួម សហការ អនុវត្ត ដើម្បី រួមចំណែក ថែរក្សា ផ្លូវ - ស្ពាន ឱ្យ ប្រើប្រាស់ បាន យូរអង្វែង ៕ កម្លាំង គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ បន្ដ ប្រតិបត្តិការ ចុះ ពិនិត្យ ទីតាំង ហាង បញ្ចាំសង្ស័យ ខុស ច្បាប់ នៅ ទីតាំង ឃ្លាំង រំសេវ ខណ្ឌ ទួលគោក
( ភ្នំពេញ ) ៖ លោក ឃ្លាំង ហួត អភិបាល រង រាជធានី ភ្នំពេញ និង លោក ជា ពិសី អភិបាល ខណ្ឌ ទួលគោក នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ បាន បន្ដ ប្រតិបត្តិការ ចុះ ពិនិត្យ ទីតាំង ហាង បញ្ចាំសង្ស័យ ខុស ច្បាប់ ក្នុង មូលដ្ឋាន ខណ្ឌ ទួលគោក ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង ក្រោម ការផ្ទាល់ ពី លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ ដោយ អនុវត្ត តាម អនុសាសន៍ ដ៏ ម៉ឺងម៉ាត់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ពាក់ព័ន្ធ ការបង្ក្រាប បទល្មើស ល្បែង ស៉ី សង ខុស ច្បាប់ ។
បំណង នេះ ត្រូវបាន ស្តែង ឡើង នៅក្នុង ជំនួប ពិភាក្សា ការងារ រវាង សម្តេច តេជោ និង លោកស្រី សែក ហាស៊ីណា នៅ ទីក្រុង ញូវយ៉ក សហរដ្ឋ អាមេរិក នា រសៀល ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ ម៉ោង នៅ សហរដ្ឋ អាមេរិក ត្រូវ នឹង ទៀប ភ្លឺ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ ម៉ោង នៅ កម្ពុជា ។
បើ តាម លោក បណ្ឌិត កៅ គឹម ហួន រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា នៅក្នុង ជំនួប នាយក រដ្ឋមន្ត្រី កម្ពុជា និង បង់ ក្លាដេស បាន ពិភាក្សា ការងារ មួយចំនួន ពាក់ព័ន្ធ ការពង្រឹង ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ និង ការធ្វើ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ ។ ក្នុង នោះ ក៏ មាន ការជជែក ដល់ ការនាំ អង្ករ ពី កម្ពុជា ទៅកាន់ ប្រទេស បង់ក្លាដេស ផងដែរ ។
សម្ដេច តេជោ ហ៊ុន សែន នា ពេល កន្លងទៅ បង់ក្លាដេស បាន ចរចា ទិញ អង្ករ ប្រមាណ ជា ២០ម៉ឺន តោន ពី ប្រទេស កម្ពុជា ។ ប៉ុន្តែ សម្ដេច ចង់ឱ្យ មាន ការនាំ អង្ករ ពី ប្រទេស កម្ពុជា ទៅកាន់ បង់ក្លាដេស ឱ្យ មាន ស្ថេរភាព ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន អញ្ជើញ ក្រុមហ៊ុន របស់ បង់ក្លាដេស មកកាន់ កម្ពុជា ដើម្បី វិនិយោគ ធ្វើ ឃ្លាំង កែច្នៃ អង្ករ ជា រោង ម៉ាស៊ីន កិន ស្រូវ ហើយ នាំចេញ ទៅកាន់ ប្រទេស បង់ក្លាដេស ។
លោកស្រី នាយក រដ្ឋមន្ត្រី បង់ក្លាដេស បាន ជម្រាប សម្តេច តេជោ ថា លោកស្រី បាន ស្នើ ឱ្យ វិស័យ ឯកជន ទៅ វិនិយោគ នៅ ប្រទេស កម្ពុជា លើ វិស័យ កសិកម្ម ។ ជាពិសេស ការនាំ អង្ករ ចេញ ពី កម្ពុជា ។
លោកស្រី បាន ជម្រាប សម្តេច តេជោ ទៀត ថា បង់ក្លាដេស មាន ដី តូច ប្រជាពលរដ្ឋ ច្រើន មិន អំណោយផល ក្នុង ការធ្វើ កសិកម្ម ដោយសារ ងាយ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ដូច្នេះ ត្រូវការ ទិញ អង្ករ ពី ខាងក្រៅ ។ តាមរយៈ នេះ លោកស្រី បាន លើក ជា គំនិត ចង់ឱ្យ មាន កិច្ចព្រមព្រៀង ណាមួយ ជាមួយគ្នា ដើម្បី ពង្រីក និង ពង្រឹង ការ ធ្វើ ធុរកិច្ច រវាង កម្ពុជា និង បង់ ក្លាដេស ឱ្យ កាន់តែ ច្រើន ។
លោកស្រី ក៏ បាន បង្ហាញ បំណង ចង់ ជំរុញឱ្យ មាន កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ ដើម្បី បង្កើន ការនាំចេញ និង ដើម្បី បង្កើន ឱកាស វិនិយោគ បន្ថែម ទៀត ។
សម្ដេច តេជោ ហ៊ុន សែន បាន ឯកភាព ចំពោះ បំណង របស់ លោកស្រី នាយក រដ្ឋមន្ត្រី បង់ក្លាដេស ។ សម្តេច តេជោ បាន លើកឡើង ថា កិច្ចព្រមព្រៀង ជា ការងារ ដែល ប្រទេស ទាំង ពីរ អាច ចាប់ផ្ដើម ការចរចា ឱ្យ មាន កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ជាមួយគ្នា ដើម្បី ជំរុញ កំណើន ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ ខណៈ កម្ពុជា ក៏ មាន កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ជាមួយ ចិន និង កូរ៉េ ខាងត្បូង ផងដែរ ។
សម្តេច តេជោ បាន បង្ហាញ ជំនឿចិត្ត ថា តាមរយៈ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី នេះ កម្ពុជា និង បង់ ក្លាដេស អាច បង្កើន ទំហំ ពាណិជ្ជកម្ម ដែល ជា ឱកាស សម្រាប់ បង់ក្លាដេស ពង្រីក និង ពង្រឹង ទំនាក់ទំនង ជាមួយ អាស៊ាន ផងដែរ ។
នៅក្នុង ជំនួប ខាង លើ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ លោកស្រី នាយក រដ្ឋមន្ត្រី បង់ក្លាដេស ដែល បាន បញ្ជូន រដ្ឋមន្ត្រី ការបរទេស បង់ក្លាដេស ចូលរួម កិច្ចប្រជុំ វេទិកា តំបន់ អាស៊ាន នៅ រាជធានី ភ្នំពេញ កាលពី ដើម ខែសីហា កន្លង ។ ក្នុង នាម ប្រធាន អាស៊ាន សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន អរគុណ បង់ក្លាដេស ដែល បាន ផ្ដល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដល់ ប្រទេស មីយ៉ាន់ម៉ា ចំនួន ១លាន ដូស កន្លងទៅ ។
សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ លោកស្រី នាយក រដ្ឋមន្ត្រី ដែល បាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ផ្លូវ មួយ ខ្សែ ដោយ ដាក់ ព្រះនាម ព្រះករុណា សម្ដេច ឪ នរោត្តម សីហនុ នៅ ប្រទេស បង់ក្លាដេស ហើយ ព្រះកម្ពុជា ដាក់ ឈ្មោះ ផ្លូវការផ្ដល់ កិត្តិយស ដល់ ឪពុក របស់ លោកស្រី ដែល ចាត់ទុក ជា បិតា ស្ថាបនិក របស់ ប្រទេស បង់ក្លាដែស ជា ប្រធានាធិបតី ទី១ និង ក្រោយមក ក្លាយជា នាយក រដ្ឋមន្ត្រី ។
សម្ដេច តេជោ ហ៊ុន សែ ន ក៏ បាន អបអរសាទរបង់ក្លាដេស ដែល បាន សាងសង់ ស្ពាន មួយ យ៉ាង វែង ក្រោម ការដឹកនាំ របស់ លោកស្រី ផ្ទាល់ ។ ស្ពាន នោះ មាន ឈ្មោះ ថា « ស្ពាន ផាត់ ម៉ា» មាន ប្រវែង ជាង ៦គីឡូម៉ែត្រ អាច ប្រើ បាន ទាំង រថយន្ត និង រថភ្លើង ហើយ ប្រើ ថវិកា របស់ ប្រទេស បង់ក្លាដេស សុទ្ធសាធ ៕ លោក ហ៊ុន ម៉ានី៖ សាល ដីកា ដាក់ទោស លោក ខៀវ សំផន ជា សច្ច ភាព ឆ្លុះបញ្ចាំង ពីរ បប សាហាវ យង់ឃ្នង ដែល កម្ពុជា បាន ជួបប្រទះ ក្នុង អតីតកាល
( ភ្នំពេញ ) ៖ អង្គ ជំនុំជម្រះ វិសាមញ្ញ ក្នុង តុលាការ កម្ពុជា ( សាលា ក្តី ខ្មែរ ក្រហម ) នៅ ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ បាន ប្រកាស សាល ដីកា លើ បណ្តឹង សាទុក្ខ សំណុំរឿង ០០២ / ០២ ពាក់ព័ន្ធ នឹង ជនជាប់ចោទ ខៀវ សំផន អតីត ប្រធាន គណៈ ប្រធាន រដ្ឋ នៃ របប ខ្មែរ ក្រហម ។ នៅក្នុង សាល ដីកា នេះ សាលា ក្តី ខ្មែរ ក្រហម បាន សម្រេច តម្កល់ សេចក្តីសម្រេច របស់ ខ្លួន ដោយ កាត់ទោស លោក ខៀវ សំផន ឲ្យ ជាប់ ពន្ធនាគារ អស់ មួយ ជីវិត ហើយ បិទ ផ្លូវ តវ៉ា តែម្តង ។
បន្ថែម ពី នេះ លោក ហ៊ុន ម៉ានី បាន យល់ឃើញ ទៀត ថា ថ្ងៃ នេះ ក៏ ជា ការឧទ្ទិស ដល់ វិញ្ញាណក្ខ័ន្ធ ជនរងគ្រោះ ទាំងអស់ ដែល បាន បាត់បង់ជីវិត ក៏ ដូចជា ការផ្សះផ្សា នូវ របួស ផ្លូវចិត្ត សម្រាប់ អ្នក ដែល បាន រស់រាន មាន ជីវិត ដែល បាន រស់ នៅក្នុង ភាពឈឺចាប់ ឲ្យបាន ស្ងប់ចិត្ត តាមរយៈ ការទទួលទោស របស់ ជនជាប់ចោទ សាកសម ទៅនឹង អំពើ ដែល ខ្លួន បាន ប្រព្រឹត្ត និង បញ្ជា ក្នុង របប ខ្មែរ ក្រហម ។
លោក ហ៊ុន ម៉ានី បាន រៀបរាប់ យ៉ាង ដូច្នេះ ថា៖ « ថ្ងៃ ប្រវត្តិសាស្ត្រ នៃ ការបិទ បញ្ចប់ ការកាត់សេចក្តីឧក្រិដ្ឋកម្ម ដែល បាន ប្រព្រឹត្ត ឡើង ក្នុង អំឡុង ពេល នៃ របប ខ្មែរ ក្រហម ។
សាល ដីកា ស្ថាពរ ប្រកាស ដោយ អង្គ ជំនុំ ជំរះ តុលាការ កំពូល នា ព្រឹក ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ បាន ផ្តន្ទាទោស អតីត ប្រមុខរដ្ឋ ក្នុង របប ប្រជាធិបតេយ្យ កម្ពុជា ខៀវ សំផន ក្នុង កម្រិត ទោស អតិបរិមាតាម ច្បាប់ នៃ ព្រះរាជាណាចក្រ កម្ពុជា គឺ ការដាក់ ពន្ធនាគារ អស់ មួយ ជីវិត ក្នុង សំណុំរឿង ០០២ / ០២ ដោយ ត្រូវ អនុវត្ត ត្រួត គ្នា ជាមួយនឹង ទោស ដាក់ ពន្ធនាគារ រស់ មួយ ជីវិត នៅក្នុង សំណុំរឿង ០០២ / ០១ ។
សាល ដីកា នេះ ក៏ ជា សច្ចភាព មួយ ដែល បាន ឆ្លុះបញ្ចាំង ពីរ បប សាហាវ យង់ឃ្នង ដែល កម្ពុជា បាន ជួបប្រទះ ក្នុង អតីតកាល ដ៏ ខ្មៅ ងងឹត ។ ឆ្លងកាត់ ដំណើរការ នីតិវិធី ដែល បាន ចំណាយ ពេល ជាង ១៦ ឆ្នាំ យុត្តិធម៌ ត្រូវបាន ផ្តល់ ជូន ជា ផ្លូវការ គឺ ការទទួលស្គាល់ នូវ អត្ថិភាព នៃ បទល្មើស និង បញ្ចប់ នូវ ស្ថានភាព និទណ្ឌភាព របស់ មេដឹកនាំ និង អ្នកទទួលខុសត្រូវ ជាន់ ខ្ពស់ បំផុត នៃ របប ឧក្រិដ្ឋ មួយ នេះ ។
មិន តែ ប៉ុណ្ណោះ ថ្ងៃ នេះ ក៏ ជា ការឧទ្ទិស ដល់ វិញ្ញាណក្ខ័ន្ធ ជនរងគ្រោះ ទាំងអស់ ដែល បាន បាត់បង់ជីវិត ក៏ ដូចជា ការផ្សះផ្សា នូវ របួស ផ្លូវចិត្ត សម្រាប់ អ្នក ដែល បាន រស់រាន មាន ជីវិត ដែល បាន រស់ នៅក្នុង ភាពឈឺចាប់ ឲ្យបាន ស្ងប់ចិត្ត តាមរយៈ ការទទួលទោស របស់ ជនជាប់ចោទ សាកសម ទៅនឹង អំពើ ដែល ខ្លួន បាន ប្រព្រឹត្ត និង បញ្ជា ។
យុវជន កម្ពុជា ជំនាន់ ក្រោយ ត្រូវ ចងចាំ និង រៀនសូត្រ ពី ប្រវត្តិសាស្រ្ត មួយ នេះ ដោយ មិន ត្រូវ អនុញ្ញាតឲ្យ ស្នាម ប្រេះស្រាំ ក្នុង អតីតកាល នេះ អាច កើត ឡើងវិញ សារជាថ្មី ហើយ ត្រូវ រួមគ្នា ថែរក្សា សុខ សន្តិភាព មួយ នេះ ដែល ជា មូលដ្ឋាន ក្នុង ការកសាង និអភិវឌ្ឍន៍ ជាតិ »៕
រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម៖ គួរតែ មាន អ្នកកាត់ក្ដី មិន លំអៀង និង មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ ដើម្បី ដោះស្រាយ វិវាទ ផ្នែក ពាណិជ្ជកម្ម
( ទីក្រុង បាលី . ឥណ្ឌូនេស៊ី ) ៖ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន លើកឡើង ថា គួរតែ មាន អ្នកកាត់ក្ដី ដែល មិន លំអៀង និង មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ ដើម្បី ដោះស្រាយ វិវាទ ផ្នែក ពាណិជ្ជកម្ម ឱ្យ មាន ភាពត្រឹមត្រូវ ។
លោក រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ បែប នេះ ក្នុង កិច្ចពិគ្រោះយោបល់ ក្រៅ ផ្លូវ ការ ថ្នាក់ រដ្ឋមន្ត្រី ស្ដីពី កំណែទម្រង់ ប្រព័ន្ធ ដោះស្រាយ វិវាទ របស់ អង្គការ ពាណិជ្ជកម្ម ពិភពលោក កាលពី ថ្ងៃទី ២១ ខែកញ្ញា ឆ្នាំ ២០២២ នៅ កោះ បាលី ប្រទេស ឥណ្ឌូនេស៊ី ។
លោក ប៉ាន សូរស័ក្តិ បាន បន្ត ថា ជំនួយ បច្ចេកទេស និង ដំបូន្មាន ផ្នែក ច្បាប់ ត្រូវតែ ផ្ដល់ជូន ដល់ ក្រុម ប្រទេស អភិវឌ្ឍ តិចតួច ដើម្បី ជា ជំនួយ ដល់ ដំណើរការក្ដី ផ្សេង ៗ ដែល ពាក់ព័ន្ធ នឹង ក្រុម ប្រទេស នេះ ។ បន្ថែម ពី នេះ គួរតែ មាន អ្នកកាត់ក្ដី ដែល មិន លំអៀង និង មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ ដែល មក ពី គ្រប់ តំបន់ និង យេនឌ័រ ហើយ ត្រូវ ជំរុញ ឱ្យ មាន ចៅក្រម ដែល មាន សមត្ថភាព មកពី ប្រទេស សមាជិក អភិវឌ្ឍ តិចតួច ផងដែរ ។
លោក រដ្ឋមន្ត្រី បាន ជម្រាប ថា កម្ពុជា បាន ត្រៀម ខ្លួន រួច ជាស្រេច ក្នុង ការចូលរួម យ៉ាង សកម្ម ជាមួយ គ្រប់ បណ្ដា ភាគី ពាក់ព័ន្ធ នៅក្នុង កំណែទម្រង់ ប្រព័ន្ធ ដោះស្រាយ វិវាទ របស់ អង្គការ ពាណិជ្ជកម្ម ពិភពលោក សំដៅ ធ្វើ យ៉ាងណា ធ្វើឱ្យ ប្រព័ន្ធ នេះ មាន ដំណើរការ កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត នា ពេល អនាគត ៕ បទ អត្ថាធិប្បាយ៖ ពិធី បុណ្យ កាន់ បិណ្ឌ ភ្ជុំ បិណ្ឌ បាន ផ្សារភ្ជាប់ ទៅនឹង ការអប់រំ នៅក្នុង សង្គម ខ្មែរ
( ភ្នំពេញ ) ៖ ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ តែងតែ ប្រារព្ធ ឡើង នៅ ថ្ងៃ១ រោច ដល់ ថ្ងៃ ១៥ រោច ខែ ភទ្របទ ជារៀងរាល់ ឆ្នាំ ហើយក៏ ជា ពិធី បុណ្យ មួយ ដែល ធំ ជាង គេ នៅក្នុង ចំណោម ពិធី បុណ្យ ទាំងអស់ ចំពោះ អ្នកកាន់ ព្រះពុទ្ធ សាសនា នៅ កម្ពុជា ។
ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ ឆ្នាំ នេះ បាន ចាប់ផ្ដើម នៅ ថ្ងៃ ១រោច ដល់ ថ្ងៃ ១៥ រោច ខែ ភទ្របទ ត្រូវ និង ថ្ងៃទី ១១ ដល់ ថ្ងៃទី ២៥ ខែកញ្ញា ។ រយៈពេល ជាច្រើន ថ្ងៃ នៃ ពិធី កាន់ បិណ្ឌ យើង សង្កេតឃើញ ថា នៅ តាម វត្ត អារាម នានា ទាំង នៅ ទីក្រុង រហូតដល់ ជនបទ មាន សភាព អ៊ូរ អរ ជាង ថ្ងៃ ធម្មតា ដោយ ពុទ្ធ បរិស័ទ យើង ទាំង ក្មេង ចាស់ ប្រុស ស្រី បាន នាំគ្នា យក ចង្ហាន់ ទៅ ប្រគេន ព្រះសង្ឃ ក្នុង ន័យ ឧទ្ទិស មគ្គផល ដល់ ញាតិ គ្រប់ សណ្ដាន ដែល បាន ចែក ឋាន ទៅកាន់ លោក ខាងមុខ ។
ព្រះសុមេធវង្ស បណ្ឌិត សុខ ប៊ុន ធឿន ព្រះចៅ អធិការ វត្ត នន្ទ មុនី ធ្លាប់ មាន ពុទ្ធ ដីកា ថា៖ ការប្រារព្ធ ពិធី ភ្ជុំ បិណ្ឌ មាន សារៈសំខាន់ ណាស់ ព្រោះ បាន បង្ហាញ ពី ការដឹងគុណ ដល់ អ្នកមាន គុណ និង បុព្វបុរស ខ្មែរ ដែល បាន ចែក ឋាន ទៅកាន់ លោក ខាងមុខ ។ ហើយ មួយ ផ្នែក ទៀត ជា ការបញ្ចូល ការអប់រំ ទូន្មាន ប្រៀន ប្រដៅ ដល់ ជន ប្រុស ស្រី គ្រប់ វ័យ បាន ត្រង់ ត្រាប់ ស្ដាប់ នូវ អំពើ អ្វី ដែល ប្រាសចាក អកុសលកម្ម ទាំងឡាយ ដែល បាន ប្រព្រឹត្ត ក្នុង ការរស់នៅ ប្រចាំ ថ្ងៃ ។
សំឡេង៖ « បើ និយាយ ពី ពុទ្ធសាសនា គេ នឹក ដល់ ការអប់រំ តែម្ដង ។ ចឹង ពុទ្ធសាសនា ជា សាសនា មួយ មាន តួនាទី សំខាន់ ណាស់ ក្នុង ការអប់រំ កាយ វា ចា ចិត្ត របស់ មនុស្ស យើង ឱ្យ សាង ប្រព្រឹត្ត នូវ អ្វី ដែល ល្អ សម្រាប់ ខ្លួន ឯង ក៏ដូចជា សម្រាប់ សង្គម ។ ចឹង ពិធី ភ្ជុំ បិណ្ឌ ធ្វើឡើង ដើម្បី ការអប់រំ ឬ ផ្សាយ ការអប់រំ ដល់ ស្រទាប់ មហាជន ទាំង ក្មេង ទាំង ចាស់ ប្រុស ស្រី ទាំងអស់ » ។
ព្រះតេជគុណ មាន ពុទ្ធ ដីកា បន្ត ទៀត ថា៖ ការបញ្ជ្រាប ការអប់រំ ដែល សំខាន់ បំផុត ក្នុង ពិធី កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ គឺ ការយល់ដឹង ពី ហេតុ នាំឱ្យ វិនាស ទាំង ១២ប្រការ ដែល ពេល ព្រលឹម ឡើង ព្រះសង្ឃ គ្រប់ វត្ត អារាម ទាំងអស់ បាន សូត្រ ជាប្រចាំ ក្នុង រយៈពេល ១៥ ថ្ងៃ នៃ ពិធី បុណ្យ ។
លោក សាស្ត្រាចារ្យ ប្រាក់ សម្ផស្ស ជា សាស្ត្រាចារ្យ ពុទ្ធិក សកលវិទ្យាល័យ ព្រះសីហនុ រាជ្យ បាន មានប្រសាសន៍ ថា៖ ក្នុង នាម ជា ពុទ្ធ បរិស័ទ ដែល បាន គោរព ប្រពៃណី ទំនៀមទម្លាប់ តាំងពី បុរាណ កាល រហូតមកដល់ បច្ចុប្បន្ន ដល់ ពេល បុណ្យ ភ្ជុំ បិណ្ឌ ពុទ្ធ សាសនិក ជន ត្រូវ ធ្វើ រឿង២ ដែល ជា រឿង សំខា ន់៖
ដែល ជាទូទៅ គឺ ជួយ ទំនុកបម្រុង លោក អ្នក មាន គុណ និង ការជូន គ្រឿង ឧបភោគ បរិភោគ ឬ លុយកាក់ ឲ្យ ព្រះរស់ បាន ទៅ វត្ត រក្សា ទាន សីល នៅ តាម ទី វត្តអារាម ។ ទី៤ ជា ការសន្សំ កុសល ផល បុណ រៀង ៗ ខ្លួន សម្រាប់ បច្ចុប្បន្ន កាល និង អនាគតកាល ។ ទី៥ បង្កើន សាមគ្គីភាព ព្រោះ ពិធី កាន់ បិណ្ឌ ត្រូវបាន កំណត់ ពេល ចាប់ផ្ដើម និង បញ្ចប់ ដូច ៗ គ្នា ក្នុង ទូទាំង ប្រទេស ដោយ បង្ហាញ ពី ការ ស្រុះស្រួល គ្នា ។ ទី៦ជា ការរក្សា ប្រណៃ ទំនៀមទម្លាប់ ខ្មែរ ដូចជា ការស្លៀក សម្លៀកបំពាក់ ប្រពៃណី របស់ នារី ខ្មែរ យើង ៕
( អត្ថបទ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ) អ្នកនាំពាក្យ ក្រសួង មហា ផ្ទៃ៖ ម្សិលមិញ សមត្ថកិច្ច កម្ពុជា ទទួលបាន បណ្តឹង ១៣ទៀត ដែល ស្នើ ឱ្យ សង្គ្រោះ ជន បរទេស
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន ឱ្យដឹង ថា សំណើ ទាំង ១៣ករណី នេះ រួម មាន៖ ស្នើ ឱ្យ សង្រ្គោះ ជនជាតិ ចិន ចំនួន ៦នាក់ . ជនជាតិ ឥណ្ឌា ១នាក់ . ជនជាតិ វៀតណាម ៤នាក់ . ជនជាតិ ស្រីលង្កា ១នាក់ . ជនជាតិ បង់ក្លាដេស ៧នាក់ ជាន ជាតិ ខ្មែរ ១នាក់ ជនជាតិ ម៉ាឡេស៉ី ៦នាក់ និង ជនជាតិ ហ្វីលីពីន ១នាក់ ។
បើ តាម អ្នកនាំពាក្យ បច្ចុប្បន្នភាព ស្រាវជ្រាវ តាម បញ្ជី តាមដាន គិត ត្រឹម ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២១ រួម មាន៖
១៖ សំណើ ក្នុង បញ្ជី តាមដាន របស់ សម្តេច ក្រឡាហោម សរុប ៣០៣ ករណី មាន មនុស្ស ៦៦៦ នាក់ មាន ១១សញ្ជាតិ ២៖ ស្រាវជ្រាវ អង្កេត បឋម បាន ១៣៧ សំណើ នៅសល់ ១៦៦ សំណើ ( រកឃើញ ២៧១ នាក់ . ឃាត់ខ្លួន ៤៩ នាក់ . បិទ ក្រុមហ៊ុន ១ទីតាំង . និង ផ្អាក អាជីវកម្ម ក៏ ដូចជា ស្រាវជ្រាវ ក្រុមហ៊ុន ៥ទីតាំង ) ។
លោក ឃ្លាំង ហួត អភិបាល រង រាជធានី ភ្នំពេញ ដែល ដឹកនាំ ប្រតិបត្តិការ ផ្ទាល់ ក្នុង មូលដ្ឋាន ខណ្ឌ ទួលគោក ដើម្បី ត្រួតពិនិត្យ ទីតាំង បញ្ចាំ ដែល សង្ស័យ ទទួលបញ្ចាំ ខុស ច្បាប់ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ បាន ប្រគល់ ម៉ូតូ ជូន ម្ចាស់ ដើម វិញ ចំនួន ៨នាក់ ក្រោយ ពិនិត្យ ឯកសារ ឃើញ ត្រឹមត្រូវ ថា ពួក គាត់ ជា ម្ចាស់ កម្មសិទ្ធិ ពិតប្រាកដ ។
បើ តាម ការសាកសួរ ទៅកាន់ ជនរងគ្រោះ ដែល មក ទទួល ម៉ូតូ វិញ នោះ បាន ឲ្យដឹង ថា អ្នក ខ្លះ បាត់ ម៉ូតូ រហូតដល់ ៥ឆ្នាំ ឯណោះ ស្រាប់តែ ប្រទះឃើញ នៅ ទីតាំង បញ្ចាំ ខុស ច្បាប់ ដែល សមត្ថកិច្ច បាន ដកហូត ។ ពួកគាត់ បាន បង្ហាញ នូវ ក្ដី ត្រេកអរ យ៉ាង ខ្លាំង បន្ទាប់ពី អស់សង្ឃឹម ជា យូរ ណាស់ មកហើយ ក្នុង ការតាម រក ម៉ូតូ របស់ ខ្លួន ដែល ត្រូវបាន ចោរ លួច ឬ ប្លន់ កាលពី ពេល កន្លងទៅ ។
ឆ្លងកាត់ ករណី នេះ អាជ្ញាធរ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល ធ្លាប់ បាត់ ម៉ូតូ កុំ ទាន់ អស់សង្ឃឹម ហើយ ត្រូវ បន្ដ ផ្ទៀងផ្ទាត់ ភិនភាគ ម៉ូតូ របស់ ខ្លួន នៅពេល អាជ្ញាធរ ផ្សព្វផ្សាយ ព្រោះ ក្រែង ពើប ប្រទះ ម៉ូតូ របស់ ខ្លួន ។
គួរ ជម្រាប ថា ក្នុង ប្រតិបត្តិការ ពិនិត្យ ទីតាំង សង្ស័យ បញ្ចាំ ដោយ ខុស ច្បាប់ នេះ កម្លាំង សមត្ថកិច្ច បាន រកឃើញ ម៉ូតូ ប្រមាណ ជាង ១.០០០ គ្រឿង ដែល គ្មាន ឯកសារ ត្រឹមត្រូវ ហើយ បាន យក ទៅ រក្សាទុក ដើម្បី ស្វែងរក ម្ចាស់ ៕
រដ្ឋបាល រាជធានី ភ្នំពេញ ស្នើ ឱ្យ ក្រុមហ៊ុន ទទួល ម៉ៅការ ដែល ឈ្នះ ការដេញថ្លៃ គម្រោង មូលនិធិ អភិវឌ្ឍន៍ សង្កាត់ យកចិត្តទុកដាក់ ធានា នូវ គុណភាព ស្រប តាម ស្តង់ដារ បច្ចេកទេស ឱ្យ បាន ត្រឹមត្រូវ
( ភ្នំពេញ ) ៖ លោក នួន ផារ័ត្ន អភិបាល រង រាជធានី ភ្នំពេញ បាន ស្នើ ឱ្យ ក្រុមហ៊ុន ទទួល ម៉ៅការ ដែល ឈ្នះ ការដេញថ្លៃ គម្រោង មូលនិធិ អភិវឌ្ឍន៍ សង្កាត់ យកចិត្តទុកដាក់ ធានា នូវ គុណភាព ស្រប តាម ស្តង់ដារ បច្ចេកទេស ឱ្យ បាន ត្រឹមត្រូវ និង ធានា សុវត្ថិភាព ជូន ដល់ សាធារណៈ ជន ។
លោក នួន ផារ័ត្ន ក៏ បាន ណែនាំ ដល់ ក្រុមហ៊ុន ចូលរួម ដេញ ថ្ងៃ ទាំងអស់ ត្រូវ ពិចារណា ឱ្យ បាន ច្បាស់លាស់ ពី តម្លៃ និង ស្ថានភាព ទីតាំ ង គម្រោង ហើយ ត្រូវ គោរព នូវ បទបញ្ជា ផ្ទៃក្នុង ក្រមសីលធម៌ និង កិច្ចសន្យា គោលការណ៍ សំខាន់ ៗ អំពី ការដេញ ថ្ងៃ ។ កុំ ឱ្យ មាន ការដេញថ្លៃ បាន ហើយ បែរជា អនុវត្ត មិន បាន ។
លោក អភិបាល រង រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ថវិកា អភិវឌ្ឍន៍ សង្កាត់ នៅ មាន កម្រិត ដូច្នេះ សូម ប្រើប្រាស់ ឱ្យ យកចិត្តទុកដាក់ លើ បញ្ហា នេះ ហើយក៏ ជា ការចាប់ផ្ដើម នៃ ការចាយ ថវិកា លើ គម្រោង នីមួយ ៗ ដែល សង្កាត់ អាច មាន លទ្ធភាព ក្នុង ការគ្រប់គ្រង គម្រោង របស់ ខ្លួន បាន ។
ជាមួយគ្នា នេះ ដែរ លោក នួន ផារ័ត្ន បាន គូសបញ្ជាក់ ថា៖ « រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង ចុះ ត្រួតពិនិត្យ ការងារ អនុវត្ត គម្រោង របស់ សង្កាត់ ទាំងអស់ អញ្ចឹង ទេ សុំ ឱ្យ ក្រុមហ៊ុន ទាំងអស់ យកចិត្តទុកដាក់ ដោយ ការដេញថ្លៃ នេះ សូម ឱ្យ ធានា បាន នូវ ភាពត្រឹមត្រូវ គិតគូរ ឱ្យ បាន ច្បាស់លាស់ នូវ តម្លៃ និង ទំហំ ការងារ និង ធានា សុវត្ថិភាព ជូន ដល់ សាធារណៈ ជន និង ធានា ដល់ គុណភាព ស្រប តាម ស្តង់ដារ បច្ចេកទេស ឱ្យ បាន ត្រឹមត្រូវ » ។
សូម បញ្ជាក់ ថា ក្រុមហ៊ុន ចូលរួម ដេញថ្លៃ មាន ចំនួន ៤ក្រុមហ៊ុន ចំពោះ លទ្ធផល ក្រុមហ៊ុន ដែល ដេញថ្លៃ បាន តាម សង្កាត់ នីមួយ ៗ មាន ដូច ជា៖
ទី១៖ សង្កាត់ ទន្លេបាសាក់ បាន ទៅ ក្រុមហ៊ុន អ៊ុយ សុភាព . ទី ២៖ សង្កាត់ ទួល ទំពូង ទី១ បាន ទៅ ក្រុមហ៊ុន អ៊ុយ សុភាព . ទី ៣៖ សង្កាត់ ទួល ទំពូង ទី២ បាន ទៅ ក្រុមហ៊ុន សុធី រាជ ខន ស្រ្កាក់ សិន ទី៤៖ សង្កាត់ បឹងត្របែក បាន ទៅ ក្រុមហ៊ុន លឹម ម៉ៅ ខន ស្ក្រាក់ សិន ទី៥៖ សង្កាត់ ផ្សារ ដើម ថ្កូវ ( មិន បាន បើក សំណើ សុំ ដេញថ្លៃ នោះ ទេ ដោយសារ ខ្វះ កូរ៉ុម ក្រុមហ៊ុន ចូលរួម ដេញថ្លៃ ) ហើយ ក្រុមហ៊ុន ដែល ដេញថ្លៃ បាន នឹង ចុះ អនុវត្ត គម្រោង នៅក្នុង ឆ្នាំ ២០២២ នេះ ៕
បេឡា ជាតិ របប សន្ដិសុខ សង្គម សហការ ជាមួយ អគ្គ នាយកដ្ឋាន អត្តសញ្ញាណកម្ម បន្ដ ត្រួតពិនិត្យ ដោះស្រាយ ផ្ដល់ អត្ដសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ ( មាន ឈីប ) ជូន កម្មករ និយោជិត នៅ ខេត្ត ស្វាយរៀង
( ភ្នំពេញ ) ៖ បេឡា ជាតិ របប សន្ដិសុខ សង្គម សហការ ជាមួយ នាយកដ្ឋាន អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ នៃ អគ្គ នាយកដ្ឋាន អត្តសញ្ញាណកម្ម ដើម្បី សម្របសម្រួល បន្ដ ការត្រួតពិនិត្យ ដោះស្រាយ និង ផ្ដល់ អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ សម្រាប់ កម្មករ និយោជិត និង សមាជិក ប . ប. ស ដែល គ្មាន អត្ដសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ នៅ មូលដ្ឋាន ខេត្ត ស្វាយរៀង មាន រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២២ - ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ ។
លោក ឧត្តមសេនីយ៍ ទោ សុខ ប្រាង អនុប្រធាន នាយកដ្ឋាន អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ នេះ ថា ដោយ មាន កិច្ចសហការ ជាមួយ បេឡា ជាតិ របប សន្ដិសុខ សង្គម លោក បាន ដឹកនាំ ក្រុមការងារ នៃ នាយកដ្ឋាន ជំនាញ ចុះ សម្របសម្រួល ដោះស្រាយ និង ផ្ដល់ អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ ជូន កម្មករ និយោជិត ដែល មកពី បណ្ដា ខេត្ត ផ្សេង ៗ មក ធ្វើការ នៅក្នុង រោងចក្រ នៃ ខេត្ត ស្វាយរៀង ។
បើ តាម លោក ឧត្តមសេនីយ៍ ទោ សុខ ប្រាង ជា ការកំណត់ ដោយ ច្បាប់ សម្រាប់ អ្នក ដែល ត្រូវ ធ្វើ អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ គឺ តម្រូវឲ្យ ពួកគាត់ មាន ឯកសារ ពាក់ព័ន្ធ ហើយ ត្រូវ ទៅ ធ្វើ នៅ ស្រុក កំណើត របស់ គាត់ ប៉ុន្ដែ ដើម្បី សម្រួល ដល់ ការងារ នេះ នាយកដ្ឋាន អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ ចុះ មកដល់ ទីតាំង របស់ រោងចក្រ ដែល ពួកគាត់ កំពុង បម្រើ ការ តែម្ដង ដើម្បី សម្រួល ដល់ ការលំបាក ផ្សេង ៗ ។
អនុប្រធាន នាយកដ្ឋាន អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ ដែល ដឹកនាំ ក្រុម អន្ដរាគមន៍ ចុះ ធ្វើ កិច្ចការងារ នេះ ដោយ ផ្ទាល់ បាន អះអាង ថា ក្នុង រយៈពេល មួយ ថ្ងៃ ម្សិលមិញ ទី ២២ ខែកញ្ញា ឆ្នាំ ២០២២ ក្រុមការងារ បាន ធ្វើ អត្តសញ្ញាណ បណ្ណ ជូន កម្មករ និយោជិត សមាជិក ប .ស. ស បាន ជាង ១០០ នាក់ ហើយ នឹង បន្ដ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា នេះ មួយ ថ្ងៃ ទៀត ។
សូម ជម្រាប ថា ការផ្ដល់ អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ នេះ មិន តម្រូវឲ្យ ប្រជាពលរដ្ឋ បង់ ថ្លៃ សេវា នោះ ឡើយ ៕
សម្តេច ពញា ចក្រី ហេង សំរិន អំពាវនាវ អាជ្ញាធរ ជួយ សម្រួល និង បង្ក លក្ខណៈ ងាយស្រួល ដល់ ពលរដ្ឋ នា ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ និង ដំណើរកម្សាន្ត នានា
( ត្បូងឃ្មុំ ) ៖ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា បាន អំពាវនាវ ដល់ អាជ្ញាធរ គ្រប់ ទីកន្លែង ត្រូវ ជួយ សម្រួល និង បង្ក លក្ខណៈ ងាយស្រួល ជូន ដល់ ប្រជាពលរដ្ឋ នៅក្នុង ឱកាស បុណ្យ កាន់ បិណ្ឌ និង បុណ្យ ភ្ជុំ បិណ្យ ព្រមទាំង ការដំណើរកម្សាន្ត ជួបជុំ ក្រុមគ្រួសារ នានា ជាដើម ។
ការអំពាវនាវ បែប នេះ របស់ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច រួមទាំង បុត្រា បុត្រី ចៅ ប្រុស ចៅ ស្រី សមាជិក សមាជិកា រដ្ឋសភា ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត បាន ប្រារព្ធ ពិធី កាន់ បិណ្ឌ ទី ១៣ នៅ វត្ត ថ្កូវ ស្ថិត ក្នុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២២ តាម ពិធី ទំនៀប ទម្លាប់ ព្រះពុទ្ធ សាសនា ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន និង ប្រជាពុទ្ធ បរិស័ទ ទាំងអស់ បាន បូជា ទៀន ធូប ផា្កភ្ញី ថ្វាយ ចំពោះ ព្រះរតន ត្រៃ រាប់ បាត្រ ព្រមទាំង បាន នាំយក នូវ ទេយ្យ ទាន គ្រឿង ឧបភោគ បរិភោគ ភេសជ្ជៈ បច្ច័យ ប្រគេន ព្រះសង្ឃ ឧទ្ទិស កុសល ផល បុណ្យ ជូន ទៅដល់ វិញ្ញាណក្ខន្ធ បុព្វការី ជន មាន មាតាបិតា ជីដូន ជីតា និង ញាតិការ ទាំង ៧សន្ដាន និង ឥស្សរជន វីរ ជន យុទ្ធជន ដែល បាន លះបង់ ជីវិត ដើម្បី បុព្វហេតុ ជាតិ និង ប្រជាជន សូម ឱ្យ ដួង វិញាណក្ខន្ធ អស់ លោក នោះ បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
បុណ្យ ភ្ជុំ បិណ្ឌ ជា ពិធី បុណ្យ មួយ ដែល ធំ ជាង គេ នៅក្នុង ចំណោម ពិធី បុណ្យ ទាំងអស់ ចំពោះ អ្នកកាន់ ព្រះពុទ្ធ សាសនា ។ ជារៀងរាល់ ឆ្នាំ នៅពេល ដល់ ថ្ងៃ ខែ ដែល ត្រូវ ប្រារព្ធ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ គ្រប់ បងប្អូន កូន ចៅ សាច់ញាតិ សន្ដាន ទាំងអស់ ទោះ នៅ ទី ជិត ឬ ទី ឆ្ងាយ តែងតែ ធ្វើដំណើរ ទៅ ជួបជុំគ្នា ជាពិសេស ឪពុក ម្ដាយ នៅ ស្រុក កណើត ដើម្បី រៀបចំ ម្ហូប អាហារ បាយ សម្ល ចង្ហាន់ យក ទៅ ប្រគេន ព្រះសង្ឃ ដែល គង់ នៅ វត្ត អារាម ។ ទាំង នេះ គឺជា ទម្លាប់ មួយ ដែល គេ និយម ធ្វើ ត ៗ គ្នា របស់ ជនជាតិ ខ្មែរ ជា យូរ មកហើយ ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន ជូន ពរ ដល់ ប្រជាពលរដ្ឋ ទំាង អស់ ជូប តែ សេក្តី សុខ សេចក្តី ចម្រើន គ្រប់ ក្រុមគ្រួសារ ។ រាល់ ការធ្វើដំណើរ ជិត ឆ្ងាយ នៅក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ជួប តែ សុខ សុវត្ថិភាព ដោយ គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា និង ចេះ អព្យាស្រ័យ គ្នា ទៅ វិញ ទៅមក ៕
ក្នុង ញត្តិ គាំទ្រ ធ្វើឡើង កាលពី ថ្ងៃទី ២១ ខែកញ្ញា សហភាព សហជីព ការងារ កម្មករ កម្ពុជា ដែល មាន សមាជិក ជាង ២ម៉ឺន នាក់ មកពី វិស័យ វាយន ភណ្ឌ កាត់ដេរ ផលិត ស្បែកជើង និង កាបូប បាន ចូលរួម អបអរសារទរ ជាមួយ កម្មករ និយោជិត ដែល ទទួលបាន ប្រាក់ ឈ្នួល អប្បរមា ថ្មី ចំនួន ២០០ ដុល្លារ សម្រាប់ កម្មករ ពេញ សិទ្ធិ និង ចំនួន ១៩៨ ដុល្លារ សម្រាប់ កម្មករ សាកល្បង ។
សហភាព សហជីព ការងារ កម្មករ កម្ពុជា បាន គាំទ្រ ពេញ ទំហឹង ចំពោះ សេចក្ដីថ្លែងការណ៍ របស់ ក្រុមប្រឹក្សា ជាតិ ប្រាក់ ឈ្នួល អប្បបរមា ។
សហភាព សហជីព ការងារ កម្មករ កម្ពុជា ក៏ បាន ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ចំពោះ ការបន្ថែម ប្រាក់ ២ដុល្លារ ដើម្បីឱ្យ ប្រាក់ ឈ្នួល អប្បបរមា របស់ កម្មករ និយោជិត បាន គ្រប់ ២០០ ដុល្លារ ។ សហភាព សហជីព ការងារ កម្មករ កម្ពុជា ចាត់ទុក ការបន្ថែម នេះ គឺជា ការគិតគូរ យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ សុខ ទុក្ខ របស់ កម្មករ និយោជិត ទូទាំង ប្រទេស កម្ពុជា ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ កាលពី ថ្ងៃទី ២១ ខែកញ្ញា បាន ប្រកាស ឱ្យដឹង ថា កម្មករ និយោជិត ក្នុង វិស័យ វេយណ ភណ្ឌ និង កាត់ដេរ ទទួលបាន ប្រាក់ ឈ្នួល អប្បបរមា ចំនួន ២០០ ដុល្លារ សម្រាប់ ឆ្នាំ ២០២៣ ។ ដោយឡែក កម្មករ និយោជិត សាកល្បង ទទួលបាន ១៩៨ ដុល្លារ ៕ ជនរងគ្រោះ និង ងាយ រងគ្រោះ កំពុង ស្នាក់ នៅក្នុង មណ្ឌល ឱកាស ខ្ញុំ និង មណ្ឌល សំចត សង្គមកិច្ច ព្រៃ ស្ពឺ ទទួលបាន យកចិត្ត ទុក ពី មន្ទីរ សង្គមកិច្ច រាជធានី ភ្នំពេញ នា ឱកាស បុណ្យ កាន់ បិណ្ឌ
( ភ្នំពេញ ) ៖ លោកស្រី មុំ ចាន់ ដានី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ឋ ជន និង យុវនិតិសម្បទា រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា
ឆ្នាំ ២០២២ នេះ បាន រៀបចំ និមន្ត ព្រះសង្ឃ សូត្រ មន្ត បង្សុកូល ឧទ្ទិស កុសល ដល់ បុព្វការី ជន និង បាន ធ្វើ បុណ្យ រាប់ បាត្រ ក្នុង ឱកាស បុណ្យ កាន់ បិណ្ឌ ភ្ជុំ បិណ្ឌ ប្រពៃណី ជាតិ ខែ្ម រ ដូន ប្រជាពលរដ្ឋ នៅ តាម ភូមិ ស្រុក ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ឱ្យ ជនរងគ្រោះ ជន ងាយ រងគ្រោះ ដែល កំពុង ស្នាក់ នៅក្នុង មណ្ឌល ឱកាស ខ្ញុំ និង មណ្ឌល សំចត សង្គមកិច្ច ព្រៃ ស្ពឺ ។
រថយន្តក្រុង ១៧៥ គ្រឿង ចេញ ដឹកជញ្ជូន ពលរដ្ឋ ចេញ ពី ភ្នំពេញ ទៅ លេង ស្រុក កំណើត ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ដោយ មិន យក ប្រាក់
រថយន្តក្រុង ទាំង១៧៥ គ្រឿង របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវបាន បែងចែក សម្រាប់ ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ចេញ ពី រាជធានី ភ្នំពេញ តាម ច្រក ចេញ ចូល រាជធានី ភ្នំពេញ គឺ តាម តម្រាយ ផ្លូវ ជាតិ ទាំង៦ ចេញ ទៅ បណ្តា ខេត្ត ក្រុង នានា ចំនួន ១២០ គ្រឿង ។ សូម បញ្ជាក់ ថា សម្រាប់ ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ប្រើប្រាស់ រថយន្ត ចំនួយ ៥៥ គ្រឿង ។ ការចេញដំណើរ ចាប់ពី ម៉ោង ៥និង ៣០ នាទី ព្រឹក ថ្ងៃទី ២៣ កញ្ញា នេះ ។
លោក ឃួង ស្រេង បាន ថ្លែង ថា៖ « ដោយ អនុវត្ត តាម អនុសាស ន៏ របស់ សម្តេច តេជោ ហ៊ុន សែន រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជូន រថយន្តក្រុង ចំនួន ១៧៥ គ្រឿង ទៅ១៨០ គ្រឿង ចាំ ដឹក បងប្អូន ប្រជាពលរដ្ឋ ទៅ ស្រុក កំណើត តាម បណ្តា ខេត្ត ក្រុង នានា ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ដោយ មិន យក ប្រាក់ ទាំង ទៅ ទាំង មក ។ នេះ ជា ការគិតគូ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ការសម្រាល ការចំណាយ របស់ បងប្អូន ប្រជាពលរដ្ឋ យើង ក្នុង ពេល ទៅ លេង ស្រុក កំណើត នា ឱកាស នេះ » ។
