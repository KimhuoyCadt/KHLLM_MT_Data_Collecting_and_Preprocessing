( ភ្នំពេញ ) ៖ ពី ថ្ងៃទី ២៩ - ៣១ ខែធ្នូ ឆ្នាំ ២០២៣ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ចូលរួម អបអរសាទរ ខួប លើក ទី២៥ នៃ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល នៅ កម្ពុជា នៅ វិមាន ឈ្នះ ឈ្នះ បាន ចូលរួម ផ្សព្វផ្សាយ តាំង បង្ហាញ អំពី សកម្មភាព និង ស្នាដៃ ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ក្នុង រយៈពេល ២៨ ឆ្នាំ កន្លងមក នេះ ដល់ ភ្ញៀវ ជាតិ និង អន្តរជាតិ បាន ដឹង និង សិក្សា ស្វែងយល់ ។
ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត ប្រធាន នាយកដ្ឋាន ផ្សព្វផ្សាយ អប់រំ និង ទំនាក់ទំនង សាធារណៈ នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ប្រាប់ វិទ្យុ ជាតិ កម្ពុជា ឱ្យដឹង ថា ក្នុង រយៈពេល ២៨ ឆ្នាំ មក នេះ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ លើ បញ្ហា គ្រឿងញៀន ។
ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត បាន បន្ត ថា អបអរសាទរ នៃ ខួប ២៥ ឆ្នាំ នៃ នយោបាយ ឈ្នះ ឈ្នះ នេះ គឺ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ដាក់តាំង រូប សកម្មភាព មាន ដូចជា សកម្មភាព របស់ ថ្នាក់ដឹកនាំ និង ការរីកចម្រើន របស់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ចាប់ពី កកើត តាំងពី ឆ្នាំ ១៩៩៥មក គិត មកដល់ ឆ្នាំ ២០២៣ នេះ មាន រយៈពេល ២៨ ឆ្នាំ ហើយ ។
( ភ្នំពេញ ) ៖ ចាប់តាំងពី ប្រទេស កម្ពុជា ដាក់ ផែនការទាក់ទាញ អ្នក វិនិយោគ បរទេស ក្រុម អ្នកជំនួញ បាន បណ្ដាក់ទុន ជា បន្តបន្ទាប់ ។
ផែនការទាក់ទាញ អ្នក វិនិយោគ បរទេស នោះ ដោយ រាប់ តាំងពី ការបង្កើន ការសាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ដែល មាន កំណើន ២៩% និង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ នៃ ការប្រាស្រ័យទាក់ទង ដែល មាន កំណើន ១២៥ % នៅ ចន្លោះ ឆ្នាំ ២០១៧ ដល់ ២០២១ ។
លោក អាន ស៊ី ថា វ អ្នកស្រាវជ្រាវ ផ្នែក សេដ្ឋកិច្ច ពន្យល់ អំពី វឌ្ឍនភាព នៃ ទាក់ទាញ វិនិយោគ នៅ កម្ពុជា ដូចត ទៅ៖
ព្រះមហាក្សត្រ សព្វ ព្រះរាជ ហរទ័យ សម្ដេច យាង សួរសុខទុក្ខ និង ប្រទាន ព្រះរាជ អំណោយ ដល់ ប្រជាកសិករ នៅ ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ ព្រះករុណា ព្រះបាទ សមេ្តច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ បាន សព្វ ព្រះរាជ ហឫទ័យ ស្តេច យាង សួរសុខទុក្ខ និង ប្រោស ព្រះរាជ ទាន នូវ ព្រះរាជ អំណោយ ដល់ ប្រជារាស្រ្ត ជា កសិករ ប្រមាណ ៤០៤ គ្រួសារ ស្ថិត នៅ ភូមិ ព្រៃ រូង និង ភូមិ ត្របែក ឃុំ ពាន រោង ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង ។
ក្នុង ព្រះរាជ ដំណើរ តាម ព្រះទីនាំង រថយន្ត លើ ចម្ងាយ ផ្លូវ ប្រមាណ ជាង ១៣០ គីឡូម៉ែត្រ តាម បណ្ដោយ ផ្លូវ ជាតិ ឪ លេខ ៨ រួច ចុះ តាម ផ្លូវ ក្រាល កៅស៊ូ និង បន្ត តាម ផ្លូវ លំ ក្រាល ក្រួស ក្រហម ។ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រះអង្គ បាន សព្វ ព្រះរាជ ហឫទ័យ ស្តេច យាង ចុះ ជួប សំណេះសំណាល និង ទត ដោយ ផ្ទាល់ ព្រះភក្ត្រ របស់ ព្រះអង្គ ចំពោះ គ្រួសារ ប្រជាកសិករ ចំនួន ៣គ្រួសារ ដល់ ក្នុង លំនៅឋាន ។
ព្រះអង្គ បាន សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជ ទាន ព្រះរាជ អំណោយ ដល់ គ្រួសារ ទាំង ៣ដោយ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន អង្ករ ៥០ គីឡូក្រាម ឃីត ១កញ្ចប់ ( មាន មុង១ ភួយ១ សារុង១ និង ក្រមា១ ) តង់ កៅស៊ូ១ ផ្ទាំង មី ១កេស ត្រីខ ១០ កំប៉ុង ស្បែកជើង ផ្ទាត់១ គូ អាវយឺត មាន ស្លាក ព្រះរាជ អំណោយ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ចំនួន ១ និង ថវិកា ១០ម៉ឺន រៀល ។
ក្នុង ឱកាស ដ៏ វិសេសវិសាល នោះ ព្រះអង្គ បាន ទទួល ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ជា ទីបំផុត ពីសំណាក់ លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ លោកយាយ លោក តា បងប្អូន ប្រជារាស្រ្ត ជា កូន ជា ចៅ របស់ ព្រះអង្គ ប្រកបដោយ ក្តី នឹក រឭក និង គោរព ស្រឡាញ់ ជា ទីបំផុត ។
ទន្ទឹមនឹង នេះ ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត បាន មាន ព្រះរាជ បន្ទូល កោតសរសើរ ចំពោះ ថ្នាក់ដឹកនាំ ព្រឹទ្ធសភា រដ្ឋសភា ពិសេស រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ប៉ិនប្រសព្វ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ប្រធាន ឧត្តម ក្រុមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ។
បន្ទាប់ពី ព្រះរាជ បន្ទូល សំណេះ សំណាល រួច មក ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ បាន សព្វ ព្រះរាជ ហឫទ័យ ស្តេច យាង ប្រោស ព្រះរាជ ទាន នូវ ព្រះរាជ អំណោយ ដោយ ផ្ទាល់ ព្រះហស្ត របស់ ព្រះអង្គ ដល់ ប្រជារាស្រ្ត ជា កសិករ ទាំង ៤០៤ គ្រួសារ ប្រកបដោយ ទឹក ព្រះទ័យ សប្បាយរីករាយ និង អាណិត ស្រឡាញ់ ជា ទីបំផុត ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ក្រុម រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « យើង កំពុង តាម យ៉ាង ដិតដល់ អម ជាមួយ ការព្រួយបារម្ភ ពី ស្ថានការណ៍ វិវត្តន៍ ថ្មី នេះ នៅក្នុង តំបន់ សមុទ្រ ចិន ខាងត្បូង ដែល អាចនឹង បំផ្លាញ សន្តិភាព សន្តិសុខ និង ស្ថិរភាព នៅក្នុង តំបន់ ។ ដូច្នេះ យើង សូម អះអាង ឡើងវិញ ពី សារៈសំខាន់ នៃ កិច្ចសន្ទនា ដោយ សន្តិវិធី ដែល ចូលរួមចំណែក ប្រកបដោយ លក្ខណៈ ស្ថាបនា ដើម្បី លើកកម្ពស់ ស្ថិរភាព និង កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ សមុទ្រ » ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស - មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ដឹកនាំ មេបញ្ជាការ រង នាយ សេនាធិការ នាយ សេនាធិការ រង មេបញ្ជាការ មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ទាំង ១៤ និង នាយ ទាហាន នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ជាច្រើន រូប ទៀត ចុះ សួរសុខទុក្ខ លោក ឧត្តមសេនីយ៍ ត្រី គង់ គីនី មេបញ្ជាការ រង នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដែល មាន ជម្ងឺ ធ្ងន់ ត្រូវបាន ចូល សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ កាល់ម៉ែត ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ ។
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៦០ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៦០ នាក់ នោះ មាន ៥១ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស គ្រឿងញៀន ១៨ករណី និង ជនសង្ស័យ ០៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស ព្រហ្មទណ្ឌ ០៩ ករណី ។
ទីក្រុង ព្យុងយ៉ាង កាលពី ខែវិច្ឆិកា កន្លងទៅ បាន បាញ់ បង្ហោះ ផ្កាយ រណប ស៊ើបការណ៍ ដំបូង បំផុត របស់ ខ្លួន យក ទៅ ដាក់ នៅ គន្លង ផែនដី ដោយ ជោគជ័យ ហើយ បាន អះអាង ចាប់តាំងពី ពេល នោះ មក ថា ផ្កាយ រណប នេះ បាន ថត និង ផ្ដល់ រូបភាព មូលដ្ឋាន យោធា សំខាន់ ៗ របស់ សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង ។
( ពោធិ៍សាត់ )៖ លោក ស៊ុយ សែម អ្នកតំណាងរាស្ត្រ មណ្ឌល ពោធិ៍សាត់ និង លោកស្រី ជា ខេង ស៊ុយ សែម នា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ បាន អញ្ជើញ កាត់ ឬ សីមា ព្រះវិហារ ថ្មី និង សម្ពោធ ឆ្លង សមិទ្ធផល នានា ក្នុង វត្ត ពុទ្ធា រាម ហៅ វត្ត ភូមិ ស្ទឹង ឃុំ ក ណ្តៀង ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ ដែល មាន តម្លៃ ប្រមាណ ជិត ៣ពាន់ លាន រៀល ។
ពិធី នេះ បាន ការនិមន្ត និង អញ្ជើញ ចូលរួម ពី ព្រះព្រហ្មា ភិរ័ត កែវ ក ន ព្រះរាជា គណៈ ថ្នាក់ កិត្តិយស នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រះពោធិ៍វង្សា វិមល ព្រះមេ គណ ខេត្ត ពោធិ៍សាត់ . លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ ព្រមទាំង អ្នក ឧកញ៉ា អស់ លោក លោកស្រី ជា ប្រតិភូ អម ដំណើរ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ពុទ្ធ បរិស័ទ្ធ ជា កុះករ ។
សម្រាប់ ពិធី បុណ្យ ឆ្លង នេះ ត្រូវបាន ប្រារព្ធ ធ្វើឡើង រយៈពេល ០៣ ថ្ងៃ ពោលគឺ ចាប់ពី ថ្ងៃទី ២៧ - ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ ដោយ មាន ការ សម្ដែង ធម៌ទេសនា ពី ព្រះវន រ័ត កិត្តិបណ្ឌិត ណយ ច្រឹក ព្រះសង្ឃ នាយក រង ទី២ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ពេល រាត្រី ក៏ មាន ការប្រគុំតន្ត្រី លេង ល្ខោន និង បាញ់ កាំជ្រួច បង្ក ភាពសប្បាយរី រាយ ដល់ ប្រជាពុទ្ធ បរិស័ទ ផងដែរ ។
លោក សូម ប្រគេន និង ប្រគល់ សមិទ្ធផល ទាំងអស់ នេះ ជូន ព្រះសង្ឃ គណៈកម្មការ អាចារ្យ និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ទាំងអស់ សម្រាប់ ប្រើប្រាស់ ហើយ សូម ជួយ ថែរក្សា ការពារ និង ជួយ ជួសជុល ឲ្យបាន ស្អាត ជានិច្ច និង សូម ឧទ្ទិស កុសល្យ ផល បុណ្យ ដែល ទទួលបាន ពី សទ្ធា ជ្រះថ្លា នេះ ជូន ទៅដល់ វិញ្ញាណក្ខ័ន្ធ អ្នក មាន គុណ ទាំងអស់ ពិសេស ពុទ្ធ បរិស័ទ ទាំងអស់ ដែល មក ចូលរួម ក្នុង ពិធី បុណ្យ នេះ ទទួលបាន បុណ្យ ស្មើ ៗ គ្នា ៕
លោក រដ្ឋមន្រ្តី ហួត ហាក់ អញ្ជើញ បិទ វគ្គ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ អធិការកិច្ច « វីធីសាស្រ្ត អង្គេត ស្រាវជ្រាវ និង ដោះស្រាយ វិវាទ ដីធ្លី »
ថ្លែង ក្នុង ពិធី ដ៏ មាន អត្តន័យ នា ពេលនេះ លោក រដ្ឋមន្រ្តី ក៏ បាន កោតសរសើរ និង វាយតំលៃ ខ្ពស់ ចំពោះ វិទ្យាស្ថាន ជាតិ អធិការកិច្ច ដែល បាន ប្រឹងប្រែង រៀបចំ វគ្គ បណ្តុះបណ្តាល សម្រេចបាន លទ្ធផល ផ្លែ ផ្កា គួរ ជា ទី មោទនៈ ។ ជាមួយគ្នា នេះ ដែរ លោក រដ្ឋមន្រ្តី ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ គ្រូ ឧទ្ទេស ទាំងអស់ ដែល បាន ចំណាយ ពេលវេលា ដ៏ មាន តំលៃ ធ្វើ បទ ឧទ្ទេសនាម ចែករំលែក ចំណេះដឹង និង បទពិសោធន៍ ល្អ ៗ ដល់ សិក្ខាកាម រយៈពេល ៨ ថ្ងៃ កន្លងទៅ នេះ ។
ទី១ - ត្រូវ មាន ចក្ខុវិស័យ ច្បាស់លាស់ ទី២ - ត្រូវ មាន ការប្ដេជ្ញាចិត្ត ខ្ពស់ ទី៣ - ត្រូវ មាន ការចូលរួម ដោយ ស្មោះត្រង់ ទី៤ - ត្រូវ មាន ការលះបង់ ។
សំដៅ បម្រើ សេវា សាធារណៈ ឱ្យ កាន់តែ ល្អ ស្អាតស្អំ ប្រកបដោយ សុចរិតភាព ដើម្បី ឈានទៅ សម្រេច ឱ្យ បាន ចក្ខុវិស័យ ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស ដែល មាន សេដ្ឋកិច្ច ជឿនលឿន នៅ ឆ្នាំ ២០៥០៕ គណបក្ស ខ្មែរ អភិរក្ស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ គណបក្ស ខ្មែរ អភិរក្ស សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ស្ថាបនិក និង ជា អគ្គ មគ្គុទ្ទេសក៍ ឯក បាន ធ្វើឲ្យ កម្ពុជា បិទ បញ្ចប់ ភ្លើង សង្គ្រាម រកឃើញ សុខ សន្តិភាព ជាពិសេស បាន បិទ បញ្ចប់ ទំព័រ ខ្មៅ ងងឹត នៃ ការបែកបាក់ ជាតិ ក្នុង រយៈពេល តិច បំផុត ៥០០ ឆ្នាំ ។ ការផ្តើម ពី សុខ សន្តិភាព និង ការឯកភាព ជាតិ ទាំងស្រុង នា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ជា បុព្វហេតុ ដ៏ ធំធេង នាំឱ្យ កម្ពុជា សម្រេចបាន នូវ ការកសាង ជាតិ ឲ្យ រីកចម្រើន ប្រជាពលរដ្ឋ រស់ នៅ ប្រកបដោយ សុខ សុភមង្គល ដូច ពេល បច្ចុប្បន្ន នេះ ។
អតីត នាយក រដ្ឋមន្រ្តី នៃ ប្រទេស អាល់បាល នី ត្រូវ ឃុំ ខ្លួន ក្នុង ផ្ទះ ក្រោម ការស៉ើប អង្កេត ពី បទ ពុករលួយ
( ភ្នំពេញ ) ៖ គណបក្ស ខ្មែរ ក្រោក សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
គណៈកម្មការរៀបចំ ព្រឹត្តិការណ៍ ប្រកួត កីឡា វាយ កូនគោល ពានរង្វាន់ សម្តេច តេជោ ហ៊ុន សែន លើក ទី៧ ឆ្នាំ ២០២៣ បាន ចាត់ទុក សមិទ្ធផល ដ៏ ធំធេង ជា ប្រវត្តិសាស្រ្ត នេះ កើត ចេញ ពី សន្តិភាព ក្រោម នយោបាយ ឈ្នះ ឈ្នះ តេជោ ហ៊ុន សែន ដែល បាន បញ្ចប់ សង្គ្រាម ស៊ីវិល ទាំងស្រុង នៅ កម្ពុជា រហូត ទទួលបាន សុខ សន្តិភាព និង ការឯកភាព ជាតិ ពេញលេញ ធ្វើឱ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ គ្រប់ វិស័យ ។ សម្តេច តេជោ ជា គំរូ នៃ ការលះបង់ ដ៏ ថ្លៃថ្លា បំផុត ដើម្បី ធានា ភាព បន្ត វេន នៃ ការដឹកនាំ ប្រកបដោយ សុវត្ថិភាព និង ភាពជឿជាក់ ។
គណបក្ស ធម្មាធិបតេយ្យ គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ គណបក្ស ធម្មាធិបតេយ្យ សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ការប្រកាស កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ជា គំនិត ប្រកបដោយ គតិបណ្ឌិត ខ្ពង់ខ្ពស់ បំផុត និង ប្រកប ដោយ ទស្សនវិស័យ វែងឆ្ងាយ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត សម្រាប់ ជា ឧត្តម ប្រយោជន៍ របស់ ជាតិ មាតុភូមិ ។ យើងខ្ញុំ ទាំងអស់ គ្នា មាន ក្តី សោមនស្ស រីករាយ ក្រៃលែង និង សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង នូវ ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
( ស៉ីដនី ) ៖ ព្យុះភ្លៀង និង ផ្គរ រន្ទះ ដ៏ ខ្លាំងក្លា បាន វាយលុក ផ្នែក ខ្លះ នៃ ភាគ ខាងកើត ប្រទេស អូស្ត្រាលី នៅ ថ្ងៃសៅរ៍ នេះ ក្រោយពី ព្យុះ បាន បោកបក់ លើ តំបន់ នេះ អំឡុង បុណ្យ ណូអែល កន្លងទៅ រីឯ អាកាសធាតុ ក្តៅ កើតមាន នៅឯ ភាគ ខាងជើង ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃសៅរ៍ ទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ ។
គួរ បញ្ជាក់ ថា រដូវ ក្តៅ ដែល ចាប់ផ្តើម ពី ខែធ្នូ ដល់ ខែកុម្ភៈ របស់ ប្រទេស អូស្រ្តាលី កំពុង ស្ថិត នៅក្រោម ឥទ្ធិពល នៃ បាតុភូត El Nino ដែល អាច បង្កឲ្យ មាន គ្រោះ ធម្មជាតិ រាប់ ចាប់តាំងពី ភ្លើង ឆេះ ព្រៃ រហូតដល់ ព្យុះ ស៊ី ក្លូន និង គ្រោះ រាំងស្ងួត រយៈពេល យូ៕ រូបភាព ពី AFP គណបក្ស មហាសាមគ្គី ជាតិ ខ្មែរ គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ គណបក្ស មហាសាមគ្គី ជាតិ ខ្មែរ សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
( ភ្នំពេញ ) ៖ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ត្រូវបាន ប្រារព្ធ ឡើង នៅ ជុំវិញ ពិភពលោក ក្នុង ឱកាស ឆ្លង ពី ឆ្នាំ ចាស់ ផ្លាស់ ចូល ឆ្នាំ ថ្មី ក៏ប៉ុន្តែ ការអបអរ ឱកាស ពិសេស នេះ មិន មែន ប្រារព្ធ ឡើង ក្នុង ពេល ដំណាល គ្នា នៅលើ ផែនដី ឡើយ គឺ មាន ប្រទេស ក៏ ដូចជា តំបន់ ខ្លះ ឆ្លង មុន គេ និង ខ្លះ ទៀត ឆ្លង ក្រោយ គេ ។
រដ្ឋមន្រ្ដី អភិវឌ្ឍន៍ ជនបទ ចុះ ត្រួតពិនិត្យ ការជួសជុល ផ្លូវ មួយចំនួន នៅ ស្រុក ទ្រាំង ខេត្ត តាកែវ និង សន្យា កសាង ផ្លូវ ជាង ២ពាន់ ម៉ែត្រ ជូន ពលរដ្ឋ
( តាកែវ )៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នា ព្រឹក ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ បាន ចុះ ត្រួតពិនិត្យ ការស្តារ ផ្លូវ ក្រាល ក្រួសស មួយ ខ្សែ ប្រវែង ២ ២៧០ ម៉ែត្រ និង បាន ជួយ ឈូសឆាយ កៀរ សម្រួល ផ្លូវ ដែល រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង ចំនួន ៣ខ្សែ ក្នុង ឃុំ ត្រឡាច ស្រុក ទ្រាំង ខេត្ត តាកែវ ប្រវែង សរុប ១ ៩០០ ម៉ែត្រ ។
លោក រដ្ឋមន្រ្ដី ក៏ បាន ជម្រាប ជូន អំពី យុទ្ធសាស្ត្រ អាទិភាព របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ គឺ អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត និង គមនាគមន៍ . ការកែលម្អ លក្ខខណ្ឌ នៃ ការរស់នៅ របស់ សហគមន៍ ជនបទ តាមរយៈ ការផ្គត់ផ្គង់ ទឹក ស្អាត និង បង្គន់ អនាម័យ តាម គ្រួសារ . ការធ្វើ ពិពិធកម្ម សកម្មភាព សេដ្ឋកិច្ច ជនបទ . និង ការពង្រឹង សេវា គាំទ្រ រដ្ឋបាល និង កិច្ចការ ទូទៅ ដែល មាន គោ ដៅ រួម គឺ លើកកម្រិត កម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ប្រសើរឡើង និង រស់ នៅក្នុង ភាពសុខដុមរម្យ នា ។
លោក រដ្ឋមន្រ្ដី បាន ផ្ដាំផ្ញើ ដល់ អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ដូច ខាងក្រោម នេះ៖
១ - ត្រូវ ថែរក្សា សុខ សន្តិភាព ជា ចំបង បើ មាន សន្តិភាព យើង មាន ឱកាស អភិវឌ្ឍន៍ ប្រទេសជាតិ ឱ្យ មាន ការរីកចម្រើន ដូច បច្ចុប្បន្ន ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ស្ថាបនិក និង ត្រូវ បាន បន្ត វេន ដោយ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្រ្ដី ។
២ - ជួយ ថែរក្សា សមិទ្ធផល នានា ដែល មាន ស្រាប់ របស់ រាជ រដ្ឋាភិបាល ចូលរួម អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ជាប្រចាំ ។
៣ - សូម ជួយ គាំទ្រ គោល នយោបាយ និង យុទ្ធសាស្រ្ដ របស់ រាជ រដ្ឋាភិបាល ។
៤ - ត្រូវ ឧស្សាហ៍ ព្យាយាម កែប្រែ ឥរិយាបថ និង ទម្លាប់ អនាម័យ ល្អ ដោយ ប្រកាន់ខ្ជាប់ នូវ អនាម័យ ស្អាត ជាប្រចាំ តាមរយៈ ការបរិភោគ ទឹក និង បន្ទោរបង់ ក្នុង បង្គន់ អនាម័យ ។
៥ - ត្រូវ បន្ត រក្សា សាមគ្គីភាព ចេះ ជួយ គ្នា និង សហការ ចូលរួម ធ្វើជា ម្ចាស់ ក្នុង ការថែរក្សា សមិទ្ធផល ដែល មាន ស្រាប់ ឱ្យ បាន គង់ វង់ ។
ឆ្លើយតប ទៅនឹង សំណូមពរ របស់ ប្រជាពលរដ្ឋ សុំ ឱ្យ ជួយ សាងសង់ ផ្លូវ បេតុង មួយ ខ្សែ ប្រវែង ២ ២០០ ម៉ែត្រ នៅ ឃុំ ត្រឡាច លោក រដ្ឋមន្រ្ដី បាន ទទួលយក សំណើ នេះ ។
( ពោធិ៍សាត់ )៖ លោក កែវ រតនៈ រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ចូលរួម បុណ្យ ពុទ្ធាភិសេក ព្រះពុទ្ធរូប ១៦៨ អង្គ និង កាត់ ខ្សែបូរ សម្ពោធ ឆ្លង សមិទ្ធផល នានា នៅ រមណីយដ្ឋាន វប្បធម៌ ធម្មជាតិ និង ប្រវត្តិសាស្ត្រ « ភ្នំ នាគស ឬ ល្អាង ព្រះនាង រំសាយ សក់ » ដែល មាន តម្លៃ ជាង ៣០ម៉ឺន ដុល្លារ សហរដ្ឋ អាមេរិក ស្ថិត ក្នុង ភូមិ ក្បាល ដំរី ឃុំ អន្សា ចំបក់ ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ។
កម្មវិធី នេះ ប្រារព្ធ ធ្វើ រយៈពេល ២ ថ្ងៃ គឺ ចាប់ពី ថ្ងៃទី ២៩ - ៣០ ខែធ្នូ ឆ្នាំ ២០២៣ ដោយ មាន ពិធី ក្រុង ពាលី និង សែន បែប សាសនា ជីវ ចល សូត្រ ពិស្តារ និមន្ត ព្រះសង្ឃ ធ្វើ ពិធី ពុទ្ធាភិសេក ព្រះពុទ្ធរូប ១៦៨ អង្គ និង មាន រាប់ បាត្រ ប្រគេន ព្រះសង្ឃ ចំនួន ៥៣ អង្គ ដែល និមន្ត មកពី បណ្តា វត្ត ក្នុង ឃុំ អន្សា ចំបក់ ស្រុក ក្រគរ ផងដែរ ។
បើ តាម លោក អេង គន្ធា អគ្គ នាយក រង អគ្គិសនី កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ អន្សា ចំបក់ ស្រុក ក្រគរ និង ឃុំ ស្រែ ស្តុក ស្រុក កណ្តៀង និង ជា ស្ថាបនិក ទីតាំង នេះ ផ្ទាល់ បាន ប្រាប់ ភ្នាក់ងារ Fresh News ឱ្យដឹង ថា រមណីយដ្ឋាន ភ្នំ នាគស ឬ ល្អាង ព្រះនាង រំសាយ សក់ គឺជា រមណីយដ្ឋាន មួយ ក្នុង ចំណោម រមណីយដ្ឋាន ជាច្រើន ទៀត ក្នុង ខេត្ត ពោធិ៍សាត់ ដែល មាន ទេសភាព ស្រស់ ត្រកាល គួរ ជា ទី គយគន់ ។
លោក បាន បន្ត ថា រមណីយដ្ឋាន ភ្នំ នាគស ក៏ ជា រមណីយដ្ឋាន វប្បធម៌ ធម្មជាតិ និង ប្រវត្តិសាស្ត្រ មួយ ដែល បាន ផ្ដួច ផ្ដើម កសាងឡើង ដោយ រូប លោក ផ្ទាល់ ក្រោម ការជួយជ្រោមជ្រែង ពី លោក កែវ រតនៈ ពិសេស មាន ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ពីសំណាក់ អភិបាល ខេត្ត គ្រប់ ជំនាន់ និង អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ដោយ ហេតុ ថា ការបង្កើត រមណីយដ្ឋាន នេះ ឡើង គឺ បាន ជួយ ការពារ ព្រៃឈើ ធម្មជាតិ និង សត្វ ព្រៃ ឱ្យ នៅ គង់វង្ស ទប់ស្កាត់ ការកាប់ ទន្ទ្រាន ដី ព្រៃ ខុស ច្បាប់ ពីសំណាក់ ជន ខិលខូច មួយចំនួន ។
លោក អេង គន្ធា បាន បន្ថែម ថា ក្នុង រយៈពេល ជិត ០៤ ឆ្នាំ មក នេះ លោក បាន ចំណាយ ថវិកា សរុប រួម ប្រមាណ ជិត ៤លាន ដុល្លារ ដែល បាន មក តាមរយៈ ការគៀង គរ ពី សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន រួមទាំង ថវិកា បដិភាគ របស់ លោក ផ្ទាល់ ដើម្បី ធ្វើ ការអភិវឌ្ឍន៍ តំបន់ នេះ ក្នុង ន័យ ទាក់ទាញ ភ្ញៀវ ទេសចរ និង ផ្តល់ កន្លែង ដើរលេង កម្សាន្ត លំហែ អារម្មណ៍ បែប ធម្មជាតិ ដោយ ឥត គិត ថ្លៃ អាច ឱ្យ ប្រជាពលរដ្ឋ បាន សិក្សា ស្វែងយល់ អំពី វប្បធម៌ ប្រវត្តិសាស្ត្រ ដែល មាន នៅ ទីតាំង នេះ ។
លោក បាន បញ្ជាក់ បន្ថែម ថា សម្រាប់ សមិទ្ធផល ថ្មី ដែល ត្រូវ សម្ពោធ ឆ្លង នា ពេលនេះ គឺ មាន តម្លៃ ប្រមាណ ជិត ៣០ម៉ឺន ដុល្លារ រួម មាន ផ្ទះ សាង ស្នេហ៍ សួន ផ្កា ទឹក រាំ ព្រះពុទ្ធរូប ចំនួន ១៦៨ អង្គ រូបសំណាក ព្រះគោ ព្រះកែវ រូបសំណាក គូរ ស្នេហ៍ ចាស់ ព្រឹទ្ធាចារ្យ និង រូបសំណាក សត្វ កម្រ ដែល ជិត ផុត ពូជ មួយចំនួន ទៀត ។ អ្វី ៗ ដែល កើតមាន សព្វ ថ្ងៃ នេះ គឺ ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព ដូច្នេះហើយ យើង ត្រូវ រួមគ្នា ថែរក្សា សន្ដិភាព ឱ្យ នៅ គង់វង្ស ជារៀងរហូត ត រៀង ទៅ ។
ជាមួយគ្នា នោះ លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ក៏ ដូចជា ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ សូម ចូលរួម ទស្សនា កម្សាន្ត ឱ្យ បាន ច្រើន កុះករ ក្នុង ឱកាស ទិវា ចូល ឆ្នាំ សាកល ២០២៣ ឈាន ចូល ២០២៤ និង ខួប លើក ទី៤៥ នៃ ទិវា ជាតិ ជ័យ ជំនះ ៧ មករា ខាងមុខ នេះ ផងដែរ ៕ អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន៖ សេរីភាព សារព័ត៌មាន កម្ពុជា មិន ឋិតនៅលើ ការនិយាយ របស់ អ្នកណា ឬ ក្រុម ណាមួយ នោះ ទេ ជាពិសេស សកម្មភាព ទាំងឡាយ ណា ដែល មាន ចរិត និង របៀបវារៈ នយោបាយ
( ភ្នំពេញ ) ៖ លោក ទេព អស្នារិទ្ធ អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន ឆ្លើយតប ទៅនឹង ការលើកឡើង របស់ សម្ព័ន្ធ អ្នកសារព័ត៌មាន កម្ពុជា ហៅ កាត់ ថា ខេមបូចា (Camboja) ថា សេរីភាព សារព័ត៌មាន មិន ឋិតនៅលើ ការនិយាយ របស់ អ្នកណា ឬ ក្រុម ណាមួយ នោះ ទេ ជាពិសេស សកម្មភាព ទាំងឡាយ ណា ដែល មាន ចរិក និង របៀបវារៈ នយោបាយ ។
អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន រូប នេះ បាន បញ្ជាក់ ថា សិទ្ធិ សេរីភាព សារព័ត៌មាន សិទ្ធិ ក្នុង ការបញ្ចេញមតិ និង ទទួលបាន ព័ត៌មាន នៅ កម្ពុជា ត្រូវបាន លើកកម្ពស់ ដោយ រាជ រដ្ឋាភិបាល ពី អាណត្តិ មួយ ទៅ អាណត្តិ មួយ ជារៀងរហូតមក ជាពិសេស ក្នុង អាណត្តិ ទី ៧នេះ តែម្តង ។
ជាមួយគ្នា នេះ ដែរ លោក ទេព អស្នារិទ្ធ ក៏ សូម អរគុណ ដល់ បងប្អូន អ្នកសារព័ត៌មាន ដែល កន្លងមក បាន អនុវត្ត ក្រមសីលធម៌ វិជ្ជាជីវៈ សារព័ត៌មាន បាន ល្អ និង បាន ប្រកប ការងារ ដោយ មិន បំពាន លើស តួនាទី ខ្លួន ជា អ្នកសារព័ត៌មាន មិន បំពាន លើ សិទ្ធិ កិត្តិយស សេចក្តីថ្លៃថ្នូរ របស់ អ្នកដទៃ និង បាន គោរព កាតព្វកិច្ច របស់ ខ្លួន ក្នុង ដែន ដែល ច្បាប់ បាន កំណត់ » ។
បន្ថែម ពី នេះ លោក សូម លើកទឹកចិត្ត ដល់ អ្នកសារព័ត៌មាន ទាំងអស់ ឱ្យ បន្ត ពង្រឹង សមត្ថភាព ជំនាញ និង ប្រកាន់ខ្ជាប់ នូវ ការអនុវត្ត ក្រមសីលធម៌ វិជ្ជាជីវៈ សារព័ត៌មាន ត្រូវ កសាង ទំនាក់ទំនង ល្អ ជាមួយ ប្រភព ព័ត៌មាន ក្នុង នោះ មាន អ្នកនាំពាក្យ តាម ក្រសួង - ស្ថាប័ន អាជ្ញាធរ មាន សមត្ថកិច្ច និង ភាគី ផ្សេង ៗ ទៀត ដើម្បី បំពេញ តួនាទី វិជ្ជាជីវៈ របស់ ឱ្យ មាន ប្រសិទ្ធភាព ៕ លទ្ធផល ប្រកួត វាយ កូនគោល ពាន សម្ដេច តេជោ ហ៊ុន សែន លើក ទី៧ ដែល មាន ថ្នាក់ដឹកនាំ ជាច្រើន ចូលរួម
( ភ្នំពេញ ) ៖ ការប្រកួត កីឡា វាយ កូនគោល ដណ្ដើម ពានរង្វាន់ សម្ដេច តេជោ ហ៊ុន សែន លើក ទី៧ ឆ្នាំ ២០២៣ បាន បញ្ចប់ ដោយ ជោគជ័យ ក្រោយ ដំណើរ ការប្រកួត នៅ ថ្ងៃទី៣០ ខែធ្នូ នេះ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រមទាំង វត្តមាន ថ្នាក់ដឹកនាំ ជាច្រើន ទៀត ។
លោក នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ប្រធាន គណៈកម្មការរៀបចំ ការប្រកួត មានប្រសាសន៍ ថា ព្រឹត្តិការណ៍ នេះ រៀបចំឡើង ក្នុង ឱកាស ដ៏ វិសេសវិសាល ដើម្បី ចូលរួម អបអរសាទរ ខួប ២៥ ឆ្នាំ នៃ ការបញ្ចប់ សង្រ្គាម ស៊ីវិល នៅ កម្ពុជា ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន មគ្គុទេស ឯក សន្តិភាព ក្រោយ ទទួលបាន ការអនុញ្ញាត ដ៏ ខ្ពង់ខ្ពស់ ពី សម្តេច តេជោ ដោយ មាន កីឡាករ ចូលរួម សរុប ៩៧ នាក់ ។
ជាមួយគ្នា ដែរ ក្នុង នាម គណៈកម្មការរៀបចំ ការប្រកួត លោក បាន គោរព ថ្លែងអំណរគុណ ជូន សម្តេច តេជោ ដែល បាន ចំណាយ ពេលវេលា ដ៏ មាន តម្លៃ អញ្ជើញ ជា អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ ក្នុង ព្រឹត្តិការណ៍ ដ៏ មាន អត្ថន័យ នេះ និង ថ្លែងអំណរគុណ សម្តេច ក្រឡាហោម ស ខេង . សម្តេច ពិជ័យ សេនា ទៀ បាញ់ . លោក កែ គឹម យ៉ាន . លោក ជា សុផារ៉ា ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ និង ថ្នាក់ដឹកនាំ ជាច្រើន ទៀត ដែល បាន អញ្ជើញ ចូលរួម ក្រោម បរិយាកាស រីករាយ ស្និទស្នាល និង អធិកអធម ក្រៃលែង ។
សមិទ្ធផល ដ៏ ធំធេង ជា ប្រវត្តិសាស្រ្ត នេះ កើត ចេញ ពី សន្តិភាព ក្រោម នយោបាយ ឈ្នះ ឈ្នះ តេជោ សែន ដែល បាន បញ្ចប់ សង្គ្រាម ស៊ីវិល ទាំងស្រុង នៅ កម្ពុជា រហូត ទទួលបាន សុខ សន្តិភាព និង ការឯកភាព ជាតិ ពេញលេញ និង ធ្វើឲ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ គ្រប់ វិស័យ ។ សម្តេច តេជោ ជា គំរូ នៃ ការលះបង់ ដ៏ ថ្លៃថ្លា បំផុត ដើម្បី ធានា ភាព បន្ត វេន នៃ ការដឹកនាំ ប្រកបដោយ សុវត្ថិភាព និង ភាពជឿជាក់ ៕
កម្មវិធី បណ្តុះបណ្តាល ជំនាញ ១. ៥លាន នាក់៖ ក្រសួង ការងារ នឹង បើក វេសនកាល ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៥ ខែមករា
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ នឹង បើក បវេសនកាល សម្រាប់ វគ្គ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ នៅ ទូទាំង ប្រទេស នា ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២៣ ខណៈ មាន អ្នក ចុះឈ្មោះ ចូលរៀន ប្រមាណ ជិត ២ម៉ឺន នាក់ ។
លោក កត្តា អ៊ន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ បាន ឱ្យដឹង ថា វិទ្យាស្ថាន បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ ទាំងអស់ ដែល ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ ក្រសួង ការងារ នឹង បើក បវេសន កាល ព្រម គ្នា នៅ ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដើម្បី ផ្តើម ការបណ្តុះបណ្តាល វគ្គ ទី១ ។
លោក បន្ថែម ថា៖ « កម្មវិធី បើក បវេសនកាល ធំ គឺ ធ្វើឡើង នៅ វិទ្យាស្ថាន ជាតិ ពហុ បច្ចេកទេស កម្ពុជា (NPIC) នៅ ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២៤ ខាងមុខ ដែល ជា និមិត្តរូប នៃ ការបើក វគ្គ បណ្តុះបណ្តាល នូវ ទូទាំង ប្រទេស នៃ កម្មវិធី ថ្នាក់ ជាតិ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ប្រកាស ដាក់ ចេញ ឱ្យ អនុវត្ត កាលពី ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដោយ សម្តច មហា បវរធិបតី ហ៊ុន ម៉ាណែត » ។
លោក អ្នកនាំពាក្យ បាន រំលឹក ថា ដើម្បី ទទួលបាន សិស្ស ចុះឈ្មោះ ចូលរៀន មន្ត្រី ក្រសួង គ្រប់ ជាន់ ថ្នាក់ និង វិទ្យាស្ថានទូទាំង ប្រទេស បាន ចេញ យុទ្ធនាការ គោះ ទ្វា គ្រប់ ខ្នង ផ្ទះ នៅ គ្រប់ ច្រកល្ហក និង ទីប្រជុំជន ដើម្បី ប្រកាស និង ពន្យល់ ពី កម្មវិធី ថ្នាក់ ជាតិ ធ្វើ យ៉ាងណា ឱ្យ ក្រុម យុវជន គោលដៅ ចុះឈ្មោះ ចូលរៀន ។
កម្មវិធី ប្រកួតប្រជែង នេះ រៀបចំឡើង ដោយ ផ្អែក លើ លក្ខណៈ ពិសេស ដូច ជា៖ ការតុបតែង រចនាលម្អ . អនាម័យ និង បរិស្ថាន . សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ . ភាព ពេញចិត្ត និង ការសប្បាយរីករាយ របស់ ភ្ញៀវ ទេសចរ និង អ្នកចូលរួម ។
វណ្ណៈ ផ្សេង ៗ គ្នា និង ក្រុម មនុស្ស ខុសគ្នា របស់ ប្រទេស ចិន រំលឹក គុណ លោក ម៉ៅ សេតុង មួយ ផ្នែក គឺ ដោយសារ ភាព ទាក់ទាញ របស់ លោក ផ្ទាល់ខ្លួន មូលហេតុ សំខាន់ មួយ ទៀត គឺ ដោយសារ លោក ម៉ៅ សេតុង បាន លើកឡើង នូវ លក្ខណៈ និង កម្មវត្ថុ របស់ បក្ស កុម្មុយនីស្ត ចិន គឺ បម្រើ ប្រជាជន នេះ ជា សញ្ញា ឫសគល់ ដែល បក្ស កុម្មុយនីស្ត ចិន ខុសពី គណបក្ស នយោបាយ ដទៃ ទៀត ហើយក៏ ជាតិច និក សម្រាប់ បក្ស កុម្មុយនីស្ត ចិន ក្នុង ការកាន់អំណាច ក្នុង រយៈពេល យូរ ផងដែរ ។
បម្រើ ប្រជាជន សំដៅ ទៅ លើ ” គំនិត និង ការអនុវត្ត ដែល ធ្វើការ ដើម្បី ផលប្រយោជន៍ របស់ ប្រជាជន ” ។ វា ត្រូវបាន ដាក់បញ្ចូល ទៅក្នុង លក្ខន្ដិកៈ របស់ បក្ស ហើយក៏ ត្រូវបាន ដាក់បញ្ចូល ទៅក្នុង រដ្ឋធម្មនុញ្ញា របស់ ប្រទេស ចិន ផងដែរ ដែល បាន ក្លាយទៅជា ភារកិច្ច ដែល កំណត់ ដោយ ច្បាប់ នៃ ស្ថាប័ន គណៈ បក្ស គ្រប់ ស្រទាប់ ជាន់ ថ្នាក់ និង បុគ្គលិក ការងារ នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី សមាជិក ព្រឹទ្ធសភា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក កំពង់ស្វាយ នា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ បាន ដឹកនាំ ក្រុមការងារ ចុះ ចែក សម្ភារ សិក្សា ដល់ សិស្សានុសិស្ស មាន ជីវភាព ខ្វះខាត នៅ ឃុំ នី ពេជ្រ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ចំនួន ៩៦ នាក់ ។
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី ឃួន ឃុន ឌី បាន លើកឡើង ថា ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្ដេច បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី បាន ធ្វើឲ្យ ប្រទេសជាតិ ទាំងមូល មាន សុខ សន្តិភាព ស្ថេរភាព នយោបាយ និង កំណើន សេដ្ឋកិច្ច ព្រមទាំង ផ្ដល់ សិទ្ធិ សេរីភាព គ្រប់ បែបយ៉ាង ដល់ ប្រជាពលរដ្ឋ ក្នុង ការរស់នៅ ប្រកបរបរ ទទួលទាន ប្រចាំ ថ្ងៃ ក្រោម ម្លប់ សន្តិភាព ។
លោកស្រី ឃួន ឃុន ឌី បាន ក្រើន រំលឹក ដល់ សិស្សានុសិស្ស ទាំងអស់ ត្រូវតែ ខិតខំ សិក្សា រៀនសូត្រ និង មិន ត្រូវ បោះបង់ ការសិក្សា ឡើយ ជាពិសេស ត្រូវ ជៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន និង សំណូមពរ ដល់ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ ធ្វើ យ៉ាងណា រក្សា ឲ្យបាន នៅ ភូមិ ឃុំ មាន សុវត្ថិភាព ជូន ដល់ ប្រជាពលរដ្ឋ និង ខិតខំ ដោះស្រាយ បញ្ហា ផ្សេង ៗ ដែល ជា ការថ្នាំង ថ្នាក់ ដល់ ពួកគាត់ ឲ្យបាន ទាន់ ពេល វេលា ។
គួរ បញ្ជាក់ ថា សម្ភារ សិក្សា សម្រាប់ ចែកជូន ដល់ សិស្សានុសិស្ស ៩៦ នាក់ ក្នុង នោះ មាន កាតាប សៀវភៅ ប៊ិច ខ្មៅដៃ បន្ទាត់ ជ័រ លុប ផងដែរ ៕
សិប្បកម្ម កែច្នៃ សត្វ ជន្លេន នាំចេញ ទៅ ក្រៅ ប្រទេស មួយ នេះ មាន ទីតាំង ស្ថិត នៅក្នុង ភូមិ អូរ សណ្ដាន់ ចាស់ ឃុំ ទឹក ហូត ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង អាច ផលិត និង កែច្នៃ សត្វ ជន្លេន ដែល ជា ផលិតផល កែច្នៃ ដ៏ កម្រ មួយ នេះ ក្នុង មួយ ថ្ងៃ បាន រហូត ទៅដល់ ១០តោន ឯណោះ ទៅ តាម រដូវកាល សំបូរ សត្វ ជន្លេន ។
លោក ឌឿ ពៅ អាយុ ៥៦ ឆ្នាំ ជា ម្ចាស់ សិប្បកម្ម កែច្នៃ សត្វ ជន្លេន ខាងលើ នេះ បាន រៀបរាប់ប្រាប់ អណ្ដាញ ព័ត៌មាន Fresh News កាលពី ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ ថា ការបើក សិប្បកម្ម កែច្នៃ សត្វ ជន្លេន ស្រស់ ខាងលើ នេះ គាត់ ទើបតែ ចាប់ផ្ដើម ដំណើរការ ជាង មួយ ឆ្នាំ តែ ប៉ុណ្ណោះ ។ ដំបូង ឡើយ គ្រួសារ របស់ គាត់ បាន ដឹក សត្វ ជន្លេន ស្រស់ យក ទៅ លក់ ឱ្យ អ្នក ដាក់ សន្ទូច នៅ ម្ដុំ មាត់ ទន្លេ ផ្សារ ក្រោម ដែល របរ មួយ នេះ គាត់ បាន ធ្វើ អស់ រយៈពេល ជាច្រើន ឆ្នាំ កន្លងមក ហើយ ។
លុះ ក្រោយមក បន្ទាប់ពី គាត់ បាន ឃើញ សិប្បកម្ម កែច្នៃ សត្វ ជន្លេន ស្រស់ ដែល មាន គេ បើក ធ្វើ នៅក្នុង មូលដ្ឋាន គាត់ ក៏ បាន លួច ដកស្រង់ បទពិសោធន៍ និង បច្ចេកទេស នេះ មក បើក ជា សិប្បកម្ម កែច្នៃ សត្វ ចន្លេន ស្រស់ ដោយ ខ្លួន ឯង ម្ដង វិញ ។ ដំបូង ដោយ បាន ចាប់ផ្ដើម ម្តង បន្តិច ៗ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ដែល មាន កម្មករ បម្រើការ នៅក្នុង សិប្បកម្ម របស់ បង ប្រុស ជាច្រើន នាក់ ផងដែរ ។
បង ប្រុស បាន បញ្ជាក់ បន្ថែម ទៀត ថា ចំពោះ សិប្បកម្ម កែច្នៃ សត្វ ជន្លេន របស់ បង ប្រុស បើ ក្នុង រដូវ វស្សា ដែល សម្បូរ សត្វ ជន្លេន វិញ គឺ ប្រជាពលរដ្ឋ អាច យក សត្វ ជន្លេន មក លក់ ឲ្យ បង ប្រុស ក្នុង មួយ ថ្ងៃ មាន រហូត ទៅដល់ ១០តោន ចំពោះ តម្លៃ ជន្លេន ស្រស់ សម្រាប់ ខែ វស្សា ដែល សំបូរ សត្វ ជន្លេន បង ប្រុស ទិញ ពី ប្រជាពលរដ្ឋ ក្នុង មួយ គីឡូក្រាម ពី ៣.០០ ០ទៅ ៣.៥០០ រៀល ចំពោះ រដូវ ដែល សម្បូរ សត្វ ជន្លេន គឺ មាន រយៈ ពី ៥ខែ ទៅ ៦ខែ ក្នុង មួយ ឆ្នាំ ។
( កំពង់ចាម ) ៖ លោក បណ្ឌិត ម៉ឹង មករា ប្រធាន សមាគម យុវជន ក្រុម៨ អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ចែក អំណោយ ជូន គ្រួសារ ក្រីក្រ ចំនួន ១០៩ គ្រួសារ និង គ្រូបង្រៀន ព្រមទាំង សិស្សានុសិស្ស ចំនួន ៨៨ នាក់ នៅ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម ។
ចំពោះ អំណោយ ចែកជូន គ្រូបង្រៀន ៦នាក់ រួម មាន៖ ប៊ិច ៥ដើម សៀវភៅ ៥ក្បាល ដប ទឹក១ កាបូប យួរ១ នឹង ថវិកា ១០ម៉ឺន រៀល ក្នុង ម្នាក់ ៗ ។ ចំពោះ សិស្សានុសិស្ស ៨២ នាក់ ម្នាក់ ៗ ទទួលបាន ខ្មៅដៃ ៥ដើម បណ្តូល ខ្មៅដៃ ៥បន្ទះ ប៊ិច ៥ដើម សៀវភៅ ១ក្បាល និង កាបូប ប៊ិច១ ។
អំណោយ ដែល ចែកជូន ក្នុង ពិធី នេះ ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី តាមរយៈ សមាគម យុវជន ក្រុម ៨ ។
លោក បណ្ឌិត ម៉ឹង មករា បាន ពាំនាំ ការសួរសុខទុក្ខ និង ការនឹករលឹក ពី សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជូន ចំពោះ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល មាន វត្តមាន ក្នុង កម្មវិធី នេះ ។
ក្រោម ការដឹកនាំ លោក បណ្ឌិត ម៉ឹង មករា ប្រធាន សមាគម យុវជន ក្រុម៨ បាន រួមចំណែក ចុះ ជួយ ប្រជាពលរដ្ឋ រួម មាន៖ ការកសាង ផ្លូវថ្នល់ សាលារៀន មន្ទីរពេទ្យ វត្ត អារាម ទំនប់ ទឹក ប្រឡាយ ទឹក ស្រះ ទឹក ការដាំ កូន ឈើ ព្រមទាំង ការងារ សេដ្ឋកិច្ច សង្គម រួម មាន វិស័យ សុខាភិបាល វិស័យ អប់រំ ជាពិសេស វិស័យ កសិកម្ម ដែល ជា សសរ ស្ដម សេដ្ឋកិច្ច ជាតិ ដ៏ មាន សារៈសំខាន់ សម្រាប់ គ្រួសារ ប្រជាពលរដ្ឋ នៅ ជនបទ ៕
គួរ បញ្ជាក់ ថា ក្រុម ហ៊ូទី យេម៉ែន ដែល មាន អ៉ីរ៉ង់ ជា ខ្នង បង្អែក បាន អះអាង ថា ការវាយប្រហារ របស់ ខ្លួន លើកប៉ាល់ ដឹក ទំនិញ ក្នុង តំបន់ សមុទ្រ ក្រហម គឺជា ការបង្ហាញ សាមគ្គីភាព ជាមួយ ប្រជាជន ប៉ាឡេស្ទីន ក្នុង តំបន់ ហ្កាហ្សា ជា ទី ដែល អ៉ី ស្រាអែល កំពុង ធ្វើ សង្រ្គាម ប្រឆាំង នឹង ក្រុមហាម៉ាស ។ ក្រុម ហ៊ូទី ក៏ បាន ព្រមាន ដែរ ថា នឹង បន្ត បើក ការវាយប្រហារ បើ ទោះជា សហរដ្ឋ អាមេរិក បាន បង្កើត ក្រុម ចម្រុះ មួយ ដើម្បី រក្សា សន្តិសុខ និង ការពារ សុវត្ថិភាព ការធ្វើ នាវា ចរ ក្នុង តំបន់ សមុទ្រ ក្រហម ក៏ដោយ ៕
យល់ដឹង ពី ជំនួញ៖ រាជ រដ្ឋាភិបាល ទម្លាក់ ឥណទាន ៥០លាន ដុល្លារ សម្រាប់ ជួយ ដល់ អ្នករក ស៉ី ក្នុង វិស័យ ទេសចរណ៍ នៅ ខេត្ត សៀមរាប . អាច ខ្ចី បាន ដល់ ៦០ ម៉ឺន ដុល្លារ ការប្រាក់ ៦.៥% ក្នុង ១ ឆ្នាំ !
លោក បណ្ឌិត បញ្ជាក់ ទៀត ថា ការផ្តល់ កម្ចី ត្រូវបាន អនុវត្តន៍ ចាប់តាំងពី ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្រោយ ការប្រកាស ដាក់ ចេញ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន លើក ទី១៩ ។
ការបញ្ជាក់ របស់ បណ្ឌិត លឹម អូន ធ្វើឡើង នៅក្នុង សិក្ខាសាលា និង សន្និសីទ សារព័ត៌មាន ស្តីពី « កម្មវិធី កម្ចី ដោយ ផ្ទាល់ ដល់ ប្រតិបត្តិករ ទេសចរណ៍ នៅ ខេត្ត សៀមរាប » នា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ ។
កម្មវិធី កម្ចី ដោយ ផ្ទាល់ ដល់ ប្រតិបត្តិករ ទេសចរណ៍ ខេត្ត សៀមរាប មាន លក្ខណៈ ពិសេស និង ប្រកបដោយ លក្ខខណ្ឌ អនុគ្រោះ មួយចំនួន ដូចជា៖ រយៈពេល អនុគ្រោះ បង់ប្រាក់ ដើម រហូតដល់ ២៤ ខែ . មិន គិត ថ្លៃ សោហ៊ុយ រៀបចំ ឥណទាន និង មិន មាន ពិន័យ ចំពោះ ការសង ត្រឡប់ មុន កាល កំណត់ ព្រមទាំង ផ្តល់ នូវ លក្ខខណ្ឌ នៃ ការអនុម័ត ប្រាក់ កម្ចី មាន ភាពទន់ភ្លន់ ជាង ឥណទាន ធម្មតា ។
លោកស្រី ឆាយ ស៊ីវលីន ប្រធាន សមាគម ទេសចរណ៍ កម្ពុជា បាន ឱ្យដឹង ថា កញ្ចប់ ថវិការ បឋម ៥០ លាន ដុល្លារ អាមេរិក ជា កញ្ចប់ ថវិការ លើក ទី២ ហើយ ដែល សបញ្ជាក់ ពី ការគិតគូរ និង កាយវិការ នៃ ការយកចិត្តទុកដាក់ ខ្ពស់ ពី សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ក្នុង ការជំរុញ វិស័យ ទេសចរណ៍ ជាពិសេស ខេត្ត សៀមរាប ។
លោកស្រី ជឿជាក់ យ៉ាង មុតមាំ ថា ប្រតិបត្តិករ ទេសចរណ៍ សៀមរាប នឹង ប្រើប្រាស់ កម្ចី នេះ ប្រកបដោយ ទំនួល ខុសត្រូវ និង ភាពច្នៃប្រឌិត ក្នុង ការធ្វើ ប្រតិបត្តិការ អាជីវកម្ម . ការកែលម្អ និង ធ្វើ ទំនើបកម្ម ដូចជា ធ្វើ ពិពិធកម្ម នៃ សេវា ទេសចរណ៍ របស់ ខ្លួន សំដៅ ទាក់ទាញ និង ទទួល ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ បាន កាន់តែ ប្រសើរឡើង មួយ កម្រិត ទៀត ។
សូម ជម្រាប ថា ដើម្បី ជួយ ដល់ វិស័យ ទេសចរណ៍ រាជ រដ្ឋាភិបាល ក៏ បាន អនុគ្រោះ ថ្លៃ លក់ អគ្គិសនី សម្រាប់ បរិមាណ អគ្គិសនី ដែល ប្រើប្រាស់ លើស ពី មធ្យម ភាគ ក្នុង រយៈពេល ៣ខែ ( ពី ខែធ្នូ ឆ្នាំ ២០២៣ ដល់ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ) ដើម្បី ជំរុញ ឱ្យ អ្នក ធ្វើ អាជីវកម្ម ក្នុង វិស័យ ទេសចរណ៍ នៅក្នុង រដូវ ចុង ឆ្នាំ ២០២៣ និង ដើម ឆ្នាំ ២០២៤ ។
ប្រតិកម្ម របស់ រដ្ឋាភិបាល ចិន ធ្វើឡើង តាមរយៈ ការិយាល័យ ចិន ទទួល កិច្ចការ តៃវ៉ាន់ ជា ការឆ្លើយតប ទៅនឹង ការកត់សម្គាល់ ខាងលើ របស់ លោក Lai Ching-te នៅក្នុង វេទិកា ត ស៊ូ មតិ មួយ ផ្សាយ ផ្ទាល់ តាម កញ្ចក់ ទូរទស្សន៍ កាលពី ថ្ងៃសៅរ៍ ទី៣០ ខែធ្នូ ម្សិលមិញ នេះ ។
( ភ្នំពេញ ) ៖ គណបក្ស ខ្មែរ តែ មួយ សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
( ឧត្តរមានជ័យ )៖ លោក រដ្ឋមន្ត្រី ជា វ៉ាន់ ដេត បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ សមិទ្ធផល ថ្មី និង សំណេះសំណាល សួរសុខទុក្ខ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន កងពល ថ្មើរជើង លេខ ៤១ យោធ ភូមិភាគ ទី៤ នៅ ទីបញ្ជាការវរសេនា តូច លេខ ៤១៣ ស្ថិត នៅ ឃុំ ជប់គគីរ ស្រុក អង្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ។
ពិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពី ឯកឧត្តម លោកជំទាវ ជា ថ្នាក់ដឹកនាំ ក្រសួង តំណាង ក្រុមហ៊ុន សុភ័ក្រនីការ អ៊ីន វេស មិន គ្រុប ខូ អិលធីឌី អាជ្ញាធរ មូលដ្ឋាន ពាក់ព័ន្ធ គ្រប់ ជាន់ ថ្នាក់ ពល ទាហាន និង គ្រួសារ កងទ័ព សរុប ប្រមាណ ៧៩៥ នាក់ ៕
រដ្ឋបាល ខេត្ត កែប បង្ហោះ ខ្លែង ១៤០ ខ្លែង អបអរសាទរ ព្រឹត្តិការណ៍ ឆ្លង ឆ្នាំ សកល និង អបអរសាទរ ខួប លើក ទី៤៥ នៃ ទិវា បុណ្យ ជាតិ ជ័យ ជំនះ ៧មករា
( កែប) ៖ រដ្ឋបាល ខេត្ត កែប នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ បាន បង្ហោះ ខ្លែង ១៤០ ខ្លែង អបអរសាទរ ព្រឹត្តិការណ៍ ឆ្លង ឆ្នាំ សកល និង អបអរសាទរ ខួប លើក ទី៤៥ នៃ ទិវា បុណ្យ ជាតិ ជ័យ ជំនះ ៧មករា ។ នេះ បើ តាម លោក តុង ភោ ប្រធាន មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ ខេត្ត កែប ។
លោក បាន ឲ្យដឹង ថា ខ្លែង ដែល បាន ចូលរួម សរុប ចំនួន ១៤០ ខ្លែង ក្នុង នោះ ខ្លែង ឯក ចំនួន ៤០ និង ខ្លែង ច្នៃប្រឌិត គ្រប់ ប្រភេទ ចំនួន ១០០ ខ្លែង ។ ខ្លែង ដែល មាន លក្ខណៈ វិនិច្ឆ័យ ល្អ ( សោភណភាព បង្ហើរ ឡើង ដាក់ចុះ សម្លេង ឯក ) ទទួលបាន ចំណាត់ថ្នាក់ ជ័យលាភី លេខ ១ លេខ ២ និង លេខ ៣ អម ដោយ ថវិកា និង រង្វាន់ លើកទឹកចិត្ត ដល់ ខ្លែង ដែល បាន ចូលរួម ទាំងអស់ ៕ ទឹក ជំនន់ លិច ផ្លូវ ក្រោម ដី ក្បែរ ទីក្រុង ឡុងដ៏ ប៉ះពាល់ ដល់ សេវាកម្ម រថភ្លើង
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ គណបក្ស ខ្មែរ សាធារណរដ្ឋ សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
( ភ្នំពេញ ) ៖ គណបក្ស ខ្មែរ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរ ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ក្រោម ការសម្រេចចិត្ត ដ៏ វៃ ឆ្លាត របស់ សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា សម្ដេច បាន មានប្រសាសន៍ បញ្ជាក់ ថា កម្ពុជា មិន បាច់ បង្កើត ទិវា សន្តិភាព ទៀត នោះ ទេ គឺ កំណត់ យក ថ្ងៃទី ២៩ ខែ ធ្នូ ទិវា សន្តិភាព នៅ កម្ពុជា ។ អស់ រយៈពេល កន្លងមក កម្ពុជា ជា ប្រទេស រង នូវ សោនាដកម្ម យ៉ាង ខ្លោចផ្សារ ជា ទីបំផុត ដោយសារតែ ភ្លើង សង្គ្រាម ។
ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ស្ថាបនិក និង ជា អគ្គ មគ្គុទ្ទេសក៍ ឯក បាន ធ្វើ អោយ កម្ពុជា បិទ បញ្ចប់ ភ្លើង សង្គ្រាម រកឃើញ សុខ សន្តិភាព ជាពិសេស បាន បិទ បញ្ចប់ ទំព័រ ខ្មៅ ងងឹត នៃ ការបែកបាក់ ជាតិ ក្នុង រយៈ ពេល តិច បំផុត ៥០០ ឆ្នាំ ។ ផ្តើម ពី សុខ សន្តិភាព និង ការឯកភាព ជាតិ ទាំងស្រុង នា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ជា បុព្វហេតុ ដ៏ ធំធេង នាំអោយ កម្ពុជា សម្រេចបាន នូវ ការកសាង ជាតិ អោយ រីកចម្រើន ប្រជាពលរដ្ឋ រស់ នៅ ប្រកបដោយ សុខ សុភមង្គល ដូច ពេល បច្ចុប្បន្ន នេះ ។
គណបក្ស ខ្មែរ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច សូម ធ្វើ ការគាំទ្រ ទាំងស្រុង ចំពោះ ប្រសាសន៍ របស់ សម្តេច មហា បវរ ធិបតី ហ៊ុន ម៉ាណត ក្នុង ការយក ថ្ងៃទី ២៩ ខែធ្នូ ជា ទិវា សន្តិភាព នៅ កម្ពុជា ។ ប្រសាសន៍ របស់ សម្តេច នេះ គឺ បាន បង្ហាញ ពិលោក អោយ ឃើញ កាន់តែ ច្បាស់ ថា កម្ពុជា គឺជា ប្រទេស ពោ ពេញ ដោយ សន្តិភាព ពេញលេញ ឯករាជ បូរណៈ ភាព ទឹកដី អធិបតេយ្យភាព បោះជំហាន លើ វិស័យ អភិវឌ្ឍន៍ ជាតិ សេដ្ឋកិច្ច ប្រជាពលរដ្ឋ និង សង្គម ជា ចំបង ។
គណបក្ស ខ្មែរ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្ឃឹម យ៉ាង មុតមាំ ថា ទិវា សន្តិភាព មួយ នេះ អាច ជា កម្លាំងចិត្ត ដ៏ មោះ មុត មួយ ប្រយោជន៍ ដល់ ខ្មែរ គ្រប់ រូប ប្តូរ ចេញ ពី ទស្សនៈ នយោបាយ ផ្តួលរំលំ វាយប្រហារ ខ្មែរ គ្នាឯង បោះជំហាន ទៅ លើ វិស័យ អភិវឌ្ឍន៍ ទាំង ធនធាន មនុស្ស និង ធនធាន សេដ្ឋកិច្ច បែប ប្រជាធិបតេយ្យ ដូច ទៅនឹង បណ្តា ប្រទេស ដ៏ ទៃ ដែល កំពុង ធ្វើ ការអភិវឌ្ឍន៍ លើ សកលលោក ៕
គណបក្ស នគរ ប្រជាធិបតេយ្យ គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា គណបក្ស នគរ ប្រជាធិបតេយ្យ សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ សម្ព័ន្ធភាព បណ្តុំ សមាគម អង្គការ សង្គម ស៊ីវិល និង សមាគម - អង្គការ ចំនួន ១៦ អង្គភាព សូម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ខេត្ត បាត់ដំបង រៀបចំ ការប្រកួត កីឡា ទូក ប្រពៃណី ខ្នាត អន្តរជាតិ « ទូក នាគ ទូក កានូ- កាយ៉ាក់ និង ទូក រ៉ូអ៊ីង » ជ្រើសរើស ជើងឯក ថ្នាក់ ជាតិ « ពានរង្វាន់ សម្តេច ក្រឡាហោម ស ខេង » លើក ទី១០ ឆ្នាំ ២០២៣
លោក សុខ លូ បាន ថ្លែង ថា ក្នុង នាម តំណាង សម្តេច ក្រឡាហោម ស ខេង ខេត្ត បាត់ដំបង បាន ចូលរួម កិច្ចសហការ សម្របសម្រួល ញ៉ាំង ឲ្យ កម្មវិធី នេះ បាន ដំណើរការ ប្រកបដោយ រលូន ។ លោក សូមស្វាគមន៍ ដល់ ប្រតិភូ គ្រូបង្វឹក កីឡាករ កីឡាការិនី អ្នកសារព័ត៌មាន និង បងប្អូន ទស្សនិកជន ទាំងអស់ ។
តាមរយៈ ការអភិវឌ្ឍ នេះ បាន បង្ក បរិយាកាស ដល់ ការវិនិយោគ កាន់តែ ប្រសើរឡើង ព្រមទាំង បាន ចូលរួម ចលនា ប្រឡង ប្រណាំង ទីក្រុង ស្អាត ដែល ខេត្ត បាត់ដំបង បាន ទទួល ពានរង្វាន់ និង ជ័យលាភី ជា បន្តបន្ទាប់ ព្រមទាំង បាន បង្ក លក្ខណៈ ជូន បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ បាន សប្បាយរីករាយ ក្រោម ដំបូល សន្តិភាព ។
( ភ្នំពេញ ) ៖ នៅក្នុង ជំនួប សំណេះសំណាល លើក ដំបូង ជាមួយនឹង បងប្អូន កម្មករ និយោជិត លើក ដំបូង ដែល រៀបចំឡើង ក្នុង តំបន់ ព្រៃ ស្ពឺ ក្នុង នាម ជា នាយក រដ្ឋមន្ត្រី កម្ពុជា កាលពី ថ្ងៃទី ២៩ សីហា ២០២៣ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ផ្តល់ អនុសាសន៍ ១០ ចំណុច ដោយ ក្នុង នោះ មាន កិច្ចការ អាទិភាព ចំនួន ៦ចំនុច សម្រាប់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ អនុវត្ត ឱ្យ បាន ក្នុង ឆ្នាំ ២០២៣ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ស្តីពី « ការកំណត់ លក្ខណ វិនិច្ឆ័យ សហគ្រាស មួយ ជា សហគមន៍ សុខសាន្ត មួយ »
សូម កុំ ចង់ សាកល្បង ប្រើ គ្រឿងញៀន សូម្បី ម្តង ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី៣០ ខែធ្នូ៖ បង្ក្រាប ១៨ករណី ឃាត់ខ្លួន ៥១ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ កម្លាំង សមត្ថកិច្ច បង្ក្រាប បាន ១៨ ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៥១ នាក់ ។
ឯកឧត្តម នុត ពុធ ដារ៉ា និង លោកជំទាវ គឹម សេដ្ឋានី ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ឯកឧត្តម នុត ពុធ ដារ៉ា អភិបាល រង ខេត្ត កណ្ដាល និង លោកជំទាវ គឹម សេដ្ឋានី រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ស្ថានីយ ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ ជើង ឯក កាលពី ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ កន្លងទៅ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី បាន ប្រកាស ថា កម្ពុជា មិន បាច់ បង្កើត ទិវា សន្តិភាព ទៀត នោះ ទេ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
កម្ពុជា ជា ប្រទេស រង នូវ សោនាដកម្ម យ៉ាង ខ្លោចផ្សារ ជា ទីបំផុត ដោយសារតែ ភ្លើង សង្គ្រាម ។ ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ស្ថាបនិក និង ជា អគ្គ មគ្គុទ្ទេសក៍ ឯក បាន ធ្វើឱ្យ កម្ពុជា បិទ បញ្ចប់ ភ្លើង សង្គ្រាម រកឃើញ សុខ សន្តិភាព ជាពិសេស បាន បិទ បញ្ចប់ ទំព័រ ខ្មៅ ងងឹត នៃ ការបែកបាក់ ជាតិ ក្នុង រយៈពេល តិច បំផុត ៥០០ ឆ្នាំ ។
ផ្តើម ពី សុខ សន្តិភាព និង ការឯកភាព ជាតិ ទាំងស្រុង នា ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ជា បុព្វហេតុ ដ៏ ធំធេង នាំឱ្យ កម្ពុជា សម្រេចបាន នូវ ការកសាង ជាតិ ឱ្យ រីកចម្រើន ប្រជាពលរដ្ឋ រស់ នៅ ប្រកបដោយ សុខ សុភមង្គល ដូច ពេល បច្ចុប្បន្ន នេះ ។
ការប្រកាស កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ ជា « ទិវា សន្តិភាព នៅ កម្ពុជា » ជា គំនិត ប្រកបដោយ គតិបណ្ឌិត ខ្ពង់ខ្ពស់ បំផុត និង ប្រកបដោយ ទស្សនវិស័យ វែងឆ្ងាយ របស់ សម្តេច បវរធិបតី ហ៊ុន ម៉ាណែត សម្រាប់ ជា ឧត្តម ប្រយោជន៍ របស់ ជាតិ មាតុភូមិ ។ យើងខ្ញុំ ទាំងអស់ គ្នា មាន ក្តី សោមនស្ស រីករាយ ក្រៃលែង និង សូម ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង នូវ ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន រដ្ឋបាល ខេត្ត បាត់ដំបង និង ក្រុមប្រឹក្សា បណ្ដាញ ព្រះវិហារ គ្រីស្ទ បរិស័ទ កម្ពុជា ចុះ លើកទឹកចិត្ត ជនរងគ្រោះ ដោយសារ គ្រឿងញៀន
( បាត់ដំបង ) ៖ នៅ រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ ទទួលបាន កិច្ចសហការ សម្របសម្រួល ពី អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង ក្រុមប្រឹក្សា បណ្ដាញ ព្រះវិហារ គ្រីស្ទ បរិស័ទ កម្ពុជា ក្រុមប្រឹក្សា បណ្ដាញ ព្រះវិហារ គ្រីស្ទ បរិស័ទ កម្ពុជា ភូមិភាគ១ សាខា ខេត្ត បាត់ដំបង បាន រៀបចំ ពិធី ផ្សព្វផ្សាយ អប់រំ ដល់ ជនរងគ្រោះ ដែល កំពុង សម្រាក នៅ មជ្ឈមណ្ឌល បន្សាប ព្យាបាល និង ស្ដារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន កែ ស៊ីនួន ខេត្ត បាត់ដំបង ។
ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត ប្រធាន នាយកដ្ឋាន ផ្សព្វផ្សាយ អប់រំ និង ទំនាក់ទំនង សាធារណ: នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ប្រាប់ ឱ្យដឹង ថា ក្រុមប្រឹក្សា បណ្ដាញ ព្រះវិហារ គ្រីស្ទ បរិស័ទ កម្ពុជា ដឹកនាំ ដោយ លោក អ៊ួង យូហាន គឺជា ដៃគូ យ៉ាង ជិតស្និត ជួយ លើ កាងារ ផ្សព្វផ្សាយ អប់រំ បង្ការ ទប់ស្កាត់ បញ្ហា គ្រឿងញៀន តាម រយ : ជន បង្គោល ជា គ្រូ គង្វាល ក្រុម ជំនុំ ដែល បាន ពង្រឹង សមត្ថភាព ជា ជន បង្គោល អប់រំ ពី បញ្ហា គ្រឿងញៀន នៅ តាម សហគមន៍ ។
លោកគ្រូ គង្វាល ទូច សុខា អនុប្រធាន ទី១ តំណាង ឲ្យ លោក អ៊ួង យូហាន ប្រធាន ក្រុមប្រឹក្សា បណ្ដាញ ព្រះវិហារ គ្រីស្ទ បរិស័ទ កម្ពុជា បាន ប្រាប់ ឱ្យដឹង ថា ការសហការរៀបចំ ពិធី បុណ្យ ណូអែល និង ឆ្លង ឆ្នាំ នៅក្នុង មជ្ឈមណ្ឌល បន្សាប ព្យាបាល និង ស្ដារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន កែស៊ី នួន បាត់ដំបង ដែល មាន ការចូលរួម ពី រដ្ឋបាល ស្រុក និង រដ្ឋបាល ខេត្ត និង មន្ត្រី បុគ្គលិក មណ្ឌល សរុប ៣៤០ នាក់ ជា ការលើកទឹកចិត្ត ផ្តល់ ក្តីសង្ឃឹម ដល់ ពួកគេ ។
លោក អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាត់ដំបង បាន សំណេះសំណាល និង លើកទឹកចិត្ត ប្រកបដោយ អត្ថន័យ ដ៏ ជ្រាលជ្រៅ ក្នុង ការផ្សព្វផ្សាយ អប់រំ ពី បញ្ហា ផ្សេង ៗ ដែល ពាក់ព័ន្ធ នឹង គ្រឿងញៀន ដាស់តឿន លួងលោម ដល់ ក្មួយ ជនរងគ្រោះ ទាំងអស់ ត្រូវ ខិតខំ ស្តាប់ ការអប់រំ របស់ ក្រុម គ្រូ ជំនាញ គ្រប់ ផ្នែក ដើម្បី ឆាប់ ជាសះស្បើយ ត្រឡប់ ទៅកាន់ គ្រួសារ និង សហគមន៍ វិញ ។
បន្ទាប់ពី បាន ផ្សព្វផ្សាយ នៅ ព្រះបន្ទូល របស់ ព្រះយេស៊ូវ គ្រីស្ទ រួច មក ក្រុមប្រឹក្សា បណ្ដាញ ព្រះវិហារ គ្រីស្ទ បរិស័ទ បាន ប្រគល់ អំណោយ ជូន ដល់ មជ្ឈមណ្ឌល បន្សាប និង ស្ដារ នីតិសម្បទា នៅ សម្ភារ មួយចំនួន ដូចជា ព្រះគម្ពីរ ចំនួន ៣១០ ក្បាល អង្ករ ៧៥០ គីឡូក្រាម ទឹក ស៊ីអ៊ីវ១០យួរ ទឹកត្រី ១០យួរ ត្រីខ១០យួរ និង មី ១០កេស ។
លោក កែ ស៊ី នួន ប្រធាន មជ្ឈមណ្ឌល បាន ថ្លែងអំណរគុណ និង សូមស្វាគមន៍ រាល់ គ្រប់ បណ្តា អង្គការ សមាគម សប្បុរសជន ទាំងអស់ ដែល មាន បំណង ចូលរួម ជួយ ដល់ ជួយ ដល់ ក្មួយ ៗ ជា ជន រងគ្រោះ ដោយសារ គ្រឿងញៀន ទាំងអស់ នៅ មជ្ឈមណ្ឌល បន្សាប ព្យាបាល និង ស្ដារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន កែស៊ី នួន បាត់ដំបង ។
កម្មវិធី បាន បញ្ចប់ ប្រកប ទៅ ដោយ ភាពរីករាយ អំណរ សាទរ នៅក្នុង ព្រះវត្តមាន ព្រះព្រះយេស៊ូ គ្រីស្ទ ជា ព្រះអង្គម្ចាស់ សង្គ្រោះ មនុស្ស ឱ្យ រួច ពី អំពើ បាប ៕
( ប៉េកាំង ) ៖ ពី ថ្ងៃទី ២៧ ដល់ ថ្ងៃទី ២៨ ខែធ្នូ សន្និសីទ ការងារ កិច្ចការ បរទេស នៃ មជ្ឈិម ចិន បាន បើក ធ្វើ នៅ ទីក្រុង ប៉េកាំង ។ លោក Xi Jinping អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កម្មុយនីស្ត ចិន ប្រធាន រដ្ឋ ចិន និង ជា ប្រធាន គណៈកម្មាធិការ យោធា មជ្ឈិម ចិន បាន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ ព្រមទាំង ថ្លែង សុន្ទរកថា គន្លឹះ ។
លោក Xi Jinping បាន បូកសរុប ជា ប្រព័ន្ធ នូវ សមិទ្ធផល ជា ប្រវត្តិសាស្ត្រ និង បទពិសោធន៍ ដ៏ មាន តម្លៃ នៃ កិច្ចការ ទូត របស់ ចិន ដែល ជា ប្រទេស ធំ ដែល មាន លក្ខណៈ ពិសេស ចិន ក្នុង យុគសម័យ ថ្មី ដោយ បាន អធិប្បាយ យ៉ាង ស៊ីជម្រៅ នូវ បរិយាកាស អន្តរជាតិ និង បេសកកម្ម ប្រវត្តិសាស្ត្រ ដែល កិច្ចការ ទូត របស់ ចិន កំពុង ប្រឈមមុខ ក្នុង ដំណើរ ថ្មី ព្រមទាំង ធ្វើ ការរៀបចំ ចាត់ចែង ដោយ គ្រប់ ជ្រុងជ្រោយ ចំពោះ កិច្ចការ ទូត របស់ ចិន ក្នុង ពេល បច្ចុប្បន្ន និង មួយ រយៈពេល ខាងមុខ ។
សន្និសីទ បាន សម្គាល់ ថា ចាប់តាំងពី សមាជ បក្ស កុម្មុយនិស្ត ចិន លើក ទី ១៨ កន្លងមក ក្នុង ដំណើរ នៃ ការជំរុញ បុព្វហេតុ សង្គម និយម ដែល មាន លក្ខណៈ ពិសេស ចិន ក្នុង យុគសម័យ ថ្មី ការងារ កិច្ចការ បរទេស របស់ ប្រទេស ចិន ទទួលបាន សមិទ្ធផល ជា ប្រវត្តិសាស្ត្រ និង មាន ការផ្លាស់ប្តូរ ជា ប្រវត្តិសាស្ត្រ ។
សន្និសីទ បាន សង្កត់ធ្ងន់ ថា ក្នុង រយៈពេល ១០ឆ្នាំ កន្លងមក យើង បាន ជម្នះ ការលំបាក និង បញ្ហា ប្រឈម ផ្សេង ៗ ក្នុង ការងារ កិច្ចការ បរទេស ហើយ ប្រទេស ចិន បាន ក្លាយជា ប្រទេស ធំ ដែល មាន ទំនួល ខុសត្រូវ និង កាន់តែ មាន ឥទ្ធិពល លើ ផ្ទៃ អន្តរជាតិ មាន ភាពដឹកនាំ ប្រកបដោយ ភាពច្នៃប្រឌិត ថ្មី និង សច្ច យុត្តិធម៌ ។
សន្និសីទ បាន សម្គាល់ ថា សម្លឹងមើល ទៅ អនាគត ការអភិវឌ្ឍ របស់ ប្រទេស ចិន កំពុង ប្រឈមមុខ នឹង កាលានុវត្តភាពយុទ្ធសាស្ត្រ ថ្មី ។ យើង ត្រូវ ផ្តោត លើ ភារកិច្ច ស្នូល របស់ បក្ស និង រដ្ឋ បង្កើត និម្មាប នកម្ម ថ្មី នៃ ទំនាក់ទំនង រវាង ប្រទេស ចិន និង ពិភពលោក ដើម្បី ធ្វើឱ្យ ប្រទេស ចិន មាន ឥទ្ធិពល កាន់តែ ខ្លាំង លើ ផ្ទៃ អន្តរជាតិ ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា ឡេង ប្រុស និង លោកជំទាវ ព្រមទាំង សហការី ទាំងអស់ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
មន្ត្រី អប់ រំ៖ ការផ្តល់ ចំណេះដឹង ដល់ កូន ជា ទ្រព្យ មិន ចេះ រីងស្ងួត និង មាន តម្លៃ ចាយ មិន ចេះ អស់
( កំពង់ធំ )៖ លោក សាន វុទ្ធី អនុប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត កំពង់ធំ បាន ថ្លែង ថា ការផ្តល់ ចំណេះដឹង ដល់ កូន គឺជា ទ្រព្យ មិន ចេះ រីងស្ងួត និង មាន តម្លៃ ចាយ មិន ចេះ អស់ ។
លោក សាន វុទ្ធី ថ្លែង បែប នេះ ក្នុង ពិធី ចែក វិញ្ញាបនបត្រ បណ្ណ សិក្សា បញ្ចាប់ វគ្គ ភាសា អង់គ្លេស ប្រចាំ ឆ្នាំ ២០២២ - ២០២៣ នៃ សាលារៀន សុវណ្ណ ភូមិ ទីតាំង ខេត្ត កំពង់ធំ នា ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២៣ ។
លោក សាន វុទ្ធី បញ្ជាក់ ថា សាលារៀន ទាំង រដ្ឋ និង ឯកជន ពិតជា លើកកម្ពស់ អភិវឌ្ឍន៍ វិស័យ អប់រំ និង បង្កើត នូវ ធនធាន មនុស្ស និង ស្នើ ឱ្យ សាលារៀន ទាំងអស់ បន្ត យកចិត្តទុកដាក់ ក្នុង ការពង្រឹង គុណភាព គ្រប់គ្រង ការងារ បង្រៀន អោយ បាន ច្បាស់លាស់ និង គិត ពីរ សុវត្ថិភាព ដល់ សិស្សានុសិស្ស ដើម្បីឱ្យ មាតាបិតា សិស្ស មាន ការជឿទុកចិត្ត ។
ឯកឧត្ដម ឧប នាយក រដ្ឋមន្រ្តី កើត រិទ្ធ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ឯកឧត្ដម កើត រិទ្ធ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
មេបញ្ជាការ យោធ ភូមិភាគ ទី៤ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ យោធ ភូមិភាគ ទី៤ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ក្រសួង ការពារ ជាតិ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ក្រសួង ការពារ ជាតិ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
( ភ្នំពេញ ) ៖ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ បញ្ជាការដ្ឋាន កងពល តូច លេខ ៧០ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
មេបញ្ជាការ យោធ ភូមិភាគ ទី៥ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ យោធ ភូមិភាគ ទី៥ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
មេបញ្ជាការ យោធ ភូមិភាគ ទី១ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ យោធ ភូមិភាគ ទី១ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ឧត្ដមសេនីយ៍ ឯក ហួត ឈាង អន ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ឧត្ដមសេនីយ៍ ឯក ហួត ឈាង អន នាយ រង សេនាធិការ ចម្រុះ នាយក ទី ចាត់ការចល នូប្បត្ថម្ភ អគ្គ បញ្ជាការ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ឯកឧត្តម រ័ត្ន ស្រ៊ាង ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ឯកឧត្តម រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរក ឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ៧នាក់ ខណៈ ជា អ្នក ជាសះស្បើយ ៥នាក់ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២៣ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ៩១៤ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៩៣៥ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ អភិបាល ខេត្ត ព្រៃវែង ដឹកនាំ កម្លាំង ចុះ អន្តរាគមន៍ បូម ទឹក ជួយសង្គ្រោះ ស្រូវ រដូវ ប្រាំង ជិត ៣ពាន់ ហិកតា
ការបូម ទឹក នេះ ដើម្បី អន្តរាគមន៍ ជួយសង្គ្រោះ ស្រូវ រដូវ ប្រាំង លើក ទី១ មាន ចំនួន ២. ៩៦៩ហិកតា ដែល ប្រជាពលរដ្ឋ បាន បង្កបង្កើន ផល លើ ផ្ទៃដី ស្រូវ រដូវ វស្សា ក្នុង ឃុំ ទាំង៦ នៃ ស្រុក ស្វាយអន្ទរ គឺ ឃុំ ព្រៃ ខ្លា . ជា ខ្លាង . ស្វាយអន្ទរ . អង្គរ ទ្រេត . មេ បុណ្យ និង ដំរី ពួន សរុប ចំនួន ២. ៩៥៨គ្រួសារ ។
សូម បញ្ជាក់ ជូន ថា ប្រភព ទឹក នៃ ស្ថានីយ៍ បូម ទឹក ទី២នេះ គឺ យកមកពី បឹង កំពិត ដែល ស្ថិត នៅក្នុង ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ តាមរយៈ ព្រែក មេវ៉ៃ គោ ជំហាន ទី១ ៕ នាយ ឧត្តមសេនីយ៍ គន់ គីម បើក សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង ដាក់ចេញ ទិសដៅ អនុវត្ត បន្ត ឆ្នាំ ២០២៤ របស់ គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ
( កំពង់ធំ ) ៖ នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម ទេសរដ្ឋមន្ត្រី អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា នា រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ បាន អញ្ជើញ ប្រារព្ធ ពិធី សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង ដាក់ចេញ ទិសដៅ អនុវត្ត បន្ត ឆ្នាំ ២០២៤ របស់ គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ។ ពិធី នេះ ប្រព្រឹត្តទៅ នៅ ទីបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត កំពង់ធំ ។
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន បន្ត ថា ក្រៅពី នោះ ទៀត គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ គ្រប់ លំដាប់ថ្នាក់ បាន សំណេះសំណាល សាកសួរ សុខទុក្ខ និង ឧបត្ថម្ភ ស្បៀងអាហារ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ជូន ដល់ បងប្អូន អតីត យុទ្ធជន ដែល មាន ជីវភាព លំបាក ខ្វះខាត បាន ចំនួន ១៩៨ លើក ស្មើ ចំនួន ១. ៥០២ គ្រួសារ ។
នាយ ឧត្តមសេនីយ៍ គន់ គីម បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន ដែល បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ គ្រប់ បែបយ៉ាង ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល និង ការដោះស្រាយ ការលំបាក ជូន បងប្អូន អតីត យុទ្ធជន ក្នុង ខេត្ត បាន ទាន់ ពេលវេលា និង បាន ថ្លែងអំណរគុណ ចំពោះ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ នៅក្នុង ខេត្ត កំពង់ធំ ដែល បាន បង្ក លក្ខណះ ងាយស្រួល ជួយ ដោះស្រាយ នូវ រាល់ ការលំបាក ដល់ គណៈកម្មាធិការ សមាគម កម្ពុជា ខេត្ត នា ពេល កន្លងមក បាន យ៉ាង ល្អ ប្រសើរ ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ គន់ គីម បាន ប្រគល់ ទិសដៅ ភារកិច្ច សំខាន់ ៗ មួយចំនួន ជូន ដល់ អាជ្ញាធរ ខេត្ត និង គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ និង បណ្ដា មន្ទីរ ស្ថាប័ន អង្គភាព ទាំងអស់ ត្រូវ ខិតខំ បន្ត យកចិត្តទុកដាក់ មើល ថែទាំ សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ បងប្អូន អតីត យុទ្ធជន ព្រោះ បងប្អូន អតីត យុទ្ធជន គឺជា អ្នក ដែល ធ្លាប់ មាន គុណ បំណាច់ ចំពោះ ជាតិ មាតុភូមិ និង បាន រួមចំណែក ជាមួយ សម្តេច តេជោ អនុវត្ត នូវ នយោបាយ ឈ្នះ ឈ្នះ ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព ដូច សព្វ ថ្ងៃ នេះ ។
បើ ទោះបី ហេតុការណ៍ នេះ ជនរងគ្រោះ មិន គ្រោះថ្នាក់ ដល់ អាយុជីវិត យ៉ាងណា ក្ដី តែ បាន បង្ហាញ ពី ភាពអមនុស្សធម៌ គ្មាន សុជីវភាព និង ឃោឃៅ របស់ អ្នកបើកបរ ដែល គ្មាន ស្មារតី ទទួលខុសត្រូវ ចំពោះ សកម្មភាព របស់ ខ្លួន ។
តាមរយៈ វីដេអូ ដែល បង្ហាញ ដោយ កាមេរ៉ា សុវត្ថិភាព បាន ឲ្យដឹង ថា រថយន្ដ នេះ គៀរ ម៉ូតូ បណ្ដាលឲ្យ ដួល ហើយ មិន ឈប់ ចុះ មើល ជនរងគ្រោះ នោះ ទេ បែរជា បើក កិន ពីលើក ហើយ រត់គេចខ្លួន បាត់ ស្រមោល តែម្ដង ។
បន្ទាប់ពី ហេតុការណ៍ កើតឡើង លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន ដាក់ បទបញ្ជា ឲ្យ កម្លាំង ជំនាញ ធ្វើ ការស្រាវជ្រាវ ស្វែងរក អ្នកបើកបរ រថយន្ត Ford ដើម្បីឲ្យ ចូល ខ្លួន មក សារភាព និង ដោះស្រាយ ក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នេះ ចំពោះមុខ សមត្ថកិច្ច និង អនុវត្ត តាម នីតិវិធី បន្ទាប់ពី គេចវេស មិន ទទួលខុសត្រូវ ក្រោយ បង្ក គ្រោះថ្នាក់ ចរាចរណ៍ ។
លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ បាន អំពាវនាវ ដល់ អ្នកបើកបរ រថយន្ដ បង្ក ត្រូវ ភ្ញាក់ រលឹក និង មាន ស្មារតី ទទួលខុសត្រូវ ហើយ ចូល ខ្លួន មក ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ដោះស្រាយ តាម ច្បាប់ ៕
លោក រដ្ឋមន្រ្តី ការពារ ជាតិ អង់គ្លេស បាន បង្ហោះ សារ នៅលើ បណ្តាញ សង្គម X (Twitter) យ៉ាង ដូច្នេះ ថា « ចក្រភព អង់គ្លេស កំពុង ធ្វើការ យ៉ាង ឆាប់រហ័ស ដើម្បី ជួយ ពង្រឹង សមត្ថភាព ការពារ ដែន អាកាស របស់ អ៊ុយក្រែន ក្រោយ ការវាយប្រហារ តាម ផ្លូវ អាកាស ដ៏ ឃោរឃៅរ របស់ លោក ពូទីន ។ មីស៉ីល ការពារ ដែន អាកាស ផលិត ដោយ អង់គ្លេស ផ្ទាល់ ចំនួន រាប់ រយ គ្រាប់ នឹង ត្រូវ បញ្ជូន ទៅ ដើម្បី ជួយ ធានា ថា អ៊ុយក្រែន មាន អ្វី ៗ ដែល ត្រូវការ ដើម្បី ការពារ ខ្លួន ពី ការវាយប្រហារ តាម ផ្លូវ អាកាស ដ៏ អាក្រក់ របស់ លោក ពូទីន » ។
ក្រសួង សុខាភិបាល ហ្កាហ្សា បាន និយាយ ថា តួលេខ ខាងលើ រួមបញ្ចូល ទាំង អ្នកស្លាប់ ចំនួន ១៨៧ នាក់ ថ្មី ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ហើយ មនុស្ស ប្រមាណ ជិត ៥៦.០០០ នាក់ ផ្សេង ទៀត នៅក្នុង តំបន់ នេះ ក៏ បាន រងរបួស ផងដែរ អំលុង ការប្រយុទ្ធ គ្នា ។ យោង តាម អង្គការ សហ ប្រជាជាតិ (UN) ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង កាលពី ថ្ងៃទី ៧ ខែតុលា មក ប្រហែលជាង ៨០ ភាគរយ នៃ ចំនួន ប្រជាជន សរុប ២. ៤លាន នាក់ នៅ Gaza ត្រូវបាន បង្ខំឱ្យ រត់ ភៀសខ្លួន ចេញ ពី ផ្ទះសម្បែង របស់ ពួកគេ ។
ខាងក្រោម នេះ ជា ប្រកាស របស់ ក្រសួង អប់ រំ៖ លោក ហ៊ុន ម៉ានី អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ផ្សព្វផ្សាយ សេចក្ដីសម្រេចចិត្ត របស់ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ គណប្ស ប្រជាជន កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី សមាជិក គណៈ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្ដាល គណប្ស ប្រជាជន កម្ពុជា នៅ រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ផ្សព្វផ្សាយ សេចក្ដីសម្រេចចិត្ត របស់ មហាសន្និបាត វិសាមញ្ញ តំណាង ទូទាំង ប្រទេស របស់ គណបក្ស កាលពី ថ្ងៃទី ៩ ដល់ ទី១០ ខែធ្នូ ឆ្នាំ ២០២៣ ជូន ដល់ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ជាង ៦០០ នាក់ នៅ មន្ទីរ គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ ។
នា ឱកាស ដ៏ ពិសេស នេះ អង្គ ពិធី បាន បង្ហាញ ការអបអរសាទរ ជូន ចំពោះ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ដែល ត្រូវបាន មហាសន្និបាត បោះឆ្នោត ជ្រើសតាំង ជា អនុប្រធាន គណបក្ស និង បាន សាទ រ លោក ហ៊ុន ម៉ានី ដែល មហាសន្និបាត បោះឆ្នោត ជ្រើសតាំង ជា សមាជិក អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា ។
ក្រោយ បាន ស្តាប់ ការអាន សេចក្ដីសម្រេចចិត្ត របស់ មហាសន្និបាត និង ការប្រកាស សមាសភាព ដែល ត្រូវបាន ជ្រើសតាំង រួច មក លោក ហ៊ុន ម៉ានី បាន ថ្លែង រំលឹក ពី ដំណើរ ប្រវត្តិសាស្ត្រ ដែល កម្ពុជា បាន ឆ្លងកាត់ ជាច្រើន ដំណាក់កាល គិត ចាប់ ត្រឹម ពី ការទទួលបាន ឯករាជ្យ ការឆ្លងកាត់ សម័យ សង្គម តរាស្ត្រ និយម សម័យ សង្គ្រាម របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម និង ដំណាក់កាល នៃ ការតស៊ូ រំដោះ ប្រទេស ពី របប ខ្មែរ ក្រហម ឈានដល់ ដំណើរ ស្វែងរក សន្តិភាព ពេញលេញ ជូន ជាតិ និង ប្រជាជន ដោយ គណបក្ស ប្រជាជន ។
ផ្សាភ្ជាប់ ចំណុច ខាងលើ ដែរ លោក ហ៊ុន ម៉ានី ក៏ បាន ផ្ដល់ ទស្សនទាន ជុំវិញ សណ្ដាប់ធ្នាប់ ពិភពលោក ស្ថានភាពប្រកួតប្រជែង ភូមិសាស្ត្រ នយោបាយ បរិបទ វិបត្តិ ជំងឺ កូវីដ១៩ បញ្ហា បម្រែបម្រួល អាកាសធាតុ និង បញ្ហា សង្គ្រាម ដែល បាន និង កំពុង ជះឥទ្ធិពល មក លើ សេដ្ឋកិច្ច និង នយោបាយ សកល និង កម្ពុជា ។
យ៉ាងណា ក្តី លោក បាន គូសបញ្ជាក់ ថា កម្ពុជា នៅតែ រក្សា បាន នូវ ភាពធន់ ដោយ រក្សា បាន សន្តិភាព ស្ថិរភាព នយោបាយ កំណើន សេដ្ឋកិច្ច វឌ្ឍនភាពសង្គម ព្រមទាំង បំពេញ បាន យ៉ាង ល្អ ប្រសើរ នូវ កាតព្វកិច្ច កម្ពុជា ក្នុង កិច្ចការ អន្តរជាតិ និង ក្នុង ក្របខណ្ឌ អាស៊ាន ។ ជាមួយគ្នា នេះ លោក ក៏ បាន បញ្ជាក់ ជូន សមាជិក សមាជិកា ចំពោះ ជំហាន ឆ្ពោះទៅ មុខ របស់ កម្ពុជា ក្នុង ការឈានទៅ សម្រេច មហិច្ឆតា ប្រែក្លាយ ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ ។
លោក ហ៊ុន ម៉ានី បាន ណែនាំឲ្យ សមាជិក សមាជិកា ទាំងអស់ ពង្រឹង ភាព ជា អ្នកដឹកនាំ និង សមត្ថភាព ស្ថាប័ន លើ គ្រប់ វិស័យ ស្រប តាម មាគ៌ា នយោបាយ ដឹកនាំ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដើម្បី រួម ជា កម្លាំង ក្នុង ការអភិវឌ្ឍ ជាតិ ការពារ រដ្ឋធម្មនុញ្ញ សន្តិភាព ប្រជាធិបតេយ្យ អធិបតេយ្យភាព ផលប្រយោជន៍ ជាតិ និង ប្រជាជន ធានា បាន នូវ កំណើន និង ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច ព្រមទាំង គោល នយោបាយ ការបរទេស ដ៏ ត្រឹមត្រូវ ។
ក្រៅតែ ពី កីឡាករ ដែល ចូលរួម ប្រកួត ហើយ នោះ ក្នុង ពី បើក ការប្រកួត នា ព្រឹក មិញ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ សម្តេច ក្រឡាហោម ស ខេង និង សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ដែល ជា ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ផងដែរ ។ បន្ទាប់ពី ប្រកាស បើក ការប្រកួត ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន អញ្ជើញ វាយ កូនគោល ផងដែរ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី នេត សាវឿន បាន ឱ្យដឹង ថា ការប្រកួត នា ព្រឹក មិញ នេះ មាន កីឡាករ ចូលរួម ប្រកួត ចំនួន ៩៦ រូប ។ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា ការប្រកួត នេះ ធ្វើឡើង ដើម្បី ចូលរួម អបអរសាទរ ខួប ២៥ ឆ្នាំ នៃ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល នៅ កម្ពុជា ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន មគ្គុទេស ក៏ ឯក សន្តិភាព ។
ការប្រកួត កីឡា វាយ កូនគោល ដណ្តើម ពានរង្វាន់ សម្តេច តេជោ ហ៊ុន សែន លើក ទី៧ បាន ប្រព្រឹត្តទៅ ក្រោម បរិយាកាស រីករាយ និង អធិកអធម ក្រៃលែង ស័ក្តិសម នឹង ខ្លឹមសារ ដ៏ មាន អត្ថន័យ កីឡា រស់ ក្នុង សន្តិភាព មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍ សមិទ្ធផល ដ៏ ធំធេង ជា ប្រវត្តិសាស្ត្រ នេះ កើត ចេញ ពី សន្តិភាព ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ តេជោ សែន ដែល បាន បញ្ចប់ សង្គ្រាម ស៊ីវិល ទាំងស្រុង នៅ កម្ពុជា ដោយ មិន មាន ការបង្ហូរ ឈាម រហូត ទទួលបាន សុខ សន្តិភាព និង ការឯកភាព ជាតិ ពេញលេញ និង ធ្វើឱ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ គ្រប់ វិស័យ ។
បន្ទាប់ពី បញ្ចប់ ការប្រកួត សម្តេច តេជោ ហ៊ុន សែន និង ឥស្សរជន ដទៃ ទៀត ព្រមទាំង កីឡាករ ក៏ បាន អញ្ជើញ ពិសា អាហារ សាមគ្គី ប្រកបដោយ ក្តី សប្បាយរីករាយ ៕
លោកស្រី ម៉ែន នារី សោភ័គ បាន បន្ដ ថា មិន មែន តែ ក្នុង នាម សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ជា ប្រធាន កាកបាទ ក្រហម កម្ពុជា នោះ ទេ តែ ក្នុង នាម ជា ស្ដ្រី ដែល ជា ភរិយា របស់ ថ្នាក់ដឹកនាំ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត គឺ តែងតែ មាន ជួយ ទៅដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ដែល ជួប នឹង ទុក្ខលំបាក រួមទាំង ជួយ លើកកម្ពស់ សុខភាព សមត្ថភាព និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ជាប់ ជានិច្ច ។
ក្នុង រយៈពេល ២៥ ឆ្នាំ នេះ កាកបាទ ក្រហម កម្ពុជា បាន ចូលរួម ក្នុង ប្រតិបត្ដិការ ធំ ៗ ជាច្រើន ដែល ផ្សាយ ភ្ជាប់ នឹង នយោបាយ ឈ្នះ ឈ្នះ ។ ដើម្បី ជ្រាប ច្បាស់ សូមអញ្ជើញ ទស្សនា កិច្ចសម្ភាស របស់ លោកស្រី ម៉ែន នារី សោភ័គ ដូចត ទៅ៖កម្លាំង នគរបាល ខេត្ត កំពង់ស្ពឺ បង្ក្រាប ក្រុម ចោរ វ័យ ក្មេង ធាក់ ប្លន់ ម៉ូតូ ៥នាក់ ក្នុង ចំណោម បក្ខពួក ១០នាក់ និបញ្ជូន ទៅ តុលាការ ចាត់ការ តាម ច្បាប់
( កំពង់ស្ពឺ ) ៖ កម្លាំង នគរបាល ខេត្ត កំពង់ស្ពឺ បាន បើក ប្រតិបត្តិការ ស្រាវជ្រាវ និង ស៊ើបអង្កេត យ៉ាង ម៉ត់ចត់ រហូត ឈាន ទៅ ឃាត់ខ្លួន ក្រុម ជន ង្ស័យ វ័យ ក្មេង ចំនួន ៥នាក់ ក្នុង ចំណោម បក្ខពួក ចំនួន ១០នាក់ ជា បន្តបន្ទាប់ ក្រោយ ធ្វើ សកម្មភាព ធាក់ ប្លន់ យក ម៉ូតូ ពី ជនរងគ្រោះ បាន សម្រេច និង រត់គេចខ្លួន បាន មួយ រយៈ នៅ សង្កាត់ កណ្ដោល ដុំ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ
ប្រតិបត្តិការ នេះ បាន ធ្វើឡើង ក្រោម បញ្ជា ពី លោក ឧត្តមសេនីយ៍ ទោ សម សាមួន ស្នងការ នគរបាល ខេត្ត កំពង់ស្ពឺ និង ការសម្របសម្រួល ពី លោក ស៊ិន វិរៈ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ខេត្ត កំពង់ស្ពឺ ។
របាយការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ស្ពឺ បាន បញ្ជាក់ ថា កាលពី ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២៣ វេលា ម៉ោង ០៤ និង ១០នាទី ទៀប ភ្លឺ នៅមុខ ផ្ទះសំណាក់ នាគ មាស ផ្លូវ បេតុង លេខ ១០៥ ភូមិ ផ្សារ ចាស់ សង្កាត់ ស្វាយ ក្រវ៉ាន់ ក្រុង ច្បារមន មាន ករណី លួច ដោយ ស្ថាន ទម្ងន់ ទោស ( ប្លន់ យក ម៉ូតូ ) បង្ក ដោយ ជនសង្ស័យ ១០នាក់ ជិះ ម៉ូតូ ០៥ គ្រឿង ។ ជនរងគ្រោះ ឈ្មោះ ជិន សារិន ភេទ ស្រី អាយុ ៣៧ ឆ្នាំ នៅ ភូមិញ រ សង្កាត់ កណ្ដោល ដុំ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ រងរបួស ជង្គង់ សងខាង និង កែង ដៃ សងខាង ។
នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ សហការ ជាមួយ នគរបាល ស្រុក សំរោងទង ស្រុក គងពិសី ស្រុក អង្គស្នួល បន្ត ឃាត់ខ្លួន ជនសង្ស័យ ៣នាក់ ទៀត រួម មាន៖
សរុប ឃាត់ខ្លួន ជនសង្ស័យ ០៥ នាក់ ដកហូត ម៉ូតូ២ គ្រឿង និង ទូរស័ព្ទ ៤គ្រឿង ។ ក្រុម ជនសង្ស័យ បាន សារភាព ថា : បាន ធ្វើ សកម្មភាព ប្លន់ ម៉ូតូ ២លើ ក និង កាប់ ម៉ូតូ ១លើក នៅ ខេត្ត កំពង់ស្ពឺ ។ ជនសង្ស័យ និង វត្ថុតាង បាន កសាង សំណុំរឿង បញ្ជូន ទៅ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ស្ពឺ ៕
អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
នាយ ឧត្ដម នាវី ទៀ វិញ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ នាយ ឧត្ដម នាវី ទៀ វិញ អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងទឹក ព្រមទាំង នាយ នាវី នាយ រង នាវី និង ពល នាវី ទាំងអស់ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
នាយ ឧត្តមសេនីយ៍ ខ្វាន់ ស៊ាម ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ខ្វាន់ ស៊ាម ព្រមទាំង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ បញ្ជាការដ្ឋាន វិស្វកម្ម ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
មេបញ្ជាការ បញ្ជាការដ្ឋាន កងទ័ព ពិសេស ឆ័ត្រ យោង ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ បញ្ជាការដ្ឋាន កងទ័ព ពិសេស ឆ័ត្រ យោង ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
មេបញ្ជាការ បញ្ជាការដ្ឋាន កងពល ធំ លេខ ២ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ បញ្ជាការដ្ឋាន កងពល ធំ លេខ ២ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
មេបញ្ជាការ យោធ ភូមិភាគ ទី២ ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ យោធ ភូមិភាគ ទី២ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
នាយ ឧត្ដមសេនីយ៍ ម៉ក់ សារុន ប្រកាស គាំទ្រ ប្រសាសន៍ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ នាយ ឧត្ដមសេនីយ៍ ម៉ក់ សារុន អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ ប្រកាស គាំទ្រ ពេញ ទំហឹង នូវ ប្រសាសន៍ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា កំណត់ យក ថ្ងៃទី ២៩ ខែធ្នូ « ជា ទិវា សន្តិភាព នៅ កម្ពុជា » ។
ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ប្រកាស ឲ្យ អ្នកបើក រថយន្ត Ford ឈ្មោះ អ៉ឹម អរុណ គង់ ហុង ចូលមក សារភាព ក្រោយ បើក រថយន្ត ប៉ះ និង កិន អ្នកបើក ម៉ូតូ មួយ គ្រឿង នៅ ខណ្ឌ សែនសុខ
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន ប្រកាស ឲ្យ អ្នកបើក រថយន្ត Ford ឈ្មោះ អ៉ឹម អរុណ គង់ ហុង ចូល ខ្លួន មក សារភាព ក្រោយ បើក ប៉ះ និង កិន ជនរងគ្រោះ បើក ម៉ូតូ បណ្តាលឲ្យ រងរបួស នៅ សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ ។
តាមរយៈ វីដេអូ ដែល បង្ហាញ ដោយ កាមេរ៉ា សុវត្ថិភាព បាន ឲ្យដឹង ថា រថយន្ដ នេះ កៀរ ម៉ូតូ បណ្ដាលឲ្យ ដួល ហើយ មិន ឈប់ ចុះ មើល ជនរងគ្រោះ នោះ ទេ បែរជា បើក កិន ពីលើក ហើយ រត់គេចខ្លួន បាត់ ស្រមោល តែម្ដង ៕
( កំពង់ធំ )៖ លោក សុក ហៃ អភិបាល រង ខេត្ត កំពង់ធំ បាន ជំរុញ ឱ្យ ប្រធាន អង្គភាព មន្ទីរ ស្ថាប័ន ទាំងអស់ ត្រួតពិនិត្យមើល មន្ត្រី ក្រោម ឱវាទ របស់ ខ្លួន ដែល ពាក់ព័ន្ធ នឹង បទល្មើស ។
ការជំរុញ បែប នេះ របស់ លោក សុក ហៃ បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ជាមួយ អ្នកសារព័ត៌មាន ក្នុង ខេត្ត កំពង់ធំ នា រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ ម្សិលមិញ ។
លោក បាន បញ្ជាក់ ថា៖ « គ្រប់ អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ផ្ដល់ ព័ត៌មាន ឱ្យ បាន ឆាប់ រហ័ស ដល់ អ្នកនាំពាក្យ ដើម្បី ឆ្លើយតប ទៅនឹង អ្នកសារព័ត៌មាន ដែល បាន ចុះផ្សាយ ថា តើ មាន ភាពច្បាស់លាស់ ពិតប្រាកដ ដែរ ឬ ទេ ? ក្នុង នោះ មន្ទីរព័ត៌មាន ត្រូវ ពិនិត្យមើល អ្នកសារព័ត៌មាន មួយចំនួន តូច ដែល តែងតែ រកស៊ី បទល្មើស ផង ផ្ដល់ ព័ត៌មាន ឱ្យ សមត្ថកិច្ច ទៅ ចាប់ ផង និង ចុះផ្សាយ ផង » ។
លោក សុក ហៃ បាន បន្ត ថា ចំពោះ ស្រុក សន្ទុក ដែល មាន ប្រាំ ឃុំ ពាក់ព័ន្ធ ទៅនឹង គម្រប ព្រៃឈើ រដ្ឋបាល ខេត្ត បាន ធ្វើ របាយការណ៍ ផ្ញើ ទៅ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ រួចហើយ រង់ចាំ តែ ក្រសួង ចុះ មក ពិនិត្យ ដើម្បី សុំ គោលការណ៍ ទៅ រាជ រដ្ឋាភិបាល សម្រេច ហើយ ចំពោះ ដី តំបន់ ៣ ក៏ បាន ធ្វើ ដូចគ្នា ដែរ ។
លោក សូម អរគុណ ចំពោះ អ្នកសារព័ត៌មាន ដែល នៅក្នុង ខេត្ត ដែល បាន នឹង កំពុងតែ ចូលរួម យ៉ាង សកម្ម ជាមួយនឹង រដ្ឋបាល ខេត្ត ជាមួយនឹង រដ្ឋាភិបាល លើ ការងារ ផ្សព្វផ្សាយ ព័ត៌មាន នៅក្នុង ខេត្ត នេះ ហើយ សូម អរគុណ ចំពោះ អស់ លោក លោកស្រី ទាំងអស់ ដែល បាន មក ចុះបញ្ជី ត្រឹមត្រូវ និង គោរព នៅ ក្រមសីលធម៌ វិជ្ជាជីវៈ ឲ្យបាន ល្អ ព្រោះថា ក្រមសីលធម៌ វិជ្ជាជីវៈ នេះ ជា អាវ ក្រោះ ការពារ ។
លោក សុក ហៃ បាន បញ្ជាក់ ទៅដល់ អ្នកសារព័ត៌មាន សូម ឱ្យ ការសរសេរ ព័ត៌មាន ត្រូវ មាន មាន ប្រភព ច្បាស់លាស់ កុំ យក តែ ម្ខាង ៕
សម្រាប់ ការប្រគុំតន្ត្រី ខ្នាត យក្ស នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ណាក់ កញ្ញា ចំរើន សុភក្ត្រ តារាចម្រៀង ប្រចាំ ផលិតកម្ម ហង្ស មាស ក្រុមការងារ ចុះ ជួយ ឃុំ អាជ្ញាធរ មូលដ្ឋាន សិល្បៈ ករ សិល្បៈ ការិនី និង ពិធី ករ ពិធី ការិនី ដែល មាន ឈ្មោះ បោះ សម្លេង ក្នុង ស្ថានីយ៍ ទូរទស្សន៍ និង ផលិតកម្ម ល្បី ៗ មួយចំនួន ទៀត ។
លោក អេង គន្ធា បាន ឱ្យដឹង ថា ការជួបជុំគ្នា នេះ គឺ ធ្វើឡើង តាម ការសន្យា របស់ លោក កែវ រតនៈ រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ ខណៈ ដែរ ឃុំ ស្រែ ស្តុក បាន បោះឆ្នោត គាំទ្រ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ទទួលបាន បាន លទ្ធផល ឈ្នះ ដាច់ លេខ ១ ទូទាំង ប្រទេស ក្នុង ព្រឹត្តការណ៍ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ កាលពី ពេល កន្លងមក ។
លោក ក៏ សូម ថ្លែងអំណរគុណ ដល់ ក្រុម សិល្បៈ ករ សិល្បៈ ការិនី និង ពិធី ករ ពិធី ការិនី ទាំងអស់ ដែល បាន ចំណាយ ពេលវេលា ដ៏ មាន តម្លៃ ចូលរួម បង្ក លក្ខណៈ សប្បាយរីករាយ ដល់ បងប្អូន ប្រជាពលរដ្ឋ យើង ក្នុង ឱកាស ទិវា ឆ្លង ឆ្នាំ សកល ២០២៣ ឈាន ចូល ២០២៤ នេះ ។
លោក អេង គន្ធា បាន គូសបញ្ជាក់ ថា តំបន់ ការពារ បេតិកភណ្ឌ វប្បធម៌ ជាតិ បឹង ទន្លេ អុំ និង ប្រសាទ ព្រះធាតុ គឺជា កេរ្តិ៍មរតក របស់ ឃុំ ស្រែ ស្តុក យើង ដែល បង្ហាញ ពី ការសហការ គ្នា និង ចំណង សាមគ្គីភាព រវាង បុរស និង នារី ដែល បន្សល់ទុក ជា ភស្តុតាង នេះ ឡើង ដូច រឿង ដំណាល និទាន ភ្នំ ប្រុស ភ្នំ ស្រី ជាដើម ។
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង បាន រៀបចំ ព្រឹត្តការណ៍ ពិព័រណ៍ ម្ហូប អាហារ ខ្មែរ អ្នក បាត់ដំបង ដើម្បី អបអរសាទ « ទីក្រុង បាត់ដំបង ទទួលបាន ការចុះបញ្ជី ក្នុង បណ្តាញ ទីក្រុង ច្នៃប្រឌិត ផ្នែក ម្ហូប អាហារ » របស់ អង្គការ យូណេស្កូ (UCCN) ដោយ មាន ដាក់ តាំង ម្ហូប អាហារ និង បង្អែម ខ្មែរ ផ្សេង ៗ គ្នា ចំនួន ១១១ ស្តង់ ។
ពិធី នេះ បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ នៅ ផ្លូវ មុខ សាលា ខេត្ត ចាស់ ដល់ សួន វិមាន ឯករាជ្យ សម្តេច ក្រឡាហោម ស ខេង ក្រុង បាត់ដំបង ក្រោម វត្តមាន លោក អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក សុខ លូ អភិបាល ខេត្ត បាត់ដំបង . ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត អាជីវករ និង ប្រជាពលរដ្ឋ ចូលរួម ជាច្រើន នាក់ ទៀត ។
លោក អ៊ុច អ៊ុំ ភីស្សរ៉ា ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត បាន ឡើង ថ្លែង សុន្ទរកថា ដើម្បី អបអរសាទរ ខេត្ត បាត់ដំបង បាន ចូល ជា សមាជិក បណ្តាញ ទីក្រុង ច្នៃប្រឌិត របស់ អង្គការ យូនេស្កូ ផ្នែក ម្ហូប អាហារ និង ដើម្បី អបអរសាទរ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សាកល ២០២៣ ឆ្លង ចូល ២០២៤ ដែល មាន ការចូលរួម យ៉ាង កុះករ ពីសំណាក់ ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព បណ្តារ ក្រុង ស្រុក នានា ជុំវិញ ខេត្ត បាត់ដំបង និង បងប្អូន អាជីវករ បាន ចូលរួម លក់ដូរ បង្ហាញ ស្នាដៃ របស់ ពួកគេ ផង ។
លោក សុខ លូ បាន រំលឹក ថា ពិធី បើក ពិព័រណ៍ ម្ហូប អាហារ និង បង្អែម ខ្មែរ ដែល រៀបចំ ដោយ មន្ទីរ ទេសចរណ៍ ខេត្ត មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ ខេត្ត ដើម្បី អបអរសាទរ ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ឆ្នាំ ២០២៣ - ២០២៤នា ខាងមុខ នេះ ។ ការប្រារព្ធ ពិធី តាំង បង្ហាញ មុខ ម្ហូប នេះ ខេត្ត បាត់ដំបង យើង ធ្លាប់ បាន រៀបចំ ធ្វើ ពិធី នេះ ជា ហូរហែ កន្លងមក ហើយ ដែរ ។
គួរ បញ្ជាក់ ថា កម្មវិធី ប្រកួតប្រជែង នេះ រៀបចំឡើង ដោយ ផ្អែក លើ លក្ខណៈ ពិសេស ដូច ជា៖ ការតុបតែង រចនាលម្អ . អនាម័យ និង បរិស្ថាន . សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ . ភាព ពេញចិត្ត និង ការសប្បាយរីករាយ របស់ ភ្ញៀវ ទេសចរ និង អ្នកចូលរួម ។
សូម ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ចូលរួម ធ្វើ ការបោះឆ្នោត គាំទ្រ ទីក្រុង ដែល លោក អ្នក ពេញចិត្ត ជាង គេ បំផុត ដោយ ជ្រើសរើស តែ ១ប៉ុណ្ណោះ ដោយ ប្រកាស បើក ចាប់ពី ម៉ោង ៥ល្ងាច ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២៣ រហូតដល់ ថ្ងៃទី ០២ ខែមករា ឆ្នាំ ២០២៤ នេះ តទៅ ៕
ក្រសួង សុខាភិបាល បាន ធ្វើ ការអំពាវនាវ ក្រើន រំលឹក ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ជាប់ ជានិច្ច ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ដើម្បី បង្ការ នូវ ការចម្លង វីរុស កូវីដ - ១៩ បំប្លែង ថ្មី ប្រភេទ Omicron JN.1 ដោយ ត្រូវ អនុវត្ត នូវ វិធានការ បង្ការ ដូច ខាងក្រោម៖
* បុគ្គល ម្នាក់ ៗ ត្រូវ បន្ត ទៅ ទទួល ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ឱ្យ បាន គ្រប់ ដូស ទាំង ដូស មូលដ្ឋាន និង ដូស ជំរុញ នៅ តាម មន្ទីរពេទ្យ ឬ មណ្ឌល សុខភាព ដើម្បី ពង្រឹង ប្រព័ន្ធ ភាពស៊ាំ រៀង ៗ ខ្លួន ឱ្យ បាន សមស្រប ដើម្បី បង្ការ ការឆ្លង វីរុស កូវីដ - ១៩ ។
* ប្រសិនបើ អ្នក មាន អាការៈ ក្ដៅ ខ្លួន ក្អក ឬ ពិបាក ដកដង្ហើម ឬ មាន បញ្ហា សុខភាព ហើយ ត្រូវ ទៅ ពិនិត្យ ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ ឬ មណ្ឌល សុខភាព ឱ្យ បាន ទាន់ ពេល សមស្រប ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ទៀត ថា យោង តាម លទ្ធផល វិភាគ លម្អិត ទទួលបាន ពី មន្ទីរពិសោធន៍ បង្អែក ជាតិ នៃ វិទ្យាស្ថាន សុខភាព សាធារណៈ នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ បាន បញ្ជាក់ ពី ការរកឃើញ វីរុស បំប្លែង ថ្មី ប្រភេទ Omicron JN.1 ចំនួន ១១ករណី បន្ថែម ទៀត ដែល ពួកគាត់ ទាំងអស់ ពុំ មាន រោគសញ្ញា ធ្ងន់ធ្ងរ គួរឱ្យ កត់សម្គាល់ ហើយ ពុំ មាន ប្រវត្តិ ធ្វើដំណើរ ទៅ ក្រៅ ប្រទេស ទេ ។
ទូរទស្សន៍ រដ្ឋ CCTV បាន រាយការណ៍ ថា លោក Xi បាន ប្រាប់ ប្រេសិត ការបរទេស របស់ ចិន ដែល ប្រមូលផ្តុំ គ្នា នៅ ទីក្រុង ប៉េកាំង ដូច្នេះ ថា « ត្រូវ ហ៊ាន តស៊ូ និង ក្លាយជា អ្នកការពារ ផលប្រយោជន៍ ជាតិ ហើយ ចាំបាច់ ត្រូវ ការពារ យ៉ាង ម៉ឺងម៉ាត់ នូវ ផលប្រយោជន៍ អធិបតេយ្យភាព សន្តិសុខ និង ការអភិវឌ្ឍន៍ ជាតិ ដោយ ការត្រៀមខ្លួន និង ឆន្ទៈ ដ៏ មុតមាំ ក្នុង ការប្រជែង នឹង កម្លាំង ដ៏ មាន ឥទ្ធិពល » ។
ការអត្ថាធិប្បាយ របស់ លោក នេះ បាន រំលឹក ឡើងវិញ នូវ ទម្រង់ វោហារ សាស្ត្រ ដ៏ កាច ដែល អនុម័ត ដោយ អ្នកការទូត ចិន ចាប់តាំងពី ឆ្នាំ ២០២០ ដែល មិន សូវ មាន ភាពលេចធ្លោ នៅ ឆ្នាំ នេះ ដោយសារ ចិន ស្វែងរក ការទាក់ទាញ ការវិនិយោគ ពី បរទេស ដើម្បី ទប់ទល់ នឹង ការធ្លាក់ចុះ សេដ្ឋកិច្ច របស់ ខ្លួន ។
លោក Xi ក៏ បាន ជំរុញឱ្យ បេសកជន ប្រកាន់ខ្ជាប់ នូវ វិន័យ បក្ស ដោយ និយាយ ឡើងវិញ នូវ ពាក្យ « តឹងរឹង » ប្រាំពីរ ដង នៅក្នុង សុន្ទរកថា ប្រចាំ ឆ្នាំ បន្ទាប់ពី សន្និសីទ ការងារ ចម្បង ស្តីពី កិច្ចការ បរទេស ដែល ជា កិច្ចប្រជុំ រៀបចំ ផែនការ គោល នយោបាយ ការបរទេស របស់ បក្ស កុម្មុយនិស្ត កម្រិត ខ្ពស់ ដែល ធ្វើឡើង រៀងរាល់ ៥ ឆ្នាំ ម្តង ។ កិច្ចប្រជុំ នេះ បាន បញ្ចប់ កាលពី ថ្ងៃព្រហស្បតិ៍ ។
គួរ បញ្ជាក់ ថា ការអត្ថាធិប្បាយ របស់ លោក Xi បាន កើតឡើង ស្រប ពេល ដែល ស្ថាប័ន ការទូត ចិន បាន និង កំពុង ជំរុញ ការអនុវត្ត ផ្នែក វិន័យ ថ្មី បន្ទាប់ពី អតីត រដ្ឋមន្ត្រី ការបរទេស លោក Qin Gang ត្រូវបាន បណ្តេញ ចេញ ពី តំណែង កាលពី ខែកក្កដា ដោយ បាន បំពេញ ការងារ ត្រឹមតែ ប្រាំពីរ ខែ ប៉ុណ្ណោះ ជុំវិញ ពាក្យ ចចាមអារ៉ាម អំពី ទំនាក់ទំនង អាពាហ៍ពិពាហ៍ ក្រៅ ប្រព័ន្ធ ៕ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ប្រារព្ធ សន្និបាត ប្រចាំ ឆ្នាំ និង ទិសដៅ បន្ត
( កំពង់ធំ )៖ នៅ រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៣ គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ បាន ប្រារព្ធ ពិធី សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង ដាក់ចេញ ទិសដៅ អនុវត្ត បន្ត ឆ្នាំ ២០២៤ របស់ គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ។
ពិធី នេះ ប្រព្រឹត្តទៅ នៅ ទីបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត កំពង់ធំ ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម ទេសរដ្ឋមន្ត្រី អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ។
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង និង ជា ប្រធាន គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ បាន ឡើង ធ្វើ របាយការណ៍ ស្វាគមន៍ យ៉ាង កក់ក្តៅ ជា ទីបំផុត ចំពោះ វត្តមាន របស់ នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម ព្រមទាំង ប្រតិភូ អម ដំណើរ ដែល បាន ឆ្លៀត ឱកាស ដ៏ មមាញឹក និង មាន តម្លៃ អញ្ជើញ ជា អធិបតីភាព ចូលរួម ក្នុង ពិធី សន្និបាត ដ៏ មាន សារៈសំខាន់ នៅ ថ្ងៃ នេះ ។
លោក បាន គូសបញ្ជាក់ អំពី ចំណុច សំខាន់ ៗ មួយចំនួន ដែល គណៈកម្មាធិការ អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ សម្រេចបាន ក្នុង ឆ្នាំ ២០២៣ មាន ជាអាទិ៍៖ ការបំពាក់ គ្រឿង ឥស្សរិយយស ការពារ ជាតិ និង ឧបត្ថម្ភ ថវិកា ជូន អតីត យុទ្ធជន ចំនួន ៣. ៤៤៧ នាក់ ដែល មាន គុណ បំណាច់ ចំពោះ ជាតិ និង មាតុភូមិ ។
ទេសរដ្ឋមន្រ្តី គន់ គីម បាន កោតសរសើរ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន ដែល បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ គ្រប់ បែបយ៉ាង ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល និង ការដោះស្រាយ ការលំបាក ជូន បងប្អូន អតីត យុទ្ធជន ក្នុង ខេត្ត បាន ទាន់ ពេលវេលា និង បាន ថ្លែងអំណរគុណ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ នៅក្នុង ខេត្ត កំពង់ធំ ដែល បាន បង្ក លក្ខណះ ងាយស្រួល ជួយ ដោះស្រាយ នូវ រាល់ ការលំបាក ដល់ គណៈកម្មាធិការ សមាគម កម្ពុជា ខេត្ត នា ពេល កន្លងមក បាន យ៉ាង ល្អ ប្រសើរ ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ គន់ គីម បាន ប្រគល់ ទិសដៅ ភារកិច្ច សំខាន់ ៗ មួយចំនួន ជូន ដល់ អាជ្ញាធរ ខេត្ត និង គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ និង បណ្ដា មន្ទីរ ស្ថាប័ន អង្គភាព ទាំងអស់ ត្រូវ ខិតខំ បន្ត យកចិត្តទុកដាក់ មើល ថែទាំ សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ បងប្អូន អតីត យុទ្ធជន ព្រោះ បងប្អូន អតីត យុទ្ធជន គឺជា អ្នក ដែល ធ្លាប់ មាន គុណ បំណាច់ ចំពោះ ជាតិ មាតុភូមិ និង បាន រួមចំណែក ជាមួយ សម្តេច តេជោ អនុវត្ត នូវ នយោបាយ ឈ្នះ ឈ្នះ ធ្វើឱ្យ ប្រទេសជាតិ យើង មាន សុខ សន្តិភាព ដូច សព្វ ថ្ងៃ នេះ ។
នៅក្នុង ឱកាស នោះ នាយ ឧត្ដមសេនីយ៍ គន់ គីម បាន ឧបត្ថម្ភ ថវិកា មួយ ចំនួន ជូន ដល់ អតីត យុទ្ធជន ចំនួន ៨១ នាក់ ដែល មាន ស្នាដៃ ល្អ ក្នុង ចលនា ប្រឡង ប្រណាំង ៣ ល្អ ផងដែរ ៕
