( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ បង្ក្រាប ១៥ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៤៣ នាក់ ។
រដ្ឋមន្ត្រី អភិវឌ្ឍន៍ ជនបទ ណែនាំ ឱ្យ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ រាជធានី ចុះ កំណត់ ភូមិ គំរូ នៅ ខណ្ឌ ជាយ រាជធានី ដោយ ផ្អែក ទៅ តាម លក្ខណៈ វិនិច្ឆ័យ នៃ ភូមិ គំរូ
( ភ្នំពេញ ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន ណែនាំ ដល់ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ រាជធានី ត្រូវ សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ចុះ កំណត់ ភូមិ គំរូ នៅក្នុង ខណ្ឌ ជាយ រាជធានី ដោយ ផ្អែក លើស ក្ដានុពល សំខាន់ ៗ ទៅ តាម លក្ខណៈ វិនិច្ឆ័យ នៃ ភូមិ គំរូ ។
ការណែនាំ នេះ ធ្វើឡើង ក្នុង ឱកាស ជួប សំណេះសំណាល និង សាកសួរ សុខទុក្ខ ជាមួយ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង មន្ដ្រី ជាប់ កិច្ចសន្យា នៃ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ រាជធានី ភ្នំពេញ សរុប ៣៣ នាក់ នា ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ ដោយ មាន ការចូលរួម ពី រដ្ឋលេខាធិការ ប្រចាំ ការ រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ថ្នាក់ដឹកនាំ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ព្រមទាំង លោក អ៊ីម រ៉ន ហាស្សាន់ អភិបាល រង រាជធានី ភ្នំពេញ ។
សម្រាប់ នីតិកាល ថ្មី នេះ ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន កំណត់ ចក្ខុវិស័យ ដ៏ មាន សារៈសំខាន់ គឺ « កសាង តំបន់ ជនបទ កម្ពុជា ប្រកបដោយ វិបុលភាព . បរិយា បន្ន . ន វានុវត្តន៍ . ឌីជីថល . និង ភាពធន់ ទាំង ផ្នែក សេដ្ឋកិច្ច សង្គម និង វប្បធម៌ » ដើម្បី ធានា បាន នូវ កំណើន ប្រាក់ ចំណូល គ្រួសារ នៅ ជនបទ ប្រកបដោយ ចីរភាព និង មាន សុខុមាលភាព កាន់តែ ល្អ ប្រសើរឡើង តាមរយៈ ការដាក់ចេញ នូវ ផែនការ យុទ្ធសាស្រ្ដ អភិវឌ្ឍន៍ ជាតិ ឆ្នាំ ២០២៤ - ២០២៨ ដែល ប្រែ កម្មវិធី អាទិភាព ចំនួន ៥ ។
លោក រដ្ឋមន្រ្ដី បាន ផ្ដាំផ្ញើ ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ រាជធានី ភ្នំពេញ ដូច ខាងក្រោម៖
* មន្ទីរ អភិវឌ្ឍន៍ ជនបទ រាជធានី ត្រូវ សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ដើម្បី កំណត់ ភូមិ គំរូ នៅក្នុង ខណ្ឌ ជាយ រាជធានី ដោយ ផ្អែក លើស ក្ដានុពល សំខាន់ ៗ ទៅ តាម លក្ខណៈ វិនិច្ឆ័យ នៃ ភូមិ គំរូ ។
* ត្រូវ បន្ដ ថែរក្សា សមិទ្ធផល និង ស្នាដៃ ដែល មាន កន្លងមក ជា មូលដ្ឋាន និង ខិតខំ បង្កើន សមិទ្ធផល និង ស្នាដៃ ថ្មី បន្ថែម ទៀត ដើម្បី ចូលរួម សម្រេច ឱ្យ បាន ចក្ខុវិស័យ កម្ពុជា ឆ្នាំ ២០៣០ និង ឆ្នាំ ២០៥០ ។
* ត្រូវ ខិតខំ បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន ប្រកបដោយ ការទទួលខុសត្រូវ និង ប្រកាន់ខ្ជាប់ នូវ សីលធម៌ វិជ្ជាជីវៈ ព្រមទាំង ចាត់ទុក ខ្លួន ឯង ជា មន្ដ្រី បម្រើ ឱ្យ ប្រជាពលរដ្ឋ ប្រកបដោយ សុចរិតភាព ។
* មន្ទីរ ត្រូវ ខិតខំ បំពេញ តួនាទី ជា សេនាធិការ ឱ្យ បាន ល្អ និង សុចរិត ដល់ រដ្ឋបាល រាជធានី មាន កិច្ចសហការ ល្អ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ មន្ទីរ ពាក់ព័ន្ធ នានា ព្រមទាំង អង្គការ ក្រៅ រដ្ឋាភិបាល ដៃគូ អភិវឌ្ឍ ដែល មាន បទពិសោធន៍ និង ធនធាន ដើម្បី ជំរុញ ការងារ អភិវឌ្ឍ ជនបទ ឱ្យ កាន់តែ ល្អ ប្រសើរឡើង ។
* មន្ទីរ ត្រូវ បង្កើត ឱ្យ មាន ក្រុម អ្នកនាំពាក្យ របស់ ខ្លួន ដើម្បី ផ្ដល់ ព័ត៌មាន ក្នុង គោលដៅ ចូលរួម ផ្សព្វផ្សាយ សមិទ្ធផល របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង អភិវឌ្ឍន៍ ជនបទ ឱ្យ បាន ទូលំទូលាយ ដល់ មហាជន ។
* ត្រូវ មាន ឯកភាព សាមគ្គីភាព ផ្ទៃក្នុង ឱ្យ បាន ល្អ យកចិត្តទុកដាក់ លើ សុខ ទុក្ខ របស់ មន្រ្ដី រាជការ និង ត្រូវ មាន ការលើកទឹកចិត្ត តាមរយៈ ការដំឡើង តួនាទី ឋានន្ដរស័ក្ដិ គ្រឿង ឥស្សរិយយស ឬ មធ្យោបាយ ផ្សេង ៗ ជាពិសេស មន្ដ្រីរាជការ ជាស្រ្ដី មាន ផ្ទៃពោះ ឬ មាន កូន តូច ជាដើម ៕
សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង សុខាភិបាល តំបន់ Gaza បាន អះអាង ថា ទៀត ថា មនុស្ស សរុប ចំនួន ៦៤. ៤៨៧ នាក់ ក៏ បាន ទទួលរង របួស ផងដែរ នៅក្នុង ដែនដី ប៉ាឡេ ស្ទីន មួយ នេះ អំលុង សង្រ្គាម របស់ អ៉ី ស្រាអែល ដែល កំពុង បន្ត អូសបន្លាយ អស់ រយៈពេល ជាង ៣ខែ មក ហើយ ។ យោង តាម ប្រភព ដដែល មាន ជនជាតិ ប៉ាឡេ ស្ទីន សរុប ១៨៣ នាក់ បាន បាត់បង់ជីវិត នៅក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ។
អ្នក ជាប់ ពន្ធ ដែល ជា ម្ចាស់ អចលន ទ្រព្យ ត្រូវ រួសរាន់ មក ចុះបញ្ជី ឬ ធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន អចលន ទ្រព្យ របស់ ខ្លួន នៅ អគ្គ នាយកដ្ឋាន ពន្ធដារ ឬ សាខា ពន្ធដារ ខេត្ត - ខណ្ឌ ដែល អចលន ទ្រព្យ ស្ថិត នៅ ដោយ ភ្ជាប់ មក ជាមួយ នូវ ឯកសារ សំខាន់ ៗ មួយចំនួន ដូច ជា៖
អ្នក ជាប់ ពន្ធ ត្រូវ ផ្ដល់ ព័ត៌មាន ជូន រដ្ឋបាល សារពើពន្ធ ( បច្ចុប្បន្នភាព ព័ត៌មាន អចលន ទ្រព្យ ) ដោយ ត្រូវ ភ្ជាប់ មក ជាមួយ នូវ ឯកសារ ដូ ច បាន បញ្ជាក់ ខាងលើ រួម ជាមួយ បង្កាន់ដៃ បញ្ជាក់ ការបង់ប្រាក់ ពន្ធនា ឆ្នាំ កន្លងមក ឬ លេខ អត្តសញ្ញាណកម្ម អចលន ទ្រព្យ (PIN) ឬ ប័ណ្ណ សម្គាល់ ការបង់ ពន្ធ លើ អចលន ទ្រព្យ ចំពោះ អចលន ទ្រព្យ ដែល៖
* អចលន ទ្រព្យ ត្រូវបាន ផ្លាស់ប្ដូរ កម្មសិទ្ធិ ករ អ្នកកាន់កាប់ ឬ អ្នក ទទួល ប្រយោជន៍ ចុងក្រោយ នៃ អចលន ទ្រព្យ ៕ សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី ផ្ញើ សារ ជូនពរ និង អបអរសាទរ ជូន ឯកឧត្តម មាស សុភា ដែល ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា កម្ពុជា ព្រមទាំង សមាជិក សមាជិកា និង មន្រ្តី រដ្ឋសភា ទាំងអស់ បាន ផ្ញើ សារ ជូនពរ និង សូម ចូលរួម អបអរសាទរ ជូន ចំពោះ ឯកឧត្តម មាស សុភា ដែល ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ជា ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ មាន ឋានៈ ស្មើ ឧប នាយក រដ្ឋមន្រ្តី ។
នា ឱកាស ដ៏ មង្គល សួស្ដី ថ្លៃថ្លា រីករាយ នេះ យើងខ្ញុំ សូម បួងសួង ដល់ តេជ បារមី នៃ វត្ថុ ស័ក្តិសិទ្ធិ ទាំងអស់ ក្នុង លោក ទេវតា ថែរក្សា ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា សូម អភិបាល ប្រោះ ព្រំ ប្រសិទ្ធ ពរ ជ័យ ជូន ឯកឧត្តម មាស សុភា និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ បុត្រា បុត្រី ជា ទីស្រឡាញ់ សូម បន្ត ជោគជ័យ គ្រប់ ភារកិច្ច និង សូម បាន ប្រកបដោយ ព្រះពុទ្ធ ពរ ទាំង៤ ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
កម្លាំង សមត្ថកិច្ច ចម្រុះ ចុះ ត្រួតពិនិត្យ ទីតាំង ដី ព្រៃឈើ របស់ រដ្ឋ រាប់ រយ ហិកតា ដែល រង ការកាប់ ទន្ទ្រាន និង ដុត បំផ្លាញ នៅ ស្រុក កូនមុំ ខេត្ត រតនគិរី
( រតនគិរី ) ៖ លោក ខ័ណ្ឌ ចំណាន អភិបាល រង ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន ដឹកនាំ កម្លាំង អាវុធហត្ថ ខេត្ត កម្លាំង នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច ខេត្ត មន្ត្រី បរិស្ថាន មន្ត្រី សុរិយោ ខេត្ត មន្ត្រី រដ្ឋបាល ព្រៃឈើ រួម នឹង អាជ្ញាធរ ស្រុក កូនមុំ កម្លាំង អាវុធហត្ថ មូលដ្ឋាន ស្រុក កូនមុំ និង កម្លាំង នគរបាល អធិការ ស្រុក កូនមុំ ចុះ ត្រួតពិនិត្យ ទីតាំង ដី ព្រៃ របស់ រដ្ឋ ជាច្រើន កន្លែង មាន ផ្ទៃដី រាប់ រយ ហិកតា ដែល រង ការកាប់ ទន្ទ្រាន និង ដុត បំផ្លាញ យក ដី ធ្វើ កម្មសិទ្ធ ។
តំបន់ ដី ព្រៃឈើ ដែល រង ការកាប់ ទន្ទ្រាន និង ដុត បំផ្លាញ នេះ ស្ថិត នៅ ត្រង់ ចំណុច អូរ កា ជាន់ ក្រោម ( កន្ទុយ ដី ក្រុមហ៊ុន SK) ស្ថិត ក្នុង ឃុំ តឺន ស្រុក កូនមុំ មាន ព្រំប្រទល់ ជាប់ ឃុំ ហាត់ ប៉ក់ ស្រុក វ៉ើន សៃ ការចុះ ដែរ ធ្វើឡើង ក្រោយ ទទួលបាន ព័ត៌មាន លើ បណ្តាញ ផ្សា ព្វផ្សាយ ថា មាន ការកាប់ ទន្ទ្រាន និង ដុត បំផ្លាញ ព្រៃ នៅ តំបន់ ខាងលើ ។
បើ តាម ក្រុមការងារ ដែល ដឹកនាំ ដោយ លោក ខ័ណ្ឌ ចំណាន បាន ឲ្យដឹង ថា ភូមិសាស្ត្រ នៅ កន្លែង រង ការកាប់ ទន្ទ្រាន និង ដុត បំផ្លាញ ដី ព្រៃឈើ របស់ រដ្ឋ មាន ភាពស្មុគស្មាញ មិន អាច ចូល ទៅដល់ ដូច្នេះ ត្រូវការ ដ្រូន បង្ហោះ ថត ផ្តិត យក រូបភាព ទើប អាច វាយតម្លៃ បាន ៕
គួរ បញ្ជាក់ ថា ការវាយប្រហារ នេះ បាន កើតឡើង តែ ប៉ុន្មាន សប្តាហ៍ ប៉ុណ្ណោះ បន្ទាប់ពី មេដឹកនាំ គណបក្ស ប្រឆាំង លោក Lee Jae-myung ត្រូវបាន គេ ចាក់ ឲ្យ របួស នៅពេល កំពុង ថ្លែង ទៅកាន់ អ្នកសារព័ត៌មាន នៅក្នុង ទីក្រុង កំពង់ផែ Busan របស់ កូរ៉េ ខាងត្បូង ៕ រូបភាព ពី AFP សាលាដំបូង ខេត្ត កំពង់ស្ពឺ ប្រកាស ព័ត៌មាន ពី ការផ្តន្ទាទោស ជន ជាប់ចោទ ៥នាក់ ដាក់ ពន្ធនាគារ ៣០ ឆ្នាំ ករណី រក្សាទុក ដឹកជញ្ជូន និង ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីប្រកាស ព័ត៌មាន៖ ក្រសួង និង ដៃគូ ខិតខំ ពន្លឿន រៀបចំ ស្ដង់ដា គុណ វុឌ្ឍិជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ កម្រិត ២ សញ្ញាបត្រ វិជ្ជាជីវៈ១ លើ ជំនាញ ការិយាល័យ ជួរ មុខ និង សេវាកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ
ជាក់ស្ដែង នា ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ ក្រសួង ទេសចរណ៍ បាន ដឹកនាំ រៀបចំ សិក្ខាសាលា ពិគ្រោះយោបល់ ស្ដីពី សេចក្ដីព្រាង កម្មវិធី សិក្សា ផ្អែក លើ សមត្ថភាព សម្រាប់ រៀបចំ គុណ វុឌ្ឍិជាតិ វិជ្ជាជីវៈ ទេសចរណ៍ កម្រិត ២ សញ្ញបត្រ វិជ្ជាជីវៈ ១ (C1) លើ ជំនាញ ការិយាល័យ ជួរ មុខ និង សេវាកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ នៅ ភោជនីយដ្ឋាន បាយ័ន កាល់ម៉ែត ។
លោក ជួប រតនា ប្រធាន នាយកដ្ឋាន ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ និង ជា ប្រធាន លេខាធិការដ្ឋាន គណៈកម្មការ គម្រោង បណ្ដុះបណ្ដាល HoKa បាន ឱ្យដឹង ថា ក្នុង ការរៀបចំ គុណ វុឌ្ឍិជាតិ សម្រាប់ មុខរបរ ណាមួយ គឺ ត្រូវ ឆ្លងកាត់ ជំហាន ចំនួន ៤ រួម មាន៖ ជំហាន ទី១ - ត្រូវ រៀបចំ កម្រង សមត្ថភាព ជំហាន ទី២ - រៀបចំ ស្ដង់ដា សមត្ថភាព ជំហាន ទី៣ - រៀបចំ កម្មវិធី បណ្ដុះបណ្ដាល ផ្អែក លើ សមត្ថភាព និង ជំហាន ទី៤ - រៀបចំ កម្មវិធី វាយតម្លៃ ផ្អែក លើ សមត្ថភាព ។
លោក រតនា ក៏ បាន បញ្ជាក់ ពី គោលបំណង នៃ ការរៀបចំ គុណ វុឌ្ឍិជាតិ លើ ជំនាញ ការិយាល័យ ជួរ មុខ និង សេវាកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ នេះ ថា គឺ ដើម្បី ផ្ដល់ ការបណ្ដុះបណ្ដាល រួម ដូចគ្នា ដល់ សិក្ខាកាម ហើយ នៅពេល សិក្ខាកាម ទទួលបាន ជំនាញ ក៏ មាន សមត្ថភាព ប្រកបដោយ ស្ដង់ដា ដូចគ្នា ដែរ ។ ការងារ នេះ ក៏ គឺជា ការរួមចំណែក ជាមួយ ផែនការបណ្ដុះបណ្ដាល ជំនាញ បច្ចេកទេស និង វិជ្ជាជីវៈ ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង រង ហានិភ័យ ប្រមាណ ១. ៥លាន នាក់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ផងដែរ ។
ជា ការចែករំលែក បទពិសោធន៍ របស់ លោក ស្រូ រិទ្ធី គ្រូបង្គោល ជាតិ និង អាស៊ាន ក្នុង វិស័យ ទេសចរណ៍ មួយ រូប ដែរ នោះ បាន លើកទឹកចិត្ត ដល់ យុវជន កម្ពុជា ពិសេស អ្នក ដែល ប្រឡង ធ្លាក់ បាក់ឌុប ឬក៏ អ្នកបោះបង់ ការសិក្សា ពីមុន មក សូម កុំ អស់សង្ឃឹម ឬ លះបង់ ការតស៊ូ ឱ្យ សោះ ។ យុវជន អាច ងាក មក ចាប់ យក ជំនាញ ណាមួយ ក្នុង វិស័យ ទេសចរណ៍ ឬ មក ទទួល ការបណ្ដុះបណ្ដាល ពី សាលា បណ្ដុះបណ្ដាល ជំនាញ ទេសចរណ៍ ដើម្បី ចាប់ យក ជំនាញ ណាមួយ ឱ្យ បាន ច្បាស់លាស់ ព្រោះ ជំនាញ ក្នុង វិស័យ ទេសចរណ៍ មិន ពិបាក រក ការងារ ធ្វើ នោះ ឡើយ ។
កូន ដំរី ព្រៃ មួយ ក្បាល ត្រូវបាន ប្រជាជា ពលរដ្ឋ នៅ ស្រុក កោះ ញែក ប្រទះឃើញ ដេក ស្លាប់ កណ្តាល ព្រៃ សង្ស័យ ការបាញ់ប្រហារ ដោយ កាំភ្លើង . សង្ឃឹម ថា អាជ្ញាធរ និង សមត្ថកិច្ច ពាក់ព័ន្ធ តាម ស្វែងរក ជន បង្ក មក ផ្តន្ទាទោស តាម ច្បាប់
លោក បាន បញ្ជាក់ ថា កូន ដំរី ព្រៃ ដែល ស្លាប់ នោះ ប្រហែល មាន អាយុ ៦ខែ ប៉ុណ្ណោះ ។ ក្រុម ប្រជាពលរដ្ឋ នៅ ខេត្ត មណ្ឌលគិរី បាន នាំគ្នា លើកឡើង ថា មន្រ្តី ជំនាញ នៃ មន្ទីរ បរិស្ថាន ខេត្ត មណ្ឌលគិរី មួយចំនួន ជាពិសេស មន្រ្តី ៗ ដែល មាន តួនាទី ជា នាយក ដែន ជំរក សត្វ ព្រៃ នៅ ខេត្ត មណ្ឌលគិរី ហាក់បីដូចជា គ្មាន សមត្ថភាព ទប់ស្កាត់ អភិរ័ក្ស ថែរក្សា ឬ ការពារ សត្វ ព្រៃ គ្រប់ ប្រភេទ ដែល ជា អម្បូរ ជីវះ ចម្រុះ សត្វ កម្រ នៅក្នុង ដែន សមត្ថកិច្ច ដែល ខ្លួន គ្រប់គ្រង នោះ ទេ ។
ពលរដ្ឋ សង្ឃឹម ថា សម្រាប់ ករណី នេះ អាជ្ញាធរ និង សមត្ថកិច្ច ពាក់ព័ន្ធ នឹង បើក ការស្រាវជ្រាវ តាម ចាប់ ជន បង្ក មក ផ្តន្ទាទោស តាម ច្បាប់ យ៉ាង តឹងរឹង ជា ទីបំផុត ៕ បញ្ចុះ បឋមសិលា សាងសង់ អគារ រដ្ឋបាល កងរាជអាវុធហត្ថ ចល័ត និង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្សេង ៗ ទៀត របស់ កងរាជអាវុធហត្ថ ក្រុង បាវិត
( ស្វាយរៀង ) ៖ លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ក្នុង ពិធី បញ្ចុះ បឋមសិលា សាងសង់ អគារ រដ្ឋបាល កងរាជអាវុធហត្ថ ចល័ត និង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្សេង ៗ ទៀត របស់ កងរាជអាវុធហត្ថ ក្រុង បាវិត ស្ថិត នៅ ភូមិ ត្រពាំង ថ្លុង សង្កាត់ បាទី ក្រុង បាវិត ។
ក្រោម ការការយកចិត្តទុកដាក់ របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស បាន លើកទឹកចិត្ត ដល់ បណ្តា រាជធានី - ខេត្ត ឲ្យ យកចិត្តទុកដាក់ លើ កាងារ កសាង អង្គភាព ពី ថ្នាក់ ខេត្ត ដល់ ក្រុង - ស្រុក ដើម្បី សម្រេច ក្នុង ការអនុវត្ត តួនាទី ភារកិច្ច ។
ទន្ទឹមនឹង ការយកចិត្តទុកដាក់ ពីសំណាក់ លោក ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ក្នុង នោះ កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង បាន ធ្វើឲ្យ កម្លាំង អាវុធហត្ថ ខេត្ត ចូលរួមចំណែក អនុវត្ត នូវ បទបញ្ជា ក្នុង ការបង្ការ ទប់ ស្តាត់ និង បង្ក្រាប បទល្មើស ផ្សេង ៗ បាន ទាន់ ពេលវេលា ជាពិសេស បាន អនុវត្ត នូវ កិច្ចការងារ ស្នូល សំខាន់ ៗ រួម មាន៖
ជាមួយគ្នា នេះ អគារ សេនាធិការដ្ឋាន អគារ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង - ស្រុក បាន សាងសង់ រួច នឹង កំពុង ដំណើរការ សាងសង់ ជា បន្តបន្ទាប់ ជាក់ស្តែង អគារ កង អន្តរាគមន៍ កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង ដែល សាងសង់ លើ ផ្ទៃដី ថ្មី ទំហំ ៨.២៧៨ ម៉ែត្រ ការ៉េ បាន ប្រារព្ធ ពិធី បញ្ចុះ បឋមសិលា សាងសង់ នៅ ថ្ងៃ នេះ ៕
អ្នកស្រាវជ្រាវ ផ្នែក សេដ្ឋកិច្ច លើក ពី វិធីសាស្រ្ត គ្រប់គ្រង ការចំណាយ ប្រកបដោយ សុវត្ថិភាព និង មាន ប្រសិទ្ធិភាព
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ គ្រប់ រូប តែង ប្រឈម នឹង ការចំណាយ រៀងរាល់ ថ្ងៃ នៅក្នុង ជីវភាព រស់ នៅ ។ អ្នក ខ្លះ ក៏ គ្រប់គ្រង ការចំណាយ បាន ល្អ ប៉ុន្តែ អ្នក ខ្លះ ទៀត គ្រប់គ្រង ពុំ បាន ល្អ ដែល ធ្វើឱ្យ ខ្លួន គាត់ និង ក្រុមគ្រួសារ ជួបប្រទះ បញ្ហា តានតឹង ផ្នែក ហិរញ្ញវត្ថុ ។
លោក អាន ស៊ី ថា វ អ្នកស្រាវជ្រាវ ព័ត៌មាន សេដ្ឋកិច្ច ចែករំលែក បទពិសោធន៍ ខ្លះ អំពី ការគ្រប់គ្រង ការចំណាយ ដោយ ឈរ លើ មូលដ្ឋាន ការស្រាវជ្រាវ ព័ត៌មាន មួយចំនួន ដូចតទៅ៖ មជ្ឈមណ្ឌល ជាតិ ផ្ដល់ ឈាម ទទួលបាន អ្នកបរិច្ចាគ ឈាម ជាង ១០០ នាក់ ពី យុទ្ធនាការ ធនាគារ ឈាម ម៉េង លី ជេ. គួច
( ភ្នំពេញ ) ៖ មជ្ឈមណ្ឌល ជាតិ ផ្ដល់ ឈាម ទទួលបាន អ្នកបរិច្ចាគ ឈាម ជាង ១០០ នាក់ ពី យុទ្ធនាការ ធនាគារ ឈាម ម៉េង លី ជេ. គួច និង បាន វាយតម្លៃ ថា ព្រឹត្តិការណ៍ នេះ ពិតជា ព្រឹត្តិការណ៍ ដ៏ មាន អត្ថន័យ ខ្លឹមសារ ក្នុង ការចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ជាពិសេស មជ្ឈមណ្ឌល ជាតិ ផ្តល់ ឈាម ។
ទាក់ទិន នឹង យុទ្ធនាការ ធនាគារ ឈាម ម៉េង លី ជេ. គួច នេះ ផងដែរ លោកស្រី វេជ្ជបណ្ឌិត មើក សាមាន អនុប្រធាន មជ្ឈមណ្ឌល ជាតិ ផ្ដល់ ឈាម បាន សម្ដែង នូវ សេចក្តីសាទរ ចំពោះ មូលនិធិ ម៉េង លី ជេ. គួច ដែល បាន រៀបចំ ព្រឹត្តិការណ៍ សប្បុរស នេះ ឡើង ដោយ មាន អ្នកស្ម័គ្រចិត្ត បរិច្ចាគ ឈាម កាន់តែ ច្រើន ឡើង ៗ បើ ប្រៀប ទៅនឹង ព្រឹត្តិការណ៍ មុន ៗ ។
លោកស្រី ក៏ បាន បង្ហាញ នូវ ក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា មូលនិធិ ម៉េង លី ជេ. គួច របស់ អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី នឹង ពាំនាំ ព្រឹត្តិការណ៍ នេះ ឱ្យ កើត មាន ឡើង ជា បន្តបន្ទាប់ នា ពេល ខាងមុខ ដើម្បី រួមចំណែក សង្រ្គោះ អាយុជីវិត របស់ កុមារ និង អ្នកជំងឺ រាប់ ម៉ឺន នាក់ នៅក្នុង មន្ទីរពេទ្យ នានា ។
គោលបំណង នៃ យុទ្ធនាការ បរិច្ចាគ ឈាម នេះ គឺ ដើម្បី ជួយ សម្រួល ការព្យាបាល ជំងឺ ដល់ ជនរងគ្រោះ ជាពិសេស កុមារ និង អ្នកជំងឺ ក្នុង ស្ថានភាព ធ្ងន់ធ្ងរ និង ការស្វះស្វែងរក ធនធាន ទាំង ខាងក្នុង និង ក្រៅ ដើម្បី ជួយ ស្រោចស្រង់ ជីវិត អ្នក ដែល កំពុង ត្រូវការ ជំនួយ បន្ទាន់ ។
ថ្លែង ក្នុង ពិធី បើក យុទ្ធនាការ ធនាគារ ឈាម ម៉េង លី ជេ. គួច នោះ ដែរ លោក ឡាយ សុភា ប្រធាន នៃ មជ្ឈមណ្ឌល ភាសា អេ អាយ អាយ បាន សម្ដែង ការយល់ឃើញ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ ជឿជាក់ ថា ការចូលរួម នៅក្នុង ព្រឹក នេះ គឺ មាន សារៈសំខាន់ ខ្លាំង និង ធំ ធេង ណាស់ ពីព្រោះ ឈាម ដែល យើង បាន បរិច្ចាគ នេះ គឺ អាច យក ទៅ ជួយ អាយុជីវិត របស់ ប្រជាជន យើង ដែល ពួកគាត់ ត្រូវការ ឈាម ជា ចាំបាច់ ហើយ បច្ចុប្បន្ន ក្នុង សង្គម យើង សូម្បី កុមារ ក្តី ក៏ ត្រូវការ ឈាម ច្រើន ផងដែរ » ។
អ្នកស្ម័គ្រចិត្ត បរិច្ចាគ ឈាម ម្នាក់ ក្នុង ចំណោម អ្នកបរិច្ចាគ ឈាម កញ្ញា នួន សោភា ដែល ជា និស្សិត សាកលវិទ្យាល័យ បាន យល់ឃើញ ពី សារៈប្រយោជន៍ នៃ ការបរិច្ចាគ ឈាម បែប នេះ ថា « ការផ្តល់ ឈាម វា មាន សារៈប្រយោជន៍ មែនទែន មិន ថា សម្រាប់ កុមារ ឬ អ្នកជំងឺ នៅ តាម មន្ទីរពេទ្យ នោះ ទេ តាមពិត ទៅ បើ យើង ក្រឡេក មើល នៅ មន្ទីរពេទ្យ គឺ ច្រើន មែនទែន សឹង គ្រប់ នាទី ពួកគាត់ ត្រូវការ ( ឈាម ) មែនទែន » ។
ក្រោយពី ទទួលបាន ព័ត៌មាន នេះ ភ្លាម . លោក ឧត្តមសេនីយ៍ ឯក ស រដ្ឋា អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ បាន ចាត់ ឲ្យ កម្លាំង សមត្ថកិច្ច ចម្រុះ ចុះ ទៅ កន្លែង កើត ហេតុ ដើម្បី អន្តរាគមន៍ ស្រាវជ្រាវ តាម ចាប់ ជន បង្ក ។
ក្នុង ប្រតិបត្តិការ នេះ ដែរ កម្លាំង ជំនាញ បាន កំណត់ មុខ សញ្ញា ជនសង្ស័យ មួយ ក្រុម ដែល បង្ក ហិង្សា ហើយ បាន ខ្លួន ខណៈ អ្នក បង្ក មួយចំនួន កំពុង រត់គេចខ្លួន ។
ក្រោយ កើត ហេតុ សមត្ថកិច្ច បាន បញ្ជូន ខ្លួន ជនរងគ្រោះ ទៅ មន្ទីរពេទ្យ ដោយ ស្ថាន ធ្ងន់ធ្ងរ បាន បញ្ជូន យក ទៅ សង្គ្រោះ បន្ទាន់ នៅ ភ្នំពេញ ប៉ុន្តែ បាន ស្លាប់ ពេល ដល់ មន្ទីរពេទ្យ ។ ជនរងគ្រោះ មាន ស្រុក កំណើត នៅ ខេត្ត សៀមរាប ។
ជុំវិញ ករណី ក្រុម ក្មេង ស្ទាវ ខាងលើ នេះ ដែរ លោក វរសេនីយ៍ ឯក លី សុខ ហ៊ី ស្នងការ រង ទទួល ផែន ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ បាន បញ្ជាក់ ថា ចំពោះ ករណី នេះ សមត្ថកិច្ច បាន ឃាត់ខ្លួន ជនសង្ស័យ បាន ជាង ១០នាក់ និង កំពុង ធ្វើ ការសាកសួរ ស្រាវជ្រាវ បក្ខពួក ដែល នៅ សេសសល់ បន្ត ទៀត ៕
( ស្វាយរៀង ) ៖ មាន ឈ្មួញ ក្នុង ស្រុក ដើរ ប្រមូល ទិញ អាចម៍ គោ អាចម៍ ក្របី លក់ ឲ្យ ឈ្មួញ វៀតណាម ដឹក ឆ្លង ដែន ទៅ ប្រទេស វៀតណាម តាម ច្រក របៀង នានា ក្នុង ស្រុក ចន្រ្ទា ជារៀងរាល់ ថ្ងៃ ដោយ ឈ្មួញ វៀតណាម ថា ទិញ អាចម៍ គោ អាចម៍ ក្របី ទាំងនេះ សម្រាប់ ច្នៃ ធ្វើ ជីលក់ ។
ប្រជាកសិករ អ្នក ចិញ្ចឹម សត្វ គោ និង ក្របី បាន លើកឡើង ថា បើ គិត ជា មធ្យម ក្នុង ឃុំ ចន្ទ្រា យ៉ាងតិច ៣០០ គ្រួសារ ដែល ចិញ្ចឹម គោ ក្របី ហើយ ប្រជាពលរដ្ឋ ដែល រស់ តាម បន្ទាត់ ព្រំដែន ក្នុង ស្រុក ចន្ទ្រា គឺ មាន ប្រមាណ ៨០ ភាគរយ ហើយ ដែល ប្រកប មុខរបរ ចិញ្ចឹម សត្វ គោ ក្របី ដើម្បី យក អាចម៍ គោ ក្របី លក់ ឲ្យ ឈ្មួញ វៀតណាម ។ ក្នុង ស្រុក ចន្ទ្រា គឺ មាន ៦ឃុំ មាន ឃុំ ចន្ទ្រា ឃុំ ច្រេស ឃុំ គគីរ ឃុំ មេស ថ្ង ក ឃុំ សំរោង និង ឃុំ ទួល ស្តី ដូច្នេះ បើ រាប់ អ្នក ចិញ្ចឹម ក្របី គឺ មិន តិច ជាង ១ពាន់ គ្រួសារ ទេ ។
ទាក់ទិន ករណី នេះ បើ តាម មន្ត្រី ជំនាញ នៃ មន្ទី កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង ថា នៅក្នុង ស្រុក ចន្ទ្រា មាន ប្រជាពលរដ្ឋ ចិញ្ចឹម សត្វ គោ ក្របី សរុប ១៩១៣៤ ក្បាល ។ ក្នុង នោះ សត្វ ក្របី មាន ៨៥៣២ ក្បាល និង សត្វ គោ ចំនួន ១០៦០២ ក្បាល ។ នេះ បើ គិត ត្រឹម ឆមាស ទី១ ក្នុង ឆ្នាំ ២០២៣ ។
សូម បញ្ជាក់ ថា ប្រជាកសិករ ខ្មែរ នៅ តំបន់ ព្រំដែន តែងតែ ឆ្លង ដែន ទៅ ទិញ ជី ថ្នាំ ប្រេង ពី ប្រទេស វៀតណាម មក ប្រើប្រាស់ លើ ដំណាំ ស្រូវ និង បន្លែ ៕ ផ្ទៃដី ១៦៣ ហិកតា នៅ តំបន់ ៣ ក្នុង សង្កាត់ ស្រយ៉ូវ ក្រុង ស្ទឹង សែន ត្រូវបាន ជន ខិលខូច លួច ឈូសឆាយ ធ្វើជា កម្មសិទ្ធិ
( កំពង់ធំ )៖ មួយ រយៈពេល នេះ ក្រោយ សង្កេតឃើញ ជន ខិលខូច មួយចំនួន បាន នាំគ្នា មក រំលោភ ដី រដ្ឋ មក ធ្វើ ស្រូវ ប្រាំង នៅ ដី តំបន់ ៣ ដែល ជា តំបន់ ហាមឃាត់ របស់ រាជ រដ្ឋាភិបាល ពោល មិន អនុញ្ញាតឲ្យ អាស្រ័យ ផល នៅលើ ដី ឬ ជីក ប្រឡាយ យក ទឹក មក ស្រោចស្រព នៅលើ ស្រូវ ប្រាំង នោះ ទេ នៅ រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ បាន ដឹកនាំ កម្លាំង ជំនាញ ចម្រុះ ពិនិត្យ ទីតាំង ដី នៅ តំបន់ ។
សេចក្តីរាយការណ៍ របស់ មន្រ្តី សាលា ខេត្ត បាន ឲ្យដឹង ថា ជន ខិលខូច កំពុង រំលោភបំពាន ដី ធ្វើ ស្រែ ប្រាំង ចំនួន ១៦៣ ហិកតា ៧២ អា ស្ថិត នៅ តំបន់ គោក ព្រះ តំបន់ ខ្ទុម មួយ ដើម និង តំបន់ ស្នែង ក្របី នៅ សង្កាត់ ស្រយ៉ូវ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ ។
លោក អភិបាល ខេត្ត នៅក្នុង ឱកាស នោះ បាន ដាក់ បទបញ្ជា ទៅ លើ កងកម្លាំង ទាំង៣ និង អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ចុះ តាមដាន សកម្មភាព របស់ ជន ខិលខូច ដែល មក ធ្វើ ស្រូវ ប្រាំង នៅ តំបន់ ហាមឃាត់ នេះ អនុវត្ត នីតិវិធី តាម ផ្លូវ ច្បាប់ ។ ចំពោះ ការឈូសឆាយ នេះ លោក មិន អនុញ្ញាត នោះ ទេ លោក នឹង ចាត់ វិធានការ តឹងរឹង ដើម្បី ផ្ដន្ទាទោស ៕
គណៈកម្មការ ជាតិ រៀបចំ ការបោះឆ្នោត ខេត្ត ស្ទឹងត្រែង បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្ដីពី ការចុះបញ្ជី គណបក្ស នយោបាយ និង បេក្ខជន ឈរឈ្មោះ
( ស្ទឹងត្រែង )៖ គណៈកម្មការ ជាតិ រៀបចំ ការបោះឆ្នោត ខេត្ត ស្ទឹងត្រែង នៅ រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ បាន បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្ដីពី ការចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បេក្ខជន ឈរឈ្មោះ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ។
កិច្ចប្រជុំ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នៅឯ លេខាធិការដ្ឋាន រៀបចំ ការបោះឆ្នោត ខេត្ត ស្ទឹងត្រែង ក្រោម អធិបតីភាព លោក ញ៉ែ ម សារី អភិបាល រង ខេត្ត និង លោក ហង់ កុង ប្រធាន គណៈកម្មការ រៀបចំ ការបោះឆ្នោត ខេត្ត ស្ទឹងត្រែង និង សមាជិក សមាជិកា លោក លោកស្រី ប្រធាន អនុប្រធាន មន្ទីរ ស្ថាប័ន ពាក់ព័ន្ធ កងកម្លាំង ទាំង៣ ប្រភេទ និង តំណាង គណបក្ស នយោបាយ ផងដែរ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ហង់ កុង បាន ថ្លែង ថា កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្នុង គោលបំណង ផ្តោត លើ ចំណុច សំខាន់ ដូច ជា៖
* ការបិទ ផ្សាយ បញ្ជី បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត * ការអនុវត្ត ការងារ បោះឆ្នោត ត្រូវបាន ឆ្លងកាត់ ដំណាក់កាល សំខាន់ ៗ ចំនួន ០២ ( ដំណាក់កាល នៃ ការចុះឈ្មោះ បោះឆ្នោត និង ដំណាក់កាល នៃ ការចុះឈ្មោះ គណបក្ស នយោបាយ និង បញ្ជី បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត )* ការប្រើប្រាស់ និង បំពេញ ទម្រង់បែបបទ ១០០៧ ( ទ. ១០០៧ )* ផែនការឃោសនា បោះឆ្នោត របស់ គណបក្ស នយោបាយ * អំពី ការិយាល័យ បោះឆ្នោត និង រាប់ សន្លឹក ឆ្នោត ។
ក្នុង កិច្ចប្រជុំ នោះ ក៏ មាន មតិ លើកឡើង ពី សមាជិក នៃ អង្គប្រជុំ ដែល មកពី តំណាង គណបក្ស នយោបាយ រួម មាន៖ តំណាង គណបក្ស ប្រជាន ជន កម្ពុជា គណបក្ស ឆន្ទៈ ខែ្មរ គណបក្ស ភ្លើង ទៀន គណបក្ស ហ៊្វុនស៊ិនប៉ិច និង តំណាង គណបក្ស កម្លាំង ជាតិ ។
លោក ញ៉ែ ម សារី បាន ថ្លែង ដ៏ មាន អត្ថន័យ ជូន អង្គប្រជុំ ដោយ ផ្តោត ទៅ លើ ការងារ រៀបចំ កម្លាំង ការពារ សន្តិសុខ សុវត្ថិភាព ឲ្យបាន ល្អ ប្រសើរ ជុំវិញ ការងារ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ការរៀបចំ សណ្តាប់ធ្នាប់ សាធារណៈ និង សុំឲ្យ ភាគី ពាក់ព័ន្ធ ជាពិសេស គណបក្ស នយោបាយ ត្រូវ សហការ គោរព ច្បាប់ និង ក្រមសីលធម៌ ឲ្យបាន ល្អ ប្រសើរ ជៀសវាង កុំ ឲ្យ កើតមាន អសន្តិសុខ ក្នុង ខេត្ត ជុំវិញ ការងារ បោះឆ្នោត ។
លោក ហង់ កុង ក៏ បាន ថ្លែង បូកសរុប និង បិទ អង្គប្រជុំ ដោយ បាន ធ្វើ ការ ផ្តាំផ្ញើ ដល់ ភាគី ពាក់ព័ន្ធ ជាពិសេស តំណាង គណបក្ស នយោបាយ ដែល ចូលរួម ប្រជុំ អនុវត្ត តាម បទបញ្ជា និង នីតិវិធី ក្រមសីលធម៌ ឲ្យបាន ត្រឹមត្រូវ ដើម្បី ចាក់ គ្រឹះ លទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ឲ្យបាន ល្អ ប្រសើរ ៕
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារលិខិត អបអរសាទរទូល ថ្វាយ សម្ដេច ព្រះមហិស្សរា នរោត្តម ច័ក្រពង្ស់ ដែល ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ ដំឡើង ព្រះឋានៈ ជា « សម្ដេច ក្រុម ព្រះ»
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ សារលិខិត អបអរសាទរ ថ្វាយ ចំពោះ សម្ដេច ព្រះមហិស្សរា នរោត្តម ច័ក្រ ពង្ស់ ឧត្ដមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ នៃ កម្ពុជា ដែល ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទ្រង់ សព្វ ព្រះរាជ ហឫទ័យ ត្រាស់បង្គាប់ ដំឡើង ព្រះឋានៈ ជា សម្ដេច ក្រុម ព្រះ នរោត្តម ច័ក្រពង្ស់ ។
( ភ្នំពេញ ) ៖ លោក អឿ សុធារ័ត្ន ប្រធាន នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ក្រេឌីត ប្យួរ៉ូ ខេមបូឌា ដែល ជា អ្នកជំនាញ ហិរញ្ញវត្ថុ មួយ រូប បាន លើកឡើង ថា ការប្រើប្រាស់ ប្រព័ន្ធ ចែករំលែក ឥណទាន CBC គឺ មាន ប្រយោជន៍ ណាស់ សម្រាប់ សាធារណជន ស្ថាប័ន ហិរញ្ញវត្ថុ និង សម្រាប់ សេដ្ឋកិច្ច ប្រទេសជាតិ ទាំងមូល មិន ថា តែ នៅ កម្ពុជា និង នៅក្នុង ពិភពលោក ក្តី ។
លោក បាន លើកឡើង តាមរយៈ ប្រព័ន្ធ CBC ចំពោះ អតិថិជន ដែល មាន ប្រវត្តិ ល្អ ពួកគាត់ នឹង មាន លទ្ធភាព ទទួលបាន កម្ចី កាន់តែ ខ្ពស់ ការអនុម័ត រហ័ស ព្រមទាំង ទទួលបាន លក្ខខណ្ឌ ល្អ ជាង គេ ផងដែរ ។
លោក បន្ថែម ថា « ជាទូទៅ យើង មើល ទៅ សាធារណជន នៅ ពេល ដែល គាត់ បង្កើត ប្រវត្តិ នៅក្នុង ប្រព័ន្ធ ចែករំលែក ព័ត៌មាន ឥណទាន ប្រវត្តិ នេះ ត្រូវបាន ផ្តល់ ទៅដល់ ស្ថាប័ន ហិរញ្ញវត្ថុ អីចឹង នៅ ពេល ដែល ស្ថាប័ន ហិរញ្ញវត្ថុ គាត់ ឃើញ ប្រវត្តិ អតិថិជន ប្រសិនបើ ជា ប្រវត្តិ ល្អ គាត់ អាច ផ្តល់ ឥណទាន បាន ខ្ពស់ ជាង មុន បើសិន ជា ប្រវត្តិ មិន ល្អ គាត់ អាច កាត់បន្ថយ ទំហំ ឥណទាន ទៅ តាម លទ្ធភាព សង របស់ សាធារណជន » ។
ទន្ទឹម គ្នា នេះ លោក លើកឡើង ថា វត្តមាន CBC នៅ កម្ពុជា បាន ជួយ ឱ្យ ប្រជាពលរដ្ឋ កម្ពុជា មាន លទ្ធភាព នៅក្នុង ការទទួលបាន នូវ ឥណទាន កាន់តែ ល្អ ប្រសើរ ជាង មុន ពោលគឺ ធ្លាក់ចុះ ពី ចំណាត់ថ្នាក់ ទី១០០ មកដល់ ចំណាត់ លេខ ៧ នៅក្នុង ពិភពលោក ៕
ថ្លែង ក្នុង កិច្ចពិភាក្សា លើ ប្រធានបទ៖ « ឥទ្ធិពល នៃ កេរ្តិ៍ឈ្មោះ មិន ល្អ ( ខូច CBC) លើ ការប្រើប្រាស់ សេវា គ្រឹះស្ថាន ហិរញ្ញវត្ថុ នៅ កម្ពុជា » លោក អឿ សុធារ័ត្ន បាន លើកឡើង ថា សេវា ហិរញ្ញវត្ថុ ប្រៀប បាន នឹង អាវុធ មុខ២ ដែល តម្រូវឲ្យ អតិថិជន ប្រើប្រាស់ សេវា នេះ ប្រកបដោយ ភាពទទួលខុសត្រូវ និង ប្រើប្រាស់ សេវា នេះ ដើម្បី ស្វែងរក ប្រាក់ ចំណេញ ជៀស ជាង ការខ្ចី បុល យក ទៅ ទិញ សម្ភារៈ និយម ផ្សេង ៗ ។
សូម ទស្សនា ការ លើកឡើង របស់ លោក អឿ សុធារ័ត្ន ប្រធាន នាយក ប្រតិបត្តិ CBC: រដ្ឋមន្ដ្រី សុខាភិបាល ជំរុញ លើកទឹកចិត្ដ ដល់ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បន្ដ ពង្រឹង សមត្ថភាព ដើម្បី រួមគ្នា លើកស្ទួយ វិស័យ សុខាភិបាល កាន់តែ រីកចម្រើន
( ភ្នំពេញ ) ៖ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន ជំរុញ លើកទឹកចិត្ដ ដល់ ថ្នាក់ដឹកនាំ និង បុគ្គលិក នៃ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បន្ដ អភិវឌ្ឍ ខ្លួន បន្ថែម ទៀត ដើម្បី ចូលរួមចំណែក ជាមួយ ក្រសួង សុខាភិបាល កម្ពុជា សំដៅ បម្រើ ប្រយោជន៍ សុខភាព ប្រជាជន ។
ការថ្លែង ដូច្នេះ របស់ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ក្នុង ឱកាស ដឹកនាំ ប្រតិភូ អញ្ជើញ ទស្សនកិច្ច នៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ ។
ក្នុង ដំណើរទស្សនកិច្ច ដែល ទទួលបាន ការស្វាគមន៍ យ៉ាង កក់ក្ដៅ ពី ថ្នាក់ដឹកនាំ និង បុគ្គលិក នៃ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា . លោក សាស្ដ្រាចារ្យ រដ្ឋមន្ដ្រី ក៏ បាន ថ្លែងអំណរគុណ ដល់ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា ដែល កន្លងមក បាន សហប្រតិបត្ដិការ ជាមួយ ក្រសួង សុខាភិបាល លើ កិច្ចការ ចូលរួម បណ្តុះបណ្តាល ធនធាន មនុស្ស កិច្ចការ ចែករំលែក ចំណេះដឹង រួមទាំង បទពិសោធន៍ ការងារ ជំនាញ ផ្នែក មន្ទីរពិសោធន៍ ផ្នែក ស្រាវជ្រាវ និង បច្ចេកទេស ផ្សេង ៗ ទៀត ។
លើស ពី នោះ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន រួមចំណែក ឆ្លើយតប ប្រឆាំង ការឆ្លង រាតត្បាត នៃ កូវីដ - ១៩ ជាមួយ ក្រសួង សុខាភិបាល ក៏ ដូច ក្នុង នាម ជា មន្ទីរពិសោធន៍ ទី មួយ នៅ កម្ពុជា ដែល អាច វិភាគ ធ្វើ រោគវិនិច្ឆ័យ បាន អាច ផ្ទេរ ចំណេះដឹង ទៅដល់ ក្រុមការងារ ផ្សេង ទៀត នៃ វិស័យ សុខាភិបាល ។
លោក សាស្ដ្រាចារ្យ រដ្ឋមន្ដ្រី ក៏ បាន គូស រម្លឹក ថា « ខ្ញុំ សង្ឃឹម យ៉ាង មុតមាំ ថា វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា នឹង បន្ដ ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត ដើម្បី ធានា បាន នូវ គុណភាព ប្រសិទ្ធិភាព និង ន វានុវត្ដន៍ ធ្វើ យ៉ាងណា ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្ដិការ រវាង វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា និង ក្រសួង សុខាភិបាល ក្នុង ការបង្កើន ការបណ្ដុះបណ្ដាល ធនធាន មនុស្ស និង បច្ចេកទេស ផ្សេង ៗ ទៀត ជាពិសេស នៅ ពេល ដែល មាន ការរីកសាយភាយ ការឆ្លង ជា សកល » ។
ជាង នេះ ទៅ ទៀត លោក សាស្ដ្រាចារ្យ រដ្ឋមន្ដ្រី ក៏ សង្ឃឹម ថា វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា នឹង ទទួលបាន នូវ ការ ពង្រីក ក្នុង ការអភិវឌ្ឍ ដើម្បី បំពេញ ទៅ តាម តម្រូវការ របស់ វិទ្យាស្ថាន ប៉ាស្ទ័រ ទៅ តាម ក្បួន ខ្នាត វិទ្យាស្ថាន ប៉ាស្ទ័រ ប៉ារីស ដោយ ប្រមូលផ្ដុំ នូវ ធនធាន ទាំងឡាយ អភិវឌ្ឍន៍ វិទ្យាស្ថាន ប៉ាស្ទ័រ នៅ កម្ពុជា ឱ្យ កាន់តែ រីកចម្រើន ជាពិសេស ការបំពេញ នូវ មុខងារ បន្ថែម ដល់ មន្ទីរពិសោធន៍ កម្ពុជា ។
( ភ្នំពេញ ) ៖ លោក អឿ សុធារ័ត្ន ប្រធាន នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ក្រេឌីត ប្យួរ៉ូ ខេមបូឌា (CBC) បាន លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ដែល កម្ពុជា ជាប់ កម្ចី ជាមួយ គ្រឹះស្ថាន ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ ហើយ មាន បញ្ហា ក្នុង ការសង ត្រឡប់ គួរ ទៅ ពិភាក្សា ជាមួយ ស្ថាប័ន ហិរញ្ញវត្ថុ ស្រប ច្បាប់ ជៀសវាង ខូច CBC ដែល នាំឱ្យ ជះ ផល អវិជ្ជមាន នៅពេល ត្រូវការកម្ចី លើក ក្រោយ ។
លោក បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា ចំពោះ អតិថិជន ដែល ជួបប្រទះ នូវ បញ្ហា នូវ ការបង់ សង ដោយសារតែ វិបត្តិ សេដ្ឋកិច្ច លើកទឹក ឱ្យ គាត់ ពិភាក្សា ជាមួយ ស្ថាប័ន ហិរញ្ញវត្ថុ ព្រោះ ស្ថាប័ន ហិរញ្ញវត្ថុ នៅ កម្ពុជា ដែល ស្ថិត ក្រោម ធនាគារ ជាតិ នៃ កម្ពុជា មាន គោលការណ៍ ត្រឹមត្រូវ មាន ភាពបត់បែន និង មាន ភាពទន់ភ្លន់ នៅក្នុង ការនិយាយ ចរចា ជាមួយ អតិថិជន និង រក ដំណោះស្រាយ ដល់ អតិថិជន ។
លោក បន្ថែម ថា « យើង ជំរុញ ឱ្យ គាត់ ជជែកគ្នា ជាមួយ ស្ថាប័ន ហិរញ្ញវត្ថុ នៅ ពេល ដែល ជជែកគ្នា ប្រហែលជា មាន នូវ គោលការណ៍ កើតឡើង អាច ថា ឥណទាន នេះ គួរតែ ធ្វើ ការស្តារ ឡើងវិញ ឬ យ៉ាងណា ម៉េច ដែរ ? នៅ ពេល ដែល គាត់ យល់ព្រម គ្នា ក្នុង ការស្តារ ឥណទាន ឡើងវិញ ប្រវត្តិ គាត់ បញ្ចូល នៅក្នុង CBC ក៏ ត្រូវ បញ្ចូល ទៅ តាម ហ្នឹង ដែរ »៕
ក្រុម យោធា អ៊ីស្រាអែល បាន និយាយ កាលពី ថ្ងៃព្រហស្បតិ៍ ថា ពួកគេ បាន សម្លាប់ ក្រុម សកម្មជន ប្រយុទ្ធហា ម៉ាស់ ជាង ៩ពាន់ នាក់ ប៉ុន្តែ បាន បាត់បង់ជីវិត ទាហាន របស់ ខ្លួន ចំនួន ២២០ នាក់ នៅ ក្នុង សង្គ្រាម ដែល មាន រយៈពេល ប្រមាណ ៣ខែ កន្លះ មក នេះ ។ ក្រុមហា ម៉ាស បាន ប្រញាប់ ច្រានចោល ចំនួន តួលេខ ដែល និយាយ ថា មាន ក្រុមហា ម៉ាស ស្លាប់ ដល់ ចំនួន ៩ពាន់ នាក់ នោះ ។
( ពោធិ៍សាត់ )៖ លោក ឡាយ វិសិដ្ឋ អភិបាល រង ខេត្ត តំណាង លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាកសិករ សូម ឱ្យ មាន ការចូលរួម យោគយល់ អធ្យាស្រ័យ គ្នា បញ្ឈប់ ការធ្វើ ស្រែ ប្រាំង បន្ថែម ទៀត និង សន្សំ ស ម្ចៃ ទឹក ទុក សម្រាប់ ប្រើប្រាស់ ៣ខែ បន្តបន្ទាប់ ទៀត ខណៈ ដែល ពួកគាត់ អនុវត្ត លើស ផែនការ កំណត់ ។
លោក អភិបាល រង ខេត្ត បាន អំពាវនាវ បែប នេះ ក្នុង ឱកាស ចុះ ត្រួតពិនិត្យមើល ផែនការ ដែល បាន ដាក់ចេញ កន្លងមក ជុំវិញ ការបែងចែក ការប្រើប្រាស់ ទឹក ចាប់ពី ទ្វា ទឹក ទី៥ រហូតដល់ ដើម ប្រឡាយ មេ ដំណាក់ អំពិល ដើម្បី អន្តរាគមន៍ ជួយសង្គ្រោះ ស្រូវ ប្រាំង ប្រជាកសិករ ដែល ជួប បញ្ហា ខ្វះខាត ទឹក ។
លោក ឡាយ វិសិដ្ឋ បាន ជម្រាប ជូន ថា ឆ្នាំ ២០២៣ គឺជា ឆ្នាំ ដែល មាន តម្លៃ ស្រូវ ខ្ពស់ ហើយ បងប្អូន ប្រជាកសិករ យើង បាន ធ្វើ ស្រូវ ប្រាំង លើស ផែនការ កំណត់ ជិត ៣០០ % នៃ ផែនការ ដូច្នេះហើយ កង្វះខាត ទឹក រឹតតែ ខ្វះខាត សម្រាប់ ឆ្នាំ នេះ និង ប្រឈម ខ្លាំង មែនទែន សម្រាប់ ការបែងចែក ទឹក ។
លោក អភិបាល រង ខេត្ត ក៏ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាកសិករ ទាំងអស់ សូម បញ្ឈប់ បន្ត ការធ្វើ ស្រែ ប្រាំង បន្ថែម ទៀត ដោយសារតែ មាន កង្វះខាត ទឹក បន្ទាប់ពី ប្រមូល ផល ហើយ នោះ សូម បិទ ការធ្វើ ស្រែ ប្រាំង និង នាំគ្នា សន្សំ សម្ចៃ ទឹក ទុក ចែករំលែក និង សម្រាប់ ប្រើប្រាស់ លើ ជីវិត មនុស្ស សត្វ និង ទឹក ស្អាត ។
លោក បាន គូសបញ្ជាក់ ថា ដំណាំ ស្រូវ មិន មែន ជា ដំណាំ ទឹក ដូចជា ព្រលិត រំចង់ និង ឈូក នោះ ទេ ក៏ប៉ុន្តែ ដំណាំ ស្រូវ គឺជា ដំណាំ ដែល ធន់ នឹង ទឹក ដូច្នេះហើយ ដំណាំ ស្រូវ គឺ ត្រូវការ ទឹកតែ សើម ដី ឬមួយ ចង្អាម ផុត ពី ដី ប៉ុណ្ណោះ ។ លោក សូម ឱ្យ បងប្អូន ប្រជាកសិករ មេត្តា កុំ យល់ច្រឡុំ ថា ដំណាំ ស្រូវ ត្រូវការ ទឹក បរិបូរណ៌ ហូរហៀរ បែក ខ្ចាយ នោះ ។ ហើយ ប្រសិនបើ អ្នក មាន ទឹក ក្នុង ស្រែ ហើយ សូម ផ្អាក បូម ដើម្បី បញ្ជូន ទឹក នេះ ដល់ ស្រែ ស្រូវ ដែល ត្រូវការ ទឹក ជា ចាំបាច់ ៕
រដ្ឋបាល ខេត្ត កំពង់ធំ ចេញ ប្រកាស ព័ត៌មាន ច្រានចោល ការចុះផ្សាយ តាម បណ្តាញ សង្គម ពាក់ព័ន្ធ ផ្ទៃដី ទំហំ ១៦០០ ហិកតា នៅ តំប់ វា ស្រង៉ែ ស្រុក កំពង់ស្វាយ
( កំពង់ធំ )៖ អ្នកនាំពាក្យ រដ្ឋបាល ខេត្ត កំពង់ធំ បាន ចេញ ប្រកាស ព័ត៌មាន ដោយ ច្រានចោល ការផ្សាយ តាម បណ្តាញ សង្គម មួយ កាលពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ ពាក់ព័ន្ធ ផ្ទៃដី ទំហំ ១៦០០ ហិកតា ស្ថិត នៅ តំប់ វា ស្រង៉ែ ស្រុក កំពង់ស្វាយ ។
សេចក្តីប្រកាស ព័ត៌មាន បាន បំភ្លឺ ថា ពាក់ព័ន្ធ ផ្ទៃដី ទំហំ ១៦០០ ហិកតា ស្ថិត នៅ តំបន់ វាល វាល ស្រង៉ែ ( វាល ផ្អែក ដំបង ) ក្នុង ភូមិសាស្ត្រ ឃុំ កំពង់គោ និង ឃុំ ផាត់ សណ្ដាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ជា ដី ស្ថិត ក្នុង ដីកា លេខ ០៧៨ ដខ ចុះ ថ្ងៃទី ០៧ ខែកញ្ញា ឆ្នាំ ២០០៥ របស់ រដ្ឋបាល ខេត្ត ស្តីពី ការប្រគល់ សិទ្ធិ ជូន លោក សុខ មុន្នី ដើម្បី ខ្លី ដី ពី រដ្ឋ ធ្វើ ស្រែ ប្រដេញ ទឹក និង ស្រែ ប្រាំង ។
ដី នេះ ត្រូវបាន ប្រជាពលរដ្ឋ ចូល ទៅកាន់ កាប់ ប្រើប្រាស់ និង អាស្រ័យ ផល ចំពោះ ដីកា លេខ ៨២ ដខ ដែល មាន ផ្ទៃដី ទំហំ ៩០០ ហិកតា បាន ប្រគល់ ជូន លោក សុខ មុន្នី ដើម្បី ធ្វើ ការ វិនិយោគ រហូតមកដល់ ពេលនេះ គឺ ផ្ទៃដី ទំហំ ៩០០ ហិកតា ស្ថិត នៅក្នុង ការគ្រប់គ្រង ប្រើប្រាស់ របស់ លោក សុខ មុន្នី នៅឡើយ ។
អ្នកនាំពាក្យ រដ្ឋបាល ខេត្ត ស្វាគមន៍ ជានិច្ច ក្នុង ការសហការផ្តល់ និង ទទួល ព័ត៌មាន ពី គ្រប់ មជ្ឈដ្ឋាន ទាំងអស់ និង ស្នើឲ្យ សារព័ត៌មាន ដែល បាន ចុះផ្សាយ និង សារព័ត៌មាន ដទៃ ទៀត ដែល មាន បំណង ចង់ ស្វែងយល់ ករណី នេះ ឬ ព័ត៌មាន ផ្សេង ៗ ទៀត សូម មក ទំនាក់ទំនង សាកសួរ ព័ត៌មាន ដោយ ផ្ទាល់ នៅ រដ្ឋបាល ខេត្ត រៀងរាល់ ម៉ោង ធ្វើការ ៕
បណ្ឌិត ប៉ាន់ ខែម ប៊ុន ថន ដឹកនាំ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ក្រុង ប៉ោយប៉ែត ប្រជុំ ពិភាក្សា បូកសរុប លទ្ធផល ការងារ ប្រចាំ ខែទី១ និង លើក ផែនការ ទិសដៅ ការងារ បន្ត
( បន្ទាយមានជ័យ )៖ លោក បណ្ឌិត ប៉ាន់ ខែម ប៊ុន ថន រដ្ឋលេខាធិការ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ក្រុង ប៉ោយប៉ែត ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ ជាមួយ លោក លោកស្រី ជា អនុប្រធាន រួម ជាមួយ សមាជិក សមាជិកា ក្រុមការងារ រាជដ្ឋាភិបាល ចុះ មូលដ្ឋាន ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ នៅ សាល ប្រជុំ សាលាក្រុង ប៉ោយប៉ែត ដើម្បី ពិភាក្សា បូកសរុប លទ្ធផល ការងារ ក្នុង ខែទី១ និង លើក ផែនការ ទិសដៅ ការងារ បន្ត ។
លោក បណ្ឌិត ប៉ាន់ ខែម ប៊ុន ថន ក្នុង នាម ជា ប្រធាន ក្រុមការងារ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ចំពោះ លោក លោកស្រី ជា អនុប្រធាន និង សមាជិក សមាជិកា គ្រប់ រូប ដែល បាន ខិតខំ យកចិត្តទុកដាក់ បំពេញ ភារកិច្ច យ៉ាង ល្អ ប្រសើរ តាម ជំនាញ រៀង ៗ ខ្លួន ប្រកបដោយ ស្មារតី សាមគ្គីភាព និង ការទទួលខុសត្រូវ ខ្ពស់ គួរឲ្យ កត់សម្គាល់ ។
លោក បណ្ឌិត ប៉ាន់ ខែម ប៊ុន ថន ប្រធាន ក្រុមការងារ បាន លើកទឹកចិត្ត ដល់ ក្រុមការងារ ឲ្យ បន្ត ការទទួលខុសត្រូវ នេះ ដើម្បី រួមគ្នា អនុវត្ត គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ឲ្យបាន ល្អ ប្រសើរ សំដៅ បម្រើ ផលប្រយោជន៍ ជូន ប្រជាពលរដ្ឋ ៕
អភិបាល ខេត្ត កំពង់ធំ ហាម ដាច់ខាត ចំពោះ ជន ខិលខូច ណា ដែល រុករាន ទន្ទ្រាន រំលោភ យក ដី រដ្ឋ នៅ តំបន់ ៣ ក្នុង ស្រុក កំពង់ស្វាយ មក ធ្វើជា កម្មសិទ្ធិ របស់ ខ្លួន
( កំពង់ធំ )៖ បច្ចុប្បន្ន ដី រដ្ឋ នៅ តំបន់ ៣ទីតាំង ខ្វាក់ ទោច ខ្វាក់ ធំ ស្ថិត នៅក្នុង ឃុំ កំពង់គោ ដែល ជន ខិលខូច កំពុងតែ រុករាន ទន្ទ្រាន និង ជីក ប្រឡាយ យក ទឹក មក ស្រោចស្រព ស្រូវ ប្រាំង របស់ ខ្លួន ដើម្បី អាស្រ័យ ផល មិន បាន ជូន ដំណឹង មក អាជ្ញាធរ មូលដ្ឋាន នោះ ឡើយ ។
លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ បាន ចុះ ពិនិត្យ ទីតាំង ដី ដែល ប្រជាពលរដ្ឋ កំពុងតែ រំលោភបំពាន ដី ធ្វើ ស្រែ ប្រាំង មាន ចំនួន ៨.០០០ ហិកតា ដែល ស្ថិត នៅ តំបន់ ( ខ្វាក់ ទោច ខ្វាក់ ធំ ) ឃុំ កំពង់គោ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ដែល ជន ខិលខូច មួយចំនួន នៅតែ រុករាន ទន្ទ្រាន រំលោភ យក ដី រដ្ឋ នៅ តំបន់ ហាមឃាត់ មក ធ្វើជា កម្មសិទ្ធិ របស់ ខ្លួន ដោយ មិន គោរព ទៅ តាម គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោក បន្ត ទៀត ថា ការចុះ ត្រួតពិនិត្យ ទីតាំង ធ្វើ ស្រែ ប្រាំង របស់ ប្រជាពលរដ្ឋ ក្នុង គោលបំណង គឺ ការពិនិត្យ បោះ បង្គោល ព្រំ ដី ដែល ឆ្វៀល ហើយ និង មិន ទាន់ ឆ្វៀល ប្រសិនបើ បងប្អូន មាន ក្បាល ដី ជាប់ នឹង ក្បាល ដី រដ្ឋ សូម កុំ រូករាន ទន្ទ្រាន បន្ត ទៀត ត្រូវ មាន ការទទួលខុសត្រូវ ដោយ ខ្លួន ឯង ធ្វើឲ្យ បាត់បង់ ព្រៃ លិច ទឹក ដែល ជា ជម្រក នៃ ត្រី និង សត្វ គ្រប់ ប្រភេទ ផងដែរ ។
( ស្វីស) ៖ នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នៅ ទីក្រុង ហ្សឺណែវ លោក បណ្ឌិត លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន និង ជា ប្រធាន កិច្ចប្រជុំ ត្រួតពិនិត្យ ឡើងវិញ លើក ទី៥ នៃ អនុសញ្ញា អូតា វ៉ា ឆ្នាំ ២០២៤ បាន ជួបប្រជុំ ទ្វេ ភាគី ជាមួយ លោក Latsamy Keomany ឯក អគ្គ រដ្ឋទូត និង តំណាង អចិន្ត្រៃយ៍ ប្រទេស ឡាវ ប្រចាំ នៅ អង្គការ សហ ប្រជាជាតិ និង អង្គការ អន្តរជាតិ នានា នៅ ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស ក្នុង គោលបំណង ស្នើ ដល់ ភាគីឡាវ ពិចារណា ចូលរួម គាំទ្រ និង ចូលរួម ជា រដ្ឋ ភាគី អនុសញ្ញា អូតាវ៉ា ។
ក្នុង ជំនួប ប្រជុំ នេះ លោក បណ្ឌិត លី ធុជ បាន កោតសរសើរ ចំពោះ សមិទ្ធផល របស់ ឡាវ ក្នុង សកម្មភាព បោសសម្អាត គ្រាប់បែក ចង្កោម និង កោតសរសើរ ដល់ សហគមន៍ អន្តរជាតិ ដែល បាន គាំទ្រ ដល់ សកម្មភាព បោស គ្រាប់បែក ចង្កោម របស់ ឡាវ ហើយ លោក ក៏ បាន ជម្រាប ជូន ដល់ ភាគីឡាវ ផងដែរ ថា កម្ពុជា ក្នុង នាម ជា ប្រធាន អនុសញ្ញា អូតា វ៉ា ឆ្នាំ ២០២៤ បាន ខិតខំ ស្វែងរក កិច្ចសហប្រតិបត្តិការ និង ជំនួយ ពី ដៃគូ អភិវឌ្ឍន៍ និង ម្ចាស់ ជំនួយ នានា ដើម្បី គាំទ្រ ដល់ សកម្មភាព បោសសម្អាត មីន របស់ ប្រទេស ឡាវ ។
ជាមួយគ្នា នេះ លោក បាន ស្នើ ឱ្យ ភាគី ឡាវ ពិចារណា ចូលរួម ជា រដ្ឋ ភាគី អនុសញ្ញា អូតា វ៉ា ហើយ កម្ពុជា នឹង ប្តេជ្ញា គាំទ្រ ដល់ ភាគីឡាវ ឱ្យ អស់ ពី លទ្ធភាព ក្នុង ការបោសសម្អាត មីន និង អនុវត្ត តាម បទដ្ឋាន របស់ អនុសញ្ញា អូតាវ៉ា ។
ជាក់ស្ដែង នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ លោក អភិបាល ខេត្ត បាន អញ្ជើញ ចុះ ពិនិត្យ ស្រូវ ប្រាំង របស់ ប្រជាពលរដ្ឋ ជាង ៧០០ ហិកតា ស្ថិត នៅក្នុង ឃុំ ខុន រ៉ង់ ស្រុក បរិបូណ៌ ដែល កំពុង ជួបប្រទះ នូវ ការ ក្រៀម ស្វិត ដោយសារតែ មិន មាន ទឹក ស្រាច ស្រព ។
បន្ទាប់ពី លោក អភិបាល ខេត្ត និង លោក ប្រធាន មន្ទីរ ធនធាន ទឹក រួម និង ក្រុមការងារ អាជ្ញាធរ មូលដ្ឋាន ចុះ ពិនិត្យ នៅ ភូមិសាស្ត្រ ទីតាំង ខាងលើ នេះ រួច មក លោក អភិបាល ខេត្ត ក៏ បាន សម្រេច បញ្ជូន គ្រឿងចក្រ ចំនួន ២គ្រឿង ជីក ប្រឡាយ មួយ ខ្សែ ដែល មាន ប្រវែង ជាង ៣ពាន់ ម៉ែត្រ និង ដាក់ ម៉ាស៊ីន បូម ទឹក ធន់ ធំ ដើម្បី នាំ ទឹក ពី ទន្លេ យកមក ស្រោចស្រប ស្រូវ ប្រាំង របស់ ប្រជាពលរដ្ឋ ដែល រង ការក្រៀម ស្វិត ចំនួន ជាង ៧០០ ហិកតា ។
លោក បាន បន្ត ថា បន្ទាប់ពី សំណើ របស់ លោក បាន ទៅដល់ លោក អភិបាល ខេត្ត និង លោក ប្រធាន មន្ទីរ ធនធាន ទឹក ខេត្ត កំពង់ឆ្នាំង ហើយ នោះ នៅ រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ លោក អភិបាល ខេត្ត និង ក្រុមការងារ រួមទាំង មន្ទីរ ធនធាន ទឹក បាន ចុះ មក ពិនិត្យ ទីតាំង ស្រូវ ប្រាំង ដែល រង ការក្រៀម ស្វិត ខាងលើ នេះ ជាក់ស្ដែង ។
ក្នុង នោះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន សម្រេច បញ្ជូន គ្រឿងចក្រ ចំនួន ២គ្រឿង ដើម្បី ធ្វើ ការជីក ស្ដារ ប្រឡាយ មួយ ខ្សែ រ ដែល មាន ប្រវែង ជាង ២.៥០០ម៉ែត្រ ដែល ប្រឡាយ នេះ គម្រោង ស្ដារ មាន ទទឹង ៥ម៉ែត្រ និង ជម្រៅ៣ម៉ែត្រ និង ប្រឡា យ មួយ ខ្សែ ទៀត ត្រូវ ជីក នាំ ទឹក ពី មាត់ ទន្លេ មក ដែល មាន ប្រវែង ជាង ១.០០០ ម៉ែត្រ ប្រឡាយ មួយ ខ្សែ នេះ ដែរ គឺ សម្រាប់ ផ្ដល់ ប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ ក្នុង ការធ្វើចរាចរណ៍ ទូក កាណូត របស់ ពួកគាត់ ដើម្បី យកមក រក្សាទុក មូលដ្ឋាន ។
( ហាណូយ ) ៖ ក្រសួង ការពារ ជាតិ វៀតណាម បាន ប្រកាស នៅ ថ្ងៃសុក្រ នេះ ថា នឹង រៀបចំ ពិព័រណ៍ អាវុធ អន្តរជាតិ នៅក្នុង ខែធ្នូ ចុង ឆ្នាំ នេះ ខណៈ ប្រទេស អាស៊ាន មួយ នេះ កំពុង ព្យាយាម ធ្វើ ពិពិធកម្ម ការផ្គត់ផ្គង់ អាវុធ របស់ ខ្លួន ហើយ ពង្រីក កិច្ចសហប្រតិបត្តិការ ក្នុង ការផលិត និង នាំចេញ អាវុធ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃសុក្រ ទី ២៦ ខែមករា ឆ្នាំ ២០២៤ ។
មន្រ្តី ក្រសួង ការពារ ជាតិ វៀតណាម បាន និយាយ ក្នុង សន្និសីទ សារព័ត៌មាន ថា ព្រឹត្តិការណ៍ ដែល នឹង រៀបចំឡើង នៅឯ មូលដ្ឋាន ទ័ព អាកាស Gia Lam ក្នុង ទីក្រុង ហាណូយ ចាប់ពី ថ្ងៃទី ១៩ ដល់ ថ្ងៃទី ២២ ខែធ្នូ នឹង ក្លាយជា ឱកាស សម្រាប់ កិច្ចសហប្រតិបត្តិការ ការពារ ជាតិ អន្តរជាតិ ហើយក៏ នឹង ស្វែងរក ដៃគូ ដើម្បី លើកកម្ពស់ ផលិកម្ម និង ការនាំចេញ ផងដែរ ។
ដោយ មិន បញ្ជាក់ លម្អិត ក្រសួង ការពារ ជាតិ វៀតណាម បាន ឲ្យដឹង ថា កិច្ចព្រមព្រៀង ជាច្រើន អាចនឹង សម្រេចបាន នៅឯ ពិព័រណ៍ អាវុធ នោះ ។ វៀតណាម មាន ការចំណាយ យោធា ប្រចាំ ឆ្នាំ លើស ពី ២ភាគរយ នៃ ផលិតផល ក្នុង ស្រុក សរុប របស់ ខ្លួន ហើយ កំពុង ផលិត អាវុធ ធុន តូច គ្រាប់ រំសេវ យន្តហោះ ដ្រូន និង រថ ពាស ដែក ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរក ឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ៤នាក់ ខណៈ ជា អ្នក ជាសះស្បើយ ១នាក់ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ០៧៥ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៦. ០០៦ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ អនុ រដ្ឋមន្រ្តី ការបរទេស ចិន និង កូរ៉េ ខាងជើង ជួបគ្នា នៅ ទីក្រុង ព្យុងយ៉ាង
( ប៉េកាំង ) ៖ នា ថ្ងៃសុក្រ នេះ អនុ រដ្ឋមន្រ្តី ការបរទេស នៃ ប្រទេស ចិន និង សមភាគី កូរ៉េ ខាងជើង បាន ជួប ពិភាក្សា គ្នា នៅឯ ទីក្រុង ព្យុងយ៉ាង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នា ថ្ងៃសុក្រ ទី ២៦ ខែមករា ឆ្នាំ ២០២៤ ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ បាន សហការ ជាមួយ មន្ទីរ រៀបចំ ដែនដី នគរ រូបនីយកម្ម សំណង់ និង សុរិយោដី រាជធានី ភ្នំពេញ រៀបចំ ពិធី បិទ ផ្សាយ ជា សារធារណៈ នូវ ឯកសារ នៃ ការវិនិច្ឆ័យ ដីធ្លី ដែល មាន លក្ខណៈ ជា ប្រព័ន្ធ ដើម្បី ទុក ពេល ឲ្យ ម្ចាស់ ដី ផ្ទៀងផ្ទាត់ ឯកសារ ឲ្យបាន ត្រឹមត្រូវ ក្នុង រយៈពេល ១៥ ថ្ងៃ គិត ចាប់តាំងពី ថ្ងៃ បិទ ផ្សាយ នេះ ទៅ ។
ទិន្នន័យ ក្បាល ដី របស់ ប្រជាពលរដ្ឋ ដែល បាន បិទ ផ្សាយ ជាសាធារណៈ នេះ ស្ថិត នៅក្នុង ភូមិ កោះ នរា សង្កាត់ និរោធ ខណ្ឌ ច្បារអំពៅ ក្រោម វត្តមាន លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោក ពឹង រតនៈ អនុប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី រាជធានី ភ្នំពេញ និង មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ ជាង ២០០ នាក់ ។
លោក ចេង មុនីរ៉ា បាន ថ្លែង ថា ការបិទ ផ្សាយ ជាសាធារណៈ នូវ ឯកសារ នៃ ការវិនិច្ឆ័យ មាន លក្ខណៈ ជា ប្រព័ន្ធ នា ពេលនេះ ពិតជា មាន តម្លៃ ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ ដូច្នេះហើយ សូម ពិនិត្យ ផ្ទៀងផ្ទាត់ ច្បាស់លាស់ ក្នុង រយៈពេល ១៥ ថ្ងៃ នេះ ព្រោះថា ប័ណ្ណ កម្មសិទ្ធិ គឺ មាន ផលប្រយោជន៍ ជាច្រើន ធានា នូវ សិទ្ធិ របស់ អ្នក ក្នុង ការធ្វើជា ម្ចាស់ ឬ ការកាន់កាប់ ដីធ្លី ។
លោក ស្នើ ប្រជាពលរដ្ឋ ត្រូវ ប្រញាប់ រួសរាន់ ទៅ ពិនិត្យមើល ការបិទ ឯកសារ នៃ ការវិនិច្ឆ័យ ដីធ្លី ដែល មាន រយៈពេល ១៥ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ២៦ ខែមករា រហូតដល់ ថ្ងៃទី ០៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ គឺ រាប់បញ្ជូល ទាំង ថ្ងៃ ឈប់សម្រាក ។ ដើម្បី មាន លទ្ធភាព ឲ្យ ម្ចាស់ ដី និង នាក់ ពាក់ព័ន្ធ ធ្វើ ការផ្ទៀងផ្ទាត់ ឈ្មោះ ស្ថានភាព គ្រួសារ និង ក្បាល់ ដី របស់ ខ្លួន ព្រមទាំង ធ្វើ ការតវ៉ា ក្នុង ករណី មាន ការខុសឆ្គង បើក ក្នុង ករណី ផុត រយៈពេល កំណត់ នៅ ការបិទ ផ្សាយ ប្រជាពលរដ្ឋ មិន អាច ជំទាស់ តវ៉ា បាន ទៀត ឡើយ ។
ជាមួយគ្នា នេះ ដែរ លោក អភិបាល បាន ធ្វើ ការអំពាវនាវ ដល់ អាជ្ញាធរ មូលដ្ឋាន រួមទាំង ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម នា ពេលនេះ ពេល ត្រឡប់ ទៅ មូលដ្ឋាន វិញ បន្ត ធ្វើ ការផ្សព្វផ្សាយ ពី ពិធី បិទ ផ្សាយ ជាសាធារណៈ នូវ ឯកសារ នៃ ការវិនិច្ឆ័យ លើ ការចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ឲ្យបាន ដឹង និង ពិនិត្យ ផ្ទៀងផ្ទាត់ ទិន្នន័យ ដែល ក្រុមការងារ ចុះបញ្ជី រ ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ របស់ មន្ទីរ ដែល បាន អនុវត្ត តាម នីតិវិធី ឲ្យបាន គ្រប់ ៗ គ្នា ៕
ទេសរដ្ឋមន្រ្តី លី ធុជ ដឹកនាំ កិច្ចប្រជុំ គណៈកម្មការ សម្របសម្រួល នៃ អនុសញ្ញា អូតា វ៉ា ដើម្បី ពិនិត្យមើល ផែនការ សកម្មភាព គាំទ្រ អនុសញ្ញា
អង្គប្រជុំ ក៏ បាន លើកឡើង អំពី ការអនុវត្តមាត្រា ៤ ស្តីពី ការបំផ្លាញ គ្រាប់ មីន ដែល រក្សាទុក និង បាន អបអរសាទរ ដល់ ប្រទេស ក្រិក ដែល មាន ដំណើរការវិជ្ជមាន ក្នុង ការសម្រេច គោលដៅ នេះ ។ ជាមួយគ្នា នេះ អង្គប្រជុំ បាន ផ្តោត ជាពិសេស ទៅ លើ ប្រទេស អ៊ុយក្រែន ដែល រង ការចោទប្រកាន់ ថា បាន រក្សាទុក គ្រាប់ មីន ប្រឆាំង មនុស្ស និង បាន ស្នើ ឱ្យ បន្ត តាមដាន ដោយ យកចិត្តទុកដាក់ បន្ថែម ទៅ លើ បញ្ហា របស់ អ៊ុយក្រែន ។
( ស្វាយរៀង ) ៖ មាន អគ្គិភ័យ ឆាបឆេះ តូប ស្តុក និង លក់ ស្បែកជើង មួយ កន្លែង អស់ ស្ទើរ ទាំងស្រុង បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល ដល់ ពលរដ្ឋ និង សមត្ថកិច្ច ជួយ អន្តរាគមន៍ បាញ់ ទឹក ពន្លត់ តែ ដោយសារ ភ្លើង ឆាបឆេះ ខ្លាំង មិន អាច ជួយ ពន្លត់ បាន នោះ ទេ ។
ករណី នេះ កើតឡើង វេលា ម៉ោង ២២៖ ៣៥ នាទី យប់ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នៅ ចំណុច ភូមិ ថ្នល់ កែង ឃុំ ក ណ្ដៀង រាយ ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង ។ ម្ចាស់ ផ្ទះ ឈ្មោះ គង់ វេហា ភេទ ប្រុស អាយុ ៥៦ ឆ្នាំ មុខរបរ កសិករ ។
សមត្ថកិច្ច នគរបាល ស្រុក ស្ចាយ ទាប បាន ឲ្យដឹង ថា នៅ មុនពេល កើត ម្ចាស់ តូប បាន អុជ ធូប ក្នុង តូប រួច បិទ តូប ដូច រាល់ ដង ហើយ ទៅ សម្រាក នៅ ផ្ទះ ដែល នៅ ខាងក្រោយ តូប ( តូប លក់ ស្បែកជើង នៅ ខាងមុខ ផ្ទះ ) លុះ ដល ម៉ោង កើត ហេតុ ខាង លើ ស្រាប់តែ មាន ផ្សែង ហុយ ចេញ និង អណ្តាត ភ្លើង ពី តូប លក់ ស្បែកជើង ម្ចាស់ ផ្ទះ បាន ស្រែក ហៅ ឲ្យ អ្នកជិតខាង ជួយ ពន្លត់ និង ទូរស័ព្ទ ទៅ សមត្ថកិច្ច ជួយ អន្តរាគមន៍ បាញ់ ទឹក ពន្លត់ ដែរ តែ ប៉ុន្តែ សម្ភារ ក្នុង តូប ត្រូវបាន ភ្លើង ឆាបឆេះ ខូចខាត អស់ ទៅ ហើយ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា តូប ស្តុក និង លក់ ស្បែកជើង នៅ ខាងមុខ ផ្ទះ ដែល ត្រូវ ភ្លើង ឆេះ នេះ ធ្វើ អំពី ដែក ប្រក់ ស័ង្កសី ជញ្ជាំង ស័ង្កសី ដែល មាន បណ្តោយ ១០ម៉ែត្រ គុណ ទទឹង ៤ម៉ែត្រ ហើយ ខូច ស្បែកជើង ជាច្រើន គូរ រាប់ មិន អស់ គិត ជា ចំនួន ទឹកប្រាក់ ប្រហែក១០.០០០ ដុល្លារ តូប ដាក់ ស្បែក និង ស្បែកជើង ខូចខាត ទាំងស្រុង ៕
មន្ទីរ សង្គមកិច្ច ខេត្ត កោះកុង ប្រគល់ ប័ណ្ណ សម្គាល់ ជន ពិការភាព ដល់ រដ្ឋបាល ក្រុង - ស្រុក ទូទាំង ខេត្ត ចំនួន ៩៥០ប័ណ្ណ
( កោះកុង ) ៖ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវតី នីតិសម្បទា ខេត្ត កោះកុង នៅ រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ បាន រៀបចំ ពិធី បើក ផ្ដល់ របប គោល នយោបាយ ជូន ជន មាន ពិការ ភាពក្រីក្រ នៅ តាម សហគមន៍ ខេត្ត កោះកុង ក្នុង ក្រុង ខេមរភូមិន្ទ និង ស្រុក មណ្ឌល សីមា ដែល មាន ជន ពិការភាព ចំនួន ២២៥ នាក់ និង បាន ប្រគល់ ប័ណ្ណ សម្គាល់ ជន ពិការភាព ដល់ រដ្ឋបាល ក្រុង ស្រុក ទូទាំង ខេត្ត កោះកុង ចំនួន ៩៥០ប័ណ្ណ ។
កម្មវិធី នេះ បាន រៀបចំឡើង ស្ថិត នៅ សាល មហោស្រព ខេត្ត កោះកុងក្រោម វត្ដមាន លោក សំឃិត វៀន អភិបាល រង ខេត្ត និង មាន ការចូលរួម ពី មេបញ្ជាការ រង កម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ . លោក - លោកស្រី អភិបាល រង ក្រុង ស្រុក លោក លោកស្រី មន្ត្រីរាជការ គ្រប់ ស្ថាប័ណ្ណ ជុំវិញ ខេត្ត និង ចាស់ជរា ជន ពិការភាព ។
លោក សំ ឃិត វៀន អភិបាល រង ខេត្ត បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល តែង យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ សុខ ទុក្ខ បងប្អូន ប្រជាពលរដ្ឋ ក្រីក្រ ជួប ការលំបាក នៅ តាម សហគមន៍ ពិសេស ជន មាន ពិការភាព ដោយ មិន បោះបង់ នរណា ម្នាក់ ចោល ឡើយ ។
ជាក់ស្តែង ក្រៅពី ការបើក ផ្តល់ ប្រាក់ របប គោល នយោបាយ ខាងលើ មូលនិធិ ជាតិ ជំនួយ សង្គម នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា សហការ ជាមួយ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម បាន នឹង កំពុង រៀបចំ ឯកសារ គោល ប្រតិបត្តិ កម្មវិធី ជាតិ ជំនួយ សង្គម ក្នុង កញ្ចប់ គ្រួសារ ដែល ជន មាន ពិកាភាព មក ពី គ្រួសារ មាន ប័ណ្ណ សមធម៌ គឺជា ក្រុម ទទួល ផល ក្នុង ចំណោម ក្រុម គោលដៅ របស់ កម្មវិធី ។
ក្រៅពី នេះ មូលនិធិ ជន ពិការ តាមរយៈ មណ្ឌល ស្តារ លទ្ធភាព ពលកម្មកាយ សម្បទា ទាំង ១១ ក៏ បាន និង កំពុង បម្រើ សេវា ផ្តល់ សម្ភារៈ ឧបករណ៍ អវយវៈ សិប្បនិម្មិត និង រណប និង សាងសង់ ផ្ទះ ដល់ បងប្អូន ដែល មាន ជីវភាព ខ្វះខាត ជួប ការលំបាក ខ្លាំង ផងដែរ ។
លោក អភិបាល រង បាន បន្ត ថា រាជ រដ្ឋាភិបាល កម្ពុជា នីតិកាល ទី៧ ក្រោម ការដឹកនាំ ប្រកបដោយ គិតិ បណ្ឌិត របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បន្ត ផ្ដោត ការយកចិត្តទុកដាក់ លើ ការកសាង និង ពង្រឹង ប្រព័ន្ធ គាំពារ សង្គម ឲ្យ មាន លក្ខណៈ ប្រមូលផ្ដុំ សង្គតភាព និង ប្រសិទ្ធភាព ដោយ ឈរ លើ ស្មារតី « មិន បោះបង់ ចោល ពលរដ្ឋ ណា ម្នាក់ ឡើយ » ។
ការចុះ ទស្សនកិច្ច សិក្សា នេះ បាន ធ្វើឡើង ចាប់ពី ថ្ងៃទី ២៣ - ២៥ ខែមករា ឆ្នាំ ២០២៤ ក្រោម គម្រោង ជំនួយ របស់ អង្គការ សហ ប្រជាជាតិ ដើម្បី អភិវឌ្ឍន៍ ឧស្សាហកម្ម (UNIDO) ដោយ សហការ ជាមួយ អគ្គ នាយកដ្ឋាន សហគ្រាស ធុន តូច មធ្យម និង សិប្បកម្ម វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា (ITC) ។
លោក ញ៉ិល ប៊ុន ធឿន បាន ថ្លែង ថា វគ្គ បណ្ដុះបណ្ដាល ដែល មាន រយៈពេល ២ ថ្ងៃ នេះ បាន សិក្សា ពី មូលដ្ឋានគ្រឹះ ចម្បង សំខាន់ ៗ នៃ ការផលិត ផលិតផល សុវត្ថិភាព ម្ហូប អាហារ គុណភាព និង ស្តង់ដារ អនាម័យ ។
ដោយឡែក សិក្ខាកាម ទាំងអស់ បាន ស្វែងយល់ កាន់តែ ច្បាស់ ពី ខ្សែ ច្រវ៉ាក់ ផលិតកម្ម ដំណើរការផលិត ការវេច ខ្ចប់ ការរក្សាទុក្ខ ផលិតផល សម្រេច ការរក្សាទុក វត្ថុធាតុ ដើម គ្រឿងផ្សំ ដែល មាន ស្តង់ដារ អនាម័យ ល្អ ដើម្បី ជា បទពិសោធន៍ យក ទៅ អនុវត្ត នៅក្នុង សិប្បកម្ម របស់ ខ្លួន សម្រាប់ ជំរុញ លើកកម្ពស់ ដំណើរការបច្ចេកទេស ក្នុង ផលិតកម្ម ម្ហូប អាហារ ឲ្យ មាន គុណភាព ស្តង់ដារ និង តំរូវការ ទីផ្សារ ក្នុង ស្រុក ហើយ អាច បន្ត នាំចេញ ទៅ ក្រៅ ប្រទេស បាន ផងដែរ ។
( ភ្នំពេញ ) ៖ លោក អឿ សុធារ័ត្ន ប្រធាន នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ក្រេឌីត ប្យួរ៉ូ ខេមបូឌា (CBC) បាន លើកឡើង ថា ស្ថានភាព សេដ្ឋកិច្ច នៅក្នុង អំឡុង ពេលនេះ គឺ ពិតជា ផល ប៉ះពាល់ ដល់ វិស័យ ហិរញ្ញវត្ថុ ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ អាជីវកម្ម របស់ សាធារណជន ហើយក៏ វា ប៉ះពាល់ ដល់ លទ្ធភាព នៃ ការបង់ សង មក វិស័យ ធនាគារ ។
លោក អឿ សុធារ័ត្ន បាន លើកឡើង ថា ទាំងអស់ នេះ ហើយ ដែល បង្ហាញ ឲ្យ ឃើញ អំពី អតិថជន ដែល ជួបប្រទះ ផលលំបាក នៅក្នុង ការបង់ សង ប្រាក់ ត្រឡប់ ទៅ ស្ថាប័ន ធនាគារ ៕
សូម ទស្សនា វីដេអូ ការលើកឡើង របស់ លោក អឿ សុធារ័ត្ន៖
កម្ពុជា - នូវែលសេឡង់ ប្ដេជ្ញាចិត្ត ក្នុង ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ រីកចម្រើន
នៅក្នុង ជំនួប នេះ ភាគី ទាំង ពីរ បាន សម្ដែង នូវ ការពេញចិត្ត ចំពោះ សមិទ្ធផល នៃ ទំនាក់ទំនង ដ៏ ល្អ និង យូរអង្វែង រវាង កម្ពុជា និង នូវែលសេឡង់ និង រីករាយ ដែល ប្រទេស ទាំង ពីរ បាន ឈានដល់ ខួប ៦៥ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត ។
បន្ថែម ពីលើ នេះ ភាគី ទាំង ពីរ ក៏ បាន ពិភាក្សា ផ្តោត លើ វិស័យ អាទិភាព នៃ កិច្ចសហប្រតិបត្តិការ រួម មាន ការអភិវឌ្ឍ ធនធាន មនុស្ស ការបោសសម្អាត មីន ទេសចរណ៍ សុខាភិបាល ពាណិជ្ជកម្ម និង វិនិយោគ ការគាំទ្រ គ្នា ទៅ វិញ ទៅ មក លើ ឆាក អន្តរជាតិ និង ឯកភាព រិះរក វិធី ដើម្បី ជំរុញ ទំនាក់ទំនង ទ្វេ ភាគី ព្រមទាំង បញ្ជាក់ អំពី ការប្ដេជ្ញាចិត្ត ក្នុង ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ។
ជាថ្មី ម្ដង ទៀត កម្ពុជា - នូវែលសេឡង់ ក៏ បាន ផ្លាស់ប្តូរ ទស្សនៈ បន្ថែម អំពី កំណើន សេដ្ឋកិច្ច ប្រកបដោយ ចីរភាព ការទាក់ទាញ ទេសចរ និង ការផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន ព្រមទាំង បញ្ហា ដែល ជា ក្ដីកង្វល់ រួម ដូច ជា៖ ការប្រែប្រួល អាកាសធាតុ បញ្ហា តំបន់ និង អន្ដរជាតិ ផងដែរ ៕
ទីភ្នាក់ងារ កយកា បើក កិច្ចប្រជុំ ទ្វេ ភាគី លើក ដំបូង ក្នុង ឆ្នាំ ២០២៤ ជាមួយ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ពី កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ កូរ៉េ ( កយកា-KOICA) និង គណៈកម្មាធិការ សហប្រតិបត្តិការ អភិវឌ្ឍន៍ កម្ពុជា នៃ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា (CDCB/CDC) បាន បើក កិច្ចប្រជុំ ទ្វេ ភាគី ពិភាក្សា ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ និង ភាពជាដៃគូរ វាង ប្រទេស ទាំង ពីរ លើក ដំបូង ក្នុង ឆ្នាំ ២០២៤ ។
កិច្ចប្រជុំ ទ្វេរ ភាគី នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ ម្សិលមិញ នៅ សាល ប្រជុំ នៅ ទីស្តី ការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ។
គោលបំណង សំខាន់ នៃ កិច្ចប្រជុំ នេះ គឺ ដើម្បី ពិភាក្សា អំពី គម្រោង សម្រាប់ ឆ្នាំ ២០២៥ ផែនការ សម្រាប់ គម្រោង ថ្មី សម្រាប់ ឆ្នាំ ២០២៦ និង ការធ្វើ បច្ចុប្បន្នភាព លើ កម្មវិធី ដែល កំពុង ដំណើរការ ។ ភាគី ទាំង សងខាង ក៏ បាន ពិភាក្សា អំពី ការរៀបចំ ពិធី សម្ពោធ អគារ ថ្មី សម្រាប់ មជ្ឈមណ្ឌល ជាតិ បណ្តុះ ធុរកិច្ច ថ្មី នៃ កម្ពុជា (NICC) នៅ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ (RUPP) ។
ទេសរដ្ឋមន្ត្រី ឈៀង យ៉ាណារ៉ា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ កយកា-KOICA និង រដ្ឋាភិបាល និង ប្រជាជន នៃ សាធារណរដ្ឋ កូរ៉េ ដែល តែងតែ គាំទ្រ ដល់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម របស់ កម្ពុជា តាមរយៈ ការអនុវត្ត គម្រោង និង កម្មវិធី នានា ។
ភាគី ទាំង ពីរ ក៏ បាន ពិភាក្សា បន្ត អំពី កិច្ចសហប្រតិបត្តិការ លើ ជំនួយ អភិវឌ្ឍន៍ ផ្លូវការ (ODA) រវាង កម្ពុជា និង កូរ៉េ ។ ភាគី ទាំង សងខាង ក៏ បាន ផ្តោត សំខាន់ ទៅ លើ ជំហាន បន្ទាប់ នៃ ការងារ រវាង ក យកា-KOICA ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា និង ក្រសួង ពាក់ព័ន្ធ របស់ កម្ពុជា ដើម្បី អភិវឌ្ឍ គម្រោង ថ្មី សម្រាប់ ឆ្នាំ ២០២៦ ។
លោក អឿ សុធារ័ត្ន បាន បញ្ជាក់ ថា ជាធម្មតា គ្រឹះស្ថាន ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ តែងតែ មើល ប្រវត្តិ របស់ អតិថិជន ចន្លោះ ពី ១ - ៣ឆ្នាំ ចុងក្រោយ ប៉ុណ្ណោះ ដូច្នេះ ប្រសិនជា អតិថិជន ចាប់ផ្ដើម បង់ សង ត្រឡប់ ឲ្យបាន ទាន់ ពេលវេលា ចាប់ពី ពេលនេះ តទៅ ដូច្នេះ ១ ឬ ២ឆ្នាំ ក្រោយ ប្រវត្តិ CBC របស់ អតិថិជន នឹង ល្អ ប្រសើរ ឡើងវិញ ។
លោក បន្ថែម ថា ជា ការពិត អតិថិជន ត្រូវការ ពេលវេលា ចន្លោះ ២ ឆ្នាំ ដើម្បី ស្ដារ ឈ្មោះ ឡើងវិញ ប្រសិនជា អតិថិជន មាន ប្រវត្តិ ខូច CBC នេះ ៕
ករណី វិជ្ជមាន មេរោគ H5N1 នេះ ត្រូវបាន បញ្ជាក់ ដោយ វិទ្យាស្ថាន ជាតិ សុខភាព សាធារណៈ និង វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ ម្សិលមិញ ។ បច្ចុប្បន្ន អ្នកជំងឺ ទទួលបាន ការថែទាំ យ៉ាង យកចិត្តទុកដាក់ ពីសំណាក់ ក្រុម គ្រូពេទ្យ ។
ជំងឺ ផ្តាសាយ បក្សី H5N1 គឺជា ជំងឺ ផ្តាសាយ មួយ ដែល ជាធម្មតា ចម្លង រវាង សត្វ បក្សី ឈឺ ទៅ បក្សី ផ្សេង ទៀត ប៉ុន្តែ ជួនកាល វា អាច ចម្លង ពី បក្សី ទៅ មនុស្ស តាម ការប៉ះពាល់ ជិតស្និទ្ធ ជាមួយ បក្សី ដែល ឈឺ ឬ ស្លាប់ ។ ជំងឺ ផ្តាសាយ បក្សី លើ មនុស្សជា ជំងឺ ធ្ងន់ធ្ងរ ដែល តម្រូវ ឱ្យ មាន ការធ្វើ ការព្យាបាល នៅ មន្ទីរពេទ្យ ទាន់ ពេល វេលា ។ ទោះបីជា វា មិន ងាយ ឆ្លង ពី មនុស្ស ទៅ មនុស្ស ប៉ុន្តែ បើ វា អាច បំប្លែង ខ្លួន អាច ឆ្លង ដូច នឹង ជំងឺ ផ្តាសាយ តាម រដូវកាល ផងដែរ ។
ក្រសួង សុខាភិបាល ក៏ បាន បង្ហាញ ពី វិធានការ បង្ការ ជំងឺ នេះ មួយចំនួន ដែរ ដូចជា ត្រូវ លាង ដៃ ឱ្យ បាន ញឹកញាប់ ជាមួយ សាប៊ូ និង ទឹក មុនពេល បរិភោគ និង បន្ទាប់ពី ប៉ះពាល់ ជាមួយ បក្សី ដាក់ កុមារ នៅ ឆ្ងាយ ពី សត្វ បក្សី និង ដាក់ សត្វ បក្សី នៅ ឱ្យ ឆ្ងាយ ពី កន្លែង រស់ នៅ កុំ បរិភោគ សត្វ បក្សី ឈឺ ឬ ងាប់ និង រាល់ សត្វ បក្សី ដែល ធ្វើ សម្រាប់ បរិភោគ ត្រូវ ចំ អិន ឱ្យ ឆ្អិន ល្អ ជាដើម ៕
សិក្ខាកាម វគ្គ សុក្រឹត្យ ការ ថ្នាក់ដឹកនាំ នគរបាល កម្រិត ២ ជំនាន់ ទី៥ នាំយក ថវិកា ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា
( ភ្នំពេញ ) ៖ តំណាង សិក្ខាកាម នៃ វគ្គ សុក្រឹត ការ ថ្នាក់ដឹកនាំ នគរបាល កម្រិត ២ ជំនាន់ ទី៥ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន នាំយក នូវ ថវិកា ចំនួន ២. ៥០០ដុល្លារ របស់ សិក្ខាកាម ទាំងអស់ ដែល បាន ចូលរួម បរិច្ចាគ ម្នាក់ បន្តិច ៗ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា តាមរយៈ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ក្នុង បុព្វហេតុ ដើម្បី កុមារ កម្ពុជា ។
សូម បញ្ជាក់ ថា សិក្ខាកាម នៃ វគ្គ សុក្រឹត ការ ថ្នាក់ដឹកនាំ នគរបាល កម្រិត ២ ជំនាន់ ទី៥ មាន សិក្ខាកាម សរុប ចំនួន ៣៦១ រូប ( នារី ៥១ រូប ) មកពី ១៤ អង្គភាព ចំណុះ ក្រសួង មហាផ្ទៃ ក្រោយ បាន សិក្សា រយៈពេល ៣ខែ នៅ បណ្ឌិត្យ សភា នគរបាល កម្ពុជា បាន មូលមតិ គ្នា ក្នុង ការរៃ អង្គាស ថវិកា ទាំងនេះ ដើម្បី រួមចំណែក ជួយ ទ្រទ្រង់ កិច្ច ដំណើរការ និង បន្ត នូវ បេសកកម្ម របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ក្នុង ការជួយសង្គ្រោះ ជីវិត កុមារ កម្ពុជា ។
ទោះបីជា ថវិកា ដែល បាន នាំមក ជូន នា ពេលនេះ ចំនួន មាន កម្រិត ក្តី តែ យើង សង្ឃឹម ថា វា ពិតជា បាន ចូលរួម ចំណែក មួយ យ៉ាង សំខាន់ ដើម្បី ទ្រទ្រង់ សកម្មភាព ជួយសង្គ្រោះ កុមារ កម្ពុជា ដែល មក សម្រាក ព្យាលបាល នៅ មន្ទីរពេទ្យ នេះ ។
តំណាង សិក្ខាកាម ក៏ បាន ថ្លែងអំណរគុណ និង សូម កោតសរសើរ ដោយ ស្មោះ ចំពោះ ថ្នាក់ដឹកនាំ ក្រុម គ្រូពេទ្យ ជំនាញ ទាំង ខ្មែរ និង បរទេស ព្រមទាំង បុគ្គលិក ទាំងអស់ នៃ មន្ទីរពេទ្យ គន្ធ បុប្ផា ដែល បាន ខិតខំ លះបង់ កម្លាំង កាយ ចិត្ត ជួយ សង្រ្គោះ ជីវិត កុមារ កម្ពុជា ផ្តល់ នូវ ក្តី អាណិត ស្រឡាញ់ ភាព កក់ក្តៅ និង ក្តីសង្ឃឹម ដល់ កុមារ កម្ពុជា ទាំងអស់ ប្រកបដោយ ស្នាមញញឹម មិន ប្រកាន់ វណ្ណៈ ពូជសាសន៍ អ្វី ឡើយ ។
គួរ ជម្រាប ថា មន្ទីរពេទ្យ គន្ធ បុប្ផា ជា មន្ទីរពេទ្យ តែ មួយ គត់ ដែល ទទួលយក ការពិគ្រោះ ពិនិត្យ និង ព្យាបាល ជំងឺ ដល់ កុមារ រាប់ ពាន់ នាក់ ក្នុង មួយ ថ្ងៃ ៗ ដោយ មិន គិត ថ្លៃ ប្រកបដោយ ការយកចិត្តទុកដាក់ វិជ្ជាជីវៈ និង ក្រមសីលធម៌ ខ្ពស់ បំផុត ៕
លើក ចុងក្រោយ បំផុត ដែល នាយក រដ្ឋមន្រ្តី នៃ ប្រទេស ហុង គ្រី បាន មក បំពេញ ទស្សនកិច្ច នៅឯ ប្រទេស អ៊ុយក្រែន គឺ តាំងតែពី ឆ្នាំ ២០១០ ។ រដ្ឋមន្រ្តី ការបរទេស អ៊ុយក្រែន និង ហុង គ្រី នឹង ត្រូវ ជួប ពិភាក្សា គ្នា នា ដើម សប្តាហ៍ ក្រោយ ហើយ ប្រធាន ខុទ្ទកាល័យ ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី បាន និយាយ ថា ដំណើរទស្សនកិច្ច របស់ លោក Orban អាចនឹង ត្រូវ លើក មក ពិភាក្សា អំលុង ជំនួប នោះ ។
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី រដ្ឋមន្ដ្រី ក្រសួង មុខងារ សាធារណៈ និង ប្រធាន គណៈកម្មការរៀបចំ ប្រឡង ប្រជែង ជ្រើសរើស មន្ដ្រីរាជការ ឲ្យ ចូល បម្រើ ការងារ ក្នុង ក្របខណ្ឌ គ្រូបង្រៀន នៃ ក្រសួង អប់រំ យុវជន និង កីឡា នឹង រៀបចំ សន្និសីទ សារព័ត៌មាន មួយ នៅ រសៀល ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ ពាក់ព័ន្ធ ការប្រឡង ប្រជែង ជ្រើសរើស គ្រូបង្រៀន ឯកទេស អប់រំ កាយ និង កីឡា ឆ្នាំ ២០២៣ ឲ្យ ចូល បម្រើ ការងារ ។
ដំណើរការ រៀបចំ ការប្រឡង ប្រជែង ជ្រើសរើស គ្រូបង្រៀន ឯកទេស អប់រំ កាយ និង កីឡា ជំនាន់ ទី ៣១ បាន បញ្ចប់ ការទទួល ពាក្យ និង ចេញ សេចក្តីសម្រេច ទទួលស្គាល់ បេក្ខភាព ជា ផ្លូវការ កាលពី ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៤ កន្លងទៅ នេះ ។
ការរៀបចំ សន្និសីទ សារព័ត៌មាន នេះ ក្នុង គោលបំណង ដើម្បី ផ្ដល់ វឌ្ឍនភាព ព័ត៌មាន អំពី ដំណើរការ រៀបចំ និង និតិវិធី ឆ្ពោះ ទៅកាន់ ការប្រឡង ជ្រើស រើស គ្រូបង្រៀន ឯកទេស អប់រំ កាយ និង កីឡា ជូន បេក្ខជន និង សាធារណជន ។
ការប្រជែង ជ្រើសរើស គ្រូបង្រៀន ឯកទេស អប់រំ កាយ និង កីឡា ឆ្នាំ ២០២៣ ឲ្យ ចូល បម្រើ ការងារ ក្នុង ក្របខណ្ឌ ក្រសួង អប់រំ យុវជន និង កីឡា នឹង ត្រូវ ប្រព្រឹត្តទៅ ក្រោម ប្រភេទ វិញ្ញាសា ចំនួន ២ គឺ ប្រភេទ វិញ្ញាសា សរសេរ និង ប្រភេទ វិញ្ញាសា អនុវត្តន៍ កីឡា ។ សម្រាប់ ប្រភេទ វិញ្ញាសា អនុវត្តន៍ កីឡា នឹង ត្រូវ ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២៤ និង ថ្ងៃ បន្តបន្ទាប់ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ កាយ និង កីឡា ។
ប្រភេទ វិញ្ញាសា អនុវត្តន៍ កីឡា មាន ៣វិញ្ញាសា ដូច ខាងក្រោម៖
ក្រុម ពេទ្យ ជប៉ុន សាន់ រ៉ាយស៍ ភ្នំពេញ ចុះ ធ្វើ ទស្សនកិច្ច និង ចែករំលែក បទពិសោធន៍ ការងារ ជាពិសេស ជំងឺ Stroke ដល់ មន្ទីរពេទ្យ បង្អែក ស្រុក ក្រូចឆ្មារ
( ត្បូងឃ្មុំ ) ៖ ក្រុម គ្រូពេទ្យ នៃ មន្ទីរពេទ្យ ជប៉ុន សាន់ រ៉ាយស៍ ភ្នំពេញ ដឹកនាំ ដោយ លោក វេជ្ជបណ្ឌិត OKAWADA Manabu ( អូកាវ៉ា ដា ម៉ាណា ប៊ុ) ប្រធាន មន្ទីរពេទ្យ បាន ចុះ ធ្វើ ទស្សនកិច្ច ទៅកាន់ មន្ទីរពេទ្យ បង្អែក ស្រុក ក្រូចឆ្មារ ដើម្បី ចែករំលែក បទពិសោធន៍ និង សំណេះសំណាល ជាមួយ មន្រ្តី រាជការ និង បុគ្គលិក មន្ទីរពេទ្យ បង្អែក ក្នុង ការពង្រឹង នូវ កិច្ចសហប្រតិបត្តិការ ជាមួយ មន្ទីរពេទ្យ ជា ដៃគូ ស្ថិត នៅ ភូមិ ខ្សាច់ ប្រឆេះ លើ ឃុំ ក្រូចឆ្មារ ស្រុក ក្រូចឆ្មារ ខេត្ត ត្បូងឃ្មុំ នា ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ ។
ក្នុង ដំណើរទស្សនកិច្ច ដែល ផ្តួចផ្តើម ឡើង ដោយ លោក ជា សុផារ៉ា សមាជិក ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ នេះ បាន ផ្តល់ នូវ ការសិក្សា ស្វែងយល់ នូវ គន្លឹះ ថ្មី ៗ បទពិសោធន៍ ថ្មី ៗ លើ វិស័យ សុខាភិបាល ដើម្បី បង្កើន គុណភាព ប្រសិទ្ធភាព បន្ថែម ទៀត ប្រកបដោយ ស្នាមញញឹម ធានា បាន ការផ្តល់ សេវា ថែទាំ សុខភាព ឆ្ពោះ ទៅរក ការគ្របដណ្តប់ សុខភាព ជា សកល ។
ជា លទ្ធផល បន្ទាប់ពី កិច្ចពិភាក្សា គ្នា លោក វេជ្ជបណ្ឌិត ប្រធាន មន្ទីរពេទ្យ ជប៉ុន សាន់ រ៉ាយស៍ ភ្នំពេញ បាន វាយតម្លៃ ខ្ពស់ លើ ការរីកចម្រើន របស់ មន្ទីរពេទ្យ បង្អែក ស្រុក បើ ប្រៀបធៀប ទៅនឹង ដំណើរទស្សនៈកិច្ច លើក ទី១ កន្លងទៅ ដោយ បាន សំណូមពរ ឲ្យ រៀបចំ រចនាសម្ព័ន្ធ នៃ ការព្យាបាល បន្ស៉ី គ្នា ឲ្យ ដូច ទៅនឹង មន្ទីរពេទ្យ ជប៉ុន សាន់ រ៉ាយស៍ ភ្នំពេញ ដើម្បី ធ្វើ ការរួមគ្នា ដោយ រលូន ។
បន្ទាប់មក ក្រុម គ្រូពេទ្យ មន្ទីរពេទ្យ ជប៉ុន សាន់រ៉ាយ៍ រាជធានី ភ្នំពេញ ក៏ បាន រៀបចំ សិក្ខាសាលា ផ្សព្វផ្សាយ ស្តីពី ជំងឺ គ្រោះថ្នាក់ ដោយ ស្ទះ និង ដាច់ សរសៃ ឈាម ខួរក្បាល (Stroke) ដែល ប្រព្រឹត្តិ ទៅ ក្រោម អធិបតីភាព លោក ហុក ពេជ្រ ហោះ អភិបាល រង ខេត្ត ត្បូងឃ្មុំ ។
សិក្ខាសាលា ផ្សព្វផ្សាយ នេះ ក្រុម គ្រូពេទ្យ មន្ទីរពេទ្យ ជប៉ុន សាន់ រ៉ាយស៍ ភ្នំពេញ បាន ធ្វើ បទបង្ហាញ លម្អិត ពី គ្រោះថ្នាក់ ដោយសារ ជំងឺ Stroke ដែល បាន ធ្វើឲ្យ ប្រជាពលរដ្ឋ ជាច្រើន ទទួល រងគ្រោះថ្នាក់ រហូត បាត់បង់ជីវិត និង ខ្លះ ទៀត ត្រូវ ស្លាប់ មួយ ចំហៀង ខ្លួន នៅ ដេក ឈឺ នៅលើ គ្រែ ពេទ្យ ហើយ ខ្លះ ទៀត ធ្លាក់ខ្លួន ឈឺ ជាច្រើន ខែ ឆ្នាំ ត្រូវ សម្រាក ព្យាបាល តាម ផ្ទះ ជាដើម ។
ក្នុង ឱកាស នោះ ដែរ លោក ហុក ពេជ្រ ហោះ អភិបាល រង ខេត្ត បាន ថ្លែង កោតសរសើរ ដល់ ក្រុម គ្រូពេទ្យ នៃ មន្ទីរពេទ្យ ជប៉ុន សាន់រ៉ាយស៍ ដែល បាន មក ធ្វើ សិក្ខាសាលា ផ្សព្វផ្សាយ ជូន ដល់ ក្រុម គ្រូពេទ្យ នៃ មន្ទីរពេទ្យ បង្អែក ស្រុក និង បងប្អូន ប្រជាពលរដ្ឋ ទូទៅ ឲ្យ មាន ការយល់ដឹង ពី ផល ប៉ះពាល់ នៃ ជំងឺ Stroke នេះ ។
( ស្វីស ) ៖ លោក បណ្ឌិត លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន និង ជា ប្រធាន កិច្ចប្រជុំ ត្រួតពិនិត្យ ឡើងវិញ លើក ទី៥ នៃ អនុសញ្ញា អូតា វ៉ា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ ក្រុមការងារ សម្របសម្រួល សកល ភាវូបនីយកម្ម នៃ អនុសញ្ញា អូតា វ៉ា ដើម្បី ពិភាក្សា អំពី បញ្ហា ស្នូល នៃ អាណត្តិ ប្រធាន របស់ កម្ពុជា និង កិច្ច ខិតខំ ប្រឹងប្រែង ក្នុង ការជំរុញ សកល ភាវូបនីយកម្ម នៃ អនុសញ្ញា អូតា វ៉ា នា ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នៅ ទីក្រុង ហ្សឺណែវ ។
កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី តំណាង ប្រទេស កម្ពុជា បែលហ្សិក ចក្រភព អង់គ្លេស កាណាដា ស្វីស ជប៉ុន ស៊ុយអែត ន័រវេស ថៃ ហូឡង់ អាល្លឺម៉ង់ និង តំណាង ISU . ICBL. ICRC ។ ក្នុង កិច្ចពិភាក្សា នោះ អង្គប្រជុំ បាន ដាក់ចេញ និង កំណត់ គោលដៅ ប្រទេស ទ មួយ ចំនួន ដែល ត្រូវ ធ្វើ សកម្មភាព សកល ភាវូបនីយកម្ម រួម មាន៖ បារ៉ែ ន ឡាវ កោះ ម៉ាស្យល មីក្រូណេស៊ី នេប៉ាល់ តុង ហ្គា វៀតណាម អាមេនី អាស៊ែ បៃហ្សង់ ហ្សកហ្ស៊ី លី បង់ ម៉ុងហ្គោលី និង សិង្ហបុរី ។
គណៈ អចិន្ដ្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា ថ្វាយ សារ លិខិត អបអរសាទរ សម្ដេច ព្រះមហិស្សរា នរោត្តម ច័ក្រពង្ស់ ដែល ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ ដំឡើង ព្រះឋានៈ ជា « សម្ដេច ក្រុម ព្រះ»
( ភ្នំពេញ )៖ គណៈ អចិន្ដ្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា បាន ថ្វាយ សារ លិខិត អបអរសាទរ ចំពោះ សម្ដេច ព្រះមហិស្សរា នរោត្តម ច័ក្រពង្ស់ ដែល ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទ្រង់ សព្វ ព្រះរាជ ហឫទ័យ ត្រាស់បង្គាប់ ដំឡើង ព្រះឋានៈ ជា សម្ដេច ក្រុម ព្រះ នរោត្តម ច័ក្រពង្ស់ ។
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៤០ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤០ នាក់ នោះ មាន ៣១ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស គ្រឿងញៀន ១៦ករណី និង ជនសង្ស័យ ០៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស ព្រហ្មទណ្ឌ ១០ករណី ។
( ភ្នំពេញ ) ៖ លោក ហែម វណ្ណឌី រដ្ឋមន្រ្តី ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ និង ជា ប្រធាន ក្រុមប្រឹក្សា បរធន បាល នៃ សហគ្រិន ខ្មែរ កាលពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ បាន ដឹកនាំ « កិច្ចប្រជុំ ក្រុមប្រឹក្សា បរធន បាល នៃ សហគ្រិន ខ្មែរ លើក ទី១៥ » ដោយ ផ្តោត លើ ការកំណត់ ទិសដៅ យុទ្ធសាស្រ្ត របស់ សហគ្រិន ខ្មែរ សម្រាប់ ឆ្នាំ ២០២៤ ។
លោក បណ្ឌិត ឈៀង វណ្ណ មុនិណ្ឌ នាយក ប្រតិបត្តិ សហគ្រិន ខ្មែរ បាន លើកឡើង ថា « សហគ្រិន ខ្មែរ បាន នឹង កំពុង រៀបចំ គម្រោង ដែល មាន សក្តានុពល ជាច្រើន មាន ទាំង គំនិត ផ្តួចផ្តើម ថ្មី ៗ និង ការពង្រីក កម្មវិធី ដែល កំពុង ដំណើរការ ស្រាប់ ដើម្បីឱ្យ កាន់តែ មាន ភាពប្រទាក់ ក្រឡា និង ប្រសិទ្ធភាព ដល់ សហគ្រិន ក្នុង ស្រុក នៅក្នុង វិស័យ ពាក់ព័ន្ធ ។ »
លោក បាន បញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត របស់ សហគ្រិន ខ្មែរ ក្នុង ការរៀបចំ និង អនុវត្ត កម្មវិធី ឱ្យ ស្រប តាម អាទិភាព ជា យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ឱ្យ បាន ពេញលេញ ក្នុង គោលបំណង ពង្រីក សក្តានុពល របស់ សហគ្រិន ។
កិច្ចប្រជុំ ក្រុមប្រឹក្សា បរធន បាល នៃ សហគ្រិន ខ្មែរ ដែល មាន សមាសភាព មកពី រាជ រដ្ឋាភិបាល និង វិស័យ ឯកជន នេះ បាន សម្រេច ជា ផ្លែ ផ្កា ក្នុង និង ការប្តេជ្ញា ជំរុញ និង អភិវឌ្ឍ សហគ្រាស ធុន តូច និង មធ្យម និង ធុរកិច្ច បង្កើត ថ្មី លើ វិស័យ ស្នូល ទាំង៤ របស់ សហគ្រិន ខ្មែរ គឺ កសិកម្ម សេវាកម្ម បច្ចេកវិទ្យា និង ផលិតកម្ម ៕
កម្ពុជា ចូលរួម វេទិកា ទេសចរណ៍ អាស៊ាន ២០២៤ កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី ទេសចរណ៍ អាស៊ាន លើក ទី ២៧ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ ក្រុង វៀង ចន្ទន៍
( ឡាវ )៖ គណៈប្រតិភូ ទេសចរណ៍ កម្ពុជា បាន ចូលរួម វេទិកា ទេសចរណ៍ អាស៊ាន ឆ្នាំ ២០២៤ កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី ទេសចរណ៍ អាស៊ាន លើក ទី ២៧ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ រដ្ឋធានី វៀង ចន្ទន៍ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ ចាប់ពី ថ្ងៃទី ២៣ - ២៧ ខែមករា ឆ្នាំ ២០២៤ ។ នេះ បើ តាម សេចក្តីជូនដំណឹង របស់ ក្រសួង ទេសចរណ៍ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នា ថ្ងៃទី ២៦ ខែមករា នេះ ។
គណៈប្រតិភូ ក្រសួង ទេសចរណ៍ ដែល ចូលរួម ក្នុង កិច្ចប្រជុំ ខាងលើ នេះ គឺ ដឹកនាំ លោក សុខ សូកេន រដ្ឋមន្តី ក្រសួង ទេសចរណ៍ តប តាម ការអញ្ជើញ របស់ លោកស្រី សួន សាវ៉ាញ វិញ៉ា កេត រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន វប្បធម៌ និង ទេសចរណ៍ ឡាវ ។ ។
នា ឱកាស វេទិកា ទេសចរណ៍ អាស៊ាន នេះ លោក រដ្ឋមន្រ្តី សុខ សូកេន បាន ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ទេសចរណ៍ អាស៊ាន លើក ទី ២៧ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ទេសចរណ៍ អាស៊ាន បូក៣ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ទេសចរណ៍ អាស៊ាន - ឥណ្ឌា និង កិច្ចប្រជុំ ជាមួយ ប្រទេស និង អង្គការ ដៃគូ ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
លោក រដ្ឋមន្ត្រី ក៏ នឹង ឆ្លៀត ឱកាស ជួបប្រជុំ ទ្វេ ភាគី ជាមួយ ប្រទេស សមាជិក អាស៊ាន និង អង្គការ ដៃគូ មួយចំនួន ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍ វិស័យ ទេសចរណ៍ អាស៊ាន និង កម្ពុជា ។
រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន ផ្សព្វផ្សាយ ភាពស្អាត របស់ កម្ពុជា កៀរគរ ហិរញ្ញប្បទាន បៃតង ដើម្បី លើកកម្ពស់ ជីវភាព សហគមន៍ ជនជាតិ ដើម ភាគ តិច
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ ប្រតិភូ សហព័ន្ធ អាល្លឺម៉ង់ ដែល ដឹកនាំ ដោយ លោក ចូខេន ហ្វាស់ បឺស (Jochen Flasbarth) រដ្ឋលេខាធិការ ក្រសួង កិច្ចសហប្រតិបត្តិការ និង អភិវឌ្ឍន៍ សេដ្ឋកិច្ច នាទី ស្តីការ ក្រសួង បរិស្ថាន ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ស្វាគមន៍ និង គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ អ្នក វិនិយោគ ដែល មាន បំណង ជួយ បង្កើន ការងារ ដល់ ប្រជា សហគមន៍ មូលដ្ឋាន និង ជួយ ឱ្យ បរិស្ថាន កម្ពុជា ស្អាត តាមរយៈ ការវិនិយោគ ដោយ ប្រើប្រាស់ ថាមពល កកើត ឡើងវិញ ។
ការលើកឡើង អំពី បរិស្ថាន ស្អាត របស់ លោក រដ្ឋមន្រ្តី ធ្វើឡើង ស្រប នឹង ជំនួប សម្តែង ការគួរសម ជាមួយ សមាគម សហគ្រាស គាំពារ បរិស្ថាន នៅ កម្ពុជា (EPIAC) ដោយ មាន ក្រុមហ៊ុន និង អ្នក វិនិយោគ មកពី ប្រទេស ចិន ចូលរួម ផងដែរ នា រសៀល ថ្ងៃទី ២៥ មករា ឆ្នាំ ២០២៤ នៅ ទីស្តីការ ក្រសួង បរិស្ថាន ។
ស្រប នឹង ការលើកឡើង នេះ លោក រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ថ្លែងអំណរគុណ ចំពោះ ការវិនិយោគ ស្អាត និង បើក ឱកាស ឱ្យ មាន ការវិនិយោគ បែប នេះ មក កម្ពុជា កាន់តែ ច្រើន ដើម្បី ផ្តល់ ឱកាស ការងារ ដល់ ប្រជា សហគមន៍ នៅ តាម មូលដ្ឋាន លើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ ស្រប តាម យុទ្ធសាស្រ្ត បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នីតិកាល ទី៧ នៃ រដ្ឋសភា ៕
ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា៖ ប្រព័ន្ធ ធនាគារ កម្ពុជា បន្ត មាន ស្ថិរភាព យ៉ាង រឹងមាំ ក្នុង ស្ថានភាព ប្រទេស មួយចំនួន មាន ការដួលរលំ គ្រឹះស្ថាន ធនាគារ
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា បាន បង្ហាញ ពី ចំណុច សំខាន់ ៗ មួយចំនួន ដែល ធនាគារ ជាតិ នៃ កម្ពុជា បាន ធ្វើ ជួយ ឲ្យ ប្រព័ន្ធ ធនាគារ កម្ពុជា បន្ត មាន ស្ថិរភាព យ៉ាង រឹងមាំ ក្នុង ស្ថានភាព ដែល បណ្តា ប្រទេស មួយចំនួន មាន ការដួលរលំ គ្រឹះស្ថាន ធនាគារ ។
លោកស្រី បណ្ឌិត ជា សិរី បាន បន្ដ ថា ចំពោះ ប្រទេស កម្ពុជា អត្រា ការប្រាក់ ឥណទាន នៅ កម្ពុជា ក៏ រក្សា បាន ស្ថិរភាព ល្អ បើ ទោះជា បាន កើនឡើង បន្តិចបន្តួច ចំពោះ គ្រឹះស្ថាន មួយចំនួន បើ ធៀប នឹង ការកើនឡើង នៅ បណ្តា ប្រទេស នានា ដោយសារ ការដំឡើង អត្រា ការប្រាក់ គោល របស់ ធនាគារ កណ្តាល ក្នុង ប្រទេស អភិវឌ្ឍន៍ ចម្បង ៗ ដូចជា សហរដ្ឋ អាមេរិក និង អឺរ៉ុប ។
លោកស្រី បណ្ឌិត បាន បញ្ជាក់ ថា « ខ្ញុំ ក៏ សូម វាយតម្លៃ ខ្ពស់ ចំពោះ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ នៅ កម្ពុជា ដែល បាន រួមចំណែក ក្នុង ការគោរព តាម បទប្បញ្ញត្តិ ប្រុងប្រយ័ត្ន នានា និង បន្ត ខិតខំ រក្សា ស្ថិរភាព អត្រា ការប្រាក់ ឥណទាន » ។
លោកស្រី បណ្ឌិត បញ្ជាក់ ថា ក្នុង ស្ថានភាព ដែល ការរៀបចំ ឥណទាន ឡើងវិញ ត្រូវបាន បញ្ចប់ ក្រោយ វិបត្តិ កូវីដ១៩ ហើយ សេដ្ឋកិច្ច ជាតិ តំបន់ និង ពិភពលោក បាន ប្រឈម នឹង ភាព មិន ច្បាស់លាស់ ខ្ពស់ ជាមួយនឹង ការកើនឡើង អត្រា ការប្រាក់ កម្ចី ក្រៅ ប្រទេស កំណើន ឥណទាន បាន ថយចុះ មក ត្រឹម ៤.៨% ដែល ជា អត្រា ទាប បំផុត ក្នុង រយៈពេល ជាង ២ទសវត្សរ៍ ចុងក្រោយ ។ ទោះ យ៉ាងណា កំណើន ឥណទាន នៅតែ បន្ត ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការរួមចំណែក ជំរុញ វិស័យ ផលិតកម្ម ដូចជា វិស័យ កម្មន្ត សាល និង កសិកម្ម ដែល នៅតែ មាន កំណើន ពីរ ខ្ទង់ ។
ទន្ទឹម នេះ ឥណទាន មិន ដំណើរការ ក៏ បាន បន្ត កើនឡើង ផងដែរ ដែល តម្រូវ ឱ្យ មាន ការយកចិត្ត ដាក់ ខ្ពស់ លើ ការត្រួតពិនិត្យ ធនាគារ ការធ្វើ Stress Test ជាប់ ជាប្រចាំ ការតាមដាន វាយតម្លៃ ឱ្យ បាន ស៊ីជម្រៅ លើ ហានិភ័យ ប្រទាក់ ក្រឡា ក៏ ដូចជា ទាមទារ ឱ្យ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ បន្ថែម ទៀត ។
បើកបរ សូម ប្រុងប្រយ័ត្ន គ្រប់ វិនាទី ! ស្លាប់ ៥នាក់ និង របួស ១២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៥ ខែមករា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ១២នាក់ ។
ការវាយប្រហារ របស់ ក្រុម ហ៊ូទី បាន រំខាន ដល់ ការដឹកជញ្ជូន ទូទាំង ពិភពលោក និង បាន បង្កើន ការព្រួយបារម្ភ អំពី អតិផរណា ពិភពលោក ។ វា ក៏ បង្កើន ការភ័យខ្លាច ថា ផល ប៉ះពាល់ នៃ សង្រ្គាម រវាង អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស នឹង ធ្វើឱ្យ មាន អស្ថិរភាព នៅ មជ្ឈិមបូព៌ា ផងដែរ ។
ទណ្ឌកម្ម ទាំងនោះ បាន ដាក់ លើ មន្ត្រី ជាន់ ខ្ពស់ ៗ របស់ ហ៊ូទី ដែល រួម មាន ដូចជា រដ្ឋមន្ត្រី ការពារ ជាតិ មេបញ្ជាការ កងទ័ព ជើងទឹក មេបញ្ជាការ កងកម្លាំង ឆ្មាំ សមុទ្រ និង នាយក លទ្ធកម្ម របស់ កងកម្លាំង មួយ នេះ ។
លោក Brian Nelson អនុ រដ្ឋមន្ត្រី នៃ ក្រសួង រតនាគារ សហរដ្ឋ អាមេរិក ទទួលបន្ទុក ភេរវកម្ម និង ចារកម្ម ហិរញ្ញវត្ថុ បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ ដូច្នេះ មួយ ថា « ការបន្ត ការវាយប្រហារ ភេរវករ របស់ ពួក ហ៊ូទី ប្រឆាំង នឹង នាវា ពាណិជ្ជកម្ម និង នាវិក ស៊ីវិល របស់ ពួកគេ ... គំរាមកំហែង ដល់ ការរំខាន ដល់ ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ អន្តរជាតិ និង សេរីភាព នៃ ការធ្វើ នាវាចរណ៍ ដែល មាន សារៈសំខាន់ ចំពោះ សន្តិសុខ ស្ថិរភាព និង វិបុលភាព ពិភពលោក » ។
លោក បាន បន្ត ថា « សកម្មភាព រួមគ្នា នៅ ថ្ងៃ នេះ ជាមួយ ចក្រភព អង់គ្លេស បង្ហាញ ពី សកម្មភាព រួម របស់ យើង ក្នុង ការប្រើ អំណាច ទាំងអស់ ដើម្បី បញ្ឈប់ ការវាយប្រហារ ទាំង នេះ » ។
អង់គ្លេស បាន និយាយ ថា បុរស ទាំង បួន នាក់ បានជាប់ពាក់ព័ន្ធ នឹង សកម្មភាព ដែល « គំរាមកំហែង ដល់ សន្តិភាព សន្តិសុខ និង ស្ថិរភាព ក្នុង ប្រទេស យេម៉ែន » ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ កងកម្លាំង សហរដ្ឋ អាមេរិក និង អង់គ្លេស បាន បើក ការវាយប្រហារ ថ្មី មួយ នៅក្នុង ប្រទេស យេម៉ែន ដោយ ផ្តោត លើ ទីតាំង ស្តុក ទុក ក្រោម ដី របស់ ក្រុម Houthi ក៏ ដូចជា សមត្ថភាព មីស៊ីល និង ការឃ្លាំមើល ដែល ប្រើប្រាស់ ដោយ ក្រុម សម្ព័ន្ធមិត្ត អ៊ីរ៉ង់ មួយ នេះ ប្រឆាំង នឹង ការដឹកជញ្ជូន នៅ សមុទ្រ ក្រហម ៕
អភិបាល ខណ្ឌ ច្បារអំពៅ ដឹកនាំ កម្លាំង ចុះ អនុវត្ត ច្បាប់ ចរាចរណ៍ ត្រួតពិនិត្យ គ្រឿងស្រវឹង នៅ ស្តុប វត្ត ច្បារអំពៅ
( ភ្នំពេញ ) ៖ ចាប់ពី យប់ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ តទៅ កម្លាំង នគរបាល រាជធានី ភ្នំពេញ នឹង ចាប់ផ្ដើម រឹតបន្តឹង ការអនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវគោក បន្ថែម ក៏ ដូចជា ការត្រួតពិនិត្យ គ្រឿងស្រវឹង ទៅ លើ អ្នកបើកបរ ហើយ ការរឹង បន្តឹង និង ការត្រួតពិនិត្យ នេះ នឹង ត្រូវ ធ្វើឡើង ដោយ ចល័ត ទីតាំង ថែម ទៀត ។
ជាក់ស្តែង នៅ យប់ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ច្បារអំពៅ ដឹកនាំ ដោយ លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ បាន ដឹកនាំ កម្លាំង សមត្ថកិច្ច ចម្រុះ ដាក់ គោលដៅ អនុវត្ត ច្បាប់ ចរាចរណ៍ ត្រួតពិនិត្យ ទៅ លើ អ្នកបើកបរ យានយន្ត ដើម្បី ពិនិត្យ និង វាស់ ជាតិ អាល់កុល លើ អ្នកបើកបរ ក្នុង គោលបំណង កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល កើត ចេញ ពី អ្នកបើកបរ ផ្ទុក នូវ ជាតិ ស្រវឹង លើស កម្រិត ។
លោក ចេង មុនីរ៉ា បាន ឱ្យដឹង ថា ការចាប់ផ្ដើម រឹតបន្តឹង បន្ថែម នេះ បន្ទាប់ពី សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា កាលពី ថ្ងៃទី ២៣ ខែមករា កន្លងទៅ នេះ បាន ណែនាំឲ្យ លោក នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ពង្រឹង ឡើងវិញ នូវ ការត្រួតពិនិត្យ គ្រឿងស្រវឹង ខណៈ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ បាន កើតឡើង ច្រើន ជា បន្តបន្ទាប់ ។
បើ តាម លោក ម៉ៅ សឿត អធិការ ខណ្ឌ ច្បារអំពៅ បាន ឱ្យដឹង ថា នា យប់ នេះ កម្លាំង អធិការដ្ឋាន ខណ្ឌ មាន កម្លាំង ចូលរួម អនុវត្ត ច្បាប់ ចរាចរណ៍ និង ត្រួតពិនិត្យ គ្រឿងស្រវឹង នាយប់ មាន ចំនួន ៤០ នាក់ ដោយឡែក កម្លាំង ប្រជាការពារ ខណ្ឌ រួមទាំង មន្ត្រី ខណ្ឌ ចំនួន ២០ នាក់ ផងដែរ ៕
លោក Li Qiang បាន គូសបញ្ជាក់ ថា ទំនាក់ទំនង ចិន - ជប៉ុន នា ពេលនេះ កំពុង ស្ថិត ក្នុង ដំណាក់កាល សំខាន់ មួយ ក្នុង ការបន្ត កេរ្តិ៍ដំណែល អតីតកាល និង បើក ចំហ អនាគត ដោយ បាន ជំរុញឱ្យ មជ្ឈដ្ឋាន ធុរកិច្ច នៃ ប្រទេស ទាំង ពីរ បន្ត ប្តេជ្ញាចិត្ត ឆ្ពោះ ទៅរក ទិសដៅ ត្រឹមត្រូវ នៃ សន្តិភាព មិត្តភាព កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ។
ដោយឡែក ប្រធាន ក្រុម ធុរកិច្ច មកពី ប្រទេស ជប៉ុន បាន សម្តែង នូវ ក្តីសង្ឃឹម ថា ប្រទេស ទាំង ពីរ នឹង ត្រឡប់ ទៅ រក បំណង ដើម នៃ មិត្តភាព និង ពង្រឹង ការផ្លាស់ប្តូរ ក្នុង វិស័យ ផ្សេង ៗ និង គ្រប់ កម្រិត ដោយ កត់សម្គាល់ ថា ប្រទេស ចិន គឺជា កម្លាំង ចលករ ដ៏ សំខាន់ សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ពិភពលោក ៕
អភិបាល ស្តីទី ខណ្ឌ ដូនពេញ ដឹកនាំ បេីក កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ ដេីម្បី ពង្រឹង ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់
( ភ្នំពេញ ) ៖ លោក ចាប ឌីណា អភិបាល ស្តី ទី នៃ គណៈអភិបាល ខណ្ឌ ដូនពេញ នៅ រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជេីញ ជា អធិបតី បេីក កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ ដូនពេញ នៅ រដ្ឋបាល ខណ្ឌ ដូនពេញ ។
កិច្ចប្រជុំ នេះ មាន របៀបវារៈ ដូច ខាងក្រោម៖
១៖ ពង្រឹង ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ និង កិច្ចការងារ ត្រួតពិនិត្យ អាវុធ ជាតិ ផ្ទុះ ជាតិ អាកុល ក្នុង មូលដ្ឋាន ខណ្ឌ ដូនពេញ ។ ( ពេល ស្រវឹង សូម កុំ ធ្វើ ការបើកបរ )
២៖ ពង្រឹង កិច្ចការងារ ទទួល សេវា តាម យន្តការច្រក ចេញ - ចូល តែ មួយ សង្កាត់ ទាំង ១១ របស់ ប្រជាពលរដ្ឋ ធ្វើឱ្យ លឿន មាន តម្លាភាព និង មាន ប្រសិទ្ធភាព ឱ្យ កាន់តែ ល្អ ប្រសើរ ។
៣៖ ពង្រឹង ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ តាម ច្រក ឌឿង ហែម ក្នុង មូលដ្ឋាន សង្កាត់ ទាំង ១១ ដើម្បី ធានា ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ ។
៤៖ ត្រូវ ធ្វើ របាយការណ៍ ជា ប្រចាំ ថ្ងៃ ចំពោះ កិច្ចការងារ ខាងលើ រួច រាយការណ៍ មក រដ្ឋបាល ខណ្ឌ ដូនពេញ ។
ឆ្នាំ ២០២៣ លេខ ទាន់ ហេតុការណ៍ 1291 កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ទទួល បណ្តឹង និង ព័ត៌មាន ផ្សេង ៗ ពី ប្រជាពលរដ្ឋ ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ជាង ១.៧០០ ករណី
ក្នុង រយៈកាល កន្លងមក ពេល បាន ទទួល សេចក្តីរាយការណ៍ និង បណ្តឹង ប្រចាំ ថ្ងៃ តាមរយៈ លេខ ទូរស័ព្ទ បន្ទាន់ 1291 ហើយ កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ ក៏ បាន ចុះ ជួយ ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ ភ្លាម ៗ ទាន់ សភាពការណ៍ ប្រកបដោយ ភាពកក់ក្តៅ បំផុត ។
អាវុធហត្ថ រាជធានី ភ្នំពេញ ក៏ សូម អភ័យទោស ផងដែរ ប្រសិនបើ ប្រជាពលរដ្ឋ ពុំ មាន ការចាំបាច់ ជាក់ស្តែង អ្វី ទេ សូម មេត្តា កុំ ហៅទូរស័ព្ទ ទៅ រំខាន ក្រុមការងារ ដើម្បី ទុក ពេលវេលា ឲ្យ ក្រុមការងារ បម្រើ ពលរដ្ឋ ផ្សេង ទៀត ដែល ត្រូវការ ជំនួយ បន្ទាន់ ពិតប្រាកដ ៕
ទីភ្នាក់ងារ ជាតិ បញ្ជាក់ ចំណាយ ប្រកាស ជ្រើសរើស បុគ្គលិក ជាប់ កិច្ចសន្យា ចំនួន ១៥ រូប ម្បី ពង្រឹង ការបំពេញ តួនាទី និង ភារកិច្ច របស់ ខ្លួន
ទីភ្នាក់ងារ ជាតិ បញ្ជាក់ ចំណាយ គឺជា អង្គភាព រដ្ឋបាល និង បច្ចេកទេស ផ្តល់ ការគាំទ្រ ដល់ ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម ក្នុង ការបញ្ជាក់ លើ ការស្នើសុំ ទូទាត់ ចំណាយ សេវា សុខាភិបាល នៃ មូលនិធិ សមធម៌ សុខាភិបាល និង សេវា វេជ្ជសាស្រ្ត នៃ របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព និង របប សន្តិសុខ សង្គម ផ្នែក ហានិភ័យ ការងារ ដែល មាន រចនាសម្ព័ន្ធ ស្ថិត នៅក្រោម ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
បុគ្គលិក ជាប់ កិច្ចសន្យា ចំនួន ១៥ រូប ដែល មាន មុខងារ និង តួនាទី ដូច ខាងក្រោម៖
៣) មន្ត្រី វិភាគ ផ្នែក សហប្រតិបត្តិការ និង ទំនាក់ទំនង ( ១រូប )
៦) មន្ត្រី បច្ចេកទេស ហិរញ្ញប្បទាន មូលនិធិ សមធម៌ សុខាភិបាល ( ១រូប )
ព័ត៌មាន លម្អិត សូម អាន ក្នុង សេចក្តីជូនដំណឹង បន្ថែ ម៖ គ្រាប់ ពូជ បន្លែ ជាច្រើន មុខ ត្រូវបាន ផ្ដល់ជូន ប្រជាពលរដ្ឋ ៥៩៩ គ្រួសារ រស់ នៅក្នុង ឃុំ ពោធិ៍ ស្រុក កំពង់លែង
( កំពង់ឆ្នាំង ) ៖ លោក បណ្ឌិត វង់ សណ្ដាប់ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ គ្រប់គ្រង ប្រព័ន្ធ ស្បៀង បម្រុង កម្ពុជា នៅ រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ចុះ មក ផ្តល់ គ្រាប់ ពូជ បន្លែ ដល់ ប្រពលរដ្ឋ ចំនួន ៥៩៩ នាក់ មកពី ៦ភូមិ ក្នុង ឃុំ ពោធិ៍ ស្រុក កំពង់លែង ខេត្ត កំពង់ឆ្នាំង ។
ក្នុង ពិធី ផ្ដល់ គ្រាប់ ពូជ បន្លែ ដល់ ប្រជាពលរដ្ឋ ខាងលើ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក មេឃុំ ពោធិ៍ ក្រុមប្រឹក្សា ឃុំ លោក មេភូមិ និង សមាជិក ភូមិ ទាំង៦ រួមទាំង ក្រុម យុវជន ស .ស .យ . ក ជាច្រើន រូប ទៀត បាន អញ្ជើញ ចូលរួម ផ្តល់ គ្រាប់ ពូជ បន្លែ ដែល មាន ដូច ជា៖ ពូជ គ្រាប់ ពោត . ត្រប់ ស្រួយ . ស្ពៃ ចង្កិះ . សណ្ដែក កួរ និង គ្រាប់ ពូជ បន្លែ ប៉េងប៉ោះ ដែល បាន ផ្ដល់ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង មួយ គ្រួសារ ៥កញ្ចប់ ដែល មាន គ្រាប់ ពូជ ចំនួន ៥មុខ ផងដែរ ។
ក្នុង ឱកាស នោះ ផងដែរ លោក រដ្ឋលេខាធិការ ក៏ បាន ធ្វើ ការផ្ដាំផ្ញើ ដល់ បងប្អូន ប្រជាកសិករ ទាំងអស់ ពេល ទទួលបាន គ្រាប់ ពូជ ទាំង នេះ ហើយ សូមឲ្យ យក ទៅ ធ្វើ ការដាំដុះ ដោយ ទទួលបាន ទិន្នផល ល្អ និង ទុក សម្រាប់ ធ្វើ ពូជ នៅ ឆ្នាំ ក្រោយ ៗ ទៀត ។
ឆ្លៀត ឱកាស នេះ ដែរ លោក រដ្ឋលេខាធិការ ក៏ បាន ក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដោយសារ រដូវ នេះ ជា រដូវ ប្រាំង ហេតុ នេះ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ចំពោះ ភ្លើង ផ្សែង ទាំងឡាយ ដោយ ចៀសវាង ការកើតឡើង នូវ អគ្គិភ័យ ដែល បណ្ដាលឲ្យ ឆាបឆេះ ផល ដំណាំ និង លំនៅដ្ឋាន របស់ បងប្អូន ផងដែរ ។
( ភ្នំពេញ ) ៖ លោក ហ៊ែល សារ៉ាត់ សមាជិក គ.ជ. ប បាន ឱ្យដឹង ថា គណបក្ស នយោបាយ ដែល បាន ចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត ជ្រើស តាំង សមាជិក ព្រឹទ្ធសភា ត្រូវ ដាក់ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ របស់ ខ្លួន ទៅ គណៈកម្មការ រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត ( គធ. ខប ) ក្នុង រយៈពេល យ៉ាង យូរ ៧ ថ្ងៃ បន្ទាប់ពី កាលបរិច្ឆេទ នៃ ការបិទ ផ្សាយ បញ្ជី រាយ នាម គណបក្ស នយោបាយ និង បញ្ជី បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត ផ្លូវការ ។
លោក ហ៊ែល សារ៉ាត់ បាន ថ្លែង ថា បញ្ជី រាយ នាម គណបក្ស នយោបាយ និង បញ្ជី បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត ផ្លូវការ គ.ជ. ប បិទ ផ្សាយ ជាសាធារណៈ នៅ តាម រាជធានី ខេត្ត ទាំង ២៥ ចាប់ពី ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ នេះ ដូច្នេះ កាលបរិច្ឆេទ នៃ ការដាក់ និង ការទទួល ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបា នឹង ត្រូវ ចាប់ផ្តើម នៅ ថ្ងៃទី ២៧ ខែមករា និង បញ្ចប់ នៅ ថ្ងៃទី២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
នា ឱកាស នោះ ដែរ លោក ហ៊ែល សារ៉ាត់ បាន បន្ថែម ថា សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ គ.ជ. ប បាន បញ្ចប់ ជាស្ថាពរ នូវ ដំណាក់កាល ចុះឈ្មោះ អ្នកបោះឆ្នោត និង ការចុះបញ្ជី បេក្ខជន គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត ។ ក៏ បាន បញ្ចប់ ផងដែរ នូវ ការចាប់ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ នៅលើ សន្លឹក ឆ្នោត ហើយ ត្រៀម អនុវត្ត ការងារ ជា បន្តបន្ទាប់ តាម ប្រតិទិន បោះឆ្នោត ដែល គ.ជ. ប បាន ដាក់ចេញ ។
មន្ត្រី ជាន់ ខ្ពស់ គ.ជ. ប រូប នេះ បាន បញ្ជាក់ ថា បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា អភិបាល អភិបាល រង នៃ គណៈអភិបាល រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ សមាជិក ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ឃុំ សង្កាត់ មេភូមិ ជំនួយការមេភូមិ និង កម្លាំងប្រដាប់អាវុធ មិន ត្រូវបាន អនុញ្ញាតឱ្យ ធ្វើជា ភ្នាក់ងារ គណបក្ស នយោបាយ ដើម្បី សង្កេតមើល ដំណើរការបោះឆ្នោត និង ការរាប់ សន្លឹក ឆ្នោត ឡើយ ។
ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ ( ទ. ១០០៧ ) ត្រូវ ចុះហត្ថលេខា ដោយ ប្រធាន ឬ តំណាង គណបក្ស នយោបាយ ដែល ទទួលបាន ការផ្ទេរ សិទ្ធិ ជា លាយលក្ខណ៍ អក្សរ ពី ប្រធាន គគ បក្ស នយោបាយ ។ ការផ្ទេរ សិទ្ធិ នេះ មិន អនុញ្ញាតឱ្យ ផ្ទេរ សិទ្ធិ បន្ត ឡើយ លើកលែងតែ ក្នុង លិខិត ផ្ទេរ សិទ្ធិ នោះ មាន ខ្លឹមសារ អនុញ្ញាតឱ្យ ផ្ទេរ សិទ្ធិ បន្ត ៕ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ និង ពិនិត្យ ជាតិ អាល់កុល ! មួយ យប់ នៅ រាជធានី ភ្នំពេញ ឃាត់ យានយន្ដ ល្មើស ជាតិ ស្រវឹង ២៣ គ្រឿង និង ល្មើស ផ្សេង ៗ ២១១ គ្រឿង
( ភ្នំពេញ ) ៖ លទ្ធផល នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ និង ត្រួតពិនិត្យ ជាតិ អាល់កុល នៅ យប់ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ ដែល ដឹកនាំ ផ្ទាល់ ដោយ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ឃាត់ យានយន្ដ ល្មើស ជាតិ ស្រវឹង ចំនួន ២៣ គ្រឿង និង ល្មើស ផ្សេង ៗ ចំនួន ២១១ គ្រឿង ។
ជា លទ្ធផល តាម បណ្តា អធិការដ្ឋាន នគរបាល ខណ្ឌ បាន ចុះ អនុវត្ត រឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក និង ត្រួតពិនិត្យ ជាតិ អាល់កុល ដូច ខាងក្រោម៖ ឃាត់ យានយន្ត ល្មើស សរុប ចំនួន ២៣៤ គ្រឿង ( រថយន្ត ចំនួន ៥គ្រឿង . ម៉ូតូ ចំនួន ២២៩ គ្រឿង ) ៖
* ទី២៖ បទល្មើស ផ្សេង ៗ ចំនួន ២១១ គ្រឿ ង៖ អត់ មួក សុវត្ថិភាព ចំនួន ២០៤ គ្រឿង . គ្មាន កញ្ចក់ មើល ក្រោយ ចំនួន ០២ គ្រឿង . កែច្នៃ ស៊ីម៉ាំង ចំនួន ២គ្រឿង និង ម៉ូតូ គ្មាន ផ្លាកលេខ ចំនួន ៣គ្រឿង ។
សេចក្តីប្រកាស ព័ត៌មាន ពី ការិយាល័យ លោក Erdogan បាន បង្ហាញ ថា លោក ប្រធានាធិបតី តួគ កី បាន ចុះហត្ថលេខា ជា ផ្លូវការលើ ការផ្តល់ សច្ចាប័ន ពីសំណាក់ សភា តួកគី ចំពោះ សមាជិកភាព ណាតូ របស់ ស៊ុយអែត ដែល ត្រូវបាន ធ្វើឡើង ក្នុង សប្តាហ៍ នេះ ពោលគឺ រយៈពេល ២០ ខែ បន្ទាប់ពី ទីក្រុង ស្តុក ខុល បាន ដាក់ពាក្យ ស្នើសុំ ចូលរួម ក្នុង ណា តូ ក្រោយ សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី ផ្ទុះឡើង នៅ អ៊ុយក្រែន ។
( ភ្នំពេញ ) ៖ តម្លៃ នៃ ការនាំចេញ ទំនិញ របស់ តំបន់ សេដ្ឋកិច្ច ពិសេស រ៉ូយ៉ាល់ គ្រុប ភ្នំពេញ របស់ អ្នក ឧកញ៉ា គិត ម៉េង មហាសេដ្ឋី កម្ពុជា បាន កើនឡើង ខ្លាំង គួរឱ្យ គត់ សម្គាល់ រយៈពេល ៨ ឆ្នាំ ចុងក្រោយ នេះ ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ តំបន់ សេដ្ឋកិច្ច ពិសេស រ៉ូយ៉ាល់ គ្រុប ភ្នំពេញ បាន លើកឡើង ថា « យើងខ្ញុំ មាន មោទនភាព បំផុត ដែល បាន រួមចំណែក ប្រហែល ៧% ក្នុង តម្លៃ នាំចេញ សរុប ទូទាំង ប្រទេស ដែល មាន ចំនួន ប្រមាណ ២៣.៤៧០ លាន ដុល្លារ អាមេរិក នេះ បើ យោង តាម របាយការណ៍ របស់ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា » ។
ការកើនឡើង យ៉ាង ខ្លាំង នេះ បាន កើតឡើង បើ ទោះបីជា ស្ថិត ក្នុង ស្ថានភាព COVID-19 ដ៏ សែន អាក្រក់ ក៏ ដោយ នេះ គឺ ដោយសារ ការ ពង្រីក និង ការរីកចម្រើន ជាលំដាប់ នៃ ផលិតកម្ម របស់ អ្នក វិនិយោគ ទាំងអស់ ជាពិសេស នៅក្នុង វិស័យ អគ្គិសនី និង អេឡិចត្រូនិច និង វិស័យ គ្រឿង បង្គំ រថយន្ត ។
ប្រភព ដែល បន្ថែម ទៀត ថា « ក្នុង នាម ជា អ្នក អភិវឌ្ឍ តំបន់ សេដ្ឋកិច្ច ពិសេស តួលេខ ខាងលើ នេះ ផ្តល់ឱ្យ យើង នូវ ថាមពល កាន់តែ ច្រើន ដើម្បី បន្ត ខិតខំ ប្រឹងប្រែង ផ្តល់ នូវ តំបន់ សេដ្ឋកិច្ច ពិសេស មួយ ដ៏ ល្អ បំផុត សម្រាប់ អ្នក វិនិយោគ កម្ពុជា និង អន្តរជាតិ សម្រាប់ ការធ្វើឱ្យ ប្រសើរឡើង នៃ អាជីវកម្ម របស់ អ្នក វិនិយោគ ក៏ ដូចជា សេដ្ឋកិច្ច រជាតិ និង ការរួមចំណែក ដល់ ឧស្សាហូបនីយកម្ម របស់ ប្រទេស ផងដែរ » ។
សូម ជម្រាប ថា តំបន់ សេដ្ឋកិច្ច ពិសេស រ៉ូយ៉ាល់ គ្រុប ភ្នំពេញ (RGPPSEZ) ត្រូវបាន បង្កើតឡើង ក្នុង ឆ្នាំ ២០០៦ ក្នុង គោលបំណង បង្កើត ទីតាំង ឈាន មុខ គេ សម្រាប់ អ្នកផលិត ពី ឧស្សាហកម្ម ផ្សេង ៗ និង បង្កើត ឱកាស ការងារ ជាច្រើន សម្រាប់ ប្រជាជន កម្ពុជា ។
រយៈពេល ជិត ១៨ ឆ្នាំ បាន កន្លងផុត ទៅ ហើយ បច្ចុប្បន្ន តំបន់ សេដ្ឋកិច្ច ពិសេស នេះ មាន ក្រុមហ៊ុន ផលិតកម្ម ចំនួន ៨៦ មកពី ១៤ ប្រទេស ផ្តល់ ការងារ ដល់ ប្រជាជន កម្ពុជា ចំនួន ៤៣. ៨០០ នាក់ និង ជន បរទេស ចំនួន ៧២០ នាក់ នៅក្នុង ឧស្សាហកម្ម ដែល មាន តម្លៃ បន្ថែម ខ្ពស់ របស់ ប្រទេស កម្ពុជា ។
ការអភិវឌ្ឍ និង ការរីកចំរើន ដ៏ សំខាន់ នេះ ក៏ ត្រូវបាន បង្ហាញ ឱ្យ ឃើញ ផងដែរ នៅក្នុង តម្លៃ នៃ ការនាំចេញ ផលិតផល ពី ក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស រ៉ូយ៉ាល់ គ្រុប ភ្នំពេញ ៕
អ្នក ឧកញ៉ា គួច ម៉េង លី៖ ភាព ខ្លាំង និង ថាមពល ស្ត្រី កើត ចេញ ពី សាមគ្គីភាព
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី ទីប្រឹក្សា កិត្តិយស នៃ សមាគម សហគ្រិន ស្រ្តី កម្ពុជា បាន ថ្លែង លើកទឹកចិត្ត ដល់ ស្ត្រី គ្រប់ រូប ដោយ បញ្ជាក់ ថា ភាព ខ្លាំង និង ថាមពល របស់ ស្ត្រី កើត ចេញ ពី សាមគ្គីភាព ។
អ្នក ឧកញ៉ា ថ្លែង បែប នេះ ក្នុង ឱកាស ចូលរួម ជា វាគ្មិន កិត្តិយស លើ ប្រធានបទ ស្តី អំពី « ភាព ខ្លាំង នៃ សាមគ្គីភាព របស់ ស្រ្តី » រៀបចំ ដោយ សមាគម សហគ្រិន ស្ត្រី កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នៅ សណ្ឋាគារ ហ៉ី ម៉ាវ៉ារី ។
អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី បាន ឲ្យដឹង ថា នៅលើ ពិភពលោក នេះ ទីណា ដែល មាន ស្ត្រី ពឹងផ្អែក លើ ស្ត្រី និង មាន អ្នកដឹកនាំ ជា ស្ត្រី ទីនោះ កាត់បន្ថយ អំពើហិង្សា កូន ចៅ សុខសាន្ត និង ការរីកចម្រើន ខ្ពស់ ។ ក្នុង ន័យ នេះ អ្នក ឧកញ៉ា ជំរុញ ឲ្យ សមាជិក សមាគម សហគ្រិន ស្ត្រី កម្ពុជា មាន សកម្មភាព កាន់តែ សកម្ម ខណៈ មាន ជាង ២០០០ នាក់ ឯ អ្នក សកម្ម មាន តែ ជាង ១០០ នាក់ ដែល នេះ អ្នក ឧកញ៉ា ចាត់ទុក ថា ជា កម្លាំង នៅ តិច បំផុត ។
អ្នក ឧកញ៉ា បាន លើកឡើង ទៀត ថា បើ តាម ធនាគារ ពិភពលោក និង ក្រសួង កិច្ចការ នារី សព្វ ថ្ងៃ គាំទ្រ ស្ត្រី ជាង ៥០០ នាក់ ជា សហគ្រិន ផ្តល់ ការងារ ឲ្យ ប្រជាពលរដ្ឋ ១៥០០០ នាក់ ហើយ រាប់ លាន នាក់ ទៀត ដែល ត្រូវបាន ផ្តល់ ការងារ ឲ្យ ធ្វើ ។ មាន តែ កម្លាំង ស្ត្រី ទេ ដែល អាច ធ្វើឲ្យ អ្វី ៗ មាន ការប្រែប្រួល យ៉ាង ធំធេង ។
« អីចឹង រួមចំណែក ខ្លាំង ណាស់ ដល់ រាជ រដ្ឋាភិបាល ដល់ ប្រទេសជាតិ មាន តែ នារី ទេ ដែល អាច បង្កើត ការជះឥទ្ធិពល ដ៏ ធំ ដែល អាច ធ្វើឲ្យ អ្វី ៗ មាន ការប្រែប្រួល ច្រើន ។ នារី គឺ មាន ភាពទន់ភ្លន់ សំឡេង មុត ហើយ ធ្ងន់ ដែល ភាគ ច្រើន បុរស ពិបាក បដិសេធ » ។ អ្នក ឧកញ៉ា បាន បញ្ជាក់ បែប នេះ ។
ក្នុង ឱកាស នោះ ដែរ ឧកញ៉ា កែវ មុំ ប្រធាន សមាគម សហគ្រិន ស្ត្រី កម្ពុជា បាន ថ្លែងអំណរគុណ អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី ដែល ជា អ្នកឧបត្ថម្ភ ផ្តាច់ មុខ ក្នុង ការរៀបចំ វេទិកា សហគ្រិន ស្រ្តី នេះ ។
រដ្ឋបាល ជលផល អំពាវនាវ ដល់ បងប្អូន ដែល កំពុង ចិញ្ចឹម ត្រី ឬ វារី សត្វ មាន ប្រភព ពី ក្រៅ ប្រទេស សូម ថែរក្សា ឲ្យបាន ខ្ជាប់ខ្ជួន ចៀសវាង លែង ចូលក្នុង ដែន ទឹក ធម្មជាតិ
រដ្ឋបាល ជលផល មាន សេចក្តីរីករាយ និង ថ្លែងអំណរគុណ ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ពិសេស អ្នកនេសាទ ដែល បាន ចូលរួម លែង នូវ ប្រភេទ ត្រី កម្រ ត្រី មេ ពូជ និង វារី សត្វ ផ្សេង ទៀត ជា អាទិ៍ ត្រី រាជ ត្រី គល់ រាំង ត្រី ត្រសក់ អណ្ដើក ហ្លួង អណ្ដើក សមុទ្រ ផ្សោត សមុទ្រ ដែល ជា សកម្មភាព ដ៏ ប្រពៃ ក្នុង ការចូលរួម ថែរក្សា ការពារ នូវ ធនធាន ជល ផល និង ទទួលបាន នូវ ការអបអរសាទរ យ៉ាង ខ្លាំង ពី មហាជន ។
ដោយឡែក នា ពេល ថ្មី ៗ នេះ មាន បងប្អូន ខ្លះ បាន លែង ត្រី ដែល មាន ប្រភព ពី ក្រៅ ប្រទេស ចូលក្នុង ដែន ទឹក ធម្មជាតិ សកម្មភាព នេះ អាចនឹង បង្ក ហានិភ័យ ដល់ មច្ឆជាតិ ក្នុង ស្រុក ។
រដ្ឋបាល ជលផល បាន បញ្ជាក់ ថា វារី សត្វ ឬ ប្រភេទ ត្រី ដែល មាន ប្រភព ពី ក្រៅ ប្រទេស មួយចំនួន ជា ប្រភេទ កាច ស៊ី សាច់ ជា អាហារ ឬ សាយ កូន លឿន ប្រសិនបើ ប្រភេទ ត្រី ឬ វារី សត្វ ទាំងនោះ មាន វត្តមាន កាន់តែ ច្រើន នៅក្នុង ដែន ទឹក ធម្មជាតិ វា នឹង ស៊ី ត្រី ក្នុង ធម្មជាតិ ដណ្តើម ទី ជម្រក និង អាច នាំឲ្យ ប៉ះពាល់ ដល់ ពូជ ក្នុង ស្រុក ។
បញ្ហា នេះ រដ្ឋបាល ជលផល សូម អំពាវនាវ ដល់ បងប្អូន ដែល កំពុង ចិញ្ចឹម ប្រភេទ ត្រី ឬ វារី សត្វ មាន ប្រភព ពី ក្រៅ ប្រទេស សូម ថែរក្សា ឲ្យបាន ខ្ជាប់ខ្ជួន ចៀសវាង លែង ឬ ធ្វេសប្រហែស ឲ្យ រួច ចូលក្នុង ដែន ទឹក ធម្មជាតិ ។ ករណី បងប្អូន មាន បំណង លែង ត្រី ឬ វារី សត្វ មាន ប្រភព ពី ក្រៅ ប្រទេស សូម ទំនាក់ទំនង មក មន្ត្រី ជំនាញ ជល ផល តាម លេខ ទូរស័ព្ទ ដូច ខាងក្រោម ។
រដ្ឋបាល ជលផល សូម លើកទឹកចិត្ត ដល់ បងប្អូន ប្រជាពលរដ្ឋ ពិសេស អ្នកនេសាទ បន្ត ផ្តល់ ព័ត៌មាន ដល់ សមត្ថកិច្ច ជល ផល និង លែង នូវ ប្រភេទ ត្រី កម្រ ត្រី មេ ពូជ និង វារី សត្វ ផ្សេង ទៀត ដែល នេសាទ បាន ឲ្យបាន ផុសផុល ថែម ទៀត ដែល នេះ ជា សកម្មភាព ដ៏ មាន តម្លៃ មិន អាច កាត់ថ្លៃ បាន ក្នុង ការចូលរួម ថែរក្សា ការពារ និង អភិរក្ស ធនធាន ជល ផល យើង ឲ្យបាន គង់វង្ស សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ។
អនុវត្ត តាម គោលការណ៍ ណែនាំ នេះ លោក ហាក់ ម៉ុង ហួត លោក មេឃុំ ពង្រ និង សហការី ដទៃ ទៀត បាន ទៅ សម្របសម្រួល ជាមួយ សហគមន៍ ទឹក ឆា នា ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម ដែល នៅជាប់ នឹង ស្រុក តាំង គោក ខេត្ត កំពង់ធំ ដើម្បី ស្នើសុំ បង្ហូរ ទឹក មួយចំនួន បញ្ជូន មកកាន់ ប្រឡាយ មេ នៃ ឃុំ ពង្រ ។ ទន្ទឹម នឹង នោះ អាជ្ញាធរ ក៏ ដើរ ប្រមូល ទឹក ពី ប្រឡាយ ផ្សេង ៗ ដែល នៅសល់ ទឹក ខ្លះ បូមបញ្ចូល មក ប្រឡាយ មេ បន្ថែម ទៀត ដើម្បី សង្គ្រោះ ឱ្យ បាន មួយ ជំហាន ដំបូង សិន ។
នៅ ដំណាក់ ទី៣នេះ ក៏ មាន ការចូលរួម ពី ប្រជាកសិករ យ៉ាង សស្រាក់សស្រាំ ក្នុង ការជួយ បូម ទឹក ឡើង ជួយ គ្នា ចេញ ប្រេង ចាក់ ម៉ាស៊ីន បូម ទឹក ពិសេស គឺ ការចូលរួម ក្នុង ការបែងចែក ទឹក ដោយ គ្មាន ភាពលំអៀង ជាដើម ដែល រឹតតែ ធ្វើឱ្យ លោក អភិបាល ស្រុក កាន់តែ មាន កម្លាំងចិត្ត ក្នុង ការជួយ ជំរុញ កិច្ចការ នេះ បន្ថែម ទៅ ទៀត ។
លោក អ៊ុំ គឹម សាន មេឃុំ ពង្រ បាន ឱ្យដឹង ថា បច្ចុប្បន្ន ការងារ សង្គ្រោះ ស្រូវ ប្រាំង ជាង ៥០០ ហិកតា នេះ គឺ ធ្វើ បាន ជាង ៧០ ភាគរយ ហើយ ហើយ ប្រសិនបើ ទឹក នៅតែ បញ្ចូន មក ដូច ស្ថានភាព បច្ចុប្បន្ន នេះ គឺ នឹង អាច សង្គ្រោះ បាន ១០០ ភាគរយ ជា ពុំ ខាន តែ ទោះបី ថា ខូចខាត ក៏ មាន តិចតួច បំផុត ដែរ ។
លោក មេឃុំ ពង្រ បាន បន្ត ថា ប្រសិនបើ មាន ទឹក គ្រប់គ្រាន់ ស្រែ ស្រូវ របស់ ប្រជាកសិករ អាច ទទួលបាន ផល លើស ពី ៥តោន ខណៈ តម្លៃ ស្រូវ ឥឡូវនេះ គឺ លក់ បាន ១គីឡូក្រាម អាច បាន ១៤០០ រៀល ដូច្នេះ ប្រសិនបើ ខាត ក៏ មិន ខាត ច្រើន ដែរ ឬ ក៏ អាច បាន ចំណេញ តិចតួច ក៏ ថា បាន ។
កសិករ នន់ ប៊ុន ហុង បាន ឱ្យដឹង ថា លើក ទី៣ នេះ លោក ឆ្លៀត ធ្វើ បន្ថែម បាន ៤. ៥ហិកតា ដែរ ហើយ រហូតមកដល់ ពេលនេះ លោក បាន បង្ហូរ ទឹក បញ្ចូល ស្រែ ជិត គ្រប់គ្រាន់ ហើយ នៅ ខ្វះ បន្តិចបន្តួច ប៉ុណ្ណោះ ហើយ លោក មាន ក្ដីរីករាយ ចំពោះ ការយកចិត្តទុកដាក់ របស់ លោក អភិបាល ស្រុក ហាក់ ម៉ុង ហួត និង លោក មេឃុំ ដែល បាន ខិតខំ ខ្នះ ខ្នែង ដោះស្រាយ បញ្ហា ទឹក ជូន កសិករ គ្រប់ គ្នា ។
ជាមួយគ្នា នោះ លោក វ៉ា ដេន ដែល ជា កសិករ មួយ រូប ដែរ នោះ បាន បញ្ជាក់ ថា លោក ធ្វើ ស្រែ លើក ទី៣ នេះ បាន តែ ជាង ១ហិកតា ទេ ដោយសារ ដំបូង ឡើយ ឃើញ មាន ទឹក នៅសល់ ច្រើន ក្នុង ប្រឡាយ មេ តែ ដល់ ពេល ក្រោយមក ក៏ បែរជា ខ្វះ ទឹក ទៅ វិញ តែ យ៉ាងណា ឃើញ អាជ្ញាធរ ស្រុក អាជ្ញាធរ ឃុំ បាន ជួយ ប្រជាកសិករ យ៉ាង សស្រាក់សស្រាំ ដែល ធ្វើឱ្យ ស្រែ ស្រូវ ជាច្រើន មាន ទឹក បញ្ចូល ឡើងវិញ ។
កសិករ ទាំង ២រូប ក៏ សង្ឃឹម ថា អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ បន្ត ជួយ បូម បញ្ចូន ទឹក ចូល ប្រឡាយ មេបន្ត ទៀត ដើម្បី ទុក សម្រាប់ បញ្ចូល ស្រែ ឱ្យ បាន គ្រប់គ្រាន់ រហូតដល់ ពេល ប្រមូល ផល ខណៈ នៅតែ ជាង ១ខែ ឬ ជិត ២ខែ ទៀត ប៉ុណ្ណោះ ។
ឆ្លើយតប នឹង សំណូមពរ នេះ លោក អភិបាល ស្រុក ហាក់ ម៉ុង ហួត ក៏ នៅតែ តាមដាន បញ្ហា នេះ យ៉ាង យកចិត្តទុកដាក់ ដើម្បី ជួយ ឱ្យ ស្រែ ស្រូវ បន្ត មាន ទឹក ស្រោចស្រព រហូរ ដល់ ពេល ប្រមូល ផល ហើយ លោក ក៏ ដូចជា សហការី មិន នឿយហត់ នឹង កិច្ចការ ដើម្បី ប្រជាពលរដ្ឋ នោះ ឡើយ ។ មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ កោតសរសើរ លោក អភិបាល ស្រុក រូប នេះ ថា គាត់ ប្រឹង ធ្វើការគ្មាន សៅរ៍ អាទិត្យ នោះ ឡើយ ៕
ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ២៦ ខែមករា ឆ្នាំ ២០២៤ ។
ក្រសួង បញ្ជាក់ ថា ទ្រនុង សម្ពាធ ខ្ពស់ ពី ប្រទេស ចិន នៅតែ បន្ត ឥទ្ធិពល មក លើ ខាងជើង និង ឦសាន ប្រទេស កម្ពុជា ជាមួយនឹង ខ្យល់ មូសុង ឦសាន កម្រិត មធ្យម ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឱ្យ៖ ចាប់ពី ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៨ ខែមករា ឆ្នាំ ២០២៤៖
គួរ ជម្រាប ថា មណ្ឌល ផ្តល់ សេវា សាធារណៈ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ទីតាំង ថ្មី នេះ គឺជា សមិទ្ធផល ថ្មី មួយ បន្ថែម ទៀត និង ជា យន្តការ មួយ ក្នុង ការបង្ខិត ការផ្តល់ សេវា សាធារណៈ ឱ្យ បាន កាន់តែ ជិត ប្រជាពលរដ្ឋ បង្ក លក្ខណៈ ងាយស្រួល ចំណេញ ពេលវេលា និង កាត់បន្ថយ ការចំណាយ ក៏ ដូចជា បង្កើន ប្រសិទ្ធភាព និង តម្លាភាព នៃ ការផ្តល់ សេវា សាធារណៈ របស់ ក្រសួង ជូន ដល់ ប្រជាពលរដ្ឋ ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ - ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោក ប៉េង ពោធិ៍នា បាន ឱ្យដឹង ទៀត ថា ការផ្លាស់ប្តូរ ទីតាំង និង ការបើក ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ មណ្ឌល ផ្ដល់ សេវា សាធារណៈ ទីតាំង ថ្មី ជាន់ ទី៤ នៅ ផ្សារ ទំនើប អ៊ីអន ម៉ល ភ្នំពេញ នេះ កឺ មាន បរិវេណ ធំ ទូលាយ ជាង ទីតាំង ចាស់ ហើយ បាន បន្ថែម សេវា សាធារណៈ ចាំបាច់ មួយ ចំនួន ទៀត ដូចជា សេវា ចុះបញ្ជី រថយន្ត ថ្មី សេវា ផ្ទេរ កម្មសិទ្ធិ រថយន្ត និង ការដាក់ពាក្យ ស្នើសុំ ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ កាន់តែ ផ្តល់ ភាពងាយស្រួល និង ស្រប តាម កំណើន នៃ តម្រូវការ របស់ ប្រជាពលរដ្ឋ ដែល ជា អ្នក មក ទទួល សេវា ។
ស្រប តាម ចក្ខុវិស័យ មាគ៌ា នយោបាយ និង យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧នេះ ក្រសួង សាធារណការ បាន ដាក់ចេញ នូវ ផែនការ អាទិភាព ក្នុង ការពង្រឹង និង លើកកម្ពស់ ការប្រើប្រាស់ បច្ចេកវិទ្យា ជាក់ស្តែង ទីតាំង ថ្មី នេះ បាន ប្រើប្រាស់ ប្រព័ន្ធ បច្ចេកវិទ្យា ឌីជីថល ដើម្បី ជួយ សម្រួល ដល់ ការផ្តល់ សេវា សាធារណៈ ប្រកបដោយ តម្លាភាព ប្រសិទ្ធភាព និង គណនេយ្យភាព ដែល បាន និង កំពុង ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការធ្វើ កំណែទម្រង់ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម ។
លោក រដ្ឋមន្ត្រី ប៉េង ពោធិ៍នា បាន បន្ថែម ថា ក្រៅពី ការផ្តល់ សេវា សាធារណៈ ក្រសួង ក៏ មាន គោលដៅ អាទិភាព សម្រាប់ ការអភិវឌ្ឍ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន ដើម្បី សម្រេច ឱ្យ បាន នូវ សមិទ្ធផល ថ្មី ៗ បន្ថែម ទៀត ពាក់ព័ន្ធ នឹង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ រូបវ័ន្ត ដូច ជា៖ ផ្លូវថ្នល់ ស្ពាន ផ្លូវ ដែក ផ្លូវ ទឹក ផ្លូវ សមុទ្រ កំពង់ផែ និង ឡូជី ស្ទីក រួមទាំង ការដាក់ចេញ នូវ យន្តការគាំទ្រ ដល់ ការធ្វើឱ្យ ប្រសើរឡើង នូវ គុណភាព ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន និង ការបង្កើន ការតភ្ជាប់ ប្រទាក់ ក្រឡា គ្នា ផងដែរ ។
( សៀមរាប ) ៖ លោក បណ្ឌិត ប៉ាន់ ខែម ប៊ុន ថន នាយក រង ខុទ្ទកាល័យ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ជា រដ្ឋលេខាធិការ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី និង ជា ប្រធាន ប្រតិបត្តិ សម្ពន្ធ យុវជន ស្រលាញ់ សន្តិភាព រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជា អធិបតី ប្រកាស កែសម្រួល រចនាសម្ព័ន្ធ ដឹកនាំ របស់ គណៈកម្មាធិការ ប្រតិបត្តិ សម្ពន្ធ យុវជន ស្រលាញ់ សន្តិភាព ខេត្ត សៀមរាប ។
ស្ថានទូត ឥណ្ឌូនេស៊ី ប្រចាំ កម្ពុជា និង ក្រសួង បរិស្ថាន បើក ទំព័រ នៃ កិច្ចសហប្រតិបត្តិការ ផ្តោត លើ ពាណិជ្ជកម្ម កាបូន និង ថាមពល បៃតង ឆ្លើយតប នឹង ការប្រែប្រួល អាកាសធាតុ
( ភ្នំពេញ ) ៖ ពាណិជ្ជកម្ម កាបូន និង ថាមពល បៃតង ឆ្លើយតប នឹង ការប្រែប្រួល អាកាសធាតុ ជា ខ្លឹមសារ រួម នៃ កិច្ចពិភាក្សា ដើម្បី បើក ទំព័រ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី រវាង ឥណ្ឌូនេស៊ី និង កម្ពុជា នា រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នៅ ទីស្តីការ ក្រសួង បរិស្ថាន ។
ចំពោះ លោក ឯក អគ្គ រដ្ឋទូត ជំនួប ទ្វេ ភាគី នៅ ថ្ងៃ នេះ គឺជា ឱកាស ល្អ ក្នុង កិច្ចសហប្រតិបត្តិការ ទូត ដើម្បី បន្ត រឹត ចំណង មិត្តភាព រវាង កម្ពុជា និង ឥណ្ឌូនេស៊ី ឱ្យ កាន់តែ មាន ភាព ស្អិត រមួត ទ្វេ ឡើង ។
លើស ពី នេះ ឯក អគ្គ រដ្ឋទូត ក៏ បាន លើកឡើង អំពី គោលបំណង ក្នុង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ដែល ផ្តោត សំខាន់ លើ កិច្ច គាំពារ បរិស្ថាន ជីវៈ ចម្រុះ និង សេដ្ឋកិច្ច បៃតង ដោយ រាប់បញ្ចូល ឥណទាន កាបូន ពាណិជ្ជកម្ម កាបូន និង ថាមពល បៃតង ឆ្លើយតប នឹង ការប្រែប្រួល អាកាសធាតុ ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ថ្លែងអំណរគុណ ចំពោះ ឯកឧត្តម ឯក អគ្គ រដ្ឋទូត និង ជូនពរ ឱ្យ ឯកឧត្តម ទទួលបាន ជោគជ័យ ក្នុង ការបំពេញ ភារកិច្ចការ ទូត នៅ កម្ពុជា ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្រ្តី បាន ជម្រាប ជូន លោក ឯក អគ្គ រដ្ឋទូត អំពី យុទ្ធសាស្រ្ត ចក្រា ក្នុង វិស័យ បរិស្ថាន ឆ្នាំ ២០២៣ - ២០២៨ ហើយ ឈរ លើ យុទ្ធសាស្រ្ត គន្លឹះ នេះ កម្ពុជា សម្រេចបាន ភាពស្អាត ភាព បៃតង និង ចីរភាព ស្រប នឹង គោលបំណង នៃ ជំនួប នៅ ថ្ងៃ នេះ ដែល ឯកឧត្តម ឯក អគ្គ រដ្ឋទូត បាន លើកឡើង ។
កម្ពុជា - ឥណ្ឌូនេស៊ី នឹង ធ្វើការ ជាមួយគ្នា យ៉ាង ជិតស្និទ្ធ ដើម្បី សម្អាត ប្រទេស ទាំង ពីរ ឱ្យ ទទួលបាន ភាពស្អាត មិន មាន ការបំពុល ដោយ សំណល់ ប្លាស្ទិក និង មាន ភាព បៃតង តាមរយៈ ការបង្កើន គម្រប ព្រៃឈើ ឈាន ឆ្ពោះទៅជា ប្រទេស អព្យាក្រឹត កាបូន ឆ្លើយតប នឹង ការប្រែប្រួល អាកាសធាតុ ដើម្បី ពង្រឹង ការវិនិយោគ បៃតង ក្រោម កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ដ៏ រឹងមាំ នេះ ។
គួរ រម្លឹក ជូន ថា ទំនាក់ទំនង ការទូត រវាង ឥណ្ឌូនេស៊ី និង កម្ពុជា អស់ រយៈពេល ៦៥ ឆ្នាំ មក នេះ បាន នាំមក នូវ ផលប្រយោជន៍ ជាច្រើន តាមរយៈ ការវិនិយោគ ការនាំចេញ នាំចូល ផលិតផល ការផ្លាស់ប្តូរ ទំនិញ កសិកម្ម ឧស្សាហកម្ម សម្រាប់ ប្រជាពលរដ្ឋ នៃ ប្រទេស ទាំង ពីរ ៕ បណ្ឌិត កៅ គឹម ហួន ដឹកនាំ គណៈប្រតិភូ អាស៊ាន ចូលរួម កិច្ចប្រជុំ ទេសចរណ៍ អាស៊ាន លើក ទី ២៧ និង មាន ជំនួប មួយចំនួន ទៀត នៅ ទីក្រុង វៀង ច័ន្ទ ប្រទេស ឡាវ
នៅ រសៀល ដដែល នេះ លោក បណ្ឌិត កៅ គឹម ហួន ក៏ បាន អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ទេសចរណ៍ អាស៊ាន និង ឥណ្ឌា លើក ទី ១១ ដែល ធ្វើជា សហ ប្រធាន ដោយ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន វប្បធម៌ និង ទេសចរណ៍ ឡាវ និង ឯក អគ្គ រដ្ឋទូត ឥណ្ឌា ប្រចាំ អាស៊ាន ។ នៅក្នុង ឱកាស នោះ លោក អគ្គ លេខាធិការ អាស៊ាន បាន ចែករំលែក ទស្សនៈ ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង អាស៊ាន និង ឥណ្ឌា នៅក្រោម ផែនការការងារ ទេសចរណ៍ អាស៊ាន - ឥណ្ឌា ។
( ភ្នំពេញ ) ៖ តប តាម ការអញ្ជើញ របស់ លោក សាលើ មសៃ គុំ ម៉ាស៊ីត ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ការបរទេស នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ លោក សុខ ចិន្តា សោភា ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នឹង អញ្ជើញ ចូលរួម កិច្ច ប្រជុំ ចង្អៀត រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៨ - ២៩ ខែមករា ឆ្នាំ ២០២៤ នៅ ទីក្រុង ហ្លួង ព្រះបាង នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ ។
ក្រោម មូល បទ « អាស៊ាន៖ ការពង្រឹង ការតភ្ជាប់ និង ភាពធន់ » កិច្ចប្រជុំ ចង្អៀត រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន នឹង ពិភាក្សា អំពី អាទិភាព និង គម្រោង សមិទ្ធផល សំខាន់ ៗ ក្រោម ភាពជា ប្រធាន អាស៊ាន របស់ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ សម្រាប់ ឆ្នាំ ២០២៤ ។
រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន នឹង ពិនិត្យ តាមដាន ការងារ នានា នៅ ក្រោយ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤៣ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ព្រមទាំង ពិភាក្សា អំពី វិធីសាស្ត្រ នានា ឆ្ពោះ ទៅរក ការកសាង សហគមន៍ អាស៊ាន រួមទាំង វឌ្ឍនភាព នៃ ការរៀបចំ ចក្ខុវិស័យ សហគមន៍ អាស៊ាន ឆ្នាំ ២០៤៥ ។ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន ក៏ នឹង ផ្លាស់ប្តូរ ទស្សនៈ ស្តីពី ទំនាក់ទំនង ខាងក្រៅ របស់ អាស៊ាន ក៏ ដូចជា បញ្ហា តំបន់ និង អន្តរជាតិ ដែល ជា ផលប្រយោជន៍ និង ក្តីបារម្ភ រួម ផងដែរ ។
ក្នុង ឱកាស នៃ កិច្ចប្រជុំ ចង្អៀត នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី នឹង មាន ជំនួប ពិភាក្សា ទ្វេ ភាគី ជាមួយ សមភាគី អាស៊ាន មួយចំនួន ដើម្បី ពង្រីក កិច្ចសហប្រតិបត្តិការ ដែល ផ្តល់ ផលប្រយោជន៍ ទៅ វិញ ទៅ មក ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី និង ពហុ ភាគី ៕
ប្រទេស អាស៊ី អាគ្នេយ៍ ទាំង ពីរ កំពុង ប្រកួតប្រជែង គ្នា លើ តំបន់ នៃ សមុទ្រ ចិន ខាងត្បូង ដែល ជា ផ្លូវ ទឹក ដ៏ សំខាន់ សម្រាប់ ការនេសាទ និង ពាណិជ្ជកម្ម ពិភពលោក ដែល ចិន ទាមទារ ស្ទើរតែ ទាំងស្រុង ។
ឆ្មាំ សមុទ្រ ហ្វីលីពីន បាន និយាយ នៅ ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ ថា ប្រទេស ទាំង ពីរ នឹង ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ស្តីពី កិច្ចសហប្រតិបត្តិការ ឆ្មាំ ឆ្នេរសមុទ្រ ។ វា មិន ច្បាស់ ថា កិច្ចព្រមព្រៀង នេះ នឹង រួមបញ្ចូល អ្វី ខ្លះ នោះ ទេ ប៉ុន្តែ កិច្ចសហប្រតិបត្តិការ ឆ្មាំ ឆ្នេរសមុទ្រ ជាធម្មតា មាន សារៈសំខាន់ ណាស់ ក្នុង ការកាត់បន្ថយ ហានិភ័យ នៃ ការប៉ះទង្គិច គ្នា រវាង នាវា នេសាទ ដែល ឈ្លាន ពាន ចូល ទៅក្នុង ដែន ទឹក បរទេស ដែល ជា ជំហាន មួយ ដែល អាច ជួយ បន្ធូរបន្ថយ ជម្លោះ ទឹកដី ទ្វេ ភាគី ។
ប្រទេស ចិន មាន ការទាមទារ ដ៏ ទូលំទូលាយ ចំពោះ សមុទ្រ ចិន ខាងត្បូង ហើយ ជារឿយ ៗ មាន ការសង្ស័យ ចំពោះ វឌ្ឍនភាព ក្នុង ការដោះស្រាយ ជម្លោះ ព្រំដែន ក្នុង ចំណោម អ្នក ទាមទារ ផ្សេង ទៀត ។ បន្ទាប់ពី វៀតណាម និង ឥណ្ឌូនេស៊ី បាន ទទួលស្គាល់ ព្រំដែន នៃ តំបន់ សេដ្ឋកិច្ច ផ្តាច់ មុខរៀង ៗ ខ្លួន នៅ សមុទ្រ ចិន ខាងត្បូង ក្នុង ខែធ្នូ ឆ្នាំ ២០២២ ឆ្មាំ សមុទ្រ ចិន បាន ធ្វើដំណើរ ម្តង ហើយ ម្តង ទៀត នៅជិត តំបន់ យុទ្ធសាស្ត្រ ទាំងនោះ ដែល បង្កឱ្យ មាន ប្រតិកម្ម ខឹងសម្បារ ទាំង ទីក្រុង ហ្សាកាតា និង ហាណូយ ។
ពិធី « ផ្សព្វផ្សាយ អនុសំវច្ឆរ មហាសន្និបាត មន្រ្តី សង្ឃ ទូទាំង ប្រទេស លើក ទី ៣១ » នៅ ខេត្ត ស្វាយរៀង ផ្តោត លើ ខ្លឹមសារ ចំនួន ៩ចំណុច
( ស្វាយរៀង ) ៖ ពិធី « ផ្សព្វផ្សាយ ខ្លឹមសារ អនុសំវច្ឆរ មហាសន្និបាត មន្រ្តី សង្ឃ ទូទាំង ប្រទេស លើក ទី ៣១ » ធ្វើឡើង នៅ សាលា គណ ខេត្ត ស្វាយរៀង ក្រោម អធិបតី សម្តេច ព្រះមហា រិយវង្ស យ៉ន សេង យៀត ព្រះអនុប្រធាន លេខាធិការដ្ឋាន គណៈ សង្ឃ នាយក ព្រះរាជ តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្តេច ព្រះសង្ឃ នាយក នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា ព្រះអធិបតី ។
ខ្លឹមសារ អនុសំវច្ឆរ លើក ទី ៣១ នេះ មាន ដូច ខាងក្រោម៖
៣៖ ពុទ្ធ មណ្ឌល វិបស្សនា ធុរៈ នៃ ព្រះរាជាណាចក្រ កម្ពុជា មាន ភារកិច្ចសហការ ជាមួយ អគ្គាធិការដ្ឋាន ពុទ្ធិក សិក្សា ជាតិ ក្នុង ការរៀបចំ ដាក់ បញ្ចូល មេរៀន សមាធិ - វិបស្សនា និង ការបដិបត្តិ ជាក់ស្តែង ក្នុង កម្មវិធី សិក្សា នៃ សាលា ពុទ្ធិកៈ គ្រប់ កម្រិត ជា ជំហ៊ាន ៗ ដើម្បី ជា ប្រយោជន៍ ឱ្យ សមណ សិស្ស - សមណ និស្សិត នឹង និស្សិត ដែល កំពុង ទទួល ការបណ្តុះបណ្តាល ក្នុង សាលា ពុទ្ធិក សិក្សា មាន ចំណេះដឹង ផ្នែក ខាង ការអប់រំ ចិត្ត តាមរយៈ ការសិក្សា ទ្រឹស្ដី សមថ - វិបស្សនា កម្មដ្ឋាន និង ការបដិបត្តិ ជាក់ស្តែង ។
៨៖ បន្ត ពង្រឹង និង ពង្រីក ការកសាង វត្ត អារាម រដ្ឋធម្មយុត្តិក និកាយ ខ្មែរ បង្កើត ឱ្យ មាន សាលា ធម្មវិន័យ ពុទ្ធិក សិក្សា ដើម្បី បណ្តុះបណ្តាល ធនធាន មនុស្ស បង្កើត សាលារៀន ព្រះធម៌ ដល់ កុមារ និង បរិស័ទ តាម មូលដ្ឋាន ឱ្យ មាន មណ្ឌល វិបស្សនា កម្មដ្ឋាន បដិបត្តិ អប់រំ ចិត្ត អប់រំ ជំនាញ និង វិធី ដោះស្រាយ អធិករណ៍ នានា ដោយ មាន ការប្រឡង ប្រជែង ជាប្រចាំ ។
