( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន សព្វ ព្រះរាជ ហឫទ័យ ត្រាស់បង្គាប់ តែងតាំង ផ្តល់ និង ដំឡើង ឋានៈ ជា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ចំនួន ៣រូប មាន ឋានៈ ស្មើ ឧប នាយក រដ្ឋមន្ត្រី ។
ទី១៖ លោក ស៉ិក ប៊ុន ហុក មាន ឋានៈ ស្មើ ឧប នាយក រដ្ឋមន្ត្រី
ទី២៖ លោក ជិន ប៊ុន ស៊ាន មាន ឋានៈ ស្មើ ឧប នាយក រដ្ឋមន្ត្រី
ទី ៣៖ ដំឡើង លោក ឃុន ហាំង ទីប្រឹក្សា រាជ រដ្ឋាភិបាល មាន ឋានៈ ស្មើ ឧប នាយក រដ្ឋមន្ត្រី ៕
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ៖ ឧប នាយក រដ្ឋមន្ត្រី ទៀ សីហា ដាស់តឿន មន្ត្រីរាជការ កម្លាំង សមត្ថកិច្ច កុំ ប្រព្រឹត្ត បទល្មើស គ្រឿងញៀន ផ្ទុយទៅវិញ ត្រូវ ខិតខំ អភិវឌ្ឍ មូលដ្ឋាន ឱ្យ បន្ត ការរីកចម្រើន
( កោះកុង ) ៖ លោក ទៀ សីហា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កោះកុង បាន ដាស់តឿន ដល់ មន្ត្រីរាជការ កងកម្លាំង សមត្ថកិច្ច អាជ្ញាធរ ពាក់ព័ន្ធ សូម កុំ ប្រព្រឹត្ត បទល្មើស គ្រឿងញៀន និង បទល្មើស ដទៃ ទៀត ឱ្យ សោះ ព្រោះ ត្រូវ ជាប់ ទោសទណ្ឌ តាម ច្បាប់ មិន អាច លើកលែង ឡើយ ផ្ទុយទៅវិញ គឺ ត្រូវ ខិតខំ អភិវឌ្ឍ មូលដ្ឋាន ឱ្យ បន្ត ការរីកចម្រើន ។
ការដាស់តឿន ណែនាំ នេះ ធ្វើឡើង ក្នុង ពិធី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ឆ្នាំ ២០២៤ របស់ រដ្ឋបាល ខេត្ត កោះកុង នា រសៀល ថ្ងៃទី ៣ ខែមករា ឆ្នាំ ២០២៣ ដោយ មាន ការទទួលស្វាគមន៍ ពី លោកស្រី មិថុនា ភូថង អភិបាល ខេត្ត កោះកុង ។
លោក ទៀ សីហា បាន ណែនាំ ដល់ អាជ្ញាធរ ខេត្ត ស្រុក រហូតដល់ ថ្នាក់ មូលដ្ឋាន ត្រូវ ខិតខំ អភិវឌ្ឍ មូលដ្ឋាន របស់ ខ្លួន ឱ្យ បន្ត ការរីកចម្រើន ដើម្បី ទាក់ទាញ ភ្លៀវ ទេសចរ ឱ្យ ចូលមក កម្សាន្ត បាន ច្រើន និង កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ បាន មួយ កម្រិត ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត ឱ្យ រដ្ឋបាល ខេត្ត ព្យាយាម ពង្រីក ទំនាក់ទំនង ជាមួយ ប្រទេស ជិតខាង ដើម្បី លើកស្ទួយ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ជួញដូរ ផលិតផល របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ការផ្លាស់ប្ដូរ ទស្សនកិច្ច វិស័យ ទេសចរណ៍ ផងដែរ ។
លោក បាន បន្ថែម ថា ដើម្បី លើកស្ទួយ ផ្នែក វិស័យ ទេសចរណ៍ ឱ្យ ភាព ទាក់ទាញ ក្រសួង បរិស្ថាន និង ក្រសួង ទេសចរណ៍ ត្រូវ រួមគ្នា រៀបចំ ហេដ្ឋ រចនាសម្ពន្ធ នៅ តាម ទីតាំង កម្សាន្ត ដូចជា រមណីយដ្ឋាន តំបន់ ឆ្នេរ ឱ្យ មាន អនាម័យ មាន សោភ័ណភាព ល្អ ស្រស់ស្រាយ និង មាន ការទទួលស្វាគមន៍ រាក់ទាក់ គោរព ប្រពៃណី ខ្មែរ ហើយ ពលរដ្ឋ មាន ការងារ ធ្វើ អាច រក ចំណូល បាន ដើម្បី ដោះស្រាយ ក្នុង ជីវភាព គ្រួសារ បាន មួយ កម្រិត ។
( កែប )៖ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស នៅ សាលា បឋមសិក្សា កំពុង ត្រឡាច ស្ថិត នៅ ក្រុង កែប ខេត្ត កែប បាន បង្ហាញ ក្ដីរីករាយ យ៉ាង អនេក នៅពេល អគារ សិក្សា និង ទី ចាត់ការ ថ្មី ក្នុង សាលា នេះ ត្រូវបាន បើក ការសាងសង់ ជា ផ្លូវការ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ បណ្ឌិត ។
ការបើក ការដ្ឋាន សាងសង់ អគារ នេះ ធ្វើឡើង នា ថ្ងៃទី ៣ ខែមករា ឆ្នាំ ២០២៤ ក្រោម វត្តមាន លោក សំ សារីន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កែប លោក សោម ពិសិដ្ឋ អភិបាល ខេត្ត កែប និង លោកស្រី ព្រមទាំង មន្ត្រីរាជការ កងកម្លាំង ដាវុធ អាជ្ញាធរ និង អ្នក ពាក់ព័ន្ធ ចូលរួម ។
លោក ខេង យ័ន អភិបាល ក្រុង កែប បាន ឲ្យដឹង ថា អគារ សិក្សា ដែល កំពុង សាងសង់ នេះ មាន ចំនួន ១ខ្នង និង អគារ ទី ចាត់ការសាលា១ ខ្នង ទៀត ដែល ជា អំណោយ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ស្ថិត នៅក្នុង បរិវេណ វត្ត កំពង់ត្រឡាច ក្នុង សង្កាត់ ព្រៃ ធំ ក្រុង កែប ខេត្ត កែប ។
លោក អភិបាល ខេត្ត ក៏ បាន ណែនាំ ដល់ លោក ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត កែប សូម ខិតខំ កៀរ គរ ធនធាន បន្ថែម លើ ការបំពាក់ ឧបករណ៍ និង សម្ភារ សិក្សា បន្ថែម ទៀត ដូចជា ការធ្វើ សួនច្បារ ការដាក់ ឱ្យ មាន សៀវភៅ អាន ដើម្បីឱ្យ សិស្សានុសិស្ស មាន ទម្លាប់ ក្នុង ការអាន សៀវភៅ សម្រាប់ ជា ជំនួយ ដល់ ការសិក្សា រៀនសូត្រ របស់ សិស្ស ៕ រដ្ឋមន្ដ្រី សុខាភិបាល ណែនាំ ឱ្យ ឱសថការី បំពេញ តួនាទី ឱ្យ ស័ក្ដិសម និង ប្រកបដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ
( ភ្នំពេញ ) ៖ ថ្លែង ក្នុង ឱកាស ចុះ ទស្សនកិច្ច និង សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ មន្ដ្រីរាជការ បុគ្គលិក នៃ មជ្ឈមណ្ឌល ជាតិ ពិសោធន៍ ពិសោធន៍ សុខាភិបាល នៅ ថ្ងៃទី ៣ ខែមករា ឆ្នាំ ២០២៤ លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន គូស រំលេច ថា ឱសថការី មាន តួនាទី ធំ វិសាលភាព ទូលាយ ក្នុង ការកំណត់ សុខភាព ឱ្យ ប្រជាពលរដ្ឋ ។
លោក សាស្ដ្រាចារ្យ បាន បន្ដ ថា បើ និយាយ ពី បម្រើ ការងារ នៅ នាយកដ្ឋាន ឱសថ គឺ គ្របដណ្ដប់ ទៅ លើ សុខភាព ទាំងអស់ អីចឹង ការអនុវត្ដន៍ ត្រូវ ក៏ បាន មក នូវ សុខភាព ល្អ ផ្ទុយទៅវិញ បើ មិន ល្អ គឺ ត្រូវ ប្រតិកម្ម ដល់ សុខភាព ឧទាហរណ៍ ដូច នៅ មន្ទីរពិសោធន៍ នេះ ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា « ឱសថការី ជា ការងារ មួយ ផ្នែក ធំ ដែល ជះឥទ្ធ ពល ដល់ សុខភាព សូម ស្នើ ដល់ ថ្នាក់ដឹកនាំ ទាំងអស់ ដែល មើល ការខុសត្រូវ លើ ជំនាញ នេះ ត្រូវ សង្កត់ធ្ងន់ ទាំង លើ ការបណ្ដុះបណ្ដាល និស្សិត និង ក្រមសីលធម៌ វិជ្ជាជីវៈ ឱសថការី នេះ ដើម្បីឱ្យ និស្សិត របស់ យើង និង ឱសថការី ដែល ចេញមក បំពេញ ភារកិច្ច នេះ មាន ជំហរ និង វិជ្ជាជីវៈ ខ្ពស់ » ។
លោក សាស្ដ្រាចារ្យ បាន បន្ថែម ថា « ការលក់ ឱសថ តាម ឱសថស្ថាន ការត្រួតពិនិត្យ ឱសថ ការចេញ បញ្ជិ កាឱសថ ចំណីអាហារ អាហារ បំប៉ន - ល - គឺ សុទ្ធតែ ពាក់ព័ន្ធ នឹង ឱសថការី ដូច្នេះ សូម ឱ្យ ឱសថការី ត្រូវ ឱ្យដឹង ថា តួនាទី យើង និង បំពេញ តួ ឱ្យ បាន ប្រសើរ ក្នុង មោទនភាព កិត្ដិយ ស កុំ ឱ្យ ឆ្គាំឆ្គង ឱ្យ សោះ ឱ្យ ស័ក្ដ័ សម នឹង តួនាទី ប្រកបដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ ជាពិសេស ឱស ការី នៃ មជ្ឈមណ្ឌល ជាតិ ពិសោធន៍ សុខាភិបាល » ។
មជ្ឈមណ្ឌល ជាតិ ពិសោធន៍ សុខាភិបាល សឹងតែ ដើរ តួនាទី ដូច មន្ដ្រី យុត្ដិធម៌ ដូច្នេះ ដែរ ព្រោះ ជា ទីតាំង បញ្ជាក់ ពី ភាពត្រឹមត្រូវ ឬ មិន ត្រឹមត្រូវ របស់ ផលិតផល ឱសថ ឬ ថ្នាំ ផ្សេង ៗ ដូច្នេះ ត្រូវ អនុវត្ដន៍ ការងារ ដោយ ភាពឯករាជ្យ ស្មោះត្រង់ ត្រឹមត្រូវ ប្រកបដោយ ដោយ ទទួលខុសត្រូវ ខ្ពស់ ដោយ មិន ត្រូវ ទទួល សម្ពាធ ពី ខាង ណា នោះ ឡើយ ព្រោះថា ផលិត ទាំងអស់ គឺ គ្របដណ្ដប់ លើ សុខភាព របស់ ប្រជាជន យើង ។
ទន្ទឹម នឹង នោះ លោក រដ្ឋមន្ដ្រី ក៏ បាន ផ្ដល់ អនុសាសន៍ គន្លឹះ ដើម្បី ជំរុញ ល្បឿន នៃ ការងារ កាន់តែ លឿន និង ពង្រីក វិសាលភាព ឱ្យ កាន់តែ ទូលំទូលាយ បន្ថែម ទៀត ៕
( សៀមរាប ) ៖ ក្រុម ចោរ ដែល តែង ធ្វើ សកម្មភាព ប្លន់ តាម ភូមិសាស្ដ្រ រាជធានី - ខេត្ត យ៉ាង សកម្ម នា ពេល កន្លងមក ត្រូវបាន កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ដឹកនាំ សហការស្រាវជ្រាវ បង្ក្រាប បាន ២នាក់ ក្នុង ចំណោម បក្ខពួក ៣នាក់ នៅ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២៣ នៅ ខេត្ត សៀមរាប ។
របាយការណ៍ របស់ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា ក្រុម ជនសង្ស័យ បាន ធ្វើ សកម្មភាព ចុងក្រោយ កាលពី ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២៣ វេលា ម៉ោង ២១៖ ១៥នាទី នៅ ចំណុច ផ្ទះ របស់ ជនរងគ្រោះ ឈ្មោះ ឡិក វិច្ឆិកា ភេទ ស្រី អាយុ ៣៣ ឆ្នាំ មុខរបរ លក់ដូរ ស្ថិត នៅ ភូមិ ត្រពាំង ខ្ទះ ( អូរ ប្រាំ ព្យាម ) ឃុំ ស្វាយលើ ស្រុក ស្វាយលើ ខេត្ត សៀមរាប បង្កឡើង ដោយ ជនសង្ស័យ ចំនួន ៣នាក់ បាន ធ្វើ សកម្មភាព ប្រើប្រាស់ កាំបិត ភ្ជង់ ប្លន់ ។
ក្រោយពី មាន ហេតុការកើតឡើង ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន កម្លាំង ជំនាញ របស់ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ហ៊ុន មុន្នីរ័ត្ន និង លោក វរសេនីយ៍ ឯក ហែម បូណា អនុប្រធាន នាយកដ្ឋាន ដឹកនាំ សហការ ជាមួយ ស្នងការដ្ឋាន នគរបាល ខេត្ត សៀមរាប ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះវិហារ បាន ស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ បំផុត ឈានដល់ កំណត់ បាន អត្តសញ្ញាណ មុខ សញ្ញ ប្រព្រឹត្ត ខាងលើ និង ទីតាំង លាក់ របស់ ជនសង្ស័យ ។
លុះ ដល់ ថ្ងៃទី ០៣ ខែមករា ឆ្នាំ ២០២៤ កម្លាំង ជំនាញ បាន បន្ត ដឹកនាំ សហការធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ២នាក់ មាន ឈ្នោះ ដូច ខាងក្រោម៖
* ទី១៖ ឈ្មោះ រ៉ង សារ៉ាត់ ភេទ ប្រុស អាយុ ៣៣ ឆ្នាំ ជនជាតិ ខ្មែរ ឃាត់ខ្លួន បាន នៅ ចំណុច ភូមិ ថ្នល ដាច់ ឃុំ ដាន រុណ ស្រុក សូនិគម ខេត្ត សៀមរាប * ទី ២៖ ឈ្មោះ ឈិន ភន ភេទ ប្រុស អាយុ ៣៨ ឆ្នាំ ជនជាតិ ខ្មែរ ឃាត់ខ្លួន បាន នៅ ចំណុច ភូមិ ស្នា ផ្អែក ឃុំ ស្រយ៉ង ស្រុក គូលេន ខេត្ត សៀមរាប និង ដកហូត បាន វត្ថុតាង ដែល យក មក ធ្វេី សកម្មភាព ប្រព្រឹត្ត បទល្មេីស បាន មួយចំនួន ។
ក្រោយពី សាកសួរ ជនសង្ស័យ ទាំង ពីរ បាន សារភាព ដូចគ្នា ថា កាលពី ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២៣ ពួកគេ ដែល មាន បក្ខ ចំនួន ៣នាក់ ពិតជា បាន ធ្វើ សកម្មភាព ចូល ផ្ទះ ប្រជាពលរដ្ឋ និង ប្រដាប់ ដោយ កាំបិត ( ដែល បាន ដកហូត ) ភ្ជង់ ប្លន់ យក ទ្រព្យសម្បត្តិ ប្រជាពលរដ្ឋ នៅ ភូមិ ត្រពាំង ខ្ទះ ( អូរ ប្រាំ ព្យាម ) ឃុំ ស្វាយលើ ស្រុក ស្វាយលើ ខេត្ត សៀមរាប ប្រាកដ មែន ។
បច្ចុប្បន្ន ជនសង្ស័យ ខាងលើ ត្រូវបាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ប្រគល់ឲ្យ ទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត សៀមរាប បន្ត អនុវត្ត នីតិវិធី និង ស្វែងរក ចាប់ខ្លួន មុខ សញ្ញា សង្ស័យ ឈ្មោះ ឈិន ភណ្ឌ ដែល រត់គេចខ្លួន ៕
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៣ ខែមករា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ៧នាក់ ។
ការបំផ្ទុះ គ្រាប់បែក ដែល ទូរទស្សន៍ រដ្ឋ បាន ពិពណ៌នា ថា ជា « ការវាយប្រហារ ភេរវកម្ម » បាន កើតឡើង នៅ ពេល ដែល ភាពតានតឹង បាន កើនឡើង នៅ មជ្ឈិមបូព៌ា មួយ ថ្ងៃ បន្ទាប់ពី មេបញ្ជាការ ទី២ របស់ ហាម៉ាស លោក Saleh al-Arouri ដែល ជា សម្ព័ន្ធមិត្ត របស់ អ៊ីរ៉ង់ ត្រូវបាន សម្លាប់ នៅក្នុង ការវាយប្រហារ ដោយ យន្តហោះ គ្មាន មនុស្ស បើក នៅក្នុង ទីក្រុង បេរូត ប្រទេស លី បង់ ។
អាជ្ញាធរ បាន គូសបញ្ជាក់ ថា ការបំផ្ទុះ នេះ បាន កើតឡើង នៅ ស្រុក កំណើត របស់ លោក ឧត្តមសេនីយ៍ Soleimani នៅ ភាគ ខាងត្បូង នៃ ប្រទេស អី រ៉ង់ ខណៈ ដែល អ្នកគាំទ្រ របស់ លោក បាន ប្រមូលផ្តុំ គ្នា ដើម្បី រំលឹក ខួប លើក ទី ៤ នៃ ការស្លាប់ របស់ គាត់ នៅក្នុង ការវាយប្រហារ ដោយ យន្តហោះ គ្មាន មនុស្ស បើក របស់ អាមេរិក នៅ ខាងក្រៅ អាកាសយានដ្ឋាន បាកដាដ នៃ ប្រទេស អ៊ីរ៉ាក់ ។
ប្រព័ន្ធ ផ្សព្វផ្សាយ ផ្លូវការ បាន និយាយ ថា មនុស្ស យ៉ាងហោចណាស់ ១៧០ នាក់ ក៏ បាន រងរបួស ក្នុង ការបំផ្ទុះ គ្រាប់បែក នេះ ដែរ ។
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ យប់ ថ្ងៃពុធ ទី៣ ខែមករា ឆ្នាំ ២០២៤ បាន ចេញ ស្តី ជូនដំណឹង ដោយ បញ្ជាក់ ថា កម្ពុជា នៅ មិន ទាន់ មាន កិច្ចព្រមព្រៀង ស្តីពី ការបញ្ជូន ពលករ ពី កម្ពុជា ទៅ ធ្វើការ នៅ ប្រទេស អ៊ីស្រាអែល នោះ ទេ ។ ជា ការចេញ សេចក្តីជូនដំណឹង ក្រោយ មាន ការជ្រើសរើស ពលករ ទៅកាន់ ប្រទេស អ៊ីស្រាអែល ដោយ ខុស ច្បាប់ លើ បណ្តាញ តេឡេក្រាម ។
សេចក្តីជូនដំណឹង របស់ ក្រសួង គូសបញ្ជាក់ ថា៖ « ដើម្បី បង្ការ នូវ ការ ឆបោក របស់ ជន ខិលខូច ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ មាន កិត្តិយស សូម ជម្រាប ជូនដំណឹង ដល់ សាធារណជន ឱ្យ បាន ជ្រាប ថា កម្ពុជា នៅ មិន ទាន់ មាន កិច្ចព្រមព្រៀង ស្ពី ពី ការបញ្ជូន ពលករ ពី កម្ពុជា ទៅ ធ្វើការ នៅ ប្រទេស អ៊ីស្រាអែល នោះ ទេ ដោយ បច្ចុប្បន្ន ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ កំពុង ធ្វើការ ជាមួយ ភាគី អ៊ីស្រាអែល ដើម្បី ពិភាក្សា លើ សេចក្តីព្រាង អនុស្សរណៈ យោគយល់ គ្នា ស្តីពី ការជ្រើសរើស និង ការបញ្ជូន ពលករ » ។
បើ តាម លិខិត ដដែល ក្រសួង បាន ប្រកាស ចាត់ វិធានការ ផ្លូវ ច្បាប់ ក្នុង ករណី ដែល ពលរដ្ឋ បាន ឃើញ ឬ មាន ការផ្សព្វផ្សាយ ជ្រើសរើស ពលករ ទៅ បម្រើ ការងារ នៅ ប្រទេស អ៊ីស្រាអែល ក្នុង រូបភាព ណា ក៏ដោយ ។
សម្រាប់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ការជ្រើសរើស និង ការបញ្ជូន ពលករ ទៅ ធ្វើការ នៅ បរទេស ដោយ ខុស ច្បាប់ គឺជា បទល្មើស ជួញដូរ មនុស្ស ។
យ៉ាងណា ក៏ដោយ ក្រសួង ការងារ នឹង ប្រកាស ជូនដំណឹង ដល់ សាធារណជន ក្នុង ករណី មាន កិច្ចព្រមព្រៀង បញ្ជូន ពលករ ទៅ ធ្វើការ នៅ ប្រទេស អ៊ីស្រាអែល ជា ផ្លូវការ នា ពេល ខាងមុខ ៕ អតីត សមាជិក គណៈកម្មាធិការ នាយក នៃ អតីត គណបក្ស សង្គ្រោះ ជាតិ ស្នើ សូម ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជនជា ជន កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ឡុង គឹម ឃន អតីត សមាជិក គណៈកម្មាធិការ នាយក នៃ អតីត គណបក្ស សង្គ្រោះ ជាតិ បាន ផ្ញើ លិខិត គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ស្នើ សូម ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជនជា ជន កម្ពុជា ។
សេចក្ដី ដូច បាន គោរព ជម្រាប ជូន ខាងលើ ខ្ញុំបាទ សូម សម្ដេច តេជោ ហ៊ុន សែន មេត្តា ពិនិត្យ និង សម្រេច អនុញ្ញាត ដល់ រូប ខ្ញុំបាទ បាន ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ខ្ញុំបាទ មាន ឱកាស បាន ចូលរួមចំនែក ក្នុង ការបម្រើ ជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា បន្ត ទៅ មុខ ទៀត ៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង កសិកម្ម ចុះ ស្ទាបស្ទង់ និង ស្តាប់ ពី សំណូមពរ ក៏ ដូចជា បញ្ហា ប្រឈម យកមក ពិភាក្សា គ្នា លើ កិច្ចការងារ ប្រើប្រាស់ ឧបករណ៍ នេសាទ
( ពោធិ៍សាត់ )៖ លោក ហាស់ សារ៉េត រដ្ឋលេខាធិការ តំណាង លោក ឌិត ទីណា រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ០២ ខែមករា ឆ្នាំ ២០២៤ បាន ចុះ ជួប សំណេះសំណាល ជាមួយ ប្រជា នេសាទ ក្នុង ភូមិ កំពង់ លួង ឃុំ កំពង់ លួង ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ក្នុង គោលបំណង ស្ទាបស្ទង់ និង ស្តាប់ ពី សំណូមពរ ក៏ ដូចជា បញ្ហា ប្រឈម យកមក ពិភាក្សា គ្នា លើ កិច្ចការងារ ប្រើប្រាស់ ឧបករណ៍ នេសាទ ស្រប តាម ច្បាប់ អនុញ្ញាត ដើម្បី មច្ឆា ជាតិ បាន គង់វង្ស ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅលើ ផែ ក្នុង ឃុំ កំពង់ លួង ដោយ បាន ការចូលរួម ពី លោក ឃឹម ហ្វីណង់ អនុ រដ្ឋលេខាធិការ លោក លោកស្រី ជា ប្រតិភូ អម ដំណើរ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ លោក អភិបាល រង ខេត្ត អាជ្ញាធរ ស្រុក ឃុំ មន្ត្រី ពាក់ព័ន្ធ និង ប្រជា នេសាទ ដែល ប្រកបរបរ ក្នុង ដែន នេសាទ បឹង ទន្លេ សាប ប្រមាណ ១៥៦ នាក់ ។
បន្ទាប់ពី មាន ការសំណូមពរ ពី ប្រជានេសាទ ក៏ ដូចជា ការលើកឡើង ឆ្លើយតប ពន្យល់ យ៉ាង ក្បោះក្បាយ ពី សំណាស់ មន្ត្រី ជំនាញ នោះ រួច មក . លោក ហាស់ សារ៉េត រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន លើកឡើង ថា ក្រសួង កសិកម្ម ចង់ឲ្យ ជីវភាព អ្នកនេសាទ យើង បាន ប្រសើរឡើង និង ធនធាន ធម្មជាតិ បាន គង់វង្ស និង សម្បូរ ឡើងវិញ ។
ចំពោះ សំណូមពរ របស់ ប្រជានេសាទ ទាំង ប៉ុន្មាន ចំណុច លោក នឹង យក ទៅ ពិភាក្សា គ្នា ជាមួយ ថ្នាក់ ដឹង នាំ ក្រសួង ដើម្បី រួមគ្នា ឯកភាព សម្រេច ជា ក្រោយ លើ កិច្ចការងារ ការប្រើប្រាស់ ឧបករណ៍ នេសាទ ឲ្យ ស្រប តាម ច្បាប់ និង មាន ប្រសិទ្ធភាព ។
បន្ថែម លើស ពី នេះ ទៅ ទៀត លោក សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច បវរធិបតី ហ៊ុន ម៉ាណែត និង ដោយ មាន លោក ឌិត ទីណា រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ជា សេនាធិការ នោះ សូម គាំទ្រ និង ចូលរួម ថែរក្សា ការពារ និង អភិរក្ស ធនធាន ជល ផល ទាំងអស់ ដើម្បី ជា ប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ទូទាំង ផ្ទៃ ប្រទេស ក៏ ដូចជា ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ធ្វើ នេសាទ សម្រាប់ ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ ។
បន្ទាប់ពី សំណេះណា ល និង ពន្យល់ ពី របៀប ប្រើ ឧបករណ៍ នេសាទ រួច ក្រុមការងារ ក៏ បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ដ៏ ថ្លៃថ្លា របស់ លោក រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម មក ចែកជូន ដល់ កងកម្លាំង ចម្រុះ ថ្នាក់ ជាតិ ដែល កំពុង ឈរជើង នៅលើ ផ្ទៃ ទឹក បឹង ទន្លេ សាប ផងដែរ ៕
ជនជាតិ ចិន មួយ ក្រុម មិន ដឹង មាន គំនុំ អ្វី យក កាំបិត ចាក់ បុរស ជនជាតិ ចិន ម្នាក់ ជាច្រើន កាំបិត បណ្ដាលឲ្យ ស្លាប់ នៅក្នុង អគារ ខុនដូ មួយ កន្លែង ក្នុង ខណ្ឌ សែនសុខ
( ភ្នំពេញ ) ៖ ជនជាតិ ចិន មួយ ក្រុម មិន ដឹង មាន គំនុំ អ្វី បាន យក កាំបិត ចាក់ បុរស ជនជាតិ ចិន ម្នាក់ ជាច្រើន កាំបិត បណ្ដាលឲ្យ ស្លាប់ នៅក្នុង អគារ ខុនដូ មួយ កន្លែង រួច ជនសង្ស័យ រត់គេចខ្លួន បាត់ បាន បង្កឲ្យ ភ្ញាក់ផ្អើល ដល់ សមត្ថកិច្ច ចុះ ឡោមព័ទ្ធ ឃាត់ ជនសង្ស័យ ពាក់ព័ន្ធ និង ទាក់ទង កម្លាំង ជំនាញ កោសល្យវិច្ច័យ ចុះ មក ត្រួតពិនិត្យ ។
ហេតុការណ៍ នេះ ស្ថិត តាម បណ្ដោយ ផ្លូវ សហព័ន្ធ រុស្ស៊ី សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ វេលា ម៉ោង ១២៖ ៤០ នាទី រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២៤ ។
ក្រោយពេល កើត ហេតុ សមត្ថកិច្ច បាន ឃាត់ មនុស្ស ប្រុស ស្រី ចំនួន ៣៧នាក់ ស្រី ចំនួន ៧នាក់ ព្រមទាំង ដកហូត គ្រឿងញៀន កាំភ្លើង និង កាំបិត រួច នាំទៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ សែនសុខ ដើម្បី ធ្វើ ការសាកសួរ និង បន្ត តាម នីតិវិធី ច្បាប់ ៕
លោក មាស ប៊ុន ឡី ត្រូវបាន តែងតាំង ជា ទីប្រឹក្សា សម្តេច តេជោ ហ៊ុន សែន
( ភ្នំពេញ ) ៖ លោក មាស ប៊ុន ឡី ត្រូវបាន តែងតាំង ជា ទីប្រឹក្សា សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ លោក មាស ប៊ុន ឡី មាន តួនាទី ជា អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន សម្ភារៈ បច្ចេកទេស ក្រសួង ការពារ ជាតិ ៕
ក្រុមហ៊ុន Alrosa ដែល គ្រប់គ្រង ដោយ រដ្ឋ រុស្ស៊ី រ៉ាប់រង ប្រមាណ ច្រើន ជាង ៩០ ភាគរយ នៃ ផលិតកម្ម ពេជ្រ របស់ រុស្ស៊ី បាន ផ្តល់ឱ្យ វិមាន ក្រឹមឡាំង នូវ ប្រភព ចំណូល ដ៏ មាន តម្លៃ ។
សហភាព អឺរ៉ុប បាន និយាយ នៅ ថ្ងៃពុធ នេះ ថា Alrosa និង នាយក ប្រតិបត្តិ របស់ ក្រុមហ៊ុន នេះ ត្រូវបាន បញ្ចូល ទៅក្នុង បញ្ជី នៃ បុគ្គល និង អង្គភាព ដែល ត្រូវបាន ដាក់ទណ្ឌកម្ម សម្រាប់ « អំពើ ដែល បំផ្លាញ ឬ គំរាមកំហែង ដល់ បូរណភាព ទឹកដី អធិបតេយ្យភាព និង ឯករាជ្យភាព របស់ អ៊ុយក្រែន » ។ របាយការណ៍ បាន បន្ថែម ថា « ក្រុមហ៊ុន គឺជា ផ្នែក មួយ ដ៏ សំខាន់ នៃ សេដ្ឋកិច្ច និង ផ្តល់ ប្រាក់ ចំណូល យ៉ាង ច្រើន ដល់ រដ្ឋាភិបាល រុស្ស៊ី » ។
គួរ បញ្ជាក់ ថា ចាប់តាំងពី រុស្ស៊ី បាន បញ្ជូន ទាហាន ទៅ អ៊ុយក្រែន ក្នុង ខែកុម្ភៈ ឆ្នាំ ២០២២ មក មាន ក្រុមហ៊ុន និង បុគ្គល រុស្ស៉ី ប្រមាណ ជា ១. ៩៥០ ហើយ ត្រូវបាន រង ការដាក់ទណ្ឌកម្ម របស់ សហភាព អឺរ៉ុប ៕ រូបភាព ពី Reuters ប្រេង ឆៅ ជួញដូរ ក្នុង តម្លៃ ជិត ៧៦ ដុល្លារ ក្នុង គ្រា មាន ក្ដីបារម្ភ ពី សេដ្ឋកិច្ច និង ជម្លោះ នៅ សមុទ្រ ក្រហម
( សិង្ហបុរី ) ៖ តម្លៃ ប្រេង មាន ស្ថិរភាព ក្នុង ជួញដូរ នៅ ទីផ្សារ អាស៊ី នៅ ព្រឹក ថ្ងៃពុធ បន្ទាប់ពី ប្រែប្រួល តម្លៃ ខ្លាំង នៅ ដើម សប្តាហ៍ នេះ ខណៈ ដែល ទីផ្សារ បាន ថ្លឹងថ្លែង ពី ការព្រួយបារម្ភ អំពី សេដ្ឋកិច្ច អាមេរិក និង ការរំខាន ដល់ ការផ្គត់ផ្គង់ ដែល បង្កឡើង ដោយ ភាពតានតឹង ដែល កំពុង បន្ត នៅក្នុង សមុទ្រ ក្រហម ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ។
តម្លៃ ប្រេង ឆៅ បាន កើនឡើង ប្រហែល ២ដុល្លារ អាមេរិក នៅ ដើម សប្តាហ៍ នេះ បន្ទាប់ពី មាន ការវាយប្រហារ លើ នាវា នៅ សមុទ្រ ក្រហម ដោយ ក្រុម ឧទ្ទាម ហូទី (Houthi) កាលពី ចុង សប្តាហ៍ មុន និង ការមកដល់ នៃ នាវា ចម្បាំង របស់ ប្រទេស អ៊ីរ៉ង់ កាលពី ថ្ងៃចន្ទ ។ ជម្លោះ កាន់តែ រីក ធំ ឡើង អាច បិទ សមុទ្រ ក្រហម ដែល ជា ផ្លូវ ទឹក ដ៏ សំខាន់ សម្រាប់ ការដឹកជញ្ជូន ប្រេង និង រំខាន ដល់ លំហូរ ពាណិជ្ជកម្ម នេះ ។
