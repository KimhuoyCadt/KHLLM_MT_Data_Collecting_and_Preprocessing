( កៀវ ) ៖ ជម្លោះ នៅ អ៊ុយក្រែន ជិត នឹង ឈានចូល ខួប នៃ ឆ្នាំ ទី៣ហើយ ខណៈ រណសិរ្ស ជួរ មុខ បាន ផ្លាស់ប្តូរ ទិដ្ឋភាព របស់ ខ្លួន ជាច្រើន នា ប៉ុន្មាន ខែ ចុងក្រោយ នេះ ។
* សង្គ្រាម នឹង បន្ត អូសបន្លាយ និង មិន ទាន់ កំណត់ ពេលវេលា បញ្ចប់ ពេល ណាមួយ ឡើយ
ចំនួន ពលរដ្ឋ រុស្ស៊ី ដែល អ៊ុយក្រែន បាន វាយប្រហារ ដាក់ លើ ក្រុង Belgorod ជាប់ ព្រំដែន អ៊ុយក្រែន កាលពី ចុង ខែធ្នូ មាន អ្នកស្លាប់ កើនឡើង ដល់ ២៥ នាក់ ហើយ នៅក្នុង ការវាយឆ្មក់ លើក ដំបូង របស់ អ៊ុយក្រែន ដាក់ លើ ទឹកដី រុស្ស៊ី នេះ ។
លោក វីរសេនីយ៍ ត្រី គង់ សារ៉ុម បាន ឱ្យដឹង ថា អង្គភាព បាន ខិតខំ បន្ត ការងារ បង្កបង្កើន ផល និង ចិញ្ចឹម សត្វ ដែល ជា ការច្នៃប្រឌិត ការធានា ចិញ្ចឹម កងទ័ព និង គ្រួសារ កងទ័ព ដែល មាន ជីវភាព ខ្វះខាត ហើយ បន្ត ដាក់ លក់ នៅ លេី ទីផ្សារ ពិសេស ចូលរួម លក់ ក្នុង ទីផ្សារ សហគមន៍ នៅ ទី រួម ខេត្ត បន្ទាយមានជ័យ តាម ផែនការ របស់ ឧត្តមសេនីយ៍ ត្រី សឹង្ហ ទុំ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ ។
( ស្វាយរៀង ) ៖ ដោយ ប្រទេសជាតិ មាន សុខ សន្តិភាព ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ធ្វើឲ្យ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ចូលមក លេង កម្សាន្ត តាម គោលដៅ សំខាន់ ៗ ទូទាំង ប្រទេស កម្ពុជា ។ សម្រាប់ ខេត្ត ស្វាយរៀង រយៈពេល ៣ ថ្ងៃ ឆ្លង ឆ្នាំ សកល មាន ភ្ញៀវ ទេសចរ និង បងប្អូន ប្រជាពលរដ្ឋ មក លេង កម្សាន្ត ជិត ១៧ម៉ឺន នាក់ ។
លោក វ៉ាន់ សារ៉ាត ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង នៅ ថ្ងៃទី២ ខែមករា ឆ្នាំ ២០២៤ នេះ ថា រយៈពេល ៣ ថ្ងៃ ចំនួន ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ មក លេង កម្សាន្ត តាម គោលដៅ សំខាន់ ៗ ក្នុង ខេត្ត មាន ចំនួន សរុប ប្រមាណ ១៦៧.៥០០ នាក់ ក្នុង នោះ ភ្ញៀវ ទេសចរ បរទេស ចំនួន ៣១០ នាក់ ។
លោក បន្ត ថា ដោយ ក្នុង ខេត្ត ស្វាយរៀង មាន ព្រឹត្តិការណ៍ ធំ ៗ ដូច ជា៖ កម្មវិធី ប្រគុំតន្ត្រី ខ្នាត ធំ និង កម្មវិធី ប្រដាល់ គុណ ខ្មែរ ( រយៈពេល ២ ថ្ងៃ គឺ ៣០ - ៣១ធ្នូ ) ឆ្នាំ ២០២៣ ។ ចូល ឆ្នាំ កល នៅ ខេត្ត ស្វាយរៀង គឺ ភ្ញៀវ ទេសចរ ក៏ ដូចជា ប្រជាពលរដ្ឋ បាន ចូលរួម ទស្សនា កម្សាន្ត តាម គោលដៅ សំខាន់ ៗ ដែល រៀបចំ ដោយ រដ្ឋបាល ខេត្ត ជា អាទិ៍ កន្លែង តាំងពិព័រណ៌ កន្លែង ប្រគុំតន្ត្រី ខា្នត ធំ និង មាត់ ច្រាំង ទន្លេ វ៉ៃ គោ ពេល រាត្រី យ៉ាង ច្រើន កុះករ ផងដែរ ៕
ពលរដ្ឋ មាន ជីវភាព ខ្វះខាត ៥០០ គ្រួសារ នៅក្នុង សង្កាត់ អូរ ជ្រៅ ទទួលបាន អំណោយ ពី អភិបាល ក្រុង ប៉ោយប៉ែត
( បន្ទាយមានជ័យ )៖ លោក គាត ហ៊ុល អភិបាល ក្រុង ប៉ោយប៉ែត នា ព្រឹក ថ្ងៃទី ០២ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ រួមទាំង គណៈ គ្រប់គ្រង ក្រុមហ៊ុន កាស៊ីណូ ហ្គ្រែន ដាយ អឹម៉ិន ស៊ីធី និង ប៉ោយប៉ែត រី សត និង ក្រុម យុវជន ស្រឡាញ់ សន្តិភាព ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ចែក គ្រឿង ឧបភោគ បរិភោគ ដល់ ប្រជាពលរដ្ឋ ៥០០ គ្រួសារ នៅ កាស៊ីណូ ហ្គ្រែន ដាយ អឹម៉ិន ស៊ីធី ក្នុង សង្កាត់ អូរ ជ្រៅ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
( ភ្នំពេញ ) ៖ នៅសល់ ពេល ៤ ថ្ងៃ ទៀត ប៉ុណ្ណោះ នឹង ផុត កំណត់ នៃ ការចុះឈ្មោះ ដាក់ពាក្យ ប្រឡង យក អាហារូបករណ៍ ទេពកោសល្យ ឌីជីថល តេជោ ថ្នាក់ បរិញ្ញាបត្រ ចំនួន ៣០០ កន្លែង សម្រាប់ ឆ្នាំ ២០២៤ ហើយ ។
FATF ដែល ជា អង្គការ អន្តរជាតិ មួយ ធ្វើ ការងារ ប្រយុទ្ធ ប្រឆាំង នឹង សកម្មភាព លាង លុយក ខ្វក់ និង សកម្មភាព ហិរញ្ញប្បទាន ភេរវកម្ម បាន បញ្ចូល ហ្វីលីពីន ទៅក្នុង បញ្ជី ឈ្មោះ កាលពី ខែមិថុនា ឆ្នាំ ២០២១ ក្រោម ហេតុផល មួយចំនួន រួម មាន ទាំង ហានិភ័យ នៃ ការលាង លុយ ពី អាជីវកម្ម កាស៉ី ណូ និង កង្វះខាត ការកាត់ទោស បទល្មើស ផ្តល់ មូលនិធិ ភេរវកម្ម ។
គួរ បញ្ជាក់ ថា នៅពេល ចូលក្នុង បញ្ជីខ្មៅ FATF នឹង តម្រូវឲ្យ មាន លក្ខខណ្ឌ រឹង តែ តឹងរ៉ឹង និង ថ្លៃ ប្រតិបត្តិការ ហិរញ្ញវត្ថុ ការ ខ្ពស់ ខ្លាំង សម្រាប់ ប្រជាជន ហ្វីលីពីន រាប់ លាន នាក់ ដែល កំពុង រស់ នៅ និង ធ្វើការ នៅ បរទេស ក្នុង ការផ្ញើរ ប្រាក់ មកកាន់ ស្រុក កំណើត ៕ រូបភាព ពី Reuters លោក ឆាយ ឫទ្ធិ សែន ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ និង ពង្រឹង គុណភាព ហេដ្ឋារចនាសម្ពន្ធ និង សំណង់ សិល្បការ្យ ជន បទ
( ភ្នំពេញ ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នា ព្រឹក ថ្ងៃទី ២ ខែមករា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ និង ពង្រឹង គុណភាព ហេដ្ឋារចនាសម្ពន្ធ និង សំណង់ សិល្បការ្យ ជនបទ ដោយ មាន ការចូលរួម ពីសំណាក់ រដ្ឋលេខាធិការ ប្រចាំ ការ រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ អគ្គ នាយក អគ្គ នាយក រង និង ថ្នាក់ដឹកនាំ នៃ នាយកដ្ឋាន ផ្លូវ លំ ជនបទ ។
លោក រដ្ឋមន្ដ្រី បាន ឱ្យដឹង ថា តាមរយៈ ការត្រួតពិនិត្យ និង សិក្សា នា ពេល កន្លងមក បង្ហាញ ថា មូលហេតុ ចម្បង ចំនួន ៤ ដែល បណ្ដាលឱ្យ ហេដ្ឋារចនាសម្ពន្ធ ផ្លូវ ជន បទ រង ការខូចខាត រួម មាន បញ្ហា គុណភាព បច្ចេកទេស ស្ថាបនា ផ្លូវ ការប្រែប្រួល អាកាសធាតុ ការដឹកជញ្ជូន លើស កម្រិត ទម្ងន់ កំណត់ និង លើក របៀបវារៈ នៃ នៃ ដំណោះស្រាយ លើ ការអនុវត្ត គម្រោង ជាមួយ ដៃគូ អភិវឌ្ឍន៍ ការទទួលខុសត្រូវ ត្រ្ទត ពិនិត្យ គុណភាព ផ្លូវ និង ការស្វែងរក បច្ចេកវិទ្យា ថ្មី ។
ជាមួយគ្នា នេះ ដើម្បី ធានា ដល់ ការស្ថាបនា ហេដ្ឋារចនាសម្ពន្ធ និង សំណង់ សិល្បការ្យ ជនបទ មាន គុណភាព សម្រាប់ បម្រើ ដល់ ការប្រើប្រាស់ របស់ ប្រជាពលរដ្ឋ មាន គុណភាព និង និរន្ដរភាព លោក រដ្ឋមន្ដ្រី បាន ផ្ដល់ អនុសាសន៍ ដូច ខាងក្រោម៖
* រៀបចំ សិក្ខាសាលា ពិគ្រោះយោបល់ ប្រមូល ធាតុ ចូល ដើម្បី សិក្សា ពី បច្ចេកវិទ្យា ថ្មី ៗ នៃ ការស្ថាបនា ផ្លូវ ជនបទ សម្រាប់ ជំនួស ឱ្យ វត្ថុធាតុ ដើម ក្នុង ស្រុក ដែល មិន អាច ឆ្លើយតប គ្រប់គ្រាន់ នា ពេល អនាគត ។
* រៀបចំ ផែនការ បុរេសកម្ម សម្រាប់ ការលើក គម្រោង ស្ថាបនា ហេដ្ឋារចនាសម្ពន្ធ ផ្លូវ ជនបទ ដោយ ត្រូវ យកចិត្តទុកដាក់ លើ ភាពធន់ នឹង ការប្រែប្រួល អាកាសធាតុ ។
* សិក្សា ស្ថានភាព ភូមិសាស្រ្ដ និង គំរូ ប្លង់ ត្រួតពិនិត្យ គ្រប់ ដំណាក់កាល នៃ ការសាងសង់ ត្រួតពិនិត្យ វត្ថុធាតុ ដើម ត្រួតពិនិត្យ គ្រឿងចក្រ សម្រាប់ ស្ថាបនា និង ការវាយតម្លៃ គុណភាព តាម សំណាក គំរូ ដែល យក ពី មន្ទីរពិសោធន៍ ត្រឹមត្រូវ ។
* ថ្នាក់ដឹកនាំ និង មន្រ្ដី អនុវត្ត គម្រោង ស្ថាបនា ផ្លូវ ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ និង ពិនិត្យ លើ វឌ្ឍនភាព នៃ ការអនុវត្ដ គម្រោង ឱ្យ បាន ទាន់ ពេលវេលា តាម កិច្ចសន្យា សាងសង់ ។
* មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ត្រូវ ពិនិត្យ និង បង្កើន កិច្ចសហប្រតិបត្តិការ ជាមួយ មន្ទីរ ជំនាញ ពាក់ព័ន្ធ លើ ការរៀបចំ ផែនការ មេអភិវឌ្ឍន៍ ផ្លូវ និង ផែនការ សកម្មភាព ប្រចាំ ឆ្នាំ ដើម្បី អនុវត្ត ការងារ មាន ប្រសិទ្ធភាព ខ្ពស់ នានា ។
* មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ត្រូវ លើក ផែនការថែទាំ ខួប លើ ខ្សែ ផ្លូវ ដែល គ្រោង ស្ថាបនា ដោយ ដៃគូ អភិវឌ្ឍន៍ មុនពេល គម្រោង ចាប់ផ្ដើម អនុវត្ត ៕ លោក វង សូត ជំរុញ ការយកចិត្តទុកដាក់ អភិវឌ្ឍ សមិទ្ធផល ផ្សេង ៗ ក្នុង សាលារៀន ដើម្បី វិនិយោគ លើ ធនធាន មនុស្ស ស្រប ពេល វិស័យ ពុទ្ធិចក្រ និង អាណាចក្រ មាន តួនាទី សំខាន់ ដូចគ្នា
( ត្បូងឃ្មុំ ) ៖ លោក វង សូត អនុប្រធាន ទី២ រដ្ឋសភា និង លោកស្រី ព្រមទាំង សម្តេច សង្ឃ មួង រ៉ា គណ: សង្ឃ នាយក រង ទី៣ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បុណ្យ លើក តម្កល់ រតនៈ វត្ថុ ចំនួន ៩អង្គ នៅលើ ប្រាសាទ ព្រះអង្គ ប្រសូត្រ ដែល មាន កំពស់ ២១ម៉ែត្រ ដែល ចំណាយ ថវិកា កសាង អស់ ប្រមាណ ៣៣ ម៉ឺន ដុល្លារ នៅ វត្ត សាមគ្គី សុខា រាម ហៅ វត្ត « ច្រក រំដេង » ស្ថិត នៅ ភូមិ ច្រក រំដេង ឃុំ ត្រពាំង ផ្លុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ២ ខែមករា ឆ្នាំ ២០២៤ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក វង សូត បាន ថ្លែងអំណរគុណ ថ្វាយ ប្រគេន ដល់ ព្រះគ្រូ ចៅអធិការ វត្ត រួម ជាមួយ ឧកញ៉ា លោក លោកស្រី អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ សប្បុរសជន ព្រមទាំង ពុទ្ធ បរិស័ទ្ធ ចំណុះ ជើង វត្ត មកពី ទីជិត ទី ឆ្ងាយ បាន រួម សាមគ្គី គ្នា កសាង សមិទ្ធិផល យ៉ាង ច្រើន នៅក្នុង វត្ត ច្រក រំដេង នេះ រួម មាន ៖ សាលា វិបស្សនា ធុរៈ បដិមា ព្រះពុទ្ធ មាតា បដិមា ព្រះពុទ្ធ ទ្រង់ ត្រាស់ ដឹង បដិមា ព្រះពុទ្ធ ទ្រង់ បរិនិព្វាន្ត និង សមិទ្ធផល ដទៃ ទៀត ជាច្រើន ។
អនុប្រធាន ទី២ រដ្ឋសភា ក៏ បាន ជំរុញ ឱ្យ ឯកឧត្តម លោកជំទាវ អាជ្ញាធរ គ្រប់ ជាន់ ថ្នាក់ បងប្អូន ពុទ្ធ បរិស័ទ្ទ រួមទាំង សប្បុរសជន ក្នុង និង ក្រៅ ប្រទេស ត្រូវ យកចិត្តទុកដាក់ លើក ការអភិវឌ្ឍ វិស័យ អប់រំ ពិសេស សាលារៀន នៅ តាម មូលដ្ឋាន និង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ក្នុង សាលារៀន ដើម្បី លើកកម្ពស់ ធនធាន មនុស្ស ដែល ជា កត្តា រួមចំណែក យ៉ាង សំខាក់ ក្នុង ការអភិវឌ្ឍ សង្គមជាតិ របស់ យើង ។
លោក បាន គូសបញ្ជាក់ ថា កន្លងទៅ វិស័យ ពុទ្ធ ចក្រ ដើរ តួនាទី សំខាន់ ក្នុង ការអភិវឌ្ឍ ធនធាន មនុស្ស ប៉ុន្តែ សព្វ ថ្ងៃ នេះ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ ហើយ រាជ រដ្ឋាភិបាល បាន កសាង សាលារៀន នៅ គ្រប់ មូលដ្ឋាន ទាំងអស់ នៅ ទូទាំង ប្រទេស ។ ទោះ យ៉ាងណា ក៏ដោយ យើង ត្រូវ យកចិត្តទុកដាក់ បន្ថែម ទៀត និង ចូលរួមចំណែក អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ក្នុង សាលារៀន ដើម្បី បំពេញ តម្រូវការ ឱ្យ បាន គ្រប់គ្រាន់ សំដៅ អភិវឌ្ឍ ធនធាន មនុស្ស និង សង្គមជាតិ របស់ យើង កាន់តែ ជឿនលឿន ថែម ទៀត ។
( បាត់ដំបង ) ៖ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង នៅ ថ្ងៃទី២ ខែមករា ឆ្នាំ ២០២៤ បាន រៀបចំ ជួប សំណេះសំណាល និង សួរសុខទុក្ខ ព្រមទាំង ផ្តល់ អំណោយ មនុស្សធម៌ ជូន អតីត យុទ្ធជន កម្ពុជា ក្រីក្រ ចំនួន ១០៤ គ្រួសារ ដែល កំពុង រស់ នៅ ភូមិ គោក រ កា ឃុំ ដូន បា ស្រុក គាស់ ក្រឡ ខេត្ត បាត់ដំបង ។
ពិធី នេះ បាន ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព លោក សុខ លូ អភិបាល ខេត្ត និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង ព្រមទាំង មាន ការចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ - មន្ត្រី ពាក់ព័ន្ធ និង សប្បុរសជន ជា ច្រេីន រូប ផងដែរ ។
ក្នុង នាម កាកបាទ ក្រហម កម្ពុជា . លោក សុខ លូ បាន សម្តែង នូវ ក្តី សោមនស្ស រីករាយ និង បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ចំពោះ បងប្អូន អតីត យុទ្ធជន ទាំងអស់ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ការពារ បូរណភាព ទឹកដី និង ពលី ជីវិត ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ ជាពិសេស ធ្វើឱ្យ ប្រទេសជាតិ ទទួលបាន សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ដូច សព្វ ថ្ងៃ នេះ ។
លោក បាន លើកឡើង ថា៖ « ប្រមុខ ថ្នាក់ដឹកនាំ និង ឥស្សរជនជាតិ សំខាន់ ៗ បាន ខិតខំ ដោយ លំបាក ក្នុង ការស្វែងរក សុខ សន្តិភាព និង កសាង ប្រទេស ឱ្យ មាន ការរីកចម្រើន ដូច សព្វ ថ្ងៃ នេះ ។ ដូច្នេះ កាកបាទ ក្រហម កម្ពុជា ក្នុង នាម ជា ជំនួយការ ឱ្យ អាជ្ញាធរ សាធារណៈ ក្នុង វិស័យ មនុស្សធម៌ ក៏ បាន ចូលរួមចំណែក គិតគូរ អំពី ការលំបាក និង លើកស្ទួយ ជីវភាព រស់ នៅ របស់ អតីត យុទ្ធជន ផងដែរ » ។
លោក សុខ លូ បាន សំណូមពរ ដល់ បងប្អូន អតីត យុទ្ធជន ទាំងអស់ ពេល ទទួលបាន ដី សម្បទាន និង ផ្ទះ នេះ ហើយ សូម ប្រើប្រាស់ ឱ្យ បាន សមស្រប ក្នុង ការបង្កបង្កើន ផល សម្រាប់ លើកស្ទួយ ជីវភាព គ្រួសារ និង ចេះ ថែរក្សា ផ្ទះសម្បែង ជា កេរមរត ដ៏ ថ្លៃថ្លា នេះ ឱ្យ បាន គង់វង្ស សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ រស់ នៅ និង អាស្រ័យ ផល បន្ត ទៀត ។ ពិសេស បងប្អូន ទាំងអស់ សូម ថែរក្សា សុខភាព ឱ្យ បាន ល្អ មើលថែ កូន ចៅ ឱ្យ បាន ដិតដល់ ប្រកាន់ខ្ជាប់ នូវ ការ ហូប ស្អាត រស់ នៅ ស្អាត ។
ថ្លែង ក្នុង សុន្ទរកថា ថ្ងៃ ឆ្លង ឆ្នាំ សកល លោក ស៉ី ជីន ពីង បាន សង្កត់ធ្ងន់ ថា « ប្រជាជន នៅ សងខាង នៃ ច្រក សមុទ្រ តៃវ៉ាន់ គឺជា គ្រួសារ តែ មួយ » ។ នៅពេល ត្រូវបាន សាកសួរ អំពី ការអត្ថាធិប្បាយ នោះ លោកស្រី សៃ បាន និយាយ ថា គោលការណ៍ ដ៏ សំខាន់ បំផុត ស្តី ទំនាក់ទំនង ជាមួយ ចិន គឺ លទ្ធិ ប្រជាធិបតេយ្យ ។ លោកស្រី សៃ បាន គូសបញ្ជាក់ ថា « នេះ គឺជា ការទទួលយក ឆន្ទៈ រួម របស់ ប្រជាជន តៃវ៉ាន់ ឲ្យ ធ្វើ ការសម្រេចចិត្ត ។ ប្រជាជន តៃវ៉ាន់ ចង់បាន សន្តិភាព ប៉ុន្តែ យើង ចង់បាន សន្តិភាព ដោយ សេចក្តីថ្លៃថ្នូរ » ។
ក្រោយ ការវាយប្រហារ កើតឡើង ជន ដៃ ដល់ ជា បុរស ម្នាក់ ត្រូវបាន ចាប់ខ្លួន ភ្លាម ៗ នៅនឹង កន្លែង កើត ហេតុ ។ ប៉ុន្តែ ស្ថានភាព របស់ លោក Lee មិន ទាន់ មាន ការបញ្ជាក់ ឡើយ ខណៈ រូបភាព ត្រូវបាន ចេញផ្សាយ នៅលើ សារព័ត៌មាន ក្នុង ស្រុក បង្ហាញ ថា រូប លោក ដេក បិទ ភ្នែក ស្ដូកស្ដឹង នៅលើ ដី ហើយ មនុស្ស នៅ ជុំវិញ យក កូន កន្សែង ខ្ទប់ ឈាម ហូរ ចេញ ពី ក របស់ លោក និង ត្រូវបាន បញ្ជូន ទៅ មន្ទីរពេទ្យ មួយ ៕
បទ វិភាគ៖ ប្រទេស ចិន នឹង វិវឌ្ឍ រីកចម្រើន ទៅ មុខ ជាមួយ ពិភពលោក ដើម្បី ឆ្ពោះ ទៅកាន់ គោលដៅ នៃ ការកសាង សហគមន៍ រួម វាសនា នៃ មនុស្សជាតិ
( ប៉េកាំង ) ៖ ប្រទេស ចិន បាន ក្លាយជា " ប្រទេស ធំ ប្រកបដោយ ទំនួល ខុសត្រូវ ដែល កាន់តែ មាន កម្លាំង ឥទ្ធិពល លើ ឆាក អន្តរជាតិ មាន កម្លាំង ដឹកនាំ ក្នុង ការច្នៃប្រឌិត ថ្មី និង មាន ការអំពាវនាវ ខាង សច្ច យុត្តិធម៌ " នេះ គឺជា សេចកី្តស និ្នដ្ឋាន ដែល ធ្វើឡើង ក្នុង សន្និសីទ ការងារ កិច្ចការ បរទេស នៃ មជ្ឈិម ចិន ដែល បាន បើក ធ្វើ នៅ ទីក្រុង ប៉េកាំង ពី ថ្ងៃទី ២៧ ដល់ ថ្ងៃទី ២៨ ខែធ្នូ ។
ឆ្នាំ ២០២៣ ប្រទេស ចិន បាន បង្ហាញ ពី ទំនួល ខុសត្រូវ នៃ ប្រទេស ធំ តាមរយៈ ការអនុវត្ត ជាក់ស្តែង របស់ ខ្លួន ។ ដោយឡែក នៅ ឆ្នាំ ២០២៤ ប្រទេស ចិន នឹង ធ្វើអន្តរកម្ម កាន់តែ ល្អ ប្រសើរ ជាមួយ ពិភពលោក ដើម្បី ឆ្ពោះ ទៅរក គោលដៅ នៃ ការកសាង សហគមន៍ រួម វាសនា នៃ មនុស្សជាតិ ៕
គួរ បញ្ជាក់ ថា រុស្ស៉ី បាន ចាប់ផ្តើម សា ជា ថ្មី នូវ ការ បង្កើន សកម្មភាព វាយប្រហារ តាម ផ្លូវ អាកាស មក លើ អ៊ុយក្រែន តាំងពី អំលុង ចុង ឆ្នាំ ២០២៣ ខណៈ កាលពី ថ្ងៃសុក្រ សប្តាហ៍ មុន រុស្ស៉ី បាន បើក ការវាយប្រហារ ដ៏ ធំ បំផុត មួយ ដោយ ប្រើប្រាស់ មីស៉ីល និង ដ្រូន សរុប ចំនួន រាប់ រយ ហើយ បណ្តាលឱ្យ មនុស្ស យ៉ាងហោច ៣៩ នាក់ ស្លាប់ នៅ អ៊ុយក្រែន ៕ រូបភាព ពី Reuters គ.ជ. ប បុក គ្រឹះ សាងសង់ អគារ ទីស្តីការ ថ្មី តម្លៃ ជាង ២១លាន ដុល្លារ
( ភ្នំពេញ ) ៖ គម្រោង អគារ ទីស្តីការ ថ្មី របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត គ.ជ. ប កម្ពស់ ៩ជាន់ ត្រូវបាន បុក គ្រឹះ សាងសង់ នៅលើ ដី លំនៅឋាន ទំហំ ជាង ៥ ពាន់ ម៉ែត្រ ការ៉េ ដែល ត្រូវបាន រាជ រដ្ឋាភិបាល ដកហូត ពី លោក គង់ គាំ អតីត មន្រ្តី ជាន់ ខ្ពស់ គណបក្ស ភ្លើង ទៀន ប្រគល់ ជា កម្មសិទ្ធិ ឱ្យ គ.ជ.ប ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប នៅ ព្រឹក ថ្ងៃទី ២ ខែមករា ឆ្នាំ ២០២៤ នេះ ។ អគារ ទីស្តីការ ថ្មី របស់ គ.ជ. ប ស្ថិត នៅ ដីឡូតិ៍ លេខ ៧១ វិថី សុធារស សង្កាត់ ទន្លេ បាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ។
លោក ហង្ស ពុទ្ធា សមាជិក គ.ជ. ប បាន ឱ្យដឹង ថា តម្លៃ នៃ ការ សាងសង់ អគារ នេះ ស្ថិត ក្នុង គម្រោង ចំណាយ ប្រមាណ ២១លាន ដុល្លារ អាមេរិក ដែល ថវិកា នេះ បាន មក ពី ការជួល អគារ ទីស្តីការ គ.ជ. ប បច្ចុប្បន្ន ឱ្យ ទៅ ក្រុមហ៊ុន ណាហ្កា វើល ។
លោក បាន បញ្ជាក់ ថា៖ « អ្វី ៗ ដែល ប្រព្រឹត្តទៅ នេះ គឺ ផ្អែក ទៅ លើ ការចុះ កិច្ចសន្យា ជាមួយ ក្រុមហ៊ុន ណាហ្កា វើល តាំងពី ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០២៣ » ។ លោក ហង្ស ពុទ្ធា បន្ត ថា តាម បន្ទុក កិច្ចសន្យា របស់ ក្រុមហ៊ុន សាងសង់ គឺ អគារ ទីស្តីការ ថ្មី របស់ គ.ជ. ប នេះ នឹង ត្រូវ រួច រាល់ ជា ស្ថាពរ នៅក្នុង ខែតុលា ឆ្នាំ ២០២៥ ។
លោក ហង្ស ពុទ្ធា បាន បន្ថែម ថា អគារ ដែល កំពុង សាងសង់ នេះ មាន ទំហំ ជាង ៣ម៉ឺន ២ពាន់ ម៉ែត្រ ការ៉េ ដោយ ក្នុង អគារ នេះ មាន សាល ប្រជុំ មួយ ដែល ផ្ទុក មនុស្ស បាន ៤៥០ នាក់ ។ អគារ ថ្មី នេះ នឹង ផ្តល់ បរិយាកាស កាន់តែ ល្អ ប្រសើរ សម្រាប់ ថ្នាក់ដឹកនាំ គ.ជ. ប និង មន្ត្រី គ.ជ. ប បំពេញ ការងារ រៀបចំ ការបោះឆ្នោត ។
សូម បញ្ជាក់ ថា ទីស្នាក់ការ គ.ជ. ប នា ពេល បច្ចុប្បន្ន មាន កម្ពស់ ១៥ ជាន់ នៅជាប់ នឹង ជញ្ជាំង អគារ ពាណិជ្ជកម្ម សណ្ឋាគារ និង កាស៊ីណូ របស់ ក្រុមហ៊ុន ណាហ្កា វើល ស្ថិត នៅ ទល់មុខ ពុទ្ធសាសន បណ្ឌិត្យ ក្នុង សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ដែល ជា ការដោះដូរ ដី រដ្ឋ បាន ពី ការជួល ទៅ ឱ្យ ក្រុមហ៊ុន ណាហ្កា វើល វិនិយោគ ជា សណ្ឋាគារ និង កាស៊ីណូ ក្នុង រយៈពេល ៩៩ ឆ្នាំ ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន បញ្ជាក់ ៣ ចំណុច អំពី ស្ថានភាព ពលរដ្ឋ ខ្មែរ រស់ នៅក្នុង ប្រទេស ជប៉ុន បន្ទាប់ពី មាន គ្រោះ រញ្ជួយ ដី កម្រិត ៧. ៦វ៉ិចទ័រ នា ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២៤ ដូចត ទៅ៖
៣៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ សូម អំពាវនាវ ពលរដ្ឋ ខ្មែរ ដែល កំពុង រស់ នៅក្នុង ប្រទេស ជប៉ុន បន្ត មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ព្រមទាំង គោរព និង អនុវត្ត តាម ការណែនាំ របស់ អាជ្ញាធរ ជប៉ុន ដើម្បី សុវត្ថិភាព ផ្ទាល់ខ្លួន ៕ ក្រសួង ការងារ បង្ហាញ ឈ្មោះ ទីភ្នាក់ងារ ជ្រើសរើស ឯកជន ៩៨ ក្រុមហ៊ុន ដែល ជ្រើសរើស ពលករ ទៅ ធ្វើការ នៅ ប្រទេស ជប៉ុន ដោយ ស្រប ច្បាប់
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី២ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន បញ្ចេញ ឈ្មោះ ទីភ្នាក់ងារ ជ្រើសរើស ឯកជន ដែល មាន សិទ្ធិ ឱ្យ ធ្វើ ការជ្រើសរើស បណ្តុះបណ្តាល បញ្ជូន និង គ្រប់គ្រង កម្មសិក្សា ការី - ពលករ ជំនាញ ទៅ ធ្វើ កម្មសិក្សា និង ធ្វើការ នៅ ប្រទេស ជប៉ុន មាន ចំនួន ៩៨ ក្រុមហ៊ុន ។
ក្រសួង ការងារ បាន បញ្ជាក់ ថា រាល់ ទីភ្នាក់ងារ ជ្រើសរើស ឯកជន ទាំងឡាយ ណា ដែល ពុំ មាន ឈ្នោះ ក្នុង បញ្ជី ខាងក្រោម នេះ គឺ ចាត់ទុក ថា ជា ទីភ្នាក់ងារ ជ្រើសរើស ឯកជន ខុស ច្បាប់ ដូច្នេះ សូម សាធារណជន រាយការណ៍ ជាបន្ទាន់ មក ទូរស័ព្ទ លេខ ០៨៩ ៩៥៧ ៧៨៩ និង ទំនាក់ទំនង មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ទាំង ២៥ រាជធានី - ខេត្ត នៅ រៀងរាល់ ម៉ោង ធ្វើការ ឬ ពិនិត្យមើល បញ្ជី ឈ្មោះ ក្រុមហ៊ុន ដែល មាន នៅក្នុង គេហទំព័រ របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
ដើម្បី ជៀសវាង ការផ្សព្វផ្សាយ ព័ត៌មាន ខុស ដែល អាច នាំឱ្យ ប្រជាពលរដ្ឋ រងគ្រោះ ការផ្សព្វផ្សាយ ពាណិជ្ជកម្ម ពាក់ព័ន្ធ និង ការជ្រើសរើស ឬ ផ្តល់ សេវា រក ការងារ ធ្វើ ដល់ ពលករ ខ្មែរ នៅ តាម បណ្តាញ សារព័ត៌មាន ណាមួយ ជាពិសេស តាម បណ្តា ស្ថានីយ៍ វិទ្យុ ត្រូវ មាន លិខិត អនុញ្ញាត ចេញ ដោយ អគ្គ នាយកដ្ឋាន ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ជាមុន ផងដែរ ៕ ឈ្វេងយល់ ! តើ អ្វី ទៅ ជាបរធន បាលកិច្ច សត្វ ចិញ្ចឹម ?
( ភ្នំពេញ ) ៖ និយ័តករបរ ធន បាលកិច្ច ( ន. ប.ធ. ) ដែល ជា និយ័តករ គ្រប់គ្រង ត្រួតពិនិត្យ និង អភិវឌ្ឍន៍ វិស័យ បរធន បាលកិច្ច នៅ កម្ពុជា តែងតែ រៀបចំ អត្ថបទ ដើម្បី ជា ប្រយោជន៍ ក្នុង ការបញ្ជ្រាប ចំណេះដឹង អំពី វិស័យ បរធន បាលកិច្ច ដែល ជា វិស័យ ដ៏ សំខាន់ មួយ
នៅ ពេល នេះ បាន រៀបចំ អត្ថបទ ថ្មី មួយ ទៀត ស្តីពី តើ អ្វី ទៅ ជាបរធន បាលកិច្ច សត្វ ចិញ្ចឹម ៕
ខាងក្រោម នេះ ជា អត្ថបទ ទាំង ស្រុង៖
ក្រសួង ការងា រ៖ ពលករ ខ្មែរ នៅ កូរ៉េ ខាងត្បូង អាច ចាប់ផ្ដើម ទៅ ទទួល សេវា ធ្វើ លិខិត ឆ្លង ដែន ធម្មតា បាន
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី២ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ និង ពលករ ខ្មែរ ដែល កំពុង ស្នាក់ នៅ និង ធ្វើការ នៅ សាធារណរដ្ឋ កូរ៉ ទាំងអស់ អាច ទៅ ទទួល សេវា ធ្វើ លិខិត ឆ្លង ដែន ធម្មតា នៅ តាម ស្ថានទូត រយៈពេល ៤ខែ ចាប់ពី ខែមករា ឆ្នាំ ២០២៤ នេះ តទៅ ។
បើ តាម សេចក្តីជូនដំណឹង របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បាន បញ្ជាក់ ទៀត ថា ការផ្តល់ សេវា ធ្វើ លិខិត ឆ្លង ដែន នៅ ស្ថានទូត នេះ ស្រប តាម អនុសាសន៍ ណែនាំ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី ក្នុង ការការសម្របសម្រួល ធ្វើ លិខិត ឆ្លង ដែន នៅ ក្រៅ ប្រទេស ដើម្បី កុំ ឱ្យ ពលករ ជួប ការលំបាក ធ្វើដំណើរ មក កម្ពុជា ក្នុង ការធ្វើ លិខិត ឆ្លង ដែន ។
បើ តាម ក្រសួង ការងារ សម្រាប់ ព័ត៌មាន លម្អិត អំពី កាលបរិច្ឆេទ និង ទីតាំង ជាក់លាក់ សូម ទំនាក់ទំនង ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សាធារណរដ្ឋ កូរ៉េ ( តាមរយៈ ទូរសព្ទ លេខ + ៨២ ០២ ៣៧៨៥ ១០៤១ ) ឬ អនុព័ន្ធ ការងារ អម ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សាធារណរដ្ឋ កូរ៉េ ( តាមរយៈ ទូរសព្ទ លេខ + ៨២ ០១០ ៨៨៩៨ ៨៦៤៤ ) នៅ រៀងរាល់ ម៉ោង ធ្វើការ ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ បរិវេណ សាលា បឋម និង អនុវិទ្យាល័យ ប៊ុន រ៉ានី សែន ជ័យ ដំណាក់ ត្រយឹង ដោយ បាន ការចូលរួម ពី លោក អភិបាល រង ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ និង បងប្អូន គ្រួសារ អតីត យុទ្ធជន យ៉ាង ច្រើន កុះករ ។
បន្ទាប់ពី សេចក្ដីរាយការណ៍ របស់ លោក អៀង ហុង អនុប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត អំពី ភូមិសាស្ត្រ អភិវឌ្ឍន៍ ការងារ សម្ព័ន្ធ មេត្រីភាព និង ស្ថានភាព ជីវភាព រស់ នៅ របស់ បងប្អូន អតីត យុទ្ធជន នោះ រួច មក . លោក ខូយ រីដា បាន ថ្លែង ថា ថ្ងៃ នេះ ជា ឱកាស មួយ ដ៏ មហោឡារិក ដែល យើង បាន មក ជួបជុំគ្នា ដើម្បី ផ្ដល់ អំណោយ មនុស្សធម៌ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ពោធិ៍សាត់ ជូន ដល់ អតីត យុទ្ធជន ចំនួន ៦២៨ គ្រួសារ ក្នុង ឱកាស ទិវា ចូល ឆ្នាំ សាកល និង ខួប លើក ទី៤៥ នៃ ទិវា ជាតិ ជ័យ ជំនះ ៧ មករា ។
លោក បាន គូសបញ្ជាក់ ថា ផ្ទះ ចំនួន ៦២៨ ខ្នង នេះ គឺ បាន មកពី ការផ្តល់ ដី សម្បទាន របស់ សម្ដេច តេជោ ហ៊ុន សែន សាងសង់ ឡើង ក្នុង ឆ្នាំ ២០២០ ហើយ បាន បញ្ចប់ នៅ ត្រីមាស ទី១ ឆ្នាំ ២០២២ ជា អំណោយ របស់ កាកបាទ ក្រហម កម្ពុជា ដែល មាន ហ្លួង ម៉ែ ន រោត្ដម មុនី នា ថ សីហនុ ជា ព្រះប្រធាន កិត្តិយស និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន និង បាន ប្រគល់ ជូន អតីត យុទ្ធជន យើង ជា បន្តបន្ទាប់ ។
លោក ខូយ រីដា បាន បន្ត ថា ការសាងសង់ ផ្ទះ ទាំងអស់ នេះ គឺជា ការយកចិត្តទុកដាក់ ពី នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត គន់ គីម ទេសរដ្ឋមន្ត្រី អនុប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ក្នុង ការជួយ អភិវឌ្ឍន៍ ភូមិ ប៊ុន រ៉ានី សែន ជ័យ ដំណាក់ ត្រយឹង ទាំង ផ្លូវថ្នល់ អណ្តូង ទឹក ទំនប់ ស្ទាក់ ទឹក សាលារៀន មណ្ឌល សុខភាព និង វត្ត អារាម ជូន បងប្អូន បាន រស់ នៅ បាន ល្អ ប្រសើរ ។
លោក ខូយ រីដា ក៏ បាន ស្នេី ឱ្យ អតីត យុទ្ធជន និង ក្រុមគ្រួសារ សូម បង្កើន ការដាំដុះ ដំណាំ ផ្សេង ៗ ទាំង ដំណាំ រយះពេល ខ្លី ដំណាំ យុទ្ធសាស្ត្រ ដើម្បី ធ្វើឱ្យ ជីវភាព គ្រួសារ កាន់តែ ប្រសើរឡើង ។
សូម បញ្ជាក់ ដែរ ថា អំណោយ មនុស្សធម៌ របស់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ពោធិ៍សាត់ ដែល ត្រូវ ផ្ដល់ជូន បងប្អូន គ្រួសារ អតីត យុទ្ធជន ចំនួន ៦២៨ គ្រួសារ ដោយ ក្នុង មួយ គ្រួសារ ទទួលបាន៖ អង្ករ២៥ គីឡូក្រាម មី ០១ កេស ទឹកត្រី ឬ ទឹក ស៊ីអ៊ីវ០១ យួរ ព្រមទាំ បន្ត ចុះ ពិនិត្យ ការរស់នៅ និង ការងារ បង្កបង្កើន ផល តាម ខ្នង ផ្ទះ ផងដែរ ៕
អគ្គ នាយក នៃ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន ថ្លែង សុន្ទរកថា ជូនពរ ឆ្នាំ ថ្មី ឆ្នាំ សកល ២០២៤ ជូន ចំពោះ ប្រិយមិត្ត របស់ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន នៅ ទូទាំង ពិភពលោក
ក្នុង រយៈពេល ១២ខែ នេះ រដ្ឋាភិបាល បាន ឧបត្ថម្ភ មូលនិធិ នៃ មន្ទីរពេទ្យ គន្ធ បុប្ផា កម្ពុជា បាន ចំនួន សរុប ១ ៥៩៦ ១៣៨ ដុល្លារ អាមេរិក ពី ចំណែក នៃ ការលក់ បណ្ណ ជូន ភ្ញៀវ ទេសចរ បរទេស ចូល ទស្សនា រមណីយ អង្គរ ដើម្បី ជួយ ក្នុង មូលនិធិ សម្រាប់ សង្គ្រោះ ជីវិត កុមារ កម្ពុជា ៕
គួរ បញ្ជាក់ ថា គ្រោះ រញ្ជួយ ដី ខ្លាំង ៗ បន្តបន្ទាប់ គ្នា ក្នុង នោះ រួម មាន ទាំង កម្រិត ៧. ៦រ៉ិច ទ័រ បាន វាយប្រហារ ជប៉ុន កាលពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ ។ គិត ចាប់តាំង ថ្ងៃចន្ទ មក ជប៉ុន បាន កត់ត្រា ការកើតមាន រំញ័រ សរុប យ៉ាងហោច ១៥៥ លើក ។ អាជ្ញាធរ ជប៉ុន ក៏ បាន ប្រកាស អាសន្ន ពីរ លក ស៊ូណាមិ ផងដែរ ប៉ុន្តែ នៅ ព្រឹក ថ្ងៃអង្គារ នេះ បាន សម្រេច ដក ការប្រកាស អាសន្ន នោះ ចេញ វិញ ៕
រូបភាព ពី Reuters អភិបាល ខេត្ត កំពង់ចាម៖ អំពើរ ជួញដូរ មនុស្ស បាន បង្កឱ្យ មាន វិនាសកម្ម ជាថ្មី ដល់ មនុស្សជាតិ ហើយ កំពុង ក្លាយជា ទាសភាព សម័យ ទំនើប គួរឱ្យ ភ័យខ្លាច និង ស្អប់ខ្ពើម
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន លើកឡើង ថា ភាព រងគ្រោះ ទាំងឡាយ ដោយ ឧក្រិដ្ឋកម្ម ជួញដូរ មនុស្ស ដែល បាន បង្កឱ្យ មាន វិនាសកម្ម ជាថ្មី ដល់ មនុស្សជាតិ ហើយ បាន នឹង កំពុង ក្លាយជា ទេសភាព សម័យ ទំនើប គួរឱ្យ ភ័យខ្លាច និង ស្អប់ខ្ពើម ។
អភិបាល ខេត្ត បាន លើកឡើង ដូច្នេះ នៅ ព្រឹក ថ្ងៃទី ២ ខែមករា ឆ្នាំ ២០២៤ ក្នុង ពិធី ប្រារព្ធ ទិវា ជាតិ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស ១២ ធ្នូ នៅក្នុង បរិវេណ វត្ត ជោត នា រាម គរ ភូមិ ក្រោយ វត្ត ឃុំ គរ ស្រុក ព្រៃឈរ ។
