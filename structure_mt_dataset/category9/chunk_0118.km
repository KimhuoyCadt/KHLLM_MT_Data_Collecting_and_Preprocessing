( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ១៩ ខែមករា ឆ្នាំ ២០២៤ ។
ក្រសួង បញ្ជាក់ ថា ទ្រនុង សម្ពាធ ខ្ពស់ ពី ប្រទេស ចិន នៅតែ បន្ត ឥទ្ធិពល គ្របដណ្តប់ មក លើ ភាគ ឦសាន ជាមួយនឹង ខ្យល់ មូសុង ឦសាន ខ្សោយ ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឱ្យ៖ ចាប់ពី ថ្ងៃទី ១៩ ដល់ ថ្ងៃទី ២១ ខែមករា ឆ្នាំ ២០២៤៖
ជាពិសេស ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិសាស្ត្រ ជួរ ភ្នំ ដងរែក និង ខ្ពង់រាប ភាគ ឦសាន សូម ប្រុងប្រយ័ត្ន ថែរក្សា សុខភាព ចំពោះ ធាតុអាកាស ត្រជាក់ ដោយ ស្លៀក សម្លៀកបំពាក់ ឱ្យ បាន គត់ មត់ ដើម្បី បង្ការ ពី ជំងឺ ដង្កាត់ នានា ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ៕ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ ប្រធាន ព្រឹទ្ធសភា បារាំង
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន សម្តែង ក្តីរីករាយ ចំពោះ ជំនួប ពិភាក្សា ការងារ នា ឱកាស នោះ និង បាន ជម្រាប ប្រធាន ព្រឹទ្ធសភា បារាំង អំពី លទ្ធផល នៃ ជំនួប ជាមួយ លោក ប្រធានាធិបតី បារាំង ជាពិសេស វឌ្ឍនភាព កិច្ចសហប្រតិបត្តិ លើ វិស័យ ជាច្រើន ដែល ជា ប្រយោជន៍ រួម នៃ ប្រទេស ទាំង ពីរ ជា អាទិ៍ វិស័យ នយោបាយ សេដ្ឋកិច្ច វប្បធម៌ និង ភាសា ជាដើម ។
សម្តេច ធិបតី ក៏ បាន អញ្ជើញ ប្រធាន ព្រឹទ្ធសភា បារាំង មក បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ កម្ពុជា ជាពិសេស នៅ ក្រោយ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ នា ខែកុម្ភៈ ឆ្នាំ ២០២៤ ៕
បារាំង សន្យា ផ្តល់ កញ្ចប់ ថវិកា ២០០ លាន អឺរ៉ូ ដល់ កម្ពុជា សម្រាប់ វិស័យ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ថាមពល និង ប្រព្រឹត្តកម្ម ទឹក ស្អាត (Video inside) ( ប៉ារីស . បារាំង ) ៖ លោក អេម៉ា នូអែល ម៉ាក្រុង ប្រធានាធិបតី បារាំង បាន ប្រកាស ថា នៅ សប្តាហ៍ នេះ បារាំង បាន សន្យា ផ្តល់ កញ្ចប់ ថវិកា ២០០ លាន អឺរ៉ូ ដល់ ប្រទេស កម្ពុជា ដើម្បី ជួយ សម្រាប់ វិស័យ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ថាមពល និង ប្រព្រឹត្តកម្ម ទឹក ស្អាត ។
ការប្រកាស បែប នេះ បាន ធ្វើឡើង នៅក្នុង សន្និសីទ សារព័ត៌មាន រួមគ្នា រវាង សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង លោក អេម៉ា នូអែល ម៉ាក្រុង ប្រធានាធិបតី បារាំង ក្នុង ជំនួប នៅ ទីក្រុង ប៉ារីស នា ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៤ នេះ ។
លោក ប្រធានាធិបតី បាន ចាត់ទុក ថា ទស្សនកិច្ច របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នា ពេលនេះ ជា ឱកាស មួយ សម្រាប់ បង្កើត គម្រោង ថ្មី ៗ ថែម ទៀត ជាមួយ ក្រុមហ៊ុន របស់ បារាំង ហើយ សម្តេច បាន ជួប ផ្លាស់ប្តូរ យោបល់ ជាមួយ ក្រុមហ៊ុន ជាច្រើន ជាពិសេស ក្រុមហ៊ុន ថាមពល ដឹកជញ្ជូន និង ហេដ្ឋារចនាសម្ព័ន្ធ ។
លោក ប្រធានាធិបតី ក៏ បាន កោតសរសើរ អំពី ជំហរ កម្ពុជា ដោយ ចូលរួម ក្នុង សេចក្តីថ្លែងការណ៍ អង្គការ សហ ប្រជាជាតិ ថ្កោល ទោស ប្រទេស រុស្ស៉ី ដែល បាន ឈ្លានពាន ទៅ ប្រទេស អ៊ុយក្រែន ផងដែរ ។
លោក បាន ប្រកាស ជាមុន នូវ ការស្វាគមន៍ ចំពោះ វត្តមាន របស់ សម្តេច ធិបតី ជាថ្មី ម្តង ទៀត ទៅកាន់ ប្រទេស បារាំង ដើម្បី បន្ត សរសេរ ប្រវត្តិសាស្ត្រ ប្រទេស ទាំង ពីរ ជា ប្រវត្តិសាស្ត្រ ផ្អែក លើ មិត្តភាព មិន ចេះ ប្រេះស្រាំ រវាង ទាំង ពីរ ។
សូម បញ្ជាក់ ថា សម្តេច ធិបតី ហ៊ុន ម៉ាណែត កំពុង បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ប្រទេស បារាំង រយៈពេល ២ ថ្ងៃ គឺ នៅ ថ្ងៃទី ១៨ - ១៩ ខែមករា ឆ្នាំ ២០២៣ តប តាម ការអញ្ជើញ របស់ ប្រធានាធិបតី បារាំង ដើម្បី ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ៕
WHO ថ្លឹងថ្លែង ពី ហានិភ័យ របស់ បញ្ញា សិប្បនិម្មិត និង អន្ថ ប្រយោជន៍ របស់ វា សម្រាប់ ការថែទាំ សុខភាព
( ហ្សឺណែវ ) ៖ បញ្ញា សិប្បនិម្មិត ជំនាន់ ក្រោយ អាច ផ្លាស់ប្តូរ ការថែទាំ សុខភាព តាមរយៈ ការអភិវឌ្ឍន៍ ថ្នាំ និង ការធ្វើ រោគវិនិច្ឆ័យ លឿន ជាង មុន ក្នុង ចំណោម វិធីសាស្ត្រ ផ្សេង ទៀត ប៉ុន្តែ អង្គការ សុខភាព ពិភពលោក (WHO) នៅ ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ បាន សង្កត់ធ្ងន់ ថា គួរតែ យកចិត្តទុកដាក់ បន្ថែម ទៀត ចំពោះ ហានិភ័យ របស់ វា ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៤ ។
អង្គការ សុខភាព ពិភពលោក បាន និង កំពុង សិក្សា ពី គ្រោះថ្នាក់ និង អត្ថប្រយោជន៍ ដែល អាច កើតមាន នៃ គំរូ ពហុ មុខងារ ធំ នៃ បញ្ញា សិប្បនិម្មិត (LMMs) ដែល មាន លក្ខណៈ ថ្មី និង កំពុង ត្រូវបាន អនុម័ត យ៉ាង ឆាប់រហ័ស ក្នុង វិស័យ សុខាភិបាល ។
អង្គការ សុខភាព ពិភពលោក (WHO) បាន និយាយ ថា « វា ត្រូវបាន គេ ព្យាករណ៍ ថា គំរូ LMMs នឹង មាន ការប្រើប្រាស់ និង អនុវត្ត យ៉ាង ទូលំទូលាយ នៅក្នុង ការថែទាំ សុខភាព ការស្រាវជ្រាវ វិទ្យាសាស្ត្រ សុខភាព សាធារណៈ និង ការអភិវឌ្ឍន៍ ថ្នាំ » ។
ទោះបីជា មាន សក្តានុពល បែប នេះ ក៏ដោយ WHO ព្រមាន ថា មាន ហានិភ័យ ចំពោះ លទ្ធផល ដែល ទទួលបាន ពី ការកត់ត្រា ទុក របស់ ប្រព័ន្ធ LMMs អាច បង្កើត លទ្ធផល មិន ពិត មិន ត្រឹមត្រូវ លំអៀង ឬ មិន ពេញលេញ ។ ហើយ វា ក៏ អាច ត្រូវបាន បណ្តុះបណ្តាល លើ ទិន្នន័យ ដែល មាន គុណភាព អន់ ឬ ទិន្នន័យ ដែល មាន ភាពលំអៀង ទាក់ទង នឹង ពូជសាសន៍ ជាតិ សាសន៍ ពូជ ពង្ស ភេទ អត្តសញ្ញាណ យេនឌ័រ ឬ អាយុ ជាដើម ។
អង្គការ WHO បាន ព្រមាន ដូច្នេះ ថា « នៅ ពេល ដែល គំរូបញ្ញា សប្បនិម្មិត LMMs ទទួលបាន ការប្រើប្រាស់ កាន់តែ ទូលំទូលាយ ក្នុង ការថែទាំ សុខភាព ការប្រើប្រាស់ ខុស និង គ្រោះថ្នាក់ ជា យថាហេតុ ចំពោះ បុគ្គល គឺ ជៀស មិន រួច »៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោក ប្រធានាធិបតី បារាំង រំពឹង ថា ទំនាក់ទំនង កម្ពុជា - បារាំង កាន់តែ ល្អ ប្រសើរ ក្រោយ ដំណើរទស្សនកិច្ច របស់ សម្តេច ធិបតី
( ប៉ារីស . បារាំង ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ចាប់ផ្តើម ដំណើរទស្សនកិច្ច ជា ផ្លូវការ របស់ សម្តេច នៅក្នុង ប្រទេស បារាំង ហើយ ។ ជាមួយ ការចាប់ផ្តើម ដំណើរទស្សនកិច្ច ផ្លូវការ នេះ នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី១៨ ខែមករា ឆ្នាំ ២០២៤ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ទទួលបាន ការស្វាគមន៍ យ៉ាង កក់ក្តៅ បំផុត លោក អេម៉ា នូអែល ម៉ាក្រុង ប្រធានាធិបតី បារាំង ។
មុន ជួបប្រជុំ ការងារ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោក ប្រធានាធិបតី បារាំង បាន ធ្វើ សន្និសីទ ព័ត៌មាន រួមគ្នា បញ្ជាក់ ពី ដំណើរទស្សនកិច្ច ផ្លូវការ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក្នុង ប្រទេស បារាំង ។
ក្នុង សន្និសីទ នោះ លោក ប្រធានាធិបតី បារាំង បាន បង្ហាញ ក្តី សោមនស្ស រីករាយ ចំពោះ ដំណើរទស្សនកិច្ច របស់ សម្តេច ធិបតី ។ លោក ម៉ាក្រុង បាន រំលឹក ពី តួនាទី បារាំង ក្នុង ការស្វែងរក សុខ សន្តិភាព នៅ កម្ពុជា ក៏ ដូចជា ការផ្តល់ ជំនួប សម្រាប់ ការអភិវឌ្ឍន៍ នៅ កម្ពុជា ។
លោក ប្រធានាធិបតី ក៏ បាន បញ្ជាក់ ពី ការទម្លាក់ កញ្ចប់ ជំនួយ ប្រមាណ ២០០ លាន អឺរ៉ុប សម្រាប់ ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ថាមពល និង ប្រព្រឹត្តកម្ម ទឹក ស្អាត ។ លោក ប្រធានាធិបតី ក៏ បាន ថ្លែង កោតសរសើរ កម្ពុជា ចំពោះ ការបញ្ជូន កងកម្លាំង ចូលរួម ថែរក្សា សន្តិភាព ជាមួយ អង្គការ សហ ប្រជាជាតិ ដែល ជា វិភាគទាន ធំ មួយ នៅ អាស៊ី ។
លោក ម៉ាក្រុង ក៏ បាន ថ្លែង កោតសរសើរ ចំពោះ ជំហរ របស់ កម្ពុជា ប្រឆាំង នឹង សង្គ្រាម ឈ្លានពាន របស់ រុស្ស៉ី នៅក្នុង ប្រទេស អ៊ុយក្រែន ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន បង្ហាញ ក្តី សោមនស្ស រីករាយ ចំពោះ ការបំពេញ ទស្សនកិច្ច ជា ផ្លូវការ នៅ បារាំង និង បាន ថ្លែងអំណរគុណ ចំពោះ ការបដិសណ្ឋារកិច្ច យ៉ាង កក់ក្តៅ ពី លោក ប្រធានាធិបតី បារាំង ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូស រំលេច ផងដែរ ថា ក្នុង ជំនួប ជាមួយ ប្រធានាធិបតី បារាំង នឹង ជជែកគ្នា ទៅ លើ ប្រធានបទ ដែល មាន ការចាប់អារម្មណ៍ រួម ក៏ ដូចជា ប្រយោជន៍ រួម ប្រទេស យើង ទាំង ពីរ ក្នុង ក្របខណ្ឌ ទ្វេ ភាគី ក៏ ដូចជា ក្របខណ្ឌ សកលលោក ផងដែរ ។
សម្តេច ធិបតី ក៏ បាន គូស រំលេច ពី សារៈសំខាន់ នៃ តួនាទី របស់ វិស័យ ឯកជន នៃ ប្រទេស ទាំង ពីរ ផង ដេរ ។ សម្តេច បាន លើកឡើង ថា ទំនាក់ទំនង រវាង រដ្ឋ និង រដ្ឋ នៃ ប្រទេស ទាំង ពីរ ពិតជា មាន សារៈសំខាន់ ហើយ អ្វី ដែល ចាំបាច់ និង សំខាន់ ដែរ នោះ គឺ ទំនាក់ទំនង រវាង វិស័យ ឯកជន ដែល ឯកឧត្តម ប្រធានាធិបតី មានប្រសាសន៍ មិញ ។ ជាពិសេស វិស័យ ឯកជន ទាំង ពីរ យើង អាច ប្រដូច ទៅនឹង ឈាម ក្រហម ដែល អាច ចិញ្ចឹម រាងកាយ នៃ ទំនាក់ទំនង ទ្វេ ភាគី កម្ពុជា - បារាំង ។
សម្តេច ធិបតី បាន បង្ហាញ ក្តីសង្ឃឹម ថា ដំណើរទស្សនកិច្ច របស់ សម្តេច នៅ បារាំង នា ពេលនេះ ជាពិសេស ជំនួប ជាមួយ ឯកឧត្តម ប្រធានាធិបតី នៅ ថ្ងៃ នេះ នឹង អាច ឱ្យ យើង ជជែកគ្នា នៅក្នុង កិច្ចការងារ ដែល ត្រូវ បន្ត ទៅ ទៀត នៅក្នុង ការពង្រឹង ទំនាក់ទំនង រវាង កម្ពុជា និង បារាំង ។
ជា ចុងក្រោយ សម្តេច ធិបតី បាន ជូន ពរ បារាំង ឱ្យ ទទួលបាន ជោគជ័យ ក្នុង ការរៀបចំ ព្រឹត្តិការណ៍ កីឡា អូឡាំពិក ឆ្នាំ ២០២៤ ក៏ ដូចជា ការរៀបចំ កិច្ចប្រជុំ ហ្វ្រង់ កូហ្វូនី ៕
( រ៉ាហ្វា ) ៖ ក្រុម គ្រូពេទ្យ បាន និយាយ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ថា មនុស្ស ១៦ នាក់ ដែល ពាក់កណ្តាល នៃ ពួកគេ ជា កុមារ ត្រូវបាន សម្លាប់ នៅក្នុង ការវាយប្រហារ តាម អាកាស របស់ អ៊ីស្រាអែល ទៅ លើ ផ្ទះ មួយ ខ្នង នៅក្នុង ទីក្រុង រ៉ាហ្វា នៃ ភាគ ខាងត្បូង ហ្គាហ្សា ស្ទ្រីប ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៤ ។
កងទ័ព អ៊ីស្រាអែល បាន បន្ត វាយប្រហារ គោលដៅ នានា ក្នុង តំបន់ ដែល ត្រូវបាន ឡោមព័ទ្ធ ខណៈ ជន ស៊ីវិល ត្រូវបាន ស្នើសុំ ឱ្យ ស្វែងរក ជម្រក ។
ជាង ១០០ ថ្ងៃ បន្ទាប់ពី ក្រុមហា ម៉ាស់ បាន បញ្ឆេះ សង្រ្គាម ជាមួយនឹង ការវាយប្រហារ របស់ ខ្លួន កាលពី ថ្ងៃទី ៧ ខែតុលា អ៊ីស្រាអែល បន្ត ធ្វើ យុទ្ធនាការ យោធា ដ៏ បង្ហូរ ឈាម និង បំផ្លិចបំផ្លាញ បំផុត ក្នុង ប្រវត្តិសាស្ត្រ ទំនើប ដោយ មាន បំណង បោសសម្អាត ក្រុម ប្រដាប់អាវុធ មួយ នេះ ដែល បាន គ្រប់គ្រង តំបន់ ហ្កាហ្សា តាំងពី ឆ្នាំ ២០០៧ មក ។ សង្គ្រាម បាន បង្កើន ភាពតានតឹង នៅ ទូទាំង តំបន់ ដោយ គំរាមកំហែង នឹង បញ្ឆេះ ជម្លោះ ផ្សេង ៗ ។
រហូតមកទល់ ពេលនេះ ជនជាតិ ប៉ាឡេ ស្ទីន ជាង ២៤.០០០ នាក់ ត្រូវបាន សម្លាប់ ហើយ ប្រហែល ៨៥ ភាគរយ នៃ ប្រជាជន នៅ តំបន់ ឆ្នេរ ដ៏ ចង្អៀត ដែល មាន ប្រជាជន ចំនួន ២.៣ លាន នាក់ បាន ភៀសខ្លួន ចេញ ពី ផ្ទះ របស់ ពួកគេ ហើយ អង្គការ សហ ប្រជាជាតិ បាន និយាយ ថា មួយ ភាគ បួន នៃ ចំនួន ប្រជាជន សរុប កំពុង រង ការអត់ឃ្លាន ៕
ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ ណែនាំ មន្ត្រី នៃ អធិការដ្ឋាន នគរបាល មាន ជ័យ និង ចំការមន ត្រូវ ផ្តល់ ភាពកក់ក្តៅ ជូន ប្រជាពលរដ្ឋ
លោក ស្នងការ ក៏ បាន ណែនាំ ដល់ មន្ត្រី នគរបាល ត្រូវ បង្កើន យកចិត្តទុកដាក់ ការចុះ ពង្រឹង អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ដើម្បីឲ្យ មូលដ្ឋាន កាន់តែ មាន សុខ សុវត្ថិភាព និង ត្រូវ ពង្រឹង ការអនុវត្ត ច្បាប់ ឲ្យបាន ម៉ឺងម៉ាត់ និង វិធានការ ជំនាញ ច្បាស់លាស់ ។
លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ ក៏ បាន ជំរុញ ឲ្យ កម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ ទាំង ពីរ ត្រូវ ខិតខំ ស្រាវជ្រាវ បង្រ្កាប បទល្មើស នៅ សេសសល់ ឲ្យបាន មិន ត្រូវ ទុកចោល បទល្មើស មិន ចាត់ការ នោះ ទេ និង បាន ណែនាំឲ្យ មាន ការគ្រប់គ្រង កម្លាំង សម្ភារៈ មធ្យោបាយ ឲ្យបាន ដើម្បី ការអនុវត្ត ភារកិច្ច ជោគជ័យ ។
ជាមួយគ្នា នោះ លោក ក៏ បាន ណែនាំឲ្យ មន្រ្តី នគរបាល យុត្តិធម៌ ត្រូវ យល់ ពី ភារកិច្ច របស់ ខ្លួន និង ការពង្រឹង ការយល់ដឹង ច្បាប់ និង ការអនុវត្ត នីតិវិធី និង បាន ណែនាំឲ្យ មាន ការបំពេញ ភារកិច្ច តាម ឋានានុក្រម និង បែងចែក វេន ល្បាត ប្រចាំ ការអនុវត្ត ជាប្រចាំ ។
សូម បញ្ជាក់ ថា ពិធី សំណេះសំណាល ដែរ មាន ការចូលរួម ពី លោក ស្នងការ រង លោក នាយ ការិយាល័យ ជំនាញ លោក អធិការ នគរបាល ខណ្ឌ ទាំង ពីរ និង លោក - លោកស្រី អធិការ រង លោក នាយ ផ្នែក ជំនាញ និង លោក នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ចំណុះ អធិការដ្ឋាន នគរបាល ខណ្ឌ មានជ័យ និង ចំការមន ជាច្រើន រូប ផងដែរ ៕
អាជ្ញាធរ មីន៖ ចាប់ពី ឆ្នាំ ២០១៨ ប្រទេស ចិន បាន ផ្តល់ ហរិញ្ញ ប្បទាន ឥត សំណង ចំនួន ១៤.៤ លាន ដុល្លារ និង បាន ធ្វើ ការបោសសម្អាត មីន និង គ្រាប់ ក្នុង ទំហំ ផ្ទៃដី ជាង ១០៧ គីឡូម៉ែត្រ ក្រឡា
( ភ្នំពេញ ) ៖ លោក លី ធុជ ទេសរដ្ឋមន្រ្តី និង ជា អនុប្រធាន ទី១ អាជ្ញាធរ មីន តំណាង សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ មីន នា ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា រវាង ក្រសួង ការបរទេស នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន និង អាជ្ញាធរ មីន ស្ដីពី ការពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ជំនួយ បោសសម្អាត មីន មនុស្សធម៌ នៅ ទីស្នាក់ការ អាជ្ញាធរ មីន ។
តាង នាម សម្តេច ធិបតី ហ៊ុន ម៉ាណែត . លោក លី ធុជ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ដំណើរទស្សនកិច្ច របស់ លោក MA Shengkun និង គណៈប្រតិភូ ពិតជា បាន ឆ្លុះបញ្ចាំង ពី ទំនាក់ទំនង យ៉ាង ជិតស្និទ្ធ រវាង ប្រទេស និង ប្រជាជន យើង ទាំង ពីរ ព្រមទាំង បាន ថ្លែង អរគុណ ជូន ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន នៃ ប្រទេស ចិន ដែល បាន ផ្តល់ ទំនុកចិត្ត និង ផ្តល់ ការគាំទ្រ ទាំង ថវិកា និង សម្ភារ រួមទាំង ការផ្តល់ ការបណ្តុះបណ្តាល ជារៀងរាល់ ឆ្នាំ ដែល ជា វិស័យ អាទិភាព មួយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
