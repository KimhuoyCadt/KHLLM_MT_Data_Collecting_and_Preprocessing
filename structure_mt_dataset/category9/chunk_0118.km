( ព្រៃវែង ) ៖ លោក នី ប៊ុន ថា ដែល ជា កូន ប្រសា និង ឈ្មោះ ជិន ស្រី មុច ជា កូន បង្កេីត នៃ សព ឈ្មោះ ជិន ផាត បាន ធ្វើ ការស្រាយ បំភ្លឺ និង ច្រានចោល ទាំងស្រុង ចំពោះ ការផ្សាយ របស់ បណ្ដាញ ព័ត៌មាន មួយចំនួន ដែល បាន ចោទប្រកាន់ មន្ទីរ សម្រាប់ ព្យាបាល ខៀង សុគន្ធា ថា បាន ព្យាបាល ឪពុក របស់ ខ្លួន បណ្ដាលឲ្យ ស្លាប់ ខណៈ ដែល បញ្ជូន ចេញ ពី គ្លីនិក មួយ នេះ ។
លោក នី ប៊ុន ថា ដែល ជា ក្រុមគ្រួសា នៃ សព សុំ បដិសេធ និង បំភ្លឺ ថា ក្នុង នាម ជា កូនប្រសារ បាន នៅ ជាមួយ ឪពុក ក្មេក គាត់ បាន ដឹង យល់ យ៉ាង ច្បាស់ អំពី អាការៈ ជំងឺ របស់ ឪពុក ក្មេក របស់ គាត់ ។
ប្រភព បាន បន្ត ថា មុននឹង ឈាន មកដល់ ការសម្រាក ព្យាបាល នៅ មន្ទីរ សម្រាក ព្យាបាល ខៀង សុគន្ធា នេះ ដែរ គាត់ ក៏ បាន ទៅ ពេទ្យ ផ្សេង ៗ ដែរ តែ ពេទ្យ គេ ដទៃ នោះ មិន ទទួល ព្យាបាល នោះ ទេ ។ ដោយឡែក នៅ ពេល ដែល ឪពុក ខ្លួន មកដល់ មន្ទីរ សម្រាក ព្យាបាល ខៀង សុគន្ធា នេះ ក៏ បាន អង្វរ ឲ្យ ពេទ្យ ជួយ ព្យាបាល ឪពុក ខ្លួន តែ មន្ទីរ សម្រាក ព្យាបាល នេះ ក៏ មិន ចង់ ទទួល ព្យាបាល នោះ ដែរ តែ ដោយសារ ក្រុមគ្រួសារ គាត់ អង្វរ ពេក មន្ទីរ សម្រាក ព្យាបាល នេះ ក៏ ព្រម ទទួល ព្យាបាល ហើយ បាន ធ្វើ កិច្ចសន្យា ត្រឹមត្រូវ ។
លោក បាន បន្ត ថា នៅ ពេល ដែល ទៅដល់ មន្ទីរពេទ្យ បង្អែក ខេត្ត ពេទ្យ ខេត្ត ក៏ បាន បន្ត បញ្ជូន ឪពុក ក្មេក ទៅ ភ្នំពេញ តែ គាត់ មិន ចង់ ទៅ នោះ ទេ តែ ដោយសារ អាការៈ ជំងឺ ឪពុក ក្មេក ខ្លួន ត្រូវតែ បញ្ជូន ទៅ ភ្នំពេញ ខណៈ បញ្ជូន ទៅដល់ ពាក់កណ្ដាល ផ្លូវ ឆ្លង ស្ពាន ព្រែក តា មាក់ បាន បន្តិច អាការៈ ជំងឺ របស់ ឪពុក មាន សភាព ចុក ខ្លាំង ឡើង បណ្ដាលឲ្យ ស្លាប់ តាម ផ្លូវ តែម្តង ។
សូម បញ្ជាក់ ថា នៅក្នុង កិច្ចសន្យា នោះ ក្រុមគ្រួសារ នៃ អ្នកជំងឺ បាន យល់ព្រម ឱ្យ គ្រូពេទ្យ ធ្វើ ការសង្គ្រោះ បន្ទាន់ តាម បច្ចេកទេស ដោយ ពុំ គិត ពី ផលវិបាក ឬ ឧបសគ្គ ណាមួយ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ក្នុង ការសង្គ្រោះ ព្យាបាល នេះ ឡើយ ។ បើ ក្នុង ពេល សង្គ្រោះ បន្ទាន់ ឬ ក្រោយ ការសង្គ្រោះ បន្ទាន់ របស់ គ្រូពេទ្យ ហើយ តែ អ្នកជំងឺ នៅតែ មិន អាច ជួយសង្គ្រោះ បាន ក្រុមគ្រួសារ របស់ អ្នកជំងឺ បាន សន្យា ថា មិន ធ្វើ ការប្តឹង ផ្តល់ ឬ ទារ សំណង ជំងឺ ចិត្ត ពី ក្រុម គ្រូពេទ្យ និង មន្ទីរ សម្រាក ព្យាបាល ឡើយ ។
ពាក់ព័ន្ធ នឹង ករណី នេះ ដែរ បើ តាម ការឲ្យដឹង អំពី គ្រូពេទ្យ នៃ មន្ទីរ សម្រាក ព្យាបាល ខៀង សុគន្ធា បាន ឲ្យដឹង ថា អ្នកជំងឺ ដែល មក ព្យាបាល នៅក្នុង មន្ទីរ សម្រាក ព្យាបាល របស់ លោក មាន ឈ្មោះ ជិន ផាត អាយុ ៦២ ឆ្នាំ រស់ នៅ ភូមិ តា ឡើក ឃុំ អង្គរ ទ្រេត ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង មាន ជំងឺ រ៉ាំរ៉ៃ ធ្ងន់ធ្ងរ ជា ច្រើន ឆ្នាំ មកហើយ ដោយ លើស សម្ពាធ ឈាម បេះដូង និង រលាក សួត រ៉ាំរៃ ។
គ្រូពេទ្យ នៅ មន្ទីរ សម្រាក ព្យាបាល ខៀង សុគន្ធា បាន បន្ត ថា ដោយ មាន ការអង្វរ ពី ក្រុមគ្រួសារ នៃ អ្នកជំងឺ ឲ្យ គ្រូពេទ្យ ជួយសង្គ្រោះ ទើប មន្ទីរ សម្រាក ព្យាបាល យល់ព្រម ជួយ សង្គ្រោះ ហើយ បាន ធ្វើ កិច្ចសន្យា ត្រឹមត្រូវ ផងដែរ ៕
គណបក្ស ប្រជាជន កម្ពុជា ចាប់ បាន លេខរៀង ទី១ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា អាណត្តិ ទី៥ (Video inside) ( ភ្នំពេញ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន លេខរៀង ទី១ នៅលើ សន្លឹក ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។
ពិធី ចាប់ ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត នៅលើ សន្លឹក ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ បាន ធ្វើឡើង ដោយ គ.ជ. ប នៅ ព្រឹក ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២៤ នេះ ក្រោម អធិបតីភាព លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប និង ចាប់ ឆ្នោត ដោយ សម្តេច ព្រះសង្ឃរាជ ទាំង ពីរ គណៈ ។
ក្រៅពី គណបក្ស ប្រជាជន កម្ពុជា ដែល ទទួលបាន លេខរៀង ទី១ ក៏ មាន ៣ទៀត ដែល ចូលរួម ក្នុង ការបោះឆ្នោត នេះ ក្នុង នោះ គណបក្ស ឆន្ទៈ ខ្មែរ បាន លេខរៀង ទី២ គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច លេខរៀង ទី៣ និង គណក ប្សកម្លាំង ជាតិ លេខរៀង ទី៤ ។
សូម បញ្ជាក់ ថា ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ នឹង ធ្វើឡើង នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ជា ការបោះឆ្នោត អសកល ដោយ អង្គ បោះឆ្នោត សម្រាប់ ការបោះឆ្នោត នេះ គឺជា តំណាងរាស្រ្ត ក្នុង តំណែង និង សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ទាំងអស់ គ្នា តំណែង នៅក្នុង ក្របខណ្ឌ នៃ ភូមិភាគ នីមួយ ៗ ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤៤ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២៧ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៤៤ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៤ នាក់ នោះ មាន ២៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស គ្រឿងញៀន ១៦ករណី និង ជនសង្ស័យ ១៧នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស ព្រហ្មទណ្ឌ ១៣ករណី ។
គណបក្ស នេះ ចាត់ទុក ថា ចំពោះ សកម្មភាព នយោបាយ របស់ គណបក្ស កាវក្លៃ ហាក់បីដូចជា កំពុង ធ្វើ សកម្មភាព ឲ្យ ប៉ះពាល់ ដល់ នយោបាយ ការទូត រវាង ប្រទេស កម្ពុជា - ថៃ ទាំង វិស័យ សេដ្ឋកិច្ច និង នយោបាយ ជាខ្លាំង ជាពិសេស ធ្វើឲ្យ ប៉ះពាល់ ច្បាប់ ប្រទេស ថៃ ដែល ប្រទេស ថៃ មិន អនុញ្ញាតឲ្យ បរទេស ណាមួយ យក ទឹកដី ថៃ ធ្វើ សកម្មភាព ប្រឆាំង រដ្ឋាភិបាល ស្រប ច្បាប់ ប្រទេស ផ្សេង ៗ នោះ ទេ ពិសេស ប្រទេស អាស៊ាន ។
ខាងក្រោម នេះ ជា សំណើ របស់ គណបក្ស នយោបាយ កម្ពុជា ទៅកាន់ នាយក រដ្ឋមន្រ្តី ថៃ៖
( បាត់ដំបង ) ៖ សមាជិក ក្រុមប្រឹក្សា គណបក្ស ភ្លើង ទៀន ក្រុង បាត់ដំបង និង ជា អតីត ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច របស់ អតីត គណបក្ស សង្គ្រោះ ជាតិ សង្កាត់ រតនៈ លោក យ៉ាន រិន ឌី បាន គោរព ស្នើសុំ សម្ដេច តេជោ ហ៊ុន សែន ដើម្បី មាន ឱកាស បាន ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
ជាមួយគ្នា នេះ លោក យ៉ាន រិន ឌី ក៏ បាន អភ័យទោស នូវ រាល់ កំហុសឆ្គង ដែល កើតមាន កន្លងមក ដោយសារតែ ការជឿ តាម គណបក្ស ប្រឆាំង ចេះតែ ញុះញង់ បំបែកបំបាក់ ជាតិ ។ លោក បាន អំពាវនាវ ដល់ អ្នកគាំទ្រ គណបក្ស ប្រឆាំង ទាំងអស់ ទាំង ក្នុង ស្រុក និង ក្រៅ ស្រុក សូម ងាក មក គាំទ្រ និង ចូលរួម ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា វិញ ដើម្បី មាន ឱកាស ចូលរួម អភិវឌ្ឍន៍ ជាតិ មាតុភូមិ ៕ នាយ ឧត្តមសេនីយ៍ ម៉ៅ សុផាន់ អញ្ជើញ បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ សម្រាប់ អនុវត្ត បន្ត ឆ្នាំ ២០២៤ នៅ ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ នៅ រសៀល ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នាយ ឧត្តមសេនីយ៍ ម៉ៅ សុផាន់ អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជការកងទ័ព ជើងគោក និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល កម្ពុជា ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ សម្រាប់ អនុវត្ត បន្ត ឆ្នាំ ២០២៤ របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ ។
លោក គីម រឹទ្ធី បាន រាយការណ៍ សង្ខេប អំពី លទ្ធផល ការងារ ឆ្នាំ ២០២៣ របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ មាន ដូចជា ការងារ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ការគ្រប់គ្រង ធនធាន ធម្មជាតិ ការប្រើប្រាស់ ដីធ្លី ព្រៃឈើ និង ជល ផល និង ការផ្តល់ សេវា សង្គម និង ការងារ បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង កិច្ច គាំពារ សង្គម ។
ថ្លែង ក្នុង ពិធី បិទ សន្និបាទ នេះ ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា នាយ ឧត្តមសេនីយ៍ ម៉ៅ សុផាន់ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ នៃ រដ្ឋបាល គ្រប់ លំដាប់ថ្នាក់ និង ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន មន្ត្រីរាជការ កងកម្លាំង មាន សមត្ថកិច្ច ទាំងអស់ ដែល បាន រួមគ្នា យ៉ាង ល្អ បំពេញ តួនាទី ភារកិច្ច ការទទួលខុសត្រូវ រហូត សម្រេចបាន នូវ សមិទ្ធផល នានា ជាច្រើន ជូន ប្រជាពលរដ្ឋ ក្នុង ទូទាំង ខេត្ត ។
នាយ ឧត្តមសេនីយ៍ ម៉ៅ សុផាន់ បាន ផ្ដល់ គោលការណ៍ ណែនាំ លើ កិច្ចការ អាទិភាព សំខាន់ ៗ មួយចំនួន និង ទិសដៅ សម្រាប់ អនុវត្ត ឆ្នាំ ២០២៤ ដល់ រដ្ឋបាល ខេត្ត ព្រះវិហារ ជា មាន ដូច ជា៖
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ១៣នាក់ ។
សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ របស់ រដ្ឋបាល ខេត្ត កណ្តាល . ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ដាក់ ចេញ អនុសាសន៍ ណែនាំ បន្ថែម ១២ចំណុច
( កណ្ដាល ) ៖ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នា ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ បាន អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ រដ្ឋបាល ខេត្ត កណ្តាល នៅ សាលា ប្រជុំ សាលា ខេត្ត កណ្ដាល និង ដោយ មាន ការចូលរួម លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល រួមទាំង គណៈប្រតិភូ និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ។
នា ឱកាស នោះ ដែរ លលោក ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ក៏ បាន ណែនាំ ឱ្យ រដ្ឋបាល ខេត្ត . មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ និង កងកម្លាំង សមត្ថកិច្ច គ្រប់ ប្រភេទ និង គ្រប់ លំដាប់ថ្នាក់ ដោយ មាន កិច្ចសហការ គ្នា ល្អ ជាមួយ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋា ខេត្ត កណ្ដាល បន្ត យកចិត្តទុកដាក់ លើ កិច្ចការ អាទិភាព មួយចំនួន ដូច ខាងក្រោម៖
បន្ថែម ពី នេះ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ក៏ បាន ថ្លែង កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រុមប្រឹក្សា ខេត្ត . គណ: អភិបាល ខេត្ត . ថ្នាក់ដឹកនាំ មន្ទីរ និង អង្គភាព ក្នុង ខេត្ត . មន្ត្រីរាជការ និង កងកម្លាំង គ្រប់ លំដាប់ថ្នាក់ ក្នុង ខេត្ត និង ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត កណ្ដាល ដែល បាន ខិតខំ រួមគ្នា យ៉ាង សកម្ម ក្នុង ការបំពេញ តួនាទី និង ភារកិច្ច របស់ ខ្លួន បាន យ៉ាង ល្អ ប្រសើរ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ រហូត សម្រេចបាន នូវ សមិទ្ធផល នានា ជាច្រើន គួរ ជាទីមោទន ។
( មណ្ឌលគិរី ) ៖ លោក ថោ ជេដ្ឋា រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នា ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២៣ បាន ចុះ ពិនិត្យ វឌ្ឍនភាព ជាក់ស្តែង វឌ្ឍនភាព គម្រោង សាងសង់ ទំនប់ អាងទឹក អូរ តេ និង ទំនប់ អាងទឹក ទំនប់ លើ ទំនប់ ក្រោម ស្ថិត ក្នុង ភូមិសាស្ត្រ ស្រុក អូរ រាំង និង ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគិរី ។
សូម ជម្រាប ថា ការចុះ ពិនិត្យ វឌ្ឍនភាព ការងារ ក្នុង ខេត្ត ភូមិភាគ ឦសាន នា ពេលនេះ ក៏ មាន ការចូលរួម ពី លោក ថង សាវុន អភិបាល ខេត្ត មណ្ឌលគិរី ថ្នាក់ដឹកនាំ មន្ត្រី ជំនាញ បច្ចេកទេស ក្រសួង មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម និង អាជ្ញាធរ មូលដ្ឋាន ពាក់ព័ន្ធ ផងដែរ ។
លោក រដ្ឋមន្ត្រី បាន បន្ថែម ទៀត ថា បណ្តា អាងទឹក ក្នុង តំបន់ នេះ ក៏ នឹង ទាក់ទាញ កំណើន ក្នុង វិស័យ អេកូ ទេសចរណ៍ ជាពិសេស ធ្វើឱ្យ បណ្តា ខេត្ត ភូមិភាគ ឦសាន បង្កើន នូវ ផលិតកម្ម ក្នុង វិស័យ កសិឧស្សាហកម្ម មាន ដំណាំ ម្រេច ធុរេន ម្នាស់ ជាដើម និង បង្កើត បាន នូវ បរិស្ថាន បៃតង គ្រប់ ពេលវេលា ព្រមទាំង លើកកម្ពស់ ជីវភាព ប្រជាជន ក្នុង តំបន់ និង ជំរុញ ដល់ កំណើន សេដ្ឋកិច្ច ជាតិ ។
ក្នុង ឱកាស ចុះ ត្រួតពិនិត្យ នេះ លោក រដ្ឋមន្ត្រី បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ វឌ្ឍនភាព ការងារ ដែល សម្រេចបាន ព្រមទាំង បាន ណែនាំ បន្ថែម ដល់ លោក ប្រធាន មន្ទីរ និង ក្រុមការងារ បច្ចេកទេស ឱ្យ បន្ត នូវ កិច្ចសហការ ល្អ ជាមួយ អាជ្ញាធរដែនដី និង គ្រប់ ភាគី ពាក់ព័ន្ធ ដោយ ធ្វើ យ៉ាងណា ឱ្យ ការងារ គម្រោង នេះ សម្រេចបាន ជោគជ័យ ប្រកបដោយ គុណភាព ខ្ពស់ ប្រើប្រាស់ បាន យូរអង្វែង និង បម្រើ ដល់ ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ ក្នុង តំបន់ ។
គួរ បញ្ជាក់ ថា ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដោយ ទទួលបាន នូវ ការគាំទ្រ និង កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ពី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន សាងសង់ អាងទឹក ទំនប់ លើ ទំនប់ ក្រោម និង ទំនប់ អាង អូរ តេ ដែល អាច ស្តុក ទឹក សម្រាប់ បម្រើ ឱ្យ គ្រប់ វិស័យ និង ផ្គត់ផ្គង់ ទឹក ស្អាត បាន ចំនួន ១២លាន ម៉ែត្រ ត្រី គុណ ជា ទឹក រស់ សម្រាប់ បម្រើ ឱ្យ តំបន់ ប៉ូល សេដ្ឋកិច្ច ទី៤ នៃ ភូមិភាគ ឦសាន របស់ ប្រទេស កម្ពុជា ៕
ខាងក្រោម នេះ ជា បញ្ជី ឈ្មោះ គណបក្ស នយោបាយ និង សង្គម ស៊ីវិល ដែល បាន ដាក់ សំណើ ទៅកាន់ នាយក រដ្ឋមន្រ្តី ថៃ៖
រដ្ឋបាល រាជធានី ភ្នំពេញ បើក សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង ទិសដៅ អនុវត្ត ការងារ ឆ្នាំ ២០២៤
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២៣ បាន រៀបចំ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង ទិសដៅ អនុវត្ត ការងារ ឆ្នាំ ២០២៤ នៅ សណ្ឋាគារ រ៉េស៊ី ដង់ សុខា ភ្នំពេញ ។
ការងារ កិច្ចការ ច្បាប់ និង ការដោះស្រាយ វិវាទ មូលដ្ឋាន បាន ទទួល ពាក្យបណ្តឹង ពី ប្រជាពលរដ្ឋ និង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ចំនួន ៩១ ករណី ក្នុង នោះ សំណុំរឿង ចំនួន ៣៤ករណី បាន ដោះស្រាយ ចប់ សព្វគ្រប់ និង សំណុំរឿង ចំនួន ៥៧ ករណី ទៀត កំពុង ពិនិត្យ និង បញ្ជូន ទៅ អង្គភាព ពាក់ព័ន្ធ ដើម្បី ដោះស្រាយ ។
បាន ផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ តាមរយៈ អង្គភាព ច្រក ចេញ - ចូល តែ មួយ រាជធានី ភ្នំពេញ សរុប ចំនួន ៦៥. ៦៩៨ សេវា ពោលគឺជា មធ្យម មាន ប្រជាពលរដ្ឋ មក សុំ សេវា ពី រដ្ឋបាល រាជធានី ភ្នំពេញ ចំនួន ១៨០ សេវា ក្នុង មួយ ថ្ងៃ និង ទទួលបាន ចំណូល ថវិកា រដ្ឋ ចំនួន ជិត ២៧ ពាន់ លាន រៀល ឬ ស្មើនឹង ប្រមាណ ៦. ៥៨ន ដុល្លា អាមេរិក ។
ចំនួន ជើងហោះហើរ និង ចំនួន អ្នកដំណើរ តាមរយៈ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ បាន បន្ត កើន ឡើងវិញ គួរឱ្យ កត់សម្គាល់ ស្រប តាម គោល នយោបាយ លើកកម្ពស់ វិស័យ ទេសចរណ៍ របស់ រាជ រដ្ឋាភិបាល ក្នុង នោះ ជើងហោះហើរ សរុប មាន ចំនួន ៨. ៧៤០ ជើង កើនឡើង ៣១. ៦៤% និង អ្នកដំណើរ សរុប មាន ចំនួន ១. ៥៤៣. ២៦៩ នាក់ កើនឡើង ១០៦ % ធៀប នឹង រយៈពេល ដូចគ្នា ក្នុង ឆ្នាំ ២០២២ កន្លងទៅ ។
ទន្ទឹមនឹង សមិទ្ធផល និង ស្នាដៃ ការងារ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ នៅ មាន បញ្ហា ប្រឈម មួយ ចំនួន ទៀត ដែល ត្រូវ ទទួលខុសត្រូវ ដូច្នេះ ក្រុមប្រឹក្សា និង គណៈ អភិបាល រាជធានី ភ្នំពេញ បាន ឯកភាព គ្នា លើក យក ទិសដៅ ការងារ និង បញ្ហា ប្រឈម ថ្មី ៗ ដើម្បី រៀបចំ ជា ប្រធានបទ សម្រាប់ ការពិភាក្សា នៅក្នុង អង្គ សន្និបាត នេះ ដោយ សម្រេច បែងចែក ជា ក្រុម ពិភាក្សា ដោយ ផ្តោត ជា សំខាន់ ទៅ លើ ប្រធានបទ ចំនួន ៤៖
ទី១៖ ការបង្ការ បង្ក្រាប និង លុបបំបាត់ ការធ្វើចរាចរ និង ប្រើប្រាស់ គ្រឿងញៀន ។ ទី ២៖ ការផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ប្រកប ទៅនឹង បញ្ហា ឈាម ដោយ តម្លាភាព ទី៣៖ យន្តការផ្តល់ ជំនួយ សង្គម ជូន ប្រជាពលរដ្ឋ ក្រីក និង ជន ងាយ រង គ្រោទី ៤៖ ការពង្រឹង គុណភាព អប់រំ នៅ រាជធានី ភ្នំពេញ ។
ទន្ទឹមនឹង លទ្ធផល ដែល សម្រេចបាន ជា វិជ្ជមាន ខាងលើ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង ព្យាយាម បន្ត ប្រមូលផ្តុំ កម្លាំង សរុប មធ្យោបាយ សរុប និង វិធានការ សរុប ដើម្បី បន្ត គ្រប់គ្រង និង ដោះស្រាយ ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត លើ ការងារ អាទិភាព សំខាន់ ៗ ពិសេស ការបំពេញ តួនាទី ភារកិច្ច ក្នុង នាម ជា អ្នកបម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ តម្លាភាព ប្រសិទ្ធភាព និង សមធម៌ ៕
លោក បន្ត ថា ផ្អែក តាម ប្រតិទិន នៃ ការបោះឆ្នោត គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត នឹង ធ្វើ ការបិទ ផ្សាយ បញ្ជី បោះឆ្នោត ដំបូង នៅ ថ្ងៃទី ៥ ខែមករា ឆ្នាំ ២០២៤ ក្នុង គោលបំណង បម្រើ ឱ្យ ការប្តឹង តវ៉ា ឬ ប្តឹង ជំទាស់ បន្ទាប់មក គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត នឹង ផ្តល់ សុពលភាព លើ បញ្ជី បោះឆ្នោត ផ្លូវការ នៅ ថ្ងៃទី ៩ ខែកុម្ភៈ ឆ្នាំ ២០២៨ ខាងមុខ នេះ ។
ប្រធាន គ.ជ. ប បាន បញ្ជាក់ បន្ថែម ថា នៅពេល ខាងមុខ នេះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ត្រូវ ផលិត សន្លឹក ឆ្នោត សម្រាប់ ភូមិភាគ នីមួយ ៗ ដើម្បី ប្រើប្រាស់ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ដែល នៅក្នុង សន្លឹក ឆ្នោត ទាំងនោះ ត្រូវការ ជា ចាំបាច់ នូវ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត ដែល នឹង ត្រូវ កំណត់ ជា លេខរៀង របស់ គណបក្ស នយោបាយ នីមួយ ៗ នៅលើ សន្លឹក ឆ្នោត សម្រាប់ ភូមិភាគ ទាំង ៨ ។
លោក ប្រាជ្ញ ចន្ទ បាន បញ្ជាក់ បន្ថែម ទៀត ថា លទ្ធផល នៃ ការចាប់ឆ្នោត ដើម្បី កំណត់ លំដាប់ លេខរៀង ឈ្មោះ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត នៅលើ សន្លឹក ឆ្នោត មាន អត្ថន័យ សំខាន់ ណាស់ សម្រាប់ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត ទាំងអស់ ដោយ បាន បង្ក លក្ខណៈ ងាយស្រួល ដល់ គណបក្ស នយោបាយ ក្នុង ការឃោសនា បោះឆ្នោត ការបោះឆ្នោត និង ជួយ ឱ្យ អ្នកបោះឆ្នោត និង អង្គ បោះឆ្នោត អាច ស្គាល់ បាន ដោយ ងាយស្រួល នូវ គណបក្ស នយោបាយ ដែល គាត់ ស្រឡាញ់ ពេញចិត្ត ។
ការថ្លែង បែប នេះ របស់ លោក រដ្ឋមន្ត្រី សុខ សូកេន ក្នុង ឱកាស ចូលរួម កិច្ច ស្វាគមន៍ ដំណើរ របស់ ភ្ញៀវ ទេសចរ អន្តរជាតិ ដែល ចូលមក ទស្សនា កម្ពុជា តាមរយៈ នាវា ទេសចរណ៍ Westerdam នៅ បរិវេណ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
ថ្លែង ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន លោក រដ្ឋមន្ត្រី បាន វាយតម្លៃ ពី បរិយាកាស រីករាយ រំលេច នូវ ការញញឹម រួសរាយ រាក់ទាក់ រវាង ប្រតិភូ ម្ចាស់ ផ្ទះ កម្ពុជា និង ក្រុម ភ្ញៀវ ទេសចរ អន្តរជាតិ ដែល ចុះ ពីលើ នាវា ទេសចរណ៍ ។
លោក រដ្ឋមន្ត្រី បញ្ជាក់ ថា ចំពោះ អ្នកដំណើរ ខ្លះ ដែល ធ្លាប់ ជួប រឿងរ៉ាវ កាលពី ឆ្នាំ ២០២០ អំឡុង ពេល កូវី ដ១៩ នោះ បាន រំឭក អនុស្សាវរីយ៍ ឡើងវិញ និង បាន បង្ហាញ ពី ភាពកក់ក្ដៅ ការថ្លែងអំណរគុណ ចំពោះ ប្រទេស កម្ពុជា ពិសេស សម្ដេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី និង ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សេចក្ដីសណ្ដោស ប្រណី ព្រម ទទួល ជួយ ពួកគេ កាលពី ពេល មាន វិបត្តិ កូវីដ នៅ ៣ឆ្នាំ មុន នោះ ។
ដោយសារ ការស្នាក់ នៅ និង ការទស្សនា កម្សាន្ត របស់ ភ្ញៀវ អន្តរជាតិ ដែល មក តាម ផ្លូវ សមុទ្រ មាន រយៈពេល ខ្លី យ៉ាង ដូច្នេះ លោក រដ្ឋមន្ត្រី សុខ សូកេន បាន បង្ហាញ អំពី គម្រោងការណ៍ រៀបចំ ផលិតផល ទេសចរណ៍ ថ្មី ៗ ហេដ្ឋារចនាសម្ពន្ធ គាំទ្រ វិស័យ ទេសចរណ៍ បន្ថែម ទៀត នៅ ខេត្ត ព្រះសីហនុ ក៏ ដូចជា តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា ដើម្បី រួមចំណែក ទាក់ទាញ ការស្នាក់នៅ របស់ ភ្ញៀវ ទេសចរ តាម ផ្លូវ សមុទ្រ ឱ្យ បាន យូរ ជាង នេះ ។
ភ្នំពេញ៖ ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ . លោក សុខ សម្បត្តិ អភិបាល ខណ្ឌ បឹងកេងកង បាន បញ្ជា ដល់ កម្លាំង សមត្ថកិច្ច ឱ្យ មាន ការយកចិត្តទុកដាក់ ក្នុង ការទប់ស្កាត់ នូវ រថយន្ត - រុឺ ម៉ក ដឹក ទំនិញ ស ពីង សំពោង ដែល នាំឱ្យ ប៉ះពាល់ ដល់ ដល់ សណ្តាប់ធ្នាប់ ចរាចរណ៍ តាម ដងផ្លូវ ។
កាលពី ព្រឹក ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ សមត្ថកិច្ច ខណ្ឌ បឹងកេងកង បាន ពួន ស្ទាក់ ឃាត់ រថយន្ត ចំនួន ៣គ្រឿង ដែល ដឹក ទំនិញ សំពីង សំពោង ខុស បច្ចេកទេស ក្នុង ការដឹកជញ្ជូន មកពី តាម បណ្តា ខេត្ត ចូលមក រាជធានី ភ្នំពេញ យកមក អប់រំ ណែនាំ ( កិច្ចសន្យា ) និង ឱ្យ យក រថយន្ត យកមក ផ្ទេរ អ៉ីវ៉ាន់ ចេញ កុំ ឱ្យ សំពីង សំពោង រួច ទើប ឱ្យ ត្រឡប់ ទៅវិញ ។
លោក សុខ សម្បត្តិ បាន ថ្លែង ថា គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ នឹង បន្ត ការអនុវត្ត ឱ្យ ដូច ភ្លៀង រលឹម ដើម្បី ទប់ស្កាត់ បញ្ហា នេះ មិន ឱ្យ កើតមាន តទៅទៀត ។
ជាមួយនឹង សកម្មភាព ពេលនេះ លោក អភិបាល ខណ្ឌ សូម អំពាវនាវ ដល់ អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ មេត្តា ចូលរួម គោរព ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ជាប់ ជាប្រចាំ ដើម្បី ការពារ អាយុជីវិត យើង អាយុជីវិត គ្រួសារ យើង និង អាយុជីវិត អ្នកដទៃ ៕ លោក វ៉ា ឈូដា ត្រូវបាន តែងតាំង ជា ទីប្រឹក្សា សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា
( ព្រះសីហនុ) ៖ អ្នក ឧកញ៉ា គៀន ស្រី នាង ភរិយា អ្នក ឧកញ៉ា ទ្រី ភាព អគ្គ នាយក ក្រុមហ៊ុន ទ្រី ភាព គ្រុប បាន ឧបត្ថម្ភ ថវិកា ២៥.០០០ ដុល្លារ ជូន កាកបាទ ក្រហម ខេត្ត ព្រះសីហនុ ដើម្បី បម្រើ សកម្មភាព មនុស្សធម៌ ក្នុង ខេត្ត ។
លោក គួច ចំរើន ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រះសីហនុ បាន ថ្លែងអំណរ អគុណ យ៉ាង ជ្រាលជ្រៅ ជូន អ្នក ឧកញ៉ា ចំពោះ ការចូលរួម សកម្មភាព មនុស្សធម៌ ជួយ ដល់ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ដោយ គ្រោះ ធម្មជាតិ និង គ្រោះមហន្តរាយ ផ្សេង ៗ នៅក្នុង ខេត្ត ។
សូម បញ្ជាក់ ថា អ្នក ឧកញ៉ា ទ្រី ភាព និង អ្នក ឧកញ៉ា គៀន ស្រី នាង ជា ពលរដ្ឋ ខ្មែរ តែងតែ ចូលរួម ក្នុង សកម្មភាព មនុស្សធម៌ និង បាន បរិច្ចាគ ធនធាន ផ្ទាល់ខ្លួន រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល និង អាជ្ញាធរ ពាក់ព័ន្ធ ដោះស្រាយ ការលំបាក ប្រជាពលរដ្ឋ ពេល ជួប គ្រោះអាសន្ន នានា ៕
មូលនិធិ ជន ពិការ នៃ ក្រសួង សង្គមកិច្ច ប្រគល់ ផ្ទះ ១ខ្នង ជូន ជន មាន ពិការភាព នៅ ខេត្ត ស្ទឹងត្រែង
( ស្ទឹងត្រែង ) ៖ មូលនិធិ ជន ពិការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ប្រគល់ ផ្ទះ ១ខ្នង ជូន ជន មាន ពិការភាព នៅ ខេត្ត ស្ទឹងត្រែង ។
ពិធី នេះ មាន ការចូលរួម ជា អធិបតី ពី លោក ហ៊ុត ពន្លឺ នាយក រង មូលនិធិ ជន ពិការ តំណាង លោក ខុម ផល លឿន ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា នាយក មូលនិធិ ជន ពិការ លោក ប្រធាន មន្ទីរ សង្គមកិច្ច ខេត្ត សាខា មូលនិធិ ជន ពិការ ខេត្ត តំណាង ស.ស .យ .ក . វិស័យ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង អាជ្ញាធរ សង្កាត់ ព្រះបាទ ។
លោក ហ៊ុត ពន្លឺ បាន ឲ្យដឹង ថា សម្រាប់ ខេត្ត ស្ទឹងត្រែង នេះ គឺជា ផ្ទះ ទី១ ហើយ ដែល មូលនិធិ ជន ពិការ សាងសង់ ជូន ជន មាន ពិការ ភាពក្រីក្រ ។ គិត មកដល់ ពេលនេះ មូលនិធិ ជន ពិការ បាន សាងសង់ ផ្ទះ បាន ៤៧ ខ្នង ហើយ គិត ពី ឆ្នាំ ២០១៩មក នេះ ជា ផ្ទះ ទី៤៦ ហើយ ដែល បាន ប្រគល់ ជា ផ្លូវការ ។
លោក បាន ផ្តាំផ្ញើ ដល់ គ្រួសារ ជន មាន ពិការ ភាព ដែល ជា ម្ចាស់ ផ្ទះ សូម ចូល រស់ នៅក្នុង គេហដ្ឋាន នេះ ឱ្យ មាន សេចក្តីសុខ ចម្រើន និង សូម ថែរក្សា សុខភាព ដើម្បី ជៀស ផុត ពី ជំងឺ នានា ។
ទាំង អាជ្ញាធរ ខេត្ត ព្រះសីហនុ និង មន្រ្តី ទេសចរណ៍ បាន ចាត់ទុក ការវិលត្រឡប់ របស់ នាវា ទេសចរណ៍ Westerdam ម្ដង ទៀត ជា ឱកាស សម្រាប់ បង្ហាញ ពិភពលោក ពី សក្ដានុពល របស់ កម្ពុជា ជាពិសេស ខេត្ត ព្រះសីហនុ និង ទាក់ទាញ អ្នក វិនិយោគ មក ខេត្ត ទៀតផង ។
មូលហេតុ ដែល រដ្ឋាភិបាល សម្រេច ឱ្យ នាវា អាម៉េរិក ចូល ចត នេះ ក្រោម ហេតុផល ថា ជួយសង្គ្រោះ មនុស្ស និង បង្ហាញ ពី សកម្មភាព មនុស្សធម៌ ជាពិសេស លុបបំបាត់ ភាពភ័យខ្លាច របស់ ពលរដ្ឋ លើ បញ្ហា ជំងឺ រលាក សួត ដែល បង្កឡើង ដោយ ជំងឺ កូវីដ១៩ ។
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ ដំឡើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២៣ ដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២៣ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
ក្រសួង សុខាភិបាល របស់ ហ្គាហ្សា បាន និយាយ ថា ជនជាតិ ប៉ាឡេស្ទីន ១៩៥ នាក់ ទៀត ត្រូវបាន សម្លាប់ និង ៣២៥ នាក់ រងរបួស ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ នេះ ដែល នាំឱ្យ ចំនួន អ្នកស្លាប់ ដោយសារ ការវាយប្រហារ របស់ អ៊ីស្រាអែល ចាប់តាំងពី ថ្ងៃទី ៧ ខែតុលា កើន ដល់ ចំនួន ២១.១១០ នាក់ និង រងរបួស ជាង ៥៥.២៤៣ នាក់ ។
អ៊ីស្រាអែល កំពុង ពង្រីក ការវាយលុក តាម ផ្លូវគោក ទៅ លើ ជំរុំ ជនភៀសខ្លួន ប៉ាឡេស្ទីន នៅ ភាគ កណ្តាល ហ្គាហ្សា ស្ទ្រីប ខណៈ ដែល មាន ការព្រមាន ថា សង្រ្គាម ជាមួយ ក្រុមហា ម៉ាស នឹង បន្ត អូសបន្លាយជាច្រើន ខែ ទៅ មុខ ។
ជនជាតិ បង់ក្លាដេស ម្នាក់ ត្រូវ ក្រុមគ្រួសារ អំពាវនាវ ស្វែងរក ក្រោយ បាត់ខ្លួន ដាច់ ការទំនាក់ទំនង ពី ហាង មួយ កន្លែង នៅ ខណ្ឌ ដូនពេញ
លោក នេត្រ ភក្ត្រា ស្នើ ដល់ អាជ្ញាធរ ចូលរួម ការពារ អភិរក្ស សត្វ ផ្សោត សត្វ ត្មាត ជីវ ចម្រុះ តាម ដងទន្លេ មេគង្គ និង ធនធាន ធម្មជាតិ ជាច្រើន ទៀត ក្នុង ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ លោក នេត្រ ភក្ត្រា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ បាន ស្នើ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច ទាំងអស់ ចូលរួម ការពារ អភិរក្ស សត្វ ផ្សោត សត្វ ត្មាត ជីវ ចម្រុះ តាម ដងទន្លេ មេគង្គ និង ធនធាន ធម្មជាតិ ជាច្រើន ទៀត ក្នុង ខេត្ត ក្រចេះ ។
បន្ថែម ពី នោះ ទៀត លោក នេត្រ ភក្ត្រា បាន បញ្ជាក់ ថា ការចូលរួម ការពារ អភិរក្ស បែប នេះ ដើម្បី ជា ប្រភព ចំណូល បង្កើត ការងារ ធ្វើ សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន តាមរយៈ ទេសចរណ៍ មក លេង កំសាន្ត ជាច្រើន ក្នុង មួយ ឆ្នាំ ៗ ដែល ជា ភាពរស់រវើក នៃ សេដ្ឋកិច្ច ក្នុង ខេត្ត ក្រចេះ ។
ការស្នើ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ រដ្ឋបាល ខេត្ត ក្រចេះ នៅ រសៀល ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នា សាល មហោស្រប ខេត្ត ក្រចេះ ។
លោក នេត្រ ភក្ត្រា ក៏ បាន ប្រាប់ ឲ្យ រដ្ឋបាល ខេត្ត ក្រុង ស្រុក ត្រូវ ខិតខំ សហការ សម្របសម្រួល និង គាំទ្រ ដល់ ការរៀបចំ រមណីយដ្ឋាន ទីតាំង ទេសចរណ៍ និង រៀបចំ ក្រុង ស្រុក ឲ្យ មាន សោភ័ណភាព មាន ភាពទាក់ទាញ បរិស្ថាន អនាម័យ ស្អាត មាន សណ្តាប់ធ្នាប់ ការប្រាស្រ័យទាក់ទង ល្អ រួសរាយ រាក់ទាក់ បង្កើត ផលិតផល ទេសចរណ៍ ថ្មី ៗ បន្ថែម ក្នុង មូលដ្ឋាន
ជាពិសេស ជំរុញ លើកទឹកចិត្ត ឲ្យ សហគមន៍ មូលដ្ឋាន ចូលរួម ឲ្យបាន សកម្ម លើ ការអភិវឌ្ឍ ទេសចរណ៍ នៅនឹង កន្លែង ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ ក្នុង ស្រុក និង ក្រៅ ប្រទេស ឲ្យ មក កំសាន្ត កាន់តែ ច្រើន ឡើង សំដៅ បង្កើន ប្រាក់ ចំណូល គ្រួសារ និង ការកាត់បន្ថយ ភាពក្រីក្រ ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក នេត្រ ភក្ត្រា ៕
រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន លើកទឹកចិត្ត ឱ្យ និស្សិត ជ័យលាភី អាហារូបករណ៍ ណូវែលសេឡង់ មាន ភាពស្អាត ពី ខាងក្នុង ដើម្បី ទទួលបាន កិត្តិយស ជូន ជាតិ មាតុភូមិ
ការបញ្ជាក់ អំពី ភាពស្អាត ពី ខាងក្នុង នេះ គឺ សំដៅ ដល់ ភាពស្អាតស្អំ ស្មោះត្រង់ និង អំពើ ល្អ សុច្ចរិត ភាព ដែល ជាដើមទុន សំខាន់ បំផុត ក្នុង ជីវិត របស់ យើង ម្នាក់ ៗ ទោះជា ប្រកប កិច្ចការងារ អ្វី ក៏ ទទួលបាន ជ័យជម្នះ ដែរ ជាក់ស្តែង ភាពស្អាត នេះ គឺ មាន ក្នុង យុទ្ធសាស្រ្ត ចក្រា វិស័យ បរិស្ថាន ២០២៣ - ២០២៨ របស់ ក្រសួង បរិស្ថាន ដែល យុទ្ធសាស្រ្ត នេះ ហើយ ជំរុញ ឱ្យ មាន ការគាំទ្រ យ៉ាង ផុសផុល ពី ប្រជាពលរដ្ឋ និង សិស្សានុសិស្ស សរុប រួម ជិត ៤លាន នាក់ ហើយ មក ទល់ ថ្ងៃ នេះ ។
លើស ពី នេះ រដ្ឋមន្រ្តី បាន លើក យក បទពិសោធន៍ ផ្ទាល់ របស់ លោក យកមក បង្ហាញ និស្សិត ក្នុង ន័យ លើកទឹកចិត្ត ឱ្យ បញ្ញវន្ត គ្រប់ រូប មាន គោលដៅ និង ផែនការ នៅក្នុង ការសិក្សា ដើម្បី នាំមក នូវ ចំណេះដឹង ចំណេះ ធ្វើ បទពិសោធន៍ ពី បរទេស មក ចែករំលែក និង បម្រើ ជា ប្រយោជន៍ ជូន ជាតិ មាតុភូមិ វិញ បន្ទាប់ពី បញ្ចប់ ការសិក្សា ដោយ ជោគជ័យ នា ពេល ខាងមុខ នេះ ៕
រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ជំរុញ ឲ្យ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ នៅ ខេត្ដ ក្រចេះ បន្ត បំរើ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន
ការថ្លែង បែប នេះ របស់ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ រដ្ឋបាល ខេត្ត ក្រចេះ នៅ រសៀល ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នា សាល មហោស្រប ខេត្ត ក្រចេះ ។
លោក ថា ហេតុ នេះ រដ្ឋបាល ខេត្ត ក្រុង ស្រុក ឃុំ សង្កាត់ មន្ទីរ និង អង្គភាព ជំនាញ ត្រូវ ចូលរួម សហការ និង គាំទ្រ ដល់ អនុវត្ត កម្មវិធី គោល នយោបាយ ទាំងនេះ ក្នុង មូលដ្ឋាន របស់ ខ្លួន ប្រកបដោយ ការទទួល ខុស ត្រូវ ខ្ពស់ ដើម្បី បម្រើ ប្រជាពលរដ្ឋ ប្រកបដោយ តម្លាភាព និង គណនេយ្យភាព ៕ គណៈ បញ្ជាការ ស្រុក ឯក ភ្នំ បន្ត ដឹកនាំ កម្លាំង ចម្រុះ ចុះបង្រ្កាប បទល្មើស នេសាទ ក្នុង តំបន់ ហាមឃាត់ រឹបអូស វត្ថុតាង មួយចំនួន ដុត បំផ្លាញ ចោល នៅនឹង កន្លែង
លោក ម៉ិល សុផល បាន បញ្ជាក់ ថា ជា លទ្ធផល រួម មាន៖ បង្រា្ក ប បាន ចំនួន ១១ឡុក . សាច់ មង ប្រវែង ៣៥០០ ម៉ែត្រ និង លែង ត្រី ចម្រុះ ចូល បឹង ធម្មជាតិ វិញ ប្រមាណ ចំនួន ៤០០ គីឡូ . កាប់បំផ្លាញ បង្គោល បណរ៉ាវ ចំនួន ៨០០ ដើម . សាច់ មង ប្រវែង ៣៥០០ ម៉ែត្រ និង បង្គោល ៨០០ ដើម ត្រូវបាន ដុត កម្ទេចចោល នៅនឹង កន្លែង ។
លោក ម៉ិល សុផល បាន បន្ថែម ថា ទីតាំង បទល្មើស ដែល នៅ សេសសល់ មិន ទាន់ ធ្វើ ការ បង្រ្កាប នៅសល់ ប្រមាណ ជាង ៤០ ទីតាំង ទៀត គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ស្រុក និង បន្ត បង្រ្កាប ឲ្យ អស់ នៅឡូតិ៍ អភិរក្ស លេខ ២ស្ថិត ក្នុង ភូមិ ព្រែក ទាល់ ឃុំ កោះ ជីវាំង ស្រុក ភ្នំ ខេត្ត បាត់ដំបង ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ២៧៨ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១២.៧៤៩ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១០.៩៨៥ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៧៦៤ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង បើក រក្រោម សារធាតុ ញៀន កែច្នៃ អត់ បណ្ណ បើក រ ស្លាកលេខ និង ល្មើស ភ្លើង - ផ្លាក សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ស្រវឹង អត់ បណ្ណ បើកបរ ឆៀក ល្មើស ភ្លើង - ផ្លាក សញ្ញា និង ល្មើស ល្បឿន ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១២លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៥ នាក់ របួស ចំនួន ១៣នាក់ ( របួស ធ្ងន់ ចំនួន ១១នាក់ ) ។ រយៈពេល ២៧ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៣៧៣ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១៤០ នាក់ របួស ៤០០ នាក់ ( របួស ធ្ងន់ ២១៩ នាក់ )៕
ស្នងការ រាជធានី ភ្នំពេញ៖ ករណី រថយន្ដ Hummer បុក មនុស្ស ស្លាប់ ២នាក់ នៅ ខណ្ឌ ដូនពេញ សមត្ថកិច្ច រកឃើញ រថយន្ដ ហើយ និង បញ្ជា ឲ្យ ស្រាវជ្រាវ បន្ដ ទៀត ដើម្បី ស្វែងរក អ្នកបើកបរ មក ផ្ដន្ទាទោស តាម ច្បាប់
( ភ្នំពេញ ) ៖ ករណី រថយន្ដ Hammer បុក មនុស្ស ស្លាប់ ២នាក់ នៅ ខណ្ឌ ដូនពេញ កាលពី ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០២៣ កន្លងទៅ នេះ រថយន្ដ ត្រូវបាន សមត្ថកិច្ច រកឃើញ ហើយ នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ និង កំពុង ស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ បន្ដ ទៀត ដើម្បី ស្វែងរក ចាប់ខ្លួនអ្នកបើកបរ មក ផ្ដន្ទាទោស តាម ផ្លូវ ច្បាប់ ។
បើ ទោះបី វិធានការ ច្បាប់ ម៉ឺងម៉ាត់ ក៏ ពិត មែន ប៉ុន្ដែ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ ក៏ បាន ផ្ញើ សារ អំពាវនាវ ដល់ ជន បង្ក ដែល បើក រថយន្ដ បុក មនុស្ស ស្លាប់ ពីរ នេះ ឲ្យ ចូល ខ្លួន មក សារភាព និង ទទួលស្គាល់ កំហុស នៅ ចំពោះមុខ សមត្ថកិច្ច ខណៈ សមត្ថកិច្ច របស់ លោក នឹង មិន ដក ដៃ រាថយ ឡើយ ក្នុង ប្រតិបត្តិការ យ៉ាង ស្រាវជ្រាវ ស្វែង ចាប់ខ្លួន ឲ្យ ខាងតែ បាន ។
សូម ជម្រាប ថា នៅ យប់ រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ មួយ កើតឡើង រវាង រថយន្ត និង ម៉ូតូ ហើយ រថយន្ដ បើក គេចខ្លួន បាត់ នៅ ចំណុច ទល់មុខ ផ្ទះ លេខ 53E ផ្លូព្រះសុី សុវត្ថិ ស្ថិត នៅក្នុង សង្កាត់ ស្រះចក ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ។
អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន លើកឡើង ថា ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ទប់ស្កាត់ ព័ត៌មាន ក្លែងក្លាយ
( ភ្នំពេញ ) ៖ សព្វ ថ្ងៃ ការរីកចម្រើន ខាង ផ្នែក បច្ចេកវិទ្យា បាន បង្ក ភាពងាយស្រួល ដល់ ការប្រាស្រ័យទាក់ទង គ្នា និង ទទួលបាន នូវ ព័ត៌មាន នានា ជាពិសេស តាមរយៈ មធ្យោបាយ ប្រព័ន្ធ ផ្សព្វផ្សាយ ទំនើប រាប់បញ្ចូល ទាំង ការផ្សព្វផ្សាយ លើ ប្រព័ន្ធ អុីនធ័រណែត និង បណ្តាញ សង្គម គ្រប់ ប្រភេទ ដែល បាន រីកដុះដាល ឡើង យ៉ាង ខ្លាំង ។
លោក ទេព អស្នារិទ្ធ បាន ផ្តល់ អនុសាសន៍ ដើម្បី ទប់ស្កាត់ ការរីកសាយភាយ នូវ ព័ត៌មាន ក្លែងក្លាយ ដោយ ប្រជាពលរដ្ឋ អាច អនុវត្ត នូវ វិធាន សំខាន់ មួយចំនួន ដូច ជា៖
២៖ សូម ពិចារណា ឲ្យបាន ច្បាស់ជាមុន សិន ថា តើ គួរ ចែករំលែក ព័ត៌មាន នោះ ទៅ អ្នកដទៃ ដែរ ឬ ទេ ហើយ ការចែករំលែក នោះ នឹង ផ្តល់ ផលប្រយោជន៍ ឬ អាច បង្ក ផលវិបាក ដល់ សង្គម គ្រួសារ និង ជាតិ ?
៣៖ ប្រសិនបើ មាន ភាពសង្ស័យ មន្ទិល ក្នុង ចិត្ត លើ ភាពសុក្រិត ភាពពិត នៃ ព័ត៌មាន ណាមួយ សូម កុំ ចែករំលែក បន្ត និង គួរ ប្រកាន់ខ្ជាប់ នូវ ទម្លាប់ ផ្ទៀងផ្ទាត់ ព័ត៌មាន ឲ្យ ច្បាស់ជាមុន សិន មុននឹង ចែក រំែលក ព័ត៌មាន នោះ បន្ត ។
អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន បាន ថ្លែង បន្ថែម ថា ក្រសួង ព័ត៌មាន នឹង រៀបចំ នូវ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ព័ត៌មាន ក្លែងក្លាយ Zero Fake News Campaign នៅពេល ខាងមុខ ក្រោម ការដឹកនាំ របស់ លោក នេត្រ ភក្ត្រា រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ដោយ ផ្តោត លើ ការផ្លាស់ប្តូរ ឥរិយាបថ របស់ ប្រជាជន និង លើកកម្ពស់ ចំណេះដឹង សាធារណៈ តាមរយៈ ការផ្សព្វផ្សាយ ដើម្បី បង្កើន ការយល់ដឹង របស់ ប្រជាពលរដ្ឋ អំពី ផលវិបាក នៃ ព័ត៌មាន ក្លែងក្លាយ ក៏ ដូចជា វិធានការ នានា ក្នុង ការទប់ស្កាត់ ការសាយភាយ នៃ ព័ត៌មាន ក្លែងក្លាយ នេះ ។
គណៈកម្មាធិការ កិច្ចការ បរទេស នៃ សភា តួកគី អនុម័ត លើ ពាក្យ ស្នើសុំ ចូល ជា សមាជិក អង្គការ NATO របស់ ប្រទេស ស៊ុយអែត
ស៊ុយអែត និង ហ្វាំងឡង់ បាន បោះបង់ ចោល នយោបាយ អព្យាក្រឹតភាព របស់ ខ្លួន ដែល មិន ចូល បក្ស សម្ព័ន្ធ យោធា ជាច្រើន ទសវត្សរ៍ ហើយ បាន ព្យាយាម ចូល ជា សមាជិក អង្គការ យោធា ដែល ដឹកនាំ ដោយ សហរដ្ឋ អាមេរិក បន្ទាប់ពី ការលុកលុយ របស់ រុស្ស៊ី លើ អ៊ុយក្រែន ក្នុង ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
សំណើ របស់ ពួកគេ បាន ទទួល ការយល់ព្រម ភ្លាម ៗ ពី សមាជិក ណា តូ ទាំងអស់ លើកលែងតែ តួកគី និង ហុង គ្រី ខណៈ ដែល ការសម្រេចចិត្ត នេះ ត្រូវ ធ្វើឡើង ជា ឯកច្ឆ័ន្ទ ។ ប្រទេស ទាំង ពីរ នៅ ទីបំផុត បាន ប្រែចិត្ត ហើយ ហ្វាំងឡង់ ត្រូវបាន ទទួលស្គាល់ ជា សមាជិក ទី ៣១ របស់ ណា តូក្នុង ខែមេសា ។ ចំណែក ស៊ុយអែត វិញ ១៩ ខែ បន្ទាប់ពី បាន ដាក់ពាក្យ សុំ ចូលរួម ជា សមាជិក នៅ មិន ទាន់ បាន ទទួល ការអនុម័ត នៅឡើយ ទេ ។
ទោះជា យ៉ាងណា កាលពី ថ្ងៃអង្គារ សប្តាហ៍ នេះ គណៈកម្មាធិការ កិច្ចការ បរទេស របស់ សភា តួកគី បាន អនុម័ត វិធានការ នេះ ។
រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ អញ្ជើញ បន្ត ជួប សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ និង មន្រ្ដី រាជការ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត រតនគិរី និង ខេត្ត ស្ទឹងត្រែង
( ស្ទឹងត្រែង ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នា ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ បាន ជួប សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ និង មន្រ្ដី រាជការ នៃ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត រតនគិរី និង ខេត្ត ស្ទឹងត្រែង ដែល មាន មន្រ្ដី ចូលរួម សរុប ចំនួន ៥៥ នាក់ ។
បន្ទាប់ពី បាន ស្តាប់ របាយការណ៍ ប្រចាំ ឆ្នាំ ២០២៣ និង ទិសដៅ ការងារ ឆ្នាំ ២០២៤ ពីសំណាក់ លោក ប្រធាន មន្ទី រួច មក លោក រដ្ឋមន្ត្រី បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ទាំងអស់ នៃ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត រតនគិរី និង ខេត្ត ស្ទឹងត្រែង ដែល ចូលរួម សម្រេចបាន លទ្ធផល ល្អ នា ពេល កន្លងមក ។
លោក រដ្ឋមន្រ្ដី បាន បន្ត ផ្ដាំផ្ញើ ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ទាំង ពីរ ដូច ខាងក្រោម៖
៦ - ត្រូវ មាន សាមគ្គីភាព ផ្ទៃក្នុង ឱ្យ បាន ល្អ មិន ប្រកាន់ បក្ខពួក យកចិត្តទុកដាក់ មន្ត្រីរាជការ មាន ពិការភាព មន្ដ្រីរាជការ ជាស្រ្ដី មាន ផ្ទៃពោះ ឬ មាន កូន តូច ជាដើម ៕ មន្រ្តី សហគមន៍៖ ប្រើ ស ទន្សោង ឈ្លូស ជ្រូក ព្រៃ ក្ងោក និង សត្វ ព្រៃ ជា ច្រើន ប្រភេទ ដែល នៅ សេសសល់ ក្នុង ព្រៃ សហគមន៍ ប្រាំបី ម៉ុម កំពុង រង ការវាយប្រហារ យ៉ាង ធ្ងន់ធ្ងរ និង ខ្វះ ប្រភព ទឹក សម្រាប់ ផឹក
( កំពង់ស្ពឺ ) ៖ ប្រជា សហគមន៍ ព្រៃឈើ ប្រាំបី ម៉ុម បាន អះអាង ថា សត្វ ព្រៃ មាន ប្រើ ស ទន្សោង ឈ្លូស ជ្រូក ព្រៃ ក្ងោក និង សត្វ ព្រៃ ជា ច្រើន ប្រភេទ ទៀត ដែល នៅ សេសសល់ ក្នុង ព្រៃ នេះ កំពុង រង ការវាយប្រហារ យ៉ាង ធ្ងន់ធ្ងរ ក្នុង ឆ្នាំ ២០២៣ នេះ អាច ប្រឈម ផុត ពូជ ប្រសិនបើ អាជ្ញាធរ សមត្ថកិច្ច ជំនាញ ពាក់ព័ន្ធ មិន មាន វិធានការ ទប់ស្កាត់ ឱ្យ បាន តឹងរ៉ឹង ទេ នោះ ។
លោក សឿន ឡាយ ប្រធាន សហគមន៍ ព្រៃឈើ ប្រាំបី ម៉ុម បាន ប្រាប់ ឱ្យដឹង នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ ថា អន្ទាក់ ត្រូវបាន គេ ដាក់ពង្រាយ ពាសពេញ ព្រៃ ហើយ កើនឡើង ទ្វេរ ដង ដែល បង្ក ជា ការគម្រាមគំហែង យ៉ាង ធ្ងន់ធ្ងរ ដល់ ជីវិត សត្វ កម្រ ទន្សោង ឈ្លូស ប្រើ ស ជ្រូក ព្រៃ ក្ងោក និង សត្វ ផ្សេង ទៀត ។
លោក បន្ត ថា កាលពី ឆ្នាំ ២០២២ អន្ទាក់ ដែល សហគមន៍ រកឃើញ មាន តែ ៤៤៤ អន្ទាក់ ប៉ុណ្ណោះ តែ នៅ ឆ្នាំ ២០២៣ នេះ គិត ត្រឹម ខែធ្នូ សហគមន៍ បាន រកឃើញ អន្ទាក់ ជិត ៩០០ អន្ទាក់ ដែល ចំនួន នេះ ហាក់ កើនឡើង ទ្វេរ ដង ។
ប្រធាន សហគមន៍ ព្រៃឈើ ប្រាំបី ម៉ុម បាន បន្ថែម ថា អន្ទាក់ ត្រូវបាន កម្លាំង សហគមន៍ រកឃើញ គេ ដាក់ពង្រាយ នៅ តាម ទីតាំង ដែល សម្បូរ ព្រៃ ក្រាស់ ៗ និង ចំការអំពៅ ដែល មាន ប្រភព ទឹក ។
លោក បន្ត ថា « ជាង នេះ សត្វ ដែល ងាយ រងគ្រោះ ធ្ងន់ធ្ងរ គឺ ពេល ដែល វា ចាកចេញ ពី ព្រៃ សហគមន៍ ដើម្បី ទៅ រក ទឹក ផឹក ព្រោះ នៅ ទីនោះ ក្រុម ព្រាន ព្រៃ តែងតែ ដាក់ពង្រាយ អន្ទាក់ ដើម្បី ប្រម៉ាញ់ និង ចាប់ សត្វ កម្រ ទាំង នេះ ។ ដោយ មើលឃើញ ពី ការប្រឈម នេះ ហើយ ទើប សហគមន៍ សម្រេច ស្នើសុំ ទៅ អាជ្ញាធរ ឱ្យ ជួយ ជីក ស្រះ មួយ កន្លែង ក្នុង ព្រៃ សហគមន៍ ដើម្បី រក្សាទុក ទឹក សម្រាប់ សត្វ ព្រៃ កម្រ ទាំង នេះ បាន ផឹក និង បញ្ជៀស ការយាយី ពី អ្នកប្រម៉ាញ់ ដ៏ សកម្ម គឺ អន្ទាក់ ព្រាន ព្រៃ » ។
ជុំវិញ ការស្នើសុំ របស់ សហគមន៍ ព្រៃឈើ ប្រាំបី ម៉ុម នេះ លោក ស៊ឹម រតនៈ អភិបាល រង ខេត្ត កំពង់ស្ពឺ បាន សម្រេច ទទួលយក សំណើ ហើយក៏ ប្រកាស រក ដៃគូរ ឯកជន ដែល អាច មាន លទ្ធភាព ក្នុង ការជីក ក្នុង នោះ ក្រុមហ៊ុន ឯកជន អាច យក អាច ម៌ ដី ទៅ ប្រើប្រាស់ តាម តម្រូវការ ដោយ ទុក មកវិញ ត្រឹមតែ ស្រះ ឱ្យ សហគមន៍ ដើម្បីឱ្យ សត្វ បាន ផឹក ប៉ុណ្ណោះ ។
សូម បញ្ជាក់ ថា សហគមន៍ ព្រៃឈើ ប្រាំបី ម៉ុម មាន ផ្ទៃដី ប្រមាណ ១២២១ ហិកតា ស្ថិត នៅក្នុង ភូមិ ថ្នល់ កែង និង ភូមិ ត្រពាំង ក្រើញ ឃុំ ប្រាំបី ម៉ុម ស្រុង ថ្ពង ខេត្ត កំពង់ស្ពឺ ៕
ស្នងការ ខេត្ត បន្ទាយមានជ័យ ប្រជុំ បូកសរុប លទ្ធផល ប្រចាំ ខែធ្នូ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ បន្ត ខែមករា ឆ្នាំ ២០២៤
( បន្ទាយមានជ័យ )៖ លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ប្រចាំ ខែធ្នូ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ បន្ត ខែមករា ឆ្នាំ ២០២៤ ដល់ កម្លាំង នគរបាល ទូទាំង ខេត្ត ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ប្រារព្ធ ធ្វើឡើង នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ដែល មាន ការអញ្ជើញ ចូលរួម ពី លោក លោកស្រី ឧត្តមសេនីយ៍ វរសេនីយ៍ ស្នងការ រង នាយ ការិយាល័យ ផែន ជំនាញ ទាំង ៣១ លោក អធិការ នគរបាល ក្រុង - ស្រុក ទាំង៩ លោក មេបញ្ជាការវរ : សេនា តូច នគរបាល ការពារ ព្រំដែន គោក ទាំង៤ លោក នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទាំង ៦៧ ។
លោក ឧត្តមសេនីយ៍ ត្រី រ៉ែ ម វីរ : ស្នងការ រង ផែនការងារ សេនាធិការ បាន ឡើង អាន របាយការណ៍ បូកសរុប លទ្ធផល ការងារ ដែល អនុវត្ត ខែ កន្លងមក និង ផ្សព្វផ្សាយ ផែនការ ខែមករា ឆ្នាំ ២០២៤ សម្រាប់ កងកម្លាំង អនុវត្ត បន្ត ។ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ លោក លោកស្រី គ្រប់ ផ្នែក ពាក់ព័ន្ធ រហូត បាន លទ្ធផល គួរ ជាទីមោទន : ។
( ព្រៃវែង ) ៖ ក្រោម ការចង្អុលបង្ហាញ ពី លោក ប៉េង ពោធិ៍នា រដ្ឋមន្រ្តី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ លោក សេង ឈួន រដ្ឋលេខាធិការ និង ជា ប្រធាន គណៈកម្មាធិការ សម្របសម្រួល អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ ដឹកនាំ ការត្រួតពិនិត្យ យានយន្ត ដឹកជញ្ជូន លើស ទម្ងន់ កម្រិត កំណត់ បាន ដឹកនាំ ក្រុមការងារ ចុះ ត្រួតពិនិត្យ យានយន្ត ដឹកជញ្ជូន លើស ទម្ងន់ កម្រិត កំណត់ នៅ ផ្លូវ លេខ ៣១០ គ.ម ០៥ ភូមិ ព្រែក ក្របៅ ឃុំ ព្រែក ក្របៅ ស្រុក ពាម ជ ខេត្ត ព្រៃវែង ។
ប្រតិបត្តិការ ខាងលើ ក្រុមការងារ បាន ត្រួតពិនិត្យ យានយន្ត សរុប ១៥ គ្រឿង ក្នុង នោះ រថយន្ត ដឹក លើស ទម្ងន់ ចំនួន៦ គ្រឿង ដឹក លើស ទម្ងន់ កម្រិត កំណត់ ចាប់ពី ៩- ២៧ តោន ដែល បាន ដឹក លើស ២០% នៃ ទម្ងន់ អនុញ្ញាត ត្រូវបាន ពិន័យ និង ឃាត់ទុក រយៈពេល ១ឆ្នាំ ។
ក្រសួង សូម រំលឹក ជូន ដល់ ម្ចាស់ ក្រុមហ៊ុន ដឹកជញ្ជូន ម្ចាស់ រថយន្ត ធុន ធ្ងន់ និង អ្នកបើកបរ រថយន្ត ធុន ធ្ងន់ ទាំង ជាថ្មី ម្តង ទៀត ថា៖ ក្រសួង នឹង បន្ត ចាត់ វិធានការរឹតបន្តឹង ការអនុវត្ត ច្បាប់ និង សេចក្ដីជូនដំណឹង ខាងលើ យ៉ាង តឹង បំផុត ដោយ គ្មាន ការលើកលែង ឡើយ ៕
សាលា រាជធានី ភ្នំពេញ ជូនដំណឹង ពី ការបញ្ចៀស ចរាចរ ក្នុង ពេល ប្រារព្ធ ពិធី ខួប លើក ទី២៥ នៃ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល នៅ កម្ពុជា និង ការអនុវត្ត នយោបាយ ឈ្នះ - ឈ្នះ និង ខួប ៥ឆ្នាំ នៃ ការកសាង វិមាន ឈ្នះ - ឈ្នះ
( ភ្នំពេញ ) ៖ សាលា រាជធានី ភ្នំពេញ នា ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការបញ្ចៀស ចរាចរ យានយន្ត គ្រប់ ប្រភេទ ជា បណ្ដោះអាសន្ន លើ កំណាត់ មហាវិធី ឈ្នះ ឈ្នះ ចាប់ពី គល់ ស្ពាន ព្រែក ព្នៅ រហូតដល់ ផ្លូវ ជាតិ លេខ ៦អា ក្នុង ពេល ប្រារព្ធ ពិធី រំឭក ខួប អនុស្សាវរីយ៍ លើក ទី២៥ នៃ ការបញ្ចប់ សង្គ្រាម ស៊ីវិល នៅ កម្ពុជា និង ការអនុវត្ត ប្រកបដោយ ជោគជ័យ នូវ នយោបាយ ឈ្នះ - ឈ្នះ និង ខួប ៥ឆ្នាំ នៃ ការកសាង វិមាន ឈ្នះ - ឈ្នះ ។
ពិធី នេះ នឹង ប្រារព្ធ ឡើង ចាប់ពី ថ្ងៃទី ២៩ - ៣១ ខែធ្នូ ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត នៅ បរិវេណ វិមាន ឈ្នះ - ឈ្នះ ស្ថិត នៅ ភូមិ ព្រែក តា សេក សង្កាត់ ព្រែក តា សេក ខណ្ឌ ជ្រោយ ចង្វា ៕ កូរ៉េ ខាងត្បូង ប្រកាស ពី ការចុះ កិច្ចសន្យា ដើម្បី ទិញ យន្តហោះ ចម្បាំង F-35 ២០ គ្រឿង បន្ថែម ទៀត ពី សហរដ្ឋ អាមេរិក
( សេអ៊ូល ) ៖ នៅ ថ្ងៃពុធ នេះ កូរ៉េ ខាងត្បូង បាន ប្រកាស ឱ្យដឹង ថា ក្នុង ខែធ្នូ នេះ ខ្លួន បាន ចុះហត្ថលេខា ជា ផ្លូវការ ជាមួយ រដ្ឋាភិបាល អាមេរិក ដើម្បី ទិញ យន្តហោះ ចម្បាំង F-35A ចំនួន ២០ គ្រឿង បន្ថែម ទៀត ចំពោះ មុខ កិច្ចប្រឹងប្រែង បង្កើន សមត្ថភាព យោធា ដើម្បី ទប់ទល់ នឹង ការគំរាមកំហែង ផ្នែក យោធា ពីសំណាក់ ប្រទេស ជិតខាង ខ្លួន គឺ កូរ៉េ ខាងជើង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Xinhua នា ថ្ងៃពុធ ទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ ។
បច្ចុប្បន្ន កងទ័ព អាកាស កូរ៉េ ខាងត្បូង មាន យន្តហោះ ចម្បាំង F-35A ចំនួន ៣៩ គ្រឿង ក្រោយ ការទិញ ៤០ គ្រឿង កាលពី ចន្លោះ ឆ្នាំ ២០១៩ ដល់ ឆ្នាំ ២០២២ ។ យោធា កូរ៉េ ខាងត្បូង បាន សម្រេចចិត្ត ដាក់ ឱ្យ F-35A ១គ្រឿង ចូល និវត្តន៍ ក្នុង ខែ នេះ ក្រោយ វា បាន រង ការខូចខាត ធ្ងន់ធ្ងរ ដោយសារ ការប៉ះទង្គិច ជាមួយ ហ្វូង បក្សី កាលពី ឆ្នាំ មុន ។
ក្នុង ឱកាស នោះ ឧត្តមសេនីយ៍ សៀក សុជាតិ បាន ចុះ ពិនិត្យ អគារ សំណង់ ការិយាល័យ ច្រក ចេញ ចូល ដើម្បី ពន្លឿន ការសាងសង់ និង តម្លើង ម៉ាស៉ីន ប្រថាប់ ត្រា ខណៈ កាលពី ពេល កន្លងទៅ ស្ថានភាព នៅ ច្រកទ្វារ អន្ដរជាតិ ប៉ោយប៉ែត នេះ មាន ការកកស្ទះ នៅ ចំណុច ទីតាំង ប្រថាប់ ត្រា ហើយ លោក បាន សម្រេច ដាក់ ម៉ាស៉ី ន និង បន្ថែម បញ្ជរ សម្រាប់ ប្រថាប់ ត្រា សំដៅ សម្រួល ដល់ ការកកស្ទះ នេះ ។
បើ តាម ឧត្តមសេនីយ៍ សៀក សុជាតិ អគារ ការិយាល័យ ច្រក ចេញ ចូល បាន បំពាក់ ដាក់ ម៉ាស៊ីន ត្រជាក់ រួចរាល់ អស់ ហើយ នៅតែ បន្ថែម បំពាក់ ម៉ាស៊ីន បញ្ជរ ប្រថាប់ ត្រា ដើម្បីឲ្យបាន ដំណើ ការដាក់ ឲ្យ ប្រើប្រាស់ នៅ ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ឲ្យបាន រួចរាល់ ជា ស្ថាពរ ។ ក្នុង នោះ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ឆ្លងកាត់ ចេញ ចូល ឆ្លង ដែន តាម ច្រក ទ្វារ អន្តរជាតិ ប៉ោយប៉ែត មាន សេក្តី ត្រកអរ យ៉ាង ខ្លាំង ព្រោះ បាន កាត់បន្ថយ ការកកស្ទះ ។
ឆ្លៀត នៅក្នុង ឱកាស នោះ ឧត្តមសេនីយ៍ សៀក សុជាតិ ក៏ បាន សំណេះសំណាល និង លើកទឹកចិត្ត ផ្ដល់ ការគាំទ្រ ដល់ មន្ត្រី ជំនាញ គ្រប់ ស្ថាប័ន ច្រកទ្វារ ដែល បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ និង បាន បំពេញ ភារកិច្ច កសាង នូវ សំណង់ ការិយាល័យ ច្រកទ្វារ បន្ថែម ទៀត ក្រោម ការដឹកនាំ បង្ហាញ ពី លោក សន្ដិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ដ្រី និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ត្រួតពិនិត្យ និង ដោះស្រាយ បញ្ហា ដំណើរ ចេញ ចូល របស់ ពលករ ខ្មែរ តាម ព្រំដែន កម្ពុជា ។
គួរ ជម្រាប ថា គោលបំណង ដែល ប៉ុស្តិ៍ នគរបាល ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ប៉ោយប៉ែត សាងសង់ បញ្ជរ បន្ថែម គឺ ដើម្បី ពន្លឿន ការប្រថាប់ ត្រា ប័ណ្ណ ព្រំដែន ជូន ប្រជាពលរដ្ឋ ខ្មែរ ចេញ - ចូល ប្រទេស ឲ្យបាន ឆាប់ រហ័ស គ្មាន ការកកស្ទះ ជាពិសេស សម្រួល ដល់ ដំណើរ ចេញ - ចូល របស់ ជន ពិការ អ្នកជំងឺ ស្រ្តី មាន ផ្ទៃពោះ កុមារ ចាស់ជរា ព្រះសង្ឃ និង សិស្សានុសិស្ស ជាដើម ៕ ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៧ ខែធ្នូ៖ បង្ក្រាប ១៨ករណី ឃាត់ខ្លួន ៤០ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ មាន ចំនួន ១៨ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៤០ នាក់ ។
វិទ្យាស្ថាន ជាតិ បណ្តុះបណ្តាល បច្ចេកទេស នៃ ក្រសួង ការងារ ត្រៀមខ្លួន រួចរាល់ ដើម្បី បង្រៀន ជំនាញ វិជ្ជាជីវៈ ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ
( ភ្នំពេញ ) ៖ លោក យ៉ោក សុទ្ធី នាយក វិទ្យាស្ថាន ជាតិ បណ្តុះបណ្តាល បច្ចេកទេស នៅ ថ្ងៃទី ២៧ ធ្នូ ២០២៣ នេះ បាន លើកឡើង ថា វិទ្យាស្ថាន បាន ត្រៀម ខ្លួន រួច ជាស្រេច ក្នុង ការបើក ជា ផ្លូវការ វគ្គ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ នៅ ពាក់កណ្តាល ខែមករា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។
លោក បន្ថែម ថា៖ « ជំនាញ ទាំង នេះ ជា ជំនាញ អាទ្ធិភាព របស់ វិទ្យាស្ថាន ហើយ ជំនាញ ទាំងនេះ មើលឃើញ ថា មាន ភាពងាយស្រួល ទៅដល់ និស្សិត និង សក្ខាកាមរក ការងារ ធ្វើ ជាពិសេស នោះ ទទួលបាន ប្រាក់ កម្រៃ ច្រើន នៅ ពេល ដែល ពួកគេ បញ្ចប់ ការសិក្សា នៅ ទីនេះ ។ ការជ្រើសរើស ជំនាញ ទាំងនេះ ផ្អែក ទៅ តាម ពាក្យស្លោក របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្រ្តី គឺ រៀន ឱ្យ ចប់ ឱ្យ ចេះ ឱ្យ មាន ការងារ ធ្វើ » ។
លោក បន្ត ថា វិទ្យាស្ថាន ជាតិ បណ្តុះបណ្តាល បច្ចេកទេស នឹង បើក ថ្នាក់ ដំបូង ក្នុង ការបណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទៅដល់ សិស្ស ដែល មាន ចុះឈ្មោះ ចូលរៀន នៅ ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២៤ ខាងមុខ ។ វិទ្យាស្ថាន បាន រៀបចំ ទាំង សម្ភារៈ ថ្នាក់រៀន រោង ជាង បន្ទាប់ ពិសោធន៍ គ្រូបណ្តុះបណ្តាល ដែល ពោ ពេញ ទៅ ដោយ សមត្ថិភាព ផងដែរ ។
គូរ បញ្ជាក់ ផងដែរ ថា កាលពី ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ កន្លងទៅ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី បាន ដាក់ ឱ្យ អនុវត្តន៍ ជា ផ្លូវការ នូវ ការ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ទៅដល់ គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ ១.៥ លាន នាក់ ដែល ការបណ្តុះបណ្តាល នេះ មាន រយៈពេល ៤ខែ សិក្សា ដោយ ឥត គិត ថ្លៃ ដោយឡែក យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ នឹង ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ ចំនួន ២៨ ម៉ឺន រៀល រហូតដល់ រៀន ចប់ ផងដែរ ។
ទន្ទឹមនឹង នេះ លោក យ៉ោក សុទ្ធី បាន អំពាវនាវ ទៅដល់ យុវជន ដែល មិន ទាន់ ចុះឈ្មោះ ចូលរៀន ស្វែងយល់ អំពី ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ហើយ នាំគ្នា មក ចុះឈ្មោះ ចូលរៀន ឱ្យ បាន គ្រប់ ៗ គ្នា ៕ បទ វិភាគ៖ ហេតុ អ្វី បានជា សហគ្រាស អន្តរជាតិ ដ៏ ល្បី ឈ្មោះ មួយចំនួន បោះបង់ ចោល ឬ ពន្យារ ពេល ផែនការ បង្កើត រោងចក្រ នៅ អាមេរិក ?
ប្រព័ន្ធ សារព័ត៌មាន អាមេរិក បាន ផ្សាយ ដំណឹង ថា នៅ ថ្ងៃ បុណ្យ ណូអែល ឆ្នាំ នេះ តម្លៃ កាដូ បាន ឡើង ថ្លៃ ជា បន្តបន្ទាប់ ជនជាតិ អាមេរិក ចំនួន លើស ពី ១ភាគ៣ សម្រេចចិត្ត បោះបង់ ចោល ទំនៀមទំលាប់ ជូន កាដូ ។ ក្នុង ប្រតិកម្ម មួយ ចំនួន នេះ តើ ទីផ្សារ នឹង មាន ជម្រើស យ៉ាងណា ? ចម្លើយ គឺ ច្បាស់ ណាស់ ៕
អត្ថបទ និង រូបភាព ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន អភិបាល ខេត្ត ឧត្តរមានជ័យ ជូនដំណឹង ដល់ ពលរដ្ឋ ដែល មាន បំណង ធ្វើ ប័ណ្ណ ព្រំដែន កម្ពុជា - ថៃ អាច ធ្វើ នៅ តាម ក្រុង ស្រុក របស់ ខ្លួន ដោយ មិន ចាំបាច់ ឡើង មក ធ្វើ នៅ ច្រក ចេញ - ចូល តែ មួយ សាលា ខេត្ត នោះ ទេ
កាបញ្ជាក់ បែប នេះ របស់ លោក ប៉ែន កុសល្យ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម ក្នុង « ទិវា ជាតិ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស ១២ ធ្នូ ឆ្នាំ ២០២៣ » នៅ សាល ប្រជុំ ធំ សាលា ខេត្ត ឧត្តរមានជ័យ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ ដោយ មាន ការចូលរួម ពី លោក ស៊ី ប្រា សិទ្ធ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ថ្នាក់ដឹកនាំ ខេត្ត មន្ត្រីរាជការ តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ អាជ្ញាធរ ក្រុង ស្រុក លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង ស្ថាប័ន ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
លោក ប៉ែន កុសល្យ បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី បាន សម្រេច ដាក់ ឱ្យ អនុវត្ត សាកល្បង ការផ្តល់ សេវា បណ្ណ ព្រំដែន កម្ពុជា - ថៃ នៅ រដ្ឋបាល ក្រុង ស្រុក នៃ ខេត្ត ជាប់ ព្រំដែន ជាមួយ ប្រទេស ថៃ សម្រាប់ រយៈពេល ៦ខែ ដោយ គិត ចាប់ពី ថ្ងៃទី១ ខែមករា ឆ្នាំ ២០២៤ត ទៅ ។
ក្នុង រយៈពេល សាកល្បង នេះ អភិបាល ស្រុក ក្រុង នៃ ខេត្ត ជាប់ ព្រំដែន ជាមួយ ប្រទេស ថៃ ត្រូវបាន ធ្វើ ប្រតិភូកម្ម អំណាច ឱ្យ ក្នុង ការត្រួតពិនិត្យ សម្រេច និង ចុះហត្ថលេខា លើ បណ្ណ ព្រំដែន កម្ពុជា - ថៃ ជូន ប្រជាពលរដ្ឋ ដែល មាន លំនៅដ្ឋាន អចិន្ត្រៃយ៍ នៅក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ។
លោក ប៉ែន កុសល្យ ក៏ បាន ណែនាំ ដល់ អាជ្ញាធរ ក្រុង ស្រុក ទាំង៥ កុំ ព្រោះតែ ចង់បាន ប្រាក់ រង្វាន់ លើកទឹកចិត្ត ពី ការធ្វើ ប័ណ្ណ ព្រំដែន កម្ពុជា - ថៃ ទៅ ហៅ ប្រជាពលរដ្ឋ ស្រុក ខេត្ត ផ្សេង ឬ ធ្វើឱ្យ ប្រជាពលរដ្ឋ ស្រុក ខេត្ត ផ្សេង គឺ ត្រូវ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ដោយ ខ្លួន ឯង តែ អាច ដើរ ហៅ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ក្រុង ស្រុក របស់ ខ្លួន មក ធ្វើ បាន ។
ទាក់ទង នឹង ការរៀបចំ « ទិវា ជាតិ ប្រយុទ្ធ អំពើ ជួញដូរ មនុស្ស ១២ ធ្នូ ឆ្នាំ ២០២៣ » ដែល ប្រារព្វ ធ្វើ នា ពេលនេះ លោក ប៉ែន កុសល្យ បាន លើកឡើង ថា ក្នុង គោលបំណង ផ្សព្វផ្សាយ ការយល់ដឹង ឱ្យ កាន់តែ ទូលាយ អំពី កិច្ចខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស គ្រប់ ទំរង់ បង្កើតឡើង ដោយ ជនល្មើស ដែល មាន កល ល្បិច ពិស ពុល យ៉ាង សម្បូរបែប ប្រកបដោយ គ្រោះថ្នាក់ និង ធ្វើឱ្យ មនុស្ស ជាច្រើន ធ្លាក់ ចូល ក្នុង អន្ទាក់ នៃ អំពើ ជួញដូរ មនុស្ស ។
ទសវត្សរ៍ រុងរោចន៍ នៃ ប្រាជ្ញាចិន បង្កើន អនុភាព ដល់ ការសម្រេច សុបិន រួម របស់ មនុស្សជាតិ
( ប៉េកាំង ) ៖ ១០ឆ្នាំ កន្លងមក ដោយ រាប់ ចាប់ផ្តើម ពី ការចេញ ដំណើរ របស់ ប្រាជ្ញាចិន ស្តីពី កិច្ច កសាង សហគមន៍ ជោគ វាសនា រួម នៃ មនុស្សជាតិ ដែល បាន រំលេច នៅក្នុង ប្រសាសន៍ របស់ លោក Xi Jinping ប្រធាន រដ្ឋ ចិន កាលពី ថ្ងៃទី ២៣ ខែមីនា ឆ្នាំ ២០១៣ បាន និង កំពុង បោះជំហាន យ៉ាង ស្វាហាប់ ជ្រាត ចូល ទៅក្នុង ស្មារតី ថ្នាក់ដឹកនាំ ប្រទេស នៅក្នុង ពិភពលោក សម្រាប់ ជា គតិ នៅក្នុង ការចូលរួម ស្វែងរក ដំណោះស្រាយ បញ្ហា សកល ជូន ដល់ ពិភពលោក ។
ប្រាជ្ញាចិន នេះ បាន លេចចេញ ក្នុង ពេលវេលា ដ៏ សមស្រប បំផុត មួយ ដោយ បាន ជួយ ទប់ស្កាល់ នូវ រាល់ ហានិភ័យ នានា ដែល ពិភពលោក មាន ការព្រួយបារម្មណ៍ ពី ការធ្លាក់ ចូល ឡើងវិញ ទៅក្នុង សង្គ្រាម ត្រជាក់ ឬ លទ្ធភាព ទៅក្នុង យន្តការ ឯកតោ ភាគី និយម ឬ ការវិលត្រឡប់ មកវិញ នូវ ទម្រង់ អាណានិគម និយម ឬ អាណាព្យាបាល និយម ។
ជាក់ស្តែង ភាគី ចិន បាន និង កំពុង យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ចំពោះ សភាពការណ៍ ជុំវិញ ប្រទេស ស៊ីរី នា ពេល បច្ចុប្បន្ន ដើម្បី កាត់បន្ថយ ហានិភ័យ គ្រោះថ្នាក់ ក្នុង តំបន់ ហើយ ភាគី ចិន តែង អំពាវនាវ ឱ្យ ដោយ ជំរុញ ឱ្យ សហគមន៍ អន្តរជាតិ ពិសេស មហា អំណាច គួរ ដើរ តួនាទី ស្ថាបនា ក្នុង ការទប់ស្កាត់ មាន ការប៉ះទង្គិច កើតឡើង ហើយ លើកទឹកចិត្ត ដល់ គ្រប់ ភាគី ពាក់ព័ន្ធ រក្សា ភាពស្ងប់ស្ងាត់ និង ការអត់ធ្មត់ ជៀសវាង ចាត់ សកម្មភាព ណាមួយ ដែល មាន លទ្ធភាព ដែល នឹង ធ្វើឱ្យ សភាពការណ៍ កាន់តែ តានតឹង ។
ជា រួម ស្រប ពេល ដែល ប្រាជ្ញាចិន ស្តីពី កិច្ច កសាង សហគមន៍ ជោគវាសនា រួម នៃ មនុស្សជាតិ ឈានជើង ចូលក្នុង ទសវត្សរ៍ ថ្មី មួយ មនុស្សជាតិ ទាំងអស់ គ្នា យល់ កាន់តែ ស៊ីជម្រៅ ពី ប្រាជ្ញាចិន ដែល មាន សុបិន រួមគ្នា ដើម្បី កសាង ភាពជាដៃគូ ដែល ផ្តល់ កិច្ចសហប្រតិបត្តិការ ឈ្នះ - ឈ្នះ និង សម្រេច សេចក្តីប្រាថ្នា រួម នៃ ការអភិវឌ្ឍ សន្តិភាព វិបុលភាព សមភាព និង ភាពយុត្តិធម៌ រីក ដុះដាល នៅ ទូទាំង ពិភពលោក ៕
ដោយ បណ្ឌិត ជា មុនី ឫទ្ធិ សមាជិក គណៈប្រតិបត្តិ សមាគម មិត្តភាព កម្ពុជា - ចិន អគ្គិភ័យ ឆេះ តូប លក់ដូរ និង ផ្ទះ ពលរដ្ឋ នៅ ផ្សារ ក្រោម ក្នុង ក្រុង សៀមរាប បណ្តាលឱ្យ ស្លាប់ ស្រ្តី មាន ផ្ទៃពោះ ២ខែ និង កូនប្រុស អាយុ ៤ឆ្នាំ . សមត្ថកិច្ច ប្រើប្រាស់ ឡាន ទឹក ចំនួន ៦ឡាន ទើប រលត់ ទាំងស្រុង
( សៀមរាប ) ៖ ករណី អគ្គិភ័យ បាន ឆាបឆេះ តុបលក់ដូរ របស់ អាជីវក និង ផ្ទះ ប្រជាពលរដ្ឋ ខ្នង នៅ ផ្សារ ក្រោម ក្នុង ក្រុង សៀមរាប ខេត្ត សៀមរាប ឡើង នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ វេលា ម៉ោង ៤: ៥០ នាទី ព្រឹក ស្ថិត នៅ ចំណុច តូប លក់ដូរ មុខ ផ្សារ ក្រោម ( ចាស់ ) ស្ថិត ក្នុង ក្រុម ទី២ ភូមិ វិហារ ចិន សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
អគ្គិភ័យ នេះ ដែរ បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ២នាក់ គឺ ស្រ្តី ឈ្មោះ វ៉ឹក ឡាន អាយុ ២៧ ឆ្នាំ ( មាន ផ្ទៃពោះ ២ខែ ) មុខរបរ លក់ដូរ និង កូនប្រុស ឈ្មោះ ង៉ិក ឌី អាយុ ៤ឆ្នាំ ។
ក្នុង របាយការណ៍ ដដែល បាន បន្ត ថា ករណី អគ្គិភ័យ នេះ ដែរ សមត្ថកិច្ច បាន ប្រើប្រាស់ រថយន្ត ពន្លត់ អគ្គីភ័យ អស់ ចំនួន ៦ គ្រឿង ( រថយន្ត ស្នងការ ខេត្ត ចំនួន ០៣ គ្រឿង . រថយន្ត អជ្ញាធរ អប្សរា ចំនួន ០២ គ្រឿង . រថយន្ត បុរី ទេសចរណ៍ ចំនួន ០១ គ្រឿង ) ប្រេី ប្រាស់ ទឹក អស់ ចំនួន ៦ឡាន ។
ជាមួយ នេះ ដែរ លោក ប្រាក់ សោភ័ណ អភិបាល ខេត្ត សៀមរាប បាន អញ្ជើញ ចុះ ពិនិត្យ ផ្ទាល់ ទីតាំង កន្លែង កើត ហេតុ ភ្លាម ៗ ផងដែរ ៕ រដ្ឋមន្ត្រី នេត្រ ភក្ត្រា៖ មន្ទីរព័ត៌មាន ខេត្ត ដើរ តួនាទី សំខាន់ ឱ្យ គណៈ បញ្ជាការ ឯកភាព ខេត្ត អាច ក្តាប់ សភាពការណ៍ ឆ្លើយតប រាល់ ព័ត៌មាន ផ្សេង ៗ ដែល អវិជ្ជមាន និង បកស្រាយ ទាន់ ពេលវេលា
( ត្បូងឃ្មុំ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន លើកឡើង ថា មន្ទីរព័ត៌មាន ខេត្ត បាន ដើរ តួនាទី សំខាន់ ឱ្យ គណៈ បញ្ជាការ ឯកភាព ខេត្ត ក្នុង ការគ្រប់គ្រង ព័ត៌មាន ក្នុង ខេត្ត របស់ ខ្លួន ដើម្បី ក្តាប់ បាន សភាពការណ៍ ហើយ ឆ្លើយតប រាល់ ព័ត៌មាន ផ្សេង ៗ ដែល អវិជ្ជមាន ហើយ ធ្វើ ការបកស្រាយ ឱ្យ ទាន់ ពេលវេលា ដើម្បី គ្រប់គ្រង លើ សាធារណៈ មតិ ក្នុង ខេត្ត និង ជំនឿ ទុកចិត្ត របស់ ប្រជាពលរដ្ឋ ។
ការលើកឡើង បែប នេះ របស់ លោក រដ្ឋមន្ត្រី នេត្រ ភក្ត្រា បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នៃ មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ និង អ្នកសារព័ត៌មាន ដែល កំពុង អនុវត្ត ការងារ ក្នុង ខេត្ត នៅ ព្រឹក ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ នៅ មន្ទីរព័ត៌មាន ស្ថិត នៅក្នុង « តំបន់ រដ្ឋបាល ខេត្ត » ភូមិ និគម លើ ឃុំ ស្រទ្បប់ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន ណែនាំ ដល់ មន្ទីរព័ត៌មាន ត្រូវ មាន កិច្ចសហការ ល្អ ជាមួយ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ដើម្បី ធ្វើ ព័ត៌មាន ផ្សព្វផ្សាយ ជា កិច្ចសម្ភាសន៍ បទ យក ការណ៍ រូបភាព ផ្សេង ៗ របស់ មន្ទីរ អង្គភាព ចំណុះ ខេត្ត ដើម្បី ផ្សាយ បាន ទូលំទូលាយ ។ ទន្ទឹម នេះ ត្រូវ មាន កិច្ចសហការ ជាមួយ សមាគម អង្គភាព សារព័ត៌មាន នានា ដើម្បី បង្កើន ការផ្សព្វផ្សាយ ជូន ប្រជាពលរដ្ឋ បាន ជម្រាប ពី អ្វី ដែល កើត មាន ឡើង ក្នុង ខេត្ត ។
លោក នេត្រ ភក្ត្រា បាន ជម្រាប ជូន ពី ដំណើរការងារ ដែល ក្រសួង ព័ត៌មាន បាន ធ្វើ យ៉ាង សកម្ម ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ដោយ បាន ដាក់ចេញ ផែនការ កំណែទម្រង់ គោល នយោបាយ ការពង្រឹង រចនាសម្ព័ន្ធ ការកសាង ឯកសារ គតិយុត្ត នានា ការពង្រឹង ការគ្រប់គ្រង វិស័យ ព័ត៌មាន និង អ្នកសារព័ត៌មាន ឱ្យ មាន លក្ខណៈ ទំនើប និង មាន ភាព សកម្ម ជាង មុន ជាពិសេស រួមគ្នា ក្នុង ភាពប្រទាក់ ក្រឡា លើ ការផ្សព្វផ្សាយ ពី សកម្មភាព របស់ ថ្នាក់ដឹកនាំ ឱ្យ បាន ដឹង ដល់ មូលដ្ឋាន ឆ្ងាយ ៗ ក្រៅពី ទីប្រជុំជន ។
លោក រដ្ឋមន្ត្រី នេត្រ ភក្ត្រា បាន បញ្ជាក់ ថា ជា ជំហ៊ាន បន្ត ទៅ មុខ ទៀត បណ្ណ សម្គាល់ អ្នកសារព័ត៌មាន ត្រូវ ចេញ ដោយ ក្រសួង ព័ត៌មាន ហើយ នឹង មាន ភ្ជាប់ QR Code ថែម ទៀត ផងដែរ ដើម្បី បញ្ជាក់ ភាព ច្បាស់លាស់ របស់ បងប្អូន ជា អ្នកសារព័ត៌មាន ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្រ្តី នេត្រ ភក្រ្តា បាន អញ្ជើញ ពិនិត្យ ដំណើរការផ្សាយ វិទ្យុ ជាតិ ត្បូងឃ្មុំ និង ទូរទស្សន៍ របស់ មន្ទីរព័ត៌មាន ខេត្ត ត្បូងឃ្មុំ ដែល កំពុង ដំណើរការផ្សាយ ជារៀងរាល់ ថ្ងៃ នូវ ព័ត៌មាន ចំណេះដឹង ការកម្សាន្ត សប្បាយ ផ្សេង ៗ ។
