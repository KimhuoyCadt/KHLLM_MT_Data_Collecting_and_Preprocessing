( កំពង់ចាម ) ៖ លោក បណ្ឌិត កែរ រដ្ឋា រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ សិក្ខាបណ្តុះបណ្តាល ស្តីពី លក្ខខ័ណ្ឌ ប្រភេទ និង កម្រិត ពិការភាព សម្រាប់ ក្រុមប្រឹក្សា វាយតម្លៃ ពិការភាព ។ ពិធី នេះ ធ្វើឡើង នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ចាម
សមាសភាព ចូលរួម ជា គណៈធិបតី មាន លោក វេជ្ជ នេត អ៊ុន អគ្គ លេខាធិការ រង ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ . លោក វេជ្ជ គឹម សាវួន ប្រធាន នាយកដ្ឋាន មន្ទីរពេទ្យ . លោកស្រី ម៉ែន នារី សុជាតិ នាយក រង មន្ទីរពេទ្យ មិត្តភាព ចិន ព្រះកុសមៈ . លោក វេជ្ជ. ម៊ី មុនី បុរិន្ទ អនុប្រធាន មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ចាម ។
សិក្ខាកាម ចូលរួម មាន៖ លោក លោកស្រី សាស្រ្តាចារ្យ ថ្នាក់ដឹកនាំ នៃ មន្ទីរពេទ្យ ជាតិ នានា អនុប្រធាន មន្ទីរ និង មន្ត្រី សុខាភិបាល ទទួល ការងារ ពិការភាព ខេត្ត រតនគីរី ស្ទឹងត្រែង ក្រចេះ មណ្ឌលគីរី សៀមរាប តាកែវ ស្វាយរៀង ព្រៃវែង កំពង់ធំ ត្បូងឃ្មុំ ព្រះវិហារ ឧត្តរមានជ័យ និង កំពង់ចាម ។
សិក្ខាសាលា បណ្តុះបណ្តាល ស្តីពី លក្ខខ័ណ្ឌ ប្រភេទ និង កម្រិត ពិការភាព សម្រាប់ ក្រុមប្រឹក្សា វាយតម្លៃ ពិការ ភាព ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ដែល អង្គ សិក្ខាសាលា មាន មោទនភាព ក្រៃលែង ដោយ មាន លោក សាស្រ្តាចារ្យ ឡឹម តារា រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល តំណាង លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល បាន ចូលរួម ជា គណអធិបតី ក្នុង ពិធី បើក នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ ។
លោក ថា ច្បាប់ ស្តីពី កិច្ចការពារ និង លើកកម្ពស់ សិទ្ធិ ជន ពិការ របស់ ព្រះរាជាណាចក្រ កម្ពុជា ឆ្នាំ ២០០៩ បាន កំណត់ អំពី គោលដៅ សម្រាប់ ជន មាន ពិការភាព គឺ ការពារ សិទ្ធិ និង សេរីភាព ការពារ ផល ប្រយោជន៍ ទប់ស្កាត់ កាត់ ការរើសអើង និង ការស្តារ កាយ សម្បទា ចិត្ត សង្គម សតិ បញ្ញា វិជ្ជាជីវ : ដើម្បី ធានា លទ្ធភាព ការចូលរួម របស់ ជន មាន ពិការភាព ដោយ ស្មើភាព និង ពេញលេញ ក្នុង រាល់ សកម្មភាព សេដ្ឋកិច្ច សង្គម ។
លោក បណ្ឌិត បាន បន្ត ថា រាជ រដ្ឋាភិបាល កម្ពុជា អាណត្ដិ មុន ៗ និង អាណត្ដិ ទី ៧នេះ បាន និង កំពុង យកចិត្តទុកដាក់ ខ្ពស់ លើ ការអនុវត្ត គោល នយោបាយ គោលការណ៍ ជាតិ និង អន្តរជាតិ ដើម្បី ធានា ការ ទទួល បាន នូវ សេវា សុខភាព ប្រកបដោយ គុណភាព សុវត្ថិភាព និង សមធម៌ សម្រាប់ ប្រជាជន គ្រប់ រូប ទាំង បុរស ស្រ្តី ជន ងាយ រងគ្រោះ ជាពិសេស បងប្អូន ជន ពិការ សំដៅ បង្កើត បរិយាកាស សង្គម ប្រកបដោយ សុខ មាលភាព សុខដុមរម្ម នីយកម្ម ផលិតភាព និង វឌ្ឍនភាព ។
លោក បាន បន្ដ ទៀត ថា នា ពេល បច្ចុប្បន្ន អត្រា អ្នក លើស ឈាម ទឹកនោម ផ្អែម ជំងឺ គ្រោះថ្នាក់ សរសៃ ឈាម ក្នុង ខួរក្បាល របួស គ្រប់ ប្រភេទ …-ល - មាន ការកើនឡើង ជាលំដាប់ ។ បន្ទុក នៃ ជំងឺ ចំនួន ៩ ក្នុង ចំណោម បន្ទុក ជំងឺ ១០ប្រភេទ ដែល កើត ជាញឹកញាប់ ( លើកលែង ជំងឺ ផ្លូវចិត្ត ) ការព្យាបាល ពាក់ព័ន្ធ នឹង វិធីសាស្រ្ត សល្យសាស្រ្ត ឬ វះកាត់ គ្រប់ ឯកទេស និង គ្រប់ ទម្រង់ នឹង អាច កាត់បន្ថយ កម្រិត ពិការភាព របស់ អ្នកជំងឺ ។
សិក្ខាសាលា បណ្តុះបណ្តាល នា ពេលនេះ បាន ផ្តល់ ចំណេះដឹង ផ្លូវ ច្បាប់ និង ជំនាញ វិជ្ជាជីវៈ ហើយនិង ក្រមសីលធម៌ ដល់ វេជ្ជបណ្ឌិត នៃ ក្រុមការងារ បច្ចេកទេស សុខភាព ជន មាន ពិការភាព និង ក្រុមប្រឹក្សា វាយតម្លៃ ប្រភេទ និង កម្រិត ពិការភាព នៅ មន្ទីរពេទ្យ ជាតិ និង មន្ទីរពេទ្យ បង្អែក រាជធានី ខេត្ត ដើម្បី វាយតម្លៃ ប្រភេទ និង កម្រិត ពិការភាព ។
ទីក្រុង កៀវ ដំបូង ឡើយ បាន ទទួលស្គាល់ ថា នឹង មាន ការដោះដូរ ឈ្លើយ សឹក ជាមួយ រុស្ស៉ី កាលពី ថ្ងៃពុធ ប៉ុន្តែ ប៉ុន្មាន ម៉ោង ក្រោយ ហេតុការណ៍ ធ្លាក់ យន្តហោះ អ៊ុយក្រែន បាន និយាយ ថា ខ្លួន នៅ មិន មាន ព័ត៌មាន គួរឱ្យ ជឿ ទុកចិត្ត បាន ស្តីពី អ្នកដំណើរ នៅលើ យន្តហោះ នោះ ឡើយ ទេ ខណៈ ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី បាន អំពាវនាវ ឱ្យ មាន ការស៉ើប អង្កេត ជា អន្តរជាតិ ។
ក្រសួង ការពារ ជាតិ រុស្ស៉ី បាន និយាយ ថា យន្តហោះ យោធា ប្រភេទ IL-76 ដែល បាន ធ្លាក់ មាន ផ្ទុក ទាហាន អ៊ុយក្រែន ជា ឈ្លើយ សឹក ចំនួន ៦៥ នាក់ រួម ជាមួយ បុគ្គលិក និង អាកាសយានិក យន្តហោះ សរុប ៦នាក់ ព្រមទាំង ឆ្មាំ អម ដំណើរ អ្នកទោស ទាំងនោះ ចំនួន ៣នាក់ ។ យោង តាម ការអះអាង របស់ ក្រសួង ការពារ ជាតិ រុស្ស៉ី គឺ កងកម្លាំង អ៊ុយក្រែន ឈរជើង នៅ តំបន់ Kharkiv ក្បែរ ព្រំប្រទល់ បាន បាញ់ មីស៉ីល ២គ្រាប់ លើ យន្តហោះ យោធា ដឹកជញ្ជូន នោះ ហើយ បាន ចាត់ទុក ឧប្បត្តិហេតុ នោះ ថា ជា ទង្វើ ភេរវកម្ម ។
ទីភ្នាក់ងារ ចារកម្ម អ៊ុយក្រែន បាន និយាយ ថា ខ្លួន មិន ទាន់ មាន ព័ត៌មាន ដែល អាច ជឿជាក់ បាន ឬ គ្រប់ ជ្រុងជ្រោយ នៅឡើយ ទេ ស្តីពី មនុស្ស ដែល ជិះ នៅលើ យន្តហោះ រុស្ស៉ី នោះ ដូចជា ថា តើ ពួកគេ ជា អ្នកណា ខ្លះ និង មាន ចំនួន ប៉ុន្មាន នាក់ ឱ្យ ប្រាកដ ។ ចំណែក លោក ហ្សេលេន ស្គី គឺ មិន បាន ទទួលស្គាល់ ឬ បដិសេធ ការចោទប្រកាន់ របស់ ទីក្រុង មូស្គូ ឡើយ ប៉ុន្តែ លោក បាន សង្កត់ធ្ងន់ ថា រុស្ស៉ី កំពុងតែ ល លេង ជាមួយ ជីវិត ឈ្លើយ សឹក អ៊ុយក្រែន ក៏ ដូចជា ជាមួយ អារម្មណ៍ របស់ សាច់ញាតិ ពួកគេ និង សង្គម អ៊ុយក្រែន ទាំងមូល ។
( ភ្នំពេញ ) ៖ អគារ អគ្គ បញ្ជាការដ្ឋាន នៃ កងយោធពល ខេមរភូមិន្ទ ដែល ជា សំណង់ ប្រវត្តិសាស្ត្រ ថ្មី មួយ ទៀត របស់ ក្រសួង ការពារ ជាតិ និង អគ្គ បញ្ជាការដ្ឋាន នៃ កងយោធពល ខេមរភូមិន្ទ ត្រូវបាន រៀបចំ ពិធី បញ្ចុះ បឋម សីលា បើក ការដ្ឋាន សាងសង់ ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ ។ អគារ នេះ ស្ថិត នៅ បឹង តាមោក ( កប់ ស្រូវ ) ភូមិ ត្រពាំងពោធិ៍ សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ ថ្នាក់ដឹកនាំ អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ ព្រមទាំង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ជាច្រើន រូប ទៀត ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង៖ ក្រសួង សាធារណការ ផ្សព្វផ្សាយ ចំណេះដឹង មេរោគ អេដស៍ និង ជំងឺ អេស៍ ផល ប៉ះពាល់ គ្រឿងញៀន ដល់ មន្ត្រី បម្រើ ការ ក្នុង មន្ទីរ សាធារណការ ខេត្ដ កំពង់ស្ពឺ
( កំពង់ស្ពឺ )៖ គណៈកម្មាធិការ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ដឹកនាំ ដោយ លោក សេន ស៊ី ហ៊ត់ រដ្ឋលេខាធិការ និង ជា ប្រធាន លេខាធិការដ្ឋាន អេដស៍ និង គ្រឿងញៀន នៃ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន សហការ ជាមួយ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កំពង់ស្ពឺ នា ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ បាន រៀបចំ កម្មវិធី ផ្សព្វផ្សាយ អប់រំ មេរោគ អេដស៍ និង ជំងឺ អេដស៍ និង សកម្មភាព ចូលរួម យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ព្រមទាំង សុវត្ថិភាព ចរាចរណ៍ ជូន ដល់ មន្ត្រី ក្នុង អង្គភាព ប្រមាណ ជិត ១០០ នាក់ ។
លោក រដ្ឋលេខាធិការ បាន បន្ត ថា ការបង្ការ និង ទប់ស្កាត់ ការរាលដាល នៃ មេរោគ អេដស៍ ព្រមទាំង ការប្រយុទ្ធ ប្រឆាំង នឹង គ្រឿងញៀន ខុស ច្បាប់ ជា កាតព្វកិច្ច របស់ យើង គ្រប់ ៗ រូប ត្រូវ ចូលរួមចំណែក អប់រំ ផ្សព្វផ្សាយ បន្ត ជាប្រចាំ ដល់ ក្រុមគ្រួសារ បងប្អូន ប្រជាជន ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ និង យល់ កាន់តែ ច្បាស់ ពី ផល ប៉ះពាល់ ដែល បណ្ដាល មកពី ការប្រព្រឹត្ត អំពើ ទាំងនោះ ធ្វើឲ្យ មាន ការលំបាក ដល់ គ្រួសារ និង សង្គមជាតិ ទាំងមូល ផងដែរ ។
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហប្រតិបត្តិការ រវាង ភ្នាក់ងារ សន្ដិសុខ ឯកជន ជាមួយ កម្លាំង មាន សមត្ថកិច្ច ក្នុង ការចូលរួមចំណែក ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក អ៉ី សុខ ឃី អគ្គ ស្នងការ រង នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ នូវ ការវាយតម្លៃ ខ្ពស់ ចំពោះ ភ្នាក់ងារ សន្ដិសុខ ឯកជន ទាំងអស់ ដែល កន្លងមក តែងតែ មាន កិច្ចសហការ ល្អ ជាមួយ កម្លាំង មាន សមត្ថកិច្ច និង អាជ្ញាធរ មូលដ្ឋាន ដើម្បី ចូលរួមចំណែក ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព សាធារណៈ នៅក្នុង សង្គម នា ពេល បច្ចុប្បន្ន នេះ ។
ក្នុង កិច្ចប្រជុំ ដក ពិសោធន៍ ការងារ សន្ដិសុខ ឯកជន រវាង អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ និង ក្រុមហ៊ុន ផ្ដល់ សេវា សន្ដិសុខ ឯកជន សហគ្រាស គ្រឹះស្ថាន ប្រើប្រាស់ សន្ដិសុខ ឯកជន . លោក ឧត្តមសេនីយ៍ ឯក អ៉ី សុខ ឃី បាន គូសបញ្ជាក់ ថា ក្រុមហ៊ុន ផ្ដល់ សេវា សន្ដិសុខ ឯកជន និង សហគ្រាស គ្រឹះស្ថាន កន្លងទៅ បាន អនុវត្ត ត្រឹមត្រូវ តាម ការកំណត់ របស់ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ តែ ក្នុង នោះ ក៏ មាន មួយចំនួន នៅ ចន្លោះប្រហោង ផងដែរ ដែល ទាមទារ ឲ្យ មាន ការពិនិត្យ យកចិត្តទុកដាក់ បន្ដ ទៀត ។
ជាក់ស្ដែង សម្រាប់ កិច្ចប្រជុំ នៅ ពេល នេះ គឺ ធ្វើឡើង ដើម្បី ពង្រឹង និង បង្កើន កិច្ចសហប្រតិបត្តិការ ឲ្យ កាន់តែ រឹងមាំ ក្នុង ភាពជាដៃគូ និង ស្វែងយល់ ឲ្យ កាន់តែ ស៉ី ជម្រៅ នូវ ចំណុច ខ្លាំង និង ចំណុច ខ្សោយ ក្នុង ការអនុវត្ត ភារកិច្ច កាតព្វកិច្ច របស់ ក្រុមហ៊ុន ផ្ដល់ សេវា សន្ដិសុខ ឯកជន សហគ្រាស គ្រឹះស្ថាន ដែល បាន អនុវត្ត កន្លងមក និង ដើម្បី បង្កើន សមត្ថភាព បង្កើន កិច្ចសហការ ប្រកបដោយ ប្រសិទ្ធភាព ក្នុង ការចូលរួមចំណែក ថែរក្សា សន្ដិសុខ សង្គម ។ នេះ បើ តាម ការលើកឡើង របស់ លោក ឧត្តមសេនីយ៍ ឯក អគ្គ ស្នងការរង ។
ក្នុង ន័យ នេះ លោក ឧត្តមសេនីយ៍ ឯក អ៉ី សុខ ឃី បាន ណែនាំឲ្យ បណ្ដា ក្រុមហ៊ុន និង សហគ្រាស គ្រឹះស្ថាន បន្ដ យកចិត្តទុកដាក់ ពិនិត្យ ឲ្យបាន ម៉ត់ចត់ ក្នុង ការជ្រើសរើស ភ្នាក់ងារ ជៀសវាង សមាសភាព មិន ល្អ សន្តិសុខ ឲ្យ ស្រប ទៅតាម លក្ខខណ្ឌ ជ្រៀត ចូល ជា ភ្នាក់ងារ សន្តិសុខ ឯកជន ។ ចំពោះ មន្ត្រី នគរបាល ដែល ចូលនិវត្តន៍ ហើយ នៅ មាន សុខភាព ល្អ រឹងមាំ និង មាន បំណង ចង់ ចូល ធ្វើការ ជាមួយ សន្តិសុខ ឯកជន គួរតែ លើកទឹកចិត្ត ។
បន្ថែម ពី នេះ ត្រូវ បន្ដ លើកកម្ពស់ និង គាំទ្រ ការបណ្តុះបណ្តាល បំប៉ន ជំនាញ សន្តិសុខ ឯកជន ដោយ ចាត់ បញ្ជូន ប្រធាន តំបន់ ឬ អ្នកគ្រប់គ្រង និង កម្លាំង ភ្នាក់ងារ មក ទទួល ការបណ្ដុះបណ្តាល បំប៉ន ជំនាញ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ដែល មាន នាយកដ្ឋាន គ្រប់គ្រង សន្តិសុខ ឯកជន ជា សេនាធិការ និង បន្ត ចូលរួម កិច្ចការពារ សន្តិសុខ សុវត្ថិភាព សណ្ដាប់ធ្នាប់ នូវ រាល់ ព្រឹត្តិការណ៍ ជាតិ អន្តរជាតិ តាម សំណើ និង សំណូម របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
លោក បាន ជំរុញ ឲ្យ បន្ត ចូលរួម សហការ ជាមួយ សមត្ថកិច្ច ក្នុង ការបង្ការ ទប់ស្កាត់ បទល្មើស ផ្សេង ៗ ដូចជា ការប្រើប្រាស់ អាវុធ ខុស ច្បាប់ . ការជួញដូរ ឬ ប្រើប្រាស់ គ្រឿងញៀន . ចោរកម្ម . ការចាប់ ជំរិត ជាដើម និង បន្ដ ចូលរួម សកម្មភាព ក្នុង ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព របស់ រាជ រដ្ឋាភិបាល ។
ដោយឡែក សម្រាប់ ការបណ្ដុះបណ្ដាល បំប៉ន ជំនាញ ភ្នាក់ងារ សន្ដិសុខ ឯកជន វិញ លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី បាន គូសបញ្ជាក់ ថា បច្ចុប្បន្ន នេះ ការបើក វគ្គ បំប៉ន ជំនាញ ភ្នាក់ងារ សន្តិសុខ ឯកជន សរុប ចំនួន ៥៦ វគ្គ សិក្ខាកាម ចូលរួម សរុប ៩. ៨៦៦ នាក់ ( ស្រី ២៣០ នាក់ ) ក្នុង នោះ ភ្នាក់ងារ សន្តិសុខ ឯកជន សរុប ចំនួន ៩. ៦៣៨ នាក់ ( ស្រី ២១១ នាក់ ) និង នគរបាល ជាតិ សរុប ចំនួន ២២៨ នាក់ ( ស្រី ១៩ នាក់ )៕
ប្រតិភូ ខេត្ត រតនគិរី អញ្ជើញ សួរសុខទុក្ខ និង ជូនពរ ថ្នាក់ដឹកនាំ បក្ស និង ថ្នាក់ដឹកនាំ ខេត្ត កន្ទូម ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ វៀតណាម
( រតនគិរី ) ៖ ក្នុង ឱកាស នៃ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ វៀតណាម ដែល នឹង ឈានចូល មកដល់ នា ពេល ខាងមុខ នេះ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២៤ គណៈប្រតិភូ ខេត្ត រតនគិរី ដឹកនាំ ដោយ លោក ងិន ណែល អភិបាល រង ខេត្ត តំណាង លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត បាន អញ្ជើញ សួរសុខទុក្ខ និង ជូនពរ ថ្នាក់ដឹកនាំ លេខា បក្ស ថ្នាក់ដឹកនាំ ខេត្ត ព្រមទាំង ប្រជាជន ខេត្ត កន្ទូម នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
តមក នៅ ថ្ងៃ ដដែល នេះ គណៈប្រតិភូ ខេត្ត រតនគិរី ដឹកនាំ ដោយ លោក ងិន ណែល បាន អញ្ជើញ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ជូនពរ ឆ្នាំ ថ្មី ដល់ លោកស្រី អ៉ី ង៉ុក អនុប្រធាន គណៈកម្មាធិការ ប្រជាជន ខេត្ត កន្ទូម ផងដែរ ។ ក្នុង ជំនួប នេះ លោក ងិន ណែល បាន ប្រសិទ្ធ ពរ ជ័យ ជូន ដល់ លោកស្រី ព្រមទាំង ថ្នាក់ដឹកនាំ និង ប្រជាជន ខេត្ត កន្ទូម សូម មាន សុខភាព ល្អ ជ័យជម្នះ គ្រប់ ភារកិច្ច ។
យុទ្ធនាការ កាត់បន្ថយ ការប្រើប្រាស់ ប្លាស្ទិក មាន អ្នកចូលរួម ដោយ ផ្ទាល់ ជាង ៤លាន ៣សែន នាក់
( ភ្នំពេញ ) ៖ គិត ចាប់ពី ថ្ងៃទី ០១ កញ្ញា ឆ្នាំ ២០២៣ រហូតដល់ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ យុទ្ធនាការ នេះ មាន អ្នកចូលរួម ដោយ ផ្ទាល់ សរុប ចំនួន ជាង ៤លាន ៣សែន នាក់ ក្នុង នោះ រួម មាន លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស កម្មករ កម្មការ នី និង អ្នកចូលរួម ផ្សេង ៗ ទៀត នៅ ទូទាំង ប្រទេស កម្ពុជា ។
យុទ្ធនាការ កាត់បន្ថយ ការប្រើប្រាស់ ប្លាស្ទិក បាន ចាប់ផ្តើម ពី សកម្មភាព និង ការចូលរួម ចេញ ពី បេះដូង របស់ សិស្សានុសិស្ស នា ពេលនេះ គឺជា កត្តា សំខាន់ បំផុត ក្នុង ការគាំទ្រ ដល់ អាទិភាព និង យុទ្ធសាស្រ្ត ចក្រា វិស័យ បរិស្ថាន របស់ ក្រសួង បរិស្ថាន ដែល មាន មុំ ៣សំខាន់ គឺ ស្អាត បៃតង និង ចីរភាព ជាពិសេស យុទ្ធសាស្រ្ត មាន គោលដៅ សំខាន់ ធ្វើឱ្យ កម្ពុជា ដែល ជា ផ្ទះ យើង ទាំងអស់ គ្នា ស្អាត ។
ជាមួយគ្នា នេះ លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន បញ្ជាក់ ថា យុទ្ធនាការ ក្រោម ប្រធាន « ថ្ងៃ នេះ ខ្ញុំ មិន ប្រើ ប្លាស្ទិក ទេ » នេះ គឺជា ជំហាន ទី១ ហើយ ជំហាន ទី២ គឺ ការសំអាត បរិស្ថាន និង មាន ជំហាន ទី៣ បន្តបន្ទាប់ ទៀត គឺ ដែល ការដាក់ចេញ ក្នុង ការជំរុញ ការលើកកម្ពស់ បរិស្ថាន សោភ័ណភាព របស់ កម្ពុជា ឱ្យ ស្រស់បំព្រង គ្មាន ការបំពុល និង ឈាន ទៅ ការលប់ បំបាត់ សំរាម សំណល់ ប្លាស្ទិក បន្តិច ម្តង ៗ ឱ្យ អស់ ពី កម្ពុជា ក្នុង ពេល អនាគត ដ៏ ខ្លី ៕
លោក Majed Al Ansari បាន សរសេរ បន្ថែម ថា « ប្រសិនបើ របាយការណ៍ នេះ ត្រូវបាន រកឃើញ ថា ជា ការពិត នោះ លោក នាយក រដ្ឋមន្រ្តី អ៉ី ស្រាអែល អាច ត្រឹមតែ ទទួលបាន ការបង្អាក់ និង ធ្វើឲ្យ ខូច ដល់ ដំណើ ការកិច្ចសម្រុះសម្រួល ប៉ុណ្ណោះ សម្រាប់ ហេតុផល ដែល ទំនងជា ចង់ បម្រើ ដល់ អាជីព នយោបាយ របស់ លោក ជំនួស ឲ្យ ការផ្តល់ អាទិភាព ដល់ ការជួយសង្គ្រោះ អាយុជីវិត មនុស្ស ស្លូតត្រង់ រួមទាំង ចំណាប់ខ្មាំង អ៉ី ស្រាអែល ផងដែរ » ។
( ភ្នំពេញ ) ៖ ក្រសួង យុត្តិធម៌ បាន បង្ហាញ នូវ មធ្យោបាយ សម្រាប់ ប្រជាពលរដ្ឋ ទទួលបាន ព័ត៌មាន ពាក់ព័ន្ធ យុទ្ធនាការ ជំរុញ និង ពន្លឿន ការដោះស្រាយ រឿងក្ដី នៅ តាម តុលាការ និង យុទ្ធនាការ ត្រួតពិនិត្យ និង ដោះស្រាយ ភាព មិន ប្រក្រតី នៅ តាម តុលាការ ។
( ភ្នំពេញ ) ៖ សន្និបាត បូកសរុប ការងារ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ប្រចាំ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ឆ្នាំ ២០២៤ បាន បើក ធ្វើជា ផ្លូវការ ហើយ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី២៥ ខែមករា ឆ្នាំ ២០២៤ នេះ ក្រោម អធិបតីភាព លោក រដ្ឋមន្ដ្រី ឌិត ទីណា និង មាន ការចូលរួម ពី លោក លោកស្រី រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ និង ថ្នាក់ដឹកនាំ ព្រមទាំង មន្ដ្រីរាជការ ក្រោម ឱវាទ ក្រសួង ចំនួន ២៨០ រូប ។
នៅក្នុង រយៈពេល ៣ ថ្ងៃ ពោលគឺ ចាប់ពី ថ្ងៃទី ២៥ - ២៦ និង ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២៤ ថ្នាក់ដឹកនាំ ក្រសួង ដែល ទទួលខុសត្រូវ តាម អនុវិស័យ ទាំង៥ និង កម្មវិធី គោល នយោបាយ អាទិភាព ទី៥ និង ទី៦ របស់ រាជ រដ្ឋាភិបាល នឹង ធ្វើ បទបង្ហាញ ជូន ដល់ អង្គ សន្និបាត ដើម្បី ជជែក ពិភាក្សា ផ្ដល់ ធាតុ ចូល សម្រាប់ រៀបចំ ផែនការ យុទ្ធសាស្ត្រ អនុវត្ត សម្រាប់ ឆ្នាំ ២០២៤ ។
អង្គ សន្និបាត នឹង បិទ បញ្ចប់ នៅ រសៀល ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២៤ ក្រោម អធិបតីភាព សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នៅ ទីស្ដីការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ៕
( ភ្នំពេញ ) ៖ លោក ហេង សួរ រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃពុធ ទី២៤ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន ជួប ពិភាក្សា ការងារ ជាមួយនឹង លោកស្រី Orna Sagiv ឯក អគ្គ រដ្ឋទូត អ៊ីស្រាអែល ប្រចាំ នៅ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ទីស្តីការ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
សម្តេច តេជោ ហ៊ុន សែន ចេញ សេចក្តីសម្រេច តែងតាំង លោក អ៊ុក ពញ្ញា . លោក ភួង សោភា . លោកស្រី គង់ សុធីរី និង លោកស្រី លីម មុយ ឡេង ជា ទីប្រឹក្សា
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ៤នាក់ ស្លាប់ និង អ្នករបួស ១៦ នាក់ ។
សម្ដេច តេជោ ហ៊ុន សែន ចេញ សេចក្ដីសម្រេច ស្ដីពី ការកែសម្រួល ផ្ទេរ និង ចាត់តាំង ថ្នាក់ដឹកនាំ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ដ កំពង់ធំ . លោក ជា ចាន់តូ ជា ប្រធាន កិត្ដិយ ស និង លោក វង្សី វិស្សុត ជា ប្រធាន
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន សេចក្ដីសម្រេច ស្ដីពី ការកែសម្រួល ផ្ទេរ និង ចាត់តាំង ថ្នាក់ដឹកនាំ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ដ កំពង់ធំ ដោយ ចាត់តាំង លោក ជា ចាន់តូ ជា ប្រធាន កិត្ដិយ ស នៃ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ដ កំពង់ធំ និង លោក វង្សី វិស្សុត ផ្ទេរ ពី ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ឆ្នាំង មក ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ។
* លោក ថោង ខុន ពី ប្រធាន មក ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ។
* ចាត់តាំង លោក ម៉ៅ សុផាន់ ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ បន្ថែម លើ ភារកិច្ច ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ ។
* ចាត់តាំង លោក ថោ ជេដ្ឋា ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ។
* ចាត់តាំង អ្នក ឧកញ៉ា ទ្រី ភាព ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ នា រសៀល ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ និង បាន នាំយក អង្ករ និង គ្រឿង ឧបភោគ បរិភោគ ទៅ ឧបត្ថម្ភ ដល់ មជ្ឈមណ្ឌល ជាតិ ព្យាបាល និង ស្តារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន ដោយ ស្ម័គ្រចិត្ត និង ផ្អែក លើ សហគមន៍ ស្ថិត នៅ ឃុំ កែវ ផុស ស្រុក ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ ។
លោក គួច ចំរើន បាន ថ្លែង ថា សម្រាប់ ខេត្ត ព្រះសីហនុ បើ ពិនិត្យ ឃើញ មាន សារធាតុ ញៀន មាន មួយ ប្រមូល មួយ ចំពោះ អ្នក មាន សារធាតុ ញៀន ត្រូវតែ បញ្ជូន ទៅកាន់ មណ្ឌល កែប្រែ បន្សា សារធាតុ ញៀន ដែល មាន ទីតាំង ស្ថិត នៅក្នុង ឃុំ កែវ ផុស ស្រុក ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ បាន ជាសះស្បើយ ទើប ឲ្យ ធ្វើ សមាហរណកម្ម ទៅក្នុង សហគមន៍ វិញ ។
លោក បន្ដ ថា លោក ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត ត្រូវ ធ្វើ ការគ្រប់គ្រង នៅក្នុង មូលដ្ឋាន ដោយ ផ្ដើម ពី ការអនុវត្ត នៅពេល ដែល បាន ជួប បាន ឃើញ មិន ថា បុគ្គល នោះ មកពី កន្លែងណា ខេត្ត ណា នៅ ទីណា មាន ស្ថានភាព បែប ណា នោះ ទេ នៅពេល ពិនិត្យ ធ្វើតេស្ត មាន ឃើញ ផ្សារ ធាតុ ញៀន មាន នៅក្នុង ខ្លួន គឺ ត្រូវតែ យកមក មជ្ឈមណ្ឌល ជាតិ ព្យាបាល និង ស្ដារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន ។
លោក បន្ដ ថា នៅក្នុង ខេត្ត ព្រះសីហនុ គណៈ បញ្ជាការ ឯកភាព ខេត្ត បាន អនុវត្ត ព្រម ៗ គ្នា ក្នុង គ្រប់ កិច្ច ប្រតិបត្តិការ ដោយ ចាត់ វិធានការត្រួតពិនិត្យ រដ្ឋបាល ចំហរ តាម ដងផ្លូវ សាធារណៈ និង នៅក្នុង មូលដ្ឋាន ក្រោយ មាន ការអនុវត្ត រយៈពេល ៣ខែ ចុងក្រោយ នេះ កម្លាំង សមត្ថកិច្ច បាន រកឃើញ អ្នក ផ្ទុក សារធាតុ ញៀន នៅក្នុង ខ្លួន មាន រហូត ទៅដល់ ជាង ២០០ នាក់ ដែល បាន បញ្ជូន មក មជ្ឈមណ្ឌល ដើម្បី ធ្វើ ការបន្សាប ។
លោក ក៏ បាន បញ្ជាក់ បន្ថែម ថា ចំពោះ យុទ្ធនាការ នេះ គឺ មិន មាន ការដក ថយ នោះ ទេ បើ ទុកឲ្យ បងប្អូន មាន សារធាតុ ញៀន នៅក្នុង ខ្លួន រស់ នៅក្នុង សហគមន៍ គឺ អាច បន្ត ការប្រើប្រាស់ ពី បុគ្គល មួយ ទៅ បុគ្គល មួយ មក ប្រើប្រាស់ ជាមួយ ខ្លួន បង្ក ការ គ្រោះថ្នាក់ នៅក្នុង សហគមន៍ ។
លោក កែវ វាសនា ប្រធាន មជ្ឈមណ្ឌល បាន ឲ្យដឹង ថា បច្ចុប្បន្ន មាន ជនរងគ្រោះ ដែល កំពុង សម្រាក ព្យាបាល និង បន្សាប សារធាតុ ញៀន មាន ចំនួន ៦៧០ នាក់ ស្រី ៣៦ នាក់ ។
មជ្ឈមណ្ឌល ជាតិ ព្យាបាល និង ស្ដារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន ដោយ ស្ម័គ្រចិត្ត និង ផ្អែក លើ សហគមន៍ មាន កន្លែង បន្សាប និង ព្យាបាល ការងារ ស្ដារ នីតិសម្បទា និង បណ្ដុះបណ្ដាល ជីវៈ មាន ដូចជា កម្មវិធី អប់រំ ចិត្ត អប់រំ ចិត្តសាស្ត្រ លំហាត់ប្រាណ កីឡា ហត្ថកម្ម ពលកម្ម កសិកម្ម អប់រំ បំណិន ជីវិត រោង ជាង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ មុន ធ្វើ សមហរណកម្ម អ្នក ជាសះស្បើយ ទៅ គ្រួសារ និង សហគមន៍ វិញ ។
សូម ជម្រាប ថា អំណោយ ដែល ផ្ដល់ជូន មជ្ឈមណ្ឌល រួម មាន៖ អង្ករ ៣០តោន ទឹកត្រី ២០០ យួរ ទឹកស៊ី អ៉ីវ២០០ យួរ មី ២០០ កេស តូច ទឹក សុទ្ធ ២០០ យួរ ថវិកា ១០លាន រៀល ជា អំណោយ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ថវិកា សប្បុរសជន ចំនួន ៣ពាន់ ដុល្លារ ផងដែរ ៕
បណ្ឌិត អ៊ាង សុផល្លែ ត៖ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ត្រូវបាន បង្កើតឡើង សំដៅ ចូលរួម គាំទ្រ និង អនុវត្ត កម្មវិធី នយោបាយ ឱ្យ សម្រេច តាម ចក្ខុវិស័យ ឆ្នាំ ២០៥០
ការលើកឡើង បែប នេះ របស់ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ប្រគល់ ភារកិច្ចការងារ ដល់ ក្រុមការងារ ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ និង បើក កិច្ចប្រជុំ លើក ដំបូង របស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន បន្ត ថា ឈរ លើ មូលដ្ឋាន បទពិសោធន៍ និង សមិទ្ធផល ដែល សម្រេចបាន កន្លងមក នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ជា ប្រមុខ បាន ដាក់ចេញ នូវ កម្មវិធី នយោបាយ រាជ រដ្ឋាភិបាល សម្រាប់ នីតិកាល ទី៧ នៃ រដ្ឋសភា និង យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ ដើម្បី កំណើន ការងារ សមធម៌ ប្រសិទ្ធភាព និង ចីរភាព ដោយ កំណត់ យក អាទិភាព គន្លឹះ ចំនួន ៥ គឺ៖ « មនុស្ស ផ្លូវ ទឹក ភ្លើង និង បច្ចេកវិទ្យា » ។
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន ផ្លាស់ប្តូរ ទស្សនៈ រិះរក វិធី ច្នៃប្រឌិត ដើម្បី ពង្រឹង របៀបវារៈ អាស៊ាន ស្តីពី ទេសចរណ៍ ប្រកបដោយ ចីរភាព និង របៀប ប្រើប្រាស់ ជំនាញ និង បណ្តាញ ដើម្បី លើកកម្ពស់ និង អនុវត្ត ដោយ ប្រសិទ្ធភាព នូវ ការទទួលស្គាល់ ទៅ វិញ ទៅ មក សម្រាប់ វិជ្ជាជីវៈ ទេសចរណ៍ អាស៊ាន (MRA-TP) ។
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន ពិភាក្សា រក វិធី ដើម្បី បង្កើន គោលដៅ ទេសចរណ៍ អាស៊ាន បន្ថែម ទៀត ដល់ ទីផ្សារ ជប៉ុន ជាពិសេស បង្កើត ការយល់ដឹង ស្តីពី កិច្ច ខិតខំ ប្រឹងប្រែង ថ្នាក់ តំបន់ ស្តីពី ទេសចរណ៍ ប្រកបដោយ ចីរភាព ។ ភាគី ទាំង ពីរ ក៏ បាន ផ្លាស់ប្តូរ មតិ ស្តីពី កិច្ចសហការ នា ពេល ខាងមុខ ក្នុង ការចែករំលែក បទពិសោធន៍ និង ការអនុវត្ត ល្អ ៗ ក្នុង ការលើកកម្ពស់ ទេសចរណ៍ ដែល ទទួលខុសត្រូវ ផ្នែក បរិស្ថាន ផងដែរ ។
បណ្ឌិត កៅ គឹម ហួន ក៏ បាន ជួប ពិភាក្សា ការងារ ជាមួយ លោក សុខ សូកេន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ កម្ពុជា មុនពេល ពិធី បើក វេទិកា ទេសចរណ៍ អាស៊ាន ឆ្នាំ ២០២៤ ។
នៅក្នុង ឱកាស នោះ អគ្គ លេខាធិការ អាស៊ាន បាន អបអរសាទរ ចំពោះ លោក សុខ សូកេន ដែល ត្រូវបាន តែងតាំង ជា រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ នៅក្នុង អាណត្តិ ថ្មី របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
បណ្ឌិត កៅ គឹម ហួន បាន គូសបញ្ជាក់ ពី កំណើន គួរឲ្យ កត់សម្គាល់ នៃ វិស័យ ទេសចរណ៍ ហើយ ភាគី ទាំង ពីរ បាន ពិភាក្សា រក វិធី ដើម្បី ពង្រឹង និង រៀបចំ ទិសដៅ អនាគត នៃ កិច្ចសហប្រតិបត្តិការ ទេសចរណ៍ អាស៊ាន រួមទាំង ជាមួយ ប្រទេស ដៃ គូ សន្ទនា របស់ អាស៊ាន ផងដែរ ។
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន ផ្លាស់ប្តូរ ទស្សនៈ ស្តីពី ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ របស់ អាស៊ាន ក៏ ដូចជា អាទិភាព សម្រាប់ ការអនុវត្ត ផែនទី ចង្អុល ផ្លូវ សម្រាប់ ការបង្កើត ទេសចរណ៍ ប្រកបដោយ ចីរភាព ។ បណ្ឌិត កៅ គឺ មហួន បាន បញ្ជាក់ ឡើងវិញ នូវ ការគាំទ្រ របស់ លេខាធិការដ្ឋាន អាស៊ាន សម្រាប់ ការដឹកនាំ របស់ ប្រទេស ឡាវ ក្នុង ការបង្កើត ស្តង់ដារ អេកូ ទេសចរណ៍ អាស៊ាន ក្នុង ឆ្នាំ ២០២៤ ។
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន ផ្លាស់ប្តូរ ទស្សនៈ ស្តីពី វឌ្ឍនភាព នៃ ការអនុវត្ត ផែនការ យុទ្ធសាស្ត្រ ទេសចរណ៍ អាស៊ាន ឆ្នាំ ២០១៦ - ២០២៥ អាទិភាព នានា ក៏ ដូចជា ទិសដៅ នៃ ទេសចរណ៍ អាស៊ាន ។ អគ្គ លេខាធិការ អាស៊ាន បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ការផ្តោត លើ ការអនុវត្ត គំនិត ផ្តួចផ្តើម សំខាន់ ៗ ដើម្បី សម្រេចបាន ការអភិវឌ្ឍ ទេសចរណ៍ ដែល កាន់តែ មាន ចីរភាព និង ភាពធន់ ស្រប ពេល ដែល តំបន់ ស្វាគមន៍ អ្នកទេសចរ វិលត្រឡប់ មកវិញ កាន់តែ ច្រើន ។
នៅក្នុង ឱកាស នោះ អគ្គ លេខាធិការ អាស៊ាន បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ការអនុវត្ត ស្តង់ដារ ខ្ពស់ សម្រាប់ វិស័យ ទេសចរណ៍ ដោយ បង្ហាញ ពី គោលដៅ នានា តាមរយៈ ទីផ្សារ ដ៏ មាន ប្រសិទ្ធភាព និង ការវិនិយោគ លើ ការអប់រំ ដើម្បី រៀបចំ អនាគត ទេសចរណ៍ អាស៊ាន មួយ ប្រកបដោយ បរិយា ប័្នន និង មាន វិបុលភាព ។
នៅ ល្ងាច ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ បណ្ឌិត កៅ គឹម ហួន ក៏ បាន អញ្ជើញ ចូលរួម និង ថ្លែង សន្ទរកថា ក្នុង ពិធី បើក វេទិកា ទេសចរណ៍ អាស៊ាន ឆ្នាំ ២០២៤ ។
លោក អគ្គ លេខាធិការ អាស៊ាន បាន សង្កត់ធ្ងន់ ពី សារៈសំខាន់ ដើម្បីឲ្យ អាស៊ាន រក្សា នូវ វឌ្ឍនភាព ក្នុង ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ អាស៊ាន ។ លោក បណ្ឌិត ក៏ បាន គូសបញ្ជាក់ ថា ការអភិវឌ្ឍ ទេសចរណ៍ ប្រកបដោយ ចីរភាព គឺ សំខាន់ ណាស់ ក្នុង ការថែរក្សា និង អភិរក្ស បរិស្ថាន វប្បធម៌ និង បេតិកភណ្ឌ ក្នុង ស្រុក ក៏ ដូចជា ដើម្បី ជំរុញ កំណើន សេដ្ឋកិច្ច នៅក្នុង តំបន់ ផងដែរ ៕
អតីត សមាជិក ក្រុម ប្រឆាំង លោក ឡុង គឹម ឃន ហៅ « សូរ សមយុទ្ធ » ត្រូវបាន តែងតាំង ជា រដ្ឋលេខាធិការ ក្រសួង យុត្តិធម៌
ការតែងតាំង នេះ បាន ធ្វើឡើង តប តាម សំណើ ទូល ថ្វាយ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
លោក ឡុង គឹម ឃន អតីត សមាជិក គណៈកម្មាធិការ នាយក នៃ អតីត គណបក្ស សង្គ្រោះ ជាតិ កាលពី ថ្ងៃទី ០៣ ខែមករា បាន ផ្ញើ លិខិត គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ស្នើ សូម ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជនជា ជន កម្ពុជា ។
លោក លើកឡើង ថា ការ ដែល បាន បាន ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី លោក មាន ឱកាស បាន ចូលរួមចំណែក ក្នុង ការបម្រើ ជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា បន្ត ទៅ មុខ ទៀត ៕ ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ ណែនាំឱ្យ មន្ត្រី តុលាការ ត្រូវ ដោះស្រាយ បណ្តឹង សុំ កែ សំបុត្រ កំណើត ជាង ៦ ពាន់ សំណុំរឿង ឱ្យ ចប់ នៅ ដំណាច់ ខែមីនា ដោយ មិន ពាក់ព័ន្ធ នឹង ប្រយោជន៍
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ បាន ណែនាំ ទៅ ចៅក្រម នៅ តាម សាលាដំបូង ទាំងអស់ ត្រូវ ធ្វើ យ៉ាងណា ដោះស្រាយ លើ បណ្តឹង កែតម្រូវ អត្រានុកូលដ្ឋាន ( សំបុត្រ កំណើត ) របស់ ប្រជាលរដ្ឋ ជាង ៦ពាន់ សំណុំរឿង ឱ្យ ចប់ នៅ ដំណាច់ ខែមីនា ឆ្នាំ ២០២៤ និង មិន ត្រូវ ពាក់ព័ន្ធ នឹង ផលប្រយោជន៍ ជាដាច់ខាត ។
ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ បាន លើកឡើង យ៉ាង ដូច្នេះ ថា៖ « រឿង អត្រានុកូលដ្ឋាន នៅ ទូទាំង ប្រទេស យើង ប្រមូល បាន មាន ជាង ជាង ៦ពាន់ រឿង ដែល ស្មើនឹង ៩០ ភាគរយ នៃ រឿងក្តី រដ្ឋប្បវេណី ពេល ប្តឹង ហើយ ត្រូវ ដោះស្រាយ ឱ្យ លឿន អី ឡូវ ខ្ញុំ បាន សំណូមពរ យ៉ាង យូរ បំផុត ដំណាច់ ខែមីនា ត្រូវ ដោះស្រាយ សំណុំរឿង ៦ ពាន់ រឿង នេះ ចោល ។
ចំពោះ ករណី នេះ . រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ បាន ណែនាំ ដល់ មន្ត្រី យុត្តិធម៌ ត្រូវ ធ្វើ យ៉ាងណា ដោះស្រាយ ឱ្យ បាន ឆាប់ រហ័ស ដោយ ប្រកាន់ យក គោលការណ៍ ត្រឹមត្រូវ ឆាប់រហ័ស និង មិន ពាក់ព័ន្ធ ផលប្រយោជន៍ ។
ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ ក៏ បាន បញ្ជាក់ ថា ចំពោះ ដំណើរការពន្លឿន ការ ដោះស្រាយ បណ្តឹង កែ អត្រានុកូលដ្ឋាន នេះ គឺ មិន ត្រូវ ឆ្លៀត ឱកាស សម្រេច លើ ឯកសារ ណា ដែល ខុស ច្បាប់ នោះ ទេ ។ មាន ន័យ ថា អត្រានុកូលដ្ឋាន ណា ដែល ច្បាប់ អនុញ្ញាតឱ្យ កែ គឺ ត្រូវ កែ ឱ្យ ត្រឹមត្រូវ តាម ច្បាប់ ដោយឡែក ចំពោះ ចំណុច ណា ដែល ច្បាប់ ហាម មិន ឱ្យ កែ គឺ មិន ត្រូវ កែតម្រូវ ជាដាច់ខាត ។
ត្រង់ ចំណុច នេះ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ បាន បន្ថែម ថា ប្រសិនបើ មាន បញ្ហា អ្វី ត្រូវ បញ្ជាក់ បញ្ហា ដែល ជួបប្រទះ នេះ ឱ្យ ពិតប្រាកដ ជាពិសេស សូម កុំ ឱ្យ មាន លេច លឺ ឱ្យ សោះ រឿង បញ្ហា ផលប្រយោជន៍ បើ ទោះបី តិចតួច ក៏ដោយ ។
ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ ក៏ បាន អំពាវនាវ ដល់ ចៅក្រម ព្រះរាជអាជ្ញា និង មន្ត្រី យុត្តិធម៌ ទាំងអស់ ត្រូវ រួមគ្នា ធ្វើ ការងារ ឱ្យ មាន ការប្រែប្រួល ជា វិជ្ជមាន សម្រាប់ មុខមាត់ វិស័យ យុត្តិធម៌ ។ ចំពោះ ករណី នេះ គឺ គ្មាន នរណា ម្នាក់ អាច ធ្វើ ទៅ រួច ម្នាក់ឯង នោះ ទេ ហើយក៏ មិន មែន មាន ចៅក្រម មុខ ដែក ម្នាក់ ធ្វើ កិច្ចការងារ នេះ រួច នោះ ដែរ ៕ គួរឲ្យ សោកស្ដាយ ! សត្វ កន្ទាយ ក្បាល កង្កែប មួយ ក្បាល ជា សត្វ កម្រ ជិត ផុត ពូជ ត្រូវបាន គេ ប្រទះឃើញ ងាប់ នៅក្នុង ស្រុក សំបូរ ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ សត្វ កន្ទាយ ក្បាល កង្កែប មួយ ក្បាល វ័យ ជំទង់ ភេទ ញី មាន ទម្ងន់ ២៦ គីឡូក្រាម ហើយ នឹង មាន ពង នៅក្នុង ពោះ ថែម ទៀត ត្រូវបាន គេ ប្រទះឃើញ ងាប់ នៅ ចំណុច កោះអណ្ដែង ខ្ចី ឃុំ វឌ្ឍ នះ ស្រុក សំបូរ ខេត្ត ក្រចេះ កាលពី ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២៤ ។
តាម របាយការណ៍ ខណ្ឌ ជល ផល ក្រចេះ បញ្ជាក់ ថា តាម ការធ្វើ កោសល្យវិច្ច័យ របស់ មន្រ្តី ជំនាញ នៃ ខណ្ឌ រដ្ឋបាល ជលផល ក្រចេះ និង អង្គការ WCS បាន សន្និដ្ឋាន ថា សត្វ កន្ធាយ ក្បាល កង្កែប នេះ ងាប់ ដោយសារ ជាប់ សន្ទូច រនង ដោយ ឃើញ មាន ផ្លែ សន្ទូច ទាក់ ជាប់ នឹង ជើង របស់ វា ។
អង្គការ WCS ក៏ បាន បញ្ជាក់ បន្ថែម ថា ជាទូទៅ ផ្លែ សន្ទូច ដែល មិន បិត នុយ ងាយ ទាក់ ជាប់ សត្វ កន្ធាយ ក្បាល កង្កែប ដោយ ខ្លួន ព្រោះ សត្វ កន្ធាយ ប្រភេទ នេះ មាន លក្ខណៈ ទន់ ហើយ កន្ធាយ ក្បាល កង្កែប ត្រូវបាន ចាត់ ជា ប្រភេទ ងាយ រងគ្រោះ ដោយ អនុក្រឹត្យ លេខ ១២៣ អន ក្រ ដូចនេះ ការចាប់ និង ជួញដូរ ជា អំពើ រ ខុស ច្បាប់ ។
រដ្ឋបាល ជលផល និង អង្គការ WCS សូម អំពាវនាវ ដល់ បងប្អូន ប្រជានេសាទ និង បងប្អូន នៅ តាម មូលដ្ឋាន ចូលរួម ថែរក្សា ប្រភេទ នេះ ឲ្យបាន គង់វង្ស និង ចៀសវាង ការចាប់ និង ជួញដូរ ខុស ច្បាប់ ដែល ពុំ នោះ ទេ នឹង ត្រូវ ទទួលទោស តាម ច្បាប់ ជាធរមាន ៕
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន អញ្ជើញ ធ្វើ បទបង្ហាញ និង ការចែករំលែក បទពិសោធន៍ ពាក់ព័ន្ធ នឹង ប្រសិទ្ធភាព នៃ កិច្ចការ នាំពាក្យ ព័ត៌មាន និង សាធារណមតិ
( ភ្នំពេញ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន អញ្ជើញ ចូលរួម ជា វាគ្មិន នៅក្នុង សិក្ខាសាលា ស្តីពី « ប្រសិទ្ធភាព នៃ កិច្ចការ នាំពាក្យ ព័ត៌មាន និង សាធារណមតិ » រៀបចំឡើង ដោយ ក្រសួង យុត្តិធម៌ នៅ រសៀល ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ នា សាល មរតក តេជោ ។
បណ្ឌិត្យ សភា ភូមិន្ទ យុត្តិធម៌ កម្ពុជា ស្ថិត នៅ មហាវិថី ឈ្នះ ឈ្នះ ភូមិ ព្រែក តា រ័ត្ន សង្កាត់ ព្រែក តា សេក ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក សេង ឌីណា រដ្ឋលេខាធិការ ក្រសួង យុត្តិធម៍ ។
សិក្ខាសាលា ស្ដីពី « ប្រសិទ្ធភាព នៃ កិច្ចការ នាំពាក្យ ព័ត៌មាន និង សាធារណមតិ » ធ្វើឡើង សម្រាប់ អ្នកនាំពាក្យ និង មន្ត្រី ទទួលបន្ទុក ការងារ ព័ត៌មាន នៃ ក្រសួង យុត្តិធម៌ និង សាលា ជម្រះ ក្ដី គ្រប់ ជាន់ ថ្នាក់ ក្នុង គោលបំណង ដើម្បី បញ្ជ្រាប នូវ ការយល់ដឹង អំពី សារៈសំខាន់ នៃ ការងារ នាំ ពាក្យ ព័ត៌មាន និង សាធារណមតិ សំដៅ ចូលរួមចំណែក ក្នុង ការបង្កើន ប្រសិទ្ធភាព នៃ ការអនុវត្ត ការងារ ស្រប តាម ទិសដៅ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ និង វិធានការ គន្លឹះ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ។
លោក នេត្រ ភក្ត្រា បាន លើក ជា សំណួរ ថា តើ អ្នក ធ្លាប់ បាន ចោទសួរ ខ្លួន ឯង ទេ ថា ស្ថាប័ន អង្គភាព របស់ ខ្លួន បាន បំពេញ ការងារ យ៉ាង ច្រើន និង មាន សមិទ្ធផល យ៉ាង ច្រើន ប៉ុន្តែ ហេតុ អ្វី បានជា សាធារណជន ហាក់ដូចជា មិន ទទួលបាន ព័ត៌មាន ពី ស្ថាប័ន ខ្លួន និង ពេល ខ្លះ មាន ការយល់ ច្រឡំ ហើយ ពលរដ្ឋ ងាយ នឹង ជឿ ព័ត៌មាន បែប មូល បង្កាច់ ថែម ទៀត ?
ដូច្នេះ ការធ្វើ ទំនាក់ទំនង ជាមួយ ស្ថាប័ន សារព័ត៌មាន ដើម្បី ផ្សព្វផ្សាយ គឺជា រឿង ចាំបាច់ ហើយ ត្រូវ ចាំ ថា កុំ អោយ ព័ត៌មាន មិន ពិត ដឹក មុខ យើង ត្រូវ មាន ការបកស្រាយ ពន្យល់ បាន លឿន តាមរយៈ ប្រពន្ធ័ ផ្សព្វផ្សាយ ។ បើសិនជា យើង ធ្វើ ច្រើន ហើយ អត់ ផ្សាយ គឺ ស្មើ សូន្យ ។
លោក រដ្ឋមន្រ្តី បាន លើក នូវ គន្លឹះ សំខាន់ នៃ ទំនាក់ទំនង សាធារ ណៈ៖
១៖ ទំនាក់ទំនង ជាមួយ សហគមន៍ និង សាធារណជន ២៖ ទំនាក់ទំនង ជាមួយ ប្រព័ន្ធ ផ្សព្វផ្សាយ ព័ត៌មាន និង អ្នកសារព័ត៌មាន ហើយ ការធ្វើ ទំនាក់ទំនង គឺ ក្នុង គោលបំណង ដើម្បី ពង្រឹង និង ពង្រីក ការយល់ដឹង ពី គ្នា នៅ ទិញ នៅ មក កាត់បន្ថយ ការយល់ ច្រឡំ រវាង គ្នា និង បង្កើន សហប្រតបត្តិការ រវាង គ្នា រវាង ស្ថាប័ន និង មជ្ឈដ្ឋាន ខាងក្រៅ ។
លោក នេត្រ ភក្ត្រា បាន លើកឡើង ពី តួនាទី សំខាន់ របស់ មន្ត្រី នាំ ពាក្យ គឺជា អ្នក ដែល ធ្វើ ការប្រមូល ព័ត៌ ទាក់ទង នឹង ស្ថាប័ន ខ្លួន ដើម្បី ផ្សព្វផ្សាយ ទៅ សាធារណជន និង គ្រប់គ្រង សាធារណមតិ សម្រាប់ ស្ថាប័ន ខ្លួន ។ មន្ត្រី នាំ ពាក្យ ធ្វើ ការងារ ស្និទ្ធ នឹង ថ្នាក់ដឹកនាំ ស្ថាប័ន និង មន្ត្រី ទំនាក់ទំនង សាធារណៈ ដើម្បី បញ្ចេញ ព័ត៌មាន តាមរយៈ សេចក្តីប្រកាស ព័ត៌មាន សេចក្តីថ្លែងការណ៍ ធានា ថា សាធារណជន បាន ទទួល ព័ត៌មាន គ្រប់ ជ្រុងជ្រោយ និង ទាន់ ពេល វេលា ។
ឆ្លើយតប ទៅ សំណួរ ថា តើ មន្ត្រី នាំ ពាក្យ ត្រូវ មាន អព្យាក្រឹត្យភាព ដែរ ទេ ? លោក រដ្ឋមន្រ្តី បាន គូសបញ្ជាក់ ថា សម្រាប់ ស្ថាប័ន នៃ អំណាច នីតិបញ្ញាត្តិ ស្ថាប័ន នីតិប្រតិបត្តិ ក្រុមហ៊ុន ឬ អង្គភាព ផ្សេង ៗ អ្នកនាំពាក្យ ប្រើ តូនាទី ជា ឆ្មាំ ការពារ ស្ថាប័ន របស់ ខ្លួន ផ្តាច់ មុខ ។ សម្រាប់ ស្ថាប័ន តុលាការ អ្នកនាំពាក្យ គួរ ថ្លឹងថ្លែង គោលជំហរ មិន លំម្លៀង ចំពោះ ភាគី នៅក្នុង សំណុំរឿង ព្រោះ តុលាការ មាន គាគី ច្រើន និង ឆ្លើយតប នឹង គោលការណ៍ ស្មើភាព គ្នា នៅ ចំពោះ មុខ ច្បាប់ ។
ថ្លែង បើក សិក្ខាសាលា នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២៤ ឧប នាយក រដ្ឋមន្ត្រី កើត រិទ្ធ រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៍ បាន លើកឡើង ថា អ្នកនាំពាក្យ នៅ តាម សាលា ជម្រះ ក្តី ទូទាំង ប្រទេស ត្រូវបាន បង្កើតឡើង ចាប់តាំងពី ឆ្នាំ ២០១៦ ។ រហូតមកដល់ បច្ចុប្បន្ន ពុំ ធ្លាប់ មាន ការរៀបចំ សិក្ខាសាលា ឬ វគ្គ បណ្តុះបណ្ដាល ពង្រឹង សមត្ថភាព ពាក់ព័ន្ធ នឹង កិច្ចការ នាំពាក្យ ដល់ អ្នកនាំពាក្យ នៅ តាម សាលា ជម្រះ ក្តី នៅឡើយ នោះ ទេ ។
