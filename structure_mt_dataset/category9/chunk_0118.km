( ភ្នំពេញ ) ៖ តប តាម ការអញ្ជើញ របស់ លោក សាស្ត្រាចារ្យ ក្លាស ធ្លាប់ ស្ថាបនិក និង ជា ប្រធាន ប្រតិបត្តិ វេទិកា សេដ្ឋកិច្ច ពិភពលោក សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ចូលរួម កិច្ចប្រជុំ ប្រចាំ ឆ្នាំ លើក ទី ៥៤ នៃ វេទិកា សេដ្ឋកិច្ច ពិភពលោក នៅ ថ្ងៃទី ១៦ - ១៧ ខែមករា ឆ្នាំ ២០២៤ នៅ ទីក្រុង ដាវ៉ូស - ក្លូស្ទ័រ ប្រទេស ស្វីស ។ នេះ បើ តាម សេចក្តីប្រកាស របស់ ក្រសួង ការបរទេស ដែល បណ្តាញ Fresh News ទទួលបាន ។
ក្រោម មូល បទ « ការកសាងឡើងវិញ នូវ ទំនុកចិត្ត » កិច្ចប្រជុំ នេះ នឹង ផ្តោត លើ គោលការណ៍ ជា មូលដ្ឋាន ដែល ជំរុញ ឱ្យ មាន ទំនុកចិត្ត រួមទាំង តម្លាភាព សង្គតិភាព និង គណនេយ្យភាព ។ ថ្នាក់ ដឹកនាំ ពិភពលោក និង នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ធំ ៗ ព្រមទាំង ប្រធាន អង្គការ អន្តរជាតិ សំខាន់ ៗ ថ្នាក់ដឹកនាំ សង្គម ស៊ីវិល តំណាង យុវជន សហគ្រិន សង្គម និង អង្គភាព សារព័ត៌មាន នានា នឹង ចូលរួម ក្នុង កិច្ចប្រជុំ នេះ ។
អញ្ជើញ អម ដំណើរ សម្តេច ធិបតី និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត រួម មាន លោក ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល អនុប្រធាន ទី១ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា និង លោកស្រី ចម និម្មល រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ព្រមទាំង ឥស្សរជន ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល និង ថ្នាក់ដឹកនាំ ធុរកិច្ច នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា ។
( កំពង់ឆ្នាំង ) ៖ ព្រះសង្ឃ អាជ្ញាធរ និង ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ បាញ់ ឆ្គោល ឃុំ ជ្រៃ បាក់ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង បាន សំណូមពរ ដល់ ថ្នាក់ដឹកនាំ សប្បុរសជន ក៏ដូចជា មន្ទីរ ក្រសួង ពាក់ព័ន្ធ ស្នើសុំ ជួយ ចូលរួម ឧបត្ថម្ភ ក សាង ស្ពាន ឆ្លង ស្ទឹង មួយ កន្លែង ( ស្ពាន ព្រៃ ក្រាំង ) ដែល ស្ពាន នេះ ស្ថិត នៅក្នុង ភូមិ ឃុំ ខាងលើ សម្រាប់ ជា អត្ថប្រយោជន៍ ដល់ ការធ្វើដំណើរ និង ដឹក កសិផល របស់ ប្រជាកសិករ ជាច្រើន ភូមិ ។
ព្រះគ្រូ ចៅអធិការ វត្ត មង្គល បញ្ញា ហៅ វត្ត បឆ្គោល ក្នុង ឃុំ ជ្រៃ បាក់ ស្រុក រលាប្អៀរ ព្រះនាម ស៊ុន យីម បាន មាន ថេរ ដីកា ថា ដោយសារ ជួប ការលំបាក ក្នុង ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ជាច្រើន ភូមិ ក្នុង ឃុំ ចំនួន ២ នៃ ស្រុក រលាប្អៀរ ទើប ថ្ងៃ នេះ បងប្អូន ប្រជាពលរដ្ឋ បាន មូលមតិ គ្នា បើក ការដ្ឋាន សាងសង់ ស្ពាន ឈើ ឆ្លង ស្ទឹង មួយ កន្លែង ដែល មាន ប្រវែង ២០ម៉ែត្រ ធ្វើ អំពី ស៊ីម៉ង់ត៍ ទៅ តាម លទ្ធភាព ជាក់ស្ដែង ដែល ពួកគាត់ មាន ជា បណ្ដើរ ៗ ។
បើ តាម ការប្រមាណ តម្លៃ ស្ពាន មួយ នេះ ត្រូវ ចំណាយ ថវិកា រហូតដល់ ជិត ៣ម៉ឺន ដុល្លារ ។ ក្នុង នាម ព្រះអង្គ ជា ព្រះចៅ អធិការ វត្ត បាញ់ ឆ្គោល ជំនួស មុខ ឱ្យ បងប្អូន ពុទ្ធ បរិស័ទ សូម អំពាវនាវ ដល់ បងប្អូន សប្បុរសជន ទាំង ក្នុង និង ក្រៅ ប្រ ទេស មេត្តា ជួយ ឧបត្ថម្ភ ជា ថវិកា ឬ ជា សម្ភារ ដើម្បី ជួយ កសាង ស្ពាន មួយ កន្លែង នេះ សម្រាប់ ជា ប្រយោជន៍ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ការធ្វើដំណើរ និង ដឹក កសិផល ទៅ តាម សទ្ធា របស់ បងប្អូន ។
លោក សំ សំណាង មេភូមិ បាញ់ ឆ្គោល ឃុំ ជ្រែក បាក់ ស្រុក រលាប្អៀរ បាន បញ្ជាក់ ថា គម្រោង សាងសង់ ស្ពាន មួយ កន្លែង នេះ មាន ប្រវែង ២០ម៉ែត្រ ទទឹង ៤.១០ ម៉ែត្រ កម្ពស់ ៦ម៉ែត្រ ឆ្លងកាត់ ស្ទឹង ជ្រៃ បាក់ ដែល គ្រោ ង ចំណាយ ថវិកា អស់ ជិត ៣ម៉ឺន ដុល្លារ ។
ក្នុង នាម លោក ជា អាជ្ញាធរ ជំនួស មុខ ឲ្យ ប្រជាពលរដ្ឋ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន ចិត្ត សប្បុរសធម៌ ក៏ ដូចជា ថ្នាក់ដឹកនាំ និង មន្ទីរ ក្រសួង ពាក់ព័ន្ធ មេត្តា ជួយ ឧបត្ថម្ភ ជា សម្ភារ ដែក ស៊ីម៉ង់ត៍ ដើម្បីឲ្យ ការកសាង ស្ពាន មួយ កន្លែង នេះ បាន រួចរាល់ ជា ស្ថាពរ ដើម្បី ឆាប់ បាន បងប្អូន ប្រជាពលរដ្ឋ ធ្វើដំណើរ ព្រោះថា បើ តាម លទ្ធភាព ដែល បាន ចាប់ផ្ដើម កសាង នៅ ពេល នេះ មាន ទឹកប្រាក់ ត្រឹម ១៥០០ ដុល្លារ ប៉ុណ្ណោះ ។
លោក បាន បញ្ជាក់ ទៀត ថា កាល ដើម ឡើយ ស្ពាន មួយ កន្លែង នេះ ជា ស្ពាន ឈើ ដែល ប្រជាពលរដ្ឋ ក្នុង ភូមិ បាន កសាង តាំងពី ឆ្នាំ ១៩៨០មក ម្ល៉េះ កន្លងមក ពេល ស្ពាន បាក់បែក ក៏ ចេះតែ ជួសជុល ប្រើប្រាស់ បណ្ដើរ ៗ រហូតមក ទើបតែ បាក់ រលំកាល អំឡុង ខែមករា ឆ្នាំ ២០២៣ ក្រោយពេល ប្រជាពលរដ្ឋ ប្រមូល ផល ស្រូវ អស់ ដោយ មាន ទឹក ជំនួន ធំ ធ្លាក់ ពីលើ ក៏ បាន ហូរផ្ដាច់ ស្ពាន នេះ តែម្ដង ។
លោក បាន បញ្ជាក់ ថា បន្ទាប់ពី ធ្វើ ការអំពាវនាវ ជា បណ្ដើរ ៗ ក៏ មាន សប្បុរស ជន ជួយ ឧបត្ថម្ភ ខ្លះ ៗ ផងដែរ ។ ក្នុង នោះ លោក សេង វិចិត្រ អភិបាល ស្រុក រលាប្អៀរ បាន ជួយ ឧបត្ថម្ភ ស៊ីម៉ង់ត៍ មួយ តោន និង លោក ឧត្តមសេនីយ៍ ឯក ទៀប ហ៊ន ក៏ បាន ជួយ ឧបត្ថម្ភ ស៊ីម៉ង់ត៍ ចំនួន ២តោន ផងដែរ ៕ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ធំ រៀបចំ កម្មវិធី សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ វេទិកា ភាព ជា អ្នកដឹកនាំ តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក ឆ្លើយតប មេរោគ អេដស៍ ជំងឺ អេដស៍ និង ការអភិវឌ្ឍ នៅ កម្ពុជា
( កំពង់ធំ )៖ លោក ងួន រតនៈ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ធំ បាន អញ្ជើញ ចូលរួម ក្នុង កម្មវិធី សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ វេទិកា ភាព ជា អ្នកដឹកនាំ តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក ឆ្លើយតប មេរោគ អេដស៍ ជំងឺ អេដស៍ និង ការអភិវឌ្ឍ នៅ កម្ពុជា ពិធី អប់រំ ព្សព្វផ្សាយ មេរោគ អេដស៍ ជំងឺ អេដស៍ ក្រោម ប្រធានបទ « សហគមន៍ តែ មួយ ដឹកនាំ ឆ្ពោះទៅ បញ្ចប់ ជំងឺ អេដស៍ » ។ ពិធី នេះ បាន ធ្វើឡើង នៅ ស្រុក ស្ទោង ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២៤ ។
លោក សាយ គឹម ឡម ប្រធាន អនុសាខា ស្រុក ស្ទោង បាន រាយការណ៍ ថា អនុសាខា បាន ខិតខំ ចុះ តាម មូលដ្ឋាន និង ធ្វើ ការផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ ឱ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ អំពី មហន្តរាយ ដែល កើតមាន ពី ឥទ្ធិពល ខ្យល់ កន្ត្រាក់ និង អគ្គីភ័យ ផ្សេង ៗ ហើយ អនុសាខា បាន ធ្វើ សកម្មភាព មនុស្សធម៌ ជួយ ដល់ ប្រជាជន ជួប គ្រោះមហន្តរាយ និង វិបត្តិ ផ្សេង ៗ សរុប ចំនួន ៤១២ ករណី ។
លោក ងួន រតនៈ សូម លើកទឹកចិត្ត ដល់ យុវជន កាកបាទ ក្រហម កម្ពុជា ស្រុក ស្ទោង ទាំងអស់ ប្រការ សំខាន់ ដែល ជា ក្រឹត្យ វិន័យ របស់ យុវជន កាកបាទ ក្រហម គឺ ត្រូវ ធ្វើជា គំរូល្អ សម្រាប់ យុវជន ដទៃ ទៀត តាមរយៈ ការប្រើ យុវភាព របស់ ខ្លួន ជា ប្រយោជន៍ ដល់ សង្គម ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ យុវជន ល្អ កាន់តែ មាន ច្រើន លប់ បំបាត់ ក្មេង ទំនើង បង តូច បង ធំ អ្នក គ្រឿន ញៀន គ្រឿងស្រវឹង ល្បែង ពាលា អាវា សែ ដែល បង្ក ជា បាតុភាព មិន ល្អ ដល់ សង្គម ។
លោក ងួន រតនៈ បាន បន្ត ថា ឆ្លងកាត់ វគ្គ បណ្តុះបណ្តាល របស់ ក្មួយ ៗ ជំនឿ ជឿជាក់ ថា បណ្តា មេរៀន សំខាន់ ៗ មួយចំនួន មាន ដូច ជា៖ ប្រវត្តិ របស់ ចលនា អន្តរជាតិ កាកបាទ ក្រហម អឌ្ឍ ចន្ទ ក្រហម វិជ្ជា សង្គ្រោះ បឋម តួនាទី ភារកិច្ច របស់ យុវជន កាកបាទ ក្រហម រួម និង ខ្លឹមសារ សំខាន់ ៗ មួយចំនួន ទៀត ។
លោក ងួន រតនៈ បាន ជំរុញ គ្រូ បង្គោល ត្រូវ ឧស្សាហ៍ ធ្វើ បទបង្ហាញ ជូន ដល់ ក្មួយ ៗ រួមចំណែក លើកកម្ពស់ ស្មារតី ភ្ញាក់ រលឹក ការស្ម័គ្រចិត្ត ជា កម្លាំង ចលករ ប្រកបដោយ ថាមពល ជា បញ្ញា ជន និង ជា សសរ ទ្រូង ដ៏ រឹងមាំ របស់ សង្គមជាតិ ចូលរួម ក្នុង ចលនា យុវជន កាកបាទ ក្រហម ពោរពេញ ដោយ បេះដូង មនុស្សធម៌ ដោយ ក្តីអាណិតអាសូរ ស្រឡាញ់ មនុស្ស ផង គ្នា រួមចំណែក បង្កើន ឧត្តម ផលប្រយោជន៍ ប្រទេសជាតិ សហគមន៍ និង គ្រួសារ ។
( ភ្នំពេញ ) ៖ លោក ណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន បង្ហាញ ជំនឿ ជឿជាក់ ១០០ ភាគរយ ថា នៅ ឆ្នាំ ២០៥០ កម្ពុជា នឹង ក្លាយជា ប្រទេស អព្យាក្រឹត កាបូន ដែល មាន ភាពស្រស់ស្អាត និង កម្រ ប ព្រៃឈើ រហូត ទៅដល់ ៦០ ភាគរយ ឬ អាច លើស នេះ ក៏ ថា បាន ។
ការបង្ហាញ ជំនឿ បែប នេះ របស់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន បាន ធ្វើឡើង ស្រប ទៅតាម ច្បាប់ យុទ្ធនាការដាំ កូន ឈើ ចំនួន ១លាន ដើម ក្នុង មួយ ឆ្នាំ ដើម្បី បង្កើន គម្រប ព្រៃឈើ រួម ជាមួយនឹង និន្នាការ បច្ចុប្បន្ន ដែល ប្រជាពលរដ្ឋ ជាពិសេស សិស្សានុសិស្ស ក្មេង និង យុវជន កាន់តែ ច្រើន ឡើង មាន ការយល់ដឹង ពី សារៈសំខាន់ របស់ ដើមឈើ ។
ជាមួយគ្នា នេះ ដែរ សម្តេច ធិបតី ហ៊ុន ម៉ាណេត ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន គាំទ្រ និង អនុម័ត ឱ្យ អនុវត្ត វិធាន ប្រតិបត្តិ មាត្រា ៦ នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ស្តីពី ការប្រែប្រួល អាកាសធាតុ ដែល ជំរុញ និង លើកទឹកចិត្ត ដល់ កម្ពុជា ក្នុង ការធ្វើ អាជីវកម្ម កាបូន ប្រកបដោយ តម្លាភាព គណនេយ្យភាព និង ស្រប តាម ស្តង់ដា អន្តរជាតិ ។
បន្ថែម ពី នេះ លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា ប្រសិនបើ យុវជន ពួកគេ ចង់បាន ភាពស្អាត ហើយ នេះ ជា ចរន្ត មួយ មិន មែន សម្រាប់ តែ ជំនាន់ នេះ នោះ ទេ ប៉ុន្តែ សម្រាប់ មនុស្ស គ្រប់ ជំនាន់តទៅ ។ មាន ន័យ ថា យុវជន ជំនាន់ នេះ នាំគ្នា ឈប់ ប្រើប្រាស់ ថង់ ប្លាស្ទិក នោះ យុវជន ជំនាន់ ក្រោយ ក៏ នឹង ឈប់ ប្រើ ថង់ ប្លាស្ទិក ដូចគ្នា ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន បន្ថែម ថា តាម ការយៈ ការចូលរួម ផ្សព្វផ្សាយ និង ការស្រឡាញ់ ដើមឈើ នោះ ពួកគាត់ ព្រមទាំង កូន ចៅ គាត់ ជំនាន់ ក្រោយ ក៏ នឹង មិន កាប់ ដើមឈើ នោះ ដែរ ។
« អញ្ចឹង ខ្ញុំ មាន ជំនឿ ជឿជាក់ ១០០ ភាគរយ ថា ចលនា របស់ យើង ជា ចលនា មិន មែន សម្រាប់ តែ រយៈពេល ខ្លី គឺជា ចលនា រយៈពេល វែង ហើយក៏ ជា ចលនា កំពុងតែ មាន សក្តានុពល ដែល ជា កម្លាំង ចលករ ជំរុញ ទៅ មុខ » ។ នេះ ជា ការលើកឡើង បន្ថែម របស់ លោក រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន ។
គួរ បញ្ជាក់ ថា កម្ពុជា បច្ចុប្បន្ន មាន ផ្ទៃដី អភិរក្ស ជាង ៧លាន ហិកតា ឬ ស្មើ ប្រមាណ ៤១ ភាគរយ នៃ ផ្ទៃដី ប្រទេស ទាំងមូល ។ កន្លងមក កម្ពុជា បាន លក់ កាបូន ក្នុង ក្របខណ្ឌ ទីផ្សារ ស្ម័គ្រចិត្ត នៅ ដែន ជម្រក សត្វ ព្រៃ តា តៃ និង ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវាញ ក្នុង ខេត្ត កោះកុង និង ដែន ជម្រក សត្វ ព្រៃ កែវ សីម៉ា ក្នុង ខេត្ត មណ្ឌលគិរី ។ ថវិកា ដែល ទទួលបាន ពី ការលក់ កាបូន គឺ យក ទៅ អភិវឌ្ឍ សហគមន៍ និង អភិរក្ស តំបន់ ការពារ ធម្មជាតិ ផ្សេង ៗ ៕
ក្រសួង មហាផ្ទៃ រកឃើញ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល មួយចំនួន មិន បាន បំពេញ កាតព្វកិច្ច ត្រឹមត្រូវ តាម ច្បាប់ និង ជូន ដំណឹង ឲ្យ បំពេញ កាតព្វកិច្ច ជាធរមាន
( ភ្នំពេញ ) ៖ ក្រសួង មហាផ្ទៃ បាន រកឃើញ ថា សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល មួយចំនួន មិន បាន បំពេញ កាតព្វកិច្ច ត្រឹមត្រូវ តាម ច្បាប់ ស្ដីពី សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល នោះ ឡើយ ខណៈ រាជ រដ្ឋាភិបាល កម្ពុជា តែងតែ ប្រកាន់ខ្ជាប់ នូវ ការ លើក ស្ទូយ សិទ្ធិ សេរីភាព ក្នុង ការបង្កើត និង ការធ្វើ សកម្មភាព របស់ សមាគម និង អង្គ មិន មែន រដ្ឋាភិបាល ។
ដោយ មើលឃើញ ពី ចំណុច នេះ លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ បាន ចេញ សេចក្ដីជូនដំណឹង មួយ ស្ដីពី ការបំពេញ កាតព្វកិច្ច តាម ការកំណត់ ដោយ ច្បាប់ ស្ដីពី សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ដើម្បីឲ្យ ស្ថាប័ន ដែល មិន បាន បំពេញ កាតព្វកិច្ច ត្រូវ បំពេញ ឲ្យបាន ត្រឹមត្រូវ តាម ច្បាប់ ជាធរមាន ។
ក្នុង សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២៤ នេះ ឧប នាយក រដ្ឋមន្ដ្រី ស សុខា បាន ឲ្យដឹង ថា បច្ចុប្បន្ន នេះ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ក្នុង ស្រុក រហូតមកដល់ បច្ចុប្បន្ន មាន ចំនួន ៦. ២៧៩ ក្នុង នោះ សមាគម មាន ចំនួន ២. ៧៤៧ និង អង្គការ មិន មែន រដ្ឋាភិបាល ចំនួន ៣. ៥៣២ ត្រូវបាន ចុះបញ្ជី និង តម្កល់ លក្ខន្តិកៈ នៅ ក្រសួង មហាផ្ទៃ ហើយ អាច ធ្វើ សកម្មភាព ដោយ សេរី ស្រប តាម ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
( រតនគិរី ) ៖ វគ្គ បណ្តុះបណ្តាល ស្តីពី « ការបើកប្រាក់ ឧបត្ថម្ភ សម្រាប់ កម្មវិធី ជំនួយ សង្គម ផ្នែក បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស សម្រាប់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ » បាន បើក ដំណើរការរយៈ ពេល ១ ថ្ងៃ ដែល រៀបចំ ដោយ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា ខេត្ត នា ព្រឹក ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២៤ ។
វគ្គ នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី និង មាន ការអញ្ជើញ ចូលរួម ពី លោក ហ៊ត ស៊ុន ហោ ប្រធាន មន្ទីរ សង្គមកិច្ច អតី យុទ្ធជន និង យុវនិតិសម្បទា លោក លោកស្រី អភិបាល ក្រុង ស្រុក ទាំង ៩ ប្រធាន ការិយាល័យ សង្គមកិច្ច និង សុខុមាលភាព សង្គម ក្រុង ស្រុក លោក លោកស្រី មេឃុំ ចៅសង្កាត់ និង មន្រ្តី ទទួលបន្ទុក កម្មវិធី ឃុំ សង្កាត់ និង មន្រី្ត ពាក់ព័ន្ធ ជាច្រើន រូប ផងដែរ ។
លោក ញ៉ែ ម សំអឿន បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន បន្ត ផ្តោត ការយកចិត្តទុកដាក់ លើ ការកសាង និង ពង្រឹង ប្រព័ន្ធ គាំពារ សង្គម ឱ្យ មាន លក្ខណៈ ប្រមូលផ្តុំ សង្គតិភាព និង ប្រសិទ្ធភាព ដោយ ឈរ លើ ស្មារតី « មិន បោះបង់ ពលរដ្ឋ ណា ម្នាក់ » ។
លោក បណ្ឌិត ប៉ាន់ ខែម ប៊ុន ថន ក្នុង នាម ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ក្រុង ប៉ោយប៉ែត បាន ថ្លែង កោតសរសេីរ ចំពោះ ការស្រលាញ់ រាប់ គ្នា រវាង ក្រុមការងារ មន្ត្រីរាជការ អាជីវករ និង ប្រជាពលរដ្ឋ ក្នុង ក្រុង ប៉ោយប៉ែត ផ្ទាល់ ក៏ ដូចជា ការទំនាក់ទំនង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង រដ្ឋបាល ក្រុង ប៉ោយ ខេត្ត បន្ទាយមានជ័យ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង រដ្ឋបាល ស្រុក អារញ្ញប្រថេប នៃ ព្រះរាជាណាចក្រ ថៃ ឡង់តិ៍ ។
ជាមួយគ្នា នេះ លោក បណ្ឌិត ប៉ាន់ ខែម ប៊ុន ថន បាន លេីក ឡេីង ថា លោក ពិតជា រំភេីប ចិត្ត ណាស់ ពេល ដែល បាន មេីល ឃេីញ នូវ ស្នាមញញឹម និង ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ពីសំណាក់ បងប្អូន ប្រជាពលរដ្ឋ ។ ការផ្ញេី ក្តីសង្ឃឹម របស់ ប្រជាពលរដ្ឋ គឺជា អម្រែកបន្ទុក និង ជា ការទទួលខុសត្រូវបស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ក្រុង ប៉ោយប៉ែត ដែល មាន លោក ជា ប្រធាន ផ្ទាល់ ។
( កំពង់ចាម ) ៖ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល ជាមួយនិវត្ត ជន របស់ សមាគម សង្គ ហៈ មិត្ត បុគ្គលិក មន្ត្រីរាជការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ សាលា ខេត្ត កំពង់ចាម នា ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២៤ ។
ថ្លែង ក្នុង ឱកាស នោះ សម្តេច កិត្តិសង្គហ បណ្ឌិត បាន នាំ ការផ្ដាំ សួរសុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជូន អង្គ ពិធី ទាំងមូល ដោយ ក្តី នឹករលឹក និង ការគិតគូរ អំពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ។
ក្នុង ពិធី នោះ ផងដែរ លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ថា អតីតកាល នៃ និវត្ត ជន គឺជា ការត្រួសត្រាយ ផ្លូវ ដោយ តម្លៃ នៃ ការធ្វើ ពលីកម្ម ឆ្លងកាត់ ការលំបាក គ្រប់ បែបយ៉ាង ដើម្បី សុខ សន្តិភាព និង ការអភិវឌ្ឍ ប្រទេសជាតិ ។
សម្រាប់ និវត្ត ជន ដែល បាន ចូលរួម ថ្ងៃ នេះ ក៏ បាន ទទួល អំណោយ ពី លោកស្រី អ៉ឹម ប៉ូលីកា អូន ព័ន្ធ មុនីរ័ត្ន រួម មាន បុរស ទទួលបាន ក្រមា ០១ និង ថវិកា ២០ ម៉ឺន រៀល ចំណែក ស្ត្រី ទទួលបាន សំពត់ សឹង ០១ក្បិន និង ថវិកា ២០ ម៉ឺន រៀល ៕
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២៤ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ០៤៩ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៩៧១ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ អាជ្ញាធរ ខេត្ត កោះកុង បើក កិច្ចប្រជុំ បន្ទាន់ ពី វិធានការរក្សា ទឹក ស្អាត សម្រាប់ ទុក ឱ្យ ប្រជាពលរដ្ឋ ខ្វះ ទឹក ប្រើប្រាស់ នា រដូវ ប្រាំង
( កោះកុង ) ៖ លោកស្រី អ៉ី នារី នេត អភិបាល រង ខេត្ត កោះកុង តំណាង លោកស្រី មិថុនា ភូថង អភិបាល ខេត្ត នា ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ បន្ទាន់ មួយ ដោយ ពិភាក្សា ពី វិធានការរក្សា ទឹក ស្អាត សម្រាប់ ទុក ជូន ប្រជាពលរដ្ឋ ប្រើប្រាស់ នា រដូវ ប្រាំង ខាងមុខ ។
កិច្ចប្រជុំ នេះ ដោយ មាន ការចូលរួម ពី អាជ្ញាធរ ក្រុង ស្រុក និង ស្ថាប័ន ពាក់ព័ន្ធ មួយ ចំនួន ផងដែរ ។
បន្ថែម ពី នេះ លោកស្រី បាន ណែនាំ ដល់ អាជ្ញាធរ គ្រប់ មូលដ្ឋាន ត្រូវ ចុះ ពិនិត្យ ឱ្យ ញឹកញាប់ ហើយ ត្រៀមលក្ខណៈ សម្បត្តិ ឱ្យ បាន គ្រប់គ្រាន ដើម្បី ងាយស្រួល នៅពេល ប្រជាពលរដ្ឋ តំបន់ ខ្វះ ទឹក ស្អាត ប្រើប្រាស់ ៕
( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ នា រសៀល ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២៤ បាន បន្ត ជួប សំណេះសំណាល ជាមួយ សមាជិក ក្រុមប្រឹក្សា ឃុំ ទាំង៥ ក្នុង ស្រុក ប្រាសាទ សំបូរ នៅ ទីស្នាក់ការ គណបក្ស ស្រុក ។
លោកស្រី សូម ថ្លែងអំណរគុណ សមាជិក សមាជិកា គណបក្ស ប្រជាជន ទាំងអស់ ដែល បាន បោះឆ្នោត គាំទ្រ ការជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៤ កន្លងមក ។
លោកស្រី បាន កោតសរសើរ យ៉ាង ក្រៃលែង ដល់ ក្រុមការងារ សមាជិក សមាជិកា ស្រុក ឃុំ ទាំងអស់ ដែល បាន ខិតខំ ពុះពារ បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ និង ខិតខំ តស៊ូ លះបង់ គ្រប់ បែបយ៉ាង ចូលរួម បម្រើ ដល់ ប្រជាពលរដ្ឋ ដែល ទទួលបាន ការគាំទ្រ ភ្លូក ទឹក ភ្លូក ដី បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដោយ ទទួលបាន សំឡេង លើសលប់ ហួស ពី ក្តីរំពឹងទុក្ខ នៅក្នុង អាណត្តិ ទី៥ នេះ ។
ជាក់ស្ដែង គោលការណ៍ គណបក្ស ប្រជាជន កម្ពុជា បាន កំណត់ អាសនៈ នៅក្នុង ខេត្ត កំពង់ធំ ឱ្យ បាន ៤អាសនៈ លើ ៦ អាសនៈ ប៉ុន្តែ យើង ទទួលបាន ៥ អាសនៈ លើ៦ អាសនៈ នេះ សបញ្ជាក់ ឱ្យ ឃើញ ថា យើង ទាំងអស់ គ្នា បាន ដាក់ កាយ ដាក់ចិត្ត ធ្វើ អំពើ ល្អ ព្រមទាំង ការបង្ហាញ ឱ្យ ឃើញ ពី សមិទ្ធផល នានា របស់ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ឆក់ យក បេះដូង ការគាំទ្រ ពី បងប្អូន ពុក ម៉ែ មាមីង ដែល មិន ធ្លាប់ មាន ពីមុន មក ។
លោកស្រី សង្ឃឹម យ៉ាង មុតមាំ ថា សមាជិក សមាជិកា ទាំងអស់ មាន សុខភាព ល្អ និង ចូលរួម បោះឆ្នោត គ្រប់ ៗ គ្នា ។ លោក ឃួន ឃុន ឌី បាន សំណូមពរ ដល់ សមាជិក សមាជិកា ឃុំ ស្រុក ទាំងអស់ មាន សុខភាពល្អ ដើម្បី ចូលរួម បោះឆ្នោត ជ្រើសរើស សមាជិក ព្រឹទ្ធសភា នឹង បន្ត ដឹកនាំ ក្រុមការងារ ឱ្យ បាន រឹងមាំ រីកចម្រើន ឋិតថេរត ទៅ មុខ ទៀត ។
សូម បញ្ជាក់ ថា នៅ ចុងបញ្ចប់ នៃ កម្មវិធី លោកស្រី បាន ចែកជូន ដល់ សមាជិក សមាជិកា ឃុំ ចំនួន ៣១ នាក់ ដោយ ម្នាក់ ៗ ទទួលបាន ក្រម៉ា១ និង ថវិកា មួយ ចំនួន ផងដែរ ៕
កាកបាទ ក្រហម កម្ពុជា ដែល មាន ហ្លួង ម៉ែ នរោត្តម មុនិនា ថ សីហនុ ជា ព្រះប្រធាន កិត្តិយស និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន បាន ទទួលស្វាគមន៍ គណៈប្រតិភូ យុវជន ស្ម័គ្រចិត្ត អាស៊ាន ប្រកបដោយ ភាពកក់ក្ដៅ ។
ជំនួប នេះ បាន ប្រព្រឹត្តទៅ ក្រោម វត្តមាន លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ ស្តីទី និង លោក យូ ឡាណា អគ្គ លេខាធិការ រង ទី២ អម ដោយ ថ្នាក់ដឹកនាំ និង មន្ត្រី ជំនាញ នៃ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា ។
បន្ទាប់ពី បាន ស្តាប់ បទបង្ហាញ នេះ រួច . ប្រតិភូ យុវជន ស្ម័គ្រចិត្ត អាស៊ាន បាន បង្ហាញ នូវ ចំណាប់អារម្មណ៍ ទៅ លើ ការងារ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក្នុង នាម ជា ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ វេទិកា ភាព ជា អ្នកដឹកនាំ តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក ឆ្លើយតប មេរោគ អេដស៍ ជំងឺ អេដស៍ និង ការអភិវឌ្ឍ នៅ កម្ពុជា និង ជា ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ ផែនការ សកម្មភាព រួម អគ្គ លេខាធិការ អង្គការ សហ ប្រជាជាតិ ដើម្បី សុខភាព ស្ត្រី និង កុមារ ។
ជុំវិញ នឹង ការងារ ផ្លូវចិត្ដ នេះ លោកស្រី អគ្គ លេខាធិការ ស្តីទី បាន គូសបញ្ជាក់ ថា កាកបាទ ក្រហម កម្ពុជា បាន ធ្វើ ការបណ្តុះបណ្តាល តាម អនឡាញ ដល់ មន្ត្រី - បុគ្គលិក នៅ តាម សាខា កាកបាទ ក្រហម កម្ពុជា ទាំង ២៥ រាជធានី - ខេត្ត ផងដែរ ។
បន្ទាប់ពី កម្មវិធី ជួប សម្តែង ការគួរសម និង សំណេះសំណាល រួច មក . ប្រតិភូ យុវជន ស្ម័គ្រចិត្ត អាស៊ាន ទាំង ១៦ រូប បាន ទទួល វគ្គ បណ្តុះបណ្តាល ស្តីពី វិជ្ជា សង្គ្រោះ បឋម និង សេវាកម្ម ភាព ធន់ សហគមន៍ មូលដ្ឋាន ដែល ធ្វើ បទ ឧទ្ទេសនាម ដោយ មន្ត្រី ជំនាញ នៃ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា ។
សម្រាប់ កាកបាទ ក្រហម កម្ពុជា សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ណែនាំ ដល់ មន្ត្រី ក្រោម ឱវាទ ឱ្យ រៀបចំ បដិសណ្ឋារកិច្ច ឱ្យ បាន ល្អ មាន ទទួល អាហារ សម្រន់ និង អាហារ ថ្ងៃត្រង់ ១ពេល រួម ជាមួយ ការផ្តល់ ជូន វិញ្ញាបនបត្រ បញ្ជាក់ ការសិក្សា ជូន ប្រតិភូ យុវជន ស្ម័គ្រចិត្ត អាស៊ាន គ្រប់ ៗ គ្នា ផងដែរ ៕
ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ជូនដំណឹង ពី ការបន្ត លើកលែង ពន្ធ ការអនុគ្រោះ ពន្ធ បន្ថែម ការពន្យារ និង ការព្យួរ ការ អនុវត្ត ពន្ធ សម្រាប់ វិស័យ អចលន ទ្រព្យ
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចេញ សេចក្តីជូនដំណឹង ថ្មី មួយ ស្តីពី ការបន្ត លើកលែង ពន្ធ ការអនុគ្រោះ ពន្ធ បន្ថែម ការពន្យារ និង ការព្យួរ ការ អនុវត្ត ពន្ធ សម្រាប់ វិស័យ អចលន ទ្រព្យ ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១២ ខែមករា នេះ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណង របស់ ក្រសួង សេដ្ឋកិច្ច៖
