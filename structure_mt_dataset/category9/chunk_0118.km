( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា បាន ផ្តួចផ្តើម បង្កើត ស្តង់ដា កិច្ចសន្យា ឥណទាន ថ្មី សម្រាប់ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ទាំងអស់ យក ទៅ ប្រើប្រាស់ ដើម្បី បង្ក ភាពងាយស្រួល ដល់ អ្នក ខ្ចី ប្រាក់ រាល់ ដំណើរការ នៃ ការស្នើសុំ ឥណទាន ។ ស្តង់ដា កិច្ចសន្យា ឥណទាន នេះ បាន រៀបចំឡើង ដោយ សមាគម ធនាគារ នៅ កម្ពុជា និង សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា ៕
( ភ្នំពេញ ) ៖ លោកស្រី ឆាយ ស៊ីវលីន ប្រធាន សមាគម ទីភ្នាក់ងារ ទេសចរណ៍ កម្ពុជា បាន លើកឡើង ថា បច្ចុប្បន្ន នេះ ធនធាន ដើម នៃ វិស័យ ទេសចរណ៍ មាន ហើយ ប៉ុន្ដែ អ្វី ដែល ជា បញ្ហា នោះ គឺ បច្ចុប្បន្ន នេះ នៅ កង្វះ ធនធាន មនុស្ស ក្នុង ការអភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ កម្ពុជា ឲ្យ រីកចម្រើន ដោយសារតែ អ្នកជំនា ក្នុង វិស័យ ទេសចរណ៍ មួយចំនួន កំពុង ស្ទាក់ស្ទើរ ក្នុង ការវិលត្រឡប់ មកវិញ បន្ទាប់ពី រង នូវ វិបត្តិ ធ្ងន់ធ្ងរ នៃ ជំងឺ កូវីដ១៩ ។
លោកស្រី ឆាយ ស៊ីវលីន បាន ថ្លែង ថា « ធនធាន ដើម នៃ វិស័យ ទេសចរ គឺ យើង មាន ហើយ ប៉ុន្ដែ ធនធាន មនុស្ស មាន ការខ្វះខាត ដែល តម្រូវឲ្យ មាន ការផលិត បន្ថែម ការខ្វះខាត នេះ ដោយសារតែ អំឡុង ពេល កូវីដ១៩ បាន ធ្វើឲ្យ អ្នកជំនាញ ក្នុង វិស័យ ទេសចរណ៍ បាន ផ្អាក ឬ ឈប់ ពី វិស័យ នេះ ហើយ រហូតមកដល់ បច្ចុប្បន្ន ការវិលត្រឡប់ នៃ អ្នកជំនាញ ទាំងនោះ ពុំ មាន គ្រប់គ្រាន់ នោះ ឡើយ » ។
លោកស្រី បាន បញ្ជាក់ ថា ជា ការពិត អំឡុង ពេល មាន វិបត្តិ កូវីដ១៩ ចង់ ឬ មិន ចង់ អ្នកជំនាញ នៃ វិស័យ ទេសចរណ៍ បាន ផ្អាក ពី ជំនាញ នេះ ដើម្បី ស្វះស្វែងរក ជំនាញ ផ្សេង ក្នុង ការបំពេញ ការងារ រក ប្រាក់ ចំណូល ដូច្នេះ បច្ចុប្បន្ន នេះ អ្នកជំនាញ ទាំងនោះ ពុំ ទាន់ វិល ត្រលប់ មក អស់ នោះ ទេ ដោយសារតែ អាចនឹង ជាប់ កុងត្រា ការងារ ថ្មី ឬ មិន ទាន់ ច្បាស់លាស់ ពី វិស័យ ទេសចរណ៍ ឬ អ្នក ខ្លះ ទៀត មាន វ័យ ចាស់ ជ្រុល ដែល មិន អាច ឲ្យ ពួកគាត់ ត្រឡប់ មក បំពេញ ការងារ នេះ សារជាថ្មី ៕
( ភ្នំពេញ ) ៖ លោកស្រី ឆាយ ស៊ីវលីន ប្រធាន សមាគម ទេសចរណ៍ កម្ពុជា បាន លើកឡើង ថា ការបង្កើត សហគមន៍ ទេសចរណ៍ ជា គន្លឹះ ល្អ បំផុត ក្នុង ការបម្រើ សេវាកម្ម ទេសចរណ៍ បែប អេកូ ទេសចរណ៍ នៅ តំបន់ ទេសចរណ៍ ឆ្ងាយ ៗ និង ជួយ ដល់ ជីវភាព ប្រជា សហគមន៍ ។
លោកស្រី កត់សម្គាល់ ថា បច្ចុប្បន្ន នេះ ការបង្កើត នូវ សហគមន៍ ទេសចរណ៍ តូច ៗ នៅ តាម តំបន់ ទេសចរណ៍ ឆ្ងាយ ៗ នៅ មាន កម្រិត នៅឡើយ ។
លោកស្រី អំពាវនាវ ដល់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ បង្កើន ការគាំទ្រ ដល់ ប្រជាពលរដ្ឋ នៅ តាម សហគមន៍ ដើម្បីឱ្យ ពួកគាត់ មាន លទ្ធភាព បង្កើត សហគមន៍ ទេសចរណ៍ និង ធ្វើឱ្យ ពួកគាត់ មាន ភាពរឹងមាំ ក៏ ដូចជា មាន លទ្ធភាព ផ្តល់ នូវ សេវាកម្ម ច្រើន បែប ដល់ ភ្ញៀវ ទេសចរ ទាំង ការដឹកជញ្ជូន ការផ្គត់ផ្គង់ អាហារ និង ការស្នាក់ នៅ ព្រម តែ ការកែច្នៃ ផលិត ជា វត្ថុអនុស្សាវរីយ៍ ជាដើម ។
ការគាំទ្រ ដល់ ពួកគាត់ គឺ ធ្វើឡើង តាមរយៈ ការបង្កើត ហេដ្ឋារចនាសម្ព័ន្ធ ការផ្តល់ ថវិកា បដិភាគ ឬ ការផ្តល់ កម្ចី ដែល មាន លក្ខណៈ អនុគ្រោះ ។ សហគមន៍ ទាំងនោះ ពិតជា ត្រូវការគាំទ្រ ព្រោះ កន្លងមក ពួកគាត់ ដំណើរការបាន ដោយសារ ដៃគូ អភិវឌ្ឍន៍ និង អង្គការ សង្គម ស៊ីវិល ហើយ នៅ ពេល ដែល អង្គការ ដៃគូ អភិវឌ្ឍន៍ ទាំងនោះ បញ្ចប់ គម្រោង នោះ អាចនឹង ធ្វើឱ្យ ពួកគាត់ ប្រឈម នឹង ការដួលរលំ ដែរ ៕
ខាងក្រោម នេះ ជា ការលើកឡើង របស់ អ្នកស្រី ឆាយ ស៉ីវលី ន៖
( ភ្នំពេញ ) ៖ លោកស្រី ឆាយ ស៊ីវលីន ប្រធាន សមាគម ទេសចរណ៍ កម្ពុជា បាន ប្រាប់ អំពី មូលហេតុ ដែល ភ្ញៀវ ទេសចរ ចូលមក កម្ពុជា ភាគ ច្រើន គឺ ចូល តាម ប្រទេស ថៃ និង ប្រទេស វៀតណាម ដោយសារតែ កម្ពុជា អត់ មាន យន្ដហោះ ហោះហើរ ត្រង់ ៗ ទៅកាន់ ប្រទេស ធំ ៗ ទាំងនោះ ។
លោកស្រី ឆាយ ស៊ីវលីន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ភ្ញៀវ ទេសចរ មក តាមរយៈ ថៃ និង វៀតណាម មាន ប្រមាណ ជា ៥០ ភាគរយ ដោយសារតែ យើង មាន ការប្រឈម មួយ គឺ យើង អត់ មាន យន្ដហោះ ហោះហើរ ត្រង់ ទៅកាន់ ប្រទេស ធំ ៗ ទាំងអស់ នោះ ជា ហេតុ ធ្វើឲ្យ ប្រទេស ជិតខាង មាន បៀប ជាង យើង »៕
សូម ស្តាប់ ការលើកឡើង របស់ លោកស្រី ឆាយ ស៉ីវលី ន៖
មន្រ្តី ហ៊ូទី ខាងលើ បាន លើក ដូច្នេះ ថា « សម្រាប់ បណ្តា ប្រទេស ផ្សេង ទៀត រួមទាំង ចិន និង រុស្ស៉ី គឺ កប៉ាល់ ដឹកជញ្ជូន របស់ ពួកគេ នៅក្នុង តំបន់ មិន ស្ថិត ក្រោម ការគំរាមកំហែង ឡើយ ។ ម៉្យាង វិញ ទៀត នោះ ពួកយើង ត្រៀមខ្លួន ជាស្រេច ដើម្បី ធានា សុវត្ថិភាព ចំពោះ ការធ្វើដំណើរ របស់ កប៉ាល់ ពួកគេ នៅ តំបន់ សមុទ្រ ក្រហម ដ្បិត សេរីភាព នៃ ការធ្វើ នាវាចរណ៍ ដើរ តួនាទី យ៉ាង សំខាន់ សម្រាប់ ប្រទេស របស់ យើង ។ យ៉ាងណា ក្តី ការវាយប្រហារ លើកប៉ាល់ នានា ដែល មាន ទំនាក់ទំនង ជាមួយ អ៉ី ស្រាអែល នឹង នៅតែ បន្ត » ។
អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា ក៏ បាន ប្រកាស ជូន សាធារណៈ ជន ឲ្យបាន ជ្រាប ថា លោក មិន ពាក់ព័ន្ធ ជាមួយ គណនី Telegram ក្លែងក្លាយ មួយ នោះ ទេ ដូច្នេះហើយ សូម ប្រជាពលរដ្ឋ មាន ការប្រុងប្រយ័ត្ន ក្នុង ករណី មាន បញ្ហា អ្វី កើតឡើង មិន ជាប់ពាក់ព័ន្ធ ជាមួយ លោក នោះ ឡើយ ៕
មន្រ្តី ជាន់ ខ្ពស់ ចិន បង្ហាញ ការបន្ត ការគាំទ្រ ដល់ កិច្ចសហប្រតិបត្តិការ សកម្មភាព មីន ដែល ជា ការងារ អាទិភាព របស់ រាជ រដ្ឋាភិបាល កម្ពុជា រហូតដល់ កម្ពុជា អាច សម្រេចបាន នូវ គោលដៅ របស់ ខ្លួន
( ភ្នំពេញ ) ៖ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៤ នៅ ទីស្នាក់ការ អាជ្ញាធរ មីន តាង នាម សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ មីន . បណ្ឌិត លី ធុជ ទេសរដ្ឋមន្រ្តី និង ជា អនុប្រធាន ទី១ អាជ្ញាធរ មីន បាន ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ លោក MA Shengkun អគ្គ នាយក រង នៃ នាយកដ្ឋាន គ្រប់គ្រង អាវុធ នៃ ក្រសួង ការបរទេស ចិន ស្តីពី ការពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ជំនួយ បោសសម្អាត មីន មនុស្សធម៌ នៅ កម្ពុជា ។
លោក MA Shengkun បាន លើកឡើង ថា មុននឹង ជំនួប ពិភាក្សា ជាមួយ ឯកឧត្តម ទេសរដ្ឋមន្រ្តី លី ធុជ លោក និង គណៈប្រតិភូ បាន ចុះ ទស្សនកិច្ច ស្វែងយល់ អំពី សកម្មភាព បោសសម្អាត មីន នៅ ទីវាល ដោយ ផ្ទាល់ ដែល រៀបចំ ដោយ មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា ហើយ លោក MA បាន យល់ យ៉ាង ច្បាស់ អំពី តម្រូវការ និង បញ្ហា ប្រឈម នានា របស់ កម្ពុជា ក្នុង ការងារ បោសសម្អាត មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ។
ក្នុង នោះ លោក MA បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល សម្រេចបាន បទពិសោធន៍ និង ជំនាញ របស់ កម្ពុជា ក្នុង វិស័យ សកម្មភាព មីន ព្រមទាំង ថ្លែងអំណរគុណ ជូន ចំពោះ អាជ្ញាធរ មីន ដែល បាន ផ្តល់ នូវ កិច្ចសហការ យ៉ាង ល្អ ប្រសើរ ក្នុង ដំណើរទស្សនកិច្ច នេះ ។
ក្នុង នាម ក្រសួង ការបរទេស និង ក្រសួង ការពារ នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន លោក MA បាន តាំងចិត្ត បន្ត ការគាំទ្រ ដល់ កិច្ចសហប្រតិបត្តិការ សកម្មភាព មីន ដែល ជា ការងារ អាទិភាព របស់ រាជ រដ្ឋាភិបាល កម្ពុជា រហូតដល់ កម្ពុជា អាច សម្រេចបាន នូវ គោលដៅ របស់ ខ្លួន ។
ទេសរដ្ឋមន្រ្តី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ បេសកកម្ម របស់ លោក MA Shengkun និង គណៈប្រតិភូ នៅ ប្រទេស កម្ពុជា ក្នុង គោលដៅ ពង្រឹង កិច្ចសហប្រតិបត្តិការ សកម្មភាព មីន មនុស្សធម៌ ហើយ ទេសរដ្ឋមន្រ្តី បាន អះអាង ថា ការរួមចំណែក របស់ រដ្ឋាភិបាល និង ប្រជាជន ចិន ពិតជា បាន ចូលរួម ដល់ ការកាត់បន្ថយ ជនរងគ្រោះថ្នាក់ និង កាត់បន្ថយ ភាពក្រីក្រ នៅ កម្ពុជា តាមរយៈ ការងារ បោសសម្អាត មីន និង ផ្តល់ ដី ដែល មាន សុវត្ថិភាព សម្រាប់ បង្កបង្កើន ។
ក្នុង នាម សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ មីន បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល និង ប្រជាជន ចិន ដែល តែងតែ ផ្តល់ ភាពជាដៃគូ និង ការគាំទ្រ ដល់ ការងារ សកម្មភាព មីន មនុស្សធម៌ នៅ កម្ពុជា ទាំង ហិរញ្ញប្បទាន ឥត សំណង សម្ភារ និង ការកសាង សមត្ថភាព នៅ កម្ពុជា ជាដើម ។
ចាប់តាំងពី ឆ្នាំ ២០១៦ ក្រោម កិច្ច សម្របសម្រួល ពី ក្រសួង ការបរទេស និង ក្រសួង ការពារ ជាតិ នៃ ប្រទេស ចិន សិក្ខាកាម ចំនួន ១៩៩ នាក់ មកពី អាជ្ញាធរ មីន មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព កងទ័ព ជើងគោក ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ទទួលបាន ការឧបត្ថម្ភ ឲ្យ ចូលរួម វគ្គ បណ្តុះបណ្តាល ចំនួន ០៦ វគ្គ ស្តីពី ការបោសសម្អាត មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម នៅ ទីក្រុង ណាន ជីន រួមទាំង ការផ្តល់ សម្ភារ បោសសម្អាត មីន ដល់ សិក្ខាកាម កម្ពុជា ផងដែរ ៕
អ្នកសារព័ត៌មាន ក្នុង ខេត្ត ស្វាយរៀង ប្រមាណ ៨០ អង្គ / នាក់ ទទួលបាន ការបណ្តុះបណ្តាល ចំណេះដឹង បន្ថែម ទាក់ទង ការធ្វើ អត្ថាធិប្បាយ ព័ត៌មាន និង របៀប ចាប់ មុំ សរសេរ ព័ត៌មាន
អ្នកសារព័ត៌មាន ប្រមាណ ៨០ អង្គ / នាក់ មកពី បណ្តា អង្គភាព នានា ក្នុង ខេត្ត ស្វាយរៀង បាន ចូលរួម ក្នុង អង្គ សិក្ខាសាលា ដើម្បី ទទួល នូវ ចំណេះដឹង និង បទពិសោធន៍ ពី ការធ្វើ អត្ថាធិប្បាយ ព័ត៌មាន និង របៀប ចាប់ មុំ សរសេរ ព័ត៌មាន អោយ បាន ល្អ ។
លោក កែវ ច័ន្ទ លី ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត ស្វាយរៀង បាន ធ្វើ របាយការណ៍ ជម្រាប ជូន ពី ស្ថានភាព ទូទៅ របស់ មន្ទីរព័ត៌មាន និង ចំនួន អង្គភាព សារព័ត៌មាន ដែល កំពុង ដំណើរការ នៅក្នុង ខេត្ត មាន ស្ថានីយ៍ វិទ្យុ ជាតិ និង ឯកជន ផ្សាយ ផ្ទាល់ ចំនួន ៦ និង ផ្សាយ បន្ត ៤ស្ថានីយ . ស្ថានីយ ទូរទស្សន៍ ចំនួន ១០ស្ថានីយ . ស្ថានីយ ទូរទស្សន៍ ខ្សែ កាប្តិ៍ ចំនួន ៣. កាសែត ចំនួន ៣ អង្គភាព និង គេហទំព័រ ចំនួន ២២ អង្គភាព ។
បណ្ឌិត សាស្រ្តាចារ្យ ឆាយ សុផល ថ្លែង ថា ការរៀបចំ សិក្ខាសាលា នេះ ឡើង ដើម្បីឲ្យ អ្នកសារព័ត៌មាន នៅក្នុង ខេត្ត ស្វាយរៀង ទទទល បាន នូវ បទពិសោធន៍ ចំណេះដឹង និង ជំនាញ ផ្នែក សារព័ត៌មាន ពិតប្រាកដ ប្រកបដោយ វិជ្ជាជីវៈ និង ក្រមសីលធម៍ ហើយ យល់ដឹង កាន់តែ ច្បាស់ ពី ការធ្វើ អត្ថាធិប្បាយ ព័ត៌មាន និង របៀប ចាប់ មុំ សរសេរ ព័ត៌មាន បាន ត្រឹមត្រូវ ។
តាមរយៈ ការពង្រឹង ប្រសិទ្ធិភាព និង លើកកម្ពស់ វិស័យ សារព័ត៌មាន អោយ បាន កាន់តែ ល្អ ប្រសើរ ទៀត នោះ ក្រសួង ព័ត៌មាន នៅក្នុង អាណត្តិ ទី៧ ដែល មាន លោក នេត្រ ភក្ត្រា ជា រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន បាន កំពុង ដំណើរការ កំណែទម្រង់ ក្នុង វិស័យ សារព័ត៌មាន និង សោត ទស្សន៍ ពិសេស ជម្រុញអោយ មាន ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ អ្នកសារព័ត៌មាន ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ។
រដ្ឋមន្រ្តី នេត្រ ភក្ត្រា ក៏ តែង បាន រំលឹក ដល់ អ្នកសារព័ត៌មាន អំពី ខ្លឹមសារ ដែល ខ្លួន ផ្សាយ ត្រូវ ឈរ លើ ក្រមសីលធម៍ វិជ្ជាជីវៈ សារព័ត៌មាន ដោយ ផ្តោត លើ តុល្យភាព ព័ត៌មាន សំដៅ ទៅ លើ អត្ថបទ ដែល មាន ការចោទ និង មាន ការបកស្រាយ បើ ចំណុច វិជ្ជមាន ក៏ ត្រូវ រក ចំណុច អវិជ្ជមាន ហើយ បើ រកឃើញ ចំណុច អវិជ្ជមាន ត្រូវ ពន្យល់ យ៉ាង មិច ខ្លះ . នេះ គឺជា ការដេញ គ្នា ក្នុង ក្របខណ្ឌ វិជ្ជាជីវៈ សារព័ត៌មាន ។
អ្នកសារព័ត៌មាន មិន មែន ជា មន្រ្តី នគរបាល យុត្តិធម៌ មិន អាច ទៅ ចាប់ គេ បាន នោះ ទេ ហើយ អ្នកសារព័ត៌មាន មិន មែន ជា តុលាការ ដែល ត្រូវ កាត់ក្តី គេ អោយ ខុស ឬ ត្រូវ នោះ ទេ . អ្នកសារព័ត៌មាន មិន មែន មាន អធិបញ្ជា អាច បញ្ជា អ្នក នេះ អ្នក នោះ បាន ទេ ។
អ្នកសារព័ត៌មាន គឺជា អ្នកនាំពាក្យ ពី កន្លែង មួយ ទៅ កន្លែង មួយ ប្រកបដោយ ប្រភព ច្បាស់លាស់ បើសិនជា អ្នកសារព័ត៌មាន គ្មាន ប្រភព ទេ គឺ ពិបាក សរសេរ ណាស់ មិន អាច សរសេរ គ្រាន់តែ ឮ គេ ថា បាន នោះ ទេ ព្រោះ អាចនឹង មាន បញ្ហា កើតឡើង នៅ ថ្ងៃ ណាមួយ ។
ពិធី ចុះបញ្ជី លក់ មូលបត្រ ជា ផ្លូវការ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ស៊ូ សុជាតិ ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ និយ័តករ មូលបត្រ កម្ពុជា . លោក ហុង សុហួរ ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក ផ្សារ មូលបត្រ កម្ពុជា . លោក លោកស្រី តំណាង ក្រសួង ស្ថាប័ន និង វិស័យ ឯកជន ព្រមទាំង ភ្ញៀវ ជាតិ និង អន្តរជាតិ ជាច្រើន រូប ។
ថ្លៃង ក្នុង ពិធី នេះ លោក បណិ្ឌត សភាចារ្យ ហ៊ាន សាហ៊ីប បាន សម្រាប ជូន អង្គ ពិធី ថា ការចុះបញ្ជី លក់ មូលបត្រ ក្នុង ថ្ងៃ នេះ គឺជា ការចុះបញ្ជី លក់ មូលបត្រ បំណុល លើក ទី ២ របស់ ក្រុមហ៊ុន បន្ទាប់ពី ការចុះបញ្ជី លក់ មូលបត្រ បំណុល លើក ទី ១ កាលពី ខែ កញ្ញា ឆ្នាំ ២០២១ កន្លងទៅ នេះ ។ តាមរយៈ ទីផ្សារ មូលបត្រ កម្ពុជា . ក្រុមហ៊ុន បាន កៀរគរ ទុន ក្នុង ទំហំ បោះផ្សាយ លើក នេះ ប្រមាណ ២០ លាន ដុល្លារ អាមេរិក បន្ថែម ទៅ លើ ការកៀរគរ ទុន ក្នុង ទំហំ បោះផ្សាយ លើក ទី ១ ប្រមាណ ២០លាន ដុល្លារ អាមេរិក ។
លោក ហុង សុហួរ បាន គូស រំលេច ថា ផ្សារ មូលបត្រ កម្ពុជា នឹង ក្លាយជា ជម្រើស ដ៏ ល្អ បំផុត ក្នុង ការជួយគាំទ្រ ម្ចាស់ អាជីវកម្ម ដែល កំពុង ត្រូវការ មូលធន ជាពិសេស ក្នុង កាលៈទេសៈ ដែល ស្ថានភាព សេដ្ឋកិច្ច បច្ចុប្បន្ន មាន សភាព មិន អំណោយផល តាម រយះ ការធ្វើ ពិពិធកម្ម មូលធន មិន ថា ជា ការលក់ មូលបត្រ កម្មសិទ្ធិ ឬ មូលបត្រ បំណុល ។ លោក បាន លើកទឹកចិត្ត ម្ចាស់ អាជីវកម្ម ទាំងអស់ ឱ្យ ចេះ ប្រើប្រាស់ លុយ អ្នកដទៃ ដើម្បី ពង្រីក និង ជំរុញ កំណើន សក្តានុពល អាជីវកម្ម របស់ ខ្លួន ប្រកបដោយ ចីរភាព និង ឆ្ពោះ ទៅកាន់ យុគសម័យ ឌីជីថល ។
លោក បណ្ឌិត សភាចារ្យ ហ៊ាន សាហ៊ីប បាន បន្ថែម ថា ការបោះផ្សាយ លក់ មូលបត្រ បាន ផ្តល់ នូវ អត្ថប្រយោជន៍ ជាច្រើន ដល់ ការគ្រប់គ្រង និង អភិបាលកិច្ច ក្រុមហ៊ុន ក៏ ដូចជា សង្គម - សេដ្ឋកិច្ច ជាតិ ទាំងមូល តាមរយៈ ១. ការបង្កើន ប្រសិទ្ធភាព មូលធន . ២. ការលើកកម្ពស់ ភាពប្រកួតប្រជែង . ៣. ការធ្វើ ពិពិធកម្ម ប្រភព ធនធាន ហិរញ្ញវត្ថុ . ៤. ការបង្កើន ប្រភព ចំណូល និង ជម្រើស បន្ថែម សម្រាប់ វិនិយោគិន . ៥. ប្រចក្សភាព នៃ តម្លៃ របស់ ក្រុមហ៊ុន . និង ៦. ពង្រឹង តម្លាភាព និង អភិបាលកិច្ច សាជីវកម្ម ។
ក្នុង ឱកាស នេះ ដែរ លោក រដ្ឋមន្ត្រី បាន រម្លឹក ទៅ អតីតកាល នា ពេល ដែល មិន ទាន់ មាន ដ្រូន និង ឧបករណ៍ បច្ចេកវិទ្យា ទំនើប នេះ ថា មន្រ្តី បច្ចេកទេស ក្រសួង និង បណ្តា មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម រាជធានី - ខេត្ត ទាំង២៥ ត្រូវកាន់ ឧបករណ៍ ក្តារ ម៉ែត្រ ចុះ ទៅ វាស់វែង ជាក់ស្តែង ដោយ ដៃ ផ្ទាល់ ហើយ ពេល ខ្លះ មធ្យោបាយ ធ្វើដំណើរ មិន អាច ចូល ទៅដល់ ត្រូវ ធ្វើដំណើរ ថ្មើរជើង ក្នុង ចម្ងាយ ឆ្ងាយ និង ចំណាយ ពេលវេលា យូរ ក្នុង ការប្រមូល ទិន្នន័យ ។
លោក រដ្ឋមន្រ្តី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ក្រុមហ៊ុន ចិន Guang Dong និង បាន បង្ហាញ នូវ ការជឿជាក់ យ៉ាង មុតមាំ ថា ឧបករណ៍ និង ចំណេះដឹង ដែល ទទួលបាន នា ពេលនេះ នឹង បាន ជួយ បង្កើន នូវ ប្រសិទ្ធភាព ការងារ ជាមួយនឹង ការអនុវត្ត ឱ្យ បាន ត្រឹមត្រូវ និង ចំ គោលដៅ ដើម្បី បម្រើ ផលប្រយោជន៍ ឱ្យ វិស័យ ធនធាន ទឹក ដែល ក្រសួង បាន ដាក់ ជូន កាន់តែ មាន ភាពរីកចម្រើន និង ទទួលបាន ប្រសិទ្ធផល ខ្ពស់ បន្ថែម ទៀត ។
ជា កិច្ច ចាប់ផ្តើម លោកស្រី Yaël BRAUN-PIVET ប្រធាន រដ្ឋសភា បារាំង បាន សម្តែង នូវ កិច្ច ស្វាគមន៍ ចំពោះ ដំណើរទស្សនកិច្ច ផ្លូវការ របស់ សម្តេច ធិបតី នៅលើ ទឹកដី បារាំង និង បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការសម្រេច ជ្រើសរើស របស់ សម្តេច ធិបតី យក ប្រទេស បារាំង ជា ប្រទេស ទី១ ក្នុង ចំណោម បណ្តា ប្រទេស នៃ ទ្វីប អឺរ៉ុប ដើម្បី បំពេញ ទស្សនកិច្ច ផ្លូវការ ក្នុង នាម ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ស្រប ពេល ដែល ប្រទេស បារាំង - កម្ពុជា កំពុង មាន ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ល្អ លើ គ្រប់ វិស័យ ។
បន្ថែម លើ នេះ លោកស្រី ប្រធាន រដ្ឋសភា ក៏ បាន សម្តែង នូវ ការពេញចិត្ត ចំពោះ គំនិត ផ្តួចផ្តើម របស់ សម្តេច ធិបតី ក្នុង ការបង្កើត នូវ មជ្ឈមណ្ឌល វប្បធម៌ ថ្នាក់ តំបន់ មួយ នៅក្នុង ប្រទេស កម្ពុជា សម្រាប់ បម្រើ ឲ្យ ការបណ្តុះបណ្តាល ភាសា បារាំង និង ការផ្សព្វផ្សាយ វប្បធម៌ បារាំង ដល់ ប្រជាជន នៃ បណ្តា ប្រទេស នៅក្នុង តំបន់ អាស៊ី ខណៈ ដែល ប្រទេស កម្ពុជា ជា ប្រទេស ដែល មាន ទំនាក់ទំនង ប្រវត្តិសាស្ត្រ ដ៏ យូរ លង់ ជាមួយនឹង ប្រទេស បារាំង ហើយក៏ នៅតែ ជា ប្រទេស សកម្ម មួយ ដែល មាន ប្រជាជន ប្រើប្រាស់ ភាសា បារាំង ជាច្រើន ។
ជា ការឆ្លើយតប សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ ចំពោះ បដិសណ្ឋារកិច្ច ស្វាគមន៍ យ៉ាង កក់ក្តៅ ពីសំណាក់ ប្រធាន រដ្ឋសភា បារាំង និង បាន សម្តែង នូវ ក្តីរីករាយ ចំពោះ វឌ្ឍនភាពរីកចម្រើន គួរឲ្យ កត់សម្គាល់ នៃ ទំនាក់ទំង រវាង ប្រទេស ទាំង ពីរ នៅ គ្រប់ កម្រិត ជាពិសេស ទំនាក់ទំនង រវាង សា្ថប័ន នីតិប្រតិបត្តិ និង ស្ថាប័ន នីតិប្បញ្ញត្តិ ក៏ ដូចជា កិច្ចសហប្រតិបត្តិការ ជិតស្និទ្ធ នៅក្នុង វិស័យ អប់រំ វប្បធម៌ ភាសា និង សេដ្ឋកិច្ច ជាដើម ។
ទន្ទឹម គ្នា នេះ សម្តេច ធិបតី នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ក៏ បាន លើកឡើង បន្ថែម ថា នៅក្នុង ដំណើរទស្សនកិច្ច ផ្លូវការ នា ឱកាស នេះ ការជំរុញ លើកកម្ពស់ ទំនាក់ទំនង ផ្នែក ពាណិជ្ជកម្ម និង វិនិយោគ ក៏ ជា របៀបវារៈសំខាន់ មួយ ផងដែរ នៃ បេសកកម្ម របស់ សម្តេច ធិបតី បន្ថែម លើ កិច្ចការ នយោបាយ និង ការទូត ដោយ សង្ឃឹម ថា ក្រុមហ៊ុន - សហគ្រាស ធំ ៗ របស់ បារាំង នឹង បន្ត ពង្រីក ការវិនិយោគ នៅ កម្ពុជា បន្ថែម ទៀត ហើយ ចំពោះ វិនិយោគិន បារាំង ថ្មី ក៏ អាចនឹង ចាប់ផ្តើម សិក្សា ស្វែងយល់ អំពី សក្តានុពល វិនិយោគ នៅ កម្ពុជា ផងដែរ ។
មុននឹង បញ្ចប់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន សង្កត់ធ្ងន់ ថា ក្នុង នាម ជា សមាជិក សកម្ម របស់ អង្គការ នៃ បណ្តា ប្រទេស និយាយ ភាសា បារាំង នៃ អង្គការ ហ្វ្រង់ កូហ្វូនី (OIF) . ទំនាក់ទំនង លើ គ្រប់ វិស័យ រវាង ប្រទេស ទាំង ពីរ នឹង កាន់តែ ត្រូវបាន ពង្រឹង និង លើកកម្ពស់ ឲ្យ កាន់តែ រីកចម្រើន ប្រសើរឡើង យ៉ាង ប្រាកដ ៕
អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ នឹង ដឹកនាំ អ្នក ឧកញ៉ា ឧកញ៉ា សរុប ២០០ រូប ចូល ថ្វាយបង្គំ គាល់ ព្រះមហាក្សត្រ និង ហ្លួង ម៉ែ នៅ ថ្ងៃស្អែក នេះ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃសៅរ៍ ១០កើត ខែ បុស្ស ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២០ ខែមករា ឆ្នាំ ២០២៤ ស្អែក នេះ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ ប្រធាន សមាគម ឧកញ៉ា កម្ពុជា នឹង ដឹកនាំ សមាជិក ក្រុមប្រឹក្សាភិបាល និង សមាជិក សមាជិកា របស់ សមាគម សរុប ចំនួន ២០០ រូប ចូល ក្រាប បង្គំ គាល់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា និង សម្ដេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៅ ព្រះបរម រាជ វាំង ។
អ្នក ឧកញ៉ា ហ៊ុន ឡាក់ អគ្គ លេខាធិការ សមាគម ឧកញ៉ា កម្ពុជា បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង ថា កម្មវត្ថុ នៃ ការចូល គាល់ ព្រះមហាក្សត្រ និង ហ្លួង ម៉ែ នៅ ថ្ងៃស្អែក នេះ គឺ ដើម្បី ថ្វាយ របាយការណ៍ អំពី វឌ្ឍនភាព នៃ សមាគម ឧកញ៉ា កម្ពុជា និង ការនាំយក តង្វាយ សប្បុរសធម៌ ពី សប្បុរ ជន ដែល ជា អ្នក ឧកញ៉ា ឧកញ៉ា នៃ សមាគម ឧកញ៉ា កម្ពុជា ចំនួន ៧១ រូប ។
អាជ្ញាធរ ជាតិ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ជូនដំណឹង ជ្រើសរើស មន្ដ្រី សម្រុះសម្រួល ដោះស្រាយ វិវាទ ចំនួន ៣០ រូប
( ភ្នំពេញ ) ៖ អាជ្ញាធរ ជាតិ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ នៅ ថ្ងៃទី ១៩ ខែមករា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការជ្រើសរើស មន្ដ្រី សម្រុះសម្រួល ដោះស្រាយ វិវាទ ចំនួន ៣០ រូប និង ផ្ដល់ អាទិភាព សម្រាប់ អ្នក ធ្លាប់ បម្រើ ការងារ ផ្នែក ច្បាប់ ឬ មន្ដ្រី ផ្នែក ច្បាប់ ដែល បាន ចូលនិវត្តន៍ ។
ក្នុង សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា មន្ដ្រី ចំនួន ៣០ រូប ត្រូវ ជ្រើសរើស ពី ក្នុង ចំណោម បេក្ខជន ដែល មាន សញ្ញាតិ ខ្មែរ និង មិន ធ្លាប់ ត្រូវបាន ផ្តន្ទាទោស ពី បទឧក្រិដ្ឋ ឬ បទ មជ្ឈិម ព្រមទាំង មាន គុណ វុឌ្ឍ ណាមួយ ដូច ខាងក្រោម៖
