( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃពុធ ៣កើត ខែកត្តិក ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា អធិបតី កិត្តិយស ក្រុមប្រឹក្សា ជាំ តិរណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា នឹង អញ្ជើញ ចូលរួម មហាសន្និបាត រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា លើក ទី៦ ដែល រៀបចំឡើង នៅ សណ្ឋាគារ សុខា ។
មហាសន្និបាត នេះ រៀបចំឡើង ដើម្បី ពិនិត្យ ឡើងវិញ សកម្មភាព ការងារ ដែល បាន ធ្វើ នា ពេល កន្លងមក និង ដាក់ ចេញ ផែនការ ក៏ ដូចជា គោលដៅ ការងារ សម្រាប់ អនុវត្តន៍ បន្ត ។
នាយ ឧត្តមសេនីយ៍ ស ថេត បង្ហាញ ការប្ដេជ្ញាចិត្ត ខ្ពស់ ក្រោយ ជាប់ ឆ្នោត ជា ប្រធាន សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា
( ភ្នំពេញ ) ៖ មហាសន្និបាត សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន បោះឆ្នោត ជ្រើសរើស នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ជា ប្រធាន សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា សម្រាប់ អាណត្តិ ទី៥ ។
ក្នុង ពិធី បិទ មហាសន្និបាត ដែល ធ្វើឡើង ក្រោម អធិបតីភាព លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន កិត្តិយស សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា . នាយ ឧត្តមសេនីយ៍ ស ថេត បាន ប្រកាស ជា ឱឡារិក និង បង្ហាញ ពី ការប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ក្រោយ ជាប់ ឆ្នោត ជា ប្រធាន សម្រាប់ អាណត្តិ ថ្មី នេះ ។
ក្នុង នាម ប្រធាន គណៈកម្មាធិការ កណ្តាល នៃ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា នាយ ឧត្តមសេនីយ៍ ស ថេត បាន ធ្វើ ការប្ដេជ្ញាចិត្ត ប្រកបដោយ ការទទួលខុសត្រូវ ដូច ខាងក្រោម៖
* ទី១៖ ខិតខំ យកចិត្តទុកដាក់ អនុវត្ត ឱ្យ បាន ត្រឹមត្រូវ ទៅ តាម លក្ខន្តិកៈ កំណត់ របស់ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា
* ទី២៖ ធ្វើ ការចង្អុល ដឹកនាំ តម្រង់ ទិស ក្នុង ជួរ គណៈកម្មាធិការ កណ្ដាល និង គ្រប់ គណៈកម្មាធិការ មូលដ្ឋាន ព្រមទាំង គណៈកម្មការទស្សនាវដ្ដី មិត្ត នគរបាល ដើម្បី អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ និង ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ តាម សេចក្តីសម្រេចចិត្ត របស់ អង្គ មហាសន្និបាត សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា នា ពេលនេះ
* ទី៣៖ ប្រមូលផ្ដុំ ការគាំទ្រ ពីសំណាក់ សមាជិក សមាជិកា នៃ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ដោយ ខិតខំ ពុះពារ ស្វែងរក ធនធាន ក៏ ដូចជា វិធានការ និង វិធីសាស្ត្រ ថ្មី ៗ ដើម្បី ធ្វើ ការអភិឌ្ឍ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ឲ្យ មាន គុណភាព និង មាន ភាពរីកចម្រើន ឡើង ថែម ទៀត ក្នុង គោលដៅ ពង្រីក នូវ លទ្ធភាព ទំនុកបម្រុង ឧបត្ថម្ភ គាំទ្រ និង ដោះស្រាយ ទុក្ខ ធុរៈ របស់ សមាជិក សមាជិកា នៃ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ឲ្យ កាន់តែ មាន វិសាល ភាព ទូលំទូលាយ បន្ថែម ទៀត
* ទី៤៖ រៀបចំ សន្និបាត វិសាមញ្ញ នៅក្នុង ពេលវេលា ដ៏ សមស្រប ដើម្បី ធ្វើ វិសោធនកម្ម លក្ខន្តិកៈ កែសម្រួល បំពេញ បន្ថែម សមាសភាព គណៈកម្មាធិការ កណ្តាល និង រៀបចំ រចនាសម្ព័ន្ធ ចាត់តាំង ឲ្យបាន សមស្រប សំដៅ ពង្រឹង ប្រសិទ្ធភាព ការងារ របស់ សមាគម ឲ្យ កាន់តែ មាន វឌ្ឍនភាព បន្ថែម ទៀត នា ពេល អនាគត ។
គិត ត្រឹម ខែសីហា ឆ្នាំ ២០២៣ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា មាន សមាជិក ចំនួន ៧៨. ០៦៩ នាក់ ក្នុង នោះ មាន សមាជិក សមាគម ជា មន្ត្រី នគរបាល ចំនួន ៦. ១៨៩៧ នាក់ សមាជិក ជា មន្ត្រី នគរបាល ដែល បាន ចូលនិវត្តន៍ ចំនួន ១៦. ១៧០ នាក់ និង មន្ដ្រី នគរបាល ពិការ ដែល ស្ម័គ្រចិត្ត នៅ បន្ត ជា សមាជិកភាព របស់ សមាគម ចំនួន ០២ នាក់ ៕
អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ សេចក្តីសម្រេច គោលការណ៍ ណែនាំ ពាក់ព័ន្ធ នានា និង ស្តាប់ របាយការណ៍ ស្តីពី វឌ្ឍនភាព ក្នុង ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន
( ស្ទឹងត្រែង ) ៖ នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង បាន រៀបចំ ពិធី ផ្សព្វផ្សាយ សេចក្តីសម្រេច គោលការណ៍ ណែនាំ នានា និង របាយការណ៍ វឌ្ឍនភាព ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខេត្ត ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង នគ បាល ជាតិ និង ជា អគ្គ លេខាធិការ រង នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង លោក ធូ ចាន់ ពៅ អភិបាល រង ខេត្ត និង ជា ប្រធាន លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន ខេត្ត ។
* ទី១៖ ជំរុញ ការងារ ផ្សព្វផ្សាយ អប់រំ * ទី ២៖ ធ្វើ ផែនការ សកម្មភាព បន្ត សម្រាប់ ដឹកនាំ អនុវត្ត ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន *ទី ៣៖ ជំរុញ ការដឹកនាំ អនុវត្ត ផែនការ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន លើក ទី៨ ។
ឆ្លៀត ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ បាន ថ្លែង សាទ រ និង កោតស សើរ គណៈកម្មាធិការ ត្រូត ពិនិត្យ គ្រឿងញៀន ខេត្ត ស្ទឹងត្រែង និង អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន ខិតខំ រួមគ្នា ប្រកបដោយ ការទទួលខុសត្រូវ សម្រេចបាន នូវ លទ្ធផល បាន ល្អ ប្រសើរ លើ ការងារ ត្រួតពិនិត្យ គ្រឿងញៀន នាំមក នូវ សុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ។
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៥.៩៦៥ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥.១៤៦ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៨១៩ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង អត់ បណ្ណ បើកបរ ល្មើស ភ្លើង - ផ្លាក សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ឆៀក ស្រវឹង ដឹក សំពីង សំពោង គ្មាន ភ្លើង បំភ្លឺ ល្មើស ភ្លើង - ផ្លាក សញ្ញា អត់ បណ្ណ បើកបរ និង ល្មើស ល្បឿន ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៩ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៥ នាក់ របួស ចំនួន ១០នាក់ ( របួស ធ្ងន់ ចំនួន ០៦ នាក់ ) ។ រយៈពេល ១៤ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១១៩ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៥៥នាក់ របួស ១៦៣ នាក់ ( របួស ធ្ងន់ ១០៧ នាក់ )៕
និយ័តករ មូលបត្រ កម្ពុជា ចែករំលែក ចំណេះដឹង ពាក់ព័ន្ធ ការវិនិយោគ លើ ផលិតផល វិនិយោគ ស្រប ច្បាប់ និង ស្គាល់ ពី គម្រោង វិនិយោគ ឆបោក
( ភ្នំពេញ ) ៖ ដើម្បី រួមចំណែក ក្នុង ការលើកកម្ពស់ ការយល់ដឹង ពាក់ព័ន្ធ នឹង ការវិន យោគ និយ័តករ មូលបត្រ កម្ពុជា បាន រៀបចំ នូវ អត្ថបទ មួយ ពន្យល់ យ៉ាង លម្អិត លើ ការវិនិយោគ លើ ផលិតផល វិនិយោគ ស្រប ច្បាប់ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង នៃ អត្ថបទ របស់ និយ័តករ មូលបត្រ កម្ពុជា៖
នៅពេល វិនិយោគ ជាធម្មតា វិនិយោគិន មាន ទំនោរ ផ្តោត សំខាន់ លើ ការទទួលបាន ប្រាក់ ចំណេញ ខ្ពស់ និង ការយល់ដឹង ផ្ទាល់ខ្លួន ដោយ មិន ផ្តោត លើ កត្តា ហានិភ័យ ដែល ជា កត្តា ដ៏ សំខាន់ សម្រាប់ ថ្លឹងថ្លែង ការវិនិយោគ នោះ ឡើយ ។
ផ្អែក លើ ទិន្នន័យ កន្លងមក ហានិភ័យ និង ប្រាក់ ចំនេញ មាន ទំនាក់ទំនង ជាមួយគ្នា ដោយ ផ្ទាល់ ។ ប្រាក់ ចំណេញ ពី ការវិនិយោគ ជាក់លាក់ ណាមួយ កាន់តែ ខ្ពស់ នឹង បង្កើន ហានិភ័យ កាន់តែ ខ្ពស់ ។
ជាទូទៅ ដើម្បី កាត់បន្ថយ ហានិភ័យ ការវិនិយោគ គួរតែ ធ្វើឡើង នៅលើ ឬ លើស ពី បន្ទាត់ ហានិភ័យ ។ លើស ពី នេះ វិនិយោគិន គួរ ជ្រើសរើស ផលិតផល វិនិយោគ ដែល ស្រប ច្បាប់ ។
នៅពេល វិនិយោគ វិនិយោគិន គួរតែ ពិនិត្យមើល ថា តើ គម្រោង វិនិយោគ មាន ការគ្រប់គ្រង ត្រឹមត្រូវ . មិន មាន ការគ្រប់គ្រង ឬ ជា គម្រោង ឆបោក ។ ផលិតផល វិនិយោគ ស្ថិត ក្រោម និយ័តកម្ម ជាទូទៅ ស្ថិត ក្រោម ការត្រួតពិនិត្យ យ៉ាង តឹងរ៉ឹង ដោយ និយ័តករ ក្នុង ប្រទេស មួយ ។ ការណ៍ នេះ ធ្វើឱ្យ ផលិតផល វិនិយោគ ដែល ស្ថិត ក្រោម និយ័តកម្ម ជា ជម្រើស ដែល មាន សុវត្ថិភាព បើ ប្រៀបធៀប ទៅនឹង ផលិតផល វិនិយោគ ផ្សេង ទៀត ។
ជាទូទៅ ផលិតផល វិនិយោគ ដែល ស្ថិត ក្រោម និយ័តកម្ម មាន លក្ខណៈ ដូច ជា៖ - ទទួលបាន ការអនុញ្ញាត ពី និយ័តករ . - គ្រប់គ្រង ដោយ ក្រុមហ៊ុន គ្រប់គ្រង មូលនិធិ ដែល ទទួលបាន អាជ្ញាបណ្ណ . - មាន ឯកសារ ផ្លូវ ច្បាប់ និង ឯកសារ ផ្តល់ ព័ត៌មាន ត្រឹមត្រូវ ហើយ ជាធម្មតា ឯកសារ ទាំង នេះ ត្រូវបាន ធ្វើ សវនកម្ម ដោយ ក្រុមហ៊ុន សវនកម្ម ដែល ទទួលបាន ការទទួលស្គាល់ ពី និយ័តករ ។ ដូច្នេះ ហានិភ័យ នៃ គម្រោង វិនិយោគ ដែល ស្ថិត ក្រោម និយ័តកម្ម ជា គម្រោង ក្លែងបន្លំ គឺ ស្ថិត នៅក្នុង កម្រិត ទាប បំផុត ។
* បច្ចុប្បន្នភាព នៃ ទីផ្សារ គម្រោង វិនិយោគ រួម នៅ កម្ពុជា
ដោយ សម្លឹង ឃើញ ពី សក្តានុពល នៃ ទីផ្សារ គម្រោង វិនិយោគ រួម ចំពោះ កំណើន សេដ្ឋកិច្ច ជាតិ និយ័តករ មូលបត្រ កម្ពុជា ( ន .ម .ក . ) ដែល ជា អាជ្ញាធរ គ្រប់គ្រង ត្រួតពិនិត្យ និង អភិវឌ្ឍ ទីផ្សារ មូលបត្រ នៅ កម្ពុជា បាន រៀបចំ នូវ ហេដ្ឋារចនាសម្ព័ន្ធ ដើម្បី ដាក់ ឱ្យ ដំណើរការ ទីផ្សារ នេះ តាមរយៈ ការដាក់ចេញ នូវ ក្របខណ្ឌ បទប្បញ្ញត្តិ ដើម្បី គ្រប់គ្រង ទីផ្សារ នេះ ។
បន្ថែម ពី នេះ កាលពី ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២៣ កន្លងទៅ ន .ម .ក . ក៏ បាន ដាក់ចេញ នូវ ប្រកាស ស្តីពី « ការបោះផ្សាយ លក់ មូលនិធិ នៃ គម្រោង វិនិយោគ រួម » ដើម្បី កំណត់ ពី លក្ខខណ្ឌ . នីតិវិធី នៃ ការបោះផ្សាយ លក់ ឯក តា មូលនិធិ នៃ គម្រោង វិនិយោគ រួម និង ប្រតិបត្តិការ របស់ មូលនិធិ បន្ទាប់ពី ការបោះផ្សាយ ដើម្បី ធានា បាន នូវ សណ្តាប់ធ្នាប់ . គណនេយ្យភាព និង តម្លាភាព នៅក្នុង ទីផ្សារ សំដៅ ការពារ ភាគី ពាក់ព័ន្ធ ដែល រួម មាន វិនិយោគិន នៅក្នុង ទីផ្សារ ។
* ផលិតផល វិនិយោគ ដែល មិន ស្ថិត ក្រោម និយ័តកម្ម
* គម្រោង វិនិយោគ បោកប្រាស់ ឬ ក្លែង បន្លំ
- ក្នុង នោះ វា ក៏ មាន របាយការណ៍ អំពី គម្រោង វិនិយោគ ដីធ្លី ដែល បង្ករ ឱ្យ មាន កំហឹង ហើយ ត្រូវបាន ចោទប្រកាន់ ជា គម្រោង ឆបោក ផងដែរ ។ ប្រតិបត្តិករ ខ្លះ ត្រូវបាន ចាប់ខ្លួន . ចោទប្រកាន់ និង ដាក់ទោស តាម ផ្លូវ ច្បាប់ ។ គម្រោង វិនិយោគ ដីធ្លី បោកប្រាស់ ទាំងនេះ តែងតែ សន្យា ថា នឹង ផ្តល់ ផល ចំណេញ ខ្ពស់ ។ ការណ៍ នេះ បង្ហាញ ពី កង្វះ នូវ តម្លាភាព អំពី វិធីសាស្ត្រ ដែល មូលនិធិ ត្រូវបាន វិនិយោគ ដោយ រួមបញ្ចូល ទាំង វឌ្ឍនភាព និង លំហូរ សាច់ប្រាក់ នៃ គម្រោង ។
វា ពិតជា សំខាន់ ក្នុង ការកត់សម្គាល់ ពី ភាពខុសគ្នា រវាង គម្រោង វិនិយោគ ដែល ស្រប ច្បាប់ តែ វិវឌ្ឍ ទៅជា ស្ថានភាព មិន ល្អ និង គម្រោង វិនិយោគ បោក បញ្ឆោត ។ គ្រប់ ការវិនិយោគ ត្រូវ ហ៊ាន ទទួលយក ហានិភ័យ ដើម្បី ទទួលបាន ផលចំណេញ ។ វា មាន ឧទាហរណ៍ ជាច្រើន នៃ ការវិនិយោគ ដែល ស្រប ច្បាប់ តែ វិវឌ្ឍ ទៅជា ស្ថានភាព មិន ល្អ ដោយសារ លក្ខ - ខណ្ឌ ទីផ្សារ មិន ល្អ និង ហេតុផល ផ្សេង ទៀត ។
ការបោកបញ្ឆោត កើតឡើង នៅ ពេល ដែល សាច់ប្រាក់ ដែល ប្រមូល បាន ពី វិនិយោគិន មិន ត្រូវបាន យក ទៅ វិនិយោគ នៅក្នុង គម្រោង ណាមួយ ជាក់លាក់ ។ ផ្ទុយទៅវិញ ប្រាក់ ចំណេញ ត្រូវបាន ប្រឌិត ឡើង ដោយ ប្រើប្រាស់ សាច់ប្រាក់ ពី វិនិយោគិន ថ្មី ដើម្បី ទូទាត់ វិនិយោគិន ចាស់ ។ គម្រោង ទាំងនេះ ត្រូវបាន គេ ស្គាល់ ថា ជា គម្រោង Ponzi ។ រាល់ ប្រតិបត្តិករ បោកប្រាស់ ទាំងនោះ មិន ទទួលបាន ការអនុញ្ញាត / អាជ្ញា បណ្ណ ដោយ និយ័តករ នោះ ឡើយ ។
* ការសន្និដ្ឋាន ដើម្បី ស្វែងរក ការវិនិយោគ ស្រប ច្បាប់ វិនិយោគិន គួរតែ ពិចារណា លើ ចំណុច មួយចំនួន ដូច ខាងក្រោម៖ - តើ ក្រុមហ៊ុន គ្រប់គ្រង ដោយ អាជ្ញាធរ ពាក់ព័ន្ធ ដែរ ឬ ទេ ? - តើ ផលិតផល វិនិយោគ ទទួលបាន ការអនុញ្ញាត ពី អាជ្ញាធរ ពាក់ព័ន្ធ ដែរ ឬ ទេ ? - តើ ការវិនិយោគ ស័ក្តិសម ទៅនឹង ប្រាក់ ចំណេញ ដែល បាន សន្យា ដែរ ឬ ទេ ? - តើ គម្រោង វិនិយោគ រួម មាន ការត្រួតពិនិត្យ និង ផ្ទៀងផ្ទាត់ ពី មេធាវី . សវនករ និង អ្នកជំនាញ ឯករាជ្យ ផ្សេង ទៀត ដែរ ឬ ទេ ?
( ភ្នំពេញ ) ៖ រដ្ឋាភិបាល ជប៉ុន តាមរយៈ ស្ថានទូត ប្រចាំ កម្ពុជា បាន ចុះហត្ថលេខា ផ្ដល់ ថវិកា ចំនួន ៤២៤. ៩០៧ ដុល្លារ អាមេរិក ដល់ ស្ថាប័ន ទទួល ជំនួយ ចំនួន ៣ ក្រោម គ្រោងការណ៍ ជំនួយ ឥត សំណង សម្រាប់ គម្រោង ទ្រង់ទ្រាយ តូច សន្តិសុខ មនុស្សជាតិ ( គូសាណូណ៌ ) ដើម្បី ស្តារ ប្រព័ន្ធ ធារាសាស្ត្រ ថ្នល់ ដាច់ ក្នុង ខេត្ត ឧត្តរមានជ័យ . គម្រោង សាងសង់ ស្ពាន ក្នុង ស្រុក កំពង់លែង ខេត្ត កំពង់ឆ្នាំង និង គម្រោង សាងសង់ ស្ពាន ក្នុង ឃុំ អូរ ម្រះ ស្រុក សៀម បូក ខេត្ត ស្ទឹងត្រែង ។
កិច្ចសន្យា ផ្តល់ ជំនួយ ត្រូវបាន ចុះហត្ថលេខា នៅ ថ្ងៃថ ទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ដោយ លោក តា និណៃ អ៊ុំ ឈិតុ ម៉ុ ភារ ធារី ស្តី ទី នៃ ស្ថានទូត ជប៉ុន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា និង អ្នកតំណាង ស្ថាប័ន ទទួល ជំនួយ ទាំង៣ ។
ទី១៖ គម្រោង ស្តារ ប្រព័ន្ធ ធារាសាស្ត្រ ថ្នល់ ដាច់ ក្នុង ខេត្ត ឧត្តរមានជ័យ ( ថវិកា ចំនួន ១១៩. ៤២៤ ដុល្លារ អាមេរិក ) សា្ថប័ន ទទួល ជំនួយ៖ មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត ឧត្តរមានជ័យ ។
ជំនួយ នេះ នឹង ត្រូវបាន ប្រើប្រាស់ ដើម្បី ស្តារ ប្រព័ន្ធ ធារាសាស្ត្រ មាន ស្រាប់ ដែល មាន មុខងារ អាង ស្ដុក ទឹក អន់ ថយ ។ តំបន់ នេះ ងាយ រងគ្រោះ រាំងស្ងួត ក្នុង រដូវ ប្រាំង ដោយសារ ប្រព័ន្ធ ធារាសាស្ត្រ មិន អាច ស្តុក ទឹក បាន គ្រប់គ្រាន់ ក្នុង រដូវ វស្សា ។ មិន តែ ប៉ុណ្ណោះ ដោយសារ សមត្ថភាព ស្តុក ទឹក មិន គ្រប់គ្រាន់ តំបន់ នេះ ជារឿយ ៗ រង ផល ប៉ះពាល់ ដោយ ទឹក ជំនន់ ។ ផ្លូវ តភ្ជាប់ ពី ប្រព័ន្ធ ធារាសាស្ត្រ នេះ ទៅ តំបន់ ដែល ប្រជាជន រស់ នៅ មាន ស្ថានភាព យ៉ាប់ យឺន ដែល ដាក់បន្ទុក យ៉ាង ធ្ងន់ ដល់ កសិករ ។
តាមរយៈ ជំនួយ នេះ រំពឹង ថា គម្រោង នេះ នឹង ផ្តល់ អត្ថប្រយោជន៍ ដល់ ប្រជាជន មូលដ្ឋាន ប្រមាណ ១.០០០ នាក់ តាមរយៈ ការកែលម្អ ប្រព័ន្ធ ធារាសាស្ត្រ ដើម្បី ធានា ការផ្គត់ផ្គង់ ទឹក សម្រាប់ កសិកម្ម ប្រកបដោយ ស្ថិរភាព ពេញ មួយ ឆ្នាំ ។ លើស ពី នេះ រំពឹង ថា កម្រិត ជីវភាព រស់ នៅ និង ប្រាក់ ចំណូល របស់ ប្រជាជន នឹង មាន ភាពប្រសើរឡើង ដោយសារ មាន ការកើនឡើង នៃ បរិមាណ ស្រូវ ដែល ផលិត បាន នៅក្នុង តំបន់ នេះ ។
ទី២៖ គម្រោង សាងសង់ ស្ពាន ក្នុង ស្រុក កំពង់លែង ខេត្ត កំពង់ឆ្នាំង ( ថវិកា ចំនួន ១៣៧. ២០៧ ដុល្លារ អាមេរិក ) សា្ថប័ន ទទួល ជំនួយ៖ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កំពង់ឆ្នាំង ។
ទី៣៖ គម្រោង សាងសង់ ស្ពាន ក្នុង ឃុំ អូរ ម្រះ ស្រុក សៀម បូក ខេត្ត ស្ទឹងត្រែង ( ថវិកា ចំនួន ១៦៨. ២៧៦ ដុល្លារ អាមេរិក ) សា្ថប័ន ទទួល ជំនួយ៖ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ស្ទឹងត្រែង ។
ជំនួយ នេះ នឹង ត្រូវបាន ប្រើប្រាស់ ដើម្បី សង់ ស្ពាន បេតុង ថ្មី មួយ ជំនួស ឱ្យ ស្ពាន ឈើ ពុក ផុយ បច្ចុប្បន្ន ខណៈ ដែល ប្រជាជន មូលដ្ឋាន ជាច្រើន តែងតែ ឆ្លងកាត់ ស្ពាន នេះ ដើម្បី ទៅ សាលារៀន កន្លែង ធ្វើការ និង មន្ទីរពេទ្យ ព្រមទាំង ដឹកជញ្ជូន កសិផល ស្ពាន នេះ បាន រង ការខូចខាត និង គ្មាន សុវត្ថិភាព ជាពិសេស សម្រាប់ កុមារ និង មនុស្ស ចាស់ ។ បន្ថែម ពី នេះ ដោយសារ ចំនួន រថយន្ត ធុន ធ្ងន់ ត្រូវបាន រំពឹង ថា នឹង មាន ការកើនឡើង ស្ពាន បច្ចុប្បន្ន នេះ ប្រហែល មិន អាច ទ្រាំទ្រ បាន ទេ ហើយ ជា លទ្ធផល អាចនឹង មាន ការបាក់ ស្រុត ។
រំពឹង ថា គម្រោង នេះ នឹង ផ្តល់ អត្ថប្រយោជន៍ ដល់ ប្រជាជន ប្រមាណ ២. ៨០០នាក់ ក្នុង ភូមិ ចំនួន ៤ តាមរយៈ ការធានា បាន នូវ ផ្លូវ ធ្វើដំណើរ ប្រកបដោយ សុវត្ថិភាព ទៅ សាលារៀន ផ្សារ និង មណ្ឌល សុខភាព ដែល នៅជិត បំផុត ពេញ មួយ ឆ្នាំ ។ ការសាងសង់ ស្ពាន ថ្មី ក៏ នឹង ជួយ សម្រួល ដល់ ការដឹកជញ្ជូន កសិផល ផងដែរ ដែល យើង រំពឹង ថា នឹង កែលម្អ កម្រិត ជីវភាព រស់ នៅ របស់ ប្រជាជន និង បង្កើន ប្រាក់ ចំណូល កសិកម្ម ។
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស បំពេញ ទស្សនកិច្ច ជា មិត្តភាព និង ជា ផ្លូវការ នៅ សាធារណរដ្ឋ សង្គម និយម វៀតណាម នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន ដឹកនាំ គណៈប្រតិភូ យោធា ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ កម្ពុជា ចូល ជួប សម្តែង ការគួរសម លោក ហ្វាម មិញ ជីញ នាយក រដ្ឋមន្ត្រី នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម នា រសៀល ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ក្នុង ជំនួប នោះ លោក ហ្វាម មិញ ជីញ បាន សម្តែង ការអបអរសាទរ ចំពោះ លោក នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ដែល បាន អញ្ជើញ មក បំបេញ ទស្សនកិច្ច នៅ វៀតណាម លើក ដំបូង ក្នុង តួនាទី ជា លោក ជា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ កម្ពុជា ហើយ លោក បាន ជូន ពរ គណៈប្រតិភូ ក្រសួង ការពារ ជាតិ កម្ពុជា បំពេញ ទស្សនកិច្ច ទទួលបាន ជោគជ័យ នៅ វៀតណាម ដើម្បី រួមចំណែក ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស យើង ទាំង ពីរ កាន់ មាន ប្រសិទ្ធភាព និង បន្ត អភិវឌ្ឍ ចំណង មិត្តភាព ប្រទេស ទាំង ពីរ អោយ កាន់តែ រីកចំរើន ។
លោក ហ្វាម មិញ ជីញ បាន បញ្ជាក់ ថា៖ « ប្រទេស យើង ទាំង ពីរ កម្ពុជា វៀតណាម មាន ទំនាក់ទំនង ជា ប្រវត្តិសាស្រ្ត ជាមួយគ្នា តាំងពី យូរ លុង ណាស់ មកហើយ ហើយ ធ្លាប់ បាន រួម សាមគ្គី គ្នា ត ស៊ូ ជំនះ រាល់ ការលំបាក និង មាន កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា ក្នុង គោលដៅ អភិវឌ្ឍ ប្រទេស នីមួយ ៗ អោយ មាន ការរីកចម្រើន » ។
មាន មតិ ឆ្លើយតប វិញ លោក នាយ ឧត្តមសេនីយ៍ ទៀ សីហា បាន បញ្ជាក់ ថា៖ « ការបំពេញ ដំណើរទស្សនកិច្ច មិត្តភាព និង ជា ផ្លូវការ នៅ វៀតណាម គឺជា ដំណើរទស្សនកិច្ច លើក ដំបូង និង ជា ប្រវត្តិសាស្រ្ត ដើម្បី បន្ត ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ផ្នែក នយោបាយ សន្តិសុខ និង សង្គម ជាមួយ មិត្ត វៀតណាម ក្នុង ការកសាង សហគមន៍ ជាមួយគ្នា កម្ពុជា - វៀតណាម » ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក នាយ ឧត្តមសេនីយ៍ ទៀ សីហា បាន ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល កងទ័ព និង ប្រជាជន វៀតណាម ដែល ជានិច្ចកាល តែងតែ ផ្តល់ ការគាំទ្រ ដល់ កងយោធពល ខេមរភូមិន្ទ ក៏ ដូចជា កម្ពុជា ទាំងមូល នូវ កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ ។ ជាក់ស្តែង ក្នុង អំឡុង ពេល នៃ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ភាគី វៀតណាម បាន ផ្តល់ នូវ ជំនួយ និង ការគាំទ្រ ជាច្រើន រួមទាំង សម្តារ និង ស្មារតី ។
កាយវិការ ដ៏ ថ្លៃថ្លា នេះ បាន បញ្ជាក់ ឱ្យ ឃើញ កាន់តែ ច្បាស់ នូវ ចំណង មិត្តភាព សាមគ្គីភាព ម នោសញ្ចេតនា និង ការគោរព រាប់អាន ដ៏ ស្មោះ របស់ កងទ័ព និង ប្រជាជន វៀតណាម ទាំងមូល ជូន ចំពោះ កងទ័ព និង ប្រជាជន កម្ពុជា ក្នុង ស្មារតី លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ ៕
ទេសរដ្ឋមន្ត្រី សុក ស៊ី ផាន់ ណា៖ ការវិនិយោគ របស់ ចិន ក្នុង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត នៅ កម្ពុជា បាន រួមចំណែក ទាក់ទាញ ការវិនិយោគ ផ្ទាល់ ពី បរទេស ពិសេស វិស័យ ផលិតកម្ម
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ បណ្ឌិត សភាចារ្យ សុក ស៊ី ផាន់ ណា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស បាន លើកឡើង ថា ការវិនិយោគ សំខាន់ ៗ របស់ ចិន ក្នុង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត កម្ពុជា បាន រួមចំណែក ទាក់ទាញ ការវិនិយោគ ផ្ទាល់ ពី បរទេស ពិសេស វិស័យ ផលិតកម្ម ដែល កត្តា ទាំងនេះ ជួយ ឲ្យ ប្រសើរឡើង នូវ ការប្រកួតប្រជែង របស់ កម្ពុជា ។
ការលើកឡើង របស់ លោក សុក ស៊ី ផាន់ ណា ធ្វើឡើង ក្នុង ឱកាស ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ចូលរួម កិច្ចប្រជុំ កំពូល « សេដ្ឋកិច្ច និង បច្ចេកវិទ្យា ចិន សកល ឆ្នាំ ២០២៣ » ក្រោម ប្រធានបទ ការបង្កើន អនុភាព នៃ កំណើន បច្ចេកវិទ្យា និង វិបុលភាព ក្នុង តំបន់ រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ៦ - ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ ទីក្រុង សិន ជិន ប្រទេស ចិន ។
កិច្ចប្រជុំ នេះ រៀបចំឡើង ក្នុង គោលបំណង ជំរុញ កាលានុវត្តភាព សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ក្នុង ចំណោម ប្រទេស ជា សមាជិក នៃ កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ ក្នុង តំបន់ ( អាសិប ) និង ផ្តោត លើ កិច្ចពិភាក្សា ទាក់ទង នឹង សក្តានុពល របស់ ក្រុម ប្រទេស BRICS អាច ក្លាយជា កម្លាំង សេដ្ឋកិច្ច ដ៏ មាន ឥទ្ធិពល ក្នុង ពិភពលោក ពហុ ប៉ូល និង បាន ស្វែងយល់ បន្ថែម អំពី តួនាទី របស់ ប្រទេស ចិន ក្នុង បម្លាស់ ប្តូរ អំណាច សកល ។
លោក សាស្ត្រាចារ្យ បណ្ឌិត សភាចារ្យ សុក ស៊ី ផាន់ ណា បាន លើកឡើង ថា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី កម្ពុជា - ចិន និង អាសិប បាន ផ្លាស់ប្ដូរ ទិដ្ឋភាព ពាណិជ្ជកម្ម របស់ កម្ពុជា យ៉ាង ខ្លាំង ដោយ ផ្ដល់ នូវ ទីផ្សារ ថ្មី សម្រាប់ ផលិតផល កសិកម្ម និង ទំនិញ របស់ កម្ពុជា ។
លោក សាស្ត្រាចារ្យ គូសបញ្ជាក់ ពី ការផ្លាស់ប្តូរ សណ្តាប់ធ្នាប់ ពិភពលោក និង ភាពចាំបាច់ នៃ ប្រព័ន្ធ ពហុ ភាគី និយម ក្នុង ការដោះស្រាយ នូវ បញ្ហា ប្រឈម សកល នៃ សតវត្ស ទី ២១ ។
លោក សង្កត់ធ្ងន់ ថា បច្ចុប្បន្ន ក្រុម ប្រទេស BRICS បាន ក្លាយជា មហាអំណាច សេដ្ឋកិច្ច ជា យុទ្ធសាស្ត្រ នៅក្នុង ពិភពលោក ពហុ ប៉ូល ធ្វើឱ្យ ចិន ក្លាយជា ទីផ្សារ សេដ្ឋកិច្ច ដ៏ សំខាន់ របស់ ពិភពលោក ។
កាសែត បាងកក ប៉ុស្តិ៍ បាន រាយការណ៍ ថា វិធានការ នេះ មាន គោលដៅ គាំទ្រ ដល់ ការអភិវឌ្ឍ គុណភាព ស្រូវ ដោយ ផ្តល់ ជូន កសិករ នូវ ទឹកប្រាក់ ១ពាន់ បាត ក្នុង ១រ៉ៃ ដែល ផ្តល់ ជូន មិន លើស ២០រ៉ៃ ក្នុង ១គ្រួសារ ឬ សរុប ជា ទឹកប្រាក់ ចំនួន ២ម៉ឺន បាត ។ គម្រោង នេះ រំពឹង ថា នឹង ផ្តល់ អត្ថប្រយោជន៍ ដល់ ពលរដ្ឋ ថៃ ចំនួន ៤. ៦៨លាន គ្រួសារ ។
កាលពី ថ្ងៃទី ៧ ខែវិច្ឆិកា គណៈ រដ្ឋមន្ត្រី បាន អនុម័ត វិធានការគាំទ្រ ស្រូវ នានា ដែល មាន ទឹកប្រាក់ សរុប ៥៥ ពាន់ លាន បាត រួមទាំង ប្រាក់ កម្ចី ផងដែរ ដើម្បី ផ្តល់ ជូន កសិករ ឱ្យ ពន្យារ ពេល លក់ ស្រូវ ដែល មាន កម្រិត សំណើម ២៥% ក្នុង រយៈពេល ៥ខែ និង ប្រាក់ កម្ចី សម្រាប់ ផ្តល់ ជូន សហករណ៍ កសិកម្ម ក្នុង ការធ្វើអន្តរាគមន៍ ក្នុង វិស័យ កសិកម្ម តាមរយៈ ការទិញ ស្រូវ ពី ក្នុង ទីផ្សារ រហូតដល់ តម្លៃ មាន ភាព អំណោយផល ។
ស្ថិត ក្រោម វិធានការ ដែល ឱ្យ កសិករ ពន្យារ ការលក់ ស្រូវ របស់ ខ្លួន រយៈពេល ៥ខែ រដ្ឋាភិបាល ថៃ នឹង ធ្វើ អន្តរាគមន៍ លើ ទីផ្សារ ដោយ ផ្តល់ ជូន អ្នកចូលរួម អនុវត្ត វិធានការ នេះ ចំនួន ១២ ០០០ បាត ក្នុង មួយ តោន និង បន្ថែម ១ ៥០០ បាត ក្នុង មួយ តោន សម្រាប់ ការស្តុក ទុក ។
គណៈកម្មាធិការ គោល នយោបាយ ស្រូវ ជាតិ បាន ឱ្យដឹង ថា រដ្ឋាភិបាល ថៃ ចង់ ស្រូបយក ស្រូវ ចំនួន ៣លាន តោន ស្ថិត ក្រោម គម្រោង នេះ ។
លោក Phumtham បាន និយាយ ថា វិធានការគាំទ្រ ស្រូវ ចុងក្រោយ នេះ ទំនងជា នឹង ដាក់ ជូន គណៈ រដ្ឋមន្ត្រី សម្រាប់ ការអនុម័ត នៅ ថ្ងៃអង្គារ ទី ១៤ ខែវិច្ឆិកា នេះ ហើយ កាលវិភាគ បឋម សម្រាប់ ការបញ្ចេញ សាច់ប្រាក់ នឹង ធ្វើឡើង ចាប់ពី ខែវិច្ឆិកា ដល់ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០២៤ ។
យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ក្រសួង ពាណិជ្ជកម្ម ថៃ បាន ប៉ាន់ប្រមាណ ថា ទិន្នផល ស្រូវ សម្រាប់ ឆ្នាំ ដាំដុះ ២០២៣ / ២០២៤ មាន ចំនួន ៣២លាន តោន ដោយ ទិន្នផល ពី រដូវ ដាំដុះ ធំ មាន ចំនួន ២៥. ៦លាន តោន ធ្លាក់ចុះ ៦% ធៀប នឹង ឆ្នាំ មុន ហើយ ទិន្នផល ស្រូវ បាន មកពី ការដាំដុះ ខុស រដូវ សរុប មាន ចំនួន ៦. ៧៨លាន តោន ធ្លាក់ចុះ ១២% ៕
ប្រធានាធិបតី បារាំង លើកទឹកចិត្ត ឱ្យ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល ហ្វ្រង់ កូហ្វូនី នៅ ឆ្នាំ ២០២៦ ហើយ បាន សន្យា ថា បារាំង នឹង គាំទ្រ បេក្ខភាព កម្ពុជា
ដោយ បាន ដឹង ថា កម្ពុជា មាន ឆន្ទៈ ក្នុង ការទទួល រៀបចំ ព្រឹត្តិការណ៍ សំខាន់ មួយ របស់ អង្គការ ហ្វ្រង់ កូហ្វូនី លោក ប្រធានាធិបតី បារាំង បាន លើកទឹកចិត្ត ឱ្យ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល ហ្វ្រង់ កូហ្វូនី នៅ ឆ្នាំ ២០២៦ ហើយ បាន សន្យា ថា បារាំង នឹង គាំទ្រ បេក្ខភាព កម្ពុជា » ។
ជាថ្មី ម្ដង ទៀត ព្រះមហាក្សត្រ ខ្មែរ បាន មាន ព្រះបន្ទូល ថា កម្ពុជា ពិតជា មាន មោទនភាព នឹង ដាក់ បេក្ខភាព រៀបចំ កិច្ចប្រជុំ កំពូល ហ្វ្រង់ កូហ្វូនី នៅ ឆ្នាំ ២០២៦ ហើយ ព្រះអង្គ ទ្រង់ មាន ព្រះរាជ តម្រិះ ថា ការគាំទ្រ របស់ បារាំង មាន តម្លៃ យ៉ាង ខ្លាំង ពីព្រោះ កិច្ច គាំទ្រ នេះ នឹង ឆ្លុះបញ្ចាំង ពី ឆន្ទៈ ក្នុង ការពង្រឹង វត្តមាន ដ៏ មាន សារៈសំខាន់ របស់ បារាំង នៅ អាស៊ី ៕ រដ្ឋបាល រាជធានី ភ្នំពេញ រៀបចំ ពិធី ក្រុង ពាលី នៅ ស្ពាន កោះន រា - កោះ ពេជ្រ ខណៈ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ថ្ងៃស្អែក
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១៤ វិច្ឆិកា ឆ្នាំ ២០២៣ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ក្រុង ពាលី តាម បែប សាសនា ដើម្បី សុំ ម្ចាស់ ទឹក ម្ចាស់ ដី សុំ សេចក្តីសុខ ចំរុង ចំរើន នៅ មុន ស្ពាន បេតុង ខ្សែ កាប តភ្ជាប់ តំបន់ អភិវឌ្ឍន៍ កោះន រា និង កោះ ពេជ្រ ដែល នឹង ត្រូវ បើក សម្ពោធ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នា ថ្ងៃទី ១៥ វិច្ឆិកា ស្អែក នេះ ។
តាម គម្រោង ដែល បាន គ្រោង ទុក ស្ពាន បេតុង ខ្សែ កាប តភ្ជាប់ តំបន់ កោះន រា និង កោះ ពេជ្រ នឹង ត្រូវ សម្ពោធ ដាក់ ឲ្យិ ប្រើប្រាស់ ជា ផ្លូវការ នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ជា ប្រពៃណី ទំនៀមទំលាប់ បុរាណ របស់ ខ្មែរ មុននឹង សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ នូវ សមិទ្ធិផល ដែល ទើប បាន សាងសង់ រួច ឬ មុននឹង ចាប់ផ្តើម សាងសង់ សំណង់ ផ្សេង ៗ ដើម្បីឲ្យ ការសាងសង់ នោះ ប្រព្រឹត្តទៅ ដោយ រលូន និង មាន សេចក្តីសុខ សេចក្តី ចំរើន ដល់ អ្នកប្រើប្រាស់ សមិទ្ធិផល ទាំងនោះ ។
ស្ពាន បេតុង ខ្សែ កាប តភ្ជាប់ កោះន រា - កោះ ពេជ្រ គឺជា សមិទ្ធិផល ថ្មី មួយ ទៀត កើត មាន ឡើង ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង ដឹកនាំ អនុវត្ត ផ្ទាល់ ដោយ លោក ឃួង ស្រេង និង សាងសង់ ដោយ ក្រុមហ៊ុន OCIC ។
ស្ពាន នេះ បាន ដើ តួនាទី យ៉ាង សំខាន់ ក្នុង ការរួមចំណែក កាត់បន្ថយ ការកកស្ទះ ចរាចរ លើ កំណាត់ មហាវិថី ព្រះនរោត្តម ពី ស្ពាន អាកាស ក្បាលថ្នល់ ចូលមក កណ្តាល ក្រុង រួមទាំង បងប្អូន អ្នកធ្វើដំណើរ ពី ខណ្ឌ ច្បារអំពៅ និង បាន កាត់បន្ថយ ការកកស្ទះ ចរាចរ មួយ ផ្នែក ធំ លើ កំណាត់ ផ្លូវ ជាតិ លេខ ១ និង ផ្លូវ ជាតិ លេខ ២ ដែល ជា ច្រក ចេញ ចូល រាជធានី ភ្នំពេញ ផងដែរ ។
អាជ្ញាធរ ហាម អាជីវករ ដាក់ អីវ៉ាន់ លក់ដូរ លើ ដង ផ្លូវ សាធារណៈ លើស គំនូស ដែល បាន កំណត់ ជុំវិញ ផ្សារ ក្រុង ព្រៃវែង
( ព្រៃវែង )៖ គណៈកម្មការ សន្តិសុខ សណ្តាប់ធ្នាប់ ខេត្ត ព្រៃវែង សហការ ជាមួយ គណ:កម្មការ ផ្សារ ដឹកនាំ ដោយ លោក ទេស សាបាន នាយក រដ្ឋបាល សាលាក្រុង ព្រៃវែង និង ជា អនុប្រធាន គណៈកម្មការរៀបចំ សណ្តា បធ្នាប់ ផ្សារ ចាស់ នៅ ថ្ងៃ ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន បន្ត អនុវត្ត រៀបចំ សណ្តាប់ធ្នាប់ និង ក្រើន រំលឹក ដល់ អាជីវករ មិន ឲ្យ ដាក់ អីវ៉ាន់ លក់ដូរ លើ ដង ផ្លូវ សាធារណៈ លើស គំនូស ដែល បាន កំណត់ ជុំវិញ ផ្សារ ក្រុង ព្រៃវែង ដើម្បីឱ្យ មាន របៀបរៀបរយ ។
សកម្មភាព នេះ ធ្វើឡើង ដោយសារ បច្ចុប្បន្ន នៅតែ មាន អាជីវករ មួយចំនួន បន្ត យក អីវ៉ាន់ ដាក់ លក់ដូរ លើស គំនូស កំណត់ នៅលើ ដង ផ្លូវ ជុំវិញ ផ្សារ ជារៀងរាល់ ថ្ងៃ ដោយ គ្មាន របៀបរៀបរយ ។
លោក ទេស សាបាន បាន ឲ្យដឹង ថា នេះ មិន មែន ជា លើក ទី មួយ ទេ ដែល អាជ្ញាធរ ខេត្ត និង ក្រុង បាន ចុះ រៀបចំ សណ្តាប់ធ្នាប់ ផ្សារ ក្រុង ព្រៃវែង តែ ជា លទ្ធផល ដូចជា វែកចក ក្នុង ទឹក អ៊ីចឹង ក៏ប៉ុន្តែ អាជីវករ មួយចំនួន ទៀត គាត់ ក៏ បាន អនុវត្ត តាម ការណែនាំ របស់ គណៈកម្មការរៀបចំ សម្រាប់ ធ្នាប់ ផ្សារ ផងដែរ ។ ថ្ងៃ នេះ គណៈកម្មកា ក៏ បាន បាន ចុះ ណែនាំ និង បាញ់ ថ្នាំ កំណត់ ទីតាំង ឱ្យ ដាក់ លក់ និង កន្លែង ហាម លក់ នៅលើ ទ្រូងផ្លូវ ។
លោក បន្ត ថា គណៈកម្មាការ រៀបចំ សណ្តាប់ធ្នាប់ ផ្សារ នៅ បន្ត ចុះ រៀបចំ បន្ត ទៀត និង តម្រូវ ឱ្យ អាជីវករ រើ គ្រែ រើ ឆ័ត្រ ចេញ ពី ដង ផ្លូវ ឬ ទ្រូងផ្លូវ តែ ម្តង ព្រោះ វា ជា ផ្លូវ សាធារណ: ដោយ មិន អនុញ្ញាតឱ្យ ពួកគាត់ លក់ លើ ផ្លូវ បន្ត ទៀត ទេ ។ ក្នុង ករណី អាជីវករ តវ៉ា ឬ មិន សហការ ជាមួយ អាជ្ញាធរ ទេ គណៈកម្មការ និង អនុវត្ដ តាម ច្បាប់ ។
លោក បាន បញ្ជាក់ ថា គោលបំណង ដែល គណៈកម្មការរៀចំ សណ្តាប់ធ្នាប់ ផ្សារ ចុះ រៀបចំ នេះ គឺ ដើម្បី បញ្ជៀស ការប៉ះពាល់ ដល់ សុខភាព របស់ ប្រជាពលរដ្ឋ និង សន្ដិសុខ សណ្ដាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ និង ប៉ះពាល់ ដល់ ការធ្វើចរាចរ របស់ ប្រជាពលរដ្ឋ ទូទៅ ធ្វើដំណើរ ផងដែរ ។
មិន តែ ប៉ុណ្ណោះ ក៏ បង្កឲ្យ ប៉ះពាល់ ដល់ ការបង្ការ ទប់ស្កាត់ និង ងាយស្រួល ក្នុង ការសង្រ្គោះ ពេល មាន បញ្ហា កើតឡើង ជា យថាហេតុ ដូចជា អគ្គីភ័យ ឆាប់ ឆេះ ជាដើម ។ ម្យ៉ាងទៀត ក៏ បាន ប៉ះពាល់ ដល់ សោភណ្ឌភាព ផ្សារ និង ប៉ះពាល់ ដល់ បរិស្ថាន អនាម័យ ផងដែរ ដូច្នេះ គណៈកម្មការសង្ឃឹម និង ជឿជាក់ ថា អាជីវករ លក់ដូរ លើ ផ្លូវ សាធារណៈ នឹង ចូលរួម សហការ ដោយ ស្ម័គ្រចិត្ដ ជាមួយ គណៈកម្មការ ឲ្យបាន ទាំងអស់ គ្នា ចាប់ពី ពេលនេះ តទៅ ៕
ខេត្ត កំពង់ស្ពឺ រៀបចំ ពីធី ប្រណាំង ទូក នា ថ្ងៃទី ១៨ - ១៩ ខែវិច្ឆិកា ជាមួយ ការរៀបចំ ព្រឹត្តិការណ៍ កម្សាន្ត ជាច្រើន
( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ដឹកនាំ កិច្ចប្រជុំ គណៈកម្មការរៀបចំ បុណ្យ អុំ ទូក ថ្នាក់ ខេត្ត និង ការងារ សន្តិសុខ សណ្ដាប់ធ្នាប់ អនាម័យ ក្នុង ពិធី ប្រណាំង ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះ ដែល នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃទី ១៨ - ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នា ពេល ខាងមុខ នេះ នៅ តាម ដងស្ទឹង ព្រែក ត្នោត សង្កាត់ ស្វាយ ក្រវ៉ាន់ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ ។
លោក អភិបាល ខេត្ត បាន ដាក់ បទបញ្ជា ដល់ កងកម្លាំងប្រដាប់អាវុធ អភិបាល ក្រុង ស្រុក និង អង្គភាព ពាក់ព័ន្ធ ត្រូវ ចូលរួម ថែរក្សា សន្តិសុខ សុវត្តិភាព សោភ័ណ្ឌភាព និង គុណភាព អនាម័យ ព្រមទាំង ពិនិត្យ ម្ហូប អាហារ លក់ដូរ ផងដែរ ។
លោក អភិបាល ខេត្ត បាន ឲ្យដឹង ថា ក្នុង ពិធី នោះ មាន ការតាំងពិរព័រណ៌ ស្រុក មួយ ផលិតផល មួយ និង សមិទ្ធផល នានា នៅក្នង ខេត្ត កំពង់ស្ពឺ ជាង នេះ នៅពេល រាត្រី ក៏ មាន ការអុជ កាំ ជ្រួច ការប្រគំ តន្រ្តី សម័យ ព្រមទាំង មាន ការរៀបចំ កម្មវិធី ផ្សេង ៗ នៅ បរិវេណ សួនច្បារ មុខ សាលា ខេត្ត ៕
( ភ្នំពេញ ) ៖ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង ងាយ រង ហានិភ័យ អាជ្ញាធរ មូលដ្ឋាន និយោជក និង អ្នកវិភាគ សេដ្ឋកិច្ច នៅ កម្ពុជា បាន អបអរសាទរ និង ពេញ យ៉ាង ខ្លាំង ចំពោះ កម្មវិធី បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ កម្រិត ១ (C1) ដល់ ក្រុម គោលដៅ គ្រួសារ ក្រីក្រ និង ងាយ រង ហានិភ័យ ដែល ជា កម្មវិធី នយោបាយ ដាក់ ចេញ ដោយ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
សម្រាប់ ក្រុម គោលដៅ មិន ត្រឹមតែ សិក្សា ដោយ ឥត គិត ថ្លៃ នោះ ទេ ថែមទាំង ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ ចំនួន ២៨ ម៉ឺន រៀល ទៀតផង ៕
( ភ្នំពេញ ) ៖ ឯកឧត្តម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា ប្រធាន ស្តីទី ព្រឹទ្ធសភា បាន ផ្ញើ សារលិខិត ជូន ពរ ឯកឧត្តម កិត្តិបរិរក្ស បណ្ឌិត ហោ ណាំ ហុង ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ នៃ កម្ពុជា ក្នុង ឱកាស ចម្រើន ជន្មាយុ ដែល នឹង ឈានចូល មកដល់ នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
( កំពង់ឆ្នាំង ) ៖ បទល្មើស នេសាទ ដោយ ប្រើ ឧបករណ៍ ហ្ស៉ីប ឬ ហៅ « ជន » ខ្នាត ធំ ចំនួន ៥ គ្រឿង ប្រើ ដោយ កម្លាំង ម៉ាស៊ីន ត្រូវបាន ក្រុម ល្មើស ច្បាប់ ធ្វើ សកម្មភាព រុញ ចាប់ ត្រី នៅ ចំណុច កោះ ក្រញ៉ាន ក្នុង ភូមិសាស្ត្រ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ដែល ក្រុម ប្រជាពលរដ្ឋ និង អ្នកសារព័ត៌មាន បាន ប្រទះឃើញ កំពុង ធ្វើ សកម្មភាព កាលពី វេលា ម៉ោង ៨៖០០ នាទី យប់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ និង បាន រាយការណ៍ ជូន មន្ត្រី ជំនាញ ទាំង យប់ ផងដែរ ។
លោក រ៉េម ផល្លី បាន និយាយ ថា បន្ទាប់ពី លោក បាន ឃើញ ទូក រុញ ជន ប្រើ ដោយ កម្លាំង ម៉ាស៊ីន ទំហំ ស៊ីឡាំង ៣០សេះ ចំនួន ៥គ្រឿង កំពុង ធ្វើ សកម្មភាព នៅ ចំណុច ខាង លើ នេះ លោក ក៏ បាន រាយការណ៍ ទៅ មន្ត្រី ជំនាញ ដើម្បីឲ្យ ចុះ មក បង្ក្រាប និង នាំយក ទូក រុញ ជន ទាំង ៥ គ្រឿង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ។
លោក បាន បញ្ជាក់ ថា បន្ទាប់ពី បាន រាយការណ៍ ទៅ ជំនាញ រួចហើយ លោក រង់ចាំ នៅ កន្លែង កើត ហេតុ អស់ រយៈពេល ជាង មួយ ម៉ោង ទើប ឃើញ លោក លី ឡា នាយ ខណ្ឌ រដ្ឋបាល ជលផល កំពង់ឆ្នាំង បាន ទូរស័ព្ទ មក ប្រាប់ លោក ថា ក ម្លាំង ជំនាញ រដ្ឋបាល ជលផល របស់ លោក មិន មាន នោះ ទេ គឺ នៅ ឆ្នុក ទ្រូ មាន តែ ម្នាក់ បើ លោក ឱ្យ កម្លាំង ទៅ ពី កំពង់ឆ្នាំង ខ្លាចក្រែង យូរ ។
ពាក់ព័ន្ធ ករណី ខាងលើ នេះ លោក លី ឡា នាយ ខណ្ឌ រដ្ឋបាល ជលផល កំពង់ឆ្នាំង បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News កាលពី យប់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ថា កម្លាំង របស់ លោក នៅ សង្កាត់ បរិបូណ៌ មាន តែ ម្នាក់ កម្លាំង ជំនាញ មាន តែ នៅ ក្រុង កំពង់ឆ្នាំង ដោយ សុំឲ្យ ខាង អ្នក ព័ត៌មាន ឃាត់ ទូក ទាំងនោះ ទុក សិន លោក នឹង បញ្ជូន កម្លាំង ទៅ តែ ក្រោយមក លោក បាន ឲ្យ អ្នកសារព័ត៌មាន នាំយក ទូក រុញ ជន ទាំង៥ គ្រឿង នោះ ទៅ ដាក់ នៅ សង្កាត់ រដ្ឋបាល ជល ផល បរិបូណ៍ ជំនួស មន្ត្រី នគរបាល យុត្តិធម៌ ទៅ វិញ ។
លោក បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា ពាក់ព័ន្ធ ទៅនឹង មន្ត្រី ជំនាញ របស់ លោក ដែល ថា ខ្វះ កម្លាំង ក្នុង ការចុះ សហការ ជាមួយ ក្រុម អ្នកសារព័ត៌មាន ដែល ពួកគាត់ បាន ចំណាយ ទាំង ពេលវេលា ទាំង ថវិកា និង ប្រឈម បញ្ហា ជាច្រើន ជា មួយ ក្រុម ជនល្មើស បាន ឃាត់ ទូក រុញ ជន ប្រើ ដោយ កម្លាំង ម៉ាស៊ីន បាន ចំនួន ៥ គ្រឿង ហើយ គ្រាន់តែ នាំ កម្លាំង ជំនាញ ទៅ យក ក៏ ធ្វើ មិន បាន ដែរ បែរជា ឆ្លើយ ថា គ្មាន កម្លាំង ចុះ ទៅ នាំយក ទូក រុញ ជនល្មើស ទាំងនោះ មកកាន់ សង្កាត់ រដ្ឋបាល ជល ផល ឆ្នុក ទ្រូ ទៅ វិញ ។
ករណី នេះ លោក មាន ការហួសចិ ត្ត ជាខ្លាំង ដោយសារតែ នៅ តំបន់ ឆ្នុក ទ្រូ នោះ មាន នាយ រង ខណ្ឌ ១នាក់ នាយ រង ផ្នែក ១នាក់ សង្កាត់ ២នាក់ និង ក៏ មាន កម្លាំង អធិការ រដ្ឋាន ខាងត្បូង បឹង ទន្លេ សាប នៅ ប្រចាំ ការ ទី នោះ ដើម្បី សហការបង្ក្រាប បទល្មើស នេសាទ ផងដែរ ។ ទោះជា យ៉ាងណា ក្នុង នាម យើង ជា មន្ត្រី ជំនាញ ត្រូវ ទទួលខុសត្រូវ ហេតុអី បានជា ប្រើ ឱ្យ អ្នកសារព័ត៌មាន ដែល មិន មែន ជា មន្ត្រី នគរបាល យុត្តិធម៌ នាំ អ្នកប្រព្រឹ ត្ត បទល្មើស ជំនួស ទៅ វិញ ។
ករណី នេះ នៅ យប់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា នេះ ដែរ អ្នកសារព័ត៌មាន ក៏ បាន រាយការណ៍ ជូន ទៅ ថ្នាក់ដឹកនាំ មួយចំនួន មាន៖ លោក ងិន ហ៊ុន ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត . លោក ខូវ លី ស្នងការ នគរបាល ខេត្ត កំពង់ឆ្នាំ ង និង លោក អភិបាល ខេត្ត កំពង់ឆ្នាំង ពាក់ព័ន្ធ នឹង ការឃាត់ បទល្មើស ប្រភេទ ទូក រុញ ជន ប្រើ ដោយ កម្លាំង ម៉ាស៊ីន ចំនួន គ្រឿង៥ ខាងលើ នេះ ដើម្បីឲ្យ លោក ទាំងអស់ បាន ជ្រាប ជា ព័ត៌មាន ផងដែរ ។
សូម បញ្ជាក់ ថា ប្រភេទ ទូក បំពាក់ ដោយ ឧបករណ៍ នេសាទ រុញ ដោយ កម្លាំង ម៉ាស៊ីន ទំហំ ៣០ សេស ទាំង ៥ គ្រឿង ខាងលើ នេះ គេ ហៅ ថា ទូក រុញ ហ្ស៉ីប ឬ ជន ឧបករណ៍ ប្រភេទ នេះ មាន មុខ ប្រមាណ ជា១០ម៉ែត្រ និង បណ្ដោយ សាច់ អួន ១៥ម៉ែត្រ ដែល មាន សាច់ អួន ក្រឡា ទហំ ១លី កន្លះ នៅ ផ្នែក ខាងក្រោយ ។
ឧបករណ៍ នេះ គេ អាច ចាប់ ត្រី បាន ច្រើន គួរសម ហើយ ឧបករណ៍ ប្រភេទ នេះ ដែរ ច្បាប់ ស្ដីពី ជល ផល មិន អនុញ្ញាតឱ្យ ប្រើ នោះ ឡើយ ព្រោះ វា អាច ប៉ះពាល់ ដល់ ការនេសាទ ជា លក្ខណៈ គ្រួសារ របស់ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្សត់ខ្សោយ ដូចជា អាច ធ្វើឱ្យ ដាច់ រហែក មង សន្ទូច និង ឧបករណ៍ នេសាទ ជា លក្ខណៈ គ្រួសារ តូចតាច របស់ ប្រជានេសាទ ជាច្រើន ទៀត ៕
នគរបាល រាជធានី ភ្នំពេញ បង្ក្រាប និង បញ្ជូន ជនសង្ស័យ ពាក់ព័ន្ធ បទល្មើស ល្បែងស៊ីសង ៧នាក់ ទៅ តុលាការ
ប្រតិបត្តិការ លប ឆ្មក់ បង្ក្រាប ល្បែងស៊ីសង ( ចាក់ ភ្នាល់ JOKER តាម ប្រព័ន្ធ អនឡាញ ) របស់ កម្លាំង ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កំរិត ស្រាល នេះ បាន អនុវត្ត ឡើង ស្ថិត នៅ ត្រង់ ចំណុច ផ្ទះ គ្មាន លេខ មួយ កន្លែង តាម បណ្ដោយ ផ្លូវ បេតុង ក្នុង ភូមិ ទ្រា៤ សង្កាត់ ស្ទឹងមានជ័យ៣ ខណ្ឌ មានជ័យ វេលា ម៉ោង ១៤៖ ២៥ នាទី ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
លោក វរសេនីយ៍ ទោ ម៉ម សាវន បាន បញ្ជាក់ ថា ចំពោះ ប្រតិបត្តិការ លប ឆ្មក់ បង្ក្រាប ល្បែងស៊ីសង នេះ ដែរ បាន ធ្វើឡើង ក្រោម បញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ . លោក វរសេនីយ៍ ឯក ប៊ុន សត្យា ស្នងការ រង ទទួល ផែនការងារ នគរបាល ព្រហ្មទណ្ឌ និង ដឹកនាំ បញ្ជា ផ្ទាល់ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី លី ប៊ុន អេង ស្នងការ រង ទទួល ដឹកនាំ ការិយាល័យ ក្រោម ការឯកភាព ពី លោក សេង ហៀង ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
លោក វរសេនីយ៍ ទោ ម៉ម សាវន បាន បញ្ជាក់ ទៀត ថា ចំពោះ វត្ថុតាង ដែល សមត្ថកិច្ច ចាប់ យក នៅក្នុង ប្រតិបត្តិការ លប ឆ្មក់ បង្ក្រាប ល្បែងស៊ីសង រួម មាន៖
ជនសង្ស័យ អ្នកមើល ការខុសត្រូវ និង អ្នកលេង ល្បែង ប្រុស ស្រី ទាំង ៧នាក់ ដែល សមត្ថកិច្ច ឃាត់ខ្លួន រួម មាន៖ ឈ្មោះ រិត ស្រី ចាន់ ហៅ ជី អាយុ ២៦ ឆ្នាំ មុខរបរ បុគ្គលិក មើល ការខុសត្រូវ កន្លែង លេង ហ្គេម ស្នាក់ នៅ ផ្ទះ ជួល តាម បណ្ដោយ ផ្លូវ លេខ ២០០៤ សង្កាត់ កាកាប១ ខណ្ឌ ពោធិ៍សែនជ័យ ។ ចំណែក ៦នាក់ ទៀត ស្នាក់ នៅ ផ្ទះ ជួល តាម បណ្ដោយ ផ្លូវ បេតុង ក្នុង ភូមិ ទ្រា៤ សង្កាត់ ស្ទឹងមានជ័យ៣ ខណ្ឌ មានជ័យ រួម មាន៖
ក្រោយ បង្ក្រាប និង រៀបចំ កសាង សំណុំ រួចរាល់ ចំពោះ ជនសង្ស័យ ប្រុស ស្រី ទាំង ៧នាក់ និង វត្ថុតាង ពាក់ព័ន្ធ បទល្មើស ល្បែងស៊ីសង ត្រូវបាន កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កំរិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បញ្ជូន ទៅកាន់ អយ្យការ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី អនុវត្ត តាម និតិវិធី ៕ លោក ចៅ តុល ដឹកនាំ កម្លាំង ចុះ រៀបចំ ទីតាំង សម្រាប់ ទទួល កីឡាករ ចំណុះ ទូក របស់ សម្ដេច តេជោ ហ៊ុន សែន សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត និង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត
( ភ្នំពេញ ) ៖ លោក ចៅ តុល នាយក រង ខុទ្ទកាល័យ មហា បវរ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន ដឹកនាំ កម្លាំង ចុះ រៀបចំ ទីតាំង សម្រាប់ ទទួល ក្រុម កីឡាករ ចំណុះ ទូក របស់ សម្ដេច តេជោ ហ៊ុន សែន សម្ដច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នៅ កំពង់ផែ ស្វយ័ត រាជធានី ភ្នំពេញ ( ផែ ថ្ម ) ។
លោក ចៅ តុល បាន ឲ្យដឹង ថា រោង ធំ ធំ ត្រូវបាន រៀបចំឡើង ជាមួយ គ្រោង ដែក យ៉ាង រឹងមាំ ជាមួយនឹង ការរៀបចំ ប្រកបដោយ ផាសុកភាព មាន ការឈូសឆាយ ព្រៃ តូច ៗ ឲ្យ ស្អាត ការសម្អាត បរិស្ថាន រៀបចំ ឲ្យ មាន បន្ទប់ទឹក គ្រប់គ្រាន់ មាន ទីបញ្ជាការ ស្រាល សម្រាប់ ផ្ដល់ នូវ រាល់ តម្រូវការ របស់ ក្រុម កីឡាករ ចំណុះ ទូក ដូច ពេទ្យ សង្រ្គោះ បឋម ឡានពេទ្យ ឡាន ទឹក ទី បញ្ជាការ សម្រាប់ កងកម្លាំង យាម កាម ជាដើម ។
លោក ចៅ តុល បាន បន្ត ថា ដោយ ផ្អែក លើ គុណភាព ជា ចម្បង និង ធានា បាន គុណភាព មិន អាច ថ្លោះ ធ្លោយ បាន លោក បាន ចុះ មក ពិនិត្យ និង បញ្ជា ដឹកនាំ ដោយ ផ្ទាល់ តែម្ដង សំដៅ ធានា បាន ការរៀបចំ ទីតាំង ឲ្យបាន ល្អ ឥត ខ្ចោះ គ្មាន ចន្លោះ ខ្វះខាត ធានា បាន នូវ សម្ភារ ចាំបាច់ គ្រប់គ្រាន់ សម្រាប់ ក្រុម កីឡាករ ចំំណុះ ទូក និង ក្រុមការងារ ទាំងអស់ ស្នាក់ នៅ ប្រកបដោយ ផាសុកភាព ធានា បាន នូវ សន្តិសុខ ល្អ និង ក្រុម គ្រូពេទ្យ ឡានពេទ្យ ប្រចាំ ការ សម្រាប់ សង្រ្គោះ បឋម ជាដើម ។
សូម ជម្រាប ថា ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប សំពះ ព្រះខែ នឹង រៀបចំ ធ្វើឡើង នៅ រាជធានី ភ្នំពេញ ចំនួន ៣ ថ្ងៃ គឺ ថ្ងៃទី ២៦ ២៧ និង ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ៕
ឧប នាយក រដ្ឋមន្ដ្រី ស សុខា អញ្ជើញ បិទ មហាសន្និបាត សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា . នាយ ឧត្តមសេនីយ៍ ស ថេត ជាប់ ឆ្នោត ជា ប្រធាន អាណត្តិ ទី៥
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន កិត្តិយស សមាគម អញ្ជើញ ជា អធិបតីភាព បិទ មហាសន្និបាត សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង មហាផ្ទៃ ។
មហាសន្និបាត មិត្ត នគរបាល ជាតិ កម្ពុជា បាន ចាប់ផ្ដើម ដំណើរការ កាលពី ព្រឹក មិញ ដឹកនាំ ដោយ លោក សន្ដិ បណ្ឌិត ម៉ៅ ច័ន្ទ តារា រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង មហាផ្ទៃ និង ជា អនុប្រធាន អចិន្ដ្រៃយ៍ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ។
មហាសន្និបាត នេះ ក៏ បាន បោះឆ្នោត ផ្ដល់ ជ្រើសតាំង ប្រធាន ថ្មី សមាជិក គណៈ អចិន្ដ្រៃយ៍ សម្រាប់ អាណត្តិ ទី៥ ដែល ក្នុង នោះ មាន នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ជា ប្រធាន សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា អាណត្តិ ទី៥ ។
សកម្មភាព ទាំងនេះ បាន បង្ហាញ ឲ្យ ឃើញ នូវ ស្មារតី មនុស្សធម៌ ដែល ជា ការរួមចំណែក យ៉ាង ធំ ធេង ក្នុង ការជួយ សម្រួល ដល់ ការលំបាក ខ្វះខាត ក្នុង ជីវភាព របស់ មន្តី នគរបាល ជាតិ ក៏ ដូចជា ក្រុមគ្រួសារ ផងដែរ ។ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា បាន ប្រារព្ធ ពិធី មហាសន្និបាត លើក ទី១ នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០០២ ក្នុង អាណត្តិ ទី១ ដែល មាន រយៈពេល ០៣ ឆ្នាំ និង បាន បញ្ចប់ អាណត្តិ នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០០៥ ។
ក្នុង ពេល មហាសន្និបាត អាណត្តិ ទី៣ សមាគម បាន ធ្វើ វិសោធនកម្ម កែសម្រួល លក្ខន្តិកៈ ឲ្យ មាន រយៈពេល ០៥ ឆ្នាំ វិញ ក្នុង អាណត្តិ នីមួយ ៗ ។ នៅ អាណត្តិ ទី៣ និង ទី៤ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា បាន បន្ត សកម្មភាព ការងារ របស់ ខ្លួន ស្រប ទៅ តាម ការកំណត់ នៃ លក្ខន្តិកៈ និង សេចក្តីសម្រេច របស់ គណៈកម្មាធិការ កណ្ដាល សម្រេចបាន លទ្ធផល ល្អ ប្រសើរ ។
គិត ត្រឹម ខែសីហា ឆ្នាំ ២០២៣ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា មាន សមាជិក ចំនួន ៧៨. ០៦៩ នាក់ ក្នុង នោះ មាន សមាជិក សមាគម ជា មន្ត្រី នគរបាល ចំនួន ៦. ១៨៩៧ នាក់ សមាជិក ជា មន្ត្រី នគរបាល ដែល បាន ចូលនិវត្តន៍ ចំនួន ១៦. ១៧០ នាក់ និង មន្ដ្រី នគរបាល ពិការ ដែល ស្ម័គ្រចិត្ត នៅ បន្ត ជា សមាជិកភាព របស់ សមាគម ចំនួន ០២ នាក់ ៕
ផ្លូវ ក្រវាត់ ព្រំដែន កម្ពុជា - ថៃ មួយ ខ្សែ ប្រវែង ជិត ២០ គីឡូម៉ែត្រ ត្រូវបាន មន្ទីរ សាធារណការ ខេត្ត ព្រះវិហារ ជួសជុល ឡើងវិញ
( ព្រះវិហារ ) ៖ កំណាត់ ផ្លូវ ខេត្ត លេខ ២ PVH3 ប្រវែង ១៧គីឡូម៉ែត្រ ជា ផ្លូវ យុទ្ធសាស្ត្រ ក្រវ៉ាត់ ព្រំដែន កម្ពុជា - ថៃ ដែល រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង នា រដូវ វស្សា កន្លងមក ត្រូវបាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ ជួសជុល ឡើងវិញ ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ រវស់ ប្រជាពលរដ្ឋ ។
លោក សំ លាង ទ្រី ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ បាន ថ្លែង ថា កំណាត់ ផ្លូវ ខេត្ត ២ PVH3 ប្រវែង ១៧គីឡូម៉ែត្រ នេះ គឺជា ប្រភេទ ផ្លូវ ក្រាល ល្បាយ ថ្ម លាតសន្ធឹង ពី ជើង ភ្នំ ទ្រព្យ ដល់ ភូមិ អង្រ្គង ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ជា ផ្លូវ យុទ្ធសាស្ត្រ របស់ កងទ័ព និង ជា ផ្លូវ ទេសចរណ៍ ធម្មជាតិ ព្រៃ ភ្នំ ក្បែរ ជើង ភ្នំ ប្រាសាទ ព្រះវិហារ ផងដែរ ។
លោក ប្រធាន មន្ទីរ បាន បន្ត ថា ការជួសជុល កំណាត់ ផ្លូវ ខេត្ត ២ PVH៣ ឡើងវិញ នេះ គឺ ក្រុមការងារ ជួសជុល ថែទាំ ផ្លូវថ្នល់ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ កៀរ សម្រួល ស្រោច ទឹក កិន បង្ហាប់ ធ្វើ យ៉ាងណា ឱ្យ ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរ ធ្វើដំណើរ បាន ស្រួល ។
លោក បណ្ឌិត បាន គូសបញ្ជាក់ បន្ថែម ទៀត ថា ខេត្ត មណ្ឌលគិរី គឺជា ខេត្ត ទី១៤ ប្រកាស ជា ខេត្ត អស់ មីន ដែល បាន បោសសម្អាត ចាប់ពី ឆ្នាំ ២០០២ ដោយ ប្រតិបត្តិករ ចំនួន ៣ រួម មាន៖ មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព អង្គភាព ស៊ីម៉ាក់ និង អង្គការ ម៉ែក ក្នុង ទំហំ ផ្ទៃដី ប្រមាណ ជា ១៧. ៨៨៦.៥៦៤ ម៉ែត្រ ក្រឡា ដោយ មាន ការគាំទ្រ ពី រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ « មូលនិធិ កម្ពុជា គ្មាន មីន ឆ្នាំ ២០២៥ » ប្រទេស ជា មិត្ត និង ដៃគូ អភិវឌ្ឍន៍ ។
លោក ថា « នេះ គឺជា ស្នាដៃ ប្រវត្តិសាស្រ្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត សម្រាប់ ប្រជាជន ខេត្ត មណ្ឌលគិរី ទាំងមូល ឱ្យ ទទួលបាន នូវ សេរីភាព រួច ចាក ផុត ពី ការគំរាម ដោយសារ មីន ដែល ជា មរតក ពី សង្រ្គាម ក្រោម ម្លប់ សន្តិភាព កើត ចេញ ពី នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី ដែល បាន ខិតខំ ប្រឹងប្រែង ពលី ស្វែងរក មក យ៉ាង លំបាក » ។
ទេសរដ្ឋមន្រ្តី បាន បន្ត ទៀត ថា ជាមួយនឹង ផ្លែ ផ្កា នៃ សន្តិភាព ការងារ បោសសម្អាត មីន ពិតជា បាន រួមចំណែក ធ្វើឱ្យ មាន ភាពខុសប្លែក គ្នា យ៉ាង ខ្លាំង ចំពោះ សុខ សុវត្ថិភាព សន្តិសុខ និង ជីវភាព រស់ នៅ របស់ ប្រជាជន កម្ពុជា ដែល កំពុង រស់ នៅក្នុង សហគមន៍ ដែល រង ផល ប៉ះពាល់ ដោយសារ សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ។
ទេសរដ្ឋមន្រ្តី បាន បន្ត លើកឡើង អំពី ភាពជោគជ័យ នៃ ការងារ បោសសម្អាត មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម រយៈពេល ជាង ៣០ ឆ្នាំ នៅ កម្ពុជា ដែល រាជ រដ្ឋាភិបាល ចំណាយ ថវិកា អស់ ជាង ២០០ លាន ដុល្លារ អាមេរិក ដើម្បី ធានា សុខ សុវត្ថិភាព និង សុខ ក្សេមក្សាន្ត ជូន ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។
ជាមួយនឹង ភាពជោគជ័យ នេះ កម្ពុជា នឹង ទទួលបាន នូវ ការវាយតម្លៃ ខ្ពស់ ពី សហគមន៍ អន្តរជាតិ ហើយ នៅ ឆ្នាំ ២០២៤ ខាងមុខ កម្ពុជា មាន កិតិ្តយ សទទួល ធ្វើជា ប្រធាន នៃ អនុសញ្ញា អូតា វ៉ា ដោយ សម្រេច ជ្រើសយក ខេត្ត សៀមរាប ជា ទីកន្លែង សម្រាប់ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល សៀមរាប - អង្គរ ស្តីពី ពិភពលោក មួយ ដែល គ្មាន មីន ដែល មាន តំណាង មកពី រដ្ឋ ភាគី និង រដ្ឋ អង្កេត ការណ៍ ប្រមាណ ជាង ២០០ ប្រទេស ចូលរួម ។
លោក បាន បន្ថែម ទៀត ថា ភាព ជា ម្ចាស់ ផ្ទះ របស់ កម្ពុជា នឹង ធ្វើឱ្យ គណៈប្រតិភូ មកពី ជាង ២០០ ប្រទេស ផ្លាស់ប្តូរ ផ្នត់គំនិត អវិជ្ជមាន ពី កម្ពុជា ក៏ ដូចជា ក្លាយជា ឯក អគ្គ រដ្ឋទូត ផ្សព្វផ្សាយ ដំណឹង ល្អ និង វិជ្ជមាន ពី កម្ពុជា ទៅកាន់ សកលលោក ៕
មនុញ្ញ ផល សន្តិភាព សង់ ដោយ អ្នក ចាស់ សម្ពោធ ដោយ អ្នក ថ្មី ! រសៀល ស្អែក សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន កោះន រា
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃពុធ ៣កើត ខែកត្ដិក ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ស្អែក នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា នឹង អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ស្ពាន កោះន រា ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ លោក ឌិត ទីណា រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ធនាគារ វីង ( ខេមបូឌា ) ម . ក បាន ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ស្តីពី ការប្រើប្រាស់ ឥណទាន របស់ ធនាគារ វីង ( ខេមបូឌា ) ម . ក សម្រាប់ ជំរុញ ការអភិវឌ្ឍន៍ វិស័យ កសិកម្ម ។ កម្មវិធី នេះ រៀបចំ ធ្វើ នៅ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ អគារ ផ្កា រំដួល សាល សែន ពិដោរ ។
លោក រដ្ឋមន្ត្រី បង្ហាញ ក្តី សោមនរីករាយ ដែល អ្នក ឧកញ៉ា គិត ម៉េង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ធនាគារ វីង ( ខេមបូឌា ) ម . ក បាន ចូលរួម ចុះហត្ថលេខា លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា រវាង ក្រសួង កសិកម្ម និង ធនាគារ វីង ដោយ ធនាគារ នេះ ព្រមព្រៀង ផ្តល់ កម្ចី ឥណទាន ចំនួន ៥លាន ដុល្លារ អាមរិក ដល់ ប្រជាកសិករ ក្នុង អត្រា ការប្រាក់ ទាប ពោលគឺ ត្រឹមតែ ៧ទៅ ៨ភាគរយ ក្នុង មួយ ឆ្នាំ តែ ប៉ុណ្ណោះ ដោយ មិន គិត កម្រៃ សេវា អ្វី ផ្សេង ទៀត ទេ ។
លោក រដ្ឋមន្ត្រី គូសបញ្ជាក់ ថា ការចុះអនុស្សរណៈ នៃ ការយោគយល់ នេះ ជា ជោគជ័យ ថ្មី មួយ ទៀត ក្នុង ការជួយ ដល់ ដល់ ប្រជាកសិករ ក៏ ដូចជា អ្នកជំនួញ ក្នុង វិស័យ កសិកម្ម សំដៅ ធ្វើ យ៉ាងណា លើកកម្ពស់ កម្លាំង ថាមពល នៅក្នុង ការជួយ ជំរុញ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម ឱ្យ បាន ទៅ មុខ មួយ កម្រិត ទៀត ។
លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ដល់ ធនាគារ វីង ជំនួស ប្រជាកសិករ សហគមន៍ និង សហគ្រាស តូច - ធំ មួយចំនួន ទៀត ដែល ធ្វើការលើកកម្ពស់ លើ វិស័យ កសិកម្ម ដែល នឹង ទទួលបាន ទំហំ កម្ចី ពី ធនាគារ វីង ប្រមាណ ជា ៥លាន ដុល្លារ ក្នុង អត្រា ការប្រាក់ ទាប ។ បើ តាម លោក រដ្ឋមន្ដ្រី នេះ គឺជា ការបើក ជា ទំព័រ ប្រវត្តិសាស្ត្រ ថ្មី មួយ ដើម្បីឱ្យ គ្រឹស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ឬ ធនាគារ ផ្សេង ៗ អាច គិតគូ ពិចារណា ក្នុង ការដើរ តាម គំរូ របស់ ធនាគារ វីង ( ខេមបូឌា ) ម . ក ក្នុង ការជួយជ្រោមជ្រែង ដល់ កសិករ និង សហគមន៍ កសិកម្ម ។
អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ធនាគារ វីង ( ខេមបូឌា ) ម . ក មានប្រសាសន៍ ថា ការចុះអនុស្សរណៈ នៃ ការយោគយល់ នេះ ដើម្បី គាំទ្រ ដល់ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង អាណត្ដិ ទី៧ ដើម្បី ជម្រុញ និង លើកកម្ពស់ វិស័យ កសិកម្ម របស់ កម្ពុជា ព្រមទាំង ជីវភាព របស់ ប្រជាជន ឱ្យ កាន់តែ ប្រសើរឡើង ក្នុង មួយ កម្រិត ទៀត ។
ករណី នេះ លោក រដ្ឋមន្ដ្រី ក៏ បាន អំពាវនាវ ដល់ ធនាគារ និង គ្រឹះស្ថាន មីគ្រូ ហិរិញ្ញវត្ថុ នានា គិតគូរ ពិចារណា ក្នុង ការផ្ដល់ ឥណទាន ដែល មាន ការអត្រា ការប្រាក់ ទាប ដើម្បី សម្រួល ដល់ ប្រជាកសិករ សម្រាប់ ជំរុញ ការអភិវឌ្ឍន៍ វិស័យ កសិកម្ម ផងដែរ ៕ សកម្មជន ក្រុម ប្រឆាំង នៅ ប្រទេស បារាំង ភ្ញាក់ រលឹក ខ្លួន ចេញ វីដេអូ សុំទោស សម្តេច តេជោ ហ៊ុន សែន ហើយ ប្រកាស ឈប់ ជឿ សម រង្ស៉ី ទៀត ហើយ (Video inside)
( ភ្នំពេញ ) ៖ សកម្មជន ក្រុម ប្រឆាំង ដ៏ ចំណាស់ ម្នាក់ គឺ លោកស្រី សេង អ៊ាង ពេលនេះ បាន ត្រឡប់ មកដល់ ប្រទេស កម្ពុជា ហើយ បន្ទាប់ពី ភ្ញាក់ រលឹក ពី ការចាញ់បោក ទណ្ឌិត សម រង្ស៉ី អស់ ជាច្រើន ទសវត្ស ដោយ ខាតបង់ ថវិកា អស់ ជាច្រើន ។
លោកស្រី បាន បន្ត ថា ពេលនេះ លោកស្រី បាន មកដល់ ប្រទេស កម្ពុជា វិញ ហើយ គ្រាន់តែ ចុះ ពីលើ យន្តហោះ ភ្លាម លោកស្រី បាន មើលឃើញ អំពី ការអភិវឌ្ឍ ជាក់ស្តែង របស់ ប្រទេស កម្ពុជា ដោយ មាន លក្ខណៈ ល្អ ស្អាត មាន សោភ័ណភាព ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ មិន ដូច ការបរិហារ របស់ ទណ្ឌិត សម រង្ស៉ី នៅ ក្រៅ ប្រទេស ទាល់តែសោះ ។
តាមរយៈ វីដេអូ នេះ លោកស្រី ក៏ បាន ស្នើសុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា និង បាន សុំទោស ចំពោះ សម្តេច តេជោ ដែល កន្លងមក លោកស្រី បាន ដើរ ផ្លូវ ខុស ៕
ខាងក្រោម នេះ ជា វីដេអូ អតីត សកម្មជន ក្រុម ប្រឆាំ ង៖
ស្ត្រី ម្នាក់ ដួល ស្លាប់ ក្នុង បន្ទប់ទឹក សង្ស័យ គាំង បេះដូង នៅ ក្រុង បាន លុង
( រតនគិរី ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ មាន ការភ្ញាក់ផ្អើល ឆោឡោ ដោយ មាន ស្ត្រី ម្នាក់ បាន ស្លាប់ នៅក្នុង បន្ទប់ទឹក សង្ស័យ គាំង បេះដូង នៅ ចំណុច ផ្ទះ ជួល មួយ កន្លែង ហាង កាត់ សក់ ស្ថិត ក្នុង ភូមិ អភិវឌ្ឍន៍ សង្កាត់ ឡា បាន សៀក ក្រុង បាន លុង ខេត្ត រតនគិរី ។
ក្រោយពី ទទួល ព័ត៌មាន ភ្លាម កម្លាំង នគរ ប៉ុស្តិ៍ ឡា បាន សៀក . កម្លាំង នគរបាល ជំនាញ ព្រហ្មទណ្ឌ ក្រុង បាន លុង សហការ ជាមួយ កម្លាំង ជំនាញ ការិយាល័យ បច្ចេកទេស វិទ្យាសាស្ត្រ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី និង គ្រូពេទ្យ នៅ មន្ទីរ សុខាភិបាល ខេត្ត ព្រមទាំង អាជ្ញាធរ ភូមិ - សង្កាត់ ចុះ ទៅដល់ កន្លែង កើត ហេតុ និង ធ្វើ ការពិនិត្យ សាកសព ខាងលើ ។
បើ តាម សមត្ថកិច្ច ដែល ចុះ ដល់ កន្លែង កើត ហេតុ ប្រាប់ ឲ្យដឹង ថា សព មាន ឈ្មោះ ប៉ក់ ស្រី មុំ ហៅ ឡាំយ៉ង អាយុ ២៦ ឆ្នាំ មុខរបរ ជាង កាត់ សក់ ។ បច្ចុប្បន្ន ជនរងគ្រោះ មាន ទីលំនៅ កន្លែង កើត ហេតុ និង មាន ប្ដី ឈ្មោះ ជ័យ ភ័ក្រ អាយុ ២៧ ឆ្នាំ បុគ្គលិក ធនាគារ មាន ទីលំនៅ សព្វ ថ្ងៃ ភូមិ ជ័យ ជំនះ សង្កាត់ ឡា បាន សៀក ក្រុង បាន លុង ខេត្ត រតនគិរី ។
ឈ្មោះ អេង ឆាយ ហេង អាយុ ៣៤ ឆ្នាំ ជា អ្នកធ្វើការ ជាមួយ ជនរងគ្រោះ បាន រៀបរាប់ប្រាប់ ថា ខ្លួន បាន ចេញ ពី ផ្ទះ មកដល់ ហាង កាត់ សក់ ក៏ បាន ឮ សម្លេង បើក ទឹក ហៀរ ចោល នៅក្នុង បន្ទប់ទឹក ព្រមទាំង ស្រែក ហៅ ឈ្មោះ ប៉ក់ ស្រី មុំ ហៅ ឡាំ យ៉ង តែ គ្មាន សម្លេង ឆ្លើយតប ចេញមក សោះ ។
ដោយ មាន ការសង្ស័យ ឈ្មោះ អេង ឆាយ ហេង បាន ហៅ ឈ្មោះ ម៉ុង ស្រី មុំ . ឈ្មោះ ម៉ែន ស្រី មុំ និង បុរស ម្នាក់ ទៀត មិន ស្គាល់ ឈ្មោះ ក៏ សម្រេច ទំលុះ ទ្វារ បន្ទប់ទឹក នោះ ស្រាប់ ឃើញ ជនរងគ្រោះ ដួល ផ្កាប់ មុខ នៅក្នុង បន្ទប់ទឹក ក្នុង ស្ថានភាព អាក្រាត កាយ ។
ភ្លាម ៗ នោះ ឈ្មោះ ម៉ុង ស្រី មុំ ក៏ បាន រត់ ទៅ ហៅ ពេទ្យ ដែល នៅក្បែរ នោះ ពេល ដែល គ្រូពេទ្យ មកដល់ ក៏ ពិនិត្យ ឃើញ ជនរងគ្រោះ ស្លាប់ បាត់ ហើយ គឺ គាំង បេះដូង ។
បើ តាម ការត្រួតពិនិត្យ និង សន្និដ្ឋាន របស់ ការិយាល័យ ជំនាញ បច្ចេកទេស វិទ្យាសាស្ត្រ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី និង គ្រូពេទ្យ នៅ មន្ទីរ សុខាភិបាល ខេត្ត រតនគិរី ព្រមទាំង អាជ្ញាធរ មូលដ្ឋាន ភូមិ - សង្កាត់ បាន បញ្ជាក់ ថា ជនរងគ្រោះ ពិតជា បាន ជួល ក្នុង បន្ទប់ទឹក ស្លាប់ ដោយសារ ការគាំង បេះដូង ពិតប្រាកដ មែន រួច បាន ប្រគល់ សព ឲ្យ ក្រុមគ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ខ្មែរ ដោយ ក្តីទុក្ខសោក ៕
ក្នុង ក្របខណ្ឌ នៃ ការអនុវត្ត មុខងារ ថ្នាក់ដឹកនាំ និង មន្ត្រី ខុទ្ទកាល័យ មាន បន្ទុក ការងារ ច្រើន ដែល ទាមទារ នូវ ភាពទន់ភ្លន់ បត់បែន និង ការអត់ធ្មត់ កម្រិត ខ្ពស់ ក្រោម សម្ពាធ នៃ ទំហំ ការងារ ដែល មាន លក្ខណៈ បច្ចេកទេស ផង និង នយោបាយ ផង ។ សមត្ថភាព ទាំង ផ្នែក ជំនាញ វិជ្ជាជីវៈ និង ទាំង ផ្នែក ជំនាញ ទន់ គឺជា លក្ខខណ្ឌ ដ៏ ចាំបាច់ សម្រាប់ ការអនុវត្ត មុខងារ និង ភារកិច្ច របស់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ខុទ្ទកាល័យ ។
បើ តាម លោក នាយក សាលា ភូមិន្ទ រដ្ឋបាល នៅ ឆ្នាំ ២០២៣ នេះ សាលា បាន ទទួល លិខិត ចាត់ បញ្ជូន មន្ត្រី ខុទ្ទកាល័យ មកពី ខុទ្ទកាល័យ សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ត្រី ខុទ្ទកាល័យ ឧប នាយក រដ្ឋមន្ត្រី ខុទ្ទកាល័យ ទេសរដ្ឋមន្ត្រី ចំនួន ១៥ និង ពី ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ក្រសួង រដ្ឋលេខាធិការដ្ឋាន ចំនួន ២៦ ដែល មាន សិក្ខាកាម សរុប ចំនួន ១៨៤ នាក់ ( ស្រី ចំនួន ៦១ នាក់ ) ដើម្បី ទទួល ការបណ្តុះបណ្តាល ក្នុង វគ្គ ទី១ ។
ការចាត់ មន្ត្រី ខុទ្ទកាល័យ ចូលរួម ក្នុង វគ្គ បណ្តុះបណ្តាល នេះ បង្ហាញ ឱ្យ ឃើញ ពី ការយកចិត្ត ទុក ខ្ពស់ របស់ ថ្នាក់ដឹកនាំ នៃ ក្រសួង ស្ថាប័ន ក្នុង ការលើកកម្ពស់ ការអភិវឌ្ឍ សមត្ថភាព មន្ត្រី ក្រោម ឱវាទ ដែល ជា សេនាធិការ ដ៏ សំខាន់ និង ត្រូវ បំពេញ ការងារ ផ្ទាល់ ជាប់ ជាមួយ ថ្នាក់ដឹកនាំ និង ប្រធាន ស្ថាប័ន ហើយ នេះ ក៏ ជា ការផ្តល់ នូវ ភាព ជឿជាក់ ដល់ សាលា ភូមិន្ទ រដ្ឋបាល ក្នុង ការរៀបចំ និង គ្រប់គ្រង វគ្គ បណ្តុះបណ្តាល ដើម្បី គាំទ្រ ការអភិវឌ្ឍ ធនធាន មនុស្ស ក្នុង វិស័យ សាធារណៈ ផងដែរ ៕
ការងារ ជា បទបញ្ជា ចំនួន ៦ របស់ សម្តេច នាយក រដ្ឋមន្ត្រី ត្រូវបាន លោក ហេង សួរ អនុវត្តន៍ ជោគជ័យ ជា បន្តបន្ទាប់ ក្នុង រយៈពេល ជាង ២ខែ (Video inside) ( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី ដឹកនាំ ដោយ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី បាន យកចិត្តទុកដាក់ ខ្ពស់ លើ ស្ថានភាព ការងារ របស់ ប្រជាពលរដ្ឋ ជាពិសេស ការបង្កើត សមត្ថភាព ផលិតភាព ក្នុង វិស័យ ឧស្សាហកម្ម និង វាយន ភណ្ឌ កាត់ដេរ សម្លៀកបំពាក់ ផលិត ស្បែកជើង កាបូប និង ផលិតផល យក តាម ខ្លួន ជាដើម ។
ឈរ លើ ស្មារតី ខាង លើ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ចាប់ យក ការងារ ចុះ ជួប កម្មករ និយោជិត មកពី បណ្តា រោងចក្រ សហគ្រាស ក្នុង វិស័យ វាយន ភណ្ឌ កាត់ដេរ សម្លៀកបំពាក់ ផលិត ស្បែកជើង កាបូប និង ផលិតផល យក តាម ខ្លួន ជា វេទិកា សាធារណៈ លើក ដំបូង នៅ ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២៣ បន្ទាប់ពី រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី ត្រូវបាន បង្កើតឡើង នៅ ថ្ងៃទី ២២ ខែសីហា ។
ក្នុង ជំនួប ជាមួយ កម្មករ និយោជិត នៅ តំបន់ ព្រៃ ស្ពឺ ក្នុង រាជធានី ភ្នំពេញ នា ថ្ងៃទី ២៩ ខែសីហា នោះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ប្រកាស ដាក់ ចេញ កម្មវិធី ការងារ អាទិភាព ចំនួន ៦ ជូន លោក ហេង សួរ រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ អនុវត្តន៍ ឱ្យ បាន ជោគជ័យ ដើម្បី ជា ប្រយោជន៍ របស់ កម្មករ និយោជិត ។
បន្ទាប់ពី ទទួលបាន បទបញ្ជា នេះ លោក ហេង សួរ ជាមួយ ថ្នាក់ដឹកនាំ ក្រសួង ព្រមទាំង សហការី បាន យកចិត្តទុកដាក់ ប្រឹងប្រែង អនុវត្តន៍ ដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ហើយ សម្រេចបាន លទ្ធផល ដ៏ ល្អ ប្រសើរ ជា បន្តបន្ទាប់ មិន ឱ្យ នាយក រដ្ឋមន្ត្រី ខកចិត្ត ឬ ខុស ការសន្យា ជាមួយ កម្មករ និយោជិត នោះ ឡើយ ។
នេះ ជា ការសម្រេច ការងារ ទី១ ប្រកបដោយ ភាពរីករាយ មុនពេល ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ មកដល់ ។
២. ៣៖ កម្មវិធី « របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាម របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ បុគ្គល និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម » និង កម្មវិធី « បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រងគ្រោះ » ៖
កម្មវិធី « របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាម របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ បុគ្គល និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម » និង កម្មវិធី « បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រងគ្រោះ » ត្រូវបាន ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
បុគ្គល ស្វ័យ និយោជន៍ ជា ស្ត្រី ដែល បង់ ភាគ ទាន បាន ៩ខែ ជាប់ គ្នា នឹង ទទួលបាន ប្រាក់ បំណាច់ លំហែ មាតុភាព នៅពេល សម្រាល កូន . និង វិភាជន៍ ប្រាក់ បូជា សព នៅពេល ទទួលមរណភាព ។
ការពង្រីក វិសាលភាព របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាមរបប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត នេះ នឹង គ្របដណ្តប់ ដល់ បុគ្គល ស្វ័យ និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម ជាង ៣លាន នាក់ បន្ថែម ដែល នឹង ធ្វើឱ្យ របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព នឹង គ្របដណ្តប់ ប្រជាជន សរុប ជាង ៥លាន នាក់ ។
៤៖ កាតព្វកិច្ច ហ្វឹកហ្វឺន កូន ជា ង៖ ការជំរុញ កាតព្វកិច្ច ហ្វឹកហ្វឺន កូន ជាង គឺ ក្រសួង បាន នឹង កំពុង ពិភាក្សា ជាមួយ ភាគី ពាក់ព័ន្ធ ជាពិសេស ភាគី និយោជក កែសម្រួល យន្តការអនុវត្ត និង កែសម្រួល កម្មវិធី ហ្វឹកហ្វឺន កូន ជាង ឱ្យ ស្រប តាម កញ្ចប់ ស្តង់ដា បណ្តុះបណ្តាល សម្រាប់ កម្មវិធី បង្កើន ជំនាញ និង ការរៀបចំ ជំនាញ ឡើងវិញ ដោយ រួមបញ្ចូល កម្មវិធី ហាត់ ការ និង កម្មសិក្សា ផងដែរ ។
៥៖ ការអនុវត្តន៍ កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ដល់ ស្ត្រី មាន ផ្ទៃពោះ មុនពេល សម្រាល . ពេល សម្រាល និង ក្រោយពេល សម្រាល៖
៦៖ កម្មវិធី ប្រលង ប្រណាំង « សហគ្រាស មួយ ជា សហគមន៍ សុខសាន្ត មួយ »៖ ការងារ នេះ លោក ហេង សួរ បាន បង្កើត ក្រុមការងារ ដើម្បី រៀបចំ យន្តការវាយតម្លៃ និង កំណត់ លក្ខណៈ វិនិច្ឆ័យ « សហគ្រាស មួយ ជា សហគមន៍ សុខសាន្ត មួយ » ដោយ ពិគ្រោះយោបល់ និង សហការ ជាមួយ ដៃគូ សង្គម សំដៅ ឈាន ទៅ ការដាក់ចេញ យុទ្ធនាការ ប្រឡង ប្រណាំង ចាប់ពី ឆ្នាំ ២០២៤ ។
តាមរយៈ លទ្ធផល ការងារ ទាំង៦ ខាងលើ នេះ បាន បង្ហាញ ឱ្យ ឃើញ ពី សមត្ថភាព នៃ ការដឹកនាំ អនុវត្តន៍ របស់ លោក ហេង សួរ ហើយក៏ បាន បង្ហាញ ពី ស្មារតី នៃ ការអនុវត្តន៍ នូវ បទបញ្ជា របស់ សម្តេច នាយក រដ្ឋមន្ត្រី ផងដែរ ។
( ក្រុង ឡុងដ៍ ) ៖ សេដ្ឋកិច្ច របស់ ចក្រភព អង់គ្លេស នៅ ទ្រឹង ក្នុង ត្រីមាស ទី៣ ឆ្នាំ នេះ ដោយសារ ការកើនឡើង អតិផរណា និង ការដំឡើង អត្រា ការប្រាក់ ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន AFP ។
ទីភ្នាក់ងារ ព័ត៌មាន AFP បាន រាយការណ៍ ដោយ ដកស្រង់ ទិន្នន័យ ផ្លូវការ ដែល ចេញផ្សាយ ដោយ ការិយាល័យ ស្ថិតិ ជាតិ (ONS) កាលពី ថ្ងៃសុក្រ ថា ផលិតផល ក្នុង ស្រុក សរុប បាន បង្ហាញ កំណើន សេដ្ឋកិច្ច សូន្យ ភាគរយ ក្នុង អំឡុង ខែកក្កដា ដល់ ខែកញ្ញា ឆ្នាំ ២០២៣ ។ អត្រា នេះ ល្អ ជាង ការរំពឹងទុក របស់ ទីផ្សារ ដែល ថា នឹង ធ្លាក់ចុះ ០.២ភាគរយ ប៉ុន្តែ ទាប ជាង កំណើន ០.២ភាគរយ ដែល ប្រទេស នេះ សម្រេចបាន នៅក្នុង ត្រីមាស ទី ពីរ ។
ទិន្នន័យ នេះ បាន ចេញផ្សាយ មួយ សប្តាហ៍ បន្ទាប់ពី ធនាគារ កណ្តាល អង់គ្លេស បាន រក្សា អត្រា ការប្រាក់ ៥.២៥ ភាគរយ នៅ ដដែល ពោលគឺជា អត្រា ខ្ពស់ បំផុត ក្នុង រយៈពេល ១៥ ឆ្នាំ ដើម្បី ដោះស្រាយ អតិផរណា ខ្ពស់ និង បាន ព្យាករ ថា សេដ្ឋកិច្ច នឹង មាន កំណើន ទាប នៅ ឆ្នាំ ក្រោយ ។
លោកស្រី មានប្រសាសន៍ ថា៖ « សកម្មភាព សេដ្ឋកិច្ច កំពុង បន្ត ធ្លាក់ចុះ ដោយសារ អត្រា ការប្រាក់ ខ្ពស់ កំពុង ដាក់បន្ទុក លើ អារម្មណ៍ របស់ អ្នកប្រើប្រាស់ និង ប្រាក់ សន្សំ ទុក របស់ ពលរដ្ឋ » ។ លោកស្រី បន្ថែម ថា៖ « ខណៈពេល ដែល ប្រាក់ ចំណូល ពិត ( ប្រាក់ ចំណូល ដក ចេញ អតិផរណា ) បាន ចាប់ផ្តើម កើនឡើង ខណៈពេល ដែល អតិផរណា ធ្លាក់ចុះ ការណ៍ នេះ កំពុង ត្រូវបាន ប៉ះ ប៉ូវ មក វិញ ដោយ អត្រា ប្រាក់ កម្ចី ទិញ ផ្ទះ កាន់តែ ខ្ពស់ ដែល កើតមាន តាមរយៈ ការចំណាយ ទៅ លើ ផ្ទះសម្បែង »៕
កងទ័ព អ៉ី ស្រាអែល និង ប៉ូលិស និយាយ ថា កងកម្លាំង ដែល បញ្ជូន ទៅកាន់ ទីក្រុង Tulkarm ដើម្បី បង្រ្កាប ក្រុម សកម្ម ប្រយុទ្ធ សង្ស័យ ថា បាន រង នូវ ការ បាញ់ប្រហារ ហើយ ពួកគេ បាន សម្លាប់ ខ្មាន់ កាំភ្លើង ប៉ាឡេ ស្ទីន ជាច្រើន នាក់ នៅក្នុង ការប៉ះទង្គិច គ្នា ជា បន្តបន្ទាប់ ។ គ្មាន ជនជាតិ អ៉ី ស្រាអែល ណា ម្នាក់ ស្លាប់ ឬ របួស ក្នុង ការប៉ះទង្គិច គ្នា នេះ ទេ ។
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច របស់ សម្តេច តេជោ៖ ក្រសួង ការបរទេស ចិន ថ្លែង ថា មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ចិន និង អាមេរិក នឹង ផ្លាស់ប្តូរ មតិ យោបល់ យ៉ាង ស៊ីជម្រៅ អំពី បញ្ហា ជា លក្ខណៈ យុទ្ធសាស្រ្ត ភាព ទូទៅ និង ទិសដៅ នៃ ទំនាក់ទំនង រវាង ចិន និង អាមេរិក
( ប៉េកាំង ) ៖ ថ្ងៃទី ១៣ ខែវិច្ឆិកា លោកស្រី Mao Ning អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន បាន ធ្វើ សន្និសីទ កាសែត ជាប្រចាំ ដើម្បី ឆ្លើយ សំណួរ របស់ អ្នកសារព័ត៌មាន អំពី កិច្ច ជំនួប រវាង មេដឹកនាំ ចិន និង អាមេរិក ។
អត្ថបទ និង រូបភាព ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ឧប នាយក រដ្ឋមន្ដ្រី ស សុខា ណែនាំឲ្យ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ពង្រឹង សមត្ថភាព និង បំពេញ រាល់ ចំណុច ខ្វះខាត ដើម្បី ភាព ជឿជាក់ របស់ សមាជិក ជាង ៧ម៉ឺន នាក់
( ភ្នំពេញ ) ៖ លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន កិត្តិយស សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ សមាគម ទាំងអស់ ត្រូវ ពង្រឹង សមត្ថភាព លើ ការគ្រប់គ្រង និង បំពេញ រាល់ ចំណុច ខ្វះខាត ដែល កើតមាន នា ពេល កន្លងមក ដើម្បី បង្កើន នូវ ទំនុកចិត្ត និង ភាពជឿជាក់ របស់ សមាជិក សមាជិក ប្រមាណ ជាង ៧ម៉ឺន នាក់ នៅពេល បច្ចុប្បន្ន នេះ ។
លោក បន្ថែម ទៀត ថា សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា មាន ការរីកចម្រើន ជា បន្ដ បន្ទាប់ ទាំង បរិមាណ និង គុណភាព ពី មួយ អាណត្តិ ទៅ មួយ អាណត្តិ ដែល បច្ចុប្បន្ន នេះ សមាគម មាន សមាជិក ចំនួន ៧៨០៦៩ នាក់ ដោយឡែក ថវិកា ដែល នៅសល់ ប្រមាណ ជាង ១៨ ពាន់ លាន រៀល ដែល ជា ចំនួន គួរឲ្យ កត់សម្គាល់ អាច ធ្វើឲ្យ សមាគម មាន លទ្ធភាព ពង្រឹង សមត្ថភាព ជួយ សមាជិក កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ។
ជាមួយគ្នា នេះ ឧប នាយក រដ្ឋមន្ដ្រី ស សុខា បាន កោតសរសើរ ដោយ ស្មោះ ចំពោះ ស្នាដៃ និង សមិទ្ធផល ដ៏ ធំធេង ដែល កន្លងមក នគរបាល ជាតិ កម្ពុជា សម្រេចបាន ក្នុង បុព្វហេតុ រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាព សង្គម ហើយ លោក ចាត់ទុក ថា ស្នាដៃ នេះ ពិត មាន តម្លៃ ធំ ធេង មិន អាច កាត់ថ្លៃ បាន ដោយ ហេតុ គ្រប់ ដំណាក់កាល នៃ ការកសាង និង អភិវឌ្ឍន៍ នា ពេល កន្លងមក ដោយ គ្មាន សុខ សន្ដិភាព គ្រប់គ្រាន់ ទេ នោះ ការអភិវឌ្ឍ ក៏ មិន អាច មាន ទៅ រួច ផងដែរ ។
ដើម្បី ចូលរួម ចំណែក ឲ្យ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា មាន ដំណើរការ ល្អ ប្រកបដោយ ប្រសិទ្ធភាព បន្ថែម ទៀត ឧប នាយក រដ្ឋមន្ដ្រី ស សុខា ប្រធាន កិត្តិយស បាន ដាក់ចេញ នូវ ការណែនាំ មួយចំនួន ដូច ខាងក្រោម៖
* ទី១៖ នៅពេល ខាងមុខ សមាគម នឹង អាច ជួបប្រទះ នូវ បញ្ហា មួយចំនួន ដែល នឹង ត្រូវ ដោះស្រាយ ជាបន្ទាន់ ដូច្នេះ ខ្ញុំ សូម ស្នើ ដល់ គណៈកម្មាធិការ កណ្ដាល ថ្មី ត្រូវ មាន វិធី ប្រជុំ ជា កំណត់ មួយ ពេញលេញ ច្បាស់លាស់ ដើម្បី ពិនិត្យ លើ ការដឹកនាំ ដោះស្រាយ បញ្ហា ដែល កើតឡើង ទាន់ ពេលវេលា ព្រមទាំង ចង្អុល ដឹកនាំ គណៈកម្មការ មូលដ្ឋាន ឲ្យ មាន ប្រសិទ្ធភាព
* ទី២៖ បច្ចុប្បន្ន ក្រសួង មហាផ្ទៃ បាន បង្កើត អគ្គ នាយកដ្ឋាន មួយចំនួន ទៀត ហើយ អគ្គ នាយកដ្ឋាន អង្គភាព ចំណុះ ក៏ ត្រូវបាន បង្កើតឡើង ដែរ ដូច្នេះ ត្រូវ សម្របសម្រួល រៀបចំ គណៈកម្មការ មូលដ្ឋាន តាម នាយកដ្ឋាន អង្គភាព ឡើងវិញ ដើម្បីឲ្យ មាន អង្គការ ចាត់តាំង និង មាន រចនាសម្ព័ន្ធ ស្រប តាម លក្ខន្ដិកៈ និង លិខិត បទដ្ឋាន នានា សមាគម ដែល មាន ជាធរមាន
* ទី៣៖ កន្លងមក គណៈកម្មការ តាម មូលដ្ឋាន បាន អនុវត្ត ល្អ រួច មកហើយ ប៉ុន្ដែ ការងារ មួយចំនួន អ្វី ដែល លោក សង្កេតឃើញ ផ្ទាល់ គឺ មាន មន្ដ្រី មួយចំនួន នៅ ថ្នាក់ ក្រោម ជាតិ មិន បាន បំពេញ កាតព្វកិច្ច អ្វី ដែល ប្រគល់ ជូន ជាពិសេស ក្នុង ការសម្របសម្រួល ក្នុង ពិធី បុណ្យ សព ជូន ដល់ មន្ដ្រី ដូចនេះ លោក ទទូច ឲ្យ សមាគម ពិនិត្យ លើ ការងារ ពិសេស ស្នើ គណៈកម្មាធិការ អាណត្តិ ថ្មី នេះ ពិចារណា ក្នុង ការបង្កើត ក្រុមការងារ អនុវត្ត កិច្ចការ ដែល នៅ សេសសល់
* ទី៤៖ ថវិកា របស់ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា មាន គ្រប់គ្រាន់ ប៉ុន្ដែ ការបើក និង ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ ជូន ក្រុមគ្រួសារ សព ដែល ជា សមាជិក នៃ សមាគម មាន ការយឺតយ៉ាវ ពេល ខ្លះ មាន រយៈពេល មួយ ខែ ពេល ខ្លះ មាន រហូតដល់ ២ខែ ដូច្នេះ ការងារ នេះ លោក សូម ស្នើឲ្យ ប្រធាន ថ្មី មេត្តា ពិនិត្យ របៀប របប នីតិវិធី នៃ ការស្នើសុំ យ៉ាង យូរ ក្រោម ១២ ថ្ងៃ នៃ ថ្ងៃ ធ្វើ ការ ដែល ជា វេលា មួយ សមរម្យ
* ទី៥៖ ចំពោះ ការផ្សព្វផ្សាយ វិញ លោក សូម ស្នើ គណៈកម្មការនិពន្ធ ទស្សនាវដ្ដី នគរបាល បង្កើន ការផ្សព្វផ្សាយ ពី សកម្មភាព របស់ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ឲ្យបាន ច្រើន ទៀត ពិសេស សកម្មភាព គណៈកម្មការ មូលដ្ឋាន ដែល ចុះ ជួយ រៀបចំ ពិធី បុណ្យ សព សមាជិក ពលី មរណៈ ដើម្បី ឆ្លុះបញ្ចាំង ឲ្យ ឃើញ ពី មនោសញ្ចាត នា សាមគ្គី របស់ មន្ដ្រី នគរបាល ជាតិ នៅ ថ្នាក់ មូលដ្ឋាន
គួរ ជម្រាប ថា សម្រាប់ មហាសន្និបាត សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា នៅ ពេល នេះ បាន បោះឆ្នោត ជ្រើសរើស នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ជា ប្រធាន សមាគម សម្រាប់ អាណត្តិ ទី៥ ។ នាយ ឧត្តមសេនីយ៍ ស ថេត បាន បង្ហាញ អំពី ការប្ដេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការបំពេញ តួនាទី ជា ប្រធាន សមាគម សម្រាប់ អាណត្តិ ថ្មី ដើម្បីឲ្យ សមាគម កាន់តែ រីកចម្រើន រឹងមាំ បន្ថែម ទៀត និង កាន់តែ ឲ្យ សមាជិក សមាជិកា ទាំងអស់ ជឿ ទុកចិត្ត លើ សមាគម ៕
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន ផ្លាស់ប្តូរ ទស្សនៈ អំពី ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - ចិន និង ស្វែងរក វិធី នានា ដើម្បី ពង្រឹង បន្ថែម នូវ កិច្ចសហប្រតិបត្តិការ រវាង ខេត្ត Zhejiang ជាមួយ អាស៊ាន និង ជាមួយ ប្រទេស សមាជិក អាស៊ាន ។
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន គូសបញ្ជាក់ អំពី តម្រូវការ ដើម្បី ស្វែងរក សក្តានុពល សម្រាប់ កិច្ចសហការ បន្ថែម ទៀត រវាង អាស៊ាន និង អូម៉ង់ ព្រមទាំង ទន្ទឹង ពង្រឹង កិច្ចសហប្រតិបត្តិការ នៅក្នុង វិស័យ ដែល ជា ប្រយោជន៍ ទៅ វិញ ទៅ មក រួមទាំង តាមរយៈ ក្របខណ្ឌ អាស៊ាន - ក្រុមប្រឹក្សា សហប្រតិបត្តិការ ឈូង សមុទ្រ ។
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន បញ្ជាក់ ឡើងវិញ នូវ ការប្តេជ្ញាចិត្ត ក្នុង ការធ្វើ ការរួមគ្នា ដើម្បី ធ្វើឱ្យ ភាព ជាដៃគូ សន្ទនា តាម វិស័យ រវាង អាស៊ាន និង តួកគី កាន់តែ មាន ទម្ងន់ ៕
អូស្រា្តលី នឹង ជំរុញ ការចែករំលែក បច្ចេកវិទ្យា ការពារ ជាតិ ជាមួយ ដៃគូ AUKUS ប៉ុន្តែ រឹតត្បិត ជាមួយ បរទេស ដទៃ ទៀត
( ស៉ីដនី ) ៖ ច្បាប់ ថ្មី របស់ អូស្ត្រាលី នឹង ពង្រឹង ការរឹតបន្តឹង លើ របៀប ចែករំលែក បច្ចេកវិទ្យា ក្នុង ឧស្សហកម្ម និង សកលវិទ្យាល័យ ការពារ ជាតិ ជាមួយ បរទេស ប៉ុន្តែ ទន្ទឹម គ្នា នឹង លើកលែង ចំពោះ ដៃគូ របស់ AUKUS ដូចជា ចក្រភព អង់គ្លេស និង សហរដ្ឋ អាមេរិក ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃអង្គារ ទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ក្នុង កម្មវិធី សិក្ខាសាលា ស្តីពី ស្ថានភាព ត្រីប បែល យក្ស ទឹក សាប ក្នុង តំបន់ ទន្ល មេគង្គ និង ពិធី ប្រគល់ វិញ្ញាបនបត្រ កំណត់ ត្រា ពិភពលោក នា ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ លោក ហាស់ សារ៉េត រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ថ្លែង ថា នេះ គឺជា មោទនភាព មួយ របស់ កម្ពុជា ដែល ត្រីប បែល របស់ កម្ពុជា បាន បំបែក កំណត់ ត្រា ពិភពលោក ដែល ជា ត្រី ទឹក សាប ធំ ជាង គេ បំផុត នៅលើ ពិភពលោក មាន ទម្ងន់ រហូតដល់ ៣០០ គីឡូក្រាម ។
លោក បាន ឱ្យដឹង បន្ត ថា ការ ដែល ត្រីប បែល នេះ ត្រូវបាន ក្រុម អ្នកស្រាវជ្រាវ ប្រសិទ្ធ នាម ថា « បូណ៌ មី » ព្រោះ ត្រី នេះ បាន លែង ចូល ក្នុង ទន្លេ មេគង្គ វិញ នៅ ថ្ងៃ ពេញ បូណ៌មី ។ តាម លទ្ធផល នៃ ការស្រាវជ្រាវ បាន បង្ហាញ ថា បូណ៌ មី បាន និង កំពុង ស្ថិត នៅក្នុង អន្លង់ ដែល អ្នកនេសាទ ចាប់ បាន កន្លងមកដដែល ។
បើ តាម មន្រ្តី ជាន់ ខ្ពស់ នៃ ក្រសួង កសិកម្ម រូប នេះ ក្នុង ឆ្នាំ ២០២២ ត្រី ប បែល យក្ស ទឹក សាប ចំនួន ០៣ ក្បាល ត្រូវបាន អ្នកនេសាទ ចាប់ បាន ដោយ ចៃដន្យ នៅ ឃុំ កោះ ព្រះ ស្រុក សៀម បូក ខេត្ត ស្ទឹងត្រែង ត្រី ប បែល យក្ស ទី១ ទម្ងន់ ១៨០ គីឡូក្រាម ទី២ ទម្ងន់ ១៤៣ គីឡូក្រាម និង ត្រី ប បែល យក្ស ទី៣ ទម្ងន់ ៣០០ គីឡូក្រាម ។
លោក ប៉ា ទ្រិក ម័រ ហ្វី ឯក រដ្ឋទូត សហរដ្ឋ អាមេរិក បាន លើកឡើង ថា នេះ គឺជា ក្តីរំភើប មួយ ដែល ត្រីប បែល យក្ស ចាប់ បាន នៅក្នុង ដង ទន្លេ មេគង្គ របស់ កម្ពុជា បាន បំបែក កំណត់ ត្រា ពិភពលោក និង ជា ការបង្ហាញ ពី មោទភាព របស់ ប្រទេស ផងដែរ ។ នេះ គឺជា ឱកាស ដ៏ ល្អ ក្នុង ការបង្ហាញ សក្តានុពល នៃ ការអភិរក្ស នៅក្នុង តំបន់ ទន្លេ មេគង្គ និង បឹង ទន្លេ សាប ដែល ពោ ពេញ ដោយ ជីវ ចម្រុះ ជាច្រើន ។ ជាពិសេស គឺ ត្រីប បែល យក្ស ពិតជា មាន ទំហំ ធំ ហើយ បើ មេ វា មាន ទំហំ បែប នេះ កូន វា ក៏ អាចនឹង មិន តូច នោះ ទេ ។
សូម ជម្រាប ថា ចាប់ពី ឆ្នាំ ២០២០ មក រដ្ឋបាល ជលផល នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង គម្រោង អច្ឆរិយភាព នៃ ទន្លេ មេគង្គ បាន លែង ប្រភេទ ត្រី ដែល កំពុង រងគ្រោះថ្នាក់ ចំនួន ១៦. ២៣៦ ក្បាល ចូលក្នុង ដែន ទឹក ធម្មជាតិ វិញ រួម មាន ត្រី គល់ រាំង ត្រី រាជ ត្រី ត្រសក់ ត្រី ប្រាធំ ក្នុនោះ ត្រី ប បែល យក្ស ៣ក្បាល ៕
ពលរដ្ឋ ភូមិ តា ព្រហ្ម សង្កាត់ ព្រែក ឯង ស្នើ ឱ្យ អាជ្ញាធរ ចាត់ វិធានការបិទ កសិដ្ឋាន ចិញ្ចឹម មាន់ ជល់ គ្មាន ច្បាប់ អនុញ្ញាត មួយ កន្លែង ដែល រំលោភ ការព្រមព្រៀង នៅតែ បង្ក សម្លេង រំខាន និង ក្លិន ស្អុយ
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ តា ព្រហ្ម សង្កាត់ ព្រែក ឯង ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ បាន ដាក់ ពាក្យ បណ្តឹង ជាថ្មី ប្តឹង ម្ចាស់ សិដ្ឋាន ចិញ្ចឹម មាន់ ជល់ គ្មាន ច្បាប់ អនុញ្ញាត មួយ កន្លែង ដែល រំលោភ កិច្ចព្រមព្រៀង នៅតែ បង្ក សម្លេង រំខាន និង ក្លិន ស្អុយ ដល់ អ្នក រស់ នៅ ជុំវិញ ។
សូម ជម្រាប ថា ករណី កសិដ្ឋាន ចិញ្ចឹម មាន់ ជល់ ដែល បង្ក សម្លេង រំខាន និង ក្លិន ស្អុយ នេះ ត្រូវបាន ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ តា ព្រហ្ម សង្កាត់ ព្រែក ឯង ប្តឹង ទៅ អាជ្ញាធរ ម្តង រួច មកហើយ ។ កាលពី ព្រឹក ថ្ងៃទី ៩ ខែសីហា ឆ្នាំ ២០២៣ កន្លងទៅ អាជ្ញាធរ ខណ្ឌ ច្បារអំពៅ និង មន្ទីរ កសិកម្ម រាជធានី ភ្នំពេញ បាន ប្រជុំ ដោះស្រាយ ផងដែរ ។ ក្រោយពី បាន ប្រជុំ ពិភាក្សា ជាមួយ ភាគី តំណាង ប្រជាពលរដ្ឋ ភាគី តំណាង ម្ចាស់ អាជីកម្ម ចិញ្ចឹម មាន់ និង អ្នក ពាក់ព័ន្ធ រួច មក អង្គប្រជុំ សម្រេច ដូច ខាងក្រោម៖
១៖ សូមឲ្យ ភាគី ម្ចាស់ អាជីវកម្ម ចិញ្ចឹម មាន់ រុះរើ ផ្លាស់ប្តូរ ទៅ ទីតាំង ផ្សេង ដែល ឆ្ងាយ ពី ទីប្រជុំជនរស់ នៅ ។
២៖ នៅ ទីតាំង នេះ មិន អនុញ្ញាត ច្បាប់ ឲ្យ បើក អាជីវកម្ម ចិញ្ចឹម មាន់ បាន ទេ ។
៤៖ មិន អនុញ្ញាតឲ្យ ម្ចាស់ អាជីវកម្ម យក មាន់ ថ្មី ផ្សេងទៀត ចូល ទីតាំង កសិដ្ឋាន នេះ ។
៥៖ ម្ចាស់ អាជីកម្ម ចិញ្ចឹម មាន់ ត្រូវ សំអាត និង មាន អនាម័យ ល្អ នៅ ទីតាំង ចិញ្ចឹម និង ជៀសវាង សំឡេង រំខាន និង មាន ក្លិន ស្អុយ ប៉ះពាល់ ដល់ អ្នកជិតខាង ។
ប៉ុន្តែ ដោយសារ ម្ចាស់ កសិដ្ឋាន មិន បាន គោរព តាម ការព្រមព្រៀង ដោយ មិន មាន វិធានការ កាត់បន្ថយ សម្លេង មាន់ រងាវ រំខាន និង ក្លិន ស្អុយ ចេញ ពី កសិដ្ឋាន ទើប ប្រជាពលរដ្ឋ ដាក់ ពាក្យ បណ្តឹង ជាថ្មី និង ស្នើ ឱ្យ បិទ កសិដ្ឋាន គ្មាន ច្បាប់ អនុញ្ញាត នោះ ៕
កាលពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ កូរ៉េ ខាងជើង បាន ហៅ UNC ថា ជា ឧបករណ៍ សម្រាប់ ប្រឈមមុខ គ្នា របស់ អាមេរិក ដែល មិន មាន ពាក់ព័ន្ធ ជាមួយ អង្គការ សហ ប្រជាជាតិ ទាល់តែសោះ ហើយ ជា អង្គការ សង្រ្គាម ខុស ច្បាប់ មួយ ដែល ចាំបាច់ ត្រូវតែ រំលាយ ចោល ប្រសិនបើ ចង់ ទប់ស្កាត់ ការផ្ទុះឡើង នៃ សង្រ្គាម សា ជា ថ្មី នៅ ឧបទ្វីប កូរ៉េ ៕ រូបភាព ពី Reuters ប្រកាស ផ្ទេរ ភារកិច្ច និង ទទួលស្គាល់ រចនាសម្ពន្ធ ដឹកនាំ របស់ គណៈកម្មាធិការ ប្រតិបត្តិ សម្ពន្ធ យុវជន ស្រឡាញ់ សន្តិភាព ស .យ .ស. ស ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ ពិធី ប្រកាស ផ្ទេរ ភារកិច្ច និង ទទួល សហគាល់ រចនាសម្ព័ន្ធ ដឹកនាំ របស់ គណៈកម្មាធិការ ប្រតិបត្តិ សម្ព័ន្ធ យុវជន ស្រឡាញ់ សន្តិភាព ( ស.យ .ស. ស) ខេត្ត បាត់ដំបង ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ប៉ាន់ ខែម ប៊ុន ថន ប្រធាន គណៈកម្មាធិការ កណ្តាល សម្ព័ន្ធ យុវជន ស្រឡាញ់ សន្តិភាព ។
លោក សឿម ប៊ុន រិទ្ធ អភិបាល រង ខេត្ត បាត់ដំបង បាន ឡើង មាន ចំណាប់អារម្មណ៍ ដែល មាន ខ្លឹមសារ សំខាន់ ៗ យ៉ាង ក្បោះក្បាយ ដល់ អង្គ ពិធី ព្រមទាំង គាំទ្រ សហការ និង អបអរសាទរ ដល់ អស់ លោក ទើប បាន ទទួល តំណែង ថ្មី បន្ត ជួយ ការងារ សង្គមជាតិ ផងដែរ ។
លោក ប៉ាន់ ខែម ប៊ុន ថន បាន លើកឡើង ថា សម្ព័ន្ធ យុវជន ស្រឡាញ់ សន្តិភាព បាន ផ្លាស់ប្តូរ ឈ្មោះ មកពី ឈ្មោះ សម្ព័ន្ធ យុវជន សេនានាគ កន្លងមក ដែល មាន រចនាសម្ព័ន្ធ នៅ ខេត្ត មួយចំនួន និង នៅ បណ្តា ក្រុង ស្រុក មួយចំនួន ដែរ បច្ចុប្បន្ន នេះ បាន និង កំពុង កសាង ពង្រីក សាខា នៅ តាម ខេត្ត បន្ថែម ទៀត ដើម្បី ងាយស្រួល បន្ត ធ្វើ ការងារ របស់ ខ្លួន ផងដែរ ៕ វេទិកា ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម នៅ ស្រុក បាធាយ ទទួលបាន សំណើ ជាច្រើន និង ត្រៀម ដោះស្រាយ ជូន ពលរដ្ឋ
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង ចាម នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន រៀបចំ បាន រៀបចំ វេទិការផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ លើក ទី៥ អាណត្តិ ទី៣ ឆ្នាំ ២០២៣ នៅ បរិវេណ មុខ វត្ត សុវណ្ណ គិរី ជើង ឆ្នុក ស្ថិត ក្នុង ភូមិ ជើង ឆ្នុ ក ឃុំ តាំង ក្រាំង ស្រុក បាធាយ ។
ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក ហៃ ងួន លី និង លោក គន់ សុភា អភិបាល រង ខេត្ត កំពង់ចាម ដោយ មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ខេត្ត តំណាង មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត សមាជិក ក្រុមប្រឹក្សា ឃុំ និង ប្រជាពលរដ្ឋ ជាច្រើន រូប ទៀត ។
លោក ហៃ ងួន លី បាន ឱ្យដឹង ថា ការរៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ គឺជា ឧបករណ៍ ដ៏ មាន សារៈសំខាន់ មួយ សម្រាប់ លើក កម្ពស់ គណនេយ្យភាព តម្លាភាព និង ការចូលរួម របស់ ប្រជាពលរដ្ឋ ទាំង បុរស និង ស្ត្រី ក្នុង កិច្ច ដំណើរការ អភិបាលកិច្ច របស់ ក្រុមប្រឹក្សា នៃ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
សូម បញ្ជាក់ ថា អង្គ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ បាន ឆ្លើយតប និង បកស្រាយ បំភ្លឺ នូវ សំណួរ និង សំណូមពរ បាន ចំនួន ៧សំណួរ និង សំណូមពរ ដែល នៅ សេសសល់ ៦ទៀត ត្រូវបាន យក ទៅ ពិភាក្សា ដោះស្រាយ នៅ ពេល ក្រោយ តាម ប្រភេទ រដ្ឋបាល នីមួយ ៗ ៕
ដូច ប្រទេស ជាច្រើន ទៀត ដែរ សហរដ្ឋ អាមេរិក មិន មាន ទំនាក់ទំនង ផ្លូវការ ជាមួយ តៃវ៉ាន់ ឡើយ ប៉ុន្តែ ជា ខ្នង បង្អែក ដ៏ សំខាន់ របស់ ដែន កោះ នេះ នៅលើ ឆាក អន្តរជាតិ និង ជា អ្នកផ្គត់ផ្គង់ សព្វាវុធ ។ ភាពតានតឹង ជុំវិញ កោះ តៃវ៉ាន់ ត្រូវ គេ រំពឹង ថា ក៏ ទំនងជា នឹង ត្រូវ លើកឡើង ផងដែរ នៅពេល លោក បៃ ដិន ជួប ប្រធានាធិបតី ចិន លោក ស៉ី ជីន ពីង នៅ ក្រៅ កិច្ចប្រជុំ APEC នា ថ្ងៃពុធ សប្តាហ៍ នេះ ( ពេលវេលា ក្នុង តំបន់ ) ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន រៀបចំ ការប្រឡង ជ្រើសរើស សមាសភាព គណៈកម្មការ រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត ( គធ. ខប ) ដើម្បីឱ្យ បម្រើ ការងារ នៅ តាម គណៈកម្មការ រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត ទាំង ២៥ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ។
យោង តាម ផែនការ មេ. ការប្រឡង ជ្រើសរើស សមាសភាព គណៈកម្មការ រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ត្រូវ ប្រព្រឹត្តទៅ នៅ គ្រប់ រាជធានី ខេត្ត ។
ដើម្បីឱ្យ ការប្រឡង នេះ ប្រព្រឹត្តទៅ ប្រកបដោយ ភាពត្រឹមត្រូវ តម្លាភាព និង យុត្តិធម៌ គ.ជ. ប បាន ចាត់តាំង សមាជិក និង ថ្នាក់ដឹកនាំ នៃ អគ្គ លេខាធិការដ្ឋាន គ.ជ. ប ចុះ ជ្រើសរើស ដោយ ផ្ទាល់ នៅ តាម រាជធានី ខេត្ត ទាំង២៥ ។ ដោយឡែក សម្រាប់ កញ្ចប់ វិញ្ញាសារ នៃ ការប្រឡង ត្រូវ ក៏ ត្រូវបាន រក្សាទុក យ៉ាង មាន សុវត្ថិភាព គ្មាន បេក្ខជន ណា ម្នាក់ អាច ដឹង សំណួរ មុន ការប្រឡង បាន ឡើយ ។
លោក តុ ប ឬ ទ្ធី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន សេវាកម្ម ច្បាប់ និង បច្ចេកទេស គ.ជ. ប បាន គូសបញ្ជាក់ ថា ការប្រលង ជ្រើសរើស មន្ត្រី ដើម្បី បម្រើ ការងារ គឺ ផ្អែក ទៅ លើ សមត្ថភាព ច្បាស់លាស់ បម្រើ ឱ្យ ការងារ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ នៅពេល ខាងមុខ នេះ ។
លោក បាន បន្ត ថា បើ ទោះបី ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ជា ការបោះឆ្នោត អសកល មែន តែ គ.ជ. ប បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ដំណើរការបោះឆ្នោត នេះ មាន តម្លាភាព ។
ខេត្ត ដែល ត្រូវ រៀបចំ ការប្រឡង នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ មាន ចំនួន ១៣ ខេត្ត រួម មាន៖ ខេត្ត ពោធិ៍សាត់ ខេត្ត ប៉ៃលិន ខេត្ត សៀមរាប ខេត្ត កោះកុង ខេត្ត កំពត ខេត្ត ស្វាយរៀង ខេត្ត រតនគិរី ខេត្ត ស្ទឹងត្រែង ខេត្ត ត្បូងឃ្មុំ ខេត្ត ឧត្តរមានជ័យ ខេត្ត ព្រះសីហនុ ខេត្ត កណ្តាល និង ខេត្ត ព្រះវិហារ ។
ដោយឡែក រាជធានី ខេត្ត ដែល រៀបចំ ការប្រឡង នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ មាន ចំនួន ១២ រាជធានី ខេត្ត រួម មាន៖ ខេត្ត កំពង់ឆ្នាំង ខេត្ត បាត់ដំបង ខេត្ត កំពង់ធំ ខេត្ត កំពង់ស្ពឺ ខេត្ត តាកែវ ខេត្ត ព្រៃវែង ខេត្ត មណ្ឌលគិរី ខេត្ត ក្រចេះ ខេត្ត កំពង់ចាម ខេត្ត បន្ទាយមានជ័យ ខេត្ត កែប និង រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ជូន ថា កាលពី ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២៣ គ.ជ. ប បាន ប្រកាស ជ្រើសរើស សមាសភាព គធ . ខប ចំនួន ១៧៥ រូប ជា មន្ត្រី ជាប់ កិច្ចសន្យា រយៈ ពេល ខ្លី ឱ្យ បម្រើ ការងារ នៅ តាម គធ .ខ ប សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ។
សេនានុព័ន្ធ យោធា នៃ ចក្រភព អង់គ្លេស ប្រចាំ កម្ពុជា កោតសរសើរ ភាពក្លាហាន នៃ កងកម្លាំង មួក ខៀវ កម្ពុជា ដែល ចូលរួម ក្នុង វិស័យ រក្សា សន្តិភាព ជាពិសេស កិច្ចសហប្រតិបត្តិការ បោសសម្អាត មីន
នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ចូល ជួប ពិភាក្សា ការងារ ជាមួយ ឧត្តមសេនីយ៍ ទោ ប្រាក់ សុទ្ធ អគ្គ នាយក រង នៃ មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព តំណាង នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព ។
លោក មាន មោទនភាព យ៉ាង ខ្លាំង ចំពោះ ភាពក្លាហាន នៃ កងកម្លាំង មួក ខៀវ កម្ពុជា ដែល ចូលរួម ក្នុង វិស័យ រក្សា សន្តិភាព ជាពិសេស កិច្ចសហប្រតិបត្តិការ បោសសម្អាត មីន ។ មិន ត្រឹមតែ ប៉ុណ្ណោះ លោក ក៏ បាន បង្ហាញ ពី ការគាំទ្រ និង ចង់ ជួយ កម្ពុជា ឱ្យ សម្រេចបាន ជោគជ័យ ក្នុង គម្រោង កម្ពុជា គ្មាន មីន ក្នុង ឆ្នាំ ២០២៥ ។
ទន្ទឹម នោះ ឧត្តមសេនីយ៍ ទោ ក៏ បាន ថ្លែងអំណរគុណ ដល់ ចក្រភព អង់គ្លេស ដែល បាន បញ្ជូន កងកម្លាំង រក្សា សន្តិភាព ក្នុង បេសកកម្ម UNTAC មក កម្ពុជា នា ឆ្នាំ ១៩៩១ - ១៩៩៣ និង បាន ពលី នូវ យុទ្ធជន ម្នាក់ ផងដែរ ។
ក្នុង នា មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព ឧត្តមសេនីយ៍ ទោ ប្រាក់ សុទ្ធ រីករាយ ជាខ្លាំង ចំពោះ ទឹកចិត្ត របស់ ភាគី ចក្រភព អង់គ្លេស ។ ឧត្តមសេនីយ៍ ទោ ក៏ បាន ស្នើសុំ ដល់ ភាគី ចក្រភព អង់គ្លេស ជួយ ផ្តល់ វគ្គ ហ្វឹកហ្វឺន វែង - ខ្លី បន្ថែម ទៅ លើ ជំនាញ បោសម្អាត មីន ភាសា ការបញ្ជា Drones រួមទាំង ការផ្លាស់ប្តូរ ទស្សនកិច្ច រវាង ប្រទេស ទាំង ពីរ ផងដែរ ។
អនុប្រធាន មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ម្នាក់ និង បក្ខពួក ៤នាក់ ទៀត ត្រូវ តុលាការ ឃុំ ខ្លួន ក្រោម បទ ចោទ « ចាប់ និង បង្ខាំង ដោយ ខុស ច្បាប់ មាន ស្ថាន ទម្ងន់ ទោស ( ជំរិត យក ប្រាក់ )»
( ភ្នំពេញ ) ៖ ចៅក្រម ស៉ើប សួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ លោកស្រី សឿន ចរិយា នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន ចេញ ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន អនុប្រធាន មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ម្នាក់ និង បក្ខពួក ៤នាក់ ទៀត ដាក់ ពន្ធនាគារ ជា បណ្ដោះអាសន្ន ក្រោម បទ ចោទ « ចាប់ និង បង្ខាំង ដោយ ខុស ច្បាប់ មាន ស្ថាន ទម្ងន់ ទោស ( ជំរិត យក ប្រាក់ )» ។
មន្ដ្រី សាលាដំបូង រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ការសម្រេច ឃុំ ខ្លួន នេះ គឺ ធ្វើឡើង បន្ទាប់ពី លោក វង្ស សាវ៉ាត ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច ចោទប្រកាន់ ក្រុម ជន ត្រូវ ចោទ ខាងលើ ពី បទ « ចាប់ និង បង្ខាំង ដោយ ខុស ច្បាប់ មាន ស្ថាន ទម្ងន់ ទោស ( ជំរិត យក ប្រាក់ )» រួច មក . ជន ត្រូវ ចោទ ទាំង ៥នាក់ ត្រូវបាន បញ្ជូន ទៅកាន់ ចៅក្រម ស៊ើបសួរ ដើម្បី សួរនាំ និង ចាត់ការ បន្ត ទៀត ។
ទាក់ទិន ករណី នេះ លោក ប្លង់ សុផល អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន រៀបរាប់ អំពី ដំណើរ រឿង ថា៖
កាលពី ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ២០២៣ ក្រុម ជនសង្ស័យ ខាងលើ ព្រមទាំង បក្ខពួក បាន ធ្វើ សកម្មភាព ឃាត់ រថយន្ត របស់ ជនរងគ្រោះ ជា ជនជាតិ ចិន ចំនួន ៣ករ ណី៖
លុះ ដល់ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ វេលា ម៉ោង ៥៖០០ នាទី ក្រុម ជនសង្ស័យ បាន ទៅ ជួប ជនរងគ្រោះ ដើម្បី ចរចារ ពី តម្លៃ ក្នុង ការដោះលែង ឲ្យ មាន សេរីភាព វិញ ដោយ តម្រូវឲ្យ បង់ប្រាក់ ក្នុង ម្នាក់ ចំនួន ១០.០០០ ដុល្លារ ជា ថ្នូរ នឹង ការដោះលែង ។ ក្រោយ បង្ខាំង អស់ ជាង ១យប់ ក្រុម ជនសង្ស័យ បាន មក ចរចារ ពី តម្លៃ ក្នុង ការដោះលែង ឲ្យ មាន សេរីភាព ម្តង ទៀត ពេល នោះ ជនរងគ្រោះ ឈ្មោះ ZHU JIWANG បាន យល់ព្រម ប្រគល់ ទូរស័ព្ទ រួមទាំង លេខ សម្ងាត់ គណនី ធនាគារ ABA ទៅឲ្យ ក្រុម ជនសង្ស័យ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៨. ៩៤៨ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៥. ៨៩០ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ ឯក អគ្គ រាជ ទូត អារ៉ាប៊ី សាអូឌីត ប្រចាំ នៅ កម្ពុជា បង្ហាញ បំណង គាំទ្រ ជួយ កម្ពុជា ក្នុង សម្របសម្រួល រាល់ ឯកសារ ករណី ដែល ត្រូវការ ថវិកា ពី មូលនិធិ អារ៉ាប៊ី សាអូឌីត សម្រាប់ ការអភិវឌ្ឍ SFD
ជាមួយគ្នា នោះ លោក បណ្ឌិត បាន សម្ដែង អារម្មណ៍ រីករាយ ចំពោះ ដំណើរទស្សនៈកិច្ច របស់ ឯកឧត្ដម ឯក អគ្គ រាជ ទូត ដែល នេះ បញ្ជាក់ ពី ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង កម្ពុជា និង អារ៉ាប៊ី សាអូឌីត ។ លោក បាន ស្នើសុំ ដល់ រាជ រដ្ឋាភិបាល ប្រទេស អារ៉ាប៊ី សាអូឌីត ឲ្យ ជួយ សម្រួល បន្ថែម ទៀត នូវ អាហារូបករណ៍ សម្រាប់ និសិត្ស កម្ពុជា គម្រោង សាងសង់ វិហារ សាលារៀន និង គម្រោង មនុស្សធម៌ ជាដើម ដើម្បី ចូលរួម អភិវឌ្ឈ នៅ កម្ពុជា ។
លោក អូស្មាន ហាស្សាន់ ក៏ បាន ស្នើសុំ ក្នុង ការបង្កើន ចំនួន អ្នកធ្វើ ហាជ្ជី ( ធ្វើ បុណ្យ ធម្មយាត្រា ) សម្រាប់ កម្ពុជា ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ឥស្លាម កម្ពុជា មាន ឱកាស ទៅ ធ្វើ បុណ្យ ហាជ្ជី បាន ច្រើន ក្នុង ការបំពេញ កាតព្វកិច្ច ដ៏ សំខាន់ នេះ ។ លោក ក៏ បាន លើកឡើង ពី សន្ទុះ នៃ ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ នៅ កម្ពុជា ដូចជា វិស័យ ពាណិជ្ជកម្ម ទេសចរណ៍ កសិកម្ម អប់រំ និង វិស័យ ផ្សេង ៗ ទៀត ។
លោក បណ្ឌិត បាន ស្នើឲ្យ ភាគី ប្រទេស អារ៉ាប៊ី សាអ៊ូឌីត ជួយ សហការ និង ផ្សព្វផ្សាយ ដល់ ប្រជាជន សហគ្រិន អ្នក វិនិយោគ នៃ ប្រទេស អារ៉ាប៊ី សាអ៊ូឌីត ឲ្យ មក វិនិយោគ លើ វិស័យ នានា រួមទាំង វិស័យ ហាឡាល កសិកម្ម និង ឧស្សាហកម្ម ដោយ កម្ពុជា បាន ត្រៀម ខ្លួន រួច ជាស្រេច ក្នុង ការសហការ ជាមួយ ប្រទេស អារ៉ាប៊ី សាអ៊ូឌីត ។
ជា កិច្ច ឆ្លើយតប ភាគី អារ៉ាប៊ី សាអូឌីត ពិតជា មាន បំណង ក្នុង ការសហការ ជាមួយ កម្ពុជា ដើម្បី ផលប្រយោជន៍ រួម ហើយ ឥលូវនេះ អារ៉ាប៊ី សាអូឌីត បាន និង កំពុង ខិតខំ ប្រឹងប្រែង ក្នុង ការបើក ស្ថានទូត របស់ ខ្លួន ឲ្យ មាន និវេសនដ្ឋាន នៅ រាជធានី ភ្នំពេញ ឲ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ បាន ដើម្បី ពង្រឹង និង សម្រួល រាល់ កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា - អារ៉ប៊ី សាអី ឌីត ឲ្យបាន កាន់តែ ល្អ ប្រសើរ លើ គ្រប់ វិស័យ ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត៖ ការដាក់ ឱ្យ អនុវត្ត កម្មវិធី របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព គឺ ឆ្លើយតប នឹង ប្រាថ្នា របស់ ពលរដ្ឋ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ថ្លែង ថា ការដាក់ ឱ្យ អនុវត្ត កម្មវិធី របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព គឺ ឆ្លើយតប នឹង ប្រាថ្នា របស់ ប្រជាពលរដ្ឋ ពិសេស ការគាំទ្រ ជីវភាព នៅពេល មាន គ្រោះថ្នាក់ ការងារ ការថែទាំ សុខភាព ការទទួលបាន ប្រាក់ សោធន ដែល មិន ធ្លាប់ មាន នៅក្នុង ប្រវត្តិសាស្ត្រ កម្ពុជា នោះ ទេ ។
ការថ្លែង បែប នេះ របស់ សម្ដេច ធិបតី ធ្វើឡើង ពិធី ប្រកាស ដាក់ ឱ្យ អនុវត្ត ជា ផ្លូវការ « របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាម របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ បុគ្គល ស្វ័យ និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក ប .ស.ស. » និង « កម្មវិធី បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ » នៅ សណ្ឋាគារ សុខា ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្ដេច ធិបតី បាន ថ្លែង ថា ការអនុវត្ត របប សន្តិសុខ សង្គម គឺជា ការអនុវត្ត ដោយ យកចិត្តទុកដាក់ ដ៏ ចម្បង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការជួយ ប្រជាពលរដ្ឋ ឱ្យ ទទួលបាន អត្ថប្រយោជន៍ ពិសេស ការគាំទ្រ ជីវភាព នៅពេល មាន គ្រោះថ្នាក់ ការងារ ការថែទាំ សុខភាព ការទទួលបាន ប្រាក់ សោធន ដូច មន្ត្រីរាជការ សាធារណៈ ដែរ ដែល ពីមុន មក មិន មាន អនុវត្ត នោះ ទេ នៅក្នុង ប្រវត្តិសាស្ត្រ កម្ពុជា ។
សម្ដេច ធិបតី បាន បន្ត ថា កម្មវិធី របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាម របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត ដែល ប្រកាស ដាក់ ឱ្យ អនុវត្ត ជា ផ្លូវការ នៅ ថ្ងៃ នេះ មាន វិសាលភាព អនុវត្ត ចំពោះ បុគ្គល ស្វ័យ និយោជន៍ និង អ្នក នៅក្នុង បន្ទុក សមាជិក ប .ស. ស រួម មាន ប្ដី ឬ ប្រពន្ធ និង កូន ក្នុង បន្ទុក ដើម្បីឱ្យ ពលរដ្ឋ ដែល ជា បុគ្គល ស្វ័យ និយោជន៍ និង អ្នក នៅក្នុង បន្ទុក សមាជិក ប .ស. ស គឺ កូន ក្រោម អាយុ ១៨ ឆ្នាំ ប្ដី ឬ ប្រពន្ធ ដែល មាន អាយុ ៦០ ឆ្នាំ ចុះ អាច បង់ ភាគ ទាន ផ្នែក ថែទាំ សុខភាព បាន ។
បុគ្គល ស្វ័យ និយោជន៍ និង សមាជិក ប .ស. ស រួម មាន ប្ដី ឬ ប្រពន្ធ និង កូន ក្នុង បន្ទុក អាច ទទួលបាន របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព ដោយ គ្រាន់តែ បង់ ភាគ ទាន ២.៦% នៃ ប្រាក់ ចំណូល ជាប់ ភាគ ទាន ៦០ ម៉ឺន រៀល ដែល ស្មើនឹង ១៥. ៦០០ រៀល ។ ការចូលរួម ជា សមាជិក ប .ស. ស ផ្នែក ថែទាំ សុខភាព ទាំង របប ភាគ ទាន កាតព្វកិច្ច និង របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត អនុញ្ញាតឱ្យ កម្មករ និយោជិត ទទួលបាន អត្ថប្រយោជន៍ ជាច្រើន ។
កង ប្រតិបត្តិការ រុករក និង សង្គ្រោះ គ្រោះមហន្ដរាយ៧១១ បញ្ចប់ ការហ្វឹកហាត់ និង លំហាត់ រួមគ្នា ជាមួយ បណ្ដា ប្រទេស នានា នៅ ប្រទេស ជប៉ុន ដោយ ជោគជ័យ លើ ការរំពឹងទុក
( ណាហ្គាអូកា - ជប៉ុន ) ៖ ការហ្វឹកហាត់ និង ធ្វើ លំហាត់ រួមគ្នា ៩ ប្រទេស នូវ ជំនាញ សង្គ្រោះ គ្រោះមហន្តរាយ ដែល រៀបចំ ដោយ ភាគី ជប៉ុន និង ទស្សនកិច្ច សិក្សា នៅ ស្ថាប័ន ពន្លត់ អគ្គីភ័យ នៅ ក្រុង ណាហ្គាអូកា នៅ សាកលវិទ្យាល័យ កូហ្គាគូ អុីន ទីក្រុង កូបេ និង ស្ថាប័ន ពន្លត់ អគ្គីភ័យ ទីក្រុង មីគិ របស់ កង ប្រតិបត្តិការ រុករក និង សង្គ្រោះ គ្រោះមហន្តរាយ ៧១១ កងពល តូច លេច៧០ ចាប់ពី ថ្ងៃទី ០៨ ដល់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ត្រូវបាន បញ្ចប់ ដោយ ទទួលបាន លទ្ធផល ល្អ ប្រសើរ លើស ពី ការរំពឹងទុក ។
ការចូលរួម ហ្វឹកហាត់ ជំនាញ សង្គ្រោះ គ្រោះមហន្តរាយ វគ្គ នេះ បាន ផ្តល់ នូវ សារៈសំខា ន់៖
* ទី១៖ បទពិសោធន៍ ថ្មី ៗ ដើម្បី យកមក បម្រើ ការ និង អនុវត្ត នៅ ប្រទេស កម្ពុជា * ទី ២៖ ពង្រឹង ស្មារតី នៃ ការសហការ និង ភាពទទួលខុសត្រូវ ប្រកបដោយ វិជ្ជាជីវៈ ពេល ចេញ ប្រតិបត្តិការ សង្គ្រោះ * ទី៣៖ ចំណេះដឹង បច្ចេកទេស លើ ការប្រើប្រាស់ សម្ភារ និង ឧបករណ៍ សង្គ្រោះ ។
ទស្សនកិច្ច សិក្សា បាន ជួយ ពង្រឹង ស្មារតី ប្រុងប្រៀប ការត្រួតពិនិ្យ លើ គុណភាព និង ថែទាំ សម្ភារ សង្គ្រោះ ជាប្រចាំ និង ការដាក់ចិត្ត ដាក់ ពេល ប្រតិបត្តិការ សង្គ្រោះ និង ចេះ សាមគ្គីភាព ចេះ សហការ រវាង ក្រុម សង្គ្រោះ គ្រោះ បឋម និង ក្រុម ពន្លត់ អគ្គីភ័យ ។
នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្រុមការងារ ប្រតិភូ ៧១១ បាន ចេញដំណើរ ពី ទីក្រុង កូបេ ប្រទេស ជប៉ុន ឆ្ពោះ ទៅកាន់ អាកាសយានដ្ឋាន អន្តរជាតិ កាន់ សាយ អូសាកា ដើម្បី ធ្វើ មាតុភូមិ និវត្តន៍ ទៅ កម្ពុជា វិញ ៕
រដ្ឋមន្ត្រី ប៉េង ពោធិ៍នា ដឹកនាំ កិច្ចប្រជុំ រក ដំណោះស្រាយ បញ្ហា ប្រឈម លើ ដែន សមត្ថកិច្ចការងារ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ការដឹកជញ្ជូន ផ្លូវគោក និង បញ្ហា ពាក់ព័ន្ធ
( ភ្នំពេញ ) ៖ លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅសៀល ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ដើម្បី រក ដំណោះស្រាយ សម្រាប់ បញ្ហា ប្រឈម ដែល មាន លើ ដែន សមត្ថកិច្ចការងារ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ការដឹកជញ្ជូន ផ្លូវគោក និង បញ្ហា ពាក់ព័ន្ធ ផ្សេង ៗ ទៀត ។
ជា លទ្ធផល នៃ កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្រ្តៃយ៍ រដ្ឋសភា បាន អនុម័ត កំណត់ កាលបរិច្ឆេទ បន្ត សម័យ ប្រជុំ រដ្ឋសភា លើក ទី១ នីតិកាល ទី៧ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ខាងមុខ ដោយ មាន របៀបវារៈ ចំនួន បួន រួម មាន៖
ព្រះអង្គ ក៏ បាន សំដែង នូវ ក្តី រំពឹង យ៉ាង ខ្លាំង ចំពោះ ១៖ គម្រោង នៃ ការសិក្សា ការជួសជុល និង ការពង្រីក សារ មន្ទីរ ជាតិ ដោយ អ្នកជំនាញ របស់ បារាំង ២៖ កិច្ចសហប្រតិបត្តិការ រវាង សារមន្ទីរ ជាតិ និង សារមន្ទីរ Guimet និង ៣៖ ការជួសជុល រូប ព្រះវិស្ណុ ផ្ទុំ ធ្វើ ពី សំរិទ្ធ រួមទាំង ការតាំង បង្ហាញ វត្ថុ បុរាណ ខ្មែរ នៅ ប្រទេស បារាំង និង សារមន្ទីរ នានា ។
ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ កូរ៉េ ខាងជើង KCNA តាមរយៈ ការស្រង់ សម្ដី ពី លោក Jo Chol Su ជា អគ្គ នាយក នៃ នាយកដ្ឋាន អង្គការ អន្តរជាតិ នៃ ក្រសួង ការបរទេស កូរ៉េ ខាងជើង បាន ថ្កោលទោស ក្រុម រដ្ឋមន្ត្រី ការបរទេស នៃ ក្រុម ប្រទេស G7 ចំពោះ អ្វី ដែល លោក ហៅ ថា ជា ការនិយាយ មួល បង្កាច់ ពី សិទ្ធិ ស្វ័យ ការពារ ខ្លួន និង អធិបតេយ្យ ស្រប ច្បាប់ របស់ កូរ៉េ ខាងជើង នៅក្នុង សេចក្ដីថ្លែងការណ៍ រួម មួយ ក្រោយ ជំនួប មួយ ក្នុង ទីក្រុង តូក្យូ កាលពី សប្ដាហ៍ មុន ។
សេចក្ដីថ្លែងការណ៍ រួម របស់ ក្រុម ប្រទេស G7 បាន អំពាវនាវ ឱ្យ មាន បទ ឈប់ បាញ់ មួយ ដើម្បី បុព្វហេតុ មនុស្សធម៌ ក្នុង សង្រ្គាម រវាង អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស ភ្ជាប់ ជាមួយ ការអះអាង ឡើងវិញ ពី ការគាំទ្រ សម្រាប់ អ៊ុយក្រែន តែ បាន ថ្កោលទោស ការធ្វើតេស្ដមីស៊ីល និង ការបញ្ជូន អាវុធ របស់ ទីក្រុង ព្យុងយ៉ាង ទៅ ឱ្យ រុស្ស៉ី ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ១២នាក់ ។
រាជ រដ្ឋាភិបាល គណបក្ស ប្រជាជន កម្ពុជា គាំពារ ពលរដ្ឋ ក្រីក្រ និង វិស័យ ឯកជន គ្រប់ កាលៈទេសៈ
( ភ្នំពេញ ) ៖ តាំងពី សម័យកាល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន រហូតដល់ អណត្តិ អ្នក បន្ត វេន ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល គណបក្ស ប្រជាជន កម្ពុជា តែង ផ្តល់ អាទិភាព ដល់ ពលរដ្ឋ ក្រីក្រ និង វិស័យ ឯកជន ។
តាមរយៈ វេទិកា រាជ រដ្ឋាភិបាល និង ផ្នែក ឯកជន លើក ទី ១៩ ដែល បើក ធ្វើ នា ព្រឹក ថ្ងៃទី ១៣ វិច្ឆិកា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ត នយោបាយ គាំពារ ពលរដ្ឋ ក្រីក្រ និង វិស័យ ឯកជន យ៉ាង ប្តូរផ្តាច់ ដូច រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ដោយ ឥត ងាក រេ ។
សម្តេច ធិបតី បាន ប្រកាស បន្ត មិន យក ភាស៊ី ពី អ្នកលក់ដូរ តូចតាច តាម ញ្ច្រែង មិន យក ពន្ធ លើ ដី កសិកម្ម ជា លក្ខណៈ គ្រួសារ មិន យក ពន្ធ អចលទ្រព្យ សម្លៃ ទាប ជាង ១០០ លាន រៀល មិន យក ពន្ធ លើ ប្រាក់ បៀវត្សរ៍ អប្បបរមា និង ប្រាក់ ឈ្នួល អប្បបរាមា របស់ កម្មករ និង មិន យក ពន្ធ ផ្សេង ៗ ទៀត យ៉ាង ច្រើន ។ និយាយ ជា រួម រាជរ រដ្ឋាភិបាល ព្យាយាម ចៀសវាង មិន យក ពន្ធ ពី អ្នក មាន ចំណូល ទាប ដើម្បី កុំ ឱ្យ ប៉ះពាល់ ជីវភាពបស់ ពួកគេ ។
ផ្ទុយទៅវិញ ពលរដ្ឋ ទាំងនោះ ទទួលបាន ការគាំពារ ពី រាជ រដ្ឋាភិបាល មុន គេ នៅ ពេល ពួកគេ ជួប វិបត្តិ ផ្សេង ៗ ដូចជា វិបត្តិ កូវីដ១៩ ឬ គ្រោះមហន្តរាយ ធម្មជាតិ ជាដើម ។
ចំពោះ វិស័យ ឯកជន វិញ ទោះបីជា សេដ្ឋកិច្ច កម្ពុជា ទទួល រង ឥទ្ធិពល អវិជ្ជមាន ពី វិបត្តិ សាកល ដូចជា វិបត្តិ ជំងឺ កូវីដ១៩ សង្គ្រាម រុស្ស៊ី និង អ៊ុយក្រែន ក៏ ដូចជា សង្គ្រាម អ៊ីស្រាអែល និង ហាម៉ាស ប៉ាឡេស្ទីន ក៏ដោយ ក៏ រាជ រដ្ឋាភិបាល មិន ទុក ឱ្យ វិស័យ ឯកជន នៅឯ កោ ឡើយ ។ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន ដាក់ចេញ វិធានការ ជាច្រើន ដើម្បី ជួយ ដោះស្រាយ បញ្ហា ប្រឈម នានា ដែល ពាណិជ្ជករ កំពុង ជួបប្រទះសំដៅ ធ្វើ យ៉ាងណា ឱ្យ ផ្នែក ឯកជន មាន សន្ទុះ ទៅ មុខ ។
ពលរដ្ឋ ក្រីក្រ និង អ្នក រក ទទួលទាន ក្នុង វិស័យ ឯកជន បាន សាទ រ យ៉ាង ខ្លាំង ចំពោះ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ដែល នៅតែ ប្តូរផ្តាច់ គាំពារ វិស័យ ឯកជន ដូច អ្វី ដែល សម្តេច តេជោ អតីត នាយក រដ្ឋមន្ត្រី ធ្លាប់ បាន ធ្វើ ដោយ ឥត ប្រែប្រួល ។
គោល នយោបាយ គាំពារ ពលរដ្ឋ ក្រីក្រ និង វិស័យ ឯកជន យ៉ាង មោះមុត នេះ ហើយ ដែល បាន ឆក់ ទាញ បេះដូង ពលរដ្ឋ ខ្មែរ ឱ្យ បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ជា ដរាប ដោយ ឥត ងាក រេ ខណៈ វិស័យ ឯកជន វិញ តែង ចូលរួម យ៉ាង សកម្ម ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី អភិវឌ្ឍន៍ ប្រទេស គ្រប់ កាលៈទេសៈ រហូត ធ្វើឱ្យ កម្ពុជា ស្គាល់ ការអភិវឌ្ឍ យ៉ាង ខ្លាំង ដូច សព្វ ថ្ងៃ ៕
ដោយ ប៉ែន បូណា អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បណ្ឌិត កៅ គឹម ហួន ផ្តល់ រង្វាន់ ប្រចាំ ខែតុលា ដល់ បុគ្គលិក ឆ្នើម ប្រចាំ លេខាធិការដ្ឋាន អាស៊ាន និង ផ្តល់ សន្ទរកថា តាម អនឡាញ នៅក្នុង ពិធី បើក នៃ ន្និសីទ សកល ស្តីពី « សន្តិសុខ និង ការទូត សុខាភិបាល សកល នៅក្នុង សតវត្សរ៍ ទី ២១ »
( ហ្សាការតា . ឥណ្ឌូណេស៊ី ) ៖ នៅ រសៀល ថ្ងៃចន្ទ ទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ លេខាធិការដ្ឋាន អាស៊ាន ប្រចាំ ទីក្រុង ហ្សាការតា សាធារណរដ្ឋ ឥណ្ឌូណេស៊ី លោក បណ្ឌិត កៅ គឹម ហួន អគ្គ លេខាធិការ អាស៊ាន បាន ផ្តល់ រង្វាន់ ប្រចាំ ខែតុលា ដល់ បុគ្គលិក ឆ្នើម ប្រចាំ លេខាធិការដ្ឋាន អាស៊ាន ។
នេះ ជា ជ័យលាភី ទី៣ហើយ ចាប់តាំងពី កម្មវិធី ដែល ជា គំនិត ផ្តួចផ្តើម របស់ អគ្គ លេខាធិការ អាស៊ាន ចាប់ផ្តើម អនុវត្ត ។ ជ័យលាភី ទទួលបាន វិញ្ញាបនបត្រ ព្រមទាំង អំណោយ ពី អគ្គ លេខាធិការ អាស៊ាន ។
ដោយឡែក នៅ យប់ ថ្ងៃចន្ទ អគ្គ លេខាធិការ អាស៊ាន បាន អញ្ជើញ ផ្តល់ សន្ទរកថា តាម អនឡាញ នៅក្នុង ពិធី បើក នៃ សន្និសីទ សកល ស្តីពី « សន្តិសុខ និង ការទូត សុខាភិបាល សកល នៅក្នុង សតវត្សរ៍ ទី ២១ » ។
( ភ្នំពេញ ) ៖ សង្រ្គាម រវាង អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស់ ប៉ាឡេ ស្ទីន អាចនឹង រីក ធំ ពេញ តំបន់ មជ្ឈឹម បូព៌ា ប្រសិនជា សហរដ្ឋ អាមេរិក និង អ៉ី ស្រាអែល ក៏ ដូចជា ក្រុមហា ម៉ាស់ ផ្ទាល់ មិន ទម្លាក់ ចោល ភាព រឹង ត្អឹង របស់ ខ្លួន ។ នេះ ជា ការលើកឡើង របស់ លោក បណ្ឌិត សភាចារ្យ រស់ ចន្រ្តា បុត្រ សាស្រ្តាចារ្យ វិទ្យាសាស្រ្ត នយោបាយ និង ជា ទីប្រឹក្សា ផ្ទាល់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ដែល បាន លើកឡើង នៅក្នុង កម្មវិធី Fresh Talk នា ថ្ងៃសៅរ៍ សប្ដាហ៍ មុន ។
ជាមួយគ្នា នេះ លោក បាន បន្ថែម ថា នៅ ពេល ដែល មិន មាន ការទម្លាក់ចុះ ភាពរឹង ត្អឹង របស់ អាមេរិក និង អ៉ី ស្រាអែល នោះ ច្បាស់ ណាស់ បណ្ដា ប្រទេស អារ៉ាប់ ដែល គាំទ្រ ប៉ាឡេ ស្ទីន ហើយ នៅ ជុំវិញ អ៉ី ស្រាអែល អាចនឹង មាន ការព្រួត គ្នា វាយ បក ទៅ លើ អ៉ី ស្រាអែល ហើយ ឈានដល់ ការបិទ ព្រែក ជីក ស៊ុយអេទៀត នោះ នោះ អាមេរិក គឺជា អ្នកខាត ធំ លើ សង្រ្គាម នេះ ហើយ នឹង ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច ពិភពលោក ទាំងមូល ។
ក្រសួង ការងារ ចេញ ប្រកាស អន្តរ ក្រសួង ស្តីពី « ការកំណត់ ភាគ ទាន និង កាលបរិច្ឆេទ ដាក់ ឱ្យ អនុវត្ត របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាមរយៈ របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ អ្នក ក្នុង បន្ទុក សមាជិក ប .ស. ស ជា មន្ត្រី សាធារណៈ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន ដាក់ចេញ នូវ ប្រកាស អន្តរ ក្រសួង ស្តីពី « ការកំណត់ ភាគ ទាន និង កាលបរិច្ឆេទ ដាក់ ឱ្យ អនុវត្ត របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាមរយៈ របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ អ្នក ក្នុង បន្ទុក សមាជិក ប .ស. ស ជា មន្ត្រី សាធារណៈ » ។
ការដាក់ចេញ នូវ ប្រកាស អន្តរ ក្រសួង នេះ ជា ការអនុវត្ត ទៅ តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ដែល ដាក់ចេញ នូវ ការងារ អាទិភាព ចំនួន ៦ ក្នុង ឆ្នាំ ២០២៣ ដល់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ក្នុុង ពិធី សំណេះសំណាល ជាមួយ កម្មករ និយោជិត កាលពី ថ្ងៃ ២៩ ខែសីហា ឆ្នាំ ២០២៣ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស អន្តរ ក្រសួង៖
កម្លាំង នគរបាល ផ្នែក សណ្ដាប់ធ្នាប់ ចរាចរណ៍ ក្រុង ប៉ោយប៉ែត បន្ត ចុះ ធ្វើ ការរៀបចំ សណ្ដាប់ធ្នាប់ នៅ ចំណុច ផ្សារ ត្រី ប៉ោយប៉ែត ក្រោយ អាជីវករ យក ចិញ្ចើមផ្លូវ ដាក់ លក់ដូរ ធ្វើឲ្យ កកស្ទះ ចរាចរណ៍
សូម បញ្ជាក់ ថា កម្លាំង នគរបាល ផ្នែក សណ្តាប់ធ្នាប់ សាធារណៈ តែងតែ បាន បន្ត ចុះ រៀបចំ សណ្តាប់ធ្នាប់ នៅ ចំណុច ផ្សារ ត្រី ដោយ បាន អប់រំ ណែនាំ បងប្អូន អាជីវករ ដែល ដាក់តាំង លក់ សម្ភារ និង ទំនិញ ផ្សេង ៗ ដែល រំលោភបំពាន លើ ទ្រូងផ្លូវ ធ្វើ អាជីវកម្ម ផ្ទាល់ខ្លួន បង្កឲ្យ មាន ការកកស្ទះ និង ប៉ះពាល់ សណ្តាប់ធ្នាប់ សុវត្ថិភាព ចរាចរណ៍ និង ដើម្បី ងាយស្រួល ធ្វើដំណើរ ទាំងអស់ គ្នា ។
ឆ្លៀត ក្នុង ឱកាស នោះ នគរបាល សណ្ដាប់ធ្នាប់ សាធារណៈ បាន ទទូច ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ដែល លក់ដូរ មួយចំនួន ដែល បាន យក ចិញ្ចើមផ្លូវ ដើម្បី រក ចំណូល ផ្ទាល់ខ្លួន គួរ គិត ពី ផល ប៉ះពាល់ ដល់ អ្នកដទៃ ផង ហើយក៏ បាន ហាម ចាប់ពី ថ្ងៃ នេះ តទៅ ត្រូវ ដាក់ លក់ដូរ ឲ្យ មាន របៀបរៀបរយ មិន ឲ្យ ដាក់ លក់ដូរ នៅលើ ដង ផ្លូវ សាធារណៈ ទៀត ទេ ចៀសវាង ការកកស្ទះ នៅលើ ដង ផ្លូវ ជុំវិញ ផ្សារ ត្រី ប៉ោយប៉ែត និង គ្រោះថ្នាក់ ជា យថាហេតុ ណាមួយ កើតឡើង ផងដែរ ៕
អាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ បញ្ជូន ជនសង្ស័យ ២នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី លួច និង គ្រឿងញៀន
( បន្ទាយមានជ័យ )៖ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង សិរី សោភ័ណ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ត្រី យ៉ាន់ សុវណ្ណ មេបញ្ជាការ មូលដ្ឋាន អាវុធហត្ថ ក្រុង បាន ដឹកនាំ កម្លាំង ចុះ ប្រតិបត្តិការ ភ្លាម ៗ ឃាត់ខ្លួន ជនសង្ស័យ ២នាក់ ករណី លួច លុយ និង ពាក់ព័ន្ធ គ្រឿងញៀន នៅ វេលា ម៉ោង ២៣ និង ០០ នាទី ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ ចំណុច សួន មានជ័យ ស្ថិត ក្នុង ភូមិ ៣ សង្កាត់ ព្រះពន្លា ។
ការចាប់ខ្លួន ជនសង្ស័យ ទាំង ២នាក់ បាន ធ្វើឡើង យោង តាម ពាក្យបណ្តឹង ជនរងគ្រោះ ឈ្មោះ ចៅ ស៊ាវ ម៉ី ភេទ ស្រី អាយុ ៣០ ឆ្នាំ មាន ទីលំនៅ បច្ចុប្បន្ន ភូមិ គោ រដ្ឋាន សង្កាត់ អូរ អំបិល ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ។
លោក វរសេនីយ៍ ត្រី យ៉ាន់ សុវណ្ណ មេបញ្ជាការ មូលដ្ឋាន អាវុធហត្ថ ក្រុង សិរី សោភ័ណ បាន ឱ្យដឹង ថា ជនសង្ស័យ ទាំង ២នាក់ រួម មាន៖
លោក វរសេនីយ៍ ត្រី យ៉ាន់ សុវណ្ណ បន្ត ថា នៅ ថ្ងៃ នោះ ក្រុម ជនសង្ស័យ បាន នាំគ្នា ធ្វើ សកម្មភាព លួច យក កាបូប ប្រាក់ និង ទូរស័ព្ទ ដៃ ដែល ជនរងគ្រោះ ខណៈ ទៅ មើល ការតាំងពិព័រណ៌ នៅ សួន មាន ជ័យ ភ្លាម ៗ ជនរងគ្រោះ បាន រាយការណ៍ ជូន កងកម្លាំង អាវុធហត្ថ ប្រចាំ ការ នៅ ទីនោះ លោក ក៏ បាន ដឹកនាំ កងកម្លាំង ដោយ ផ្ទាល់ ចុះ ស្រាវជ្រាវ រហូត ឃាត់ខ្លួន ជនសង្ស័យ ២នាក់ ភ្លាម ៗ ព្រមទាំង ដកហូត វត្ថុតាង ម៉ូតូ១ គ្រឿង និង កាបូប លុយ របស់ ជនរងគ្រោះ នាំយក មកកាន់ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង សិរី សោភ័ណ ដើម្បី ចាត់ការ តាម នីតិវិធី ។
ក្រោយ ឃាត់ខ្លួន និង សួរចម្លើយ ជនសង្ស័យ បាន សារភាព ថា ពួក ខ្លួន ពិតជា បាន លួច កាបូប លុយ និង ប្រើប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ពិតប្រាកដ មែន ។ ដោយ ផ្អែក លើ ចម្លើយ សារភាព ជនសង្ស័យ ត្រូវបាន កម្លាំង មូលដ្ឋាន អាវុធហត្ថ ក្រុង បញ្ជូន មក បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ចាត់ការ បន្ត តាម នីតិវិធី ។
លោក វរសេនីយ៍ ឯក ម៉ែន ភិរម្យ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត ទទួល ការងារ ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស បាន ឱ្យដឹង ថា ការបង្ក្រាប ករណី ខាងលើ នេះ ធ្វើឡើង ក្រោម បទបញ្ជា លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត និង មាន ការសម្របសម្រួល នីតិវិធី ពី លោក កើត វណ្ណារ៉េត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ ខេត្ត បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ហើយ នៅ ព្រឹក ថ្ងៃអង្គារ ទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ អនុវត្ត តាម នីតិវិធី ។ ចំណែក វត្ថុតាង របស់ ជនរងគ្រោះ ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ ប្រគល់ ជូន ម្ចាស់ ដើម វិញ ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្លែង បែប នេះ ពេល អញ្ជើញ ប្រកាស ដាក់ ឱ្យ អនុវត្តន៍ ជា ផ្លូវការ កម្មវិធី នយោបាយ ២ រួម មាន៖ ១៖ របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាម របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ បុគ្គល និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម និង ២៖ កម្មវិធី បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រងគ្រោះ ។
បើ តាម ប្រសាសន៍ សម្តេច ធិបតី នេះ ជា ការបង្ហាញ ថា រាជ រដ្ឋាភិបាល បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ ថែទាំ សុខភាព របស់ កម្មករ និយោជិត ដោយ មិន ទាន់ នរណា ម្នាក់ ចោល ដោយ មិន បាន ព្យាបាល ពេល មាន ជំងឺ ឡើយ ។ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ដែរ ថា ប្រជាពលរដ្ឋ ត្រូវ ចំណាយ ជា មធ្យម ក្នុង មួយ ខែ ចន្លោះ ពី ១៥ដុល្លារ ទៅ ២០ ដុល្លារ ឬ ស្មើ ២៥០ ដុល្លារ ក្នុង មួយ ឆ្នាំ ទៅ លើ បញ្ហា សុខភាព ។
ការអំពាវនាវ នេះ បាន ធ្វើឡើង ក្នុង ប្រកាស ដាក់ ឱ្យ អនុវត្ត ជា ផ្លូវការ របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាមរបប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត និង ប្រកាស ដាក់ ឱ្យ អនុវត្ត ជា ផ្លូវការ នូវ កម្មវិធី បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន អំពាវនាវ យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ សូម អំពាវនាវ ដល់ មាតា បិតា អាណាព្យាបាល យុវជន នៃ គ្រួសារ ក្រីក្រ គ្រួសារ ងាយ រង ហានិភ័យ ជួយ ជំរុញ លើកទឹកចិត្ត និង បង្ក លក្ខណៈ ងាយស្រួល ដល់ សមាជិក គ្រួសារ របស់ ខ្លួន ឱ្យ មក ចុះឈ្មោះ ចូលរៀន និង មក រៀន ឱ្យ បាន ទៀងទាត់ ឱ្យ ចប់ វគ្គ បណ្តុះបណ្តាល ដើម្បី ទទួលបាន ជំនាញ មួយ ពិតប្រាកដ ដែល អាច ទទួលបាន ការងារ និង មុខ របប សមរម្យ និង មាន ស្ថិរភាព ចំណូល » ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ណែនាំ ដល់ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ត្រូវ គ្រប់គ្រង វត្តមាន របស់ សិស្ស ឱ្យ បាន ល្អ និង ធានា បាន នូវ ការប្រឡង បញ្ចប់ វគ្គ ប្រកបដោយ តម្លាភាព គុណភាព និង ប្រសិទ្ធភាព ។
« កិច្ចការងារ នេះ ជា កិច្ចការ សំខាន់ គឺ គុណភាព នៃ ការបណ្ដុះបណ្ដាល កន្លងទៅ យើង មាន ពេល ខ្លះ អត្រា នៃ អ្នករៀន មិន ចប់ ច្រើន ការបោះបង់ ច្រើន ហើយ កិច្ចការងារ នេះ គឺ មិន ធ្វើឱ្យ ជោគជ័យ នូវ កម្មវិធី យើង ទេ អញ្ចឹង គឺ ទាមទារ នូវ ការខិតខំ របស់ ក្រសួង - ស្ថាប័ន ប៉ុន្តែ ត្រូវ មាន ការចូលរួម របស់ គ្រួសារ និង យុវជន យើង ផ្ទាល់ » ។ នេះ ជា ការលើកឡើង បន្ថែម ទៀត របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ។
ជាមួយគ្នា នេះ ដែរ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន អំពាវនាវ ដល់ យុវជន ដែល ទទួលបាន ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ សូម ដាក់ចិត្ត សិក្សា រៀនសូត្រ ឱ្យ បាន ចប់ ព្រោះ ពេលវេលា មិន រងចាំ មនុស្ស នោះ ទេ ។ ការចំណាយ ពេលវេលា ៣ខែ ៦ខែ ឬ ១ ឆ្នាំ ដើម្បី ទាញយក ចំណេះដឹង ជំនាញ នៅក្នុង ខ្លួន របស់ យើង នោះ យើង អាច មាន ជម្រើស ច្រើន សម្រាប់ អនាគត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល គ្រាន់តែ ជា អាណាព្យាបាល ជួយ បណ្តុះបណ្តាល យុវជន ឱ្យ រឹង ដៃ រឹង ជើង និង ផ្តល់ ឱកាស នៅពេល ចាំបាច់ ប៉ុន្តែ រដ្ឋាភិបាល ក៏ ដូចជា ឪពុក ម្តាយ មិន អាច នៅ ជាមួយ យើង រហូត នោះ ទេ ។ ដូច្នេះ ត្រូវ ទាមទារ ឱ្យ យុវជន និង ប្រជាលរដ្ឋ ដែល បាន ទទួល ពី ការបណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ត្រូវ ខិតខំ ឱ្យ រឹង ដៃ រឹង ជើង ខ្លួន ឯង ដើម្បី ជួយ ដល់ ឪពុក ម្តាយ និង សង្គមជាតិ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ណែនាំ ដល់ យុវជន ត្រូវ ខិតខំ រៀនសូត្រ ឱ្យ មាន គុណភាព មាន ជំនាញ ពិតប្រាកដ ហើយ ជំនាញ អ្វី ក៏ ល្អ ដែរ តែ ត្រូវ ចេះ ឱ្យ ប្រាកដ ។
សិស្ស ដែល បាន ចុះឈ្មោះ ចូលរៀន នឹង ទទួលបាន ការសិក្សា ដោយ មិន បង់ ថ្លៃ . ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ ចំនួន ២៨ ម៉ឺន រៀល . ទទួលបាន ការប្រឹក្សា យោ បល់ ពី ការជ្រើសរើស ជំនាញ និង ព័ត៌មាន ទីផ្សារ ការងារ . ចុះ កម្មសិក្សា នៅ តាម សហគ្រាស គ្រឹះស្ថាន ឧស្សាហកម្ម និង ក្រុមហ៊ុន ឯកជន . ជំនាញ មួយ ពិត ប្រា កដ ដែល ទីផ្សារ ការងារ កំពុង ត្រូវការ និង ឱកាស ការងារ ធ្វើ សមរម្យ និង ប្រាក់ ចំណូល ទៀងទាត់ ។
ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព អញ្ជើញ ប្រកាស ដាក់ ឱ្យ អនុវត្តន៍ ជា ផ្លូវការ កម្មវិធី នយោបាយ ចំនួន ពីរ ក្នុង វិស័យ ការងារ ដើម្បី ជា ឧត្តម ប្រយោជន៍ សម្រាប់ កម្មករ និយោជិត នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា កម្មវិធី នេះ នឹង ធ្វើឲ្យ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ មាន ជីវភាពល្អ ប្រសើរ ដោយ រក្សា បាន នូវ ស្ថេរភាព និង កំណើន ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ជា រួម ការដាក់ចេញ នូវ កម្មវិធី បណ្ដុះបណ្ដាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស នេះ គឺជា ខិតខំ របស់ រាជ រដ្ឋាភិបាល ដើម្បី ជួយ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ អាច មាន ចំណេះដឹង ចំណេះ ធ្វើ អាច ស្វែងរក ការងារ ឬ បង្កើត ការងារ ដោយ ខ្លួន ឯង ប្រៀប ដូចជា ការជីក ស្រះ ឲ្យ ធំ ដើម្បី ចិញ្ចឹម ត្រី និង បង្រៀន ឲ្យ បងប្អូន ចេះ ស្ទួច ត្រី ឬ នឹង ផ្ដល់ ឱកាស និង សិទ្ធិ និង ជម្រើស ជូន បងប្អូន ដើម្បី ចាប់ ត្រី ដោយ ខ្លួន ឯង » ។
សម្ដេច គូសបញ្ជាក់ ថា ច្ចុប្បន្ន រាជ រដ្ឋាភិបាល កំពុង ជួយ ឧបត្ថម្ភ សាច់ប្រាក់ ដល់ គ្រួសារ ក្រីក្រ ប្រមាណ ជាង ៧០ ម៉ឺន គ្រួសារ និង គ្រួសារ ងាយ រង ហានិភ័យ ជាច្រើន ម៉ឺន គ្រួសារ ទៀត ដែល ការជួយ ឧបត្ថម្ភ នេះ ប្រៀប ដូចជា ការឲ្យ ត្រី ទៅ បងប្អូន ប្រជាពលរដ្ឋ ដែល អាច ឲ្យ បងប្អូន អាច រស់ បាន នៅក្នុង ស្ថានភាព លំបាក ចំពោះ មុខ ប៉ុន្ដែ មិន គ្រប់គ្រាន់ ទេ សម្រាប់ ការកសាង ជីវភាពរឹងមាំ ប្រកបដោយ ចីរភាព នោះ ទេ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៦៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៦៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៦៧ នាក់ នោះ មាន ៣៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៣ករណី និង ជនសង្ស័យ ២៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ១៤ករណី ។
ការបញ្ជាក់ ឲ្យដឹង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតី ប្រកាស ដាក់ ឲ្យ អនុវត្តន៍ ជា ផ្លូវការ កម្មវិធី នយោបាយ ចំនួន ពីរ ក្នុង វិស័យ ការងារ ដើម្បី ជា ឧត្តម ប្រយោជន៍ សម្រាប់ កម្មករ និយោជិត នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « គោលដៅ របស់ រាជ រដ្ឋាភិបាល គ្រប់ ជំនាន់ គឺ ថា ធ្វើ ម្ដេច ឲ្យ ប្រជាពលរដ្ឋ ខ្មែរ ពី មួយ ជំនាន់ ទៅ មួយ ជំនាន់ កាន់តែ ល្អ ប្រសើរ កាន់តែ មាន ឱកាស កាន់តែ រឹងមាំ និង កាន់តែ ឈ្លៀសវៃ និង សមត្ថភាព កាន់តែ ខ្ពស់ ដើម្បី ជំរុញ ប្រទេស យើង កាន់តែ លឿន » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា កម្ពុជា រងគ្រោះ ដោយសារ សង្គ្រាម គ្មាន ឱកាស ប៉ុន្ដែ ជំនាន់ បច្ចុប្បន្ន មាន ឱកាស ដែល យើង កសាង មូលដ្ឋាន ប៉ុន្ដែ អ្វី ដែល សំខាន់ គឺ ត្រូវ ជំរុញ ឲ្យ ជំនាន់ កូន ចៅ យើង កាន់តែ រឹងមាំ ដោយ គិតគូរ សុខភាព និង គិតគូរ ពី ចំណេះដឹង សមត្ថភាព និង ឱកាស ដើម្បី អាច រក ការងារ និង ធានា នូវ សមត្ថភាព ។
ទន្ទឹម គ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឲ្យដឹង ថា តាមរយៈ កម្មវិធី សមធម៌ សុខាភិបាល និង ការដាក់ ឲ្យ អនុវត្តន៍ កម្មវិធី របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព នឹង ពង្រីក វិសាលភាព អ្នក ទទួលបាន ការគាំពារ ផ្នែក សុខភាព រហូតដល់ទៅ ប្រមាណ ៩លាន នាក់ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា អ្វី ដែល ជា ក្ដីសង្ឃឹម របស់ បងប្អូន និយោជិត ដែល កំពុង ខិតខំ ធ្វើ ការ ចំពោះ មុខ នេះ គឺ អាច ទ្រទ្រង់ ជីវភាព គ្រួសារ ក៏ ដូចជា ខ្លួន ឯង ក៏ប៉ុន្ដែ ការផ្ដល់ ក្ដីសង្ឃឹម និង អនាគត ភ្លឺស្វាង កូន ចៅ ដែល ជា ក្ដីប្រាថ្នា របស់ បងប្អូន ។
បន្ថែម ពី នោះ ទៀត សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឲ្យដឹង ផងដែរ ថា រាជ រដ្ឋាភិបាល បាន យកចិត្តទុកដាក់ ទៅ លើ សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ តាំងពី មុនពេល កើត រហូតដល់ ពេល កើត ៕
រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ កម្ពុជា - វៀតណាម ឯកភាព ពង្រឹក កិច្ចសហប្រតិបត្តិការ រក្សា សន្តិសុខ សុវត្ថិភាព តាម បណ្តោយ ព្រំដែន ទប់ស្កាត់ ឧក្រិដ្ឋកម្ម ឆ្លង ដែន បទល្មើស ឆ្លង ដែន ខុស ច្បាប់ ទប់ស្កាត់ បទល្មើស គ្រឿងញៀន
នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា នាយ ឧត្តមសេនីយ៍ ទៀ សីហា អម ដោយ ឧត្តមសេនីយ៍ ឯក បំរុង ហ្វុង ស៊ីទីន អនុប្រធាន អគ្គ សេនាធិការ កងទ័ព ប្រជាជន វៀតណាម បាន ដឹកនាំ គណៈប្រតិភូ យោធា ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ កម្ពុជា ទៅ ដាក់ កម្រង ផ្កា គោរព វិញាណក្ខន្ធ នៅ ស្តូប វីរៈ ជន និង បន្ទាប់មក បាន បន្ត ទៅ ដាក់ កម្រង ផ្កា គោរព វិញាណក្ខន្ធ លោក ប្រធាន ហូជីមិញ នៅក្នុង រដ្ឋធានី ហាណូយ ។
ក្នង ជំនួប នោះ នាយ ឧត្តមសេនីយ៍ ផាន វ៉ាន់ ចាង បាន សម្តែង ការស្វគមន៍ ចំពោះ នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ដែល បាន ដឹកនាំ គណះ ប្រតិភូ យោធា ជាន់ ខ្ពស់ ក្រសួង ការជាតិ កម្ពុជា មក បំពេញ ទស្សនកិច្ច ជា មិត្តភាព និង ជា ផ្លូវការ នៅ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
តាង នាម ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ អគ្គ បញ្ជាការដ្ឋាន នៃ កងយោធពល ខេមរភូមិន្ទ នាយ ឧត្តមសេនីយ៍ ទៀ សីហា បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ ចំពោះ ការទទួល ស្វាគមន៍ យ៉ាង កក់ក្តៅ របស់ រដ្ឋមន្រ្តី ក្រសួង ការពារ ប្រទេស វៀតណាម ចំពោះ គណៈប្រតិភូ ក្រសួង ការពារ ជាតិ កម្ពុជា ដែល បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច មិត្តភាព និង ជា ផ្លូវការ នៅ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
នាយ ឧត្តមសេនីយ៍ ទៀ សីហា បាន ចាត់ទុក ដំណើរទស្សនកិច្ច នៅ វៀតណាម លើក នេះ បាន នាំមក នូវ ការរឹត ចំណង មិត្តភាព សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ផូរផង់ ជា យូរ លង់ ណាស់ មកហើយ រវាង កងទ័ព ប្រជាជន និង រដ្ឋាភិបាល នៃ ប្រទេស ទាំង ពីរ កម្ពុជា - វៀតណាម ។
ក្នុង ឱកាស នោះ រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ទាំង ពីរ ជំរាប ជូន គ្នា ទៅ វិញ ទៅមក អំពី សភាពការណ៍ វិវត្តន៍ នៅក្នុង ប្រទេស នីមួយ ៗ ទាំង សភាពការណ៍ ជាតិ អន្តរជាតិ ទាក់ទង ទៅ នឹង សន្តិសុខ ក្នុង តំបន់ និង សាកលលោក ដែល កំពុង កើត មាន ឡើង ក្នុង ពេល បច្ចុប្បន្ន នេះ ។
( ភ្នំពេញ ) ៖ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ មហាសន្និបាត របស់ ខ្លួន ក្រោយ ដំណើរការ អស់ រយៈពេល ៤អាណត្តិ ។ មហាសន្និបាត នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក សន្ដិ បណ្ឌិត ម៉ៅ ច័ន្ទ តារា រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង មហាផ្ទៃ ។
ក្នុង មហាសន្និបាត នៅ ពេល នេះ ក៏ មាន ការរៀបចំ បោះឆ្នោត ជ្រើសរើស ប្រធាន អាណត្តិ ថ្មី ផងដែរ ក្រោយ ប្រធាន អាណត្តិ ចាស់ គឺ លោក សន្ដិ បណ្ឌិត នេត សាវឿន ដែល បច្ចុប្បន្ន ជា ឧប នាយក រដ្ឋមន្ដ្រី បាន សុំ លា លែង ។
សកម្មភាព ទាំងនេះ បាន បង្ហាញ ឲ្យ ឃើញ នូវ ស្មារតី មនុស្សធម៌ ដែល ជា ការរួមចំណែក យ៉ាង ធំ ធេង ក្នុង ការជួយ សម្រួល ដល់ ការលំបាក ខ្វះខាត ក្នុង ជីវភាព របស់ មន្តី នគរបាល ជាតិ ក៏ ដូចជា ក្រុមគ្រួសារ ផងដែរ ។
សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា បាន ប្រារព្ធ ពិធី មហាសន្និបាត លើក ទី១ នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០០២ ក្នុង អាណត្តិ ទី១ ដែល មាន រយៈពេល ០៣ ឆ្នាំ និង បាន បញ្ចប់ អាណត្តិ នៅ ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០០៥ ។
ក្នុង ពេល មហាសន្និបាត អាណត្តិ ទី៣ សមាគម បាន ធ្វើ វិសោធនកម្ម កែសម្រួល លក្ខន្តិកៈ ឲ្យ មាន រយៈពេល ០៥ ឆ្នាំ វិញ ក្នុង អាណត្តិ នីមួយ ៗ ។ នៅ អាណត្តិ ទី៣ និង ទី៤ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា បាន បន្ត សកម្មភាព ការងារ របស់ ខ្លួន ស្រប ទៅ តាម ការកំណត់ នៃ លក្ខន្តិកៈ និង សេចក្តីសម្រេច របស់ គណៈកម្មាធិការ កណ្ដាល សម្រេចបាន លទ្ធផល ល្អ ប្រសើរ ។
គិត ត្រឹម ខែសីហា ឆ្នាំ ២០២៣ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា មាន សមាជិក ចំនួន ៧៨. ០៦៩ នាក់ ក្នុង នោះ មាន សមាជិក សមាគម ជា មន្ត្រី នគរបាល ចំនួន ៦. ១៨៩៧ នាក់ សមាជិក ជា មន្ត្រី នគរបាល ដែល បាន ចូលនិវត្តន៍ ចំនួន ១៦. ១៧០ នាក់ និង មន្ដ្រី នគរបាល ពិការ ដែល ស្ម័គ្រចិត្ត នៅ បន្ត ជា សមាជិកភាព របស់ សមាគម ចំនួន ០២ នាក់ ៕ រយៈពេល ជាង ២ខែ មាន សិស្សានុសិស្ស និង លោកគ្រូ អ្នកគ្រូ ប្រមាណ ២.៦លាន នាក់ បាន ចូលរួម អនុវត្ត « ថ្ងៃ នេះ ខ្ញុំ មិន ប្រើ ថង់ ប្លាស្ទិក ទេ »
ដូចនេះ ប្រជាពលរដ្ឋ ចំនួន ១៥.៦១ % បាន ចូលរួម ដោយ ផ្ទាល់ ក្នុង យុទ្ធនាការ កាត់បន្ថយ ការប្រើប្រាស់ ប្លាស្ទិក ។ ខណៈ តាម ការគណនា នៃ ការចូលរួម ដោយ ប្រយោល ពីសំណាក់ ឪពុក ម្តាយ អាណាព្យាបាល និង សាច់ញាតិ អាច ប៉ាន់ប្រមាណ ថា មាន ប្រជាពលរដ្ឋ ជិត ៥០ ភាគរយ នៃ ចំនួន ពលរដ្ឋ ទូទាំង ប្រទេស បាន ចូលរួម ក្នុង យុទ្ធនាការ កាត់បន្ថយ ការប្រើប្រាស់ ប្លាស្ទិក នេះ ។
ការចូលរួម ដ៏ សកម្ម របស់ កម្ពុជា នា ពេលនេះ មិន ត្រឹមតែ ផ្តល់ ផលប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ របស់ ខ្លួន ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែមទាំង ផ្តល់ នូវ គំរូ សកម្មភាព ដ៏ ល្អ មួយ ដើម្បី ចែករំលែក ជាមួយ ប្រទេស ដទៃ ទៀត នៅ ទូទាំង ពិភពលោក ដោយ បង្ហាញ ពី គំនិត ផ្តួចផ្តើម ដែល អាច កៀរគរ មនុស្ស នៅ តាម សហគមន៍ សាលារៀន និង បុគ្គល នានា ឱ្យ មាន ការបោះជំហាន ទៅ មុខ យ៉ាង សំខាន់ ក្នុង ការកាត់បន្ថយ សំណល់ ប្លាស្ទិក យ៉ាង ទូលំទូលាយ ។
ក្រសួង បរិស្ថាន កម្ពុជា បាន បន្ត ពង្រឹង យុទ្ធនាការ កាត់បន្ថយ ការប្រើប្រាស់ ប្លាស្ទិក ដោយ អនុវត្ត វិធានការ ជាក់ស្តែង តាមរយៈ ដាក់ ឱ្យ ប្រើប្រាស់ ធុង សំរាម ដាច់ដោយឡែក នៅ តាម សាលារៀន និង លើកទឹកចិត្ត សិស្សានុសិស្ស កែច្នៃ ប្លាស្ទិក និង សំណល់ សំរាម ធ្វើជា ជី កំប៉ុស ។ វិធានការ ដ៏ ចំបង នេះ បាន កំពុង ប្រព្រឹត្តទៅ ស្រប តាម គំនិត ផ្តួចផ្តើម ជា សកល របស់ អង្គការ សហ ប្រជាជាតិ ដើម្បី ដោះស្រាយ ការបំពុល ប្លាស្ទិក ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ចាត់ទុក ការប្រកាស ដាក់ ឱ្យ អនុវត្តន៍ កម្មវិធី របប សន្តិសុខ សង្គម និង ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ បច្ចេកទេស នា ព្រឹក ថ្ងៃ នេះ ជា ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ មួយ ទៀត របស់ កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា និយាយ ដល់ មូលធន មនុស្ស គឺ ត្រូវ គិត ដល់ សុខភាព និង សមត្ថភាព ។ ដូច្នេះ កម្មវិធី ដាក់ ឱ្យ អនុវត្តន៍ នៅ ព្រឹក ថ្ងៃ នេះ ជា ការគាំទ្រ ខ្ពស់ ដល់ នយោបាយ មូលធន មនុស្ស ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការដាក់ ឱ្យ អនុវត្តន៍ កម្មវិធី របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព នា ព្រឹក ថ្ងៃ នេះ គឺ ឆ្លើយតប នឹង ការចង់បាន របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា តាមរយៈ កម្មវិធី សមធម៌ សុខាភិបាល និង ការដាក់ ឱ្យ អនុវត្តន៍ កម្មវិធី របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព នឹង ពង្រីក វិសាលភាព អ្នក ទទួលបាន ការគាំពារ ផ្នែក សុខភាព រហូតដល់ទៅ ប្រមាណ ៩លាន នាក់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល បាន យកចិត្តទុកដាក់ ទៅ លើ សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ តាំងពី មុនពេល កើត រហូតដល់ ពេល កើត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល គ្រប់ ជំនាន់ គឺ មាន ការគិតគូរ ខ្ពស់ ចំពោះ ការលើកកម្ពស់ សុខុមាលភាព និង សមត្ថភាព របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ប្រដូច ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ ជា ការបង្រៀន ឱ្យ ពួកគេ ជា ស្ទួច ត្រី ដើម្បី ម្ចាស់ ការលើ ជីវិត ដោយ មាន ជំនាញ ច្បាស់លាស់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ក្រសួង ការងារ និង ក្រសួង ពាក់ព័ន្ធ ប្រឹងប្រែង រួមគ្នា អនុវត្តន៍ កម្មវិធី ទាំង ពីរ នេះ ឱ្យ ទទួលបាន ជោគជ័យ និង មាន ប្រសិទ្ធភាព ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា កម្មវិធី របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាម របប ភាគ ទាន ធ្វើឡើង ដោយ ស្ម័គ្រចិត្ត មិន មាន ការបង្ខិតបង្ខំ នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ឱ្យ ក្រសួង ពាក់ព័ន្ធ ត្រូវ តាមដាន ឱ្យ ជាប់ ជាប្រចាំ លើ កម្មវិធី ជាតិ ដើម្បី ធានា ប្រសិទ្ធភាព នៃ ការអនុវត្តន៍ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ដល់ អាជ្ញាធរ ពាក់ព័ន្ធ ផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ នូវ កម្មវិធី ផ្តល់ ការបណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្វះខាត ជំរុញ កូន ឱ្យ មក ទទួល ការបណ្តុះបណ្តាល ផ្នែក វិជ្ជាជីវៈ និង បច្ចេកទេស ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ត្រូវ តាមដាន ឱ្យ ជាប់ ប្រចាំ លើ ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ និង បច្ចេកទេស ចៀសវាង ការបោះឆ្នោត ការសិក្សា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា យឺត មួយ ថ្ងៃ ក្នុង ការសម្រេចចិត្ត គឺ អាច យឺត ទៅដល់ ១ខែ ទៅ ៣ខែ ដល់ ការអនុវត្ត ។ ដូច្នេះ ត្រូវ ដាក់ ចេញ ភ្លាម អនុវត្ត ភ្លាម តាមរយៈ ការគិតគូរ គ្រប់ ជ្រុងជ្រោយ ។
ប៉ុន្តែ ក្នុង ជំនួប ជាមួយ លោក វីដូដូ អ្វី ដែល ជា ការផ្តោត របស់ លោក ចូ បៃ ដិន គឺ ផែនការធ្វើ បច្ចុប្បន្នភាព កិច្ចសហប្រតិបត្តិការ ជាមួយ ឥណ្ឌូណេស៊ី ដើម្បី ដំឡើង ទំនាក់ទំនង នៃ ប្រទេស ទាំង២ ទៅជា ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់គ្រង ជ្រុងជ្រោយ ។
គួរ បញ្ជាក់ ថា គិត មក ទល់នឹង ពេលនេះ ក្រុម មន្ត្រី សុខាភិបាល ក្នុង តំបន់ ហ្កាហ្សា គ្រប់គ្រង ដោយ ក្រុមហា ម៉ាស បាន បញ្ជាក់ ថា ការវាយប្រហារ សងសឹក របស់ អ៉ី ស្រាអែល បាន សម្លាប់ ជនជាតិ ប៉ាឡេស្ទីន លើស ១១.០០០ នាក់ ហើយ ក្នុង នោះ ភាគ ច្រើន ជា ជន ស៊ីវិល ចាប់តាំងពី ក្រុមហា ម៉ាស វាយប្រហារ លើ ភាគ ខាងត្បូង អ៉ី ស្រាអែល ដោយ សម្លាប់ មនុស្ស ១២០០ នាក់ ភាគ ច្រើន ជា ជន ស៊ីវិល និង ចាប់ខ្លួន មនុស្ស ច្រើន ជាង ២០០ នាក់ ចំណាប់ខ្មាំង ៕
ព្រះករុណា ព្រះមហាក្សត្រ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ជំនួយ គ្រប់ រូបភាព ដែល រដ្ឋាភិបាល បារាំង បាន ផ្តល់ សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម នៅ កម្ពុជា ។ ទាំងនេះ បង្ហាញ ពី ការយកចិត្តទុកដាក់ របស់ បារាំង ចំពោះ ប្រទេស កម្ពុជា ។
ព្រះករុណា ព្រះមហាក្សត្រ ក៏ បាន សំដែង នូវ ក្តី រំពឹង យ៉ាង ខ្លាំង ចំពោះ ( ១) គម្រោង នៃ ការសិក្សា ការជួសជុល និង ការពង្រីក សារ មន្ទីរ ជាតិ ដោយ អ្នកជំនាញ របស់ បារាំង ( ២) កិច្ចសហប្រតិបត្តិការ រវាង សារមន្ទីរ ជាតិ និង សារមន្ទីរ Guimet និង ( ៣) ការជួសជុល រូប ព្រះវិស្ណុ ផ្ទុំ ធ្វើ ពី សំរិទ្ធ រួមទាំង ការតាំង បង្ហាញ វត្ថុ បុរាណ ខ្មែរ នៅ ប្រទេស បារាំង និង សារមន្ទីរ នានា ។
ព្រះករុណា ព្រះមហាក្សត្រ បាន មាន ព្រះបន្ទូល ថា កម្ពុជា ពិតជា មាន មោទនភាព នឹង ដាក់ បេក្ខភាព រៀបចំ កិច្ចប្រជុំ កំពូល ហ្វ្រង់ កូហ្វូនី នៅ ឆ្នាំ ២០២៦ ហើយ ព្រះអង្គ ទ្រង់ មាន ព្រះរាជ តម្រិះ ថា ការគាំទ្រ របស់ បារាំង មាន តម្លៃ យ៉ាង ខ្លាំង ពីព្រោះ កិច្ច គាំទ្រ នេះ នឹង ឆ្លុះបញ្ចាំង ពី ឆន្ទៈ ក្នុង ការពង្រឹង វត្តមាន ដ៏ មាន សារៈសំខាន់ របស់ បារាំង នៅ អាស៊ី ។
នៅ ចុងបញ្ចប់ នៃ ព្រះរាជ សវនាការ លោក Emmanuel MACRON បាន សូម យាង ព្រះករុណា ព្រះមហាក្សត្រ ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល ហ្វ្រង់ កូហ្វូនី លើក ទី១៩ នៅ ទីក្រុង បារី ស នា ថ្ងៃទី ៤- ៥ ខែតុលា ឆ្នាំ ២០២៤ ។ ព្រះករុណា ព្រះមហាក្សត្រ ទ្រង់ បាន សូមអញ្ជើញ លោក ប្រធានាធិបតី នៃ សាធារណរដ្ឋ បារាំង និង លោកជំទាវ ចូលរួម កិច្ចប្រជុំ កំពូល ហ្រ្វង់ កូហ្វូនី លើក ទី២០ នៅ ឆ្នាំ ២០២៦ នៅ កម្ពុជា ។ លោក ប្រធានាធិបតី បាន បញ្ជាក់ នូវ សេចក្តីរីករាយ ក្នុង ការចូលរួម ៕
ព្រឹក ថ្ងៃ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ប្រកាស ដាក់ ឱ្យ អនុវត្តន៍ ជា ផ្លូវការ កម្មវិធី នយោបាយ ចំនួន ពីរ ក្នុង វិស័យ ការងារ ដើម្បី ជា ឧត្តម ប្រយោជន៍ សម្រាប់ កម្មករ និយោជិត
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត គ្រាន់តែ បើក ទំព័រ ការងារ ក្នុង នីតិកាល ថ្មី ភ្លាម បាន ប្រកាស ការងារ បន្ទាន់ ចំនួន ៦ ជូន ទៅ លោក ហេង សួរ រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។ ការងារ ទាំង៦ នោះ ត្រូវបាន លោក រដ្ឋមន្ត្រី សម្រេច ជា ផ្លែ ផ្កា ជា បន្តបន្ទាប់ ។
ការដាក់ ឱ្យ អនុវត្តន៍ ជា ផ្លូវការ នូវ « របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាម របប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ បុគ្គល និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម » និង « កម្មវិធី បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រងគ្រោះ » គឺជា ការសម្រេចបាន កិច្ចការ ចំនួន ពីរ ទៀត ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ដាក់ ជូន លោក ហេង សួរ ។
ការពង្រីក វិសាលភាព របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព ដល់ បុគ្គល ស្វ័យ និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម តាម គោលការណ៍ ស្ម័គ្រចិត្ត នា ពេលនេះ គឺជា ប្រវត្តិសាស្ត្រ ថ្មី មួយ បន្ថែម សម្រាប់ កម្ពុជា ដែល បាន ប្រែក្លាយ សេចក្តីប្រាថ្នា របស់ បុគ្គល ស្វ័យ និយោជន៍ ភាគ ច្រើន ដែល ចង់ ចូល ជា សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម ក៏ ដូចជា ក្តី ប្រាថ្នា របស់ កម្មករ និយោជិត ភាគ ច្រើន ដែល ចង់ឱ្យ អ្នក នៅក្នុង បន្ទុក របស់ ខ្លួន អាច ទទួលបាន ការធានារ៉ាប់រង សុខភាព ដូច ខ្លួន ដែរ ។
តាមរយៈ កម្មវិធី នេះ បុគ្គល ស្វ័យ និយោជន៍ និង អ្នក ក្នុង បន្ទុក សមាជិក បេឡា ជាតិ របប សន្តិសុខ សង្គម រួម មាន ប្តី ឬ ប្រពន្ធ និង កូន ក្នុង បន្ទុក អាច ទទួលបាន របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព ដោយ គ្រាន់តែ បង់ ភាគ ទាន ត្រឹមតែ ២.៦ភាគរយ នៃ ប្រាក់ ចំណូល ជាប់ ភាគ ទាន ៦០ ម៉ឺន រៀល ដែល ស្មើនឹង ១៥.៦០០ រៀល ហើយ អាច ទទួលបាន សេវា ព្យាបាល និង ថែទាំ វេជ្ជសាស្ត្រ ដែល មាន ជម្រើស ទៅ ព្យាបាល គ្រប់ មន្ទីរ ពេទ្យ នានា ដែល ជា ដៃគូ បេឡា ជាតិ របប សន្តិសុខ សង្គម បន្ថែម ពីលើ មន្ទីរពេទ្យ រដ្ឋ ។
សិស្ស ដែល បាន ចុះឈ្មោះ ចូលរៀន នឹង ទទួលបាន ការសិក្សា ដោយ មិន បង់ ថ្លៃ . ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ប្រចាំ ខែ ចំនួន ២៨ ម៉ឺន រៀល . ទទួលបាន ការប្រឹក្សា យោបល់ ពី ការជ្រើសរើស ជំនាញ និង ព័ត៌មាន ទីផ្សារ ការងារ . ចុះ កម្មសិក្សា នៅ តាម សហគ្រាស គ្រឹះស្ថាន ឧស្សាហកម្ម និង ក្រុមហ៊ុន ឯកជន . ជំនាញ មួយ ពិតប្រាកដ ដែល ទីផ្សារ ការងារ កំពុង ត្រូវការ និង ឱកាស ការងារ ធ្វើ សមរម្យ និង ប្រាក់ ចំណូល ទៀងទាត់ ។
ដោយឡែក ការបណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ដូនតា ត្រូវបាន រៀបចំ និង អនុវត្ត ដោយ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក្នុង គោលបំណង អភិរក្ស ចំណេះដឹង និង ជំនាញ ដូនតា ឱ្យ បាន គង់វង្ស និង អភិវឌ្ឍ « ឧស្សាហកម្ម វប្បធម៌ និង ច្នៃប្រតិដ្ឋ បង្កើត ថ្មី » ។
តាមរយៈ កម្មវិធី នយោបាយ ទាំង ពីរ ខាងលើ នេះ បាន ស្តែង ឱ្យ ឃើញ កាន់តែ ច្បាស់ នូវ ស្មារតី របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នីតិកាល ទី ៧ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក្នុង ការលើកកម្ពស់ សុខុមាលភាព និង ជីវភាព របស់ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ប្រសើរ ស្រប តាម គោលដៅ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១៕ គណៈកម្មការ អន្តរ ក្រសួង ចុះ ពិនិត្យ វាយតម្លៃ ប្រគល់ - ទទួល ការងារ ជួសជុល លក្ខណៈ ខួប ផ្លូវ ក្រាល ក្រួស ក្រហម ២ខ្សែ នៅ ខេត្ត ឧត្តរមានជ័យ
( ឧត្តរមានជ័យ )៖ លោក បណ្ឌិត នួន ដាញ៉ិល រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ តំណាង លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ រួម ជាមួយ គណៈប្រតិភូ អន្តរ ក្រសួង មាន ក្រសួង អភិវឌ្ឍន៍ ជនបទ និង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នា រសៀល ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន ចុះ ត្រួតពិនិត្យ និង វាយតម្លៃ ប្រគល់ - ទទួល ១០០% លើ ការងារ ជួល ជុល ផ្លូវ ក្រាល ក្រួស ក្រហម លក្ខណះ ខួប ចំនួន ២ខ្សែ នៅក្នុង ខេត្ត ឧត្តរមានជ័យ ។
ផ្លូវ ក្រាល ក្រួស ក្រហម ទាំង ២ខ្សែ ខាងលើ នេះ គឺ ការងារ ជួសជុល ផ្លូវ ជា គម្រោង ឆ្នាំ ២០២៣ អនុវត្ត ដោយ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ឧត្តរមានជ័យ ដោយ ប្រើប្រាស់ ថវិកា ជំពូក ៦១ ។ បន្ទាប់ពី បាន ធ្វើ ការពិនិត្យ ជាក់ស្តែង និង យោង តាម ស្មារតី អង្គប្រជុំ រួច មក គណៈកម្មការ អន្តរ ក្រសួង បាន សម្រេច ឯកភាព ទទួលយក លទ្ធផល ការងារ ខាងលើ ១០០ % ។
លោក បណ្ឌិត នួន ដាញ៉ិល បាន ថ្លែង ថា ក្រោម ការដឹកនាំ របស់ លោក ឆាយ រិទ្ធិ សែន លោក បាន ណែនាំ ដល់ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត រាជធានី ត្រូវបាន យកចិត្តទុកដាក់ ធ្វើ ការជួសជុល ថែទាំ ឡើងវិញ ផ្លូវ ដែល គ្រប់គ្រង ដោយ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ជាពិសេស ផ្លូវ ដែល រង ការខូចខាត ដោយ ទឹក ជំនន់ ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ និង ការដឹកជញ្ជូន កសិផល ទៅកាន់ ទីផ្សារ របស់ ប្រជាពលរដ្ឋ មាន ភាពងាយស្រួល ៕
វេទិកា ចែករំលែក វីដេអូ ដ៏ ពេញនិយម ដែល មាន អ្នកប្រើប្រាស់ ប្រហែល ១ពាន់ លាន នាក់ ប្រចាំ ខែ បាន ប្រឈមមុខ នឹង ការរឹតបន្តឹង នៅក្នុង ប្រទេស មួយចំនួន សម្រាប់ ការរំលោភ លើ មូលដ្ឋាន ទិន្នន័យ និង ផល ប៉ះពាល់ ដែល អាច បង្ក គ្រោះថ្នាក់ ដល់ មនុស្ស វ័យ ក្មេង ។
ការសម្រេចចិត្ត នេះ ទៀតសោត កើតឡើង តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី ប្រទេស នេប៉ាល់ បាន ចេញ សេចក្តីណែនាំ មួយ ដែល តម្រូវ ឱ្យ វេទិកា ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ដែល កំពុង ប្រតិបត្តិការ នៅក្នុង ប្រទេស នេះ បង្កើត ការិយាល័យ របស់ ខ្លួន ។
លោក បាន អំពាវនាវ ឱ្យ អង្គការ សហ ប្រជាជាតិ និង សហភាព អឺរ៉ុប ទម្លាក់ ជំនួយ តាម ផ្លូវ អាកាស ទៅកាន់ តំបន់ ហ្គាហ្សា ដែល ហែក ហួរ ដោយ សង្រ្គាម ជាពិសេស តំបន់ ភាគ ខាងជើង របស់ ខ្លួន និង ទាមទារ ឱ្យ បើក ច្រក របៀង ផ្តល់ ជំនួយ បន្ថែម ទៀត ទៅកាន់ តំបន់ ហ្គាហ្សា បន្ថែម ពីលើ ផ្លូវ ឆ្លងកាត់ Rafah ។
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន ចេញ អនុក្រឹត្យ ស្តីពី ការអនុវត្ត កម្មវិធី ជាតិ ជំនួយ សង្គម ផ្នែក បណ្ដុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស សម្រាប់ យុវជន មក ពី គ្រួសារ ក្រីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ ។
អនុក្រឹត្យ នេះ មាន គោលបំណង កំណត់ អំពី វិធាន នីតិវិធី និង យន្តការគ្រប់គ្រង ការអនុវត្ត កម្មវិធី ជាតិ ជំនួយ សង្គម ផ្នែក បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស សម្រាប់ យុវជន មក ពី គ្រួសារ ក្រីក និង គ្រួសារ ងាយ រង ហានិភ័យ ដើម្បី ផ្ដល់ ឱកាស ស្មើគ្នា ជូន យុវជន ក្នុង ការទទួលបាន ការអភិវឌ្ឍ ជំនាញ និង ឱកាស ការងារ កាន់តែ ល្អ ប្រសើរ ក្នុង ការបង្កើន ប្រាក់ ចំណូល និង ជីវភាព រស់ នៅ ។
ខាងក្រោម នេះ ជា អនុក្រឹត្យ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា៖ ព្រឹក ស្អែក សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ប្រកាស ដាក់ ឱ្យ អនុវត្តន៍ ជា ផ្លូវការ កម្មវិធី នយោបាយ ចំនួន ពីរ ក្នុង វិស័យ ការងារ ដើម្បី ជា ឧត្តម ប្រយោជន៍ សម្រាប់ កម្មករ និយោជិត
តាមរយៈ កម្មវិធី នយោបាយ ទាំង ពីរ ខាងលើ នេះ បាន ស្តែង ឱ្យ ឃើញ កាន់តែ ច្បាស់ នូវ ស្មារតី របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នីតិកាល ទី ៧ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក្នុង ការលើកកម្ពស់ សុខុមាលភាព និង ជីវភាព របស់ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ប្រសើរ ស្រប តាម គោលដៅ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ ៕
ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បន្ត បើក វគ្គ បណ្ដុះបណ្ដាល ជូន ជំនួយការហិរញ្ញវត្ថុ ដ្ឋបាល ឃុំ សង្កាត់ នៅ ខេត្ត ពោធិ៍សាត់ ខេត្ត ប៉ៃលិន និង ខេត្ត កំពង់ឆ្នាំង
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ សណ្ឋាគារ ស្ទឹង សង្កែ ខេត្ត បាត់ដំបង . ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន បន្ត បើក វគ្គ បណ្ដុះបណ្ដាល ស្តីពី « ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ នៅ រដ្ឋបាល ឃុំ សង្កាត់ » ជូន ជំនួយការហិរញ្ញវត្ថុ រដ្ឋបាល ឃុំ សង្កាត់ នៃ ខេត្ត ពោធិ៍សាត់ ខេត្ត ប៉ៃលិន និង ខេត្ត កំពង់ឆ្នាំង ចំនួន ១២៨ នាក់ ដើម្បី ពង្រឹង ពង្រីក សមត្ថភាព និង លើកកម្ពស់ ចំណេះដឹង ពាក់ព័ន្ធ នឹង ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ។
លោក បណ្ឌិត អនុ រដ្ឋលេខាធិការ បាន ជម្រាប ជូន អង្គ ពិធី ថា ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដោយ មាន វិទ្យាស្ថាន សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ជា សេនាធិការ លើ មុខងារ បណ្តុះបណ្ដាល និង វិក្រឹត ការ តែង បាន យកចិត្តទុកដាក់ ខ្ពស់ លើ ការកសាង និង ការអភិវឌ្ឍ សមត្ថភាព ជូន ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ទាំង នៅ ថ្នាក់ ជាតិ និង ថ្នាក់ មូលដ្ឋាន ពាក់ព័ន្ធ នឹង ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ សំដៅ ចូលរួមចំណែក ដល់ ការអនុវត្ត ការកែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ឱ្យ សម្រេចបាន ជោគជ័យ ។
( ភ្នំពេញ ) ៖ ថ្លែង នៅក្នុង កម្មវិធី Fresh Talk លោក បណ្ឌិត សភាចារ្យ រស់ ចន្រ្តា បុត្រ ដែល ជា អ្នកជំនាញ វិទ្យាសាស្រ្ត នយោបាយ និង ជា ទីប្រឹក្សា ផ្ទាល់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា៖ « សង្រ្គាម រវាង អ៉ី ស្រាអែល និង ប៉ាឡេស្ទីន មិន មែន ជា សង្រ្គាម ដែល ញោះ ដោយ ប្រទេស មហា អំណាច ដើម្បី លក់ អាវុធ ដូច សង្រ្គាម នៅ ទីតាំង ផ្សេង នោះ ទេ ។ ប៉ុន្តែ សង្រ្គាម នេះ កើតឡើង ព្រោះតែ ការចង់ រក្សា ឥទ្ធិពល របស់ សហរដ្ឋ អាមេរិក និង អ៉ី ស្រាអែល នៅក្នុង តំបន់ មជ្ឈឹម បូព៌ា » ។
បើ តាម ការបញ្ជាក់ ពី លោក បណ្ឌិត សភាចារ្យ គឺ គន្លឹះ នៃ ការដោះស្រាយ សង្រ្គាម នេះ គឺ នៅលើ អាមេរិក បើ អាមេរិក ឲ្យ អ៉ី ស្រាអែល បញ្ចប់ ជម្លោះ នេះ នឹង ត្រូវ ចប់ ។ តែ បើ មិន ព្រម បញ្ចប់ ហើយ មិន ទទួលស្គាល់ ប៉ាឡេ ស្ទីន ជា រដ្ឋ ឯករាជ្យ មួយ នោះ ទេ នោះ សង្រ្គាម រវាង អ៉ី ស្រាអែល និង ប៉ាឡេស្ទីន ក៏ នឹង បន្ត រហូត គ្មាន ថ្ងៃ បញ្ចប់ ឡើយ ។
ជា បន្ត សូម ទស្សនិកជន ទស្សនា ខ្លឹមសារ ដើម នៃ ការលើកឡើង របស់ លោក បណ្ឌិត សភាចារ្យ រស់ ចន្ត្រា បុត្រ ដូចតទៅ៖ បណ្ឌិត សភាចារ្យ រស់ ចន្រ្តា បុត្រ៖ បើសិនជា សង្រ្គាម របស់ អ៉ី ស្រាអែល នៅ តំបន់ ហ្គាហ្សា បន្ត អូសបន្លាយ នោះ នឹង មាន ហានិភ័យ ជាច្រើន លើ ជនជាតិ ជ្វីស ទូទាំង ពិភពលោក (Video inside)
( ភ្នំពេញ ) ៖ បណ្ឌិត សភាចារ្យ រស់ ចន្រ្តា បុត្រ សាស្រ្តាចារ្យ វិទ្យាសាស្រ្ត នយោបាយ និង ជា ទីប្រឹក្សា ផ្ទាល់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា៖ « បើសិនជា សង្រ្គាម របស់ អ៉ី ស្រាអែល នៅ តំបន់ ហ្គាហ្សា អូសបន្លាយ នោះ នឹង មាន ហានិភ័យ ជាច្រើន លើ ជនជាតិ ជ្វីស ទូទាំង ពិភពលោក ហើយ ទីណា ដែល មាន ជនជាតិ ជ្វីស រស់ នៅ ទីនោះ នឹង អាច មិន មាន សេចក្ដីសុខ ឡើយ » ។
មិន មាន សេចក្ដីសុខ ព្រោះថា នឹង មាន ការសងសឹក ទៅ វិញ ទៅ មក លើ ជនជាតិ ជ្វីស ដែល នេះ នឹង បង្ក ជា ជំងឺ ប្រវត្តិសាស្រ្ត ដែល ពិបាក ព្យាបាល ហើយ អ្វី ដែល គេ ធ្លាប់ តែ ស្រលាញ់ អាណិត ជនជាតិ ជ្វីស កន្លងមក អាចនឹង ត្រូវ រលាយ បាត់បង់ អស់ ផងដែរ ព្រោះ ទង្វើ ដែល អ៉ី ស្រាអែល កំពុង ធ្វើ នៅ ហ្គាហ្សា ពិភពលោក ភាគ ច្រើន គឺ មិន គាំទ្រ នោះ ឡើយ ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក បណ្ឌិត សភាចារ្យ រស់ ចន្រ្តា បុត្រ នៅក្នុង កម្មវិធី Fresh Talk នា ចុង សប្ដាហ៍ មុន ។
ជា បន្ត សូម ទស្សនិកជន ទស្សនា ខ្លឹមសារ ដើម នៃ ការលើកឡើង របស់ លោក បណ្ឌិត សភាចារ្យ រស់ ចន្ត្រា បុត្រ ដូចតទៅ៖ អភិបាល រាជធានី ភ្នំពេញ ចេញ សេចក្ដីណែនាំ មិន ឲ្យ ប្រមូល ភាស៉ី និង ការបង់ ថ្លៃ ផ្សេង ៗ ពី អ្នកលក់ដូរ តាម កញ្ច្រែង កញ្ជើ ល្អី និង ការលក់ដូរ ចល័ត គ្រប់ ប្រភេទ
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០២៣ បាន ចេញ សេចក្ដីណែនាំ មួយ ការ មិន ប្រមូល ចំណូល ភាស៉ី និង ការបង់ ថ្លៃ ផ្សេង ៗ ចំពោះ ការលក់ដូរ តាម កញ្ច្រែង កញ្ជើ ល្អី និង ការលក់ដូរ ចល័ត គ្រប់ ប្រភេទ នៅក្នុង រាជធានី ភ្នំពេញ ។
កន្លងមក រាជ រដ្ឋាភិបាល អាណត្តិ ទី៦ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ សារាចរ លេខ ១១ សរ ចុះ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០១៦ ដោយ សម្រេច លុប ការបង់ ភាស៊ី និង ការបង់ ថ្លៃ ផ្សេង ៗ ទៀត ចំពោះ ប្រជាពលរដ្ឋ លក់ដូរ តាម កញ្ច្រែង កញ្ជើ ល្អី នៅ ទីកន្លែង លក់ដូរ និង ទីផ្សារ ទូទាំង ប្រទេស ។ ជាមួយគ្នា នេះ កាលពី ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០២៣ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដាក់ បទបញ្ជា ឲ្យ អនុវត្ត នូវ សារាចរ ណែនាំ ខាងលើ ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត ។
ដោយ ទទួលបាន ការយកចិត្តទុកដាក់ ខ្ពស់ ជា ប្រចាំ ដល់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ដើម្បី ពង្រឹង និង ចៀសវាង ជន ខិលខូច មួយចំនួន ឆ្លៀត ឱកាស ដើរ ប្រមូល ថវិកា ក្រោម រូបភាព ប្រមូល ភាស៊ី ពី អ្នកលក់ដូរ តាម កញ្ច្រែង កញ្ជើ ល្អី និង ការលក់ដូរ ចល័ត ពី អាជីវករ នៅ រាជធានី ភ្នំពេញ រដ្ឋបាល រាជធានី ភ្នំពេញ សូម ធ្វើ ការណែនាំ ដល់ រដ្ឋបាល ខណ្ឌ រដ្ឋបាល សង្កាត់ គណៈកម្មការ ផ្សារ ក្រុមហ៊ុន វិនិយោគ ធ្វើ អាជីវកម្មភាស៊ី និង អាជីវកម្ម ប្រមូល ចំណូល អនាម័យ ព្រមទាំង ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដូច ការងារ សំខាន់ ៗ ចំនួន ៤ចំណុច ។
ខាងក្រោម នេះ ជា សេចក្ដីណែនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ៖
គណៈកម្មាធិការ ជាតិ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស កំពុង បង្កើត ផែនការ យុទ្ធសាស្ត្រ ថ្នាក់ ជាតិ ៥ ឆ្នាំ ប្រយុទ្ធ ប្រឆាំង នឹង អំពើ ជួញដូរ មនុស្ស
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន បើក សិក្ខាសាលា ថ្នាក់ ជាតិ ស្តីពី ការវាយតម្លៃ ការអនុវត្ត ផែនការ យុទ្ធសាស្ត្រ ជាតិ ៥ ឆ្នាំ ( ២០១៩ - ២០២៣ ) និង ការបង្កើត ផែនការ យុទ្ធសាស្ត្រ ថ្នាក់ ជាតិ ៥ ឆ្នាំ ( ២០២៤ - ២០២៨ ) ប្រយុទ្ធ ប្រឆាំង នឹង អំពើ ជួញដូរ មនុស្ស ។
បើ តាម លោកស្រី ជូ ប៊ុន អេង បាន បង្ហាញ នូវ ក្ដៅ រំពឹង ថា ធាតុ ចូល ថ្មី ៗ ដែល នឹង ដាក់ ចូល ក្នុង ផែនការ យុទ្ធសាស្ត្រ រយៈពេល ៥ ឆ្នាំ ទៅ មុខ ទៀត នោះ នឹង ជួយ បង្កើន ប្រសិទ្ធភាព នៃ ការទប់ស្កាត់ និង បង្រ្កាប អំពើ ជួញដូរ មនុស្ស នៅ កម្ពុជា ជាពិសេស បទល្មើស កើតឡើង ក្នុង ទម្រង់ ថ្មី ៗ ។
ជាមួយ នេះ លោកស្រី ក៏ បាន អំពាវនាវ ផងដែរ ដល់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន ស្រាវជ្រាវ ឬ រកឃើញ ករណី អ្វី មួយ ពាក់ព័ន្ធ បញ្ហា អំពើ ជួញដូរ មនុស្ស ហើយ បាន ចង់ ក្រង ជា ឯកសារ ឬ ធ្វើជា របាយការណ៍ សូម ផ្ញើ ទៅកាន់ គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស ដើម្បី ធ្វើ ការផ្ទៀងផ្ទាត់ និង ដោះស្រាយ រួមគ្នា ចៀស ជាង យក ទៅ ផ្សព្វផ្សាយ ធ្វើឲ្យ ប៉ះពាល់ ដល់ កំណើន នៃ ភ្ញៀវ ទេសចរ បរទេស ក៏ ដូចជា អ្នក វិនិយោគ ពី ក្រៅ ប្រទេស ជាដើម ។
ការណែនាំ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតី នៃ វេទិកា « រាជ រដ្ឋាភិបាល - ផ្នែក ឯក ជន » លើក ទី១៩ ដើម្បី បើក ការជជែក លើ ការធ្វើ ធុរកិច្ច នៅ កម្ពុជា ។ ជំនួប នេះ ធ្វើឡើង នា វិមាន សន្ដិភាព នា ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ដើម្បី រួមចំណែក ជំរុញ សេដ្ឋកិច្ច ជាតិ រាជ រដ្ឋាភិបាល បាន ណែនាំឲ្យ អគ្គិសនី កម្ពុជា ពិនិត្យ លទ្ធភាព ផ្ដល់ ថ្លៃ អនុគ្រោះ ជូន អតិថិជន ឧស្សាហកម្ម និង កសិកម្ម ចំពោះ បរិមាណ ថាមពល បើ លើស ជា ការលើកទឹកចិត្ត ដល់ អ្នក វិនិយោគ ឲ្យ បង្កើន ការផលិត និង បង្កើន ការងារ បន្ថែម » ។
ជាមួយគ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា កន្លងមក រាជ រដ្ឋាភិបាល ទទួលបាន ការស្នើសុំ បញ្ចុះ ថ្លៃ អគ្គិសនី និង ការអនុញ្ញាតឲ្យ ប្រើប្រាស់ ថាមពល ពន្លឺ ព្រះអាទិត្យ លើ ដំបូល ។ ជុំវិញ ការបញ្ចុះ ថ្លៃ អគ្គិសនី . ជា គោលការណ៍ រាជ រដ្ឋាភិបាល តែង ខិតខំ បញ្ចុះ ថ្លៃ អគ្គិសនី ឲ្យ អស់ លទ្ធភាព ដើម្បី កាត់បន្ថយ ថ្លៃ ដើម ផលិតកម្ម ព្រមទាំង សម្រួល ដល់ ជីវភាព រស់ នៅ របស់ ប្រជាជន ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ទៀត ថា ទោះជា យ៉ាង នេះ ក្តី . លទ្ធភាព នៃ ការបញ្ចុះ ថ្លៃ អគ្គិសនី អាស្រ័យ ទៅតាម ស្ថានភាព និរន្តភាព នៃ អាជីវកម្ម និង ស្ថិរភាព នៃ ការផ្គត់ផ្គង់ ដែល ត្រូវ មាន ការ សិក្សា ឲ្យបាន ច្បាស់លាស់ និង គ្រប់ ជ្រុងជ្រោយ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ក្នុង ស្ថានភាព ដ៏ លំបាក ដោយសារ វិបត្តិ ជំងឺ កូវីដ - ១៩ និង នយោបាយ សកលលោក ដែល បាន ធ្វើឲ្យ កើតមាន វិបត្តិ ថាមពល និង ការឡើង ថ្លៃ នៃ ប្រេងឥន្ធនៈ . ប្រទេស ជាច្រើន រួមទាំង ប្រទេស ជិតខាង របស់ កម្ពុជា . បាន ដំឡើង ថ្លៃ អគ្គិសនី ជា បន្តបន្ទាប់ ដើម្បី ទប់ នឹង ការខាតបង់ អាជីវកម្ម ។
បន្ថែម ពី នោះ ទៀត សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា សម្រាប់ កម្ពុជា . រាជ រដ្ឋាភិបាល បាន និង កំពុង ខិតខំ រក្សា ថ្លៃ អគ្គិសនី មិន ឲ្យ ឡើង សំដៅ ជួយ សម្រួល ដល់ អ្នកប្រើប្រាស់ អគ្គិសនី និង អ្នក វិនិយោគ ទាំងអស់ ៕ សាលា អនុគណក្រុង សៀមរាប សម្រេច បិទ វត្ត ពោធិលង្កា ជា បណ្តោះអាសន្ន និង បញ្ចប់ តួនាទី ចៅអធិការ គ្រូសូត្រ ឆ្វេង និង គ្រូសូត្រ ស្តាំ បន្ទាប់ពី កើត អធិករណ៍ មិន ចេះ ចប់ មិន ចេះ ហើយ
( សៀមរាប ) ៖ សាលា អនុគណក្រុង សៀមរាប នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន សម្រេច បិទ វត្ត ពោធិលង្កា ស្ថិត នៅក្នុង ភូមិ ស្ល ក្រាម សង្កាត់ ស្ល ក្រាម ក្រុង សៀមរាប ខេត្ត សៀមរាប បន្ទាប់ពី ព្រះសង្ឃ នៅក្នុង វត្ត បាន បង្កើត អធិករណ៍ មិន ចេះ ចប់ មិន ចេះ ហើយ ដែល មាន ភាពរាំ រ៉ៃ យូ ឆ្នាំ មកហើយ ។ ក្នុង ករណី ការរំសាយ ព្រះសង្ឃ ចេញ ពី វត្ត ពោធិលង្កា នេះ ដោយ ព្រះសង្ឃ មួយចំនួន មិន បាន គោរព ប្រតិបត្តិ តាម ធម៌ វិន័យ ព្រះពុទ្ធ សាសនា និង ព្រមទាំង ចែក បក្ខ ចែក ពួក ជា ៤ក្រុម នៅក្នុង វត្ត ពោធិលង្កា នេះ ។
ព្រះបវរវិជ្ជា ទេព ភឿន ព្រះវិន័យ ធម៌ ខេត្ត និង ជា អ្នកនាំពាក្យ សាលា គណ ខេត្ត សៀមរាប បាន មាន ថេរ ដីការ ថា ការសម្រេច បិទ វត្ត ពោធិលង្កា ជា បណ្តោះអាសន្ន នា ពេលនេះ ធ្វើឡើង តាម ខ្លឹមសារ នៃ សេចក្តីសម្រេច របស់ គណៈ សង្ឃ នាយក នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន បញ្ចប់ មុខ តំណែង របស់ គណៈ គ្រប់គ្រង វត្ត ពោធិលង្កា នេះ បន្ទាប់ពី កើត មាន ភាព មិន ប្រក្រតី ក្នុង ការគ្រប់គ្រង វត្ត ។ ព្រះអង្គ បន្ត ថា បន្ទាប់ពី ការសម្រេច នេះ គណៈ សង្ឃ ខេត្ត ក្រុង និង ធ្វើ ការរៀបចំ សណ្តាប់ធ្នាប់ វត្ត នេះ ឡើងវិញ ។
យោង តាម សេចក្តីសម្រេច របស់ គណៈ សង្ឃ នាយក លេខ ១០៧ ចុះ ថ្ងៃទី ២៧ ខែកញ្ញា ឆ្នាំ ២០២៣ បាន សម្រេច បញ្ចប់ មុខតំណែង គណៈ សង្ឃ វត្ត ពោធិលង្កា នេះ រួម មាន៖
* ទី១៖ បញ្ចប់ មុខតំណែង ភិក្ខុ កែវ ខូយ ពី ចៅអធិការ * ទី២៖ បញ្ចប់ មុខតំណែង ភិក្ខុ ពេជ្រ ដេវីឌ ពី គ្រូសូត្រ ស្ដាំ * ទី៣៖ បញ្ចប់ មុខតំណែង ភិក្ខុ ស៊ីញ ស៊ីន ពី គ្រូសូត្រ ឆ្វេង * ទី៤៖ បញ្ចប់ មុខតំណែង ភិក្ខុ សេង សុខុម ពី វិន័យ ធរ ។
ដោយឡែក យោង តាម សេចក្តីជូនដំណឹង ចុះ ថ្ងៃទី ១៣ ខែវិច្ឆិកា នេះ របស់ សាលា អនុគណក្រុង សៀមរាប បាន ឲ្យដឹង ថា សាលា អនុគណក្រុង សៀមរាប សូម ពិត ប្រគេន ភិក្ខុ សាមណេរ លោក តា លោកយាយ ឧបាសក ឧបាសិកា ប្អូន ៗ សិស្ស និស្សិត និង អ្នក ដែល កំពុង ស្នាក់ នៅក្នុង វត្ត ពោធិលង្កា ទាំងអស់ ឲ្យបាន ជ្រាប ថា សាលា អនុគណក្រុង សូម ធ្វើ ការប្រកាស រំសាយ ភិក្ខុ សាម ណេរ ទាំងអស់ នៅក្នុង វត្ត ពោធិលង្កា ឲ្យ និមន្ត ទៅ គង់ តាម បណ្តា វត្ត ក្នុង ក្រុង សៀមរាប ។
សាលា អនុគណក្រុង មិន អនុញ្ញាតឲ្យ បុគ្គល ណាមួយ បន្ត ស្នាក់ នៅក្នុង វត្ត ពោធិលង្កា ទៀត ឡើយ បើ បុគ្គល ណាមួយ មិន ព្រម ចាកចេញ ទៅ តាម ការជូនដំណឹង នេះ សាលា អនុគណក្រុង និង សហការ ជាមួយ កម្លាំង មាន សមត្ថកិច្ច អនុវត្ត តាម ផ្លូវ ច្បាប់ ដោយ មិន ទទួលខុសត្រូវ លើ ការបាត់បង់ ឬ ខូចខាត ទ្រព្យសម្បត្តិ ណាមួយ ឡើយ ។
ពាក់ព័ន្ធ ឈានដល់ ការបិទ វត្ត ពោធិលង្កា នេះ ត្រូវបាន ប្រជាពលរដ្ឋ ចំណុះ ជើង វត្ត សម្តែង នូវ ការសាទរ យ៉ាង ខ្លាំង ពីព្រោះ ព្រះសង្ឃ នៅក្នុង វត្ត នេះ បាន បង្កើត បក្ខពួក និង តែងតែ បង្ក ជម្លោះ នៅក្នុង វត្ត ជា ហូរហែរ និង ជា យូរ ឆ្នាំ ណាស់ មកហើយ ។ ប្រជាពលរដ្ឋ រំពឹង ថា ចំណាក់ការ របស់ គណៈ សង្ឃ នាយក និង គណៈ សង្ឃ ខេត្ត នេះ និង ប្រែក្លាយ ទី អារាម មួយ នេះ ឲ្យ ក្លាយជា ទីកន្លែង គោរព សក្ការៈ របស់ ពុទ្ធ បរិស័ទ ឡើងវិញ ៕
អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន លើក ទី១៩ ក្រោម អធិបតីភាព សម្តេច ធិបតី ហ៊ុន ម៉ាណែត
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន លើក ទី១៩ ដែល ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ វិមាន សន្តិភាព ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ បែប នេះ បាន ធ្វើឡើង នៅក្នុង ឱកាស អញ្ជើញ ជួប វិស័យ ឯកជន និង ប្រកាស ដាក់ ចេញ កិច្ចអន្តរាគមន៍ នានា ដើម្បី លើកកម្ពស់ ការធ្វើ ធុរកិច្ច នៅ កម្ពុជា នៅ វិមាន សន្តិភាព នា ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឱ្យដឹង ថា វិស័យ ឯកជន បាន ស្នើ ឱ្យ មាន ការពង្រឹង ការគ្រប់គ្រង លើ ការនាំចូល សាច់ ជ្រូក បង្កក មាន់ ស៊ុត និង ត្រី ខុស ច្បាប់ ដែល មាន តម្លៃ ថោក និង គុណភាព ទាប ដែល ធ្វើឱ្យ អ្នក ចិញ្ចឹម ក្នុង ស្រុក មិន អាច ប្រកួតប្រជែង បាន ដោយ ស្មើភាព ព្រមទាំង ប៉ះពាល់ ដល់ សុខភាព របស់ ប្រជាពលរដ្ឋ ។
ជា ការឆ្លើយតប សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន ជំរុញ ដល់ មន្ត្រី ពាក់ព័ន្ធ យ៉ាង ដូច្នេះ ថា៖ « ក្នុង ន័យ នេះ ដើម្បី លើកកម្ពស់ ការប្រកួតប្រជែង ដោយ ស្មើភាព និង ការពារ សុខភាព របស់ ប្រជាពលរដ្ឋ រាជ រដ្ឋាភិបាល សម្រេច ដាក់ចេញ នូវ វិធានការ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ ពង្រឹង ឱ្យ បាន ម៉ត់ចត់ ការ ហាម នាំចូល ម្ហូប ឬ ចំណីអាហារ ណា ដែល ខូច គុណភាព ឬ គុណភាព ទាប ដែល ប៉ះពាល់ ដល់ សុខភាព មិន ថា ឡើយ តែ សាច់ ជ្រូក បង្កក មាន់ ស៊ុត និង ត្រូវ ខុស ច្បាប់ មក ព្រះរាជាណាចក្រ កម្ពុជា » ។
បន្ថែម ពី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ត ថា ត្រូវ កំណត់ ទ្វារ ព្រំដែន ដែល អនុញ្ញាតឱ្យ មាន ការនាំចូល សាច់ ជ្រូក បង្កក មាន់ ស៊ុត និង ត្រី ដើម្បី បង្ក ភាពងាយស្រួល នៅក្នុង ការគ្រប់គ្រង និង ត្រួតពិនិត្យ លើ ការនាំចូល ខុស ច្បាប់ ក្នុង រូបភាព ផ្សេង ៗ ។
កាលពី សប្តាហ៍ មុន លោកស្រី Braverman បាន ចេញ អត្ថបទ មួយ តាមរយៈ ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក អង់គ្លេស ដោយ មាន ខ្លឹមសារ ចោទប្រកាន់ ប៉ូលិស អង់គ្លេស ថា ប្រកាន់ នូវ ស្តង់ដា ពីរ ក្នុង ការប្រព្រឹត្តទៅ លើ សកម្មភាព បាតុកម្ម ពោល គឺ មាន ភាពលម្អៀង ទៅកាន់ ក្រុម បាតុករ គាំទ្រ ប៉ាឡេស្ទីន ។ ការចោទប្រកាន់ របស់ លោកស្រី ត្រូវ គណបក្ស ប្រឆាំង អះអាង ថា បាន បង្កើន ភាពតានតឹង អំលុង ចលនា បាតុកម្ម គាំទ្រ ប៉ាឡេស្ទីន និង សកម្មភាព បាតុកម្ម ប្រឆាំង ចលនា នោះ នៅក្នុង ចក្រភព អង់គ្លេស ។
ទីភ្នាក់ងារ កុមារ របស់ UN គឺ UNICEF បាន និយាយ ក្នុង របាយការណ៍ ថា កុមារ រហូតដល់ទៅ ៣៤៧ លាន នាក់ ក្រោម អាយុ ១៨ ឆ្នាំ កំពុងតែ ប្រឈម ការខ្វះខាត ទឹក ក្នុង កម្រិត ខ្ពស់ ឬ កម្រិត ខ្ពស់ ខ្លាំង ដែល ជា តួលេខ ច្រើន ជាង គេ បំផុត ក្នុង ចំណោម តំបន់ ផ្សេង ៗ ទៀត លើ ពិភពលោក ។ តំបន់ ដែល មាន ប្រទេស ចំនួន ៨ នេះ រួម មាន អាហ្វហ្កានីស្ថាន បង់ក្លាដែស ប៊ូតង់ ឥណ្ឌា នេប៉ាល់ ម៉ាល់ ឌីវ ប៉ាគីស្ថាន និង ស្រីលង្កា ហើយ ជា ទីជម្រក របស់ កុមារ លើស១ភាគ៤ នៃ ចំនួន កុមារ សរុប នៅ ទូទាំង ពិភពលោក ។
