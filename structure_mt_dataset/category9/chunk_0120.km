( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៩នាក់ និង របួស ធ្ងន់ ស្រាល ២១ នាក់ ។
នេះ បើ យោង តាម របាយការណ៍ ផ្លូវការ ពី ក្រសួង សុខាភិបាល ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃ នេះ ៕ ក្រសួង មហាផ្ទៃ កម្ពុជា និង អារ៉ាប៊ី សាអូឌី បង្កើន កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ច្បាប់ និង ការទូត
ក្នុង ឱកាស ចូល ជួប សម្ដែង ការគួរសម ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី នៅ ទីស្ដីការ ក្រសួង មហាផ្ទៃ នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ លោក ឯក អគ្គ រាជ ទូត អារ៉ាប៊ី សាអូឌីត បាន ជម្រាប អំពី ដំណើរការ នៃ ការធ្វើ សេចក្តីព្រាង អនុស្សរណៈ យោគយល់ គ្នា ស្តីពី កិច្ចសហប្រតិបត្តិការ អនុវត្ត ច្បាប់ ដែល ពេលនេះ កំពុង ស្ថិត នៅក្នុង ដំណើរការ នៃ ការកែសម្រួល និង រំពឹង ថា សម្រេចបាន នា ពេល ឆាប់ ៗ ។
ជា ការឆ្លើយតប អភិសន្តិ បណ្ឌិត ស សុខា បាន ស្វាគមន៍ និង ចាត់ទុក វត្តមាន របស់ ឯកឧត្តម ឯក អគ្គ រាជូត នា ពេលនេះ ថា ជា ការបង្ហាញ ឱ្យ ឃើញ អំពី ការយកចិត្តទុកដាក់ របស់ លោក ក្នុង ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ កាន់តែ ជិតស្និទ្ធ រវាង អារ៉ាប៊ី សាអូឌីត និង ព្រះរាជាណាចក្រ កម្ពុជា ជាពិសេស ជាមួយ ក្រសួង មហាផ្ទៃ ផ្ទាល់ ។
* ជំរុញ ការអនុវត្ត គម្រោង សាងសង់ អគារ ថ្មី បន្ថែម ទៀត * ពង្រឹង កិច្ចសហប្រតិបត្តិការ ជាមួយ ដៃគូ ដែល មាន ស្រាប់ និង ពង្រីក ជាមួយ ដៃគូ ថ្មី ៗ ថែម ទៀត * បន្ត អនុវត្ត សកម្មភាព ដែល មាន ស្រាប់ ដោយ ធានា ឆ្លើយតប នឹង អាទិភាព ដែល បាន ដាក់ចេញ ក្នុង យុទ្ធសាស្រ្ត បញ្ចកោណ ដំណាក់កាល ទី១ ក៏ ដូចជា អាទិភាព របស់ ក្រសួង សុខាភិបាល ។
លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ក៏ បាន គូស រំលេច នូវ ការដាក់ចេញ នូវ យុទ្ធសាស្រ្ត បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ ដែល ក្នុង នោះ វិស័យ សុខាភិបាល ជា វិស័យ អាទិភាព មួយ ក្នុង ការលើកកម្ពស់ សុខភាព និង សុខុមាលភាព ប្រជាជន ។ ដើម្បី ឈានទៅ សម្រេចបាន ការគ្របដណ្តប់ សុខភាព ជា សកល ត្រូវ ចូលរួម អនុវត្ត យុទ្ធសាស្រ្ត គន្លឹះ ទាំង ៩ ចំណុច ច និង អាទិភាព គន្លឹះ៖
* ពង្រឹង មណ្ឌល សុខភាព តាមរយៈ ការពង្រឹង ពង្រីក ហេដ្ឋារចនាសម្ព័ន្ធ ការបំពាក់ ឧបករណ៍ សម្ភារៈ បរិក្ខារ វេជ្ជសាស្រ្ត និង ការផ្គត់ផ្គង់ ឱសថ ឱ្យ បាន គ្រប់គ្រាន់ និង ទាន់ ពេលវេលា និង ការពង្រឹង សមត្ថភាព បុគ្គលិក ដើម្បី ធានា ការ ផ្តល់ សេវា ២៤ ម៉ោង លើ ២៤ ម៉ោង ។
ឧប នាយក រដ្ឋមន្ដ្រី ស សុខា ជំរុញ សមាគម មិត្ត នគរបាល ធ្វើ សកម្មភាព ជា គុណ ប្រយោជន៍ ដល់ នគរបាល ជា សមាជិក
( ភ្នំពេញ ) ៖ ក្នុង ពិធី បិទ មហាសន្និបាត របស់ សមាគម មិត្ត នគរបាល កម្ពុជា លោក អភិសន្តិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការបំពេញ តួនាទី ភារកិច្ច អស់ រយៈពេល អាណត្តិ ទី៤ កន្លងទៅ របស់ សមាគម មិត្ត នគរបាល កម្ពុជា ។
ទន្ទឹម នេះ ដើម្បី បំពេញ តួនាទី ភារកិច្ច ឲ្យ កាន់តែ មាន ប្រសិទ្ធផល ថែម ទៀត លោក អភិសន្តិ បណ្ឌិត បាន ថ្លែង លើកទឹកចិត្ត ដល់ គណៈកម្មាធិការ កណ្តាល អាណត្តិ ថ្មី ត្រូវ រៀបចំ ឲ្យ មាន កម្មវិធី ប្រជុំ ជា កំណត់ មួយ ដើម្បី ពិនិត្យ លើ ការងារ ដឹកនាំ និង ដោះស្រាយ បញ្ហា ដែល កើត មាន ឡើង ឲ្យបាន ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ។ ចំពោះ អង្គការ ចាត់តាំង តាម អង្គភាព នីមួយ ៗ ចំណុះ ក្រសួង មហាវិញ គួរ ពិនិត្យ រៀបចំ រចនាសម្ព័ន្ធ ឡើងវិញ ជាពិសេស តាម អគ្គ នាយកដ្ឋាន ដែល ទើប បង្កើត ថ្មី ។
ដើម្បី លើកកម្ពស់ កិត្តិយស មន្ត្រី នគរបាល ជាតិ អភិសន្តិ បណ្ឌិត ស សុខា បាន ជំរុញ ដល់ គណៈកម្មាធិការ អាណត្តិ ថ្មី ឲ្យ ពិចារណា បង្កើត ក្រុមការងារ ឬ អនុគណៈកម្មាធិការ រៀបចំ ពិធី បុណ្យ សព នៅ តាម គណៈកម្មាធិការ មូលដ្ឋាន នីមួយ ៗ សម្រាប់ ចាត់ចែង ពិធី បុណ្យ ឲ្យបាន សមរម្យ ។ ដូចគ្នា ដែរ ថវិកា សម្រាប់ ឧបត្ថម្ភ ដល់ នគរបាល ជាតិ ជា សមាជិក របស់ សមាគម វិញ គប្បី ពន្លឿន ក្នុង ផ្ដល់ជូន ក្រុមគ្រួសារ សព យ៉ាង យូរ ក្នុង រយៈពេល ១២ ថ្ងៃ នៃ ថ្ងៃ ធ្វើការ ដោយ កុំ អូសបន្លាយ ពេល យូរ ។
ដោយឡែក ចំពោះ ការផ្សព្វផ្សាយ សកម្មភាព វិញ គណៈកម្មការនិពន្ធ ទស្សនាវដ្ដី មិត្ត នគរបាល សូម បន្ត បង្កើន ការយកចិត្តទុកដាក់ សម្រិត សម្រាំង ទាំង រូបភាព និង ខ្លឹមសារ អត្ថបទ ឲ្យបាន កាន់តែ ល្អ ទ្វេរ ដង ក៏ ដូចជា ពង្រីក ការចុះផ្សាយ សកម្មភាព ដែល បាន ចុះ ផ្ដល់ ថវិការ ឧបត្ថម្ភ និង ការជួយ រៀបចំ ពិធី បុណ្យ សព ផងដែរ ។
រីឯ ការគ្រប់គ្រង សមាជិក ដើម្បីឱ្យ ស្រប តាម គោល នយោបាយ ឌីជីថល និង ភាពងាយស្រួល សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា គួរ សហការ ជាមួយ អគ្គ នាយកដ្ឋាន បច្ចេកវិទ្យា ឌីជីថល និង ផ្សព្វផ្សាយ អប់រំ និង អគ្គ នាយកដ្ឋាន ធនធាន មនុស្ស នៃ ក្រសួង មហាផ្ទៃ ដើម្បី ឈាន ទៅ ធ្វើ ទំនើបកម្ម គ្រប់គ្រង ឯកសារ របស់ សមាជិក សមាជិកា តាម ប្រព័ន្ធ ឌីជីថល ដោយ មិន អាច នៅ បន្ត ប្រតិបត្តិការ តាម បែប ប្រពៃណី ទៀត ឡើយ ។
ក្នុង ពិធី បិទ មហាសន្និបាត នេះ ដែរ លោក អភិសន្តិ បណ្ឌិត ស សុខា ក៏ ផ្ញើ សារ អំពាវនាវ ដល់ បណ្ដា សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន បន្ត ឧបត្ថម្ភ គាំទ្រ សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា ដើម្បីឲ្យ សមាគម នេះ កាន់តែ រឹងមាំ និង រីកចម្រើន ថែម ទៀត នា ពេល បច្ចុប្បន្ន និង អនាគត ។
គួរ កត់សម្គាល់ ថា មហាសន្និបាត បាន បោះឆ្នោត ជូន នាយ ឧត្ដមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ធ្វើជា ប្រធាន និង បោះឆ្នោត ផ្ដល់ សេចក្ដីទុកចិត្ត ជូន លោក អភិសន្តិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ជា ប្រធាន កិត្តិយស ៕
កម្ពុជា - សាធារណរដ្ឋ កូរ៉េ រៀបចំ សិក្ខាសាលា ចែករំលែក បទពិសោធន៍ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ
( ព្រះសីហនុ) ៖ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង ទីភ្នាក់ងារ សុវត្ថិភាព និង សុខភាព ការងារ សាធារណរដ្ឋ កូរ៉េ (KOSHA) បាន សហការរៀបចំ សិក្ខាសាលា ចែករំលែក បទពិសោធន៍ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ ដែល មាន គោលបំណង រួមចំណែក លើកកម្ពស់ ការយល់ដឹង និង ប្រមូល ព័ត៌មាន សំខាន់ ៗ ក្នុង ដំណើរការ រៀបចំ ច្បាប់ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ សម្រាប់ កម្ពុជា ។
នា ឱកាស នោះ លោកស្រី សុវណ្ណ វណ្ណារតន៍ បាន ឱ្យដឹង ថា តាមរយៈ សិក្ខាសាលា នេះ បាន ផ្ដល់ នូវ ការស្វែងយល់ បន្ថែម អំពី គោល នយោបាយ និង ច្បាប់ ពាក់ព័ន្ធ នឹង សុវត្ថិភាព និង សុខភាព ការងារ នៅ សាធារណរដ្ឋ កូរ៉េ ដើម្បី រួមចំណែក ក្នុង ការលើកកម្ពស់ ការយល់ដឹង និង ប្រមូល ព័ត៌មាន សំខាន់ ៗ ក្នុង ដំណើរការ រៀបចំ ច្បាប់ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ សម្រាប់ ប្រទេស កម្ពុជា ។
ក្នុង ឱកាស នោះ លោកស្រី កិត្តិបណ្ឌិត អ៊ុក ម៉ាលី បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល បាន ផ្តាំផ្ញើ ថ្លែងអំណរ ព្រះគុណ ចំពោះ ទឹក ព្រះទ័យ ដ៏ ជ្រះថ្លា របស់ ព្រះធម្មវ ន វា សី ដែល បាន ចែករំលែក នូវ ទេយ្យ ទាន ជា ថវិកា និង អង្ករ ទាំង នេះ មក ជូន កាកបាទ ក្រហម កម្ពុជា សម្រាប់ បន្ត ចែកជូន ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ និង ងាយ រងគ្រោះ បំផុត ។
តាមរយៈ អំណាច នៃ បុណ្យ ដែល បាន ធ្វើ នៅ ថ្ងៃ នេះ លោកស្រី កិត្តិបណ្ឌិត បាន បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ វត្ថុ ស័ក្តិសិទ្ធ ទាំងអស់ ក្នុង លោក ប្រោស ព្រំ ផ្តល់ នូវ ពរ ជ័យ សិរី សួស្តី សូម ឱ្យ ព្រះរាជាណាចក្រ កម្ពុជា បន្ត ស្ថិត នៅក្នុង សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ជានិច្ច និង សូម បួងសួង ដល់ ព្រះធម្មវ ន វា សី សុន ចាន់ វីរៈ សូម មាន ព្រះសុខភាព ល្អ ព្រះជន្មាយុ យឺន យូរ ដើម្បី បន្ត ទ្រទ្រង់ វិស័យ ព្រះពុទ្ធ សាសនា ឱ្យ បាន គង់វង្ស រីកចម្រើន ត រៀង ទៅ ។
សូម បញ្ជាក់ ថា ក្នុង ឱកាស នោះ ដែរ លោកស្រី កិត្តិបណ្ឌិត បាន ប្រគេន ចំពោះ ព្រះធម្មវ ន វា សី សុន ចាន់ វីរៈ នូវ គ្រឿង ឥស្សរិយយ ស មុនីសារាភ័ណ្ឌ ថ្នាក់ មហាសេរី វឌ្ឍន៍ ដែល ជា ការប្រោស ព្រះរាជ ទាន ដ៏ ឧត្តុង្គឧត្តម ពី ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា កាលពី ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ផងដែរ ៕
តុលាការ ខេត្ត ក្រចេះ សម្រេច ឃុំ ខ្លួន ជនសង្ស័យ ៧នាក់ ដាក់ ពន្ធនាគារ ក្រោយ ចាប់បង្ខាំង មនុស្ស ខុស ច្បាប់ និង អំពើ ឆ បោក នៅ ស្រុក ចិត្រ បុរី
( ក្រចេះ ) ៖ លោក ជា ប៉ោ ចៅក្រម ស៊ើបសួរ សាលាដំបូង ខេត្ត ក្រចេះ នៅ ល្ងាច ថ្ងៃទី ១៥ ខែវិច្ឆកា ឆ្នាំ ២០២៣ នេះ បាន សម្រេច ឃុំ ខ្លួន ជនសង្ស័យ ចំនួន ៧នាក់ ដាក់ ពន្ធនាគារ ក្រោយ ចាប់បង្ខាំង មនុស្ស ខុស ច្បាប់ និង អំពើ ឆ បោក នៅ ស្រុក ចិត្រ បុរី ។
សូម បញ្ជាក់ ថា ជនសង្ស័យ ទាំង ៧នាក់ ត្រូវបាន កម្លាំង អាវុធហត្ថ ក្រចេះ ក្រោម បញ្ជា លោក ឧត្តមសេនីយ៍ សាន្ដ ប៊ុន ថា ន មេបញ្ជាការ អាវុធហត្ថ ខេត្ត ក្រចេះ ឃាត់ខ្លួន កាលពី ថ្ងៃទី ១១ និង ថ្ងៃទី ១២ ខែវិច្ឆកា ឆ្នាំ ២០២៣ នៅ ចំណុច ភូមិ សំបុក ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
យោង តាម របាយការណ៍ អាវុធហត្ថ ខេត្ត ក្រចេះ ដែល ភ្នាក់ងារ ព័ត៌មាន Fresh News ទទួលបាន នា ល្ងាច ថ្ងៃទី ១៤ ខែវិច្ឆកា ឆ្នាំ ២០២៣ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ម៉ោង ១៤៖០០ នាទី កម្លាំង អាវុធហត្ថ បាន ទទួល បណ្តឹង តាម ទូរសព្ទ ពី ឈ្មោះ ប៉ូច គឹម យូ ភេទ ប្រុស អាយុ ៤៥ ឆ្នាំ ជនជាតិ ខ្មែរ រស់ នៅ ភូមិ ក្បាល ពោធិ៍ ឃុំ សំបូរ ស្រុក ទ្រាំង ខេត្ត តាកែវ ថា មាន មនុស្ស មួយ ក្រុម បាន បង្ខាំង ខ្លួន ទុក នៅ ចំណុច ផ្ទះ ១កន្លែង ក្នុង ភូមិ សំបុក ឃុំ សំបុក ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
តាម របាយការណ៍ ដដែក បាន បញ្ជាក់ ទៀត ថា ក្រោយ មាន ការសម្របសម្រួល នីតិវិធី ពី លោក ព្រះរាជអាជ្ញា កម្លាំង អាវុធហត្ថ ខេត្ត បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ជាប់ពាក់ព័ន្ធ ចំនួន ០៤ នាក់ រួម មាន៖
លុះ ដល់ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ កម្លាំង អាវុធហត្ថ ខេត្ត បាន សហការ ជាមួយ កម្លាំង នគរបាល ប៉ុស្តិ៍ សំបុក តំណាង មេភូមិ ដឹកនាំ ដោយ លោក អង រី ព្រះរាជអាជ្ញា រង អយ្យការ សាលាដំបូង ខេត្ត ក្រចេះ បាន បន្ត ធ្វើ ការឆែកឆេរ លំនៅដ្ឋាន របស់ ឈ្មោះ ខ្វៀង ធី បែរ ភេទ ស្រី នៅ ចំណុច ខាងលើ បាន ចាប់ យក វត្ថុតាង រួម មាន៖ ទូរ ដែក ព ណ៏ មាស ចំនួន១ គ្រឿង និង បន្ត ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៣នាក់ ទៀត រួម មាន៖
តាម ការអះអាង របស់ ដើម បណ្តឹង បាន បញ្ជាក់ ថា សំណរ ខ្មៅ ប្រែ ពណ៌ ប្រសិនជា របស់ ពិត គឺ ខ្មៅ សុទ្ធ ការពារ ផ្លូវ ងងឹត មាន តម្លៃ ប្រមាណ ជា ១០លាន ដុល្លា អាមេរិក ) ក្នុង ១ដុំ ៕ ក្រសួង បរិស្ថាន ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ « យុទ្ធសាស្ត្រ ចក្រា វិស័យ បរិស្ថាន ២០២៣ - ២០២៨ » និង « យុទ្ធនាការ ផ្ទៃ មេឃណ៌ ខៀវ និង ការបញ្ចេញ ឧស្ម័ន ផ្ទះ កញ្ចក់ ស្មើ សូន្យ ២០២៥ នៅ កម្ពុជា »
( ភ្នំពេញ ) ៖ ក្រសួង បរិស្ថាន រួម ជាមួយ អង្គការ ពាក់ព័ន្ធ នៅ រសៀល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន ប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ « យុទ្ធសាស្ត្រ ចក្រា វិស័យ បរិស្ថាន ២០២៣ - ២០២៨ » និង « យុទ្ធនាការ ផ្ទៃ មេឃណ៌ ខៀវ និង ការបញ្ចេញ ឧស្ម័ន ផ្ទះ កញ្ចក់ ស្មើ សូន្យ ២០២៥ នៅ កម្ពុជា » ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន រួម ជាមួយ អង្គការ ដៃគូ ដែល ធ្វើ ការលើ វិស័យ បរិស្ថាន នៅ ទីស្តីការ ក្រសួង បរិស្ថាន ។
យុទ្ធសាស្រ្ត ចក្រា វិស័យ បរិស្ថាន ២០២៣ - ២០២៨ បាន រៀបចំឡើង ក្នុង គោលបំណង ប្រែក្លាយ សក្តានុពល វិស័យ បរិស្ថាន ឱ្យ ទៅជា ឧត្តម ប្រយោជន៍ ពិតជាក់ស្តែង សម្រាប់ ប្រទេសជាតិ និង ប្រជាជន កម្ពុជា គ្រប់ ជំនាន់ ។ យុទ្ធសាស្រ្ត ចក្រា វិស័យ បរិស្ថាន ផ្តោត សំខាន់ លើ កម្លាំង បង្វិល៣ ធំ ៗ គឺ ទី១៖ គោល នយោបាយ . ទី ២៖ រដ្ឋបាល ឌីជីថល និង ទី៣៖ ការផ្សព្វផ្សាយ ដែល ជា កម្លាំង ចលករ រុញ នាវា កម្ពុជា ឆ្ពោះទៅ សម្រេចបាន នូវ ចក្ខុវិស័យ កម្ពុជា ឆ្នាំ ២០៥០ គឺ ភាព ស្អាត ភាព បៃតង និង ចីរភាព ។
យុទ្ធសាស្ត្រ ចក្រា វិស័យ បរិស្ថាន ២០២៣ - ២០២៨ នឹង ប្រើប្រាស់ ជា ផែនទី បង្ហាញ ផ្លូវ ក្នុង ការអនុវត្ត ឱ្យ ចំ គោលដៅ អាទិភាព ផ្តល់ សេវា សាធារណៈ ឱ្យ ចំតម្រូវការ របស់ សាធារណជន និង ប្រែក្លាយ សក្តានុពល វិស័យ បរិស្ថាន ឱ្យ ក្លាយទៅជា ឧត្តម ប្រយោជន៍ បម្រើ ដល់ ប្រជាពលរដ្ឋ កម្ពុជា គ្រប់ ជំនាន់ និង ចូលរួមចំណែក ឆ្លើយតប ទៅនឹង ការប្រែប្រួល អាកាសធាតុ សកល ។
យុទ្ធនាការ មេឃ ពណ៌ ខៀវ និង ការបញ្ចេញ ឧស្ម័ន ស្មើ សូន្យ ២០៥០ ជា វេទិកា មួយ ដែល ជួយ ដល់ ភាគី ពាក់ ព័ន្ធ នានា ក្នុង ការចូលរួម ជាមួយ ស្ថាប័ន រដ្ឋាភិបាល ក្នុង ការសម្រេច ឱ្យ បាន គោលដៅ ការបញ្ចេញ ឧស្ម័ន ស្មើ សូន្យ ត្រឹម ឆ្នាំ ២០៥០ តាមរយៈ ការលើកកម្ពស់ ការយល់ដឹង អំពី សកម្មភាព អាកាសធាតុ ដែល បង្កើត ឱ្យ មាន ផ្ទៃ មេឃ ពណ៌ ខៀវ និង ការបញ្ចេញ ឧស្ម័ន ស្មើ សូន្យ ។ យុទ្ធនាការ នេះ ក៏ នឹង ជួយ ផ្ដល់ជូន នូវ ដំណោះស្រាយ ជាក់ស្ដែង តាមរយៈ ភាព ជាដៃគូរ វាង រដ្ឋាភិបាល សហគមន៍ មូលដ្ឋាន និង វិស័យ ពាក់ព័ន្ធ សំខាន់ ៗ ផ្សេង ទៀត ។
ក្នុង នោះ ផងដែរ យុទ្ធនាការ នេះ ចង់ លើក យក ការអនុវត្ត ថ្មី ៗ និង ល្អ ៗ ដែល អាច ធ្វើ ទៅ បាន ជាជាង ការអនុវត្ដ ដើរ តាម គន្លង ចាស់ ( វិធីសាស្ត្រ ដដែល ៗ ) កន្លងមក ដែល នាំឱ្យ មាន ការបំពុល បរិយាកាស ។
( ភ្នំពេញ ) ៖ សមាគម សហគ្រិន វ័យ ក្មេង កម្ពុជា សូម ថ្លែងអំណរគុណ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា ចំពោះ ការដាក់ចេញ គោល នយោបាយ យុទ្ធសាស្ត្រ បន្ទាន់ គាំទ្រ និង ស្ដារ វិស័យ ធុរកិច្ច កម្ពុជា ។
ចំពោះ ការយកចិត្តទុកដាក់ របស់ សម្តេច មហា បវធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា ដល់ សហគ្រាស ខ្នាត មីក្រូ តូច និង មធ្យម ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ គោល នយោបាយ យុទ្ធសាស្ត្រ បន្ទាន់ ក្នុង ការគាំទ្រ និង ស្តារ វិស័យ ធុរកិច្ច ក្នុង ប្រទេស កម្ពុជា នៅក្នុង កាលៈទេសៈ ដ៏ លំបាក បំផុត នេះ ដែល ប្រៀប បាន នឹង ប្រេង រំអិល មួយ ដើម្បី ជួយ ឱ្យ កង់ សេដ្ឋកិច្ច នៅ កម្ពុជា មាន ចរន្ត បន្ត ទៅ មុខ ទៀត បាន ។
យើងខ្ញុំ ទាំងអស់ គ្នា ពុំ អាច បំភ្លេច គុណ ដ៏ ថ្លៃថ្លា នេះ បាន ឡើយ និង សូម ប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ថា នឹង ខិតខំ ប្រឹងប្រែង ពុះពារ រាល់ ឧបសគ្គ ទាំងអស់ នេះ ជាមួយ រាជ រដ្ឋាភិបាល លើ ការស្តារ វិស័យ ទេសចរណ៍ ឱ្យ មាន ដំណើ ការ ល្អ ដើម្បី ជំរុញ ការអភិវឌ្ឍ វិស័យ ឯកជន និង ចូលរួម ភាពធន់ នៃ សេដ្ឋកិច្ច ជាតិ ។
ក្នុង នាម សហគ្រិន វ័យ ក្មេង កម្ពុជា ទាំងអស់ សូម ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី សិរី មង្គល វិបុល សុខ គ្រប់ ប្រការ ជូន សម្តេច មហា បវរធិបតី ព្រមទាំង ក្រុមគ្រួសារ និង សហការី សូម បាន នូវ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
បណ្ឌិត កៅ គឹម ហួន ដឹកនាំ គណៈប្រតិភូ លេខាធិការដ្ឋាន អាស៊ាន ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី១៧ និង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក លើក ទី ១០ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ ទីក្រុង ហ្សាការតា
( ហ្សាការតា ) ៖ តប តាម ការអញ្ជើញ របស់ លោក Prabowo Subianto រដ្ឋមន្ត្រី ការពារ ជាតិ នៃ សាធារណរដ្ឋ ឥណ្ឌូណេស៊ី និង ជា ប្រធាន កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន ឆ្នាំ ២០២៣ លោក បណ្ឌិត កៅ គឹម ហួន អគ្គ លេខាធិការ អាស៊ាន បាន ដឹកនាំ គណៈប្រតិភូ លេខាធិការដ្ឋាន អាស៊ាន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី១៧ និង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក លើក ទី១០ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ ទីក្រុង ហ្សាការតា សាធារណរដ្ឋ ឥណ្ឌូណេស៊ី ។
ហើយ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ លេខាធិការ អាស៊ាន បាន អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី១៧ ដែល បាន ប្រព្រឹត្តទៅ ក្រោម ប្រធានបទ « សន្តិភាព វិបុលភាព និង សន្តិសុខ » ។
កិច្ចប្រជុំ បាន អនុម័ត ឯកសារ សំខាន់ ៗ មួយចំនួន រួមទាំង កម្មវិធី ការងារ របស់ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន ឆ្នាំ ២០២៣ - ២០២៦ ឯកសារ ទស្សនទាន ស្តីពី ការអនុវត្ត ចក្ខុវិស័យ អាស៊ាន ស្តីពី តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក ពី ទស្សនវិស័យ ខាង ការពារ ជាតិ ក៏ ដូច ជា៖ សេចក្តីប្រកាស រួម នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន ដើម្បី សន្តិភាព វិបុលភាព និង សន្តិសុខ ជាដើម ។
នៅ រសៀល ថ្ងៃ ដដែល លោក បណ្ឌិត កៅ គឹម ហួន បាន អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន - សហរដ្ឋ អាមេរិក ។ នៅក្នុង ឱកាស នោះ ឯកឧត្តម អគ្គ លេខាធិការ អាស៊ាន បាន កោតសរសើរ ពី ការរីកចម្រើន នៃ កិច្ចសហប្រតិបត្តិការ ផ្នែក ការពារ ជាតិ អាស៊ាន - សហរដ្ឋ អាមេរិក ដែល ចូលរួមចំណែក យ៉ាង វិជ្ជមាន ដល់ ការអនុវត្ត ភាព ជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - សហរដ្ឋ អាមេរិក ។
នា ឱកាស នោះ ដែរ បណ្ឌិត កៅ គឹម ហួន បាន អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន - ជប៉ុន ។
នៅក្នុង ឱកាស នោះ អគ្គ លេខាធិការ អាស៊ាន បាន គូសបញ្ជាក់ ថា ឆ្នាំ នេះ ជា ឱកាស ប្រកបដោយ អត្ថន័យ សម្រាប់ ទំនាក់ទំនង រវាង អាស៊ាន និង ជប៉ុន ស្រប ពេល ដែល ភាគី ទាំង ពីរ ប្រារព្វ ខួប អនុស្សាវរីយ៍ ៥០ ឆ្នាំ នៃ មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ អាស៊ាន - ជប៉ុន ។
ក្នុង ន័យ នេះ លោក បណ្ឌិត កៅ គឹម ហួន ទន្ទឹង ចាំ មើល កិច្ចសហប្រតិបត្តិ ផ្នែក ការពារ ជាតិ កាន់តែ ជិតស្និទ្ធ រវាង អាស៊ាន និង ជប៉ុន តាមរយៈ ក្របខណ្ឌ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក ៕ អ្នកដំណើរ តាម ផ្លូវ អាកាស នៅ អាកាសយានដ្ឋាន សៀមរាប អង្គរ កើនឡើង ដល់ ៤០០០ នាក់ ក្នុង មួយ ថ្ងៃ
លោក បាន ឱ្យដឹង ផងដែរ ថា បច្ចុប្បន្ន នេះ ការហោះហើរ ជា មធ្យម នៅ អាកាសយានដ្ឋាន សៀមរាប អង្គរ មាន ចំនួន ៤៤ ជើង ( ទ្វេ ទិស ) ក្នុង មួយ ថ្ងៃ ដោយ ភាគ ច្រើន ហោះហើរ ពី តំបន់ អាស៊ាន និង ប្រទេស ចិន ។
ជាមួយគ្នា នេះ លោក កត់សម្គាល់ ថា ការហោះហើរ ត្រលប់ មកវិញ គឺ មាន កំណើន មធ្យម និង ទទួលបាន ភ្ញៀវ ចម្រុះ ជាតិ សាសន៍ ក្នុង នោះ មកពី ប្រទេស ក្នុង តំបន់ អាស៊ាន ច្រើន ជាង គេ មាន រហូតដល់ ៧២% និង តំបន់ អឺរ៉ុប ២៨% ។
សូម ជម្រាប ថា បច្ចុប្បន្ន មាន ក្រុមហ៊ុន អាកាសចរណ៍ ដែល ធ្វើ ការហោះហើរ ចេញ - ចូល អាកាសយានដ្ឋាន សៀមរាប អង្គរ មាន ចំនួន ៩ ក្នុង នោះ មាន ក្រុមហ៊ុន អាកាសចរណ៍ អន្តរជាតិ ចំនួន ៨ និង ក្រុមហ៊ុន អាកាសចរណ៍ ក្នុង ស្រុក ចំនួន ១ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ដូចនេះ ថា « ឥលូវនេះ និយាយ ត្រង់ ខ្ញុំ មិន បង្អាប់ ប្រទេស ណា នោះ ទេ ប្រទេស ដែល ខ្ញុំ ធ្លាប់ នៅ ធ្លាប់ រៀន នៅ អឺរ៉ុប មួយចំនួន បញ្ហា សន្តិសុខ ប្រៀបធៀប ជាមួយ រាជធានី ភ្នំពេញ ប្រហែលជា រាជធានី ភ្នំពេញ ល្អ ជាង តែ ខ្ញុំ មិន និយាយ ប្រទេស ណា ទេ រឿង របស់ គេ ប៉ុន្តែ សួរ ថា ល្អ គ្រប់ ឫ នៅ នៅ ទេ ព្រោះ នៅ មាន បញ្ហា ចឹង យើង ត្រូវ បន្ត ធ្វើ ទៅ ទៀត ហើយ ខ្ញុំ សូម សរសើរ ណាស់ ចំពោះ កម្លាំង សមត្ថកិច្ច របស់ យើង » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ថ្លែង អរគុណ ដល់ កងកម្លាំង សមត្ថកិច្ច ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ស្នងការគន របាល តាម បណ្តា ខេត្ត អគ្គ ស្នងការ នគរបាល ជាតិ និង កង ម្លាំង អាវុធហត្ថ នៅ តាម បណ្តា រាជធានី ខេត្ត ទាំងអស់ ដែល បាន ចូលរួម សហការ អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព បាន ល្អ ប្រសើរ ហើយ បើ ទោះបីជា មាន បញ្ហា អសន្តិសុខ តិចតួច ប៉ុន្តែ ស្ថានភាព នៃ ការគ្រប់គ្រង បាន មាន ភាគ ច្រើន ។
សម្តេច ធិបតី ក៏ បាន រំលឹក ដែរ ថា នៅ ឆ្នាំ ជាង ១៩៩០ មាន ចោរប្លន់ ជា បណ្តាញ តែ ម្តង ហើយ ញឹកញាប់ ណាស់ ក្រុម រ៉ាស្មាច់ និង ក្រុម ផ្សេង ៗ ចេញមក ទាំង អាការ ទាំងឡាន ៗ បន្តិច ទៅ នេះ បន្តិច ទៅ នោះ ប៉ុន្តែ បញ្ហា សន្តិសុខ នៅ ពេល នេះ គឺ មាន ភាពល្អ ប្រសើរ ណាស់ ។
ការណែនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន កោះន រា នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣៤ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៨២ នាក់ ។
* ករណី ដឹកជញ្ជូន រក្សាទុក ២១ ករណី ឃាត់ខ្លួន ៤៣ នាក់ * ករណី ប្រើប្រាស់ ១១ករណី ឃាត់ខ្លួន ៣៧ នាក់ * ករណី ជួញដូរ ២ករណី ឃាត់ខ្លួន ២នាក់
ក្រុម គណបក្ស ប្រឆាំង នៅ កោះ តៃវ៉ាន់ ចូលរួម កម្លាំង គ្នា សម្រាប់ ការបោះឆ្នោត មេដឹកនាំ អាណត្តិ ថ្មី នា ដើម ឆ្នាំ ក្រោយ
( តៃ ប៉ិ) ៖ កាលពី ថ្ងៃអង្គារ សប្តាហ៍ នេះ គណបក្ស ប្រឆាំង នាំមុខ គេ ទាំង ពីរ នៅ កោះ តៃវ៉ាន់ បាន ប្រកាស ថា ពួកគេ នឹង ចូលរួម កម្លាំង ជាមួយគ្នា សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស មេដឹកនាំ អាណត្តិ ថ្មី ដែល ត្រូវ ប្រព្រឹត្តទៅ នា ខែមករា ឆ្នាំ ក្រោយ ប៉ុន្តែ ពួកគេ មិន ទាន់ សម្រេច ថា តើ បេក្ខជន របស់ ភាគី ខាង ណា ដែល នឹង ត្រូវ ឈរឈ្មោះ ជា បេក្ខជន មេដឹកនាំ ឬ បេក្ខជន មេដឹកនាំ រង នៅឡើយ ទេ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃពុធ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត គាំទ្រ ការអភិវឌ្ឍ គម្រោង កោះន រា និង ចាត់ទុក ជា ការអភិវឌ្ឍ ដ៏ ពិសេស ដែល ស្តារ មកវិញ ពី ការបាក់ ដី ដោយ ចរន្ត ទឹក ហូរ ក្លាយជា តំបន់ ពហុ សកម្មភាព សេដ្ឋកិច្ច (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ថ្លែង គាំទ្រ ដល់ ការអភិវឌ្ឍ គម្រោង ទីក្រុង រណប កោះន រា និង ចាត់ទុក គម្រោង នេះ ជា ការអភិវឌ្ឍ ពិសេស ដែល ស្តារ ឡើងវិញ ពី ការបាក់ ដី ដោយ ចរន្ត ទឹក ហូរ ប្រែក្លាយជា តំបន់ ពហុ សកម្មភាព សេដ្ឋកិច្ច ។
ការថ្លែង របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន កោះន រា នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ ដល់ អាជ្ញាធរ រាជធានី ភ្នំពេញ ដែល បាន ចូលរួម បង្ក លក្ខណៈ ងាយស្រួល សម្រាប់ កិច្ចអភិវឌ្ឍន៍ កោះន រា ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែ ទៀត ថា ហេដ្ឋារចនាសម្ព័ន្ធ មាន សារៈសំខាន់ ណាស់ សម្រាប់ ជាតិ ដែល ជា សរសៃ ឈាម របស់ ជាតិ ។ រាជ រដ្ឋាភិបាល តែងតែ ផ្តល់ អាទិភាព ដល់ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ តភ្ជាប់ ហើយ ផ្លូវ ជា អាទិភាព គន្លឹះ មួយ ក្នុង គោល នយោបាយ រាជ រដ្ឋាភិបាល ។
អ្នក ឧកញ៉ា ពុង ឃាវ សែ បាន ឲ្យដឹង ថា តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ អំពី យុទ្ធសាស្ត្រ « យក ស្លឹក ត្នោត ខ្ចប់ ស្ករ ត្នោត » និង « យក ក្រុង ចិញ្ចឹម ក្រុង សាលា រាជធានី ភ្នំពេញ បាន ប្រើប្រាស់ ថវិកា ដែល បាន មកពី ការអភិវឌ្ឍ កោះន រា នេះ មក ធ្វើ ការអភិវឌ្ឍន៍ គម្រោង នានា នៅ រាជធានី ភ្នំពេញ មាន ដូច ជា៖
* សាងសង់ ស្ពាន អាកាស សម្ដេច គង់ សំអុល ចំណុច ប្រសព្វ មហាវិថី សហព័ន្ធ រុស្សី និង ផ្លូវ ២០០៤ * សាងសង់ ស្ពាន អាកាស ព្រះមុនីវង្ស ស្ថិត នៅ ចំណុច ផ្លូវ ប្រសព្វ មហាវិថី សម្តេច តេជោ និង ផ្លូវ ២៧ * សាងសង់ ស្ពាន អាកាស ឫស្សីកែវ ស្រប តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៥ * សាងសង់ ស្ពាន អាកាស បេតុង ខ្សែ កាប ឫស្សីកែវ ប្រវែង ៨០០ ម៉ែត្រ ៕
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ស្នើ ដល់ ធនាគារ និង គ្រឹះស្ថាន ហិរញ្ញវត្ថុ យកចិត្តទុកដាក់ សម្រួល ឥណទាន ដើម្បី សម្រាល ការលំបាក របស់ អ្នក ខ្ចី (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច មហា បវធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន ស្នើ ទៅដល់ ធនាគារ និង គ្រឹះស្ថាន ហិរញ្ញវត្ថុ យកចិត្តទុកដាក់ សម្រួល ឥណទាន ដើម្បី សម្រាល ការលំបាក របស់ អ្នក ខ្ចី ។
ការស្នើ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ស្ពាន កោះន រា ដែល ជា ស្ពាន ប្រអប់ បេតុង ខ្សែកាប ឆ្លងកាត់ ទន្លេបាសាក់ ភ្ជាប់ រវាង តំបន់ អភិវឌ្ឍន៍ កោះ ពេជ្រ និង តំបន់ អភិវឌ្ឍន៍ កោះន រា នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ឥលូវ រាជ រដ្ឋាភិបាល . ធនាគារ ជាតិ បាន អនុញ្ញាត បន្ធូរ លក្ខខណ្ឌ មួយ ចំនួន ជូន វិស័យ ធនាគារ ក៏ ដូចជា ក្រុមហ៊ុន មួយចំនួន ចឹង សូម ធ្វើ យ៉ាង ម្ដេច ប្រតិបត្ដិករ នៅក្នុង វិស័យ នេះ ដែល បាន ការ សម្រាល ហើយ សូម ធ្វើ យ៉ាងណា ជួយ សម្រាល ទៅដល់ អតិថិជន ផង ទៅ តាម លទ្ធភាព ធ្វើ បាន នៅក្នុង លក្ខណៈ ប្រុងប្រយ័ត្ន » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ការធ្វើ យ៉ាង នេះ ដើម្បី ជួយ គ្នា ព្រោះថា អ្នក ចុងក្រោយ គឺជា អតិថិជន បើសិនជា អតិថិជន មាន បញ្ហា ធនាគារ ឬ ក៏ ក្រុមហ៊ុន ដែល ផ្ដល់ កម្ចី ក៏ ជួប បញ្ហា ហើយ រដ្ឋាភិបាល ក៏ មាន បញ្ហា ផងដែរ ។
ជាមួយគ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា អ្វី ដែល រាជ រដ្ឋាភិបាល បាន ផ្ដល់ គោលការណ៍ សង្ឃឹម ថា ប្រតិបត្ដិករ ទាំង នៅក្នុង វិស័យ ធនាគារ . អចលន ទ្រព្យ ក៏ ដូចជា វិស័យ ផ្សេង ៗ ដែល អាច បាន ផល សូម ធ្វើ ការគិតគូរ វិធានការ យ៉ាងណា ដើម្បី ជួយ សម្រាល បន្ដ ទៅដល់ បងប្អូន ប្រជាពលរដ្ឋ របស់ យើង ដែល ត្រូវការកម្ចី ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឲ្យដឹង ទៀត ថា យើង ត្រូវ ជួយ គ្នា នៅក្នុង ការលំបាក ហើយ ពិត ណាស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ព្រោះ មិន ចង់ឲ្យ ដួល រំលំ ដោយ ជួយសម្រួល យ៉ាងណា ក្នុង លក្ខខណ្ឌ មួយ សមស្រប ដោយ មិន ធូរ ពេក និង មិន លំបាក ពេក ។
សូម រំលឹក ថា ក្នុង វេទិកា « រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន » លើក ទី១៩ កាលពី ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ដាក់ចេញ នូវ វិធានការ មួយចំនួន ដើម្បី រួមចំណែក ជួយ ដល់ វិស័យ អចលន ទ្រព្យ ដែល បាន រង ផល ប៉ះពាល់ ពី វិបត្តិ នានា ផ្ទួន ៗ គ្នា ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន លើកទឹកចិត្ត ដល់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ធ្វើ ការរៀបចំ ឥណទាន ឡើងវិញ ជូន ដល់ អ្នក ដែល ខ្ចី ដើម្បី ទិញ ដីធ្លី និង លំនៅឋាន ទៅ តាម លទ្ធភាព ជាក់ស្តែង របស់ គ្រឹះស្ថាន ដោយ ផ្អែក លើ គោលការណ៍ ស្ម័គ្រចិត្ត ៕ រដ្ឋមន្រ្តី ហិរញ្ញវត្ថុ ឥណ្ឌា៖ សង្រ្គាម អ៉ី ស្រាអែល - ហ្កាហ្សា គឺជា បញ្ហា ប្រឈម ចំពោះ គម្រោង ច្រក របៀង សេដ្ឋកិច្ច ដែល គាំទ្រ ដោយ អាមេរិក
កាលពី ខែកញ្ញា ក្រុម មេដឹកនាំ ពិភពលោក បាន ប្រកាស កិច្ចព្រមព្រៀង ផ្លូវ ដែក និង កំពង់ផែ ដែល តភ្ជាប់ តំបន់ មជ្ឈិមបូព៌ា និង អាស៉ី ខាងត្បូង ខណៈ សហរដ្ឋ អាមេរិក ស្វែងរក ការទប់ស្កាត់ ឥទ្ធិពល នៃ គម្រោង ហេដ្ឋារចនាសម្ព័ន្ធ ពិភពលោក « ខ្សែក្រវាត់ និង ផ្លូវ » របស់ ចិន ជាមួយ គម្រោង បង្កើត ច្រក របៀង សេដ្ឋកិច្ច ថ្មី មួយ ។
គួរ បញ្ជាក់ ថា ច្រក របៀង ដែល បាន ស្នើ ឡើង នឹង ឆ្លងកាត់ អ៉ី ស្រាអែល ដែល កំពុង ធ្វើ សង្រ្គាម យ៉ាង ខ្លាំងក្លា ជាមួយ ក្រុមហា ម៉ាស ដើម្បី សងសឹក ចំពោះ ការវាយលុក ឆ្លង ព្រំដែន ចូល ទៅក្នុង ប្រទេស របស់ ខ្លួន ថ្ងៃទី ៧ ខែតុលា ៕ រូបភាព ពី Reuters បទ វិភាគ៖ ភព ផែនដី ដ៏ ធំ ល្វឹងល្វើយ អាច ផ្តល់ លំហ កាន់តែ ទូលំទូលាយ សម្រាប់ ការអភិវឌ្ឍ រៀង ខ្លួន របស់ ចិន និង សហរដ្ឋ អាមេរិក ក៏ ដូចជា វិបុលភាព រួម ផងដែរ
តើ ទំនាក់ទំនង រវាង ចិន និង អាមេរិក ដែល កំពុង ស្ថិតិ ក្នុង ផ្លូវ កែង ម្តង ទៀត នឹង ទៅកាន់ ទិស ណា ភាគី ទាំង ពីរ ចាំបាច់ ត្រូវ ធ្វើ ការជ្រើសរើស ម្តង ទៀត ចំណែក ជោគវាសនា នៃ ទំនាក់ទំនង ទ្វេ ភាគី ដ៏ សំខាន់ បំផុត នៅលើ ពិភពលោក គឺ ក្តាប់ ជាប់ ក្នុង ដៃ របស់ ខ្លួន ។
ភព ផែនដី ដ៏ ធំ ល្វឹងល្វើយ អាច ផ្តល់ លំហ កាន់តែ ទូលំទូលាយ សម្រាប់ ការអភិវឌ្ឍ រៀង ខ្លួន របស់ ចិន និង សហរដ្ឋ អាមេរិក ក៏ ដូចជា វិបុលភាព រួម ផងដែរ ។ យ៉ាងណាមិញ ចាប់តាំងពី ឈាន ចូល ទសវត្សរ៍ ទី ២ នៃ សតវត្សរ៍ ទី ២១ មក សហរដ្ឋ អាមេរិក បាន ចាត់ទុក ប្រទេស ចិន ជា ដៃគូ ប្រកួតប្រជែង ចម្បង របស់ ខ្លួន បន្តិច ម្តង ៗ ។ នៅលើ បណ្តាញ អ៊ីនធឺណែត របស់ ចិន មាន ឃ្លា ពេញនិយម មួយ ដែល ថា " បំភ្លឺ តែ ចង្កៀង ផ្ទះ ខ្លួន ឯង បាន ហើយ កុំ ពន្លត់ ចង្កៀង របស់ អ្នកដទៃ " ។
ការប្រកួតប្រជែង វវាង ប្រទេស និង ប្រទេស ជា រឿង ប្រក្រតី ហើយក៏ គ្មាន ផល ប៉ះពាល់ អ្វី ទេ ប៉ុន្តែ គួរតែ ជា ការប្រកួតប្រជែង ប្រកបដោយ ភាពវិជ្ជមាន មិន មែន ជា ការប្រកួតប្រជែង ដ៏ អាក្រក់ ដែល វាយប្រហារ គ្នា ទៅ វិញ ទៅមក និង ប្រយុទ្ធ យក ស្លាប់ រស់ នោះ ទេ ។ ការប្រកាន់ខ្ជាប់ ការយល់ដឹង ដ៏ ត្រឹមត្រូវ ចំពោះ ប្រទេស ចិន គឺជា មូលដ្ឋានគ្រឹះ និង បុរេលក្ខខណ្ឌ នៃ ការជំរុញ ទំនាក់ទំនង រវាង ចិន និង អាមេរិក ឱ្យ មាន ស្ថិរភាព ឡើងវិញ និង ចូលក្នុង ដំណើរ វិល ជុំ ដ៏ វិជ្ជមាន ។
អត្ថបទ និង រូបភាព ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន កោះន រា
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃពុធ ៣កើត ខែកត្ដិក ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ស្ពាន កោះន រា ។
ស្ពាន កោះន រា ជា ស្ពាន ប្រអប់ បេតុង ខ្សែ កាប ឆ្លងកាត់ ទន្លេបាសាក់ ភ្ជាប់ រវាង តំបន់ អភិវឌ្ឍន៍ កោះ ពេជ្រ និង តំបន់ អភិវឌ្ឍន៍ កោះន រា ។ ស្ពាន កោះន រា បាន បើក ការដ្ឋាន សាងសង់ កាល ពី ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០២០ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន កោះន រា៖
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន សម្តែង ក្តី សោមនស្ស រីករាយ ដែល បាន អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន កោះន រា និង ស្ពាន នាគ ភ្លោះ កោះន រា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ ដែល បាន ចេញ ទៅ បោះឆ្នោត យ៉ាង ច្រើន កុះករ កាលពី ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ ដល់ អាជ្ញាធរ ក្នុង រាជធានី ភ្នំពេញ ដែល បាន ចូលរួម បង្ក លក្ខណៈ ផ្សេង សម្រាប់ កិច្ចអភិវឌ្ឍន៍ កោះន រា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ហេដ្ឋារចនាសម្ព័ន្ធ មាន សារៈសំខាន់ ណាស់ សម្រាប់ ជាតិ ។ ហេដ្ឋារចនាសម្ព័ន្ធ គឺជា សរសៃ ឈាម របស់ ជាតិ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ពីមុន ភ្ជាប់ គ្នា តែ តាម ផ្លូវគោក ផ្លូវ ទឹក និង ផ្លូវ អាកាស ឥឡូវ មាន ផ្លូវ មួយ ទៀត គឺ ផ្លូវ ឌីជីថល ។ ផ្លូវ ឌីជីថល នេះ ភ្ជាប់ ទំនាក់ទំនង គ្នា បាន លឿន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង គាំទ្រ ការអភិវឌ្ឍន៍ កោះន រា ដោយ សម្តេច ចាត់ទុក ការអភិវឌ្ឍន៍ នេះ ជា ការអភិវឌ្ឍន៍ ដ៏ ពិសេស ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ចាត់ទុក ការអភិវឌ្ឍន៍ កោះន រា គឺជា ការស្រង់ ស្ថានភាព កោះ ដែល ពីមុន ត្រូវបាន បាក ចូល ទន្លេ ហើយ ការអភិវឌ្ឍន៍ នេះ បាន ក្លាយទៅជា កន្លែង មាន សក្តានុពល ផ្នែក សេដ្ឋកិច្ច ខ្ពស់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការអភិវឌ្ឍន៍ កោះន រា គឺជា ការបែងចែក ផល លាភ ទៅ ប្រជាពលរដ្ឋ មិន មែន សម្រាប់ តែ ឧកញ៉ា ពុង ឃាវ សែ ឬ មនុស្ស មួយ ក្តាប់ តូច នោះ ទេ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការអភិវឌ្ឍន៍ កោះន រា នឹង ពង្រីក ផល សេដ្ឋកិច្ច ដល់ ច្បារអំពៅ និង ចំការមន ផងដែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា គោល នយោបាយ អភិវឌ្ឍន៍ របស់ កម្ពុជា គឺ ពលរដ្ឋ គ្រប់ រូប ទទួលបាន ផល លាភ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បង្ហាញ ក្តីសង្ឃឹម ថា ក្រុមហ៊ុន អ្នក ឧកញ៉ា ពុង ឃាវ សែ នឹង បន្ត យកចិត្តទុកដាក់ ក្នុង ការអភិវឌ្ឍន៍ តំបន់ កោះន រា ទៅ តាម ផែនការគ្រោងទុក ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ស្នើ ទៅដល់ ធនាគារ និង គ្រឹះស្ថាន ហិរញ្ញវត្ថុ យកចិត្តទុកដាក់ សម្រួល ឥណទាន ដើម្បី សម្រាល ការលំបាក របស់ អ្នក ខ្ចី ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការដាក់ចេញ គោល នយោបាយ ឱ្យ ជន បរទេស ជួល ផ្ទះ ជួល ដី រយៈពេល យូរ នៅតែ បន្ត អនុវត្តន៍ តាម រដ្ឋធម្មនុញ្ញ ហើយ មិន ឱ្យ ជន បរទេស ទាំង រូប វន្ត បុគ្គល និង នីតិបុគ្គល អាច កាន់កាប់ ដីធ្លី ខ្មែរ បាន នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ ពង្រឹង សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ សាធារណៈ ទប់ស្កាត់ រាល់ សកម្មភាព ចលាចល ក្នុង សង្គម ជាពិសេស ពេល បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ រដ្ឋបាល រាជធានី ភ្នំពេញ គិតគូរ សម្រួល លំហូរ ចរាចរណ៍ ក្រោយ ដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន កោះន រា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ រដ្ឋបាល រាជធានី ភ្នំពេញ ពង្រឹង ការផ្តល់ សេវា ដឹកជញ្ជូន ក្នុង រាជធានី ភ្នំពេញ ដោយ ពង្រាយ ខ្សែ រត់ រថយន្តក្រុង បន្ថែម មកកាន់ កោះន រា និង តំបន់ អភិវឌ្ឍន៍ ដទៃ ទៀត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ចង់ឱ្យ មាន ការសិក្សា រៀបចំ ផ្លូវ សម្រាប់ រថយន្តក្រុង សាធារណៈ ដើម្បី សម្រួល ការធ្វើចរាចរណ៍ រថយន្តក្រុង សាធារណៈ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បង្ហាញ បំណង សិក្សា ផ្លូវ អាកាស និង ផ្លូវ ក្រោម ដី ក្នុង រាជធានី ភ្នំពេញ ដើម្បី សម្រួល ការធ្វើចរាចរណ៍ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ចង់ឱ្យ មាន ការសិក្សា រៀបចំ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ដោយ រៀបចំ ជា តំបន់ បៃតង តំបន់ អាជីវកម្ម និង តំបន់ កម្សាន្ត សប្បាយ ដាច់ ៗ ពី គ្នា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ រដ្ឋបាល រាជធានី ភ្នំពេញ យកចិត្តទុកដាក់ ពង្រឹង នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ដើម្បី ពង្រឹង សណ្តាប់ធ្នាប់ សាធារណៈ ទប់ស្កាត់ ចោរ ឆក់ ប្លន់ និង សុវត្ថិភាព សម្រាប់ អ្នកទេសចរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ឲ្យដឹង ថា អ្នក បាញ់ បោះ នៅ គិរីរម្យ ៤នាក់ ត្រូវបាន បណ្តេញ ចេញ ពី ក្របខណ្ឌ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សន្តិសុខ ប្រទេស នៅ តំបន់ អឺរ៉ុប មួយចំនួន ដែល សម្តេច ធ្លាប់ រស់ នៅ ចាញ់ រាជធានី ភ្នំពេញ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ឥឡូវនេះ មាន ជល់ មាន់ តាម អាកាស មាន ចាក់ ទឹកភ្លៀង តាម អនឡាញ ។ រាជ រដ្ឋាភិបាល នឹង ប្រឹងប្រែង ទប់ស្កាត់ ។
រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង រៀបចំ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ រវាង ថ្នាក់ដឹកនាំ ខេត្ត និង ថ្នាក់ ក្នុង មូលដ្ឋាន ទូទាំង ខេត្ត
យោង អនុក្រឹត្យ លេខ ២១៦ អន ក្រ. ប ក ចុះ ថ្ងៃទី ១៤ ខែធ្នូ ឆ្នាំ ២០០៩ ស្តីពី តួនាទី ភារកិច្ច និង ទំនាក់ទំនង ការងារ របស់ ក្រុមប្រឹក្សា និង គណៈ អភិបាល ខេត្ត ក្រុមប្រឹក្សា និង គណៈ អភិបាល ក្រុង ក្រុមប្រឹក្សា និង គណៈ អភិបាល ស្រុក មាត្រា ៩បាន ចែង ថា ក្នុង អំឡុង ត្រីមាស ទី៤ នៃ ឆ្នាំ នីមួយ ៗ ក្រុមប្រឹក្សា ខេត្ត ត្រូវ រៀបចំ ឱ្យ មាន វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ នៅ តាម ក្រុង ស្រុក នានា ក្នុង ខេត្ត ។
ក្រសួង ការងា រ៖ មុខជំនាញ ចំនួន ៣៨មុខ ដែល នឹង បណ្តុះបណ្តាល ដល់ យុវជន មក ពី គ្រួសារ ក្រីក្រ ជា ជំនាញ ដែល ទីផ្សារ កំពុង ត្រូវការ
គ្មាន លុយ យក ទៅ ដណ្តឹង ប្រពន្ធ ចាក់ សម្លាប់ មិត្តភ័ក្រប្លន់ យក ម៉ូតូ ត្រូវ នគរបាល ឃាត់ខ្លួន
( កំពង់ស្ពឺ ) ៖ ដោយសារតែ ខ្វះ លុយ ចូល ចែ ចូវ កូនក្រមុំ គេ បែរជា ចិត្ត ដាច់ ចាក់ សម្លាប់ មិត្តភ័ក្រឯង យក ម៉ូតូ តែ វាសនា មិន ល្អ ត្រូវបាន កម្លាំង នគរបាល ក្រុង ឧដុង្គ ម៉ែ ជ័យ ឃាត់ខ្លួន បាន ភ្លាម ៗ ។ ជន ដៃ ដល់ បាន ល្បួង មិត្តភ័ក្រ ទិញ ស្រា របៀរ ហូប ជាមួយគ្នា រួច ទាញ កាំបិត ចុង ស្រួច វែង ចាក់ សម្លាប់ ប្លន់ យក ម៉ូតូ មិត្តភក្តិ ដើម្បី ដណ្តឹង ប្រពន្ធ នៅឯ ខេត្ត តាកែវ ។
ការឃាត់ខ្លួន ខាងលើ នេះ បាន ធ្វើឡើង កាលពី វេលា ម៉ោង ៧៖ ៤០ យប់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ ចំណុច ខាងជើង រោង ម៉ាស៊ីន កិន ស្រូវ អប្សរា រ៉ាយ ភូមិ ស្រះ កៃវ សង្កាត់ វាំង ចាស់ ក្រុង ឧដុង្គ ម៉ែ ជ័យ ខេត្ត កំពង់ស្ពឺ ។
នគរបាល ក្រុង ឧដុង្គ ម៉ែ ជ័យ បាន ឱ្យដឹង ថា មាន ករណី ប្លន់ យក ម៉ូតូ មួយ បាន កើតឡើង ដោយសារតែ ជន ដៃ ដល់ បាន ធ្វើ សកម្មភាព យក កូន កាំបិត ចុង ស្រួច ទៅ អារ - ក និង ចាក់ សម្លាប់ ជនរងគ្រោះ ដើម្បី ប្លន់ យក ម៉ូតូ ខណៈ ដែល កំពុង ផឹក ស៊ី ជាមួយគ្នា ហើយ ជនរងគ្រោះ និង ជនសង្ស័យ ជា មនុស្ស ស្គាល់ គ្នា កាលពី រសៀល ថ្ងៃ ខែ ដដែល ។
សមត្ថកិច្ច បាន បន្ត ទៀត ថា ជនរងគ្រោះ មាន ឈ្មោះ ណយ ចាន់ ណៃ អាយុ ២២ ឆ្នាំ មុខរបរ កម្មករ រោងចក្រ រស់ នៅ ភូមិ រំលេច សង្កាត់ ព្រះស្រែ ក្រុង ឧដុង្គ ម៉ែ ជ័យ រីឯ ជន ដៃ ដល់ មាន ឈ្មោះ ពេជ្រ រ៉ាវី អាយុ ២០ ឆ្នាំ មុខរបរ កម្មករ រោងចក្រ រស់ នៅក្នុង ភូមិ ត្រពាំង ពុទ្រា ឃុំ ទំនប់ ធំ ស្រុក ពញា ឮ ខេត្ត កណ្តាល ។
ករណី នេះ កម្លាំង នគរបាល ជំនាញ បាន ចុះ ដល់ កន្លែង កើត ហេតុ ធ្វើ ការស្រាវជ្រាវ បាន ឃាត់ខ្លួន ជន ដៃ ដល់ ជា កម្មករ រោងចក្រ ធ្វើ ការងារ ជាមួយ ជនរងគ្រោះ ដែរ ។ ក្រោយមក នគរបាល បាន ដកហូត វត្ថុតាង បន្សល់ទុក នៅ កន្លែង កើត ហេតុ កូន កាំបិត ០១ ដើម ស្បែកជើង ០១គូ និង ស្រាបៀរ ០៦ កំប៉ុង ។
តាម ចម្លើយ សារភាព របស់ ជនសង្ស័យ ឆ្លើយ ថា ខ្លួន ពិតជា បាន ធ្វើ សកម្មភាព ចាក់ និង អារ - ក សម្លាប់ ជនរងគ្រោះ យក ប្លន់ ម៉ូតូ ប្រាកដ មែន ដោយសារ ខ្លួន ខ្វះ លុយ យក ទៅ ស្តី ដណ្តឹង ប្រពន្ធ នៅក្នុង ខេត្ត តាកែវ ទើប សម្រេចចិត្ត ធ្វើ បែប នេះ ទៅ ៕ ឡាន ដឹក កម្មករ រោងចក្រ ជួប គ្រោះថ្នាក់ ចរាចរណ៍ ស្លាប់ ម្នាក់ និង របួស ១៣នាក់ លើ ផ្លូវ ជាតិ លេខ ៤១
( កំពង់ស្ពឺ ) ៖ មាន គ្រោះថ្នាក់ ចរាចរណ៍ រថយន្ត និង ម៉ូតូ ប ញ្រ្ចាស ទិស គ្នា បាន កើតឡើង នៅ យប់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅលើ ផ្លូវ ជាតិ លេខ ៤១ ចន្លោះ គីឡូម៉ែត្រ ២៦ - ២៧ ត្រង់ ចំណុច ភូមិ អណ្ដូង ច្រុះ ឃុំ ស្នំ ក្រពើ ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ ។
លោក អភិបាល ស្រុក បន្ត ថា ករណី ខាងលើ បណ្ដាលឲ្យ ស្លាប់ អ្នកបើកបរ ម៉ូតូ និង របួស កម្មករ ចំនួន ១៣នាក់ ក្នុង នោះ រងរបួស ស្រាល ចំនួន ១២ និង របួស បាក់ ដៃ ខាងឆ្វេង ១ នាក់ តែ ភ្លាម ៗ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ផងដែរ ៕ ចលនា ប្រដាប់អាវុធ នៅ មីយ៉ាន់ម៉ា អះអាង ថា កងកម្លាំង រាប់ សិប នាក់ របស់ របប យោធា ទម្លាក់ អាវុធ ចុះចាញ់ និង ត្រូវបាន ចាប់ខ្លួន
( ណៃ ពិដោ) ៖ ចលនា ប្រដាប់អាវុធ ជនជាតិ ភាគ តិច មួយ នៅឯ ប្រទេស មីយ៉ាន់ម៉ា បាន អះអាង នា ថ្ងៃពុធ នេះ ថា សមាជិក សរុប រាប់ សិប នាក់ នៃ កងកម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា បាន នាំគ្នា ទម្លាក់ អាវុធ ចុះចាញ់ ឬ ត្រូវបាន ចាប់ខ្លួន ខណៈ ដែល ប្រតិបត្តិការ វាយលុក ក្រោម ការរួម សហការ គ្នា រវាង ក្រុម ចលនា ប្រដាប់អាវុធ ប្រឆាំង នឹង របប សឹក មីយ៉ាន់ម៉ា កំពុង បន្ត ប្រព្រឹត្តទៅ នៅ តាម បណ្តា រដ្ឋ មួយចំនួន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃពុធ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ពិធី ខាងលើ នេះ មាន ការអញ្ជើញ ចូលរួម ពី លោក រស់ ពិសិដ្ឋ ប្រធាន សាលាដំបូង លោក ឡុង ហុក ម៉េង ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី ព្រមទាំង លោក ឧត្តមសេនីយ៍ វរសេនីយ៍ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ លោក អភិបាល អភិបាល រង ក្រុង ស្រុក អធិការ អធិការ រង ស្រុក ក្រុង លោក មេឃុំ នាយ ប៉ុស្តិ៍ រដ្ឋបាល ឃុំ សង្កាត់ ទូទាំង ខេត្ត រតនគិរី ។
* ទី១៖ ជំរុញ ការងារ ផ្សព្វផ្សាយ អប់រំ * ទី ២៖ ធ្វើ ផែនការ សកម្មភាព បន្ត សម្រាប់ ដឹកនាំ អនុវត្ត ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន *ទី ៣៖ ជំរុញ ការដឹកនាំ អនុវត្ត ផែនការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន លើក ទី៨ ។
ឆ្លៀត ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ បាន ថ្លែង សាទ រ និង កោតសរសើរ គណៈកម្មាធិកា ត្រួតពិនិត្យ គ្រឿងញៀន ខេត្ត រតនគិរី និង អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន ខិតខំ រួមគ្នា ប្រកបដោយ ការទទួលខុសត្រូវ សម្រេចបាន នូវ លទ្ធផល បាន ល្អ ប្រសើរ លើ ការងារ ត្រួតពិនិត្យ គ្រឿងញៀន នាំមក នូវ សុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ។
ជាមួយគ្នា នេះ ដើម្បីឲ្យ ការងារ ចាត់តាំង ការអនុវត្ត ការងារ ខាងលើ ទទួលបាន ប្រសិទ្ធភាព ល្អ . នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ បាន ស្នើឲ្យ គណៈ បញ្ជាការ ឯកភាព ខេត្ត ត្រូវ ម្ចាស់ ការដឹកនាំ អនុវត្ត ការងារ ខាងលើ ទៅ តាម ជំនាញ និង វិស័យ របស់ ខ្លួន ក្នុង ដែន សមត្ថកិច្ច ផងដែរ ៕
រដ្ឋមន្រ្តី ព័ត៌មាន៖ ការពង្រឹង ស្ថាប័ន ការពង្រឹង សមត្ថភាព មន្រ្តី និង ការលើកទឹកចិត្ត ជា ចំណុច សំខាន់ នៃ ដំណើរការកែទម្រង់ រដ្ឋបាល សាធារណៈ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ លោក នេត្រ ភក្ត្រា រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន បាន លើកឡើង ថា ការពង្រឹង ស្ថាប័ន ការពង្រឹង សមត្ថភាព មន្រ្តី និង ការលើកទឹកចិត្ត គឺជា ចំណុច សំខាន់ នៃ ដំណើរការកែទម្រង់ រដ្ឋបាល សាធារណៈ ហើយ សម្រាប់ ការធ្វើ កំណែទម្រង់ នេះ ក្រសួង ព័ត៌មាន គឺ មាន ការពាក់ព័ន្ធ ចំនួន ៣ ដែល ត្រូវ ធ្វើ រួម មាន កំណែទម្រង់ រដ្ឋបាល សាធារណៈ . ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ និង កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ ។
ការលើកឡើង របស់ រដ្ឋមន្រ្ដី បែប នេះ ក្នុង ឱកាស បើក សិក្ខាសាលា ផ្សព្វផ្សាយ តម្រង់ ទិស ទស្សនា ទាន នៃ កំណែទម្រង់ រដ្ឋបាល សាធារណៈ នា ព្រឹក ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ ទីស្តីការ ក្រសួង ព័ត៌មាន ។
លោក នេត្រ ភក្ត្រា បាន លើកឡើង ពី សារៈសំខាន់ នៃ សិក្ខាសាលា នា ឱកាស នេះ ដែល ពាក់ព័ន្ធ ដល់ ដំណើរការ កំណែទម្រង់ រដ្ឋបាល សាធារណៈ ជា កិច្ចការងារ មួយ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ ជា អាទិភាព ក្នុង ការគ្រប់គ្រង និង ដឹកនាំ ប្រទេស នៅក្នុង អាណត្តិ ទី៧ ។
លោក រដ្ឋមន្រ្តី បាន ថ្លែង ថា សម្រាប់ អាណត្តិ ទី៧ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា នៅ ឆ្នាំ ២០២៤ គឺ ឆ្នាំ ដែល យើង ត្រូវ ចាប់ ហ្វ្រាំង មាន ន័យ ថា ក្រសួង ស្ថាប័ន ទាំងអស់ ត្រូវ ពិនិត្យ វាយតម្លៃ ទៅ លើ អ្វី ដែល ក្រសួង ស្ថាប័ន របស់ ខ្លួន មាន ហើយ រៀបចំ នូវ ផែនការ ឱ្យ បាន ច្បាស់លាស់ មុននឹង បន្ត ដំណើរ ទៅ មុខ ទៀត ។
ទន្ទឹម នេះ សម្រាប់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧នេះ ក៏ បាន ផ្តោត លើ ការងារ ជា អាទិភាព សំខាន់ ៗ ចំនួន ៦ ក្នុង នោះ រួម មាន៖
លោក រដ្ឋមន្រ្ដី បាន ថ្លែង បញ្ជាក់ ថា សម្រាប់ មុខងារ សាធារណៈ គឺជា អាទិភាព១ ស្ថិត ក្នុង ដំណើរ នៃ ការកែទម្រង់ ទៅ លើ ស្ថាប័ន ហើយ ការគ្រប់គ្រង ស្ថាប័ន មួយ គឺ ត្រូវ ផ្តោត សំខាន់ ទៅ លើ ៣ ចំណុច រួម មាន៖
* ទី ១៖ ផ្តោត លើ ភាព ជា អ្នកដឹកនាំ មាន ន័យ ថា តាំងពី ថ្នាក់ កំពូល រហូតដល់ ថ្នាក់ ក្រោម គឺ ចាំបាច់ ត្រូវ មាន ភាព ជា អ្នកដឹកនាំ * ទី ២៖ រចនាសម្ព័ន្ធ ការងារ ច្បាស់លាស់ មាន ន័យ ថា យើង ស្គាល់ តូនាទី និង ការបែងចែក តូនាទី ភារកិច្ច ឱ្យ បាន ច្បាស់លាស់ *ទី ៣៖ ធនធាន មនុស្ស ដែល ចំណុច ទាំង ៣នេះ នាំ ទៅ រក ការដឹកនាំ ស្ថាប័ន បាន រឹងមាំ ។
រដ្ឋមន្រ្តី ក៏ បាន ជម្រាប ជូន ផងដែរ ថា សម្រាប់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ រហូតមកដល់ ថ្ងៃ នេះ គឺ មាន រយៈពេល ៨២ ថ្ងៃ ហើយ ក្នុង ពេល បន្តបន្ទាប់មក នេះ តាម ក្រសួង ស្ថាប័ន ក៏ ដូចជា សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី តែង ធ្វើ ការប្រជុំ ជាច្រើន ដង គឺ ដើម្បី ដាក់ ចុះ នូវ គោល នយោបាយ ផែនការ សកម្មភាព សម្រាប់ ដំណើរការ រាជ រដ្ឋាភិបាល ថ្មី ឱ្យ បាន កាន់តែ ល្អ និង បន្ត ទៅ មុខ ទៀត ។
លោក នេត្រ ភក្រ្ដា បាន បញ្ជាក់ ឱ្យដឹង ដែរ ថា សម្តេច ធិបតី នាយក រដ្ឋមន្រ្តី បាន ទុក ពេល ឱ្យ ១ ឆ្នាំ ដល់ ក្រសួង ស្ថាប័ន ដើម្បី ធ្វើ កំណែទម្រង់ រដ្ឋបាល សាធារណៈ ដែល មាន ៣ ចំណុច សំខាន់ គឺ ការពង្រឹង ស្ថាប័ន ការពង្រឹង សមត្ថភាព មន្រ្តី និង ការលើកទឹកចិត្ត ។
លោក បាន គូសបញ្ជាក់ អំពី ចំណុច សំខាន់ ៗ ដែល ក្រសួង ព័ត៌មាន ត្រូវ ធ្វើ ចាប់ពី ពេលនេះ ទៅ គឺ ការបណ្តុះបណ្តាល និង ពង្រឹង ធនធាន មនុស្ស ឱ្យ បាន រឹងមាំ ដោយ ត្រូវ ប្រមូល ម្តុំ មន្រ្តី ធ្វើ ការងារ ជា រួម ឡើងវិញ ក្នុង នោះ ត្រូវ រៀបចំ ធនធាន មនុស្ស ឡើងវិញ ឱ្យ មាន គុណភាព និង សមត្ថភាព ដើម្បី បំពេញ កិច្ចការងារ ឱ្យ មាន ប្រសិទ្ធភាព ។
លោក នេត្រ ភក្រ្ដា បាន សង្កត់ធ្ងន់ ថា ការពង្រឹង សមត្ថភាព និង សមិទ្ធិកម្ម ស្ថាប័ន គឺ ដើម្បី លើកកម្ពស់ គុណភាព ការងារ ប្រកបដោយ វិន័យ សីលធម៌ វិជ្ជាជីវៈ ប្រសិទ្ធភាព និង ស័ក្តិសិទ្ធិភាព ហើយ ការដាក់ ឱ្យ អនុវត្តន៍ ប្រព័ន្ធ លើកទឹកចិត្ត គាំទ្រ សមិទ្ធិកម្ម ប្រកបដោយ សង្គតិភាព សមធម៌ ប្រសិទ្ធភាព ជាពិសេស អ្វី សំខាន់ នោះ គឺ រួម ចិត្ត រួម គំនិត រួម សកម្មភាព ។
រដ្ឋលេខាធិការ បាន លើកឡើង បន្ថែម ថា ការកែទម្រង់ រដ្ឋបាល សាធារណៈ នេះ គឺ ដើម្បី ធ្វើឱ្យ មាន សង្គតិភាព នៃ ការតាក់តែង លិខិត បទដ្ឋាន គតិយុត្ត ការរៀបចំ និង ការដាក់ ឱ្យ អនុវត្តន៍ ឧបករណ៍ ការងារ គតិយុត្ត លើកកម្ពស់ ការយល់ដឹង និង លើកកម្ពស់ ប្រសិទ្ធភាព នៃ ការអនុវត្ត លិខិត បទដ្ឋាន គតិយុត្ត ព្រមទាំង ផ្តល់ ដំណោះស្រាយ យុត្តិធម៌ ឬ សមធម៌ ចំពោះ វិវាទ ឬ ការតវ៉ា នានា ពាក់ព័ន្ធ នឹង ដែន សមត្ថកិច្ច ក្នុង ក្របខ័ណ្ឌ របស់ ក្រសួង ព័ត៌មាន ដែល ជា កិច្ចការ អាទិភាព ៕
រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង បើក កិច្ចប្រជុំ ពិគ្រោះយោបល់ ស្តីពី ការរៀបចំ និង កសាង កម្មវិធី វិនិយោគ បី ឆ្នាំ រំកិល ២០២៤ - ២០២៦
លោក ធូ ចាន់ ពៅ បាន ថ្លែង ថា កិច្ចប្រជុំ ពិគ្រោះយោបល់ ស្តីពី ការកសាង កម្មវិធី វិនិយោគ សម្រាប់ ឆ្នាំ ២០២៤ - ២០២៦ របស់ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង ពិតជា មាន សារសំខាន់ ណាស់ ក្នុង ការរៀបចំ ផែនការអភិវឌ្ឍន៍ និង កម្មវិធី វិនិយោគ ស្រប តាម ច្បាប់ ស្តីពី ការគ្រប់គ្រង រដ្ឋបាល រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ។
លោក អភិបាល រង ខេត្ត បន្ត ថា កិច្ចប្រជុំ ពិគ្រោះយោបល់ ស្តីពី ការកសាង កម្មវិធី វិនិយោគ បី ឆ្នាំ រំកិល ( ២០២៤ - ២០២៦ ) គឺ ដើម្បី បង្ហាញ អំពី តម្រូវការអភិវឌ្ឍន៍ មូលដ្ឋាន ទូទាំង ខេត្ត និង សម្របសម្រួល បន្ស៊ី នូវ តម្រូវការអភិវឌ្ឍន៍ ទាំងនេះ ជាមួយ គម្រោង និង ធនធាន របស់ ដៃគូ អភិវឌ្ឍន៍ អង្គការ មិន មែន រដ្ឋាភិបាល វិស័យ ឯកជន និង អ្នក ពាក់ព័ន្ធ នានា និង ឈានដល់ ការឆ្លើយតប តម្រូវការ ជាក់ស្ដែង របស់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ប្រកបដោយ ប្រសិទ្ធភាព ។
ក្នុង នោះ សម្រាប់ កម្មវិធី វិនិយោគ បី ឆ្នាំ រំកិល និង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការអនុវត្ត នូវ គោល នយោបាយ កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ស្រប តាម យុទ្ធសាស្ត្រ បច្ចកោណ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ពិសេស នោះ គឺ ធ្វើ ការឆ្លើយតប ទៅនឹង តម្រូវការ ជាក់ស្តែង របស់ បងប្អូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ការបង្ខិត សេវា ឱ្យ ចូល កៀក ទៅ ជិត ប្រជាពលរដ្ឋ និង ចូលរួម លើកកម្ពស់ កម្រិត ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ សំដៅ កាត់បន្ថយ ភាពក្រីក្រ ។
ជា ចុងក្រោយ លោក ធូ ចាន់ ពៅ រំពឹងទុក ថា រដ្ឋបាល ខេត្ត ក្រុង ស្រុក ដែគូ អភិវឌ្ឍន៍ អង្គការ មិន មែន ដ្ឋាភិបាល វិស័យ ឯកជន សប្បុរសជន និង អ្នក ពាក់ព័ន្ធ នានា ដែល ចូលរួម ក្នុង វេទិការពិគ្រោះយោបល់ ថ្ងៃ នេះ បាន យល់ ពី គោលបំណង តម្រូវការ គម្រោង អភិវឌ្ឍន៍ និង លទ្ធភាព ថវិការ ពី គ្នា ទៅ វិញ ទៅមក និង អាច ឈានដល់ មាន ការសម្របសម្រួល គ្នា ដើម្បី អោយ ការវិនិយោគ ក៏ ដូច ការអភិវឌ្ឍន៍ ទៅ តាម មូលដ្ឋាន នានា ប្រព្រឹត្តទៅ ដោយ រលូន មាន សង្គតភាព និង មាន ប្រសិទ្ធភាព ខ្ពស់ ៕
ទីក្រុង បុរាណ និង ផ្ទះសម្បែង រាប់ ពាន់ ខ្នង រង ការជន់ លិច នៅ តំបន់ ភាគ កណ្តាល ប្រទេស វៀតណាម
( ហាណូយ ) ៖ ទីក្រុង Hue ដែល ជា ទីក្រុង បុរាណ របស់ វៀតណាម និង ជា ទីតាំង សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក ដែល ពេញនិយម សម្រាប់ ក្រុម ភ្ញៀវ ទេសចរ បាន ស្ថិត ក្រោម ផ្ទៃ ទឹក នា ថ្ងៃពុធ នេះ បន្ទាប់ពី ការធ្លាក់ ភ្លៀង ខ្លាំង នៅ ភាគ កណ្តាល ប្រទេស វៀតណាម បាន ជន់ លិច លំនៅដ្ឋាន រាប់ ពាន់ ខ្នង និង កាត់ផ្តាច់ កំណាត់ ផ្លូវ ហាយវ៉េ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃពុធ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
រូបភាព ពី ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក វៀតណាម បាន បង្ហាញ ឱ្យ ឃើញ ប្រជាជន វៀតណាម នាំគ្នា ធ្វើដំណើរ ដោយ ជិះ ទូក លើ ដង ផ្លូវ ដែល លិច លង់ ខណៈ ផ្ទះសម្បែង និង រថយន្ត ត្រូវបាន ជន់ លិច ។ អ្នកស្រុក នៅ ទីក្រុង Hue បាន អះអាង ថា ទីក្រុង បុរាណ នេះ រង ការជន់ លិច សឹងតែ នៅ គ្រប់ កន្លែង ហើយ ថាមពល អគ្គិសនី ក៏ ត្រូវបាន កាត់ផ្តាច់ ផងដែរ ។ ភ្លៀង បាន ធ្លាក់ ខ្លាំង ទៅ លើ ខេត្ត មួយចំនួន នៅ ភាគ កណ្តាល ប្រទេស វៀតណាម តាំងតែពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ ។
គួរ បញ្ជាក់ ថា វៀតណាម តែងតែ ទទួលរង ស្ថានភាព អាកាសធាតុ អាក្រក់ ៗ នៅ អំលុង រដូវ ភ្លៀង ចន្លោះ ខែមិថុនា ដល់ ខែវិច្ឆិកា ជារៀងរាល់ ឆ្នាំ ។ យោង តាម ការព្យាករ កម្រិត ទឹកភ្លៀង អាចនឹង ស្ថិត នៅ កម្រិត ខ្ពស់ សម្រាប់ រយៈពេល ប្រហែល២ ថ្ងៃ ទៀត មុន មាន ភាពប្រសើរឡើង នៅ អំលុង ចុង សប្តាហ៍ នេះ ។ យោង តាម តួលេខ ផ្លូវការ គ្រោះ ធម្មជាតិ ដែល រួម មាន ទាំង ទឹក ជំនន់ និង គ្រោះ រអិល បាក់ ដី បាន បង្កឱ្យ មនុស្ស ១៣៦ នាក់ ស្លាប់ ឬ បាត់ខ្លួន នៅ វៀតណាម ក្នុង ឆ្នាំ នេះ ៕
ទីភ្នាក់ងារ កិច្ចសហប្រតិបត្តិការ សន្តិសុខ ការពារ ជាតិ ដែល ស្ថិត ក្រោម ក្រសួង ការពារ ជាតិ អាមេរិក ( មន្ទីរ បញ្ចកោណ ) បាន ប្រកាស ដូច ខាងលើ ហើយ បាន អះអាង ថា ផែនការលក់ មី ស៉ីល នោះ មាន ទំហំ ទឹកប្រាក់ ប្រហែល ៦៥០ លាន ដុល្លារ ។ វា នឹង ត្រូវ ឆ្លងកាត់ ការសម្រេច ចុងក្រោយ របស់ សភា អាមេរិក ។ យោង តាម ទីភ្នាក់ងារ ដដែល រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង បាន ដាក់ សំណើ ទិញ មីស៉ីល SM-6 Block I សរុប ៣៨ គ្រាប់ រួម ជាមួយ សម្ភារ ពាក់ព័ន្ធ ផ្សេង ទៀត ហើយនិង ការជួយ បណ្តុះបណ្តាល ប្រើប្រាស់ ។
ទីភ្នាក់ងារ កិច្ចសហប្រតិបត្តិការ សន្តិសុខ ការពារ ជាតិ អាមេរិក បាន លើកឡើង ថា គម្រោង លក់ មី ស៉ីល ខាងលើ នឹង គាំទ្រ គោលដៅ នៃ គោល នយោបាយ ការបរទេស ក៏ ដូចជា កម្មវត្ថុ នៃ សន្តិសុខ ជាតិ របស់ សហរដ្ឋ អាមេរិក តាមរយៈ ការជួយ ធ្វើឱ្យ ប្រសើរឡើង នូវ សន្តិសុខ របស់ សម្ព័ន្ធមិត្ត ដ៏ សំខាន់ មួយ ដែល ជា តួអង្គ ចម្បង សម្រាប់ ស្ថិរភាព នយោបាយ ព្រមទាំង វឌ្ឍនភាព សេដ្ឋកិច្ច នៅក្នុង តំបន់ ឥណ្ឌូ - ប៉ា ស៉ីហ្វិក ។
ក្នុង ឱកាស ដ៏ មាន តម្លៃ នោះ សម្តេច តេជោ ហ៊ុន សែន រំលេច ពី មេរៀន ដ៏ មាន តម្លៃ បំផុត ចំនួន ៧ ចំណុច ដែល ទទួលបាន ពី ដំណើរតស៊ូ ដើម្បី ការរស់រាន ស្តារ កសាង និង ការពារ មាតុភូមិ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ដូច្នេះ ថា នៅក្នុង ក្របខណ្ឌ នៃ « រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា និង ដំណើរតស៊ូ ជា រួម របស់ យើង ដើម្បី ការរស់រាន ស្តារ កសាង និង ការពារ មាតុភូមិ ចាប់ពី ថ្ងៃ ជ័យជម្នះ ៧ មក រា ១៩៧៩ រហូតមកដល់ បច្ចុប្បន្ន នេះ ដែល មាន រយៈពេល ជាង ៤ទសវត្សរ៍ យើង ទទួលបាន នូវ មេរៀន ដ៏ មាន តម្លៃ មួយចំនួន ដែល មាន សារៈសំខាន់ បំផុត សម្រាប់ ជាតិ យើង គឺ៖
ទី២៖ ប្រជាជន ជា កត្តា កំណត់ ក្នុង ការតស៊ូ រំដោះ ជាតិ ការកសាង ការពារ ប្រទេស និង ជា មូលដ្ឋានគ្រឹះ សម្រាប់ ទ្រទ្រង់ ដល់ ការដឹកនាំ ខាង នយោបាយ ក្នុង សង្គមជាតិ ។ បើ ប្រជាជន មិន យល់ មិន គាំទ្រ មិន ចូលរួម គឺ គ្មាន កិច្ចការ ណា របស់ ជាតិ អាច សម្រេចបាន ឡើយ ។ ដូចនេះ គ្រប់ អង្គការ ចាត់តាំង ទាំងអស់ ត្រូវតែ ប្រកាន់ខ្ជាប់ នូវ ភាពស្មោះត្រង់ និង យក ប្រជាជន ធ្វើជា គោលដៅ នៃ ការបម្រើ របស់ ខ្លួន ។
សម្តេច តេជោ បាន ថ្លែង រំលឹក ថា ស្ថិត ក្នុង កាលៈទេសៈ ដ៏ មហន្តរាយ នៃ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត « រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា » បច្ចុប្បន្ន ឈ្មោះ ថា « រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា » ដែល បាន ដឹកនាំ ដោយ សម្តេច ពញា ចក្រី ហេង សំរិន . សម្តេច ធម្មពោធិសាល ជា ស៊ីម . រូប សម្តេច តេជោ ផ្ទាល់ និង ថ្នាក់ដឹកនាំ ដទៃ ទៀត បាន តស៊ូ រំដោះ ប្រទេសជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា ឱ្យ រស់រាន មាន ជីវិត ឡើងវិញ ។
( កំពត ) ៖ លោក អ៊ំ វិទូ ក្រឡាបញ្ជី នៃ សាលាដំបូង ខេត្ត កំពត បាន ចេញ លិខិត ជូន ដំណឹង ស្ដីពី ការបញ្ជូន តាម ការផ្សាយ ជាសាធារណៈ ដល់ ឈ្មោះ ស៉ឹម វណ្ណះ ភេទ ស្រី អាយុ ៣៩ ឆ្នាំ ជនជាតិ ខ្មែរ ទីលំនៅ បច្ចុប្បន្ន នៅ ភូមិ ព្រៃឈើ ទាល ឃុំ អង្គរ ជ័យ ស្រុក អង្គរ ជ័យ ខេត្ត កំពត ជា ចុងចម្លើយ យក ដីកា កោះ ចុះ ថ្ងៃទី ២៥ ខែតុលា ឆ្នាំ ២០២៣ នៅ សាលាដំបូង ខេត្ត កំពត នា ថ្ងៃទី ០៥ ខែធ្នូ ឆ្នាំ ២០២៣ វេលា ម៉ោង ៩៖០០ នាទី ព្រឹក បន្ទប់ អក្សរ ( គ) ។
មូលហេតុ នេះ ការចេញ ដីកា កោះ នេះ ដើម្បីឲ្យ ចុងចម្លើយ ធ្វើ នីតិវិធី ត្រៀម សម្រាប់ ការទាញ ហេតុផល ដោយ មូលហេតុ ចាំបាច់ និង ជៀសវាង នៅ ការយឺតយ៉ាវ ក្នុង ដំណើរការ នីតិវិធី ៕
ខាងក្រោម នេះ ជា លិខិត ជូន ដំណឹង អញ្ជើញ របស់ តុលាកា រ៖
សេចក្តីសម្រេចចិត្ត របស់ មហាសន្និបាត រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា លើក ទី៦ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣
បន្ទាប់ពី បញ្ចប់ កម្មវិធី អង្គ មហាសន្និបាត រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា លើក ទី៦ បាន ចេញ សេចក្តីសម្រេចចិត្ត ដែល មាន ខ្លឹមសារស្រុង ដូច ខាងក្រោម៖
ការចាប់ផ្តើម នៃ រដូវ វស្សា និង លទ្ធភាព នៃ ការជន់ លិច បាន បង្កើន ការភ័យខ្លាច ការជន់ លិច និង រីករាលដាល ជំងឺ ឆ្លង ។ កាលពី សប្តាហ៍ មុន អង្គការ សុខភាព ពិភពលោក (WHO) បាន ឲ្យដឹង រួចហើយ ថា តំបន់ Gaza ប្រឈម នឹង កើនឡើង នូវ ហានិភ័យ នៃ ការរីករាលដាល ជំងឺ ដោយសារតែ ការទម្លាក់ គ្រាប់បែក របស់ អ៉ី ស្រាអែល រំខាន ដល់ ប្រព័ន្ធ សុខាភិបាល លទ្ធភាព ប្រើប្រាស់ ទឹក ស្អាត និង បណ្តាលឲ្យ មាន មនុស្ស ត្រូវ រស់ នៅ កកកុញ ក្នុង ទី ជម្រក បណ្តោះអាសន្ន ។
( ភ្នំពេញ ) ៖ ដើម្បី ដោះស្រាយ ការលិចលង់ ដោយ ជំនន់ ទឹកភ្លៀង រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឲ្យ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ធ្វើ ផែនការ រួចរាល់ ដើម្បី បង្កើត ជា គម្រោង ធ្វើ យ៉ាងណា ដោះស្រាយ ឲ្យបាន នូវ ការលិចលង់ ដោយ ជំនន់ ទឹកភ្លៀង ដោយ គម្រោង នេះ បាន ការគាំទ្រ ពី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រួចហើយ ដោយ ត្រូវ អនុវត្ត នៅ ឆ្នាំ ២០២៤ ។
នេះ ជា ការបញ្ជាក់ ជូន របស់ លោក កើត ឆែ អភិបាល រង តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅក្នុង កិច្ចប្រជុំ សាមញ្ញា លើក ទី ៥៣ របស់ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ អាណត្តិ ទី៣ នៅ ព្រឹក ថ្ងៃទី ១៥ វិច្ឆិកា នេះ នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម វត្តមាន លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ ។
ទន្ទឹម នេះ កម្មករ ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ត្រី ដែល តែងតែ យកចិត្តទុកដាក់ ចំពោះ កម្មករ ជាក់ស្ដែង ប្រាក់ ឈ្នួល អប្បបរមា ដំឡើង ដល់ ២០៤ ដុល្លារ សម្រាប់ ឆ្នាំ ២០២៤ ។ រាល់ សកម្មភាព របស់ សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្ត្រី ទាំង នៅ វេទិកា ក្រៅ ប្រទេស ក៏ ដូចជា ក្នុង ប្រទេស គឺ ខិតខំ ស្វែងរក អ្នក វិនិយោគទុន ក្នុង គោលដៅ ស្ដារ និង ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ ។
លោក កើត ឆែ ក៏ បាន លើកឡើង ពី ការងារ ចាំបាច់ និង ធំ ៗ មួយចំនួន របស់ រដ្ឋបាល រាជធានី ដែល ត្រូវ អនុវត្ត បន្ទាន់ ៗ ក្នុង នោះ៖
* ទី ១៖ សម្រាប់ ខែ ១១នេះ មាន ការងារ រៀបចំ ពិធី បុណ្យ អុំ ទូក អក អំបុក សំពះ ព្រះខែ ដែល នឹង អាច មាន មនុស្ស ចូលរួម ប្រមាណ ៣លាន នាក់ ក្រោយពី ការអាក់ខាន ច្រើន ឆ្នាំ ដោយសារ ការរាតត្បាត ដោយ ជំងឺ កូវិដ - ១៩ ។
* គម្រោង ស្ថាបនា ស្ពាន ឆ្លងកាត់ ទន្លេ ចន្លោះ ស្ពាន ព្រះមុនីវង្ស និង ស្ពាន ពី ខាង ព្រែក ប្រា ទៅ ចំ ផ្សារ ទំនើប អ៉ី អន៣ ជាមួយនឹង ការស្ថាបនា ស្ពាន កម្ពុជា - កូរ៉េ ផងដែរ ។ គម្រោង ទាំងនេះ គឺ សុទ្ធតែ មាន ផល ប៉ះពាល់ ដែល អាជ្ញាធរ រាជធានី ភ្នំពេញ ត្រូវ ដោះស្រាយ ជាមួយ ប្រជាពលរដ្ឋ ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ រាជធានី ភ្នំពេញ បាន អបអរសាទរ នូវ សមិទ្ធផល ការដាក់ ឱ្យ ប្រើប្រាស់ ស្ពាន បេតុង ខ្សែ កាប តភ្ជាប់ តំបន់ អភិវឌ្ឍ កោះន រា និង តំបន់ អភិវឌ្ឍ កោះ ពេជ្រ ដែល ធ្វើឱ្យ ចរាចរណ៍ លើ ផ្លូវ ជាតិ លេខ ១ ពិសេស លើ ស្ពាន ព្រះមុនីវង្ស មាន ការធូរ ស្រាល ច្រើន មិន មាន ការកកស្ទះ ដូច ពេល មុន ទៀត ទេ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី សិក្សា រៀបចំ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ដោយ ចែក ជា តំបន់ បៃតង តំបន់ អាជីវកម្ម និង តំបន់ កម្សាន្ត ដាច់ ៗ ពី គ្នា (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ណែនាំ ដល់ លោក ឧប នាយក រដ្ឋមន្ត្រី សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ សិក្សា រៀបចំ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ដោយ ចែក ជា តំបន់ បៃតង តំបន់ អាជីវកម្ម និង តំបន់ កម្សាន្ត សប្បាយ ដាច់ ៗ ពី គ្នា ។
សម្តេច ធិបតី ថ្លែង បែប នេះ ពេល អញ្ជើញ សម្ពោធ ប្រើប្រាស់ ជា ផ្លូវការ « ស្ពាន កោះន រា និង ស្ពាន នាគ ភ្លោះ កោះន រា ភ្ជាប់ ពី គម្រោង កោះន រា ទៅកាន់ ផ្លូវ ជាតិ លេខ ១» នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
បើ តាម ប្រសាសន៍ សម្តេច ធិបតី មាន ប្រជាពលរដ្ឋ ជាច្រើន សុខចិត្ត ទិញ ផ្ទះ នៅក្នុង បុរី ដែល មាន តម្លៃ ថ្លៃ ព្រោះ ផ្ទះ នោះ មាន លក្ខណៈ ងាយស្រួល ក្នុង ការរស់នៅ ដូចជា មាន ផ្លូវ ធំ តំបន់ រស់ នៅ បៃតង និង តំបន់ អាជីវកម្ម ដែល នៅ ដាច់ ពី គ្នា ។ សម្តេច ធិបតី ក៏ ចង់ឲ្យ ការអភិវឌ្ឍ ថ្មី និង ការពង្រីក តំបន់ រាជធានី ភ្នំពេញ ត្រូវ គិតគូរ ពី បញ្ហា នេះ ដោយ មិន ត្រូវ ឲ្យ តំបន់ រស់ នៅ របស់ ប្រជាពលរដ្ឋ ឡូក ឡំ នឹង តំបន់ អាជីវកម្ម នោះ ទេ ។
សូម ជម្រាប ថា ជន ដៃ ដល់ ចំនួន ៤នាក់ ដែល បាន ធ្វើ សកម្មភាព បាញ់បោះ សេរី នៅ ផ្ទះ លំហែ លើ ភ្នំ គិរីរម្យ ក្នុង ពិធី ខួបកំណើត នោះ បាន ចូលមក សារភាព កំហុស នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ស្ពឺ ជាមួយ កាំភ្លើង ខ្លី ៣ដើម ។ ជន មេក្លោង ដែល ជា ម្ចាស់ ទីតាំង ឈ្មោះ កង តារាវិឆៃ ហៅ កង ឆាយ កំពុង រត់គេចខ្លួន ហើយ កម្លាំង សមត្ថកិច្ច កំពុង ស្រាវជ្រាវ ដើម្បី ស្វែងយក ចាប់ខ្លួន ផងដែរ ។
ករណី នេះ លោក ឧត្តមសេនីយ៍ ទោ សម សាមួន ស្នងការ នគរបាល ខេត្ត កំពង់ស្ពឺ បាន អះអាង ថា ផ្ទះ លំហែ ដែល កើត ហេតុការណ៍ បាញ់ បោះ សេរី នេះ មិន មែន ជា កម្មសិទ្ធិ របស់ ឈ្មោះ គៀង ចាន់ តួ ដែល ជា កូន របស់ នាយ ឧត្តមសេនីយ៍ គៀន សាវុធ នោះ ទេ ពោល លោក បាន លក់ មក ឲ្យ ឈ្មោះ កង តារាវិឆៃ ហៅ កង ឆាយ ហើយ ។
ឆ្លើយ តាម ការសាកសួរ និង ចម្លើយ សារភាព នៅ ចំពោះមុខ សមត្ថកិច្ច ជន ដៃ ដល់ ទាំង៤នាក់ ខាងលើ បាន សារភាព ថា នៅ ថ្ងៃ កើត ហេតុ ពួកគេ បាញ់ កាំភ្លើង ប្រហែល ជិត ៣០ គ្រាប់ ប៉ុណ្ណោះ ។ ដោយឡែក សម្រាប់ សំបក គ្រាប់ ដែល រកឃើញ នៅ កន្លែង កើត ហេតុ ប្រមាណ ២០០ គ្រាប់ នោះ សមត្ថកិច្ច សន្និដ្ឋាន ជំហ៊ាន ដំបូង ថា កន្លង ទៅ ទីតាំង នេះ ក៏ ធ្លាប់ បាញ់ បោះ សេរី បែប នេះ ដែរ ។
សូម រំលឹក ថា ស្នូរ គ្រាប់ កាំភ្លើង ជាច្រើន គ្រាប់ បាន បន្លឺ ឡើង យ៉ាង កង រំពង នៅ យប់ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដែល ឮ ចេញ ពី ក្នុង ពិធី ខួបកំណើត មួយ ស្ថិត នៅ ចំណុច ផ្ទះ លំហែ ភូមិ ថ្មី ( ចំការតែ ) ឃុំ ចំបក់ ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ ( លើ ខ្នងភ្នំ គិរីរម្យ ) ដែល សមត្ថកិច្ច អះអាង ថា ជា កម្មសិទ្ធិ របស់ ឈ្មោះ ឆាយ ភេទ ប្រុស អាយុ ប្រហែល ២៨ ឆ្នាំ រស់ នៅ រាជធានី ភ្នំពេញ ។
សម្រាប់ ករណី បាញ់ បោះ ដោយ សេរី នេះ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ស្ពឺ លោក ស៊ិន វិរៈ បាន បញ្ជា ឲ្យ សមត្ថកិច្ច បើក ការស្រាវជ្រាវ តាម នីតិវិធី ជាបន្ទាន់ ចំពោះ ជន បង្ក ។ នៅ រសៀល ថ្ងៃ នេះ លោក ព្រះរាជអាជ្ញា បាន ដឹកនាំ កម្លាំង សមត្ថកិច្ច ចំរុះ ចុះ ទៅដល់ កន្លែង កើត ហេតុ ដើម្បី ពិនិត្យ ជាក់ស្តែង និង មាន វិធានការ បន្ត ទៀត ៕ ក្រសួង អប់រំ សេចក្ដីណែនាំ ស្ដីពី ដំណើរការគ្រឹះស្ថាន មធ្យមសិក្សា ចំណេះ ទូទៅ សាធារណៈ ក្នុង ឆ្នាំ សិក្សា ២០២៣ - ២០២៤ ក្នុង ក្របខណ្ឌ ស្តង់ដា សាលារៀន
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីណែនាំ ស្ដីពី ដំណើរការគ្រឹះស្ថាន មធ្យមសិក្សា ចំណេះ ទូទៅ សាធារណៈ ក្នុង ឆ្នាំ សិក្សា ២០២៣ - ២០២៤ ក្នុង ក្របខណ្ឌ ស្តង់ដា សាលារៀន ៕
ការបញ្ជាក់ ឲ្យដឹង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល អ្នក ឧកញ៉ា ពុង ឃាវ សែ អញ្ជើញ ចូលរួម ក្នុង ពិធី សម្ពោធ ប្រើប្រាស់ ជា ផ្លូវការ « ស្ពាន កោះន រា និង ស្ពាន នាគ ភ្លោះ កោះន រា ភ្ជាប់ ពី គម្រោង កោះន រា ទៅកាន់ ផ្លូវ ជាតិ លេខ ១» ក្រោម អធិបតីភាព សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
អ្នក ឧកញ៉ា ពុង ឃាវ សែ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ការចំណាយ របស់ ក្រុមហ៊ុន សម្រាប់ គម្រោង កោះន រា ចាប់ពី ដំបូង រហូតមកដល់ ពេលនេះ ក្រុមហ៊ុន បាន ចំណាយ ជាង ៣០០ លាន ដុល្លារ រួច មកហើយ និង ត្រូវ ចំណាយ ខ្ទង់ រយ លាន ដុល្លារ បន្ថែម ទៀត ដើម្បីឲ្យ គម្រោង ទីក្រុង រណប កោះន រា នេះ អាច បញ្ចប់ ការសាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ទាំងអស់ នៅក្នុង ឆ្នាំ ២០២៥ ខាងមុខ មិន រាប់បញ្ចូល ការសាងសង់ អគារ » ។
បន្ថែម ពី នោះ ទៀត អ្នក ឧកញ៉ា ពុង ឃាវ សែ បាន ឲ្យដឹង ថា តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ អំពី យុទ្ធសាស្ត្រ « យក ស្លឹក ត្នោត ខ្ចប់ ស្ករ ត្នោត » និង « យក ក្រុង ចិញ្ចឹម ក្រុង សាលា រាជធានី ភ្នំពេញ បាន ប្រើប្រាស់ ថវិកា ដែល បាន មកពី ការអភិវឌ្ឍ កោះន រា នេះ មក ធ្វើ ការអភិវឌ្ឍន៍ គម្រោង នានា នៅ រាជធានី ភ្នំពេញ មាន ដូច ជា៖
* សាងសង់ ស្ពាន អាកាស សម្ដេច គង់ សំអុល ចំណុច ប្រសព្វ មហាវិថី សហព័ន្ធ រុស្សី និង ផ្លូវ ២០០៤ * សាងសង់ ស្ពាន អាកាស ព្រះមុនីវង្ស ស្ថិត នៅ ចំណុច ផ្លូវ ប្រសព្វ មហាវិថី សម្តេច តេជោ និង ផ្លូវ ២៧ * សាងសង់ ស្ពាន អាកាស ឫស្សីកែវ ស្រប តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៥ * សាងសង់ ស្ពាន អាកាស បេតុង ខ្សែ កាប ឫស្សីកែវ ប្រវែង ៨០០ ម៉ែត្រ ។
អ្នក ឧកញ៉ា ពុង ឃាវ សែ ក៏ បាន ឲ្យដឹង ផងដែរ ថា ក្នុង អំឡុង ពេល ដ៏ មមាញឹក ខ្លាំង នេះ ទីក្រុង រណប កោះន រា បាន បង្កើន កន្លែង ការងារ ដល់ ប្រជាពលរដ្ឋ យ៉ាង ច្រើន ដូច ជា៖
ក្រសួង ព័ត៌មាន និង ប្រពន្ធ័ ផ្សព្វផ្សាយ របស់ ចិន ពង្រឹង ពង្រីក កិច្ចសហប្រតិបត្តិការ កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ស្រប តាម ទំនាក់ទំនង ពី « មិត្ត ដែក ថែប មក មិត្ត ត្បូង ពេជ្រ »
( ភ្នំពេញ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ គណៈប្រតិភូ ប្រពន្ធ័ ផ្សព្វផ្សាយ CMG ប្រទេស ចិន ដឹកនាំ ដោយ អ្នកនាង Xu Xiaoxia អនុប្រធាន ផ្នែក ភាសា ខ្មែរ នៃ មជ្ឈមណ្ឌល កម្មវិធី ភាសា តំបន់ អាស៊ី និង អាហ្វ្រិក នៃ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នាទី ស្តីការ ក្រសួង ព៏ត៌មាន ។
កិច្ចពិភាក្សា បាន ផ្តោត ជា សំខាន់ កិច្ចសហប្រតិបត្តិការ រវាង វិទ្យុ មិត្តភាព ចិន - កម្ពុជា ជាមួយ ក្រសួង ព័ត៌មាន កម្ពុជា ដែល មាន កន្លងមក ហើយ បន្ត ទៅ មុខ បន្ថែម ទៀត ។
រដ្ឋមន្រ្តី នេត្រ ភក្ត្រា ក្នុង នាម ក្រសួង ព័ត៌មាន កម្ពុជា បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល និង ប្រជាជន ចិន ពិសេស CGTN ដែល បាន ធ្វើ កិច្ចសហប្រតិបត្តិការ ជាមួយ វិទ្យុជាតិ កម្ពុជា និង ក្រសួង ព័ត៌មាន ដែល កិច្ចការងារ នេះ គឺ មាន សារៈសំខាន់ ក្នុង ការបង្កើត នូវ ខ្លឹមសារ សម្រាប់ ផ្សព្វផ្សាយ ដល់ ប្រជាជន កម្ពុជា ។
ពិសេស ជាង នេះ ការផ្សាយ ជា ភាសា ចិន តាមរយៈ វិទ្យុ មិត្តភាព កម្ពុជា - ចិន បាន ផ្តល់ ឱកាស ច្រើន ដល់ ប្រជាជន កម្ពុជា ដែល រៀន ភាសា ចិន អាច ស្តាប់ ព័ត៌ម មាន ជា ភាសា ចិន បាន ។ ទន្ទឹម នេះ អ្នកវិនិយោគិន និង អ្នកទេសចរ ចិន ដែល បាន មក រក សុី និង ដើរលេង កំសាន្ត គឺ អាច ទទួលបាន ព័ត៌មាន សំខាន់ ៗ ពី ការផ្សាយ របស់ វិទ្យ មិត្តភាព កម្ពុជា - ចិន ។
លោក រដ្ឋមន្រ្តី បាន គួស បញ្ជាក់ ពី ការយកចិត្តទុកដាក់ ក្នុង ផ្សព្វផ្សាយ ព័ត៌មាន ដែល មាន សារៈសំខាន់ ដោយ ត្រូវ ធើ្វ យ៉ាងណា ឲ្យ ការផ្សាយ ជា ភាសា ចិន ផ្តោត លើ ព័ត៌មាន នៅក្នុង ប្រទេស កម្ពុជា ដើម្បី អោយ បងប្អូន ជនជាតិ ស្តាប់ បាន យល់ គ្នា ទៅ វិញទៅ មក ពី ប្រពៃណី ទំនៀមទំលាប់ និង ការស់ នៅ ប្រចាំ ថ្ងៃ ។ ជាមួយគ្នា នេះ វិទ្យុ មិត្តភាព កម្ពុជា - ចិន បាន ផ្សព្វផ្សាយ អំពី វប្បធម៌ ប្រពៃណី ទំនៀប ទំលាប់ និង វិស័យ ទេសចរណ៍ និង ភាសា ខ្មែរ ទៅដល់ ប្រជាជន ចិន បាន ដឹង បាន ឃើញ ច្បាស់ ពី ប្រទេស កម្ពុជា ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ លោក រដ្ឋមន្រ្តី បាន ស្នើ ដល់ ភាគី ចិន ជួយ លើ ផ្នែក បច្ចេកទេស និង ឧបករណ៍ ដើម្បី សម្រួល ដល់ ការផ្សព្វផ្សាយ ក៏ ដូចជា ស្នើ ខាង ចិន ឲ្យ ផ្សព្វផ្សាយ ពី បរិបទ នៃ ការរស់នៅ របស់ កម្ពុជា . ប្រពៃណី វប្បធម៌ សម្បត្តិ ធម្មជាតិ នៃ កម្ពុជា បាន ច្រើន ទៅ ប្រជាជន ចិន បាន ដឹង ស៊ីជម្រៅ បន្ថែម ទៀត ។
( វ៉ាស៉ីន តោន ) ៖ បន្ទាប់ពី កិច្ចប្រជុំ ដើម្បី ស្វែងរក ចំណុច រួម មួយ មុនពេល សន្និសីទ ស្តីពី អាកាសធាតុ (COP28) មកដល់ សហរដ្ឋ អាមេរិក និង ចិន បាន បញ្ជាក់ ក្នុង សេចក្តីថ្លែងការណ៍ រួម នៅ ថ្ងៃពុធ នេះ ថា នឹង គាំទ្រ គោលដៅ ថាមពល កកើត ឡើងវិញ ជា សកល ហើយ យល់ព្រម ធ្វើ ការរួមគ្នា លើ បញ្ហា នៃ ការបំពុល អាកាសធាតុ ដោយ មេតាន និង ប្លាស្ទិក ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃពុធ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
លោក វរសេនីយ៍ ទោ ម៉ម សាវន បាន បញ្ជាក់ នៅក្នុង របាយការណ៍ ទៀត ថា ចំពោះ ការស្រាវជ្រាវ និង ឈានដល់ ការឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ហើយ រកឃើញ ធ្លាប់ ប្រព្រឹត្ត បទល្មើស ឆក់់ ៤ករណី នេះ ដែរ គឺ បាន អនុវត្ត ឡើង ស្ថិត នៅ ចំណុច ក្បែរ ហាង កាហ្វេ មួយ កន្លែង ក្នុង ភូមិ ទ្រា សង្កាត់ ស្ទឹងមានជ័យ១ ខណ្ឌ មានជ័យ វេលា ម៉ោង ១៧៖៣០ នាទី ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
លោក បាន ឲ្យដឹង ថា ក្រោយ ឃាត់ខ្លួន ជនសង្ស័យ ឈ្មោះ ខេ សុបញ្ញា ហៅ កន អាយុ ១៨ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ស្នាក់ នៅ ផ្ទះ លេខ ៤២ ផ្លូវ លំ ភូមិ ឬ ស្សី សង្កាត់ ស្ទឹងមានជ័យ១ ខណ្ឌ មានជ័យ ហើយ ធ្វើ ការស្រាវជ្រាវ សាកសួរ យ៉ាង យកចិត្តទុកដាក់ គឺ ជនសង្ស័យ បាន ឆ្លើយ សារភាព ប្រាប់ សមត្ថកិច្ច ថា កន្លងមក ធ្លាប់់ បាន ប្រព្រឹត្ត បទល្មើស ឆក់ ៤ករណី មក ហើយ រួម មាន៖
រដ្ឋមន្រ្តី ក្រសួង ធនធា ធម្មជាតិ រុស្ស៉ី ទៅ បំពេញ ទស្សនកិច្ច នៅ កូរ៉េ ខាងជើង ចំពេល មាន របាយការណ៍ នៃ ការអភិវឌ្ឍ កម្មវិធី មីស៉ីល
KCNA រាយការណ៍ ថា រុស្ស៉ី ចង់ អភិវឌ្ឍ « កិច្ចសហប្រតិបត្តិការ ជាច្រើន វិស័យ » ជាមួយ កូរ៉េ ខាងជើង ដោយ ផ្អែក តាម កិច្ចព្រមព្រៀង រវាង លោក ប្រធានាធិបតី វ្ល៉ាឌីមៀ ពូទីន និង ប្រធានាធិបតី កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន នៅពេល ជួបគ្នា កាលពី ខែកញ្ញា លើ ទឹកដី រុស្ស៉ី ។
KCNA ក៏ បាន រាយការណ៍ នៅ ថ្ងៃពុធ នេះ ដែរ ថា កូរ៉េ ខាងជើង បាន អភិវឌ្ឍ និង ធ្វើតេស្ត ប្រកបដោយ ជោគជ័យ លើ « ម៉ាស៊ីន ដំណើរការ ដោយ ឥន្ធនៈ រឹង ស៊េរី ថ្មី មួយ » សម្រាប់ មីស៊ីល បាលិស្ទី គរយៈ ចម្ងាយ មធ្យម ។ ចំណែក ទីភ្នាក់ងារ ស៉ើបការណ៍ សម្ងាត់ កូរ៉េ ខាងត្បូង បាន ឲ្យដឹង នៅក្នុង ខែវិច្ឆិកា នេះ ថា កូរ៉េ ខាងជើង កំពុង ស្ថិត ក្នុង ដំណាក់កាល ចុងក្រោយ នៃ ការរៀបចំ សម្រាប់ ការបាញ់ បង្ហោះ ផ្កាយ រណប ចារកម្ម ហើយ ហាក់ដូចជា បាន ទទួល ជំនួយ បច្ចេកទេស ពី រុស្ស៉ី ។
ថ្លែង បើក កិច្ចប្រជុំ លោក ប្រាបូវូ ស៊ូប៊ីន តូ រដ្ឋមន្រ្តី ការពារ ជាតិ ឥណ្ឌូនេស៊ី បាន សម្តែង ការអបអរសាទរ និង ថ្លែងអំណរគុណ ដល់ ប្រទេស កម្ពុជា ដែល បាន ធ្វើជា ម្ចាស់ ផ្ទះ ទទួលបាន ជោគជ័យ ក្នុង ការរៀបចំ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១៦ កាលពី ឆ្នាំ ២០២២ កន្លងមក ហើយ តាមរយៈ កិច្ចប្រជុំ នៅ កម្ពុជា ប្រទេស ឥណ្ឌូនេស៊ី បាន ប្តេជ្ញាចិត្ត បន្ត នូវ លទ្ធផល ដែល កម្ពុជា សម្រេចបាន ។
លោក រដ្ឋមន្រ្តី ការពារ ជាតិ ឥណ្ឌូនេស៊ី បាន បញ្ជាក់ បន្ថែម ថា កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១៧ ឆ្នាំ ២០២៣ បន្ត ស្វែងរក នូវ ការបង្កើន និង ពង្រឹង និមាបនកម្ម សន្តិសុខ ក៏ ដូចជា ការជំរុញ ឲ្យ មាន បរិយាប័ន នៅលើ ពិភពលោក ។ លោក បាន អំពាវនាវ ដល់ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី១៧ ធ្វើ ការពិក្សា គ្នា ដើម្បី ស្វែងរក នូវ យន្តការ ផ្សេង ៗ ក្នុង ការដោះស្រាវ បញ្ហា ផ្សេង ៗ ដូចជា បញ្ហា នៅក្នុង តំបន់ ។
កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការពារ ជាតិ អាស៊ាន លើក ទី ១៧ ឆ្នាំ ២០២៣ នៅ ប្រទេស ឥណ្ឌូនេស៊ី បាន ប្រព្រឹត្តិ ទៅ ក្រោម មូល បទ « សន្តិភាព វិបុលភាព និង សន្តិសុខ » ដោយ ផ្តោត លើ កិច្ចពិភាក្សា ស្តីពី ការបង្កើន កិច្ចសហប្រតិបត្តិការ ការពារ ជាតិ ការពង្រឹង ជំនឿ ទុកចិត្ត និង ការលើកកម្ពស់ សមត្ថភាព និង ភាពធន់ របស់ តំបន់ ដើម្បី ដោះស្រាយ បញ្ហា ប្រឈម ផ្នែក សន្តិសុខ ។ រដ្ឋមន្រ្តី ការពារ ជាតិ អាស៊ាន បាន ធ្វើ ការពិភាក្សា ផ្លាស់ប្តូរ ទស្សនៈ គ្នា លើ បញ្ហា ក្នុង តំបន់ និង អន្តរជាតិ ដែល ជា ក្តីបារម្ភ និង ផលប្រយោជន៍ រួម ។
សូម បញ្ជាក់ ថា កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការពារ ជាតិ អាស៊ាន លើក ទី១៧ នៅ ប្រទេស ឥណ្ឌូនេស៊ី ក៏ មាន ការអញ្ជើញ ចូលរួម ពី រដ្ឋមន្ត្រី ការពារ ជាតិ ប្រទេស ទីម័រ ខាងកើត ដែល បាន ចូលរួម ប្រជុំ ក្នុង នាម ជា អ្នកសង្កេតការណ៍ ៕
កឋិន សាមគ្គី រដ្ឋបាល ខេត្ត ក្រចេះ នឹង ដង្ហែរ ទៅ ប្រគេន ព្រះសង្ឃ ចំនួន ២វត្ត ប្រមូល បាន បច្ច័យ បាន ៦៣. ៦៧៤.០០០ រៀល និង ២៦២៥ ដុល្លារ
( ក្រចេះ ) ៖ រដ្ឋបាល ខេត្ត ក្រចេះ ដែល ផ្តួចផ្តើម ដោយ លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ និង លោក ហឿ ស៊ីយ៉ែម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន រៀបចំ និមន្ត ព្រះសង្ឃ ន មស្ការ ព្រះរតនត្រ័យ ចម្រើន ព្រះបរិត្ត និង សម្ដែង ព្រះធម៌ ទេសនា ក្នុង ពិធី បុណ្យ ក ឋិន ទាន រស្មី សាមគ្គី ដើម្បី ដង្ហែ វេរ ប្រគេន ដល់ ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា អស់ ត្រី មាស ។
ក្នុង ពិធី នេះ ដែរ ដោយ មាន ការចូលរួម យ៉ាង ច្រើន កុះករ ពីសំណាក់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត មន្ត្រីរាជការ ក្រុង ស្រុក និង ប្រជាពុទ្ធ បរិស័ទ ជិត ឆ្ងាយ ផងដែរ ។
តាម ប្រពៃណី និង ទំនៀមទម្លាប់ បុណ្យ ក ឋិន ទាន គឺជា ពិធី បុណ្យ ប្រពៃណី ព្រះពុទ្ធ សាសនា មួយ ដែល ប្រជាជន ខ្មែរ ចាប់ផ្ដើម ធ្វើ បន្ទាប់ពី បុណ្យ ចេញ ព្រះវស្សា ។ បុណ្យ ក ឋិន តែង ត្រូវបាន ដង្ហែ ចូល គ្រប់ ទី អារាម ទាំងអស់ ចាប់ពី ថ្ងៃ ១រោច ខែ អស្សុជ ដល់ ថ្ងៃទី ១៥ កើត ខែកត្តិក គឺ ពុំ មាន វត្ដ ណាមួយ ត្រូវបាន ខកខាន ឡើយ ។
ពិធី ហែ អង្គក ឋិន ទៅកាន់ ទី អារាម នីមួយ ៗ គេ រៀបចំ ធ្វើឡើង យ៉ាង អធិកអធម្មសប្បាយរីករាយ យ៉ាង ក្រៃលែង ហើយ អ្នក ផ្ដើម បុណ្យ តែង រៀបចំ បរិក្ខាក ឋិន មាន ត្រៃ ចីវរ ស្បង់ និង ទេយ្យ ទាន ផ្សេង ៗ ទៀត ដូចជា បាត ចាន ស្រាក់ កាំបិត ចេស ម្ជុល ថង់ យាម និង ឆ័ត្រ ជាដើម រួច គេ នាំគ្នា ហែ ទៅ ទី អារាម ដែល បាន កំណត់ ទុក ។
( ជាំង ស៊ូ . ចិន ) ៖ រសៀល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ លោក គួច ចំរើន អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ បាន អញ្ជើញ ដឹកនាំ ប្រតិភូ ខេត្ត ព្រះសីហនុ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ លោក ស៊ី ឃុន លីន អភិបាល ខេត្ត ជាំង ស៊ូ សម្រាប់ ដំណើរទស្សនកិច្ច របស់ លោក កាន់ ទៅ ទីនោះ ។
លោក ស៊ី ឃុន លីន អភិបាល ខេត្ត ជាំង ស៊ូ បាន ថ្លែង ការស្វាគមន៍ ដ៏ កក់ក្តៅ ចំពោះ លោក គួច ចំរើន និង គណៈប្រតិភូ ខេត្ត ព្រះសីហនុ ទាំងអស់ ដែល អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ ខេត្ត ជាំង ស៊ូ នា ពេលនេះ ។
បន្ទាប់ពី បាន ណែនាំ យ៉ាង ខ្លី អំពី ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង សង្គម នៃ ខេត្ត ជាំង ស៊ូ លោក ស៊ី ឃុន លីន បាន បញ្ជាក់ ថា សាធារណរដ្ឋ ប្រជាមានិត ចិន និង ព្រះរាជាណាចក្រ កម្ពុជា មាន ទំនាក់ទំនង មិត្តភាព ជា ប្រពៃណី យ៉ាង ជ្រាលជ្រៅ ហើយ ការឯកភាព ដ៏ សំខាន់ ដែល សម្រេចបាន ដោយ មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ បាន ចង្អុលបង្ហាញ ទិសដៅ សម្រាប់ កិច្ចសហប្រតិបត្តិការ ក្នុង តំបន់ ឱ្យ កាន់តែ ស៊ីជម្រៅ ។
លោក ស៊ី ឃុន លីន បាន ចាត់ទុក ថា ខេត្ត ព្រះសីហនុ ជា ច្រក ដ៏ សំខាន់ សម្រាប់ កម្ពុជា ក្នុង ការបើកចំហរ ទៅកាន់ ពិភព ខាងក្រៅ ហើយ ខេត្ត ព្រះសីហនុ គឺជា ខេត្ត មិត្តភាព របស់ ខេត្ត ជាំង ស៊ូ និង ជា ដៃគូ ដ៏ សំខាន់ សម្រាប់ ខេត្ត ជំាង ស៊ូ ក្នុង ការចូលរួម ក្នុង ការកសាង រួមគ្នា នៃ « ខ្សែក្រវាត់ និង ផ្លូវ » ហើយ កិច្ចសហប្រតិបត្តិការ រវាង ខេត្ត ទាំង ពីរ សម្រេចបាន លទ្ធផល ជា ផ្លែ ផ្កា និង បន្ត ខ្លាំងក្លាត ទៅ មុខ ទៀត ។
លោក គួច ចំរើន បាន ថ្លែងអំណរគុណ ដល់ លោក ស៊ី ឃុន លីន អភិបាល ខេត្ត ជាំង ស៊ូ សម្រាប់ ការគាំទ្រ ដល់ ការអភិវឌ្ឍន៍ ខេត្ត ព្រះសីហនុ កន្លងមក ជាពិសេស គាំទ្រ ដល់ តំបន់ សេដ្ឋកិច្ច ពិសេស ក្រុង ព្រះសីហនុ ។
លោក បាន មានប្រសាសន៍ ថា ខេត្ត ព្រះសីហនុ គឺជា ចំណុច សំខាន់ នៃ « គំនិត ផ្តួចផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ » ហើយ ការសាងសង់ តំបន់ សេដ្ឋកិច្ច ពិសេស ក្រុង ព្រះសីហនុ បាន ទទួល ការយកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ពី ថ្នាក់ដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ហើយ បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច របស់ កម្ពុជា ។
លោក គួច ចំរើន សង្ឃឹម ថា ខេត្ត ទាំង ពីរ នឹង សហការ គ្នា យ៉ាង ជិតស្និទ្ធ លើ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង មនុស្សធម៌ ហើយ សហគ្រាស ខេត្ត ជាំង ស៊ូ កាន់តែ ច្រើន នឹង មក បណ្តាក់ទុន នៅ ខេត្ត ព្រះសីហនុ ដើម្បី សម្រេចបាន នូវ វិបុលភាព រួម និង ផ្តល់ ប្រយោជន៍ ដល់ ប្រជាជន នៃ ខេត្ត ទាំង ពីរ ។
ក្នុង ឱកាស នោះ អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ ក៏ បាន ស្នើ អភិបាល ខេត្ត ជាំង ស៊ូ ជួយ គាំទ្រ ការបើក ដំណើរការ នូវ ការហោះហើរ ត្រង់ ពី ទីក្រុង អ៊ូ ស៊ី មក ខេត្ត ព្រះសីហនុ ឡើងវិញ បន្ទាប់ពី ខកខាន មួយ រយៈពេល ដោយសារ កូវី ដ និង ជួយ ជម្រុញ អ្នក វិនិយោគទុន ខេត្ត ជាំង ស៊ូ មក បណ្តាក់ទុន នៅក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស ក្រុង ព្រះសីហនុ ឱ្យ បាន កាន់តែ ច្រើន ថែម ទៀត ។
លោក ស៊ី ឃុន លីន បាន ទទួលយក និង គាំទ្រ សំណើ របស់ លោក គួច ចំរើន និង បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ ខេត្ត ក្រុង បងប្អូន ខេត្ត ព្រះសីហនុ - ជាំង ស៊ូ និង ក្រុង ព្រះសីហនុ - អ៊ូ ស៊ី លើ វិស័យ សេដ្ឋកិច្ច ឧស្សាហកម្ម ពាណិជ្ជកម្ម ការវិនិយោគ ទេសចរណ៍ និង វប្បធម៌ ៕ រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី ជំរុញ មន្រ្តី ជំនាញ ខេត្ត កណ្ដាល ចុះបញ្ជី ដីធ្លី ក្នុង ភូមិសាស្ត្រ របស់ ខ្លួន ឲ្យបាន លឿន តាម ផែនការ
( កណ្ដាល ) ៖ លោក សាយ សំអាល់ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន ជំរុញ មន្រ្តី ជំនាញ ខេត្ត កណ្ដាល ចុះបញ្ជី ដីធ្លី ក្នុង ភូមិសាស្ត្រ របស់ ខ្លួន ឲ្យបាន លឿន តាម ផែនការ ពោលគឺ សម្រច ឲ្យ ខាន តែ បាន នៅ បំណាច់ ឆ្នាំ ២០២៤ ។
ថ្លែង នៅក្នុង កិច្ចប្រជុំ ពិភាក្សា លើ ការរៀបចំ ចុះបញ្ជី ដីធ្លី ក្នុង ភូមិសាស្ត្រ ខេត្ត កណ្ដាល នា រសៀល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ លោក ឧប នាយក រដ្ឋមន្ត្រី សង្កត់ធ្ងន់ ថា « មន្ត្រី យើង ត្រូវ ចុះបញ្ជី ដីធ្លីបង្ហើយ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ឆាប់ ដែល នេះ គឺជា កិច្ចការ ដែល ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន និង កំពុង ជំរុញ ដើម្បី ឆ្លើយតប ទៅនឹង គោល នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី មួយ នេះ » ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន ជំរុញ ដល់ សាខា ពន្ធដារ ខេត្ត កណ្ដាល ដែល មាន លោក ងួន សុវណ្ណ ជា ប្រធាន ត្រូវ រួមគ្នា ជួយ ពន្លឿន ការងារ បង់ ពន្ធ សូន្យ របស់ ពលរដ្ឋ ឲ្យបាន លឿន រហ័ស និង រលូន ផងដែរ ដើម្បី ងាយស្រួល ដល់ ដំណើរ ចេញ បណ្ណ កម្មសិទ្ធិ ដល់ ពលរដ្ឋ ។
លោក បញ្ជាក់ ថា ទូទាំង ប្រទេស កម្ពុជា ក្បាល ដី ជាង ៥លាន នឹង ត្រូវ ធ្វើ បណ្ណ ដូច្នេះ សូម មន្ត្រី យើង ដែល ពាក់ព័ន្ធ ទាំងអស់ គ្នា មេត្តា ផ្ដល់ សេវា គាប់ ចិត្ត ដើម្បី បញ្ឈប់ វិវាទ ប្រែក្លាយ រឿង នេះ ឲ្យ មាន ការ ទុកចិត្ត លើ រដ្ឋបាល ខេត្ត ស្រុក ឃុំ ភូមិ តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្រ្តី ។
ស្ថិត ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន ប្រគល់ ជូន ឧបករណ៍ បច្ចេកទេស និង សម្ភារ ការិយាល័យ មួយចំនួន សម្រាប់ ការងារ ចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ក្នុង ជូន ដល់ មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត កណ្ដាល ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត ក៏ បាន ដាក់ចេញ យុទ្ធនាការ ផ្តល់ បណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ដែល ជា ប្រភេទ អចលន ទ្រព្យ អំណោយ ផ្ដាច់ ឬ ពន្ធ សូន្យ ចាប់តាំងពី ខែមេសា ឆ្នាំ ២០២៣ មក ទល់ នឹង ខែវិច្ឆិកា ឆ្នាំ ២០២៣ គឺ បាន វាស់វែង ក្បាល ដី បំពេញ នីតិវិធី ទាំង នៅ សុរិយោដី និង ពន្ធដារ រួចរាល់ និង បាន ប្រគល់ បណ្ណ កម្មសិទ្ធិ ជូន ដល់ ប្រជាពលរដ្ឋ សរុប ចំនួន ២៨. ៥៨៤បណ្ណ ៕ អគ្គ នាយកដ្ឋាន គយ ចេញ សេចក្ដីបំភ្លឺ ស្ដីពី ការចាប់ ឃាត់ ទំនិញ ដែល កំពុង រក្សាទុក នៅ សាខា គយ និង រដ្ឋាករ ខេត្ត តាកែវ
ក្នុង ន័យ នេះ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា មាន កិត្តិយស សូម ជម្រាប ជូន សាធារណជន បាន ជ្រាប ថា ទំនិញ ដែល ត្រូវបាន ចុះ ពិនិត្យ អនុលោម ភាព ( តាមរយៈ ការអនុវត្ត យន្តការ កណ្តាល ទី ) រួច បាន ចាប់ ឃាត់ និង រក្សាទុក នៅ សាខា គយ និង រដ្ឋាករ ខេត្ត តាកែវ គីជា ទំនិញ លួច នាំចូល តាម ច្រក របៀង នានា តាម ( រថយន្ត សាំ យ៉ុង ) និង ព្រំដែន ជាប់ ប្រទេស វៀតណាម យកមក ប្រមូលផ្ដុំ ដាក់ ចូល ក្នុង រថយន្ត ដឹក អ្នកដំណើរ រថយន្ត ដឹក ទំនិញ ផ្សេង ទៀត ដែល ពុំ មាន បង្កាន់ដៃ ពន្ធ និង អាករ នាំចូល និង ឯកសារ ពាក់ព័ន្ធ ឡើយ ។
បន្ថែម លើ នេះ ទំនិញ ទាំងនោះ មាន មួយចំនួន ជា ទំនិញ ជាប់ កម្រិត កំណត់ ដែល តម្រូវឲ្យ មាន លិខិត អនុញ្ញាត ឬ អាជ្ញាប័ណ្ណ ពី ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ មុននឹង អាច ធ្វើ ការនាំចូល ( តាម អនុក្រឹត្យ លេខ ១៧ អន ក្រ. បក ចុះ ថ្ងៃទី ២៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ ) និង ទំនិញ មួយចំនួន ទៀត ត្រូវបាន ដុត បំផ្លាញ ចោល ( សាច់ និង គ្រឿង សមុទ្រ បង្កក ខូច គុណភាព ) ។
ដោយឡែក ការគណនា ប្រាក់ ពន្ធ និង អាករ នាំចូល ត្រូវ អនុវត្ត តាម តម្លៃ ទិញ - លក់ ពិត និង អាត្រា ពន្ធ តាម យថា ប្រភេទ ទំនិញ ដែល មាន ចែង ក្នុង តារាង ពន្ធ គយ កម្ពុជា ជាធរមាន ហើយ ពុំ មាន មន្ត្រី គយ និង រដ្ឋាករ ណា ម្នាក់ មាន សិទ្ធិ សម្រេច លើ ការដំឡើង ឬ ការបន្ធូរបន្ថយ ប្រាក់ ពន្ធ និង អាក ដូច ការលើកឡើង និង ការចោទប្រកាន់ ដោយ គ្មាន មូលដ្ឋាន ត្រឹមត្រូវ របស់ អាជីវករ និង បណ្ដា សារព័ត៌មាន ទាំងនោះ ឡើយ ៕
ខាងក្រោម នេះ ជា សេចក្ដីបំភ្លឺ របស់ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖ សមាគម ជនជាតិ ជប៉ុន នៅ កម្ពុជា រៀបចំ ពិធី បុណ្យ របាំ ប្រពៃណី ខ្លួន ដើម្បី អបអរ ខួប លើក ទី៧០ នៃ ការបង្កើត ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ
ជាមួយគ្នា នោះ លោក សោម រតនា បាន លើកឡើង ថា « ឆ្នាំ នេះ យើង មាន កិត្តិយស រៀបចំ បុណ្យ បុន អូដូរី ឡើងវិញ បន្ទាប់ពី ខកខាន ប៉ុន្មាន ឆ្នាំ ដោយសារ ជំងឺ រាតត្បាត ជំងឺ កូវីដ - ១៩ ។ ក្រោយពី ជោគជ័យ លើ ការទប់ស្កាត់ និង សម្រេចបាន ការចាក់ វ៉ាក់សាំង ទូទាំង ផ្ទៃ ប្រទេស ពីសំណាក់ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា វិធានការ ការពារ នានា ពីសំណាក់ ក្រសួង សុខាភិបាល ដែល បងប្អូន ប្រជាពលរដ្ឋ បាន អនុវត្ត យ៉ាង ខ្ជាប់ខ្ជួន ទើប យើង អាច ចៀស ផុត ពី ជំងឺ រាតត្បាត និង ប្រារព្ធ ការជួបជុំ ឡើងវិញ បាន ដូច ពេលនេះ » ។
អនុ រដ្ឋលេខាធិការ ក្រសួង អប់រំ ដដែល បន្ដ ថា ពិធី បុណ្យ នេះ គឺជា ព្រឹត្តិការណ៍ មួយ ដែល ប្រារព្ធ រៀបចំឡើង ដើម្បី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៧០ នៃ ការបង្កើត ទំនាក់ទំនង កម្ពុជា ជប៉ុន ហើយក៏ ជា ឱកាស ដ៏ ពិសេស មួយ ដើម្បី ផ្លាស់ប្ដូរ បទពិសោធន៍ ដ៏ ល្អ ផូរផង់ រវាង កម្ពុជា - ជប៉ុន និង ជា ផ្នែក មួយ យ៉ាង សំខាន់ ក្នុង ការពង្រឹង ចំណង មិត្តភាព ប្រទេស ទាំង ពីរ ផងដែរ ៕
សម្ដេច តេជោ ហ៊ុន សែន ផ្ដល់ អនុសាសន៍ បន្ថែម ដល់ មហាសន្និបាត រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា ដើម្បី សម្រេច ជោគជ័យ ក្នុង ដំណាក់កាល ថ្មី (Video inside) ( ភ្នំពេញ ) ៖ អនុសាសន៍ បន្ថែម ចំនួន ៧ ចំណុច ត្រូវបាន ដាក់ចេញ ដោយ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ពិធី បិទ មហាសន្និបាត រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា លើក ទី៦ នៅ ព្រឹក ថ្ងៃតី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ដើម្បី សម្រេចបាន សមិទ្ធផល ជោគជ័យ ថ្មី ៗ បន្ថែម ទៀត ក្នុង ដំណាក់កាល ថ្មី នេះ ។
អនុសាសន៍ ដែល សម្ដេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ ដើម្បីឲ្យ រណសិរ្ស គ្រប់ ថ្នាក់ គប្បី យកចិត្តទុកដាក់ អនុវត្ត ប្រែក្លាយ សេចក្តីសម្រេចចិត្ត នៃ អង្គ មហាសន្និបាត នា ថ្ងៃ នេះ ឲ្យ ក្លាយជា សកម្មភាព ជាក់ស្ដែង រួម មាន៖
* ទី១៖ បន្ត ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី ថែរក្សា សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សុខដុម នៃ សង្គម និង ការពារ ដាច់ខាត នូវ ឯករាជ្យ អធិបតេយ្យភាព និង បូរណភាព ទឹកដី ។
* ទី២៖ រណសិរ្ស គ្រប់ ថ្នាក់ ត្រូវ ពង្រឹង និង ពង្រីក រចនាសម្ព័ន្ធ ចាត់តាំង រណសិរ្ស បង្កើន សមត្ថភាព គ្រប់គ្រង និង ដឹកនាំ ការងារ ស្វែងរក ប្រភព គាំទ្រ ឲ្យបាន កាន់តែ ច្រើន ឡើង ដើម្បី ធានា និរន្តរភាព និង វឌ្ឍនភាព នៃ បេសកកម្ម រចនាសម្ព័ន្ធ និង បុព្វហេតុ របស់ រណសិរ្ស ។
* ទី៣៖ រណសិរ្ស គ្រប់ ថ្នាក់ ត្រូវ បន្ត អប់រំ បំផុស ចលនា បញ្ជ្រាប ការយល់ដឹង អំពី គោល នយោបាយ នានា របស់ រាជ រដ្ឋាភិបាល ឲ្យបាន ជ្រួតជ្រាប ទូលំទូលាយ ក្នុង សង្គម និង ការប្រមូលផ្ដុំ កម្លាំង មហាជន ពី គ្រប់ ស្រទាប់ គ្រប់ មជ្ឈដ្ឋាន ដើម្បី ចូលរួម គាំទ្រ និង អនុវត្ត គោលការណ៍ និង គោល នយោបាយ ទាំងនោះ សំដៅ ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេចបាន ចក្ខុវិស័យ នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម របស់ កម្ពុជា ជាពិសេស ជា ប្រទេស ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស អភិវឌ្ឍន៍ នៅ ឆ្នាំ ២០៥០ ។
* ទី ៤៖ ចូលរួម ក្នុង ការតស៊ូ ប្តូរផ្តាច់ ក្នុង ការទប់ស្កាត់ នូវ រាល់ ឧបាយកល និង សកម្មភាព បំបែកបំបាក់ សាមគ្គី ជាតិ របស់ ក្រុម ប្រឆាំង មជ្ឈដ្ឋាន អមិត្ត ទាំង ក្នុង និង ក្រៅ ប្រទេស ដែល ប៉ុនប៉ង អូសទាញ មហាជន ប្រជាជន ឲ្យ ប្រឆាំង ចំពោះ បុព្វហេតុ កសាង និង អភិវឌ្ឍន៍ ជាតិ មាតុភូមិ ជា ទី ស្នេហា នៃ យើង ។
* ទី៥៖ ពង្រឹង និង ថែរក្សា ឲ្យបាន រឹងមាំ នូវ សាមគ្គីភាព និង ឯកភាព ផ្ទៃក្នុង ទាំង ទស្សនៈ គោលជំហរ និង នយោបាយ សតិអារម្មណ៍ តាម គោលការណ៍ « រក្សា ចាស់ បង្កើន ថ្មី » ។
* ទី ៦៖ ចូលរួម អនុវត្តមាគ៌ា គោល នយោបាយ ការទូត សន្តិភាព ឯករាជ្យ មិត្តភាព និង សហប្រតិបត្តិការ ស្មើភាព ជាមួយ បណ្តា ប្រទេស នានា នៅលើ ពិភពលោក ដោយ ឈរ លើ មូលដ្ឋាន គោរព ឯករាជ្យ អធិបតេយ្យ ស្មើ សិទ្ធិ និង មាន ផលប្រយោជន៍ ទាំង សងខាង ស្រប តាម បាវចនា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នៃ ការ « កែទម្រង់ ខាងក្នុង កសាង មិត្ត ខាងក្រៅ ដោយ ឈរ លើ មូលដ្ឋាន ឯករាជ្យ » ។
* ទី៧៖ ត្រូវ យក ស្មារតី នៃ អង្គ មហាសន្និបាត រណសិរ្ស លើក ទី៦ ទៅ ផ្សព្វផ្សាយ បន្ត ឲ្យបាន ទូលំទូលាយ បន្ថែម ទៀត ដល់ គ្រប់ មជ្ឈដ្ឋាន សង្គម ។
( ភ្នំពេញ ) ៖ រដ្ឋាភិបាល ជប៉ុន បាន ចុះហត្ថលេខា ផ្ដល់ ជំនួយ ឥត សំណង សាងសង់ ស្ពាន បេតុង ថ្មី មួយ មាន ប្រវែង ២៥ម៉ែត្រ ជូន ប្រជាពលរដ្ឋ នៅ ស្ថិត នៅ ឃុំ អូរ ម្រះ ស្រុក សៀម បូក ខេត្ត ស្ទឹងត្រែង ដោយ ប្រើប្រាស់ ថវិកា ចំនួន ១៦៨. ២៧៦ ដុល្លារ អាមេរិក ។
ការផ្ដល់ ជំនួយ នេះ ធ្វើឡើង តាមរយៈ ការចុះហត្ថលេខា រវាង លោក តា និណៃ អ៊ុំ ឈិតុ ម៉ុ ភារ ធារី ស្តី ទី នៃ ស្ថានទូត ជប៉ុន ប្រចាំ កម្ពុជា ជាមួយ ភាគី កម្ពុជា ដែល មាន លោក ព្រំ ចាន់ ថា ប្រធាន មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ស្ទឹងត្រែង លោក សួង ហ៊ី អភិបាល ស្រុក សៀម បូក និង លោក សយ គា អនុប្រធាន មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត នា រសៀល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ ស្ថានទូត ជប៉ុន ប្រចាំ កម្ពុជា រាជធានី ភ្នំពេញ ។
នេះ ជា ជំនួយ ឥត សំណង សម្រាប់ គម្រោង ទ្រង់ទ្រាយ តូច សន្តិសុខ មនុស្សជាតិ ដើម្បី សាងសង់ ស្ពាន បេតុង ថ្មី ១កន្លែង ខាងលើ ប្រវែង ២៥ម៉ែត្រ និង ទទឹង ៦ម៉ែត្រ ដោយ ប្រើប្រាស់ ថវិកា ចំនួន ១៦៨. ២៧៦ ដុល្លារ អាមេរិក ។
គម្រោង សាងសង់ ស្ពាន បេតុង ថ្មី នេះ គឺ ដើម្បី ជំនួស ឱ្យ ស្ពាន ឈើ ចាស់ ដែល បាន ពុក ផុយ រង ការខូចខាត និង គ្មាន សុវត្ថិភាព ដោយសារ ចំនួន រថយន្ត ធុន ធ្ងន់ ឆ្លងកាត់ ច្រើន បណ្ដាលឱ្យ មាន ការបាក់ ស្រុត ជា ហេតុ បង្កឱ្យ មាន ការលំបាក ជាច្រើន ដល់ ប្រជាជន ក្នុង មូលដ្ឋាន ក្នុង ការធ្វើដំណើរ ឆ្លងកាត់ ទៅ សាលារៀន កន្លែង ធ្វើការ មន្ទីរពេទ្យ ជាពិសេស ការដឹកជញ្ជូន កសិផល របស់ ប្រជាពលរដ្ឋ ទូទៅ ។
ក្នុង កិច្ចសម្ភាស ជាមួយ អ្នកសារព័ត៌មាន លោក Santo Darmosumarto បាន ឱ្យដឹង ថា ក្រៅ ឥណ្ឌូនេស៊ី បាន ផ្សព្វផ្សាយ ពី តំបន់ ទេសចរណ៍ ជាច្រើន របស់ ឥណ្ឌូនេស៊ី ឱ្យ ប្រជាជន កម្ពុជា បាន ស្គាល់ ឥណ្ឌូនេស៊ី ក៏ បាន ផ្សព្វផ្សាយ ពី កម្ពុជា ទៅកាន់ ប្រជាជន ឥណ្ឌូនេស៊ី ផងដែរ តាមរយៈ បណ្តាញ សង្គម ដោយ បង្ហាញ ពី ប្រទេស កម្ពុជា ជា ប្រទេស ដែល មាន សុខ សន្តិភាព ប្រជាជន មាន ភាព រួសរាយ រាក់ទាក់ ដែល ធ្វើឱ្យ ប្រជាជន ឥណ្ឌូនេស៊ី ចង់ មក ដើរកម្សាន្ត . ស្វែងយល់ ពី បរិយាកាស វិនិយោគ និង ការបំពេញ នៅ ការងារ នៅ កម្ពុជា ជាដើម ។
ជាមួយគ្នា នេះ លោក លើកទឹក ដល់ ប្រជាជន កម្ពុជា ទៅ ទស្សនា នៅ ឥណ្ឌូនេស៊ី ជាពិសេស កោះ ស៊ូម៉ាត្រា ខាង សិច ព្រោះ ទីតាំង ភូមិសាស្រ្ត នៃ កោះ នេះ មាន ភាពស្រស់ស្អាត និង មាន វប្បធម៌ ចម្រុះ ជាច្រើន ។ ចំណែក ម្ហូប ប្រចាំ តំបន់ វិញ ក៏ មាន រសជាតិ ស័ក្កសម នឹង ប្រជាជន កម្ពុជា ងាយស្រួល ក្នុង ការទទួលទាន បាន ។
បើ តាម អគ្គ រដ្ឋទូត ឥណ្ឌូនេស៊ី ប្រចាំ កម្ពុជា រូប នេះ ចាប់ពី ខែមករា ដល់ ខែវិច្ឆិកា នេះ ឆ្នាំ ២០២៣ នេះ ប្រជាជន កម្ពុជា ប្រមាណ ៩៣០០ នាក់ បាន ទៅ លេង ប្រទេស នេស៊ី ហើយ រំពឹង ថា រហូត ដំណាច់ ឆ្នាំ នេះ នឹង មាន រហូត ជាង១០ ០០០ នាក់ ។ លោក ថា ចំនួន នេះ តិចតួច នៅឡើយ ទេ បើ ធៀប នឹង មុន ការរីករាលដាល ជំងឺ កូវីដ១៩ មាន រហូតដល់ ១៣០០០ នាក់ ហើយ សង្ឃឹម ថា នៅ ពេល ដែល សេដ្ឋកិច្ចកាន់តែ ប្រសើរ អ្នក ទៅ ទស្សនា នៅ ឥណ្ឌូនេស៊ី និង កើនឡើង ដល់ ប្រមាណ ៣ម៉ឺន នាក់ ។
លោក បន្ថែម ថា ភ្ញៀវ ទេសចរ ឥណ្ឌូនេស៊ី គឺជា ទីផ្សារ មួយ ដ៏ សំខាន់ សម្រាប់ កម្ពុជា ដោយ បាន ចូលរួមចំណែក ប្រមាណ ៣% សម្រាប់ ទីផ្សារ ទេសចរណ៍ នៅ កម្ពុជា ។
