( ភ្នំពេញ ) ៖ លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន ទទួល ជួប សម្តែង ការគួរសម ជាមួយ បណ្ឌិត្យ សភា នគរបាល កម្ពុជា ដឹកនាំ ដោយ នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ ឯក មនោសែន ប្រធានបណ្ឌិត្យ សភា នគរបាល កម្ពុជា ព្រមទាំង មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ រួម ជាមួយ អនុប្រធាន នៃ បណ្ឌិត្យ សភា នគរបាល កម្ពុជា សរុប ប្រមាណ ២០ រូប ។
លោរដ្ឋមន្ត្រី ជម្រាប ជូន បន្ថែម អំពី ការបង្កើត អង្គភាព បរិវត្តន៍ កម្ម ឌីជីថល នៅ តាម បណ្តា ក្រសួង ស្ថាប័ន រដ្ឋ ការកសាង មជ្ឈមណ្ឌល ទិន្នន័យ ជាតិ ការបង្កើត ថ្នាល និង កម្មវិធី បច្ចេកវិទ្យា នានា ការលើកកម្ពស់ វិស័យ អប់រំ ឌីជីថល តាមរយៈ ការផ្តល់ អាហារូបករណ៍ ទេពកោសល្យ ឌីជីថល តេជោ ការបង្កើត កម្មវិធី អភិវឌ្ឍន៍ ជំនាញ ឌីជីថល ការបង្កើត មជ្ឈមណ្ឌល បច្ចេកវិទ្យា សហគមន៍ ការរៀបចំ ប្រព័ន្ធ គ្រប់គ្រង សាលារៀន និង ការរៀបចំ កម្មសិក្សា ផ្នែក ឌីជីថល ជាដើម ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ មាន មោទនភាព ក្នុង ការដឹកនាំ របស់ លោក រដ្ឋមន្ត្រី លើ វិស័យ បច្ចេកវិទ្យា ឌីជីថល ក្នុង ការចូលរួម អភិវឌ្ឍ ធនធាន មនុស្ស នៅក្នុង ប្រទេស កម្ពុជា ។
នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ មាន សង្ឃឹម ថា វិស័យ បច្ចេកវិទ្យា ជា វិស័យ សំខាន់ ក្នុង ការធ្វើ បរិវត្តកម្ម ឌីជីថល នៅក្នុង ក្រសួង ស្ថាប័ន រដ្ឋ និង បាន ល្អ ប្រសើរ ជាពិសេស ក្នុង ជួយ លើកកម្ពស់ វិស័យ សន្តិសុខ សណ្តាប់ធ្នាប់ ឱ្យ កាន់តែ មាន ការរីកចម្រើន ។ នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ ក៏ បាន សំណូមពរ ដល់ លោក រដ្ឋមន្ត្រី ក្នុង ការជួយគាំទ្រ លើ ការផ្តល់ សេវា អ៊ីនធឺណិត ជូន បណ្ឌិត្យ សភា នគរបាល កម្ពុជា និង ជួយ គាំទ្រ បណ្តុះបណ្តាល លើ ជំនាញ ផ្នែក បទល្មើស បច្ចេកវិទ្យា ។
ជា ការឆ្លើយតប លោក រដ្ឋមន្ត្រី បាន ឯកភាព ក្នុង ការតភ្ជាប់ សេវា អ៊ីនធឺណិត ជូន បណ្ឌិត្យ សភា នគរបាល កម្ពុជា ព្រមទាំង ចូលរួម សហការ ក្នុង ផ្តល់ ជា វាគ្មិន ក្នុង ការបណ្តុះបណ្តាល ជំនាញ ចាំបាច់ ព្រមទាំង បន្ត កិច្ចសហការ ក្នុង គោលបំណង ចូលរួមចំណែក ការពារ សុខ សន្តិភាព ជូន ប្រជាពលរដ្ឋ ។
បណ្ឌិត្យ សភា នគរបាល កម្ពុជា ជា គ្រឹះស្ថាន សិក្សា សាធារណៈ តែ មួយ គត់ ក្នុង ការសិក្សា ស្រាវជ្រាវ វិទ្យាសាស្រ្ត នគរបាល និង ការអភិវឌ្ឍ ធនធាន មនុស្ស លើ វិស័យ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ ប្រកបដោយ កិត្យានុភាព ឧត្ដមភាព និង ការជឿទុកចិត្ត ក្នុង ក្របខណ្ឌ ជាតិ និង អន្តរជាតិ ៕ ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ
( សៀមរាប ) ៖ អាកាសយានដ្ឋាន អន្តរ ជាតិ សៀមរាប អង្គរ (SAI) តម្លៃ ប្រមាណ ១.១០០ លាន ដុល្លារ អាមេរិក សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ៤កើត ខែកត្តិក ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ហើយ ។ ពិធី នេះ ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
វត្តមាន អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ គឺជា សមិទ្ធផល ដ៏ មហាសាល មួយ ទៀត នៅលើ ទឹកដី ខេត្ត សៀមរាប ដែល ជា ប៉ូល សេដ្ឋកិច្ច ដ៏ មាន សក្តានុពល របស់ កម្ពុជា ផ្នែក ទេសចរណ៍ ។ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ក្លាយជា ការតភ្ជាប់ ផ្លូវ អាកាស ដ៏ សំខាន់ រវាង ខេត្ត សៀមរាប ជាមួយ តំបន់ ដទៃ ក្នុង ប្រទេស កម្ពុជា ក៏ ដូចជា បណ្តា មាន សក្តានុពល ទេសចរណ៍ ដទៃ ទៀត ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គ រ៖
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សម្តេច មាន ក្តី សោមនស្ស រីករាយ ដែល បាន អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ គឺជា សមិទ្ធផល ប្រវត្តិសាស្ត្រ មួយ ទៀត លើ វិស័យ ដឹកជញ្ជូន ផ្លូវ អាកាស ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន វាយតម្លៃ ខ្ពស់ ចំពោះ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល រដ្ឋបាល ខេត្ត សៀមរាប និង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ នានា ដែល បាន ខិតខំ សហការ យ៉ាង ជិតស្និទ្ធ ក្នុង ការសម្របសម្រួល គម្រោង ប្រកបដោយ ស្មារតី បុរេសកម្ម និង ទទួលខុសត្រូវ ខ្ពស់ តាំងពី ដើម រហូត សម្រេចបាន លទ្ធផល ជា រូបរាង ដោយ រលូន និង តាម ផែនការគ្រោងទុក ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ជា ផ្លែ ផ្កា កើត ចេញ ពី សុខ សន្តិភាព និង ជា សមិទ្ធផល លេចធ្លោ ថ្មី បន្ថែម ទៀត នៃ ចំណង មិត្តភាព ដែក ថែប កម្ពុជា - ចិន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការសម្រេច សាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ គឺ ធ្វើឡើង ក្រោម ចក្ខុវិស័យ វែងឆ្ងាយ ។ ជាពិសេស ឈរ លើ គោលដៅ ពីរ គឺ អភិវឌ្ឍន៍ និង អភិរក្ស ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការសម្រេចចិត្ត ដូរ ព្រលានយន្ត ពី ចម្ងាយ ត្រឹម ៥គីឡូម៉ែត្រ ពី ក្រុង សៀមរាប មក ចម្ងាយ ៥០ គីឡូម៉ែត្រ ពី ក្រុង សៀមរាប គឺ ដើម្បី ថែទាំ សម្បត្តិ ដូនតា ខ្មែរ ឱ្យ បាន យូរអង្វែង ថែម ទៀត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បង្ហាញ ក្តី រំពឹង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ មាន សមត្ថភាព កាន់តែ ខ្ពស់ ក្នុង ការទទួលយន្តហោះ ធំ ៗ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត មាន ជំនឿចិត្ត ថា ទៅ ថ្ងៃ មុខ ក្រុង សៀមរាប កាន់តែ រីក ហើយ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ នឹង ក្លាយជា អាកាសយានដ្ឋាន មួយ ស្ថិត កណ្តាល ក្រុង សៀមរាប ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ចាត់ទុក ការកសាង អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ជា ការបង្ហាញ ឱ្យ ឃើញ ពី ការប្រែក្លាយ តំបន់ អតីត សមរភូមិ សង្គ្រាម ទៅជា តំបន់ អភិវឌ្ឍន៍ និង មាន សក្តានុពល សេដ្ឋកិច្ច ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ការសាងសង់ បាន អាកាសយានដ្ឋាន ជា រឿង ល្អ មួយ តែ ត្រូវ រក វិធី អភិវឌ្ឍន៍ បន្ត ដើម្បី ធានា ដល់ និរន្តភាព ដំណើរការ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ បាន រៀបចំ ប្រព័ន្ធ ត្រួតពិនិត្យ អ្នកដំណើរ ចូល ដល់ កម្ពុជា តាម ប្រព័ន្ធ អេឡិចត្រូនិក ហើយ នឹង ដាក់ ឱ្យ អនុវត្តន៍ មុន គេ នៅ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប នៅ ចុង ឆ្នាំ ២០២៣ នេះ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ណែនាំ ឱ្យ ភ្ជាប់ ការធ្វើ អាជីវកម្ម ជាមួយ អាកាសយានដ្ឋាន សៀមរាប អង្គរ ដើម្បី ផ្តល់ ប្រយោជន៍ សេដ្ឋកិច្ច ដល់ ពលរដ្ឋ នៅ ខេត្ត សៀមរាប និង ខេត្ត ដទៃ ទៀត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ឆ្នាំ ២០២៤ ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ ទំនាក់ទំនង ប្រជាជន កម្ពុជា - ចិន ដូច្នេះ នឹង មាន ការចូលមក ទេសចរណ៍ ច្រើន ពី ប្រជាពលរដ្ឋ ចិន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ដើម្បីឱ្យ ខេត្ត សៀមរាប អាច មាន សមត្ថភាព ទទួល អ្នកទេសចរ ឡើងវិញ គឺ រដ្ឋបាន ដាក់ចេញ ផែនការ ជាច្រើន ជួយ ដល់ ប្រតិបត្តិករ ទេសចរណ៍ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា បើ ទោះបី កម្ពុជា ជួប ការលំបាក ដោយសារ បញ្ហា សេដ្ឋកិច្ច សកល តែ កម្ពុជា បន្ត ប្រឹងប្រែង មិន ឱ្យ តម្លៃ អគ្គិសនី ឡើង ថ្លៃ នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ដល់ អាជ្ញាធរ ខេត្ត សៀមរាប ខិតខំ ធានា សន្តិសុខ សណ្តាប់ធ្នាប់ នៅ តំបន់ ជុំវិញ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ដើម្បី ធ្វើឱ្យ វិស័យ ទេសចរណ៍ នៅ ខេត្ត សៀមរាប កាន់តែ រស់រវើក នោះ រាជ រដ្ឋាភិបាល នឹង គិតគូរ ការតភ្ជាប់ ជើងហោះហើរ ត្រង់ ទៅកាន់ តំបន់ ទេសចរណ៍ មាន សក្តានុពល នៅ ប្រទេស នានា និង ការពង្រីក វិសាលភាព នៃ ការប្រើប្រាស់ បណ្ណ ព្រំដែន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា បើ មាន ព្រលានយន្តហោះ ហើយ តែ ខ្វះ កម្មវិធី ទាក់ទាញ ទេសចរណ៍ ក៏ មិន អាច ឱ្យ ព្រលាន ដំណើរការ ល្អ នោះ ដែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការដាក់ ឱ្យ ប្រើប្រាស់ ព្រលានយន្តហោះ និង ការដាក់ចេញ យុទ្ធសាស្ត្រ « ទស្សនា សៀមរាប ឆ្នាំ ២០២៤ » គឺជា ការជួយ ស្រោចស្រង់ ទេសចរណ៍ នៅ សៀមរាប ឡើងវិញ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ នឹង ក្លាយជា កាលានុវត្តភាព ប្រកបដោយ សក្តានុពល ដ៏ ខ្លាំងក្លា និង សំខាន់ សម្រាប់ វិស័យ ទេសចរណ៍ ខេត្ត សៀមរាប ដែល ជា គោលដៅ ទេសចរណ៍ ដ៏ សំខាន់ របស់ កម្ពុជា និយាយ ដោយឡែក ព្រមទាំង វិស័យ ទេសចរណ៍ និង វិស័យ សេដ្ឋកិច្ច នៅ ទូទាំង ប្រទេស និយាយ ជា រួម ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ប្រកាស ស្វាគមន៍ យ៉ាង កក់ក្តៅ ដល់ ប្រជាពលរដ្ឋ ចិន មក ទស្សនា កម្ពុជា ឲ្យបាន ច្រើន ជាពិសេស មកកាន់ ខេត្ត សៀមរាប តែម្តង ។
( កំពត ) ៖ លោកស្រី ហ៊ុន ចាន់ ធី ម៉ៅធ និន ប្រធាន កិត្តិយស សាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ព្រមទាំង មន្ត្រី ក្រុមការងារ ពាក់ព័ន្ធ បាន ចុះ ជួប សំណេះសំណាល និង នាំយក ចង្ក្រាន សន្សំ សំចៃ ថាមពល ចែកជូន គ្រួសារ ប្រជាពលរដ្ឋ ដែល សុទ្ធ ជា ស្ត្រី ងាយ រងគ្រោះ និង ក្រីក្រ ចំនួន ១០០ គ្រួសារ មកពី បណ្ដា ភូមិ នៃ សង្កាត់ អណ្តូង ខ្មែរ ។
ពិធី ជំនួប សំណេះសំណាល ខាងលើ បាន ប្រព្រឹត្ត ធ្វើឡើង នា ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ សាលា សង្កាត់ អណ្ដូង ខ្មែរ ក្រុង កំពត ។
សំណេះសំណាល លោកស្រី ហ៊ុន ចាន់ ធី បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្ដាំផ្ញើ សួរសុខទុក្ខ របស់ លោក បណ្ឌិត ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត ដែល តែងតែ បាន យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ការដោះស្រាយ ពី បញ្ហា ទុក្ខលំបាក របស់ បងប្អូន ប្រជាពលរដ្ឋ ជាពិសេស កន្លងមក លោក តែងតែ ជួយ គាំទ្រ សកម្មភាព របស់ ស្ត្រី គ្រប់ កាលៈទេសៈ ក្នុង សកម្មភាព មនុស្សធម៌ និង សង្គម ជួយ ដល់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ក្នុង ខេត្ត ។
លោកស្រី ហ៊ុន ចាន់ ធី បាន សម្ដែង ទឹកចិត្ត រីករាយ និង ចាត់ទុក សកម្មភាព របស់ ក្រុមការងារ ដែល បាន ចុះ ជួប សំណេះសំណាល និង បាន នាំយក នូវ ចង្រ្កាន សន្សំ សំចៃ ថាមពល មក ចែកជូន ប្រជាពលរដ្ឋ នា ពេលនេះ គឺ ពិតជា បាន ចូលរួមចំណែក លើកកម្ពស់ ជីវភាព រស់ នៅ និង សុខភាព របស់ ប្រជាពលរដ្ឋ នៅក្នុង សហគមន៍ ក៏ ដូចជា ការ រួមចំណែក គាំទ្រ ការពារ បរិស្ថាន ព្រមទាំង កាត់បន្ថយ ការប្រែប្រួល អាកាសធាតុ នៅ កម្ពុជា ជាមួយ រាជ រដ្ឋាភិបាល ។
លោកស្រី ក៏ បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម ថែរក្សា ចង្ក្រាន ដែល បាន ចែកជូន នា ពេលនេះ ដើម្បីឲ្យ ការប្រើប្រាស់ បាន យូរអង្វែង និង ទទួលបាន អត្ថប្រយោជន៍ បន្ថែម ទៀត ពី ការប្រើប្រាស់ ចង្ក្រាន នេះ នៅក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ។
ព្រម ជាមួយគ្នា នេះ លោកស្រី បាន ថ្លែងអំណរគុណ ប្រជាពលរដ្ឋ ផងដែរ ដែល នៅតែ ស្រលាញ់ គាំទ្រ ជឿជាក់ លើ ការដឹកនាំ ដ៏ ប៉ិនប្រសប់ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី ក្នុង អាណត្តិ ទី៧ ដើម្បី បន្ត ថែរក្សា ការពារ សន្តិភាព ក្នុង ការដឹកនាំ ប្រទេស និង អភិវឌ្ឍន៍ សង្គមជាតិ បាន កាន់តែ រីកចម្រើន ថែម ទៀត ៕
វេទិការផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម នៅ ស្រុក ជើង ព្រៃ ទទួល សំណូមពរ ១៨ករណី ដើម្បី ដោះស្រាយ
លោក ខ្លូត ផន បាន បន្ត ថា វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ នា ពេលនេះ ពិតជា បាន ផ្ដល់ ឱកាស ដល់ ប្រជាពលរដ្ឋ ទទួលបាន នូវ ព័ត៌មាន និង បាន ស្តាប់ នូវ របាយការណ៍ បូកសរុប លទ្ធផល ការងារ ដែល ក្រុមប្រឹក្សា និង គណៈ អភិបាល ខេត្ត សម្រេចបាន ក្នុង ឆ្នាំ កន្លងទៅ ហើយក៏ ជា ឱកាស មួយ សម្រាប់ ប្រជាពលរដ្ឋ លើកឡើង នូវ សំណួរ និង សំណូមពរ ដើម្បី ក្រុមប្រឹក្សា ធ្វើ ការពិភាក្សា និង ឆ្លើយតប ។
សូម បញ្ជាក់ ថា អង្គ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ បាន ទទួល សំណូមពរ ពី ប្រជាពលរដ្ឋ ចំនួន ១៨ករណី ក្នុង នោះ រដ្ឋបាល ខេត្ត ដោះស្រាយ បាន មួយចំនួន នៅសល់ មួយចំនួន ទៀត ត្រូវបាន យក ទៅ ពិភាក្សា ដោះស្រាយ នៅ ពេល ក្រោយ តាម ប្រភេទ រដ្ឋបាល នីមួយ ៗ ៕
ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ានិត បន្ត នាំ អាវ រងារ ដែល ជា អំណោយ របស់ សម្តេច តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ចែកជូន កងកម្លាំង បណ្ដា អង្គភាព ចំណុះ សមូរ ភូមិ ទិសទី១ ប្រាសាទ ព្រះវិហារ
លោក ឧត្តមសេនីយ៍ ឯក ស្រី ឌឹក មេបញ្ជាការ រង កងទ័ព ជើងគោក និង ជា មេបញ្ជាការ កងពល ធំ អន្តរាគមន៍ លេខ ៣ បាន ថ្លែង លើកឡើង អំពី សភាពការណ៍ ទូទៅ នៅ តាម បណ្ដោយ ខ្សែ បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ - ឡាវ ដែល គណៈ បញ្ជាការ ឯកភាព សមូរ ភូមិ មុខ ទិសទី១ ទទួលខុសត្រូវ ។
លោក ថា រហូតមកដល់ ពេលនេះ ហាក់ មាន សភាព ស្ងប់ស្ងាត់ ធម្មតា បើ ទោះបី កន្លងមក ធ្លាប់ មាន សកម្មភាព មិន ប្រក្រតី ខ្លះ ៗ បាន កើតឡើង យ៉ាងណា ក្តី តែ ភាគី ទាំង សងខាង បាន ព្យាយាម រួមគ្នា ដោះស្រាយ ដោយ សន្តិវិធី និង បញ្ចៀស បាន រាល់ សកម្មភាព ទាំងឡាយ ណា ដែល នាំអោយ ឈាន ទៅរក ការប្រឈមមុខ គ្នា ដោយ ប្រដាប់អាវុធ ។
ថ្លែង សំណេះសំណាល នា ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ានិត បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង សេចក្តីនឹករលឹក ពី សម្តេច ទាំង ទ្វេរ ដែល ជានិច្ច ជាកាល សម្តេច តែង យកចិត្តទុកដាក់ គិតគូរ ជានិច្ច ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ កងកម្លាំងប្រដាប់អាវុធ យើង ។
លោក ក៏ ថ្លែងអំណរគុណ ព្រមទាំង កោតសរសើរ កងកម្លាំងប្រដាប់អាវុធ ទាំងអស់ ដែល ឈរជើង នៅ តាម បន្ទាត់ ព្រំដែន ហើយ បាន ខិតខំ បំពេញ ភារកិច្ច របស់ ខ្លួន ជូន ជាតិ មាតុភូមិ ដោយ បង្ហាញ នូវ ភាព ម៉ឺងម៉ាត់ ក្នុង ការថែរក្សា សន្តិសុខ សន្តិភាព ស្ថិរភាព ការពារ បូរណភាព ទឹកដី និង បាន បន្ត ចូលរួម យ៉ាង សកម្ម ក្នុង ការជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ នៅក្នុង ស្ថានភាព គ្រោះមហន្តរាយ នានា ។
លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ានិត ក៏ បាន ថ្លែង លើកទឹកចិត្ត ដល់ កងកម្លាំងប្រដាប់អាវុធ ទាំងអស់ ឱ្យ បន្ត រក្សា ស្មារតី សេ្នហា ជាតិ សាសនា ព្រះមហាក្សត្រ និង ការពារ សុខ សន្តិភាព ឱ្យ បាន ស្ថិតស្ថេរ យូរអង្វែង ដោយ បន្ត វេន ពី មួយ ជំនាន់ ទៅ មួយ ជំនាន់ ដើម្បី ថែរក្សា នូវ សមិទ្ធផល នានា ដែល បុព្វបុរស ជំនាន់ មុន ៗ បាន បង្កើត និង បន្សល់ទុក ឱ្យ យើង ជំនាន់ ក្រោយ ។
លោក ឧត្តមសេនីយ៍ ឯក មេបញ្ជាការ រង កងទ័ព ជើងគោក បាន ថ្លែង លើកឡើង ថា សុខ សន្តិភាព ប្រៀប បាន ទៅនឹង ខ្យល់ ដង្ហើម ដែល មនុស្ស ទាមទារ ជា ចាំបាច់ ក្នុង ការរស់រាន មាន ជីវិត ព្រោះថា សង្គ្រាម ការបាក់បែក នឹង ចូល ខ្លួន មក ជំនួស បើ អវត្តមាន សន្តិភាព ដូច្នេះ សូម កងកម្លាំងប្រដាប់អាវុធ ដែល ជា កម្លាំង ជួរ មុខ បន្ត ការពារ និង ថែរក្សា នូវ សុខ សន្តិភាព ដែល យើង មាន សព្វ ថ្ងៃ អោយ បាន នៅ គង់វង្ស យូរអង្វែង ៕
យ៉ាងណា ក្តី បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ អ៉ី ស្រាអែល លោក Lapid ដែល ធ្លាប់ ដឹកនាំ រដ្ឋាភិបាល ចម្រុះ អ៉ី ស្រាអែល មុនពេល លោក Netanyahu ត្រឡប់ មកកាន់អំណាច សា ជា ថ្មី កាលពី ឆ្នាំ ២០២២ គឺ មិន ធ្លាប់ បាន ប្រកាស ទាមទារ ឱ្យ លោក នាយក រដ្ឋមន្រ្តី ចុះ ពី តំណែង ឡើយ គិត ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង មក ៕ រូបភាព ពី AFP អភិបាល ខេត្ត កណ្តាល អញ្ជើញ ដាក់ ឲ្យ ប្រើប្រាស់ ផ្លូវ នៅ ទីក្រុង អរិយក្សត្រ ជាង ៣គីឡូម៉ែត្រ . អ្នកក្រុង អរិយក្សត្រ ត្រេកអរ យ៉ាង ខ្លាំង និង ថ្លែងអំណរគុណ អាជ្ញាធរ ខេត្ត
( កណ្ដាល ) ៖ ផ្លូវ ប្រវែង ៣.២៤៩ ម៉ែត្រ ទទឹង ៨ម៉ែត្រ កម្រាស់ ០.១៥ម៉ែត្រ និង លូដោះ ទឹក អម សង្ខាង ផ្លូវ នៅ សង្កាត់ អរិយក្សត្រ ក្រុង អរិយក្សត្រ ខេត្ត កណ្តាល ត្រូវបាន ដាក់ សម្ភោធ ឲ្យ ប្រើប្រាស់ ក្រោម អធិបតីភាព លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល នៅ ល្ងាច ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។ វិថី ថ្មី នេះ បាន ញ៉ាំង ឲ្យ ប្រជាពលរដ្ឋ ក្រុង អរិយក្សត្រ មាន ការសប្បាយរីករាយ ត្រេកអរ ជាខ្លាំង ។
នៅក្នុង ឱកាស នោះ លោក គង់ សោភ័ណ្ឌ បាន លើកឡើង ថា ការសម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ផ្លូវ បេតុង អាមេ និង លូដោះ អម សង្ខាង ផ្លូវ នា ពេលនេះ ជា សមិទ្ធផល ដ៏ ធំធេង ថ្មី បន្ថែម ទៀត ជាមួយនឹង សមិទ្ធផល នានា ជាច្រើន ផ្សេង ទៀត របស់ សង្កាត់ អរិយក្សត ក្រុង អរិយក្សត្រ ក្នុង វិស័យ សេដ្ឋកិច្ច - សង្គម ប្រកបដោយ សោភ័ណ្ឌភាព ផាសុកភាព សមធម៌ និង បរិយាប័ន្ន ។
អភិបាល ខេត្ត បន្ត ថា រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ និង ប៉ិនប្រសប់ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា អគ្គ មគ្គុទ្ទេសក៍ វ័យ ក្មេង ដ៏ ឆ្នើម បាន ដាក់ចេញ គោល នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ ដែល មាន អាទិភាព គន្លឹះ ចំនួន ៥៖ « មនុស្ស ផ្លូវ ទឹក ភ្លើង និង បច្ចេកវិទ្យា » ដោយ នៅតែ តម្កល់ មនុស្ស ជា អាទិភាព នៅលើ គេ ។
លោក ថា « នយោបាយ នេះ នៅតែ ជា អាទិភាព និង ស្ថិត នៅលើ ផ្លូវ ត្រូវ ទាំង ក្នុង អតីតកាល បច្ចុប្បន្ន កាល ក៏ ដូចជា អនាគតកាល សម្រាប់ ការកសាង ប្រទេស កម្ពុជា ឆ្ពោះ ទៅរក ការរីកចម្រើន លើ គ្រប់ វិស័យ មាន ផ្លូវ មាន ស្ពាន មាន ក្តីសង្ឃឹម និង មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ មាន សន្តិភាព ទើប មាន អ្វី ៗ ដូច ថ្ងៃ នេះ » ។
អភិបាល ខេត្ត បន្ថែម ថា ផ្លូវ បេតុង អាម ប្រវែង ៣២៤៩ ម៉ែត្រ ទទឹង ៨ម៉ែត្រ ស្ថិត នៅ ភូមិ អរិយក្សត្រ ភូមិ ខ្សាច់ សង្កាត់ អរិយក្សត្រ ក្រុង អរិយក្សត្រ ខេត្ត កណ្តាល សាងសង់ ដោយ ឧកញ៉ា ភឺន ផល្លា និង បាន ប្រសិទ្ធិ នាម ថា « វិថី ឧកញ៉ា ភឺន ផល្លា » ផងដែរ ។
ក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ណែនាំ ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ បន្ត យកចិត្តទុកដាក់ អនុវត្ត គោល នយោបាយ « ភូមិ ឃុំ - សង្កាត់ មាន សុវត្ថិភាព » ដែល មាន លក្ខណៈ សម្បត្តិ ៧យ៉ាង ឱ្យ បាន ល្អ ប្រសើរ ។ បន្ត ពង្រឹង និង កែលម្អ ការផ្តល់ សេវា សាធារណៈ គ្រប់ ប្រភេទ ដោយ ជំរុញ អនុវត្ត ឱ្យ បាន តាម ទិស ស្លោក « ធ្វើឱ្យ បាន ធ្វើឱ្យ លឿន និង មាន តម្លាភាព » ក្នុង ការផ្តល់ សេវា សាធារណៈ និង សេវា រដ្ឋបាល គ្រប់ ប្រភេទ ជូន ប្រជាពលរដ្ឋ ។
លោក បាន ណែនាំឲ្យ បន្ត រួមគ្នា ខិតខំ ដោះស្រាយ សំណើ សំណូមពរ និង បញ្ហា ប្រឈម នានា នៅ តាម មូលដ្ឋាន ប្រកបដោយ តម្លាភាព គណនេយ្យភាព និង យុត្តិធម៌ ជាពិសេស ខិតខំ កាត់បន្ថយ ការថ្នាំង ថ្នាក់ របស់ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
ជាមួយគ្នា នេះ លោក ឧកញ៉ា ភឺន ផល្លី បាន ថ្លែង ថា ក្រុមហ៊ុន មាន ផែនការអភិវឌ្ឍន៍ ក្រុង អរិយក្សត្រ នេះ ឲ្យ រីកម្រើន ជា ទីក្រុង ទំនើប ដោយ មាន សាងសង់ បុរី វីឡា ខុនដូ និង អចលន ទ្រព្យ ល្អ ឯក ជាច្រើន ផ្សេង ទៀត ខណ: ដែល ប្រទេស ជាតិ យើង មាន សុខ សន្តិភាព និង កំពុងតែ រីកលូតលាស់ ទៅ មុខ ជាលំដាប់ ៕ កម្ពុជា នឹង ធ្វើជា ប្រធាន នៃ អនុសញ្ញា អូតា វ៉ា នៅ ឆ្នាំ ២០២៤ និង ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល សៀមរាប - អង្គរ ស្តីពី ពិភពលោក មួយ ដែល គ្មាន មីន
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន តំណាង សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង ជា ប្រធាន អាជ្ញាធរ មីន បាន បញ្ជាក់ ថា កម្ពុជា នឹង ធ្វើជា ប្រធាន នៃ អនុសញ្ញា អូតា វ៉ា ឆ្នាំ ២០២៤ និង ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល សៀមរាប - អង្គរ ស្តីពី ពិភពលោក មួយ ដែល គ្មាន មីន នៅ ចុង ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។
តាមរយៈ សន្និសីទ សារព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ០២៣ នេះ ទេសរដ្ឋមន្ត្រី លី ធុជ បាន ឱ្យដឹង ថា សម្រាប់ កិច្ចប្រជុំ នេះ នឹង មាន តំណាង មក បណ្តា ប្រទេស ជិត ២០០ ទូទាំង ពិភពលោក តាមរយៈ កិច្ចប្រជុំ នៅ ខេត្ត សៀមរាប នេះ ក៏ ជា ទាក់ទាញ ភ្ញៀវ ទេសចរ មក ទស្សនា ប្រាសាទ អង្គរវត្ត របស់ កម្ពុជា ជាដើម ។
ទេសរដ្ឋមន្ត្រី លី ធុជ បាន បញ្ជាក់ ថា ក្នុង ឱកាស ធ្វើជា ប្រធាន នៃ អនុសញ្ញា អូតា វ៉ា និង ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល សៀមរាប - អង្គរ ស្តីពី ពិភពលោក មួយ ដែល គ្មាន មីន កម្ពុជា ដែល ជា ប្រទេស ឆ្លងកាត់ ការរងគ្រោះ ដោយសារ គ្រាប់ មីន ប្រឆាំង មនុស្ស នឹង ចែករំលែក បទពិសោធន៍ ជាពិសេស ចំណុច វិជ្ជមាន ដែល កម្ពុជា បាន ខិតខំ ប្រឹងប្រែង កន្លងមក ដូចជា នយោបាយ ឈ្នះ ឈ្នះ នាំមក នូវ សុខ សន្តិភាព ជូន កម្ពុជា ក៏ ដូចជា ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា ។
ទេសរដ្ឋមន្ត្រី លី ធុជ បាន បញ្ជាក់ បន្ថែម ថា៖ « តាមរយៈ កិច្ចប្រជុំ នេះ កម្ពុជា នឹង ប្រាប់ ពិភពលោក ថា កម្ពុជា ញញឹម ឡើងវិញ ហើយ រស់ ឡើងវិញ ហើយ រស់ ក្នុង ក្តីសុខ ក្សេមក្សាន្ត រស់ ក្នុង សន្តិភាព បន្ទាប់ពី សង្គ្រាម រ៉ាំរ៉ៃ ជាច្រើន ទសវត្ស ដែល គេ មើល មក កម្ពុជា យើង តែ ក្រហម ឃើញ តែ ឈាម ឃើញ តែ ភាពវេទនា ឃើញ តែ ការអត់ឃ្លាន កម្ពុជា នឹង ប្រាប់ គេ ថា កម្ពុជា ជា ទឹកដី ញញឹម ជា ទឹកដី នៃ ក្តីសង្ឃឹម » ។
ជាមួយគ្នា ដែរ ទេសរដ្ឋមន្ត្រី លី ធុជ ក៏ បាន លើកឡើង ពី មូលហេតុ ដែល កម្ពុជា បាន ធ្វើជា ប្រធាន នៃ អនុសញ្ញា អូតា វា នេះ ដោយសារ កត្តា ជាច្រើន និង ជាពិសេស នោះ កម្ពុជា បាន ចាក់ ផុត ពី សង្គ្រាម និង ជា ប្រទេស មាន សន្តិភាព ។ លោក បាន បន្ថែម ថា កម្ពុជា គឺជា ប្រទេស មួយ ដែល ទទួលបាន ជោគជ័យ យ៉ាង ធេង ក្នុង ការលុបបំបាត់ សង្គ្រាម ។
ទេសរដ្ឋមន្ត្រី លី ធុជ បាន ឱ្យដឹង ថា កម្ពុជា ជា ប្រទេស ដំបូង នៅ អាស៉ី ដែល បាន ធ្វើជា ប្រធាន នៃ អនុសញ្ញា អូតាវ៉ា ។ ការទទួល ញញួរ ធ្វើជា ប្រធាន នៃ អនុសញ្ញា អូតា វ៉ា នេះ បន្ទាប់ពី ប្រទេស ស្វីស ។
សូម បញ្ជាក់ ថា កម្ពុជា បាន ក្លាយជា រដ្ឋ ភាគី មួយ នៃ អនុសញ្ញា អូតា វ៉ា ចាប់ពី ឆ្នាំ ២០០០ ។ ក្នុង នាម ជា រដ្ឋ ភាគី កម្ពុជា បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង លើ វិស័យ មីន ហើយក៏ បាន នឹង កំពុង បំពេញ កាតព្វកិច្ច របស់ ខ្លួន យ៉ាង សស្រាក់ ស្រាំ ព្រមទាំង ទទួលបាន នូវ ការវាយតម្លៃ ខ្ពស់ ពី គ្រប់ រដ្ឋ ភាគី ៕ ក្រោយ ទើប ជួប មុខ គ្នា លោក បៃ ដិន នៅតែ ចាត់ទុក លោក ស៉ី ជីន ពីង ជា មេដឹកនាំ ផ្តាច់ការ
( សៀមរាប ) ៖ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន អះអាង ថា ដើម្បី ជួយ ឱ្យ សកម្មភាព ទេសចរណ៍ នៅ ខេត្ត សៀមរាប កាន់តែ រស់រវើក នោះ រាជ រដ្ឋាភិបាល នឹង ខិតខំ តភ្ជាប់ ជើងហោះហើរ ត្រង់ ជាមួយ គោលដៅ ទេសចរណ៍ អន្តរជាតិ បន្ថែម ទៀត និង កំពុង ធ្វើ ការពង្រីក វិសាលភាព នៃ ការប្រើប្រាស់ បណ្ណ ព្រំដែន ជាមួយ ប្រទេស ស ជិតខាង ។
សម្តេច ធិបតី បាន បន្ត ថា ក្រសួង ទេសចរណ៍ និង រដ្ឋាលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល ក៏ កំពុង ខិតខំ ជំរុញ ការតភ្ជាប់ ជើងហោះហើរ ត្រង់ ទាំងនេះ ដែរ ។
សម្ដេច ធិបតី បាន បញ្ជាក់ ថា ចំពោះ កិច្ចការ ពង្រីក វិសាលភាព ការប្រើប្រាស់ បណ្ណ ព្រំដែន ក្រសួង មហាផ្ទៃ កំពុង ធ្វើការ ជាមួយ ភាគី ថៃ ដើម្បី ជួយ សម្រួល ទេសចរ និង ប្រជាពលរដ្ឋ ថៃ ដែល មកពី ខេត្ត ជាប់ ព្រំដែន អាច ធ្វើដំណើរ មកកាន់ ខេត្ត សៀមរាប បាន ដោយ មិន ចាំបាច់ ប្រើប្រាស់ លិខិត ឆ្លង ដែន ។
ក្រៅពី នេះ ក៏ នៅ មាន ការរៀបចំ ព្រឹត្តិការណ៍ ផ្សេង ៗ នៅក្នុង ខេត្ត សៀមរាប ដូចជា កីឡា រត់ ម៉ារ៉ាតុង កិច្ចប្រជុំ កំពូល ធំ ៗ ពិធី បុណ្យ ជាតិ ទៀត ដែរ ។
សម្ដេច ធិបតី នាយក រដ្ឋមន្ត្រី កម្ពុជា ក៏ បាន លើកទឹកចិត្ត ដល់ រដ្ឋបាល ខេត្ត យូណាន ប្រទេស ចិន សូម ចូលរួម រៀបចំ ព្រឹត្តិការណ ទេសចរណ៍ នានា នៅ ខេត្ត សៀមរាប ឬ រៀបចំ កញ្ចប់ ទស្សនកិច្ច ទេសចរណ៍ ឱ្យ បាន ច្រើន មកកាន់ ខេត្ត សៀមរាប ព្រោះ ជា ខេត្ត សៀមរាប និង ខេត្ត យូណាន ជា ខេត្ត សម្ពន្ធ មេត្រីភាព នឹង គ្នា ស្រាប់ ។
សម្ដេច ធិបតី បាន បន្ថែម ថា ប្រសិនបើ មាន តែ ព្រលានយន្តហោះ អត់ មាន កម្មវិធី ជួយ ឱ្យ ទេសចរ មក ទេ ក៏ មិន ចំណេញ ដែរ ទេសចរ មក ច្រើន ហើយ តែ ខ្វះ សេវាកម្ម គុណភាព ខ្វះ ហេដ្ឋារចនាសម្ពន្ធ គាំទ្រ ក៏ ទេសចរ គេ មិន សប្បាយ ចិត្ត ដែរ ដូច្នេះ ស្នើ ឱ្យ វិស័យ ឯកជន ពង្រឹង សេវាកម្ម ទេសចរណ៍ ឱ្យ បាន ល្អ ៕
លោកស្រី ចម និម្មល រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន ជំរុញ និង លើកទឹកចិត្ត ដល់ ក្រុមហ៊ុន ហ្គ្រីន ត្រេដ និង សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ឱ្យ ខិតខំ បំពេញ ការងារ និង បន្ត សកម្មភាព នេះ ដើម្បី ជំរុញ ការនាំចេញ អង្ករ ដែល នឹង ឈាន ទៅរក ការបើក ច្រក ទីផ្សារ ថ្មី ៗ ទៀត ។
លោកស្រី បាន លើកឡើង ផងដែរ អំពី ការយកចិត្តទុកដាក់ របស់ រាជ រដ្ឋាភិបាល ដើម្បី ធ្វើឱ្យ វិស័យ ស្រូវ អង្ករ កម្ពុជា មាន ភាពប្រកួតប្រជែង ដែល មាន ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ ដោយ លើកលែង ពន្ធ គ្រប់ ប្រភេទ និង អាករ ដល់ រោង ម៉ាស៊ីន កិន ស្រូវ និង អ្នកនាំចេញ តាំងពី ឆ្នាំ ២០១១ ហើយ បាន បន្ត ជូន រយៈពេល ៥ ឆ្នាំ បន្ថែម ទៀត សម្រាប់ សហគ្រាស ដែល អស់ អាណត្តិ ។
លោកស្រី បន្ត ថា ជាមួយគ្នា នេះ ក្រសួង ពាណិជ្ជកម្ម កំពុង ចរចា រៀបចំ នីតិវិធី ក្នុង ការចុះអនុស្សរណៈ យោគយល់ លើក ទី៧ សម្រាប់ បរិមាណ កើនឡើង ២០% បន្ថែម ទៀត សម្រាប់ ឆ្នាំ ២០២៣ - ២០២៤ ផងដែរ ។
លោកស្រី ក៏ បាន បង្ហាញ អំពី គោលជំហរ គាំទ្រ ដល់ ផែនការ នៃ ការពង្រីក ទីផ្សារ អង្ករ កម្ពុជា ទៅកាន់ ទីផ្សារ ប្រទេស ផ្សេង ៗ បន្ថែម ទៀត នៅក្នុង ឆ្នាំ ២០២៤ ដោយ លោកស្រី បាន ផ្តល់ អនុសាសន៍ បន្ថែម រួម មាន៖
* ក្រុមហ៊ុន ហ្គ្រីន ត្រេដ រួមគ្នា ជាមួយ សហព័ន្ធ ស្រូប អង្ករ កម្ពុជា និង អ្នកនាំចេញ ទាំងអស់ ត្រូវ បន្ត កិច្ចសហការ ជាប្រចាំ ជាមួយ អ្នកនាំចូល លើ ការរួមគ្នា ផ្សព្វផ្សាយ អង្ករ កម្ពុជា នៅ ទីផ្សារ ប្រទេស ដើម្បី ជំរុញ និង បង្កើន តម្រូវការ ការកែប្រែ ឥរិយាបទ អតិថិជន ឱ្យ ទទួលយក នូវ អង្ករ កម្ពុជា ឱ្យ កាន់តែ ច្រើន ។
* ស្នើសុំ ភាគី ប្រទេស ទីម័រ លេស្តេ ជួយ លើកទឹកចិត្ត ដល់ អ្នក វិនិយោគ ក៏ ដូច អ្នកនាំចូល អង្ករ ឱ្យ មក វិនិយោគ និង ទទួល ការនាំចូល អង្ករ កម្ពុជា ឱ្យ កាន់តែ ច្រើន ថែម ទៀត ព្រោះថា អង្ករ កម្ពុជា មាន រសជាតិ ឆ្ងាញ់ និង ជា អង្ករ ដែល ឈ្នះ ពានរង្វាន់ ពិភពលោក ចំនួន ៥ ដង ហើយ ដែល ទើបតែ ទទួលបាន មេដាយ មាស ចំពោះ ប្រភេទ អង្ករ សែន ក្រអូប ដែល បាន ធ្វើឡើង នៅ ប្រទេស ចិន ថ្មី ៗ នេះ ។
* គ្រប់ អនុព័ន្ធ ពាណិជ្ជកម្ម ទាំងអស់ ត្រៀមខ្លួន ជានិច្ច ដើម្បី គាំទ្រ សម្រួល កិច្ច ពាណិជ្ជកម្ម និង ការផ្សព្វផ្សាយ ដើម្បីឱ្យ ទីផ្សារ អង្ករ កម្ពុជា កាន់តែ រីក ធំ ឡើង ។
ថ្លែង ក្នុង ឱកាស សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន ឲ្យដឹង ថា យោង តាម ដំណឹង ពី អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ គម្រោង នេះ នឹង ត្រូវ រៀបចំ រួចរាល់ នៅ ចុង ឆ្នាំ ២០២៣ ខណៈ ការដាក់ ឲ្យ ដំណើរការ ជា គម្រោង គំរូ តែ ម្តង នៅ ឆ្នាំ ២០២៤ ។
ជាមួយគ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ឆ្នាំ ២០២៤ ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ ទំនាក់ទំនង ប្រជាជន កម្ពុជា - ចិន ដូច្នេះ នឹង មាន ការចូលមក ទេសចរណ៍ ច្រើន ពី ប្រជាពលរដ្ឋ ចិន ។ សម្តេច ធិបតី បាន ប្រកាស ស្វាគមន៍ យ៉ាង កក់ក្តៅ ដល់ ប្រជាពលរដ្ឋ ចិន មក ទស្សនា កម្ពុជា ។
សម្តេច ធិបតី ក៏ បាន ណែនាំ ដល់ អាជ្ញាធរ ខេត្ត សៀមរាប ខិតខំ ធានា សន្តិសុខ សណ្តាប់ធ្នាប់ នៅ តំបន់ ជុំវិញ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ ។ សម្តេច ធិបតី បាន ទៀត ថ្លែង ថា ដើម្បី ធ្វើឱ្យ វិស័យ ទេសចរណ៍ នៅ ខេត្ត សៀមរាប កាន់តែ រស់រវើក នោះ រាជ រដ្ឋាភិបាល នឹង គិតគូរ ការតភ្ជាប់ ជើងហោះហើរ ត្រង់ ទៅកាន់ តំបន់ ទេសចរណ៍ មាន សក្តានុពល នៅ ប្រទេស នានា និង ការពង្រីក វិសាលភាព នៃ ការប្រើប្រាស់ បណ្ណ ព្រំដែន ។
ថ្លែង បើក កិច្ចប្រជុំ លោក ប្រាបូវូ ស៊ូប៊ីន តូ រដ្ឋមន្រ្តី ការពារ ជាតិ ឥណ្ឌូនេស៊ី បាន សម្តែង ការកោតសរសើរ ដល់ សហរដ្ឋ អាមេរិក ដែល បាន ធ្វើការ ជាមួយ ប្រទេស នៅក្នុង តំបន់ ដើម្បី សន្តិភាព និង ស្ថេរភាព ។
លោក បន្ត ថា កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្រ្តី ការពារ ជាតិ អាស៊ាន - អាមេរិក និង ធ្វើជា សក្ខីភាព ចំពោះ អាស៊ាន និង សហរដ្ឋ អាមេរិក និង ភាពជាដៃគូរ ដោយ ផ្អែក ទៅ លើ ការគោរព គ្នា ទៅ វិញ ទៅ មក ផលប្រយោជន៍ រួម ការយោគយល់ គ្នា សន្តិភាព ស្ថេរភាព នៅក្នុង តំបន់ ឥណ្ឌូប៉ាស៊ីភិច ។
កិច្ចប្រជុំ នេះ បាន ផ្តល់ ឱកាស ដ៏ មាន តម្លៃ បំផុត សំរាប់ ធ្វើ កិច្ចសហប្រតិបត្តិការ រួមគ្នា និង ការធ្វើឲ្យ ស៉ី ជម្រៅ នៃ ការយោគយល់ គ្នា ។
លោក សង្កត់ធ្ងន់ ថា អាស៊ាន មាន សារៈសំខាន់ សម្រាប់ កិច្ចសន្ទនា និង សហប្រតិបត្តិការ ក្នុង តំបន់ នេះ ជា មូលហេតុ ដែល ធ្វើឲ្យ សហរដ្ឋ អាមេរិក ធ្វើ ការងារ ឲ្យ កាន់តែ ស៊ី ជំរៅ ជាមួយ អាស៊ាន នៅ គ្រប់ កម្រិត ។
ក្នុង បទ អន្តរាគមន៍ ក្នុង កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្រ្តី ការពារ ជាតិ អាស៊ាន - អាមេរិក នាយ ឧត្តមសេនីយ៍ ទៀ សីហា បាន បញ្ជាក់ ថា ចាប់តាំងពី ការបង្កើតឡើង ក្នុង ឆ្នាំ ១៩៧៧ ភាពជាដៃគូ អាស៊ាន - អាមេរិក បាន បន្ត ប្ដេជ្ញា រក្សា សន្តិភាព សន្តិសុខ និង ស្ថិរភាព ក៏ ដូចជា វិបុលភាព សម្រាប់ តំបន់ របស់ យើង ។
កិច្ចព្រមព្រៀង រវាង មេដឹកនាំ អាស៊ាន - អាមេរិក ក្នុង ការបង្កើត ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ (CSP) នៅក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន - អាមេរិក លើក ទី១០ នៅ រាជធានី ភ្នំពេញ បាន ឆ្លុះបញ្ចាំង ពី ភាព ទូលំទូលាយ និង ស៊ីជម្រៅ នៃ ទំនាក់ទំនង របស់ យើង និង បាន បើក ផ្លូវ សម្រាប់ ការពង្រឹង កិច្ចសហប្រតិបត្តិការ របស់ យើង លើ វិស័យ ការពារ ជាតិ បន្ថែម ទៀត ។
នាយ ឧត្តមសេនីយ៍ ទៀ សីហា បាន កោតសរសើរ ដល់ តួនាទី ស្ថាបនា របស់ សហរដ្ឋ អាមេរិក ក្នុង តំបន់ រួមទាំង ការចូលរួម យ៉ាង សកម្ម ក្នុង ក្រុមការងារ ជំនាញ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក ( ADMM-Plus ) ។ សហរដ្ឋ អាមេរិក បាន ធ្វើជា សហ ប្រធាន ក្រុមការងារ ជំនាញ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក ជាមួយនឹង បណ្តា ប្រទេស សមាជិក អាស៊ាន ចំនួន ៣លើក រួច មកហើយ ។
លោក បញ្ជាក់ ថា សហរដ្ឋ អាមេរិក នឹង ធ្វើជា សហ ប្រធាន នៃ ក្រុមការងារ ជំនាញ ជុំ ទី៥ លើ វិស័យ វេជ្ជសាស្ត្រ យោធា ជាមួយនឹង ប្រទេស ឥណ្ឌូនេស៊ី ។ កម្ពុជា សូម គាំទ្រ ការរួមចំណែក ដ៏ មាន តម្លៃ បែប នេះ ។
ការថ្លែង បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាកាសយានដ្ឋាន អន្តរ ជាតិ សៀមរាប អង្គរ (SAI) ដែល មាន តម្លៃ ប្រមាណ ១.១០០ លាន ដុល្លារ អាមេរិក ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ គោលដៅ ដើម្បី ជំរុញ វិស័យ ទេសចរណ៍ ជាពិសេស នៅ ខេត្ត សៀមរាប នេះ កាល ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ថ្មី ៗ នៅពេល សម្តេច ជួប វិស័យ ឯកជន គឺ បាន ដាក់ចេញ នូវ គោលការណ៍ សម្រាប់ ខេត្ត សៀមរាប គឺ ឆ្នាំ ២០២៤ ជា ឆ្នាំ ទស្សនា ខេត្ត សៀមរាប ដែល ជា គោល នយោបាយ ដើម្បី ជំរុញ វិស័យ ទេសចរណ៍ នៅ ខេត្ត សៀមរាប ។
ជាមួយគ្នា នេះ ដែរ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឱ្យដឹង ថា កាលពី ខែតុលា ឆ្នាំ ២០២៣ សម្តេច បាន ជួប ពិភាក្សា ជាមួយ លោក ប្រធានាធិបតី ចិន ស៉ី ជិន ពីង និង នាយក រដ្ឋមន្ត្រី ចិន ដោយ មាន ការឯកភាពយក ឆ្នាំ ២០២៤ ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ ទំនាក់ទំនង ប្រជាជន កម្ពុជា - ចិន ជាពិសេស ការជំរុញ មុន ព្រួញ ទេសចរណ៍ ឱ្យ មកពី ប្រទេស ចិន មកកាន់ កម្ពុជា ឱ្យ កាន់តែ ច្រើន ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « ក្នុង គោល នយោបាយ ដែល យើង បាន ដាក់ចេញ នោះ គឺ ទី១ រៀបចំ យន្តកាល ក្នុង ការអនុវត្ត ដែល រៀបចំ នូវ ក្រុមប្រឹក្សា ទេសចរណ៍ មួយ ជាបន្ទាន់ ដើម្បី ដែល ជា តួអង្គ រៀបចំ ចេញ ពី ផែនការ សកម្មភាព ដឹកនាំ អនុវត្តន៍ និង ការដាក់ ចេញ ជា វិធានការជួយ លើកទឹកចិត្ត ប្រតិបត្តិករ វិស័យ ឯកជន ក្នុង ខេត្ត សៀមរាប តាមរយៈ យន្តកាល ជួយ លើ ពន្ធ លើកទឹកចិត្ត ផ្សេង ៗ ការត្រៀម ផ្តល់ ហិរញ្ញប្បទាន ដែល មាន ការប្រាក់ សមរម្យ មួយចំនួន សម្រាប់ ប្រតិបត្តិករ ក្នុង វិស័យ ទេសចរណ៍ » ។
បន្ថែម ពី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន បញ្ជាក់ ថា ដើម្បី ជា ការរួមចំណែក បន្ថែម ទៀត ក្នុង ការទាញ ភ្ញៀវ ទេសចរ ឱ្យ មក ទស្សនា កម្សាន្តន O ខេត្ត សៀមរាប រដ្ឋ ក៏ បាន ជួយ បន្ធូរបន្ថយ ការចំណាយ លើ វិស័យ ថាមពល បើ ទោះបី តម្លៃ អគ្គិសនី នៅ តាម បណ្តា ប្រទេស នានា មាន ដំឡើង ថ្លៃ ក៏ដោយ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ នឹង ក្លាយជា កាលានុវត្តភាព ប្រកបដោយ សក្តានុពល ដ៏ ខ្លាំងក្លា និង សំខាន់ សម្រាប់ វិស័យ ទេសចរណ៍ ខេត្ត សៀមរាប ។
សូម ជម្រាប ថា ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី នៃ វេទិកា « រាជ រដ្ឋាភិបាល - ផ្នែក ឯក ជន » លើក ទី១៩ កាលពី ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ថ្មី ៗ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល បាន សម្រេច ផ្តល់ កម្ចី ដល់ ប្រតិបត្តិករ ទេសចរណ៍ នៅ ខេត្ត សៀមរាប ចំនួន ៥០លាន ដុល្លារ ជាមួយនឹង អត្រា ការប្រាក់ សមរម្យ និង លក្ខខណ្ឌ អនុគ្រោះ ផ្សេង ទៀត ដើម្បី ធានា អនុញ្ញាតឱ្យ ប្រតិបត្តិករ ទេសចរណ៍ អាច ទទួលបាន នូវ ហិរញ្ញប្បទាន និង ចំនួន ទឹកប្រាក់ សមរម្យ តាម ប្រភេទ អាជីវកម្ម ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ជឿជាក់ ថា តំបន់ អាកាសយានដ្ឋាន អន្ដរជាតិ សៀមរាប អង្គរ នឹង ក្លាយជា តំបន់ សេដ្ឋកិច្ច ឧស្សាហកម្ម ពហុ បំណង ដែល នឹង ជួយ រុញ ដល់ សេដ្ឋកិច្ច ខេត្ត សៀមរាប កាន់តែ រីកចម្រើន បន្ថែម ទៀត ពិសេស បំពេញ បន្ថែម នូវ សេដ្ឋកិច្ច ផ្នែក ទេសចរណ៍ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « តំបន់ ជីក្រែ តំបន់ សូត្រ និគម ពី ដើម បើ តាម ប្រវត្តិ ជា កន្លែង វាយ គ្នា រហូតដល់ ឆ្នាំ ១៩៩៨ នៅ ទីនេះ មាន សកម្មភាព របស់ កម្លាំង ខ្មែរ ក្រហម ផ្លូវ ដែល យើង ជិះ ពី ទី រួម ខេត្ត មកដល់ ទីនេះ ពោរពេញ ទៅ ដោយ មីន និង ច្បាំង គ្នា និង ស្លាប់ អញ្ចឹង ប្រែក្លាយ តំបន់ អតីត សមរភូមិ ទៅជា តំបន់ អភិវឌ្ឍន៍ ហើយ ជា តំបន់ សេដ្ឋកិច្ច ឧស្សាហកម្ម និង ពហុ បំណង គឺជា អ្វី ដែល នឹង ដល់ ខេត្ត សៀមរាប ដើម្បី បំពេញ បន្ថែម នូវ សេដ្ឋកិច្ច ផ្នែក ទេសចរណ៍ នៅ ខេត្ត សៀមរាប » ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី . អ្វី ៗ ទាំងអស់ នេះ ជា ចក្ខុវិស័យ វែងឆ្ងាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ក្នុង ការជ្រើសរើស ទីតាំង ធ្វើ ព្រលានយន្ដហោះ ថ្មី នេះ គឺ មាន ហេតុផល ច្រើន ហើយ ការអភិវឌ្ឍ មកដល់ ថ្ងៃ នេះ ក៏ បាន ផ្ដល់ ប្រយោជន៍ រួចទៅហើយ ដល់ ប្រជាពលរដ្ឋ នៅ ជុំវិញ នេះ និង ប្រជាពលរដ្ឋ នៅ ខេត្ត សៀមរាប ទាំងមូល ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ទៀត ថា ប្រជាពលរដ្ឋ នៅ តំបន់ នេះ មិន ត្រឹមតែ ទទួលបាន នូវ ហេដ្ឋារចនាសម្ព័ន្ធ នោះ ទេ ពោល ក៏ បាន បង្កើត ការងារ ថែម ទៀត ផង ។ លើស ពី នេះ សម្ដេច បាន បង្ហាញ នូវ ជំនឿចិត្ត ថា ទៅ ថ្ងៃ មុខ ក្រុង សៀមរាប កាន់តែ រីក ហើយ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ នឹង ក្លាយជា អាកាសយានដ្ឋាន មួយ ស្ថិត កណ្តាល ក្រុង សៀមរាប ខណៈ ការសាងសង់ បាន អាកាសយានដ្ឋាន ជា រឿង ល្អ មួយ តែ ត្រូវ រក វិធី អភិវឌ្ឍន៍ បន្ត ដើម្បី ធានា ដល់ និរន្តភាព ដំណើរការ ។
សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី គូសបញ្ជាក់ ទៀត ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ នឹង ក្លាយជា កាលានុវត្តភាព ប្រកបដោយ សក្តានុពល ដ៏ ខ្លាំងក្លា និង សំខាន់ សម្រាប់ វិស័យ ទេសចរណ៍ ខេត្ត សៀមរាប ដែល ជា គោលដៅ ទេសចរណ៍ ដ៏ សំខាន់ របស់ កម្ពុជា និយាយ ដោយឡែក ព្រមទាំង វិស័យ ទេសចរណ៍ និង វិស័យ សេដ្ឋកិច្ច នៅ ទូទាំង ប្រទេស និយាយ ជា រួម ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត អះអាង ដែរ ថា ឆ្នាំ ២០២៤ ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ ទំនាក់ទំនង ប្រជាជន កម្ពុជា - ចិន ដូច្នេះ នឹង មាន ការចូលមក ទេសចរណ៍ ច្រើន ពី ប្រជាពលរដ្ឋ ចិន ហើយ ដើម្បីឲ្យ ខេត្ត សៀមរាប អាច មាន សមត្ថភាព ទទួល អ្នកទេសចរ ឡើងវិញ គឺ រដ្ឋបាន ដាក់ចេញ ផែនការ ជាច្រើន ជួយ ដល់ ប្រតិបត្តិករ ទេសចរណ៍ ផងដែរ ៕
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ (SAI) តម្លៃ ប្រមាណ ១.១០០ លាន ដុល្លារ អាមេរិក នា ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « មាន ការពិភាក្សា និង មាន ការឯកភាព ឆ្នាំ ២០២៤ នេះ គឺជា ឆ្នាំ នៃ ទំនាក់ទំនង ប្រជាជន និង ប្រជាជន របស់ កម្ពុជា - ចិន ជាពិសេស មុខ ព្រួញ សំខាន់ គឺ ការជំរុញ ទេសចរណ៍ ឲ្យ មកពី ចិន ឲ្យ ច្រើន នៅ ឆ្នាំ ២០២៤ » ។
ទន្ទឹម គ្នា នេះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ក្នុង នាម ជា ម្ចាស់ ផ្ទះ កម្ពុជា ចាំបាច់ នៅក្នុង ការដាក់ចេញ គោល នយោបាយ ដើម្បី ធ្វើ យ៉ាងណា ជួយ សម្រួល ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឲ្យដឹង ថា នៅក្នុង នយោបាយ ដែល ដាក់ចេញ នោះ នឹង រៀបចំ យន្ដ ការ នៅក្នុង ការអនុវត្ដ ដែល រៀបចំ ឡើងវិញ នូវ ក្រុមប្រឹក្សា ទេសចរណ៍ មួយ ជាបន្ទាន់ ដើម្បី ជា តួអង្គ រៀបចំ ចេញ ជា ផែនការ សកម្មភាព និង ដឹកនាំ អនុវត្ដ ក្នុង ការជួយសម្រួល ទាំងអស់ ។
ដើម្បី បន្ត វិធានការ ចំពោះ បុគ្គល ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សណ្តាប់ធ្នាប់ ស្ថាប័ន ព័ត៌មាន និង ដើម្បី ការពារ ភាព ស្អាតស្អំ ចំពោះ អ្នកសារព័ត៌មាន ក្រសួង ព័ត៌មាន តម្រូវឲ្យ អ្នកសារព័ត៌មាន និង បុគ្គល ដែល ជាប់ពាក់ព័ន្ធ ករណី សុំ លុយ ពី កាស៊ីណូ ថប ដាយ អឹម៉ិន ត្រូវ មក ធ្វើ ការផ្ទៀងផ្ទាត់ ឈ្មោះ និង ឆ្លើយ បំភ្លឺ នៅ អគ្គ នាយកដ្ឋាន ព័ត៌មាន និង សោត ទស្សន៍ នៃ ក្រសួង ព័ត៌មាន រៀងរាល់ ថ្ងៃ ធ្វើ ការ គិត ចាប់ពី ថ្ងៃ ចេញ សេចក្តីប្រកាស ព័ត៌មាន រហូតដល់ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០២៣ ជាកំហិត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត លើកទឹកចិត្ត ឱ្យ ក្រុមហ៊ុន សាងសង់ អាកាសយាន្ត អន្តរជាតិ សៀមរាប - អង្គរ ពង្រីក ផែនការវិនិយោគ ក្នុង ខេត្ត សៀមរាប បន្ថែម ទៀត ដើម្បីឱ្យ ខេត្ត នេះ ក្លាយជា ប៉ូល អភិវឌ្ឍន៍ ពហុ បំណង នៅ កម្ពុជា
( សៀមរាប ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន គាំទ្រ និង លើកទឹកចិត្ត ឱ្យ ក្រុមហ៊ុន សាងសង់ អាកាសយាន្ត អន្តរជាតិ សៀមរាប - អង្គរ ពង្រីក ផែនការវិនិយោគ នៅក្នុង ខេត្ត សៀមរាប បន្ថែម ទៀត ដើម្បីឱ្យ ខេត្ត នេះ ក្លាយជា ប៉ូល អភិវឌ្ឍន៍ ពហុ បំណង នៅ កម្ពុជា ។
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្នុង ឱកាស សម្តេច ធិបតី អនុញ្ញាតឱ្យ លោក វ៉ាង អ៉ីប៉ (Wang Yubo) អភិបាល ខេត្ត យូណាន នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ក្នុង ឱកាស នៃ ការអញ្ជើញ ចូលរួម ក្នុង « ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ » ។
ក្រសួង ការងារ និង ក្រុមហ៊ុន យក្ស របស់ កូរ៉េ បង្កើត កិច្ចសហការ អភិវឌ្ឍ ធនធាន មនុស្ស កម្ពុជា ក្នុង វិស័យ ឧស្សាហកម្ម ធុន ធ្ងន់
ក្នុង កិច្ចពិភាក្សា ដែល ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ភាគី ទាំងអស់ បាន ឯកភាព លើ ការបណ្តុះបណ្តាល ប្រជាពលរដ្ឋ កម្ពុជា ឱ្យ មាន ចំណេះដឹង លើ វិស័យ ឧស្សាហកម្ម ធុន ធ្ងន់ ក្នុង សង្វាក់ ផលិតកម្ម ផលិត នាវា និង កប៉ាល់ ដែល កំពុង មាន សក្តានុពល ។
ក្នុង កិច្ចពិភាក្សា ប្រកបដោយ ភាពស្និទ្ធស្នាល នេះ លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល សាធារណរដ្ឋ កូរ៉េ ខាងត្បូង និង ក្រុមហ៊ុន ដែល បាន ផ្តល់ វគ្គ បណ្តុះបណ្តាល នេះ ជូន ពលរដ្ឋ កម្ពុជា ឱ្យ មាន ជំនាញ ក្នុង វិស័យ ឧស្សហកម្ម ធុន ធ្ងន់ មួយ នេះ ។ ទន្ទឹមនឹង នេះ ក្រសួង បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បី ជួយ គាំទ្រ ដល់ ក្រុមហ៊ុន ក្នុង ការបណ្តុះបណ្តាល លើ ជំនាញ នេះ នៅ កម្ពុជា ឱ្យ ទទួលបាន ភាពជោគជ័យ ។
សម្រាប់ ឯក អគ្គ រដ្ឋទូត កូរ៉េ ខាងត្បូង វិញ កិច្ចសហការបណ្តុះបណ្តាល នេះ នឹង ក្លាយជា ចំណុច ជ្រោមជ្រែង ដ៏ សំខាន់ បន្ថែម ទៀត ដែល នឹង ធ្វើឱ្យ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ កាន់តែ ស្អិត រមួត និង ស៊ីជម្រៅ ទាំង ផ្នែក សេដ្ឋកិច្ច និង ភាព ជា មិត្ត របស់ ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ។
លោកស្រី ភឿង ស កុណា ជួប ពិភាក្សា ទ្វេ ភាគី ជាមួយ រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ បារាំង
នេះ គឺជា ការអនុម័ត ជា លើក ដំបូង លើ ដំណោះស្រាយ មួយ ចាប់តាំងពី សង្រ្គាម ដ៏ បង្ហូរ ឈាម រវាង អ៉ី ស្រាអែល និង ហាម៉ាស ផ្ទុះឡើង កាលពី ថ្ងៃទី ៧ ខែតុលា មក ។ ដំណោះស្រាយ នេះ ដែរ ត្រូវបាន ព្រាង ឡើង ដោយ ប្រទេស ម៉ាល់ត៍ និង ទទួលបាន ការអនុម័ត យល់ព្រម ពី សមាជិក ចំនួន ១២ នៅក្នុង ចំណោម សមាជិក ទាំង ១៥ នៃ ក្រុមប្រឹក្សា សន្តិសុខ UN ។ ចំណែក សហរដ្ឋ អាមេរិក រុស្ស៉ី និង ចក្រភព អង់គ្លេស ដែល សុទ្ធតែ មាន អំណាច វេតូ បាន អនុប វាទ លើ ដោះស្រាយ នេះ នេះ ក្នុង ការបោះឆ្នោត កាលពី ថ្ងៃពុធ ។
ដំណោះស្រាយ ព្រាង ឡើង ដោយ ប្រទេស ម៉ាល់ត៍ បាន អំពាវនាវ ឱ្យ មាន ការពង្រីក បទ ឈប់ បាញ់ មនុស្ស ជាបន្ទាន់ និង បើក ច្រក របៀង នៅ ទូទាំង តំបន់ ហ្កាហ្សា ដើម្បី ជួយ សម្រួល ដល់ ការផ្ដល់ ជំនួយ ទៅដល់ ប្រជាជន ស៊ីវិល ព្រមទាំង អំពាវនាវ ផងដែរ ឱ្យ មាន ការដោះលែង ចំណាប់ខ្មាំង ជាបន្ទាន់ និង ដោយ គ្មាន លក្ខខណ្ឌ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៧៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៧៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៧៩ នាក់ នោះ មាន ៦៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ២៦ករណី និង ជនសង្ស័យ ១៣នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ០៨ ករណី ។
សម្តេច តេជោ ហ៊ុន សែន អនុញ្ញាតឱ្យ ប្រធាន តំណាង មូលនិធិ CIESF ចូល ជួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ
( ភ្នំពេញ ) ៖ ក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ លោកស្រី សេង សុភាព នាយិកា អង្គការ FHI 360 ប្រចាំ កម្ពុជា លោក សាស្ត្រាចារ្យ ឡឹម តារា រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ជំរុញ លើកទឹកចិត្ដ ដល់ អង្គការ FHI 360 ពិនិត្យ លទ្ធភាព បន្ថែម ដើម្បី ចូលរួមចំណែក ក្នុង ការសម្រេចបាន នូវ ការគ្របដណ្តប់ សុខភាព ជា សកល
លោក រដ្ឋលេខាធិការ ក៏ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ និង ការស្វាគមន៍ របស់ លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី ចំពោះ អង្គការ សុខភាព គ្រួសារ អន្តរជាតិ ថ្លែងអំណរគុណ ដល់ អង្គការ FHI 360 ដែល បាន ចូលរួម គាំទ្រ ក្រសួង សុខាភិបាល ក្នុង ការអភិវឌ្ឍន៍ ប្រព័ន្ធ ថែទាំ សុខភាព នៅ កម្ពុជា ។
ជាពិសេស ចូលរួម ក្នុង ការសម្រេច សមិទ្ធផល ជាច្រើន នៃ គម្រោង លើកកម្ពស់ គុណភាព និង សមធម៌ សុខាភិបាល កម្ពុជា ការធ្វើឱ្យ ប្រសើរឡើង នូវ ពិធីសារ ពង្រឹង គុណភាព កម្មវិធី សុខភាព ថ្នាក់ ជាតិ ។
លោកស្រី បន្ត ថា អង្គការ FHI 360 មាន បេសកកម្ម ចម្បង ក្នុង ការធ្វើឱ្យ ប្រសើរឡើង នូវ សមធម៌ សុខភាព និង សុខុមាលភាព របស់ មនុស្សជាតិ តាមរយៈ ការប្រើប្រាស់ ទិន្នន័យ និង ការស្វែងរក ដំណោះស្រាយ ដោយ មូលដ្ឋាន ។ អង្គការ FHI 360 នៅ ប្រទេស កម្ពុជា បាន ចាប់ផ្តើម ដំណើរការ កាលពី ឆ្នាំ ១៩៩៨ និង បច្ចុប្បន្ន កំពុង អនុវត្ត សកម្មភាព និង ផ្តល់ ជំនួយ បច្ចេកទេស លើ គម្រោង សកម្មភាព ផ្តោត លើ វិស័យ សុខាភិបាល ចំនួន ៥ រួម មាន៖
១៖ បង្កើន សកម្មភាព អប់រំ សុខភាព ជូន ប្រជាពលរដ្ឋ សំដៅ លើកកម្ពស់ សុខភាព ពលរដ្ឋ កាន់តែ ប្រសើរឡើង
២៖ ប្រយុទ្ធ នឹង ជំងឺ ឆ្លង
៣៖ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ ឆ្លង ជា សកល ដែល ជា បញ្ហា សុខភាព សាធារណៈ
៤៖ ទប់ស្កាត់ ជំងឺ មិន ឆ្លង ដែល ប៉ះពាល់ ដល់ សុខភាព សាធារណៈ ក្នុង ពេល ដែល សង្គម សេដ្ឋកិច្ច មាន ការរីកចម្រើន
៥៖ ទប់ស្កាត់ នឹង បង្ការ ជំងឺ បណ្ដាល មកពី ផល ប៉ះពាល់ ពី បម្រែបម្រួល អាកាសធាតុ
៦៖ ធ្វើឱ្យ ប្រសើរឡើង នូវ ការ ពិនិត្យ និង ព្យាបាល ជំងឺ នៅ តាម សហគមន៍
៧៖ ការធ្វើ និយ័ត កម្ម ករ សេវា សាធារណៈ និង សេវា ឯកជន ដើមី្ប លើកកម្ពស់ សេវា ថែទាំ សុខភាព
៨៖ អភិវឌ្ឍន៍ ធនធាន មនុស្ស ជាពិសេស ជំនាញ សុខាភិបាល
ព្រមទាំង អាទិភាព សុខាភិបាល ទាំង បី គឺ * ពង្រឹង សមត្ថភាព មណ្ឌល សុខភាព តាមរយៈ ការផ្គត់ផ្គង់ សម្ភារៈ បរិក្ខារ វេជ្ជសាស្ត្រ ឱសថ ចាំបាច់ ហេដ្ឋារចនាសម្ព័ន្ធ ពង្រឹង សមត្ថភាព បុគ្គលិក សុខាភិបាល ធ្វើ យ៉ាងណា ឱ្យ ការផ្តល់ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ បាន ២៤ ម៉ោង ក្នុង ១ ថ្ងៃ ។
* ពង្រឹង សមត្ថភាព មន្ទីរពេទ្យ បង្អែក ស្រុក ប្រតិបត្តិ និង ខេត្ត តាមរយៈ ការពង្រឹង សមត្ថភាព ក្នុង ការសង្ក្រោះ បន្ទាន់ បន្ទប់ វះកាត់ មន្ទីរពិសោធន៍ និង ប្រព័ន្ធ បញ្ជូន ជាដើម ។
EDC ជូនដំណឹង ពី ការរអាក់រអួល ចរន្ត ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ដើម្បី រុះរើ គន្លង ខ្សែ បណ្តាញ ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ ដំឡើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដល់ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
ព្រឹក ថ្ងៃ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ
( សៀមរាប ) ៖ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ (SAI) តម្លៃ ប្រមាណ ១.១០០ លាន ដុល្លារ អាមេរិក សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ៤កើត ខែកត្តិក ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ហើយ ។ ពិធី នេះ នឹង ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
វត្តមាន អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ គឺជា សមិទ្ធផល ដ៏ មហាសាល មួយ ទៀត នៅលើ ទឹកដី ខេត្ត សៀមរាប ដែល ជា ប៉ូល សេដ្ឋកិច្ច ដ៏ មាន សក្តានុពល របស់ កម្ពុជា ផ្នែក ទេសចរណ៍ ។ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ក្លាយជា ការតភ្ជាប់ ផ្លូវ អាកាស ដ៏ សំខាន់ រវាង ខេត្ត សៀមរាប ជាមួយ តំបន់ ដទៃ ក្នុង ប្រទេស កម្ពុជា ក៏ ដូចជា បណ្តា មាន សក្តានុពល ទេសចរណ៍ ដទៃ ទៀត ។
អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ក៏ ជា សមិទ្ធផល មួយ កើត ចេញ ពី គោល នយោបាយ នៃ ចំណង មិត្តភាព ដែក ថែប និង កិច្ចសហប្រតិបត្តិការ ត្បូង ពេជ្រ កម្ពុជា - ចិន ក្រោម ក្របខណ្ឌ នៃ គំនិត ផ្តួចផ្តើម ខ្សែក្រវ៉ាត់ និង ផ្លូវ (BRI) និង គំនិត ផ្តួចផ្តើម ពី ប្រមុខ ដឹកនាំ រដ្ឋាភិបាល កម្ពុជា - ចិន ។
អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ មាន ទីតាំង ស្ថិត នៅក្នុង ភូមិសាស្ត្រ ឃុំ តា ប៉ែក ស្រុក សូទ្រនិគម និង ឃុំ គោក ធ្លក លើ ស្រុក ជីក្រែង នៃ ខេត្ត សៀមរាប មាន ចម្ងាយ ជាង ៤០ គីឡូម៉ែត្រ ពី រមណីយដ្ឋាន អង្គរ និង ជាង ៥០ គីឡូម៉ែត្រ ពី ទីប្រជុំជន ក្រុង សៀមរាប ។
អាកាសយានដ្ឋាន នេះ បាន ចាប់ផ្តើម សាងសង់ ជា ផ្លូវការ នៅ ខែមីនា ឆ្នាំ ២០២០ បញ្ចប់ ជាស្ថាពរ កាល នៅ បំណាច់ ខែមីនា ឆ្នាំ ២០២៣ នេះ ដោយ ប្រើ រយៈពេល ៣៦ ខែ ស្មើនឹង ៣ឆ្នាំ ។ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ នេះ ប្រើប្រាស់ បុគ្គលិក - វិស្វករ - កម្មករ ចន្លោះ ពី ២. ៥០០នាក់ ទៅ ៣.៧០០ នាក់ ក្នុង នោះ មាន បុគ្គលិក - វិស្វករ - កម្មករ ខ្មែរ ចំនួន ៧០ ភាគរយ និង ចិន ចំនួន ៣០ ភាគរយ អាស្រ័យ ទៅ លើ តម្រូវការ នៃ ទំហំ ការងារ ជាក់ស្តែង ។
បច្ចុប្បន្ន នេះ បុគ្គលិក - វិស្វករ - កម្មករ ក្រុមហ៊ុន ម៉ៅការ ពាក់ព័ន្ធ ទាំងនោះ នៅសល់ តែ ចំនួន ៩០៣ នាក់ ក្នុង នោះ បុគ្គលិក - វិស្វករ - កម្មករ ខ្មែរ ចំនួន ៣៤៦ នាក់ និង ចិន ចំនួន ៥៥៧ នាក់ ។
ក្នុង អំឡុង ពេល កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ នៃ សមាគម ប្រជាជាតិ អាស៊ី អាគ្នេយ៍ នៅ ថ្ងៃពុធ សប្តាហ៍ នេះ បាន យកចិត្តទុកដាក់ ចំពោះ ស្ថានភាព កាន់តែ យ៉ាប់យ៉ឺន នៅ តំបន់ ហ្គាហ្សា ដែល ជា កន្លែង ជន ស៊ីវិល ប៉ាឡេ ស្ទីន ជាង ១១.៣០០ នាក់ ត្រូវបាន សម្លាប់ ខណៈ ដែល អ៊ីស្រាអែល បន្ត ការទម្លាក់ គ្រាប់បែក ប្រចាំ ថ្ងៃ និង ការវាយប្រហារ តាម ផ្លូវគោក ។
លោក បាន បន្ថែម ថា « ជំហរ របស់ ឥណ្ឌូនេស៊ី គឺ ច្បាស់លាស់ និង រឹងមាំ ។ យើង ជំរុញ និង អំពាវនាវ ឱ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ អរិភាព ជាមួយនឹង ការបង្កើត ច្រក របៀង ជាបន្ទាន់ សម្រាប់ ជំនួយ មនុស្សធម៌ ។ ហើយ អំពើហិង្សា លើ ប្រជាជន ស៊ីវិល ត្រូវតែ បញ្ឈប់ » ។
លោក Hassan បាន និយាយ ដូច្នេះ ទៀត ថា « ប្រទេស ម៉ាឡេស៊ី បញ្ជាក់ ជាថ្មី នូវ ការ អំពាវនាវ ដ៏ រឹងមាំ របស់ ខ្លួន សម្រាប់ បទ ឈប់ បាញ់ ជាបន្ទាន់ ការទទួលបាន ជំនួយ មនុស្សធម៌ ដោយ មិន មាន ការរារាំង និង ការបដិសេធ រាល់ ការប៉ុនប៉ង ដើម្បី ជម្លៀស ប្រជាជន ប៉ាឡេស្ទីន ដោយ បង្ខំ ចេញ ពី ទឹកដី ស្រប ច្បាប់ របស់ ពួកគេ » ។
រដ្ឋមន្ត្រី ម៉ាឡេស៊ី រូប នេះ ក៏ បាន បញ្ជាក់ ឡើងវិញ នូវ គោលជំហរ របស់ ខ្លួន ថា ប៉ាឡេស្ទីន សម នឹង ទទួលបាន រដ្ឋ ឯករាជ្យ និង អធិបតេយ្យភាព របស់ ពួកគេ ដោយ ផ្អែក លើ ព្រំដែន មុន ឆ្នាំ ១៩៦៧ ដែល មាន ហ្សេរុយ សាឡឹម ខាងកើត ជា រដ្ឋធានី របស់ ខ្លួន ផងដែរ ។
គួរ បញ្ជាក់ ថា ឥណ្ឌូណេស៊ី និង ម៉ាឡេស៊ី គឺជា អ្នកគាំទ្រ ប៉ាឡេ ស្ទីន ដ៏ រឹងមាំ អស់ ជាច្រើន ទសវត្សរ៍ មក ហើយ ។ រដ្ឋាភិបាល ទាំង ពីរ មិន មាន ទំនាក់ទំនង ការទូត ជាមួយ អ៊ីស្រាអែល ទេ ហើយ បាន អំពាវនាវ ម្តង ហើយ ម្តង ទៀត ឱ្យ បញ្ចប់ ការកាន់កាប់ ទឹកដី ប៉ាឡេស្ទីន ។
ប្រជាជន ឥណ្ឌូណេស៊ី និង ម៉ាឡេស៊ី រាប់ ម៉ឺន នាក់ នៅក្នុង ទីក្រុង នានា បាន ដើរ តាម ផ្លូវ ដើម្បី បង្ហាញ ពី សាមគ្គីភាព របស់ ពួកគេ ជាមួយ ប៉ាឡេ ស្ទីន ចាប់តាំងពី ការចាប់ផ្តើម នៃ ការវាយប្រហារ ដ៏ សាហាវ របស់ អ៊ីស្រាអែល ទៅ លើ តំបន់ ហ្គាហ្សា កាលពី ខែ មុន ៕
ផ្សារ មូលបត្រ កម្ពុជា នឹង ដាក់ សម្ពោធ ជា ផ្លូវការ ប្រព័ន្ធ បើក គណនី ជួញដូរ តាម អនឡាញ នៅ ថ្ងៃស្អែក នេះ
( ភ្នំពេញ ) ៖ ផ្សារ មូលបត្រ កម្ពុជា ( ផមក ) បាន ចេញ សេចក្ដីជូនដំណឹង ពី ការដាក់ សម្ពោធ ជា ផ្លូវការ ប្រព័ន្ធ បើក គណនី ជួញដូរ តាម អនឡាញ ដើម្បីឱ្យ វិនិយោគិន ប្រើប្រាស់ នៅ ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
ប្រព័ន្ធ បើក គណនី ជួញដូរ តាម អនឡាញ ជា ប្រព័ន្ធ អនុញ្ញាតឱ្យ វិនិយោគិន ទទួលបាន គណនី ភ្លាម ៗ រៀងរាល់ ម៉ោង ធ្វើការ ដើម្បី បើក គណនី ជួញដូរ តាម អនឡាញ បាន វិនិយោគិន ត្រូវ ដោន ឡូត កម្មវិធី ទូរស័ព្ទ ផ្សារ ហ៊ុន និង តម្រូវឲ្យ វិនិយោគិន ចុច ពាក្យ បើក គណនី ជួញដូរ បន្ទាប់មក ត្រូវ ជ្រើសរើស ក្រុមហ៊ុន មូលបត្រ ដែល ខ្លួន ពេញចិត្ត ហើយ បំពេញ ព័ត៌មាន មួយចំនួន ស្តេន អត្តសញ្ញា ញប័ណ្ណ និង ស្កេន មុខ ។
បន្ទាប់ពី ក្រុមហ៊ុន មូលបត្រ បាន ពិនិត្យមើល ព័ត៌មាន របស់ អ្នក ស្នើសុំ រួចរាល់ នោះ លេខ អត្តសញ្ញា ញ វិនិយោគិន និង លេខ គណនី ជួញដូរ នឹង ត្រូវ បង្កើតឡើង ភ្លាម ៗ ។ ដូចនេះ វិនិយោគិន កាន់តែ មាន ភាពងាយស្រួល ឆាប់រហ័ស ចំណេញ ពេលវេលា និង ការចំណាយ ផ្សេង ៗ ដើម្បី ទទួលបាន គណនី ជួញដូរ ។ បន្ទាប់ពី បាន គណនី ជួញដូរ វិនិយោគិន អាច ដាក់ ប្រាក់ ចូល គណនី និង ជួញដូរ បាន ភ្លាម ៗ ផងដែរ ។
ការបើក គណនី ជួញដូរ មូលបត្រ តាម អនឡាញ ជា ផ្នែក មួយ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល ថ្មី ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋម នៃ កម្ពុជា ។
ផ្សារ មូលបត្រ កម្ពុជា សង្ឃឹម ថា ក្នុង ឆ្នាំ ២០២៤ ខាងមុខ នេះ នឹង មាន ការបើក គណនី កើនឡើង ប្រមាណ ៣ម៉ឺន ទៅ ៥ម៉ឺន គណនី ( ឬ ស្មើនឹង ជិត ១០០% នៃ ចំនួន គណនី បច្ចុប្បន្ន ) បន្ទាប់ពី ដាក់ ដំណើរការ ប្រព័ន្ធ នេះ ៕
វិភាគ អន្តរជា តិ៖ តើ របប សឹក មីយ៉ាន់ម៉ា កំពុង ចាញ់ ក្នុង សង្រ្គាម ស៊ីវិល ឬ ?
គួរ បញ្ជាក់ ថា ប្រធានាធិបតី នៃ របប សឹក មីយ៉ាន់ម៉ា លោក Myint Swe កាលពី ថ្ងៃទី ៨ ខែវិច្ឆិកា កន្លងទៅ នេះ បាន ព្រមាន ថា មីយ៉ាន់ម៉ា កំពុង ប្រឈមមុខ នឹង ហានិភ័យ នៃ ការពុះ ចែក ប្រទេស ជា ចំណែក ៗ ដោយសារតែ ការឆ្លើយតប មិន មាន ប្រសិទ្ធភាព របស់ យោធា ចំពោះ សកម្មភាព ឧទ្ទាម របស់ ក្រុម ចលនា ប្រដាប់អាវុធ ប្រឆាំង នឹង អំណាច របប សឹក ៕
ក្រសួង សុខាភិបាល និង KOICA ធ្វើ សន្និសីទ ផ្សព្វផ្សាយ សមិទ្ធផល របស់ « គម្រោង ពង្រឹង សុខភាព មាតា និង ទារក នៅ តំបន់ ឦសាន នៃ ប្រទេស កម្ពុជា
សន្និសីទ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី តំណាង អភិបាល នៃ គណអភិបាល ខេត្ដ មន្ទីរ សុខាភិបាល ខេត្ត មណ្ឌលគិរី និង ខេត្ត រតនគិរី មជ្ឈមណ្ឌល ជាតិ គាំពារ មាតា និង ទារក (NMCHC) មជ្ឈមណ្ឌល ជាតិ លើកកម្ពស់ សុខភាព (NCHP) និង មន្ត្រី ពាក់ព័ន្ធ គម្រោង សរុប ចំនួន ១០០ នាក់ ដើម្បី ធ្វើ ការចែករំលែក នូវ សមិទ្ធផល របស់ គម្រោង ដែល បាន អនុវត្ដ ក្នុង រយៈពេល ៥ឆ្នាំ ។
លោក វេជ្ជបណ្ឌិត ស៊ុង វិនតៈ បាន ថ្លែង ថា ក្នុង នាម លោក សាស្ត្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្រ្ដី ក្រសួង សុខាភិបាល សូម សម្តែង នូវ ការកោតសរសើរ ដល់ អង្គការ ហ្គូដ ណែប័រ កម្ពុជា ដែល បាន សហការ ជាមួយ មន្ទីរ សុខាភិបាល ទាំង ពីរ អនុវត្តន៍ គម្រោង និង ទទួល លទ្ធផល ជោគជ័យ តាម ការរំពឹងទុក ទោះ ក្នុង កាលៈទេសៈ នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក៏ដោយ ។
លោក រដ្ឋលេខាធិការ ក៏ បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល និង ប្រជាជន នៃ សាធារណរដ្ឋ កូរ៉េ តាមរយៈ KOICA ដែល បាន ផ្តល់ ការគាំទ្រ ដល់ វិស័យ សុខាភិបាល ជាច្រើន មិន ត្រឹមតែ គម្រោង គិរី នេះ មួយ ទេ ។ ទន្ទឹម នឹង នោះ លោក ក៏ បាន គូស រំលេច នូវ អាទិភាព វិស័យ សុខាភិបាល ទាំង៩ និង អាទិភាព ចំបង ចំនួន ៣ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា ក្រោម ការដឹកនាំ ដ៏ ប៉ិនប្រសព្វ បុរេសកម្ម ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
លោក រដ្ឋលេខាធិការ ក៏ បាន ថ្លែង កោតសរសើរ និង ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ ខេត្ត ទាំង ពីរ មន្ត្រី សុខាភិបាល ទាំងអស់ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ និង ប្រជាជន ទាំងអស់ នៅក្នុង ខេត្ត ទាំង ពីរ ដែល បាន គាំទ្រ សហការ អនុវត្តន៍ និង ចូលរួម យ៉ាង សកម្ម ធ្វើឱ្យ សុខភាព មាតា ទារក និង កុមារ នៅក្នុង ខេត្ត ទាំង ពីរ ឱ្យ កាន់តែ ប្រសើរឡើង ។
រដ្ឋមន្រ្តី សុខាភិបាល អញ្ជើញ ចុះ ពិនិត្យ ការផ្តល់ សេវា សុខាភិបាល ជូន ប្រជាពលរដ្ឋ នៅ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ លោក សាស្រ្តាចារ្យ ឈាង រ៉ា រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល បាន អញ្ជើញ ចុះ ពិនិត្យ ការផ្តល់ សេវា សុខាភិបាល ជូន ប្រជាពលរដ្ឋ ព្រមទាំង សំណេះសំណាល និង សួរសុខទុក្ខ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ និង បុគ្គលិក សុខាភិបាល នៃ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង ។
លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ក៏ បាន ជួប សំណេះសំណាល និង ថ្លែងអំណរគុណ ព្រមទាំង កោតសរសើរ ជូន ចំពោះ មន្រ្តី សុខាភិបាល ទាំងអស់ នៃ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង ដែល បាន ខិតខំ បម្រើ សេវា ថែទាំ សុខភាព ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ និង ក្រមសីលធម៌ វិជ្ជាជីវៈ ខ្ពស់ ។
ក្នុង ការចុះ ពិនិត្យ នេះ ដែរ លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី បាន វាយតម្លៃ ខ្ពស់ ពី ភាពរីកចម្រើន របស់ មន្ទីរពេទ្យ ទាំង សំណង់ អគា* រ ថ្មី ៗ និង អគារ ដែល មាន ស្រាប់ ដោយ ត្រូវបាន រៀបចំ និង ជួសជុល ឡើងវិញ បាន យ៉ាង ល្អ ប្រសើរ រួមទាំង សម្ភារៈ បរិក្ខារ វេជ្ជសាស្រ្ត និង ធនធាន មនុស្ស មាន ជំនាញ ច្បាស់លាស់ ក្នុង ការផ្តល់ សេវា ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ គុណភាព សុវត្ថិភាព ប្រសិទ្ធភាព និង សមធម៌ ។
ទន្ទឹមនឹង ការរីកចម្រើន នេះ លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ក៏ បាន ផ្តល់ អនុសាសន៍ បន្ថែម ទៀត ក្នុង ការបន្ត សកម្មភាព តទៅ មុខ ទៀត ដូច ជា៖
* ធ្វើ ទំនើបកម្ម មន្ទីរពេទ្យ ប្រកបដោយ ន វានុវត្តន៍ ឌីជីថល និង មាន ការទទួលស្គាល់ គុណភាព
* ពង្រឹង មណ្ឌល សុខភាព តាមរយៈ ការពង្រឹង ពង្រីក ហេដ្ឋារចនាសម្ព័ន្ធ ការបំពាក់ ឧបករណ៍ សម្ភារៈ បរិក្ខារ វេជ្ជសាស្រ្ត និង ការផ្គត់ផ្គង់ ឱសថ ឱ្យ បាន គ្រប់គ្រាន់ និង ទាន់ ពេលវេលា និង ការពង្រឹង សមត្ថភាព បុគ្គលិក ដើម្បី ធានា ការ ផ្តល់ សេវា ២៤ ម៉ោង លើ ២៤ ម៉ោង ។
* ពង្រឹង គុណភាព សេវា ថែទាំ សុខភាព នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក មន្ទីរពេទ្យ បង្អែក ខេត្ត និង មន្ទីរពេទ្យ ជាតិ ដោយ ផ្តោត ទៅ លើ ការពង្រឹង ផ្នែក ប្រពោធទនកម្ម ផ្នែក សង្គ្រោះ បន្ទាន់ ផ្នែក វះកាត់ ផ្នែក មន្ទីរពិសោធន៍ និង ផ្នែក រូបភាព វេជ្ជសាស្រ្ត ។
* ពង្រឹង សមត្ថភាព មន្រ្តី សុខាភិបាល នៅ គ្រប់ កម្រិត តាមរយៈ ការបណ្តុះបណ្តាល ផ្នែក ភាព ជា អ្នកដឹកនាំ និង ន វានុវត្តន៍ ។
ជា ចុងក្រោយ លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ស្នើសុំ ឱ្យ មន្រ្តី រាជការ និង បុគ្គលិក សុខាភិបាល ទាំងអស់ ត្រូវ ចេះ ជួយ គ្នា សហការ គ្នា សាមគ្គីភាព គ្នា និង ត្រូវ ខិតខំ ប្រឹង ព្យាយាម បន្ថែម ទៀត ក្នុង ការអភិវឌ្ឍ មន្ទីរពេទ្យ និង វិស័យ សុខាភិបាល ឱ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ដើម្បី ឈាន ទៅរក ការសម្រេចបាន នូវ ការគ្របដណ្តប់ សុខភាព ជា សកល ៕
ក្រសួង សាធារណការ បេីក កិច្ចប្រជុំ ពិភាក្សា ជាមួយ NEDA និង ក្រុមហ៊ុន ទីប្រឹក្សា បច្ចេកទេស សម្រាប់ ការចុះសិក្សា គម្រោង ធ្វើឱ្យ ប្រសើរ ឡើងវិញ ផ្លូវ ជាតិ លេខ ៦៨
( ភ្នំពេញ ) ៖ លោក ហ៊ុន សុរិទ្ធី អភិបាល រង រាជធានី តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន លើកឡើង ថា បច្ចុប្បន្ន ប្រជាពលរដ្ឋ ខ្មែរ ពាណិជ្ជករ ធុរ ជន វិនិយោគិន ជាតិ និង អន្តរជាតិ បាន នឹង កំពុង រីករាយ ទទួល នូវ មនុញ្ញ ផល នៃ ការអនុវត្ត គោល នយោបាយ យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ដោយ ផ្តោត ទៅ លើ វិស័យ កសិកម្ម . ឧស្សាហកម្ម . វិស័យ សំណង់ និង ទេសចរណ៍ ។
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ហ៊ុន សុរិទ្ធី អញ្ជើញ ចូលរួម ក្នុង ពិធី សម្ពោធ ជា ផ្លូវការ សាខា ក្នុង ស្រុក ក្រុមហ៊ុន តូយ៉ូតា ( ខេមបូឌា ) ស្ថិត នៅ តាម បណ្តោយ ផ្លូវ សម្តេច តេជោ ហ៊ុន សែន ( ផ្លូវ ៦០ម៉ែត្រ ) ភូមិ ទួល រកា សង្កាត់ ចាក់អង្រែ ក្រោម ខណ្ឌ មានជ័យ នៅ ល្ងាច ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
លោក ហ៊ុន សុរិទ្ធី បាន លើកឡើង ថា ការសម្ពោធ ជា ផ្លូវការសាខា ក្នុង ស្រុក ក្រុមហ៊ុន តូយ៉ូតា ( ខេមបូឌា ) ស្ថិត ក្នុង ខណ្ឌ មានជ័យ នា ពេលនេះ គឺ ពិតជា បាន ឆ្លុះបញ្ចាំង ឲ្យ ឃើញ ពី ការសម្រេចចិត្ត ដ៏ ត្រឹម ត្រូវ របស់ ក្រុមហ៊ុន តូយ៉ូតា ។
លោក ថា នេះ ជា ជោគជ័យ ថ្មី មួយ ទៀត នៃ ការអនុវត្ត កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ បញ្ចា កោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ ក្នុង ការខិតខំ ទាក់ទាញ នូវ ការវិនិយោគ ទាំង ក្នុង និង ក្រៅ ប្រទេស ជាពិសេស គឺ ការខិតខំ បង្កើន ជំនឿ ជឿជាក់ ជូន ដល់ ពាណិជ្ជករ វិនិយោគ និង ធុរ ជន ដើម្បី បណ្តាក់ទុន ធ្វើ អាជីវកម្ម នៅ កម្ពុជា សំដៅ រួមចំណែក ជំរុញ ឲ្យ មាន កំណើន សេដ្ឋកិច្ច បង្កើត ការងារ កាត់បន្ថយ ភាពក្រីក្រ និង អភិវឌ្ឍន៍ រាជធានី ភ្នំពេញ ឲ្យ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ។
សមត្ថកិច្ច បង្ហាញ អត្តសញ្ញាណ ក្រុម ជន ដៃ ដល់ ដែល បាញ់ បោះ សេរី នៅ ភ្នំ គិរីរម្យ ខណៈ ម្ចាស់ ទីតាំង បន្ដ គេចខ្លួន
( ភ្នំពេញ ) ៖ អត្តសញ្ញាណ ក្រុម ជន ដៃ ដល់ ចំនួន ៤នាក់ ដែល បាញ់ បោះ សេរី យ៉ាង អនាធិបតេយ្យ នៅ ផ្ទះ លំហែ លើ ភ្នំ គិរីរម្យ ( ចំការតែ ) ស្ថិត ក្នុង ភូមិ ថ្មី ឃុំ ចំបក់ ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ កាលពី ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ត្រូវបាន សមត្ថកិច្ច បង្ហាញ បន្ទាប់ពី ពួកគេ ចូល សារភាព កំហុស នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
ទាក់ទិន ករណី នេះ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន អះអាង ថា នៅ រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ថា មន្ដ្រី នគរបាល ដៃ ដល់ ចំនួន ៤នាក់ ដែល បាញ់ បោះ សេរី នៅ ផ្ទះ លំហែ លើ ខ្នងភ្នំ គិរីរម្យ នឹង ត្រូវ បណ្ដេញចេញ ពី ក្របខ័ណ្ឌ មន្ដ្រី នគរបាល ជាតិ កម្ពុជា ។
ក្នុង ឱកាស អញ្ជើញ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ស្ពាន កោះនរា សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា បើ តាម អ្វី ដែល ទេសរដ្ឋមន្ដ្រី ឆៃ ស៉ី ណារិទ្ធ បាន រាយការណ៍ ជូន សម្ដេច ហេតុការណ៍ បាញ់ បោះ សេរី នៅ ភ្នំ គិរីរម្យ គឺជា មន្ដ្រី នគរបាល ចំនួន ៤រូប ហើយ នឹង ត្រូវ បណ្ដេញចេញ ពី ក្របខ័ណ្ឌ តែម្ដង ។
សូម រំលឹក ថា ស្នូរ គ្រាប់ កាំភ្លើង ជាច្រើន គ្រាប់ បាន បន្លឺ ឡើង យ៉ាង កង រំពង នៅ យប់ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដែល ឮ ចេញ ពី ក្នុង ពិធី ខួបកំណើត មួយ ស្ថិត នៅ ចំណុច ផ្ទះ លំហែ ភូមិ ថ្មី ( ចំការតែ ) ឃុំ ចំបក់ ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ ( លើ ខ្នងភ្នំ គិរីរម្យ ) ដែល សមត្ថកិច្ច អះអាង ថា ជា កម្មសិទ្ធិ របស់ ឈ្មោះ កង តារាវិឆៃ ភេទ ប្រុស អាយុ ប្រហែល ២៨ ឆ្នាំ រស់ នៅ រាជធានី ភ្នំពេញ ។
អង្គការ សហ ប្រជាជាតិ និង កាកបាទ ក្រហម សម្តែង ការកត់ស្លុត ចំពោះ ការវាយឆ្មក់ របស់ អ៊ីស្រាអែល លើ មន្ទីរពេទ្យ Al Shifa ក្នុង តំបន់ ហ្គាហ្សា
( ហ្សឺណែវ ) ៖ អង្គការ សហ ប្រជាជាតិ និង កាកបាទ ក្រហម បាន សម្តែង ការកត់ស្លុត និង ព្រួយបារម្ភ របស់ ពួកគេ បន្ទាប់ពី កងកម្លាំង អ៊ីស្រាអែល បាន វាយ ឆ្មក់ ចូល មន្ទីរពេទ្យ ដ៏ ធំ បំផុត នៅ ហ្គាហ្សា ហើយ បាន អំពាវនាវ ឱ្យ មាន ការ ការពារ អ្នកជំងឺ និង ជន ស៊ីវិល រាប់ ពាន់ នាក់ នៅ ទីនោះ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
កងកម្លាំង អ៊ីស្រាអែល បាន វាយ ឆ្មក់ ចូល មន្ទីរពេទ្យ Al Shifa នៅ ព្រឹក ថ្ងៃពុធ សប្តាហ៍ នេះ ដោយ ផ្តោត លើ អ្វី ដែល ពួកគេ និយាយ ថា ជា មជ្ឈមណ្ឌល បញ្ជាការ របស់ ក្រុមហា ម៉ាស នៅក្នុង ផ្លូវ រូង ក្រោម ដី ដែល ស្ថិត នៅក្រោម អ្នកជំងឺ និង ជន ស៊ីវិល រាប់ ពាន់ នាក់ ដែល កំពុង ស្វែងរក ទី ជម្រក ពី ការប្រយុទ្ធ គ្នា ដ៏ ខ្លាំងក្លា ។
លោក បាន មានប្រសាសន៍ ទៀត ថា « ការការពារ ទារក ទើបនឹង កើត អ្នកជំងឺ បុគ្គលិក ពេទ្យ និង ជន ស៊ីវិល ទាំងអស់ ត្រូវតែ មាន អាទិភាព លើកង្វល់ ផ្សេង ទៀត ទាំងអស់ » ដោយ បាន សង្កត់ធ្ងន់ ថា « មន្ទីរពេទ្យ មិន មែន ជា សមរភូមិ ទេ » ។
គណៈកម្មាធិការ អន្តរជាតិ នៃ កាកបាទ ក្រហម (ICRC) បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា ខ្លួន មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង អំពី ផល ប៉ះពាល់ លើ អ្នកជំងឺ និង របួស បុគ្គលិក ពេទ្យ និង ជន ស៊ីវិល ។
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៦.៥៣៤ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥.៦៥៩ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៨៧៥ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង អត់ បណ្ណ បើកបរ ល្មើស ភ្លើង - ផ្លាក សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ឆៀក ស្រវឹង ដឹក សំពីង សំពោង គ្មាន ភ្លើង បំភ្លឺ ល្មើស ភ្លើង - ផ្លាក សញ្ញា អត់ បណ្ណ បើកបរ និង ល្មើស ល្បឿន ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១២លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៩ នាក់ របួស ចំនួន ២១នាក់ ( របួស ធ្ងន់ ចំនួន ០៦ នាក់ ) ។ រយៈពេល ១៥ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១៣១ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៦៤ នាក់ របួស ១៨៤ នាក់ ( របួស ធ្ងន់ ១១៣ នាក់ )៕
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា ការអភិវឌ្ឍ ដែល មាន ន័យ បំផុត គឺ ការអភិវឌ្ឍ ដែល បាន ផលប្រយោជន៍ ទៅដល់ ប្រជាពលរដ្ឋ ទូទៅ ទាំងអស់ ហើយ កោះន រា នេះ ទៀតសោត ប្រៀប ដូចជា ការជប់ ដី ដែល ត្រូវបាន លុប បាត់ ហើយ ធ្វើឲ្យ រីក ឡើងវិញ កាន់ ខ្ពស់ សម្រាប់ ប្រជាពលរដ្ឋ គ្រប់ រូប ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី តំបន់ កោះន រា នឹង ត្រូវ អភិវឌ្ឍន៍ ជា បន្ដ បន្ទាប់ មិន ចាញ់ តំបន់ កោះ ពេជ្រ នោះ ទេ ពោល នឹង បង្កើត ទៅជា តំបន់ សេដ្ឋកិច្ច ឧស្សាហកម្ម ទៅ តាម អ្វី ដែល បាន គ្រោង ទុក ។
សម្ដេច ធិបតី ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចាត់ទុក ការអភិវឌ្ឍន៍ កោះន រា គឺជា ការស្រង់ ស្ថានភាព កោះ ដែល ពីមុន ត្រូវបាន បាក ចូល ទន្លេ ហើយ ការអភិវឌ្ឍន៍ នេះ បាន ក្លាយទៅជា កន្លែង មាន សក្តានុពល ផ្នែក សេដ្ឋកិច្ច ខ្ពស់ តំបន់ កោះន រា ខណៈ កាល មុន ចិញ្ចឹម ប្រជាជន មិន ច្រើន ប្រកបរបរ កសិកម្ម តែ ឥលូវ នឹង ប្រែក្លាយទៅជា តំបន់ ពហុ សកម្មភាព សេដ្ឋកិច្ច ដែល នឹង មាន ការអភិវឌ្ឍ ផ្សេង ៗ ។
ក្នុង ន័យ នេះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បង្ហាញ ក្តីសង្ឃឹម ថា ក្រុមហ៊ុន អ្នក ឧកញ៉ា ពុង ឃាវ សែ នឹង បន្ត យកចិត្តទុកដាក់ ក្នុង ការអភិវឌ្ឍន៍ តំបន់ កោះន រា ទៅ តាម ផែនការគ្រោងទុក ។
បើ តាម ការបញ្ជាក់ របស់ អ្នក ឧកញ៉ា ពុង ឃាវ សែ អគ្គ នាយក ក្រុមហ៊ុន OCIC ការចំណាយ របស់ ក្រុមហ៊ុន សម្រាប់ គម្រោង កោះន រា ចាប់ពី ដំបូង រហូតមកដល់ ពេលនេះ ក្រុមហ៊ុន បាន ចំណាយ ជាង ៣០០ លាន ដុល្លារ រួច មកហើយ និង ត្រូវ ចំណាយ ខ្ទង់ រយ លាន ដុល្លារ បន្ថែម ទៀត ដើម្បីឲ្យ គម្រោង ទីក្រុង រណប កោះន រា នេះ អាច បញ្ចប់ ការសាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ទាំងអស់ នៅក្នុង ឆ្នាំ ២០២៥ ខាងមុខ មិន រាប់បញ្ចូល ការសាងសង់ អគារ ។
សម្ដេច ធិបតី បាន ណែនាំ ឱ្យ រដ្ឋបាល រាជធានី ភ្នំពេញ បន្ត គិតគូរ ពី ការរៀបចំ ហេដ្ឋារចនាសម្ពន្ធ សាធារណៈ ដើម្បី សម្រួល កុំ ឱ្យ មាន ការស្ទះ ចរាចរណ៍ នៅក្នុង ក្រុង ។
សម្ដេច ធិបតី បាន បង្ហាញ បំណង សិក្សា គម្រោង សាងសង់ ផ្លូវ អាកាស និង ផ្លូវ ក្រោម ដី ក្នុង រាជធានី ភ្នំពេញ បន្ថែម ទៀត ពិសេស ការពង្រីក ទីក្រុង ដើម្បី សម្រួល ការធ្វើចរាចរណ៍ របស់ ប្រជាពលរដ្ឋ ក្នុង ក្រុង ។
សម្ដេច ធិបតី បាន បន្ត ថា ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ក៏ មាន ផែនការ មេក្នុង ការពង្រីក ទីក្រុង ទៅ ក្រៅ ផងដែរ ដែល ការពង្រីក ទីក្រុង នេះ ត្រូវ គិតគូរ អំពី ហេដ្ឋារចនាសម្ពន្ធ សាធារណៈ ជា ចាំបាច់ ។
ការលើកឡើង បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស សម្តេច បាន អញ្ជើញ សម្ពោធ ដាក់ ឱ្យ ប្រើ ប្រាស់ ជា ផ្លូវការ នូវ ស្ពាន កោះន រា ។
ជាមួយគ្នា នេះ ដែរ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ណែនាំ ឱ្យ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ ពង្រឹង និង បង្កើន សមត្ថភាព ផ្តល់ សេវា ដឹកជញ្ជូន តាម ផ្លូវគោក របស់ រដ្ឋាករ ស្វយ័ត ដឹកជញ្ជូន សាធារណៈ រថយន្តក្រុង ក្នុង នោះ ត្រូវ សិក្សា ពង្រាយ ទីតាំង ខ្សែ រត់ បន្ថែម ឆ្លងកាត់ តំបន់ កោះន រា និង ទីក្រុង រណប កោះ ពេជ្រ ព្រមទាំង តំបន់ អភិវឌ្ឍន៍ ថ្មី ដើម្បី បង្កើន ការទាក់ទាញ អ្នកនិយម ការប្រើប្រាស់ មធ្យោបាយ រួម និង សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កំពុង សិក្សា បន្ថែម លើ ការកសាង ផ្លូវ អាកាស ប្រព័ន្ធ ដឹកជញ្ជូន សាធារណៈ និង ប្រព័ន្ធ ផ្លូវ ក្រោម ដី ក្នុង រាជធានី ភ្នំពេញ ដើម្បី សម្រួល ការធ្វើចរាចរណ៍ ព្រមទាំង ការពង្រីក ទីក្រុង ជាដើម ។
