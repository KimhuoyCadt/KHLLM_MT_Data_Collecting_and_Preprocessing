( ភ្នំពេញ ) ៖ លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នា រសៀល ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ប្រគល់ កុំព្យូទ័រ ១៥០ គ្រឿង តុ និង កៅអី ចំនួន ១៥០ ឈុត និង រៀបចំ បន្ទប់ ICT Lab ចំនួន ១ បន្ទប់ ជូន សាកលវិទ្យាល័យ ការពារ ជាតិ តំណាង ដោយ នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ ជា តារា សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ការពារ ជាតិ ។
នៅក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី បាន ថ្លែង ថា ចំពោះ សម្ភារៈ ដែល បាន ប្រគល់ ជូន នៅ ពេល នេះ គឺ ដើម្បី ឆ្លើយតប នឹង តម្រូវការប្រើប្រាស់ របស់ សាកលវិទ្យាល័យ ការពារ ជាតិ ក្នុង គោលបំណង ជំរុញ ការងារ បណ្តុះបណ្តាល ដល់ និស្សិត នាយ ទាហាន ជំនាញ ព័ត៌មានវិទ្យា យោធា ។
លោក រដ្ឋមន្ត្រី បាន បន្ថែម ថា ចំពោះ កុំព្យូទ័រ ១៥០ គ្រឿង ដែល បាន ប្រគល់ ជូន នៅ ពេល នេះ ជា ប្រភេទ កុំព្យូទ័រ ដែល មាន សមត្ថភាព ខ្ពស់ ដើម្បី ឆ្លើយតប នឹង ការរៀន បច្ចេកវិទ្យា ដែល មាន ភាពស្មុគស្មាញ របស់ មុខវិជ្ជា នីមួយ ៗ ។
លោក រដ្ឋមន្ត្រី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សាកលវិទ្យាល័យ ការពារ ជាតិ ដែល បាន រួមចំណែក យ៉ាង សកម្ម លើ ការលើកកម្ពស់ ពង្រឹង សមត្ថភាព កងទ័ព ឲ្យ មាន ចំណេះដឹង ចំណេះ ធ្វើ និង វិជ្ជាជីវៈ យ៉ាង ពិតប្រាកដ ក្នុង ការទទួលខុសត្រូវ បំពេញ ភារកិច្ចការពារ បូរណភាព ទឹកដី ការពារ សន្តិភាព ការអភិវឌ្ឍ និង ការរស់នៅ ដ៏ សុខសាន្ត របស់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី ។
ជា ការឆ្លើយតប នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ បាន ថ្លែងអំណរគុណ ដល់ លោក រដ្ឋមន្ត្រី ក្នុង ការចូលរួម អភិវឌ្ឍ ធនធាន មនុស្ស នៅក្នុង ប្រទេស កម្ពុជា ជាពិសេស លើ ជំនាញ ព័ត៌មានវិទ្យា យោធា និង ក្នុង ការចូលរួមចំណែក ក សាង រាជ រដ្ឋាភិបាល ឌីជីថល ស្រប តាម យុទ្ធសាស្រ្ត បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល ដើម្បី ជំរុញ អភិបាលកិច្ច និង បច្ចេកវិទ្យា ឌីជីថល ។
សូម ជម្រាប ជូន ថា សាកលវិទ្យាល័យ ការពារ ជាតិ ជា គ្រឹះស្ថាន ឧត្តម សិក្សា របស់ ក្រសួង ការពារ ជាតិ នាំមុខ គេ លើ ផ្នែក សិក្សា ស្រាវជ្រាវ វិទ្យាសាស្រ្ត យោធា ការសិក្សា វិទ្យាសាស្ត្រ សង្គម និង ភាសា វិទ្យាសាស្ត្រ ពិត និង ការអប់រំ ហ្វឹកហ្វឺន បណ្តុះបណ្តាល វិជ្ជាជីវៈ អាជីព ដែល មាន ការទទួលស្គាល់ កម្រិត ថ្នាក់ ជាតិ និង អន្តរជាតិ ៕
ក្រសួង ធនធាន ទឹក ជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ . អាច មាន ភ្លៀង ធ្លាក់ ពី តិច ទៅ បង្គួរ
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស នៅ ព្រះរាជាណាចក្រ កម្ពុជា សម្រាប់ ថ្ងៃទី ៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ក្រសួង បញ្ជាក់ ថា ប្រព័ន្ធ សម្ពាធ ខ្ពស់ ពី ប្រទេស ចិន លាតសន្ធឹង មក លើ ភាគ ខាងជើង និង ភាគ ឦសាន នៃ ព្រះរាជាណាចក្រ កម្ពុជា រួម ជាមួយ ខ្យល់ មូសុង ឦសាន ខ្សោយ ។ ទន្ទឹមនឹង នេះ មាន ចរន្ដ ខ្យល់ ក្ដៅ ហើយ សើម ពី សមុទ្រ ចិន ខាងត្បូង នឹង បក់ ពី ទិស ខាងកើត និង ទិស អាគ្នេយ៍ មក លើ ប្រទេស កម្ពុជា ។ ស្ថានភាព បែប នេះ នឹង ធ្វើឱ្យ ធាតុអាកាស នៅ ថ្ងៃទី ៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ៖
១៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត៖ ក្រសួង រៀបចំ ដែនដី កំពុង ពន្លឿន ការចែក បណ្ណ កម្មសិទ្ធិ ដីធ្លី ជូន ពលរដ្ឋ ខណៈ បច្ចុប្បន្ន ចែក បាន ២លាន ក្បាល ដី និង នៅសល់ ៥លាន ក្បាល ដី ទៀត
២៖ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ដាក់ ចេញ ផែនការ មេអភិវឌ្ឍន៍ ខេត្ត ជាប់ សមុទ្រ ពិសេស ខេត្ត ព្រះសីហនុ ដែល មាន សក្ដានុពល ខ្លាំង សម្រាប់ ជាតិ
៣៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត៖ ដើម្បី ទាក់ទាញ ទេសចរណ៍ និង ការវិនិយោគ នៅ ខេត្ត ព្រះសីហនុ ត្រូវ ភ្ជាប់ ជើងហោះហើរ ជាមួយ តំបន់ ទេសចរណ៍ ល្បី ៗ និង ពង្រឹង សន្តិសុខ . ភូមិសាស្ត្រ ខេត្ត នេះ ប្រៀប ដូចជា គ្រាប់ ពេជ្រ
៤៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត សាទ រ និង រីករាយ ចំពោះ ការចាប់ផ្តើម ដំណើរការ ការដ្ឋាន សាងសង់ កំពង់ផែ ទឹក ជ្រៅ ខេត្ត ព្រះសីហនុ ដំណាក់កាល ទី១ មុន ដាច់ ឆ្នាំ ២០២៣
៥៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត រំលឹក ថា ពេល សម្តេច ចាប់កំណើត ក្នុង ផ្ទៃ បាន ៧ខែ ត្រូវ ជាប់ នៅ កន្លែង ឃុំឃាំង ជាមួយ ម្តាយ . ខណៈពេល នៅពេល កើត មាន ជំងឺ ក្តៅ ខ្លួន ខ្លាំង រហូត ពេទ្យ ណែនាំឲ្យ ម្តាយ ត្រៀម ចិត្ត
៦៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំឲ្យ រៀបចំ ផ្លូវ ដែក អាច ឲ្យ រត់ បាន ល្បឿន ៨០ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង
៨៖ តាំងពី ក្លាយជា នាយក រដ្ឋមន្ត្រី សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ស្គាល់ តែ បន្ទប់ គេង ការិយាល័យ ធ្វើ ការ ឯកសារ ផ្លូវ ទៅ ធ្វើ ការ និង ធ្វើការ ខណៈ កម្មវិធី ផ្សេង ៗ លែង ត្រូវបាន គេ អញ្ជើញ ហើយ
ក្រសួង ការបរទេស អាមេរិក បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា « លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន លោកស្រី Kamikawa សម្រាប់ ការថ្កោលទោស ចំពោះ ការវាយប្រហារ របស់ ក្រុមហា ម៉ាស លើ ប្រទេស អ៊ីស្រាអែល និង សម្រាប់ ការចូលរួម រំលែក ទុក្ខ ដល់ ពលរដ្ឋ អាមេរិក ដែល បាន បាត់បង់ជីវិត » ។
មន្ត្រី និង អ្នកវិភាគ និយាយ ថា ប្រទេស ជប៉ុន បាន ចាត់ វិធានការ យ៉ាង ប្រុងប្រយ័ត្ន ចំពោះ វិបត្តិ នេះ ដោយ រក្សា ជំហរ របស់ ខ្លួន ឱ្យ ស្រប តាម ជំហរ គាំទ្រ អ៊ីស្រាអែល នៃ សម្ព័ន្ធមិត្ត ជិតស្និទ្ធ បំផុត របស់ ខ្លួន គឺ សហរដ្ឋ អាមេរិក ៕ រូបភាព ពី AFP អង់គ្លេស នឹង រៀបចំ កិច្ចប្រជុំ បន្ទាន់ មួយ ស្តីពី ផល ប៉ះពាល់ នៃ សង្គ្រាម អ៊ីស្រាអែល - ហាម៉ាស់ លើ សហគមន៍ របស់ ខ្លួន
( ឡុងដ៍ ) ៖ រដ្ឋាភិបាល អង់គ្លេស នឹង បើក កិច្ចប្រជុំ បន្ទាន់ មួយ ដើម្បី ឆ្លើយតប ទៅនឹង ផល ប៉ះពាល់ នៃ សង្រ្គាម រវាង អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស លើ ការរួបរួម សង្គម ក្នុង ប្រទេស អង់គ្លេស នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ ចំពេល មាន ការព្រួយបារម្ភ ក្នុង ចំណោម រដ្ឋមន្ត្រី អំពី ការតវ៉ា គាំទ្រ ប៉ាឡេស្ទីន ដែល គ្រោង នឹង ធ្វើឡើង ដើម្បី ទាមទារ បទ ឈប់ បាញ់ នា ថ្ងៃ ឈប់សម្រាក នៅ ចុង សប្តាហ៍ នេះ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
អ្នកនាំពាក្យ របស់ នាយក រដ្ឋមន្ត្រី Rishi Sunak បាន និយាយ យ៉ាង ដូច្នេះ ថា « ឧប នាយក រដ្ឋមន្ត្រី នឹង ធ្វើជា ប្រធាន កិច្ចប្រជុំ ឆ្លើយតប បន្ទាន់ មួយ ដើម្បី សម្របសម្រួល ការឆ្លើយតប របស់ រដ្ឋាភិបាល ចំពោះ ស្ថានភាព នៅ អ៊ីស្រាអែល និង ហ្គាហ្សា » ។
សេចក្តីថ្លែងការណ៍ បាន បន្ត ថា « វា នឹង មើល ទៅ លើ ផ្នែក ដ៏ ធំ ទូលាយ ប៉ុន្តែ ជាក់ស្តែង ជាមួយនឹង ការផ្តោត ជាពិសេស លើ ផល ប៉ះពាល់ នៃ ការវាយប្រហារ ភេរវកម្ម មក លើ ចក្រភព អង់គ្លេស និង របៀប ដែល អាច ដោះស្រាយ បញ្ហា សំខាន់ ៗ មួយចំនួន ជុំវិញ ការរួបរួម សហគមន៍ »៕ រូបភាព ពី AFP ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន ជួប ពិភាក្សា ការងារ ជាមួយ ឯក អគ្គ រដ្ឋទូត អាមេរិក ប្រចាំ កម្ពុជា ដោយ ផ្ដោត សំខាន់ លើ ការងារ សន្ដិសុខ និង ពង្រឹង ទំនាក់ទំនង
ជំនួប ដ៏ មាន សារៈសំខាន់ នេះ ត្រូវបាន ធ្វើឡើង ដើម្បី ពង្រឹង បន្ដ កិច្ចសហប្រតិបត្តិការ លើ ការងារ សន្ដិសុខ ផ្លាស់ប្ដូរ ព័ត៌មាន ដើម្បី ទប់ស្កាត់ អំពើ ភេរវកម្ម បទល្មើស បច្ចេកវិទ្យា និង បទឧក្រិដ្ឋ ឆ្លង ដែន គ្រប់ ប្រភេទ ព្រមទាំង បន្ដ លើ ការងារ បណ្ដុះបណ្ដាល ពិសេស ជំនាញ បទល្មើស បច្ចេកវិទ្យា បទល្មើស ប្រឆាំង ការសម្អាត ប្រាក់ និង ប្រឆាំង គ្រឿងញៀន ជាដើម ។
ក្នុង ឱកាស នោះ លោក ឯក អគ្គ រដ្ឋទូត W. Patrick Murphy បាន សម្ដែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង លើ ការងារ ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នា ពេល កន្លងមក ក្រោម ការដឹកនាំ បញ្ជា ផ្ទាល់ របស់ ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន កាល នៅ ជា អគ្គ ស្នងការ នគរបាល ជាតិ ។ ពិសេស ការពារ ព្រឹត្តិការណ៍ សំខាន់ នានា ក្នុង នោះ មាន ទាំង ដំណើរ ចូលរួម កិច្ចប្រជុំ របស់ ប្រធានាធិបតី អាមេរិក នៅ កម្ពុជា ហើយក៏ ទទួលបាន នូវ ការកោតសរសើរ ពី ស្ថាប័ន ការពារ ផ្ទាល់ របស់ ប្រធានាធិបតី ។
លោក ឯក អគ្គ រដ្ឋទូត អាមេរិក បាន អះអាង ថា កន្លងមក ក្រុមការងារ នេះ បាន ជួយ ធ្វើ ការងារ ជាច្រើន ក្នុង ការបង្ការ បទល្មើស ដែល បង្ក ដោយ ពលរដ្ឋ អាមេរិក ដើម្បី ចាប់ ជន បង្ក ទាំងនោះ បញ្ជូន ទៅ ផ្ដន្ទាទោស នៅ អាមេរិក វិញ ហើយ បម្រើ ដល់ ប្រយោជន៍ រដ្ឋាភិបាល អាមេរិក ជាច្រើន ផងដែរ ។
ជា ការឆ្លើយតប ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន បាន ឯកភាព ទាំងស្រុង ចំពោះ សំណូមពរ របស់ ឯក អគ្គ រដ្ឋទូត អាមេរិក និង បាន សំណូមពរ ទៅកាន់ ភាគី អាមេរិក វិញ ឲ្យ បន្ដ ជួយ លើ ការងារ បណ្ដុះបណ្ដាល មន្ដ្រី ជំនាញ មន្ដ្រី បច្ចេកទេស ក៏ ដូចជា សម្ភារៈ នានា ដែល បម្រើ ដល់ ការងារ ប្រយុទ្ធ ប្រឆាំង បទល្មើស បទឧក្រិដ្ឋ ឆ្លង ដែន គ្រប់ ប្រភេទ បទល្មើស ប្រឆាំង ភេរវកម្ម និង បទល្មើស គ្រឿងញៀន ជាដើម ។
បន្ថែម ពី នេះ ភាគី ទាំង ពីរ ក៏ បាន ពិភាក្សា គ្នា អំពី កិច្ចសហប្រតិបត្តិការ លើ ការងារ ប្រឆាំង ការជួញដូរ មនុស្ស លុបបំបាត់ អំពើ កេងប្រវ័ញ ផ្លូវភេទ លើ កុមារ ក៏ ដូចជា ចូលរួមចំណែក ក្នុង ការដាក់ទោស ឲ្យបាន ធ្ងន់ធ្ងរ លើ ជន ដែល ប្រព្រឹត្ត បទល្មើស នេះ ផងដែរ ៕
អ្នកនាំ សាលា ខេត្ត កណ្ដា ល៖ ការប្រឡង បាក់ឌុប នៅ ឆ្នាំ ២០២៣ ប្រព្រឹត្តទៅ ដោយ រលូន ល្អ
បើ តាម លោក ចេង សំអុល ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត កណ្ដាល បាន ឱ្យដឹង ថា ការប្រឡង មាន ការយាម កាម បាន តឹងរឹង ល្អ មិន អាច មាន ការបន្លំ យក ព្រី យ៉ុង ចូល បាន ទេ គឺ ប្រឡង ដោយ សមត្ថភាព ។
សូម ជម្រាប ថា ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សិក្សា ទុតិយភូមិ មាន រយៈពេល ២ ថ្ងៃ គឺ ថ្ងៃទី ៦ និង ទី៧ ខែវិច្ចិកា ឆ្នាំ ២០២៣ ខណៈ ដែល ខេត្ត កណ្ដាល មាន មណ្ឌល ប្រឡង ចំនួន ១៧ មណ្ឌល ស្មើនឹង ៤៥១ បន្ទប់ ដែល ស្ថិត នៅ ក្រុង / ស្រុក ចំនួន ៤៖
ខេត្ត កណ្តាល ឆ្នាំ នេះ មាន បេក្ខជន មាន ឈ្មោះ ក្នុង បញ្ជី ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ សរុប ចំនួន ១០. ៨៧៣ នាក់ ស្រី ៦.០២៣ នាក់ ។ បើ ធៀប ទៅនឹង ឆ្នាំ សិក្សា ២០២១ - ២០២២ ខេត្ត មាន មណ្ឌល ប្រឡង ថយចុះ ចំនួន ០២ មណ្ឌល រីឯ បេក្ខជន បាន កើនឡើង ចំនួន ៧៣០ នាក់ ស្រី ៣៥៦ នាក់ ៕ ក្រសួង បរិស្ថាន និង សមាគម អភិរក្ស ដំរី ខ្មែរ អៃ រាវត្តា ពង្រឹង ការផ្សព្វផ្សាយ ផ្សារភ្ជាប់ ដំរី ធម្មជាតិ និង ជនជាតិ ដើម ជំរុញ វិស័យ អេកូ ទេសចរណ៍ ខេត្ត រតនគិរី
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន អនុញ្ញាតឱ្យ សមាគម អភិរក្ស ដំរី ខ្មែរ អៃ រាវត្តា ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ដើម្បី ជំរុញ ការផ្សព្វផ្សាយ ផ្សារភ្ជាប់ ដំរី ធម្មជាតិ និង ជនជាតិ ដើម ក្នុង គោលបំណង លើកកម្ពស់ វិស័យ អេកូ ទេសចរណ៍ ខេត្ត រតនគិរី ។ ជំនួប សម្តែង ការគួរសម នេះ បាន ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង នា រសៀល ថ្ងៃទី ០៧ វិច្ឆិកា ឆ្នាំ ២០២៣ ។
លោកស្រី ក្លេខៃ ចិន្តា ប្រធាន ក្រុមប្រឹក្សាភិបាល និង ជា ប្រធាន សមាគម អភិរក្ស ដំរី ខ្មែរ អៃ រាវត្តា បាន ជម្រាប ជូន លោក រដ្ឋមន្រ្តី ថា បច្ចុប្បន្ន សមាគម អៃ រាវត្តា មាន ដំរី ចំនួន ៤ក្បាល ក្នុង នោះ រួម មាន ដំរី ញី១ ក្បាល ឈ្មោល ២ក្បាល និង កូន ដំរី ញី១ ក្បាល ទៀត ឈ្មោះ ណូអែល ទេវី ។ ជាមួយគ្នា នេះ សមាគម អភិរក្ស ដំរី ខ្មែរ អៃ រាវត្តា បាន ស្នើសុំ ការគាំទ្រ បន្ថែម ទៀត ពី ក្រសួង បរិស្ថាន លើ សកម្មភាព អេកូ ទេសចរណ៍ និង ជួយ ផ្សព្វផ្សាយ វិស័យ នេះ ឱ្យ កាន់តែ ទូលំទូលាយ ថែម ទៀត ។
ឆ្លើយតប នឹង ការលើកឡើង នេះ លោក រដ្ឋមន្រ្តី សូម គាំទ្រ ការអភិវឌ្ឍ សកម្មភាព អេកូ ទេសចរណ៍ និង ជួយ ផ្សព្វផ្សាយ វិស័យ នេះ ក្រសួង បរិស្ថាន សូម គាំទ្រ ទាំងស្រុង ហើយ នឹង រៀបចំ ពិនិត្យមើល លទ្ធភាព ក្នុង ការជួយ ជំរុញ ការអភិវឌ្ឍ តំបន់ ទេសចរណ៍ ដោយ របៀប ណា ទៅ ទិសដៅ ណា ហើយ តភ្ជាប់ តំបន់ ទេសចរណ៍ ធម្មជាតិ ណា ខ្លះ ទៀត ដើម្បី តភ្ជាប់ ជា របៀង ទេសចរណ៍ ធម្មជាតិ ផង និង បង្កើន វិសាលភាព តំបន់ ទេសចរណ៍ ធម្មជាតិ ដែល អាច បំពេញ ឱ្យ គ្នា ទៅ វិញ ទៅ មក ដើម្បី បម្រើ ឱ្យ វិស័យ ទេសចរណ៍ កាន់តែ មាន ភាពទាក់ទាញ ។
សូម រម្លឹក ជូន ថា សមាគម អភិរក្ស ដំរី ខ្មែរ អៃ រាវត្តា បាន បង្កើតឡើង ក្នុង គោលបំណង លើកកម្ពស់ ការងារ បរិស្ថាន ធនធាន ធម្មជាតិ អប់រំ ស្រាវជ្រាវ វប្បធម៌ ប្រពៃណី ខ្មែរ ដោយ ផ្តោត លើ ការងារ សំខាន់ ចម្បង ចំនួន គឺ៖
ទី ១៖ ជួយ កិច្ចការ អភិរក្ស ដំរី ស្រុក នៅ កម្ពុជា ដែល ប្រឈម នឹង ការផុត ពូជ ទី២៖ ជួយ លើកកម្ពស់ វិស័យ អេកូ ទេសចរណ៍ នៅក្នុង តំបន់ ធនធាន ធម្មជាតិ និង ទី៣៖ បង្កាត់ ពូជ ដំរី ស្រុក ឱ្យ កើត កូន កើត ចៅ បាន កាន់តែ ច្រើន ៕
សង្គ្រាម អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស ប៉ាឡេ ស្ទីន ឈានចូល ថ្ងៃទី ៣០
( ប៉ាឡេ ស្ទីន ) ៖ អ៊ីស្រាអែល នៅតែ បន្ត ការវាយប្រហារ ដាក់ លើ តំបន់ ហ្គាហ្សា បើ ទោះបី មាន រលក បាតុកម្ម លើ ពិភពលោក ទាមទារ រក ការបញ្ឈប់ បាញ់ គ្នា និង បើ ទោះបីជា សហរដ្ឋ អាមេរិក បាន ស្នើរក ការ សំរាក ឈប់ បាញ់ គ្នា ខ្លះ យ៉ាងណា ក៏ដោយ ។ កងកម្លាំង អ៊ីស្រាអែល ត្រូវ គេ រាយការណ៍ ថា បាន វាយ កាត់ផ្តាច់ តំបន់ ហ្គាហ្សា ស្ទី្រប នេះ ជា ពីរ ហើយ និង កំពុង ឡោមព័ទ្ធ ក្រុង ហ្គាហ្សា ភាគ ខាង ជើង ។
កន្លែង ដែល វាយប្រហារ នោះ គឺជា កន្លែង នៃ ជំរំជនភៀសខ្លួន ដែល មាន មនុស្ស ជាច្រើន បាន រស់ នៅ ។ ទោះជា យ៉ាងណា ក៏ដោយ សេចក្តីរាយការណ៍ ខ្លះ បាន ព្យាយាម ការពារ ថា កន្លែង ដែល មាន ទម្លាក់ គ្រាប់បែក នា ភាគ ខាងត្បូង នោះ មិន មែន ជា កន្លែង ដែល អ៊ីស្រាអែល បាន ប្រាប់ ពលរដ្ឋ ស្លូត ត្រង់ ឱ្យ ធ្វើដំណើរ ទៅកាន់ ទីនោះ ឡើយ ។ ក្រុមហា ម៉ាស បាន បន្ទោស ថា ការវាយប្រហារ ដាក់ លើ ជំរំជនភៀសខ្លួននា ភាគ ខាងត្បូង នោះ គឹជា ស្នាដៃ របស់ ក្រុម ទាហាន អ៊ីស្រាអែល ប៉ុន្តែ អ៊ីស្រាអែល បាន និយាយ ថា គេ នឹង ធ្វើ ការស៊ើបអង្កេត ។
ជម្លោះ ប៉ាឡេ ស្ទីន - អ៊ីស្រាអែល បាន ឈានចូល ដល់ ថ្ងៃទី ៣០ ហើយ គិត ត្រឹម ថ្ងៃចន្ទ ទី៦វិច្ឆិកា គ្រា ដែល ក្រសួង សុខាភិបាល ក្នុង តំបន់ ហ្គាហ្សា បាន និយាយ ថា មាន ពលរដ្ឋ ក្នុង តំបន់ ហ្គាហ្សា ស្ទីប ស្លាប់ ប្រមាណ ជាង ១ម៉ឺន ១ ពាន់ នាក់ ក្នុង នោះ អ្នកស្លាប់ ប្រមាណ ជាង ១ភាគ បី គឺជា កុមារ ។ ក្រសួង សុខាភិបាល ហ្គាហ្សា បាន បញ្ជាក់ នូវ ចំនួន តួលេខ ទៀត ថា ក្នុង ចំណោម ជនជាតិ ប៉ាឡេ ស្ទីន ដែល ត្រូវបាន សម្លាប់ នៅ តំបន់ ហ្គាហ្សា នោះ គឺ រួម មាន កុមារ ប៉ាឡេ ស្ទីន ជាង ៤ពាន់៨០០ នាក់ ។
( ភ្នំពេញ ) ៖ បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ល្ងាច ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន បង្ហោះ សារ វីដេអូ ថ្លែងអំណរគុណ ដល់ គណៈ មេ ប្រយោគ អប្បមាទ ប្រធាន មណ្ឌល អនុ រក្ស និង អ្នក ពាក់ព័ន្ធ នានា ដែល បាន ចូលរួម ជួយ ឱ្យ ដំណើរ ប្រឡង បាក់ឌុប ទទួលបាន ជោគជ័យ ៕
សូម កុំ ចង់ សាកល្បង ប្រើ គ្រឿងញៀន សូម្បី ម្តង ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៧ ខែវិច្ឆិកា៖ បង្ក្រាប ២៥ ករណី ឃាត់ខ្លួន ៧១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៥ ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៧១ នាក់ ។
* ករណី ដឹកជញ្ជូន រក្សាទុក ១២ករណី ឃាត់ខ្លួន ២៦ នាក់ * ករណី ជួញដូរ ៣ករណី ឃាត់ខ្លួន ៩នាក់ * ករណី ប្រើប្រាស់ ១០ករណី ឃាត់ ៣៦ នាក់
មេ សិទ្ធិ មនុស្ស កម្ពុជា . មន្ត្រី បន្ទុក សិទ្ធិ កុមារ UN និង តំណាង អង្គការ យូនី សេហ្វ ប្រចាំ កម្ពុជា ជួប ពិភាក្សា ពី ការបង្កើត ស្ថាប័ន ជាតិ សិទិ្ធ មនុស្ស នៅ កម្ពុជា និង សេចក្តីព្រាង ច្បាប់ ស្ដីពី កិច្ចការពារ កុមារ
ជំនួប នេះ រៀបចំឡើង ក្នុង គោលបំណង ពិភាក្សា ទៅ លើ របៀបវារៈសំខាន់ ចំនួន ពីរ គឺ៖ ១. ការបង្កើត ស្ថាប័ន ជាតិ សិទ្ធិ មនុស្ស (NHRI) ក្នុង ប្រទេស កម្ពុជា និង ២. ការពិភាក្សា លើ ប្រធានបទ ដែល ទាក់ទង នឹង កុមារ មាន ជា អាទិ៍៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ ការផ្តល់ សច្ចាប័ន លើ ពិធីសារ បន្ថែម ទី៣ ស្តីពី នីតិវិធី បណ្តឹង នៃ អនុសញ្ញា ស្តីពី សិទ្ធិ កុមារ ការកេងប្រវ័ញ្ច លើ កុមារ និង ពលកម្ម កុមារ ។
ចំពោះ របៀបវារៈ ទី២ ដែល ពាក់ព័ន្ធ នឹង សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ ការផ្តល់ សច្ចាប័ន លើ ពិធីសារ បន្ថែម ទី៣ស្តីពី នីតិវិធី បណ្តឹង ការកេងប្រវ័ញ្ច លើ កុមារ និង ពលកម្ម កុមារ . ទេសរដ្ឋមន្ត្រី កែវ រ៉េមី បាន ជម្រាប ទៅកាន់ ប្រតិភូ ទទួលបន្ទុក សិទ្ធិ កុមារ នៃ អង្គការ សហ ប្រជាជាតិ ថា ការងារ ទាំង នេះ គឺ ស្ថិត នៅក្រោម សមត្ថកិច្ច របស់ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ។
ឆ្លើយតប ទៅនឹង ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា . គណៈប្រតិភូ នៃ គណៈកម្មាធិការ ទទួលបន្ទុក សិទ្ធិ កុមារ នៃ អង្គការ សហ ប្រជាជាតិ យល់ឃើញ ថា រាល់ ការងារ អនុសញ្ញា ក តិកាសញ្ញា អន្តរជាតិ នានា ដែល ពាក់ព័ន្ធ នឹង សិទ្ធិ កុមារ សិទ្ធិ ស្រ្តី សិទ្ធិ ជន មាន ពិការភាព និង ការប្រឆាំង ទារុណកម្ម ជាដើម គឺ ស្ថិត នៅក្រោម វិស័យ សិទ្ធិ មនុស្ស ព្រោះ ការងារ ទាំង នេះ ពាក់ព័ន្ធ នឹង តួនាទី និង ភារកិច្ច របស់ គណៈកម្មាធិការ នេះ ។
បន្ទាប់ពី ទទួលបាន អនុសាសន៍ នេះ ទេសរដ្ឋមន្ត្រី កែវ រ៉េមី បាន បញ្ជាក់ ថា គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា នឹង ខិតខំ ប្រឹងប្រែង ធ្វើការសហការបន្ត ទៀត ជាមួយនឹង ក្រសួង ពាក់ព័ន្ធ ដើម្បី ពិនិត្យមើល លទ្ធភាព និង ពិភាក្សា លើ កត្តា ផ្សេង ៗ ទាក់ទង នឹង សំណើ របស់ គណៈ កម្មាធិការ ទទួលបន្ទុក សិទ្ធិ កុមារ នៃ អង្គការ សហ ប្រជាជាតិ ។
គណៈប្រតិភូ ក៏ បាន កត់សម្គាល់ និង សម្ដែង នូវ ការកោតសរសើរ ចំពោះ ប្រទេស កម្ពុជា ដែល មាន វឌ្ឍនភាព ជា វិជ្ជមាន លើ ការអនុវត្ត អនុសញ្ញា ស្ដីពី សិទ្ធិ កុមារ ៕
( ភ្នំពេញ ) ៖ តាម ការចាត់តាំង របស់ លោក ឧប នាយក រដ្ឋមន្ត្រី សុខ ចិន្តា សោភា រដ្ឋមន្រ្តី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ លោក បណ្ឌិត ឈីវ យី ស៊ាង រដ្ឋលេខាធិការ និង ជា អ្នកសម្របសម្រួល ជាតិ អម អង្គការ អន្តរជាតិ ហ្វ្រង់ កូហ្វូនី (OIF) បាន ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ចូលរួម សន្និសីទ ថ្នាក់ រដ្ឋមន្រ្តី ហ្វ្រង់ កូហ្វូនី (CMF) លើក ទី៤៤ នៅ ទីក្រុង Yaoundé តប តាម ការអញ្ជើញ របស់ រដ្ឋាភិបាល កាមេរូន ។
សន្និសីទ CMF នេះ បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ០៤ - ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព រដ្ឋមន្ត្រី ការបរទេស ទុយនីស៊ី ដែល ជា ប្រធាន CMF លើក ទី៤៤ និង លោកស្រី អគ្គ លេខាធិការ អង្គការ OIF និង មាន ការចូលរួម ពីសំណាក់ រដ្ឋមន្រ្តី ការបរទេស និង គណៈប្រតិភូ មកពី ប្រទេស សមាជិក អង្គការ OIF ចំនួន ៥៤ ព្រមទាំង ប្រតិបត្តិករ អង្គការ ហ្វ្រង់ កូហ្វូនី និង តំណាង អង្គការ អន្តរជាតិ និង តំបន់ ជាច្រើន រូប ។
សប្បុរសជន នៅ រាជធានី ភ្នំពេញ នាំយក ទេយ្យ ទាន និង បច្ច័យ មួយចំនួន ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត បរឡយ ស្រុក បរ កែវ
ឧកញ៉ា ចិន សំណាង បាន ថ្លែង ថា ទោះបី ផ្លូវ ធ្វើដំណើរ ទៅ ទី អារាម ខាងលើ មាន ការលំបាក បន្តិច ក្តី តែ ទឹកចិត្ត សទ្ធា ជ្រះថ្លា ធ្វើដំណើរ តាំងពី រាជធានី ភ្នំពេញ ចំងាយ ផ្លូវ ជាង ៦០០ គីឡូម៉ែត្រ ទំរាំ ដល់ ទី អារាម មាន ភាព ដែល មាន ភាព អត្តខាត់ នេះ ។
ឧកញ៉ា រូប នេះ បន្ត ថា កន្លងទៅ ក្រុមការងារ លោក បាន អម ដំណើរ លោកស្រី ឧកញ៉ា ហ៊ុន ស៊ីណាត ប្អូន ស្រី បង្កើត សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ សាលា បឋមសិក្សា ហ៊ុន ស៊ីណាតបរឡយ ។
ឧកញ៉ា ចិន សំណាង បញ្ជាក់ ឲ្យដឹង ទៀត ថា ដោយ មើលឃើញ ពី ការរីកចម្រើន និង កំណើន ប្រជាពលរដ្ឋ ជាពិសេស បងប្អូន ជនជាតិ ភាគ តិច ហើយ កាលពី មិន ទាន់ មាន សាលា បឋមសិក្សា ហ៊ុន ស៊ីណាត ប្រជាពលរដ្ឋ នៅ តំបន់ នោះ មាន តែ ១៣០ នាក់ ។
រហូតមកដល់ បច្ចុប្បន្ន នេះ មាន សាលា បឋមសិក្សា ហ៊ុន ស៊ីណាត ដែល ងាយស្រួល ឲ្យ កូន ចៅ ពួកគាត់ បាន ចូល រៀនសូត្រ ស្រួល មិន ពិបាក ធ្វើដំណើរ ទៅ សាលារៀន នៅ ទី ឆ្ងាយ ឃើញ ថា ប្រជាពលរដ្ឋ កើនឡើង ដល់ ៦០០ នាក់ ។
ជាង នេះ ទៅ ទៀត ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ជាង មុន លោក បាន សន្យា ថា នឹង សាងសង់ សាលារៀន ១ខ្នង ស្មើនឹង ៦ បន្ទប់ បន្ថែម ទៀត នៅ ចុង ឆ្នាំ ២០២៤ ខាងមុខ ។
សូម បញ្ជាក់ ថា ទេយ្យ ទាន មាន ដូចជា អង្ករ មី ត្រីខ ទឹកក្រូច ទឹកត្រី ទឹក ស៊ីអ៊ីវ មួយចំនួន និង បច្ច័យ ១០០ ដុល្លារ ប្រគេន ព្រះសង្ឃ ។ រីឯ ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ចំនួន ១០នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ១០ម៉ឺន រៀល និង លោកគ្រូ - អ្នកគ្រូបង្រៀន នៅ សាលា បឋមសិក្សា ហ៊ុន ស៊ីណាត បរឡយ ចំនួន ៤នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ៣០០ ដុល្លារ ផងដែរ ៕
ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ សំណេះសំណាល ជាមួយ នគរបាល ខណ្ឌ កំបូល និង ណែនាំ ការងារ ជំនាញ មួយចំនួន ដើម្បី បង្កើន ប្រសិទ្ធភាព ការងារ នៅក្នុង មូលដ្ឋាន
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន អញ្ជើញ សំណេះសំណាល ជាមួយ នគរបាល ខណ្ឌ កំបូល និង ណែនាំ ពី កិច្ចការ ដឹកនាំ ការងារ ជំនាញ មួយចំនួន សម្រាប់ អង្គភាព អធិការដ្ឋាន នគរបាល ខណ្ឌ កំបូល យក ទៅ អនុវត្ត ដើម្បី បង្កើន ប្រសិទ្ធភាព គុណភាព ការងារ ក្នុង ការបម្រើ ផលប្រយោជន៍ សង្គមជាតិ និង ប្រជាពលរដ្ឋ ពិតប្រាកដ ។
នា ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ បាន ណែនាំ ឱ្យ មាន ការគ្រប់គ្រង កម្លាំង មធ្យោបាយ សម្ភារៈ ឱ្យ បាន ល្អ និង សាមគ្គី ផ្ទៃក្នុង ឱ្យ បាន រឹងមាំ ។
លោក ស្នងការ ក៏ បាន ក្រើន រំលឹក ដល់ មន្ត្រី នគរបាល ទូទាំង ខណ្ឌ កំបូល ត្រូវ ខិតខំ ពង្រឹង ការអនុវត្ត វិធានការ បង្ការ ទប់ស្កាត់ បទល្មើស គ្រប់ ប្រភេទ បើ ក្នុង ករណី កើតឡើង នូវ បទល្មើស ត្រូវ ស្រាវជ្រាវ បង្រ្កាប ឱ្យ បាន ទាន់ ពេល វេលា ។ បន្ថែម ពី នេះ ត្រូវ ពង្រឹង ការងារ សណ្តាប់ធ្នាប់ ចរាចរណ៍ ឱ្យ បាន ល្អ បំពេញ ភារកិច្ច ប្រកាន់ខ្ជាប់គោលការណ៍ ច្បាប់ និង វិន័យ កងកម្លាំង នគរបាល ជាតិ ដើម្បី បញ្ចៀស រង ការរិះគន់ ពី ប្រជាពលរដ្ឋ ។
លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ បាន បញ្ជាក់ បន្ថែម ថា ដល់ មន្ត្រី នគរបាល ទាំងអស់ ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ បង្ការ ទប់ស្កាត់ ក្មេង ទំនើង និង ការទប់ស្កាត់ អំពើ លួច ឆក់ ឱ្យ មាន ប្រសិទ្ធភាព ភាព ផងដែរ ៕
អគ្គិភ័យ ឆេះ ផ្ទះ ប្រជាពលរដ្ឋ នៅ ខណ្ឌ មានជ័យ បណ្តាល ស្លាប់ ម្នាក់ . សមត្ថកិច្ច ប្រើប្រាស់ ឡាន ទឹក ចំនួន ១៩ គ្រឿង
( ភ្នំពេញ ) ៖ ករណី អគ្គិភ័យ បាន លេប ត្របាក់ អស់ ផ្ទះ ប្រជាពលរដ្ឋ ១ខ្នង អស់ ទាំងស្រុង បាន បង្ក ការភ្ញាក់ផ្អើល នៅ វេលា ម៉ោង ១២និង ២០ នាទី ថ្ងៃត្រង់ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដែល ស្ថិត នៅ តាម បណ្តោយ ផ្លូវ លំ ក្រុម៥ ភូមិ ថ្មី សង្កាត់ ស្ទឹងមានជ័យ ទី១ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
ហេតុការណ៍ នេះ បាន បណ្តាលឱ្យ មនុស្ស ប្រុស ម្នាក់ បាន ស្លាប់ ( មាន សតិ មិន គ្រប់ ) រីឯ មូលហេតុ បណ្តាល មកពី ដុត ផ្ទះ បង្ក ជា អគ្គិភ័យ ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន នាយ ការិយាល័យ នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ប្រាប់ ឱ្យ បណ្តាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា ដោយ មាន ការអនុវត្ត តាម បទបញ្ជា របស់ ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន ណែនាំ ដល់ កម្លាំង ជំនាញ ការិយាល័យ នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ ត្រូវ ធ្វើការ យកចិត្តទុកដាក់ ខ្ពស់ នៅក្នុង ប្រតិបត្តិការ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេល វេលា ។
ដោយ ទទួលបាន បទបញ្ជា របស់ ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ . លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន បាន ដឹកនាំ បញ្ជា ផ្ទាល់ ដល់ កងម្លាំង ពន្លត់ អគ្គិភ័យ ដែល ប្រចាំ ការ នៅ តាម បណ្តាល គោលដៅ ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ ដើម្បី ចេញ ទៅ ជួយ អន្តរាគមន៍ បាញ់ ទឹក ពន្លត់ ឱ្យ ទាន់ ពេលវេលា កុំ ឲ្យ មាន ការឆាបឆេះ បន្ត ដល់ ផ្ទះ ប្រជាពលរដ្ឋ ដែល នៅក្បែរ នោះ ។
នៅក្នុង ប្រតិបត្តិការ ខាងលើ នេះ កម្លាំង សមត្ថកិច្ច ជំនាញ បាន ប្រើប្រាស់ រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន ១៩ គ្រឿង ក្នុង នោះ រួម មាន៖
* រថយន្ត ពន្លត់ អគ្គិភ័យ របស់ ការិយាល័យ រាជធានី ភ្នំពេញ ចំនួន ១៤ គ្រឿង * ប្រើប្រាស់ ទឹក អស់ ០៨ ឡាន * រថយន្ត ជំនួយ មកពី ក្រុមហ៊ុន ស្រាបៀរ កម្ពុជា ចំនួន ០១ គ្រឿង * រថយន្ត ទីក្រុង ជ្រោយ ចង្វារ ចំនួន ០២ គ្រឿង * រថយន្ត ផ្សារ ទំនើប អូឡាំព្យា ចំនួន ០២ គ្រឿង ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន បាន បញ្ជាក់ ថា ចំពោះ ករណី គ្រោះ អគ្គិភ័យ ខាងលើ នេះ ជា ប្រភេទ សំណង់ ឈើ លើ ថ្ម ក្រោម ទំហំ ( ៥ម៉ែត្រ គុណ ២០ម៉ែត្រ ) បាន ឆេះ ផ្ទះ មួយ ខ្នង អស់ ទាំងស្រុង និង ពុំ បាន បណ្តាលឱ្យ ឆេះ រាលដាល ដល់ ផ្ទះ អ្នក ក្បែរខាង ឡើយ ។
លោក បាន សួរសុខទុក្ខ យ៉ាង ស្មោះ និង សម្តែង ការអបអរសាទរ យ៉ាង កក់ក្តៅ ចំពោះ ពួកគេ ហើយ បាន លើកទឹកចិត្ត ដល់ ពួកគេ ឱ្យ បន្ត ខិតខំ ប្រឹងប្រែង ប្រកាន់ខ្ជាប់ និង អភិវឌ្ឍ នូវ « បទពិសោធន៍ Fengqiao» ក្នុង យុគសម័យ ថ្មី ដើម្បី រួមចំណែក កាន់តែ ធំ សម្រាប់ ការជំរុញ ការកសាង ប្រទេស ចិន ប្រកបដោយ សន្តិភាព ដែល មាន កម្រិត កាន់តែ ខ្ពស់ ។
គួរ រម្លឹក ថា តាមរយៈ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ដ៏ ឧត្តុងឧត្តម និង ដ៏ ថ្លៃថ្លា របស់ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី រយៈពេល ១១ឆ្នាំ កន្លងមក បាន ទទួល លទ្ធផល ជា ផ្លែ ផ្កា ដែល នាំឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គោរព ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន និង លោក ហ៊ុន ម៉ានី ថ្នាក់ដឹកនាំ ខេត្ត គ្រប់ ជាន់ ថ្នាក់ និង ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា នៃ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត ឯកឧត្តម ហ៊ុន ម៉ានី ព្រមទាំង ក្រុមការងារ ៕
( ភ្នំពេញ ) ៖ លោក ប៊ិន ត្រឈៃ រដ្ឋមន្ត្រី ក្រសួង ផែនការ បាន ចេញ សេចក្តីសម្រេច ស្តីពី ការបង្កើត ក្រុមការងារ ព័ត៌មាន និង បណ្តាញ ទំនាក់ទំនង សង្គម របស់ ក្រសួង ផែនការ ។ នេះ បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
តាមរយៈ សេចក្តីសម្រេច របស់ លោក រដ្ឋមន្ត្រី ប៊ិន ត្រឈៃ បាន ឱ្យដឹង ថា ក្រុមការងារ នេះ មាន សមាសភាព ចំនួន ៩រូប ៕
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច របស់ រដ្ឋមន្ត្រី ក្រសួង ផែនការ៖
( ភ្នំពេញ ) ៖ លោក សាយ សម្ផស្ស សេរី ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន សម្រច ឃុំ ខ្លួន កូនស្រី ឈ្មោះ លៀង ហែម វត្តី ដាក់ ពន្ធនាគារ ព្រៃស ( ម២ ) ដើម្បី រង់ ចាំំ ទទួល ការជំនុំជម្រះ ទោសទណ្ឌ នៅ ពេល ក្រោយ ដោយសារតែ កូនស្រី រូប នេះ បាន ចាក់ សម្លាប់ ឪពុក បង្កើត របស់ ខ្លួន និង កាប់ ទៅ លើ ម្តាយ បណ្តាលឲ្យ រងរបួស ធ្ងន់ ។
សូម ជំរាប ថា កូនស្រី ឈ្មោះ លៀង ហែម វត្តី ត្រូវបាន កម្លាំង សមត្ថកិច្ច ខណ្ឌ កំបូល ចាប់ និង បញ្ជូន ខ្លួន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ។
ដើម ចម នៃ រឿង កូនស្រី បង្កើត ចាក់ សម្លាប់ ឪពុក ម្តាយ ខ្លួន ឯង បាន កើត នៅ ( បុរី ម៉ន ដានី ) គំរោង ទី១០ ដោយសារតែ រូប គេ ចង់ ចេញ ទៅ ខាងក្រៅ ផ្ទះ តែ ឪពុក ម្តាយ មិន ព្រម ឲ្យ ចេញ ក៏ ឈ្លោះប្រកែកគ្នា រហូត ឈានដល់ ការប្រើប្រាស់ ហិង្សា យក កូន កាំបិត ចាក់ ទៅ លើ ឪពុក ម្តាយ កាលពី វេលា ម៉ោង ៧យប់ ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្នុង ភូមិ តា អិន សង្កាត់ ស្នោរ ខណ្ឌ កំបូល ។
ក្រោយ កើត ហេតុ ឪពុក ត្រូវបាន ដឹក បញ្ជូន ទៅកាន់ ទៅ មន្ទីរពេទ្យ ភ្លាម ៗ តែ ជា អកុសល្យ គាត់ បាន ស្លាប់ រីឯ ម្តាយ រងរបួស ធ្ងន់ ។ ក្រោយ កើត ហេតុ កូនស្រី ដែល ជា អ្នកបង្ក ក៏ ត្រូវបាន ចាប់ខ្លួន បាន ភ្លាម ខណៈពេល ព្យាយាម ពួន ក្នុង ផ្ទះ អ្នកជិតខាង ។
បើ តាម សេចក្តីរាយការណ៍ មួយចំនួន ទៀត បាន ឲ្យដឹង ថា កូនស្រី រូប នេះ សង្ស័យ ជា មនុស្ស កើត ជំងឺ សសៃ ប្រសាទ ៕
លោក សួន សុម៉ាលីន ជំរុញ ដល់ មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ត្រូវ បន្ត ខិតខំ អនុវត្ត កិច្ចការងារ របស់ ខ្លួន ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ប្រសើរ
( ព្រៃវែង ) ៖ លោក សួន សុម៉ាលីន អភិបាល ខេត្ត ព្រៃវែង បាន ថ្លែង ជំរុញ ដល់ មន្ទីរ អង្គភាព រដ្ឋបាល ក្រុង ស្រុក អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ បន្ត ខិតខំ យកចិត្តទុកដាក់ អនុវត្ត តួនាទី ភារកិច្ច របស់ ខ្លួន ឲ្យ កាន់តែ ល្អ ប្រសើរឡើង បន្ថែម ទៀត ធ្វើ យ៉ាងណា ដើម្បីឲ្យ ការងារ បម្រើ សេវា សាធារណៈ ជូន បងប្អូន ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ប្រសើរ ស្រប តាម យុទ្ធសាស្រ្ត ចក្ខុវិស័យ របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ ។
ការលើកឡើង បែប នេះ របស់ អភិបាល ខេត្ត ព្រៃវែង នៅក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ព្រៃវែង នា ថ្ងៃទី ៧ ខែវិច្ជិកា ឆ្នាំ ២០២៣ នៅ សាលា ខេត្ត ព្រៃវែង ។
សូម បញ្ជាក់ ថា នៅក្នុង កិច្ចប្រជុំ នោះ ដែរ មន្ទីរ អង្គភាព រដ្ឋបាល ក្រុង ស្រុក កងកម្លាំង ទាំង៣ បាន លើកឡើង អំពី ផែនការ សកម្មភាព របស់ ខ្លួន ដែល អនុវត្ត កន្លងមក ដើម្បី បង្ហាញ អំពី លទ្ធផល ដែល ខ្លួន បាន អនុវត្ត មក នោះ ជូន លោក អភិបាល ខេត្ត ដើម្បី ធ្វើ ការពិនិត្យ និង ដាក់ ផែនការ សកម្មភាព បន្ថែម ទៀត ដល់ មន្ទីរ អង្គភាព រដ្ឋបាល ក្រុង ស្រុក កងកម្លាំង ទាំង បី អង្គភាព ពាក់ព័ន្ធ ដើម្បី អនុវត្ត បន្តរ ទៀត ។
លោក អភិបាល ខេត្ត បាន ណែនាំ ដល់ មន្ទីរ អង្គភាព អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវ ខិតខំ អនុវត្ត ការងារ របស់ ខ្លួន រៀង ៗ ខ្លួន ធ្វើ យ៉ាងណា ដើម្បី បំពេញ តម្រូវ ការចាំបាច់ ដែល ជា ផលប្រយោជន៍ រួម ដល់ បងប្អូន ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ប្រសើរ បន្ថែម ទៀត ។ រដ្ឋបាល ក្រុង ស្រុក ទាំងអស់ ត្រូវ ពង្រឹង អនុវត្ត នូវ គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ឲ្យ មាន ប្រសិទ្ធភាព ដើម្បី ធានា សុខ សុវត្ថិភាព ជូន បងប្អូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ប្រកបដោយ សុវត្ថិភាព ខ្ពស់ ។
ក្រុម ប្រទេស G7 រួម មាន ចក្រភព អង់គ្លេស កាណាដា បារាំង អាល្លឺម៉ង់ អ៉ីតាលី ជប៉ុន និង សហរដ្ឋ អាមេរិក ព្រមទាំង សហភាព អឺរ៉ុប ត្រូវ ជួបប្រជុំគ្នា នៅ ទីក្រុង តូក្យូ នា ថ្ងៃទី ៧ - ៨ ខែវិច្ឆិកា ដើម្បី ពិភាក្សា អំពី បញ្ហា ផ្សេង ៗ រួម មាន ទាំង សង្រ្គាម រុស្ស៉ី នៅ អ៊ុយក្រែន និង សង្រ្គាម របស់ អ៉ី ស្រាអែល ជាមួយ ក្រុមហា ម៉ាស ប៉ាឡេស្ទីន នៅឯ តំបន់ Gaza Strip ។
( ភ្នំពេញ ) ៖ ចលនា ភូមិ១ ផលិតផល ១ គឺជា យន្តការ ដ៏ មាន ប្រសិទ្ធភាព មួយ ក្នុង ការលើកកម្ពស់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច មូលដ្ឋាន បង្កើត ការងារ នៅនឹង កន្លែង កាត់បន្ថយ ចំណាកស្រុក កាត់បន្ថយ ភាពក្រីក្រ ដែល ទាំងនេះ គឺជា មូលដ្ឋាន ចាំបាច់ ក្នុង ការរួមចំណែក ធ្វើឲ្យ កម្ពុជា ឈាន ទៅ សម្រេចបាន នូវ ចក្ខុវិស័យ ប្រែក្លាយជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ក្លាយជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
បណ្ឌិត សភាចារ្យ ទេសរដ្ឋមន្ត្រី បន្ត ថា ក្រៅពី ទិដ្ឋភាព សេដ្ឋកិច្ច ចលនា ភូមិ ១ ផលិតផល ១ ក៏ បាន ផ្តោត ដល់ ការលើកកម្ពស់ ផ្នែក វប្បធម៌ ប្រពៃណី ផងដែរ តាមរយៈ ការផ្តល់ ការយកចិត្តទុកដាក់ ទៅ លើ ផលិតផល តាម មូលដ្ឋាន ដែល មាន ចរិក ឆ្លុះបញ្ចាំង ពី លក្ខណៈ វប្បធម៌ ប្រពៃណី របស់ តំបន់ និង បង្កើត មោទនភាព ដល់ ប្រជា សហគមន៍ និង មូលដ្ឋាន ដែល ខ្លួន កំពុង រស់ នៅ ។
លោក ផល សុជាតិ អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន គណៈកម្មាធិការ ជាតិ ជំរុញ ចលនា ភូមិ ១ ផលិតផល ១ បាន ឲ្យដឹង ថា គណៈកម្មាធិការ ជាតិ ជំរុញ ចលនា ភូមិ ១ ផលិតផល ១ បាន ប្រមូល ចង ក្រង ផលិតផល ភូមិ ១ ផលិតផល ១ ចំនួន ២លើក រួច មក ដោយ ទទួលបាន ផលិតផល ទទួលស្គាល់ ជា ផលិតផល ភូមិ ១ ផលិតផល ១ ចំនួន ៥៥៩ ផលិតផល ដែល ក្នុង នោះ សម្រាប់ រាជធានី ភ្នំពេញ មាន ចំនួន ៥៦ ផលិតផល ។ ផលិតផល ទាំងនេះ នឹង ត្រូវ ធ្វើ ការវាយតម្លៃ ដាក់ ចំណាត់ថ្នាក់ ផលិតផល ផ្កាយ ១.២.៣.៤. ៥។
តាមរយៈ សកម្មភាព នេះ វា នឹង ក្លាយទៅជា កម្លាំង អូសទាញ មួយ ថែម ទៀត ក្នុង ការទាក់ទាញ ទឹកចិត្ត ផលិត ករ ក្នុង ស្រុក ឲ្យ មាន ការខំប្រឹងប្រែង ពង្រឹង គុណភាព ផលិតផល របស់ ខ្លួន ដើម្បី ទទួលបាន ចំណាត់ថ្នាក់ ល្អ និង បង្កើន ឱកាស ទីផ្សារ និង សមត្ថភាព ប្រកួតប្រជែង របស់ ខ្លួន ។
បន្ទាប់មក បណ្ឌិត សភាចារ្យ ទេសរដ្ឋមន្ត្រី ក៏ បាន អញ្ជើញ ប្រគល់ វិញ្ញាបនបត្រ ទទួលស្គាល់ ផលិតផល ភូមិ ១ ផលិតផល ១ ឆ្នាំ ២០២២ ចំនួន ៥៦ ផលិតផល ដែល មាន មូលដ្ឋាន ផលិត នៅ រាជធានី ភ្នំពេញ និង បាន អញ្ជើញ ទស្សនា ស្តង់ ផលិតផល ភូមិ ១ ផលិតផល ១ ដែល រៀចំ តាំង បង្ហាញ នៅ ខាងក្រៅ បន្ទប់ អង្គ សិក្ខាសាលា នោះ ផងដែរ ៕
គណបក្ស មហាសាមគ្គី ជាតិ ខ្មែរ ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
គណបក្ស ខាងលើ ដែល ជា សមាជិក ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្ដល់ យោបល់ ចាត់ទុក ថា ការចោទប្រកាន់ ខាងលើ នេះ គឺ គ្មាន ការពិត ទាំងស្រុង ព្រោះ ការចូលរួម ក្នុង យន្តការ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា គោលការណ៍ ស្ម័គ្រចិត្ត និង ជា សិទ្ធិ សេរីភាព កើត ចេញ ពី ការសម្រេចចិត្ត ដោយ គ្មាន ការបង្ខិតបង្ខំ នោះ ឡើយ ។
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស៖ គណបក្ស ខ្មែរ ក្រោក ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស៖ និយ័តករ គណនេយ្យ និង សវនកម្ម ជូនដំណឹង ពាក់ព័ន្ធ នឹង កាតព្វកិច្ច គណនេយ្យ និង សវនកម្ម ដើម្បី ដោះស្រាយ សំណូមពរ និង លើកទឹកចិត្ត សហគ្រាស
គណបក្ស ខ្មែរ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
គណបក្ស ខាងលើ ដែល ជា សមាជិក ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្ដល់ យោបល់ ចាត់ទុក ថា ការចោទប្រកាន់ ខាងលើ នេះ គឺ គ្មាន ការពិត ទាំងស្រុង ព្រោះ ការចូលរួម ក្នុង យន្តការ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា គោលការណ៍ ស្ម័គ្រចិត្ត និង ជា សិទ្ធិ សេរីភាព កើត ចេញ ពី ការសម្រេចចិត្ត ដោយ គ្មាន ការបង្ខិតបង្ខំ នោះ ឡើយ ។
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស៖ គណបក្ស ខ្មែរ សាធារណរដ្ឋ ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោលទោ ស៖
គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
គណបក្ស ខាងលើ ជា សមាជិក ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្ដល់ យោបល់ ចាត់ទុក ថា ការចោទប្រកាន់ ខាងលើ នេះ គឺ គ្មាន ការពិត ទាំងស្រុង ព្រោះ ការចូលរួម ក្នុង យន្តការ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា គោលការណ៍ ស្ម័គ្រចិត្ត និង ជា សិទ្ធិ សេរីភាព កើត ចេញ ពី ការសម្រេចចិត្ត ដោយ គ្មាន ការបង្ខិតបង្ខំ នោះ ឡើយ ។
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស៖ រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្រុមហ៊ុន ចិន រៀបចំ ពិធី អបអរសាទរ ខួប១ ឆ្នាំ នៃ ការដាក់ ឱ្យ ដំណើរការ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ
( ភ្នំពេញ ) ៖ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ ដែល ជា ខ្សែ ផ្លូវ ល្បឿន លឿន លើក ដំបូង នៅ កម្ពុជា បាន ដាក់ ឱ្យ ធ្វើចរាចរណ៍ បាន រយៈពេល មួយ ឆ្នាំ ហើយ ។ នៅ រសៀល ថ្ងៃអង្គារ ទី៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្រុមហ៊ុន ចិន ដែល វិនិយោគ លើ ផ្លូវ ល្បឿន លឿន នេះ បាន រៀបចំ ពិធី អបអរសាទរ ខួប មួយ ឆ្នាំ នៃ ការដាក់ ឱ្យ ដំណើរការ ផ្លូវ ល្បឿន លឿន នេះ ។
ពិធី អបអរសាទរ ខួប១ ឆ្នាំ នៃ ការបើក ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ផ្លូវ ល្បឿន លឿន ដំបូង បង្អស់ នៅ កម្ពុជា ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព លោក ស៊ុន ចាន់ថុល ឧប នាយក រដ្ឋមន្ត្រី និង ជា អនុប្រធាន ទី១ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក វ៉ាង វិន ធៀន ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ នៅ កម្ពុជា ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ដោយ លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ថ្នាក់ដឹកនាំ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ថ្នាក់ដឹកនាំ ក្រុមហ៊ុន ចិន ព្រមទាំង មន្ត្រីរាជការ និស្សិត និង ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិសាស្ត្រ នៃ តម្រាយ ផ្លូវ ល្បឿន លឿន នេះ ។
ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង ព្រះសីហនុ ជា ផ្លូវ ល្បឿន លឿន ថ្មី និង ដំបូង បំផុត ក្នុង ប្រវត្តិសាស្រ្ត កម្ពុជា តភ្ជាប់ ពី រាជធានី ភ្នំពេញ ទៅកាន់ ទីក្រុង ទេសចរណ៍ និង កំពង់ផែ សមុទ្រ ធំ បំផុត ក្រុង ព្រះសីហនុ មាន ប្រវែង សរុប ១៨៧. ០៥ គីឡូម៉ែត្រ ត្រូវបាន បើក ការដ្ឋាន សាងសង់ កាលពី ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០១៩ តភ្ជាប់ ពី សង្កាត់ សំរោង ក្រោម ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ទៅដល់ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ដោយ ឆ្លងកាត់ ខេត្ត កណ្តាល កំពង់ស្ពឺ និង ខេត្ត កោះកុង ។
ការធ្វើដំណើរ ទៅកាន់ ក្រុង ព្រះសីហនុ ដែល ពីមុន ធ្លាប់ ប្រើ រយៈពេល ពី ៤ ទៅ ៥ ម៉ោង តាម ផ្លូវ ជាតិ លេខ ៤ ឥឡូវនេះ បាន កាត់បន្ថយ នៅសល់ ត្រឹមតែ ប្រមាណ ២ ម៉ោង ប៉ុណ្ណោះ ដែល នេះ បង្ហាញ ឱ្យ ឃើញ ថា ផ្លូវ ល្បឿន លឿន មួយ ខ្សែ នេះ បាន និង កំពុង មាន តួនាទី យ៉ាង សំខាន់ ក្នុង ការនាំយក នូវ បទពិសោធន៍ ធ្វើដំណើរ ថ្មី កាត់បន្ថយ ការចំនាយ ពេលវេលា ព្រមទាំង លើ កម្ពស់ ប្រសិទ្ធភាព នៃ ការធ្វើដំណើរ ជូន ដល់ ប្រជាពលរដ្ឋ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ១៤១ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២.៦០០ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ២.២៥១ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៣៤៩ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក អត់ បណ្ណ បើកបរ ការដាក់ តាំង និង ល្មើស ភ្លើង - ផ្លាក សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ឆៀក ដឹក សំពីង សំពោង ល្មើស ភ្លើង - ផ្លាក សញ្ញា អត់ បណ្ណ បើកបរ និង ល្មើស ល្បឿន ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៤ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៣ នាក់ របួស ចំនួន ៣៥ នាក់ ( របួស ធ្ងន់ ចំនួន ១៨នាក់ ) ។ រយៈពេល ៧ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៤៩ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ២១ នាក់ របួស ៩៦ នាក់ ( របួស ធ្ងន់ ៦៣ នាក់ )៕
( ភ្នំពេញ ) ៖ ឆ្នាំ ២០០៦ - ២០២៣ មាន រយៈពេល ១៧ឆ្នាំ មកហើយ ដែល កម្ពុជា បាន បញ្ជូន កងទ័ព មួក ខៀវ ចូលរួម ប្រតិបត្តិការ រក្សា សន្តិភាព ក្រោម ឆត្រ របស់ អង្គការ សហ ប្រជាជាតិ ។
នៅ ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០០៦ ជា ពេល នៃ ការបញ្ជូន កម្លាំង លើក ដំបូង របស់ កម្ពុជា ចូលរួមចំណែក ស្វែងរក សុខ សន្តិភាព ។ ព្រឹត្តិការណ៍ នេះ បាន កើតឡើង បន្ទាប់ពី ១២ ឆ្នាំ ក្រោយ នៃ ការអំពាវនាវ ពី អគ្គ លេខាធិការ អង្គការ សហ ប្រជាជាតិ ដល់ សមាជិក របស់ ខ្លួន និង បន្ទាប់ពី បាន ពិនិត្យ ក្របខ័ណ្ឌ រដ្ឋធម្មនុញ្ញ របស់ ព្រះរាជាណាចក្រ កម្ពុជា ជាធរមាន គ្រប់ ជ្រុងជ្រោយ រួច មក ។
ក្រោយមក សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា នា ពេល នោះ បាន ឯកភាព ជា ផ្លូវ ចូលរួម បេសកកម្ម រក្សា សន្តិភាព ក្រោម ឆ័ត្រ អង្គការ សហ ប្រជាជាតិ ជា ផ្លូវការ ។
ខាងក្រោម នេះ ជា វីដេអូ ឯកសារ ពី បេសកកម្មភាព ចូលរួម រក្សា សន្តិភាព របស់ កងទ័ព កម្ពុជា៖
( ភ្នំពេញ ) ៖ នាយក នៃ មជ្ឈមណ្ឌល ន វានុវត្តន៍ ផ្នែក អភិបាលកិច្ច និង ប្រជាធិបតេយ្យ នៃ វិទ្យាស្ថាន ចក្ខុវិស័យ អាស៊ី លោក ឆេង គឹម ឡុង បាន មើលឃើញ ថា គោល នយោបាយ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ប្រែក្លាយ កម្ពុជា មាន ភាពទាក់ទាញ និង អាច ពង្រីក កម្លាំង ជំនាញ នា ពេល អនាគត ។
ការបញ្ជាក់ បែប នេះ របស់ បណ្ឌិត សេដ្ឋកិច្ច គឺ បន្ទាប់ពី រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រកាស បណ្តុះបណ្តាល ក្រុម យុវជន គោលដៅ មក ពី គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ដែល ប្រមុខ រដ្ឋាភិបាល គ្រោង នឹង ប្រកាស នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ខាងមុខ នេះ ។
សម្រាប់ អ្នកជំនាញ សេដ្ឋកិច្ច រូប នេះ ការបណ្តុះបណ្តាល នឹង ប្រែក្លាយកម្លាំង អតិពលកម្ម ទៅជា កម្លាំង ពលកម្ម ដែល មាន ជំនាញ ច្បាស់លាស់ និង មាន ចំណូល ខ្ពស់ ។ កត្តា នេះ នឹង ធ្វើឱ្យ កម្ពុជា មាន ភាពទាក់ទាញ ការវិនិយោគ ពី ក្រៅ ប្រទេស ត្បិត អី កម្ពុជា បាន ត្រៀម កម្លាំង ជំនាញ រួច ជា សម្រេច ៕
អតីត នាយក រដ្ឋមន្រ្តី កម្ពុជា ដ៏ មាន ប្រជាប្រិយភាព បាន ថ្លែង បន្ថែម ថា ប្រសិនបើ គ្មាន បទ ឈប់ បាញ់ ណាមួយ កើតឡើង ទេ នោះ តំបន់ ហ្រ្គាសា និង ក្លាយទៅជា វាល ពិឃាដ និង ជា កន្លែង កប់ ខ្មោច ដ៏ ធំ ជាង គេ នៅលើ ពិភពលោក ។
ការថ្លែង សារ អំពាវនាវ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។ ប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ និង ជា ប្រធាន គណបក្ស កាន់អំណាច របស់ កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន ថ្លែង សារ យ៉ាង ដូច្នេះ ថា៖
« ប្រសិនបើ គ្មាន បទ ឈប់ បាញ់ មួយ ទេ តំបន់ ហ្រ្គាសា និង ក្លាយទៅជា វាល ពិឃាដ និង ជា កន្លែង កប់ ខ្មោច ដ៏ ធំ ជាង គេ នៅលើ ពិភពលោក ។ កន្លងមក មាន ការអំពាវនាវ ពី សហគមន៍ អន្តរជាតិ ឲ្យ មាន បទ ឈប់ បាញ់ មួយ នៅ តំបន់ ហ្រ្គាសា តែ ត្រូវបាន បដិសេដ្ឋ ដោយ នាយក រដ្ឋមន្ត្រី អ៉ី ស្រាអែល ដោយ គាត់ បាន ថ្លែង ថា ( នឹង មិន មាន បទ ឈប់ បាញ់ ទេ ប្រសិនបើ មិន មាន ការដោះលែង ចំណាប់ខ្មាំង ) ។
ប្រសិនជា ពាក្យ នេះ ជា ពាក្យ របស់ នាយក រដ្ឋមន្ត្រី អ៉ី ស្រាអែល ដូច សារព័ត៌មាន ចុះផ្សាយ ពិតប្រាកដ មែន ខ្ញុំ មើលឃើញ ថា វា ជា ច្រក ចេញ ឆ្ពោះ ទៅរក បទ ឈប់ បាញ់ មួយ ប្រសិនបើ ក្រុមហា ម៉ាស់ យល់ព្រម ដោះលែង ចំណាប់ខ្មាំង ដើម្បី ដោះដូរ ជាមួយ បទ ឈប់ បាញ់ ។
ខ្ញុំ សូម អំពាវនាវ ដល់ អគ្គ លេខាធិការ អង្គការ សហ ប្រជាជាតិ និង ភាគី ពាក់ព័ន្ធ សូម ចាប់ផ្តើម រក ការចរចា ដោយ ផ្តើម ចេញ ពី ការដោះលែង ចំណាប់ខ្មាំង ដោយ ក្រុមហា ម៉ាស់ និង ការសន្យា របស់ អ៉ី ស្រាអែល ថា នឹង ឈប់ បាញ់ ប្រសិន មាន ការដោះលែង ចំណាប់ខ្មាំង ។
ខ្ញុំ ក៏ សូម អំពាវនាវ ដល់ ក្រុមហា ម៉ាស់ នៃ ប៉ាឡេស្ទីន សូម ធ្វើ ការដោះលែង ចំណាប់ខ្មាំង ដើម្បី ឈាន ឆ្ពោះ ទៅរក បទ ឈប់ បាញ់ ដែល ជា ផលប្រយោជន៍ អាយុជីវិត នៃ ប្រជាជន ប៉ាឡេស្ទីន នៅ តំបន់ ហ្រ្គា សាស្រ្ទីប ទាំងមូល ។
( កំពង់ស្ពឺ ) ៖ នៅ រសៀល ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ស្ពឺ បាន អញ្ជើញ ដឹកនាំ ប្រជុំ មន្ត្រី នគរបាល យុត្តិធម៌ ដែល មាន ការចូលរួម ពី ព្រះរាជអាជ្ញា រង លោក ស្នងការ ស្នងការរង មន្ត្រី នគរបាល នៃ ស្នងការ នគរបាល ខេត្ត លោក មេបញ្ជាការ មេបញ្ជាការ រង និង មន្ត្រី នគរបាល យុត្តិធម៌ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ ជាច្រើន រូប ។
លោក ព្រះរាជអាជ្ញា បាន បន្ត ថា « មន្រ្តី នគរបាល យុត្តិធម៌ មាន តួនាទី យ៉ាង សំខាន់ ទៅ តាម ដំណាក់កាល នីមួយ ៗ ដូចជា ដំណាក់កាល ស៊ើបអង្កេត ។ នៅ ដំណាក់កាល ស៊ើបអង្កេត មន្រ្តី នគរបាល យុត្តិធម៌ ជា សេនាធិការ និង ស្ថិត នៅក្រោម ការសម្របសម្រួល របស់ ព្រះរាជអាជ្ញា មាន សមត្ថកិច្ច » ។
លោក ព្រះរាជអាជ្ញា បាន បញ្ជាក់ ថា បេសកកម្ម របស់ មន្រ្តី នគរបាល យុត្តិធម៌ រួម មាន ទទួលបណ្ដឹង ទាមទារ និង បណ្ដឹង បរិហារ ។ ស៊ើបអង្កេត បទល្មើស ជាក់ស្តែង និង ធ្វើ ការអង្កេត បឋម ។ ធ្វើ កំណត់ហេតុ លើ គ្រប់ ពាក្យបណ្ដឹង ។ រៀបចំ បញ្ជី ពាក្យ បណ្តឹង និង ចំណាត់ការលើ ពាក្យបណ្ដឹង ជាដើម ។
ដំណើរការ សំណេរ មាន ភាពស្ងប់ស្ងាត់ និង សណ្ដាប់ធ្នាប់ របៀបរៀបរយ ល្អ ទាំង នៅក្នុង និង ក្រៅ មណ្ឌល ដំណើរការប្រឡង បាន ប្រព្រឹត្ត ទៅ តាម ពេលវេលា ដែល បាន កំណត់ ។
ក្រសួង អប់រំ យុវជន និង កីឡា បញ្ជាក់ ឱ្យដឹង ថា ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ សម័យ ប្រឡង៖ ០៦ វិច្ឆិកា ២០២៣ ត្រូវបាន បញ្ចប់ ដោយ ជោគជ័យ និង មិន មាន ហេតុការខុស ប្រក្រតី កើត មាន ឡើង គួរឱ្យ កត់សម្គាល់ នោះ ទេ ។
ក្រសួង បន្ត ថា បេក្ខជន ដែល បាន ចេញ ពី ការប្រឡង មាន ទឹកមុខ ស្រស់ស្រាយ សប្បាយរីករាយ ដែល បញ្ជាក់ ថា ដំណើរការប្រឡង មធ្យមសិក្សា ទុតិយភូមិ ពិតជា ប្រព្រឹត្តទៅ ដោយ គោរព តាម គោលការណ៍ ច្បាប់ យុត្តិធម៌ តម្លាភាព និង លទ្ធផល ទទួលយក បាន ។
ក្រសួង អប់រំ យុវជន និង កីឡា គ្រោង នឹង ប្រកាស លទ្ធផល ប្រឡង នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ សម្រាប់ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្ដាល និង ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ សម្រាប់ ខេត្ត ផ្សេង ទៀត ៕
សេចក្តីប្រកាស របស់ ក្រសួង ការបរទេស រុស្ស៉ី បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « គិត ត្រឹម ម៉ោង ០០៖០០ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នីតិវិធី នៃ ការដក រុស្ស៉ី ចេញ ពី សន្ធិសញ្ញា CFE ដែល ត្រូវបាន ព្យួរ ដោយ ប្រទេស យើង កាលពី ឆ្នាំ ២០០៧ គឺ បាន បញ្ចប់ រួចរាល់ ជា ស្ថាពរ ហើយ » ។ រុស្ស៉ី បាន ផ្អាក ការចូលរួម សន្ធិសញ្ញា នេះ ទាំងស្រុង កាលពី ឆ្នាំ ២០១៥ ហើយ នៅក្នុង ឆ្នាំ ២០២៣ នេះ ទីក្រុង មូស្គូ បាន ប្រកាស ពី ចេតនា ដក ខ្លួន ចេញ តែម្តង ។
សន្ធិសញ្ញា CFE ត្រូវបាន ចុះហត្ថលេខា នៅ ឆ្នាំ ១៩៩០ ដោយ បក្ស សម្ព័ន្ធ យោធា ណា តូ និង អតីត បក្ស សម្ព័ន្ធ យោធាក តិកាសញ្ញា ទីក្រុង វ៉ាសូវី ហើយ បាន ចូល ជាធរមាន នៅ ឆ្នាំ ១៩៩២ ។ សន្ធិសញ្ញា នេះ ត្រូវបាន បង្កើតឡើង ក្រោម គោលដៅ បង្កើត តុល្យភាព រវាង សម្ព័ន្ធភាព យោធា ទាំង២ តាមរយៈ ការកំណត់ ចំនួន សព្វាវុធ និង សម្ភារ យោធា ដែល ភាគី ទាំង ពីរ ត្រូវបាន អនុញ្ញាតឱ្យ ដាក់ពង្រាយ ។
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នា ព្រឹក ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន ប្រារព្ធ មី ទ្ទីង អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៧០ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា ( ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០២៣ ) និង ខួប លើក ទី១៩ ឆ្នាំ នៃ ការគ្រង ព្រះបរម រាជសម្បត្តិ របស់ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ពិធី នេះ ស្ថិត ក្រោម វត្តមាន លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ និង លោក ខូយ ឃុន ហ៊ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ស្ដី ទី ដោយ មាន ការចូលរួម ពី លោក លោកស្រី ជា សមាជិក ក្រុមប្រឹក្សា ខេត្ត អភិបាល រង ខេត្ត មេបញ្ជាការ កង កម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រធាន មន្ទីរ អង្គភាព លោក អភិបាល ក្រុង ស្រុក មន្ត្រីរាជការ ប្រជាពលរដ្ឋ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស យុវជន កាកបាទ ក្រហម កាយ រិទ្ធ និង យុវជនស.ស .យ . ក ខេត្ត ជាច្រើន រូប ទៀត ។
លោក គីម រិទ្ធី បាន ថ្លែង ថា ថ្ងៃ នេះ ជា ថ្ងៃ ដ៏ មហានក្ខ ឬក្ស ឧត្តុង្គឧត្តម ដែល ខេត្ត ព្រះវិហារ បាន ប្រារព្ធ ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៧០ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា និង ផ្សាភ្ជាប់ ជាមួយ ព្រះរាជ ពិធី គ្រង ព្រះបរម រាជសម្បត្តិ ខួប លើក ទី ១៩ ឆ្នាំ របស់ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ របស់ យើង ផងដែរ ។
សមិទ្ធផល ទាំងនេះ ផ្តើម ចេញ ពី កម្លាំង សាមគ្គី ដ៏ មុត ស្រួច របស់ ប្រជាជាតិ យើង ដែល មាន តម្លៃ ជ្រាលជ្រៅ ជា ប្រវត្តិសាស្រ្ត ដោយ បាន បង្កើត ជា មូលដ្ឋានគ្រឹះ រឹងមាំ លើ គ្រប់ វិស័យ ដើម្បី ធានា ដល់ ការស្ថិតស្ថេរ គង់វង្ស និង រីកចម្រើន របស់ កម្ពុជា ៕ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ ជា វិធានការ ជាក់ស្តែង មួយ របស់ ចិន ដើម្បី សម្រេច ការបើក ទូលាយ ប្រកបដោយ កម្រិត ខ្ពស់ និង ជំរុញ សេដ្ឋកិច្ច សកល
( ប៉េកាំង ) ៖ កន្លងមក មិន ថា ពេល ចូលរួម សកម្មភាព ក្នុង ស្រុក ឬ វេទិកា អន្តរជាតិ ក្តី ថ្នាក់ដឹកនាំ ចិន តែង លើកឡើង ថា « ទ្វារ បើក ទូលាយ របស់ ប្រទេស ចិន នឹង មិន បិទ ជាដរាប » ។ ការគូសបញ្ជាក់ ម្តង ហើយ ម្តង ទៀត របស់ ថ្នាក់ដឹកនាំ ចិន ជា ការប្រាប់ ពី គោលជំហរ របស់ ប្រទេស ចិន ដែល រីករាយ ធ្វើ ការប្រាស្រ័យទាក់ទង ជាមួយ បណ្តា ប្រទេស លើ ពិភពលោក ដើម្បី ទទួលបាន វិបុលភាព និង ការអភិវឌ្ឍ រួម ។
ដើម្បី សម្រេចបាន នូវ ពាក្យសន្យា ស្តីពី ការបើក ទូលាយ ដោយ កម្រិត ខ្ពស់ ប្រទេស ចិន បាន ដាក់ចេញ វិធានការ និង មាន ការអនុវត្ត ជាក់ស្តែង ជាច្រើន ក្នុង នោះ ពិព័រណ៍ នាំចូល ចិន អន្តរជាតិ ជាពិព័រណ៍ ដំបូង បង្អស់ លើ ពិភពលោក ដែល ប្រើ ពាក្យ « នាំចូល » សម្រាប់ ធ្វើជា ឈ្មោះ នៃ ពិព័រណ៍ ថ្នាក់ ជាតិ ដែល បង្ហាញ ពី ការស្វាគមន៍ ចំពោះ រាល់ ផលិតផល មាន គុណភាព ខ្ពស់ នៃ បណ្តា ប្រទេស ក្នុង ការនាំចូល ទៅ ប្រទេស ចិន ដែល នេះ ជា ឱកាស មាស មួយ សម្រាប់ សហគ្រាស លើ ពិភពលោក បញ្ជូន ផលិតផល របស់ ខ្លួន ទៅក្នុង ទីផ្សារ ចិន ។
អត្ថបទ ដោយ ៖ លោក តាំង ស៊ី ឡេង . បុគ្គលិក វិទ្យុ មិត្តភាព កម្ពុជា - ចិន លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត និង មិត្ត កាយ ឫទ្ធិ នារី តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក រួមគ្នា ដាំ ដើមឈើ ខាងលិច ប្រាសាទ អង្គរវត្ត
ការដាំ ដើមឈើ នេះ ធ្វើឡើង នា ឱកាស មហាសន្និបាត មិត្ត កាយ ឫទ្ធិ នារី តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក ក្រោម ប្រធានបទ៖ យើង រួមគ្នា អភិវឌ្ឍ អនាគត កុមារី និង យុវតី ៕ ធនាគា អាហរ័ណ - នីហរ័ណ កូរ៉េ ប្តេជ្ញា បន្ត កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អភិវឌ្ឍន៍ ជនបទ នៅ កម្ពុជា
ដើម្បីឱ្យ ស្រប ទៅនឹង យុទ្ធសាស្រ្ត បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី នេះ ក្រសួង បាន និង កំពុង អនុវត្ត តាម ចក្ខុវិស័យ របស់ ខ្លួន គឺ ការលើកកម្ពស់ គុណភាព និង គុណ តម្លៃ ជីវិត រស់ នៅ របស់ ប្រជាជន ជនបទ ប្រកបដោយ បរិយា បន្ន ទាំង ផ្នែក សេដ្ឋកិច្ច សង្គម និង វប្បធម៌ តាមរយៈ កម្មវិធី អាទិភាព ចំនួន ៤៖
លោក រដ្ឋមន្ត្រី បាន ជម្រាប ជូន លោកស្រី នាយិកា និង សហការី ថា ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន ត្រៀម ខ្លូន រួច ជាស្រេច ក្នុង ការបន្ត កិច្ចសហប្រតិបត្តិការ ជា ដៃគូ ជាមួយ Korean Eximbank នៅក្នុង អាណត្តិ ទី៧នេះ ក្រសួង បាន ធ្វើការ ជាមួយ ក្រសួង ស្ថាប័ន និង អង្គភាព ពាក់ព័ន្ធ បាន យ៉ាង ស្អិត ល្មួត ក្រោម ឆ័ត្រ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា តែ មួយ សំដៅ ផ្តល់ ប្រយោជន៍ ពិត ជូន ដល់ ប្រជាពលរដ្ឋ ។
លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ចំពោះ ភាគី មិត្ត កូរ៉េ ដែល តែងតែ ជួយ គាំទ្រ ការអភិវឌ្ឍ ប្រទេស កម្ពុជា និង ថ្លែងអំណរគុណ លោកស្រី នាយិកា ធនាគា អាហរ័ណ - នីហរ័ណ កូរ៉េ ប្រចាំ កម្ពុជា ដែល បន្ត កិច្ចសហប្រតិបត្តិការ ជា ដៃគូ ជាមួយ ក្រសួង ផងដែរ ៕ ក្រសួង ទេសចរណ៍ រៀបចំ ឱ្យ មាន ការវាយតម្លៃ ពាក់កណ្ដាល អាណត្តិ នៃ ការអនុវត្ត ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ ឆ្នាំ ២០២១ - ២០២៥ ដើម្បី ឆ្លុះបញ្ចាំង ពី វឌ្ឍនភាព ទេសចរណ៍ កម្ពុជា និង រក ឱ្យ ឃើញ បញ្ហា សម្រាប់ ដោះស្រាយ បន្ត
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ បាន ផ្សព្វផ្សាយ នូវ កិច្ចការ ចាំបាច់ មួយ ដល់ រដ្ឋបាល រាជធានី - ខេត្ត ក៏ ដូចជា មន្ទីរ ទេសចរណ៍ រាជធានី - ខេត្ត នានា នោះ គឺ ការវាយតម្លៃ ពាក់កណ្ដាល អាណត្តិ នៃ ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ ឆ្នាំ ២០២១ - ២០២៥ របស់ រដ្ឋបាល រាជធានី - ខេត្ត នីមួយ ៗ ដើម្បី ឆ្លុះបញ្ចាំង ពី វឌ្ឍនភាព វិស័យ ទេសចរណ៍ និង រក ឱ្យ ឃើញ នូវ បញ្ហា ប្រឈម នានា សំដៅ រួមគ្នា ដោះស្រាយ ឱ្យ មាន ប្រសិទ្ធភាព ។
លោក បាន បន្ត ថា សិក្ខាសាលា នៅ ថ្ងៃ នេះ គឺ ចង់ ផ្សព្វផ្សាយ ដល់ រដ្ឋបាល រាជធានី - ខេត្ត ពី ការអនុវត្ត តាមដាន ត្រួតពិនិត្យ និង វាយតម្លៃ ពាក់កណ្ដាល អាណត្តិ នៃ ផែនការអភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ ឆ្នាំ ២០២១ - ២០២៥ របស់ រដ្ឋបាល រាជធានី - ខេត្ត នីមួយ ៗ នោះ ពិសេស គឺ ផ្ដល់ ភាពម្ចាស់ការ ឱ្យ រដ្ឋបាល រាជធានី - ខេត្ត ក្នុង ការអនុវត្ត ឱ្យ មាន ប្រសិទ្ធភាព នូវ ផែន ការអភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ រាជធានី - ខេត្ត របស់ ខ្លួន ។
លោក ជួប រតនា បាន បញ្ជាក់ ថា ជា លទ្ធផល នៅក្នុង សិក្ខាសាលា ព្រឹក នេះ តំណាង រដ្ឋបាល រាជធានី - ខេត្ត បាន គាំទ្រ និង ជួយ ជំរុញ បន្ថែម ដល់ មន្ទីរ ទេសចរណ៍ ក៏ ដូចជា មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ ជុំវិញ ខេត្ត ដើម្បី សហការ គ្នា ប្រមូល នូវ លទ្ធផល ដែល បាន ពី ការអនុវត្ត ផែនការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ នៅក្នុង ដែន សមត្ថកិច្ច រៀង ៗ ខ្លួន ។
ដោយ មាន ការគាំទ្រ ពី រដ្ឋបាល រាជធានី - ខេត្ត យ៉ាង ដូច្នេះហើយ លោក ប្រធាន នាយកដ្ឋាន សង្ឃឹម ថា វិស័យ ទេសចរណ៍ នឹង ត្រូវបាន ជំរុញ ការស្ដារ និង លើកស្ទួយ ឱ្យ កាន់តែ មាន ភាពទាក់ទាញ មាន គុណភាព ប្រសិទ្ធភាព ផលិតផល ទេសចរណ៍ កាន់តែ ល្អ ជាង មុន ដែល នឹង ចូលរួម ទៅដល់ ការសម្រេចបាន តាម ចក្ខុវិស័យ នៃ ផែនទី ចង្អុល ផ្លូវ ស្ដីពី ការស្ដារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ កម្ពុជា ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ កាលពី ពេល កន្លងទៅ នោះ ៕
សភា ពាណិជ្ជកម្ម កម្ពុជា បោះឆ្នោត ជ្រើសរើស ប្រធាន និង សមាជិក ការិយាល័យ តំណាង នៅ ទីក្រុង ម៉ុង រ៉អាល់ ប្រទេស កាណាដា
( ភ្នំពេញ ) ៖ អនុលោម ទៅតាម សេចក្ដីសម្រេច របស់ រាជ រដ្ឋាភិបាល ស្តីពី ការបង្កើត ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ ទីក្រុង ម៉ុង រ៉េអាល់ ខេត្ត កេប៊ិច ប្រទេស កាណាដា . នៅ ថ្ងៃទី៦ ខែ វិច្ឆិកា ឆ្នាំ ២០២៣ សភា ពាណិជ្ជកម្ម កម្ពុជា រួម និង ក្រសួង ពាណិជ្ជកម្ម រៀបចំ ការបោះឆ្នោត ជ្រើសរើស ប្រធាន និង សមាជិក ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ ទីក្រុង ម៉ុង រ៉េអាល់ ខេត្ត កេប៊ិច ប្រទេស កាណាដា សម្រាប់ អាណត្តិ ទី១ លើក ទី១ ។
ពិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពី លោក លឹម ច័ន្ទ សុភ័ក្រ្ត អគ្គ នាយក រង ពាណិជ្ជកម្ម ក្នុង ប្រទេស តំណាង លោក បួន សារៈមុនី រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម និង ជា ប្រធាន គណៈកម្មការ រៀបចំ ការបោះឆ្នោត ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា អ្នក ឧកញ៉ា លឹម ហេង អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា តំណាង អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង លោក គឹម ច័ន្ទ ភិរម្យ កុងស៊ុល កិត្តិយស ប្រចាំ ទីក្រុង ម៉ុង រ៉េអាល់ ខេត្ត កេប៊ិច ប្រទេស កាណាដា ។
ការបោះឆ្នោត បាន ប្រព្រឹត្តទៅ ដោយ រលូន ស្រប តាម នីតិវិធី ច្បាប់ ជាធរមាន ។ ឆ្លង តាម លទ្ធផល នៃ ការបោះឆ្នោត លោក ម៉ូ ខេវិន ត្រូវបាន ជ្រើសរើស ជា ប្រធាន ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ ទីក្រុង ម៉ុង រ៉េអាល់ ខេត្ត កេប៊ិច ប្រទេស កាណាដា សម្រាប់ អាណត្តិ ទី១ លើក ទី១ ។
គណៈកម្មការរៀបចំ ការបោះឆ្នោត បាន ប្រកាស លទ្ធផល សមាសភាព ប្រធាន និង សមាជិក ការិយាល័យ តំណាង សភា ពាណិជ្ជកម្ម កម្ពុជា នៅ ទីក្រុង ម៉ុង រ៉េអាល់ ខេត្ត កេប៊ិច ប្រទេស កាណាដា សម្រាប់ អាណត្តិ ទី១ លើក ទី១ ចំនួន ៩រូប ៕
គណបក្ស រស្មី ខេមរា ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស៖ គណបក្ស កសិករ ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស៖ គណបក្ស ចលនា ប្រជាធិបតេយ្យ ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
ក្រោម នេះ គឺជា សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស៖ គណបក្ស ខ្មែរ អភិរក្ស ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
គណបក្ស នគរ ប្រជាធិបតេយ្យ ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
គណបក្ស ពន្លឺ ថ្មី ថ្កោល ទោស ក្រុម ពួក ប្រឆាំង ជ្រុលនិយម និង ក្រុម អង្គការ សង្គម ស៊ីវិល ដែល បំភ្លៃ ថា ការតែងតាំង សមាសភាព ប្រតិភូ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ជា ការគ្មាន ប្រយោជន៍ និង ចំណាយ ថវិកា ជាតិ ខ្ជះខ្ជាយ
ថ្នាក់ដឹកនាំ ខេត្ត កណ្តាល ប្រារព្ធ មីទ្ទីញ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី៧០ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា និង ទិវា កំណើត នៃ កងយោធពល ខេមរភូមិន្ទ ឆ្នាំ ២០២៣
ជំនួប នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នៅ វិមាន រដ្ឋសភា . លោកស្រី ឯក អគ្គ រដ្ឋទូត បាន ឱ្យដឹង ថា ឥណ្ឌា ក៏ នឹង បន្ត សហការ ជាមួយ កម្ពុជា លើ ការបណ្តុះបណ្តាល និង ផ្លាស់ប្តូរ លើ វិស័យ រួម មាន បច្ចេកវិទ្យា កសិកម្ម អប់រំ វប្បធម៌ ថាមពល ការជួយ អភិរក្ស ប្រាសាទ បុរាណ ជាដើម ។
លោកស្រី បណ្ឌិត ដេវីយ៉ានី អ៊ុតាំ ខូប្រាហ្គេត បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច រដ្ឋសភា ធិបតី ដែល បាន ចងចាំ និង បាន រំលឹក រឿង រាវ អតីតកាល ។
ជាមួយគ្នា នេះ លោកស្រី ឯក អគ្គ រដ្ឋទូត ឥណ្ឌា រូប នេះ បាន គូសបញ្ជាក់ ថា មិន ខុសពី អតីតកាល នោះ ទេ ទៅ ថ្ងៃ អនាគត និង ពេល បច្ចុប្បន្ន នេះ ឥណ្ឌា នៅតែ បន្ត ជួយ គំាទ្រ ដល់ ការអភិវឌ្ឍ នៅ កម្ពុជា ។ លោកជំទាវ ឯក អគ្គ រដ្ឋទូត បាន សន្យា ថា នឹង ខិតខំ ជំរុញ ព្រមទាំង កៀរគរ អ្នកទេសចរ អ្នក វិនិយោគ ឥណ្ឌា មក កម្ពុជា ឱ្យ បាន កាន់តែ ច្រើន ត្បិត អី ពលរដ្ឋ ឥណ្ឌា ជាច្រើន ចាប់អារម្មណ៍ ជាខ្លាំង ក្នុង ការធ្វើដំណើរ មក ទស្សនា កម្ពុជា ជាពិសេស សំណង់ ប្រាសាទ បុរាណ នៅ កម្ពុជា ដែល ជា ស្ថាបត្យកម្ម បុរាណ ដ៏ ល្អ ឯក ។
សម្តេច ប្រធាន រដ្ឋសភា បាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ លោកស្រី បណ្ឌិត ដែល បាន រួម វិភាគទាន ដ៏ មាន តម្លៃ ដល់ ការពង្រឹង ទំនាក់ទំនង ទ្វេ ភាគី ដ៏ យូរអង្វែង រវាង ប្រទេស ទាំង ពីរ កម្ពុជា - ឥណ្ឌា ។
សម្តេច រដ្ឋសភា ធិបតី បាន រំលឹក បន្ថែម ថា នៅក្នុង ឆ្នាំ ១៩៨១ សម្តេច ផ្ទាល់ បាន បំពេញ ទស្សនកិច្ច នៅ ឥណ្ឌា និង បាន រៀបរាប់ ពី វិនាសកម្ម ក្នុង របប ប៉ុល ពត ដល់ ពិភពលោក បាន ដឹង ។
សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី បាន បង្ហាញ ក្តីរំភើប រីករាយ ជាខ្លាំង នូវ លទ្ធផល នៃ ជំនួប រវាង លោកស្រី ឯក អគ្គ រដ្ឋទូត និង សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី កម្ពុជា កាលពី ដើម ខែតុលា កន្លងទៅ ថ្មី ៗ នេះ ជាពិសេស លើ ការឯកភាព គ្រោង ឱ្យ មាន ជើងហោះហើរ ត្រង់ ពី ឥណ្ឌា មកកាន់ កម្ពុជា ក្នុង ពេល ឆាប់ ៗ នេះ ។
ជាមួយគ្នា នេះ សម្តេច រដ្ឋសភា ធិបតី បាន ស្នើ លោកស្រី ឯក អគ្គ រដ្ឋទូត ជួយ ជំរុញ និង កៀរគរ អ្នកទេសចរ អ្នក វិនិយោគ ឥណ្ឌា មក ទស្សនា និង បណ្តាក់ទុន នៅ កម្ពុជា ឱ្យ បាន ច្រើន ឡើង ។ សម្តេច រដ្ឋសភា ធិបតី ក៏ បាន ស្នើ ដល់ ប្រទេស ឥណ្ឌា ជួយ បណ្តុះបណ្តាល ផ្នែក ព័ត៌មានវិទ្យា ដល់ សិស្ស និស្សិត កម្ពុជា ក៏ ដូចជា មន្រ្តី អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា កម្ពុជា ផងដែរ ។
រដ្ឋសភា កម្ពុជា បាន បង្កើត ក្រុម មិត្តភាព សភា កម្ពុជា - ឥណ្ឌា ដែល ក្រុម មិត្តភាព សភា នេះ បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការផ្សាភ្ជាប់ ទំនាក់ទំនង ប្រជាជន និង ប្រជាជន ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ វិស័យ ការទូត សភា ការចែករំលែក បទពិសោធន៍ គ្នា លើ ការងារ នីតិកម្ម និង ការគាំទ្រ គ្នា ទៅ វិញ ទៅ មក នៅ គ្រប់ វេទិកា អន្តរសភា ទាំង ក្នុង តំបន់ និង សកលលោក ។
លោកស្រី ឯក អគ្គ រដ្ឋទូត ក៏ បាន គោរព អញ្ជើញ សម្តេច រដ្ឋសភា ធិបតី ទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស ឥណ្ឌា នៅពេល សមស្រប ណាមួយ ដែល ការអញ្ជើញ នេះ សម្តេច រដ្ឋសភា ធិបតី បាន ទទួលយក ៕ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ បើក វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ គ្រប់គ្រង ចម្ការ មីន ថ្នាក់ អាស៊ាន និង តំបន់ លើក ទី៦ ក្នុង ក្របខណ្ឌ អង្គការ សហ ប្រជាជាតិ
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ទោ ប្រាក់ សុទ្ធ អគ្គ នាយក រង មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព តំណាង នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព បាន អញ្ជើញ បើក វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ គ្រប់គ្រង ចម្ការ មីន ថ្នាក់ អាស៊ាន និង តំបន់ លើក ទី៦ ក្នុង ក្របខណ្ឌ អង្គការ សហ ប្រជាជាតិ ក្រោម ការជួយ ឧបត្ថម្ភ គាំទ្រ ពី សាធារដ្ឋ បារាំង និង កិច្ចសហការ ពី ប្រទេស អូស្រ្តាលី ។
វគ្គ ហ្វឹកហ្វឺន នេះ មាន រយៈពេល ៣សប្តាហ៍ ដែល មាន យោធាចារ្យ មកពី ប្រទេស បារាំង កម្ពុជា និង អូស្រ្តាលី នឹង ផ្តល់ ការបណ្តុះបណ្តាល ដល់ សិក្ខាកាម មកពី ប្រទេស ចំនួន ១០ ដូច ជា៖ ម៉ាឡេស៊ី ឥណ្ឌូនេស៊ី ថៃ នេប៉ាល់ បង់ក្លាដែស វៀតណាម ឡាវ ម៉ុងហ្គោលី សេរី ឡាំង ការ និង កូរ៉េ ខាងត្បូង ។ វគ្គ ហ្វឹកហ្វឺន នេះ នឹង ក្លាយជា ចំណែក មួយ យ៉ាង សំខាន់ ក្នុង ការរឹត ចំណង មិត្តភាព សាមគ្គីភាព ក្នុង ប្រតិបត្តិការ រក្សា សន្តិភាព ឱ្យ កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ។
ក្នុង នាម ជា ប្រទេស ម្ចាស់ ផ្ទះ ឧត្តមសេនីយ៍ ទោ ប្រាក់ សុទ្ធ បាន បង្ហាញ សេចក្តីរីករាយ ជា អនេក ដែល បាន ទទួល ធ្វើជា ម្ចាស់ ផ្ទះ រៀងរាល់ ឆ្នាំ ដែល នេះ បង្ហាញ ឱ្យ ឃើញ ពី ការទទួលស្គាល់ ចំពោះ សមត្ថភាព និង បទពិសោធន៍ របស់ កងកម្លាំង កម្ពុជា លើ ជំនាញ បោសសម្អាត មីន ។
ឧត្តមសេនីយ៍ ទោ បាន បន្ថែម ថា វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ គ្រប់គ្រង ចំការ មីន ថ្នាក់ អាស៊ាន និង តំបន់ លើក ទី៦ នៅ កម្ពុជា នា ពេលនេះ ពិតជា មាន សារៈសំខាន់ ណាស់ ក្នុង ការចែករំលែក ព័ត៌មាន និង បទពិសោធន៍ ពី គ្នា ទៅ វិញ ទៅ មក ស្រប គ្នា នឹង ការយកចិត្តទុកដាក់ លើ វិស័យ មីន ដោយ កម្ពុជា បាន ចាត់ទុក វិស័យ នេះ ជា អាទិភាព ទី១៨ បន្ថែម ពីលើ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ទាំង ១៧ របស់ អង្គការ សហ ប្រជាជាតិ (SDGs) ។
ឧត្តមសេនីយ៍ ទោ ប្រាក់ សុទ្ធ ជឿជាក់ ថា កម្ពុជា ក៏ នឹង ដកស្រង់ បាន មេរៀន បទពិសោធន៍ ថ្មី ៗ និង ការធ្វើ ន វានុវត្ត លើ ចំណេះ ជំនាញ ថែមទៀត ពី ការពិភាក្សា ស៊ីជម្រៅ ក្នុង វគ្គ ហ្វឹកហ្វឺន នេះ ដើម្បី បង្កើន សមត្ថភាព និង ប្រសិទ្ធភាព ការងារ របស់ ខ្លួន ថែម ទៀត ក្នុង ប្រទេស សាម៉ី និង ក្នុង ប្រតិបត្តិការ រក្សា សន្តិភាព សម្រាប់ អនាគត ។
លោក វរសេនីយ៍ ត្រី Cryprien Martin បាន លើកឡើង ថា មេរៀន នៃ វគ្គ ហ្វឹកហ្វឹន នឹង ស្រប តាម ស្តង់ដារ អន្តរជាតិ ពោរពេញ ទៅ ដោយ ការចែករំលែក ផ្លាស់ប្តូរ ចំណេះដឹង គ្នា ទៅ វិញ ទៅ មក ជាពិសេស នឹង ផ្តោត សំខាន់ ទៅ លើ ចំណេះដឹង និង ជំនាញ ដែល ចាំបាច់ សម្រាប់ រៀបចំ ផែនការរចនាសម្ព័ន្ធ ដឹកនាំ គ្រប់គ្រង និង សម្របសម្រួល ប្រតិបត្តិការ នៅ ទីលាន ជាក់ស្តែង ។ ទន្ទឹម នោះ ក៏ នឹង ផ្តោត សំខាន់ លើ ការចូល រុករក ពេល ប្រតិបត្តិការ ក្នុង អាគារ ដែល ជា ផ្នែក ដ៏ សំខាន់ មួយ ក្នុង ពេល បំពេញ បេសកកម្ម ។
ប្រទីប ចំនួន ៣៩ មកពី តាម មន្ទីរ អង្គភាព ស្រុក ក្រុង ចូលរួម លយ នៅ ដង ស្ទឹង សិរី សោភ័ណ ដើម្បី ពិធី អបអរសាទរ ពិធី បុណ្យ អុំ ទូក ចាប់ពី ថ្ងៃទី ៦ ដល់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា
លោក អ៊ុំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ បាន ថ្លែង ថា ក្នុង ពិធី បុណ្យ អុំ ទូក អក អំបុក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ ឆ្នាំ នេះ ចាប់ផ្តើម ពី ថ្ងៃទី ៦ ដល់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ត ទៅ ដែល មាន រយៈពេល ២២ ថ្ងៃ ហើយ ប្រទីប ដែល ចូលរួម មាន ៣៩ ប្រទី ប រួម មាន៖
ជាមួយគ្នា នេះ អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ ត្រូវបាន យកចិត្តទុកដាក់ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ឲ្យបាន ល្អ ដើម្បី ប្រជាពលរដ្ឋ និង ទេសចរណ៍ បាន មក សប្បាយរីករាយ នៅក្នុង ពិធី បុណ្យ នេះ ផងដែរ ។
ទន្ទឹមនឹង នេះ ដែរ លោក អ៊ុំ រាត្រី បាន អំពាវនាវ ដល់ បងប្អូន ទាំងអស់ ដែល បាន មក ទស្សនា ពិធី បុណ្យ ត្រូវ ចេះ គោរព ច្បាប់ ចរាចរណ៍ ឲ្យបាន គ្រប់ គ្នា ចៀសវាង ឲ្យ ផុត ពី គ្រោះថ្នាក់ ចរាចរណ៍ ដើម្បី សេចក្តីសុខ គ្រប់ ៗ គ្នា ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្លែង បែប នេះ ពេល អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ ជាង ១ម៉ឺន ៥ពាន់ នាក់ នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ នា ព្រឹក ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ប្រសាសន៍ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត គឺ ចង់ បង្ហាញ ថា ការងារ ជា នាយក រដ្ឋមន្ត្រី មាន ភាព រវល់ ណាស់ បើ ប្រៀបធៀប នឹង ពេល សម្តេច ធិបតី មិន ទាន់ ជា នាយក រដ្ឋមន្ត្រី ។
សូម ជម្រាប ថា សម្តេច ធិបតី បាន ក្លាយជា នាយក រដ្ឋមន្ត្រី កាលពី ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២៣ កន្លងទៅ ក្រោយ ទទួលបាន ការគាំទ្រ ពី ប្រជាជន និង រដ្ឋសភា ឱ្យដឹកនាំ រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី ៕
«No More Bet» ភាពយន្ត មួយ ដែល បាន ផ្សព្វផ្សាយ កាលពី ប៉ុន្មាន ខែ មុន ដោយ មាន លក្ខណៈ វាយប្រហារ ដល់ សន្តិសុខ សុវត្ថិភាព និង ការជួញដូរ កម្លាំង ពលកម្ម នៅ ប្រទេស មួយចំនួន ដូចជា ថៃ ភូមា និង កម្ពុជា ជាដើម ។ ក្រោយ ភាពយន្ត នេះ ត្រូវបាន ផ្សព្វផ្សាយ តាម បណ្ដាញ អ៉ីនធឺណិត មាន ជន បរទេស ជាច្រើន បាន លើកឡើង ពី ការព្រួយបារម្ភ ពី សុវត្ថិភាព បើ ពួកគេ ធ្វើដំណើរ មកកាន់ ប្រទេស ទាំងនេះ ។
សម្តេច ធិបតី បាន ថ្លែងអំណរគុណ ជាថ្មី ចំពោះ វិនិយោគិន ជនជាតិ ចិន ទាំងនោះ ដែល មាន ជំនឿ ទុកចិត្ត លើ ប្រទេស កម្ពុជា ហើយ បាន បន្ត ជួយ យកអាសារ ការពារ កម្ពុជា ។ សម្តេច ស្នើ ក៏ ឱ្យ បន្ត បង្កើត ការងារ ផ្ដល់ ការយកចិត្តទុកដាក់ ទៅ លើ ជីវភាព សុវត្ថិភាព និង បរិស្ថាន ការងារ ដល់ បងប្អូន កម្មករ បន្ត ទៀត ។
សម្តេច បាន បញ្ជាក់ ថា « សូម បន្ត ជឿ ទុកចិត្ត និង ពង្រីក ការវិនិយោគ ជា បន្ថែម ទៀត រដ្ឋាភិបាល នឹង ខិតខំ ជួយ ហើយក៏ នឹង ខិតខំ បន្ត ទាក់ ម៉ូយ មកវិនិយោគ ថែម ទៀត »៕
ក្នុង ន័យ នេះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ចង់ ប្រៀបធៀប ភាព ខុសគ្នា រវាង ទារក នៅ សម័យ ប្រទេសជាតិ កំពុងតែ អភិវឌ្ឍន៍ ក្រោម ម្លប់ ដ៏ ត្រជាក់ នៃ សុខ សន្ដិភាព និង កាលពី ជំនាន់ សម្ដេច នៅ ទារក ពេល ប្រទេស កំពុង ធ្លាក់ ក្នុង ភ្លើង សង្គ្រាម ដែល លំបាក សព្វគ្រប់ បែបយ៉ាង ។
ក្នុង ជំនួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ . សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា ទារក សម័យ នេះ ទទួលបាន ការគាំពារ សុខភាព ជាមួយ ម្ដាយ តាំងពី ខ្លួន ចាប់កំណើត នៅក្នុង ផ្ទៃ ខុសពី ជំនាន់ សម្ដេច នៅពេល កើត មក សូម្បីតែ ថ្នាំ សង្កូវ ក៏ គ្មាន ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ជំនាន់ ខ្ញុំ ប៊ិស ស្លាប់ ម្ដង ដោយសារ គេ អត់ មាន ថ្នាំ ហើយ ក្ដៅ ខ្លួន ខ្លាំង ម្ដាយ ក៏ អត់ មាន ថ្នាំ សង្កូវ ស្រួលបួល ទេ ។ គេ មក ប្រាប់ ម៉ែ ( សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ) ពេទ្យ ខ្មែរ ក្រហម ថា មិត្ត អើយ ត្រៀមខ្លួន ទៅ ត្រៀម ចិត្ត ទៅ ។ កូន ទី១ កើត មក បង របស់ ខ្ញុំ ត្រូវ ស្លាប់ ដោយសារ ពេទ្យ ប្រហែស ធ្លាក់ នៅសល់ មួយ ទៀត ឥលូវ ក្ដៅ ខ្លួន អត់ មាន ថ្នាំ ត្រៀម ចិត្ត ទៅ » ។
សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី ចង់ ប្រៀបធៀប ថា សម័យ ស្រុក មាន សុខ សន្ដិភាព សូម្បីតែ កូន នៅក្នុង ផ្ទៃ នៅឡើយ ក៏ ទទួលបាន ការគាំពារ សុខភាព ជាមួយ ម្ដាយ ក្នុង នោះ មាន ទាំង ការពិនិត្យ សុខភាព ផ្ដល់ អាហារូបត្ថម្ភ វ៉ាក់សាំង បង្ការ ផ្សេង ដែល ជួយ ដល់ ការការពារ សុខភាព ផងដែរ ។ ពោល ផ្ទុយ ទាំងស្រុង នៅ ពេល ដែល ប្រទេសជាតិ ធ្លាក់ ក្នុង ភ្លើង សង្គ្រាម រឿងរ៉ាវ ទាំងអស់ នេះ ត្រូវបាន គេ មើល រំលង ៕
ការបោះឆ្នោត សកល ក្នុង នោះ រួម មាន ទាំង ការបោះឆ្នោត ប្រធានាធិបតី អ៊ុយក្រែន គ្រោង នឹង ត្រូវ ប្រពឹត្ត ទៅ នៅ និទាឃ រដូវ ឆ្នាំ ក្រោយ ។ ប៉ុន្តែ ការបោះឆ្នោត នេះ មិន អាច ធ្វើឡើង បាន ឡើយ ក្នុង ពេល ប្រទេស អ៊ុយក្រែន កំពុង ស្ថិត នៅក្រោម ច្បាប់ អាជ្ញា សឹក ដែល ត្រូវបាន ប្រកាស ចាប់តាំងពី សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី ផ្ទុះឡើង កាលពី ឆ្នាំ ២០២២មក ។
( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ នគរបាល មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន បាន បង្ក្រាប ករណី ជួញដូរ និង រក្សាទុក គ្រឿងញៀន ឃាត់ខ្លួន ជនជាតិ ចិន តៃវ៉ាង ៣នាក់ និង ថ្នាំ ញៀន ជាង ២គីឡូក្រាម នៅ រាជធានី ភ្នំពេញ ។
ប្រតិបត្តិការ ចុះបង្ក្រាប នេះ ដោយ អនុវត្តន៍ តាម បទបញ្ជា របស់ នាយ ឧត្ដមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ការដឹកនាំ បញ្ជា របស់ នាយ ឧត្ដមសេនិយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការទទួល ផែន ប្រឆាំង គ្រឿងញៀន និង ការដឹកនាំ ផ្ទាល់ របស់ លោក ឧត្ដមសេនិយ៍ ឯក ឃឹង សារ៉ាត់ នាយក មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ត្រូវបាន សមត្ថកិច្ច នៃ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ចាត់ការ តាម ច្បាប់ ។
សូម ជម្រាប ថា នាយ ឧត្ដមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ បាន ដាក់បញ្ជា យ៉ាង ម៉ឺងម៉ាត់ ឱ្យ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បោសសម្អាត ឧក្រិន ជន គ្រឿងញៀន ឱ្យ អស់ ហើយ នាយក មន្ទីរ ប្រឆាំង គ្រឿងញៀន ដែល ដឹកនាំ ដោយ ឧត្ដមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ បាន ប្តេជ្ញាចិត្ត ថា នឹង ចុះបង្ក្រាប គ្រឿងញៀន តាម បណ្ដា រាជធានី - ខេត្ដ ឲ្យ អស់ នូវ បញ្ហា គ្រឿងញៀន នេះ ៕
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បំពាក់ គ្រឿង ឥស្សរិយយស ជូន សមាជិក ព្រឹទ្ធសភា ចុង នីតិកាល ទី៤ ជាង ៥០ នាក់ ចំពោះ ការខិតខំ បម្រើ ជាតិ និង អភិវឌ្ឍន៍ ប្រទេសជាតិ
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា នៃ កម្ពុជា នា ព្រឹក ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ បំពាក់ គ្រឿង ឥស្សរិយយស ជូន សមាជិក ព្រឹទ្ធសភា ចុង នីតិកាល ទី៤ ចំនួន ៥៧ នាក់ ចំពោះ ការខិតខំ បម្រើ ជាតិ ប្រជាពលរដ្ឋ និង រួមចំណែក កសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ឆ្ពោះ ទៅកាន់ នីតិរដ្ឋ ។
ការថ្លែង បែប នេះ របស់ សម្ដេច ធិបតី ត្រូវបាន ធ្វើឡើង ឱកាស ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ប្រមាណ ១៥. ១៩៤ នាក់ នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ខេមបូឌា ចេជាង ហ្គ័រ ជី អេស អ៉ីហ្សេត ស្ថិត ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
សម្ដេច ធិបតី បាន ឱ្យដឹង ថា ដើម ឡើយ ប្រជាពលរដ្ឋ ភាគ ច្រើន មិន មាន កម្មសិទ្ធិ ដីធ្លី នោះ ទេ ពួកគាត់ មាន ត្រឹមតែ សិទ្ធិ កាន់កាប់ ប្រើប្រាស់ អាស្រ័យ ផល ប៉ុណ្ណោះ ដូច្នេះ រាជ រដ្ឋាភិបាល បាន ជំរុញ កន្លងមក ច្រើន ហើយ ដែរ ពិសេស នៅ ឆ្នាំ ២០១១ សម្ដេច តេជោ ហ៊ុន សែន ដែល ជា អតីត នាយក រដ្ឋមន្ត្រី បាន ដាក់ចេញ គោល នយោបាយ វាស់វែង ដីធ្លី ។
សម្ដេច ធិបតី បាន បន្ត ថា បច្ចុប្បន្ន ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ កំពុង វាស់វែង បាន ជាង ៧លាន ក្បាល ដី ហើយ ចែក បណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ បាន ២លាន ក្បាល ដី នៅសល់ ៥លាន ក្បាល ដី ទៀត ដែល ត្រូវ ចែក បណ្ណ កម្មសិទ្ធិ ឱ្យ បាន ឆាប់ ជូន ប្រជាពលរដ្ឋ ។
សម្ដេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន បន្ត ទៀត ថា លោក សាយ សំអាល់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ដែនដី បាន ដាក់ចេញ គោលការណ៍ យុទ្ធសាស្ត្រ ហើយ សម្ដេច ធិបតី ក៏ បាន ចារ ឯកភាព ផ្ដល់ គោលការណ៍ រួចហើយ ដែរ ។
សម្ដេច ធិបតី បាន ណែនាំ ឱ្យ ប្រើប្រាស់ កម្លាំង សរុប ទាំង ថ្នាក់ កណ្ដាល ទាំង ថ្នាក់ រាជធានី - ខេត្ត ដើម្បី បំពេញ កិច្ចការ ចែក បណ្ណ កម្មសិទ្ធិ ដីធ្លី ឱ្យ ប្រជាពលរដ្ឋ ឱ្យ បាន លឿន កុំ ឱ្យ កកស្ទះ ដើម្បី ប្រជាពលរដ្ឋ យក ទៅ ប្រើប្រាស់ ៕
( ភ្នំពេញ ) ៖ សម្តេច ព្រះមហា អរិយវង្ស បណ្ឌិត យ៉ន សេង យៀត ព្រះសាកលវិទ្យាធិការ រង ទទួលបន្ទុក ដឹកនាំ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហនុ រាជ សូម ថ្លែងអំណរគុណ ចំពោះ អគ្គ មហា ឧបាសិកា មហាសទ្ធម្ម ជោតិក ធ ជៈ សុខ អ៉ឹម ព្រមទាំង បុត្រ និង ចៅ ដែល បាន ចូល បច្ច័យ ចំនួន ១០.០០០ ដុល្លារ ( មួយ ម៉ឺន ដុល្លារ អាមេរិក ) ដើម្បី កសាង អគារ សិក្សា និង សាល ប្រជុំ ថ្មី នៃ ពុទ្ធិក សាកលវិទ្យាល័យ ។
អគារ ថ្មី នៃ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហនុ រាជ នេះ ដែរ មាន បណ្តោយ ២៣.៥៥ ម៉ែត្រ ទទឹង ១៧.៥ ម៉ែត្រ កម្ពស់ ៤ ជាន់ សម្រាប់ គណៈ គ្រប់គ្រង មន្ត្រី សង្ឃ មន្ត្រីរាជការ សាស្ត្រាចារ្យ បាន បំពេញ ការងារ និង សមណ និស្សិត និស្សិត បាន សិក្សា រៀនសូត្រ សំដៅ បន្ត ជួយ ការអភិវឌ្ឍ ធនធាន មនុស្ស ជា ឧត្តម ប្រយោជន៍ សង្គមជាតិ ឱ្យ កាន់តែ មាន ភាពរីកចម្រើន ជា និរន្តរ៍ ។
ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហនុ រាជ គឺជា គ្រឹះស្ថាន ពុទ្ធិក ឧត្ដម សិក្សា ពុទ្ធសាសនា ដំបូង និង ឈាន មុខ គេ នៅ កម្ពុជា ដែល បាន បង្កើតឡើង នៅ ថ្ងៃទី១ ខែកក្កដា ឆ្នាំ ១៩៥៤ ក្រោម ព្រះរាជូបត្ថម្ភ របស់ ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហនុ ព្រះបរម រតន កោដ្ឋ ។ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហនុ រាជ មាន ទីតាំង ទល់មុខ ព្រះបរម រាជ វាំង និង សាល សន្និសីទ ចតុមុខ លេខ ៣៩៣ តិរវិថី ព្រះស៊ីសុវត្ថិ សង្កាត់ ជ័យ ជំនះ ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ២០ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៦ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ២០ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ២០ នាក់ នោះ មាន ១០នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ០៤ ករណី និង ជនសង្ស័យ ១០នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ០៩ ករណី ។
( បន្ទាយមានជ័យ )៖ កម្លាំង នគរបាល ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ បាន បើក ប្រតិបត្តិការ ចុះបង្ក្រាប ទីតាំង ខារ៉ាអូខេ មួយ កន្លែង យីហោ «SKY KTV» ក្រោយ សង្ស័យ ពាក់ព័ន្ធ ករណី ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន ហើយ ឈានដល់ ការឃាត់ខ្លួន មនុស្ស ប្រុស ស្រី ចំនួន ១០៧ នាក់ ក្នុង នោះ ជន បរទេស ៤២ នាក់ ។
សេចក្ដីរាយការណ៍ បាន ឲ្យដឹង ថា ប្រតិបត្តិការ នេះ បាន ធ្វើឡើង នៅ យប់ ថ្ងៃទី ០៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ ក្រោម ការសម្របសម្រួល ពី លោក លឹម ប៊ុន សុភ័ក្រ ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង ខេត្ត និង ដឹកនាំ ប្រតិបត្តិការ ដោយ លោក វរសេនីយ៍ ឯក សៅ សារឿន អធិការ នគរបាល ក្រុង ប៉ោយប៉ែត ។
ទីតាំង ខារ៉ាអូខេ «SKY KTV» ត្រូវបាន បិទ បណ្តោះអាសន្ន រីឯ ជនសង្ស័យ ប្រុស ស្រី ទាំង នេះ ត្រូវបាន នគរបាល ឃាត់ខ្លួន សួរនាំ និង ធ្វើតេស្ត រក សារធាតុ ញៀន ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ៕
( ភ្នំពេញ ) ៖ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅតែ បន្ដ ទុក ថា ភ្នាក់ងារ សន្ដិសុខ ឯកជន គឺជា កម្លាំង ជំនួយ ដ៏ សំខាន់ ដល់ កម្លាំង មាន សមត្ថកិច្ច ដូច្នេះហើយ ដើម្បី បំពេញ ការងារ ប្រកបដោយ ប្រសិទ្ធភាព សំដៅ ចូលរួមចំណែក ថែរក្សា សន្ដិុ សុខ សណ្ដាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាព សង្គម ភ្នាក់ងារ សន្ដិសុខ ឯកជន ទាំងអស់ ត្រូវតែ ទទួលបាន ការបណ្ដុះបណ្ដាល ជំនាញ សំខាន់ ៗ បន្ថែម ទៀត ជា បន្ដ បន្ទាប់ ។
ជាក់ស្ដែង នៅ ព្រឹក ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ បាន អនុញ្ញាតឲ្យ នាយកដ្ឋាន គ្រប់គ្រង សន្ដិសុខ ឯកជន រៀបចំ បើក វគ្គ បំប៉ន ជំនាញ ភ្នាក់ងារ សន្តិសុខ ឯកជន លើក ទី ៥៤ ដល់ ភ្នាក់ងារ សន្ដិសុខ ឯកជន ។ ពិធី បើក វគ្គ បំប៉ន ជំនាញ នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សន្ដិសុខ ឯកជន ។
បន្ថែម ពី នេះ លោក ក៏ បាន ថ្លែងអំណរគុណ ដល់ ម្ចាស់ ក្រុមហ៊ុន ផ្តល់ សេវា សន្តិសុខ ឯកជន និង ម្ចាស់ សហគ្រាស គ្រឹះស្ថាន ដែល តែងតែ ចាត់ បញ្ជូន ភ្នាក់ងារ សន្តិសុខ ឯកជន មក ទទួល ការបំពាក់ បំប៉ន ជំនាញ ភ្នាក់ងារ សន្តិសុខ ឯកជន ឲ្យ មាន វិជ្ជាជីវៈ ច្បាស់លាស់ ។ ការបំពាក់ បំប៉ន នេះ ពិតជា មាន សារៈសំខាន់ ណាស់ សម្រាប់ ភ្នាក់ងារ សន្តិសុខ ឯកជន ឲ្យ យល់ដឹង ច្បាស់ ពី តួនាទី ភារកិច្ច និង ច្បាប់ ដែល ត្រូវ អនុវត្ត ជា ប្រចាំ ថ្ងៃ ។
ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាពធាតុអាកាស នៅ ព្រះរាជាណាចក្រ កម្ពុជា សម្រាប់ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ក្រសួង បាន បញ្ជាក់ ថា ប្រព័ន្ធ សម្ពាធ ខ្ពស់ ពី ប្រទេស ចិន លាតសន្ធឹង មក លើ ភាគ ខាងជើង និង ភាគ ឦសាន នៃ ព្រះរាជាណាចក្រ កម្ពុជា រួម ជាមួយ ខ្យល់ មូសុង ឦសាន ខ្សោយ ។ ទន្ទឹមនឹង នេះ មាន ចរន្ដ ខ្យល់ ក្ដៅ ហើយ សើម ពី សមុទ្រ ចិន ខាងត្បូង នឹង បក់ ពី ទិស ខាងកើត និង ទិស អាគ្នេយ៍ មក លើ ប្រទេស កម្ពុជា ។ ស្ថានភាព បែប នេះ នឹង ធ្វើឱ្យ ធាតុអាកាស នៅ ថ្ងៃទី ៧ ខែវិច្ឆិកា ២០២៣៖
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អបអរសាទរ ខួប លើក ទី ២០ របាំ ព្រះរាជ ទ្រព្យ ត្រូវបាន ចុះ ក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្សជាតិ
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន បង្ហោះ សារ អបអរសាទរ ខួប លើក ទី ២០ របាំ ព្រះរាជ ទ្រព្យ ត្រូវបាន ចុះ ក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្សជាតិ ( ៧ វិច្ឆិកា ២០០៣ - ៧ វិច្ឆិកា ២០២៣) ។
គួរ រំលឹក ថា របាំ ព្រះរាជ ទ្រព្យ ត្រូវបាន ចុះ ក្នុង បញ្ជី ជា សម្បត្តិ បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្សជាតិ នៅ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០០៣ នៅ ទីក្រុង អ៉ីស្តង់ ប៊ុល ប្រទេស តួកគី ។
របាំ ក្បាច់ ខ្មែរ បុរាណ ឬ របាំ ព្រះរាជ ទ្រព្យ នេះ ជា ទម្រង់ របាំ សក្ការ : មាន ភាពល្បីល្បាញ ខាង កាយវិការ ទន់ភ្លន់ គួរឱ្យ ចង់ គយ គន់ និង មាន ទ្រង់ គ្រឿង ចាំង ភ្លឺ ផ្លេក ៗ ។
របាំ ព្រះរាជ ទ្រព្យ របាំ ក្បាច់ បុរាណ ខ្មែរ ជា ប្រភេទ របាំ ដែល នាដក រ ប្រើ ចលនាកាយវិការ ក្បាច់ និង មនោសញ្ចោត នា យ៉ាង ប៉ិនប្រសប់ ទៅ តាម ការវិវត្ត នៃ សាច់រឿង ដែល រៀបរាប់ បញ្ជាក់ ដោយ ទំនុក ច្រៀង នៃ ក្រុម ចម្រៀង ជា ពួក នឹង ត្រូវបាន ប្រគំ ដោយ វង់ ភ្លេង ពិណពាទ្យ ដែល មាន តួនាទី ប្រគំ ជូន របាំ នេះ ផងដែរ ៕
ព្រឹក ថ្ងៃ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ ជាង ១ម៉ឺន ៥ពាន់ នាក់ នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ៩រោច ខែ អស្សុជ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ប្រមាណ ១៥. ១៩៤ នាក់ ។ ក្នុង នោះ មាន កម្ម ការិនី មាន ផ្ទៃពោះ ចំនួន ៤៨២ នាក់ ។ កិច្ច សំណេះសំណាល ធ្វើឡើង នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ខេមបូឌា ចេជាង ហ្គ័រ ជី អេស អ៉ីហ្សេត ស្ថិត ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
បច្ចុប្បន្ន ខេត្ត ព្រះសីហនុ មាន រោងចក្រ សហគ្រាស សរុប ចំនួន ៦២៣ និង មាន កម្មករ និយោជិត កំពុង បម្រើ ការងារ សរុប ប្រមាណ ៨ម៉ឺន ផ្តល់ ប្រាក់ ឈ្នួល សរុប ជាង ២៣៨ លាន ដុល្លារ អាមេរិក ក្នុង មួយ ឆ្នាំ ។ ក្នុង នោះ រោងចក្រ សហគ្រាស ក្នុង វិស័យ កាត់ដេរ មាន ចំនួន ៥៨ ផ្តល់ ការងារ ជូន កម្មករ និយោជិត សរុប ប្រមាណ ២ម៉ឺន នាក់ ផ្តល់ ប្រាក់ ឈ្នួល សរុប ជាង ៦២ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ។
នយោបាយ បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ គឺជា នយោបាយ អាទិភាព មួយ របស់ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ទាំង ក្នុង អាណត្តិ ចាស់ និង អាណត្តិ ថ្មី ។ ក្រោយ បង្កើត រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី ហើយ ភ្លាម សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ចាប់ យក កម្មករ និយោជិត ក្នុង វិស័យ ឧស្សាហកម្ម ផ្នែក វាយន ភណ្ឌ កាត់ដេរ ផលិត ស្បែកជើង និង ផលិតផលិតផល ធ្វើដំណើរ និង កាបូប ជា ជំនួប សាធារណៈ លើក ដំបូង និង មាន ជំនួប ជា បន្តបន្ទាប់ ទៀត ។
ក្នុង ជំនួប កន្លងទៅ សម្តេច ធិបតី បាន បង្ហាញ ពី គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្នុង នីតិកាល ថ្មី ជាពិសេស យុទ្ធសាស្ត្រ បញ្ចកោណ - ដំណាក់កាល ទី១ ដែល ជា យុទ្ធសាស្ត្រ ផ្តោត ការយកចិត្តទុកដាក់ ខ្ពស់ លើ កំណើន ការងារ និង លើកកម្ពស់ ជីវភាព របស់ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ល្អ ប្រសើរ ជាពិសេស ការងារ អាទិភាព ៦ សម្រាប់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ អនុវត្ត ឱ្យ មាន ប្រសិទ្ធភាព ក្នុង ឆ្នាំ ២០២៣ នេះ រួម មាន៖
២៖ រៀបចំ លិខិត បទដ្ឋាន គតិយុត្តិ ជាបន្ទាន់ ដើម្បី ត្រៀម ដាក់ ឱ្យ ដំណើរការ របប សន្តិសុខ សង្គម ផ្នែក ថែទាំ សុខភាព តាមរបប ភាគ ទាន ដោយ ស្ម័គ្រចិត្ត សម្រាប់ អ្នក ក្នុង បន្ទុក សមាជិក ប .ស.ស . ដើម្បី ជួយ សម្រាល បន្ទុក ចំណាយ ផ្នែក ថែទាំ សុខភាព របស់ កម្មករ និយោជិត និង ក្រុមគ្រួសារ ឱ្យ បាន លឿន និង ត្រូវ ផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ ដល កម្មករ និយោជិត ព្រមទាំង បង្កើត យន្ត ការងាយស្រួល សម្រាប់ កម្មករ និយោជិត អាច ចូលរួម ជាមួយនឹង កម្មវិធី នេះ ។
៣៖ រៀបចំ ដាក់ ឱ្យ ដំណើរការ កម្មវិធី បណ្ដុះបណ្តាល ជំនាញ បច្ចេកទេស វិជ្ជាជីវៈ ដល់ យុវជន មក ពី គ្រួសារ កីក្រ និង គ្រួសារ ងាយ រង ហានិភ័យ នៅ ទូទាំង ប្រទេស ចំនួន ប្រមាណ ១.៥លាន នាក់ និង សម្របសម្រួល ជាមួយ ភាគី ពាក់ព័ន្ធ អនុញ្ញាតឱ្យ កម្មករ និយោជិត អាច ចូលរៀន ជំនាញ វិជ្ជាជីវៈ ផង ដែរ ដើម្បី បង្កើន ផលិតភាព ប្រសិទ្ធភាព ការងារ នៅ កន្លែង ការងារ ដោយ ត្រូវ រៀបចំ វគ្គ បណ្តុះបណ្តាល នៅ វេន ពេល យប់ ឬ ចុង សប្ដាហ៍ ។
៤៖ ត្រូវ ជំរុញ ការអនុវត្ត កាតព្វកិច្ច ហ្វឹកហ្វឺន កូន ជាង ឱ្យ បាន ពេញលេញ ស្រប តាម ច្បាប់ ស្តីពី ការងារ ដោយ រួមបញ្ចូល កម្មវិធី ហាត់ ការ កម្មសិក្សា កម្មវិធី បង្កើន ជំនាញ និង ការរៀបចំ ជំនាញ ឡើងវិញ ដោយ លើកទឹកចិត្ត វិស័យ ឯកជន ចូលរួម អនុវត្ត កាតព្វកិច្ច ក្នុង ការបណ្តុះបណ្តាល កម្មករ និយោជិត និង ផ្ដល់ ការបណ្តុះបណ្តាល បន្ថែម ដល់ កម្មករ និយោជិត ដែល កំពុង ធ្វើ ការ ដើម្បី លើកកម្ពស់ សមត្ថភាព ជំនាញ បង្កើន ផលិតភាព និង លទ្ធភាព នៃ ការបង្កើន ប្រាក់ ឈ្នួល ។
៥៖ យកចិត្តទុកដាក់ ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ដល់ ស្រ្តី មាន ផ្ទៃពោះ ទាំង មុនពេល សម្រាល កូន ពេល សម្រាល កូន និង ក្រោយពេល សម្រាល កូន ឱ្យ បាន ល្អ និង កាន់តែ មាន ភាពងាយស្រួល ។ ហើយក៏ ត្រូវ ធានា ផងដែរ ថា ស្ត្រី មាន ផ្ទៃពោះ និង ជន មាន ពិការភាព បាន ចេញ ធ្វើការ មុន ១៥នាទី ។
៦៖ បង្កើត ឱ្យ មាន កម្មវិធី ប្រកួតប្រជែង លើ ប្រធានបទ ភាព សុខដុមរមនា នៅ កន្លែង ធ្វើការ ដើម្បី ប្រែក្លាយ សហគ្រាស មួយ ជា សហគមន៍ សុខសាន្ដ មួយ ចាប់ពី ឆ្នាំ ២០២៤ នេះ តទៅ ។
សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ក៏ បាន ណែនាំ ផែនការ សកម្មភាព ក្នុង រយៈពេល ពីរ ឆ្នាំ ខាងមុខ ឱ្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ យកចិត្តទុកដាក់ អនុវត្ត លើ ការងារ អាទិភាព ចំនួន ៤ទៀត ផងដែរ ដែល ក្នុង នោះ រួម មាន៖
១៖ សហការ ជាមួយ ក្រសួង កិច្ចការ នារី ក្រសួង អប់រំ យុវជន និង កីឡា តំណាង ភាគី និយោជក និង តំណាង ភាគី កម្មករ និយោជិត រួមគ្នា សិក្សា លទ្ធភាព បង្កើត ទារកដ្ឋាន និង មត្តេយ្យ សហគមន៍ នៅ តាម តំបន់ ដែល មាន រោងចក្រ ដោយ មាន ការចូលរួម ទ្រទ្រង់ ពី និយោជក និង ភាគី ពាក់ព័ន្ធ នានា ។
២៖ សហការ ជាមួយ ភាគី ពាក់ព័ន្ធ ជំរុញ ការកែលម្អ កន្លែង ហូប បាយ ឬ អាហារដ្ឋាន នៅ តាម រោងចក្រ ដែល កំពុង ដំណើរការ ឱ្យ បាន សមរម្យ សម្រាប់ កម្មករ និយោជិត និង តម្រូវ ឱ្យ មាន ការរៀបចំ កន្លែង ហូប បាយ ឬ អាហារដ្ឋាន សម្រាប់ រោងចក្រ ដែល ត្រូវ បង្កើត ថ្មី ។
៣៖ សហការ ជាមួយ ភាគី ពាក់ព័ន្ធ សិក្សា យន្តការគាំទ្រ និង លើកទឹកចិត្ត ឱ្យ មាន ការផ្លាស់ប្ដូរ ជា បណ្តើរ ៗ នូវ មធ្យោបាយ ដឹកជញ្ជូន កម្មករ និយោជិត ដែល ស្រប តាម បទដ្ឋាន បច្ចេកទេស និង ផាសុកភាព ជាង មុន ត្រឹម ឆ្នាំ ២០២៧ ។
៤៖ ជំរុញ កម្មវិធី ធ្វើតេស្ត ទទួលស្គាល់ ជំនាញ ដែល ជា ឱកាស សម្រាប់ កម្មករ និយោជិត ទាំង ក្នុង និង ក្រៅ ប្រទេស អាច មាន វិញ្ញាបនបត្រ ទទួលស្គាល់ ជំនាញ មួយ ដើម្បី បង្ហាញ ពី សមត្ថភាព និង កម្រិត ជំនាញ របស់ ខ្លួន ផងដែរ ។
ក្រោម ការសម្របសម្រួល និង យកចិត្តទុកដាក់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា កាលពី ចុង ខែកញ្ញា កន្លងទៅ នេះ ប្រាក់ ឈ្នួល អប្បបរមា របស់ កម្មករ និយោជិត ក្នុង វិស័យ វាយន ភណ្ឌ កាត់ដេរ ផលិត ស្បែកជើង និង ផលិតផលិតផល ធ្វើដំណើរ និង កាបូប ត្រូវបាន ប្រកាស ដំឡើង ថែម ទៀត នៅ ឆ្នាំ ២០២៤ ដែល មាន ចំនួន ទាប បំផុត ២០៤ ដុល្លារ ក្នុង ១ខែ ពោលគឺ កើនឡើង ៤ដុល្លារ បើ ធៀប នឹង ឆ្នាំ ២០២៣ ទោះបីជា ពិភពលោក ប្រឈម នឹង វិបត្តិ សេដ្ឋកិច្ច យ៉ាងណា ក៏ដោយ ៕
កម្មករ ជាង ៣០ នាក់ ជួប គ្រោះថ្នាក់ ចរាចរណ៍ . នៅ ថ្ងៃ នេះ អភិបាល ខេត្ត កំពង់ស្ពឺ ចុះ សួរសុខទុក្ខ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត
លោក វ៉ី សំណាង បាន លើកឡើង ថា គ្រោះថ្នាក់ ពិតជា មើល មិន ឃើញ នោះ ទេ ការធ្វេសប្រហែស តែ មួយ វិនា ទេ គឺ បណ្តាលឱ្យ យើង ជួប នូវ គ្រោះថ្នាក់ ភ្លាម ដូច្នេះហើយ ទើប ទាមទារ ឱ្យ យើង គ្រប់ គ្នា តោង ឱ្យ មាន ការប្រុងប្រយត្ន័ ខ្ពស់ ពិសេស គឺ អ្នកបើកបរ និង អ្នកបញ្ជា យានយន្ត គ្រប់ រូបភាព ការធ្វេសប្រហែស មួយ ពេល គឺ ធ្វើឱ្យ យើង ត្រូវបាត់បង់ គ្រប់ យ៉ាង ត្រូវ រង ពិការភាព និង ខ្លះ ត្រូវបាត់បង់ ទាំង អាយុជីវិត ទៀតផង ។
អភិបាល ខេត្ត សង្កត់ធ្ងន់ ថា « នេះ ពិតជា សំណាង ដែល មិន មាន បងប្អូន ណា ម្នាក់ ត្រូវបាត់បង់ អាយុជីវិត តែ មាន បងប្អូន ខ្លះ ត្រូវ ប្រើ រយៈពេល យូរ ដើម្បី សម្រាក ព្យាបាល ឱ្យ បាន ជាសះស្បើយ ទាំងនេះ ធ្វើឱ្យ បងប្អូន មិន បាន ទៅ បម្រើ ការងារ ដែល ធ្វើឱ្យ បាត់បង់ ប្រាក់ ចំណូល ប្រចាំ ថ្ងៃ តែ យ៉ាងណា សូម បងប្អូន កុំ ទាន់ គិត លើ កត្តា នេះ អី គឺ ត្រូវ គិត ពី សុខភាព សំខាន់ និង ខិតខំ អនុវត្ត តាម ការណែនាំ របស់ ក្រុម គ្រូពេទ្យ ដើម្បី ឆាប់ បាន ជាសះស្បើយ » ។
លោក វេជ្ជបណ្ឌិត ឃីម វិដាសែត ជំនាញ ផ្នែក វះកាត់ នៃ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ស្ពឺ បាន ឱ្យដឹង ថា បច្ចុប្បន្ន កម្មករ កម្ម ការិនី ដែល បាន ជួប ឧបទ្ទវហេតុ មាន ៥នាក់ រងរបួស ធ្ងន់ ដោយ ២នាក់ បាក់ ដង កាំបិត និង ៣នាក់ ប៉ះពាល់ ក្បាល ធ្ងន់ធ្ងរ ។
បច្ចុប្បន្ន ពួកគាត់ កំពុង ស្ថិត ក្រោម ការព្យាបាល យ៉ាង យកចិត្តទុកដាក់ ពី ក្រុម គ្រូពេទ្យ ដែល ការព្យាបាល នេះ និង ប្រើ រយៈពេល យូរ ចំណែក អ្នករបួស ស្រាល ផ្សេង ទៀត អាច ប្រើ រយៈពេល ព្យាបាល ត្រឹមតែ មួយ សប្តាហ៍ ទៅ១០ ថ្ងៃ ប៉ុណ្ណោះ អាច វិល ទៅ ធ្វើការ ជាធម្មតា វិញ ហើយ ៕
អភិបាល ខេត្ត ព្រៃវែង ផ្ដាំផ្ញើ បេក្ខជន បេក្ខ នារី ប្រឡង បាក់ឌុប ទាំងអស់ ត្រូវ ថែទាំ សុខភាព ឱ្យ បាន ល្អ
( ព្រៃវែង ) ៖ លោក សួន សុម៉ាលីន អភិបាល ខេត្ត ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ៧ ខែវិច្ចិកា ឆ្នាំ ២០២៣ បាន ផ្ដាំផ្ញើ ដល់ ប្អូន ៗ ជា បេក្ខជន បេក្ខ នារី ដែល មកពី បណ្ដាល ស្រុក នានា នៅ ខេត្ត ព្រៃវែង មក ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ ២០២៣ ត្រូវ យកចិត្តទុកដាក់ ថែទាំ សុខភាព ឱ្យ បាន ល្អ ដើម្បី ដំណើរការដល់ ការប្រឡង របស់ ប្អូន ៗ ទទួលបាន ជោគជ័យ ។
ការលើក ថ្លែង ឡើង បែប នេះ របស់ អភិបាល ខេត្ត ព្រៃវែង បាន ធ្វើឡើង នៅក្នុង ឱកាស លោក បាន ដឹកនាំ ក្រុមការងារ អាជ្ញាធរ ពាក់ព័ន្ធ មន្ទីរ អង្គភាព អញ្ជើញ ពិនិត្យ និង កាត់ វិញ្ញាសារ ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ ២០២៣ ថ្ងៃទី២ នៅ មណ្ឌល ប្រឡង សាលា បឋមសិក្សា សម្ដេច តេជោ ហ៊ុន សែន ព្រៃវែង ក្រុង ។
ក្នុង ឱកាស នោះ ក៏ មាន ការចូលរួម លោកស្រី ទន់ សាអ៊ឹម អនុ រដ្ឋលេខាធិការ ក្រសួង អប រំ យុវជន និង កីឡា និង ជា ប្រធាន គណៈ មេ ប្រយោគ ទូទាំង ប្រទេស ប្រចាំ ខេត្ត ព្រៃវែង ក្រុមការងារ ACU ផងដែរ ។
លោក សួន សុម៉ាលីន បាន ថ្លែង ណែនាំ ទៅ ដល់ បេក្ខជន បេក្ខ នារី សូម យកចិត្តទុកដាក់ ប្រឹងប្រែង បញ្ជេញ សមត្ថភាព ចំណេះដឹង ដែល ខ្លួន មាន មិន ត្រូវ បង្ក ការរំខាន នៅក្នុង បន្ទប់ ឬ ក៏ លួច មាន ប្រយ៉ុង ពិសេស មិន ត្រូវ ចម្លង គ្នា នោះ ឡើយ ហើយ ក្រោយពេល ទទួល លទ្ធផល ប្រឡង ជាប់ ត្រូវ បន្ត ការសិក្សា នៅ សកលវិទ្យាល័យ បន្ត ទៀត ដើម្បី ទទូល បាន ជំនាញ ដែល ខ្លួន ស្រឡាញ់ ។
លោក សួន សុម៉ាលីន បាន ផ្តាំផ្ញើ ដល់ បេក្ខជន បេក្ខ នារី លោកគ្រូ អនុ រក្ស ទាំងអស់ ត្រូវ អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នៅ បទបញ្ញាត្តិ ផ្ទៃក្នុង នៃ ការប្រឡង នេះ ធ្វើ យ៉ាងណា ដើម្បី ទទួលបាន នូវ ចំណេះដឹង ពិតប្រាកដ មាន សមត្ថភាព ក្នុង ការ បម្រើ ការងារ និង ជួយ អភិវឌ្ឍ ប្រទេសជាតិ យើង ។
លោក អភិបាល ខេត្ត ក៏ សូម ជូនពរ ដល់ បេក្ខជន បេក្ខ នារី ដែល បាន មក ប្រឡង ទាំងអស់ សូមឲ្យបាន ជាប់ គ្រប់ ៗ គ្នា ។
សូម បញ្ជាក់ ថា ចំពោះ ការរៀបចំ ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ក្នុង ខេត្ត ព្រៃវែង មាន បេក្ខជន បាន ដាក់ពាក្យ ប្រឡង ចំនួន ៨.១៣៥ នាក់ ស្រី ចំនួន ៤.៣៥៤ នា ក មាន ចំនួន ១៥ មណ្ឌល មាន ចំនួន ៣២៧ បន្ទប់ ។ ដោយ ក្នុង នោះ បែងចែក ជា ពីរ ផ្នែក មាន ផ្នែក វិទ្យាសាស្ត្រ និង ផ្នែក វិទ្យាសាស្រ្ត សង្គម ។
ពលរដ្ឋ ១០៨ គ្រួសារ នៅ ខណ្ឌ កំបូល រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ស្ទឹង ព្រែក ត្នោត . ថ្ងៃ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ នាយក ស្រូវ ពូជ ជិត ៧តោន របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ផ្តល់ ពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក កើត ឆែ អភិបាល ស្តីទី រាជធានី ភ្នំពេញ បាន ណែនាំឲ្យ មន្ទីរ កសិកម្ម មន្ទីរ ធនធាន ទឹក រាជធានី ភ្នំពេញ ព្រមទាំង អាជ្ញាធរ ខណ្ឌ កំបូល យកចិត្តទុកដាក់ ទាំង បណ្ដុះបណ្ដាល បច្ចេកទេស ទាំង ការផ្ដល់ ទឹក ជូន ប្រជាពលរដ្ឋ នៅពេល រាជ រដ្ឋាភិបាល បាន ផ្ដល់ គ្រាប់ ពូជ ស្រូវ ជូន ពួកគាត់ សំដៅ ធ្វើ យ៉ាងណា ឲ្យ ពួកគាត់ អាច បង្កបង្កើន ផល រហូត ទទួលបាន ទិន្នផល ខ្ពស់ ។
ការណែនាំ បែប នេះ របស់ លោក កើត ឆែ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្នុង ពិធី ចែក ស្រូវ ពូជ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ស្ទឹង ព្រែក ត្នោត ចំនួន ១០៨ គ្រួសារ នៅ វត្ត ទ្រនំ ជ្រឹង ភូមិ ខ្ចៅ សង្កាត់ បឹង ធំ ខណ្ឌ កំបូល ។
លោក កើត ឆែ បាន លើកឡើង ថា សម្រាប់ មន្ទីរ កសិកម្ម រាជធានី ភ្នំពេញ ត្រូវ បញ្ជូន មន្ត្រី របស់ ខ្លួន ផ្ដល់ បច្ចេកទេស ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ រីឯ មន្ទីរ ធនធាន ទឹក ក៏ ត្រូវ នៅ គិតគូរ ជាមួយ ប្រជាពលរដ្ឋ ផងដែរ ពោលគឺ នៅ ពេល ដែល ពួកគាត់ មិន មាន ទឹក ធ្វើ ស្រែ ដើម្បី បង្កបង្កើត ផល មន្ទីរ ត្រូវតែ ផ្ដល់ ទឹក ជូន ។
ដោយឡែក សម្រាប់ អាជ្ញាធរ មូលដ្ឋាន ពិសេស អាជ្ញាធរ ខណ្ឌ កំបូល វិញ ក៏ ត្រូវតែ នៅ ផ្ទាល់ ជាមួយ ប្រជាពលរដ្ឋ ផងដែរ ខណៈ ដែល បងប្អូន ប្រជាពលរដ្ឋ មាន ការខ្វះខាត អ្វី មួយ អាជ្ញាធរ ត្រូវ ជួយ ពួកគាត់ ភ្លាម សំដៅ ធ្វើ យ៉ាងណា ក្រោយពី ទទួលបាន ស្រូវ ពូជ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នេះ ហើយ ពួកគាត់ អាច យក ទៅ បង្កបង្កើន ផល ទទួលបាន ទិន្នផល ខ្ពស់ ។
លោក កើត ឆែ បាន បន្ថែម ទៀត ថា « កម្ពុជា មាន សន្តិភាព ពេញលេញ ។ ក្រោម ម្លប់ សន្តិភាព នេះ យើង អាច ធ្វើ អ្វី បាន គ្រប់ យ៉ាង ទាំង ការរកស៊ី ជួញដូរ និង ការបង្កបង្កើត ផល ជាដើម ។ ដូច្នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ រួមគ្នា ថែរក្សា សន្តិភាព នេះ ឲ្យបាន គង់វង្ស » ។
លោក ឃឹម ស៊ុន សូដា អភិបាល ខណ្ឌ កំបូល បាន ឲ្យដឹង ថា គ្រាប់ ពូជ ស្រូវ ដែល បាន ផ្តល់ ជូន បងប្អូន ប្រជាកសិករ ដែល ទទួលរង ការខូចខាត ដំណាំ ស្រូវ វស្សា ដោយ គ្រោះ ទឹក ជំនន់ ស្ទឹង ព្រែក ត្នោត ចំនួន ១០៨ គ្រួសារ ស្ថិត ក្នុង សង្កាត់ បឹង ធំ ខណ្ឌ កំបូល នេះ មាន ចំនួន ៦.៦៥០ គីឡូក្រាម ជា អំណោយ ដ៏ ថ្លៃថ្លា បំផុត របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី ។
ស្រប ជាមួយ ការ នឹង ពន្យា ពេល ឡើង ថ្លៃ សម្រាប់ ការធ្វើដំណើរ លើ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ក្រុង ព្រះសីហនុ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន អំពាវនាវ ដល់ ពលរដ្ឋ ដូចនេះ ថា « សុំ បងប្អូន ទៅ ដាក់ពាក្យ សុំ បំពាក់ ឧបករណ៍ ETC តាម ប្រព័ន្ធ អេឡិចត្រូនិច នេះ ស្រួល ផង វា មិន ចាំបាច់ រង់ចាំ ខ្ញុំ ពេល ខ្លះ ជិះ ក្បូន មក មក ក្បូន នឹង ពេល ឡាន មកដល់ ទ្វា វា បើក ស្រាប់ ព្រោះ យើង បញ្ជូល កាត ក្នុង នឹង ងាយស្រួល អត់ ចាំបាច់ ចាំ ហើយ បើ អ្នកបង់ សាច់ប្រាក់ ត្រូវ តកន្ទុយ គ្នា ខាត ពេល » ។
ជាមួយគ្នា នោះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ថ្លែង អរគុណ ដល់ លោក ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល និង លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រួមទាំង ក្រុមការងារ ដែល បាន ចរចារ សម្រាប់ ការវិនិយោគ លើ ផ្លូវ ល្បឿន លឿន មួយ នេះ ដែល ផ្លូវ មួយ នេះ គឺ បាន ចំណាយ ថវិកា សាងសង់ ជាង ២ពាន់ លាន ដុល្លារ ក្រោម ទម្រង់ វិនិយោគ សាងសង់ - ប្រតិបត្តិការ - ផ្ទេរ (BOT) ដែល មាន រយៈពេល ប្រតិបត្តិការ ចំនួន ៥០ ឆ្នាំ ។
សម្តេច ធិបតី ក៏ បាន បញ្ជាក់ ដែរ ថា ការធ្វើ ដូចនេះ គឺ មាន នៅ គ្រប់ ប្រទេស ទាំងអស់ ជាក់ស្តែង នៅ ពេល ដែល សម្តេច ធ្វើដំណើរ ទៅ សហរដ្ឋ អាមេរិក រាល់ ពេល ដែល ធ្វើដំណើរ ពី រដ្ឋ មួយ ទៅកាន់ រដ្ឋ មួយ ទៀត គ្រាន់តែ ត្រូវ បង់ ថ្លៃ ផ្លូវ នេះ មាន ច្រើន កន្លែង ព្រោះ ពីរដ្ឋ មួយ ទៅកាន់ រដ្ឋ មួយ ទៀត មាន ក្រុមហ៊ុន សាងសង់ ផ្លូវ ល្បឿន លឿន នេះ ៣ ទៅ ៤ក្រុមហ៊ុន សម្រាប់ សាងសង់ ដែល នេះ គឺជា ការចូលរួម របស់ វិស័យ ឯកជន ។
( កំពង់ចាម ) ៖ នៅ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បានា នាំ ប្រតិភូ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចុះ ពិនិត្យ វឌ្ឍនភាព សំណង់ អគារ ថ្មី របស់ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅក្នុង បរិវេណ សាលា ខេត្ត កំពង់ចាម ។
មន្រ្តី បាន ឱ្យដឹង ថា ការជួប ពិភាក្សា រវាង លោក អភិបាល ខេត្ត និង ប្រតិភូ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ គឺ ពិភាក្សា លម្អិត ទៅ លើ ការរៀបចំ រចនាបទ និង សោភ័ណភាព នៅ ខាងក្នុង នៃ អាគារ រដ្ឋបាល ខេត្ត ដែល កំពុង សាងសង់ ។
មន្ត្រី ដដែល បាន បញ្ជាក់ ថា សំណង់ ថ្មី របស់ រដ្ឋបាល ខេត្ត កំពង់ចាម គឺ មាន ទំហំ ៣.៥០០ ម៉ែត្រ ការ៉េ កម្ពស់ ៣ជាន់ ។ បច្ចុប្បន្ន សំណង់ នេះ សាងសង់ សម្រេច លទ្ធផល បាន ៦០% ។ ហើយ សំណង់ នេះ ដែរ គ្រោង សាងសង់ បញ្ចប់ ជាស្ថាពរ នៅ ខែមេសា ឆ្នាំ ២០២៤ ៕ ឧប នាយក រដ្ឋមន្ត្រី ទៀ សីហា៖ ការងារ ចង សម្ព័ន្ធ មេត្រីភាព រវាង កងទ័ព និង អង្គភាព ស៊ីវិល មាន សារៈសំខាន់ ឆ្លើយតប ទៅនឹង យុទ្ធសាស្រ្ត នានា របស់ រដ្ឋាភិបាល នីតិកាល ទី៧
( ព្រះសីហនុ) ៖ នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន លើកឡើង ថា ការងារ ចង សម្ព័ន្ធ មេត្រីភាព រវាង អង្គភាព នៃ កងយោធពល ខេមរភូមិន្ទ ជាមួយ ស្ថាប័ន អង្គភាព ស៊ីវិល ពិតជា មាន សារៈសំខាន់ ឆ្លើយតប ទៅនឹង វិធានការ យុទ្ធសាស្រ្ត នានា របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភាព ដែល បាន ដាក់ចេញ ក្នុង ស្ថានភាព នៃ តម្រូវការ ជាក់ស្តែង របស់ ប្រទេសជាតិ ដោយ ឈរ លើ ស្មារតី ទទួលខុសត្រូវ ចំពោះ ឧត្តម ប្រយោជន៍ និង សាមគ្គី ជាតិ ខ្ពស់ ។
ការលើកឡើង បែប នេះ របស់ ឧប នាយក រដ្ឋមន្ត្រី ទៀ សីហា បាន ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្នុង ឱកាស លោក បាន អញ្ជើញ ជា អធិបតី បិទ សិក្ខាសាលា ដក ពិសោធន៍ លើ ការងារ សម្ព័ន្ធ មេត្រីភាព រវាង អង្គភាព នៃ កងយោធពល ខេមរភូមិន្ទ ជាមួយ ស្ថាប័ន អង្គភាព ស៊ីវិល ទិស យោធ ភូមិភាគ ទី៣ ក្រោម ប្រធានបទ « សម្ព័ន្ធ មេត្រីភាព រួមចំណែក ការពារ ជាតិ ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ » ។
នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ តំណាង ស្ថាប័ន អង្គភាព របស់ រដ្ឋ និង វិស័យ ឯកជន សប្បុរសជន នានា ដែល បាន អញ្ជើញ មក ចូលរួម ក្នុង កម្មវិធី សិក្ខាសាលា ដ៏ មាន សារសំខាន់ នេះ ជាពិសេស ចំពោះ ដៃគូ សម្ព័ន្ធ មេត្រីភាព របស់ យើង ដែល ជានិច្ចកាល នៅតែ បន្ត យកចិត្តទុកដាក់ ចូលរួម សហការ ជួយ ឧបត្ថម្ភ ដល់ កងយោធពល ខេមរភូមិន្ទ បង្ហាញ ឱ្យ ឃើញ ពី ស្មារតី សាមគ្គី ជាតិ រឹងមាំ ស្រប តាម ពាក្យស្លោក « ស្រឡាញ់ គ្នា ក្នុង គ្រា ក្រ ស្គាល់ មិត្ត ល្អ ក្នុង គ្រា លំបាក » ។
សរុប ព្រឹក ថ្ងៃទី ២ នៃ ដំណើរការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូម សម័យ ប្រឡង ៖ ០៦ វិច្ឆិកា ២០២៣ មាន បេក្ខជន អវត្តមាន ចំនួន ២ ២៧៥ នាក់ ស្រី ៩២៤ នាក់ ( ក្នុង នោះ បេក្ខជន ស្វៃរិន ១ ៨០៤ នាក់ ស្រី ៧៤៩ នាក់ ) ស្មើនឹង ១.៦៦ ភាគរយ មាន បញ្ហា សុខភាព ៨១ ករណី ដែល ក្នុង នោះ បេក្ខជន មាន បញ្ហា សុខភាព មិន អាច បន្ត ការប្រឡង បាន មាន ចំនួន ០៤ ករណី ក្រៅ ពី នេះ បេក្ខជន ដែល មាន បញ្ហា សុខភាព ទាំងអស់ បាន បន្ត ការប្រឡង ជាធម្មតា ក្រោម ការយកចិត្តទុកដាក់ មើល ថែ ពី ក្រុម គ្រូពេទ្យ បន្ទាប់ពី អាការ បាន ធូរស្រាល ។
ក្រសួង អប់រំ យុវជន និង កីឡា ជំរុញ លើកទឹកចិត្ត ឱ្យ បេក្ខជន ប្រឡង ទាំងអស់ ត្រូវ ថែរក្សា សុខភាព ឱ្យ បាន ល្អ សម្រាក និង បរិភោគ អាហារ ឱ្យ បាន គ្រប់គ្រាន់ ប្រកបដោយ អនាម័យ ដើម្បី ទទួលបាន លទ្ធផល ល្អ ក្នុង ការប្រឡង ។
នៅ តាម មណ្ឌល ប្រឡង នីមួយ ៗ មាន ដំណើរការ ល្អ មាន សភាព ស្ងប់ស្ងាត់ និង របៀបរៀបរយ ល្អ អនុវត្ត តាម សេចក្ដីណែនាំ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា ដោយ មាន ការចិត្ត យក ទុកដាក់ និង ទំនួល ខុសត្រូវ ខ្ពស់ ពី គណៈ មេ ប្រយោគ ទូទាំង ប្រទេស គណៈ អប្បមាទ ទូទាំង ប្រទេស ជំនួយការអប្បមាទ ប្រធាន អនុប្រធាន មណ្ឌល គណៈកម្មការ កណ្ដាល គណៈកម្មការត្រួតពិនិត្យ អគារ គណៈកម្មការ អនុរក្ស ដោយ មាន ការចូលរួម សហការ ដោយ សហភាព សហព័ន្ធ យុវជន កម្ពុជា អង្គភាព ប្រឆាំង អំពើពុករលួយ និង អាជ្ញាធរ មាន សមត្ថកិច្ច ពាក់ព័ន្ធ ។
ការណែនាំ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ - និយោជិត ប្រមាណ ១៥. ១៩៤ នាក់ ។ កិច្ច សំណេះសំណាល នេះ ធ្វើឡើង នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ខេមបូឌា ចេជាង ហ្គ័រ ជី អេស អ៉ីហ្សេត ស្ថិត ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « រឿង ផ្លូវ ដែក ដឹក ទំនិញ ឥលូវ ផ្លូវ ដែក របស់ យើង នា ពេល បច្ចុប្បន្ន បើក បាន ត្រឹម ៥០ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង ឥលូវ យើង ធ្វើ យ៉ាង ម្ដេច ឲ្យ អាច រត់ បាន ល្បឿន ៨០ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង ដឹក ទំនិញ បាន មួយចំនួន » ។
បន្ថែម ពី នោះ ទៀត សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា សម្ដេច នឹង ឲ្យ សិក្សា អំពី ការកាត់បន្ថយ តម្លៃ ដឹកជញ្ជូន តាម ផ្លូវ ហើយ បើសិនជា ផ្លូវ ដែក នេះ ធ្វើ រួចរាល់ យើង នឹង ដឹក ទំនិញ បាន ច្រើន ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឲ្យដឹង ថា ឡាន មួយ ដឹក បាន តែ មួយ ទូ ប៉ុន្ដែ មួយ រទះ ភ្លើង ដឹក បាន ទូច្រើន ដែល មាន ប្រវែង ពី១ គីឡូ ទៅ ២គីឡូ ដី ដែល នេះ ជា យុទ្ធសាស្ដ្រ ក្នុង ការបង្កើន ការ ដឹក ទំនិញ ដើម្បី ជំរុញ កំណើន សេដ្ឋកិច្ច ។
លើស ពី នោះ ទៀត សម្ដេច ធិបតី ហ៊ុន ម៉ាណែន បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល នឹង បន្ដ ធ្វើ ហេដ្ឋារចនាសម្ព័ន្ធ ព្រោះថា ហេដ្ឋារចនាសម្ព័ន្ធ វា ជួយ នៅក្នុង ការកាត់បន្ថយ តម្លៃ ដឹកជញ្ជូន និង ជួយ ឲ្យ សេដ្ឋកិច្ច មាន ការកើនឡើង ផងដែរ ៕
នៅតែ ៣ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ! ក្រសួង ការងារ នឹង រៀបចំ ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ ដោយ ផ្តល់ ឱកាស ការងារ ជាង ២ម៉ឺន កន្លែង ដល់ យុវជន
ការថ្លែង បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ប្រមាណ ១៥. ១៩៤ នាក់ នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ខេមបូឌា ចេជាង ហ្គ័រ ជី អេស អ៉ីហ្សេត ស្ថិត ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា ខេត្ត ព្រះសីហនុ ជាមួយ ខេត្ត ជាប់ មាត់ សមុទ្រ មាន សក្តានុពល ក្នុង ការអភិវឌ្ឍ កំពង់ផែ ទឹក ជ្រៅ ហើយក៏ ជា ផែ មួយ ដ៏ សំខាន់ របស់ កម្ពុជា តាម ពីមុន សម័យ សង្គ្រាម ដូច្នេះហើយ រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ខិតខំ អភិវឌ្ឍ កំពង់ផែ ខេត្ត ព្រះសីហនុ នេះ ឱ្យ កាន់តែ មាន ភារី ចម្រើន បន្ថែម ទៀត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ត ថា កំពង់ផែ ព្រះសីហនុ មាន ការចរាចរណ៍ កុងតឺន័រ ខណៈ ដែល ការគ្រោងទុក នឹង មាន កុងតឺន័រ តែ ៥៥ម៉ឺន នោះ ទេ ក្នុង មួយ ឆ្នាំ ប៉ុន្តែ ប៉ុន្មាន ឆ្នាំ នេះ មាន កុងតឺន័រ ចល័ត ជាង ៧៥ ម៉ឺន កុងតឺន័រ ។ ដូច្នេះ ដើម្បី បំពេញ សេចក្តីត្រូវការ រាជ រដ្ឋាភិបាល ពង្រីក កំពង់ផែ នេះ ឱ្យ មាន ទំហំ ធំ និង ជ្រៅ ជាង មុន ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « កន្លងទៅ យើង បាន ធ្វើ ច្រើន អី ឡូវ យើង កំពុងតែ កែប្រែ កន្លែង កុងតឺន័រ ដើម្បី ចូល កប៉ាល់ បប៉ុន្តែ អ្វី ដែល សំខាន់ យើង បាន ធ្វើការ ជាមួយ ជប៉ុន ដើម្បី យកមកវិនិយោគ ពង្រីក ផែ ទឹក ជ្រៅ របស់ យើង ដំណាក់កាល ទី១ ខ្ញុំ សង្ឃឹម ថា នឹង បាន បុក គ្រឹះ មុន ដាច់ ឆ្នាំ ២០០២៣ » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ជួប ពិភាក្សា ជាមួយ ប្រធាន JICA ដើម្បី ជំរុញ ការចរចា បញ្ចប់ ការទម្លាក់ ថវិកា សម្រាប់ បុក គ្រឹះ ជំហាន ទី១ ក្នុង ការពង្រីក ផែ ទឹក ជ្រៅ ខេត្ត ព្រះសីហនុ ឱ្យ បាន មុន ដំណាច់ ឆ្នាំ ២០២៣ ដែល ជា ឆ្នាំ ដ៏ សំខាន់ សម្រាប់ កម្ពុជា និង ជប៉ុន គឺ ខួប អនុស្សាវរីយ ៧០ ឆ្នាំ នៃ ការបង្កើត ចំណង ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ត ថា កម្ពុជា និង ជប៉ុន នឹង រួមគ្នា ធ្វើ ដើម្បី ពង្រីក កំពង់ផែ ទឹក ជ្រៅ នៅ ខេត្ត ព្រះសីហនុ នេះ ឱ្យ មាន លេចចេញ ជា រូបរាង ឡើង ។ ខណៈ កំពង់ផែ ខេត្ត ព្រះសីហនុ បច្ចុប្បន្ន នេះ អាច ឱ្យ កុងតឺន័រ ដឹក ទំនិញ ចូល ចត បាន តែ ៩.៥០ ម៉ែត្រ ដូច្នេះ កំពង់ផែ ខេត្ត ព្រះសីហនុ ទទួល ទំនិញ បាន តែ ជាង ១៨ ភាគរយ នៃ ទំនិញ ប៉ុណ្ណោះ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ប្រកាស ដាក់ ចេញ មហិច្ឆតា ប្រែក្លាយ កំពង់ផែ ព្រះសីហនុ ជា កន្លែង ផ្ទេរ ទំនិញ ។ ប្រសិនបើ ការពង្រីក កំពង់ផែ ទឹក ជ្រៅ ដំណាក់កាល ទី១ នេះ ទទួលបាន ជោគជ័យ នោះ កំពង់ផែ ទឹក ជ្រៅ នេះ អាច មាន លទ្ធភាព ទទួល កុងតឺន័រ ដឹក ទំនិញ ប្រមាណ ៩៣ ភាគរយ វា នឹង កាត់បបន្ថយ តម្លៃ ការការដឹកជញ្ជូន តាម ផ្លូវ ទឹក ដែល ពី មាន តម្លៃ ចន្លោះ ៤០០ ឬ ៥០០ ដុល្លារ មក ត្រឹម ២០០ ដុល្លារ ក្នុង មួយ កុងតឺន័រ ។
បន្ថែម ពី នេះ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន គូសបញ្ជាក់ ថា ប្រសិនបើ ថ្ងៃ អនាគត កម្ពុជា អាច ពង្រីក កំពង់ទឹក ជ្រៅ ជំហាន ទី២ ឬ ជំហាន ទី៣ នោះ នៅ ថ្ងៃ អនាគត កំពង់ផែ នឹង អាច ទទួលបាន កុងតឺន័រ កាន់តែ ច្រើន ដែល ដឹក ទំនិញ ឆ្លងកាត់ ដែល វា នឹង ផ្តល់ ឱកាស ការងារ កាន់តែ ច្រើន ឡើង ដល់ ប្រជាពលរដ្ឋ ជាពិសេស ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា ការពង្រីក កំពង់ផែ ទឹក ជ្រៅ នៅ ខេត្ត ព្រះសីហនុ គឺ ត្រូវតែ បន្ត ទៅ មុន ជានិច្ច ព្រោះ វា ជា គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
នៅ ពេល ដែល កំពង់ផែ ទឹក ជ្រៅ នេះ សាងសង់ រួចរាល់ នៅ ឆ្នាំ ២០២៥ នឹង អាច អនុញ្ញាតឲ្យ កប៉ាល់ ដែល សមត្ថភាព ផ្ទុក កុងតឺន័រ រហូតដល់ ជាង ៤ ពាន់ កុងតឺន័រ អាច ចូល ចត ដែល ពេល នោះ កប៉ាល់ ប្រមាណ ៩៣ % នៃ កប៉ាល់ ក្នុង តំបន់ អាស៉ី ចូល ចត នៅ កម្ពុជា បាន ដែល នឹង ធ្វើឱ្យ តម្លៃ ដឹកជញ្ជូន ទាប ជាង មុន ដែល តាម ការប៉ាន់ស្មាន តម្លៃ ដឹកជញ្ជូន អាច ចុះ ជាង ២០០ ដុល្លារ ក្នុង មួយ កុងតឺន័រ ។
បច្ចុប្បន្ន នេះ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ អាច អនុញ្ញាតឱ្យ នាវា ក្នុង តំបន់ អាស៊ី ប៉ាស៉ី ហ្វិច ចូល បាន តែ ប្រមាណ តែ ១៨% ប៉ុណ្ណោះ មាន ន័យ ថា ក្នុង ចំណោម ១០០កប៉ាល់ អាច ចូល ចត បាន តែ ១៨ ឬ ១៩កប៉ាល់ និង អនុញ្ញាតឱ្យ នាវា ដែល ផ្តុក កុងតឺន័រ បាន តែ ១៥០០ ប៉ុណ្ណោះ ៕
ត្រង់ ចំណុច នេះ សម្តេច នាយក រដ្ឋមន្ត្រី បាន ណែនាំ ឱ្យ អាជ្ញាធរ កម្លាំងប្រដាប់អាវុធ គ្រប់ លំដាប់ថ្នាក់ បង្កើត ការពង្រឹង កិច្ចការ សន្តិសុខ ឱ្យ បាន ល្អ ។
ការលើកឡើង របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ ជាង ១ម៉ឺន ៥ពាន់ នាក់ នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ នា ព្រឹក ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
សម្តេច បន្ថែម ថា « ការបង្កើត ការហោះហើរ ត្រង់ មកកាន់ ខេត្ត ព្រះសីហនុ ក៏ សំខាន់ ដែរ ធ្វើ យ៉ាងម៉េច បើក មុខ ព្រួញ ហោះហើរ ឱ្យ បាន ច្រើន យើង ភ្ជាន់ ខេត្ត ព្រះសីហនុ ជាមួយ ទិសដៅ ទេសចរណ៍ ឱ្យ បាន ច្រើន ដើម្បី ទាញ ទេសចរណ៍ មកកាន់ ទីនេះ » ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ទៀត ថា ភូមិសាស្ត្រ ក្នុង ខេត្ត ព្រះសីហនុ ពិតជា មាន សក្តានុពល ខ្លាំង ណាស់ សម្រាប់ ជំរុញ កំណើន សេដ្ឋកិច្ច ប្រៀប ដូចជា គ្រាប់ ពេជ្រ តែ ត្រូវ មាន ការកែច្នៃ ដើម្បី ទទួលបាន ជាប្រយោជន៍ ហើយ ដើម្បី មាន ឱកាស កែច្នៃ គ្រាប់ ពេជ្រ ឱ្យ បានជា ប្រយោជន៍ ត្រូវ ទាមទារ ចាំបាច់ នូវ សុខ សន្តិភាព ។
ជាក់ស្តែង ភូមិសាស្ត្រ កំពង់ផែ ព្រះសីហនុ ដែល ត្រូវបាន អភិវឌ្ឍន៍ ជា បន្តបន្ទាប់ និង ឈានដល់ ការចាប់ផ្តើម បើក ការដ្ឋាន សាងសង់ កំពង់ផែ ទឹក ជ្រៅ ដំណាក់កាល ទី១ មុន ដាច់ ឆ្នាំ ២០២៣ ខាងមុខ នេះ គឺ ប្រៀប ដូចជា កែច្នៃ ពេជ្រ ឱ្យ មាន ប្រយោជន៍ កាន់តែ ច្រើន សម្រាប់ សេដ្ឋកិច្ច ។ កំពង់ផែន ព្រះសីហនុ នៅ ចន្លោះ កណ្តាល រវាង កំពង់ របស់ វៀតណាម និង ថៃ ដូច្នេះ ពេល អភិវឌ្ឍន៍ ផែ ទឹក ជ្រៅ នឹង ទាញ ប្រយោជន៍ ច្រើន ពី ទីតាំង ភូមិសាស្ត្រ ដ៏ អំណោយផល នេះ ។
សម្តេច នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ដូច្នេះ ថា « សក្តានុពល ភូមិសាស្ត្រ យើង មាន គ្រាន់តែ ពេជ្រ យើង មិន ទាន់ ច្នៃ គេ ប្រើ មិន ទាន់ ឃើញ តម្លៃ ឥឡូវ យើង ត្រូវ ដាក់ គោល នយោបាយ ដើម្បី ច្នៃ ចេញ ឱ្យ ច្រើន មុខ ដើម្បីឱ្យ គេ មក ប្រើប្រាស់ ទាញ ផល ឱ្យ យើង ឱ្យ កាន់តែ ច្រើន ដើម្បី ផលប្រយោជន៍ សេដ្ឋកិច្ច កម្ពុជា » ។
សម្តេច បាន ថ្លែង ទៀត ថា ការ ដែល រាជ រដ្ឋាភិបាល ខិតខំ ទាក់ទាញ វិនិយោគ ក សាង ហេដ្ឋារចនាសម្ព័ន្ធ ទាំង ការដឹកជញ្ជូន ផ្លូវ ទឹក ផ្លូវគោក ផ្លូវ អាកាស និង ពង្រឹង សន្តិសុខ នៅ ខេត្ត ព្រះសីហនុ នេះ ដើម្បី តែ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ធ្វើ យ៉ាងណា បង្កើត ការងារ ជំរុញ សកម្មភាព សេដ្ឋកិច្ច និង ជីវភាព របស់ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ធូរធាឡើង ។
សម្តេច បន្ថែម ថា នៅ ខេត្ត ព្រះសីហនុ រាជ រដ្ឋាភិបាល មិន មែន ជំរុញ ឱ្យ មាន តែ ការផលិតផលិត វាយ ភណ្ឌ កាត់ដេរ នោះ ទេ គឺ ដាក់ ទិសដៅ ជំរុញ ឧស្សាហកម្ម កម្រិត ខ្ពស់ ដូចជា ឧស្សាហកម្ម យានយន្ត និង អេឡិចត្រូនិច ផងដែរ ៕
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ដាក់ ចេញ ផែនការ មេអភិវឌ្ឍន៍ ខេត្ត ជាប់ សមុទ្រ ពិសេស ខេត្ត ព្រះសីហនុ ដែល មាន សក្ដានុពល ខ្លាំង សម្រាប់ ជាតិ (Video inside) ( ព្រះសីហនុ) ៖ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន អះអាង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច កំពុង ដាក់ ចេញ ផែនការ មេ សម្រាប់ អភិវឌ្ឍន៍ ខេត្ត ព្រះសីហនុ និង ខេត្ត ជាប់ សមុទ្រ ប៉ុន្ដែ មិន យក ខេត្ត ជាប់ សមុទ្រ ដទៃ ទៀត មក ប្រកួតប្រជែង ជាមួយ ខេត្ត ព្រះសីហនុ នោះ ឡើយ ។
ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី ប្រមាណ ១៥. ១៩៤ នាក់ នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ស្ថិត ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ នា ព្រឹក ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា ខេត្ត ព្រះសីហនុ បើ អភិវឌ្ឍន៍ បាន ត្រឹមត្រូវ នាំ សេដ្ឋកិច្ច ឲ្យ ជាតិ ច្រើន ណាស់ ពិសេស ខេត្ត ជាប់ ខេត្ត ព្រះសីហនុ តែម្ដង ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី . ខេត្ត ព្រះសីហនុ មាន សក្តានុពល ធំ ណាស់ សម្រាប់ ជាតិ កម្ពុជា ហើយ ពាក់ព័ន្ធ ផែនការអភិវឌ្ឍន៍ ដ៏ មាន សក្ដានុពល មួយ នេះ គឺ រាជ រដ្ឋាភិបាល បាន ប្រគល់ ភារកិច្ច ជូន ឧប នាយក រដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល ។
សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី បាន ណែនាំឲ្យ រៀបចំ និង ពិនិត្យ គិតគូរ អំពី កំពង់ សមុទ្រ ដែល កំពុង មាន ចំនួន ៤ ក្នុង នោះ ខេត្ត ព្រះសីហនុ មួយ . ខេត្ត កំពត ពីរ និង ខេត្ត កោះកុង មួយ ដោយ ត្រូវ ធ្វើ យ៉ាងណា ឲ្យ ប្រទាក់ ក្រឡា គ្នា តែ មិន ប្រកួតប្រជែង គ្នា នោះ ទេ ហើយ មាន គោលដៅ រួម ដូចគ្នា គឺ ប្រកួតប្រជែង ជាមួយ ប្រទេស ជិតខាង ។ ក្នុង នោះ ត្រូវ បែងចែក គ្នា ឲ្យ ច្បាស់ ថា កំពង់ផែ ណា សម្រាប់ ទេសចរណ៍ និង កំពង់ផែ ណា សម្រាប់ ទំនិញ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា ខេត្ត ជាប់ សមុទ្រ ទាំង៤ របស់ កម្ពុជា សុទ្ធតែ មាន សក្ដានុពល ទេសចរណ៍ ទាំងអស់ ដោយ ត្រូវ ដាក់ចេញ ទិសដៅ វិនិយោគ ឲ្យ ចំ ទិសដៅ ។ ឧទាហរណ៍៖ ខេត្ត ព្រះសីហនុ មាន តំបន់ កោះ ច្រើន ត្រូវ វិនិយោគ ទៅ លើ កោះ . ខេត្ត កំពត មាន ធនធាន ធម្មជាតិ ច្រើន ត្រូវ វិនិយោគ ឲ្យ ចំ អ្វី ដែល មាន ។
ដោយឡែក វិស័យ អចលន ទ្រព្យ ក៏ ត្រូវ ពង្រឹង ឡើងវិញ ផងដែរ ដែល កន្លងមក កម្ពុជា ហាក់ បាន ដើរ លឿន លើ វិស័យ នេះ ប៉ុន្ដែ មួយ រយៈ កាល ចុងក្រោយ នេះ ត្រូវបាន ជាប់គាំង ក្នុង នោះ ទាំង កម្ពុជា និង សកល តែម្ដង ដែល នេះ ហាក់ដូចជា វត្តន៍ រយៈពេល ១០ឆ្នាំ ត្រូវ ជួបប្រទះ នូវ ការជាប់គាំង ម្ដង ។ នេះ ជា អ្វី ដែល សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ បន្ថែម ។ ប៉ុន្ដែ ទោះជា យ៉ាងណា បញ្ហា ជាប់គាំង លើ វិស័យ អចនល ទ្រព្យ នេះ ក្រុមការងារ រាជ រដ្ឋាភិបាល កំពុង ដោះស្រាយ ជាប់ ជាប្រចាំ ពិសេស នៅ ខេត្ត ព្រះសីហនុ តែម្ដង ។
បន្ថែម ពី នេះ ការពង្រឹង លើ ការងារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ ក៏ ជា កត្តា មួយ សំខាន់ ផងដែរ នៅ ទូទាំង ប្រទេស ទាំងអស់ ពិសេស នៅ តំបន់ ទេសចរណ៍ និង ឧស្សាហ៍កម្ម ព្រោះ ទេសចរ មិន អាច ទៅ កម្សាន្ដ បាន ទេ នៅ កន្លែង គ្មាន សន្ដិសុខ ល្អ គ្មាន សណ្ដាប់ធ្នាប់ ហើយ អ្នក វិនិយោគ ក៏ ដូចគ្នា ដែរ ដូច្នេះ ការងារ ពង្រឹង សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង ស្ថេរភាព គឺជា រឿង ដែល ចាំបាច់ បំផុត ។
ជាមួយគ្នា នេះ ការភ្ជាប់ នូវ ការហោះហើរ ត្រង់ រវាង ខេត្ត ព្រះសីហនុ និង តំបន់ ទេសចរណ៍ ល្បី ៗ នៅក្នុង តំបន់ ក៏ ត្រូវ គិតគូរ ផងដែរ ដែល ម្សិលមិញ សម្ដេច បាន ណែនាំ អំពី ការងារ នេះ ក្នុង កិច្ចប្រជុំ ផ្នែក រាជ រដ្ឋាភិបាល និង ផ្នែក ឯកជន ពិភាក្សា ការងារ លើ វិស័យ ទេសចរណ៍ នៅ កម្ពុជា ។ នេះ បើ តាម ប្រសាសន៍ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។ ទាំងអស់ នេះ សំដៅ ធ្វើ យ៉ាងណា ទាក់ទាញ វិនិយោគ បង្កើត ការងារ និង បង្កើន ប្រាក់ ចំណូល ដល់ ប្រជាពលរដ្ឋ ផងដែរ ៕
ហ្វីលីពីន សង្ឃឹម ថា អាច ចុះ កិច្ចព្រមព្រៀង កងទ័ព ជាមួយ ជប៉ុន ឆាប់ ៗ
( ម៉ានីល) ៖ ហ្វីលីពីន រំពឹង ថា អាចនឹង ឈានដល់ កិច្ចព្រមព្រៀង មួយ ជាមួយ ជប៉ុន ឱ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន ដើម្បី អនុញ្ញាត ការដាក់ពង្រាយ កងទ័ព ទៅ វិញ ទៅ មក នៅលើ ទឹកដី នៃ ប្រទេស ទាំង២ ។ នេះ បើ តាម រដ្ឋមន្ត្រី ការពារ ជាតិ ហ្វីលីពីន ដកស្រង់ ចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters ។
ហ្វីលីពីន និង ជប៉ុន ដែល ជា សម្ព័ន្ធមិត្ត ជិតស្និទ្ធ របស់ សហរដ្ឋ អាមេរិក បាន ឯកភាព គ្នា លើ កិច្ចចរចា ស្ដីពី ការដាក់ពង្រាយ កងទ័ព ទៅ វិញ ទៅ មក នៅលើ ទឹកដី នៃ ប្រទេស ទាំង២ នៅ ចំពោះមុខ ការកើនឡើង ភាពតានតឹង នៅក្នុង តំបន់ ។ ប្រទេស ទាំង២ នេះ ក៏ សុទ្ធសឹងតែ ជា ភាគី ជម្លោះ ដែន ទឹក ជាមួយ ចិន ផងដែរ ។
គួរ បញ្ជាក់ ថា ក្នុង ដំណើរទស្សនកិច្ច ទៅកាន់ ហ្វីលីពីន កាលពី ចុង សប្ដាហ៍ កន្លងទៅ នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក Fumio Kishida បាន និយាយ ថា ប្រទេស របស់ លោក និង ហ្វីលីពីន រួមទាំង សហរដ្ឋ អាមេរិក កំពុង ធ្វើ កិច្ចសហប្រតិបត្តិការ លើ ការការពារ សេរីភាព ក្នុង តំបន់ សមុទ្រ ចិន ខាងត្បូង ក្នុង បរិបទ នៃ ការកើនឡើង ភាពតានតឹង ជាមួយ ចិន ៕ រូបភាព ពី Reuters ក្រសួង សេដ្ឋកិច្ច ចេញ ប្រកាស ស្តីពី នីតិវិធី បំពេញ បែបបទ គយ មុនពេល ទំនិញ មកដល់
ខាងក្រោម នេះ ជា ប្រកាស ស្តីពី នីតិវិធី បំពេញ បែបបទ គយ មុនពេល ទំនិញ មកដ ល់៖
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ ជាង ១ម៉ឺន ៥ពាន់ នាក់ នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ៩រោច ខែ អស្សុជ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត ប្រមាណ ១៥. ១៩៤ នាក់ ។ ក្នុង នោះ មាន កម្ម ការិនី មាន ផ្ទៃពោះ ចំនួន ៤៨២ នាក់ ។ កិច្ច សំណេះសំណាល ធ្វើឡើង នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ខេមបូឌា ចេជាង ហ្គ័រ ជី អេស អ៉ីហ្សេត ស្ថិត ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះ សីហនុ ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ៖
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ថ្ងៃ នេះ សម្តេច មាន ក្តី សោមនស្ស រីករាយ បាន ជួប សំណេះសំណាល ជាមួយ កម្មករ និយោជិត នៅ ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន នាំយក ការផ្តាំផ្ញើ សួរសុខទុក្ខ និង ក្តី នឹករលឹក របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ចំពោះ កម្មករ និយោជិត ទាំងអស់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា តាំងពី ក្លាយជា នាយក រដ្ឋមន្ត្រី ស្គាល់ តែ បន្ទប់ គេង ការិយាល័យ ធ្វើ ការ ឯកសារ និង ទៅ ធ្វើការ ។ ដោយឡែក កម្មវិធី ផ្សេង គេ លែង ហៅ ហើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា កម្មករ និយោជិត ប្រៀប ដូចជា ថ្ម ( ថាមពល ) សម្រាប់ សេដ្ឋកិច្ច ជាតិ ។ កម្ម ការ និយោជិត មាន សមត្ថភាព កាន់តែ ខ្លាំង នោះ កម្លាំង សេដ្ឋកិច្ច ជាតិ ក៏ កាន់តែ ខ្លាំង ផងដែរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា លទ្ធផល ឆ្នោត ជាង ៨៦ ភាគរយ ដែល គាំទ្រ បក្ស ប្រជាជន កម្ពុជា ក្នុង ខេត្ត ព្រះសីហនុ បង្ហាញ ការជឿជាក់ របស់ ប្រជាពលរដ្ឋ លើ ការដឹកនាំ របស់ ថ្នាក់ដឹកនាំ បក្ស ប្រជាជន កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ប្រាក់ ចំណូល បច្ចុប្បន្ន មិន ទាន់ គ្រប់គ្រាន់ ទេ សម្រាប់ កម្មករ និយោជិត តែ ប្រាក់ ចំណូល នេះ បើ ធៀប នឹង អតីតកាល គឺ មាន ភាពប្រសើរ ច្រើន ហើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ទសវត្សរ៍ ៨០ និង ៩០ កម្ពុជា នាំ ពី ក្រៅ គ្រប់ បែបយ៉ាង សម្រាប់ ការហូបចុក និង ប្រើប្រាស់ តែ បច្ចុប្បន្ន កម្ពុជា អាច ផលិត សម្រាប់ ហូប និង ប្រើប្រាស់ ខ្លួន ឯង ហើយ បាន លក់ ចេញ ទៅ ក្រៅ ប្រទេស ថែម ទៀត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ កំពុង ពន្លឿន ការចែក បណ្ណ កម្មសិទ្ធិ ដីធ្លី ជូន ប្រជាពលរដ្ឋ ។ បច្ចុប្បន្ន ចែក បាន ២លាន ក្បាល ដី សល់ ប្រមាណ ៥លាន ក្បាល ដី ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត រំលឹក ថា ពេល សម្តេច ចាប់ ផ្ទៃ បាន ៧ខែ ត្រូវ ជាប់ គុក ជាមួយ ម្តាយ ។ នៅពេល កើត ហើយ មាន ជំងឺ ម្តង ក្តៅ ខ្លួន ខ្លាំង រហូត ពេទ្យ ណែនាំ ឱ្យ ម្តាយ ត្រៀម ចិត្ត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ធម្មជាតិ ខេត្ត ព្រះសីហនុ ល្អ ណាស់ ប្រៀប ដូចជា គ្រាប់ ពេជ្រ តែ ត្រូវ មាន ការកែច្នៃ ដើម្បី បានជា ប្រយោជន៍ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ដើម្បី មាន ឱកាស កែច្នៃ គ្រាប់ ពេជ្រ ឱ្យ បានជា ប្រយោជន៍ ត្រូវ ទាមទារ ចាំបាច់ នូវ សុខ សន្ត្តិភាព ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា បើ មាន សង្គ្រាម គ្មាន ឱកាស កែប្រែ ធម្មជាតិ ទៅជា សក្តានុពល នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ដើម្បី ច្នៃ ពេជ្រ ឱ្យ មាន តម្លៃ ក្រៅតែ ពី កត្តា សុខ សន្តិភាព ហើយ នោះ ទាមទារ ឱ្យ មាន គោល នយោបាយ ច្បាស់លាស់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត លើកទឹកចិត្ត ពលរដ្ឋ ឱ្យ ទៅ បំពាក់ ETC សម្រាប់ ធ្វើដំណើរ លើ ផ្លូវ ល្បឿន លឿន ងាយស្រួល ដែល ពេលនេះ ក្រុមហ៊ុន បន្ត ពន្យារ ពេល មិន យក ថ្លៃ សម្រាប់ ការចុះឈ្មោះ យក កាត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ឱ្យ រៀបចំ ផ្លូវ ដែក អាច ឱ្យ រត់ បាន ល្បឿន ៨០ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង សាទ រ និង រីករាយ ចំពោះ ការចាប់ផ្តើម ដំណើរការការដ្ឋាន សាងសង់ កំពង់ផែ ទឹក ជ្រៅ ខេត្ត ព្រះសីហនុ ដំណាក់កាល ទី១ មុន ដាច់ ឆ្នាំ ២០២៣ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្លែង ប្រកាស ដាក់ ចេញ មហិច្ឆតា ប្រែក្លាយ កំពង់ផែ ព្រះសីហនុ ជា កន្លែង ផ្ទេរ ទំនិញ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល កំពុង ដាក់ ចេញ ផែនការ មេ អភិវឌ្ឍន៍ ខេត្ត ព្រះសីហនុ និង ខេត្ត ជាប់ សមុទ្រ ដោយ មិន យក ខេត្ត ជាប់ សមុទ្រ ដទៃ មក ប្រកួតប្រជែង ជាមួយ ខេត្ត ព្រះសីហនុ នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ប្រកាស ប្រគល់ ភារកិច្ច ជូន ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល គិតគូរ ពី ការអភិវឌ្ឍន៍ ផែ នៅ ខេត្ត ជាប់ សមុទ្រ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សន្តិសុខ ខេត្ត ព្រះសីហនុ ត្រូវតែ ពង្រឹង ដើម្បី ទាក់ទាញ ទេសចរណ៍ និង ការវិនិយោគ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ដើម្បី ទាក់ទាញ ទេសចរណ៍ ចូល ខេត្ត ព្រះសីហនុ ត្រូវ ភ្ជាប់ ជើងហោះហើរ ជាមួយ តំបន់ ទេសចរណ៍ ល្បី ៗ ក្នុង តំបន់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ខេត្ត ព្រះសីហនុ បើ អភិវឌ្ឍន៍ បាន ត្រឹមត្រូវ នាំ សេដ្ឋកិច្ច ឱ្យ ជាតិ ច្រើន ណាស់ ជាពិសេស ខេត្ត ជាប់ ខេត្ត ព្រះសីហនុ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ខេត្ត ព្រះសីហនុ មាន សក្តានុពល ធំ ណាស់ សម្រាប់ ជាតិ កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បង្ហាញ ក្តី រំពឹង ថា ៥ ទៅ១០ ឆ្នាំ ខាងមុខ ទៀត ខេត្ត ព្រះសីហនុ ប្រែក្លាយទៅជា ខេត្ត ដែល ប្រជាពលរដ្ឋ មាន ចំណូល ខ្ពស់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ដរាបណា បក្ស ប្រជាជន កម្ពុជា នៅតែ ដឹកនាំ ប្រទេស ខេត្ត ព្រះសីហនុ នឹង ទទួលបាន ការអភិវឌ្ឍ កាន់តែ រីកចម្រើន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ថ្លែង ថា ពេល សម្តេច កំពុង បំពេញ ទស្សនកិច្ច នៅ ប្រទេស ចិន មាន មតិ មហាជន មួយចំនួន បាន សួរនាំ អំពី ភាពយន្ត ចិន មួយ ដែល និយាយ ពី ស្ថានភាព មិន ល្អ នៅ ស្រុក ខ្មែរ ជាពិសេស ខេត្ត ព្រះសីហនុ ប៉ុន្តែ ត្រូវបាន អ្នក វិនិយោគទុន របស់ ចិន ដែល កំពុង រកស៊ី នៅ កម្ពុជា បាន ថ្លែង បកស្រាយ ថា នៅ ទីនោះ ( កម្ពុជា ) មិន ដូច ក្នុង រឿង ភាពយន្ត នោះ ទេ មាន ស្ថានភាព និង សន្តិសុខ ល្អ ណាស់ ។
រដ្ឋមន្ត្រី សុខាភិបាល ជំរុញ ថ្នាក់ដឹកនាំ ទទួលបន្ទុក ពង្រឹង ការផ្តល់ សេវា នៅ តាម មន្ទីរពេទ្យ ថ្នាក់ ខេត្ត ស្រុក និង មណ្ឌល សុខភាព ត្រូវ ចុះ ពិនិត្យ ផ្ទាល់ ដើម្បី បំពេញ តម្រូវការ ជាក់ស្តែង
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ឈាង រ៉ា រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល បាន ណែនាំ ជាពិសេស ជំរុញឱ្យ ថ្នាក់ដឹកនាំ ទទួលបន្ទុក ការងារ បន្ត ពង្រឹង ការផ្តល់ សេវា នៅ តាម មន្ទីរពេទ្យ ថ្នាក់ ខេត្ត ស្រុក និង មណ្ឌល សុខភាព ចុះ ពិនិត្យ ផ្ទាល់ ជាប់ ជាប្រចាំ នៅ មូលដ្ឋាន សុខាភិបាល តាម បណ្តា ខេត្ត ដើម្បី ជួយ ពាំនាំ និង គាំទ្រ ផ្នែក បណ្តុះបណ្តាល បច្ចេកទេស និង បំពេញ តម្រូវការ តាម ស្ថានភាព ជាក់ស្តែង ។
ការថ្លែង បែប នេះ របស់ លោក រដ្ឋមន្ត្រី ក្នុង ឳកាស ដឹកនាំ កិច្ចប្រជុំ កម្រិត ថ្នាក់ដឹកនាំ ដើម្បី ពិនិត្យ វឌ្ឍនភាព ការងារ និង លើក ទិសដៅ ការងារ បន្ត លេីក ទី១ នៃ ខែវិច្ឆិកា នា ថ្ងៃទី ០៦ ខែវិចិ្ឆកា ឆ្នាំ ២០២៣ នៅ ទីស្តីការ ក្រសួង សុខាភិបាល ។
លោក រដ្ឋមន្ត្រី ក៏ បាន រំលឹក ដល់ គ្រប់ បុគ្គលិក មន្ត្រី សុខាភិបាល នៅ គ្រប់ កម្រឹត និង ទីកន្លែង កុំ ភ្លេច ថែទាំ សុខភាព ខ្លួន ឲ្យបាន ល្អ នឹង នៅ រក្សារ បាន សមត្ថភាព ជំនាញ ថែទាំ ព្យាបាល និង បន្ត បម្រើ សេវា សុខាភិបាល ជូន ប្រជាពលរដ្ឋ កាន់តែ ប្រសើរ និង ប្រកបដោយ ទំនុកចិត្ត ។
លោក រដ្ឋមន្រ្តី បាន លើក សរសើរ ផងដែរ ដល់ មន្រ្តី សុខាភិបាល នៅ តាម មូលដ្ឋាន មន្ទីរពេទ្យ បង្អែក ស្រុក ខេត្ត ជាពិសេស មណ្ឌល សុខភាព ដែល ផ្តល់ សេវា ជូន ប្រជាពលរដ្ឋ ក្នុង ឱកាស ដែល ឆ្លៀត ចុះ ពិនិត្យ នៅ មណ្ឌល សុខភាព ចុង កាល់ និង មណ្ឌល សុខភាព ដូន កែន ខេត្ត ឧត្តរមានជ័យ ដែល មាន មន្ត្រី សុខាភិបាល នៅ រង់ចាំ បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ ២៤ ម៉ោង លើ ២៤ ម៉ោង ។
ទន្ទឹម នឹង នោះ លោក សាស្ត្រាចារ្យ រដ្ឋមន្រ្តី បាន ណែនាំ បន្ថែម ថា ត្រូវ ពង្រឹង ការងារ រដ្ឋបាល ក្នុង នោះ ការពង្រឹង សេវា ច្រក ចេញ ចូល តែ មួយ គឺ ត្រូវ ពង្រឹង ឱ្យ មាន ប្រសិទ្ធភាព ត្រឹមត្រូវ និង ល្អប្រសើរ ថែម ទៀត ។
សូម ជម្រាប ថា កិច្ចប្រជុំ ខាងលើ នេះ បាន រៀបចំឡើង តាមរយៈ ប្រព័ន្ធ ហ៊ីប្រីដ៍ Hybrid និង មាន វត្តមាន ផ្ទាល់ នៅ ទីស្តីការ ក្រសួង សុខាភិបាល និង វត្តមាន តាម បណ្តា ខេត្ត ក្រុង តាមរយៈ ប្រព័ន្ធ វីដេអូ សន្និសទី ដែល មាន ការអញ្ជើញ ចូលរួម ដោយ រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ទីប្រឹក្សា អគ្គ នាយក និង អគ្គាធិការ នៃ ក្រសួង សុខាភិបាល ៕
ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ( បាក់ឌុប ) ថ្ងៃ ចុងក្រោយ ចាប់ផ្តើម ហើយ
បេក្ខជន ទាំងអស់ បាន ចូលក្នុង បន្ទប់ ប្រឡង រៀង ៗ ខ្លួន នៅ តាម មណ្ឌល ប្រឡង នៅ គ្រប់ រាជធានី ខេត្ត ដោយ មាន ការត្រួតពិនិត្យ និង ផ្ទៀងផ្ទាត់ យ៉ាង យកចិត្តទុកដាក់ ពីសំណាក់ គណៈកម្មការ អនុរក្ស និង ក្រោម ការពិនិត្យ ដោយ អង្គភាព ប្រឆាំង អំពើពុករលួយ ។
ក្រសួង អប់រំ យុវជន និង កីឡា សូម អំពាវនាវ ដល់ បេក្ខជន ទាំងអស់ ត្រូវ គោរព បទប្បញ្ញត្តិ នៃ ការប្រឡង ឱ្យ បាន ល្អ ប្រសើរ ជាពិសេស មិន ត្រូវ លាក់ ទុក ជាប់ នឹង ខ្លួន នូវ ឧបករណ៍ អេឡិចត្រូនិច គ្រប់ ប្រភេទ ចូលក្នុង មណ្ឌល ប្រឡង ឬ បន្ទប់ ប្រឡង ជាដាច់ខាត ។ ក្នុង ករណី រកឃើញ ថា បាន ប្រព្រឹត្ត សកម្មភាព ផ្ទុយ នឹង បទប្បញ្ញត្តិ និង កម្រិត វិន័យ បេក្ខជន នឹង ត្រូវបាន កំណត់ ឱ្យ ធ្លាក់ ជា ស្វ័យប្រវត្តិ ។
សូម ជម្រាប ថា សរុប ថ្ងៃទី ១ នៃ ដំណើរការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូម សម័យ ប្រឡង ៖ ០៦ វិច្ឆិកា ២០២៣ មាន បេក្ខជន អវត្តមាន ចំនួន ២ ១៣៤ នាក់ ស្រី ៨៧១ នាក់ ( ក្នុង នោះ បេក្ខជន ស្វៃរិន ១ ៧៣២ នាក់ ស្រី ៧២៤ នាក់ ) ស្មើនឹង ១.៥៥ ភាគរយ មាន បញ្ហា សុខភាព ៣៨ ករណី ដែល ក្នុង នោះ មាន ករណី បញ្ជូន ទៅ មន្ទីរពេទ្យ ចំនួន ០៤ ករណី និង មាន បេក្ខជន ចំនួន ០៣ រូប ជួប គ្រោះថ្នាក់ ចរាចរណ៍ ស្រាល ។
បេក្ខជន ដែល មាន បញ្ហា សុខភាព ទាំងអស់ បាន បន្ត ការប្រឡង ជាធម្មតា ក្រោម ការយកចិត្តទុកដាក់ មើល ថែ ពី ក្រុម គ្រូពេទ្យ បន្ទាប់ពី អាការ បាន ធូរស្រាល លើកលែង ០៣ ករណី ។
ក្រសួង អប់រំ យុវជន និង កីឡា គ្រោង នឹង ប្រកាស លទ្ធផល ប្រឡង នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ សម្រាប់ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្ដាល និង ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ សម្រាប់ ខេត្ត ផ្សេង ទៀត ព្រមទាំង មាន ផ្សាយ នៅលើ ទំព័រ ហ្វេសប៊ុក ផ្លូវការ ក្រសួង អប់រំ យុវជន និង កីឡា ៕
មិន ត្រូវ បើកបរ ល្មើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៣នាក់ និង របួស ១២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៦ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ១២នាក់ ។
