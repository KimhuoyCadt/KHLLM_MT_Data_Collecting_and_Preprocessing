អ្នកមិនដឹងថាអរូបីមាន ន័យ ដូចម្តេច?
អ្វី ដែល អ្នក កំពុង ស្វែងរក ឬ មាន អ្វី ផ្សេង ទៀត ដើម្បី ពិភាក្សា ។
ជា សាក្សី នៅ កន្លែង នោះ អ្នក ផ្តល់ ហិរញ្ញប្បទាន បាន ចុះហត្ថលេខា បោះត្រា និង ប្រគល់ កិច្ចសន្យា នេះ នៅ ថ្ងៃ
20 នៅកន្លែង ណាដែលអ្នក ឮស្នូរនៅទី នោះ អ្នកនឹងប្រមូលផ្ដុំមក ឯយើង ហើយព្រះ នៃយើងនឹងប្រយុទ្ធដើម្បីយើង » ។
ហើយគំនរមិនស្អាត ដោះអាវរបស់គាត់ ។
ហើយយើងដើរតាមគេ ទោះយើងធ្វើអាជីវកម្មនៅ ទី ណា ។
ខ្ញុំអាចនិយាយថា ការរត់ពិតជាបានផ្លាស់ប្តូរជីវិតរបស់ខ្ញុំ » ។
ហ្សកហ្ស៊ី ចង់ រត់ ។
ដូច្នេះ អ្នក ចង់ ធ្វើ ភីហ្សា ។
អ្នក មិន ស្គាល់ បុរស និង ស្ត្រី ។
ដំបូង ភ្នែក របស់ អ្នក នឹង ច្បាស់ ជាង ។
នាងបាននិយាយថា “ បងថ្លៃរបស់ខ្ញុំបាន ប្រែក្លាយខ្ញុំទៅជាថង់ដាល់ ។
គ្មាន អ្វី គួរឱ្យ សង្ស័យ ទេ បើ ប្រៀបធៀប ទៅនឹង ព្រះវិហារ ផ្សេង ទៀត នៅ ជុំវិញ
ចូរ ចាំ ថា អ្វី ក៏ដោយ ដែល អ្នក ធ្វើ ទោះជា មាន គុណធម៌ ឬ អត់ ក៏ដោយ សុទ្ធតែ មាន លទ្ធផល ។ អ្វីដែលភ្ជាប់មកជុំវិញទៅនៅជុំវិញ ។
នៅពេល អ្នក ឃើញ វា រលាយ ហើយ រាលដាល ។
ខ្ញុំ សង្ឃឹម ថា អ្នក មិន មានអារម្មណ៍ ឈឺចាប់ ទេ ហើយ អ្នក សប្បាយ ចិត្ត ។
ទោះ ជាយ៉ាង ណាក៏ដោយ គ្មាននរណាម្នាក់នឹកឃើញបុរសកំសត់នោះឡើយ ។
« បុរសនេះប្រាកដជានៅ ជាមួយនឹងទ្រង់ ព្រោះគាត់ក៏ជាអ្នកស្រុកកាលីឡេដែរ » ។
ដូច្នេះហើយគឺ ជាអ្នកដែលត្រូវសម្រេច ចិត្តថាមួយ ណាសមជាងសម្រាប់អ្នក ។
អា ប្រាហាំ ដែល ជា បុព្វបុរស របស់ យើង បាន សុខចិត្ត លះបង់ កូនប្រុស របស់ គាត់ សម្រាប់ ព្រះ។
ការ សរសើរនឹងលើកទឹក ចិត្តពួកគេ ហើយគេនឹងវង្វេង ។
តើ ពរ ជ័យអ្វីខ្លះដែលត្រូវបាន សន្យាចំពោះអ្នកស្តាប់បង្គាប់ ?
កន្លែង ធ្វើ ការរួម ឬ ការងារ រួមគ្នា កំពុង លេចឡើង ទូទាំង ប្រទេស ។
ដ្បិតយើងនឹងអត់ទោសអំពើទុច្ចរិតរបស់គេ ហើយមិនចាំពីអំពើ បាបរបស់គេទៀតឡើយ » ។
" ខ្ញុំ បាន ធ្វើ វា ព្រោះ ខ្ញុំ គិត ថា គ្មាន ការកោតខ្លាច ព្រះជា ម្ចាស់ ទាល់តែសោះ ហើយ ពួកគេ នឹង សម្លាប់ ខ្ញុំ ដោយសារតែ ប្រពន្ធ របស់ ខ្ញុំ " ។
21 នាងនឹងប្រសូតបានបុត្រមួយ ហើយអ្នក រាល់គ្នានឹងដាក់ព្រះ‌នាមទ្រង់ថា ព្រះ‌ យេស៊ូ ដ្បិតទ្រង់នឹង សង្គ្រោះ រាស្ត្រទ្រង់ឲ្យរួចពីអំពើ បាបរបស់គេ » ។
សម្រាប់ ការប្រមូល ផល គឺ សម្បូរបែប ។
ទៅ ជួប គ្រូពេទ្យ ប្រសិន បើ៖
គេ ត្រូវតែ ល្អ ជាង មនុស្ស ក្បែរ ខ្លួន បើ មិន ដូច្នេះ ទេ ស្លាប់ មិន បាន សម្រេច ។
អ្នកអាចទទួលបានប្រាក់ច្រើន » ។
ម៉ូដដ៏ អស្ចារ្យដែលខ្ញុំ សប្បាយ ចិត្តមិនស្លាប់
ទី មួយ ទាក់ទង នឹង ការឃ្លាត ឆ្ងាយ ពី សង្គម៖
នៅ ពេលព្រឹក អាហារ ពេលព្រឹក ដ៏ ឈ្ងុយ ឆ្ងាញ់ ត្រូវបាន បម្រើ នៅក្នុង ម្លប់ ដើមឈើ ។
នៅ ទី បញ្ចប់វាជាក្រុម រ៉ុកដែលយើងទាំងអស់គ្នាចង់បាន ។
គ្មានអ្វីល្អជាងការ ឲ្យជើងអ្នកស្រូបខ្យល់អាកាសបរិសុទ្ធបន្ទាប់ពីដើរលេងអស់មួយថ្ងៃ ។
ដល់ គាត់ ថា គាត់ នឹង បំពាន លើ សេចក្តីទុកចិត្ត ដូច ដែល គាត់ មាន
មើល អ្វីដែលខ្ញុំសរសេរទៅអ្នកមិនមែនជាការ កុហកទេ ព្រះជាសាក្សីរបស់ខ្ញុំ ។
តាំងពីពេលនោះមកគេមិនឃើញនាងតែងខ្លួនសោះ ។
វាយ គាត់ ខណៈពេល ដែល គាត់ កំពុង ធ្វើ ការវាយប្រហារ របស់ គាត់ ។
« ឥឡូវនេះ យើងជាកូនរបស់ព្រះ ប៉ុន្តែវានៅមិនទាន់លេចចេញនូវអ្វីដែលយើងនឹងក្លាយទៅជាឡើយ ដ្បិត កាល ណាទ្រង់លេចមក យើងនឹងឃើញទ្រង់ដូចជាទ្រង់ ហើយយើងនឹងបានដូចទ្រង់ » ។
25 ព្រះ‌ យេស៊ូមានព្រះ‌បន្ទូលទៅនាង ថា៖ « ខ្ញុំជាដំណើរ រស់ឡើងវិញ ហើយជាជីវិត អ្នក ណាដែលជឿលើខ្ញុំ ទោះបីគាត់ស្លាប់ហើយក៏ដោយ ក៏គាត់នឹង រស់ឡើងវិញនៅថ្ងៃនេះ » ។
26 ហើយពួកគេមិនអាចចាប់ទ្រង់តាមព្រះបន្ទូលរបស់ទ្រង់នៅចំពោះមុខប្រជាជនបានទេ ។
ចូល ហើយ ក្លាយជា នរណា ម្នាក់ ។
ក៏ ធ្លាប់ ស្គាល់ ខ្ញុំ ដែរ ។
" ខ្ញុំ ជឿ ថា អ្នកនយោបាយ កំពុង ធ្វើឱ្យ ខូច ប្រព័ន្ធ នយោបាយ របស់ អាមេរិក ដោយ ព្យាយាម ធ្វើពុត ថា នរណា ម្នាក់ កំពុង គ្រប់គ្រង អាមេរិក ពី ខាងក្រៅ " ។
ដំបូង យើង និយាយ ខូឃី ខ្លួន ឯង ។
សម្រាប់ក្មេងប្រុសថៃអាយុ ១១ ឆ្នាំម្នាក់នេះ គាត់គ្មានជម្រើសក្រៅពីធ្វើ ការ ដើម្បីចំណាយលើថ្លៃព្យាបាលម្តាយរបស់ គាត់។
ស្អែកខ្ញុំចេញទៅស្អែក ។
លើ លោក នេះ អ្នក មាន បញ្ហា ប៉ុន្តែ សូម លើកទឹកចិត្ត !
ដើម្បីឲ្យមនុស្សនៃព្រះ អាចបានពេញលេញ ហើយបានបំពាក់ដោយហ្មត់ចត់សម្រាប់រាល់ការ ល្អទាំងអស់ » ។
គាត់បាននិយាយថា៖ « ខ្ញុំគ្មាន សល់អ្វីទេ » ។
ភ្នែក ខ្មៅ ហាហា កំប្លែង ណាស់ !
គ្មាន បញ្ហា ទេ ខ្ញុំ រីករាយ ក្នុង ការចែករំលែក !
តើ ខ្ញុំ គួរ ធ្វើ ដូចម្តេច ដើម្បី ការពារ ខ្លួន ពី ព្រះអាទិត្យ ?
ដោយ សារពួកគេមិនព្រម ប្រែ ចិត្តពីអំពើ បាបរបស់ខ្លួន ពួកគេនឹង ស្រេកឃ្លាន និងអស់ សង្ឃឹម ។
៨ មាត់របស់ខ្ញុំពោរពេញទៅដោយការ សរសើររបស់អ្នក ដោយប្រកាសពីសិរីល្អរបស់អ្នករាល់ថ្ងៃ ។
អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាស្លាប់ក៏ដោយ អ្នក នោះនឹងមានជីវិត » ។
ប៉ុន្តែ ហេ ខ្ញុំ គិត ថា វា ស្រប នឹង អូសាកា តាម វប្បធម៌ ។
តើនរណាបានព្រមានអ្នកឲ្យរួចពីសេចក្ដី ក្រោធរបស់ព្រះ?
អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាស្លាប់ក៏ដោយ ក៏នឹងមានជីវិត » ។
ខ្ញុំ បាន ទាក់ទង ជាមួយ ទាហាន ម៉ារីន រួម
អស់អ្នកដែលមានសេចក្ដី ស្រឡាញ់ ដោយដឹងថាខ្ញុំត្រូវបានតាំងសម្រាប់ការពារដំណឹងល្អ ;
ពួកគេ ភ្ញាក់ផ្អើល នឹង សមត្ថភាព របស់ ពួកគេ ។
« យើងតែងតែអរគុណព្រះ សម្រាប់អ្នក រាល់ គ្នា ដោយលើកឡើងអ្នកនៅក្នុងការ អធិស្ឋានរបស់យើង ។
៣៧ លោកបារណា បាសចង់យកលោក យ៉ូហាន ដែលហៅថាម៉ាកុស ទៅជាមួយដែរ ។
យើង ត្រៀមខ្លួន ហើយ រង់ចាំ អ្នក !
គាត់នឹងក្លាយជាអ្នកខ្លាំងជាង ហើយប្រើអំណាចលើអ្នកទន់ខ្សោយ ។
ការ ដក ថយត្រូវបានស្នើឡើងដោយអ្នកតែងទំនុកតម្កើងដែលនិយាយថា៖ « នៅស្ងៀម ហើយដឹងថាយើងជាព្រះ!
ចង់ ធ្វើឱ្យ បុរស របស់ ខ្ញុំ ភ្ញាក់ផ្អើល ។
លះបង់ ដើម្បី ផលិត ក្រណាត់ ម៉ែត្រ ។
នាងនិយាយទៅ កាន់គាត់ថា “ អ្នកត្រូវតែជាមហា វីរ៉ា ” អ្នកដែលបានត្រាស់ដឹងក្នុងសម័យនេះ គេនិយាយ ។
អ្នកដែល មកយឺតនឹងទទួល ទោសដល់ជីវិត !
បី ឆ្នាំ ក្រោយមក ខ្ញុំ បាន សម្រេចចិត្ត ។
អ្នក បាន អាន រួចហើយ អំពី ការរំលឹក ឡើងវិញ ។
ការឆ្លុះបញ្ចាំង ពី អណ្តាត ភ្លើង ដែល អ្នក បាន ឆេះ ។
ឯងនឹងសម្លាប់អញ ដូចឯងបានសម្លាប់ជន ជាតិអេស៊ីបនោះកាលពីម្សិល មិញឬ ? » ។
គាត់ នឹង អណ្តែត នៅក្នុង ទឹក ហើយ មាន ពន្លឺ នៅក្នុង ភ្នែក ងងឹត ផងដែរ ។
ខ្ញុំ បាន ទទួល ករណី លើកលែង ជា លើក ដំបូង ។
ធ្ងន់ធ្ងរ ណាស់ លោក អើយ ។
ព្រះជាព្រះបិតាជាមាតារបស់ ខ្ញុំ ,
ចាប់ពី ថ្ងៃ នោះ មក គាត់ បាន លះបង់ ជីវិត របស់ គាត់ ( ក្រៅ ម៉ោង ទោះ យ៉ាងណា ក៏ដោយ ) ដើម្បី ជួយសង្គ្រោះ បាល់ ដ៏ គួរឱ្យ ស្រឡាញ់ ទាំងនោះ ។
“ ខ្ញុំ នៅសល់ កុងត្រា ១ឆ្នាំ កន្លះ ទៀត ហើយ ខ្ញុំ ចង់ បន្ត រហូតដល់ ចប់ ។
ព្រះគឺ ធំ ជាង ការបដិសេធ ទាំងឡាយ ណា ដែល អាច ធ្វើ បាន ពី ទ្រង់ ហើយ ទ្រង់ នឹង មិន អនុញ្ញាតឱ្យ ការវាយលុក នៃ អំពើ អាក្រក់ មក រំខាន ដល់ ភាពតែ មួយ នៃ វិញ្ញាណ ( នៅក្នុង សេចក្ដីស្រឡាញ់ ) ឡើយ ។
ខ្ញុំ បាន សុំ ឱ្យ គាត់ រង់ចាំ រហូតដល់ ខ្ញុំ ត្រលប់ ពី ហាង ។
នោះ ហើយ ជា កន្លែង ដែល សង្គម និយម ចូលមក ។
‹ ទ្រង់មិនមែនជាព្រះ នៃមនុស្សស្លាប់ទេ គឺជាព្រះ នៃមនុស្ស រស់ › ។
NIV: មិន មែនអ្នក ណាដែលសរសើរខ្លួនឯងដែលពេញ ចិត្តទេ គឺ ជាអ្នកដែលព្រះ អម្ចាស់សរសើរ ។
បន្ទាប់ពីផ្លាស់ប្តូររដូវស្លឹកឈើជ្រុះកន្លង មក យើងបានស្វែង រកអ្វីគ្រប់យ៉ាង ។
មនុស្ស មាន បាប ពួកគេ ធ្វើបាប អ្នក ពួកគេ ជា មនុស្ស អាត្មានិយម ពួកគេ តែងតែ ធ្វើ ផ្ទុយ ពី អ្វី ដែល អ្នក កំពុង បន់ស្រន់ ឱ្យ ពួកគេ ធ្វើ ។
និង ការថ្វាយបង្គំ បុព្វបុរស របស់ យើង ។
បើអ្នកនៅលើ ហ្វេ សប៊ុករកខ្ញុំ !
ទាំងនេះ មើល ទៅ ស្រដៀង នឹង វា ។
ពេលនោះ អ្នកស្វែង រកសេចក្ដី ពិតដែលមាន ចិត្តបរិសុទ្ធនឹងត្រូវទាក់ ទាញ ។
ហើយ ការពិត សេះ នេះ កំពុង ចាប់ផ្តើម ដំបូង របស់ នាង សម្រាប់ គាត់ ។
អ្នក ទាំងអស់គ្នានៅសុខ សប្បាយ ។
ដូចបាននិយាយថា៖ « ថ្ងៃនេះបើអ្នក ឮសំឡេងគាត់ កុំធ្វើ ចិត្តរឹងប៉ឹងដូចអ្នកបានធ្វើក្នុងការ បះបោរនោះឡើយ » ។
មនុស្ស ធម្មតា ហើយ ពួកយើង នៅសល់ ក៏ ដូចគ្នា ដែរ ។
ខ្ញុំច្រណែននឹងអ្នក រាល់ គ្នា ដោយការ ច្រណែនព្រះ ដ្បិតខ្ញុំបានរៀបការ នឹងអ្នក ជាមួយប្ដីតែមួយ ដើម្បីឲ្យខ្ញុំបង្ហាញអ្នក ជាស្ត្រីព្រហ្ម ចារីបរិសុទ្ធដល់ព្រះគ្រិស្ដ ។
១១ សាក្សីទុច្ចរិតក្រោកឡើង គេសួរខ្ញុំអំពីរឿងដែលខ្ញុំមិនដឹង ។
2 មានមនុស្សជាច្រើនដើរតាមទ្រង់ ហើយទ្រង់ក៏ប្រោសគេនៅទី នោះ ។
ព្រះទ្រង់បានឆ្លើយ តបដោយសេចក្តី ប្រកាសដោយកំហឹងថា ទ្រង់នឹងបំផ្លាញពួកគេ ។
អ្នក ខ្លះ ចង់ឱ្យ យើង គិត ថា វា មាន គ្រោះថ្នាក់ ។
និង ស្រទាប់ ខាងក្រោម សមរម្យ ។
នៅពេលនាងត្រឡប់មកវិញ នាងបានឈប់និយាយ ។
មានចែងទុកមកថា “ ហើយគេបានជឿដល់ព្រះ‌ អម្ចាស់ ហើយនឹងម៉ូសេ ជាអ្នក បម្រើទ្រង់ ” ។
ដើរ ជុំវិញ ទីក្រុង ដូចជា អ្នក នៅ ទីនោះ ។
ចូរស្វែង រកការ សងសឹក ប៉ុន្តែដើម្បីធ្វើសេចក្តី ថ្លែង ការណ៍ទាំងពីរទៅ កាន់ពួកអ្នកប្រព្រឹត្តអាក្រក់ដែលអ្នកប្រយុទ្ធ
នៅ ចុងបញ្ចប់ នៃ ថ្ងៃទី ពីរ
ហើយ អង្គុយ ដោយ ងឿងឆ្ងល់ ។
ខ្ញុំ ចង់ ណែនាំ ថា មាន ក្នុង ចំណោម ពួក គ្រីស្ទាន
ខ្ញុំអាចនិយាយបានថា វាទំនងជាទាបជាង ២០ ភាគរយដែលខ្ពស់ជាង ២០ ភាគរយ » ។
ពេលនោះ ព្រះ អម្ចាស់បានបង្ហាញគាត់ថា គាត់មិនបានធ្វើល្អទេ ដែលគាត់ខឹងនឹងរឿងនេះ ។ ដ្បិតជាការ ល្អដែលព្រះ បានអាណិតដល់ប្រជាជនក្រុង នីនី វេ។
អ្នក ជាមនុស្សដែលនឹងកំពុងស្តាប់ពួកគេ ដូច្នេះពួកគេត្រូវនិយាយល្អចំពោះអ្នក ។
លេខ ទូរស័ព្ទ របស់ អ្នក ត្រូវតែ មាន យ៉ាងហោចណាស់ 10 ខ្ទង់ ។
តន្ត្រី សម្រាប់ ទិវា កុមារ ។
21 ដូច្នេះ មានបុរសម្នាក់ដែលបានទៅជាមួយនឹងយើង ក្នុងអំឡុងពេលដែលព្រះ‌ អម្ចាស់យេស៊ូបានយាងចូល មកក្នុងចំណោមយើង ។
ព្រះអង្គជាព្រះ ដ៏មានឫ ទ្ធានុភាព ជាព្រះ អម្ចាស់នៃព្រះអម្ចាស់ ជាស្ដេចនៃ ស្ដេច និងជាម្ចាស់នៃ ពលបរិវារ ។
ខ្ញុំមិនស្គាល់លោកម្ចាស់ទេ ហើយខ្ញុំក៏មិនអនុញ្ញាតឲ្យអ៊ីស្រាអែលទៅដែរ » ។
ខ្ញុំ នឹង ត្រលប់ ទៅ ផ្ទះ កក់ក្តៅ ។
១៣ ពេលនោះ ព្រះ បានយាងចុះពីគាត់ នៅកន្លែងដែលទ្រង់មាន បន្ទូលជាមួយគាត់ ។
ឃ៖ ខ្ញុំ បាន ចាក់សោ ទ្វារ ។
26 ខ្ញុំចង់និយាយថា៖ « ខ្ញុំនឹងកាត់វាជាដុំ ៗ ខ្ញុំនឹងដកការ ចងចាំរបស់វាចេញពីមនុស្ស » ។
យក មនុស្ស ទាំងនោះ ចេញ ពី ជីវិត របស់ អ្នក ។
មនុស្ស យើង ជា មនុស្ស អាត្មានិយម ខ្លាំង ណាស់ ដែល ពួកយើង នឹង មិន សូម្បីតែ អធិស្ឋាន ដល់ ព្រះ ប្រសិនបើ គ្មាន អ្វី សម្រាប់ យើង ។
« បញ្ហាប្រឈមសម្រាប់ កប៉ាល់ដែលបានសាងសង់នៅថ្ងៃនេះគឺថា នឹងកើតឡើងក្នុងអាយុជីវិតរបស់វា ។
ដូច្នេះ ទ្រង់ គឺជា បិតា នៃ អស់ អ្នក ដែល ជឿ ប៉ុន្តែ មិន បាន កាត់ ស្បែក ដើម្បីឲ្យ សេចក្តីសុចរិត ត្រូវបាន រាប់បញ្ចូល ដល់ ពួកគេ ។
ខ្ញុំមិនដឹងអ្វីផ្សេងត្រូវនិយាយទេ » ។
និង ការស៊ើបអង្កេត ចរន្ត កំដៅ ។
និងហុកសិបហិចតា ដោយផ្តល់ឲ្យគាត់នឹងតាំងលំនៅ លើវា ។
អ័ ប្រាហាំ មាន កូនប្រុស មួយ ។
« ជន ជាតិយូដាខ្លះបានបញ្ចុះ បញ្ចូល ហើយចូលរួមជាមួយប៉ូល និងស៊ីឡាស » ។
អាហារពេលព្រឹកគឺសំខាន់ណាស់ ប៉ុន្តែកុំញ៉ាំរបស់ទាំងនេះ !
ត្រឡប់ ទៅ សិល្បៈ វិញ ។
ដូច្នេះ ទ្រង់មិនបានឡើងទៅស្ថាន សួគ៌ទេ ។
