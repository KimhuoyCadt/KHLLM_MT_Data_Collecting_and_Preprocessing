នឹងយកគាត់ទៅឆ្ងាយ ឬហែកគាត់ជាដុំ ៗ » ។
“ នៅ តង់ទី១ យើងមិនជឿលើខ្លួនឯងទេ ។
បន្ត បង្កើត រឿង បែប នេះ ។
នៅ តាម ផ្លូវ ទៅ ផ្ទះ ខ្ញុំ បាន ឃើញ ព្រះអាទិត្យ ។
ពេលដែលព្រះអម្ចាស់បានតាំងលំនៅ ដល់ញាតិសន្តានរបស់អ្នក ដូចអ្នកបានតាំងលំនៅហើយ ហើយគេក៏បាន កាន់កាប់ទឹកដីដែលព្រះអម្ចាស់ ជាព្រះ របស់អ្នកប្រទានអោយពួកគេឆ្លងទន្លេយ័រ ដាន់ដែរ អ្នក រាល់គ្នាអាចត្រឡប់ទៅ កាន់ទ្រព្យ សម្បត្តិដែលយើងបានប្រគល់ជូនអ្នកវិញ ។
« មិនមែនឆ្អឹងរបស់ទ្រង់នឹងត្រូវខូចឡើយ » ។
នេះ ជា ការចាប់ ទាំងអស់៖ ខ្ញុំ រៀបការ ហើយ ។
អនាគតអ្នកមិនដឹងខ្លួន អ្នក បានសម្លាប់ឪពុកម្តាយខ្ញុំ ។
ហើយកសាងសមត្ថភាពរបស់អ្នកក្នុងការ ឈរដោយការ ជឿជាក់មិនងាក រេ ពេលដែលអ្នកត្រូវការ វាខ្លាំងបំផុត ។
អ្នក នឹង ឃើញ ពួកគេ ដោយ ភ្នែក របស់ អ្នក ។
មនុស្ស ជាច្រើន នៅ ទីនេះ រង់ចាំ ដើម្បី ចូលទៅ ខាងក្នុង ។
ពួកគេមិនបានជឿលើលោកទេ ដូច្នេះហើយលោកនឹងដាក់ទោសពួកគេ ។
ឬ ជាការ ប្រកាសដំណឹងល្អ ?
ខ្ញុំ រស់នៅ ដើម្បី សាកល្បង ខ្លួន ឯង នៅលើ សង្វៀន ។
៧ ដូច្នេះ ពួកគេសម្រេច ចិត្តយកប្រាក់នេះទៅទិញដីជាងស្មូនធ្វើជាកន្លែងបញ្ចុះ សពជនបរទេស ។
ឥឡូវអ្នកអាចប្រើអ៊ីនធឺណិតបាន » ។
ថ្ងៃនេះជាថ្ងៃសម្រាប់ខ្ញុំ » ។
ព្រះអង្គមានព្រះបន្ទូលទៅគេ ថា៖ « ហេតុអ្វីបានជាពិបាក ចិត្ត ហើយយំ ?
វា អាច បង្កើន ការអរ ព្រះគុណ ដល់ សិរី ល្អ នៃ ព្រះ។
« ត្រូវស្លៀកពាក់ហើយត្រៀមខ្លួនសម្រាប់ការបម្រើ ហើយរក្សា ចង្កៀងរបស់អ្នក ... » ។
ប៉ុន្តែពួកគេប្តេជ្ញា ចិត្តខ្លួនឯងក្នុងរយៈពេលយូរនៅពេលពួកគេរកឃើញការ ធ្លាក់ចុះ ។
គ្មាន អ្នកណា ហ៊ាន ឆ្លងកាត់ ផ្លូវ នោះ នៅ ពេល យប់ ទេ ។
អ្នកបើកបរពេញមួយថ្ងៃ ហើយមិនបានទៅ ណាទេ ។
31 ព្រះអង្គមានព្រះបន្ទូលទៅគាត់ ថា៖ « ប្រសិនបើគេមិនស្ដាប់លោកម៉ូសេ និងព្យាការីទេ នោះគេនឹងមិនជឿឡើយ ទោះបីមានអ្នក ណារស់ពីស្លាប់ឡើងវិញក៏ដោយ » ។
ហើយ អ្នក មើល ទៅ ដូចជា អ្នកដឹង អ្នក មើល ទៅ ដូចជា អ្នក កំពុង ត្អូញត្អែរ ។
រចនាសម្ព័ន្ធ ទាំងមូល ដែល យើង បាន ឮ ពីមុន មក ។
" តើអ្នកគិតថាអ្នកអាចឱ្យខ្ញុំ បញ្ជាបន្ថែមមួយចំនួន? "
« ហេតុអ្វីបានជាអ្នក និយាយជាពាក្យប្រស្នាដល់ប្រជាជន ?
នាងត្រូវបានគេបញ្ជូនទៅមន្ទីរ ពេទ្យពីរដងក្នុងខែ តែមួយដោយគ្រោះថ្នាក់
14 ពេលនេះ ព្រះ‌វិញ្ញាណនៃព្រះ‌ អម្ចាស់បានចាកចេញពីសូល ហើយវិញ្ញាណអាក្រក់ពីព្រះ‌ អម្ចាស់បានធ្វើទារុណកម្មគាត់ ។
ក្នុង ករណី នៃ ថ្នាក់ ប្រជាជន របស់ អ្នក អ្នក គួរតែ ធ្វើ ដូច នេះ៖
វា គឺ អំពី ព្រះដែល សម្រេច បំណង ព្រះហឫទ័យ របស់ ព្រះ។
ដូចធម្មតាគេបាននិយាយថា " ដំណោះស្រាយគឺទុកជាមោឃៈ " ។
នៅ ថ្ងៃទី បី ទ្រង់ នឹង ប្រោស យើង ឲ្យ រស់ ឡើងវិញ
៣៥ ពេត្រុសនិយាយទៅគាត់ ថា៖ « ទោះខ្ញុំត្រូវស្លាប់ជាមួយអ្នកក៏ដោយ ក៏ខ្ញុំមិនបដិសេធដែរ ។ សិស្សទាំងអស់ក៏និយាយដូចគ្នាដែរ ។
យើង ទាំងអស់ គ្នា គឺជា កូនប្រុស របស់ ព្រះដែល ខ្ជះខ្ជា យ ដោយ ឥត ប្រុងប្រយ័ត្ន ។
« យើងគ្មានសិទ្ធិសម្លាប់អ្នក ណាទេ ។
“ យើងភ័យខ្លាចក្នុងការ និយាយអំពីរឿងនេះ ។
បុរស នោះ បាន ប្តឹង ទៅ ធនាគារ ។
កុំខ្លាចពេលដែលអ្នក ណាក្លាយជាអ្នកមានឡើយ ពេលដែលសិរីល្អនៃផ្ទះរបស់ខ្លួនកើនឡើង
ទោះបីជាមានមនុស្ស បាបនៅក្នុងចំណោមពួកគេ ព្រះ ដ៏ វិសុទ្ធសូមប្រទាន ពរដល់ទ្រង់ មិនបដិសេធការ អធិស្ឋានរបស់មនុស្សជាច្រើនឡើយ ។
ផ្លែ ឈើ ដំបូង លេចឡើង នៅលើ ដើមឈើ ដែល បាន ឈានដល់ អាយុ ប្រាំបួន ឆ្នាំ ។
បងប្អូនរបស់គាត់ដែលនៅ សល់សុទ្ធតែជាជ្រូក » ។
ដូច្នេះ ខ្ញុំនឹងដាក់ទោសគាត់ រួចដោះលែងគាត់ » ។
ខ្ញុំ ស្គាល់ តែ អារី ហ្គាតូ ប៉ុណ្ណោះ ។
គ្រប់ គ្នា ខ្ចប់ ច្រើន ពេក អ្នកដឹង ថា វា ជា ការពិត ។
អ្នកដឹកនាំ : ខ្ញុំ បាន ជ្រមុជ ទឹក ឱ្យ អ្នក ; ប៉ុន្តែ គាត់នឹងធ្វើបុណ្យជ្រមុជទឹកអ្នកដោយព្រះវិញ្ញាណបរិសុទ្ធ » ។
ដើម្បី សន្សំ សំចៃ ពេលវេលា របស់ តុលាការ ។
ទីក្រុង ឡុងដ៍ គឺជា ទីក្រុង ដ៏ អស្ចារ្យ មួយ នៅក្នុង ពិភពលោក ។
តាំងពី បញ្ចប់វាខ្ញុំអាយុ ៨ ឆ្នាំ ខ្ញុំបានជួបអ្នក ។
ពេលខ្ញុំចូលទៅជិត ខ្ញុំបានឃើញសាកសពបួន ។
ហើយដើម្បីឲ្យអ្នក រាល់គ្នាបានជាប្រជាជនបរិសុទ្ធដល់ព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នក ដូចទ្រង់បានមានព្រះ‌បន្ទូល មក » ។
ដើម្បីឱ្យយើងអាចផ្សងព្រេងនឹងនាង។
មនុស្សប្រហែលមិនចង់ស្តាប់ពួកគេទេ ប៉ុន្តែពួកគេត្រូវខឹងដោយ សារ តែពួកគេមានអាវុធ នុយក្លេអ៊ែរ ។
តើពួកគេនឹងធ្វើបែបនេះនៅក្នុងប្រទេសរបស់ពួកគេឬ ? » ។
ប៉ុន្តែកេរ ដំណែលនោះស្ថិតក្នុងគ្រោះថ្នាក់ ។
ពួកគេបានយកព្រះ អម្ចាស់ចេញពីផ្នូរ ហើយយើងមិនដឹងថាគេយកលោកទៅ ឯ ណាទេ » ។
ពួកសិស្សរបស់លោក យ៉ូហានបានប្រាប់លោកអំពី ការ ទាំងអស់នេះ ។
បើអ្នកមិនគោរពឪពុកម្តាយទេ ការ បញ្ច្រាសក៏នឹងកើតមានដែរ ហើយវាមិនទាន់ពេលវេលា
ខ្ញុំ ដឹង ថា ខ្ញុំ មាន ភាព ផុយស្រួយ និង ខ្សោយ ។
បន្ទាប់មកដង្កៀប នឹង ត្រូវបាន ដាក់ នៅ ការណាត់ជួប ជា បន្តបន្ទាប់ ។
ខ្ញុំ ដឹង ថា គាត់ ស្គាល់ យើង ហើយ ស្រលាញ់ យើង ។
វានឹងត្រូវបាន យល់ » ។
គាត់ បាន ប្រាប់ ប្រពន្ធ របស់ គាត់ ភ្លាម ៗ ។
អ្នក ឃើញ " ខ្ញុំ មាន បញ្ហា បន្តិចបន្តួច ជាមួយ វា ។
កម្លាំង របស់ យើង ស្ថិត នៅលើ ជំនឿ របស់ យើង ថា បច្ចេកវិទ្យា គួរតែ បម្រើ មនុស្ស មិន មែន មធ្យោបាយ ផ្សេង ទៀត នោះ ទេ ។
“ លោក ម្ចាស់ ខ្ញុំ មិន បាន ធ្វើ អ្វី ដែល គួរអោយ ចាប់អារម្មណ៍ ដូច របស់ អ្នកទេ ។
ខ្ញុំ បាន យក គាត់ មកវិញ នៅ ខែមេសា ។
អ្នក ច្រូត និង ព្រះអម្ចាស់ នៃ ការប្រមូល ផល
ទ្វារ បើក សម្រាប់ អ្នក ជារៀងរាល់ ថ្ងៃ ។
ប៉ុន្តែ ប្រសិនបើ ខ្ញុំ ធ្វើ វា វា នឹង ផ្តល់ឱ្យ ខ្ញុំ
តើមានអ្វីខ្លះអំពី ក្រឹត្យ ក្រមរបស់ព្រះ ដែលផ្ដល់ឲ្យអ្នក នូវការ យល់ដឹងអំពី លក្ខណៈរបស់ព្រះ?
ម្តាយឪពុកខ្ញុំពិតជាមិនបានស្តាប់តន្ត្រីបែបនោះទេ ។
៣០ ( ហា ) អ្នក ណាមិននៅជាមួយខ្ញុំ អ្នកនោះប្រឆាំងនឹងខ្ញុំ ។ ហើយអ្នក ណាដែលមិនប្រមូលផ្ដុំជាមួយនឹងខ្ញុំក៏ខ្ចាត់ខ្ចាយទៅ ។
ប៉ុន្តែយប់មិញគេនឹកឃើញ កាលនៅរៀនថ្នាក់បរិញ្ញាបត្រ ។
មនុស្សដែលគាត់ស្គាល់ហើយបាន លា ចាកលោកទៅហើយ ។
ថ្ងៃ នេះ ជា ថ្ងៃ មួយ ទៀត ហើយ ព្រះជា អ្នកទទួលខុសត្រូវ ។
តាមពិត ទៅ ខ្ញុំមានរឿងចង់និយាយច្រើន ដូច្នេះខ្ញុំនឹងបង្ហោះរឿង នេះជាពីរ ឬបីផ្នែក។
ភាពងាយស្រួល នៃ ការលើក ។
អ្នក ត្រូវតែ ធ្វើ តាម គំរូ របស់ ខ្ញុំ ដូចជា ខ្ញុំ ធ្វើ តាម គំរូ របស់ ព្រះគ្រីស្ទ ។
ប្អូន ស្រី កំពុង ចាប់ ប្តី ។
ព្រះរបស់ ខ្ញុំ មាន អំណាច
ខ្ញុំ ជាអ្នក បម្រើរួមគ្នារបស់អ្នក ហើយជាបងប្អូនរបស់អ្នកម្នាក់ជាព្យាការី និង ជាអ្នកដែល កាន់តាមពាក្យនៃសៀវភៅនេះ ។
