( កំពត) ៖ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នៅ សាលា ខេត្ត កំពត លោក ជា វ តាយ អភិបាល ខេត្ត បាន ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា ស្ដីពី ការងារ ត្រៀម ចូលរួម រៀបចំ តាំងពិព័រណ៍ បង្ហាញ ពី សមិទ្ធផល ក្នុង ពិធី សម្ពោធ វិមាន អនុស្សាវរីយ៍ នយោបាយ ឈ្នះ ឈ្នះ និង ការងារ ឆ្លង ឆ្នាំ សកល ២០១៨ ឈាន ចូល ឆ្នាំ ២០១៩ ។
លោក ជា វ តាយ បន្ត ថា សមិទ្ធផល និង ការអភិវឌ្ឍ ទាំងអស់ ដែល កំពុង មាន ជាក់ស្ដែង នេះ គឺជា តឹកតាង អំពី ភាពសុខដុម រម្មណីយកម្ម របស់ សង្គម កម្ពុជា ក្នុង ដំណាក់កាល ដែល កម្ពុជា ឲ្យ ឈ្នោះ ថា សម័យកាល តេជោ សែន មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ។
លោក អភិបាល ខេត្ត ក៏ បាន សំណូមពរ និង ផ្ដាំផ្ញើ ឲ្យ គ្រប់ ថ្នាក់ដឹកនាំ ខេត្ត និង មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង អាជ្ញាធរ ក្រុង ស្រុក ត្រូវ យកចិត្តទុកដាក់ ពី បញ្ហា រូបភាព ទាំង សកម្មភាព និង សមិទ្ធផល នានា រីកចម្រើន ក្នុង ខេត្ត ដោយ ផ្សារភ្ជាប់ នយោបាយ សន្តិសុខ សេដ្ឋកិច្ច ជាមួយ ជីវភាពរីកចម្រើន របស់ ប្រជាពលរដ្ឋ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ដឹកនាំ ប្រទេសជាតិ ពិសេស ឆ្លុះបញ្ចាំង ក្រោយ រយះពេល ២០ ឆ្នាំ នៃ នយោបាយ ឈ្នះ ឈ្នះ បាន បញ្ចប់ សង្គ្រាម ទាំងស្រុង ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ បាន លើកឡើង ថា សុខ សន្តិភាព មាន តម្លៃ ធំ ធេង ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ៗ រូប ព្រមទាំង កងយោធពល ខេរ ភូមិន្ទ ដែល នាំមក ដោយសារ គោល នយោបាយ ឈ្នះ - ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ធ្វើឱ្យ ភាគី ជម្លោះ ខ្មែរ រវាង ខ្មែរ បង្រួបបង្រួមគ្នា ទាំងស្រុង នៅ ឆ្នាំ ១៩៩៨ រហូត មក ពេល បច្ចុប្បន្ន នេះ ។
ការលើកឡើង បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ធ្វើឡើង នៅ ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ក្នុង ឱកាស ដែល នាយ ឧត្តមសេនីយ៍ បាន អញ្ជើញ ជា អធិបតីភាព ពិធី បើក វគ្គ បណ្តុះបណ្តាល នាយ ទាហាន ថ្នាក់ កង អនុ សេនា ទោ និង កង អនុ សេនា ធំ ទ័ព ជំនាញ ជំនាន់ ទី ០៣ ស្ថិត នៅ វិទ្យាស្ថានទ័ព ជើងគោក ( ថ្លុក តា សេក ) ក្នុង ឃុំ ត្រែង ត្រយឹង ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ ។
ការស្មោះត្រង់ អស់ ពី ចិត្ត និង បេះដូង នេះ គឺ សំដៅ ទៅដល់ ការ ដែល មិន ធ្វើ ខុស នឹង ច្បាប់ មិន ធ្វើ អ្វី ដែល ខុស នឹង ឆន្ទៈ របស់ ប្រទេស កម្ពុជា ហើយ ឃើញ អ្នកណា មាន គំនិត អាក្រក់ មាន បំណង ចង់ បំផ្លាញ សុខ សន្តិភាព យើង ត្រូវតែ ហ៊ាន រាយការណ៍ ហ៊ាន និយាយ ហ៊ាន ថា ហ៊ាន ពុះពារ ដើម្បី លុបបំបាត់ អំពី បញ្ហា នោះ ឱ្យ បាន ដែល នេះ ហើយ ជា ការស្មោះត្រង់ អស់ ពី ចិត្ត នោះ ។
នាយ ឧត្តមសេនីយ៍ ក៏ បាន ផ្ដាំផ្ញើ ដល់ យោធិន ទាំងអស់ ត្រូវ មាន ការស្មោះត្រង់ នឹង រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង នោះ ត្រូវ ខិតខំ កសាង ជំនាញ របស់ ខ្លួន ចូលរួម ក្នុង ការការពារ បូរណភាព ទឹកដី និង មាន ការសាមគ្គី ឯកភាព គ្នា ដើម្បី ការពារ តម្លៃ សុខ សន្តិភាព ដែល មាន នា បច្ចុប្បន្ន នេះ ។ ទោះបី ក្នុង តម្លៃ ណា ក៏ដោយ ត្រូវ ប្រឆាំង ដាច់ខាត និង វាយ បក នូវ រាល់ ឧបាយកល របស់ ជន អគតិ មួយចំនួន តូច ដែល ចង់ បំផ្លាញ់ សុខ សន្តិភាព កម្ពុជា ៕
អភិបាល ខណ្ឌ ដង្កោ បន្ដ សំណេះសំណាល និង ស្ថាបនា ផ្លូវ បេតុង មួយ ខ្សែ ជូន ប្រជាពលរដ្ឋ នៅ សង្កាត់ ស្ពាន ថ្ម
( ភ្នំពេញ ) ៖ លោក នុត ពុធ ដារ៉ា ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា អភិបាល ខណ្ឌ ដង្កោ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ បាន សំណេះសំណាល សួរសុខទុក្ខ ប្រជាពលរដ្ឋ និង ពិនិត្យមើល គម្រោង ស្ថាបនា ផ្លូវ បេតុង ០១ ខ្សែ ក្នុង ភូមិ អញ្ចាញ សង្កាត់ ស្ពាន ថ្ម ។
កុមារ អាយុ៣ ឆ្នាំ ម្នាក់ ត្រូវ រង្វាន់ ទឹកប្រាក់ ១០០ លាន រៀល ពី អ៊ីឈីតាន់ . ពិតជា អស្ចារ្យ មែន !
តាម សម្ដី អ្នកនាង បេត បូ ផា អាយុ ២៨ ឆ្នាំ មាន មុខរបរ ជា កម្មការិនី រោងចក្រ កាត់ដេរ រស់ នៅ ភូមិ ត្រពាំងក្រឡោង ឃុំ លំពង់ ស្រុក បាទី ខេត្ត តាកែវ ដែល ត្រូវ ជា ម្តាយ បង្កើត របស់ កុមារ មាន សំណាង ខាងលើ នេះ បាន ប្រាប់ ក្រុមការងារ ដែល ចុះ ប្រគល់ រង្វាន់ ដល់ លំនៅឋាន ផ្ទាល់ តែម្ដង យ៉ាង ដូច្នេះ ថា កាលពី សប្ដាហ៍ កន្លងទៅ នេះ កូនប្រុស របស់ អ្នកនាង ដែល មាន ឈ្មោះ ម៉ាស់ ថុនា អាយុ ត្រឹម ជាង ៣ ឆ្នាំ បាន ទា ទិញ តែ បៃតង អ៊ីឈីតាន់ រសជាតិ ផ្លែ គូ លេន ពី តូប អ្នកលក់ ដែល ស្ថិត នៅ ជាប់ គ្នា ទទួលទាន ។
លុះ ពេល មួល គម្រប ដប ឱ្យ កូន ទទួលទាន ក៏ ស្រាប់តែ ឃើញ មាន រង្វាន់ ១០០ លាន រៀល នៅក្នុង គម្រប ដប តែម្ដង ។ គ្រាន់តែ បាន ឃើញ ភ្លាម អ្នកនាង រួម ជាមួយនឹង ស្វាមី ត្រេកអរ ជាខ្លាំង ហើយក៏ បាន យក ទៅ បង្ហាញ អ្នកលក់ ព្រមទាំង ទូរស័ព្ទ ផ្តល់ ដំណឹង ដល់ ក្រុមហ៊ុន តាមរយៈ លេខ ទូរស័ព្ទ ដែល មាន នៅនឹង គម្រប ដប ស្រាប់ ។
ដំណើរ ឆ្ពោះ ទៅ ការប្រារព្ធ ខួប ២០ ឆ្នាំ នៃ សន្តិភាព នៅ កម្ពុជា និង ការសម្ពោធ វិមាន ឈ្នះ ឈ្នះ ( វគ្គ ទី១ )
២០ ឆ្នាំ ក្រោយមក កម្ពុជា បាន សប្បាយរីករាយ នឹង ផ្លែ ផ្កា នៃ សន្តិភាព និង ទទួលអំណរ សាទរ សមិទ្ឋ ផលប្រវត្តិសាស្រ្ត នៃ វិមាន ឈ្នះ ឈ្នះ ដែល ត្រូវបាន កសាង រួចស្រេច ជា ស្ថាពរ នៅក្នុង ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ហើយ គ្រោង នឹង សម្ពោធ ជា ផ្លូវការ នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៨ ( សម្រាប់ រយៈពេល ៣ ថ្ងៃ ) នៅ មហាវិថី ឈ្នះ - ឈ្នះ ទល់ មុខ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ថ្មី ឈ្មោះ « មរតក តេជោ » នៅ តំបន់ អភិវឌ្ឍន៌ លី យ៉ុង ផាត់ ។
ចង ក្រង ដោយ៖ ចៅ ចាក់ ស្មុក រាជធានី ភ្នំពេញ ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុន្នីរ័ត្ន បង្ហាញ សុទិដ្ឋិនិយម ចំពោះ សមិទ្ធផល និង វឌ្ឍនភាព លើ វិស័យ ពាណិជ្ជកម្ម
( ភ្នំពេញ ) ៖ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន បង្ហាញ សុទិដ្ឋិនិយម ខ្ពស់ ចំពោះ សមិទ្ធផល ការងារ ឆ្នាំ ២០១៨ របស់ ក្រសួង ពាណិជ្ជកម្ម ដែល បាន រួមចំណែក ពង្រីក វិស័យ នាំចេញ របស់ កម្ពុជា ឱ្យ សម្រេចបាន ទំហំ ជាង ៦០ % នៃ ផលិតផល ក្នុង ស្រុក សរុប ( ផ.ស. ស) ។
ថ្លែង ក្នុង ពិធី បិទ សន្និបាត បូកសរុប ការងារ ពាណិជ្ជកម្ម ឆ្នាំ ២០១៨ និង ទិសដៅ អនុវត្តន៍ ការងារ ឆ្នាំ ២០១៩ ដែល រៀបចំឡើង នៅ ទីស្តីការ ក្រសួង ពាណិជ្ជកម្ម នៅ ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន បង្ហាញ មោទនភាព ខ្ពស់ ចំពោះ វឌ្ឍនភាព នៃ ទំហំ ពាណិជ្ជកម្ម របស់ កម្ពុជា ដែល មាន កំណើន រៀងរាល់ ឆ្នាំ ជាក់ស្តែង នៅក្នុង ឆ្នាំ នេះ ទឹកប្រាក់ នាំចេញ ក្រោម ប្រព័ន្ធ អនុគ្រោះ ពន្ធ មាន ចំនួន ១៣ ពាន់ លាន ដុល្លារ អាមេរិក កើនឡើង ប្រមាណ ១៨ % បើ ធៀប នឹង ឆ្នាំ ២០១៧ ។
លោក អូន ព័ន្ធ មុនីរ័ត្ន « កំណើន ពាណិជ្ជកម្ម គួរឱ្យ កត់សម្គាល់ នេះ មិន អាច កាត់ផ្តាច់ បាន ពី ការរួមចំណែក យ៉ាង សកម្ម របស់ មន្រ្តី គ្រប់ ជាន់ ថ្នាក់ នៃ ក្រសួង ពាណិជ្ជកម្ម តាមរយៈ ការខិតខំ ធ្វើ សកម្មភាព ពាណិជ្ជកម្ម ទាំង នៅក្នុង ប្រទេស និង នៅលើ ឆាក អន្តរជាតិ » ។
លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ក៏ បាន ជម្រាប ជូន ពី ទិសដៅ ការងារ សំខាន់ ៗ មាន លក្ខណៈ ប្រទាក់ ក្រឡា និង គ្រប់ ជ្រុងជ្រោយ ដែល ក្រសួង ត្រូវ បន្ត អនុវត្តន៍ ក្នុង ឆ្នាំ ២០១៩ សំដៅ ប្រែក្លាយ វិស័យ ពាណិជ្ជកម្ម ទៅជា វិស័យ ឈាន មុខ សម្រាប់ ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ ស្រប តាម កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៦ នៃ រដ្ឋសភា ។
សូម ជម្រាប ថា តាមរយៈ កិច្ចប្រឹងប្រែង របស់ ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា បាន ទទួល ជោគជ័យ លើ ការបើក ទីផ្សារ និង នាំចេញ ទំនិញ ទៅកាន់ ប្រទេស ចំនួន ១៤៧ ក្នុង ពិភពលោក ។ ជាមួយគ្នា នេះ ទំហំ នៃ ការផ្លាស់ប្តូរ ពាណិជ្ជកម្ម របស់ កម្ពុជា នៅក្នុង ឆ្នាំ ២០១៨ ជាមួយ បណ្តា ប្រទេស នានា សម្រេចបាន ទំហំ ទឹកប្រាក់ ២៤. ៩៨៥ លាន ដុល្លារ អាមេរិក គឺ បាន កើនឡើង ប្រមាណ ៥% បើ ធៀប នឹង ឆ្នាំ ២០១៧ ដែល មាន ទឹកប្រាក់ ត្រឹម ២៣.៧៩៦ លាន ដុល្លារ អាមេរិក ៕
ពាក់ព័ន្ធ នឹង សំណុំរឿង នេះ មាន មតិ រិះគន់ ជាច្រើន ពី មន្ត្រីរាជការ រួមទាំង ឧត្តម មន្ត្រី របស់ កម្ពុជា ផង ថា លោក Willaim Guang ដែល ជា សមាជិក ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ មាន ឋានៈ ស្មើនឹង ទេសរដ្ឋមន្ត្រី ត្រាស់បង្គាប់ តែងតែ ដោយ ព្រះព្រះមហាក្សត្រ កំពុង ធ្វើឲ្យ ប៉ះពាល់ ដល់ កិត្តិយស កិត្តិនាម និង សេចក្តីថ្លៃថ្នូរ របស់ ឧត្តម មន្ត្រី ។
គួរ បញ្ជាក់ ថា អង្គការ សហ ប្រជាជាតិ និង បណ្ដា ប្រទេស លោក ខាងលិច បាន ជំរុញ ឱ្យ ប្រទេស លីប៊ី រៀបចំ ការបោះឆ្នោត សកល នៅ ឆ្នាំ ២០១៩ ខាងមុខ សំដៅ បិទ បញ្ចប់ ជម្លោះ អស់ រយៈពេល ជាង ៧ឆ្នាំ មក នេះ ពោលគឺ ក្រោយ របប ដឹកនាំ លោក Gaddafi ដួលរលំ កាលពី ឆ្នាំ ២០១១ ដោយ នាំយក ទៅ ជាមួយ នូវ ភាពរុងរឿង ដែល ប្រជាជន លីប៊ី ធ្លាប់ មាន ៕
១៖ វិសោធនកម្ម ច្បាប់ គណបក្ស នយោបាយ ដែល អាច បើក សិទ្ធិ ឲ្យ អ្នកនយោបាយ ជាប់ បម្រាប មាន សិទ្ធិ ធ្វើ នយោបាយ ឡើងវិញ បាន ឆ្លង ផុត ព្រឹទ្ធសភា ហើយ ( ចុច អាន )
២៖ ព្រឹទ្ធសភា ប្រកាស លទ្ធផល សម័យ ប្រជុំ លើក ទី២ នីតិកាល ទី៤ ដែល ពិនិត្យ និង ឱ្យ យោបល់ លើ សេចក្តីស្នើ ច្បាប់ ដែល អាច បើក ផ្លូវ ឱ្យ អ្នកនយោបាយ មាន សិទ្ធិ ធ្វើ នយោបាយ ឡើងវិញ ( ចុច អាន )
៨៖ រដ្ឋមន្ត្រី ការពារ ជាតិ វៀតណាម . ឡាវ . ថៃ និង អគ្គ នាយកដ្ឋាន សហប្រតិបត្តិការ យោធា អន្តរជាតិ ចិន នឹង មក ទស្សនកិច្ចព្រម គ្នា នៅ កម្ពុជា ដើម្បី សម្ពោធ វិមាន ឈ្នះ ឈ្នះ ( ចុច អាន )
៩៖ សមាជិក សភា សាធារណរដ្ឋ កូរ៉េ៖ ប្រទេស កម្ពុជា នឹង ក្លាយទៅជា ប្រទេស កាន់តែ ជឿនលឿន ឆាប់ ៗ ខាងមុខ នេះ ( ចុច អាន )
១៖ ក្រុម ខ្មាន់ កាំភ្លើង វាយប្រហារ អគារ ក្រសួង ការបរទេស លីប៊ី ស្ថិត នៅក្នុង ទីក្រុង ទ្រី ប៉ូលី ( ចុច អាន )
៣៖ ឥណ្ឌូណេស៊ី ត្រូវការ ជំនួយ សង្គ្រោះ បន្ទាន់ ជាច្រើន ដើម្បី ជួយ ដល់ ជនរងគ្រោះ ធ្ងន់ធ្ងរ ក្រោយ រលក យក្ស ស៊ូណាមិ ផ្តាច់ ជីវិត មនុស្ស ជិត ៤០០ នាក់ ( ចុច អាន )
៤៖ ប្រធានាធិបតី ឥណ្ឌូណេស៊ី បញ្ជា ឱ្យ ទីភ្នាក់ងារ ជាតិ ទិញ ប្រព័ន្ធ ប្រកាស អាសន្ន ក្រោយ រលក យក្ស ស៊ូណាមិផ្ដាច់ ជីវិត មនុស្ស ៣៧៣ នាក់ ( ចុច អាន )
៨៖ អ៊ីស្រាអែល នឹង រៀបចំ ការបោះឆ្នោត សកល មុន អណត្តិ នៅ ខែមេសា ឆ្នាំ ២០១៩ ខាងមុខ ( ចុច អាន )
៩៖ តុលាការ ទីក្រុង វ៉ាស៊ីនតោន បង្គាប់ ឱ្យ កូរ៉េ ខាងជើង សង ប្រាក់ ៥០១ លាន ដុលា្លរ ជា ការទទួលខុសត្រូវ លើ ការស្លាប់ របស់ និស្សិត អាមេរិក ម្នាក់ ( ចុច អាន )
១១៖ ចិន សម្រេច ទិញ សណ្តែក សៀង ពី ប្រទេស ធំ មួយ ភ្លាម ៗ ក្រោយ ផ្អាក ការនាំចូល ពី សហរដ្ឋ អាមេរិក ដោយសារតែ សង្គ្រាម ពាណិជ្ជកម្ម ( ចុច អាន )
គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត ជូនដំណឹង អំពី ការប្រកួតប្រជែង « ទីក្រុង ដែល មាន ពិធី បុណ្យ ឆ្លង ឆ្នាំ សកល ល្អ ជាង គេ ប្រចាំ ឆ្នាំ »
យោង តាម សេចក្តីជូនដំណឹង របស់ លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត បាន ឲ្យដឹង ថា កម្មវិធី ប្រកួតប្រជែង នេះ ធ្វើឡើង ដោយ ផ្អែក លើ លក្ខណៈ ពិសេស មួយចំនួន ដូចជា ការតុបតែង លម្អ អនាម័យ និង បរិស្ថាន សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ ភាព ពេញចិត្ត និង ការសប្បាយរីករាយ របស់ ភ្ញៀវ ទេសចរ និង អ្នកចូលរួម ។
( កំពង់ស្ពឺ ) ៖ អភិបាល ខេត្ត កំពង់ស្ពឺ លោក វ៉ី សំណាង នៅ រសៀល ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ចែក អំណោយ ជា សម្ភារ ប្រើប្រាស់ ក្នុង ផ្ទះ ជូន កម្មករ កម្ម ការិនី ប្រមាណ ២. ០០០នាក់ នៅ រោងចក្រ ហី រូតា ដែល មាន ទីតាំង ស្ថិត នៅ ឃុំ វល្លិស ស្រុក សំរោងទង ។
ក្នុង ឱកាស នោះ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ថ្លែង ថា ដោយ កត្តា សន្តិភាព និង ដោយ មាន ការយកចិត្តទុកដាក់ ពី រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ទើប បងប្អូន កម្មករ កម្មាការិនី មាន ឱកាស បាន ជួបជុំគ្នា គ្រប់ កម្មវិធី ជាតិ ធំ ៗ និង បុណ្យ អន្តរជាតិ ជាច្រើន ផងដែរ ។
លោក អភិបាល បន្ត ថា ដោយសារតែ ការអភិវឌ្ឍ និង មាន សន្តិភាព ពេញលេញ បាន ធ្វើ យើង ទាំងអស់ គ្នា មាន ការងារ ធ្វើ ទទួលបាន ផល កម្រៃ បៀរវត្សន៍ ខ្ពស់ រស់ នៅ ដោយ ភាព សម្បូរសប្បាយ សុខដុមរម្យ នា ជា ការពិត សព្វ ថ្ងៃ មាន សម្ភារ ពេញនិយម ប្រើប្រាស់ គ្រប់ លំនៅដ្ឋាន កត្តា នេះ រាជ រដ្ឋាភិបាល ទាមទារ ចាំបាច់ ត្រូវ កសាង បន្ថែម គ្រប់ ហេដ្ឋារចនាសម័ន្ធ ដើម្បី តម្រូវ ការចាំបាច់ ជូន ពលរដ្ឋ ៕
( ភ្នំពេញ ) ៖ ថ្លែង ក្នុង ពិធី បិទ បញ្ចប់ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៨ និង លើក ទិសដៅ ឆ្នាំ ២០១៩ នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន ក្រើន រំលឹក មន្ត្រី ក្រោម ឱវាទ របស់ ខ្លួន ឲ្យ គិតគូរ ឡើងវិញ ពី ឥរិយាបទ នៅក្នុង ការផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន ប្រាប់ ឲ្យ មន្ត្រី ត្រូវ បម្រើ ប្រជាពលរដ្ឋ មក រក សេវា ឲ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ព្រោះ នេះ គឺជា ភារកិច្ច និង ជា តម្លៃ នៃ ការងារ របស់ មន្ត្រីរាជការ គ្រប់ ៗ រូប ដែល ត្រូវតែ ធ្វើ ការងារ នោះ ដោយ មិន ខ្លាច នឿយហត់ ឡើយ ។ មន្ត្រីរាជការ គ្រប់ ក្រសួង ស្ថាប័ន និង អង្គភាព ទាំងអស់ មិន ត្រូវ ធ្វើ សកម្មភាព ទាំងឡាយ ណា ដែល ធ្វើឲ្យ ប្រជាពលរដ្ឋ បាក់ទឹកចិត្ត លែង ចង់ មក ប្រើ សេវា សាធារណៈ បន្ត ទៀត នោះ ទេ ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ឥរិយាបទ ដែល ចាត់ទុក ថា យើង ជា មន្ត្រី ផ្តល់ សេវា ច្រើន ជូន ដល់ ប្រជាពលរដ្ឋ សូមឲ្យ ឥរិយាបទ សម្តី សម្តៅ គ្រប់ បែបយ៉ាង មេត្តា គិតគូរ ថ្លឹងថ្លែង ថា ឪពុក យើង ម្តាយ យើង លោកយាយ យើង គាត់ ទៅ រក សេវា មេត្តា ហៅ រក ឲ្យបាន មុន និង ផ្តល់ ការគាំទ្រ និង លើកទឹកចិត្ត របស់ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ ផ្តល់ សេវា ជូន គាត់ ឲ្យ គាត់ សប្បាយរីករាយ ដោយ ចាត់ទុក ថា ទោះបី ហត់នឿយ ប៉ុណ្ណា គឺ យើង ស៊ូ ជា ភារកិច្ច ជា មោទនភាព ដែល រាជ រដ្ឋាភិបាល ប្រគល់ ភារកិច្ច នេះ ឲ្យ យើង »៕
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ សារលិខិត ថ្លែងអំណរ ព្រះរាជ គុណ ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃអង្គារ ៣រោច ខែមិគសិរ ឆ្នាំ ច សំរឹទ្ធ ស័ក ព .ស . ២៥៦២ ត្រូវនឹង ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ផ្ញើ សារលិខិត ថ្លែងអំណរ ព្រះរាជ គុណ ព្រះករុណា ព្រះមហាក្សត្យ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
សារលិខិត ថ្លែងអំណរ ព្រះរាជ គុណ នោះ មាន ខ្លឹមសារ ថា៖
« ខ្ញុំ ម្ចាស់ ព្រមទាំង សហការី ទាំងអស់ នៃ កាកបាទ ក្រហម កម្ពុជា មាន សេចក្ដីរីករាយ ឥត ឧបមា ដោយ បាន ទទួល នូវ ព្រះរាជ ទ្រព្យ ចំនួន ១.០០០ ដុល្លារ អាមេរិក របស់ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជូបត្ថម្ភ ចំពោះ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ខែធ្នូ ឆ្នាំ ២០១៨ តាមរយៈ សម្ដេច ចៅហ្វា វាំង គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង ។
រដ្ឋសភា ធ្វើ វិសោធនកម្ម ច្បាប់ ស្តីពី ការបោះឆ្នោត ក្រុមប្រឹក្សា រាជធានី / ខេត្ត ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា បាន បើក កិច្ចប្រជុំ មួយ ក្រោម អធិបតីភាព សម្តេច ពញ្ញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៃ កម្ពុជា ដើម្បី ពិនិត្យ ចំពោះ សេចក្តីស្នើ ច្បាប់ ស្តីពី វិសោធនកម្ម ស្តីពី ការបោះឆ្នោត ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋសភា ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
បន្ទាប់ពី បាន ពិភាក្សា លើ របៀបវារៈ ខាងលើ នេះ អង្គប្រជុំ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា បាន សម្រេច ប្រគល់ សេចក្តីស្នើ ច្បាប់ ស្តីពី វិសោធនកម្ម ស្តីពី ការបោះឆ្នោត ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ ដែល ជា សំណើ របស់ ក្រុមប្រឹក្សា តំណាងរាស្រ្ត ហត្ថលេខី ចំនួន ៩២ រូប ដល់ គណៈកម្មការ នីតិកម្ម និង យុត្តិធម៌ នៃ រដ្ឋសភា ធ្វើ ការពិនិត្យ និង សិក្សា ហើយ ធ្វើ របាយការណ៍ ជូន គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា វិញ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ រដ្ឋសភា អំពី លទ្ធផល នៃ កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា នៅ ថ្ងៃ នេះ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៥ ខែ ធ្នូ៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៧៥១ គ្រឿង និង ផាក ពិន័យ ៤៦២ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៥.៧៦៧ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៧៥១ គ្រឿង ( ម៉ូតូ ៧៤ %) អប់រំ២៨៩ គ្រឿង និង ផាក ពិន័យ ៤៦២ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៥ ខែធ្នូ នេះ ត្រួតពិនិត្យ បាន ចំនួន ៤. ០៩៩ គ្រឿង . អប់រំ១៦២ គ្រឿង និង ផាក ពិន័យ ៣៥៧ គ្រឿង ។
អភិបាល ខេត្ត កំពង់ចាម៖ គ្រប់ ផ្សារ ទាំងអស់ មិន ត្រូវ ភាស៊ី លើស កំណត់ នោះ ទេ ហើយ ត្រូវ រៀបចំ សណ្តាប់ធ្នាប់ អនាម័យ ឲ្យបាន ល្អ
( កំពង់ចាម ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត កំពង់ចាម ប្រាប់ ឲ្យ គណៈ អាជីវករ ផ្សារ ទាំងអស់ ក្នុង ខេត្ត ត្រូវ រៀបចំ ការគ្រប់គ្រង ឲ្យបាន ល្អ នៅក្នុង ឋានានុក្រម របស់ ខ្លួន ហើយ ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការថែទាំ សណ្តាប់ធ្នាប់ អនាម័យ ឲ្យបាន ល្អ ។ ដោយឡែក ការទារ ភាស៊ី ត្រូវតែ គោរព ទៅ តាម សៀវភៅ បន្ទុក និង ចូលរួម អភិវឌ្ឍ នៅ តាម ផ្សារ របស់ ខ្លួន ឲ្យបាន ល្អ ប្រសើរ ។
លោក អភិបាល ខេត្ត បាន ថ្លែង យ៉ាង ដូចនេះ ទៅកាន់ បងប្អូន គណៈ អាជីវករ នា ព្រឹក ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នៅ សាល ប្រជុំ សាលា ខេត្ត កំពង់ចាម ក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ ឡើងវិញ លើ ការអនុវត្ត និង ការគ្រប់គ្រង ផ្សារ គ្រប់ ប្រភេទ នៅ ទូទាំង ខេត្ត កំពង់ចាម ។
ជាង នេះ ទៅ ទៀត ត្រូវ មាន ការអភិវឌ្ឍ បន្ថែម នូវ ចំណុច ខ្វះខាត ក្នុង ផ្សារ របស់ ខ្លួន ផងដែរ ព្រោះ ផ្សារ ទាំងអស់ អាជ្ញាធរ ខេត្ត បាន ប្រគល់ឲ្យ គណៈ អាជីវករ ជា អ្នកគ្រប់គ្រង ហើយ ដែល ថវិកា ចំណូល ទាំងអស់ គឺ សម្រាប់ ធ្វើ ការចំណាយ លើ ការថែទាំ សណ្តាប់ធ្នាប់ អនាម័យ និង ការអភិវឌ្ឍ នៃ ផ្សារ ដែល បងប្អូន គ្រប់គ្រង ។
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ដាក់ចេញ ទិសដៅ ការងារ ពាណិជ្ជកម្ម ឆ្នាំ ២០១៩ ដើម្បី យក ទៅ អនុវត្ដ ក្នុង គោលបំណង អភិវឌ្ឍ ការងារ ពាណិជ្ជកម្ម ឲ្យ កាន់តែ ប្រសើរឡើង ក្រោយ បញ្ចប់ សន្និបាត បូកសរុប ការងារ ពាណិជ្ជកម្ម ឆ្នាំ ២០១៨ និង ទិសដៅ ការងារ ឆ្នាំ ២០១៩ នា រសៀល ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ។
ខាងក្រោម នេះ ជា ទិសដៅ ការងារ ពាណិជ្ជកម្ម ឆ្នាំ ២០១៩ ដែល ចេញ ដោយ ក្រសួង ពាណិជ្ជកម្ម៖ ចិន៖ ចោរប្លន់ រថយន្តក្រុង រួច ជិះ ទៅ បុក រះ លើ អ្នកដំណើរ តាម ផ្លូវ បណ្តាលឲ្យ ស្លាប់ ០៥ នាក់ និង របួស ២១ នាក់
បើ តាម មន្ត្រី ប៉ូលិស ចិន នៅ ហ្នឹង កន្លែង កើត ហេតុ បាន ឲ្យដឹង ថា ជនសង្ស័យ ត្រូវបាន ចាប់ខ្លួន និង បញ្ជូន ទៅ ប៉ុស្តិ៍ ប៉ូលិស រួចហើយ ដើម្បី ធ្វើ ការសាកសួរ ។ ករណី ប្លន់ រថយន្តក្រុង បែប នេះ គឺជា រឿង កម្រ បំផុត មួយ នៅក្នុង ប្រទេស ចិន ព្រោះ រថយន្តក្រុង មាន ទំហំ ធំ និង ពិបាក ណាស់ ក្នុង ការបើក គេច ចេញ ទៅ ណា ឆ្ងាយ ដើម្បី គេច ពី សមត្ថកិច្ច ៕
អភិបាល ខេត្ត ពោធិ៍សាត់៖ ច្បាប់ មាន ប្រសិទ្ធភាព ឬ គ្មាន ប្រសិទ្ធភាព គឺ ផ្តើម ចេញ ពី កត្តា មនុស្ស មិន មែន ផ្តើម ចេញ ពី អ្នកតាក់តែង ច្បាប់ នោះ ទេ
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន ខេត្ត បាន ថ្លែង ថា ច្បាប់ មាន ប្រសិទ្ធភាព ឬ គ្មាន ប្រសិទ្ធភាព គឺ ផ្តើម ចេញ ពី កត្តា មនុស្ស មិន មែន ផ្តើម ចេញ ពី អ្នកតាក់តែង ច្បាប់ នោះ ទេ ដូច្នេះ កត្តា មនុស្ស គឺជា កត្តា កំណត់ ។
លោក ម៉ៅ ធ និន បាន ថ្លែង ទៀត ថា ក្នុង នាម មន្ត្រី នគរបាល នៅក្នុង មូលដ្ឋាន ត្រូវ ចាកចេញ ឲ្យ ផុត ពី ការបង្ក លក្ខណៈ ឲ្យ បទល្មើស គ្រឿងញៀន កើតឡើង ត្រូវ ចូលរួម ត្រួតពិនិត្យ មុខ សញ្ញា ជួយ ដូរ ថា តើ វា កើត ចេញ ពី ចំណុច ណា ។
លោក បាន សង្កត់ធ្ងន់ ថា ច្បាប់ មាន ប្រសិទ្ធភាព ឬ គ្មាន ប្រសិទ្ធភាព គឺ ផ្តើម ចេញ ពី កត្តា មនុស្ស មិន មែន ផ្តើម ចេញ ពី អ្នកតាក់តែង ច្បាប់ នោះ ទេ ដូច្នេះ កត្តា មនុស្ស គឺជា កត្តា កំណត់ ក្នុង ការអនុវត្ត ច្បាប់ បើ មនុស្ស មិន មុត ស្រួច គ្មាន ឆន្ទះ គ្មាន មន សិក្កា គ្មាន ក្រមសីលធម៌ និង គ្មាន ភាព ចាស់ទុំ ទេ នោះ មាន ច្បាប់ គឺ នៅតែ ឥត ប្រយោជន៍ ដែរ ហើយ ការអនុវត្តន៍ ច្បាប់ គឺ ត្រូវ ឈរ នៅលើ មូលដ្ឋាន សុក្រឹត និង យុត្តិធម៌ ។
លោក បាន ជំរុញ ឲ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច ជាពិសេស មន្ត្រី នគរបាល យុត្តិធម៌ នៅ មូលដ្ឋាន ត្រូវ បន្ត ពង្រឹង សមត្ថភាព របស់ ខ្លួន ដោយ អនុវត្តន៍ ច្បាប់ ទៅ តាម ក្រមសីលធម៌ ភាព ជា ចាស់ទុំ ប្រើប្រាស់ ភ្នែក ឲ្យបាន ច្រើន ជាង ត្រចៀក មាន ជំហរ សុក្រឹត និង យុត្តិធម៌ ធ្វើ យ៉ាងណា ឲ្យ មូលដ្ឋាន មាន ភាពស្ងប់ស្ងាត់ គ្មាន ការចរាចរណ៍ និង ប្រើប្រាស់ គ្រឿងញៀន ។
ក្នុង នាម ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត លោក មិន ចង់បាន របាយការណ៍ ដែល ពាក់ព័ន្ធ នឹង សកម្មភាព នៃ ការបង្ក្រាប បទល្មើស គ្រប់ ប្រភេទ នោះ ឡើយ ពោលគឺ ចង់បាន តែ របាយការណ៍ នៃ ភាពស្ងប់ស្ងាត់ ដែល មូលដ្ឋាន នោះ ទទួលបាន ក្រៅពី ភាព សុខសាន្ត របស់ ប្រជាពលរដ្ឋ ។
លោក បាន បន្ថែម ទៀត ថា អំណាច ដែល មាន ត្រូវ ប្រើប្រាស់ ឲ្យ អស់ លទ្ធភាព ក្នុង ការដាក់ទោស បុគ្គល ដែល ប្រព្រឹត្ត ផ្ទុយ នឹង ច្បាប់ និង ត្រូវ ប្រើប្រាស់ ភ្នែក ឲ្យបាន ច្រើន ជាង ត្រចៀក ដោយ មិន ជ្រក ក្រោម ដំបូល របស់ បទល្មើស នោះ ឡើយ ។
លោក បាន បន្ត ថា ស្រុក មាន សុខ សន្តិភាព ពេញលេញ មកដល់ ពេលនេះ គឺ ដោយសារ សម្តេច តេជោ បាន យក ជីវិត មក ប្តូរ ដើម្បីឲ្យ មាតុភូមិ យើង សុខសាន្ត ក៏ប៉ុន្តែ ពុក ម៉ែ ប្រជាពលរដ្ឋ បែរជា មិន បាន សុខ ដោយសារតែ គ្រឿងញៀន ។ ដូច្នេះ ត្រូវ ចូលរួម លុបបំបាត់ ការចរាចរណ៍ និង ប្រើប្រាស់ គ្រឿងញៀន ឲ្យបាន ទាំងអស់ ស្រប តាម គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ទាំង ៩ចំណុច ៕ រន្ធត់ ណាស់ ! ជិះ ម៉ូតូ លឿន ជ្រុល ចង្កូត ទៅ បុក រថយន្ត ដឹក ដី ធុន ធំ បណ្ដាល ស្លាប់ ម្នាក់ និង របួស ធ្ងន់ ២នាក់ នៅ ខណ្ឌ ឫស្សីកែវ
( ភ្នំពេញ ) ៖ យុវជន និង យុវតី ៣ នាក់ បាន ជិះ ម៉ូតូ មួយ គ្រឿង ក្នុង ល្បឿន យ៉ាង លឿន ជ្រុល ចង្កូត ទៅ បុក ជាមួយ រថយន្ត ដឹក ដី ធុន ធំ បណ្ដាលឲ្យ ស្លាប់ ម្នាក់ និង រងរបួស ធ្ងន់ ២នាក់ ត្រូវបាន ដឹក យក ទៅ សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ កាល់ម៉ែត្រ ។ ហេតុការណ៍ នេះ កើតឡើង នៅ រសៀល ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០១៨ ស្ថិត នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៥ ក្នុង សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។
សេចក្ដីរាយការណ៍ ពី ភ្នាក់ងារ Fresh News បាន បញ្ជាក់ ថា ជនរងគ្រោះ ដែល បាត់បង់ជីវិត ឈ្មោះ ហម រតនៈ ភេទ ប្រុស អាយុ ១៧ ឆ្នាំ មុខរបរ នៅ ផ្ទះ ស្នាក់ នៅ ភូមិ ព្រែក ព្នៅ សង្កាត់ ព្រែក ព្នៅ ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ ។ ចំណែកឯ យុវតី ចំនួន ២នាក់ ទៀត មិន ត្រូវបាន ស្គាល់ អត្តសញ្ញាណ ឡើយ ។
លុះ មកដល់ ចំណុច ផ្លូវ ជាតិ លេខ ៥ រថយន្ត ខាងលើ បាន បត់ ឆ្វេង ដៃ ភ្លាម ៗ នោះ ស្រាប់តែ ឃើញ យុវជន ៣នាក់ ជិះ ម៉ូតូ ក្នុង ល្បឿន យ៉ាង លឿន ក៏ ជ្រុល ចង្កូត ទៅ បុក ពាក់កណ្ដាល រថយន្ត យ៉ាង ពេញ ទំហឹង បណ្ដាលឲ្យ យុវជន ម្នាក់ ស្លាប់ នៅនឹង កន្លែង កើត ហេតុ ចំណែកឯ យុវតី ២នាក់ ទៀត ត្រូវបាន សមត្ថកិច្ច ហៅ រថយន្ត សង្គ្រោះ បន្ទាន់ ដឹក យក ទៅកាន់ មន្ទីរពេទ្យ កាល់ម៉ែត ដើម្បី ជួយសង្គ្រោះ ។ ក្រោយពី កើត ហេតុ ម្ចាស់ រថយន្ត បង្ក បាន រត់គេចខ្លួន បាត់ ដោយ បន្សល់ទុក តែ រថយន្ត នៅ និង កន្លែង កើត ហេតុតែ ប៉ុណ្ណោះ ។
ក្រោយពេល កើត ហេតុ កម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ ឬស្សីកែវ បាន ចុះ មកដល់ ទីតាំង កើត ហេតុ និង បាន ទំនាក់ទំនង ហៅ សមត្ថកិច្ច ជំនាញ ផ្នែក ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ចុះ មក ធ្វើ ការវាស់វែង និង នាំយក រថយន្ត បង្ក និង ម៉ូតូ រងគ្រោះ យក ទៅ រក្សាទុក នៅ ការិយាល័យ ជំនាញ ដើម្បី រង់ចាំ ធ្វើការដោះស្រាយ ។
ចំណែកឯ សាកសព ជនរងគ្រោះ ខាងលើ ត្រូវ សមត្ថកិច្ច ធ្វើ កំណត់ហេតុ ប្រគល់ឲ្យ ទៅ ក្រុមគ្រួសារ សាច់ញាតិ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី នៅឯ គេហដ្ឋាន ៕ ពលរដ្ឋ នៅ សង្កាត់ អូរឬស្សី ក្រុង ក្រចេះ សំណូមពរ ឱ្យ អាជ្ញាធរ ចាត់ វិធានការ ទប់ស្កាត់ ក្លិន ស្អុយ ហូរ ចេញ ពី រោងចក្រ ស៊ិង សុង អ៊ិន ដាស ស្ទ្រៀល
ដោយសារតែ ការពិបាក ទ្រាំ នូវ ក្លិន ស្អុយ នេះ ពេក ហើយ ខ្លាច ប្រឈមមុខ នឹង ជម្ងឺ ផង នោះ ទើប ពួក គាត់ បាន សម្រេចចិត្ត សំណូមពរ ឲ្យ អាជ្ញាធរ ជួយ រក វិធានការ ទប់ស្កាត់ ពី ផល ប៉ះពាល់ និង ទុក្ខលំបាក របស់ ពួកគាត់ ព្រោះ ក្លិន ទាំងនេះ បណ្ដាលឲ្យ ប៉ះពាល់ ដល់ បរិស្ថាន និង ប៉ះពាល់ សុខភាព យ៉ាង ខ្លាំង ។
( ភ្នំពេញ ) ៖ លោក រស់ មុនិន្ទ ប្រធាន មជ្ឈមណ្ឌល ជាតិ នៃ មជ្ឈត្ត ការ ផ្នែក ពាណិជ្ជកម្ម បាន ចេញមក ពន្យល់ យ៉ាង លម្អិត ជុំវិញ លក្ខណៈ ពិសេស ជាច្រើន ដល់ សាធារណជន ពាណិជ្ជករ ក្នុង ការដោះស្រាយ ជម្លោះ ពាណិជ្ជកម្ម តាម យន្តការមជ្ឈត្តការ ។
