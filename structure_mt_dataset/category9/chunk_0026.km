( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ បាន ដឹកនាំ ក្រុមការងារ ចុះអន្តរាគមន៍ ដាក់ ម៉ាស៊ីន បូម ទឹក ដើម្បី ជួយសង្គ្រោះ ស្រូវ ប្រាំង ប្រមាណ ១២០០ ហិកតា ស្ថិត នៅ ភូមិ ព្រៃ ព្រះ ភូមិ ចុង ព្រៃ ភូមិ ត្នោត និង ភូមិ តា ប៉ោង ឃុំ កំពង់ស្វាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ដែល ជួប គ្រោះ រាំងស្ងួត ។
ជាមួយគ្នា នេះ ដែរ លោក សុខ លូ និង ក្រុមការងារ គ្រោង ដាក់ ម៉ាស៊ីន បូម ទឹក ធុន ធំ ចំនួន ០៦ គ្រឿង ដើម្បី បូម ទឹក ស្ទឹង សែន ដាក់ តាម បឹង និង ប្រឡាយ ដែល អាច ឱ្យ ប្រជាពលរដ្ឋ បូម បន្ត ទៅ ជួយសង្គ្រោះ ស្រូវ ប្រាំង ដែល កំពុងតែ ជួប បញ្ហា ខ្វះ ទឹក ។
លោក សុខ លូ បាន លើកឡើង ថា ម៉ាស៊ីន ធុន ធំ ចំនួន ២គ្រឿង របស់ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង ម៉ាស៊ីន មួយ គ្រឿង ទៀត ដែល ជា ការ ជួយ ឧបត្ថម្ភ ដោយ សម្ដេច តេជោ ហ៊ុន សែន បាន នឹង កំពុង បូម ទឹក ដាក់ ទៅ តាម បឹង ប្រឡាយ មេ ដើម្បីឱ្យ បងប្អូន ប្រជាពលរដ្ឋ បូម បន្ត សម្រាប់ យក ទៅ ប្រើប្រាស់ តែ នៅ មិន ទាន់ គ្រប់គ្រាន់ នៅឡើយ អភិបាល ខេត្ត បាន ឱ្យ មន្ទីរ ធនធាន ទឹក បន្ថែម ម៉ាស៊ីន ធន់ ធំ ចំនួន បី គ្រឿង បន្ថែម ទៀត ដើម្បី ពន្លឿន ការបូម ទឹក សង្គ្រោះ ស្រូវ ប្រាំង ឱ្យ បាន ទាន់ ពេលវេលា ផងដែរ ។
លោក សុខ លូ បាន បញ្ជាក់ ថា ប្រភព ទឹក ដែល សំខាន់ សម្រាប់ កសិករ នៅ តំបន់ នេះ គឺ ទឹក ស្ទឹង សែន ប៉ុន្តែ វា នៅ ឆ្ងាយ បន្តិច ហើយ ម្យ៉ាង វិញ ទៀត ដោយសារ ទឹក ស្ទឹង សែន ឆ្នាំ នេះ តូច ពេក មិន ហៀរ ទៅដល់ បឹងបួរ ផ្សេង ៗ ផង នោះ ធ្វើឱ្យ ប្រភព ទឹក ដែល ជា តម្រូវការ ប្រើប្រាស់ លើ ការងារ ស្រែ ចម្ការ មិន គ្រប់គ្រាន់ ដូច ឆ្នាំ មុន ៗ នោះ ទេ ។ ដូច្នេះ ដំណោះស្រាយ ដំបូង គឺ បូម ទឹក ស្ទឹង សែន ដាក់ ចូល ប្រភព ប្រឡាយ ទឹក ផ្សេង ៗ ដើម្បីឱ្យ កសិករ បូម បន្ត ទៅកាន់ ស្រែ រៀង ៗ ខ្លួន ។
ប្រជាកសិករ បាន សំដែង នូវ ភាពរីករាយ ដែល បាន អាជ្ញាធរ ក៏ ដូចជា ថ្នាក់ដឹកនាំ ខេត្ត យកចិត្តទុកដាក់ ក្នុង ការជួយ ស្រោចស្រព ស្រូវ របស់ ពួកគាត់ ឱ្យ បាន ទាន់ ពេលវេលា ព្រោះ ថា ស្រូវ របស់ គាត់ ទើបតែ ដាក់ ទឹក លើក ទី មួយ ហើយ ស្រូវ របស់ គាត់ នឹង បន្ត ដាក់ ទឹក នៅលើក ទី ពីរ ឬ លើក ទី បី ទៀត ។
ជាមួយគ្នា នេះ ដែរ ប្រជាពលរដ្ឋ ក៏ បាន ថ្លែងអំណរគុណ ដល់ អាជ្ញាធរ ខេត្ត ក៏ ដូចជា សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ជួយ ចុះ ជួយសង្គ្រោះ ដល់ ស្រូវ ពួកគាត់ ដែល ខ្វះខាត ទឹក បាន ទាន់ ពេលវេលា ហើយ ពួកគាត់ នឹង ប្រើប្រាស់ ទឹក នេះ មិន ឱ្យ ខ្ជះខ្ជាយ និង មិន ធ្វើឱ្យ ថ្នាក់ដឹកនាំ មាន ការខកចិត្ត នោះ ទេ ។ ប្រជាពលរដ្ឋ ទាំងអស់ សូម គាំទ្រ ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ជា បន្ត ទៀត ៕
ក្រុម មន្រ្តី ប្រាប់ អាជីវករ នៅ តំបន់ កាស៊ីណូ ក្រុង ប៉ោយប៉ែត ត្រូវ រួមគ្នា លើក តម្លើង រូបិយ បណ្ណ កម្ពុជា
( បន្ទាយមានជ័យ )៖ មន្រ្តី កាំ កុងត្រូល . មន្រ្តី ពាណិជ្ជកម្ម និង រដ្ឋបាល ក្រុង ប៉ោយប៉ែត បាន ណែនាំ ដល់ អាជីវក ខ្មែរ ថៃ និង ចិន ទាំងអស់ ដែល កំពុង ប្រកប អាជីវកម្ម នៅ តាម កាស៊ីណូ ក្នុង ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ត្រូវ នាំគ្នា ចូលរួម លើក តម្កើន រូបិយ បណ្ណ កម្ពុជា ហើយក៏ បាន ថ្លែង ព្រមាន ទុក ពេលរយៈ១ ខែ ផងដែរ សម្រាប់ កិច្ចការងារ នេះ បើ មិន ដូច្នេះ ទេ អាជីវកម្ម របស់ ខ្លួន អាច ប្រឈម នឹង ការបិទ រួច កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ តុលាការ ។
ការណែនាំ ទាំង នេះ ដោយសារតែ ក្រុម អាជីវករ ទាំងនោះ មិន បាន អនុវត្ត តាម សេចក្តីប្រកាស របស់ ក្រសួង ពាណិជ្ជកម្ម ដែល តម្រូវឲ្យ ក្រុម អាជីវករ ត្រូវ បិត ស្លាក តម្លៃ លើ មុខ ទំនិញ របស់ ខ្លួន ។
ប្រធាន កាំ កុងត្រូល រូប នេះ បាន បន្ត ថា « មន្រ្តី ជំនាញ អនុវត្ត ឱ្យ មាន ការ សរសេរ រាយ មុខ ទំនិញ តាំង លក់ ក្នុង ផ្សារ ម៉ាត ឬ ទីតាំង លក់ ទំនិញ យោង តាម ការប្រកាស របស់ ក្រសួង ពាណិជ្ជកម្ម ស្តីពី ការបិទ ស្លាក លើ មុខ ទំនិញ និង សេវាកម្ម គ្រប់ ប្រភេទ ដើម្បី លើកស្ទួយ ប្រាក់ រៀល ខ្មែរ ដោយ ធានា ដល់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ទីផ្សារ សេរី និង ការប្រកួតប្រជែង ដោយ សមធម៌ » ។
បើ តាម លោក ឆាឡែស ប្រោន (Charles Brown) ដែល ជា អគ្គមេបញ្ជាការ កងទ័ព អាកាស អាមេរិក ប្រចាំ នៅ តំបន់ ប៉ាស៊ីហ្វិក ការផ្អាក សកម្មភាព ហោះហើរ របស់ យន្តហោះ ទម្លាក់ គ្រាប់បែក នេះ គឺ ក្នុង គោលបំណង ជួយ ដល់ កិច្ចប្រឹងប្រែង តាម ផ្លូវការទូត ដើម្បី ដោះស្រាយ បញ្ហា អាវុធ នុយក្លេអ៊ែរ នៃ ប្រទេស កូរ៉េ ខាងជើង ។
មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង ធនធាន ទឹក រូប នេះ បាន បញ្ជាក់ ទៀត ថា ព្យុះ USAGI នៅ ពេល ដែល ស្ថិត ឆ្នេរសមុទ្រ ប្រទេស វៀតណាម គឺជា ព្យុះ ទីហ្វុង ប៉ុន្ដែ នៅពេល ធ្វើដំណើរ មកដល់ ព្រំដែន ប្រទេស កម្ពុជា - វៀតណាម ព្យុះ នេះ បាន វិវឌ្ឍន៍ ខ្លួន ទៅជា វិសម្ពាធ (TD) ហើយ នៅ ពេល នេះ ទៀតសោត ព្យុះ នេះ បាន ក្លាយទៅជា សម្ពាធ ទាប តែម្ដង ដែល ធ្វើឲ្យ ភ្លៀង និង ខ្យល់ នៅ តំបន់ ភាគ ខាងត្បូង នៃ ប្រទេស កម្ពុជា មាន ការថមថយ ។
បើ តាម លោក ចាន់ យុត្ថា សម្ពាធ ទាប នេះ នឹង បន្ដ គ្រប បណ្ដប់ និង ជះឥទ្ធិពល នៅ តំបន់ ទំនាប កណ្ដាល ភាគ ពាយ្យ និង ខ្ពង់រាប ភាគ ខាងជើង នៃ ប្រទេស កម្ពុជា វិញ ម្ដង ចាប់ពី ថ្ងៃទី ២៧ ដល់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ស្អែក នេះ ដែល ធ្វើឲ្យ អាកាសធាតុ នៅ បន្ដ អួរ អាប់ ។
អបអរសាទរ ! ភាពយន្ដ កីឡាទី១ របស់ កម្ពុជា ស្ដីពី កីឡា ចំបាប់ ឈ្នះ ពាន អន្ដរជាតិ នៅ កេន យ៉ា
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨
១៖ សម្ដេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ បំពេញ ទស្សនកិច្ច និង ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល អាស៊ី - ប៉ាស៊ីហ្វិក នៅ ប្រទេស នេប៉ាល់ នៅ ចុង សប្តាហ៍ នេះ ចុច អាន
២៖ សម្តេច ទៀ បាញ់៖ សំណង់ វិមាន ឈ្នះ - ឈ្នះ នឹង ក្លាយជា និក្ខេប បទ ដល់ នាយ ទាហាន និង យុវជន ជំនាន់ ក្រោយ សម្រាប់ ស្វែងយល់ ពី សន្តិភាព នៅ កម្ពុជា ចុច អាន
៣៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្តល់ ឱវាទ សំខាន់ ពីរ យ៉ាង ដល់ យុវជន កម្ពុជា ក្នុង ឱកាស មហាសន្និបាត តំណាង ទូទាំង ប្រទេស សសយក នៅ ថ្ងៃ នេះ ចុច អាន
៨៖ ម្រេច កម្ពុជា នឹង លែង ពឹងផ្អែក តែ លើ ទីផ្សារ វៀតណាម និង ថៃ ទៀត ហើយ បន្ទាប់ពី សហព័ន្ធ ម្រេច ចាប់កំណើត ចុច អាន
៩៖ អ្នកជំនាញ អារ្យធម៌ ខ្មែរ៖ តើ អាមេរិក ខ្លាច កំពង់ផែ សមុទ្រ ទឹក ជ្រៅ ខ្មែរ ឬ គ្រាន់ ជា លេស ដូច ពី អតីតកាល ? ចុច អាន
១០៖ លិខិត មិត្ត អ្នកអាន៖ លទ្ធផល នៃ នយោបាយ អត្តឃាត របស់ សម រង្ស៊ី គឺ ភាពឯកោ ! ចុច អាន
១១៖ អ្នកវិភាគ៖ សម រង្ស៊ី កំពុង ប្រើ យុទ្ធ វិធី លួងលោម បង្រួបបង្រួម ក្លែងក្លាយ ដើម្បី គ្រប់គ្រង ខ្មោច បក្ស សង្គ្រោះ ជាតិ ចុច អាន
១៣៖ ភាពតានតឹង ផ្ទុះឡើង ជាថ្មី រវាង រុស្ស៊ី និង អ៊ុយក្រែន ! ម្ខាង ត្រៀម ប្រកាស ប្រើ ច្បាប់ អាជ្ញា សឹក និង ម្ខាង ទៀត កោះ ប្រជុំ ក្រុមប្រឹក្សា សន្តិសុខ UN ជាបន្ទាន់ ! ចុច អាន
១៤៖ សហរដ្ឋ អាមេរិក នឹង ផ្តល់ រង្វាន់ ០៥លាន ដុល្លារ ដល់ អ្នក ផ្តល់ ព័ត៌មាន ឈានដល់ ការចាប់ខ្លួន ជន បង្ក អំពើ ភេរវកម្ម ក្នុង ទីក្រុង ម៉ុម បៃ កាលពី ឆ្នាំ ២០០៨ ចុច អាន
១៦៖ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ឥណ្ឌា៖ ត្រូវ ធ្វើ កំណែទម្រង់ ក្នុង WTO តែ មិន ត្រូវ រំសាយ អង្គការ នេះ ចោល ជាដាច់ខាត ! ចុច អាន
១៧៖ ការវិនិយោគ ផ្ទាល់ ពី បរទេស នៅក្នុង ប្រទេស ចិន មាន កំណើន ថេរ នៅ ឆ្នាំ ២០១៨ នេះ ចុច អាន ១៨៖ ទាំង គំនូរ ដ៏ កម្រ ដែល សល់ ពី សម័យ រាជកាល សុង នឹង ដាក់ លក់ ដេញថ្លៃ នៅ ទីក្រុង ហុងកុង ចុច អាន
ច្បាប់ អាជ្ញា សឹក នេះ នឹង ត្រូវ អនុវត្ត សម្រាប់ រយៈពេល ២ខែ ។ ប៉ុន្តែ មុននឹង ត្រូវ ចូល ជាធរមាន ទាល់តែ មាន ការអនុម័ត ពី សភា អ៊ុយក្រែន ជាមុន សិន ហើយ គេ ក៏ រំពឹង ដែរ ថា ក្រុម តំណាងរាស្ត្រ អ៊ុយក្រែន នឹង អនុម័ត លើ ការប្រកាស ឱ្យ ប្រើ ច្បាប់ អាជ្ញា សឹក ក្នុង ពេល ឆាប់ ៗ នេះ ។
គួរ ជម្រាប ថា ភាពតានតឹង រវាង អ៊ុយក្រែន និង រុស្ស៊ី បាន ផ្ទុះឡើង កាលពី ថ្ងៃអាទិត្យ បន្ទាប់ពី ទីក្រុង ម៉ូស្គូ ចោទ ថា ទូក អ៊ុយក្រែន បី គ្រឿង បាន ចូលក្នុង តំបន់ ដែន ទឹក របស់ ខ្លួន ដោយ ខុស ច្បាប់ ។ លើស ពី នេះ ទៅ ទៀត អាជ្ញាធរ អ៊ុយក្រែន ក៏ បាន អះអាង ដែរ ថា ទូក ប្រដាប់ ដោយ កាំភ្លើង ០២ គ្រឿង និង ទូក ល្បាត ធម្មតា មួយ គ្រឿង ត្រូវបាន ភាគី រុស្ស៊ី រឹបអូស រីឯ ក្រុម នាវិក អ៊ុយក្រែន មួយចំនួន បាន រងរបួស ដោយ ការបាញ់ប្រហារ ពី ភាគី រុស្ស៊ី ។
ប្រទេស ទាំង ពីរ បាន បន្ទោស និង ចោទប្រកាន់ ដាក់ គ្នា ទៅ វិញ ទៅ មក ខណៈ នៅ ថ្ងៃចន្ទ នេះ សមាជិក សភា អ៊ុយក្រែន នឹង បោះឆ្នោត សម្រេច ថា តើ ត្រូវ ប្រកាស ដាក់ ឱ្យ ប្រើ ច្បាប់ អាជ្ញា សឹក ឬ ក៏ យ៉ាងណា ស្រប ពេល ភាគី រុស្ស៊ី ក៏ បាន ស្នើ កោះ ប្រជុំ ក្រុមប្រឹក្សា សន្តិសុខ នៃ អង្គការ សហ ប្រជាជាតិ ជាបន្ទាន់ ៕
បច្ចុប្បន្ន សហភាព សហព័ន្ធ យុវជន កម្ពុជា មាន សមាជិក គណៈកម្មាធិការ កណ្តាល សរុប ១៤២ រូប ដែល ទើបនឹង បោះឆ្នោត បន្ថែម ៤៣ នាក់ ព្រមទាំង សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល សរុប ២០រូប ។ បូក បញ្ចូល សមាជិក ថ្មី ១៥ រូប ទៀត ដូច្នេះ សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល កើន ដល់ ៣៥ រូប ៕ គ.ជ. ប៖ បញ្ជី បោះឆ្នោត ដំបូង ឆ្នាំ ២០១៨ និង ឈ្មោះ អ្នក ដែល ត្រូវ លុប ចេញ ពី បញ្ជី បោះឆ្នោត តាម ឃុំ សង្កាត់ ត្រូវបាន បិទ ផ្សាយ ព្រម ៗ គ្នា នៅ តាម ឃុំ សង្កាត់ នា ថ្ងៃ នេះ
នៅក្នុង ជំនួប នេះ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ថ្លែង ថា ក្រោម ការដឹកនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ក្នុង នោះ កងយោធពល ខេមរភូមិន្ទ ក៏ បាន បំពេញ តួនាទី របស់ ខ្លួន បាន យ៉ាង ជោគជ័យ ជាពិសេស ការងារ ការពារ បូរណភាព ទឹកដី ការពារ សុខ សន្តិភាព តាម យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល ការងារ កសាង កងយោធពល ខេមរភ មិន្ទ ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ នាយ ឧត្ដមសេនីយ៍ ឥត សារ៉ាត់ ក៏ បាន បញ្ជាក់ ជូន ប្រតិភូ ថា កងយោធពល ខេមរភូមិន្ទ មាន ការបណ្ដុះបណ្ដាល គ្រប់ ជាន់ ថ្នាក់ គ្រប់ ជំនាញ ដែល ធ្វើឱ្យ យោធិន គ្រប់ រូប មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការបំពេញ ភារកិច្ច ក្នុង ការទំនាក់ទំនង ប្រទេស ទាំង ពីរ កងទ័ព ទាំង ពីរ រដ្ឋាភិបាល ប្រទេស ទាំង ពីរ ក៏ ធ្លាប់ បាន ផ្លាស់ប្ដូរ ទស្សនកិច្ច ពី គ្នា ទៅ វិញ ទៅ មក ផងដែរ ជា ហេតុ ធ្វើឱ្យ ការទំនាក់ទំនង កងទ័ព យើង ទាំង ពីរ ក៏ ត្រូវតែ ពង្រឹង ការទំនាក់ទំនង ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ កងទ័ព បង់ក្លាដែស ដែល បាន ជ្រើសរើស យក ប្រទេស កម្ពុជា មក ធ្វើ ទស្សនកិច្ច សិក្សា ៕
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៦ ខែវិច្ឆិកា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៨៨០ គ្រឿង និង ផាក ពិន័យ ៦៨៣ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៤.៨៨៥ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៨៨០ គ្រឿង ( ម៉ូតូ ៦៨ %) អប់រំ១៩៧ គ្រឿង និង ផាក ពិន័យ ៦៨៣ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ២. ៥០៨ គ្រឿង . អប់រំ១០១ គ្រឿង និង ផាក ពិន័យ ៤៩១ គ្រឿង ។
ធ្លាក់ ឧទ្ធម្ភាគចក្រ យោធា ចំ ទីប្រជុំជន ក្នុង ទីក្រុង អ៊ីស្តង់ប៊ុល ផ្តាច់ ជីវិត មនុស្ស ០៤ នាក់ !
( អ៊ីស្តង់ប៊ុល) ៖ នាយ ទាហាន យ៉ាងតិច ០៤ នាក់ បាន ស្លាប់ និង ម្នាក់ ទៀត ស្ថិត ក្នុង ការសង្រ្គោះ បន្ទាន់ បន្ទាប់ពី ឧទ្ធម្ភាគចក្រ យោធា មួយ គ្រឿង បាន ធ្លាក់ ចំ ទីប្រជុំជន ក្នុង ទីក្រុង អ៊ីស្តង់ប៊ុល នៃ ប្រទេស តួកគី ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃចន្ទ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
បើ តាម រូបភាព បង្ហាញ ពី ហេតុការណ៍ គ្រោះថ្នាក់ ខាងលើ ឧទ្ធម្ភាគចក្រ នោះ បាន ធ្លាក់ ទៅ លើ ដង ផ្លូវ មួយ ខ្សែ ដែល សម្បូរ ទៅ ដោយ លំនៅឋាន ក្នុង សង្កាត់ សាន់ ខេក តេផេ (Sancaktepe) នៃ តំបន់ មាន ជនជាតិ អាស៊ី រស់ នៅ ច្រើន ក្នុង ទីក្រុង អ៊ីស្តង់ប៊ុល ។ បើ តាម សេចក្តីថ្លែងការណ៍ របស់ អភិបាល ក្រុង ឧទ្ធម្ភាគចក្រ យោធា បាន ធ្លាក់ ក្នុង អំឡុង ពេល ធ្វើ ការហ្វឹកហ្វឺន មួយ ។
គួរ ជម្រាប ថា ជុំវិញ ករណី ខាងលើ ឧទ្ធម្ភាគចក្រ ដែល ពុំ ច្បាស់ ថា ជា ធុន អ្វី នេះ ត្រូវ គេ រាយការណ៍ ថា បាន ធ្លាក់ បន្ទាប់ពី ប៉ះ ជាមួយ ដំបូល អគារ មួយ ខ្នង ស្រប ពេល ព្យាយាម ធ្វើ ការចុះចត នៅលើ ផ្លូវ ដោយសារតែ មាន បញ្ហា ៕ ទីប្រឹក្សា លោក បណ្ឌិត ងួន ញ៉ិល ផ្ដល់ អណ្ដូង ទឹក និង សម្ភារ សិក្សា ជូន សិស្ស នៅ សាលា បឋមសិក្សា ប៊ុន រ៉ានី ហ៊ុន សែន បេង នៅ ស្រុក មេមត់ ខេត្ដ ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ លោក ឈាន លីម សាវុធ ទីប្រឹក្សា លោក បណ្ឌិត ងួន ញ៉ិល អនុប្រធាន រដ្ឋសភា បាន ផ្តល់ អណ្តូង ស្នប់ ទឹក ស្អាត ខ្នាត ធំ ព្រមទាំង សម្ភារ សិក្សា មួយចំនួន ជូន សិស្សានុសិស្ស នៃ សាលា បឋមសិក្សា ប៊ុន រ៉ានី ហ៊ុន សែន បេង ដែល ស្ថិត នៅ ឃុំ រូង ស្រុក មេមត់ ខេត្ត ត្បង ឃ្មុំ តប តាម សំណូមពរ ស្នើសុំ របស់ គ្រូ និង សិស្ស ព្រមទាំង អាជ្ញាធរ មូលដ្ឋាន នេះ ។
ក្នុង ពិធី នោះ លោក ឈាន លីម សាវុធ បាន ស្នើឲ្យ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ព្រមទាំង មាតាបិតា សិស្ស សូម ចូលរួម ជួយ ថែរក្សា អណ្តូង ស្នប់ ទឹក ស្អាត នេះ ដើម្បី ធានា នូវ ការ ប្រើប្រាស់ បាន យូរ ។
លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង មាតាបិតា សិស្ស ក្នុង មូលដ្ឋាន ឃុំ រូង ស្រុក មេមត់ បាន សម្ដែង នូវ ទឹកចិត្ត ត្រេកអរ និង សប្បាយរីករាយ ចំពោះ សមិទ្ធិផល នេះ ព្រមទាំង បាន ថ្លែងអំណរគុណ ដល់ ម្ចាស់ អំណោយ ដែល បាន យកចិត្តទុកដាក់ ជួយ ដោះស្រាយ ទុក្ខលំបាក ជូន ប្រជាពលរដ្ឋ ។
ក្នុង ឱកាស ចែក សម្ភារ សិក្សា និង អំណោយ លោក ឈាន លីម សាវុធ ក៏ បាន ចែកជូន ថវិកា ព្រមទាំង សម្ភារ ប្រើប្រាស់ មួយចំនួន ជូន ដល់ អាជ្ញាធរ មួលដ្ឋាន និង ប្រជាពលរដ្ឋ ផងដែរ ៕ ខ្យល់ កន្ដ្រាក់ មួយ ប្រាវ បាក់ ដើមឈើ ធំ មួយ នៅ មហាវិថី ព្រះនរោត្តម ក្នុង ខណ្ឌ ដូនពេញ បណ្ដាលឲ្យ ខូចខាត រថយន្ដ ៣ គ្រឿង
( ភ្នំពេញ ) ៖ ខ្យល់ កន្ត្រាក់ បាន បោកបក់ យ៉ាង ខ្លាំង មួយ ប្រាវ បណ្តាលឲ្យ បាក់ ដើមឈើ ធំ មួយ រលំ សង្កត់ លើ រថយន្ត ចំនួន ៣គ្រឿង រង ការខូចខាត ប៉ុន្ដែ មិន ប៉ះពាល់ ដល់ ពលរដ្ឋ ណា ម្នាក់ នោះ ទេ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ រសៀល ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅ តាម បណ្តោយ មហាវិថី ព្រះនរោត្តម ស្ថិត នៅក្នុង សង្កាត់ ជ័យ ជំនះ ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ។
ភ្លាម ៗ ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ លោក សុខ ពេញវុធ បាន បញ្ជា ឲ្យ កម្លាំង សន្តិសុខ សាលា ខណ្ឌ ចុះ ទៅដល់ ទីតាំង កើត ហេតុ និង កាប់ ដើមឈើ ដែល បាន ដួលរលំ សង្កត់ ទៅ លើ រថយន្ត ចំនួន ៣ គ្រឿង នោះ ចេញ ពី ផ្លូវ ដើម្បី កុំ ឲ្យ មាន ការកក់ ស្ទះ ចរាចរណ៍ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ តាម ផ្លូវ នេះ ។
ក្រោយ កើត ហេតុ មន្ត្រី ជំនាញ បាន យក រថយន្ត ទាំង៣ គ្រឿង ខាងលើ ដែល រង ការខូចខាត នោះ យក ទៅ ធ្វើ កំណត់ហេតុ នៅឯ សាលា ខណ្ឌ ដូនពេញ ដើម្បី រង់ចាំ ដោះស្រាយ គ្នា តាម ក្រោយ ។
សូម ជម្រាប ថា ពាក់ព័ន្ធ ករណី ខ្យល់ កន្ដ្រាក់ នេះ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ ថា នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ឥទ្ធិពល ព្យុះ USAGI កំពុងតែ ស្ថិត នៅ ព្រំដែន កម្ពុជា - វៀតណាម គឺ នៅ តាម បណ្ដោយ ព្រំដែន ក្នុង ខេត្ត ស្វាយ វៀង និង ព្រៃវែង ដែល ធ្វើឲ្យ មាន ភ្លៀង ធ្លាក់ ច្រើន នៅ ទីនោះ រហូត ធ្វើឲ្យ មាន ការព្រួយបារម្ភ ទេ ។
លោក ចាន់ យុត្ថា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ ទៀត ថា ឥទ្ធិពល ព្យុះ USAGI នឹង ធ្វើដំណើរ មកដល់ រាជធានី ភ្នំពេញ នៅ វេលា ម៉ោង ២រំលង អាធា្រ ត្រ យប់ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ មុននឹង បន្ដ ដំណើរ ទៅកាន់ ខេត្ត កំពង់ស្ពឺ និង ខេត្ត កោះកុង ៕
សាកសព ត្រី បាឡែន ទាំង នេះ ត្រូវ គេ ប្រទះឃើញ កាលពី យប់ ថ្ងៃអាទិត្យ ដោយ ពួកវា បាន ជាប់គាំង នៅលើ កោះ ស្ទេវ៉ាដ (Steward) ដែល ជា កោះ តូច មួយ នៅ ភាគ ខាងត្បូង នូវែលសេឡង់ ។ នៅពេល ប្រទះឃើញ គឺ ពាក់កណ្តាល នៃ ពួកវា បាន ងាប់ បាត់ ទៅ ហើយ តែ ដោយសារ ការមើលឃើញ ស្ថានភាព ជាក់ស្តែង នៃ ត្រី បាឡែន ដែល នៅ សេសសល់ បូករួម កត្តា បង្ក ការលំបាក ដទៃ ទៀត អាជ្ញាធរ នូវែលសេឡង់ ក៏ បាន សម្រេច សម្លាប់ ត្រី បាឡែន ដែល នៅសល់ នោះ ចោល ទាំងអស់ តែម្តង កុំ ឲ្យ ពួកវា នៅ រង ភាពវេទនា ត ទៀត ។
( ភ្នំពេញ ) ៖ សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា កម្ពុជា បាន លើកឡើង ថា សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការចលនា យុវជន ដើម្បី ចូលរួម ក្នុង សកម្មភាព សង្គម សេដ្ឋកិច្ច នយោបាយ ចូលរួម អនុវត្ត គោល នយោបាយ នានា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ តាម វិស័យ និង គ្រប់ មូលដ្ឋាន ទូទាំង ប្រទេស ។
ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ពិធី បើក មហាសន្និបាត តំណាង ទូទាំង ប្រទេស លើក ទី៤ របស់ ស .ស .យ . ក នៅ ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ក៏ បាន គូសបញ្ជាក់ ថា សហភាព សហព័ន្ធ យុវជន កម្ពុជា ក៏ បាន ចូលរួមចំណែក ជាពិសេស ក្នុង ការលើក ស្ទូយ មោទនភាព ជាតិ និង កិត្យានុភាព ជាតិ លើ ឆាក អន្ដរជាតិ ផងដែរ ។
សម្ដេច ប្រធាន ព្រឹទ្ធសភា ក៏ បាន ចូលរួម អបអរសាទរ ចំពោះ សមិទ្ធផល ទាំងឡាយ ដែល ក្រុមគ្រួសារ ស .ស .យ . ក សម្រេចបាន ក្នុង រយៈពេល ៦ឆ្នាំ កន្លងមក នេះ នៅ តាម វិស័យ និង ផែនការការងារ ជាច្រើន ដែល បាន ផ្ដល់ ប្រយោជន៍ ដោយ ផ្ទាល់ ដល់ យុវជន និង សង្គម កម្ពុជា ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ និង ជីវភាព សង្គម ។
សម្ដេច បញ្ជាក់ ថា ស .ស .យ . ក គឺជា វេទិកា ដ៏ ទូលំទូលាយ មួយ សម្រាប់ យុវជន ទាំងអស់ គ្នា ចូលរួម ក្នុង គោលដៅ លើកកម្ពស់ សុខភាព យុវជន . ការសិក្សា . ការរក ការងារ ធ្វើ . ការចម្រើន លូតលាស់ និង ការជំរុញ លើកកម្ពស់ ផ្នត់គំនិត ចែករំលែក ចូលរួម ផ្ដល់ ទៅឲ្យ សង្គម វិញ តាមរយៈ ការងារ ស្ម័គ្រចិត្ដ ការលះបង់ និង ការបរិច្ចាគ ។
សម្ដេច សាយ ឈុំ បាន សង្កត់ យ៉ាង ដូច្នេះ ថា « យើង ត្រូវ ចង់ ចាំ ថា ការងារ មហាជន ជា ការងារ ចាំបាច់ និង ត្រូវ ធ្វើជា ប្រចាំ ។ ជាក់ស្ដែង ការគាំទ្រ មហាជន គឺជា កត្ដា កំណត់ នៃ ភាពជោគជ័យ និង ប្រៀប ឈ្នះ នៅ គ្រប់ ការងារ ទាំងអស់ មិន ថា នយោបាយ សង្គម និង សេដ្ឋកិច្ច នោះ ទេ ។ អាស្រ័យ ហេតុ នេះ ការងារ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ត្រូវតែ ផ្សាភ្ជាប់ ជាមួយ មហាជន ជាពិសេស យុវជន គឺ មាន សារៈសំខាន់ បំផុត ដែល ត្រូវតែ បន្ដ ធ្វើឲ្យ ជាប់ ជានិច្ច » ។
បើ តាម ការលើកឡើង របស់ សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ក្នុង ដំណាក់កាល ៥ឆ្នាំ ទៅ មុខ កម្លាំង និង ចំនួន យុវជន ក្នុង ស្រទាប់ មហាជន កាន់តែ មាន ចំនួន កើនឡើង ស្រប ពេល ជាមួយ ការវិវឌ្ឍន៍ នៃ បច្ចេកវិទ្យា សង្គម សេដ្ឋកិច្ច ដែល នឹង ជះឥទ្ធិពល កាន់ ខ្លាំង ទៅ លើ ផ្នត់គំនិត និង តម្រូវការ ថ្មី ៗ របស់ យុវជន ។
ព្រម ពេល ជាមួយគ្នា នេះ ការលេចឡើង នូវ ក្ដីសង្ឃឹម ថ្មី ៗ និង មជ្ឈដ្ឋាន សាធារណៈ មតិ នានា ទាំង វិជ្ជមាន និង អវិជ្ជមាន ជាពិសេស តាមរយៈ បណ្ដាញ ព័ត៌មាន សង្គម នឹង ធ្វើឲ្យ មហាជន ក្នុង នោះ ចលនា យុវជន កាន់តែ មាន ភាពប្រឈម ឡើង ដែល ទាមទារ ឲ្យ ការងារ នេះ ត្រូវ មាន ចក្ខុវិស័យ និង ទិសដៅ ការងារ ច្បាស់លាស់ រចនាសម្ព័ន្ធ រឹងមាំ រួម ជាមួយ ការដឹកនាំ និង សាមគ្គីភាព ជា ធ្លុង មួយ ដើម្បី អាច ឲ្យ សមិទ្ធផល ដែល មាន ស្រាប់ កាន់តែ រីកលូតលាស់ ឡើង និង កើនឡើង ច្រើន បន្ថែម ទៀត ៕
ស្នងការ ខេត្ត បន្ទាយមានជ័យ ដឹកនាំ កម្លាំង ៥០០ នាក់ ចុះ បារ កំប្លោក ចេញ ពី ស្ទឹង ស្វាយ ចេក ដើម្បីឲ្យ ទឹក ស្ទឹង មាន សោភ័ណភាព ល្អ
( បន្ទាយមានជ័យ )៖ លោក ឧត្តមសេនីយ៍ ទោ អាត់ ខែម ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ បាន ដឹកនាំ កងកម្លាំង នគរបាល ខេត្ត ស្រុក ក្រុង និង វរសេនា តូច ការពារ ព្រំដែន គោក ទាំង៤ សរុប ចំនួន ៥០០ នាក់ មាន ទាំង ទូក ឡាន ទឹក សម្រាប់ កងកម្លាំង ងូត កុំ ឲ្យ រមាស់ ចុះ បារ កំប្លោក និង ពើក ដែល នៅក្នុង ស្ទឹង ស្វាយ ចេក ស្រុក ស្វាយ ខេត្ត បន្ទាយមានជ័យ ដែល មាន ប្រវែង ចំនួន ៦៥០ ម៉ែត្រ ។
ប្រតិបត្តិការ ចុះ បារ កំប្លោក នេះ ដែរ ធ្វើឡើង នា ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ហើយក៏ មាន ការចូលរួម ពី ព្រះសង្ឈ កងកម្លាំង សឹក រង ស្រុក កម្លាំង កងរាជា អាវុធហត្ថ ស្រុក មន្ត្រីរាជការ ក្នុង ស្រុក និង ប្រជាពលរដ្ឋ សិស្សានុសិស្ស វិទ្យាល័យ ស្វាយ ចេក សម្ព័ន្ធ យុវជន យ៉ាង ច្រើន កុះករ ផងដែរ ។
លោក លឿង សុភ័ក្រ្ត អភិបាល ស្រុក ស្វាយ លោក មេភូមិ រ ការ ថ្មី និង ប្រជាពលរដ្ឋ បាន ថ្លែង នូវ អំណរ សាទរ ជាមួយនឹង សកម្មភាព របស់ កងកម្លាំង នគរបាល និង កម្លាំង កងរាជអាវុធហត្ថ អាជ្ញាធរ មូលដ្ឋាន សឹក រង ស្រុក សិស្សានុសិស្ស រួមទាំង ប្រជាពលរដ្ឋ ផងដែរ ។
( ភ្នំពេញ ) ៖ តប តាម ការអញ្ជើញ របស់ នាយក រដ្ឋមន្ត្រី នៃ ប្រទេស នេប៉ាល់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ បំពេញ ទស្សនកិច្ច ផ្លូវការ និង ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ី - ប៉ាស៊ីហ្វិក នៅ ប្រទេស នេប៉ាល់ ចាប់ពី ថ្ងៃទី ៣០ ខែវិច្ឆិកា ដល់ ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
ឥស្សរជន កម្ពុជា ដែល នឹង អញ្ជើញ អម ដំណើរ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី រួម មាន៖ លោក ប្រាក់ សុខុន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ សមាជិក ដទៃ ទៀត នៃ រាជ រដ្ឋាភិបាល កម្ពុជា និង តំណាង ពី សភា ពាណិជ្ជកម្ម កម្ពុជា ផងដែរ ៕ ផ្ទាំង គំនូរ ដ៏ កម្រ ដែល សល់ ពី សម័យ រាជកាល សុង នឹង ដាក់ លក់ ដេញថ្លៃ នៅ ទីក្រុង ហុងកុង (Video inside)
កន្លែង លក់ ដេញថ្លៃ បាន ឲ្យដឹង ថា ផ្ទាំង គំនូរ « ឈើ និង ថ្ម » នេះ នឹង ស្ថិត ក្នុង ចំណោម ស្នាដៃ ដ៏ សំខាន់ បំផុត នៃ ប្រវត្តិសាស្ត្រ នៃ ការលក់ ដេញថ្លៃ ។
ការតាំង បង្ហាញ នេះ មាន បង្ហាញ ស្នាដៃ សិល្បៈ ប្រហែល ៦០មុខ ដែល មាន លក្ខណៈ ចម្រុះ គ្នា ទាំង បែប បុរាណ និង សហសម័យ ទាំង គ្រឿង សេរ៉ា មិច និង ស្នាដៃ សិប្បកម្ម ចម្រុះ ប្រភេទ គ្នា ផងដែរ ។ អ្នករៀបចំ កម្មវិធី បាន ឲ្យដឹង ថា អ្នក ដេញថ្លៃ ជនជាតិ ចិន បាន ចាប់អារម្មណ៍ កាន់តែ ច្រើន ទៅ លើ ស្នាដៃ សិល្បៈ បែប សហសម័យ នា ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ។
ស្នាដៃ សិល្បៈ ទាំងអស់ ព្រមទាំង គ្រឿងអលង្ការ មួយចំនួន ទៀត នឹង ដាក់ លក់ ដេញថ្លៃ ចាប់ពី ថ្ងៃទី ២៣ ដល់ ២៥ ខែវិច្ឆិកា នៅ ទីក្រុង ហុងកុង ៕ ( សារព័ត៌មាន CCTV របស់ ចិន )
ការលើកឡើង របស់ រដ្ឋមន្ត្រី ការពារ ជា កម្ពុជា រូប នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅក្នុង ឱកាស ដែល សម្តេច បាន ដឹកនាំ ក្រុមងារ ងារ បន្ត ចុះ ត្រួតពិនិត្យ ដំណើរការ សាងសង់ វិមាន ឈ្នះ - ឈ្នះ ស្ថិត នៅ សង្កាត់ ជ្រោយ ចង្វា រាជធានី ភ្នំពេញ ។
សម្តេច ពិជ័យ សេនា បាន បញ្ជាក់ ថា សំណង់ វិមាន ឈ្នះ - ឈ្នះ នឹង ក្លាយជា ទីតាំង តម្កល់ ទុក នូវ ទ្រព្យសម្បត្តិ ខាង បញ្ញា ញាណ ទ្រព្យសម្បតិ្ត លើ ការយល់ដឹង ពី ប្រវិត្តសាស្ត្រ ដែល ត្រូវ យកមក តម្កល់ នៅ វិមាន នេះ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ យុវជន និង អ្នកសិក្សា ស្រាវជ្រាវ នានា បាន ដឹង បាន ឮ បាន មើល នៅ នយោបាយ ឈ្នះ - ឈ្នះ ផងដែរ ។
សូម ជម្រាប ថា វិមាន ឈ្នះ - ឈ្នះ នេះ បាន ចាប់ផ្តើម សាងសង់ ឡើង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០១៦ លើ ទំហំ ដី ៨ហិចតា ស្ថិត នៅ ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។ ការសាងសង់ វិមាន ឈ្នះ - ឈ្នះ នេះ គឺជា និម្មិត រូប នៃ សុខ សន្តិភាព ដែល កម្ពុជា ទទួលបាន ក្រោយពី បញ្ចប់ សង្គ្រាម ស៊ីវិល ដ៏ រ៉ាំរ៉ៃ ជាច្រើន ទសវត្ស កន្លងមក ។
ជាង នេះ ទៀត វិមាន នេះ នឹង ក្លាយជា កេរមរតក សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ផងដែរ ។ នេះ ជា ការបញ្ជាក់ បន្ថែម ពី នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ ប្រធាន ក្រុមការងារ សាងសង់ វិមាន ឈ្នះ - ឈ្នះ ដែល បាន ប្រឹងប្រែង យ៉ាង មុះមត់ ក្នុង ការដឹកនាំ ក្រុមការងារ សាងសង់ វិមាន ជា ប្រវត្តិសាស្រ្ត មួយ នេះ តាម ការណែនាំ និង ចង្អុលបង្ហាញ ជាប្រចាំ របស់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ។
ទំនប់ ទឹក ស្ទឹង ស្រែង នេះ មាន ប្រវែង ២. ៨០០ម៉ែត្រ តភ្ជាប់ ពី ភ្នំ កំបោរ ទៅ ភ្នំ រូង ដែក មាន សមត្ថភាព ស្តុក ទឹក បាន ២៥៩ លាន ម៉ែត្រ គូប ។ ទំនប់ នេះ ស្ថិត នៅក្នុង ភូមិ ស្រះ កែវ ឃុំ ពង្រ ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ ។ ទំនប់ ស្ទឹង ស្រែង ដែល ដើរ តួនាទី កាត់បន្ថយ ទឹក ជំនន់ និង អាច ផ្តល់ ទឹក សម្រាប់ យក ទៅ ផ្គត់ផ្គង់ ដី ស្រែ ជាង ២៥.០០០ ហិកតា ក្នុង ខេត្ត ចំនួន ៣ រួម មាន ខេត្ត ឧត្តរមានជ័យ បន្ទាយមានជ័យ និង សៀមរាប ។ ទំនប់ នេះ ត្រូវបាន បញ្ចប់ ការសាងសង់ កាលពី ខែមីនា ឆ្នាំ ២០១៧ ។
ពេល ចាប់ផ្តើម ដំណើរការ សាងសង់ ទំនប់ មួយ នេះ ក៏ មាន ធ្វើ ចលនា ផ្សេង ៗ រារាំង ការសាងសង់ នេះ ផងដែរ ក្រោម ហេតុផល ប៉ះពាល់ ដី ព្រៃ សហគមន៍ ។ ប៉ុន្តែ ដោយ មើលឃើញ ពី អត្ថប្រយោជន៍ ចាំបាច់ ក្នុង ការទាញយក ទឹក សម្រាប់ ផ្គត់ផ្គង់ ការស្រោចស្រព និង ប្រើប្រាស់ របស់ ប្រជាពលរដ្ឋ រាជ រដ្ឋាភិបាល បាន ជម្នះ សាងសង់ ទំនប់ ស្ទាក់ ទឹក នេះ ឡើយ ។
បច្ចុប្បន្ន ល ទំនប់ ស្ទាក់ ទឹក មួយ នេះ កំពុង ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការផ្តល់ ប្រភព ទឹក សម្រាប់ ប្រជាពលរដ្ឋ ។ លោក សេង សុង ប្រជាពលរដ្ឋ រស់ នៅក្នុង ស្រុក អន្លង់ វែង តាំងពី ទសវត្សរ៍ ឆ្នាំ ៨០មក នោះ បាន សម្តែង ការសាទរ និង រីករាយ ខ្លាំង ចំពោះ សមិទ្ធផល មួយ នេះ ។
លោក បាន គូសបញ្ជាក់ ថា តាំងពី លោក រស់ នៅ ទីនេះ មិន ដែល មាន ទំនប់ ទឹក ធំ បែប នេះ ឡើយ ហើយ ប្រជាពលរដ្ឋ តែង ជួប បញ្ហា ខ្វះ ទឹក ប្រើប្រាស់ និង ស្រោចស្រព ។ ប៉ុន្តែ ក្រោយពេល រាជ រដ្ឋាភិបាល សាងសង់ ទំនប់ នេះ ឡើង ធ្វើឲ្យ ប្រជាពលរដ្ឋ លែង ជួប បញ្ហា ទាំងអស់ នោះ ហើយ បាន ជួយ ធ្វើឲ្យ ជីវភាព របស់ ពួកគាត់ បាន ប្រសើរ ផងដែរ ៕
មន្រ្តី កាំ កុងត្រូល ខេត្ត សៀមរាប ចុះ អង្កេត ទំនិញ នៅ ផ្សារ សម្ដេច តេជោ ដើម ក្រឡាញ់ . រកឃើញ មឹក មាន សារធាតុ គីមី ហាមឃាត់ និង បាន ដកហូត យក ទៅ កំទេចចោល
( សៀមរាប ) ៖ មន្រ្តី សាខា កាំ កុត្រូល ខេត្ត សៀមរាប និង អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ ខេត្ត សៀមរាប នៅ ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន សហការ ជាមួយ មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម គណៈកម្មការ ផ្សារ បាន ចុះ ត្រួតពិនិត្យ ទំនិញ ដែល ដាក់តាំង លក់ នៅក្នុង ផ្សារ សម្ដេច តេជោ ដើម ក្រឡាញ់ ដែល មាន ទីតាំង នៅ ភូមិ ត្រពាំង សេះ ឃុំ គោក ចក ស្រុក សៀមរាប ខេត្ត សៀមរាប ។
ជាមួយគ្នា នោះ ដែរ មន្រ្តី ជំនាញ បាន ធ្វើ ការណែនាំ ដល់ អាជីវករ អោយ យល់ដឹង អំពី សុវត្ថិភាព ម្ហូប អាហារ ពិសេស សូម កុំ ផលិត ឬ យក ទំនិញ គ្មាន គុណភាព ឬ មាន សារធាតុ គីមី ហាមឃាត់ មក ដាក់ តាំង លក់ ព្រោះ នាំឲ្យ ប៉ះពាល់ ដល់ សុខភាព របស់ អ្នកប្រើប្រាស់ ៕ « ការតស៊ូ របស់ ប្រជាជន៖ កម្ពុជា រស់ ឡើងវិញ » ចំណងជើង នៃ សៀវភៅ និយាយ ពី ដំណើរតស៊ូ ដើម្បី បុព្វហេតុ ជាតិ និង ប្រជាជន របស់ សម្តេច ហេង សំរិន
( ភ្នំពេញ ) ៖ សៀវភៅ និយាយ ពី ដំណើរតស៊ូ ដើម្បី បុព្វហេតុ ជាតិ និង ប្រជាជន របស់ សម្តេច ហេង សំរិន មាន ចំណងជើង ថា « ការតស៊ូ របស់ ប្រជាជន៖ កម្ពុជា រស់ ឡើងវិញ » ត្រូវបាន ធ្វើ ពិធី ផ្សព្វផ្សាយ នៅ ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ។ សៀវភៅ រៀបរាប់ ពី បេសកកម្ម ក្នុង បុព្វហេតុ ជាតិ និង ប្រជាជន ដែល សម្តេច បាន ចំណាយ ពេល សឹង ពេញ មួយ ជីវិត សម្តេច ត្រូវបាន កត់ត្រា ទុក នៅក្នុង សៀវភៅ នេះ ជា ភាសា អង់គ្លេស ។
ពិធី សម្ពោធ និង ផ្សព្វផ្សាយ សៀវភៅ ដែល មាន លក្ខណៈ ប្រវត្តិសាស្រ្ត នេះ មាន ការអញ្ជើញ ចូលរួម ពី សមាជិក សមាជិកា រដ្ឋសភា ព្រឹទ្ធសភា មន្ត្រី រដ្ឋាភិបាល មន្រ្តី នៃ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា និង ព្រឹទ្ធសភា ព្រមទាំង និស្សិត និង បណ្ណារក្ស នៃ គ្រឹះស្ថាន អប់រំ សាធារណៈ និង ឯកជន ជាង ១០០ នាក់ ។
« ការតស៊ូ របស់ ប្រជាជន៖ កម្ពុជា រស់ ឡើងវិញ » នឹង បង្ហាញ ពី ការពិត នៃ សង្គ្រាម នៅ កម្ពុជា ដល់ អ្នកអាន និង កូន ខ្មែរ ជំនាន់ ក្រោយ ដែល ចង់ សិក្សា ឈ្វេងយល់ ពី ប្រវត្តិសាស្រ្ត កម្ពុជា ។ ជា ប្រវត្តិសាស្រ្ត នៃ ការតស៊ូ ដោះ ប្រទេសជាតិ របស់ ឥស្សរជន ស្នេហាជាតិ និង ដំណើរ ស្តា កម្ពុជា ឡើងវិញ ក្រោយ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត បាន រលំ ទៅក្នុង រយៈ ៤០ ឆ្នាំ កន្លងមក នេះ ។
ប្រសូត្រ នៅក្នុង គ្រួសារ កសិករ នៅ ទី ជនបទ មួយ ក្នុង ខេត្ត កំពង់ចាម ក្នុង ឆ្នាំ ១៩៣៤ សម្តេច ហេង សំរិន គឺជា ប្រធាន ស្ថាបនិក ចលនា មហាជន ធំ មួយ ឈ្មោះ ថា « រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា » ដែល ក្រោយមក បាន ប្តូរ ឈ្មោះ ជា « រណសិរ្ស សាមគ្គី អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា » ដែល បាន បង្កើតឡើង នៅក្នុង សមាជ មួយ នៅ ខេត្ត ក្រចេះ កាលពី ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ១៩៧៨ ។ ផ្តើម ចេញ ពី ខេត្ត ក្រចេះ នោះ ហើយ ដែល សម្តេច ហេង សំរិន បាន ប្រកាស ផែនការ ១១ ចំណុច ក្នុង ការផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
ក្រោយ ថ្ងៃ៧ ខែមករា ឆ្នាំ ១៩៧៩ សម្តេច ហេង សំរិន បាន ក្លាយជា ប្រមុខរដ្ឋ នៃ សាធារណរដ្ឋ ប្រជាមានិត កម្ពុជា និង ជា អគ្គ លេខាធិការ បក្ស នៃ គណបក្ស បដិវត្តន៍ ប្រជាជន កម្ពុជា ។ បច្ចុប្បន្ន សម្តេច ហេង សំរិន ជា ប្រធាន រដ្ឋសភា និង ជា ប្រធាន កិត្តិយស នៃ គណ បក្ស ប្រជាជន កម្ពុជា ព្រមទាំង ជា ប្រធាន ប្តូរ វេន នៃ វេទិកា សភា អាស៊ី ប៉ាស៊ីហ្វិក (APPF) ខណៈ ដែល សភា កម្ពុជា នឹង ធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ ប្រចំា ឆ្នាំ លើក ទី ២៧ នៃ វេទិកា សភា នេះ នៅក្នុង ខែមករា ឆ្នាំ ២០១៩ ខាងមុខ ។
សម្តេច ហេង សំរិន គឺជា ថ្នាក់ដឹកនាំ ម្នាក់ ក្នុង ចំណោម ថ្នាក់ដឹកនាំ ចលនា រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា ចំនួន ១៤រូប ដែល នៅរស់រាន មាន ជីវិត ដូចជា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា . លោកស្រី មាន សំអាន សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ នៃ គណបក្ស ប្រជាជន កម្ពុជា និង ជា សមាជិកា ព្រឹទ្ឋ សភា លោក រស់ សម័យ ទីប្រឹក្សា ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល និង លោក ចាន់ វ៉ែន អតីត អគ្គ លេខាធិការ រដ្ឋសភា ជាដើម ។
រណសិរ្ស សាមគ្គី សង្រ្គោះ ជាតិ កម្ពុជា នឹង ប្រារព្ធ ខួប លើក ទី ៤០ ឆ្នាំ ថ្ងៃ បង្កើត រណសិរ្ស នៅ ស្តូប អនុស្សាវរីយ៍ នា ស្រុក ស្នួល ខេត្ត ក្រចេះ នា ថ្ងៃទី ២ ខែធ្នូ ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។ សម្តេច ពញា ចក្រី ហេង សំរិន នឹង អញ្ជើញ ជា អធិបតីភាព ដ៍ ខ្ពង់ខ្ពស់ ក្នុង កម្មវិធី នេះ ដែល មាន មហាជន រាប់ ម៉ឺន នាក់ ចូលរួម ផងដែរ ។
* ឧបក ថា សម្រាំង នៅក្នុង សៀវភៅ
មរណភាព របស់ សោ ភឹម៖ ការស្លាប់ របស់ សោ ភឹម មេបញ្ជាការ ភូមិភាគ បូព៌ា នៃ កងទ័ព បដិវត្តន៍ ប្រជាជន កម្ពុជា គឺជា អ្វី មួយ ដែល មជ្ឈដ្ឋាន ជាតិ និង អន្តរជាតិ ចង់ ដឹង ។ សៀវភៅ « ការតស៊ូ របស់ ប្រជាជន៖ កម្ពុជា រស់ ឡើងវិញ » នឹង មាន រៀបរាប់ លម្អិត ទាក់ទង នឹង ការស្លាប់ របស់ សោ ភឹម ។
ត្រង់ ចំណុច មួយ ដែល សម្តេច ហេង សំរិន បាន ប្រាប់ អ្នក និពន្ធ ដោយ បាន រំលឹក អំពី កិច្ចប្រជុំ ចុងក្រោយ មួយ ជាមួយ អតីត មេបញ្ជាការ ដែល កំពុង មាន ជំងឺ នៅ វត្ត មួយ ក្នុង ឃុំ ព្រៃ សាលិត ក្នុង ស្រុក ពារាំង ខេត្ត ព្រៃវែង កាលពី ឆ្នាំ ១៩៧៨ ដែល ភ្លាម ៗ នោះ បន្ទាប់ពី អង្គរក្ស មួយចំនួន របស់ សោ ភឹម ត្រូវបាន សម្លាប់ ដោយ កងកម្លាំង ប៉ុល ពត នៅជិត ទីក្រុង ភ្នំពេញ ។
« គាត់ ស្ថិត នៅក្នុង សភាព មួយ បាក់ទឹកចិត្ត » សម្តេច បាន រៀបរាប់ ដូច្នេះ ដោយ បាន ពន្យល់ ពី មូលហេតុ ដែល សោ ភឹម បាន ឯកភាព ចាកចេញ ពី កងកម្លាំង របស់ ប៉ុល ពត ឆ្ពោះ ទៅកាន់ ស្រុក ស្រីសន្ធ រ ខេត្ត កំពង់ចាម ។ « នៅ ស្រុក ស្រីសន្ធរ សម្តេច មាន ទាហាន ឈរជើង ចំនួន ៣០០ នាក់ សម្រាប់ ត្រៀម អន្តរាគមន៍ សភាពការណ៍ ដែល អាច កើតឡើង ជា យថាហេតុ ណាមួយ » ។
សម្តេច ហេង សំរិន បាន មានប្រសាសន៍ បន្ត ថា « ពួក ទ័ព សត្រូវបាន យក សព សោ ភឹម ជា ភស្តុតាង និង ចោទប្រកាន់ ថា គាត់ ជា ជនក្បត់ ពិតប្រាកដ ហើយ គាត់ បាន ស្លាប់ ហើយ ។ ឈ្មោះ ឈាន ដែល ជា លេខា បក្ស តំបន់ ២២ និង ឈ្មោះ សារុន ប្រធាន ភស្តុភារ តំបន់ បូព៌ា ក៏ ត្រូវបាន ពួកវា សម្លាប់ ផងដែរ » ។
* ការប៉ះទង្គិច ជាមួយ កងកម្លំាង តាម៉ុក
« ការតស៊ូ របស់ ប្រជាជន៖ កម្ពុជា រស់ ឡើងវិញ » ក៏ និយាយ រំលឹក ផងដែរ ដល់ ការប៉ះទង្គិច ដំបូង ជាមួយ កងកម្លាំង តំបន់ និរតី ដែល ដឹកនាំ ដោយ តា ម៉ុក ខណ: ពេល ដែល កម្លាំង បដិវត្តន៍ កំពុងតែ ប្រយុទ្ឋ ផ្តួលរំលំ របប លន់ ណុល ។
សម្តេច ពញា ចក្រី ហេង សំរិន បាន ហៅ ការប៉ះទង្គិច លើក ដំបូង ជាមួយ តា ម៉ុក នោះ មាន ជាប់ពាក់ព័ន្ឋ នឹង ការបាត់ ខ្លួន នៅ តំបន់ ភ្នំ ជីសូនូវ កងកម្លាំង ១០នាក់ មកពី តំបន់ បូព៌ា ដោយ រួមទាំង មេបញ្ជាការ កង អនុ សេនា ធំ មួយ រូប ផងដែរ ។
ក្រោយមក ទៀត ក៏ មាន ការប៉ះទង្គិច គ្នា ម្តង ទៀត នៅ តំបន់ ព្រំដែន ស្រុក ស្អាង និង ស្រុក ព្រៃ កប្បាស ត្រង់ ម្តុំ ព្រែក អំបិល ។ នោះ គឺជា ការប៉ះទង្គិច ទ្រង់ទ្រាយ ធំ មួយ រវាង កង កំលាំង ថ្មើរជើង របស់ ភូមិភាគ ទាំង ពីរ រហូត មាន ការប្រឈមមុខ ដាក់ គ្នា ដោយ ប្រើ កំា ភ្លើង ត្បាល់ ទៀតផង ។
* ការដក កំលាំង ចេញពី ភ្នំពេញ
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន មានប្រសាសន៍ ថា កងកម្លាំង តំបន់ បូព៌ា របស់ សម្តេច បាន ឈរជើង ត្រួតត្រា នៅ ភ្នំពេញ រយ: ពេល មួយ ខែ មុនពេល ត្រូវ ជំនួស ដោយ កម្លាំង មជ្ឈឹម តាម បទបញ្ជា អោយ ចាកចេញ ។ « ពួក កងកម្លាំង មជ្ឈឹម ម៉ឺងមាត់ ហ្មត់ចត់ និង ដាច់ខាត » ។ នៅ ពេលណា ចេញ បញ្ជា ការងារ ដាច់ខាត ត្រូវតែ សម្រេច ដោយ មិន ត្រូវ បរាជ័យ ជាដាច់ខាត ។ សម្តេច បាន រំលឹក ឡើងវិញ ។
* ការបោះពុម្ព ផ្សាយ និង ផ្សព្វផ្សាយ
សហរដ្ឋ អាមេរិក នឹង ផ្តល់ រង្វាន់ ០៥លាន ដុល្លារ ដល់ អ្នក ផ្តល់ ព័ត៌មាន ឈានដល់ ការចាប់ខ្លួន ជន បង្ក អំពើ ភេរវកម្ម ក្នុង ទីក្រុង ម៉ុម បៃ កាលពី ឆ្នាំ ២០០៨
( កំពង់ធំ )៖ ដើម្បី ជួយ សម្រួល ដល់ កសិករ ក្នុង រដូវកាល ប្រមូល ផល ស្រូវ ស្រាល នេះ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ បាន ដឹកនាំ មន្ត្រីរាជការ កងកម្លំាង ប្រដាប់អាវុធ និង យុវជន ចុះ ជួយ ច្រូត ស្រូវ ប្រជាកសិករ នៅ ភូមិ ព្រៃ ព្រះ ឃុំ កំពង់ស្វាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ និង បាន ពិសារ បាយ សាមគ្គី ជាមួយ ប្រជាពលរដ្ឋ នៅនឹង វាល ស្រែ យ៉ាង ឆ្ងាញ់ ពិសារ ប្រកបដោយ ភាពសប្បាយរីករាយ និង ស្និទ្ធស្នាល ។
លោក សុខ លូ ថ្លែង ថា រដូវ នេះ ជា រដូវ ប្រមូល ផល ច្រូត កាត់ ស្រូវ ដែល ក្រុមគ្រួសារ នីមួយ ៗ កំពុងតែ មាន ភាពមមាញឹក ដោយឡែក គ្រួសារ ខ្លះ ទៀត ដោយសារតែ សមាជិក គ្រួសារ តិច បាន បង្ខំ ចិត្ត ជួល កម្លាំង ពលកម្ម ពី ខាងក្រៅ មក ជួយ បន្ថែម ទៀត ។ នៅ ពេល នេះ លោក បាន ដឹកនាំ ក្រុមការងារ ចូលរួម ជួយ ច្រូត ស្រូវ ក្នុង គោលបំណង ដើម្បី កាត់បន្ថយ ការចំណាយ ថវិកា របស់ ប្រជាកសិករ ក្នុង ការជួល កម្លាំង ពលកម្ម មក ប្រមូល ផល ស្រូវ ដែល ទុំ ពេញ វាល ស្រែ ។
ជាមួយគ្នា នោះ ដែរ លោក សុខ លូ បាន សំដែង នូវ ក្តី សប្បាយរីករាយ ដែល ខេត្ត កំពង់ធំ អាច ផលិត បាន ស្រូវ សរីរាង្គ ដែល មាន ក្រុមហ៊ុន ធំ ៗ ចុះ កុងត្រា ក្នុង ការទទួល ទិញ ស្រូវ សម្រាប់ នាំចេញ លក់ បន្ត នៅ ក្រៅ ប្រទេស ដែល មាន តម្លៃ សមរម្យ អាច ទទួលយក បាន ។
លើស ពី នេះ ទៀត លោក ក៏ បាន សំណូមពរ ដល់ ប្រជាកសិករ ទាំងអស់ ត្រូវ ផលិត ស្រូវ ស្រប ទៅតាម តម្រូវការ របស់ ទីផ្សារ និង មាន គុណភាពល្អ ដើម្បីឲ្យ ក្រុមហ៊ុន បញ្ជាទិញ ឲ្យ កាន់តែ ច្រើន នៅ ឆ្នាំ ក្រោយ ៗ ទៀត ។ ដូច្នេះ សូមឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ ខិតខំ បង្កបង្កើន ផល បន្ថែម ទៀត ដើម្បី លើកកម្ពស់ កម្រិត ជីវភាព គ្រួសារ ឲ្យ មាន ការរីកចម្រើន កាន់តែ ល្អ ប្រសើរឡើង ថែម ទៀត ជាពិសេស ចូលរួម ថែរក្សា នូវ សុខ សន្តិភាព ស្ថេរភាព នយោបាយ កុំ ជឿ តាម ការញុះញង់ របស់ ជន អគតិ មួយចំនួន ឲ្យ សោះ ។
សូម បញ្ជាក់ ថា ស្ថិត នៅក្នុង រដូវការ កំពុង ប្រមូល ផល ប្រភេទ ស្រូវ ស្រាល ស្រូវ ផ្កា រំដួល នេះ ប្រជាកសិករ មួយចំនួន កំពុង មមាញឹក ធ្វើ ស្រែ ប្រាំង ជាច្រើន ហិចតា បន្ថែម ទៀត ផងដែរ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ អាជ្ញាធរ អាមេរិក បាន សម្រេចចិត្ត ប្រើប្រាស់ ឧស្ម័ន បង្ហូរ ទឹកភ្នែក ដើម្បី បំបែក ហ្វូង ជន អន្តោប្រវេសន៍ ដែល ព្យាយាម ឆ្លង ព្រំដែន ដោយ ខុស ច្បាប់ ពី ទីក្រុង Tijuana នៃ ប្រទេស ម៉ិចស៉ី កូ ចូលមកកាន់ សហរដ្ឋ អាមេរិក ៕
២៖ អាជ្ញាធរ វៀតណាម បាន ឱ្យដឹង ថា ព្យុះ ទីហ្វុង យូសាជិ (Usagi) ដែល បាន និង កំពុង វាយប្រហារ តំបន់ ភាគ ខាងត្បូង នៃ ប្រទេស ជាមួយ ការបង្ក ជា គ្រោះ រអិល បាក់ ដី និង បាន ផ្ដាច់ យក ជីវិត មនុស្ស ម្នាក់ ព្រមទាំង បំផ្លាញ ផ្លូវថ្នល់ ទូក នានា ព្រមទាំង ផ្ទះសម្បែង ប្រជាជន រាប់ សិប ខ្នង ៕
៣៖ ក្រុម បាតុករ អ៊ុយក្រែន ជាច្រើន នាក់ បាន ប្រមូលផ្ដុំ គ្នា នៅ ខាងក្រៅ ស្ថានទូត រុស្ស៊ី ប្រចាំ ទីក្រុង គៀវ ដើម្បី សម្ដែង ការតវ៉ា ប្រឆាំង នឹង ទីក្រុង ម៉ូស្គូ ដែល បាន រឹបអូស ទូក អ៊ុយក្រែន ចំនួន ០៣ គ្រឿង ក្រោយ មាន ការបះទង្គិច គ្នា នៅឯ ដែន សមុទ្រ នៃ ឧបទ្វីប គ្រីមៀ ៕
៤៖ តំបន់ ព្រំដែន អ៊ីរ៉ាក់ - អ៊ីរ៉ង់ បាន ទទួលរង ការវាយប្រហារ ពី គ្រោះ រញ្ជួយ ដី កម្រិត ធ្ងន់ ៦.៣រ៉ិច ទ័រ ដែល បង្កឲ្យ មនុស្ស យ៉ាងតិច ម្នាក់ ស្លាប់ និង រាប់ រយ នាក់ ទៀត រងរបួស ៕
( ភ្នំពេញ ) ៖ លោក សុង សារ៉ន ប្រធាន សហព័ន្ធ ម្រេច និង គ្រឿងទេស កម្ពុជា ដែល ជា សហព័ន្ធ ទើប ចាប់កំណើត នៅ ដើម ខែវិច្ឆិកា នេះ បាន រៀបរាប់ ថា ការកកើត សហព័ន្ធ ម្រេច នេះ មិន ត្រឹមតែ ផ្ដល់ ប្រយោជន៍ ដល់ ប្រជាកសិករ ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ ថែមទាំង ជួយ ដល់ បង្កើត ទីផ្សារ ម្រេច ផងដែរ ។
លោក សុង សារ៉ន លើកឡើង ថា ផ្អែក តាម ទិន្ន័យ របស់ ក្រសួង កសិកម្ម កម្ពុជា មាន ម្រេច ជិត ២ម៉ឺន តោន ត្រូវបាន ផលិត ដោយឡែក បើ ផ្អែក លើ ទិន្នន័យ ក្នុង ប្រទេស វៀតណាម បាន បញ្ជាក់ ថា វៀតណាម បាន បញ្ជាទិញ ម្រេច ពី កម្ពុជា ២៥.០០០ តោន ក្នុង ១ ឆ្នាំ ហើយ ចំនួន នេះ ក៏ មិន មាន ភាពប្រាកដប្រជា នៅឡើយ ដែល តម្រូវឲ្យ សហព័ន្ធ ប្រមូល ទិន្នន័យ ជាក់លាក់ ។
លោក បញ្ជាក់ ថា « បន្ទាប់ពី មាន សហព័ន្ធ ម្រេច និង គ្រឿងទេស នេះ កម្ពុជា នឹង មិន ពឹងផ្អែក ទាំងស្រុង លើ ទីផ្សារ វៀតណាម ទៀត ឡើយ ព្រោះ មាន ជម្រើស ទីផ្សារ ច្រើន ដូច ជា៖ សហគមន៍ អឺរ៉ុប . ឌូបៃ . អារ៉ាប់ និង ទីផ្សារ សហរដ្ឋ អាមេរិក ជាដើម ។ ទីផ្សារ ទាំង នេះ មាន តួនាទី សំខាន់ ណាស់ ក្នុង ចលនា ទទួលទាន ម្រេច លើ ពិភពលោក ដោយ ក្ដោប បាន ជាង ៨០ ភាគរយ លើ ទីផ្សារ សរុប ម្រេច » ។
លោក បន្ដ ទៀត ថា ចំណែកឯ ទីផ្សារ ដែល កំពុង លេចធ្លោរ មួយ ទៀត នោះ គឺ ទីផ្សារ របស់ ប្រទេស ចិន ហើយ ជា ទីផ្សារ ថ្មី ដែល កំពុង កើនឡើង នៃ ទីផ្សារ ម្រេច នេះ ។
លោក ថា « ខ្ញុំ ជឿជាក់ ថា ចិន នឹង ងាក មក ចាប់អារម្មណ៍ លើ ទីផ្សារ ម្រេច របស់ កម្ពុជា ព្រមទាំង បញ្ជាទិញ ម្រេច ពី កម្ពុជា ។ ដើម្បី នាំចូល ម្រេច ទៅក្នុង ប្រទេស ចិន បាន កម្ពុជា ត្រូវ មាន ជា យុទ្ធសាស្រ្ដ ដែល សហព័ន្ធ នឹង លើក យក ពិភាក្សា ជាមួយ សមាជិក » ។
លោក ថា ម្រេច របស់ កម្ពុជា មាន សក្ដានុពល ខ្លាំង ដែល ត្រូវបាន ចាត់ទុក ថា ជា ម្រេច ដែល ប្រកបដោយ គុណភាព និង សុវត្ថិភាព ខ្ពស់ ដល់ អ្នកទទួលទាន ៕
( តាកែវ )៖ កម្លាំង នគរបាល នាយកដ្ឋាន ប្រឆាំង ភេរវកម្ម និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន សហការ ជាមួយ នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ក្រោម ការសម្របសម្រួល ពី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខត្ត តាកែវ នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន បើក ប្រតិបត្តិការ ចុះ ទៅ បង្ក្រាប និង ចាប់ខ្លួន ជនជាតិ ចិន មួយ ក្រុម ធំ មាន ចំនួន ២៣៥ នាក់ ( ស្រី ៣៦ ) ដែល ជាប់ពាក់ព័ន្ធ ករណី Voip ។
សម្រាប់ ជនជាតិ ចិន ទាំងនេះ ត្រូវបាន ចាប់ខ្លួន រួម ជាមួយ វត្ថុតាង ជាច្រើន ត្រូវបាន រឹបអូស ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ តុលាការ ចាត់ការ តាម ច្បាប់ ។
