( ភ្នំពេញ ) ៖ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK ប្រកាស បន្ដ ឥណទាន ផ្នែក កសិកម្ម ដល់ ប្រជាកសិករ បន្ថែម ទៀត ទោះបីជា បច្ចុប្បន្ន នេះ វិស័យ កសិកម្ម កំពុង មាន ការធ្លាក់ចុះ យ៉ាងណា ក្ដី ហើយ វិស័អ ចលន វត្ថុ កើនឡើង ក៏ដោយ ក៏ គ្រឹះស្ថាន មួយ នេះ មិន ផ្លាស់ប្ដូរ និង រុញ រា ក្នុង ការផ្ដល់ ឥណទាន ដល់ ប្រជាកសិករ នោះ ឡើយ ។ នេះ បើ តាម ការឲ្យដឹង ពី លោក គា បូរាណ ប្រធាន នាយក ប្រតិបត្តិ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK ។
លោក គា បូរាណ លើកឡើង ថា « មួយ រយៈ ចុងក្រោយ នេះ វិស័យ កសិកម្ម ហាក់ ថមថយ ពិតមែន ដោយសារតែ កំណើន នៃ វិស័យ ផ្សេង ទៀត កំពុង កើនឡើង ខ្លាំង ។ ប៉ុន្ដែ យ៉ាងណា ក្ដី វិស័យ កសិកម្ម នៅតែ ជា វិស័យ មួយ ធំ ចំពោះ ការគាំទ្រ វិស័យ សេដ្ឋកិច្ច នៃ កម្ពុជា មួយ វិញទៀត ប្រជាជន កម្ពុជា ប្រមាណ ៦០ % នៅតែ ប្រកបរបរ ធ្វើ ស្រែ ចំការខ្នាត តូច ដើម្បី ផ្គត់ផ្គង់ ជីវភាព រស់ នៅ » ។
លោក បន្ដ ថា វិស័យ កសិកម្ម ជា វិស័យ សំខាន់ លើ ពិភពលោក និង មិន អាច ខ្វះ បាន ព្រោះ គ្មាន អ្នកណា ម្នាក់ រស់ ដោយ អត់ ហូប អាហារ បាន ឡើយ ។ កម្ពុជា ជា ប្រទេស មួយ ដែល មាន ធនធាន ល្អ ដី មាន ជីវជាតិ អាច បង្កបង្កើន ផល បាន ប្រសើរ ជាក់ស្ដែង កម្ពុជា ក៏ បាន ជាប់ ចំណាត់ថ្នាក់ លេខ ១ ដែល មាន អង្ករ ល្អ ថែម ទៀត ផង ។
លោក បញ្ជាក់ ថា « សម្រាប់ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK ទោះបីជា វិស័យ កសិកម្ម ថយចុះ ហើយ វិស័យ អចលន វត្ថុ កើនឡើង ក៏ AMK មិន មាន បំណង ឬ ផែនការ ក្នុង ការផ្លាស់ប្ដូរ ទិសដៅ ផ្នែក ឥណទាន លើ អចលន ទ្រព្យ ដែរ គឺ បន្ដ ផ្ដល់ កម្ចី ផ្នែក កសិកម្ម ទៅដល់ ប្រជាកសិករ តាម ជនបទ ដើម្បី លើ កម្ពស់ ជីវភាព របស់ ពលរដ្ឋ និង ក៏ លើកកម្ពស់ វិស័យ នេះ បន្ថែម ទៀត » ។
ដោយឡែក សម្រាប់ សន្និសីទ ស្ដីពី ការប្រកាស ខ្លួន ចូល ជា សមាជិក ធនាគារ ស៊ាង ហៃ ពាណិជ្ជ និង សន្សំ របស់ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK នេះ ធ្វើឡើង ដើម្បី ផ្លាស់ប្ដូរ មុខមាត់ ថ្មី ឲ្យ ក្លាយជា គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ មួយ ដែល ឈាន មុខ គេ នៅ កម្ពុជា នា ពេល អនាគត ពិសេស លើកកម្ពស់ វិស័ធនាគារ នៅ កម្ពុជា ថែម ទៀត ផង ។
លោក ថា ការសម្រេចចិត្ត វិនិយោគ លើ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK នេះ គឺ ផ្ដោត លើ កត្តា ចម្បង ៗ ជាច្រើន ព្រមទាំង ការសំលឹង ឃើញ ពី ភាពរឹងមាំ ផ្នែក ហិរញ្ញវត្ថុ និង បេសកកម្ម សង្គម របស់ ខ្លួន ទំនុកចិត្ត លើ បុគ្គលិក និង ការគ្រប់គ្រង របស់ AMK ផងដែរ ។
លោក បាន សំដែង ការស្វាគមន៍ យ៉ាង ខ្លាំង ចំពោះ ការចូល ជា សមាជិក របស់ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK នេះ ។ លោក សង្ឃឹម ថា បន្ទាប់ពី ការចូល ខ្លួន ជា សមាជិក AMK នឹង បន្ដ តួនាទី ក្នុង ការលើក កំណើន សេដ្ឋកិច្ច ដែល មិន គួរឲ្យ ជឿ ក្នុង ប្រទេស កម្ពុជា ហើយ នឹង ប្រែក្លាយ ជីវភាព ប្រជាជន ពី ទាប ទៅ ចំណូល មធ្យម ផងដែរ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៦.៤៣៦ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ១.១៤៨ គ្រឿង ( ម៉ូតូ ៨0%) អប់រំ២៦៥ គ្រឿង និង ផាក ពិន័យ ៨៨៣ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ២. ៨៤៧ គ្រឿង . អប់រំ១២៥ គ្រឿង និង ផាក ពិន័យ ២៩៧ គ្រឿង ។
ប្រសាសន៍ សំខាន់ ៗ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង នៅក្នុង ឱកាស អញ្ជើញ ជា អធិបតី បិទ មហាសន្និបាត តំណាង ទូទាំង ប្រទេស លើក ទី៤ របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា
មហាសន្និបាត តំណាង ទូទាំង ប្រទេស លើក ទី៤ របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ធ្វើឡើង កាលពី ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ក្រោម អធិបតីភាព សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា និង ជា អនុប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ តួអង្គ ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន រួមគ្នា ក្នុង ការរក្សា តួអង្គ អង្គការ យុវជន មួយ នេះ ។
* សម្តេច តេជោ បាន ថ្លែង ថា សកម្មភាព របស់ យុវជន មិន មែន ទើប កើតមាន នៅ ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ១៩៧៨ នោះ ទេ ។ ប៉ុន្តែ សកម្មភាព របស់ យុវជន បាន កើតមាន តាំងពី ពេល មុន ដើម្បី ប្រឆាំង នឹង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
* សម្តេច តេជោ ហ៊ុន សែន គេ មិន អាច កាត់ ប្រវត្តិសាស្ត្រ ជា កង់ ៗ បាន នោះ ឡើយ ហើយ បើ ខ្វះ ទស្សនៈ ប្រវត្តិសាស្ត្រ មិន អាច ក្លាយទៅជា អ្នកវាយតម្លៃ ស្ថានការណ៍ បាន ទេ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តាំ ដល់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ថា ត្រូវ ប្រកាន់ នូវ គោលការណ៍ សមូហភាព ដឹកនាំ បុគ្គល ទទួលខុសត្រូវ ។
* សម្តេច តេជោ បាន ថ្លែង ថា បើ ប្រកាន់ នូវ គោលការណ៍ សមូហភាព ដឹកនាំ បុគ្គល ទទួលខុសត្រូវ គឺ គ្មាន ឡើយ ការបែកបាក់ គ្នា ។
* សម្តេច តេជោ បាន ថ្លែង ថា សម្តេច មិន ខ្វល់ អ្វី ជា កុម្មុយនិស្ត ឬ មិន កុម្មុយនិស្ត នោះ ទេ គឺ ស្គាល់ តែ អ្វី ជា រឿង ពិតប្រាកដ ដែល កំពុង កើត នៅ កម្ពុជា ។
* សម្តេច តេជោ បាន រំលឹក ថា ពី អតីតកាល ពេល ទៅ ប្រទេ សេរី គេ ថា សម្តេច ជន កុម្មុយនិស្ត ពេល ទៅ ប្រទេស កុម្មុយនិស្ត គេ ថា សម្តេច ជា ជន សេរី តែ សម្តេច អត់ ខ្វល់ ទេ សំខាន់ សម្តេច ជា របស់ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ហៅ ក្រុម ជន ដែល ហៅ របប ដឹកនាំ បច្ចុប្បន្ន ថា ជា កុម្មុយនិស្ត គ្រា ដែល ពួកគេ មាន សិទ្ធិ សេរីភាព ជ្រើសរើស ការងារ ផ្សេង ៗ ដោយ សេរី នោះ គឺជា មនុស្ស ក្បត់ នឹង ការពិត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា យុវជន បច្ចុប្បន្ន មាន ឱកាស ល្អ និង សមត្ថភាព ខ្លាំង បើ ធៀប ជាមួយ យុវជន ជំនាន់ មុន ប៉ុន្តែ ពួកគេ មិន ទាន់ បាន ឆ្លងកាត់ ភាព ចាស់ទុំ នៅឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា យុវជន ជំនាន់ ថ្មី ត្រូវតែ រៀនសូត្រ ពី ចាស់ ជំនាន់ មុន ព្រោះ ចាស់ ជំនាន់ មុន មាន បទពិសោធន៍ យ៉ាង ច្រើន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ធ្វើជា មេដឹកនាំ លំបាក ប៉ុន្តែ ត្រូវតែ ហ៊ាន លះបង់ បើ ទោះបី ការលះបង់ នោះ ធំ រហូតដល់ លះបង់ អាយុជីវិត ក៏ ត្រូវ ធ្វើ ដែរ ដើម្បី ប្រយោជន៍ សង្គមជាតិ និង ប្រជាជន ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា សម្តេច ធ្លាប់ ប្រដៅ ខៀវ សំផន ផងដែរ ពាក់ព័ន្ធ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន រំលឹក ថា ទម្រាំ មាន ថ្ងៃ នេះ មាន មនុស្ស ស្លាប់ ច្រើន ណាស់ ។
* សម្តេច តេជោ បាន លើកឡើង ថា តើ លើ លោក នេះ មាន មេដឹកនាំ ប៉ុន្មាន នាក់ ហើយ ដែល ហ៊ាន ប្រថុយ ជីវិត ចូលទៅ ជំរុំ របស់ សត្រូវ ។
* សម្តេច តេជោ បាន រំលឹក ថា នៅពេល ទទួលបាន ការបោះឆ្នោត គាំទ្រ ពី សភា ឡើង ធ្វើជា នាយក រដ្ឋមន្ត្រី នៅ ថ្ងៃទី ១៤ មករា ឆ្នាំ ១៩៨៥ សម្តេច មើលឃើញ ថា មិន អាច យក សង្គ្រាម បញ្ចប់ សង្គ្រាម បាន នោះ ទេ ។ ដូច្នេះហើយ ទើប សម្តេច ដាក់ ចេញ នយោបាយ កំណែទម្រង់ នយោបាយ និង កំណែទម្រង់ សេដ្ឋកិច្ច ត្រូវតែ ធ្វើ ទន្ទឹម គ្នា ។
* សម្តេច តេជោ បាន ថ្លែង ថា កម្លាំង សង្កត់ បី យ៉ាង ដែល អាច សម្លាប់ ជីវិត នយោបាយ របស់ សម្តេច រួម មាន៖ ១. ការ មិន យល់ គ្នា នៅក្នុង ផ្ទៃក្នុង បក្ស . ២. បារម្ភ ខ្លាច វៀតណាម រារាំង ព្រោះ នយោបាយ កម្ពុជា និង វៀតណាម ខុសគ្នា ខណៈ កងទ័ព វៀតណាម នៅ កម្ពុជា ប្រមាណ ១០ម៉ឺន នាក់ . ៣. ការបារម្ភ ខ្លាច សហភាព សូវៀតណាម កាត់ផ្តាច់ ជំនួយ ព្រោះ ពេល នោះ មាន តែ សូវៀត និង អឺរ៉ុប ជា អ្នក ផ្តល់ ជំនួយ មក កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការកំណត់ គោលដៅ គឺជា រឿង សំខាន់ ក្នុង ការដឹកនាំ ដូចជា សម្តេច បាន កំណត់ ថា ការបញ្ចប់ សង្គ្រាម នាំមក នូវ សន្តិភាព គឺជា គោលដៅ ពេល សម្តេច ឡើង ធ្វើជា នាយក រដ្ឋមន្ត្រី នៅ ឆ្នាំ ១៩៨៥ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តាំ ដល់ យុវជន ថា ចាប់ អ្វី ត្រូវ ចាប់ ឲ្យ ប្រាកដ ហើយ ត្រូវ ពង្រឹង សមត្ថភាព ខ្លួន ងើបឡើង ក្នុង នាម ជា ប្រជាជាតិ ស្មើ មុខ ស្មើ មាត់ ជាមួយ ប្រជាជាតិ ដទៃ ។
* សម្តេច តេជោ ហ៊ុន សែន ឆ្លើយតប ទណ្ឌិត សម រង្ស៉ី គ្មាន ថ្ងៃ ផ្លាស់ប្តូរ ជំហរ ព្រោះ បារម្ភ រឿង គំនាប បរទេស ដូច ការរំពឹងទុក របស់ ពួកគេ នោះ ឡើយ ។
* សម្តេច តេជោ បាន ផ្តាំ ទៀត ថា ដើម្បី សម្រេច គោលដៅ ត្រូវ ស្គាល់ ឱកាស បង្ក ឱកាស និង ក្តាប់ ឱកាស ឲ្យបាន ត្រឹមត្រូវ ។
* សម្តេច តេជោ បាន ផ្តាំ ទៅ យុវជន ថា ត្រូវ បន្ត រួមចំណែក ការពារ នូវ សន្តិភាព ស្ថេរភាព នយោបាយ កុំ ឲ្យ រឿងរ៉ាវ អតីតកាល ត្រឡប់ មកវិញ ពោល តម្លៃ ណា ក៏ដោយ កុំ ឲ្យ បដិវត្តន៍ ពណ៌ កើតមាន នៅ កម្ពុជា ។
* សម្តេច នាយក រដ្ឋមន្ត្រី អំពាវនាវ ដល់ យុវជន ឲ្យ បន្ត រួមគ្នា ប្រឹងប្រែង ជួយ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង សង្គម និង មិន ត្រូវ យក អធិបតេយ្យ ជាតិ ទៅ ដោះដូរ ជាមួយ ជំនួយ នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បន្ត ថា កុំ ខ្លាច ចំពោះ ក្រុម អ្នកប្រឆាំង ព្រោះ បើ មិន ប្រឆាំង គឺ មិន មែន ឈ្មោះ ជា អ្នក ប្រឆាំង នោះ ឡើយ ប៉ុន្តែ ត្រូវ គោរព តម្លៃ ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ឈប់ ឆ្លើយឆ្លង ជាមួយ ទណ្ឌិត សម រង្ស៉ី បើ ទោះបី ឆ្កឹះ សម្តេច ក៏ដោយ ។
ផ្ទះ ទី១០៣ ជា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន ប្រគល់់ ជូន អតីត យុទ្ធជន ពិការ នៅ ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ
ពលបាល ឯក អ៊ុ សាខ ន ក្រៅពី ប្រាក់ បៀវត្ស ប្រចាំ ប្រចាំ ខែ ដែល រាជ រដ្ឋាភិបាល ផ្តល់ ជូន លោក បាន ប្រកប មុខរបរ បន្ថែម ជា ជាង សំណង់ ផ្សេង ៗ និង នេសាទ ត្រី ដើម្បី បាន ប្រាក់ កម្រៃ ប្រចាំ ថ្ងៃ ចិញ្ចឹម គ្រួសារ ។ ផ្ទះ ថ្មី ដែល ទើប សាងសង់ រួច ប្រគល់ ជូន នា ពេលនេះ មាន ទំហំ ៤ម៉ែត្រ គុណ៦ម៉ែត្រ សាងសង់ ពី ឈើ ជញ្ជាំង និង រនាប ក្តារ ដំបូល ប្រក់ ស័ង្កសី សាងសង់ ខ្ពង់ខ្ពស់ ផុត ពី ដី ដែល បាន ចំណាយ ថវិកា ក្នុង ការសាងសង់ អស់ ទឹកប្រាក់ ៦.៩៩៨.០០០ រៀល ។
ក្នុង ពិធី សំណេះសំណាល និង ប្រគល់ ផ្ទះ ថ្មី នេះ លោក និង ក្រុមការងារ សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ក៏ បាន ពាំនាំ នូវ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន តាមរយៈ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ជា អគ្គ លេខាធិការ រង សមាគម អតីត យុទ្ធជន ជូន គ្រួសារ អតីត យុទ្ធជន ពិការ នេះ បន្ថែម ទៀត រួម មាន៖ អង្ករ ចំនួន ៥០ គីឡូក្រាម . មី យើង ចំនួន ០២ កេស . ទឹកត្រី . ទឹកស៊ីអ៊ីវ ចំនួន ០២យួរ និង ថវិកា ចំនួន ៤០០.០០០ រៀល ៕
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា ចេញ សេចក្ដីថ្លែងការណ៍ ជុំវិញ កង្វល់ របស់ ពលរដ្ឋ រឿង នៅ ខេត្ត ព្រះសីហនុ ពាក់ព័ន្ធ ជនជាតិ ចិន . រាជ រដ្ឋាភិបាល កំពុង វិធានការ ដើម្បី ពង្រឹង សន្ដិសុខ និង សណ្ដាប់ធ្នាប់
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន សេចក្ដីថ្លែងការណ៍ មួយ ជុំវិញ កង្វល់ របស់ ប្រជាពលរដ្ឋ នៅ ខេត្ត ព្រះសីហនុ ដោយ សង្ស័យ ពាក់ព័ន្ធ ទៅនឹង ជនជាតិ ចិន ខណៈ ដែល សារព័ត៌មាន មួយចំនួន ក៏ បាន ធ្វើ បទ អត្ថាធិប្បាយ ក្នុង គោលដៅ ដើម្បី ផលប្រយោជន៍ ណាមួយ នោះ ។
សេចក្ដីថ្លែងការណ៍ ដែល បាន បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ មុន នេះ បន្ដិច នា រសៀល ថ្ងៃ នេះ បាន អះអាង ថា រាជ រដ្ឋាភិបាល បាន និង កំពុង ចាត់ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ ក្នុង ការពង្រឹង សន្ដិសុខ សុវត្ថិភាព ក៏ ដូចជា សណ្ដាប់ធ្នាប់ សង្គម សម្រាប់ បម្រើ ផលប្រយោជន៍ សាធារណៈ ក្នុង តំបន់ នោះ ។ ជាក់ស្ដែង ក៏ មាន ជន បរទេស ដែល ជា អ្នកទេសចរ ត្រូវបាន ឃាត់ខ្លួន ជា បន្ដ បន្ទាប់ និង បញ្ជូន ត្រឡប់ ទៅ ប្រទេស ដើម វិញ ក្រោម ការអនុវត្ត ច្បាប់ របស់ កម្ពុជា ។
ក្នុង បរិការណ៍ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា សង្ឃឹម យ៉ាង មុតមាំ ថា អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ បន្ដ ការអនុវត្ត ច្បាប់ ដែល ស្រប ទៅនឹង គោល នយោបាយ ជាតិ ដាក់ ចេញ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ វិស័យ ទេសចរណ៍ និង ការវិនិយោគ ។ ជា ការចាំបាច់ ដើម្បី ទប់ស្កាត់ សកម្មភាព ទាំងឡាយ ដែល អាច បណ្ដាលឲ្យ កើត មាន ឡើង ជា សង្គ្រាម ចិត្ត សាស្ដ្រ និង ការរើសអើង ពូជសាសន៍ ដែល អាច ធ្វើឲ្យ ប៉ះពាល់ ដល់ កិត្យានុភាព និង វិបុលភាព របស់ កម្ពុជា ។
រាជ រដ្ឋាភិបាល នៅតែ បន្ដ លើកទឹកចិត្ត ដល់ វិនិយោគ ទាំងអស់ ដែល បាន និង កំពុង ប្រតិបត្តិ ធុរកិច្ច ក៏ ដូចជា ភ្ញៀវ ជាតិ និង អន្ដរជាតិ ដែល មក ទស្សនា កម្សាន្ដ រមណីយដ្ឋាន ធម្មជាតិ វប្បធម៌ និង ប្រវត្តិសាស្ដ្រ នៅ កម្ពុជា ស្រប តាម គោល នយោបាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ខិតខំ ប្រឹងប្រែង និង ទាក់ទាញ វិនិយោគ និង ទេសចរណ៍ នៅ គ្រប់ វេទិកា ជាតិ និង អន្ដរជាតិ ទាំងអស់ សម្រាប់ ការរួមចំណែក ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច កម្ពុជា ៕
ចំណែកឯ ការលើកឡើង ខាងលើ របស់ លោក ដូណាល់ ត្រាំ កើត មាន ឡើង បន្ទាប់ពី ក្រុម ជន អន្តោប្រវេសន៍ មកពី តំបន់ អាមេរិក កណ្ដាល ជាង ៥០០ នាក់ បាន ព្យាយាម ឆ្លង ព្រំដែន ពី ទីក្រុង Tijuana នៃ ប្រទេស ម៉ិចស៉ី កូ កាលពី ថ្ងៃទី ២៥ ខែវិច្ឆិកា ដើម្បី ចូល ទៅកាន់ សហរដ្ឋ អាមេរិក ។ ប៉ុន្តែ ទន្ទឹម គ្នា ការបះទង្គិច គ្នា បាន ផ្ទុះ រហូតដល់ ឆ្មាំ ការពារ ព្រំដែន អាមេរិក ប្រើប្រាស់ ឧស្ម័ន បង្ហូរ ទឹកភ្នែក ដើម្បី ទប់ សា្កត់ ក្រុម បង្ក អស្ថិរភាព ទាំងនោះ ៕
កម្លាំង នគរបាល អន្ដោប្រវេសន៍ បន្ដ ឃាត់ខ្លួន ជនជាតិ វៀតណាម ២០ នាក់ ដែល ចូលមក ស្នាក់ នៅ និង ធ្វើការ ខុស ច្បាប់ នៅ ខណ្ឌ ដូនពេញ
( ភ្នំពេញ ) ៖ ក្រុម ប្រតិបត្តិការ ចម្រុះ នាយកដ្ឋាន ស៊ើបអង្កេត និង អនុវត្ត នីតិវិធី នៃ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ សហការ ជាមួយ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ក្រោម ការសម្របសម្រួល ពី លោក ប្លង់ សុផល ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ចុះ ឃាត់ខ្លួន ជនជាតិ វៀតណាម ចំនួន ២០ នាក់ ក្នុង នោះ ស្រី ៤នាក់ នៅមុខ ចំណុច ភោជនីយដ្ឋាន ចតុមុខ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៥ ស្ថិត នៅក្នុង ភូមិ ១៦ សង្កាត់ ស្រះចក ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ។
លោក ឧត្តមសេនីយ៍ ឯក អ៊ុក ហៃ សីឡា ប្រធាន នាយកដ្ឋាន ស៊ើបអង្កេត និង អនុវត្ត នីតិវិធី បាន ឲ្យដឹង ថា ជនជាតិ វៀតណាម ចំនួន ១៤នាក់ បាន កាន់កាប់ និង ប្រើប្រាស់ ឯកសារ ត្រឹមត្រូវ រួម មាន៖ បង្កាន់ដៃ បង់ប្រាក់ ប្រកាស ទទួលស្គាល់ បង្កាន់ស្នើសុំ ដាក់ទទួលស្គាល់ ជា ជន បរទេស អន្តោប្រវេសន្ត និង ជនជាតិ វៀតណាម ចំនួន ០៦ នាក់ ស្រី ០៤ នាក់ បាន លួច ឆ្លង ដែន ចូលមក ស្នាក់ នៅ និង ប្រកបរបរ ដោយ ខុស ច្បាប់ គ្មាន លិខិត ឆ្លង ដែន ។
បើ តាម លោក ឧត្តមសេនីយ៍ ឯក អ៊ុក ហៃ សីឡា ក្រុម ប្រតិបត្តិការ ចម្រុះ បាន បញ្ជូន ជានជាតិ វៀតណាម ចំនួន ០៦ នាក់ ស្រី ០៤ នាក់ ខាងលើ មកកាន់ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ ដើម្បី ត្រួតពិនិត្យ ឯកសារ និង សាកសួរ តាម នីតិវិធី បន្ត ៕ រដ្ឋមន្រ្តី ធនធាន ទឹក ចូលរួម កិច្ចប្រជុំ ក្រុមប្រឹក្សា គណៈកម្មការ ទន្លេ មេគង្គ លើក ទី២៥ នៅ វៀតណាម . ឆ្នាំ ២០១៩ កម្ពុជា បន្ត វេន ពី វៀតណាម ធ្វើ ម្ចាស់ ផ្ទះ វិញ ម្តង
តាមរយៈ សុន្ទរកថា ថ្លែង ក្នុង កិច្ចប្រជុំ ដោយ ប្រធាន គណៈប្រតិភូ នៃ ប្រទេស ជា សមាជិក និង ការពិភាក្សា ក្នុង កិច្ចប្រជុំ ប្រទេស ជា សមាជិក បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល ដែល MRC សម្រេចបាន ក្នុង ឆ្នាំ ២០១៨ និង ការលើកកម្ពស់ ខិតខំ ប្រឹងប្រែង និង កិច្ចសហប្រតិបត្តិការ តំបន់ ក៏ ដូចជា ភាពជាដៃគូ ជាមួយ ភាគី ពាក់ព័ន្ធ ដែល បាន ជម្រុញ លើកកម្ពស់ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង និង ការអភិវឌ្ឍ ប្រកប ដោយ ចីរភាព នៃ អាង ទន្លេ មេគង្គ ។
នៅក្នុង នោះ ផងដែរ ប្រទេស ជា សមាជិក ក៏ បាន ទទួលស្គាល់ នូវ បញ្ហា ប្រឈម ក្នុង ក្របខ័ណ្ឌ ស្ថាប័ន និង ក្នុង អាង ទន្លេ មេគង្គ មាន ជាអាទិ៍ កិច្ចសហប្រតិបត្តិការ ក្នុង ចំណោម យន្តការ ក្នុង តំបន់ ដែល មាន ស្រាប់ និង ទើប បង្កើត ថ្មី កំណើន ប្រជាជន កំណើន នៃ ការអភិវឌ្ឍ និង តម្រូវការ ទឹក សម្រាប់ ទ្រទ្រង់ និង ជម្រុញ ការរីកលូតលាស់ សេដ្ឋកិច្ច សង្គម បម្រែបម្រួល អាកាសធាតុ គ្រោះ ទឹក ជំនន់ គ្រោះ រាំងស្ងួត ជាដើម ។
គួរ បញ្ជាក់ ថា ភ្លាម ៗ អាជ្ញាធរ ចិន មិន ទាន់ បាន បញ្ជាក់ ពី មូលហេតុ ផ្ទុះ នេះ នៅឡើយ ទេ ស្រប ពេល ដែល ការស៉ើប អង្កេត កំពុង ធ្វើឡើង ហើយក៏ មិន ទាន់ មាន សេចក្ដីរាយការណ៍ ថា មាន ការលេច ធ្លាយ សារធាតុ គីមី ឬ ក៏ យ៉ាងណា នោះ ដែរ ៕
ក្រសួង មហាផ្ទៃ បង្ហាញ កាលបរិច្ឆេទ និង ទីកន្លែង ប្រឡង ជ្រើសរើស មន្ត្រី ក្របខណ្ឌ នគរបាល ជាតិ
( ភ្នំពេញ ) ៖ ក្រសួង មហាផ្ទៃ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី កាលបរិច្ឆេទ និង ទីកន្លែង ប្រឡង ជ្រើសរើស មន្ត្រីរាជការ ចូល បម្រើ ការងារ ក្នុង ក្របខណ្ឌ មន្ត្រី នគរបាល ជាតិ សម្រាប់ រាជធានី - ខេត្ត នានា ដោយ ក្នុង នោះ ក្រសួង បាន បញ្ជាក់ ថា សម័យ ប្រឡង នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃចន្ទ ទី១០ ខែធ្នូ ឆ្នាំ ២០១៨ វេលា ម៉ោង ៧៖០០ នាទី ព្រឹក ។
សូម កុំ បើកបរ ស្ថិត ក្រោម ស្ថានភាពងងុយដេក ! ស្លាប់ ៦នាក់ និង របួស ១២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៧ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ . របួស ស្រាល ៧នាក់ និង របួស ធ្ងន់ ១៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១១លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១២ គ្រឿង . រថយន្ត តូច ៤គ្រឿង និង រថយន្ដ ធុន ធំ ៤គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ . បត់ គ្រោះថ្នាក់ . ស្រវឹង និង ប្រជែង ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា បាន ឲ្យដឹង ថា កិច្ចប្រជុំ ខាងលើ នេះ នឹង លើក យក ប្រធានបទ ស្តីពី « ការជំរុញ ឲ្យ មាន ការរីកចម្រើន សេដ្ឋកិច្ច នៅ តំបន់ អាស៊ី » ។ មហាសន្និបាត នេះ នឹង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ រដ្ឋសភា ព្រឹទ្ធសភា បណ្តា ប្រទេស ដែល ជា សមាជិក សភា តំបន់ អាស៊ី ៤២ ប្រទេស គណៈប្រតិភូ បណ្តា ប្រទេស អ្នកសង្កេតការណ៍ ចំនួន ១៦ ប្រទេស និង អង្ក ការដៃគូរ សភា តំបន់ អាស៊ី ចំនួន ១០ ។
សូម ជម្រាប ថា សភា នៃ ព្រះរាណាចក្រ កម្ពុជា ធ្លាប់ បាន ទទួល ធ្វើជា ម្ចាស់ ផ្ទះ នៃ មហាសន្និបាត សភា តំបន់ អាស៊ី ចំនួន ២ ឆ្នាំ ជាប់ គ្នា គឺ មហាសន្និបាត សភា តំបន់ អាស៊ី លើក ទី៨ ក្នុង ឆ្នាំ ២០១៥ និង លើក ទី៩ ក្នុង ឆ្នាំ ២០១៦ ។
ការលើកឡើង របស់ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី បិទ មហាសន្និបាត តំណាង ទូទាំង ប្រទេស លើក ទី៤ របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា៖ « កិច្ចការ សំខាន់តែ ពីរ ទេ ដែល ក្តាប់ វា ឱ្យ ជាប់ ក្នុង ដៃ ជា ផែ ទីចង្អុល ផ្លូវ ទី១៖ គឺ បន្ត រួមចំណែក ការពារ នូវ សន្តិភាព ស្ថិរភាព នយោបាយ កុំ ឱ្យ រឿងរ៉ាវ អតីតកាល វិលត្រឡប់ មកវិញ រឿង នេះ គឺជា រឿង ដាច់ខាត តម្លៃ ណា ក៏ដោយ ត្រូវ ធ្វើ កុំ ឱ្យ ដិវត្តន៍ ពណ៌ កើត នៅ កម្ពុជា ឱ្យ សោះ » ។
ជាមួយគ្នា នេះ ដែរ នាយក រដ្ឋមន្ត្រី កម្ពុជា ដ៏ មាន ប្រជាប្រិយភាព រូប នេះ បាន មានប្រសាសន៍ អំពាវនាវ ដល់ យុវជន ឱ្យ បន្ត រួមគ្នា ប្រឹងប្រែង ជួយ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង សង្គម និង មិន ត្រូវ យក អធិបតេយ្យ ជាតិ ទៅ ដោះដូរ ជាមួយ ជំនួយ នោះ ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ធ្ងន់ ៗ ទៀត ថា៖ « ខ្ញុំ បញ្ជាក់ សារជាថ្មី កម្លាំងប្រដាប់អាវុធ និង រដ្ឋបាល ស៊ីវិល អព្យាក្រឹត បាន តែ ចំពោះ មុខ គណបក្ស នយោបាយ និង គណបក្ស នយោបាយ ទេ តែ មិន អនុញ្ញាតិ ឱ្យ អព្យាក្រឹត រវាង រដ្ឋាភិបាល ជាមួយ គណបក្ស នយោបាយ ដែល ប៉ុនប៉ង់ ផ្តួររំលំ គេ បង្កើត កម្លាំងប្រដាប់អាវុធ និង រដ្ឋបាល ដើម្បី ការពារ រដ្ឋ សូម កុំ ភាន់ ច្រឡំ លើ ចំណុច នេះ ឱ្យ សោះ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ ប្រាប់ អ្នកគាំទ្រ ថា សូម កុំ ខ្លាច ចំពោះ ក្រុម អ្នកប្រឆាំង ព្រោះ បើ មិន ប្រឆាំង គឺ មិន មែន ឈ្មោះ ជា អ្នក ប្រឆាំង នោះ ឡើយ ប៉ុន្តែ ប្រឆាំង យ៉ាងណា ក៏ដោយ ត្រូវតែ គោរ និង ឱ្យ តម្លៃ លើ ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ជា ធំ ដើម្បី ភាពរីកចម្រើន របស់ ប្រជាតិ ទាំងមូល ហើយ សកម្មភាព ប្រឆាំង ណាមួយ ក៏ ត្រូវតែ ដាក់ គោលការណ៍ ឱ្យ បាន ច្បាស់លាស់ មិន មែន នាំគ្នា ប្រឆាំង ដើម្បី តែ ប្រយោជន៍ បុគ្គល ណាមួយ នោះ ទេ ។
សម្តេច តេជោ ក៏ បាន ផ្តាំ ដល់ យុវជន ថា ចាប់ អ្វី ត្រូវ ចាប់ ឱ្យ ប្រាកដ ហើយ ត្រូវ ពង្រឹង សមត្ថភាព ខ្លួន ងើប ឡើង ក្នុង នាម ជា ប្រជាជាតិ ស្មើ មុខ ស្មើ មាត់ ជាមួយ ប្រជាជាតិ ដទៃ ។ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី កម្ពុជា ក៏ បាន ផ្តាំផ្ញើ ទៅ យុវជន ខ្មែរ ទាំងអស់ កុំ ឆ្វេង កុំ ស្តាំ ត្រូវ រក ចំណុច កណ្តាល មួយ ដើម្បី ភាពជោគជ័យ របស់ ខ្លួន ស្រប តាម ភាពឈ្លាស វ៉ៃ របស់ ខ្លួន មាន នៅក្នុង សម័យ ឌីជី ផល នេះ ៕
សម្តេច តេជោ ហ៊ុន សែន៖ ធ្វើជា មេដឹកនាំ លំបាក ត្រូវតែ ហ៊ាន លះបង់ បើ ទោះបី ការលះបង់ នោះ ធំ រហូត លះបង់ អាយុជីវិត ក៏ ត្រូវ ធ្វើ ដែរ ដើម្បី ប្រយោជន៍ សង្គមជាតិ និង ប្រជាជន (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន លើកឡើង ពី ភាពអង់អាច ក្លាហាន ថា ធ្វើជា មេដឹកនាំ លំបាក ប៉ុន្តែ ត្រូវតែ ហ៊ាន លះបង់ បើ ទោះបី ការលះបង់ នោះ ធំ រហូតដល់ លះបង់ អាយុជីវិត ក៏ ត្រូវ ធ្វើ ដែរ ដើម្បី ប្រយោជន៍ សង្គមជាតិ និង ប្រជាជន ។
ការលើកឡើង របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅក្នុង ឱកាស ដែល សម្តេច តេជោ បាន អញ្ជើញ ជា អធិបតីភាព ពិធី បិទ មហាសន្និបាត តំណាង ទូទាំង ប្រទេស លើក ទី៤ របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) ដែល ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា រូប នេះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ៖ « បើ ធ្វើជា មេដឹកនាំ គេ ត្រូវតែ ហ៊ាន លះបង់ បើ ទោះបីជា តម្លៃ នៃ កាលះបង់ នោះ វា ធំ ធេង ប៉ុណ្ណា រហូតដល់ ជីវិត ក៏ ត្រូវតែ ហ៊ាន ធ្វើ ដែរ ដើម្បី អនាគត ប្រទេសជាតិ ដើម្បី សេចក្តីសុខ របស់ អ្នកដទៃ ខ្ញុំ គួរតែ និយាយ អំពី បទពិសោធន៍ សម្រាប់ ផ្ទាល់ខ្លួន របស់ ខ្ញុំ ប៉ុណ្ណោះ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន បន្ត ថា គ្មាន ការទទួលបាន ផលប្រយោជន៍ ណាមួយ ដោយ មិន បាន បង់ ថ្លៃ នោះ ទេ គឺ មាន តែ ពួក ប្រឆាំង ផ្គាប់ មុខ តែ ប៉ុណ្ណោះ ដែល ដេក រងចាំ ស្រមើលស្រមៃ ទទួល ផល ពី ការដួលរលំ នៃ រដ្ឋអំណាច របស់ សម្តេច ។ ប៉ុន្តែ ពួក អ្នក ទន្ទឹងរង់ចាំ ពី ការដួលរលំ នៃ របប សម្តេច ព្រះនរោត្តម សីហនុ ក៏ សុទ្ធតែ ទទួលបាន ការបរាជ័យ រួចទៅហើយ ហើយ អ្នក ដែល ទន្ទឹងរងចាំ ការដួលរលំ របស់ របប លន់ ណុល ក៏ ទទួលបរាជ័យ រួចទៅហើយ អ្វី ដែល យើង ទទួលបាន គឺ តែងតែ ទទួលបាន នូវ ការបង់ ថ្លៃ ជានិច្ច គ្រាន់តែ តិច ឬ ច្រើន តែ ប៉ុណ្ណោះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក ថា ទម្រាំ មាន ថ្ងៃ នេះ មាន មនុស្ស ស្លាប់ ច្រើន ណាស់ ដើម្បី ជាតិ មាតុភូមិ កម្ពុជា គឺ ស្លាប់ ដោយ ទទួលរង នូវ អំពើ ព្រៃផ្សៃ បំផុត គឺ ដោយសារ គេ វ៉ៃ គេ បាញ់ និង ទម្លាក់ គ្រាប់បែក គ្រប់ បែបយ៉ាង ប៉ុន្តែ មាន មួយ ប៉ែក ស្លាប់ ដោយសារ កាលះបង់ ដើម្បី ការពារ សេចក្តីសុខ ជូន ប្រជាជន ដើម្បី ការរស់រាន មាន ជីវិត ។ ហើយ សម្តេច បាន យក ជីវិត របស់ សម្តេច ទៅ ប្តូរ យក នូវ ស្ថានភាព ដូច ពេល បច្ចុប្បន្ន នេះ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន មានប្រសាសន៍ បញ្ជាក់ ថា តើ នៅលើ លោក នេះ មាន មេដឹកនាំ ប៉ុន្មាន នាក់ ហើយ ដែល ហ៊ាន ប្រថុយ ជីវិត ចូលទៅ ជំរុំ របស់ សត្រូវ គឺ សម្តេច បាន ប្រើប្រាស់ ជីវិត របស់ ខ្លួន មក ធ្វើជា ដើមទុន ដើម្បី ប្តូរ យក សុខ សន្តិភាព រហូតដល់ បច្ចុប្បន្ន នេះ ៕
សម្ភារ ប្រើប្រាស់ មួយចំនួន ត្រូវបាន ប្រគល់ ជូន កម្លាំង នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម សម្រាប់ ចូលរួម មិទ្ទីញ ថ្ងៃ ០២ធ្នូ ស្រុក ស្នួល ខេត្ត ក្រចេះ
( កំពង់ចាម ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី សិត សិលា . លោក ឧត្តមសេនីយ៍ ត្រី សំ ហេង និង លោក ឧត្តមសេនីយ៍ ត្រី ចាន់ រស្មី តំណាង លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម នៅ រសៀល ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន យក សម្ភារ ប្រើប្រាស់ មួយចំនួន ប្រគល់ ជូន កម្លាំង នគរបាល អន្តរាគមន៍ ពិសេស សម្រាប់ ចូលរួម ក្នុង ពិធី មិទ្ទីញ ថ្ងៃ ០២ធ្នូ ស្រុក ស្នួល ខេត្ត ក្រចេះ ។
សម្ភារ ប្រើប្រាស់ ដែល ជា អំណោយ របស់ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ទាំងអស់ នោះ រួម មាន អាវយឺត នគរបាល ពណ៌ ត្រេអ៊ី ចំនួន ៦៦ អាវ និង ខ្សែក្រវ៉ាត់ សាន់ត្រុង ចំនួន ៦០ ។
ក្នុង ឱកាស នោះ ផងដែរ កងកម្លាំង អន្តរាគមន៍ ទាំងអស់ បាន ថ្លែងអំណរគុណ លោក ឧត្តមសេនីយ៍ ទោស្នងការ ដែល តែងតែ យក ចិត្តទុកដាក់ ដល់ មន្ត្រី ក្រោម ឱវាទ និង សូមឲ្យ លោក កាន់តែ ជោគជ័យ ក្នុង ភារកិច្ច ជា ថ្នាក់ដឹកនាំ ។
សូម ជម្រាប ថា ២ ធ្នូ ថ្ងៃ នេះ គឺជា ខួប ៤០ ឆ្នាំ ( ២ ធ្នូ ១៩៧៨ - ២ ធ្នូ ២០១៨ ) ដែល ប្រជាពលរដ្ឋ ខ្មែរ ជាពិសេស កម្លាំង យុវជនរង ការធ្វើទុក្ខ ម្នេញ និង ជិះ ជាន់ យ៉ាង វេទនា ពីរ បប កម្ពុជា ប្រជាធិបតេយ្យ ដឹកនាំ ដោយ ប៉ុល ពត ខៀវ សំផន និង អៀង សារី បាន រួបរួម ពូន កម្លាំង គ្នា ជា ធ្លុង ដើម្បី ផ្តួល នូវ ដ៏ យង់ឃ្នង និង សម្លាប់ រង្គាល មួយ នេះ ហើយក៏ ជា ជំហាន ស្រោចស្រង់ កម្ពុជា ចេញពី គំនរ ផេះ ផង់ មក រក ភាពរីកចម្រើន នា ពេល បច្ចុប្បន្ន ផងដែរ ៕
យោង តាម Stockholmcf គំនិត ប្រមូលផ្ដុំ ការបង្រួបបង្រួម បណ្ដា ប្រទេស អ្នក កាន់ សាសនា អ៉ី ស្លាម ត្រូវបាន ធ្វើឡើង ដោយ មន្ត្រី ទីប្រឹក្សា ជាន់ ខ្ពស់ របស់ លោក អឺ ដូហ្កាន់ ដែល បាន បញ្ចុះបញ្ចូល តំណាង ប្រជាជាតិ អ៉ី ស្លាម ជាច្រើន ក្នុង អំឡុង ពិធី ជួបជុំ នៅ ទីក្រុង អ៉ីស្ដង់ ប៊ូល នា ពេល ថ្មី ៗ នេះ ។ បន្ថែម ពីលើ នេះ គេហទំព័រ នេះ ដដែល បាន ឱ្យដឹង ទៀត ថា គំនិត ប្រមូលផ្ដុំ អ៉ី ស្លាម តែ មួយ នឹង ត្រូវ ដឹកនាំ ដោយ ប្រធានាធិបតី តួកគី លោក អឺ ដូហ្កាន់ នៅ ដើម ឆ្នាំ ២០២៣ ។
សូម ជម្រាប ថា បើ តាម Stockholmcf ទីប្រឹក្សា ជាន់ ខ្ពស់ ជាច្រើន របស់ លោក អឺ ឌូហ្កាន់ មាន បំណង រៀបចំ សន្និសីទ ឬ ការជួបជុំ នៃ អ្នកតំណាង មកពី ប្រទេស អ្នក កាន់ សាសនា អ៉ី ស្លាម ជារៀងរាល់ ឆ្នាំ រហូតដល់ ឆ្នាំ ២០២៣ ជា ឆ្នាំ ដែល តួកគី នឹង ប្រារព្ធ ខួប លើក ទី ១០០ ឆ្នាំ នៃ ការបង្កើត សាធាណ រដ្ឋ តួកគី ។ ការជ្រើសយក កាលបរិច្ឆេក នេះ ទៀតសោត ទំនងជា លោក អឺ ដូហ្កាន់ ចង់ ប្រើ វា ដើម្បី បង្កើត គំនិត មួយ ត្រឡប់ ទៅ រក ភាព ខ្លាំងក្លា នៃ អាណាចក្រ អូតូម៉ង់ ៕
ការប្រកាស របស់ សម្ដេច ប្រមុខ នៃ រាជ រដ្ឋាភិបាល ត្រូវបាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី រួម ជាមួយ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បិទ មហាសន្និបាត តំណាង ទូទាំង ប្រទេស លើក ទី៤ របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) ដែល ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។
បន្ថែម ពី នេះ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ក៏ បាន គូស រំលេច ថា ទណ្ឌិត សម រង្ស៊ី ដែល កំពុង រត់ គេច ពី សំណាញ់ ច្បាប់ របស់ កម្ពុជា ទៅ ជ្រកកោន នៅ បរទេស តែងតែ ព្យាយាម បង្ហោះ សារ ក្នុង Facebook និង ប្រើប្រាស់ គ្រប់ វិធី ទាំងអស់ ដើម្បីឲ្យ សម្ដេច ធ្វើ ការ តបត ខណៈ ដែល សម្ដេច ដឹង ច្បាស់ ថា ទណ្ឌិត រូប នេះ លែង ជា មនុស្ស ដែល គេ យកចិត្តទុកដាក់ ហើយ ដូច្នេះ វិធី តែ មួយ គិត គឺ ព្យាយាម ឆ្កិះ សម្ដេច ឲ្យ និយាយ ជេរ ត្រឡប់ ទៅវិញ ។
ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ផ្ដាំផ្ញើ ទៅ មន្ដ្រី រាជ រដ្ឋាភិបាល និង អ្នកគាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ កុំ ខ្លាច ចំពោះ ក្រុម អ្នកប្រឆាំង ព្រោះ បើ មិន ប្រឆាំង គឺ មិន មែន ឈ្មោះ ជា អ្នក ប្រឆាំង នោះ ឡើយ ប៉ុន្តែ ត្រូវ គោរព តម្លៃ ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ដោយ មិន ធ្វើឲ្យ ប៉ះពាល់ ដល់ ផលប្រយោជន៍ ពលរដ្ឋ ឲ្យ សោះ ។
យ៉ាងណា ក៏ដោយ បុរស ខ្លាំង កម្ពុជា ដែល ហ៊ាន លះបង់ ជីវិត របស់ ប្រជាជាតិ និង មាតុភូមិ ដោយ មិន ខ្លាច នឿយហត់ រូប នេះ ក៏ បាន ឆ្លៀត ផ្តាំ ទៅ យុវជន ទាំងអស់ ថា ត្រូវ បន្ត រួមចំណែក ការពារ នូវ សន្តិភាព ស្ថេរភាព នយោបាយ កុំ ឲ្យ រឿងរ៉ាវ អតីតកាល ត្រឡប់ មកវិញ ពោល តម្លៃ ណា ក៏ដោយ កុំ ឲ្យ បដិវត្តន៍ ពណ៌ កើតមាន នៅ កម្ពុជា និង អំពាវនាវ ដល់ យុវជន ឲ្យ បន្ត រួមគ្នា ប្រឹងប្រែង ជួយ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង សង្គម និង មិន ត្រូវ យក អធិបតេយ្យ ជាតិ ទៅ ដោះដូរ ជាមួយ ជំនួយ នោះ ឡើយ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ មេបញ្ជាការ យោធា អាមេរិក មួយ រូប បាន ឲ្យដឹង នា ថ្ងៃចន្ទ សប្តាហ៍ នេះ ថា យន្តហោះ ទម្លាក់ គ្រាប់បែក របស់ អាមេរិក លែង ធ្វើ ការហោះហើរ បង្ហាញ សាច់ដុំ នៅលើ ឧបទ្វីប កូរ៉េ ទៀត ហើយ បន្ទាប់ពី កូរ៉េ ខាងត្បូង បាន ស្នើសុំ ឲ្យ ផ្អាក ការធ្វើ សកម្មភាព នេះ ៕
២៖ មាន សេចក្តីរាយការណ៍ ថា ជប៉ុន កំពុង ពិចារណា ទិញ យន្តហោះ ចម្បាំង ជំនាន់ ថ្មី F-35 រហូតដល់ ១០០ គ្រឿង ពី សហរដ្ឋ អាមេរិក ក្នុង តម្លៃ ជាង ៨. ៨ ពាន់ លាន ដុល្លារ ខណៈ ដែល ទីក្រុង តូក្យូ កំពុង ព្យាយាម ទប់ទល់ ការរីកធំ ឡើង នៃ ឥទ្ធិពល យោធា ចិន នៅក្នុង តំបន់ ៕
៤៖ អង្គការ សហ ប្រជាជាតិ (UN) នា ថ្ងៃចន្ទ សប្តាហ៍ នេះ បាន ប្រកាស ផ្តល់ ជំនួយ ផ្នែក សុខាភិបាល និង អាហារូបត្ថម្ភ ដែល មាន ទំហំ ទឹកប្រាក់ ៩.២លាន ដុល្លារ សម្រាប់ ប្រទេស វេណេស៊ុយអេឡា ដែល ប្រជាជន កំពុង ជួបប្រទះ ភាពអត់ឃ្លាន ព្រមទាំង ជំងឺ ឈឺថ្កាត់ ផ្សេង ៗ នៅ ចំពោះមុខ ការដួលរលំ នៃ ប្រព័ន្ធ សេដ្ឋកិច្ច បែប សង្គម និយម នៃ ប្រទេស អាមេរិក ឡាទីន មួយ នេះ ៕
៥៖ ខណៈ ដែល ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន អំពាវនាវ ឲ្យ ទម្លាក់ ថ្លៃ ប្រេង អារ៉ាប៊ី សាអូឌីត បាន បង្កើន ការផលិត ប្រេង របស់ ខ្លួន ក្នុង ខែវិច្ឆិកា នេះ ដល់ កម្រិត ខ្ពស់ បំផុត ពុំ ធ្លាប់ មាន ក្នុង ប្រវត្តិសាស្រ្ត ៕
តាម គម្រោង គណៈប្រតិភូ ជាន់ ខ្ពស់ សភា នឹង ចូលរួម ក្នុង កិច្ចប្រជុំ គណៈកម្មាធិការ ប្រតិបត្តិ លើក ទី២ និង មហាសន្និបាត លើក ទី ១១ របស់ សភា តំបន់ អាស៊ី APA ចាប់ពី ថ្ងៃទី ២៧ ខែវិច្ឆិកា ដល់ ថ្ងៃទី ០៤ ខែធ្នូ ឆ្នាំ ២០១៨ ។ ក្រៅពី នោះ លោក បណ្ឌិត ងួន ញ៉ិល និង គណៈប្រតិភូ ក៏ នឹង អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ពាក់ព័ន្ធ ជាច្រើន ផ្សេង ៗ ទៀត ផងដែរ ។ មហាសន្និបាត លើក ទី ១១ របស់ សភា តំបន់ អាស៊ី APA រៀបចំឡើង ក្រោម ប្រធានបទ « ការជំរុញ ឱ្យ មាន ការរីកចម្រើន សេដ្ឋកិច្ច នៅ តំបន់ អាស៊ី » ។
មហាសន្និបាត នេះ នឹង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ រដ្ឋសភា ព្រឹទ្ធសភា បណ្តា ប្រទេស ដែល ជា សមាជិក សភា តំបន់ អាស៊ី ៤២ ប្រទេស គណៈប្រតិភូ បណ្តា ប្រទេស ជា អ្នកសង្កេតការណ៍ ចំនួន ១៦ ប្រទេស និង អង្គការ ដៃគូ សភា តំបន់ អាស៊ី ចំនួន ១០ ។
សូម ជម្រាប ថា សភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ធ្លាប់ បាន ទទួល ធ្វើជា ម្ចាស់ ផ្ទះ នៃ មហាសន្និបាត សភា តំបន់ អាស៊ី ចំនួន ២ឆ្នាំ ជាប់ គ្នា គឺ មហាសន្និបាត សភា តំបន់ អាស៊ី លើក ទី៨ ក្នុង ឆ្នាំ ២០១៥ និង លើក ទី៩ ក្នុង ឆ្នាំ ២០១៦ ៕ ទាស់ គ្នា ហើយ ! អង់គ្លេស រិះគន់ សម្តី បែប គំរាមកំហែង របស់ ប្រធានាធិបតី ម៉ាក្រុង ជុំវិញ បញ្ហា ពាណិជ្ជកម្ម អង់គ្លេស - អឺរ៉ុប និង ការធ្វើ នេសាទ ដែន សមុទ្រ
គួរ ជម្រាប ថា ចក្រភព អង់គ្លេស នឹង ត្រូវ ដក ខ្លួន ចេញ ពី សហភាព អឺរ៉ុប នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ ពោលគឺ ក្នុង រយៈពេល ជិត ០៣ ឆ្នាំ ក្រោយ ប្រជាជន អង់គ្លេស ក្នុង សំឡេង ភាគ ច្រើន បាន សម្រេច ជ្រើសរើស យក ផ្លូវ នេះ តាមរយៈ ការធ្វើ ប្រជាមតិ នៅ អំឡុង ឆ្នាំ ២០១៦ ។ ទោះបីជា បែប នេះ ក្តី សហភាព អឺរ៉ុប ក៏ ធ្លាប់ បាន សំណូមពរ ផងដែរ ឲ្យ អង់គ្លេស ពន្យារ ពេល នៃ ការដក សមាជិកភាព នេះ សិន ព្រោះ នៅ មាន បញ្ហា ជាច្រើន ទៀត ដែល អាច មិន អាច ដោះស្រាយ ទាន់ កាល កំណត់ នៅ មុន ខែមីនា ឆ្នាំ ២០១៩ នោះ ឡើយ ៕
សម្តេច ក្រឡាហោម ស ខេង ដឹកនាំ កិច្ចប្រជុំ ធ្វើ សេចក្តីព្រាង ច្បាប់ ថ្មី ដើម្បី ការពារ ព្រៃឈើ និង ធនធាន ធម្មជាតិ កម្ពុជា
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៧ ខែវិច្ឆិកា នេះ លទ្ធផល៖ បង្ក្រាប ២៤ ករណី ឃាត់ខ្លួន ៤៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
អាជ្ញាធរ ស្រុក ឆ្លូង ចុះ ណែនាំ ពលរដ្ឋ ឱ្យ ប្រុងប្រយ័ត្ន និង ហាមឃាត់ មិន ឱ្យ សាងសង់ លំនៅដ្ឋាន តាម មាត់ ច្រាំង ទន្លេ ព្រោះ ងាយ រងគ្រោះ ដោយសារ ការបាក់ ច្រាំង
( ក្រចេះ ) ៖ លោក ហេង សុថា អភិបាល ស្រុក ឆ្លូង នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ ចុះ ណែនាំ ឱ្យ មាន ការប្រុងប្រយ័ត្ន និង ហាមឃាត់ មិន ឱ្យ សាងសង់ លំនៅដ្ឋាន តាម មាត់ ច្រាំង ទន្លេ ឬ ក៏ ជួសជុល លំនៅដ្ឋាន ដែល រង ការខូចខាត នោះ និង ការសាងសង់ បន្ថែម ព្រោះ ងាយ រងគ្រោះ ដោយសារ ការបាក់ ច្រាំង ។
ការចុះ ណែនាំ របស់ អភិបាល ស្រុក ឆ្លូង ធ្វើឡើង បន្ទាប់ពី លោក បាន ទទួល ដំណឹង ថា មាន ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ៥ខ្នង ដែល បាន សាងសង់ នៅ តាម មាត់ ទន្លេ ប្រឈម និង ការបាក់ ស្រុត មាន តែ មិន ខូចខាត ទាំងស្រុង ទេ ។
លោក ហេង សុថា បាន បន្ត ថា ផ្ទះ ប្រជាពលរដ្ឋ ដែល ស្ថិត នៅ ភូមិ កោះ កណ្តុរ តាម បណ្ដោយ មាត់ ទន្លេ ចាប់ពី វត្ត វេទី រហូតដល់ ស្ពាន ឆ្លូង ប្រឈម ការបាក់ ស្រុត ច្រាំង ទន្លេ ដូច្នេះ សូម ប្រជាពលរដ្ឋ ដែល មាន លំនៅដ្ឋាន នៅ ទីតាំង ខាងលើ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ឱ្យ បាន ខ្ពស់ បំផុត ។
ជាមួយគ្នា នេះ ដែរ លោក ហេង សុថា ក៏ បាន ចុះ ទៅ ពិនិត្យ ផ្ទះ ប្រជាពលរដ្ឋ មួយ ខ្នង ដែល បាន បាក់ ស្រុត និង បណ្ដាលឱ្យ ទុស្សេ ខ្សែភ្លើង ឆាបឆេះ អស់ ទាំងស្រុង ក្រោយពី ភ្លៀង ធ្លាក់ ១យប់ ១ ថ្ងៃ បាន បាក់ ច្រោះ ដី ច្រាំង ទន្លេ ។ ហេតុការណ៍ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ៧៖ ១៥ នាទី យប់ ថ្ងៃទី ២៦ ខែវិច្ឆកា ឆ្នាំ ២០១៨ នៅ ភូមិ កោះ កណ្ដុរ ឃុំ ឆ្លូង ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ឱ្យដឹង ថា ម្ចាស់ ផ្ទះ ឈ្មោះ ឡាំ យាំង គៀង ភេទ ប្រុស អាយុ ៨២ ឆ្នាំ ជនជាតិ វៀតណាម មាន ផ្ទះ ១ ខ្នង ទំហំ ៥ម៉ែត្រ គុណ ៨ម៉ែត្រ ត្រូវបាន បាក់ ស្រុត និង ឆេះ អស់ ទាំងស្រុង ខូចខាត់ សម្ភារ ក្នុង ផ្ទះ គិត ជា ទឹកប្រាក់ ប្រមាណ ជាង ២០០០ ដុល្លារ តែ មិន អ្នក រងរបួស ។ ក្នុង ហេតុការណ៍ នេះ នគរបាល ប្រើប្រាស់ រថយន្ដ ពន្លត់ អគ្គិភ័យ ដោយ បាញ់ ទឹក ពន្លត់ ប្រើ ទឹក ចំនួន ២ រថយន្ដ ទើប រលត់ ទាំងស្រុង ៕
សេចក្តីរាយការណ៍ ព័ត៌មាន នេះ បាន លេចឡើង ស្រប ពេល ដែល ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ កំពុងតែ ជំរុញ ឲ្យ ជប៉ុន ជួយ ទិញ បរិក្ខា យោធា ព្រមទាំង សម្ភារៈ អាមេរិក ដទៃ ៗ ទៀត ដោយ លើក ហេតុផល ថា ទីក្រុង វ៉ាស៊ីនតោន មាន គម្លាត ឱន ភាព ពាណិជ្ជកម្ម ធំ ខ្លាំង ជាមួយ ទីក្រុង តូក្យូ ។
ជាមួយគ្នា នេះ ទីក្រុង តូក្យូ ក៏ ត្រូវ គេ រាយការណ៍ ផងដែរ ថា កំពុង ពិចារណា កែលម្អ ឲ្យ ប្រសើរឡើង នូវ នាវា ដឹក ឧទ្ធម្ភាគចក្រ របស់ ខ្លួន ឈ្មោះ អ៊ីហ្ស៊ូ មុ (Izumo) ឲ្យ ទៅជា នាវា ដឹក យន្តហោះ ចម្បាំង ពេញលេញ មួយ តែម្តង ដែល ជា រឿង ដ៏ ចាំបាច់ មួយ នៅ ចំពោះមុខ ការបង្កើន ឥទ្ធិពល យោធា តាម ផ្លូវ សមុទ្រ របស់ ចិន ។
គួរ ជម្រាប ថា នៅក្រោម រដ្ឋធម្មនុញ្ញ សន្តិនិយម នា ពេល បច្ចុប្បន្ន យោធា នៃ ប្រទេស ជប៉ុន ត្រូវបាន ដាក់កំហិត ឲ្យ នៅ ត្រឹម មាន សិទ្ធិ តែ សម្រាប់ ការពារ ខ្លួន ឯង ប៉ុណ្ណោះ ហើយ ជប៉ុន មាន ការពឹងផ្អែក ធំ ធេង ទៅ លើ សហរដ្ឋ អាមេរិក ដោយ ឈរ លើ កិច្ចព្រមព្រៀង សន្តិសុខ ទ្វេ ភាគី ៕ រដ្ឋមន្ត្រី ថោង ខុន ប្រជុំ ត្រួតពិនិត្យ ការងារ ត្រៀម រៀបចំ ព្រឹត្តិការណ៍ នានា របស់ អនុគណៈកម្មការ ចូលរួម ពី ធី សម្ពោធ វិមាន ឈ្នះ ឈ្នះ
លោក រដ្ឋមន្ត្រី បាន ពិភាក្សា និង ពិគ្រោះយោបល់ ជាមួយ ក្រុមការងារ នីមួយ ៗ ដូចជា ស្ដង់ ពិព័រណ៍ សមិទ្ធផល ២០ ឆ្នាំ របស់ ក្រសួង - ស្ថាប័ន ពិព័រណ៍ សមិទ្ធផល របស់ រាជធានី - ខេត្ត ទាំង២៥ ពិព័រណ៍ ទេសចរណ៍ ពាណិជ្ជកម្ម ម្ហូប អាហារ ការសម្តែង ទស្សនីយភាព សិល្បៈ ព្រឹត្តិការណ៍ កីឡា និង ពិធី ឆ្លង ឆ្នាំ សកល ព្រម ជាមួយនឹង ការណែនាំ អំពី ការរៀបចំ រាល់ សកម្មភាព ពិព័រណ៍ សិល្បៈ កីឡា ឱ្យ បាន សម្បូរបែប និង ប្រកបដោយ ភាពទាក់ទាញ ។
តំបន់ ទាំង ៤នេះ ដែល មាន ការចូលរួម ពី គ្រប់ ក្រសួង - ស្ថាប័ន រដ្ឋបាល រាជធានី - ខេត្ត និង ស្ដង់ ពិព័រណ៍ ពាណិជ្ជកម្ម ទេសចរណ៍ ម្ហូប អាហារ និង ការវិនិយោគ របស់ ក្រុមហ៊ុន នានា និង មាន ការចូលរួម ពី ប្រទេស ជា មិត្ត មួយចំនួន ផងដែរ ។
ដោយឡែក ចំពោះ ពិព័រណ៍ សមិទ្ធផល ក្រសួង - ស្ថាប័ន បាន ត្រៀម រួចរាល់ ហើយ រីឯ ពិព័រណ៍ ពាណិជ្ជកម្ម ទេសចរណ៍ ម្ហូប អាហារ វិនិយោគ ក្រុមការងារ បាន ទទួល ការចុះឈ្មោះ បាន ជាង ៧០ % ហើយ ។
ចំពោះ ព្រឹត្តិការណ៍ និង សកម្មភាព កីឡា មាន ១២ ប្រភេទ កីឡា ហើយ ដែល បាន ត្រៀម រួចរាល់ ហើយ រីឯ កម្មវិធី ឆ្លង ឆ្នាំ សកល ក៏ បាន ត្រៀម រៀបចំ រួចរាល់ហើយ ទាំង កម្មវិធី ព្រឹត្តិការណ៍ ឆ្លង ឆ្នាំ ទាំង កម្មវិធី លៀង សាយ ភោជន៍ ។
លោក រដ្ឋមន្ត្រី បាន ក្រើន រំលឹក សុំ ឱ្យ គ្រប់ ផ្នែក ក្នុង អនុគណៈកម្មការបន្ត សហការ គ្នា និង បន្ត សហការ ជាមួយ អនុគណៈកម្មការ ដទៃ ឱ្យ បាន ល្អ ដើម្បី ជោគជ័យ ត្រចះត្រចង់ នៃ ពិធី បុណ្យ នេះ ៕
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង និង ផ្ដល់ ឋានៈ ជា ទីប្រឹក្សា គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ចំនួន ០៦ រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង និង ផ្ដល់ ឋានៈ ជា ទីប្រឹក្សា គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ចំនួន ០៦ រូប ដែល មាន ឋានៈ ស្មើ អនុ រដ្ឋលេខាធិការ ។
សូម អាន ខ្លឹមសារ លម្អិត នៃ ព្រះរាជ ក្រឹត្យ ដែល មាន នៅ ខាងក្រោម នេះ៖ ចាប់ខ្លួន ៤នាក់ កាង គ្រឿងចក្រ កាយ ឈូសឆាយ ដី នៅ តំបន់ គម្រប ព្រៃឈើ ក្នុង ស្រុក ព្រៃនប់ ឆ្នាំ ២០០២. អភិបាល ខេត្ត ព្រះសីហនុ ព្រមាន តាម ចាប់ ជនល្មើស កាង ដី អនាធិបតេយ្យ បញ្ជូន ទៅកាន់ តុលាការ
( ព្រះសីហនុ) ៖ បន្ទាប់ពី បាន ចាប់ ក្រុមកាង ដី ប្រដាប់អាវុធ នៅ កោះ ក្របី ស្រុក ព្រៃនប់ រួច ត្រូវបាន តុលាការ ចេញ ដីកា ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ សមត្ថកិច្ច នគរបាល ស្រុក ព្រៃនប់ ក៏ បាន បន្ត ធ្វើ ការឃាត់ខ្លួន ក្រុម ជើង ខ្លាំង ចំនួន ៤នាក់ ផ្សេង ទៀត ដែល ធ្វើ សកម្មភាព កាង ដី នៅ តំបន់ ភូមិ ពូធឿង ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ យកមក សួរ នាំ ដែល ពួកគេ បាន កាង ដី ឲ្យ ឈ្មោះ ថៃ ធី គាវ ក្នុង ការឈូសឆាយ ដោយ គ្មាន ច្បាប់ ព្រោះតែ អាង អ្នក មាន អំណាច នៅ ពីក្រោយ ខ្នង ។
ការឃាត់ខ្លួន ជនល្មើស ទាំង ៤នាក់ នេះ បាន ធ្វើឡើង បន្ទាប់ពី ក្រុម នេះ បាន ទៅ កាង គ្រឿងចក្រ កាយ ឈូសឆាយ ដី នៅ តំបន់ គម្រប ព្រៃឈើ ឆ្នាំ ២០០២ ស្ថិត នៅ តំបន់ ភូមិ ពូធឿង ឃុំ បិត្រាំង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ កាលពី ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ដោយ សំអាង ថា ដី នេះ មាន ប័ណ្ណ តាំងពី ឆ្នាំ ១៩៩៦ ។
មួយវិញទៀត ប័ណ្ណ ទាំង នេះ ត្រូវបាន និរាកណ៍ អស់ ទៅ ហើយ បន្ទាប់ពី រដ្ឋាភិបាល បាន ដាក់ តំបន់ នេះ ជា តំបន់ គម្រប ព្រៃឈើ ឆ្នាំ ២០០២មក ។ ប៉ុន្តែ ប័ណ្ណ នេះ ត្រូវបាន អ្នក មាន លទ្ធភាព មួយចំនួន នៅតែ យកមក ប្រើ ក្នុង ការកាន់កាប់ ដី នេះ ដែរ ។
លោក យន្ត មីន អភិបាល ខេត្ត ព្រះសីហនុ បាន ព្រមាន ថា លោក នឹង ចាត់ វិធានការក្តៅ តាម ច្បាប់ ដោយ គ្មាន ការលើកលែង ឡើយ ទោះជា អ្នក នោះ ជា នរណា ក៏ដោយ ។ គួរ រំលឹក ថា កន្លងមក រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ប្រើ វិធានការ ច្បាប់ លើ ក្រុម អានាធិបតេយ្យ និង អ្នកកាង អាង ខ្នង បង្អែក អ្នក មាន អំណាច នៅ ពីក្រោយ ខ្នង បានជាច្រើន ករណី មក ហើយ ។
ចំពោះ ជនល្មើស ទាំង ៤នាក់ នេះ ដែរ នគរបាល ស្រុក ព្រៃនប់ កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ដើម្បី ចាត់ការ បន្ត នៅ រសៀល ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ។
លោក ហួ យ៉ៃ អធិការ នគរបាល ស្រុក ព្រៃនប់ បាន ឲ្យដឹង ថា ជនល្មើស ទាំង ៤នាក់ នេះ រួម មាន៖
ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ កម្ពុជា ត្រូវ ជ្រើសតាំង ជា ប្រធាន កិច្ចប្រជុំ ស្តីពី ការពិនិត្យ ឡើងវិញ ការអនុវត្ត ការប្តេជ្ញាចិត្ត របស់ អន្តរ រដ្ឋាភិបាល អាស៊ី - ប៉ាស៊ីហ្វិក លើ បញ្ហា មេរោគ អេដស៍ ជំងឺ អេដស៍
អង្គប្រជុំ បាន លើកឡើង ម្តង ហើយ ម្តង ទៀត និង ឯកភាព គ្នា ថា « ទោះបីជា មាន វឌ្ឍនភាព ក្នុង ការប្រយុទ្ធ នឹង ជំងឺ អេដស៍ នៅក្នុង តំបន់ ក៏ដោយ ក៏ មេរោគ អេដស៍ មិន ទាន់ ចប់ នៅឡើយ ទេ ។ ដូច្នេះ យើង ត្រូវ ជម្នះ នូវ បញ្ហា នានា ដើម្បី ឈានទៅ សម្រេចបាន នូវ គោលដៅ នានា ដែល បាន ដាក់ចេញ ដោយ អង្គការ សហ ប្រជាជាតិ ក្នុង ការបញ្ចប់ ជំងឺ អេដស៍ នៅ ឆ្នាំ ២០៣០» ។ នេះ បើ តាម មន្រ្តី ជាន់ ខ្ពស់ នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ កម្ពុជា បាន បន្ថែម ៕
ចាប់តាំងពី ខែតុលា មក ជន អន្តោប្រវេសន៍ ច្រើន ជាង ៥.០០០ នាក់ មកពី បណ្ដា ប្រទេស ក្នុង តំបន់ អាមេរិក កណ្ដាល ជាពិសេស គឺ អ៊ែល សាល វ៉ាឌ័រ El Salvador បាន ធ្វើដំណើរ ក្នុង ចំងាយ ផ្លូវ រាប់ ពាន់ គីឡូម៉ែត្រ ដោយ ខ្លះ ដើរ និង អ្នក ខ្លះ ទៀត ជិះ រថយន្ដក្រុង ដើម្បី ធ្វើដំណើរ ឆ្ពោះ មកកាន់ សហរដ្ឋ អាមេរិក ជា ទី ដែល ពួកគេ សង្ឃឹម ថា អាចនឹង កសាង ជីវិត ថ្មី មួយ ដ៏ ប្រសើរ ជាង នៅ ប្រទេស កំណើត របស់ ពួកគេ ។
ចំណែកឯ ជន អន្តោប្រវេសន៍ ផ្សេង ទៀត ក៏ បាន សរសេរ រៀបរាប់ ផងដែរ ថា រូប គេ រំពឹង ទៅដល់ សហរដ្ឋ អាមេរិក ព្រោះតែ ចង់ គេច ចេញ ពី ក្រុម ឧក្រិដ្ឋ ជន ដែល មិន មែន ត្រឹមតែ បង្ក ការភ័យខ្លាច នៅក្នុង ប្រទេស El Salvador នោះ ទេ តែ នៅក្នុង តំបន់ អាមេរិក កណ្ដាល ថែម ទៀត ។ ការធ្វើដំណើរ ទៅដល់ សហរដ្ឋ អាមេរិក គឺជា ក្ដីស្រម៉ៃ និង ក្ដីសង្ឃឹម ចុងក្រោយ ក្នុង ការស្វែងរក អនាគត ថ្មី និង ជីវិត រស់ នៅ ប្រកបដោយ ភាពថ្លៃថ្នូរ ។
គួរ ជម្រាប ថា ជុំវិញ បញ្ហា អន្តោប្រវេសន៍ ដែរ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន ព្រមាន ជា បន្តបន្ទាប់ ថា ទីក្រុង វ៉ាស៊ីនតោន អាចនឹង បិទ ព្រំដែន ភាគ ខាងត្បូង ជាប់ ជាមួយ ប្រទេស ម៉ិចស៉ី កូជា អចិន្ត្រៃយ៍ តែម្ដង ក្នុង ករណី ចំបាច់ បន្ទាប់ពី មាន ការប៉ះទង្គិច គ្នា ដោយ ហិង្សា រវាង ឆ្មំា ព្រំដែន និង ជន អន្តោប្រវេសន៍ ៕
សិស្សសាលារៀន អន្តរជាតិ SIS ទទួលបាន ការបណ្តុះបណ្តាល អំពី សុវត្ថិភាព ម្ហូប អាហារ ពី មន្ត្រី ជំនាញ កាំ កុងត្រូល
( ភ្នំពេញ ) ៖ សិស្សសាលា អន្តរជាតិ អេស អាយ អេស (SIS) ចំនួន ១៤៨ នាក់ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ទទួល ការបណ្តុះបណ្តាល ចំណេះដឹង មូលដ្ឋាន អំពី សុវត្ថិភាព ម្ហូប អាហារ ពី មន្ត្រី ជំនាញ កាំ កុងត្រូល សាខា ផែ ស្ងួត ចុង ទី ភ្នំពេញ ។
រាជ រដ្ឋាភិបាល បាន កំណត់ យក មុំ មួយ ក្នុង ចំណោម មុំ ទាំង បួន នៃ យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ អាណត្តិ ទី៦ នេះ គឺ ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស ដែល ក្នុង នោះ « សុវត្ថិភាព ម្ហូប អាហារ » ជា កត្តា ជំរុញ មួយ ។ ចំណេះដឹង អំពី សុវត្ថិភាព ម្ហូប អាហារ គឺជា កាតាលីករ ដែល ជំរុញ សង្គម ទាំងមូល ឲ្យ មាន សុខ មាលភាព រួមចំណែក ជំរុញ ធនធាន មនុស្ស ក្នុង សង្គម អោយ មាន ការរីកចម្រើន និង និរន្តភាព ផងដែរ ។
យោង លើ សារសំខាន់ នេះ សាលារៀន អន្តរជាតិ អេស អាយ អេស (SIS) បាន សហការ ជាមួយ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល នៃ ក្រសួង ពាណិជ្ជកម្ម បើក វគ្គ អប់រំ ផ្សព្វផ្សាយ អំពី « សុវត្ថិភាព ម្ហូប អាហារ និង កិច្ចការ ការពារ អ្នកប្រើប្រាស់ » លើក ទី៣ ដើម្បី បញ្ជ្រាប ចំណេះដឹង អំពី សុវត្ថិភាព ម្ហូប អាហារ ដល់ សិស្សានុសិស្ស បន្ថែម លើ កម្មវិធី សិក្សា របស់ សាលា ។
លោក ខៀវ បញ្ញា វឌ្ឍន៍ គ្រូបង្គោល សុវត្ថិភាព ចំណីអាហារ នៃ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល ក្រសួង ពាណិជ្ជកម្ម បាន ឲ្យដឹង ថា ក្រុមការងារ របស់ លោក តែងតែ ចុះ អប់រំ ដល់ ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន សិស្សសាលា តាម គ្រឹស្ថាន សាធារណៈ អាជីវករ តាម ទីផ្សារ នានា ដើម្បី ណែនាំ ពួកគាត់ ឲ្យ យល់ដឹង អំពី របៀប នៃ កាជ្រើសរើស ម្ហូប អាហារ ការថែរក្សាទុក ការចំអិន និង ពន្យល់ ពួកគាត់ អំពី ការប្រើប្រាស់ សារធាតុ គីមី ហាមឃាត់ លើ ម្ហូប អាហារ ដែល ជះឥទ្ធិពល អាក្រក់ ដល់ សុខភាព អ្នកប្រើប្រាស់ ។
អាវុធហត្ថ រាជធានី ភ្នំពេញ បញ្ជូន ពលរដ្ឋ ម្នាក់ ទៅ ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ
( ភ្នំពេញ ) ៖ ជាញឹកញាប់ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បំពេញ ភារកិច្ច ស្នូល យ៉ាង មមាញឹក ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ទាំង ការស្រាវជ្រាវ បង្ក្រាប បទល្មើស ទាំង ការការពារ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សាធារណៈ ទាំង ការសង្គ្រោះ ប្រជាពលរដ្ឋ ដែល ជួប ឧបទ្ទវហេតុ ផ្សេង ៗ ។
ក្រោយពី ការពិនិត្យ រួច មក គ្រូពេទ្យ បាន ចេញ វេជ្ជបញ្ជា ឲ្យ អ្នកជំងឺ ប្រើប្រាស់ ថ្នាំ មួយ រយៈ សិន ដើម្បី តាមដាន អាការៈ រោគ បន្ត បន្ទាប់មក ក្រុមការងារ គ្រូពេទ្យ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ជូន អ្នកជំងឺ ទៅដល់ លំនៅដ្ឋាន វិញ និង រង់ចាំ ជួយ ជូន គាត់ ទៅ មក មន្ទីរពេទ្យ នៅ ថ្ងៃ ក្រោយ បន្ត ទៀត តាម ការណាត់ជួប របស់ គ្រូពេទ្យ ។
ការចុះ ទៅ ជួយ ពិនិត្យ និង ជូន ទៅ ព្យាបាល នេះ គឺ ក្រុម គ្រូពេទ្យ របស់ អាវុធហត្ថ រាជធានី ភ្នំពេញ តែងតែ ចុះ ជាប់ ជា បន្តបន្ទាប់ ក្នុង រយៈកាល កន្លងមក និង បាន ជួយ ដល់ ពលរដ្ឋ ទន់ខ្សោយ និង ទី ទាល់ ក្របាន ជាច្រើន នាក់ ផងដែរ ហើយ ឥរិយាបថ របស់ អាវុថហត្ថ រាជធានី ភ្នំពេញ ទាំងនេះ ក៏ បាន ទទួល ការគាំទ្រ និង សាទរ ពី ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ ព្រែក កំពឹស ខណ្ឌ ដង្កោ យ៉ាង ពេញ ទំហឹង ទៀតផង ៕ ទ័ព អាកាស អ៊ីស្រាអែល ទើប បញ្ជូន យន្តហោះ ចម្បាំង ថ្លៃ ជាង គេ លើ លោក ០២ គ្រឿងទៀត ចូល ឃ្លាំង ធ្វើឲ្យ ចំនួន សរុប កើន ដល់ ១៤ គ្រឿង !
កងកម្លាំង ទ័ព អាកាស អ៉ី ស្រាអែល ទទួលបាន យន្ដហោះ F-35 ពីរ គ្រឿង ជា លើក ដំបូង កាលពី ខែធ្នូ ឆ្នាំ ២០១៦ ។ មួយ វិញទៀត អ៉ី ស្រាអែល ក៏ ជា ប្រទេស តែ មួយ គត់ នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា ផងដែរ ដែល ធ្វើ ប្រតិបត្តិការ យន្ដហោះ ចម្បាំង F-35 ហើយ គ្រោង ដាក់ ឱ្យ ប្រើប្រាស់ ចម្បាំង អាមេរិក មួយ នេះ ជា ផ្លូវការ ក្នុង ពេល ឆាប់ ៗ ។
លោក ហ៊ុន ម៉ានី៖ សមិទ្ធផល ធំ បំផុត ដែល ស .ស .យ . ក សម្រេចបាន គឺ ការទទួលស្គាល់ និង ការស្វាគមន៍ ពី ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន !
( ភ្នំពេញ ) ៖ ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) លោក ហ៊ុន ម៉ានី បាន អះអាង ថា សមិទ្ធផល ជាច្រើន ដែល សហភាព សហព័ន្ធ យុវជន កម្ពុជា សម្រេចបាន ក្នុង រយៈពេល ៦ឆ្នាំ កន្លងមក ប៉ុន្ដែ ក្នុង ចំណោម សមិទ្ធផល ទាំងអស់ នោះ ត្រូវបាន លោក កត់សម្គាល់ ថា សមិទ្ធផល ដែល ធំ ជាង គេ បំផុត នោះ គឺ ការទទួលស្គាល់ និង ការទទួលស្វាគមន៍ ពីសំណាក់ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន ទាំងអស់ ។
ក្នុង មហាសន្និបាត នៅ ព្រឹក ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ លោក ហ៊ុន ម៉ានី បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ខ្ញុំ គិត ថា ជា រួម សមិទ្ធផល ធំ ជាង គេ ចំពោះ ខ្ញុំ ដែល ជា មោទនភាព នោះ គឺ ការទទួលស្គាល់ ហើយ ការស្វាគមន៍ ពី ប្រជាពលរដ្ឋ » ។
សូម ជម្រាប ថា ស .ស .យ . ក មាន សមាជិក សកម្ម ជាង ១២ម៉ឺន នាក់ ដោយ មិន បូក បញ្ចូល សមាជិក ជា នីតិបុគ្គល ឡើយ ក្នុង នោះ មាន សមាជិក គណៈកម្មាធិការ កណ្តាល សរុប ១៤២ រូប ដែល ទើបនឹង បោះឆ្នោត បន្ថែម ៤៣ នាក់ ព្រមទាំង សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល សរុប ៣៥ រូប ៕
សិក្ខាសាលា នេះ ត្រូវបាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅ ភោជនីយដ្ឋាន វ័ន ម៉រ ដោយ មាន ការចូលរួម ពីសំណាក់់ អតិថិជន មកពី ស្ថាប័ន ធនាគារ មីក្រូ ហិរញ្ញវត្ថុ រោងចក្រ និង ស្ថាប័ន នានា បាន មក ចូលរួម ជាច្រើន ។
( សៀមរាប ) ៖ មន្រ្តី សាខា កាំ កុត្រូល ខេត្ត សៀមរាប និង អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ ខេត្ត សៀមរាប នៅ ព្រឹក ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន សហការ ជាមួយ មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម គណៈកម្មការ ផ្សារ បាន ចុះ ត្រួតពិនិត្យ ទំនិញ ដែល ដាក់តាំង លក់ នៅក្នុង ផ្សារ ញ៉ែ ( តា ភុល ) ដែល មាន ទីតាំង នៅ ភូមិ តា ភុល ឃុំ ស្វាយ ដង្គុំ ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
ជាមួយគ្នា នោះ មន្រ្តី ជំនាញ បាន ធ្វើ ការណែនាំ ដល់ អាជីវករ ឲ្យ យល់ដឹង អំពី សុវត្ថិភាព ម្ហូប អាហារ ពិសេស សូម កុំ ផលិត ឬ យក ទំនិញ គ្មាន គុណភាព ឬ មាន សារធាតុ គីមី ហាមឃាត់ មក ដាក់ តាំង លក់ ព្រោះ នាំឲ្យ ប៉ះពាល់ ដល់ សុខភាព របស់ អ្នកប្រើប្រាស់ ៕ ខេត្ត ត្បូងឃ្មុំ នឹង រៀបចំ ព្រឹត្តិការណ៍ ដើរ ៤០ គីឡូម៉ែត្រ ដើម្បី អបអរ ខួប អនុស្សាវរីយន៍ ២ធ្នូ គម្រប់ ខួប ៤០ ឆ្នាំ ( ១៩៧៨ - ២០១៨ )
( ត្បូងឃ្មុំ ) ៖ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន ឱ្យដឹង ថា នៅ ទី២៩ ខែវិច្ឆិកា ខាងមុខ នេះ ខេត្ត ត្បូងឃ្មុំ និង សហភាព សហព័ន្ធ យុវជន កម្ពុជា នឹង រៀបចំ ព្រឹត្តិការណ៍ ដើរ ៤០ គីឡូម៉ែត្រ ចាប់ពី ឃុំ ទ ន្លូង ក្នុង ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ឆ្ពោះ ទៅកាន់ ស្រុក ស្នួល ខេត្ត ក្រចេះ ដើម្បី អបអរ ខួប អនុស្សាវរីយន៍ ២ធ្នូ គម្រប់ ខួប ៤០ ឆ្នាំ ( ១៩៧៨ - ២០១៨) ។
នេះ ជា ការបញ្ជាក់ របស់ លោក ជា ម ច័ន្ទ សោភ័ណ នា ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅក្នុង ឱកាស លោក ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ បើក កិច្ចប្រជុំ រៀបចំ ផែនការ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម ដងផ្លូវ ក្នុង ភូមិសាស្ត្រ ខេត្ត ត្បូងឃ្មុំ ដោយ មាន ការចូលរួម ពី អភិបាល រង ខេត្ត នាយក - នាយក រង រដ្ឋបាល សាលា ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ អភិបាល ក្រុង ស្រុក ថ្នាក់ដឹកនាំ មន្ទីរ ជុំវិញ ខេត្ត ស .ស .យ . ក និង មន្ត្រី សាលា ខេត្ត ដែល ពាក់ព័ន្ធ ផងដែរ ។
នៅក្នុង ឱកាស នេះ ដែរ អភិបាល ខេត្ត ត្បូងឃ្មុំ ដែល ទើប ត្រូវបាន តែងតាំង ក៏ បាន ស្នើ ឱ្យ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ ក្តាប់ ឱ្យ បាន នូវ សភាពការណ៍ ពង្រឹង សន្តិសុខ ធានា សុវត្ថិភាព ដល់ អ្នកចូលរួម ទាំងអស់ ក្នុង ដំណើរ ប្រវែង ៤០ គីឡូម៉ែត្រ ទៅកាន់ ទីប្រវត្តិសាស្ត្រ ដើម្បី អបអរ ពិធី ខួប អនុស្សាវរីយ ២ធ្នូ ដោយ មាន រៀបចំ ក្រុម គ្រូពេទ្យ ថ្នាំ ពេទ្យ ក៏ ដូចជា ឡានពេទ្យ សម្រាប់ សង្គ្រោះ ករណី បន្ទាន់ ណាមួយ ផងដែរ ។
លោក អភិបាល ខេត្ត សង្ឃឹម យ៉ាង មុតមាំ ថា កម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ រួម ជាមួយ លោក អភិបាល ក្រុង ស្រុក មន្ទីរ ពាក់ព័ន្ធ ជុំវិញ ខេត្ត សហការ គ្នា ឱ្យ បាន ស្អិត រមួត ធ្វើ យ៉ាងណា ឱ្យ កម្មវិធី ដំណើរការ ទៅ ដោយ រលូន តាម ការគ្រោងទុក ៕
( ស្វាយរៀង ) ៖ ដើម្បី ធានា ឱ្យ បាន សុវត្ថិភាព ចំណីអាហារ លោក ម៉ាន់ សុខ ន អនុប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ មន្ត្រី ចុះ ពិនិត្យ មុខ ទំនិញ ជាច្រើន មុខ ដែល បាន ដាក់ លក់ នៅក្នុង ផ្សារ រាត្រី ក្រុង បាវិត តែ មិន បាន រកឃើញ ទំនិញ មាន ផ្ទុក សារធាតុ គីមី នោះ ទេ ប៉ុន្តែ រកឃើញ ទឹកដោះ ហួស កាលបរិច្ឆេទ ចំនួន ១០កំប៉ុង និង មី ស្រាត គ្មាន សំបក វេចខ្ចប់ ត្រឹមត្រូវ ។
លោក ម៉ាន់ សុខ ន បាន ថ្លែង ថា ដោយ មាន ការណែនាំ ពី លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម និង លោក ម៉ក់ ពេជ្ជរិទ្ធ ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក កាំ កុងត្រូល មន្រ្តី កាំ កុងត្រូល ខេត្ត ស្វាយរៀង តែងតែ ចុះ ពិនិត្យ មុខ ទំនិញ បាន ជាច្រើន លើក ហើយ ការចុះ ពិនិត្យ មុខ ទំនិញ នៅ ថ្ងៃ នេះ ក្នុង គោលបំណង ធានា បាន សុវត្ថិភាព ម្ហូប អាហារ ព្រោះ វា មាន សារសំខាន់ ចាំបាច់ ណាស់ ក្នុង សង្គម និង ជីវភាព ប្រចាំ ថ្ងៃ ។
អនុប្រធាន សាខា កាំ កុងត្រូល រូប នេះ បាន បន្ត ទៀត ថា ការទទួលខុសត្រូវ លើ សុវត្ថិភាព ម្ហូប អាហារ គឺជា ការទទួលខុសត្រូវ រួមគ្នា ទាំង ស្ថាប័ន ជំនាញ ទាំង អ្នកនាំចូល អ្នកផលិត អ្នកចែកចាយ និង អ្នក ទាំងអស់ គ្នា ជា អ្នកប្រើប្រាស់ ផងដែរ ព្រោះ សុខភាព គឺជា កត្តា ចំបង នៃ ភាព រស់រាន នៃ ជីវិត មនុស្ស ។
ជាមួយគ្នា នោះ អនុប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ស្វាយរៀង ក៏ បាន អំពាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ នៅ ខេត្ត ស្វាយរៀង សូម មាន ការប្រុងប្រយ័ត្ន ចំពោះ ការបរិភោគ ចំណីអាហារ ត្រូវ ពិនិត្យមើល ស្លាកសញ្ញា កាលបរិច្ឆេទ ឱ្យ បាន ច្បាស់លាស់ មុន ទិញ យក ទៅ បរិភោគ ដើម្បី ចូលរួម លើកកម្ពស់ សុខុមាលភាព ទាំងអស់ គ្នា ហើយ មន្ត្រី កាំ កុងត្រូល នឹង បន្ត ចុះ ពិនិត្យ ទំនិញ នៅ តាម ផ្សារ នានា នៅក្នុង ខេត្ត ស្វាយរៀង ឱ្យ បាន ញឹកញាប់ បន្ថែម ទៀត ៕
សេចក្ដីណែនាំ របស់ សម្តេច ក្រឡាហោម ដែល បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជាក់ បន្ត ថា រាល់ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ព្រមទាំង សហគមន៍ នានា ដែល បាន ចុះបញ្ជី ត្រឹមត្រូវ មាន លិខិត បទដ្ឋាន គតិយុត្ត នានា ជាធរមាន ព្រមទាំង លក្ខន្តិកៈ របស់ ខ្លួន ដែល បាន តម្កល់ ទុក នៅ ក្រសួង មហាផ្ទៃ អាច ធ្វើ សកម្មភាព បាន ដោយ មិន ចាំបាច់ ជូនដំណឹង ដល់ អាជ្ញាធរ មូលដ្ឋាន ក្នុង រយៈពេល ៣ ថ្ងៃ មុនពេល ចាប់ផ្ដើម សកម្មភាព ដូច មុន ទៀត ឡើយ ៕
