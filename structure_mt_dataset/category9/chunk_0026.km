( ចិន ) ៖ មន្ត្រី ជាន់ ខ្ពស់ រដ្ឋាភិបាល មកពី ប្រទេស នៃ សហប្រតិបត្តិការ ទន្លេ មេគង្គ - ឡាន ឆាង ដែល រួម មាន ដូច ជា៖ ចិន ឡាវ កម្ពុជា មីយ៉ាន់ម៉ា ថៃ និង វៀតណាម បាន ជួបប្រជុំគ្នា នៅ ទីក្រុង លួង ព្រះបាង ប្រទេស ឡាវ កាលពី សប្តាហ៍ មុន ដើម្បី ឈាន ទៅរក ការចុះ កិច្ចព្រមព្រៀង គ្នា ទៅ លើ វិធី ផ្សេង ៗ សម្រាប់ យកមក អភិវឌ្ឍ អនុ តំបន់ នេះ ប្រកបដោយ និរន្តរភាព និង ការសហការ ល្អ ។
កិច្ចប្រជុំ លើក ទី បួន របស់ ក្រុម រដ្ឋមន្ត្រី ក្រសួង ការបរទេស របស់ ប្រទេស ដែល ចូលរួម ក្នុង សហប្រតិបត្តិការ ទន្លេ មេគង្គ - ឡាន ឆាង បាន ឈានដល់ មាន ការចុះ កិច្ចព្រមព្រៀង ទៅ លើ វិស័យ មួយចំនួន ដែល ផ្ដល់ អត្ថប្រយោជន៍ ដល់ គ្រប់ ភាគី ។ អត្ថប្រយោជន៍ ទាំងនោះ រួម មាន ដូចជា សហប្រតិបត្តិការ លើ សមត្ថភាព ផលិត ដែល មាន គុណភាព ខ្ពស់ និង ការកសាង ក្រវ៉ាត់ អភិវឌ្ឍ សេដ្ឋកិច្ច នៃ សហប្រតិបត្តិការ ទន្លេ មេគង្គ - ឡាន ឆាង ។
ឧត្ដម ទីប្រឹក្សា រដ្ឋ និង រដ្ឋមន្ត្រី ការបរទេស ចិន លោក វ៉ាង អ៊ី និង រដ្ឋមន្ត្រី ការបទេស ឡាវ លោក សាលើ ម សាយ កុំ ម៉ាសិទ្ធ បាន ធ្វើជា អធិបតី ក្នុង ពិធី ប្រជុំ នេះ ដោយ មាន ការចូលរួម ពី លោក ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង លោក យូ ខ្វា ធីន រដ្ឋមន្ត្រី ការបរទេស មីយ៉ាន់ម៉ា លោក ដន ប្រាមុត វីណៃ រដ្ឋមន្ត្រី ការបរទេស ថៃ និង លោក ផាម បី ញ មីញ អនុ នាយក រដ្ឋមន្ត្រី និង រដ្ឋមន្ត្រី ការបរទេស វៀតណាម ។
លោក រដ្ឋមន្ត្រី ការបរទេស ចិន សហប្រតិបត្តិការ ទន្លេ មេគង្គ - ឡាន ឆាង បាន ផ្ដល់ កម្លាំង ជំរុញ បន្ថែម ដល់ សហប្រតិបត្តិការ ចិន - អាស៊ាន ព្រមទាំង បាន ធ្វើឲ្យ ប្រសើរឡើង នូវ ទំនាក់ទំនង រវាង បណ្ដា ប្រទេស ទាំងឡាយ នៅក្នុង តំបន់ នេះ ។
លោក ក៏ បាន លើកឡើង អំពី ភាពចាំបាច់ ដែល ប្រទេស ទាំង៦ ត្រូវ ពង្រឹង ចំណង ទំនាក់ទំនង ឲ្យ កាន់តែ ស៊ីជម្រៅ ដើម្បី កសាង ក្រវ៉ាត់ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច នៃ សហប្រតិបត្តិការ ទន្លេ មេគង្គ - ឡាន ឆាង ដើម្បី លើកស្ទួយ ដល់ សហប្រតិបត្តិការ លើ វិស័យ ផលិត និង បណ្ដុះឲ្យ មាន ការអភិវឌ្ឍ ថ្មី ៗ បន្ថែម សម្រាប់ ជួយ លើកស្ទួយ ដល់ ការអភិវឌ្ឍ ប្រកបដោយ និរន្តរភាព ។
រដ្ឋមន្ត្រី មកពី ប្រទេស ទាំង៦ បាន យល់ព្រម សម្របសម្រួល ដល់ ការអភិវឌ្ឍ នៃ សហប្រតិបត្តិការ ទន្លេ មេគង្គ - ឡាន ឆាង ដោយ ប្រទេស នីមួយ ៗ សុទ្ធតែ មាន ផែនការអភិវឌ្ឍន៍ រយៈពេល វែង រៀង ៗ ខ្លួន ។ រដ្ឋមន្ត្រី ទាំង៦ ក៏ បាន យល់ព្រម ថា នឹង ពង្រឹង ការតភ្ជាប់ ទំនាក់ទំនង ថ្នាក់ អនុ តំបន់ ក៏ ដូចជា ស្វែងរក ឱកាស ថ្មី ៗ ដើម្បី ធ្វើ សហប្រតិបត្តិការ ឆ្លង តំបន់ ផងដែរ ៕ ( សារព័ត៌មាន CCTV របស់ ចិន )
( ចិន ) ៖ ការអភិវឌ្ឍ នៃ វិស័យ អនឡាញ របស់ ប្រទេស ចិន បាន ក្លាយជា ការអភិវឌ្ឍ គំរូ មួយ សម្រាប់ ឲ្យ បណ្ដា ប្រទេស កំពុង អភិវឌ្ឍ យក ទៅ អនុវត្ត តាម ដើម្បី ទទួលបាន ជោគជ័យ លើ វិស័យ សេដ្ឋកិច្ច របស់ ខ្លួន ជាពិសេស គឺ វិស័យ លក់ ទំនិញ តាម ប្រព័ន្ធ អេឡិចត្រូនិច តែម្ដង ។
ព្រីន ក្រដាស កុម្ម៉ង រក ទំនិញ ឲ្យ ត្រូវ តាម ការកុម្ម៉ង់ និង ផ្ញើ ឥវ៉ាន់ នោះ ទៅ ក្រៅ ប្រទេស ! នេះ គឺជា ការងារ ប្រចាំ ថ្ងៃ របស់ លោក ជិន ប៉។ កាលពី ៨ឆ្នាំ មុន គាត់ បាន ចាប់ផ្ដើម លក់ ឥវ៉ាន់ តូច ៗ ដូចជា តុក្កតា និង ប៊ិច សៀវភៅ ទៅឲ្យ អតិថិជន ជា ជន បរទេស តាម វេបសាយ អន្តរជាតិ ជាច្រើន ។ ចាប់តាំងពី ពេល នោះ មក មុខរបរ របស់ គាត់ ក៏ បាន រីកចម្រើន យ៉ាង ខ្លាំង ។
ទីផ្សារ នៅ អាមេរិក និង អឺរ៉ុប សំបូរ អ្នកទិញ ទំនិញ តាម អនឡាញ ជាង គេ ។ ចំណែកឯ ប្រទេស ដែល កំពុង មាន សេដ្ឋកិច្ច ស្ទុះ ឡើង ខ្លាំង ដូចជា ប្រេស៊ីល និង ឥណ្ឌា វិញ ក៏ មាន ប្រជាជន ទិញ ទំនិញ តាម អនឡាញ កាន់តែ ច្រើន នាក់ ដែរ ។ ការងើបឡើង នៃ វិស័យ ពាណិជ្ជកម្ម អេឡិចត្រូនិច របស់ ចិន ក៏ បាន ជំរុញ ឲ្យ ក្រុមហ៊ុន លក់ រាយ នៅ បរទេស ត្រូវ កែសម្រួល ផែនការលក់ របស់ ពួកគេ ដែរ ។
ក្រៅពី អ្នកលក់ និង អ្នក ដឹក ទំនិញ ទៅ ក៏ មាន ភាគី ផ្សេង ទៀត ដែរ ដែល ទទួលបាន ផលប្រយោជន៍ ពី ការរីកចម្រើន ដ៏ ឆាប់រហ័ស នៃ វិស័យ អីនធើណេត របស់ ចិន ។ ការអភិវឌ្ឍ នៃ វិស័យ អិនធើណេត របស់ ចិន ក៏ មាន តួនាទី ដ៏ សំខាន់ នៅក្នុង ទីផ្សារ ពិភពលោក ដែរ ។
( ភ្នំពេញ ) ៖ ក្រោយ មាន សារព័ត៌មាន ជាតិ និង អន្ដរជាតិ ធ្វើ ការផ្សព្វផ្សាយ អំពី ការចោទប្រកាន់ ដោយ គ្មាន ភស្ដុតាង និង មាន ចរិត លក្ខណៈ នយោបាយ របស់ លោក Brad Adams មន្ដ្រី អង្គការ ឃ្លាំមើល សិទ្ធិ មនុស្ស អន្ដរជាតិ កាលពី ពេល ថ្មី ៗ សហព័ន្ធ កីឡា បាល់ទាត់ កម្ពុជា (FFC) បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បំភ្លឺ ជា ផ្លូវការ ហើយ នឹង បាន ចាត់ទុក ការចោទប្រកាន់ នេះ មាន លក្ខណៈ ទុច្ចរិត ក្នុង ការបង្អាក់ ដំណើរការអភិវឌ្ឍន៍ វិស័យ បាល់ទាត់ ទាំង ក្នុង តំបន់ និង លើ ពិភពលោក ទៀតផង ។
សម្រាប់ ស៊ុប ចង្កាក់ Volcano អាច ទាក់ទាញ អតិថិជន បាន ដោយសារតែ រសជាតិ ឆ្ងាញ នៃ ទឹកស៊ុន ដែល នាំចូល ពី បរទេស ដោយ បញ្ចូល នូវ គ្រឿងផ្សំ យ៉ាង ឈ្ងុយ ឆ្ងាញ ថែមទាំង ផ្ដោត លើ អនាម័យ ខ្ពស់ ហើយ មួយ វិញទៀត តម្លៃ ក៏ សមរម្យ សម្រាប់ ទទួលទាន គួបផ្សំ ជាមួយ សេវាកម្ម ដ៏ ពិសេស ផងដែរ ។
( ភ្នំពេញ ) ៖ តាម ការគ្រោងទុក នៅ វេលា ម៉ោង ប្រមាណ ១២ ថ្ងៃត្រង់ ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី នឹង យាង មកដល់ មាតុ ប្រទេស វិញ ហើយ ក្រោយ បញ្ចប់ ការបំពេញ ព្រះរាជ ទស្សនកិច្ច នៅ ប្រទេស វៀតណាម រយៈពេល ៣ ថ្ងៃ តប តាម ការយាង របស់ រដ្ឋាភិបាល វៀតណាម ។
ព្រះរាជ ដំណើរ បំពេញ ទស្សនកិច្ច របស់ ព្រះមហាក្សត្រ ខ្មែរ ទៅកាន់ ប្រទេស វៀតណាម នា ពេលនេះ ក៏ ត្រូវបាន គេ ពិពណ៌នា ថា ជា ព្រះរាជ ដំណើរ ដើម្បី លើកកម្ពស់ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ ឲ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ៕ អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ចំនួន ២គ្រឿង ថែម ទៀត
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ២គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន ២គ្រឿង ក្នុង នោះ រួម មាន៖ រ៉ឺម៉ក់ ម៉ូតូ កង់២ គ្រឿង ។
ការដំឡើង ឯក តា នៃ សន្ទស្សន៍ បៀវត្ស មូលដ្ឋាន នេះ បាន ធ្វើឲ្យ ប្រាក់ បៀវត្ស ទាប បំផុត ( អប្បបរមា ) របស់ មន្ត្រីរាជការ និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ កើនឡើង មួយ កម្រិត ទៀត ឡើង ដល់ ជាង ១លាន រៀល ។
រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ចូលរួម លើកកម្ពស់ កម្រិត ជីវភាព របស់ មន្ត្រីរាជការ គ្រូពេទ្យ គ្រូបង្រៀន និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ( យោធា នគរបាល និង អាវុធហត្ថ ) ឲ្យ កាន់តែ មាន ជីវភាព ធូរធា នោះ បាន កំណត់ ឲ្យ មាន ការដំឡើង ប្រាក់ បៀវត្ស២ ដង ក្នុង ១ ឆ្នាំ ដោយ លើក ទី១ ដំឡើង នៅ ខែមករា និង លើក ទី២ នៅ ខែមេសា មុន បុណ្យ ចូល ឆ្នាំ ខ្មែរ ។
បើ តាម លោក យក់ ប៊ុន ណា រាជ រដ្ឋាភិបាល មិន ត្រឹមតែ ដំឡើង ប្រាក់ បៀវត្ស សម្រាប់ តែ មន្ត្រីរាជការ និង កម្លាំងប្រដាប់អាវុធ ប៉ុណ្ណោះ ទេ នៅ និវត្ត ជន ជា អតីត យុទ្ធជន និង អតីត មន្ត្រីរាជការ ស៊ីវិល ក៏ ត្រូវ ដំឡើង ប្រាក់ សោធន និវត្តន៍ ប្រចាំ ខែ ផងដែរ ចាប់ពី ខែមេសា ឆ្នាំ ២០១៩ ។
គួរ បញ្ជាក់ ថា ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន ជាញឹកញយ ធ្លាប់ បាន អះអាង និង សន្យា ចំពោះ មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ ថា ប្រាក់ បៀវត្ស របស់ មន្ត្រីរាជការ គ្រូបង្រៀន គ្រូពេទ្យ និង កម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ នឹង ត្រូវ ដំឡើង ជារៀងរាល់ ឆ្នាំ ហើយ ១ ឆ្នាំ ដំឡើង ២ដង ។ បន្ថែម លើស ពី នេះ ៕
សូម កុំ បើកបរ ល្មើស ល្បឿន កំណត់ ដាច់ខាត ! ស្លាប់ ម្នាក់ និង របួស ៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួ៦ លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ម្នាក់ . របួស ស្រាល គ្មាន និង របួស ធ្ងន់ ២នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៦លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៩គ្រឿង . រថយន្ត តូច៣ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្មើស ល្បឿន . ប្រជែង និង មិន គោរព សិទ្ធិ ។
ប្រធានាធិបតី កូរ៉េ ខាងត្បូង ទទូច ឲ្យ បន្ត ពង្រឹង សមត្ថភាព ការពារ ជាតិ ទោះ ទំនាក់ទំនង ជាមួយ កូរ៉េ ខាងជើង ប្រសើរឡើង ក្តី
( សេអ៊ូល ) ៖ ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន បាន និយាយ ថា ប្រទេស របស់ លោក គួរតែ បន្ត បង្កើន សមត្ថភាព ការពារ ជាតិ ទោះបីជា កន្លងមក នេះ ទំនាក់ទំនង ជាមួយ កូរ៉េ ខាងជើង បាន ចាប់ផ្តើម មាន ភាពប្រសើរឡើង ក៏ដោយ ដ្បិត ថា សន្តិភាព អាច សម្រេច ទៅ បាន លុះត្រាតែ មាន កម្លាំង យោធា រឹងមាំ មួយ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន រុស្ស៊ី Sputnik នៅ យប់ ថ្ងៃព្រហស្បតិ៍ ទី២០ ខែធ្នូ ឆ្នាំ ២០១៨ ។
លោក មូន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « ភាពស្ងប់ សុខ បច្ចុប្បន្ន ស្ថិត ក្នុង លក្ខណៈ បណ្តោះអាសន្ន នៅឡើយ ស្រប ពេល ដែល ដំណើរការ រំសាយ អាវុធ នុយក្លេអ៊ែរ ចេញ ពី ឧបទ្វីប កូរ៉េ និង ការស្វែងរក សន្តិភាព ពេញលេញ កំពុងតែ ប្រព្រឹត្តទៅ មុខ ប៉ុន្តែ យើង ដាច់ខាត មិន ត្រូវ ភ្លេច ខ្លួន នោះ ឡើយ រហូត ទាល់ អ្វី ៗ បាន បញ្ចប់ ជាស្ថាពរ ទាំងស្រុង ខណៈ សន្តិភាព អាច គង់វង្ស យូរអង្វែង ទៅ បាន នៅពេល យើង មាន យោធា ខ្លាំងក្លា រឹងមាំ » ។
គួរ ជម្រាប ថា ក្នុង ឆ្នាំ ២០១៨ នេះ លោក មូន បាន បើក កិច្ចប្រជុំ ជា ប្រវត្តិសាស្រ្ត ដល់ ទៅ ០៣ លើក ជាមួយ ប្រមុខ ដឹកនាំ កំពូល កូរ៉េ ខាងជើង គឺ លោក គីម ជុង អ៊ុន ដោយ ក្នុង ជំនួប ទាំងនោះ ប្រទេស ទាំង ពីរ បាន ព្រមព្រៀង គ្នា ជាច្រើន រួម មាន ទាំង ការសន្យា ថា នឹង មិន ប្រើប្រាស់ កម្លាំង យោធា ប្រឆាំង ដាក់ គ្នា នា ថ្ងៃ អនាគត ឡើយ ៕ អង្គការ មូលនិធិ កុមារ កម្ពុជា រៀបចំ ពិធី អបអរ ក្មេង ចំនួន ៣០ នាក់ ដែល ទទួល ការគាំទ្រ ពី អង្គការ បាន ប្រែក្លាយ ខ្លួន ពី ក្មេង គំនរ សំរាម ទៅជា បញ្ញា វ័ន្ត
( បាងកក) ៖ នាយក រដ្ឋមន្រ្តី ថៃ លោក ប្រាយុទ្ធ ចាន់ អូចា បាន ថ្លែង នា ថ្ងៃព្រហស្បតិ៍ នេះ ថា រូប លោក នឹង មិន លា លែង ពីមុខតំណែង ឡើយ ទោះបីជា កំពុង បន្ត រង សម្ពាធ ខ្លាំង ពី ក្រុម អ្នករិះគន់ ក៏ដោយ នៅ មុន ការបោះឆ្នោត ខែកុម្ភៈ ឆ្នាំ ២០១៩ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ យប់ ថ្ងៃព្រហស្បតិ៍ ទី២០ ខែធ្នូ ឆ្នាំ ២០១៨ ។
នៅ ចំពោះមុខ ក្រុម អ្នកសារព័ត៌មាន ក្នុង វិមាន រដ្ឋាភិបាល ថៃ លោក ប្រាយុទ្ធ បាន ប្រកាស ថា លោក នឹង នៅ បន្ត កាន់អំណាច ជា ប្រមុខ រាជ រដ្ឋាភិបាល និង ជា ប្រធាន ក្រុមប្រឹក្សា ជាតិ ដើម្បី សន្តិភាព និង សណ្តាប់ធ្នាប់ ដដែល ទោះ មាន ការអំពាវនាវ យ៉ាង ទទូច ឲ្យ រូប លោក ចុះ ចេញ ពី តំណែង នៅ មុន ការបោះឆ្នោត សកល ដែល ត្រូវ ប្រព្រឹត្តទៅ នា ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២០ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង អង្គ សន្និបាត គណៈកម្មាធិការ កណ្ដាល លើក ទី ៤១ អាណត្តិ ទី៥ បាន ធ្វើ ការប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ថា សម្រេច ឲ្យបាន គោលដៅ នៃ ការកាត់បន្ថយ ភាពក្រីក្រ ឲ្យ ស្ថិត ក្នុង អត្រា ទាប ជាង ១០ភាគរយ និង ការពារ មិន ឲ្យ ភាពក្រីក្រ វិលត្រឡប់ មកវិញ ។
ក្នុង ន័យ នេះ គណបក្ស ប្រជាជន កម្ពុជា នឹង ខិតខំ ជំរុញ ការអនុវត្ត ឲ្យបាន សម្រេច ជោគជ័យ នូវ កម្មវិធី នយោបាយ និង យុទ្ធសាស្ដ្រ ចតុកោណ ដំណាក កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៩ ដែល មាន គោលដៅ ជា យុទ្ធសាស្ដ្រ៤ សំដៅ ក សាង មូលដ្ឋាន ឆ្ពោះទៅ សម្រេច ចក្ខុវិស័យ កម្ពុជា ជា ប្រទេស ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
សេចក្ដីប្រកាស អំពី លទ្ធផល នៃ សន្និបាត គណៈកម្មាធិការ កណ្ដាល ដែល បង្ហាញ នៅ ល្ងាច ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ក្រោយ បិទ បញ្ចប់ សន្និបាត ដែល ដំណើរការ រយៈពេល ៣ ថ្ងៃ នេះ បញ្ជាក់ ថា គោលដៅ ជា យុទ្ធសាស្ដ្រ ៤នោះ រួម មាន៖
ទី ១៖ ធានា ឲ្យបាន កំណើន សេដ្ឋកិច្ច ក្នុង អត្រា មធ្យម ប្រចាំ ឆ្នាំ ក្នុង រង្វង់ ៧ភាគរយ ប្រកបដោយ ចីរភាព និង ធន់ នឹង វិបត្តិ
ទី ២៖ បង្កើត ការងារ ឲ្យបាន កាន់តែ ច្រើន ទាំង បរិមាណ និង គុណភាព ជូន ប្រជាជន ជាពិសេស ស្រទាប់ យុវជន
ទី៣៖ សម្រេច ឲ្យបាន គោលដៅ នៃ ការកាត់បន្ថយ ភាពក្រីក្រ ឲ្យ ស្ថិត ក្នុង អត្រា ទាប ជាង ១០ភាគរយ និង ការពារ មិន ឲ្យ ភាពក្រីក្រ វិលត្រឡប់ មកវិញ
និង ៤៖ បន្ដ ពង្រឹង សមត្ថភាព និង អភិបាលកិច្ច នៃ ស្ថាប័ន រដ្ឋ ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ដើម្បី ធានា ឲ្យបាន នូវ ប្រសិទ្ធភាព សេវា សាធារណៈ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
( ភ្នំពេញ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ បាន បញ្ចប់ ការរៀបចំ សន្និបាត គណៈកម្មាធិការ កណ្តាល របស់ ខ្លួន នៅ មជ្ឈមណ្ឌល ពិព័រណ៍ និង សន្និបាត កោះ ពេជ្រ បន្ទាប់ពី ដំណើរការ អស់ រយៈពេល ៣ ថ្ងៃ ។
យោង តាម សេចក្តីជូនដំណឹង ពី លទ្ធផល នៃ អង្គ សន្និបាត បាន ឲ្យដឹង ថា គណបក្ស ប្រជាជន កម្ពុជា ដែល ជា គណបក្ស ដឹកនាំ រាជ រដ្ឋាភិបាល បាន ប្តេជ្ញា មិន ឱន ក្បាល ចំពោះ ការដាក់ សម្ពាធ ណាមួយ ពី មជ្ឈដ្ឋាន ខាងក្រៅ ឡើយ ។
សេចក្តីប្រកាស លទ្ធផល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន . បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ( អង្គ សន្និបាត ) តម្កល់ ខ្ពស់ ស្មារតី ស្នេហាជាតិ ដ៏ បរិសុទ្ធ ការពារ ដាច់ខាត នូវ ឯករាជ្យ អធិបតេយ្យ និង បូរណភាព ទឹកដី ប្រឆាំង ការជ្រៀត ជ្រែក របស់ បរទេស ចូល កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ការមួល បង្កាច់ ភាពត្រឹមត្រូវ របស់ នយោបាយ និង សកម្មភាព របស់ កម្ពុជា ដោយ មិន ឱន ក្បាល ចំពោះ ការដាក់ សម្ពាធ ណាមួយ ពី ខាងក្រៅ » ។
ថែរក្សា សន្តិភាព . សន្តិសុខ . ស្ថិរភាព នយោបាយ . សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព សង្គម ឲ្យ បាន រឹងមាំ រាំង ស្កាត់ រាល់ សកម្មភាព ប្រទូស្តរ៉ាយ ដែល បង្ក ដោយ ពួក ប្រឆាំង និង មជ្ឈដ្ឋាន អន្តរជាតិ នានា ដោយ ប្រតិបត្តិ ម៉ឺងម៉ាត់ រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ជាធរមាន ។ នេះ បើ យោង តាម សេចក្តីជូនដំណឹង ដដែល បាន បញ្ជាក់ បន្ថែម ។
ព្រម ជាមួយ នេះ អង្គ សន្និបាត បាន ប្តេជ្ញា ការពារ និង ពង្រឹង ដំណើរការ ប្រជាធិបតេយ្យ ឲ្យ ចាក់ គ្រឹះ កាន់តែ រឹងមាំ នៅ កម្ពុជា លើ មូលដ្ឋាន ធានា នូវ សន្តិភាព និង ការអភិវឌ្ឍ និង ត្រូវ ផ្សារភ្ជាប់ ជាមួយ ការថែរក្សា អត្តសញ្ញាណ ជាតិ សេចក្តីថ្លៃថ្នូរ ប្រពៃណី ទំនៀមទម្លាប់ ល្អ របស់ ជាតិ និង ការកសាង សុខដុមរមនា ក្នុង សង្គម កម្ពុជា ផងដែរ ៕
អាវុធហត្ថ រាជធានី ភ្នំពេញ បញ្ជូន ជនសង្ស័យ ប្រុស ស្រី ១០នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី គ្រឿងញៀន
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស គ្រឿងញៀន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បញ្ជូន ជនសង្ស័យ ប្រុស ស្រី ១០នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី គ្រឿងញៀន ដើម្បី ធ្វើ ការផ្តន្ទាទោស រួម និង ក្រាម ពណ៌ ស ថ្លា ២៨ កញ្ចប់ ( ប្រភេទ ម៉ា ទឹកកក ) ។
ពួកគេ ទាំង ១០នាក់ នេះ មាន៖
សូម បញ្ជាក់ ផងដែរ ថា ពួកគេ ទាំង ១០នាក់ ត្រូវបាន សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស គ្រឿងញៀន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ សហការ ជាមួយ កម្លាំង មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ មានជ័យ ធ្វើ ការបង្ក្រាប និង ឃាត់ខ្លួន បានជា បន្តបន្ទាប់ គ្នា រយៈពេល ២ ថ្ងៃទី គឺ ថ្ងៃទី ១៦ និង ១៧ ខែធ្នូ ឆ្នាំ ២០១៨ ។
ក្រោយពេល ឃាត់ខ្លួន ពួកគេ យកមក សួរ ចម្លើយ ក្រោម វិធានការ ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស គ្រឿងញៀន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ពួកគេ ទាំង ១០នាក់ ខាងលើ បាន សារភាព ថា គឺ ពិតជា ជាប់ពាក់ព័ន្ធ ករណី គ្រឿងញៀន ប្រាកដ មែន ហើយ គ្រឿង ទាំងអស់ ក៏ ជា របស់ ពួកគេ ដែរ ទើប សមត្ថកិច្ច អាវុធហត្ថ បាន ប្រមូល វត្ថុតាង និង សុំ ណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ បន្ត តាម ច្បាប់ ៕ សន្និបាត គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា រយៈពេល ៣ ថ្ងៃ បាន បិទ បញ្ចប់ ហើយ
( ភ្នំពេញ ) ៖ រហូតដល់ ម៉ោង ជាង ៦៖០០ ល្ងាច ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ សន្និបាត គណៈកម្មាធិការ កណ្តាល លើក ទី ៤១ អាណត្តិ ទី៥ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល ធ្វើឡើង រយៈពេល ៣ ថ្ងៃ បាន បិទ បញ្ចប់ ហើយ ។
ក្រោយ បញ្ចប់ សន្និបាត នេះ គណបក្ស ប្រជាជន កម្ពុជា បាន បង្ហាញ សេចក្តីសម្រេច ជា លទ្ធផល សំខាន់ ៗ ចំនួន ១១ ចំណុច ដើម្បី តម្រង់ ទិស សម្រាប់ ការអនុវត្ត របស់ ខ្លួន ទៅ ថ្ងៃ ខាងមុខ ។
នៅក្នុង សន្និបាត នេះ គណបក្ស ប្រជាជន កម្ពុជា ដែល កាន់អំណាច ៥ អាណត្តិ មក នេះ បាន បញ្ចូល សមាជិក អចិន្រ្តៃយ៍ ថ្មី ចំនួន ៧រូប ផងដែរ ដែល ធ្វើឱ្យ សមាជិក អចិន្រ្តៃយ៍ របស់ គណបក្ស ដ៏ ចំណាស់ នេះ មាន ចំនួន ៣៧ រូប និង មាន សមាជិក គណៈកម្មាធិការ កណ្តាល ចំនួន ៨៦៥ រូប ៕
( កាណាដា) ៖ យោធា កាណាដា បាន អះអាង ថា អាកាសយានិក ចិន បាន លូកលាន់ ចូល ទៅក្នុង កិច្ចសន្ទនា នៃ ក្រុម អាកាសយានិក នៅលើ យន្តហោះ អង្កេត ការណ៍ របស់ កាណាដា ដែល ប្រការ នេះ ក៏ ធ្លាប់ ត្រូវបាន គេ អះអាង ថា បាន កើត មាន ឡើង ចំពោះ យន្តហោះ ជប៉ុន អូស្ត្រាលី និង នូវែលសេឡង់ ផងដែរ ខណៈ ប្រទេស ចិន និង កាណាដា កំពុងតែ ប្រឈមមុខ ភាពតានតឹង ខ្លាំង ជាមួយគ្នា ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នា ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី២០ ខែធ្នូ ឆ្នាំ ២០១៨ ។
បើ តាម ការបញ្ជាក់ ពី មន្ត្រី យោធា កាណាដា នេះ មិន មែន ជា លើក ទី មួយ ឡើយ ដែល យន្តហោះ មកពី តំបន់ ផ្សេង ត្រូវបាន គេ រាយការណ៍ ថា បាន ទទួលរង ការលុកលុយ តាមរយៈ កិច្ចសន្ទនា ដោយ ក្រុម អាកាសយានិក ចិន ជ្រៀត ចូល មកកាន់ ប្រព័ន្ធ វិទ្យុ ទាក់ទង របស់ ពួកគេ ពេល កំពុង ធ្វើ ការបញ្ជា យន្តហោះ នោះ ។ កាណាដា បាន ចាត់ទុក ថា វា គឺជា ទង្វើ មិន សមរម្យ របស់ ចិន ដែល បាន បង្ក ផល ប៉ះពាល់ ដល់ សេរីភាព នៃ ការធ្វើចរាចរណ៍ ក្នុង តំបន់ របស់ អន្តរជាតិ ។
ទស្សនា ការ សម្តែង ឥត គិត ថ្លៃ និង ការបញ្ចុះ តម្លៃ ជាច្រើន ពី ណាហ្គាវើលដ៍ នា ចុង ឆ្នាំ នេះ !
( ភ្នំពេញ ) ៖ នាំ ក្រុមគ្រួសារ រួមទាំង កូន តូច ៗ និង មិត្តភ័ក្តិ របស់ អ្នក មក ណាហ្គាវើលដ៍ ក្នុង ឱកាស ចុង ឆ្នាំ នេះ ដើម្បី ប្រារព្ធ បុណ្យ ណូអែល ដ៏ សប្បាយរីករាយ ចូល ទស្សនា ការ សម្តែង ឥត គិត ថ្លៃ និង ទទួលបាន ការបញ្ចុះ តម្លៃ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ ។
មួយ ថ្ងៃ មុន ថ្ងៃ បុណ្យ ណូអែល និង នៅ ថ្ងៃ ណូអែល ពុក ម៉ែ ពូមីង បងប្អូន អាច ដើរ និង ថត រូប ជាមួយ ម៉ាស់ ស្កត់ ណូអែល ដែល ពួកគាត់ នឹង ដើរ ជូនពរ ភ្ញៀវ ទូទាំង សណ្ឋាគារ ចាប់ពី ម៉ោង ៦ ល្ងាច ។ បន្ទាប់មក អ្នក អាច ដើរ ជាមួយ តាណូ អែល ទៅកាន់ ភោជនីយដ្ឋាន មួយចំនួន នៅក្នុង ណាហ្គាវើលដ៍ ចាប់ពី ម៉ោង ៧យប់ មុនពេល អ្នក សម្រេចចិត្ត ទៅ ពិសា ម្ហូប ពិសេស របស់ យើង ។
( ប៉ៃលិន ) ៖ លោកស្រី សោ មុន្នីរ័ត្ន អភិបាល រង ខេត្ត ប៉ៃលិន នៅ ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ បាន ទទួលមរណភាព ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ ខណៈ កូនប្រុស លោកស្រី និង លោកស្រី ប៉ុក ណាឌី អភិបាល រង បន្ទាយមានជ័យ បាន រងរបួស ធ្ងន់ ក្នុង គ្រោះថ្នាក់ ចរារចណ៍ ដ៏ រន្ធត់ នេះ ផងដែរ ។
ភ្នាក់ងារ ព័ត៌មាន Fresh News បាន បញ្ជាក់ ឱ្យដឹង ថា ករណី គ្រោះថ្នាក់ ចរារចណ៍ ខាង លើ នេះ ស្ថិត នៅ ភូមិ ឈើ នាគ ឃុំ ស្វាយជ្រុំ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង បន្ទាប់ពី ជនរងគ្រោះ ទាំង បី នាក់ បាន វិល ពី ភ្នំពេញ ត្រឡប់មក ខេត្ត ប៉ៃលិន វិញ ។
មុនពេល កើត ហេតុ ហេតុ គេ ឃើញ រថយន្ត របស់ លោកស្រី អភិបាល រង ខេត្ត ប៉ៃលិន ម៉ាក លុច្ស ស៊ីស បាន ធ្វើដំណើរ បញ្ច្រាស ទិស គ្នា ពី ភ្នំពេញ ទៅ ខេត្ត ប៉ៃលិន រហូតមកដល់ កន្លែង កើត ហេតុ ក៏ បុក ជាមួយ រថយន្ត ពីរ គ្រឿង ទៀត ពេញ ទំហឹង បណ្តាលឱ្យ លោកស្រី អភិបាល រង ខេត្ត ស្លាប់ បន្ទាប់ពី បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ចំណែក រថយន្ត ទាំង បី គ្រឿង ខូត ខាត ទាំង សង្ខាង ។
សូម បញ្ជាក់ ថា ជនរងគ្រោះ ដែល ស្លាប់ បាត់បង់ជីវិត មាន ឈ្មោះ សោម មុន្នីរ័ត្ន អាយុ ៥៦ ឆ្នាំ ជា អភិបាល រង ខេត្ត ប៉ៃលិន . លោកស្រី ម៉ុក ណាឌី អាយុ ៤៩ ឆ្នាំ ជា អភិបាល រង ខេត្ត បន្ទាយមានជ័យ រងរបួស ធ្ងន់ និង កូនប្រុស អភិបាល រង ខេត្ត ប៉ៃលិន រងរបួស ធ្ងន់ ផងដែរ ។
បច្ចុប្បន្ន សព ត្រូវបាន តម្កល់ ទុក ចំណែក ជនរងគ្រោះ ទាំង ពីរ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ៕ KCNA: សហរដ្ឋ អាមេរិក គួរតែ បញ្ឈប់ ការគាបសង្កត់ ឱ្យ កូរ៉េ ខាងជើង រំសាយ អាវុធ នុយក្លេអ៊ែរ
គួរ ជម្រាប ថា សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងជើង បាន ព្រមព្រៀង គ្នា រំសាយ អាវុធ នុយក្លេអ៊ែរ នៅលើ ឧបទ្វីប កូរ៉េ ក្រោយ ជំនួប រវាង ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ និង មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន ក្នុង ប្រទេស សិង្ហបុរី កាលពី ខែមិថុនា កន្លងទៅ ។ ប៉ុន្តែ ការរំសាយ អាវុធ នុយក្លេអ៊ែរ មិន មាន ភាពរីកចំរើន ទាល់តែ រីឯ សហរដ្ឋ អាមេរិក វិញ ក៏ មិន ព្រម បន្ធូរបន្ថយ ការដាក់ ទណ្ឌកម្ម លើ ទីក្រុង ព្យុងយ៉ាង រហូត ទាល់តែ អាវុធ នុយក្លេអ៊ែរ ត្រូវ រំសាយ ចោល ទាំងស្រុង ជាមុន សិន ។
ដំណើរ ភាពយន្ត ចល័ត ចិន - ខ្មែរ ដ៏ ឆ្នើម លើក ទី៣ ត្រូវបាន បញ្ចប់ ដោយ ជោគជ័យ យ៉ាង ខ្លាំង នៅ ខេត្ត មណ្ឌលគិរី
( មណ្ឌលគិរី ) ៖ ដំណើរ ភាពយន្ត ចល័ត ចិន - ខ្មែរ ដ៏ ឆ្នើម លើក ទី៣ ដែល បាន ធ្វើដំណើរ មកដល់ ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគិរី និង បាន ចាក់បញ្ចាំង នៅ ទីធ្លា ក្បែរ រង្វង់ មូល គោ ព្រៃ កាលពី រាត្រី ថ្ងៃទី ១៩ ខែធ្នូ ឆ្នាំ ២០១៨ នោះ ទទួលបាន នូវ ភាពជោគជ័យ យ៉ាង ខ្លាំង ដោយសារតែ មាន ការចូលរួម និង គាំទ្រ យ៉ាង ពេញ ទំហឹង ពីសំណាក់ ថ្នាក់ដឹកនាំ ខេត្ត ក៏ ដូចជា អាជ្ញាធរ ក្រុង មន្ទីរ ពាក់ព័ន្ធ និង ការចូលរួម ទស្សនា ពី បងប្អូន ប្រជាពលរដ្ឋ ព្រមទាំង ប្អូន ៗ សិស្សានុសិស្ស យ៉ាង ច្រើន កុះករ ប្រមាណ ជា ១.៣០០ នាក់ ។
គួរ បញ្ជាក់ ថា ឆ្នាំ ២០១៨ នេះ ស្រប ពេល ដែល ប្រមុខ ថ្នាក់ដឹកនាំ កម្ពុជា - ចិន បាន ប្រារព្ធ ខួប លើក ទី ៦០ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ ព្រឹត្តិការណ៍ « ដំណើ ភាពយន្ត ចល័ត ចិន - ខ្មែរ ដ៏ ឆ្នើម លើក ទី » ត្រូវបាន ចាប់ផ្ដើម បន្ត បេសកកម្ម របស់ ខ្លួន បន្ត ទៀត ដោយ មាន កិច្ចសហការ រវាង ស្ថានទូត ចិន ប្រចាំ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក្រសួង ព័ត៌មាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង រៀបចំ ផ្ទាល់ ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ។
ព្រឹត្តិការណ៍ ដំណើ ភាពយន្ត ចល័ត ចិន - ខ្មែរ ដ៏ ឆ្នើម លើក ទី៣ នេះ បាន ចាប់ផ្ដើម បេសកកម្ម ចាប់តាំងពី ថ្ងៃទី ៥ ខែធ្នូ ឆ្នាំ ២០១៨ ដោយ ទទួលបាន ជោគជ័យ យ៉ាង ធំ សម្បើម នៅ តាម បណ្ដា ខេត្ត មួយចំនួន ដូចជា ខេត្ត បាត់ដំបង ខេត្ត សៀមរាប ខេត្ត កំពង់ធំ ខេត្ត ស្ទឹងត្រែង ខេត្ត រតនគិរី និង ចុងក្រោយ គឺ ខេត្ត មណ្ឌលគិរី និង បាន ធ្វើដំណើរ ក្នុង ចម្ងាយ ផ្លូវ ដ៏ វែងឆ្ងាយ សរុប ប្រមាណ ជាជាង ២. ៥០០គីឡូម៉ែត្រ និង មាន អ្នកចូលរួម ទស្សនា សរុប ប្រមាណ ជា១៥ ។០០០ នាក់ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោកស្រី វិន ស៊ីធួ អភិបាល រង ខេត្ត មណ្ឌលគិរី ដែល បាន មាន វត្តមាន ជា អធិបតី ក្នុង ព្រឹត្តិការណ៍ នេះ បាន ថ្លែង ថា ព្រឹត្តិការណ៍ « ដំណើរ ភាពយន្ត ចល័ត ចិន - ខ្មែរ ដ៏ ឆ្នើម លើក ទី » នេះ បាន ជំរុញ ឱ្យ មាន ការផ្លាស់ប្តូរ នូវ វប្បធម៌ សិល្បៈ ភាព យន្ត នៃ ប្រទេស កម្ពុជា - ចិន ហើយក៏ បាន ធ្វើឱ្យ ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ស្គាល់ គ្នា កាន់តែ ច្បាស់ និង បាន ស្វែងយល់ ពី គ្នា ទៅ វិញ ទៅ មក កាន់តែ ស៉ី ជម្រៅ បន្ថែម ទៀត ។
ជាមួយគ្នា នេះ ដែរ លោក ហ្វឹង ហ៊ុយ អគ្គ នាយក វិទ្យុ មិត្តភាព កម្ពុជា - ចិន បាន ថ្លែង ថា ព្រឹត្តិការណ៍ ចាក់បញ្ចាំង ភាពយន្ត ចល័ត ចិន - កម្ពុជា ដ៏ ឆ្នើម លើក ទី៣ ឆ្នាំ ២០១៨ នេះ គឺ រៀបចំឡើង ឡើង ក្នុង គោលបំណង ដើម្បី ផ្លាស់ប្តូរ វប្បធម៌ និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ រឹងមាំ និង រីកចម្រើន បន្ថែម ទៀត ។
លោក ហ្វឹង ហ៊ុយ ក៏ បាន អរគុណ ចំពោះ រដ្ឋបាល ខេត្ត ក្រុង អាជ្ញាធរ និង បងប្អូន ប្រជាពលរដ្ឋ នៅ ខេត្ត មណ្ឌលគិរី ដែល បាន គាំទ្រ សហការ និង ចូលរួម ទស្សនា យ៉ាង ច្រើន កុះករ បែប នេះ ហើយ ការចូលរួម ទស្សនា របស់ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ តាម បណ្ដា ខេត្ត នានា ក៏ ដូចជា នៅ ខេត្ត មណ្ឌលគិរី នេះ ពិតជា បាន ជំរុញ ឱ្យ ទំនាក់ទំនង រវាង កម្ពុជា ចិន កាន់តែ ស្អិត រមួត និង រឹងមាំ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ឥត ឈប់ឈរ ។
កញ្ញា ត្រាវ ឆ្វេ ជា សិស្ស ថ្នាក់ ទី១០ នៃ វិទ្យាល័យ ហ៊ុន សែន មណ្ឌលគិរី ដែល បាន មក ចូលរួម ទស្សនា ភាពយន្ត ចិន ខ្មែរ នេះ ដែរ បាន ចាត់ទុក ថា ការបញ្ចាំង ភាពយន្ត នេះ ពិតជា ល្អ មើល ខ្លាំង ណាស់ ។ កញ្ញា ថា ទាំង រូបភាព ទាំង ការអប់រំ និង បាន មើលឃើញ ពី ទិដ្ឋភាព នានា នៃ ប្រទេស ចិន រួមទាំង វប្បធម៌ របៀបរបប រស់ នៅ របស់ ប្រជាជន ចិន និង កម្ពុជា ផងដែរ ។
