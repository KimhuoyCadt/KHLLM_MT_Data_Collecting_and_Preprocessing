( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្រ្ដី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន អះអាង ថា រហូតមកដល់ ពេលនេះ ការសិក្សា ផ្លូវ ល្បឿន លឿន ពី រាជធានី ភ្នំពេញ ទៅ បាវិត ព្រំដែន កម្ពុជា - វៀតណាម បាន សិក្សា រួចរាល់ ចប់ សព្វគ្រប់ អស់ ហើយ ដែល ត្រូវ ចំណាយ ថវិកា ធ្វើអស់ ប្រមាណ ៣. ៨០០ លាន ដុល្លារ សម្រាប់ សាងសង់ ។ នេះ បើ តាម ការចុះផ្សាយ របស់ AKP ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន អះអាង បែប នេះ ក្នុង ឱកាស ដែល បាន អញ្ជើញ ជា អធិបតី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ចំណត កំពង់ផែ កុងតឺន័រ LM១៧ ជំហាន ទី២ នៃ គម្រោង ពង្រីក ហេដ្ឋារចនាសម្ព័ន្ធ របស់ កំពង់ផែ ស្វយ័ត ភ្នំពេញ ស្ថិត នៅ ភូមិ កណ្តាល លើ ឃុំ បណ្តាយ ដែក ស្រុក កៀនស្វាយ ខេត្ត កណ្តាល ។
លោក បាន លើកឡើង ថា បើ ប្រៀបធៀប ទៅនឹង ការសាងសង់ ផ្លូវ ល្បឿន លឿន ពី រាជធានី ភ្នំពេញ ទៅ ខេត្ដ ព្រះសីហនុ ដែល មាន ប្រវែង ១៩០ គីឡូម៉ែត្រ នោះ គឺ ចំណាយ ថវិកា ប្រមាណ តែ២.០០០លាន ដុល្លារ ប៉ុណ្ណោះ ដោយសារ ផ្លូវ នេះ មិន មាន ការសាងសង់ ឆ្លងកាត់ បឹង ឬ តំបន់ លិច ទឹក ដូច ផ្លូវ ល្បឿន លឿន ភ្នំពេញ ទៅ បាវិត ។
លោក បាន បន្ដ ថា ដោយសារតែ ទំហំ ទឹកប្រាក់ ក្នុង ការចំណាយ សាងសង់ ផ្លូវ ល្បឿន លឿន ពី ភ្នំពេញ ទៅ បាវិត នេះ គឺ មាន ចំនួន ច្រើន ពេក នោះ រាជ រដ្ឋាភិបាល មិន ទាន់ សម្រេច ធ្វើ ការសាងសង់ ឬ យ៉ាងណា ទេ ដោយ កំពុងតែ ស្វែងរក ដៃគូ វិនិយោគ ពី វិស័យ ឯកជន ដើម្បី កសាង ផ្លូវ នេះ ។
លោក ទេសរដ្ឋមន្រ្ដី ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ទៀត ថា រាជ រដ្ឋាភិបាល កម្ពុជា នៅតែ បន្ដ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ ជាច្រើន ទៀត ជាពិសេស ការរៀបចំ ផែនការ យុទ្ធសាស្រ្ដ ដោយ ផ្ដោត សំខាន់ ៗ លើ ការអភិវឌ្ឍ ការដឹកជញ្ជូន តាម ផ្លូវគោក ផ្លូវ ដែក និង ផ្លូវ ទឹក ដើម្បី សម្រួល ដល់ មធ្យោបាយ ដឹកជញ្ជូន ទំនិញ និង ការធ្វើចរាចរណ៍ ប្រកបដោយ សុវត្ថិភាព កាត់បន្ថយ តម្លៃ ដឹកជញ្ជូន ជាមួយនឹង សេវា លឿន រហ័ស និង កាន់តែ មាន ប្រសិទ្ធភាព សម្រាប់ ចូលរួម ធ្វើ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ជាតិ ៕
មន្ទីរពិសោធន៍ ជីវ វេជ្ជសាស្រ្ត ដំបូង គេ បង្អស់ នៅ កម្ពុជា ទទួលបាន វិញ្ញាបនបត្រ ស្តង់ដារ អន្តរជាតិ
( ភ្នំពេញ ) ៖ ចាប់តាំងពី ឆ្នាំ ២០១២ មន្ទីរពិសោធន៍ ជីវ វេជ្ជសាស្រ្ត នៃ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន ចូលរួម ក្នុង ការធ្វើឲ្យ ប្រសើរឡើង ជា បន្តបន្ទាប់ នូវ គុណភាព ដែល ស្រប តាម តម្រូវការ នៃ ស្តង់ដារ អន្តរជាតិ NF EN ISO 15189: ២០១២ ដែល ចាំបាច់ សម្រាប់ មន្ទីរពិសោធន៍ ជីវ វេជ្ជសាស្ត្រ នានា នៅ ប្រទេស បារាំង ។
មន្ទីរពិសោធន៍ ជីវ វេជ្ជសាស្រ្ត បាន អនុវត្ត គោលការណ៍ ធានា គុណភាព មួយ នៅក្នុង បរិបទ នៃ បេសកកម្ម ការ វាយតម្លៃ រោគវិនិច្ឆ័យ និង ជំនួយ ព្យាបាល ដោយ មាន គោលបំណង ដូច ខាងក្រោម៖
* ធានា បាន នូវ គុណភាព នៃ ការធ្វើតេស្ត វិភាគ ដែល បាន ស្នើសុំ អាច ផ្តល់ ជូន នូវ លទ្ធផល ដែល ជឿ ទុកចិត្ត បាន និង ត្រឹមត្រូវ បំផុត តាម ដែល អាច ធ្វើ ទៅ បាន * ផ្តល់ ជូន លទ្ធផល ទាន់ ពេលវេលា ជាពិសេស នៅក្នុង ករណី បន្ទាន់ * ផ្តល់ ជូន នូវ ដំបូន្មាន ញឹកញាប់ តាម តម្រូវការ និង គ្រប់ ពេលវេលា
បន្ទាប់ពី ការធ្វើ សវនកម្ម មួយ នៅក្នុង ខែឧសភា ឆ្នាំ ២០១៨ គណៈកម្មាធិការ វាយតម្លៃ ទទួលស្គាល់ គុណភាព របស់ ប្រទេស បារាំង បាន សន្និដ្ឋាន ថា មន្ទីរពិសោធន៍ ជីវ វេជ្ជសាស្ត្រ នេះ បាន បំពេញ គ្រប់ លក្ខខណ្ឌ ស្រប តាម តម្រូវ ការស្តង់ដារ ហើយ បាន សំរេច ផ្ដល់ នូវ ការទទួលស្គាល់ គុណភាព លើ វិសាលភាព ជាក់លាក់ នៃ គ្លីនិក ជីវសាស្ត្រ ដូច ជា៖ ជីវ គីមី លោហិត សាស្រ្ត សេរ៉ូម សាស្រ្ត រក ជម្ងឺ ឆ្លង បាក់តេរីសាស្រ្ត និង ការធ្វើ រោគវិនិច្ឆ័យ រក មេរោគ រ បេង ជាមួយ GenXpert ។
ជាង នេះ ទៅ ទៀត ការទទួលស្គាល់ គុណភាព ស្រប តាម បទដ្ឋាន អន្ដរជាតិ ISO 15189 បាន បង្ហាញ ពី សមត្ថភាព បច្ចេកទេស នៃ មន្ទីរពិសោធន៍ និង ប្រតិបត្តិការ ត្រឹមត្រូវ មួយ នៅក្នុង មន្ទីរពិសោធន៍ មួយ នេះ ក្រោម ប្រព័ន្ធ គ្រប់គ្រង មួយ ដ៏ សមស្រប ។
មន្ទីរពិសោធន៍ ជីវ វេជ្ជសាស្ត្រ នៃ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា គឺជា មន្ទីរពិសោធន៍ ដំបូង គេ បង្អស់ នៅ កម្ពុជា ដែល ទទួលបាន វិញ្ញាបនប័ត្រ ISO 15189 ហើយ ជា ភស្តុតាង ច្បាស់លាស់ ដែល បញ្ជាក់ ពី គោលការណ៍ ធានា គុណភាព របស់ យើង នោះ គឺ ដើម្បី បង្កើន អត្ថប្រយោជន៍ ជា អចិន្រៃ្តយ៍ ដល់ អតិថិជន និង គ្រូពេទ្យ ចេញ វេជ្ជបញ្ជា ។
មន្ទីរពិសោធន៍ ជីវ វេជ្ជសាស្រ្ត ត្រូវបាន បង្កើតឡើង ដោយ ប្តេជ្ញា ស្វែងរក វិធីសាស្រ្ត ល្អ បំផុត ក្នុង ការផ្តល់ សេវា ដែល មាន គុណភាព ផ្តល់ នូវ លទ្ធផល ដែល ជឿ ទុកចិត្ត បាន និង ទាន់ ពេលវេលា ជូន ដល់ អ្នកជំងឺ របស់ ខ្លួន ( ប្រជាជន កម្ពុជា ជន បរទេស និង ភ្ញៀវ ទេសចរ ) សំរាប់ ប្រើប្រាស់ ក្នុង ការធ្វើ រោគវិនិច្ឆ័យ ប្រកបដោយ ប្រសិទ្ធភាព ដោយ សម្ងាត់ និង ដោយ ដំបូន្មាន ត្រឹមត្រូវ ៕ រដ្ឋមន្ត្រី ព័ត៌មាន គាំទ្រ ក្រសួង ធម្មការ ចំពោះ ការណែនាំ បញ្ហា ដឹក សត្វ មាន ជីវិត ទៅ កន្លែង សត្តឃាត
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ក្រសួង ធម្មការ និង សាសនា ចេញ សារាចរ ណែនាំ ចំពោះ បញ្ហា មិន សមរម្យ ក្នុង អាជីវកម្ម សត្តឃាត រួច មក រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញ៉ារីទ្ធ បាន បង្ហោះ សារ គាំទ្រ មួយ ចំពោះ ចំណាត់ការ នេះ ខណៈ ដែល លោក ក៏ ទើស ភ្នែក អំពី បញ្ហា ខាងលើ ផងដែរ ។
ការ ដឹកជញ្ជួន សត្វ មាន ជីវិត តាម ផ្លូវ យក ទៅ កន្លែង សត្តឃាត ដោយ គ្មាន ការបិទបាំង នេះ តែង កើតមាន ជារឿយ ៗ នៅក្នុង ប្រទេស កម្ពុជា តែ មិន ទាន់ មាន ចំណាត់ ការ ណាមួយ ពី អាជ្ញាធរ មាន សមត្ថកិច្ច នៅឡើយ ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០១៨ កន្លងទៅ ក្រសួង ធម្មការ និង សាសនា បាន ចេញ សារាចរ ណែនាំ ស្ដីពី ការអនុវត្ត គោលការណ៍ ណែនាំ របស់ រាជ រដ្ឋាភិបាល លើ ការធ្វើ ការ អាជីវកម្ម សត្វ មាន ជីវិត ក្នុង ន័យ ណែនាំឲ្យ អ្នក ធ្វើ អាជីវកម្ម ទាំងអស់ រៀបចំ ការបិទបាំង ឲ្យបាន សមរម្យ ក្នុង ពេល ដឹកជញ្ជូន សត្វ មាន ជីវិត ទាំងនោះ ទៅ កន្លែង សត្តឃាត ៕ គម្រោង ការពារ ទឹក ជំនន់ ដែល ជា ជំនួយ ឥត សំណង របស់ ជប៉ុន តម្លៃ ៣០ លាន ដុល្លារ ចាប់ផ្តើម អនុវត្តន៍ ហើយ !
( ភ្នំពេញ ) ៖ គម្រោង ការពារ ទឹក ជំនន់ និង កែលម្អ ប្រព័ន្ធ ប្រឡាយ លូ ជំហាន ទី៤ ដែល ជា គម្រោង ហិរញ្ញប្បទាន របស់ ប្រទេស ជប៉ុន តាមរយៈ អង្ក ការចៃកា (JICA) មាន ទឹកប្រាក់ ប្រមាណ ៣០ លាន ដុល្លារ អាមេរិក ហើយ គម្រោង ទាំងនេះ មាន ទាំង ការដាក់ បណ្តាញ លូមេ សាងសង់ អាង ស្តុក ទឹក ក្រោម ដី និង សាងសង់ ស្ថានីយ៍ បូម ទឹក និង ការតម្លើង របាមេ កានិច ស្វ័យប្រវត្តិ ដើម្បី ប្រមូល សំរាម នៅមុខ ផ្លូវ បង្ហូរ ទឹក នៃ ស្ថានីយ៍ បូម ទឹក ជាដើម ចាប់ផ្តើម អនុវត្តន៍ ។
នេះ បើ តាម ការបង្ហាញ ឲ្យដឹង ក្នុង កិច្ចប្រជុំ ដំបូង នៃ គម្រោង ការពារ ទឹក ជំនន់ និង កែលម្អ ប្រព័ន្ធ ប្រឡាយ លូ ក្នុង រាជធានី ភ្នំពេញ ជំហាន ទី៤ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែធ្នូ ឆ្នាំ ២០១៨ នៅ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ។
លោក សាំ ពិសិដ្ឋ ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា គម្រោង ការពារ ទឹក ជំនន់ និង កែលម្អ ប្រព័ន្ធ ប្រឡាយ លូ ក្នុង រាជធានី ភ្នំពេញ ជំហាន ទី៤នេះ មាន ទឹកប្រាក់ សរុប ប្រមាណ ៣០លាន ដុល្លារ អាមេរិក ដែល ជា ជំនួយ ឥត សំណង របស់ រដ្ឋាភិបាល ជប៉ុន តាមរយៈ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ ជប៉ុន JICA ។
គម្រោង នេះ នឹង អនុវត្តន៍ ការដ្ឋាន ដូចតទៅ៖ ១ - ដាក់ បណ្តាញ លូមេ នៅក្នុង ភូមិសាស្ត្រ ខណ្ឌ ទួលគោក ប្រវែង ៨.២គីឡូម៉ែត្រ . ២ - ដាក់ បណ្តាញ លូមេ នៅក្នុង ភូមិសាស្ត្រ ខណ្ឌ ដូនពេញ ប្រវែង ៤. ៤គីឡូម៉ែត្រ . ៣ - សាងសង់ អាង ស្តុក ទឹក ក្រោម ដី និង សាងសង់ ស្ថានីយ៍ បូម ទឹក នៅ សួនច្បារ មុខ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា . ៤ - តម្លើង របាមេ កានិច ស្វ័យប្រវត្តិ ដើម្បី ប្រមូល សំរាម នៅមុខ ផ្លូវ បង្ហូរ ទឹក នៅ ស្ថានីយ៍ បូម ទឹក ចតុមុខ ព្រះគន្លង់១ ព្រះគន្លង់២ និង ផ្សារ ចាស់ និង ៥- ផ្តល់ រថយន្ត បូម ទឹក ចល័ត ចំនួន ២គ្រឿង ។
ពាក់ព័ន្ធ នឹង គម្រោង ខាងលើ នេះ លោក ម៉េត មាស ភក្តី អ្នកនាំពាក្យ រដ្ឋបាល រាជធានី ភ្នំពេញ នា ពេល កន្លងមក នេះ ក៏ បាន ធ្លាប់ បាន ឲ្យដឹង ដែរ ថា គម្រោង ជំហាន ទី៤ នៃ ការការពារ ទឹក ជំនន់ និង កែលម្អ ប្រព័ន្ធ ប្រឡាយ លូ នេះ បាន ផ្តោត ទៅ លើ ការងារ សំខាន់ ៗ មួយចំនួន ដូចជា ការងារ រំដោះ ទឹក ។
ការងារ រំដោះ ទឹក នេះ ចែកចេញ ជា ពីរ ផ្នែក ទៀត ដែល គោលបំណង ធំ ឬ អត្ថប្រយោជន៍ ធំ គឺ ទទួលបាន នៅ ផ្នែក ខាងជើង វត្តភ្នំ នៅក្នុង តំបន់ ផ្លូវ អម ផ្លូវ និង ផ្លូវ ១៤៧ ដោយ ចាប់ពី វត្តភ្នំ រហូត ទៅដល់ រង្វង់ មូល គួច កាណុង មាន ផ្ទៃ ប្រមាណ ជិត ៧០ ហិកតា ដែល នឹង ត្រូវ រៀបចំ និង គិតគូរ ឲ្យ មាន ជា ស្ថានីយ៍ បូម ទឹក មួយ កន្លែង ដែល ស្ថានីយ៍ បូម ទឹក នេះ ជា ស្ថានីយ៍ ទី៥ ស្រប តាម មាត់ ទន្លេ មាន ទីតាំង នៅ ទល់មុខ សួនច្បារ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ សេដ្ឋកិច្ច (CDC) ។
នៅក្នុង ស្ថានីយ៍ បូម ទឹក នេះ នឹង រៀបចំ ឲ្យ មាន អាង ស្តុក ទឹក ក្រោម ដី ដែល មាន សមត្ថភាព អាច ស្តុក ទឹក ប្រមាណ ៦.០០០ ម៉ែត្រ គូប មុននឹង ធ្វើ ការបូម ទម្លាក់ ទឹកភ្លៀង ពី អាង ស្តុក ទឹក ចូល ទៅក្នុង ទន្លេ ។
បន្ថែម ពី ការរៀបចំ ស្ថានីយ៍ បូម ទឹក នេះ នឹង មាន ការដំឡើង ជា ម៉ាស៊ីន ចាប់ យក សំរាម ដោយ ស្វ័យប្រវត្តិ ដែល កិច្ចការ នេះ ជា ចំណែក មួយ នៃ គម្រោង ជំហាន នទី៤ ហើយ គម្រោង នេះ នឹង យក ទៅ បំពាក់ នៅ គ្រប់ ស្ថានីយ៍ ទាំង៤ នៅ ជាប់ មាត់ ទន្លេ គឺ ស្ថានីយ៍ បូម ទឹក ផ្សារ ចាស់ ស្ថានីយ៍ ព្រះគម្លង់ ស្ថានីយ៍ ផ្សារ កណ្តាល និង ស្ថានីយ៍ ចតុមុខ ដែល ជា ស្ថានីយ ស្ថាបនា រួចហើយ តាំងពី គម្រោង ជំហាន នទី២មក ម្ល៉េះ ។
បន្ថែម ឧបករណ៍ កាយ សំរាម ដោយ ស្វ័យប្រវត្តិ នៅក្នុង ស្ថានីយ៍ ទាំង៤ លើ គម្រោង ជំហាន ទី៤នេះ ។ អត្ថប្រយោជន៍ នៃ ការសម្រួល ផ្ទៃ ទឹក នៅក្នុង តំបន់ ទួលគោក ស្ថិត ក្នុង សង្កាត់ បឹងកក់១ សង្កាត់ បឹងកក់២ ។
ក្នុង គម្រោង នឹង មាន ការរៀបចំ ដាក់ ប្រព័ន្ធ បណ្តាញ លូ ក្នុង ទំហំ ចន្លោះ ចាប់ពី ២ម៉ែត្រ ទៅ២. ៥០ម៉ែត្រ ចម្ងាយ ប្រមាណ ជិត ៧គីឡូម៉ែត្រ និង ការដាក់ លូ ប្រអប់ ប្រវែង១.៥គីឡូម៉ែត្រ ។
( ភ្នំពេញ ) ៖ ក្រោយ របប ខ្មែរ ក្រហម ត្រូវបាន វាយ ផ្តួលរំលំនៅ ឆ្នាំ ១៩៧៩ មេដឹកនាំ ខ្មែរ ក្រហម រួម នឹង ទាហាន ខ្មែរ ក្រហម បាន រត់ សម្ងំ លាក់ ខ្លួន និង តាំង ទី នៅ តាម បណ្តោយ ព្រំដែន ខ្មែរ - ថៃ និង តំបន់ មួយចំនួន ទៀត ដូចជា ក្នុង ខេត្ត ប៉ៃលិន បន្ទាយមានជ័យ បាត់ដំបង និង ព្រះវិហារ ជាដើម ។ ជាពិសេស នៅលើ ខ្នងភ្នំ ដងរែក ក្នុង ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ជា មូលដ្ឋាន តស៊ូ ដ៏ រឹងមាំ ចុងក្រោយ គេ របស់ ខ្មែរ ក្រហម ។
បន្ទាប់ពី តស៊ូ ប្រយុទ្ធ ប៉ុនប៉ង កាន់ កាប់ ដែនដី កម្ពុជា ជាថ្មី អស់ រយៈពេល ជិត ២០ ឆ្នាំ ពួកគេ ក៏ បាន ចុះ ចូល ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ជា បន្តបន្ទាប់ ។ មេដឹកនាំ និង កងទ័ព ខ្មែរ ក្រហម នៅ ស្រុក អន្លង់ វែង បាន ចុះ ចូល ចុងក្រោយ គេ នៅក្នុង ឆ្នាំ ១៩៩៨ ហើយក៏ ជា ពេល ដែល កម្ពុជា បាន បិទ បញ្ចប់ ទំព័រ នៃ ភ្លើង សង្គ្រាម ទាំងស្រុង បន្ទាប់ពី ឆាបឆេះ អស់ រយៈពេល ជិត ៤០ ឆ្នាំ ។
តើ មាន មូលហេតុ អ្វី នាំឲ្យ មេដឹកនាំ និង ទាហាន ខ្មែរ ក្រហម នៅ តំបន់ អន្លង់ វែង និង តំបន់ ដទៃ ទៀត ចុះ ចូល ជាមួយ រាជ រដ្ឋាភិបាល ?
( ភ្នំពេញ ) ៖ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ដ៏ រន្ធត់ មួយ រវាង ម៉ូតូ រ៉ឺម៉ក ដឹក ដែក បាន ដាច់ កង់ ម្ខាង ហើយក៏ រ៉េ ចង្កូត ទៅ បុក ជាមួយនឹង រថយន្ត សាំ យ៉ុង ដឹក កម្មករ១ គ្រឿង ដែល កំពុង ធ្វើដំណើរ បញ្ច្រាស ទិស ផ្សេង គ្នា បណ្ដាលឲ្យ មាន អ្នកស្លាប់ ម្នាក់ និង ម្នាក់ ទៀត រងរបួស ធ្ងន់ ។ ជនរងគ្រោះ ដែល រងរបួស ធ្ងន់ ត្រូវបាន ដឹក យក ទៅ សង្គ្រោះ បន្ទាន់ នៅឯ មន្ទីរពេទ្យ ។
ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ដ៏ រន្ធត់ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៨ ដែល ស្ថិត នៅ ចំណុច មុខ វត្ត កំពែង តាម បណ្ដោយ ផ្លូវ បេតុង ស្ថិត ក្នុង សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
ជន បង្ក មាន ឈ្មោះ ហ៊ុន ង៉ែត ម៉ឺន ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ មុខរបរ បើកបរ រថយន្ត ដឹក កម្មករ មាន ស្រុក កំណើត នៅ ស្រុក ព្រះស្ដេច ខេត្ត ព្រៃវែង ។ រីឯ ជនរងគ្រោះ ដែល ស្លាប់ និង ម្នាក់ ទៀត រងរបួស ធ្ងន់ នោះ មិន ត្រូវបាន ស្គាល់ អត្តសញ្ញាណ នៅឡើយ ទេ ។
