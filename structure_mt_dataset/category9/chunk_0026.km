ឆ្លៀត ឱកាស នោះ ដែរ ក្រុមការងារ ក៏ បាន ចែក ផ្សាយ នូវ រូបភាព Poster និង ផ្សព្វផ្សាយ ដល់ អាជីវករ អ្នកលក់ដូរ និង អ្នកប្រើប្រាស់ នៅ ផ្សារ ស្អាង ព្រែក តូច និង ផ្សារ កោះ ធំ ដើម្បីឲ្យ ពួកគាត់ បាន យល់ដឹង អំពី ផលវិបាក ដែល បណ្តាល មកពី ការបរិភោគ អាហារ ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ និង ការដាក់ លាយ បន្ថែម សារធាតុ គីមី ក្នុង ម្ហូប អាហារ ។
លោក អ៊ូ ម៉ាន រិន ក៏ បាន ណែនាំ ដល់ អាជីវករ លក់ដូរ ទាំងអស់ អំពី អនាម័យ និង របៀប ដាក់ តាំង លក់ ទំនិញ ឲ្យបាន ត្រឹមត្រូវ ស្រប ទៅ តាម យថា ប្រភេទ នៃ ទំនិញ នីមួយ ៗ ដើម្បី បញ្ជៀស នូវ ការឆ្លង បាត់ តេរី ផ្សេង ៗ ផងដែរ និង បាន សំណូមពរ ដល់ អាជីវករ នៅក្នុង ផ្សារ ទាំង ពីរ ឲ្យ ជួយ ត្រួតពិនិត្យ ទំនិញ ដោយ ខ្លួន ឯង ចំពោះ ការបរិច្ឆេទ នៃ ទំនិញ និង ហាម ដាក់ តាំង លក់ ទំនិញ ដែល ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ នេះ ផងដែរ ៕
ក្រុមហ៊ុនាំចេញ អង្ករ មួយ ទៀត តំណាង ឲ្យ កសិករ ខ្មែរ ជាង ២ម៉ឺន នាក់ ដាក់ លិខិត តវ៉ា ទៅ សហគមន៍ អឺរ៉ុប ចំពោះ គម្រោង ដាក់ គំនាប ពន្ធដារ លើ អង្ករ កម្ពុជា !
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន នាំចេញ អង្ករ របស់ កម្ពុជា ថ្មី មួយ ទៀត ហើយ ដែល តំណាង ឲ្យ ប្រជាកសិករ ជាង ៤ពាន់ គ្រួសារ ស្មើនឹង ប្រជាពលរដ្ឋ ២ម៉ឺន នាក់ បាន ដាក់ លិខិត តវ៉ា ចំពោះ សហគមន៍ អឺរ៉ុប ដែល គ្រោង នឹង ដាក់ គំនាប ពន្ធដារ លើក អង្ករ កម្ពុជា ។
សហគមន៍ អឺរ៉ុប នឹង សម្រេច ថា ដាក់ គំនាប ពន្ធ លើក អង្ករ កម្ពុជា ឬ មិន ដាក់ នៅ ថ្ងៃទី ០៤ ខែធ្នូ ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
ការតវ៉ា របស់ ក្រុមហ៊ុន នាំចេញ អង្ករ នេះ ធ្វើឡើង បន្ទាប់ពី ក្រសួង ពាណិជ្ជកម្ម របស់ សគមន៍ អឺរ៉ុប ចាប់ផ្តើម សើរើ ឡើងវិញ លើ អង្ករ កម្ពុជា តាម បណ្តឹង របស់ ប្រទេស អ៊ីតាលី ហើយ រកឃើញ ថា អង្ករ កម្ពុជា មាន សក្តានុពល ធ្វើឲ្យ ប៉ះពាល់ ដល់ កសិករ នៅ ប្រទេស អ៊ីតាលី មែន ប៉ុន្តែ រកឃើញ នេះ គឺ មិន សម ហេតុផល ព្រោះ អង្ករ របស់ អ៊ីតាលី គឺជា ប្រទេស អង្ករ ស ហើយ អង្ករ របស់ កម្ពុជា នាំចេញ ទៅ អឺរ៉ុប គឺជា ប្រទេស អង្ករ ក្រអូប ដែល អ៊ីតាលី ដាំដុះ ពុំ បាន រឿង អី្វ បានជា ទៅ ប៉ះពាល់ ដល់ អង្ករ អ៊ីតាលី ។
នាយក ក្រុមហ៊ុន រូប នេះ សង្កត់ធ្ងន់ ថា « ការលើកឡើង របស់ អ៊ីតាលី ហាក់ដូចជា ផ្ទុយ ពី ការពិត ដែល មាន នៅ កម្ពុជា ក្នុង លិខិត ដែល ខ្ញុំ ដាក់ ទៅ នោះ គឺ ដើម្បីឲ្យ គាត់ ពិនិត្យ ឡើងវិញ អំពី តថភាព ជាក់ស្តែង និង ឲ្យ គាត់ ( សហគមន៍ អឺរ៉ុប ) ពិចារណា ឡើងវិញ បន្ទាប់ពី គាត់ បាន ពិនិត្យ លើ ទិដ្ឋភាព ជាក់ស្តែង ដែល យើង ផលិត ដែល យើង មាន ហើយ វា ផ្ទុយ ស្រឡះ ពី ការរកឃើញ របស់ គាត់ សូមឲ្យ គាត់ ដក ចេញ វិញ ទៅ លើ របាំង ពន្ធដារ ទារ ពន្ធ លើ អង្ករ យើង គឺ មិន សមរម្យ និង មិន ត្រូវ នូវ អ្វី ដែល គាត់ បាន អង្កេត » ។
រដ្ឋមន្ដ្រី ក្រសួង អប់រំ ណែនាំ គ្រប់ មន្ទីរ អប់រំ និង គ្រឹះស្ថាន សិក្សា ទាំងអស់ វាយ គង ទូង ស្គ ទះ ប៉ោត និង គោះ ត្រ ដោក នៅ យប់ ថ្ងៃទី ៣០ វិច្ឆិកា ដើម្បី អបអរសាទរ ការដាក់ « ល្ខោន ខោល » ជា សម្បត្តិ បេតិកភណ្ឌ
( ភ្នំពេញ ) ៖ លោក ហង់ ជួន ណារ៉ុន រដ្ឋមន្ដ្រី ក្រសួង អប់រំ យុវជន និង កីឡា បាន អំពាវនាវ ដល់ គ្រប់ មន្ទីរ អប់រំ សាកលវិទ្យាល័យ វិទ្យាស្ថាន និង គ្រឹះស្ថាន សិក្សា ទាំងអស់ ចូលរួម វាយ គង ទូង ស្គ ទះ ប៉ោត គោះ ត្រ ដោក និង ប្រើ មធ្យោបាយ ផ្សេង ៗ នៅ ម៉ោង ១០ យប់ ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ដើម្បី អបអរសាទរ ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្ត្រ ចំពោះ ការដាក់ « ល្ខោន ខោល » ចូលក្នុង បញ្ជី បេតិកភណ្ឌ សម្បត្តិ វប្បធម៌ អរូបីយ៍ នៃ មនុស្សជាតិ ។
នេះ បើ តាម លិខិត របស់ លោក រដ្ឋមន្ដ្រី ផ្ញើ ទៅកាន់ សាកលវិទ្យាធិការ និង វិទ្យាស្ថាន និង លោក ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី - ខេត្ត នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ។
ស្រូវ ប្រាំង របស់ កសិករ ជិត១ ពាន់ ហិកតា ក្នុង សង្កាត់ រកា កណ្តាល ក្រុង ក្រចេះ រង ការលិចលង់ ដោយសារ ទឹកភ្លៀង រយៈពេល ២ ថ្ងៃ ជាប់ ៗ គ្នា
( ក្រចេះ ) ៖ គិត មកដល់ ល្ងាច ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ស្រូវ ប្រាំង របស់ កសិករ មាន ចំនួន ជិត១ ពាន់ ហិតា ស្ថិត ក្នុង សង្កាត់ រកា កណ្តាល ក្រុង ក្រចេះ ខេត្ត ក្រចេះ កំពុង ទទួលរង ការលិចលង់ និង ឈាន ទៅរង ការខូចខាត ទាំងស្រុង ប្រសិនបើ សភាព លិច លង់ នេះ នៅតែ បន្ត អូសបន្លាយ រយៈពេល យូរ ដោយ មិន មាន ការជួយសង្គ្រោះ ទាន់ ពេលវេលា ទេ នោះ ។
ការលិចលង់ ដែល មាន ទំហំ ធំធេង គួរឱ្យ សោកស្តាយ របស់ ប្រជាកសិករ ខាងលើ នេះ គឺ ក្រោយពេល ដែល ខេត្ត ក្រចេះ ទាំងមូល បាន ទទួល នូវ ឥទ្ធិពល ព្យុះ USAGI បង្ករ ឱ្យ មាន ភ្លៀង ធ្លាក់ ចំនួន ពី ថ្ងៃ ជាប់ ៗ ជា ហេតុ ធ្វើឱ្យ មាន ទឹក ជំនន់ កើតឡើង ដោយ កន្លែង ខ្លះ ការលិចលង់ មាន ជម្រៅ រហូតដល់ទៅ ពីរ ម៉ែត្រ ក៏ មាន ។
ពលរដ្ឋ ដែល បង្កបង្កើន ផល ស្រូវ ប្រាំង បាន ជម្រុញ ឱ្យ អាជ្ញាធរ ក្រុង ចុះ រុះរើ ចោល ឧបករណ៍ ចាប់ ត្រី ជាច្រើន ប្រភេទ ដែល ដាក់ បិទ ផ្លូវ ទឹក នៅ តាម បឹង ព្រែក និង អូរ នានា ដើម្បី រំដោះ ទឹកភ្លៀង ឱ្យ ហូរ ចេញ បាន ឆាប់ រហ័ស ។ អាជ្ញាធរ ក្រុង បាន លើកឡើង ថា ក្រោយពី ជំនន់ ទឹកភ្លៀង ដែល កើត ចេញ ពី ចំហាយ ព្យុះ បាន បង្អុរ ធ្លាក់ រយៈពេល ២យប់ ១ ថ្ងៃ បាន បង្ក ការជន លិច យ៉ាង ធ្ងន់ធ្ងរ ស្ទើរ គ្រប់ ទីកន្លែង ក្នុង ភូមិសាស្រ្ត ក្រុង ក្រចេះ ។
លោក ហេង រ័ត្ន ម៉ូលីដា ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត ក្រចេះ បាន ឱ្យដឹង នៅ ល្ងាច ថ្ងៃទី ២៨ ខែវិច្ឆកា ដែ ថា លោក បាន ចាត់ មន្រ្តី របស់ លោក ចុះ ទៅ សហការ ជាមួយ អាជ្ញាធរ និង បងប្អូន ប្រជាពលរដ្ឋ ចុះ ទៅ រុះរើ បទល្មើស នេសាទ ដូចជា ធ្នួស និង របាំង ស្បៃ មុង នៅ តាម បណ្ដា ព្រែក នានា ដែល ជា ហេតុ បណ្ដាលឱ្យ ស្ទះ ទឹក ហូរ ចូលក្នុង ទន្លេ មិន លឿន ។
គួរ ជម្រាប ថា ខណៈ របាយការណ៍ របស់ ក្រសួង ការពារ ជាតិ អាមេរិក បាន បង្ហាញ ថា សព្វ ថ្ងៃ ចិន មាន នាវា មុជទឹក នុយក្លេអ៊ែរ ដែល កំពុង ធ្វើ ប្រតិបត្តិការ ចំនួន តែ ០៤ គ្រឿង នោះ វែបសាយ Defense One បាន អះអាង ថា តាមពិត មាន តែ ០២ គ្រឿង ប៉ុណ្ណោះ ប៉ុន្តែ អ្នកជំនាញ ផ្សេង ទៀត បាន អះអាង ថា វា ជា រឿង មើលងាយ ចិន សុទ្ធសាធ ហើយ អ្វី ដែល ជា អាថ៌កំបាំង ពីក្រោយ រឿង នេះ គឺ ពិតជា នឹង លាតត្រដាង ក្នុង ពេល ឆាប់ ៗ ៕ សមាជិក អាស៊ាន ទាំង១០ រួមគ្នា ពិភាក្សា លើ ការរៀបចំ ស្តង់ដារ បណ្តុះបណ្តាល ជំនាញ ស្ប៉ា និង សុខ មាលភាព អាស៊ាន
( សៀមរាប ) ៖ ក្រសួង ទេសចរណ៍ កម្ពុជា បាន រៀបចំ កិច្ចប្រជុំ ពិសេស នៃ គណៈកម្មការ តាមដាន និង ត្រួតពិនិត្យ អ្នកជំនាញ ទេសចរណ៍ អាស៊ាន (ATPMC) ចាប់ពី ថ្ងៃទី ២៨ - ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ ខេត្ត សៀមរាប ដើម្បី បន្ត រៀបចំ ស្តង់ដា កម្មវិធី បណ្ដុះបណ្ដាល ជំនាញ ស្ប៉ា អាស៊ាន ដោយ មាន ការចូលរួម ពី តំណាង ក្រសួង ទេសចរណ៍ អាស៊ាន សមាគម ស្ប៉ា នៃ បណ្ដា ប្រទេស អាស៊ាន និង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ នានា ។
លោក ប៉ាក់ សុខុម រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង ជា តំណាង រដ្ឋមន្ត្រី លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន ថ្លែង ក្នុង កម្មវិធី បើក កិច្ចប្រជុំ ដោយ លើកឡើង ថា ដោយ ក្រសួង ទេសចរណ៍ កម្ពុជា មាន ភាពជឿនលឿន លើ ការអភិវឌ្ឍ ធនធាន មនុស្ស ស្រប តាម យន្តការ និង ស្តង់ដា អាស៊ាន ប្រទេស ជា សមាជិក អាស៊ាន បាន ស្នើឲ្យ កម្ពុជា ដឹកនាំ រៀបចំ ស្តង់ដា បណ្ដុះបណ្ដាល ជំនាញ ស្ប៉ា អាស៊ាន សម្រាប់ អនុវត្ត ក្នុង ប្រទេស អាស៊ាន ទាំងអស់ ។
ស្តង់ដា នេះ នឹង ត្រូវ ដាក់បញ្ចូល ជា ឧបសម្ព័ន្ធ បន្ថែម នៃ កិច្ចព្រមព្រៀង ទទូល ស្គាល់ គ្នា ទៅ វិញ ទៅ មក លើ អ្នកជំនាញ ទេសចរណ៍ អាស៊ាន (ASEAN MRA TP) ដែល មាន គោលបំណង សម្រួល ឲ្យ អ្នកជំនាញ ទេសចរណ៍ មាន សមត្ថភាព ស្រប តាម ស្តង់ដា អាស៊ាន ចំនួន ៣២មុខ ក្នុង សេវាកម្ម សណ្ធា គារ និង សេវាកម្ម ធ្វើដំណើរ អាច បម្លាស់ ទី ការងារ ក្នុង តំបន់ ស្រប តាម ច្បាប់ និង យន្ត ការរួម អាស៊ាន ។
ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង អភិវឌ្ឍ ជំនាញ ទេសចរណ៍ ដល់ យុវជន ក្រសួង ទេសចរណ៍ កម្ពុជា បាន រៀបចំ និង ដាក់ចុះ អនុវត្ត កម្មវិធី បណ្ដុះបណ្ដាល អាស៊ាន នេះ តាម សាលា បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ទេសចរណ៍ នានា ដោយ ទទួលបាន លទ្ធផល ខ្ពស់ និង បាន ចែករំលែក បទពិសោធន៍ ជោគជ័យ ដល់ ប្រទេស សមាជិក អាស៊ាន មួយចំនួន ទៀត ផងដែរ ។
នា ពេល ថ្មី ៗ នេះ ក្រសួង ទេសចរណ៍ ក៏ បាន រៀបចំ និង ដាក់ ឲ្យ ប្រើប្រាស់ ផងដែរ នូវ ស្តង់ដា សមត្ថភាព ស្ប៉ា និង សុខុមាលភាព កម្ពុជា របស់ ខ្លួន នៅ តាម សាលា បណ្តុះបណ្តាល វិជ្ជាវៈ ទេសចរណ៍ នានា ដើម្បី លើកកម្ពស់ គុណ តម្លៃ ជំនាញ ស្ប៉ា នេះ ។ ទន្ទឹមនឹង នេះ ដែរ ក៏ បាន បណ្ដុះបណ្ដាល បំប៉ន សមត្ថភាព អ្នកជំនាញ ម៉ាស្សា កំពុង ធ្វើការ ជាច្រើន ពាន់ អ្នក ផងដែរ ។
សូម រំលឹក ផងដែរ ថា ជាមួយនឹង កំណើន ទេសចរ ជាតិ និង អន្តរជាតិ ដ៏ ខ្លាំងក្លា នា ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ វិស័យ ទេសចរណ៍ បាន បង្កើត ការងារ ផ្ទាល់ រហូតមកដល់ បច្ចុប្បន្ន បាន ប្រមាណ ជាង ៦២ ម៉ឺន នាក់ ស្មើនឹង ១៣% នៃ ការងារ សរុប ហើយ នៅក្នុង ឆ្នាំ ២០២០ និង បង្កើត ការងារ ផ្ទាល់ បាន ប្រមាណ ១លាន នាក់ ឆ្នាំ ២០២៥ ប្រមាណ ១.២លាន នាក់ និង ឆ្នាំ ២០៣០ បាន ចំនួន ២លាន នាក់ ដោយ មិន គិត ពី ការងារ ដោយ ប្រយោល រាប់ សិប ម៉ឺន នាក់ ទៀត ៕
ស្ថានទូត ជប៉ុន ប្រចាំ កម្ពុជា រៀបចំ អបអរសារទ ព្រះរាជ ពិធី បុណ្យ ចំរើន ព្រះជន្ម អធិរាជ ជប៉ុន ៨៤ ឈានចូល ៨៥ ព្រះវស្សា និង ជា ឆ្នាំ ចុងក្រោយ នៃ ការឡើង គ្រងរាជសម្បត្តិ
( ភ្នំពេញ ) ៖ លោក ហូរិណូ អ៊ុជិ ហ៊ីដេហ៊ីសា ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា បាន រៀបចំ អបអរសារទ ព្រះរាជ ពិធី បុណ្យ ចំរើន ព្រះជន្ម ព្រះករុណា ព្រះចៅ អធិរាជ ជប៉ុន អាគីហ៊ីតូ ៨៤ ឈាន ចូល ៨៥ ព្រះវស្សា ជា ខួប អនុស្សាវរីយ៍ ៣០ ឆ្នាំ នៃ ការឡើង គ្រងរាជសម្បត្តិ និង ជា ឱកាស នៃ ការបំពេញ ព្រះរាជ តួនាទី ជា ព្រះចៅ អធិរាជ ប៉ុន ផងដែរ ។
ការរៀបចំ ពិធី អបអរសារទ ព្រះរាជ ពិធី បុណ្យ ចំរើន ព្រះជន្ម អធិរាជ ជប៉ុន នេះ បាន ធ្វើឡើង នា យប់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ ស្ថានទូត ជប៉ុន ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ឧប នាយក រដ្ឋមន្ត្រី ប៊ិន ឈិន រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្តីការ គណៈ រដ្ឋមន្ត្រី . ឯ អគ្គ រាជ ទូត . ឯក អគ្គ រដ្ឋទូត បណ្តា ប្រទេស ជា មិត្ត និង តំថ្នាក់ដឹកនាំ ស្ថាប័ន រាជ រដ្ឋាភិបាល កម្ពុជា យ៉ាង ច្រើន កុះករ ផងដែរ ។
នៅក្នុង ឱកាស នេះ ដែរ លោក ហូរិណូ អ៊ុជិ ហ៊ីដេហ៊ីសា បាន ថ្លែង ថា ព្រះករុណា ព្រះចៅ អធិរាជ ជប៉ុន អាគីហ៊ីតូ នឹង ដាក់ រាជ នៅ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ក្រោយ ហើយ ព្រះអង្គម្ចាស់ ណា រុហ៊ីតូ ព្រះរាជ ទាយាទ នេង បន្ត ឡើង គ្រងរាជសម្បត្តិ នៅ ថ្ងៃទី១ ខែឧសភា ឆ្នាំ ក្រោយ ផងដែរ ។
ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ កម្ពុជា រូប នេះ បាន បន្ត ថា រយៈពេល ៣០ ឆ្នាំ នៃ ការឡើង គ្រងរាជសម្បត្តិ របស់ ព្រះចៅង ធិរាជ អាគីហ៊ីតូ គឺ អំឡុង ពេល ដំណើរការស្វែងរក សន្តិភាព រហូតដល់ ការអភិវឌ្ឍ ប្រទេស កម្ពុជា នា ពេល បច្ចុប្បន្ន នេះ ព្រមទាំង ជា ពេលវេលា នៃ ការពង្រឹង និង ពង្រីក ចំណង មិត្តភាព រវាង ជប៉ុន និង កម្ពុជា ដ៏ គួរឱ្យ គត់ សម្គាល់ ។
ឧប នាយក រដ្ឋមន្ត្រី ប៊ិន ឈិន បាន បន្ត ថា ចាប់តាំងពី ឆ្នាំ ១៩៩០ ប្រទេស ជប៉ុន បាន ដើរ ទួនាទី យ៉ាង សំខាន់ ក្នុង ដំណើរការ សន្តិភាព និង ការកសាង សន្តិភាព បន្ត ទៀត របស់ កម្ពុជា ។ ជាមួយគ្នា នេះ ដែរ ប្រទេស ជប៉ុន បាន ចូលរួមចំណែក យ៉ាង ធំ ធេង ក្នុង ការស្តារ ប្រទេស កម្ពុជា ឡើងវិញ ក្រោយ សង្គ្រាម និង បាន ចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម កម្ពុជា ។
ប៉ុន្តែ ព្រម ពេល ជាមួយគ្នា ប្រធានាធិបតី រុស្ស៊ី លោក វ្ល៉ាឌីមៀ ពូទីន បាន ចោទ លោក Poroshenko កំពុង ប្រើប្រាស់ សកម្មភាព បង្ក រឿង នៅ សមុទ្រ Azov និង ច្បាប់ អាជ្ញា សឹក ក្នុង ចេតនា បង្កើន ប្រជាប្រិយភាព របស់ ខ្លួន នៅមុខ ការបោះឆ្នោត ក្នុង ប្រទេស អ៊ុយក្រែន នៅ ឆ្នាំ ២០១៩ តែ ប៉ុណ្ណោះ ៕
ឯក អគ្គ រដ្ឋទូត ថ្មី ប្រទេស ឡាវ អបអរសាទរ ដែល រដ្ឋ សភា ផ្តល់ សេចក្តីទុកចិត្ត ជូន សម្តេច ពញា ចក្រី ហេង សំរិន ដឹកនាំ រដ្ឋសភា កម្ពុជា បន្ត ទៀត
សម្តេច ហេង សំរិន បាន កោតសរសើរ និង ពេញចិត្ត ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ស្ថានទូត ឡាវ នៅ កម្ពុជា ដែល បាន ដើរតួ ជា តំណាង បេសកកម្ម ការ ទូត ដ៏ មាន ជោគជ័យ ក្នុង ការពូន ជ្រុំ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី រវាង ប្រជាជាតិ ទាំង ពីរ ។
ក្នុង នាម រដ្ឋសភា សម្តេច បាន គូសបញ្ជាក់ ថា រដ្ឋសភា កម្ពុជា គាំទ្រ ពេញ ទំហឹង ចំពោះ បេសកកម្ម របស់ លោក ឯក អគ្គ រដ្ឋទូត នឹង សន្យា ធ្វើ កិច្ចសហការ ពេញលេញ ដើម្បីឲ្យ បេសកកម្ម ការ ទូត របស់ លោផក នៅ កម្ពុជា ទទួលបាន ជោគជ័យ ហើយ សម្តេច ហេង សំរិន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ពី វឌ្ឍនភាព នៃ ទំនាក់ទំនង មិត្តភាព សាមគ្គីភាព ជា ប្រពៃណី និង កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ រវាង បក្ស រដ្ឋ រដ្ឋាភិបាល ក៏ ដូចជា រដ្ឋសភា កម្ពុជា - ឡាវ ដែល មាន ការរីកចម្រើន ឥត ឈប់ឈរ ។
ចំពោះ កិច្ចសហប្រតិបត្តិការ រវាង សភា ប្រទេស ទាំង ពីរ វិញ សម្តេច ហេង សំរិន បាន លើកឡើង ថា រដ្ឋសភា កម្ពុជា នីតិកាល ទី៦ នឹង បន្ត ពង្រឹង ពង្រីក ទំនាក់ទំនង ការទូត សភា តាមរយៈ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ពហុ ភាគី ជាពិសេស គឺ បន្ត កិច្ចសហប្រតិបត្តិការ ជិតស្និទ្ធ ជាមួយ រដ្ឋសភា ឡាវ និង គាំទ្រ គ្នា ទៅ វិញ ទៅ មក លើ វេទិកា អន្តរសភា នានា ដើម្បី បម្រើ ផលប្រយោជន៍ រួម របស់ ប្រជាជន ប្រទេស ទាំង ពីរ ។
ជាមួយគ្នា នេះ លោក អាំ ផាយ ឃិន ដាវង្ស បាន អបអរ ចំពោះ លទ្ធផល បោះឆ្នោត ជ្រើស តំាង សមាជិក រដ្ឋសភា នីតិកាល ទី៦ និង បាន សាទ រ យ៉ាង ក្រៃលែង ចំពោះ រដ្ឋសភា កម្ពុជា ដែល ផ្តល់ សេចក្តីទុកចិត្ត ជូន សម្តេច ពញា ចក្រី ហេង សំរិន បន្ត ដឹកនាំ រដ្ឋសភា ក្នុង អាណត្តិ ថ្មី ទៀត ។
លោក ឯក អគ្គ រដ្ឋទូត បាន គូសបញ្ជាក់ ថា ក្នុង ការពង្រឹង ពង្រីក ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង បក្ស រដ្ឋ និង ប្រជាជន កម្ពុជា - ឡាវ ឲ្យ កាន់តែ រឹងមាំ ថែម ទៀត នោះ នៅក្នុង ខែធ្នូ ខាងមុខ នេះ ឥស្សរជន ជាន់ ខ្ពស់ កម្ពុជា ដែល មាន សម្តេច ហេង សំរិន និង សម្តេច ហ៊ុន សែន ជាដើម នឹង អញ្ជើញ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស ឡាវ ផ្សេង ៗ គ្នា ។
លោក អាំ ផាយ ឃិន ដាវង្ស បាន ថ្លែង ថា នៅក្នុង ដំណើរទស្សនកិច្ច ផ្លូវការ និង មិត្តភាព របស់ សម្តេច តេជោ ហ៊ុន សែន នៅ ប្រទេស ឡាវ រដ្ឋាភិបាល ប្រទេស ទំាង ពីរ និង ចុះ កិច្ចព្រមព្រៀង យោគយល់ គ្នា លើ វិស័យ អប់រំ វប្បធម៌ និង ថាមពល អគ្គិសនី ។ ជាមួយគ្នា នេះ ប្រទេស ទំាង ពីរ ក៏ នឹង ពិភាក្សា គ្នា លើ បញ្ហា ពាណិជ្ជកម្ម ពិសេស សការលើកលែង ពន្ធ ត្រួត គ្នា និង បញ្ហា បត្យាប័ន អ្នកទោស ផងដែរ ។
លោកស្រី ណាន់ស៊ី ភែឡូស៊ី (Nancy Pelosi) វ័យ ៧៨ ឆ្នាំ ត្រូវបាន ជ្រើសតាំង សម្រាប់ មុខតំណែង ជា « ប្រធាន សភា តំណាងរាស្រ្ត អាមេរិក » ជាមួយ សំឡេង គាំទ្រ ២០៣ សំឡេង និង ប្រឆាំង ៣២ សំឡេង ខណៈ អនុប្បវាទ មាន ០៣ សំឡេង ។ យ៉ាងណាមិញ តំណាងរាស្រ្ត ប្រចាំ រដ្ឋ កាលីហ្វរញ៉ា រូប នេះ ត្រូវការ សំឡេង គាំទ្រ សរុប ចំនួន ២១៨ សំឡេង នៅក្នុង ការបោះឆ្នោត សភា តំណាងរាស្រ្ត មួយ ទៀត ដែល នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃទី ០៣ ខែមករា ឆ្នាំ ក្រោយ ទើប អាច ទទួលបាន តំណែង នេះ ជា ផ្លូវការ ។
គួរ ជម្រាប ថា បក្ស ប្រជាធិបតេយ្យ អាមេរិក ដណ្តើម បាន ការគ្រប់គ្រង នៅក្នុង សភា តំណាងរាស្រ្ត ជា លើក ដំបូង ក្នុង រយៈពេល ០៨ ឆ្នាំ នៅក្នុង ការបោះឆ្នោត សភា ពាក់កណ្តាល អាណត្តិ នៅ អាមេរិក កាលពី ដើម ខែវិច្ឆិកា នេះ ខណៈ បក្ស សាធារណរដ្ឋ នៅតែ បន្ត ពង្រីក ឥទ្ធិពល នៅក្នុង ព្រឹទ្ធសភា ដដែល ហើយ ប្រការ នេះ បាន ធ្វើឲ្យ អំណាច សភា អាមេរិក បែក ជា ពីរ ៕
