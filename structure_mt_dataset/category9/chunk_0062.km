ប៉ុន្តែ ដើម្បី ផ្លាស់ប្តូរ ពិភពលោក អ្នក មិន ធ្វើ បែប នេះ ទេ ។
ដើម្បី ពិនិត្យមើល បងប្អូន ស្រី ទាំង ប្រាំពីរ ។
ដូច្នេះហើយខ្ញុំសូមលើកលែងទោសអ្នក » ។
នៅថ្ងៃ បន្ទាប់ អ្នក រាល់គ្នាក្នុងក្រុង បង្ហាញខ្លួនសម្រាប់ពិធីមង្គលការ ។
ពួកគេមិនខ្វល់នឹងព្រះ ទេ ប៉ុន្តែព្រះ បានយក ចិត្តទុកដាក់ចំពោះពួកគេ ។
« យើងមកពីព្រះ អ្នក ណាដែលស្គាល់ព្រះ ក៏ស្តាប់យើងដែរ អ្នក ណាមិនមកពីព្រះ មិនស្តាប់យើងទេ ដោយហេតុនេះយើងស្គាល់ព្រះវិញ្ញាណនៃសេចក្ដី ពិត និងវិញ្ញាណនៃកំហុស » ។
សូម្បីតែទេវតាកាព្រី យ៉ែលក្នុងការ ប្រយុទ្ធ ជាមួយគាត់ក៏មិនយកគាត់ទៅ តែម្នាក់ឯងដែរ គាត់បាននិយាយថា៖ « ព្រះ យេហូវ៉ាទ្រង់បន្ទោសឯង » ។
