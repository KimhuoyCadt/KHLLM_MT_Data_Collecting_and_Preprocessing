ខ្ញុំមិនគិតថាការ ខ្វះការ ត្រៀមខ្លួនជាហេតុផលនោះទេ ។
នៅតែ មាន ពេល ខ្លះ ដែល អ្នក នឹង រកឃើញ ខ្លួន ឯង
បន្ទាប់មកគេកាត់ព្រលឹងចេញ » ។
ខ្ញុំគិតថាខ្ញុំនឹងត្រូវការ វាដើម្បីរក្សាអ៊ីនធឺណិតនេះបន្ត !
ជា ការពិត ណាស់ នេះ ប្រហែលជា មិន មែន ជា ជម្រើស សមរម្យ សម្រាប់ មនុស្ស គ្រប់ គ្នា នោះ ទេ ។
យើងស្រឡាញ់រ៉ូបនេះសម្រាប់វាជាការ ទាក់ទាញរបស់ស្ត្រី ។
បន្ទប់ ធ្វើការ របស់ នាង នៅក្នុង ផ្ទះ មួយ ហើយ ងាយស្រួល រក ។
យើងនឹង នាំ មកលើពួកគេ និងអ្នកក្រុងយេរូសាឡឹម និងជន ជាតិយូដានូវគ្រោះ មហន្តរាយទាំងប៉ុន្មាន ដែលយើងបានប្រកាសប្រឆាំងនឹងពួកគេ ប៉ុន្តែគេមិនឮឡើយ » ។
«បន្ទាប់មកពួកគេបានបញ្ចេញសំឡេងដំបូង » ។
ឱ ស្នេហ៍អើយ ចូរអត់ ធ្មត់នឹងខ្ញុំ ។
ឈានដល់ និង ផ្លាស់ទី ឆ្ងាយ ពី ភ្ញៀវ ។
សមាជិក WTO ស្ថិត ក្នុង កម្រិត ផ្សេង ៗ គ្នា នៃ ការអភិវឌ្ឍន៍ ហើយ ការយកចិត្តទុកដាក់ ជាពិសេស គួរតែ ត្រូវបាន ផ្តល់ ទៅ ឱ្យ តម្រូវការ របស់
ផ្កាយដែលគេបានឃើញនៅទិសខាងកើតបានដើរពីមុខគេរហូតដល់ឈប់នៅលើកន្លែងដែលក្មេងនោះនៅ ។
ហេតុ អ្វី មនុស្ស ច្រើន ម្លេះ ដាក់ ខ្ញុំ ?
ខ្ញុំពិតជាត្រូវការ ដើម្បីទទួលបានសាច់ប្រាក់ខ្លះ ។
« ទោះជាដំណឹងល្អរបស់យើងត្រូវបានបិទបាំងក៏ដោយ វាត្រូវបានបាំង តែចំពោះអ្នកដែលត្រូវវិនាសប៉ុណ្ណោះ ។
ចូល ឆ្នាំ ចិន គឺជា ពេលវេលា សម្រាប់ សម្លៀកបំពាក់ ថ្មី ។
គាត់មិនប្រាកដថាមានថ្នាំព្យាបាលរោគសម្រាប់មនុស្សពិការ ភ្នែកនោះទេ ។
ខ្ញុំ ស្រលាញ់ ប្រទេស របស់ ខ្ញុំ វា ជា ផ្ទះ របស់ ខ្ញុំ ប៉ុន្តែ ខ្ញុំ មិន មាន មោទនភាព ចំពោះ វា ទេ ។
ពេលឮសូរគ្រហឹមពីក្រោយគេ ។
« គាត់សួរថា តើថ្ងៃ ណានឹងជាថ្ងៃរស់ឡើងវិញ ?
« ប្រសិនបើអ្នកសរសេរវាមិនមានការ ធានាថានរណាម្នាក់នឹង មក។
នាង ធំ ឡើង ក្លាយជា អ្នក ប្រមាញ់ ដ៏ ល្អ បំផុត នៅក្នុង ត្រកូល ។
ដប់ ឆ្នាំ ក្រោយមក គាត់ បាន យក នាង មកវិញ ។
បន្ទាប់ពីពួកគេបានរីក ចម្រើន និងពង្រីកបន្ថែមទៀតនូវ ផលចំណេញរបស់ពួកគេ
ធ្លាក់ទៅលើម្ដាយ ហើយគាត់ទទួល មរតកពីម្ដាយ ។
យ៉ាងណាមិញ ខ្ញុំ ធ្វើ បែប នេះ ព្រោះ ការងារ របស់ ខ្ញុំ គឺ ការពារ គ្រួសារ ខ្ញុំ ពី គ្រោះថ្នាក់ ។
ខ្ញុំ ទន្ទឹងរង់ចាំ ចូលរួម ជាមួយ មិត្ត រួម ក្រុម ថ្មី របស់ ខ្ញុំ នៅ ថ្ងៃ នេះ និង ចាប់ផ្តើម ការរៀបចំ សម្រាប់ រដូវកាល ខាងមុខ » ។
តាមពិត វា ជា រូបកាយ របស់ អ្នក ។
ខ្ញុំភ្លេចថាតើអ៊ីនធឺណិតបានឆក់ប៉ុន្មាន កាលពី ១០ ឆ្នាំមុន ។
គ្មាន អំពើ បាប ណា ធំ ជាង រឿង មួយ ទៀត ទេ - វារញ៉េរញ៉ៃ ជាមួយនឹង ទំនាក់ទំនង របស់ យើង ជាមួយ ព្រះ។
នៅក្នុង ខ្លឹមសារ ពួកគេ មាន នៅលើ ផែនដី ។
ដ្បិតមនុស្សគ្រប់គ្នាបានប្រព្រឹត្តអំពើ បាប ហើយខ្វះព្រះគុណរបស់ព្រះ។
អ្នក បាននិយាយថា ទាំងនេះ ជារូបភាពរបស់ប្រធានាធិបតីកំពុងបំពេញការងាររបស់គាត់សម្រាប់ប្រជាជនអាមេរិក ។
ជាថ្ងៃដែលពួកវាពិបាកក្នុងការ រំលាយ ហើយអាចនឹងធ្វើឱ្យមានការ ហើម ពោះថែមទៀត ។
ប៉ុន្តែ ប្រហែលជា អ្នក មិន ចង់ ធ្វើ ដូច្នេះ ទេ ។
ខ្ញុំមិនអាចទៅទិញទំនិញដោយគ្មានម្តាយរបស់ខ្ញុំទេ ។
សារ ទិវា សេរីភាព សារព័ត៌មាន ពិភពលោក
ដើម មែក ធាង ជា កម្មសិទ្ធិ របស់ ក្រុម ពន្លឺ ។
ដូច នេះ៖ « គុកពិតតែមួយគត់គឺការ ភ័យខ្លាច ហើយសេរីភាពពិតប្រាកដតែមួយគត់គឺសេរីភាព ពីការ ភ័យខ្លាច » ។
ហើយ ទ្វារ ពីរ ចុះក្រោម យើង មិន ដឹង ថា ពួកគេ នៅក្បែរ នោះ ទេ ។
ដោយ គ្មាន ខ្យល់ និង ទឹក ។
បុរសនិងស្ត្រីជាច្រើនមិនដឹង
ដូច្នេះ ស្រមៃថាបានជួបអ្នក រាល់គ្នាក្នុងបន្ទប់មុនពេលយប់ ។
បានដាក់នៅក្នុងគាត់ដោយអ្នក និងអ្នក ហើយប្រទេសដែលគាត់បានបម្រើយ៉ាងថ្លៃថ្នូរ » ។
«បងប្អូនអើយ ខ្ញុំសូមបួងសួងឲ្យបងមានសុខភាពល្អ ហើយសូមឲ្យបានសុខ សប្បាយគ្រប់ ៗគ្នា ទោះបីជាព្រលឹងរបស់បងបានសុខស្រួលក៏ដោយ ។
បងប្អូន អើយ មាន រាប់ រយ ។
នោះគឺថាតើពួកគេជឿលើអ្វីក្រៅពីដំណឹងល្អ ?
សេចក្តីសុចរិត ក្នុង ជាតិ នេះ ។
ការចរចាចំនួន 10 ក្នុងរឿងនោះផងដែរ ។
ហើយខ្ញុំបានសំណូមពរដល់ពួកគេ បើពួកគេចង់ផ្តល់ ប្រយោជន៍ដល់ខ្ញុំតាមមធ្យោបាយ ណាមួយ ឲ្យគិតទុក ជាមុនចំពោះអ្នកដែល នាំខ្ញុំចេញ ហើយកាត់ក្បាលខ្ញុំដោយខ្លួន ឯង ។
ត្រឡប់មក សង្គ្រោះ ខ្ញុំ វិញ !
មានពាក្យថាអាក្រក់
យើង ត្រូវ ធ្វើ គណិតវិទ្យា មូលដ្ឋាន ជាមុន សិន ។
នោះ គឺជា ព្រះរបស់ ពួកគេ ។
" នឹងមានការ ស្លាប់ច្រើនណាស់ " ។
ពេលដែលមិត្ត ភក្តិត្រូវគេចោទថាចាប់រំលោភ
៣ « កុំធ្វើ បាបដី ឬសមុទ្រ ឬដើមឈើឡើយ ទាល់ តែយើងដាក់ ត្រានៅលើថ្ងាសរបស់អ្នក បម្រើនៃព្រះ នៃយើងខ្ញុំ » ។
