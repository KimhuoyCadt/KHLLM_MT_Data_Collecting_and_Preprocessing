ឬ ខ្ញុំ កំពុង ព្យាយាម ផ្គាប់ ចិត្ត ប្រជាជន ?
ពួកគេសួរថា៖ « តើយើងត្រូវធ្វើអ្វីដើម្បីធ្វើ កិច្ចការរបស់ព្រះ?
នៅ ពេល ដែល បុរស ម្នាក់ ចូលរួម ជាមួយ ស្រី ពេស្យា គាត់ មិន មាន បំណង មើល ថែ នាង ឬ ចូលរួម ជាមួយ នាង ក្នុង គ្រួសារ របស់ គាត់ ឡើយ ។
យើងបានឈានមុខគេម្នាក់ក្នុងចំណោមបុរស
ភាពល្បីល្បាញ នៅពេល វា ត្រូវបាន ដាក់ចេញ ជា លើក ដំបូង ។
« អ្វីដែលអ្នក សុំពីខ្ញុំ ខ្ញុំនឹងឲ្យទៅអ្នករហូតដល់ពាក់កណ្តាលនៃ នគររបស់ខ្ញុំ » ។
២៣ ហើយអ្នក ណាដែលមិនធ្វើ បាបខ្ញុំ អ្នកនោះមានសុភមង្គល » ។
« មើលដៃជើងខ្ញុំ ថាខ្ញុំជាខ្លួនឯង សូមពាល់ខ្ញុំមើល ដ្បិតវិញ្ញាណមិនមានសាច់ និងឆ្អឹង ដូចអ្នក ឃើញថាខ្ញុំមានទេ » ។
អ្នក រស់នៅទី ណាក៏ដោយ អ្នកមិនត្រូវបរិភោគឈាមបក្សី ឬសត្វ ណាឡើយ ។
រត់មិនចាំគាត់ប្រាប់ខ្ញុំ » ។
ប្លក់ ប្លុក ឬ គេហទំព័រ គឺជា ប្រភេទ នៃ គេហទំព័រ ឬ ជា ផ្នែក នៃ គេហទំព័រ ។
ទ្រង់មានព្រះ‌បន្ទូលទៅទ្រង់ម្ដងទៀតថា « ចុះបើរកបានសែសិបនាក់នៅ ទីនោះ តើឯងនឹងធ្វើអ្វី ?
ដូចជា ការគោរព ដែល អ្នក កំពុង ស្ថិត នៅ ។
ហើយយកវាទៅកន្លែងដដែលរាល់ដង ទើបគេស្គាល់ក្លិនខ្លួន ឯង ។
គាត់បានយកវាមកថ្វាយជាមធ្យម ហើយព្យាបាលតាមការ ចង់បាន ។
« បើអ្នក ស្រឡាញ់អ្នកដែលស្រឡាញ់អ្នក តើអ្នកនឹងបានសំណងអ្វី ?
2. រួចទូលព្រះអង្គ ថា៖ « សូមប្រាប់យើងខ្ញុំថា អ្នក ធ្វើការ ទាំងនេះដោយអំណាចអ្វី ?
អ្នក ណាដែលជឿលើខ្ញុំ ដូចមានចែងទុកក្នុងគម្ពីរ នោះនឹងមានទឹកដែលមានជីវិតហូរ មកពីជ្រៅក្នុងខ្លួន » ។
ទោះជា យ៉ាងណា ក៏ដោយ នៅ ពេល ដែល ខ្ញុំ បាន សិក្សា ព្រះបន្ទូល របស់ ព្រះលើ ប្រធានបទ នេះ ហើយ ខ្ញុំ និង ភរិយា របស់ ខ្ញុំ បាន ឮ សេចក្ដីអធិប្បាយ ពីរ បី អំពី ប្រធានបទ នេះ - យើង ដឹង ថា ព្រះកំពុង ដោះស្រាយ ជាមួយ ដួងចិត្ត របស់ យើង ។
ខ្ញុំចង់បានត្រសក់បែបនេះ !
គាត់មិនបានសរសេរអក្សរទេ ( មិន មែនថាគាត់ធ្លាប់សរសេរវាទេ ) ហើយពេលគាត់និយាយថា គាត់សោកស្តាយពេលបានឮវាស្តាប់ទៅពិតប្រាកដ ។
ប្រាប់ គាត់ ថា ខ្ញុំ នឹង សង គាត់ ពីរ រយ ភាគរយ ។ ចំណាប់អារម្មណ៍ ។
ទីបំផុត អ្វី ដែល នឹង ត្រូវ ចងចាំ គឺ
បន្ទាប់មកត្រូវបានគេយកមកវិញ ហើយផ្នូរក៏ពេញ ។
មុនពេល ចូល ប្រទេស ចិន៖
គាត់មិនមានការសង្ស័យចំពោះលទ្ធផលដូចដែលគាត់បានប្រាប់ A
អាន មើល និង ស្តាប់ ។
ម្នាល អាវុសោ ទាំងឡាយ ព្រោះ មិន មាន បាបកម្ម ។
សម្រាប់ ម៉ោង បន្ទាប់ យើង ផ្លាស់ទី តាម របៀប នេះ ។
១៦ ដូច្នេះ វាមិនអាស្រ័យលើបំណងប្រាថ្នាឬការ ខិតខំរបស់មនុស្សទេ ប៉ុន្តែអាស្រ័យលើសេចក្ដី មេត្តា ករុណារបស់ព្រះ។
ក្នុងនាមជារូបកាយនៃអ្នក ជឿ យើងត្រូវបានចាត់ឲ្យទៅ ផ្សាយដំណឹងល្អ និងបង្កើតសិស្ស ។
តើរដ្ឋាភិបាលបារាំង សហការក្នុងការ ស្វែង រកមនុស្សទាំងនោះដែរឬទេ ?
យ៉ាកុបបានឮពាក្យរបស់កូនចៅ ឡា បាន់និយាយថា៖ « យ៉ាកុបបានដកយករបស់ទាំងអស់ដែលជាឪពុកយើង ហើយពីអ្វីដែលជាឪពុកយើង គាត់ក៏បានទ្រព្យ សម្បត្តិទាំងនេះដែរ » ។
បន្ទាប់ពី សារ ត្រូវបាន ផ្ញើ
លោកបានប្តេជ្ញាថា៖ « គ្មាននរណាអាចបែងចែកយើងបានឡើយ » ។
ការ ធ្វើរោគវិនិច្ឆ័យនោះបានបង្ហាញថាជា ចម្លើយដែលក្រុមគ្រួសារកំពុងស្វែង រក ។
សញ្ញា ទាំង ១០ ដែល បង្ហាញ ថា គាត់ មិន ស្រលាញ់ អ្នក ទៀត ទេ
កុំ ឈប់ ជាមួយ អាហារ
ពាក្យនឹង ថយក្រោយ ប៉ុន្តែនៅពេលអ្នកដាក់ពាក្យនោះនឹងត្រូវប្រឈមមុខនឹងផ្លូវត្រូវ ។
យើង ត្រូវបាន វាយប្រហារ ដោយ ភាព មិន ស៊ីសង្វាក់ គ្នា ដែល កើតឡើង នៅពេល យើង ព្យាយាម
អ្នក អាច ធ្វើ វា ឥឡូវនេះ ហើយ ត្រៀមខ្លួន ។
ដូច្នេះតើអ្នកដឹងថាអ្នកមានជំងឺនេះដោយរបៀបណា ?
អ្នក អាច និយាយ ជាមួយ ស្ត្រី ជាច្រើន ។
ចាំបាច់ ត្រូវតែ រក្សា វា ឱ្យ នៅ ទំនេរ
ហើយហ្វូងមនុស្សទាំងមូលបានត្រេក អរចំពោះគ្រប់ការ ដែលទ្រង់កំពុងធ្វើ ។
សហភាព អឺរ៉ុប បាន ចាប់ផ្តើម នៅក្នុង ខែកុម្ភៈ នូវ ដំណើរការ រយៈពេល 18 ខែ ដែល អាច នាំទៅ ដល់ ការផ្អាក បណ្តោះអាសន្ន ...
ឯងនៅឆ្ងាយប៉ុន្មានថ្ងៃហ្នឹងឬអី ?
ខ្ញុំមិនស្តាប់នាងទេ នាងជាគោកុហក !
ដូច្នេះខ្ញុំថា អ្នក ដឹងប្រាប់ខ្ញុំបន្ថែមទៀត ។
" គាត់បាននិយាយថា : ' តើអ្នកបានឃើញនៅពេលដែលយើងបានជ្រកកោននៅលើថ្ម ?
វា ធ្វើឱ្យ អ្នក ដែល ធ្វើ វា មិន ប្រសើរ ជាង អ្នក ដែល ពួកគេ ចង់ បដិសេធ ។
អ្នក មិន មានអារម្មណ៍ បុរស នេះ ទេ ។
« ហើយពេលចែកទាំងប្រាំពីរនាក់ក្នុងចំណោមបួនពាន់នាក់ តើអ្នករើសបានបំណែកប៉ុន្មាន កន្ត្រក ? » ។
ហើយ មនុស្ស ម្នាក់ អាច មើលឃើញ មោទនភាព ក្នុង ភាព ជា ម្ចាស់ ។
យើងបានទទួលបុណ្យជ្រមុជទឹកនៅខែ វិច្ឆិកា ហើយបានក្លាយជាសមាជិកក្រុមជំនុំ ។
តើ អ្នកណា បាន បន្សល់ទុក សញ្ញា របស់ គាត់ នៅ ឆ្នាំ ២០០១ ច្រើន ជាង អ្នក ផ្សេង ទៀត ?
ដូច្នេះ ខ្ញុំអាចផ្សាយនៅ ទីនោះបានដែរ ព្រោះខ្ញុំ មកនេះហើយ » ។
គាត់ បាន បន្ត កម្លាំង ពេញ ។
លោកបាននិយាយថា៖ « ការ ស្លាប់បានក្លាយជាអាថ៌កំបាំងនៃឃាតកម្មដោយសារខ្វះភស្តុតាង ។
ហេរ៉ូអ៊ីន និង ការបង្ក្រាប គឺ មិន ល្អ សម្រាប់ អ្នកទេ ។
ហើយទ្រង់បានធ្វើឲ្យអ្នក រាល់គ្នាទទួល យកដី និងផ្ទះ សម្បែងរបស់ពួកគេ និងប្រាក់របស់ពួកគេ និងជាដីដែលអ្នកមិនធ្លាប់បានដើរទៅ
សំណួរ៖ តើ ប្រអប់ ទាំងនេះ មាន សមត្ថភាព គ្រប់គ្រាន់ ដើម្បី ទទួលបាន ការចាប់អារម្មណ៍ ពី អតិថិជន ដែរ ឬ ទេ ?
ពួកគេជាច្រើននាក់បានមកពីទីក្រុងផ្សេង ៗ ហើយបានស្នាក់ នៅក្នុងវិហារឥស្លាម ។
នេះ អាច ផ្តល់ឱ្យ កូនស្រី របស់ អ្នក នូវ ឱកាស ដើម្បី និយាយ ។
កុំ ព្យាយាម ចាប់អារម្មណ៍ គាត់ !
តោះ ស្តាប់ ដើម ដំបូង តាម យូធូប ។
នាងមានកូនស្រីម្នាក់ជាមួយប្តីថ្មី។
សម្រេចចិត្ត ថា តើ ត្រូវ រក្សាទុក ឬ កម្ចាត់ ពួកគេ ។
