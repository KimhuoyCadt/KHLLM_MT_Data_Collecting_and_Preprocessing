អាប់ សា ឡំមនិងយូដាសទាំងពីរនាក់បានស្លាប់យ៉ាងអាម៉ាស់មុខ ពីព្រោះពួកគេបានក្បត់អ្នកដែលព្រះយេ ហូវ៉ាបានរើសតាំង ។ ( ២សាំ .
១១៩ :១៥៨ ) គឺពិតជាសំខាន់ណាស់ដែលយើងលះចោលទំនោរចិត្ដទៅរកមហិច្ឆតាដ៏ងងឹតង ងុល ឬក៏ការលោភលន់ដែលនាំឲ្យបាត់បង់ការពេញចិត្ដពីព្រះយេ ហូវ៉ា !
មេរៀនទាំងនេះពិតជាមានឥទ្ធិពលខ្លាំងណាស់មកលើយើងក្នុងការជួយយើងឲ្យបដិសេធការក្បត់ដែលជាលក្ខណៈដ៏គួរឲ្យស្អប់ខ្ពើម មែនទេ ?
ចូរយកត ម្រាប់តាមពួកអ្នកដែលបានបង្ហាញភក្ដី ភាព
១៨ : ១-៤ ) យ៉ូណា ថា នបានខំអស់ ពីសមត្ថភាពដើម្បី‹ ជួយចំរើនឲ្យដាវីឌ ›ឬលើកទឹកចិត្ដគាត់ ។ យ៉ូណា ថា នថែមទាំងប្រថុយជីវិតរបស់គាត់ដោយនិយាយការពារដាវីឌនៅចំពោះមុខស្ដេចសូល ។ យ៉ូណា ថា នបានប្រាប់ដាវីឌដោយស្មោះថា៖«អ្នកនឹងបានធ្វើជាស្ដេចលើសាសន៍អ៊ីស្រាអែល ហើយខ្ញុំនឹងបានជាបន្ទាប់របស់អ្នក» ។ ( ១សាំ .
២០: ៣០-៣៤; ២៣:១៦, ១៧ ) ក្រោយយ៉ូណា ថា នស្លាប់ នោះមិនមែនចម្លែកឡើយ ដែលដាវីឌបានបង្ហាញទុក្ខសោកនិងសេចក្ដីស្រឡាញ់របស់គាត់ក្នុងចម្រៀងដ៏សោក សៅមួយ ។ — ២សាំ .
យ៉ូណា ថា នបានដឹងថាគាត់ត្រូវមានភក្ដីភាពចំពោះអ្នកណា ។ គាត់បានចុះចូលទាំងស្រុងចំពោះសិទ្ធិគ្រប់គ្រងរបស់ព្រះយេ ហូវ៉ា ហើយគាត់បានគាំទ្រយ៉ាងពេញទំហឹងចំពោះដាវីឌជាអ្នកដែលព្រះបានតែងតាំង ។ ស្រដៀងគ្នាដែរនៅសព្វថ្ងៃនេះ ទោះជាយើងប្រហែលជាមិនមានឯក សិទ្ធិពិសេសណាមួយក្នុងក្រុមជំនុំ ក្ដី យើងគួរស្ម័គ្រចិត្ដគាំទ្របងប្អូនដែលបានត្រូវតែងតាំងដើម្បីដឹកនាំក្នុងចំណោមយើង ។ — ១ថែ .
គំរូល្អឯទៀតដែលយើងនឹងពិចារណាគឺគំរូរបស់សាវ័កពេត្រុស ជាអ្នកដែលបានប្រកាសថាគាត់នឹងមានភក្ដីភាពចំពោះលោកយេស៊ូ ។ ពេលដែលគ្រិស្ដបានប្រើឧទាហរណ៍អំពីសារៈសំខាន់នៃការបង្ហាញជំនឿទៅលើរូបកាយនិងឈាមរបស់លោក ដែលទុកជាគ្រឿងបូជានៅពេលឆាប់ៗខាងមុខ នោះពួកអ្នកកាន់តាមលោកយេស៊ូជាច្រើននាក់បានទាស់ចិត្ដនឹងសម្ដីរបស់លោកយេស៊ូ ហើយបានឈប់តាមលោកទៀត ។ ( យ៉ូន .
៦: ៥៣-៦០, ៦៦ ) ដូច្នេះ លោកយេស៊ូបានបែរទៅសួរសាវ័ក១២នាក់របស់លោកថា៖«តើអ្នករាល់គ្នាចង់ទៅដែរឬ ?»
ប្រសាសន៍របស់លោកនាំឲ្យបានជីវិតដែលគ្មានទីបញ្ចប់ ហើយយើងបានជឿ ក៏បានដឹងថា លោកជាអ្នកបរិសុទ្ធរបស់ព្រះ» ។ ( យ៉ូន .
ទំនងជាមិនមែនទេ ។ ទោះជាយ៉ាងនោះក៏ដោយ ពេត្រុសបានតាំងចិត្ដនៅស្មោះត្រង់ចំពោះបុត្ររបស់ព្រះដែលលោកបានរើសតាំង ។
ពេត្រុសមិនបានគិតថា លោកយេស៊ូមានគំនិតមិនត្រឹមត្រូវ ហើយថាក្រោយមកលោកនឹងដឹងរួចប្រែក្រឡាស់ពាក្យដែលលោកបាននិយាយនោះទេ ។ ពេត្រុសបានទទួលស្គាល់ដោយចិត្ដរាបទាបថា«ប្រសាសន៍របស់លោកនាំឲ្យបានជីវិតដែលគ្មានទីបញ្ចប់» ។ ស្រដៀងគ្នាដែរនៅសព្វថ្ងៃនេះ តើយើងនឹងមានប្រតិកម្មយ៉ាងណា ប្រសិនបើយើងឃើញចំណុចណាមួយក្នុងសៀវភៅដែល«អ្នកបម្រើដ៏ស្មោះត្រង់»បានរៀបចំដែលយើងពិបាកយល់ ឬមិនស្របនឹងគំនិតរបស់យើង ?
យើងគួរខំប្រឹងយល់នូវចំណុចនោះ ជាជាងគ្រាន់តែសង្ឃឹមថានឹងមានការផ្លាស់ប្ដូរដែលស្របតាមទស្សនៈរបស់យើង ។ — សូមអាន លូកា ១២: ៤២
ចូររក្សាភក្ដីភាពចំពោះគូអាពាហ៍ ពិពាហ៍របស់អ្នក
ក្នុងចំណោមអំពើក្បត់ ការផិតក្បត់គ្នាគឺជាទង្វើមួយដែលធ្វើឲ្យមនុស្សឈឺចាប់បំផុត ។ អ្នកផិតក្បត់លែងស្មោះត្រង់នឹងគូអាពាហ៍ ពិពាហ៍របស់ខ្លួន ហើយបែរជាយកចិត្ដទុកដាក់នឹងបុគ្គលម្នាក់ទៀត ។ អ្នកដែលពីមុនធ្លាប់មានគូ ស្រាប់តែនៅម្នាក់ឯងវិញ ។ ជីវិតរបស់គាត់បានផ្លាស់ប្ដូរទាំងស្រុងដូចជាក្រឡាប់ ចាក់ ។ តើនេះបានកើតឡើងយ៉ាងដូចម្ដេចដល់មនុស្សពីរនាក់ដែលធ្លាប់ស្រឡាញ់គ្នា ?
តើព្រះយេ ហូវ៉ាមានអារម្មណ៍យ៉ាងណាចំពោះពួកអ្នកដែលចុះចោលគូរបស់ខ្លួនដោយគ្មានមូលហេតុពីគម្ពីរ ?
ចំពោះពួកអ្នកដែលរៀបការហើយ តើតាមរបៀបណាដែលពួកគេអាចរក្សាភក្ដីភាពចំពោះគូរបស់ខ្លួន ?
បណ្ដាំរបស់ព្រះចែងថា៖«ចូរឲ្យឯងបានរីករាយចំពោះប្រពន្ធ ដែលបានគ្នាពីកាលក្រមុំកំឡោះចុះ»ហើយ«ចូររស់នៅដោយអំណរ ជាមួយនឹងប្រពន្ធ ជាទីស្រឡាញ់របស់ឯង» ។ ( សុភ.
មានសមាជិកខ្លះដែលបានប្រព្រឹត្ដអំពើខុសឆ្គងធ្ងន់ធ្ងរ ហើយត្រូវបានកែតម្រង់«យ៉ាងម៉ឹងម៉ាត់ ដើម្បីពួកគេអាចមានជំនឿមាំមួន» ។ ( ទីត .
១២: ១១ ) ចុះយ៉ាងណាវិញ បើយើងមានសាច់ញាតិ ឬមិត្ដជិតស្និទ្ធណាម្នាក់បានត្រូវបណ្ដាច់មិត្ដ ភាព ?
នេះជាការល្បងលភក្ដីភាពរបស់យើង ថាយើងនឹងស្មោះត្រង់ចំពោះព្រះយេ ហូវ៉ាឬចំពោះបុគ្គលនោះ ។ ព្រះយេ ហូវ៉ាកំពុងសង្កេតមើលថា យើងនឹងធ្វើតាមបង្គាប់របស់លោកដែលមិនឲ្យទាក់ទងជាមួយនឹងអ្នកដែលបានត្រូវបណ្ដាច់មិត្ដ ភាពឬមិនធ្វើតាម ។ — សូមអាន កូរិន ថូស ទី១ ៥: ១១-១៣
២: ១០ ) សូមឲ្យយើងទាំងអស់គ្នារក្សាភក្ដីភាពឲ្យនៅរឹងមាំចំពោះព្រះនិងចំពោះគ្នាទៅវិញទៅមក ។
តាមការពិតកម្លាំងរបស់សាំ សុនមកពីចំណងមិត្ដ ភាពពិសេសជាមួយព្រះយេ ហូវ៉ាក្នុងនាមជាន៉ា សារី តម្នាក់ មិនមែនមកពីសក់របស់គាត់ទេ ។
ពេត្រុសបានស្មោះភក្ដីចំពោះបុត្ររបស់ព្រះដែលលោកបានរើសតាំងទោះជាអ្នកឯទៀតបានបដិសេធលោកក៏ដោយ
សូមរកចម្លើយចំពោះសំណួរទាំងនេះ :
តើពាក្យថាចិត្ដសំដៅទៅលើអ្វី ?
តើមានវិធីអ្វីដែលយើងអាចប្រើដើម្បីពិនិត្យមើលចិត្ដរបស់យើង ?
តើតាមរបៀបណាយើងអាចបន្ដបម្រើព្រះយេ ហូវ៉ាយ៉ាងស្មោះអស់ ពីចិត្ដ ?
ជាងថ្មដែកភ្លើងទៅទៀត»ហើយលោកយេស៊ូបានប្រាប់ថា៖«ប្រសិនបើភ្នែកម្ខាងរបស់អ្នក បណ្ដាលឲ្យអ្នកជំពប់ដួល ចូរខ្វេះវាចេញ ហើយបោះចោលឲ្យឆ្ងាយទៅ» ។ — យ៉ូប ១៦: ១៧; សុភ.
២: ១ ) គឺសំខាន់ណាស់ដែលយើងខំយល់ថា«ចិត្ដ»ជានិ មិត្ដ រូបអ្វី ដោយសារគម្ពីរបានប្រាប់យើងឲ្យការពារចិត្ដរបស់យើង ។ — សូមអាន សុភាសិត ៤: ២៣
ជាឧទាហរណ៍ សូមគិតអំពីរូបផ្គុំដែលធ្វើអំពីបំណែកក្រដាសជាច្រើន ។ ដោយថយមកមើលរូបផ្គុំទាំងមូល គេឃើញថាបំណែកក្រដាសដែលបានផ្គុំត្រូវគ្នាទាំងអស់នោះ ចេញជារូបភាពមួយ ។ ស្រដៀងគ្នាដែរ យើងត្រូវមើលកន្លែងជាច្រើនក្នុងគម្ពីរដែលប្រើពាក្យ«ចិត្ដ»ដើម្បីឲ្យយើងអាចយល់ថាពាក្យនេះមានន័យយ៉ាងណា ។ ដូច្នេះ តើពាក្យថាចិត្ដមានន័យយ៉ាងណា ?
៦: ៦ ) ប៉ុន្ដែ ពេលមានតែពាក្យ«ចិត្ដ»ប៉ុណ្ណោះវិញ ពាក្យនេះសំដៅទៅលើលក្ខណៈទាំងអស់ក្នុងខ្លួនមនុស្ស ។
ហេតុអ្វីយើងចង់ខំយ៉ាងខ្លាំងដើម្បីបម្រើព្រះដោយអស់ ពីចិត្ដ ?
ស្ដីអំពីចិត្ដ ស្ដេចដាវីឌបានរំលឹកសាឡូម៉ូនថា៖«កូនអញអើយ ចូរឲ្យឯងបានស្គាល់ព្រះនៃឪពុកឯងចុះ ព្រមទាំងប្រតិ បត្ដិតាមទ្រង់ ដោយអស់ ពីចិត្ដ ហើយស្ម័គ្រស្មោះផង ដ្បិតព្រះយេ ហូវ៉ាទ្រង់ស្ទង់អស់ទាំងចិត្ដ ក៏យល់អស់ទាំងសេចក្ដីដែលយើងគិតដែរ» ។ ( ១រប.
២៨ :៩ ) ពិតមែន ព្រះយេ ហូវ៉ាជាអ្នកពិនិត្យមើលចិត្ដទាំងអស់រួមទាំងចិត្ដរបស់យើងផងដែរ ។ ( សុភ.
តើយើងគួរទទួលស្គាល់អ្វីស្ដីអំពីការតាំងចិត្ដបម្រើព្រះ?
២: ២ ) ហេតុនេះ ដើម្បីឲ្យប្រាកដថាយើងមិនឈប់បម្រើព្រះដោយអស់ ពីចិត្ដ នោះយើងត្រូវពិនិត្យមើលចិត្ដរបស់យើងជាទៀងទាត់ ។ តើយើងអាចធ្វើដូច្នេះតាមរបៀបណា ?
តើអ្វីបង្ហាញការពិតអំពីអ្វីដែលមានក្នុងចិត្ដរបស់យើង ?
វិធីជាក់ស្ដែងមួយដើម្បីពិនិត្យមើលចិត្ដរបស់យើង
តើប្រសាសន៍របស់លោកយេស៊ូនៅម៉ាថា យ ៦: ៣៣និងអ្វីដែលមាននៅក្នុងចិត្ដយើងជាប់ទាក់ទងគ្នាយ៉ាងណា ?
ក្នុងសុន្ទរកថាដដែលនេះ លោកយេស៊ូបានប្រាប់ពួកអ្នកស្តាប់អំពីអ្វីដែលពួកគេអាចធ្វើដើម្បីបង្ហាញថាពួកគេចង់បម្រើព្រះដោយអស់ពីចិត្ដ ។ លោកយេស៊ូបានមានប្រសាសន៍ថា៖«ចូរបន្ដស្វែងរករាជាណាចក្រនិងសេចក្ដីសុចរិតរបស់ព្រះជាមុន ហើយលោកនឹងផ្ដល់របស់ទាំងនេះឲ្យអ្នក» ។ ( ម៉ា ថ.
៩:៥១, ៥៧-៦១ ) យើងអាចឃើញច្បាស់នូវភាពខុសគ្នាស្រឡះរវាងការតាំងចិត្ដយ៉ាងម៉ឺងម៉ាត់របស់លោកយេស៊ូក្នុងការធ្វើតាមបំណងប្រាថ្នារបស់ព្រះ និងចិត្ដស្ទាក់ស្ទើររបស់បុរសទាំងនោះ ។ ដោយចាត់ទុករឿងផ្ទាល់ខ្លួនថាសំខាន់ជាងកិច្ចបម្រើព្រះ នោះពួកគេបានបង្ហាញថា ពួកគេមិនចង់បម្រើព្រះដោយស្មោះអស់ ពីចិត្ដទេ ។
យើងមិនដូចបុរសទាំងនោះទេ ។ យើងបានទទួលការអញ្ជើញរបស់លោកយេស៊ូឲ្យធ្វើជាអ្នកកាន់តាមលោក ហើយឥឡូវយើងកំពុងបម្រើព្រះយេ ហូវ៉ាជារៀងរាល់ថ្ងៃ ។ ដោយធ្វើបែបនេះ យើងបង្ហាញថាយើងមានអារម្មណ៍យ៉ាងណាចំពោះព្រះយេ ហូវ៉ា ។ ក៏ប៉ុន្ដែ ទោះជាយើងកំពុងមានសកម្មភាពក្នុងក្រុមជំនុំក៏ដោយ យើងក៏នៅតែត្រូវដឹងច្បាស់នូវគ្រោះថ្នាក់ដែលអាចកើតឡើងដល់ចិត្ដរបស់យើង ។ តើគ្រោះថ្នាក់នោះជាអ្វី ?
ពេលលោកយេស៊ូសន្ទនាជាមួយបុរសទាំងនោះដែលលោកបានអញ្ជើញឲ្យក្លាយជាអ្នកកាន់តាមលោក លោកយេស៊ូបានបញ្ជាក់អំពីគ្រោះថ្នាក់នេះ ដោយមានប្រសាសន៍ថា៖«អ្នកណាដែលចាប់កាន់ន ង្គ័ល តែបែរទៅមើលអ្វីនៅខាងក្រោយ អ្នកនោះមិនសមនឹងរាជាណាចក្ររបស់ព្រះឡើយ» ។ ( លូក .
