តើរេ បិកាបានទុកគំរូអ្វីសម្រាប់យើង ?
២៤ : ៥៨ ) រេ បិកាបានពោលពាក្យដូចខាងលើនេះ ពេលនាងឆ្លើយតបទៅម្ដាយនិងបងប្រុសរបស់នាងថានាងយល់ព្រមចាកចេញពីផ្ទះនៅថ្ងៃនោះឯង ហើយធ្វើដំណើរជាមួយមនុស្សដែលពុំធ្លាប់ស្គាល់អស់ជាង៨០០គីឡូម៉ែត្រ ( ៥០០ម៉ៃ ល៍ ) ដើម្បីក្លាយជាប្រពន្ធអ៊ី សាកដែលជាកូនប្រុសរបស់អា ប្រាហាំ ។ ( លោ.
២៤: ៥០-៥៨ ) រេ បិកាបាននិយាយថាមែនគឺមែន ហើយនាងបង្ហាញថានាងជាប្រពន្ធដែលកោតខ្លាចព្រះ និងជាប្រពន្ធដែលស្មោះត្រង់របស់អ៊ី សាក ។ រេ បិការស់នៅអស់មួយជីវិតរបស់នាងក្នុងត្រសាល ជាជនបរទេសក្នុងស្រុកដែលព្រះបានសន្យា ។ ដោយសារនាងមានចិត្ដស្មោះត្រង់ នាងបានទទួលរង្វាន់ដោយក្លាយជាជីដូននៃលោកយេស៊ូគ្រិស្ដជាពូជដែលបានត្រូវសន្យា ។ — ហេ.
ហេតុអ្វីអេសាយជាគំរូល្អសម្រាប់យើង ?
៦: ៨) មុនពោលពាក្យនេះ ក្នុងការបើកបង្ហាញដ៏អស្ចារ្យមួយក្នុងគំនិត អេសាយបានឃើញព្រះយេ ហូវ៉ាអង្គុយលើបល្ល័ង្កខាងលើវិហាររបស់អ៊ីស្រាអែល ។ កាលដែលគាត់កំពុងសម្លឹងមើលអ្វីដ៏អស្ចារ្យនោះ អេសាយបានឮព្រះយេ ហូវ៉ាមានប្រសាសន៍ថា ៖ « តើអញនឹងចាត់អ្នកណាឲ្យទៅ តើអ្នកណានឹងទៅឲ្យអញ ? »
ហេតុអ្វីព្រះយេ ហូវ៉ាឲ្យគេកត់ទុកគំរូខាងលើនេះក្នុងបណ្ដាំរបស់លោកសម្រាប់យើង ?
ហើយតើការរក្សាសម្ដីថាមែនគឺមែនគឺសំខាន់យ៉ាងណា ?
តើអ្វីនឹងជួយយើងឲ្យធ្វើតាមពាក្យសម្ដីរបស់យើង ?
តើពាក្យថាមែនដែលសំខាន់បំផុតសម្រាប់អ្នកកាន់តាមលោកយេស៊ូគឺជាអ្វី ?
។ ក្រោយមក ពេលដែលបុគ្គលនោះជឿនទៅមុខក្នុងការគោរពប្រណិប័តន៍ព្រះ ហើយមានបំណងចង់បានការអនុញ្ញាតឲ្យទទួលការជ្រមុជទឹក អ្នកចាស់ទុំនឹងជួបគាត់ ហើយសួរថា ៖ « តើអ្នកបានប្រគល់ខ្លួនអ្នកជូនព្រះយេ ហូវ៉ាក្នុងសេចក្ដីអធិដ្ឋានហើយឬនៅ ? »
។ នៅទីបំផុត នៅថ្ងៃទទួលការជ្រមុជទឹក អ្នកដែលត្រូវទទួលការជ្រមុជទឹកម្នា ក់ ៗ នឹងត្រូវសួរថា ៖ « ដោយមានមូលដ្ឋានលើការបូជា ជីវិតនៃលោកយេស៊ូគ្រិស្ដ តើអ្នកបានប្រែចិត្ដពីអំពើខុសឆ្គងរបស់អ្នក ហើយបានប្រគល់ខ្លួនអ្នកចំពោះព្រះយេ ហូវ៉ា ដើម្បីធ្វើតាមបំណងប្រាថ្នារបស់លោកឬទេ ? »
។ ដូច្នេះ នៅមុខសាក្សីទាំងឡាយ អ្នកថ្មីទាំងនេះនិយាយថាបាទឬចាសដើម្បីសន្យាថាពួកគេនឹងបម្រើព្រះយេ ហូវ៉ាជារៀងរហូត ។
ដើម្បីពិចារណាអំពីខ្លួនយើងជាទៀងទាត់ តើយើងគួរសួរសំណួរអ្វីខ្លះ ?
តើខ្ញុំបន្ដធ្វើតាមបង្គាប់លោកយេស៊ូ ដោយចាត់ទុកកិច្ចការផ្សព្វផ្សាយនិងការបង្រៀនមនុស្សឲ្យក្លាយជាអ្នកកាន់តាមលោក ជាអ្វីដែលសំខាន់បំផុតក្នុងជីវិតរបស់ខ្ញុំឬទេ ? ›
តើនៅក្នុងរឿងណា ខ្លះនៃជីវិតរបស់អ្នកដែលការថាមែនគឺមែនគឺជារឿងសំខាន់ ?
ការធ្វើតាមសម្បថនៃការប្រគល់ខ្លួនជូនព្រះ មានន័យថាយើងក៏ត្រូវស្មោះត្រង់ក្នុងរឿងសំខាន់ឯទៀតដែរ ។ ជាឧទាហរណ៍ តើអ្នកបានរៀបការហើយឬនៅ ?
បើដូច្នេះមែន សូមធ្វើតាមពាក្យសន្យារបស់អ្នក ។ តើអ្នកបានយល់ព្រមទៅពិសាបាយជាមួយអ្នកណាម្នាក់ដែលមិនសូវមានធនធានឬទេ ?
ដូច្នេះ សូមកុំលុបចោលពាក្យសន្យានោះដោយសារមានម្នាក់ទៀតបានអញ្ជើញអ្នកដែលតាមមើលទៅគឺល្អជាងការអញ្ជើញមុន ។ តើអ្នកបានសន្យាជាមួយអ្នកដែលអ្នកបានជួបពេលផ្សព្វផ្សាយថា អ្នកនឹងទៅជួបគាត់ម្ដងទៀតដើម្បីជួយគាត់ឲ្យកាន់តែមានចំណេះថែមទៀតអំពីព្រះឬទេ ?
បើដូច្នេះមែន ចូររក្សាសម្ដីរបស់អ្នកបើថាមែនគឺមែន ហើយព្រះយេ ហូវ៉ានឹងឲ្យពរដល់កិច្ចបម្រើផ្សាយរបស់អ្នក ។ — សូមអាន លូកា ១៦: ១០
ប្រសិនបើយើងមិនបានធ្វើតាមពាក្យសម្ដីរបស់យើង តើយើងគួរធ្វើអ្វី ?
គម្ពីរចែងថាដោយសារយើងជាមនុស្សមិនល្អឥតខ្ចោះ « យើងទាំងអស់គ្នាជំពប់ដួលជាញឹកញយ » ជាពិសេសតាមរយៈពាក្យសម្ដីរបស់យើង ។ តើយើងគួរធ្វើយ៉ាងណា ពេលយើងដឹងថាយើងមិនបានធ្វើតាមពាក្យសម្ដីរបស់យើង ?
នៅក្នុងច្បាប់របស់ព្រះសម្រាប់ជនជាតិអ៊ីស្រាអែល មានការរៀបចំដែលបង្ហាញសេចក្ដីមេ ត្ដាក រុណាចំពោះមនុស្សណាដែលមានទោសដោយសារ បាន « ស្បថដោយឥតបើគិត » ។ ( លេ វី.
តើអស់អ្នកដែលខំប្រឹងរក្សាពាក្យសម្ដីរបស់ខ្លួនបើថាមែនគឺមែន នឹងមានអនាគតដ៏អស្ចារ្យអ្វី ?
អ្នកគោរពប្រណិប័តន៍ព្រះយេ ហូវ៉ាទាំងអស់ដែលខំប្រឹងរក្សាពាក្យសម្ដីរបស់ខ្លួនបើថាមែនគឺមែន នឹងមានអនាគតដ៏អស្ចារ្យមែន !
តាំងពីលោកយេស៊ូទទួលការជ្រមុជទឹករហូតដល់ពេលលោកស្លាប់ លោកយេស៊ូធ្វើតាមអ្វីដែលលោកបានសន្យាចំពោះបិតាលោក
តើតាមរបៀបណាយើងអាចជៀសវាងមិនឲ្យទុក្ខលំបាកធ្វើឲ្យយើងធ្លាក់ទឹកចិត្ដ ?
តើមានមូលហេតុអ្វីខ្លះដែលយើងមានចិត្ដក្លាហាន ?
អ្នកបម្រើរបស់ព្រះបានស៊ូទ្រាំនឹងស្ថានភាពដ៏ពិបាកទាំងនេះដោយជោគជ័យ ។ ទោះជាយ៉ាងនេះក្ដី យើងចង់ត្រៀមលក្ខណៈដើម្បីប្រឈមមុខនឹងការពិបាកណាក៏ដោយដែលយើងអាចជួបប្រទះនៅអនាគត កាលដែលរបៀបរបបពិភពលោកនេះកាន់តែជិតដល់ទីបញ្ចប់ ។ តើយើងអាចស៊ូទ្រាំ ហើយមិនធ្លាក់ទឹកចិត្ដយ៉ាងដូចម្ដេច ?
តើអ្វីអាចជួយយើងឲ្យប្រឈមមុខនឹងទុក្ខលំបាកសព្វថ្ងៃនេះដោយចិត្ដក្លាហាន ?
ចូររៀនពីគំរូនៃពួកអ្នកដែលបានប្រឈមមុខនឹងបញ្ហាក្នុងជីវិតដោយចិត្ដក្លាហាន
ដូចរ៉ូម ១៥: ៤បានបង្ហាញ តើយើងអាចទទួលការសម្រាលទុក្ខយ៉ាងដូចម្ដេច ពេលប្រឈមមុខនឹងស្ថានភាពដ៏ពិបាក ?
ទោះជាស្ថានភាពពិបាកធ្វើឲ្យមនុស្សកាន់តែច្រើនជាងមុនរងទុក្ខក៏ដោយ នេះមិនមែនជាអ្វីដែលថ្មីសម្រាប់មនុស្សជាតិនោះទេ ។ សូមយើងពិចារណាថាយើងអាចរៀនអ្វីខ្លះពីអ្នកបម្រើមួយចំនួនរបស់ព្រះនៅសម័យបុរាណ ដែលបានប្រឈមមុខនឹងបញ្ហាក្នុងជីវិតដោយចិត្ដក្លាហាន ។ — រ៉ូម ១៥: ៤
៣៨ : ៤-៨) កំណត់ហេតុក្នុងគម្ពីរស្ដីអំពីដំណើរជីវិតរបស់ដាវីឌ បានបង្ហាញយ៉ាងច្បាស់អំពីការឈឺចាប់របស់គាត់ ដែលបណ្ដាលមកពីទុក្ខលំបាកទាំងនេះ ។ ប៉ុន្ដែ ទុក្ខលំបាកទាំងនេះមិនបានបំផ្លាញចំណងមិត្ដ ភាពរវាងគាត់និងព្រះទេ ។ គាត់បាននិយាយដោយជំនឿរឹងមាំថា ៖ « ព្រះយេ ហូវ៉ាទ្រង់ជាទីពឹងពំនាក់នៃជីវិតខ្ញុំ តើត្រូវឲ្យខ្ញុំភ័យចំពោះអ្នកណា ? »
តើអ្វីបានជួយអា ប្រាហាំនិងសា រ៉ាឲ្យស៊ូទ្រាំនឹងជីវិតដ៏ពិបាក ?
តើយើងអាចយកត ម្រាប់យ៉ូបយ៉ាងដូចម្ដេច ?
កាលដែលប៉ូលបម្រើព្រះ តើគាត់បានជួបនឹងទុក្ខលំបាកអ្វីខ្លះ ?
ប៉ុន្ដែតើការដឹងអំពីអ្វី បានជួយប៉ូលឲ្យមានចិត្ដក្លាហានដើម្បីបន្ដបម្រើព្រះ?
តើបញ្ហាសព្វថ្ងៃនេះប្រហែលជាមានឥទ្ធិពលយ៉ាងណាមកលើយើង ?
តើយើងអាចជៀសវាងពីការធ្លាក់ទឹកចិត្ដដោយសារ ទុក្ខលំបាកក្នុងជីវិតយ៉ាងដូចម្ដេច ?
យើងត្រូវផ្ដោតអារម្មណ៍ទៅលើអ្វីដែលយើងគិតថាល្អក្នុងជីវិតរបស់យើង ។ បណ្ដាំរបស់ព្រះប្រាប់យើងថា ៖ « ចិត្ដរីករាយតែងតែបណ្ដាលឲ្យមានទឹកមុខផូរផង់ តែវិញ្ញាណត្រូវបាក់បែកដោយកើតមានទុក្ខព្រួយក្នុងចិត្ដ » ។ ( សុភ.
សូមលើកឧទាហរណ៍ ។ ( ខ ) តើតាមរបៀបណាមហ ន្ដ រាយធម្មជាតិអាចធ្វើឲ្យយើងដឹងថាអ្វីគឺសំខាន់បំផុតក្នុងជីវិត ?
មូលហេតុដែលយើងមានចិត្ដក្លាហាន
២៨ : ៧) ប៉ូលបានសម្ដែងនូវទំនុកចិត្ដឥតរង្គោះរង្គើរបស់គាត់ ដោយស្រដីថា ៖ « យើងកំពុងឈ្នះក្នុងការទាំងអស់នេះ ដោយសារលោកដែលបានស្រឡាញ់យើង » ។ ស្រដៀងគ្នាដែរ កាលដែលលោកយេស៊ូជិតរងគ្រោះ លោកបានបញ្ជាក់យ៉ាងច្បាស់ថាលោកមានចំណងមិត្ដ ភាពរឹងមាំជាមួយព្រះ ដោយមានប្រសាសន៍ថា ៖ « ខ្ញុំមិនមែននៅម្នាក់ឯងទេ ពីព្រោះបិតានៅស្ថានសួគ៌នៅជាមួយនឹងខ្ញុំ » ។ តើពាក្យទាំងនេះសឲ្យឃើញអ្វី ?
ពាក្យទាំងអស់នេះសឲ្យឃើញនូវទំនុកចិត្ដឥតរង្គោះរង្គើទៅលើព្រះយេ ហូវ៉ា ។ បើយើងបណ្ដុះនូវទំនុកចិត្ដស្រដៀងគ្នា នេះអាចជួយយើងឲ្យមានចិត្ដក្លាហានដើម្បីប្រឈមមុខនឹងទុក្ខលំបាកណាក៏ដោយនៅសព្វថ្ងៃនេះ ។ — សូមអាន ទំនុក ត ម្កើង ៤៦ : ១-៣
ចូរទទួលប្រយោជន៍ពីរបៀបរៀបចំរបស់ព្រះដើម្បីរក្សាចិត្ដក្លាហាន
ហេតុអ្វីការសិក្សាបណ្ដាំរបស់ព្រះជាអ្វីដែលសំខាន់ចំពោះយើង ?
ការធ្វើអ្វី ៗ ទាំងនេះនឹងជួយយើងឲ្យមានចិត្ដគំនិតដូចអ្នកតែងទំនុក ត ម្កើងដែលបានពោលថា ៖ « ឱទូលបង្គំស្រឡាញ់ក្រិត្យវិន័យរបស់ទ្រង់ណាស់ហ្ន៎ ទូលបង្គំរំពឹងគិតពីក្រិត្យវិន័យនោះជាដរាបរាល់ថ្ងៃ » ។ — ទំនុក .
បងប្រុសអា ឡេចនៅប្រទេសអង់គ្លេសដែលបានធ្លាក់ទឹកចិត្ដជាយូរមកហើយ បានពោលថា ៖ « ការអធិដ្ឋានទៅព្រះយេ ហូវ៉ា ហើយស្តាប់លោកដោយអានបណ្ដាំរបស់លោកគឺជាអ្វីដែលសំខាន់ចាំបាច់សម្រាប់ខ្ញុំ » ។
បងស្រីឡានី ដែលបានត្រូវរៀបរាប់ខាងលើ ពន្យល់អំពីទស្សនៈរបស់គាត់ស្ដីអំពីការសេព គប់របស់គ្រិស្ដសាសនិកថា ៖ « ការចូលរួមប្រជុំគឺសំខាន់ណាស់ ។ ខ្ញុំបានដឹងថាខ្ញុំត្រូវទៅប្រជុំ បើខ្ញុំចង់ឲ្យព្រះយេ ហូវ៉ាជួយខ្ញុំឲ្យចេះស៊ូទ្រាំ » ។
តើយើងមានទំនុកចិត្ដយ៉ាងណាពេលដែលយើងប្រឈមមុខនឹងទុក្ខលំបាក ?
យើងមិនឈប់ត ស៊ូឡើយ » ។ ដោយមានជំនួយពីព្រះយេ ហូវ៉ា យើងអាចប្រឈមមុខនឹងទុក្ខលំបាកសព្វថ្ងៃនេះដោយចិត្ដក្លាហាន ។ — សូមអាន កូរិន ថូស ទី២ ៤: ១៧, ១៨
ហេតុអ្វីយើងគួរយកចិត្ដទុកដាក់នឹងចិត្ដគំនិតដែលយើងបង្ហាញ ?
តើយើងចង់ជៀសវាងពីចិត្ដគំនិតបែបណា ហើយតើយើងអាចធ្វើដូច្នេះយ៉ាងដូចម្ដេច ?
តើយើងអាចធ្វើអ្វីដើម្បីបង្ហាញចិត្ដគំនិតដែលលើកទឹកចិត្ដនៅក្នុងក្រុមជំនុំ ?
ពេលសរសេរសំបុត្រទៅបងប្អូនរួមជំនឿ តើប៉ូលបានបញ្ជាក់អំពីសេចក្ដីសង្ឃឹមអ្វី ?
បទគម្ពីរប្រាប់យើងថា ៖ « យើងមិនបានទទួលចិត្ដគំនិតរបស់ពិភពលោកនេះទេ តែបានទទួលសកម្ម ពលពីព្រះ » ។ តើ « ចិត្ដគំនិតរបស់ពិភពលោក » គឺជាអ្វី ?
តើបណ្ដាជនអ៊ីស្រាអែលខ្លះបានបង្ហាញចិត្ដគំនិតមិនត្រឹមត្រូវយ៉ាងដូចម្ដេច ?
ម្ដេចឡើយអ្នកទាំង២លើកកំពស់ខ្លួនត្រួតលើពួកជំនុំ ? »
១៦: ៣) ស្រដៀងគ្នាដែរ ដា ថា ននិងអ័ ប៊ី រ៉ាមបានត្អូញត្អែរប្រឆាំងនឹងម៉ូសេដោយនិយាយថាគាត់ ‹ ចង់លើកខ្លួន ធ្វើជាកំពូលលើពួកគេទៀត › ។ ពេលដែលម៉ូសេបានហៅពួកគេឲ្យមក ពួកគេបានតបឆ្លើយដោយក្រអឺត ក្រទមថា ៖ « យើងមិនព្រមទៅសោះឡើយ ! »
១៦: ១២-១៤) ព្រះយេ ហូវ៉ាច្បាស់ជាមិនពេញចិត្ដនឹងចិត្ដគំនិតរបស់ពួកគេឡើយ ។ លោកបានប្រហារជីវិតពួកអ្នកប្រឆាំងទាំងអស់នោះ ។ — ជន .
តើតាមរបៀបណាអ្នកខ្លះនៅសតវត្សរ៍ទី១បានបង្ហាញថាពួកគេមានចិត្ដគំនិតអាក្រក់ ហើយប្រហែលជាដោយសារមូលហេតុអ្វី ?
មនុស្សខ្លះនៅសតវត្សរ៍ទី១ក៏បានចាប់ផ្ដើមរិះគន់ពួកអ្នកដែលបានត្រូវតែងតាំងឲ្យមានអំណាចលើក្រុមជំនុំ ព្រមទាំង « មើលងាយអ្នកដែលមានអំណាចលើពួកគេ » ។ បុរសទាំងនេះទំនងជាមិនពេញចិត្ដនឹងឯក សិទ្ធិរបស់ពួកគេ ហើយបានព្យាយាមបញ្ចុះបញ្ចូលអ្នកឯទៀតឲ្យប្រឆាំងនឹងបុរសដែលបានត្រូវតែងតាំង ដែលកំពុងបំពេញយ៉ាងយកចិត្ដទុកដាក់នូវភារកិច្ចដែលព្រះបានប្រគល់ឲ្យ ។ — សូមអាន យ៉ូហាន ទី៣ ៩, ១០
តើយើងត្រូវប្រយ័ត្ននឹងចិត្ដគំនិតបែបណាក្នុងក្រុមជំនុំសព្វថ្ងៃនេះ ?
ដោយសារពួកគេឃើញភាពមិនល្អឥតខ្ចោះរបស់ពួកអ្នកចាស់ទុំ នោះអ្នកខ្លះនៅក្នុងក្រុមជំនុំដែលបានប្រព្រឹត្ដអំពើខុសឆ្គងធ្ងន់ធ្ងរបដិសេធមិនមកជួបគណៈកម្មាធិការវិនិច្ឆ័យដែលបានត្រូវតែងតាំងឲ្យជួយពួកគេ ។ នេះអាចប្រៀបដូចជាអ្នកជំងឺដែលមិនព្រមទទួលប្រយោជន៍ពីការព្យាបាល ដោយសារគាត់មិនចូលចិត្ដលក្ខណៈខ្លះរបស់គ្រូពេទ្យនោះ ។
យើងគួរចាំជានិច្ចថា ព្រះយេ ហូវ៉ាបានតែងតាំងអ្នកចាស់ទុំឲ្យ « ឃ្វាលក្រុមជំនុំរបស់ព្រះ » ។ ដូច្នេះ យើងទទួលស្គាល់ថាយើងគួរគោរពការរៀបចំរបស់ព្រះ ទោះជាយើងមានឯក សិទ្ធិបម្រើជាអ្នកចាស់ទុំឬមិនមានក៏ដោយ ។ ការរក្សាចិត្ដគំនិតត្រឹមត្រូវអាចជួយយើងឲ្យជៀសវាងពីការខ្វល់ខ្វាយហួសហេតុពេកអំពីឋានៈរបស់យើង ។ ពេលស្ដេចសូលនៃស្រុកអ៊ីស្រាអែលមានអារម្មណ៍ថាដាវីឌអាចនាំឲ្យគាត់បាត់បង់រាជ្យសម្បត្ដិ សូល « ចេះតែរំពៃមើលដាវីឌ » ។ ( ១សាំ .
១៨ : ៩) ស្ដេចសូលបានបណ្ដុះចិត្ដគំនិតអាក្រក់ ហើយថែមទាំងចង់សម្លាប់ដាវីឌទៀតផង ។ ជាជាងគិតហួសហេតុពេកអំពីឋានៈរបស់ខ្លួនដូចសូល ជាការល្អជាងដែលយើងធ្វើដូចដាវីឌ ។ ទោះជាដាវីឌទទួលរងនូវអំពើអ យុត្ ដិ ធម៌ជាច្រើនក៏ដោយ បុរសវ័យក្មេងនេះបាននៅតែគោរពអ្នកដែលព្រះបានតែងតាំងឲ្យមានអំណាច ។ — សូមអាន សាំ យូអែល ទី១ ២៦: ២៣
តើអ្វីនឹងជួយឲ្យមានសាមគ្គីភាពក្នុងក្រុមជំនុំ ?
តើយើងគួរមានទស្សនៈយ៉ាងណាចំពោះមតិផ្ទាល់ខ្លួនរបស់យើង ហើយតើក្នុងគម្ពីរមានឧទាហរណ៍អ្វីខ្លះស្ដីអំពីរឿងនេះ ?
តើយើងអាចបង្ហាញចិត្ដគំនិតត្រឹមត្រូវក្នុងទំនាក់ទំនងរបស់យើងជាមួយនឹងអ្នកឯទៀតយ៉ាងដូចម្ដេច ?
យើងអាចរៀនពីគំរូរបស់យ៉ូបស្ដីអំពីការអភ័យទោស ។ មិត្ដភក្ដិក្លែងក្លាយបីនាក់បានធ្វើឲ្យគាត់អាក់អន់ចិត្ដ ដោយពោលពាក្យមិនសប្បុរសជាច្រើន ។ ប៉ុន្ដែ យ៉ូបបានអភ័យទោសឲ្យពួកគេ ។ តើតាមរបៀបណា ?
ស្ដីអំពី « ចិត្ដគំនិតត្រឹមត្រូវ » របស់យើង តើយើងអាចតាំងចិត្ដធ្វើអ្វី ?
នៅល្ងាចមួយនៃរដូវក្ដៅក្នុងឆ្នាំ១៩៥១ យុវជនបួននាក់ដែលទាំងអស់គ្នាមានអាយុជាង២០ឆ្នាំ បានឈរក្នុងបន្ទប់ទូរស័ព្ទដែលនៅជិ ត ៗ គ្នានៅក្រុងអ៊ី តា ខា រដ្ឋញូវយ៉ក សហរដ្ឋ អាម៉េរិក ហើយបានទូរស័ព្ទទៅរដ្ឋមី ស៊ី ហ្គិន រដ្ឋអាយ អូ វ៉ា និងរដ្ឋកា លី ហ្វ័ រញ៉ាទាំងរំភើបចិត្ដ ។ ពួកគេចង់ប្រាប់ដំណឹងល្អដល់ក្រុមគ្រួសារនិងមិត្ដភក្ដិ !
នៅដើមខែកុម្ភៈ អ្នកត្រួសត្រាយ១២២នាក់បានទៅដល់ក្រុងសោតឡានស៊ីង រដ្ឋញូវយ៉ក ដើម្បីចូលសាលាគីលាតជំនាន់ទី១៧ ។ ក្នុងចំណោមអ្នកដែលនឹងក្លាយជាសាសន ទូតទាំងនោះរួមមានបងប្រុសឡូ វែល ធឺ ន នឺ បងប្រុសវីលៀម ( បៀល ) ខា ស ថិន រី ឆឺដ ខេ ល ស៊ី និងបងប្រុសរ៉ា ម៉ិន ថេម ផឺល ថុន ។ បងប្រុសឡូ វែលនិងបៀលមកពីរដ្ឋមី ស៊ី ហ្គិន បងរី ឆឺដមកពីរដ្ឋអាយ អូ វ៉ា និងបងរ៉ា ម៉ិនមកពីរដ្ឋកា លី ហ្វ័ រញ៉ា មិនយូរប៉ុន្មានពួកគាត់ទាំងអស់គ្នាចាប់ផ្ដើមស្គាល់គ្នាច្បាស់ ។
ពួកគាត់នឹងដឹងមែន !
ពេលបងន័រកំពុងថ្លែងសុន្ទរកថា សិស្សទាំងអស់ចង់ដឹងកាន់តែខ្លាំងឡើងនៅពេលដែលគាត់ចាប់ផ្ដើមប្រកាសអំពីប្រទេសដែលពួកគេនឹងត្រូវចាត់ឲ្យទៅ ។ សិស្សដំបូងដែលគាត់ហៅឲ្យឡើងលើវេទិកាគឺយុវជនទាំងបួននាក់នេះដែលមានអារម្មណ៍ភ័យ ប៉ុន្ដែបានធូរស្រាលពេលដែលពួកគាត់ដឹងថាពួកគាត់អាចទៅជាមួយគ្នា !
អស់អ្នកដែលទាញយកមេរៀនអំពីរឿងនេះ នឹងសប្បាយចិត្ដបម្រើព្រះយេ ហូវ៉ានៅកន្លែងណាក៏ដោយ ហើយបំពេញភារកិច្ចណាក៏ដោយដែលលោកចាត់ឲ្យធ្វើ ។
នោះពួកគាត់មានអារម្មណ៍មិនស្រួលទេ ។ តើពួកគាត់បានធ្វើអ្វីដែលនាំឲ្យបងហ្វ្ រូសនិយាយខ្លាំង ៗ បែបនេះ ?
ពេលដែលបងប្រុសជនជាតិស្វីសម្នាក់បានឲ្យយើងស្នាក់នៅផ្ទះឈើរបស់គាត់នៅលើភ្នំ នាប្រទេសស្វីស សម្រាប់វិស្សមកាលលើកទី១របស់យើងក្រោយពីរស់នៅអា ឡឺ ម៉ ង់បានមួយឆ្នាំ ។ យើងអាចសម្រាកពីរសប្ដាហ៍ដោយមិនពិបាកនិយាយភាសាអា ឡឺ ម៉ ង់ !
ប៉ុន្ដែ ខ្ញុំមិនបានដឹងអំពីអ្វីដែលបងឡូ វែលនឹងធ្វើនោះទេ ។ គាត់បានទទូចឲ្យយើងអាននិងពិភាក្សាបទគម្ពីរប្រចាំថ្ងៃរៀងរាល់ព្រឹក ជាភាសាអា ឡឺ ម៉ ង់ !
ជីវិតអាពាហ៍ ពិពាហ៍ដែលមានសុភមង្គល
១៧: ១៧) នៅក្នុងពិភពលោកសព្វថ្ងៃនេះ កម្រមានមិត្ដភក្ដិពិតប្រាកដបែបនេះណាស់ !
ជាការល្អណាស់ដែលបងឡូ វែល រ៉ា ម៉ិន បៀល រី ឆឺដបានប្រគល់ខ្លួនជូនព្រះយេ ហូវ៉ានៅពេលពួកគាត់មានអាយុ១៨ ១២ ១១ និង១០ឆ្នាំ ហើយពេលមានអាយុរវាង១៧ឆ្នាំនិង២១ឆ្នាំ ពួកគាត់បានចាប់ផ្ដើមបម្រើពេញពេល ។ ពួកគាត់ធ្វើតាមឱវាទនៅសាស្តា ១២: ១ដែលលើកទឹកចិត្ដពួកគាត់ថា ៖ « ចូរនឹកចាំពីព្រះដ៏បង្កើតខ្លួន ក្នុងគ្រាដែលឯងនៅក្មេង » ។
ពួកគាត់អាចបំពេញភារកិច្ចដូចខាងលើនេះបាន ដោយសារកាលពីពួកគាត់នៅជាយុវជន ពួកគាត់បានធ្វើតាមការអញ្ជើញដែលប្រកបដោយសេចក្ដីស្រឡាញ់របស់ព្រះយេ ហូវ៉ាឲ្យបម្រើលោកអស់ ពីកម្លាំងកាយចិត្ដ ។ — កូឡ .
សព្វថ្ងៃនេះបងឡូ វែល រី ឆឺដ និងរ៉ា ម៉ិនបម្រើជាមួយគ្នាម្ដងទៀតនៅការិយាល័យសាខាដែលឥឡូវនេះនៅក្រុងសែលតឺស៍ប្រទេសអា ឡឺ ម៉ ង់ ។ គួរឲ្យសោក ស្តាយណាស់ បងបៀលបានស្លាប់នៅឆ្នាំ២០១០ ពេលគាត់បម្រើជាអ្នកត្រួសត្រាយពិសេសនៅសហរដ្ឋ អាម៉េរិក ។ ជិត៦០ឆ្នាំដែលបងប្រុសទាំងបួននាក់មានចំណងមិត្ដភក្ដិដ៏ពិសេសជាមួយនឹងគ្នា បានបែកគ្នាដោយសារសេចក្ដីស្លាប់ !
អំណរដែលពួកគាត់បានទទួលជាបន្ដបន្ទាប់ក្នុងភារកិច្ចរបស់ពួកគាត់ ធ្វើឲ្យពួកគាត់ជឿជាក់ថាព្រះយេ ហូវ៉ាជ្រាបជានិច្ចអំពីអ្វីដែលល្អបំផុតសម្រាប់ពួកគាត់
ខាងលើ : បងហ្វ្ រូស ( ខាងស្ដាំ ) និងអ្នកឯទៀត ក្នុងអំឡុងទស្សនកិច្ចជាមួយបងន័រ ( ខាងឆ្វេង ) ខាងស្ដាំ : ក្នុងអំឡុងវិស្សមកាលនៅប្រទេសស្វីស នៅឆ្នាំ១៩៥២
ពីឆ្វេងទៅស្ដាំ : បងរី ឆឺដ បៀល ឡូ វែលនិងរ៉ា ម៉ិនជួបគ្នា នៅក្រុងសែ ល តឺស៍ ក្នុងពិធីសម្ពោធអាគារថ្មី របស់ការិយាល័យសាខានៅឆ្នាំ១៩៨៤
លោកយេស៊ូបានធ្វើគំរូស្ដីអំពីចិត្ដរាបទាប
ចូរអប់រំខ្លួនឲ្យមានចិត្ដគំនិតជាអ្នកតូចជាងគេ
តើការអភ័យទោសរបស់ព្រះយេ ហូវ៉ាផ្ដល់ប្រយោជន៍អ្វីដល់អ្នក ?
ចូរអភ័យទោសឲ្យគ្នាទៅវិញទៅមកដោយគ្មានល័ក្ខខ័ណ្ឌ
ស្ដេចដាវីឌនៅអ៊ីស្រាអែលសម័យបុរាណបានលើកត ម្កើងនាមរបស់ព្រះយេ ហូវ៉ានិងគោលបំណងរបស់លោកយ៉ាងខ្លាំង ។ គាត់ក៏បានឲ្យតម្លៃទៅលើគោលការណ៍ដែលជាមូលដ្ឋាននៃច្បាប់របស់ព្រះ ហើយបានអធិដ្ឋានឲ្យព្រះបង្រៀនគាត់ឲ្យធ្វើតាមបំណងប្រាថ្នារបស់លោក ដូចអត្ថបទនេះបង្ហាញ ។ អត្ថបទនេះក៏ជួយយើងឲ្យដឹងអំពីមូលហេតុដែលយើងគួរមានទស្សនៈដូចព្រះយេ ហូវ៉ាចំពោះរឿងផ្សេងៗគ្រប់ពេលវេលា ។
ក្រប: កិច្ចផ្សព្វផ្សាយនៅក្រុងតូចមួយនៅជនបទ នាក្រុងអាល់ បារ៉ា សេន នៃប្រទេសអេស្ប៉ាញភាគកណ្ដាល ។ ក្រុមជំនុំថេ រូ អែលមានអ្នកផ្សព្វផ្សាយ៧៨នាក់ ហើយក្នុងតំបន់ផ្សាយរបស់ក្រុមជំនុំនោះមានក្រុងអាល់ បារ៉ា សេន ភូមិ និងក្រុង១៨៨ទៀត
ចំនួនអ្នកចូលរួមពិធីរំលឹកនៅឆ្នាំ២០១២
តើអ្វីបានជួយដាវីឌឲ្យយល់អំពីបំណងប្រាថ្នារបស់ព្រះ?
តើអ្វីនឹងជួយយើងឲ្យនៅតែទទួលការពេញចិត្ដពីព្រះយេ ហូវ៉ា ?
តើការគិតអំពីបំណងប្រាថ្នារបស់ព្រះអាចជួយយើងយ៉ាងដូចម្ដេច ហើយតើយើងសង្ឃឹមថាអាចរៀនអ្វីពីស្ដេចដាវីឌស្ដីអំពីរឿងនេះ ?
ពេលអ្នកកំពុងដើរកាត់ភ្នំស្រាប់តែអ្នកមកដល់ផ្លូវដែលបែកជាពីរ ។ តើអ្នកគួរទៅតាមផ្លូវមួយណា ?
ពេលប្រឈមមុខនឹងកូ លី យ៉ាត យុវជនដាវីឌបានប្រកាសថា៖«ឯងបានមកឯអញ ទាំងកាន់ដាវកាន់លំពែង ហើយនឹងដែកពួយផង តែឯអញវិញ អញមកឯឯងដោយនូវព្រះនាមរបស់ព្រះយេ ហូវ៉ានៃពួកពលបរិវារ គឺជាព្រះនៃពួកពលសាសន៍អ៊ីស្រាអែល ដែលឯងបានប្រកួតនឹងគេនោះ» ។ ( ១សាំ .
តើអ្នកមានមោទនភាពដោយសារអ្នកមានព្រះយេ ហូវ៉ាជាព្រះរបស់អ្នកឬទេ ?
៩: ២៤ ) តើអ្នកមានប្រតិកម្មយ៉ាងណាពេលអ្នកជិតខាង អ្នករួមការងារ សិស្សរួមថ្នាក់ ឬញាតិសន្ដាន និយាយដោយមិនគោរពព្រះយេ ហូវ៉ា ហើយចំអកឲ្យសាក្សីរបស់លោក ?
ពេលនាមរបស់ព្រះបានត្រូវគេតិះដៀល តើអ្នកហ៊ាននិយាយដោយទុកចិត្ដលើការគាំទ្ររបស់លោកឬទេ ?
១៧: ១១ ) ផ្ទុយទៅវិញ យើងគួរឆាប់និយាយការពារនាមដ៏បរិសុទ្ធរបស់ព្រះយេ ហូវ៉ា ។ បំណងប្រាថ្នារបស់យើងគឺជួយមនុស្សឲ្យស្គាល់ព្រះយេ ហូវ៉ាច្បាស់ ។ ដើម្បីសម្រេចគោលបំណងនេះ យើងប្រើបណ្ដាំរបស់លោកដើម្បីជួយអ្នកឯទៀតឲ្យយល់សារៈសំខាន់នៃការចូលទៅជិតព្រះ ។ — យ៉ា.
តើអ្វីជាមូលហេតុសំខាន់បំផុតដែលដាវីឌប្រយុទ្ធជាមួយនឹងកូ លី យ៉ាត ហើយតើអ្វីគួរជារឿងសំខាន់បំផុតចំពោះយើង ?
១៧: ២៥-២៧ ) បណ្ដាជនបានឆ្លើយតបដោយនិយាយម្ដងទៀតនូវអ្វីដែលពួកគេបាននិយាយពីមុនថា៖«បើអ្នកណាសំឡាប់បាន នោះស្ដេចនឹងប្រទានទ្រព្យសម្បត្ដិដ៏វិសេស ដល់អ្នកនោះ ព្រមទាំងឲ្យព្រះរាជបុត្រីទ្រង់ផង» ។ ( ១សាំ .
តើការចង់បានកេរ្ដិ៍ឈ្មោះដោយរកទ្រព្យសម្បត្ដិឲ្យបានច្រើន ហើយមានមុខមាត់ក្នុងពិភពលោកជារឿងសំខាន់បំផុតចំពោះយើងឬ ?
ច្បាស់ណាស់ យើងចង់ធ្វើដូចដាវីឌដែលបានច្រៀងថា៖«ចូរដំកើងព្រះយេ ហូវ៉ាជាមួយនឹងខ្ញុំចុះ ចូរយើងព្រមគ្នាលើកព្រះនាមទ្រង់ឡើង» ។ ( ទំនុក .
៣៤: ៣ ) ហេតុនេះ សូមឲ្យយើងទុកចិត្ដលើព្រះ ដោយចាត់ទុកកេរ្ដិ៍ឈ្មោះរបស់លោកថាសំខាន់ជាងកេរ្ដិ៍ឈ្មោះរបស់យើង ។ — ម៉ា ថ.
តើដាវីឌបានប្រព្រឹត្ដយ៉ាងណាចំពោះស្ដេចសូល ដែលបង្ហាញថាគាត់នៅតែគិតដល់បំណងប្រាថ្នារបស់ព្រះយេ ហូវ៉ា ?
១៨: ៧-១១; ១៩: ១០ ) បន្ទាប់មក សូលបាននាំបុរសចំនួន៣.០០០នាក់ដែលគាត់បានជ្រើសរើសនៅស្រុកអ៊ីស្រាអែល ហើយបានចេញទៅតាមរកដាវីឌនៅតំបន់ស្ងាត់ជ្រងំ ។ ( ១សាំ .
២៦ : ៨-១១ ) ដោយសារដាវីឌបន្ដស្វែងរកការណែនាំពីព្រះ គាត់មិនបានផ្លាស់ប្ដូរការតាំងចិត្ដរបស់គាត់ដើម្បីប្រព្រឹត្ដសមស្របតាមបំណងប្រាថ្នារបស់ព្រះយេ ហូវ៉ា ទោះជាអ័ ប៊ី សាយបានជំរុញគាត់ក៏ដោយ ។
តើអ្នកបានរៀនអ្វីពីដាវីឌស្ដីអំពីការចាត់ទុកបំណងប្រាថ្នារបស់ព្រះថាសំខាន់បំផុតក្នុងជីវិតរបស់អ្នក ?
ដាវីឌបានពន្យល់ថា៖«សូមឲ្យព្រះនៃទូលបង្គំឃាត់មិនឲ្យទូលបង្គំធ្វើដូច្នោះឡើយ តើទូលបង្គំនឹងផឹកឈាមរបស់មនុស្សទាំងនេះ ដែលបានប្រថុយជីវិតយ៉ាងនេះឬអី ដ្បិតគេបានយកទឹកនេះមក ដោយប្រថុយជីវិតរបស់គេ» ។ — ១រប.
តើអ្វីបានជួយដាវីឌឲ្យមានទស្សនៈដូចព្រះយេ ហូវ៉ាស្ដីអំពីរឿងផ្សេងៗ?
ដាវីឌបានព្យាយាមធ្វើតាមច្បាប់របស់ព្រះយ៉ាងដិតដល់ ។ គាត់បានច្រៀងថា៖«ឱព្រះនៃទូលបង្គំអើយ ទូលបង្គំមានសេចក្ដីអំណរ នឹងធ្វើតាមព្រះហឫទ័យទ្រង់ អើ ក្រឹត្យវិន័យរបស់ទ្រង់ក៏នៅក្នុងចិត្ដទូលបង្គំ» ។ ( ទំនុក .
តើតាមរបៀបណាសាឡូម៉ូនមិនបានគោរពច្បាប់របស់ព្រះ?
១១: ១-៦ ) ជាការសំខាន់ណាស់ដែលយើងធ្វើតាមច្បាប់និងគោលការណ៍ដែលមាននៅក្នុងបណ្ដាំរបស់ព្រះ!
តើយើងរៀនអ្វីពីច្បាប់របស់ព្រះដែលថាឲ្យរៀបការតែជាមួយអ្នក«កាន់តាមលោកម្ចាស់»ប៉ុណ្ណោះ ?
ប្រសិនបើអ្នកមិនជឿណាម្នាក់ចង់មានទំនាក់ទំនងស្នេហាជាមួយយើង តើយើងតបឆ្លើយដោយបង្ហាញឲ្យឃើញទស្សនៈដូចដាវីឌឬដូចសាឡូម៉ូន ?
គម្ពីរបង្គាប់ឲ្យអ្នកគោរពប្រណិប័តន៍ពិតរបស់ព្រះរៀបការតែជាមួយអ្នក«កាន់តាមលោកម្ចាស់»ប៉ុណ្ណោះ ។ ( ១កូ.
៧: ៣៩ ) ប្រសិនបើគ្រិស្ដសាសនិកម្នាក់សម្រេចចិត្ដរៀបការ គាត់គួរតែរៀបការជាមួយអ្នកដែលមានជំនឿដូចគ្នា ។ ប្រសិនបើយើងស្គាល់គោលការណ៍ដែលមានក្នុងខគម្ពីរនេះ យើងមិនត្រឹមតែមិនរៀបការជាមួយអ្នកដែលមិនជឿប៉ុណ្ណោះទេ ប៉ុន្ដែយើងក៏មិនចង់មានទំនាក់ទំនងស្នេហាជាមួយបុគ្គលបែបនោះដែរ ។
តើអ្វីអាចជួយយើងឲ្យជៀសវាងពីការមើលរូបអាសអាភាសដែលប្រៀបដូចជាអន្ទាក់ ?
ចូរគិតអំពីទស្សនៈរបស់ព្រះគ្រប់ពេលវេលា
ពីព្រោះដាវីឌបានព្យាយាមប្រព្រឹត្ដស្របតាមបំណងប្រាថ្នារបស់ព្រះ ។
តើអ្វីបានរារាំងដាវីឌមិនឲ្យសម្លាប់សូល ពេលគាត់មានឱកាសធ្វើដូច្នេះ ?
តើយើងអាចរៀនអ្វីពីការដែលដាវីឌមិនព្រមផឹកទឹកដែលពួកបុរសរបស់គាត់បានយកមកឲ្យគាត់ ?
ជាមនុស្សជាតិ តើលោកយេស៊ូបានបង្ហាញចិត្ដរាបទាបយ៉ាងដូចម្ដេច ?
លោកយេស៊ូផ្ទាល់បានពន្យល់ថា៖«តើអ្នករាល់គ្នាយល់អ្វីដែលខ្ញុំបានធ្វើដល់អ្នករាល់គ្នាទេ ? .. .
ប្រសិនបើខ្ញុំបានលាងជើងរបស់អ្នករាល់គ្នា ទោះបីខ្ញុំជាម្ចាស់និងជាគ្រូក៏ដោយ នោះអ្នករាល់គ្នាក៏ត្រូវលាងជើងឲ្យគ្នាទៅវិញទៅមកដែរ ។ ព្រោះខ្ញុំបានធ្វើគំរូឲ្យអ្នករាល់គ្នា ដើម្បីឲ្យអ្នករាល់គ្នាធ្វើអ្វីដែលខ្ញុំបានធ្វើដល់អ្នករាល់គ្នា» ។ ( យ៉ូន .
១៣:១២-១៥ ) ដោយសុខចិត្ដធ្វើកិច្ចការបែបនេះដែលមនុស្សចាត់ទុកថាថោកទាប លោកយេស៊ូបានបង្រៀនមេរៀនដ៏សំខាន់មួយដល់ពួកសាវ័ករបស់លោក ដែលបានដិតជាប់យ៉ាងជ្រៅក្នុងចិត្ដរបស់ពួកគេ ហើយបានលើកទឹកចិត្ដពួកគេឲ្យមានចិត្ដរាបទាបនៅពេលក្រោយមក ។ ៣.
៩: ៤៦-៤៨ ) ក្រោយមកក្នុងកិច្ចបម្រើផ្សាយរបស់លោក ដោយដឹងថាពួកផា រិ ស៊ីចង់បានមុខមាត់ លោកយេស៊ូបានមានប្រសាសន៍ទៅពួកគេថា៖«អ្នកណាដែលត ម្កើងខ្លួន អ្នកនោះនឹងត្រូវបន្ទាបចុះ តែអ្នកណាដែលបន្ទាបខ្លួន អ្នកនោះនឹងត្រូវត ម្កើងឡើង» ។ ( លូក .
១៤: ១១ ) ច្បាស់ណាស់ លោកយេស៊ូចង់ឲ្យអ្នកកាន់តាមលោកមានចិត្ដរាបទាបពោលគឺគ្មានចិត្ដអំ ណួ តនិងគ្មានចិត្ដក្រអឺត ក្រអោង ។ ដើម្បីយកត ម្រាប់លោក ចូរយើងពិនិត្យមើលដោយយកចិត្ដទុកដាក់អំពីគំរូរបស់លោកស្ដីអំពីចិត្ដរាបទាប ។ យើងក៏នឹងពិចារណានូវមូលហេតុដែលគុណសម្បត្ដិនេះមានប្រយោជន៍ មិនគ្រាន់តែចំពោះអ្នកដែលបង្ហាញគុណសម្បត្ដិនេះប៉ុណ្ណោះទេ ប៉ុន្ដែចំពោះអ្នកឯទៀតផងដែរ ។
តើបុត្រតែមួយរបស់ព្រះបានបង្ហាញចិត្ដរាបទាបយ៉ាងដូចម្ដេច មុននឹងលោកមកផែនដី ?
នូវគំរូរបស់ព្រះយេ ហូវ៉ាស្ដីអំពីចិត្ដរាបទាប ពេលលោកបង្ហាញសេចក្ដីមេ ត្ដាក រុណាចំពោះមនុស្សជាតិដែលមានភាពខុសឆ្គង ។
ដើម្បីលើកបញ្ជាក់អំពីចិត្ដរាបទាបរបស់បុត្រតែមួយរបស់ព្រះ សាវ័កប៉ូលបានសរសេរថា៖«ទោះជាលោកធ្លាប់មានសណ្ឋានដូចព្រះ លោកមិនដែលគិតអំពីការដណ្ដើមយកឋានៈរបស់ព្រះ ពោលគឺការតាំងខ្លួនឲ្យស្មើព្រះនោះទេ ។ លោកមិនបានធ្វើដូច្នេះទេ តែលោកបានលះបង់អ្វីៗទាំងអស់ ហើយយកសណ្ឋានជាខ្ញុំបម្រើ រួចក្លាយទៅជាមនុស្សជាតិ» ។ — ភី.
តើតាមរបៀបណាលោកយេស៊ូបង្ហាញចិត្ដរាបទាបពេលលោកនៅក្មេង និងក្នុងអំឡុងកិច្ចបម្រើផ្សាយរបស់លោកនៅផែនដី ?
២:៨ ) តាំងពីក្មេងមក លោកយេស៊ូបានទុកគំរូឲ្យយើងស្ដីអំពីចិត្ដរាបទាប ។ ទោះជាលោកបានត្រូវចិញ្ចឹមដោយយ៉ូសែបនិងម៉ា រៀជាឪពុកម្ដាយដែលជាមនុស្សមិនល្អឥតខ្ចោះក្ដី លោកយេស៊ូ«បន្ដចុះចូលក្នុងឱវាទរបស់ពួកគាត់»ដោយចិត្ដរាបទាប ។ ( លូក .
ជាមនុស្សពេញវ័យ លោកយេស៊ូបានបង្ហាញចិត្ដរាបទាបដោយចាត់ទុកការធ្វើតាមបំណងប្រាថ្នារបស់ព្រះជាអ្វីដែលសំខាន់បំផុត មិនមែនបំណងប្រាថ្នារបស់លោកឡើយ ។ ( យ៉ូន .
៦: ៩ ) ដូច្នេះ លោកយេស៊ូបានណែនាំអ្នកកាន់តាមលោកឲ្យចាត់ទុកការធ្វើឲ្យនាមរបស់ព្រះយេ ហូវ៉ាបានបរិសុទ្ធជាអ្វីដែលសំខាន់បំផុត ។ លោកយេស៊ូផ្ទាល់ក៏បានរស់នៅតាមរបៀបនេះដែរ ។ នៅជិតចុងបញ្ចប់នៃកិច្ចបម្រើផ្សាយរបស់លោកយេស៊ូនៅផែនដី លោកអាចអធិដ្ឋានទៅព្រះយេ ហូវ៉ាថា៖«ខ្ញុំបានសម្ដែងឲ្យពួកគាត់ស្គាល់នាមរបស់លោក ក៏នឹងសម្ដែងឲ្យស្គាល់តទៅទៀត» ។ ( យ៉ូន .
១៧: ២៦ ) ម្យ៉ាងទៀត ក្នុងអំឡុងកិច្ចបម្រើផ្សាយរបស់លោក លោកយេស៊ូបានលើកកិ ត្ដិ យសព្រះយេ ហូវ៉ាចំពោះអ្វីដែលលោកបានសម្រេចនៅផែនដី ។ — យ៉ូន .
