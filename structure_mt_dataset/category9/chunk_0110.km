ពេលដែលបណ្ដាជនអ៊ីស្រាអែលមិនយកចិត្ដទុកដាក់នឹងការរំលឹករបស់ព្រះយេ ហូវ៉ា តើពួកគេទទួលលទ្ធផលអ្វី ?
៤: ១៣, ១៤ ) ដូចបានទាយទុកក្នុងគម្ពីរ ពេលដែលពួកគេមិនបានទុកចិត្ដលើការរំលឹករបស់ព្រះ ពួកគេទទួលបានលទ្ធផលដ៏ជូរចត់ ។ — លេ វី.
តើយើងអាចទាញមេរៀនពីគំរូរបស់បណ្ដាជនអ៊ីស្រាអែលយ៉ាងដូចម្ដេច ?
តើតាមរបៀបណាយើងអាចទទួលប្រយោជន៍ពីគំរូរបស់បណ្ដាជន អ៊ីស្រាអែល ?
ដូចបណ្ដាជនអ៊ីស្រាអែល រាស្ដ្ររបស់ព្រះនៅសព្វថ្ងៃនេះទទួលឱវាទនិងការប្រដៅតម្រង់ ។ ( ២ពេ.
១៤: ១២ ) សូមយើងពិចារណាអំពីមូលហេតុខ្លះដែលយើងអាចទុកចិត្ដលើការរំលឹករបស់ព្រះយេ ហូវ៉ា និងអំពីរបៀបដែលយើងទទួលប្រយោជន៍ពីការធ្វើតាមការរំលឹកទាំងនោះ ។
ពេលបណ្ដាជនអ៊ីស្រាអែលនៅទីរហោស្ថានឬតំបន់ស្ងាត់ជ្រងំ តើតាមរបៀបណាព្រះយេ ហូវ៉ាបានធ្វើឲ្យពួកគេជឿជាក់ថាលោកកំពុងគាំទ្រពួកគេ ?
តើព្រះយេ ហូវ៉ាកំពុងដឹកនាំរាស្ដ្ររបស់លោកនៅសព្វថ្ងៃនេះយ៉ាងដូចម្ដេច ?
អ្នកបម្រើព្រះសព្វថ្ងៃនេះហៀបនឹងចូលក្នុងពិភពលោកថ្មីដ៏សុចរិត ។ តើយើងទុកចិត្ដព្រះយេ ហូវ៉ាថាលោកនឹងផ្ដល់អ្វីដែលយើងត្រូវការដើម្បីរួចជីវិតនៅគ្រា«ទុក្ខវេទនាជាខ្លាំង»ដែលជិតមកដល់ឬទេ ?
១១៩ : ៤០, ៤១ ) ពិតមែនតែព្រះយេ ហូវ៉ាមិននាំយើងចូលក្នុងពិភពលោកថ្មីដោយប្រើបង្គោលពពកឬបង្គោលភ្លើងនោះទេ ប៉ុន្ដែលោកកំពុងប្រើអង្គការរបស់លោកដើម្បីជួយយើងឲ្យប្រុងប្រយ័ត្នជានិច្ច ។ ជាឧទាហរណ៍ យើងបានត្រូវលើកទឹកចិត្ដឲ្យពង្រឹងចំណងមិត្ដ ភាពរវាងយើងនិងព្រះយេ ហូវ៉ា ដោយអានគម្ពីរ ដោយគោរពប្រណិប័តន៍ជាក្រុមគ្រួសារ ព្រមទាំងចូលរួមកិច្ចប្រជុំនិងកិច្ចបម្រើផ្សាយជាទៀងទាត់ ។ តើយើងបានធ្វើការកែប្រែដើម្បីធ្វើតាមការណែនាំទាំងនេះឬទេ ?
តើព្រះយេ ហូវ៉ាបង្ហាញថាលោកយកចិត្ដទុកដាក់ចំពោះយើងតាមរបៀបណា ខ្លះ ?
១៣: ១-១៧ ) ការប្រព្រឹត្ដដោយចិត្ដរាបទាបបែបនេះបានធ្វើឲ្យពួកសាវ័កចាំក្នុងចិត្ដជារៀងរហូត ។ ប្រហែលជា៣០ឆ្នាំក្រោយមក សាវ័កពេត្រុសដែលបានមានវត្ដ មាននៅពិធីបរិភោគអាហារនោះ បានជូនឱវាទដល់បងប្អូនរួមជំនឿអំពីចិត្ដរាបទាប ។ ( ១ពេ.
តើលោកយេស៊ូបានរំលឹកពួកអ្នកកាន់តាមលោកអំពីការបណ្ដុះឲ្យមានគុណសម្បត្ដិដ៏សំខាន់ចាំបាច់អ្វី ?
ប្រធានបទមួយទៀតដែលលោកយេស៊ូច្រើនតែពិភាក្សាជាមួយពួកអ្នកកាន់តាមលោក គឺភាពចាំបាច់នៃការមានជំនឿរឹងមាំ ។ បន្ទាប់ពីពួកអ្នកកាន់តាមមិនអាចបណ្ដេញវិញ្ញាណកំណាចដែលចូលក្មេងប្រុសម្នាក់ ពួកគេបានសួរលោកយេស៊ូថា៖«ហេតុអ្វីយើងមិនអាចបណ្ដេញវាបាន ?»
។ លោកយេស៊ូបានឆ្លើយថា៖«គឺដោយសារអ្នករាល់គ្នាមានជំនឿតិច ។ ខ្ញុំប្រាប់អ្នករាល់គ្នាការពិតថា ប្រសិនបើអ្នកមានជំនឿប៉ុនគ្រាប់មូស្ តាត ...
នឹងគ្មានអ្វីដែលអ្នកធ្វើពុំកើតឡើយ» ។ ( ម៉ា ថ.
ឱកាសទាំងនេះមិនគ្រាន់តែជាការជួបជុំគ្នាដ៏សប្បាយរីករាយប៉ុណ្ណោះទេ តែជាឱកាសដើម្បីឲ្យយើងបង្ហាញទំនុកចិត្ដលើព្រះយេ ហូវ៉ា ។
ហេតុអ្វីជាការសំខាន់ដែលយើងអប់រំខ្លួនឲ្យមានសេចក្ដីស្រឡាញ់ដូចគ្រិស្ដនៅសព្វថ្ងៃនេះ ?
២២: ៣៩ ) ស្រដៀងគ្នាដែរ យ៉ាកុបដែលជាប្អូនប្រុសរបស់លោកយេស៊ូ បានហៅសេចក្ដីស្រឡាញ់ថាជា«ច្បាប់របស់ស្ដេច» ។ ( យ៉ា.
២: ៨ ) សាវ័កយ៉ូហានបានសរសេរថា៖«បងប្អូនជាទីស្រឡាញ់អើយ !
ខ្ញុំមិនមែនសរសេរបញ្ញ ត្ដិថ្មីមកឲ្យអ្នករាល់គ្នាទេ តែគឺជាបញ្ញ ត្ដិចាស់ដែលអ្នករាល់គ្នាបានទទួលពីដើមដំបូង» ។ ( ១យ៉ូន .
២: ៧, ៨ ) តើយ៉ូហានចង់សំដៅលើអ្វីពេលគាត់សរសេរថា៖«បញ្ញ ត្ដិចាស់»?
លោកយេស៊ូបានបង្ហាញការយកចិត្ដទុកដាក់យ៉ាងស្មោះចំពោះអ្នកឯទៀត ។ យើងអាចឃើញការយកចិត្ដទុកដាក់ដែលផុសចេញពីសេចក្ដីស្រឡាញ់របស់លោក ពេលលោកបានធ្វើឲ្យមនុស្សឈឺ មនុស្សពិការបានជាសះស្បើយ និងពេលលោកបានប្រោសមនុស្សស្លាប់ ឲ្យរស់ឡើងវិញ ។ ប៉ុន្ដែភារកិច្ចសំខាន់បំផុតដែលលោកយេស៊ូមកផែនដីមិនមែនគ្រាន់តែធ្វើឲ្យមនុស្សជាសះស្បើយខាងរូបកាយប៉ុណ្ណោះទេ ។ ការផ្សព្វផ្សាយនិងសេចក្ដីបង្រៀនរបស់លោកបានមានឥទ្ធិពលជាយូរអង្វែងលើជីវិតរបស់មនុស្ស ។ តើតាមរបៀបណា ?
ការផ្សព្វផ្សាយដែលលោកយេស៊ូបានចាប់ផ្ដើមនៅសតវត្សរ៍ទី១ គឺបានត្រូវធ្វើឡើងក្នុងកម្រិតធំជាងនៅសព្វថ្ងៃនេះ ។ លោកយេស៊ូបានបង្គាប់ពួកអ្នកកាន់តាមលោកថា៖«ដូច្នេះ ចូរទៅបង្រៀនមនុស្សគ្រប់ជាតិសាសន៍ឲ្យក្លាយទៅជាអ្នកកាន់តាមខ្ញុំ» ។ ( ម៉ា ថ.
តើប៉ូលនិងពេត្រុសបានជូនឱវាទអ្វីខ្លះ ?
ច្បាស់ណាស់ ការរំលឹកបានជួយគ្រិស្ដសាសនិកនៅសម័យដើមឲ្យរក្សាជំនឿមាំមួន ។ សូមស្រមៃគិតអំពីការលើកទឹកចិត្ដដែលធី ម៉ូថេច្បាស់ជាបានទទួលពីសាវ័កប៉ូលដែលកាលនោះជាអ្នកទោសនៅក្រុងរ៉ូម ដែលបានប្រាប់គាត់ថា៖«ចូរកាន់ខ្ជាប់គំរូនៃពាក្យដែលមានប្រយោជន៍ដែលអ្នកបានឮពីខ្ញុំ» ។ ( ២ធី .
១: ១៣ ) បន្ទាប់ពីបានលើកទឹកចិត្ដបងប្អូនរួមជំនឿឲ្យអប់រំខ្លួនឲ្យមានគុណសម្បត្ដិដូចជា ការស៊ូទ្រាំ ការរាប់អានគ្នាជាបងប្អូន និងការចេះទប់ចិត្ដ សាវ័កពេត្រុសបាននិយាយថា៖«ខ្ញុំប្រុងប្រៀបរំលឹកអ្នករាល់គ្នាអំពីការទាំងនេះជានិច្ច ទោះជាអ្នករាល់គ្នាដឹងការទាំងនេះ ហើយក៏បានតាំងខ្លួនមាំមួនក្នុងសេចក្ដីពិត» ។ — ២ពេ.
តើគ្រិស្ដសាសនិកនៅសតវត្សរ៍ទី១មានទស្សនៈយ៉ាងណាចំពោះការរំលឹក ?
សំបុត្រដែលប៉ូលនិងពេត្រុសបានសរសេរ បានបញ្ជាក់អំពី«អ្វីដែលពួកអ្នកប្រកាសទំនាយបរិសុទ្ធបានប្រាប់» ។ ( ២ពេ.
៣: ២ ) តើបងប្អូននៅសតវត្សរ៍ទី១បានខឹងពេលទទួលការណែនាំបែបនេះឬទេ ?
មិនមែនទេ ពីព្រោះការណែនាំនោះបង្ហាញអំពីសេចក្ដីស្រឡាញ់របស់ព្រះ ដែលបានជួយពួកគេឲ្យ«បន្ដទទួលគុណដ៏វិសេសលើសលប់និងចំណេះពីលោកយេស៊ូគ្រិស្ដ ដែលជាម្ចាស់និងជាអ្នកសង្គ្រោះ» ។ — ២ពេ.
ហេតុអ្វីយើងគួរទុកចិត្ដការរំលឹករបស់ព្រះយេ ហូវ៉ា ហើយតើការធ្វើដូច្នេះនាំឲ្យយើងទទួលប្រយោជន៍យ៉ាងដូចម្ដេច ?
២: ២, ៣ ) ស្ថានភាពពិភពលោកដែលកាន់តែអាក្រក់ទៅៗក៏បានសម្រេចទំនាយក្នុងគម្ពីរដែរ ។ ដូចបានរៀបរាប់នៅខាងលើ ការកើនឡើងនៃសកម្មភាពផ្សព្វផ្សាយនៅទូទាំងពិភពលោកគឺកំពុងសម្រេចយ៉ាងចំៗនូវពាក្យរបស់លោកយេស៊ូ ។ — ម៉ា ថ.
អ្វីដែលព្រះជាអ្នកបង្កើតរបស់យើងបានធ្វើនៅអតីតកាលធ្វើឲ្យយើងទុកចិត្ដលោក ។ តើយើងទទួលប្រយោជន៍ពីការរំលឹករបស់លោកឬទេ ?
ហេតុអ្វីយើងមានចិត្ដរីករាយចំពោះការរំលឹករបស់ព្រះយេ ហូវ៉ា ?
តើយើងអាចពង្រឹងទំនុកចិត្ដលើព្រះយេ ហូវ៉ាយ៉ាងដូចម្ដេច ?
ហេតុអ្វីជាការសំខាន់ដែលយើងត្រូវជាប់រវល់ជានិច្ចក្នុងកិច្ចការដែលទាក់ទងនឹងរាជាណាចក្រព្រះ?
តើយើងគួរធ្វើតាមចិត្ដគំនិតបែបណារបស់អ្នកតែងទំនុក ត ម្កើង ?
១១៩ : ១១១ ) ស្រដៀងគ្នាដែរ តើយើងមានចិត្ដរីករាយនឹងបញ្ញ ត្ដិរបស់ព្រះយេ ហូវ៉ា ឬជួនកាលយើងចាត់ទុកបញ្ញ ត្ដិទាំងនោះជាបន្ទុកធ្ងន់ទៅវិញ ?
ទោះជានៅពេលខ្លះយើងមានអារម្មណ៍ធុញទ្រាន់នឹងឱវាទខ្លះ ក៏ដោយ យើងមិនត្រូវធ្លាក់ទឹកចិត្ដទេ ។ យើងអាចអប់រំខ្លួនឲ្យទុកចិត្ដលើប្រាជ្ញាដ៏ខ្ពង់ខ្ពស់របស់ព្រះដោយមិនរង្គោះរង្គើ !
សូមយើងពិចារណារបៀបបីយ៉ាង ។
២៥: ១, ២ ) តើអ្វីបានជួយដាវីឌបណ្ដុះឲ្យមានទំនុកចិត្ដបែបនេះលើបិតារបស់គាត់ដែលនៅស្ថានសួគ៌ ?
តើបណ្ដាំរបស់ព្រះប្រាប់យើងយ៉ាងណា អំពីចំណងមិត្ដ ភាពដែលដាវីឌមានជាមួយព្រះយេ ហូវ៉ា ?
មនុស្សជាច្រើនអធិដ្ឋានទៅព្រះតែនៅពេលពួកគេជួបស្ថានភាពពិបាកប៉ុណ្ណោះ ។ ចុះយ៉ាងណាបើមិត្ដភក្ដិឬញាតិសន្ដានម្នាក់មកនិយាយជាមួយអ្នក តែពេលគាត់ត្រូវការលុយឬចង់ឲ្យអ្នកធ្វើអ្វីមួយសម្រាប់គាត់ប៉ុណ្ណោះ ?
សូមកត់សម្គាល់ពាក្យសរសើរនិងពាក្យថ្លែងអំណរគុណរបស់ដាវីឌចំពោះព្រះយេ ហូវ៉ា ដែលថា៖«ឱព្រះយេ ហូវ៉ា ជាព្រះអម្ចាស់នៃយើងខ្ញុំអើយ ព្រះនាមទ្រង់ប្រសើរគ្រប់លើផែនដីយ៉ាងណាទៅ ទ្រង់បានដំ កល់សិរីល្អទ្រង់ទុកនៅលើស្ថានសួគ៌ !»
៨: ១ ) តាមរយៈពាក្យរបស់ដាវីឌ តើអ្នកអាចប្រាប់ថា ដាវីឌមានចំណងមិត្ដ ភាពជិតស្និទ្ធយ៉ាងណាជាមួយបិតារបស់គាត់ដែលនៅស្ថានសួគ៌ ?
ចិត្ដអបអររបស់ដាវីឌចំពោះភាពឧត្ដុង្គ ឧត្ដមនិងភាពរុងរឿងរបស់ព្រះ ជំរុញគាត់ឲ្យលើកត ម្កើងព្រះយេ ហូវ៉ា«ជាដរាបរាល់ថ្ងៃ» ។ — ទំនុក .
តើតាមរបៀបណាយើងអាចទទួលប្រយោជន៍ដោយចូលទៅជិតព្រះតាមរយៈសេចក្ដីអធិដ្ឋាន ?
ដូចដាវីឌដែរ យើងត្រូវប្រាស្រ័យទាក់ទងជាមួយនឹងព្រះយេ ហូវ៉ាជាទៀងទាត់ដើម្បីពង្រឹងទំនុកចិត្ដរបស់យើងលើលោក ។ គម្ពីរចែងថា៖«ចូរចូលទៅជិតព្រះ ហើយលោកនឹងចូលមកជិតអ្នករាល់គ្នាដែរ» ។ ( យ៉ា.
៤: ៨ ) ការចូលទៅជិតព្រះតាមរយៈសេចក្ដីអធិដ្ឋានក៏ជារបៀបសំខាន់មួយដែរដើម្បីទទួលសកម្ម ពលបរិសុទ្ធ ។ — សូមអាន យ៉ូហាន ទី១ ៣: ២២
ហេតុអ្វីយើងគួរជៀសវាងការនិយាយពាក្យដដែលៗក្នុងសេចក្ដីអធិដ្ឋាន ?
ពេលអ្នកអធិដ្ឋាន តើអ្នកចូលចិត្ដពោលពាក្យ ឬប្រើពាក្យដដែលៗឬទេ ?
បើដូច្នេះ មុននឹងអធិដ្ឋានទៅព្រះ សូមចំណាយពេលបន្ដិចដើម្បីគិតអំពីអ្វីដែលអ្នកចង់និយាយ ។ ប្រសិនបើយើងនិយាយពាក្យដដែលៗទៅមិត្ដភក្ដិឬញាតិសន្ដានរាល់ពេលដែលយើងនិយាយជាមួយគាត់ តើគាត់សប្បាយចិត្ដឬទេ ?
បណ្ដាំរបស់ព្រះចែងថា៖«ដោយអធិដ្ឋាន អង្វរសុំ ព្រមទាំងថ្លែងអំណរគុណ ចូរជម្រាបព្រះអំពីសំណូមពររបស់អ្នករាល់គ្នា ក្នុងគ្រប់ការទាំងអស់» ។ ( ភី.
៤: ៦ ) តាមការពិត អ្វីក៏ដោយដែលមានឥទ្ធិពលលើចំណងមិត្ដ ភាពរវាងយើងនិងព្រះ ឬលើជីវិតរបស់យើងដែលជាអ្នកបម្រើលោក ជាអ្វីសមរម្យដែលយើងអាចអធិដ្ឋាន ។
ជាការល្អដែលយើងពិចារណាពាក្យសម្ដីក្នុងសេចក្ដីអធិដ្ឋានរបស់បុរសស្ដ្រីស្មោះត្រង់ដែលបានកត់ទុកក្នុងគម្ពីរ ។ ( ១សាំ .
ហេតុអ្វីយើងត្រូវរំពឹងគិតអំពីការដាស់តឿនពីព្រះ?
ដាវីឌបានប្រកាសថា៖«សេចក្ដីបន្ទាល់ នៃព្រះយេ ហូវ៉ាជាពិត ក៏ធ្វើឲ្យមនុស្សខ្លៅល្ងង់មានប្រាជ្ញា» ។ ( ទំនុក .
តើការរំពឹងគិតអំពីអ្វីអាចជួយយើងឲ្យរក្សាទុកសេចក្ដីរំលឹករបស់ព្រះ?
កាលដែលយើងទន្ទឹងរង់ចាំសេចក្ដីសន្យារបស់ព្រះក្លាយជាការពិត តើយើងបង្ហាញថាជំនឿរបស់យើងទៅលើសេចក្ដីសន្យាទាំងនោះនៅតែរឹងមាំ ហើយថាបំណងប្រាថ្នារបស់ព្រះនៅតែជាអ្វីដែលសំខាន់បំផុតក្នុងជីវិតរបស់យើងឬទេ ?
ជាឧទាហរណ៍ តើយើងពិតជាជឿថាបា ប៊ី ឡូនដ៏ខ្លាំងក្លានឹងត្រូវបំផ្លាញចោលនាពេលបន្ដិចទៀតនេះឬទេ ?
តើពរដែលយើងនឹងទទួលនាពេលអនាគត ដូចជាជីវិតដែលគ្មានទីបញ្ចប់ក្នុងសួនឧទ្យាននៅលើផែនដីគឺពិតប្រាកដចំពោះយើងដូចពេលដែលយើងចាប់ផ្ដើមរៀនគម្ពីរដំបូងឬទេ ?
តើយើងនៅតែបន្ដខ្នះ ខ្នែងក្នុងកិច្ចផ្សព្វផ្សាយ ជាជាងចាត់ទុករឿងផ្ទាល់ខ្លួនរបស់យើងជាអ្វីដែលសំខាន់បំផុតក្នុងជីវិតរបស់យើងឬទេ ?
ចុះយ៉ាងណាសេចក្ដីសង្ឃឹមចំពោះការប្រោសឲ្យរស់ឡើងវិញ ការធ្វើឲ្យនាមរបស់ព្រះបានបរិសុទ្ធ និងការបង្ហាញថាព្រះមានសិទ្ធិគ្រប់គ្រងវិញ ?
តើរឿងទាំងនេះនៅតែជារឿងសំខាន់សម្រាប់យើងឬទេ ?
ការរំពឹងគិតអំពីរឿងទាំងនេះប្រហែលជាអាចជួយយើងឲ្យធ្វើដូចអ្នកតែងទំនុក ត ម្កើងដែលនិយាយថា ចូររក្សា«សេចក្ដីបន្ទាល់ទ្រង់ទុកជាមរដកនៅជាដរាប» ។ — ទំនុក .
១៣. ហេតុអ្វីគ្រិស្ដសាសនិកនៅសតវត្សរ៍ទី១ពិបាកយល់អំពីរឿងខ្លះ ?
នៅដើមសតវត្សរ៍ទី២០ ទោះជាបងប្អូនជាច្រើននាក់មានការយល់ច្រឡំអំពីគ្រាចុងក្រោយបង្អស់ក៏ដោយ តើពួកគាត់បានទុកគំរូល្អអ្វីខ្លះ ?
ស្រដៀងគ្នាដែរ នៅដើមសតវត្សរ៍ទី២០ គ្រិស្ដសាសនិកពិតមួយចំនួនបានសង្ឃឹមខុសអំពី«គ្រាចុងក្រោយបង្អស់» ។ ( ២ធី .
១៣: ១០ ) ដូច្នេះនៅឆ្នាំ១៩២២ បងប្រុសយ៉ូសែប រ៉ូ ធើ ហ្វឺ ត ដែលកាលនោះជាអ្នកនាំមុខកិច្ចការផ្សព្វផ្សាយ បានប្រាប់ពួកអ្នកដែលបានមកចូលរួមមហាសន្និបាតអន្ដរ ជាតិនៅក្រុងស៊ី ដឺ ផូញ រដ្ឋអូ ហៃ យ៉ូ សហរដ្ឋ អាម៉េរិក ថា៖«មើល !
ស្ដេចគ្រប់គ្រងហើយ !
អ្នករាល់គ្នាជាអ្នកផ្សព្វផ្សាយអំពីរាជាណាចក្ររបស់លោក ។ ដូច្នេះ ចូរផ្សាយ ចូរផ្សាយ ចូរផ្សាយអំពីស្ដេចនិងរាជាណាចក្ររបស់លោក» ។ តាំងពីពេលនោះមក ការប្រកាស«ដំណឹងល្អអំពីរាជាណាចក្រ»បានទៅជាសញ្ញាសម្គាល់របស់អ្នកបម្រើព្រះយេ ហូវ៉ានៅសម័យនេះ ។ — ម៉ា ថ.
តើយើងទទួលពរអ្វីខ្លះ ដែលមកពីការនៅតែសកម្មជានិច្ចក្នុងកិច្ចបម្រើផ្សាយ ?
។ គាត់បានបន្ថែមថា៖«ព្រះហស្ដទ្រង់មានឫទ្ធិខ្លាំង ព្រះហស្ដស្ដាំទ្រង់ក៏ខ្ពស់ណាស់» ។ ( ទំនុក .
៣១ : ២៧ ) ដោយយកត ម្រាប់ព្រះដែលជាអ្នកបង្កើតរបស់យើង ចូរយើងជាប់រវល់ក្នុងកិច្ចការដែលទាក់ទងនឹងកិច្ចបម្រើព្រះ ។ ការបម្រើព្រះដោយអស់ ពីចិត្ដ នាំឲ្យយើងទទួលរង្វាន់ ហើយធ្វើឲ្យព្រះយេ ហូវ៉ាមានចិត្ដរីករាយយ៉ាងខ្លាំងក្នុងការផ្ដល់ពរមកលើកិច្ចបម្រើផ្សាយរបស់យើង ។ — សូមអាន ទំនុក ត ម្កើង ៦២ : ១២
ហេតុអ្វីយើងអាចនិយាយថាការប្រព្រឹត្ដដោយជំនឿអាចជួយយើងឲ្យពង្រឹងទំនុកចិត្ដលើឱវាទរបស់ព្រះយេ ហូវ៉ា ?
តើតាមរបៀបណាការប្រព្រឹត្ដដោយជំនឿ ជួយយើងឲ្យពង្រឹង ទំនុកចិត្ដលើព្រះយេ ហូវ៉ា ?
កំណត់ហេតុចែងថា៖«កាលណាបាតជើងរបស់ពួកសង្ឃ ដែលសែងហឹបផងព្រះយេ ហូវ៉ា ...
បានដាក់ចុះទៅក្នុងទឹកទន្លេយ័រ ដាន់ហើយ នោះទឹកទន្លេនឹងត្រូវកាត់ផ្ដាច់ ...
រួចពួកបណ្ដាជនគេឆ្លងដំរង់ចំទៅឯក្រុងយេ រី ខូ ឯពួកសង្ឃដែលសែងហឹបនៃសេចក្ដីសញ្ញាផងព្រះយេ ហូវ៉ា គេក៏ឈរនឹង នៅដីស្ងួតនាបាតទន្លេយ័រ ដាន់ ហើយសាសន៍អ៊ីស្រាអែលទាំងអស់គ្នា ក៏ឆ្លងទៅនៅដីស្ងួតដែរ» ។ ( យ៉ូស .
៣: ១២-១៧ ) សូមស្រមៃគិតថាបណ្ដាជនអ៊ីស្រាអែលច្បាស់ជាទទួលការលើកទឹកចិត្ដយ៉ាងណា នៅពេលដែលពួកគេឃើញទឹកទន្លេដែលកំពុងតែហូរខ្លាំងបានឈប់ហូរភ្លាម !
ខ្ញុំនៅជាមួយនឹងអ្នករាល់គ្នាជារៀងរាល់ថ្ងៃ រហូតដល់គ្រាចុងបញ្ចប់នៃរបៀបរបបពិភពលោកនេះ» ។ ( ម៉ា ថ.
២៨: ១៩, ២០ ) សាក្សីជាច្រើននាក់ដែលប្រហែលជាធ្លាប់មានអារម្មណ៍ខ្មាសអៀនអាចបញ្ជាក់ថា សកម្ម ពលបរិសុទ្ធរបស់ព្រះបានជួយពួកគេឲ្យមានចិត្ដក្លាហានដើម្បីផ្សព្វផ្សាយដល់មនុស្សដែលពួកគេពុំធ្លាប់ស្គាល់ ពេលពួកគេបំពេញកិច្ចបម្រើផ្សាយ ។ — សូមអាន ទំនុក ត ម្កើង ១១៩ : ៤៦; កូរិន ថូស ទី២ ៤: ៧
១: ៣ ) លោកឲ្យតម្លៃចំពោះអ្វីទាំងអស់ដែលយើងធ្វើដើម្បីជួយគាំទ្រកិច្ចការដែលទាក់ទងនឹងរាជាណាចក្រព្រះ ។ កាលដែលយើងធ្វើអ្វីៗទាំងអស់ដែលយើងអាចធ្វើបាន យើងទាំងអស់គ្នាត្រូវចាំក្នុងចិត្ដថា សំខាន់បំផុតគឺជំនឿលើការផ្ដល់ថ្លៃលោះរបស់គ្រិស្ដដែលរក្សាជីវិតរបស់យើង ។ — ហេ.
តើយើងអាចបង្ហាញទំនុកចិត្ដលើព្រះយេ ហូវ៉ាតាមរបៀបណា ខ្លះ ?
ការគោរពប្រណិប័តន៍របស់យើងតម្រូវឲ្យចំណាយពេលវេលា កម្លាំង និងទ្រព្យសម្បត្ដិ តាមដែលយើងអាចធ្វើទៅបាន ។ មែនហើយ យើងចង់ធ្វើអស់ ពីចិត្ដរបស់យើងដើម្បី«បំពេញកិច្ចការជាអ្នកផ្សព្វផ្សាយដំណឹងល្អ» ។ ( ២ធី .
៤: ៥ ) តាមការពិត យើងសប្បាយចិត្ដធ្វើដូច្នេះ កាលដែលយើងជួយអ្នកឯទៀតឲ្យ«មានចំណេះត្រឹមត្រូវអំពីសេចក្ដីពិត» ។ ( ១ធី .
២: ៤ ) ច្បាស់ណាស់ ការលើកកិ ត្ដិ យសនិងការសរសើរព្រះយេ ហូវ៉ា ធ្វើឲ្យយើងមានចំណងមិត្ដ ភាពកាន់តែរឹងមាំជាមួយលោក ។ ( សុភ.
ហេតុអ្វីគ្រិស្ដសាសនិកទាំងអស់ត្រូវយកចិត្ដទុកដាក់ចំពោះការកែប្រែទាំងស្រុង ?
តើការកែប្រែទាំងស្រុងអ្វី ដែលគ្រិស្ដសាសនិកម្នាក់ៗត្រូវធ្វើ ?
តើយើងអាចទទួលជោគជ័យក្នុងការកែប្រែទាំងស្រុងដ៏សំខាន់ចាំបាច់នេះយ៉ាងដូចម្ដេច ?
