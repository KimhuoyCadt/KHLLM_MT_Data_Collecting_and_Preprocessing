កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ រវាង កម្ពុជា និង សាធារណរដ្ឋ ឆេក នឹង ឆ្លងកាត់ គ្រប់ វិស័យ រួមទាំង វិស័យ សុខាភិបាល កសិកម្ម វិស័យ ការពារ ជាតិ អាកាសចរណ៍ បរិស្ថាន ទឹក ស្អាត ស្ថានីយ៍ ប្រព្រឹត្តិកម្ម ប្រព័ន្ធ លូ និង ទេសចរណ៍ ធម្មជាតិ ។
លោក សុខុន បាន មានប្រសាសន៍ ថា ប្រទេស កម្ពុជា បាន លើកឡើង ពី វិស័យ អាទិភាព ដែល មាន សក្តានុពល សម្រាប់ ការវិនិយោគ ផ្ទាល់ ពី បរទេស (FDI) និង បាន ផ្តល់ ការគាំទ្រ ដល់ សាធារណរដ្ឋ ឆេក ក្នុង ការបង្កើត មន្ទីរពេទ្យ នៅក្នុង ព្រះរាជាណាចក្រ ។
លោក បាន លើកទឹកចិត្ត សមភាគី ឆេក ឱ្យ ពិនិត្យមើល ការសាងសង់ បណ្តាញ ថាមពល ពី ឡាវ មក កម្ពុជា បន្ទាប់ពី ព្រះរាជាណាចក្រ បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ទិញ អគ្គិសនី 2.900 មេហ្គាវ៉ាត់ ពី ប្រទេស ឡាវ ដើម្បី បំពេញ ចន្លោះ ដែល ជួបប្រទះ នា ពេល ថ្មី ៗ នេះ ។ លោក ក៏ បាន ជំរុញ ឱ្យ ទីក្រុង Prague វិនិយោគ លើ ថាមពល កកើត ឡើងវិញ ផងដែរ ។
រដ្ឋមន្ត្រី ការបរទេស ក៏ បាន និយាយ អំពី ចំណាប់អារម្មណ៍ របស់ ឆេក ក្នុង វិស័យ កសិកម្ម និង ទេសចរណ៍ ។
លោក សុខុន មានប្រសាសន៍ ថា កិច្ចសហប្រតិបត្តិការ ថ្មី នេះ ជាមួយ សាធារណរដ្ឋ ឆេក នឹង នាំមក នូវ សក្ដានុពល ថ្មី សម្រាប់ ការអភិវឌ្ឍន៍ នៅ កម្ពុជា ។
លោក សុខុន បាន មានប្រសាសន៍ ថា ទីក្រុង ប្រាក និង ទីក្រុង ភ្នំពេញ មាន ទំនាក់ទំនង ជិតស្និទ្ធ តាំងពី ទសវត្សរ៍ ឆ្នាំ 1950 ហើយ លោក បាន ថ្លែងអំណរគុណ ចំពោះ សាធារណរដ្ឋ ឆេក ដែល បាន កែប្រែ បំណុល ដែល កម្ពុជា ជំពាក់ នោះ ទៅជា ជំនួយ អភិវឌ្ឍន៍ ។ លោក ថា នេះ ជា គំរូល្អ សម្រាប់ ប្រទេស ផ្សេង ទៀត យក តាម ។
លោក គិន ភា នាយក វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន មានប្រសាសន៍ ថា ទោះបីជា ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវបាន សហភាព អឺរ៉ុប ចោទប្រកាន់ ថា បាន រំលោភ សិទ្ធិ មនុស្ស ក៏ដោយ ក៏ ទំនាក់ទំនងជាមួយ សាធារណរដ្ឋ ឆេក នៅតែ មាន ភាព កក់ក្តៅ ។
សាធារណរដ្ឋ ឆេក គឺជា ផ្នែក មួយ នៃ ប្រទេស ឆេកូ ស្លូវ៉ាគី រហូតដល់ វា ត្រូវបាន រំលាយ ដោយ សន្តិភាព ក្នុង ឆ្នាំ 1993 ចូល ទៅក្នុង សាធារណរដ្ឋ ឆេក និង ស្លូវ៉ាគី ។
គណៈកម្មាធិការ ជាតិ ទន្លេ មេគង្គ កម្ពុជា (CNMC) បាន ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ អាស៊ី - អឺរ៉ុប លើក ទី៨ (Asem) ស្តីពី កិច្ចសន្ទនា អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ដែល បាន បញ្ចប់ កាលពី សប្តាហ៍ មុន នៅ ខេត្ត សៀមរាប ។ អនុសាសន៍ ជាច្រើន ត្រូវបាន ធ្វើឡើង ដើម្បី បង្កើន ភាព ជាដៃគូ ផ្នែក ទឹក រវាង អាង ទន្លេ មេគង្គ និង បណ្តា ប្រទេស អឺរ៉ុប ។
