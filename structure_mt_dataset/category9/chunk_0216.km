អ្នកនាំពាក្យ សាលា ខេត្ត ឧត្តរមានជ័យ លោក ជា ពិសិដ្ឋ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ជំនន់ ទឹកភ្លៀង បាន និង កំពុង កើតឡើង ម្តង ទៀត នៅក្នុង ស្រុក បន្ទាយ អំពិល និង ស្រុក អន្លង់ វែង ប៉ុន្តែ វា មិន ទាន់ ប៉ះពាល់ ដល់ ដំណាំ ស្រូវ របស់ ពួកគាត់ នៅឡើយ ទេ ។ លោក បាន បន្ត ថា៖ ប៉ុន្តែ វា អាច ប៉ះពាល់ ដល់ ដំឡូង មី ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន នឹង ចាប់ផ្តើម ដំណើរទស្សនកិច្ច ផ្លូវការ រយៈពេល ពីរ ថ្ងៃ នៅ សាធារណរដ្ឋ ឆេក ក្នុង ខែតុលា ដោយ ប្រទេស ទាំង ពីរ រំពឹង ថា នឹង ឯកភាព គ្នា លើ វិស័យ ជាច្រើន នៃ កិច្ចសហប្រតិបត្តិការ ។
ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន និយាយ កាលពី ថ្ងៃចន្ទ ថា លោក ហ៊ុន សែន នឹង ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ទៅកាន់ ទីក្រុង ប្រាក ចាប់ពី ថ្ងៃទី ១៣ - ១៤ ខែតុលា ដើម្បី ពង្រឹង ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ជាមួយនឹង គម្រោង រួម ជាច្រើន នឹង ត្រូវ ចុះហត្ថលេខា ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស កម្ពុជា លោក កេត សោ ផាន់ បាន និយាយ នៅ ថ្ងៃចន្ទ នេះ ថា ក្រសួង ការបរទេស កំពុង ស្ថិត ក្នុង ដំណើរការ រៀបចំ ដំណើរទស្សនកិច្ច ផ្លូវការ នេះ ហើយ ព័ត៌មាន លម្អិត មិន ទាន់ ត្រូវបាន បញ្ចប់ នៅឡើយ ទេ ។
