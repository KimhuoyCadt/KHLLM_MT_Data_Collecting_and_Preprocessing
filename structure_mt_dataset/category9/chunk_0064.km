ចែករំលែក ហើយក្នុងករណីនោះ វាជាការពិតសម្រាប់គ្រប់ស្ថានភាពរបស់ភរិយា ។
“ គិតពីគេឲ្យខ្ពស់ដោយសេចក្ដី ស្រឡាញ់ព្រោះ តែការងាររបស់គេ ។
វា មិន គាំទ្រ កម្មវិធី រុករក បណ្ដាញ ទេ ។
ជំរុំនិងផ្នូរស្រដៀងគ្នានេះត្រូវបានរកឃើញនៅដើមខែនេះនៅខាងព្រំដែនថៃ ។
ផលិតផល សម្រាប់ វា ។
« អស់អ្នកដែលពាល់គាត់បានជាហើយ » ។
ប៉ុន្តែខ្ញុំស្គាល់ទ្រង់ ហើយ កាន់តាមព្រះបន្ទូលទ្រង់ ។
ស្រលាញ់ គ្នា បាន ៦ខែ ។
នៅ ទីនេះ ពួកគេ ជាច្រើន មាន ប្រាំមួយ និង
សាធារណរដ្ឋ ប្រជាធិបតេយ្យ កុងហ្គោ * កូស្តារី កា*
យើងគឺជាកម្មវិធីសាកល្បងព្យាបាលសហគមន៍ធំបំផុតក្នុងរដ្ឋ » ។
ខ្ញុំ ទន្ទឹងរង់ចាំ ទទួល អ៊ីមែល ។
ស្ត្រី គឺជា អ្នក ខាងក្រៅ នៅក្នុង ការរៀបចំ នេះ ។
ឥឡូវនេះនាងស្ថិតក្នុងកន្លែងជ្រកកោនហើយ » ។
ជំហាន គឺជា អំណាច នៃ ទំនុកចិត្ត ។
« ខ្ញុំប្រាប់អ្នក ជាប្រាកដថា ខ្ញុំ ជាទ្វារសម្រាប់ចៀម ។
នៅជិត ផ្សារ ដូហ្វីន ។
អ្នក ផ្សេង ទៀត ត្រូវ ធ្វើ
« ខ្ញុំមានទំនុក ចិត្តលើព្រះ អម្ចាស់ថា អ្នកនឹងមិនមានទស្សនៈផ្សេងទៀតឡើយ ហើយអ្នក ណាដែលធ្វើឲ្យអ្នកមានទុក្ខព្រួយនឹងទទួល ទោស ទោះជាអ្នក ណាក៏ដោយ ។
ប៉ុន្តែខ្ញុំបានរកឃើញថាវាផ្តោតខ្លាំងលើការ ជិះដែលខ្ញុំមិនធ្វើ ។
បទគម្ពីរគំរូ៖ « នេះហើយជាព្រះស្រឡាញ់លោកីយ៍យ៉ាង ណា ទ្រង់បានប្រទានព្រះរាជ បុត្រាទ្រង់ ជាព្រះរាជ បុត្រា តែមួយរបស់ទ្រង់ ។
៥ ដែលត្រូវបានរក្សាទុកដោយព្រះចេស្ដានៃព្រះ តាម រយៈសេចក្ដី ជំនឿដល់សេចក្ដីសង្គ្រោះ ដែលត្រៀមនឹងបើកសម្ដែងនៅ គ្រាចុងក្រោយ បង្អស់ ។
អ្នកដែលមាន ចិត្តបរិសុទ្ធ មាន ពរហើយ ដ្បិតគេនឹងឃើញព្រះ។
ចំណុច សំខាន់ គឺ អ្នក អាច ផ្លាស់ប្តូរ វា ប្រសិនបើ អ្នក ចង់បាន ។
ការពិត លេចចេញ ក្នុង ទម្រង់ ជាច្រើន នៅតែ ជា ការពិត ។
ពេលខ្ញុំមើលទៅពួកគេ ខ្ញុំនឹកឃើញពីទំនួលខុសត្រូវរបស់ខ្ញុំក្នុងនាមជាគ្រូ គង្វាល ។
ឆ្ងាយ ពី ទីប្រជុំជន ផ្លូវ មាន ផ្លាក សញ្ញា ល្អ ណាស់ ។
នំ សាំង វិច ការ៉េម ល្អ បំផុត នៅក្នុង ទីក្រុង ។
វា ជា ការខកចិត្ត ពិតប្រាកដ សម្រាប់ រយៈពេល 2 ឆ្នាំ ចុងក្រោយ នេះ ។
បី នៅក្នុង ពិភពលោក ទាំងមូល ។
ដើម្បី មើល ថា តើ ខ្ញុំ អាច បង្កើត ជីវិត បែប មនោសញ្ចេតនា ។
នៅ ពេលណា ដែល មុខ ទ្រូង ដៃ និង ជើង របស់ អ្នក ត្រូវបាន លាតត្រដាង អ្នក ត្រូវ លាប ឡេ ការពារ កម្តៅ ថ្ងៃ ។
ដែល យើង តែងតែ អាច ធ្វើ បាន កាន់តែ ប្រសើរ ។
បី នៅក្នុង ពិភពលោក ទាំងមូល ។
ពេលវេលា ផ្សេង ៗ គ្នា ) ដែល អ្នកនិពន្ធ នៃ បុណ្យ ណូអែល
“ មន្ត្រី ប៉ូលីស នៅក្នុង ប្រទេស នេះ គាំទ្រ យើង ។
ខ្ញុំតែងតែនិយាយទៅ កាន់គាត់ថាអ្នកសំណាងហើយដែលអ្នកគួរឱ្យស្រឡាញ់។ ការពិត គឺ ។
នៅថ្ងៃនោះនឹងមាន សម្រែកយ៉ាងខ្លាំងពីមាត់ទ្វារត្រី ជាសំឡេងបន្លឺចេញពីផ្នែកទីពីរនៃទីក្រុង ហើយនឹងមានសំឡេងធ្លាក់ខ្លាំងពីលើភ្នំ » ។
ឥឡូវនេះ ពួកគេ រក លុយ បាន ដោយសារ ការបរាជ័យ ក្នុង ការស្តារ នីតិសម្បទា ។
នេះធ្វើឱ្យវាជាឆ្នាំទី 28 ដែលពួកគេទាំងពីរទទួលបានកិត្តិយសនោះ ។
“ ខ្ញុំមិនមានការ មើលឃើញពីស្ថានភាពរបស់គាត់ទេ ប៉ុន្តែគាត់នៅកន្លែងមួយដែលមិនឆ្ងាយពីយើងពេក ។
ខ្ញុំនឹងដាក់គាត់ឲ្យដូចជាបង្គោលក្នុងកន្លែងសុវត្ថិភាព ។ គាត់ នឹង ក្លាយជា បល្ល័ង្ក នៃ កិត្តិយស ដល់ គ្រួសារ ឪពុក របស់ គាត់ ។
សូម អរគុណ ចំពោះ ការទាក់ទង មក នាយកដ្ឋាន យុត្តិធម៌ និង អគ្គ ព្រះរាជអាជ្ញា
នៅ ពេល ដែល ផ្នែក ត្រូវបាន ប្រមូលផ្តុំ ។
ទាក់ទង គាត់ ទៅ៖
ខ្ញុំចូល ចិត្តទស្សនិកជននៅទី នោះ » ។
ដូច្នេះខ្ញុំអាចរៀន បញ្ជារបស់អ្នក ។
កើត ក្នុង គ្រួសារ អ្នកកាត់ដេរ សាសនា ។
ការហោះ ហើរ មកកម្ពុជាត្រូវបាន ពន្យារពេលបន្តិច ។
ក្រុមប្រឹក្សា បាន ផ្តល់ឱ្យ វា ទៅ មហាវិទ្យាល័យ ។
គ្រប់ ប្រភេទ ដែល ភ្ជាប់ ទៅនឹង សេវាកម្ម របស់ ឪពុក គាត់ ។
៤៣ ខ្ញុំបានមកក្នុងព្រះនាមព្រះបិតារបស់ខ្ញុំ ប៉ុន្តែអ្នក រាល់គ្នាមិនទទួលខ្ញុំទេ ។
ប្រសិនបើវាត្រូវនឹងឈ្មោះរបស់វា ខ្ញុំនឹងចាកចេញភ្លាម ៗ ។
នាងនិយាយដោយមោទនភាព ថា " នោះជាកូនរបស់ខ្ញុំ !"
. . . នឹងមិនមានស្រីសំផឹងរបស់កូនស្រីអ៊ីស្រា ‌ អែល ឬកូនចៅអ៊ីស្រា ‌ អែលទេ ។
គាត់ លេង ដូចជា គាត់ ខឹង នឹង ពិភពលោក ។
វាជាការ ហ៊ាននិងហៅ » ។
ពេលខ្ញុំសួរថាប៉ុន្មាន គាត់និយាយពិត ៦ ខែ ។
អ្នកនឹងទុកចោលការសន្យាទទេរបស់ពិភពលោក ហើយផ្តល់ពេលវេលាពេញមួយជីវិតដើម្បីស្វែង រករបស់ល្អពីព្រះ។
9 ទោះជាយ៉ាង ណា ដោយយោង ទៅលើសេចក្ដី ស្រឡាញ់ជាបងប្អូន អ្នកមិនត្រូវការ ឲ្យយើងសរសេរអំពីអ្នកឡើយ ដ្បិតអ្នក រាល់គ្នាត្រូវបានព្រះបង្រៀនឲ្យស្រឡាញ់គ្នាទៅវិញទៅ មក ។ ១០ ហើយតាមពិត អ្នកកំពុង តែធ្វើវាចំពោះបងប្អូនទាំងអស់នៅស្រុក ម៉ា សេដូនទាំងមូល ។
ហើយខ្ញុំបានឃើញទេវតាទាំងប្រាំពីរអង្គដែលឈរនៅចំពោះព្រះ ហើយបានប្រទាន ត្រែប្រាំពីរដល់ពួកគេ » ( វិវរណៈ ៨:១ - ២) ។
សូមមើល អ្វី ដែល យើង បាន រកឃើញ សម្រាប់ ភាពអស់ កល្ប ចុងក្រោយ របស់ អ្នក !
ទាំង នេះ ក៏ អាច ចូល ប្រើ បាន យ៉ាង អស្ចារ្យ នៅលើ អ៊ីនធឺណិត ផងដែរ ។
« ខ្ញុំ បាន ពិភាក្សា អំពី ភាពផ្ទុយ គ្នា នៃ ព្រះគម្ពីរ ។
មុនថ្ងៃបុណ្យនៃសេចក្តី ស្រឡាញ់ គាត់បានចេញមករកខ្ញុំជាភេទដូចគ្នា ។
នោះល្អជាងមិនធ្វើអ្វីសោះ » ។
ប៉ុន្តែ មនុស្ស ភាគ ច្រើន មិន ចាំបាច់ ចំណាយ ប្រាក់ ប៉ុន្មាន ទេ ។
នាង ចង់ ក្លាយជា ផ្នែក មួយ នៃ ថ្ងៃ ។
