22 ខ្ញុំមិនបានឃើញព្រះវិហារបរិសុទ្ធនៅក្នុងទីក្រុងទេ ពីព្រោះព្រះ‌ អម្ចាស់ដ៏មានឫទ្ធា ‌នុភាព និងព្រះ‌ អម្ចាស់
ណា តាសាមើល មក ខ្ញុំ ។
អូ ខ្ញុំ បាន ព្យាយាម យ៉ាង ខ្លាំង ដើម្បី ធ្វើជា មិត្ត របស់ គាត់ ហើយ ប្រហែលជា ថ្ងៃ ណាមួយ វា នឹង កើតឡើង ” ។
អ្នកខ្លះអាចនិយាយថាគាត់គ្រាន់ តែជា ឆ្មាប៉ុណ្ណោះ ប៉ុន្តែសម្រាប់ខ្ញុំគាត់ជាកូនរបស់ខ្ញុំ ។
យើងបានផ្លាស់ទៅឆ្នេរសមុទ្រប្រហែល ៤ ឆ្នាំមុន » ។
ពេលយើងមានរឿងល្អកើតឡើងក្នុងជីវិត យើងប្រហែលជាចង់ចែករំលែក វាជាមួយគ្រួសារទាំងមូល ឬមិត្តភ័ក្ដិរបស់យើង ។
តើតាមពិតទៅ តើពួកគេអាចទប់ទល់នឹង ភាពសម្បូរសប្បាយខាងលោកិយបានយ៉ាង ណា ?
នឹង វិនិច្ឆ័យ អាថ៌កំបាំង របស់ មនុស្ស ទាំងអស់ ។
ឪពុក ម្តាយ របស់ គាត់ ជា ជន អន្តោប្រវេសន៍ ហ្វីលីពីន ប៉ុន្តែ គាត់ បាន កើត និង ធំធាត់ នៅ ទីនោះ ។
ម៉្យាង វិញ ទៀត គឺ ដោយសារតែ គ្រោះថ្នាក់ លាក់ កំបាំង នៃ សាកសព ទាំង ពីរ ។
យក អ្វី ដែល អ្នក ចង់បាន ពី អ្វី ដែល ពួកគេ និយាយ ហើយ អនុវត្ត វា ទៅក្នុង ជីវិត របស់ អ្នក និង អ្វី ដែល មាន ប្រយោជន៍ សម្រាប់ អ្នក ប៉ុន្តែ មេរៀន បាន មក នៅក្នុង ការស្តាប់ ។
សូម មើល អត្ថបទ វិគី ភីឌា ស្តីពី គ្មាន តម្រុយ ។
ចាំខ្ញុំត្រូវបានកោះហៅ ?
បញ្ចុះបញ្ចូលពួកគេថា គាត់ត្រូវបានគេបោះ បង់ឱ្យធ្វើ តាមបំណងប្រាថ្នារបស់ពួកគេ។
ក្នុង ករណី ផ្សេង ទៀត អ្នក អាច " ជ្រើសរើស ចូល " បញ្ជី ចែកចាយ ព័ត៌មាន ក្នុង ស្រុក មួយចំនួន ។
វាជាការ បង្គាប់ឲ្យគោរព !
ចូរ និយាយ ថា កូនស្រី របស់ អ្នក ជា ម៉ូដែល ខោ
បន្ទាប់មក ពួកគេ បាន រលាយ ចូល ទៅក្នុង ផែនដី ។
នេះ ជា ចម្រៀង មួយ បទ ដែល ខ្ញុំ ចូលចិត្ត ។
កុំ ប្រាប់ ខ្ញុំ ថា ដៃ ខ្ញុំ គ្មាន ប្រយោជន៍ ។
ពេលគាត់យល់ថាគាត់ ជាអ្នកស្រុកគីលី គា ។ ៣៤ ក្រោយពីអានចប់ គាត់សួរថាគាត់ មកពីខេត្ត ណា ?
យ៉ាង ណាក៏ដោយ ខ្ញុំអាចលក់វាទៅឲ្យជនបរទេស ។
រង់ចាំវាស្ងួតសិន ទើបខ្ញុំព្យួរវា។
« យើងមិនគួរឲ្យមនុស្សទាំងនោះចូលក្នុងប្រទេសទេ » ។
ប៉ុន្តែដូចការ ផ្សាយពាណិជ្ជកម្ម ហ្គីណេសចាស់បាននិយាយថា៖ « រឿងល្អ មកដល់អ្នកដែលរង់ចាំ » ។
« ពួកគេ បាន អនុញ្ញាតឱ្យ ពួកគេ មួយចំនួន ត្រឡប់ មកវិញ ទោះបីជា បាន សារភាព ថា ពួកគេ បាន ទាមទារ ពួកគេ ត្រឡប់ មកវិញ នៅ ពេល ក្រោយ ក៏ដោយ ។
ប្រស្នា អំពី ព្រហ្ម ចារី ទាំង ដប់ ; និង ទេពកោសល្យ៖ ការពិពណ៌នា អំពី ការវិនិច្ឆ័យ ចុងក្រោយ ។
ដូច្នេះការ ប៉ះដៃអ្នកនឹងគ្រប់គ្រាន់ » ។
យើង រក្សា និង ប្រើប្រាស់ ទិន្នន័យ ផ្ទាល់ខ្លួន របស់ អ្នក សម្រាប់ គោលបំណង មួយចំនួន ឬ ទាំងអស់ ដូច ខាងក្រោម៖
មាន សារៈសំខាន់ យ៉ាង សំខាន់ ចំពោះ សមាជិក ដ៏ ខ្ពង់ខ្ពស់ របស់ មនុស្ស ។
អ្នក ដែល មាន រូបរាង ប្លែក ។
ខ្ញុំ ស្នើ ឱ្យ អ្នក រង់ចាំ រហូតដល់ ពេល នោះ ។
ឬធ្វើម៉េចដឹងប្តីថាឯងនឹងជួយប្រពន្ធឯង ?
សេចក្តីស្រឡាញ់ និង ពរ ជ័យ របស់ យើង គឺ មកពី ទ្រង់ ។
ពួកគេ ចំណាយ ពេល មួយ ថ្ងៃ ជាមួយគ្នា លាតសន្ធឹង លើ សាឡុង ។
អ្នក ត្រូវការ ព្រះគុណ សន្សំ ។
មនុស្ស 1 នាក់ក្នុងចំណោម 2 នាក់បានយល់ឃើញថាវាមានប្រយោជន៍ ។
ខ្ញុំមិនធ្វើអ្វីដែលមិនទៀងត្រង់ ។
តើបុរស ណាមិនចង់បានបើដឹងពីអត្ថប្រយោជន៍ច្រើន ?
នៅ ពេល ដែល វា ទៅដល់ ទីនោះ ខ្ញុំ នឹង សប្បាយ ចិត្ត ។
៧ ដូច្នេះ ចូរអ្នកកុំចូលរួមជាមួយនឹងគេឡើយ ។
អ្នក ណានិយាយដោយខ្លួនឯង ធ្វើដូច្នេះដើម្បីបានកិត្តិយសសម្រាប់ខ្លួនឯង ប៉ុន្តែអ្នក ណាដែលធ្វើការ ដើម្បីកិត្តិយសដល់អ្នកដែលចាត់អ្នកនោះមក នោះជាមនុស្ស ស្មោះត្រង់ ។ គ្មានអ្វីមិនពិតអំពីគាត់ទេ » ។
នេះដោយសារ តែអ្នកបើកបរក្មេង ៗសព្វ ថ្ងៃ ។
ក្រុម ទាំង ពីរ មាន ឱកាស ឈ្នះ ។
អ្នក ណាដែលជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ » ។
ព្រះ អើយ អ្នក បាន តាំងចិត្ត នឹង កាបូប រួចហើយ !
បញ្ហាគឺផ្ទះដែលពួកគាត់ រស់នៅនោះ សង់នៅខាងខ្ញុំ ។
ចូល ទៅក្នុង បទបន្ទាប់មក វា មិន អី ទេ ។
« ចូរការពារប្រាក់ បញ្ញើដ៏ល្អដែលបានប្រគល់ដល់អ្នក --- ការពារវាដោយជំនួយពីព្រះវិញ្ញាណបរិសុទ្ធ ដែលគង់នៅក្នុងយើង » ។
« វាពិតជាកិត្តិយសណាស់ដែលបានជួបជាមួយប្រធាន Kagame ។
នៅក្នុង អារម្មណ៍ : រីករាយ
បាន ដឹកនាំ ត្រឡប់ ទៅ តារាង មាតិកា ។
អត់ទោសឱ្យពួកគេ ព្រោះពួកគេមិនដឹងថាគេធ្វើអ្វីទេ » ។
គាត់ បាន បង្ហាញ ខ្លួន អោយ ពេត្រុ ស បន្ទាប់មក ទៅដល់ ពួក ដប់ ពីរ នាក់ ។
៦ ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា មានម្នាក់ធំជាងព្រះវិហារបរិសុទ្ធមកហើយ ។
បរិមាណ ដ៏ ច្រើន មិន អាច រាប់ បាន ប៉ុន្តែ មាន គុណសម្បត្តិ ក្នុង វិធី សាស្ត្រ៖
ឈរ ជាមួយ ខ្ញុំ បងប្អូន ស្រី ។
មាន សំណួរ ជាច្រើន ដែល ខ្ញុំ ចង់ សួរ អ្នក ។
អ្នកនឹងប្រាប់ដល់អស់អ្នកដែលគេខ្វល់ខ្វាយនឹងការ នេះដឹង ដ្បិតការ មិនស្តាប់បង្គាប់ និងសេចក្ដី ស្លាប់គឺជាពាក្យដដែល » ។
មក ... ព្រះយេស៊ូវបានធានាដល់គាត់ថា គាត់នឹងនៅជាមួយគាត់ក្នុងឋានសួគ៌ .. . នៅថ្ងៃនោះ ។
ពួកគេ មាន កូនប្រុស តែ មួយ ។
គាត់ ចង់ ចូល ព្រះវិហារ ប៉ុន្តែ ឪពុក របស់ គាត់ មិន អនុញ្ញាត ទេ ។
នេះ ជា រឿង មួយ អំពី ការប្រើ ស្រោម អនាម័យ របស់ ឪពុក អ្នក ។
ខ្ញុំមាន អំណរគុណជារៀងរហូតចំពោះអ្នកដែលមានជំនឿលើខ្ញុំគ្រប់គ្រាន់ក្នុងការ ផ្តល់អាហារូបករណ៍នេះដល់ខ្ញុំ ហើយខ្ញុំប្រាកដជាមិនធ្វើឲ្យពួកគេខក ចិត្តឡើយ » ។
ត្រៀមខ្លួន សម្រាប់ អឺរ៉ុប ។
ខ្ញុំមិនពូកែនិយាយច្រើនពេកជាមួយមនុស្សមួយចំនួនដែលខ្ញុំមិនស្គាល់ ។
