« ដូច្នេះកុំខ្លាចពួកគេឡើយ ដ្បិតគ្មានអ្វីដែលបិទបាំងដែលមិនត្រូវបើកសម្ដែង ហើយលាក់ទុកដែលមិនអាចដឹងបានឡើយ ។
ព្រះបាន ទាញ យើង ចេញពី គំនរ សំរាម ហើយ ទ្រង់ មាន ផែនការ សម្រាប់ យើង ប៉ុន្តែ គ្មាន អ្វី សោះ អំពី ពួកយើង ដែល ធ្វើឲ្យ យើង ក្លាយជា មនុស្ស ម្នាក់ ក្នុង ចំណោម អ្នក ដែល ត្រូវបាន ជួយសង្គ្រោះ ។
ខ្ញុំ រីករាយ ណាស់ ដែល គាត់ បាន និយាយ អំពី វា ។
ពួកគេ អាច យល់ស្រប ជាមួយ ឪពុក របស់ គាត់ ។
ជាច្រើន សតវត្ស មក ហើយ ស្ត្រី បាន និង កំពុង តស៊ូ ដើម្បី ធានា បាន នូវ មុខតំណែង គួរឱ្យ គោរព នៅក្នុង សង្គម ។
ចិត្ត ហើយបើនិយាយថាគ្មានការ ក្បត់ទេ គឺមិននិយាយអ្វីសោះ !'
អ្នក បាន ឃើញ នូវ អ្វី ដែល គាត់ បាន ធ្វើ ចំពោះ ខ្ញុំ នៅក្នុង ការប្រកួត ចុងក្រោយ របស់ យើង ។
ហើយគាត់បាននិយាយថា “ នោះនឹងត្រូវអស់ហើយ ” ។
ប៉ុន្តែ មនុស្ស ជាច្រើន ចូលចិត្ត ដឹង ពី តម្លៃ ជាមុន ។
ក្នុង ករណី មាន ការសង្ស័យ គាត់ រាយ បញ្ជី ការងារ ដែល ត្រូវ មាន
ដរាបណា អ្នក ធ្វើ តាម បទប្បញ្ញត្តិ របស់ ទីក្រុង អំពី អ្វី ដែល អ្នក អាច បោះចោល ការជួល អាច ជួយ អ្នក ឱ្យ ធ្វើ វា បាន ។
គ្មាន អ្នកណា ឃើញ ទឹកភ្នែក ខ្ញុំ ទេ ?
"" ខ្ញុំប្រកាសបំបែកខ្លួនពីសហរដ្ឋអាមេរិក ។
ផ្សេង ៗ ក្នុង សម័យ បច្ចុប្បន្ន ។
ខ្ញុំ កំពុង អំពាវនាវ ឱ្យ រដ្ឋាភិបាល សហព័ន្ធ ជួយ យើង ព្រោះ យើង ត្រូវការ កន្លែង អចិន្ត្រៃយ៍ ។
១៨ យើងបានឮសំឡេងនេះចេញពីស្ថាន សួគ៌ ពេលយើងនៅ ជាមួយនឹងទ្រង់នៅលើភ្នំបរិសុទ្ធ ។
និយាយ តាម ត្រង់ ខ្ញុំ ចង់ ជឿ ថា ការផ្លាស់ប្តូរ របប អាហារ របស់ ខ្ញុំ បាន ជួយ ខ្ញុំ !
អ្នកដែលមានជំងឺកូវីដ - ១៩ អ្នក ប្រហែលជាអាចចាប់វាទៀតហើយ ។
ភាព ចាស់ទុំ 5 ឆ្នាំ ច្រើន តែ គ្រប់គ្រាន់ ។
កិច្ចការ 6:3 « ដូច្នេះ បងប្អូនអើយ ចូររើសចេញពីចំណោមអ្នក រាល់គ្នានូវបុរសល្បីឈ្មោះប្រាំពីររូប ដែលពោរពេញដោយព្រះវិញ្ញាណ និងប្រាជ្ញា ដែលយើងនឹងតែងតាំងឲ្យបំពេញ មុខងារនេះ » ។
ការថ្វាយបង្គំ កូនគោ មាស ; បន្ទាប់ពី ដូចគ្នា ។
អ្នកនឹង រកឃើញច្រើនដើម្បីឱ្យអ្នក រវល់ទាំងក្នុង និងក្រៅខ្ទម ។
គាត់ខក ចិត្តនឹងការ បង្គាប់របស់ព្រះ ហើយត្រូវបានជំនួសដោយដាវីឌ
ប្រសិនបើ អ្នកស្លាប់ បាន ស្នើសុំ ឱ្យ គាត់
វា មិន មែន អំពី អ្វី ដែល ព្រះនាម ត្រឹមត្រូវ នោះ ទេ ។
ខ្ញុំ សង្ឃឹមថា ខ្ញុំបានធ្វើអំពើល្អជាងការ ធ្វើ បាបក្នុងជីវិតរបស់ខ្ញុំ » ។
នៅ ថ្ងៃ ដែល មាន ពន្លឺ ថ្ងៃ វា បង្ហាញ ទីក្រុង ឡុងដ៍ ល្អ បំផុត ។
អ្នកដែលមាន ចិត្តបរិសុទ្ធបាន ពរហើយ ព្រោះគេនឹងឃើញព្រះ។
និង ការកោតខ្លាច ព្រះអម្ចាស់ ។
រៀបចំ ឧបករណ៍ ផ្ទុក ទារក ឡើងវិញ
យើង ត្រូវតែ ស្មោះត្រង់ ។
ដែល ជាប់ អន្ទាក់ ដោយ កំហុស របស់ ពួកគេ ការដក ភាព ងងឹត ចេញ ពី អ្នក ដែល ដឹង
គាត់និយាយបន្តថា៖ « នេះគឺជាព្រះ ដែលមាន បន្ទូលទៅក្នុងស្ថានភាពមនុស្សថា ' អ្នកខូចហើយសមត្ថភាពរបស់អ្នកក្នុងការ ស្គាល់ខ្ញុំហើយសូម្បីតែដឹងពីវត្តមានរបស់ខ្ញុំ » ។
អត្ថបទ មុន ថ្ងៃ ខ្មៅ៖ តើ វា យ៉ាងម៉េច ជា លើក ដំបូង ។
ចិត្ត ១០យ៉ាង ដើម្បី រក្សា ចិត្ត
យើង បាន ដាក់ ញត្តិ ; យើងបានធ្វើការ អង្វរក រ 11 យើងបានក្រាបខ្លួននៅមុខបល្ល័ង្ក ហើយការ ប្រមាថ ការ អង្វររបស់យើងត្រូវបានគេមិនយក ចិត្តទុកដាក់ ហើយយើងត្រូវបានគេប្រមាថដោយការ មើលងាយពីជើងបល្ល័ង្ក ។ មាន សមត្ថភាព ប៉ុន្តែ .. .
ខ្ញុំធ្លាប់គិតថាឯងមាន ចិត្តអាក្រក់ ហើយជេរគ្រប់ពេលដែលអ្នកទូរស័ព្ទជាមួយក្រុមគ្រួសារ » ។
ទោះបីនេះជាការ បំពានដ៏ធំក៏ដោយ ក៏វាមិនធំជាងគេដែរ ។
ប្រសិនបើ អ្នកនាំ កូន របស់ អ្នក មក ជាមួយ នោះ ក៏ មាន ការថែទាំ កូន ដែល នឹង ផ្តល់ ជូន អ្នក ផងដែរ ។
វា តំណាង ឱ្យ អ្នក ជឿ ការធានា នៃ ព្រះគុណ នៃ ព្រះសម្រាប់ សេចក្តីអំណរ និង ពរ ជ័យ របស់ ពួកគេ ។
ហើយគេបានដឹងថា នាងចូល ចិត្តធ្វើម្ហូប រហ័ស ហើយគេចូល ចិត្តធ្វើម្ហូបយឺត ។
គាត់ បាន ហោះ ទៅ រក អ្នកទិញ ទំនិញ
ខ្ញុំ នឹង អធិស្ឋាន សម្រាប់ អ្នក ជារៀងរាល់ ថ្ងៃ !
យើង ជឿ ថា គ្រប់ គ្នា គួរតែ មានអាហារ ដែល ពួកគេ ចូលចិត្ត ញ៉ាំ ។
ឥឡូវនេះ យើងទាំងអស់គ្នានៅ ទីនេះនៅចំពោះព្រះភក្ត្រព្រះ ដើម្បីស្ដាប់គ្រប់ទាំងសេចក្ដី ដែលព្រះ បានបង្គាប់ មក » ។
នៅពេល អ្នក ដាក់ លើ ជនល្មើស ។
ស្គាល់ថៅកែមិត្តប្រុសទី ៣ របស់បងប្អូនជីដូនមួយទេ ?
គាត់ បិទ ភ្នែក ប្រហែល ដប់ វិនាទី ។
អ្នក ទីមួយមកនិយាយថា “ លោកម្ចាស់ មីណារបស់លោករកបានដប់ទៀតហើយ ” ។
ឥឡូវនេះ មនុស្ស ភាគ ច្រើន ចំណាយ ពេល ច្រើន អង្គុយ នៅមុខ កុំព្យូទ័រ ។
គាត់និយាយពីខ្លួនឯង ហើយមិនស្គាល់អ្នកទេ ។
និង សេចក្តីថ្លែងការណ៍ អំពី មូលហេតុ ដែល សមាជិក មិន ធ្វើ
អ្នក ណាដែលជឿត្រូវបានកំណត់ទុក ជាមុនដើម្បីធ្វើដូច្នេះ ។
កូនប្រុស របស់ គាត់ មាន អាយុ ប្រាំ ប្រាំបួន ឆ្នាំ ហើយ ការកែតម្រូវ គឺ ពិបាក សម្រាប់ ពួកគេ ។
ឬទុក្ខ វេទនាក្នុងប្រទេសដែលត្រូវបានបំផ្លាញដោយសង្គ្រាមស៊ីវិល ។
៦ ប្រាកដណាស់ ទុក្ខព្រួយមិនកើតចេញពីដីទេ ហើយទុក្ខលំបាកក៏មិនកើតចេញពីដីដែរ ។
នេះ គឺ សម្រាប់ ខ្ញុំ និង បងប្អូនស្រី របស់ ខ្ញុំ ។
វាដូចជានាងមិនដែលបានទៅ » ។
១២ នៅថ្ងៃ បន្ទាប់ ពេលពួកគាត់ មកពីភូមិបេថា នី គាត់ឃ្លាន ។
ព្រះ បាន សន្យាថានឹងផ្តល់សាច់ច្រើនដល់ជន ជាតិអ៊ីស្រាអែល ធ្វើឲ្យពួកគេឈឺដោយសារវា ដែលបណ្ដាលឲ្យមនុស្សជាច្រើនស្លាប់ ។
មើល គ្រួសារខ្ញុំខ្សោយជាងគេនៅម៉ាណា សេ ហើយខ្ញុំជាកូនពៅក្នុងផ្ទះឪពុកខ្ញុំ » ( ចៅក្រម ។
តើ ប្រិយមិត្ត យល់ យ៉ាងណា ដែរ ចំពោះ ទំនាក់ទំនង គ្រួសារ ក្នុង កម្មវិធី ?
ល្ង ) ដើម្បី ផ្ទៀងផ្ទាត់ ដំណើរការ ។
ការយល់ដឹង នឹង ជួយ ប៉ុន្តែ ការខិតខំ ប្រឹងប្រែង នឹង ត្រូវការ ។
ដើរតាមផ្លូវហើយរកមើលសញ្ញាមួយប្រហែលជាគាត់ដើរយូរហើយ » ។
ខ្ញុំ ខកចិត្ត ដែល ខ្ញុំ មិន អាច បង្ហាញ ការប្រមូល ពេញលេញ របស់ នាង ។
ដូចគ្នានេះបានកើតឡើងនៅប្រទេសជប៉ុនក្នុងអំឡុងពេល រញ្ជួយដីឆ្នាំ ២០១១ ។
ពួកគេ ស្រឡាញ់ ទ្រព្យសម្បត្តិ របស់ ឪពុក អ្នក ។
ភ្ញៀវ របស់ អ្នក មិន ស្គាល់ ខ្ញុំ ទេ ដូច្នេះ ពួកគេ ចង់ ឮ ពី អ្នក ។
« ខ្ញុំបានសម្រេច ចិត្តមិនដឹងអ្វីក្នុងចំណោមអ្នក រាល់គ្នាលើកលែង តែព្រះយេស៊ូវ គ្រីស្ទ ហើយទ្រង់បានឆ្កាង » ( ២: ២) ។
៦ ប៉ុន្តែខ្ញុំប្រាប់អ្នក រាល់គ្នាថា មានម្នាក់ធំជាងព្រះវិហារបរិសុទ្ធនៅ ទីនេះ ។
ហើយវាមានក្នុងទំហំធំ ទូលាយមួយដែលស័ក្តិសមនឹងមនុស្សគ្រប់ប្រភេទ ។
ប្រសិនបើ នរណា ម្នាក់ ចង់ មក
ស្វែងរក យូរ ហើយ ទីបំផុត រកឃើញ នៅ ទីនេះ ។
« ហើយដាវីឌ បាន សុគតក្នុងវ័យចំណាស់ ហើយសាឡូម៉ូន ជាកូនរបស់គាត់ក៏ចូល មកជំនួសគាត់ វិញ » ។
« យើងនឹងធ្វើអ្វីគ្រប់យ៉ាងដែលយើងអាចធ្វើបានក្នុងការ រារាំងដើម្បីធ្វើឱ្យគ្រប់លទ្ធភាពទាំងអស់
ពួកគេធ្វើឲ្យខ្លួនគេប្រមាថព្រះ និងមនុស្ស ។
អ្នក នឹង ត្រូវបាន សួរ រក ពាក្យ សម្ងាត់ ដែល អ្នក បាន បង្កើត ។
