“ ខ្ញុំមានអារម្មណ៍ថាវាជិតបង្កើត ភាព ក្លាហានហើយ ។
ហើយ វា ក្លាយជា រឿង សំខាន់ សម្រាប់ គាត់ ។
« ហើយពេលឃើញគាត់ ពួកគេក៏ថ្វាយបង្គំគាត់ ប៉ុន្តែអ្នកខ្លះ សង្ស័យ ។
ជ្រើសរើស អត្ថបទ ថ្មី ៗ នៅក្នុង ទិនា នុប្បវត្តិ យោង៖
អ្នក គឺជា អ្នក ប្រយុទ្ធ ដើម្បី ប្រទេស របស់ យើង !
« បាទ បាទ » ខ្ញុំឆ្លើយ តបនឹងការ ត្អូញត្អែររបស់បុរសនោះ ។
វា ស្ថិត ក្នុង ស្ថានភាព ល្អ មាន ដៃ
ធ្វើដូច្នេះបន្ទាប់ពីគាត់ត្រឡប់ពីគុយ បា ។
ប៉ុន្តែ ផ្ទុយទៅវិញ អ្នក អាច ប្រាកដ ថា ម៉ារ៉ុក នឹង មិន ចុះចាញ់ ដោយ ងាយ នោះ ទេ ។
ដូច្នេះ តើ គាត់ មាន ប្រពន្ធ ប៉ុន្មាន ?
៨ - ដូចមានចែងទុកមកថា៖ « ព្រះ បានប្រទានឲ្យពួកគេមានវិញ្ញាណ ក្រហាយភ្នែក ភ្នែកមិនអាចមើលឃើញ និងត្រចៀក រហូតដល់សព្វថ្ងៃនេះមិនអាចស្តាប់បាន ។
ប៉ុន្តែ គាត់ ចង់ ធ្វើ អ្វី មួយ ។
ខ្ញុំនឹងទូរស័ព្ទទៅគាត់ពេលក្រោយដើម្បីសួរថាតើគាត់នឹង មកផ្ទាល់ឬអត់ » ។
គ្មាននរណាខ្វល់ពីការ សម្លឹងមើលអ្នកទេ គេនឹងគិតតាមការ អនុវត្តរបស់ខ្លួន ។
ឥឡូវនេះ ត្រឡប់ ទៅ អង្គុយ ចុះ ហើយ ស្នាក់ នៅ ទីនោះ ។
និង ការពិត របស់ អ្នក នៅក្នុង នាឡិកា ពេល យប់ ។
ទោះ យ៉ាងណា ក៏ដោយ នៅតែ ស្លៀកពាក់ ដោយ គោរព
បង្អាក់ ការលូតលាស់ របស់ គាត់ ហើយ ផ្តល់ឱ្យ គាត់ នូវ រូបរាង ដ៏ ឆ្ងាញ់ ។
៤៣ ខ្ញុំបានមកក្នុងព្រះនាមព្រះបិតារបស់ខ្ញុំ ហើយអ្នក រាល់គ្នាមិនទទួលខ្ញុំទេ ។
នេះ ជា រូបមន្ត សម្រាប់ អ្នក ដែល ធ្វើ ១៦ ម្រាម ដៃ ។
គាត់ទៅរៀននៅព្រឹកនេះដូចធម្មតា ប៉ុន្តែបើទោះជាម៉ោងជិត ៨ ០០ហើយក៏មិនបានត្រឡប់មកវិញដែរ ។
អ្នកនឹងឈរហើយអ្នកនឹងមិនត្រូវខ្មាស ,
គាត់ នឹង មិន ដែល ចាប់អារម្មណ៍ នឹង មនុស្ស ស្រី ដូច នាង ទេ ។
ប្រាក់ ម៉ាស៊ីន មេ បាន សម្តែង ។
ពួកគេ ទើបតែ ដឹង ថា ពួកគេ ត្រូវតែ ប្រយុទ្ធ ។
យើងអាចចាត់ទុកគេហទំព័រងងឹតជាផ្នែក រងនៃបណ្ដាញជ្រៅ ។
« តើអ្នក ជាអ្នកដែលត្រូវមក ឬយើងគួររំពឹងទុកអ្នកផ្សេង ? »
ដូច នៅក្នុង ករណី នៃ អាហ្វ្រិក ខាងត្បូង ការលើកលែង ទោស
ខ្ញុំមិនដឹងថាខ្ញុំចង់ធ្វើអ្វីដើម្បីចិញ្ចឹមជីវិត » ។
អ្នក មិន ចាំបាច់ ធ្វើឱ្យ ខូច កេរ្តិ៍ឈ្មោះ ខ្លួន ឯង ទេ ។
អ្នក ពិតជា មិន បាន រកឃើញ ពួកគេ នៅក្នុង ប្រទេស ស៊ុយអែត មិន ថា នៅក្នុង សហរដ្ឋ អាមេរិក ឬ យ៉ាងហោចណាស់ នៅក្នុង ទីក្រុង ឈីកាហ្គោ ។
ដូច ដែល ទើបតែ បាន និយាយ ; ថ្ងៃនេះ បើអ្នក ឮសំឡេងរបស់ទ្រង់ ចូរកុំធ្វើ ចិត្តរឹងដូចអ្នកបានធ្វើក្នុងការ បះបោរឡើយ » ។
ដូច្នេះ ខ្មាំង ស ត្រូវបានផ្តល់ព័ត៌មានដល់គាត់ដោយរីករាយ ដែលនឹងបន្តតាម រកព្រះ នៃទ្រព្យ សម្បត្តិរបស់គាត់ ដោយចំណាយអស់ព្រលឹង ។
ហេហេ កន្លែងណា !
ពិតណាស់ មានអ្នកដែលជឿថា វាគួរ តែចាក់សំរាម ។
« ប៉ុន្តែ ប្រជាជនក្នុងទីក្រុងបានបែកបាក់គ្នា ខ្លះនៅខាងជន ជាតិយូដា ហើយខ្លះទៀតនៅខាងសាវ័ក ។
ខ្ញុំ ជាមនុស្សស្រីឆ្នាស់ណាស់ ខ្ញុំក្ដៅខ្លួនណាស់ ។
ក្នុងពេលបច្ចុប្បន្ននេះមិនមានអ្វីខ្វះនោះទេ ។
លោកុប្បត្តិ ១១: ១៖ « ហើយផែនដីទាំងមូលគឺជាភាសា តែមួយ ហើយនិយាយតែមួយ » ។
ខ្ញុំមិនចង់ឲ្យសារ៉ា ដា ចាប់វាទេ ។
យើងបានចាត់ស្នែងនៅចំពោះមុខអ្នក ដែលបានបណ្ដេញពួកគេចេញពីមុខអ្នក ហើយក៏ជាស្ដេចទាំងពីររបស់ជន ជាតិអាម៉ូរីដែរ ប៉ុន្តែមិនមែនដោយដាវ ឬដោយ ...
តាមពិតមានមនុស្ស ២.០០០ នាក់ទៀតកំពុងរង់ចាំការព្យាបាល។
បើក ករណី ដ្រាយ របស់ អ្នក ។
ឬខ្ញុំត្រូវអនុវត្តពេលក្របីនៅស្ងៀម ។
ផ្កាយនឹងធ្លាក់ពីលើមេឃ ហើយអំណាចនៃស្ថាន សួគ៌នឹងត្រូវកក្រើក ។
តើ អ្នក អាច លង់ ស្នេហ៍ ភ្លាម ៗ
ភ័យ រន្ធត់ អំពី៖ សត្វ ពីង ពាង ។
នេះគឺជាការ លើកទឹក ចិត្ត និងការ ធ្វើជាដើម ។
រង់ចាំ បុរស ដែល គ្មាន សង្ឃឹម នឹង ចេញមក ។
មានសំឡេងមក កាន់គេពីលើមេឃ ចេញពីមាត់មហា ទេវតា
វា ដំណើរការ រាងកាយ ទាំងមូល ។
ពួកគេ នឹង មាន ការខកចិត្ត និង ងឿងឆ្ងល់ នៅពេល ពួកគេ ព្យាយាម កក់ សក់ របស់ ពួកគេ ។
មិន ថា អ្នក រស់ នៅក្នុង ក្លឹប រថយន្ត ទេ ។
នៅ សម័យ កូសូវ៉ូ ។
ដំណើរ ឆ្លងកាត់ គំនិត របស់ ខ្ញុំ ។
សិល្បៈដែលទទួលបានការ សរសើរ ស្មើគ្នារបស់ Reza ។
នៅ ទីនោះ លោកបានដើរតាមមាគ៌ា ។
ពួកគេ រស់ នៅក្នុង បេះដូង នៃ ព្រលឹង ។
ពួកគេបាននិយាយថា៖ « ខ្ញុំនឹងមិនចាត់ទុកវាជាការ ប្រមាថទេ ។
អ្នក នៅ តែមិនបានជួសជុលរន្ធពីរនៅក្នុងជញ្ជាំងដែលអ្នកបានធ្វើនោះទេ » ។
ខ្ញុំសុបិនចង់នៅក្នុងក្រុម ចម្រៀងស្រីជាមួយមិត្ត ភក្តិរបស់ខ្ញុំ
គ្រាន់តែ សរសេរ លើ អ្វី ដែល អ្នក បាន ឃើញ ។
ធ្វើ បច្ចុប្បន្នភាព មូលដ្ឋាន ទិន្នន័យ ដោយ ប្រើ ពាក្យបញ្ជា ខាងក្រោម ។
អាសួសនោះជាម្តាយរបស់កូនស្រី ហើយនាងបានការពារអ្នករំលោភក្មេង
នេះ ជា រឿង វិជ្ជមាន សម្រាប់ ទីក្រុង ។
អ្នកប្រើដែលមានអ៊ីនធឺណិតមិនត្រូវការ ប្រូកស៊ីទេ ។
បានទទួល យកនៅក្នុងនោះគឺ
អល់ឡោះ មាន បន្ទូល ថាៈ ហើយ ពួក យូដា និយាយ ។
នៅ ទីក្រុង ហ្សេរុយ សាឡឹម អ្នកនាំពាក្យ យោធា អ៊ីស្រាអែល បាន និយាយ ថា " យើង មិន ធ្វើ អត្ថាធិប្បាយ លើ របាយការណ៍ អំពី ប្រភេទ នេះ ទេ " ។
ម្នាក់ទៀតនិយាយលេងសើច ថា៖ « មិនមែនម្នាក់ទៀត រស់ពីស្លាប់ទេ » ។
ទោះ យ៉ាងណា ក៏ដោយ វា មាន សមរភូមិ ឡើង ភ្នំ ពី ទីនេះ ។
អ្នក អាច ទៅដល់ កន្លែង ហាត់ប្រាណ នៅ កម្រិត 5 ប៉ុណ្ណោះ ។
រួមបញ្ចូល៖ បញ្ចូល ចេញ និង បញ្ជូន បន្ត ។
ប្រាំបី ឆ្នាំ គឺ គ្រប់គ្រាន់ ទេ ?
ខ្ញុំដាក់ខ្លួនទៅសាលក្រមរបស់តុលាការ ។
មុន ថ្ងៃអាទិត្យ
ដូច្នេះ ពលរដ្ឋ ចិន
អ្នក ណាដែលមិនលក់ត្រូវចិញ្ចឹមខ្លួន ឯង ។
វា ពិតជា ឆ្ងាញ់ ហើយ ពួកគេ ចូលចិត្ត
មិន ចាំបាច់ បង្ខំ ទ្វារ ទេ យើង បើក ទាន់ ពេល ។
ដូច្នេះ អ្នកដែលធ្វើការ នៃសេចក្ដី សុខសាន្តមាន ពរហើយ ព្រោះគេនឹងត្រូវបានហៅថាជាកូនរបស់ព្រះ។
ទោះជា យ៉ាងណា ក៏ដោយ ពួកគេ មាន ប្រវែង វែង ។
កិច្ចសហការ គឺជា រឿង ទី 1 ដែល អ្នក អាច ធ្វើ ដើម្បី ជំរុញ ខ្លួនអ្នក ឱ្យ ឆ្ពោះទៅ មុខ ។
កុំ នាំនរណា ម្នាក់ មក ជាមួយ អ្នក ដោយ គ្មាន ការអនុញ្ញាត ពី ម្ចាស់ ផ្ទះ ។
ទោះ យ៉ាងណា ក៏ដោយ វា នឹង ពិបាក ក្នុង ការចែករំលែក មួយ របស់ អ្នក ។
មនុស្សជាច្រើនចំណាយពេលទំនេររបស់ខ្លួនក្នុងពេលថ្ងៃក្នុងវិហារឥស្លាម ដើម្បីសូត្រគម្ពីរគម្ពី គូរ៉ា ។
អ្វីដែលផ្ទុយ ពីការ កើនឡើង ?
ចាប់ពីពេលនោះមក ខ្ញុំចាប់ផ្ដើមសូត្រ មន្តរៀងរាល់ថ្ងៃ ដូចដែលម្ដាយខ្ញុំសុំ ។
ខ្ញុំ សរសើរ ព្រះបន្ទូល របស់ ព្រះអម្ចាស់ ។
បើរកឃើញថាមានកំហុស នាងអាចត្រូវដកចេញពីតំណែង ។
សមាជិក ព្រឹទ្ធសភា ខ្ញុំ បាន សួរ នាង ថា តើ ពេលណា ទើប នាង ក្លាយជា កូនក្រមុំ ។
1:10 ប្រជាជនទាំងអស់កំពុងអធិស្ឋាននៅខាងក្រៅខណៈដែលគាត់កំពុងដុតគ្រឿងក្រអូប .
1:11 យើងក៏ត្រូវចាត់ទុកជា មរតកដែរ ដោយបានកំណត់ទុកជាមុន ស្របតាមគោលបំណងរបស់ព្រះអង្គដែលធ្វើការ ទាំងអស់តាមការ ទូន្មាននៃព្រះហឫទ័យរបស់ព្រះអង្គ ។
បពិត្រព្រះ អង្គគង់នៅខាងស្ដាំព្រះហស្ត ។
ខ្ញុំមិនមានផែនការ អនាគតសម្រាប់អាពាហ៍ពិពាហ៍នោះទេ ។
បំណែក ទាំងនេះ ខ្លះ មាន អាយុកាល រហូតដល់ មួយ រយ ឆ្នាំ ។
« អ្នក ដែល ពន្យារ ពេល ច្រណែន នឹង ភាពជោគជ័យ របស់ អ្នកធ្វើ ការសម្រេចចិត្ត » ។
ខ្ញុំ សង្ឃឹមថានឹង រកឃើញ កសិដ្ឋានមួយដែលចង់សាកល្បងពួកគេ » ។
យើងធ្វើអ្វីដែលត្រឹមត្រូវ ដោយ សារយើងស្រឡាញ់ព្រះ។ ដោយ សារយើងស្រឡាញ់ព្រះ យើងយល់ថាការ ស្តាប់បង្គាប់គឺប្រសើរជាងការ លះបង់ ។
ទោះបីជាជិតមួយឆ្នាំក៏ត្រូវត្រៀមខ្លួន !
ខ្ញុំ អាច អាន ស៊ីឌី ។
វា មិន អាច ធ្វើ បច្ចុប្បន្នភាពវីនដូ បាន ទេ ។
អ្នកខ្លះក៏បានសម្រេច ចិត្តដែរ ។
តើអ្នកត្រូវផ្តល់អ្វីជំនួសឱ្យអ្វីដែលអ្នកកំពុងលុបបំបាត់ ?
ទោះ យ៉ាងណា ក៏ដោយ ថា ពួកគេ ចង់បាន ជំនឿ និង សាសនា ខ្លួន ឯង
ភាពស្មោះត្រង់ និង ការគោរព ប្រតិបត្តិ ចំពោះ អ្នក ដែល មាន អំណាច លើ យើង នៅក្នុង ព្រះអម្ចាស់ ។
( នេះគឺជាអណាហ៍ដែលបានរកឃើញប្រភពទឹកក្តៅនៅទី រហោស្ថាន ខណៈដែលគាត់កំពុងវាលស្មៅ លាស៊ីបៀន ជាឪពុករបស់គាត់ ) ។
' អ្នកណា និយាយ ភាសា ដទៃ និយាយ ទៅកាន់ ព្រះជាម្ចាស់ មិន មែន និយាយ ទៅកាន់ មនុស្ស ទេ ត្បិត គ្មាន អ្នកណា យល់ អំពី គាត់ ទេ ទោះបីជា អ្វី ដែល គាត់ និយាយ គឺ ពោរពេញ ដោយ អត្ថន័យ ខ្ពស់ បំផុត ក៏ដោយ ។
ប៉ុន្មាន ឆ្នាំ ក្រោយមក នាង បាន ក្លាយជា អ្នកថតរូប ដ៏ ឆ្នើម ម្នាក់ ។
១៦ លោកត្រូវគេបញ្ចុះ សពលោកនៅក្នុងក្រុងរបស់ព្រះបាទដាវីឌ ដោយព្រោះ តែអំពើល្អដែលលោកបានធ្វើនៅស្រុកអ៊ីស្រាអែល សម្រាប់ព្រះជាម្ចាស់ និងព្រះវិហាររបស់ លោក ។
ហើយ គាត់ បាន ដឹកនាំ ពួកគេ ដូចជា ហ្វូង ចៀម នៅក្នុង វាល រហោ ស្ថាន ។
ប៉ុន្តែ យើង មាន គំនិត ជា មូលដ្ឋាន ។
នៅក្នុង លក្ខខណ្ឌ នៃ កាលបរិច្ឆេទ : ឥឡូវនេះ រដ្ឋ តិចសាស់ ត្រូវបាន កំណត់ ទាំងអស់ ។
ឥឡូវនេះ ឆ្មាំ ជាតិ កំពុង ឈានជើង ចូលទៅ ជួយ ស្វែងរក គាត់ ។
មិន អាច គ្រប់គ្រង បាន វា ប្រាប់ អ្នក ។
យើងគិតម្យ៉ាងទៀតថា វាមិនសំខាន់ទេក្នុងការ មានតុល្យភាព ។
អ្នក គឺ ខុសគ្នា និង មិន អាច ប្រៀបផ្ទឹម នឹង អ្នកដទៃ បាន ។
« យើងបានមកស្នាក់នៅក្នុងស្រុកនេះ ព្រោះទុរ្ភិក្សធ្ងន់ធ្ងរនៅស្រុកកាណាន ហើយគ្មានស្រែចំការ សម្រាប់ហ្វូងចៀមរបស់យើង ។
វា ដំណើរការ ដូចគ្នា ទៅនឹង ការដើរ ទិញ ឥវ៉ាន់ ដែល បាន រកឃើញ ។
ពេលអ្នកបន្ទោសអ្នក ប្រាជ្ញ គាត់នឹងស្រឡាញ់អ្នក ។
វា ល្អ សម្រាប់ ប្រជាជន ចិន ។
ខ្ញុំ រីករាយដែលបានឮថានាងធ្វើបានល្អ បន្ទាប់ពីការ ប្រកួតរបស់នាង ។ ហើយ ដើម្បីឱ្យ នាង អាច រក្សា ជើង របស់ នាង បាន ។
បច្ចុប្បន្ននេះគេ សន្មតថាជាឆ្នាំនៃការ សាងសង់ប្រាសាទ ។
អ្នក គឺជា វីរបុរស របស់ ខ្ញុំ ថ្ងៃ នេះ ។
ស្ត្រី ជនជាតិ អៀរឡង់
កុំ បង្ខំ កុមារ ឱ្យ ទន្ទេញ ក្នុង ពេល តែ មួយ ។
ខ្ញុំ ចង់ ក្លាយជា កូនក្មេង ។
ទឹក រហូតដល់ វា ទៅដល់ ជញ្ជាំង រវាង រណ្តៅ មូល
ហើយ អាវ ធំ ត្រូវបាន ពាក់ សម្រាប់ ការលួងលោម ។
ចាប់ពួកគេ ដូច្នេះពួកគេបាន ផល
បន្ទាប់ពី ការវាយប្រហារ កេះ ត្រូវបាន ដោះស្រាយ ( ថា តើ វា ចោទប្រកាន់ ពួកគេ ( ប្រសិនបើ មាន ) ។
ហើយប្រសិនបើអារក្សសាតាំងក្រោកឈរទាស់នឹងខ្លួន ហើយបែកបាក់គ្នា នោះវាមិនអាចឈរបានឡើយ ប៉ុន្តែត្រូវ បញ្ចប់ទៅ ។
ក៏គួប ផ្សំនឹងការ ភ័យខ្លាចថាក្រុម ប្រឹក្សានេះអាចត្រូវបានគេប្តឹង ។
ពួកគេជាច្រើនក៏បានតាំងលំនៅក្នុងប្រទេសនេះដែរ ។
ពួកគេ ដើរលេង ខ្ញុំ មិន អាច យក បច្ចេកវិទ្យា តិចតួច ចេញ ពី ដៃ របស់ ពួកគេ បាន ទេ ។
១១ ប៉ុន្តែ ប្រជាជនរបស់យើងមិនព្រមស្ដាប់សំឡេងរបស់យើងទេ ហើយអ៊ីស្រាអែលក៏មិនព្រមទទួលខ្ញុំដែរ ។
គាត់បង្រៀនពួកគេឲ្យបន្តសុបិនរបស់ពួកគេ ហើយ « ចាប់យកថ្ងៃ » ។
គ្រួសារ របស់ ខ្ញុំ មាន ឥទ្ធិពល យ៉ាង ជ្រាលជ្រៅ បំផុត មក លើ ខ្ញុំ ពីព្រោះ ពួកគេ តែងតែ ជឿជាក់ លើ ខ្ញុំ ។
ពេលខ្លះខ្ញុំភ្ញាក់ផ្អើលថាខ្ញុំនិងអ្នកផ្សេងទៀតអាចធ្វើ កិច្ចការនេះបានទាំងអស់ ។
ខ្ញុំបានដើរចេញនៅពេលដែលខ្ញុំបានឮដូច្នេះ ។
កម្មវិធី ទូរទស្សន៍ នៅលើ តន្ត្រី របស់ ខ្ញុំ ។
ទោះបីជា ធំ ទូលាយ ក៏ដោយ
ការលំបាក ក្នុង ការសិក្សា ១៣.
តើ អ្នក អាច ទិញ ធានារ៉ាប់រង លើ ផ្ទះ អ្នកជិតខាង បាន ទេ ?
សម្អាត ស៊ីម កាត ។
ប្រសិនបើ ពួកគេ បង្ហាញ ថា មាន លទ្ធភាព ពួកគេ អាចនឹង ពង្រីក ជារៀងរាល់ ឆ្នាំ ។
បាន វិសុទ្ធ និង គោរព ដល់ ព្រះ។
« តើអ្នក រាល់គ្នាមិនដឹងថាមនុស្សទុច្ចរិតនឹងមិនទទួលរាជាណាចក្ររបស់ព្រះជា មរដកទេ ? » ។
វា នឹង មាន សំឡេង ស្រទន់ នៅពេល ញ័រ ។
ត្រូវយកគ្រឿងក្រអូបពីរ តម្លឹង មកលើវា ។
ពួកគេបានបែកគ្នាតាំងពីខែ វិច្ឆិកា ឆ្នាំ ២០១១ ។
៣៧ ពេលរកឃើញគាត់ក៏និយាយទៅគាត់ថា៖
ខ្ញុំបានឆ្លើយ ថា៖ « ខ្ញុំឃើញជើង ចង្កៀងមាសដ៏រឹងមួយ មានចានមួយនៅលើ ហើយ ចង្កៀងប្រាំពីរនៅលើនោះ មាន ចង្អូរប្រាំពីរសម្រាប់ ចង្កៀង ។
ប្រសិនបើ វា បង្ហាញ ថា វា ប្រហែលជា មាន អ្វី ខុស៖
ជីវិត មនុស្ស ត្រូវបាន បំផ្លាញ ។
ដែល យើង នឹង អាច ទទួលបាន ព្រះគុណ របស់ ព្រះជាម្ចាស់ ។
ហើយកុំខ្លាចប្រជាជនក្នុងស្រុកឡើយ ព្រោះយើងនឹងលេបត្របាក់គេ » ( ជន គណនា ១៤: ៩) ។
ខ្ញុំបានឮសំឡេងមួយដែលខ្ញុំមិនបានដឹង៖
កុមារ ត្រូវ មាន ការត្រួតពិនិត្យ គ្រប់ ពេលវេលា ។
មតិ យោបល់ ប្រសិនបើ អ្នក ចង់បាន ។
“ ខ្ញុំពិតជា រីក រាយណាស់ដែលបានកូនស្រីទាំងពីរនាក់នេះជាកូនស្រីរបស់ខ្ញុំ ។
ប្រទេស ចិន បាន ផ្តល់ ការការពារ ការទូត ដល់ មីយ៉ាន់ម៉ា ជា យូរ មកហើយ ។
ការផ្សាយ ពាណិជ្ជកម្ម ផ្ទាល់ខ្លួន នៅក្នុង រីណូ និង ផ្កា ភ្លើង ។
កុំ ទិញ មិន ដំណើរការ ល្អ ។
១៥ ពីព្រោះគេបានប្រព្រឹត្តអំពើអាក្រក់នៅចំពោះមុខខ្ញុំ ហើយបានធ្វើឲ្យខ្ញុំខឹង ចាប់តាំងពីថ្ងៃដែលបុព្វបុរសរបស់ពួកគេបានចេញពីស្រុកអេស៊ីប រហូតមកដល់សព្វថ្ងៃនេះ ។
ប្រោសទ្រង់ឲ្យមានព្រះជន្មរស់ឡើងវិញ អ្នកនឹងបាន សង្គ្រោះ » ។
ជាច្រើន កំពុង កើតឡើង ហើយ នឹង កើតឡើង នៅ ជុំវិញ យើង ។
ក្នុង នាមជា អ្នកជំនួស យើង មិន ទទួលបាន ប្រាក់ខែ ទេ ប្រសិនបើ យើង មិន ធ្វើការ មួយ ថ្ងៃ ។
« ដូច្នេះ ទោះបីអ្នកបរិភោគ ឬផឹក ឬធ្វើអ្វីក៏ដោយ ចូរធ្វើគ្រប់យ៉ាងដើម្បីសិរីល្អរបស់ព្រះ។
6:10 ហើយគាត់បានហៅមិត្ត ភក្តិទាំងអស់របស់គាត់ , ហើយមាន ប្រសាសន៍ទៅពួកគេ :: ការ គេងបាត់ពីភ្នែករបស់ខ្ញុំ , ហើយខ្ញុំបានធ្លាក់ទៅឆ្ងាយ , ហើយ ចិត្តរបស់ខ្ញុំត្រូវបានគេទម្លាក់សម្រាប់ .
គាត់បានពន្យល់ ថា៖ « ខ្ញុំមិនដែលដឹងថាគាត់ផឹកគ្រឿងស្រវឹងទេ ។
នេះ ជារូប ភាពល្អប្រសើរនៃការ ឡើងភ្នំ ។
ខ្ញុំមានអារម្មណ៍ថាឧទ្យានគឺពិសិដ្ឋ » ។
ម៉ារៀ បាននិយាយថា៖ « ឧបសគ្គដ៏ធំមួយ
អ្នក រាំ ក្បាលពោះ រាំ លើ ។
១១ ដូច្នេះ ខ្ញុំ មកក្រុងយេរូសាឡឹម ហើយនៅ ទីនោះបីថ្ងៃ ។
លើស ពី មួយ ភាគ បួន មាន ស្ថានភាព ធ្ងន់ធ្ងរ ។
ប្រជាជនមិនមកដោយ សារ តែអ៊ីហ៊ី ទេ ពួកគេមកដោយ សារ តែការ លះបង់ចំពោះព្រះ ដ៏មាន មហិទ្ធិ ឫទ្ធិ » ។
ដើម្បី ដឹង ពី សេចក្តីស្រឡាញ់ របស់ ព្រះគ្រីស្ទ ដែល ឆ្លងកាត់ ចំណេះដឹង ; ដើម្បីឲ្យអ្នក រាល់គ្នាបានពេញដោយ ភាព ពេញលេញនៃព្រះ។
« ខ្ញុំប្រាប់អ្នក រាល់គ្នាតាមការ ពិត គាត់នឹងដាក់គាត់ឲ្យគ្រប់គ្រងលើទ្រព្យ សម្បត្តិទាំងអស់របស់គាត់ ។
ព្រោះរាង កាយមនុស្សស្រីមិនត្រង់ !
អ្នកជំងឺ ជាច្រើន ដែល មាន សម្ពាធ ឈាម ខ្ពស់ នឹង មិន សម្គាល់ ឃើញ សញ្ញា ណាមួយ នៃ បញ្ហា នោះ ទេ ។
ទំនាក់ទំនង រវាង អាទិទេព និង ព្រះនាម ទ្រង់
តែ ខ្លាច ស្លាប់ ។
តើ ធ្វើ ដូចម្តេច ដើម្បី ធ្វើ ការសម្រេចចិត្ត ទីផ្សារ ដែល ជំរុញ ដោយ ទិន្នន័យ ?
ម៉ាកុស 2:27 ព្រះអង្គមានព្រះបន្ទូលទៅគេ ថា៖ « ថ្ងៃ ស ប្ប័ទកើតមកសម្រាប់មនុស្ស មិនមែនមនុស្សសម្រាប់ថ្ងៃ ស ប្ប័ទទេ ។
ជីវិត របស់ ខ្ញុំ មិន មាន ភាព រញ៉េរញ៉ៃ ទេ ។
