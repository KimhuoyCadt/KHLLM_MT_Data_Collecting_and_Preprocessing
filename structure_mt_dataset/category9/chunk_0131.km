ស្រប គ្នា នេះ អំពើពុករលួយ និង បក្ខពួក និយម ក៏ នឹង រុញ ច្រាន អោយ កូនចៅ ជំនាន់ ក្រោយ របស់ ពួកគាត់ ប្រឈម នឹង អនាគត មិន ច្បាស់លាស់ ។
របស់ គាត់ មិន មាន អាហារ ហូបចុក ទេ ។
នេះ ខ្ញុំ បាន និយាយ ជាមួយ អ្នកជំងឺ ស្រី ម្នាក់ ដែល បាន រួមភេទ ច្រើន ដង ណាស់ ក្នុង មួយ ឆាក ជីវិត របស់ នាង ។
ខ្ញុំ ខំ ទប់ទឹកភ្នែក ។
ដូចនេះ សូម កុំ ភ្ញាក់ផ្អើល នៅ ពេល ដែល វត្ថុ នៅក្នុង ខោ ប្រុស ៗ
តែង ចង់បាន បុរស រឹងមាំ ម្នាក់ ជា គូ អនាគត ។
ប្រហែល ១អាទិត្យ ក្រោយ ខ្ញុំ ក៏ បាន ទៅ មែន ។
ពួក សត្វ តោ បាន ស៊ី សាច់ គាត់ ស្ទើរតែ ទាំងអស់ នៃ ខ្លួន របស់ គាត់ ដោយ នៅសល់ ក្បាល និង ឆ្អឹង គាត់ មួយចំនួន ។
ពេលនេះ កុំ បារម្ភ នេះ ជា គន្លឹះ ងាយ ៗ
២០ សូម លើក តម្កើង សិរី រុងរឿង ព្រះជាម្ចាស់ ជា ព្រះបិតា របស់ យើង អស់ កល្បជា អង្វែង ត រៀង ទៅ ។
យ៉ាងណាមិញ បើសិនជា វារង ការរលាក មែន គឺ រលាក ទាំង ពីរ ក្នុង ពេល តែ មួយ តែម្តង ។
ការកាន់ តាម បទបញ្ញត្តិ ទាំងឡាយ របស់ ទ្រង់ ជួយ ខ្ញុំ ឱ្យ ផ្លាស់ប្តូរ អាកប្បកិរិយា របស់ ខ្ញុំ ។
ខ្ញុំ ពិតជា ពិបាក និយាយ ណាស់ ប៉ុន្តែ អ្វី ៗ
នៅ ថ្ងៃ នេះ មនុស្ស រាប់ ពាន់ នាក់ ត្រូវ គេ រំពឹង ថា នឹង មកដល់ តំបន់ ជិត ព្រំដែន នេះ ។
ច្រក ប៉ោយប៉ែត ឱ្យ អ្នក ឆ្លង ដែន ជួយ ចេញថ្លៃ ទឹក ភ្លើង
មេដឹកនាំ រូប នេះ ប្រតិកម្ម ថា អ្នកស្លាប់ ដោយ រន្ទះ បាញ់ នោះ ជា សកម្មជន បក្ស ប្រឆាំង ហើយ ថា អាច មកពី ពួកគេ ជេរ លោក ទើប មាន បាបកម្ម ពី បាតុភូត ធម្មជាតិ បែប នេះ ។
ដូច្នេះ ខ្ញុំ មិន ឃើញ ថា រឿង នេះ អាច កើតមាន ឆាប់ ៗ
នាងខ្ញុំ មាន ចំណាប់អារម្មណ៍ ចង់ ធ្វើ លំហាត់ប្រាណ ដូចជា ដើរ តិច ៗ
ខ្ញុំ នឹង ប្រយុទ្ធ លុះ ដល់ ទី បញ្ចប់ ហើយ ខ្ញុំ នឹង ឈ្នះ ។
ក៌្រចក ពណ ក្រហម ក្រមៅ ជួយ កំចាត់ ភាព រងា ក្នុង រដូវ រំហើយ ខ្ញុំ និង អ្នក
ចាប់ខ្លួន បុរស ម្នាក់ លួច កាបូប លោកស្រី …
ម្ខាង ជា ពួក អ្នក ដែល គាំទ្រ គណបក្ស កាន់អំណាច ។
ហេតុ នេះ ហើយ បានជា ខ្ញុំបាទ បញ្ជូន គាត់ មក ឯកឧត្តម ភ្លាម ហើយ ខ្ញុំបាទ បាន ប្រាប់ អស់ អ្នក ដែល ចោទប្រកាន់ គាត់ អោយ នាំ ពាក្យ បណ្តឹង មក ជូន ឯកឧត្តម តែម្តង ។
ផ្ទុយទៅវិញ ស្ទើ តែ មួយ ភាគ បី នៃ ប្រជាពលរដ្ឋ មិន បាន ទទួល នូវ សេវា ហិរញ្ញវត្ថុ ណាមួយ ឡើយ ។
ពិត ណាស់ ត្រឹមតែ អត់ង ងុយ មួយ យប់ គឺ គ្រប់គ្រាន់ នឹង ធ្វើឱ្យ ស្បែក មុខ អ្នក នឹង ប្រែ ជា ស្រអាប់ ស្លក់ បាត់បង់ សម្រស់ អស់ រលីង ទៅ ហើយ ។
តែ ពេលនេះ មិន អី ទេ ខ្ញុំ ជិត រួចផុត ទុក្ខ ទាំងអស់ នេះ ហើយ ។
ក្តីសង្ឃឹម របស់ ខ្ញុំ គឺ ថា រដ្ឋាភិបាល កម្ពុជា នឹង បង្ហាញ ដល់ យើង នូវ សុឆន្ទៈ ដែល យើង បាន បង្ហាញ ដល់ គេ ដើម្បី បន្ត ឡើងវិញ នូវ ភាពជាដៃគូ ដ៏ ពិសេស និង ខ្លាំងក្លា ដែល យើង មាន រហូតមកដល់ កាលពី មួយ ឆ្នាំ មុន នេះ ៕
របាយការណ៍ នានា អំពី ការជួញដូរ មនុស្ស និង ការរំលោភ សិទ្ធិ ការងារ របស់ ពលករ ចំណាកស្រុក ជាច្រើន របស់ ប្រទេស ម៉ាឡេស៊ី ដែល ពួកគេ ភាគ ច្រើន ជា ពលករ ដែល ធ្វើការ នៅ តាម រោងចក្រ នានា នៃ ឧស្សាហកម្ម ផលិត ស្រោម ដៃ ជ័រ របស់ ម៉ាឡេស៊ី បាន បង្ហាញ បញ្ហា សិទ្ធិ ការងារ ជាច្រើន ឆ្នាំ មកហើយ ។
ស្តាប់ បទពិសោធន៍ អ្នក ប្រឡង បាក់ឌុប ជាប់ !
នៅ ស្ងៀម បន្តិច ទើប គេ និយាយ បន្ត ៖
អ. ហ. ចាប់ខ្លួន ស្ត្រី ម្នាក់ ជា អ្នកជំនាញ ទម្លាក់ យោង
ចាប់ពី ពេល នោះ មក នាង បាន សម្តែង ក្នុង ភាពយន្ត ដទៃ ទៀត ជា បន្តបន្ទាប់ និង ទទួលបាន ពានរង្វាន់ ជាច្រើន ផងដែរ ។
ចូលរួម អបអរ កូនប្រុស យាយ អឿន ចូល រោង ការព្រឹក នេះ !
បន្តិច ហើយ ដាក់ ចូល ក្នុង ទឹក ក្តៅ អ៊ុន ៗ
លោក បាន ថ្លែង ថា ការអភិវឌ្ឍ ធនធាន មនុស្ស គឺ មាន សារៈសំខាន់ ខ្លាំង ណាស់ ។
នាង ពិតជា ស្រស់ស្អាត ខ្លាំង ណាស់ តើ មាន ការថែរក្សា បែប ណា ខ្លះ ទៅ ?
ហើយ ព្រះអង្គ ក៏ បំភ្លឺ សេចក្តីងងឹត
តើ ព្រះអង្គ ឆ្លើយតប នឹង ពាក្យ តវ៉ា របស់ ខ្ញុំ
បាន បំផ្លាញ ការរស់រាន របស់ ប្រជាជន ។
ដូច្នេះ ខ្ញុំ ត្រូវ តាម ចិត្ត គាត់ ខ្លះ ៗ
ប៉ុន្តែ ក្រុមហ៊ុន ទើបតែ ចូលទៅ តំបន់ នោះ ក្នុង ឆ្នាំ ២០១៥ ទេ ។
រីឯ យើង វិញ យើង សុំ ផ្តល់ សក្ខីភាព ល្អ អំពី គាត់ ដែរ ប្អូន ដឹង ស្រាប់ ហើយ ថា សក្ខីភាព របស់ យើង ជា សេចក្តីពិត ។
ពិត មែន ហើយ ការព្យាយាម ដាក់ ឱ្យ បាន ១ប្រកាស ក្នុង មួយ ថ្ងៃ ពិតជា មិន ងាយស្រួល ប៉ុន្មាន ទេ ។
ឬ មាស បើ អ្នកស្លាប់ នោះ ជា ព្រះរាជ វង្សានុវង្ស ឬ ជា ព្រះមហាក្សត្រ ។
ទោះជា យ៉ាងណា ក៏ដោយ លោក ប្រធានាធិបតី អូបាម៉ា និង ប្រធានាធិបតី ស៊ី បាន ចំណាយ ពេល ចរចា៣ ម៉ោង កន្លះ ៕
នេះ ក៏ ជា មូលហេតុ ដែល យើង ត្រូវ សរសើរ ដំកើង ព្រះអង្គ ផងដែរ ។
ថា នៅ ទេ ចា ពេលនេះ គ្រប់ គ្នា កំពុង កក់ក្តៅ បី បាច់ អាន់ ឆាន់ ជា ក្មួយ ពេល ទំហឹង ហើយ ចំពោះ ពួកយើង ក៏ បន្ត ធ្វើ ការ ទៅ មុខ ទៀត ពេលណា ពេល ហ្នឹង ចុះ នៅពេល ដល់ ពេលវេលា គឺ ពេលនេះ ពួកយើង សប្បាយ ចំពោះ រឿងរ៉ាវ ថ្មី ៗ
ការណ៍ នេះ មិន ត្រឹមត្រូវ ទាល់តែសោះ ដល់ ពួក អ្នក បង់ ពន្ធ សហរដ្ឋ អាមេរិក ។
ប្រសិនបើ លោកអ្នក មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ ដើម្បី ចុះឈ្មោះ បោះឆ្នោត នោះ អ្នក នឹង ត្រូវ ៖
នៅក្នុង សហរដ្ឋ អាមេរិច , អ្នក អាច
នៅពេល សួរនាំ ថា តើ ពួកគេ ត្រូវការ ធ្វើ អ្វី ដើម្បី កសាង លើ ជោគជ័យ របស់ ខ្លួន លោក បាន និយាយ ថា ត្រូវតែ ស្រេកឃ្លាន ។
ស្តេច ជ្រាប ទ្រង់ ព្រះអំណរ ពន់ ប្រមាណ ។
តាម ខ្ញុំ យល់ ប្រហែល សម្រាប់ ក្នុង ពិធី ដូចជា ដង្វាយ អាច ប្រើ ពពែ ហ្នឹង ។
ខ្ញុំ ទៅ ដេក នៅ មណ្ឌលគិរី ៣ខែ នៅ ទី រួម ខេត្ត ១អាទិត្យ មាន នរណា ប្រឆាំង ខ្ញុំ មាន នរណា ស្អប់ ខ្ញុំ ។
មនុស្ស ជាច្រើន មិន បាន ស្រឡាញ់ និង ជឿជាក់ លើ ខ្លួន ឯង គ្រប់គ្រាន់ ឡើយ ។
លោក មានប្រសាសន៍ ថា អ្វី ដែល ជា អនុសាសន៍ ផ្ទាល់ខ្លួន របស់ ខ្ញុំ គឺ មាន ប៉ុន្មាន ចំនុច ហ្នឹង ដែល គួរតែ គិត ពិចារណា ឡើងវិញ បើ មិន អញ្ចឹង ទេ ស្ថានភាព នយោបាយ វា អាចនឹង ប្រែប្រួល ដដែល ៗ
អ្នក តែងតែ គិត ពី វត្ថុ បំណង សម្រាប់ ថ្ងៃ អនាគត មុននឹង អ្នក ចាប់ផ្តើម សម្រេចចិត្ត ធ្វើ អ្វី មួយ នា ពេល បច្ចុប្បន្ន ។
ព្រះអង្គ កំណត់ ចុងបញ្ចប់ អោយ គេ
បង្ក គ្រោះថ្នាក់ ហើយ រត់ គេច រង់ចាំ ដោះស្រាយ តាម ទូរស័ព្ទ
ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ ខ្ញុំ ខ្ញុំ ក៏ មិន ដែល ធ្វើឱ្យ អ្នកណា ស្អប់ខ្ពើម ខ្ញុំ ដែរ ។
២៧រីឯ ព្រះជា ម្ចាស់ ដែល ឈ្វេង យល់ ចិត្ត មនុស្ស ទ្រង់ ជ្រាប ព្រះបំណង របស់ ព្រះវិញ្ញាណ ព្រោះ ព្រះវិញ្ញាណ ទូល អង្វរ អោយ ប្រជាជន ដ៏ វិសុទ្ធ ស្រប តាម ព្រះហឫទ័យ របស់ ព្រះជាម្ចាស់ ។
គ្រាន់តែ វាយ កំណត់ ត្រា ហើយ កម្មវិធី នេះ នឹង ធ្វើ នៅសល់ ។
