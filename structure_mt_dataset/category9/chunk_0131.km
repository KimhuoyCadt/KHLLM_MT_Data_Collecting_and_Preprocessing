ជា ចេញមុខចេញមាត់ ខ្លាំង ដូចជា ពេល មុន ៗ
គាត់ ក៏ បាន ដឹកនាំ ពួកគេ ដោយ សេចក្តីជំនឿ ឆ្ពោះ ទៅរក ជ័យជម្នះ ដ៏ អស្ចារ្យ ។
ដូចនេះ គួរតែ ប្អូន ៗ
សូម ប្រាប់ អោយ ដឹង ចុះ ទង្វើ ដែល អ្នក អែង បាន ធ្វើ ឥឡូវ វា កំពុងតែ នឹង
យើង ប្រកួតប្រជែង ជាមួយ ពិភពលោក ហើយ ខ្ញុំ ចង់ឱ្យ ប្រទេស អាមេរិក ឈ្នះ ។
អ្នកនាង ចន ច័ន្ទ លក្ខិណា ប្រាប់ ឱ្យដឹង ទៀត ថា ៖
ចូរ យើង ជា អ្នក ជឿជាក់ ស្មោះស្ម័គ្រ តាម បែប ដូនតា
ចូរ នាំ បងប្អូន របស់ លោក វិលត្រឡប់ ទៅ ទីក្រុង វិញ ចុះ ។
សួរ ព្រះពុទ្ធ ព្រះអង្គ ត្រាស់ ថា ពួក ប្រេត ជា ញាតិ របស់ ព្រះអង្គ នាំគ្នា យំ ទារ
ប៉ូលិស កំពុង តាម រក ចាប់ខ្លួន គាត់ នៅក្នុង ព្រៃ នោះ ។
ប្រជាជន ជប៉នុភាគ ច្រនើ មិន អាច និយាយ ភាសា អង់គស្ល បោន
នៅពេល បាន សិទ្ធិ ធ្វើ នយោបាយ ឡើងវិញ តើ មន្ត្រី បក្ស ប្រឆាំង នឹង ធ្វើ យ៉ាងម៉េច បើ គ្មាន បក្ស បែប នេះ ?
តែ ពេល បាន ចូល ប្រឡូក ក្នុង ពិភព សប្បាយ នេះ ហើយ ពួកគេ ប្រែ រូប ប្រែ រាង ទៅជា ស្រស់ស្អាត រហូតដល់ អ្នកគាំទ្រ ខ្លះ ដេក យល់សប្តិ ឃើញ មិន ឈប់ ។
ទំនុក របស់ ស្តេច ដាវីឌជា អ្នក បំរើ ព្រះអម្ចាស់ ។
ប្រសិនបើ គ្មាន ការចាំបាច់ អ្នក អាច សិក្សា តែ ម្នាក់ឯង បាន ហើយ ។
អរគុណ នាងខ្ញុំ សុំ ចេញ អាហារ បី ពេល ពេញ
គេ ព្រម តម្លើង តែ ៩ដុល្លារ ប៉ុណ្ណោះ ។
ការធ្វើដំណើរ ចុង សប្តាហ៍ នេះ មិន ត្រូវបាន ប្រកាស ទេ មុនពេល លោក ត្រាំ បាន ចេញ លិខិត របស់ គាត់ ។
កុមារ ទាំង ពីរ ដើរ ចេញពី ទីនោះ ទៅ ។
លោកជំទាវ ក៏ បាន អបអរសាទរ និង ទទួលយក នូវ បទពិសោធន៍ ដ៏ ល្អ ៗ
ណ្ហើយ ចុះ យើង រង់ចាំ ៤ឆ្នាំ ទៀត ៕
ខ្ញុំ នៅតែ ត្រូវការធ្វើការ ជាមួយនឹង ពួកគេ នៅ ពេលណា ដែល ចាំបាច់ ។
ប៉ាឱ្យ ឧទាហរណ៍ ពី កម្លាំង ទឹកប្រាក់ បាន ទេ ខ្ញុំ ចង់ ដឹង ណាស់ ?
គ្រប់ យ៉ាង សម្រាប់ ពួកគេ ។
ពិសេស ការ ដែល ខ្ញុំ លើក រឿង នេះ មក និយាយ ព្រោះ ខ្ញុំ ចង់ បង្ហាញ ពី ទឹកចិត្ត ម្តាយ ចំណាស់ ម្នាក់ ប៉ុណ្ណោះ ។
ពួកគាត់ កំពុងតែ ផ្លាស់ប្តូរ ពិភពលោក ជាមួយនឹង អ្នកគាំទ្រ របស់ ខ្លួន ។
មិន ត្រឹមតែ បង្ហាញ វត្តមាន នោះ ទេ ថ្នាក់ដឹកនាំ របស់ តូយ៉ូតា ក៏ បាន មករាក់ទាក់ ភ្ញៀវ ជាមួយ ទឹកមុខ ញញឹមញញែម ព្រមទាំង បាន ចុះ មក ទទួល អតិថិជន ដោយ ផ្ទាល់ ។
ធ្វើ ដូច្នេះ ព្រះអម្ចាស់ ជា ព្រះរបស់ អ្នក នឹង ប្រទាន ពរ អោយ អ្នក បាន ចំរុង ចំរើន ក្នុង គ្រប់ កិច្ចការ ដែល អ្នក ធ្វើ ។
ចម្អិន សាច់ ទៅ ១៤៥ អង្សា សេ៦៣ អង្សា សេ សម្រាប់ ការកាត់ សាច់ ទាំងមូល ។
ចម្លើយ នេះ មាន តែ រង់ចាំ ឱ្យ សាមីខ្លួន ឆ្លើយ ដោយ ផ្ទាល់ ហើយ ៕
ដើម្បី រក យុត្តិធម៌ ជូន កូនក្តី ខ្ញុំ ៗ
ឥឡូវ យើង ពឹងផ្អែក លើ ខាងក្រៅ ។
ពលរដ្ឋ នឹង កាន់តែ អស់ ជំនឿ លើ អាជ្ញាធរ បើ រក មិន ឃើញ ការពិតប្រាកដ រឿង នៅ ប៉ោយប៉ែត
អ្នកណា ស្រេកឃ្លាន សេចក្តីសុចរិត ,
ដូចនេះ នាង ក៏ បាន និយាយ សា ឡើងវិញ ម្តង ទៀត ហើយ នៅតែ គ្មាន នរណា ឆ្លើយតប ដដែល ។
លោក បាន បន្ត ថា ការវាយប្រយុទ្ធ គ្នា ឥឡូវ រុល ចូល តំបន់ មាន មនុស្ស រស់ នៅ ច្រើន ៗ
១កុំ ទាន់ សម្រេច អ្វី ទាំងអស់
ប៉ុន្តែ នាង មិន បាន សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ទេ ។
ខ្ញុំ គិត ថា ក្នុង នាម ជា អ្នកនិពន្ធ យើង តែងតែ បន្ត រៀន ការ សរសេរ សំណេរ របស់ យើង ។
នៅ ថ្ងៃ ដែល ព្រះជា ម្ចាស់ បង្កើត មនុស្ស ព្រះអង្គ បាន បង្កើត គេ អោយ មាន លក្ខណៈ ដូច ព្រះជា ម្ចាស់២ ព្រះអង្គ បង្កើត គេ ជា បុរស ជា ស្ត្រី និង ប្រទាន ពរ អោយ គេ ហើយ នៅ ថ្ងៃ ដែល ព្រះអង្គ បង្កើត គេ មក នោះ ទ្រង់ ហៅ គេ ថា មនុស្ស ។
និង យុត្តិធម៌ នៅក្នុង ស្រុក អ៊ីស្រាអែល !
សម្តេច សាយ ឈុំ ទទួលទាន បាយ ថ្ងៃត្រង់ ជាមួយ អ្នក រត់ ម៉ូតូ ឌុប
ក្នុង ឆ្នាំ ១៩៥០ ថ្នាំជក់ ដ៏ ធំ បាន បង្កើត សៀវភៅ ចាក់ ។
ជាច្រើន ដែល ធ្វើឱ្យ អ្នកប្រើប្រាស់ ។
ដូច្នេះ ចូរ ព្យាយាម សម្រក ទម្ងន់ សិន មុននឹង សម្រេចចិត្ត យក កូន ។
នោះ ក៏ បាន ដក ទូរស័ព្ទ របស់ គាត់ ដើម្បី យក ផ្តិត យក ទស្សនីយភាព នេះ ។
ទាំងអស់ ដែល នៅ ស្ថាន ទាំងនោះ បន្លឺ សំឡេង ឡើង ថាៈ សូម ព្រះអង្គ ដែល គង់ លើ បល្ល័ង្ក និង កូន ចៀម ទទួល ពាក្យ សរសើរ តម្កើង ព្រះកិត្តិនាម សិរី រុងរឿង និង ព្រះចេស្តា អស់ កល្បជា អង្វែង ត រៀង ទៅ !
គាត់ បញ្ចុះបញ្ចូល នាង ឱ្យ ចូលរួម ជាមួយ គាត់ នៅ ប្រទេស ស៊ីរី ។
គឺជា វិធី ដ៏ ល្អ មួយ ដើម្បី ស្គាល់ គ្រូ និង ដឹង ការរំពឹងទុក របស់ កូន អ្នក ។
នៅ ពេល នេះ បុរស មិន ទាន់ ឆ្លង ផុត គ្រោះ យាយី នៅឡើយ ទេ ហេតុ នេះ ទោះ ធ្វើ អ្វី ក៏ដោយ គប្បី មាន ការប្រយ័ត្នប្រយែង ។
កាលពី សប្តាហ៍ មុន មាន ការចាប់ខ្លួន ជា មធ្យម ចំនួន ៤, ៥០០នាក់ ក្នុង មួយ ថ្ងៃ ។
១៣ បុណ្យ ចម្លង របស់ ជនជាតិ យូដា ជិត មកដល់ ហើយ ព្រះយេស៊ូ ក៏ យាង ឡើង ទៅ ក្រុង យេរូសាឡឹម ។
នៅ អង់គ្លេស និង អេស្ប៉ាញ ខ្ញុំ តែងតែ បង់ប្រាក់ ជានិច្ច ។
នេះ ជា ពេលវេលា ដ៏ សំខាន់ សម្រាប់ បុរស ខ្លាំង ចិន …
រឿង ហេតុ ពិត របស់ ខ្ញុំ ប្រាប់ ថា ខ្ញុំ ស្ថិត ក្នុង ស្ថានភាព កាន់តែ តានតឹង ទៅ ៗ
អំឡុង ពេល នោះ នាង ពុំ បាន ទទួល មុខតំណែង អ្វី ឡើយ ប៉ុន្តែ បទពិសោធន៍ ល្បិច កល ជំនួញ ត្រូវបាន ឪពុក ចិញ្ចឹម ផ្ទេរ ឱ្យ យ៉ាង ស្ងៀមស្ងាត់ ។
គ្មាន សាច់ញាតិ ច្រើន កុះករ ចូលរួម នោះ ទេ ។
ព្រះអង្គ ត្រូវ ជា ព្រះអនុជជីដូ …
ដឹក ចេញ ពី កុងតឺន័រ
ដ្បិត គឺ ព្រះហើយ ដែល ជា ចៅក្រម ។
វីដេអូៈ ៦ម្លប់ សន្តិភាព
ឥលូវ យើង ទៅតាម ដាន ទស្សនា ទាំងអស់ គ្នា ទៅ មើល ៕
ព្រោះ ខ្ញុំ មិន បាន បោះបង់ ចោល ព្រះបន្ទូល របស់ ព្រះដ៏ វិសុទ្ធ ឡើយ ។
វណ្ណាវត្តី ស្ទុះ ឡើង កូដ ក្រោយ វិលវិញ - សារព័ត៌មាន នគរ ធំ
