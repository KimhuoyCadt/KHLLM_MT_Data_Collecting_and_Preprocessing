( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ម្នាក់ . របួស ធ្ងន់ ១០នាក់ និង របួស ស្រាល ៧នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៥លើក នេះ បណ្ដាលឲ្យ ខូចខាត ម៉ូតូ ចំនួន ៣គ្រឿង . រថយន្ត តូច ៣គ្រឿង . រថយន្ដ ធុង ធំ៣ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន គោរព សិទ្ធិ . មិន ប្រកាន់ ស្ដាំ . ស្រវឹង និង ប្រជែង ។
សូម បញ្ជាក់ ថា នៅ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ នេះ វីដេអូ ឃ្លីប មួយ បង្ហាញ ពី សកម្មភាព ក្រុម ជន ប្រកាស បង្ក អសន្តិសុខ នៅក្នុង ក្រុង ព្រះសីហនុ ត្រូវបាន គេ ចែកចាយ តាម បណ្តាញ ទំនាក់ទំនង សង្គម ។ នៅក្នុង វីដេអូ ក្រុម ជនជាតិ ចិន មួយ ក្រុម នេះ បាន និយាយ ថា ពួកគេ មកពី ខេត្ត ឆុង ឆីង ហើយនិយាយ ទៀត ថា កំពង់សោម ៣ឆ្នាំ ក្រោយ ពួកគេ ចង់ឲ្យ វឹកវរ គឺ វឹកវរ . ចង់ឲ្យ សុវត្ថិភាព គឺ សុវត្ថិភាព ។
វីដេអូ ឃ្លីប មួយ នេះ នាំឱ្យ ការចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ពី ប្រជាពលរដ្ឋ ខ្មែរ និង ចែកចាយ បន្ត យ៉ាង ផុល ផុស ។ ក្រោយ វីដេអូ នេះ បែក ធ្លាយ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ បាន ចេញ បញ្ជា ឱ្យ តាម វែក មុខ ជនជាតិ ចិន មួយ ក្រុម នេះ ភ្លាម ៗ ផងដែរ ។
ឧត្តមសេនីយ៍ ទោ ជួន ណារិន ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ បាន អះអាង ថា កម្លាំង នគរបាល ខេត្ត ព្រះសីហនុ និង សមត្ថកិច្ច ជំនាញ ដទៃ ទៀត កំពុង បើក ការស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ បំផុត ដើម្បី ស្វែងរក ការពិត និង វែក រក មុខ ក្រុម ជនជាតិ ចិន មួយ ក្រុម នេះ ៕ កម្លាំង នគរបាល ខេត្ត ព្រះសីហនុ ចាប់ខ្លួន ជនជាតិ ចិន ម្នាក់ ពាក់ព័ន្ធ ករណី ប្រើប្រាស់ និង ចែកចាយ គ្រឿងញៀន
( ព្រះសីហនុ) ៖ កម្លាំង នគរបាល ខេត្ត ព្រះសីហនុ ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត នៅ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០៩១ នេះ បាន ចាប់ខ្លួន ជនជាតិ ចិន ម្នាក់ ដែល ពាក់ព័ន្ធ ករណី ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន ស្ថិត នៅ ក្រុម ទី៤៥ ភូមិ ៥ សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុ ។
របាយការណ៍ សមត្ថកិច្ច បាន បញ្ជាក់ ថា ដោយ ឡើយ កម្លាំង នគរបាល ជំនាញ កំពុង ល្បាត ក្នុង មូលដ្ឋាន ស្មុគស្មាញ់ ស្រាប់តែ បាន ប្រទះឃើញ ជនជាតិ ចិន ម្នាក់ កំពុង ជិះ ម៉ូតូ មើល ទៅ គួរឲ្យ សង្ស័យ ក៏ បាន ឃាត់ សួរនាំ និង ពិនិត្យ ម៉ូតូ ដែល រូប គេ ជិះ រួច ឈាន ទៅ ឆែក ផ្ទះ ដែល ជួល ស្នាក់ នៅ ស្ថិត ក្នុង ភូមិ១ សង្កាត់ ៣ ក្រុង ព្រះសីហនុ ។
រថយន្តក្រុង ដឹក អ្នកដំណើរ ភ្នំពេញ - វៀតណាម បើក លឿន ដូច ហោះ បុក ម៉ូតូ ស្លាប់ ម្នាក់ នៅ ស្រុក កៀនស្វាយ
( កណ្តាល ) ៖ យុវជន ម្នាក់ ត្រូវបាន ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុ ដោយសារ រថយន្តក្រុមហ៊ុន ដឹក អ្នកដំណើរ ពី ភ្នំពេញ ទៅ ប្រទេស វៀតណាម និង ពី ប្រទេស វៀតណាម មកកាន់ រាជធានី ភ្នំពេញ បុក នៅលើ ចំណែក ផ្លូវ ម៉ូតូ អ្នកបើកបរ រថយន្ត ព្យាយាម រត់គេចខ្លួន បាត់ បន្សល់ទុក រថយន្ត ចោល កន្លែង កើត ហេតុ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ រសៀល ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ នេះ នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ១ ចន្លោះ គីឡូម៉ែត្រ លេខ ៤០ និង ៤១ ភូមិ ជ្រោយ ដង ឃុំ សំរោង ធំ ស្រុក កៀនស្វាយ ខេត្ត កណ្តាល ។
នគរបាល បាន បន្ត ទៀត ថា មុនពេល កើត ហេតុ គេ ឃើញ រថយន្ត បង្ក បើកបរ ក្នុង ទិសដៅ អ្នកលឿង ភ្នំពេញ ក្នុង ល្បឿន លឿន ខ្លាំង ។ លុះ ដល់ ចំណុច កើត ហេតុ ទំនងជា ឡើង ជែង គេ ចូលទៅ ចំណែក ផ្លូវ ម៉ូតូ ដែល កំពុង បើកបរ បញ្ច្រាស ទិស គ្នា បុក ម៉ូតូ យ៉ាង ពេញ ទំហឹង បណ្តាលឲ្យ អ្នកបើកបរ ម៉ូតូ គៀប អ្នកបើកបរ ម៉ូតូ ជាប់ ស្លាប់ ។
ក្រោយ កើត ហេតុ អ្នកបើកបរ រថយន្ត មិន នៅ ទទួលខុសត្រូវ នោះ ទេ ព្យាយាម រត់គេចខ្លួន បាត់ ។ ភ្លាម នោះ ដែរ នគរបាល ចរាចរ ស្រុក កៀនស្វាយ បាន ចុះ ទៅដល់ ជួយ អន្តរាគមន៍ វាស់វែង និង សន្និដ្ឋាន រួច ប្រគល់ សាកសព ជូន ទៅ ក្រុមគ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ។ ចំណែក វត្ថុតាង ទាំង២ ត្រូវ យក ទៅ រក្សាទុក នៅ អធិការដ្ឋាន ដើម្បី កសាង សំណុំ បន្ថែម បញ្ជូន មកកាន់ ស្នងការ ខេត្ត កណ្តាល ផ្នែក ចរាចរ ដើម្បី បន្ត នីតិវិធី ។
ពលរដ្ឋ ធ្វើដំណើរ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ១ បាន និយាយ ថា រថយន្តក្រុមហ៊ុន ដឹក អ្នកដំណើរ ពី ភ្នំពេញ ទៅ ប្រទេស វៀតណាម និង វៀតណាម មក ភ្នំពេញ នេះ បើក លឿន ៗ ណាស់ ។ ពួកគេ បើក ជែង គេ ជែង ឯង យក តែ ពី ឈ្នះ ដៃ មិន គិត អាយុជីវិត អ្នកដំណើរ នោះ ទេ មិន ដឹង ជា ច្បាប់ នៅ ក្រុមហ៊ុន គេ នឹង យ៉ាងម៉េច ទេ បានជា បើក មិន ប្រណី សោះ ។
ប្រជាពលរដ្ឋ សំណូមពរ ដល់ ក្រសួង ទេសចរណ៍ ពិនិត្យ ក្រុមហ៊ុន មួយ នេះ និង ធ្វើ លក្ខណ ឲ្យ ក្រុមហ៊ុន ណែនាំ ដល់ អ្នកបើកបរ គោរព ច្បាប់ ចរាចរណ៍ ផង និង បើក ឲ្យ សម ល្បឿន និង ផ្លូវ ចង្អៀត ឬ ផ្លូវ វាល ផង កុំ ដឹង តែ លឿន បែប នេះ ៕ វត្ត ចំនួន ៣ នៅ ស្រុក ស្អាង ខេត្ត កណ្ដាល ទទួលបាន ស៊ីម៉ង់ត៍ ពី សប្បុរសជន
( កណ្តាល ) ៖ គណកម្មការ អាចារ្យ វត្ត និង ព្រះសង្ឃ គង់ នៅ វត្ត ត្រពាំង ឈូក វត្ត ព្រែក តូច និង វត្តភ្នំ ធន់មន្ត ក្នុង ស្រុក ស្អាង ខេត្ត កណ្ដាល កំពុង មាន ការខ្វះខាត ពេល ដំណើរការ សាងសង់ សំណង់ អគារ សម្រាប់ ពុទ្ធ បរិស័ទ គោរព បូជា និង ដើម្បី លើកស្ទួយ វិស័យ ព្រះពុទ្ធ សាសនា ។
លោក សេង សុជាតិ អធិការ នគរបាល ស្រុក ស្អាង បាន គៀង គរ សប្បុរសជន នានា នៅក្នុង មូលដ្ឋាន របស់ លោក ឲ្យ ចូលរួម ជួយ ឧបត្ថម្ភ ជា ថវិកា និង សម្ភារ ទៅ តាម សទ្ធា ជ្រះថ្លា រៀង ៗ ខ្លួន ហើយ សប្បុរ ជន បាន ចូលរួម យ៉ាង សស្រាកសស្រាំ បាន ស៊ីម៉ង់ត៍ ចំនួន ១៥តោន នាំយក ទៅ ប្រគេន ជូន ព្រះសង្ឃ គង់ នៅ វត្ត នៅ វត្ត នីមួយ ៗ នៅ ព្រឹក ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ ។
លោក សេង សុជាតិ បាន ឲ្យដឹង ថា វត្ត ដែល លោក នាំយក ស៊ីម៉ង់ត៍ ទៅ ប្រគេច ជូន ព្រះសង្ឃ នោះ មាន វត្ត ចំនួន ៣ ទី ១៖វត្ត ត្រពាំង ឈូក . ទី ២៖ វត្ត ព្រែក តូច និង ទី ៣៖វត្តភ្នំ ធន់មន្ត ដោយ ក្នុង មួយ វត្ត លោក ប្រគេន ជូន ស៊ីម៉ង់ត៍ ចំនួន ៥តោន និង ឧបត្ថម្ភ ជូន យាយ ជីតា ជី នៅក្នុង វត្ត ដោយ សរុប អស់ ចំនួន ១លាន រៀល ផងដែរ ។
លោក បាន បន្ត ថា ស៊ីម៉ង់ត៍ ទាំងអស់ គឺ លោក បាន មកពី សប្បុរសជន នានា នៅក្នុង ឃុំ ត្រើយ ស្លា ឃុំ ព្រែក គយ ឃុំ ស្វាយ ប្រទាល ឃុំ សត្បូត៍ និង សប្បុរសជន នៅ ស្រុក កោះ ធំ មួយចំនួន ផងដែរ ។ ជាមួយគ្នា នេះ លោក បាន ថ្លែងអំណរគុណ ម្ចាស់ អំណោយ ទាំងអស់ ដែល បាន លះបង់ ថវិកា ផ្ទាល់ខ្លួន ដើម្បី ជួយ ឧបត្ថម្ភ ដល់ ព្រះសង្ឃ កំពុង ខ្វះខាត តាមរយៈ លោក និង សូមឲ្យ លោក អ្នក ទាំងអស់ ទទួលបាន នូវ កុសល ផល បុណ្យ និង មាន សេចក្តីសុខ ក្នុង ក្រុមគ្រួសារ រកស៊ី ទទួលទាន មាន បាន ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប គ្រឿងញៀន ខុស ច្បាប់ ចំនួន ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ប្រើប្រាស់ ចំនួន ២៦ នាក់ ( ស្រី ៤នាក់ ) ។
បើ យោង តាម របាយការណ៍ របស់ គណៈកម្មការ ទី៣ នៃ យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ បាន ឲ្យដឹង ថា ប្រភេទ បទល្មើស រួម មាន៖ ជួញដូរ ៦ករណី ឃាត់ខ្លួន ១៥នាក់ ( ស្រី ២នាក់ ) និង ប្រើប្រាស់ ៤ករណី ឃាត់ខ្លួន ១១នាក់ ( ស្រី ២) ។
( ភ្នំពេញ ) ៖ ដើម្បី បម្រើ ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព លើស ពី អ្វី ដែល បាន ធ្វើ រាល់ ថ្ងៃ នេះ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន បង្កើត នូវ កម្មវិធី ជជែក ផ្ទាល់ (Live Chat) ក្នុង ន័យ បង្ក លក្ខណៈ ងាយស្រួល ឲ្យ អ្នក ជាប់ ពន្ធ ងាយស្រួល ក្នុង ការជជែកគ្នា ដោយ ផ្ទាល់ ពាក់ព័ន្ធ នឹង ពន្ធដារ ដោយ គ្រាន់តែ ផ្ញើ សារ ឆ្លើយឆ្លង ជាមួយ មន្ដ្រី ជំនាញ ពន្ធដារ ។
លោក ស សុខា បើក យុទ្ធនាការ ហាត់ ហ្វឹកហ្វឺន ក្រុម ជម្រើសជាតិ និង ក្រុម ថ្នាល ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ នេះ លោក ស សុខា រដ្ឋលេខាធិការ តំណាង លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក យុទ្ធនាការ ហាត់ ហ្វឹកហ្វឺន ក្រុម ជម្រើសជាតិ និង ក្រុម ថ្នាល ឆ្នាំ ២០១៩ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ ។
ក្នុង ឱកាស នោះ ទាំង ជម្រើសជាតិ និង ថ្នាល មាន កីឡាករ កីឡាការិនី ជាង១.០០០ នាក់ និង មាន ៣៥ ប្រភេទ កីឡា យកមក ហ្វឹកហាត់ ដើម្បី ពង្រឹង សមត្ថភាព ឲ្យ កាន់តែ ខ្លាំង ត្រៀម ចូលរួម ព្រឹត្តិការណ៍ អាស៊ីហ្គេម ឆ្នាំ ២០២៣ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ។
លោក ស សុខា ថ្លែង ទៅកាន់ ក្រុម កីឡាករ កីឡាការិនី ដោយ ណែនាំឲ្យ គោរព បញ្ជា ផ្ទៃក្នុង និង យល់ អធ្យាស្រ័យ គ្នា ក្នុង រយៈកាល រស់ នៅ ជាមួយគ្នា ព្រោះ គ្នា ច្រើន តែង ប៉ះទង្គិច គ្នា ។ អ្វី ដែល លោក សង្កត់ធ្ងន់ នោះ គឺ ត្រូវ មាន ឆន្ទៈ មុះ មុត ក្នុង ការហ្វឹកហាត់ ដើម្បី ប្រកួត លើក ទង់ជាតិ កម្ពុជា នៅ បរទេស ចៀសវាង ការប្រកួត ដើម្បី តែ ប្រាក់ រង្វាន់ ៕
សេចក្ដីរាយការណ៍ ខាង លើ កើត មាន ឡើង បន្ទាប់ពី ក្រុម មន្ត្រី អាមេរិក បាន អះអាង កាលពី ខែមីនា ថា សហរដ្ឋ អាមេរិក កំពុង ប្រឹងប្រែង បញ្ចុះបញ្ចូល ឱ្យ ឥណ្ឌា បោះបង់ ចោល គម្រោង ទិញ S-400 ។ ប៉ុន្តែ បើសិនជា ឥណ្ឌា នៅតែ ទិញ ប្រព័ន្ធ មីស៊ីល នេះ ពី រុស្ស៊ី នោះ អាចនឹង ប្រឈមមុខ ជាប់ ទណ្ឌកម្ម របស់ ទីក្រុង វ៉ាស៊ីនតោន ខណៈ ការលើកលែង ការដាក់ទណ្ឌកម្ម អស់ សុពលភាព កាលពី ដើម ខែឧសភា កន្លងទៅ ។
កម្ពុជា កំពុង ចរចា នាំចេញ ផ្លែ ស្វាយ ដោយ ផ្ទាល់ ទៅកាន់ ប្រទេស ចិន (Video inside) ( ភ្នំពេញ ) ៖ បន្ទាប់ ជោគជ័យ ក្នុង ការនាំចេញ ផ្លែ ចេក ស្រស់ ទៅកាន់ ប្រទេស ចិន ហើយ នោះ រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ លោក វេង សា ខុន បាន បញ្ជាក់ ឲ្យដឹង ថា កម្ពុជា កំពុង រៀបចំ ការចរចា ជាមួយ ភាគី ចិន ដើម្បី ឈានដល់ ការសម្រេចបាន នូវ ការចុះហត្ថលេខា រួមគ្នា លើ ពិធីសារ ស្តីពី ការនាំចេញ ផ្លែ ស្វាយ ដោយ ផ្ទាល់ ពី កម្ពុជា ទៅ ទីផ្សារ ប្រទេស ចិន ថែម ទៀត ។
បច្ចុប្បន្ន ផលិតផល កសិកម្ម របស់ កម្ពុជា ចំនួន ៥មុខ ត្រូវបាន ភាគី ចិន អនុញ្ញាតឲ្យ នាំចេញ ដោយ ផ្ទាល់ គឺ អង្ករ ចំណិត ដំឡូង មី ក្រៀម ស្វាយចន្ទី ចុង អង្ករ និង ចេក ដែល ទើប សម្រេចបាន ថ្មី ៗ នេះ ។
ក្នុង ១ ឆ្នាំ ៗ កម្ពុជា ប្រមូល បាន ទិន្នផល ស្វាយ ប្រមាណ ជិត ១លាន តោន ខណៈ កម្ពុជា នាំចេញ ស្វាយ ទៅកាន់ ប្រទេស ជិតខាង រួម មាន វៀតណាម និង ថៃ ជាដើម ។
លោក ប្ត ថា « ឯក អគ្គ រាជ ទូត ខ្មែរ នៅ រដ្ឋធានី ប៉េកាំង បាន ជូន ដំណឹង មក ខ្ញុំ ថា ភាគី ចិន នឹង អញ្ជើញ កម្ពុជា ធ្វើ ការជជែក រៀបចំ ពិធីសារ ស្តី អំពី ការនាំចេញ ផ្លែ ស្វាយ ចេញ ពី កម្ពុជា អាច នៅក្នុង ខែកក្កដា ខាងមុខ នេះ ។ យើង ក៏ ចង់ លើក ជា កញ្ចប់ ដែរ ព្រោះ យើង មិន ចង់ លើក មួយ ម្តង ទេ ដែល ដំបូង ការនាំចេញ អង្ករ បន្ទាប់មកការនាំចេញ ដំឡូង មី ស្វាយចន្ទី ចុង អង្ករ និង ចេក ។ ហើយ លើក នេះ គឺ លើក ពី ផ្លែ ស្វាយ តែ យើង ចង់ លើក ជា កញ្ចប់ រួម មាន ស្វាយ តា ងែន ស្រការនាគ ជាមួយនឹង ទឹកមាត់ ត្រចៀកកាំ ផងដែរ » ។
លោក រដ្ឋមន្ត្រី បញ្ជាក់ ថា ការដាក់ ជា កញ្ចប់ នេះ ដើម្បី ងាយស្រួល ដល់ ប្រជាជន កម្ពុជា ជាពិសេស កសិករ អាច មាន លទ្ធភាព ផលិត កាន់តែ មាន ទំហំ ធំ ឡើង ដើម្បី ជា ប្រយោជន៍ ដល់ ជីវភាព រស់ នៅ របស់ ប្រជាជន ។
នៅ ឆ្នាំ ២០១៨ កម្ពុជា បាន នាំចេញ ផលិតផល កសិកម្ម ផ្លូវការសរុប ជាង ៤. ៣លាន តោន ហើយ បើសិន គិត ទាំង ផលិតផល នាំចេញ ក្រៅ ផ្លូវការ គឺ មិន តិច ជាង ៧លាន តោន ទេ ។
បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បើក វគ្គ ហ្វឹកហ្វឺន បំប៉ន យុទ្ធ វិធី ខ. គ ថ្មើរជើង និង យុទ្ធ ដំណើរ ទ័ព រយៈពេល ៤៥ ថ្ងៃ
( កំពង់ធំ )៖ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន រៀបចំ ពិធី បើ វគ្គ ហ្វឹកហ្វឺន បំប៉ន យុទ្ធ វិធី ខ. គ ថ្មើរជើង និង យុទ្ធ ដំណើរ ទ័ព ជូន នាយ ទាហាន និង ពល ទាហាន ចំណុះ ឲ្យ យោធ ភូមិភាគ ទី៤ ក្រោម អធិបតីភាព លោក ពៅ ហេង មេបញ្ជាការង កងទ័ព ជើងគោក មេបញ្ជាការ យោធ ភូមិភាគ ទី៤ និង ប្រតិភូ អម ដំណើរ រួមទាំង មេបញ្ជាការង និង នាយ ទាហាន ជាច្រើន រូប នៅ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ ។
លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន បញ្ជាក់ ពី ដំណើរការបើក វគ្គ ហ្វឹកហ្វឺន តាម ផែនការ របស់ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក និង បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ទី៤ តាម ផែនការ ថ្នាក់ លើ កំណត់ ដែល មាន សិក្ខាម ដាក់ចុះ ១០០ នាក់ បាន រៀបចំ ហ្វឹកហាត់ ដល់ កងកម្លាំង ផ្នែក សឹក រង ស្រុក ក្រុង ទាំង៨ និង វរសេនា តូច ទាំង២ នៃ បញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បំប៉ន យុទ្ធ វិធី ខ. គ ថ្មើរជើង និង យុទ្ធ ដំណើរ ទ័ព ។
វគ្គ ហ្វឹកហ្វឺន នេះ ដើម្បី បំពេញ សមត្ថភាព បន្ថែម ដល់ យោធិន ឲ្យ ក្លាយទៅជា ឧបករណ៍ ដ៏ រ៉ឹង មាំ ក្នុង ការចូលរួម រក្សា សន្តិសុខ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង ការពារ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល ប្រសូត្រ ចេញពី ការបោះឆ្នោត និង ប្រឆាំង ដាច់ខាត ចំពោះ ក្រុម ឬ សកម្មភាព ទាំងឡាយ ណា ដែល មាន ចេតនា ប្រឆាំង មក លើ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ។
លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន ឲ្យដឹង ថា រយៈពេល ហ្វឹកហ្វឺន មាន ចំនួន ៤៥ ថ្ងៃ ដែល បាន ចាប់ផ្តើម ពី ថ្ងៃទី ១១ ខែឧសភា ដល់ ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ២០១៩ សិក្ខាម ចំនួន ១០០ នាក់ គណកម្មការគ្រប់គ្រង វគ្គ ១៥នាក់ ក្រុម គ្រូ យោធាចារ្យ ចំនួន ១៨ នាក់ ក្រុម បម្រើ ចំនួន ៥នាក់ ក្នុង ចម្ងាយ យុទ្ធ ដំណើរ ៣២ គីឡូម៉ែត្រ ក្នុង តំបន់ ព្រៃឡង់ ស្រុក សណ្តាន់ ខេត្ត កំពង់ធំ និង បាន ទទួល កញ្ចប់ ថវិកា សម្រាប់ បំប៉ន ពី សម្តេច តេជោ ហ៊ុន សែន ក្នុង មួយ ថ្ងៃ៣.០០០ រៀល បន្ថែម លើ ហូប ប្រចាំ ថ្ងៃ ដល់ សិក្ខាម ។
លោក ពៅ ហេង មេបញ្ជាការង កងទ័ព ជើងគោក មេបញ្ជាការ យោធ ភូមិភាគ ទី៤ បន្ទាប់ពី ជំរាប ជូន ដល់ អង្គ ពិធី ទាំងមូល ស្តីពី សភាព ការនយោបាយ ក្នុង ប្រទេស និង ក្រៅ ប្រទេស រួច មក ក៏ បាន ណែនាំ ផ្តាំផ្ញើ និង ផ្តល់ ឱវាទ ដល់ ថ្នាក់ដឹកនាំ នាយ ទាហាន និង ពល ទាហាន នូវ អនុសាសន៍ ដ៏ មាន អត្ថន័យ ខ្លឹមសារ សំខាន់ ៗ ជាច្រើន ផងដែរ ។
ពហុកីឡដ្ឋាន ត្រៀម ស៊ីហ្គេម ឆ្នាំ ២០២៣ បញ្ចប់ គ្រឿង បង្គុំ សំខាន់ ៗ និង សម្រេច លទ្ធផល បាន ប្រមាណ ៥០ %
លោក បណ្ឌិត ថោង ខុន មានប្រសាសន៍ ថា មកទល់ ពេលនេះ ពហុកីឡដ្ឋាន ធំ បាន ចំណាយ ពេល សាងសង់ ២០ ខែ ហើយ ក្នុង ក្របខណ្ឌ ហិរញ្ញប្បទាន ឥត សំណង ពី សាធារណរដ្ឋ ប្រជាមានិត ចិន ។ ឯ លទ្ធផល សម្រេចបាន រួម មាន៖ ការសាងសង់ សម្រេចបាន លទ្ធផល ប្រមាណ ៥០% និង ការតម្លើង ថា សប ង្គុំ កៅអី បេតុង អង្គុយ ប្រមាណ ៧០% ។ ប៉ុន្ដែ សម្ភារៈ បរិក្ខា សំណង់ សម្រាប់ បម្រើ ការងារ សាងសង់ គ្រឿង បង្គុំ រួម គឺ បាន នាំចូល មកដល់ ការដ្ឋាន ១០០ % នៅឡើយ តែ សម្ភារៈ បំពាក់ នឹង ស្នើសុំ បែបបទ នាំចូល ជា បន្ដ បន្ទាប់ ។
លោក រដ្ឋមន្ដ្រី បាន គូសបញ្ជាក់ បន្ថែម ថា ក្នុង ការសាងសង់ កីឡដ្ឋាន ស្ដង់ដារ អន្ដរជាតិ នេះ ដែរ បាន ប្រើ កម្លាំង ពលកម្ម សរុប ជាង ៨០០ នាក់ ក្នុង នោះ មាន ក្រុមការងារ ជំនាញ ភាគី ចិន ប្រមាណ ៥៤០ នាក់ និង កម្លាំង ពលកម្ម ក្នុង ស្រុក ប្រមាណ ៣០០ នាក់ ។ ផ្អែក លើ ផែនការការងារ ក្នុង ខែកក្កដា ខាងមុខ ថា ស កៅអី បេតុង នឹង ត្រូវ លើក ដាក់ ចប់ សព្វគ្រប់ ហើយ នៅ ខែសីហា គ្រឿង បង្គុំ ធ្នឹម កោង ផ្នែង ប៉ម រាង បាត ដៃ ដែល បញ្ជាក់ ពី អត្តសញ្ញាណ ជាតិ និង ការគោរព និង រឹត ចំណង មិត្តភាព សាមគ្គី ក៏ នឹង ត្រូវ សាងសង់ រួចរាល់ ផងដែរ ។
សមាគម ជំងឺ ហេម៉ូហ្វីលា កម្ពុជា ផ្សព្វផ្សាយ ចំណេះដឹង និង វិធី ព្យាបាល ជំងឺ ឈាម កម្រកក . មនុស្ស ១ម៉ឺន នាក់ មាន ម្នាក់ កើត ជំងឺ នេះ !
( សៀមរាប ) ៖ សមាគម ជំងឺ ហេម៉ូហ្វីលា កម្ពុជា ( ជំងឺ ឈាម កម្រកក ) នៅ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ នេះ បាន ផ្សព្វផ្សាយ ចំណេះដឹង ស្តីពី ជំងឺ ឈាម កម្រក ក ក្នុង ពិធី បើក ទិវា ជំងឺ ហេម៉ូហ្វីលា ពិភពលោក និង សិក្ខាសាលា ស្តីពី ការព្យាបាល ដោយ ចលនា សម្រាប់ អ្នកជំងឺ ហេម៉ូហ្វីលា ក្នុង ខេត្ត សៀមរាប ។
សិក្ខាសាលា នេះ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ៣ រួម មាន៖ ១៖ ដើម្បី ចូលរួម អបអរសាទរ ទិវា ហេម៉ូហ្វីលា ពិភពលោក ក្នុង ការស្វែងរក ការគាំទ្រ ដល់ សាធារណជន សម្រាប់ ស្វែងយល់ដឹង និង គាំទ្រ បន្ថែម លើ ជំងឺ ហេម៉ូហ្វីលា នេះ . ២៖ ដើម្បី បង្រៀន គ្រួសារ សាច់ញាតិ និង អ្នកជំងឺ ស្តីពី ការព្យាបាល ដោយ ចលនា សម្រាប់ អ្នក ជំងឺ ហេម៉ូហ្វីលា . ៣៖ ពង្រឹង ទំនាក់ទំនង រវាង មន្ទីរពេទ្យ កុមារ ជាតិ មន្ទីរពេទ្យ កុមារ អង្គរ សមាគម អ្នក ព្យាបាល ដោយ ចលនា កម្ពុជា និង សមាគម ជំងឺ ហេម៉ូហ្វីលា កម្ពុជា ។
ក្នុង ឱកាស នោះ លោក សែម សុខ បញ្ញា ប្រធាន សមាគម ជំងឺ ហេម៉ូហ្វីលា កម្ពុជា បាន សំណូមពរ ដល់ សមាជិក ក្រុមគ្រួសារ និង អ្នកជំងឺ ឲ្យ មាន ការចូលរួម ជាមួយ សកម្មភាព នានា របស់ សមាគម ដើម្បីឱ្យ សមាគម មាន និរន្តរភាព និង ការគាំទ្រ ពី សាធារណជន កាន់តែ ខ្លាំងក្លា ជាង មុន ។
ជាមួយគ្នា នេះ លោក ផេង វ៉ាន់ អ្នក ព្យាបាល ដោយ ចលនា នៃ មន្ទីរពេទ្យ កុមារ ជាតិ បាន លើកឡើង ថា ការព្យាបាល ដោយ ចលនា មាន សារសំខាន់ សម្រាប់ ជួយ ដល់ អ្នកជំងឺ ឈាម កម្រក ក ឱ្យ គាត់ ចៀស ផុត ពី ពិការភាព ដូច្នេះ ជា ការសំណូមពរ ដល់ ក្រុមគ្រួសារ និង អ្នកជំងឺ ការយល់ដឹង ពី ការព្យាបាល ដោយ ចលនា គឺ កាត់បន្ថយ ពី ភាពពិការ ។
លោក ស្រេង ស៊ុង ប្រធាន អ្នកគាំទ្រ ជំងឺ ហេម៉ូហ្វីលា កម្ពុជា នៃ មន្ទីរពេទ្យ កុមារ អង្គរ បាន លើកឡើង ពី វឌ្ឍនភាព ក្នុង ការជួយ ដល់ អ្នកជំងឺ ថា បច្ចុប្បន្នភាព នៅ តំបន់ សៀមរាប នេះ មាន អ្នកជំងឺ ចំនួន ១០៨ នាក់ ហើយ មន្ទីរពេទ្យ កុមារ អង្គរ បាន សម្រេច នឹង ទទួល ព្យាបាល អ្នកជំងឺ ពេញ វ័យ តែ មិន អនុញ្ញាតឱ្យ អ្នកជំងឺ ពេញ វ័យ នេះ សម្រាក និង ស្នាក់ នៅក្នុង មន្ទីរពេទ្យ ទេ ។
ដោយឡែក នៅ ប្រទេស កម្ពុជា តាម ការប៉ាន់ប្រមាណ គឺ មាន ៣០០០ នាក់ ទូទាំង ប្រទេស កម្ពុជា ប៉ុន្តែ អ្នកជំងឺ មាន ចំនួន ប្រមាណ ត្រឹម ១០០ នាក់ ដែល ទទួល ការព្យាបាល និង ធ្វើ រោគវិនិច្ឆ័យ ហើយ កន្លែង ដែល អាច ព្យាបាល ជំងឺ នេះ គឺ នៅ មន្ទីរពេទ្យ កុមារ ជាតិ នៅ រាជធានី ភ្នំពេញ និង មន្ទីរពេទ្យ កុមារ អង្គរ ខេត្ត សៀមរាប ជាមួយនឹង វេជ្ជបណ្ឌិត តែ ពីរ រូប ប៉ុណ្ណោះ ៕ ជនជាតិ ចិន ម្នាក់ បើក កន្លែង កែច្នៃ កម្ទេច កំណាត់ ខុស ច្បាប់ ត្រូវ អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ ចុះ បិទ (Video inside)
( ភ្នំពេញ ) ៖ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ពោធិ៍សែនជ័យ ដឹក នាំ ដោយ លោក ប៉ាង លីដា អភិបាល រង ខណ្ឌ ពោធិ៍សែនជ័យ និង លោក សើន កែវ វណ្ណ ធី មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខណ្ឌ បាន ចុះ បិទ អាជីវកម្មសិប្បកម្ម កែច្នៃ កម្ទេច កំណាត់ មួយ កន្លែង ទៀត ដែល កំពុង ដំណើរការ គ្មាន ច្បាប់ អនុញ្ញាត និង បង្ក ការប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ និង បរិស្ថាន ផងដែរ ។
ការចុះ បិទ នោះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩នេះ ហើយ ទីតាំង សិប្បកម្ម កែច្នៃ កម្ទេច កំណាត់ ខាងលើ ស្ថិត ក្នុង ភូមិ កំបូល សង្កាត់ កំបូល ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
សមត្ថកិច្ច បាន ឲ្យដឹង ថា សិប្បកម្ម កែច្នៃ កម្ទេច កំណាត់ ខាងលើ នោះ មាន ម្ចាស់ ឈ្មោះ ឆាយ យ៉ូវ ផាយ អាយុ ៤៧ ឆ្នាំ ជា ជនជាតិ ចិន និង បាន ដំណើរការ អាជីវកម្ម នេះ ជា យូរ មកហើយ ដោយ គ្មាន ច្បាប់ អនុញ្ញាត ត្រឹមត្រូវ ឡើយ ហើយ ការរក ស៉ី នេះ គឺ ចាត់ទុក ថា ធ្វើឡើង ដោយ ខុស ច្បាប់ ថែម ទៀត ផង ។ មិន តែ ប៉ុណ្ណោះ អ្នក រក ស៉ី មួយ នេះ បាន ចិត្ត ទុក អាជ្ញាធរ ដូចជាតិច ម៉ង នឹកស្មាន ថា គ្មាន អ្នកណា ដឹង ទើប បើក អាជីវកម្ម អត់ ច្បាប់ បែប នេះ ប៉ុន្តែ ទោះជា យ៉ាងណាមិន អាច លាក់បាំង បាន ឡើយ ។
អាជ្ញាធរ បាន ឲ្យដឹង បន្ត ថា ទីតាំង ខាងលើ នេះ មាន ការបង្ក ផល ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ បង្ក ប៉ះពាល់ ដែល មាន ក្លិន ឈ្ងៀម ដល់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង មូលដ្ឋាន និង នៅក្បែរ នោះ និង បង្ក ផល ប៉ះពាល់ ដល់ បរិស្ថាន យ៉ាង ខ្លាំង ផងដែរ ។
( ត្បូងឃ្មុំ ) ៖ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ចំនួន ៣១៥ នាក់ នៅ ព្រឹក ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ បាន បន្ត ចុះ ពិនិត្យ ព្យាបាល ជំងឺ និង អំណោយ ថ្នាំ ពេទ្យ របស់ លោក ហ៊ុន ម៉ានី ចែកជូន ដល់ ប្រជាពលរដ្ឋ ចំនួន ៥. ៥៨១ នាក់ ( ប្រាំ ពាន់ ប្រាំរយ ប៉ែត សិប មួយ នាក់ ) លើស ការគ្រោងទុក ចំនួន ១ ពាន់ នាក់ នៅ វិទ្យាល័យ ហេង សំរិន ចក ភូមិ ចម្លាក់ ឃុំ ចក ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ ព្រមទាំង មាន ចែកជូន អាហារ សម្រន់ ជា នំបុ័ង និង ទឹក សុទ្ធ ផងដែរ ។
ដូច សព្វ ដង ដែរ ប្រជាពលរដ្ឋ សប្បាយរីករាយ ស្វាគមន៍ និង ត្រេកអរ ឥត ឧបមារ ចំពោះ សកម្មភាព ចុះ ពិនិត្យ ព្យាបាល នេះ ហើយ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រៀល ជ្រៅ និង សូម គោរព ជូនពរ លោក ហ៊ុន ម៉ានី និង ក្រុមគ្រួសារ ព្រមទាំង ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ទាំងអស់ សូម ជួប នូវ ពុទ្ធ ពរ ទាំង ប្រាំ ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ និង បដិភាណៈ កុំបី ឃ្លាង ឃ្លាត ឡើយ ៕
សម្តេច ក្រឡាហោម ស ខេង ជំរុញ ឲ្យ សមត្ថកិច្ច ពាក់ព័ន្ធ តាម មូលដ្ឋាន បន្ត ផ្សព្វផ្សាយ គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព
( បាត់ដំបង ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសូង មហាផ្ទៃ បាន បង្គាប់ ដល់ សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ឱ្យ បន្ត ផ្សព្វផ្សាយ ពន្យល់ ប្រជាពលរដ្ឋ ឲ្យ យល់ដឹង បន្ត ទៀត អំពី គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព តាម មូលដ្ឋាន ។
ថ្លែង ក្នុង ពិធី បញ្ចុះ ខណ្ឌ សីមា ព្រះវិហារ ថ្មី និង សម្ពោធ សមិទ្ធផល នានា ក្នុង វត្ត បុញ្ញ ខេត្ត នា រាម ហៅ វត្ត អន្លង់ តាម៉ុក ខេត្ត បាត់ដំបង កាលពី ថ្ងៃទី ១១ ខែឧសភា សម្តេច ក្រឡាហោម ស ខេង បាន បង្គាប់ ដល់ នគបាល អាជ្ញាធរ មូលដ្ឋាន គណៈ ពង្រឹង ឃុំ ធ្វើ ការផ្សព្វផ្សាយ គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ដល់ ប្រជាពលរដ្ឋ ឲ្យដឹង ច្បាស់លាស់ ។
សម្តេច ក៏ បាន អំពាវនាវ ដល់ កម្លាំង សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ពិសេស នគរបាល កងរាជអាវុធហត្ថ ទាំងអស់ រដ្ឋបាល ឃុំ ស្រុក ត្រូវ ផ្សព្វផ្សាយ ឲ្យ ប្រជាពលរដ្ឋ បាន យល់ ពី គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព មាន ប៉ុន្មាន ចំណុច ដើម្បី រួមគ្នា ទប់ស្កាត់ អំពើ ផ្សេង ៗ ដែល បម្រុង នឹង កើតមាន ក្នុង មូលដ្ឋាន ។
សម្តេច បញ្ជាក់ ថា៖ « បើ ត្រូវការបោះពុម្ភ ចែក បោះ ទៅ ចែក ឲ្យ ដល់ ផ្ទះ របស់ គាត់ ។ យើង ពឹង សមត្ថកិច្ច យើង វា មួយ ផ្នែក ក៏ប៉ុន្តែ យើង គ្មាន កម្លាំង សមត្ថកិច្ច នគ បាល ឬ រាជអាវុធហត្ថ រាយ គ្រប់ កន្លែង គ្រប់ ភូមិ នោះ ទេ » ។
សម្តេច ក៏ បាន លើកឡើង ថា សូមឲ្យ ការពារ កុំ គ្រឿងញៀន វាយលុក នៅក្នុង តំបន់ របស់ យើង ព្រោះថា បើ គ្រឿងញៀន វាយលុក នោះ វា នឹង ធ្វើឲ្យ ធនធាន មនុស្ស សំខាន់ យុវវ័យ ត្រូវ ខូចខាត់ ដោយសាធាតុ ញៀន នឹង បំផ្លាញ ប្រព័ន្ធ សរសៃ ប្រាសាទ ។ បើ កាលណា គ្រឿងញៀន ចូល ក្នុង ខ្លួន ហើយ បុគ្គល នោះ គ្មាន អនាគត ទៀត ទេ ហើយ មិន ត្រឹម តែ ប៉ុណ្ណឹង ទេ វា ប៉ះពាល់ ដល់ សង្គម ដោយសារ គ្រឿងញៀន មិន អាច បន្សាប បាន ទាំងស្រុង នោះ ទេ ។
ក្រសួង ទេសចរណ៍ ដាក់ ចេញ ក្រម ប្រតិបត្តិ វិជ្ជាជីវៈ ទេសចរណ៍ និង ក្រមសីលធម៌ វិជ្ជាជីវៈ មគ្គុទ្ទេសក៍ ទេសចរណ៍ ២០ ចំណុច៖
( ភ្នំពេញ ) ៖ ក្នុង កិច្ចប្រជុំ ប្រចាំ ខែ នៃ ក្រសួង ទេសចរណ៍ ក្រោម អធិបតីភាព លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ នា ថ្មី ៗ នេះ ក្រសួង ទេសចរណ៍ បាន បង្ហាញ ពី ក្រម ប្រតិបត្តិ វិជ្ជាជីវៈ មគ្គុទ្ទេសក៍ ទេសចរណ៍ និង ក្រសីលធម៌ វិជ្ជាជីវៈ មគ្គុទ្ទេសក៍ ទេសចរណ៍ ចំនួន ២០ ចំណុច ។
នីតិវិធី នៃ ការត្រួតពិនិត្យ ការអនុវត្ត ក្រម ប្រតិបត្ត មគ្គុទ្ទេសក៍ ទេសចរណ៍ នេះ គឺ តាមរយៈ ប្រកាស លេខ ០៤៧ ប្រក ចុះ ថ្ងៃទី ១៧ ខែកុម្ភះ ឆ្នាំ ២០១៤ របស់ ក្រសួង ទេសចរណ៍ ។
តាម ព័ត៌មាន Fresh News ទទួលបាន គឺ មគ្គុ ទេសចរណ៍ ដែល ទទួល អាជ្ញា បណ្ណ ទេសចរណ៍ នឹង ទទួលបាន ១០ពិន្ទុ អតិបរមា ។ ក្នុង ន័យ នេះ មគ្គុទ្ទេសក៍ ទេសចរណ៍ ដែល អនុវត្ត តាម បាន ល្អ តាម ក្រម វិជ្ជាជីវៈ នឹង ទទួលបាន ការលើក សរសើរ និង មេដាយ តែ បើសិនជា មគ្គុទ្ទេសក៍ ទេសចរណ៍ ណា ដែល ប្រព្រឹត្ត ខុស ចំណុច ណាមួយ នៃ ក្រម ប្រតិបត្តិ និង ក្រម វិជ្ជាជីវៈ មគ្គុទ្ទេសក៍ ទេសចរណ៍ នេះ ត្រូវ ទទួល ការពិន័យ ដក ពិន្ទុ តាម ការជាក់ស្តែង លម្អិត មាន នៅក្នុង ឧបសម្ព័ន្ធ នៃ ប្រកាស នេះ ដូច មាន ជូន ភ្ជាប់ ខាងក្រោម ផងដែរ ៕
ទូលព្រះបង្គំ ជា ខ្ញុំ សម្តេច តេជោ ហ៊ុន សែន សូម ព្រះបរម រាជានុញ្ញាត ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ នៃ កម្ពុជា នា ឱកាស ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម គម្រប់ ៦៦ យាង ចូល ៦៧ ព្រះវស្សា
ក្រោយ ជម្នះ ការលំបាក ជាច្រើន ដំណក់ ទឹកដោះគោ ស្រស់ លើក ដំបូង ក្នុង « ឧទ្យាន ជាតិ តេជោ សែន ឬ ស្សី ត្រឹប » នឹង បង្ហាញ វត្តមាន នៅ ខែកក្កដា នេះ ហើយ
( ព្រះវិហារ ) ៖ បន្ទាប់ពី ជម្នះ រាល់ ការលំបាក និង ឧបសគ្គ ជាច្រើន ជំពូក នោះ ទីបំផុត លោក សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន សម្រេច បំណងប្រាថ្នា របស់ ខ្លួន ហើយ ដោយ ទឹកដោះគោ ស្រស់ នឹង ត្រូវបាន ផលិត ឡើង ជា លើក ដំបូង ក្នុង « ឧទ្យាន ជាតិ តេជោ សែន ឬ ស្សី ត្រឹប » នៅ ខេត្ត ព្រះវិហារ ដើម្បី ផ្គត់ផ្គង់ ឲ្យ អ្នកប្រើប្រាស់ ជាតិ និង បរទេស ចាប់ពី ខែកក្កដា ខាងមុខ នេះ ទៅ ។
នៅក្នុង ផ្នែក មួយ នៃ ឧទ្យាន នេះ រោង និង វាល ចិញ្ចឹម គោ ព្រមទាំង វាល ដាំ ស្មៅ ត្រូវបាន រៀបចំឡើង តាម លក្ខណៈ បច្ចេកទេស ដោយ មាន ក្រុម ជំនាញ មកពី ប្រទេស ថៃ មក ជួយ សម្រួល ខណៈ អ្នកជំនាញ ជា យុវជន កម្ពុជា ចំនួន ១០រូប ដែល បាន សិក្សា នៅ ប្រទេស ថៃ ក៏ បាន បំពេញ ការងារ នេះ ដែរ ។
ម៉ាស៊ីន គាប យក ទឹកដោះគោ ម៉ាស៊ីន ច្រក និង រក្សាទុក ត្រូវបាន នាំ មកពី ប្រទេស ជប៉ុន ដើម្បី ផលិត ទឹកដោះគោ ស្រស់ ឲ្យ មាន អនាម័យ និង មាន គុណភាព ស្រម តាម លក្ខណៈ បច្ចេកទេស ចំណីអាហារ ។
លោក បណ្ឌិត្យ សភាចារ្យ សុខ ទូច បាន ឲ្យដឹង ថា ក្រុមការងារ « ឧទ្យាន រាជ បណ្ឌិត្យ សភា កម្ពុជា តេជោ សែន ឬ ស្សី ត្រឹប » កំពុង ធ្វើ កិច្ចការ នេះ យ៉ាង សកម្ម ដោយ លោក អះអាង ថា គោ មួយ ក្បាល មាន តម្លៃ ជាង ២.០០០ ដុល្លារ អាម៉េរិក ។
លោក បណ្ឌិត បញ្ជាក់ ថា នៅ ឆ្នាំ ២០២០ គោ សរុប ចំនួន ៥០០ ក្បាល នឹង មាន នៅក្នុង ឧទ្យាន នេះ ហើយ ទឹកដោះគោ នឹង ត្រូវបាន ផលិត រហូតដល់ មួយ ម៉ឺន លីត្រ ក្នុង មួយ ថ្ងៃ ដើម្បី យក ទៅ ផ្គត់ផ្គង់ ឲ្យ អ្នកប្រើប្រាស់ ពិសេស ទេសចរណ៍ នៅ ក្រុង សៀមរាប ។
លោក បន្ត ថា នៅពេល ទឹកដោះគោ ផលិត ចេញ ពី ឧទ្យាន នេះ ហើយ នោះ នឹង កាត់បន្ថយ ការនាំចូល ទឹកដោះគោ ស្រស់ ពី បរទេស ហើយ ក្រោយមក ឧទ្យាន នេះ ក៏ នឹង បង្កើត ធនាគារ គោ សម្រាប់ កសិករ ពិសេស អ្នក រស់ នៅ ជុំវិញ តំប់ នោះ ។
សូម បញ្ជាក់ ថា នៅក្នុង « ឧទ្យាន រាជ បណ្ឌិត្យ សភា កម្ពុជា តេជោ សែន ឬ ស្សី ត្រឹប » ដែល មាន ទំហំ ១៤. ៣៣៤ ហិកតា ហើយ ដែល ត្រូវបាន បង្កើតឡើង ដោយ ព្រះរាជ ក្រឹត្យ នៅ ឆ្នាំ ២០១៤ មាន មជ្ឈមណ្ឌល ស្រាវជ្រាវ តាមដាន អភិរក្ស និង អភិវឌ្ឍ កសិកម្ម ព្រៃឈើ និង សត្វ ព្រៃ និង សត្វ កម្រ ជីក ស្រះ ស្តុក ទឹក ទុកឲ្យ សត្វ ព្រៃ ផឹក ផឹក ដាំ ដើមឈើ បង្កាត់ ផ្កា រួម និង ការងារ កសិកម្ម មួយ ចំនួន បណ្តុះបណ្តាល របៀប ចិញ្ចឹម គោ ការគាប យក និង រក្សាទុក ទឹកដោះ ។
ឧទ្យាន ដែល ស្ថិត នៅ ឃុំ ឆែប១ និង ឃុំ ឆែប២ ក្នុង ស្រុក ឆែប ខេត្ព្រះ វិហារ នេះ ក៏ មាន អភិរក្ស ឡស្ល ដែក បែប បុរាណ ផងដែរ ព្រោះថា តំបន់ នោះ ជា អតីត កន្លែង ផលិត ដែក នា សម័យ អង្គរ ចាប់ពី សតវត្ស ទី ១១ ដល់ សតវត្ស ទី ១៣ ។
សូម រម្លឹក ថា រាជ បណ្ឌិត្យ សភា កម្ពុជា និង ក្រុមហ៊ុន មួយ របស់ ជប៉ុន កាលពី ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០១៨ បាន ចុះ អនុស្សរណៈ យោគយល់ គ្នា ដើម្បី នាំយក សត្វ កម្រ នានា ដូចជា ត្រី ដូហ្វីន ឬ ត្រី ផ្សោត ទឹក សាប ដែល ជិត ផុត ពូជ នៅលើ ពិភពលោក ទៅ ចិញ្ចឹម នៅក្នុង ឧទ្យាន នេះ ព្រោះ នៅ ទីនោះ មាន អូរ ដាលាស់ ដែល ជា អូរ ពី បុរាណកាល ។
រាជ បណ្ឌិត្យ សភា កម្ពុជា កំពុង ស្វះស្វែងរក ជំនួយ ប្រមាណ ១០លាន ដុល្លារ ពី ប្រទេស កូរ៉េ ខាងត្បូង ដើម្បី ស្តារ អូរ បុរាណ នេះ ឡើងវិញ សម្រាប់ អភិរក្ស សត្វ ព្រៃ និង សត្វ កម្រ ព្រមទាំង សម្រាប់ កសិកម្ម របស់ កសិករ នៅ តំបន់ ក្បែរ ឧទ្យាន នោះ ។
នៅក្នុង អនុស្សរណៈ យោគយល់ គ្នា មួយ ផ្សេង ទៀត រវាង រាជ បណ្ឌិត្យ សភា កម្ពុជា និង ក្រុមហ៊ុន មួយ របស់ ជប៉ុន កាល ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០១៨ គឺ រាជ បណ្ឌិត្យ សភា កម្ពុជា នឹង នាំយក សត្វ កម្រ នានា ដូចជា ត្រី ដូហ្វីន ឬ ត្រី ផ្សោត ទឹក សាប ដែល ជិត ផុត ពូជ នៅលើ ពិភពលោក ទៅ ចិញ្ចឹម នៅក្នុង ឧទ្យាន នេះ ព្រោះ នៅ ទីនោះ មាន អូរ មួយ ហៅ ថា អូដាលាស់ ដែល រាជ បណ្ឌិត្យ សភា កម្ពុជា ចង់ រៀបចំ នៅ ទីនោះ ឱ្យ ទៅជា ដូហ្វីន ។
ទន្ទឹម នឹង នោះ រាជ បណ្ឌិត្យ សភា កម្ពុជា នឹង រក សត្វ ខ្លា ដែល ជិត ផុត ពូជ និង ដំរី យក ទៅ អភិរក្ស នៅក្នុង ឧទ្យាន នេះ ដើម្បី គ្រប់ ជាតិ សាសន៍ បាន មក ទស្សនា សត្វ កម្រ ស្ទើរតែ ផុត ពូជ ៕
អគ្គ នាយក គយ និង រដ្ឋាករ កម្ពុជា លើក បង្ហាញ ពី ការធ្វើ កំណែទម្រង និង ទំនើបកម្ម ប្រព័ន្ធ គយ ក្នុង សន្និសីទ អគ្គ នាយក គយ តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក
ក្នុង សុន្ទរកថា បើក សន្និសីទ លោក Pranab Kuma Das បាន លើកឡើង ថា ដើម្បី ឆ្លើយតប នឹង ការវិវត្តន៍ និង ភាពរីកចម្រើន យ៉ាង លឿន នៃ ពាណិជ្ជកម្ម អន្តរជាតិ បដិវត្ត ឧស្សាហកម្ម ទី៤ និង ពាណិជ្ជកម្ម អេឡិចត្រូនិក ក្នុង បរិបទ សេដ្ឋកិច្ច ឌីជីថល ប្រទេស ក្នុង តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក ត្រូវ រៀបចំ យុទ្ធសាស្ត្រ កំណែទម្រង់ របស់ ខ្លួន ដែល ផ្តោត សំខាន់ លើ ផ្នែក សន្តិសុខ និង កិច្ច សម្រួល ពាណិជ្ជកម្ម . អនុលោម ភាព និង ការអនុវត្ត ច្បាប់ និង ការកសាង សមត្ថភាព ។
លោក បាន គូសបញ្ជាក់ ពី តួនាទី សំខាន់ របស់ បច្ចេកវិទ្យា ក្នុង ការសម្រួល នីតិវិធី គយ និង បាន គូសបញ្ជាក់ នូវ ផ្នែក សំខាន់ ៗ នៃ ការងារ ដែល បាន គ្របដណ្តប់ ក្រោម ប្រធានបទ របស់ WCO សម្រាប់ ឆ្នាំ ២០១៩ « ព្រំដែន វៃ ឆ្លាត សម្រាប់ កិច្ច សម្រួល ពាណិជ្ជកម្ម ការធ្វើដំណើរ និង ការដឹកជញ្ជូន » ។
ទន្ទឹម នេះ លោក អគ្គ លេខាធិការ Kunio Mikuriya ក៏ បាន គូសបញ្ជាក់ ពី យុទ្ធសាស្រ្ត និង គំនិត ផ្តួចផ្តើម ថ្មី ៗ របស់ អង្គការ គយ ពិភពលោក ដោយ រួម មាន ដូច ជា៖ សន្តិសុខ និង កិច្ច សម្រួល ពាណិជ្ជកម្ម . ការវាស់វែង លទ្ធផល . ស្វ័យប្រវត្តិកម្ម នីតិវិធី គយ និង សហប្រតិបត្តិការ គយ . ប្រព័ន្ធ គ្រប់គ្រង ហានិភ័យ . និង ការប្រើប្រាស់ បច្ចេកវិទ្យា ក្នុង នីតិវិធី គយ និង ប្រតិបត្តិការ គយ ជាពិសេស ការប្រើប្រាស់ ទិន្នន័យ ធំ (Big Data) ប្រមូល ទិន្នន័យ វិភាគ ទិន្នន័យ ការចែករំលែក ផ្លាស់ប្តូរ ទិន្នន័យ ។
លោក បណ្ឌិត គុណ ញឹម ត្រូវបាន អញ្ជើញ ធ្វើ បទបង្ហាញ ពី លទ្ធផល ពិភាក្សា ស្តីពី ពាណិជ្ជកម្ម អេឡិចត្រូនិក ឆ្លងកាត់ ព្រំដែន ផងដែរ ។
ពាក់ព័ន្ធ នឹង វិស័យ អាទិភាព របស់ តំបន់ អាស៊ី - ប៉ាស៊ីហ្វិក អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ក៏ បាន ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ កែទម្រង់ និង ទំនើបកម្ម គយ ឆ្នាំ ២០១៩ - ២០២៣ ដោយ បាន ប្រើប្រាស់ ប្រព័ន្ធ ព័ត៌មានវិទ្យា ក្នុង នីតិវិធី គយ ជា យុទ្ធសាស្រ្ត ស្នូល ដើម ជួយ ជ្រោមជ្រែង យុទ្ធសាស្ត្រ ចំនួន ៤ទៀត រួម មាន៖ បង្កើន ប្រសិទ្ធភាព នៃ ការប្រមូល ចំណូល . ពង្រឹង អនុលោម ភាព និង ការអនុវត្ត ច្បាប់ . សហប្រតិបត្តិការ គយ និង ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស និង ស្ថាប័ន ។
សូម បញ្ជាក់ ថា ឆ្លៀត ក្នុង ឱកាស ចូលរួម សន្និសីទ នេះ គណៈប្រតិភូ នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ក៏ បាន ជួបប្រជុំ ទ្វេ ភាគី ជាមួយ រដ្ឋបាល គយ នៃ ប្រទេសជា ដៃគូ ពាណិជ្ជកម្ម សំខាន់ ៗ មួយចំនួន ដូចជា ប្រទេស ឥណ្ឌា . កូរ៉េ . ថៃ ជាដើម ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ ការងារ គយ ។
ថ្នាក់ដឹកនាំ ក្រុមប្រឹក្សា ធម្មនុញ្ញ អញ្ជើញ ចូលរួម វេទិកា ច្បាប់ អន្តរជាតិ លើក ទី៩ នៅ ប្រទេស រុស្ស៉ី
ក្នុង វេទិកា ច្បាប់ អន្តរជាតិ នេះ មាន ការចូលរួម ពីសំណាក់ តុលាការ ធម្មនុញ្ញ និង ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ បណ្តា ប្រទេស ចំនួន ៩១ ដើម្បី ចែករំលែក បទពិសោធន៍ និង ពិភាក្សា លើ ប្រធានបទ សំខាន់ ៗ ពាក់ព័ន្ធ ទៅនឹង ច្បាប់ រដ្ឋធម្មនុញ្ញ ព្រមទាំង ពិភាក្សា លើ ច្បាប់ ផ្សេង ៗ ទៀត សរុប ចំនួន ១៥០ ប្រធានបទ ។
លោក អ៉ឹម សួស្តី នឹង ឡើង ថ្លែង ចែករំលែក បទពិសោធន៍ គោល សំខាន់ ៗ នៃ ច្បាប់ រដ្ឋធម្មនុញ្ញ របស់ រកម្ពុជា និង សមត្ថកិច្ច របស់ ក្រុមប្រឹក្សា ធម្មនុញ្ញ ក្នុង ការធានា ការពារ ការគោរព រដ្ឋធម្មនុញ្ញ ដែល ជា ច្បាប់ កំពូល របស់ ប្រទេស ។
សមត្ថកិច្ច ឃាត់ខ្លួន ខ្មាន់ កាំភ្លើង ម្នាក់ បាញ់ សម្លាប់ ជនជាតិ ភ្នង នៅ ស្រុក កែវសីមា ខេត្ត មណ្ឌលគិរី
( មណ្ឌលគិរី ) ៖ សមត្ថកិច្ច ឃាត់ខ្លួន ខ្មាន់ កាំភ្លើង ម្នាក់ បាញ់ សម្លាប់ ជនជាតិ ភ្នង កាលពី បុណ្យ ចូល ឆ្នាំ ខ្មែរ ដែល អំពើ ឃាតកម្ម នេះ បាន កើតឡើង កាលពី ព្រឹក ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០១៩ នៅ ភូម ក្មូម ឃុំ ស្រែ ឈូក ស្រុក កែវសីមា ខេត្ត មណ្ឌលគិរី មាន ចម្ងាយ ពី ទី រួម ខេត្ត ប្រហែល ជិត ១០០ គីឡូម៉ែត្រ ។
បើ តាម ការបង្ហើប ប្រាប់ ពី សមត្ថកិច្ច បាន ឲ្យដឹង ថា ជនសង្ស័យ ក្នុង ករណី បាញ់ សម្លាប់ មនុស្ស នៅ ស្រុក កែវសីមា កាលពី ពេល កន្លងមក ត្រូវ នគរបាល ឃាត់ខ្លួន បាន ភ្លាម ៗ ប៉ុន្តែ សមត្ថកិច្ច ហាក់ មិន ទាន់ ទំលាយ ព័ត៌មាន នេះ ទេ ដោយសារ កំពុង បន្ត នីតិវិធី ។
លោក ឡោ សុខា ស្នងការ នគរបាល ខេត្ត មណ្ឌលគិរី បាន ប្រាប់ Fresh news ប្រចាំ ខេត្ត មណ្ឌលគិរី នៅ ព្រឹក ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ នេះ ថា ជនសង្ស័យ ពិតជា ឃាត់ខ្លួន បាន ពិត មែន តែ ពេលនេះ ការិយាល័យ ជំនាញ នគរបាល ខេត្ត កំពុង នាំ ជនសង្ស័យ ទៅ ធ្វើត្រាប់ ។ លោក ស្នងការពុំ ទាន់ ប្រាប់ ពី អត្តសញ្ញាណ ជនសង្ស័យ នោះ ទេ ព្រោះ ពេលនេះ សមត្ថកិច្ច កំពុង នាំយក ជនសង្ស័យ ទៅ ធ្វើត្រាប់ នៅ ទីតាំង កើត ហេតុ ។
កាលពី ព្រឹក ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ ត្រូវ នឹង ថ្ងៃ បុណ្យ ប្រពៃណី ចូល ឆ្នាំ ខ្មែរ ថ្ងៃទី២ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី បាន ដឹកនាំ កម្លាំង សមត្ថកិច្ច ចុះ ស្រាវជ្រាវ ករណី អំពើ ឃាតកម្ម ដ៏ ឃោរឃៅ ព្រៃផ្សៃ មួយ ដោយ ជនល្មើស បាន បាញ់ប្រហារ ទៅ លើ ជនរងគ្រោះ ម្នាក់ បណ្តាលឲ្យ ស្លាប់ ភ្លាម ៗ នៅលើ ផ្ទះ ខ្លួន ។ ហេតុការណ៍ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ០៨៖ ៥១ នាទី យប់ ថ្ងៃទី ១៤ ខែមេសា ឆ្នាំ ២០១៩ នៅ ចំណុច រ យ៉ង ភូមិ ក្មូម ឃុំ ស្រែ ឈូក ស្រុក កែវសីមា ខេត្ដ មណ្ឌលគីរី ។
បើ តាម របាយការណ៍ លោក កុយ ចំរើន នាយ ប៉ុស្តិ៍ ស្រែ ឈូក បាន ឲ្យដឹង ថា ជនរងគ្រោះ មាន ឈ្មោះ ប្យុច ផុស អាយុ ៣៩ ឆ្នាំ ជនជាតិ ភ្នង មុខរបរ កសិករ មាន ប្រពន្ធ ឈ្មោះ ស្រោញ ចែវ មាន កូន ចំនួន ៧នាក់ ស្រី ៦នាក់ មាន ទីលំនៅ កន្លែង កើត ហេតុ ខាង លើ ។
មុនពេល កើត ហេតុ ជនរងគ្រោះ បាន ត្រឡប់ មក ពី ព្រៃ វិញ ជាធម្មតា ដូច សព្វមួយ ដង បន្ទាប់មក ជនរងគ្រោះ បាន ទៅ ចូលរួម កម្មវិធី សែន ព្រេន បុណ្យ ចូល ឆ្នាំ ថ្មី រួច បាន ផឹក ស្រាបៀរ អស់ ៣កំប៉ុង ជាមួយ អ្នកភូមិ រួច ត្រឡប់មក ផ្ទះ វិញ ហើយ បាន ដេក មើល ទូរស័ព្ទ ជាមួយ កូន ស្រាប់តែ មាន ជន មិន ស្គាល់ មុខ មក បាញ់ ពីក្រោម ផ្ទះ ត្រូវ ចំពោះ ចំនួន ២គ្រាប់ ជនរងគ្រោះ បាន ស្លាប់ ភ្លាម នៅលើ ផ្ទះ តែម្តង ៕ ប្រធានាធិបតី អ៊ីរ៉ង់ អំពាវនាវ ឱ្យ មាន ការឯកភាព ជាតិ ប្រឈមមុខ នឹង សម្ពាធ មិន ធ្លាប់ មាន ពី សហរដ្ឋ អាមេរិក
( តេហេរ៉ង់ ) ៖ ប្រធានាធិបតី អ៊ីរ៉ង់ លោក ហាសាន់ រូហានី បាន អំពាវនាវ ឱ្យ ប្រជាជន និង អ្នកនយោបាយ អ៊ីរ៉ង់ ទំាង អស់ រួបរួម ក៏ ដូចជា ឯកភាព ជាតិ គ្នា ឡើង ស្រប ពេល កំពុង ប្រឈមមុខ នឹង សម្ពាធ ព្រមទាំង ការដាក់ទណ្ឌកម្ម មិន ធ្លាប់ ពី មុន មក ពីសំណាក់ សហរដ្ឋ អាមេរិក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CGTN នៅ ថ្ងៃអាទិត្យ ទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា កាលពី ថ្ងៃសុក្រ ការដំឡើង ពន្ធ ២០០ ពាន់ លាន ដុល្លារ លើ ទំនិញ នាំចូល ពី ចិន របស់ សហរដ្ឋ អាមេរិក បាន ចូល ជាធរមាន ហើយ ដោយ លោក ដូណាល់ ត្រាំ អះអាង ថា ការសម្រេចចិត្ត ដាក់ ពិន័យ បែប នេះ គឺ ដោយសារតែ ចិន រំលោភ លើ ការប្ដេជ្ញាចិត្ត របស់ ខ្លួន ឯង នៅក្នុង កិច្ចចរចា ពាណិជ្ជកម្ម ៕
ខ្ញុំ ម្ចាស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម ក្រាបបង្គំទូល ថ្វាយ នូវ សារលិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះមហាក្សត្រ ក្នុង ឱកាស នៃ ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម របស់ ព្រះអង្គ
ខ្ញុំ ម្ចាស់ ទូលព្រះបង្គំ យើងខ្ញុំ ទាំងអស់ គ្នា មាន សេចក្ដីសោមនស្ស រីករាយ ឥត ឧបមា ដែល បាន រស់ នៅ និង បំពេញ បេសកកម្ម មនុស្សធម៌ ក្រោម ម្លប់ ដ៏ ត្រជាក់ នៃ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ក្នុង ព្រះរាជ បេសកកម្ម ឧត្តុង្គឧត្តម ថ្លៃថ្លា ជា ប្រវត្តិសាស្ត្រ បន្ត ពី ព្រះករុណា សម្តេច ព្រះវរ រាជ បិតា ព្រះបរម រតន កោដ្ឋ ដើម្បី បូរណភាព ទឹកដី ឯករាជ្យ ជាតិ ខ្មែរ ។
សូម ក្រាបបង្គំទូល ថ្វាយ នូវ សារ ថ្វាយ ព្រះពរ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ទូល ថ្វាយ ព្រះករុណា ព្រះមហាក្សត្រ ដែល មាន ខ្លឹមសារ ទាំងស្រុង ដូច ខាងក្រោម ៖
ខ្មាន់ កាំភ្លើង ៣នាក់ បើក ការវាយប្រហារ លើ សណ្ឋាគារ ផ្កាយ៥ របស់ ចិន នៅ ប៉ាគីស្ថាន
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ធ្ងន់ ៦នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៨ លើក នេះ បណ្ដាលឲ្យ ខូចខាត ម៉ូតូ ចំនួន ៨ គ្រឿង . រថយន្ត តូច ៣គ្រឿង . រថយន្ដ ធុង ធំ៣ គ្រឿង និង យាន ផ្សេង១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន គោរព សិទ្ធិ . មិន ប្រកាន់ ស្ដាំ . ស្រវឹង និង ប្រជែង ។
ចិន ដាក់ ដំណើរការ នាវា ចម្បាំង ថ្មី ពីរ គ្រឿង ខណៈ អាមេរិក នៅតែ បន្ត ចល័ត នាវា ចម្បាំង ចូលមក សមុទ្រ ចិន ខាងត្បូង
គួរ ជម្រាប ថា ការដាក់ ដំណើរការ នាវា ចម្បាំង ថ្មី នេះ កើត មាន ឡើង ខណៈ ដែល តាំងពី ដើម ខែឧសភា នេះ មក កងទ័ព ជើងទឹក របស់ អាមេរិក បាន បញ្ជូន នាវា ចម្បាំង ជា បន្តបន្ទាប់ ឲ្យ មក ធ្វើដំណើរ ឆ្លងកាត់ តំបន់ សមុទ្រ ចិន ខាងត្បូង ដែល មាន បញ្ហា វិវាទ រវាង ប្រទេស មួយចំនួន នៅ ជុំវិញ តំបន់ នេះ ។ ទីក្រុង ប៉េកាំង តែងតែ បាន ចេញមុខ ថ្កោល ទោស ចំពោះ សកម្មភាព បង្កហេតុ នេះ ប៉ុន្តែ អាមេរិក ហាក់ នៅតែ មិន ខ្វល់ ៕
ប្រជាពលរដ្ឋ ៣៨ គ្រួសារ ទិញ ដី ពី ក្រុមហ៊ុន ដោយ ស្រប ច្បាប់ បែរ ត្រូវ រងគ្រោះ ព្រោះ ប្តី ប្រពន្ធ ថៅកែ ក្រុមហ៊ុន ឈ្លោះគ្នា
ក្រោយពី ទិញ ដី ខាងលើ ដោយ ស្រប ច្បាប់ ពី ឈ្មោះ នួន ច័ន្ទ មករា ដោយ មាន អាជ្ញាធរ ភូមិ ឃុំ និង ស្រុក បាន ទទួលស្គាល់ ក្នុង ការផ្ទេរ សិទ្ធិ កាន់កាប់ ដីធ្លី ទាំង ៣៨ គ្រួសារ រួចហើយ នោះ ពួកគាត់ ដាំដុះ និង អាស្រ័យ ផល នៅលើ ដី នោះ ដោយ បាន ចំណាយ ប្រាក់កាស ជាច្រើន និង កម្លាំង ញើស ឈាម ក្នុង ការដាំដុះ និង ថែទាំ ដំណាំ រហូតដល់ សព្វ ថ្ងៃ ។
( ភ្នំពេញ ) ៖ ផ្កា ថ្ម ជា សត្វ មិន មែន ជា រុក្ខជាតិ នោះ ទេ ដែល ជា ប្រភព ជីវៈ សម្រុះ ដ៏ សម្បូរបែប បំផុត នៅលើ ភព ផែនដី ហើយ វា ផ្ដល់ ការទ្រទ្រង់ ដល់ ជីវិត មនុស្ស ជាង ៤០០ លាន នាក់ នៃ ប្រជាជន ពិភពលោក ។ ផ្កា ថ្ម សមុទ្រ ក៏ ជា អេកូឡូស៊ី ដែល ទទួលរង ការគំរាមគំហែង ខ្លាំង ពី ការឡើង កំដៅ នៃ សមុទ្រ ដែល កើត ចេញពី បំរែ បំរួល អាកាសធាតុ ។ នៅ ពេល ដែល ផ្កា ថ្ម សមុទ្រ ទទួលរង ការខូចខាត ផ្សេង ៗ សហគមន៍ និង សេដ្ឋកិច្ច ក្នុង តំបន់ ជា អ្នក ខាតបង់ ។
អង្គការ សត្វ ព្រៃ និង រុក្ខជាតិ អន្តរជាតិ (FFI) សហការ ជាមួយ រដ្ឋបាល ជលផល អាជ្ញាធរ មាន សមត្ថកិច្ច វិស័យ ឯកជន និង សហគមន៍ នេសាទ តំបន់ ឆ្នេរ បាន ធ្វើការ យ៉ាង ជិតស្និទ្ធ ក្នុង កិច្ចការពារ និង អភិរក្ស ធនធាន ជល ផល កំពុង រងគ្រោះថ្នាក់ និង ទី ជម្រក សំខាន់ ៗ តាមរយៈ កម្មវិធី អភិរក្ស ធនធាន តំបន់ ឆ្នេរ និង សមុទ្រ នៅ កម្ពុជា តាំងពី ឆ្នាំ ២០១០ ។
ក្នុង រយៈពេល ប៉ុន្នាន ឆ្នាំ ចុងក្រោយ នេះ ភ្ញៀវ ទេសចរ មាន កំណើន ពី គ្រប់ ទិសទី មក លេង កំសាន្ត នៅ តាម បណ្តា ខេត្ត តំបន់ ឆ្នេរ ក៏ ដូចជា តាម កោះ នានា ជាពិសេស នា ឱកាស បុណ្យ ជាតិ សំខាន់ ៗ ។ ជាធម្មតា ភ្ញៀវ ទេសចរ ចូលចិត្ត ដើរកំសាន្ត តាម ឆ្នេរ ខ្សាច់ ស្ទូច ត្រី ទស្សនា ទិដ្ឋភាព ថ្ងៃអស្តង្គត និង ហែលទឹក សមុទ្រ មើល ផ្កា ថ្ម ជាដើម ។ ទោះជា យ៉ាងណា សកម្មភាព ចំបង ១០ ចំណុច ដែល ភ្ញៀវ ទេសចរ និង អ្នកដឹក ភ្ញៀវ ទេសចរ តាម ទូក គប្បី ជៀសវាង ដូច ខាងក្រោម៖
លោក អ៊ុក វិបុល ប្រធាន នាយកដ្ឋាន អភិរក្ស ជល ផល បាន បញ្ជាក់ ថា ក្នុង នាម រដ្ឋបាល ជលផល លោក រីករាយ និង ថ្លែងអំណរគុណ ដល់ ដៃគូ អាជ្ញាធរ មូលដ្ឋាន និង សហគមន៍ ទាំងអស់ ដែល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង សកម្មភាព អភិរក្ស ធនធាន ជល ផល ដ៏ មាន តម្លៃ នេះ និង សូម ស្នើ បន្ត សកម្មភាព ដ៏ ថ្លៃថ្លា នេះ បន្ត ទៀត សម្រាប់ ជាតិ និង កូន ចៅ យើង ជំនាន់ ក្រោយ ផង ។
អ៊ីរ៉ង់ ប្រាប់ ពិភពលោក កុំ ឲ្យ ភ្លេច « ការកុហក របស់ អាមេរិក » ដើម្បី ឈ្លានពាន អ៊ីរ៉ាក់ ក្នុង ឆ្នាំ ២០០៣ !
( តេហេរ៉ង់ ) ៖ ខណៈ ដែល ស្ថានការណ៍ នៅ តំបន់ មជ្ឈិមបូព៌ា កំពុងតែ កើនឡើង កម្តៅ ដោយសារតែ សព្វាវុធ ទំនើប ៗ របស់ សហរដ្ឋ អាមេរិក បាន មកដល់ ពាសពេញ ក្នុង តំបន់ នោះ ប្រទេស អ៊ីរ៉ង់ បាន បង្ហើរ សារ មួយ ឃ្លា ប្រាប់ ពិភពលោក ដើម្បីឲ្យ គ្រប់ គ្នា នឹកឃើញ ដល់ ការកុហក របស់ អាមេរិក ដែល បាន ឈានដល់ ការព្រួត គ្នា វាយប្រហារ ប្រទេស អ៊ីរ៉ាក់ កាលពី ឆ្នាំ ២០០៣ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ Sputnik នា ល្ងាច ថ្ងៃសៅរ៍ ទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ ។
ប្រទេស អ៊ីរ៉ង់ នៅ ថ្ងៃសៅរ៍ នេះ បាន ចោទ សហរដ្ឋ អាមេរិក ថា កំពុង បង្ក ការគំរាមកំហែង យ៉ាង ធ្ងន់ធ្ងរ ចំពោះ សន្តិសុខ ក្នុង តំបន់ តាមរយៈ ការដាក់ពង្រាយ ទ័ព និង សព្វាវុធ នៅ តំបន់ មជ្ឈិមបូព៌ា ហើយ អ៊ីរ៉ង់ ថែមទាំង បាន លើកឡើង ទៀត ថា ទីក្រុង វ៉ាស៊ីនតោន កំពុង ប្រើប្រាស់ ការស៊ើបអង្កេត ក្លែងក្លាយ ឬ ព័ត៌មាន សម្ងាត់ បែប ប្រឌិត ដោយ មក ចោទ លើ អ៊ីរ៉ង់ ថា បាន និង កំពុង រៀបចំ ផែនការ សម្ងាត់ ធ្វើ ការវាយប្រហារ តំបន់ យុទ្ធសាស្ត្រ ព្រមទាំង សម្ព័ន្ធមិត្ត នានា របស់ អាមេរិក នៅក្នុង តំបន់ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប គ្រឿងញៀន ខុស ច្បាប់ ចំនួន ២០ ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣៤ នាក់ ។
បើ យោង តាម របាយការណ៍ របស់ គណៈកម្មការ ទី៣ នៃ យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ បាន ឲ្យដឹង ថា ប្រភេទ បទល្មើស រួម មាន៖ ជួញដូរ ១១ករណី ឃាត់ខ្លួន ១៨ នាក់ និង ប្រើប្រាស់ ៩ករណី ឃាត់ខ្លួន ១៦ នាក់ ។
( ត្បូងឃ្មុំ ) ៖ បន្ទាប់ពី ភ្លៀង ធ្លាក់ លាយ លំខ្យល់ កន្ត្រាក់ ជាង ១០ ថ្ងៃ កន្លងទៅ ចាប់តាំងពី ថ្ងៃទី១ រហូតដល់ ថ្ងៃទី ១០ ខែឧសភា ឆ្នាំ ២០១៩ បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ សរុប ប្រមាណ ជាង ២០០ គ្រួសារ ហើយ ក្នុង ខេត្ត ត្បូងឃ្មុំ ទទួលរង ផល ប៉ះពាល់ ដោយ រលំ ផ្ទះ និង ប៉ើង តំបូល ផ្ទះ វត្ត អារាម សាលារៀន ក៏ ដូចជា ផល ដំណាំ នានា របស់ ប្រជាពលរដ្ឋ ត្រូវបាក់ ខូចខាត ខ្ទេចខ្ទី ផងដែរ ។
បើ តាម លោក លី សុភាលីន អភិបាល ស្រុក ពញា ក្រែក បាន ឱ្យដឹង ថា កាលពី ថ្ងៃ១០ ម្សិលមិញ ភ្លៀង បាន បន្ត ធ្លាក់ លាយ លំ ជាមួយ ខ្យល់ កន្ត្រាក់ បោកបក់ មក លើ ភូមិ ស្រុក ប្រជាពលរដ្ឋ ក្នុង ស្រុក ពញា ក្រែក ធ្វើឱ្យ ផ្ទះ ពលរដ្ឋ ចំនួន ៦៣ គ្រួសារ រងគ្រោះ បន្ថែម ទៀត ក្នុង នោះ ៥៦ គ្រួសារ ខូចខាត ប៉ើង ដំបូល តិចតួច និង ៩គ្រួសារ រលំ ផ្ទះ ទាំងស្រុង ។
ក្នុង ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន សំណេះសំណាល និង សម្តែង នូវ ការសោកស្តាយ ក៏ ដូចជា ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើរ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ចំពោះ បងប្អូន ដែល រងគ្រោះ ទាំងអស់ ដោយ ក្តី នឹករលឹក និង អាណិតអាសូរ បំផុត ។
លោក អភិបាល ខេត្ត បាន ថ្លែង ថា អំណោយ ចែកជូន បងប្អូន ពេលនេះ គឺ ដើម្បី ជួយ សម្រួល នូវ តម្រូវ ការចាំបាច់ របស់ បងប្អូន ជាមួយគ្នា នោះ ក៏ បាន ផ្តាំផ្ញើរ ដល់ បងប្អូន ពលរដ្ឋ ទាំងអស់ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ បំផុត ចំពោះ ការបំរែ បំរួល អាកាសធាតុ ថែរក្សា សុខភាព ខ្លួន មើលថែ កូន ៗ តូច ៗ ឱ្យ បាន ល្អ ពិសេស ខិតខំ ប្រកបរបរ ចិញ្ចឹម ជីវិត បន្ថែម ទៀត ដើម្បី បង្កើន លទ្ធភាព សាងសង់ ផ្ទះសម្បែង ឡើងវិញ ផងដែរ ។
អាគារ សិក្សា ១ខ្នង ក្នុង អនុវិទ្យាល័យ ក្រយាន ជា អំណោយ សម្ដេច តេជោ ហ៊ុន សែន នឹង បើក ឲ្យ សិស្ស ចូលរៀន នៅ ចុង ឆ្នាំ នេះ
( កំពង់ធំ ) ៖ អគារ សិក្សា ថ្មី ១ខ្នង កម្ពស់ ២ជាន់ ក្នុង អនុវិទ្យាល័យ ក្រយាន ស្ថិត នៅ ឃុំ ក្រយា ស្រុក សន្ទុក ខេត្ត កំពង់ធំ នឹង បើក ឲ្យ សិស្ស ចូល សិក្សា នៅ ខែតុលា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ហើយ ។
អគារ សិក្សា ១ខ្នង កម្ពស់ ២ជាន់ នឹង ១២ បន្ទប់ នេះ ជា អំណោយ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល ផ្ដល់ជូន តាមរយៈ លោក ជា ចាន់តូ សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក សន្ទុក ។
អភិបាល រង ស្រុក សន្ទុក ឲ្យដឹង ថា គិត ត្រឹម ឆ្នាំ ២០១៨ នេះ នៅ ទូទាំង ស្រុក សន្ទុក មាន អគារ សិក្សា ជា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិ ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ផ្ដល់ តាម យៈ លោក ជា ចាន់តូ និង ស្រី មាន ចំនួន ២៥ ខ្នង ក្នុង នោះ អគារ សង់ ពី ថ្ម មាន ២២ ខ្នង និង អគារ សង់ ពី ឈើ មាន ចំនួន ៣ខ្នង ។
លោក បន្ដ ថា ក្រៅពី នោះ នៅ បាន ជួយ កសាង សមិទ្ធផល ជាច្រើន ដែល បម្រើ ដល់ ការសិក្សា របស់ សិស្សនុសិស្ស ថែម ទៀត ផង ។
លោក ជា ចាន់តូ ឲ្យដឹង ថា សមិទ្ធ ទាំង នេះ ជា ការខិតខំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា គឺ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្នុង បំណង បង្ខិត សាលារៀន ឲ្យ កាន់តែ ជិត បំផុត នឹង សិស្សានុសិស្ស ដើម្បីឲ្យ ពួកគេ កាន់តែ ងាយស្រួល និង មាន ឱកាស រៀនសូត្រ ដូច សិស្ស ទាំង ផ្សេង ៗ ទៀត ។
លោក ជា ចាន់តូ ក៏ បាន ស្នើឲ្យ ប្រជាពលរដ្ឋ រួម សាមគ្គី គ្នា បន្ត ថែរក្សា ការពារ សុខ សន្តិភាព ដែល មាន នេះ ឲ្យបាន គង់វង្ស ព្រោះ សុខ សន្តិភាព ជា មូលដ្ឋានគ្រឹះ ដ៏ រឹងមាំ សម្រាប់ អភិវឌ្ឍ ប្រទេស និង នាំឲ្យ រស់ នៅ សុខសាន្ត ដូច បច្ចុប្បន្ន ។
លោក បន្ថែម ថា អ្នក ទាំងអស់ គ្នា ត្រូវ ចងចាំ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ប៉ុណ្ណោះ ដែល រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ ដូច្នេះ សូម បន្ដ គាំទ្រ ចំពោះ គោល នយោបាយ រាជ រដ្ឋាភិបាល បន្ដ ទៀត ដើម្បី ការរីកចម្រើន សង្គមជាតិ និង ការរស់នៅ ប្រកបដោយ សេចក្ដីសុខសាន្ត ៕ ត្រឹម២ ថ្ងៃ ខ្យល់ កន្រ្តាក់ វាយ បំផ្លាញ ផ្ទះ ពលរដ្ឋ ជិត ៣០០ ខ្នង នៅ ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ ក្នុង រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ មាន ករណី គ្រោះ ធម្មជាតិ ខ្យល់ កន្ត្រាក់ វាយ បាន ប្រហារ ផ្ទះ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ត្បូងឃ្មុំ មាន ចំនួន រហូតដល់ទៅ ជិត ៣០០ ខ្នង ។
ទិន្និន័យ នេះ ត្រូវបាន បង្ហាញ ឡើង ក្នុង ឱកាស ដែល លោកស្រី ឡេង សុខា អភិបាល រង ខេត្ត និង ជា ប្រធាន ស្តីទី គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ត្បូងឃ្មុំ ព្រមទាំង លោក រស់ សុខ ន នាយក សាខា កាកបាទ ក្រហម ខេត្ត បាន ដឹកនាំ ក្រុមការងារ យក អំណោយ កាកបាទ ក្រហម ចុះ ជួយ ប្រជាពលរដ្ឋ រងគ្រោះ ភ្លាម ៗ ចំនួន ៨៧ គ្រួសារ នៅ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ នេះ ។
នៅ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ ម្សិលមិញ កាកបាទ ក្រហម ខេត្ត ត្បូងឃ្មុំ ក៏ បាន នាំយក អំណោយ មនុស្សធម៌ ទៅ ចែកជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ខ្យល់ កន្ត្រាក់ រលំ និង របើក ដំបូល ផ្ទះ ចំនួន ៦៧ គ្រួសារ ម្តង ហើយ ដោយ សរុប ទាំង២លើក ក្នុង ស្រុក ពញា ក្រែក មាន ប្រជាពលរដ្ឋ រងគ្រោះ ទទួលបាន អំណោយ ១៥៤ គ្រួសារ ខណៈ ទូទាំង ខេត្ត មាន ពលរដ្ឋ រងគ្រោះ ប្រមាណ ជិត ៣០០ គ្រួសារ ត្រឹម រយៈពេល តែ ២ ថ្ងៃ នេះ ។
លោកស្រី ឡេង សុខា បាន ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពី សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល តែងតែ យកចិត្តទុកដាក់ គិត គូរ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ រូប មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុរ ជំនឿ សាសនា ឬ និន្នាការ នយោបាយ ណាមួយ ឡើយ ។
លោកស្រី ឡេង សុខា បាន សំដែង នូវ ការសោកស្ដាយ ចំពោះ ការខូចខាត ផ្ទះ សំបែង ទ្រព្យសម្បត្តិ ដែល នេះ ជា គ្រោះមហន្តរាយ គ្មាន នរណា ម្នាក់ ចង់ ជួបប្រទះ ឡើយ ។ សកម្មភាព នេះ គឺជា ការបង្ហាញ នូវ ការយកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ គ្រប់ រូប ពីសំណាក់ ថ្នាក់ដឹកនាំ ពិសេស គឺ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន ៕
ឥណ្ឌា៖ ការបោះឆ្នោត សកល ជុំ ទី៦ តាម លិទ្ធិ ប្រជាធិបតេយ្យ ដ៏ ធំ បំផុត លើ ពិភពលោក ចាប់ផ្ដើម ហើយ នៅ ថ្ងៃអាទិត្យ នេះ !
( ញួ ដេលី ) ៖ ប្រជាជន ឥណ្ឌា នៅក្នុង ទីក្រុង ញូដេលី និង បណ្ដា រដ្ឋ ភាគ ខាងជើង នៃ ប្រទេស បាន ធ្វើដំណើរ ទៅកាន់ ការិយាល័យ បោះឆ្នោត ហើយ នៅ ថ្ងៃអាទិត្យ នេះ ដើម្បី ទម្លាក់ សន្លឹក ឆ្នោត របស់ ពួកគេ នៅក្នុង ជុំ ចុងក្រោយ នៃ ការបោះឆ្នោត សកល ដែល ចែកចេញ ជា៧ ដំណាក់កាល ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Al Jazeera នៅ ថ្ងៃអាទិត្យ ទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ ។
ជាមួយគ្នា នោះ ដែរ បើ តាម គណៈកម្មាការរៀបចំ ការបោះឆ្នោត ឥណ្ឌា ប្រជាជន ច្រើន ជាង ១០០ លាន នាក់ នៅ ទូទាំង រដ្ឋ ចំនួន ៧ ដែល មាន សិទ្ធិ បោះឆ្នោត បាន ចូលរួម ក្នុង ការបោះឆ្នោត ជុំ ទី៦ នៅ ថ្ងៃអាទិត្យ នេះ សម្រាប់ អសនៈ ចំនួន ៥៩ ក្នុង នោះ រាប់បញ្ចូល ទាំង ទីក្រុង ញូដេលី ផងដែរ ។
គួរ បញ្ជាក់ ថា បើ តាម លោក រដ្ឋមន្ត្រី ការបរទេស បារាំង ការរុញច្រាន ឱ្យ ពិភពលោក ធ្លាក់ ក្នុង ភាពចលាចល គឺ មាន ជាប់ពាក់ព័ន្ធ នឹង ភាពតានតឹង រវាង សហរដ្ឋ អាមេរិក និង ចិន រួមទាំង ជាមួយ រុស្ស៊ី ផងដែរ ៕
ថ្ងៃស្អែក ព្រះមហាក្សត្រ យាង ទៅ ទីក្រុង ប៉េកាំង ដើម្បី ចូលរួម វេទិកា អរិយធម៌ អាស៊ី លើក ទី១
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នឹង យាង ទៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន នៅ ថ្ងៃចន្ទ ១០កើត ខែពិសាខ ឆ្នាំ កុរ ឯកស័ក ព .ស ២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០១៩ ស្អែក នេះ ដើម្បី ចូលរួម វេទិកា អរិយធម៌ អាស៊ី លើក ទី១ ដែល រៀបចំ ដោយ ប្រទេស ចិន ។
ព្រះរាជ ដំណើរ របស់ ព្រះអង្គ តប តាម ការយាង របស់ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង ។ ថ្នាក់ដឹកនាំ ព្រឹទ្ធសភា រដ្ឋសភា និង រាជ រដ្ឋាភិបាល ព្រមទាំង មន្ត្រី ព្រះបរម រាជ វាំង ព្រះញាតិវង្ស នឹង យាង និង អញ្ជើញ ថ្វាយ ព្រះរាជ ដំណើរ របស់ ព្រះអង្គ នៅ ថ្ងៃស្អែក នេះ ។
សន្និសីទ នេះ នឹង អញ្ជើញ មេដឹកនាំ នយោបាយ មកពី អាស៊ី បណ្តា ប្រទេស ដទៃ ទៀត ប្រធាន អង្គការ អន្តរជាតិ ដែល ពាក់ព័ន្ធ និង អ្នកតំណាង មកពី គ្រប់ ផ្នែក នៃ មនុស្សជាតិ ដើម្បី ចូលរួម ផងដែរ ៕
បង្ហាញ មុខ មេខ្លោង ជួញដូរ ចែកចាយ និង អ្នកប្រើប្រាស់ គ្រឿងញៀន សរុប ១៥ នាក់ ដែល ធ្វើ សកម្មភាព យ៉ាង សកម្ម នៅ ក្រុង ស្ទឹង សែន
( កំពង់ធំ )៖ លោក ឧត្តមសេនីយ៍ ទោ អ៊ុក កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ធំ បាន ធ្វើ សន្និសីទ សារព័ត៌មាន បង្ហាញ មេខ្លោង ជួញដូរ ចែកចាយ ចំនួន ០២ នាក់ និង ប្រើប្រាស់ សារធាតុ ញៀន ខុស ច្បាប់ ចំនួន ១៣នាក់ ( ស្រី ០១ នាក់ ) ដែល ធ្វើ សកម្មភាព ជួញដូរ ចែកចាយ និង ប្រើប្រាស់ សារធាតុ ញៀន យ៉ាង សកម្ម ក្នុង ភូមិសាស្ត្រ ក្រុង ស្ទឹង សែន ។ សន្និសីទ នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ ។
លោក ឧត្តមសេនីយ៍ ទោ អ៊ុក កុសល បាន ថ្លែង ថា អង្គភាព នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ធំ ជានិច្ចកាល បាន យកចិត្តទុកដាក់ អនុវត្តន៍ តាម គោលការណ៍ និង សេចក្តីណែនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ជាពិសេស សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ លោក នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ ហើយ ថ្នាក់ដឹកនាំ តែងតែ ផ្តាំផ្ញើ ជំរុញ ឲ្យ យកចិត្តទុកដាក់ ក្នុង ការបង្ការ បង្ក្រាប បទល្មើស គ្រឿងញៀន ជា ការងារ រួម ។
បន្ទាប់មក នៅ ថ្ងៃទី ១០ ខែឧសភា ឆ្នាំ ២០១៩ ម៉ោង ១៥៖ ០៥ នាទី សមត្ថកិច្ច ជំនាញ បាន ប្រើប្រាស់ វិធានការ ជំនាញ របស់ ខ្លួន បាន ចុះបង្ក្រាប ករណី ជួញដូរ ០១ករណី ឃាត់ខ្លួន ជនសង្ស័យ បាន ១១នាក់ ។ ក្នុង នោះ ឃាត់ខ្លួន មេ ខ្លោង មុខ សញ្ញា ជួញដូរ ចែកចាយ ម្នាក់ ឈ្មោះ វ៉ាន់ ឆេងប៉ាវ ភេទ ប្រុស នៅ ភូមិ ស្ទឹង សែន សង្កាត់ កំពង់ ក្របៅ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ និង ឃាត់ខ្លួន មុខ សញ្ញា ប្រើប្រាស់ ១០នាក់ ( ស្រី ០១ នាក់ ) វត្ថុតាង ញៀន ចំនួន ០១ កញ្ចប់ ។
មេខ្លោង វ៉ាន់ ឆេងប៉ាវ ជា មុខសញ្ញា ចាស់ ហើយ មាន ល្បិច កល ច្រើន ប្រភេទ ដែល បាន ធ្វើ សកម្មភាព ចែកចាយ ដោយ ផ្ញើ តាមរយៈ ម៉ូតូ ឌុប យក ទៅឲ្យ អ្នកប្រើប្រាស់ បន្ត ព្រមទាំង ប្រើប្រាស់ ល្បិច កល លួងលោម អូសទាញ ក្មេង ៗ ជា អនីតិជន ឲ្យ យក ថ្នាំ ញៀន ទៅឲ្យ អ្នកប្រើប្រាស់ ជា បន្តបន្ទាប់ ដោយ ក្នុង ០១ លើក មេខ្លោង វ៉ាន់ ឆេងប៉ាវ បាន ឲ្យ កំរ៉ៃ ទៅ ក្មេង ៗ ចាប់ពី ៥ពាន់ រៀល ទៅ ១ម៉ឺន រៀល តាម ថ្នាំ ញៀន តិច ឬ ច្រើន ។ ហើយ ពួកគេ បាន ប្រមូលផ្ដុំ គ្នា ដើម្បី ប្រើប្រាស់ និង មាន ការផ្លាស់ប្តូរ ទីតាំង និង ពេលវេលា ជា បន្តបន្ទាប់ ។
លោក ស្នងការ នគរបាល ខេត្ត កំពង់ធំ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត កំពង់ធំ និង ទូទាំង ប្រទេស កម្ពុជា សូម គិត ថា បញ្ហា គ្រឿងញៀន ជា ការងារ រួម ហើយ បើ ឃើញ មាន សកម្មភាព ជួញដូរ ចែកចាយ ៕
អភិបាល ខេត្ត កំពង់ចាម ចុះ ពិនិត្យ ការសាងសង់ ខឿន ការពារ ច្រាំង ទន្លេ ឡើងវិញ បន្ទាប់ពី បាក់ ស្រុត ដោយសារ ទឹក ជំនន់
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក គួច ចំរើន នៅ ព្រឹក ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩នេះ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យមើល ការសាងសង់ ខឿន ការពារ ច្រាំង ទន្លេ ឡើងវិញ បន្ទាប់ពី ច្រាំង ទន្លេ នេះ បាន បាក់ ស្រុត កាលពី រដូវ ទឹក ជំនន់ កន្លង ទៅ ស្ថិត ក្នុង ក្រុង កំពង់ចាម ខេត្ត កំពង់ចាម ។
ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ថ្លែង ប្រាប់ អង្គភាព Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០១៩ នេះ ថា បន្ទាប់ពី ទទួលបាន បទបញ្ជា យ៉ាង ម៉ឺងម៉ាត់ ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ នោះ លោក បាន បញ្ជា កម្លាំង ជំនាញ បើក ការស្រាវជ្រាវ ភ្លាម ៗ ជាបន្ទាន់ ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ រហូតមកដល់ ពេលនេះ កម្លាំង ជំនាញ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពុង សហការ ជាមួយ នាយកដ្ឋាន ជំនាញ ពាក់ព័ន្ធ បើក ប្រតិបត្ដិការ យ៉ាង ក្ដៅ គគុក ដើម្បី ស្រាវជ្រាវ និង ឈានដល់ ការចាប់ខ្លូន ជនជាតិ ចិន មួយ ក្រុម ខាងលើ ដែល បង្ហោះ វីដេអូ ស្រែក គំរាម ចង់ បង្ក អសន្ដិសុខ នៅ ខេត្ត ព្រះសីហនុ ។
ប៉ុន្ដែ ទោះជា យ៉ាងណា ក៏ដោយ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ មិន ទាន់ អាច បញ្ជាក់ ច្បាស់ ថា ជនជាតិ ចិន ដែល បង្ហោះ វីដេអូ នោះ ស្នាក់ នៅ ឬ ក៏ ធ្វើការ នៅ ខេត្ត ព្រះសីហនុ នោះ ទេ ពោល ស្ថិត នៅក្រោម ការស្រាវជ្រាវ នៅឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន លើកទឹកចិត្ត ឱ្យ ប្រជាពលរដ្ឋ ដាំ បន្លែ បង្ការ ជុំវិញ ផ្ទះ សម្រាប់ ទទួលទាន
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ឱ្យ ដាំ បន្លែ បង្ការ នៅ ជុំវិញ ផ្ទះ របស់ ខ្លួន ទុក សម្រាប់ ទទួលទាន ខណៈ បច្ចុប្បន្ន គេ មើលឃើញ ថា ប្រជាពលរដ្ឋ ខ្មែរ មិន សូវ និយម ដាំ បន្លែ បង្ការ ជុំវិញ ផ្ទះ នោះ ទេ ទុក ឱ្យ ដី ដែល មាន ទំហំ ធំ ទំនេរ ចោល ។
ជាមួយ ការបង្ហាញ រូបភាព មួយ សន្លឹក ជាមួយ ឧត្តម ភរិយា សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក្នុង ចម្កា បន្លែ នៅ ជុំវិញ ផ្ទះ នោះ សម្តេច តេជោ ហ៊ុន សែន នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ១២ ខែឧភា ឆ្នាំ ២០១៩ នេះ បាន បញ្ជាក់ ថា ការដាំដុះ បន្លែ បង្ការ នៅ ជុំវិញ ផ្ទះ នោះ មិន មែន សម្រាប់ ជា ការលម្អ ទេ ប៉ុន្តែ សម្រាប់ យកមក ធ្វើ ម្ហូប អាហារ ។ ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ជំរុញ និង លើកទឹកចិត្ត ឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ ដាំដុះ បន្លែ បង្ការ នៅ ជុំវិញ ផ្ទះ ផងដែរ ។
សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ដូច្នេះ « ខ្ញុំ សូម ជំរុញ និង លើកទឹកចិត្ត ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដាំដុះ ដំណាំ បន្លែ បង្ការ សម្រាប់ ទទួលទាន ជុំវិញ ផ្ទះ ព្រោះ ជីជាតិ ដី ប្រទេស យើង គឺ អំណោយផល ល្អ ណាស់ សម្រាប់ ដំណាំ កសិកម្ម » ។
សម្តេច តេជោ ក៏ បាន ឆ្លៀត ដាស់ ស្មារតី របស់ ប្រជាពលរដ្ឋ ដែរ ថា ការដាំ ដំណាំ បន្លែ ផ្លែ ឈើ គ្មាន ដាក់ ជី គីមី គឺ ដើម្បី សុខភាព ទាំងអស់ គ្នា ទាំង សម្រាប់ អ្នក ដាំ និង អ្នកប្រើប្រាស់ ។
ទន្ទឹមការលើកទឹកចិត្ត របស់ ប្រមុខ រាជ រដ្ឋាភិបាល នេះ គេ ក៏ សង្កេតឃើញ ដែរ ថា បច្ចុប្បន្ន ប្រជាពលរដ្ឋ នៅ តាម ទី ជនបទ ភាគ ច្រើន មាន ផ្ទៃដី ធំ ៗ នៅ ជុំវិញ លំនៅឋាន របស់ ពួកគេ ។ តែ ពួកគេ មិន សូវ និយម ដាំ ដំណាំ បន្លែ បង្ការ នៅ ជុំវិញ ផ្ទះ សម្រាប់ ទុក ទទួលទាន នោះ ឡើយ ដោយ ទុក ឱ្យ ដី ទាំងនោះ ទំនេរ ចោល ។ អ្នក ខ្លះ លើកឡើង ថា បន្លែ បង្ការ បច្ចុប្បន្ន មាន តម្លៃ ថោក ងាយស្រួល ទិញ មក ទទួលទាន ទើប ពួកគេ មិន សូវ ជា រវីរវល់ ជាមួយ ការដាំ បន្លែ នៅ ជុំវិញ ផ្ទះ នេះ ។
ការលើកទឹកចិត្ត របស់ ប្រមុខ របស់ រាជ រដ្ឋាភិបាល មាន សាធារណៈ ម តិ មួយចំនួន បាន បង្ហាញ ការគាំទ្រ ជាខ្លាំង ការដាំដុះ បន្លែ បង្ការ នៅ ជុំវិញ ផ្ទះ សម្រាប់ ទទួលទាន នេះ ជួយ ធ្វើឱ្យ ប្រជាពលរដ្ឋ កាត់បន្ថយ ការចំណាយ លើ បន្លែ បង្ការ ហើយក៏ ជួយ ធានា ដល់ សុខភាព របស់ ពួកគេ ចៀស ផុត ពី ការបរិភោគ បន្លែ បង្ការ លក់ លើ ទីផ្សារ ដែល មាន សារធាតុ គីមី ផងដែរ ៕
ខ្ញុំ បាន ស្ដារ ទំនាក់ទំនង ការទូត ជាមួយ ទីក្រុង ប៉េកាំង ឱ្យ វិល ទៅរក ភាព ប្រក្រតី វិញ នៅ ឆ្នាំ ១៩៧៩ ។ ចាប់តាំងពី ពេល នោះ មក តើ លោក ដឹង ទេ ថា តើ ចិន បាន ធ្វើ សង្គ្រាម ប៉ុន្មាន ដង ជាមួយ ប្រទេស ដទៃ ? សូម្បីតែ ម្តង ក៏ គ្មាន ផង ។ រីឯ យើង វិញ យើង ធ្វើ សង្គ្រាម ឥត ឈប់ឈរ ។
សហរដ្ឋ អាមេរិក គឺជា ប្រជាជាតិ មួយ ដែល ស្រឡាញ់ សង្គ្រាម ជាង គេ បង្អស់ នៅក្នុង ប្រវត្តិសាស្ត្រ ពិភពលោក ពីព្រោះ អាមេរិក ចេះតែ ចង់ បង្ខំ ឲ្យ បណ្តា ប្រទេស ដទៃ ទទួលយក គុណ តម្លៃ របស់ ខ្លួន ។ ចំណែកឯ ចិន វិញ មិន ប្រើប្រាស់ ធនធាន របស់ គេ ដើម្បី ធ្វើ សង្គ្រាម ទេ តែ ដើម្បី ការអភិវឌ្ឍ ដូចជា យក ទៅ សាងសង់ ផ្លូវ ដែក សម្រាប់ រថភ្លើង ល្បឿន លឿន ជាដើម ។ ចុះ យើង វិញ តើ យើង មាន ផ្លូវ ដែក សម្រាប់ រថភ្លើង ល្បឿន លឿន ប៉ុន្មាន គីឡូម៉ែត្រ ហើយ នៅក្នុង ប្រទេស របស់ យើង ?
យើង បាន ខ្ជះខ្ជាយ ប្រាក់ អស់ ៣ទ្រី លាន ដុល្លារ ក្នុង សកម្មភាព យោធា ជាពិសេស គឺ ការធ្វើ សង្គ្រាម ។ ចិន សូម្បីតែ មួយ សេន ក៏ មិន ចំណាយ ផង ក្នុង ការធ្វើ សង្គ្រាម ហេតុ ដូច្នេះហើយ បានជា ចិន កំពុង វ៉ា ឈ្នះ យើង នៅ ស្ទើ តែ គ្រប់ វិស័យ » ។
ដូច្នេះ បើសិនជា យើង យក លុយ ៣ទ្រី លាន ដុល្លារ ទៅ អភិវឌ្ឍ លើ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ អាមេរិក នោះ យើង នឹង មាន ផ្លូវ ដែក សម្រាប់ រថភ្លើង ល្បឿន លឿន ។ យើង នឹង មាន ស្ពាន និង ផ្លូវ ជាច្រើន ។ រីឯ ប្រព័ន្ធ អប់រំ របស់ យើង ក៏ នឹង មាន គុណភាព ល្អ ដូចជា ប្រទេស កូរ៉េ ខាងត្បូង ឬ ទីក្រុង ហុងកុង ផងដែរ ៕
សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ សូម ព្រះបរម រាជានុញ្ញាត ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ នៃ កម្ពុជា នា ឱកាស ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម គម្រប់ ៦៦ យាង ចូល ៦៧ ព្រះវស្សា
កម្ពុជា ដើរតួ ជា ប្រទេស កិត្តិយស ក្នុង ពិព័រណ៍ ផ្លូវ សូត្រ អន្តរជាតិ លើក ទី៤ នៅ ទីក្រុង ស៊ី អាន ខេត្ត សាន ស៊ី ប្រទេស ចិន
ការចូលរួម របស់ កម្ពុជា ក្នុង ព្រឹត្តិការណ៍ នេះ គឺ បង្ហាញ នូវ ការគាំទ្រ របស់ កម្ពុជា ចំពោះ គោល នយោបាយ បើក ចំហរ ទីផ្សារ និង ការត្រួសត្រាយ ផ្លូវ សម្រាប់ វិស័យ ឯកជន ដើម្បី តភ្ជាប់ ទំនាក់ទំនង សេដ្ឋកិច្ច ពាណិជ្ជកម្ម រវាង បណ្តា ប្រទេស ក្នុង គន្លង « ផ្លូវ មួយ ខ្សែក្រវាត់ មួយ » របស់ ប្រទេស ចិន ។
ថ្លែង ក្នុង ឱកាស នៃ ការបើក សម្ពោធ ពិព័រណ៍ កាលពី ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩ លោក យឹម ឆៃលី បាន ជម្រាប អ្នកចូលរួម ប្រមាណ ៥០០ នាក់ អំពី កិច្ចសហប្រតិបត្តិការ លើ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ក្រោម គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ មួយ ផ្លូវ មួយ » នឹង ផ្តល់ ឱកាស ជួយ ជំរុញ ឲ្យ ប្រទេស ទាំង២ កម្ពុជា - ចិន បន្ត កិច្ចសហការ អភិវឌ្ឍន៍ លើ វិស័យ ផ្សេង ៗ ទៀត ដូចជា បច្ចេកវិទ្យា កសិកម្ម ការធ្វើ ទំនើបកម្ម ផលិតកម្ម កសិកម្ម និង ជនបទ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ អប់រំ យុវជន កីឡា និង វប្បធម៌ ជាដើម ។ល ។
សូម បញ្ជាក់ ថា ក្នុង នាម ជា ប្រទេស កិត្តិយស ក្នុង ពិព័រណ៍ ផ្លូវ សូត្រ ឆ្នាំ ២០១៩ កម្ពុជា បាន រៀបចំ ពន្លា ជាតិ មួយ ដែល តុបតែង លម្អ តាមរចនាបទ ខ្មែរ សង់ តាម លំនាំ ព្រះបរម រាជ វាំង ដំបូល ប្រក់ ក្បឿង ស្រកាលិញ និង ផ្នែក ខាងក្នុង មាន តុ សម្រាប់ ដាក់ ឯកសារ ផ្សព្វផ្សាយ ពី គោល នយោបាយ វិនិយោគ វប្បធម៌ និង ផលិតផល ខ្មែរ ។ ជាមួយគ្នា នេះ មាន ការរៀបចំ ស្តង់ ពិព័រណ៍ មួយចំនួន ទៀត សម្រាប់ ពាណិជ្ជករ ខ្មែរ ដាក់ បង្ហាញ ផលិតផល របស់ ខ្លួន ផងដែរ ។
ក្នុង អំឡុង ពេល នៃ ការចូលរួម ពិព័រណ៍ នេះ កម្ពុជា បាន នាំយក ក្រុម សិល្បករ សិល្បការិនី ចូលរួម សម្តែង រួមគ្នា ជាមួយ សិល្បករ សិល្បការិនី របស់ ប្រទេស ចិន និង ប្រទេស រុស្ស៉ី ចំនួន ២រាត្រី ជាប់ គ្នា ព្រមទាំង សម្តែង ជា ប្រចាំ នៅ ពន្លា ជាតិ កម្ពុជា យើង ជូន មហាជន ទស្សនា ដើម្បី ផ្សព្វផ្សាយ ពី សិល្បៈ វប្បធម៌ ដ៏ ល្អ ផូរផង់ របស់ កម្ពុជា លើ ឆាក អន្តរជាតិ ។
ក្នុង រយៈពេល ៤ឆ្នាំ នេះ ព្រឹត្តិការណ៍ ដ៏ ធំ នេះ បាន ក្លាយជា វេទិកា មួយ សម្រាប់ ជំរុញ សកម្មភាព ពាណិជ្ជកម្ម វិនិយោគ សេដ្ឋកិច្ច នយោបាយ ទេសចរណ៍ វប្បធម៌ និង ទំនាក់ទំនង ការទូត ជាពិសេស កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ រវាង ប្រទេស ចិន និង បណ្តា ប្រទេស ក្នុង តំបន់ និង ពិភពលោក ៕ រដ្ឋបាល ស្រុក គាស់ ក្រឡ ខេត្ត បាត់ដំបង ចេញមក បំភ្លឺ និង ច្រានចោល ការចោទប្រកាន់ តាម បណ្ដាញ សង្គម ករណី វិវាទ ដីធ្លី រវាង ប្រជាពលរដ្ឋ នៅ ចំណុច ភ្នំ ស្ន
