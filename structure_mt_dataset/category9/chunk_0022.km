( កំពង់ស្ពឺ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ បាន បញ្ជាក់ ថា ក្នុង នាម ជា កងទ័ព ចាំបាច់ បំផុត ត្រូវតែ មាន ការហ្វឹកហ្វឺន ហាត់ ឱ្យ បាន ជាប់ ជាប្រចាំ ទាំង ជំនាញ យោធា ចំណេះដឹង ទូទៅ ភាសា បរទេស និង ជំនាញ ឯកទេស ផ្សេង ៗ ដើម្បី មាន គ្រប់ លទ្ធភាព ក្នុង ការចូលរួម ការពារ ជាតិ មាតុភូមិ អធិបតេយ្យ ជាតិ បូរណភាព ទឹកដី និង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ។
ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក វគ្គ ហ្វឹកហ្វឺន បណ្តុះបណ្តាល នាយ ទាហាន សកម្ម ជំនាន់ ទី ២៣ នៅឯ សាលា នាយ ទាហាន សកម្ម នៃ កងយោធពល ខេមរភូមិន្ទ ក្នុង ខេត្ត កំពង់ស្ពឺ ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ក៏ បាន លើក សរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចខិតខំ បំពេញ ការងារ របស់ ថ្នាក់ដឹកនាំ យោធាចារ្យ បុគ្គលិក បម្រើ ការ និង នាយ ទាហាន ទាំងអស់ របស់ សាលា ដែល កន្លងមក បាន សហការ គ្នា យ៉ាង ល្អ ក្នុង ការរៀបចំ ឱ្យ មាន កម្មវិធី សក្សា និង កិច្ច ដំណើ ការ នូវ វគ្គ ហ្វឹកហ្វឺន ជាច្រើន សំដៅ ពង្រឹង ពង្រីក សមត្ថភាព កងទ័ព របស់ យើង ឱ្យ កាន់តែ មាន គុណភាព ដែល អាច ពង្រឹង ប្រៀបការពារ ជាតិ ការពារ បូរណភាព ទឹកដី កម្ពុជា ឱ្យ កាន់តែ រឹងមាំ ។
ទន្ទឹមនឹង នេះ ដែរ នាយ ឧត្តមសេនីយ៍ ក៏ បាន នាំមក នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សួរសុខទុក្ខ និង ក្តី នឹករលឹក ប្រកបដោយ មនោសញ្ចេតនា យ៉ាង ជ្រាលជ្រៅ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន . សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ និង អគ្គ បញ្ជាការ កងយោធពល ខេមរភូមិន្ទ ផ្ញើ ជូន ចំពោះ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន យោធាចារ្យ និង សិក្ខាកាម នាយ ទាហាន សកម្ម ទាំងអស់ នៅក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ផងដែរ ៕
ទេសរដ្ឋមន្រ្តី គន់ គីម ប្រគល់ ផ្ទះ ១៦ ខ្នង ជា អំណោយ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កត្តិ ព្រឹទ្ធបណ្ឌិត ជូន អតីត យុទ្ធជន ១៦ គ្រួសារ នៅ ខេត្ត កែប
( កែប )៖ ទេសរដ្ឋមន្រ្តី គន់ គីម អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា អម ដំណើរ ដោយ លោក ឯក ក្រិត រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា . លោក កែន សត្ថា អភិបាល ខេត្ត កែប និង លោក ឧកញ៉ា វិញ ហ៊ួរ នា ព្រឹក ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ទៅ ប្រគល់ ផ្ទះ ជូន អតីត យុទ្ធជន ចំនួន ១៦ គ្រួសារ ។
ផ្ទះ នេះ ធ្វើ ពី ថ្ម ប្រក់ សង្ក័ សី ទំហំ ៤ម៉ែត្រ គុណ ៩ម៉ែត្រ និង មាន បន្ទប់ទឹក មួយ ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កត្តិ ព្រឹទ្ធបណ្ឌិត សាងសង់ ដោយ ឧកញ៉ា វិញ ហួរ ជូន ដល់ បងប្អូន អតីត យុទ្ធជន ខេត្ត កែប ។ ពិធី នេះ បាន ប្រារព្ធ ធ្វើឡើង នៅ ភូមិ ដំណាក់ ចង្អើរ សង្កាត់ ព្រៃ ធំ ក្រុង កែប ខេត្ត កែប ។
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន នាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពី សម្តេច តេជោ ជូន ដល់ អតីត យុទ្ធជន ។ បន្ទាប់មក លោក អគ្គ លេខាធិការ បាន ថ្លែងអំណរគុណ ចំពោះ បងប្អូន ដែល បាន ធ្វើជា គំរូល្អ នៅ មូលដ្ឋាន រក្សា បាន កិត្តិយស និង សេចក្ដីថ្លៃថ្នូរ ក្នុង នាម ខ្លួន ជា អតីត កងកម្លាំងប្រដាប់អាវុធ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន ផ្តាំផ្ញើ ដល់ បងប្អូន ដែល មក រស់ នៅ ទីនេះ ត្រូវ ចេះ រក្សា អនាម័យ ដើម្បី បង្ការ ជំងឺ ថែរក្សា ផ្ទះសម្បែង និង ត្រូវ ចេះ សាមគ្គី គ្នា អធ្យាស្រ័យ ឲ្យ គ្នា ទៅ វិញ ទៅ មក រវាង អ្នកជិតខាង គ្នា ។ លោក ទេសរដ្ឋមន្រ្តី និង ជា អគ្គ លេខាធិការ ស. អ. ក បាន សំណូមពរ ឲ្យ លោក អភិបាល ខេត្ត កែប ចលនា សប្បុរសជន ជួយ ឧបត្ថម្ភ បងប្អូន ក្នុង ដំណាក់កាល ដែល ពួកគាត់ ទើប មក នៅ ថ្មី ។
ជា ការឆ្លើយតប ចំពោះ មុខ លោក អភិបាល ខេត្ត បាន សម្រេច ត បណ្តាញ អគ្គិសនី ចូលមកដល់ ផ្ទះ បងប្អូន ។
នៅក្នុង ពិធី នេះ លោក ឧកញ៉ា វិញ ហ៊ួរ ក្នុង នាម សម្តេច ទាំង ពីរ បាន ឧបត្ថម្ភ សម្ភារ ប្រើប្រាស់ និង គ្រឿង ឧបភោគ បរិភោគ ជាច្រើន ជូន បងប្អូន ទាំង ១៦ គ្រួសារ ដែល ទទួលបាន ផ្ទះ និង ថវិកា ក្នុង ១គ្រួសារ ២០ ម៉ឺន រៀល និង ជូន បងប្អូន អតីត យុទ្ធជន ដែល មក ចូលរួម ក្នុង ពិធី នេះ ចំនួន ១០០ នាក់ ក្នុង ម្នាក់ ៗ ចំនួន ៥ម៉ឺន រៀល ។
បងប្អូន អតីត យុទ្ធជន ទាំង ១៦ គ្រួសារ សូម សំដែង ការដឹងគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ដែល ជានិច្ចកាល បាន គិតគូរ ពី សុខ ទុក្ខ របស់ ពួកគាត់ ទាំង ជីវភាព រស់ នៅ ទាំង សុខភាព ផ្តល់ ផ្ទះ ផ្តល់ ដី ដល់ ពួកគាត់ ដែល មាន ជីវភាព ខ្វះខាត ពួកគាត់ សូម ជូនពរ ឲ្យ សម្តេច ទាំង ពីរ ព្រមទាំង ក្រុមគ្រួសារ បាន សុខសប្បាយ សុខភាព រឹងមាំ បន្ត ដឹកនាំ ប្រទេស កម្ពុជា ជារៀងរហូត ៕ ក្រុមហ៊ុន ធំ ៗ ចំនួន ១០ ប្រកាស ជ្រើសរើស បុគ្គលិក ជិត ២ពាន់ កន្លែង !
( ភ្នំពេញ ) ៖ ឱកាស ការងារ ចំនួន ១៩៨២កន្លែង ទៀត ហើយ បាន នឹង កំពុង រង់ចាំ សិស្ស - និស្សិត ដែល កំពុង ស្វែងរក ការងារ និង ចង់ ផ្លាស់ប្តូរ ការងារ ថ្មី ពី ក្រុមហ៊ុន ចំនួន ១០ សម្រាប់ វេទិកា ការងារ នា ថ្ងៃទី ២៥ ខែមេសា ខាងមុខ នេះ ។
អាស្រ័យ ហេតុ នេះ សិស្ស និស្សិត អ្នក ស្វែងរក ការងារ ធ្វើ និយោជក ព្រមទាំង ប្រជាពលរដ្ឋ កម្ពុជា ទាំងអស់ ដែល កំពុង ស្វែងរក ការងារ ធ្វើ ឬ ត្រូវការ បទពិសោធន៍ ស្វែងរក ការធ្វើ និង ត្រូវការ ជ្រើសរើស កម្លាំង ពលកម្ម អាច ទទួលបាន សេវា ផ្តល់ ជូន ដោយ រាជ រដ្ឋាភិបាល ដោយ មិន គិត កម្រៃ ។
ការចូលរួម ផ្សព្វផ្សាយ កម្មវិធី សង្រ្កាន្ត នេះ គឺ ធ្វើឡើង ដើម្បី ចូលរួមចំណែក ផ្សព្វផ្សាយ ពី ទីតាំង រម្មណីយ៍ដ្ឋាន នៅ តាម បណ្ដា ខេត្ត ដែល ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ នៅ មិន ទាន់ បាន ស្គាល់ នៅឡើយ ។ នេះ បើ តាម ការបញ្ជាក់ បន្ថែម របស់ លោក រដ្ឋមន្រ្តី នៅក្នុង ពី ធី អបអរសាទ ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ខ្មែរ ដែល ធ្វើឡើង នៅ ក្រសួង ព័ត៌មាន ។
លោក ខៀវ កាញារីទ្ធ បាន ឱ្យដឹង ថា គ្រប់ ប្រធាន មន្ទីរ គ្រប់ ខេត្ត ក្រុង អាច ថត វីដេអូ ពាក់ព័ន្ធ នឹង សង្រ្កាន្ត នៅ តាម របស់ ខ្លួន រួច ផ្ញើ មកកាន់ ទូរទស្សន៍ និង វិទ្យុ ជាតិ ដើម្បី អាច ច ជួយ ផ្សព្វផ្សាយ បាន កាន់តែ ច្រើន ។
យ៉ាងណាមិញ លោក រដ្ឋមន្រ្តី បាន ផ្ញើ សារ ជូនពរ ទៅកាន់ ប្រជាពលរដ្ឋ គ្រប់ រូប ថា ប្រទេស ខ្មែរ មាន សន្តិភាព ហើយ សន្តិភាព នេះ អាច មាន ទៅ បាន គឺ អាស្រ័យ លើ ការយោគយល់ គ្នា គោរព ច្បាប់ ទម្លាប់ និង ផ្ដល់ ការទុកចិត្ត ចំពោះ រាជ រដ្ឋាភិបាល ដែល បាន ប្រឹងប្រែង អស់ រយៈពេល ជាង ៤០ ឆ្នាំ មក នេះ បាន ធ្វើឲ្យ កម្ពុជា មាន ការអភិវឌ្ឍន៍ មួយ ជំហាន ម្ដង ៗ ប្រកបដោយ ភាពសុខដុមរមនា ៕
( ភ្នំពេញ ) ៖ កម្លាំង អន្តរាគមន៍ ពិសេស និង កម្លាំង ផ្នែក សន្តិសុខ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន បើក ប្រតិបត្តិការ ប្រដេញ ចាប់ ក្រុម ចោរ ឆក់ ២នាក់ បាន ភ្លាម ៗ បន្ទាប់ពី ក្រុម ចោរ ខាងលើ នោះ បាន ធ្វើ សកម្មភាព ឆក់ កាបូប របស់ ស្ត្រី ជនជាតិ ដី គោក ម្នាក់ បាន សម្រេច ខណៈ ជនរងគ្រោះ កំពុង ឈរ ថត បុគ្គលិក នៅ ភោជនីយដ្ឋាន ក្វាង ទុង លេង ល្បែង ប្រជាប្រិយ ក្នុង ឱកាស អបអរ ឆ្នាំ ថ្មី បុណ្យ ចូល ឆ្នាំ ខ្មែរ ប្រពៃណី ជាតិ និង ធ្វើឲ្យ ជនរងគ្រោះ ដួលរង របួស ផងដែរ ។
ហេតុការណ៍ ខាងលើ នោះ បាន កើតឡើង នៅ យប់ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០១៩ នៅ ចំណុច ផ្លូវ សហព័ន្ធ រុស្ស៊ី មុខ ហាង ភោជនីយដ្ឋាន ក្វាង ទុង ក្នុង ភូមិ ព្រៃ ទា សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
លោក យឹម សារ៉ាន់ បាន បន្ត ទៀត ថា ក្រោម ការបញ្ជា ផ្ទាល់ ពី ឧត្តមសេនីយ៍ ឯក ស ថេត ស្នងការ នគរបាល រាជធានី ភ្នំពេញ . កម្លាំង ទាំងអស់ បាន អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ដោយ កម្លាំង របស់ លោក តែងតែ ល្បាត ពួន ស្ទាក់ បង្ក្រាប បទល្មើស នានា ជាក់ស្តែង បាន បង្ក្រាប ក្រុម ចោរ ឆក់ ទាំងនេះ តែម្តង ។
បើ តាម លោក អធិការ ពេល ធ្វើ សកម្មភាព ភ្លាម ក ម្លាំង របស់ លោក បាន ឃើញ ក៏ បើក ប្រតិបត្តិការ ប្រដេញ ចាប់ ជនសង្ស័យ ទាំង ២នាក់ ដោយ ប្រើ រយៈពេល តែ ប៉ុន្មាន នាទី ប៉ុណ្ណោះ និង បាន យក កាបូប លុយ ប្រគល់ជូន ជនរងគ្រោះ វិញ ផងដែរ ។
បើ តាម ការបញ្ជាក់ ពី ជំនាញ ព្រហ្មទណ្ឌ ខណ្ឌ បាន ឲ្យដឹង ថា សម្រាប់ ជនសង្ស័យ លឹម លាង ហេង ត្រូវបាន ចាប់ខ្លួន ម្តង រួច មកហើយ ក្នុង ករណី ឆក់ កាបូប នារី ខារ៉ាអូខេ ម៉ូឌែន ស៊ី ផ្លូវ ជាតិ លេខ ៣ ក្នុង កំឡុង ឆ្នាំ ២០១៧ ។ តាម ចំលើ យ របស់ ជនសង្ស័យ ខាង នេះ ថា ខ្លួន ធ្លាប់ ធ្វើ សកម្មភាព ឆក់ ជាច្រើន លើក សុទ្ធតែ បាន សម្រេច ។
ជាមួយ ជា នេះ ដែរ ស្រ្តី ជនជាតិ ចិន ដី គោក ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ដល់ កម្លាំង នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ដែល បាន ធ្វើ ការបង្ក្រាប ក្រុម ចោរ ឆក់ ទាំងនេះ បាន ភ្លាម ៗ និង បាន ប្រគល់ កាបូប ជូន គាត់ វិញ ដោយ មិន មាន ការបាត់បង់ ទ្រព្យសម្បត្តិ សូម្បីតែ មួយ កាក់ មួយ សេន ។
បច្ចុប្បន្ន ជនសង្ស័យ ទំាង ២នាក់ ត្រូវបាន កម្លាំង ជំនាញ ប៉ុស្តិ៍ នគរបាល ចោម ចៅ ទី៣ កំពុងតែ សួរ នាំ និង កសាង សំណុំរឿង បញ្ជូន បន្ត ទៅ កាន់ ផ្នែក ជំនាញ ព្រហ្មទណ្ឌ នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ ចាត់ការ បន្ត តាម នីតិវិធី ច្បាប់ ៕
យ៉ាងណាមិញ ពុំ ទាន់ មាន ការបញ្ជាក់ ជា ផ្លូវការ ជុំវិញ ព័ត៌មាន នេះ នៅឡើយ ទេ ក៏ប៉ុន្តែ ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក របស់ ស៊ូ ដង់ បាន បញ្ជាក់ ថា នឹង ចេញផ្សាយ សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង ការពារ ជាតិ នា ពេល បន្តិច ទៀត ស្តី អំពី ស្ថានការណ៍ នៅក្នុង ប្រទេស ដើម្បីឲ្យ មហាជន យល់ ពី រឿង ពិត ។
គួរ ជម្រាប ថា ចាប់តាំងតែពី ខែធ្នូ ឆ្នាំ ២០១៨ បាតុកម្ម បាន កើតមាន ជា បន្តបន្ទាប់ ដោយសារតែ ការឡើង ថ្លៃ ទំនិញ ហើយ ក្នុង ការតវ៉ា ទាំងនោះ មាន ការទាមទារ ឲ្យ លោក Omar Bashir ដែល កាន់អំណាច អស់ រយៈពេល ជាង ៣០ ឆ្នាំ មកហើយ នោះ ចុះចេញ ពី តំណែង ខណៈ កាលពី ចុង សប្តាហ៍ មុន ក្រុម បាតុករ ក៏ បាន ទទូច ឲ្យ យោធា មក ចូលរួម កម្លាំង ជាមួយ ប្រជាជន ផងដែរ ស្រប ពេល ដែល ការតវ៉ា ដែល បាន បន្ត មកដល់ សប្តាហ៍ នេះ បាន បណ្តាលឲ្យ ជន ស៊ីវិល មួយចំនួន ស្លាប់ ក្នុង ការប៉ះទង្គិច គ្នា ជាមួយ កម្លាំង សន្តិសុខ ៕
បុណ្យ ចូល ឆ្នាំ ថ្មី កាន់តែ ខិត ជិត មកដល់ ! លោក ហេង រតនា ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ដល់ ជន ចាស់ជរា ក្រីក្រ នៅ ស្រុក លើក ដែក ខេត្ត កណ្តាល
( កណ្ដាល ) ៖ លោក ហេង រតនា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក លើក ដែក ខេត្ត កណ្តាល នា ព្រឹក ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន ចុះ សំណេះសំណាល សួរសុខទុក្ខ និង ចែក អំណោយ ជូន ដល់ ជន ចាស់ជរា ក្រីក្រ ប្រមាណ ៤០ គ្រួសារ មកពី ឃុំ កំពង់ភ្នំ ស្រុក លើក ដែក ខេត្ត កណ្តាល ដោយ បាន ចែកជូន នូវ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា មួយ ចំនួន ។
បន្ទាប់ពី បញ្ចប់ ការជួប សំណេះសំណាល ជាមួយ ជន ចាស់ជរា ក្រីក្រ រួច មក លោក ហេង រតនា បាន ចុះ ពិនិត្យ និង សាកសួរ សុខទុក្ខ អ្នកជំងឺ និង ក្រុមគ្រួសារ ពេទ្រស្ម គ្រចិត្ត ដែល អញ្ជើញ មកពី មន្ទីរពេទ្យ ព្រះកេតុ មាលា ដែល កំពុង ពិនិត្យ ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ១០០០ នាក់ ដោយ ឥត គិត ថ្លៃ នៅ ឃុំ កំពង់ភ្នំ ស្រុក លើក ដែក ខេត្ត កណ្តាល ។ ក្នុង ឱកាស នោះ លោក បាន ឧបត្ថម្ភ នូវ ថវិកា មួយ ចំនួន ផងដែរ ជូន ដល់ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត ។
បន្ទាប់ពី បញ្ចប់ ពិធី សំណេះសំណាល រួច មក លោក ហេង រតនា និង ក្រុមការងារ បាន ចូល ជួបប្រជុំ ជាមួយ ថ្នាក់ដឹកនាំ យុវជន ស្រុក លើក ដែក ខេត្ត កណ្ដាល ដើម្បី ផ្ដល់ ជា អនុសាសន៍ ណែនាំ ក្នុង ការរៀបចំ សង្ក្រាន្ដ ឆ្នាំ ថ្មី ឆ្នាំ កុរ ឯកស័ក ព .ស ២៥៦៣ ដោយ លោក បាន ឧបត្ថម្ភ នូវ ការ ថវិកា មួយ ចំនួន ដល់ ក្រុមការងារ យុវជន ដើម្បីឲ្យ ការរៀបចំ សង្ក្រាន្ត ឆ្នាំ ថ្មី មាន ដំណើរការ ល្អ ៕ ក្រុមហ៊ុន ថ្មី មួយ ចាយ ទុន ១៨លាន ដុល្លារ បោះជំហាន ចូលក្នុង ទីផ្សារ បង់ រំលស់ គ្រឿងចក្រ កសិកម្ម នៅ កម្ពុជា
ដើម្បី កំណត់ ខ្លួន ឯង ឲ្យ ខុស ពី បណ្តា ក្រុមហ៊ុន ដទៃ ផ្សេង ទៀត ក្រុមហ៊ុន ថ្មី មួយ នេះ ផ្តល់ ជូន នូវ អត្រា ការប្រាក់ ទាប ការបង់ ត្រឡប់ មកវិញ មាន ច្រើន ប្រភេទ និង ការអនុម័ត ការបង់ រំលស់ យ៉ាង ឆាប់រហ័ស ដោយ គ្មាន បង្កប់ កម្រៃ សេវា ឬ ថ្លៃ សេវា បន្ថែម ផ្សេង ៗ ណាមួយ ឡើយ ។
អភិបាល ខេត្ត ព្រះវិហារ កម្ពុជា និង ប្រតិភូ ខេត្ត យាឡាយ វៀតណាម បន្ត ស្វែងរក អដ្ឋិធាតុ អតីត ទាហាន ស្ម័គ្រចិត្ត របស់ វៀតណាម នៅ កម្ពុជា
នៅក្នុង ឱកាស នោះ អភិបាល ខេត្ត ព្រះវិហារ បាន ជម្រាប ជូន លោក អនុប្រធាន លេខា បក្ស ខេត្ត យាឡាយ ពី ការបន្ត ចំណង មិត្តភាព កិច្ចសហប្រតិបត្តិការ កាន់តែ ល្អ បន្ថែម ទៀត រវាង ខេត្ត ព្រះវិហារ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាមួយ ខេត្ត យាឡាយ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម តាមរយៈ ការផ្លាស់ប្តូរ ទស្សនកិច្ច គ្នា ទៅ វិញ ទៅ មក ជា បន្តបន្ទាប់ ប្រកបដោយ ភាពកក់ក្តៅ និង ស្និតស្នាល ។
បន្ថែម ពី នេះ លោក អ៊ុន ចាន់ ដា បាន ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ ក៏ ដូច ប្រជាជន វៀតណាម ដែល តែងតែ បន្ត នូវ ប្រពៃណី ជា មិត្តភាព និង កិច្ចសហប្រតិការ ល្អ រហូតមក ។ លើស ពី នេះ ទៀត លោក អភិបាល ខេត្ត បាន បង្ហាញ ពី សមិទ្ធផល និង ការអភិវឌ្ឍ រីកចម្រើន ក៏ ដូច សក្តានុពល សំខាន់ របស់ ខេត្ត ព្រះវិហារ ក្រោម ការដឹកនាំ សម្តេច តេជោ ហ៊ុន សែន ជាពិសេស ខេត្ត តាម បណ្តោយ ព្រំដែន បាន ប្រែក្លាយជា ព្រំដែន សន្តិភាព កិច្ចសហប្រតិបត្តិការ ល្អ ។
ជា ការឆ្លើយតប លោក ចូវ ង៉ុក ទន់ បាន ថ្លែងអំណរ ជំនួស ប្រធាន លេខា បក្ស ក៏ ដូច ប្រជាជន ខេត្ត យាឡាយ ដែល លោក អភិបាល ខេត្ត ព្រះវិហារ ទទួលស្វាគម យ៉ាង កក់ក្តៅ បំផុត ដល់ ប្រតិភូ ខេត្ត យ៉ាឡាយ លើស ពី នេះ ទៀត ខេត្ត ព្រះវិហារ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រែក្លាយ ខេត្ត ព្រះវិហារ ឱ្យ មាន ការរីកចម្រើន ប្រជាពលរដ្ឋ មាន ជីវភាព ធូធារ ជាពិសេស បាន កសាង នូវ ព្រំដែន សន្តិភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ ប្រសើរ នា ពេល កន្លងមក និង ថ្ងៃ អនាគត ។
លោក អនុប្រធាលេខា បក្ស បាន ប្តេជ្ញា បន្ត បង្កើន មិត្តភាព កិច្ចសហប្រតិបត្តិ ល្អ ជាមួយ ខេត្ត ព្រះវិហារ ឱ្យ បាន យូរអង្វែង ទៅ និង សូម គាំទ្រ នូវ សំណូមពរ របស់ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ ក្នុង ការបង្កើត ឱ្យ មាន ការផ្លាស់ប្តូរ បទពិសោធន៍ រវាង យុវជន ខេត្ត ទាំង ពីរ តាម រយៈ ដំណើរទស្សនកិច្ច ដ៏ មាន សារសំខាន់ ៕ មន្រ្តី កាំ កុងត្រូល ខេត្ត កំពង់ធំ បន្ដ ត្រួតពិនិត្យ រក ទំនិញ ខូច គុណភាព នៅ ផ្សារ កំពង់ឈើ ទាល រកឃើញ កាហ្វេ និង ទឹកក្រូច ខូច គុណភាព និង ហួស កាលបរិច្ឆេទ
( កំពង់ធំ )៖ ដោយ ជិត ដល់ បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ខ្មែរ មន្ត្រី សាខា កាំ កុងត្រូល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០១៩ នេះ បាន សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង អាជ្ញាធរ មូលដ្ឋាន បាន បន្ត ចុះ ពិនិត្យ ផ្សព្វផ្សាយ អំពី គុណភាព និង សុវត្ថិភាព ម្ហូប អាហារ ស្ថិត នៅ ផ្សារ កំពង់ឈើ ទាល ភូមិ កំពង់ឈើ ទាល ឃុំ សំបូរ ស្រុក ប្រាសាទ សំបូរ ខេត្ត កំពង់ធំ ។
ក្នុង ឱកាស នោះ ដែរ មន្ដ្រី ជំនាញ ក៏ បាន ចែក ផ្សាយ នូវ រូបភាព Poster និង ផ្សព្វផ្សាយ ដល់ អាជីវករ អ្នកលក់ដូរ អ្នកប្រើប្រាស់ ឲ្យបាន យល់ ដឹង អំពី ផលវិបាក ដែល បណ្តាល មកពី ការបរិភោគ អាហារ ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ និង ការដាក់ លាយ បន្ថែម សារធាតុ គីមី ហាមឃាត់ ចូលក្នុង ម្ហូប អាហារ ផងដែរ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ រៀបចំ ពិធី សូត្រ មន្ត ចំរើន ព្រះបរិត្ត លើក រាសី ក្នុង ឱកាស ឆ្នាំ ថ្មី
