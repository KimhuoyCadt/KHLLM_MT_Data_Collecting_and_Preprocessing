( ត្បូងឃ្មុំ ) ៖ លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង លោកស្រី បាន អញ្ចើញ សំណេះសំណាល សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយសារ ខ្យល់ កន្រ្តាក់ ទទួលរង ផល ប៉ះពាល់ ដោយ ការប៉ើង ដំបូល និង រលំ ផ្ទះ ចំនួន ១៧០ គ្រួសារ ក្នុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ នា ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០១៩ ។
ថ្លែង នា ឱកាស នោះ រដ្ឋមន្ត្រី បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ នៅពេល មេឃ ងងឹត រក ភ្លៀង ម្តង ៗ សូម ផ្អាក ធ្វើ ការងារ ផ្សេង ៗ នៅ ក្រៅ ផ្ទះ ហាល ភ្លៀង ហើយ ឆាប់ រូតរះ រត់ រក ទីកន្លែង មាន សុវត្ថិភាព ដើម្បី ការពារ ខ្លួន កុំ ឲ្យ មាន គ្រោះថ្នាក់ ដោយសារ គ្រោះ ធម្មជាតិ ដូចជា មាន ផ្គរ រន្ទះ បាញ់ ខ្យល់ កន្ត្រាក់ ខ្យល់ព្យុះ ដែល នាំឲ្យ ជួប គ្រោះថ្នាក់ ផ្សេង ៗ ដល់ ប្រជាពលរដ្ឋ ផងដែរ ។
បន្ថែម ពីលើ នេះ រដ្ឋមន្ត្រី វង សូត បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បាន យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ គ្រប់ ទិសទី ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ ឡើយ ហើយ បញ្ហា គ្រោះ ធម្មជាតិ ខ្យល់ កន្រ្តាក់ នេះ ជា ការព្រួយបារម្ភ របស់ រាជ រដ្ឋាភិបាល ដែល បណ្តាល មកពី បម្រែបម្រួល អាកាសធាតុ និង សុំ ស្នើ ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ឲ្យ ជួយ តាមដាន បញ្ហា គ្រោះ ធម្មជាតិ នេះ ដើម្បី អាច ជួយ ដោះស្រាយ បញ្ហា ជូន ប្រជាពលរដ្ឋ បាន ទាន់ ពេល វេលា ។
ចំពោះ អំណោយ ដែល ចែកជូន ប្រជាពលរដ្ឋ រងគ្រោះ ចំនួន ១៧០ គ្រួសារ នា ឱកាស នោះ រួម មាន ៖ ក្នុង ១គ្រួសារ ៗ ទទួលបាន អង្ករ ២០ គីឡូក្រាម . មី១ កេស . ទឹកត្រី ១យួរ . ទឹក ស៊ីអ៊ីវ១ យួរ . តង់១ និង ថវិការ ១០ម៉ឺន រៀល សម្រាប់ ផ្ទះ ១៥៧ ខ្នង ខូចខាត តិចតួច និង ថវិការ ២០ ម៉ឺន រៀល សម្រាប់ គ្រួសារ ខូខាត ធ្ងន់ធ្ងរ ១៣គ្រួសារ ផងដែរ ៕ ក្នុង ខែ ពិសិដ្ឋ រ៉ាម៉ាឌន ទេសរដ្ឋមន្រ្តី អូស្មាន ហាស្សាន់ អំពាវនាវ សាសនិក ឥស្លាម ចូលរួម បរិច្ចាគ ទាន និង ខំប្រឹង សាង កុសល ផ្សេង ៗ ឲ្យ កាន់តែ ច្រើន
( ភ្នំពេញ ) ៖ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្រ្តី ទទួលបន្ទុក បេសកកម្ម ពិសេស បាន អំពាវនាវ ដល់ សាសនិក ឥស្លាម ទាំងអស់ ត្រូវ ចូលរួម ឲ្យបាន ផល ផុស ក្នុង ការបរិច្ចាគ ទាន និង កសាង ផល កុល្យ ផ្សេង ៗ ឲ្យ កាន់តែ ច្រើន ក្នុង ខែ ពិសិដ្ឋ របស់ ឥស្លាម រ៉ាម៉ាឌន ព្រោះ ខែ នេះ ការបរិច្ចាក ទាន ពិតជា មាន សារសំខាន់ ដល់ សហគមន៍ គ្រួសារ អ្នក ខ្វះខាត និង រាល់ អំពើ កុសល្យ ផ្សេង ៗ នឹង ទទួលបាន ផល បុណ្យ ច្រើន ជាង ខែ នានា ។
ថ្លែង បែប នេះ របស់ ទេសរដ្ឋមន្ដ្រី អូស្មាន ហាស្សាន់ ធ្វើឡើង នៅ ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក បាន ជួប សំណេះសំណាល និង នាំ អំណោយ កញ្ចប់ គ្រឿង ឧបភោគ បរិភោគ ជូន ដល់ សាសនិក ឥស្លាម ៧៥០ គ្រួសារ ក្នុង នោះ ២៥០ គ្រួសារ ជូន បងប្អូន នៅ សង្កាត់ ព្រែក ប្រា និង ៥០០ គ្រួសារ ជូន បងប្អូន នៅ សង្កាត់ ជ្រោយចង្វារ រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា កញ្ចប់ គ្រឿងទេស គ្រឿង ឧបភោគ បរិភោគ ទាំងនេះ ជា ការសហការ ឧបត្ថម្ភ របស់ សប្បុរស ជន មួយចំនួន រួម មាន ក្រុមហ៊ុន ទេសចរណ៍ យូណេស ធួរ ក្រុមហ៊ុន សាលី កាត្រេឌីង ក្រុមហ៊ុន ណាសា ខូស មេតិក និង លោកស្រី ម៉ាណ ណាវី អ្នកតំណាងរាស្រ្ត មណ្ឌល ភ្នំពេញ ៕ មន្រ្តី កាំ កុងត្រូល ខេត្ត ព្រះសីហនុ បន្ត ចុះ អង្កេត រក ទំនិញ ខូច គុណភាព ក្លែងបន្លំ ស្លាកសញ្ញា និង សារធាតុ គីមី នៅ ផ្សារ វាល រេញ ស្រុក ព្រៃនប់ តែ រក មិន ឃើញ ទំនិញ ណា មាន សារធាតុ គីមី ឡើយ
( ព្រះសីហនុ) ៖ មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០១៩ នេះ សហការ ជាមួយ មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម គណៈកម្មការ ផ្សារ និង អាជ្ញាធរដែនដី បាន បន្ត ចុះ ផ្សព្វផ្សាយ អំពី គុណភាព សុវត្ថិភាព ម្ហូប អាហារ ត្រួតពិនិត្យ ផលិតផល ម្ហូប អាហារ និង ទំនិញ វេចខ្ចប់ ស្រាប់ នៅ ផ្សារ វាល រេញ ក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
បើ តាម លោក ប៊ុន ចំរើន ប្រធាន កាំ កុងត្រូល ស្តីទី សាខា ខេត្ត ព្រះសីហនុ បាន ឲ្យដឹង ថា គោលបំណង នៃ ការត្រួតពិនិត្យ គឺ ដើម្បី ស្រាវជ្រាវ ទប់ស្កាត់ ការចរាចរណ៍ ទំនិញ ខូច គុណភាព ក្លែងបន្លំ ស្លាក សញ្ញា ផុត កំណត់ កាលបរិច្ឆេទ ប្រើប្រាស់ និង មាន សារធាតុ គីមី ហាមឃាត់ ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ ។
លោក បន្ត ថា នៅក្នុង សកម្មភាព ចុះ ត្រួតពិនិត្យ មន្ត្រី ជំនាញ បាន ដក យក គំរូ ម្ហូប អាហារ មួយចំនួន មក ធ្វើតេស្ត បឋម រួម មាន៖ បង្គារ មឹក ស្រស់ ស្ពៃ ជ្រក់ ជ្រក់ ត្រសក់ ដើម្បី រក សារធាតុ គីមី ហាមឃាត់ ដែល អាច ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ ។ ជាមួយគ្នា នោះ មន្ត្រី ជំនាញ បាន ធ្វើ ការត្រួតពិនិត្យ រក ភាព មិន អនុលោម នៅលើ សំបក វេចខ្ចប់ ផលិតផល ម្ហូប អាហារ ផងដែរ ។
លោក ប្រធាន ស្តីទី បាន ឲ្យដឹង ថា ជា លទ្ធផល មន្ត្រី ជំនាញ របស់ លោក ពុំ បាន រកឃើញ មាន វត្តមាន សារធាតុ គីមី ហាមឃាត់ នៅលើ ផលិតផល ម្ហូប អាហារ ខាងលើ និង ពុំ មាន ការដាក់ តាំង លក់ ទំនិញ ម្ហូប អាហារ វេច ខ្ចប់ ស្រាប់ ខូច គុណភាព ហួស កាលបរិច្ឆេទ នោះ ទេ ។
នៅក្នុង ប្រតិបត្តិការ នេះ លោក នៅ តុន អនុប្រធាន សាខា ក៏ បាន ធ្វើ ការណែនាំ ដល់ អាជីវករ ដទៃ ឲ្យ យល់ដឹង និង អនុវត្ត ទៅតាម ច្បាប់ ស្តីពី ការគ្រប់គ្រង គុណភាព សុវត្ថិភាព លើ ផលិតផល ទំនិញ និង សេវា ចៀសវាង បង្ក ផល ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ នឹង អាច ប្រឈម ចំពោះ មុខ ច្បាប់ ថែម ទៀត ៕
ការអះអាង របស់ កូរ៉េ ខាងជើង កើត មាន ឡើង ក្រោយ អង្គការ សហ ប្រជាជាតិ (UN) បាន ប្រកាស ឲ្យដឹង ថា ប្រជាជន កូរ៉េ ខាងជើង រហូតដល់ ១០លាន នាក់ កំពុង ត្រួវការ ជំនួយ ជា ស្បៀងអាហារ ជាបន្ទាន់ ។ លើស ពី នេះ ទៅ ទៀត បើ តាម UN ប្រជាជន កូរ៉េ ខាងជើង មាន ម្ហូប អាហារ បរិភោគ តែ ៣០០ ក្រាម ប៉ុណ្ណោះ ក្នុង មួយ ថ្ងៃ គិត មក ទល់ នឹង ឆ្នាំ ២០១៩ នេះ ហើយ វា ជា សញ្ញា គ្រោះថ្នាក់ បំផុត ទៅដល់ ជីវិត រស់ នៅ ជាពិសេស កុមារ ៗ ដែល ត្រូវការ អាហារូបត្ថម្ភ ។
គួរ ជម្រាប ថា កូរ៉េ ខាងជើង ក៏ ធ្លាប់ ជួបប្រទះ គ្រោះ អត់ឃ្លាន ដ៏ ធ្ងន់ធ្ងរ បំផុត មួយ ផងដែរ កាលពី អំឡុង ឆ្នាំ ១៩៩០ ដោយ មាន ប្រជាជន រាប់ ពាន់ ត្រូវបាន គេ ជឿជាក់ ថា បាន បាត់បង់ជីវិត ៕
ភ្ញៀវ ទេសចរ ទៅ លេង ខេត្ត ព្រះវិហារ កើនឡើង ៣៤. ៥៥% ធៀប នឹង ឆ្នាំ មុន ក្នុង ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម ព្រះមហាក្សត្រ
( ព្រះវិហារ ) ៖ លោក គង់ វិបុល ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ព្រះវិហារ បាន បញ្ជាក់ ថា ក្នុង រយៈពេល ៣ ថ្ងៃ នៃ ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ខេត្ត ព្រះវិហារ ទទួលបាន ភ្ញៀវ ទេសចរ សរុប ១៩. ១៥៦ នាក់ មាន ការកើនឡើង ៣៤. ៥៥% បើ ធៀប នឹង ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ។
ប្រធាន មន្ទីរ ទេសចរណ៍ រូប នេះ បន្ត ថា ទីតាំង ទេសចរណ៍ ដែល ភ្ញៀវ ទេសចរ តែងតែ ទៅ លេង កំសាន្ត រួម មាន៖ ប្រាសាទ ព្រះវិហារ ស្ថិត ក្នុង ស្រុក ជាំ ក្សាន្ត ប្រាសាទ កោះ កែរ ស្ថិត ក្នុង ស្រុក គូលែន ទឹក ធ្លាក់ ព្រះនិម្មិត ស្ថិត ក្នុង ស្រុក ឆែប ជាដើម ។
ជា ការកត់សម្គាល់ ចំនួន ភ្ញៀវ ទេសចរ តាម រមណីយដ្ឋាន នានា មាន ការកើនឡើង ច្រើន យ៉ាង ដូច្នេះ ដោយសារ ថ្ងៃ ឈប់សម្រាក បូករួម ទាំង ថ្ងៃ សម្រាក ចុង សប្តាហ៍ មាន រយៈពេល ៥ ថ្ងៃ និង ម្យ៉ាងទៀត អាកាសធាតុ មាន លក្ខណៈ អំណោយផល ល្អ ខណៈ បញ្ហា សន្តិសុខ សណ្ដាប់ធ្នាប់ និង ប្រព័ន្ធ ហេដ្ឋាន ចរនា សម្ព័ន្ធ មាន លក្ខណៈ ល្អ ប្រសើរ ផងដែរ ៕ អភិបាល ខេត្ត កំពង់ធំ នឹង បន្ដ ដាក់ពង្រាយ មន្ដ្រី ឃ្លាំមើល នៅ តំបន់ ២ និង តំបន់ ៣ ក្នុង ស្រុក បារាយណ៍ ដើម្បី ទប់ស្កាត់ ការឈូសឆាយ យក ធ្វើជា កម្មសិទ្ធិ ឯកជន
( កំពង់ធំ ) ៖ អភិបាល ខេត្ត កំពង់ធំ លោក សុខ លូ នឹង បន្ដ ដាក់ពង្រាយ មន្ដ្រី ចុះ ទៅ ឃ្លាំមើល ដី នៅ តំបន់ ២ និង តំបន់ ៣ ក្រោម ការគ្រប់គ្រង របស់ ក្រសួង បរិស្ថាន ស្ថិត នៅក្នុង មូលដ្ឋាន ស្រុក បារាយណ៍ ក្រែង មាន ការទន្ទ្រាន កាន់កាប់ យក ធ្វើជា កម្មសិទ្ធិ ឯកជន ។
អភិបាល ខេត្ត កំពង់ធំ ក៏ បាន បញ្ជាក់ ផងដែរ ថា រហូតមកដល់ ពេលនេះ ពុំ មាន សកម្មភាព ចុះ ទៅ ទន្ទ្រាន កាន់កាប់ ដី នៅ តំបន់ ២ និង តំបន់ ៣ទៀត នោះ ឡើយ ហើយ នា ពេល កន្លងទៅ មន្ដ្រី របស់ លោក ក៏ បាន ចាប់ គ្រឿងចក្រ ជាច្រើន គ្រឿង ផងដែរ ដែល ទៅ ភ្ជួរ ឈូសឆាយ រំលោភ ដី នៅ ទីនោះ ប៉ុន្ដែ មិន ថា តែ តំបន់ ទាំង ២នេះ ទេ នៅ បណ្ដា ស្រុក ទាំងអស់ លោក នឹង បញ្ជា ឲ្យ មន្ដ្រី ជំនាញ និង មន្ដ្រី មូលដ្ឋាន បន្ដ យកចិត្តទុកដាក់ តាមដាន ករណី នេះ បន្ដ ទៀត ។
ប្រជាពលរដ្ឋ នៅ ឃុំ ទ្រាល ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ បាន រាយការណ៍ ថា ក្នុង រយៈពេល ថ្មី ៗ នេះ មាន សកម្មភាព ទៅ ទន្ទ្រាន យក ដី ជាង ២០០ ហិចតា នៅ តំបន់ ២ និង តំបន់ ៣ ដែល ដឹកនាំ ដោយ ឈ្មួញ ម្នាក់ ឈ្មោះ អ៊ុក វ៉ុន ។ ប្រជាពលរដ្ឋ រូប នេះ ដែល សុំ មិន បញ្ចេញ ឈ្មោះ បាន បញ្ជាក់ ថា សកម្មភាព ខាងលើ បាន កើត មាន ឡើង តាំងពី មុខ ថ្ងៃ ចូល ឆ្នាំ មក ម្ល៉េះ ប៉ុន្ដែ ក្រោយមក ក៏ មាន មន្ដ្រី បរិស្ថាន និង អាជ្ញាធរ ចុះ ទៅ ហាមឃាត់ ផងដែរ ។
បើ តាម ប្រជាពលរដ្ឋ ការឈូសឆាយ ទន្ទ្រាន យក ដី នៅ តំបន់ នោះ អាចនឹង បន្ដ កើតឡើង ហើយ ការវាទ ទី រំលោភ យក ក៏ កាន់តែ ធំ ឡើង ដែល ឈ្មួញ ទុក លក់ ឲ្យ ប្រជាពលរដ្ឋ ដែល គាត់ អះអាង ថា ចេញ ទៅ ពី ខេត្ត កណ្ដាល ។
មេឃុំ បារាយណ៍ ស្រុក បារាយណ៍ ខេត្ដ កំពង់ធំ លោក ធូ សេង បាន ថ្លែង ថា លោក មិន ទាន់ បាន ទទួល ព័ត៌មាន នៃ ការរំលោភ យក តំបន់ ២ និង តំបន់ ៣នេះ ឡើយ ហើយ លោក ក៏ មិន បាន ក្ដាប់ ឲ្យ លម្អិត ពាក់ព័ន្ធ ទៅនឹង បញ្ហា នេះ ទេ ។
ប្រជាពលរដ្ឋ បាន រាយការណ៍ ថា ឈ្មួញ អ៊ុក វ៉ុន នេះ រស់ នៅ ឃុំ បារាយណ៍ ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ បាន យក គ្រឿងចក្រ ដូចជា ត្រាក់ទ័រ ទៅ ភ្ជួរ និង អេស្កាវ៉ាទ័រ ៤ ទៅ៥ គ្រឿង ទៅកាយ ព្រុំ រំលោភ យក ដី តំបន់ ការពារ ទេសភាព អស់ ជិត ៣០០ ហិកតា តែ ហាក់ គ្មាន អាជ្ញាធរ ថ្នាក់ ណា ហ៊ាន ទៅ ហាមឃាត់ ឡើយ ។
ប្រជាពលរដ្ឋ បាន សំណូមពរ ដល់ ក្រសួង មន្ទីរ ពាក់ព័ន្ធ ជួយ ទប់ស្កាត់ ឈ្មួញ និង មន្ត្រី ខិល ខូច ទាំងនោះ ជាពិសេស សូមឲ្យ មាន វិធានការ ទៅ លើ ជន នេះ ឲ្យបាន ធ្ងន់ធ្ងរ បំផុត កុំ លើកលែង ។
យ៉ាងណា ក៏ដោយ អភិបាល ខេត្ត កំពង់ធំ នឹង ចាត់ វិធានការ ច្បាប់ មិន លើក លើក ឲ្យ ឡើយ សម្រាប់ សកម្មភាព ទន្ទ្រាញ យក ដី របស់ រដ្ឋ ទាំងនេះ ៕ អតីត ប្រធានាធិបតី ប្រេស៊ីល លោក Temer ត្រូវ ដោះលែង ជា លើក ទី ពីរ ចេញ ពី មន្ទីរឃុំឃាំង
នៅ ព្រឹក ថ្ងៃទី ១៤ ខែឧសភា ឆ្នាំ ២០១៩ លោក នាយក រដ្ឋមន្រ្តី នេប៉ាល់ បាន បន្ត ជួប សម្តែង ការគួរសម ជាមួយ សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា ព្រមទាំង បន្ត ចូល ជួប សម្តែង ការគួរសម ជាមួយ សម្តេច សាយ ឈុំ ប្រមុខរដ្ឋ ស្តីទី កម្ពុជា ផងដែរ ។ បន្ទាប់មក លោក នាយក រដ្ឋមន្រ្តី នេប៉ាល់ និង គណៈប្រតិភូ បាន បន្ត អញ្ជើញ ទស្សនា សារមន្ទីរ ជាតិ និង ព្រះវិហារ ព្រះកែវ មរក ត ។
ប្រទេស កម្ពុជា និង នេប៉ាល់ បាន ភ្ជាប់ ទំនាក់ទំនង ជាមួយគ្នា នៅ ឆ្នាំ ១៩៦៤ តែ ត្រូវបាន កាត់ផ្តាច់ ទៅ វិញ នៅ អំឡុង ពេល កម្ពុជា ជួប វិបត្តិ ភ្លើង សង្គ្រាម ។ ប្រទេស ទាំង ពីរ បាន ភ្ជាប់ ទំនាក់ទំនង ឡើងវិញ នៅ ថ្ងៃទី ០៧ ខែកញ្ញា ឆ្នាំ ១៩៩៩ ។
ដ្បិត ថា បាន បង្កើត ទំនាក់ទំនង ជាមួយគ្នា ឡើងវិញ រយៈ ជិត ២០ ឆ្នាំ ទៅ ហើយ ក្តី តែ បច្ចុប្បន្ន ប្រទេស កម្ពុជា មិន ទាន់ មាន ស្ថានទូត ប្រចាំ នៅ នេប៉ាល់ នៅឡើយ ទេ ( មាន វិវេសនដ្ឋាន នៅ ទីក្រុង ញូវ ដេលី ប្រទេស ឥណ្ឌា ) ហើយ នេប៉ាល់ ក៏ មិន មាន ស្ថានទូត ប្រចាំ នៅ កម្ពុជា ផងដែរ ( មាន និវេសនដ្ឋាន នៅ ទីក្រុង បាងកក ប្រទេស ថៃ )
សូម បញ្ជាក់ ថា កាលពី ខែវិច្ឆិកា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ អំឡុង ទស្សនកិច្ច របស់ សម្តេច តេជោ ហ៊ុន សែន ទៅកាន់ ប្រទេស នេប៉ាល់ ភាគី ទាំង ពីរ ក៏ បាន ចុះហត្ថលេខា លើ ឯកសារ ចំនួន ៤ ផងដែរ ក្នុង នោះ មាន ដូច ជា៖
តាមរយៈ ព្រះរាជ សុន្ទរកថា ដ៏ មាន អត្ថន័យ នា ឱកាស នោះ ព្រះមហាក្សត្រ នៃ កម្ពុជា វាយតម្លៃ ខ្ពស់ ប្រកបដោយ ការជឿជាក់ ថា លទ្ធផល ដែល ទទួលបាន ពី វេទិកា អរិយធម៌ អាស៊ី លើក ទី១ នេះ នឹង រួម វិភាគទាន យ៉ាង ធំធេង ប្រកបដោយ ប្រសិទ្ធភាព និង ការជំរុញ ឲ្យ មាន ទំនាក់ទំនង ល្អ រវាង ប្រជាជាតិ នៅ អាស៊ី នាសម័យ បច្ចុប្បន្ន ពូន ជ្រុំ ការយោគយល់ គ្នា ក្នុង តំបន់ កាន់តែ ជ្រាលជ្រៅ និង លើកស្ទួយ កិច្ចសហប្រតិបត្តិការ ក្នុង សន្តិភាព ភាតរភាព និង ស្រឡាញ់ គ្នា កាន់តែ ប្រសើរឡើង ។
ឆ្លៀត ក្នុង ឱកាស ដ៏ មាន តម្លៃ នេះ ព្រះមហាក្សត្រ សូម កោតសរសើរ ប្រធានាធិបតី ដែល បាន ផ្តួចផ្តើម សហគមន៍ វាសនា រួម របស់ មនុស្សជាតិ ដែល ជា ឧត្តម គតិ និង មនសិការ គិតគូរ ដល់ ការកសាង សហគមន៍ វាសនា រួម រវាង បណ្តា ប្រទេស មាន សេដ្ឋកិច្ច ជឿនលឿន តូច ធំ និង សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល ជា អរិយ ប្រទេស មាន វីរភាព ប្រកបដោយ ភាពទន់ភ្លន់ គួរឲ្យ គោរព និង កោតសរសើរ ខ្ពង់ខ្ពស់ ៕
ព្រះមហាក្សត្រ ខ្មែរ កោតសរសើរ ប្រធានាធិបតី ស៊ី ជីន ពីង ដែល បាន ផ្តួចផ្តើម សហគមន៍ វាសនា រួម របស់ មនុស្សជាតិ (Video inside) ( ប៉េកាំង - ចិន ) ៖ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន មាន ព្រះរាជ បន្ទូល កោតសរសើរ ចំពោះ លោក ប្រធានាធិបតី ចិន ស៊ី ជីន ពីង ដែល បាន ផ្តួចផ្តើម សហគមន៍ វាសនា រួម របស់ មនុស្សជាតិ ដែល ជា ឧត្តម គតិ និង មនសិការ គិតគូរ ដល់ ការកសាង សហគមន៍ វាសនា រួម ។
ព្រះអង្គ មាន ព្រះរាជ បន្ទូល យ៉ាង ដូច្នេះ ក្នុង ឱកាស ទ្រង់ យាង ចូលរួម ក្នុង វេទិកា អរិយធម៌ អាស៊ី លើក ទី១ ដែល ផ្តួចផ្តើម បង្កើតឡើង ដោយ លោក ស៊ី ជីន ពីង ប្រធានាធិបតី ចិន នា រដ្ឋធានី ប៉េកាំង វេលា ព្រឹក ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០១៩ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី បណ្តា មេដឹកនាំ នៃ ប្រទស នានា ជាច្រើន ផងដែរ ។
ព្រះមហាក្សត្រ បាន មាន ព្រះរាជ បន្ទូល ថា « ឆ្លៀត ក្នុង ឱកាស ដ៏ មាន តម្លៃ នេះ ខ្ញុំ សូម កោតសរសើរ ឯកឧត្តម ប្រធានាធិបតី ដែល បាន ផ្តួចផ្តើម សហគមន៍ វាសនា រួម របស់ មនុស្សជាតិ ដែល ជា ឧត្តម គតិ និង មនសិការ គិតគូរ ដល់ ការកសាង សហគមន៍ វាសនា រួម រវាង បណ្តា ប្រទេស មាន សេដ្ឋកិច្ច ជឿនលឿន តូច ធំ និង សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល ជា អរិយ ប្រទេស មាន វីរភាព ប្រកបដោយ ភាពទន់ភ្លន់ គួរឱ្យ គោរព និង កោតសរសើរ ខ្ពង់ខ្ពស់ » ។
ព្រះអង្គ មាន ព្រះរាជ បន្ទូល ទៀត ថា « ជាថ្មី ម្តង ទៀត សូម ចូលរួម វាយតម្លៃ ខ្ពស់ ប្រកបដោយ ការជឿជាក់ ថា លទ្ធផល ដែល ទទួលបាន ពី វេទិកា អរិយធម៌ អាស៊ី លើក ទី១ នេះ នឹង រួម វិភាគទាន យ៉ាង ធំធេង ប្រកបដោយ ប្រសិទ្ធភាព និង ការជំរុញ ឱ្យ មាន ទំនាក់ទំនង ល្អ រវាង ប្រជាជាតិ នៅ អាស៊ី នាសម័យ បច្ចុប្បន្ន ពូន ជ្រុំ ការយោគយល់ គ្នា ក្នុង តំបន់ កាន់តែ ជ្រាលជ្រៅ និង លើកស្ទួយ កិច្ចសហប្រតិបត្តិការ ក្នុង សន្តិភាព ភាតរភាព និង ស្រឡាញ់ គ្នា កាន់តែ ប្រសើរឡើង » ។
ក្នុង ឱកាស នោះ ព្រះមហាក្សត្រ ទ្រង់ បាន មាន ព្រះរាជ បន្ទូល ជំរុញ ឲ្យ មាន ការយកចិត្តទុកដាក់ លើ ការពង្រឹង តួនាទី សាសនា និង ការលើកតម្កើង តម្លៃ សីលធម៌ និង ប្រពៃណី ល្អ នៃ ទំនាក់ទំនង និង ប្រវត្តិសាស្ត្រ នៃ ប្រជាជាតិ នៅ អាស៊ី ការថែរក្សា សុខដុម ភាពសង្គម និង សន្តិភាព នៅ អាស៊ី និង នៅលើ សាកលលោក ឱ្យ កាន់តែ រឹងមាំ ឡើង ។
លើស ពី នេះ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ទ្រង់ មាន បន្ទូល ថា វេទិកា ខ្សែក្រវាត់ មួយ និង ផ្លូវ មួយ ដែល ជា គំនិត ផ្តួចផ្តើម របស់ លោក ស៊ី ជិន ពីង ថា ត្រូវបាន ចាប់ផ្តើម ឡើង ដោយ មាន គណៈប្រតិភូ ច្រើន ប្រទេស បាន ចូលរួម ពិតជា សក្ខីកម្ម បង្ហាញ ឱ្យ ឃើញ នូវ សាមគ្គីភាព ជា ភាតរភាព នៃ វាសនា រួមគ្នា ដែល ប្រទេស នីមួយ ៗ ទទួលបាន ផលប្រយោជន៍ ជាច្រើន តាមរយៈ កិច្ចសហប្រតិបត្តិការ ខ្សែក្រវាត់ មួយ និង ផ្លូវ មួយ នេះ ។
សូម ជម្រាប ថា ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន យាង ចាកចេញ ពី កម្ពុជា ទៅដល់ ទីក្រុង ប៉េកាំង ប្រទេស ចិន នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០១៩ ដើម្បី ចូលរួម វេទិកា អរិយធម៌ អាស៊ី លើក ទី១ ដែល រៀបចំ ដោយ ប្រទេស ចិន តប តាម ការយាង របស់ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង ។ ព្រះអង្គ នឹង យាង និវត្តន៍ មក ប្រទេស កម្ពុជា វិញ នៅ រសៀល ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០១៩ ៕
សូម រំលឹក ថា ព្រះមហាក្សត្រ ខ្មែរ បាន យាង ចេញ ពី ប្រទេស កម្ពុជា ទៅ ចូលរួម វេទិកា អរិយធម៌ អាស៊ី លើក ទី១ នៅ រដ្ឋធានី ប៉េកាំង តប តាម ការយាង របស់ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង កាលពី ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ ។
វេទិកា នេះ រៀបចំឡើង ដោយ រួម មាន វេទិកា តូច ៗ ចំនួន ប្រាំមួយ ទៀត ស្តីពី ប្រធានបទ នៃ ការផ្លាស់ប្តូរ អរិយធម៌ អាស៊ី និង ការយល់ដឹង ពី គ្នា ទៅ វិញ ទៅមក ។
ក្នុង ព្រះរាជ សុន្ទរកថា នោះ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី បាន វាយតម្លៃ ខ្ពស់ ប្រកបដោយ ការជឿជាក់ ថា លទ្ធផល ដែល ទទួលបាន ពី វេទិកា អរិយធម៌ អាស៊ី លើក ទី១ នេះ នឹង រួម វិភាគទាន យ៉ាង ធំធេង ប្រកបដោយ ប្រសិទ្ធភាព និង ការជំរុញ ឱ្យ មាន ទំនាក់ទំនង ល្អ រវាង ប្រជាជាតិ នៅ អាស៊ី នាសម័យ បច្ចុប្បន្ន ពូន ជ្រុំ ការយោគយល់ គ្នា ក្នុង តំបន់ កាន់តែ ជ្រាលជ្រៅ និង លើកស្ទួយ កិច្ចសហប្រតិបត្តិការ ក្នុង សន្តិភាព ភាតរភាព និង ស្រឡាញ់ គ្នា កាន់តែ ប្រសើរឡើង ។
ព្រះអង្គ ក៏ បាន កោតសរសើរ លោក ប្រធានាធិបតី ចិន ដែល បាន ផ្តួចផ្តើម បង្កើត សហគមន៍ វាសនា រួម របស់ មនុស្សជាតិ ។ ព្រះអង្គ បាន ចាត់ទុក គំនិត ផ្តួចផ្តើម នេះ ជា ឧត្តម គតិ និង មនសិការ គិតគូរ ដល់ ការកសាង សហគមន៍ វាសនា រួម រវាង បណ្តា ប្រទេស មាន សេដ្ឋកិច្ច ជឿនលឿន តូច ធំ និង សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល ជា អរិយ ប្រទេស មាន វីរភាព ប្រកបដោយ ភាពទន់ភ្លន់ គួរឱ្យ គោរព និង កោតសរសើរ ខ្ពង់ខ្ពស់ ។
ក្នុង ព្រះរាជ សុន្ទរកថា ព្រះអង្គ មាន ព្រះរាជ បន្ទូល ទៀត ថា ឈរ លើ ការផ្តួចផ្តើម ដ៏ សំខាន់ ខាង លើ នេះ វេទិកា ខ្សែក្រវាត់ មួយ និង ផ្លូវ មួយ ត្រូវបាន ចាប់ផ្តើម ឡើង ដោយ មាន គណៈប្រតិភូ ច្រើន ប្រទេស បាន ចូលរួម ពិតជា សក្ខីកម្ម បង្ហាញ ឱ្យ ឃើញ នូវ សាមគ្គីភាព ជា ភាតរភាព នៃ វាសនា រួមគ្នា ដែល ប្រទេស នីមួយ ៗ ទទួលបាន ផលប្រយោជន៍ ជាច្រើន តាមរយៈ កិច្ចសហប្រតិបត្តិការ ខ្សែក្រវាត់ មួយ និង ផ្លូវ មួយ នេះ ។
ក្នុង ឱកាស មាន ព្រះរាជ វត្តមាន នៅក្នុង រដ្ឋធានី ប៉េកាំង ប្រទេស ចិន ក្រៅពី ការយាង ចូលរួម វេទិកា អរិយធម៌ អាស៊ី ព្រះមហាក្សត្រ ខ្មែរ ក៏ បាន យាង ជួប សាវនាការ ទ្វេ ភាគី ជាមួយ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង ផងដែរ ។ ក្នុង ជំនួប សវនាការ នោះ ព្រះមហាក្សត្រ ខ្មែរ បាន មាន ព្រះរាជ បន្ទូល ពិភាក្សា ការងារ ជាច្រើន លើ ការពង្រឹង ពង្រីក ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ នានា ជាមួយ ប្រទេស ចិន ។
ព្រះមហាក្សត្រ បាន មាន ព្រះរាជ បន្ទូល ថា ប្រជាជន កម្ពុជា នឹង ឈរ យ៉ាង រឹងមាំ ជាមួយ ប្រជាជន ចិន នៅ គ្រប់ កាលៈទេសៈ ទាំងអស់ ហើយក៏ បាន បង្ហាញ ទឹក ព្រះទ័យ គាំទ្រ យ៉ាង ពេញ ទំនឹង ចំពោះ គោល នយោបាយ « ផ្លូវ មួយ ខ្សែក្រវាត់ មួយ » ។
លោក ប្រធានាធិបតី ចិន បាន ទូល ថ្វាយ ព្រះអង្គ ថា ប្រទេស ចិន នឹង នៅតែ បន្ត គាំទ្រ យ៉ាង ពេញ ទំហឹង ដល់ ការអភិវឌ្ឍ ប្រទេស កម្ពុជា ស្រប តាម គោល នយោបាយ ជាតិ របស់ ខ្លួន និង បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទស កម្ពុជា ដើម្បី ជំរុញ ភាពជាដៃគូរ យុទ្ធសាស្ត្រ ដ៏ ទូលំទូលាយ រវាង ប្រទេស ចិន និង ប្រទេស កម្ពុជា ឲ្យបាន រីកចម្រើន ឈានដល់ កម្រិត ថ្មី មួយ ។
ក្រៅពី យាង ជួប សវនាការ ជាមួយ ប្រធានាធិបតី . ព្រះមហាក្សត្រ ខ្មែរ ក៏ បាន យាង ជួប សវនាការ ជាមួយ លោក វ៉ាង ឈឺ សាន អនុប្រធានាធិបតី ចិន ។
ក្នុង ជំនួប សវនាការ នោះ លោក វ៉ាង ឈឺ សាន បាន ទូល ថ្វាយ ថា មិត្តភាព រវាង ប្រទេស ចិន និង កម្ពុជា មាន ប្រវត្តិសាស្ត្រ យ៉ាង យូរអង្វែង ហើយ ចំណង មិត្តភាព រវាង ចិន និង ព្រះរាជ វង្សានុវង្ស នៃ ព្រះរាជាណាចក្រ កម្ពុជា ពិតជា មាន តម្លៃ ណាស់ សម្រាប់ ប្រទស ចិន ។
លោក បាន ទូល ថ្វាយ ទៀត ថា ស្ថិត ក្រោម ការដឹកនាំ របស់ មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ទំនាក់ទំនង ចិន - កម្ពុជា ស្ថិត នៅក្នុង ស្ថានភាព ដ៏ ល្អ បំផុត នៅក្នុង ប្រវត្តិសាស្ត្រ ។
អ្វី ដែល ធ្វើឱ្យ មាន ការចាប់អារម្មណ៍ ខ្ពស់ ផងដែរ នោះ ក្នុង ព្រះរាជ ដំណើរ របស់ ព្រះមហាក្សត្រ ខ្មែរ យាង ទៅកាន់ ប្រទេស ចិន នា ពេលនេះ គឺ ចំនឹង ខួប ចម្រើន ព្រះជន្ម របស់ ព្រះអង្គ គម្រប់ ៦៦ ព្រះវស្សា យាង ចូល ៦៧ ព្រះវស្សា ។ ក្នុង ពិធី លាង សាយ ភោជន៍ ជូន គណៈប្រតិភូ ដែល បាន យាង និង អញ្ជើញ ចូលរួម វេទិកា អរិយធម៌ អាស៊ី នា វិមាន ប្រជាជន ចិន លោក ស៊ី ជីន ពីង និង ភរិយា បាន រៀបចំ ព្រះរាជ ពិធី ចម្រើន ព្រះជន្ម ថ្វាយ ព្រះមហាក្សត្រ ខ្មែរ ប្រកបដោយ ភាពរីករាយ និង ស្និទ្ធស្នាល ជា ទីបំផុត ។
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញារីទ្ធ បាន ចាត់ កម្មវិធី នោះ ថា ជា រឿង ភ្ញាក់ផ្អើល មួយ ។ ដោយឡែក ប្រជាពលរដ្ឋ ខ្មែរ ក៏ បាន សម្តែង ការ ជាប់ ចិត្ត និង ភ្ញាក់ផ្អើល ចំពោះ ទឹកចិត្ត ប្រកបដោយ ការគោរព ស្រឡាញ់ និង យកចិត្តទុកដាក់ របស់ ប្រធានាធិបតី ចិន ចំពោះ ព្រះមហាក្សត្រ ខ្មែរ ផងដែរ ៕ សង្គ្រាម សំរាម ! ហ្វីលីពីន កោះហៅ មន្ត្រី ទូត ពី កាណាដា ត្រឡប់ មកវិញ ព្រោះតែ សំរាម ៦៩ កុងតឺ នឺ ...
គួរ បញ្ជាក់ ថា កាណាដា បាន ធា្លប់ អះអាង ថា សំរាម ដែល ត្រូវបាន នាំចេញ ទៅកាន់ ទីក្រុង ម៉ានីល នៅ ចន្លោះ ឆ្នាំ ២០១៣ និង ឆ្នាំ ២០១៤ ធ្វើឡើង ក្រោម រូបភាព ជា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ដោយ មិន បាន ទទួល ការគាំទ្រ ពី រដ្ឋាភិបាល ទីក្រុង Ottawa ឡើយ ។ ប៉ុន្តែ ហ្វីលីពីន បាន ដាក់ពាក្យ ប្ដឹង តវ៉ា ប្រឆាំង នឹង កាណាដា ជា បន្តបន្ទាប់ រហូតដល់ តុលាការ ហ្វីលីពីន សម្រេច បញ្ជូន សំរាម ទាំង នេះ ទៅកាណាដា វិញ កាលពី ឆ្នាំ ២០១៦៕ គិត ត្រឹម ខែឧសភា ឆ្នាំ ២០១៩ រាជធានី ភ្នំពេញ មាន អតីត យុទ្ធជន ជិត ១ម៉ឺន នាក់
( ភ្នំពេញ ) ៖ គិត ត្រឹម ខែឧសភា ឆ្នាំ ២០១៩ នេះ រាជធានី ភ្នំពេញ មាន អតីត យុទ្ធជន កម្ពុជា សរុប ចំនួន ៩. ៣១៨ នាក់ ហើយ ក្នុង នោះ គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ បាន នឹង កំពុង យកចិត្តទុកដាក់ ដូចជា ការផ្តល់ ការសាងសង់ ផ្ទះ ជូន ការផ្តល់ ដី ដែល មាន ស្រាប់ ការជួសជុល ផ្ទះ ការស្នើសុំ ដី នឹង ផ្ទះ ទៅ រស់ តាម បណ្តា ខេត្ត នានា ជាដើម ។
នេះ បើ តាម ការបង្ហាញ ឲ្យដឹង ក្នុង ពិធី អបអរសាទរ ខួប លើក ទី ១២ ទិវា អតីត យុទ្ធជន កម្ពុជា ២១ ខែមិនា ដែល បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០១៩ នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម វត្តមាន លោកស្រី កែវ សុខ ពិសី អភិបាល រង រាជធានី ភ្នំពេញ និង ជា តំណាង របស់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោកស្រី មុំ ចាន់ ដានី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង នីតិសម្បទា រាជធានី ភ្នំពេញ ។
លោកស្រី មុំ ចាន់ ដានី បាន ឲ្យដឹង ថា មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង នីតិសម្បទា រាជធានី ភ្នំពេញ បាន និង កំពុង គ្រប់គ្រង ធ្វើ របប គោល នយោបាយ ដល់ អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ គិត ត្រឹម ខែឧសភា ឆ្នាំ ២០១៩ មាន ចំនួន សរុប ៩. ៣១៨ នាក់ ក្នុង នោះ រួម មាន ជន ពិការ១. ២៦១ នាក់ គ្រួសារ ពលី ១. ២១២ នាក់ គ្រួសារ មរណៈ ៥៨២ នាក់ និវត្ត ជន៣. ៦៨៤ នាក់ ជន បាត់បង់ ពលកម្ម ៦៧ នាក់ បន្ទុក ៩៩១៨ នាក់ កូន២. ៤១៤នាក់ ។
គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ បាន ចងក្រង ជា សមាជិក សមាគម នៅ តាម មូលដ្ឋាន ក្នុង រាជធានី ភ្នំពេញ ចំនួន . ៨៨០៦ នាក់ ។ ក្នុង នោះ រួម មាន៖
ជាក់ស្តែង ពេលនេះ មាន សមាជិក សមាគម អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ ចំនួន ១៥៧ គ្រួសារ ជួប ការលំបាក ត្រូវបាន ការយកចិត្តទុកដាក់ ពី លោក ឃួង ស្រេង ប្រធាន កិត្តិយស មាគម អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ បាន និង កំពុង ដោះស្រាយ ជា ជំហាន ៗ ក្នុង ការផ្តល់ ការសុំ សាងសង់ ផ្ទះ ជូន ដល់ សមាជិក សមាគម លើ ដី ដែល មាន ស្រាប់ ចំនួណ ២៤ ខ្នង ការសុំ ជួសជុល ផ្ទះ ជូន ចំនួន ៣២ ខ្នង និង ការស្នើសុំ ដី និង ផ្ទះ ទៅ រស់ តាម បណ្តា ខេត្ត នានា ចំនួន ១០១ គ្រួសារ ។
លោកស្រី កែវ សុខ ពិសី បាន លើកឡើង ថា ការប្រារឰ ពិធី ខួប លើក ទី ១២ ទិវា អតីត កម្ពុជា ២១ មិថុនា នេះ ធ្វើឡើង ក្នុង គោលបំណង បង្ហាញ ពី ការយកចិត្តទុកដាក់ ដើម្បី រំឭក គុណូបការៈ គុណ ចំពោះ បងប្អូន អតីត យុទ្ធជន ទាំងអស់ ដែល បាន លះបង់ សាច់ ស្រស់ ឈាម ស្រស់ ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ រហូត ធ្វើឲ្យ ប្រទេសជាតិ យើង មាន សុខ សន្តិភាព និង មាន ការអភិវឌ្ឍ រីកចម្រើន រហូតមកដល់ ពេល បច្ចុប្បន្ន ។
លោកស្រី បាន បន្ត ទៀត ថា ក្រោយ ឆ្នាំ ១៩៧៩ បងប្អូន អតីត យុទ្ធជន របស់ យើង ទាំងអស់ មាន អាយុ ត្រឹមតែ ១៥ទៅ ២០ ឆ្នាំ ប៉ុណ្ណោះ តែ មកដល់ ពេលនេះ បាន ចូលនិវត្តន៍ ទៅ ហើយ ខណៈ ដែល ការណោះ បងប្អូន និវត្តន៍ ជន ទាំងអស់ សុទ្ធតែ ធ្វើ ការបំពេញ ការងារ ជូន ជាតិ ដោយ មិន មាន ប្រាក់ខែ ផង នោះ ។
លោកស្រី បាន បន្ត ទៀត ថា ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា ទាំងមូល មាន សុខ សន្តិភាព ពេញ បរិបូរណ៍ ធ្វើឲ្យ កម្ពុជា មាន ឱកាស អភិវឌ្ឍន៍ ប្រទេស រហូត មាន ការអភិវឌ្ឍន៍ រីកចម្រើន រហូតមកដល់ បច្ចុប្បន្ន នេះ ។
ដោយ មើល ឃើញ ពី គុណ តំលៃ ដ៏ មិន អាច កាត់ថ្លៃ ពីសំណាក់ អតីត យុទ្ធជន របស់ យើង សម្ដេច បាន បង្កើត ឲ្យ មាន ជា ទិវា រំលឹក អតីត យុទ្ធជន នេះ ឡើង នៅ ថ្ងៃទី ១២ មិថុនា ជារៀងរាល់ ឆ្នាំ ។ មិន តែ ប៉ុណ្ណោះ សម្ដេច នៅ បាន ផ្ដល់ ជា ដី សម្បទាន ជា ផ្ទះ សំបែង ជា ថវិកា និង ការបណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ជាដើម ថែម ទៀត ។ នេះ ជា ការគូសបញ្ជាក់ បន្ថែម របស់ លោកស្រី មុំ ចាន់ ដានី ។
លោកស្រី បាន បញ្ជាក់ ទៀត ថា ក្នុង នាម លោក ឃួង ស្រេង ប្រធាន កិត្តិយស សមាគម អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ នឹង ពង្រឹង ការយកចិត្តទុកដាក់ លើកកម្ពស់ ជីវភាព អតីត យុទ្ធជន ឲ្យបាន ប្រសើរឡើង ទៅតាម អនុសាសន៍ របស់ សម្ដេច តេជោ ហ៊ុន សែន ៕
ការបង្កើន ការនាំចេញ ថាមពល ( ប្រេង និង ឧស្ម័ន ) គឺជា យុទ្ធសាស្ត្រ មួយ ដ៏ សំខាន់ របស់ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ក្នុង ការកាត់បន្ថយ ឱន ភាព ពាណិជ្ជកម្ម ខណៈ ចិន គឺជា ប្រទេស ដ៏ ធំ មួយ នៅលើ ពិភពលោក សម្រាប់ ទីផ្សារ ថាមពល អាមេរិក ។ ជាក់ស្ដែង កាលពី ឆ្នាំ ២០១៨ ការប្រើប្រាស់ ថាមពល ជាពិសេស ធ្យូងថ្ម របស់ ចិន បាន កើន ដល់ ៤. ៦៤ ពាន់ លាន តោន ឬ កើនឡើង ៧. ៧ដង បើ ធៀប ទៅនឹង ឆ្នាំ ១៩៧៨ ។
ចំណែកឯ ការនាំចូល ប្រេង ឆៅ គឺ មាន រហូតដល់ ៧០ ភាគរយ និង ឧស្ម័ធម្មជាតិ ៤៣ ភាគរយ ឯណោះ ។ ដូច្នេះហើយ ទើប ក្រុម អ្នកជំនាញ យល់ ថា សហរដ្ឋ អាមេរិក គ្មាន ហេតុផល ត្រូវ ប្រងើយ កន្ដើយ ដ្បិត សង្រ្គាម ពាណិជ្ជកម្ម មិន មែន ត្រឹមតែ ធ្វើឱ្យ ចិន ខាតបង់ តែ ឯង នោះ ទេ សូម្បីតែ សហរដ្ឋ អាមេរិក ក៏ ត្រូវ រងគ្រោះ ដែរ ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃ សប្ដាហ៍ មុន ចិន បាន សម្រេចចិត្ត ដំឡើង ពន្ធ លើ ផលិតផល នាំចូល ពី សហរដ្ឋ អាមេរិក មាន តម្លៃ ជាង ៦០ ពាន់ លាន ដុល្លារ ជា ការឆ្លើយតប នឹង ទីក្រុង វ៉ាស៊ីនតោន ដែល បាន ដំឡើង ពន្ធ មាន តម្លៃ ២០០ ពាន់ លាន ដុល្លារ លើ ផលិតផល នាំចូល ពី ចិន ។
តាម របាយការណ៍ ដដែល បាន បញ្ជាក់ ថា សម្រាប់ ឱកាស ឈប់ សម្រាក ចំនួន ៥ ថ្ងៃ កន្លងមក នេះ សម្រាប់ ខេត្ត កំពត មាន ភ្ញៀវ ទេសចរ ជាតិ មាន ចំនួន ៩៩. ៩៨៨ នាក់ និង ភ្ញៀវ អន្តរជាតិ មាន ចំនួន ៤.៤៥៣ នាក់ រីឯ ខេត្ត កែប វិញ មាន ភ្ញៀវ ទេសចរ ជាតិ ចំនួន ៩៦. ១៦៥ នាក់ និង ភ្ញៀវ អន្តរជាតិ មាន ចំនួន ២៤៧៩ នាក់ ។
ជា ការកត់សម្គាល់ ចំនួន ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ មាន ការកើនឡើង ច្រើន យ៉ាង ដូច្នេះ ដោយសារ ថ្ងៃ ឈប់សម្រាក បូករួម ទាំង ថ្ងៃ សម្រាក ចុង សប្តាហ៍ មាន រយៈពេល ៥ ថ្ងៃ និង ម្យ៉ាងទៀត អាកាសធាតុ មាន លក្ខណៈ អំណោយផល ល្អ ខណៈ បញ្ហា សន្តិសុខ សណ្ដាប់ធ្នាប់ និង ប្រព័ន្ធ ហេដ្ឋាន ចរនា សម្ព័ន្ធ មាន លក្ខណៈ ល្អ ប្រសើរ ផងដែរ ៕ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ជិត ១៣ម៉ឺន នាក់ ទៅ កម្សាន្ត តាម រមណីយដ្ឋាន នានា ក្នុង ខេត្ត ព្រះសីហនុ ថ្ងៃ ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម ព្រះមហាក្សត្រ
( ព្រះសីហនុ) ៖ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា រយៈពេល ៥ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១១ ដល់ ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០១៩ មាន ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ចំនួន ១២៦. ០៣០ នាក់ បាន មក ទស្សនា កម្សាន្ត នៅ តាម តំបន់ រមណីយដ្ឋាន នានា ក្នុង ខេត្ត ព្រះសីហនុ ។ នេះ បើ តាម របាយការណ៍ របស់ មន្ទីរ ទេសចរណ៍ ខេត្ត ព្រះសីហនុ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០១៩ នេះ ។
តាម របាយការណ៍ ដដែល បាន បញ្ជាក់ ថា សម្រាប់ ឱកាស ឈប់ សម្រាក ចំនួន ៥ ថ្ងៃ កន្លងមក នេះ ភ្ញៀវ ជាតិ មាន ចំនួន ១១០. ៧៣០ នាក់ និង ភ្ញៀវ អន្តរជាតិ មាន ចំនួន ១៥.៣០០ នាក់ ។
ជា ការកត់សម្គាល់ ចំនួន ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ មាន ការកើនឡើង ច្រើន យ៉ាង ដូច្នេះ ដោយសារ ថ្ងៃ ឈប់សម្រាក បូករួម ទាំង ថ្ងៃ សម្រាក ចុង សប្តាហ៍ មាន រយៈពេល ៥ ថ្ងៃ និង ម្យ៉ាងទៀត អាកាសធាតុ មាន លក្ខណៈ អំណោយផល ល្អ ខណៈ បញ្ហា សន្តិសុខ សណ្ដាប់ធ្នាប់ និង ប្រព័ន្ធ ហេដ្ឋាន ចរនា សម្ព័ន្ធ មាន លក្ខណៈ ល្អ ប្រសើរ ផងដែរ ៕ ខ្នង ផ្ទះ ទី១២០ ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន ត្រូវបាន ប្រគល់ ជូន អតីត យុទ្ធជន ពិការ នៅ ខេត្ត កំពង់ធំ
