រដ្ឋាភិបាល អ៊ីរ៉ាក់ បាន លើកឡើង ថា ការកាត់ទោស ប្រហារជីវិត នឹង ជួយ បង្ក្រាប ឧក្រិដកម្ម បាន តែ អ្នកនាំពាក្យ លេតស៍ គូ បា បាន សារភាព ថា " កិច្ចការ នេះ មិន ងាយស្រួល ធ្វើ ទេ ។ "
ប្រធានាធិបតី អ៊ីរ៉ាក់ ចាលាល តាឡា បានី ជា គំនិត ផ្ទាល់ខ្លួន បាន ប្រឆាំង នឹង ការដាក់ទណ្ឌកម្ម មូលធន ហើយ បាន និយាយ ថា គាត់ នឹង មិន ចុះហត្ថលេខា លើ ការកាត់ទោស ប្រហារជីវិត ឡើយ ទោះបី សម្រាប់ កាត់ទោស ប្រឆាំង នឹង សាដាម ហូសេន ក៏ដោយ ។
ក្រុម សិទ្ធិ មនុស្ស និង អង្គការ សហ ប្រជាជាតិ បាន សង្ឃឹម ថា អ៊ីរ៉ាក់ នឹង ជៀសវាង មិន ប្រើប្រាស់ ទោស ប្រហារជីវិត ប្រឆាំង ពលរដ្ឋ ខ្លួន ឡើយ ហើយ បាន ជំរុញ រដ្ឋាភិបាល នេះ មិន ឲ្យ អនុវត្ត ទោស ប្រហារជីវិត ។
បុរស បី នាក់ ដែល មាន ឈ្មោះ ថា បាយ៉ាន់ អាមេត សេដ អូយ ដេ ដាវូដ សាលម៉ាន និង ដាហា ចាស៊ី ម ហាសាន ត្រូវបាន កាត់ទោស ពី បទ ធ្វើឃាត ប៉ូលីស បី នាក់ ក្នុង ក្រុង គុត ខេត្ត វ៉ាស៊ីត ។
ជា ការឆ្លើយតប សម្លេង ជនភៀសខ្លួន ដែល ជា អង្គការ មិន ស្វែងរក ប្រាក់ ចំណេញ តំណាង ឲ្យ ជនភៀសខ្លួន ស្រប ច្បាប់ និង មាន ជំនាញ បាន និយាយ ថា ពួកគេ ស្វាគមន៍ ការពិត ដែល ថា បណ្ឌិត ហ្គូន សាលេស បាន ទទួលយក ការប្រឆាំង ជា លក្ខណៈ កាយវិការ របស់ យើង ហើយ យើង រីករាយ ដែល ផ្កា ទាំង នេះ នឹង រំលែក ទុក្ខ ដល់ សមាជិក សេវា ដែល រង របួស ។
ឌីលេបាន ប្រកាស ថា គាត់ នឹង ចុះចេញ ពី តំណែង មេដឹកនាំ ជា បណ្តោះអាសន្ន ។
ឌីលេបាន លើកឡើង ជាសាធារណៈ ថា ការចោទប្រកាន់ នេះ គឺជា រឿង បក្សពួក និយម និង ជា រឿង នយោបាយ ។
ការចោទប្រកាន់ នេះ មាន ប្រភព ដើម មកពី មេធាវី ស្រុក របស់ ត្រា វីស ខោន ធី ឈ្មោះ រ៉ូនី អើល ដែល ជា អ្នក ប្រជាធិបតេយ្យ ដែល ធ្លាប់ បាន កាត់ទោស មន្ត្រី ប្រជាធិបតេយ្យ និង សាធារណៈ រដ្ឋ រួមទាំង ព្រឹទ្ធសភា អាមេរិក ឈ្មោះ កៃ បាយ លៃ ហាត់ ជី សុន ។
អ្នកនាំពាក្យ របស់ ឌីលេ ឈ្មោះ ខេវីន មែដិន បាន ហៅ ដីការ នេះ ថា " ជា ការផ្តន្ទាទោស ដែល ធ្វើឡើង ដោយ សមាជិក និយម បក្ស ប្រជាធិបតេយ្យ " ដោយ សំដៅ ដល់ ព្រះរាជអាជ្ញា រ៉ូនី អើល ជា អ្នក ប្រជាធិបតេយ្យ និយម ។
យោង លើ បទបញ្ញាតិ របស់ គណបក្ស សាធារណរដ្ឋ ឌីលេ ត្រូវតែ ចុះ ចេញ ដោយ យោង លើ ដីការ ។
ឌីលេ ត្រូវបាន បដិសេធ ដោយ គណកម្មាធិការ វិមាន ក្រមសីលធម៌ ពីមុន មក ចំនួន បី ដង ហើយ ។
អ្នកវិមាន សាធារណរដ្ឋ បាន លប់ ចោល មុន នេះ បន្តិច នូវ បទបញ្ញាតិ ដែល តម្រូវឲ្យ គាត់ លា ឈប់ ពី តំណែង ដោយ យោង តាម ដីការ ប៉ុន្តែ បាន ដាក់បញ្ចូល ឡើងវិញ ដោយ ខ្លាច មាន ការតវ៉ា ពី អ្នកបោះឆ្នោត ។
គណកម្មាធិការ សកម្មភាព នយោបាយ របស់ ឌីលេ ដែល មាន ឈ្មោះ ថា ប្រជាជន តិចសាស ដើម្បី អ្នក សាធារណរដ្ឋ ភាគ ច្រើន ត្រូវបាន កាត់ទោស ពី បទ ចោទប្រកាន់ ដែល ខ្លួន បាន ទទួល ការបរិច្ចាគ ក្រុមហ៊ុន ដែល ភាគ ច្រើន បាន មកពី វិស័យ ក្រេឌីត កាត សំរាប់ ប្រើប្រាស់ ក្នុង ការបោះឆ្នោត ថ្នាក់ ជាតិ ។
ច្បាប់ តិចសាស ហាម មិន ឲ្យ ប្រើប្រាស់ លុយ ក្រុមហ៊ុន ក្នុង ការបោះឆ្នោត ដោយ គ្រាន់តែ អនុញ្ញាត សំរាប់ ចំណាយ រដ្ឋបាល ប៉ុណ្ណោះ ។
មាន មួយ ករណី ដែល តំណាងរាស្ត្រ ម្នាក់ បាន ប្តូរ គណបក្ស ដើម្បី រក្សា តំណែង ខ្លួន ។
អាល់ចាហ្សើរ៉ា បាន រាយការណ៍ កាលពី ពីរ បី ថ្ងៃ មុន ថា ទាហាន អ៊ីរ៉ាក់ នឹង សម្លាប់ អ្នកកាសែត លុះត្រាតែ រដ្ឋាភិបាល រ៉ូម៉ានី ដក ទ័ព្វ របស់ ខ្លួន ចេញ ពី ប្រទេស នេះ ក្នុង រយៈពេល បួន ថ្ងៃ ។
កាលពី ល្ងាច ថ្ងៃសុក្រ សហការី និង សាច់ញាតិ របស់ អ្នកកាសែត បាន ប្រមូលផ្តុំ មុខ កូត្រូ សេនី ផា លេស ដែល ជា វិមាន របស់ បាក់ សេគូ ដើម្បី អំពាវនាវ ឲ្យ ដោះលែង អ្នកកាសែត ។
នាយក រដ្ឋមន្ត្រី ស្ទេហ្វិន ហា ភើ បាន និយាយ ថា ការអធិដ្ឋាន និង អារម្មណ៍ របស់ តំណាងរាស្ត្រ ទាំងអស់ ស្ថិត នៅ ជាមួយ អ្នក ជា ទីស្រឡាញ់ របស់ស៊ូវ៉ាហ្គៀនៅពេល ដ៏ ក្រៀមក្រំ នេះ ។
ប្រធានាធិបតី លោក ចច ដេប បែល យូ ប៊ូស បាន បញ្ជា ឱ្យ ផ្ទេរ លោក ចូស ប៉ាឌីឡា ដែល ត្រូវបាន ឃុំ ខ្លួន ដោយ ទាហាន អាមេរិក ដែល រង ការចោទប្រកាន់ ថា ជា ភេរវករ អោយ ចេញ ពី គុក ឃុំ ខ្លួន ទាហាន ដើម្បី ប្រឈម នឹង ការកាត់ក្តី ក្នុង តុលាការ ព្រហ្មទណ្ឌ សហព័ន្ធ ។
ដីកា ចោទប្រកាន់ នា ពេល បច្ចុប្បន្ន មិន មានបញ្ចូល នូវ បទឧក្រិដ្ឋ ណាមួយ ទៅ លើ ការចោទប្រកាន់ ទាំងនេះ ទេ ។
ផ្ទុយទៅវិញ លោក ប៉ាឌីឡា ត្រូវបាន ចោទប្រកាន់ ពី បទ ធ្វើដំណើរ ទៅ ក្រៅ ប្រទេស ដើម្បី បណ្តុះបណ្តាល ដល់ " ក្រុម ជីហាត ដ៏ ហឹង្សា " ផ្តល់ សម្ភារៈ ដើម្បី គាំទ្រ ដល់ ភេវ រក រ ដោយ ផ្ញើ ប្រាក់ ទ្រព្យសម្បត្តិ ជា រូប វន្ត និង ជ្រើសរើស សមាជិក ថ្មី សំរាប់ ក្រុម ជីហាត និង ផ្សំ គំនិត ធ្វើឃាត បុគ្គល មួយចំនួន នៅ ក្រៅ ប្រទេស ។
ការកែប្រែ ក្នុង ការឃុំ ខ្លួន បាន ផ្តល់ឱ្យ លោក ប៉ាឌី ឡា នូវ សិទ្ធិ មួយចំនួន ដែល គាត់ ត្រូវបាន គេ បដិសេធ នៅពេល រដ្ឋបាល នេះ បាន កំណត់ ថា គាត់ ជា " យុទ្ធជន ដែល ជា សត្រូវ " រួមបញ្ចូល ទាំង សិទ្ធិ ទាក់ទង ទៅ តុលាការ សហព័ន្ធ និង ត្រូវ ទទួលបាន ការ ការពារ ដោយ មេធាវី ម្នាក់ ។
ច្បាប់ នៃ ការឃុំឃាំង ជនសង្ស័យ ដោយ គ្មាន ការចោទប្រកាន់ នោះ ដែល ស្ថិត ក្រោម ការកំណត់ នេះ ត្រូវបាន តវ៉ា ក្នុង តុលាការ ជំនួស មុខ ឱ្យ លោក ប៉ាឌីឡា និង ក្នុង ខែកញ្ញា គណៈ មេធាវី ទី3 ម្នាក់ នៃ បណ្តាញ តុលាការ ឧទ្ធរណ៍ សហរដ្ឋ អាមេរិក ទី4 បាន គាំទ្រ អំណាច របស់ រដ្ឋាភិបាល ក្នុង ការឃុំ ខ្លួន លោក ប៉ាឌីឡា ។
តុលាការ កំពូល ត្រូវ តំរូវអោយ សំរេច ថា តើ ខ្លួន នឹង ពិនិត្យ ឡើងវិញ នូវ សេចក្តីសម្រេច នោះ នៅ សប្តាហ៍ ក្រោយ ឬ យ៉ាងណា ។
