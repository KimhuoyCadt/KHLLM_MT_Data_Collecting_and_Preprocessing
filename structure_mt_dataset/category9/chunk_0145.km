ចំណី ទាំងនេះ យើង ត្រូវ ដាក់ ក្នុង ស្នូក ចោល ជា ប្រចាំ ឱ្យ មាន់ ស៊ី ហើយ ត្រូវ ឧស្សាហ៍ ផ្តល់ កណ្តៀរ ឱ្យ វា ស៊ី ដែរ ។
នេះ ខ្ញុំ ប្រហែល ចង់ យក ពេល ទំនេរ ឱ្យ បាន ប្រហែល ជាមួយ ខែ គ្រាន់ បាន ដកដង្ហើម បាន ធូរ ខ្លះ ។
អង្គភាព ពាក់ព័ន្ធ នីមួយ ៗ
បើក រថយន្ត លើ ដប ស្រាបៀរ ដាក់ បញ្ឈរ បំបែក ឯតទគ្គកម្ម
ការទំនាក់ទំនង ប្រកបដោយ ប្រសិទ្ធិភាព មាន រឿង ច្រើន ទៀត ដែល ត្រូវ ធ្វើជាមួយនឹង ការស្តាប់ ជៀស ជាង អ្វី ផ្សេង ៗ
បើ ពលិកម្ម កាន់តែ មាន វិសាលភាព ប៉ុណ្ណា សេចក្តីស្នេហា ក៏ មាន លើសលប់ ទៅ តាម នោះ ដែរ ។
ឯ ទូលបង្គំ វិញ បាន ពឹង ដល់ ព្រះយេហូវ៉ា
ក្រុមគ្រួសារ ពួកគាត់ បាន ទៅ ទទួល ទាំង ក្តី រំភើប និង ហូរ ទឹកភ្នែក និយាយ ទាំង អួល ដើម ក ថា ពួកគាត់ ទន្ទឹងរង់ចាំ ថ្ងៃ ដោះលែង នេះ យូរ មកហើយ ។
ដោយ មិន ខ្លាច ញញើត ច្បាប់ ឡើយ ។
ខ្ញុំ គិត ថា ការដោះ ខោ នឹង ធ្វើឱ្យ អាម៉ាស់ ណាស់ សម្រាប់ ជនសង្ស័យ ។
គ្រឿង អេឡិចត្រូនិច ជជុះ គ្រឿងទេស ។
របៀប ចិញ្ចឹម ត្រី អណ្តែង ទទួលបាន ផល ល្អ បំផុត
គ្រូពេទ្យ របស់ អ្នក អាចនឹង ណែនាំ អ្នក អោយ ជ្រើសរើស យក វិធី ផ្សេង ជំនួស ។
ក្មេង នាំ តែ គេ រិះគន់ ទើប ចេះតែ អត់ធ្មត់ ។
បទបញ្ជា តឹងរឹង នេះ មិន ទាន់ មាន កាលបរិច្ឆេទ បញ្ចប់ នៅឡើយ ទេ ។
ដោយ បាន ស្នើ កុំ បំប៉ោង បញ្ហា បែប នេះ ដែល អាច បង្ក ទៅជា ជម្លោះ ក្នុង តំបន់ ។
យើងខ្ញុំ សប្បាយ យ៉ាង ក្រៃលែង ដោយ បាន មកដល់ ទីនេះ ជាមួយ បណ្តា មិត្ត អ្នកឯង ហើយ បាន គយគន់ ទេសភាព ដ៏ ស្រស់បំព្រង ។
នេះ ពី បញ្ហា ខាងលើ ។
ទទួលស្គាល់ នៅលើ ពិភពលោក ប៉ុណ្ណោះ ដែល អាច ទាក់ទាញ វិនិយោគិន សិង្ហបុរី បាន ។
ក្រុមហ៊ុន តិចតួច អាច ធ្វើ ការងារ ប្រភេទ នេះ បាន ។
សម្រាប់ ហេតុផល មួយ នេះ ក្មេងស្រី តូច ៗ
ចូរ បង្កើត ភាព ជឿជាក់ តាមរយៈ ការរក្សា នូវ កិច្ចសន្យា របស់ អ្នក ។
ដោយ ទទួលបាន សារ ជូនពរ ល្អ ៗ
សិក្ខាកាម ត្រូវ បែងចែក ជា ពីរ ក្រុម គឺ ក្រុម ព្រឹក និង ថ្ងៃ រសៀល ។
មុខមាត់ ប៉ុណ្ណឹង ៗ
ពួកគេ រៀបការ រួច បី នាក់ នៅតែ កូនប្រុស ម្នាក់ ប៉ុណ្ណោះ ។
គួរ ណា តែ បាន ចិញ្ចឹម ដោយ ក្តីស្រលាញ់ ទាំង កាយវិការ និង ពាក្យសម្តី ជាពិសេស គឺ ទង្វើ និង ពាក្យសម្តី ដែល ចេញ ពី ឪពុក ម្តាយ របស់ ពួកគេ តែម្តង ។
ដូច្នេះ តើ នឹង មាន អ្វី កើតឡើង នៅពេល គូ សងសឹក ទាំង ពីរ ជួបគ្នា ជម្រះ បញ្ជី ចាស់ កាលពី ៣៧ ឆ្នាំ មុន ?
លោក វេជ្ជបណ្ឌិត សុក សារឿន បាន វិលត្រឡប់មក ប្រទេស កម្ពុជា វិញ នឹង បាន ចូលរួម ក្នុង កម្មវិធី គំរោង
បងប្អូន ដឹក ដៃ គ្នា មក ប៉ុស្តិ៍ សុំ ឱ្យ ជួយ ជាបន្ទាន់ …
តើ ម៉ាស៊ីន នេះ ដំណើរការ យ៉ាងដូចម្តេច ?
ក្រែម នេះ សម្រាប់ ប្រើ នៅ ពេល ថ្ងៃ ។
ពេល ធ្លាក់ ព្រិល មិន ប្រាកដ ថា ត្រជាក់ ខ្លាំង ទេ ។
ឡើយ ទាក់ទិន នឹង ករណី នេះ ។
ក្នុង ចំណោម អ្នកជំងឺ ទាំង ៤៤ នាក់ រួម មាន ៖
បំពង់ អ៊ិនធឺរ ៧១៨ កាលី ប
ប្រតិបត្តិការ នេះ ដឹកនាំ ដោយ លោក ប៉ាង លីដា អភិបាល រង ខណ្ឌ ទួលគោក ។
ហើយ ឥឡូវ ស្រមោល ខ្មៅ នោះ បាន រសាត់ បាត់ ពី ជីវិត ខ្ញុំ ហើយ ។
មិន គួរ ទទួលទាន អាហារ ៤ប្រភេទ នៅ ពេលព្រឹក
ចង់ និយាយ រៀបរាប់ប្រាប់ ។
ស៊ិន ឧត្តម ផល្លា បំពេញ បំណង រៀមច្បង - តារា ញូស៍
ខ្ញុំ មិន បាន ដឹង ឈ្មោះ អ្នកនិពន្ធ សៀវភៅ នេះ ទេ ។
១ - កិត្តិគុណ នឹង ការងារ ជា ថ្វី ដៃ របស់ លោកគ្រូ ព្រះសព ព្រះឧត្តម មុនី អ៊ុម ស៊ូរ៣
គាត់ អាច ស្តាប់ ខ្ញុំ បាន
ទោះជា ខាង គ្រួសារ សព អង្វរក ចាំ ធ្វើ បុណ្យ រួចរាល់ សិន ចាំ រើ អីវ៉ាន់ ចេញ ក៏ ម្ចាស់ ផ្ទះ មិន ព្រម ដាច់ខាត ។
ប៉ុន្តែ ពួកគេ និយាយ ថា ពួកគេ មិន មែន មក ហែ ព្រោះតែ ប្រាក់ នោះ ទេ ។
ដោយសារ បែប នេះ ទើប ឃុំ ប៉ុណ្ណា ដែត បណ្តោយ ប្រពន្ធ ប្រឡូក ក្នុង វិស័យ សិល្បៈ ទៀត
ខ្ញុំ គិត ថា ភារកិច្ច នេះ គឺ ធំ ធេង ណាស់ សម្រាប់ យុវជន កម្ពុជា ដើម្បី លើកកម្ពស់ ការយល់ដឹង អំពី វប៌្បធម អត្តសញ្ញាណ ជាតិ ។
ខ្ញុំ មិន ទាន់ បាន និយាយ បញ្ចប់ ផង ស្រាប់តែ យុវជន នោះ ឆ្លើយ ផូង ៖
ក្នុង នោះ មាន ទាំង គ្រួសារ ខ្ញុំ ក៏ បាន រុញ ឡាន សន្សឹម ៗ
ទូលបង្គំ ថ្ងូរ ជារៀងរាល់ ថ្ងៃ
ម្យ៉ាងទៀត អ្នក នឹង មាន រឿង ល្អ ៗ
ហេតុ អ្វី បានជា អាមេរិក ខ្វល់ខ្វាយ ខ្លាំង ម្ល៉ោះពី ជម្លោះ រវាង ជប៉ុន និង កូរ៉េ ខាងត្បូង ?
នៅពេល បរិយាកាស រាង ស្ងប់ បន្តិច វិញ នោះ លោក ក៏ បាន សម្រេចចិត្ត ថត ឆ្មា ទឹក នេះ ចោល មួយ ប៉ុស្តិ៍ ទៀត មុននឹង គាត់ ចាកចេញ ទៅ វិញ ។
គួរ រម្លឹក ដែរ ថា នេះ មិន មែន ជា លើក ទី មួយ ដែល មាន យន្តហោះ ត្រូវបាន ទុកចោល នៅ ព្រលានយន្តហោះ កូឡាឡាំពួរ ។
គេ នាំគ្នា បង្កាត់ ភ្លើង ឱ្យ បានជា ភ្នក់១ តូច ហើយ ម្នាក់ ដែល ជា មេ មាន់ បញ្ជា ឱ្យ កូន របស់ ខ្លួន តោង ចង្កេះត ៗ
ម្រេច កំពត អាចនឹង មាន ទីផ្សារ ថ្មី បន្ថែម ទៀត នៅ ប្រទេស ស្វ៊ីស
ពលរដ្ឋ ចិន ជាង ១ ពាន់ នាក់ ស្លាប់ ដោយសារ ជំងឺ ឆ្លង រាតត្បាត
ហេតុ អ្វី បានជា មាន មនុស្ស កាន់តែ ច្រើន ឡើង ៗ
នៅ ចំណុច កណ្តាល រវាង ចិញ្ចើម ដែល អាច ជួយ កាត់បន្ថយ ការចុក រោយ នៃ ភ្នែក ។
ព្រោះថា ស្ត្រី ជា ឆ្អឹង ខ្នង នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម ។
ការចូលរួម ក្នុង ក្រុម ជំនុំ អនុញ្ញាតឱ្យ លោក អ្នក អាច បំពេញ ចំណុច ទាំងនោះ បាន ។
លោក និយាយ បន្ថែម ទៀត ថា អ្នក ដឹង ទេ ខ្ញុំ ចង់ឱ្យ ពួកគេ ក្លាយជា ឧក្រិដ្ឋ ជន ហើយនិង បញ្ចប់ បញ្ហា របស់ ប្រទេស ខ្ញុំ ហើយនិង ជួយសង្គ្រោះ មនុស្ស ជាន់ ក្រោយ ចេញ ពី ការបំផ្លិចបំផ្លាញ នេះ ។
ប្រសិនបើ មាន អ្នក ពុល អាច បញ្ជូន មក មណ្ឌល សុខភាព បង្អែក ដែល នៅជិត បំផុត សម្រាប់ ព្យាបាល ។
ប្រភេទ បាន បោះពុម្ព
យ៉ាងណា ក៏ដោយ ប្រសិនបើ សវនាការ កាត់ទោស ទៅ លើ ពួក នាង ពិតជា ត្រូវ ធ្វើ ដោយ ជៀស មិន ផុត នោះ លោក បាន សម្រេច ថា លោក នឹង មិន ទៅ ធ្វើជា សាក្សី ដើម្បី ចោទប្រកាន់ ពួក នាង ឡើយ ៕
ដំបូង បំផុត ក្នុង ពិភពលោក !
ពួកគាត់ នេះ ឆ្លង ទៅ ធ្វើការ ក្នុង មួយ ថ្ងៃ ៗ
