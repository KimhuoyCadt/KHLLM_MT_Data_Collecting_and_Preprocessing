ខ្ញុំ ចង់ ជួប ជាមួយ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ជាង ក្រុម វិនិយោគិន បុគ្គល ។
ក្រុម វិនិយោគិន បុគ្គល មាន សារៈសំខាន់ ប៉ុន្តែ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ អាច ជួយ ជំរុញ ការ ជួញដូរ ឧបករណ៍ និស្សន្ទ ។
ការ ជួញដូរ ឧបករណ៍ និស្សន្ទ មិន មាន ន័យ ថា មនុស្ស គ្រប់ គ្នា វា ល្អ សម្រាប់ អ្នក នោះ ទេ ។
ប៉ុន្តែ ខ្ញុំ ផ្ដោត លើ របៀប ជួយ ប្រជាជន រក ប្រាក់ បាន ច្រើន ។
ហានិភ័យ ពិត មិន អាច ប្រកែក បាន ក្នុង ការ ជួញដូរ ការ វិនិយោគ ទាំងអស់ ។
តើ ក្រុម វិនិយោគិន អាច ពិនិត្យ លើ ការ ប្រែប្រួល តម្លៃ ដូរ ឧបករណ៍ និស្សន្ទ ដិត ដល់ ដូចម្ដេច ?
យើង ព្យាយាម នាំ យក បរិយាកាស ជួញដូរ សម ហេតុ ផល ស្មើភាព និង តម្លាភាព ។
យើង ដឹង ថា នៅ តែ មាន ក្រុមហ៊ុន ដែល មិន ត្រូវ បាន គ្រប់គ្រង នៅ ទី នេះ ហើយ ក្រុមហ៊ុន ទាំង នេះ មាន អតិថិជន ច្រើន ប៉ុន្តែ តើ ក្រុមហ៊ុន ទាំង នេះ បញ្ជាក់ ថា តម្លៃ របស់ ពួកគេ ត្រឹម ត្រូវ ដូចម្ដេច ?
អ្នក មិន ដឹង ទេ នៅ ពេល ក្រុមហ៊ុន ទាំង នេះ កំណត់ តម្លៃ ដើម្បី ទទួល បាន កម្រៃ ជើង សារ ។
វា តែងតែ មាន គុណសម្បត្តិ និង គុណវិបត្តិ នៅ ពេល អ្នក កំពុង ធ្វើ អ្វី ៗ ដែល បង្ក បញ្ហា ។
តើ អ្វី ជា សក្ដានុពល សម្រាប់ ទីផ្សារ កម្ពុជា និង នៅ ក្នុង វិសាលភាព ក្នុង តំបន់ ដែល កម្ពុជា ត្រូវ ឈរ ជើង ទាក់ទង នឹង ការ ប្រើប្រាស់ ឧបករណ៍ ហិរញ្ញវត្ថុ នេះ ?
សក្ដានុពល សម្រាប់ កម្ពុជា គឺ ធំ ដូច្នេះ ហើយ ទើប យើង នៅ ទី នេះ ។
កម្ពុជា គឺជា ប្រទេស មាន ស្ថិរភាព នយោបាយ ។
ប្រជាជន កំពុង មាន ជីវភាព ធូរធារ ហើយ ប្រាក់ អាច ហូរ ចូល និង ចេញ ពី ប្រទេស នេះ កាន់ តែ ងាយ ស្រួល បើ ធៀប នឹង កន្លែង ជាច្រើន ដូចជា ប្រទេស វៀតណាម ។
ឧទាហរណ៍ នៅ ប្រទេស វៀតណាម ការ យក ប្រាក់ ចំណេញ របស់ យើង ត្រឡប់ ទៅ ទីក្រុង ហុងកុង តែងតែ ពិបាក សម្រាប់ ពួកយើង ។
ដូច្នេះ លំហូរ សាច់ ប្រាក់ ចេញ ចូល ដោយ សេរី និង បរិយាកាស អាជីវកម្ម ល្អ នឹង ជួយ ពួកយើង ប្រតិបត្តិការ បាន នៅ ក្នុង ប្រទេស នេះ ។
សម្រាប់ វិសាលភាព ក្នុង តំបន់ វា ក៏ ធំ ផង ដែរ ដោយសារ តែ ប្រសិន បើ នរណា ម្នាក់ មកពី វៀតណាម នាំ យក សាច់ ប្រាក់ និង បើក គណនី មួយ ពួកគេ អាច មាន លទ្ធភាព ចូល ដល់ ទីផ្សារ អ ន្តរជាតិ បាន ។
វៀតណាម មិន បាន គ្រប់គ្រង លើ ការ ជួញដូរ ឧបករណ៍ និស្សន្ទ ទេ នៅ ពេល នេះ ប៉ុន្តែ ពួកគេ ធ្លាប់ បាន ជួញដូរ រហូត ដល់ ឆ្នាំ ២០០៩ ទើប បាន បិទ វា ។
បញ្ហា ផ្សេង ទៀត គឺ ថា ទំនាក់ ទំនង សម្រាប់ ប្រទេស ចិន និង កម្ពុជា បាន កើនឡើង ។
ហើយ នេះ ផ្ដល់ ឱកាស កាន់តែ ធំ ដល់ ពួកយើង ។
តើ ស្ថិរភាព ពិភពលោក និង កត្តា ស្ថានភាព សេដ្ឋកិច្ច ក្នុង ការ ជួញដូរ ឧបករណ៍ និស្សន្ទ នេះ ដូចម្ដេច ?
សម្រាប់ ខ្ញុំ បរិយាកាស នយោបាយ អស្ថិរភាព អាច ជា មធ្យោ បាយ មួយ ដើម្បី រក ប្រាក់ ចំណេញ ។
ការ ជួញដូរ ឧបករណ៍ និស្សន្ទ គឺជា ឧបករណ៍ ដែល គួរ ឲ្យ ចាប់ អារម្មណ៍ ខ្លាំង ដោយសារ តែ វា ពឹង លើ ទំនុក ចិត្ត របស់ ក្រុម វិនិយោគិន ដែល គ្មាន ស្ថិរភាព ដូចម្ដេច ដែល ធ្វើ ឲ្យ ពួកគេ ផ្លាស់ ប្តូរ យុទ្ធសាស្ដ្រ វិនិយោគ របស់ ពួកគេ ។
នៅ ទីផ្សារ របស់ យើង ប្រសិន បើ អ្នក មើល ឃើញ តម្លៃ រូបិយប័ណ្ណ កើនឡើង ឬ ធ្លាក់ ចុះ វា តែង តែ ធៀប នឹង តម្លៃ ប្រាក់ ដុល្លារ អាមេរិក ។
ប៉ុន្តែ យើង ក៏ មាន រូបិយប័ណ្ណ ច្រើន ប្រភេទ ផង ដែរ ។
ប៉ុន្តែ ឧបករណ៍ ដែល ពេញ និយម បំផុត គឺ ប្រាក់ ដុល្លារ អាមេរិក ។
ដូច្នេះ ប្រសិន បើ អ្នក គិត ថា អ្វី មួយ មិន មាន ស្ថិរភាព ចូរ ទិញ ប្រាក់ ដុល្លារ ទៅ ។
ប៉ុន្តែ រូបិយប័ណ្ណ យន់ កំពុង ចាប់ផ្ដើម ទទួល បាន ភាព ពេញនិយម នៅ ទី នេះ និង ផ្ដល់ ជម្រើស ផង ដែរ ដែល ជា ផលិតផល ដែល យើង ផ្ដល់ ។
ប្រទេស ទាំង ពីរ ចិន និង កម្ពុជា អាច ធ្វើ ការងារ ជាមួយ គ្នា លើ បញ្ហា នេះ ។
តើ បញ្ញត្តិ ទីផ្សារ គ្រប់គ្រាន់ នឹង ផ្ដល់ ភាព ច្បាស់លាស់ ដល់ ទីផ្សារ នេះ ដូចម្ដេច ?
ទីផ្សារ ដែល មាន ការ គ្រប់គ្រង ស្មើភាព នឹង នាំ ឲ្យ មាន តម្លាភាព ។
តុល្យភាព រវាង ទីផ្សារ រឹងមាំ និង ការ គ្រប់គ្រង គឺជា សិល្បៈ មួយ ។
ជាមួយ បញ្ហា ដែល លើក ឡើង នេះ ប្រតិបត្តិករ ដែល នៅ លើ បណ្ដាញ នេះ ចាំបាច់ ត្រូវ បញ្ឈប់ ។
ឧទាហរណ៍ ក្នុង ក្រុមហ៊ុន របស់ ខ្ញុំ ប្រសិន បើ ការ ជួញដូរ ណា មួយ សម្រាប់ អតិថិជន ម្នាក់ ដោយ គ្មាន ការ អនុញ្ញាត ឬ ការ ធានា ប្រាក់ ចំណេញ ពួកគេ ចេញ ពី ទី នេះ ។
ប៉ុន្តែ យើង អាច ជួយ ពួកគេ បង្កើត ការ បញ្ឈប់ ការ ខាតបង់ និង បញ្ឈប់ វិធានការ ប្រាក់ ចំណេញ ប៉ុន្តែ នោះ គឺ អាស្រ័យ លើ ការ ផ្លាស់ប្តូរ របស់ អតិថិជន ។
យើង នឹង ត្រួតពិនិត្យ ទីផ្សារ នេះ និង ផ្ដល់ ជម្រើស ដល់ ពួកគេ នៅ ពេល ណា ទិញ និង លក់ ។
ប៉ុន្តែ យើង នឹង មិន ដែល ធានា ប្រាក់ ចំណេញ នោះ ទេ ។
ខ្ញុំ ហ្មត់ ចត់ ខ្លាំង ណាស់ ចំពោះ បញ្ហា នោះ ។
យើង រីករាយ ដែល ការ ជួញដូរ កំពុង កើត ឡើង ហើយ អតិថិជន បាន ផ្ដល់ ប្រតិកម្ម ត ប វិជ្ជមាន ដល់ ពួកយើង ស្ដីពី ការ អនុវត្ត តម្លៃ និង សេវា បម្រើ អតិថិជន ៕
អាជ្ញាធរវៀតណាម ប្រកាសដាក់ដេញថ្លៃលក់ខ្មោចយន្តហោះរបស់កម្ពុជា
ប្រសិន បើ បន្ទាប់ ពី ការ អនុវត្ត ច្បាប់ ក្រុមហ៊ុន អាកាសចរណ៍ នៅ តែ ជំពាក់ អាជ្ញាធរ វៀតណាម វា មិន មែន សម្រាប់ យើង ក្នុង ការ បង់ ប្រាក់ តំណាង ឲ្យ ក្រុមហ៊ុន នេះ ទេ » ។
លោក បន្ត ថា លោក មិន បាន ដឹង ថា នរណា គ្រប់គ្រង លើ ក្រុមហ៊ុន អាកាសចរណ៍ រ៉ូយ៉ាល់ ខ្មែរ អ៊ែរ ឡាញ នេះ ប៉ុន្តែ ករណី ម្ចាស់ យន្តហោះ ដែល បោះបង់ ចោល នៅ ព្រលាន យន្តហោះ បរទេស គឺជា រឿង ធម្មតា ។
ក្រសួង ដឹក ជញ្ជូន វៀតណាម បាន ស្នើ ឲ្យ ក្រុមហ៊ុន ព្រលាន យន្តហោះ របស់ វៀតណាម លក់ « ខ្មោច យន្តហោះ នេះ ចោល » ។
នេះ បើ តាម ប្រព័ន្ធ ព័ត៌មាន របស់ វៀតណាម ។
