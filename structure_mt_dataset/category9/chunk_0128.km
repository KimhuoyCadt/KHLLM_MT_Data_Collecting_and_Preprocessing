ប្រទេស ក្រីក្រ មួយ នេះ ទទួល បាន អត្រា កំណើន សេដ្ឋកិច្ច ជា មធ្យម ខ្ពស់ ជាង ៨ ភាគរយ ក្នុង រយៈពេល ៥ ឆ្នាំ ចុង ក្រោយ នេះ ។
យ៉ាង នេះ ក្តី ទោះ ជា របាយការណ៍ របស់ ធនាគារ ពិភពលោក បាន បញ្ជាក់ ពី កំណើន សេដ្ឋកិច្ច ខ្ពស់ ជាង ការ រំពឹង ទុក នៅ ប្រទេស ថៃ ក្នុង អំឡុង ឆមាស ទី មួយ ឆ្នាំ ២០១៦ ក្តី ក៏ ធនាគារ នេះ ឲ្យ ដឹង ថា ការ ស្ទុះ ងើប ឡើង វិញ នៃ សេដ្ឋកិច្ច ដែល មាន មូលដ្ឋាន ទូលំ ទូលាយ និង ទ្រទ្រង់ ខ្លួន ឯង បាន នៅ មិន ទាន់ ចាប់ ផ្តើម មាន ប្រសិទ្ធភាព នោះ ទេ ។
សេដ្ឋកិច្ច របស់ ប្រទេស ថៃ បាន ប្រឈម នឹង អស្ថិរភាព នយោបាយ អស់ រយៈពេល ជាច្រើន ឆ្នាំ គិត ចាប់ តាំង ពី យោធា បាន ដណ្តើម អំណាច កាលពី ឆ្នាំ ២០១៤ មក ៕
វៀតណាម - អ៊ីរ៉ង់ប្តេជ្ញាបង្កើនពាណិជ្ជកម្មដល់$២ពាន់លាន
ប្រធានាធិបតី អ៊ីរ៉ង់ រូប នេះ បាន ប្រាប់ ក្រុម អ្នក យក ព័ត៌មាន នៅ ទីក្រុង ហាណូយ ថា៖
កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ដ៏ សំខាន់ ដែល បាន សម្រេច កាលពី ខែ កក្កដា ឆ្នាំ ២០១៥ និង បាន ចូល ជា ធរ មាន នៅ ខែ មករា បាន ឃើញ ពី ទណ្ឌកម្ម ប្រឆាំង នឹង ប្រទេស អ៊ីរ៉ង់ ត្រូវ បាន លុប ចោល ជា ថ្នូរ នឹង ការ កាត់ បន្ថយ កម្មវិធី នុយក្លេអ៊ែរ របស់ រដ្ឋាភិបាល ក្រុង តេ អេរ៉ង់ ដោយ បាន បើក ចំហ ទីផ្សារ មួយ ក្នុង ចំណោម ទីផ្សារ ដែល មិន ទាន់ បាន ទាញ យក ផលប្រយោជន៍ ចុងក្រោយ របស់ ពិភពលោក សម្រាប់ ពាណិជ្ជកម្ម ពិភពលោក ។
ក្រុម អ្នក វិភាគ ឲ្យ ដឹង ថា រដ្ឋាភិបាល ហាណូយ និង តេ អេរ៉ង់ ដែល សុទ្ធ តែ មាន ទំនាក់ ទំនង មិន សូវ ល្អ ជាមួយ រដ្ឋ អាមេរិក នា ពេល កន្លង មក មាន បំណង លើក កម្ពស់ សម្ព័ន្ធ មិត្ត ឲ្យ លើ ស ពី សកម្មភាព ការទូត ប្រចាំ តំបន់ ៕
បន្ទុកបំណុលច្រើនប៉ះពាល់ដល់សេដ្ឋកិច្ចសកល
ធនាគារ ដោះស្រាយ វិបត្តិ មួយ នេះ បាន បន្ត ឲ្យ ដឹង ថា ជាពិសេស ភាព ទន់ ខ្សោយ របស់ ធនាគារ នៅ តំបន់ អឺរ៉ុប នឹង រីក ឡើង កាន់តែ ធំ ក្លាយ ជា កត្តា គំរាម កំហែង មួយ ចំពោះ ប្រព័ន្ធ ហិរញ្ញវត្ថុ ពិភពលោក ដោយ មាន អនុបាត ប្រាក់ ចំណេញ ទាប និង ចំនួន បំណុល ខូច ច្រើន ប្រកប ដោយ គ្រោះថ្នាក់ ។
មូលនិធិ IMF បាន ឲ្យ ដឹង ក្នុង ការ វាយ តម្លៃ ហានិភ័យ ហិរញ្ញវត្ថុ និង សារពើពន្ធ ពិភពលោក ថា កម្រិត បំណុល រដ្ឋាភិបាល និង ក្រុមហ៊ុន ដ៏ ច្រើន បំផុត មិន ធ្លាប់ មាន នេះ នឹង ធ្វើ ឲ្យ ធនាគារ មួយ ចំនួន មាន ការ លំបាក កាន់តែ ខ្លាំង ដើម្បី ជម្រះ បញ្ជី តារាង តុល្យការ របស់ ខ្លួន និង ជំរុញ កំណើន សេដ្ឋកិច្ច ។
ធនាគារ និង សេវា ធានា រ៉ាប់រង ខ្សោយ មូលនិធិ IMF បាន បន្ត ថា មាន ស្ថានភាព ទន់ ខ្សោយ ដែល បាន រីក រាលដាល នៅ តាម ធនាគារ មួយ ចំនួន មូលនិធិ សោធន និង ក្រុមហ៊ុន ធានារ៉ាប់រង ដែល ជា លទ្ធផល នៃ កំណើន សេដ្ឋកិច្ច ទាប អស់ រយៈពេល ជាច្រើន ឆ្នាំ និង អត្រា ការប្រាក់ ទាប បំផុត ដែល បាន កាត់ បន្ថយ អនុបាត ប្រាក់ ចំណេញ របស់ ក្រុមហ៊ុន ទាំង នោះ ។
មូលនិធិ នេះ បាន ឲ្យ ដឹង ទៀត ថា រដ្ឋាភិបាល ចាំបាច់ ត្រូវ ជំរុញ កំណើន សេដ្ឋកិច្ច និង ជួយ បោស សម្អាត វិស័យ ហិរញ្ញវត្ថុ ដោយ មិន បង្កើន ច្រើន ហួស ហេតុ នូវ បំណុល របស់ ខ្លួន ផ្ទាល់ បន្ថែម ទៀត ។
ទោះ ជា យ៉ាង នេះ ក្តី នៅ តាម ប្រទេស អភិវឌ្ឍន៍ ធនាគារ ចំនួន ២៥ ភាគរយ ដែល កាន់ កាប់ ទ្រព្យ សម្បត្តិ ១១,៧ ពាន់ ពាន់ លាន ដុល្លារ នឹង នៅ តែ មាន ស្ថានភាព ទន់ ខ្សោយ ទោះ បី ជា ស្ថិត ក្នុង ស្ថានភាព ស្ទុះ ងើប ឡើង វិញ នៃ សេដ្ឋកិច្ច ក៏ដោយ ។
លទ្ធភាព សង បំណុល របស់ ក្រុមហ៊ុន ធានា រ៉ាប់រង ជីវិត និង មូលនិធិ សោធន ត្រូវ បាន គំរាម កំហែង ដោយ អត្រា ការប្រាក់ ទាប ដែល បាន អូសបន្លាយ ពេល យូរ ។
ដោយ ព្យាករ ពី វិបត្តិ របស់ ឧស្សាហកម្ម ធនាគារ នៅ តាម តំបន់ មួយ ចំនួន មូលនិធិ នេះ ឲ្យ ដឹង ថា ធនាគារ មួយ ចំនួន ចាំបាច់ ត្រូវ លុប បំបាត់ ឥណទាន ដែល មាន បញ្ហា ជា បន្ទាន់ និង ធ្វើ បច្ចុប្បន្នភាព គំរូ អាជីវកម្ម ។
មូលនិធិ IMF បាន ឲ្យ ដឹង ក្នុង របាយការណ៍ ពិនិត្យ តាមដាន សារពើពន្ធ របស់ ខ្លួន ថា បំណុល សាធារណៈ និង ឯកជន ដោយ មិន រាប់ បញ្ចូល បំណុល របស់ វិស័យ ហិរញ្ញវត្ថុ កាល ពី ចុង ឆ្នាំ មុន បាន កើនឡើង ដល់ ១៥២ ពាន់ ពាន់ លាន ដុល្លារ ដោយ បំណុល ប្រមាណ ២ ភាគ ៣ ជា បំណុល វិស័យ ឯកជន ។
សេចក្តី ប្រកាស ដោយ លោក អូន ព័ន្ធ មុនីរ័ត្ន រដ្ឋមន្ដ្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ធ្វើ ឡើង ខណៈ ADB រៀបចំ ការ ពិភាក្សា កម្រិត ខ្ពស់ ពី ថ្ងៃ ម្សិលមិញ ដោយ បង្ហាញ ពី ប្រតិបត្តិការ របស់ ខ្លួន រយៈពេល ២៥ ឆ្នាំ នៅ កម្ពុជា និង រយៈពេល ៥០ ឆ្នាំ ចាប់ តាំងពី ធនាគារ នេះ ត្រូវ បាន បង្កើត ឡើង ជា លើក ដំបូង ។
ប៉ុន្តែ លោក ព្រមាន ថា ការ ផ្ដល់ កម្ចី នៅ ពេល អនាគត ត្រូវការ បង្កើន ការ ត្រួតពិនិត្យ និង ការ វាយតម្លៃ ដូច្នេះ រដ្ឋាភិបាល អាច រៀនសូត្រ ពី ជោគជ័យ និង បរាជ័យ កន្លង មក នៅ ពេល និយាយ អំពី ការ ផ្ដល់ មូលនិធិ ។
លោក ចាន់ សុផល នាយក មជ្ឈមណ្ឌល សិក្សា គោល នយោបាយ ជឿជាក់ ថា ADB អាច ផ្ដល់ កម្ចី បន្ថែម ទៀត ដល់ កម្ពុជា បើ ប្រទេស នេះ ប្រើប្រាស់ កម្ចី ឲ្យ មាន ប្រសិទ្ធភាព និង ចំ ពេល វេលា ។
លោក អ៊ឹម វត្ថា អ្នក នាំ ពាក្យ និង ជា សមាជិក TRC បាន ឲ្យ ដឹង ថា បន្ទាប់ ពី កិច្ចប្រជុំ ជាមួយ ប្រតិបត្តិករ ទូរស័ព្ទ ចល័ត ទាំង អស់ កាលពី ថ្ងៃ ទី ២០ ខែ កញ្ញា ពួកគេ បាន យល់ ព្រម ជាមួយ ក្រសួង ប្រៃសណីយ និង ទូរគមនាគមន៍ និង ក្រសួង មហាផ្ទៃ ថា នឹង អនុវត្ត តាម ពេលវេលា កំណត់ របស់ ក្រសួង ដែល នឹង អនុវត្ត នៅ ថ្ងៃ ទី ១ ខែ វិច្ចិកា ។
លោក អ៊ឹម វុត្ថ បាន លើក ឡើង ថា៖
ប៉ុន្តែ ហាង របស់ លោក លក់ ស៊ីម កាត ចុះ បញ្ជី តែ ប៉ុណ្ណោះ ។
អ្នកស្រី ស៊ីវ ម៉ី អ្នក លក់ ស៊ីម កាត រាយ ផ្សេង ទៀត នៅ ហាង វុទ្ធី ហ្វូន សប បាន ឲ្យ ដឹង ថា ចាប់ តាំងពី ការ រឹតបន្តឹង តម្រូវការ អត្តសញ្ញាណប័ណ្ណ ការ លក់ ស៊ីម កាត បាន ធ្លាក់ ចុះ ៤០ ភាគរយ ។
កញ្ញា សំ ស៊ីណេត ដែល កំពុង ប្រើប្រាស់ ស៊ីម កាត មិន ចុះ បញ្ជី ពី ក្រុមហ៊ុន ស្មាត បាន ឲ្យ ដឹង ថា កញ្ញា មិន បាន ទទួល សារ ប្រកាស ណា មួយ ឬ ការ ទូរស័ព្ទ ពី ក្រុមហ៊ុន នៅ ឡើយ ទេ ។
បើ ទោះបី យ៉ាង នេះ ក្តី របាយការណ៍ ចេញ ផ្សាយ កាលពី ថ្ងៃ ម្សិលមិញ បង្ហាញ ថា ការ រក្សា កំណើន នេះ កំពុង មាន ការ ពិបាក កាន់តែ ខ្លាំង ដោយសារ តែ ការ កើនឡើង នៃ ការ ប្រកួត ប្រជែង និង ការ ធ្លាក់ ចុះ ពាណិជ្ជកម្ម ពិភពលោក ។
ប៉ុន្តែ ធនាគារ នេះ ក៏ បាន ព្រមាន ពី ហានិភ័យ នៃ ការ ធ្លាក់ ចុះ ដែល រួម មាន ភាព មិន ច្បាស់លាស់ ដែល អាច កើតឡើង ទាក់ទង នឹង ការ បោះឆ្នោត នៅ ពេល ខាង មុខ ការ ធ្លាក់ ចុះ ដោយសារ តែ ការ រំពឹង ទុក នៃ ការ បង្កើន អត្រា ការ ប្រាក់ របស់ អាមេរិក និង កំណើន សេដ្ឋកិច្ច ពិភពលោក កាន់ តែ ទាប ។
នៅក្នុង ចក្ខុវិស័យ ដែល កែតម្រូវ របស់ ខ្លួន ធនាគារ ពិភពលោក ព្យាករ ថា កម្ពុជា នឹង រក្សា សេដ្ឋកិច្ច ៧ ភាគរយ របស់ ខ្លួន នៅ ឆ្នាំ នេះ បើ ធៀប នឹង ៦,៩ ភាគរយ ក្នុង ការ ប៉ាន់ ប្រមាណ លើក មុន របស់ ខ្លួន ។
របាយការណ៍ បច្ចុប្បន្នភាព នេះ ឲ្យ ដឹង ថា តម្លៃ នាំ ចេញ សម្លៀកបំពាក់ បាន កើនឡើង យ៉ាង រឹងមាំ ក្នុង អំឡុង ឆមាស ទី ១ ឆ្នាំ ២០១៦ ដែល កើន ឡើង ១០,៥ ភាគរយ ធៀប នឹង រយៈពេល ដូច គ្នា កាលពី ឆ្នាំ មុន ។
ធនាគារ ពិភពលោក បាន សន្មត ថា កំណើន នេះ ដោយ ក្រុមហ៊ុន ផលិតកម្ម មាន មូលដ្ឋាន ក្នុង ស្រុក ដែល កំពុង បង្ហាញ ដំណើរការ កាន់តែ ទាន់ សម័យ ដូចជា ការ បោះពុម្ព និង ការ ប៉ាក់ ក្នុង ការ បន្ថែម តម្លៃ ដល់ ផលិតផល កាត់ដេរ របស់ ពួកគេ និង ការ កើនឡើង ខ្លាំង ក្នុង ការ នាំ ចេញ ទៅ ទីផ្សារ អឺរ៉ុប ។
ឧស្សាហកម្ម កាត់ដេរ និង ស្បែក ជើង ដែល មាន ចំនួន សរុប ជាង ៦,៣ ពាន់ លាន ដុល្លារ ក្នុង ការ នាំចេញ កាល ពី ឆ្នាំ មុន និង ផ្ដល់ ការងារ ដល់ កម្មករ ប្រហែល ៧០០ ០០០ នាក់ បច្ចុប្បន្ន ជា សសរ ស្ដម្ភ ដ៏ ក្រាស់ បំផុត របស់ សេដ្ឋកិច្ច កម្ពុជា ។
ឧទាហរណ៍ វិស័យ ទេសចរណ៍ បាន មើល ឃើញ អត្រា កំណើន មធ្យម ប៉ុណ្ណោះ កាលពី ដើម ឆ្នាំ ២០១៦ ដោយសារ តែ ការ ធ្លាក់ ចុះ ការ មក ដល់ របស់ ភ្ញៀវ ទេសចរ វៀតណាម ឡាវ និង កូរ៉េ ខាង ត្បូង ។
ទន្ទឹម នឹង នេះ កសិកម្ម ដែល ធ្លាប់ ជា ឆ្អឹង ខ្នង នៃ សេដ្ឋកិច្ច របស់ កម្ពុជា និង ជា កត្តា ជំរុញ ដ៏ សំខាន់ មួយ នៃ កំណើន ត្រូវ បាន ចាត់ ទុក មិន សំខាន់ ដោយសារ តម្លៃ ចុះ ទាប ។
លោកស្រី ជា សិរី អគ្គ នាយិកា ធនាគារ ជាតិ នៃ កម្ពុជា ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ តាម អ៊ីមែល ថា តម្រូវការ NCD កំពុង កើនឡើង នៅ ទីផ្សារ ហិរញ្ញវត្ថុ កម្ពុជា ដូច្នេះ NBC ត្រូវតែ ផ្លាស់ប្តូរ យន្តការ ខ្លះ ៗ ដើម្បី អភិវឌ្ឍ ឲ្យ មាន ការ ជួញដូរ រវាង ស្ថាប័ន ហិរញ្ញវត្ថុ និង ស្ថាប័ន ដូច គ្នា ។
មិន ត្រឹម តែ ប៉ុណ្ណោះ NBC អាច ដឹកនាំ ប្រតិបត្តិការ រូបិយវត្ថុ មាន ប្រសិទ្ធភាព កាន់តែ ប្រសើរ តាមរយៈ ការ ចាក់ បញ្ចូល សាច់ ប្រាក់ លើ ទីផ្សារ នៅ ពេល មាន កង្វះ ខាត ឬ ការ កាត់ បន្ថយ នៅ ពេល មាន ភាព លើ ស ។
លោក រ័ត្ន យូម៉េង អនុប្រធាន នាយក ប្រតិបត្តិ និង ជា គណៈ ប្រធាន នាយក ប្រតិបត្តិ រតនា ភិបាល នៃ ធនាគារ អេស៊ីលីដា បាន ឲ្យ ដឹង ថា ការ ផ្លាស់ប្តូរ ការ លក់ NCD មក ក្នុង មួយ សប្ដាហ៍ ម្តង តម្រូវ ឲ្យ ក្រុម ការងារ របស់ លោក ត្រូវ រៀបចំ ផែនការ និង គ្រប់គ្រង លំហូរ សាច់ ប្រាក់ ឲ្យ កាន់ តែ មាន ប្រសិទ្ធភាព ជាង មុន ។
មូលនិធិ IMF ដំឡើង ចក្ខុវិស័យសេដ្ឋកិច្ចរបស់ជប៉ុន
ប៉ុន្តែ មូលនិធិ នេះ បាន បន្ត ឲ្យ ដឹង ថា ការ ដំឡើង ការ ព្យាករ នេះ ភាគ ច្រើន គឺ ដោយសារ កត្តា ជំរុញ ដែល បាន រំពឹង ទុក ពី កញ្ចប់ ចំណាយ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ របស់ រដ្ឋាភិបាល ជប៉ុន ចំនួន ២៨ ពាន់ ពាន់ លាន យ៉េន ( ស្មើ ២៧៣ ពាន់ លាន ដុល្លារ ) ដែល ត្រូវ បាន ប្រកាស កាលពី ខែ សីហា ក៏ ដូចជា ការ សម្រេច ពន្យារ ពេល ដំឡើង ពន្ធ លើ តម្រូវការ ប្រើប្រាស់ ។
មូលនិធិ IMF បាន ឲ្យ ដឹង ក្នុង ចក្ខុវិស័យ សេដ្ឋកិច្ច ពិភពលោក ចុង ក្រោយ របស់ ខ្លួន ថា ៖
មូលនិធិ នេះ បាន បន្ត ថា៖
