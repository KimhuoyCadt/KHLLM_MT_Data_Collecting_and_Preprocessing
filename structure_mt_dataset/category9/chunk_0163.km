ប៉ុន្តែ លោក បាន លើកឡើង ថា នេះ ជា ពេលវេលា ដែល កូរ៉េ ទាំង ពីរ ចាំបាច់ ត្រូវតែ ស្វែងរក ចំណុច ល្អ ដើម្បី បញ្ចប់ ការជាប់គាំង ផ្នែក នយោបាយ នេះ ។
ឯ សូក្រាត វិញ ចោទ សំណួរ ឡើង ថា អ្វី ទៅជា ភាពយុត្តិធម៌ ?
ដើម្បី ក្លាយជា អវកាសយានិក តើ អ្នក ត្រូវ មាន លក្ខណៈ សម្បត្តិ អ្វី ខ្លះ ?
និយាយ ពី តុលាការ វិញ ត្រូវ គេ មើលឃើញ ថា ជា ឧបករណ៍ ដ៏ មាន ប្រសិទ្ធភាព របស់ គណបក្ស កាន់អំណាច ។
សូម ប្អូន ប្រុស មាន សំណាង ល្អ ។
ក្នុង កិច្ចការ បច្ចេកទេស រឿង បោះ ព្រំដែន វា អ៊ីចឹង ហើយ បានជា មាន ការជំទាស់ ពី ខាង យើង ។
វា មិន មាន ការច្នៃប្រឌិត អី ទេ ។
នេះ ប្រហែលជា មុនពេល បោះឆ្នោត ឬ ក៏ មួយ ថ្ងៃ បន្ទាប់ពី ការបោះឆ្នោត ។
នាយក រដ្ឋមន្ត្រី ស្នើ ចិន វិនិយោគ លើ ការកែច្នៃ
បន្ត តាម ផ្លូវ សរសៃ ប្រសាទ ។
ហាង លក់ ផ្កា ធម្មជាតិ ។
បុរស ម្នាក់ កំពុង សាសង នែបនិត្យ ជាមួយ សង្សារ ត្រូវ បងប្អូន ខាង ស្រី ប្តឹង សមត្ថកិច្ច
អឺរ៉ុប រកឃើញ កិច្ចព្រមព្រៀង ដើម្បី …
កញ្ញា ឌីលី កាពេល តែង ខ្លួន ក្នុង ឈុត បុរាណ
បញ្ឈប់ គំនិត អវិជ្ជមាន
ហេតុ នេះ ការខូច ហ្វ្រាំង ឬ ចាប់ មិន ស៊ីពេល កំពុង បើកបរ …
បន្ថែម ពីលើ នេះ លទ្ធផល ដែល ទទួលបាន ពិតជា មាន សារសំខាន់ ណាស់ ដើម្បី រៀបចំ ផែនការ យុទ្ធសាស្ត្រ សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ៕
ជួនកាល ប្រជាជន យើង ញ៉ាំ ភ្លេច ខ្លួន ហើយ ថ្ងៃ ក្រោយ គាត់ នឹង ប្រឈម នឹង ជម្ងឺ មហារី ។
ចំណែក អ្នក ប្រកបរបរ រកស៊ី ជួញដូរ មាន ការរកាំ ចិត្ត ព …
ពី ក្រ បាយ ហូប មិន គ្រាន់ ក្លាយជា កសិករ គំរូ ក្នុង ភូមិ សម្បទាន សង្គមកិច្ច សុខ សែន ជ័យ
ទាមទារ សំណង ជំងឺ ចិត្ត ចំនួន ទឹកប្រាក់ ១០០ រៀល មួយ រយ រៀល ។
ក៏ គឺជា របស់ ធម្មតា ដែល តែង កើតមាន ក្នុង រូបកាយ របស់ សត្វលោក គ្រប់ ៗ
នេះ សូម ពិភាក្សា គ្នា ដោះស្រាយ បញ្ហា ដែល សេសសល់ ដោយ សន្តិវិធី ។
អំពើ ប្រល័យ ពូជសាសន៍ ជា អ្វី ?
ឆ្នាំ ទាំង៥ មាន ធាតុ ជា អ្នកសង្គ្រោះ កើត មក នាំ លាភ ជ័យ ដល់ ឪពុក ម្តាយ
លោកស្រី មួរ សុខ ហួរ តំណាងរាស្ត្រ ខេត្ត កំពត នៃ គណបក្ស សម រង្ស៊ី ត្រូវបាន
អ្នកស្រី មិន ប្រកាន់ខ្លួន មិន រើស ម្ហូប ចំណី មាន អី ញ៉ាំ ហ្នឹង ជាពិសស អ្នកស្រី ចូលចិត្ត ម្ហូប ខ្មែរ ។
ដោយ ក្តី គោរព រាប់អាន ពី នាងខ្ញុំ ធី សុវណ្ណ ថា ។
សូម បញ្ជាក់ ថា គណៈប្រតិភូ ក្រុម អ្នក សង្កេតការណ៍ អន្តរជាតិ មកពី ៣ស្ថាប័ន នយោបាយ រួម មាន ៖
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ បាន បញ្ជាក់ ថា ផ្ទៃដី ប្រទាញប្រទង់ នេះ អាច មាន រហូត ទៅដល់ មួយ ពាន់ ហិកតារ ។
ឡាន នៅ ស្អាត ទាំងអស់
មាន ការជជែក ដេញដោល រាប់ រយ ករណី ត្រូវបាន ធ្វើឡើង នៅ ទូទាំង ប្រទេស ។
សេចក្តីព្រាង ច្បាប់ នេះ មិន ត្រូវបាន គេ ដាក់ ជូន ទៅ រដ្ឋសភា នៅឡើយ នោះ ទេ ហើយ ឥឡូវនេះ ច្បាប់ នេះ នៅ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នៅឡើយ ។
ទៅ ប្រជុំ ខាង ប៉ុស្តិ៍ វៀតណាម ដែល គេ កាន់ការ នៅ ហ្នឹង ផ្ទាល់ ហើយ ឥឡូវ រង់ចាំ បទបញ្ជា ថ្នាក់ លើ គាត់ ឱ្យ ដោះស្រាយ ក៏ប៉ុន្តែ ធ្វើ បន្ត គឺ ការពារ ដាច់ខាត ។
ដើម្បី សង្គ្រោះ ទ្រព្យ របស់ ប្រទេស នៅ បរទេស ។
ថ្ងៃ ៩វិច្ឆិកា មិន ត្រឹម ជា ថ្ងៃ ពិសេស របស់ កម្ពុជា ទេ តែ ក៏ ជា ថ្ងៃចងចាំ មួយ របស់ ប្រជាជន អាល្លឺម៉ង់ ដែរ !
យើង ផ្សាយ ជាសាធារណៈ តាម ទូរទស្សន៍ អីអញ្ជើញ មក ទាំងអស់ តើ !
កុមារភាព របស់ អ្នក គ្រាន់តែ ជា អតីតកាល តែ ប៉ុណ្ណោះ ដូចនេះ មនុស្ស ឬ ព្រឹត្តិការណ៍ ដែល អ្នក បាន ជួប មិន មាន ទៀត ឡើយ ។
តាម ការស្រាវជ្រាវ របស់ លោក នា គ្រា សង្គ្រាម វៀតណាម មិន សូវ មាន ឱកាស
លបងាញ កន្លយដុះ ភាប់ ពី
សូម បញ្ជាក់ ថា ក្រុមប្រឹក្សា តំបន់ អាកទិក មាន ប្រទេស ជា សមាជិក ចំនួន ៨មាន ជាអាទិ៍ ដូចជា ៖
រាប់ ពី មួយ ដល់ ដប់ រួច ឱន មុន ត្រឡប់ មកកាន់កាយវិការ ទី ពីរ វិញ ហើយ ចាប់ផ្តើម ធ្វើ សា ជា ថ្មី ។
គួរ រំឮក ផងដែរ ថា បើ ទោះជា នៅ មិន ទាន់ មាន ទ្រនំ ក្នុង សិល្ប ពិតប្រាកដ យ៉ាងណា ក្តី ប៉ុន្តែ ជាតិ សុច្ចកា នៅតែ ទទួលបាន ការចាប់អារម្មណ៍ ពីសំណាក់ មហាជន ។
ជាមួយគ្នា នេះ ផងដែរ OPEC នឹង ពិភាក្សា ពី ការកាត់បន្ថយ ទិន្នផល ប្រេង បន្ទាប់ពី កិច្ចប្រជុំ នៅ ថ្ងៃទី ៦ ខែធ្នូ ខាងមុខ នេះ ៕
មេដឹកនាំ រុស្ស៊ី និង អ៊ុយក្រែន ទាមទារ ដូចគ្នា ឱ្យ ដោះលែង អ្នកទោស របស់ ម្ខាង ៗ
បន្ទាប់មក លោក ក៏ បាន ចេញមុខ មក សូម ទោស ចំពោះ ការលើកឡើង ដូច្នោះ ដែល នាំឱ្យ មនុស្ស ប្រភេទ នេះ ឈឺចាប់ ប៉ុន្តែ លោក ក៏ បាន បញ្ជាក់ ច្បាស់លាស់ ដដែល ថា នឹង ប្រឆាំង ការរៀបការ ភេទ ដូចគ្នា ៕
បើ ពិតជា ចាំបាច់ ចង់ និយាយ ធ្វី ជាមួយ មិត្ត យើង មែន គួរតែ ចាំ ពេល ទំនេរ ក្រៅ កន្លែង ធ្វើការ ។
ឥណ្ឌា ជា ប្រទេស ផលិត វ៉ាក់សាំង ធំ ជាង គេ បំផុត នៅក្នុង ពិភពលោក ។
៧ក្រសួង ចាំ យក លុយ ពី អ្នកលក់ ស្រូវ នៅ ព្រៃវែង
សម្រាប់ ករណី ០២ ថ្មី ទៀត គឺជា ជនជាតិ ចិន ។
ដូច្នេះ ទំនប់ នេះ នឹង បង្ក ផល ប៉ះពាល់ ជាច្រើន ទៅ លើ មិន ត្រឹមតែ ប្រជាជន ថៃ ប៉ុណ្ណោះ ទេ គឺ ថែមទាំង តំបន់ ទាំងមូល ។
សណ្ឋាគារ នៅ សៀមរាប ចំនួន ៨ ត្រូវបាន បិទ ទ្វារ ជា បន្តបន្ទាប់
ព្រះអ្ហាយ៍ ន័យ ខុសពី អ្វី ដែល ខ្ញុំ បាន គិត ក៏ ដូចជា អ្នក ផ្សេង បាន គិត ១៨០ដឺក្រេ ។
ទាហាន យល់ព្រម នឹង សំណើ នេះ ។
នេះ គឺជា ផ្លែ ឈើ ដែល ល្អ បំផុត ចំពោះ សុខភាព ទាំង ២០ ប្រភេទ នៅលើ ផែនដី ។
អ្នក ទាំងនោះ បាន ពោរពេញ ដោយ ព្រះវិញ្ញាណ ដ៏ វិសុទ្ធ, ហើយ ចាប់ផ្តើម និយាយ ភាសា ផ្សេង ៗ
ប៉ុន្តែ អ្នកស្រី មិន ព្រម ក្រោយ មក ក៏ ស្រាប់តែ ទូរស័ព្ទ ខល លែង ចូល ។
ដកស្រង់ ពី សប្បាយ
ឡិចស៊ីស បើក ធ្លាក់ ប្រឡាយ ព្រោះ មិន ស្គាល់ ភូមិសាស្ត្រ
មនុស្សម្នា ទាំង ក្មេង ចាស់ ពួកគេ ម្នាក់ ៗ
ពោល អំពី រឿងរ៉ាវ នៃ ស្តេច ធំ ទាំង ៤ជាដើម
ពួកយើង គ្នា ប្រាំ នាក់ ល្មម មួយ ឡាន រាប់ មាន ខ្ញុំ អនុប្រធាន របស់ ខ្ញុំ និង ក្មួយ
៤. មនុស្ស ស្រី ចូលចិត្ត ឱ្យ គេ សរសើរ និង ចូលចិត្ត ទទួល កាដូ
ដំឡូង - រុក្ខជាតិ ប៉េងប៉ោះ
ផលិតកម្ម សាន់ដេឡើយ សូម្បីតែ កូន គំនិត ដ៏ តូច មួយ ក៏ មិន មាន ដែរ ។
ក្រោយពី បាន ធ្វើ សកម្មភាព រួច ជនសង្ស័យ ទាំង ០២ នាក់ បាន ជិះ ម៉ូតូ គេចខ្លួន ។
ក្នុង ប្រទេស កម្ពុជា ការអភិវឌ្ឍន៍ សំណង់ លំនៅ ស្ថាន មាន កំណើន ខ្ពស់ គួរឱ្យ កត់សម្គាល់ ។
ការធ្វើ បែប នេះ ព្រោះ នាង គិត ថា ប្រសិនជា នាង ឱ្យ នាង គ្រាន់តែ ជា ស្រី ម្នាក់ ក្នុង ចំណោម ស្រី ផ្សេង ទៀត ដែល ត្រាំ ទូរសព្ទ ទៅ ញ៉ែ ។
យានយន្ត សម្រាប់ ដឹក អ្នកដំណើរ សាធារណៈ នានា ក៏ ត្រូវបាន ផ្អាក ដែរ ។
បញ្ចប់ រាល់ ទម្រង់ នៃ អំពើហិង្សា មក លើ ស្ត្រី និង កុមារី
រឿង ចោរ ចិត្ត ជា
ដើម្បី ជំរុញ ការដឹកជញ្ជូន តាម ផ្លូវ ដែរ ថ្ងៃ ១៧មីនា ២០១៩ នេះ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ដឹកនាំ ប្រជាពលរដ្ឋ ស្…
គ្នា យើង មួយចំនួន អាច ងឿងឆ្ងល់ និង បារម្ភ ពាក់ព័ន្ធ រឿង រួមភេទ និង វដ្ត រដូវ របស់ ខ្លួន តើ អាច ធ្វើឱ្យ រដូវ មក មិន ទៀង ដែរ ឬ អត់ ?
ផ្ទុយទៅវិញ អង្គការ សង្គម ស៊ីវិល និង កសិករ ខ្នាត តូច យល់ ថា ការអនុវត្ត នៅតែ មិន ទាន់ មាន ប្រសិទ្ធភាព នៅឡើយ ។
ធ្វើឡើង ដើម្បី ដឹងគុណ ដល់ ព្រះគង្គា និង ព្រះធរណី និង ដើម្បី បូជា ចំពោះ ព្រះចង្កូម កែវ ពិភព នាគ ដែល ព្រះពុទ្ធ បាន ទៅ ស្ទឹង នម្ម ទា និង នៅ ទីឯ ទៀត ។
ទីបំផុត នាយ តាក់ស៊ី សាង ផ្នួស បាន សម្រេច ហើយ នៅ ព្រឹក ថ្ងៃ នេះ
តើ រាជធានី ភ្នំពេញ ត្រូវការ ទឹក ស្អាត ប៉ុន្មាន ម៉ឺន ម៉ែត្រ គីប ដើម្បី ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ?
ទេសចរណ៍ ជា វិស័យ សំខាន់ មួយ ដែល បាន ជួយ ទ្រទ្រង់ សេដ្ឋកិច្ច ប្រទេសជាតិ ។
ព្រោះ រឿង នេះ កើតឡើង ជា យូរ ណាស់ មកហើយ នៅតែ ពុំ អាច បង្ក្រាប បាន ទៀត ៕
សង្ឃឹម ថា អាច ប្រើប្រាស់ ជាមួយ ក្រុម ម៉ាក់ អូអេស បាន !
អ្នកស្រាវជ្រាវ បាន ប្រើប្រាស់ ទិន្នន័យ មកពី ជនជាតិ អង់គ្លេស ច្រើន ជាង ៣០០០ នាក់ ដើម្បី ពិនិត្យ ទៅ លើ ទំនាក់ទំនង មួយ នេះ ។
ដូចជា ព្រះបរម រាជ វាំង ជាដើម ។
គ្រប់ មណ្ឌល សុខភាព ត្រៀម សង្គ្រោះ ក្រែង មាន ពុល នំបញ្ចុក នៅ ថ្ងៃ ៩មិថុនា
ជាច្រើន ទៀត ត្រូវបាន ប្រមូល យក ផ្តុំ គ្នា នៅក្នុង ហ្គេម នេះ តែម្តង ។
បច្ចេកទេស ដាំ ប៉សឺឡែន ប្រណីត ចាប់តាំងពី ស្នាម លម្អិត រហូតដល់ បំណិន ផ្សំ ពណ៌ ។
ការប្រកាស នេះ មាន ការសាទរ ជាច្រើន ពីសំណាក់ អ្នកគាំទ្រ ជាច្រើន របស់ តារាង ចំរៀង វ័យ ៣៥ រូប នេះ ។
ទាំងអស់ ដូចជា មាន គោលបំណង ចង់ បំបាត់ ចោល ទាំងស្រុង នូវ សំលេង នៃ រាល់ ការទាមទារ តវ៉ា ទាំងឡាយ ។
អ្នកចូលរួម ជាង ១១០ នាក់
ខ្ញុំ ពេល នោះ គឺជា ក្មេង ដែល មាន ពេលវេលា ច្រើន ក្នុង ជីវិត ហើយ ខ្ញុំ បាន ធ្វើ អាល់ប៊ុម សម្រាប់ ពិធី ជប់លៀង មួយ ។
ឆ្នាំ ក្រោយ ខ្ញុំ នឹង បើក ប្រភព កម្មវិធី បង្កើត គម្រោង ដោយ ស្វ័យប្រវត្តិ របស់ ខ្ញុំ ផ្ទាល់ តែម្តង ។
ម៉ូតូ លក់ អាយ ខន មាន ពន្ធ ម៉ូតូ ស្អាត
ល្បង ខ្ញុំ ចង់បាន ខុសពី រូប អង្គរ វិញ អាច ដាក់ ជា រូប ផ្សេង ដូចជា រូច ហង្ស បាយ័ន្ត រឺ ថា ជា រូបរាហូ ។
សូម ជួយ បកស្រាយ ឱ្យ បាន ក្បោះក្បាយ បន្តិច បាន ទេ ?
ពិនិត្យមើល ឱ្យ ច្បាស់ ធនប័ត្រ អនុស្សាវរីយ៍ ប្រភេទ ៣០០០០ រៀល ថ្មី ដាក់ ឱ្យ ប្រើប្រាស់ នៅ ថ្ងៃ នេះ
ប៉ុន្តែ សំណុំរឿង ព្រហ្មទណ្ឌ នោះ មិន ត្រូវបាន រំលត់ ចោល ទេ ។
ម៉ាឡេស៊ី មិន ទាន់ រិះគន់ ទៀន ដោយ ចំ ៗ
លទ្ធផល ផ្លូវការ នៃ ការបោះឆ្នោត ឆ្នាំ ២០១៣
រឿងក្តី នេះ វា ធំ ហើយ រឿង មេធាវី ស្ម័គ្រចិត្ត ហាក់បីដូចជា អ្នកណា ចេញមុខ ជួយ ធ្វើ រឿង ហ្នឹង ។
ពេល ខ្លះ សញ្ញា លើ ក្រចក អាច មាន ប្រតិកម្ម ទៅនឹង ផលិតផល អ្វី មួយ ។
ប្រធានបទៈ ព្រឹទ្ធសភា មាន អាណត្តិ
ផ្ទុះ គ្រាប់បែក នៅ ទីតាំង ពួក ឧទ្ទាម នៅ ទីក្រុង ស៊ីរី សម្លាប់ មនុស្ស ១៨ នាក់
ហើយ មួយចំនួន បាន ទទួល ការពេញនិយម ពី អ្នកគាំទ្រ ដោយ ជារឿយ ៗ
សរុប មក ការកំណត់ មុខងារ នេះ ពិតជា ផ្តល់ ភាពងាយស្រួល និង សន្សំ ពេលវេលា ដល់ លោក អ្នក ផងដែរ ។
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីប្រកាស ដូច ខាងក្រោម ៖
តែ ទូលបង្គំ នឹង រក្សាទុក នូវ បញ្ញត្ត ទ្រង់ យ៉ាង អស់ ពី ចិត្ត
ទោង នឹង រំអិល ក្មេង លេង
វត្ថុតាង ត្រូវបាន សមត្ថកិច្ច យកមក រក្សារ ទុក នៅ អធិការ នគរបាល ស្រុក ៕
បង្ហាញ អំពី ច្បាប់ បទបញ្ញត្ត និិង សេចក្តីជូនដំណឹង ផ្សេង ៗ
បំលែង ប្រាក់ រូពី ស្រីលង្កា ទៅ ប្រាក់ យ៉េន ។
ដើម្បីឱ្យ ប្រភេទ ខ្មែរ យូនី កូដ ទាំងនេះ តំនើរការ នៅក្នុង
បើ ទុក លោក ឈាង វុន ធ្វើ ការបន្ត ទៀត ច្បាស់ជា អាណាត្តិ ក្រោយ ៗ
ក្នុង នោះ ជីវិត ឯកជន របស់ អ្នកនាង ក៏ ត្រូវបាន បើក ចំហ ខ្លាំង ក្រោយ កូន របស់ អ្នកនាង កាន់តែ ធំ ឡើង ៗ
ក្នុង លិខិត កាលពី ថ្ងៃទី ២៩ ខែមិនា ទៅកាន់ លោក សម រង្ស៊ី លោក ហ៊ុន សែន បាន សរសេរ យ៉ាង ដូច្នេះ ថា
មាន មិត្ត ខ្លះ បាន ណែនាំ ខ្ញុំ កុំ ឱ្យ ធ្វើ បែប នេះ ខ្ញុំ ពិតជា សោកស្តាយ ណាស់ ដែល ខ្ញុំ មិន អាច ធ្វើ តាម សំណូមពរ របស់ ពួកគេ បាន ។
