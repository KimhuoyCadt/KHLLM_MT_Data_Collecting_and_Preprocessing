ប៉ុន្តែ នៅក្នុង ពិភព បាល់ទាត់ អ្នក មិន អាច បដិសេធ អ្វី ៗ
ព្រោះ ធ្លាប់ បាន ធ្វើ ពិសោធ ទៅ លើ អាកាសធាតុ ចំនួន ពីរ លើក រួច មកហើយ ។
ចំពោះ សិស្ស ជយលាភី ដែល ជាប់ និទ្ទេស A ទាំង ៨នាក់ ក្នុង ម្នាក់ ៗ
ទោះបី ប្រជាពលរដ្ឋ ក្នុង ទីក្រុង ក៏ដោយ ។
ខ្ញុំ មិន អាច ធ្វើ អ្វី កើត ទេ ជាមួយ អាឡិក ស៊ីស សាន ឆេស
នេះ ផងដែរ មុននឹង បញ្ជូន ដល់ ព្រឹទ្ធសភា និង ក្រោយមក នឹង ត្រូវ ឡាយ ព្រហស្ថលេខា ដោយ ព្រះមហាក្សត្រ ដើម្បី ប្រកាស ឱ្យ ប្រើ ។
បាន ល្បីល្បាញ និង គេ ស្គាល់ បន្ថែម ទៀត ។
យើង នឹង ដាក់ សំណើ ជា ផ្លូវការ ដើម្បី អាច បញ្ចាំង បាន នៅក្នុង ពេល អនាគត ។
នេះ បាន បង្ហោះ រូបភាព មួយចំនួន ដែល កីឡាករ មួយចំនួន បាន លេង បាល់បោះ ។
ខ្ញុំ គឺជា សាស្ត្រាចារ្យ នៅ មហាវិទ្យាល័យ ដូច្នេះ វា គឺជា កាតព្វកិច្ច របស់ ខ្ញុំ ដែល ត្រូវ ចូលរួម ផ្តល់ យោបល់ ជួយ ជាតិ ។
ឱ្យ អ្នក រីករាយ នឹង ពន្លឺ ដ៏ ភ្លឺស្វាង នៅ ពេលល្ងាច !
ពួកយើង ចូលរួម យកចិត្តទុកដាក់ ចំពោះ កុមារ ទាំងអស់ គ្នា ។
អរគុណ សូម បាន ជួប នៅ សេចក្តីសុខ នឹង បាន ស្រាកស្រាន្ត !
មួយ ទៀត គឺ ពិបាក មាន ទំនាក់ទំនង ជាមួយ អ្វី ដែល គេ ហៅ ថា ភ្នាក់ងារ ជា តំណាង នៃ អង្គការ សហ ប្រជាជាតិ ទៅ ទៀត ។
សូម បញ្ជាក់ ថា ប្រេង ដូង នេះ មិន មាន ក្លិន ប្រេង ដូង ដូចជា ការរំងាស់ តាម ដែល យើង ធ្លាប់ ធ្វើ នោះ ឡើយ ។
ចង់ ដឹង អត់ ថា មាន អ្វី កាន់តែ អស្ចារ្យ ជាមួយនឹង …
ក្លាយជា អ្នក មាន ព្រោះតែ បាល់ -
កូរ៉េ ខាងជើង នៅ ពេល ថ្មី ៗ
ចប់ ហើយ ខ្ញុំ បើ និយាយ ដល់ គណិតវិទ្យា
ការរៀនសូត្រ គឺជា ការវិនិយោគ ដ៏ ល្អ បំផុត តែ មួយ គត់ ដែល អ្នក ត្រូវ ធ្វើ ។
តែ បែរជា រំពឹង លទ្ធផល ផ្សេង ដែល ប្រសើរ ជាង មុន ។
ក្នុង លោក នេះ ព្រមទាំង ទេវលោក មិន មាន បុគ្គល ប្រៀប នឹង តថាគត បាន ទេ ។
នេះ បើ យោង តាម ការប្រកាស របស់ ព្រះបរម រាជ វាំង ។
គួរតែ ដឹង ដែរ ថា អ្វី ទៅជា សេចក្តីថ្លៃថ្នូរ របស់ ខ្លួន ។
សូម ឯកឧត្តម ទាំង បី មេត្តា ទទួល នូវ ការគោរព រាប់អាន អំពី ខ្ញុំ មុត ចន្ថា ៕
តើ មនុស្ស ត្រូវការ គេង ប៉ុន្មាន ម៉ោង ទើប គ្រប់គ្រាន់ ?
ផ្លុង - រ៉េត សូម ជួយ ចែករំលែក បន្ត បើ អ្នកស្រលាញ់ ប្រទេសជាតិ របស់ ខ្លួន
ហើយ ព័ត៌មាន នេះ ខ្ញុំ គិត ថា ជា ព័ត៌មាន មិន ពិតប្រាសចាក ពីលើ មូលដ្ឋាន សព្វ បែប សព្វ យ៉ាង ទាំងអស់ ។
ក្នុង គ្រា ដ៏ លំបាក នេះ អ្នក ត្រូវ ធ្វើជា បុគ្គល ដែល លះបង់ និង រឹងមាំ ។
ចំណែកឯ អ្នកនាំពាក្យ ស្ថានទូត អាមេរិក វិញ បញ្ជាក់ ថា លោក មិន ទាន់ អាច ធ្វើ អត្ថាធិប្បាយ បាន ទេ នៅ ថ្ងៃ នេះ ។
ប៉ុន្តែ សូម កុំ ព្រួយបារម្ភ ព្រោះ ពួកយើង នឹង ណែនាំ ប្រភេទ អាហារ ឆ្ងាញ់ ៗ
វីដេអូ នេះ ទំនងជា ត្រូវបាន ថត នៅ មួយ ថ្ងៃ ក្រោយពេល កើត ហេតុ ភ្លាម ៗ
គ្នា ជា លើក ដំបូង ក្នុង ប្រវត្តិសាស្ត្រ ចាប់តាំងពី ឆ្នាំ ១៩៦៥ ៖
វា ជា ក្តី សុបិន របស់ យើង ទាំង ពីរ ហើយ ខ្ញុំ ក៏ មិន ចង់ឱ្យ វា បាក់ទឹកចិត្ត រាថយ រហូត ភ្លេច ក្តីស្រមៃ របស់ ខ្លួន ឯង នោះ ទេ ។
កម្ពុជា ត្រៀម បញ្ជូន កាកសំណល់ សំរាម ប្លាស្ទិក ១៦០០តោន ទៅ អាមេរិក និង កាណាដា វិញ
ទៅកាន់ អ្នក រាល់គ្នា ដោយ ដៃ ខ្ញុំ ផ្ទាល់ ។
ខ្ញុំ សូម អះអាង ថា សម្តី ខ្ញុំ ពិត គ្រប់ ម៉ាត់ ។
ហើយ ដូច្នេះហើយ មាន រង់ចាំ រហូតដល់ ច្រមុះ កញ្ញា ឈប់ ហើម ថា តើ នាង ស្រស់ស្អាត ដល់ កម្រិត ណា ។
លោក ថា មិន មាន សំភាៈ គ្រប់ ឱ្យ កម្មករ ទេ ដោយសារ លោក ម៉ៅត ពី គេ ហើយ លោក ក៏ បាន និយាយ ណែនាំ កម្មករ ឱ្យ មាន ការប្រយ័ត្នប្រយែង ដែរ ។
ជាក់ស្តែង កាលពី ថ្ងៃពុធ កន្លងទៅ នេះ នៅលើ គណនី
តុលាការ នៅ កម្ពុជា គ្មាន ឯករាជ្យ ស្ថិត នៅក្រោម អំណាច នយោបាយ ?
លោក បញ្ជាក់ ថា កន្លងមក ខេត្ត នីមួយ ៗ
ការស្នាក់ នៅ រយៈពេល ខ្លី - ការស្នាក់ នៅ
តែងតែ កើត ករណី ឃាតកម្ម ។
លោក ថា លោក មាន ការសោកស្តាយ ៖
ពី ដៃ ក្រុម អ្នកតវ៉ា ។
ខុសប្លែក ឆ្ងាយ ពី យើង ។
លោក អ្នក ធ្លាប់ ជួបប្រទះ កូន មាន អាការប្រកាច់ រមួល ខ្លួន ទេ ?
ព្រះអង្គ ដាក់ទោស គេ
គម្រោង ទាំង៤ ដែល ចុះហត្ថលេខា នា ថ្ងៃ នេះ នឹង ចូលរួមចំណែក ក្នុង ការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាជន កម្ពុជា ក្រីក្រ ហើយ យើង សប្បាយរីករាយ ក្នុង ការជួយគាំទ្រ ពួកគាត់ ។
អូស ដៃ ស្ត្រី ម្នាក់ ចូល បន្ទប់ គ្លីនិក ប៉ង អី ៗ
រង្វាន់ សាច់ប្រាក់ តើ វា នឹង ត្រូវ បញ្ជូន មក ខ្ញុំ យ៉ាងដូចម្តេច ?
ត្រូវ ឱ្យ ប្រាកដ ថា អ្នក រក្សា ការពិភាក្សា ជា បន្ត ទៀត ។
អ្នកនាង ចូលចិត្ត បរិភោគ ផ្លែ ឈើ ដូចជា ផ្លែ ប៉ោម ពណ៌ ខៀវ ជាដើម និង បន្លែ ។
ប្រហែលជា អ្នកដទៃ មិន ចាប់អារម្មណ៍ ទេ ប៉ុន្តែ ក្នុង នាម ខ្ញុំ ជា មគ្គុទ្ទ សកេ៍ ទេសចរណ៍ ម្នាក់ ខ្ញុំ តែងតែ ឮ ពាក្យ នេះ នៅក្នុង ត្រចៀក ជានិច្ច ។
នេះ សូម ចាប់ វា ទុក ផង ព្រោះ វា បាន លួច ស្លាកលេខ ឡាន របស់ ខ្ញុំ និង អ្នកជិតខាង ម្នាក់ ទៀត ។
ក្រោយពី សម្រាល កូន រួច តើ ស្ត្រី ត្រូវ បន្ត ធ្លាក់ ឈ…
កត្តា នេះ ហើយ ជា អ្នក កំណត់ សេដ្ឋកិច្ច ហើយ សេដ្ឋកិច្ច កំណត់ ទីផ្សារ អចលន វត្ថុ ។
ដង្ហែរ មក ឃើញ តែ ព្រះសព និង ក្តាម ឈូស ព្រះអង្គ តែ ប៉ុណ្ណឹង ។
ប្រជាជន អាមេរិក ច្រើន ជាង ៤០០០០០ នាក់ ហើយ មាន ជំងឺ ដោយសារតែ បាក់តេរី ស៊ាំ ថ្នាំ ជារៀងរាល់ ឆ្នាំ ។
លោក មិន បាន ចូលរួម ក្នុង ការស្រវ ជ្រាាវ នេះ ទេ ។
ការធានា ៣ឆ្នាំ ។
អ្នកនាង ទែន សុខ ស្រី និត ប្រែ សម្រួល សេចក្តីរាយការណ៍ នេះ ។
ប៉ុន្តែ អត្តសញ្ញាណ របស់ អ្នកស្លាប់ មិន ទាន់ ដឹង នៅឡើយ ទេ ។
ក៏ ស្ញប់ស្ញែង ជាមួយ ភាពល្បីល្បាញ របស់ នាង ដែរ …
និង តាម ការនិយម ចូលចិត្ត របស់ ប្រជាជន នៅក្នុង សម័យ នោះ ។
ទីបំផុត ចង្ក្រៀង ខ្ញុំ ក៏ មាន ប្រេង ស្មៅ
៧ឥឡូវនេះ ចូរ បង្ហាញ ខ្លួន មក ខ្ញុំ នឹង កាត់ក្តី អោយ អ្នក រាល់គ្នា នៅ ចំពោះ ព្រះភក្ត្រ ព្រះអម្ចាស់ ។
ស្ត្រី ជាច្រើន គ្មាន ភាពរំភើប ឬ ចូលចិត្ត វា នោះ ទេ ។
នៅក្នុង របារ ចំហៀង ខាងឆ្វេង ចុច លើ លុប ទិន្នន័យ ទាំងអស់ ។
សម្រាប់ អ្នកម្តាយ ជាទីគោរព !
ជនល្មើស ៣នាក់ រួមគ្នា ហែក គុក បាន ដោយ សុវត្ថិភាព
ដូច្នេះហើយ យើង យល់ ថា ពួកគេ គួរតែ ទទួល រង ទណ្ឌកម្ម ។
ចាប់តាំងពី ពេល នោះ មករាល់ ការសម្តែង របស់ លោក ម្តង ៗ
គ្នា ថា គេ មិន ខ្លាច ទេ អង្គភាព ប្រឆាំង អំពើពុករលួយ ខ្លាចតែ ពួយ រលីង ៕
់ើម្បី បំពេញ តម្រូវការ ក្នុង ស្រុក នោះ ទេ ។
ពួក លោក បំពេញ ការងារ ទាំង ប៉ុន្មាន នៅក្នុង ទី សក្ការៈ បំផុត ហើយ ធ្វើ ពិធី រំដោះ បាប អោយ ជនជាតិ អ៊ីស្រាអែល ស្រប តាម សេចក្តី ទាំង ប៉ុន្មាន ដែល លោក ម៉ូសេជា អ្នក បំរើ របស់ ព្រះជាម្ចាស់ បាន បង្គាប់ ទុក ។
ក្រុមការងារ ទាំង នេះ បាន ឱ្យដឹង ថា ពួកគេ សង្ឃឹម ថា លទ្ធផល នេះ នឹង អាច ជួយ កំណត់ និង តម្រែ តម្រង់ កុមារ កុំ ឱ្យ ឆាប់ ពាក់ព័ន្ធ ទៅនឹង រឿង ល្បែង ស្នេហា ពេក ៕
ប៉ុន្តែ យង ចង់ឱ្យ អ្នកគាំទ្រ របស់ យើង ស្ថិត នៅ ជាមួយនឹង យើង ក្នុង ពេល បាត់បង់ ទម្រង់ លេង បែប នេះ ។
ប្រសិនបើ អ្នក ចង់ មើល ថា តើ ក្រុមហ៊ុន ណា ខ្លះ នៅលើ ពិភពលោក ដែល ល្បី ៗ
ប៉ុន្មាន ថ្ងៃ ក្រោយពី ទទួលមរណភាព សព របស់ ប៉ុល ពត ត្រូវបាន បូជា
ប្រាសាទ នេះ បាន កសាង នៅ ចំ កណ្តាល នៃ រាជធានី របស់ ព្រះបាទ ជ័យ វរ្ម័ន
អាជ្ញាធរ បាន និយាយ ថា មនុស្ស រាប់ ពាន់ នាក់ ត្រូវបាន គេ នាំ ទៅកាន់ កន្លែង សុវត្ថិភាព ប៉ុន្តែ រហូតមកដល់ ពេលនេះ មាន មនុស្ស ច្រើន ជាង៦,០០០នាក់ នៅតែ កំពុង រង់ចាំ ការជួយសង្គ្រោះ ។
អ្នក អាច បរិភោគ វា បាន ក្នុង កម្រិត មួយ សមរម្យ ចៀសវាង ការញ៉ាំ ច្រើន ឬ ញឹកញាប់ ពេក ៕
គ្រាន់តែ ថា អ្នក អាយុ កាន់តែ ច្រើន ពេលវេលា ទំនេរ កាន់តែ តិច ។
តើ អ្នក ជួប បាន ម្នាក់ ហើយ ឬ នៅក្នុង ជីវិត នេះ
ទៀត ឬ ក្លាយជា គោល ដៃ នៃ ការវាយប្រហារ តែ ប៉ុណ្ណោះ ។
អាជ្ញាធរ រង ការរិះគន់ ថា ដឹក សព មនុស្ស ដូច ដឹក ខ្មោច សត្វ
សង្ឃ មាន លទ្ធិ មាន និកាយ របស់ សង្ឃ ។
ឯង ចិត្ត ធ្ងន់ ណាស់ ន៎ បើ ខ្ញុំ វិញ ខ្ញុំ នឹង ទៅ ប្រដៅ អាតា កញ្ចាស់ ហ្នឹង ឱ្យដឹង ដៃ របស់ ខ្ញុំ ម្តង ឱ្យដឹង ថា យ៉ាងម៉េច ឃើញ ខ្ញុំ ស្លូត ចង់បាន ដៃ មីង ភុន ៖
ក្នុង ករណី នេះ អ្នក អាច ស្វែងរក ការងារ មួយចំនួន ធ្វើ ដើម្បី កំដរ អារម្មណ៍ ។
សមាជិក ក្រុមគ្រួសារ ដែល កំពុង ស្នាក់ នៅក្នុង ផ្ទះ នោះ មាន ទំនោរ ចិត្ត ចេញ ទៅ ក្រៅ កាន់តែ ញឹកញាប់ ហើយ មិន បាន ស្នាក់ នៅក្នុង ផ្ទះ ទេ ។
ក៏ប៉ុន្តែ បុរស ជា ឪពុក នៅតែ ចចេះ ទាមទារ ឱ្យ ប្រគល់ លុយ ភ្លាម ៗ
អ្នក ត្រូវ ចុះ កិច្ចសន្យា អោយ បាន ត្រឹមត្រូវ ជាមួយនឹង ម្ចាស់ ផ្ទះ ចាស់ ។
សម័យ មិន បណ្តោយ ឱ្យ កូន ណាមួយ ល្ងង់ខ្លៅ ឡើយ ។
លោកស្រី ភឿង ស កុណា លើកឡើង ក្នុង លិខិត នោះ ថា ៖
ពិភពលោក ផ្លាស់ប្តូរ ស្ទើរតែ ជារៀងរាល់ ថ្ងៃ ហើយ អាជីវករ ត្រូវតែ មាន សមត្ថភាព ក្នុង ការសម្រប ខ្លួន ទៅនឹង ការផ្លាស់ប្តូរ ក្នុង វិស័យ របស់ ខ្លួន ដែរ ។
ចំនួន អសនៈ សម្រាប់ មណ្ឌល នីមួយ ៗ
ដូចនេះ ទោះ ជ្រើសរើស ប្រេង ឆា ក៏ដោយ ត្រូវ ចម្រាញ់ យក ផលិតផល ណា ល្អ ដូចនេះ ជម្រើស ល្អ គួរ ប្រើ ប្រេង អូលីវ វិញ ទើប មាន គ្រោះថ្នាក់ តិច ។
លោកស្រី ត្រូវបាន ប្តូរ ទៅ គ្រប់គ្រង នាយកដ្ឋាន រតនាភិបាល នៅ ឆ្នាំ ២០០៨ ។
ជនជាប់ចោទ អោអាន ឬ ហៅ ថា ៖
ប្រសិនបើ អ្នក មាន គោលបំណង ច្បាស់លាស់ និង ជំហរ រឹងមាំ នោះ អ្នក ប្រាកដ ជា អាច ធ្វើ បាន ។
ង បុប្ផា ធ្វើឱ្យ យើង មាន មោទនភាព ចំពោះ គាត់ ណាស់ ។
ខ្ញុំ សង្ឃឹម ថា យើង នឹង ក្លាយជា មិត្ត ដ៏ ល្អ នឹង គ្នា
ទំព័រ ដើម សហគមន៍ សហគមន៍ ដែល ចាក រំលែក សេចក្តី អាណិត ស្រលាញ់ របស់ លោក អ្នក
លុះ ដល់ ផុត កណ្តាល ស្រាប់តែ រេ ចង្កូត បុក បង្កាន់ដៃ ស្ពាន បណ្តាលឱ្យ ក្រឡាប់ តែម្តង ។
ខ្ញុំ ផឹក ទឹក ដើម្បី បំបាត់ ភាពស្រេកឃ្លាន ។
បើ មាន អ្នកណា ស្គាល់ ជួយ ប្រាប់ ផង ។
គម្រោង ទី7 ផ្នែក វិទ្យាសាស្ត្រ
លោក បន្ត ថា ក្រៅពី បួន ទីតាំង សំខាន់ ៗ
បើសិនជា ប្រការ នេះ កើតមាន វា នឹង ជា គ្រោះ សោនាដកម្ម១ ចំពោះ មនុស្សលោក ។
កូនស្រី មួយ នេះ ពិបាក ក្មួយ បន្តិច ហើយ !
ប្រាប់ ឱ្យ ជូន គាត់ ទៅ រក កន្លែង កោស ជប់ លោក តា ម្នាក់ ខ្យល់ គស្លាប់ បាត់
ដំណាក់កាល អ្នក កំពុង នៅ
ប ពិត្រ ព្រះអង្គ ជា សម្មតិ ទេវរាជ ទេវ លោក ទើប ជា ទី រម្មណីយ - ដ្ឋាន សម្រាន្ត ព្រះទ័យ ជាង មនុស្សលោក នេះ ។
ហើយ ចូរ ពួក អ្នក ចូល លំនៅដ្ឋាន តាម ទ្វារ ខាងមុខ របស់ វា ។
ក្មេងប្រុស អត់ ទេ អ្នកគ្រូ !
ព័ត៌មាន តាម អ៊ីម៉ែល ទីផ្សារ ទីផ្សារ អនឡាញ តើ អ្នកណា ជា អ្នកលក់ រាយ ធំ ជាង គេ នៅលើ ពិភពលោក ?
ទៀត ជាមួយនឹង ក្រុម ជនជាតិ ផ្សេង ៗ
ហើយ ទំនាក់ទំនង ដែល អ្នក មាន ជាមួយ អ្នកដទៃ ក៏ ជា គុណសម្បត្តិ ល្អ មួយ របស់ អ្នក ដែរ ។
ជាធម្មតា ថ្ងៃ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជនជាតិ ចិន គ្មាន ការឈប់ សម្រាក ជា ផ្លូវការ នោះ ទេ នៅ កម្ពុជា ។
ទន្ទឹម នេះ អ្នកនាង ផល្លា មិន លាក់ លៀម ទេ ថា នាង មាន មិត្ត ប្រុស ម្នាក់ ជា ជនជាតិ ឥណ្ឌា ។
ខ្ញុំ បាន ប្រាប់ ពួកគេ គ្រាន់តែ ឃុំ ខ្លួនខ្ញុំ ជំនួស បាន ហើយ ។
រឹង រឹតតែ យល់ដឹង ប្រយោជន៍ គឺ សេចក្តីស្ងប់ចិត្ត ក៏ រឹង រឹតតែ ចម្រើន ដូច្នេះ ទើប ពុទ្ធ បរិស័ទ មិន ធុញ ទាន់ នឹង ការក្រេបរស របស់ ព្រះធម៌ ឡើយ ។
