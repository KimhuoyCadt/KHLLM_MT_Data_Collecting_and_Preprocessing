រលក កម្តៅ ខ្លាំង នឹង បណ្តាលឱ្យ មនុស្ស ច្រើន ម៉ឺន នាក់ ស្លាប់
ក្រុមហ៊ុន ដែល បាន ចូលក្នុង ប្រទេស នេះ កាលពី មួយ ទសវត្សរ៍ មុន បាន ចំណាយ ពេល ៥ ឆ្នាំ ដើម្បី រុករក គម្រោង ប្រេង និង ឧស្ម័ន នៅ ឈូង សមុទ្រ ។
បើសិនជា ខ្ញុំ នៅក្នុង ស្ថានភាព របស់ លោក មូឌី វិញ ខ្ញុំ ប្រហែលជា ស្រែក ហៅ ឱ្យ គេ ជួយ ឬ ស្វែងរក ច្រក ចេញ តាម ទ្វារ ក្រោយ ហើយ ។
ស្តាប់ ម្តាយ នារី រងគ្រោះ រៀបរាប់ ពី រឿង កូន របស់ គាត់ ត្រូវ ជន ដៃ ដល់ កាត់ ក្បាល កាលពី ថ្ងៃ មុន មាន វីដេអូ
ប្រសិនជា អ្នក កំពុងតែ រក វិធី មួយ ដែល ងាយស្រួល ហេតុ អ្វី អ្នក មិន ចាប់ផ្តើម នូវ វិធី ខាងក្រោម នេះ ៖
តើ បក្ស កាន់អំណាច និង បក្ស ប្រឆាំង ពិតជា មាន ការលួច ចរចា គ្នា ជា សម្ងាត់ ក្រោយ កើត អំពើហិង្សា មែន ឬ ?
សូម ទាក់ទង មក ពួកយើង ប្រសិនបើ អ្នក ចង់ ពិភាក្សា អំពី របៀប ដែល យើង អាច ជួយ អ្នក ។
ការស្រោច ទឹក គឺ ស្រោច ទឹក ក្នុង មួយ ថ្ងៃ ១ ដង នៅ ពេលព្រឹក រដូវ វស្សា ។
អ្នក ត្រូវតែ មាន អាយុ យ៉ាងតិច ១៣ ឆ្នាំ ដើម្បី ចុះឈ្មោះ ប្រើ ឬ ចូលរួម នៅក្នុង វេទិកា ពិភាក្សា ។
ព្រះអង្គ ជា ព្រះនៃ ឪពុក របស់ ទូល បង្គំ
ខាងក្រោម នេះ គឺជា ការៀបរាប់ អ្នក ទាំង ៤ទាក់ទង នឹង ការរលំអគារមកកាន់ លោក រំដួល ចិត្រា អ្នកកាសែត នៃ សារព័ត៌មាន ថ្មី ៗ
ការពិត ពួកយើង ជា កម្មសិទ្ធអល់ ឡោះ ហើយ ពួកយើង ពិតជា អ្នក វិល ត្រលប់ ទៅកាន់ លោក វិញ
មាន ន័យ ថា ជា មនុស្ស ម្នាក់ ដែល អាច ជា មិត្ត ឬ ជា សត្រូវ របស់ អ្នក កំពុងតែ គំរាមកំហែង នៅក្នុង ជីវិត ។
ដូច បង្ហាញ ក្នុង តារាង ខាងក្រោម របស់ ក្រុមហ៊ុន បច្ចេកវិទ្យា កំពូល ៗ
វេទិកា ការងារ លើក ទី២
តើសល់ សំណុំរឿង ប៉ុន្មាន ទៀត ដែល តុលាការ ទាំង ៣ថ្នាក់ មិន ទាន់ ដោះស្រាយ ចប់ ?
ចំពោះ គ្រីស្ទ បរិស័ទ កម្លាំង នោះ មកពី ព្រះជាម្ចាស់ ។
វា ក៏ មិន មែន ជា រឿង នឹង កើតឡើង ក្នុង ពេល អនាគត ដែរ ព្រោះ វា កំពុងតែ មាន វត្តមាន ក្នុង ពេល បច្ចុប្បន្ន នេះ ឯង ។
នៅនឹង កន្លែង អាន ព័ត៌មាន ។
នេះ នៅ ច្រក ព្រលានយន្តហោះ អន្តរជាតិ ។
ខ្ញុំ សង្ឃឹម ថា រដ្ឋាភិបាល កម្ពុជា នឹង ព្យាយាម ដ៏ ល្អ បំផុត ដើម្បី ការពារ លោក សម រង្ស៊ី ។
ប្តូរ តាម បំណង ប្តូរ តាម បំណង
រហូត ធ្វើអោយ លោក អ៊ិត សេដ្ឋា លែង ដឹងខ្លួន ។
ខ្ញុំ មិន ដែល ចង់ ទៅ កន្លែងណា ផ្សេង ទេ ។
ជាទូទៅ ពេទ្យ គ្មាន ណែនាំ ឱ្យ ប្រើ ថ្នាំ នេះ ជាមួយ ថ្នាំ រៀបរាប់ ខាងក្រោម នេះ ទេ ប៉ុន្តែ មាន ករណី ខ្លះ តម្រូវ ឱ្យ ប្រើ នេះ រួមគ្នា ក្រោយ កែ កម្រិត និង ពេលវេលា ប្រើ ។
ដូច្នេះ រឿង ដំបូង ដែល ត្រូវ ធ្វើ គឺ ការស៊ើប …
ហើយ ច្បាប់ បោះឆ្នោត ច្បាប់ ស្អី ច្បាប់ ស្អី ហ្នឹង គេ បង្ហាញ គាត់ តែ បន្តិច ៗ
រឿង ហ្នឹង ខ្ញុំ អត់ បាន ដឹង អ្វី ទាំងអស់ នៅ ខាងក្រៅ ហ្នឹង ។
អ្នកប្រមាញ់ ត្រូវបាន ប្រាប់ ថា ៖
ការដោះដូរ អ្នកទោស នេះ ដែល ត្រូវបាន បញ្ចាំង តាម ទូរទស្សន៍ រុស្សី មាន កំណត់ ត្រូវ ធ្វើឡើង តាំងពី ដើម សប្តាហ៍ នេះ មក ម្លេះ ។
ថ្វីបើ មិន មាន ការសិក្សា រយៈពេល យូរ ណាមួយ ទៅ លើ ការប្រើប្រាស់ ទូរស័ព្ទ នៅឡើយ តែ អ្នកវិទ្យាសាស្ត្រ ក៏ កំពុងតែ សិក្សា ចំពោះ វា នៅ ឡើយ ។
រាល់ ថ្ងៃ នេះ លោក អ្នក តែងតែ បរិភោគ អាហារ ច្រើន ប្រភេទ ដែល មាន សារៈប្រយោជន៍ ផ្សេង ៗ
ក្រុម ទូកង ទាំងអស់ មុនពេល ចូលរួម ការប្រណាំង
ឬ សូម្បីតែ ឡាន របស់ អ្នក ក្នុង រយៈពេល តែ ២០ វិនាទី ប៉ុណ្ណោះ ។
ដូចនេះ ហើយ ទើប ត្រូវបាន គេ ចាត់ទុក ជា និមិត្ត សញ្ញា នៃ ការចាប់ផ្តើម នូវ អ្វី ៗ
ហេតុ អ្វី ត្រូវ ខ្វាយខ្វល់ អំពី ព្រៃឈើ របស់ កម្ពុជា ?
អាស្រ័យ លើ បរិក្ខា នេះ ពិភពលោក ទាំងមូល អាច ប្រើប្រាស់ ភា សា តែ មួយ រួមគ្នា បាន
នោះ អ្នក គ្រាន់តែ មិន ចាំបាច់ ធ្វើ ការបន្ថែម ស្ករ ទៅក្នុង ទឹកតែ របស់ អ្នក នោះ ទេ ។
សូម រង់ចាំ មើល លទ្ធផល ទៅ ។
ប្រសិនបើ យើង ដាក់ ជំនឿ របស់ យើង លើ ព្រះអង្គ ហើយ ទុកចិត្ត លើ ទ្រង់ ព្រមទាំង ធ្វើ តាម បង្គាប់ របស់ ទ្រង់ នោះ យើង នឹង មាន អំណរ មាន ការស្កប់ ចិត្ត ក៏ ដូចជា មាន ទំនុកចិត្ត ផងដែរ ។
អូចាំ បន្តិច ពួកគេ បាន ធ្វើ រួចហើយ !
តា ម៉ាប់ លើ អាកប្បកិរិយា ក្នុង ការគ្រប់គ្រង ស…
អ្នក ត្រូវ ស្វែងរក ជំនួយ ពី គ្រូពេទ្យ ជាបន្ទាន់ ប្រសិនបើ អ្នក មាន ៖
លោក សំលាង ទ្រី បាន បញ្ជាក់ ផងដែរ ថា ៖
ព្រះសម្ពុលា បាន ស្តាប់ ពាក្យ នោះ ហើយ ទើប ពោល គាថា ទាំងឡាយ ៣ថា
ក៏ប៉ុន្តែ ការសុំ អនុញ្ញាត នោះ ត្រូវបាន បដិសេធ ពីព្រោះតែ យន្តហោះ មួយ ទៀត កំពុង ហោះហើរ ក្នុង តំបន់ នោះ ។
ក្រៅពី នេះ ក៏ រួមបញ្ចូល បទ ពីមុន ៗ
លោក សម រង្ស៊ី កំពុង ស្ថិត នៅក្នុង សហរដ្ឋ អាមេរិក ដើម្បី ទាក់ទាញ អ្នកគាំទ្រ ។
គ្មាន នរណា ម្នាក់ នៅ សេសសល់ ឡើយ ។
អ្នក ដែល កើត ក្នុង ខែមេសា មាន បុគ្គលិក លក្ខណៈ ពិសេស បែប នេះ !
វិទ្យាស្ថាន មិន ទទួលខុសត្រូវ ចំពោះ ការបាត់បង់ ឡើយ ។
តាមកវិញ ឱ្យ មក ចាប់ អាំង ក្លែម ស្រា ហើយ ណា
មាន សាក្សី ច្បាស់លាស់ ដឹង ឮ ហើយ សាក្សី នោះ បាន ផ្តិត មេដៃ លើ ពាក្យបណ្តឹង ។
ការធ្វើ បែប នេះ ជួយ ស្តារ ផ្លូវចិត្ត ឡើងវិញ ផងដែរ ។
គ្មាន អ្នកណា ស្គាល់ ច្បាស់ ក្រៅពី ប្រជាជន ដែល រស់ នៅ ឃុំ សង្កាត់ នោះ ទេ ។
ពេលនេះ វេលា នេះ សំណួរ ចាក់ ស្ត្រេស ពេញ ខួរក្បាល ខ្ញុំ ហើយ តើ ខ្ញុំ គួរ ដោះស្រាយ យ៉ាងម៉េច ទៅ ?
ការ តាម ប្រមាញ់ ទាំង រថយន្ត និង ម៉ូតូ ទំនងជា ធ្វើឱ្យ ចោរ ស្លន់ ក៏ បើក ម៉ូតូ គេច មក តាម ផ្លូវ ក្រោយ ផ្ទះ ដែល បាន ធ្វើ សកម្មភាព ប្លន់ វិញ ។
ដោយសារ ការបោះឆ្នោត ជាតិ កាលពី ឆ្នាំ ២០១៨ មិន បាន ធ្វើឡើង តាម បែប ប្រជាធិបតេយ្យ ។
ចំណែកឯ ប័ណ្ណ ក្រីក្រ របស់ ពួកគេ ដែល អាជ្ញាធរ ចេញ ឱ្យ នោះ ក៏ ត្រូវបាន លុបចោល រួចហើយ ដែរ ។
ផ្ទុយទៅវិញ បើសិនជា ខេត្ត មាន លទ្ធភាព អភិវឌ្ឍ តំបន់ វប៌្បធម នោះ ក៏ កាន់តែ ប្រសើរ ដែរ ៕
ច ថត អូឌីយ៉ូ ប្រសិនបើ តម្រូវការ
ហើយ អ្វី យើង ត្រូវ ពិនិត្យមើល មុន គេ គឺ ៖
តើ អ្នក មានអារម្មន៍ ម៉េច ដែរ ពេល ដែដល ដឹង ថា ត្រី ប្រភេទ នេះ សាហាវ យ៉ាងណា ?
កែវភ្នែក ទាំង គូ របស់ លូអ៊ាន់ ក៏ បិទ លក់ ស្លុង ហើយ ភ្លាម ៗ
ភាសា ដែល ប្រើ ដោយ នាយក រដ្ឋមន្ត្រី និង មេដឹកនាំ បក្ស BJP ដទៃ ទៀត នៅក្នុង យុទ្ធនាការ ឃោសនា បោះឆ្នោត គឺ មាន លក្ខណៈ សមូហភាព ។
គ្មាន ការឈឺចាប់ អ្វី ដែល នឹង ស្ថិតស្ថេរ ជារៀងរហូត ទេ ហើយ គ្មាន ការ អាក្រក់ អ្វី ដែល នឹង មានជ័យជម្នះ នៅ ចុងបញ្ចប់ ឡើយ ។
អ្នក ដែល មាន កើត ក្រួស ក្នុង តម្រងនោម គួរ ប្រើ ភ្ជាប់ ជាមួយ ពួក សារជាតិ ម៉ាញ៉េស្យូម ។
១២ អ្នក រាល់គ្នា ត្រូវ សប្បាយរីករាយ នៅ ចំពោះ ព្រះភក្ត្រ ព្រះអម្ចាស់ ជា ព្រះរបស់ អ្នក រាល់គ្នា រួម ជាមួយ កូនប្រុស កូនស្រី និង អ្នក បំរើ ប្រុស ស្រី ព្រមទាំង ពួក លេវី ដែល រស់ នៅក្នុង ក្រុង ជាមួយ អ្នក រាល់គ្នា ដែរ ដ្បិត ពួក លេវី គ្មាន ទឹកដី ជា ចំណែក មត៌ក ក្នុង ចំណោម អ្នក រាល់គ្នា ទេ ។
មួយ តង់ គេង គ្នា ២នាក់ ភេទ ដូចគ្នា ។
សូម សរសើរ សប្បរស ជន និង ជួយ អបអរសាទរ ដល់ មជ្ឈមណ្ឌលកុមារ កំព្រា !
ពលរដ្ឋ និង សកម្មជន បរិស្ថាន អះអាង ថា …
លោក ថា ប្រសិនបើ គណបក្ស ណាមួយ មិន មក ចូលរួម បន្ទាប់ពី ចប់ សមាជ ពលរដ្ឋ នឹង ដង្ហែ ញត្តិ ទៅ ដាក់ នៅ ទីស្នាក់ការ របស់ គណបក្ស នោះ ទោះបីជា គ្មាន ការអនុញ្ញាតឱ្យ មាន ការដង្ហែ ក្បួន ក៏ដោយ ។
ទាំងនោះ ចូលចិត្ត ទាក់ទង ស្រី ៗ
ពួក អ្នកវិទ្យាសាស្ត្រ បាន ធ្វើ ការតាមដាន លើ ស្ត្រ …
ដូចនេះ ត្រូវ យល់ ឱ្យ ច្បាស់ ក្មេង ល្ងង់ !
ខ្ញុំ នឹង ចងចាំ ជានិច្ច នូវ វិជ្ជាជីវៈ ដែល ខ្ញុំ ទទួលយក បាន សេចក្តីសប្បុរស និង មិត្តភាព ដែល ពួកគេ បាន បង្ហាញ ដល់ ខ្ញុំ ក្នុង អំឡុង ពេល បី ខែ នៅក្នុង ប្រទេស កម្ពុជា នោះ ។
១៥អស់ អ្នក ដែល អង្គុយ នៅក្នុង ក្រុមប្រឹក្សា ជាន់ ខ្ពស់ ទាំង ប៉ុន្មាន សម្លឹងមើល មក លោក ស្ទេ ផាន គ្រប់ ៗ
ហាក់ដូចជា មិន ចេះ ធុញទ្រាន់ សោះ បើ ទោះជា ពួកគេ ធ្លាប់ មើល រឿង ទាំងនោះ រាប់ ភ្លេច ហើយ ក៏ដោយ ។
ពួកយើង បាន ធ្វើឱ្យ គ្រប់ ៗ
ខណៈពេល បួស ជា លោក នេន ពេជ្រ ថៃ នៅតែ គិត រឿង អស់ ទាំងនេះ ទៅដល់ លោកយាយ មាន វីដេអូ
ពេល ខ្ញុំ ដឹង រឿង ភ្លាម ប្រពន្ធ របស់ ខ្ញុំ បាន សុំ ខ្ញុំ លែងលះ គ្នា តែម្តង ។
ប្រហែលជា ទៅ មិន រួច ទេ ដឹង លោក ជាមុន្នី ពីព្រោះ លោក ក៏ ស្ថិត នៅក្នុង មញ្ជី ខ្មៅ របស់ គេ
ជោគជ័យ របស់ អាជីវកម្ម មួយ គឺ កុំ ធ្វើ តាម តែ គ្នា
ដាក់ នៅក្នុង ទូទឹកកក សម្រាប់ 2 ម៉ោង ។
ក៏ សម័យ នោះ ឯង ព្រះវង្គីសៈ មាន អាយុ ទើបតែ នឹង បាន សម្រេច ព្រះអរហត្ត ថ្មី ៗ
ខ្ញុំ ពិតជា មានអារម្មណ៍ សោកស្តាយ ណាស់ ដែល កូនប្រុស ម្នាក់ មាន ឪពុក បែប នេះ ។
បន្ថែម លើ ជំងឺ ដាច់ សរសៃ ឈាម ខួរក្បាល លោក សួស សង វា ចា ក៏ មាន ជំងឺ ទឹកនោម ផ្អែម កម្រិត ធ្ងន់ ផងដែរ ។
លោក ភោគ សាវុធ បាន ឱ្យដឹង ថា ជា លទ្ធផល បង្ក្រាប បាន មាន ដូចជា ៖
មួយចំនួន ទៀត ដែល សមត្ថកិច្ច ស្វែងរក ចាប់ខ្លួន ។
ខ្ញុំ បាន ត្រឹមតែ នៅ ស្ងៀម ហើយ ទឹកភ្នែក ក៏ ហូរ ចេញមករឿយ ៗ
យើង សូម ណែនាំ ដល់ អ្នក នូវ សហគ្រិន ល្បី ៗ
សង្គ្រោះ មាន ន័យ ដូចម្តេច ?
សម្រាប់ មនុស្ស មួយចំនួន គឺ គ្មាន វិធី ណាមួយ ដែល អាច ដោះស្រាយ បញ្ហា នេះ បាន ឡើយ ។
មួយចំនួន ទៀត ដែល កើតឡើង ក្នុង កំឡុង ពេល ប្រឡង ។
អ្នក អាច សម្លឹង មុខ នាង បន្តិច និង ញញឹម ដាក់ នាង ដោយ ភាពរាក់ទាក់ ។
ការទទួលបាន សំណើ ដូច្នេះ ដោយសារតែ ពេល ថ្មី ៗ
ខាងស្តាំ គឺជា សំណង់ អគារ នៅ មុនពេល បាក់ រលំ ។
នេះ ជា សេរីភាព របស់ អ្នកគាំទ្រ ។
បើសិនជា នាង មាន សង្សារ ឬ គូ កំណាន់ ចិត្ត ហើយក៏ អាច ជា ហេតុផល ធ្វើឱ្យ ខ្ញុំ កាត់ចិត្ត ពី នាង ដែរ ។
ហាម ធ្វើ ដាច់ខាត ពេល ទៅដល់ ប្រទេស ទាំងនេះ
ក្រុមប្រឹក្សា រដ្ឋធម្មនុញ្ញ គឺ ដូច តែ គ្នា ។
ដូច្នេះ អតិថិជិន ទាំងអស់ នឹង ចំណាយ កាន់តែ តិច ចំណេញ កាន់តែ ច្រើន ។
លោក សាការី ត្រូវ យាម ទ្វារ ប៉ែក ខាងជើង ។
មាន សុវត្ថិភាព និង ងាយស្រួល ក្នុង ការធ្វើ បោកគក់
ហើយ នោះ ជា កន្លែង ស៊ីឌីអិន អាច ជួយ អ្នក ។
ដ្បិត សាច់ នេះ ជា អាហារ ដ៏ វិសុទ្ធ បំផុត ដែល ព្រះអម្ចាស់ ប្រទាន មក អ្នក រាល់គ្នា ដើម្បី អោយ អ្នក រាល់គ្នា ដកបាប ចេញ ពី សហគមន៍ និង ធ្វើ ពិធី រំដោះ បាប ពួកគេ នៅ ចំពោះ ព្រះភក្ត្រ ព្រះអម្ចាស់ ។
ចូលរួម ក្នុង ដំណើរការ សន្តិភាព ដើម្បី បញ្ចប់ សង្គ្រាម ។
ជាមួយនឹង កូន ប្រសា នៅក្នុង បន្ទប់ទឹក ។
ជាធម្មតា ជនរងគ្រោះ ដោយ ការរំលោភបំពាន គ្រប់ រូបភាព ទាំងអស់ មិន អាច ចងចាំ រឿងរ៉ាវ បាន ពេញលេញ បំភ្លេច រឿងរ៉ាវ នានា ដើម្បី រស់រាន ឬ ក៏ ច្របូកច្របល់ អំពី អ្វី ដែល បាន កើតឡើង ។
ទោះ ទៅដល់ ទីណា ក៏ នៅតែ នឹកឃើញ ដដែល ។
បើ និយាយ ពី ពេលវេលា ជា មធ្យម ដែល អ្នកប្រើប្រាស់ ទូរសព្ទ វិញ គឺ ២ ម៉ោង ៥១នាទី ជារៀងរាល់ ថ្ងៃ ។
នោះ ទ្រង់ នឹង ប្រទាន ឱ្យ អ្នក បាន ដូច បំណង ចិត្ត
ការចាកចេញ របស់ នាង លើក នេះ មិន មាន វត្តមាន ស្វាមី នៅ ជាមួយ ឡើយ ។
ពួកគាត់ កំពុង ចូលរួម រៀបចំ ពិធី ឡើង ផ្ទះ ថ្មី នេះ ។
ការទទួលយក ពួកគេ នឹង ផ្តល់ឱ្យ យើង ស្វែងយល់ ពី កន្លែង ដែល យើង ឈរ នៅក្នុង ទំនាក់ទំនង ជាមួយ ពួកគេ ។
តែ យ៉ាងណា ថ្នាក់ដឹកនាំ អឺរ៉ុប មិន បាន និយាយ ត្រូវ គ្នា ទេ ស្តីពី បេក្ខជន ព្រោះ ម្នាក់ ៗ
ប្រសិនបើ អ្នកស្រឡាញ់ នាង ខ្លាំង មែន នោះ អ្នក នឹង ឱ្យ ព្រះច័ន្ទ ទៅ នាង ។
ពួកគេ មាន ឱកាស ជាច្រើន លើក ប៉ុន្តែ ធ្វើ មិន បាន សម្រេច ។
ដើរ ចាក់ សម្លាប់ មនុស្ស ស្លាប់ យ៉ាងតិច ៤នាក់ មាន វីដេអូ
ដែល ខ្ញុំ បាន ចំឡង ជូន ដល់ អ្នក រាល់គ្នា ផ្ទាល់ ពី រឿង ដែល នឹង ចេញ ក្នុង ពេល យ៉ាងហោចណាស់ ក៏ ប្រាំ ទៅ ប្រាំមួយ ឆ្នាំ ទៀត ដែរ !
តើ ត្រូវ ធ្វើ ដូចម្តេច ដើម្បី គេច ពី បាតុភូត រន្ទះ បាញ់ ពេល មេឃ ងងឹត មុន ភ្លៀង
ប្រសិនបើ អ្នក មិន ប្រព្រឹត្ត អំពើ ផិត ក្បត់ ទេតែ សម្លាប់ គេ នោះ បាន សេចក្តី ថា អ្នកប្រព្រឹត្ត ល្មើស នឹង ក្រឹត្យ វិន័យ ហើយ ។
ជាមួយគ្នា នៅ ទីនេះ ។
អនុវត្ត វិធីសាស្ត្រ ខាងក្រោម នេះ មើល មើល៍ !
នេះ បើ តាម ការលើកឡើង របស់ លោក វ៉ាត់ ចំរើន ។
ប្រសិនបើ អ្នក ទៅ មន្ទីរពេទ្យ មិន ទាន់ ពេល អ្នក នឹង ស្លាប់ ។
លោក បាន ថ្លែង ថា ប្រសិនបើ អស់ លោក ចង់ ធ្វើឱ្យ វាករ ណើនះ ឆេះ រលាយ សាបសូន្យ សូមអញ្ជើញ ដុត ភ្លើង បន្ថែម ទៀត ។
ទំព័រ ដើម សហគ្រិន ភាព អ្នកណា ៗ
លោក បន្ថែម ថា លោក មិន ហ៊ាន អំពាវនាវ ដល់ សប្បុរសជន ឱ្យ ជួយ លោក ទេ ព្រោះ លោក ក្រែងចិត្ត គេ ដោយសារ កន្លងមក លោក ធ្លាប់ តែ ជួយ មិត្ត សិល្បៈ ករ ។
៣ឆ្នាំ បន្ទាប់ពី ចាប់កំណើត ក្រុមហ៊ុន នេះ មាន ផលិតផល ចំនួន ១០០ ប្រភេទ ដែល ជា សម្ភារៈ ទូទៅ
រួម ជាមួយ ខេត្ត នានា ដូច ៖
ប៉ុន្តែ ទោះជា យ៉ាងណា ក៏ យើង នៅតែ បារម្ភ និង បន្ត ការខិតខំ រក ដំណោះស្រាយ បន្ត ទៅ ទៀត លើ បញ្ហា ទាំងនេះ បន្ត ផងដែរ ។
ឃើញ បាក់ គ្រិប ស៊ីម៉ាដាម សាម៉ាឌី !
ប៉ុន្តែ ភស្តុតាង ជាច្រើន បន្ថែម ទៀត បង្ហាញ ថា គោល នយោបាយ នោះ បាន ធ្វើឱ្យ មនុស្ស ជាច្រើន នៅក្នុង តំបន់ ជនបទ ធ្លាក់ ចូលកាន់តែ ជ្រៅ ទៅក្នុង ភាពក្រីក្រ ។
នេះ គឺជា អ្វី ដែល កើតឡើង នៅលើ គណនី បណ្តាញ សង្គម របស់ អ្នក នៅពេល អ្នក លាចាក លោក
ដែល ធ្វើឱ្យ បុគ្គលិក ភាគ ច្រើន មិន សប្បាយ ចិត្ត ។
ដើម្បី បញ្ជប់ ជម្លោះ កាលពី ថ្ងៃទី ៩តុលា ។
មកដល់ ម៉ូសេតែ អស់ ទាំង រឿងរ៉ាវ ណា ដែល តូច ៗ
ចេញមក ក្រៅ នៅ មុនពេល ទឹកនោម ចេញ តែ បន្តិច តែ ប៉ុណ្ណោះ ។
ឡើងវិញ លើក ទី៣ ដោយ មាន បរិមាណ ច្រើន ។
បាន ទទួល ការបំប៉ន យ៉ាង យកចិត្តទុកដាក់ ពី ឪពុក
យោធា អាមេរិក ត្រូវតែ បង្កើន ការប្រើប្រាស់ ឧបករណ៍ វៃ ឆ្លាត
ផ្ទុក ទៅ ដោយ ក្រុម ដែល មាន ទំនាក់ទំនង ទៅនឹង ប៊ូតុង បញ្ជា ។
ឬ បន្លែ ឆៅ សុខចិត្ត ញ៉ាំ ស៊ុប គោ ឆ្នាំង ភ្លើង ក្តៅ ៗ
លួច រថយន្ត ពី ក្រុង មក បុក មនុស្ស ស្លាប់ នៅ ស្រុក ពួក មាន វីដេអូ
អ្នក អាច សម្រេចចិត្ត ថា តើ ក្រោយ ដំឡើង រួច ស្ថាន ឆាក ខាងមុខ ដំណើរការ ភ្លាម ឬ យ៉ាងណា ។
ចូរ ចេញ ទៅ មើល ស្តេច សាឡូម៉ូន ចុះ
ជា ស្វាមី ត្រូវ ជួយ ជ្រោមជ្រែង គាត់ ។
យើង ខិតខំ ប្រឹងប្រែង ដើម្បីឱ្យ គម្រោង នេះ ឈាន ទៅដល់ គោលដៅ ។
យើង ដឹង ថា មនុស្ស គ្រប់ គ្នា ចង់ ប្រើប្រាស់ ទូរស័ព្ទ ទំនើប ។
នេះ តាម ពួក អ្នកជំនាញ ។
ពេលនេះ ខ្ញុំ បន្ត ស្វែងយល់ អំពី កាយ វប្បកម្ម និង ជ្រើសរើស អាហារ ទទួលទាន យ៉ាង សមរម្យ ។
ព្រោះ ពួកគាត់ ពិតជា ទាល់ច្រក ហើយ បើ បែប ៗ
បើ មាន ហិង្សា ណាមួយ កើតឡើង នោះ រដ្ឋាភិបាល ជា អ្នកទទួលខុសត្រូវ
របាយការណ៍ ប្រព័ន្ធ ផ្សព្វផ្សាយ អ៊ីស្រាអែល បាន និយាយ ថា គាត់ ត្រូវបាន គេ ផ្តល់ អត្តសញ្ញាណ បណ្ណ នៅក្នុង ប្រទេស អ៊ីស្រាអែល ក្រោម ច្បាប់ ស្តីពី ការត្រឡប់ មកវិញ ដែល អនុញ្ញាតឱ្យ ជនជាតិ ជ្វីហ្វ ក្លាយជា ពលរដ្ឋ អ៊ីស្រាអែល ។
អាមេរិក សម្តែង ក្តីបារម្ភ បន្ទាប់ពី ច្បាប់ អាជ្ញាសិក ត្រូវ ដាក់ ឱ្យ ប្រើ
តែ តាមពិត មែន ទាំងស្រុង ទេ ពួកគេ មិន ដឹង ថា ធ្វើ យ៉ាងណា ។
មិន ត្រូវ ព្យាយាម ចាប់ កំហុស គ្រប់ ពេលវេលា នោះ ទេ កាលណា សម្រេចចិត្ត ថា ប្រើ ជីវិត រួមរស់ ជាមួយគ្នា ហើយក៏ ត្រូវ ប្រគល់ ការទុកចិត្ត ឱ្យ គ្នា ជឿ ចិត្ត គ្នា ទៅ វិញ ទៅមក ។
លោក ថា ការទម្លាក់ ស្លាក់ ចេញ ពីមុខ ផ្ទះ គឺ ដោយសារ លោក អស់ ជំនឿ ទៅ លើ ការដឹកនាំ របស់ គណបក្ស សម រង្ស៊ី ។
ខ្ញុំ បាន ឈ្នះ លើ ការប្រកែកគ្នា ទាំងអស់ ប៉ុន្តែ ខ្ញុំ ក៏ បាត់បង់ មិត្តភក្តិ ព្រម គ្នា ដែរ ។
ក្តីស្រឡាញ់ ទាំង កំរោល របស់ នាង បាន សម្លាប់ វា ។
វា អាច ធ្វើឱ្យ មនុស្ស ម្នាក់ មាន អារម្មណ៍ ល្អ ប្រសើរ ជា បណ្តោះអាសន្ន ប៉ុន្តែ នៅ ទីបញ្ចប់ វា មិន ដោះស្រាយ បញ្ហា នេះ បាន ទេ ។
កុំ ចង់ សាកល្បង ប្រើ គ្រឿងញៀន សូម្បី ម្តង !
ពេល នោះ មួយ សប្តាហ៍ ពិតជា យូរ សែន យូរ សម្រាប់ ខ្ញុំ ។
គេ កុំ លេង ចូល អោយ សោះ ណា៎ប៉ា យ៉ាត់ ប៉ា យ៉ែងសង្ឃឹម ថា កំពុង បាន
ព្រឹក មិញ នេះ អផ្សុក ពេក ខ្ញុំ ធ្វើដំណើរ លេង ៗ
វា នឹង ជួយ រក្សា ស្បែក របស់ អ្នក អោយ មាន សំណើម គ្រប់ ពេល និង ជួយ ការពារ ស្បែករ ពី ការឆ្លង មេរោគ ផងដែរ ។
រូបរាង ដាក់ ធុង
ដក បញ្ឈរ ជើង មេ គយ តំបន់ ៥ព្រោះ ហេតុផល មួយ
នៅ ខាងឆ្វេង គឺជា កន្លែង ស្នាក់នៅ របស់ កម្មករ ។
អាងទឹក និង ម៉ូតូ សម្រាប់ ក្មេង ជិះ លេង
បក្ស សង្គ្រោះ ជាតិ នឹង ទាមទារ ឱ្យ បោះឆ្នោត ឡើងវិញ បើ គ្មាន ការស៊ើបអង្កេត លទ្ធផល ឆ្នោត
លាងបាប ជម្រះ ឱ្យ អស់ បាប តាម លទ្ធិ ព្រាហ្មណ៍ ជាដើម ។
ជូន ប្រជាពលរដ្ឋ យ៉ាង ច្បាស់លាស់ ។
ត្បិត កាយសម្បទា មិន ល្អ បុរស ម្នាក់ តស៊ូ បើក របរ ចិញ្ចឹម ជីវិត ខ្លួន ឯង មិន ខ្ចី ដើរ សុំ ទាន គេ - បច្ចេកវិទ្យា
លោក មានប្រសាសន៍ ថា តាម ការវិភាគ មួយចំនួន វា មាន លក្ខណៈ ហានិភ័យ ខ្ពស់ ។
