ពិតជា លឿន ហើយ កាន់តែ លឿន អស្ចារ្យ គ្រប់ ទីកន្លែង សម្រាប់ អ្នក ទាំងអស់ គ្នា រៀងរាល់ ថ្ងៃ ជាមួយ សែល កាត ។
ក្រដាស ប្រាក់ វៀតណាម លុយ ដុង ។
លោក ចាស្ពើ រប៉ាវ ៖
ពួកគេ មាន គ្នា រួចហើយ ក៏ ជា អ្វី ដែល ពួកគេ ត្រូវការ ដែរ ។
សាំង គេច ពន្ធ ស្តុក ទុក ពេញ ស្រុក តា ខ្មៅ អ្នកស្រុក ភ័យខ្លាច កើតមាន អគ្គីស ភ័យ
ដោយ ធ្វើជា មន្ត្រី សម្ងាត់ សម្រាប់ CIA ក្នុង អាជីព ភាគ ច្រើន របស់ ខ្លួន នោះ លោកស្រី ហាស្ពែល ក្នុង ឆ្នាំ ២០០២ បាន បម្រើការ ជា ប្រធាន ស្ថានីយ៍ CIA នៅក្នុង ប្រទេស ថៃ កន្លែង ដែល ទីភ្នាក់ងារ នេះ បាន ធ្វើ ការស៊ើបអង្កេត នៅក្នុង គុក សម្ងាត់ មួយ ដោយ ប្រើប្រាស់ វិធីសាស្ត្រ ជាច្រើន រួមទាំង ការចាក់ ទឹក ស្រោច លើ មុខ ។
មួយ ជីវិត មួយ ឥឡូវនេះ រូប បី ជីវិត មួយ អ្វី ៗ
ស្ត្រី នេះ មាន ប្រអប់ ជើង ផ្ងា បញ្ច្រាស ទៅ វិញ
នៅ ពេល នេះ យើង កំពុង ពិនិត្យ អាជ្ញាប័ណ្ណ របស់ គាត់ ដើម្បី បន្ត សុពលភាព ។
កតញ្ញុតាធម៌ ជា គុណធម៌ ដែល សំខាន់ ក្នុង ភាពជា មនុស្ស ។
តើ គេ អាច ធ្វើ ដូចម្តេច ខ្លះ ដើម្បី បង្ការ បញ្ហា រមួលក្រពើ ឬ រមួល សាច់ដុំ ?
សូម មាន សេចក្តីសុខ សុវត្ថិភាព នៅពេល ឈប់ សម្រាក នៅពេល ខាងមុខ ។
បងប្អូន ប្រៀប បីដូចជា ចំហាយ ទឹក ដែល មាន តែ មួយ ភ្លែត រួច ក៏ រសាត់ បាត់ ទៅ ។
ខ្ញុំ បាន មាន គម្រោង ធ្វើ សួន មួយ ទៀត រួច មកហើយ ក្នុង ចិត្ត របស់ ខ្ញុំ នៅ ឆ្នាំ ក្រោយ នេះ ៕
តើ អ្នកណា នឹង ទទួល ផល ចំណេញ អំពី រឿង បែប នេះ កើតឡើង នៅក្នុង ពេល ដែល រាជ រដ្ឋាភិបាល កំពុង និយាយ អំពី សន្តិសុខ និង សុវត្ថិភាព ប្រជាពលរដ្ឋ ?
សម្រាប់ សិស្ស ខ្ជិល ឱ្យ បាន ពិន្ទុ ខ្ពស់ 6នាទី មុន
ផ្ទុយទៅវិញ សមត្តកិច្ចពិសេស លោក សុខ គឹម សាន្ត កាន់តែ មាន បាន ទៅ វិញ ។
ម៉ូអាប់ បោះ ដៃ ដូច គេ បោះ ដៃ ហែលទឹក
ប៉ុន្តែ អ្វី ដែល យើង មិន ត្រូវ ធ្វើ គឺ ការសែនព្រេន ដល់ មនុស្ស ស្លាប់ ថ្វាយបង្គំ នូវ អ្វី ដែល មិន មែន ជា ព្រះពិត ។
នេះ លោក អ្នក ប្រហែលជា អាចនឹង ទទួលបាន ដំណឹង ល្អ ពី សំបុក អាយ ធី ជាក់ ជា មិន ខាន ។
លោក ចនសុន និយាយ ថា ដូច ដែល ច្បាប់ បាន ចែង យើង នឹង ចាកចេញ នៅ ថ្ងៃទី ៣១តុលា ហើយ ខ្ញុំ សង្ឃឹម ថា យើង នឹង ទទួលបាន កិច្ចព្រមព្រៀង មួយ ហើយ ខ្ញុំ គិត ថា អ្វី ដែល ប្រជាជន នៃ ប្រទេស នេះ ចង់បាន គឺ ចង់ ឃើញ សមាជិក សភា មក ធ្វើ ការរួមគ្នា ដើម្បី ផលប្រយោជន៍ ជាតិ ដើម្បី សម្រេច រឿង នេះ ហើយ នោះ គឺជា អ្វី ដែល យើង នឹង ធ្វើ ។
បាន ឈានដល់ ការបំផ្លាញ ជីវិត មនុស្ស ?
ទាំងអស់ ក្នុង ជីវិត កូន ។
ការបោះឆ្នោត ប្រជាធិបតេយ្យ ជា អ្វី ដែល ក្រុម អ្នកនយោបាយ ទន្ទឹងរង់ចាំ ពី រដ្ឋធម្មនុញ្ញ ថ្មី ។
ចំណាត់ការ របស់ ខ្ញុំ កំពុង ដុត ដៃ ដុត ជើង រក មុខ សញ្ញា ហ្នឹង ។
ទិញ ភ្លាម ឈ្នះ ភ្លាម រួសរាន់ ឡើង ៗ
តើ វា ហាក់ដូចជា ពិបាក ណាស់ ដើម្បីឱ្យ គេ ចូលចិត្ត អ្នកលឿន មែន ទេ ?
គ្រប់ គ្នា ដែល ទស្សនា ការប្រកួត បាល់ទាត់ ដឹង ថា វា មាន លក្ខណៈ ពិសេស ។
ប៉ុន្តែ អនុវិស័យ ផ្លូវថ្នល់ ក្នុង ប្រទេស កម្ពុជា នៅតែ មិន មាន ប្រសិទ្ធភាព និង នៅ មាន លក្ខណៈ បែក ខ្ញែក នៅឡើយ ។
ដោយ ពួក ចាប់ផ្តើម ប្តូរ ទម្លាប់ ជីវិត រស់ នៅ របស់ ពួកគេ ។
ចង់ឱ្យ ជួយ ដោះស្រាយ ឱ្យ គាត់ ឱ្យ លឿន គ្នា ក្រ ដោះស្រាយ ឆាប់ ៗ
អញ្ចឹង ខ្ញុំ និយាយ ក្នុង លក្ខណៈ ដែល ខ្ញុំ បាន ធ្វើ ផ្ទាល់ ។
ថ្ងៃអាទិត្យ មួយ នាង បបួល ខ្ញុំ ទៅ វិហារ ។
សុំទោស ចាក ប្រធាន ហើយ ។
ទំព័រ ដើម ហ្វេសប៊ុក សមាជិក ក្រុម សម្រាប់ ការ
ព្រះអង្គ ក្តៅក្រហាយ នឹង ពូជពង្ស
រឃើញ រធវប្ើ ត្រវោ ប្រង
ខ្ញុំ អត់ មាន តួលេខ នៅក្នុង ដៃ ព្រោះថា ខ្ញុំ ជាប់រវល់ បើក ឡាន ។
ដូច្នេះ អ្នក ប្រហែលជា មិន ចង់ ប្រើ ពេលវេលា រួមភេទ ជាមួយគ្នា ទាំង ម្នាក់ ៗ
តែង បំភ្លឺ ប្រាប់ ថា ល្អ និង អាក្រក់ ៕
យើងខ្ញុំ ចង់បាន ឱ្យ ជាតិ មួយ ដែល មាន មាន លទ្ធិ ប្រជាធិបតេយ្យ ពិតប្រាកដ ។
ព្រះអង្គ ក៏ បាន បញ្ជាក់ អោយ ដឹង ផងដែរ ថា សម្តេច ក្រុម ព្រះនរោត្តមរណ ឬទ្ធិ នឹង ធ្វើជា ព្រះរាជ បុត្រ បួស មុខ ភ្លើង តាម ប្រពៃណី ។
កំពូល លេស ទាំង ៤មនុស្ស មិន ចង់ សន្សំ ប្រាក់ តែងតែ ប្រើ ជានិច្ច
វា ពិតជា មិន ចាញ់ កីឡា ប្រដាល់ ម្នាក់ ទេ ។
នៅពេល យន្តហោះ ចុះចត ម្តង ៗ
ប្លក់ គ្មាន ន័យ គេ ស្រដី ថា ឆ្គួត ទៀត ក្រុម ប្រតិបត្តកិារណ៍ ពិសេស
ឥឡូវនេះ គាត់ រងគ្រោះ ដោយសារ អ៊ីចឹង ទៀត ។
នេះ ពួកគេ នៅតែ ឃើញ មាន កើតឡើង នូវ ការ ប្រើប្រាស់ អំពើហឹង្សា មួយចំនួន ។
ទឹកប្រាក់ នេះ ទំនងជា ត្រូវបាន ផ្ទេរ ទៅ ឱ្យ ក្រុមហ៊ុន មួយ …
វា ជា ដំណោះស្រាយ ថ្មី មួយ ទៀត ដើម្បី ជួយ ឱ្យ ធ្មេញ របស់ អ្នកស ។
ហេតុការណ៍ ដែល ធ្វើឱ្យ ខ្ញុំ ចាំ ទុក ក្នុង ចិត្ត
ទាំង នោៈហេុ អ្វី បាន មិន ចេញមក បកស្រាយ ?
គ្រប់ យ៉ាង យើង ធ្វើ គឺ សុទ្ធតែ ដើម្បី មនុស្ស ដែល យើង ស្រលាញ់
អាជាត វា អាច ឆ្លើយ បាន
បោល ទៅដល់ សំនាក់ ដំរី ជា បន្ត ។
ខ្ញុំ មិន ចង់ឱ្យ សាធារណជន វិនិច្ឆ័យ គិលានុបដ្ឋាយិកា ទាំងអស់ តាមរយៈ រូបភាព របស់ ខ្ញុំ នេះ ទេ ។
ប៉ុន្តែ អ្នក ខ្លះ មាន ប្រតិកម្ម បែប នេះ ។
ជាច្រើន ដែល បាន កើតឡើង ក្នុង ពិភពលោក ហើយ រឿង ខ្លះ គ្មាន នរណា ម្នាក់ អាច បកស្រាយ បាន ឡើយ សូម្បីតែ អ្នកវិទ្យាសាស្ត្រ ។
ក្នុង ជីវិត ប្រចាំ ថ្ងៃ សាន សុជាវ ជិរ ប្បញ្ញោ
មាន ភស្តុតាង ជាច្រើន បាន បង្ហាញ នៅ តាម ប្រាង្គ ប្រាសាទ នានា ដែល ព្រះរាជា ក្រោយ បាន ត្រាស់បង្គាប់ អោយ ឆ្លាក់ រូប ព្រះឥសីបញ្ជាន់ លើ រូប ព្រះពុទ្ធ ដែល ជា ស្នាដៃ របស់ ព្រះរាជាមុន ឬ ការផ្លាស់ប្តូ រាជធានី ពី អង្គរ ទៅ កោះ កេរ និង ក្រោយមកពី កោះ កេរ ទៅ អង្គរ វិញ ជាដើម ។
ខ្ញុំ គិត ថា ទុក ឱ្យ ប្រវត្តិសាស្ត្រ ចារ ឈ្មោះ លោក ហ៊ុន សែន ទៅ ។
ល្ងង់ ម្ល៉េះ គ្រាន់តែ អ៊ីចឹង ខឹង អី ?
ឥឡូវនេះ យើង ឱ្យ សហគមន៍ តាមដាន មើល បើ មាន ក៏ រាយការណ៍ មក ។
ពួកគេ មិន ចង់ បាត់បង់ ប្រាក់ ដោយសារ អំពើពុករលួយ ឡើយ ។
ពួកគេ ពុំ បាន ដើរ តាម មាគ៌ា របស់ យើង ហើយក៏ មិន ប្រព្រឹត្ត អំពើ សុចរិត នៅ ចំពោះមុខ យើង មិន កាន់ តាម ច្បាប់ និង វិន័យ របស់ យើង ដូច ដាវីឌ ជា បិតា របស់ សាឡូម៉ូន ឡើយ ។
ខ្ញុំ ឆ្ងល់ ដែរ ហេតុអី ទើប មក សួរ ពេលនេះ ។
មិន តែ ប៉ុណ្ណោះ លោក បាន រិះគន់ យ៉ាង ចំ ៗ
បន្ទាប់មក នឹង រៀបចំ ពី ធី ជប់លាងជា កិត្តិយស ផងដែរ ។
តំបន់ កោះ ហាន ត្រូវបាន សហគមន៍ រៀបចំឡើង ជាង ១ខែ កន្លងមក ហើយ ។
ដូច្នេះ ចាំបាច់ ត្រូវតែ មាន ភាគី ទី បី ហើយ ដើម្បីឱ្យ គេ ជួយ សម្របសម្រួល ។
មកពី អស់ លោក អ្នកនិក ឃើញ តែ ពី ប្រកា់ ខែ
តទៅ នេះ គឺជា វិធីសាស្ត្រ ងាយ ៗ
ការប៉ះទង្គិច មាន រយៈពេល ប្រមាណ ជា ១០នាទី មុន ពេល ដែល វា បាន ស្ងប់ ទៅវិញ ។
សហរដ្ឋ អាមេរិក និង សហភាព អឺរ៉ុប ក៏ បាន ទាមទារ ដូចនេះ ដែរ ។
អ្នក អាច ដើរ ទៅ ធ្វើ ការប្រសិនបើ អាច ធ្វើ ទៅ បាន ។
ការរំខាន ដល់ អ្នកដទៃ ក្នុង ម៉ោង ធ្វើការ គឺ បង្ហាញ ពី ការ មិន គោរព ដល់ ការងារ អ្នកដទៃ ។
ថ្ងៃ នេះ ខ្ញុំ នឹង បង្ហាញ អ្នក ទាំងអស់ គ្នា ពី របៀប តម្លើង បញ្ជី ចាក់ វីដេអូ ផ្សេង ៗ
ពី រឿង ភាពតានតឹង នយោបាយ នេះ លោក សម រង្ស៊ី គឺជា អ្នក ដែល បង្កឡើង សូម មេត្តា យល់ដឹង ផង ។
តែ នៅក្នុង ឆ្នាំ កន្លងទៅ នេះ ជាច្រើន ដង ហើយ ដែល សហរដ្ឋ អាមេរិក បាន រង ការចោទប្រកាន់ គ្មាន មូលដ្ឋាន មិន ត្រឹមត្រូវ និង ខុស ដោយ ចេតនា ។
ខ្ញុំ គិត ថា ហេតុ អ្វី ក៏ ខ្ញុំ មិន បញ្ចូល រូបថត ទាំងនេះ ចូលក្នុង គម្រោង ?
ជូបប្រជុំគ្នា យ៉ាងតិច មួយ ដង ក្នុង មួយ ខែ
លោក លុយ ហាង នាយ ប៉ុស្តិ៍ នគរបាល សង្កាត់ លេខ ២ បាន ឱ្យដឹង ថា រឿង ហេតុ បាន កើតឡើង ២ដំណាក់កាល ។
នោះ ហើយ ដែល គោលដៅ ដ៏ ធំ បំផុត សម្រាប់ ខ្ញុំ ៕
តួកគី និង អឺរ៉ុប ពិភាក្សា ពី ការកើនឡើង ចំនួន ជន ចំណាកស្រុក ទៅ ក្រិក
ចូរ រង់ចាំ មើល ការងារ របស់ លោក ៕
នេះ ហើយ ជា អត្តសញ្ញាណ របស់ យើង ក្នុង ព្រះគ្រីស្ទ ។
វា នឹង ជាប់គាំង រហូត ។
ការចងក្រង ឡើងវិញ ចាប់ ដំណើរការ តាំងពី ឆ្នាំ ២០០៤
ខ្ញុំ ជូនពរ ពួកគេ បាន សុខសប្បាយ ។
អង្គភាព រដ្ឋាភិបាល ប្រតិកម្ម ខ្លាំង ៗ
សំណុំរឿង នេះ កំពុង ជួប បញ្ហា នីតិវិធី ខ្លះ ៗ
ដែល អ្នក រាល់គ្នា បាន សូន ដោយ ដៃ ខ្លួន ឯង
កាលណា ពង និង មេរូប បាន ក្លាយជា សាច់ដុំ មួយ តូច ហើយ វា ចេះតែ រីកចម្រើន ធំ ឡើង មួយ ថ្ងៃ បន្តិច ៗ
ឱ្យ បើក ប្រាក់ បៀវត្សរ៍ ជារៀងរាល់ ខែ ។
ចំនួន ៨ចំណុច នៃ របប គ្រប់គ្រង ថ្មី នេះ ។
សរុប មក អ្នកម្តាយ ភាគ ច្រើន ណាស់ ដែល ជំពាក់ គេ ទៅ តាម ឋានៈ ខ្លួន ៕
សេចក្តីព្យាយាម និង ចិត្ត អំណត់ របស់ លោក ពិតជា គួរឱ្យ គេ កោតសរសើរ ណាស់ ។
កក្រើក យប់ នេះ ផ្តាច់ព្រ័ត្រ ពាន ធំ ៗ
ឆ្ងល់ ថា ការចំណាយ យាង
ដូច្នេះ ខ្ញុំ ទៅ ធ្វើ បុណ្យ ត្រឹម រាប់ បាត នៅ ពេលព្រឹក បាន ហើយ ។
កូន ចៀម និង អស់ អ្នក ដែល ព្រះអង្គ បាន លោះ
ជនជាតិ អេស៊ីប ស្រែក ឡើង ថា ៖
ត្រឹមត្រូវ ភ្ញាក់ ខ្លួន ផង អត់ ចេះ ខ្មាស់ មែន
ម៉ារីណា ញញឹម ពព្រាយ មួយ រំពេច ។
ថ្ងៃ មួយ ជនជាតិ អ៊ីស្រាអែល បាន ចេញ ទៅ ច្បាំង តទល់ នឹង ជនជាតិ ភីលី ស្ទីន ។
