ដើម្បី ត្រួតពិនិត្យ ករណី អ្នកបើកបរសេព គ្រឿងស្រវឹង ។
លោក លឹម ជ្រន និយាយ ថា ពលរដ្ឋ អ្នក ដាំ ម្រេច ឯទៀត ៗ
ទោះជា យ៉ាងណា ខ្ញុំ នៅតែ ចង់ ទៅ រៀន ដោយសារតែ ខ្ញុំ ចង់ ចេះ អាន និង សរសេរ ។
យើង ទុកចិត្ត ដល់ មិត្ត យើង ព្រោះ យើង មាន ទំនុកចិត្ត ថា គេ នឹង ប្រើ ព័ត៌មាន នោះ ជួយ យើង មិន មែន ធ្វើឱ្យ យើង គ្រោះថ្នាក់ ។
ម៉ូតូ បុក កុងតែ ន័រ កំពុង បត់ ចូល ផែ ស្ងួត បាក់ ក ស្លាប់ មួយ រំពេច
ឥឡូវនេះ កំពុង តម្កល់ នៅ វត្តមាន បងប្អូន គេ ចូល បច្ច័យ អី ខ្លះ ហើយ ។
ជាច្រើន ទៀត ជា អ្នក កំណត់ សុខភាព របស់ អ្នក ។
ពីមុន មាន តែ ប៉ុន្មាន តែ ប៉ុណ្ណោះ ។
មនុស្ស ជាច្រើន មិន មាន ការផ្គត់ផ្គង់ ពី គ្រួសារ របស់ ពួកគេ ដូច ដែល មនុស្ស យើង ធ្លាប់ ទទួលបាន កាលពី ៣០ ឬ ៤០ ឆ្នាំ មុន នោះ ទេ ។
គាត់ ឱ្យ យើង តាំង ស្មារតី ឱ្យ ល្អ ។
ប៉ុន្តែ លោក បាន បដិសេធ ចំពោះ ការចោទ ថា លោក ប្រព្រឹត្ត អំពើពុករលួយ ។
លោក ហ៊ុន សែន នៅតែ អះអាង ដដែល ៗ
ម្តាយ ណា មិន រន្ធត់ មកពី ព្រលានយន្តហោះ វិញ …
ទ្រង់ ព្រះសណ្តាប់ឮ សំឡេង ខ្ញុំ
ប្រទេស ម៉ាឡេស៊ី មាន រាជធានី និង រដ្ឋសរុប ចំនួន ៖
ចូរ សិក្សា អំពី ការសើច ចំពោះ ខ្លួន ឯង តែ មិន ត្រូវ ធ្វើអោយ ខ្លាំងក្លា ពេក នោះ ទេ ។
ថៃ កម្មង់ តាម រដូវកាល ។
ដល់ អ្នកដទៃ ដែល កំពុង ជួប នូវ បញ្ហា ។
ជា លក្ខណៈ ប្រពៃណី និង តាម បែប សាសនា ក៏ ចាប់ កកើត ឡើងវិញ បន្តិច ម្តង ៗ
ហេតុ នេះ ហើយ បានជា នាង ក្លាយទៅ
មុន នេះ ប្រភព ពី ឥណ្ឌា បាន ឱ្យដឹង ថា បណ្តា ផលិត
១៧គេ ទូល អង្វរ ព្រះយេស៊ូ អោយ ចាកចេញ ពី ស្រុក ភូមិ របស់ គេ ។
ក្រៅពី នេះ របាយការណ៍ មកពី ក្រុម អ្នក សង្កេតការណ៍ បោះឆ្នោត ជាតិ និង អន្តរជាតិ ដទៃ ទៀត ក៏ មាន ការយល់ឃើញ ដូចគ្នា ដែរ ។
និង មាន តម្លៃ សមរម្យ សារព័ត៌មាន នគរ វត្ត
លោក សម រង្ស៊ី ប្រមាថ យ៉ាង ធ្ងន់ធ្ងរ ដល់ លោក …
៤០ គេ តែង នាំគ្នា ឆបោក យក ទ្រព្យសម្បត្តិ របស់ ស្ត្រី មេម៉ាយ ដោយ ធ្វើ ឫក ជា សូត៌្រធម យ៉ាង យូរ ។
ហើយ ឃាតករ ជា ខ្មាន់ កាំភ្លើង ស្ថិត នៅក្នុង សេរីភាព នៅឡើយ ។
ដារិក - ដួងចិត្ត ខ្លាំង
អនុវត្ត ការអង្គុយ រួច ងើប ធាក់ ។
សារព័ត៌មាន ក្នុង ស្រុក បាន រាយការណ៍ ដោយ ដកស្រង់ ប្រភព ប៉ូលិស ថា លោកស្រី យ៉ូស៊ីណូ និយាយ ថា គាត់ បាន លាក់ សាកសព កាលពី ១០ឆ្នាំ មុន ដោយសារតែ គាត់ មិន ចង់ រើ ចេញ ពី ផ្ទះ ដែល គាត់ បាន ចែករំលែក ជាមួយ ម្តាយ បន្ទាប់ពី ម្តាយ បាន ស្លាប់ ទៅ ។
បញ្ហា នេះ កំពុង ប្រឈម ខ្លាំង ចំពោះ ពលរដ្ឋ ក្រីក្រ ជាពិសេស គឺ ជន ពិការ ។
ប៊ូតុង បិទ បើក ។
្មក ខ្ញំ និង ភរ យាខ្ញំ
ពេល បង្ហាត់ គួរ បង្ហាត់ នៅ ខាងក្រៅ ផ្ទះ ក្នុង អំឡុង ពេល ដែល ធាតុអាកាស ល្អ ត្រជាក់ ស្រួល ។
ក្នុង ពេល ជាមួយគ្នា នេះ បញ្ហា ពន្ធ ដែល ត្រូវបាន បន្សល់ទុក តាំងតែពីរ បប មុន មក ម្ល៉េះ ក៏ ត្រូវបាន ដោះស្រាយ រួចរាល់ ហើយ ដែរ ៕
ស្វាមី លោកស្រី ក៏ បាន បង្ហោះ វីដេអូ មួយ ផងដែរ
ដែល អ្នក រាល់គ្នា ដុត ទាំងមូល ថ្វាយ យើង
ទាំង ១៨ គ្មាន នរណា ចង់ឱ្យ កើតឡើង
ប៉ុន្តែ ជាមួយ វៀតណាម អត់ ឃើញ អនុវត្ត ។
លោក បាន និយាយ ថា នៅក្នុង សង្គ្រាម ឆ្លាតវៃ នា ពេល អនាគត ប្រព័ន្ធ AI នឹង មាន លក្ខណៈ ដូចជា ខួរក្បាល នៃ រាងកាយ មនុស្ស អ៊ីចឹង ។
ដោយឡែក សម្រាប់ ការដំណើរការ ឡើងវិញ នោះ នឹង ជូន ដំណឹង នៅ ពេល ក្រោយ ៕
អចិន្ត្រៃយ៍ អូអូអូ អចិន្ត្រៃយ៍ បិទ
ចំពោះ ខ្ញុំ ខ្ញុំ ដឹងខ្លួនខ្ញុំ ផ្ទាល់ ព្រោះ ខ្ញុំ អត់ ដឹង អី ផង ។
បិន ជីរ៉ូជឺ យល់ព្រម ។
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក កម្វុជ រាជ លក្ឝ្មី អង្គរ ៖
អាយុ ត្រឹម ២៦ ឆ្នាំ ក្លាយជា មហាសេដ្ឋី ក្មេង ជាង គេ បំផុត លើ ពិភពលោក
ប៉ុន្តែ ពួកគាត់ ថា យើង រស់ នៅ ក្រោម មេឃ ណា ត្រូវ គោរព មេឃ ហ្នឹង ។
ត្រៀម ចេញ ដំណើរ ឆ្លង ដែន ទៅ ប្រទេស វៀតណាម
ការធ្វើ បែប នេះ គឺជា ការបន្ទាប តម្លៃ គោលការណ៍ អព្យាក្រឹតភាព របស់ ខ្លួន ។
កងទ័ព ថៃ បដិសេធ ថា មិន បាន សម្លាប់ អ្នកកាប់ ឈើ កម្ពុជា ទាំង ១៥ នាក់ ទេ
មនោសញ្ចេត អ្នក នៅ លីវ នឹង បាន ជួប មនុស្ស ដែល ខ្លួន ស្រឡាញ់ ។
ប៉ុន្តែ ប្រទេស អេហ្ស៊ីប មិន មាន ទាហាន ជើង គោក នៅក្នុង ប្រទេស យេ មែន ទេ ។
ប៉ុន្តែ ខ្ញុំ ឡើង សង្វៀន ដើម្បី បង្ក្រាប ពួកគេ ។
ដល់ ជនជាតិ វៀតណាម ហើយ ប្រាប់ ឱ្យ ពួកគេ ត្រឡប់ ទៅវិញ ។
ខ្ញុំ តែងតែ និយាយ ពាក្យ នេះ ចំពោះ គាត់ ជានិច្ច រៀងរាល់ ថ្ងៃ នៃ ក្តីស្រឡាញ់ នឹង គ្រប់ ពេល ដែល ខ្ញុំ ខល ទៅ គាត់ ។
កុំ បំបោល ក្រែង មិន ដល់ ដូច ប្រាថ្នា ។
ហើយ តាម ការព្យាករ ណ៏ នឹង ត្រូវ ម្តង ទៀត នៅ ចុង ខែមករា
