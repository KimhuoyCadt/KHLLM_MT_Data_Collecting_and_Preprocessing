( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ ពិធី បួងសួង សុំ សេចក្តីសុខ សេចក្តី ចម្រើន សម្រាប់ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ ថោះ បញ្ចស័ក ពុទ្ធ សករាជ ២៥៦៧ ។
ពិធី នេះ ធ្វើឡើង ក្រោម វត្តមាន លោក ញ៉ឹក បាន ខេង អភិបាល រង ខេត្ត និង តំណាង លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ និង មាន ការចូលរួម ពី លោក លោកស្រី ប្រធាន មន្ទីរ ពាក់ព័ន្ធ នានា ជុំវិញ ខេត្ត តំណាង កងកម្លាំង ទាំង៣ ព្រមទាំង មន្ត្រីរាជការ រដ្ឋបាល សាលា ខេត្ត អាចារ្យ គណៈកម្មការ និង អ្នក រៀបចំ ពិធី ចូលរួម ស្ថិត នៅ លោក តា អី ( ជាប់ ផ្ទះ មុខងារ ) និង លោកតា ក្រហម « ក » ។
ក្នុង នាម តំណាង ឱ្យ រដ្ឋបាល ខេត្ត កំពង់ធំ លោក ញ៉ឹក បាន ខេង សូម ឧទ្ទិស និង បួងសួង ដល់ វត្ថុ ស័ក្កសិទ្ធ ក្នុង លោក សូម ជួយ ថែរក្សា និង ប្រោស ព្រំ ដល់ បុគ្គលិក និង ក្រុមការងារ មន្ត្រីរាជការ នៅក្នុង ខេត្ត កំពង់ធំ ទាំងមូល ទទួលបាន នូវ សេចក្តីសុខ សេចក្តី ចម្រើន រកស៊ី មាន បាន ត្រជាក់ ត្រជុំ និង ចៀស ផុត ពី ឧបទ្រព ចង្រៃ នៅក្នុង ឆ្នាំ ចាស់ និង ទទួលបាន លាភ សំណាង គ្រប់ ៗ គ្រួសារ ទាំងអស់ នៅក្នុង ឆ្នាំ ថ្មី នេះ ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា គិត ម៉េង និង ក្រុមគ្រួសារ កំពុង មាន ទុក្ខ ជា ទម្ងន់ ដោយ លោកស្រី គិត ហុង មៀន បង ស្រី បង្កើត ជាទីគោរព ស្រឡាញ់ ដ៏ ជ្រាលជ្រៅ របស់ អ្នក ឧកញ៉ា បាន ទទួលមរណភាព ក្នុង ជុន្មាយុ ៦៦ ឆ្នាំ ដោយ រោគា ពាធ នៅ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៣ នៅ ទីក្រុង កង់ បេរ៉ា ប្រទេស អូស្ត្រាលី ។
សេចក្តី ដូច បាន ជម្រាប ជូន ខាងលើ អ្នក ឧកញ៉ា គិត ម៉េង និង ក្រុមគ្រួសារ សូម គោរព អញ្ជើញ សម្តេច ឯកឧត្តម លោកជំទាវ អ្នក ឧកញ៉ា លោក ឧកញ៉ា លោក លោកស្រី បងប្អូន និង មិត្តភក្តិ ជិត ឆ្ងាយ មេត្តា ជ្រាប និង ចូលរួម ពិធី បូជា សព តាម ការគួរ ។
ការអញ្ជើញ ចូលរួម ក្នុង ពិធី នេះ ជា កិត្តិយស ដ៏ ឧត្តុង្គឧត្តម បំផុត ចំពោះ គ្រួសារ របស់ អ្នក ឧកញ៉ា គិត ម៉េង និង ដើម្បី ចាប់ មគ្គផល និង អនុមោទនា ទទួលបាន អានិសង្ស តាម កម្លាំង សទ្ធា ជ្រះថ្លា ៕ តំណាង ឧប នាយក រដ្ឋមន្ត្រី ប៊ិន ឈិន ដឹកនាំ ប្រតិភូ ចុះ សួរសុខទុក្ខ សំណេះសំណាល និង នាំ អំណោយ ចែកជូន យោធា នៅ កងពល ធំ អន្តរាគមន៍ លេខ ៣ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ
នៅក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក ស្រី ឌឹក មេបញ្ជាការ រង កងទ័ព ជើងគោក និង ជា មេបញ្ជាការ កងពល ធំ អន្តរាគមន៍ លេខ ៣ បាន ថ្លែង នៅ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ វត្តមាន ប្រតិភូ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ដែល បាន ចំណាយ ពេលវេលា ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ មក ចែកជូន កងទ័ព នា ពេលនេះ ។
លោក ថ្លែង ទៀត ថា « កងពល ធំ អន្តរាគមន៍ លេខ ៣ ត្រូវបាន ចង សម្ព័ន្ធ មេត្រីភាព ជាមួយ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី កាលពី ឆ្នាំ ២០១០ តាម ការផ្គូរ ផ្គង ដ៏ ខ្ពង់ខ្ពស់ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា » ប៉ុន្តែ ត្រូវ អាក់ខាន ដំណើរការចុះ សួរសុខទុក្ខ មួយ រយៈ ក្រោយ សម្តេច វិបុល បញ្ញា សុខ អាន បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០១៧ ។
លោក រដ្ឋលេខាធិការ បាន ថ្លែង ពាំនាំ នូវ សេចក្តីនឹករលឹក និង គោរព ដឹងគុណ អស់ ពី ដួងចិត្ត ពីសំណាក់ លោក កិត្តិនីតិកោសល បណ្ឌិត ប៊ិន ឈិន ឧប នាយក រដ្ឋមន្ត្រី ប្រចាំ ការ និង ជា រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ដែល ជានិច្ច ជាកាល លោក តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ កងទ័ព របស់ យើង តាមរយៈ ការផ្តល់ នូវ សម្ភារ គ្រឿង ឧបភោគ បរិភោគ ចែកជូន ដល់ ដៃ បងប្អូន កងទ័ព ជាទីគោរព ស្រឡាញ់ ជារៀងរាល់ ឆ្នាំ ។
ក្នុង នាម ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ដែល ជា សេនាធិការ ផ្ទាល់ របស់ នាយក រដ្ឋមន្ត្រី លោក សូម គោរព ដឹងគុណ មិន អាច បំភ្លេច បាន នូវ ការលះបង់ ប្រឹងប្រែង និង ការដឹកនាំ ដ៍ ឈ្លាសវៃ បំផុត របស់ « សម្តេច តេជោ ដែល ក្នុង ប្រវត្តិសាស្ត្រ របស់ យើង គ្មាន ពីរ ដែល បាន នាំមក នូវ ការអភិវឌ្ឍ គ្រប់ វិស័យ ទាំងអស់ ជាពិសេស សម្តេច បាន នាំមក នូវ សុខ សន្តិភាព ពេញលេញ ជូន ជាតិ និង មាតុភូមិ » ។
លោក ជ្រា សុចិន្តា បាន ថ្លែង ទៀត ថា តាមរយៈ សំណូមពរ លើកឡើង របស់ លោក ឧត្តមសេនីយ៍ ឯក ស្រី ឌឹក . ពេល ត្រឡប់ ទៅវិញ លោក នឹង រាយការណ៍ ជូន លោក ឧប នាយក រដ្ឋមន្ត្រី ប៊ិន ឈិន ឱ្យ បាន ជ្រាប ។
លោក រដ្ឋលេខាធិការ ក៏ បាន ថ្លែង លើកឡើង ជម្រាប ជូន នាយ និង ពល ទាហាន ពី ព្រឹត្តិការ ធំ ៗ ពីរ ដែល នឹង កើតឡើង ក្រោយ ពិធី បុណ្យ ចូល ឆ្នាំ ខ្មែរ រួច រួម មាន៖
* ទី ១៖ ព្រឹត្តិការណ៍ ស៊ីហ្គេម ដែល យើង ខកខាន ៦៤ ឆ្នាំ មកហើយ *ទី ២៖ ព្រឹត្តិការណ៍ រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ នៃ រដ្ឋសភា នា ខែកក្កដា ខាងមុខ នេះ ដែល ព្រឹត្តិការណ៍ ដ៍ ធំ អស្សច្ចារ្យ ទាំង ពីរ នេះ គឺ បាន មក ដោយ ប្រទេស យើង មាន សុខ សន្តិភាព ស្ថិរភាព និង សុវត្ថិភាព ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
ជាមួយគ្នា នេះ លោក ជ្រា សុចិន្តា បាន ថ្លែង អំពាវនាវ ដល់ នាយ និង ពល ទាហាន ទាំងអស់ ត្រូវ ចូលរួម ការពារ សុខ សន្តិភាព ស្ថិរភាព ជូន ជាតិ មាតុភូមិ ឱ្យ នៅ ស្ថិតស្ថេរ គង់វង្ស យូរអង្វែង ដើម្បីឱ្យ ប្រទេសជាតិ យើង កាន់តែ អភិវឌ្ឍ រីកចំរើន គ្រប់ វិស័យ ថែម ទៀត ។
សូម បញ្ជាក់ ថា អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ ដែល ទីស្តីការណគៈ រដ្ឋមន្ត្រី នាំ មក ចែកជូន នាយ និង ពល ទាហាន នា ពេលនេះ រួម មាន៖ មីជាតិ ចំនួន ១០០០ កេស ត្រីខ ចំនួន ៥០ កេស ធំ ឆៃ ប៉ូវ ផ្អែម ចំនួន ៥០០ គីឡូក្រាម ទឹកត្រី ចំនួន ២០០ យួរ ទឹកក្រូច ចម្រុះ ចំនួន ១០០ កេស និង ទឹក សីវ អ៊ីវ ចំនួន ២០០យួរ ផងដែរ ៕
នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត៖ ការរៀបចំ មណ្ឌល អភិវឌ្ឍន៍ យោធិន ពិការ នៅ ទូទាំង ប្រទេស ជា គោល នយោបាយ របស់ រដ្ឋាភិបាល ដើម្បី លើកស្ទួយ ជីវភាព រស់ នៅ យោធិន ពិការ និង ក្រុមគ្រួសារ
នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា ជានិច្ច ជាកាល សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តែង យកចិត្តទុកដាក់ និង គិតគូរ អំពី សុខ ទុក្ខ របស់ អ៊ុំ ពូ មីង យោធិន ពិការ ដែល បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការកសាង ស្នាដៃ និង គុណ បំណាច់ ជូន ជាតិ មាតុភូមិ ប្រកបដោយ ទឹកចិត្ត ស្នេហាជាតិ . ការលះបង់ និង ពលិកម្ម គ្រប់ បែបយ៉ាង ក្នុង ការប្រយុទ្ធ ការពារ ជាតិ និង ប្រជាជន កម្ពុជា ប្តូរ យក សន្តិភាព ធ្វើឱ្យ ប្រជាជនរស់ ក្នុង សេចក្តីសុខសាន្ត និង ការអភិវឌ្ឍ រីកចម្រើន ដូច សព្វ ថ្ងៃ ។
ទន្ទឹមនឹង នេះ ដែរ នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន យកចិត្តទុកដាក់ ខ្ពស់ លើ វិស័យ ពិការភាព ដោយ បាន ដាក់ចេញ និង អនុវត្ត គោល នយោបាយ នានា ដើម្បី លើកកម្ពស់ ជីវភាព និង សុខុមាលភាព របស់ អ៊ុំ ពូ មីង យោធិន ពិការ សំដៅ ធ្វើ យ៉ាងណា ជួយ ដល់ អ៊ុំ ពូ មីង និង ក្រុមគ្រួសារ ឱ្យ ទទួលបាន កិត្តិយស . សេចក្តីថ្លៃថ្នូរ . គុណភាព ជីវិត ល្អ ប្រសើរ . គ្មាន ការរើសអើង និង ទទួលបាន សេវា សង្គម និង សេវា សាធារណៈ ប្រកបដោយ ភាពអនុគ្រោះ ។
( បន្ទាយមានជ័យ ) ៖ នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក នៅ ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ប្រកាស តែងតាំង ផ្លាស់ប្តូរ មុខតំណែង ជូន នាយ ទាហាន « មណ្ឌល អភិវឌ្ឍន៍ យោធិន ពិការ ៣១៧ តេជោ ភ្នំ ឆត្រ កងទ័ព ជើងគោក » ។
គណៈកម្មការ ផ្សារ ចាក់អង្រែ និមន្ដ ព្រះសង្ឃ សូត្រ មន្ត លើក រាសី ជូនពរ ជ័យ ដល់ បងប្អូន អាជីវករ ក្នុង ឱកាស អបអរសាទរ ចូល ឆ្នាំ ថ្មី
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ លោក គាត តូ ប្រធាន គណៈកម្មការ ផ្សារ ចាក់អង្រែ បាន រៀបចំ និមន្ត ព្រះសង្ឃ សូត្រ មន្ត ប្រោស ព្រហ្ម ដេីម្បី សុំ សេចក្តីសុខ សេចក្តី ចម្រើន ជូន ដល់ លោក - លោកស្រី អនុប្រធាន មន្ត្រី បុគ្គលិក សន្តិសុខ រួមទាំង បងប្អូន អាជីវករ ផ្សារ ចាក់អង្រែ ទាំងអស់ និង ប្រជាពលរដ្ឋ ដែល ចេញ ចូល ទិញ ទំនិញ នៅ ផ្សារ ចាក់អង្រែ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ និង ទទួល ទេវតា ឆ្នាំ ថ្មី ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៦ ។
លោក គាត តូ បាន បន្ត ថា ជារៀងរាល់ ឆ្នាំ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ និង ទទួល ទេវតា ព្រះនាម កិមិ រា ទេវី ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៦ លោក ព្រមទាំង គណៈកម្មការ ផ្សារ តែងតែ ជួបជុំគ្នា និមន្ដ ព្រះសង្ឃ បង្សុកូល ដើម្បី កាត់ផ្ដាច់ នូវ រាល់ ឧបទ្រព ចង្រៃ នៅក្នុង ឆ្នាំ ចាស់ ចាប់ យក សិរី សួរ ស្ដី នៅក្នុង ឆ្នាំ ថ្មី ឱ្យ ពរ ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ ជូន អាជីវករ ប្រជាពលរដ្ឋ នា ឱកាស ឆ្នាំ ថ្មី នេះ ។
( ភ្នំពេញ ) ៖ ម្ចាស់ ផ្សារ បាយ័ន បាន បរិច្ចាគ ថវិកា ចំនួន ១០លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ម្ចាស់ ផ្សារ បាយ័ន តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ របស់ កងទ័ព បាន គូសបញ្ជាក់ ថា « ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ម៉ោង ៤៖៣៥ ទាប ភ្លឺ ថ្ងៃពុធ នេះ ( ម៉ោង ក្នុង តំបន់ ) ។ ពេលនេះ ក្រុម ប្រតិកម្ម រហ័ស របស់ បន្ទាយ យោធា កំពុង ធ្វើ សកម្មភាព ខណៈ ទីតាំង កើត ហេតុ ត្រូវបាន ហ៊ុមព័ទ្ធ និង បិទ ជិត ។ ប្រតិបត្តិការ រុករក ជន បង្ក កំពុង ប្រព្រឹត្តទៅ ស្រប ពេល ព័ត៌មាន លម្អិត បន្ថែម កំពុង ត្រូវបាន ផ្ទៀងផ្ទាត់ ឱ្យ ច្បាស់លាស់ » ។
គួរ បញ្ជាក់ ថា បន្ទាយ យោធា ខាងលើ នេះ មាន ចម្ងាយ ប្រហែល ២៨០ គីឡូម៉ែត្រ ភាគ ពាយព្យ នៃ ទីក្រុង ញូវ ដេលី គឺ បម្រើ ជា មូលដ្ឋាន ទ័ព ផង និង ជា កន្លែង ស្នាក់នៅ របស់ គ្រួសារ ទាហាន ផង ៕
រសៀល នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ បិទ សន្និបាត ក្រសួង អប់រំ យុវជន និង កីឡា
( ភ្នំពេញ ) ៖ នៅសៀល ថ្ងៃពុធ ទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ចាស់ និង លើក ទិសដៅ ការងារ ឆ្នាំ ថ្មី របស់ ក្រសួង អប់រំ យុវជន និង កីឡា ។ ពិធី នេះ ប្រារព្ធ ធ្វើឡើង នៅ សាល សន្និសីទ វិទ្យាស្ថាន បច្ចេកទេស កម្ពុជា ។
ខាងក្រោម នេះ ជា សមិទ្ធផល ការងារ សំខាន់ ៗ ដែល ក្រសួង អប់រំ យុវជន និង កីឡា សម្រេចបាន ក្នុង ឆ្នាំ សិក្សា ២០២១ - ២០២២ កន្លងទៅ៖
គិត ត្រឹម ឆ្នាំ សិក្សា ២០២២ - ២០២៣ សាលា មត្តេយ្យ សិក្សា និង គ្រឹះស្ថាន សិក្សា ចំណេះ ទូទៅ ទាំង សាធារណៈ សហគមន៍ និង ឯកជន សរុប ១៨. ៨៣០ ក្នុង នោះ ក្នុង នោះ សាលា មត្តេយ្យ សិក្សា គ្រប់ រូបភាព ៨.៦០៧ សាលា សាលា បឋមសិក្សា ៨.០៦៧ សាលា អនុវិទ្យាល័យ ១.៣៤០ សាលា និង វិទ្យាល័យ ៨១៦ សាលា ។
គ្រឹះស្ថាន អប់រំ បច្ចេកទេស និង វិជ្ជាជីវៈ មាន ចំនួន ១៩កន្លែង មាន សិស្ស សរុប ៣. ២៥៩ នាក់ ស្រី ៣៥.៦ភាគរយ និង គ្រឹះស្ថាន ឧត្តម សិក្សា ទូទាំង ប្រទេស មាន ១៣២ ក្នុង នោះ គ្រឹះស្ថាន ឧត្តម សិក្សា សាធារណៈ ៤៨ និង ឯកជន ៨៤ ដែល មាន ទីតាំង ស្ថិត នៅ ២០ រាជធានី ខេត្ត ។ និស្សិត កំពុង សិក្សា នៅ ឧត្តម សិក្សា សរុប ២០៥. ៦៣៦ នាក់ ស្រី ៤៧. ៥ភាគរយ ។
២៖ ការងារ អភិវឌ្ឍ យុវជន
ក្រសួង បាន ពង្រីក រចនាសម្ព័ន្ធ ក្រុមប្រឹក្សា អភិវឌ្ឍ យុវជន ៣៣ ក្រសួង ស្ថាប័ន និង ២៥ រាជធានី ខេត្ត ដែល ជា យន្តការគាំទ្រ និង ជា ផែនទី បង្ហាញ ផ្លូវ ដើម្បី ប្រមូលផ្ដុំ កម្លាំង ចូលរួម ពី គ្រប់ អ្នក ពាក់ព័ន្ធ និង ការយកចិត្តទុកដាក់ លើ ការអភិវឌ្ឍ យុវជន ។
ក្រសួង បាន សិក្សា ស្រាវជ្រាវ និង បោះពុម្ព ផ្សព្វផ្សាយ « សន្ទស្សន៍ ស្តីពី ការអភិវឌ្ឍ យុវជន កម្ពុជា ». « របាយការណ៍ ស្តីពី ការវិភាគ ស្ថានភាពយុវជន កម្ពុជា » ព្រមទាំង បាន បង្កើត ប្រព័ន្ធ ព័ត៌មាន គ្រប់គ្រង យុវជន និង កម្មវិធី ក្នុង ទូរស័ព្ទ វៃឆ្លាត មាន ឈ្មោះ ថា « សុខភាព យុវជន » ដើម្បី ជា មូលដ្ឋាន ទទួល ព័ត៌មាន អំពី តម្រូវការ យុវជន នៅ តាម ក្រសួង ស្ថាប័ន ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ដៃគូ អភិវឌ្ឍ អង្គការ សង្គម ស៊ីវិល វិស័យ ឯកជន និង គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ។
ក្រសួង បាន ធ្វើ វិសោធនកម្ម ធម្មនុញ្ញ និង បទបញ្ជា ផ្ទៃក្នុង របស់ កាយ រឹទ្ធិជាតិ កម្ពុជា តាមរយៈ ការរៀបចំ មហាសន្និបាត កាយ រឹទ្ធិជាតិ កម្ពុជា និង បាន រៀបចំ ផែនការ យុទ្ធសាស្ត្រ កាយ រឹទ្ធិជាតិ កម្ពុជា ឆ្នាំ ២០២៣ - ២០២៧ ។
ក្រសួង បាន បណ្តុះបណ្តាល បំណិន សតវត្សរ៍ ទី ២១ ដល់ យុវជន បាន ចំនួន ៤៨. ៥៦៧ នាក់ ស្រី ៤៩ ភាគរយ ក្នុង គោលដៅ ផ្តល់ ជំនាញ មួយ យ៉ាងតិច ប្រចាំ ជីវិត ដល់ យុវជន ។
៣៖ ការងារ អប់រំ កាយ និង កីឡា
ក្រសួង បាន រៀបចំ ការប្រកួត កីឡា ជាតិ លើក ទី៣ និង ការប្រកួត កីឡា ជន ពិការ ជាតិ លើក ទី១ ប្រកបដោយ ជោគជ័យ ។ ក្រសួង បាន សហការរៀបចំ ការប្រកួត កីឡា ជា លក្ខណៈ អន្តរជាតិ នៅក្នុង ប្រទេស លទ្ធផល កម្ពុជា ទទួលបាន មេដាយ មាស ៣គ្រឿង . មេដាយ ប្រាក់ ៣គ្រឿង . និង មេដាយ សំរឹទ្ធិ ១៣ គ្រឿង ។ ក្រសួង បាន បញ្ជូន កីឡាករ ទៅ ចូលរួម ការប្រកួត កីឡា លក្ខណៈ អន្តរជាតិ នៅ ក្រៅ ប្រទេស លើ ៤៥ ប្រភេទ កីឡា និង ទទួលបាន មេដាយ ១.៣៧០ គ្រឿង ក្នុង នោះ មេដាយ មាស ៣២៦ គ្រឿង . មេដាយ ប្រាក់ ៣៦៣ គ្រឿង . និង មេដាយ សំរឹទ្ធិ ៦៨១ គ្រឿង ។
ចំពោះ ការចូលរួម ប្រកួត ជើងឯក ពិភពលោក កម្ពុជា ទទួលបាន មេដាយ មាស ៣៩ គ្រឿង . មេដាយ ប្រាក់ ៥២ គ្រឿង . និង មេដាយ សំរឹទ្ធិ ៦៥ គ្រឿង ។ ការប្រកួត ជើងឯក អាស៊ី កម្ពុជា ទទួលបាន មេដាយ មាស ៧៧ គ្រឿង . មេដាយ ប្រាក់ ៧៧ គ្រឿង . និង មេដាយ សំរឹទ្ធិ ១២៧ គ្រឿង ៕
សមត្ថកិច្ច កម្ពុជា បន្ត ទទួលបាន បណ្តឹង ១ករណី ទៀត ដែល ស្នើ ឱ្យ ជួយសង្គ្រោះ ជនជាតិ វៀតណាម ១នាក់
បើ តាម អ្នកនាំពាក្យ បច្ចុប្បន្នភាព ស្រាវជ្រាវ តាម បញ្ជី តាមដាន គិត ត្រឹម ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០២៣ រួម មាន៖
១៖ សំណើ ក្នុង បញ្ជី តាមដាន របស់ សម្តេច ក្រឡាហោម សរុប ៨៣៥ ករណី មាន មនុស្ស ២. ០៩៨នាក់ ២៖ បាន ស្រាវជ្រាវ ស៊ើបអង្កេត បឋម ៨០២ សំណើ និង បិទ សំណុំរឿង ២៧៤ សំណើ ( រកឃើញ មនុស្ស ១. ២១៦ នាក់ . ឃាត់ខ្លួន ជនសង្ស័យ ១២៩ នាក់ . បិទ ក្រុមហ៊ុន ៥ទីតាំង . និង ផ្អាក អាជីវកម្ម ក៏ ដូចជា ស្រាវជ្រាវ ក្រុមហ៊ុន ៤ទីតាំង ) ៣៖ កំពុង បន្ត បើក ប្រតិបត្តិការ ស្រាវជ្រាវ និង ស៊ើបអង្កេត ៣៣ ករណី ៕
សម្ដេច តេជោ ហ៊ុន សែន៖ រាជ រដ្ឋាភិបាល នឹង បន្ត ផ្តល់ ឤទិភាព ក្នុង ការជ្រើសរើស និង បណ្តុះបណ្តាល គ្រូបង្រៀន (Video inside) ( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល នឹង បន្ត ផ្តល់ ឤទិភាព ក្នុង ការជ្រើសរើស និង បណ្តុះបណ្តាល គ្រូបង្រៀន ដើម្បី បំពេញ បន្ថែម នូវ តម្រូវការ គ្រូបង្រៀន ប្រកបដោយ គុណភាព ។
ការថ្លែង បែប នេះ របស់ សម្តេច តេជោ ហ៊ុន សែន គឺ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ចាស់ និង លើក ទិសដៅ ការងារ ឆ្នាំ ថ្មី របស់ ក្រសួង អប់រំ យុវជន និង កីឡា នា រសៀល ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នៅ សាល សន្និសីទ វិទ្យាស្ថាន បច្ចេកទេស កម្ពុជា ។
លោក ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា ក៏ បាន ឱ្យដឹង ដែរ ថា ក្រសួង អប់រំ បាន រៀបចំ គោលការណ៍ នៃ ការគ្រប់គ្រង ធនធាន មនុស្ស និង ដាក់ ឱ្យ អនុវត្ត សេចក្តីណែនាំ ស្តីពី និយាម ប្រើប្រាស់ បុគ្គលិក ដើម្បី ដោះស្រាយ បញ្ហា លើស ខ្វះ គ្រូបង្រៀន និង ពង្រាយ គ្រូបង្រៀន ឱ្យ ដល់ កន្លែង ខ្វះ គ្រូ និង បាន បញ្ចូល គ្រូ ខ្មែរ ឥស្លាម ១. ៤៤១ នាក់ និង គ្រូ ជនជាតិ ដើម ភាគ តិច ២០ នាក់ ទៅក្នុង ក្របខណ្ឌ រដ្ឋ ៕
< លោក ស៉ី ជិន ពី ង៖ កងកម្លាំង យោធា ចិន ចាំបាច់ ត្រូវ ពង្រឹង ការហ្វឹកហាត់ ដែល ផ្តោត លើ ស្ថានភាពប្រយុទ្ធ ជាក់ស្តែង
( ប៉េកាំង ) ៖ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ចិន CCTV នៅ ថ្ងៃពុធ នេះ បាន រាយការណ៍ ថា ប្រធានាធិបតី ចិន លោក ស៉ី ជិន ពីង បាន អំពាវនាវ ឱ្យ កងកម្លាំងប្រដាប់អាវុធ របស់ ប្រទេស ចិន ត្រូវ ពង្រឹង កាន់តែ ខ្លាំង ថែម ទៀត នូវ ការហ្វឹកហាត់ យោធា ដែល ផ្តោត ទៅ លើ ស្ថានភាពប្រយុទ្ធ ជាក់ស្តែង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃពុធ ទី ១២ ខែមេសា ឆ្នាំ ២០២៣ ។
យោង តាម CCTV ការធ្វើ អត្ថាធិប្បាយ ដូច ខាងលើ របស់ លោក ស៉ី ត្រូវបាន ធ្វើឡើង កំលុង ដំណើរទស្សនកិច្ច ចុះ ពិនិត្យ កងទ័ព ជើងទឹកចិន កាលពី ថ្ងៃអង្គារ សប្តាហ៍ នេះ ។ នា ពេល នោះ លោក ប្រធានាធិបតី ចិន ក៏ បាន បន្ថែម ផងដែរ ថា កងកម្លាំង យោធា ត្រូវតែ ការពារ ឱ្យ មុតមាំ នូវ អធិបតេយ្យ បូរណភាព ទឹកដី និង ផលប្រយោជន៍ ដែន សមុទ្រ របស់់ ប្រទេស ចិន ។
គួរ បញ្ជាក់ ថា នៅ ដើម សប្តាហ៍ នេះ យោធា ចិន ទើបតែ បាន បិទ បញ្ចប់ ការធ្វើ សមយុទ្ធ យោធា ទ្រង់ទ្រាយ ធំ រយៈពេល ៣ ថ្ងៃ ក្រោម គោលដៅ កំញើញ តៃវ៉ាន់ ។ ភាពតានតឹង បាន កើនឡើង គួរឱ្យ កត់សម្គាល់ នៅក្នុង តំបន់ បន្ទាប់ពី ការដំឡើង សាច់ដុំ យោធា របស់ ទីក្រុង ប៉េកាំង ដែល ចាត់ទុក តៃវ៉ាន់ ជា ផ្នែក មិន អាច កាត់ផ្តាច់ បាន នៃ ទឹកដី របស់ ប្រទេស ចិន ។ ចិន បាន បើក ការធ្វើ សមយុទ្ធ យោធា នោះ ដើម្បី ឆ្លើយតប ចំពោះ ជំនួប រវាង មេដឹកនាំ កោះ តៃវ៉ាន់ ហើយនិង ប្រធាន សភា តំណាងរាស្រ្ត អាមេរិក នៅ រដ្ឋ កាលីហ្វរញ៉ា កាលពី សប្តាហ៍ មុន ៕
អនុ រដ្ឋមន្រ្តី ការបរទេស អ៊ុយក្រែន បញ្ចប់ ទស្សនកិច្ច នៅ ឥណ្ឌា ដោយ ស្នើសុំ ជំនួយ មនុស្សធម៌ និង ការគាំទ្រ ផ្នែក ការទូត
( ញូ ដេលី) ៖ នៅ ថ្ងៃពុធ នេះ អនុ រដ្ឋមន្រ្តី ការបរទេស អ៊ុយក្រែន បាន បិទ បញ្ចប់ ទស្សនកិច្ច រយៈពេល ៤ ថ្ងៃ របស់ ខ្លួន នៅក្នុង ប្រទេស ឥណ្ឌា បន្ទាប់ពី បាន អំពាវនាវ សុំ ជំនួយ មនុស្សធម៌ រួមទាំង ការគាំទ្រ ផ្នែក ការទូត ពី ទីក្រុង ញូដេលី ដែល មកទល់ ពេលនេះ បាន បន្ត ចៀសវាង ថ្កោល ទោស ការឈ្លានពាន របស់ រុស្ស៉ី នៅ អ៊ុយក្រែន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃពុធ ទី ១២ ខែមេសា ឆ្នាំ ២០២៣ ។
គួរ បញ្ជាក់ ថា ចំណង ទាក់ទង ផ្នែក សន្តិសុខ ដ៏ យូរអង្វែង របស់ ឥណ្ឌា ជាមួយ រុស្ស៉ី បាន ធ្វើឱ្យ ទីក្រុង ញូដេលី ស្ថិត ក្នុង ជំហរ លំបាក មួយ ហើយ ស្រប ពេល ដែល ឥណ្ឌា បាន អំពាវនាវ ឱ្យ បញ្ចប់ អរិភាព ទាំងអស់ នៅ អ៊ុយក្រែន ឥណ្ឌា នៅតែ មិន ថ្កោល ទោស ចំ ៗ លើ ការឈ្លានពាន នោះ ឡើយ ។ ម៉្យាង វិញ ទៀត ឥណ្ឌា ក៏ កំពុង បង្កើន ការទិញ ប្រេង បញ្ចុះ តម្លៃ ពី រុស្ស៉ី ផងដែរ បើ ទោះបីជា ត្រូវបាន លោក ខាងលិច ទទូច ឱ្យ ជួយ កាត់ផ្តាច់ ប្រភព ចំណូល របស់ ទីក្រុង មូស្គូ ក៏ដោយ ៕
ការកោតស សើរ បែប នេះ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅសៀល ថ្ងៃពុធ ទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ចាស់ និង លើក ទិសដៅ ការងារ ឆ្នាំ ថ្មី របស់ ក្រសួង អប់រំ យុវជន និង កីឡា ។ ពិធី នេះ ប្រារព្ធ ធ្វើឡើង នៅ សាល សន្និសីទ វិទ្យាស្ថាន បច្ចេកទេស កម្ពុជា ។
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើ យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ សូម កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ អង្គ សន្និបាត អប់រំ ដែល បាន ដំណើរការ ដោយ រលូន និង ទទួលបាន សមិទ្ធផល គួរ ជា ទី មោទនៈ លើ ការងារ អប់រំ អភិវឌ្ឍ យុវជន និង ការអប់រំ កាយ និង កីឡា ដោយ បាន ពិនិត្យ ឡើងវិញ នូវ សមិទ្ធផល សម្រេចបាន ក្នុង រយៈពេល ១០ឆ្នាំ កន្លងមក តាមរយៈ ការអនុវត្ត ការកែទម្រង់ ជា បន្តបន្ទាប់ ... !» ។
ជាមួយគ្នា នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ក៏ ដូចជា វឌ្ឍនភាព សម្រេចបាន ក្នុង ឆ្នាំ សិក្សា កន្លងមក ព្រមទាំង បាន ដាក់ចេញ នូវ អាទិភាព ៨ ចំណុច សម្រាប់ ទិសដៅ ការងារ នា ពេល ខាងមុខ ឱ្យ កាន់តែ ស៊ីជម្រៅ ស្រប តាម បរិការណ៍ ថ្មី ៗ នៃ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ទាំង ក្នុង តំបន់ និង ពិភពលោក ជាពិសេស ក្នុង ខណៈ ដែល កម្ពុជា កំពុង រក្សា បាន នូវ សុខ សន្តិភាព ពេញលេញ ស្ថិរភាព នយោបាយ និង ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច ព្រមទាំង បាន ឆ្លើយតប ទៅនឹង ចក្ខុវិស័យ កម្ពុជា នៅ ឆ្នាំ ២០៣០ និង ឆ្នាំ ២០៥០ ។
ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បន្ត ថា សមិទ្ធផល ដែល ទទួលបាន ពិតជា បាន ស្តែង ចេញពី កិច្ច ខិតខំ ប្រឹងប្រែង និង កិច្ចសហការ យ៉ាង ស្អិត រមួត របស់ ថ្នាក់ដឹកនាំ បុគ្គលិក អប់រំ គ្រប់ លំដាប់ថ្នាក់ លោកគ្រូ អ្នកគ្រូ មាតាបិតា សហគមន៍ និង ឤជ្ញាធរដែនដី ក្នុង ការអភិវឌ្ឍ វិស័យ អប់រំ ឱ្យ មាន ការរីកចម្រើន ទៅ មុខ ស្រប តាម តួនាទី និង ភារកិច្ច រៀង ៗ ខ្លួន ជាមួយនឹង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បន្ថែម យ៉ាង ដូច្នេះ ថា៖ « ជាមួយគ្នា នេះ ខ្ញុំ សូម អរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ដៃគូ អភិវឌ្ឍ អង្គការ ជាតិ - អន្តរជាតិ និង ស្ថាប័ន ពាក់ព័ន្ធ ដែល បាន ចូលរួម សហការ និង ផ្តល់ ការឧបត្ថម្ភ គាំទ្រ ទាំង សម្ភារៈ ថវិកា និង បច្ចេកទេស » ។
ទន្ទឹមនឹង នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន គាំទ្រ កម្មវិធី កែទម្រង់ វិធានការ និង អាទិភាព ដែល អង្គ សន្និបាត បាន ដាក់ចេញ ដោយ ឈរ លើ មូលដ្ឋាន នៃ សមិទ្ធផល នា ពេល បច្ចុប្បន្ន និង កាលានុវត្តភាព ថ្មី ៗ និង ការកំណត់ ទិសដៅ ការកែទម្រង់ ច្បាស់លាស់ ប្រកបដោយ ភាព ជាក់ស្តែង និយម ជាមួយនឹង គោលដៅ ជាក់លាក់ ព្រមទាំង មាន រចនាសម្ព័ន្ធ ដឹកនាំ និង មាន យន្តការអនុវត្ត ច្បាស់លាស់ ដើម្បី កសាង មូលធន មនុស្ស ដែល មាន សក្តានុពល ទាំង ចំណេះដឹង ជំនាញ និង អាកប្បកិរិយា សម្រាប់ ការអភិវឌ្ឍ ប្រទេសជាតិ ។
ខាងក្រោម នេះ ជា លទ្ធផល ការងារ របស់ ព្រឹទ្ធសភា ក្នុង ឆ្នាំ ២០២២៖
អគ្គ លេខាធិការ អាស៊ាន បណ្ឌិត កៅ គឹម ហួន ជួប ពិភាក្សា ការងារ ជាមួយ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ជប៉ុន តាមរយៈ អនឡាញ
( ហ្សាការតា ) ៖ លោក បណ្ឌិត កៅ គឹម ហួន អគ្គ លេខាធិការ អាស៊ាន នៅ ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ លោក សៃ តូ កែន រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ជប៉ុន តាមរយៈ អនឡាញ ។
ជំនួប ពិភាក្សា គ្នា នេះ បាន ធ្វើឡើង នៅ លេខាធិការដ្ឋាន អាស៊ាន ក្នុង ទីក្រុង ហ្សាការតា សាធារណរដ្ឋ ឥណ្ឌូណេស៊ី ដោយ មាន ការចូលរួម ពី លោក គីយ៉ា ម៉ាសាហ៉ី កូ ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ អាស៊ាន ផងដែរ ។
នៅក្នុង ជំនួប នោះ អគ្គ លេខាធិការ អាស៊ាន បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ភាពជាដៃគូ អាស៊ាន - ជប៉ុន ហើយ ភាគី ទាំង ពីរ បាន ពិភាក្សា រក វិធី ដើម្បី ពង្រឹង កិច្ចសហប្រតបត្តិការ រវាង អាស៊ាន និង ជប៉ុន ជាពិសេស នៅក្នុង វិស័យ យុត្តិធម៌ និង នីតិរដ្ឋ ។
លោកជំទាវ ឃុន ហៀង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រសួង ការបរទេស ចិន ថ្លែង ថា៖ បច្ចុប្បន្ន នេះ ទំនាក់ទំនង រវាង ចិន និង អាមេរិក កំពុង ជួបប្រទះ នឹង ការលំបាក ប៉ុន្តែ ចិន មិន មែន ជា អ្នក ត្រូវ ទទួលខុសត្រូវ នោះ ទេ !
( ប៉េកាំង ) ៖ មាន ការផ្សាយ ដំណឹង ថា បន្ទាប់ពី " ហេតុករណ៍ បាឡុង " បាន កើតឡើង ប្រទេស ចិន បាន បង្កក ការប្រាស្រ័យទាក់ទង ផ្នែក ការទូត ជាមួយ សហរដ្ឋ អាមេរិក ។ លោក Wang Wenbin អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន បាន លើកឡើង ក្នុង សន្និសីទ សារព័ត៌មាន ជា ប្រចាំ ដែល ធ្វើឡើង ដោយ ក្រសួង ការបរទេស ចិន កាលពី ថ្ងៃទី ១១ ខែមេសា ថា បច្ចុប្បន្ន នេះ ទំនាក់ទំនង រវាង ចិន និង អាមេរិក កំពុង ជួបប្រទះ នឹង ការលំបាក ប៉ុន្តែ ចិន មិន មែន ជា អ្នក ត្រូវ ទទួលខុសត្រូវ នោះ ទេ ។
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ឱកាស អញ្ជើញ បិទ សន្និបាត ក្រសួង អប់រំ យុវជន និង កីឡា
( ភ្នំពេញ ) ៖ នៅសៀល ថ្ងៃពុធ ទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ចាស់ និង លើក ទិសដៅ ការងារ ឆ្នាំ ថ្មី របស់ ក្រសួង អប់រំ យុវជន និង កីឡា ។ ពិធី នេះ ប្រារព្ធ ធ្វើឡើង នៅ សាល សន្និសីទ វិទ្យាស្ថាន បច្ចេកទេស កម្ពុជា ។
សូម រំលឹក ថា ក្រសួង អប់រំ យុវជន និង កីឡា បាន បើក សន្និបាត បូកសរុប ការងារ ឆ្នាំ ចាស់ ឆ្នាំ ២០២១ - ២០២២ និង លើក ទិសដៅ ការងារ ឆ្នាំ ថ្មី ឆ្នាំ ២០២២ - ២០២៣ កាល ពី ព្រឹក ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២៣ ។ សន្និបាត របស់ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ឆ្នាំ នេះ ធ្វើឡើង ក្រោម ប្រធានបទ « បរិវត្តកម្ម នៃ វិស័យ អប់រំ »។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សមិទ្ធផល ដែល ទទួលបាន ពិតជា បាន ស្តែង ចេញពី កិច្ច ខិតខំ ប្រឹងប្រែង និង កិច្ចសហការ យ៉ាង ស្អិត រមួត របស់ ថ្នាក់ដឹកនាំ បុគ្គលិក អប់រំ គ្រប់ លំដាប់ថ្នាក់ លោកគ្រូ អ្នកគ្រូ មាតាបិតា សហគមន៍ និង ឤជ្ញាធរដែនដី ក្នុង ការអភិវឌ្ឍ វិស័យ អប់រំ ឱ្យ មាន ការរីកចម្រើន ទៅ មុខ ស្រប តាម តួនាទី និង ភារកិច្ច រៀង ៗ ខ្លួន ជាមួយនឹង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
* សម្តេច តេជោ ហ៊ុន សែន វាយតម្លៃ ខ្ពស់ ចំពោះ ដៃគូ អភិវឌ្ឍ អង្គការ ជាតិ - អន្តរជាតិ និង ស្ថាប័ន ពាក់ព័ន្ធ ដែល បាន ចូលរួម សហការ និង ផ្តល់ ការឧបត្ថម្ភ គាំទ្រ ទាំង សម្ភារៈ ថវិកា និង បច្ចេកទេស ។
* សម្តេច តេជោ ហ៊ុន សែន សូម គាំទ្រ ចំពោះ កម្មវិធី កែទម្រង់ វិធានការ និង អាទិភាព ដែល អង្គ សន្និបាត បាន ដាក់ចេញ ដោយ ឈរ លើ មូលដ្ឋាន នៃ សមិទ្ធផល នា ពេល បច្ចុប្បន្ន និង កាលានុវត្តភាព ថ្មី ៗ និង ការកំណត់ ទិសដៅ ការកែទម្រង់ ច្បាស់លាស់ ប្រកបដោយ ភាព ជាក់ស្តែង និយម ជាមួយនឹង គោលដៅ ជាក់លាក់ ព្រមទាំង មាន រចនាសម្ព័ន្ធ ដឹកនាំ និង មាន យន្តការអនុវត្ត ច្បាស់លាស់ ដើម្បី កសាង មូលធន មនុស្ស ដែល មាន សក្តានុពល ទាំង ចំណេះដឹង ជំនាញ និង អាកប្បកិរិយា សម្រាប់ ការអភិវឌ្ឍ ប្រទេសជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ អនុសាសន៍ ចំនួន ៦ ចំណុច សម្រាប់ អនុវត្ត បន្ត ដល់ ក្រសួង អប់រំ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ផ្តល់ អនុសាសន៍ ឲ្យ បន្ត ពង្រឹង និង អភិវឌ្ឍ ប្រព័ន្ធ អប់រំ ឱ្យ កាន់តែ រឹងមាំ មាន ភាព បុរេសកម្ម ទំនើបកម្ម និង ឆ្លើយតប ទៅនឹង បរិការណ៍ - ជាតិ និង អន្តរជាតិ ។ ជាមួយ នេះ ការធានា បាន នូវ សេវា អប់រំ ដែល មាន ប្រសិទ្ធភាព និង គុណភាព ប្រកបដោយ សមធម៌ បរិយាប័ន្ន ព្រមទាំង លើកកម្ពស់ ឱកាស ក្នុង ការសិក្សា ពេញ មួយ ជីវិត សម្រាប់ ទាំងអស់ គ្នា ជាពិសេស ត្រូវ ខិតខំ រិះរក វិធានការ ដែល កាន់តែ មាន ប្រសិទ្ធភាព ដើម្បី លើកកម្ពស់ លទ្ធផល សិក្សា របស់ សិស្ស នៅ គ្រប់ កម្រិត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ផ្តល់ អនុសាសន៍ ឲ្យ បន្ត អភិវឌ្ឍ សមត្ថភាព ស្ថាប័ន និង មន្ត្រី អប់រំ ឱ្យ បាន ពេញលេញ មាន ភាពរស់រវើក និង ប្រទាក់ ក្រឡា គ្នា តាមរយៈ ធានា ភាពស័ក្តិសិទ្ធ នៃ ភាព ជា អ្នកដឹកនាំ និង ការគ្រប់គ្រង របស់ មន្ត្រី អប់រំ គ្រប់ លំដាប់ថ្នាក់ រួមទាំង ការកែទម្រង់ គ្រឹះស្ថាន បណ្តុះបណ្តាល គ្រូ ការលើកកម្ពស់ ប្រសិទ្ធភាព ហិរញ្ញប្បទាន សហ - ប្រតិបត្តិការ ការកសាង គោល នយោបាយ និង ផែនការអប់រំ និង ការអភិវឌ្ឍ វិជ្ជាជីវៈ ជាប្រចាំ សម្រាប់ បុគ្គលិក អប់រំ និង គ្រូបង្រៀន ។
លោក ហុក វ៉ាន់ធី ណា ប្រធាន សាលាដំបូង ខេត្ត កណ្ដាល នាំ ថវិកា ១០០ លាន រៀល បរិច្ចាគ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ លោក ហុក វ៉ាន់ធី ណា ប្រធាន សាលាដំបូង ខេត្ត កណ្ដាល ព្រមទាំង គណៈប្រតិភូ អម ដំណើរ បាន នាំយក អំណោយ សប្បុរសធម៌ ជា ថវិកា ចំនួន ១០០.០០០.០០០ រៀល បរិច្ចាគ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា ភ្នំពេញ គឺ ដើម្បី ជូន មន្ទីរពេទ្យ អាច ធ្វើ ការចាត់ចែង និង ទ្រទ្រង់ ដំណើរ នៅក្នុង មន្ទីរ ទេព្យ និង ជា ការរួមចំណែក មួយ ក្នុង សកម្មភាព សង្គម ក្នុង ន័យ រួម ជួយ ដល់ កុមារ កម្ពុជា ។
ការចូលរួម បរិច្ចាគ ថវិកា ពីសំណាក់ សប្បុរសជន នានា ដែល ដឹកនាំ ដោយ លោក ហុក វ៉ាន់ធី ណា នេះ គឺ ដើម្បី ចូលរួម អបអរសាទរ ដល់ ការបង្កើតឡើង នូវ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា គំរប់ ខួប៥ ឆ្នាំ ក្រោម គំនិត ផ្ដួច ផ្ដើម របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន
ថវិកា នេះ ជា ចំណែក មួយ ផ្នែក ដែល សល់ បន្ទាប់ពី ការចាត់ចែង ពី ឧបត្ថម្ភ ដល់ កងទ័ព នៅ បញ្ជាការដ្ឋាន ភូមិភាគ ៤. កងទ័ព នៅ បញ្ជាការដ្ឋាន កងពល ធំ អន្តរាគមន៍ លេខ ២ និង មន្ទីរពេទ្យ គន្ធ បុប្ផា អង្គរ ( សៀមរាប ) កន្លងមក ។
សូម បញ្ជាក់ ថា ថវិកា នេះ បាន មក ពី ការចូលរួម ដោយ ស្ម័គ្រចិត្ត របស់ សប្បុរសជន នានា ( ដូច មាន ភ្ជាប់ ក្នុង បញ្ជី រាយ នាម សប្បុរសជន ចំនួន ៥២ រូប ) ៕
គណៈប្រតិភូ ខេត្ត យ៉ាឡាយ ប្រទេស វៀតណាម ជួប សម្តែង ការគួរសម និង ជូនពរ ថ្នាក់ដឹកនាំ ខេត្ត ស្ទឹងត្រែង ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ
( ស្ទឹងត្រែង )៖ គណៈប្រតិភូ ខេត្ត យ៉ាឡាយ សាធារណរដ្ឋ សង្គម វៀតណាម ដឹកនាំ ដោយ លោក ចូវ ង៉ុក ទ័ន អនុលេខា អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ បក្ស ខេត្ត យ៉ាឡាយ នៅ ព្រឹក ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជួប សម្តែង ការគួរសម និង ជូនពរ ថ្នាក់ដឹកនាំ ខេត្ត ស្ទឹងត្រែង ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ
លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត ស្ទឹងត្រែង និង លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ គណៈប្រតិភូ ខេត្ត យ៉ាឡាយ សាធារណរដ្ឋ សង្គម វៀតណាម ដែល បាន អញ្ជើញ ចូល ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ជូនពរ ក្នុង ឱ ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ឈាន មកដល់ ក្នុង ពេល ដ៏ ខ្លី ខាងមុខ នេះ ។
លោក អភិបាល ខេត្ត បាន ចាត់ទុក្ខ ថា ការចូល សំណេះសំណាល សួរសុខទុក្ខ និង ជូនពរ ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ ពីសំណាក់ គណៈប្រតិភូ ខេត្ត យ៉ាឡាយ បាន បង្ហាញ ពី ទំនាក់ទំនង ល្អ មាន ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ ប្រសើរ រវាង ខេត្ត យ៉ាឡាយ ប្រទេស វៀតណាម និង ខេត្ត ស្ទឹងត្រែង ប្រទេស កម្ពុជា ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា កម្ពុជា - វៀតណាម មាន ទំនាក់ទំនង ល្អ ជា ប្រពៃណី ហើយ កាយវិការ នៃ ការអញ្ជើញ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ជូនពរ ឆ្នាំ ថ្មី នេះ ខេត្ត ទាំង ពីរ និង ប្រទេស ទាំង ពីរ តែងតែ ជូនពរ គ្នា ទៅ វិញ ទៅមក ។ កាយវិការ ដ៏ ល្អ ប្រពៃ នេះ និង បង្ហាញ បន្ត ដល់ កូន ចៅ ជំនាន់ ក្រោយ ឱ្យ បន្ត នូវ ប្រពៃណី ដ៏ ល្អ នេះ ដើម្បីឱ្យ ចំណង មិត្តភាព រវាង កម្ពុជា - កាន់តែ រឹងមាំ ។
អនុលេខា អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ បក្ស ខេត្ត យ៉ាឡាយ បាន ថ្លែងអំណរ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ថ្នាក់ដឹកនាំ ខេត្ត ស្ទឹងត្រែង ពិសេស លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត និង លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ដែល ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ គណប្រតិភូ ខេត្ត យ៉ាឡាយ នា ពេលនេះ ។
លោក បាន បន្ត ថា កម្ពុជា - វៀតណាម ជា មិត្ត ដ៏ ល្អ ជា មាន ទំនាក់ទំនង ល្អ លើ គ្រប់ វិស័យ ជាពិសេស មាន ទំនាក់ទំនង ជា ប្រវត្តិសាស្ត្រ ក្នុង ការសាមគ្គីភាព គ្នា ប្រយុទ្ធ ជាមួយ សត្រូវ រួម នៅក្នុង សម័យ សង្គ្រាម ។ លោក សូម ឱ្យ ទំនាក់ទំនង និង កិច្ចសហប្រតិបតិ្តការ និង ចំណង មិត្តភាព របស់ ខេត្ត ទាំង ពីរ កាន់តែ ល្អ ប្រសើរ ទ្វេ ឡើង ដើម្បី ភាព សុខសាន្ត និង ការរីកចម្រើន ជីវភាព រស់ នៅ របស់ ប្រជាជន ។
លោក ចូវ ង៉ុក ទ័ន បាន កោតសរសើរ ចំពោះ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង ថ្នាក់ដឹកនាំ ខេត្ត ស្ទឹងត្រែង ដែល បាន ធ្វើឲ្យ ខេត្ត មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ព្រមទាំង ផ្លាស់ប្តូរ មុខមាត់ ទាំងស្រុង ។
គួរ បញ្ជាក់ ថា កាលពី ចុង ខែកុម្ភៈ លោក ពូទីន បាន ប្រកាស ថា ទីក្រុង មូស្គូ សម្រេច ព្យួរ ការចូលរួម របស់ ខ្លួន ក្នុង សន្ធិសញ្ញា New START ដែល កំណត់ ចំនួន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ របស់ រុស្ស៉ី និង អាមេរិក ខណៈ កាលពី ជិត ៣សប្តាហ៍ មុន លោក ប្រធានាធិបតី រុស្ស៉ី បាន និយាយ ថា រូប លោក នឹង ដាក់ពង្រាយ អាវុធ នុយក្លេអ៊ែរ តាក់ ទិក នៅ បេឡារុស ដែល ជា ប្រទេស ជិតខាង និង ជា សម្ព័ន្ធមិត្ត ដ៏ ជិតស្និទ្ធ ៕
ទេសរដ្ឋមន្រ្តី លី ធុជ ចាត់ទុក កងកម្លាំង បោសសម្អាត មីន របស់ កងទ័ព ជើងគោក ជា ឆ្អឹង ខ្នង ដ៏ រឹងមាំ សម្រាប់ វិស័យ សកម្មភាព មីន មនុស្សធម៌ នៅ កម្ពុជា ដើម្បី ឈាន ឆ្ពោះ ទៅរក កម្ពុជា មួយ គ្មាន មីន ឆ្នាំ ២០២៥
( បាត់ដំបង ) ៖ ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន បាន ចាត់ទុក កងកម្លាំង បោសសម្អាត មីន របស់ កងទ័ព ជើងគោក គឺជា ទ្រព្យសម្បត្តិ ដ៏ មាន សារៈសំខាន់ និង ជា ឆ្អឹង ខ្នង ដ៏ រឹងមាំ សម្រាប់ វិស័យ សកម្មភាព មីន មនុស្សធម៌ នៅ កម្ពុជា ដើម្បី ឈាន ឆ្ពោះ ទៅរក កម្ពុជា មួយ គ្មាន មីន ឆ្នាំ ២០២៥ ។
ការលើកឡើង បែប នេះ របស់ ទេសរដ្ឋមន្ត្រី លី ធុជ បាន ធ្វើឡើង នៅក្នុង កំឡុង ពេល ដែល បាន ទទួល សិទ្ធិ ពី នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក ធ្វើជា អធិបតី ក្នុង ពិធី បិទ វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ បោសសម្អាត មីន និង យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ ចំនួន ១៩កង អនុ សេនា តូច របស់ កងទ័ព ជើងគោក ដែល បាន ប្រព្រឹត្តិ ទៅ នៅ សាលា ពល ទាហាន ទី៥ ខេត្ត បាត់ដំបង នា ព្រឹក ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
ពិធី នេះ មាន ការចូលរួម ពី លោក ហេង រតនា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា . ឧត្តមសេនីយ៍ ឯក ខឹម ជា សាឃឿន មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក . ឧត្តមសេនីយ៍ ឯក អ៊ុច វ៉ាន់ ថា មេបញ្ជាការ រង និង ជា មេបញ្ជាការបញ្ជាការដ្ឋាន វិស្វកម្ម កងទ័ព ជើងគោក មេបញ្ជាការ រង មេបញ្ជាការ ភូមិភាគ យោធាចារ្យ នាយ ទាហាន នាយ ទាហាន រង និង សិក្ខាកាម សរុប ចំនួន ៦០២ នាក់ ។
ទេសរដ្ឋមន្រ្តី លី ធុជ បាន បន្ត ទៀត ចាប់ពី ឆ្នាំ ២០២២ កងទ័ព ជើងគោក បាន បញ្ជូន និង ត្រៀម កម្លាំង នាយ ទាហាន ចំនួន ៤៥កង អនុ សេនា តូច ស្មើនឹង ១. ១៧០ នាក់ ដើម្បី ចូលរួម បោសសម្អាត មីន មនុស្សធម៌ នៅ កម្ពុជា ព្រមទាំង ទទួលបាន នូវ ការហ្វឹកហ្វឺន ជំនាញ បោសសម្អាត មីន ជា បន្តបន្ទាប់ ។
( វ៉ាស៉ីន តោន ) ៖ លទ្ធផល ស្ទង់ មតិ ដែល ចេញផ្សាយ កាលពី ថ្ងៃអង្គារ សប្តាហ៍ នេះ បាន បង្ហាញ ថា ម្នាក់ ក្នុង ចំណោម ប្រជាជន អាមេរិក ពេញ វ័យ ៥នាក់ គឺ មាន សមាជិក គ្រួសារ ដែល ត្រូវបាន សម្លាប់ ដោយ កាំភ្លើង រាប់ ទាំង ការធ្វើ អត្តឃាត ហើយ អត្រា ប្រហាក់ប្រហែល គ្នា ក៏ បាន អះអាង ដែរ ថា ពួកគេ ផ្ទាល់ ធ្លាប់ រង ការគំរាមកំហែង ដោយ កាំភ្លើង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នា ថ្ងៃពុធ ទី ១២ ខែមេសា ឆ្នាំ ២០២៣ ។
លោក សាយ គឹម ឡម បាន បញ្ជាក់ ថា នេះ គឺជា ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ដោយ កម្ពុជា យើង ធ្វើជា ម្ចាស់ ផ្ទះ ក្នុង ពេល ឆាប់ ខាងមុខ នេះ ហើយ ព្រឹត្តិកាណ៍ រត់ សប្បាយ ៗ នេះ គឺ ដើម្បី អបរសាទរ ព្រឹត្តិកាណ៍ ទាំង ពីរ ព្រោះ កម្មវិធី នេះ អាច កើតមាន ទៅ បាន ក៏ ដោយសារ ស្រុក ទេស យើង មាន សុខ សន្តិភាព ពេញ បរិបូរ ក្រោម ការដឹកនាំ ដ៏ ឆ្លៀសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ជាមួយ នេះ ផងដែរ លោក ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ដល់ គណៈកម្មការ និង អត្តពលិក គ្រប់ រូប ដែល បាន អញ្ជើញ មក ពី អង្គភាព ជុំវិញ ស្រុក និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ធនាគារ ឯកជន NGO កងកម្លាំង ទាំង បី ម្ចាស់ គម្រោង អភិវឌ្ឍន៍ នានា មហាជន សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ មន្ត្រីរាជការ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ពេលវេលា ថវិកា មក ចូលរួម ដែល ញ៉ាំង ឲ្យ ព្រឹត្តិការណ៍ នេះ ប្រព្រឹត្តទៅ បាន យ៉ាង រលូន ស្និទ្ធស្នាល កក់ក្តៅ និង សប្បាយរីករាយ បំផុត តាម ការគ្រោងទុក ។
លោក សាយ គឹម ឡម បាន អំពាំ វនាវ ដល់ មហាជន និង យុវជន ឲ្យ ចូលរួម លេង កីឡា ដើម្បី សុខភាព មិត្តភាព កិច្ចការ មនុស្សធម៌ ចៀស ឆ្ងាយ ពី គ្រឿងញៀន និង ចូលរួម ការពារ សុខ សន្តិភាព ជាមួយ រាជ រដ្ឋាភិបាល ឲ្យ មាន ការរីកចម្រើន និង សូម ជូនពរ មាន សិរី សួស្តី ក្នុង ឆ្នាំ ថ្មី ទាំងអស់ គ្នា ។
កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ គយ និង រដ្ឋាករ ត្រីមាស ទី១ ឆ្នាំ ២០២៣ ដឹកនាំ ដោយ លោក បណ្ឌិត គុណ ញឹម រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ដែល ត្រូវបាន រៀបចំ តាមរយៈ ការចូលរួម ដោយ ផ្ទាល់ និង តាម ប្រព័ន្ធ វីដេអូ នៅ រសៀល ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០២៣ នៅ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ។
បន្ទាប់ពី បិទ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ គយ និង រដ្ឋាករ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី ក៏ បាន រៀបចំ ពិធី ជួប សំណេះសំណាល ជាមួយនិវត្ត ជន អតីត មន្ត្រីរាជការ គយ និង រដ្ឋាករ ចំនួន ១៥០ រូប ដោយ បាន សម្តែង នូវ សេចក្តីនឹករលឹក ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ រាល់ ស្នាដៃ និង គុណ បំណាច់ របស់ និវត្ត ជន ទាំងអស់ ដែល បាន លះបង់ កម្លាំង កាយ កម្លាំង ប្រាជ្ញា និង កម្លាំងចិត្ត ក្នុង ការពុះពារ ឧបសគ្គ គ្រប់ បែបយ៉ាង ដើម្បី សម្រេចបាន នូវ សមិទ្ធផល ជូន អង្គភាព ក្នុង រយៈកាល កន្លងមក ។
យោង តាម របាយការណ៍ របស់ អធិការដ្ឋាន នគរបាល ក្រុង តាខ្មៅ បាន ឲ្យដឹង ថា ក្មេង ស្ទាវ ចំនួន ១០នាក់ បាន ព័ទ្ធ វាយ យុវជន ២នាក់ បណ្ដាលឲ្យ របួស ធ្ងន់ ដែល ជា ការសងសឹក ហើយ ត្រូវបាន នគរបាល ក្រុង តាខ្មៅ ដឹកនាំ ដោយ លោក យី វណ្ណ ដា អធិការ នគរបាល ក្រុង តាខ្មៅ តាម ចាប់ បាន ៦នាក់ និង ដោះលែង វិញ ម្នាក់ និង គេចខ្លួន ចំនួន ៤នាក់ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ចំណុច ខាងមុខ ហាង កាហ្វេ អេហ្សូតិច ស្ថិត នៅក្នុង ភូមិ តា ខ្មៅ សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២៣ វេលា ម៉ោង ១៦៖៣០ នាទី ។
ក្រោយ កើត ហេតុ រួច ក៏ ត្រូវ សមត្ថកិច្ច ក្រុង តាខ្មៅ ចេញ អន្តារាគមន៍ ដេញ ចាប់ខ្លួន បាន ជនសង្ស័យ ចំនួន ៦នាក់ បញ្ជូន មកកាន់ អធិការដ្ឋាន ដើម្បី សាកសួរ និង ចាត់ការ តាម នីតិធី តែម្តង ។ ប៉ុន្តែ ដោយសារ ម្នាក់ មាន អាយុ ក្មេង ពេក ព្រះរាជអាជ្ញា ឲ្យ ដោះលែង វិញ ។
ជនរងគ្រោះ ០២ នាក់ រួម មាន៖
* ទី១៖ ឈ្មោះ គួរ គីម សេង អាយុ ១៥ ឆ្នាំ មុខរបរ សិស្ស ទីលំនៅ ភូមិ ត្រពាំង ឈូក សង្កាត់ អូរបែក ក្អម ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ មាន របួស ស្នាម ពក ក្បាល ។* ទី២៖ ឈ្មោះ ញ៉ៅ និធិ អាយុ ១៣ ឆ្នាំ ស្នាក់ នៅ ភូមិ សន្សំ កុសល២ សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ មាន របួស ស្នាម រយះ ក្បាល ខាងក្រោយ ។
ជនសង្ស័យ ១០នាក់ រួម មាន៖
រដ្ឋាភិបាល ក្រុង សេអ៊ូល ស្វែងរក ការពិត ជុំវិញ ឯកសារ បែកធ្លាយ សម្ងាត់ របស់ ចារកម្ម អាមេរិក លើ កិច្ចការ សន្តិសុខ ជាតិ កូរ៉េ ខាងត្បូង
( ភ្នំពេញ ) ៖ លោក ធឹម សំអាន អភិបាល ខណ្ឌ ព្រែក ព្នៅ នៅ ថ្ងៃទី ១២ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន ជួប សំណេះសំណាល ជាមួយ បងប្អូន កងកម្លាំង សណ្តាប់ធ្នាប់ ខណ្ឌ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ខ្មែរ ប្រពៃណី ជាតិ និង បាន ដាស់តឿន ក្រើន រំលឹក ដល់ កងកម្លាំង សណ្ដាប់ធ្នាប់ ខណ្ឌ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ វិន័យ មាន សាមគ្គីភាព ផ្ទៃក្នុង ល្អ ក្នុង ពេល ចុះ បំពេញ ការងារ រៀបចំ សណ្តាប់ធ្នាប់ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ តួនាទី ភារកិច្ច គឺ ទន់ភ្លន់ តែ ម៉ឺងម៉ាត់ ។
ជាមួយគ្នា នេះ ដែរ លោក ធឹម សំអាន បាន កោតស សើរ ដល់ កម្លាំង សណ្តាប់ធ្នាប់ ខណ្ឌ ទាំងអស់ កន្លងមក បាន ខិតខំ បំពេញ ការងារ យ៉ាង សកម្ម ក្នុង ការការពារ សន្តិសុខ ចុះ រៀបចំ សណ្តាប់ធ្នាប់ សម្រួល ចរាចរណ៍ ចុះ ពង្រឹង ច្បាប់ ចរាចរណ៍ ចូលរួម ត្រួតពិនិត្យ អាវុធ ជាតិ ផ្ទុះ និង ចុះល្បាត តាម មូលដ្ឋាន ។ ចំណុច មួយ ទៀត ត្រូវ ចេះ ជួយ គ្នា ចេះ ស្រឡាញ់ គ្នា ចេះ អធ្យាស្រ័យ ឱ្យ គ្នា ចេះ សន្តោស ប្រណី ឱ្យ គ្នា ទៅ វិញ ទៅមក និង ចេះ ជួយ យកអាសារ គ្នា ។
ស្រប ពេល ដែល ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី មកដល់ លោក អភិបាល ខណ្ឌ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ ភ្លើង ទៀន ភ្លើង ធូប ចង្ក្រាន ហ្គាស់ ប្រព័ន្ធ ខ្សែភ្លើង នៅក្នុង ផ្ទះ ត្រូវ ត្រួតពិនិត្យ ឱ្យ បាន ហ្មត់ចត់ បំផុត មុន និង ចេញ ពី ផ្ទះ ទៅ កំសាន្ត នៅ តាម រម្មណីដ្ឋាន នានា បង្កា ខ្លាច កើតមាន គ្រោះ អគ្គិភ័យ ។
ជនសង្ស័យ បាន ឲ្យ ជនរងគ្រោះ ផ្ញើ ប្រវត្តិ រូប ផ្ទាល់ខ្លួន រូបថត និង ឯកសារ ផ្សេង ៗ ដើម្បី បំពេញ បែបបទបញ្ចូល ក្របខ័ណ្ឌ ។ បន្ទាប់មក ជនសង្ស័យ ក៏ បាន ប្រគល់ អត្តសញ្ញាណប័ណ្ណ កងទ័ព និង លិខិត បញ្ជា បេសកកម្ម ទៅ ជនរងគ្រោះ ប្រើប្រាស់ ។ ក្រោយមក ជនរងគ្រោះ បាន សួរ រក ប្រាក់ខែ រដ្ឋ អង្គភាព និង មេ កើយ ស្រាប់តែ ជនសង្ស័យ បាន ប្រាប់ ថា ចាំ សួរ ថ្នាក់ លើ ឲ្យ និង រក លេស ដោះសារ រហូត ទើប ជនរងគ្រោះ ដឹង ថា ខ្លួន ត្រូវបាន ចាញ់បោក គេ ក៏ ដាក់ ពាក្យ បណ្តឹង នៅ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ តែម្តង ។
បន្ទាប់ពី បាន ទទួល បណ្តឹង ពី ជនរងគ្រោះ អាវុធហត្ថ ភ្នំពេញ ក៏ បាន បើក ការ ស្រាវជ្រាវ ជាបន្ទាន់ និង ឈាន ទៅ ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ឈ្មោះ ផន ច័ន្ទ ផានិត នៅ ចំណុច មុខ ផ្សារ បុរី ពិភព ថ្មី កំបូល ៣ ភូមិ ថ្ម ដា សង្កាត់ កន្ទោក ខណ្ឌ កំបូល ។ ជនសង្ស័យ មាន មុខរបរ ត្រឹមតែ ជា អ្នក គួក ជេរ ដី និង ជា តៃ កុង ឡាន ប៉ុណ្ណោះ ក្នុង នោះ អាវុធហត្ថ រាជធានី ភ្នំពេញ ក៏ បាន ចាប់ យក អាវុធ ខ្លី កែច្នៃ ០១ ដើម ពុំ មាន ម៉ាក និង ឯកសារ ក្លែង មួយចំនួន ពី ជនសង្ស័យ ផងដែរ ។
ជនសង្ស័យ បាន ទទួលស្គាល់ ថា ពិតជា បាន ទទួល ប្រាក់ ពី ជនរងគ្រោះ ដើម្បី រត់ ការចូល ក្របខ័ណ្ណ ពិតប្រាកដ មែន ដែល ការ រត់ ការចូល ក្របខ័ណ្ឌ នេះ គឺ ខ្លួន បាន ក្លែង ឯកសារ ប្រគល់ឲ្យ ជនរងគ្រោះ និង បាន ទទួល លុយ ពី ជនរងគ្រោះ ទើបតែ បាន ៨.០០០ ដុល្លារ ប៉ុណ្ណោះ ក៏ ត្រូវ ជនរងគ្រោះ ចាប់ ចំណុច ខ្សោយ បាន ថា ខ្លួន ឆបោក តែម្តង ។ បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន អាវុធហត្ថ រាជធានី ភ្នំពេញ កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ តាម និតិវិធី ។
ជាពិសេស លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ធ្លាប់ មានប្រសាសន៍ ទៀត ថា « ឯកឧត្តម ថត សែល ហ្វី ជាមួយ មនុស្ស រាប់ ពាន់ នាក់ រាប់ រយ នាក់ តែ អ្នក ខ្លះ បាន រូបថត ជាមួយ ឯកឧត្តម មួយ ប៉ុស្ត៍ ក៏ ដើរ ធ្វើបាប គេ ប្រព្រឹត្ត អំពើ ខុសឆ្គង ដោយ ភូតកុហក់ ថា ជា ជំនួយការ របស់ ឯកឧត្តម ដើរ ចាប់ ដី ដែល មនុស្ស បែប នេះ ត្រូវតែ ចាប់ខ្លួន ភ្លាម ៗ ។ ពី ណា ដែល យក ឈ្មោះ ឯកឧត្តម ទៅ ប្រើ ទោះជា ជំនួយការឯកឧត្តម ឬ អ្វី ក៏ដោយ ឲ្យ តែ ធ្វើ ខុស ច្បាប់ គឺ ចាប់ ទៅ មិន បាច់ សួរ យោបល់ ទេ ហើយ បើ ប្រាប់ ឯកឧត្តម គឺ ឯកឧត្តម ប្តឹង ថែម ពីលើ ទៀត » ។
ដូច្នេះ តាមរយៈ សារ ដ៏ មាន តម្លៃ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ខាងលើ នេះ គឺជា ជំនួយ ស្មារតី ក្នុង ការដាស់តឿន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា សារធារណៈ ជន ទូទៅ តោង ប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ កុំ ឲ្យ ចាញ់បោក ជន ទុច្ចរិត ដោយ ត្រឹមតែ ឃើញ រូបថត ដែល ថត ជាមួយ ថ្នាក់ដឹកនាំ ឬ ឥស្សរជន សំខាន់ ណាមួយ ឲ្យ សោះ ៕
ឯកឧត្ដម ប្រាក់ សំអឿន និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ប្រាក់ សំអឿន អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន រដ្ឋបាល ក្រសួង មហាផ្ទៃ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ចំនួន ៥លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្ដម ប្រាក់ សំអឿន និង លោកជំទាវ តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ប្រាជ្ញ ចន្ទ និង លោកជំទាវ ឱម សារី បរិច្ចាគ ថវិកា ២០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
