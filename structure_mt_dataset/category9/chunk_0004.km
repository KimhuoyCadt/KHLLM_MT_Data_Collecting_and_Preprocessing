បំណងប្រាថ្នា ល្អ បំផុត របស់ ខ្ញុំ នៅលើ ការងារ ថ្មី របស់ អ្នក ។
បំណងប្រាថ្នា ល្អ បំផុត របស់ ខ្ញុំ នៅលើ ផ្ទះ ថ្មី របស់ អ្នក ។
សូម ឱ្យ គាត់ ទាក់ទង ខ្ញុំ ផងដែរ ។
សូម ឱ្យ របស់ គាត់ ទាក់ទង ខ្ញុំ ។
សូម ឱ្យ ភរិយា របស់ អ្នក ទាក់ទង ខ្ញុំ ។
សូម ឱ្យ ប្ដី របស់ អ្នក ទាក់ទង របស់ ខ្ញុំ ។
សូម ឱ្យ ព្រះអាទិត្យ របស់ អ្នក ទាក់ទង របស់ ខ្ញុំ ។
សូម គាត់ បំណងប្រាថ្នា ដ៏ ល្អ បំផុត របស់ ខ្ញុំ ។
សូម ឱ្យ របស់ នាង បំណងប្រាថ្នា ដ៏ ល្អ បំផុត របស់ ខ្ញុំ ។
សូម ឱ្យ ភរិយា របស់ អ្នក បំណងប្រាថ្នា ដ៏ ល្អ បំផុត របស់ ខ្ញុំ ។
សូម ឱ្យ ប្ដី របស់ អ្នក បំណងប្រាថ្នា ដ៏ ល្អ បំផុត របស់ ខ្ញុំ ។
សូម ឱ្យ កូនស្រី របស់ អ្នក បំណងប្រាថ្នា ដ៏ ល្អ បំផុត របស់ ខ្ញុំ ។
សូម ឱ្យ កូនប្រុស របស់ អ្នក បំណងប្រាថ្នា ដ៏ ល្អ បំផុត របស់ ខ្ញុំ ។
អបអរសាទរ ខ្ញុំ បាន ឮ អ្នក ឈប់ ជក់ បារ ។ តើ អ្នក គ្រប់គ្រង វា យ៉ាងដូចម្តេច ?
អបអរសាទរ ខ្ញុំ បាន ឮ អ្នក ទទួលបាន ការងារ ជាមួយ ក្រុមហ៊ុន ទូរទស្សន ។ អេប៊ីស៊ី ។
អបអរសាទរ ខ្ញុំ បាន ឮ អ្នក ឈ្នះ ការប្រកួត នេះ ។
អ្នក ត្រូវតែ មាន ការរីករាយ ខ្លាំង ណាស់ មែន ទេ ។
ខ្ញុំ ហ៊ាន ភ្នាល់ ថា កូន របស់ អ្នក ការសប្បាយ ចិត្ត ខ្លាំង ណាស់ ។
ខ្ញុំ បាន ភ្នាល់ ប្ដី របស់ អ្នកករាយ ខ្លាំង ណាស់ ។
សូម អបអរសាទរ ខ្ញុំ បាន ឮ អ្នក មាន កូនប្រុស តូច ម្នាក់ ។
អ្នក ត្រូវតែ មាន ការសប្បាយរីករាយ ខ្លាំង ណាស់ ។
នោះ ជា គំនិត អស្ចារ្យ ។ តើ ធ្វើ ដូចម្តេច អំពី អាហារ មួយចំនួន នេះ ?
សូម ប្រញាប់ បន្តិច ។
ចាកចេញ ពេលនេះ ។
ហេតុ អ្វី បានជា យើង មិន ញ៉ាំ អាហារ ថ្ងៃត្រង់ ?
អ្នក នឹង មិន ញ៉ាំ អាហារ ថ្ងៃត្រង់ ?
នឹង យើង ញ៉ាំ អាហារ ថ្ងៃត្រង់ ?
ចូលរួម ជាមួយ ពួកយើង ។
ខ្ញុំ នឹង ពិនិត្យ ភ្លៀង មួយ ។
ខ្ញុំ មាន គ្រប់គ្រាន់ ហើយ ។ ូម អរគុណ ។
មិន មែន គ្រាន់តែ ឥឡូវនេះ សូម អរគុណ ។
ខ្ញុំ ប្រសើរ ជាង មុន បាន ។
របាយការណ៍ នេះ ត្រឹមត្រូវ ។
តើ អ្នក ចង់ ពិសា អាហារ ពេលល្ងាច ពេលនេះ ?
នាង អាច ចូល ទៅកាន់ កិច្ចប្រជុំ ភ្លាម ទេ ?
អ្នក អាច យល់ ថា ខ្ញុំ មានអារម្មណ៍ ?
ខ្ញុំ គិត ថា របាយការណ៍ នេះ វែង ពេក ។
ល្អ សម្រាប់ ខ្ញុ ។ អរគុណ ។
ទៅ ខាងស្តាំ ចុង បាន ។
នៅ ពេល ដែល ត្រូវបាន យន្តហោះ របស់ អ្នក ចាក សម្រាប់ ទីក្រុ ។ សាន់ប្រាន់ស៊ីស្កូ ?
ជា ការពិត ។ ខ្ញុំ បាន ធ្វើ ការកក់ ខ្លួនខ្ញុំ ផ្ទាល់ ។
អ្នក នឹង វិលត្រឡប់ មកវិញ នៅ ថ្ងៃចន្ទ ?
ទី ១៤ ខែមិថុនា ។
ខ្ញុំ នឹង ចាកចេញ នៅ សប្ដាហ៍ បន្ទាប់ ទៀត ។
ខ្ញុំ នឹង ត្រូវបាន បាត់ អស់ រយៈពេល ២សប្ដាហ៍ ។
គាត់ បាន ចាកចេញពី ១ ថ្ងៃ មុន ពេល ដែល កាលពី ម្សិលមិញ ។
ដំណើរកម្សាន្ត របស់ យើង ចាប់ផ្តើម នៅ ទី២ ។ ខែកក្កដា ។ ហើយ បញ្ចប់ នៅ ថ្ងៃទី ២៧ ។
ខ្ញុំ នឹង ចាប់ផ្តើម រៀន នៅ ខែកញ្ញា ។ ទី៣ ។
រថភ្លើង ចេញ នៅ ម៉ោង ៣រសៀល ។
សាលា ចាប់ផ្តើម នៅ ម៉ោង ៩សាម សិម នាទី ។
នៅ ទី២បញ្ចប់ នៅ ពាក់កណ្តាល យប់ ។
នៅ ទី២ធ្វើដំណើរ ពី ម៉ោង ៤ល្ងា ។ ទៅ ម៉ោង ១២យប់ ។
អាសយដ្ឋាន របស់ អ្នក ។ និង ទូរសព្ទ របស់ អ្នក ។
ខ្ញុំ រស់ នៅក្នុង ចំនួន ៤សញ្ញា៦ ។ ូរទស្សន ។ អេប៊ីស៊ី ទាំង ពីរ និង លេខ ទូរស័ព្ទ របស់ ខ្ញុំ គឺជា ប្រាំមួយ បួន ប្រាំបី ចំនួន បី បួន នាក់ ពីរ ។
កម្ពស់ ។ និង ទម្ងន់ របស់ អ្នក ។
ខ្ញុំ ពិតជា ប្រាំ ជើង កម្ពស់ ៨អ៊ីញ និង មាន ទម្ងន់ មួយ រយ ហាសិប ប្រាំមួយ ផោន ។
មិន ប្រក្រតី ទ ។ ធម្មតា ប្រមាណ ៥ទៅ ៦ដល់ ក្នុង មួយ ឆ្នាំ ។
ក្នុង កាតព្វកិច្ច ខ្ញុំ ជាធម្មតា ជាមួយនិង ធុរកិច្ច របស់ ខ្ញុំ ជា សម្ពាធ មួយ កម្រ ។
ដូច្នេះហើយ ខ្ញុំ សង្ឃឹម ថ ។ ខ្ញុំ មាន ឱកាស ធ្វើដំណើរ ជារឿយ ៗ បាន ច្រើន ។
ពួកគេ ទិញ អាហារ ជាច្រើន ជាមួយ ពួកគេ ។
តើរឿយ ៗ អ្នកទិញ ហ្គាស ប៉ុន្មាន ដង ?
តើ ខ្ញុំ គួរតែ ពិនិត្យមើល ទភលើ គាត់ ?
ពួកគេ ពិតជា ចូលចិត្ត វា ខ្លាំង ណាស់ ។
ខ្ញុំ គ្រាន់តែ អាច និយាយ សម្រាប់ ប៉ុន្មាន នាទីនេះ ។
ខ្ញុំ អាច និយាយ ភាសា បារាំង បាន បន្តិច ។
ខ្ញុំ បាន និយាយ ទៅកាន់ គាត់ រាល់ ពេល ឥឡូវនេះ ហើយ បន្ទាប់មក ។
ខ្ញុំ តែងតែ ឃើញ គាត់ នៅលើ រថភ្លើង រៀងរាល់ ព្រឹក ។
ខ្ញុំ ស្ទើរតែ មិន ធ្លាប់ បាន បរិភោគ អាហារ នៅ ក្រៅ ទៀត ទេ ។
ខ្ញុំ កម្រ ជិះ រថយន្ដក្រុង នេះ ណាស់ ។
គ្មាន ការ និយាយ លេង ។ ជា ការពិត ជាច្រើន ។
ខ្ញុំ គ្រាន់តែ មាន ប្រហែល ហាសិប សៀវភ ។ ខ្ញុំ ចង់ ទទួលបាន ច្រើន ជាង នេះ ប៉ុន្តែ ខ្ញុំ មិន មាន ចន្លោះ ច្រើន បាន ចាកចេញ នៅលើ ធ្នើ សៀវភៅ របស់ ខ្ញុំ ។
ប្រសិនបើ លោកអ្នក ចង់ ខ្ចី ណាមួយ នៃ សៀវភៅ របស់ ខ្ញុំ ។ ូម អនុញ្ញាតឱ្យ ខ្ញុំ ដឹ ។ ខ្ញុំ ពិតជា មិន ចាំ ផ្តល់ ប្រាក់ កម្ចី ឱ្យ ពួកគេ មិត្តភក្តិ ។
តើ នៅក្នុង គ្រួសារ របស់ អ្នក មាន មនុស្ស ប៉ុន្មាន នាក់ ?
តើ អ្នក ញ៉ាំ កាហ្វេ ប៉ុន្មាន ប៉េង ក្នុង មួយ ថ្ងៃ ?
តើ អ្នក ត្រូវការ ក្រដាស ប៉ុន្មាន ដុំ ?
តើ ប្រអប់ សូកូឡា ប៉ុន្មាន ប្រអប់ ខ្ញុំ ត្រូវ ទិញ ?
តើ មាន ប្រអប់ សូកូឡា ប៉ុន្មាន ដែល ខ្ញុំ ទទួលបាន ?
តើ មាន មនុស្ស ប៉ុន្មាន ប្រអប់ សូកូឡា ខ្ញុំ គួរ នាំយក មក ?
តើ មាន មនុស្ស ប៉ុន្មាន កំប៉ុង សូដា ?
តើ ធ្វើ ដូចម្តេច ជាច្រើន ធុង ទឹកដោះគោ ?
តើ មាន កញ្ចប់ ស្ករ កៅស៊ូ ប៉ុន្មាន ?
តើ មាន មនុស្ស ប៉ុន្មាន កែវ ស្រាបៀរ ខ្ញុំ គួរ បញ្ជា ?
តើ មាន មនុស្ស ប៉ុន្មាន កំប៉ុង សូដា ខ្ញុំ គួរតែ ទទួលបាន សម្រាប់ គណបក្ស នេះ ដែរ ទេ ?
តើ ធ្វើ ដូចម្តេច ជាច្រើន ធុង ទឹកដោះគោ តើ អ្នកទិញ ជារៀងរាល់ សប្ដាហ៍ ?
តើ ធ្វើ ដូចម្តេច ជាច្រើន ដំបង នៃ តើ អ្នក ទំពាស្ករ កៅស៊ូ ជារៀងរាល់ ថ្ងៃ ?
តើ ធ្វើ ដូចម្តេច ជាច្រើន ដុំ សាប៊ូ តើ អ្នក ចង់បាន ?
តើ អ្នក ផឹក កាហ្វេ ជារៀងរាល់ ថ្ងៃ យ៉ាងដូចម្តេច ដែរ ?
ខ្ញុំ ពិតជា សោកស្តាយ ខ្លាំ ។ ខ្ញុំ មាន លេខ ផ្ទះ ខុស ។
នេះ ជា កាដូ សម្រាប់ អ្នក ។
អ្នក មាន ផ្ទះ គួរ ស្រឡាញ់ ។
សួស្ត ។ សូមអញ្ជើញ ចូលមក ក្នុ ។ ខ្ញុំ រីករាយ ដែល អ្នក អាច ចូលម ។ តើ អ្នក មាន បញ្ហា ណាមួយ ក្នុង ការស្វែងរក ផ្ទះ របស់ យើង ?
សូដា មួយ សំឡេង ដ៏ អស្ចារ្យ ។
គឺជា លំនៅដ្ឋាន របស់ ស្ម៊ីធ បាន កន្លែង ណាមួយ នៅក្នុង សង្កាត់ នេះ ?
ខ្ញុំ នៅ ទីនេះ ដើម្បី មើល យ៉ូហាន ស្ម៊ីធ ។
សូម ដោះ ស្បែកជើង អ្នក ចេញ ផង ។
ខ្ញុំ រីករាយ ដែល អ្នក បាន មក ទីនេះ ។
ចូរ យើង ទទួលយក ការរួមគ្នា ជាថ្មី ម្តង ទៀត ក្នុង ពេល ឆាប់ ។
ពេល ក្រោយ អ្នក ត្រូវតែ មក លេង ខ្ញុំ ម្តង ទៀត ។
អរគុណ ច្រើន ចំពោះ ការមាន រូប ខ្ញុំ ។
អរគុណ ច្រើន ចំពោះ ការអញ្ជើញ រូប ខ្ញុំ ចំពោះ អ្នក ។
ក្រុម មិត្តភក្តិ របស់ ខ្ញុំ ម្នាក់ បាន កំពុងតែ ទទួលបាន ការរួមគ្នា ដើម្បីឱ្យ មាន ភេសជ្ជៈ មួយចំនួន និង ស្ដាប់ តន្ត្រី មួយចំនួន ។
យើង ចង់ឱ្យ មាន អ្នក ជាង សម្រាប់ ភេសជ្ជៈ ។
ហេតុ អ្វី អ្នក មិន ចូលមក ផ្ទះ ខ្ញុំ ថ្ងៃសៅរ៍ ខាងមុខ នេះ ?
ចូរ យើង មាន ពិធី ជប់លៀង មួយ កាលពី ថ្ងៃអាទិត្យ ក្រោយ នេះ ។
ខ្ញុំ សូម អញ្ជើញ អ្នក អាហារ ពេលល្ងាច ក្រោយ ទៀត នៅ ល្ងាច ថ្ងៃសុក្រ ។
ខ្ញុំ ចង់ អញ្ជើញ អ្នក ទៅ ផ្ទះ ខ្ញុំ ។
វា ជា ការប្រមូលផ្តុំ នៃ ការជួបជុំ មិត្តភក្តិ ។
នេះ នឹង ក្លាយជា ការជួបជុំ ក្រៅ ផ្លូវការណ៍ មួយ ។
វា ជា ពិធី ខួបកំណើត មួយ ។
វា ជា ពិធី ខួបកំណើត ភ្ញាក់ផ្អើល ។
វា ជា គណបក្ស ចម្រុះ មួយ ។
វា ជា គណបក្ស អាហារ ពេលល្ងាច ។
ខ្ញុំ រំពឹង ថា នឹង ស្លៀកពាក់ ?
ខាងក្រោម នេះ ជា ផែនទី ទៅកាន់ ផ្ទះ របស់ ខ្ញុំ មួយ ។
ខាងក្រោម នេះ ជា ការណែនាំ ក្នុង ការភោជនីយដ្ឋាន នេះ ។
ខ្ញុំ នឹង ជួប អ្នក នៅ ស្ថានីយ៍ នៅ ប្រាំពីរ ។
ខ្ញុំ នឹង មក យក អ្នក ឡើង តិចតួច បន្ទាប់ពី ប្រាំមួយ ។
ខ្ញុំ គ្រាន់តែ បាន ឮ ការព្យាករ នេ ។ វា ត្រូវបាន សន្មត់ ថា ដើម្បី បញ្ឈប់ ការធ្លាក់ ព្រឹល នៅ ថ្ងៃស្អែក ។
ខ្ញុំ សង្ឃឹម ថា ពួកគេ មាន សិទ្ធិ ។
វា អាចនឹង ស្រស់ស្អាត ដើម្បី មើល ពន្លឺ ថ្ង មួយចំនួន ។
អាកាសធាតុ ស្រស់ស្អាត មិន ចឹង ?
ជា ថ្ងៃ ដែល អស្ចារ្យ ។
ថ្ងៃ ស្រស់ស្អាត ។
ថ្ងៃ នេះ ត្រជាក់ ណាស់ ។
ថ្ងៃ នេះ ភ្លៀង ហើយ ។
ព្រិល កំពុង ធ្លាក់ ថ្ងៃ នេះ ។
ខាងក្រៅ ក្តៅ ណាស់ ។
ខាងក្រៅ ត្រជាក់ ណាស់ ។
នៅ ខាងក្រៅ អាកាសធាតុ ល្អ ណាស់ ។
នៅ ខាងក្រៅ ត្រជាក់ ណាស់ ។
នៅ ខាងក្រៅ មាន សំណើម ណាស់ ។
នៅ ខាងក្រៅ មាន ខ្យល់ ខ្លំាង ណាស់ ។
នៅ ខាងក្រៅ មាន អាធាតុ ត្រជាក់ ។
នៅ ខាងក្រៅ ភ្លៀក ធ្លាក់ ។
នៅ ខាងក្រៅ មាន ព្រិល ធ្លាក់ ។
ភ្លៀង ចាប់ផ្តើម ភ្លៀង ហើយ ។
ភ្លៀង បាន រំាង ហើយ ។
មេឃ ស្រឡះ ល្អ ណាស់ ។
ទៅ ទីនេះ មាន ឱកាស ធ្លាក់ ទឹកកក ប្រហែល៨ ភាគរយ ។
តើ អ្នក អាកាសធាតុ នៅ ទីក្រុង តូក្យូ យ៉ាងម៉េច ដែរ ?
អាកាសធាតុ អនុញ្ញាតឱ្យ នោះ យើង នឹង ចូលទៅ ។
វា នឹង ត្រូវបាន ពន្យា ពេល នៅក្នុង ព្រឹត្តិការណ៍ នៃ ការភ្លៀង ។
ការព្យាករ សម្រាប់ ចុង សប្ដាហ៍ នេះ ប្រាប់ យ៉ាងណា ដែរ ?
ការព្យាករ រយៈពេល វែង នេះ យ៉ាងម៉េច ដែរ ?
តើ អ្វី ទៅ ជា ការសីតុណ្ហភាព ខ្ពស់ នា ពេល បច្ចុប្បន្ន នេះ ?
ការព្យាករ សម្រាប់ ថ្ងៃ នេះ យ៉ាងណា ដែរ ?
ការព្យាករ សម្រាប់ ថ្ងៃស្អែក នេះ យ៉ាងដូចម្តេច ?
ទាក់ទង ទៅ ជន ទាំងអស់ ដែល ចូលរួម នៅក្នុង កិច្ចព្រមព្រៀង នេះ ភ្លាម ។
ខ្ញុំ មិន ប្រាកដ ថា បើសិនជា មាន គំនិត ល្អ នោះ ទេ ។
ខ្ញុំ យល់ស្រប ដែល យើង គួរតែ ទៅ ពិនិត្យមើល សម្ភារៈ ម្តង ទៀត ។
ខ្ញុំ គិត ថា មាន ការខ្ជះខ្ជាយ ពេលវេលា ល្អ មួយ ។
ខ្ញុំ មិន គិត ដូច្នេះ ទ ។ ខ្ញុំ ពិតជា គិត ថា យើង គួរតែ រង់ចាំ រហូតដល់ ថ្ងៃស្អែក ។
ល្អ ប្រសិនបើ អ្នក ទំាង ពីរ ទាមទារ ខ្ញុំ នឹង ទៅជាមួយ អ្នក ។
ខ្ញុំ មិន យល់ស្រប ជាមួយនិង មាន និន្នាការ ទៅ អ្វី ដែល គាត់ បាន និយាយ ថា ។
ខ្ញុំ ចង់ ធ្វើឱ្យ ចំណុច មួយ ។
អ្នក បាន ធ្វើជា ចំណុច របស់ អ្នក ។
ខ្ញុំ ចង់ សង្កត់ធ្ងន់ ទៅ លើ ចំនុច នេះ ។
ចូរ បិទ នៅលើ ការធ្វើឱ្យ ការសម្រេចចិត្ត មួយ ។
តើ អ្នក គិត យ៉ាងម៉េច អំពី ការប្រើប្រាស់ ក្រេប លាប មាត់ ស្ត្រី ?
តើ អ្នក គិត ការយាយី ផ្លូវភេទ នៅក្នុង កន្លែង ការងារ នេះ ?
តើ អ្នក គិត ការកកស្ទះ ចរាចរណ៍ នៅក្នុង ទីក្រុង ដែល មាន ទំហំ ធំ ?
តើ អ្នក មាន យោបល់ ទាក់ទង ការការេម ស្ត្រី ?
តើ អ្នក មាន យោបល់ ទាក់ទង ការយាយី ផ្លូវភេទ នៅក្នុង កន្លែង ការងារ នេះ ?
តើ អ្នក មាន យោបល់ ទាក់ទង ការកកស្ទះ ចរាចរណ៍ នៅក្នុង ទីក្រុង ដ៏ ធំ មួយ ?
ខ្ញុំ ប្រហែលជា វង្វេង ។ ខ្ញុំ កំពុង រក ផ្លូវ ទៅ ធនាគារ អេប៊ីស៊ី ។
ធនាគារ អេប៊ីស៊ី នៅ តំបន់ ខាង ផ្លូវ នេះ ខាងឆ្វេង ។
ខ្ញុំ ត្រូវបាន ជួយ ។
អភ័យទោស ឱ្យ ខ្ញុំ ផង ។
ខ្ញុំ ប្រហែល អាច ជួយ អ្នក បាន ។
ខ្ញុំ សុំទោស ប៉ុន្តែ ខ្ញុំ មិន ស្គាល់ តំបន់ នេះ ទេ ។
ខ្ញុំ ទុំ ទោស ប៉ុន្តែ ខ្ញុំ មិន សូវ ច្បាស់ ពី តំបន់ នេះ ទេ ។
ខ្ញុំ សុំទោស ប៉ុន្តែ មាន អំណាច នៅក្នុង តំបន់ នេះ ទេ ?
