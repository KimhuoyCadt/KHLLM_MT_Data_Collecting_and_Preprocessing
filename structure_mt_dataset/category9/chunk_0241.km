( វ៉ាស៊ីនតោន ) ៖ អតីត ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នៅតែ ចាត់ទុក ខ្លួន ឯង ជា មនុស្ស មាន ឥទ្ធិពល ជាង គេ បំផុត នៅក្នុង គណបក្ស សាធារណរដ្ឋ ដោយ ប្រាប់ ម្ចាស់ ជំនួយ នៃ គណបក្ស មួយ នេះ ថា លោក នឹង ជួយ ឱ្យ ពួកគេ ឈ្នះ នៅក្នុង ការបោះឆ្នោត សភា ពាក់កណ្ដាល អាណត្តិ នៅ ឆ្នាំ ២០២២ ខាងមុខ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃអាទិត្យ ទី១១ ខែមេសា ឆ្នាំ ២០២១ ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការបន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី រហូតដល់ ១៥៧ នាក់ ដែល ភាគ ច្រើន បំផុត ជា អ្នក រស់ នៅ រាជធានី ភ្នំពេញ ខណៈ អ្នកជំងឺ ចំនួន ៧២ នាក់ បាន ជាសះស្បើយ និង អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ។
សេចក្តីប្រកាស ព័ត៌មាន បាន បញ្ជាក់ ថា អ្នក ឆ្លង ទាំង ១៥៧ នាក់ ក្នុង នោះ មាន ករណី នាំចូល ពី ក្រៅ ប្រទេស ម្នាក់ ជា ជនជាតិ នីហ្សេរីយ៉ា មកដល់ កម្ពុជា នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២១ និង ១៥៦ នាក់ ជា ករណី ឆ្លង ក្នុង សហគមន៍ ២០កុម្ភៈ ដែល រួម មាន រាជធានី ភ្នំពេញ ១៤១ នាក់ . ខេត្ត តាកែវ ២នាក់ . ខេត្ត ស្វាយរៀង ៤នាក់ . ខេត្ត កណ្តាល ១នាក់ និង ខេត្ត កោះកុង ៨នាក់ ។
សម្រាប់ អ្នក ជាសះស្បើយ ទាំង ៧២ នាក់ វិញ គឺជា អ្នក ឆ្លង ក្នុង សហគមន៍ នៃ ព្រឹត្តិការណ៍ ២០កុម្ភៈ ដោយ ទទួ លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ប៉ុន្តែ ត្រូវ បន្ត ធ្វើចត្តាឡី ស័ក ១៤ ថ្ងៃ ដើម្បី តាមដាន សុខភាព ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ៧ព្រឹក ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០២១ នេះ កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង សរុប ចំនួន ៤២៣៨ នាក់ ក្នុង នោះ ករណី សហគមន៍ ២០កុម្ភៈ ចំនួន ៣ ៧០៥ នាក់ . អ្នក ជាសះស្បើយ ចំនួន ២១៥២ នាក់ . អ្នក កំពុង សម្រាក ព្យាបាល ចំនួន ២០៥២ នាក់ . អ្នកស្លាប់ ចំនួន ២៩ នាក់ និង ស្លាប់ ដោយ ជំងឺ ផ្សេង ពេល កំពុង ព្យាបាល កូវី ដ១៩ ចំនួន ៥នាក់ ៕ បញ្ជូន មេក្លោង ជួញដូរ គ្រឿងញៀន ជា ស្នងការ រង នគរបាល ខេត្ត កំពត ម្នាក់ និង បក្ខពួក ២នាក់ ទៀត ទៅ តុលាការ ក្រោយ បង្ក្រាប ជាមួយ ថ្នាំញៀន ជិត ២គីឡូក្រាម
លោក គុជ គឹម ឡុង បាន បញ្ជាក់ ថា ពួកគេ ទាំង ៣នាក់ ត្រូវបាន បញ្ជូន មក តុលាការ កាលពី ល្ងាច ម្សិលមិញ និង បញ្ជូន មក ព្រឹក នេះ បន្ត ទៀត ហើយ កំពុង ស្ថិត នៅក្នុង ការសួរនាំ របស់ លោក សេង គឹម ឡាក់ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ បន្ត ទៀត ។
សូម បញ្ជាក់ ថា កម្លាំង នគរបាល ជំនាញ បាន បើក ប្រតិបត្តិការ បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន មួយ ករណី ឃាត់ខ្លួន មនុស្ស ៣នាក់ និង ថ្នាំ ញៀន ជិត ២គីឡូក្រាម ក្នុង នោះ មេក្លោង ជា ស្នងការ រង នគរបាល ខេត្ត កំពត គឺ ឧត្តមសេនីយ៍ ត្រី អ៉ឹម ឈួន ។ ប្រតិបត្តិការ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នៅ ចំណុច ចំណត រថយន្ត ផ្សារ ខាលែន ឌែល ម៉ល ( បឹងកក់ ) ស្ថិត ក្នុង សង្កាត់ ស្រះចក ខណ្ឌ ដូនពេញ ដោយ កម្លាំង មន្ទីរ ប្រឆាំង គ្រឿងញៀន ។
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ត្រឡប់ ផ្ទះ វិញ ដោយ សុវត្ថិភាព ! ស្លាប់ ៣នាក់ និង របួស ៣នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១០ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ៣នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . មិន ប្រកាន់ ស្ដាំ ៕
ក្រសួង សុខាភិបាល៖ ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ នៅ ទូទាំង ប្រទេស កើន ដល់ ចំនួន ជាង ៧៤ម៉ឺន នាក់ គិត ត្រឹម ថ្ងៃទី ១០ ខែមេសា
ខាងក្រោម តារាង ព័ត៌មាន លម្អិត នៃ ការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ របស់ ក្រសួង សុខាភិបាល៖ ខេត្ត ស្វាយរៀង រកឃើញ ករណី វិជ្ជមាន ជំងឺ កូវីដ១៩ លើ ប្រជាពលរដ្ឋ ៤នាក់ ទៀត និង អំពាវនាវ ឲ្យ អ្នក ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល សូម ធ្វើចត្តាឡី ស័ក ហើយ តាមដាន សុខភាព
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស ពី ការរកឃើញ ករណី វិជ្ជមាន ជំងឺ កូវីដ១៩ លើ ប្រជាពលរដ្ឋ ៤នាក់ ដែល ក្រសួង សុខាភិបាល បាន ចេញ ប្រកាស និង សូម អំពាវនាវ ដល់ អ្នក ដែល ប៉ះពាល់ ទាំង ផ្ទាល់ និង ប្រយោល ធ្វើចត្តាឡី ស័ក និង តាមដាន សុខភាព របស់ ខ្លួន ជាប្រចាំ ។
