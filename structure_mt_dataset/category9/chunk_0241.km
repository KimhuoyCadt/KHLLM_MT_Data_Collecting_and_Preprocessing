( បាត់ដំបង ) ៖ ស្រប ពេល ទទួលបាន ទឹកភ្លៀង លើក ដំបូង ក្នុង ឆ្នាំ ២០២១ នេះ ប្រជាពលរដ្ឋ ២នាក់ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ រន្ទះ បាញ់ និង ខូចខាត ផ្ទះ អស់ ២ខ្នង ដោយសារ ពេល ភ្លៀង លាយ ខ្យល់ កន្ត្រាក់ នៅ ស្រុក ភ្នំព្រឹក ខេត្ត បាត់ដំបង នា ល្ងាច ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
រដ្ឋបាល ស្រុក ភ្នំព្រឹក បាន ឲ្យដឹង ថា ក្នុង ពេល ភ្លៀង នោះ គឺ មាន ខ្យល់ កន្ត្រាក់ យ៉ាង ខ្លាំង ថែមទាំង មាន រន្ទះ បាញ់ ២លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ នៅ ទីតាំង ២ករណី ផ្សេង គ្នា ។
ករណី ទី ១៖ កើតឡើង នៅ ភូមិ ពេជ្រ ចិន្តា ឃុំ ពេជ្រ ចិន្តា ស្រុក ភ្នំព្រឹក ដោយ ជនរងគ្រោះ ជា ស្ត្រី មាន ឈ្មោះ ង៉ែត ហឿន អាយុ ៥២ ឆ្នាំ ។ មុនពេល កេីត ហេតុ គាត់ បាន ឈរ មើល កូន ៗ របស់ គាត់ ពូន រង ដាំ ដំឡូង មី ស្រាប់តែ ភ្លាម នោះ ក៏ មាន រន្ទះ បាញ់ បាញ់ គាត់ ស្លាប់ នៅ នឹង ន្លែង តែម្ដង ។
ករណី ទី ២៖ មាន រន្ទះ បាញ់ មួយ ករណី ដែរ ដែល បណ្តាលឲ្យ ស្លាប់ ក្មេងស្រី ម្នាក់ ទៀត មាន ឈ្មោះ អៀង លីណា អាយុ ១២ ឆ្នាំ កេីត ឡេីង នៅ ភូមិ ភ្នំ តូច ឃុំ ពេជ្រ ចិន្តា ស្រុក ភ្នំព្រឹក ។ មុនពេល កេីត ហេតុ ក្មេងស្រី រងគ្រោះ បាន ជិះ កង់ ទៅ រក ម្ដាយ តែ ពេល ត្រលប់មក ផ្ទះ វិញ ដល់ ទី វាល ប្រហែល ១០០ ម៉ែត្រ ពី ផ្ទះ របស់ ខ្លួន ក៏ ត្រូវ រន្ទះ បាញ់ ស្លាប់ ស្រស់ ៗ តែម្ដង ។
ក្រោយពី ចុះ ត្រួតពិនិត្យ រួច មក សមត្ថកិច្ច ក៏ បាន ប្រគល់ សាកសព ជូន សាច់ញាតិ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ។
រដ្ឋបាល ស្រុក ភ្នំព្រឹក ក៏ បាន បញ្ជាក់ ដែរ ថា ក្នុង ថ្ងៃ ដដែល នោះ ក៏ មាន ភ្លៀង លាយឡំ នឹង ខ្យល់ កន្រ្តាក់ បណ្តាលឲ្យ របេីក ដំបូង ផ្ទះ ចំនួន ២ខ្នង ទៀត ដែរ នៅ ភូមិ ភ្នំ តូច ឃុំ ពេជ្រ ចិន្ដា ស្រុក ភ្នំព្រឹក ខេត្ត បាត់ដំបង តែ ពុំ មាន គ្រោះថ្នាក់ ដល់ មនុស្ស នោះ ទេ ៕ លោកជំទាវ អ៊ឹង កន្ថា ផាវី និង ឯកឧត្តម ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោកជំទាវ អ៊ឹង កន្ថា ផាវី រដ្ឋមន្ដ្រី ក្រសួង កិច្ចការ នារី និង ឯកឧត្តម ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
លោកជំទាវ អ៊ឹង កន្ថា ផាវី រដ្ឋមន្ដ្រី ក្រសួង កិច្ចការ នារី និង ឯកឧត្តម កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ម៉ឹង វណ្ណា រុំ និង លោកជំទាវ ឆាយ ក ល្យាណ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម ម៉ឹង វណ្ណា រុំ និង លោកជំទាវ ឆាយ ក ល្យាណ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ម៉ឹង វណ្ណា រុំ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ផែនការ ឧបត្ថម្ភ ថវិកា ៣ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សូម កុំ ប្រើ ទូរស័ព្ទ ពេល កំពុង បើកបរ ! ស្លាប់ ៤នាក់ និង របួស ១៣នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៥ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ១៣នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . ប្រជែង . មិន ប្រកាន់ ស្តាំ និង បត់ គ្រោះថ្នាក់ ៕
( ភ្នំពេញ ) ៖ នៅ យប់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បាន ថ្លែង សារ ជូន ប្រជាពលរដ្ឋ អំពី ការយក សំណាក តេស្ត រក មេរោគ កូវីដ១៩ និង ថ្លែង អំពី ស្ថានភាព ជំងឺ កូវីដ១៩ ដែល កំពុង រីករាលដាល នៅ កម្ពុជា ។
រដ្ឋបាល ខេត្ត កំពត ប្រកាស ពី ការរកឃើញ ស្ដ្រី ម្នាក់ កើត ជំងឺ កូវីដ១៩ នៅ ឃុំ ព្រែក ក្រឹស ស្រុក កំពង់ត្រា ច និង បង្ហាញ ពី តាំង ដែល ស្ដ្រី នោះ បាន ទៅ មុន រកឃើញ វិជ្ជមាន
ក្នុង លិខិត នោះ រដ្ឋបាល ស្រុក កំពង់ត្រា ច បាន គូសបញ្ជាក់ ថា ស្ដ្រី ឈ្មោះ ស៉ឹម ស៉ី មួយ នៅ ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២១ បាន មកដល់ លំនៅឋាន ស្ថិត ក្នុង ភូមិ ព្រៃ ព្រូស ឃុំ ព្រែក ក្រឹស ហើយ តាម ការស្រាវជ្រាវ ស្ដ្រី រូប នេះ បាន ធ្វើដំណើរ មកពី ភ្នំពេញ ដោយ ម៉ូតូ ផ្ទាល់ខ្លួន ជាមួយ ប្ដី ឈ្មោះ គង់ ប្រុស ។
ក្រោយ ទទួលបាន ព័ត៌មាន ពី ការវិលត្រឡប់ ក្រុមការងារ ឃុំ សហការ ជាមួយ មន្ដ្រី សុខាភិបាល ស្រុក ប្រតិបត្តិ កំពង់ត្រា ច បាន ចុះ ពិនិត្យ កំដៅ និង តេស្ដ យក សំណាក ពិនិត្យ ទាំង ប្ដី ប្រពន្ធ ភ្លាម ៗ ដោយ អាការៈ សុខភាព របស់ ពួកគាត់ មិន សូវ ល្អ ក្រុមការងារ បាន បញ្ជូន ពួកគាត់ មក ធ្វើចត្តាឡី ស័ក នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក ។ រហូតមកដល់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្រសួង សុខាភិបាល បាន បង្ហាញ ថា ស្ដ្រី ឈ្មោះ ស៉ឹម ស៉ី មួយ វិជ្ជមាន ជំងឺ កូវីដ១៩ ។
ខាងក្រោម នេះ ជា លិខិត របស់ រដ្ឋបាល ស្រុក កំពង់ត្រា ច និង ទីតាំង ដែល ស្ដ្រី នោះ បាន ទៅ មុន រកឃើញ កើត ជំងឺ កូវីដ ១៩៖
រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ បាន បញ្ជាក់ ថា នៅ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្រោយ ទទួលបាន លទ្ធផល ពិនិត្យ សំណាក ពី វិទ្យាស្ថាន សុខភាព សាធារណៈ ឃើញ ថា មាន ពលករ និង ប្រជាពលរដ្ឋ ចំនួន ៣នាក់ មាន លទ្ធផល វិជ្ជមាន កូវីដ១៩ ដែល មាន សាវតា ដូច ខាងក្រោម៖
* ទី១៖ ឈ្មោះ ថូន ចន្ធូ ភេទ ស្រី អាយុ ៣០ ឆ្នាំ មាន ផ្ទៃពោះ ៩ខែ រស់ នៅ ភូមិ ក្បាល ហុង សង្កាត់ ផ្ទះ ព្រៃ ក្រុង ពោធិ៍សាត់ ពលករ មកពី ភ្នំពេញ តំបន់ សេដ្ឋកិច្ច ពិសេស កំបូល ធ្វើការ រោងចក្រ ផលិត ខ្សែភ្លើង បាន មកដល់ ខេត្ត ពោធិ៍សាត់ កាលពី ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២១ ធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល ចត្តាឡី ស័ករ លាំង យក សំណាក ពិនិត្យ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២១ នៅ វិទ្យាស្ថាន សុខ ភាពសាធារណៈ លទ្ធផល វិជ្ជមាន កូវីដ១៩ ។
* ទី២៖ ឈ្មោះ ណាង ស្រី និត ភេទ ស្រី អាយុ ១៩ ឆ្នាំ រស់ នៅ ភូមិ រហា ទិល ឃុំ តា លោ ស្រុក តា លោ សែន ជ័យ ជា ពលករ មកពី ខេត្ត ព្រះសីហនុ ចំណុច អូរ៥ អ្នក នៅ ជាមួយ ផ្ទះ ឧកញ៉ា ឆេង វុទ្ធី មាន ផ្ទៃពោះ ៦ខែ បាន មកដល់ ខេត្ត ពោធិ៍សាត់ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២១ ធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល ចត្តាឡី ស័ក រលាំង យក សំណាក ពិនិត្យ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២១ នៅ វិទ្យាស្ថាន សុខ ភាពសាធារណៈ លទ្ធផល វិជ្ជមាន កូវីដ១៩ ។
* ទី៣៖ ឈ្មោះ ផាន សំណាង ភេទ ប្រុស អាយុ៣០ ឆ្នាំ រស់ នៅ ភូមិ ក្រសាំ បៅ ឃុំ ក្រពើរ ពីរ ស្រុក វាលវែង ជា អ្នក ដែល បាន ប៉ះពាល់ ផ្ទាល់ ជាមួយ ឈ្មោះ មាស សម្បត្តិ ជា អ្នក មកពី ខេត្ត កណ្តាល ដែល កំពុង ធ្វើចត្តាឡី ស័ក រង់ចាំ លទ្ធផល ពិនិត្យ សំណាក ដែល បាន ចូល ធ្វើចត្តាឡី ស័ក ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២១ នៅ មណ្ឌល ចត្តាឡី ស័ក ប្រម៉ោយ យក សំណាក ពិនិត្យ ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២១ នៅ វិទ្យាស្ថាន សុខភាព សាធារណៈ លទ្ធផល វិជ្ជមាន កូវីដ១៩ ។
ចំពោះ ករណី ខាងលើ រដ្ឋបាល ខេត្ត ដោយ មាន ក្រុមការងារ ស្រាវជ្រាវ ស្វែងរក អ្នក ពាក់ព័ន្ធ បុគ្គល វិជ្ជមាន កូវីដ១៩ កំពុង ធ្វើ ការស្រាវជ្រាវ រក អ្នក ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ប្រយោល មក ធ្វើចត្តាឡី ស័ក ជៀសវាង ឆ្លង ចូល សហគមន៍ ។ បច្ចុប្បន្ន អ្នកវិជ្ជមាន កូវីដ១៩ ទាំង៣ រដ្ឋបាល ខេត្ត ដោយ មាន មន្ទីរ សុខាភិបាល ខេត្ត បាន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ ទីកន្លែង ក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត ដែល រៀបចំ សម្រាប់ អ្នកជំងឺ កូវីដ១៩ ៕
ការអនុម័ត យល់ព្រម នេះ វា នឹង ផ្តល់ លទ្ធភាព ឲ្យ រូប លោក អាច បន្ត កាន់អំណាច រហូតដល់ ឆ្នាំ ២០៣៦ ។
បើ យោង តាម ច្បាប់ ថត ចំលង មួយ ដែល ចេញផ្សាយ នៅលើ គេហទំព័រ ព័ត៌មាន ច្បាប់ របស់ រដ្ឋាភិបាល បាន គូសបញ្ជាក់ ថា មេដឹកនាំ រុស្ស៊ី វ័យ ៦៨ ឆ្នាំ ដែល បាន កាន់អំណាច ជាង ពីរ ទសវត្សរ៍ មក ហើយ នោះ បាន ចុះហត្ថលេខា លើ ច្បាប់ ខាងលើ នៅ ថ្ងៃចន្ទ នេះ ៕
អភិបាល ខេត្ត ព្រៃវែង ចូលរួម អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ខ្មែរ និង ផ្តល់ កាដូ ដប ដាក់ ទឹក ក្តៅ ដល់ មន្ត្រី សាលា ខេត្ត
( ព្រៃវែង ) ៖ លោក ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង នា រសៀល ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ សាលា ខេត្ត ក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ ដែល នឹង ឈានចូល មកដល់ នៅពេល ខាងមុខ នេះ ។
លោក ជា សុមេធី បាន ថ្លែង ធ្វើ ការ ផ្តាំផ្ញើ ដល់ មន្ត្រីរាជការ និង ពលរដ្ឋ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ ការចម្អិន ម្ហូប អាហារ អុជ ធូប និង ទៀន ដើម្បី ចៀសវាង កុំ ឲ្យ មាន អគ្គីភ័យ កើតឡើង ដោយ ការធ្វេសប្រហែស ណាមួយ ដែល ធ្វើឲ្យ រំខាន ក្នុង ថ្ងៃ ចូល ឆ្នាំ ។
លោក អភិបាល ខេត្ត ក៏ បាន អំពាវនាវ ដល់ មន្ត្រីរាជការ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ទប់ស្កាត់ ការពារ ការ ចម្លង កូវីដ១៩ ទាំងអស់ គ្នា តាមរយៈ ការអនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៣ការពារ ៣កុំ ។ រាល់ ការបើកបរ ត្រូវ គោរព ច្បាប់ ចរាចរណ៍ កុំ បើក ប្រជែង យក លឿន តែ ខ្លួន ឯង កុំ ផឹក គ្រឿងស្រវឹង ក្នុង ពេល បើកបរ ត្រូវ មាន ការយោគយល់ គ្នា និង ប្រុងប្រយ័ត្ន ខ្ពស់ ជានិច្ច ទោះបី បើកបរ ជិត ឬ ឆ្ងាយ ដើម្បី សុវត្ថិភាព ក្នុង ថ្ងៃ ចូល ឆ្នាំ ទាំងអស់ គ្នា ។
នៅក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ផ្តល់ នូវ កាដូរ ជា ដប សម្រាប់ ដាក់ ទឹក ក្តៅ ជូន ដល់ មន្ត្រីរាជការ សាលា ខេត្ត ព្រៃវែង ទាំងអស់ ផងដែរ ៕
នៅ ឃុំ ត្រងិល ខេត្ត កំពង់ឆ្នាំង មាន មនុស្ស ៦នាក់ ពាក់ព័ន្ធ នឹង អ្នក កើត កូវីដ១៩ . សូម អ្នក ពាក់ព័ន្ធ ប្រញាប់ ទៅ ធ្វើតេស្ត នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង
បើ តាម សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ក្រុង កំពង់ឆ្នាំង ខេត្ត កំពង់ឆ្នាំង បាន ឲ្យដឹង ដែរ ថា មាន មនុស្ស ២៤ នាក់ បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ដោយ ប្រយោល ជាមួយនឹង លោក សោម ឡូ ដែល ត្រូវបាន ប្រកាស ថា កើត ជំងឺ កូវីដ១៩ នៅ ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ ។ អាជ្ញាធរ ក្រុង កំពង់ឆ្នាំង បាន អំពាវនាវ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ទៅ យក សំណាក ធ្វើតេស្ត នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ជាបន្ទាន់ ។
ខាងក្រោម នេះ ជា របាយការណ៍ របស់ អធិការដ្ឋាន នគរបាល ស្រុក កំពង់លែង៖ លោក ផាម មិញ ជិញ នាយក រដ្ឋមន្ត្រី វៀតណាម ថ្មី ជា នរណា ?
អ្នកនយោបាយ វៀតណាម ដ៏ មាន ឥទ្ធិពល រូប នេះ បាន ស្បថ ចូលកាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ជា ផ្លូវការ នៅ រសៀល ថ្ងៃចន្ទ ទី០៥ ខែមេសា ឆ្នាំ ២០២១ ដើម្បី កាន់ តំណែង រយៈពេល ០៥ ឆ្នាំ ។ នាយក រដ្ឋមន្ត្រី ថ្មី រូប នេះ ត្រូវបាន គេ មើលឃើញ ថា នឹង ព្យាយាម ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ប្រទេស អាស៉ី អាគ្នេយ៍ មួយ នេះ ឲ្យ កាន់តែ រីកចម្រើន ទៅ មុខ ទៀត បើ ទោះបីជា ពិភពលោក ទាំងមូល កំពុង រង ការរាតត្បាត ដោយ ជំងឺ COVID-19 ក៏ដោយ ។
ថ្នាក់ដឹកនាំ ខេត្ត ប៉ៃលិន ប្រារព្ធ ពិធី បួងសួង សុំ ពរ ជ័យ ពី « លោកយាយ យ៉ាត »
ពិធី នេះ ប្រព្រឹត្តទៅ ដោយ មាន ការចូលរួម ពី នាយ ឧត្តមសេនីយ៍ អ៉ី ឈាន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ប៉ៃលិន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត អ្នកតំណាងរាស្ត្រ និង លោកស្រី បាន ស្រី មុំ អភិបាល ខេត្ត ព្រមទាំង ប្រធាន មន្ទីរ គ្រប់ អង្គភាព នៅ អាស្រម លោកយាយ យ៉ាត ក្បែរ ជើង ភ្នំ យ៉ាត ជាប់ ផ្លូវ ជាតិ លេខ ៥៧ ស្ថិត ក្នុង ភូមិ វត្ត សង្កាត់ ប៉ៃលិន ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ដែល ចម្ងាយ ពី ទី រួម ខេត្ត ប្រមាណ ២គីឡូម៉ែត្រ ។
បើ តាម ការបញ្ជាក់ របស់ លោកស្រី បាន ស្រី មុំ ការធ្វើ ពិធី បួងសួង សុំ សេចក្តីសុខ សេចក្តី ចម្រើន នា ពេលនេះ គឺ ចង់បាន ពរ ជ័យ ពី លោកយាយ យ៉ាត ដែល មាន បារមី ថែរក្សា លើ ទឹកដី ត្បូង ពេជ្រ សូម តាម ជួយ បីបាច់ ថែរក្សា ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ប៉ៃលិន និង ប្រទេសជាតិ ឱ្យ ជៀស ផុត ពី គ្រោះ ធម្មជាតិ នានា និង ជំងឺ ដង្កាត់ ផ្សេង ៗ ជាពិសេស ជៀស ចេញ ឱ្យ ផុត ពី ជំងឺ កូវីដ១៩ (Covid-19) ដែល កំពុង ចម្លង រីករាល ដាល នៅក្នុង ប្រទេស និង នៅ ទូទាំង សកលលោក ។
នៅក្នុង ឱកាស នោះ ផងដែរ បើ ទោះបីជា ខេត្ត ប៉ៃលិន ពុំ ទាន់ មាន ករណី កូវីដ - ១៩ ផ្ទុះ ឆ្លង ចូល សហគម ក៏ ពិត មែន តែ ក្នុង នាម ថ្នាក់ដឹកនាំ ខេត្ត លោកស្រី បាន ស្រី មុំ បាន អំពាវនាវ សូម ឱ្យ ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ត្រូវ បន្ត ការប្រុងប្រយ័ត្ន ខ្ពស់ ដើម្បី ការពារ ខ្លួន ពី ជំងឺ ដ៏ កាច សាហាវ នេះ និង ជំងឺ ឆ្លង ផ្សេង ៗ ដោយ អនុវត្ត នូវ វិធានការ “ ៣ការពារ ៣កុំ ” របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ ដូចជា វិធានការ នានា របស់ ក្រសួង សុខាភិបាល ។
សូម បញ្ជាក់ ថា រូបសំណាក ធំ របស់ លោកយាយ យ៉ាត ដែល ស្ថិត នៅក្នុង អាស្រម ក្បែរ ជើង ភ្នំ យ៉ាត នេះ ត្រូវបាន កសាងឡើង នៅក្នុង អំឡុង ខែមេសា ឆ្នាំ ២០១១ គឺ ចំណាយ ថវិកា ផ្ទាល់ របស់ នាយ ឧត្តមសេនីយ៍ អ៊ី ឈាន និង លោកស្រី បាន ស្រី មុំ ដោយ ធ្វើ ពី ថ្ម ភក់ នៅ ខេត្ត កំពង់ធំ មាន កម្ពស់ ៣.៨០ ម៉ែត្រ បល្ល័ង្ក ទំហំ ប្រវែង ២. ៤០ម៉ែត្រ ការ៉េ និង មាន ទម្ងន់ សរុប ៣២តោន ៕
ក្រសួង ការពារ ជាតិ ចាក់ វ៉ាក់សាំង ការពារ កូវីដ លើក ទី១ ជូន កម្លាំងប្រដាប់អាវុធ កើន ដល់ ចំនួន ១៧០. ៤០០ នាក់ ខណៈ ចាក់ លើក ទី២ បាន ចំនួន ១១១. ២១២ នាក់
ខាងក្រោម តារាង បញ្ជី បូកសរុប ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ របស់ លើក ទី១ និង លើក ទី២ របស់ ក្រសួង ការពារ ជា តិ៖ អាជ្ញាធរ អគ្គិសនី កម្ពុជា ឧបត្ថម្ភ ថវិកា ១២០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ អាជ្ញាធរ អគ្គិសនី កម្ពុជា ឧបត្ថម្ភ ថវិកា ១២០ លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
អាជ្ញាធរ អគ្គិសនី កម្ពុជា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ អាជ្ញាធរ អគ្គិសនី កម្ពុជា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម វេជ្ជបណ្ឌិត គីម សួរ ភីរុណ ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ចាម និង លោកជំទាវ វេជ្ជបណ្ឌិត ឱក លីនី ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម វេជ្ជបណ្ឌិត គីម សួរ ភីរុណ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម សន្តិ បណ្ឌិត ម៉ៅ ច័ន្ទ តារា ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម សន្តិ បណ្ឌិត ម៉ៅ ច័ន្ទ តារា រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម សន្តិ បណ្ឌិត ម៉ៅ ច័ន្ទ តារា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ព្រឹទ្ធសភា ឧបត្ថម្ភ ថវិកា ២០ លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ព្រឹទ្ធសភា ឧបត្ថម្ភ ថវិកា ២០ លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ព្រឹទ្ធសភា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( តេហេរ៉ង់ ) ៖ រដ្ឋបាល ចំណីអាហារ និង ឪសថ អ៊ឺរ៉ង់ នៅ ថ្ងៃចន្ទ នេះ បាន ឲ្យដឹង ថា វ៉ាក់សាំង បង្ការ ជំងឺ COVID-19 ដែល ត្រូវបាន បម្រុងទុក សម្រាប់ ប្រទេស អ៉ីរ៉ង់ ក្រោម កម្មវិធី COVAX របស់ អង្គការ សុខភាព ពិភពលោក បាន ទៅដល់ ប្រទេស អ៊ីរ៉ង់ ហើយ កាលពី ថ្ងៃអាទិត្យ សប្តាហ៍ មុន ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃចន្ទ ទី០៥ ខែមេសា ឆ្នាំ ២០២១ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ទេព ង ន អនុប្រធាន ទី២ ព្រឹទ្ធសភា ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ប្រមុខ ការទូត កម្ពុជា នឹង ចូលរួម ក្នុង កិច្ចសន្ទនា ត្រី ភាគី បើក ចំហរ ថ្នាក់ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន - ចក្រភព អង់គ្លេស នៅ ថ្ងៃទី ០៨ ខែមេសា តាម ប្រព័ន្ធ វីដេអូ
របាយការណ៍ បាន បង្ហាញ រយៈពេល ពីរ ថ្ងៃ នេះ អ្នកស្ម័គ្រចិត្ត មក ចាក់ វ៉ាក់សាំង មាន ចំនួន ១៩២. ៦០៦ នាក់ ក្នុង នោះ អ្នកអនុញ្ញាតឱ្យ ចាក់ មាន ចំនួន ១៨៣. ៨៣១ នាក់ និង អ្នក មិន អនុញ្ញាតឱ្យ ចាក់ មាន ចំនួន ៨. ៧០៤ នាក់ ។
របាយការណ៍ របស់ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ផងដែរ ថា ការចាក់ វ៉ាក់សាំង ទាំង៣ ប្រភេទ ( ស៊ីណូ ហ្វាម អាស្ត្រា ហ្សេនីកា និង ស៊ីណូ វ៉ាក់ ) ចាក់ បាន ជិត ៤៦ម៉ឺន នាក់ ហើយ ។
( ភ្នំពេញ ) ៖ នៅ យប់ ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២១ អាជ្ញាធរ និង មន្រ្តី សុខាភិបាល បាន ឲ្យដឹង ថា បងប្អូន អាជីវករ ផ្សារ អូរ ឬស្សី មាន ចំនួន ២០ នាក់ ទៀត ហើយ ត្រូវបាន រកឃើញ វិជ្ជមាន កូវីដ១៩ នាំឲ្យ ចំនួន កើនឡើង រហូតដល់ ៣៦ នាក់ ។ ជាមួយ តួរ លេខ នៃ ការឆ្លង ចេះតែ កើតមាន យ៉ាង ដូច្នេះ អាជ្ញាធរ រាជធានី ភ្នំពេញ សូម បន្ត អំពាវនាវ ឲ្យ បងប្អូន អាជីវករ ផ្សេង ទៀត ទៅ យក សំណាក ជា បន្ទាន់ នៅ វិទ្យាល័យ បាក់ទូក ខណៈ អ្នក បាន ទៅ យក សំណាក មាន ជាង ១០០០ នាក់ ហើយ ។
អភិបាល ខណ្ឌ ៧មករា លោក លឹម សុភា និង របាយការណ៍ របស់ គណៈកម្មការ ផ្សារ អូរ ឬស្សី បាន ឲ្យដឹង ថា កាលពី យប់ មិញ មាន អាជីវករ ចំនួន ២០ នាក់ ទៀត ត្រូវបាន រកឃើញ វិជ្ជមាន កូវីដ ជា បន្តបន្ទាប់ ដែល នាំឲ្យ ចំនួន មាន ការកើនឡើង ដល់ ៣៦ នាក់ ហើយ ។ តែ ទោះជា យ៉ាណា ក្រោយ ការព្រមាន និង អំពាវនាវ របស់ អាជ្ញាធរ នោះ អាជីវករ ជាង ១០០០ នាក់ បាន ទៅ យក សំណាក រួចហើយ ក្នុង ចំណោម អាជីវករ ជាង ៧០០០ នាក់ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ សូម អំពាវនាវ ដល់ អាជីវករ ផ្សេង ទៀត ទៅ យក សំណាក ជា បន្ទាន់ និង បន្ត ធ្វើចត្តាឡី ស័ក ឲ្យបាន ត្រឹមត្រូវ នៅ តាម ផ្ទះ ហើយ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ តាមដាន នៅក្នុង ភូមិ ឬ សង្កាត់ របស់ ខ្លួន តើ មាន នរណា ខ្លះ ដែល លក់ដូរ នៅក្នុង ផ្សារ អូរ ឬស្សី ត្រូវ ចុះ ទៅ ណែនាំឲ្យ ទៅ យក សំណាក និង ធ្វើចត្តាឡី ស័ក ឲ្យបាន ខ្ជាប់ខ្ជួន ។
សម្រាប់ បងប្អូន អាជីវករ ណា ដែល មិន បាន ធ្វើចត្តាឡី ស័ក ឲ្យបាន ត្រឹមត្រូវ នោះ នឹង ត្រូវបាន រកការផាកពិន័យ ដូច ដែល មាន ចែង នៅក្នុង ច្បាប់ ថ្មី ទាក់ទង នឹង ជំងឺ កូវីដ១៩ ។
អាជ្ញាធរ រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ការឲ្យ អាជីវករ ទៅ ពិនិត្យ សំណាក នេះ មិន មែន ជា ការបង្ខិតបង្ខំ ពាក់ព័ន្ធ នឹង សិទ្ធិ សេរីភាព នោះ ឡើយ ប៉ុន្ដែ ពាក់ព័ន្ធ នឹង បញ្ហា សុខភាព ចំបង របស់ បងប្អូន ដើម្បីឲ្យ ដឹង ច្បាស់ ថា អាជីវករ ណា មាន ផ្ទុក ជំងឺ កូវីដ - ១៩ និង អាជីវករ ណា មិន មាន ផ្ទុក ជំងឺ កូវីដ - ១៩ ។
អភិបាល ខណ្ឌ ៧មករា បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ អាជីវករ និង អ្នក ទាំងឡាយ ដែល បាន ឃើញ ឈ្មោះ អ្នក កើត កូវីដ នៅ ផ្សារ អូរ ឬស្សី សូម ទៅ យក សំណាក ជា បន្ទាន់ ដើម្បី ស្វែងរក កូវីដ១៩ ហើយ បើ មិន ព្រម និង បន្ត គេចវេស ទៀត នោះ អាជ្ញាធរ នឹង ប្រើ វិធានការ តាម ច្បាប់ នៅពេល រកឃើញ ថា បុគ្គល ទាំងនោះ បាន ឆ្លង កូវីដ ដោយសារ បាន ប៉ះពាល់ ជាមួយ អ្នកជំងឺ មុន ៗ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ យប់ ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២១ បាន សម្រេច ផ្អាក ការចេញ ចូល ផ្សារ អូរឫស្សី ជា បណ្តោះអាសន្ន រយៈពេល ១៤ ថ្ងៃ ។ ការផ្អាក នេះ ធ្វើឡើង បន្ទាប់ពី រកឃើញ អាជីវករ អនុប្រធាន ផ្សារ និង សន្តិសុខ សរុប ៦នាក់ បាន កើត ជំងឺ កូវីដ១៩ ។
បើ តាម សេចក្តីជូនដំណឹង បាន បញ្ជាក់ ថា ការផ្អាក នេះ ធ្វើឡើង ចាប់ពី ថ្ងៃទី ០៤ រហូតដល់ ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២១ ។ សេចក្តីជូនដំណឹង បាន បន្ថែម ថា ការផ្អាក នេះ ដើម្បី បង្ការ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល មេរោគ កូវីដ១៩ ទៅដល់ អាជីវករ អតិថិជន ក៏ ដូចជា ប្រជាពលរដ្ឋ ចេញ ចូល ផ្សារ ។
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៤៦ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមេសា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៦ នាក់ នោះ មាន ២០ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៥ករណី និង ជនសង្ស័យ ២៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៥ករណី ។
អាជ្ញាធរ រាជធានី ភ្នំពេញ អនុវត្ត បម្រាម គោចរ ឃាត់ យានយន្ត បាន ចំនួន ៩ គ្រឿង ទៀត នៅ យប់ មិញ
( ភ្នំពេញ ) ៖ ឯកឧត្តម ថោង ខុន រដ្ឋមន្ដ្រី ក្រសួង ទេសចរណ៍ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ថោង ខុន និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ឆាយ ឬទ្ធិ សែន និង លោកជំទាវ វង គន្ធារី ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឆាយ ឬទ្ធិ សែន និង លោកជំទាវ វង គន្ធារី ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ឆាយ ឬទ្ធិ សែន និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាព អាកាសធាតុ នៅ កម្ពុជា ចាប់ពី ថ្ងៃទី ០៧ - ១៣ ខែមេសា . តំបន់ មួយចំនួន មាន ភ្លៀង ធ្លាក់ ពី ខ្សោយ ទៅ ច្រើន
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ពី ស្ថានភាព អាកាសធាតុ នៅ កម្ពុជា ចាប់ពី ថ្ងៃទី ០៧ - ១៣ ខែមេសា ឆ្នាំ ២០២១ ។
សូម អាន សេចក្តីជូនដំណឹង ដូច ខាងក្រោម៖ គិត ថ្ងៃ ត្រឹម ថ្ងៃទី ០៥ ខែមេសា ការចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ ទូទាំង ប្រទេស សរុប ចំនួន ៦៣៥. ២៤៤ នាក់
( ភ្នំពេញ ) ៖ គិត ថ្ងៃ ត្រឹម ថ្ងៃទី ០៥ ខែមេសា ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ ទូទាំង ប្រទេស សរុប ចំនួន ៦៣៥. ២៤៤ នាក់ ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ ៕ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ ច្រានចោល ការយក រូបភាព និង ឈ្មោះ អភិបាល ខេត្ត ទៅ បង្កើត គណនី Facebook ក្លែងក្លាយ ដើម្បី ផលប្រយោជន៍ ផ្ទាល់ខ្លួន និង អំពាវនាវ សមត្ថកិច្ច ចាត់ វិធានការ ច្បាប់
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប នា ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ជូន ដំណឹង ថា ប្រជាពលរដ្ឋ ទាំង ២១ នាក់ ដែល ពាក់ព័ន្ធ ជាមួយ អ្នកជំងឺ កូវីដ១៩ ម្នាក់ នៅ ភូមិ ដក ពោធិ៍ សង្កាត់ ស្ល ក្រាម ក្រុង សៀមរាប ត្រូវបាន អាជ្ញាធរ អនុញ្ញាតឲ្យ ត្រលប់ ទៅ ផ្ទះ វិញ ហើយ តែ ត្រូវ បន្ត ធ្វើចត្តាឡី ស័ក រយ: ពេល ១៤ ថ្ងៃ នៅ ផ្ទះ រៀង ៗ ខ្លួន ។
មក ទល់ ថ្ងៃ នេះ អ្នក ពាក់ព័ន្ធ ទាំងនោះ ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន បួន លើក ដូចនេះ រដ្ឋបាល ខេត្ត សម្រេច អនុញ្ញាតឲ្យ អ្នក ពាក់ព័ន្ធ ទាំង ២១ នាក់ នោះ វិល ត្រលប់ ទៅ លំនៅឋាន វិញ និង ណែនាំឲ្យ គ្រប់ អ្នក ពាក់ព័ន្ធ ទាំងនេះ បន្ត ធ្វើចត្តាឡី ស័ក ដាក់ ខ្លួន ឱ្យ នៅ ដាច់ដោយឡែក ពី អ្នកដទៃ រយៈពេល ១៤ ថ្ងៃ នៅ តាម លំនៅឋាន រៀង ៗ ខ្លួន បន្ត ទៀត ។
រដ្ឋបាល ខេត្ត សៀមរាប បាន បញ្ជាក់ ទៀត ថា ក្នុង ករណី ប្រជាពលរដ្ឋ មាន ការប្រែប្រួល សុខភាព ត្រូវ រួសរាន់ ផ្តល់ ព័ត៌មាន មក អាជ្ញាធរ មូលដ្ឋាន ឬ លេខ ទូរស័ព្ទ ០១២ ៩៥៥ ៤៧៤ / ០៧៧ ៧៨៩ ០០១ ដើម្បី ក្រុមការងារ ចាត់ វិធានការ ក្នុង ការយក សំណាក ធ្វើតេស្ត ស្រាវជ្រាវ បន្ត ទៀត ។
ខាងក្រោម តារាង ព័ត៌មាន លម្អិត នៃ ការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ របស់ ក្រសួង សុខាភិបាល៖ រដ្ឋមន្រ្តី កើត រិទ្ធ ដឹកនាំ កិច្ចប្រជុំ រវាង ថ្នាក់ដឹកនាំ ក្រសួង យុត្តិធម៌ ជាមួយ តំណាង រដ្ឋបាល រាជធានី ខេត្ត
( ភ្នំពេញ ) ៖ លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ នៅ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ រវាង ថ្នាក់ដឹកនាំ ក្រសួង យុត្តិធម៌ ជាមួយ តំណាង រដ្ឋបាល រាជធានី ខេត្ត ទាំងអស់ ដើម្បី ពន្យល់ និង ផ្សព្វផ្សាយ អំពី វិធានការ តាម ផ្លូវ ច្បាប់ នានា ទាក់ទង នឹង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក៏ ដូចជា បកស្រាយ រាល់ ចម្ងល់ ទាក់ទង នឹង ការដាក់ចេញ នូវ វិធានការ នានា របស់ រដ្ឋបាល រាជធានី ខេត្ត ។
កិច្ចប្រជុំ នេះ បាន រៀបចំឡើង តាមរយៈ ប្រព័ន្ធ Zoom ដោយ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង យុត្តិធម៌ និង តំណាង រាជធានី - ខេត្ត ទាំងអស់ ផងដែរ ។
សូម បញ្ជាក់ ថា ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស កម្ពុជា ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព នា ថ្មី ៗ នេះ កម្ពុជា បាន ចេញ ច្បាប់ និង អនុក្រឹត្យ ស្តីពី វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ជំងឺ ឆ្លងកាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ផងដែរ ៕
ក្រោយ ការព្រមាន បុរស បើក ម៉ូតូ កង់៣ និង ប្រពន្ធ ដែល ពាក់ព័ន្ធ ជាមួយ អ្នក កើត កូវីដ បាន យល់ព្រម ទៅ ធ្វើចត្តាឡី ស័ក ហើយ
( កំពង់ឆ្នាំង ) ៖ ក្រុម សមត្ថកិច្ច ចម្រុះ នៅ ល្ងាច ថ្ងៃទី ៥ ខែមេសា នេះ បាន ឲ្យដឹង ថា បុរស ឈ្មោះ ពិន ប៉ូ ជា អ្នកបើក ម៉ូតូ កង់៣ ម្នាក់ រស់ នៅ ភូមិ ម៉ុង បារាំង សង្កាត់ ប្អេរ ក្រុង កំពង់ឆ្នាំង ដែល ពាក់ព័ន្ធ នឹង បុរស មាន វិជ្ជមាន កូវី១៩ ឈ្មោះ សោម ឡូ នៅ ភូមិ សង្កាត់ ជាមួយគ្នា ដោយ មាន ការណែនាំ អប់រំ ពី អាជ្ញាធរ មូលដ្ឋាន និង ការព្រមាន ពី សមត្ថកិច្ច អំពី ផ្លូវ ច្បាប់ ផង នោះ គាត់ និង ប្រពន្ធ បាន យល់ព្រម ឡើង រថយន្ត របស់ ក្រុម គ្រូពេទ្យ ជួរ មុខ ទៅ ធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល ចត្តាឡី ស័ក របស់ ខេត្ត ហើយ ។
ដោយឡែក ពួក កូន ៗ របស់ គាត់ ២នាក់ ទៀត ត្រូវបាន អាជ្ញាធរ និង សមត្ថកិច្ច អនុញ្ញាតឲ្យ ធ្វើចត្តាឡី ស័ក នៅក្នុង ផ្ទះ ដោយ មាន សមត្ថកិច្ច មូលដ្ឋាន ប្រចាំ ការ ការពារ យ៉ាង ម៉ឺងម៉ាត់ ផងដែរ ។
សូម ជម្រាប ថា យោង តាម សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ក្រុង កំពង់ឆ្នាំង ខេត្ត កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា មាន មនុស្ស ២៤ នាក់ បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ដោយ ប្រយោល ជាមួយនឹង លោក សោម ឡូ ដែល ត្រូវបាន ប្រកាស ថា កើត ជំងឺ កូវីដ១៩ នៅ ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ ។ អាជ្ញាធរ ក្រុង កំពង់ឆ្នាំង បាន អំពាវនាវ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ទៅ យក សំណាក ធ្វើតេស្ត នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ជាបន្ទាន់ ៕
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ យប់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចុះ ពិនិត្យ និង ចែក ស្បៀងអាហារ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល ជាប់ នៅ ទីតាំង ចត្តាឡី ស័ក ស្ថិត ក្នុង សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ក្រោយ ទីតាំង នោះ មាន អ្នក កើត ជំងឺ កូវីដ ហើយ អាជ្ញាធរ សម្រេច បិទ បណ្ដោះអាសន្ន ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឃួង ស្រេង បាន ឧបត្ថម្ភ នូវ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ជូន ប្រជាពលរដ្ឋ ដែល ជាប់ នៅ ទីតាំង នោះ ចំនួន ១៦០ គ្រួសារ ដោយ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ មួយ បាវ និង មី មួយ កេស ។
បើ តាម លោក ឃួង ស្រេង នៅ ថ្ងៃស្អែក អាជ្ញាធរ នឹង បន្ដ ឧបត្ថម្ភ ស្បៀងអាហារ ជូន ដល់ ប្រជាពលរដ្ឋ ជា បន្ដ បន្ទាប់ ទៀត ដោយ មិន ទុកឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ អត់ ស្បៀងអាហារ ដើម្បី ទទួលទាន គ្រា ដែល កំពុង ធ្វើចត្តាឡី ស័ក នោះ ទេ ។ ដូច្នេះ សូម ប្រជាពលរដ្ឋ កុំ មាន ការព្រួយបារម្ភ ។
លោក ឃួង ស្រេង បាន អះអាង ថា ក្នុង ករណី ប្រជាពលរដ្ឋ ត្រូវការ ទិញ ម្ហូប អាហារ បន្ថែម ទៀត នោះ អាច ទាក់ទង ទៅ លេខ ទូរស័ព្ទ របស់ អ្នកលក់ ដើម្បី ទិញ មក ដាក់ នៅ ខាងមុខ ទីតាំង ចត្តាឡី ស័ក ហើយ ពួកគាត់ អាច ចេញមក យក បាន ។
គួរ ជម្រាប ថា ទីតាំង ខាងលើ នេះ ត្រូវបាន អាជ្ញាធរ រាជធានី ភ្នំពេញ បាន សម្រេច បិទ នៅ ល្ងាច ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ បន្ទាប់ពី រកឃើញ ថា មាន អ្នក ឆ្លង ជំងឺ កូវីដ ជា បន្ដ បន្ទាប់ ៕
ពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ចុះ ប្រតិបត្តិការ ចាក់ ថ្នាំ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន កងកម្លាំង នគរបាល ជាតិ និង កង វិស្វកម្ម ខេត្ត កោះកុង
លោក លេង ផាលី បាន ឲ្យ ភ្នាក់ងារ Fresh News ថា ដើម្បី ចូលរួម ចុះ បេសកកម្ម ចាក់ ថ្នាំ វ៉ាក់សាំង ការពារ ជំងឺ កូវិដ១៩ ជូន ដល់ កងកម្លាំង នគរបាល ជាតិ និង កម្លាំង វិស្វកម្ម ក្រុម លោកគ្រូពេទ្យ ស្ម័គ្រចិត្ត បាន បើក យុទ្ធនាការ ចាក់ ថ្នាំ ការពារ កូវិដ១៩ រយៈពេល ៥ ថ្ងៃ ដោយ គិត ចាប់ពី ថ្ងៃទី៥ ដល់ ទី៩ ខែមេសា ឆ្នាំ ២០២១ ស្ថិត ក្នុង បរិវេណ សាខា កាក បាត ក្រហម កម្ពុជា ខេត្ត កោះកុង ដើម្បីឲ្យ ស្រប តាម អនុសាសន៍ ណែនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
គណៈកម្មាធិការ បាន និយាយ នៅក្នុង របាយការណ៍ របស់ ខ្លួន យ៉ាង ដូច្នេះ ថា « យើង អាច រាប់ ឃើញ ថា មាន អ្នកស្លាប់ ចំនួន ១៨ នាក់ និង ៥៤ នាក់ បាន រងរបួស ... គិត ចាប់តាំងពី ថ្ងៃអាទិត្យ ( ទី០៤ ខែមេសា ) ។ ការវះកាត់ ត្រូវបាន ធ្វើ លើ មនុស្ស ចំនួន ១០នាក់ ខណៈ ដែល មន្ទីរពេទ្យ នៅតែ ទទួលបាន ជនរងគ្រោះ បន្ថែម ទៀត » ។
របាយការណ៍ បាន គូសបញ្ជាក់ ថា អំពើហិង្សា នេះ បាន ចាប់ផ្តើម កាលពី ថ្ងៃសៅរ៍ ( ទី០៣ ខែមេសា ) និង បាន កើនឡើង ខ្លាំង នៅ ថ្ងៃអាទិត្យ ដោយ បន្ថែម ថា ការវាយប្រហារ នៅតែ បន្ត កើត មាន ឡើង ។
គណៈកម្មាធិការ ដដែល នេះ បាន ជំរុញ ឲ្យ រដ្ឋាភិបាល កណ្តាល ធ្វើអន្តរាគមន៍ ដើម្បី បញ្ចប់ ភាពចលាចល ផ្នែក សន្តិសុខ នៅក្នុង ទីក្រុង ក៏ ដូចជា បាន អំពាវនាវ ឲ្យ មាន ការ ការពារ មណ្ឌល សុខភាព និង បុគ្គលិក ពេទ្យ ដើម្បី ជួយ សម្រួល ដល់ ប្រតិបត្តិការ ជួយសង្គ្រោះ ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១
១៖ ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៦៣ នាក់ ថែម ទៀត ខណៈ អ្នកជំងឺ ៩៤ នាក់ ជាសះស្បើយ
៣៖ ក្រសួង សុខាភិបាល ប្រកាស អំពី ករណី ជនជាតិ ចិន ម្នាក់ អាយុ ៤២ ឆ្នាំ ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩
៤៖ លោក ង្វៀង សួន ហ៊្វុក ជាប់ ឆ្នោត ជា ប្រធានាធិបតី ថ្មី របស់ វៀតណាម
៥៖ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ លិខិត អបអរសាទរ លោក ង្វៀង សួន ហ៊្វុក ដែល ត្រូវបាន តែងតាំង ជា ប្រធានាធិបតី ថ្មី របស់ វៀតណាម
៧៖ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ លិខិត អបអរសាទរ ជូន លោក ផាម មិញ ជិញ ដែល ត្រូវបាន ជ្រើសតាំង ជា នាយក រដ្ឋមន្រ្តី ថ្មី វៀតណាម
៩៖ ព្រះមហាក្សត្រ និង ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ បាន យាង មកដល់ ប្រទេស កម្ពុជា វិញ ហើយ
១០៖ ថៃ រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ ជិត ២០០ នាក់ ទៀត នៅក្នុង របាយការណ៍ ថ្ងៃចន្ទ នេះ
១១៖ សប្បុរសជន ដែល បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
១៣៖ សាលា រាជធានី ភ្នំពេញ អំពាវនាវ ឲ្យ អាជីវករ ទាំងអស់ នៅ ផ្សារ អូរឫស្សី ទៅ យក សំណាក ជា បន្ទាន់ . បើ អាជីវករ ណា គេចវេស ទៅ យក សំណាក មិន ឲ្យ ចូល លក់ ឡើយ ក្រោយ បើក ផ្សារ ឡើងវិញ
១៥៖ វិទ្យាល័យ បាក់ទូក ជា កន្លែង សម្រាប់ យក សំណាក របស់ អាជីវករ ទាំងអស់ នៅ ផ្សារ អូរឫស្សី
១៦៖ គ្រោះ ទឹក ជំនន់ នៅ ឥណ្ឌូណេស៊ី និង ទីម័រ ខាងកើត ផ្តាច់ ជីវិត មនុស្ស ៧៦ នាក់
១៧៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់៖ សម្តេច តេជោ ហ៊ុន សែន មិន ដែល មាន ទម្លាប់ ទុក ប្រជាជន ចោល ក្នុង គ្រា លំបាក នោះ ឡើយ
១៨៖ ប្រ៊ុយណេ អះអាង ថា បណ្តា មេដឹកនាំ អាស៊ាន នឹង រៀបចំ កិច្ចប្រជុំ ស្តីពី ស្ថានការណ៍ នៅ មីយ៉ាន់ម៉ា នៅក្នុង ទីក្រុង ហ្សាការតា
១៩៖ រដ្ឋមន្រ្ដី ក្រសួង សុខាភិបាល៖ ៣ការពារ ៣កុំ បូក នឹង ការចាក់ វ៉ាក់សាំង និង មិន ចាំបាច់ កុំ ចេញពី ផ្ទះ នឹង អាច បិទ បញ្ចប់ ព្រឹត្ដិការណ៍ « សហគមន៍ ២០កុម្ភៈ »ក្នុង ពេល ដ៏ ឆាប់
២១៖ ក្រសួង សុខាភិបាល នឹង ពង្រីក ទីតាំង មន្ទីរពិសោធន៍ តេស្ដ រក កូវីដ១៩ បន្ថែម ទៀត នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប នឹង ការឆ្លង រាតត្បាត នៅក្នុង សហគមន៍
២២៖ មនុស្ស ស្លាប់ កើន ដល់ ២៦ នាក់ ក្នុង ករណី លិច សាឡាង ដឹក អ្នកដំណើរ នៅ បង់ក្លាដែស
២៣៖ អាជ្ញាធរ អំពាវនាវ ឲ្យ ក្រុម អាជីវករ នៅ ផ្សារ ចាស់ ដែល ជាប់ពាក់ព័ន្ធ និង មាន តូប នៅក្បែរ តូប អ្នក កើត កូវីដ ម្នាក់ ទៅ យក សំណាក . បើ គេចវេស នឹង ប្រឈម វិធានការ រដ្ឋបាល
២៤៖ ចិន នឹង បរិច្ចាគ វ៉ាក់សាំង ចំនួន ១៥០.០០០ ដូស ដល់ ប្រទេស អែល សាល់ វ៉ាឌ័រ
២៥៖ ៤ ថ្ងៃ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ចាក់ បាន ជាង ១៤ម៉ឺន នាក់
២៦៖ ប្រជាជន ប៉ាគីស្ថាន នាំគ្នា សម្រុក ទិញ វ៉ាក់សាំង កូវីដ - ១៩ របស់ រុស្ស៊ី ខណៈ ទីផ្សារ ឯកជន បើក លក់
២៧៖ សម្ដេច តេជោ ហ៊ុន សែន ផ្ដល់ អនុសាសន៍ ៥ ចំណុច ដល់ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ និង ពលរដ្ឋ ដើម្បី បំផុស ស្មារតី ទិញ និង ប្រើប្រាស់ ផលិតផល ខ្មែរ
២៩៖ ខេត្ត ចំនួន ៣៤ នៅ ថៃ រង ការបំផ្លិចបំផ្លាញ ដោយសារ ព្យុះ ហើយ មនុស្ស ម្នាក់ បាត់បង់ជីវិត
៣០៖ នាយក រដ្ឋមន្ត្រី អង់គ្លេស នឹង ដាក់ ចេញ ផែនការ បើក ដំណើរការ សេដ្ឋកិច្ច ឡើងវិញ
៥៖ ចំណេះដឹង ទូទៅ៖ មិន គួរឱ្យ ជឿ ថា កន្លែង ដែល ជ្រៅ ជាង គេ បំផុត របស់ ផែនដី គឺ វែង ជាង កម្ពស់ ភ្នំ អេវឺរ៉េស នោះ ទៅ ទៀត
៦៖ LG បញ្ជាក់ ជា ផ្លូវការ នៅ ថ្ងៃ នេះ ថា ខ្លួន បាន សម្រេចចិត្ត ចាកចេញ ពី អាជីវកម្ម ទូរស័ព្ទ ចល័ត
៧៖ ក្រោយ ព្យាបាល ១៥ ថ្ងៃ សួស វីហ្សា ធូរស្បើយ ច្រើន និង ត្រៀម ចេញ ទៅ ផ្ទះ ប្រសិនបើ បន្ត ធ្វើតេស្ត សំណាក « អវិជ្ជមាន »
៨៖ តារាចម្រៀង ហង្ស មាស ធែល ថៃ បញ្ជាក់ ថា ជាសះស្បើយ ពី ជំងឺ កូវីដ - ១៩ បន្ទាប់ពី ទទួលបាន ការយកចិត្តទុកដាក់ ព្យាបាល ពី ក្រុម គ្រូពេទ្យ
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឱក តារា រិទ្ធិ រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង គ្រួសារ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ឱក តារា រិទ្ធិ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ហ្វីលីពីន បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ ថ្មី ៗ ចំនួន ៨. ៣៥៥ ករណី និង ស្លាប់ ១០នាក់ បន្ថែម ទៀត នៅក្នុង របាយការណ៍ ថ្ងៃ នេះ
លោក ឈាង សុវណ្ណ រតនៈ អគ្គ នាយក ប្រ៊ូវ កាហ្វេ ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
លោក ឈាង សុវណ្ណ រតនៈ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សូម កុំ ចង់ សាកល្បង ប្រើ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែ មេសា៖ បង្ក្រាប ៨ករណី ឃាត់ខ្លួន ១៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៤ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១ករណី និង ជួញដូរ ៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ១៦ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៦៣ ករណី ឃាត់ មនុស្ស ១៣០ នាក់ ( ស្រី ៧នាក់ )៕ ឯកឧត្តម បណ្ឌិត សភាចារ្យ ហ៊ាន សាហ៊ីប និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១០លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត សភាចារ្យ ហ៊ាន សាហ៊ីប រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១០លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម បណ្ឌិត សភាចារ្យ ហ៊ាន សាហ៊ីប និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា អនុប្រធាន ទី១ ព្រឹទ្ធសភា និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គណៈកម្មាធិការ វិនិយោគ កម្ពុជា ឧបត្ថម្ភ ថវិកា ៤ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ )៖ គណៈកម្មាធិការ វិនិយោគ កម្ពុជា ឧបត្ថម្ភ ថវិកា ៤ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
គណៈកម្មាធិការ វិនិយោគ កម្ពុជា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ហង្ស វិចិត្រ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៥លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម ហង្ស វិចិត្រ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៥លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ហង្ស វិចិត្រ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកស្រី Apisamai បាន គូសបញ្ជាក់ ថា ជុំវិញ បញ្ហា នេះ អាជ្ញាធរ អាច បង្កើន ការរឹតត្បឹត បន្ថែម ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ ឆ្លង ដ៏ កាច សាហាវ នេះ ដូចជា ការបិទ ជា បណ្តោះអាសន្ន នូវ កន្លែង កម្សាន្ត មួយចំនួន ឬ តំបន់ ទាំងមូល ដែល មាន កន្លែង កម្សាន្ត ជាច្រើន ស្ថិត នៅ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ម៉ែន បូរិកា និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ម៉ែន បូរិកា និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ម៉ែន បូរិកា និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
