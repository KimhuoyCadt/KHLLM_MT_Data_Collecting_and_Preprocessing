( ភ្នំពេញ ) ៖ លោក លឹម គាន ហោ រដ្ឋមន្ដ្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ផ្ញើ សារ មួយ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ លោក ម៉ៅ អាយុទ្ធ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ដែល បាន បាត់បង់ជីវិត ដោយសារ ជំងឺ កូវីដ១៩ កាលពី ល្ងាច ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ ។
លោក លឹម គាន ហោ បាន គូសបញ្ជាក់ ថា « យើងខ្ញុំ ទាំងអស់ គ្នា ជា ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម មាន ក្តី រន្ធត់ ចិត្ត យ៉ាង ខ្លាំង ដោយ បាន ទទួល ដំណឹង ថា ឯកឧត្តម ម៉ៅ អាយុទ្ធ ដែល ត្រូវ ជា ឪពុក ជីតា បាន ទទួលមរណភាព នៅ ថ្ងៃព្រហស្បតិ៍ ៤កើត ខែពិសាខ ឆ្នាំ ឆ្លូវ ទោស័ក ព .ស . ២៥៦៤ ត្រូវនឹង ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ ក្នុង ជន្មាយុ ៧៧ ឆ្នាំ ដោយ រោគា ពាធ » ។
លោក រដ្ឋមន្ដ្រី បាន ចាត់ទុក ថា មរណភាព របស់ លោក ម៉ៅ អាយុទ្ធ គឺជា ការបាត់បង់ នូវ ធនធាន មនុស្ស ដ៏ ឆ្នើម មួយ រូប ក្នុង វិស័យ ព័ត៌មាន សិល្បៈ វប្បធម៌ ក្នុង ឋានៈ លោក ជា រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ក វីនិពន្ធ និង ជា ផលិត ករ ភាពយន្ត ដ៏ មាន ទេពកោសល្យ និង ប៉ិនប្រសព្វ ។
លោក បន្ថែម ថា « ក្នុង ឱកាស ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម ចូលរួម រំលែក នូវ មរណទុក្ខ ជាមួយ ក្រុមគ្រួសារ ដោយ សេចក្តីសង្វេគ ជា ទីបំផុត និង សូម ឧទ្ទិស បួងសួង សុំ ឱ្យ ដួង វិញ្ញាណក្ខន្ធ របស់ ឯកឧត្តម ម៉ៅ អាយុទ្ធ បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។ សូម ក្រុមគ្រួសារ នៃ សព ទទួល នូវ ការរំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ពី យើងខ្ញុំ ទាំងអស់ គ្នា » ។
ក្រសួង ការងារ បញ្ជាក់ បន្ថែម ពី ប្រភេទ រោងចក្រ សហគ្រាស និង សិប្បកម្ម ដែល អាច ស្នើសុំ បុគ្គលិក ចាំបាច់ បំផុត
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តោះបណ្តាល វិជ្ជាជីវៈ បាន ចេញ សេចក្តី បញ្ជាក់ បន្ថែម អំពី ប្រភេទ រោងចក្រ សហគ្រាស និង សិប្បកម្ម ដែល អាច ស្នើសុំ បុគ្គលិក ចាំបាច់ បំផុត ដើម្បី ប្រចាំ ការ និង អំពី ឯកសារ តម្រូវ ក្នុង ពេល ធ្វើដំណើរ ទៅ បំពេញ ការងារ ឬ ប្រកប មុខរបរ ឬ អាជីវកម្ម ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កណ្តាល នឹង បន្ត ផ្តល់ « លិខិត អនុញ្ញាត ចេញ - ចូល » ទៅ តាម សំណូមពរ និង តម្រូវការ ជាក់ស្តែង ដល់ តំណាង រោងចក្រ សហគ្រាស និង សិប្បកម្ម ដែល ត្រូវបាន អនុញ្ញាតឱ្យ ដំណើរការ សកម្មភាព អាជីវកម្ម ក្នុង អំឡុង ពេល នៃ ការអនុវត្ត វិធានការបិទ ខ្ទប់ ជា បណ្តោះអាសន្ន នៅ រៀងរាល់ ម៉ោង ធ្វើការ ។
ក្នុង សេចក្ដីសម្រេច នោះ អភិបាល ខេត្ត ព្រះសីហនុ បាន កំណត់ ថា អាជីវកម្ម លក់ដូរ ទាំងអស់ នៅ ផ្សារ លើ ត្រូវ ផ្អាក បណ្ដោះអាសន្ន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ម៉ោង ០៣៖០០ នាទី រសៀល ថ្ងៃទី ១៦ ដល់ ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ ដើម្បី ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ១៩ ។ លោក គួច ចំរើន បាន សង្កត់ធ្ងន់ ទៀត ថា អាជីវករ លក់ដូរ នៅក្នុង ផ្សារ លើ ទាំងអស់ មាន កាតព្វកិច្ច ត្រូវ ទៅ យក សំណាក ដើម្បី រក ជំងឺ កូវីដ ។
អភិបាល ខេត្ត បាន បន្ថែម ថា ក្រុមការងារ ឆ្លើយតប បន្ទាន់ នៃ មន្ទីរ សុខាភិបាល នឹង ចុះ យក វត្ថុ សំណាក ពី អាជីវករ ទាំងអស់ នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២១ នៅ ផ្សារ លើ ក្រុង ព្រះសីហនុ ។ ក្នុង ករណី បងប្អូន អាជីវករ ណា ខកខាន មិន បាន ទៅ ផ្ដល់ វត្ថុ សំណាក តាម ការកំណត់ ខាងលើ ត្រូវ ទៅ ផ្ដល់ វត្ថុ សំណាក នៅ វេទិកា ៧មករា រៀងរាល់ ម៉ោង ធ្វើការ ( រួមទាំង ថ្ងៃ ឈប់សម្រាក ) ។
ជាមួយគ្នា នេះ អាជីវករ ទាំងអស់ ព្រមទាំង ក្រុមគ្រួសារ ត្រូវ ធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ របស់ ខ្លួន ឲ្យបាន ត្រឹមត្រូវ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ដោយឡែក អាជីរកម្ម លក់ដូរ ដែល ត្រូវបាន អនុញ្ញាត នោះ រួម មាន ការលក់ដូរ គ្រឿង ឧបភោគ បរិភោគ ( បន្លែ ផ្លែ ឈើ ត្រី សាច់ គ្រឿងទេស គ្រាប់ ធញ្ញជាតិ អង្ករ ជាដើម និង អាជីវករ លក់ អាហារ ឆ្អិន ស្រាប់ ( គុយ ទាវ បាយ ឆា មី ឆា បបរ នំបញ្ចុក បាញ់ ស៊ុង និង បង្អែក គ្រប់ មុខ ) និង លក់ ភេសជ្ជៈ ប៉ុន្ដែ ត្រូវ ផ្អាក បណ្ដោះអាសន្ន រយៈពេល ៣ ថ្ងៃ ( ថ្ងៃទី ១៦ ១៧ និង ថ្ងៃទី ១៨ ) ដើម្បី បាញ់ ថ្នាំ សម្លាប់ មេរោគ និង លាង សម្អាត អនាម័យ នៅក្នុង ផ្សារ ទាំងមូល ។
ក្នុង សេចក្ដីសម្រេច នោះ បាន បន្ថែម ទៀត ថា ពេល អាជីវករ លក់ដូរ គ្រឿង ឧបភោគ បរិភោគ មាន លិខិត បញ្ជាក់ អវិជ្ជមាន ជំងឺ កូវីដ១៩ ( លើក ទី១ ) ពី មន្ទីរ សុខាភិបាល ខេត្ត អាច អនុញ្ញាតឲ្យ ចូលក់ដូរ វិញ បាន ហើយ ការលក់ អាហារ ឆ្អិន ស្រាប់ និង ភេសជ្ជ អាច អនុញ្ញាតឲ្យ លក់ដូរ បាន ប៉ុន្ដែ ត្រូវ វេចខ្ចប់ ជូន អតិថិជន ។
សូម ជម្រាប ជូន ថា គិត ត្រឹម រសៀល ថ្ងៃទី ១៦ ខែម សា ឆ្នាំ ២០២១ នេះ អាជីវករ ផ្សារ លើ ត្រូវបាន រកឃើញ ថា ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ១៣នាក់ រួច មកហើយ ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត នឹង ចាត់ មន្ទីរ ពាណិជ្ជកម្ម ឲ្យ អង្កេត តាមដាន នូវ តម្លៃ ទំនិញ គ្រប់ ប្រភេទ ដែល បាន ដាក់ លក់ លើ ទីផ្សារ ក្នុង ខេត្ត ព្រះសីហនុ ។ ក្នុង ករណី រកឃើញ ថា មាន អាជីវករ ណា ធ្វើ ការតម្លើង ថ្លៃ ទំនិញ ខុស ប្រក្រតី រដ្ឋបាល ខេត្ត នឹង ចាត់ វិធានការដាក់ ពិន័យ រដ្ឋបាល យ៉ាង តឹងរឹង បំផុត ហើយ បើ ការតម្លើង ថ្លៃ នេះ បង្ក ចលាចល ក្នុង សង្គម អាជីវករ នោះ នឹង ប្រឈមមុខ ផ្លូវ ច្បាប់ ដោយ មិន លើកលែង ឡើយ ៕
