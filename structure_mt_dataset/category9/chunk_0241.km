( ភ្នំពេញ ) ៖ នៅ យប់ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២១ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ថ្លែង អំពី ស្ថានភាព ជំងឺ កូវីដ១៩ នៅ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។ សូម ទស្សនា វិដេអូ ទាំង ស្រុង៖ ភាសា ចិន ក្លាយជា ភាសា ផ្លូវ ការ ទី៦ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក
លោក រដ្ឋមន្ត្រី ថោង ខុន បាន ឲ្យដឹង ថា ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា បាន ផ្ញើ ដីកា បញ្ជូន របស់ ក្រសួង ការបរទេស សហភាព អឺរ៉ុប និង កិច្ចសហប្រតិបត្តិការ អេស្ប៉ាញ ស្តីពី ការចូល ជាធរមាន នូវ វិសោធនកម្ម នៃ លក្ខន្តិកៈ អង្គការ ទេសចរណ៍ ពិភពលោក ដែល ភាសា ចិន បាន ក្លាយជា ភាសា ផ្លូវការ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក កាលពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ។
នៅក្នុង កិច្ចប្រជុំ លើ ការអនុម័ត គាំទ្រ ភាសា ចិន ឲ្យ ក្លាយជា ភាសា ផ្លូវ ការ ទី៦ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក បាន ប្រារព្ធ ធ្វើឡើង ក្នុង កិច្ចប្រជុំ មហាសន្និបាទ អង្គការ ទេសចរណ៍ ពិភពលោក នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០០៧ នៅ ប្រទេស កូឡុំប៊ី ហើយ អង្គ សន្និបាទ បាន តម្រូវឲ្យ រដ្ឋ ជា សមាជិក ធ្វើ ការគាំទ្រ តាមរយៈ ការផ្ញើ លិខិត គាំទ្រ ជា ផ្លូវការមក ក្រសួង ការបរទេស សហភាព អឺរ៉ុប និង កិច្ចសហប្រតិបត្តិការ អេស្ប៉ាញ ។
នៅក្នុង លក្ខន្តិកៈ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក ដើម្បីឲ្យ ភាសា ចិន ត្រូវបាន ប្រើប្រាស់ ជា ផ្លូវការ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក តម្រូវឲ្យ មាន ការគាំទ្រ ចំនួន ២/ ៣ នៃ រដ្ឋ សមាជិក សរុប ១៥៩ ។
ជាមួយគ្នា នោះ ដែរ រដ្ឋ សមាជិក អង្គការ ទេសចរណ៍ ពិភពលោក ចំនួន ១០៦ បាន ផ្ញើ លិខិត គាំទ្រ លើ ការប្រើប្រាស់ ភាសា ចិន ជា ផ្លូវការ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក តាមរយៈ ការផ្តល់ ការគាំទ្រ ផ្ទាល់ ចុងក្រោយ ដើម្បី បង្រ្គប់ នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២១ ក្នុង នោះ កម្ពុជា ក៏ បាន ផ្ញើ លិខិត គាំទ្រ រួចហើយ ដែរ តាំងពី ឆ្នាំ ២០១២ ។
ក្នុង នាម តំណាង ឲ្យ កម្ពុជា ដែល ជា រដ្ឋ សមាជិក នៃ អង្គការ ទេសចរណ៍ ពិភពលោក ដែរ នោះ ក្រសួង ទេសចរណ៍ កម្ពុជា ក៏ កំពុង រៀបចំ លិខិត អបអរសាទរ ជូន ក្រសួង វប្បធម៌ និង ទេសចរណ៍ ចិន និង ស្ថានទូត ចិន ប្រចាំ កម្ពុជា ផងដែរ ដេីម្បី សម្ដែង ការអបអរសាទរ ដែល ភាសា ចិន បាន ក្លាយជា ភាសា ផ្លូវការ របស់ អង្គការ ទេសចរណ៍ ពិភពលោក នេះ ។
សេចក្តីថ្លែងការណ៍ ដដែល នេះ បាន និយាយ ទៀត ថា ការអនុញ្ញាត នេះ នឹង ត្រូវ ពិនិត្យ ឡើងវិញ រៀងរាល់ ត្រី មាស ម្តង ទៅ លើ ទិន្នន័យ ដែល រក្សាទុក ទាក់ទង នឹង សុវត្ថិភាព ប្រសិទ្ធភាព និង គុណភាព នៃ វ៉ាក់សាំង ។
ប្រមុខ ការទូត កម្ពុជា - វៀតណាម អញ្ជើញ គ្នា ធ្វើ ទស្សនកិច្ច ផ្លូវការ ទៅ វិញ ទៅ មក
ការអញ្ជើញ នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា បាន ជួប សន្ទនា តាម ទូរស័ព្ទ ជាមួយ លោក ប៊ូយ ថាញ់ សឺន ដើម្បី អបអរសាទរ ដែល ត្រូវបាន តែងតាំង ជា រដ្ឋមន្រ្តី ក្រសួង ការបរទេស នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម នា ពេល ថ្មី ៗ នេះ ។
ក្រសួង ការបរទេស កម្ពុជា បាន បញ្ជាក់ ថា៖ « លោក ប្រាក់ សុខុន បាន អញ្ជើញ លោក ប៊ូយ ថាញ់ សឺន មក បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ កម្ពុជា ក្នុង ពេលវេលា សមស្រប និង ធ្វើជា សហ ប្រធាន កិច្ចប្រជុំ គណៈកម្មការ ចម្រុះ កម្ពុជា - វៀតណាម (JC) លើក ទី១៩ ដែល គ្រោង នឹង រៀបចំ នៅ កម្ពុជា នា ចុង ឆ្នាំ ២០២១ នេះ » ។
លោក ប៊ូយ ថាញ់ សឺន ក៏ បាន អញ្ជើញ លោក ប្រាក់ សុខុន ទៅ បំពេញ ទស្សនកិច្ច នៅ វៀតណាម ក្នុង ពេលវេលា សមស្រប ផងដែរ ។ រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ បាន ទទួលយក ការអញ្ជើញ នេះ ដោយ សេចក្តី សោមនស្ស រីករាយ ។
ក្នុង អំឡុង កិច្ចសន្ទនា តាម ទូរស័ព្ទ រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ បាន ពិភាក្សា ដោយ ស្មោះត្រង់ និង ភាតរភាព អំពី ទំនាក់ទំនង ទ្វេ ភាគី និង បាន សម្តែង នូវ ការពេញចិត្ត ចំពោះ ការកើនឡើង ជាលំដាប់ នូវ ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ នៅលើ វិស័យ ជាច្រើន រួម មាន វិស័យ អប់រំ ពាណិជ្ជកម្ម វិនិយោគ ថាមពល ការតភ្ជាប់ និង សន្តិសុខ ស្រប ពេល ជាមួយ ការផ្ទុះឡើង នូវ ជំងឺ កូវីដ - ១៩ ។
រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ បាន កោតសរសើរ ចំពោះ វិធានការ និង កិច្ចសហការ រវាង ភាគី ទាំង ពីរ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ រាតត្បាត កូវីដ - ១៩ ។ ក្នុង ន័យ នេះ លោក ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ រដ្ឋាភិបាល និង ប្រជាជន វៀតណាម ដែល បាន ផ្តល់ សម្ភារៈ វេជ្ជសាស្រ្ត និង ការគាំទ្រ ផ្នែក ហិរញ្ញវត្ថុ ជូន ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា នៅក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី ប្រយុទ្ធ ប្រឆាំង ជំងឺ រាតត្បាត កូវីដ - ១៩ ។
ក្រៅពី កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ ក៏ បាន ផ្លាស់ប្តូរ ទស្សនៈ គ្នា លើ បញ្ហា តំបន់ និង អន្តរជាតិ ដែល ជា ផលប្រយោជន៍ រួម ។ ក្នុង បរិបទ នេះ រដ្ឋមន្រ្តី ការបរទេស វៀតណាម បាន បញ្ជាក់ ជាថ្មី នូវ ការគាំទ្រ ដ៏ ពេញលេញ របស់ ប្រទេស វៀតណាម ចំពោះ ប្រទេស កម្ពុជា ក្នុង នាម ជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល អាស៊ី - អឺរ៉ុប លើក ទី ១៣ (ASEM13) នៅ ចុង ឆ្នាំ ២០២១ និង ធ្វើជា ប្រធាន ប្ដូរ វេន អាស៊ាន នៅ ឆ្នាំ ២០២២ ខាងមុខ ៕
ប្រមុខ ការទូត កម្ពុជា ជួប សន្ទនា តាម ទូរស័ព្ទ ជាមួយ ប្រមុខ ការទូត វៀតណាម ថ្មី
