( ភ្នំពេញ ) ៖ លោក ឌិត មុន្ទី ប្រធាន តុលាការ កំពូល បាន ចេញ សម្រេច ដោយ អនុញ្ញាតឱ្យ មន្ដ្រី តុលាការ កំពូល និង មហា អយ្យការ អម សាលា កំពូល ទាំងអស់ បំពេញ ការងារ ពី ចម្ងាយ ឬ តាម ប្រព័ន្ធ អនឡាញ ក្នុង រយៈពេល បិទ ខ្ទប់ ចាប់ពី ថ្ងៃទី ១៩ ដល់ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ ដោយ មិន ចាំបាច់ មក បំពេញ ការងារ ក្នុង ស្ថាប័ន នោះ ទេ ។
បើ តាម សេចក្តីសម្រេច របស់ លោក កិតិ្ត នីតិកោសល បណ្ឌិត ឌិត មុន្ទី ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ បាន ឱ្យដឹង ថា ការសម្រេច បែប នេះ របស់ ប្រធាន តុលាការ កំពូល គឺ ធ្វើឡើង ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ នៅក្នុង ស្ថាប័ន តុលាការ កំពូល និង មហា អយ្យការ អម តុលាការ កំពូល ។
ក្នុង សេចក្តីសម្រេច ដដែល បាន បញ្ជាក់ ថា ត្រូវបាន ចាត់តាំង មន្ត្រី រដ្ឋបាល ឱ្យ មក ប្រចាំ ការ តាម វេន នៅ តុលាការ កំពូល និង មហា អយ្យការ អម តុលាការ កំពូល ចាប់ពី ថ្ងៃទី ១៩ ដល់ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២១ ចំនួន ៣វេន ផងដែរ ។ ខណៈ មន្ត្រី ប្រចាំ ការ តាម វេន ត្រូវ ទទួល ឯកសារ ពាក្យបណ្តឹង ឬ ព័ត៌មាន ផ្សេង ៗ ហើយ ថតចម្លង ផ្ញើ ជូន ប្រធាន តុលាការ កំពូល តាមរយៈ ប្រព័ន្ធ អនឡាញ ដើម្បី ចាត់ការ ផងដែរ ៕
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច របស់ តុលាការ កំពូល៖
សាលាឧទ្ធរណ៍ ណែនាំ ៧ ចំណុច ដល់ មន្ត្រី ដែល បំពេញ ការងារ អំលុង បិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក យូ ប៊ុន ឡេង ប្រធាន សាលាឧទ្ធរណ៍ រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីណែនាំ ចំនួន ៧ ចំណុច ស្តីពី ការបំពេញ ការងារ របស់ មន្ត្រីរាជការ ក្នុង កំលុង ពេល បិទ ខ្ទប់ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។ នេះ យោង តាម សេចក្តីណែនាំ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន មុន នេះ បន្តិច ។
ក្នុង សេចក្តីណែនាំ របស់ ប្រធាន សាលាឧទ្ធរណ៍ លោក យូ ប៊ុន ឡេង បាន ឱ្យដឹង ថា ដើម្បី ចូលរួម អនុវត្ត សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល ខាងលើ ឱ្យ មាន ប្រសិទ្ធភាព ដើម្បី អាច បំពេញ ការងារ ជា សមត្ថកិច្ច របស់ ស្ថាប័ន សាលាឧទ្ធរណ៍ ភ្នំពេញ ដែល ករណី មួយចំនួន ត្រូវតែ ដំណើ ការ ដូច្នេះ ក្នុង នាម ជា ប្រធាន សាលាឧទ្ធរណ៍ ភ្នំពេញ សូម ណែនាំ និង អនុវត្ត ដូច ខាងក្រោម៖
ទី ២៖ ក្រៅពី ករណី ខាងលើ ចៅក្រម អាច ពិនិត្យ សំណុំរឿង ដែល ខ្លួន ទទួលបន្ទុក និង ចាត់ចែង ធ្វើ របាយការណ៍ លើ សំណុំរឿង ទាំងនោះ ដើម្បី ជួយ សម្រួល ការងារ ដោះស្រាយ សំណុំរឿង បាន ឆាប់ រហ័ស ជៀសវាង ការកកស្ទះ នៅ ក្រោយពេល មាន ស្ថានភាពប្រក្រតី ឡើងវិញ ។
ទី ៣៖ នៅក្នុង អំឡុង ពេល បិទ ខ្ទប់ នេះ ជា គោលការណ៍ មន្ត្រី ទាំងអស់ ត្រូវ នៅ ធ្វើ ការអនឡាញ តាម ផ្ទះ ។
ទី៥៖ ត្រូវ ធ្វើ លិខិត បញ្ជា បេសកកម្ម ជូន ចៅក្រម និង ក្រឡាបញ្ជី ម្នាក់ សម្រាប់ ចៅក្រម មួយ រូប ដើម្បី អាច មក បំពេញ ការងារ បាន តម្រូវ ដូច ខាងលើ ។ ព្រះរាជអាជ្ញា ដែល ត្រូវ មក បំពេញ ការងារ ជាមួយ ក្រុមប្រឹក្សា ជំនុំ ជំរះ អាស្រ័យ លើ អគ្គ ព្រះរាជអាជ្ញា ចាត់តាំង និង ធ្វើ លិខិត បញ្ជា បេសកកម្ម ជូន ពួកគាត់ ។ សមាសភាព ជំនុំ ជំរះ ទាំងអស់ ត្រូវ មាន ទំនាក់ទំនង ការងារ បាន ល្អ កាលបើ មាន កម្មវិធី សវនាការ តម្រូវ ។
ទី៦៖ លោក សង្ឃឹម ថា លិខិត បេសកកម្ម នេះ នឹង យក ទៅ ប្រើប្រាស់ សម្រាប់ តែ ការធ្វើដំណើរ ទៅ មក បំពេញ ការងារ ស្ថាប័ន ប៉ុណ្ណោះ ។
និង ទី៧៖ ក្នុង ករណី សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល មាន បន្ត ការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល សេចក្តីណែនាំ នេះ ក៏ នៅ មាន ប្រសិទ្ធភាព បន្ត តាម ពេលវេលា ដូចគ្នា ដែរ ៕
សូម អាន សេចក្តីណែនាំ របស់ ប្រធាន សាលាឧទ្ធរណ៍ រាជធានី ភ្នំពេញ ដែល មាន ខ្លឹមសារ ទាំងស្រុង ដូច ខាងក្រោម៖
លោកស្រី កែវ ច័ន្ទ ស៊ុន ណារី ជំនួយការ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោកស្រី កែវ ច័ន្ទ ស៊ុន ណារី ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី កម្ពុជា ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោកស្រី កែវ ច័ន្ទ ស៊ុន ណារី កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោកស្រី កែវ ច័ន្ទ ស៊ុន ណារី ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ លោក សេង ឌី និង លោកស្រី អ៊ុក សុភា ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោក សេង ឌី និង លោកស្រី អ៊ុក សុភា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក សេង ឌី និង លោកស្រី ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឧកញ៉ា លីម ប៊ុណ្ណា និង លោកជំទាវ ថុង ធីតា ឧបត្ថម្ភ ថវិកា ៥ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឧកញ៉ា លីម ប៊ុណ្ណា និង លោកជំទាវ ថុង ធីតា ឧបត្ថម្ភ ថវិកា ៥ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឧកញ៉ា លីម ប៊ុណ្ណា និង លោកជំទាវ ថុង ធីតា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឧកញ៉ា លីម ប៊ុណ្ណា និង លោកជំទាវ ថុង ធីតា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៤នាក់ និង អំពាវនាវ អ្នក ពាក់ព័ន្ធ ប្រញាប់ ទៅ យក សំណាក
( កំពង់ស្ពឺ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ - ១៩ ចំនួន ៤នាក់ និង អំពាវនាវ ដល់ អ្នក ដែល បាន ប្រាស្រ័យទាក់ទង ជាមួយ អ្នកជំងឺ ទាំង ៤នាក់ នេះ ត្រូវ រាយការណ៍ ជូន អាជ្ញាធរ មូលដ្ឋាន ជាបន្ទាន់ និង រួសរាន ទៅ យក សំណាក នៅ មន្ទីរ បង្អែក ខេត្ត ព្រមទាំង ដាក់ ខ្លួន ឱ្យ នៅ ដាច់ដោយឡែក រយៈពេល ១៤ ថ្ងៃ ។
ទី១៖ ឈ្មោះ ជា ឃឿន ភេទ ស្រី អាយុ ៤៥ ឆ្នាំ ជា កម្មការិនី រោងចក្រ សាប្រ៊ឺ ណា នៅ ភូមិ ត្រពាំង វែង ឃុំត្រពាំងគង ស្រុង សំរោង
ទី២៖ ឈ្មោះ ណែត ស្រី ល័ក្ខ ភេទ ស្រី អាយុ ២៧ ឆ្នាំ នៅ ផ្ទះ រស់ នៅ ភូមិ ត្រពាំង វែង ឃុំត្រពាំងគង ស្រុង សំរោង
ទី៣៖ ឈ្មោះ រ័ត្ន លីម ភេទ ស្រី អាយុ ៥៤ ឆ្នាំ នៅ ផ្ទះ រស នៅ ភូមិ ត្រពាំង វែង ឃុំត្រពាំងគង ស្រុង សំរោង
និង ទី៤៖ ឈ្មោះ អាង អ៉ីន ឈ័រ ភេទ ស្រី អាយុ២ ឆ្នាំ នៅ ផ្ទះ រស់ នៅ ភូមិ ត្រពាំង វែង ឃុំត្រពាំងគង ស្រុង សំរោង ។
ក្នុង ករណី បងប្អូន មាន បញ្ហា សុខភាព ឬ រោគសញ្ញា សង្ស័យ ផ្សេង ៗ សូម មេត្តា ទៅ ពិនិត្យ សុខភាព នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ឬ មណ្ឌល សុខភាព ដែល នៅជិត គេហដ្ឋាន និង រាយការណ៍ ទៅ អាជ្ញាធរ មូលដ្ឋាន ជាបន្ទាន់ ឬ ទំនាក់ទំនង តាមរយៈ លេខ ទូរស័ព្ទ លេខ៖ ០១២ ៩៨៥ ៦៨៩ / ០៨៨ ៥៩៨ ៤៤ ៩៦ ។
ទន្ទឹមនឹង នេះ រដ្ឋបាល ខេត្ត បាន ក្រើន រំឮក ដល់ ប្រជាពលរដ្ឋ ត្រូវ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ « ៣កុំ និង ៣ការពារ » របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ៕
ការប្រកាស ពី ការរៀបចំ ការបោះឆ្នោត ប្រធានាធិបតី ធ្វើឡើង ដោយ ប្រធាន សភា ជាតិ ស៊ីរី លោក ហាមូដា សាបាគ (Hamouda Sabbagh) ។ បើ តាម លោក ហាមូដា ការបោះឆ្នោត ដើម្បី ជ្រើសរើស ប្រធានាធិបតី ម្នាក់ ឱ្យដឹកនាំ ប្រទេស សម្រាប់ អាណត្តិ មាន រយៈពេល ៧ ឆ្នាំ នឹង ត្រូវ ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៦ ខែឧសភា ។ ប្រធាន សភា រូប នេះ បន្ថែម ថា បេក្ខជន ប្រធានាធិបតី ទាំងអស់ នឹង អាច ចុះឈ្មោះ ចូលរួម ប្រកួតប្រជែង ចាប់ពី ថ្ងៃចន្ទ សប្ដាហ៍ នេះ តទៅ រីឯ ប្រជាជន ស៊ីរី នៅឯ ក្រៅ ប្រទេស អាចនឹង បោះឆ្នោត នៅឯ ស្ថានទូរ ស៊ីរី នៅ ថ្ងៃទី ២០ ខែឧសភា ។
គួរ បញ្ជាក់ ថា នេះ គឺជា ការបោះឆ្នោត ប្រធានាធិបតី ជា លើក ទី២ ដែល នឹង ប្រព្រឹត្តទៅ អំឡុង សង្រ្គាម ស៊ីវិល នៅ ស៊ីរី ។ ការបោះឆ្នោត កាលពី ឆ្នាំ ២០១៤ ដែល លោក អាសាដ ទទួលបាន សំឡេង គាំទ្រ ដល់ ទៅ ៩២ ភាគរយ ត្រូវបាន សហរដ្ឋ អាមេរិក និង សហភាព អឺរ៉ុប ចាត់ទុក ថា ផ្ទុយ ពី លទ្ធិ ប្រជាធិបតេយ្យ ហើយ ដូចគ្នា ដែរ ការបោះ ឆ្នោត ក្នុង ឆ្នាំ នេះ លោក អាសាដ ត្រូវបាន គេ រំពឹង ថា បន្ត កាន់អំណាច ដដែល ស្រប ពេល រដ្ឋាភិបាល របស់ លោក កំពុង គ្រប់គ្រង ទឹកដី ស្ទើរតែ ទាំងស្រុង ៕
រដ្ឋាករ ទឹក ក្រុង ភ្នំពេញ ចេញ សេចក្តីណែនាំ កំណត់ ចំនួន មន្ត្រី និយោជិត បំពេញ ការងារ ក្នុង អំឡុង ពេល បិទ ខ្ទប់ ដើម្បី ធានា និរន្តរភាព ផ្គត់ផ្គង់ ទឹក ស្អាត ជូន ប្រជាពលរដ្ឋ ប្រើប្រាស់
( ភ្នំពេញ ) ៖ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ បាន ចេញ សេចក្តីណែនាំ មួយ ស្តីពី ការកំណត់ ចំនួន មន្ត្រី និយោជិត បំពេញ ការងារ ក្នុង អំឡុង ពេល ការបិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ដើម្បី ធានា និរន្តរភាព ផ្គត់ផ្គង់ ទឹក ស្អាត ជូន ប្រជាពលរដ្ឋ ប្រើប្រាស់ ។
២៖ មន្ត្រី និយោជិត ដែល ប្រចាំ ការ នៅ តាម រោងចក្រ ផលិត ទឹក ស្អាត ទាំង បួន និង ក្រុម សន្តិសុខ ដែល ប្រចាំ ការ នៅ ស្នាក់ការ កណ្តាល តាម រោងចក្រ និង តាម អាង តម្កល់ ទឹក ត្រូវ បំពេញ ការងារ នៅនឹង កន្លែង ដោយ មិន មាន ការចល័ត ផ្លាស់ប្តូរ កម្លាំង និង អនុវត្ត ឲ្យបាន តាម គោលការណ៍ បទបញ្ជា ផ្ទៃក្នុង អង្គភាព ។
៣៖ មន្ត្រី និយោជិត ដែល មិន មាន ក្នុង ចំណុច ទាំង ពីរ ខាងលើ ស្នើ បំពេញ ការងារ តាមរយៈ ប្រព័ន្ធ Online នៅ តាម គេហដ្ឋាន រៀង ៗ ខ្លួន តាម ការណែនាំ របស់ ប្រធាន សាមី នាយកដ្ឋាន អង្គភាព និង អនុវត្ត នូវ វិធានការ នានា របស់ រាជ រដ្ឋាភិបាល ជា ចាំបាច់ ។
៤៖ គ្រប់ ថ្នាក់ដឹកនាំ មន្ត្រី ន យោជិត ដែល មក បំពេញ ការងារ នៅ អង្គភាព ចាំបាច់ ត្រូវ អនុវត្តន៍ ការត្រួតពិនិត្យ កម្តៅ ពាក់ ម៉ាស និង អនុវត្តន៍ វិធានការ ៣កុំ ៣ការពារ ជាប្រចាំ ។
៥៖ គ្រប់ មន្ត្រី និយោជិត ដែល ទទួលបាន លិខិត បញ្ជា បេសកម្ម ចាំបាច់ ត្រូវ ប្រើប្រាស់ ដោយ ប្រុងប្រយ័ត្ន និង ចំ គោលដៅ ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៥៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ១៨ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៥៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៩ ខែមេសា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៥៩ នាក់ នោះ មាន ៤៥ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៨ ករណី និង ជនសង្ស័យ ១៤នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៩ ករណី ។
រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ សម្រេច ផ្អាក ដំណើរការផ្សារ ធំ ទួល សង្កែ ១៤ ថ្ងៃ ក្រោយ រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ ចេញ ចូល ផ្សារ ថ្ងៃ ៥ដល់ ថ្ងៃ១០ និង អំពាវនាវ អ្នក ពាក់ព័ន្ធ ទៅ ធ្វើតេស្ត រក មេរោគ
( ភ្នំពេញ ) ៖ អភិបាល ខណ្ឌ ឫស្សីកែវ លោក ជា ពិសី និង ជា សមាជិក ក្រុម លេខា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន សម្រេច ផ្អាក ដំណើរការ មូលដ្ឋាន ផ្សារ ធំ ទួល សង្កែ ( ហៅ ផ្សារ សាំ ហាន់ ) បណ្ដោះអាសន្ន រយះពេល ១៤ ថ្ងៃ ស្ថិត នៅ សង្កាត់ ទួល សង្កែទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ដោយ គិត ចាប់ពី ម៉ោង ០០៖០០ នាទី ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ ដល់ ថ្ងៃទី ០២ ខែឧសភា ឆ្នាំ ២០២១ ។
ការសម្រេច របស់ លោក ជា ពិសី ក្នុង ការផ្អាក ដំណើរការ មូលដ្ឋាន ផ្សារ ធំ ទួល សង្កែ ( ហៅ ផ្សារ សាំ ហាន់ ) បណ្ដោះអាសន្ន រយះពេល ១៤ ថ្ងៃ បាន អនុវត្ត ឡើង ក្រោយពី រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ សហការ ជាមួយ ក្រុមការងារ មន្ត្រី សុខាភិបាល បាន រកឃើញ អ្នក ឆ្លង កើត ជំងឺ កូវីដ - ១៩ ចេញ ចូល ផ្សារ ធំ ទួល សង្កែ ( ផ្សារ សាំ ហាន់ ) ពាក់ព័ន្ធ ព្រឹត្តិការណ៍ ២០កុម្ភៈ ចាប់ពី ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ ដល់ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២១ ។
បន្ថែម ពី នេះ លោក អភិបាល ខណ្ឌ ឫស្សីកែវ សូម អំពាវនាវ អ្នក ដែល គ្មាន រោគសញ្ញា សូម ដាក់ ខ្លួន ឲ្យ ដាច់ដោយឡែក និង តាមដាន សុខភាព របស់ ខ្លួន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃ ដែល សង្ស័យ បាន ប៉ះពាល់ ឬ នៅ ផ្សារ ធំ ទួល សង្កែ ( ហៅ ផ្សារ សាំ ហាន់ )៕ រដ្ឋបាល ខេត្ត ស្វាយរៀង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត កូវីដ១៩ ថ្មី ចំនួន ៨នាក់ ដែល មាន ទីលំនៅ និង បម្រើ ការងារ នៅ សង្កាត់ បាវិត
បន្ថែម លើ នេះ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១៨ ខែមេសា នេះ ក៏ បាន ចេញ សេចក្តីសម្រេច ស្តីពី ការអនុវត្ត វិធានការ រដ្ឋបាល ជា បណ្តោះអាសន្ន ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ត្រ សង្កាត់ បាវិត ក្រុង បាវិត ។
សេចក្តីសម្រេច នេះ បញ្ជាក់ ថា ការដាក់ វិធានការ រដ្ឋបាល នេះ មាន ថិរ វេលា អនុវត្ត ១៤ ថ្ងៃ គិត ចាប់ពី ម៉ោង ០០៖០០ ថ្ងៃទី ១៩ ខែមេសា ដល់ ថ្ងៃទី ២ ខែឧសភា ឆ្នាំ ២០២០១ ។ ថិរ វេលា នេះ អាច ត្រូវបាន សម្រេច បន្ត ឬ បញ្ចប់ មុន ថិរ វេលា កំណត់ តាម ការជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ៕
សូម អាន សេចក្តីជូនដំណឹង និង សេចក្តីសម្រេច ខាងក្រោម៖ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង រកឃើញ អ្នក កើត កូវី ដ១៩ ឈ្មោះ ហង់ ស៉ី ម ហើយ គឺ គាត់ ធ្វើការ នៅ រោងចក្រ « ហីរ៉ាយហ្សិន អៅដរ ( ខេមបូឌា )»
ស្ត្រី ឈ្មោះ ហង់ ស៊ីម អាយុ ៤២ ឆ្នាំ ជា កម្មករការ នី រោងចក្រ មាន ទីលំនៅ ក្នុង ភូមិ ត្រពាំង ថ្លឹង សង្កាត់ ចោម ចៅ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល រកឃើញ វិជ្ជមាន កូវីត - ១៩ កាលពី ថ្ងៃ ទី១៧ ខែមេសា នៅ មន្ទីរពេទ្យ រាជធានី ភ្នំពេញ ហើយ ស្ត្រី រូប នេះ បាន បញ្ជាក់ ប្រាប់ គ្រូពេទ្យ នៅ ភ្នំពេញ ថា គាត់ គឺជា កម្មការិនី ធ្វើការ នៅ រោងចក្រ មួយ កន្លែង ក្នុង ខេត្ត កំពង់ឆ្នាំង តែ មិន បាន ប្រាប់ ឈ្មោះ រោងចក្រ ពិត ប្រាកដ នោះ ឡើយ ។
លោក បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា ស្ត្រី ឈ្មោះ ហង់ សុី ម គឺ គាត់ បាន សម្រាក ព្យាបាល ជំងឺ កូវីដ - ១៩ ជាមួយនឹង កូនប្រុស របស់ គាត់ ម្នាក់ ទៀត ឈ្មោះ រៀម សារ៉ាក់ អាយុ ១៨ ឆ្នាំ ។ ទាំង ពីរ នាក់ ម្ដាយ និង កូន ធ្វើការ នៅក្នុង រោងចក្រ ហីរ៉ាយហ្សិន អៅដរ ( ខេមបូឌា ) ដែល រោងចក្រ នេះ មាន ទីតាំង ស្ថិត នៅក្នុង ភូមិ ផ្សារ ត្រា ច ឃុំ លង្វែក ស្រុក កំពង់ត្រឡាច ខេត្ត កំពង់ឆ្នាំង ។
ចំណែក ម្ដាយ របស់ គេ ឈ្មោះ ហង់ សុី ម វិញ បាន ឈប់ សម្រាក តាំងពី ថ្ងៃ ទី២ ខែមេសា មក ម្ល៉េះ ។ បច្ចុប្បន្ន ទាំង ពីរ នាក់ ម្ដាយ និង កូន កំពុង សម្រាក ព្យាបាល ជំងឺ កូវី - ១៩ នៅ មន្ទីរពេទ្យ រាជធានី ភ្នំពេញ ។
( កំពត ) ៖ ជនជាតិ អាល្លឺម៉ង់ ម្នាក់ ត្រូវបាន កម្លាំង ការិយាល័យ ស៊ើបអង្កេត និង អនុវត្ត នីតិវិធី នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពត ចាប់ខ្លួន ក្រោយ ល្មើស សេចក្ដីណែនាំ របស់ រាជ រដ្ឋាភិបាល និង បំរាម គោចរ របស់ រដ្ឋបាល ខេត្ត កំពត ព្រមទាំង ញុះញង់ ឲ្យ មាន ការផឹក ស៉ី នៅលើ បណ្ដាញ សង្គម Facebook ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ស្នងការ នគរបាល ខេត្ត កំពត បាន ឲ្យដឹង ថា ជនជាតិ អាល្លឺម៉ង់ នេះ ត្រូវបាន កម្លាំង នគរបាល ចាប់ខ្លួន នៅ ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្រោយ ល្មើស សេចក្ដីណែនាំ និង បំរាម គោចរ ចំណុច ក្រុង កំពត នៅ វេលា ម៉ោង ០៩ យប់ ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២១ ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ជនសង្ស័យ ឈ្មោះ KASKE STEVE អាយុ ៣៦ ឆ្នាំ ។ បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន កម្លាំង ការិយាល័យ ជំនាញ កំពុង កសាង សំណុំរឿង ដើម្បី បញ្ជូន ទៅកាន់ តុលាការ ចាត់ការបន្ដ តាម នីតិវិធី ៕
សូម អាន សេចក្តីប្រកាស របស់ សហព័ន្ធ ស្រូវ អង្ករ ដូច ខាងក្រោម៖ នារី ម្នាក់ ចូលទៅ សារភាព សុំទោស នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ក្រោយ បង្ហោះ រូបភាព ជួបជុំ ផឹក ស៉ី និង ប្រើ ពាក្យ អសុរស
ស្ត្រី ខាងលើ មាន ឈ្មោះ គឹម កញ្ញា ភេទ ស្រី អាយុ ៣៦ ឆ្នាំ ទីលំនៅ ភូមិ គោ រដ្ឋាន សង្កាត់ អូរ អំបិល ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ។
បន្ទាប់មក សាម៉ីខ្លួន បាន មក សារភាព និង ធ្វើ ការសុំទោស នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ( នៅ ការិយាល័យ ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា ) ដើម្បី ប្រាប់ អំពី មូលហេតុ ដែល ខ្លួន បាន ប្រព្រឹត្ត ។
ក្រោយពី នគរបាល ខេត្ត បន្ទាយមានជ័យ សាកសួរ ស្ត្រី ខាងលើ បាន ឲ្យដឹង ថា រូបភាព ដែល បាន បង្ហោះ នោះ ជា រូបភាព ចាស់ តាំងពី ខែធ្នូ ឆ្នាំ ២០២០ ម្ល៉េះ ហើយ ការណ៍ ដែល ខ្លួន ប្រើ ពាក្យ សម្តី អសុរស នោះ ដោយសារ មាន ទំនាស់ ជាមួយ អ្នកជិតខាង ទើប យក រូប នោះ មក ផុស សារជាថ្មី ធ្វើឲ្យ ប៉ះពាល់ ដល់ សណ្តាប់ធ្នាប់ សាធារណៈ និង មិន គោរព តាម អនុសាសន៍ របស់ រាជ រដ្ឋាភិបាល ៣ ការពារ ៣ កុំ ។
តាម ការស្រាវ របស់ ការិយាល័យ ជំនាញ រកឃើញ ថា រូបភាព ដែល បាន បង្ហោះ នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២១ នោះ ជា រូបភាព ចាស់ ដែល ធ្លាប់ បាន បង្ហោះ ក្នុង ខែធ្នូ ឆ្នាំ ២០២០ ពិតប្រាកដ មែន ។
ដោយ មាន ការណែនាំ ពី លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ បាន ឲ្យ កម្លាំង ជំនាញ ធ្វើ កិច្ចសន្យា អប់រំ ស្ត្រី ខាងលើ បញ្ឈប់ ការបង្ហោះ រូបភាព បែប នេះ តទៅទៀត និង ធ្វើ ការគ្រប់គ្រង តាមដាន បន្ត ទៅ ទៀត ផងដែរ ៕ តម្លៃ ប្រេងឥន្ធនៈ លក់ រាយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី៣០ ខែមេសា៖ តម្លៃ សាំង ធម្មតា ៣. ៧០០ រៀល និង ម៉ាស៊ូត តម្លៃ ៣. ២៥០ រៀល ក្នុង ១លីត្រ
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការកំណត់ ថ្លៃ ប្រេងឥន្ធនៈ ត្រូវ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃទី ១៦ ដល់ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២១ ដោយ សាំង ធម្មតា ត្រូវ លក់ តម្លៃ ៣. ៧០០ រៀល ក្នុង មួយ លីត្រ និង ម៉ាស៊ូត លក់ ក្នុង តម្លៃ ៣. ២៥០ រៀល ក្នុង ១លីត្រ៕
ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង ជំរុញ ក្រុម គ្រូពេទ្យ ព្យាបាល ជំងឺ កូវីដ ខិតខំ យកចិត្តទុកដាក់ គោរព ក្រមសីលធម៌ វិជ្ជាជីវៈ ក្នុង ការព្យាបាល អ្នកជំងឺ ឱ្យ មាន ប្រសិទ្ធភាព
( ស្វាយរៀង ) ៖ លោក បណ្ឌិត កែរ រដ្ឋា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង បាន ជំរុញ ដល់ ក្រុម គ្រូពេទ្យ ព្យាបាល ជំងឺ កូវីដ - ១៩ ក្នុង ខេត្ត ត្រូវ ខិតខំ យកចិត្តទុកដាក់ និង គោរព ក្រមសីលធម៌ វិជ្ជាជីវៈ ក្នុង ការព្យាបាល អ្នកជំងឺ ឱ្យ មាន ប្រសិទ្ធភាព និង តម្លាភាព គឺ ត្រូវ ធ្វើ យ៉ាងណា ព្យាបាល ឱ្យ ឆាប់ ជាសះស្បើយ ឡើងវិញ ។
ការជំរុញ បែប នេះ របស់ លោក បណ្ឌិត កែរ រដ្ឋា បាន ធ្វើឡើង នៅក្នុង ឱកាស លោក បាន ដឹកនាំ ក្រុម គ្រូពេទ្យ របស់ មន្ទីរពេទ្យ បង្អែក ស្វាយទាប ចំនួន ១៧នាក់ ចូលរួម ផ្លាស់ វេន ក្រុម គ្រូពេទ្យ ព្យាបាល ក្នុង មណ្ឌល ព្យាបាល កូវីដ - ១៩ ក្រុង បាវិត ដែល ត្រូវ បញ្ចប់ ភារកិច្ច ១៤ ថ្ងៃ ។
ការផ្លាស់ប្ដូរ វេន ក្រុម គ្រូពេទ្យ ព្យាបាល ជំងឺ កូវីដ - ១៩ នេះ បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ២០២១ ដែល មាន ការចូលរួម ពី លោក អភិបាល រង ក្រុង បាវិត លោក វេជ្ជបណ្ឌិត ប្រាក់ សម្បត្តិ ប្រធាន មន្ទីរពេទ្យ បង្អែក ជីភូ . លោក វេជ្ជបណ្ឌិត សរ សុខ ចំរើន ប្រធាន មន្ទីរពេទ្យ បង្អែក ស្វាយទាប និង លោក វេជ្ជបណ្ឌិត អុឹម បុត្រ ប្រធាន ផ្នែក ចត្តាឡី ស័ក ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក បណ្ឌិត កែរ រដ្ឋា បាន ថ្លែងអំណរគុណ ដល់ ក្រុម គ្រូពេទ្យ ព្យាបាល ជំងឺ កូវីដ - ១៩ ទាំងអស់ នៅ ខេត្ត ស្វាយរៀង ដែល បាន ខិតខំ យកចិត្ត ក្នុង ការព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ ដោយ មិន ខ្លាច នឿយហត់ ដើម្បី បុព្វហេតុ ប្រទេសជាតិ ក្នុង គ្រា ដ៏ លំបាក នេះ ជាពិសេស ក្នុង ការលើកកម្ពស់ សុខ មាលភាព ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ ។
លោក បណ្ឌិត កែរ រដ្ឋា បាន លើកឡើង ថា បច្ចុប្បន្ន នេះ នៅក្នុង ខេត្ត ស្វាយរៀង មាន មន្ទីរពេទ្យ ព្យាបាល កូវីដ - ១៩ ចំនួន ២ និង មណ្ឌល ព្យាបាល កូវីដ - ១៩ ក្រុង បាវិត ចំនួន ១។ មន្ទីរពេទ្យ ព្យាបាល កូវីដ - ១៩ ចំនួន ២នោះ លោក អភិបាល ខេត្ត និង ជា ប្រធាន គណៈកម្មការ កូវីដ - ១៩ ខេត្ត បាន យកមន្ទីរពេទ្យ បង្អែក ស្វាយ ជ្រំ និង មន្ទីរពេទ្យ បង្អែក សាមគ្គី រំំ ដួល ស្រុក រំដួល ជា មន្ទីរពេទ្យ សម្រាប់ ព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ ។
លោក បាន បន្ត ថា ដោយសារតែ អ្នកជំងឺ កូវីដ - ១៩ មាន ការកើនឡើង លោក អភិបាល ខេត្ត បាន យក អាគារ មួយ នៅ ក្រុង បាវិត ធ្វើជា មណ្ឌល ព្យាបាល កូវីដ - ១៩ ។ ចំពោះ ក្រុម គ្រូពេទ្យ ព្យាបាល នៅក្នុង មណ្ឌល ព្យាបាល នេះ មន្ទីរ សុខាភិបាល បាន ចល័ត ពី មន្ទីរពេទ្យ ផ្សេង ៗ ក្នុង ខេត្ត មក ជួយ ដោយ ប្តូរ វេន វិល ជុំ ១៤ ថ្ងៃម្តង ។
ជាក់ស្ដែង ថ្ងែ នេះ ក្រុម គ្រូពេទ្យ របស់ មន្ទីរពេទ្យ បង្អែក ស្វាយទាប ចូល ក្រុម គ្រូពេទ្យ របស់ មន្ទីរពេទ្យ បង្អែក ជីភូ ចេញ ។ ប៉ុន្តែ ក្រុម គ្រូពេទ្យ របស់ មន្ទីរពេទ្យ បង្អែក ជីភូ ត្រូវ បន្ត ចត្តាឡី ស័ក នៅ មណ្ឌល ចត្តាឡី ស័ក ១៤ ថ្ងៃ បន្ថែម ទៀត ទើប អនុញ្ញាតឱ្យ ទៅ ផ្ទះ ជួបជុំ គ្រួសារ ។ ចំពោះ វេន បន្តបន្ទាប់ គឺ ក្រុម គ្រូពេទ្យ របស់ មន្ទីរពេទ្យ បង្អែក រមាសហែក រួច ដល់ ក្រុម គ្រូពេទ្យ របស់ មន្ទីរពេទ្យ បង្អែក ខេត្ត ស្វាយរៀងម្តង ។
ជាមួយគ្នា នេះ លោក បណ្ឌិត ក៏ បាន ឧបត្ថម្ភ ទឹកដោះ ឆៅ ២០ឡូ និង ទឹក សុទ្ធ ២០ កេស ជូន ក្រុម គ្រូពេទ្យ ទាំង ២ក្រុម និង ឧបត្ថម្ភ សមត្ថកិច្ច ចំនួន ៤នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា ចំនួន ៥មុឺន រៀល ផងដែរ ៕
ឯកឧត្ដម វង់ សណ្តាប់ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្ដម វង់ សណ្តាប់ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឯកឧត្ដម វង់ សណ្តាប់ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម វង់ សណ្តាប់ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ប៉ែន សំអាត និង ក្រុមគ្រួសារ ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឯកឧត្តម ប៉ែន សំអាត និង ក្រុមគ្រួសារ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
បទ អត្ថាធិប្បាយ៖ សេដ្ឋកិច្ច ចិន ងើប ឡើងវិញ ប្រកបដោយ ស្ថិរភាព ជា បន្តបន្ទាប់ ដែល មាន ភាពធន់ យ៉ាង ខ្លាំងក្លា
( ប៉េកាំង ) ៖ ថ្ងៃទី ១៦ ខែមេសា ប្រទេស ចិន បាន ចេញផ្សាយ ទិន្នន័យ ជា ផ្លូវការ ឱ្យ ដឹង ថា តាម សិ្ថតិ ជា ជំហាន ដំបូង នៅ ត្រីមាស ទី មួយ ឆ្នាំ នេះ ផលិតផល ក្នុង ស្រុក សរុប របស់ ប្រទេស ចិន មាន ចំនួន ២៤. ៩៣១ ទ្រីលាន យាន់ ប្រាក់ ចិន បាន កើនឡើង ១៨.៣ភាគរយ បើ ប្រៀបធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ ២០២០ ។ មិន បាច់ សង្ស័យ ឡើយ និយាយ ចំពោះ សេដ្ឋកិច្ច ចិន គឺជា កិច្ច ចាប់ផ្តើម ដ៏ ល្អ ប្រសើរ ក្នុង ឆ្នាំ នេះ ។
បន្ទាប់ពី ឆ្លងកាត់ ការធ្លាក់ចុះ ក្នុង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ មុន សេដ្ឋកិច្ច ចិន បាន ងើប ឡើងវិញ ប្រកបដោយ ស្ថិរភាព ជា បន្តបន្ទាប់ ហើយ បាន បង្ហាញ ឱ្យ ឃើញ នូវ ភាពធន់ យ៉ាង ខ្លាំងក្លា ដែល បាន នាំមុខ ក្នុង ជួរ អង្គភាព សេដ្ឋកិច្ច សំខាន់ ៗ លើ ពិភពលោក ទាំងមូល ។ ប្រការ ទាំង នេះ គឺ ដោយសារ ប្រទេស ចិន មាន ដំណើរ ងើប ឡើងវិញ ប្រកប ដោយ ភាពជឿនលឿន បង្គួរ និង បាន ងើប ឡើងវិញ ក្នុង មូលដ្ឋាន ទាប ។
ជា ការពិត ណាស់ ប្រឈម នឹង ការរីករាលដាល នៃ ជំងឺ កូវីដ ១៩ និង បរិយាកាស អន្តរជាតិ ដ៏ ស្មុគស្មាញ ការងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច ចិន នៅតែ ស្ថិត នៅក្រោម កម្លាំង សម្ពាធ ដដែល ប៉ុន្តែ បើ ធ្វើ ការវិភាគ ពី កត្តា ជាច្រើន ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ចិន នា ពេល បច្ចុប្បន្ន នេះ អាច ជឿជាក់ ថា អង្គភាព សេដ្ឋកិច្ច ធំ ទី ពីលើ ពិភពលោក មាន ការរំពឹងទុក អាច រក្សា ការងើប ឡើងវិញ ជា បន្តបន្ទាប់ រីឯ ការងើប ឡើងវិញ របស់ សេដ្ឋកិច្ច សកល ក៏ នឹង ទទួលបាន កម្លាំង ចលករ កាន់តែ ច្រើន ពី ប្រទេស ចិន ផងដែរ ៕
លោក ឧកញ៉ា ថោង សារ៉ាត់ និង លោកជំទាវ ទាវ ធីតា ឧបត្ថម្ភ ថវិកា ២ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា ថោង សារ៉ាត់ និង លោកជំទាវ ទាវ ធីតា ឧបត្ថម្ភ ថវិកា ២ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោក ឧកញ៉ា ថោង សារ៉ាត់ និង លោកជំទាវ ទាវ ធីតា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក ឧកញ៉ា ថោង សារ៉ាត់ និង លោកជំទាវ ទាវ ធីតា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ នេះ អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ក្នុង គោលបំណង បន្ត ការងារ គ្រប់គ្រង អប់រំ សាធារណៈ មតិ នៅក្នុង រយៈពេល នៃ ការបិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ទីក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល បាន បញ្ចេញផ្សាយ នូវ វីដេអូ អប់រំ ថ្មី មួយ ទៀត ដែល មាន ចំណងជើង ថា កូវីដ ១៩៖ រួមគ្នា អត់ធ្មត់ និង សុខចិត្ត លំបាក រយៈពេល ខ្លី ដើម្បី សេចក្តីសុខ យូរអង្វែង » ។
ម៉្យាង វិញ ទៀត ក្នុង រយៈពេល ១៤ ថ្ងៃ នៃ ការបិទ ខ្ទប់ នេះ ក៏ គឺជា វិញ្ញាសារ ដ៏ សំខាន់ មួយ ដើម្បី វាស់ស្ទង់ ពី ជោគជ័យ ឬ បរាជ័យ របស់ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជាមួយ ជំងឺ កូវីដ - ១៩ ។ ហើយ ជោគជ័យ ឬ បរាជ័យ គឺ អាស្រ័យ ទាំងស្រុង លើ ការចូលរួម របស់ ប្រជាពលរដ្ឋ គ្រប់ រូប ពោល គឺ ប្រសិនបើ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ គ្នា អត់ធ្មត់ បាន ហើយ ចូលរួម អនុវត្ត វិធានការ នេះ ឲ្យបាន ខ្ជាប់ខ្ជួន ព្រឹត្តិការណ៍ ២០ កុម្ភៈក៍ អាច បិទ បញ្ចប់ ទៅ វិញ នា ពេល ឆាប់ ៗ ខាងមុខ ។
ផ្ទុយទៅវិញ ប្រសិនបើ ប្រជាពលរដ្ឋ ខ្វះ ការអត់ធ្មត់ និង មិន ចូលរួម អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន ទេ គ្រោះអាសន្ន ធំ នឹង ចូល មកដល់ ពេល នោះ យើង ទាំងអស់ គ្នា នឹង ច្បាស់ជា ទទួលរង ទុក្ខលំបាក ក្នុង រយៈពេល វែង ដែល ពិបាក ស្តារ និង ពិបាក រក ទី បញ្ចប់ ជាក់ ជា មិន ខាន ។ ដូច្នេះ ដើម្បី អាច យកឈ្នះ ជំងឺ ឆ្លង ដ៏ កាច សាហាវ នេះ បាន វិធានការ ដ៏ មាន ប្រសិទ្ធភាព បំផុត គឺ មាន តែ ការអនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ វិធានការ ៣កុំ ៣ការពារ ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ រួចហើយ ។
លោក ឧកញ៉ា ស៊ី គង់ ទ្រីវ និង លោកជំទាវ ភូ ហុង ស៊ួន ឧបត្ថម្ភ ថវិកា ១០ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា ស៊ី គង់ ទ្រីវ និង លោកជំទាវ ភូ ហុង ស៊ួន ឧបត្ថម្ភ ថវិកា ១០ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោក ឧកញ៉ា ស៊ី គង់ ទ្រីវ និង លោកជំទាវ ភូ ហុង ស៊ួន កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក ឧកញ៉ា និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រដ្ឋបាល ភិបាល កូរ៉េ ខាងត្បូង បន្ត ផ្តល់ ជំនួយ បរិក្ខា ពេទ្យ តម្លៃ សរុប ប្រមាណ ៣៥ ម៉ឺន ដុល្លារ ជូន ក្រសួង សុខាភិបាល កម្ពុជា
( ភ្នំពេញ ) ៖ រដ្ឋាភិបាល នៃ សាធារណៈ រដ្ឋ កូរ៉េ តាមរយៈ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ កូរ៉េ (KOICA) បន្ត ផ្តល់ ជំនួយ បរិក្ខា ពេទ្យ សម្រាប់ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ សរុប ជា ថវិកា ប្រមាណ ជា ៣៥ ម៉ឺន ដុល្លារ អាមេរិក ជូន ដល់ ក្រសួង សុខាភិបាល នៃ ប្រទេស កម្ពុជា ។
បើ តាម KOICA ការផ្តល់ ជំនួយ នេះ ត្រូវបាន ធ្វើឡើង តាមរយៈ កម្មវិធី ការឆ្លើយតប ចំពោះ កូវីដ១៩ របស់ ទីភ្នាក់ងារ កយការ លើ របៀប វីរៈ ដើម្បី កសាង ភាពល្អ ប្រសើរ ក្នុង ការប្រឆាំង កូវីដ១៩ តាមរយៈ កិច្ចសហប្រតិបត្ត ការអភិវឌ្ឍន៍ ។ កម្មវិធី នេះ ជា គំនិត ផ្ទួច ផ្តើម របស់ សាធារណៈ រដ្ឋ កូរ៉េ ដែល ធ្វើអន្តរាគមន៍ ដើម្បី ឆ្លើយតប ទៅនឹង ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ តាម ការគាំទ្រ ផ្សេង ៗ ។
អាជ្ញាធរ សម្រេច ផ្អាក ដំណើរការផ្សារ បឹងត្របែក ផ្លាហ្សា នៅ ខណ្ឌ ចំការមន បណ្ដោះអាសន្ន ក្រោយ ពាក់ព័ន្ធ ជាមួយ អ្នក កើត ជំងឺ កូវីដ
រដ្ឋបាល ខណ្ឌ ចំការមន បាន បញ្ជាក់ ថា ផ្សារ បឹងត្របែក ផ្លាហ្សា នេះ ត្រូវ ផ្អាក បណ្ដោះអាសន្ន រយៈពេល ២សប្ដាហ៍ គិត ចាប់ពី ថ្ងៃទី ១៩ ខែមេសា ដល់ ថ្ងៃទី ០២ ខែឧសភា ឆ្នាំ ២០២១ ដើម្បី បង្ការ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ នៅ ដល់ អាជីវករ អតិថិជន ក៏ ដូចជា ប្រជាពលរដ្ឋ ដែល ចេញ - ចូល ផ្សារ នេះ ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ នេះ រដ្ឋា បាល ទីក្រុង ហុងកុង បាន បញ្ជាក់ ថា ប្រទេស ទាំង៣ ខាងលើ ត្រូវបាន ចាត់ទុក ថា មាន ហានិភ័យ ខ្ពស់ បំផុត ក្រោយ មាន ករណី ឆ្លង នាំចូល ពី ប្រទេស ទាំងនេះ ត្រូវបាន រាយការណ៍ ជា បន្តបន្ទាប់មកកាន់ ទីក្រុង ហុងកុង ក្នុង រយៈពេល ១៤ ថ្ងៃ មក នេះ ។
សូម កុំ ប្រើ ទូរស័ព្ទ ពេល កំពុង បើកបរ ! ស្លាប់ ១នាក់ និង របួស ២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៨ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១នាក់ និង របួស ធ្ងន់ ស្រាល ២នាក់ ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃទី ១៣ ខែមេសា កន្លងទៅ អាជ្ញាធរ សុខាភិបាល សហរដ្ឋ អាមេរិក បាន សម្រេច ផ្អាក ការប្រើប្រាស់ វ៉ាក់សាំង Johnson និង Johnson ដែល ជា វ៉ាក់សាំង ចាក់ តែ មួយ ដូស ជា បណ្តោះអាសន្ន សិន ដើម្បី ស៊ើបអង្កេត លើ របាយការណ៍ អំពី បញ្ហា កំណក ឈាម ចំនួន ០៦ ករណី ក្នុង ចំណោម មនុស្ស ដែល បាន ចាក់ វ៉ាក់សាំង នេះ ជាង ៧លាន នាក់ ៕ រដ្ឋបាល ខេត្ត ស្វាយរៀង ដាក់ ចេញ វិធានការ រដ្ឋបាល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៩មេសា ដល់ ថ្ងៃទី ២ឧសភា ដើម្បី ទប់ស្កាត់ កូវីដ១៩ នៅ ក្រុង បាវិត
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១៨ ខែមេសា នេះ បាន ចេញ សេចក្តីសម្រេច ស្តីពី ការអនុវត្ត វិធានការ រដ្ឋបាល ជា បណ្តោះអាសន្ន ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ត្រ សង្កាត់ បាវិត ក្រុង បាវិត ។ នេះ បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ដែល ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ២នាក់ នេះ នៅ មន្ទីរពេទ្យ ហ្លូង ម៉ែ និង មន្ទីរពេទ្យ ចាក់អង្រែ ។
* ទី១៖ មន្ទីរពេទ្យ ហ្លួង ម៉ែ បាន ឱ្យដឹង ថា បុរស ជនជាតិ ខ្មែរ អាយុ ៥៥ ឆ្នាំ ដែល រស់ នៅ សង្កាត់ អូរឫស្សី ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ បាន ចូល សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល បុរី ១០០ ខ្នង នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ១២៖០០ នាទី ថ្ងៃត្រង់ បន្ទាប់ពី ទទួលបាន លទ្ធផល វិជ្ជមាន កូវីដ - ១៩ ជាមួយ ស្ថានភាព ក្អក ហត់ ខ្លាំង និង មាន ប្រវត្តិ ជំងឺ ទឹកនោម ផ្អែម ប្រចាំ កាយ ។
ដោយ ស្ថានភាព ជំងឺ មាន ការវិវត្ត ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ចេះតែ ធ្ងន់ធ្ងរ ឡើង ៗ និង អាការៈ ហត់ ដង្ហក់ ខ្លាំង ដែល តម្រូវ ឱ្យ ក្រុម គ្រូពេទ្យ បញ្ជូន គាត់ ទៅ ព្យាបាល បន្ត នៅ មន្ទីរពេទ្យ ហ្លួង ម៉ែ នៅ ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ២០២១ ពេល មកដល់ មន្ទីរពេទ្យ ក្រុម គ្រូពេទ្យ បាន ពិនិត្យ ឃើញ ថា អ្នកជំងឺ បាន ស្លាប់ បាត់បង់ជីវិត រួចទៅហើយ មុនពេល ចូល ដល់ មន្ទីរពេទ្យ នៅ ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ១២៖ ៤៥ នាទី ។
* ទី២៖ មណ្ឌល សុខភាព ចាក់អង្រែ បាន ឱ្យដឹង ថា បុរស ជនជាតិ ខ្មែរ អាយុ ៤៩ ឆ្នាំ រស់ នៅ សង្កាត់ ឫស្សីកែវ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ បន្ទាប់ពី បាន រកឃើញ មាន វិជ្ជមាន កូវីដ - ១៩ អ្នកជំងឺ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល ចាក់ អង្រៃ នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ០០៖ ១៦នាទី ជាមួយ អាការៈ ក្តៅ ក្អក ហត់ និង មាន ប្រវត្តិ ជំងឺ ទឹកនោម ផ្អែម ប្រចាំ កាយ ។
ដោយ ជំងឺ មាន ការវិវត្តិ កាន់តែ ធ្ងន់ធ្ងរ ឡើង ៗ និង ស្ថិត ក្នុង ស្ថានភាពហត់ ដង្ហក់ ខ្លាំង ដែល ត្រូវ ឱ្យ ក្រុម គ្រូពេទ្យ ជួយសង្គ្រោះ តាម លក្ខណៈ បច្ចេកទេស ដោយ មាន ការប្រើប្រាស់ ម៉ាស៊ីន ជំនួយ ដង្ហើម ផង ប៉ុន្តែ នៅតែ មិន អាច ជួយសង្គ្រោះ អ្នកជំងឺ បាន គាត់ ក៏ បាន ស្លាប់ បាត់បង់ជីវិត នៅ ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ០២៖៤៥ នាទី ។
ការសន្និដ្ឋាន របស់ ក្រុម គ្រូពេទ្យ៖ បុរស ជនជាតិ ខ្មែរ អាយុ ៤៩ ឆ្នាំ ខាងលើ នេះ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ វិបត្តិ ផ្លូវ ដង្ហើម ស្រួច ស្រាវ ធ្ងន់ធ្ងរ និង រលាក សួត ទាំង សងខាង ដោយសារ វីរុស កូវីដ - ១៩ លើ អ្នក មាន ជំងឺ ទឹកនោម ផ្អែម ប្រចាំ កាយ ។
ខ្លឹមសារ សង្ខេប នៃ សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល ហាមឃាត់ ការធ្វើដំណើរ ឆ្លង ខេត្ត . ការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ
( ភ្នំពេញ ) ៖ បណ្ដាញ ព័ត៌មាន Fresh News សូម បង្ហាញ នូវ ការសង្ខេប បទប្បញ្ញត្តិ សំខាន់ ៗ ដែល មាន ចែង ក្នុង សេចក្ដីសម្រេច របស់ រាជ រដ្ឋាភិបាល ស្ដីពី ការបន្ដ ហាមឃាត់ ការធ្វើដំណើរ និង បិទ រមណីយដ្ឋាន ទេសចរណ៍ នៅ ទូទាំង ប្រទេស ជា បណ្ដោះអាសន្ន និង ការបិទ ខ្ទប់ ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ។
ជាមួយគ្នា នេះ ក៏ មាន ការសង្ខេប នូវ ការ កែសម្រួល វិធានការ ដែល ត្រូវបាន អនុវត្ត ក្នុង អំឡុង ពេល បិទ ខ្ទប់ (Lockdown) ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។ សេចក្ដីសង្ខេប នេះ គឺ ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ងាយស្រួល ក្នុង ការស្វែងយល់ នូវ អ្វី ដែល ជា វិធានការ របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ នា ពេល កន្លងមក ។ សូម អាន ខ្លឹមសារ សង្ខេប នៅ ខាងក្រោម នេះ៖
សាលា រាជធានី ភ្នំពេញ បាន កំណត់ កម្រិត ទឹកប្រាក់ ពិន័យ អន្តរការណ៍ ទៅ តាម វិធានការ រដ្ឋបាល នីមួយ ៗ ចំពោះ បុគ្គល ដែល មិន គោរព ដោយ ចេតនា នូវ វិធានការ រដ្ឋបាល ដែល រាជ រដ្ឋាភិបាល និង រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ដាក់ចេញ ក្នុង គោលបំណង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ជំងឺ ឆ្លងកាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ។
សាលា រាជធានី ភ្នំពេញ បាន កំណត់ ទៀត ថា មន្ត្រី ដែល មាន នីតិសម្បទា ជា នគរបាល យុត្តិធម៌ នៃ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ ចេញ បង្កាន់ដៃ ពិន័យ អន្តរការណ៍ ជូន បុគ្គល ដែល មិន គោរព ដោយ ចេតនា វិធានការ រដ្ឋបាល ខាងលើ ដើម្បី បង្គាប់ឱ្យ បុគ្គល នោះ បង់ប្រាក់ ពិន័យ អន្តរការណ៍ ទៅ តាម កំហុស ដែល ខ្លួន បាន ប្រព្រឹត្ត ក្នុង រយៈពេល ៣០ ( សាមសិប ) ថ្ងៃ គិត ចាប់ពី ថ្ងៃ បាន ទទួល បង្កាន់ដៃ ពិន័យ អន្តរការណ៍ ។
លោក ឃួង ស្រេង បាន ប្រកាស បញ្ចេញ អង្ករ ដែល ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រមាណ ១៤០ តោន នៅ ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ ស្អែក នេះ ដោយ ផ្តល់ ទៅ មួយ ខណ្ឌ ចំនួន ១០តោន ។ អង្ករ ទាំងអស់ នេះ ទុក ឱ្យ អភិបាល ខណ្ឌ យក ទៅ ចែកជូន ប្រជាពលរដ្ឋ ដែល ខ្វះខាត ស្បៀងអាហារ ។
លោក ឃួង ស្រេង ក៏ បាន ណែនាំ ឱ្យ អភិបាល ខណ្ឌ ទាំងអស់ តាមដាន ឱ្យ ជាប់ ជាប្រចាំ លើ បណ្តាញ សង្គម ហ្វេសប៊ុក ដើម្បី ពិនិត្យមើល ការដង្ហោយ ហៅ រក ជំនួយ ពីសំណាក់ ប្រជាពលរដ្ឋ ដែល ខ្វះខាត ។
សូម បញ្ជាក់ ថា ក្នុង កំលុង ពេល ប្រទេសជាតិ កំពុង ជួប បញ្ហា ដោយសារ ជំងឺ កូវីដ១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន សម្រេច ជា គោលការណ៍ ផ្តល់ ថវិកា និង ស្បៀ អាហារ ផ្សេង ៗ សម្រាប់ ប្រជាពលរដ្ឋ ធ្វើចត្តាឡី ស័ក ហើយក៏ បាន ណែនាំ ឱ្យ គិតគូរ ផ្តល់ ស្បៀងអាហារ សម្រាប់ អ្នក ខ្វះខាត ក្នុង កំលុង ពេល អនុវត្ត វិធានការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ ផងដែរ ៕
គួរ បញ្ជាក់ ថា ចំនួន អ្នកស្លាប់ ដោយសារ ជំងឺ រាតត្បាត សកល COVID-19 នៅ ទូទាំង ប្រទេស អាល្លឺម៉ង់ សរុប ៨០. ៥២៦ នាក់ គិត ត្រឹម ថ្ងៃអាទិត្យ នេះ ។ អាល្លឺម៉ង គឺជា ប្រទេស ឈលំដាប់ថ្នាក់ ទី៥ ដែល មាន អ្នកស្លាប់ ច្រើន ជាង គេ បំផុត នៅ អ៊ឺរ៉ុប ដោយ នៅ ពីក្រោយ អង់គ្លេស អ៊ឺតាលី រុស្ស៊ី និង បារាំង ៕
តុលាការ សម្រេច ឃុំ ខ្លួន បុគ្គល បើក ឡាន ពាក់ ផ្លាកលេខ ន. ប ពេល អនុវត្ត ការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ ក្រោម បទ ចោទ ការរារាំង ដល់ ការអនុវត្ត វិធានការ និង គ្មាន សិទ្ធិ ប្រើ នូវ យានយន្ត ដែល មាន ស្លាកសញ្ញា សម្គាល់ នគរបាល ឬ យោធា
