( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ និង របួស ធ្ងន់ ស្រាល ១២នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . ប្រជែង . បត់ គ្រោះថ្នាក់ និង មិន ប្រកាន់ ស្ដាំ ៕
ទន្ទឹម គ្នា នោះ អ្នកនាំពាក្យ ការបរទេស រូប នេះ បាន សង្កត់ធ្ងន់ ថា រុស្ស៊ី បាន ព្រមាន សហរដ្ឋ អាមេរិក ម្តង ហើយ ម្តង ទៀត អំពី ផលវិបាក នៃ សកម្មភាព អរិភាព របស់ ខ្លួន ដែល បញ្ជាក់ ពី កម្រិត នៃ ការប្រឈមមុខ រវាង ប្រទេស ទាំង ពីរ ។
គួរ បញ្ជាក់ ថា នៅ ព្រឹក ថ្ងៃ នេះ សហរដ្ឋ អាមេរិក បាន សម្រេច ដាក់ទណ្ឌកម្ម ប្រឆាំង នឹង រុស្ស៊ី និង បណ្តេញ អ្នកការទូត ចំនួន ១០នាក់ ដើម្បី ជា ការឆ្លើយតប នឹង ការជ្រៀត ជ្រែក ការបោះឆ្នោត និង ការវាយប្រហារ តាម អ៊ិនធឺរណែត ដែល ត្រូវបាន ចោទប្រកាន់ ថា ទីក្រុង មូស្គូ គឺជា អ្នក នៅ ពីក្រោយ ខ្នង ៕
ក្រសួង ការងារ ជូនដំណឹង ពី ការស្នើសុំ លិខិត អនុញ្ញាត ចេញ - ចូល រោងចក្រ សហគ្រាស និង សិប្បកម្ម ដែល ត្រូវ អនុញ្ញាត អំឡុង ពេល វិធានការបិទ ខ្ទប់ នៅ ភ្នំពេញ និង ក្រុង តាខ្មៅ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ជូន ដំណឹង ពី តម្រូវការ ឯកសារ និង ទីកន្លែង ស្នើសុំ « លិខិត អនុញ្ញាត ចេញ - ចូល » រោងចក្រ សហគ្រាស និង សិប្បកម្ម ដែល ត្រូវបាន អនុញ្ញាតឲ្យ ដំណើរការ ក្នុង អំឡុង ពេល នៃ ការអនុវត្ត វិធានការបិទ ខ្ទប់ ជា បណ្តោះ
អាសន្ន នៅ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ។
* ទី ១៖ ត្រូវ យក ឯកសារ បើក សហគ្រាស និង បញ្ជី ឈ្មោះ កម្មករ និយោជិត និង បុគ្គលិក ដែល ត្រូវ ធ្វើដំណើរ មក បំពេញ ការងារ ក្នុង អំឡុង ពេល បិទ ខ្ទប់ ។
* ទី ២៖ ត្រូវ ចាត់ តំណាង ១ រូប មក ស្នើសុំ នៅ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ សម្រាប់ រោងចក្រ សហគ្រាស សិប្បកម្ម នៅ រាជធានី ភ្នំពេញ និង មក ស្នើសុំ នៅ មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កណ្តាល សម្រាប់ រោងចក្រ សហគ្រាស សិប្បកម្ម នៅ ក្រុង តាខ្មៅ ។
បន្ថែម លើ « លិខិត អនុញ្ញាត ចេញ - ចូល » នេះ លោក លោកស្រី ព្រមទាំង កម្មករ និយោជិត និង បុគ្គលិក ត្រូវ យក តាម ខ្លួន ផងដែរ នូវ បណ្ណ ការងារ ឬ បណ្ណ បុគ្គលិក និង អត្តសញ្ញាណ បណ្ណ សញ្ជាតិ ខ្មែរ ដើម្បី បង្ហាញ ជូន សមត្ថកិច្ច ។ ជន ទាំងឡាយ ណា ដែល ក្លែង « លិខិត អនុញ្ញាត ចេញ - ចូល » ឬ ប្រើ លិខិត នេះ ខុសពី គោលបំណង ដើម ត្រូវ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ជាធរមាន ។
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត និង សោកស្តាយ ជាខ្លាំង ជាមួយ ក្រុមគ្រួសារ សព លោក ម៉ៅ អាយុទ្ធ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ដែល បាន ទទួលមរណភាព ដោយសារ ជំងឺ កូវីដ - ១៩ ក្នុង ជន្មាយុ ៧៧ ឆ្នាំ ។
នៅក្នុង ការចូលរួម រំលែក មរណទុក្ខ នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ចាត់ទុក ការស្លាប់ របស់ លោក ម៉ៅ អាយុទ្ធ គឺជា ការបាត់បង់ នូវ ធនធាន មនុស្ស ដ៏ សំខាន់ មួយ ជាពិសេស គឺ ការបាត់បង់ អ្នកនិពន្ធ ខ្សែភាពយន្ត ខ្មែរ ដ៏ ល្បីល្បាញ មួយ រូប ក្នុង ចំណោម អ្នកនិពន្ធ ខ្សែភាពយន្ត ជើង ខ្លាំង ដទៃ ទៀត នៅក្នុង វិស័យ សិល្បៈ ខ្មែរ ។
ស្ថិត ក្នុង មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង សូមឲ្យ វិញ្ញាណក្ខន្ធ លោក ម៉ៅ អាយុទ្ធ បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ក្នុង សន្និសីទ សារព័ត៌មាន ពាក់ព័ន្ធ នឹង ស្ថានភាព Lockdown រាជធានី ភ្នំពេញ នៅ ព្រលប់ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ លោក ឃួង ស្រេង បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « អាល់កុល គឺជា ទំនិញ ចាំបាច់ មួយ ដែល ស្ថិត នៅក្នុង ទំនិញ អាទិភាព ដែល សម្រាប់ ការពារ ខ្លួន អញ្ចឹង គ្មាន ហេតុផល អី ត្រូវ ហាមឃាត់ ការដឹក អាល់កុល ទេ » ។
ការលើកឡើង របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង ដោយសារ មាន ដំណឹង ពី មូលដ្ឋាន ថា មាន អ្នកចែកចាយ អាល់កុល និង សម្ភា ការពារ កូវី ដ១៩ នៅ ខណ្ឌ ឫស្សីកែវ បាន ដឹក ទំនិញ ទាំងនោះ ទៅ ចែកចាយ នៅ ចម្ការ ដូង និង ផ្លូវ ៦០ម៉ែត្រ តែ ត្រូវ អាជ្ញាធរ មូលដ្ឋាន ឃាត់ មិន ឲ្យ ឆ្លងកាត់ ។ អាជ្ញាធរ មូលដ្ឋាន ថា ទាល់តែ អ្នកចែកចាយ នោះ មាន ឯកសារ អនុញ្ញាត ទើប បាន ។
ដើម្បី អស់ មន្ទិល សង្ស័យ និង ងាយស្រួល ក្នុង ការបកស្រាយ ចម្ងល់ ជូន ប្រជាពលរដ្ឋ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ប្រកាស ដាក់ ប្រើប្រាស់ នូវ លេខ ទូរស័ព្ទ Hotline និង លេខ ៣ប្រព័ន្ធ ផ្សេង ទៀត ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ទំនាក់ទំនង សួរ សំណួរ បន្ថែម នៅពេល មាន ចម្ងល់ ណាមួយ ពាក់ព័ន្ធ បញ្ហា បិទ ខ្ទប់ (Lockdown) រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ។
( ភ្នំពេញ ) ៖ កម្មករ និយោជិត នៅ តាម រោងចក្រ សហគ្រាស នានា ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច ផ្តល់ អាទិភាព ក្នុង ការទទួលបាន វ៉ាក់សាំង កូវីដ១៩ ផងដែរ ដើម្បី បង្កើន ភាពសុាំ ក្នុង ចង្កោម កម្មករ និយោជិត និង ធានា ដល់ និរន្តភាព ការងារ មិន រង ការរំខាន ពី ជំងឺ កូវីដ១៩ ។
ក្នុង ដំណាក់កាល ដំបូង សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តល់ វ៉ាក់សាំង សម្រាប់ ចាក់ ជូន កម្មករ និយោជិត ប្រមាណ ជាង ១០ម៉ឺន នាក់ ។
លោក ហេង សួរ បាន ឱ្យដឹង ដែរ ថា ការចាក់ ជូន កម្មករ និយោជិត គឺ ខុសពី ការចាក់ ជូន មន្ត្រីរាជការ ឬ ប្រជាពលរដ្ឋ ទូទៅ ដោយ ក្រសួង បាន បែងចែង ក្រុម គ្រូពេទ្យ រហូតដល់ទៅ ៦០ ក្រុម ហើយ ចុះ ចាក់ ដល់ រោងចក្រ តែម្តង ។ បើ តាម លោក ហេង សួរ ការចាក់ បែប នេះ ដើម្បី បញ្ចៀស ហានិភ័យ នៃ ការឆ្លង ជំងឺ និង ពន្លឿន ដំណើរការចាក់ ផងដែរ ។
លោក ហេង សួរ បាន កត់សម្គាល់ ឃើញ ថា មាន កម្មករ និយោជិត និង បណ្តា រោច ក្រ ជាច្រើន បាន ដាក់ សំណើ សុំ ចាក់ វ៉ាក់សាំង ក្រោម គោលការណ៍ ស្ម័គ្រចិត្ត ។ លោក បាន បញ្ជាក់ ថា មកដល់ ពេលនេះ មាន កម្មករ និយោជិត រហូតដល់ទៅ ប្រមាណ ៦០ ម៉ឺន នាក់ បាន ស្នើសុំ ចាក់ វ៉ាក់សាំង ។
លោក ហេង សួរ បាន គូសបញ្ជាក់ ថា តាមរយៈ សំណើ នេះ គឺ បាន បង្ហាញ ឱ្យ ឃើញ ពី ការយល់ ច្បាស់ របស់ កម្មករ និយោជិត លើ គុណ តម្លៃ វ៉ាក់សាំង សម្រាប់ សុខភាព ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
បន្ថែម ពីលើ នេះ លោក ហេង សួរ ក៏ បាន អំពាវនាវ ដល់ កម្មករ និយោជិត ទាំងអស់ ឱ្យ ចូលរួម ចាក់ វ៉ាក់សាំង ទៅ តាម ផែនការ របស់ រាជ រដ្ឋាភិបាល ។ ជាពិសេស ត្រូវ ជឿ ទុកចិត្ត លើ អ្នក វេជ្ជសាស្ត្រ និង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល លើ ការងារ ចាក់ វ៉ាក់សាំង ដោយ មិន ត្រូវ ជឿ តាម ការអុច អាល ណាមួយ នោះ ឡើយ ។
លោក ហេង សួរ ក៏ បាន គូសបញ្ជាក់ ដែរ ថា តាម ការគ្រោងទុក របស់ រាជ រដ្ឋាភិបាល ក្នុង ចំណោម កម្មករ និយោជិត ប្រមាណ ជា ២លាន នាក់ គ្រោង នឹង បញ្ចប់ ការវ៉ាក់សាំង នៅ អំឡុង ខែមិថុនា ឆ្នាំ ២០២២ បើសិន រាជ រដ្ឋាភិបាល អាច រក វ៉ាក់សាំង បាន តាម ផែនការ របស់ ខ្លួន ៕
ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន ពាក់ព័ន្ធ នឹង ស្ថានភាព Lockdown រាជធានី ភ្នំពេញ នៅ ព្រលប់ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ លោក ឃួង ស្រេង បាន ឲ្យដឹង ថា អំឡុង ពេល បិទ ខ្ទប់ រាជធានី ភ្នំពេញ ១៤ ថ្ងៃ នេះ រាជ រដ្ឋាភិបាល បាន ទុក សិទ្ធិ ឲ្យ ប្រជាពលរដ្ឋ អាច ដើរ ទៅ ផ្សារ ទិញ ទំនិញ និង ធ្វើដំណើរ ចេញ ក្រៅ បាន ពេល មាន ការចាំបាច់ ផ្សេង ៗ ។ នេះ ជា ចរិត ទន់ភ្លន់ ដែល ជា ការគិតគូរ របស់ រាជ រដ្ឋាភិបាល ចំពោះ ប្រជាពលរដ្ឋ យ៉ាង ច្បាស់លាស់ ។
លោក អភិបាល រាជធានី ភ្នំពេញ ថែមទាំង រំលឹក ថា បើ ទោះបី រាជធានី ភ្នំពេញ ត្រូវបាន Lockdown រយៈពេល ១៤ ថ្ងៃ ហាង ទំនិញ លក់ ម្ហូប អាហារ ភេសជ្ជៈ និង របស់របរ ចាំបាច់ ប្រើប្រាស ប្រចាំ ថ្ងៃ មួយចំនួន នៅតែ បន្ត បម្រើ ជូន ប្រជាពលរដ្ឋ ។ លោក ក៏ សំណូមពរ ប្រជាពលរដ្ឋ កុំ មាន ការយល់ ច្រឡំ ថា ហាង ទាំងអស់ ត្រូវបាន បិទ ខណៈ ដែល ធ្វើឲ្យ មាន ក្រុម ឈ្មួញ ទុច្ចរិត មួយចំនួន ឆ្លៀត តម្លើង ថ្លៃ ទំនិញ ទៀត នោះ ។
លោក ឃួង ស្រេង បាន សុំ ការយោគយល់ ពី ប្រជាពលរដ្ឋ អំឡុង ពេល បិទ ខ្ទប់ នេះ និង ស្នើសុំ ឲ្យ ចូលរួម ទាំងអស់ គ្នា ដើម្បី កម្ចាត់ កូវីដ១៩ ។ លោក សង្កត់ធ្ងន់ ថា វិធានការបិទ ខ្ទប់ នេះ មិន មែន ធ្វើឡើង ដើម្បី សម្លាប់ ពលរដ្ឋ ទេ តែ ជា វិធានការ ដើម្បី ប្រជាពលរដ្ឋ និង សង្គមជាតិ ទាំងមូល ។
លោក បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល ធ្វើឡើង ទាំង ទើស ទាល់ បំផុត ព្រោះ ដឹង ថា បងប្អូន ប្រជាពលរដ្ឋ ប្រាកដជា មាន ការលំបាក និង មាន ការថ្នាំង ថ្នាក់ ប៉ុន្តែ បើ បងប្អូន ពិចារណា ឲ្យបាន ដិតដល់ បងប្អូន នឹង មិន ថ្នាំង ថ្នាក់ ជាមួយ ឪពុក ម្តាយ ដែល តឹង តែង ជាមួយ កូន ទេ » ។
លោក បន្ត ថា « សូម បងប្អូន ប្រជាពលរដ្ឋ កុំ ស្តាប់ ពាក្យ ចចាមអារ៉ាម បំផ្លើស និង បំភ័យ ធ្វើឲ្យ ឈ្មួញ ទុច្ចរិត ឆ្លៀត ឱកាស តម្លើង ថ្លៃ ទំនិញ និង គ្រឿង ឧបភោគ បរិភោគ ។ ក្នុង សេចក្តីសម្រេច រាជ រដ្ឋាភិបាល បាន ទុកឲ្យ រោងចក្រ សហគ្រាស ផលិត គ្រឿង ឧបភោគ បរិភោគ ឲ្យ ដំណើរការ នៅ ដដែល » ។
លេខ ទូរស័ព្ទ ដើម្បី ប្រជាពលរដ្ឋ សាកសួរ នូវ ចម្ងល់ ផ្សេង ៗ រួម មាន៖
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន អនុញ្ញាតឱ្យ រោងចក្រ សហគ្រាស និង សិប្បកម្ម ចំនួន ១១ ប្រភេទ អាច ដំណើរការ ជាធម្មតា នៅ អំឡុង ពេល បិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នា ពេលនេះ ។ នេះ បើ តាម សេចក្តីសម្រេច របស់ ក្រសួង ការងារ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
តាម សេចក្តីសម្រេច នេះ បាន បញ្ជាក់ ថា ប្រភេទ រោងចក្រ សហគ្រាស និង សិប្បកម្ម ដែល ត្រូវបាន អនុញ្ញាតឱ្យ ដំណើរការ សកម្មភាព អាជីវកម្ម ក្នុង អំឡុង ពេល នៃ ការអនុវត្ត វិធានការបិទ ខ្ទប់ ជា បណ្តោះអាសន្ន នូវ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល មាន ដូច ខាងក្រោម៖
ក្រសួង ការងារ ក៏ បាន អនុញ្ញាតឱ្យ បុគ្គលិក ផ្នែក សន្តិសុខ . រដ្ឋបាល . ហិរញ្ញវត្ថុ . ផ្គត់ផ្គង់ និង ដឹកជញ្ជូន នៃ រោងចក្រ សហគ្រាស និង សិប្បកម្ម ដែល ត្រូវបាន ឱ្យ ផ្អាក ដំណើរការ អាជីវកម្ម ចំនួន មិន លើស ពី ២៥ នាក់ ក្នុង មួយ រោងចក្រ សហគ្រាស មក បំពេញ ការងារ ជាធម្មតា ដើម្បី ធានា សេវា អប្បបរមា និង គ្រប់គ្រង សន្និធិ ទំនិញ និង ផលិតផល របស់ ខ្លួន ។
រាល់ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ដែល ត្រូវបាន អនុញ្ញាត ដូច បាន រៀបរាប់ ខាងលើ បុគ្គល គ្រប់ រូប មាន កាតព្វកិច្ច ត្រូវ អនុវត្ត វិធានការ សុខាភិបាល រួម មាន ការពាក់ ម៉ាស់ និង ការរក្សា គម្លាត សុវត្ថិភាព ព្រមទាំង ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ការធ្វើ អនាម័យ ដើម្បី សម្លាប់ មេរោគ និង ការវាស់ កម្ដៅ ដើម្បី ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
រាល់ រោងចក្រ សហគ្រាស សិប្បកម្ម ឬ ទីតាំង អាជីវកម្ម ដែល ត្រូវបាន អនុញ្ញាតឱ្យ នៅ បើក ដំណើរការ ស្រប តាម ប្រការ១ នៃ សេចក្តីសម្រេច នេះ ត្រូវ ផ្អាក ប្រតិបត្តិការ របស់ ខ្លួន ចាប់ពី ម៉ោង ២០ ( ម្ភៃ ) ដល់ ម៉ោង ៥ ( ប្រាំ ) សម្រាប់ ទទួល អតិថិជន ដោយ ផ្ទាល់ លើកលែង ចំពោះ សេវា សង្គ្រោះ បន្ទាន់ សេវា សុខាភិបាល ឱសថស្ថាន ស្ថានីយ ប្រេងឥន្ធនៈ សេវា សណ្ឋាគារ និង ផ្ទះសំណាក់ និង សេវា សាធារណៈ ចាំបាច់ ដទៃ ទៀត ដោយ មាន ការ អនុញ្ញាត ពី អាជ្ញាធរ មាន សមត្ថកិច្ច ។
( ម៉ានីល) ៖ ក្រសួង សុខាភិបាល នៃ ប្រទេស ហ្វីលីពីន បាន រាយការណ៍ ថា មាន ករណី ឆ្លង ថ្មី ចំនួន ១១. ៤២៩ ករណី បន្ថែម ទៀត ត្រូវ បាន បញ្ជាក់ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ ដែល នាំឲ្យ ចំនួន អ្នក ឆ្លង សរុប កើន ដល់ ៩០៤. ២៨៥ ករណី ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃព្រហស្បតិ៍ ទី១៥ ខែមេសា ឆ្នាំ ២០២១ ។
ក្នុង រយៈពេល ដូចគ្នា នេះ ប្រទេស អាស៊ី អាគ្នេយ៍ មួយ នេះ ក៏ បាន កត់ត្រា ករណី ស្លាប់ ដោយសារ ជំងឺ ដ៏ កាច សាហាវ នេះ ចំនួន ១៤៨ នាក់ ផងដែរ ដែល នាំឲ្យ អ្នកស្លាប់ សរុប កើន ដល់ ១៥. ៥៩៤ នាក់ នៅ ទូទាំង ប្រទេស ។
ក្រសួង សុខាភិបាល ហ្វីលីពីន បាន គូសបញ្ជាក់ ថា បច្ចុប្បន្ន ករណី សកម្ម ដែល កំពុង សម្រាប ព្យាបាល ក្នុង មន្ទីរពេទ្យ មាន ចំនួន សរុប ១៨៣. ៥២៧ ករណី ។
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ទទួលបាន ការឧបត្ថម្ភ គ្រែ ពេទ្យ ចំនួន ៦០ និង ឧបករណ៍ តាមដាន ជីវិត ពី សប្បរស ជន សម្រាប់ ចូលរួម ទប់ស្កាត់ និង ព្យាបាល ជំងឺ កូវីដ១៩
( កំពង់ស្ពឺ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ទទួល ការឧបត្ថម្ភ គ្រែ ពេទ្យ ចំនួន ៦០ និង ឧបករណ៍ តាមដាន ជីវិត ចំនួន ១០ ពី សប្បរស ជន សម្រាប់ ចូលរួម ទប់ស្កាត់ និង ព្យាបាល ជំងឺ កូវីដ១៩ នៅក្នុង ខេត្ត ខណៈ ការឆ្លង ហាក់ មាន ការកើនឡើង ក្នុង រយៈ ចុងក្រោយ នេះ ។
លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ក្នុង នាម ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ក្រុមហ៊ុន និង សប្បរស ជន ទាំងអស់ ដែល បាន ចូលរួមចំណែក យ៉ាង ខ្លាំង ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ១៩ ។
ក្រុមហ៊ុន និង សប្បរស ជន ដែល បាន ចូលរួម បរិច្ចាគ ជូន រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ រួម មាន៖
អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ចាត់ទុក ថា ការជួយ ឧបត្ថម្ភ ដល់ រដ្ឋបាល ខេត្ត គឺ ដូចជា បាន ជួយ ទ្រទ្រង់ ចំពោះ សុខភាព ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ជាង នេះ ទៅ ទៀត ហាក់ បាន ជួយ សម្រួល បន្ទុក ដល់ រាជ រដ្ឋាភិបាល ប្រយុទ្ធ ប្រឆាំង និង ជំងឺ កាច សាហាវ កូវីដ១៩ ដែល រាតត្បាត លើ សកលលោក បាន សម្លាប់ ជីវិត រាប់ លាន នាក់ ។
លោក អភិបាល ខេត្ត នៅតែ អំពាវនាវ ចំពោះ សប្បុរសជន ទាំងឡាយ មាន បំណង ជួយ សម្រាល ចំពោះ កិច្ចការ ខាងលើ រដ្ឋបាល ខេត្ត សង្ឃឹម យ៉ាង មុតមាំ ថា បងប្អូន សប្បុរស នៅតែ បន្ត ជួយ ដើម្បី ផ្តល់ ជូន ចំពោះ ប្រជាពលរដ្ឋ ដែល ការខ្វះខាត បន្ត ៕
បុរស រូប នេះ ត្រូវបាន កម្លាំង នគរបាល កំពុង កសាង បញ្ជូន ទៅកាន់ តុលាការ ចាត់ការ តាម ច្បាប់ ក្រោម បទ ចោទ « ប្រឆាំង នឹង ការអនុវត្ត ការងារ សារធារណ:» ។
របាយការណ៍ របស់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ បាន បញ្ជាក់ ថា « នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ប្រហែល១០៖ ៣០នាទី កម្លាំង របស់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ០១ នាក់ ជាក់ស្ដែង ពី « បទ ប្រឆាំង នឹង ការអនុវត្ត ការងារ សារធារណ:» ប្រព្រឹត្ត នៅ ចំណុច មុខ ផ្ទះ លេខ ៤៥ ផ្លូវ លេខ ១២៨ កែង ផ្លូវ ២១៥ ក្រុម ទី២២ ភូមិ ៩ សង្កាត់ ផ្សារ ដេប៉ូទី២ ខណ្ឌ ទួលគោក » ។
ភ្លាម ៗ នោះ កម្លាំង សមត្ថកិច្ច យើង ដែល នៅ ប្រចាំ ការគោលដៅ ក៏ បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ និង ចាប់ យក កូន កាំបិត ចិត បន្លែ ចុង ស្រួច ដង ពណ៌ ក្រហម ចំនួន ០១ រួច បញ្ជូន មកកាន់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក ដើម្បចាត់ការ តាម នីតិវ ធី ច្បាប់ តែម្ដង ។
ក្រោយពី ឃាត់ខ្លួន ជនសង្ស័យ ខាងលើ សមត្ថកិច្ច បាន យក ទឹកនោម ជនសង្ស័យ រូប នេះ យកមក ធ្វើតេស្ត ស្វែងរក សារធាតុ ញៀន ក្នុង ទឹកនោម ជា លទ្ធផល មាន ភាពអវិជ្ជមាន ។ បច្ចុប្បន្ន : ជនសង្ស័យ ខាងលើ កំពុង ឃាត់ខ្លួន ជា បណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក ដើម្បី សាកសួរ និង ចាត់ការ តាម ផ្លូវ ច្បាប់ ៕ រដ្ឋបាល ខេត្ត តាកែវ ជូនដំណឹង ឱ្យ ផ្អាក លក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ និង ការផ្អាក ការជួបជុំ រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃ នេះ តទៅ
( តាកែវ )៖ រដ្ឋបាល ខេត្ត តាកែវ នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីណែនាំ ស្ដីពី ការផ្អាក លក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ និង ការផ្អាក ការជួបជុំ រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៥ ខែមេសា ដល់ ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ នៅក្នុង ភូមិសាស្ត្រ ខេត្ត តាកែវ ។
សេចក្ដីជូនដំណឹង បាន ឱ្យដឹង ថា ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភៈ » និង ក្នុង គោលបំណង ការពារ អាយុជីវិត របស់ ប្រជាពលរដ្ឋ សុខភាព សាធារណៈ និង សណ្តាប់ធ្នាប់ សាធារណៈ រដ្ឋបាល ខេត្ត តាកែវ សូម ធ្វើ ការណែនាំ នូវ វិធានការចាំបាច់ មួយ ចំនួន ដូច ខាងក្រោម៖
ទី១៖ គ្រប់ ផ្សារ រដ្ឋ ផ្សារ ឯកជន ផ្សារ ម៉ាត ភោជនីយដ្ឋាន អាហារដ្ឋាន តូប អាហារ ហាង ការហ្វេ ហាង ភេសជ្ជៈ ទីតាំង អាជីវកម្ម ផ្នែក អាហារដ្ឋាន គ្រប់ ប្រភេទ ត្រូវ ផ្អាក ជា បណ្តោះអាសន្ន នូវ ការលក់ដូរ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ រយ ពេល ២សប្តាហ៍ ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២១ ។
ទី ២៖ ភោជនីយដ្ឋាន អាហារដ្ឋាន គេហដ្ឋាន ហាង លក់ ភេសជ្ជៈ និង អាជីវកម្ម ផ្នែក អាហារដ្ឋាន គ្រប់ ប្រភេទ ត្រូវ ផ្អាក ជា បណ្តោះអាសន្ន ចំពោះ ការទទួល អតិថិជន មក ទទួលទាន ក្នុង បរិវេណ អាជីវកម្ម របស់ ខ្លួន ប៉ុន្តែ អាច វេចខ្ចប់ អាហារ ហូបចុក បាន ។
ទី៣៖ មន្ទីរ ពាណិជ្ជកម្ម មន្ទីរ ទេសចរណ៍ ខេត្ត តាកែវ និង អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ សហការ ចុះ ត្រួតពិនិត្យ តាម គោលដៅ តាម ផ្សារ ផ្សារ ម៉ាត ភោជនីយដ្ឋាន អាហារដ្ឋាន ហាង ភេជ្ជៈ គ្រប់ ប្រភេទ ដើម្បី អនុវត្ត តាម សេចក្តីជូនដំណឹង នេះ ។ ក្នុង ករណី ឃើញ ថា គណៈ គ្រប់គ្រង ផ្សារ ឬ ម្ចាស់ អាជីវកម្មដ្ឋាន ណាមួយ មិន ព្រម អនុវត្ត ត្រូវ ធ្វើ កិច្ចសន្យា ណែនាំ លើក ទី១ ហើយ ប្រសិនបើ នៅតែ បន្ត បំពាន ត្រូវតែ អនុវត្ត តាម វិធានការ រដ្ឋបាល និង វិធានការ ច្បាប់ ដោយ មិន លើកលែង ឡើយ ៕
UPDATE: គិត ត្រឹម ល្ងាច ត្រឹម ថ្ងៃទី ១៥ ខែមេសា នេះ កម្មករ និយោជិត និង ថ្នាក់ដឹកនាំ អង្គការ វិជ្ជាជីវៈ ៨៧ ៩៩៩ នាក់ ត្រូវបាន ចាក់ វ៉ាក់សាំង កូវីដ១៩
បើ តាម ក្រសួង ការងារ សម្រាប់ ក្នុង ថ្ងៃទី ១៥ ខែមេសា នេះ មាន អ្នកស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង សរុប ចំនួន ៧ ០៦៨ នាក់ ដោយ ចាក់ បាន ចំនួន ៦ ៨៨៣ នាក់ ក្នុង នោះ មាន បរទេស ចំនួន ៤២៨ នាក់ និង គ្រូពេទ្យ មិន អនុញ្ញាតឱ្យ ចាក់ ចំនួន ១៨៥ នាក់ ៕
ក្រសួង រៀបចំ ដែនដី ប្រកាស អំពី ការចាក់ វ៉ាក់សាំង កូវីដ១៩ លើក ទី២ ជូន ដល់ មន្រ្តី រាជការ របស់ ខ្លួន ចាប់ពី ថ្ងៃស្អែក នេះ
( ភ្នំពេញ ) ៖ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ថា ក្រសួង សុខាភិបាល នឹង ទៅ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីង - ១៩ ជា លើក ទី២ រយៈពេល ២ ថ្ងៃ ជូន ដល់ មន្រ្តី រាជការ ក្រសួង រៀបចំ ដែនដី ចាប់ពី ថ្ងៃស្អែក នេះ ។
ទោះជា យ៉ាង នេះ ក្តី ក្រសួង រៀបចំ ដែនដី បាន បញ្ជាក់ ថា អ្នក ដែល ត្រូវ មក ចាក់ វ៉ាក់សាំង លើក ទី២ ត្រូវ អនុវត្ត ដូច ខាងក្រោម៖ ១៖ យកមក ជាមួយ នូវ កាត់ ចាក់ វ៉ាក់សាំង លើក ទី១ ២៖ ពិនិត្យ លេខរៀង នៅក្នុង បញ្ជី ឈ្មោះ ដើម្បី ផ្ដល់ជូន មន្ត្រី ប្រចាំ ការ នៅ ច្រក ចូល ទើប អនុញ្ញាត ឱ្យ ចូល កន្លែង រង់ចាំ ៣៖ អ្នក ចាក់ វ៉ាក់សាំង ថ្ងៃទី២ ខែមេសា ឆ្នាំ ២០២១ ត្រូវ អញ្ជើញ មក ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២១ ៤៖ អ្នក ចាក់ វ៉ាក់សាំង ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២១ ត្រូវ អញ្ជើញ មក ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២១ ។
សូម បញ្ជាក់ ថា ក្រសួង រៀបចំ ដែនដី នា ថ្មី ៗ នេះ បាន ទទួល ការកោតសរសើរ ពី សម្តេច តេជោ ហ៊ុន សែន ដោយសារតែ ក្រៅពី ចាក់ វ៉ាក់សាំង ជូន មន្រ្តី រាជការ របស់ ខ្លួន ក្រសួង នេះ បាន ផ្តល់ ជូន នូវ ការចាក់ វ៉ាក់សាំង ដល់ មន្រ្តី ជាប់ កិច្ចសន្យា និង អ្នក អនាម័យ ផងដែរ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ ក្រសួង រៀបចំ ដែន ដី៖ កងកម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា ចាប់ខ្លួន មេដឹកនាំ បាតុកម្ម ម្នាក់ ខណៈ មនុស្ស មួយចំនួន ទៀត ស្លាប់ និង របួស នៅ ថ្ងៃព្រហស្បតិ៍ នេះ (Video inside) ( រ៉ង់ ហ្គូន ) ៖ កងកម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា នា ថ្ងៃព្រហស្បតិ៍ នេះ បាន ចាប់ខ្លួន មេដឹកនាំ មួយ រូប នៃ ចលនា បាតុកម្ម ប្រឆាំង យោធា ហើយក៏ មាន មនុស្ស មួយចំនួន ទៀត ស្លាប់ និង របួស ផងដែរ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី១៥ ខែមេសា ឆ្នាំ ២០២១ ។
ក្នុង ថ្ងៃព្រហស្បតិ៍ នេះ ទាហាន មីយ៉ាន់ម៉ា ក៏ បាន ធ្វើ សកម្មភាព បាញ់ បង្រ្កាប នៅ ទីក្រុង ម៉ាន ដាឡាយ (Mandalay) ដើម្បី បំបែក ក្រុម បាតុករ ដែល ភាគ ច្រើន ជា បុគ្គលិក សុខាភិបាល ផងដែរ ។ បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក របស់ មីយ៉ាន់ម៉ា បុរស ម្នាក់ បាន បាត់បង់ជីវិត ខណៈ មួយចំនួន ទៀត បាន រងរបួស និង ត្រូវ ឃាត់ខ្លួន ។
គួរ បញ្ជាក់ ថា សប្តាហ៍ នេះ គឺ ត្រូវ ជា បុណ្យ ចូល ឆ្នាំ ថ្មី នៅ មីយ៉ាន់ម៉ា ហៅ ថា Thingyan ដែល មាន រយៈពេល ឈប់ សម្រាក ០៥ ថ្ងៃ និង បាន ចាប់ផ្តើម កាលពី ថ្ងៃអង្គារ ប៉ុន្តែ ក្រុម សកម្មជន ប្រជាធិបតេយ្យ បាន អំពាវនាវ ឲ្យ ប្រជាជន ផ្អាក សកម្មភាព អបអរ ផ្សេង ៗ ចោល ដើម្បី បន្ត ផ្តោត លើ ចលនា បាតុកម្ម ប្រឆាំង យោធា របស់ ពួកគេ ហើយ មនុស្ស រាប់ រយ នាក់ បាន ចូលរួម ការធ្វើ បាតុកម្ម តាមរយៈ ការដើរ ដង្ហែ ក្បួន ជិះ ម៉ូតូ ដង្ហែ ព្រមទាំង ទម្រង់ សកម្មភាព ផ្សេង ៗ ទៀត ៕
ខេត្ត កំពង់ចាម សម្រេច ផ្អាក ២សប្តាហ៍ ការលក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ និង ផ្អាក ការទទួល អតិថិជន តែ អាជីវកម្ម ផ្នែក អាហារ - ភេសជ្ជៈ នៅ បន្ត លក់ ដដែល
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ១៥ ខែមេសា នេះ បាន ចេញ សេចក្តីណែនាំ ស្តីពី ការផ្អាក ជា បណ្តោះអាសន្ន រយៈពេល ០២ សប្ដាហ៍ ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ នូវ ការលក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ និង ការផ្អាក ការទទួល អតិថិជន ឱ្យ ចូលមក ទទួលទាន គ្រឿងស្រវឹង ក្នុង ភោជនីយដ្ឋាន អាហារដ្ឋាន ហាង ភេសជ្ជៈ និង អាជីវកម្ម ផ្នែក អាហារ - ភេសជ្ជៈ ដែល មាន លក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពង់ចាម ។
សេចក្តីណែនាំ នេះ បាន ធ្វើឡើង ដោយ យោង តាម អនុសាសន៍ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា កាលពី ថ្ងៃទី ១៤ ខែមេសា ឆ្នាំ ២០២១ ស្តីពី ការផ្អាក ការលក់ គ្រឿងស្រវឹង ទូទាំង ប្រទេស និង ស្ថានភាព នៃ ការឆ្លង រីករាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០ - កុម្ភៈ ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ២៣៦ នាក់ ទៀត ដែល បាន រកឃើញ កើត ជំងឺ កូវីដ១៩ នៅ ថ្ងៃទី ១៤ ខែមេសា ម្សិលមិញ នេះ ។
ខាងក្រោម នេះ គឺ ឈ្មោះ របស់ អ្នកជំងឺ កូវីដ១៩៖ ទីក្រុង ប៉េកាំង បាន ចាក់ វ៉ាក់សាំង ជូន ប្រជាជន ១២.៥លាន នាក់ ហើយ
គួរ បញ្ជាក់ ថា រហូតមកដល់ ពេលនេះ សមត្ថភាព ចាក់ វ៉ាក់សាំង ប្រចាំ ថ្ងៃ របស់ ទីក្រុង ប៉េកាំង ដែល មាន ប្រជាជន សរុប ជិត ២១លាន នាក់ បាន ឈានដល់ ចំនួន ៤០០.០០០ ដូស ហើយ ក្នុង មួយ ថ្ងៃ ។ រីឯ កន្លែង ចាក់ វ៉ាក់សាំង ជាង ៤០០ កន្លែង ត្រូវបាន បង្កើតឡើង នៅ ទូទាំង ទីក្រុង ៕
ក្រសួង អប់រំ អំពាវនាវ ឲ្យ បុគ្គលិក អប់រំ មន្រ្តី ជាប់ កិច្ចសន្យា និង បុគ្គលិក អង្គការ ក្នុង វិស័យ អប់រំ ដែល ចាក់ វ៉ាក់សាំង ដូស ទី១ រួចហើយ ត្រូវ មក ទៅ ចាក់ ដូស ទី២
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នា ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សារលិខិត លើកទឹកចិត្ត ចំពោះ បុគ្គលិក អប់រំ និង មន្រ្តី ជាប់ កិច្ចសន្យា នៃ អង្គភាព អប់រំ និង គ្រឹះស្ថាន សិក្សា សាធារណៈ និង ឯកជ ព្រមទាំង បុគ្គលិក អង្គការ មិន មែន រដ្ឋាភិបាល ក្នុង វិស័យ អប់រំ ដែល បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដូសទី១ រួចហើយ នោះ ត្រូវ ទៅ ចាក់ ដូស ទី២ តាម កាលបរិច្ឆេទ និង ទីកន្លែង ដែល បាន កំណត់ ឱ្យ បាន គ្រប់ គ្នា ៕
ខាងក្រោម នេះ ជា សារលិខិត របស់ ក្រសួង អប់ រំ៖
រដ្ឋបាល ខេត្ត ស្វាយរៀង បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង ជំងឺ កូវីដ ចំនួន ៦៩ នាក់ នៅ ក្រុង បាវិត
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ រសៀល ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ៦៩ នាក់ ដែល បម្រើ ការ និង ស្នាក់ នៅ កាស៉ីណូ ចំនួន ៣កន្លែង ស្ថិត ក្នុង ភូមិ បាវិត កណ្ដាល សង្កាត់ បាវិត ក្រុង បាវិត ។
សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា បច្ចុប្បន្ន អ្នក កើត ជំងឺ កូវីដ១៩ ទាំងអស់ នេះ ត្រូវបាន បញ្ជូន ទៅ មណ្ឌល ព្យាបាល ជំងឺ កូវីដ ចំនួន ៤៤ នាក់ . នៅ មន្ទីរពេទ្យ បង្អែក ស្វាយ ជ្រំ ចំនួន ១៤នាក់ និង នៅ មន្ទីរពេទ្យ បង្អែក សាមគ្គី រំដួល ចំនួន ១១នាក់ ។
ដោយឡែក ចំពោះ ទីតាំង ដែល ពាក់ព័ន្ធ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ នេះ ស្ថិត នៅ ភូមិ បាវិត កណ្ដាល សង្កាត់ បាវិត ក្រុង បាវិត ត្រូវបាន រៀបចំ ជា មណ្ឌល ចត្តាឡី ស័ក រួម មាន៖
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត ស្វាយរៀង ក៏ បាន អំពាវនាវ ដល់ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដោយ ផ្ទាល់ ឬ ប្រយោល ជាមួយ អ្នកជំងឺ កូវីដ១៩ និង ទីតាំង ខាងលើ គិត ចាប់ពី ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២១ ត្រូវ ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ រយៈពេល ១៤ ថ្ងៃ ដើម្បី តាមដាន សុខភាព ៕ អាហ្វហ្គានីស្ថាន គោរព ការសម្រេចចិត្ត ដក កងទ័ព របស់ អាមេរិក នៅ ត្រឹម ថ្ងៃទី ១១ ខែកញ្ញា
បើ តាម លោក Minapal ប្រធានាធិបតី អាហ្គានីស្ថាន និង ប្រធានាធិបតី អាមេរិក បាន ធ្វើ ការសន្ទនា តាម ទូរស័ព្ទ កាលពី យប់ ថ្ងៃពុធ ម្សិលមិញ ដោយ ពិភាក្សា អំពី ការសម្រេចចិត្ត របស់ សហរដ្ឋ អាមេរិក ក្នុង ការដក កងទ័ព ទាំងអស់ ចេញ ពី ប្រទេស អាហ្គានីស្ថាន នៅ ត្រឹម ថ្ងៃទី ១១ ខែកញ្ញា ខាងមុខ ។
ថ្ងៃទី ១១ ខែកញ្ញា ខាងមុខ គឺជា ខួប លើក ទី២០ នៃ ការវាយប្រហារ ភេរវកម្ម ដែល អូសទាញ សហរដ្ឋ អាមេរិក ធ្លាក់ ចូល ទៅក្នុង សង្គ្រាម នៅ អាហ្គានីស្ថាន ។ សេចក្តីសម្រេច ចុងក្រោយ របស់ សហរដ្ឋ អាមេរិក នេះ គឺ យូរ ជាង កាលបរិច្ឆេទ កំណត់ កន្លងមក ដែល ត្រូវបាន ចរចារ វា រដ្ឋបាល អាមេរិក អាណត្តិ មុន និង ក្រុម ឧទ្ទាម តាលី បង់ កាលពី ឆ្នាំ ២០២០ ដែល តម្រូវឲ្យ ដក ទ័ព អាមេរិក ចេញ ពី អាហ្វហ្គានីស្ថាន នៅ ថ្ងៃទី ០១ ខែឧសភា ។
គួរ បញ្ជាក់ ថា បើ តាម មន្ទីរ បញ្ចកោណ ( ក្រសួង ការពារ ជាតិ អាមេរិក ) មាន កងទ័ព អាមេរិក ប្រហែល២. ៥០០នាក់ កំពុង ឈរជើង នៅក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ប៉ុន្តែ ប្រព័ន្ធ ផ្សព្វផ្សាយ អាមេរិក នា ពេល ថ្មី ៗ នេះ បាន និយាយ ថា ចំនួន នេះ មិន បាន រាប់បញ្ចូល កងកម្លាំង ពិសេស អាមេរិក ចំនួន ១.០០០ នាក់ នៅក្នុង ប្រទេស នេះ ទេ ។ ក្រៅពី នេះ មាន កងទ័ព ណា តូ (NATO) ប្រមាណ ៧.០០០ នាក់ ទៀត នៅក្នុង អាហ្វហ្គានីស្ថាន ដែល ពឹងផ្អែក លើ ភ័ស្តុភារ និង ការគាំទ្រ សន្តិសុខ របស់ សហរដ្ឋ អាមេរិក ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៦៣ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក បទល្មើស សម្រាប់ រថយន្ត គឺ ភាគ ច្រើន លើស ល្បឿន អត់ បណ្ណ បើកបរ អត់ ស្លាកលេខ អត់ ខ្សែក្រវាត់ អត់ ឆៀក និង អាជីវកម្ម ជាដើម ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង ប្រកាស ពី ការរក ឃើញ អ្នក កើត កូវីដ១៩ ចំនួន ២នាក់ ទៀត នៅ ភូមិ បាវិត កណ្តាល . អ្នក ប៉ះពាល់ ផ្ទាល់ ៨នាក់ ត្រូវបាន យក សំណាក និង ឲ្យ ធ្វើចត្តាឡី ស័ក
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ បាន ស្រង់ សេចក្តីជូន ព័ត៌មាន របស់ ក្រសួង សុខាភិបាល ថា មាន ករណី វិជ្ជមាន ជំងឺ កូវីដ - ១៩ លើ បុគ្គល ចំនួន ០២ នាក់ រស់ នៅ ភូមិ បាវិត កណ្តាល សង្កាត់ បាវិត ក្រុង បាវិត ។
សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង បន្ត ថា កាលពី ថ្ងៃទី ១៣ ខែមេសា ឆ្នាំ ២០២១ ក្រុមការងារ បាន យក វត្ថុ វិភាគ សំណាក អ្នក មាន រោគសញ្ញា ចូលក្នុង និយមន័យ សង្ស័យ ថា មាន ជំងឺ កូវីដ - ១៩ នៅ អតីត យានដ្ឋាន Mr. SO ក្រុង បាវិត ដើម្បី ធ្វើតេស្ត នៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា លទ្ធផល វិជ្ជមាន ជំងឺ កូវីដ - ១៩ រួម មាន៖
បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ខាងលើ ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក សាមគ្គី រំដួល និង មាន អ្នក ប៉ះពាល់ ផ្ទាល់ ចំនួន ០៨ នាក់ រង់ចាំ ក្រុមការងារ យក វត្ថុ វិភាគ សំណាក និង ដាក់ ធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ ដើម្បី តាមដាន សុខភាព ។
រដ្ឋបាល ខេត្ត ព្រៃវែង ជូនដំណឹង ឲ្យ ផ្អាក លក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ និង ការផ្អាក ការជួបជុំ រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃ នេះ តទៅ
( ព្រៃវែង ) ៖ រដ្ឋបាល ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីណែនាំ ស្ដីពី ការផ្អាក លក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ និង ការផ្អាក ការជួបជុំ រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៥ ខែមេសា ដល់ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ នៅក្នុង ភូមិសាស្ត្រ ខេត្ត ព្រៃវែង ។
សេចក្ដីជូនដំណឹង បាន ឲ្យដឹង ថា ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភៈ » និង ក្នុង គោលបំណង ការពារ អាយុជីវិត របស់ ប្រជាពលរដ្ឋ សុខភាព សាធារណៈ និង សណ្តាប់ធ្នាប់ សាធារណៈ រដ្ឋបាល ខេត្ត ព្រៃវែង សូម ធ្វើ ការណែនាំ នូវ វិធានការចាំបាច់ មួយ ចំនួន ដូច ខាងក្រោម៖
១៖ ផ្អាក ការលក់ដូរ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ ( ស្រាបៀរ - ស្រា គ្រប់ ប្រភេទ ) នៅក្នុង ភូមិសាស្ត្រ ខេត្ត ព្រៃវែង ។
២៖ គ្រប់ ផ្សារ រដ្ឋ ផ្សារ ឯកជន ផ្សារ ម៉ាត ភោជនីយដ្ឋាន អាហារដ្ឋាន តូប អាហារ ហាង ការហ្វេ ហាង ភេសជ្ជៈ ទីតាំង អាជីវកម្ម ផ្នែក អាហារ - ភេសជ្ជៈ និង ដេប៉ូចែកចាយ គ្រឿងស្រវឹង នៅក្នុង ភូមិសាស្ត្រ ខេត្ត ត្រូវ ផ្អាក ជា បណ្តោះអាសន្ន នូវ ការលក់ដូរ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ ។
៣៖ ប្រជាពលរដ្ឋ ត្រូវ នៅ តាម ផ្ទះ រៀង ៗ ខ្លួន ក្នុង គ្រួសារ នីមួយ ៗ ។ ចំពោះ ការជួបជុំ ប្រមូលផ្តុំ គ្នា ច្រើន ពី ផ្ទះ មួយ ទៅ ផ្ទះ មួយ ការពិសារ គ្រឿងស្រវឹង និង ការចាក់ បាស រាំ កម្សាន្ត តាម ផ្ទះ ត្រូវ ហាមឃាត់ ជាដាច់ខាត ។
៤៖ ស្នងការដ្ឋាន នគរបាល ខេត្ត បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ និង រដ្ឋបាល ក្រុង ស្រុក ឃុំ សង្កាត់ ត្រូវ ធ្វើ ការណែនាំ ហាមឃាត់ និង ទប់ស្កាត់ ការជួបជុំ លក់ដូរ និង ការពិសារ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ ។
៥៖ គ្រប់ ទីតាំង អាហារដ្ឋាន ភោជនីយដ្ឋាន ផ្សារ ម៉ាត អាជីវករ អ្នកលក់ដូរ ចែកចាយ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ និង បងប្អូន ប្រជាពលរដ្ឋ ដែល មិន អនុវត្ត តាម ការណែនាំ ខាងលើ ត្រូវ អនុវត្ត វិធានការ រដ្ឋបាល និង វិធានការ ច្បាប់ ដោយ គ្មាន ការលើកលែង ឡើយ ៕
រដ្ឋបាល ស្រុក ខ្សាច់ កណ្ដាល នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ១៥ គ្រួសារ ដែល ជាប់ ចត្តាឡី ស័ក និង ប្រាប់ ឲ្យ ថែទាំ សុខភាព
( កណ្ដាល ) ៖ លោក ប៊ុន ផេង អភិបាល ស្រុក ខ្សាច់ កណ្ដាល ខេត្ដ កណ្ដាល នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ក្រុមការងារ នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ចំនួន ១៥ គ្រួសារ ដែល ជាប់ ចត្តាឡី ស័ក ពាក់ព័ន្ធ ដោយ ប្រយោល ជាមួយ អ្នកវិជ្ជមាន កូវីដ - ១៩ ។
ក្នុង ការនាំយក អំណោយ នេះ មាន ការចូលរួម ពី លោក អ៊ុ ចន ប្រធាន ក្រុមប្រឹក្សា ស្រុក . លោក ចាន់ តារា អភិបាល រង ស្រុក . លោក នាយក នាយក រង មន្ត្រីរាជការ រដ្ឋបាល ស្រុក និង កម្លាំង ប៉ុស្តិ៍ រដ្ឋបាល ព្រែក តា កូវ និង កម្លាំង ប្រជាការពារ ។
ក្នុង ឱកាស នោះ លោក ប៊ុន ផេង ក៏ បាន ណែនាំ បន្ថែម ថា បើ ទោះ គ្រួសារ បងប្អូន ទាំងអស់ បាន យក សំណាក ធ្វើតេស្ត ឃើញ អវិជ្ជមាន ហើយ ក្ដី ក៏ ត្រូវ បន្ត ធ្វើចត្តាឡី ស័ក ឲ្យ គ្រប់ ១៤ ថ្ងៃ នឹង ត្រូវ ថែទាំ សុខភាព កុំ ចេញ ក្រៅ ផ្ទះ របស់ ខ្លួន កុំ ប្រមូលផ្តុំ ពាក់ ម៉ាស លាង ដៃ ជាមួយ ជែល ឬ អាកុល ឲ្យ បាន ញឹកញាប់ និង រក្សា គម្លាត ។
នាយ ឧត្តមសេនីយ៍ អ៉ី ឈាន ចុះ ត្រួតពិនិត្យ គោលដៅ បិទ ការធ្វើដំណើរ ឆ្លង ខេត្ត តាម ក្រុង ស្រុក ដែល ជាប់ ព្រំប្រទល់ ខេត្ត បាត់ដំបង
ការ ចុះ ត្រួតពិនិត្យ នេះ ដើម្បី ពង្រឹង ការអនុវត្ត បទបញ្ជា របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ស្តីពី ការបិទ ការធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ជា បណ្តោះអាសន្ន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ម៉ោង សូន្យ ចូល ថ្ងៃទី ៧ រហូតដល់ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២១ ដើម្បី បង្ការ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ទៅដល់ សហគមន៍ ទ្រង់ទ្រាយ ធំ ។
ជាមួយគ្នា នេះ លោកស្រី បាន ស្រី មុំ បាន លើកឡើង ថា បន្ទាប់ពី ទទួលបាន សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល រដ្ឋបាល ខេត្ត ប៉ៃលិន បាន ប្រជុំ ដាក់ ផែនការណែនាំ ភ្លាម ៗ ក្នុង គោលបំណង ដើម្បី ប្រយុទ្ធ និង ទប់ស្កាត់ ការ ឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ពី ភូមិសាស្រ្ត នៃ ខេត្ត មួយ ទៅ ភូមិសាស្ត្រ នៃ ខេត្ត មួយ ទៀត និង ធ្វើ ការប្រជុំ ដាក់ ផែនការ ជា បន្តបន្ទាប់ ដើម្បី អនុវត្ត សេចក្តីសម្រេច នេះ ប្រកប ដោយ ប្រសិទ្ធភាព និង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
ចំពោះ ការបិទ ចរាចរណ៍ នេះ គឺ ត្រូវបាន អនុគ្រោះ លើ ការធ្វើចរាចរណ៍ ចំពោះ រថយន្ត ដឹក ទំនិញ រថយន្ត សង្គ្រោះ បន្ទាន់ រថយន្ត ពន្លត់ អគ្គីភ័យ រថយន្ត មន្ត្រីរាជការ សាធារណៈ ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ដែល ចុះ បំពេញ បេសកកម្ម ឬ មាន លិខិត បញ្ជាក់ ពី ប្រធាន អង្គភាព ឬ រថយន្ត អ្នកជំងឺ ដែល មាន លិខិត បញ្ជាក់ ពី មន្ទីរពេទ្យ ។
អភិបាល ខេត្ត ប៉ៃលិន បាន បន្ថែម ទៀត ថា សព្វ ថ្ងៃ នេះ ព្រឹត្តិការណ៍ « សហគមន៍ ២០កុម្ភៈ » នៃ ការឆ្លង ជំងឺ កូវីដ - ១៩ ចូល ទៅក្នុង សហគមន៍ នៅ មិន ទាន់ មាន ការធូរ ស្រាល នៅឡើយ ទេ ហើយ ថ្មី ៗ នេះ នៅក្នុង ភ្នំពេញ មាន ការឆ្លង រីករាល ដាល កាន់តែ ច្រើន ឡើង ថែម ទៀត ៕
សាលាដំបូង ខេត្ត ព្រះវិហារ នាំ អំណោយ មួយចំនួន ជូន អង្គភាព ពន្ធនាគារ ដើម្បី ទុក ផ្គត់ផ្គង់ ជូន អ្នកទោស
( ព្រះវិហារ ) ៖ លោក វុធ សាវី ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ ដែល ត្រូវនឹង ថ្ងៃទី ២ នៃ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ បាន ដឹកនាំ ក្រុមការងារ នាំយក អំណោយ រួម មាន សម្ភារ និង ថវិកា មួយ ចំនួន ប្រគល់ ជូន អង្គភាព ពន្ធនាគារ ខេត្ត សម្រាប់ ធ្វើ ការផ្គត់ផ្គង់ អ្នកទោស ដែល កំពុង ជាប់ ឃុំឃាំង ។
នៅក្នុង ឱកាស នោះ លោក វុធ សាវី ក៏ បាន ផ្តាំផ្ញើរ សាកសួរ សុខទុក្ខ ពី លោក ប្រធាន សាលាដំបូង ខេត្ត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ក៏ ដូចជា ថ្នាក់ដឹកនាំ ជាច្រើន រូប ទៀត នៃ សាលាដំបូង ខេត្ត ព្រះវិហារ ជូន ចំពោះ ថ្នាក់ដឹកនាំ និង មន្ត្រី ទាំងអស់ នៅក្នុង អង្គភាព ពន្ធនាគារ ខេត្ត ពិសេស នៅក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី នេះ ក្នុង នាម សាលាដំបូង ខេត្ត ព្រះវិហារ លោក ក៏ បាន ជូន ពរ ជ័យ ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ពន្ធនាគារ ខេត្ត ទាំងអស់ សូម មាន សុខភាព ល្អ និង ទទួលបាន ជោគជ័យ គ្រប់ ភារកិច្ច ។
លោក វុធ សាវី បាន កោតសរសើរ អង្គភាព ពន្ធនាគារ ខេត្ត ដែល គ្រប់គ្រង អ្នកទោស បាន យ៉ាង ល្អ ពិសេស ស្រប ពេល ដែល ជំងឺ កូវីដ១៩ កំពុង រាតត្បាត ឆ្លង ចូល សហគមន៍ ចាប់តាំងពី ថ្ងៃទី ២០ កុម្ភៈ មក អង្គភាព ពន្ធនាគារ ខេត្ត បាន យកចិត្ត ទុក្ខ ដាក់ ខ្ពស់ ដាក់ចេញ នូវ ការគ្រប់គ្រង ផ្សេង ក្នុង គោលបំណង មិន ឱ្យ មាន ការឆ្លង រីករាល ដាល នៃ ជំងឺ កូវីដ១៩ ដល់ អ្នកទោស ។
លោក ក៏ បាន ផ្តាំផ្ញើរ បន្ថែម ដល់ ប្រធាន អង្គភាព ពន្ធនាគារ ខេត្ត ត្រូវ បន្ត អនុវត្តន៍ តាម វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការណែនាំ របស់ រាជ រដ្ឋាភិបាល ( ៣កុំ និង ៣ការ ) ឱ្យ បាន ជាប់ ជាប្រចាំ ផងដែរ ។
អំណោយ ដែល អង្គភាព ពន្ធនាគារ ទទួលបាន រួម មាន៖ ម៉ាស់ ទឹកស៊ីអ៊ីវ ស្ករ អំបិល និង ថវិកា ចំនួន ១.៦០០.០០០ រៀល ៕
លោក ហ៊ុន ម៉ានី៖ « ជា មេដឹកនាំ ដែល តែង នៅ ជាប់ ជាមួយ ប្រជាជន សម្តេច តេជោ ពិតជា ជ្រាប ច្បាស់ នូវ អ្វី ដែល ប្រជាជន ចង់បាន និង អ្វី ដែល ប្រសើរ បំផុត សម្រាប់ ជាតិ និង ប្រជាជន »
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន គណៈកម្មការ ទី៧ នៃ រដ្ឋសភា និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន លើកឡើង ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា គឺជា មេដឹកនាំ មួយ ដែល តែង នៅ ជាប់ ជាមួយ ប្រជាជន ហើយ ពិតជា ជ្រាប ច្បាស់ នូវ អ្វី ដែល ប្រជាជន ចង់បាន និង អ្វី ដែល ប្រសើរ បំផុត សម្រាប់ ជាតិ និង ប្រជាជន ។
ការលើកឡើង របស់ លោក ហ៊ុន ម៉ានី បាន ធ្វើឡើង តាមរយៈ បណ្តាញ សង្គម Facebook នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ ស្រប ពេល ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ វិធានការបិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ខណៈ កម្ពុជា មាន ករណី ឆ្លង រាប់ រយ នាក់ ក្នុង ១ ថ្ងៃ ។
អ្នកតំណាងរាស្ត្រ វ័យ ក្មេង រូប នេះ បាន បញ្ជាក់ ថា នៅលើ ពិភពលោក នេះ ពុំ មាន ក្បួន តម្រា ឯណា ដែល អាច ប្រើ ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ ឆ្លង រាតត្បាត កូវីដ - ១៩ មាន ប្រសិទ្ធភាព ១០០% នោះ ឡើយ ។ ចំនួន អ្នក ឆ្លង និង អ្នកស្លាប់ នៅ តាម ប្រទេស នីមួយ ៗ គឺជា ការវាស់ស្ទង់ នូវ ការ ឆ្លើយតប និង គ្រប គ្រង ស្ថានការណ៍ របស់ រដ្ឋាភិបាល ប្រទេស នោះ ។
លោក ហ៊ុន ម៉ានី ក៏ បាន បន្ថែម ថា នៅ ចំពោះមុខ ការ មិន ធ្លាប់ ជួបប្រទះ វិបត្តិ ដូចគ្នា ក្នុង អតីតកាល យើង ពិតជា មាន សំណាង ដែល មាន មេដឹកនាំ ម្នាក់ និង សហការី ដែល ពោរពេញ ដោយ បទពិសោធន៍ ក្នុង ការដឹកនាំ និង ប្រយុទ្ធ នឹង វិបត្តិ កូវីដ - ១៩ នេះ ។ ជា មេដឹកនាំ មួយ ដែល តែង នៅ ជាប់ ជាមួយ ប្រជាជន គាត់ ពិតជា ជ្រាប ច្បាស់ នូវ អ្វី ដែល ប្រជាជន ចង់បាន និង អ្វី ដែល ប្រសើរ បំផុត សម្រាប់ ជាតិ និង ប្រជាជន ។
លោក ហ៊ុន ម៉ានី ក៏ បាន គូសបញ្ជាក់ បន្ថែម ថា៖ « គាត់ គឺជា មេដឹកនាំ ដែល យើង តែង ផ្តល់ ទំនុកចិត្ត លើ គាត់ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ហើយ ដែល យើង អាច ជឿជាក់ បាន ថា គាត់ គ្មាន ហេតុផល ណាមួយ នឹង ទៅ ចោល យើង ដាច់ខាត ទោះជា ក្នុង ពេល ដ៏ លំបាក យ៉ាងណា ក្តី »៕
បទ អត្ថាធិប្បាយ៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី សិទ្ធិ មនុស្ស របស់ អាមេរិក មាន ភាពពិការ ភ្នែក ពណ៌
( ប៉េកាំង ) ៖ បើ លោកអ្នក ស្វែងរក តាម បណ្តាញ អ៊ីនធើណេត នូវ « សេចក្តីព្រាង ច្បាប់ ស្តីពី សិទ្ធិ » របស់ អាមេរិក អាច ឃើញ ពាក្យបកស្រាយ ដូច ពោល ខាងក្រោម៖ « សេចក្តីព្រាង ច្បាប់ ស្តីពី សិទិ្ធ » ក៏ អាច បកប្រែ ជា « សេចក្តីព្រាង ច្បាប់ ស្តីពី សិទ្ធិ មនុស្ស » ផងដែរ ។ « សេចក្តីព្រាង ច្បាប់ ស្តីពី សិទ្ធិ មនុស្ស » មាន គោលបំណង រឹតត្បិត អំណាច របស់ រដ្ឋាភិបាល និង ការពារ សិទ្ធិ របស់ ប្រជាពលរដ្ឋ ក្នុង នោះ បាន ធានា សេរីភាព របស់ បុគ្គល លើ វិស័យ ជាច្រើន ។
គំនូរ កំប្លែង មួយ ផ្ទាំង បាន បង្ហាញ ថា « ពូTom» ដៃ ម្ខាង កាន់ « សេចក្តីប្រកាស ឯករាជ្យ » ហើយ ដៃ ម្ខាង កាន់ខ្ជាប់ នូវ ខ្សែ ដែក សម្រាប់ ខ្នោះ មនុស្ស ស្បែក ខ្មៅ ។ ក្នុង ប្រវតិ្តសាស្ត្រ ការគាបសង្កត់ និង រើសអើង មនុស្ស ស្បែក ខ្មៅ ជា ស្នាម ប្រឡាក់ និង ដំបៅ មហារីក របស់ លោក ខាងលិច ដែល ពិបាក នឹង ទាត់ចោល បាន ។ ជាពិសេស គឺ នៅ អាមេរិក ទំនាស់ រវាង ពូជសាសន៍ មាន ភាព កាន់តែ មុត ស្រួច គឺជា មូលហេតុ សំខាន់ មួយ ដែល បណ្តាល ឱ្យ សង្គម អាមេរិក មាន ភាពវឹកវរ ជាញឹកញាប់ ។
នា ពេល ថ្មី ៗ កន្លងទៅ នេះ សំណុំរឿង វាយប្រហារ និង ប្រមាថ ដែល សំដៅ ចំពោះ ជនជាតិ អាមេរិក ដើមកំណើត អាស៊ី បណ្តាលឱ្យ ប្រជាជនជាច្រើន ដង្ហែ ក្បូន ធ្វើ បាតុកម្ម ។ នៅ អាមេរិក ក្នុង ចំណោម អនីតិជន មាន អាយុ ក្រោម ១៨ ឆ្នាំ មនុស្ស មិន មែន ស្បែក សមាន ចំនួន ប្រហែល១ ភាគ៣ ប៉ុន្តែ ក្នុង ពន្ធ ធនាគារ អនីតិជន មិន មែន ស្បែក សមាន ចំនួន ២ភាគ ៣។ ជនជាតិ អាមេរិក ដើមកំណើត អាហ្រ្វិក មាន ចំនួន មិន ដល់ ១៣ភាគរយ នៃ ចំនួន ប្រជាជន សរុប អាមេរិក ប៉ុន្តែ អត្រា ត្រូវ ប៉ូលិស បាញ់ ស្លាប់ គឺ ២៨ ភាគរយ ។
រំលឹក ឡើងវិញ ពី ប្រវតិ្តសាស្ត្រ អាមេរិក អាច មើលឃើញ ដោយ ងាយស្រួល ថា ចាប់ពី ដាក់ ចេញ « សេចក្តីប្រកាស រំដោះ » នា ឆ្នាំ ១៨៦៣ រហូតដល់ លោក អូបាម៉ា ត្រូវ ជ្រើសតាំង ជា ប្រធានាធិបតី នា ឆ្នាំ ២០០៨ បើ មើល ពី សំបក ក្រៅ តួនាទី របស់ មនុស្ស ស្បែក ខ្មៅ ត្រូវបាន លើកកម្ពស់ ជា បណ្តើរ ៗ ។ ប៉ុន្តែ តាមពិត ទៅ ការរើសអើង ពូជសាសន៍ មិន ដែល រលាយ សាបសូន្យ នៅ អាមេរិក ទាល់តែសោះ ។
បើ តាម សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត កណ្តាល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ឱ្យដឹង ថា មន្ត្រី នគរបាល យុត្តិធម៌ មាន សមត្ថកិច្ច ត្រូវ ចេញ បង្កាន់ដៃ ពិន័យ អន្តរការណ៍ ជូន បុគ្គល ដែល មិន គោរព វិធាន រដ្ឋបាល ដើម្បី បង្គាប់ឱ្យ បុគ្គល នោះ បង់ប្រាក់ ពិន័យ អន្តរការណ៍ ទៅ តាម កំហុស ដែល ខ្លួន បាន ប្រព្រឹត្ត ក្នុង រយៈពេល ៣០ ថ្ងៃ គិត ចាប់ពី ថ្ងៃ បាន ទទួល បង្កាន់ដៃ ពិន័យ អន្តរការណ៍ ។
បន្ថែម ពី នេះ ក្នុង ករណី ទទួល ប្រាក់ ពិន័យ អន្តរការណ៍ ដោយ ផ្ទាល់ ជា សាច់ប្រាក់ ឬ ជា មូល ប្បទាន បត្រ ត្រូវ ប្រើប្រាស់ បង្កាន់ដៃ បង់ប្រាក់ ដែល បោះពុម្ភ និង បើក ផ្តល់ ដោយ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
ការចេញ បង្កាន់ដៃ ពិន័យ អន្តរការណ៍ ត្រូវ ធ្វើឡើង ចំនួន ៣ច្បាប់ ដោយ មួយ ច្បាប់ សម្រាប់ ប្រគល់ ជូន បុគ្គល ដែល មិន គោរព វិធានការ រដ្ឋបាល និង ២ច្បាប់ ទៀត សម្រាប់ រក្សាទុក ជា ឯកសារ ៕
លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ប្រកាស ជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ ថា គ្រប់ ហាង លក់ ទំនិញ និង ម្ហូប អាហារ ទាំងអស់ នៅ ទូទាំង រាជធានី ភ្នំពេញ ត្រូវបាន អនុញ្ញាតឲ្យ បើក ដំណើរការ ដូច ធម្មតា ប្រជាពលរដ្ឋ អាច ធ្វើដំណើរ ទៅ ទិញ នៅ ទីតាំង ដែល ក្បែរ ផ្ទះ របស់ ខ្លួន ឬ កម្មង់ ទិញ តាម អនឡាញ ។
ការចេញមក ប្រកាស ជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ របស់ លោក ឃួង ស្រេង ធ្វើឡើង បន្ទាប់ពី រាជ រដ្ឋាភិបាល បាន ចេញ សេចក្ដីសម្រេច បិទ ខ្ទប់ (LockDown) រាជធានី ភ្នំពេញ រយៈពេល ១៤ ថ្ងៃ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ហើយ មិន តម្រូវឲ្យ ប្រជាពលរដ្ឋ ចេញ ក្រៅ ផ្ទះ ជាដាច់ខាត បើ គ្មាន ករណី ចាំបាច់ លើកលែង ទិញ ម្ហូប អាហារ ប៉ុណ្ណោះ ៕
ផ្សារក សិផល ធម្មជាតិ ឡេង ណា វ៉ា ត្រា គ្រប់ សាខា បន្ដ បើក លក់ ទំនិញ ដូច ធម្មតា ដោយ មិន មាន ការដំឡើង ថ្លៃ ឡើយ
បងប្អូន ប្រជាពលរដ្ឋ អាច អញ្ជើញ ទៅ ទិញ នៅ ទីតាំង ផ្ទាល់ នៅ គ្រប់ សាខា ក៏ បាន ឬ តាម លេខ ទូរស័ព្ទ ០១១ ៤៤៤ ៤៤៤ ភ្នាក់ងារ ផ្សារ នឹង ដឹក ទំនិញ ដែល លោក អ្នក កុម្មង់ ជូន ដល់ ផ្ទះ ។
ការប្រកាស របស់ លោក ឃួង ស្រេង ធ្វើឡើង បន្ទាប់ពី រាជ រដ្ឋាភិបាល បាន ចេញ សេចក្ដីសម្រេច បិទ ខ្ទប់ (LockDown) រាជធានី ភ្នំពេញ រយៈពេល ១៤ ថ្ងៃ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ហើយ មិន តម្រូវឲ្យ ប្រជាពលរដ្ឋ ចេញ ក្រៅ ផ្ទះ ជាដាច់ខាត បើ គ្មាន ករណី ចាំបាច់ លើកលែង ទិញ ម្ហូប អាហារ ប៉ុណ្ណោះ ៕
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន ផ្លូវការ Fresh News នៅ ព្រឹក ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ប្រកាស ជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ ថា គ្រប់ ហាង លក់ ទំនិញ និង ម្ហូប អាហារ ទាំងអស់ នៅ ទូទាំង រាជធានី ភ្នំពេញ ត្រូវបាន អនុញ្ញាតឲ្យ បើក ដំណើរការ ដូច ធម្មតា ប្រជាពលរដ្ឋ អាច ធ្វើដំណើរ ទៅ ទិញ នៅ ទីតាំង ដែល ក្បែរ ៗ ផ្ទះ របស់ ខ្លួន ឬ កម្មង់ ទិញ តាម អនឡាញ ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ វេលា ម៉ោង ជាង ១រសៀល ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បន្ដ ប្រកាស រក អ្នកជំងឺ កូវីដ១៩ ចំនួន ៦នាក់ ទៀត ដែល កំពុង បាត់ខ្លួន ។ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ព្រមាន ថា បើ អ្នកជំងឺ ទាំង ១០នាក់ នេះ មិន បង្ហាញ ខ្លួន ទៀត នឹង កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ចាត់ការ តាម ច្បាប់ ។
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន តាមរយៈ Facebook ផ្លូវការ របស់ ក្រសួង បាន ប្រកាស ផ្អាក ដំណើរ ការជា បណ្តោះអាសន្ន មណ្ឌល ផ្តល់ សេវា សាធារណៈ របស់ ក្រសួង នៅ ផ្សារ ទំនើប ជីប ម៉ុង ណូរ៉ូមល និង នៅ ផ្សារ ទំនើប អ៉ី អន ម៉ល ទី១ និង អ៉ី អន ម៉ល ទី២ រយៈពេល ២សប្តាហ៍ គិត ចាប់ពី ថ្ងៃទី ១៥ ខែមេសា ដល់ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ ។
លោក គឹម សន្តិភាព បាន ពន្យល់ ដែរ ថា ការបិទ ខ្ទប់ គឺជា វិធានការ រដ្ឋបាល មួយ តឹងរ៉ឹង ដែល តម្រូវឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ នៅ ផ្ទះ រៀង ៗ ខ្លួន . ផ្អាក ការធ្វើដំណើរ . ផ្អាក រាល់ ការជួបជុំ . ហើយ ក្រុមហ៊ុន ឬ សហគ្រាស ត្រូវ ផ្អាក ដំណើរការ ជា បណ្តោះអាសន្ន ក្នុង រយៈពេល បិទ ខ្ទប់ ១៤ ថ្ងៃ នេះ ។ ការធ្វើដំណើរ អាច ធ្វើ ទៅ បាន តែ ក្នុង ករណី ចាំបាច់ និង បន្ទាន់ មួយចំនួន ប៉ុណ្ណោះ ដូចជា ការចេញ ទៅ ទិញ ម្ហូប អាហារ កីឡា ឬ ទៅ ពេទ្យ ជាដើម ។
ការជួបជុំ អាច ធ្វើ ទៅ បាន តែ ក្នុង ករណី ចាំបាច់ បំផុត ដូចជា បុណ្យ សព ឬ សកម្មភាព បម្រើ ឲ្យ សុខុមាលភាព សាធារណៈ និង ប្រយោជន៍ សង្គម ។ រីឯ ការជួបជុំ ក្នុង ចំណោម គ្រួសារ ដែល រស់ នៅ ជាមួយគ្នា ក្នុង បរិវេណ ផ្ទះ របស់ ខ្លួន ក៏ ត្រូវបាន អនុញ្ញាត ផងដែរ ។
រាល់ ក្រុមហ៊ុន ឬ សហគ្រាស ដែល ជា តម្រូវ ការចាំបាច់ សម្រាប់ ការរស់នៅ ប្រចាំ ថ្ងៃ របស់ ប្រជាជន ទូទៅ អាច នៅ ដំណើរការបាន ដូចជា ហាង ទំនិញ ផ្សារ លក់ ម្ហូប អាហារ រោងចក្រ ឬ សិប្បកម្ម ផលិត ម្ហូប អាហារ មន្ទីរពេទ្យ ឬ ក្លីនិក ឯកជន . ធនាគារ ជាដើម ។
សហគ្រាស ឬ ក្រុមហ៊ុន ដែល មិន មែន ជា តម្រូវការខាន មិន បាន របស់ ប្រជាពលរដ្ឋ ទូទៅ ត្រូវ ផ្អាក សកម្មភាព ទាំងអស់ ។ ប៉ុន្តែ ស្ថាប័ន សាធារណៈ ដែល ផ្តល់ សេវា សាធារណៈ ដល់ ប្រជាពលរដ្ឋ នៅ បន្ត ដំណើរការ ដដែល ។
រាល់ ស្ថាប័ន សាធារណៈ និង ឯកជន ដែល ត្រូវបាន អនុញ្ញាតឲ្យ បន្ត ដំណើរការ ត្រូវ កាត់បន្ថយ ចំនួន បុគ្គលិក មក បម្រើ ការ ឲ្យ មក នៅ តិច បំផុត ហើយ ត្រូវ អនុវត្ត នូវ រាល់ វិធានការ សុខាភិបាល ដូចជា ការពាក់ ម៉ាស ការរក្សា គម្លាត សុវត្ថិភាព និង ការលាង សម្អាត ដៃ ជាដើម ។
អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ សង្កត់ធ្ងន់ ៗ ថា៖ « បុគ្គល គ្រប់ រូប មាន កាតព្វកិច្ច ត្រូវ ពាក់ ម៉ាស និង រក្សា គម្លាត សុវត្ថិភាព នៅក្នុង ភូមិសាស្រ្ត ដែល ត្រូវបាន បិទ ខ្ទប់ ។ ការបំពាន វិធានការបិទ ខ្ទប់ នេះ ដោយ ការ មិន គោរព ឬ រារាំង នឹង ត្រូវ ទទួល ទោស ដែល ត្រូវបាន កំណត់ ដោយ ច្បាប់ » ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង យុត្តិធម៌ ថែមទាំង បាន បង្ហាញ ទោសទណ្ឌ ដែល មាន ចែង ក្នុង ច្បាប់ ស្តីពី វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ជំងឺ ឆ្លងកាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ដូច ខាងក្រោម៖
ជាមួយគ្នា នេះ អភិបាល រាជធានី ភ្នំពេញ ក៏ បាន លើកទឹកចិត្ត ដល់ ម្ចាស់ ហាង លក់ ម្ហូប អាហារ ទាំងអស់ បន្ត ការលក់ដូរ ជូន ប្រជាពលរដ្ឋ ជាធម្មតា ហើយ ប្រជាពលរដ្ឋ ក៏ អាច កម្មង់ ទិញ តាម អនឡាញ ផងដែរ ។
ការចេញមក ប្រកាស ជូនដំណឹង និង លើកទឹកចិត្ត ខាងលើ នេះ របស់ លោក ឃួង ស្រេង ធ្វើឡើង បន្ទាប់ពី រាជ រដ្ឋាភិបាល បាន ចេញ សេចក្ដីសម្រេច បិទ ខ្ទប់ (LockDown) រាជធានី ភ្នំពេញ រយៈពេល ១៤ ថ្ងៃ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ហើយ មិន តម្រូវឲ្យ ប្រជាពលរដ្ឋ ចេញ ក្រៅ ផ្ទះ ជាដាច់ខាត បើ គ្មាន ករណី ចាំបាច់ លើកលែង ទិញ ម្ហូប អាហារ ប៉ុណ្ណោះ ។
