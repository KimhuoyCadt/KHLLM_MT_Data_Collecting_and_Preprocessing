( កំពង់ឆ្នាំង ) ៖ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង បាន ចេញ សាឡាង ដឹក រថយន្ត ពេទ្យ ចំនួន ០២ គ្រឿង ទៅកាន់ ស្រុក កំពង់លែង និង រថយន្ត មន្ត្រី ពេទ្យ ផ្សេង ទៀត នៅ កំពង់ផែ ថ្មី ផ្សារ ក្រោម ចុង កោះ ដើម្បី ត្រៀម រង់ចាំ ដឹកជញ្ជូន ប្រជាពលរដ្ឋ មាន ចំនួន ជិត ៤០ នាក់ ដែល បាន ល្មើស នឹង បំរាម របស់ អាជ្ញាធរ ខេត្ត ដោយ មិន អនុញ្ញាតឲ្យ អ្នក ដែល នៅ រាជធានី ភ្នំពេញ ឬ អ្នក នៅ ក្រៅ ខេត្ត ធ្វើដំណើរ ចូលមក ទឹកដី ខេត្ត កំពង់ឆ្នាំង នោះ ឡើយ ។
កាលពី ថ្ងៃទី៥ ខែមេសា ឆ្នាំ ២០២១ រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង ប្រកាស ថា អ្នក ដែល នៅ រាជធានី ភ្នំពេញ ឬ អ្នក នៅ ក្រៅ ខេត្ត ធ្វើដំណើរ ចូលមក ទឹកដី ខេត្ត កំពង់ឆ្នាំង អាជ្ញាធរ ខេត្ត នឹង បញ្ជា ឱ្យ អាជ្ញាធរ មូលដ្ឋាន ចាប់ យក ទៅ ធ្វើចត្តាឡី ស័ក ចំនួន ១៤ ថ្ងៃ រួមទាំង ធ្វើ ការពិនិត្យ សំណាក ជា ចាំបាច់ ។
លោក ងិន ចាន់ សារ៉េត ជា អ្នកដឹកនាំ ក្រុមការងារ ឆ្លើយតប បន្ទាន់ នៃ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា បន្ទាប់ពី ទទួលបាន បទ បញ្ជា ពី ថ្នាក់ដឹកនាំ ក្នុង ខេត្ត លោក ក៏ បាន ដឹកនាំ ក្រុមការងារ ឆ្លើយតប បន្ទាន់ ចុះ ទៅ ស្រុក កំពង់លែង ដើម្បី ប្រមូល ប្រជាពលរដ្ឋ ទាំងនោះ ទៅ ដាក់ នៅ មណ្ឌល ចត្តាឡី ស័ក ស្រុក ទឹក ផុស ក្នុង វេលា យប់ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២១ នេះ និង យក សំណាក ពួកគាត់ ទាំងអស់ គ្នា ទៅ ពិនិត្យ ផងដែរ ។
( ភ្នំពេញ ) ៖ ឧបាសិកា នាង ហួន អ្នកម្តាយ លោកជំទាវ ទ្រី សុខា និង កូន បង្កើត ទាំង ៣នាក់ រួម មាន៖ លោក អ៊ុក សំរិទ្ធិ ពេជ្រ និង លោកស្រី សាម សុភា. លោក ដែន និមល និង លោកស្រី សាម សុផា. លោក សាម សុឌីម៉ង់ និង លោកស្រី សួន វល័ក្ខ ម្ចាស់ ហាង បង្អែម រំដួល ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឧបាសិកា នាង ហួន និង កូន ៗ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឧបាសិកា នាង ហួន ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក អេង ផា និង លោកស្រី សុខ លាង កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
របាយការណ៍ បាន បង្ហាញ រយៈពេល ៨ ថ្ងៃ កន្លងទៅ នេះ អ្នកស្ម័គ្រចិត្ត មក ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ មាន ចំនួន ៣៣៣. ៦៥៣ នាក់ ក្នុង នោះ អ្នកអនុញ្ញាតឱ្យ ចាក់ មាន ចំនួន ៣១៨. ៤៦៧ នាក់ និង អ្នក មិន អនុញ្ញាតឱ្យ ចាក់ មាន ចំនួន ១៥. ៨២៦ នាក់ ។
របាយការណ៍ របស់ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ផងដែរ ថា ការចាក់ វ៉ាក់សាំង ទាំង៣ ប្រភេទ ( ស៊ីណូ ហ្វាម អាស្ត្រា ហ្សេនីកា និង ស៊ីណូ វ៉ាក់ ) ចាក់ បាន ជាង ៦១ ម៉ឺន នាក់ ហើយ ។
ការដាក់ ឱ្យ ដំណើរការសាឡាង ទាំង ពីរ គ្រឿង នេះ ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ។ ជាពិសេស ជួយ រំដោះ ការកកស្ទះ ចរាចរណ៍ នៅលើ ស្ពាន ព្រះមុនីវង្ស ដែល កំពង ដំណើរការ ជួសជុល ផង នោះ ។
យោង តាម ទិន្នន័យ របស់ មជ្ឈមណ្ឌល ប្រយុទ្ធ ប្រឆាំង ជំងឺ ឆ្លង អាមេរិក (CDC) វ៉ាក់សាំង ប្រមាណ ជា ១៦៩ លាន ដូស ហើយ ត្រូវបាន ចាក់ នៅក្នុង សហរដ្ឋ អាមេរិក ក្នុង ចំណោម វ៉ាក់សាំង ជាង ២១៩ លាន ដូស ដែល ត្រូវបាន ចែកចាយ រួចរាល់ នៅ ទូទាំង ប្រទេស ។ បើ តាម លោក បៃ ដិន វ៉ាក់សាំង ១៥០ លាន ដូស ត្រូវបាន ចាក់ ក្នុង រយៈពេល ៧៥ ថ្ងៃ ដំបូង នៃ ការឡើង កាន់អំណាច របស់ លោក ដែល នឹង ឈានទៅ សម្រេចបាន គោលដៅ នៃ ការចាក់ ឲ្យ គ្រប់ ២០០ លាន ដូស មិន ឲ្យ លើស ពី ១០០ ថ្ងៃ ដំបូន នៃ អាណត្តិ របស់ លោក ៕
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារ ជូនពរ ជូន ជន រួម ជាតិ ដើម្បី អបអរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ពុទ្ធ សករាជ ២៥៦៥
ក្នុង សារ ជូនពរ របស់ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ក៏ បាន លើកឡើង ថា ក្នុង ឱកាស មហាសង្ក្រាន្ត ទាំង បី ថៃ្ង នេះ ប្រជាពលរដ្ឋ យើង រៀបចំ រណ្តាប់ គ្រឿង សក្ការ បូជា អុជ ប្រទីប ជ្វាលា ថ្វាយ ព្រះរតន ត្រៃ និង ទទួលស្វាគមន៍ ទេវតា ឆ្នាំ ថ្មី ។ ពិធី ទាំង នេះ ជា ឱកាស ឱ្យ ប្រជាពលរដ្ឋ យើង រួមគ្នា ជម្រុះ ចោល ឱ្យ ជរះ ស្រឡះ នូវ ភាពអពមង្គល ឧបទ្រព ចង្រៃ និង មន្ទិល ហ្មង សៅ ទាំងពួង ក្នុង ឆ្នាំ ចាស់ ហើយ តាំងចិត្ត ថ្មី ប្រព្រឹត្ត អំពើ ល្អ ប្រកបដោយ មេត្តា ក រុណា មុទិតា ឧបេក្ខា និង បញ្ញា នៅក្នុង ឆ្នាំ ថ្មី នេះ ។
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន បញ្ជាក់ ថា នៅក្នុង ដំណាក់កាល ដ៏ លំបាក នៃ ការឆ្លង រាតត្បាត ជា សាកល នៃ ជំងឺ កូវីដ - ១៩ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដ៏ ឆ្នើម បាន ខិតខំ បំពេញ តួនាទី ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ បំផុត និង បាន ធ្វើឱ្យ កម្ពុជា រក្សា បាន ស្ថិរភាព នយោបាយ ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច សុខ សន្តិភាព សុវត្ថិភាព សុខុមាលភាព ប្រជាជន ការអភិវឌ្ឍ ហើយ ដែល ប្រជាពលរដ្ឋ ទាំងមូល សុទ្ធតែ ទទួលបាន គុណ ប្រយោជន៍ ដោយ សមធម៌ និង តម្លាភាព ។
ក្នុង សារ ជូនពរ របស់ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន បន្ថែម ថា ក្រោម ម្លប់ ដ៏ ត្រជាក់ ត្រជំ នៃ ព្រះករុណា ព្រះបាទ សមេ្តច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ក្រោម ដំបូល នៃ រដ្ឋធម្មនុញ្ញ និង លើ មូលដ្ឋាន នៃ មហាសាមគ្គី ឯកភាព ជាតិ រឹងមាំ ដំណើរ ទៅ មុខ របស់ ជាតិ យើង ប្រព្រឹត្តទៅ ដោយ រលូន និង មាន ជោគជ័យ ជា បន្តបន្ទាប់ ។
ខាងក្រោម នេះ ជា សារលិខិត ជូន ពរ របស់ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ៖
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ទូល ថ្វាយ សារ លិខិត ថ្វាយ ព្រះរាជ សព្ទ សាធុការ ពរ ព្រះករុណា ព្រះមហាក្សត្រ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស . ២៥៦៥
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២១ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ទូល ថ្វាយ សារ លិខិត ថ្វាយ ព្រះរាជ សព្ទ សាធុការ ពរ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ក្នុង ឱកាស ដ៏ មហា មង្គល សួស្តី ប្រពៃ ថ្លៃថ្លា ប្រកបដោយ មហាន ក្ខត្ត ឫក្ស នៃ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស .២៥៦៥ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង នៃ សារលិខិត របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ទូល ថ្វាយ ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា៖ រកឃើញ អ្នកវិជ្ជមាន កូវីដ១៩ ចំនួន ៣នាក់ ទៀត នៅក្នុង ខណ្ឌ ឬស្សីកែវ
( ភ្នំពេញ ) ៖ មនុស្ស ចំនួន ៣នាក់ ទៀត ត្រូវបាន រកឃើញ វិជ្ជមាន កូវីដ១៩ នៅក្នុង មូលដ្ឋាន ខណ្ឌ ឬស្សីកែវ នា យប់ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២១ ហើយ ត្រូវបាន រថយន្ត សង្គ្រោះ បន្ទាន់ បាន មក ដឹក ពួកគាត់ ទៅ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ហើយ ។
លោក ជា ពិសី អភិបាល ខណ្ឌ ឬស្សីកែវ បាន ជូន ដំណឹង ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង ខណ្ឌ ប្ញស្សីកែវ ថា នៅ យប់ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ២២៖៣០ នាទី អាជ្ញាធរ នៃ រដ្ឋបាល ខណ្ឌ ប្ញស្សីកែវ និង ក្រុម គ្រូពេទ្យ បាន ស្វែងរកឃើញ អ្នកវិជ្ជមាន នឹង មេរោគ កូវីដ១៩ ចំនួន ០៣ នាក់ រួម មាន៖
លោក ជា ពិសី បាន ផ្ញើ សារ ក្រើន រម្លឹក ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា បង្កើន ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ ដើម្បី ចូលរួម ទប់ស្កាត់ ការរីករាលដាល ជម្ងឺ កូវីដ១៩ នៅក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ៕ លោក ឧកញ៉ា ឌី ជោត និង លោកជំទាវ លាង ធារ៉ា ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា ឌី ជោត និង លោកជំទាវ លាង ធារ៉ា ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោក ឧកញ៉ា ឌី ជោត និង លោកជំទាវ លាង ធារ៉ា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក ឧកញ៉ា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក សៀ សុផល និង លោកស្រី ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អាជ្ញាធរ រាជធានី ភ្នំពេញ អនុវត្ត បម្រាម គោចរ ឃាត់ រថយន្ត បាន ចំនួន ៩ គ្រឿង ទៀត នៅ យប់ មិញ
( ភ្នំពេញ ) ៖ ឯកឧត្តម គង់ អៀង និង លោកជំទាវ ហួត សុម៉ាលី ឧបត្ថម្ភ ថវិកា ២០ លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឯកឧត្តម គង់ អៀង និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ក្រុមប្រឹក្សាភិបាល គណៈ គ្រប់គ្រង ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ សាស្រ្តាចារ្យ សិស្ស មន្ត្រី ជាន់ ខ្ពស់ ជំនាន់ ទី ១១ និង សិស្ស មន្ត្រី ក្រមការជំនាន់ ទី៩ និង កម្មសិក្សា ការី ទាំងអស់ នៃ សាលា ភូមិន្ទ រដ្ឋបាល ឧបត្ថម្ភ ថវិកា ៨លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
សាលា ភូមិន្ទ រដ្ឋបាល កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សរុប ការចាក់ វ៉ាក់សាំង កូវីដ ទូទាំង ប្រទេស ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ បាន ចំនួន ជាង ៨១ម៉ឺន នាក់ ហើយ ( គិត ត្រឹម យប់ ថ្ងៃទី ០៨ មេសា )
