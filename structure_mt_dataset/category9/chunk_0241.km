( ភ្នំពេញ ) ៖ លោក ហេង ហាំង ម៉េង តំណាង ក្រុមហ៊ុន ឌី អេហ្វ អាយ ឡាក់ គី ប្រាយ វេត លីមីធីត និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ២ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
លោក ហេង ហាំង ម៉េង និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឧកញ៉ា និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឧកញ៉ា ហាន់ ឃាង និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៣ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឧកញ៉ា ហាន់ ឃាង តំណាង ក្រុមហ៊ុន ម៉ូហ៊ឺ បា ម៉ាសូអន កម្ពុជា និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៣ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឧកញ៉ា ថៃ ជា ហួត ប្រធាន ក្រុមប្រឹក្សាភិបាល ក្រុមហ៊ុន ប៉េង ហួត គ្រុប និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ២០ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឧកញ៉ា ថៃ ជា ហួត ប្រធាន ក្រុមប្រឹក្សាភិបាល ក្រុមហ៊ុន ប៉េង ហួត គ្រុប និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ២០ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឧកញ៉ា ថៃ ជា ហួត និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឧកញ៉ា ថៃ ជា ហួត ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រសួង បាន បញ្ជាក់ ថា នៅ រយៈពេល នេះ តំបន់ មួយចំនួន នឹង មាន ភ្លៀង ធ្លាក់ ពី ខ្សោយ ទៅ ច្រើន និង សូមឲ្យ ប្រជាពលរដ្ឋ បន្ត ប្រុងប្រយ័ត្ន នឹង បាតុភូត ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ៕
( ភ្នំពេញ ) ៖ សន្តិសុខ យាម នៅ ខាងមុខ ធនាគារ ABA ក្បែរ ស្ពាន អាកាស ផ្សារ ដី ហ៊ុយ បាន ដក កាំភ្លើង ខ្លី របស់ ខ្លួន បាញ់ សម្លាប់ បុរស ម្នាក់ ស្លាប់ ភ្លាម ៗ នៅនឹង កន្លែង នេះ យោង តាម កាមេរ៉ា សុវត្ថិភាព បង្ហាញ ពី សកម្មភាព យ៉ាង ជាក់ស្តែង ។
កាមេរ៉ា សុវត្ថិភាព បាន បង្ហាញ សកម្មភាព ជាក់ស្តែង ថា បុរស ជនរងគ្រោះ បាន ដើរ សំដៅ ចង្អុល មុខ ទៅ រក សន្តិសុខ កំពុង យាម នៅ ខាងមុខ ធនាគារ ABA ដោយ មាន កាន់ កាំបិត ជាមួយ ផង ប្រុង នឹង ចាក់ ទៅ លើ សន្តិសុខ ក៏ប៉ុន្តែ ត្រូវបាន សន្តិសុខ ដក កាំភ្លើង ខ្លី បាញ់ គំរាម តែ ជនរងគ្រោះ នៅតែ រង់ បំណង ចាក់ សន្តិសុខ ទើប សន្តិសុខ បាញ់ សម្លាប់ នៅនឹង កន្លែង តែម្តង ។
ហេតុការណ៍ កើតឡើង នៅ វេលា ម៉ោង ៨៖ ៥៧ នាទី យប់ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ ស្ថិត នៅក្បែរ ស្ពាន អាកាស ផ្សារ ដី ហ៊ុយ ស្ថិត ក្នុង សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
ប្រជាពលរដ្ឋ នៅជិត កន្លែង កើត ហេតុ បាន ឲ្យដឹង ថា ដោយសារ មាន ទំនាស់ គ្នា នៃ ក្រុម ក្មេង ស្ទាវ បាន វាយ គ្នា នៅ ខាងមុខ ធនាគារ ABA ទើប សន្តិសុខ ជា អ្នកយាម ហាមឃាត់ ក្រុម ជន ទំនើង ទាំងនោះ តែ ពួកគេ នៅតែ មិន ស្តាប់ ថែមទាំង ខឹងសម្បារ សន្តិសុខ រហូត រត់ ទៅ យក កាំបិត ចង់ ចាក់ សន្តិសុខ ទើប បណ្តាលឱ្យ សន្តិសុខ ដក កាំភ្លើង បាញ់ ជនរងគ្រោះ តែម្តង ៕ ក្រសួង សុខាភិបាល៖ ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ នៅ ទូទាំង ប្រទេស កើន ដល់ ចំនួន ៥១២. ៣៣៤ នាក់ គិត ត្រឹម ថ្ងៃទី ០៦ ខែមេសា
ខាងក្រោម តារាង ព័ត៌មាន លម្អិត នៃ ការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ របស់ ក្រសួង សុខាភិបាល៖
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ នៅ យប់ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បន្ដ ចុះ ពិនិត្យ ការអនុវត្ត បំរាម គោចរ កំណត់ មិន ឲ្យ ធ្វើដំណើរ ចាប់ពី ម៉ោង ៨យប់ ដល់ ម៉ោង ៥ភ្លឺ ក្នុង ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ រយៈពេល ១៤ ថ្ងៃ ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ។
បំរាម គោចរ ត្រូវបាន ដាក់ចេញ ដោយ រដ្ឋបាល រាជធានី ភ្នំពេញ រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២១ត ទៅ ដែល ជា វិធានការ រដ្ឋបាល ថ្មី មួយ ដើម្បី ទប់ស្កាត់ និង បង្ការ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ។
សម្រាប់ អ្នក ដែល មិន គោរព តាម បំរាម គោចរ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ដាក់ បទបញ្ជា យ៉ាង ម៉ឺងម៉ាត់ ដល់ កងកម្លាំងប្រដាប់អាវុធ អាជ្ញាធរ និង សមត្ថកិច្ច ពាក់ព័ន្ធ ត្រូវ ដកហូត មធ្យោបាយ ធ្វើដំណើរ ។
បន្ទាប់ ដកហូត មធ្យោបាយ ហើយ នោះ ម្ចាស់ ត្រូវ បញ្ជូន ទៅ ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ នៅក្នុង ផ្ទះ រៀង ៗ ខ្លូន ។ នៅពេល ធ្វើចត្តាឡី ស័ក អាជ្ញាធរ មូលដ្ឋាន ត្រូវ តាមដាន ត្រួតពិនិត្យ ឲ្យបាន ត្រឹមត្រូវ ក្នុង ករណី ការអនុវត្ត មិន ត្រឹមត្រូវ តាម ការណែនាំ ទេ នោះ នឹង អនុវត្ត នូវ ការ ផាកពិន័យ តាម ច្បាប់ តែម្ដង ។
មួយវិញទៀត ក្នុង ករណី ប្រជាពលរដ្ឋ ត្រូវការធ្វើដំណើរ ពេលយប់ ក្នុង ម៉ោង ដែល ត្រូវ ហាមឃាត់ ( មិន បន្ទាន់ តែ មាន កំណត់ វេលា ច្បាស់លាស់ ) ត្រូវ សុំ លិខិត បញ្ជាក់ និង មាន វាយ ត្រា ពី ចៅសង្កាត់ ឬ អាជ្ញាធរ មូលដ្ឋាន ដោយ ប្រាប់ អំពី មូលហេតុ និង គោលបំណង នៃ ការធ្វើដំណើរ ដើម្បី បង្ហាញ ជូន សមត្ថកិច្ច នៅ តាម គោលដៅ ត្រួតពិនិត្យ ៕ BREAKING: ផ្ទុះ អាវុធ មួយ ករណី នៅក្បែរ ស្ពាន អាកាស ផ្សារ ដី ហ៊ុយ ស្ថិត ក្នុង ខណ្ឌ សែនសុខ . សេចក្ដីរាយការណ៍ ដំបូង ថា មាន មនុស្ស ម្នាក់ ស្លាប់
( ភ្នំពេញ ) ៖ សេចក្ដីរាយការណ៍ បាន ឲ្យដឹង ថា នៅ មុន នេះ បន្ដិច វេលា ម៉ោង ប្រមាណ ជិត ៩យប់ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ មាន ករណី ផ្ទុះ អាវុធ ចំនួន ៣គ្រាប់ នៅក្បែរ ស្ពាន អាកាស ផ្សារ ដី ហ៊ុយ ស្ថិត ក្នុង សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
បើ តាម សេចក្ដីរាយការណ៍ ជំហ៊ាន ដំបូង អះអាង ថា ក្នុង ហេតុការណ៍ នេះ បាន បណ្ដាលឲ្យ មនុស្ស ម្នាក់ ស្លាប់ ។ តែ យ៉ាងណាមិញ សម្រាប់ មូលហេតុ ដែល នាំឲ្យ ផ្ទុះ អាវុធ នេះ មិន ទាន់ ត្រូវបាន សមត្ថកិច្ច បញ្ជាក់ ឲ្យដឹង នៅឡើយ ទេ ព្រោះ កំពុង សួរនាំ នៅ កន្លែង កើត ហេតុ ។
មន្ដ្រី នគរបាល នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News យ៉ាង ខ្លី ដែរ ថា ពិតជា មាន ករណី ផ្ទុះ អាវុធ បណ្ដាលឲ្យ មនុស្ស ម្នាក់ ស្លាប់ ប្រាកដ មែន ។ ហើយ បច្ចុប្បន្ន នគរបាល ជំនាញ កំពុង ធ្វើ ការសួរនាំ និង ស្រាវជ្រាវ បន្ដ ទៀត ។
អ្នកវិជ្ជមាន កូវីដ៩ នាក់ មាន ទាំង កូនក្មេង អាយុ ជិត ១ ខួប នៅ ស្រុក តាំង គោក បាន ជាសះស្បើយ . អ្នក ពាក់ព័ន្ធ ៤២ នាក់ ទៀត ត្រូវ បញ្ចប់ ការធ្វើចត្តាឡី ស័ក
គួរ ជម្រាប ថា ការរាលដាល នៅ មូលដ្ឋាន ស្រុក តាំង គោក នេះ គឺ ដំបូង ឡើយ មាន យុវតី ម្នាក់ ឈ្មោះ ឡេង មីង ហួយ បាន ជាប់ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ ដោយ នាង បាន ធ្វើដំណើរ ពី ខេត្ត ព្រះសីហនុ ចូលមក ស្រុក តាំង គោក ខេត្ត កំពង់ធំ ដែល ជា ស្រុក កំណើត របស់ ខ្លួន ព្រោះ ដោយសារ មាន ធុរៈ ចាំបាច់ ក្នុង គ្រួសារ ។ បន្ទាប់មក ក៏ បាន ឆ្លង ដល់ សាច់ញាតិ របស់ នាង ចំនួន ៨នាក់ ( ៩នាក់ បើ គិត ទាំង មីង ហួយ ) និង មាន អ្នក ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ប្រយោល ត ៗ គ្នា ចំនួន ៤២ នាក់ ទៀត ។
លោក បន្ត ថា អ្នក ជាសះស្បើយ ចុងក្រោយ គេ គឺ បាន ចេញ ពី មន្ទីរពេទ្យ នៅ ល្ងាច ថ្ងៃទី ០៥ ខែមេសា ម្សិលមិញ ហើយ អាជ្ញាធរ បាន ណែនាំ ឱ្យ គាត់ ធ្វើចត្តាលីស័ក រយៈពេល ១៤ ថ្ងៃ នៅ ផ្ទះ បន្ត ទៀត ដែរ ។
តែ ទោះជា យ៉ាងណា លោក ហាក់ ម៉ុង ហួត ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទូទៅ ត្រូវ បន្ត ចូលរួម អនុវត្ត វិធានការ « ៣ការពារ ៣កុំ » ដែល ណែនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក៏ ដូចជា វិធាន អនាម័យ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ខ្ជាប់ខ្ជួន ដើម្បី ចូលរួម ទប់ស្កាត់ ការរីករាលដាល មក ក្នុង សហគមន៍ តទៅទៀត ៕
មិន តែ ប៉ុណ្ណោះ លោកស្រី លើកឡើង ថា « មាន បញ្ហា ផ្សេង ទៀត ក្រៅពី បញ្ហា នៃ ការរើសអើង ប្រឆាំង នឹង មនុស្ស មួយចំនួន ដែល មិន មាន លទ្ធភាព ចាក់ វ៉ាក់សាំង សម្រាប់ ហេតុផល ណាមួយ » ។
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា នាំ ពាក្យ ក្រសួង សុខាភិបាល បាន ថ្លែង ថា ឱកាស ចូល ឆ្នាំ ប្រពៃណី ជាតិ ខ្មែរ ខាងមុខ នេះ ប្រាកដ ណាស់ នឹង មាន ការចល័ត ពី ខេត្ដ មួយ ទៅ ខេត្ដ មួយ ហើយ ការជួបជុំ ក៏ កើតមាន ដែល ជា ការព្រួយបារម្ភ យ៉ាង ខ្លាំង ខណៈ ជំងឺ កូវីដ១៩ កំពុងតែ វាយលុក ប្រទេស របស់ យើង ។
លោកស្រី បាន ថ្លែង បញ្ជាក់ ទៀត ថា « ខេត្ដ ខ្លះ មិន ទាន់ មាន ករណី ឆ្លង ជំងឺ កូវីដ១៩ នោះ ទេ គ្រួសារ ខ្លះ ក៏ មិន មាន អ្នក ឆ្លង ដែរ ។ ប៉ុន្ដែ យើង ដឹង ច្បាស់ ហើយ ថា បច្ចុប្បន្ន មេរោគ កូវីដ១៩ កំពុងតែ វាយលុក និង ផ្ទុះ ខ្លាំង នៅ រាជធានី ភ្នំពេញ ខេត្ដ ព្រះសីហនុ កណ្ដាល ស្វាយរៀង ព្រៃវែង និង សៀមរាប ( នៅ តាម តំបន់ ខ្លះ ) ។ ដូច្នេះ យើង ត្រូវតែ ចៀសវាង ជាពិសេស ប្រជាពលរដ្ឋ យើង ដែល ត្រូវ ធ្វើដំណើរ ពី ភ្នំពេញ ទៅកាន់ ស្រុក កំណើត តាម ខេត្ដ នីមួយ ៗ » ។
លោកស្រី ឱ វណ្ណឌីន បាន លើកឡើង ថា « អ្វី ដែល ជា ការព្រួយបារម្ដ របស់ ខ្ញុំ គឺ ខ្លាចតែ ក្រោយពេល ឈប់ ចូល ឆ្នាំ ខ្មែរ រួចរាល់ ហើយ ស្រាប់តែ ខេត្ដ គ្មាន ករណី ឆ្លង បែរ ទៅជា ផ្ទុះ នូវ ការឆ្លង នៃ ជំងឺ កូវីដ១៩ ទៅ វិញ ។ នេះ ហើយ ជា មូលហេតុ ដែល យើង ទាំងអស់ គ្នា ត្រូវតែ រួមគ្នា កាត់ផ្ដាច់ ខ្សែ ចម្លង នេះ គឺ ការចម្លង ពី មនុស្ស ម្នាក់ ទៅ មនុស្ស ម្នាក់ ទៀត ។ ការកាច់ ផ្ដាច់ ខ្សែ ចម្លង នេះ វា ទាល់តែ បុគ្គល គ្រប់ រូប កុំ ចល័ត បើ មិន មាន ភាពចាំបាច់ ខ្លាំង » ។
លើស ពី នោះ លោកស្រី បាន អំពាវនាវ អ្នក ភ្នំពេញ កុំ ធ្វើដំណើរ ទៅ ស្រុក កុំ នាំ មេរោគ កូវីដ១៩ ចម្លង ទៅ គ្រួសារ របស់ ខ្លួន និង សហគមន៍ ហើយ ត្រូវ ចូលរួម ទាំងអស់ គ្នា បំពេញ កាតព្វកិច្ច នៅក្នុង ការអនុវត្ដ នូវ វិធានការ ៣ការពារ ៣កុំ ឱ្យ បាន ជាដាច់ខាត នោះ ប្រជាពលរដ្ឋ នឹង មិន អាច ឆ្លង និង ចម្លង ជំងឺ ដ៏ សាហាវ នេះ ទេ ។
លោកស្រី រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល ក៏ បាន ទទូច ក្នុង ឱកាស ចូល ឆ្នាំ ខ្មែរ ខាងមុខ នេះ ថា សូម បងប្អូន យើង កាត់បន្ថយ ការធ្វើដំណើរ ឱ្យ បានជា អតិបរិមា អ្នក ដែល មិន ចាំបាច់ គឺ សុំ នៅ ផ្ទះ នៅ ពេល នេះ គឺ នៅ ផ្ទះ ល្អ ប្រសើរ ជា ទីបំផុត ព្រោះ នៅ ផ្ទះ អត់ មាន ហានិភ័យ អ្វី ទៅ ជួប ជាមួយ ជំងឺ កូវីដ១៩ នោះ ទេ ជាពិសេស វីរុស កូវីដ ប្រភេទ បម្លែង ថ្មី នេះ ដែល យើង មិន ដឹង ថា នៅ ពេល នេះ វា នៅ ទីណា នោះ ទេ បើ ឆ្លង ហើយ រយៈពេល ២ - ៣ ថ្ងៃ គឺ ស៊ី សួត ស្លាប់ តែម្ដង ៕
សូម ទស្សនា ការ លើកឡើង របស់ លោកស្រី ឱ វណ្ណឌីន ទាំងស្រុង ក្នុង ឱកាស ចុះ ពិនិត្យ និង ប្រគល់ សម្ភារ មួយចំនួន ជូន ដល់ ក្រុម គ្រូពេទ្យ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ស៊ីណូ វ៉ាក់ ជូន ប្រជាពលរដ្ឋ នៅ កោះ ពេជ្រ និង ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នា ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២១ នេះ ដូចតទៅ៖ TOP NEWS: រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច បិទ ការធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ជា បណ្តោះអាសន្ន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ម៉ោង សូន្យ ចូល ថ្ងៃទី ៧ រហូតដល់ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២១
ប៉ុន្តែ សម្រាប់ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ត្រូវបាន ចាត់ទុក ជា តំបន់ មួយ មិន ស្ថិត នៅក្រោម វិសាលភាព នៃ ការហាមឃាត់ ការធ្វើដំណើរ ឆ្លងកាត់ ចេញ - ចូល ទៅ វិញ ទៅមក នោះ ទេ ។
ក្នុង សេចក្តីសម្រេច នេះ រាជ រដ្ឋាភិបាល ក៏ បាន សម្រេច បិទ រមណីយដ្ឋាន ទេសចរណ៍ នៅ ទូទាំង ប្រទេស ជា បណ្តោះអាសន្ន រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ៧ ដែល ថ្ងៃទី ២០ ខែមេសា ផងដែរ ។
គណៈ អភិបាល រាជធានី ខេត្ត ក៏ មាន សិទ្ធ បង្កើត យន្ត ការ ចាំបាច់ នានា ដើម្បី តាមដាន ត្រួតពិនិត្យ និង អនុវត្ត វិធានការ ទាំងឡាយ ក្រោម ខាងលើ ក្រោម សមត្ថកិច្ច របស់ ខ្លួន ផងដែរ ។
សូម បញ្ជាក់ ថា វិធានការ របស់ រាជ រដ្ឋាភិបាល បាន ធ្វើឡើង ក្នុង គ្រា ដែល ការឆ្លង ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ២០កុម្ភៈ កំពុង បន្ត កើនឡើង ជារៀងរាល់ ថ្ងៃ និង រីកសាយភាយ ទៅកាន់ ខេត្ត ជាច្រើន ។
( ភ្នំពេញ ) ៖ លោក ផាម មិញ ជិញ នាយក រដ្ឋមន្រ្តី ថ្មី របស់ វៀតណាម បាន បង្ហាញ អំពី ការប្តេជ្ញាចិត្ត បន្ត សហការ យ៉ាង ល្អ និង ជិតស្និទ្ធ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដើម្បី បន្ត ពង្រឹង ទំនាក់ទំនងជា អ្នកជិតខាង ល្អ មិត្តភាព ជា ប្រពៃណី និង កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ ។
ការអះអាង របស់ នាយក រដ្ឋមន្រ្តី ថ្មី វៀតណាម បាន ធ្វើឡើង នៅក្នុង ជំនួប សន្ទនា តាម ទូរស័ព្ទ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នៅ រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ ដែល ក្នុុង ជំនួប នោះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បាន សម្តែង នូវ អំណរ សាទរ យ៉ាង កក់ក្តៅ បំផុត ជូន ចំពោះ លោក ផាម មិញ ជិញ ដែល ត្រូវបាន សម័យ ប្រជុំ លើក ទី១១ នីតិកាល ទី១៤ នៃ រដ្ឋសភា វៀតណាម បោះឆ្នោត ជ្រើសតាំង ជា នាយក រដ្ឋមន្រ្តី ។
ភាគី ទាំង ពីរ បាន ឯកភាព អនុវត្ត ប្រកបដោយ ប្រសិទ្ធភាព នូវ ការងារ គ្រប់គ្រង ព្រំដែន ការប្រយុទ្ធ ប្រឆាំង នឹង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ការសហការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ការជំរុញ សកម្មភាព ផ្លាស់ប្តូរ ទំនិញ និង ការដោះស្រាយ បាន ទាន់ ពេលវេលា នូវ រាល់ បញ្ហា ដែល កើតមាន ជា យថាហេតុ ។ ភាគី ទាំង ពីរ បាន ឯកភាព បន្ត សហការ យ៉ាង ជិតស្និទ្ធ នៅក្នុង ក្របខណ្ឌ កិច្ចសហប្រតិបត្តិការ ពហុ ភាគី ។
សម្តេច តេជោ ហ៊ុន សែន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល ដ៏ ធំធេង ដែល ប្រជាជន វៀតណាម សម្រេចបាន រហូតមកដល់ បច្ចុប្បន្ន នេះ ព្រមទាំង បាន សម្តែង នូវ ការជឿជាក់ ថា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ លោក ផាម មិញ ជិញ រដ្ឋាភិបាល និង ប្រជាជន វៀតណាម នឹង អនុវត្ត ដោយ ជោគជ័យ នូវ ផែន ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម រយៈពេល ៥ ឆ្នាំ ( ២០២១ - ២០២៥ ) និង យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ សេដ្ឋកិច្ច រយៈពេល ១០ ឆ្នាំ ( ២០២១ - ២០៣០ ) តាមរយៈ សេចក្តីសម្រេចិត្ត រប ស់ គណបក្ស កុម្មុយនិស្ត និង រដ្ឋសភា វៀតណាម ។
លោក ផាន មិញ ជិញ បាន ថ្លែងអំណរគុណ ដល់ កម្ពុជា ដែល បាន គាំទ្រ វៀតណាម ឱ្យ បំពេញ តួនាទី ជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២០ ដោយ ជោគជ័យ និង បាន បញ្ជាក់ អំពី ការគាំទ្រ របស់ វៀតណាម ចំពោះ កម្ពុជា ក្នុង ការបំពេញ តួនាទី ជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ី - អឺរ៉ុប (ASEM) លើក ទី១៣ នៅ ចុង ឆ្នាំ ២០២១ និង ជា ប្រធាន អាស៊ាន នៅ ឆ្នាំ ២០២២ ខាងមុខ នេះ ដោយ បាន ជោគជ័យ ។
ប្រជាពលរដ្ឋ បាន ឲ្យដឹង ថា ស្ពាន នេះ ក៏ ធ្លាប់ ធ្លាក់ គោយន្ត និង ស្រូវ ចូល ទៅក្នុង អូរ រងគ្រោះ មនុស្ស និង ខូចខាត សម្ភារៈ រួច មកហើយ ដែរ ៕ ហ្វីលីពីន កត់ត្រា ចំនួន អ្នកស្លាប់ ប្រចាំ ថ្ងៃ ដោយសារ កូវីដ - ១៩ ច្រើន បំផុត មិន ធ្លាប់ មាន ចំនួន ៣៨២ នាក់ និង ករណី ឆ្លង ថ្មី ជាង ៩ ពាន់ ករណី នៅក្នុង របាយការណ៍ ថ្ងៃ នេះ
( ម៉ានីល) ៖ ប្រទេស ហ្វីលីពីន បាន កត់ត្រា ចំនួន អ្នកស្លាប់ ដោយសារ ជំងឺ COVID-19 ចំនួន ៣៨២ នាក់ បន្ថែម ទៀត នៅ ថ្ងៃអង្គារ នេះ ដែល ជា ចំនួន អ្នកស្លាប់ ប្រចាំ ថ្ងៃ ខ្ពស់ បំផុត មិន ធ្លាប់ មាន សម្រាប់ ប្រទេស អាស៊ី អាគ្នេយ៍ មួយ នេះ ដែល នាំឲ្យ មាន អ្នកស្លាប់ សរុប កើន ដល់ ទៅ ១៣.៨១៧ នាក់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃអង្គារ ទី ០៦ ខែមេសា ឆ្នាំ ២០២១ ។
ទោះជា យ៉ាងណា ក្រសួង សុខាភិបាល បាន គូសបញ្ជាក់ ថា តួលេខ អ្នកស្លាប់ ច្រើន នៅក្នុង របាយការណ៍ ថ្ងៃ នេះ ដោយសារតែ មាន ករណី ស្លាប់ ចំនួន ៣៤១ នាក់ មិន ត្រូវបាន គេ រាយការណ៍ កាលពី សប្តាហ៍ មុន ដោយសារតែ បញ្ហា បច្ចេកទេស នៅក្នុង ប្រព័ន្ធ ប្រមូល ទន្ន័យ ។
លោកស្រី សុង ឡេង បូរ៉ា បរិច្ចាគ ថវិកា២.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ មន្ទីរពេទ្យ « នគរ ទេព » និង ចូលរួម ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ
( ភ្នំពេញ ) ៖ លោកស្រី សុង ឡេង បូរ៉ា នាយិការ ពិធី ការ សម្ដេច តេជោ ហ៊ុន សែន បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ មន្ទីរពេទ្យ « នគរ ទេព » ។ ការបរិច្ចាគ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ទិញ មន្ទីរ « នគរ ទេព » មក ធ្វើជា សម្បត្តិ រដ្ឋ និង បម្រើ ការព្យាបាល អ្នកជំងឺ កូវីដ១៩ ។
ជាមួយគ្នា នេះ លោកស្រី សុង ឡេង បូរ៉ា ក៏ បាន បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ ទៀត ជូន គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ទប់ស្កាត់ និង បង្ការ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ផងដែរ ៕
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ផ្ញើ សារ ជូន ថ្នាក់ដឹកនាំ ទាំងអស់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ លោកគ្រូពេទ្យ អ្នកគ្រូពេទ្យ បុគ្គលិក សុខាភិបាល គ្រប់ រូប កងកម្លាំង និង ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ សូម ប្រកបដោយ សេចក្តីសុខ សុភមង្គល សុខភាព ល្អ ជៀស ចាក ឆ្ងាយ ពី ជំងឺ ផ្សេង ៗ ជាពិសេស ជំងឺ កូវីដ១៩ ទាំងអស់ គ្នា និង សូម ទទួលបាន ជោគជ័យ គ្រប់ តួនាទី ភារកិច្ច ។
តាមរយៈ សារ ប្រមាណ ជាង ៦នាទី ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ ការលំបាក ដែល ប្រជាពលរដ្ឋ កម្ពុជា បាន ជួបប្រទះ ក្នុង អំឡុង ពេល រីករាលដាល ជំងឺ កូវីដ១៩ នេះ គឺ ទាមទារ ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ រក្សា នូវ ភាពរឹងមាំ ទាំង ស្មារតី និង កម្លាំង ហើយ ចូលរួម សហការ គោរព និង អនុវត្ត តាម ការណែនាំ ក៏ ដូចជា វិធានការបន្ទាន់ នានា របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ ជា បន្ដ បន្ទាប់ ។
លោក ហ៊ុន ម៉ានី បាន ឲ្យដឹង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន កំណត់ និង អនុវត្ត វិធានការគ្រប់គ្រង សភាពការណ៍ ដោយ ត្រឹមត្រូវ ហ្មត់ចត់ បំផុត ក្នុង ការបង្ការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នៅ កម្ពុជា ក្នុង នោះ អ្វី ដែល ជា លទ្ធផល គឺ បទពិសោធន៍ ជោគជ័យ ក្នុង ការគ្រប់គ្រង ព្រឹត្តិការណ៍ សហគមន៍ ៣វិច្ឆិកា និង ២៨វិច្ឆិកា ។
ជាមួយនឹង ជោគជ័យ នេះ គឺ មិន អាច កាត់ផ្ដាច់ ពី ការចូលរួម របស់ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ព្រោះថា មូលដ្ឋាន នៃ ការយកឈ្នះ លើ ស្ថានភាព និង សភាពការណ៍ លំបាក គឺ ការរួបរួម និង ការសាមគ្គី គ្នា ក្នុង នាម ប្រជាពលរដ្ឋ ខ្មែរ តែ មួយ ៕
ខាងក្រោម នេះ ជា វីដេអូ នៃ ការផ្ញើ សារ របស់ លោក ហ៊ុន ម៉ានី៖ ឧត្តមសេនីយ៍ ទោ សេង ធារិន ប្រាប់ កងទ័ព ត្រូវ ផ្សព្វផ្សាយ ដល់ ពលរដ្ឋ ឲ្យបាន ចូលរួម ចាក់ ថ្នាំ វ៉ាក់សាំង ការពារ កូវី ដ១៩
( ប៉ៃលិន ) ៖ លោក ឧត្តមសេនីយ៍ ទោ សេង ធារិន មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ យោធ ភូមិភាគ ទី៥ ប្រាប់ ឲ្យ កងទ័ព ចូលរួម ផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលាយ ដល់ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ឲ្យ ទៅ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នូវ ជំងឺ កូវីដ១៩ តទៅទៀត ។
ការលើកឡើង ដូច្នេះ បន្ទាប់ពី មួយ រយៈ នេះ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ បាន អំពាវនាវ ប្រជាពលរដ្ឋ កុំ ចូលរួម ចាក់ វ៉ាក់សាំង របស់ ចិន ក្នុង គោលបំណង ចង់ឲ្យ ប្រជាពលរដ្ឋ កម្ពុជា បន្ត ស្លាប់ និង ឆ្លង ដោយសារ ជំងឺ កូវីដ១៩ រួច ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ នឹង ទម្លាក់ កំហុស មក លើ រាជ រដ្ឋាភិបាល កម្ពុជា ថា មិន មាន វិធានការ ក្នុង ការគ្រប់គ្រង ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
ការថ្លែង បែប នេះ ធ្វើឡើង នៅក្នុង ពិធី ប្រជុំ បូកសរុប លទ្ធផល ការងារ យោធា សន្តិសុខ ឆ្នាំ ២០២០ និង ផ្សព្វផ្សាយ ផែនការ សកម្មភាព ការងារ យោធា សន្តិសុខ ឆ្នាំ ២០២១ របស់ តំបន់ ប្រតិបត្តិការ សឹក រង ប៉ៃលិន ស្ថិត ក្នុង ភូមិ ដីក្រហម ឃុំ អូរតា វ៉ៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន នា ព្រឹក ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២១ ។
នៅក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ សេង ធារិន បាន កោតសរសើរ ដល់ អង្គភាព តំបន់ ប្រតិបត្តិការ សឹក រង ប៉ៃលិន ដែល បាន ប្រឹងប្រែង ទាំង កម្លាំង កាយ កម្លាំងចិត្ត ក្នុង បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ រហូត ទទួលបាន លទ្ធផល ល្អ នៅក្នុង ឆ្នាំ នេះ ។
លោក ឧត្តមសេនីយ៍ ទោ បាន បន្ត ថា « នៅ ប៉ុន្មាន ថ្ងៃ ខាងមុខ ទៀត គឺ ដល់ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល ប្រជាពលរដ្ឋ អាជីវករ មន្ត្រីរាជការ កម្មករ បុគ្គលិក ត្រូវបាន អនុញ្ញាតឲ្យ ឈប់ សម្រាក ចំណែកឯ កម្លាំង កងទ័ព មិន ត្រូវបាន អនុញ្ញាតឲ្យ ឈប់ សម្រាក នោះ ទេ ហើយ ត្រូវតែ បង្កើន ការយកចិត្តទុកដាក់ ចូលរួម ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ឲ្យ ទទួលបាន លទ្ធផល ល្អ ប្រសើរ » ។
( ព្រះវិហារ ) ៖ លោក ពឹង ទ្រី ដា ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ និង ជា អនុប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ក្រុមការងារ នាំ អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ផ្តល់ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ បណ្តាលឱ្យ ខូចខាត ផ្ទះ សំបែង ចំនួន ១៨ គ្រួសារ នៅ ភូមិ បង្កន និង ភូមិរៀបរយ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ។
លោក ពឹង ទ្រី ដា បាន ថ្លែង ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ក៏ ដូចជា លោក មាស សុភា ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហកម្ពុជា ខេត្ត លោក ប្រាក់ សុវណ្ណ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ដែល ជានិច្ច ជាកាល តែង បាន គិតគូរ យកចិត្តទុកដាក់ ជានិច្ច ចំពោះ ប្រជាពលរដ្ឋ ក្រីក្រ និង ប្រជាពលរដ្ឋ ដែល ជួប នូវ គ្រោះថ្នាក់ ផ្សេង ៗ ផងដែរ ។
លោក ពឹង ទ្រី ដា ក៏ បាន ចូលរួម សោកស្តាយ ជាមួយ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ខ្យល កន្ត្រាក់ ចំនួន ១៨ គ្រួសារ ធ្វើឱ្យ ខូចខាត ផ្ទះ សំបែង និង ទ្រព្យសម្បត្តិ ផ្សេង ៗ ។ លោក ថា គ្រោះថ្នាក់ គ្មាន អ្នកណា មើលឃើញ នោះ ទេ ហើយក៏ គ្មាន អ្នកណា ចង់ឱ្យ កើតមាន ដែរ សូម កុំ អស់សង្ឃឹម ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី គឺ មិន ទុក ឱ្យ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភាពអត់ឃ្លាន នោះ ឡើយ ។
លោក ក៏ បាន ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ការពារ ទប់ស្កាត់ កុំ ឱ្យ ឆ្លង ជំងឺ កូវីដ .១៩ កើតមាន ក្នុង ក្រុមគ្រួសារ និង សហគមន៍ ដោយ ត្រូវ អនុវត្ត ឱ្យ បាន ទៀងទាត់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង អនុសាសន៍ ណែនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន គឺ ៣កុំ និង ៣ការពារ ។
សូម បញ្ជាក់ ថា ពលរដ្ឋ រងគ្រោះ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម មី១ កេស ត្រីខ១យួរ មុង១ សារ៉ុង១ ភួយ១ ក្រមា១ ទឹកស៊ីអ៊ីវ ១យួរ និង ថវិកា មួយ ចំនួន ។ ដោយឡែក គ្រួសារ ដែរងគ្រោះ ធ្ងន់ធ្ងរ និង មធ្យម ទទួលបាន តង់ ១ ផងដែរ ៕
យុវជន ល្អ រួបរួម គាំទ្រ កម្ចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែ មេសា៖ បង្ក្រាប ១៨ករណី ឃាត់ខ្លួន ២៩ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី និង ជួញដូរ ១២ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ សរុប ២៩ នាក់ ព្រមទាំង ដកហូត បាន គ្រឿងញៀន ៧០. ៧៨ ក្រាម និង ១៧កញ្ចប់ តូច ទៀត ។
អភិបាល ខេត្ត កំពង់ចាម ណែនាំឲ្យ មន្ត្រី ត្រួតពិនិត្យ ឱ្យ បាន ហ្មត់ចត់ មុននឹង ទទួលយក គម្រោង សាងសង់ អ្វី មួយ ពី ម្ចាស់ ក្រុមហ៊ុន ម៉ៅការ
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន ណែនាំ ឱ្យ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ ធ្វើ ការត្រួតពិនិត្យ ឱ្យ បាន ហ្មត់ចត់ មុននឹង ទទួលយក គម្រោង សាងសង់ អ្វី មួយ ពី ម្ចាស់ ក្រុមហ៊ុន ម៉ៅការ ចៀសវាង ការខូចខាត ផល ប្រយោជន៍ រួម ក្នុង គម្រោង មូលនិធិ ឃុំ - សង្កាត់ ។
លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ដូចនេះ នៅ ថ្ងៃទី 0៦ ខែមេសា ឆ្នាំ ២០២១ នៅ សាលា ខេត្ត កំពង់ចាម ក្នុង កិច្ចប្រជុំ សាមញ្ញ លើក ទី ២៣ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម ។
លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ថា មន្ត្រី ពាក់ព័ន្ធ ជាពិសេស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ទាំងអស់ ដែល ជា ម្ចាស់ គម្រោង មូលនិធិ ឃុំ - សង្កាត់ ត្រូវ ធ្វើ ការត្រួតពិនិត្យ ឲ្យ បាន ច្បាស់លាស់ ជាមុន សិន មុននឹង ចុះហត្ថលេខា ទទួលយក នូវ គម្រោង សាងសង់ អ្វី មួយ ពី ម្ចាស់ ក្រុមហ៊ុន ទទួល ការ ដើម្បី ចៀសវាង ការខូចខាត ផល ប្រយោជន៍ រួម ហើយ គ្មាន អ្នកទទួលខុសត្រូវ ដោយឡែក ចំពោះ ក្រុមហ៊ុន ដែល សាងសង់ សំណង់ គ្មាន គុណភាព ត្រូវ ធ្វើ ការរាយការណ៍ ដើម្បី មាន ចំណាត់ការ តាម ផ្លូវ ច្បាប់ ផងដែរ ។
ក្នុង កិច្ចប្រជុំ នេះ ដែរ លោក ខ្លូត ផន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម បាន លើក ជា របៀបវារៈ ធំ ៗ ចំនួន ៤ រួម មាន៖
( ភ្នំពេញ ) ៖ កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បន្ដ ចូលរួម សហការ អនុវត្ត សេចក្តីសម្រេច របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ស្តីពី វិធានការបំរាម គោចរចាប់ពី ម៉ោង ៨៖០០ យប់ រហូតដល់ ម៉ោង ៥៖០០ ភ្លឺ ចំនួន ៣០ គោលដៅ និង ល្បាត ការពារ សន្តិសុខ សុវត្ថិភាព ជូន ដល់ ប្រជាពលរដ្ឋ ទូទាំង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ នា យប់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ ។
មួយវិញទៀត ក្នុង ករណី ប្រជាពលរដ្ឋ ត្រូវការធ្វើដំណើរ ពេលយប់ ក្នុង ម៉ោង ដែល ត្រូវ ហាមឃាត់ ( មិន បន្ទាន់ តែ មាន កំណត់ វេលា ច្បាស់លាស់ ) ត្រូវ សុំ លិខិត បញ្ជាក់ និង មាន វាយ ត្រា ពី ចៅសង្កាត់ ឬ អាជ្ញាធរ មូលដ្ឋាន ដោយ ប្រាប់ អំពី មូលហេតុ និង គោលបំណង នៃ ការធ្វើដំណើរ ដើម្បី បង្ហាញ ជូន សមត្ថកិច្ច នៅ តាម គោលដៅ ត្រួតពិនិត្យ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៦០៦ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១
បើ តាម អ្នកនាំពាក្យ . គិត ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ៦ ខែមេសា ក្នុង ឆ្នាំ ២០២១ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៧១.១៩៤ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥២.១២២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១៩. ០៧២ គ្រឿង ។
ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម បដិសេធ ព័ត៌មាន ដែល ចោទ ថា មាន ការបើក លេង ល្បែង ស៉ី សង ជល់ មាន់ នៅ ស្រុក ចំការ លើ
ផ្អែក តាម ការបំភ្លឺ ពី ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ អូរ វាយ ឃុំ ស្ពឺ ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម និង ផ្អែក តាម របាយការណ៍ របស់ អាជ្ញាធរ មូលដ្ឋាន បាន ឲ្យដឹង ថា នៅ ចំណុច ទីតាំង ខាងលើ ធ្លាប់ មាន ក្រុម អ្នក លួច លេង ល្បែង ជល់ មាន ម្ដង ម្កាល និង ក៏ ត្រូវបាន សមត្ថកិច្ច ចុះបង្ក្រាប ជា បន្ដ បន្ទាប់ បច្ចុប្បន្ន នេះ ពុំ មាន សកម្មភាព លួច លេង ល្បែង ជល់ មាន់ នៅ ភូមិ សាស្ដ្រ នោះ ទៀត ទេ ។
បើ ទោះជា យ៉ាងណា ក៏ដោយ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម បាន ដាក់ បទបញ្ជា និង ចាត់តាំង លោក អធិការ រង ០១ រូប ទទួល ដឹកនាំ កម្លាំង ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល ស្ពឺ បន្ត ល្បាត ឃ្លាំមើល សកម្មភាព ល្បែងស៊ីសង ខុស ច្បាប់ នានា នៅ គោលដៅ ខាងលើ ក៏ ដូចជា ក្នុង ភូមិសាស្ត្រ នៃ ស្រុក ចំការលើ ។
តាម ការស្រាវជ្រាវ របស់ ជំនាញ ពុំ ទាន់ បាន រកឃើញ ភស្តុតាង ដាក់ បន្ទុក ណាមួយ ដែល អាច បញ្ជាក់ ថា មន្ត្រី ណា ម្នាក់ ជា អ្នកបើកបន ល្បែងស៊ីសង ខុស ច្បាប់ នោះ នៅឡើយ ទេ ។ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម សូម ស្នើឲ្យ អ្នក ដែល បាន ចុះផ្សាយ មេត្តា សហការចង្អុល មុខ សញ្ញា សង្ស័យ ឬ ផ្តល់ ភស្តុតាង បន្ថែម ដើម្បី សមត្ថកិច្ច មាន មូលដ្ឋាន អនុវត្ត គោលការណ៍ ជំនាញ និង នីតិវិធី ។
ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សាធារណជន អ្នកសារព័ត៌មាន និង បណ្ដាញ សង្គម ដែល តែងតែ សហការផ្តល់ ព័ត៌មាន ពាក់ព័ន្ធ សន្តិសុខ សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព សង្គម ដើម្បី មាន មូលដ្ឋាន ចាត់ វិធានការ បង្ការ ទប់ស្កាត់ និង បង្ក្រាប ទាន់ ពេល វេលា ។
ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម សូមស្វាគមន៍ ចំពោះ មតិ រិះគន់ ទាំងឡាយ ក្នុង ន័យ ស្ថាបនា និង ទទួលយក ជា មូលដ្ឋាន ក្នុង ការកែលម្អ ការអនុវត្ត តួនាទី ភារកិច្ច បម្រើ ជាតិ និង ប្រជាជន និង ស្នើសុំ ពី គ្រប់ មជ្ឈដ្ឋាន បន្ត សហការ ជាមួយ កម្លាំង ជំនាញ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម សូម ទំនាក់ទំនង ទូរស័ព្ទ លេខ ០៧៨ ៧៧៧៧ ១៦ ឬ លេខ ០១៥ ៧២៧ ៣៣៧ នឹង រក្សា ការសម្ងាត់ ជូន ៕
លោកស្រី សុង ឡេង បូរ៉ាវី និង ស្វាមី បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ទិញ មន្ទីរពេទ្យ « នគរ ទេព » និង ថវិកា ៥០០ ដុល្លារ សម្រាប់ ចូលរួម ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ
( ភ្នំពេញ ) ៖ លោកស្រី សុង ឡេង បូរ៉ាវី និង ស្វាមី បរិច្ចាគ ថវិកា ចំនួន ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ មន្ទីរពេទ្យ « នគរ ទេព » ។ ការបរិច្ចាគ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ទិញ មន្ទីរ « នគរ ទេព » មក ធ្វើជា សម្បត្តិ រដ្ឋ និង បម្រើ ការព្យាបាល អ្នកជំងឺ កូវីដ១៩ ។
ជាមួយគ្នា នេះ លោកស្រី សុង ឡេង បូរ៉ាវី និង ស្វាមី ក៏ បាន បរិច្ចាគ ថវិកា ចំនួន ៥០០ ដុល្លារ ជូន គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ទប់ស្កាត់ និង បង្ការ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ៕
( ភ្នំពេញ ) ៖ ឯកឧត្តម ម៉ុក ម៉ារ៉េត សមាជិក សភា មណ្ឌល តាកែវ ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ម៉ុក ម៉ារ៉េត កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ប៉េកាំង ) ៖ នៅលើ ពិភពលោក តើ ប្រទេស ណា មួយ មាន ឋានៈ ខ្ពស់ ជាង ប្រទេស ដទៃ ទៀត ? ក្នុង ក្រសែភ្នែក របស់ ជនជាតិ ចិន ចម្លើយ គឺ អត់ មាន ទេ ! នា ពេល ថ្មី ៗ កន្លងទៅ នេះ លោក វ៉ាង អ៊ី សមាជិក ក្រុមប្រឹក្សា កិច្ចការ រដ្ឋ និង ជា រដ្ឋមន្រ្តី ការបរទេស ចិន បាន ថែ្លង ក្នុង ពេល ផ្តល់ បទសម្ភាសន៍ ផ្តាច់ មុខ ជាមួយ អ្នកសារព័ត៌មាន ថា ប្រទេស ចិន មិន ទទួលស្គាល់ ថា នៅលើ ពិភពលោក ប្រទេស ណា មួយ មាន ឋានៈ ខ្ពស់ ជាង ប្រទេស ដទៃ ទៀត ហើយក៏ មិន ទទួលយក ថា រឿង នៅលើ ពិភពលោក សម្រេច ដោយ ប្រទេស តែ មួយ ។
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ជូ គឹម ឡេង រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ វ៉ែន សុភី ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្ដម ជូ គឹម ឡេង និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ត្រាំ អ៉ីវតឹក និង លោកជំទាវ ឈរ ណារី ឧបត្ថម្ភ ថវិកា ៥លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ត្រាំ អ៉ីវតឹក និង លោកជំទាវ ឈរ ណារី ឧបត្ថម្ភ ថវិកា ៥លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ទេសរដ្ឋមន្ត្រី និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ លោកស្រី មុំ ចានី ដានី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា រាជធានី ភ្នំពេញ បាន ស្នើ យ៉ាង ទទូច ទៅដល់ ជន ងាយ រងគ្រោះ រួម មាន៖ កុមារា កុមារី អំ ពូ មី ក្មួយ ៗ ដែល កំពុង យក អំបោស ដើរ បោសរថយន្ត នៅ តាម ភ្លើង ស្តុប ធ្វើជា របប ចិញ្ចឹម ជីវិត នោះ សូម វិលត្រឡប់ ទៅកាន់ លំនៅឋាន វិញ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ដែល កំពុង រីករាលដាល ខ្លាំង នៅ ពេល នេះ ។
លោកស្រី មុំ ចានី ដានី បាន អង្វរ ដោយ ទទូច បែប នេះ ខណៈ លោកស្រី និង លោក តូច ចាន់ នី អគ្គ នាយក នៃ អគ្គ នាយក បច្ចេកទេស នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ចុះ យក ម៉ាស សាប៊ូ និង ភួយ ផ្តល់ ជូន ដល់ ក្រុម ជន ងាយ រងគ្រោះ នៅ តាម ភ្លើង ស្តុប នានា ក្នុង រាជធានី ភ្នំពេញ នា ល្ងាច ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ ។
លោកស្រី មុំ ចាន់ ដានី បាន ឲ្យដឹង ថា ជា ការឆ្លើយតប ទៅ សកម្មភាព មនុស្សធម៌ ជំរុញ មិន ឲ្យ មាន នរណា ម្នាក់ ស្លាប់ ដោយ គ្មាន បាយ ទទួលទាន ឬ ដោយសារ អាជ្ញាធរ យើង មិន បាន ដឹង នោះ ខណៈ នេះ ក្រុមការងារ មន្ទីរ សង្គមកិច្ច បាន ចុះ ពិនិត្យ និង បាន ស្នើឲ្យ ពួកគាត់ វិលត្រឡប់ ទៅកាន់ លំនៅដ្ឋាន និង ចូល ផ្ទះ ដើម្បី ការពារ ពួក ពី ហានិភ័យ នៃ រលក ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ដែល បាន និង កំពុង រីករាលដាល ក្នុង សហគមន៍ ។
ជាមួយគ្នា នេះ លោក តូច ចាន់ នី បាន បញ្ជាក់ ផងដែរ ថា ក្រុម ជន ងាយ រងគ្រោះ មិន ចង់ រស់ នៅ តាម មណ្ឌល ដែល រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង សង្គមកិច្ច បាន យក ពួកគាត់ ទៅ រស់ នៅ ក្រោម ការយកចិត្ត ទុក្ខ ថែរក្សា ចិញ្ចឹម បីបាច់ របស់ គោល នយោបាយ ជាតិ នោះ ទេ ពោលគឺ គាត់ ចង់ រស់នៅ ដោយ សេរី ដើរ ត្រាច់ចរ តាម ដងផ្លូវ តាម ស្តុប ដើម្បី រស់ មួយ បែប របស់ ពួកគាត់ ។
ពាក់ព័ន្ធ នឹង ស្ថានភាព ការពារ ជំងឺ កូវីដ១៩ នេះ លោក តូច ចាន់ នី បាន បញ្ជាក់ ថា សព្វ ថ្ងៃ មន្ទីរ សង្គមកិច្ច មាន មណ្ឌល ជាច្រើន ដែល យក មនុស្ស ទៅ ដាក់ តាម មណ្ឌល ដូចជា មណ្ឌល វិប្លាស ស្មារតី មណ្ឌលកុមារ កំព្រា ជន អនាថា ហើយ មណ្ឌល ទាំងនេះ មាន ហានិភ័យ ខ្ពស់ ចឹង ទេ ក្រុមការងារ បាន ចុះ ចែក ម៉ាស អាល់កុល ជែល និង ពង្រឹង ការណែនាំ បង្រៀន ដល់ ពួកគាត់ ឲ្យ ពាក់ ម៉ាស់ លាង ដៃ និង សាប៊ូ អាល់កុល ជែល ធ្វើ យ៉ាងណា ឲ្យ ពួកគាត់ ចេះ ការពារ ខ្លួន ពី ជំងឺ កូវីដ១៩ ។
លោក តូច ចានីនី បាន បញ្ជាក់ ទៀត ថា ជា វិធានការ ការពារ កូវី ដ១៩ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី នេះ យើង មិន អនុញ្ញាតឲ្យ អ្នក ក្រៅ ចូល មណ្ឌល និង អ្នក ក្នុង ចេញ ក្រៅ មណ្ឌល ៕ ក្រសួង ការងារ ចេញ ប្រកាស ស្តីពី ការប្រើប្រាស់ ប័ណ្ណ អនុញ្ញាត ដឹកជញ្ជូន កម្មករ និយោជិត និង ការធ្វើ ការងារ នៅក្នុង អំឡុង ពេល ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង គោលដៅ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ ចេញ ប្រកាស ស្តីពី ការប្រើប្រាស់ ប័ណ្ណ អនុញ្ញាត ដឹកជញ្ជូន កម្មករ និយោជិត និង ការធ្វើ ការងារ នៅក្នុង អំឡុង ពេល ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង គោលដៅ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។ នេះ បើ យោង តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ជម្រាប ជូន ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ដែល មិន ត្រូវបាន កំណត់ ឱ្យ បិទ សកម្មភាព អាជីវកម្ម . កម្មករ និយោជិត និង បុគ្គលិក . និង អ្នកបើកបរ ឬ ម្ចាស់ មធ្យោបាយ ដឹកជញ្ជូន កម្មករ និយោជិត និង បុគ្គលិក ដូច ខាងក្រោម៖
ក៖ ចំពោះ កម្មករ និយោជិត និង បុគ្គលិក
* អ្នកប្រើប្រាស់ មធ្យោបាយ ធ្វើដំណើរ ផ្ទាល់ខ្លួន និង ធ្វើដំណើរ តែ ម្នាក់ឯង ត្រូវ យក តាម ខ្លួន នូវ កាត សម្គាល់ កម្មករ និយោជិត ឬ បុគ្គលិក និង អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ឬ ឯកសារ ដែល អាច បញ្ជាក់ ពី ទីលំនៅ បច្ចុប្បន្ន របស់ ខ្លួន នៅ រៀងរាល់ ពេល ធ្វើដំណើរ ទៅ កន្លែង ធ្វើការ និង ត្រឡប់មក ផ្ទះ ដើម្បី បង្ហាញ ជូន អាជ្ញាធរ មាន សមត្ថកិច្ច
* អ្នកប្រើប្រាស់ មធ្យោបាយ ធ្វើដំណើរ រួមត្រូវ ជិះ មធ្យោបាយ ដែល មាន « ប័ណ្ណ អនុញ្ញាត ដឹកជញ្ជូន កម្មករ និយោជិត » ចេញ ដោយ ក្រសួង ឬ មន្ទីរ ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង យក តាម ខ្លួន នូវ កាត សម្គាល់ កម្មករ និយោជិត និង បុគ្គលិក នៅ រៀងរាល់ ពេល ធ្វើដំណើរ ទៅ កន្លែង ធ្វើការ និង ត្រឡប់មក ផ្ទះ ដើម្បី បង្ហាញ ជូន អាជ្ញាធរ មាន សមត្ថកិច្ច ។
ខ៖ ចំពោះ ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស
* ត្រូវ ផ្ដល់ បញ្ជី ស្លាកលេខ រថយន្ដ ឬ មធ្យោបាយ ដឹកជញ្ជូន ដល់ អធិការ ការងារ
* ត្រូវ សហការ ជាមួយ អធិការ ការងារ ដើម្បី ផ្ដល់ « ប័ណ្ណ អនុញ្ញាត ដឹកជញ្ជូន កម្មករ និយោជិត » ដល់ អ្នកបើកបរ ( ដូច មាន គំរូ ជូន ភ្ជាប់ ជាមួយ ) សម្រាប់ បង្ហាញ ជូន អាជ្ញាធរ មាន សមត្ថកិច្ច នៅពេល ដឹកជញ្ជូន កម្មករ និយោជិត និង បុគ្គលិក ទៅ កន្លែង ធ្វើការ និង ត្រឡប់មក ផ្ទះ
* ត្រូវ ធានា ថា កម្មករ និយោជិត និង បុគ្គលិក ទាំងអស់ មាន កាត សម្គាល់ ខ្លួន ។ ក្នុង ករណី បាត់ ត្រូវ ចេញ កាត សម្គាល់ ខ្លួន ជូន កម្មករ និយោជិត និង បុគ្គលិក ជា បន្ទាន់ ។
គ៖ ចំពោះ អ្នកបើកបរ ឬ ម្ចាស់ មធ្យោបាយ ដឹកជញ្ជូន កម្មករ និយោជិត និង បុគ្គលិក
* ត្រូវ មក ទទួលយក « ប័ណ្ណ អនុញ្ញាត ដឹកជញ្ជូន កម្មករ និយោជិត » ពី រោងចក្រ សហគ្រាស និង ត្រូវ ដាក់ បង្ហាញ នៅ ផ្នែក ខាងមុខ មធ្យោបាយ ដឹកជញ្ជូន ដើម្បី បង្ហាញ ជូន អាជ្ញាធរ មាន សមត្ថកិច្ច ៕
ក្រសួង ការពារ ជាតិ ចាក់ វ៉ាក់សាំង ការពារ កូវីដ លើក ទី១ ជូន កម្លាំងប្រដាប់អាវុធ កើន ដល់ ចំនួន ១៨០. ២៣៥ នាក់ ខណៈ ចាក់ លើក ទី២ បាន ចំនួន ១១១. ៧៧០ នាក់
សេចក្តីប្រកាស របស់ ក្រសួង ការបរទេស បាន បញ្ជាក់ ថា នៅ រសៀល ថ្ងៃទី ០៦ ខែមេសា នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ជួប សន្ទនា តាម ទូរស័ព្ទ ជាមួយ លោក ផាម មិញ ជិញ ដោយ បាន សម្តែង នូវ អំណរ សាទរ យ៉ាង កក់ក្តៅ បំផុត ជូន ចំពោះ លោក ផាម មិញ ជិញ ដែល ត្រូវបាន សម័យ ប្រជុំ លើក ទី១១ នីតិកាល ទី១៤ នៃ រដ្ឋសភា វៀតណាម បោះឆ្នោត ជ្រើសតាំង ជា នាយក រដ្ឋមន្រ្តី ។
សេចក្តីប្រកាស បាន បញ្ជាក់ ថា ភាគី ទាំង ពីរ បាន ឯកភាព អនុវត្ត ប្រកបដោយ ប្រសិទ្ធភាព នូវ ការងារ គ្រប់គ្រង ព្រំដែន ការប្រយុទ្ធ ប្រឆាំង នឹង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ការសហការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ការជំរុញ សកម្មភាព ផ្លាស់ប្តូរ ទំនិញ និង ការដោះស្រាយ បាន ទាន់ ពេលវេលា នូវ រាល់ បញ្ហា ដែល កើតមាន ជា យថាហេតុ ។ ភាគី ទាំង ពីរ បាន ឯកភាព បន្ត សហការ យ៉ាង ជិតស្និទ្ធ នៅក្នុង ក្របខណ្ឌ កិច្ចសហប្រតិបត្តិការ ពហុ ភាគី ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១
១៖ ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ៧២ នាក់ ខណៈ អ្នកជំងឺ ចំនួន ៤៧ នាក់ ជាសះស្បើយ
៣៖ ក្រសួង សុខាភិបាល ផ្លូវការ អំពី ករណី បុរស ជនជាតិ ខ្មែរ អាយុ ៣៥ ឆ្នាំ នៅ ស្រុក មេសាង ស្លាប់ ដោយសារ កូវី ដ១៩
៥៖ ក្រសួង សុខាភិបាល ក្រើន រំលឹក ចុងក្រោយ ដល់ ម្ចាស់ សេវា ពិនិត្យ ព្យាបាល ជំងឺ ឯកជន ទាំងអស់ ក្នុង ការអនុវត្ត វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩
៧៖ រដ្ឋមន្រ្តី សុខាភិបាល ប្រាប់ អភិបាល រាជធានី - ខេត្ត ឱ្យ ត្រៀម បម្រុង ក្រុម គ្រូពេទ្យ ដើម្បី ថែទាំ និង ព្យាបាល អ្នកជំងឺ កូវីដ១៩ នៅ តាម ផ្ទះ
៨៖ នូវែលសេឡង់ - អូស្រ្តាលី នឹង អនុវត្ត គោលការណ៍ ធ្វើដំណើរ ដោយ មិន បាច់ ធ្វើចត្តាឡី ស័ក ជាមួយគ្នា ក្នុង ខែមេសា នេះ
៩៖ លោក គឹម សន្តិភាព៖ បុគ្គល មិន សហការ ជាមួយ មន្រ្តី សុខាភិបាល ដើម្បី យក វត្ថុ សំណាក ទៅ វិភាគរក មេរោគ កូវីដ - ១៩ ប្រឈម នឹង ការពិន័យ ពី ១លាន រៀល ដល់ ៥លាន រៀល
១០៖ កូរ៉េ ខាងជើង ប្រកាស មិន ចូលរួម ក្នុង ព្រឹត្តិការណ៍ កីឡា អូឡាំពិក ទីក្រុង តូក្យូ ដោយសារ បារម្ភ ពី កូវីដ - ១៩
១១៖ ស្នងការ រាជធានី ភ្នំពេញ បង្ហាញ លេខ ទូរស័ព្ទ ស្នងការ រង អធិការ ទាំង ១៤ និង នាយ ប៉ុស្តិ៍ ទាំង ១០៥ សម្រាប់ ប្រជាពលរដ្ឋ រាយការណ៍ បញ្ហា ផ្សេង ៗ
១៣៖ ៥ ថ្ងៃ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ចាក់ បាន ជាង ១៨ម៉ឺន នាក់
១៤៖ ប្រធានាធិបតី រុស្ស៊ី លោក ពូទីន ចុះហត្ថលេខា លើ ច្បាប់ ដែល អនុញ្ញាតឲ្យ រូប លោក អាច កាន់អំណាច រហូតដល់ ឆ្នាំ ២០៣៦
១៥៖ អារ៉ាប៊ី សាអូឌីត នឹង អនុញ្ញាតឲ្យ អ្នក ដែល បាន ចាក់ វ៉ាក់សាំង ឬ មាន ប្រព័ន្ធ ភាព សុំា ទប់ទល់ កូវីដ - ១៩ ចូលរួម ក្នុង ធម្មយាត្រា អ៊ុរ៉ស់
១៦៖ កង នាវា ចម្បាំង ចិន នឹង ធ្វើ សមយុទ្ធ ជាប្រចាំ នៅក្នុង ដែន ទឹក ក្បែរ កោះ តៃវ៉ាន់
១៧៖ អ្នកស្លាប់ ក្នុង គ្រោះ ទឹក ជំនន់ នៅ ឥណ្ឌូណេស៊ី និង ទីម័រ ខាងកើត កើន ដល់ ១៥៧ នាក់
២២៖ បទ វិភាគ អន្តរជាតិ៖ សហរដ្ឋ អាមេរិក ដាក់ទណ្ឌកម្ម . ចិន ជា អ្នក ប្រមូល ផល
៤៖ ចំណេះដឹង ទូទៅ៖ ស្វែងយល់ ពី ប្រវត្តិ ព្រែក ជីក ស៊ុយអេ ទី ដែល កប៉ាល់ យក្ស មួយ បាន គឿង ជាប់ នៅ ទីនោះ
បើ តាម រដ្ឋបាល ខេត្ត ស្វាយរៀង . បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ជា បុគ្គលិក កាស៉ី ណូ បាវិត - ម៉ុក បាយ ខាងលើ ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក សាមគ្គី រំដួល និង មណ្ឌល ព្យាបាល ជំងឺ កូវីដ - ១៩ ក្រុង បាវិត ។
ចិន ត្រូវបាន គេ មើលឃើញ ថា បាន បង្កើន ល្បឿន នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន ប្រជាជន របស់ ខ្លួន ជារៀងរាល់ ថ្ងៃ ។ ដោយ វ៉ាក់សាំង ជាង ០៦ លាន ដូស ត្រូវបាន ប្រើប្រាស់ ក្នុង រយៈពេល តែ ពីរ ថ្ងៃ ប៉ុណ្ណោះ ខណៈ ដែល ការសិក្សា ស្រាវជ្រាវ និង ការអភិវឌ្ឍន៍ ក្នុង វិស័យ ផលិត វ៉ាក់សាំង នៅក្នុង ប្រទេស ក៏ បាន រីកចម្រើន គួរឲ្យ កត់សម្គាល់ ផងដែរ ៕
សម្តេច តេជោ ហ៊ុន សែន ណែនាំ ឱ្យ បង្កើន ការចាក់ វ៉ាក់សាំង នៅ ភ្នំពេញ និង ខេត្ត កណ្តាល ដើម្បី បង្កើត ភាព ផ្សាំ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ណែនាំ ទៅ គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ឱ្យ រៀបចំ ផែនការ ឱ្យ ហើយ សម្រាប់ ការមកដល់ នូវ វ៉ាក់សាំង លើក ក្រោយ ដោយ ធ្វើ យ៉ាងណា បង្កើន ការចាក់ នៅ ភ្នំពេញ និង ខេត្ត កណ្តាល ព្រមទាំង តំបន់ តាម ផ្លូវ ជាតិ ចេញ ពី ភ្នំពេញ មាន កម្មករ និយោជិត ធ្វើ ការ ច្រើន ។ សម្រាប់ សម្តេច តេជោ ហ៊ុន សែន បង្កើន ការចាក់ វ៉ាក់សាំង នៅ ភ្នំពេញ និង ខេត្ត កណ្តាល នេះ ដើម្បី បង្កើន ភាពសាំ សម្រាប់ ពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បង្ហើប ពី តម្រុយ នៃ ការកំណត់ ជន ដែល ត្រូវ ចាក់ វ៉ាក់សាំង ផងដែរ ។ បើ តាម សម្តេច តេជោ ការចាក់ សម្រាប់ ជន អាទិភាព បាន ធ្វើ រួចហើយ ដូច្នេះ វ៉ាក់សាំង ដែល មក ក្រោយ នេះ នឹង ត្រូវ ចាក់ គ្រប់ បុគ្គល ទាំងអស់ ដែល មាន អាយុ និង សុខភាព ត្រូវ តាម លក្ខខណ្ឌ កំណត់ របស់ វ៉ាក់សាំង ។
កន្លងមក ការចាក់ វ៉ាក់សាំង នេះ កម្ពុជា បាន កំណត់ គោលការណ៍ ស្ម័គ្រចិត្ត ។ តែ ដើម្បី បង្កើត ភាពសុាំ ការចាក់ វ៉ាក់សាំង អាច ក្លាយទៅជា វ៉ាក់សាំង កាតព្វកិច្ច ដោយ មិន អាច ឈរ លើ គោលការណ៍ ស្ម័គ្រចិត្ត ទៀត នោះ ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា អ្នក ដែល មិន ចាក់ វ៉ាក់សាំង អាចនឹង ពិបាក រក ការងារ ធ្វើ ហើយក៏ អាចនឹង ក្លាយទៅជា អ្នក រើសអើង ពី អ្នក ចាក់ វ៉ាក់សាំង ផងដែរ ។
សម្តេច តេជោ បាន បញ្ជាក់ លើ បញ្ហា នេះ យ៉ាង ដូច្នេះ « បន្តិច ទៀត នៅលើ ពិភពលោក វ៉ាក់សាំង អាច ថា វ៉ាក់សាំង ក្លាយជា វ៉ាក់សាំង កាតព្វកិច្ច តែម្តង នេះ ការប្រមើមើល របស់ ខ្ញុំ ។ ខ្ញុំ គិត ថា អ្នក ដែល មិន បាន ចាក់ វ៉ាក់សាំង គឺជា អ្នក ដែល អភ័ព្វ អ្នក ដែល ពុំ មាន លទ្ធភាព ទទួលបាន ការងារ ធ្វើ ឬ ស្វាគមន៍ ពីសំណាក់ អ្នក បាន ទទួល វ៉ាក់សាំង ដែល បង្កើត ទៅជា ការរើសអើង » ។
ក្រៅតែ ពី ភូមិសាស្ត្រ ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ឱ្យ គណៈកម្មការ ចំពោះ កិច្ច ពិភាក្សា ជាមួយ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ពិនិត្យ លទ្ធភាព ចាត់ចែង នៅ តាម តំបន់ ស្ថិត នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៤ លេខ ២ លេខ ៣ និង តំបន់ ជាប់ ខេត្ត កណ្តាល ជាប់ ភ្នំពេញ ដទៃ ទៀត សុទ្ធសឹង ជា កន្លែង សម្បូរ ទៅ ដោយ កម្មករ និយោជិត ។
យោង តាម របាយការណ៍ របស់ គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង បាន ឱ្យដឹង ថា គិត ត្រឹម ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ កន្លងទៅ នេះ រាជធានី ភ្នំពេញ ចាក់ វ៉ាក់សាំង ជូន មន្ត្រី និង ជន អាទិភាព សរុប ជាង ៩ម៉ឺន នាក់ ហើយ ៕
ក្រសួង ការបរទេស ចេញ ប្រកាស ផ្លូវការ អំពី ជំនួប តាម ទូរស័ព្ទ រវាង សម្តេច តេជោ ហ៊ុន សែន ជាមួយ នាយក រដ្ឋមន្ត្រី ថ្មី របស់ វៀតណាម
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្រសួង ការបរទេស កម្ពុជា បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ខ្លឹមសារ ជំនួប តាម ទូរស័ព្ទ រវាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ជាមួយ លោក ផាម មិញ ជិញ នាយក រដ្ឋមន្ត្រី នៃ ប្រទេស វៀតណាម នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ ។
រដ្ឋបាល ខេត្ត សៀមរាប ដាក់ វិធានការ៣ ចំណុច ដើម្បី បង្ការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ខ្មែរ ខាងមុខ . អាជ្ញាធរ ប្រាប់ ពលរដ្ឋ បើ មិន ចាំបាច់ កុំ ចេញ ក្រៅ ផ្ទះ
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប បាន ចេញ សេចក្ដីណែនាំ ស្ដី វិធានការ បង្ការ និង ទប់ស្កាត់ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ អំឡុង ពេល ចូល ឆ្នាំ ប្រពៃណី ជាតិ នា ពេល ខាងមុខ នេះ ។ យោង តាម ខ្លឹមសារ ក្នុង លិខិត អាជ្ញាធរ ខេត្ត សៀមរាប បាន ណែនាំឲ្យ ប្រជាពលរដ្ឋ ជួបជុំ ក្រុមគ្រួសារ តាម គេហដ្ឋាន រៀង ៗ ខ្លួន ហើយ ចៀសវាង ការធ្វើដំណើរ ចេញ ក្រៅ ផ្ទះ ប្រសិនបើ មិន ចាំបាច់ ក៏ ដូចជា ចៀសវាង ការធ្វើដំណើរ ឆ្លង ខេត្ត ជាដើម ។
បន្ថែម ពី នេះ អាជ្ញាធរ ខេត្ត ប្រាប់ ដល់ ម្ចាស់ អាជីវកម្មដ្ឋាន សណ្ឋាគារ សេវាកម្ម ដ្ឋាន ភោជនីយដ្ឋាន ជាដើម ត្រូវ អនុវត្ត តាម វិធានការ សុខាភិបាល ពាក់ ម៉ាស់ និង រក្សា គម្លាត ស្រប តាម គោលការណ៍ និង វិធាន សុខាភិបាល ។ល ៕
ពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ទ្រាក់ ១១គ្រួសារ នៅ ស្រុក បន្ទាយ អំពិល ទទួលបាន អំណោយ សង្រ្គោះ បន្ទាន់ ពី កាកបាទ ក្រហម កម្ពុជា ខេត្ត ឧត្តរមានជ័យ
( ឧត្តរមានជ័យ )៖ លោក ឃិន ញ៉ាណ អភិបាល រង ខេត្ត ឧត្តរមានជ័យ និង ជា អនុប្រធាន អចិន្ត្រៃយ៍ គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ក្រុមការងារ នាំ អំណោយ មនុស្សធម៍ របស់ កាកបាទ ក្រហម កម្ពុជា ចុះ ផ្តល់ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ទ្រាក់ ខូចខាត ផ្ទះ សំបែង ចំនួន ១១គ្រួសារ នៅក្នុង ឃុំ ចំនួន ពីរ នៃ ស្រុក បន្ទាយ អំពិល ខេត្ត ឧត្តរមានជ័យ ។
លោក ឃិន ញ៉ាណ បាន ថ្លែង ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ក៏ ដូចជា លោក គន់ គីម ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហកម្ពុជា ខេត្ត លោក ប៉ែន កុសល្យ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ដែល ជានិច្ច ជាកាល តែង បាន គិតគូរ យកចិត្តទុកដាក់ ជានិច្ច ចំពោះ ប្រជាពលរដ្ឋ ក្រីក្រ និង ប្រជាពលរដ្ឋ ដែល ជួប នូវ គ្រោះថ្នាក់ ផ្សេង ៗ ។
លោក ឃិន ញ៉ាណ ក៏ បាន ចូលរួម សោកស្តាយ ជាមួយ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ខ្យល កន្ទ្រាក់ ទាំង ១១គ្រួសារ ធ្វើឱ្យ ខូចខាត ផ្ទះ សំបែង និង ទ្រព្យសម្បត្តិ ផ្សេង ៗ ។ គ្រោះថ្នាក់ គ្មាន អ្នកណា មើលឃើញ នោះ ទេ ហើយក៏ គ្មាន អ្នកណា ចង់ឱ្យ កើតមាន ដែរ សំខាន់ មិន មាន គ្រោះថ្នាក់ ដល់ សមាជិក គ្រួសារ នោះ គឺជា ការប្រសើរ ហើយ និង សូម កុំ អស់សង្ឃឹម ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី គឺ មិន ទុក ឱ្យ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភាពអត់ឃ្លាន ឫឯកោរ នោះ ឡើយ ។
លោក ឃិន ញ៉ាណ ក៏ បាន ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ការពារ ទប់ស្កាត់ កុំ ឱ្យ ឆ្លង ជំងឺ កូវីដ១៩ កើតមាន លើ ខ្លួន ឯង ក្រុមគ្រួសារ និង សហគមន៍ ដោយ ត្រូវ អនុវត្តន៍ វិធានការ ដ៏ មាន ប្រសិទ្ធិភាព គឺ ត្រូវ អនុវត្ត ឱ្យ បាន ទៀងទាត់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង អនុសាសន៍ ណែនាំ ដ៍ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន គឺ ៣កុំ និង ៣ការពារ ។
សូម បញ្ជាក់ ថា សម្ភារ ដែល ផ្តល់ ជូន នៅ ពេល នេះ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម មី១ កេស ត្រីខ១០ កំប៉ុង មុង១ សារ៉ុង១ ភួយ១ ក្រមា១ ទឹក ស៊ីអ៊ីវ១ យួរ អាវយឺត ចំនួន ៦។ ដោយឡែក ៣គ្រួសារ ដែរងគ្រោះ ធ្ងន់ធ្ងរ នៅ ឃុំ បេង ទទួលបាន សង្គ័ សី ចំនួន ៣០ សន្លឹក ពី ក្រុមការងារ ផងដែរ ៕ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ចាប់ផ្ដើម យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ថ្នាក់ដឹកនាំ មន្ដ្រីរាជការ និង អង្គភាព ចំណុះ ក្រសួង
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃអង្គារ ទី៦ ខែមេសា ឆ្នាំ ២០២១ នៅ ទីស្តីការ នៃ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចាប់ផ្ដើម បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ មន្ត្រី ជាប់ កិច្ចសន្យា នៃ ក្រសួង អាជ្ញាធរ ទន្លេ សាប និង គណៈកម្មាធិការ ជាតិ ទន្លេ មេគង្គ កម្ពុជា ដោយ ផ្អែក លើ គោលការណ៍ ស្ម័គ្រចិត្ត ដែល បាន និង កំពុង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ០៦ ដល់ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២១ ។
ដើម្បីឱ្យ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដំណើរការ ទៅ បាន ដោយ រលូន និង មាន សុវត្ថិភាព ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន រៀបចំ ទីតាំង ចាក់ វ៉ាក់សាំង ក្នុង ទីស្តីការ ក្រសួង ដោយ អនុវត្ត ទៅ តាម គោលការណ៍ ស្តង់ដារ និង វិធានការ កំណត់ របស់ ក្រសួង សុខាភិបាល ដើម្បី ធានា នូវ សុវត្ថិភាព សុខុមាលភាព ដល់ មន្ត្រី ដែល បាន ចូលរួម ចាក់ វ៉ាក់សាំង ។
សម្រាប់ ថ្នាក់ដឹកនាំ និង មន្រ្តី ទាំងអស់ ដែល ទទួលបាន នូវ វ៉ាក់ សាក់ រួចរាល់ ហើយ ក្តី ក៏ ត្រូវតែ បន្ត គោរព តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង គោលការណ៍ ណែនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន គឺ « ៣ការពារ និង ៣កុំ » ដើម្បី ចូលរួម យ៉ាង សកម្ម ជាមួយ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការបង្ការ និង ទប់ស្កាត់ ការរាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ ។
គួរ ជម្រាប ថា នៅ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២១ គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស នៃ ក្រសួង សុខាភិបាល បាន ចាប់ផ្ដើម យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ស៉ី ណូវ៉ាក់ (Sinovac) នៅ ទូទាំង ប្រទេស ជូន ប្រជាពលរដ្ឋ ដែល ស្ម័គ្រចិត្ត ហើយ ការចាក់ វ៉ាក់សាំង នេះ នឹង ធ្វើឡើង ជា បន្ដ បន្ទាប់ គ្រប់ ប្រជាពលរដ្ឋ ទាំងអស់ ។
វ៉ាក់សាំង កូវីដ១៩ ជា ឧបករណ៍ ថ្មី មួយ បន្ថែម លើ វិធានការ សុខាភិបាល ដែល មាន ស្រាប់ សម្រាប់ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ និង សង្គ្រោះ ជីវិត មនុស្ស ដោយ ជួយ បុគ្គល មិន ឲ្យ ឈឺ ធ្ងន់ នៅពេល ឆ្លង ជំងឺ កូវីដ១៩ និង ការកាត់បន្ថយ ការព្យាបាល នៅ មន្ទីរពេទ្យ ។
រាជ រដ្ឋាភិបាល បាន ធ្វើ ការអំពាវនាវ ជា បន្តបន្ទាប់ ដល់ ប្រជាជន ទូទាំង ប្រទេស ឲ្យ មក ទទួល ចាក់ វ៉ាក់សាំង កូវីដ១៩ ដោយ ស្ម័គ្រចិត្ត ហើយ បាន ជំរុញ និង ការពន្លឿន យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ធ្វើ យ៉ាងណា បាន ១លាន ដូស ក្នុង ខែ ជូន ដល់ បងប្អូន ប្រជាជន ក្នុង មូលដ្ឋាន រាជធានី - ខេត្ត ។
សារព័ត៌មាន Bloomberg ដោយ ផ្អែក លើ ប្រភព ដែល ខ្លួន ទទួលបាន បាន ឱ្យដឹង ទៀត ថា ប្រទេស អាល្លឺម៉ង់ បារាំង អ៉ីតាលី អេស្ប៉ាញ និង ហូឡង់ នឹង មាន វ៉ាក់សាំង គ្រប់គ្រាន់ ដើម្បី ចាក់ ជូន ប្រជាជន របស់ ខ្លួន ច្រើន ជាង ៥៥ភាគរយ នៅ ត្រឹម ខែមិថុនា ខាងមុខ ។
នាយ ឧត្តមសេនីយ៍ គីម ប៊ុន ថា ន ប្រាប់ ទាហាន ឈរជើង តាម ព្រំដែន សមរភូមិ ទិសទី១ ប្រាសាទ ព្រះវិហារ ត្រូវ ការពារ ខ្លួន កុំ ឲ្យ ឆ្លង ជំងឺ កូវីដ១៩
( ព្រះវិហារ ) ៖ នាយ ឧត្តមសេនីយ៍ គីម ប៊ុន ថា ន អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា នាយក រង ខុទ្ទកាល័យ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ថ្លែង ប្រាប់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ឈរជើង តាម ព្រំដែន នៅ សរ ភូមិ ទិសទី១ ប្រាសាទ ព្រះវិហារ ត្រូវ ការពារ ខ្លួន កុំ ឲ្យ ឆ្លង ជំងឺ កូវីដ១៩ បើ ទោះបីជា បាន ចាក់ វ៉ាក់សាំង ការពារ រួចហើយ ក៏ដោយ ។
ក្នុង ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ គីម ប៊ុន ថា ន បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ជានិច្ច ជាកាល សម្តេច តែង គិតគូរ យកចិត្ត ទុក្ខ ដាក់ ជានិច្ច ពី សុខ ទុក្ខ និង ការរស់នៅ របស់ កងទ័ព និង គ្រួសារ កងទ័ព ។
លោក ក៏ បាន ពាំនាំ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក ហូ សិទ្ធី នាយក ខុទ្ទកាល័យ សម្តេច តេជោ ហ៊ុន សែន . លោក ប្រាក់ វណ្ណឌី ក៏ ដូចជា សមាជិក ក្រុម លេខ ក្រុម ជំនួយការ និង អង្គភាព សម្ព័ន្ធ មេត្រី ផ្សេង ទៀត ដូចជា ឧត្តរម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ធានាគារ កាណាឌីយ៉ា ផងដែរ ។
លោក នាយ ឧត្តមសេនីយ៍ គីម ប៊ុន ថា ន បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក ក៏ បាន ថ្លែងអំណរគុណ តាមរយៈ លោក ផាន និម្មិត ជូន ចំពោះ លោក នាយក ខុទ្ទកាល័យ សម្តេច តេជោ ដែល ជានិច្ច ជាកាល លោក តែង គិតគូរ ដើម្បីឲ្យ ការមក សួរ សុខទុក្ខ នេះ បាន ធ្វើជា ទៀងទាត់ មួយ ឆ្នាំ ៣ដង ។
នាយ ឧត្តមសេនីយ៍ ក៏ បាន ថ្លែង កោតសរសើរ ដល់ នាយ និង ពល ទាហាន ទាំងអស់ ក្នុង វរសេនា តូច លេខ ៣៨៥ ដែល អនុវត្ត បាន ល្អ តាម ការណែនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ៣កុំ និង ៣ការពារ ក៏ ដូចជា វិធានការ របស់ ក្រសួង សុខាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
លោក ថា វ៉ាក់សាំង ការពារ ទោះបី បាន ចាក់ ហើយក៏ នៅតែ ឆ្លង ដែរ បើ យើង មិន បាន អនុវត្តន៍ វិធានការ ការពារ ឲ្យបាន ត្រឹមត្រូវ នេះ ហើយ លោក ក៏ ផ្តាំផ្ញើ ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ បន្ត រួម សាមគ្គីភាព ផ្ទៃក្នុង ឲ្យបាន ល្អ ។
ក្នុង ឱកាស ចម្រើន ជន្មាយុ គម្រប់ ៧០ ឈាន ចូល ៧១ ឆ្នាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា . នាយ ឧត្តមសេនីយ៍ គីម ប៊ុន ថា ន ព្រមទាំង នាយ និង ពល ទាហាន ទាំងអស់ សូម ប្រសិទ្ធ ពរ ជ័យ វិបុល សុខ គ្រប់ ប្រការ ជូន ចំពោះ សម្តេច តេជោ សូម មាន សុខភាព ល្អ អាយុ យ៉ឺន យូ កម្លាំង ពលំមាំ មួយ ប្រាជ្ញា ឈ្លាសវៃ ដើម្បី បន្ត ដឹកនាំ ប្រទេស កម្ពុជា អោយ ឆ្លង ផុត គ្រោះ ចង្រៃ ពី ជំងឺ កូវីដ១៩ ដើម្បី កសាង ប្រទេសជាតិ ឲ្យ មាន ការអភិវឌ្ឍន៍ រីកចម្រើន តទៅទៀត ។
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ស្នើ ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ចំណុះ សាលា ខេត្ត កំពត ទាំងអស់ សូម បន្ត សហការ ចូលរួម ជួយ កិច្ចការងារ សហការ និង ចេះ ស្រឡាញ់ គ្នា ប្រៀប ដូចជា បងប្អូន ក្នុង ក្រុមគ្រួសារ តែ មួយ ។
ក្នុង ឱកាស នោះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន ជូន ថវិកា ដល់ សមាជិក សមាជិកា ក្រុមប្រឹក្សា ខេត្ត ២៥ នាក់ ម្នាក់ ៗ ទទួលបាន ២០០ ដុល្លា និង មន្ត្រី ក្របខណ្ឌ សាលា ខេត្ត ១៣៧ នាក់ ក្នុង ម្នាក់ ១០០ ដុល្លា និង មន្ត្រី ជាប់ កិច្ចសន្យា និង នគរបាល ការពារ សាលា ខេត្ត ៦៥ នាក់ ក្នុង ម្នាក់ ទទួលបាន ថវិកា ចំនួន ៥០ ដុល្លា ៕
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល៖ ការសិក្សា គម្រោង អភិវឌ្ឍន៍ ផ្លូវ រថភ្លើង ក្រោម ដី លើក ដំបូង របស់ កម្ពុជា នឹង បញ្ចប់ នៅ ខែ ក្រោយ
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ថ្លែង ថា ការសិក្សា គម្រោង អភិវឌ្ឍន៍ ផ្លូវ រថភ្លើង ក្រោម ដី គ្រោង នឹង បញ្ចប់ ក្នុង រយៈពេល មួយ ខែ ខាងមុខ ទៀត នេះ ។
ខណៈ ដែល ការសិក្សា គម្រោង អភិវឌ្ឍន៍ ផ្លូវ រថភ្លើង ក្រោម ដី ដែល គ្រោង នឹង បញ្ចប់ ក្នុង រយៈពេល មួយ ខែ ខាងមុខ នេះ ទៀត នេះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ក៏ បាន ស្នើ ឱ្យ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ជួយ ពិនិត្យ ឡើងវិញ លើ លទ្ធផល នៃ គម្រោង សិក្សា ទាំងនេះ និង រៀបចំ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ផងដែរ ។
លោក ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល ធ្លាប់ បាន ថ្លែង បញ្ជាក់ ដែរ ថា ក្រសួង កំពុង សិក្សា គម្រោង នៃ ប្រព័ន្ធ ប្រតិបត្តិការ រថភ្លើង ស្វ័យប្រវត្តិ (AGT) ការសិក្សា គម្រោង Monorail និង គម្រោង ផ្លូវ រថភ្លើង ក្រោម ដី ដើម្បី ដាក់ ជូន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ធ្វើ ការពិនិត្យ និង ពិចារណា ជ្រើសរើស គម្រោង ណាមួយ ក្នុង ការដោះស្រាយ បញ្ហា កកស្ទះ ចរាចរណ៍ ក្នុង រាជធានី ភ្នំពេញ នា ពេល សព្វ ថ្ងៃ នេះ ។
កម្ពុជា បាន ខិតខំ អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ នានា ដើម្បី បង្ក ភាពងាយស្រួល ដល់ ការធ្វើចរាចរ របស់ ពលរដ្ឋ និង កាត់បន្ថយ ការកកស្ទះ ដែល បណ្តាល មកពី កំណើត យានយន្ត នៅ រាជធានី ភ្នំពេញ ក្នុង នោះ មាន ការសាងសង់ ស្ពាន អាកាស ស្ពាន អាកាស ថ្មើជើង ។ គម្រោង ផ្លូវ រថភ្លើង ក្រោម ដី ត្រូវបាន រំពឹង ថា នឹង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការដឹកជញ្ជូន និង កាត់បន្ថយ ការកកស្ទះ ផងដែរ ។
បើ តាម លោក ហ៊ាង សុទ្ធា យុត្តិ អ្នកនាំពាក្យ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ឱ្យដឹង ដែរ ថា ពាក់ព័ន្ធ នឹង គម្រោង អភិវឌ្ឍន៍ ផ្លូវ រថភ្លើង ក្រោម ដី នេះ គិត មកដល់ ពេលនេះ នៅ មិន ទាន់ មាន ព័ត៌មាន ល្អិត ណាមួយ ដែល អាច បញ្ជាក់ ច្បាស់ ពី ទំហំ ទឹកប្រាក់ និង ទីតាំង ច្បាស់លាស់ នៅឡើយ ទេ ដោយ រង់ចាំ ការសិក្សា ចប់ សព្វគ្រប់ តែម្តង ៕
លោក ធឹម សំអាន បាន ថ្លែង ថា ដោយ អនុវត្ត ទៅ តាម ការណែនាំ របស់ លោក ឃួង ស្រេង បាន ចុះ ធ្វើ សកម្មភាព បាញ់ ថ្នាំ សំលាប់ មេរោគ ក៏ ដូច បាញ់ ថ្នាំ មូស ក្នុង អគារ និង ក្រៅ បរិវេណ សាលា ខណ្ឌ តាម ដងផ្លូវ និង ទីតាំង មណ្ឌល ចត្តាឡី ស័ក ផងដែរ ។
លោក ធឹម សំអាន បាន បញ្ជាក់ ថា នេះ ជា យកចិត្តទុកដាក់ លើ សុខ មាលភាព និង សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ពីសំណាក់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដោយ បាន ឱ្យ សាលា ខណ្ឌ ចុះ បាញ់ ថ្នាំ សម្លាប់ មរោគ ជាប្រចាំ បាញ់ ថ្នាំ មូស ដើម្បី សុខ មាលភាព របស់ ប្រជាពលរដ្ឋ និង ដើម្បី ចូលរួម ទប់ស្កាត់ បង្ការ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ដែល កំពុង រាតត្បាត ក្នុង រាជធានី ភ្នំពេញ ។
លោក អភិបាល ខណ្ឌ បឹងកេងកង ក៏ បាន បញ្ជាក់ ផងដែរ ថា ពាក់ព័ន្ធ នឹង ការបាញ់ ថ្នាំ សម្លាប់ រោគ នេះ ដែរ មិន មែន ចេះតែ បាញ់ នោះ ទេ គឺ ត្រូវ កំណត់ ពី ពេលវេលា ដែល ត្រូវបាញ់ ទៅ តាម ជំនាញ របស់ សុខាភិបាល ៕
បទ អត្ថាធិប្បាយ៖ ប្រមូលផ្តុំ គ្រាប់ ពូជ ចំនួន ៤០លាន គ្រាប់ ដើម្បី កសាង អនាគត ! នេះ ជា រឿងរ៉ាវ អំពី ការរុករក និង សាប ព្រោះ ក្តីសង្ឃឹម
យប់ មួយ នា ឆ្នាំ ២០១៦ នៅ ក្រុង ឡាសា ភូមិភាគ ស៊ី ហ្សាំង ។ ដូច ពេល ធម្មតា លោក ជុង យ៉ាង បាន លេប ថ្នាំ បញ្ចុះ សម្ពាធ ឈាម និង ថ្នាំ បញ្ចុះ ជាតិ ខ្លាញ់ ក្នុង ឈាម រួចហើយ បាន បើក កំព្យូរ ទ័រ ចាប់ផ្តើម សរសេរ លិខិត ស្នើសុំ ទៅ តំបន់ ស៊ី ហ្សាំង ដោយ ស្ម គ្រចិត្ត ជា លើក ទី បី ។
លោក បាន និយាយ ជាមួយ ភរិយា ថា៖ « ទោះបី ខ្ញុំ មិន នៅ កូនសិស្ស ក៏ នឹង បន្ត ធ្វើ ការស្រាវ ជា្រវ ទៀត ។ ខ្ញុំ ចង់ បណ្តុះបណ្តាល ក្រុម បណ្ឌិត ជា ធនធាន មនុស្ស ជំនាញ ខ្ពស់ សម្រាប់ ការងារ អភិវឌ្ឍ ស៊ី ហ្សាំង » ។ ក្រោម ការជំរុញ របស់ លោក សកលវិទ្យាល័យ ស៊ី ហ្សាំង បាន បង្កើត កំណត់ត្រា ទី មួយ ជាច្រើន ជាពិសេស ការស្រាវជ្រាវ ជីវ ចម្រុះ ដែល ល្បី ឈ្មោះ លើ ឆាក អន្តរជាតិ ។
ដោយ៖ វិទ្យុ មិត្តភាព កម្ពុជា - ចិន
អភិបាល ខណ្ឌ ចំការមន សុំ ឱ្យ ប្រជាពលរដ្ឋ បង្កើន ការអនុវត្ត វិធានការ អនាម័យ និង ការការពារ ខ្លួន ពី កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ថេង សុថុល អភិបាល ខណ្ឌ ចំការមន បាន សុំឲ្យ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ខណ្ឌ ចំការមន បន្ត យកចិត្តទុកដាក់ អនុវត្ត នូវ វិធាន នានា របស់ ក្រសួង សុខាភិបាល ក្នុង ការការពារ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ ខណៈ នៅ កម្ពុជា បាន រកឃើញ អ្នកវិជ្ជមាន កូវីដ ជា បន្តបន្ទាប់ និង មាន អ្នកស្លាប់ ដោយសារ ជំងឺ នេះ ផងដែរ ដូច្នេះ ដើម្បី ការពារ កុំ ឱ្យ កូវីដ បន្ត ឆ្លង ក្នុង សហគមន៍ ទាំងអស់ គ្នា ចូលរួម ទាំងអស់ គ្នា អនុវត្ត តាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន គឺ « ៣ការពារ ៣កុំ » ។
លោក អភិបាល បាន ស្នើ ឡើង ដូចនេះ នៅ រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ ក្នុង ពិធី ចែក អំណោយ ដល់ ប្រជាពលរដ្ឋ ប៉ះពាល់ នៃ ព្រឹត្តិការ សហគមន៍ ២០កុម្ភៈ ដែល ខ្វះខាត ជីវភាព ចំនួន ២០ គ្រួសារ នៅ សង្កាត់ បឹងត្របែក នៅ បរិវេណ សាលា សង្កាត់ ។
ក្នុង ឱកាស នេះ លោក អភិបាល ខណ្ឌ ក៏ បាន បង្ហាញ ពី ការយកចិត្តទុកដាក់ ពីសំណាក់ លោក អភិបាល រាជធានី ភ្នំពេញ ដល់ បងប្អូន កំពុង ធ្វើចត្តាឡី ស័ក ដែល ជា អ្នករង ផល ប៉ះពាល់ នៃ ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ និង សូមឲ្យ បងប្អូន រក្សា អនាម័យ ខ្លួនប្រាណ ពាក់ ម៉ាស ឲ្យបាន ត្រឹមត្រូវ លាងសំអាត ដៃ ញឹកញាប់ រក្សា គំលាត ឲ្យបាន ឆ្ងាយ ពី គ្នា មុន ប្រើប្រាស របស់ អ្វី មួយ ត្រូវតែ លាងសំអាត ឲ្យបាន ស្អាត ល្អ បាញ់ អាល់កុល និង ត្រូវ ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ឲ្យបាន ទាន់ ពេលវេលាង ដែរ ។
លោក អភិបាល ខណ្ឌ បាន ទទូច សុំ កុំ ឲ្យ មាន ការជួបជុំគ្នា ជា ទ្រង់ទ្រាយ ធំ ណាមួយ រូម ទាំង ពិធី សាសនា នានា ផងដែរ ដើម្បី ទប់ស្កាត់ នូវ ការចម្លង ឬ ការរីករាលដាល នៃ ជំងឺ ប្រភេទ ថ្មី ៗ នៅក្នុង ប្រទេស កម្ពុជា ដូច ដែល ប្រមុខ រាជ រដ្ឋាភិបាល បាន ប្រកាស ប្រយុទ្ធ ប្រឆាំង ទប់ស្កាត់ ការរីករាកដាល នៃ ជំងឺ កូវីដ១៩ នេះ ដើម្បី សុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ។
លោក សុន សិទ្ធី នាយក រដ្ឋបាល ខណ្ឌ បាន បញ្ជាក់ ថា អំណោយ ដែល ចែកជូន ប្រជាពលរដ្ឋ ក្នុង ០១ គ្រួសារ រួម មាន៖ អង្ករ ចំនួន ០១ប៉ាវ ស្មើនឹង ២០ គីឡូក្រាម . មី ចំនួន ០១កេស . ទឹកត្រី ចំនួន ០១យួរ . ទឹកស៊ី អ៉ីវ ចំនួន ០១យួរ . ម៉ាស ចំនួន ១០. ទឹក បរិសុទ្ធ ចំនួន ០១កេស ៕
ការស្រង់ ខ្លឹមសារ អនុក្រឹត្យ លេខ ៣៧ របស់ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង យុត្តិធម៌ មក ពន្យល់ បែប នេះ ដោយសារ វិទ្យុ អាស៉ី សេរី (RFA) ដែល ជា វិទ្យុ បម្រើ បរទេស នៅ ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២១ បាន ផ្សាយ បំភ្លៃ ថា រាជ រដ្ឋាភិបាល បង្ខំ កម្មករ រោងចក្រ ឲ្យ ទៅ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ។
បើ តាម លោក គឹម សន្តិភាព . ការរៀបចំ ឲ្យ កម្មករ រោងចក្រ បាន ចាក់ វ៉ាក់សាំង កូវីដ១៩ ព្រោះ ពួកគេ ជា ក្រុម មនុស្ស ដែល ត្រូវ ទទួលបាន វ៉ាក់សាំង កូវីដ១៩ ជា ចាំបាច់ ដោយ ផ្អែក លើ ស្ថានភាព នៃ ការងារ ឬ ស្ថានភាព នៃ មុខរបរ របស់ ពួកគេ តាម ការកំណត់ របស់ ក្រសួង សុខាភិបាល ដូច មែន ចែង ក្នុង អនុក្រឹត្យ លេខ ៣៧ ជាធរមាន ស្រាប់ ។
សូម ជម្រាប ថា គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ នៃ ក្រសួង សុខាភិបាល កាលពី ព្រឹក ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២១ បាន ចាប់ផ្តើម បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ (SINOVAC) នៅក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស លើ ជន គោលដៅ ប្រមាណ ៧៤៥.០០០ នាក់ ។ ការបើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ស៉ី ណូវ៉ាក់ នេះ ធ្វើឡើង បន្ទាប់ពី កម្ពុជា ទិញ បាន វ៉ាក់សាំង ចំនួន ១. ៥លាន ដូស ពី ក្រុមហ៊ុន ចិន ហើយ ដឹក មកដល់ កម្ពុជា កាលពី ថ្ងៃទី ២៦ ខែមីនា កន្លងទៅ នេះ ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ គណៈកម្មការ ចំពោះ កិច្ច បាន គូសបញ្ជាក់ ថា ក្រុម ជន ដែល ត្រូវ ចាក់ វ៉ាក់សាំង ស៉ី ណូវ៉ាក់ នេះ រួម មាន៖
( ភ្នំពេញ ) ៖ លោកជំទាវ សុង ឡេង បូរ៉ា នាយិកា ពិធីការ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
លោកជំទាវ សុង ឡេង បូរ៉ា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម សុខ ប្រសិទ្ធិ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម សុខ ប្រសិទ្ធិ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន និង លោកជំទាវ គា ម៉ី ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម សុខ ប្រសិទ្ធិ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ផ្នែក ក្រសួង ស្ថាប័ន នៃ យុវជន ថ្នាក់ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា បរិច្ចាគ ថវិកា ១០. ២៤៩ ដុល្លារ ដល់ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) ដែល កំពុង ប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ផ្នែក ក្រសួង ស្ថាប័ន នៃ យុវជន ថ្នាក់ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ ដោយ លោក ជ្រុន ថេរ៉ាវ៉ាត បាន នាំយក ថវិកា ចំនួន ១០. ២៤៩ ដុល្លារ ដែល បាន មកពី ការបរិច្ចាក របស់ សមាជិក សមាជិកា ផ្នែក ចូលរួម ឧបត្ថម្ភ ដល់ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) ក្រោម ការដឹកនាំ របស់ លោក ហ៊ុន ម៉ាណែត ប្រធាន ក្រុមប្រឹក្សាភិបាល និង លោកស្រី ពេជ ចន្ទ មុន្នី អនុប្រធាន ក្រុមប្រឹក្សាភិបាល ។
ផ្នែក ក្រសួង ស្ថាប័ន នៃ យុវជន ថ្នាក់ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា សូម សម្តែង នូវ សេចក្តីគោរព និង កោតសរសើរ ដល់ វីរភាព ក្រុម គ្រូពេទ្យ កម្ពុជា ដែល បាន អនុវត្ត នូវ តួនាទី របស់ ខ្លួន យ៉ាង សកម្ម ក្នុង ការចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៨លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៨លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អ្នក ឧកញ៉ា ហេង ជាវ និង លោកជំទាវ កាយ ហូន ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា ហេង ជាវ ទីប្រឹក្សា សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន និង លោកជំទាវ កាយ ហួន ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
អ្នក ឧកញ៉ា ហេង ជាវ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្ដម ឧត្ដមសេនីយ៍ ឯក ប៉ោ វណ្ណៈ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្ដម ឧត្ដមសេនីយ៍ ឯក ប៉ោ វណ្ណៈ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង លោកជំទាវ ផង់ ចិន្តា ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្ដម ឧត្ដមសេនីយ៍ ឯក ប៉ោ វណ្ណៈ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស រុស្ស៉ី ត្រូវបាន ទីភ្នាក់ងារ ព័ត៌មាន រុស្ស៉ី អ៉ីនធើ ហ្វាកស៍ (Interfax) ដកស្រង់ សម្តី យ៉ាង ដូច្នេះ ថា « ផ្លូវ ឆ្ពោះ ទៅរក ការគំរាមកំហែង និង ការដាក់ សម្ពាធ ដូចជា ការប្រើប្រាស់ ទណ្ឌកម្ម ប្រឆាំង នឹង អាជ្ញាធរ មីយ៉ាន់ម៉ា បច្ចុបន្ន គឺ ពុំ មាន អនាគត នោះ ទេ ហើយ គ្រោះថ្នាក់ ជា ទីបំផុត ។ ទង្វើ បែប នេះ នឹង អាច រុញ ច្រាន ឲ្យ មីយ៉ាន់ម៉ា ធ្លាក់ ទៅក្នុង ការផ្ទុះ សង្រ្គាម ស៉ី វិល ទ្រង់ទ្រាយ ធំ តែម្តង ... » ។
គួរ បញ្ជាក់ ថា បណ្តា ម ហា អំណាច អន្តរជាតិ មួយចំនួន បាន ដាក់ទណ្ឌកម្ម លើ យោធា មីយ៉ាន់ម៉ា ដើម្បី ជា ការដាក់ សម្ពាធ ប៉ុន្តែ មក ទល់ ពេលនេះ ទាំង ទណ្ឌកម្ម និង ការទទូច ឲ្យ បញ្ឈប់ អំពើហិង្សា ដើម្បី ដោះស្រាយ បញ្ហា ដោយ សន្តិវិធី គឺ មិន បាន បង្ហាញ សញ្ញា ថា មាន ប្រសិទ្ធភាព ឡើយ ដោយ យោធា មីយ៉ាន់ម៉ា នៅតែ បន្ត ការបង្រ្កាប យ៉ាង ចាស់ ដៃ លើ ក្រុម បាតុករ ប្រឆាំង រដ្ឋប្រហារ ។ បើ តាម ក្រុម ឃ្លាំមើល សិទ្ធិ មនុស្ស នៅ មីយ៉ាន់ម៉ា មនុស្ស ច្រើន ជាង ៥៥០ នាក់ ហើយ បាន ស្លាប់ ៕
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ស្នើ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី តម្រង់ ទិស នៃ ការអភិវឌ្ឍ របស់ ខ្លួន ទៅ លើ តំបន់ ឆ្លងកាត់ ព្រំដែន របស់ កម្ពុជា
អាជ្ញាធរ ខេត្ត ស្វាយរៀង សម្រេច អនុវត្ត វិធានការ រដ្ឋបាល បណ្តោះអាសន្ន ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ត្រ ក្រុង បាវិត រយៈពេល ១២ ថ្ងៃ
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីសម្រេច អនុវត្ត វិធានការ រដ្ឋបាល ជា បណ្តោះអាសន្ន ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ត្រ ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន បញ្ជាក់ ថា ការដាក់ចេញ វិធានការ រដ្ឋបាល ជា បណ្តោះអាសន្ន នេះ មាន ថិរ វេលា អនុវត្ត រយៈពេល ១២ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ០៧ ដល់ ១៨ ខែមេសា ឆ្នាំ ២០២១ ហើយ ថិរ វេលា នេះ អាច ត្រូវបាន សម្រេច បន្ត ឬ បញ្ចប់ មុន ថិរ វេលា កំណត់ តាម ការជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង ៕
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង៖
ការិយាល័យ ព័ត៌មាន នៃ ក្រុមប្រឹក្សា កិច្ចការ រដ្ឋ ចិន ចេញផ្សាយ សៀវភៅ សស្តីពី « ការអនុវត្ត ជាក់ស្តែង របស់ ប្រទេស ចិន ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ របស់ មនុស្សជាតិ »
( ប៉េកាំង ) ៖ នៅ ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២១ ការិយាល័យ ព័ត៌មាន នៃ ក្រុមប្រឹក្សា កិច្ចការ រដ្ឋ ចិន បាន ចេញផ្សាយ សៀវភៅ សស្តីពី « ការអនុវត្ត ជាក់ស្តែង របស់ ប្រទេស ចិន ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ របស់ មនុស្សជាតិ » ។
សៀវភៅ ស បាន បង្ហាញ ថា ការលុបបំបាត់ ភាពក្រីក្រ បាន ផ្លាស់ប្តូរ មុខមាត់ ជនបទ នៃ ប្រទេស ចិន ជា ប្រវត្តិសាស្ត្រ ហើយ ជា បដិវត្តន៍ ដ៏ អស្ចារ្យ មួយ ទៀត នៅក្នុង តំបន់ ជនបទ នៃ ប្រទេស ចិន ដែល បាន ជំរុញ យ៉ាង ខ្លាំង ដល់ ការអភិវឌ្ឍ ជាទូទៅ នៃ តំបន់ ជនបទ របស់ ប្រទេស ចិន ហើយ បាន ចាក់ គ្រឹះ ដ៏ រឹងមាំ សម្រាប់ ការកសាង ប្រទេស សង្គម និយម ទំនើប ដោយ គ្រប់ ជ្រុងជ្រោយ និង សម្រេច គោលដៅ នៃ ការតស៊ូ « មួយ សតវត្សរ៍ ទី២» ។
ក្រុមហ៊ុន នេះ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
OKNHA LY PAO កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គួរ បញ្ជាក់ ថា យោង តាម ស្ថិតិ ឆ្នាំ ២០១៨ ជនជាតិ នូវែលសេឡង់ ដែល រស់ នៅក្នុង ប្រទេស អូស្រ្តាលី មាន ចំនួន ៥៦៨.០០០ នាក់ គឺ ស្មើនឹង ២.៣ភាគរយ នៃ ចំនួន ប្រជាជន អូស្រ្តាលី សរុប ហើយ ជា សហគមន៍ ជន ចំណាកស្រុក ធំ ជាង គេ លំដាប់ ទី០៤ របស់ ប្រទេស អូស្រ្តាលី ។ សម្រាប់ ការធ្វើ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ មាន ទំហំ ១៨ ពាន់ លាន ដុល្លារ ដែល ធ្វើឲ្យ អូស្រ្តាលី ជា ដៃគូ ពាណិជ្ជកម្ម ធំ បំផុត របស់ នូវែលសេឡង់ ៕
តាម សេចក្តីប្រកាស បាន ឱ្យដឹង ថា ពលរដ្ឋ ខ្មែរ ដែល ទទួលមរណភាព នេះ ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ ត្រូវបាន បញ្ជូន ចូល សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត កាលពី វេលា ម៉ោង ១០៖២០ នាទី ព្រឹក ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ ក្នុង ស្ថានភាព សន្លប់ បាត់ ស្មារតី និង គ្មាន សញ្ញា ជីវិត ប៉ុន្តែ នៅតែ ទៅ មិន អាច ជួយសង្គ្រោះ អ្នកជំងឺ ឱ្យ រួចផុត ពី សេចក្តីស្លាប់ បាន ។
ក្រសួង បាន បន្ត ថា ដោយ មាន ការសង្ស័យ ក្រុម គ្រូពេទ្យ បាន យក សំណាក របស់ សព ដើម្បី ធ្វើ ការវិភាគរក វីរុស កូវីដ១៩ ជា លទ្ធផល បាន បញ្ជាក់ ថា សព មាន វិជ្ជមាន ជំងឺ កូវីដ១៩ ។
ជា ការសន្និដ្ឋាន របស់ ក្រុម គ្រូពេទ្យ គឺ បុរស ខាងលើ បាន ស្លាប់ មុនពេល ចូល ទៅដល់ មន្ទីរពេទ្យ ដោយសារ ជំងឺ កូវីដ១៩ ។
លោក កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ក្រសួង សង្គមកិច្ច បញ្ចប់ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន មន្រ្តី រាជការ ជាង ១ ពាន់ នាក់ សម្រាប់ ដូស ទី១
( ភ្នំពេញ ) ៖ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ប្រកាស បិទ បញ្ចប់ ការចាក់ វ៉ាក់សាំង ជូន មន្រ្តី រាជការ សម្រាប់ ការចាក់ដូសទី១ នា ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ ។
យុទ្ធនាការ រយៈពេល ៦ ថ្ងៃ នៃ ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ នេះ បាន ប្រព្រឹត្តទៅ ដោយ ល្អ ហើយ ជា លទ្ធផល ចាក់ ជូន មន្ត្រី បាន ចំនួន ១០៨១ នាក់ ។ លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច បាន ថ្លែងអំណរគុណ ដល់ ក្រុមការងារ និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ និង ចូលរួម ធ្វើឱ្យ ដំណើរការ នៃ ការចាក់ វ៉ាក់ នា ពេលនេះ ទទួលបាន លទ្ធផល ល្អ ។
បើ តាម ការបញ្ជាក់ ពី លោក ជា ចំណាន ប្រធាន អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង ជូន មន្ត្រី ក្រសួង សង្គមកិច្ច ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន ថា មន្រ្តី រាជការ ដែល បាន ចាក់ វ៉ាក់ស៊ីណូ វ៉ាក់ លើក ទី១ ហើយ ត្រូវ ត្រលប់ ទៅ ចាក់ដូស ទី ២ ក្នុង ចន្លោះ ១៤ ថ្ងៃ ទៅ ២៨ ថ្ងៃ ហើយ ចាក់ លើក ទី ១ នៅ កន្លែងណា ត្រូវ ទៅ ចាក់ លើក ទី ២ នៅ កន្លែង នោះ ដដែល ។
សូម ជម្រាប ថា រាជ រដ្ឋាភិបាល កម្ពុជា មាន គោលដៅ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ជូន ប្រជាជន ចំនួន ១០ លាន់ នាក់ ពី ក្នុង ចំណោម ចំណោម ប្រជាជន សរុប ជិត ១៦ លាន នាក់ ។
នៅក្នុង ឱកាស បោះ ដែរ លោក វង សូត ក៏ បាន ឧបត្ថម្ភ ថវិកា ៦ លាន រៀល ដល់ ក្រុមការងារ គ្រូពេទ្យ ១១ នាក់ ដែល បាន បំពេញ ការងារ យ៉ាង យកចិត្តទុកដាក់ នៅក្នុង ក្រសួង សង្គមកិច្ច រយៈពេល ៦ ថ្ងៃ នេះ ផងដែរ ៕
ឯក អគ្គ រដ្ឋទូត ថ្មី របស់ សិង្ហបុរី ប្រចាំ កម្ពុជា ជួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ
នៅក្នុង ជំនួប នេះ ទាំង លោកស្រី ឯក អគ្គ រដ្ឋទូត សិង្ហបុរី និង ទាំង លោក រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ បាន វាយតម្លៃ ខ្ពស់ ប្រកបដោយ ក្ដី សោមនស្ស រីករាយ ចំពោះ លទ្ធផល នៃ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ក៏ ដូចជា កិច្ចសហប្រតិបត្តិការ ក្នុង ក្របខណ្ឌ អាស៊ាន រវាង ប្រទេស ទាំង ពីរ កម្ពុជា និង សិង្ហបុរី ។
ទន្ទឹម នឹង នោះ ផ្អែក លើ សំណូមពរ របស់ កម្ពុជា លោកស្រី ឯក អគ្គ រដ្ឋទូត សិង្ហបុរី ក៏ បាន សន្យា នឹង ខិតខំ ជំរុញ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី នេះ ឱ្យ ដល់ កម្រិត ថ្នាក់ ស្ថាប័ន រដ្ឋ ទទួលបន្ទុក វិស័យ មុខងារ សាធារណៈ ជា បន្ត ទៅ ទៀត សំដៅ រួមចំណែក ដល់ ការពង្រឹង ទំនាក់ទំនង មិត្តភាពល្អ ប្រសើរ រវាង រដ្ឋាភិបាល និង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ កម្ពុជា - សិង្ហបុរី ៕
លោក ឧកញ៉ា ជឹង ធាន សេង និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា ជឹង ធាន សេង និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
លោក ឧកញ៉ា និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឃាតក សម្លាប់ ក្មេងប្រុស អាយុ១០ ឆ្នាំ នៅ ខណ្ឌ ច្បារអំពៅ ត្រូវ ចាប់ខ្លួន បាន ហើយ ជា បង ថ្លៃ ជីដូនមួយ . មូលហេតុ ដោយសារ ខឹង ជនរងគ្រោះ វាយ ក្បាល
( ភ្នំពេញ ) ៖ ឃាតក សម្លាប់ ក្មេងប្រុស អាយុ១០ ឆ្នាំ កាលពី ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២១ ហើយ គេ ប្រទះឃើញ សព នៅក្នុង ព្រៃ តាម បណ្ដោយ ផ្លូវ ថៃ ហ្គ័រ ស្ថិត ក្នុង ភូមិ បោះ អង្កាញ់១ សង្កាត់ ព្រែក ឯង ខណ្ឌ ច្បារអំពៅ ត្រូវ កម្លាំង នគរបាល ជំនាញ ស្រាវជ្រាវ បាន ហើយ នៅ យប់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ នៅ វត្ត ជ្រោយ អំពិល ស្ថិត ក្នុង ភូមិ ជ្រោយ អំពិល សង្កាត់ ក្បាល កោះ ខណ្ឌ ច្បារអំពៅ ។
នៅ ចំពោះ មុខ មន្ដ្រី នគរបាល ជំនាញ ជន ដៃ ដល់ បាន សារភាព ថា ខ្លួន ពិតជា បាន សម្លាប់ ជនរងគ្រោះ ប្រាកដ មែន ដោយ មូលហេតុ ខឹង ជនរងគ្រោះ វាយ ក្បាល ២ដង គ្រា ដែល ខ្លួន តំណម មិន ឲ្យ នរណា វាយ ក្បាល នោះ ទេ ដូច្នេះហើយ ដោយ ប្រាប់ ទៅ ជនរងគ្រោះ មិន ស្ដាប់ ជន ដៃ បាន ធ្វើ សកម្មភាព វាយ សម្លាប់ ជនរងគ្រោះ តែម្ដង ។
គួរ ជម្រាប ថា ប្រតិបត្តិការ នេះ ធ្វើឡើង ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នង នគរបាល ជាតិ និង មាន ការចង្អុលបង្ហាញ ពី លោក ឧត្តមសេនីយ៍ ឯក អ៉ិន បូរ៉ា អគ្គ ស្នងការ រង ទទួល ផែន និង លោក ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ និង លោក ឧត្តមសេនីយ៍ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ។
ក្នុង រង្វង់ ប្រតិបត្តិការ ស្រាវជ្រាវ រហូត ឈានដល់ ការបង្ក្រាប បាន ជន ដៃ ដល់ នៅ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ ដោយ កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ទោ ជា វ វិបុល អនុប្រធាន នាយកដ្ឋាន ដឹកនាំ សហការ ជាមួយ កម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ ច្បារអំពៅ . ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ និង អង្គការ CPU ។
គួរ ជម្រាប ថា ក្មេងប្រុស អាយុ១០ ឆ្នាំ បាត់ ពី ផ្ទះ ប៉ុន្មាន ត្រូវ គេ ប្រទះឃើញ សព នៅក្នុង ព្រៃ បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២១ នៅ តាម បណ្ដោយ ផ្លូវ ថៃ ហ្គ័រ ស្ថិត ក្នុង ភូមិ បោះ អង្កាញ់១ សង្កាត់ ព្រែក ឯង ខណ្ឌ ច្បារអំពៅ សង្ស័យ ជា ករណី ឃាតកម្ម ។ ក្មេងប្រុស រងគ្រោះ ត្រូវបាន គេ ស្គាល់ ឈ្មោះ ជា ប៊ុន ហេង រស់ នៅ ភូមិ ជ្រោយ អំពិល សង្កាត់ ក្បាល កោះ ។
ក្នុង រយៈពេល ដ៏ ខ្លី អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា និង លោកស្រី បាន បរិច្ចាគ ថវិកា សរុប ជិត ១០លាន ដុល្លារ ជួយ ដល់ សង្គមជាតិ
( ភ្នំពេញ ) ៖ គិត ចាប់ពី ថ្ងៃទី ១០ ខែធ្នូ ឆ្នាំ ២០២០ ដល់ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ មហាជន បាន សង្កេតឃើញ ថា អ្នក ឧកញ៉ា វ័យ ក្មេង ឡេង ណា វ៉ា ត្រា បាន បរិច្ចាគ ថវិកា ជួយ ដល់ សង្គមជាតិ ជិត ១០លាន ដុល្លារ ខណៈ ទឹកចិត្ត សប្បុរស នេះ គឺ ត្រូវបាន ធ្វើឡើង ក្នុង ពេល ដែល សង្គមជាតិ ជួប ការខ្វះខាត ក៏ ដូចជា ការបង្ហាញ នូវ ឆន្ទៈ មួយ ក្នុង ការចូលរួមចំណែក ជាមួយ រដ្ឋាភិបាល ។
ខាងក្រោម នេះ គឺជា កាលបរិច្ឆេទ និង ចំនួន ថវិកា សប្បុរសធម៌ ដែល អ្នក ឧកញ៉ា ចិត្ត ធម៌ វ័យ ក្មេង និង លោកជំទាវ បាន លះបង់ ធនធាន ផ្ទាល់ខ្លួន ចូលរួម ជាមួយ រដ្ឋាភិបាល និង ជួយ សង្គមជា តិ៖
ទី ១៖ ថ្ងៃទី ថ្ងៃទី ១០ ខែធ្នូ ឆ្នាំ ២០២០ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា និង លោកស្រី បាន បរិច្ចាគ ចំនួន ១លាន ដុល្លារ តាមរយៈ លោក សេង ទៀង ជូន សម្ដេច តេជោ ហ៊ុន សែន ដើម្បី ចូលរួម ទិញ វ៉ាក់សាំង វ៉ាក់សាំង កូវីដ១៩ ចាក់ ជូន ពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ទី ២៖ ថ្ងៃទី ១៣ ខែមីនា ឆ្នាំ ២០២១ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា និង លោកស្រី បាន បរិច្ចាគ ជូន សម្ដេច តេជោ ហ៊ុន សែន ចំនួន ៣លាន ដុល្លារ ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ដើម្បី ចាក់ ជូន ពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ទី ៤៖ ថ្ងៃ ២៧ ខែមីនា ឆ្នាំ ២០២១ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា និង លោកស្រី បាន បរិច្ចាគ ថវិកា ចំនួន ៣. ៥លាន ដុល្លារ តាមរយៈ សម្ដេច តេជោ ដើម្បី ទិញ មន្ទីរពេទ្យ នគរ ទេព សម្រាប់ ព្យាបាល បងប្អូន កើត ជំងឺ កូវីត១៩ ។
ទី ៥៖ នៅ ថ្ងៃទី ០៥ ខែមេសា ឆ្នាំ ២០២១ អ្នក ឧកញ៉ា ឡេង ណា វ៉ា ត្រា និង លោកស្រី ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ១.៤លាន ដុល្លារ ជូន ដល់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដើម្បី ចូលរួម ក្នុង ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ខួប លើក ទី១៥៨ ។
( ភ្នំពេញ ) ៖ លោកជំទាវ ឧកញ៉ា រង ឈុន នី អគ្គ នាយិកា ក្រុមហ៊ុន លី ឃី ហ៊ួត ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
លោកជំទាវ ឧកញ៉ា រង ឈុន នី កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោកជំទាវ ឧកញ៉ា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម បណ្ឌិត ឈុន ស៊ី រុន និង លោកជំទាវ អៀន វុឌ្ឍី ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត ឈុន ស៊ី រុន និង លោកជំទាវ អៀន វុឌ្ឍី ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម បណ្ឌិត ឈុន ស៊ី រុន និង លោកជំទាវ អៀន វុឌ្ឍី កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម សួង ម៉េង គា រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ឧបត្ថម្ភ ថវិកា ៣ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម សួង ម៉េង គា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
កាលពី ស. វទី ២០ ការដាក់ទណ្ឌកម្ម អាច ជា វិធានការ មួយ មាន ប្រសិទ្ធភាព ព្រោះ នៅ ពេល នោះ សហរដ្ឋ អាមេរិក ជា មហាអំណាច ទាំង យោធា និង សេដ្ឋកិច្ច ផុត លេខ ដែល សឹងតែ គ្មាន គូ ប្រៀប ។ ប៉ុន្តែ បច្ចុប្បន្ន មាន មហា អំណាច ជាច្រើន ក្នុង នោះ រួម មាន ទាំង ចិន បាន លេច មុខមាត់ ឡើង នៅលើ ឆាក អន្តរជាតិ ហើយ សូម្បីតែ រដ្ឋបាល លោក ចូ បៃ ដិន ក៏ បាន ទទួលស្គាល់ ដែរ ថា « ចិន ជា គូ ប្រជែង ភូមិសាស្ត្រ នយោបាយ ដ៏ ធំ បំផុត របស់ សហរដ្ឋ អាមេរិក » នៅក្នុង ស. វទី ២១ នេះ ។
* អាមេរិក អ្នក ដាក់ទណ្ឌកម្ម ចិន ជា អ្នក ប្រមូល ផល
គួរ បញ្ជាក់ ថា ការដាក់ទណ្ឌកម្ម គឺជា ឧបករណ៍ ការទូត ដែល ត្រូវបាន គេ សង្កេតឃើញ ថា អាមេរិក ប្រើប្រាស់ ជាទូទៅ នៅពេល ត្រូវ ដោះស្រាយ ជាមួយ ប្រទេស ទាំងឡាយ ណា ដែល មិន អាច វាយ បក ឬ ដាក់ទណ្ឌកម្ម ធ្វើឱ្យ ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ ផលប្រយោជន៍ អាមេរិក វិញ តែ ប៉ុណ្ណោះ ។ រីឯ ក្រុម អ្នកជំនាញ ភាគ ច្រើន ក៏ យល់ ដែរ ថា ការដាក់ទណ្ឌកម្ម មិន មែន ជា មធ្យោបាយ មាន ប្រសិទ្ធភាព នោះ ទេ ហើយ ជា ទម្លាប់ អ្នក ដែល រងគ្រោះ ពី ទណ្ឌកម្ម គឺជា ប្រជាជន ស៊ីវិល ធម្មតា ពោលគឺ មិន មែន ជា មេដឹកនាំ របស់ ពួកគេ ឡើយ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម រស់ វណ្ណា រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម រស់ វណ្ណា និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
រដ្ឋមន្រ្តី សុខាភិបាល ប្រាប់ អភិបាល រាជធានី - ខេត្ត ឱ្យ ត្រៀម បម្រុង ក្រុម គ្រូពេទ្យ ដើម្បី ថែទាំ និង ព្យាបាល អ្នកជំងឺ កូវីដ១៩ នៅ តាម ផ្ទះ (Video inside) ( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល កម្ពុជា នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ លិខិត មួយ ប្រាប់ ដល់ អភិបាល រាជធានី - ខេត្ត ទាំងអស់ ឱ្យ ត្រៀម បម្រុង ក្រុម គ្រូពេទ្យ ដើម្បី ថែទាំ និង ព្យាបាល អ្នកជំងឺ កូវីដ១៩ នៅ តាម ផ្ទះ ក្នុង មូលដ្ឋាន ។
លិខិត របស់ រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល បាន ធ្វើឡើង បន្ទាប់ពី មាន អនុសាសន៍ ណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ឱ្យ ក្រសួង សុខាភិបាល និង អ្នក ពាក់ព័ន្ធ គិតគូរ រៀបចំ ទុក ជាមុន ពី លទ្ធភាព ផ្តល់ ការព្យាបាល នៅ តាម ផ្ទះ សម្រាប់ អ្នកជំងឺ កូវីដ១៩ ដែល មាន ស្ថានភាព ស្រាល ។
លិខិត របស់ លោក រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា ដើម្បី ជួយ សម្រាល បន្ទុក មន្ទីរពេទ្យ រដ្ឋ នានា ក្នុង រាជធានី - ខេត្ត ក្រសួង ស្នើ ឱ្យ ត្រៀម បម្រុង បង្កើត ក្រុម គ្រូពេទ្យ ថែទាំ និង ព្យាបាល នៅ តាម ផ្ទះ សម្រាប់ អ្នកជំងឺ កូវីដ១៩ ដែល គ្មាន រោគសញ្ញា និង ករណី ជំងឺ ស្រាល ក្នុង លក្ខខណ្ឌ ដែល មាន ការរាតត្បាត ធ្ងន់ធ្ងរ ជា យថាហេតុ ដែល ហួស ពី ចំណុះ មន្ទីរពេទ្យ រដ្ឋ ឬ កន្លែង ព្យាបាល ដែល រាជធានី - ខេត្ត នីមួយ បាន រៀបចំ រួចជាស្រេច ហើយ ។
លោក ម៉ម ប៊ុន ហេង បាន បន្ថែម ថា ការត្រៀម បម្រុង នេះ ត្រូវ យក ក្រុម គ្រូពេទ្យ នៅ តាម មូលដ្ឋាន សុខាភិបាល ផ្ទាល់ របស់ ខ្លួន ដោយ រៀបចំ ជា ក្រុម និង ដឹកនាំ ដោយ ប្រធាន ការិយាល័យ សុខាភិបាល ស្រុក ប្រតិបត្តិ ។
ក្រសួង សុខាភិបាល នឹង ធ្វើ ការបណ្តុះបណ្តាល ក្រុម គ្រូពេទ្យ ទាំងនោះ ដោយ អនុវត្ត តាម នីតិវិធី ប្រតិបត្តិ ស្តង់ដារ (SOP) ដែល ក្រសួង នឹង រៀបចំ ជូន ។ នេះ បើ តាម ការបញ្ជាក់ បន្ថែម ទៀត របស់ លោក ម៉ម ប៊ុន ហេតុ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ធ្វើ ការណែនាំ ថ្មី មួយ ដោយ ឱ្យ ក្រសួង សុខាភិបាល និង អ្នក ពាក់ព័ន្ធ គិតគូរ និង រៀបចំ ទុក ជាមុន ពី លទ្ធភាព ផ្តល់ ការព្យាបាល នៅ តាម ផ្ទះ សម្រាប់ អ្នកជំងឺ កូវីដ១៩ ដែល មាន ស្ថានភាព ស្រាល ។
ក្នុង សារ សំឡេង ដែល ត្រូវា បាន ចែកចាយ លើ បណ្តាញ សង្គម នា ព្រឹក ថ្ងៃទី ០៦ ខែមេសា សម្តេច តេជោ បាន ចាត់ទុក នេះ គឺជា ការគិតគូរ និង ជា ការរៀបចំ ផែនការ ទុក ជាមុន ក្នុង ករណី អ្នកជំងឺ កើនឡើង កាន់តែ ច្រើន ហើយ មិន អាច មាន ទីតាំង សម្រាប់ ព្យាបាល ។
ការផ្តួចផ្តើម ឱ្យ គិតគូរ ព្យាបាល ជំងឺ តាម ផ្ទះ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង បន្ទាប់ពី ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ នៅតែ បន្ត កើនឡើង ។
ខាងក្រោម នេះ ជា លិខិត របស់ រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល៖ ប្រធាន សមាគម សហគ្រិន វ័យ ក្មេង ខេត្ត សៀមរាប ដឹកនាំ សមាជិក ចូលរួម ចាក់ វ៉ាក់សាំង កូវីដ១៩
( សៀមរាប ) ៖ នៅ ព្រឹក ថ្ងៃទី ៦ ខែមេសា ប្រធាន សមាគម សហគ្រិន វ័យ ក្មេង ខេត្ត សៀមរាប បាន ដឹកនាំ សមាជិក នៃ សមាគម ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដែល ធ្វើឡើង នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ។
លោក ថោង ប៊ុន ថា រី លើកឡើង ទៀត ថា ការទទួល វ៉ាក់សាំង បង្ការ នៅ ពេល នេះ គឺ អាច ជួយ ការពារ សង្គម គ្រួសារ រួម និង បុគ្គលិក ទាំងអស់ ឲ្យ ជៀស ឆ្ងាយ ពី ជំងឺ កូវីដ១៩ ដែល កំពុង យាយី ជា សាកលលោក ។ យ៉ាងណា ក៏ដោយ បើ ទោះបី បាន ចាក់ វ៉ាក់សាំង រួច ក៏ ពិត មែន តែ លោក ប្រធាន សមាគម សហគ្រិន វ័យ ក្មេង ខេត្ត សៀមរាប ប្រាប់ ថា រូប លោក ក៏ ដូចជា សមាជិក ទាំងអស់ នឹង បន្ត អនុវត្ត វិធានការ សុខាភិបាល ពិសេស គោរព ទៅ តាម ប្រសាសន៍ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល គឺ ៣កុំ ៣ការពារ ដើម្បី ធានា បាន ថា មិន ប្រឈម នឹង ការឆ្លង ជំងឺ កូវីដ១៩ ។
ក្នុង នោះ ដែរ ជា ប្រជាពលរដ្ឋ មួយ រូប លោក ថោង ប៊ុន ថា រី បាន អំពាវនា ដល់ ប្រជាវ ពលរដ្ឋ ទាំងអស់ ក្នុង ប្រទេស កម្ពុជា សូម មាន ការជឿជាក់ លើ វ៉ាក់សាំង កូវីដ១៩ ហើយ ការចាក់ វ៉ាក់សាំង គឺ ដើម្បី ការពារ ខ្លួន ឯង គ្រួសារ ក៏ ដូចជា ជួយ សង្គមជាតិ ឲ្យ ឆាប់ វិលត្រឡប់មក ដូច សភាព ដើម វិញ នា ពេល អនាគត និង ស្ដារ សេដ្ឋកិច្ច យើង ឡើងវិញ ៕ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន យក ទៅ ប្រគល់ ជូន ពលរដ្ឋ ជិត ២០០ គ្រួសារ ដែល កំពុង ធ្វើចត្តាឡី ស័ក នៅ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន
លោក ឃួង ស្រេង បាន លើកឡើង ថា សម្ដេច តេជោ ហ៊ុន សែន បាន យកចិត្តទុកដាក់ ខ្លាំង ណាស់ ចំពោះ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ។ ជាក់ស្តែង នៅ ពេល នេះ ខណៈ ដែល ទទួលបាន ព័ត៌មាន ពី បងប្អូន ដែល កំពុង ធ្វើចត្តាឡី ស័ក នៅ ភូមិ ១៦ ក្នុង សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការ មន នេះ សម្តេច បាន ឲ្យ អាជ្ញាធរ រាជធានី ភ្នំពេញ ចុះ ពិនិត្យមើល ស្ថានភាព ជាក់ស្តែង និង នាំយក នូវ ថវិកា ស្បៀងអាហារ មួយចំនួន មក ចែកជូន ភ្លាម ៗ តែម្តង បើ ទោះបី នៅ ពេល យប់ ក៏ដោយ ។
លោក បន្ត ទៀត ថា សម្ដេច តេជោ ហ៊ុន សែន នៅតែ ជា ជួរ មុខ ក្នុង ការជួយ ដល់ ប្រជាពលរដ្ឋ បើ ទោះបី ស្ថិត ក្នុង កាលៈទេសៈ បែប ណា ក៏ដោយ ។ ជាក់ស្តែង ខណៈ ដែល បងប្អូន ជួប ការលំបាក ក្នុង ជីវភាពពេល កំពុង ធ្វើចត្តាឡី ស័ក នេះ គឺ សម្តេច បាន ណែនាំឲ្យ ចុះ ជួយ ភ្លាម ៗ ។
ជាមួយគ្នា នេះ លោក ឃួង ស្រេង សូមឲ្យ ប្រជាពលរដ្ឋ មាន ការយោគយល់ ចំពោះ ការបិទ ភូមិ មួយ នេះ មិន ឲ្យ ចេញ ចូល ដោយសារតែ នេះ ជា វិធាន របស់ ក្រសួង សុខាភិបាល ដើម្បី បង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ ប្រទេស ណា ក៏ គេ ធ្វើ ដូច្នេះ ដែរ សំដៅ ធ្វើ យ៉ាងណា កុំ ឲ្យ ជំងឺ នេះ រាលដាល កាន់តែ ខ្លាំង ។
គួរ ជម្រាប ថា លោក ថេង សុថុល អភិបាល ខណ្ឌ ចំការមន បាន បញ្ជាក់ ថា ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិ ទី ១៦ ក្នុង សង្កាត់ ទន្លេបាសាក់ នេះ មាន ចំនួន ជាង ៣០០ គ្រួសារ ប៉ុន្តែ ប្រជាពលរដ្ឋ ដែល អាជ្ញាធរ តម្រូវឲ្យ ពួកគាត់ ធ្វើចត្តាឡី ស័ក នៅ ពេល នេះ មាន ចំនួន ១៩៤ គ្រួសារ ។
បើ តាម លោក គឹម សន្តិភាព ការពិន័យ អន្តរការណ៍ ខាងលើ គឺ ទណ្ឌកម្ម ចំពោះ « ការ មិន អនុវត្ត កាតព្វកិច្ចសហការ ជាមួយ មន្ត្រី សុខាភិបាល ដើម្បី យក វត្ថុ សំណាក » ដែល មាន ចែង ក្នុង អនុក្រឹត្យ លេខ ៣៧ ស្តីពី វិធានការ សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ជំងឺ ឆ្លងកាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ។
លោក គឹម សន្តិភាព បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « បុគ្គល ដែល មិន សហការ ជាមួយ មន្រ្តី សុខាភិបាល ដើម្បី យក វត្ថុ សំណាក ទៅ វិភាគរក មេរោគ កូវីដ - ១៩ ត្រូវ ផ្តន្ទាទោស ជាពិន័យ អន្តរការណ៍ ពី ១លាន រៀល ទៅ ៥រៀល ហើយ ការបង់ប្រាក់ ពិន័យ អន្តរការណ៍ នេះ មិន ធ្វើឱ្យ បុគ្គល ដែល ប្រព្រឹត្ត អំពើ ល្មើស នេះ រួចផុត ពី កាតព្វកិច្ច ក្នុង ការ ឱ្យ មន្រ្តី សុខាភិបាល យក សំណាក ទៅ វិភាគរក មេរោគ កូវីដ - ១៩ នោះ ទេ » ។
សូម ជម្រាប ថា នៅ ព្រឹក ថ្ងៃទី ៥ ខែមេសា ឆ្នាំ ២០២១ ម្សិលមិញ មាន ករណី គ្រួសារ លោក ពិន ប៉ូ ដែល ជា អ្នកបើក ម៉ូតូ កង់៣ ម្នាក់ រស់ នៅ ភូមិ ម៉ុង បារាំង សង្កាត់ ប្អេរ ក្រុង កំពង់ឆ្នាំង ខេត្ត កំពង់ឆ្នាំង ដែល បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ នឹង បុរស មាន វិជ្ជមាន កូវី១៩ ឈ្មោះ សោម ឡូ មិន សហការ ជាមួយ មន្ត្រី សុខាភិបាល ដើម្បី យក សំណាក ទៅ ធ្វើ វិភាគរក មេរោគ ឡើយ ។ ទោះជា យ៉ាងណា នៅ ល្ងាច ថ្ងៃ ដដែល គ្រួសារ ខាងលើ បាន សហការ វិញ ក្រោយ រង ការព្រមាន ផ្លូវ ច្បាប់ និង ការពន្យល់ ពី សមត្ថកិច្ច ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ អ៊ឹម ប៉ូលីកា ឧបត្ថម្ភ ថវិកា ២ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម អគ្គ បណ្ឌិត សភាចារ្យ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ឡាវ ម៉េង ឃីន និង លោកជំទាវ ជឹង សុភាព ឧបត្ថម្ភ ថវិកា ១០ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឡាវ ម៉េង ឃីន និង លោកជំទាវ ជឹង សុភាព ឧបត្ថម្ភ ថវិកា ១០ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ឡាវ ម៉េង ឃីន និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ជាមួយគ្នា នេះ លោក ទេសរដ្ឋមន្រ្តី និង ក្រុមការងារ បាន ចុះ ពិនិត្យ អគារ ដែល រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន រៀបចំឡើង សម្រាប់ ធ្វើចត្តាឡី ស័ក និង ព្យាបាល ជំងឺ កូវីដ នៅ អគារ ម៉ុក បាយ ព្រមទាំង បាន ចុះ ពិនិត្យ សកម្មភាព ចាក់ វ៉ាក់សាំង របស់ ក្រុម គ្រូពេទ្យ នៅ មណ្ឌល សុខភាព បាវិត ផងដែរ ៕ ឯកឧត្តម ម៉ម ប៊ុន ហេង និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ម៉ម ប៊ុន ហេង កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ឧបត្ថម្ភ ថវិកា ២ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម លឹម គាន ហោ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម សារ៉ាក់ ខាន់ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម សារ៉ាក់ ខាន់ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម ឈិត សុខុន និង លោកជំទាវ កែវ យិន ឧបត្ថម្ភ ថវិកា ៨លាន រៀល ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឈិត សុខុន និង លោកជំទាវ កែវ យិន ឧបត្ថម្ភ ថវិកា ៨លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្តម ឈិត សុខុន កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
