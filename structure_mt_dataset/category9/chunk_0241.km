( រ៉ង់ ហ្គូន ) ៖ ក្រុម អ្នក ប្រឆាំង របប យោធា នៅ មីយ៉ាន់ម៉ា នា ថ្ងៃសុក្រ នេះ បាន ប្រកាស បង្កើត រដ្ឋាភិបាល ផ្ទាល់ខ្លួន មួយ តែម្តង ជាមួយ គោលដៅ ចម្បង ស្វែងរក ការគាំទ្រ និង ទទួលស្គាល់ ពី អន្តរជាតិ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ល្ងាច ថ្ងៃសុក្រ ទី ១៦ ខែមេសា ឆ្នាំ ២០២១ ។
រដ្ឋាភិបាល រួបរួម ជាតិ មីយ៉ាន់ម៉ា បាន បង្ហាញ សមាសភាព មួយចំនួន ដែល រួម មាន អតីត សមាជិក សភា របស់ គណបក្ស លោកស្រី អោង សាន ស៊ូ ជី ព្រមទាំង មេដឹកនាំ ចលនា បាតុកម្ម និង សមាជិក នៃ សហគមន៍ ជនជាតិ ភាគ តិច ជាដើម ។ រដ្ឋមន្រ្តី កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ របស់ រដ្ឋាភិបាល នេះ បាន ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ថា គោលដៅ គឺ ធ្វើ យ៉ាង បញ្ចប់ អំពើហិង្សា ស្តារ លទ្ធិ ប្រជាធិបតេយ្យ ឡើងវិញ និង កសាង សហភាព សហព័ន្ធ ប្រជាធិបតយ្យ មួយ ។
គួរ បញ្ជាក់ ថា ប្រទេស មីយ៉ាន់ម៉ា បាន ធ្លាក់ ក្នុង ភាពវឹកវរ យ៉ាង ហិង្សា ចាប់តាំងតែពី រដ្ឋប្រហារ ថ្ងៃទី ០១ ខែកុម្ភៈ ឆ្នាំ ២០២១ ដែល បាន ទម្លាក់ រដ្ឋាភិបាល ស៉ី វិល របស់ លោកស្រី ស៊ូ ជី ក្រោយ ការទទួល ជ័យជម្នះ ភ្លូក ទឹក ភ្លូក ដី នៅ អាណត្តិ ទី២ ក្នុង ការបោះឆ្នោត កាលពី ខែវិច្ឆិកា ឆ្នាំ មុន ខណៈ យោធា ចោទ ថា ការបោះឆ្នោត នោះ បាន ប្រព្រឹត្តទៅ ដោយ មិន ប្រក្រតី ។
នៅក្នុង ថ្ងៃសុក្រ នេះ ដែរ គេ នៅ មិន ទាន់ ឃើញ មាន សេចក្តីរាយការណ៍ ណាមួយ អំពី ស្ថានការណ៍ នៅ មីយ៉ាន់ម៉ា ដូចជា ការធ្វើ បាតុកម្ម និង បង្ក្រាប ដូច សព្វមួយ ដង នោះ ឡើយ ។ ដោយឡែក ការឆ្លើយតប របស់ យោធា មីយ៉ាន់ម៉ា ទៅនឹង ការបង្កើត រដ្ឋាភិបាល ថ្មី ដោយ ក្រុម អ្នក ប្រឆាំង របប ខ្លួន ខាងលើ នេះ ក៏ មិន ឃើញ មាន នៅឡើយ ដែរ ៕
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន អះអាង ថា គិត ត្រឹម ម៉ោង ៤៖០០ រសៀល ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្រសួង និង មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត កណ្តាល បាន ចេញ « លិខិត អនុញ្ញាត ចេញ - ចូល » ចំនួន ១០.៧៩៨ សន្លឹក ។
យោង សេចក្តីសម្រេច លេខ ៤៩សសរ របស់ រាជ រដ្ឋាភិបាល ស្តីពី ការបិទ ខ្ទប់ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តា ខ្មៅ នៃ ខេត្ត កណ្តាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង គោលការណ៍ ឯកភាព របស់ គណៈកម្មការ ជាតិ គ. ប. ខ ក្រសួង សម្រេច បញ្ឈប់ ការផ្តល់ « លិខិត អនុញ្ញាត ចេញ - ចូល » ជូន រោងចក្រ សហគ្រាស និង សិប្បកម្ម ចាប់ពី ពេល ជូនដំណឹង នេះ តទៅ ។
ក្រសួង ការងារ រ បាន បញ្ជាក់ ទៀត ថា លោក លោកស្រី ជា ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស និង សិប្បកម្ម អាច ទៅ ស្នើសុំ លិខិត អនុញ្ញាតឲ្យ ដំណើរការ សកម្មភាព អាជីវកម្ម ពី អាជ្ញាធរ មាន សមត្ថកិច្ច ដែល នៅជិត បំផុត ។
នៅពេល ធ្វើដំណើរ សូម លោក លោកស្រី និង បងប្អូន កម្មករ និយោជិត ដែល មាន ការអនុញ្ញាតឲ្យ បន្ត សកម្មភាព អាជីវកម្ម យក ជាប់ ខ្លួន ជានិច្ច នូវ៖
* ទី ១៖ លិខិត អនុញ្ញាតឲ្យ ដំណើរការ សកម្មភាព អាជីវកម្ម * ទី ២៖ ឯកសារ បញ្ជាក់ អំពី តួនាទី ការងារ មុខរបរ ឬ អាជីវកម្ម ( បណ្ណ កម្មករ ឬ បណ្ណ បុគ្គលិក )* ទី ៣៖ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ឬ លិខិត បញ្ជាក់ ទីលំនៅ ៕ រដ្ឋបាល ខេត្ត កំពង់ចាម បិទ អគារ សម្រាក ព្យាបាល ជំងឺ ទូទៅ នៅក្នុង មន្ទីរពេទ្យ បង្អែក ស្រីសន្ធ រ និង មន្ទីរ ពហុ ព្យាបាល ព្រែក ពោធិ៍
ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៦ ខែ មេសា៖ បង្ក្រាប ៩ករណី ឃាត់ខ្លួន ១៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៩ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី . ជួញដូរ ៦ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ១៥ នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ បទបញ្ជា ទៅកាន់ អាជ្ញាធរ និង សមត្ថកិច្ច ត្រូវតែ អនុវត្ត វិធានការ ឱ្យ បាន តឹង រឺង បំផុត មិន ឱ្យ មាន ការធ្វើដំណើរ ឆ្លង ពី ផ្ទះ មួយ ទៅ ផ្ទះ មួយ ឬ ពី ភូមិ មួយ ទៅ ភូមិ មួយ នោះ ឡើយ ។
ក្នុង សារ សំឡេង ពិសេស នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន កត់សម្គាល់ ថា ក្នុង ពេល បិទ ខ្ទប់ នេះ នៅតែ មាន ប្រជាពលរដ្ឋ អាច ធ្វើចរាចរ ការប្រាស្រ័យទាក់ទង គ្នា និង ឆ្លង ខេត្ត ជាដើម ។ សម្តេច តេជោ ហ៊ុន សែន បាន ក្រើន រំលឹក ដល់ អាជ្ញាធរ និង សមត្ថកិច្ច ក្នុង រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ បង្កើន ការអនុវត្តន៍ វិធានការ នេះ ដោយ ម៉ឺងម៉ាត់ បំផុត ។
នៅក្នុង សុន្ទរកថា ចេញ ពី សេតវិមាន លោក ចូ បៃ ដិន បាន និយាយ វា ជា ពេល ត្រូវ បញ្ចប់ សង្រ្គាម របស់ អាមេរិក ដ៏ យូអង្វែង ។ លោក បាន ពន្យល់ ថា ការសម្រេចចិត្ត ដក កងទ័ព គឺ ដោយសារតែ សហរដ្ឋ អាមេរិក គ្មាន ហេតុផល ណាមួយ ត្រូវ បន្ត រក្សា វត្តមាន កងទ័ព ក្នុង ប្រទេស អាហ្វហ្កានីស្ថាន ត ទៀត ឡើយ ។ លោក បៃ ដិន ចង់ សំដៅ ទៅ លើ វត្ថុ បំណង ដែល អាមេរិក ប្រកាស ធ្វើ សង្រ្គាម កាលពី ជាង ២០ ឆ្នាំ មុន ។
សហរដ្ឋ អាមេរិក បាន ប្រកាស ធ្វើ សង្រ្គាម នៅ អាហ្វហ្គានីស្ថាន គឺ តែ ប៉ុន្មាន សប្ដាហ៍ ប៉ុណ្ណោះ បន្ទាប់ពី មាន ការវាយប្រហារ លើ អគារ ពាណិជ្ជកម្ម ពិភពលោក ក្នុង ទីក្រុង ញូយ៉ក នៅ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០០១ ។ អាមេរិក នៅក្រោម ការដឹកនាំ របស់ អតីត ប្រធានាធិបតី លោក ចច ដាប់ ប៊ែល យូប៊ូស បាន ចោទ ថា ក្រុម អាល់កៃ របស់ Osama bin Laden ជា អ្នក នៅ ពីក្រោយ ការវាយប្រហារ នេះ និង ចោទ ដែរ ថា អាហ្វហ្កានីស្ថាន នៅក្រោម ការដឹកនាំ របស់ រដ្ឋាភិបាល តាលី បង់ នៅ ពេល នោះ គឺជា អ្នក ជួយ លាក់ បំពួន មេ ភេរវករ អាល់កៃដា រូប នេះ ។
* ប្ដូរ យុទ្ធសាស្រ្ត មក ផ្ដោត លើ ចិន
នៅក្នុង សុន្ទរកថា កាលពី ថ្ងៃពុធ លោក ចូ បៃ ដិន ក៏ បាន លើកឡើង បន្តិច ដែរ ពី ចិន ។ លោក បៃ ដិន ថា សហរដ្ឋ អាមេរិក ត្រូវតែ ផ្ដោត លើ បញ្ហា ប្រឈមមុខ នៅ ចំពោះមុខ ដោយ សង្កត់ធ្ងន់ ពី ការគំរាមកំហែង នៃ ការវាយប្រហារ ព័ត៌មានវិទ្យា និង ការកើនឡើង នៃ ទំនាក់ទំនង តានតឹង ជាមួយ ចិន ។ « យើង ត្រូវតែ ពង្រឹង ការប្រកួតប្រជែង របស់ សហរដ្ឋ អាមេរិក ដើម្បី ឆ្លើយតប ទៅនឹង ការប្រកួតប្រជែង កាន់តែ ខ្លាំង ឡើង ដែល យើង កំពុង ប្រឈមមុខ ជាមួយ ចិន » ។ នេះ ជា ការកត់សម្គាល់ របស់ លោក បៃ ដិន ។
ដើម្បី សម្រេច គោលដៅ នេះ សហរដ្ឋ អាមេរិក ត្រូវការ ជា ចំា បាច់ កិច្ចសហប្រតិបត្តិកពី តួអង្គ សំខាន់ មួយចំនួន នៅក្នុង តំបន់ ដូចជា ហ្វីលីពីន និង ឥណ្ឌូណេស៊ី ។ ក៏ប៉ុន្តែ ក្នុង ចំណោម ប្រទេស ទាំងនេះ អាចនឹង ប្រទេស ខ្លះ ប្រឆាំង នឹង ការដំឡើង ប្រព័ន្ធ មីស៊ីល អាមេរិក ពីព្រោះ ពួកគេ បារម្ភ ថា ការធ្វើ ដូច្នេះ អាច ប្រឈមមុខ នឹង ហានិភ័យ នៃ ការវាយប្រហារ យោធា តាម ផ្លូវ អាកាស ឬ ទណ្ឌកម្ម សេដ្ឋកិច្ច ពី ចិន ៕
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ ជូន គ្លីនិក អ៊ាវ សុខា ដែល បាន ឧបត្ថម្ភ ថវិកា ចំនួន ២.០០០ ដុល្លារ ជូន ដល់ សាលា រាជធានី ភ្នំពេញ សម្រាប់ ប្រើប្រាស់ ដើម្បី ប្រយុទ្ធ ប្រឆាំង និង ការទប់ស្កាត់ ការ ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ។
លិខិត ថ្លែងអំណរគុណ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២១ នេះ លោក ឃួង ស្រេង បាន គូសបញ្ជាក់ ថា តាមរយៈ កាយវិការ ដ៏ ល្អ ប្រពៃ ប្រកបដោយ មនុស្សធម៌ និង គុណធម៌ របស់ គ្លីនិក អ៊ាវ សុខា ពិតជា បាន រួមចំណែក យ៉ាង សំខាន់ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ និង រាជ រដ្ឋាភិបាល ស្រប តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ក្នុង ការចាត់ វិធានការ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង រាជធានី ភ្នំពេញ ក៏ ដូចជា នៅ ទូទាំង ប្រទេស បាន ទាន់ ពេល វេលា ។
ខាងក្រោម នេះ ជា លិខិត ថ្លែងអំណរគុណ របស់ អភិបាល រាជធានី ភ្នំពេញ៖ ក្រសួង អប់រំ ជូនដំណឹង អំពី ការកែសម្រួល កាលបរិច្ឆេទ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដួស ទី២ ជូន បុគ្គលិក អប់រំ
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការកែសម្រួល កាលបរិច្ឆេទ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដួស ទី២ ជូន បុគ្គលិក អប់រំ នៅ ទីតាំង សាលា អន្ដរជាតិ កាណាដា (CIS) វិទ្យាល័យ ជា ស៊ីម ឈូក វ៉ា និង ទីតាំង វិទ្យាល័យ ច្បារអំពៅ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ ក្រសួង អប់រំ ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖
( ឥណ្ឌូណេស៉ី ) ៖ ចាប់ពី ដើម សតវត្សរ៍ ទី ១៦ ប្រទេស ឥណ្ឌូណេស៉ី ក៏ ធ្លាប់ ស្ថិត នៅក្រោម នឹម អាណានិគម របស់ ពួក ចក្រពត្តិ អឺរ៉ុប និង ចក្រ ពត្តិ ជប៉ុន ផងដែរ រហូតដល់ គ្រិស្ដ សករាជ ១៩៤៩ ទើប បង ធំ អាស៉ី អាគ្នេយ៍ មួយ នេះ ទទួលបាន ឯករាជ្យ ជា ផ្លូវការ ពី ព្រះរាជាណាចក្រ ហូឡង់ វិញ ។
ខាងក្រោម នេះ ជា អត្ថបទ ភាគ ទី៨ ដែល រៀបរាប់ អំពី ព្រឹត្តិការណ៍ អាណានិគម នៅ ប្រទេស ឥណ្ឌូណេស៉ី៖
ក្រោម ការគ្រប់គ្រង របស់ ពួក ហូឡង់ គេ ឃើញ ថា វិស័យ សេដ្ឋកិច្ច នៅ កោះ ស៊ូម៉ាត្រា ក្នុង រយៈពេល ជាង ៣០ ឆ្នាំ ដំបូង មាន ការផ្លាស់ប្ដូរ គួរឱ្យ កត់សម្គាល់ ។ ស៊ូម៉ាត្រា ក្លាយជាង អ្នកផ្គត់ផ្គង់ ថ្នាំជក់ ដ៏ ធំ បំផុត និង មាន គុណភាព ល្អ ដាច់ គេ នៅក្នុង ចំណោម ប្រទេស ផ្គត់ផ្គត់ ថ្នាំជក់ ដទៃ ។ ក្រោយ រកឃើញ កំណប់ ប្រេង ដោយ ពួក ហូឡង់ មក នោះ កោះ ស៊ូម៉ាត្រា ក៏ បាន ក្លាយជា ប្រភព ប្រេង ដ៏ សំខាន់ របស់ ក្រុម ប្រេង ហូឡង់ ។
ចំពោះ ផ្សារ លក់ គ្រឿង ឧបភោគ បរិភោគ បន្លែ ត្រី សាច់ គឺ អនុញ្ញាតឱ្យ លក់ ធម្មតា បន្តែ សម្រាប់ ប្រជាពលរដ្ឋ គឺ អនុញ្ញាតឱ្យ មក ទិញ គ្រឿង ឧបភោគ យក ទៅ ផ្ទះ ត្រឹមតែ ៣ ថ្ងៃ ក្នុង មួយ សប្ដាហ៍ ប៉ុណ្ណោះ ចំពោះ ហាង លក់ សម្ភារ ផ្សេង ៗ ដូច ជា៖ កន្លែង លក់ គ្រឿង សំណង់ លក់ កង់ លក់ ខោអាវ លក់ គ្រឿង អេឡិចត្រូនិច និង ផ្ទះសំណាក់ នឹង ត្រូវបាន បិទ ទាំងស្រុង រយៈពេល ១៤ ថ្ងៃ តែម្ដង ចំពោះ សហគ្រាស ក្នុង ក្រុង តាខ្មៅ គឺ អនុញ្ញាតឱ្យ ដំណើរការ ធម្មតា ប៉ុន្តែ អនុញ្ញាតឱ្យ មាន កម្មករ ត្រឹមតែ ២៥ នាក់ ប៉ុណ្ណោះ ។
ការសម្រេច បែប នេះ របស់ លោក គង់ សោភ័ណ្ឌ បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ អនុវត្ត សេចក្តីសម្រេច លេខ ៤៩ សសរ ចុះ ថ្ងៃទី ១៤ ខែមេសា ឆ្នាំ ២០២០ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ស្តីពី ការបិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល រយៈពេល ១៤ ថ្ងៃ ចាប់ពី វេលា ម៉ោង ០០៖០០ នាទី ឈានចូល ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ ដើម្បី ចូលរួម ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
