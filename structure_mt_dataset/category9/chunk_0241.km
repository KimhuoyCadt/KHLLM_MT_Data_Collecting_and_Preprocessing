( ភ្នំពេញ ) ៖ ឧកញ៉ា ហ៊ុន ឡាក់ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៣ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឧកញ៉ា ហ៊ុន ឡាក់ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឧកញ៉ា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឧកញ៉ា អ៉ឹង សែ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឧកញ៉ា អ៉ឹង សែ និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឧកញ៉ា អ៊ឹង សែ និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោកស្រី ទី បូរ៉ាស៉ី បរិច្ចាគ ថវិកា២.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ មន្ទីរពេទ្យ « នគរ ទេព » និង ចូលរួម ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ
( ភ្នំពេញ ) ៖ លោកស្រី ទី បូរ៉ាស៉ី ប្រធាន គណៈកម្មការ ទី៥ នៃ ព្រឹទ្ធសភា បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ មន្ទីរពេទ្យ « នគរ ទេព » ។ ការបរិច្ចាគ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ទិញ មន្ទីរ « នគរ ទេព » មក ធ្វើជា សម្បត្តិ រដ្ឋ និង បម្រើ ការព្យាបាល អ្នកជំងឺ កូវីដ១៩ ។
ជាមួយគ្នា នេះ លោកស្រី ទី បូរ៉ាស៉ី ក៏ បាន បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ ទៀត ជូន គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ទប់ស្កាត់ និង បង្ការ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ផងដែរ ៕
អាជ្ញាធរ រាជធានី ភ្នំពេញ អនុវត្ត បម្រាម គោចរ ឃាត់ រថយន្ត បាន ចំនួន ២គ្រឿង ទៀត នៅ យប់ មិញ
គួរ បញ្ជាក់ ថា អតីត ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន ដក ទីក្រុង វ៉ាស៊ីនតោន ចេញ ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ អ៉ី រ៉ង់ ឆ្នាំ ២០១៥ កាលពី ឆ្នាំ ២០១៨ ដោយ ចោទ ថា ទីក្រុង តេហេរ៉ង់ ថា មិន បាន អនុវត្ត តាម កិច្ចព្រមព្រៀង នេះ ។ តាំងពី ពេល នោះ មក ដែរ អ៉ីរ៉ង់ បាន ចាប់ផ្ដើម បង្កើន ការចម្រាញ់ សារធាតុ អ៉ុយរ៉ាញ៉ូម ដែល បង្កឱ្យ មាន ការព្រួយបារម្ភ ថា សារធាតុ អ៊ុយរ៉ាញ៉ូម ទាំង នេះ អាចនឹង ត្រូវ ប្រើប្រាស់ ដើម្បី ផលិត អាវុធ នុយក្លេអ៊ែរ ។
ដោយឡែក កិច្ចពិភាក្សា ខាងលើ កើត មាន ឡើង បន្ទាប់ពី រដ្ឋបាល អាមេរិក ថ្មី របស់ លោក ចូ បៃ ដិន និង ទីក្រុង តេហេរ៉ង់ បាន បង្ហាញ ពី ចេតនា ត្រឡប់មក អនុវត្ត តាម កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ឡើងវិញ តែ ពួកគេ សុទ្ធតែ ដាក់ លក្ខខណ្ឌ ដាក់ គ្នា ទៅ វិញ ទៅមក ។ សហរដ្ឋ អាមេរិក តម្រូវ ឱ្យ អ៉ី រ៉ង់ បញ្ឈប់ ការចម្រាញ់ សារធាតុ អ៊ុយរ៉ាញូម រីឯ អ៉ីរ៉ង់ ទាមទារ ឱ្យ លោក បៃ ដិន ដក ទណ្ឌកម្ម សេដ្ឋកិច្ច ទាំងអស់ ដែល នៅសល់ ពី ជំនាន់ លោក ដូណាល់ ត្រាំ ជាមុន សិន ៕
គួរ បញ្ជាក់ ថា ប្រជាជន អូស្រ្តាលី តែ ប្រហែល ៦៧០.០០០ នាក់ ប៉ុណ្ណោះ ដែល ទទួលបាន ការចាក់ វ៉ាក់សាំង សម្រាប់ ដូស ដំបូង ដោយ វា ខុសពី គោលដៅ ដំបូង របស់ ប្រទេស អូស្រ្តាលី ដែល មាន គោលបំណង ចាក់ វ៉ាក់សាំង ជូន ប្រជាជន របស់ ខ្លួន ឲ្យបាន ចំនួន ៤លាន នាក់ នៅ ចុង ខែមីនា ៕
អាជ្ញាធរ ខេត្ត ព្រះសីហនុ សម្រេច ឲ្យ គ្លីនិក តែ វ៉ាន់ បើក ដំណើរការធម្មតា ឡើងវិញ ក្រោយ បញ្ចប់ ការធ្វើជា មណ្ឌល ចត្តាឡី ស័ក
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចេញ បញ្ចប់ ជា មណ្ឌល ចត្តាឡី ស័ក ចំពោះ គ្លីនិក តៃវ៉ាន់ មាន ទីតាំង ផ្លូវ ២៣តុលា ភូមិ១ សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត ក៏ បាន សម្រេច ឲ្យ គ្លីនិក នេះ បើក ដំណើរការធម្មតា ឡើងវិញ ប៉ុន្តែ ត្រូវ អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ តាម វិធានការ « ៣ការពារ ៣កុំ » របស់ សម្តេច តេជោ ហ៊ុន សែន និង សេចក្តីណែនាំ របស់ ក្រសួងុ ខាភិបាល ៕
សូម អាន សេចក្តីសម្រេច ទាំង ស្រុង៖ លោកជំទាវ ឧកញ៉ា ចាន់ សុទ្ធា ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោកជំទាវ ឧកញ៉ា ចាន់ សុទ្ធា ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
លោកជំទាវ ឧកញ៉ា ចាន់ សុទ្ធា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោកជំទាវ ឧកញ៉ា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
