( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៣៣០ នាក់ ទៀត ដែល បាន រកឃើញ កើត ជំងឺ កូវីដ១៩ នៅ ថ្ងៃទី ២១ ខែមេសា ។
( កំពង់ឆ្នាំង ) ៖ ប្រជាពលរដ្ឋ ភូមិ ព្រះរាម រង្សី ជាង ៣០០ គ្រួសារ បាន ទទួល អំណោយ ពី សប្បុរសជន និង ថ្នាក់ដឹកនាំ បាន យកមក ចែកជូន ដល់ ពលរដ្ឋ ទាំងអស់ នៅក្នុង ភូមិ ដែល កំពុង ធ្វើចត្តាឡី ស័ក នៅក្នុង លំនៅដ្ឋាន គ្រប់ គ្រួសារ រយៈពេល ១៤ ថ្ងៃ បន្ទាប់ពី មាន ករណី ប្រជាពលរដ្ឋ ម្នាក់ រស់ នៅក្នុង ភូមិ ព្រះរាម រង្សី នេះ បាន ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ ហើយ ក្រុមគ្រួសារ បាន យក សព មក ធ្វើ បុណ្យ នៅ លំ នៅដ្ឋាន ដោយ មិន បាន ដឹង ថា សព មាន វិជ្ជមាន កូវីដ១៩ ។
លោក សេង វិចិត្រ អភិបាល រង ស្រុក រលាប្អៀរ បាន បញ្ជាក់ ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ ល្ងាច ថ្ងៃទី ២២ ខែមេសា នេះ ថា នៅ រសៀល ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ នេះ ក្រុមការងារ ស្រុក រលាប្អៀរ និង ក្រុមការងារ ឃុំ ជ្រៃ បាក់ បាន នាំយក អំណោយ របស់ លោក សូ សាម៉ន អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក រលាប្អៀរ និង អំណោយ របស់ សប្បុរស ជន ជាច្រើន នាក់ ទៀត បាន ជួយ ឧបត្ថម្ភ ដល់ ប្រជាពលរដ្ឋ ជាង ៣០០ គ្រួសារ រួមទាំង ក្រុម ប្រជាការពារ នៅ យាម តាម គោលដៅ ទាំង ៥ ជុំវិញ ភូមិ ព្រះរាម រង្សី ផងដែរ ។
អំណោយ ទាំងអស់ ខាងលើ នេះ បាន យក ទៅ ប្រគល់ ជូន អាជ្ញាធរ ភូមិ ដើម្បីឲ្យ លោក ចាត់ចែង ទៅ តាម គ្រួសារ នីមួយ ៗ ជាក់ស្តែង បើ ទោះជា អំណោយ ទាំងអស់ នេះ មាន តិច តួច ស្តួចស្ដើង យ៉ាងណា ក្តី ក៏ ជា ទឹកចិត្ត សប្បុរសធម៌ របស់ សប្បុរសជន ជួយ រំលែក នៅ ការខ្វះខាត របស់ បងប្អូន បាន មួយចំណែក ក្នុង កាលៈទេសៈ ដែល បងប្អូន កំពុងតែ ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ រយៈពេល ១៤ ថ្ងៃ នេះ ។
( ភ្នំពេញ ) ៖ លោក ហេង សួរ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន អំពាវនាវ ដល់ ម្ចាស់ រោងចក្រ សហគ្រាស នៅ តាម ខេត្ត ដែល មិន ស្ថិត នៅក្នុង តំបន់ បិទ ខ្ទប់ ឱ្យ ផ្លាស់ប្តូរ របៀប ប្រតិបត្តិការ ហិរញ្ញវត្ថុ របស់ ខ្លួន ក្នុង ការបើក ប្រាក់ ឈ្នួល ជូន បងប្អូន កម្មករ និយោជិត ។
លោក ហេង សួរ បាន អំពាវនា ដូច្នេះ ធ្វើឡើង បន្ទាប់ពី មាន រោងចក្រ សហគ្រាស នៅ តាម បណ្តា ខេត្ត ជាច្រើន បាន ស្នើសុំ ក្រសួង ជួយ សម្របសម្រួល និង អន្តរាគមន៍ ដើម្បី ស្នើសុំ លិខិត បញ្ជា បេសកកម្ម ពី ច្រក ចេញ ចូល តែ មួយ នៅ តាម ខេត្ត នានា សម្រាប់ ប្រើប្រាស់ ជា លិខិត បើក ផ្លូវ ឡើង មក បើក សាច់ប្រាក់ ពី ធនាគារ នៅ ភ្នំពេញ យក ទៅ បើក ប្រាក់ ឈ្នួល ជូន បង បប្អូន កម្មករ និយោជិត របស់ ខ្លួន ។
លោក ហេង សួរ ក៏ បាន សំណូមពរ ដល់ បងប្អូន កម្មករ និយោជិត នៅ តាម បណ្តា ខេត្ត ដែល ត្រូវ បើក ប្រាក់ ឈ្នួល នៅ ចុង សប្តាហ៍ នេះ សូម មេត្តា អត់ធ្មត់ រង់ចាំ ដល់ ដើម សប្តាហ៍ ក្រោយ ដើម្បី ទុក ពេល ឱ្យ រោងចក្រ សហគ្រាស នីមួយ ៗ ប្រើ វិធីសាស្ត្រ ថ្មី ក្នុង ការផ្ទេរ សាច់ប្រាក់ របស់ ខ្លួន ទៅ បើក ជូន បងប្អូន ។
លោក ហេង សួរ ក៏ បាន បញ្ជាក់ ផងដែរ ថា ក្រសួង នឹង ព្យាយាម សម្របសម្រួល ជាមួយ គ្រប់ ភាគី ពាក់ព័ន្ធ ជំរុញ គ្រប់ រោងចក្រ សហគ្រាស ដែល មិន ស្ថិត នៅក្នុង តំបន់ បិទ ខ្ទប់ ឲ្យ ផ្លាស់ប្តូរ របៀប ប្រតិបត្តិការ ហិរញ្ញវត្ថុ របស់ ខ្លួន ៕
លោក ឃួង ស្រេង បន្ដ ចែក អំណោយ សម្ដេច តេជោ ហ៊ុន សែន ជូន ពលរដ្ឋ ១. ៣៤៥ គ្រួសារ នៅ សហគមន៍ ចំនួន ១០ ក្នុង សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ
( ភ្នំពេញ ) ៖ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ត្រូវបាន លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ នេះ បន្ដ យក ទៅ ចែកជូន ប្រជាពលរដ្ឋ ចំនួន ១៣៤៥ គ្រួសារ រស់ នៅ សហគមន៍ ចំនួន ១០ ក្នុង សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ ខណៈ រាជ រដ្ឋាភិបាល បាន សម្រេច បិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ ដើម្បី ការពារ នូវ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឃួង ស្រេង បាន ស្នើ ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី ទាំងអស់ កុំ ដាក់ទោស ចំពោះ អ្នក ដែល ជួយ យើង ហើយ ទៅ ជឿ លើ អ្នក ដែល មិន បាន ជួយ យើង សោះ ។ ហើយ កម្មករ កម្ម ការិនី មាន ការងារ ធ្វើ មាន ជីវភាព ប្រសើរឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ គឺ ដោយសារតែ ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ។
លោក ឃួង ស្រេង បាន អះអាង ថា សម្ដេច បាន ខិតខំ ខ្លាំង ខ្លាំង ណាស់ ក្នុង ការស្វែងរក អ្នក វិនិយោគទុន មក វិនិយោគ នៅ កម្ពុជា ដើម្បីឲ្យ បងប្អូន កម្មករ កម្មការិនី មាន ការងារ ធ្វើ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ដូច្នេះ សូម បងប្អូន កុំ ដាក់ទោស ចំពោះ អ្នក ដែល ជួយ យើង ឲ្យ សោះ ។
អភិបាល រាជធានី ភ្នំពេញ បន្ថែម ទៀត ថា ជំងឺ កូវីដ - ១៩ បាន កើតឡើង នៅ ទូទាំង ពិភពលោក ហើយ កម្មករ កម្ម ការិនី នៅឯ បរទេស ក៏ បាន ប្រឈមមុខ នូវ ជំងឺ កូវីដ - ១៩ នេះ ផងដែរ ។ ដោយឡែក សម្រាប់ កម្មករ កម្ម ការិនី នៅ កម្ពុជា ដែល មាន បញ្ហា ជំងឺ កូវីដ - ១៩ នេះ ត្រូវបាន រដ្ឋាភិបាល យកចិត្តទុកដាក់ ណាស់ ដោយ បាន ឧបត្ថម្ភ ជា គ្រឿង ឧបភោគ បរិភោគ ជួយ សម្រួល ដល់ ជីវភាព របស់ កម្មករ កម្ម ការិនី ថែម ទៀត ។
គួរ បញ្ជាក់ ថា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ប្រជាពរដ្ឋ ទាំង ១៣៤៥ គ្រួសារ នេះ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ មី ត្រីខ ទឹក ស៉ី អ៉ីវ និង ទឹកត្រី ៕ តើ ប្រទេស ចិន បាន ដើរ តួនាទី យ៉ាងដូចម្តេច ក្នុង ស្ថានការណ៍ ប្រែប្រួល របស់ ពិភពលោក ?
( ប៉េកាំង ) ៖ « ក្នុង នាម ជា សមាជិក សំខាន់ នៃ មហា គ្រួសារ ធំ ទ្វីប អាស៊ី ប្រទេស ចិន បាន ធ្វើឱ្យ ស៊ីជម្រៅ នូវ កំណែទម្រង់ និង ការបើក ទូលាយ ជា បន្តបន្ទាប់ សកម្ម ក្នុង ការជំរុញ កិច្ចសហប្រតិបត្តិការ ក្នុង តំបន់ វិវឌ្ឍ រីកចំរើន ជាមួយ ទ្វីប អាស៊ី រួមគ្នា អភិវឌ្ឍន៍ ជាមួយ ពិភពលោក » ប៉ុន្តែ ក្នុង ដំណើរ អភិវឌ្ឍន៍ របស់ ប្រទេស ចិន ក៏ មិន ខ្វះ សំឡេង ចោទ ជា មន្ទិល សង្ស័យ និង មូល បង្កាច់ ដែរ ។
( ភ្នំពេញ ) ៖ រយៈពេល ០២ ខែ មក ហើយ ដែល កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន មមាញឹក ទាំង យប់ ទាំង ថ្ងៃ ក្នុង ការចូលរួម សហការ ជាមួយ កម្លាំង ចម្រុះ របស់ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល និង កម្លាំង នគរបាល ទូទាំង រាជធានី ភ្នំពេញ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នូវ ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិការណ៍ ២០កុម្ភៈ ។
ចូលរួម ផ្សព្វផ្សាយ នូវ សេចក្តីជូនដំណឹង សេចក្តីណែនាំ បទបញ្ជា សេចក្តីសម្រេច អនុក្រឹត្យ និង ច្បាប់ ដែល ពាក់ព័ន្ធ ដល់ ការបង្កា ទប់ស្កាត់ នូវ ការរីករាលដាល ជំងឺ កូវីដ - ១៩. ចូលរួម សហការល្បាត និង ឈរជើង ត្រួតពិនិត្យ ការអនុវត្ត បម្រាម គោចរ និង វិធានការ បិទ ខ្ទប់ ភូមិ សង្កាត់ រហូតដល់ រាជធានី ទាំងមូល ផង និង បាន រួមចំណែក ចែក ស្បៀង ចែក ម៉ាស់ ដល់ ប្រជាពលរដ្ឋ ជាច្រើន ផង ។
ក្រៅពី នេះ អាវុធហត្ថ រាជធានី ភ្នំពេញ ក៏ បាន ចូលរួម អនុវត្ត យ៉ាង ម៉ឹង ម៉ាត់ ក្នុង ការការពារ ខ្លួន គ្រប់ ជំហាន ទាំង ការរស់នៅ និង ការបំពេញ បេសកកម្ម របស់ ខ្លួន តាម សេចក្តីជូនដំណឹង និង វិធានការ របស់ ក្រសួង សុខាភិបាល ជាពិសេស អនុសាសន៍ ណែនាំ ដ៏ ខ្ពង់ខ្ពស់ និង វិធានការ ៣ការពារ ៣កុំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
នា យប់ ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២១ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ចាត់ ក្រុមការងារ នាំយក ម៉ាស់ ចំនួន ៣.៤០០០ ម៉ាស បន្ថែម ទៀត ទៅ ចែកជូន ដល់ កម្លាំង អាវុធហត្ថ គ្រប់ គោលដៅ ដើម្បី យក ទៅ ប្រើប្រាស់ បន្ត បេសកកម្ម ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ជា បន្ត ទៀត ៕
សមាគម នារី ខណ្ឌ បឹងកង កង ចុះ សួរសុខទុក្ឋ និង នាំយក អំណោយ ជូន ជន ចាស់ជរា មាន ជំងឺ ជិត ២០០ គ្រួសារ
លោកស្រី ស៊ុយ សែន សករាជ បាន បញ្ជាក់ ថា សកម្មភាព នេះ មិន មែន ជា លើក ទី១ នោះ ទេ ដែល កន្លងមក សមាគម នារី ខណ្ឌ បាន ចុះ ដោះស្រាយ ជូន ប្រជាជន ដែល ខ្វះខាត ជាច្រើន នៅក្នុង មូលដ្ឋាន ខណ្ឌ បឹងកេងកង នេះ ។
លោកស្រី បាន ឲ្យដឹង ថា នេះ គឺជា ការអនុវត្តន៍ អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ឋ បណ្ឌិត តែងតែ ក្រើន រំលឹក ដល់ មន្រ្តី មូលដ្ឋាន ត្រូវ យកចិត្តទុកដាក់ លើក បញ្ហា ជីវភាព របស់ ប្រជាជន ដោយ មិន ទុកឲ្យ ប្រជាជន ណា ម្នាក់ រងគ្រោះ ឬ ស្លាប់ ដោយ យើង មិន បាន ដឹង មិន បាន ដោះស្រាយ នោះ ទេ ។
ប្រធាន សមាគម នារី ខណ្ឌ បាន នាំយក ថវិកា របស់ លោកស្រី ម៉ែន សំអន ជូន ដល់ កងកម្លាំង មន្ត្រីរាជការ ខណ្ឌ បឹងកេងកង
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ លោកស្រី គឹម សុវណ្ណា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ខណ្ឌ បឹងកេងកង និង លោក ធឹម សំអាន អភិបាល ខណ្ឌ លោកស្រី ប្រធាន សមាគម នារី ខណ្ឌ បាន នាំយក អំណោយ និង ថវិកា របស់ លោកស្រី ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច ជូន ដល់ កងកម្លាំង កងរាជអាវុធហត្ថ និង នគរបាល និង អនុសាខា សមាគម នារី ខណ្ឌ - សង្កាត់ ទាំង៧ ។
លោកស្រី ស៊ិន រតនា បាន ឲ្យដឹង ថា ថវិកា ដែល ផ្តល់ ដោយ លោកស្រី ឧប នាយក រដ្ឋមន្ត្រី ម៉ែន សំអន នា ពេលនេះ រួម មាន៖
* អនុសាខា សមាគម នារី ខណ្ឌ ៥០០.០០០ រៀល *កងរាជអាវុធហត្ថ ៥០០.០០០ រៀល * អធិការ នគរបាល ខណ្ឌ ៥០០.០០០ រៀល * ក្រុមការងារ នារី សង្កាត់ ក្នុង ១សង្កាត់ ៤០០.០០០ រៀល សរុប ០៧ សង្កាត់ ក្នុង ការបំពេញ ភារះ កិច្ច ដ៏ មាន សារៈសំខាន់ ក្នុង ការលុបបំបាត់ ជម្ងឺ កូវីដ១៩ ឲ្យ អស់ នា ពេល បច្ចុប្បន្ន នេះ ។
ជំនួស មុខ ឲ្យ កងកម្លាំង ទាំង ពីរ និង ថ្នាក់ដឹកនាំ នារី ទាំងអស់ . លោក ធឹម សំអាន សូម ថ្លែងអំណរគុណ ចំពោះ ការផ្តល់ ថវិកា ខាងលើ នេះ ៕
សេចក្តីជូនដំណឹង នេះ បាន ធ្វើឡើង បន្ទាប់ពី មាន មតិ ណែនាំ របស់ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុន្នីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន គណៈកម្មការ ជាតិ គ្រប់គ្រង និង ដឹកនាំ ការអនុវត្ត វិធានការបិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ។
អភិបាល ខេត្ត កណ្ដាល ចុះ ពង្រឹង វិធានការ កូវីដ ដល់ អាជ្ញាធរ ស្រុក កៀនស្វាយ ក្រោយ រកឃើញ អ្នក ឆ្លង បន្ត បន្ទាប់
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល បាន ដឹកនាំ ក្រុមការងារ ចុះ ទៅ មូលដ្ឋាន ស្រុក កៀនស្វាយ ដើម្បី ពង្រឹង លើ វិធានការ ការពារ កូវី ដ១៩ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ក្រោយ រកឃើញ មនុស្ស ៧នាក់ ជា ក្រុមគ្រួសារ ឲ្យ របស់ អាជីវករ ផ្សារ កៀន ស្វាយ ឆ្លង កូវីដ១៩ ទាំង គ្រួសារ តែម្ដង សរុប ៨នាក់ ។ គិត មកដល់ ថ្ងៃទី ២២ ខែមេសា នេះ អ្នកស្រុក កៀនស្វាយ មាន វិជ្ជមាន កូវីដ១៩ ចំនួន ៣៨ នាក់ ហើយ ។
លោក អភិបាល ខេត្ត បន្ត ថា « ជា ការប្រសើរ ដែល ប្រជាពលរដ្ឋ និង អាជីវករ ដែល វិជ្ជមាន កូវីដ១៩ គឺ ឆ្លង តែ ក្នុង គ្រួសារ តែ ប៉ុណ្ណោះ ដោយ មិន មាន ឆ្លង រាលដាល ពេញផ្សារ គគីរ នោះ ទេ ហើយ ពេលនេះ អាជ្ញាធរ គ្រប់គ្រង បាន និង បាន បិទ ផ្សារ នេះ ជា បណ្តោះអាសន្ន រួច មកហើយ » ។
លោក អភិបាល ខេត្ត បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម អនុវត្ត វិធានការ នានា របស់ រាជ រដ្ឋាភិបាល រដ្ឋបាល ខេត្ត រដ្ឋបាល ស្រុក ក៏ ដូចជា សហការ អនុវត្ត តាម ការណែនាំ របស់ អាជ្ញាធរ និង កម្លាំង មាន សមត្ថកិច្ច ដើម្បី បុព្វហេតុ រួម នៃ ការកាត់ផ្តាច់ និង ឈាន ទៅ បញ្ចប់ ការឆ្លង រាលដាល ក្នុង សហគមន៍ នៃ ជំងឺ កូវីដ១៩ សំដៅ ស្ថានការណ៍ និង គ្រប់ សកម្មភាព របស់ សង្គម វិល មក រក ប្រក្រតី ភាព ឡើងវិញ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
មន្ត្រី យោធា ជា នាយ រង ទី ចាត់ការការពារ គីមីសាស្ត្រ កើត ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ ទី ចាត់ការការពារ គីមីសាស្ត្រ អគ្គ បញ្ជាការដ្ឋាន បាន ឱ្យដឹង ថា លោក ឧត្តមសេនីយ៍ ទោ កែវ ប៊ុន ណា អត្តលេខ ០១២៥៧៥ នាយក រង ទី ចាត់ការការពារ គីមីសាស្រ្ត បាន រកឃើញ កើត ជំងឺ កូវីដ១៩ ។
យោង តាម សេចក្តីជូន ព័ត៌មាន នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ របស់ ទី ចាត់ការការពារ គីមីសាស្ត្រ បាន ឱ្យដឹង ថា លោក ឧត្តមសេនីយ៍ ទោ កែវ ប៊ុន ណា បាន ទៅ យក សំណាក កាលពី ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០២១ ហើយ លទ្ធផល បង្ហាញ មាន វិជ្ជមាន ជំងឺ កូវីដ១៩ ។ ភរិយា របស់ លោក ក៏ រកឃើញ វិជ្ជមាន ផងដែរ ។
បច្ចុប្បន្ន លោក កែវ ប៊ុន ណា និង ភរិយា កំពុង សម្រាក ព្យាបាល នៅ ផ្ទះ ដែល ស្ថិត នៅ ភូមិ ហនុ មាន ឃុំ ក្រាំង ធ្នង់ ស្រុក បាទី ខេត្ត តាកែវ តាម ការណែនាំ របស់ ក្រុម គ្រូពេទ្យ ក្រសួង សុខាភិបាល ។
បើ តាម ទី ចាត់ការការពារ គីមីសាស្ត្រ បាន បញ្ជាក់ ថា អ្នកជំងឺ ទាំង ពីរ នាក់ នេះ ធ្លាប់ បាន ចាក់ វ៉ាក់សាំង ចំនួន ០២ លើក រួច មកហើយ ។
ទី ចាត់ការការពារ គីមីសាស្ត្រ អំពាវនាវ ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ដែល បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ឬ ដោយ ប្រយោល ត្រូវ អនុវត្តន៍ តាម វិធានការ ការពារ កូវីដ - ១៩ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ខ្ជាប់ ខ្លួន និង ម៉ឺងម៉ាត់ បំផុត ៕
ថ្ងៃ នេះ ក្រសួង ពាណិជ្ជកម្ម លក់ អង្ករ បាន ២១៨ បាវ . មី ៦២៣ កេស និង គ្រឿង បរិភោគ មួយចំនួន ទៀត ក្នុង តម្លៃ ទាប ជាង ទីផ្សារ ជូន ប្រជាពលរដ្ឋ នៅ តំបន់ ក្រហម
លោក ប៉ែន សុវិជាតិ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ទំនិញ ស្បៀង លក់ បាន នៅ តំបន់ ក្រហម ថ្ងៃ ២២ មេសា ២០២១ ពលរដ្ឋ បាន បញ្ជាទិញ ច្រើន ។ យើង ប្រឹងប្រែង សម្រប សម្រួល រហូតដល់ យប់ ពុំ ទាន់ អស់ ការបញ្ជាទិញ នៅឡើយ ។ ទំនិញ ដែល ពុំ ទាន់ បាន បញ្ជូន ដល់ ផ្ទះ នឹង បញ្ជូន នៅ ថ្ងៃស្អែក ។ ស្អែក នេះ ក្រសួង នឹង បញ្ចូល បន្លែ ច្រើន មុខ ទៀត ព្រមទាំង ទំនិញ ក្រៀម ផ្សេង ទៀត ផងដែរ » ។
( ស្ទឹងត្រែង ) ៖ ទីតាំង ស្ដុកឈើ ប្រភេទ លេខ ១ មួយ កន្លែង នៅ ចំណុច ភូមិ ច្រប់ ឃុំ ក្បាលរមាស ស្រុក សេសាន ខេត្ត ស្ទឹងត្រែង ត្រូវ កម្លាំង អាវុធហត្ថ ខេត្ត ស្ទឹងត្រែង ក្រោម ការបញ្ជា ផ្ទាល់ របស់ លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ ឌី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ក្រោម ការសម្របសម្រួល ពី តំណាង អយ្យការ ចុះបង្ក្រាប នៅ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
តាម ការសាកសួរ ឈ្មោះ អៀង សារ៉ាត់ បាន សារភាព ថា ខ្លួន ទិញ ពី ឈ្មោះ ឈន ណាត ។ ដោយ អនុវត្ត តាម ការណែនាំ ពី លោក ជេត ខេមរា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ស្ទឹងត្រែង បាន បញ្ជា ឲ្យ កម្លាំង អាវុធហត្ថ ឃាត់ខ្លួន ជនសង្ស័យ ទាំង២នាក់ ខា លើ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ខ្លួន ទៅ តុលាការ ចាត់ការ តាម ច្បាប់ ៕
លោក ស៊ី មានប្រសាសន៍ ថា ប្រទេស ចិន នឹង ចាប់ផ្តើម កាត់បន្ថយ ការប្រើប្រាស់ ធ្យូងថ្ម បន្តិច ម្តង ៗ ចាប់ពី ឆ្នាំ ២០២៦ ដល់ ឆ្នាំ ២០៣០
( ស៊ាង ហៃ ) ៖ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង បាន ប្រាប់ កិច្ចប្រជុំ កំពូល ស្តី អំពី អាកាសធាតុ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២២ មេសា នេះ ថា ប្រទេស ចិន នឹង ចាប់ផ្តើម កាត់បន្ថយ ការប្រើប្រាស់ ធ្យូងថ្ម ក្នុង រយៈពេល ចន្លោះ ពី ឆ្នាំ ២០២៦ ដល់ ឆ្នាំ ២០៣០ ដែល ជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ក្នុង ការកាត់បន្ថយ ការបំភាយ ឧស្ម័ន ផ្ទះ កញ្ចក់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP ។
ការអត្ថាធិប្បាយ របស់ លោក ស៊ី បាន បញ្ជាក់ ថា ការប្រើប្រាស់ ធ្យូងថ្ម របស់ ចិន ដែល ខ្ពស់ បំផុត នៅលើ ពិភពលោក នឹង ឈានដល់ កម្រិត កំពូល នៅ ឆ្នាំ ២០២៥ ហើយ ចាប់ផ្តើម ធ្លាក់ចុះ ជា បន្តបន្ទាប់ ។
ទន្ទឹម គ្នា នេះ ប្រធានាធិបតី សុី ជីន ពីង ក៏ បាន រំលឹក ឡើងវិញ នូវ ការ អំពាវនាវ របស់ ចិន ទៅកាន់ បណ្តា ប្រទេស ឧស្សាហកម្ម ដើម្បី ជួយ ប្រទេស ក្រីក្រ ឱ្យ ផ្លាស់ប្តូរ ទៅ រក ការអភិវឌ្ឍ បៃតង និង កាបូន ទាប ផងដែរ ៕
ជាក់ស្តែង តាមរយៈ រូបភាព 20 សន្លឹក ដែល ត្រូវបាន ថត ដោយ ក្រុម ថត រូប របស់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២២ ខែមេសា នេះ គឺ បាន បង្ហាញ ពី សកម្មភាព កម្លាំង សមត្ថកិច្ច កំពុង បំពេញ ការងារ ក្រោម ដំណក់ ទឹកភ្លៀង យ៉ាង សស្រាក់សស្រាំ ដោយ មិន ខ្លាច នឿយហត់ ឡើយ ។ ពួកគាត់ ក៏ មាន គ្រួសារ នៅ ផ្ទះ ដែរ ប៉ុន្តែ ដើម្បី ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង កូវីដ១៩ និង ដើម្បី ក្តីសុខ ប្រជាជន ទាំងមូល ត្រូវ សុខចិត្ត លះបង់ ក្តីសុខ ផ្ទាល់ខ្លួន មួយ គ្រា សិន ៕
សូម ទស្សនា រូបភាព ២០ សន្លឹក បង្ហាញ ពី សកម្មភាព កម្លាំង សមត្ថកិច្ច បំពេញ ការងារ ក្រោម ដំណក់ ទឹកភ្លៀ ង៖
អត្រា មរណភាព របស់ ប្រទេស ស៊ុយអែត ក្នុង មនុស្ស ម្នាក់ គឺ ខ្ពស់ ជាង បណ្តា ប្រទេស ជិតខាង ស្ថិត ភាគ ខាងជើង របស់ ខ្លួន ច្រើន ដង ប៉ុន្តែ ទាប ជាង នៅ បណ្តា ប្រទេស អ៊ឺរ៉ុប ភាគ ច្រើន ដែល បាន ជ្រើសរើស ការចាត់ វិធានការបិទ ខ្ទប់ ប្រទេស ៕
ប្រជាពលរដ្ឋ ៧គ្រួសារ នៅ ស្រុក ស្វាយលើ ដែល រងគ្រោះ ដោយ ខ្យល់ កន្រ្តាក់ ទទួល អំណោយ មនុស្សធម៌ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប
( សៀមរាប ) ៖ នៅ ព្រឹក ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ លោក គុជ លីណា អនុប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប បាន អញ្ជើញ ជួប សំណេះសំណាល សួរសុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ បណ្ដាលឱ្យ រ បើក ដំបូល ចំនួន ៧គ្រួសារ នៅ ឃុំ តា សៀម ស្រុក ស្វាយលើ ។
គួរ បញ្ជាក់ ថា អំណោយ មនុស្សធម៌ ដែល បាន ផ្ដល់ជូន ១ គ្រួសារ ទទួលបាន៖ មុង១ ភួយ១ សារុង១ ក្រមា១ កន្ទេល១ ស័ង្កសី ១០សន្លឹក មី១ កេស ត្រីខ១យួរ អង្ករ ៣០ គីឡូក្រាម និង ថវិកា ១សែន រៀល ៕ ក្រសួង យុត្តិធម៌ បង្ហាញ តារាង ប្រៀបធៀប វិធានការពាក់ព័ន្ធ នឹង សកម្មភាព មុខរបរ ឬ អាជីវកម្ម ដែល តម្រូវឲ្យ កាត់បន្ថយ ចំនួន បុគ្គលិក ក្នុង តំបន់ បិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ
( ភ្នំពេញ ) ៖ ក្រសួង យុត្តិធម៌ នៅ ថ្ងៃទី ២២ ខែមេសា នេះ បាន បង្ហាញ តារាង ប្រៀបធៀប វិធានការពាក់ព័ន្ធ នឹង សកម្មភាព មុខរបរ ឬ អាជីវកម្ម ដែល តម្រូវឲ្យ កាត់បន្ថយ ចំនួន បុគ្គលិក ក្នុង តំបន់ បិទ ខ្ទប់ នៃ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ។ នេះ បើ យោង តាម តារាង ប្រៀបធៀប ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕
ក្រសួង យុត្តិធម៌ បង្ហាញ តារាង ប្រៀបធៀប វិធានការហាមឃាត់ ការធ្វើដំណើរ របស់ មន្រ្តី និង បុគ្គលិក នៃ ទីតាំង សកម្មភាព ការងារ មុខរបរ និង អាជីវកម្ម ដែល ត្រូវបាន អនុញ្ញាតឲ្យ ដំណើរការ នៅក្នុង តំបន់ បិទ ខ្ទប់ រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ
( ភ្នំពេញ ) ៖ ក្រសួង យុត្តិធម៌ នៅ ថ្ងៃទី ២២ ខែមេសា នេះ បាន បង្ហាញ តារាង ប្រៀបធៀប វិធានការហាមឃាត់ ការធ្វើដំណើរ របស់ មន្រ្តី និង បុគ្គលិក នៃ ទីតាំង សកម្មភាព ការងារ មុខរបរ និង អាជីវកម្ម ដែល ត្រូវបាន អនុញ្ញាតឲ្យ ដំណើរការ នៅក្នុង តំបន់ បិទ ខ្ទប់ នៃ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្តាល ។ នេះ បើ យោង តាម តារាង ប្រៀបធៀប ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕
ជាមួយនឹង ការអំពាវនាវ នេះ លោកស្រី ឱ វណ្ណឌីន បាន ស្នើ ដល់ បុគ្គល ដែល កំពុង ធ្វើចត្តាឡី ស័ក នៅ តំបន់ ក្រហម ហើយ ដែល ត្រូវ ចាក់ វ៉ាក់សាំង ដូស ទី២ ធ្វើ ការទំនាក់ទំនង ទៅកាន់ អាជ្ញាធរ មូលដ្ឋាន ដោយ បញ្ជាក់ ប្រាប់ អាជ្ញាធរ នូវ កាលបរិច្ឆេទ នៃ ការចាក់ដូសទី១ និង ប្រភេទ វ៉ាក់សាំង ដែល បាន ចាក់ ដើម្បីឱ្យ អាជ្ញាធរ រៀបចំ បញ្ជី ឈ្មោះ ជូន ទៅ គណៈកម្មការ ចំពោះ កិច្ច ដើម្បី រៀបចំ កម្មវិធី ចាក់ វ៉ាក់សាំង ។
ទោះជា យ៉ាង នេះ ក្តី លោកស្រី ឱ វណ្ណឌីន ក៏ បាន អំពាវនាវ ផងដែរ ដល់ បុគ្គល ដែល កំពុង ធ្វើចត្តាឡី ស័ក ទាំងអស់ អនុវត្ត ឱ្យ បាន ត្រឹមត្រូវ ក្នុង ការធ្វើចត្តាឡី ស័ក ឱ្យ បាន ១៤ ថ្ងៃ ហើយ មិន ត្រូវ ចេញ ក្រៅ នោះ ឡើយ ។ ការចេញ ក្រៅ ឬ ចល័ត របស់ អ្នក ធ្វើចត្តាឡី ស័ក អាច បង្ក ជា ហានិភ័យ ប្រសិនបើ រូប គាត់ ត្រូវបាន ឆ្លង កូវីដ១៩ ដែល អាច ដឹង នៅពេល ធ្វើតេស្ត ម្តង ទៀត ។
លោកស្រី ក៏ បាន ស្នើ ដល់ អ្នក ដែល ធ្វើចត្តាឡី ស័ក ទាំងនោះ កុំ ឱ្យ មាន ការបារម្ភ ព្រោះ ការចាក់ វ៉ាក់សាំង ដូស ទី២នេះ មិន មាន ហានិភ័យ ចំពោះ ភាពយឺតយ៉ាវ បន្តិចបន្តួច នោះ ទេ ប៉ុន្តែ នឹង មាន ប្រសិទ្ធភាព ថែម ទៀត ។
សូម បញ្ជាក់ ថា រដ្ឋបាល រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ បាន ចេញ សេចក្ដីសម្រេច កំណត់ តំបន់ មួយ ក្នុង ភូមិសាស្ដ្រ ខណ្ឌ មានជ័យ . ខណ្ឌ ពោធិ៍សែនជ័យ និង ខណ្ឌ ទួលគោក ដែល មាន ការឆ្លង រាលដាល ធ្ងន់ធ្ងរ នៃ ជំងឺ កូវីដ១៩ ជា « តំបន់ ក្រហម » ។ ទីតាំង ដែល ត្រូវ កំណត់ ជា « តំបន់ ក្រហម » នៅ រាជធានី ភ្នំពេញ នោះ រួម មាន៖
* ទី ១៖ ភូមិសាស្ដ្រ សង្កាត់ ស្ទឹងមានជ័យ ទី១. សង្កាត់ ស្ទឹងមានជ័យ ទី២ និង សង្កាត់ ស្ទឹងមានជ័យ ទី៣ នៃ ខណ្ឌ មានជ័យ * ទី ២៖ ភូមិសាស្ដ្រ សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ * ទី ៣៖ ភូមិ ១៤. ភូមិ ១៦ និង ភូមិ ១៧ នៃ សង្កាត់ បឹងសាឡាង ខណ្ឌ ទួលគោក ៕
ខាងក្រោម តារាង បញ្ជី បូកសរុប ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ របស់ ក្រសួង ការពារ ជា តិ៖ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ៖ ក្រុមការងារ វិមាន ឈ្នះ ឈ្នះ បាន ត្រៀម រៀបចំ ពិពរណ៍ និង ប្រមូល កត់ត្រា តាម ពេលវេលា សមស្រប ដើម្បី រក្សា រៀបចំ ទុក នៅ វិមាន ឈ្នះ ឈ្នះ អំពី ព្រឹត្តិការណ៍ កូវីដ១៩
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ ជា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ទទួលបន្ទុក កិច្ចការ ប្រវត្តិសាស្ត្រ និង អគ្គ នាយក អគ្គ នាយកដ្ឋាន នយោបាយ និង កិច្ចការ បរទេស ក្រសួង ការពារ ជាតិ បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ យប់ ថ្ងៃទី ២២ ខែមេសា ឆ្នាំ ២០២១ នេះ ថា ក្រុមការងារ វិមាន ឈ្នះ ឈ្នះ បាន ត្រៀម រៀបចំ ពិពរណ៍ និង ប្រមូល កត់ត្រា តាម ពេលវេលា សមស្រប ដើម្បី រក្សា រៀបចំ ទុក នៅ វិមាន ឈ្នះ ឈ្នះ អំពី ព្រឹត្តិការណ៍ កូវីដ - ១៩ នេះ ។
បើ តាម នាយ ឧត្តមសេនីយ៍ បាន ឱ្យដឹង ថា ពី ចម្លាក់ មាន រូបថត គំនូរ វីដេអូ ឯកសារ ច្បាប់ វិធានការ នានា ទុក ឱ្យ ជំនាន់ ក្រោយ បាន ដឹង ពី ទិដ្ឋភាព ការដឹកនាំ វីរៈ ភាព ស្មារតី សាមគ្គី ដើម្បី ប្រែក្លាយ ពី គ្រោះមហន្តរាយ កូវីដ១៩ នេះ ឱ្យ ទៅជា កម្លាំង ជាតិ និមិត្ត រួប ជាតិ និង ការឯកភាព ជាតិ ក្រោម ទង់ នយោបាយ ឈ្នះ ឈ្នះ តេជោ សែន កសាង អភិវឌ្ឍ ជាតិ បន្ត ទៀត យ៉ាង រឹងមាំ ។
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ បាន គូសបញ្ជាក់ ថា៖ « ក្នុង នេះ ក៏ យើង ឃើញ នូវ វិធានការ ដែល រាជ រដ្ឋាភិបាល ដែល អាជ្ញាធរ មាន ការ ពុះពារ ដើម្បី អនុវត្ត វិធានការពារ ដើម្បី ធានា នូវ អាយុជីវិត និង ការឆ្លង រាលដាល ដែល មាន ការរៀបចំ កម្លាំង គ្រប់ ផ្នែក រៀបចំ កម្លាំង ព្យាបាល កម្លាំង ពន្យល់ កម្លាំង ដឹកជញ្ជូន សព្វ បែប យ៉ាង ។ នេះ ហើយ ជា ជីវភាព និង រសជាតិ នៅក្នុង សម័យ កូវីដ - ១៩ ដែល យើង ត្រូវ កត់ត្រា ចារឹក ទុក ជា ប្រវត្តិសាស្ត្រ រយ ឆ្នាំ ទៅ មុខ » ។
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិត បាន លើកឡើង ថា បើ យើង មាន ការប្រៀបធៀប ថែម ទៀត ជាមួយ ប្រទេស តំបន់ នានា ក៏ ដូចជា ប្រទេស ដែល នៅ ឆ្ងាយ ដែល កំពុងតែ មាន ស្ថានភាព យ៉ាង ធ្ងន់ធ្ងរ និង បាន គ្រប់គ្រង ធូរស្រាល មក វិញ នោះ យើង នឹង កាន់តែ ឃើញ វិធានការ ជីវភាព និង វិធានការ ផ្សេង ៗ ដែល កាន់តែ ច្រើន ថែម ទៀត ក្លាយទៅជា គំនរ សកល នៃ ប្រវត្តិសាស្ត្រ នៃ សម័យ កូវីដ - ១៩ ដែល នឹង មាន រឿងរ៉ាវ ជាច្រើន ត្រូវ ចារិក នៅក្នុង ទំព័រ សម្រាប់ មនុស្សជាតិ ក្នុង សកលលោក ។
នាយ ឧត្តមសេនីយ៍ ក៏ ក្រើន រំឮក ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម ចូលរួម ប្រតិបត្តិ វិធានការ ទាំងឡាយ ឱ្យ បាន មុតមាំ យេីង នឹង បាន ឆ្លង ផុត រយៈកាល ដ៏ គ្រោះថ្នាក់ នេះ ៕ លោកជំទាវ ឌី សុជាតិ ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ លោកជំទាវ ឌី សុជាតិ ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោកជំទាវ ឌី សុជាតិ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោកជំទាវ ឌី សុជាតិ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
