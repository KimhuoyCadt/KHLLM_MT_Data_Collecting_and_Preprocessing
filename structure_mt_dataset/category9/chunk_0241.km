១៖ ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ៤០ នាក់ ថែម ទៀត ខណៈ អ្នកជំងឺ ចំនួន ៦នាក់ ជាសះស្បើយ
៣៖ សម្តេច តេជោ ហ៊ុន សែន កំណត់ ផែនការចាក់ វ៉ាក់សាំង កូវីដ១៩ ឱ្យ បាន ១លាន ដូស ក្នុង មួយ ខែ
៤៖ អគ្គ លេខាធិការ UN រិះគន់ ប្រទេស អ្នក មាន ៗ ដែល ប្រមូល វ៉ាក់សាំង ស្តុក ទុក លើស ពី តម្រូវការ និង គិត តែ ពី ប្រយោជន៍ ខ្លួន ឯង
៥៖ អ្នកជំងឺ ម្នាក់ ទៀត ហើយ អាយុ ៣៩ ឆ្នាំ បាន ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ នៅ មណ្ឌល សុខភាព ចាក់អង្រែ
៧៖ សម្តេច ម៉ែ ប្រទាន ព្រះរាជ សារ ថ្លែងអំណរគុណ ដ៏ ជ្រាលជ្រៅ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល ទិញ មន្ទីរពេទ្យ នគរ ទេព ហើយ ប្ដូរ ឈ្មោះ ទៅ ដាក់ មន្ទីរពេទ្យ « ហ្លួង ម៉ែ »
៩៖ ទីប្រឹក្សា នាយក រដ្ឋមន្ត្រី៖ វិទ្យុ អាស៉ី សេរី និង ខ្មែរ ស៉ី ឈ្នួល បរទេស មិន គួរ ផ្សាយ បំបាក់ទឹកចិត្ត ឧកញ៉ា ដែល បរិច្ចាគ ថវិកា ជួយ ទិញ មន្ទីរពេទ្យ « នគរ ទេព » នោះ ទេ
១០៖ លោក ចូ បៃ ដិន៖ « ការបង្ក្រាប ពីសំណាក់ កងកម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា ទៅ លើ ក្រុម បាតុករ គឺ ពិតជា ទង្វើ ដ៏ សាហាវ ឃោរឃៅ »
១១៖ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា៖ តម្លៃ អង្ករ កម្ពុជា នៅលើ ទីផ្សារ អន្តរជាតិ ក្នុង ត្រីមាស ទី១ ឆ្នាំ នេះ មាន ការកើនឡើង
១២៖ ស្ថានការណ៍ នៅ មីយ៉ាន់ម៉ា៖ « មនុស្ស ស្លាប់ ក្នុង បាតុកម្ម កើន ដល់ ៤៥៩ នាក់ . ក្រុម សកម្មជន អំពាវនាវ ឲ្យ បណ្តា កងទ័ព ជនជាតិ ភាគ តិច ចូលរួម ការតស៊ូ ប្រឆាំង យោធា »
១៣៖ អភិបាល ខេត្ត ត្បូងឃ្មុំ សម្រេច បិទ ផ្សារ ពោធិ៍ ស្រុក នៅ ស្រុក ពញា ក្រែក បណ្ដោះអាសន្ន ក្រោយ អ្នក កើត ជំងឺ កូវីដ បាន ទៅ ទីនោះ
១៧៖ រាជ រដ្ឋាភិបាល ដាក់ ឱ្យ ដំណើរការ គម្រោង ធានា ឥណទាន ដើម្បី ស្តារ អាជីវកម្ម របស់ សាជីវកម្ម ធានា ឥណទាន កម្ពុជា ទំហំ ទឹកប្រាក់ ២០០ លាន ដុល្លារ
១៩៖ អាជ្ញាធរ អំពាវនាវ ឱ្យ អ្នក ពាក់ព័ន្ធ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៤នាក់ ដែល ឆ្លង ចេញពី កន្លែង ព្យាបាល ជំងឺ « សាន ភីរ៉ូ » ទៅ តេសត្ត សុខភាព និង ធ្វើចត្តាឡី ស័ក
២១៖ ឆេះ រោងចក្រ ចម្រាញ់ ប្រេង នៅ ឥណ្ឌូណេស៊ី . មនុស្ស ជិត១ ពាន់ នាក់ ត្រូវ ជម្លៀស និង ៥នាក់ រងរបួស (
២៣៖ កប៉ាល់ យក្ស ដែល ជាប់គាំង នៅ ព្រែក ជីក ស៊ុយអេ ត្រូវ ទាញ ក្បាល ឲ្យ ងាកចេញ ពី ច្រាំង បាន ជាង ១០០ ម៉ែត្រ
២៤៖ ថៃ រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ ចំនួន ៣៩ នាក់ ទៀត នៅក្នុង របាយការណ៍ ថ្ងៃចន្ទ នេះ
២៥៖ បទ វិភាគ អន្តរជាតិ៖ សង្រ្គាម ស៊ីវិល នៅ មីយ៉ាន់ម៉ា អាច ផ្ទុះឡើង ដែរ ឬ ទេ ?
១៖ ចំណេះដឹង ទូទៅ៖ តើ ប្រទេស ណា ដែល ទទួលស្គាល់ ឯករាជ្យ របស់ សហរដ្ឋ អាមេរិក មុន គេ បង្អស់ ?
៣៖ គ្រូ ថ្មី ក្រុម គោ ព្រៃ កម្ពុជា ថា លោក នឹង ទទួលខុសត្រូវ គ្រប់ បញ្ហា ទោះបី លំបាក ឬ ស្មុគស្មាញ យ៉ាងណា ក៏ដោយ
៤៖ តារាចម្រៀង ណុប បាយ៉ារិទ្ធ ទទូច ដល់ បងប្អូន ខ្មែរ គួរ ប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ ពី ជំងឺ កូវីដ - ១៩ ខណៈ ខ្លួន មាន អាការៈ ធូរស្បើយ ច្រើន
បើ តាម អ្នកនាំពាក្យ . គិត ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ២៩ ខែមីនា ក្នុង ឆ្នាំ ២០២១ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៦៧.៩០៨ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៤៩.៧៦៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១៨. ១៤៦ គ្រឿង ។
ក្រសួង អប់រំ ហាម មិន ឲ្យ គ្រឹះស្ថាន សិក្សា រដ្ឋ - ឯកជន សហការ ឬ ទទួល ការឧបត្ថម្ភ ពី ឧស្សាហក រ ថ្នាំជក់ ឡើយ
( ភ្នំពេញ ) ៖ ដោយសារ សង្កេតឃើញ ថា គ្រឹះស្ថាន សិក្សា មួយចំនួន តូច ប្រើប្រាស់ ស្លាកសញ្ញា ពាណិជ្ជកម្ម ថ្នាំជក់ តាំង នៅក្នុង កម្មវិធី នានា ក្នុង គ្រឹះស្ថាន សិក្សា របស់ ខ្លួន នោះ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ចេញ សេចក្តីណែនាំ ហាមឃាត់ កិច្ចសហការ និង សហប្រតិបត្តិការ រវាង ឧស្សាហក រ ថ្នាំជក់ ជាមួយ អង្គភាព ចំណុះ ក្រសួង មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី - ខេត្ត ការិយាល័យ អប់រំ យុវជន និង កីឡា នៃ រដ្ឋបាល ក្រុង - ស្រុក - ខណ្ឌ គ្រឹះស្ថាន សិក្សា គ្រប់ កម្រិត ទាំង សាធារណៈ និង ឯកជន ។
សេចក្តីណែនាំ នេះ គឺជា ផ្នែក មួយ នៃ ការចូលរួម អនុវត្ត អនុសញ្ញា ស្តីពី ការត្រួតពិនិត្យ ផលិតផល ថ្នាំជក់ ផងដែរ ។ ក្នុង នោះ មាត្រា ៥.៣ នៃ អនុសញ្ញា បាន ចែង ថា សុខភាព សាធារណៈ និង ឧស្សាហកម្ម ថ្នាំជក់ មាន ទំនាស់ ផលប្រយោជន៍ នឹង គ្នា មិន អាច ផ្សះផ្សា បាន ដោយសារ ក្រុមហ៊ុន ថ្នាំជក់ ផលិត និង ផ្សព្វផ្សាយ លក់ ផលិតផល ថ្នាំជក់ ដែល តាមរយៈ លក្ខណៈ វិទ្យាសាស្រ្ត បាន រកឃើញ ថា បង្កឱ្យ ញៀន ឈឺ ពិការ ស្លាប់ និង បញ្ហា សង្គម ផ្សេង ៗ រួមទាំង ភាពក្រីក្រ ។
បន្ថែម លើ នេះ ទៀត តាមរយៈ ការសិក្សា ពី ឯកសារ ផ្ទៃក្នុង របស់ ក្រុមហ៊ុន ថ្នាំជក់ អន្តរជាតិ ឧស្សាហកម្ម ថ្នាំជក់ ប្រើប្រាស់ យុទ្ធសាស្រ្ត ទំនួល ខុសត្រូវ សង្គម ដើម្បី បង្កើត ទំនាក់ទំនង ជាមួយ បុគ្គល ដែល មាន សិទ្ធ សម្រេច បង្កើត ឥទ្ធិពល ក្នុង ការរៀបចំ គោល នយោបាយ និង សាង កេរ្តិ៍ឈ្មោះ របស់ ក្រុមហ៊ុន ។ ក្រុមហ៊ុន ថ្នាំជក់ ក៏ បាន ប្រើប្រាស់ កម្មវិធី ជួយ សង្គម ដើម្បី បង្កើន ទំនុកចិត្ត បង្កើន ប្រាក់ ចំណេញ និង រារាំង ការអនុវត្ត គោល នយោបាយ ការពារ សុខភាព ប្រកបដោយ ប្រសិទ្ធភាព ។
បើ យោង តាម ការស្រាវជ្រាវ របស់ អង្គការ សហ ប្រជាជាតិ ការប្រើប្រាស់ ថ្នាំជក់ ជា កត្តា ចម្បង មួយ នៃ ការស្លាប់ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ប្រមាណ ១៥.០០០ នាក់ ក្នុង មួយ ឆ្នាំ ៗ ហើយ ថវិកា ប្រមាណ ៦៤៩ លាន ដុល្លារ ត្រូវបាន ខាតបង់ ៕
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បង្ហាញ តារាង តម្លៃ ស្រូវ នៅ វាល ស្រែ ដែល កំពុង ប្រមូល ផល តាម បណ្តា ខេត្ត មួយចំនួន សម្រាប់ ថ្ងៃទី ២៩ ខែមីនា នេះ
តាម សេចក្តីប្រកាស ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា អ្នកជំងឺ ស្លាប់ បាត់បង់ជីវិត នេះ មាន អាស័យដ្ឋាន នៅ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ដោយ លទ្ធផល ទទួលបាន វិជ្ជមាន កូវីដ១៩ នៅ ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២១ ហើយ បាន ស្លាប់ នៅ វេលា ម៉ោង ២១៖ ៤០ នាទី ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២១ ដោយ ជំងឺ ស្ទះ សរសៃ ឈាម បេះដូង ភ្លាម ៗ ។
គិត ត្រឹម ម៉ោង ៧៖០០ នាទី ព្រឹក ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២១ នេះ កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង កូវីដ១៩ សរុប ចំនួន ២២៧៣ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ ចំនួន ១១៧២ នាក់ . អ្នក កំពុង សម្រាក ព្យាបាល ជំងឺ ចំនួន ១០៨៧ នាក់ . ស្លាប់ ចំនួន ១១នាក់ និង ៣នាក់ ទៀត ស្លាប់ ដោយសារ ជំងឺ ផ្សេង ពេល កំពុង ទទួល ការព្យាបាល ជំងឺ កូវីដ១៩ ៕ អាជ្ញាធរ ជាតិ អប្សរា យកចិត្តទុកដាក់ លើ សំណើ សុំ សាងសង់ របស់ ប្រជាពលរដ្ឋ នៅក្នុង តំបន់ ឧទ្យាន អង្គរ
( សៀមរាប ) ៖ សម្រាប់ ខែមីនា ឆ្នាំ ២០២១ នេះ ក្រុមការងារ ជំនាញ នៃ នាយកដ្ឋាន រៀបចំ ដែនដី និង គ្រប់គ្រង លំនៅដ្ឋាន ក្នុង ឧទ្យាន អង្គរ បាន ចុះ ពិនិត្យ លក្ខខណ្ឌ ការរស់នៅ និង ប្រើប្រាស់ ទីតាំង ស្នើសុំ របស់ ប្រជាពលរដ្ឋ បាន ចំនួន ១២៩ គ្រួសារ រួម មាន៖ ក្រុង សៀមរាប ៣២ គ្រួសារ ស្រុក បន្ទាយស្រី ២២ គ្រួសារ ស្រុក អង្គរ ធំ ១៣គ្រួសារ ស្រុក ប្រាសាទ បាគង ៣៨ គ្រួសារ ស្រុក ពួក ១០គ្រួសារ ស្រុក សូទ្រនិគម ៦គ្រួសារ និង ស្រុក ស្វាយលើ ៨គ្រួសារ ។
ដោយឡែក ក្នុង រយៈពេល ដូចគ្នា នេះ ដែរ ប្រជាពលរដ្ឋ ដែល មាន លក្ខខណ្ឌ គ្រប់គ្រាន់ ដើម្បី ទទួលបាន ការអនុញ្ញាត ក្រុមការងារ ផ្នែក ស្ថាបត្យកម្ម បាន ជួយ រៀបចំ គំនូស ប្លង់ បាន ចំនួន ៥០ គ្រួសារ រួម មាន៖ ស្រុក អង្គរ ធំ ៦គ្រួសារ ក្រុង សៀមរាប ១០គ្រួសារ ស្រុក ប្រាសាទ បាគង ៨គ្រួសារ ស្វាយលើ ៤គ្រួសារ ស្រុក ពួក ១១គ្រួសារ និង ស្រុក បន្ទាយស្រី ១១គ្រួសារ ។
សូម បញ្ជាក់ ថា រាល់ ការស្នើសុំ ច្បាប់ ជួសជុល គឺ ពុំ មាន ការបង់ប្រាក់ ទេ ៕
រដ្ឋបាល ខេត្ត ព្រះសីហនុ អំពាវនាវ ឲ្យ ពិនិត្យ លទ្ធភាព បញ្ចុះ តម្លៃ ឬ លើកលែង ការបង់ ថ្លៃ ឈ្នួល ផ្ទះ ឈ្នួល បន្ទប់ និង ឈ្នួល តូប រាន ស្តង់ លក់ដូរ និង បង់ ការប្រាក់ ឬ កាត់បន្ថយ ការប្រាក់ ក្នុង ដំណាក់កាល កូវីដ
( ព្រះសីហនុ) ៖ រដ្ឋបាល ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដី អំពាវនាវ ឲ្យ មាន ការពិនិត្យ លទ្ធភាព បញ្ចុះ តម្លៃ ឬ លើកលែង ការបង់ ថ្លៃ ឈ្នួល ផ្ទះ ឈ្នួល បន្ទប់ និង ឈ្នួល តូប រាន ស្តង់ លក់ដូរ លើកលែង ការបង់ ការប្រាក់ ឬ កាត់បន្ថយ ការប្រាក់ ឬ ពន្យា ពេល នៃ ការបង់ ការប្រាក់ ឬ ពន្យា ការបង្វិល សង ថ្លៃ ដើម ក្នុង ដំណាក់កាល នៃ ការផ្ទុះ ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភៈ » នេះ រហូតដល់ ស្ថានភាព នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ មាន សភាព ធូរស្រាល ឡើងវិញ ។
១៖ ពិនិត្យ លទ្ធភាព បញ្ចុះ តម្លៃ ឬ លើកលែង ការបង់ ថ្លៃ ឈ្នួល ផ្ទះ ឈ្នួល បន្ទប់ និង ឈ្នួល តូប រាន ស្តង់ លក់ដូរ លើកលែង ការបង់ ការប្រាក់ ឬ កាត់បន្ថយ ការប្រាក់ ឬ ពន្យា ពេល នៃ ការបង់ ការប្រាក់ ឬ ពន្យា ការបង្វិល សង ថ្លៃ ដើម ក្នុង ដំណាក់កាល នៃ ការផ្ទុះ ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភៈ » នេះ រហូតដល់ ស្ថានភាព នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ មាន សភាព ធូរស្រាល ឡើងវិញ ។
២៖ យោគយល់ អធ្យាស្រ័យ ចំពោះ ការយឺតយ៉ាវ ក្នុង ការបង់ ថ្លៃ ឈ្នួល ផ្ទះ ឬ ឈ្នួល បន្ទប់ ឬ ឈ្នួល តូប រាន ស្តង់ លក់ដូរ ពី អ្នក ស្នាក់ នៅ ពី អ្នកលក់ដូរ ពី អ្នក ខ្ចី ប្រាក់ ដោយ មិន គួរ ពិន័យ ឲ្យ បង់ប្រាក់ បន្ថែម ឬ ដក យក ប្រាក់ កក់ មក ទូទាត់ សង ថ្លៃ ប្រាក់ ឈ្នួល ហើយ គួរ បន្ត អនុញ្ញាត ឲ្យ ពួកគាត់ បាន ស្នាក់ នៅ លក់ដូរ បន្ត ទៀត មិន គួរ បណ្តេញ ពួកគាត់ ចេញ ឬ បញ្ឈប់ កិច្ចសន្យា ជួល ឬ ដកហូត យក ឯកសារ វត្ថុធានា ផ្សេង ៗ ដាក់ លក់ ឡាយ ឡុង ឡើយ ។
៣៖ ត្រូវ អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត នូវ វិធានការ « ការពារ និង ៣កុំ » របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សេចក្តីណែនាំ របស់ ក្រសួង សុខាភិបាល ឲ្យបាន ខ្ជាប់ខ្ជួន ។
រដ្ឋបាល ខេត្ត ព្រះសីហនុ សង្ឃឹម យ៉ាង មុតមាំ ថា លោក ឧកញ៉ា លោក លោកស្រី ដែល ជា ម្ចាស់ ផ្ទះ ជួល បន្ទប់ ជួល ម្ចាស់ ផ្សារ ម្ចាស់ តូប រាន ស្តង់ លក់ដូរ ម្ចាស់ ធនាគារ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ទាំងអស់ នៅក្នុង ខេត្ត ព្រះសីហនុ នឹង ចូលរួម អនុវត្ត ខ្លឹមសារ នៃ សេចក្តី អំពាវនាវ នេះ ប្រកបដោយ ទឹកចិត្ត សប្បុរសធម៌ មាន ស្មារតី យោគយល់ អធ្យាស្រ័យ ខ្ពស់ និង ឈរ លើ ស្មារតី សាមគ្គី ជាតិ ជា ធ្លុង មួយ ជាក់ ជា មិន ខាន ៕ ទីបំផុត កោះ តៃវ៉ាន់ សម្រេច ឈប់ ប្រើ យន្តហោះ ចម្បាំង ដើម្បី តាម ស្ទាក់ យន្តហោះ ចិន ទៀត ហើយ
លោក Chang បាន បន្ត ទៀត ថា ក្រោយ មកវិធីសាស្រ្ត នៃ ការឆ្លើយតប ខាងលើ ត្រូវបាន ផ្លាស់ប្តូរ ដោយ យោធា តៃវ៉ាន់ នឹង ចល័ត យន្តហោះ ដែល យឺត ល្មម ប៉ុណ្ណោះ ក្នុង ករណី ដែល ចិន ធ្វើ ដូចគ្នា ប៉ុន្តែ តៃវ៉ាន់ ក៏ បាន បន្ត សម្រួល មធ្យោបាយ ឆ្លើយតប ថែម ទៀត ។ បើ តាម លោក Chang ឥឡូវ តៃវ៉ាន់ ភាគ ច្រើន កំពុង ប្រើប្រាស់ ប្រព័ន្ធ មីស៉ីល នៅលើ ដី ជំនួស វិញ ដើម្បី តាមដាន យន្តហោះ យោធា របស់ ចិន ព្រោះ វា ចំណេញ ធនធាន ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃសុក្រ សប្តាហ៍ កន្លងទៅ យន្តហោះ យោធា ចិន សរុប ដល់ ទៅ ២០ គ្រឿង បាន ចូលមក ក្នុង តំបន់ ADIZ របស់ តៃវ៉ាន់ ដែល ជា ចំនួន ច្រើន បំផុត ពុំ ធ្លាប់ មាន ។ ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ ធ្លាប់ បាន និយាយ កាលពី ខែតុលា ឆ្នាំ មុន ថា តៃវ៉ាន់ បាន ចំណាយ ថវិកា ជិត ៩០០ លាន ដុល្លារ ក្នុង ឆ្នាំ ២០២០ លើ ការចល័ត យន្តហោះ ចម្បាំង ឲ្យ ទៅ ស្ទាក់ យន្តហោះ យោធា ចិន និង ថា សម្ពាធ ដែល ពួកគេ កំពុង ប្រឈម គឺ ខ្លាំងក្លា ណាស់ ។
ទោះបីជា កងទ័ព អាកាស តៃវ៉ាន់ ទទួលបាន ការហ្វឹកហាត់ យ៉ាង ល្អ ក៏ ពិត មែន ប៉ុន្តែ បើ ធៀប ជាមួយ កងទ័ព អាកាស ចិន វិញ នោះ គឺ ចិន មាន អានុភាព ជាង ឆ្ងាយ ខ្លាំង ណាស់ ។ ការប្រកាស ពី ការផ្លាស់ប្តូរ យុទ្ធសាស្ត្រ ខាងលើ នេះ បាន កើត មាន ឡើង បន្ទាប់ពី យន្តហោះ ចម្បាំង តៃវ៉ាន់ បាន បុក គ្នា និង ធ្លាក់ កាលពី មួយ សប្តាហ៍ មុន ដែល នាំឲ្យ មាន ការខាតបង់ យ៉ាង ខ្លាំង ៕
វិទ្យាល័យ ពេជ្រ ចិន្តា នៅ ស្រុក ភ្នំព្រឹក ខេត្ត បាត់ដំបង សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ប្រព័ន្ធ សាលារៀន ឌីជីថល «Wiki School» សម្រាប់ ការសិក្សា តាម ប្រព័ន្ធ អេឡិចត្រូនិក
លោក ងន់ ម័រ បាន បញ្ជាក់ ថា «Wiki School ជា កម្មវិធី គ្រប់គ្រង សាលា បែប ឌីជីថល ដែល អនុញ្ញាតឲ្យ លោកគ្រូ អ្នកគ្រូ អាច ដាក់ កិច្ចការ ផ្ទះ ឬ ការងារ គម្រោង ឲ្យ សិស្ស តាម កម្មវិធី ទូរស័ព្ទ ដៃ ហើយ អាច ឲ្យ សិស្ស មាតាបិតា សិស្ស ផ្ញើ សារ ទៅ គ្រូបង្រៀន ឬ សាលារៀន ដើម្បី សាកសួរ ព័ត៌មាន ផ្សេង ៗ ហើយក៏ អាច ឲ្យ សាលារៀន ឬ គ្រូបង្រៀន អាច ផុស ហ្វីត នៅក្នុង ប្រព័ន្ធ ដើម្បីឲ្យ សិស្ស មាតាបិតា សិស្ស អាច ទទួល ព័ត៌មាន ព្រមទាំង អាច បញ្ចេញមតិ ឬ អាច បញ្ចេញ អារម្មណ៍ ចូលចិត្ត បាន ដែរ » ។
សារំលែក មរណទុក្ខ និង ថវិកា ចំនួន ៣លាន រៀល របស់ សម្តេច ក្រឡាហោម ស ខេង ត្រូវបាន នាំយក ជូន ដល់ ក្រុមគ្រួសារ សព លោក អនុ សេនីយ៍ ឯក ថ ន ចាន់ ធឿន ដែល ស្លាប់ ដោយ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២១ លោក វរសេនីយ៍ ឯក សែម រតនា នាយ ការិយាល័យ ចរាចរណ៍ ផ្លូវគោក តំណាង ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន នាំយក អំណោយ ឧបត្ថម្ភ របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ជូន ដល់ ក្រុមគ្រួសារ សព លោក អនុ សេនីយ៍ ឯក ថ ន ចាន់ ធឿន ដែល ស្លាប់ ដោយ ជំងឺ កូវីដ១៩ ។
អំណោយ រួម មាន៖ ប្រាក់ ឧបត្ថម្ភ ចំនួន ៣លាន រៀល និង សារ រំលែក មរណទុក្ខ ផ្តល់ ជូន លោកស្រី ធឿន សុធារ័ត្ន ត្រូវ ជា កូនស្រី បង្កើត នៃ សព លោក អនុ សេនីយ៍ ឯក ថ ន ចាន់ ធឿន មន្ត្រី នគរបាល ចរាចរណ៍ ផ្លូវគោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដែល បាន ទទួលមរណៈភាព ដោយ ជំងឺ COVID-19 កាលពី ថ្ងៃទី ២៥ ខែមីនា ឆ្នាំ ២០២១ នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
អំណោយ ឧបត្ថម្ភ ដែល បាន ផ្តល់ ជូន នេះ គឺ ផ្តល់ ជូន តាមរយៈ លោក ពៅ វុទ្ធី មេភូមិ ក្តី ចាស់ ឃុំ ព្រែក លួង ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្តាល ៕
គួរ បញ្ជាក់ ថា របាយការណ៍ ចុងក្រោយ ដែល ក្រុម ជំនាញ WHO បាន ចេញ នៅ ពេល នេះ គឺ ត្រូវបាន ទន្ទឹងរង់ចាំ ដោយ អន្តរជាតិ ជា យូរ ណាស់ មកហើយ គិត ចាប់តាំងពី ក្រុម ជំនាញ នេះ បាន ចាកចេញ ពី ទីក្រុង វូហាន កាលពី មួយ ខែ មុន មក ម្ល៉េះ ។ យ៉ាងណា ក៏ដោយ ការចេញ របាយការណ៍ យឺត នេះ ត្រូវបាន ក្រុម ជំនាញ អន្តរជាតិ WHO អះអាង ថា ដោយសារតែ ពួកគេ ត្រូវការ ពេលវេលា ដើម្បី រៀបចំ លំដាប់លំដោយ នៃ សម្មតិកម្ម ។
លោក បាន ផ្តល់ ជា គំនិត វិញ ថា « បើ ក្រុម មនុស្ស ខ្មែរ មួយ ក្រុម ដែល កំពុង ស៉ី ឈ្នួល បរទេស ខំ ផ្សព្វផ្សាយ អាក្រក់ គ្រប់ រឿង ពី កម្ពុជា មាន ឈាម ជា ខ្មែរ ពិតប្រាកដ គួរ ណាស់ តែ លើកទឹកចិត្ត ដល់ ក្រុម ឧកញ៉ា ទាំងនោះ ដែល បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការ ការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ស្ថានភាព នេះ មិន មែន មក បំបាក់ទឹកចិត្ត សប្បុរស របស់ ពួកគាត់ បែប នេះ ទេ » ។
សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ២៧ ខែមីនា ឆ្នាំ ២០២១ បាន ប្រកាស ពី ការទិញ មន្ទីរពេទ្យ នគរ ទេព ហើយ ប្ដូរ ឈ្មោះ ទៅ ដាក់ ថា មន្ទីរពេទ្យ « ហ្លួង ម៉ែ » វិញ ដើម្បី ប្រើប្រាស់ ជា មន្ទីរពេទ្យ របស់ រដ្ឋ ។ ក្រោយ ការប្រកាស របស់ សម្ដេច តេជោ ហ៊ុន សែន មាន សប្បុរស ជន ជាច្រើន នាក់ ( អ្នក ឧកញ៉ា និង ឧកញ៉ា ) បាន ចូលរួម បរិច្ចាគ ធនធាន ផ្ទាល់ខ្លួន ដើម្បី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការទិញ មន្ទីរពេទ្យ មួយ នេះ ។
សម្ដេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ សម្តេច ម៉ែ បាន ប្រោសប្រទាន ព្រះរាជ សារ សម្តែង នូវ អំណរគុណ ដ៏ ខ្ពង់ខ្ពស់ និង សូម កោតសរសើរ ដ៏ កក់ក្តៅ បំផុត ចំពោះ ការខិតខំ បំពេញ ភារកិច្ច របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ព្រមទាំង សមាជិក - សមាជិកា ដ៏ ឧត្តុង្គឧត្តម ទាំងអស់ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា ចំពោះ ការទិញ មន្ទីរពេទ្យ ខាងលើ ។ សម្តេច ម៉ែ បាន មាន ព្រះតម្រិះ ចាត់ទុក ថា នោះ ជា ការងារ ដ៏ ល្អ មួយ ដើម្បី ជា ឧត្តម ប្រយោជន៍ ជាតិ មាតុភូមិ និង ប្រជារាស្ត្រ កម្ពុជា ៕
លោក យ៉ដ សឺក (Yawd Serk) ជា ប្រធាន ក្រុមប្រឹក្សា ស្ដារ ឡើងវិញ នៃ រដ្ឋ សាន ហៅ កាត់ RCSS កាលពី ថ្ងៃទី ២៧ ខែមីនា បាន ចេញមុខ ព្រមាន ចំៗ ថា ក្រុម ប្រដាប់ អាវុធ ជនជាតិ ភាគ តិច មីយ៉ាន់ម៉ា ទាំងអស់ នឹង មិន ឈរ ស្ងៀម ដោយ មិន ធ្វើ សកម្មភាព អ្វី សោះ នោះ ឡើយ ប្រសិនបើ កងកម្លាំង យោធា មីយ៉ាន់ម៉ា នៅតែ បន្ត សម្លាប់ ក្រុម បាតុករ ។ ការព្រមាន បែប នេះ ធ្វើឡើង នៅ ចំពេល មាន សេចក្ដីរាយការណ៍ ជា បន្តបន្ទាប់ ថា កងកម្លាំងប្រដាប់អាវុធ ជនជាតិ ដើម ភាគ តិច ខ្លះ ចាប់ផ្ដើម ប៉ះទង្គិច គ្នា ដោយ អាវុធ ជាមួយ យោធា មីយ៉ាន់ម៉ា ។
បេសកជន ពិសេស អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក កិច្ចការ មីយ៉ាន់ម៉ា លោក Dr. Sasa បាន ព្រមាន កាលពី ពេល ថ្មី ៗ នេះ ថា បើសិនជា បាតុករ នៅតែ ត្រូវបាន សម្លាប់ កាន់តែ ច្រើន ឡើង នោះ សង្រ្គាម ស៊ីវិល មួយ អាចនឹង ផ្ទុះឡើង ហើយ មេដឹកនាំ យោធា បច្ចុប្បន្ន គឺ លោក មីន អោង ហ្លេង អាចនឹង ជួប ជោគវាសនា ដូចជា អតីត មេដឹកនាំ លីប៊ី លោក មូអាំ ម៉ា ហ្គាដាហ្វី ដែល ត្រូវបាន ក្រុម បាតុករ ចាប់ខ្លួន និង បាញ់ សម្លាប់ កាលពី ខែតុលា ឆ្នាំ ២០១១ ។
រុស្ស៊ី ជាពិសេស គឺ ចិន តែម្ដង ដែល ជា អ្នកជិតខាង ភូមិ ផង របង តែ មួយ បាន ចាត់ទុក ថា មីយ៉ាន់ម៉ា ជា តំបន់ យុទ្ធសាស្ត្រ ដែល អាច ជួយ ឱ្យ ពួកគេ រក្សា ឥទ្ធិពល និង ទប់ស្កាត់ ការពង្រីក ឥទ្ធិពល របស់ អាមេរិក នៅក្នុង តំបន់ ៕
រដ្ឋបាល ខេត្ត កណ្ដាល បន្ត ទទួលបាន អំណោយ ពី សប្បុរសជន ដើម្បី រួមគ្នា បង្ការ ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩
លោក គង់ សោភ័ណ្ឌ ក្នុង នាម រដ្ឋបាល ខេត្ត និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត កណ្តាល បាន ថ្លែងអំណរគុណ ដោយ ស្មោះ ចំពោះ លោក បណ្ឌិត និង លោកស្រី ទាំង ទ្វេ ដែល បាន បរិចាគ ថវិកា សម្ភារ យ៉ាង មាន តម្លៃ សម្រាប់ ជួយ រដ្ឋបាល ខេត្ត នៅក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ដែល កំពុងតែ បង្ក ហានិភ័យ មក លើ សុខភាព និង ជីវិត ប្រជាជន កម្ពុជា ។
អំណោយ ដែល លោក បណ្ឌិត ស៊ាង ប៊ុន លាង និង លោកស្រី ហ៊ុន ប៊ុន ធឿន និង លោកស្រី ហៀវ លន់ ប្រគល់ជូន រដ្ឋបាល ខេត្ត កណ្ដាល រួម មាន៖ អង្ករ ២៥តោន ទឹកត្រី ១០កេស ទឹកស៊ីអ៊ីវ ១០កេស ទឹក សុទ្ធ ១០០ កេស ម៉ាស ១២កេះ ធំ អាកុល ១០កាន និង ថវិកា ៤០ លាន រៀល ។
