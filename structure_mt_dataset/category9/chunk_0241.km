* ទី១៖ បុគ្គលិក មន្ត្រីរាជការ បុគ្គលិក ជាប់ កិច្ចសន្យា និង បុគ្គលិក ផ្សេង ៗ ទៀត ដែល មាន អាសយដ្ឋាន រស់ នៅ បច្ចុប្បន្ន ក្នុង ទីតាំង ខណ្ឌ ឫស្សីកែវ នៃ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ សូម ទៅ ទទួល វ៉ាក់សាំងស៊ីណូ វ៉ាក់ដូស ទី២ នៅ តាម ទីតាំង ដែល នៅជិត បំផុត ចំនួន ៣កន្លែង រួម មាន៖ ទី១. ទីស្តីការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ទី២. តារាង បាល់ទាត់ របស់ អគ្គិសនី កម្ពុជា និង ទី៣. វិទ្យាល័យ ឫស្សីកែវ ។
ទី ២៖ ចំពោះ បុគ្គលិក មន្ត្រីរាជការ បុគ្គលិក ជាប់ កិច្ចសន្យា និង បុគ្គលិក ផ្សេង ៗ ទៀត ដែល មាន អាសយដ្ឋាន រស់ នៅ បច្ចុប្បន្ន ក្នុង ទីតាំង ខណ្ឌ ទាំង ១៣ នៃ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ( ក្រៅពី ខណ្ឌ ឫស្សីកែវ ) សូម ទៅ ទទួល វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ដូស ទី២ នៅ តាម បណ្តា ទីតាំង នៅជិត បំផុត ដែល បាន រៀបចំ ដោយ ក្រសួង សុខាភិបាល ចៀសវាង ការចល័ត ឆ្លងកាត់ ទីតាំង ភូមិសាស្ត្រ នៃ ខណ្ឌ នីមួយ ៗ ក្នុង អំឡុង ពេល នៃ ការអនុវត្ត វិធានការបិទ ខ្ទប់ និង បំរាម គោចរ របស់ រាជ រដ្ឋាភិបាល ៕
លោក ប្រធាន ច្រក បាន បន្ថែម ថា លោក ខិតខំ ពន្យល់ ដល់ ភាគី វៀតណាម ពេញ មួយ ថ្ងៃ មក ហើយ ជុំវិញ ការមាន វិធានការ ល្អ របស់ កម្ពុជា ហើយ ស្នើឲ្យ មាន ការបើក លក់ បន្លែ មក កម្ពុជា ធម្មតា វិញ ទៅ ប៉ុន្តែ ខាង វៀតណាម នៅតែ មិន ព្រម ហើយនិយាយ ដដែល ៗ ថា ខ្លាច ឆ្លង ជំងឺ ពី កម្ពុជា ព្រោះ អាជីវករ នៅ ផ្សារ ដើម គរ ឆ្លង ច្រើន ។
ទន្ទឹមនឹង ករណី នេះ ដែរ នៅឯ ច្រក ក្អម សំណរ ឯណោះ វិញ លោក សុទ្ធ សាវឿន ជា ប្រធាន ច្រក បាន ថ្លែង ប្រាប់ ដែរ ថា ខាង ច្រក របស់ លោក មិន មាន ការដឹកជញ្ជូន បន្លែ ធំដុំ ទេ មាន តែ បន្ដិចបន្ដួច ប៉ុណ្ណោះ ខណៈ ដែល លោក បាន អនុវត្តន៍ វិធានការ កូវីដ ចំពោះ ការចេញ - ចូល របស់ វៀតណាម មក កម្ពុជា និង ពី កម្ពុជា ទៅ វៀតណាម ធ្វើ យ៉ាងណា ទប់ស្កាត់ មិន ឲ្យ មាន ការឆ្លង ជំងឺ កូវីដ ជាដាច់ខាត ។
សូម រំលឹក ថា ប៉ុន្មាន ថ្ងៃ មុន នេះ ពលរដ្ឋ ស្រុក ស្អាង ដែល ដឹក បន្លែ មក លក់ នៅ ក្រុង តាខ្មៅ តាមរយៈ ឡាន ទួរី ស ប៉ុន្តែ មិន ត្រូវបាន គេ អនុញ្ញាតឲ្យ ឆ្លងកាត់ ចូល ក្រុង ឡើយ រីឯ ដំណាំ កសិផល របស់ ពួកគាត់ ត្រូវ ដឹក យក ទៅ ផ្ទះ វិញ ដែល បង្កឲ្យ មាន ការខូចខាត ៕
( កំពត ) ៖ ជនជាតិ ចិន ២នាក់ បន្លំ បើក រថយន្ដ សង្គ្រោះ បន្ទាន់ ក្នុង គោលបំណង ឆ្លងកាត់ ខេត្ត កំពត ទៅ ខេត្ត ព្រះសីហនុ បំពាន សេចក្ដីណែនាំ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការបិទ ខ្ទប់ មិន ឲ្យ មាន អ្នកធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ដែល កម្លាំង នគរបាល ចាប់ខ្លួន នោះ ត្រូវបាន បញ្ជូន ទៅកាន់ សាលាដំបូង ខេត្ត កំពត ដើម្បី ផ្ដន្ទាទោស តាម ច្បាប់ សិន មុន បណ្ដេញចេញ ពី កម្ពុជា ។
កាលពី ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ តុលាការ ខេត្ត កំពត បាន ចេញ ដីកា ឃុំ ខ្លួន ពួកគេ ទាំង ២នាក់ ដាក់ ពន្ធនាគារ ជា បណ្តោះអាសន្ន ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២១ នេះ ស្នងការ នគរបាល ខេត្ត កំពត លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន ឲ្យដឹង ថា បន្ទាប់ពី កម្លាំង នគរបាល ជំនាញ បញ្ចប់ ការសួរនាំ ជនជាតិ ចិន ទាំង ២នាក់ នេះ ត្រូវបាន កសាង សំណុំរឿង ដើម្បី បញ្ជូន ទៅ តុលាការ ផ្ដន្ទាទោស ទើប បណ្ដេញចេញ ពី កម្ពុជា តាម ក្រោយ ។
គួរ ជម្រាប ថា ប្រតិបត្តិការ នេះ កម្លាំង នគរបាល ផែន អន្ដោប្រវេសន៍ ខេត្ត កំពត ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី សែម សោភ័ណ សហការ ជាមួយ នគរបាល ជំនាញ ឃាត់ ជនជាតិ ចិន ទាំង ២នាក់ នេះ តាំងពី ថ្ងៃទី ១៤ ខែមេសា ឆ្នាំ ២០២១ ។
ប៉ុន្ដែ នៅពេល ឃាត់ខ្លួន បាន គ្រាន់តែ សួរ នាំ បឋម ប៉ុណ្ណោះ ព្រោះ ត្រូវ យក សំណាក ទៅ ពិនិត្យ ជាមុន សិន ទៅ បន្ដ នីតិវិធី បន្ថែម ទៀត ។ លុះ លទ្ធផល បង្ហាញ ថា អវិជ្ជមាន ទើប កម្លាំង នគរបាល ជំនាញ ចាត់ការបន្ដ តាម នីតិវិធី ដែល បច្ចុប្បន្ន នៅ ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២១ នេះ កម្លាំង ផែន អន្ដោប្រវេសន៍ បាន បញ្ជូន ខ្លួន ជនជាតិ ចិន ទាំង ២នាក់ នេះ ទៅកាន់ ទីស្នាក់ ការត្រៀម បណ្ដេញចេញ នៅ ខេត្ត ព្រះសីហនុ ដើម្បី បណ្ដេញចេញ ពី កម្ពុជា តែម្ដង ។
លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ម ធុរិទ្ធ បាន បញ្ជាក់ ថា នៅ ថ្ងៃ កើត ហេតុ ជនជាតិ ចិន ទាំង ២នាក់ នេះ ព្យាយាម បើក រថយន្ត សង្គ្រោះ បន្ទាន់ ដែល មាន ដាក់ ឡូហ្គូ « មន្ទីរ ព្យាបាល ចុង ស៊ិន » ឆ្លង ព្រំប្រទល់ ខេត្ត កំពត និង ខេត្ត ព្រះសីហនុ ពេល សមត្ថកិច្ច ឃាត់ សួរនាំ ក៏ បើក រថយន្ត រត់ ត្រឡប់ មក ក្រោយ វិញ បន្ទាប់មក កម្លាំង ជំនាញ ឃាត់ខ្លួន បាន នៅ ចំណុច ផ្លូវ បំបែក ភ្នំ បូកគោ ស្ថិត នៅ ភូមិ កែប ថ្មី ឃុំ បឹង ទូក ស្រុក ទឹក ឈូ ខេត្ត កំពត ។
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ជូន ដំណឹង ពី ការរកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ លើ ប្រជាពលរដ្ឋ ចំនួន ៤នាក់ បន្ថែម ទៀត ដែល រស់ នៅ ភូមិ ថ្នល់ បែក កើត ឃុំ ស្វាយ ទាប ស្រុក ចំការលើ និង ភូមិ ទ្រា ឃុំ ស្វាយ ពោធិ៍ ស្រុក ស្រីសន្ធរ ។
រដ្ឋបាល ខេត្ត កំពង់ចាម បាន អះអាង ថា បច្ចុប្បន្ន អ្នកជំងឺ កូវីដ១៩ ទាំង ៤នាក់ នេះ ត្រូវបាន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត និង បន្ដ ស្រាវជ្រាវ រក អ្នក ដែល ប៉ះពាល់ ដោយ ផ្ទាល់ និង ដោយ ប្រយោល នឹង ករណី នេះ បន្ថែម ទៀត ផងដែរ ។
ក្រៅពី នេះ រដ្ឋបាល ខេត្ត កំពង់ចាម ក៏ បាន បង្ហាញ អំពី ប្រវត្តិ នៃ ការធ្វើដំណើរ មួយចំនួន របស់ អ្នកជំងឺ កូវីដ ទាំង ៤នាក់ នេះ ដើម្បី ងាយស្រួល ដល់ ប្រជាពលរដ្ឋ ផ្សេង ទៀត តាមដាន សុខភាព ពិសេស អ្នក ដែល សង្ស័យ ថា មាន ការពាក់ព័ន្ធ ៕
រដ្ឋបាល ខេត្ត បាត់ដំបង ហាមឃាត់ ការធ្វើដំណើរ ចេញ - ចូល ក្នុង ខេត្ត ចំនួន ៨ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២០ ដល់ ថ្ងៃទី ២៨ ខែមេសា
( បាត់ដំបង ) ៖ លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង នៅ ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ប្រាប់ ទៅ មន្ត្រី ពាក់ព័ន្ធ ទូទាំង ខេត្ត ឱ្យ បន្ត ហាមឃាត់ ការធ្វើដំណើរ ឆ្លងកាត់ ចេញ ចូល ខេត្ត បាត់ដំបង ជា បណ្តោះអាសន្ន សម្រាប់ រយៈពេល ៨ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ២០ ដល់ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០២១ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
បើ តាម លិខិត របស់ រដ្ឋបាល ខេត្ត ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក នេះ ថ្ងៃទី ២០ ខែមេសា នេះ បាន បញ្ជាក់ ថា ចំពោះ វិធានការ រដ្ឋបាល ក្នុង ការហាមឃាត់ ការធ្វើដំណើរ ឆ្លងកាត់ ចេញ ចូល នេះ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ បុគ្គល ល្មើស ដែល ប្រើប្រាស់ មធ្យោបាយ ផ្សេង ៗ ធ្វើដំណើរ តាម ផ្លូវ ជនបទ ផ្លូវ លំ នានា តាម ភូមិ ឃុំ ស្រុក ដើម្បី បង្វែង ដាន អាជ្ញាធរ សមត្ថកិច្ច ហើយ សម្ងំ លាក់ ខ្លួន នៅក្នុង សហគមន៍ ភូមិ ឃុំ សង្កាត់ ដែល អាច នាំមក នូវ ការរីករាល ជំងឺ កូវីដ - ១៩ ។
ក៏ប៉ុន្តែ ការហាមឃាត់ ការធ្វើដំណើរ នេះ ត្រូវបាន លើកលែក ចំពោះ៖
សម្តេច តេជោ ហ៊ុន សែន ថ្លែង សារណែនាំ មិន ឱ្យ មាន ការជូនដំណើរ សម្តេច ឡើង យន្តហោះ ទៅ ប្រជុំ អាស៊ាន នៅ ប្រទេស ឥណ្ឌូនេស៊ី ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល មិន ឱ្យ មាន ការជូនដំណើរ សម្តេច ឡើង យន្តហោះ ទៅ ចូលរួម កិច្ចប្រជុំ អាស៊ាន នៅ ប្រទេស ឥណ្ឌូនេស៊ី នា ថ្ងៃទី ២៤ ខែមេសា នោះ ឡើយ ។
ជា ទម្លាប់ រាល់ ពេល សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចេញ ក្រៅ ប្រទេស តែ មាន ការជូនដំណើរ ពី មន្ត្រី ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា ថ្នាក់ សម្តេច ឧប នាយក រដ្ឋមន្ត្រី និង ទេសរដ្ឋមន្ត្រី ជាដើម ។ បើ តាម សម្តេច តេជោ ការហាម មិន ឱ្យ មាន ការជូនដំណើរ នេះ ដោយសារ រាជធានី ភ្នំពេញ កំពុង ស្ថិត ក្នុង ការអនុវិធានការបិទ ខ្ទប់ និង ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ទៀត ថា ក្រោយពេល បញ្ចប់ កិច្ចប្រជុំ នៅ ប្រទេស ឥណ្ឌូនេស៉ី ថ្ងៃទី ២៤ ខែមេសា នោះ វេលា ម៉ោង ប្រមាណ ៩យប់ សម្តេច នឹង ហោះ ត្រឡប់មក ប្រទេស កម្ពុជា វិញ ។ ដំណើរ ត្រឡប់ មកវិញ ក៏ មិន តម្រូវ ឱ្យ មាន ការទទួល ដំណើរ ហើយក៏ នឹង មិន មាន ការធ្វើ សន្និសីទ ព័ត៌មាន អ្វី នោះ ដែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ពេល ត្រឡប់ មកវិញ ទាំង សម្តេច និង គណៈប្រតិភូ ត្រូវ យក សំណាក ពិនិត្យ រក ជំងឺ កូវីដ១៩ ហើយ ត្រូវ ដាក់ ខ្លួន នៅ ដាច់ដោយឡែក ( ចត្តាឡី ស័ក ) រយៈពេល ១៤ ថ្ងៃ ដើម្បី ធានា ថា មាន សុវត្ថិភាព មិន មាន ជំងឺ កូវីដ១៩ ហើយ ចម្លង ទៅ អ្នកដទៃ ។
ដោយឡែក សម្រាប់ អ្នក ព័ត៌មាន គឺ អនុញ្ញាតឱ្យ ទៅ យក តែ ត្រូវ រក្សា គម្លាត ពោលគឺ នៅ ឱ្យ ឆ្ងាយ ៕
រដ្ឋបាល ខណ្ឌ ដូនពេញ ផ្អាក ដំណើរការ ជា បណ្តោះអាសន្ន ផ្សារ កណ្តាល ក្រោយ រកឃើញ អាជីវករ ឆ្លង កូវី ដ ជា បន្តបន្ទាប់
ក្នុង ករណី ដែល អាជ្ញាធរ ពិនិត្យ ឃើញ ថា បងប្អូន ខកខាន ឬ គេចវេស មិន បាន យក សំណាក ហើយ អាជ្ញាធរ ពិនិត្យ ទៅ មាន ពាក់ព័ន្ធ ជាមួយ អាជីវករ លក់ដូរ នៅ ផ្សារ កណ្តាល ដែល មាន ផ្ទុក មេរោគ កូវីដ - ១៩ នោះ អាជ្ញាធរ មិន អនុញ្ញាតឱ្យ បងប្អូន ដែល មិន បាន ទៅ យក សំណាក រក មេរោគ កូវីដ - ១៩ នោះ ចូល ប្រកប អាជីវកម្ម លក់ដូរ ឡើយ ៕
( មីយ៉ាន់ម៉ា ) ៖ បន្ទាប់ពី បាន អាន និង ទស្សនា នូវ ព្រឹត្តិការណ៍ អាណានិគម នៅ តំបន់ អាស៉ី អាគ្នេយ៍ ដែន កោះ រួចហើយ នោះ សូម ប្រិយមិត្ត ងាក មក ស្វែងយល់ អំពី ព្រឹត្តិការណ៍ អាណានិគម នៅ តំបន់ អាស៉ី អាគ្នេយ៍ ដែន គោក វិញ ម្ដង ដោយ នៅ ភាគ ទី ១១នេះ យើងខ្ញុំ សូម លើកឡើង អំពី ប្រទេស មីយ៉ាន់ម៉ា មុន គេ ដោយ ហេតុ ថា អតីត ចក្រភព ដ៏ ខ្លាំងក្លា ប្រចាំ តំបន់ មួយ នេះ ក៏ ធ្លាប់ ស្ថិត នៅក្រោម អាណានិគម អង់គ្លេស អស់ រយៈពេល ១២៤ ឆ្នាំ ( ១៨២៤ - ១៩៤៨ ) ផងដែរ ។
សម័យ ដែល អង់គ្លេស វាយ ភូមា នោះ គឺ ចំពេល ដែល ភូមា កើតមាន វិបត្តិ រាជ វង្ស ពីព្រោះតែ ព្រះមហាក្សត្រ នៃ រាជ វង្ស កន បោង នោះ ហាក់ មិន សូវ ឈ្លាសវៃ មិន រវល់ នឹង កិច្ចការ ការពារ ទឹកដី ទោះបី មាន បញ្ហា ជម្លោះ ជាមួយ អង់គ្លេស នៅ ចំពោះ មុខ ក៏ដោយ ។ ប៉ុន្តែ ព្រះមហាក្សត្រ បន្ទាប់ គឺ ព្រះចៅ មីន តន (Mindon Min) ក៏ ខ្លាំង ពូកែ ដែរ ដែល ឡើង គ្រងរាជ្យ ដោយ ការធ្វើ រាជប្រហារ ទម្លាក់ ស្ដេច អសមត្ថភាព អង្គមុន ។
អង់គ្លេស មាន គោល នយោបាយ អូសទាញ មនុស្ស ពី ប្រទេស ឥណ្ឌា និង ប្រទេស ចិន ឱ្យ មក ធ្វើការ នៅក្នុង ប្រទេស ភូមា ប៉ុន្តែ ជន បរទេស ភាគ ច្រើន តែង រស់ នៅក្នុង ក្រុង ចំណែក ជនជាតិ ភូមា ម្ចាស់ ស្រុក ត្រូវ ខ្ទាត ទៅ រស់ នៅ ក្រៅ ក្រុង វិញ ។ ការអូសទាញ ជន បរទេស ចូលមក នេះ ធ្វើឱ្យ ជនជាតិ ឥណ្ឌា ក្លាយជា អ្នក ចង ការប្រាក់ រហូត ធ្វើឱ្យ ជនជាតិ ភូមា ជាច្រើន ជួប នឹង វិបត្តិ ជំពាក់ បំណុល ជនជាតិ ឥណ្ឌា ។ តាំងពី ពេល នោះ មក ជនជាតិ ភូមា មាន ការខឹងសម្បារ យ៉ាង ខ្លាំង ទៅ លើ ជនជាតិ ឥណ្ឌា ៕
របាយការណ៍ របស់ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ផងដែរ ថា ការចាក់ វ៉ាក់សាំង ទាំង៣ ប្រភេទ ( ស៊ីណូ ហ្វាម អាស្ត្រា ហ្សេនីកា និង ស៊ីណូ វ៉ាក់ ) ចាក់ បានជាត ៩៨ ម៉ឺន នាក់ ហើយ ។
សម្រាប់ អ្នក ជាសះស្បើយ ទាំង ៣១ នាក់ វិញ សុទ្ធសឹង ជា អ្នក ឆ្លង ក្នុង សហគមន៍ នៃ ព្រឹត្តិការណ៍ ២០កុម្ភៈ ដោយ ទទួ លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ប៉ុន្តែ ត្រូវ បន្ត ធ្វើចត្តាឡី ស័ក ១៤ ថ្ងៃ ដើម្បី តាមដាន សុខភាព ។
( កំពត ) ៖ កម្លាំង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពត នៅ វេលា ម៉ោង ៩ព្រឹក ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ក្រាប ជនជាតិ ចិន ១១នាក់ ដែល បម្រុង ធ្វើដំណើរ ឆ្លងកាត់ ខេត្ត កំពត ទៅ រាជធានី ភ្នំពេញ បន្លំ ជិះ ក្នុង រថយន្ដ ដឹក ជំនិញ ដើម្បី បំភាន់ ភ្នែក សមត្ថកិច្ច ។
ស្នងការ នគរ របាល ខេត្ត កំពត លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា កម្លាំង ប្រចាំ ការ នៅ គោល ព្រំប្រទល់ ខេត្ត របស់ លោក បាន ធ្វើ ការឃាត់ រថយន្ត មួយ គ្រឿង នៅ ភូមិ អង្គ ឃ្លៃ ឃុំ ត្រម៉ែង ស្រុក ឈូក ដែល បាន រត់ ពន្ធ ដឹក ជនជាតិ ចិន ចំនួន ១១នាក់ ពី ខេត្ត ព្រះសីហនុ ដោយ ធ្វើដំណើរ តាម ផ្លូវ ជាតិ លេខ៤ ឆ្លងកាត់ តាម ភូមិសាស្ត្រ នៅ ឃុំ តេជោ អភិវឌ្ឍន៍ ស្រុក ឈូក ។
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា ឡាយ ប៊ុន ប៉ា និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ១១.០០០ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
លោក ឧកញ៉ា ឡាយ ប៊ុន ប៉ា និង លោកជំទាវ កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោក ឧកញ៉ា ឡាយ ប៊ុន ប៉ា និង លោកជំទាវ ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត សុខ ផល លោកជំទាវ គឹម ហេង ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត សុខ ផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ លោកជំទាវ គឹម ហេង ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត សុខ ផល លោកជំទាវ គឹម ហេង កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត សុខ ផល ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា កុក អាន អគ្គ នាយក កាស៊ីណូ ហ្គោល ឌិន ក្រោណ ឧបត្ថម្ភ ថវិកា ៥ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ ។
អ្នក ឧកញ៉ា កុក អាន កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ អ្នក ឧកញ៉ា កុក អាន ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សម្តេច តេជោ ហ៊ុន សែន បាន គូស រំលេច បែប នេះ ក្នុង សុន្ទរកថា បើក វេទិកា បូអាវ សម្រាប់ អាស៊ី ដែល ប្រារព្ធ ធ្វើឡើង តាមរយៈ ប្រព័ន្ធ វីដេអូ ។ វេទិកា ធ្វើឡើង ក្រោម ប្រធានបទ « ពិភពលោក ក្នុង ការផ្លាស់ប្ដូរ៖ រួម ដៃ គ្នា ដើម្បី ពង្រឹង អភិបាលកិច្ចសកល និង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ខ្សែក្រវាត់ និង ផ្លូវ » ។
នៅ ចំពោះ មុខ មេដឹកនាំ ប្រទេស ជា សមាជិក នៃ វេទិកា បូអាវ សម្រាប់ អាស៊ី ដែល ជា វេទិកា ផ្តួចផ្តើម ឡើង ដោយ ប្រទេស ចិន នេះ សម្តេច ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន លើកឡើង ថា ក្នុង បរិការណ៍ នៃ វិបត្តិ ជំងឺ កូវីដ១៩ និង ការប្រជែង ភូមិសាស្ត្រ នយោបាយ របស់ ប្រទេស មហា អំណាច នេះ ប្រទេស នីមួយ ៗ គួរតែ ដើរ តួនាទី កាន់តែ សកម្ម នៅក្នុង អភិបាលកិច្ចសកល ដោយ ភាពបត់បែន . ស្ថាបនា និង ឥរិយាបថ ទទួលខុសត្រូវ ។
សម្តេច តេជោ បាន គូសបញ្ជាក់ បែប នេះ « ក្នុង កាលៈទេសៈ ដ៏ សំខាន់ នេះ ខ្ញុំ យល់ឃើញ ថា ពិភពលោក ពិតជា ត្រូវការអភិបាលកិច្ចសកល មួយ ដែល គាំទ្រ ពហុ ភាគី និយម និង គោរព ច្បាប់ អន្តរជាតិ និង អធិបតេយ្យភាព របស់ ប្រទេស នីមួយ ៗ ដែល មិន គិត ពី ទំហំ ឬ ធនធាន ដោយ មាន អង្គការ សហ ប្រជាជាតិ ជា ស្នូល ។ កម្ពុជា ទទួលស្គាល់ នូវ តួនាទី ស្នូល នៃ ពហុ ភាគី និយម ក្នុង ការដោះស្រាយ បញ្ហា ប្រឈម ពិភពលោក ដែល មាន ភាពស្មុគស្មាញ និង អន្តរ ទំនាក់ទំនង » ។
ក្នុង សុន្ទរកថា បើក វេទិកា នេះ សម្តេច តេជោ ហ៊ុន សែន វាយតម្លៃ ខ្ពស់ ចំពោះ គំនិត ផ្តួចផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ របស់ រដ្ឋាភិបាល ចិន ផងដែរ ។ សម្តេច តេជោ បាន គូសបញ្ជក់ ថា ក្រោម គំនិត ផ្ដួច ផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ ចាប់តាំងពី ការបង្កើត មក បាន រួមចំណែក ដល់ ការជំរុញ កិច្ចសហប្រតិបត្តិការ ក្នុង តំបន់ និង ពិភពលោក លើ ហេដ្ឋារចនាសម្ព័ន្ធ រឹង និង ទន់ . សេដ្ឋកិច្ច . ពាណិជ្ជកម្ម . កាលានុវត្តភាព វិនិយោគ . ការផ្លាស់ប្ដូរ វប្បធម៌ និង ការតភ្ជាប់ រវាង ប្រជាជន និង ប្រជាជន ។
សម្តេច តេជោ បន្ត ថា ខណៈពេល នៃ ការធ្លាក់ចុះ សេដ្ឋកិច្ច នេះ គំនិត ផ្ដួច ផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ នៅតែ ជា កម្លាំង ជំរុញ ដើម្បី បន្ត ពង្រីក កិច្ចសហប្រតិបត្តិការ ក្នុង ចំណោម ប្រទេស នៅក្នុង តំបន់ និង ពិភពលោក សម្រាប់ បុព្វហេតុ សន្តិភាព . សន្តិសុខ . វិបុលភាព និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
ក្នុង នាម រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ចិន ដែល បាន ផ្តល់ ថ្នាំ ពេទ្យ . គ្រឿង បរិក្ខារ វេជ្ជសាស្ត្រ ក៏ ដូចជា វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ចំនួន ៣.៣លាន ដូស ដល់ កម្ពុជា ដែល ក្នុង នោះ ចំនួន ១.៣លាន ដូស ជា ជំនួយ មនុស្សធម៌ ៕
សុន្ទរកថា សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ក្នុង ពិធី បើក វេទិកា បូអាវ សម្រាប់ អាស៊ី តាម ប្រព័ន្ធ វីដេអូ ( ២ទំព័រ ) ( ភ្នំពេញ ) ៖ វេទិកា បូអាវ សម្រាប់ អាស៊ី ខួប ទី២០ ឆ្នាំ ត្រូវបាន បើក ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃទី ២០ ខែមេសា ឆ្នាំ ២០២១ នៅក្នុង ប្រទេស ចិន ។ ការបើក វេទិកា នេះ ត្រូវបាន ធ្វើឡើង ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ នៃ ប្រទេស ជា សមាជិក ដែល រួម មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ផងដែរ ។
ដោយសារតែ វិបត្តិ នៃ ជំងឺ កូវីដ១៩ ការបើក វេទិកា នេះ មិន អាច ប្រព្រឹត្តទៅ ដោយ អធឹក អធម ដូច បណ្តា ឆ្នាំ កន្លងទៅ នោះ ឡើយ ដោយ ត្រូវ ធ្វើឡើង តាមរយៈ ប្រព័ន្ធ វីដេអូ ប៉ុណ្ណោះ ។
វេទិកា បូអាវ សម្រាប់ អាស៊ី (BFA) ជា អង្គការ ក្រៅ រដ្ឋាភិបាល អន្ដរជាតិ ដែល មិន រក ប្រាក់ ចំណេញ ស្ថិត ក្នុង ប្រទេស ចិន និង ជា វេទិកា បូអាវ សម្រាប់ អាស៊ី ដ៏ ល្បីល្បាញ និង សំខាន់ បំផុត សម្រាប់ អ្នកដឹកនាំ មកពី រដ្ឋាភិបាល ធុរកិច្ច និង សាកលវិទ្យាល័យ នៅ ទ្វីប អាស៊ី និង ទ្វីប ដទៃ ទៀត ដើម្បី ចែករំលែក ចក្ខុវិស័យ ស្តីពី បញ្ហា ចំបង នៅក្នុង តំបន់ ដែល មាន សក្តានុពល ជុំវិញ ពិភពលោក ។
នៅ ឆ្នាំ ២០២១ នេះ វេទិកា នេះ ត្រូវបាន ប្រារព្ធ ធ្វើឡើង ក្រោម ប្រធានបទ « ពិភពលោក ក្នុង ការផ្លាស់ប្ដូរ៖ រួម ដៃ គ្នា ដើម្បី ពង្រឹង អភិបាលកិច្ចសកល និង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ខ្សែក្រវាត់ និង ផ្លូវ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង អបអរសាទរ ចំពោះ ខួប គម្រប់ ២០ ឆ្នាំ នៃ ការបង្កើត វេទិកា នេះ ។ សម្តេច តេជោ បាន គូសបញ្ជាក់ ថា រយៈពេល ២០ ឆ្នាំ កន្លងមក វេទិកា នេះ បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការជំរុញ កិច្ចសហប្រតិបត្តិការ នយោបាយ . សេដ្ឋកិច្ច - សង្គម . វប្បធម៌ និង បរិស្ថាន ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន លើកឡើង ដែរ ថា បច្ចុប្បន្ន ជំងឺ កូវី - ១៩ បាន បន្ត គំរាមកំហែង យ៉ាង ធ្ងន់ធ្ងរ ដល់ សុខភាព សាធារណៈ សកល និង ការអភិវឌ្ឍ ជា រួម ។ ក្នុង បរិការណ៍ នេះ គ្មាន ប្រទេស ណា មួយ មាន សុវត្ថិភាព នោះ ទេ ដរាបណា ប្រទេស ទាំងអស់ មិន មាន សុវត្ថិភាព ។
ក្នុង សុន្ទរកថា នេះ សម្តេច តេជោ ហ៊ុន សែន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការយកចិត្តទុកដាក់ ខ្ពស់ និង ការប្តេជ្ញាចិត្ត របស់ ប្រទេស ចិន ក្នុង ការអនុវត្ត « ផ្លូវ សូត្រ សុខភាព » ក្រោម គំនិត ផ្ដួច ផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ និង តួនាទី ឈានមុខ ក្នុង ការផ្ដល់ នូវ ថ្នាំ ពេទ្យ . គ្រឿង បរិក្ខារ វេជ្ជសាស្រ្ត និង វ៉ាក់សាំង ការពារ កូវីដ - ១៩ ទាន់ ពេលវេលា ទៅកាន់ ប្រទេស ជាច្រើន ដែល នេះ ជា សក្ខីភាព មួយ យ៉ាង ប្រចក្ស អំពី ភាពដឹកនាំ សកល របស់ ប្រទេស ចិន ។
តាង នាម ឱ្យ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា សម្តេច តេជោ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ចិន ដែល បាន ផ្តល់ ថ្នាំ ពេទ្យ . គ្រឿង បរិក្ខារ វេជ្ជសាស្ត្រ ក៏ ដូចជា វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ចំនួន ៣.៣លាន ដូស ដល់ កម្ពុជា ដែល ក្នុង នោះ ចំនួន ១.៣លាន ដូស ជា ជំនួយ មនុស្សធម៌ ។
យោង តាម សេចក្តីជូន ព័ត៌មាន ដែល Fresh News ទទួលបាន ក្រសួង បាន បញ្ជាក់ ថា អ្នកជំងឺ កូវីដ១៩ ទាំង ៤នាក់ ដែល បាន ទទួលមរណភាព នេះ រួម មាន៖ ១៖ បុរស ជនជាតិ ខ្មែរ អាយុ ៦៥ ឆ្នាំ រស់ នៅ សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ បាន ចូល សម្រាក ពេទ្យ នៅ ថ្ងៃទី ២៤ ខែមីនា ឆ្នាំ ២០២១ វេលា ម៉ោង ១៤៖ ២០នាទី បន្ទាប់ពី ទទួលបាន លទ្ធផល វិជ្ជមាន កូវីដ - ១៩ ជាមួយ ស្ថានភាព ក្អក ហត់ ខ្លាំង និង មាន ប្រវត្តិ ជំងឺ ទឹកនោម ផ្អែម ប្រចាំ កាយ ។
២៖ បុរស ជនជាតិ ខ្មែរ អាយុ ៧២ ឆ្នាំ រស់ នៅ សង្កាត់ ជើងឯក ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ បាន ចូល សម្រាក ព្យាបាល នៅ មជ្ឈមណ្ឌល ជាតិ កម្ចាត់ រោគរ បេង និង ហង់ សិន នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២១ ដោយ មាន រោគសញ្ញា ក្អក ហត់ រួមទាំង មាន ជំងឺ ទឹកនោម ផ្អែម ជំងឺ បេះដូង និង ខ្សោយ តំរងនោម ដំណាក់កាល ចុងក្រោយ ប្រចាំ កាយ ។ បន្ទាប់ពី បាន រកឃើញ មាន វិជ្ជមាន កូវីដ - ១៩ ហើយ អ្នកជំងឺ មាន ការវិវត្តិ កាន់តែ ធ្ងន់ធ្ងរ គាត់ ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល បន្ត នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ សូវៀត នៅ ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០២១ ។
តាម ការសន្និដ្ឋាន របស់ ក្រុម គ្រូពេទ្យ ស្ត្រី រូប នេះ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ វិបត្តិ ផ្លូវ ដង្ហើម ស្រួច ស្រាវ ធ្ងន់ធ្ងរ និង រលាក សួត ទាំង សងខាង ដោយសារ វីរុស កូវីដ - ១៩ ។
ក្រសួង សុខាភិបាល ចូលរួមចំណែក សោកស្ដាយ ជា ពន់ពេក និង ចូលរួម មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជា ទីបំផុត ជាមួយ ក្រុមគ្រួសារ សព ។
ក្រសួង ការពារ ជា តិ៖ នាយ ទាហាន ២រូប ទៀត មាន វិជ្ជមាន មេរោគ កូវីដ១៩
បើ តាម សេចក្តីប្រកាស . នាយ ទាហាន ២រូប ដែល មាន វិជ្ជមាន មេរោគ កូវីដ១៩ នេះ មាន៖
ទី១៖ លោក ភៀក ប៊ុន ឈឿន អត្តលេខ ០១៣៦៨៥ ឋានន្តរសក្តិ ឧត្តមសេនីយ៍ ទោ មុខងារ នាយក រង នាយកដ្ឋាន កិច្ចការ រដ្ឋបាល អគ្គ លេខាធិការដ្ឋាន ក្រសួង ការពារ ជាតិ មាន ទីលំនៅ ភូមិ មិត្តភាព សង្កាត់ ឫស្សីកែវ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ត្រូវបាន រកឃើញ វិជ្ជមាន កូវីដ - ១៩ នៅ ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២១
និង ទី២៖ កញ្ញា អ៊ុង សុវ៉ាន់ ដារ៉ា អត្តលេខ ១៩២០០៦ ឋានន្តរសក្តិ វរសេនីយ៍ ទោ មុខងារ នាយ ផ្នែក កិច្ចការ នារី ការិយាល័យ អប់រំ ចិត្តសាស្ត្រ អគ្គ លេខាធិការដ្ឋាន ក្រសួង ការពារ ជាតិ ទីលំនៅ បច្ចុប្បន្ន ភូមិ ទូល សង្កែ សង្កាត់ ទួល សង្កែ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ត្រូវបាន រកឃើញ វិជ្ជមាន កូវីដ - ១៩ នៅ ថ្ងៃទី ១៩ ខែមេសា ឆ្នាំ ២០២១ ។
ក្រសួង ការពារ ជាតិ បាន បញ្ជាក់ ថា អ្នកជំងឺ ទាំង ២នាក់ នេះ ធ្លាប់ បាន ចាក់ វ៉ាក់សាំង ចំនួន ២លើក រួចហើយ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ ក្រសួង ការពារ ជា តិ៖ រដ្ឋបាល ខេត្ដ កំពង់ចាម អនុញ្ញាតឲ្យ ដំណើរការ ឡើងវិញ មណ្ឌល សុខភាព ក្រឡា នៅ ស្រុក កំពង់សៀម ក្រោយ បិទ ដោយសារ ពាក់ព័ន្ធ អ្នក កើត ជំងឺ កូវីដ
គួរ ជម្រាប ថា ទីតាំង មណ្ឌល សុខភាព ក្រឡា នេះ ត្រូវបាន ផ្អាក ដំណើរការ បណ្ដោះអាសន្ន កាលពី ពេល កន្លងទៅ ដោយសារ មាន ការជាប់ពាក់ព័ន្ធ ជាមួយ អ្នក កើត ជំងឺ កូវីដ១៩ និង ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ នេះ ទៅកាន់ ប្រជាពលរដ្ឋ ផ្សេង ទៀត ។
