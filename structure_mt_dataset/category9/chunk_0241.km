ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ទីប្រឹក្សា គ.ជ. ប និង នាយក ខុទ្ទល័យ ប្រធាន គ.ជ. ប
( ភ្នំពេញ ) ៖ ព្រះករុណា សម្តេច ព្រះបាទ ន រោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង និង ផ្តល់ ឋានៈ ទីប្រឹក្សា គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) និង នាយក ខុទ្ទល័យ របស់ ប្រធាន គ.ជ.ប ។
* ទី១៖ លោក សោម សូរីដា ជា ទីប្រឹក្សា គណៈកម្មការ ជាតិ រៀបចំ ការបោះឆ្នោត មាន ឋានៈ ស្មើ រដ្ឋលេខាធិការ បន្ថែម លើ មុខងារ បច្ចុប្បន្ន * ទី២៖ លោក ស៊ិន ដារ៉ា ជា នាយក ខុទ្ទកាល័យ ប្រធាន គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត មាន ឋានៈ ស្មើ អគ្គ នាយក បន្ថែម លើ មុខងារ បច្ចុប្បន្ន ។
បុគ្គលិក និង គ្រូពេទ្យ ២៤ នាក់ នៅ មន្ទីរ សម្រាក ព្យាបាល និង សម្ភព ទេពនិម្មិត បន្ត ពិនិត្យ សំណាក លើក ទី៣ អវិជ្ជមាន ជំងឺ កូវីដ១៩ . រដ្ឋបាល ខេត្ត សម្រេច ឲ្យ បើក ដំណើរការ ឡើងវិញ
( ត្បូងឃ្មុំ ) ៖ បុគ្គលិក និង គ្រូពេទ្យ ២៤ នាក់ នៅ មន្ទីរ សម្រាក ព្យាបាល និង សម្ភព ទេពនិម្មិត បន្ត ពិនិត្យ សំណាក លើក ទី៣ « អវិជ្ជមាន ជំងឺ កូវីដ១៩ » ។ នេះ បើ តាម ការ ឱ្យដឹង ពី អាជ្ញាធរ និង មន្ត្រី ជាន់ ខ្ពស់ មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ ស្រង់ លទ្ធផល ពី វិទ្យាស្ថាន ប៉ាស្ទ័រ នៅ ល្ងាច ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
ជាមួយគ្នា នឹង លទ្ធផល នេះ រដ្ឋបាល ខេត្ត នឹង សម្រេច ឲ្យ មន្ទីរ សម្រាក ព្យាបាល និង សម្ភព ទេពនិម្មិត ដែល ស្ថិត នៅក្នុង ក្រុង សួង នេះ បើក ដំណើរការ ពិនិត្យ ព្យាបាល ឡើងវិញ ផងដែរ ។
ធនាគារ រដ្ឋ ARDB រួមគ្នា ជាមួយ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK អនុវត្ត គម្រោង ជំរុញ ទីផ្សារ សម្រាប់ កសិកម្ម ខ្នាត តូច
គម្រោង នេះ មាន គោលដៅ ជំរុញ កំណើន ប្រកបដោយ បរិយាប័ន្ន លើ ទីផ្សារ និង គាំទ្រ ដល់ ការផលិត ជា លក្ខណៈ ខ្សែ ច្រវាក់ ផលិតកម្ម ព្រមទាំង ការអភិវឌ្ឍ ចង្កោម ផលិតផល នីមួយ ៗ តាម មូលដ្ឋាន ដល់ ក្រុម កសិករ ខ្នាត តូច ។
អនុស្សរណៈ នេះ មាន គោលបំណង ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ ការអនុវត្ត គម្រោង ជំរុញ ទីផ្សារ សម្រាប់ កសិកម្ម ខ្នាត តូច (AIMS) តាមរយៈ ការផ្តល់ ឥណទាន បន្ត ដល់ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ដើម្បី អនុវត្ត ការផ្តល់ ឥណទាន ដល់ អ្នកទទួល ផល ក្នុង តំបន់ គោលដៅ គម្រោង ឲ្យកាន់ ប្រសើរ ៕រកឃើញ អ្នកវិជ្ជមាន កូវីដ១៩ ថ្មី ២នាក់ ទៀត ពាក់ព័ន្ធ ហាង កាហ្វេ « លឹង្គ ១០០០ » នៅ ក្រុង សៀមរាប
រដ្ឋបាល ខេត្ត សៀមរាប សូម ជម្រាប ជូន សាធារណជន ឱ្យ បាន ជ្រាប ថា ក្នុង ព្រឹត្តិការណ៍ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ចូលក្នុង « សហគមន៍ ២០កុម្ភៈ » នេះ ខេត្ត សៀមរាប បាន រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ - ១៩ ថ្មី ចំនួន ២នាក់ នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២១ ជា អ្នក ពាក់ព័ន្ធ ជាមួយនឹង បុរស វិជ្ជមាន ជំងឺ កូវីដ - ១៩ ដែល ជា អ្នកបើក រថយន្ត តាក់ស៊ី និង ហាង កាហ្វេ លឹង្គ ១០០០ រួម មាន ដូច ខាងក្រោម៖
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត សៀមរាប សូម ជម្រាប ជូន ប្រជាពលរដ្ឋ ដែល បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ឬ ដោយ ប្រយោល ជាមួយ អ្នកវិជ្ជមាន ទាំង ពីរ នាក់ ខាងលើ សូម រួសរាន់ ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ ក្នុង ក្រុមគ្រួសារ រៀង ៗ ខ្លួន ដោយ មិន ត្រូវ ពាក់ព័ន្ធ និង ប៉ះពាល់ ជាមួយ អ្នកដទៃ ជាដាច់ខាត ។
រដ្ឋបាល ខេត្ត សៀមរាប សង្ឃឹម យ៉ាង មុតមាំ ថា បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម អនុវត្ត ឱ្យ បាន ម៉ឺងមាត់ និង អនុវត្ត នូវ វិធានការ ការពារ របស់ រាជ រដ្ឋាភិបាល និង ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕ ជនល្មើស បើក កាណូត បំបុក កាណូត សមត្ថកិច្ច ពេល កំពុង ប្រតិបត្តិការណ៍ បង្ក្រាប បណ្តាលឱ្យ អ្នកបើកបរ កាណូត សមត្ថកិច្ច ម្នាក់ រងរបួស ធ្ងន់ នៅ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ អ្នកបើកបរ កាណូត របស់ សមត្ថកិច្ច ម្នាក់ បាន រងរបួស ធ្ងន់ បញ្ជូន ទៅ សង្គ្រោះ បន្ទាន់ នៅ រាជធានី ភ្នំពេញ ខណៈ ដែល កំពុង ចុះ ប្រតិបត្តិការ ល្បាត ប្រទះឃើញ បទល្មើស កំពុង លួច ធ្វើ សកម្មភាព អូស អួន នៅ កន្លែង អភិរក្ស ជល ផល ( អតីត ឡូត៏ លេខ ០៦) ។
ហេតុការណ៍ នេះ បាន កើតឡើង នា វេលា ម៉ោង ០៩៖ ៤០ នាទី យប់ ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២១ នៅ ចំណុច កន្លែង អភិរក្ស ជល ផល លើ ផ្ទៃ ទឹក បឹង ទន្លេ សាប ស្ថិត ក្នុង ភូមិ កោះ ក្អែក ឃុំ រាំង ទិល ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ ។
បច្ចុប្បន្ន សមត្ថកិច្ច បាន នឹង កំពុង សហការស្រាវជ្រាវ តាម រក ជនសង្ស័យ ដើម្បី ចាត់ការ តាម នីតិវិធី ៕ អាជ្ញាធរ ខេត្ត ក្រចេះ ដាក់ពង្រាយ ប៉ុស្ដិ៍ ត្រួតពិនិត្យ ៦ គោលដៅ ទូទាំង ខេត្ត ដើម្បី ទប់ស្កាត់ ការរីករាលដាល កូវី ដ១៩
( ក្រចេះ ) ៖ ក្នុង ឱកាស ប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជនជាតិ ខ្មែរ ខាងមុខ នេះ លោក គង់ គឹម នី អភិបាល រង ខេត្ត នៅ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន ចុះ ត្រួតពិនិត្យ ៦ គោលដៅ ទូទាំង ខេត្ត ទប់ស្កាត់ លំហូរ ប្រជាពលរដ្ឋ មកពី តំបន់ នានា ជាពិសេស ដើម្បី ទប់ស្កាត់ ការរាលដាល ជំងឺ កូវីដ - ១៩ ចូល មូលដ្ឋាន ។
លោក គង់ គឹម នី បាន ចុះ ត្រួតពិនិត្យ គោលដៅ ឈរ ជើង សំខាន់ ៗ របស់ សមត្ថកិច្ច ចម្រុះ ចំនួន ២កន្លែង នៅក្នុង ស្រុក ស្នួល គឺ ព្រំប្រទល់ ស្រុក មេម៉ុត ខេត្ត ត្បូងឃ្មុំ និង ស្រុក កែវសីមា ខេត្ត មណ្ឌលគិរី ក្នុង ការហាមឃាត់ ការធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ។
នៅក្នុង ឱកាស ចុះ ត្រួតពិនិត្យ គោលដៅ ទាំង២ ខាងលើ លោក អភិបាល រង ខេត្ត ក៏ បាន នាំយក សម្ភារ មួយចំនួន របស់ រដ្ឋបាល ខេត្ត ឧបត្ថម្ភ ដល់ កងកម្លាំង ដែល កំពុង ឈរជើង នៅ គោលដៅ ទាំង ២ ខាងលើ រួម មាន៖ អង្ករ អាល់កុល ម៉ាស ថវិកា ចំនួន ១លាន រៀល ក្នុង ១ គោលដៅ ។
