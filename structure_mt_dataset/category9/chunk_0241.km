( ភ្នំពេញ ) ៖ ឯកឧត្ដម ឧប នាយក រដ្ឋមន្រ្តី ហោ ណាំ ហុង និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្ដម ហោ ណាំ ហុង កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម ហោ ណាំ ហុង ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
គិត ត្រឹម ថ្ងៃទី ០៤ ខែមេសា ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ ទូទាំង ប្រទេស សរុប ចំនួន ៥៨១. ៥៩១ នាក់
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ០៤ ខែមេសា ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ ទូទាំង ប្រទេស សរុប ចំនួន ៥៨១. ៥៩១ នាក់ ។
អ្វី ដែល ជា ការចាប់អារម្មណ៍ ខ្លាំង នោះ វត្តមាន របស់ ក្រុមហ៊ុន Tesla កំពុង ទទួលបាន ការស្វាគមន៍ យ៉ាង ខ្លាំង ជាពិសេស បងប្អូន ដែល រស់ នៅ រាជធានី ភ្នំពេញ ។
ការមកដល់ របស់ ក្រុមហ៊ុន Tesla នេះ បាន បង្ហាញ ពី ការជឿជាក់ លើ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល រក្សា បាន នូវ សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សុវត្ថិភាព សង្គម បង្ក លក្ខណៈ ងាយស្រួល ក្នុង ការធ្វើ ធុរកិច្ច ៕ អាជីវករ និង សន្តិសុខ នៅ ផ្សារ អូរ ឬស្សី សរុប ១៦នាក់ រកឃើញ ឆ្លង កូវីដ១៩ . អាជ្ញាធរ បន្ត អំពាវនាវ ឲ្យ អាជីវករ ទាំងអស់ ទៅ យក សំណាក ជា បន្ទាន់ និង ព្រមាន ប្រើ ផ្លូវ ច្បាប់ ចំពោះ បុគ្គល ដែល បន្ត គេចវេស
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ នេះ អាជីវករ និង សន្តិសុខ នៅ ផ្សារ អូរ ឬស្សី ចំនួន ១៦ នាក់ ក្នុង នោះ មាន អាជីវករ ១២នាក់ និង សន្តិសុខ ៤នាក់ ត្រូវបាន រកឃើញ ឆ្លង កូវីដ ជា បន្តបន្ទាប់ ហេតុ ដូច្នេះហើយ អាជ្ញាធរ សូម អំពាវនាវ ដល់ បងប្អូន អាជីវករ ទាំងអស់ នៅក្នុង ផ្សារ អូរ ឬស្សី ទៅ យក សំណាក ជា បន្ទាន់ ហើយ នឹង ប្រើ ផ្លូវ ច្បាប់ បើសិន នៅ បន្ត គេចវេស មិន ព្រម ទៅ យក សំណាក ។
ក្រោយ មាន ការអំពាវនាវ របស់ អភិបាល រាជធានី ភ្នំពេញ គេ សង្កេតឃើញ ថា មាន អ្ន ប៉ះពាល់ ទាំង ផ្ទាល់ និង ប្រយោល បាន ទៅ យក សំណាក ប៉ុន្តែ ទន្ទឹម គ្នា នោះ ក៏ មាន អ្នក ខ្លះ ទៀត ដែល ធ្លាប់ ប៉ះពាល់ ជាមួយ អ្នកជំងឺ មិន បាន ទៅ យក សំណាក នោះ ទេ ។ ជាមួយនឹង បញ្ហា នេះ អាជ្ញាធរ បាន ព្រមាន ប្រើ ផ្លូវ ច្បាប់ ចំពោះ អ្នក គេចវេស ទាំងនោះ បើ នៅតែ មិន ព្រម ទៅ យក សំណាក នៅ ពេល ដែល ខ្លួន បាន ដឹង ថា ធ្លាប់ មាន ការប៉ះពាល់ ជាមួយ អ្នក កើត កូវីដ កន្លងមក នោះ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ យប់ ថ្ងៃទី ០៣ ខែមេសា ឆ្នាំ ២០២១ បាន សម្រេច ផ្អាក ការចេញ ចូល ផ្សារ អូរឫស្សី ជា បណ្តោះអាសន្ន រយៈពេល ១៤ ថ្ងៃ ។ ការផ្អាក នេះ ធ្វើឡើង បន្ទាប់ពី រកឃើញ អាជីវករ អនុប្រធាន ផ្សារ និង សន្តិសុខ សរុប ៦នាក់ បាន កើត ជំងឺ កូវីដ១៩ ។
បន្ថែម ពីលើ សេចក្តីជូនដំណឹង នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា បន្ទាប់ ផ្អាក ការចេញ ចូល ផ្សារ ទៅ លោក ក៏ បាន ចាត់ចែង ឱ្យ លាង និង បាញ់ ថ្នាំ នៅក្នុង ផ្សារ នេះ ផងដែរ ៕ ក្រសួង សុខាភិបាល៖ ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ១៩ នៅ ទូទាំង ប្រទេស កើន ដល់ ចំនួន ៤១៨. ៥៦៤ នាក់ គិត ត្រឹម ថ្ងៃទី ០៤ ខែមេសា
ខាងក្រោម តារាង ព័ត៌មាន លម្អិត នៃ ការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ របស់ ក្រសួង សុខាភិបាល៖ អគ្គិភ័យ ឆេះ ផ្ទះ ផ្តាច់ ជីវិត សមាជិក គ្រួសារ ចំនួន ០៤ នាក់ ក្នុង នោះ មាន ស្ត្រី ពោះ ធំ ម្នាក់ នៅ រដ្ឋធានី ហាណូយ របស់ ប្រទេស វៀតណាម
( ហាណូយ ) ៖ ទីភ្នាក់ងារ សារព័ត៌មាន វៀតណាម បាន រាយការណ៍ ឲ្យដឹង នៅ ថ្ងៃអាទិត្យ នេះ ថា សមាជិក គ្រួសារ ចំនួន ០៤ នាក់ បាន ស្លាប់ បាត់បង់ជីវិត នៅក្នុង គ្រោះ អគ្គិភ័យ ឆេះ ផ្ទះ មួយ ខ្នង នៅ រដ្ឋធានី ហាណូយ របស់ ប្រទេស វៀតណាម ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃអាទិត្យ ទី០៤ ខែមេសា ឆ្នាំ ២០២១ ។
គួរ បញ្ជាក់ ថា បើ យោង តាម ការិយាល័យ ស្ថិតិ ទូទៅ របស់ ប្រទេស បាន ឲ្យដឹង ថា នៅក្នុង ត្រី មាស ដំបូង នៃ ឆ្នាំ នេះ គ្រោះ អគ្គិភ័យ និង ការផ្ទុះ សរុប ចំនួន ៦២៦ ដង បាន កើតឡើង នៅក្នុង ប្រទេស វៀតណាម ដោយ បាន សម្លាប់ មនុស្ស ២១ នាក់ និង បង្ក ការខាតបង់ ទ្រព្យសម្បត្តិ ប្រមាណ ១៦១. ២ពាន់ លាន ដុង វៀតណាម ឬ ស្មើ ប្រមាណ ៧លាន ដុល្លារ អាមេរិក ៕
ខេត្ត រតនគិរី រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ ជា លើក ដំបូង ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ
( រតនគិរី ) ៖ រដ្ឋបាល ខេត្ត រតនគិរី បាន ប្រកាស ឱ្យដឹង ថា នៅ ថ្ងៃទី ០៤ ខែមេសា នេះ បាន រកឃើញ បុរស ម្នាក់ កើត ជំងឺ កូវីដ១៩ ដែល នេះ ជា ករណី វិជ្ជមាន កូវីដ១៩ ជា លើក ដំបូង ហើយ សម្រាប់ ខេត្ត ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ។
លុះ ដល់ ថ្ងៃទី ០១ ខែមេសា ដោយ មាន ការសង្ស័យ បុរស រូប នេះ បាន ទាក់ទង ជាមួយ មន្ត្រី សុខាភិបាល យក សំណាក ទាំង ប្តី ប្រពន្ធ ។ លទ្ធផល វិភាគ ចេញ ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ បង្ហាញ ថា បុរស ឈ្មោះ ញឹក សុជា មាន វិជ្ជមាន ជំងឺ កូវីដ១៩ ។
រដ្ឋបាល ខេត្ត រតនគិរី បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ និង សាធារណជន ដែល មាន ជាប់ពាក់ព័ន្ធ នឹង បុគ្គល ឈ្មោះ ញឹក សុជា សូម ផ្តល់ ព័ត៌មាន ដើម្បី មន្ត្រី ចុះ យក សំណាក និង ត្រូវ ធ្វើចត្តាឡី ស័ក ខ្លួន ឯង រយៈពេល ១៤ ថ្ងៃ ។ ក្នុង មាន ករណី សង្ស័យ ឬ ការប្រែប្រួល សុខភាព ទាក់ទង ទៅ ទូរស័ព្ទ លេខ ០៩៧ ៥៩៥ ៧៧៨ ៨ និង ០៩២ ១២១ ៣៨៣ ៕ យ៉ាងហោចណាស់ ៤៤ នាក់ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ គ្រោះ ទឹក ជំនន់ និង បាក់ ដី នៅ ភាគ ខាងកើត នៃ ប្រទេស ឥណ្ឌូនេស៊ី
អាជ្ញាធរ បាន គូសបញ្ជាក់ ថា ផ្ទះ ជាច្រើន ត្រូវបាន ជន់ លិច ដោយ ភក់ ខណៈ ស្ពាន និង ផ្លូវថ្នល់ ត្រូវបាន បំផ្លាញ យ៉ាង ខ្ទេចខ្ទី នៅ ចុង ខាងកើត នៃ កោះ ។
មន្ត្រី រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឱ្យដឹង ថា កុំព្យូទ័រ យួរ ដៃ ទាំង ៦៨ គ្រឿង ដែល ប្រគល់ ជូន ក្រុម គ្រូពេទ្យ គឺ សម្រាប់ បម្រើ ការងារ បញ្ចូល ទិន្នន័យ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ជូន ប្រជាពលរដ្ឋ ដោយ ស្ម័គ្រចិត្ត នៅ ទីតាំង ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ទាំង ៣៤កន្លែង ទូទាំង រាជធានី ភ្នំពេញ ។
មន្ត្រី ដដែល បាន បញ្ជា កថា ព្យូទ័រ យួរ ដៃ ទាំងនេះ គឺ ប្រគល់ ជូន ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ ១៤ គ្រឿង ក្រុម គ្រូពេទ្យ ស្ម័គ្រ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ១៤ គ្រឿង និង ក្រុម គ្រូពេទ្យ របស់ មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ ៤០ គ្រឿង ។
ថវិកា អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ចំនួន ១០០ លាន រៀល ត្រូវបាន បរិច្ចាគ ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន នាំយក ថវិកា ចំនួន ១០០ លាន រៀល របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី បរិច្ចាគ ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ពេល នៅ មាន ជន្មាយុ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី បាន ចូលរួម ធ្វើ កិច្ចការ មនុស្សធម៌ នៅក្នុង សង្គម ជាច្រើន ជាពិសេស ជា ពុទ្ធ សាសនិក ជន មួយ រូប ពោរពេញ ដោយ សទ្ធា ជ្រះថ្លា ដោយ បាន ចូលរួមចំណែក កសាង សមិទ្ធផល ជាច្រើន តម្កល់ ជា ឧត្តម ប្រយោជន៍ សម្រាប់ ព្រះពុទ្ធ សាសនា ផងដែរ ។
ថ្ងៃស្អែក ព្រះមហាក្សត្រ និង ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ យាង ត្រឡប់ ពី ចិន
( ភ្នំពេញ ) ៖ ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី និង ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ នរោត្តម មុនិនា ថ សីហនុ ជាទីគោរព សក្តារៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៅ រសៀល ថ្ងៃចន្ទ ទី០៥ ខែមេសា ឆ្នាំ ២០២១ ស្អែក នេះ នឹង យាង ត្រឡប់មក កម្ពុជា វិញ ហើយ បន្ទាប់ពី ព្រះអង្គ ទាំង ទ្វេ យាង ពិនិត្យ ព្រះរាជ សុខភាព រយៈពេល ជាង ១ខែ នៅ រដ្ឋធានី ប៉េកាំង ប្រទេស ចិន ។
ស្ថានទូត បរទេស និង អង្គការ ដៃគូរ អភិវឌ្ឍន៍ ជាច្រើន ប្រចាំ កម្ពុជា ថ្លែងអំណរគុណ សម្ដេច តេជោ ហ៊ុន សែន ដែល អនុញ្ញាតឱ្យ មន្ត្រី ក្នុង ស្ថាប័ន ខ្លួន ទទួលបាន វ៉ាក់សាំង កូវីដ១៩
បណ្ដា អង្គ ទូត ប្រចាំ កម្ពុជា ទាំងនោះ បាន លើកឡើង ទៀត ថា ប្រសាសន៍ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល ថា « កម្ពុជា ជា ប្រទេស តូច តែ មាន បេះដូង ធំ » គឺជា ការពិត ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ០៤ ខែមីនា ឆ្នាំ ២០២១ កន្លងទៅ សម្ដេច តេជោ ហ៊ុន សែន បាន ប្រកាស ពី ការសម្រេច អនុញ្ញាតឱ្យ ជនបទេស នៅ កម្ពុជា ដែល ជា មន្ត្រី ការទូត មន្ត្រី របស់ ស្ថាប័ន ហិរញ្ញវត្ថុ អន្តរជាតិ និង មន្ត្រី អង្គការ ដៃគូ អភិវឌ្ឍន៍ ទាំងអស់ ទទួលបាន ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដោយ ឥត គិត ថ្លៃ ដូច ប្រជាពលរដ្ឋ ខ្មែរ ទូទៅ ។
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ ថ្ងៃអាទិត្យ ទី០៤ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ចុះ ពិនិត្យ ដំណើរការចាក់ វ៉ាក់សាំង កូវីដ១៩ របស់ ក្រុមហ៊ុន ស៊ីណូ វ៉ាក់ ជូន មន្ត្រីរាជការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
ក្រសួង សាធារណការ ក៏ ដូចជា ក្រសួង ស្ថាប័ន ដទៃ ទៀត បាន ចាប់ផ្តើម យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ជូន មន្ត្រីរាជការ កាលពី ថ្ងៃទី ០១ ខែមេសា កន្លងទៅ នេះ ។ តាម ផែនការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ត្រូវ ចាក់ ជូន មន្ត្រី ប្រមាណ ជា ១. ៩៩៣ នាក់ ។ រយៈពេល ៣ ថ្ងៃ កន្លងទៅ នេះ ក្រសួង ចាក់ បាន ប្រមាណ ១. ២១៩ នាក់ ហើយ ។
ក្នុង ឱកាស នោះ ទាំង លោក ទេសរដ្ឋមន្ត្រី និង លោក ហ៊ុន ម៉ានី សុទ្ធតែ បាន គូសបញ្ជាក់ ពី សារសំខាន់ នៃ វ៉ាក់សាំង កូវីដ១៩ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល កំពុង រាតត្បាត នៅ កម្ពុជា ក៏ ដូចជា ពិភពលោក ។
លោក ស៊ុន ចាន់ថុល បាន គូសបញ្ជាក់ ថា វ៉ាក់សាំង កូវីដ១៩ ជា ឧបករណ៍ ថ្មី មួយ បន្ថែម ទៀត លើ វិធានការ សុខាភិបាល ដែល មាន ស្រាប់ សម្រាប់ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ និង សង្គ្រោះ ជីវិត មនុស្ស ដោយ ជួយ បុគ្គល មិន ឱ្យ ឈឺ ធ្ងន់ នៅពេល ឆ្លង ជំងឺ កូវីដ១៩ និង កាត់បន្ថយ ការព្យាបាល នៅ មន្ទីរពេទ្យ ។
ដោយឡែក លោក ហ៊ុន ម៉ានី បាន លើកឡើង ថា វ៉ាក់សាំង គឺជា ដំណោះស្រាយ មួយ ដ៏ ចាំបាច់ សម្រាប់ ការពារ ប្រជាជន និង សហគមន៍ ទាំងមូល ចៀស ផុត ពី ការឆ្លង រាលដាល ទ្រង់ទ្រាយ ធំ ណា មួួយ ។
ទាំង លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល និង លោក ហ៊ុន ម៉ានី បាន បង្ហាញ ពី ការគិតគូរ និង កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការស្វះស្វែងរក វ៉ាក់សាំង មក ចាក់ ជូន ប្រជាពលរដ្ឋ ។ ក្នុង នោះ ការគ្រោងទុក របស់ រាជ រដ្ឋាភិបាល ត្រូវ រក វ៉ាក់សាំង ចាក់ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន យ៉ាងតិច ១០លាន នាក់ ។
លោក ស៊ុន ចាន់ថុល បាន លើកឡើង ថា « រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ជា ប្រមុខ លោក បាន គិតគូរ ខ្លាំង ណាស់ ក្នុង ការការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ពី ការរាត ត្បាត ជំងឺ កូវីដ១៩ ហើយ បាន ប្រឹងប្រែង ក្នុង ការស្វះស្វែងរក វ៉ាក់សាំង ចាក់ ជូន ប្រជាពលរដ្ឋ របស់ យើង ។ នេះ គឺជា គំរូភាព គឺជា គុណ តម្លៃ ដ៏ ធំធេង របស់ មេដឹកនាំ របស់ យើង » ។
ដោយឡែក លោក ហ៊ុន ម៉ានី បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល បាន កិច្ច ខិតខំ ប្រឹងប្រែង កៀរគរ ស្វែងរក វ៉ាក់សាំង ពី គ្រប់ ទិសទី តាម យន្តការ នានា ប្រកបដោយ ភាពបត់បែន ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ទទួលបាន វ៉ាក់សាំង ។
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល និង លោក ហ៊ុន ម៉ានី បាន អំពាវនាវ ដល់ មន្ត្រីរាជការ ក៏ ដូចជា ជន ដែល បាន ចុះឈ្មោះ ឬ ផ្តល់ អាទិភាព ក្នុង ការចាក់ វ៉ាក់សាំង នោះ រួសរាន់ មក ចាក់ វ៉ាក់សាំង ដើម្បី បាន ជញ្ជាំង ការពារ សុខភាព របស់ ខ្លួន និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ នៅក្នុង សហគមន៍ ។
លោក ស៊ុន ចាន់ថុល និង លោក ហ៊ុន ម៉ានី ក៏ បាន ក្រើន រំលឹក ដល់ អ្នក ចាក់ វ៉ាក់សាំង ដែរ ថា ទោះបី បាន ចាក់ វ៉ាក់សាំង ហើយក៏ ដោយ ក៏ មិន ត្រូវ ភ្លេច ខ្លួន អនុវត្ត តាម វិធាន នានា ដែល ណែនាំ ដោយ ក្រសួង សុខាភិបាល នោះ ឡើយ ។ ជាពិសេស វិធាន « ៣កុំ និង ការពារ » ព្រោះថា ទោះបី ចាក់ វ៉ាក់សាំង ហើយក៏ ដោយ ក៏ មេរោគ នៅតែ មាន លទ្ធភាព ឆ្លង ។ គ្រាន់តែ វា មិន បង្ក ទុក្ខ ទោស ដល់ សុខភាព ខ្លាំង និង ព្យាបាល ឆាប់ ជា ជាង អ្នក មិន បាន ចាក់ វ៉ាក់សាំង ។
សូម បញ្ជាក់ ថា ក្នុង ដំណើរ ចុះ ពិនិត្យ ការចាក់ វ៉ាក់សាំង នៅ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នេះ លោក ស៊ុន ចាន់ថុល បាន អញ្ជើញ លោក ហ៊ុន ម៉ានី ពិនិត្យ សមិទ្ធផល របស់ ក្រសួង កន្លែង ផ្តល់ សេវា សាធារណៈ និង វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន ផងដែរ ៕
អភិបាល ខេត្ត ពោធិ៍សាត់ ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន ចំពោះ ក្រុមគ្រួសារ សព លោក ឧត្តមសេនីយ៍ ត្រី សូ សុវណ្ណឌី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ និង ក្នុង នាម ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ពោធិ៍សាត់ បាន ផ្ញើ សារលិខិត រំលែក មរណទុក្ខ ចំពោះ មរណភាព របស់ លោក ឧត្តមសេនីយ៍ ត្រី សូ សុវណ្ណឌី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត
លោក ឧត្តមសេនីយ៍ ត្រី សូ សុវណ្ណឌី បាន ទទួលមរណភាព នៅ ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ ក្នុង ជន្មាយុ ៥៩ ឆ្នាំ ដោយ រោគា ពាធ នៅ សង្កាត់ ទួល ស្វាយ ព្រៃ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ៕
ទីតាំង ទាំង១០ ដែល ត្រូវ ចាក់ វ៉ាក់សាំង Sinovac ជូន ដល់ ថ្នាក់ដឹកនាំ មន្ត្រី ព្រះសង្ឃ និង ពលរដ្ឋ ទូទាំង ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ ) ៖ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ទីតាំង ចំនួន ១០ទីតាំង ដែល ត្រូវ ដំណើរការចាក់ វ៉ាក់សាំង Sinovac ជូន ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ព្រះសង្ឃ និង ប្រជាពលរដ្ឋ រស់ នៅក្នុង ក្រុង - ស្រុក ទាំង៧ ទូទាំង ខេត្ត ពោធិ៍សាត់ ។
ទីតាំង ទាំង ១០ នោះ រួម មាន៖
ជាមួយគ្នា នោះ រាជ រដ្ឋាភិបាល បាន ផ្ដល់ ឱកាស ឱ្យ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ហ៊ុន ម៉ានី ចុះ បេសកកម្ម ចូលរួម ក្នុង ការចាក់ វ៉ាក់សាំង ជូន ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ព្រះសង្ឃ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ពោធិ៍សាត់ ផងដែរ ខណៈ នា ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ នេះ ពួកគាត់ បាន ធ្វើដំណើរ ទៅដល់ ខេត្ត ពោធិ៍សាត់ ហើយ ដោយ បាន ទទួល ការស្វាគមន៍ យ៉ាង កក់ក្ដៅ ពីសំណាក់ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្របខណ្ឌ ទូទាំង ខេត្ត ពោធិ៍សាត់ ។
សូម ជម្រាប ថា អស់ រយៈពេល ជាច្រើន សប្ដាហ៍ កន្លងមក ហើយ ដែល កម្ពុជា បាន ប្រយុទ្ធ ប្រឆាំង នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ ដែល ជា ព្រឹត្តិការណ៍ ឆ្លង ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ មាន វិសាលភាព ទូលំទូលាយ ជាង ព្រឹត្តិការណ៍ មុន ៗ ។
រហូតមកទល់ ពេលនេះ ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ មិន ត្រឹមតែ បាន ឆ្លង រាលដាល ដល់ រាជធានី ភ្នំពេញ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ វា ថែម បាន ឆ្លង រាលដាល ដល់ បណ្ដា ខេត្ត ផ្សេង ទៀត ផងដែរ ។ ដើម្បី ទប់ស្កាត់ ជំងឺ នេះ កុំ ឱ្យ ឆ្លង រាលដាល កាន់តែ ខ្លាំង រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ វិធានការ ជាច្រើន ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល កាន់តែ ធំ ទៅ ៗ ៕ មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង ប្រកាស ពី ការរក ឃើញ អ្នក ឆ្លង កូវីដ ម្នាក់ . សូម អ្នក ពាក់ព័ន្ធ ទៅ ពិនិត្យ សុខភាព ជាបន្ទាន់
មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង បញ្ជាក់ ថា អ្នក ឆ្លង កូវីដ១៩ នោះ គឺជា បុរស ជនជាតិ ខ្មែរ ឈ្មោះ សោម ឡូ អាយុ ៣៦ ឆ្នាំ មាន មុខងារ ជា អ្នកធ្វើការ នៅ រោងចក្រ នៅ រាជធានី ភ្នំពេញ ដោយ ទទួល លទ្ធផល ធ្វើតេស្ត លើក ទី២ « វិជ្ជមាន » នៅ ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង បាន បង្ហាញ ប្រវត្តិ ធ្វើដំណើរ របស់ បុរស ខាងលើ មុន ប្រកាស ថា កើត កូវីដ១៩ ដូច ខាងក្រោម៖
គាត់ បាន មកកាន់ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង នៅ ថ្ងៃចន្ទ ទី២៩ ខែមីនា ឆ្នាំ ២០២១ ដើម្បី ពិនិត្យ សុខភាព ដោយ មាន អាការៈ ក្តៅ ខ្លួន លើស ពី ៣៨ អង្សា សេ ជាមួយនឹង រោគសញ្ញា ពិបាក ដកដង្ហើម និង ឈឺក ។ ក្រុម គ្រូពេទ្យ បែងចែង អ្នកជំងឺ បាន បញ្ជូន បុរស នោះ បន្ត មក ក្រុមការងារ ព្យាបាល ថែទាំ ពិសេស ដើម្បី ធ្វើតេស្ត រក ជំងឺ កូវីដ - ១៩ ។
បន្ទាប់ពី ធ្វើតេស្ត រួច បុរស នោះ ត្រូវបាន ណែនាំ និង អនុញ្ញាតឲ្យ ត្រឡប់ ទៅ ធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ វិញ និង រង់ចាំ លទ្ធផល តេស្ត ។ នៅ ថ្ងៃ បន្ទាប់ វេលា ម៉ោង ១១៖០០ នាទី ព្រឹក បុរស នោះ បាន ចូលមក សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង និង ត្រូវបាន ដាក់ ឲ្យ ព្យាបាល ដាច់ដោយឡែក នៅ ផ្នែក អាគារ ជំងឺ ឆ្លង នៃ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ។
តាម ការសាកសួរ បុរស នេះ ចាប់ មាន សញ្ញា ក្អក និង ពិបាក ដកដង្ហើម នៅ ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២១ ម៉្លេះ ។ លុះ ព្រឹក ថ្ងៃ បន្ទាប់ ត្រូវនឹង ថ្ងៃទី ២៩ ខែ ឆ្នាំ ដដែល វេលា ម៉ោង ៤៖០០ ព្រឹក គាត់ ក៏ បាន ជិះ ម៉ូតូ ម្នាក់ឯក មកកាន់ ខេត្ត កំពង់ឆ្នាំង ឯ ផ្ទះ របស់ គាត់ នៅ ភូមិ ម៉ុង បារាំង សង្កាត់ ប្អែរ ក្រុង កំពង់ឆ្នាំង ខេត្ត កំពង់ឆ្នាំង នៅ ម៉ោង ៦៖៣០ នាទី ព្រឹក ។ នៅ ម៉ោង ៨៖០០ គាត់ បាន ធ្វើដំណើរ មកកាន់ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ជាមួយ ភរិយា របស់ គាត់ ដោយ ម៉ូតូ រៀង ៗ ខ្លួន ។
បើ តាម មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង . អ្នក ពាក់ព័ន្ធ ជាមួយនឹង បុរស ខាងលើ សូម ប្រញាប់ ទៅ ពិនិត្យ និង ដើម្បី តាមដាន សុខភាព ជាបន្ទាន់ តាម វិធាន សុខាភិបាល ៕
លោក ហ៊ុន ម៉ានី៖ វ៉ាក់សាំង ជា ដំណោះស្រាយ ចាំបាច់ សម្រាប់ ការពារ សុខភាព . អ្នក មាន ឈ្មោះ សូម រួសរាន់ ទៅ ចាក់ វ៉ាក់សាំង
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី សមាជិក សភា កម្ពុជា និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ទទូច ដល់ មន្ត្រីរាជការ និង អ្នក ដែល បាន ចុះឈ្មោះ ចាក់ វ៉ាក់សាំង កូវីដ១៩ រួចរាល់ ហើយ នោះ សូម រួសរាន់ ទៅ ចាក់ វ៉ាក់សាំង ។
ការលើកឡើង របស់ អ្នកតំណាងរាស្ត្រ វ័យ ក្មេង របស់ កម្ពុជា រូប នេះ បាន ធ្វើឡើង ពេល អញ្ជើញ ចុះ ពិនិត្យមើល ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត នៃ សម្ព័ន្ធ គ្រូពេទ្យ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ដែល កំពុង ចូលរួម ក្នុង យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ នៅ តាម ក្រសួង ស្ថាប័ន នានា នៅ ថ្ងៃអាទិត្យ ទី០៤ ខែមេសា ឆ្នាំ ២០២១ នេះ ។
លោក ហ៊ុន ម៉ានី បាន គូសបញ្ជាក់ ថា ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត នៃ សម្ព័ន្ធ គ្រូពេទ្យ សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ខិតខំ ប្រឹងប្រែង មិន ខ្លាច នឿយហត់ សំដៅ ធ្វើ យ៉ាងណា ឱ្យ ការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ អាច បាន សម្រេច តាម ផែនការ ។
លោក ហ៊ុន ម៉ានី ក៏ បាន លើកឡើង ដែរ ថា កិច្ច ខិតខំ ប្រឹងប្រែង ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល ដែល បាន កៀរគរ ស្វែងរក វ៉ាក់សាំង ពី គ្រប់ ទិសទី តាម យន្តការ នានា ប្រកបដោយ ភាពបត់បែន គឺ ដើម្បី អាច ឱ្យ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ទទួលបាន វ៉ាក់សាំង ក្នុង កម្រិត មួយ ។
លោក បាន គូសបញ្ជាក់ ថា វ៉ាក់សាំង គឺជា ដំណោះស្រាយ មួយ ដ៏ ចាំបាច់ សម្រាប់ ការពារ ប្រជាជន និង សហគមន៍ ទាំងមូល ចៀស ផុត ពី ការឆ្លង រាលដាល ទ្រង់ទ្រាយ ធំ ណា មួួយ ។
លោក ម៉ានី បាន អំពាវនាវ ដល់ អ្នក មាន ឈ្មោះ ក្នុង បញ្ជី ត្រូវ ទទួល វ៉ាក់សាំង ឱ្យ រួសរាន់ ទៅ ចាក់ វ៉ាក់សាំង ដើម្បី ការពារ សុខភាព ខ្លួន និង សហគមន៍ ។ លោក បាន អំពាវនាវ យ៉ាង ដូច្នេះ « ខ្ញុំ សូម អំពាវនាវ ដល់ បងប្អូន ដែល ត្រូវ មក ទទួល វ៉ាក់សាំង សូមអញ្ជើញ មក ទទួល វ៉ាក សាំង ឱ្យ បាន ឆាប់ រួសរាន់ ដើម្បី ទទួលបាន ខែល ការពារ ខ្លួន ក៏ ដូចជា សហគមន៍ របស់ យើង ផងដែរ » ។
សូម បញ្ជាក់ ថា គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ កាលពី ថ្ងៃទី ០១ ខែមេសា កន្លងទៅ នេះ បាន បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ នៅ ទូទាំង ប្រទេស ដោយ កំណត់ ជន គោលដៅ ត្រូវ ចាក់ ប្រមាណ ៧៤៥.០០០ នាក់ ។
ក្រសួង បន្ត ថា នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២១ វេលា ម៉ោង ០៨៖០០ នាទី ព្រឹក ស្ត្រី ខាងលើ បាន ចូលមក សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ដោយ អ្នកជំងឺ មាន ស្ថានភាពហត់ ខ្លាំង ដែល តម្រូវ ឱ្យ ក្រុម គ្រូពេទ្យ យក អ្នកជំងឺ ទៅ សម្រាក ព្យាបាល ក្នុង បន្ទប់ សង្គ្រោះ បន្ទាន់ ដោយ ប្រើប្រាស់ ម៉ាស៊ីន ជំនួយ ដង្ហើម និង បាន យក សំណាក ទៅ វិភាគ ភ្លាម ៗ ។
លទ្ធផល ពិនិត្យ សំណាក របស់ គាត់ ដែល ទទួលបាន ពី មន្ទីរពិសោធន៍ វិទ្យាស្ថាន ជាតិ សុខភាព សាធារណៈ បញ្ជាក់ ថា មាន វិជ្ជមាន វីរុស កូវីដ - ១៩ ។
ការសន្និដ្ឋាន របស់ ក្រុម គ្រូពេទ្យ៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ៧២ ឆ្នាំ ខាងលើ នេះ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ វិបត្តិ ផ្លូវ ដង្ហើម ធ្ងន់ធ្ងរ និង រលាក សួត ទាំង សងខាង ធ្ងន់ធ្ងរ បណ្តាល មកពី វីរុស កូវីដ - ១៩ ។
ក្រសួង សុខាភិបាល សូម ចូលរួមចំណែក សោកស្តាយ ជា ពន់ពេក និង សូម ចូលរួម មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជា ទី បំផុត ជាមួយ ក្រុមគ្រួសារ សព ។
យោង តាម របាយការណ៍ ផ្លូវការ របស់ ក្រសួង សុខាភិបាល គិត ត្រឹម ថ្ងៃទី ០៤ ខែ មេស នេះ អ្នកជំងឺ កូវីដ១៩ ដែល បាន ស្លាប់ បាត់បង់ជីវិត មាន ចំនួន សរុប ២៥ នាក់ ហើយ ។ ក្នុង នោះ ២០ នាក់ ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ និង អ្នកជំងឺ ៥នាក់ ស្លាប់ ដោយសារ អាការៈ នៃ ជំងឺ ផ្សេង ។
ខាងក្រោម ជា ទិន្នន័យ អ្នកជំងឺ ដែល បាន ស្លាប់ បាត់បង់ជីវិត បង្ហាញ ផ្លូវការ ដោយ ក្រសួង សុខាភិបាល៖
អ្នកជំងឺ កូវីដ១៩ ដែល ស្លាប់ ដោយសារ អាការ រោគ ផ្សេង មាន ៥នាក់ រួម មាន៖
( ភ្នំពេញ ) ៖ ដោយ សេចក្តីគោរព ដឹងគុណ ដ៏ ធំធេង បំផុត ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ថ្ងៃ ខួបកំណើត របស់ សម្តេច នៅ ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ នេះ លោក ទិត សុធា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល បាន រៀប រៀង នូវ អត្ថបទ កំណាព្យ ខ្លី មួយ ជា ការគោរព ជូនពរ ដោយ ស្មោះស្ម័គ្រ បំផុត ចំពោះ សម្តេច ក្រោម ចំណងជើង ថា « សម្តេច តេជោ បេះដូង កម្លោះ » ។
« សម្តេច តេជោ បេះដូង កម្លោះ » មាន អត្ថន័យ ទាំងស្រុង ខាងក្រោម នេះ៖
៣ ថ្ងៃ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ចាក់ បាន ជិត ១០ម៉ឺន នាក់
( ភ្នំពេញ ) ៖ យោតាម របាយការណ៍ ក្រសួង សុខាភិបាល បាន បង្ហាញ ថា រយៈពេល ៣ ថ្ងៃ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ស៊ីណូ វ៉ាក់ ក្រុម គ្រូពេទ្យ បាន ចាក់ ជូន មន្ត្រីរាជការ និង ជន គោលដៅ នៅ ទូទាំង ប្រទេស បាន ជិត ១០ម៉ឺន នាក់ ។
របាយការណ៍ របស់ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ផងដែរ ថា ការចាក់ វ៉ាក់សាំង ទាំង៣ ប្រភេទ ( ស៊ីណូ ហ្វាម អាស្ត្រា ហ្សេនីកា និង ស៊ីណូ វ៉ាក់ ) ចាក់ បាន ជាង ៣៧ម៉ឺន នាក់ ហើយ ។
គួរ បញ្ជាក់ ថា គ្រោះថ្នាក់ ខាងលើ បាន កើតឡើង កាលពី ព្រឹក ថ្ងៃសុក្រ សប្តាហ៍ នេះ នៅពេល រថភ្លើង មួយ ខ្សែ ដឹក មនុស្ស ប្រហែល ៥០០ នាក់ បាន បុក រថយន្ត ស្ទូច មួយ គ្រឿង នៅក្បែរ ច្រក រូង ក្រោម ដី មួយ កន្លែង ក្នុង ទីក្រុង ហ័រលៀន (Hualien) ហើយ បណ្តាលឲ្យ ទូរ រថភ្លើង ០៥ កំណាត់ ដំបូង ខ្ទាត ចេញ ពីលើ ផ្លូវ រួចទៅ បុក នឹង ជញ្ជាំង នៃ រូង ក្រោម ដី នោះ ៕ តំណាងរាស្រ្ត កំពង់ឆ្នាំង និង ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ចុះ សួរសុខទុក្ខ ពលរដ្ឋ និង ក្រុម គ្រូពេទ្យ កំពុង ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ - ១៩
( កំពង់ឆ្នាំង ) ៖ ដោយ មាន ការយកចិត្តទុកដាក់ គិត គូរ ដល់ ក្រុម គ្រូពេទ្យ ពី ថ្នាក់ដឹកនាំ នា ព្រឹក ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ លោកស្រី កែ ច័ន្ទ មុនី អ្នកតំណាងរាស្រ្ត មណ្ឌល កំពង់ឆ្នាំង និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ឃុំ ពង្រ និង លោកស្រី ដោក សុទ្ធា ទីប្រឹក្សា រាជ រដ្ឋាភិបាល បាន ចុះ សួរសុខទុក្ខ ក្រុម គ្រូពេទ្យ ប្រចាំ ការ និង ចាក់ វ៉ាក់សាំង ការពារ កូវីដ - ១៩ ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង មណ្ឌល សុខភាព ពង្រ ស្រុក រលាប្អៀរ ។
លោកស្រី ទាំង ពីរ និង ថ្នាក់ដឹកនាំ ស្រុក បាផ្សព្វផ្សាយ ឲ្យបាន ជ្រួតជ្រាប ដល់ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ឱ្យ យល់ដឹង អំពី វិធី ការពារ នៃ ការឆ្លង ជំងឺ កូវីដ - ១៩ ដោយ ឲ្យ ពួកគាត់ អនុវត្ត តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល និង ក្រសួង សុខាភិបាល ដើម្បី រួមគ្នា ទប់ស្កាត់ នូវ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ កុំ ឱ្យ ឆ្លង ចូលក្នុង សហគមន៍ ។
លោក យង់ សៅ វុឌ្ឍី អភិបាល ស្រុក រលាប្អៀរ បាន ប្រាប់ Fresh News នៅ រសៀល ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ នេះ ឲ្យដឹង ថា នា ឱកាស ដែល លោកស្រី ទាំង ពីរ និង ថ្នាក់ដឹកនាំ ស្រុក បាន ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ និង ក្រុម គ្រូពេទ្យ ដែល កំពុង មមាញឹក ក្នុង ការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ នៅ មណ្ឌល សុខភាព ពង្រ ។ លោកស្រី ទាំង ពីរ និង ថ្នាក់ដឹកនាំ ស្រុក ក៏ បាន នាំយក នូវ ភេសជ្ជៈ មួយចំនួន ដែល មាន ទឹក សុទ្ធ ទឹក ផ្លែឈើ និង សម្ភារៈ មួយចំនួន ចែកជូន ក្រុម គ្រូពេទ្យ និង ប្រជាពលរដ្ឋ នៅ ទីនោះ ផងដែរ ។
ការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ជាបន្ត នេះ លោក បាន ផ្ដល់ អាទិភាព មុន គេ គឺ អាជីវករ ផ្សារ គ្រូបង្រៀន ម៉ូតូ ឌុប តៃ កុង រថយន្ត តាក់ស៊ី ត្រូវតែ មាន អាទិភាព ក្នុង ការទទួលបាន វ៉ាក់សាំង មុន ប្រជាពលរដ្ឋ ទូទៅ ។ លោក នឹង ចាក់ ជូន ប្រជាពលរដ្ឋ ទាំងអស់ ឲ្យបាន គ្រប់ ៗ គ្នា ក្នុង ស្រុក រលាប្អៀរ ទាំងមូល ផងដែរ ៕
( ភ្នំពេញ ) ៖ ឯកឧត្ដម នឹម ថូត និង លោកជំទាវ គីម ចន្ធូ ឧបត្ថម្ភ ថវិកា ១ពាន់ ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
ឯកឧត្ដម នឹម ថូត កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ ឯកឧត្ដម ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
បើកបរ សូម កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៤នាក់ និង របួស ១៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៤ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ១៥ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . ស្រវឹង . មិន ប្រកាន់ ស្តាំ និង កត្តា យាន ៕
រកឃើញ អ្នកវិជ្ជមាន កូវីដ១៩ ចំនួន ៤នាក់ បន្ថែម ទៀត នៅ សង្កាត់ ស្ទឹងមានជ័យ ទី១ ខណ្ឌ មានជ័យ
ក្រុម គ្រូពេទ្យ ក្រសួង សុខាភិបាល បាន ចុះ យក អ្នកវិជ្ជមាន កូវីដ១៩ ចំនួន ៤នាក់ ទាំង យប់ បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ហ្លួង ម៉ែ ។
អាជ្ញាធរ ខណ្ឌ ស្ទឹងមានជ័យ ប្រកាស ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន សង្កាត់ ស្ទឹងមានជ័យ ទី១ មេត្តា ប្រុងប្រយ័ត្ន ស្តាប់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ចូលរួម អនុវត្ត នូវ វិធានការ ៣ការពារ ៣កុំ ៕ ហាង ស្ទីម សូណា ម៉ាស្សា មួយ កន្លែង នៅ ខណ្ឌ ពោធិ៍សែនជ័យ នៅ បន្ត លួច បើក ត្រូវ អាជ្ញាធរ ចុះ បិទ និង ឃាត់ មនុស្ស ១២នាក់
( ភ្នំពេញ ) ៖ ហាង យីហោ « ផ្ទះ សុខភាព » ស្ទីម ម៉ាស្សា សូណា ត្រូវបាន អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ ចុះបង្ក្រាប និង បិទ ទីតាំង មួយ នេះ តែម្ដង ព្រមទាំង ឃាត់ខ្លួន មនុស្ស ប្រុស ស្រី ចំនួន ១២នាក់ ខណៈ ជំងឺ កូវីដ កំពុង រាតត្បាត នៅក្នុង សហគមន៍ យ៉ាង គំហុក ដោយ បំពាន និង មិន ស្តាប់ ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ការចុះ បិទ ទីតាំង ម៉ាស្សា ខាងលើ នេះ បាន ធ្វើឡើង កាល ល្ងាច ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២០១ នេះ នៅ ចំណុច ផ្លូវ បេតុង ភូមិ ត្រពាំង ថ្លឹង៣ ក្នុង សង្កាត់ សង្កាត់ ចោម ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
លោក ហែម ដារិទ្ធិ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ឲ្យដឹង ថា ក្រោយ ក្រុមការងារ បាន ត្រួតពិនិត្យ ឃើញ ថា ហាង ខាងលើ បាន បន្ត លួច បើក អាជីវកម្ម ទោះបី អាជ្ញាធរ ធ្វើ ការណែនាំ ក៏ ដូចជា ការជូនដំណឹង រួច មកហើយ ក្តី ក៏ ម្ចាស់ ហាង មួយ នេះ មិន បាន ចូលរួម សហការណ៍ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ នោះ ឡើយ ។
អាជ្ញាធរ បាន ចុះ ត្រួតពិនិត្យ ជាក់ស្ដែង ឃើញ ថា ទីតាំង នេះ ពិតជា បើក ដំណើរការ នោះ ទើប អាជ្ញាធរ ខណ្ឌ បាន ដឹកនាំ កម្លាំង ចុះបង្ក្រាប សម្រេច បិទ ទីតាំង មួយ នេះ ជា បណ្ដោះអាសន្ន និង ធ្វើ ការឃាត់ខ្លួនអ្នកមើល ការខុសត្រូវ និង ភ្ញៀវ ចំនួន ១២នាក់ បញ្ជូន ទៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី សាកសួរ និង កសាង សំណុំរឿង ចាត់ការ បន្ត តាម និតិវិធី ច្បាប់ ។
លោក ហែម ដារិទ្ធិ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ជាពិសេស បងប្អូន អាជីវករ ដែល ប្រកប អាជីវកម្ម ក្នុង មូលដ្ឋាន ខណ្ឌ មេត្តា ចូលរួម អនុវត្តន៍ តាម បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន « ៣ការពារ និង ៣កុំ » ឱ្យ បាន ត្រឹមត្រូវ ខ្ជាប់ខ្ជួន ។
វិធានការ៣កុំ និង ៣ការពារ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ប្រកបដោយ ប្រសិទ្ធភាព « ៣កុំ » មាន ន័យ ថា៖ ទី ១៖ កុំ ចាប់ ដៃ គ្នា ដោយ ងាក មក ប្រើ វប្បធម៌ សំពះ របស់ ខ្មែរ យើង ជា ជំនួស វិញ ។ ទី ២៖ កុំ ទៅ កន្លែងណា ដែល មាន មនុស្ស ច្រើន និង ទី៣៖ កុំ នៅក្នុង បន្ទប់ បិទ ជិត គ្មាន ខ្យល់ ចេញ ចូល ជាពិសេស បន្ទប់ ដែល មាន ម៉ាស៊ីន ត្រជាក់ ។
ចំណែក « ៣ការពារ » គឺ ៖ ទី ១៖ ត្រូវ នាំគ្នា ពាក់ ម៉ាស់ ឲ្យបាន គ្រប់ គ្នា និង គ្រប់ ទីកន្លែង ជាពិសេស នៅ តាម ទីកន្លែង សាធារណៈ ។ ទី ២៖ ត្រូវ លាង សម្អាត ដៃ ជាមួយ អាល់កុល ឬ ជែល ជាប្រចាំ និង ឲ្យបាន ញឹកញាប់ ជាពិសេស មុនពេល បរិភោគ អាហារ និង ក្រោយពេល បាន ប៉ះពាល់ វត្ថុ ផ្សេង ៗ និង ទី៣៖ ត្រូវ រក្សា គម្លាត សុវត្ថិភាព បុគ្គល ដោយ ត្រូវ នៅ ឃ្លាត ពី គ្នា យ៉ាងតិច មួយ ម៉ែត្រ កន្លះ ជាដើម ៕ វ៉ាក់សាំង កូវីដ - ១៩ ជាង « ១៣៦ លាន ដូស » ត្រូវបាន ចាក់ ជូន ប្រជាជន នៅ ទូទាំង ប្រទេស ចិន គិត ត្រឹម ថ្ងៃសៅរ៍ សប្តាហ៍ នេះ
ក្រុមការងារ ដដែល នេះ បាន គូសបញ្ជាក់ ទៀត ថា ល្បឿន នៃ ការចាក់ វ៉ាក់សាំង បាន កើនឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ខណៈ ដែល ការសិក្សា ស្រាវជ្រាវ និង ការអភិវឌ្ឍន៍ ក្នុង វិស័យ ផលិត វ៉ាក់សាំង នៅក្នុង ប្រទេស ក៏ បាន រីកចម្រើន គួរឲ្យ កត់សម្គាល់ ផងដែរ ៕
រដ្ឋបាល ខេត្ត ព្រះសីហនុ ប្រកាស ផ្អាក ជា បណ្តោះអាសន្ន ការចេញ ចូល ទីតាំង មួយ ផ្នែក នៃ តំបន់ ទំនប់ រលក ក្រោយ រកឃើញ អ្នក កើត កូវីដ ជា បន្តបន្ទាប់
យោង តាម លិខិត របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ បាន បញ្ជាក់ ថា រដ្ឋបាល សូម ជម្រាប ជូន បងប្អូន ប្រជាពលរដ្ឋ នៅ តំបន់ ទំនប់ រលក ឱ្យ បាន ជ្រាប ថា « យោង តាម លទ្ធផល តេស្ត វត្ថុ សំណាក ដែល ក្រុម ឆ្លើយតប បន្ទាន់ នៃ មន្ទីរ សុខាភិបាល ខេត្ត បាន យក ពី ប្រជាពលរដ្ឋ នៅ តំបន់ ទំនប់ រលក ចាប់ពី ថ្ងៃទី ២៧ ខែមីនា ឆ្នាំ ២០២១ មក គឺ បាន បញ្ជាក់ ថា មាន ករណី វិជ្ជមាន វីរុស កូវីដ១៩ ពាក់ព័ន្ធ ជាមួយ មនុស្ស នៅក្នុង តំបន់ នោះ ជា បន្តបន្ទាប់ » ។
ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ បន្ត ទៀត រដ្ឋបាល ខេត្ត សម្រេច បិទ តំបន់ នោះ ជាបន្ទាន់ ចាប់ពី ត្រឹម ទីស្នាក់ការ កងរាជអាវុធហត្ថ ទំនប់ រលក ទៅដល់ រំដួល ជើង ភ្នំ ( ក្រុម ទី៦ ) និង ចាប់ពី ផ្លូវ រថភ្លើង ( ទាំង សង ផ្លូវ ) នៅ ខាងក្រោយ សាលា សាគូរ៉ា មិត្តភាព កម្ពុជា ជប៉ុន រហូតដល់ មាត់ សមុទ្រ ដោយ មិន អនុញ្ញាតឲ្យ មាន ការចេញ - ចូលំ តំបន់ នោះ បន្ត ទៀត ឡើយ ។
ក្រុមការងារ ស្រាវជ្រាវ និង តាមដាន បុគ្គល សង្ស័យ ថា មាន ផ្ទុក ជំងឺ កូវីដ - ១៩ នឹង ចុះ ស្រាវជ្រាវ សម្ភាសន៍ អ្នក ពាក់ព័ន្ធ ក្នុង ទីតាំង នោះ ហើយ ក្រុម ឆ្លើយតប បន្ទាន់ នៃ មន្ទីរ សុខាភិបាល ខេត្ត នឹង ចុះ យក វត្ថុ សំណាក ពី អ្នក រស់ នៅក្នុង តំបន់ នោះ ទាំងអស់ ដើម្បី ធ្វើតេស្ត រក វីរុស កូវី៥ - ១៩ ។
ក្នុង ន័យ នេះ រដ្ឋបាល ខេត្ត ព្រះសីហនុ សម្រេច ផ្អាក អាជីវកម្ម និង ការលក់ដូរ គ្រប់ ប្រភេទ របស់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង តំបន់ នោះ ជា បណ្តោះអាសន្ន និង កំណត់ ជា មណ្ឌល ចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ពេល ជូនដំណឹង នេះ តទៅ រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី ។ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវតែ យក សំណាក តេស្ត និង ធ្វើចត្តាឡី ស័ក គ្រប់ ៗ គ្នា ឱ្យ បាន ត្រឹមត្រូវ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ក្នុង ករណី បងប្អូន ប្រជាពលរដ្ឋ មិន អនុវត្ត តាម ការណែនាំ ខាងលើ រដ្ឋបាល ខេត្ត ព្រះសីហនុ នឹង ចុះ អនុវត្ត វិធានការ តាម នីតិវិធី ច្បាប់ ជា ធំរ មាន ។ អាស្រ័យ ហេតុ នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ អនុវត្ត តាម ខ្លឹមសារ ខាងលើ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ៕ ចៅក្រម សាលាដំបូង រាជធានី ភ្នំពេញ ម្នាក់ ឆ្លង កូវីដ១៩
កាលពី កន្លងទៅ នេះ កូនប្រុស របស់ លោក ធ្ធាំ បុណ្ណា ត្រូវបាន រកឃើញ វិជ្ជមាន កូវីដ១៩ បន្ទាប់មក លោក និង សមាជិក គ្រួសារ ក៏ ត្រូវបាន ធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ ហើយ ធ្វើតេស្ត រក កូវីដ ។ ក្រោយ ធ្វើតេស្ត លើក ទី២ លទ្ធផល បញ្ជាក់ នៅ ល្ងាច ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ បង្ហាញ ថា លោក មាន វិជ្ជមាន កូវីដ១៩ ផងដែរ ។
ក្រៅពី លោក ចៅក្រម សាលាដំបូង រាជធានី ភ្នំពេញ ក៏ មាន សាច់ញាតិ របស់ គាត់ មួយចំនួន ទៀត ក៏ ត្រូវបាន រកឃើញ វិជ្ជមាន កូវីដ១៩ ផងដែរ ។
នៅ យប់ ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ នេះ លោក ធ្ធាំ ប៊ុណ្ណា និង សាច់ញាតិ របស់ លោក មួយចំនួន រស់ នៅ ផ្ទះ លេខ ២៨ ផ្លូវ លេខ ៣១៧ សង្កាត់ បឹងកក់ទី១ ខណ្ឌ ទួលគោក ត្រូវបាន ក្រុម គ្រូពេទ្យ ទៅ ដឹក មក ព្យាបាល នៅ មន្ទីរពេទ្យ ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ៧៖០០ នាទី ព្រឹក ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ នេះ កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង សរុប ចំនួន ២៦៨៩ នាក់ ក្នុង នោះ ករណី សហគមន៍ ២០កុម្ភៈ ចំនួន ២១៥៩ នាក់ . អ្នក ជាសះស្បើយ ចំនួន ១៦៥៣ នាក់ . អ្នក កំពុង សម្រាក ព្យាបាល ចំនួន ១០១២ នាក់ . អ្នកស្លាប់ ចំនួន ១៩ នាក់ និង ស្លាប់ ដោយ ជំងឺ ផ្សេង ពេល កំពុង ព្យាបាល កូវី ដ១៩ ចំនួន ៥នាក់ ៕ បុរស ដែល មាន មិត្ត ស្រី កើត កូវីដ១៩ ហើយ ទៅ លេង ស្រះ ចិញ្ចឹម ត្រី នៅ ស្រុក កំពង់ត្រឡាច ខេត្ត កំពង់ឆ្នាំង នៅ ពេល នេះ « វិជ្ជមាន កូវីដ១៩ » ពេល តេស្ត លើក ទី២
បើ តាម លោក ប្រាក់ វ៉ុន . បុរស ខាងលើ ត្រូវបាន ដាក់ ឲ្យ ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង និង តាមដាន សុខភាព ដោយ ផ្អែក តាម វិធាន សុខាភិបាល ។
បន្ទាប់ពី ទទួលបាន ព័ត៌មាន សុំ កិច្ចសហការ ពី រាជធានី ភ្នំពេញ នោះ អាជ្ញាធរ ស្រុក កំពង់ត្រឡាច និង ខេត្ត កំពង់ឆ្នាំង សហការ ជាមួយ ក្រុម គ្រូពេទ្យ ចុះ ពី ភ្នំពេញ ទៅ បាន នាំ ស្ត្រី មាន វិជ្ជមាន កូវីដ១៩ នេះ មក ព្យាបាល នៅ ភ្នំពេញ ។ ដោយឡែក បុរស ជា សង្សារ ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក នៅ កន្លែង ចិញ្ចឹម ត្រី ដោយ មាន ការយាម កាម ពី កម្លាំង សមត្ថកិច្ច រហូត ត្រូវ ប្រកាស ថា ឆ្លង កូវីដ១៩ នៅ ថ្ងៃទី ៤ ខែមេសា ។
បើ តាម អាជ្ញាធរ បាន ឱ្យដឹង ថា បុគ្គល ទាំង ពីរ នាក់ នេះ មិន បាន ទៅ ជាប់ពាក់ព័ន្ធ ជាមួយ ជន ដទៃ នោះ ទេ ដោយសារ ពួកគេ បាន ជិះ រថយន្ត ផ្ទាល់ខ្លួន ពី ភ្នំពេញ ហើយ ឆ្ពោះ ទៅកាន់ កន្លែង ចិញ្ចឹម ត្រី តែម្តង ៕ គណៈកម្មការ ផ្សារ ចាក់អង្រែ ចុះ បាញ់ ថ្នាំ សម្លាប់ មេរោគ ទាំង ក្នុង និង ក្រៅ ជុំវិញ បរិវេណ ផ្សារ ដើម្បី ចូលរួម បង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ និង មេរោគ ផ្សេង ៗ
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួម បង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ ដូចជា រាជ រដ្ឋាភិបាល នា ល្ងាច ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ នេះ លោក គាត តូ ប្រធាន គណៈកម្មការ ផ្សារ ចាក់អង្រែ ខណ្ឌ មានជ័យ បាន ដឹកនាំ ការងារ ចុះ បាញ់ ថ្នាំ សម្លាប់ មេរោគ នៅ ជុំវិញ ផ្សារ បរិវេណ ផ្សារ និង ក្នុង ផ្សារ ដើម្បី បង្ការ ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ នៅ សហគមន៍ ។
ក្នុង ពេល ដឹកនាំ មន្ត្រី ចុះ បាញ់ ថ្នាំ ផ្សារ ចាក់អង្រែ នេះ លោក ប្រធាន គណៈកម្មការ ផ្សារ បាន លើកឡើង ថា ក្រោយពី អាជីវករ បាន បិទ តូប លក់ ឬ រៀបចំ ឥវ៉ាន់ ទំនិញ ដាក់ ចូល ក្នុង តូប រួចរាល់ និង ជា ការចូលរួម ការពារ នូវ ការឆ្លង ជំងឺ កូវីដ១៩ គឺ មុន ក្រុមការងារ បាញ់ ថ្នាំ សម្លាប់ មេរោគ នេះ ខាង គណៈកម្មការ ផ្សារ បាន ចុះ បាញ់ ទឹក លាង សម្អាត ទីធ្លា មុខ ផ្សារ តាម ផ្លូវ ជុំវិញ ផ្សារ និង តាម ចិញ្ចើមផ្លូវ ឱ្យ មាន អនាម័យ ល្អ បរិស្ថាន ស្អាត នេះ គឺជា កត្តា សំខាន់ ណាស់ ក្នុង ការការពារ ការឆ្លង មេរោគ នេះ ផងដែរ ។
លោក បញ្ជាក់ ថា ការងារ នេះ គណៈកម្មការ ផ្សារ មិន ត្រូវ មើល រំលង ឡើយ ពេល អតិថិជន អាជីវករ មក រក ទិញ អីវ៉ាន់ ឬ មហាជន ទូទៅ ដែល ចេញ ចូល ផ្សារ គឺ ពួកគាត់ ទទួលបាន បរិយាកាស ល្អ ដែល អាច ចៀស បាន ពី ការឆ្លង មេរោគ កូវីដ១៩ បាន មួយ ចំណែក ផងដែរ ។ លោក បន្ត ថា ការងារ នេះ គណៈកម្មការ ផ្សារ នៅតែ បន្ត ចុះ ធ្វើជា ប្រចាំ ពិសេស នៅ ថ្ងៃ ចុង សប្ដាហ៍ ដូច ថ្ងៃ នេះ ជាដើម ។
លោក គាត តូ បាន បញ្ជាក់ ថា ដើម្បី សុខុមាលភាព របស់ អាជីវករ ពិសេស ប្រជាពលរដ្ឋ ចេញ ចូល ផ្សារ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ណែនាំ ឱ្យ គណៈកម្មការ ផ្សារ ចុះ បាញ់ ថ្នាំ មូស ឬ ថ្នាំ សម្លាប់ មេរោគ នៅ តាម ទីផ្សារ នានា ក្នុង រាជធានី ។
ជាមួយគ្នា នេះ គណៈកម្មការ ផ្សារ បាន លាង សម្អាត ផ្សារ ក្នុង មួយ សប្តាហ៍ លាង ម្តង ដោយ ក្រុមការងារ លាង កន្លែង ហូបចុក និង កន្លែង លក់ បន្លែ សាច់ ដែល កន្លែង នេះ វា សម្បូរ ទៅ ដោយ បាក់តេរី ច្រើន បង្កឱ្យ មាន ក្លិន ស្អុយ ឆ្អេះ ឆ្អាប ប៉ុន្តែ ចំពោះ កន្លែង មាន លក់ គ្រឿងទេស លក់ សម្លៀកបំពាក់ គឺ គាត់ បោស ជូត ដោយ ខ្លួន ឯង ជារៀងរាល់ ថ្ងៃ ទៅ ហើយ និង គណៈកម្មការ ក៏ បាន បាញ់ ថ្នាំ សម្លាប់ មេរោគ ផងដែរ ។
ក្នុង ឱកាស នេះ លោក គាត តូ ក៏ បាន បង្ហាញ ពី ការយកចិត្តទុកដាក់ ពីសំណាក់ ពី លោក អភិបាល រាជធានី ដល់ អាជីវករ ដែល ជា អ្នករង ផល ប៉ះពាល់ នៃ ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ និង អំពាវនាវ ឱ្យ អាជីក រ អតិថិជន រក្សា អនាម័យ ខ្លួនប្រាណ ពាក់ ម៉ាស ឱ្យ បាន ត្រឹមត្រូវ លាង សម្អាត ដៃ ឱ្យ បាន ញឹកញាប់ រក្សា គម្លាត ឱ្យ បាន ឆ្ងាយ ពី គ្នា មុន ប្រើប្រាស របស់ អ្វី មួយ ត្រូវតែ លាង សម្អាត ឱ្យ បាន ស្អាត ល្អ បាញ់ អាល់កុល និង ត្រូវ ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ឱ្យ បាន ទាន់ ពេលវេលាង ដែរ ៕
អភិបាល ខេត្ត ព្រៃវែង ផ្តល់ អំណោយ ដល់ គ្រួសារ សព ក្មេងប្រុស ស្រី ៤នាក់ ដែល លង់ទឹក ស្លាប់ នៅ ស្រុក មេសាង
( ព្រៃវែង ) ៖ អភិបាល ខេត្ត ព្រៃវែង នា រសៀល ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២១ បាន ចាត់ ឲ្យ ក្រុមការងារ នាំ អំណោយ ជា ថវិកា និង សម្ភារ ទៅ ចូលរួម រំលែក ទុក្ខ ដល់ ក្រុមគ្រួសារ នៃ សព ក្មេងប្រុស ស្រី ៤នាក់ ដែល បាន លង់ទឹក ស្លាប់ នៅ ស្រុក មេសាង ។
បើ តាម លោក លាប សារិទ្ធ អធិការ នគរបាល ស្រុក មេសាង បាន ឲ្យដឹង ថា ក្មេងប្រុស ស្រី ទាំង ៤នាក់ ដែល លង់ទឹក ស្លាប់ នេះ ត្រូវ សមត្ថកិច្ច និង ក្រុមគ្រួសារ រកឃើញ សព កាលពី យប់ ថ្ងៃទី២ ខែមេសា ខណៈ ដែល ចេញ ទៅ រក ត្រី ហើយ មិន ឃើញ វិល ត្រលប់មក ផ្ទះ វិញ ។
លោក បាន បន្ត ថា នៅ មុនពេល កើត ហេតុ ក្មេង ៗ បាន ចេញ ទៅ រក ត្រី នៅ ចំណុច ព្រែក ឈូក រណ្តៅ ក្នុង ភូមិ យាង ធំ ឃុំ ជី ផុច ស្រុក មេសាង ហើយ មិន បាន វិលត្រឡប់មក ផ្ទះ វិញ ទេ ទើប ធ្វើឲ្យ ក្រុមគ្រួសារ មាន ការភ្ញាក់ផ្អើល និង ប្ដឹង សមត្ថកិច្ច ឲ្យ ជួយ តាម រក ក៏ បាន ប្រទះឃើញ សព លង់ទឹក ស្លាប់ ក្នុង ទឹក ជម្រៅ ជាង ៣ម៉ែត្រ យ៉ាង អាណោច អាធម ។
លោក អធិការ បាន អំពាវនាវ ដល់ អាណាព្យាបាល ទាំងអស់ ត្រូវ អប់រំ កូន ៗ កុំ ឱ្យ ទៅ លេង ទឹក ឬ រក ត្រី ក្នុង តំបន់ ដែល មាន ការ ជីក ដោយ អេស្កាវ៉ាទ័រ មាន ជម្រៅ ជ្រៅ ដែល នាំឱ្យ គ្រោះថ្នាក់ កើតឡើង ជា យថាហេតុ ៕ លោក ហ៊ុន ម៉ានី ចុះ ទៅ ទីតាំង ដំណើរការចាក់ វ៉ាក់សាំង កូវីដ១៩ ដើម្បី សួរសុខទុក្ខ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ស .ស .យ .ក . ដែល កំពុង បំពេញ បេសកកម្ម ចាក់ វ៉ាក សាំង
ក្នុង ដំណើរ សួរសុខទុក្ខ នេះ ដែរ លោក ហ៊ុន ម៉ានី បាន ធ្វើការ ថ្លែងអំណរគុណ ក្រុម គ្រូពេទ្យ ស័្ម គ្រចិត្ត ទាំងអស់ ចំពោះ ការខំប្រឹងប្រែង អស់ ពី កម្លាំង កាយ ចិត្ត ដើម្បី ធានា ដំណើរការចាក់ វ៉ាក់សាំង ជូន ដល់ ប្រជាពលរដ្ឋ អាច ប្រព្រឹត្តទៅ បាន ដោយ រលូន ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។
ទន្ទឹម នេះ លោក ក៏ បាន លើកទឹកចិត្ត និង ផ្តាំផ្ញើ ឲ្យ ក្រុម គ្រូពេទ្យ ទាំងអស់ មាន ការប្រុងប្រយ័ត្ន ជាប់ ជានិច្ច ក្នុង ការការពារ និង រក្សា សុខភាព ផ្ទាល់ខ្លួន ក្នុង អំឡុង ពេល បំពេញ ការងារ ដែល អាច ប្រឈម នឹង ហានិភ័យ មួយ នេះ ។
ជា ការកត់សម្គាល់ កន្លងមក ចំពោះ ការចូលរួម របស់ ស.ស .យ .ក . ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង យុទ្ធនាការ ប្រឆាំង ជំងឺ កូវីដ១៩ តាមរយៈ សារ បង្ហោះ លើ ទំព័រ ផ្លូវការ របស់ ស្ថាប័ន ខ្លួន ក៏ ដូចជា ទំព័រ ផ្លូវការ ផ្ទាល់ លោក ហ៊ុន ម៉ានី តែង បាន ជំរុញ លើកទឹកចិត្ត សមាជិក សមាជិកា របស់ ខ្លួន ក្នុង ការចូលរួម កិច្ចការងារ យុទ្ធនាការ ផ្សព្វផ្សាយ ពី គ្រោះថ្នាក់ នៃ ជំងឺ កូវីដ១៩ ដល់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ការចូលរួម សហការ ជាមួយ អាជ្ញាធរ ក្នុង ការបង្ការ និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ក្នុង មូលដ្ឋាន នីមួយ ៗ ។
ខាងក្រោម តារាង បញ្ជី បូកសរុប ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ របស់ លើក ទី១ និង លើក ទី២ របស់ ក្រសួង ការពារ ជា តិ៖ ថៃ ប្រកាស រកឃើញ ករណី ឆ្លង ថ្មី ៗ នៃ កូវីដ - ១៩ ចំនួន ៩៦ ករណី បន្ថែម ទៀត នៅក្នុង របាយការណ៍ ថ្ងៃអាទិត្យ នេះ
២១ ថ្ងៃ នៃ បេសកកម្ម គ្រូពេទ្យ គន្ធ បុប្ផា ដណ្តើមយក ជីវិត កុមារា ម្នាក់ ពី មច្ចុរាជ
( ភ្នំពេញ ) ៖ ក្មេង បុរស អាយុ ១៥ ឆ្នាំ ត្រូវបាន ដណ្តើម ចេញ ពី មច្ចុរាជ មកវិញ ដោយ ក្រុម គ្រូពេទ្យ នៃ មន្ទីរពេទ្យ គន្ធ បុប្ផា បន្ទាប់ពី រូប គេ រងរបួស ក្បាល ធ្ងន់ធ្ងរ ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ ។
យោង តាម ការផ្សាយ លើ ទំព័រ ហ្វេសប៊ុក របស់ ស្ថាបនិក មន្ទីរពេទ្យ គន្ធ បុប្ផា លោក វេជ្ជបណ្ឌិត ប៊ិត រិច នើ បាន បញ្ជាក់ ថា ក្មេងប្រុស រូប នេះ បាន ហើម ខួរក្បាល និង បែក ឈាម ក្នុង សួង ធ្ងន់ធ្ងរ បំផុត ។ រូប គេ ត្រូវបាន ឪពុក ម្តាយ យក ចេញ ពីមុខឡ ដុត នៅ ដង្ហើម ផ្តឹក ៗ មក សង្គ្រោះ នៅ មន្ទីរពេទ្យ គន្ធ បុប្ផា ។
ប្រភព បន្ត ថា ក្រុម គ្រូពេទ្យ បាន ប្រឹងប្រែង សង្គ្រោះ ជីវិត ក្មេងប្រុស រូប នេះ រយៈពេល ២១ ថ្ងៃ ដោយ រស់ ជាមួយ ការជំនួយ ពី ម៉ាស៊ីន សប់ ដង្ហើម រយៈពេល ៧ ថ្ងៃ ។ បើ តាម ប្រភព បាន បញ្ជាក់ ថា បច្ចុប្បន្ន ក្មេងប្រុស រូប នេះ មាន សុខភាព ល្អ ឡើងវិញ ហើយ ។
សូម បញ្ជាក់ ថា មន្ទីរពេទ្យ គន្ធ បុប្ផា គឺជា មន្ទីរពេទ្យ មនុស្សធម៌ ធំ មួយ នៅ កម្ពុជា ព្យាបាល ដោយ មិន គិត ថ្លៃ តាំងពី ឆ្នាំ ១៩៩៣ ។ បច្ចុប្បន្ន មន្ទីរពេទ្យ ទទួលបាន ការទ្រទ្រង ថវិកា មួយ ផ្នែក ធំ ពី មូលនិធិ ដែល បង្កើតឡើង ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ៕ លោកស្រី ឱ វណ្ណឌីន ប្រកាស ដាច់ អហង្ការ ហាម ក្រសួង ស្ថាប័ន មួយចំនួន ផ្តល់ វ៉ាក់សាំង កូវីដ១៩ ជូន អ្នក ដែល គ្មាន ឈ្មោះ ក្នុង បញ្ជី (Video inside)
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ( គ. វ .ក .១៩ ) ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២១ បាន ប្រកាស ដាច់ អហង្ការ ដោយ ហាម ក្រសួង ស្ថាប័ន មួយចំនួន បញ្ឈប់ ការផ្តល់ វ៉ាក់សាំង កូវីដ១៩ ជូន អ្នក ខាងក្រៅ ដែល គ្មាន ឈ្មោះ ក្នុង បញ្ជី អាទិភាព ជាបន្ទាន់ ។
ការប្រកាស របស់ លោកស្រី ឱ វណ្ឌ ឌីន បាន ធ្វើឡើង ក្រោយពី សង្កេតឃើញ ថា ក្រសួង មួយចំនួន បាន យក អ្នកដទៃ ដែល មិន មែន ជា មន្ត្រីរាជការ ស៉ី វិល ក្នុង ក្របខណ្ឌ ក្រសួង របស់ ខ្លួន មក ចាក់ វ៉ាក់សាំង កូវីដ១៩ ។ តាមរយៈ សារ សំឡេង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន លោកស្រី ឱ វណ្ណឌីន ថ្លែង ថា ការណ៍ ដែល ក្រសួង នាំ អ្នក ក្រៅ មក ចាក់ វ៉ាក់សាំង ក្នុង ក្រសួង យ៉ាង ដូច្នេះ នាំឲ្យ ខ្វះខាត វ៉ាក់សាំង តាម ការបែងចែក វ៉ាក់សាំង ដែល ត្រូវ រៀបចំ រួចហើយ នោះ ។
លោកស្រី បន្ត ថា « ប្រសិនបើ ក្រសួង នីមួយ ៗ ចេះតែ យក បុគ្គល ផ្សេង ដែល មិន មែន ជា មន្ត្រី ដែល មិន មែន ជា បុគ្គលិក របស់ ខ្លួន យកមក ចាក់ ធ្វើឲ្យ ចំនួន វ៉ាក់សាំង ដែល យើង គ្រោង ផ្តល់ឲ្យ មន្ត្រីរាជការ ស៉ី វិល ដែល ក្រោម ក្រសួង នីមួយ ៗ នេះ មិន មាន វ៉ាក់សាំង គ្រប់ ទេ ។ អញ្ចឹង ចាប់ពី ស្អែក ទៅ ខ្ញុំ សូម ដាក់ បញ្ជា យ៉ាង ដាច់ខាត តែម្តង ពីព្រោះ រឿង នេះ ជា រឿង ធំ ណាស់ មិន មែន ជា រឿង តូចតាច ទេ » ។
លោកស្រី ឱ វណ្ណឌីន បាន អំពាវនាវ ដល់ ប្រធាន អនុគណៈកម្មការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ នៅ តាម ក្រសួង ស្ថាប័ន មិន ត្រូវ បន្ថែម បុគ្គលិក ផ្សេង ទេ ហើយ ចាប់ពី ស្អែក ទៅ លោកស្រី សុំឲ្យ ក្រុមការងារ ចាក់ វ៉ាក់សាំង ចុះ ត្រួតពិនិត្យ ឲ្យបាន ហ្មត់ចត់ បំផុត និង ផ្ទៀងផ្ទាត់ ទៅ តាម បញ្ជី ដែល មាន ស្រាប់ ។ លោកស្រី ផ្តាំ ក្រុមការងារ ចាក់ វ៉ាក់សាំង ថា ប្រសិនបើ អ្នក ដែល មក ចាក់ មិន ស្ថិត នៅក្នុង បញ្ជី គឺ មិន អនុញ្ញាតឲ្យ ចាក់ ទេ ។
សូម ជម្រាប ថា យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ គណៈកម្មការ ចំពោះ កិច្ច បាន គូសបញ្ជាក់ ថា ក្រុម ជន ដែល ត្រូវ ចាក់ វ៉ាក់សាំង ស៉ី ណូវ៉ាក់ នេះ រួម មាន៖
( ភ្នំពេញ ) ៖ លោកជំទាវ ឧកញ៉ា ង៉ូវ ម៉ុច និង ឯកឧត្តម ឧកញ៉ា ង៉ូវ ស្រ៊ុន ឧបត្ថម្ភ ថវិកា ៥ម៉ឺន ដុល្លារ អាមេរិក ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២១ នេះ កាកបាទ ក្រហម កម្ពុជា ។
លោកជំទាវ ឧកញ៉ា កន្លងមក តែងតែ ចូលរួម ឧបត្ថម្ភ ថវិកា ជារៀងរាល់ ឆ្នាំ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ។ កន្លងមក នេះ លោកជំទាវ ឧកញ៉ា ក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
