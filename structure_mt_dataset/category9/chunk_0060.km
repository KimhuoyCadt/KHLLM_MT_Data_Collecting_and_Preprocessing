« ប្រសិនបើអ្នក រាល់គ្នាជាកូនរបស់លោក អ័ ប្រាហាំ អ្នកនឹងធ្វើដូចដែលលោកអប្រាហាំបានធ្វើ ប៉ុន្តែឥឡូវនេះ អ្នកចង់សម្លាប់ខ្ញុំ ជាបុរសម្នាក់ដែលបានប្រាប់ការ ពិតដែលខ្ញុំបានឮពីព្រះ នេះមិនមែនជាអ្វីដែល អ័ ប្រាហាំបានធ្វើនោះទេ ។
គាត់ បាន និយាយ ថា គាត់ មាន កិច្ចការ ជាច្រើន ដែល ត្រូវ ធ្វើ
ទោះបីជា យើង មិន អាច មើលឃើញ ព្រះដោយ មើលឃើញ ក៏ដោយ តាមរយៈ សេចក្តីជំនឿ និង តាមរយៈ ព្រះបន្ទូល របស់ ព្រះ យើង អាច ដឹង ថា ទ្រង់ ជា នរណា ។
វាកំពុងកើតឡើង កាន់ តែច្រើន ប៉ុន្តែវាមិនគ្រប់គ្រាន់ទេ » ។
ដូច្នេះបើតាមនាង ករណីនេះនឹងត្រូវបិទ ។
ពួកគេ បាន រកឃើញ ថា ប្រជាជន
មាន ឈ្មោះ សម្រាប់ អ្វី ដែល ខ្ញុំ កំពុង សិក្សា ។
អ្នកលែងត្រូវ កាន់កាតរាងកាយដើម្បីចូលបឹងទៀតហើយ ។
អ្នក នឹង អភិវឌ្ឍ ការប្រាស្រ័យទាក់ទង មិន មែន ពាក្យសំដី របស់ អ្នកដល់ ចំណុច
" ខ្ញុំ គ្រាន់តែ អាច រំលឹក អ្នក ប៉ុណ្ណោះ ។
ផ្ទះ ចិញ្ចឹម គឺជា ផ្ទះ ដូច យើង ដែរ ។
ពេលមានរឿងខុសប្រក្រតី ចូរសួរពួកគេថា “ តើអ្នកកំពុងប្រើ កម្លាំងខ្យល់ និងជំនោរក្នុងជីវិតដោយរបៀបណា ?
29 គាត់កំពុង តែនិយាយជជែកគ្នាជាមួយនឹងជន ជាតិយូដាដែលនិយាយភាសាក្រិច ប៉ុន្តែគេព្យាយាមសម្លាប់គាត់ ។
ហើយ អាច ជ្រៀត ចូល យ៉ាង ជ្រៅ ទៅក្នុង អត្មា របស់ ពួកគេ ។
មិន អនុញ្ញាតឱ្យ ពួកគេ ចូល ។
អ្នកជិតខាង បាន នាំ ពួកគេ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
ទាប ណាស់ រហូតដល់ ចុង ខែកញ្ញា ប៉ុន្តែ មាន ទំហំ ធំ
“ ប្រជាជន រីករាយណាស់ដែលបានឃើញគាត់ ។
ការ ថតរូបត្រូវបានធ្វើឡើងមុនពេលនាងម៉ាថាស្លាប់ ។
យើងនឹងស្លាប់ យើងទាំងអស់គ្នានឹងស្លាប់ ?
លោកចោទថា ប៉ូលិស និងមន្ត្រីរដ្ឋាភិបាលតែងជាប់ពាក់ព័ន្ធនឹងការ ដឹក ជញ្ជូនឈើខុសច្បាប់ ។
ដូច្នេះ វាជារឿងមិនសមហេតុផលដែលនិយាយថា ខ្ញុំប្រឆាំងនឹងប្រធានាធិបតី » ។
បន្ទាប់មក អ្នកនឹងត្រូវប្រមូលគ្នាទៅជាមួយប្រជារាស្ត្ររបស់អ្នក » ។ ៣ លោកម៉ូសេ និយាយទៅ កាន់ប្រជាជន ថា៖ « សូមលើកទ័ពរបស់អ្នកខ្លះទៅច្បាំងនឹងជន ជាតិម៉ាឌាន ដើម្បីធ្វើការ សងសឹករបស់ព្រះអម្ចាស់ មកលើពួកគេ » ។
កុំញ៉ាំអាហារដែលត្រជាក់ហើយឬឡើងកំដៅវិញ។
ប្រពន្ធត្រូវចាប់បាន ចំណែកម្នាក់ទៀត រត់គេចខ្លួនបាត់ ។
អ្នក ទាំងពីរច្រៀងដោយបង្ហាញថាពួកគេទាំងពីរជាប្រុស ។
ជាង សារព័ត៌មាន ស៊ុយអែត បាន កត់សម្គាល់ ។
ស្នេហាមិនអាចរាប់បានទេ ?
៤៩ អស់អ្នកដែលស្គាល់លោកយេស៊ូ និងស្ត្រីដែលដើរតាមលោកពីស្រុកកាលីឡេ ឈរមើលការ ទាំងនេះពីចម្ងាយ ។
ដ្បិតខ្ញុំត្រូវបានគេឆ្កាងជាមួយនឹងព្រះ គ្រីស្ទ ។
ព្រះ បានទប់ទល់យ៉ាងខ្លាំង ។
វា ពិបាក ណាស់ ក្នុង ការស្វែងរក នរណា ម្នាក់ ។
ពិសេសនៅថ្ងៃ អាទិត្យ ខ្ញុំក្រោកពីម៉ោង ៩ ។
ព្រះអម្ចាស់បានឮសំឡេងរបស់ជន ជាតិអ៊ីស្រាអែល ហើយបានប្រគល់ជន ជាតិកាណានទៅ ។
នៅ ពេល ដែល ផែនដី ផ្លាស់ប្តូរ វា បាន បោះ គន្លង ទៅ អាកាស ។
ខ្ញុំមិនគួរនិយាយរឿងបែបនេះទេ បើវាធ្វើឱ្យអ្នកមិនស្រួល ។
នឹង ត្រូវបាន បង្កឡើង ដោយ ការជូនដំណឹង ។
បើមានអ្វីក៏នាំគាត់ចេញពីអារម្មណ៍ ។
អ្នក នឹង ឃើញ ភាពខុសគ្នា ក្នុង រយៈពេល 7 ថ្ងៃ ។
នេះ ហើយ លុយ កញ្ញា
« យើងចង់មានទំនាក់ ទំនងជាមួយគ្រប់តំបន់ ។
ពួកគេចង់ឲ្យខ្ញុំចូលផ្នែក ពេទ្យដូចបងប្រុសខ្ញុំ » ។
ការលើកទឹកចិត្ត ទាំងនេះ មិន ចាំបាច់ មាន ជម្លោះ ជាមួយនឹង គោលដៅ ខ្ពស់ បំផុត របស់ ខ្ញុំ ទេ ។
ប៉ុន្តែ តើ វា ពិបាក ណាស់ ក្នុង ការចងចាំ ពាក្យ សម្ងាត់ សម្រាប់ គណនី ទាំងអស់ មែន ទេ ?
ស្ថាន សួគ៌នឹងមិនត្រូវបានប្រគល់ទៅឱ្យអ្នក និយាយច្រើនបំផុត។
ខ្ញុំ ត្រូវតែ និយាយ ថា ខ្ញុំ ពិតជា ដឹង គុណ សម្រាប់ ថ្ងៃ នេះ ។
ថា អ្នក នឹង ត្រូវបាន យក ដោយ គ្មាន ការយល់ដឹង ។
មាន មហាក្សត្រី ថ្មី នៅក្នុង ក្រុង អ្នក ទាំងអស់ គ្នា !
5 គេមិនមានបញ្ហាដូចមនុស្ស ឯទៀតទេ ហើយក៏មិនរងគ្រោះដូចមនុស្សដែរ …
ទី មួយ រត់ក្នុងល្បឿន ១៦ គីឡូម៉ែត្រក្នុងមួយម៉ោង ខណៈពេលក្រោយអាចឡើងដល់ ២២ គីឡូម៉ែត្រក្នុងមួយម៉ោង ។
កុំឲ្យអ្នក ណាដែលពេញ ចិត្តនឹងការ បន្ទាបខ្លួន និងការ ថ្វាយ បង្គំទេវតាធ្វើឲ្យអ្នកបាត់បង់សិទ្ធិឡើយ ។
ផ្នែក ទន់ ជាង របស់ ប៊ីល ។
នៅ ពេល ដែល ខ្ញុំ ក្លាយជា បុរស ហើយ បាន ជួប ពិភពលោក ។
ហ្វូងមនុស្សទាំងអស់ភ្ញាក់ផ្អើល ហើយនិយាយថា
គាត់នឹងក្រីក្រ សូម្បីតែបន្សល់ទុកនូវ ភាពស្រស់ត្រកាលក្នុងសម្លៀក បំពាក់ដែលសើមរបស់នាង ។
ខ្ញុំមិនបានទទួលប្រាក់ឈ្នួលសម្រាប់ការងារដែលខ្ញុំធ្វើអស់រយៈពេល ២ ឆ្នាំ មកហើយ ។
ខ្ញុំ ខ្លាច ស្លាប់ ព្រោះ ដឹង ថា ឪពុក ខ្ញុំ និយាយ ត្រូវ ។
នាង ចាប់ផ្តើម ជាមួយនឹង អ្វី ដែល ខ្ញុំ មាន ។
ម្យ៉ាងទៀត តើយើងគួរទុក ចិត្តអ្នក ណា ?
ឆ្ពោះ ទៅរក តម្រូវការ ជ្រើសរើស ។
ហើយ មិន ត្រូវបាន អនុញ្ញាត ។
តើអ្នកដឹងទេថាតើព្រះអាទិត្យនិងខ្យល់ដំណើរការ យ៉ាង ណាសម្រាប់ពួកគេ ?
អ្នកបើកបរ ជា ជនជាតិ ក្រូអាត ។
ក្រោយពីប្រមូលផ្តុំគ្នារួច គេក៏បញ្ជូនអ្នកយាមទៅគុក ដើម្បី នាំពួកសាវ័ក មក ។
កុំ បដិសេធ ត្រគាក ជង្គង់ ឬ ស្មា ។
យេហ៊ីអែល និងស៊ីម៉ាយ ជាកូនរបស់ហេម៉ាន សេម៉ាយ៉ា និងអ៊ូស៊ាល ជាកូនរបស់លោកយេ ឌូថុន ។
គ្មាន ការពន្យារ ពេល មួយ សប្តាហ៍ ទៀត ទេ ។
ផ្ទុយទៅវិញ មកពី ខ្ញុំ យល់ ថា
លោកបានបង្គាប់ពួកគេ ថា៖ « ក្រោយមកប្រាំពីរឆ្នាំ គឺក្នុងឆ្នាំដែលបានរួចពី បាប គឺនៅក្នុងពិធីបុណ្យពន្លា ។
ខ្ញុំពិតជាជឿថាមាននិស្សិតមហាវិទ្យាល័យច្រើនណាស់ ។
