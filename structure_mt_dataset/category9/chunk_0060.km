32 ដូច្នេះ ចូរបំពេញអ្នក រាល់គ្នាទៅតាមខ្នាតនៃបុព្វបុរសរបស់អ្នក ។
ការអភ័យទោស ពី អំពើ បាប ដែល គ្មាន មនុស្ស ណា ម្នាក់ ទុក តែ អារក្ស អាច សម្រេចបាន នូវ សេចក្តីសុខ ។
ម្ដាយរបស់នាងបាននិយាយថា៖ « ខ្ញុំមានអារម្មណ៍ឈឺ និងខឹង ។
ពីព្រោះ ព្រះជា ចៅក្រម ។
អ្នក ណាដែលស្រឡាញ់សេចក្ដី ពិត ពួកគេចូល មកក្នុងពន្លឺ ។
ព្រះអម្ចាស់ យ៉ាងហោចណាស់ ជា អ្នកជំនួស ព្រះអង្គ ឬ ?
អ្នកដែលបានបែក ពីគ្នាទៅវិញទៅមក ។
មនុស្សប្រុសនឹងលែងបង្រៀនអ្នកជិតខាង ឬបងប្អូនរបស់ខ្លួនដោយពោលថា “ ស្គាល់ព្រះ‌ អម្ចាស់ ” ប៉ុន្តែគេនឹងស្គាល់ខ្ញុំទាំងអស់គ្នា ចាប់តាំងពីពួកគេតិចជាងគេរហូតដល់ធំជាងគេ ។
ហើយដាក់ក្នុងបំពង់ ពួកវានឹងមានអាយុច្រើនឆ្នាំ ។
បើ អ្នក ជា ព្រះគ្រីស្ទ សង្គ្រោះ ខ្លួនអ្នក និង យើង !
ប៉ុន្តែពួកគេទាំងអស់នឹងបានដឹង ព្រោះវានឹងបំបាត់ការសង្ស័យទាំងអស់ ។
ពួកគេ គ្មាន សមត្ថភាព ស្នេហា
ខ្ញុំ នឹង ជួប អ្នក នៅ ទីនោះ ក្នុង រយៈពេល ប្រាំ ម៉ោង ។
ដែល ធ្វើឱ្យ ពួកគេ មាន ស្ថេរភាព ខ្លាំង ដូច ដែល បាន ឃើញ ដោយ ចំណុច រំពុះ ខ្ពស់ របស់ ពួកគេ ។
នៅថ្ងៃរៀបការ គូស្វាមីភរិយាប្តូរកម្រងផ្កាជាកាយវិការ ទទួល យកគ្នាទៅវិញទៅមក
ចំណែក របស់ សត្វ តោ គឺជា ចំណែក ធំ បំផុត ។
គាត់ បាន និយាយ ថា “ អ្នក ជួប ជាមួយ មនុស្ស រាប់ សិប នាក់ ជារៀងរាល់ សប្តាហ៍ ។
គាត់គ្រាន់ តែប្រាប់ខ្ញុំអំពីរឿងនេះ » ។
ហើយពួកគេនឹងត្រូវដាក់ក្រោមការសង្ស័យយ៉ាងខ្លាំង » ។
ឥតចលនាដូចអ្នកដែលឃើញ តែមិនយល់ ។
កូនតូចរបស់ខ្ញុំ សូមរក្សាខ្លួនអ្នក ពីរូបព្រះ។
គាត់ បាន ដឹង ថា ទ្រង់ ត្រូវបាន ផ្តល់ សិទ្ធិ អំណាច លើ អ្វី ៗ ទាំងអស់ ថា ទ្រង់ បាន មកពី ព្រះ ហើយ នឹង ត្រឡប់ ទៅ រក ព្រះវិញ ។
ពួកគេសុខ ចិត្តទុក ចិត្តលោក ហើយមិនមានបញ្ហាអ្វីឡើយ ។
ព្រះអម្ចាស់បានធ្វើតាមសេចក្ដីសន្យារបស់ទ្រង់ ដែលទ្រង់បានធ្វើចំពោះ អ័ ប្រាហាំប្រហែលបួន រយឆ្នាំមុននេះ ។
ដូច្នេះ នាងដែលស្បថនឹងអាសនៈ នោះក៏ស្បថនឹងអាសនៈ និងអ្វី ៗទាំងអស់នៅលើអាសនៈដែរ ។
បន្ទាប់ពីអ្នកធ្វើហើយអ្នកចង់បង្កើតផ្ទៃពីវា ?
ដូច្នេះ ចូរ វិនិច្ឆ័យអំពីសារៈសំខាន់ដែលទាក់ទងនឹងការ រក្សាទម្រង់នៃ ការ ថ្វាយបង្គំរបស់ពួកគេ
អ្នក កាន់ សាសនា ជឿ ថា គាត់ បាន រកឃើញ ព្រះ។
ប៉ុន្តែ ខ្ញុំ នឹង ស្នាក់ នៅ ក្រុង អេភេសូរ រហូតដល់ ថ្ងៃ បុណ្យ ទី ៥០ ។
ពួកគេដោយព្រះ‌ អម្ចាស់ ពេលចូលទៅក្នុងស្រុក សន្យា ។
អ្នក រាល់គ្នា នៅលើ ផែនដី ។
ចុះចូលចំពោះអ្នកទាំងនេះ និងអ្នក រាល់គ្នាដែលចូលរួមក្នុងការងារ ហើយធ្វើការ នៅក្នុងការងារនោះ ។
ពេលនាងចូលរួមជាមួយយើង នាងបានលាន់មាត់ថា “ ខ្ញុំមិនដែលឃើញឆ្កែរត់លឿនបែបនេះទេ ។
ពួកគេ កុហក ផ្លូវ របស់ ពួកគេ ចេញ ពី គ្រប់ ស្ថានភាព ។
គ្មានលេសអ្វីទេ អ្នកគ្មានបេះដូង
២ បានឃើញអ្នក កាន់តាមលោកខ្លះបរិភោគដោយដៃដែល « មិនស្អាត » ពោលគឺមិនបានលាងសម្អាត ។
ដូចគ្នាដែរ ខ្ញុំសុំប្រាប់អ្នក រាល់គ្នាថា នៅចំពោះមុខពួកទេវតានៃព្រះ មាន អំណរចំពោះមនុស្ស បាបម្នាក់ដែល ប្រែ ចិត្ត » ។
ដើម្បីយកសត្វដែលព្រះបង្កើត មកពី ភាពសាហាវព្រៃផ្សៃរបស់វាមក វិញ » ។
ពួកគេនឹងឆ្លងផុតពីជីវិតនេះទៅក្នុង ភាពងងឹត ដែលពួកគេនឹងមិនវិល មកវិញឡើយ ។
ដោយ គ្មាន ប្រភេទ និង តួនាទី មួយចំនួន នៅក្នុង ភាពតានតឹង សម្រាប់ ពួកគេ ។
កុំ បោះខ្លួនទៅកន្លែងអង្គុយ ហើយនិយាយថា « នេះនឹងជាសេចក្ដី អធិប្បាយសម្រាប់ពួកបរិសុទ្ធ ដូច្នេះ យើងអាចនឹងរួចខ្លួនពីការ ស្ដាប់វា » ។
កុំ មាន ចិត្ត ជាថ្មី ដើម្បី ធ្វើ អ្វី ផ្សេង ក្រៅពី អំពើ អាក្រក់ ។
តើ អ្នក ចាប់អារម្មណ៍ នឹង ការសិក្សា វេជ្ជសាស្ត្រ នៅ អ៊ុយក្រែន ទេ ?
មានសេចក្តី រាយការណ៍ថា មិត្តប្រុសរបស់ Lau ត្រូវបានគេរាយការណ៍ថាកំពុងស្ថិតក្នុងស្ថានភាពមានស្ថិរភាពនៅពេលនេះ ។
៤ ប៉ុន្តែពេលដែលព្រះ យេស៊ូវបានឮដូច្នេះ ទ្រង់មាន បន្ទូលថា៖ « ជំងឺនេះមិនត្រូវ បញ្ចប់ដោយសេចក្ដី ស្លាប់ទេ ប៉ុន្តែសម្រាប់សិរីល្អនៃព្រះ ដើម្បីឲ្យព្រះ រាជ បុត្រានៃព្រះ បានដំកើងដោយ សារវា » ។
តើអ្នកមិនបានអាននូវអ្វីដែលស្តេចដាវីឌ បានធ្វើពេលគាត់និងគូកនរបស់គាត់ឃ្លានទេឬ ?
ដែល នឹង ល្អ សម្រាប់ អ្នក ។
50 ខ្ញុំ មិន ស្វែងរក សិរី រុងរឿង សម្រាប់ ខ្លួនខ្ញុំ ទេ ។ ប៉ុន្តែមានម្នាក់ដែលស្វែង រកវា ហើយគាត់ជាចៅក្រម ។
ទោះ ជាយ៉ាង ណា គាត់បាននិយាយថា « ខ្ញុំនឹងត្រឡប់ទៅស្រុក កំណើតវិញ ព្រោះគ្មានកន្លែង ណាល្អជាងនេះទេ » ។
ហើយ ពួកគេ នឹង រីករាយ នឹង ការសិក្សា របស់ ពួកគេ ។
« គាត់នឹង បង្វែរកូនចៅអ៊ីស្រាអែលជាច្រើនមក ឯព្រះអម្ចាស់ ជាព្រះ របស់ពួកគេ ។
ជីវិតដោយអ្នកអង្វរថា កាលដែលអង្វរនោះ
នៅជិត កំពូល នៃ សិប្បកម្ម របស់ ពួកគេ ។
យើង មិន មាន ទូរទឹកកក ទេ ឥឡូវនេះ ។
ទ្រង់នឹងធ្វើសេចក្តី សុចរិតរបស់អ្នក ជាពន្លឺ ។
គាត់បានថតរឿងនេះទុកជាមុន ដូច្នេះគាត់បានជូនដំណឹងដល់គាត់នៅពេលដែលគ្រោងនឹងចាក់ផ្សាយ ។
កុំ ធ្វើ បែប នេះ សម្រាប់ ថ្ងៃ បុណ្យ នៃ ក្តីស្រឡាញ់ ។
កូនស្រីរបស់ផារ៉ោនបានយកគាត់មកចិញ្ចឹមជាកូនរបស់គាត់ » ។
ថ្ងៃ ណាមួយ អ្នក នឹង ធ្វើការ ឱ្យ ពួកគេ ។
គាត់នឹងដឹងថាអ្នកនោះមកពី ណា » ។
ដូច្នេះ ប្រសិនបើ អ្នក មិន ដែល ឃើញ ភ្នែក របស់ ទេវតា ទេ
គេចូលមកដោយស្ទាក់ស្ទើរក្រោយពេលព័ត៌មានពេលព័ត៌មានកំពុងជាប់ ។
ហើយ នៅតែ រក្សា តាម របៀប ដដែល ដូច អ្នក ថ្វាយបង្គំ អារក្ស ។
(6) ដែល ទោះជា ទ្រង់ មាន នៅក្នុង ទម្រង់ នៃ ព្រះក៏ដោយ ទ្រង់ មិន បាន ចាត់ទុក ភាពស្មើគ្នា ជាមួយនឹង ព្រះជា រឿង ដែល ត្រូវ ចាប់ ឡើយ
ហើយ មួយ ថ្ងៃ ក្រោយមក គាត់ បាន ក្លាយជា បណ្ឌិត នៃ ទេវៈ ។
កុំខ្លាចអី យើងនឹងឈ្នះ !» ។
ចូរប្រាប់យើងខ្ញុំដោយអំណាចអ្វីដែលអ្នកកំពុងធ្វើការ ទាំងនេះ » និយាយ ។
ដៃរបស់គេត្រូវបានតោងពីក្រោយដូចជាខ្នោះដៃ ។
គួរមានការ ចែករំលែកជីវិត ការ ឱបគ្នា ការ ចេះដឹងពិតពីគ្នាទៅវិញទៅមកដូចមនុស្ស ។
« ដូច្នេះ ចូរអ្នកនិងប្រជាជនអ៊ីស្រាអែលទាំងអស់ដឹងថា វាគឺដោយព្រះនាមនៃព្រះ យេស៊ូគ្រិស្ដជាអ្នកស្រុក ណា សា រ៉ែត ដែលអ្នកបានឆ្កាង ប៉ុន្តែ ជាអ្នកដែលព្រះ បានប្រោសឲ្យ រស់ឡើងវិញថា បុរសនេះឈរនៅមុខអ្នក រាល់គ្នាបានជា » ។
ពួកគេនិយាយថា “ ទឹកនេះជាប្រភពនៃជីវិត វាបានក្លាយទៅជាវិនាស ” ។
សួរ ពួកគេ ពី កន្លែង ដែល ពួកគេ ធ្វើការ ឬ អ្វី ដែល ពួកគេ ចូលចិត្ត ធ្វើ នៅពេល ទំនេរ របស់ ពួកគេ ។
នេះជាការ ដាក់ទណ្ឌកម្មសម្រាប់គាត់ដែល រត់ចេញជាមួយអ្នក បម្រើស្បែក សពីរនាក់ផ្សេងទៀត ។
ការអធិស្ឋាន ចំនួន ម្ភៃ ហើយ ចុងក្រោយ នោះ គឺជា ការអធិស្ឋាន មួយ រយ ។
ដូច្នេះ សមាជ ទូរស័ព្ទ ពិភពលោក ជិត មកដល់ ហើយ ។
ភាគ ខាងលិច គឺជា ទឹកដី នៃ សត្វ ព្រៃ ។
« តើទ្រង់មិនមែនជាព្រះ នៃយើងខ្ញុំទេ ដែលបានបណ្ដេញអ្នកស្រុកចេញពីមុខអ៊ីស្រា ‌ អែល ជាប្រជារាស្ត្ររបស់ទ្រង់ ហើយបានប្រគល់វាដល់កូនចៅរបស់ អ័ ប្រាហាំ ជាមិត្តរបស់ទ្រង់ជារៀងរហូតឬ ?
បំភ្លេច លទ្ធភាព ដែល ថា នាង នឹង ក្លាយជា ជនជាតិ ចិន ។
គាត់នឹងបំប្លែងកូនចៅអ៊ីស្រា ‌ អែលជាច្រើនឲ្យទៅជាព្រះ‌ អម្ចាស់ ជាព្រះ របស់ពួកគេ ។
ស្រលាញ់ គ្នា អស់ ពី បេះដូង ។
ឈប់ខ្វល់ខ្វាយទៅ ហើយអ្នក នឿយណាយក៏បានសម្រាកចុះ » ។
នាំឱ្យ ពួកគេ សង្ស័យ អំណាច របស់ វា ហើយ ដោយ ហេតុ នេះ ពួក បរិសុទ្ធ ដែល វា មាន ប្រភព ដើម ។
មនុស្ស គឺ ធំ ជាង អ្វី ៗ ផ្សេង ទៀត នៃ ការបង្កើត ពីព្រោះ ព្រះបាន ប្រទាន ថាមពល ដល់ គាត់ ។
ដូច្នេះ ក្រោយពីបាន តមអាហារ និងអធិស្ឋានរួច គេក៏ដាក់ដៃលើគេ ហើយចាត់គេចេញ » ។
ចូរសរសើរអ្នក ហើយស្តាប់បង្គាប់អ្នក ដូចជាអ្នក បម្រើដ៏រាបទាប ។
លោកបានសម្រេច ចិត្តប្រកប របរជាគ្រួសារធំមួយ ដែលជា លទ្ធផលលោកមានកូន ៩ នាក់ ( ប្រុស ៨ ស្រី ១) ។
ទាសករអើយ ចូរចុះចូលចំពោះម្ចាស់ដោយសេចក្ដី គោរព មិនត្រឹម តែចំពោះអ្នកដែលមាន ចិត្តល្អប៉ុណ្ណោះទេ តែក៏ចំពោះអ្នកដែលឃោរឃៅដែរ ។
នៅក្នុងអ្នក ហើយអ្នកមិនទទួល យកវាទេ នោះអ្នកនៅ តែជាអ្នកដើរតាមប្រពៃណី ។
ព្រះវិញ្ញាណនិងកូនក្រមុំពោលថា៖ «មក ហើយឲ្យអ្នកដែល ឮពោលថា ‹ មក ›» ។
២ យើងម្នាក់ ៗត្រូវផ្គាប់ ចិត្តអ្នកជិតខាងរបស់ខ្លួនដើម្បីប្រយោជន៍របស់ខ្លួន ដើម្បីកសាងខ្លួនឡើង ។
តើ អ្នក និយាយ ពាក្យ ហែម យ៉ាងដូចម្តេច ?
ខ្ញុំនឹងធ្វើឲ្យគេដួលនៅជើងអ្នក ហើយទទួលស្គាល់ថាខ្ញុំបានស្រឡាញ់អ្នក ។
យើងមិនខ្លាចធ្វើជាអ្នកពូកែទេ !» ។
នាង ត្រូវតែ ពិបាក ក្នុង ការគិត ឈ្មោះ ថ្មី ។
សេចក្ដី ក្រោធរបស់ព្រះ នៃយើងគឺ មកលើមនុស្សមាន បាប ។
នឹង ត្រូវ បំផ្លាញ ដោយ ទឹក ។
ហើយ ប្រាកដ ណាស់ ការស្លាប់ គឺ ជៀស មិន រួច ។
ដោយឈឺ ចិត្ត យ៉ាកុបបានទទួលឯក សិទ្ធិក្នុងការ និមិត្តរបស់ព្រះ។
កុំបោះ បង់ ការ នេះទេ ស្ថាន សួគ៌ហាមមិនឲ្យយើងបាត់ បង់ការ ជួបគ្នាប្រាំបីខែ ដូចដែលបានកើតឡើង កាលពីមុនឡើយ » ។
ដល់ ប្រជាជាតិ ដែល ល្ងង់ខ្លៅ ។
ការបោះឆ្នោត របស់ ខ្ញុំ គឺ សម្រាប់ សូម ថែរក្សា ទូរទឹកកក របស់ ខ្ញុំ ។
ទ្រង់ជាស្តេចដ៏រុងរឿង ។
បើប្រជាជាតិមួយមិនចុះចូលទេ ជាតិនោះអយុត្តិធម៌ ។
ហើយផ្តល់ឲ្យយើងនូវ ភាព ក្លាហានដើម្បីឈរយ៉ាងរឹងមាំ និង ក្លាហានដើម្បីនិយាយការពិតរបស់អ្នក » ។
រ៉ូម 8:28 - ហើយយើងដឹងថាអ្វី ៗទាំងអស់ធ្វើការ រួមគ្នាដើម្បីសេចក្ដី ល្អចំពោះអ្នកដែលស្រឡាញ់ព្រះ ដល់អ្នកដែលត្រូវបានហៅតាមគោលបំណង ។
អ្នក ណាដែលគេចាប់បាន ( ក្នុងអំពើ ) គួរ តែត្រូវគេបាញ់សម្លាប់ ។
ពិតណាស់ ព្រះ បានប្រទានអ្វីគ្រប់យ៉ាងដល់យើង ។
ដូច្នេះ កូនចៅរបស់អ្នកនឹងក្លាយជាស្ដេចស្រុកអ៊ីស្រាអែលរហូតដល់ជំនាន់ទីបួន » ។
ខ្ញុំបានឮសំឡេងមួយដែលខ្ញុំមិនដឹង ។
ហើយនរណាជាអ្នកដែលបានឃើញវា ?
ពួកគេនិយាយពាក្យដដែល ថា៖ « លោកម្ចាស់ បើលោកនៅ ទីនេះ ប្អូនប្រុសខ្ញុំមិនស្លាប់ទេ » ។
ចូរធ្វើចំពោះពួកគេ ដូច សាសន៍ម៉ាឌាន ។
ខ្ញុំ គិត ថា ខ្ញុំ គួរតែ ចាប់ផ្តើម សិក្សា ។
ដូច្នេះ គេនឹងមិនត្រៀមខ្លួនសម្រាប់ពេលដែលព្រះមហាក្សត្រយាងមកវិញទេ ។
« ហើយខ្ញុំមានទំនុក ចិត្តលើព្រះអម្ចាស់ថា ខ្ញុំនឹង មកក្នុងពេលឆាប់ ៗនេះ ។
ចំណែក ឯយើងបានទិញពន្លកដើម្បី ភាព ងាយស្រួល ។
យើង បាន ឃើញ នូវ អ្វី ដែល ពួកគេ បាន ធ្វើ ហើយ ខ្ញុំ គិត ថា យើង ត្រូវតែ ត្រៀមខ្លួន សម្រាប់ អ្វី ដែល អាចនឹង កើតឡើង នា ពេល អនាគត ។
ច្បាស់ ណាស់ ថា បាន យក ពី អ្នក ដែល មាន កម្មសិទ្ធិ ដោយ គ្មាន ការយល់ព្រម ពី ពួកគេ ។
ហើយគេនឹងស្គាល់ទី បន្ទាល់របស់អ្នក ។
នៅ ពេល ដែល ផ្សិត ដំបូក ច្រើន ស្ថានភាព នេះ កើតឡើង ។
ខ្ញុំ បាន ប្រាប់ អ្នក ពីមុន ថា ក្រដាស នេះ ពិតជា សំខាន់ សម្រាប់ ខ្ញុំ ។
ដូច្នេះ ចូរអ្នក រាល់គ្នាសូមព្រះ‌ អម្ចាស់នៃច្រូតកាត់ចាត់អ្នកធ្វើការ ទៅក្នុងស្រែរបស់ព្រះអង្គចុះ » ។
ហើយយើងក៏ត្រូវទទួលខុសត្រូវចំពោះអ្នក កាន់អំណាច ។
ស្ត្រី ដែល មិន មាន បងប្អូន ចូរ ថ្វាយបង្គំ ព្រះច័ន្ទ ជំនួស វិញ ។
៦ ប៉ុន្តែខ្ញុំនិយាយថានេះជា សម្បទាន មិនមែនជា បញ្ញត្តិទេ ។
ហើយពួកគេបានអង្វរទ្រង់ម្តងហើយម្តងទៀតកុំឲ្យបង្គាប់ពួកគេឲ្យចូលទៅក្នុងអវិចីនោះឡើយ ។
ហើយអ័ដាមមិនត្រូវបានគេបោកបញ្ឆោតទេ ប៉ុន្តែស្ត្រីនោះត្រូវបានគេបោកបញ្ឆោត ហើយបានក្លាយទៅជាអ្នក រំលង ។
ហើយអ័ដាមមិនត្រូវបានគេបោកបញ្ឆោតទេ ប៉ុន្តែស្ត្រីនោះត្រូវបានគេបញ្ឆោត ហើយបានក្លាយទៅជាអ្នកបំពាន ។
ប៉ុន្តែ សូម បងប្អូន ក្រោក ឈរ ឡើង ។
បុគ្គលដែលចាប់បានម្តង ៗ ។
ហើយថាមេខ្លោងដែលនៅពីក្រោយអំពើអាក្រក់នេះនឹងត្រូវចាប់បាន ។
ពួកគេត្រូវតែប្រឹងអស់ពីសមត្ថភាព ហើយរង់ចាំថ្ងៃជំនុំ ជម្រះ ។
361 ដើម្បី ធ្វើ ការសម្រេចចិត្ត ត្រឹមត្រូវ ។
ទាំង នេះ គឺជា វិធី សុវត្ថិភាព ហើយ យើង នឹង បង្ហាញ វា ដល់ អ្នក ។
ម្យ៉ាងទៀត សូម ចងចាំ ហើយ អធិស្ឋាន សម្រាប់ អ្នក ដែល គ្មាន នរណា អធិស្ឋាន សម្រាប់ ពួកគេ និង អ្នក ដែល បាន សុំ ការអធិស្ឋាន របស់ យើង ។
ភេស្ទុសឆ្លើយ ថា៖ ‹ ប៉ូលត្រូវឃុំខ្លួននៅសេសារា ហើយខ្ញុំផ្ទាល់នឹងទៅទីនោះឆាប់ ៗ ។
ហើយពេលគាត់ទទួលបានឱកាស គាត់បានធ្វើឲ្យអ្នកដែលចូល ចិត្តគាត់បាន រលាយ អស់ ។
ហើយហេតុអ្វីបានជា អនុញ្ញាតឲ្យខ្ញុំថា ម្តាយរបស់លោកម្ចាស់ មករកខ្ញុំ ?
ប្រសិនបើ អ្នក នៅ ក្មេង ហើយ ចង់ អរគុណ ម្តាយ របស់ អ្នក ។
« កុំប្រាប់នរណាម្នាក់នូវអ្វីដែលអ្នកបានឃើញឡើយ រហូតដល់កូនមនុស្សបានរស់ឡើង វិញ » ។
ការ មិន រង់ចាំ ព្រះបង្ហាញ ពី ការខ្វះ ជំនឿ លើ ផែនការ របស់ ព្រះ។
ដូច្នេះ ក្នុង រយៈពេល ពីរ សប្តាហ៍ ខ្ញុំ នឹង នៅ ទីនេះ ឬ អត់ ។
ពួកគេបាន បង្វែរការ ផ្ដោតទៅលើការ យកដំណឹងល្អទៅ កាន់ សាសន៍ ដទៃ
ហើយពេលស្លាប់ទៅក៏ ប្រែក្លាយទៅជាដើមឈើធំ ៗពីរដែលមានជីវិត ។
សាក្សីម្នាក់បាននិយាយថា៖ « វាបានផ្ទុះឡើង។
១៤] ហើយ អ័ដាម មិន មែន ជា អ្នក ដែល ត្រូវបាន បញ្ឆោត ទេ ។ វាជាស្ត្រីដែលត្រូវបានគេបញ្ឆោត ហើយក្លាយជាមនុស្សមាន បាប ។
និង ចែកជូន អ្នក ដែល មាន សិទ្ធិ ទទួលបាន ។
៣៤ ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « ខ្ញុំប្រាប់អ្នក រាល់គ្នាជាប្រាកដថា អ្នក ណាដែលប្រព្រឹត្តអំពើ បាប សុទ្ធតែជាខ្ញុំបម្រើរបស់អំពើ បាប ។
មហា បូជាចារ្យ គ្រប់ រូប ត្រូវបាន ជ្រើសរើស ពី ក្នុង ចំណោម បុរស ហើយ ត្រូវបាន តែងតាំង ឱ្យ ធ្វើជា តំណាង ពួកគេ នៅក្នុង បញ្ហា ទាក់ទង នឹង ព្រះ ដើម្បី ថ្វាយ អំណោយ និង ការបូជា សម្រាប់ អំពើ បាប ។
ដោយខ្លាចនាងនិងកូនត្រូវធ្វើជាទាសករ នាងកុហកគ្រូពេទ្យ ។
ពួកគេ មាន ពេលវេលា ដ៏ គួរឱ្យ ស្រឡាញ់ ជាមួយគ្នា ។
នៅពេល ថ្ងៃ មាន ភាព កក់ក្តៅ និង កក់ក្ដៅ ។
បើឯងធ្វើ បាបនាង យើងនឹងសម្លាប់ឯង » ។
« នេះហើយជា សារដែលយើងបានឮពីទ្រង់ ហើយប្រកាសប្រាប់អ្នក រាល់គ្នាថា ព្រះទ្រង់ ជាពន្លឺ ហើយក្នុងទ្រង់មិនមាន ភាពងងឹតអ្វីឡើយ ។
« ព្រះយេស៊ូវបាន កាន់តាមច្បាប់សម្រាប់អ្នក និងសម្រាប់ខ្ញុំ ហើយបានទទួល រង្វាន់សម្រាប់យើង » ។
វា មាន បួន ពណ៌ ពី ទិស ទាំង បួន ; គាត់សួរប្រជាជនថាតើនេះមកពីណា ?
សូម ថ្វាយ ព្រះពរ ព្រះអង្គ ។
