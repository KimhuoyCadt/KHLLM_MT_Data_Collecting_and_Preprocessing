28 ជារៀងរាល់ឆ្នាំ ទីបី ចូរប្រមូលទុកនៅក្នុងក្រុងរបស់អ្នក ជាចំណែក ១០ នៃអាហារដែលអ្នកបានដាំនៅក្នុងចម្ការរបស់អ្នក ។
7 ដ្បិតយើងមិនបានយកអ្វីមកក្នុងលោកីយ៍ទេ ហើយយើងមិនអាចដកយកអ្វីចេញពីវាបានឡើយ ។
1 « ឥឡូវនេះ កូនមនុស្សអើយ ចូរយកឥដ្ឋ មកដាក់នៅមុខអ្នក ហើយទាញក្រុងយេរូសាឡិម មកលើនោះ ។
មូលដ្ឋាន ទិន្នន័យ បន្ទាប់ ដែល ខ្ញុំ នឹង ទៅ
ខ្ញុំក៏ប្រហែលជាត្រូវការ ពេលខ្ញុំដល់ចុងឆ្នាំង ។
ព្រោះ វា លាក់ គ្រាប់ ធញ្ញជាតិ នៅក្នុង អង្កាម ។
25 ដ្បិតដាវីឌមាន ប្រសាសន៍អំពីគាត់ថា “ ខ្ញុំបានឃើញព្រះ‌ អម្ចាស់នៅចំពោះមុខខ្ញុំជានិច្ច ដ្បិតគាត់នៅខាងស្ដាំខ្ញុំ ដើម្បីកុំឲ្យខ្ញុំ ញ័រ ។
ចុះរូបភាពសមត្ថកិច្ច ណាដែលរំលោភបុរសនេះ ?
យើងអយុត្តិធម៌ចំពោះសម្តេច ។
ហើយ អ្នក អាច ធ្វើ អ្វី មួយ ដែល ស្រដៀង គ្នា សម្រាប់ ពួកគេ ដែល នៅសល់ ។
គាត់បានដឹងរឿងនេះហើយ ហើយគាត់ពេញ ចិត្ត ។
ទ្រង់មក រកអ្នកនៅថ្ងៃនេះ ហើយអង្វរអ្នកម្ដងទៀតឲ្យ ប្រែ ចិត្ត ។
ខ្ញុំ មិន អី ទេ រហូតដល់ ព្រឹក ថ្ងៃ ណាត់ជួប ។
ខ្ញុំស្គាល់ទ្រង់ដោយព្រោះខ្ញុំ មកពីទ្រង់ ហើយទ្រង់បានចាត់ខ្ញុំឲ្យ មក » ។
មនុស្ស ម្នាក់ មិន ចាំបាច់ រត់ សូម្បីតែ ការចងចាំ របស់ មនុស្ស ម្នាក់ ដើម្បី គិត ពី ឈ្មោះ ពីរ ឬ បី ។
អ្នក អាច សាកល្បង វា ព្រោះ វា ងាយស្រួល ប្រើ ។
បន្ទាប់មក គេ នាំ នាង ទៅ មន្ទីរពេទ្យ ។
ប្រាថ្នា ថា ខ្ញុំ បាន នៅ ទីនេះ សម្រាប់ ការ នេះ ។
លើកតម្កើង នៅ ស្ថាន សួគ៌ ។
ម្តង ធ្វើឱ្យ អ្នកស្រុក ស្រែក យំ នៅពេល ពួកគេ ជិះ ទូក
តាមពិត ការសន្ទនានិងការចរចាគឺ ជាផ្លូវត្រឹមត្រូវ តែមួយគត់ដែលចេញ » ។
ការលេង ដោយ យុត្តិធ ម៌៖
នេះ គឺជា អាយុ ដ៏ ល្អ បំផុត សម្រាប់ ការធ្វើដំណើរ ។
អ្នក រាល់គ្នាដឹងហើយ ប៉ុន្តែខ្ញុំនៅ តែជាមនុស្សច្រណែន ។
កាលពី បី ឆ្នាំ មុន ខ្ញុំ បាន សម្រេចចិត្ត ផ្លាស់ប្តូរ ផ្នត់គំនិត របស់ ខ្ញុំ ។
ក្នុង ចំណោម ប្រភេទ ផ្សេង ៗ នៃ ការកាត់ និង រាង ពួកគេ មកពី ពួក ឧទ្ទាម ។
ប្រាកដ ណាស់ ខ្ញុំ អាច ធ្វើ វា បាន ប៉ុន្តែ វា មិន ស្រប ច្បាប់ ទាំងស្រុង នោះ ទេ ។
ព្រះរាជាណាចក្រ អារ៉ាប៊ី សាអូឌីត ផ្តល់ សញ្ជាតិ ដល់ មនុស្ស យន្ត
១៦ ឬជា កំណើតមិនទាន់កំណត់ដែលខ្ញុំបានលាក់ទុក ដូចជាទារកដែលមិនដែលឃើញពន្លឺ ។
ប្រសិនបើលោកស្រីយីង ឡាក់ត្រូវបានចោទប្រកាន់ លោកស្រីនឹងត្រូវហាមមិនឱ្យធ្វើនយោបាយរយៈពេលប្រាំឆ្នាំ ។
អ្នក ត្រូវតែ ហ៊ាន លះបង់ គ្រប់ យ៉ាង ។
ផឹក តែ សម្រាប់ ពេល ខ្លះ ។
ព្រះបាទសូលមានរាជ ឱង្ការទៅ កាន់ដាវីឌ ថា៖ « អ្នកមិនអាចទៅ ត ទល់នឹងជន ជាតិភីលី ស្ទីនបានទេ » ។
ក្រុមហ៊ុន មិន មែន ទេ ។
លុះត្រាតែ អ្នក អាច យោល បាន ច្រើន ។
មិន អាច លើស ពី ពេលវេលា នៅក្នុង ពិភពលោក បាន ទេ ។
" សេវាកម្ម ល្អ គ្មាន ការរអាក់រអួល ចំពោះ ខ្ញុំ ។
ការ សរសេរក្នុងគម្ពីរត្រូវបានសរសេរ ជាយូរមកហើយ ។
ភាគ ច្រើន ត្រូវបាន ធ្វើ មុន ពេល នោះ ។
អធិស្ឋាន អរគុណ សម្រាប់ ការចុះឈ្មោះ ចូលរៀន ។
ប្រាប់មកកូនស្រីនេះមិនទាន់ត្រៀមខ្លួនទទួលកាដូខ្លះទេ !
សូមអធិស្ឋានសម្រាប់យើង » ។
ញ៉ាំ អាហារ ដែល មាន សុខភាព ល្អ ដែល ធ្វើឱ្យ អ្នក មានអារម្មណ៍ ល្អ បំផុត
ឃ្លីប នេះ ក៏ បង្ហាញ ពី អ្នកនាំពាក្យ បាន និយាយ ថា “ ជន អនាមិក មកពី ជុំវិញ ពិភពលោក នឹង តាម ប្រមាញ់ អ្នក ។
គាត់ នឹង ឆ្លៀត ឱកាស ណា មួយ ដើម្បី លើកតម្កើង ព្រះ របស់ គាត់ ។
« នេះជាកូនប្រុស ជាទី ស្រឡាញ់របស់ខ្ញុំ ដែលខ្ញុំពេញ ចិត្ត ។
បន្ទាប់មកគាត់ស្រែកខ្លាំងៗ ហើយដួលសន្លប់នៅនឹងដី ។
ឥឡូវខ្លាចចិនតាមអ៊ីនធឺណិត ។
ដ្បិតខ្ញុំបានឃើញមុខអ្នក ហើយ ហាក់ដូចជាបានឃើញព្រះភក្ត្រនៃព្រះ ដោយអ្នកបានទទួលខ្ញុំយ៉ាងពេញ ចិត្ត ។
ដោយ ហេតុផល ខ្លះ លោក មិន ទទួលយក ការពន្យល់ ថា នេះ ជា កាណុង បាញ់ ប្រឆាំង នាវា មុជទឹក ។
មិនត្រឹម តែប៉ុណ្ណឹងទេ ឈ្លោះគ្នាហើយយល់ខុសគ្រប់វេន ។
មនុស្ស ស្រឡាញ់ ពួកគេ ហើយ ស្តាប់ ពួកគេ ។
សម្រាប់ មនុស្ស ជាច្រើន កន្លែង ធ្វើការ គឺជា គេហទំព័រ ចម្បង ឬ តែ មួយ គត់ នៃ ការចូល ប្រើ អ៊ីនធឺណិត ។
អ្វី ដែល អ្នក អាច ធ្វើ បាន ដើម្បី ជួយ សហគម ន៍៖
មិន មែន លីនេអ៊ែរ , សម្រាប់
សួរ បុរស ដែល អ្នក ចូលចិត្ត ប្រាប់ អ្នក អំពី ទម្លាប់ ចម្លែក ដែល គាត់ មាន ។
ត្រូវ ប្រាកដ ថា តាមដាន ស្មៅ របស់ ពួកគេ ។
ហើយ ពួកគេ ទាំង នេះ នឹង មើល អ្នកលង់ទឹក ។
២៤ « សូមបង្រៀនខ្ញុំ នោះខ្ញុំនឹង កាន់អណ្ដាតរបស់ខ្ញុំ ហើយធ្វើឲ្យខ្ញុំយល់ពីអ្វីដែលខ្ញុំបានធ្វើខុស ។
ខ្ញុំ ដឹង ព្រោះ ខ្ញុំ មើល ច្រើន ណាស់ ។
ប៉ុន្តែ អ្វី ៗ ទាំងអស់ គឺ ពិសិដ្ឋ ណាស់ អ្វី គ្រប់ យ៉ាង គឺ ព្រះ។
យើង ទាំងអស់ គ្នា ជា ខ្មែរ ។
ហ្វូង មនុស្ស នៅលើ ថា សរឹង របស់ យើង ។
ខ្ញុំនិយាយនេះធ្វើឲ្យអ្នក ខ្មាស ។
ធ្វើឱ្យ ពួកគេ រងរបួស , បំផ្លាញ ពួកគេ ។
សូមស្វាគមន៍ ក្នុង ការចូលរួម ។
វានិយាយដោយពិពណ៌នាអំពី ការអនុវត្តនៃពួក ជំនុំនៅសតវត្សទីមួយថា « ហើយនៅថ្ងៃទីមួយនៃសប្តាហ៍ . . . ពួកសិស្សបានមកជុំគ្នាដើម្បីកាច់នំប៉័ង ... » ( កិច្ចការ 20:7 ) ។
សូមឱ្យពួកគេ ស ច្ចា ប្រណិធានចំពោះមាតាបិតាតាម រយៈអំពើរបស់ខ្លួន ។
ទទួលយក វគ្គ សិក្សា និង ទាំងអស់ គ្នា ។
វា ជា ពេលវេលា ដ៏ អស្ចារ្យ មួយ សម្រាប់ ខ្ញុំ និង បុគ្គលិក របស់ ខ្ញុំ ។
អ្នក គឺជា មនុស្ស ល្ងីល្ងើ ដែល ពេល ខ្លះ ធ្វើត្រាប់ តាម មនុស្ស ល្អ ម្នាក់ ។
ជា កម្មសិទ្ធិ របស់ ស៊ីម៉ូន ។
ប៉ុន្តែអ្នកចង់ដឹងថាតើនេះរំខានខ្ញុំទេ ?
ពូ គាត់ប្រាប់គាត់ថា ៖ សងបំណុលវិញ បើអ្នកអាច បើមិនអ៊ីចឹងមិនសងទេ ។
តាមពិត ពួកគេត្រូវបានលើកទឹក ចិត្តយ៉ាងខ្លាំង ។
ជើង ឆាប់ ស្រក់ ឈាម ។
