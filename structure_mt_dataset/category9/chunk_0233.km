( ស្នួល - ក្រចេះ ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ ជា ប្រធាន ក្រុមការងារ ខេត្ត ក្រចេះ និង សហការី បាន ចូលរួម ក្នុង កិច្ចប្រជុំ ការងារ រៀបចំ សន្និបាត មូលដ្ឋាន ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ដើម្បី ចូលរួម អបអរសាទរ ឧទ្ទិស ដល់ ខួប លើក ទី ៤៣ នៃ ទិវា ជ័យ ជំនះ « ៧ មក រា ១៩៧៩ - ៧ មករា ២០២២ » ។
ពិធី នេះ បាន ប្រារព្ធ ឡើង នៅ ព្រឹក ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២២ នាទីលាន វិមាន អនុស្សាវរីយ៍ ថ្ងៃ បង្កើត រណសិរ្ស សាមគ្គី សង្គ្រោះ ជាតិ កម្ពុជា ២ធ្នូ ១៩៧៨ ស្ថិត ក្នុង ឃុំ ២ធ្នូ ស្រុក ស្នួល ខេត្ត ក្រចេះ ដោយ មាន ការចូលរួម ពីសំណាក់ អស់ លោក លោកស្រី ជា សមាជិក ព្រឹទ្ធសភា អ្នកតំណាងរាស្រ្ត សមាជិក ក្រុមការងារ ថ្នាក់ ជាតិ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត អភិបាល ខេត្ត ប្រធាន ក្រុមការងារ និង អភិបាល ស្រុក ក្រុង ទាំង៧ មេឃុំ មេភូមិ និង មន្រ្តី មូលដ្ឋាន ជាច្រើន នាក់ ទៀត សរុប មាន អ្នកចូលរួម ប្រមាណ ជាង ៤០០ នាក់ ។
លោក ប្រធាន ក្រុមការងារ ខេត្ត ក្រចេះ ក៏ បាន ថ្លែង គូសបញ្ជាក់ ពី គុណ តម្លៃ នៃ ការចងចាំ និង ការដឹងគុណ របស់ ប្រជាជន កម្ពុជា ចំពោះ ពលីកម្ម ដ៏ ខ្ពង់ខ្ពស់ របស់ បុព្វការី ជន យើង ក្នុង បុព្វហេតុ វាយ ផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ដើម្បី សង្គ្រោះ ប្រជាជាតិ ស្តារ កសាង ប្រទេសជាតិ បង្រួបបង្រួម ជាតិ បញ្ចប់ សង្គ្រាម ដែល ជា មូលដ្ឋានគ្រឹះ នាំមក នូវ សុខ សន្តិភាព វឌ្ឍនភាព វិបុលភាព របស់ កម្ពុជា នា ពេល បច្ចុប្បន្ន និង ត ទៅ អនាគត ។
ខាងក្រោម នេះ ជា របាយការណ៍ នៃ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស អាស៊ាន គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២២៖
នៅ សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន ចេញផ្សាយ នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ( ម៉ោង នៅ វ៉ាស៊ីនតោន ) សេតវិមាន បាន ឱ្យដឹង ទៀត ថា ប្រធាន សភា តំណាងរាស្ត្រ អាមេរិក លោកស្រី Nancy Pelosi បាន ផ្ញើ លិខិត អញ្ជើញ លោក ចូ បៃ ដិន ឱ្យ ថ្លែង សុន្ទរកថា ប្រចាំ ឆ្នាំ នៅឯ សម័យ ប្រជុំ រួម នៃ សភា ទាំង២ របស់ សហរដ្ឋ អាមេរិក នៅ ថ្ងៃទី១ ខែមីនា ដើម្បី ចែករំលែក ចក្ខុវិស័យ របស់ លោក សម្រាប់ ប្រទេសជាតិ ។ សេតវិមាន បន្ថែម ថា លោក ប្រធានាធិបតី ចូ បៃ ដិន ក៏ បាន ទទួលយក ការអញ្ជើញ នេះ ដែរ ។
គួរ បញ្ជាក់ ថា ជាធម្មតា ការថ្លែង សុន្ទរកថា ប្រចាំ ឆ្នាំ របស់ ប្រធានាធិបតី អាមេរិក ស្ដីពី « ស្ថានភាព សហព័ន្ធ » ត្រូវ ធ្វើឡើង នៅ ចុង ខែមករា ឬ នៅ ដើម ខែកុម្ភៈ ហើយ ការលើ ក ពេលនេះ អាច បណ្ដាល មកពី ការកើនឡើង ករណី ឆ្លង COVID-19 នៅក្នុង សហរដ្ឋ អាមេរិក ដែល បង្កឡើង ដោយ មេរោគ បំប្លែង ថ្មី អូមី ក្រុង ៕
អតីត យុទ្ធជនជា មុខសញ្ញា ពិកា មួយ គ្រួសារ នៅ ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ ទទួល ផ្ទះ ១ខ្នង ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន
( ព្រះវិហារ ) ៖ គ្រួសារ អតីត យុទ្ធជន ដែល ជា មុខសញ្ញា ពិកា មួយ គ្រួសារ រស់ នៅ ភូមិ ដា ឃុំ ចម្រើន ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ បាន ទទួល ផ្ទះ ១ខ្នង ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ។
នៅក្នុង ឱកាស នេះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ ច័ន្ទ សុភ័ក្ត្រា បាន ថ្លែង ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា លោក ទេសរដ្ឋមន្ត្រី គន់ គីម អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា និង លោក ប្រាក់ សុវណ្ណ ប្រធាន កិត្តិយស សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត ព្រះវិហារ ដែល ជានិច្ច ជាកាល តែង បាន គិតគូរ យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ បងប្អូន អតីត យុទ្ធជន កម្ពុជា នៅក្នុង ខេត្ត ព្រះវិហារ ។
ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត ព្រះវិហារ ក៏ បាន ថ្លែង កោតសរសើរ ដល់ វីរៈ ភាព និង ភាពអង់អាច ក្លាហាន របស់ បងប្អូន អតីត យុទ្ធជន របស់ យើង ដែល បាន ចូលរួមចំណែក យ៉ាង សំខាន់ នា ពេល កន្លងមក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ឈ្លាសវៃ និង បុិន ប្រសព្វ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ការកសាង ជាតិ មាតុភូមិ រហូត ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ គ្រប់ វិស័យ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ។
នា ឱកាស នោះ ដែរ ថ្នាក់ដឹកនាំ ទាំង២ ក៏ បាន កោតសរសើរ ដល់ សាស្រ្តាចារ្យ លោកគ្រូ អ្នកគ្រូ ដែល បាន យកចិត្តទុកដាក់ ចិត្ត ខិតខំ បង្ហាត់ បង្រៀន ដល់ សិស្សានុសិស្ស មិន ថា មាន បញ្ហា ទុក្ខលំបាក យ៉ាងណា ក៏ មិន ថ្អូញ ថ្អែរ ហើយ តស៊ូ ពុះពារ គ្រប់ ឧបសគ្គ ។ ថ្នាក់ដឹកនាំ ទាំង២ ក៏ បាន ផ្តល់ ដំបូន្មាន ដល់ សិស្សានុសិស្ស ទាំងអស់ ឱ្យ ខិតខំ ប្រឹងប្រែង ព្យាយាម រៀនសូត្រ សិក្សា ស្រាវជ្រាវ បំពេញ បន្ថែម និង បង្កើន នូវ ចំណេះដឹង ភាសា បរទេស ដើម្បី អនាគត របស់ ខ្លួន ក្រុមគ្រួសារ និង សង្គមជាតិ ទាំងមូល ។
ការចែករំលែក បទពិសោធន៍ របស់ ថ្នាក់ដឹកនាំ ទាំង ពីរ បាន ធ្វើឡើង ក្នុង ឱកាស លោក អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សិស្សានុសិស្ស ថ្នាក់ ទី១២ ដែល ទើប បញ្ចប់ ការប្រឡង សញ្ញាបត្រ ទុតិយភូមិ ចំនួន ៩២៣ នាក់ មកពី ស្រុក ក្រគរ ចំនួន ៦៦២ នាក់ និង ស្រុក កណ្តៀង ចំនួន ២៦១ នាក់ នៃ វិទ្យាល័យ ហ៊ុន សែន ក្រគរ . វិទ្យាល័យ ១០មករា បឹងកន្ទួត . វិទ្យាល័យ ឈើ តុំ . វិទ្យាល័យ ហ៊ុន សែន ក ណ្តៀង និង វិទ្យាល័យ នទី សេដ្ឋា នា រសៀល ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២២ ។
ជា ការលើកទឹកចិត្ត ដល់ កូនក្មួយ សិស្សានុសិស្ស ថ្នាក់ដឹកនាំ ទាំង២ បាន ប្រកាស រៀបចំ ដំណើរទស្សនកិច្ច អញ្ជើញ កូនក្មួយ ទៅ លេង ខេត្ត សៀមរាប នា ពេល ឆាប់ ៗ ខាងមុខ ហើយ បន្ទុក ទាំងអស់ នោះ ក្រុមការងារ ចុះ ជួយ ឃុំ នីមួយ ៗ ជា អ្នកទទួល រ៉ាប់ រង និង ត្រូវ បន្ត អនុវត្តន៍ វិធានការ « ៣ការពារ ៣កុំ » ក៏ ដូចជា វិធានការ នានា របស់ ក្រសួង សុខាភិបាល បើ ទោះ យើង ទាំងអស់ គ្នា ទទួលបាន វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ គ្រប់ ៗ គ្នា ក៏ដោយ ។
លោក រដ្ឋមន្ត្រី ទេសចរណ៍ បាន បញ្ជាក់ ថា សម្រាប់ គោលដៅ ទេសចរណ៍ សំខាន់ ៗ រួម មាន៖
បន្ថែម ពី នេះ លោក ថោង ខុន បាន កត់សម្គាល់ ថា បើ ទោះបី ថ្ងៃ ឈប់សម្រាក ពិធី បុណ្យ ឆ្នាំ សាកល ទើបតែ កន្លងផុត នា សប្តាហ៍ កន្លងមក ប៉ុន្តែ ចរន្ត ភ្ញៀវ ទេសចរ ផ្ទៃក្នុង នៅតែ បង្ហាញ សញ្ញា រឹងមាំ ។ ជាក់ស្តែង ត្រឹមតែ មួយ ថ្ងៃ ឈប់សម្រាក ៧ មករា ដែល ជា ថ្ងៃ កំណើត ទី២ របស់ ខ្លួន បងប្អូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ បរទេស ផងដែរ បាន ចេញ ដើរកំសាន្ត រហូតដល់ ជិត ១៦ម៉ឺន នាក់ ។
ជាមួយនឹង ចំនួន ភ្ញៀវ ទេសចរ ដើម កម្សាន្ត នេះ ដែរ រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន បញ្ជាក់ ថា ចរន្ត ភ្ញៀវ ទេសចរ នឹង បន្ត កើនឡើង រហូតដល់ ចុង សប្តាហ៍ ខណៈ ដែល ភ្ញៀវ ទេសចរ និង បងប្អូន ប្រជាពលរដ្ឋ នឹង បន្ត ដើរកម្សាន្ត នៅ គោលដៅ ទេសចរណ៍ ផ្សេង ៗ ក្រៅពី គោលការណ៍ ដែល បាន ពួកគាត់ បាន ទៅ នា ឱកាស ឆ្លង ឆ្នាំ សាកល ។
បើ តាម សេចក្ដីថ្លែងការណ៍ មួយ របស់ អាជ្ញាធរ សុខាភិបាល ចក្រភព អង់គ្លេស រយៈពេល ប្រហែលជា ៣ខែ ក្រោយ ការចាក់ វ៉ាក់សាំង បង្ការ ដូស ជំរុញ ឬ ដូស ទី៣ វា នៅតែ មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង កម្រិត ៩០ ភាគរយ ការពារ ប្រឆាំង នឹង ការចូល សម្រាក ព្យាបាល ក្នុង មន្ទីរពេទ្យ នៅក្នុង ចំណោម ក្រុម មនុស្ស មាន អាយុ ៦៥ ឆ្នាំ ឡើង ទៅ ។
សេចក្ដីថ្លែងការណ៍ ដដែល បាន បញ្ជាក់ ដូច្នេះ ថា « ទិន្នន័យ បច្ច ប្បន្ន បង្ហាញ ថា វ៉ាក់សាំង ដូស ជំរុញ នៅតែ មាន ប្រសិទ្ធភាព ខ្ពស់ ផ្ដល់ ការការពារ ប្រឆាំង មិន ឱ្យ ធ្លាក់ខ្លួន ឈឺ ធ្ងន់ បើ ទោះជា នៅក្នុង ចំណោម មនុស្ស ងាយ រងគ្រោះ បំផុត គឺ មនុស្ស ចាស់ ក៏ដោយ ... ហើយ ក្រោម ហេតុផល នេះ វា មិន ទាន់ មាន ភាពចាំបាច់ បន្ទាន់ តម្រូវ ឱ្យ ចាក់ វ៉ាក់សាំង ដូស ទី៤ នៅឡើយ ទេ » ។
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ការយោគយល់ ខ្ពស់ ! ស្លាប់ ១នាក់ និង របួស ១២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៧ ខែមករា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន មនុស្ស ១នាក់ បាន ស្លាប់ និង ១២នាក់ រងរបួស ធ្ងន់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២២ ។ នេះ បើ តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
សម្ដេច តេជោ ហ៊ុន សែន អញ្ជើញ ចូលរួម ក្នុង ពិធី លៀង សាយ ភោជន៍ ដែល រៀបចំឡើង ដោយ ប្រធាន ក្រុមប្រឹក្សាភិបាល រដ្ឋ នៃ សាធារណរដ្ឋ សហភាព មីយ៉ាន់ម៉ា
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ រាត្រី ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី លៀង សាយ ភោជន៍ ដែល រៀបចំឡើង ដោយ ប្រធាន ក្រុមប្រឹក្សាភិបាល រដ្ឋ នៃ សាធារណរដ្ឋ សហភាព មីយ៉ាន់ម៉ា ក្នុង ដំណើរ អញ្ជើញ បំពេញ ទស្សនកិច្ចការងារ រយៈពេល ពីរ ថ្ងៃ នៅ មីយ៉ាន់ម៉ា ។
នាយ ឧត្តមសេនីយ៍ មីន អោង ឡាំង (Min Aung Hlaing) ប្រធាន ក្រុមប្រឹក្សា រដ្ឋបាល រដ្ឋ នៃ សាធារណរដ្ឋ សហភាព មីយ៉ាន់ម៉ា បាន ប្រារព្វ ពិធី លៀង សាយ ភោជន៍ ជា មហា កិត្តិយស ដ៏ ខ្ពង់ខ្ពស់ បំផុត ជូន សម្តេច តេជោ ហ៊ុន សែន និង គណៈប្រតិភូ ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន អញ្ជើញ បំពេញ ទស្សនកិច្ចការងារ នៅ រដ្ឋធានី ណៃ ពិដោរ សាធារណរដ្ឋ សហភាព មីយ៉ាន់ម៉ា ។
នាយ ឧត្តមសេនីយ៍ មីន អោង ឡាំង បាន ថ្លែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី និង រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា ដែល បាន ផ្តល់ ជំនួយ សម្ភារៈ បរិក្ខា វេជ្ជសាស្រ្ត ដើម្បី ជួយ ដល់ ប្រទេស មីយ៉ាន់ម៉ា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ រាតត្បាត កូវីដ ១៩ ៕
ក្នុង ចំណោម ករណី ឆ្លង ខាងលើ មាន ៣៩៦ នាក់ ជា ករណី នាំចូល ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង ស្រុក ។ ចំណែក អ្នកស្លាប់ សរុប នៅ ទូទាំង ប្រទេស កើន ដល់ ៨៣៧ នាក់ ដដែល បន្ទាប់ពី បាន រាយការណ៍ ពី អ្នកស្លាប់ ថ្មី ចំនួន ២នាក់ ទៀត នៅ ថ្ងៃ នេះ ខណៈ ករណី ឆ្លង កូវីដ១៩ សរុប កេីន ដល់ ២៨៣. ៩៩១ ករណី ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស រួម របស់ កម្ពុជា - មីយ៉ាន់ម៉ា៖ គ.ជ. ប អនុម័ត លើ បទបញ្ជា និង នីតិវិធី សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឆ្នាំ ២០២២
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គជប) បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ពី ការអនុម័ត លើ បទបញ្ជា និង នីតិវិធី សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឆ្នាំ ២០២២ ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២២ នេះ ។
ការអនុម័ត នេះ បាន ធ្វើឡើង បន្ទាប់ពី លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប បាន បើក កិច្ចប្រជុំ ដើម្បី ពិនិត្យ និង សម្រេច ជុំវិញ ការផ្ដល់ យោបល់ លើ សេចក្ដីព្រាង បទបញ្ជា និង នីតិវិធី សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ដែល ភាគី ពាក់ព័ន្ធ បាន ផ្ដល់ ត្រឡប់មក គ.ជ. ប វិញ នា ថ្ងៃព្រហស្បតិ៍ ទី៦ ខែមករា ឆ្នាំ ២០២២ ម្សិលមិញ ។
សេចក្ដីព្រាង បទបញ្ជា និង នីតិវិធី ដែល មាន ចំនួន ១៤ជំពូក និង ១៨៧ ប្រការ ព្រមទាំង មាន ៩ឧបសម្ព័ន្ធ ត្រូវបាន គ.ជ. ប បញ្ជូន ទៅ ឱ្យ ភាគី ពាក់ព័ន្ធ នឹង ការបោះឆ្នោត ដើម្បី សុំ ផ្ដល់ យោបល់ រួម មាន ក្រសួង ស្ថាប័ន រាជ រដ្ឋាភិបាល ចំនួន ៩ គណបក្ស នយោបាយ ចំនួន ២៦ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ចំនួន ២៨ ។
ក្នុង របាយការណ៍ ថ្ងៃសុក្រ នេះ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ២៣៣ នាក់ បន្ថែម ទៀត ផងដែរ ។
រហូតមកដល់ ម៉ោង នេះ មាន សារព័ត៌មាន ធំ ៗ ល្បី ៗ ជាច្រើន កំពុង តាមដាន និង ផ្សព្វផ្សាយ អំពី ដំណើរទស្សនកិច្ច របស់ សម្ដេច តេជោ ហ៊ុន សែន ទៅកាន់ ប្រទេស សមាជិក អាស៊ាន ដែល កំពុង មាន ភាពច្របូកច្របល់ មួយ នេះ ។ ការចាប់អារម្មណ៍ ក៏ ព្រោះតែ ដំណើរទស្សនកិច្ច របស់ សម្ដេច តេជោ ហ៊ុន សែន មាន គោលដៅ សម្របសម្រួល ដល់ វិបត្តិ ភូមា ដើម្បី ស្ដារ សភាពការណ៍ និង ពង្រឹង មជ្ឈភាព របស់ អាស៊ាន ឡើងវិញ ។
ខាងក្រោម នេះ ជា ប្រធានបទ របស់ សារព័ត៌មាន អន្តរជាតិ ធំ ៗ នៅ ជុំវិញ ពិភពលោក ដែល ផ្សព្វផ្សាយ អំពី ដំណើរទស្សនកិច្ច របស់ សម្ដេច តេជោ ហ៊ុន សែ ន៖
ទោះជា យ៉ាងណា បណ្តា ប្រទេស ដែល មាន អ្នក ឆ្លង ចាប់ពី ១០.០០០ ករណី គឺ មាន ១៧៨ ប្រទេស និង ដែនដី ខណៈ ប្រទេស កម្ពុជា យើង ឈរ នៅ លេខរៀង ទី ១១០ ។
ជាមួយគ្នា នេះ ដើម្បី គ្រប់គ្រង ការឆ្លង រាលដាល នៅក្នុង ប្រទេស ផ្ទាល់ ការពិសា គ្រឿងស្រវឹង នៅ តាម ភោជនីយដ្ឋាន នឹង ត្រូវ ផ្អាក នៅ ក្រោយ ម៉ោង ៩យប់ ក្នុង ខេត្ត ចំនួន ៨ រួមទាំង រាជធានី បាងកក ចាប់ពី ថ្ងៃអាទិត្យ ចុង សប្តាហ៍ នេះ ហើយ វា នឹង ត្រូវ ហាមឃាត់ ទាំងស្រុង តែ ម្តង នៅ តាម ខេត្ត ចំនួន ៦៩ ដទៃ ទៀត របស់ ប្រទេស ថៃ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ក្លាយជា មេដឹកនាំ បរទេស ដំបូង គេ ដែល អញ្ជើញ ទស្សនកិច្ច នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា ចាប់តាំងពី យោធា បាន ចាប់ខ្លួន លោកស្រី អង់ សាន ស៊ូជី កាលពី ដើម ឆ្នាំ ២០២១ ។ ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ ហ៊ុន សែន នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា មាន រយៈពេល ពីរ ថ្ងៃ គឺ ថ្ងៃទី ០៧ និង ថ្ងៃទី ០៨ ខែមករា ។
យោង តាម ក្រសួង ការបរទេស កម្ពុជា បាន ឱ្យដឹង ថា ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង ត្រូវ អម ដំណើរ ដោយ លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ និង លោក ទេសរដ្ឋមន្ត្រី ចម ប្រសិទ្ធ រដ្ឋមន្ត្រី ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ និង មន្ត្រី ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា មួយចំនួន ទៀត ។
បើ តាម ក្រសួង ការបរទេស កម្ពុជា ក្នុង ឱកាស នៃ ដំណើរទស្សនកិច្ច នេះ សម្តេច តេជោ នឹង មាន ជំនួប ទ្វេ ភាគី ជាមួយ នាយ ឧត្តមសេនីយ៍ ជាន់ ខ្ពស់ មីន អោង ឡាំង ដើម្បី ពិភាក្សា និង ផ្លាស់ប្តូរ ទស្សនៈ អំពី កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី និង ពហុ ភាគី និង ការវិវត្ត ថ្មី ៗ នៅក្នុង អាស៊ាន ។
បើ ទោះបី ក្រសួង ការបរទេស កម្ពុជា មិន បាន លើក លំអិត ពី របៀបវារៈ នៃ ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ យ៉ាងណាក្តី ។ តែ បើ តាម ការបញ្ជាក់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដំណើរ ទៅកាន់ ប្រទេស មីយ៉ាន់ម៉ា របស់ សម្តេច នា ពេលនេះ សម្តេច ចូលរួម វិភាគទាន ដោះស្រាយ វិបត្តិ របស់ មីយ៉ាន់ម៉ា ជាពិសេស ការនាំ មីយ៉ាន់ម៉ា វិល មក រក វេទិកា របស់ អាស៊ាន ឡើងវិញ បន្ទាប់ពី ប្រទេស ត្រូវបាន អវត្តមាន ក្នុង វេទិកា អាស៊ាន នា ឆ្នាំ កន្លងទៅ ។
ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ ទៅកាន់ ប្រទេស មីយ៉ាន់ម៉ា កំពុង ស្ថិត ក្នុង ការចាប់អារម្មណ៍ និង តាមដាន យ៉ាង យកចិត្តទុកដាក់ ពី បណ្តាញ ផ្សព្វផ្សាយ និង មេដឹកនាំ ប្រទេស នានា ក្នុង តំបន់ និង លើ ពិភពលោក ៕ អង់គ្លេស នឹង បញ្ចេញ កងកម្លាំង យោធា ឲ្យ ទៅ ជួយ ការងារ តាម មន្ទីរពេទ្យ ចំពោះ មុខ កំណើន ករណី ឆ្លង កូវីដ - ១៩ យ៉ាង គំហុក
ប្រកាស សមាសភាព ក្រុមការងារ ចំនួន ១៩ រូប ទៀត ចុះ ជួយ ពង្រឹង ការងារ បក្ស នៅ មូលដ្ឋាន ឃុំ ពង ទឹក ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោក ចាន់ កុលបុត្រ ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ឃុំ ពង ទឹក ស្រុក រំដួល ខេត្ត ស្វាយរៀង បាន លើកឡើង ថា ខួប រយៈពេល ៤៣ ឆ្នាំ នៃ ទិវា អនុស្សាវរីយ៍ ៧ មក រា ១៩៧៩ គឺជា សច្ចធម៌ ប្រវត្តិសាស្រ្ត ដែល មិន អាច មាន អ្នកណា មក បំភ្លៃ បំផ្លើស បំភ្លេច ឬ បំផ្លាញ បាន ឡើយ ក្រោម ការលះបង់ សាច់ ស្រស់ ឈាម ស្រស់ របស់ សម្តេច តេជោ ហ៊ុន សែន និង ឥស្សរជន ផ្សេង ៗ ទៀត ។
ការថ្លែង បែប នេះ របស់ លោក ចាន់ កុលបុត្រ នៅក្នុង ពិធី ប្រកាស សមាសភាព ក្រុមការងារ ចំនួន ១៩ រូប បន្ថែម ទៀត ដើម្បី ចុះ ជួយ ពង្រឹង ការងារ បក្ស នៅ មូលដ្ឋាន ឃុំ ពង ទឹក ឱ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ។ ពិធី ប្រកាស ក្រុមការងារ គណបក្ស ប្រជាជន ឃុំ ពង ទឹក នេះ ដែរ ក៏ មាន ការចូលរួម ពី លោក រស់ ផារិទ្ធ អភិបាល រង ខេត្ត ស្វាយរៀង និង ជា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ពង ទឹក ព្រមទាំង លោក លោកស្រី ដែល ជា សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ជាច្រើន នាក់ ផងដែរ ។
លោក បាន បន្ថែម ថា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន នាំមក នូវ សុខ សន្តិភាព ជូន ជាតិ មាតុភូមិ ហើយ បាន ប្រែក្លាយ ប្រទេស កម្ពុជា ពី ចំណុច សូន្យ ឱ្យ មាន ការអភិវឌ្ឍន៍ រីកចំរើន លើ គ្រប់ វិស័យ តួយ៉ាង ដូចជា ខេត្ត ស្វាយរៀង មាន រោងចក្រ សហគ្រាស ជាច្រើន កន្លែង អាច ស្រូបយក កម្មករ កម្ម ការិនី កំពុង បម្រើ ការងារ ប្រមាណ ជាង ៩ម៉ឺន នាក់ ដែល ធ្វើឱ្យ ជីវភាព របស់ ប្រជាពលរដ្ឋ កាន់តែ ធូធារ ផងដែរ ។
នា ឱកាស នោះ ដែរ លោក រស់ ផារិទ្ធ ក៏ បាន ស្នើ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ចូលរួម ថែក្សា សមិទ្ធផល ទាំងឡាយ ដែល កើត ចេញ ពី ការខិតខំ អភិវឌ្ឍន៍ របស់ រាជ រដ្ឋាភិបាល និង គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ បាន គង់វង្ស និង ត្រូវ ប្រឆាំង ដាច់ខាត ជន ទាំងឡាយ ណា ដែល មាន គំនិត ចង់ បំផ្លាញ សុខ សន្តិភាព នៅក្នុង ប្រទេស និង ត្រូវ បន្ត ចូលរួម គាំទ្រ ការអនុវត្តន៍ កម្មវិធី ចតុកោណ ដំណាក់កាល ទី៦ របស់ រាជ រដ្ឋាភិបាល ឱ្យ ផុស ផល ។
ព្រម ជាមួយ នេះ យើង ទាំង អស់ គ្នា សូម លំឱន កាយ គោរព ឧទ្ទិស បួងសួង សូម ឱ្យ ដួង វិញ្ញាណក្ខន្ធ របស់ ជន រួម ជាតិ យើង រាប់ លាន នាក់ ដែល ត្រូវ សម្លាប់ យ៉ាង អយុត្តិធម៌ និង អាណោច អា ធម្ម បំផុត ក្នុង របប ប៉ុល ពត បាន ទៅកាន់ សុគតិភព ជារៀងដរាប » ។
ក្នុង ឱកាស អបអរសាទរ ជ័យជម្នះ ៧ មករា ! អគារ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក រមាសហែក ដែល មាន តម្លៃ ជាង ១លាន ដុល្លារ ត្រូវបាន សម្ភោធ ជា ផ្លូវការ ក្រោម អធិបតីភាព លោកស្រី បណ្ឌិត ម៉ែន សំអន
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី បាន នាំ នូវ សេចក្តីនឹករលឹក និង ការផ្តាំផ្ញើរ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ជានិច្ចកាល សម្តេច ទាំង ទ្វេរ តែងតែ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការគិតគូរ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។
លោកស្រី បាន បន្ថែម ថា អគារ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ដែល សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ នៅ ថ្ងៃ នេះ គឺជា សមិទ្ធផល ថ្មី មួយ នៅក្នុង ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង ដែល បម្រើ ឲ្យ រដ្ឋបាល គណបក្ស នៅ ថ្នាក់ មូលដ្ឋាន ហើយ អគារ នេះ ក៏ បាន បង្ហាញ ពី ភាពរឹងមាំ និង ជា គណបក្ស ដែល មាន ភាព ចាស់ទុំ ខាង នយោបាយ ក្នុង ការដឹកនាំ ប្រទេស ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ស្ថាបនិក មគ្គុទេ្ទស ឯក និង ប្រតិបត្តិករ នយោបាយ ឈ្នះ ឈ្នះ ដែល បាន នាំមក នូវ សន្តិភាព និង ការឯកភាព ជាតិ ពេញេលញ ។
លោកស្រី បណ្ឌិត បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល បាន ចុះឈ្មោះ បោះឆ្នោត រួចហើយ សូមអញ្ជើញ ទៅ ពិនិត្យ ផ្ទៀងផ្ទាត់ ឈ្មោះ នៅ តាម ការិយាល័យ គ.ជ. ប ដែល បាន កំណត់ នៅ តាម មូលដ្ឋាន ឲ្យបាន គ្រប់ ៗ គ្នា ចាប់ពី ថ្ងៃទី ៣ ដល់ ថ្ងៃទី ១៤ ខែមករា ឆ្នាំ ២០២២ ព្រោះ ការបោះឆ្នោត នេះ មាន សារ : សំខាន់ ណាស់ សំរាប់ អភិវឌ្ឍន៍ មូលដ្ឋាន ពិសេស ក៏ ជា ការចូលរួម ថែរក្សា សុខ សន្តិភាព ដែល មាន នា ពេល បច្ចុប្បន្ន ឱ្យ នៅ គង់វង្ស យូរអង្វែង ដើម្បីឱ្យ ប្រទេសជាតិ កាន់តែ មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ថែម ទៀត ។
