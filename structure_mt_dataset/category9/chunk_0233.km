( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ប្តេជ្ញា ត្រៀម នាំយក និស្សិត នៃ វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន ទៅកាន់ ការដ្ឋាន សាងសង់ នានា ទោះ មិន ស្ថិត នៅក្នុង ក្របខណ្ឌ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក៏ដោយ ដើម្បី ស្វែងយល់ ពី បទពិសោធន៍ និង ការ អនុវត្ត ជាក់ស្តែង លើ ការងារ សាធារណការ ។
គម្រោង ដែល នឹង ត្រៀម នាំ និស្សិត ទៅ រួម មាន ដូច ជា៖ ការដ្ឋាន ផ្លូវ ល្បឿន លឿន កំពង់ផែ គម្រោង សាងសង់ ផ្លូវ មួយចំនួន ទៀត រួម មាន គម្រោង សាងសង់ ស្ពាន នៅ ក្រចេះ គម្រោង ពង្រីក ផ្លូវ ពី ស្គន់ ទៅ កំពង់ចាម ពី ពីរ គន្លង ទៅ បួន គន្លង គម្រោង ពង្រឹង គុណភាព ផ្លូវ ជាតិ លេខ ៣១ ៣៣ និង ៤១ រួមទាំង ព្រលានយន្តហោះ ភ្នំពេញ ថ្មី ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បញ្ជាក់ ដូចនេះ នា ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយនិស្សិត ថ្នាក់ ឆ្នាំ សិក្សា មូលដ្ឋាន ២០២០ - ២០២១ នៃ វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន ដែល ត្រូវ ប្រឡង បញ្ចប់ ឆមាស ទី២ ជំនាន់ ទី១ ដោយ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង ទទួលបន្ទុក លោក ហឿន សំនៀង នាយក វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន លោក លោកស្រី ថ្នាក់ដឹកនាំ និង ក្រុមការងារ វិទ្យាស្ថាន ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី បាន បញ្ជាក់ ដែរ ថា វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន ជា ថ្នាល បណ្តុះបណ្តាល តែ មួយ គត់ នៅ កម្ពុជា ក្នុង ការផ្ដល់ ចំណេះដឹង ចំណេះ ធ្វើ ដល់ និស្សិត ឱ្យ ក្លាយជា វិស្វករ អាច កសាង ផ្លូវ ស្ពាន ប្រកបដោយ គុណភាព ជូន ប្រទេសជាតិ មាតុភូមិ ដូនតា បាន សាងសង់ ប្រាង្គ ប្រាសាទ អង្គរវត្ត និង ប្រាសាទ ផ្សេង ទៀត មាន អាយុកាល រាប់ ពាន់ ឆ្នាំ មិន ទាន់ ខូច នៅឡើយ ដូច្នេះ យើង មនុស្ស ជំនាន់ ក្រោយ គួរតែ អាច កសាង ស្ពាន ឆ្លង ទន្លេ មេគង្គ បាន ដោយ ខ្លួន ឯង ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ក៏ បាន ជំរុញ លើកទឹកចិត្ត ដល់ និស្សិត ឱ្យ ខិតខំ ប្រឹងប្រែង រៀនសូត្រ ឱ្យ ពូកែ មាន ឆន្ទៈ ខ្ពស់ ក្នុង ការសិក្សា ដើម្បី មាន សមត្ថភាព បច្ចេកទេស ចំណេះដឹង និង ជំនាញ អាច កសាង ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ និង យក ចំណេះ វិជ្ជា ទៅ ជួយ កសាង ប្រទេសជាតិ មាតុភូមិ ឱ្យ បាន រុងរឿង ថែម ទៀត ដើម្បី មោទនភាព ថ្នាក់ដឹកនាំ នៅ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក៏ ដូចជា ថ្នាក់ដឹកនាំ ប្រទេសជាតិ ផងដែរ ។
សូម ជម្រាប ថា៖ ការប្រឡង បញ្ចប់ ឆមាស ទី ពីរ នេះ នឹង ប្រព្រឹត្តទៅ ចំនួន ៣ ថ្ងៃ ពេញ ទាំង ព្រឹក និង ពេល រសៀល ចាប់ពី ថ្ងៃទី ២២ ដល់ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២១ ហើយ ការ ប្រឡង នេះ នឹង ត្រូវ ធ្វើ រួមគ្នា នៅ សាល ប្រជុំ ទីស្តីការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ដែល មាន និស្សិត ចូលរួម ប្រឡង សរុប ប្រមាណ ១៩១ រូប ចូលរួម ប្រឡង ជាមួយគ្នា ក្នុង សាល តែ មួយ ៕
ក្រសួង ការងារ អញ្ជើញ កម្មករ និយោជិត ៣៦០ នាក់ ដែល ត្រូវបាន កាត់បន្ថយ ដោយ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ និង មិន ទាន់ ទទួលយក ការទូទាត់ ប្រាក់ បំណាច់ ផ្ដាច់ កិច្ចសន្យា ចូលរួម ប្រជុំ បន្ត រក ដំណោះស្រាយ
( ភ្នំពេញ )៖ គណៈកម្មការ សម្រាប់ ដោះស្រាយ បញ្ហា កូដកម្ម និង បាតុកម្ម នៅ តាម គ្រប់ មុខ សញ្ញា បាន ចេញ លិខិត មួយ អញ្ជើញ កម្មករ និយោជិត ចំនួន ៣៦០ នាក់ ដែល ត្រូវបាន កាត់បន្ថយ ដោយ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ និង មិន ទាន់ ឯកភាព ក្នុង ការទទួលយក ការទូទាត់ ប្រាក់ បំណាច់ ផ្ដាច់ កិច្ចសន្យា ការងារ ចូលរួម ប្រជុំ បន្ត រក ដំណោះស្រាយ ។
ការប្រជុំ បន្ត រក ដំណោះស្រាយ សមស្រប ដើម្បីឲ្យ គ្រប់ ភាគី វិវាទ អាច ទទួលយក បាន ស្រប តាម បទប្បញ្ញត្តិ ច្បាប់ និង ផ្អែក លើ សមភាព និង សមធម៌ នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២១ ចាប់ពី ម៉ោង ៩ព្រឹក តទៅ នៅ សាល ប្រជុំ A នៃ ទីស្តីការ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
បើ តាម ការបញ្ជាក់ នៅក្នុង លិខិត អញ្ជើញ បាន ឲ្យដឹង ថា កម្មករ និយោជិត ទាំងអស់ អាច អញ្ជើញ តំណាង សហជីព ឬ អ្នកតំណាង ឬ មេធាវី របស់ ខ្លួន មក ចូលរួម ជាមួយ ខ្លួន បាន ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ មាន សេចក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា បងប្អូន កម្មករ និយោជិត ទាំងអស់ នឹង ចូលរួម ក្នុង កិច្ចប្រជុំ ខាងលើ ដើម្បី បញ្ចប់ វិវាទ ការងារ នៅ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ លីមីធីត នេះ ៕
ខាងក្រោម នេះ ជា លិខិត អញ្ជើញ កម្មករ និយោជិត ចូលរួម ប្រជុំ៖ សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២១
១៖ ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ មិន មាន អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ នោះ ទេ ចំណែក អ្នក ឆ្លង ថ្មី រកឃើញ ៤នាក់ . ជាសះស្បើយ ១២នាក់
៣៖ ឯកសារ ចំនួន ៧ ត្រូវបាន ចុះហត្ថលេខា ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន និង ប្រធានាធិបតី វៀតណាម
៤៖ ថៃ៖ មនុស្ស ២. ៤៧៦នាក់ ឆ្លង កូវីដ - ១៩ និង អ្នកជំងឺ ៣២ នាក់ ស្លាប់ ក្នុង របាយការណ៍ ថ្ងៃអង្គារ នេះ
៥៖ សម្តេច តេជោ ហ៊ុន សែន ថ្លែងអំណរគុណ ប្រធានាធិបតី វៀតណាម ដែល គាំទ្រ កម្ពុជា ធ្វើ យ៉ាងណា ឱ្យ ទទួល ជោគជ័យ ក្នុង កិច្ចប្រជុំ អាស៊ាន ឆ្នាំ ក្រោយ
៧៖ មេដឹកនាំ កម្ពុជា - វៀតណាម សម្តែង ការពេញចិត្ត ចំពោះ ការរីកចម្រើន នៃ ទំនាក់ទំនង គ្រប់ ជ្រុងជ្រោយ និង ជិតស្និទ្ធ រវាង ប្រទេស ទាំង ពីរ
៩៖ កម្ពុជា ចាប់ផ្តើម អនុវត្ត កូតា នាំចេញ អង្ករ ៤សែន តោន ថ្មី ដែល ផ្តល់ ដោយ មិត្ត ចិន
១១៖ អ្នក រកស៊ី អនឡាញ មក ចុះបញ្ជី នៅ ក្រសួង ពាណិជ្ជកម្ម កើនឡើង ខណៈ ក្រសួង ព្រមាន ផាក ពិន័យ ធ្ងន់ធ្ងរ លើ អ្នករកស៊ី មិន ចុះបញ្ជី
១៣៖ ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាព អាកាសធាតុ ចាប់ពី ថ្ងៃទី ២២ - ២៨ ខែធ្នូ . អាចនឹង មាន ភ្លៀង ពី ខ្សោយ ទៅ មធ្យម ហើយ អាកាសធាតុ ចុះ ត្រជាក់ ខ្លាំង ជាថ្មី
១៤៖ រុស្ស៉ី ទទូច ឲ្យ មាន ការឆ្លើយតប ជាបន្ទាន់ ពី សហរដ្ឋ អាមេរិក ពាក់ព័ន្ធ បញ្ហា សន្តិសុខ
១៦៖ វិភាគ អន្តរជាតិ៖ លោក ចូ បៃ ដិន . ពី ប្រធានាធិបតី មាន ការគាំទ្រ ភ្លូក ទឹក ភ្លូក ដី ក្លាយជា ប្រធានាធិបតី បាត់បង់ ការគាំទ្រ ភ្លូក ទឹក ភ្លូក ដី
២៖ TikTok ចាប់ផ្ដើម ដំណើរការ ប្រព័ន្ធ របាយការណ៍ តម្លាភាព និង មជ្ឈមណ្ឌល តម្លាភាព ជា ភាសា ខ្មែរ
ប្រទេស ចិន នា ពេល ឥឡូវនេះ កំពុង ព្យាយាម ប្រយុទ្ធ ប្រឆាំង នឹង ការផ្ទុះ ឡើងវិញ នៃ ការឆ្លង ជំងឺ COVID-19 ក្នុង សហគមន៍ នៅក្នុង ទីក្រុង ជាច្រើន រួមទាំង មជ្ឈមណ្ឌល ឧស្សាហកម្ម សំខាន់ ៗ នៅ ភាគ ខាងកើត និង ភាគ ខាងត្បូង ប្រទេស ផងដែរ ។
ជុំវិញ បញ្ហា នេះ រដ្ឋាភិបាល ក្នុង តំបន់ បាន ប្រកាស ជូនដំណឹង ថា ទីក្រុង Xi'an ក៏ បាន ដាក់ចេញ នូវ វិធានការរឹតត្បឹត មួយចំនួន ដោយ បញ្ជា ឱ្យ បិទ សាលារៀន និង កន្លែង កម្សាន្ត ដែល ស្ថិត នៅ កន្លែង បិទ ជិត ធំ ៗ រួមទាំង បាន លើកទឹកចិត្ត ប្រជាជន ឱ្យ ចៀសវាង ការចេញ ទៅ ក្រៅ និង ការជួបជុំគ្នា ជា ក្រុម ធំ ៗ ផងដែរ ៕
ប្រធានាធិបតី វៀតណាម ចូលរួម ព្រះរាជ ពិធី លៀង សាយ ភោជន៍ ផ្លូវ រដ្ឋ ដែល រៀបចំ ដោយ ព្រះមហាក្សត្រ កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ ព្រលប់ ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២១ នេះ លោក ង្វៀង ស៊ួន ហ្វុក ប្រធានាធិបតី វៀតណាម បាន អញ្ជើញ ចូលរួម ពិធី លៀង សាយ ភោជន៍ ផ្លូវ រដ្ឋ ដែល រៀបចំឡើង ដោយ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី នៅ ព្រះបរម រាជ វាំង ដើម្បី ស្វាគមន៍ ចំពោះ ដំណើរទស្សនកិច្ច ផ្លូវ រដ្ឋ របស់ ប្រធានាធិបតី វៀតណាម ។
ពិធី នេះ ក៏ មាន ការចូលរួម ដោយ ថ្នាក់ដឹកនាំ កំពូល ៗ របស់ កម្ពុជា រួមទាំង ថ្នាក់ដឹកនាំ វៀតណាម ដែល បាន អម ដំណើរទស្សនកិច្ច របស់ លោក ប្រធានាធិបតី វៀតណាម ផងដែរ ។
សូម បញ្ជាក់ ថា ប្រធានាធិបតី វៀតណាម បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ មកដល់ ប្រទេស កម្ពុជា នៅ ម៉ោង ៨៖៣០ នាទី ព្រឹក ថ្ងៃអង្គារ នេះ ។ បន្ទាប់ពី បាន មកដល់ កម្ពុជា នៅ ព្រឹក មិញ នេះ លោក ង្វៀន សួន ហ៊្វុក បាន ចូល ក្រាប បង្គំ គាល់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ហើយ បន្ត ចូល គាល់ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ផងដែរ ។
អភិបាល ខេត្ត ពោធិ៍សាត់ បញ្ជា ដាច់ខាត មិន ឱ្យ មន្ត្រី ណា ម្នាក់ យក លុយ ប្រចាំ ខែ ពី បទល្មើស គ្រប់ ប្រភេទ . ករណី បើ មាន បុគ្គល ណា ប្រព្រឹត្ត ត្រូវ អនុវត្ត ច្បាប់ ពុំ មាន ការលើកលែង ឡើយ
( ពោធិ៍សាត់ )៖ លោក ជា វ តាយ អភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត បាន ដាក់ បទបញ្ជា យ៉ាង ដាច់ ណាត់ គឺ មិន ឱ្យ មន្ត្រី ណា ម្នាក់ យក លុយ ប្រចាំ ខែ ពី បទល្មើស ជល ផល ឬ បទល្មើស គ្រប់ ប្រភេទ នោះ ឡើយ ក្នុង ករណី បើ មាន បុគ្គល ណា ប្រព្រឹត្ត ត្រូវ អនុវត្ត តាម ច្បាប់ ដោយ ពុំ មាន ការលើកលែង ។
ការដាក់ បញ្ជា បែប នេះ របស់ លោក អភិបាល ខេត្ត បាន ធ្វើឡើង នា ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២១ នៅក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ប្រចាំ ខែវិច្ឆិកា ឆ្នាំ ២០២១ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក អភិបាល រង ខេត្ត ប្រធាន សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត នាយក នាយក រង រដ្ឋបាល សាលា ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ អភិបាល ក្រុង ស្រុក និង មន្ត្រី ចំណុះ ឱ្យ រដ្ឋបាល ខេត្ត មួយចំនួន ទៀត ។
ជាមួយគ្នា នេះ ក៏ មាន សេចក្តីរាយការណ៍ របស់ អង្គភាព នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត លោក អភិបាល ស្រុក ក្រុង ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត ដែល បាន លើកឡើង អំពី ច្បាប់ ចរាចរណ៍ ផ្លូវគោក បញ្ហា គ្រឿងញៀន គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព និង សភាពការណ៍ សន្តិសុខ តាម ព្រំដែន ។
មានប្រសាសន៍ បូកសរុប លោក ជា យ តាយ បាន ដាក់ចេញ នូវ ផែនការ សកម្មភាព សំខាន់ ៗ ចំនួន ៨ចំណុច ធំ ៗ សម្រាប់ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ស្រុក ក្រុង យក ទៅ បន្ត អនុវត្តន៍ រួម មាន៖
ទន្ទឹមនឹង នេះ ត្រូវ មាន ទីកន្លែង ត្រួតពិនិត្យ ច្បាប់ ចរាចរណ៍ ឱ្យ បាន ច្បាស់លាស់ ត្រឹមត្រូវ និង ត្រូវ បន្ត អនុវត្ត ចំពោះ បទល្មើស ជាក់ស្តែង តែ បើ គ្មាន បទល្មើស ទេ នោះ សូម កុំ ហៅ ឬ ឃាត់ទុក ដែល នាំឱ្យ ប៉ះពាល់ ដល់ អារម្មណ៍ អ្នកធ្វើដំណើរ ៕
កម្លាំង នគរបាល ឃាត់ខ្លួន មេ ខ្យល់ ម្នាក់ ដែល សកម្ម នាំ ពលករ ឆ្លង ដែន ខុសប ច្បាប់ នៅ ខេត្ត ឧត្តរមានជ័យ
( ឧត្តរមានជ័យ )៖ មេខ្យល់ ម្នាក់ ដែល តែង នាំ ពលករ លួច ឆ្លង ដែន ខុស ច្បាប់ ចូល ទៅក្នុង ប្រទេស ថៃ ត្រូវបាន កម្លាំង នគរបាល ការពារ ព្រំដែន គោក លេខ ៧០២ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ឧត្តរមានជ័យ ធ្វើ ការឃាត់ខ្លួន ដើម្បី ចាត់ការ ទៅតាម ច្បាប់ ។
មន្ត្រី នគរបាល ព្រំដែន គោក បាន ថ្លែង ឲ្យដឹង ថា ក្រោម បទបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ទោ ហួត សុធី ស្នងការ នគរបាល ខេត្ត ឧត្តរមានជ័យ និង លោក ឧត្ដមសេនីយ៍ ត្រី ហង្ស បូរ ស្នងការ រង ផែន នគរបាល ការពារ ព្រំដែន គោក នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កម្លាំង នគរបាល បាន ចុះល្បាត ជាប់ ជាប្រចាំ ២៤ ម៉ោង លើ ២៤ ម៉ោង ដោយ ប្តូរ វេន គ្នា ដើម្បី ទប់ស្កាត់ ពលករ លួច ឆ្លង ដែន ខុស ច្បាប់ ។
ជាក់ស្តែង នៅ នៅ ថៃ្ង ទី២០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ នៅ ចំណុច គោលដៅ លេខ ១៧ ច្រក របៀង អូរ ខ្លាឃ្មុំ ស្ថិត ក្នុង សង្កាត់ អូរ ស្មាច់ ក្រុង សំរោង កម្លាំង នគរបាល ការពារ ព្រំដែន គោក លេខ ៧០២ បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ឈ្មោះ ភោគ ណារិទ្ធ ( ហៅ ខ្លឹង ) អាយុ ៥៤ ឆ្នាំ ជា មុខសញ្ញា មេក្លោង នាំ ពលករ ឆ្លង ដែន ខុស ច្បាប់ យ៉ាង សកម្ម មាន ទីលំនៅ ភូមិ អូរ ខ្លាឃ្មុំ សង្កាត់ អូរ ស្មាច់ ក្រុង សំរោង ខេត្ត ឧត្ដរ មានជ័យ ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន កម្លាំង ជំនាញ នាំ ខ្លួន មកកាន់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ដើម្បី សាកសួរ និង កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
សាលា រាជធានី ភ្នំពេញ ចេញ ប្រកាស ព័ត៌មាន បង្ហាញ លទ្ធផល នៃ កិច្ចប្រជុំ រក ដំណោះស្រាយ វិវាទ ការងារ របស់ ក្រុមហ៊ុន ណាហ្គាវើលដ៍
ខាងក្រោម នេះ ជា ខ្លឹមសារ លម្អិត នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន៖
លោក ង្វៀង សួន ហ៊្វុក អញ្ជើញ សម្តេច ប្រធាន ព្រឹទ្ធសភា កម្ពុជា ទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស វៀតណាម
នៅក្នុង ឱកាស នោះ លោក ង្វៀង សួន ហ៊្វុក បាន លើកឡើង ថា ប្រជាជន និង ប្រទេស ទាំង ពីរ បាន ប្រគៀក ស្មា និង សហការ គ្នា យ៉ាង ល្អ ប្រសើរ ដើម្បី រួមគ្នា តស៊ូ ជាមួយ ពួក ចក្រពត្តិ ។ តាំងពី ពេល មុន រហូតមកដល់ ពេល បច្ចុប្បន្ន នេះ ប្រទេស ទាំង ពីរ បាន ពូន ជ្រុំ ទំនាក់ទំនង មិត្តភាព សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ យ៉ាង ល្អ ប្រពៃ និង កាន់តែ រីកចម្រើន ថែម ទៀត ។
លោក ង្វៀង សួន ហ៊្វុក បាន បន្ត ទៀត ថា ប្រទេស ទាំង ពីរ បាន ធ្វើ ការទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ល្អ លើ គ្រប់ វិស័យ ដូចជា វិស័យ ការពារ ជាតិ សន្តិសុខ វប្បធម៍ សេដ្ឋកិច្ច និង វិស័យ អប់រំ ។ល ។ ហើយ បច្ចុប្បន្ន នេះ ទំហំ ពិណិជ្ជកម្ម នៃ ប្រទេស ទាំង ពីរ មាន ការកើនឡើង ជាលំដាប់ ដោយ សម្រេចបាន ប្រហែល ជាង ៩ ពាន់ លាន ដុល្លារ អាមេរិក ។
បន្ថែម ពី នេះ លោក សង្ឃឹម ថា នា ពេល ខាងមុខ នេះ ប្រទេស ទាំង ពីរ នឹង បន្ត ពង្រឹង ពង្រីក ទំនាក់ទំនង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ប្រពៃ ដើម្បី ចាត់ទុក ជា មរតក ឱ្យ យុវវ ជន ជំនាន់ ក្រោយ ។
ក្នុង នាម ប្រជាជន និង ព្រឹទ្ធសភា កម្ពុជា សម្តេច ប្រធាន ព្រឹទ្ធសភា បាន សម្តែង នូវ មនោសញ្ចេតនា សប្បាយរីករាយ និង ស្វាគមន៍ ដ៏ កក់ក្តៅ ចំពោះ លោក ង្វៀន សួន ហ៊្វុក និង គណៈប្រតិភូ ជាន់ ខ្ពស់ ដែល បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច ជា ផ្លូវ រដ្ឋ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ។
សម្តេច ប្រធាន ព្រឹទ្ធសភា សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ មាន ជំនឿ ជឿជាក់ ថា តាមរយៈ ដំណើរទស្សនកិច្ច របស់ លោក ប្រធាន រដ្ឋ នា ពេលនេះ ពិតជា នឹង នាំមក នូវ ការ ពង្រឹង និង ពង្រីក នូវ ចំណង សាមគ្គីភាព មិត្តភាព និង កិច្ចសហប្រិតបត្តិការ រវាង ប្រជាជន និង ប្រទេស ទាំង ពីរ ដែល មាន តាំ បី យូរ លង់ ណាស់ មកហើយ ។
សម្តេច ប្រធាន ព្រឹទ្ធសភា បាន សម្តែង នូវ ការអបអរសាទរ ចំពោះ សមិទ្ធផល ដ៏ មហាសាល របស់ បក្ស រដ្ឋាភិបាល និង ប្រជាជន វៀតណាម ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ បក្ស កុម្មុយនីស្ត វៀតណាម ។
( ភ្នំពេញ ) ៖ វេលា ម៉ោង ប្រមាណ ១០៖ ៤០ នាទី ថ្ងៃទី ១៩ ខែធ្នូ ឆ្នាំ ២០២១ ផ្ទះ អ្នកលក់ ឡេ អនឡាញ អ៊ាន សៀវ ម៉ី ត្រូវបាន ក្រុម ចោរ មួយ ក្រុម មាន គ្នា ៥នាក់ ស្លៀកពាក់ ឯកសណ្ឋាន សមត្ថកិច្ច កាន់ ដីកា បង្គាប់ ឲ្យ នាំ ខ្លួន បន្លំ ចូល ចាប់ខ្លួន អ្នកលក់ ឡេ អនឡាន ល្បី ឈ្មោះ អ៊ាន សៀវ ម៉ី ហើយ ធ្វើ សកម្មភាព ប្លន់ តែម្តង ។ ក្រោយ ពួក ចោរ បាន ចាកចេញ ប្រមាណ ៧នាទី ប្អូន ប្រុស របស់ អ៊ាន សៀវ ម៉ី បាន ហៅទូរស័ព្ទ មកកាន់ លេខ ១២៩១ របស់ អាវុធហត្ថ រាជធានី ភ្នំពេញ ដើម្បី សុំ ការអន្តរាគមន៍ ។
ព្រឹក ស្អែក រាជ បណ្ឌិត្យ សភា កម្ពុជា នឹង រៀបចំ សន្និសីទ អន្តរជាតិ ស្ដីពី « តួនាទី របស់ ចិន ក្នុង សតវត្សរ៍ ទី ២១ និង ទំនាក់ទំនង របស់ ចិន ជាមួយ អាស៊ាន »
( ភ្នំពេញ ) ៖ វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា នឹង រៀបចំ សន្និសីទ អន្តរជាតិ ស្ដីពី « តួនាទី របស់ ចិន ក្នុង សតវត្សរ៍ ទី ២១ និង ទំនាក់ទំនង របស់ ចិន ជាមួយ អាស៊ាន » នៅ ព្រឹក ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២១ ស្អែក នេះ តាម ទម្រង់ កូន កាត់ ។
សម្រាប់ វិគ្មិន នៅក្នុង សន្និសីទ សារព័ត៌មាន នឹង មាន អញ្ជើញ ចូលរួម ពីសំណាក់ លោក បណ្ឌិត សភាចារ្យ សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា . លោក បណ្ឌិត គិន ភា ប្រធាន នៃ វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា . លោក CHANG Jian អគ្គ ទីប្រឹក្សា នៃ ស្ថានទូត នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា . លោក បណ្ឌិត យង់ ពៅ អគ្គ លេខាធិការ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ព្រមទាំង វិគ្មិន ដែល ជា អ្នកជំនាញ ជាតិ និង អន្តរជាតិ ជាច្រើន រូប ផងដែរ ។
សន្និសីទ នេះ នឹង រៀបចំឡើង លើ កិច្ចពិភាក្សា វគ្គ ទី១៖ « គំរូ នៃ ការអភិវឌ្ឍ របស់ ប្រទេស ចិន និង ការជំរុញ នៃ គំរូ នេះ ចំពោះ ប្រទេស ផ្សេង ៗ នៅ តំបន់ អាស៊ាន » ។ កិច្ចពិភាក្សា វគ្គ ទី២៖ « ទំនាក់ទំនង ចិន អាស៊ាន ការប្រឈម ឱកាស និង ទស្សនវិស័យ » ។
បន្ថែម ពី នេះ ប្រធានបទ ដែល ត្រូវ ពិភាក្សា រួម មាន៖
អាជ្ញាធរ ខេត្ត សៀមរាប រៀបចំ ពិធី បួងសួង សុំ សេចក្តីសុខ ដល់ ពលរដ្ឋ ក្នុង ខេត្ត
លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប និង លោក អ៊ាន ឃុន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន បូជា ថ្វាយ ទៀន ធូប ផ្កា ភ្ញី និង បួងសួង ដល់ វត្ថុ ស័ក្តិសិទ្ធ គ្រប់ ទិសទី នៅក្នុង តំបន់ សម្បត្តិ បិតិក ភ័ណ្ឌ ជាតិ ដែល ដូនតា បាន បន្សល់ទុកឲ្យ កូន ជំនាន់ ក្រោយ ថែរក្សា ទៅ តាម ទំនៀមទំលាប់ បែប សាសនា ។ ក្នុង នោះ ក៏ មាន កម្មវីធី សូត្រ មន្ត ចម្រើន ព្រះបរិត្ត ស្វា ធាយ ធម៍ ប្រោះ ព្រំ សុំ សិរី សួស្តី ជ័យ មង្គល វិមុល សុខ គ្រប់ ប្រការ ដល់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស នឹង ប្រគេន នៅ ទេយ្យ ទាន ចំពោះ ព្រះសង្ឃ ផងដែរ ។
ពិធី បួងសួង នេះ ក្នុង គោលបំណង ដើម្បីឲ្យ ប្រជាជន កម្ពុជា ទូទាំង ប្រទេស ក៏ ដូចជា ប្រជាជន ដែល រស់ នៅក្នុង ខេត្ត សៀមរាប ចាប់ពី ពេលនេះ តទៅ ខេត្ត សៀមរាប អាចនឹង វិលត្រឡប់ ទៅ រក សភាព ដើម វិញ ហើយ ខេត្ត សៀមរាប ក៏ ជា ខេត្ត មួយ ដែល កំពុងតែ កែប្រែ មុខមាត់ ថ្មី ស្រប ពេល ដែល ជំងឺ កូវីដ - ១៩ បាន ស្ងប់ស្ងាត់ ។ ការប្រារព្ធ ពិធី នេះ ឡើង បាន ដោយសារតែ ប្រទេស កម្ពុជា គោរព និង ប្រណិបត្តិ នូវ ព្រះពុទ្ធ សាសនា ជា សាសនា របស់ រដ្ឋ ដើម្បី ថែរក្សា ការពារ វិស័យ ព្រះពុទ្ធ សាសនា ឱ្យ កាន់តែ មាន ភាពរុងរឿង នឹង រីកចំរើន ជាដរាប ។
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២១ ខែ ធ្នូ៖ បង្ក្រាប ២៥ ករណី ឃាត់ខ្លួន ៥៨ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៥ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៧ករណី និង ជួញដូរ ១៨ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥៨ នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន ថ្លែងអំណរគុណ ប្រធានាធិបតី វៀតណាម ដែល គាំទ្រ កម្ពុជា ធ្វើ យ៉ាងណា ឱ្យ ទទួល ជោគជ័យ ក្នុង កិច្ចប្រជុំ អាស៊ាន ឆ្នាំ ក្រោយ
ការលើកឡើង របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅក្នុង ជំនួប កំពូល នៅ វិមាន សន្តិភាព នា ព្រឹក ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស ដែល លោក ង្វៀង ស៊ួន ហ្វុក មក បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ រយៈពេល ២ ថ្ងៃ នៅក្នុង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២១ - ២២ ខែធ្នូ ឆ្នាំ ២០២១ ។
លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ទៀត ថា សម្តេច ក៏ បាន ថ្លែងអំណរគុណ លោក ង្វៀង ស៊ួន ហ្វុក ដែល កន្លងមក គាំទ្រ និង ជួយ ដល់ កម្ពុជា ធ្វើឱ្យ កម្ពុជា ជោគជ័យ ក្នុង ការរៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ី - អឺរ៉ុប (ASEM) លើក ទី ១៣ ។
ប្រទេស កម្ពុជា នឹង ធ្វើជា ប្រធាន ប្តូរ វេន របស់ អាស៊ាន នៅ ឆ្នាំ ២០២២ ខាងមុខ នេះ ។ ជាមួយនឹង តួនាទី ដ៏ សំខាន់ នេះ អាស៊ាន បាន លេចឡើង នូវ បញ្ហា ជាច្រើន ក្នុង នោះ មាន បញ្ហា មីយ៉ាន់ម៉ា និង ការប្រកួតប្រជែង លើ ភូមិសាស្រ្ត នយោបាយ នៃ ប្រទេស មហា អំណាច ផងដែរ ។
សម្រាប់ បញ្ហា មីយ៉ាន់ម៉ា កម្ពុជា ដែល ធ្លាប់ មាន បទពិសោធន៍ ក្នុង ការដោះស្រាយ បញ្ហា នេះ បាន បញ្ជាក់ ជាមុន ថា នឹង ខិតខំ ជួយ សម្របសម្រួល ប៉ុន្តែ ការដោះស្រាយ បាន ឬ មិន បាន នោះ គឺ អាស្រ័យ លើ មីយ៉ាន់ម៉ា ខ្លួន ឯង ផ្ទាល់ តែម្តង ។
នៅក្នុង សន្នីសីទ សារព័ត៌មាន នៅ ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០២១ អ្នកនាំពាក្យ ក្រសួង ការបរទេស វៀតណាម លោកស្រី Lê Thị Thu Hằng បាន លើកឡើង ថា វៀតណាម គាំទ្រ កម្ពុជា ក្នុង ការបំពេញ តួនាទី ជា ប្រធាន អាស៊ាន ក្នុង ឆ្នាំ ២០២២ ខាងមុខ នេះ ខណៈ ដែល កម្ពុជា មាន បំណង ចូលរួម ដោះស្រាយ ដោះស្រាយ បញ្ហា មីយ៉ាន់ម៉ា និង ដើម្បី ពង្រឹង មជ្ឈភាព អាស៊ាន ៕
ប្រធានាធិបតី វៀតណាម បន្ត ចូល ជួប សម្តែង ការគួរសម ជាមួយ ប្រធាន ព្រឹទ្ធសភា កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ជិត ៤រសៀល ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២១ នេះ លោក ង្វៀង ស៊ួន ហ្វុក ប្រធានាធិបតី វៀតណាម បាន បន្ត ចូល ជួប សម្តែង ការគួរសម ជាមួយ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា កម្ពុជា បន្ទាប់ពី បាន ដាក់ កម្រង ផ្កា នៅ វិមាន ឯករាជ្យ និង គោរព វិញ្ញាណក្ខន្ធ ព្រះបរម រតន កោដ្ឋ ។
ប្រធានាធិបតី វៀតណាម បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ មកដល់ ប្រទេស កម្ពុជា នៅ ម៉ោង ៨៖៣០ នាទី ព្រឹក ថ្ងៃអង្គារ នេះ ។ នៅ ព្រឹក មិញ នេះ បន្ទាប់ពី បាន មកដល់ កម្ពុជា លោក ង្វៀន សួន ហ៊្វុក បាន ចូល ក្រាប បង្គំ គាល់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ហើយ បន្ត ចូល គាល់ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ផងដែរ ។
សូម បញ្ជាក់ ថា ប្រធានាធិបតី វៀតណាម បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ មកដល់ ប្រទេស កម្ពុជា នៅ ម៉ោង ៨៖៣០ នាទី ព្រឹក ថ្ងៃអង្គារ នេះ ។ ក្នុង អំឡុង ពេល ទស្សនកិច្ច ផ្លូវ រដ្ឋ នេះ លោក ង្វៀន សួន ហ៊្វុក មាន កម្មវិធី ចូល ក្រាប បង្គំ គាល់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ហើយ បន្ត ចូល គាល់ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ។
លោក ង្វៀន សួន ហ៊្វុក នឹង មាន ជំនួប ដោយឡែក ពី គ្នា ជាមួយ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក ប្រធាន រដ្ឋ នឹង អញ្ជើញ ធ្វើជា អធិបតី ជាមួយ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ក្នុង ពិធី បញ្ចុះ បឋមសិលា សាងសង់ អាគារ រដ្ឋបាល ថ្មី នៅក្នុង វិមាន រដ្ឋសភា និង ជាមួយ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន ក្នុង ពិធី ចុះហត្ថលេខា លើ ឯកសារ សំខាន់ ៗ មួយចំនួន ផងដែរ ៕
លោក ង្វៀន សួន ហ្វ៊ុក បន្ត អញ្ជើញ ថ្វាយ កម្រង ផ្កា គោរព ព្រះវិញ្ញាណក្ខន្ធ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហនុ ព្រះបរម រតន កោដ្ឋ នៅ មណ្ឌ ប ព្រះបរម រូប
លោក ប្រធាន រដ្ឋ នឹង អញ្ជើញ ធ្វើជា អធិបតី ជាមួយ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ក្នុង ពិធី បញ្ចុះ បឋមសិលា សាងសង់ អាគារ រដ្ឋបាល ថ្មី នៅក្នុង វិមាន រដ្ឋសភា និង ជាមួយ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន ក្នុង ពិធី ចុះហត្ថលេខា លើ ឯកសារ សំខាន់ ៗ មួយចំនួន ផងដែរ ៕ រដ្ឋបាល ខេត្ដ កណ្តាល ប្រគល់ ថវិកា ចំនួន ៥២២. ៤៥៧.០០០ រៀល និង ១. ១៥០ ដុល្លារ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា
ពិធី ប្រគល់ ថវិកា នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន ក្រុមប្រឹក្សា បរធន បាល នៃ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា នៅ ទីស្តីការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន បាន ថ្លែងអំណរគុណ និង អរគុណ ចំពោះ រដ្ឋបាល ខេត្ត កណ្តាល ដែល បាន ចូលរួម បរិច្ចាគ ថវិកា ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ស្ថាបនិក និង ជា ប្រធាន កិត្តិយស សំដៅ ធានា កិច្ច ដំណើរការ របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ប្រព្រឹត្តិ ទៅ ដោយ រលូន បន្ត ទៀត ។
សូម ជម្រាប ថា មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ត្រូវបាន បង្កើតឡើង ក្រោម គំនិត ផ្តួចផ្តើម របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិតិ្ត ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក្នុង ទស្សនវិស័យ កុមារ ជា អនាគត ដ៏ ភ្លឺស្វាង របស់ កម្ពុជា នៅតែ ទទួលបាន ការពិនិត្យ និង ព្យាបាល ជំងឺ ដោយ ឥត គិត ថ្លៃ នៅ មន្ទីរពេទ្យ គន្ធ បុប្ផា ទាំង ០៥ ទីតាំង នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា តាមរយៈ ការចូលរួម បរិច្ចាគ ពី សប្បុរសជន នានា ទាំង ក្នុង និង ក្រៅ ប្រទេស ។
ពាក្យស្លោក នៃ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា គឺ « ភាពញញឹម របស់ កុមារ គឺជា អនាគត ដ៏ ភ្លឺស្វាង របស់ កម្ពុជា ការចូលរួម បរិច្ចាគ របស់ ឯកឧត្តម លោកជំទាវ លោក លោកស្រី អ្នកនាង កញ្ញា ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា គឺជា កាយវិការ ដ៏ សប្បុរស ដែល នឹង រួមចំណែក ក្នុង ការព្យាបាល និង ជួយសង្គ្រោះ កុមារ កម្ពុជា រាប់ លាន នាក់ »៕
ឯក អគ្គ រដ្ឋទូត ឥណ្ឌូណេស៊ី ប្រចាំ កម្ពុជា និង ប្រតិភូ ចុះ ស្វែងយល់ ពី សក្តានុពល របស់ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា ថ្លែង ថា ផ្ដើម ចេញ ពី កត្តា ភូមិសាស្រ្ត និង កត្តា វិទ្យាសាស្រ្ត ធ្វើឲ្យ ខេត្ត កំពង់ចាម ប្រៀប បាន ទៅនឹង គ្រាប់ ពេជ្រ មិន ទាន់ កែច្នៃ ហើយ កំពុង រង់ចាំ អ្នក វិនិយោគ ជាច្រើន ចូលមក បណ្ដាក់ទុន ។
ឆ្លើយតប ទៅនឹង ការស្វែងយល់ អំពី សក្តានុពល ក្នុង ខេត្ត កំពង់ចាម របស់ ឯក អគ្គ រដ្ឋទូត ឥណ្ឌូនេស៊ី ប្រចាំ កម្ពុជា . លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ថា បច្ចុប្បន្ន កម្ពុជា កំពុង មាន សុខ សន្តិភាព ពេញលេញ មាន ស្ថេរភាព នយោបាយ ល្អ ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ដែល ជា ឱកាស ដើម្បី យើង ធ្វើ ការអភិវឌ្ឍន៍ ផ្សេង ៗ ។
លោក អភិបាល ខេត្ត បន្ត ថា « សម្រាប់ សក្តានុពល ខេត្ត កំពង់ចាម គឺ មិន ខុសគ្នា នឹង បណ្ដា ខេត្ត ផ្សេង ៗ នោះ ទេ គ្រាន់តែ ខេត្ត នេះ មាន ធនធាន មនុស្ស ច្រើន និង មាន ភូមិសាស្ត្រ ជាប់ ដង ទន្លេ មេគង្គ នៅជិត រាជធានី ភ្នំពេញ ហើយក៏ ជា តំបន់ កណ្ដាល ផ្សាភ្ជាប់ តំបន់ សេដ្ឋកិច្ច ផ្សេង ៗ ទៀត ដែល ឆ្លងកាត់ » ។
បើ តាម លោក អភិបាល ខេត្ត បច្ចុប្បន្ន ខេត្ត កំពង់ចាម មាន រោងចក្រ កាត់ដេរ ចំនួន ១៧កន្លែង កំពុង ផ្ដល់ ការងារ ដល់ ប្រជាពលរដ្ឋ ជាង ៣ម៉ឺន នាក់ និង កំពុង ដំណើរការ យ៉ាង ល្អ មាន ចំការ កៅស៊ូ ដែល មាន ដី ដែល មាន ជីជាតិ និង ប្រភព ទឹក គ្រប់គ្រាន់ សម្រាប់ ប្រជាពលរដ្ឋ ធ្វើ ការដាំដុះ ដំណាំ ផ្សេង ៗ ដើម្បី ផ្គត់ផ្គង់ នៅក្នុង ស្រុក ផង និង នាំចេញ ទៅ ក្រៅ ប្រទេស ផងដែរ ធ្វើឲ្យ ប្រជាពលរដ្ឋ មាន ជីវភាព ប្រសើរឡើង ជាលំដាប់ ។
ម្យ៉ាងទៀត ផ្ដើម ចេញ ពី កត្តា ភូមិសាស្រ្ត និង កត្តា វិទ្យាសាស្រ្ត ដែល ធ្វើឲ្យ ខេត្ត កំពង់ចាម ជា ខេត្ត មួយ ប្រៀប បាន ទៅនឹង គ្រាប់ ពេជ្រ ដែល មិន ទាន់ ច្នៃ និង រង់ចាំ អ្នក វិនិយោគ ជាច្រើន ចូលមក បណ្ដាក់ទុន ។ ទន្ទឹមនឹង នេះ អាជ្ញាធរ ខេត្ត បាន ផ្ដល់ លក្ខណៈ ងាយស្រួល ទាំង ការងារ សន្តិសុខ សណ្ដាប់ធ្នាប់ ការរក្សា ឲ្យបាន នូវ របៀបរបប ធ្វើ ការងារ និង ការផ្ដល់ សេវា រដ្ឋបាល ផ្សេង ៗ ជូន ប្រជាពលរដ្ឋ ក៏ ដូចជា អ្នក វិនិយោគ ជា ទី ពេញចិត្ត ផងដែរ ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក អ៊ុន ចាន់ ដា៕
ក្រុម កាងារ អន្តរ ក្រសួង និង អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ ចុះ វាស់វែង ក្បាល ដី ដែល ប៉ះពាល់ ជាមួយ គម្រោង សាងសង់ ស្ថានីយ ជញ្ជីង ថ្លឹង យានយន្ត អចល័ត ក្នុង សង្កាត់ និមិត្ត ក្រុង ប៉ោយប៉ែត
លោក លី សារី បាន លើកឡើង ថា បន្ទាប់ពី ពិភាក្សា ជជែកគ្នា រវាង ក្រុមការងារ និង អ្នក ពាក់ព័ន្ធ ទំនាស់ បាន ធ្វើឲ្យ ក្រុមការងារ ទទួលបាន ធាតុ ចូល ថ្មី ៗ បន្ថែម ទៀត ដែល ជា លទ្ធផល ល្អ សម្រាប់ ជា ជំនួយ ដល់ យន្តការ ឈាន ទៅរក ការដោះស្រាយ បញ្ហា នេះ ផងដែរ ។
ជាមួយគ្នា នេះ លោក លី សារី បាន បញ្ជាក់ ថា សម្រាប់ លទ្ធផល នៃ កិច្ចប្រជុំ និង សកម្មភាព ចុះ វាស់វែង ជាក់ស្តែង ក្រុមការងារ ទទួលបាន៖
ជន ពិការ ក្រីក្រ នៅ តាម សហគមន៍ ចំនួន ៦២៤ នាក់ ក្នុង ខណ្ឌ ព្រែក ព្នៅ ទទួលបាន របប គោល នយោបាយ ពី រាជ រដ្ឋាភិបាល
( ភ្នំពេញ ) ៖ ជន ពិការ ក្រីក្រ ចំនួន ៦២៤ នាក់ រស់ នៅក្នុង ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ ទទួលបាន របប គោល នយោបាយ ពី រាជ រដ្ឋាភិបាល ។ នេះ បង្ហាញ ឲ្យ ឃើញ ថា ជា ការខិតខំ ប្រឹងប្រែង យកចិត្ត ទុក្ខ ដាក់ ខ្ពស់ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការលើកកម្ពស់ កម្រិត ជីវភាព រស់ នៅ និង គុណភាព ជីវិត របស់ បងប្អូន ជន មាន ពិការភាព ។
រដ្ឋមន្រ្តី អ៊ុក រ៉ាប៊ុន ចុះ ចែក អាវ រងារ ដល់ មនុស្ស ចាស់ ៗ ក្នុង ឃុំ ទាំង៩ ក្នុង ស្រុក សាមគ្គី មាន ជ័យ
នៅក្នុង ពិធី នេះ លោក បណ្ឌិត សុភាចារ្យ អ៊ុក រ៉ាប៊ុន បាន លើកឡើង ថា ឆ្លងកាត់បរិបទ ជំងឺ កូវីដ១៩ ជា ជម្ងឺ រាតត្បាត នៅក្នុង ប្រទេស កម្ពុជា កន្លងមក នេះ ធ្វើឲ្យ ប្រជាពលរដ្ឋ យើង និង កម្មករ កម្មការិនី មួយចំនួន បាត់បង់ ការងារ បាត់បង់ មុខរបរ ចិញ្ចឹម ជីវិត ព្រោះតែ ខ្លាច ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ។
ក្នុង សភាពការណ៍ នេះ ប្រមុខ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ វិធានការ ទប់ស្កាត់ ការរាលដាល ឆ្លង ជំងឺ កូវីដ១៩ គឺ « ៣កុំ និង ៣ការពារ » ។ ជាមួយគ្នា នេះ នៅក្នុង តំបន់ បិទ ខ្ទប់ ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ១៩ ក៏ បាន ទទួល អំណោយ សង្គ្រោះ ពី ប្រមុខ រាជ រដ្ឋាភិបាល មាន ស្បៀងអាហារ ថវិកា និង ម៉ាស់ អាកុល ជែល ពិសេស គឺ ការចាក់ វ៉ាក់សាំង ការពារ ជូន ដល់ ប្រជាពលរដ្ឋ យើង ផងដែរ ។
ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ខាង លើ នេះ សម្ដេច តេជោ នាយក មន្ត្រី បាន ខិតខំ ខ្នះ ខ្នែង ស្វះស្វែង ទិញ វ៉ាក់សាំង ចាក់ ជូន ប្រជាពលរដ្ឋ ជិត ៩០ ភាគរយ ក្នុង ចំំណោម ប្រជាជន ១៦លាន នាក់ បាន ចាក់ វ៉ាក់សាំង ។ ការខ្នះ ខ្នែង ជួយសង្គ្រោះ ជីវិត ប្រជាពលរដ្ឋ ខាងលើ នេះ គឺជា សំណាង ប្រជាពលរដ្ឋ កម្ពុជា យើង ខណៈ ដែល នៅលើ ពិភពលោក ប្រទេស មួយចំនួន គ្មាន វ៉ាក់សាំង ចាក់ ដូច នៅ កម្ពុជា ឡើយ និង បច្ចុប្បន្ន នេះ ប្រជាពលរដ្ឋ ទាំងនោះ កំពុង រងគ្រោះ ឆ្លង និង ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ ជារៀងរាល់ ថ្ងៃ ។
ក្រោយពី ទប់ស្កាត់ ជំងឺ កូវីដ១៩ បាន ជោគជ័យ ប្រមុខ រាជ រដ្ឋាភិបាល ក៏ បាន ប្រកាស បើក ប្រទេស ឡើងវិញ ហើយ កាលពី ថ្ងៃទី ១៨ ខែធ្នូ សម្ដេច តេជោ បាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ពហុកីឡដ្ឋាន មរតក តេជោ នៅ ទីក្រុង ភ្នំពេញ និង កាលពី ថ្ងៃទី ២០ ខែធ្នូ នេះ សម្ដេច តេជោ បាន ប្រកាស បិទ ព្រឹត្តិការណ៍ សហគមន៍ កុម្ភៈ ២០ ដែល ក្នុង ព្រឹត្តិការណ៍ នេះ ជម្ងឺ កូវីដ១៩ បាន ឆ្លង មក ប្រជាពលរដ្ឋ ក្នុង កម្ពុជា សរុប ចំនួន ១៤. ៤០២៣ នាក់ និង ស្លាប់ សរុប ចំនួន ៣. ០០៥ នាក់ ។
ដោយឡែក តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ នៅក្នុង ខែរងា នេះ លោក បណ្ឌិត សុភាចារ្យ អ៊ុក រ៉ាប៊ុន ក៏ បាន ទិញ អាវ រងា ចែកជូន ដល់ មេឃុំ ទាំង៩ នៅក្នុង ស្រុក សាមគ្គី មាន ជ័យ ដើម្បី ចែកចាយ ជូន ដល់ មនុស្ស វ័យ ចំណាស់ ៗ នៅ គ្រប់ មូលដ្ឋាន ដែល គាត់ មាន សុខភាព មិន ល្អ អាចនឹង មាន ជំងឺ ផ្ដាសាយ ដែល នេះ គឺជា ការគិតគូ និង យកចិត្តទុកដាក់ របស់ សម្ដេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល របស់ យើង ។
