( ភ្នំពេញ ) ៖ លោកស្រី កិត្ដិ សង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង ដែល ត្រូវ ជា ឪពុក ក្មេក របស់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ លោកស្រី សូម សម្តែង នូវ ការសោកស្តាយ ស្រណោះ អាឡោះអាល័យ ជា ទីបំផុត ជាមួយ ក្រុមគ្រួសារ នៃ សព ព្រោះ ការបាត់បង់ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ផឹង គឹង គឺជា ការបាត់បង់ នូវ លោកឪពុក ជីតា ជីតា ទួត ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ល្អ ប្រពៃ ចំពោះ កូន ចៅ ជា ទីស្រឡាញ់ របស់ លោក កន្លងមក មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ តែងតែ រួមចំណែក លើកកម្ពស់ ដល់ វិស័យ ព្រះពុទ្ធ សាសនា នៅ កម្ពុជា យ៉ាង ច្រើន ពុំ អាច បំភ្លេច បាន ។
លោកស្រី សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ផឹង គឹង សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ កម្លាំង ចម្រុះ របស់ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ចុះ រុះរើ ខ្ទម សំណង់ ខុស ច្បាប់ ដែល រំលោភ យក ដី សម្បទាន សេដ្ឋកិច្ច ក្រោយ អប់រំ ច្រើន ដង តែ មិន ស្តាប់ អាជ្ញាធរ
( កំពង់ស្ពឺ ) ៖ កម្លាំង ចម្រុះ ដឹកនាំ ដោយ លោក សរ សុពុត្រា អភិបាល រង ខេត្ត កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ បាន ចុះ រុសរើ ខ្ទម សង់ លើ ដី សម្បទាន សេដ្ឋកិច្ច អេច អិល អេច ក្នុង ភូមិ ពោធិមាស ឃុំ ត្រពាំង ជោ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ។
លោក សរ សុពុត្រា អភិបាល រង ខេត្ត កំពង់ស្ពឺ បាន ឲ្យដឹង ថា កងកម្លាំង ចំរុះ មាន ចំនួន ៣៥០ នាក់ របស់ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បាន រុះរើ ខ្ទម សង់ ខុស ច្បាប់ ចំនួន ៨៥ខ្ទម ខណៈ អាជ្ញាធរ ភូមិ - ឃុំ បាន ធ្វើ ការអប់រំ បងប្អូន ប្រជាពលរដ្ឋ មិន ចង់ មាន ការតវ៉ា ដោយ អាជ្ញាធរ បាន ប្រាប់ ពួកគាត់ ពិតជា មក រស់ នៅ លើ ដី មាន កម្មសិទ្ធិ ជា ដី សម្បទាន សេដ្ឋកិច្ច របស់ ក្រុមហ៊ុន ។
( ភ្នំពេញ ) ៖ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង ដែល ត្រូវ ជា ឪពុក ក្មេក របស់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ លោក សូម សម្តែង នូវ ការសោកស្តាយ ស្រណោះ អាឡោះអាល័យ ជា ទីបំផុត ជាមួយ ក្រុមគ្រួសារ នៃ សព ព្រោះ ការបាត់បង់ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ផឹង គឹង គឺជា ការបាត់បង់ នូវ លោកឪពុក ជីតា ជីតា ទួត ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ល្អ ប្រពៃ ចំពោះ កូន ចៅ ជា ទីស្រឡាញ់ របស់ លោក កន្លងមក មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ តែងតែ រួមចំណែក លើកកម្ពស់ ដល់ វិស័យ ព្រះពុទ្ធ សាសនា នៅ កម្ពុជា យ៉ាង ច្រើន ពុំ អាច បំភ្លេច បាន ៕
កាល ថ្លែង របស់ សម្ដេច ពិជ័យ សេនា បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច បាន អញ្ជើញ ជា តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ពិធី អបអរសាទរ ខួប លើក ទី ២៣ ទិវា នយោបាយ ឈ្នះ ឈ្នះ និង ខួប៣ ឆ្នាំ ថ្ងៃ សម្ពោធ វិមាន ឈ្នះ ឈ្នះ នា ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ថ្លែង ដូចនេះ ថា « ជាមួយនឹង ការរីកចម្រើន ឥត ឈប់ឈរ នេះ ការប្រឈម មារ ជ្រែក នៅតែ មាន ជាក់ស្ដែង នា ពេល ថ្មី ៗ នេះ យើង បាន ឃើញ ទាំងអស់ គ្នា ហើយ ជាមួយ ការប្រែប្រួល ភូមិសាស្ត្រ នយោបាយ របស់ មហា អំណាច ដែល ជា កង្វល់ ដ៏ ធំ របស់ យើង គឺ ឥទ្ធិពល និង ការជ្រៀត ជ្រែក មកដល់ កម្ពុជា ដែល ធ្លាប់ ជា ប្រទេស រងគ្រោះ មិន ចេះ ចប់ ពីសំណាក់ ខាងក្រៅ អស់ ពី រឿង មួយ ចូលមក រឿង មួយ ជា ហូរហែ » ។
សម្តេច បាន បញ្ជាក់ ដែរ ថា « តាម ការប៉ាន់ស្មាន និង ការព្យាករណ៍ ( បញ្ហា ទាំងអស់ នេះ នឹង មិន ត្រូវ បាន បញ្ចប់ ទេ នឹង នៅតែ បន្ត ក្នុង សាច់រឿង ប្លែក ៗ ទៀត ) ព្រោះ បន្ត លើក ពី បញ្ហា សិទ្ធិ មនុស្ស ប្រជាធិបតេយ្យ រហូតមក ដាក់ទណ្ឌកម្ម យោធា ទណ្ឌកម្ម អាវុធ ក៏ ដូចជា បញ្ហា ផ្សេង ៗ ដែល កើត មាន ឡើង ជា បន្តបន្ទាប់ ដែល នឹង មាន ការរៀបចំ ជា ហូរហែ ពី មារស ត្រូវ ដែល ជា ឧបសគ្គ សម្រាប់ កម្ពុជា » ។
ការលើកឡើង របស់ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ បាន ធ្វើឡើង បន្ទាប់ពី សហរដ្ឋ អាមេរិក បាន បន្ត ដាក់ សម្ពាធ មក លើ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ហេតុផល នយោបាយ ។ សហរដ្ឋ អាមេរិក តាមរយៈ ការិយាល័យ ឧស្សាហកម្ម និង សន្តិសុខ របស់ ខ្លួន បាន ប្រកាស ជា ឯកតោ ភាគី ដោយ រឹតត្បិត ការលក់ អាវុធ និង សម្ភារ យោធា ឱ្យ កម្ពុជា ។
( ភ្នំពេញ ) ៖ លោក មាស សុភា ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង ដែល ត្រូវ ជា ឪពុក ក្មេក របស់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ។
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម ចូលរួម រំលែក មរណទុក្ខ ជូន ចំពោះ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកជំទាវ គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សហការី នៃ កាកបាទ ក្រហម កម្ពុជា សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត និង សោកស្តាយ ជាខ្លាំង ជាមួយ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកជំទាវ គឹង ចាន់ ឌី ព្រមទាំង ក្រុមគ្រួសារ ទាំងអស់ ចំពោះ មរណភាព របស់ មហា ឧសក ពុទ្ធសាសនូបត្ថម្ភ ផឹង គឹង ដែល បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ១:៤៥ នាទី រំលង អធ្រាត្រ ថ្ងៃព្រហស្បតិ៍ ១១រោច ខែមិគសិរ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស . ២៥៦៥ ត្រូវនឹង ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២១ ក្នុង ជន្មាយុ ៩២ ឆ្នាំ ដោយ ជរា ពាធ ។
ក្នុង ការចូលរួម រំលែក មរណទុក្ខ នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ចាត់ទុក មរណភាព របស់ មហា ឧបាសកសាសនូបត្ថម្ភ ផឹង គឹក គឺជា ការបាត់បង់ លោក ឱពុក ជីតា ជីតា ទួត ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ល្អ ប្រពៃ ចំពោះ កូន ចៅ ជា ទីស្រឡាញ់ ដែល កន្លងមក មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ តែងតែ ចូលរួមចំណែក លើកកម្ពស់ ដល់ វិស័យ ព្រះពុទ្ធ សាសនា នៅ កម្ពុជា យ៉ាង ច្រើន ពុំ អាច បំភ្លេច បាន ។
ស្ថិត ក្នុង មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង សូមឲ្យ វិញ្ញាណក្ខន្ធ មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ផឹង គឹង បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ការបញ្ជាក់ របស់ ប្រមុខ ការទូត កម្ពុជា បាន ធ្វើឡើង ក្នុង ឱកាស ផ្ដល់ ព័ត៌មាន ស្ដីពី អាទិភាព កម្ពុជា ក្នុង នាម ជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២២ ជូន បណ្ដា អង្គ ទូត និង បណ្ដាញ សារព័ត៌មាន នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២១ ។
ចំពោះ ប្រធានបទ នេះ ត្រូវបាន ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន ពន្យល់ ថា « គំនិត នេះ ចង់ បង្ហាញ ពី សារសំខាន់ នៃ ស្មារតី របស់ អាស៊ាន ជា គ្រួសារ រួបរួមគ្នា ទាំងអស់ ។ ស្មារតី រួមគ្នា ដ៏ រឹងមាំ នេះ គឺ ធ្វើ ក្នុង សកម្មភាព រួមគ្នា ដើម្បី សម្រេចបាន នូវ គោលដៅ រួម តែ មួយ » ។
តំណាង ជាតិ សម្រាប់ ក្រុមប្រឹក្សា សហគមន៍ សន្តិសុខ - នយោបាយ អាស៊ាន រូប នេះ បាន បន្ត ថា នៅក្នុង ពាក្យ ថា « ទាំងអស់ គ្នា រួមគ្នា ធ្វើ » គឺ ចង់ បញ្ជាក់ ថា កម្ពុជា សង្កត់ធ្ងន់ លើ មជ្ឈភាព ឯកភាព និង សាមគ្គីភាព របស់ អាស៊ាន ។ លុះត្រាតែ យើង ឈរ ក្នុង ជំហរ តែ មួយ នោះ យើង នឹង អាច ទទួលយក នូវ បញ្ហា ប្រឈម នៅក្នុង តំបន់ ជាមួយគ្នា ហើយក៏ បាន ចូលរួម ក្នុង ន័យ ស្ថាបនា បន្ថែម ទៀត នៅក្នុង ការថែរក្សា ការលើកកម្ពស់ សន្តិភាព ស្ថិរភាព សន្តិសុខ ក៏ ដូចជា ការអភិវឌ្ឍ ក្នុង តំបន់ និង សកលលោក ផងដែរ ។
ប្រមុខ ការទូត កម្ពុជា បាន ថ្លែង ទៀត ថា « ក្នុង ន័យ នេះ ខ្ញុំ សូម បញ្ជាក់ ថា យើង នឹង ឈរ ដោយ ឯកភាព និង កិច្ចសហប្រតិបត្តិការ សម្រាប់ ផ្តល់ ផលប្រយោជន៍ ទៅ វិញ ទៅ មក មិន មែន ជា ការរួបរួម សម្រាប់ ប្រឈមមុខ គ្នា ទៅ វិញ ទៅមក នោះ ទេ ។ យើង នឹង ខំ ផ្តោត បន្ថែម ទៅ លើ បញ្ហា ដែល មាន បញ្ហា ទាក់ទង គ្នា ធ្វើឲ្យ យើង មាន កិច្ចសហប្រតិបត្តិការ ការកសាង ទំនុកចិត្ត និង ការជឿជាក់ ទៅ វិញ ទៅ មក ដើម្បី កាត់បន្ថយ នូវ គម្លាត ដែល មាន បញ្ហា នីមួយ ៗ » ។
ក្នុង ស្មារតី នេះ កម្ពុជា ប្រាថ្នា ចង់ ដឹកនាំ អាស៊ាន តាមរយៈ បញ្ហា ប្រឈម ជាច្រើន ដែល កំពុង ប្រឈមមុខ នៅក្នុង តំបន់ រួមគ្នា ។ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន មាន បញ្ហា ប្រឈម ៤ធំ ៗ ដែល ផ្តល់ បច្ច័យ ដល់ អាស៊ាន និង ហួស អាស៊ាន ផងដែរ ។
បើ តាម តំណាង ជាតិ សម្រាប់ ក្រុមប្រឹក្សា សហគមន៍ សន្តិសុខ - នយោបាយ អាស៊ាន . បញ្ហា ប្រឈម ទាំង ៤រួម មាន៖
យោង តាម ការិយាល័យ ធនាគារ និហរ័ណ - អាហរ័ណ កូរ៉េ ប្រចាំ រាជធានី ភ្នំពេញ ដែល ទទួលបន្ទុក ប្រតិបត្តិការ មូលនិធិ កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច (EDCF) គម្រោង លើកកម្រិត គុណភាព ផ្លូវ ជាតិ លេខ ៤៨ គឺជា គម្រោង មួយ ក្នុង ចំណោម គម្រោង មូលនិធិ កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច (EDCF) ទាំង ១២ ដែល នៅក្រោម ក្រសួង សាធារណការ និង ដឹកជញ្ចូន ។
គិត ចាប់ ឆ្នាំ ២០០១ រហូតមកដល់ បំណាច់ ឆ្នាំ ២០២១ សាធារណរដ្ឋ កូរ៉េ បាន ផ្តល់ ហិរញ្ញប្បទាន សម្បទាន ដល់ កម្ពុជា តាមរយៈ មូលនិធិ កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច (EDCF) ចំនួន ៣០ គម្រោង គិត ជា ទឹកប្រាក់ សរុប ចំនួន ១.២ ពាន់ លាន ដុល្លារ អាមេរិក សម្រាប់ អភិវឌ្ឍន៍ វិស័យ សំខាន់ ៗ មាន ដូចជា វិស័យ ដឹកជញ្ចូន វិស័យ ធនធាន ទឹក វិស័យ គ្រប់គ្រង ទឹក កខ្វក់ វិស័យ សុខាភិបាល វិស័យ អប់រំ វិស័យ អភិបាលកិច្ច និង ការឆ្លើយតប បន្ទាន់ ទៅនឹង ជំងឺ ឆ្លងកាច សាហាវ (Covid-19) ។
សាធារណរដ្ឋ កូរ៉េ នឹង បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយនឹង រាជ រដ្ឋាភិបាល កម្ពុជា បន្ថែម ទៀត ហើយ នឹង ពង្រីក ជំនួយ ទៅ លើ វិស័យ ដទៃ ទៀត មាន ដូចជា វិស័យ ថាមពល វិស័យ កសិកម្ម និង វិស័យ ទូរគមនាគមន៍ និង គម្រោង ជាច្រើន ទៀត ៕
លោកស្រី ផាក គឺ នហេ ដែល បច្ចុប្បន្ន មាន វ័យ ៦៩ ឆ្នាំ ត្រូវបាន គេ ដឹង ថា កំពុង ជាប់ ពន្ធនាគារ ជាមួយនឹង ជំងឺ ប្រចាំ ការ ធ្ងន់ធ្ងរ ។ លោកស្រី ផាក បាន ក្លាយជា ប្រធានាធិបតី កូរ៉េ ខាងត្បូង ដំបូង គេ ក្នុង ប្រវត្តិសាស្ត្រ ដែល ត្រូវបាន ទម្លាក់ ចេញ ពី តំណែង ពេល កំពុង កាន់អំណាច កាលពី ឆ្នាំ ២០១៧ ដោយ តុលាការ ធម្មនុញ្ញ ជុំវិញ រឿង អាស្រូវ ពុករលួយ និង ការគប់ គិត គ្នា ជាមួយ មនុស្ស ជំនិត ក្នុង ការទទួលបាន ប្រាក់ មូលនិធិ រាប់ លាន ដុល្លារ ពី ក្រុមហ៊ុន ធំ ៗ ក្នុង ប្រទេស ដើម្បី បម្រើ ផលប្រយោជន៍ ក្រុមគ្រួសារ ខ្លួន ឯង ។
កាលពី ខែមករា ដើម ឆ្នាំ ២០២១ តុលាការ កំពូល កូរ៉េ ខាងត្បូង បាន ទម្លាក់ ចោល នូវ ការ ផ្ទន្ទាទោស លោកស្រី ផាក ដាក់ ពន្ធនា រយៈពេល ២០ ឆ្នាំ ពី បទ ពុករលួយ និង បាន ផ្តល់ ឱកាស ជា លើក ដំបូង ឲ្យ លោកស្រី បញ្ចប់ ដំណើរការតតាំង តាម ផ្លូវ ច្បាប់ ដែល កាល ណោះ ត្រូវបាន គេ មើលឃើញ ថា លោកស្រី អាចនឹង ទទួលបាន ការលើកលែង ទោស ៕ ចំណេះដឹង ទូទៅ៖ តើ មនុស្ស ដំបូង ធ្វើ បម្លាស់ ទី ទៅដល់ ទ្វីប អាមេរិក ដោយ របៀប ណា ?
ក្រសួង រៀបចំ ដែនដី បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២១ និង កំណត់ ទិសដៅ ការងារ សម្រាប់ ឆ្នាំ ២០២២ ចំនួន ១៨ ចំណុច
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន ដំណើរការកិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២២ ដែល មាន សមាជិក ចូលរួម សរុប ចំនួន ១ ១៥៦ រូប ។
គួរ បញ្ជាក់ ថា ការប្រកាស ខាងលើ របស់ ក្រសួង ការបរទេស រុស្ស៊ី ធ្វើឡើង តែ ប៉ុន្មាន ម៉ោង ប៉ុណ្ណោះ មុននឹង ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន និង លោក ប្រធានាធិបតី រុស្ស៊ី លោក វ្ល៉ាឌីមៀ ពូទីន ត្រូវ ជួប ពិភាក្សា គ្នា តាម ទូរស័ព្ទ នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ នេះ ៕
ឧត្តមសេនីយ៍ ឯក បណ្ឌិត ឈួន ថា វរិន្ទ មេបញ្ជាការ រង កងទ័ព ជើងអាកាស ផ្ញើ សារ រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក បណ្ឌិត ឈួន ថា វរិន្ទ មេបញ្ជាការ រង កងទ័ព ជើងអាកាស និង លោកជំទាវ ឈុន ផាណ្ណា នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង ដែល ត្រូវ ជា ឪពុក ក្មេក របស់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ។
រដ្ឋមន្ត្រី ជា វ៉ាន់ ដេត ផ្ញើ សារ រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង
( ភ្នំពេញ ) ៖ លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង ដែល ត្រូវ ជា ឪពុក ក្មេក របស់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ។
រដ្ឋមន្ត្រី ជា វ៉ាន់ ដេត មាន ក្តី រំជួល ចិត្ត ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ថា មហា ឧបាសក ពុទ្ធសាសនូបត្ថម្ភ ផឹង គឹង ត្រូវ ជា ឪពុក របស់ ឯកឧត្តម និង លោកជំទាវ បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ១៖៤៥ រំលង អធ្រាត្រ ថ្ងៃព្រហស្បតិ៍ ១១រោច ខែមិគសិរ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស ២៥៦៥ ត្រូវនឹង ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២១ ក្នុង ជន្មាយុ ៩២ ឆ្នាំ ដោយ ជរា ពាធ ។
បទ វិភាគ អន្តរជាតិ៖ « សង្គ្រាម ចម្រុះ » និង វិបតិ្ត ដ៏ សម្ងាត់ របស់ អនុត្តរភាព របស់ អាមេរិក
ការបង្ក រឿង ច្រើន ពេក ពិតជា នឹង នាំមក នូវ ក្ដី អន្តរាយ ដល់ ខ្លួន ឯង ។ សង្គ្រាម ចម្រុះ បាន ជួយ អាមេរិក បង្ក្រាប ដៃគូ ប៉ុន្តែ ព្រម ពេល ជាមួយគ្នា នេះ ក៏ បាន ប៉ះពាល់ ដល់ មូលដ្ឋាន អនុត្តរភាព របស់ អាមេរិក ដោយ មើល មិន ឃើញ ។ វា អាច នាំមក នូវ ផលប្រយោជន៍ ក្នុង រយៈពេល ដ៏ ខ្លី ដល់ ច្រើន ប៉ុណ្ណា ផលវិបាក ចំពោះ អាមេរិក ក្នុង រយៈពេល យូរ ក៏ កាន់តែ ធ្ងន់ធ្ងរ ប៉ុណ្ណឹង ។
ទី មួយ៖ សង្គ្រាម ចម្រុះ បាន កាត់ ក ម្សោយ កិត្យានុភាព អន្តរជាតិ របស់ អាមេរិក ហើយក៏ កាន់តែ បង្ហាញ ឱ្យ ឃើញ ច្បាស់ នូវ ភាពអស់ ជំនឿចិត្ត របស់ អាមេរិក រឹតតែ ខ្លាំង ឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។
ទី ពី រ៖ សង្គ្រាម ចម្រុះ ធ្វើឱ្យ អាមេរិក ចង គំនុំ នៅ គ្រប់ ទីកន្លែង ក៏ ធ្វើឱ្យ ស ម័្ពន្ធ មិត្ត របស់ អាមេរិក ខកចិត្ត និង បាត់បង់ ទំនុកចិត្ត ។
ដោយ៖ បណ្ឌិត ជា មុនី ឫទ្ធិ ( ប្រធាន សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន )
ឧត្តមសេនីយ៍ ឯក ស ថេត ផ្ញើ សារ រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង នគរបាល ជាតិ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារលិខិត រំលែក ទុក្ខ ជូន លោក ទេសរដ្ឋមន្ត្រី គន់ គីម និង លោកស្រី គឹង ចាន់ ឌី ចំពោះ មរណភាព របស់ មហា ឧបាសក ផឹង គឹង ដែល ត្រូវ ជា ឪពុក ក្មេក របស់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ។
