ខ្ញុំ បាន ចាត់ គាត់ ឱ្យ មក ឯ អ្នក រាល់គ្នា សម្រាប់ ការ នេះ ឯង គឺ ដើម្បីឱ្យ អ្នក រាល់គ្នា បាន ដឹង អំពី យើង និង ដើម្បី កម្សាន្ត ចិត្ត អ្នក រាល់គ្នា ។
ពេល ពួក អ៊ីស្រាអែល បាន ទទួល បទពិសោធន៍ ដ៏ គួរឱ្យ ស្ញែង ខ្លាច នៅក្បែរ ភ្នំ ស៊ីណាយ ពួកគេ ក៏ បាន អង្វរ លោក ម៉ូសេ ថា សូម លោក មានប្រសាសន៍ មក យើងខ្ញុំ រាល់គ្នា តែ ខ្លួន លោក បាន ហើយ យើងខ្ញុំ នឹង ស្តាប់ លោក សូម កុំ ឱ្យ ព្រះមាន ព្រះបន្ទូល នឹង យើងខ្ញុំ ឡើយ ក្រែង យើងខ្ញុំ ត្រូវ ស្លាប់ ២០១៩ ។
ប្រៀប ដូច នឹង ពាក្យ បុរាណ ពោល ថា អ្នក មាន រក្សា ខ្សត់ ដូច សំពត់ ពាត់ ពី ក្រៅ អ្នកប្រាជ្ញ រក្សា ខ្លៅ ដូច សំពៅ នៅ សំប៉ាន ៕
មាន ព័ត៌មាន ថា លោក ត្រាំ ចង់ ដកហូត តំណែង ទីប្រឹក្សា …
ប៉ុន្តែ នៅពេល យើង ញ៉ាំ ទឹក វិញ យើង តែងតែ ចង់ ញ៉ាំ ទឹក ត្រជាក់ ។
និវត្តន៍ ជន ខ្មែរ មិន ចូលចិត្ត …
ព្រោះ វា ធ្វើឱ្យ រាងកាយ របស់ អ្នកទទួលរង ការឈឺចាប់ ខ្លាំង បន្ថែម ពីលើ ការឈឺចាប់ មួយ ទៀត ។
លោក បាន មានប្រសាសន៍ ថា ខ្ញុំ នឹង ស្នើ ឱ្យ សម្តេច ប្រធាន ហេង សំរិន រក មធ្យោបាយ ដោះស្រាយ បញ្ហា នេះ ។
ខ្ញុំ មិន បាន និយាយ ច្រើន អស់ រយៈពេល ២សប្តាហ៍ ។
និង មិន អាច ព្យាករ បាន ដែល វា គឺជា រឿង សំខាន់ និង គួរឱ្យ សោកស្តាយ បំផុត ៕
បើ ទោះជា គ្មាន ច្បាប់ ឬ ក្រម វិជ្ជាជីវៈ ចែង ពី ការកំណត់ ឱ្យ អ្នកសារព័ត៌មាន ត្រូវ សរសេរ ឬ ហៅ អស់ លោក ធំ ៗ
ជាង នេះ ការរិះគន់ ផ្សេង ៗ
តាម គំនិត របស់ ខ្ញុំ គឺ ពួកគេ ពិតជា អាច លេង បាន សម្រាប់ យប់ នេះ ។
ប៉ុន្តែ នៅក្នុង បរិបទ មួយ ដែល ថ្មី ការគិត បែប នេះ អាច ជួប នឹង ផលវិបាក ។
តិក និក៣ ចំណុច ដើម្បី កំណត់ ការងារ ក្នុង ក្តី សុបិន របស់ យើង
ម៉ូតូ ពន្លះ និង ម៉ូតូ ពេញ ទំហឹង របួស ២នាក់ នៅ ខេត្ត កណ្តាល
សេចក្តី អធិស្ឋាន ដែល ព្រះមិន ឆ្លើយតប ស្ថិត ក្នុង ចំណោម ការពិបាក បំផុត ដែល ខ្ញុំ បាន ជួបប្រទះ ។
បើសិនជា អ្នក កំពុងតែ ឆ្ងល់ អំពី របៀប ដែល ទ្វារមាស មាន ប្រតិកម្ម ដូចម្តេច ក្… អាន បន្ត
ស្រលាញ់ មនុស្ស អត់ចិត្ត ឈឺចាប់ ជាង ស្រលាញ់ គេ ម្ខាង ទៅ ទៀត
ការពិត គួរឱ្យ អស្ចារ្យ ចំពោះ ស្ត្រី មាន ផ្ទៃពោះ ក្នុង ត្រី មាស ដំបូង
យើង គ្រប់ គ្នា សុទ្ធតែ បាន ដឹង ពី អត្ថប្រយោជន៍ របស់ ផ្លែ ក្រូចឆ្មារ ។
ចូលរៀន លើក ទី៤ ៖
អ្នក គួរតែ ជួប ពិភាក្សា ជាមួយ បុគ្គលិក ជាមុន សិន ។
ទី ពីរ កំណត់ កាលបរិច្ឆេទ ដើម្បីឱ្យ គាត់ រុះរើ ។
របស់ ខ្ញុំ បាន នឹង កំពុង ចូល ប្រឡូក លើ ការងារ នេះ ហើយ ។
តាម សមត្ថកិច្ច បាន ឱ្យដឹង ថា មូលហេតុ នាំឱ្យ មាន អគ្គិភ័យ នេះ ដោយសារ ផ្ទុះ សេ ខ្សែរ ភ្លើង ។
ខ្ញុំ បាន សរសេរ បទ ថ្មី ៗ
នេះ បាន ប្រមូលផ្តុំ គ្នា តវ៉ា នៅ ទីតាំង …
ពីរ នាក់ បាន ស្គាល់ គ្នា នៅក្នុង ហាង កាហ្វេ ដោយ ចៃដន្យ ។
បើសិនជា អ្នក កំពុងតែ ឆ្ងល់ ថា គួរ បន្ទោបង់ ប៉ុន្មាន ដង ក្នុង មួយ ថ្ងៃ ចូរ ចាំ ថា វា អាស្រ័យ ទៅ លើ អ្វី ដែល អ្នក ញ៉ាំ ដែរ ។
ហេតុ ដួច្នេះ ចូរ ហាត់ រៀន ស្តាប់ ខ្យល់ ដកដង្ហើម និង ពាក្យសំដី គ្នា ទៅ វិញ ទៅ មក ខណៈពេល អនុវត្ត ឈុត ឆាក ស្នេហា ព្រោះ វិធី នេះ វា នឹង ធ្វើឱ្យ អ្នក ទាំង ពីរ ទទួលបាន សេចក្តីរីករាយ ។
រហូត ប៉ុន្មាន ខែ មក ហើយ ហ្នឹង ។
យន្តហោះ ចម្បាំង អាមេរិក ត្រៀម ប្រើ នៅ កូរ៉េ ធ្លាក់ ក្នុង សមុទ្រ
ដូច មច្ចុរាជ កំណាច ឫ ស្យា
ក ណ្តៀង ត្បូង ឆាំង អ៊ឹង ណារី
អនុញ្ញាត្តិ អោយ ខ្ញុំ សុំ សួរ លោក មួយ ៖
ប្រាំ ថ្ងៃ ក្រោយមក យើង ក៏ បាន មកដល់ ក្រុង ត្រូអាស, ជួបជុំ នឹង ពួកគេ , រួច ស្នាក់ នៅ ទីនោះ ប្រាំពីរ ថ្ងៃ ។
គឺ បាន ធ្វើ សកម្មភាព នៅ តាម មូលដ្ឋាន រៀង ៗ
ដែរ ហើយ គាត់ ធ្វើចម្ការ នៅលើ នោះ ។
ក្រោយពេល សម្រេច ការហើយ យើង នឹង ប្រទាន រង្វាន់ ឱ្យ ។
ដោយៈ លោក អឿន ស្រួ
សម្រាប់ មនុស្ស ភាគ ច្រើន សូម្បីតែ មនុស្ស ដែល ស្និទ្ធិ ស្នាល នឹង ពួកគេ បំផុត ក៏ គ្មាន ការជឿជាក់ លើ ពួកគេ ដែរ ។
នៅ ថ្ងៃ នេះ សហព័ន្ធ និស្សិត បញ្ញា វ័ន្ត
បាន ទៅ រដ្ឋាភិបាល ។
របស់ ខ្លួន ដូច ក្រុមហ៊ុន ដទៃ ពុំ ដែល ខាន ឡើយ ។
ក្រោយមក ធ្វើអោយ ស្លឹក ស្ងួត វា តែងតែ កើតឡើង នៅ រដូវ ក្តៅ ។
អ្វី ដែល អ្នក នឹង ឃើញ នៅពេល អ្នក ដើរ ឈានចូលក្នុង សាលា ជំនុំមរមន
ទៀត ដើម្បី ការពារ ទឹកដី
តាម ផ្លូវ នេះ ត្រូវ ធ្វើដំណើរកាត់ ព្រៃ និង ដី ហ៊ុយ ផង បែក ភក់ ផង ។
អញ្ចឹង តាម ស្ថិតិ យើង មើល ទៅ ឃើញ ថា យើង នៅក្នុង រង្វង់ អាច គ្រប់គ្រង បាន ។
មូលហេតុ ដោយសារ អ្នកបើកបរ ម៉ូតូ បើកបរ គ្មាន ការប្រុងប្រយ័ត្ន ៕
ព្រះអង្គ នឹង វាល់ អោយ អ្នក រាល់គ្នា តាមរង្វាល់ ដែល អ្នក រាល់គ្នា វាល់ អោយ អ្នកដទៃ ។
នា ពេលនេះ វា ក៏ ត្រលប់ មកវិញ ដើម្បី បំពេញ ចិត្ត អតិថិជន របស់ ខ្លួន ។
កំព្រា នោះ ទេ ប៉ុន្តែ អាច ជំពាក់ ជំពិន លើ ករណី មួយ ផ្សេង ។
លោក អាត់ ធន់ អត្ថាធិប្បាយ ថា គេ ត្រូវ តាមដាន ការអនុវត្តន៍ បទបញ្ជា របស់ លោក នាយក រដ្ឋមន្ត្រី ៕
លោក អធិការ ង បាន អះអាង ថា គ្មាន អ្នកភូមិ ណា ទៅ ដេញ គាត់ ចេញ ពី ភូមិ នោះ ទេ ព្រោះ អ្នកភូមិភាគ ច្រើន គឺ សុទ្ធតែ ជាប់ សាច់ ឈាម ជាមួយនឹង គាត់ ។
ផងដែរ ឆ្លើយតប ទៅ អាមេរិក វិញ នា ពេល ខាងមុខ ។
ក្នុង ពេលវេលា ដ៏ តិច ។
ប្រជាជន ទូទៅ មិន សូវ ខ្វល់ខ្វាយ អំពី ចំណីរអាហារ ដែល គួរ ទទួលទាន ប្រចាំ ថ្ងៃ នោះ ឡើយ ។
បន្ទាប់មក ទើប ពួក នេះ យល់ ថា ហិប របស់ ព្រះអម្ចាស់ មកដល់ ជំរំហើយ ។
នៅក្នុង កាលៈទេសៈ បែប នេះ យើង ត្រូវ ធ្វើការ ជាមួយ ប្រទេស ផ្សេង ៗ
យើង មិន គួរ ផ្តោត លើ បញ្ហា នៅក្នុង ប្រទេស ស៊ីរី នោះ ទេ ។
ហើយ មុខជំនាញ នេះ បាន ផ្តល់ នូវ អត្ថប្រយោជន៍ ជាច្រើន ដល់ ខ្ញុំ គឺ ធ្វើអោយ ខ្ញុំ យល់ដឹង ពី ៖
