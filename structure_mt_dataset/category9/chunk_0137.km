ប៉ុន្តែ រដ្ឋាភិបាល មិន បាន ធ្វើ អ្វី ទាំងអស់ ។
ប៉ុន្តែ អត្រា ប្តូរ ប្រាក់ គឺជា មនុស្ស ល្អ ។
លា ហើយ ថែរក្សា ខ្លួន និង ភ្នែក របស់ ខ្ញុំ ផង ៕
ហ្នឹង ហើយ គ្រាន់តែ ប្រជាជន មិន និយាយ ។
មិន ត្រូវ ធ្វើ ដូច ដើម ល្ហុង និង អំពៅ ដែល មាន លក្ខណៈ រឹង ក្រៅតែ ប្រហោង
ដូច្នេះហើយ ទើប គ្រប់ គ្នា មើលឃើញ កាន់តែ ច្បាស់ ឡើង ៗ
សំណួរ ចុងក្រោយ បំផុត នោះ គឺ នរណា ជា អ្នកបញ្ជូន ទ្រង់ ឱ្យ មកសុគត យ៉ាង ដូច្នេះ ?
ក្រុមហ៊ុន នេះ បាន ដាក់ លក់ ទូរស័ព្ទ ទំនើប របស់ ខ្លួន នៅ ទីផ្សារ មួយ នេះ កាលពី ឆ្នាំ មុន ។
សព្វ ថ្ងៃ យើង មាន បរិមាណ មិន សូវ មាន គុណភាព ។
យក រថយន្ត ចេញ ពី កន្លែង កើត ហេតុ ដោយ ពួកគេ អះអាង ថា ចាំ ឪពុក របស់ ខ្លួន មក ដោះស្រាយ ។
អ្នក ចាំបាច់ ត្រូវ មាន គំនិត ច្នៃប្រឌិត ដើម្បី គេច ឱ្យ ផុត ពី ភាពធុញទ្រាន់ ខាង ផ្លូវភេទ នេះ ។
ចូរ ស្តាប់ បង្គាប់ ចៅហ្វាយ ខាង សាច់ ឈាម នៅក្នុង ការ ទាំងអស់ ចុះ មិន មែន បម្រើ តែ ក្នុង ការ ដែល គេ មើលឃើញ ដូចជា ចង់ ផ្គាប់ ចិត្ត មនុស្ស ឡើយ គឺ ត្រូវ ធ្វើ ដោយ ចិត្ត ស្មោះត្រង់ ទាំង កោតខ្លាច ព្រះអម្ចាស់
ឈាម នេះ បាន យ៉ាង ឆាប់រហ័ស ។
ក - ប្រសិទ្ធិភាព នៃ កិច្ច ប្រតិបត្តិការ ។
ខ្ញុំបាទ ឈ្មោះ រតនៈ !
គេ នាំគ្នា មើលងាយ គ្នា ទៅ វិញ ទៅមក ។
ប្រាសាទ ព្រះវិហ៊ារ ៖
ខ្ញុំ កំពុង ហ្វឹកហាត់ និង ធ្វើ ការងារ យ៉ាង ច្រើន ។
ប្រពន្ធ ប្តឹង ប៉ូលិស អោយ ចាប់ ប្តី លាក់ កាំភ្លើង នៅ ផ្ទះ
ចំណែកឯ សុភាសិត មួយ ទៀត បាន ពោលថ៉ា សូវ ស្លាប់
គ្រាន់តែ លេច ឮ ព័ត៌មាន នេះ ភ្លាម ប្រជាពលរដ្ឋ ម្នាក់ ៗ
រីឯ ចែកចាយ ចេញ ទៅ វិញ ដាក់ ប៊ី ដុង ក្នុង កន្ត្រក ដឹក ម៉ូតូ
មិន អាច ឆ្លើយតប នឹង តម្រូវការ របស់ ពលរដ្ឋ បាន ទេ ។
នៅ ត្រង់ ដៃ យ៉ាង ទាន់ហន់ ។
២. កាត់បន្ថយ ការព្រួយបារម្ភ
អ្នក មាន ទ្រព្យ ដណ្តើម ខ្ញុំ ពី ឧកញ៉ា ដេវីដឆាយ ណា វ៉ា
អ្នក រត់ រ៉ឺម៉ក កង់ ៣ ម្នាក់ បើក ធ្លាក់ លូ ស្លាប់ ភ្លាម ៗ
តើ ខ្លឹមសារ ចម្រៀង ច្រៀង បែប ណា ដែល អាច នៅ ឋិតថេរ យូរអង្វែង ?
ទោះបីជា … អាន លម្អិត
នេះ ជា បញ្ហា ស្លាប់ រស់ ហើយ លោក ត្រាំ បាន ក្បត់ ប្រជារាស្ត្រ អាមេរិកាំង ។
ខ្ញុំ ពិតជា សប្បាយ ចិត្ត និង គាំទ្រ ១០០ ភាគរយ ៕
តែ យ៉ាងណា គេ នោះ ហាក់ មិន បាន ប្រតិបត្តិ តាម ការស្នើ របស់ លោក ឡើយ ។
តាមពិត ពាក្យ ទាំង នេះ មិន មាន ឥទ្ធិពល អ្វី ធុំ ដំមក លើ ខ្ញុំ ទេ ។
នាង មិន ត្រូវការ លុយ ឬ ការជួយ ពី អ្នក ឡើយ
អ្នក និង គូរ ស្នេហ៏ ប្រៀប បីដូចជា ប្តី ប្រពន្ធ ដែល ទើបនឹង រៀបការ ថ្មី ថ្មោង ។
ប្រតិបត្តិការ នេះ នឹង ចាប់ផ្តើម នៅ ថ្ងៃចន្ទ ។
ព្រោះតែ រថយន្ត មួយ នេះ ធ្វើឱ្យ អ្នកដំណើរ …
បើ ហ៊ុន សែន ពិតជា អ្នកក្លាហាន មក ដេញ បាញ់ ទាហាន ថៃ អោយ ចេញ ពី វត្ត អោយ អស់ កុំ ក្លាហាន តែ នៅមុខ កញ្ចក់ ទូរទស្សន៍
នេះ សំណាង ហើយ ដែល ពួកយើង ទាំង បី នាក់ មិន ស្លាប់ ។
ហើយ រាល់ ពេល ដែល ពួក វា ជាប់គាំង នៅ ច្រាំង ហើយ គឺ ពួកវា ស្លាប់ ភ្លាម ៗ
វា មិន មែន គ្រាន់តែ ជា រឿង សំខាន់ នៅក្នុង ប្រទេស ណូវែលហ្សេឡង់ តែ មួយ នោះ ទេ ។
សមាជិក សភា ម៉ាឡេស៊ី នឹង ជួបគ្នា នៅ ថ្ងៃច័ន្ទ នេះ ដើម្បី ដោះស្រាយ ភាព ជាប់គាំង នយោបាយ របស់ ប្រទេស បន្ទាប់ពី ព្រះមហាក្សត្រ មិន បាន រកឃើញ បេក្ខជន ណាមួយ ដែល មាន សំឡេង ភាគ ច្រើន ច្បាស់លាស់ ដើម្បី ក្លាយជា នាយក រដ្ឋមន្ត្រី បន្ទាប់ ។
ទំព័រ ដើម បច្ចេកវិទ្យា ចេញមក ហើយ !
មើល ឆ្វេង មើល ស្តាំ ។
បើ នៅ ក្រុង ប្រាក វិញ ជិះ ម៉េត្រូ អី ត្រូវ ប្រយ័ត្ន កាបូប លុយ អោយ មែនទែន ចង្អៀត ៗ
នៅ ពេល នោះ អ្នក ត្រូវបាន គេ កត់សម្គាល់ ពី អារម្មណ៍ ដែល អ្នក កំពុង មាន ឬ ស្តែង ចេញ ដូច្នេះ អ្នក ត្រូវតែ ម្ចាស់ ការ ចំពោះ អារម្មណ៍ ទាំងនោះ ។
ព្រះបាទ ដាវីឌ ជា អម្ចាស់ នៃ យើង បាន តែងតាំង សម្តេច សាឡូម៉ូន ជា ព្រះមហាក្សត្រ ហើយ ។
បុគ្គលិក ពេទ្យ រូប នេះ បាន និយាយ បន្ថែម ថា យើង កំពុង ខិតខំ ព្យាយាម រក មធ្យោបាយ ឯទៀត ៗ
ប្អូន ស្រី វង្វេង រក ផ្លូវ ទៅ ផ្ទះ មិន ឃើញ
ប៉ុន្តែ ពេល ទៅដល់ រូប លោក បាន ឃើញ មិត្ត ស្រី កំពុង កៀក កើយ ជាមួយ ប្រុស ផ្សេង ទៅ វិញ ។
ប្រសិនបើ កីឡាករ ម្នាក់ ទទួល ការព្យាបាល ពួកគេ ត្រូវតែ ចាកចេញ ពី ទីលាន ប្រកួត ។
ស្ទើរតែ គ្រប់ ប្រទេស ទាំងអស់ នៅលើ ពិភពលោក ទទួលស្គាល់ ការទទួលខុសត្រូវ របស់ ខ្លួន ក្រោម ច្បាប់ អន្តរជាតិ ក្នុង ការសង បំណុល ដែល រដ្ឋាភិបាល មុន ជំពាក់ ។
វា ចេញ ស្វែងរក ចំណី យ៉ាង សកម្ម ជាពិសេស វា ចូលចិត្ត ប្រមាញ់ ដេញ ចាប់ សត្វ ព្រៃ ថ្មី ៗ
ដែល ចាំបាច់ សម្រាប់ ការកសាង សាច់ដុំ ។
នេះ មិន មែន ជា ការអស្ចារ្យ ទេ ដែល ក្មេងស្រី ដែល ចង់ ដឹង ចង់ ឃើញ ម្នាក់ អាច អាំង នំប៉័ង ដោយ ប្រើ មាស៊ីន ស្វ័យប្រវត្តិ ។
លោក ឌីសៅ គឺជា អតីត កុមារ ភៀសខ្លួន មួយ រូប ដែល បច្ចុប្បន្ន កំពុង រស់ នៅ សហរដ្ឋ អាមេរិក ។
លោក ប្រាវីត និយាយ ថា គ្រប់ គ្នា ត្រូវតែ ប្រកាន់ខ្ជាប់ នឹង ច្បាប់ ។
ពួក អ្នកជំនាញ ព្រមាន ឱ្យ ប្រុងប្រយ័ត្ន ព្រោះ អាច មាន ការប្រព្រឹត្ត អំពើ ទុច្ចរិត តាមរយៈ ការខ្ចី ប្រាក់ ជាច្រើន យ៉ាង ឆាប់រហ័ស បែប នេះ ។
បើ តាម លោក សំទូច ការប្រមូល ផល ស្រូវ នៅក្នុង ទឹក មិន ងាយស្រួល ឡើយ ។
កុំ ប្រៀបធៀប ជីវិត អ្នក មក ជីវិត ខ្ញុំ អី ព្រោះ ជីវិត មនុស្ស ម្នាក់ ៗ
ដែរ ទើប បង ស្រី ខ្ញុំ មិន ចាប់អារម្មណ៍ ។
