ហើយទម្លាក់ពួកគេដោយការ ទាយ
ជនជាតិ អ៊ីតាលី មាន អ៊ីតាលី ។
“ ដើម្បីដឹងថានេះគឺជាការ បំផ្លាញអំពើអាក្រក់ដ៏អាក្រក់ ” ។
កម្មវិធី អាវុធ នុយក្លេអ៊ែរ របស់ ប្រទេស នេះ នឹង មាន ផលប្រយោជន៍ ច្រើន ជាង ការចាប់អារម្មណ៍
" អ្នក មិន និយាយ ការស៊ើបអង្កេត ការក្លែងបន្លំ នៅ ទីនេះ ទេ ។
3 ដោយពោលថា៖ « កុំធ្វើ បាបផែនដី ឬសមុទ្រ ឬដើមឈើឡើយ ដរាប ណាយើងបានបិទ ត្រាអ្នក បម្រើនៃព្រះ នៃយើងនៅលើថ្ងាសរបស់គេ » ។
ជូត និង សម្អាត គ្រប់ ពេលវេលា ។
ខ្ញុំ អាច យល់ ពី ការចង់ ដឹង ចង់ ឃើញ របស់ អ្នក ចូលចិត្ត អុក ។
ការលេង មាន លក្ខណៈ ជា សកល នៅ គ្រប់ ប្រទេស ដែល ខ្ញុំ បាន ធ្វើដំណើរ ទៅ ។
ដូច្នេះ អ្នកមិនចាំបាច់បង្កើតស្នេហារបស់នាងឡើងវិញពីដើមឡើយ។
តើ អ្នក យល់ យ៉ាងណា ចំពោះ យុទ្ធនាការ ទីផ្សារ ?
មេដឹកនាំ ពិភពលោក កំពុង ប្រើ ខួប លើក ទី 25 នៃ ការបង្ក្រាប នៅ ទីលាន ធាន អាន មេន របស់ ប្រទេស ចិន ដើម្បី ជំរុញ ទីក្រុង ប៉េកាំង ឱ្យ មាន ការរីកចំរើន លើ សិទ្ធិ មនុស្ស ។
“ ខ្ញុំមើលជន រងគ្រោះកំពុងសិក្សានាង ។
ពួកនេធីនីក៏ជាអ្នកដែលដាវីឌ និងពួកចៅហ្វាយបានតែងតាំងឲ្យបម្រើពួកលេវីដែរ ។
សម្រាប់ ពួកយើង ពួកយើង ជ្រើសរើស មិន យក កូន ទៀត ទេ ។
ខ្ញុំមិនចង់បង្កបញ្ហាទេ …» ។
បើអ្នកចង់បោះពុម្ពតារាងនេះចេញទៅទីនេះ ។
វា ផ្តល់ ទំនុកចិត្ត កាន់តែ ប្រសើរឡើង នៅពេល ធ្វើ ការសម្រេចចិត្ត ... .
គិលានុបដ្ឋាយិកា ប្រហែលជា មិន មែន ជា ការងារ ដ៏ អស្ចារ្យ បំផុត នោះ ទេ ប៉ុន្តែ សម្រាប់ ខ្ញុំ វា មាន អត្ថន័យ និង បំពេញ ចិត្ត បំផុត ។
យកមនុស្ស មកជាមួយនាងអណ្ដូងអត់មានទេ ។
ព្យាយាម ស្វែងរក សន្តិភាព សម្រាប់ ខ្លួនអ្នក ។
ពេលគេធ្វើរួច ខ្ញុំ រកឃើញរឿងនេះ ។
« ដោយសារធនធានរបស់ពួកគេមានចំនួនតិចជាង ប៉ុន្តែ បន្ទាប់មកពួកគេមើលឃើញថាតើអាចធ្វើអ្វីបានទៀត។
អស់ រយៈពេល បី ថ្ងៃ បន្ទាប់មក បាន អង្វរ ព្រះជា ម្ចាស់ ឱ្យ យក នាង ចេញពី ជីវិត ដ៏ ខ្លី នេះ ។
ជាថ្មីម្តងទៀត សម្រាប់ការ ប្រាកដថាមិនមាន ភាពមិនច្បាស់ លាស់ក្នុងការ វែកញែករបស់អ្នក។
ល្អ សម្រាប់ អ្នក ក្រោកឈរ ឡើង សម្រាប់ ខ្លួនអ្នក និង របស់របរ ។
គាត់បានប្រាប់យើងរួចហើយថា៖ « ព្រះ យេហូវ៉ាទ្រង់គង់ជាមួយនឹងឯង » ។
គាត់បាននិយាយថា៖ « យើងមានការ ពិពណ៌នាដ៏ល្អមួយអំពីបុគ្គល។
អ្វី ដែល មនុស្ស ព្រួយបារម្ភ
ប៉ុន្តែបានប្រគល់ជីវិតទៅឲ្យគ្រោះកាច ។
" ការមកដល់ នៃ សំបុត្រ គឺជា វត្ថុ ដ៏ អស្ចារ្យ ដំបូង នៃ ការ មិន ចេះ អត់ធ្មត់ រាល់ ព្រឹក ។
នៅពេល ណាមួយ ខ្ញុំនឹងចេញ បទ ចម្រៀងរបស់គាត់ » ។
ខ្ញុំកំពុងស្វែងរកពេលវេលាដ៏ល្អបំផុតដើម្បីផ្សព្វផ្សាយអ្នក យកព័ត៌មានផ្នែកថែទាំសុខភាព ។
ចំណាប់អារម្ម ណ៍៖ គ្មាន ការអត្ថាធិប្បាយ លើ រឿង នេះ ទេ ។
អូ ខ្ញុំ ប្រយោគ ជាប់ នឹង រូបភាព ។
តម្រូវការ ដ៏ អស្ចារ្យ មួយ នៃ ថ្ងៃ នេះ គឺ បុរស និង ស្ត្រី ដែល មាន ចិត្ត ស្មោះស្ម័គ្រ ដែល ត្រូវបាន កាន់កាប់ ទាំងស្រុង ជាមួយនឹង សេចក្តី ពិតជា មូលដ្ឋាន ដ៏ អស្ចារ្យ នៃ ព្រះបន្ទូល របស់ ព្រះ។
អ្នកគាំទ្រកីឡាដឹងរឿងល្អជាងក្មេងអាយុ១២ ឆ្នាំទៅទៀត ។
ថ្មើរជើង ឈានជើង មួយ ដើរ ។
មិន ត្រូវការ អ៊ីនធឺណិត
ជារៀងរាល់ ឆ្នាំ ប្រទេស ផ្សេង គ្នា មាន កិត្តិយស ក្នុង ការផ្តល់ ដើមឈើ ។
នេះ ជា កន្លែង ដែល អ្នក ចាប់ផ្តើម៖ មាន វត្តមាន ។
យើងបាននៅទីនោះជាមួយគាត់ដោយក្តីស្រឡាញ់ និងការ បាត់ បង់ដោយរីករាយ និងសោក សៅ ។
ធ្វើការ នៅ ចម្ងាយ របស់ អ្នក ហើយ បន្ទាប់មក អ្នក អាច ធ្វើ ការ តាម ពេលវេលា របស់ អ្នក ។
ដូច្នេះ ព្រះបាទ ដាវីឌមានព្រះបន្ទូលថា មើល ស្អែកជាថ្ងៃបុណ្យសែនព្រះ ខែ ហើយខ្ញុំត្រូវចូលរួមពិសាជាមួយនឹងស្តេច ប៉ុន្តែសូមឲ្យខ្ញុំទៅលាក់ខ្លួននៅវាលស្រែរហូតដល់ល្ងាចថ្ងៃ បន្ទាប់ ។
ខ្ញុំ មាន ន័យ ថា វិចិត្រករ ម្នាក់ ។
សារ៉ា គឺជា អ្នកគាំទ្រ ថ្មី ។
ថ្ងៃ នេះ នៅ ការិយាល័យ របស់
លើ ផែនដី ក្រោម អំណាច និង ការគ្រប់គ្រង របស់ ខ្ញុំ ។
ក្រោយពីញ៉ាំអាហារក្រោម តុ សស កុដិរួច .. .
កុំ ស្ទាក់ស្ទើរ ក្នុង ការធ្វើដំណើរ តាម ដងទន្លេ ដោយ ឥត គិត ថ្លៃ ។
គាត់ជាមនុស្សប្រភេទដែលនឹងបង្ហាញអ្នកពីសុបិនរបស់គាត់ ហើយបង្ហាញអ្នកពីអារម្មណ៍របស់គាត់ ។
ឥឡូវនេះ បើនិយាយពីរឿង នយោបាយបោះឆ្នោត បញ្ហានេះនឹងត្រូវលើកយកមកពិភាក្សា បន្ទាប់ពីពេញអង្គ ។
ការចាប់ គឺ ថា បុគ្គល នេះ នឹង មិន
ការពិពណ៌នា កម្មវិធី ដោយ៖ តោះ លេង
ប្រើត្រង់នេះសម្រាប់ផ្លូវដែលវាប៉ះនឹងអាណាចក្ររបស់ទេវតា ដូចមានគេប្រាប់ថា អ្នក ណាប្រើត្រូវដុសដោយពន្លឺនៃស្លាបទេវតា ។
ប៉ុន្តែ ទោះបីជា បន្ទាប់ពី អេក្រង់ បន្ត ដំបូង ក៏ដោយ ខ្ញុំ គិត ថា មាន រឿង ជាច្រើន ដែល យើង អាច ធ្វើ បាន ដើម្បី ធានា ថា ដំណើរការសម្រេចចិត្ត របស់ យើង ផ្អែក លើ គុណសម្បត្តិ ។
ប៉ុន្តែប្រសិនបើពួកគេមិន អាចឆ្លើយសំណួរទាំង បីនេះ ពួកគេប្រហែលជាមិនយល់ពីបញ្ហារបស់ពួកគេឱ្យ បានគ្រប់គ្រាន់នោះ ទេ ។
បាញ់ ម្តង ទៀត បន្ទាប់ពី ពីរ ថ្ងៃ ។
មាន ឱកាស តិចតួច ដែល ពួកគេ អាច វិវត្ត ទៅជា ជំងឺ មហារីក ភ្នែក ។
អ្នកត្រូវ អញ្ជើញការបញ្ចូលយ៉ាង សកម្ម៖ " តើអ្នកបានឃើញអ្វីពីយប់មិញ ?
ប៉ុន្តែ ទោះបីជា នាង មិន ស្មោះត្រង់ នឹង ពិន្ទុ ក៏ដោយ
មួយ ឆ្នាំ កន្លះ ប៉ុន្តែ ពួកគេ មិន ត្រួត លើ គ្នា ទេ ។
បន្ទាប់ពី នាង ចេញ ពី គុក
ព្រោះអ្នកមាន ចិត្ត ស្មោះចំពោះគាត់ » ។
ខ្ញុំ នឹង ប្រែក្លាយ គាត់ ទៅជា អ្នក ជឿ ។
« គេបានចាកចេញពីផ្លូវត្រង់ ហើយដើរទៅតាមមាគ៌ារបស់បាឡាម ជាកូនរបស់លោកបេអ៊រ ដែលស្រឡាញ់ប្រាក់ឈ្នួលនៃអំពើទុច្ចរិត ។
ប៉ុន្តែ ខ្ញុំ សូម ជូនពរ ឱ្យ ការខិតខំ ប្រឹងប្រែង របស់ ខ្ញុំ ត្រូវបាន ទទួលស្គាល់ ដោយ រដ្ឋាភិបាល ។
ព្រះអង្គដែលយាងចុះមក គឺ ជាអ្នកដែលបានឡើងខ្ពស់ជាងស្ថាន សួគ៌ទាំង អស់ ដើម្បីបំពេញសកលលោកទាំងមូល ។
សូមអធិស្ឋានឲ្យយើងប្រតិបត្តិដោយការ យល់ដឹងអំពីអ្វីដែលយើងមានច្រើន ហើយមិនមែនមកពីកន្លែងខ្វះខាតនោះទេ » ។
យើងក្រឡេកមើលស្ត្រីម្នាក់នេះ ដូចជានាងមានវត្តមានក្នុងសុភាសិតដ៏ល្អនេះ ។
( យ៉ូហាន ទី១ ៤:១៧ ) ដោយរបៀបនេះ សេចក្ដី ស្រឡាញ់ត្រូវបានបង្គ្រប់ក្នុងចំណោមយើង ដើម្បីឲ្យយើងមានទំនុក ចិត្តនៅថ្ងៃជំនុំ ជំរះ ពីព្រោះក្នុងពិភពលោកនេះ យើងដូចជា លោក ។
តើប្រជាជនអាចនិយាយថា « វាជាចំណែក » ដោយរបៀប ណាពេលពួកគេមិនដឹងថានោះជាអ្វី ហើយម៉ូសេ ត្រូវប្រាប់ពួកគេថា នោះ ជានំប៉័ងដែលព្រះ យេហូវ៉ាបានប្រទានដល់អ្នក ជាអាហារ ?
ដូច្នេះ គាត់ អាច សម្លាប់ យើង ។
យើង ចង់ លុបបំបាត់ រដ្ឋ ។
អាឌី សម្រាប់ ជីវិត ។
មនុស្ស គ្រប់ រូប អាច ស្មាន ថា បេះដូង ស្ត្រី ។
ខ្ញុំចាំថាទ្វារចូលទៅណា ។
មនុស្ស បាន បង្កើត ឧបករណ៍ ដើម្បី ជួយ ពួកគេ ចងចាំ កន្លែង ដែល ពួកគេ មាន បញ្ហា គណិតវិទ្យា ។
អគារទាំងមូលត្រូវបានបំផ្លាញ » ។
នេះ ពិតជា ល្អ ណាស់ ខ្ញុំ ឃ្លាន ណាស់ ។
ហើយ មាន ជំនឿ លើ ខ្ញុំ បន្តិច
ការបង្រៀន របស់ វា អនុវត្ត ចំពោះ ជីវិត ទាំងអស់ ។
ចូរពួកគេនិយាយដូច្នេះថា ព្រះ‌ អម្ចាស់បានប្រោស លោះពីកណ្ដាប់ដៃរបស់ខ្មាំង ស ត្រូវ * ហើយបានប្រមូលផ្ដុំគ្នាចេញពីប្រទេសនានា ។
នោះ ជា ការបកស្រាយ របស់ ខ្ញុំ !
ឥឡូវនេះ មាន វិធី មួយ ផ្សេង ទៀត ដែល អ្នក ប្រហែលជា អាច ស្វែងរក ស្ថានភាព របស់ អ្នក ។
កែច្នៃ សម្ភារៈ ដែល យើង បាន បាញ់ បង្ហោះ ទៅក្នុង លំហ ។
ប្រាប់ ខ្ញុំ ពី អ្វី ដែល ខ្ញុំ គួរ ធ្វើ បន្ទាប់ពី ការទះដៃ , ម៉ាក់ ។
មានការ ស្រែកយំពេញផ្លូវពេញមួយយប់ ហើយខ្ញុំមិនអាចដេក លក់ទេ ។
អ្នក ទាំងអស់ គ្នា ប្រហែលជា ដឹង ថា វា និយាយ អំពី អ្វី ។
" ត្រូវបាន សង្គ្រោះនៅថ្ងៃនេះ ... " តើយើងពិតជាបាន សង្គ្រោះពីអ្វី ?
២៦ នៅកន្លែងដែលគេនិយាយថា ‹ អ្នកមិនមែនជា រាស្ដ្ររបស់យើងទេ › នោះគេនឹងហៅថា ‹ កូនរបស់ព្រះ ដ៏មានព្រះជន្មរស់ ›» ។
ពពកសាធារណៈ ត្រូវបាន បង្ហោះ ដោយ ទី បី
នាងដាក់ឈ្មោះវ៉ាលីនាងថាជាកាបូប » ។
ជា ការពិត ណាស់ យើង នឹង ពិចារណា ពី អ្វី ដែល យើង អាច ធ្វើ សម្រាប់ ពួកគេ ប៉ុន្តែ នោះ ជា ជំហាន ដ៏ សំខាន់ មួយ ឆ្ពោះទៅ មុខ ។
អ្នកនឹងមិនទៅមន្ទីរពេទ្យទេ លុះត្រាតែអ្នកមិនទាន់ស្លាប់ » ។
ដើម្បីបំផ្លាញពួកគេ ដើម្បីឲ្យលោកបានក្លាយជាកំពូល
វាជាកន្លែងដែលខ្ញុំតែងតែចូល ចិត្តរស់នៅទីនោះប្រហែល ២៥ ឆ្នាំ មកហើយ ។
មិនមែនដោយ សារ តែគ្រោះថ្នាក់នេះទេ ។
បេះដូង នៃ ម៉ាឡាកា ប្រទេស ម៉ាឡេស៊ី ។
ខ្ញុំ សង្ឃឹម ថា អ្នក នឹង រកឃើញ ថា មាន ប្រយោជន៍
គាត់ និយាយ ថា “ កំណាព្យ នេះ មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ខ្ញុំ និង ជីវិត របស់ ខ្ញុំ ។
ដើម្បីឱ្យសប្បុរសជនឈានដល់រាប់ពាន់លានត្រូវធ្វើ ៥ យ៉ាងនេះ ...
ពេលនេះ ប្រពន្ធ របស់ អ្នក កំពុង តស៊ូ ។
រហូតមកដល់ពេលនេះនាងខ្លាំងណាស់ ។
អរគុណសារ៉ា ដែលនៅជាមួយខ្ញុំពីមួយថ្ងៃទៅមួយថ្ងៃ.. . វាមិនមែនជាការ ងាយស្រួលនោះទេ ។
" ស្លូវេនី មាន សក្តានុពល នៅក្នុង ឧស្សាហកម្ម កិច្ចប្រជុំ "
ស្រី ល្អ ទៅ ឋានសួគ៌ ស្រី អាក្រក់ ទៅ គ្រប់ ទីកន្លែង - សម្រង់ សម្តី
មើលមុខគាត់ខ្លាំងម្ល៉េះ !
តើអ្នកចង់រៀនបន្ថែមអំពីព្រះយេស៊ូវឬ ?
ដូច្នេះក្នុងករណីបែបនេះ សូមទៅជួបគ្រូពេទ្យភ្លាម ។
ចាប់ផ្តើម ថ្ងៃ របស់ អ្នក ជាមួយនឹង ការផឹក ទឹក ។
យើងមិនដឹងថា តើវាចេញពីផ្សារសើម ឬក៏នៅកន្លែងផ្សេងទៀត ។
កំពុង សម្លឹងមើល ។ ជាក់ស្តែង និង នៅលើ មុខ របស់ អ្នក ជារៀងរាល់ ថ្ងៃ ។
បើខ្ញុំ ជាអ្នក និពន្ធ ខ្ញុំមិនធ្វើអ៊ីចឹងទេ ។
នោះ គឺជា អ្វី ដែល ពួកគេ មាន ហើយ យើង ទាំងអស់ គ្នា ត្រូវការ ពួកគេ ។
ពួកគេជឿថាអ្នកនោះជាអ្នកដែលបានបង្កើតជីវិតទាំងអស់នៅលើផែនដី ហើយផ្តល់នូវអារម្មណ៍ និងបញ្ញា ។
ពួកគេ ជាអ្នក ដំបូងគេដែលតាំងលំនៅ លើកោះខាងត្បូង » ។
ប្រើប្រាស់ យ៉ាង ទូលំទូលាយ ដោយ អង្គការ សហ ប្រជាជាតិ ។
ព្រះអង្គជាអ្នកដែលបាន សង្គ្រោះអ៊ីស្រាអែល ។
ក្នុងចំណោមមនុស្សដែលគាត់បានរកឃើញនៅមាត់ទឹកនិងជនក្រីក្រ, .
« យើងបានរកឃើញថាបុរសនេះជាអ្នកបង្កបញ្ហា បង្ក ចលាចលក្នុងចំណោមជន ជាតិយូដា ទូទាំងពិភពលោក ។
ប៉ុន្តែ បន្ទាប់មក គាត់ ត្រូវ សួរ អំពី ដំណើរ ស្វែងរក របស់ នាង ។
ម៉ាក់ និង ខ្ញុំ ជា ថ្ងៃ នៃ ផ្នែក របស់ ខ្ញុំ ។
ទីក្រុង របស់ យើង បាន ធ្លាក់ ចូល ទៅក្នុង ដៃ របស់
អ្នក មិន មាន ស្ថេរភាព រហូតដល់ អ្នកបញ្ចប់ ការថែទាំ ។
( ម៉ាថា យ ២៨: ១៨ ) បន្ទាប់មក ព្រះ យេស៊ូបានចូលមក ឯពួកគេ ហើយមានព្រះបន្ទូល ថា៖ « គ្រប់ទាំងអំណាចនៅស្ថាន សួគ៌ និងនៅផែនដីបានប្រគល់ឲ្យខ្ញុំ ។
បន្ទាប់មក បី ហើយ ឥឡូវនេះ វា ជា ផ្លូវ នៃ ជីវិត ។
វា ត្រូវតែ មកពី កន្លែង ជ្រៅ ។
ការបង្កើត ទាំងមូល ត្រូវបាន ហែក ហួរ ដោយ ការ មិន ស្តាប់ បង្គាប់ និង អំពើពុករលួយ ហើយ ការបង្កើត ទាំងមូល ត្រូវ ស្តីបន្ទោស ។
ស្ត្រីនេះកំពុងព្យាយាមផ្ទុក សេះរបស់នាង ។
យើងកំពុងជួយគាត់ក្នុងការ ស្រាវជ្រាវរបស់គាត់ » ។
តម្លៃ រដ្ឋធម្មនុញ្ញ នៃ សារៈសំខាន់ ខ្ពស់ បំផុត នៅក្នុង សង្គម ប្រជាធិបតេយ្យ ។
ប៉ុន្តែ ភាគ ច្រើន មិន មែន ទេ ។
ទ្រង់បានធ្វើផ្លូវឲ្យយើងរួច ពីចំណងនៃអំពើ បាប ។
ដូច្នេះ អ្នក មិន អាច ប្រើ សញ្ញា ផ្កាយ បាន ទេ ។
ដូច្នេះតើអ្នកអាចធ្វើ ដូចម្តេចដើម្បីទប់ស្កាត់ ការ ផ្ទុះកំហឹង ទឹកភ្នែក ឬអាក្រក់ជាងនេះ?
ពួកគេ បាន សម្រេចចិត្ត ធ្វើ ការស្ទង់ មតិ ។
បោះការ ប្រុងប្រយ័ត្នទៅនឹងខ្យល់ហើយជឿថាវាបានធ្វើមុនពេលដែលវាត្រូវបានធ្វើ។
យើងអាចវាយពួកគេបាន ព្រោះយើងមានព្រះ នៅខាងយើង ។
សូម អោយ មាន សន្តិភាព នៅ ថ្ងៃ ខាងមុខ ។
ពួកគេ ត្រូវបាន រៀន តាមរយៈ ការទំនាក់ទំនង ជាមួយ មនុស្ស ផ្សេង ទៀត ។
អ្នកប្រៀបដូចជាអ័ព្ទដែលលេចចេញមួយ រយៈពេលបន្តិច បន្ទាប់មកក៏បាត់ទៅ ។
ប៉ុន្តែខ្ញុំមានប្រធានបទមួយដែលរំជួល ចិត្តក្នុង ចិត្តសម្រាប់ឆ្នាំនេះ ។
តើនរណាទទួលបាន ផលប្រយោជន៍ពីករណីបែបនេះដែលបានកើតឡើងក្នុងពេលជាមួយគ្នាដែលរដ្ឋាភិបាលកំពុងនិយាយអំពីសន្តិភាព និងសុវត្ថិភាពសម្រាប់ប្រជាពលរដ្ឋ ? . . .
៤ ព្រោះបើទ្រង់គង់នៅលើផែនដី ទ្រង់មិនគួរធ្វើជា សង្ឃទេ ដោយឃើញថាមាន សង្ឃថ្វាយទានតាមច្បាប់ ។
ហើយគាត់នឹងឈរ ដ្បិតព្រះអម្ចាស់អាចធ្វើឲ្យគាត់ឈរបាន ។
ហើយគាត់នឹងឈរ ដ្បិតព្រះ‌ អម្ចាស់អាចធ្វើឲ្យគាត់ឈរបាន ។
គាត់ បាន បោះ ខ្សែ ពួរ ដ៏ ច្របូកច្របល់ មក ខ្ញុំ ។
ហេ ខ្ញុំ ត្រូវបាន បង្រៀ ន៖
ខ្ញុំមិនឲ្យអ្នក ណាធ្វើអ្វីដែលគេមិនចង់ធ្វើនោះទេ » ។
បញ្ច្រាសភាព ស្ពឹក៖ មម ។
នាងប្រាប់ថាគាត់ជាមនុស្សស្លាប់។
ក្នុង នាម ជា គ្រូបង្វឹក សម្រាប់ ប្រាំមួយ ដំបូង
នាំយក កីឡា បេស្បល ។
ប៉ុន្តែពេលខ្ញុំកំពុងលាងចាន ខ្ញុំគិតក្នុង ចិត្តថា “ មានកូនម្នាក់ទៀតទេ ?
ប៉ុន្តែប្រសិនបើគេនិយាយទៅ កាន់អ្នក ចូរកុំឆ្លើយទៅគេឡើយ ។
កិច្ចព្រមព្រៀង សន្តិភាព ត្រូវបាន សម្រេច ។
អ្នកដែល ចិត្តបរិសុទ្ធ
បូជាចារ្យ ដកដៃចេញហាក់ដូចជាត្រូវគេដុត ។
ពេលខ្ញុំ មកដល់ផ្ទះនាងនឹងរង់ចាំ ។
ពីអាស៊ីដែលមិនធ្លាប់មានពីមុន មក » ។
« កុំធ្វើឲ្យខូចដី ឬសមុទ្រ ឬដើមឈើឡើយ ទាល់ តែយើងដាក់ ត្រានៅលើថ្ងាសអ្នក បម្រើនៃព្រះ នៃយើង » ។
នេះជាជំនួបមិនគួរឲ្យជឿ និងមានផលិតភាព ជាមួយនឹងលទ្ធភាពគ្មានដែនកំណត់សម្រាប់ទាំងសហរដ្ឋអាមេរិក និងចិន ។
ខ្ញុំគ្មានប្រយោជន៍សម្រាប់បងប្អូនទេ ។
២៨ ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា ក្នុងចំណោមអ្នកដែលកើតពីស្ត្រី គ្មានអ្នក ណាធំជាងលោក យ៉ូហានឡើយ ។ ប៉ុន្តែ អ្នក ណាដែលតូចជាងគេក្នុងព្រះរាជាណាចក្ររបស់ព្រះ នោះធំជាងគាត់ ។
តារាសម្ដែងក្រីក្រម្នាក់មានបញ្ហាក្នុងការបង់ថ្លៃជួល ។
ហើយ គាត់ ផ្តល់ ច្រើន ។
តើ អ្នក ត្រូវការផលប័ត្រ អ្នក ត្រូវការទំព័រ ក្រុម តើ អ្នក ត្រូវការ សេវាកម្ម ដែរ ឬ ទេ ។
ទោះ ខ្ញុំ ស្គាល់ គេ ក៏ ខ្ញុំ មិន ចែករំលែក ដែរ ។
ប្រហែលជាដោយសារគាត់អាចយកខ្លួនគាត់ទៅ កាន់ដំណឹង ល្អវិញ ។
ពួកគេ ចង់ ប្រើ ម៉ឺនុយ ដើម ។
ហើយ គាត់ បាន បំពេញ កាតព្វកិច្ច របស់ គាត់ ដោយ កាតព្វកិច្ច ។
គាត់ បាន ប៉ាន់ប្រមាណ ថា ក្រុមហ៊ុន ឱសថ ផ្សេង ទៀត នឹង អាច ចាប់ផ្តើម ផលិត ថ្នាំ គ្រាប់ ក្នុង រយៈពេល ប៉ុន្មាន ខែ ប៉ុន្តែ បាន ទទួលស្គាល់ ថា កិច្ចព្រមព្រៀង នេះ នឹង មិន ពេញចិត្ត គ្រប់ គ្នា នោះ ទេ ។
ចន សុន បាន ឆ្លើយតប ដោយ ទទូច ថា " ដូច ដែល ច្បាប់ បាន កំណត់ យើង ចាកចេញ នៅ ថ្ងៃទី 31 ខែតុលា ហើយ ខ្ញុំ សង្ឃឹម យ៉ាង ខ្លាំង ថា យើង នឹង ទទួលបាន កិច្ចព្រមព្រៀង មួយ ហើយ ខ្ញុំ គិត ថា អ្វី ដែល ប្រជាជន នៃ ប្រទេស ចង់បាន គឺ ចង់ ឃើញ សមាជិក សភា មក រួមគ្នា ធ្វើ ការ ដើម្បី ផលប្រយោជន៍ ជាតិ ដើម្បី ទទួលបាន ។ កិច្ចការនេះបានធ្វើហើយ នោះជាអ្វីដែលយើងនឹងធ្វើ » ។
ប៉ះពាល់ ដល់ ការរស់រាន មាន ជីវិត របស់ មនុស្សជាតិ ?
ជីវិត របស់ កូន ៗ របស់ អ្នក ទាំងអស់ ។
" ខ្ញុំ បាន សារភាព ប្រាប់ ពួកគេ ថា ពាក្យសម្ដី តែងតែ មិន គ្រប់គ្រាន់ ក្នុង ស្ថានភាព បែប នេះ ប៉ុន្តែ ភារកិច្ច ចម្បង របស់ ខ្ញុំ គឺ ធ្វើជា អ្នកតំណាង នៃ ប្រទេស ទាំងមូល ហើយ ឱ្យ ពួកគេ ដឹង ថា យើង កំពុង គិត អំពី ពួកគេ នៅ ពេល នេះ ហើយ នឹង បន្ត គិត ។ អំពី ពួកគេ ជារៀងរាល់ ថ្ងៃ ” លោក អូបាម៉ា បាន ប្រាប់ អ្នកយកព័ត៌មាន បន្ទាប់ពី កិច្ចប្រជុំ នៅ មន្ទីរពេទ្យ សាកលវិទ្យាល័យ Colorado ។
« មើល អញ នាំគេ មករកឯង ដើម្បីឲ្យឯងដឹងថា ខ្ញុំ រកមិនឃើញមានមូល ដ្ឋានចោទប្រកាន់គាត់ »
បញ្ហាថ្មីដែលកើតចេញពីអតីតជោគជ័យកំពុងរង់ចាំរដ្ឋបាលថ្មី ។
ដូច្នេះប្រសិនបើជីវិតរបស់អ្នកជួបបញ្ហា វាជាកំហុសរបស់អ្នក ។
ផ្តល់ឱ្យ ដែល មិន ត្រូវបាន កើត ចេញពី ការពិត ឧទាហរណ៍ នៅពេល ជា មធ្យម
ការពិន័យ របស់ ខ្ញុំ សម្រាប់ ការបំពាន នេះ គឺ ធ្លាក់ លើ ផ្លូវ ។
ការ មិន យល់ព្រម ភ្លាម ៗ ដោយ ការកើនឡើង ខ្ពស់ ។
ខណៈ ដែល ទស្សវត្សរ៍ ក្រោយ នឹង បង្ហាញ ឱ្យ ឃើញ គាត់ បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បី ទទួលយក ភាពយន្ដ ហូលីវូដ ។
ស្ត្រីដែលជាប់គុក១៨ ឆ្នាំប្រាប់រឿងរបស់ខ្លួន ។ - ២.
តើ អ្នកណា មិន អាច សប្បាយ ចិត្ត ជាមួយនឹង លទ្ធផល ទាំងនោះ ?
« ដោយ សារផ្ទះនេះមានផ្ទះ សម្បែងច្រើន ទើបមនុស្សចូល ចិត្តមកទីនេះ » ។
« ខ្ញុំធានាថាថ្ងៃនេះអ្នកនឹងនៅជាមួយខ្ញុំនៅឋានសួគ៌ » ។
មានមនុស្សជាច្រើនបានសួរថា តើយើងមានអំណោយគ្រប់គ្រាន់ដែរឬទេ ?
ទោះបីជា អ្នកដឹងខ្លួន ក៏ដោយ សូម កុំ ធ្វេសប្រហែស ដំបូន្មាន នេះ ។
មនុស្សគ្រប់គ្នាដែលមានខួរក្បាលនៅក្នុងក្បាលដឹងថាវា លម្អៀង ។
ខ្ញុំ សង្ឃឹម ថា ពួកគេ អាច ជម្រះ ក្បាល របស់ ពួកគេ តាម របៀប វិជ្ជមាន ។
មនុស្ស ជាច្រើន នៅក្នុង ប្រទេស ចិន ចូលចិត្ត ញ៉ាំ វា ។
វួដ សម្រាប់ ពួកគេ ; ប៉ុន្តែពួកគេមានមនុស្សច្រើនកុះករ
17 ប៉ុន្តែអ្នក ណាដែលចូលរួមជាមួយនឹងព្រះ‌ អម្ចាស់ នោះជា វិញ្ញាណ តែមួយនៅ ជាមួយនឹងទ្រង់ ។
ហើយ នាង បាន ផឹក ច្រើន ជាង ស្រាបៀរ បន្តិច ។
ក្នុងការ អស់សង្ឃឹមដើម្បីបន្តជាមួយនឹងអំពើអាក្រក់ ពួកគេនឹងត្រូវចាប់បាន ។
រដ្ឋាភិបាលថ្មីរួមមានស្ត្រីបីនាក់។
អ្វីដែលអ្នកហៅថាទ្រុងរបស់អ្នក
ដោយសារតែ គាត់ ជា នាង ។
នៅ ចុងបញ្ចប់ នៃ ថ្ងៃ គាត់ ចង់ឱ្យ គ្រប់ ចន្លោះ ទាំងអស់ ។
បើអ្នកឈប់ឥឡូវនេះ អ្នកនឹងឈប់ពេញមួយជីវិត !
នៅ ពេល ដែល នៅ ទីនោះ ពួកគេ បាន ចាប់ផ្តើម ជីវិត របស់ ពួកគេ ។
13 យុវនារីដែល រស់នៅក្នុងសួនច្បារ ខណៈមិត្ត ភក្តិរបស់អ្នកកំពុងតែស្តាប់សំឡេងរបស់អ្នក សូមឲ្យខ្ញុំបានឮ .. .
សហគ្រាស - បំពេញ ជាមុន ដោយ ឈ្មោះ ទ្រព្យសម្បត្តិ របស់ អ្នក ។
សម្ពាធ នឹង ទៅដល់ ពួកគេ ។
បាន ទទូច ថា គេហទំព័រ នេះ អាច ត្រូវបាន ផ្លាស់ទី បន្ថែម ទៀត បន្ទាប់ពី ជាច្រើន ។
គ្រួសារ ខ្ញុំ សប្បាយ ចិត្ត !
ជារឿយ ៗ ពួកគេ បាន ព្យាយាម ផ្តល់ឱ្យ គាត់ នូវ អត្ថប្រយោជន៍ នៃ ការសង្ស័យ ដោយ គ្រាន់តែ ឱ្យ វា ខាំ ពួកគេ នៅក្នុង គូទ ប៉ុណ្ណោះ ។
នាងបាននិយាយថា៖ « គាត់បានស្លាប់ដោយផ្ទាំងថ្មស្អាតព្រោះគាត់ជាមនុស្សល្អ » ។
ខ្ញុំ កំពុង និយាយ អំពី អ្វី ដែល ខ្ញុំ បាន សាកល្បង ខ្លួន ឯង ។
ថ្ងៃ មួយ នាង បាន ធ្វើឱ្យ ខ្ញុំ ហោះហើរ នៅលើ មេឃ ។
មួយ នៃ នំត្រជាក់ បំផុត ។
បើមិនដូច្នេះទេ អ្នកដែលបដិសេធ ឬមិនព្រមធ្វើនេះនឹងត្រូវបោះចូលទៅក្នុងបឹងភ្លើង ។
ថ្កោល ទោស ប្រធានាធិបតី ។
ហើយ ឥឡូវនេះ ខ្ញុំ បាន យល់ ពី មូលហេតុ ដែល គាត់ ទុក ម៉ាស៊ីន ឱ្យ ដំណើរការ ។
តើអ្នកដឹងទេថា តើពេល ណាដែលពួកគេអាចនឹងមើលការ ទាមទារម្ដងទៀត ?
កម្ពស់ រលកដែលគេហៅថាអំព្លី ទីត ។
" អ្នក ជាអ្នកដែលត្រូវមក ឬយើងត្រូវចាំអ្នកផ្សេង ? "
ការអភ័យទោស មិន ទទូច លើ វិធី ផ្ទាល់ខ្លួន ; វាមិនមែនជាការ ខឹង សម្បាឬអាក់ អន់ ចិត្តទេ » ។
គាត់បានសម្រេច ចិត្តមកទីនេះជាមួយខ្ញុំ ពេលខ្ញុំនៅក្នុងការិយាល័យនាយក » ។
គាត់ បាន មើល ក្តារ ថ្ងូរ
ខ្ញុំមានក្រដាសមួយក្នុងដៃ ព្រោះខ្ញុំបានវាយអក្សរ ។
តាមពិត ទៅ អ្នក ប្រហែលជា មិន គិត ទេ ថា អ្នក នឹង ទទួលបាន ទាំងអស់ ក្នុង មួយ គូ ។
នេះ អនុញ្ញាតឱ្យ មាន ការវិភាគ អំពី អាហារ ទាំងអស់ នៅក្នុង ការលក់ ។
ដាក់ ស្លាក អ្វី ដែល ល្អ និង អាក្រក់ ។
យើងចង់បានរដ្ឋអភិវឌ្ឍន៍ដែលសន្តិសុខត្រូវបានធានា » ។
ហេតុ អ្វី បានជា អ្នក យក កូនប្រុស របស់ ខ្ញុំ ?
កុំ ព្យាយាម ក្លាយជា ធំ ពេញ មួយ យប់ ។
សម្រាប់ អាពាហ៍ពិពាហ៍ ខាងលិច វឺជីនៀ នៃ ឆ្នាំ ។
ដ្បិតយើងជាព្រះវិហារនៃព្រះ ដ៏មានព្រះជន្មគង់នៅ ដូចព្រះ បានមានព្រះបន្ទូលថា ៖ យើងនឹងស្នាក់នៅ ហើយដើរនៅក្នុងចំណោមពួកគេ ហើយយើងនឹងធ្វើជាព្រះ របស់គេ ហើយគេនឹងធ្វើជាប្រជារាស្ត្ររបស់យើង ។
ផ្ទុយទៅវិញ ព្រះបាន បញ្ជាក់ យ៉ាង ច្បាស់ ដល់ គាត់ ថា វា គឺជា អាកប្បកិរិយា របស់ គាត់ ចំពោះ ការដឹកនាំ របស់ ព្រះ ដែល នឹង បង្ហាញ ថា គាត់ ជា ស្តេច ល្អ ឬ អាក្រក់ ។
ស្ថិតិ បង្ហាញ ថា ប្រាំបួន ផ្សេង ទៀត មិន តែងតែ ធ្វើ ដូច្នេះ ទេ ។
« ខ្ញុំនឹងរីក រាយនិងត្រេក អរចំពោះសេចក្តី ស្រឡាញ់ដែលមិនចេះចប់របស់អ្នក ដ្បិតអ្នកបានឃើញទុក្ខលំបាករបស់ខ្ញុំ ហើយអ្នកខ្វល់ខ្វាយពីទុក្ខព្រួយនៃព្រលឹងខ្ញុំ ។
នេះ ជារឿងមួយក្នុងចំណោមរបស់ខ្ញុំ ត្រូវ តែប៉ុន្មានឆ្នាំក្រោយ មក ។
កុំឲ្យអ្នក ណានិយាយពេលដែលត្រូវល្បួងថា “ ខ្ញុំត្រូវបានព្រះល្បួង ” ពីព្រោះព្រះ មិនអាចល្បួងដោយអំពើអាក្រក់បានទេ ហើយទ្រង់ក៏មិនល្បួងអ្នក ណាដែរ ។
ហើយសេចក្ដី ស្លាប់គឺជាសេចក្ដី ស្លាប់មែនទេ ?
ខ្ញុំ សង្ឃឹម ថា អ្នក ម្នាក់ ៗ មាន ថ្ងៃ ដ៏ អស្ចារ្យ ។
ឥឡូវនេះ គាត់ នៅតែ តស៊ូ ជាមួយ ជំងឺ ផ្តាសាយ ។
ម្សៅកំណត់ទាំងនេះគឺគ្មានទម្ងន់ ហើយមានច្រើនពណ៌ ។
បំណុល នេះ ត្រូវបាន លក់ ទៅ ឱ្យ ភ្នាក់ងារ ប្រមូល បំណុល ..
នេះជាវិធីសាស្ត្រដ៏មានប្រសិទ្ធភាពមួយទៀតដើម្បីធ្វើឱ្យធ្មេញរបស់អ្នកភ្លឺ ។
ពួកគេឆ្លើយ ថា៖ « ដោយរីករាយ បើសិនជាស្ដេចចេញ បញ្ជា » ។
វត្ថុ ទាំង ពីរ នេះ នឹង មាន ប្រយោជន៍ នៅពេល អ្នក កំពុង បង្រៀន កូន របស់ អ្នក ។
ខ្ញុំគិតអំពី ក្តី សង្ឃឹមដែលខ្ញុំបានទុកក្នុង ចិត្ត ។
ស៊េរីនេះបានចាប់ផ្ដើមទទួលបានចំហាយខ្លះនៅទីនេះ ។
ប៉ុន្តែអ្វីទៅជា លទ្ធផលដែលមិនបានកើតឡើង ?
ទោះ យ៉ាងណា ក៏ដោយ នៅក្នុង អត្ថបទ បន្ទាប់
យើង ទាំងអស់ គ្នា លះបង់ ដើម្បី មនុស្ស ដែល យើង ស្រលាញ់ ។
អនុញ្ញាតឱ្យ ឆ្លើយ វា ។
ទោះ យ៉ាងណា ក៏ដោយ ចាប់តាំងពី យើង កំណត់ រួចហើយ
ខ្ញុំមិនចង់ឱ្យសាធារណជន វិនិច្ឆ័យគិលានុបដ្ឋាយិកាទាំងអស់ដោយផ្អែកលើរូបភាពរបស់ខ្ញុំទេ ។
ពួកគេមួយចំនួនមានការ ចាប់អារម្មណ៍បែបនេះ » ។
មាន សត្វ ជាច្រើន នៅលើ ភព ផែនដី ដែល នៅតែ មិន ស្គាល់ នរណា ម្នាក់ សូម្បីតែ អ្នកវិទ្យាសាស្ត្រ ក៏ដោយ ។
ដូច្នេះហើយថ្ងៃដែលកូនយកប្តីជាថ្ងៃសិរីមង្គល
ដូច្នេះ វា មិន ទំនង ថា អ្នកបម្រើ នៃ ដំណឹង ល្អ ដែល ជា មធ្យោបាយ នៃ ការបង្វែរ មនុស្ស ជាច្រើន ទៅ រក សេចក្តីសុចរិត នោះ នឹង ភ្លឺ ជាង អ្នក ដែល មាន ប្រាជ្ញា ឬ អ្នក ដែល ពួកគេ អាច ជា មធ្យោបាយ នៅក្នុង ព្រះហស្ត នៃ ព្រះ នៃ ការងាក ទៅ រក សេចក្តីសុចរិត នោះ ទេ ។ .
ចិញ្ចឹម កូនប្រុស ដែល ជា មនុស្ស ពូកែ ។
ដំណើរការ រៀបចំផែនការ នេះគួរតែចាប់ផ្តើមជាច្រើនឆ្នាំមក ហើយ » ។
2 គេបានចងគាត់ នាំគាត់ទៅ ហើយប្រគល់ទៅឲ្យពី ឡាត់ ជាអភិបាល ។
អន់ចិត្ត នឹង ភាពល្ងង់ខ្លៅ របស់ អ្នកដទៃ ?
