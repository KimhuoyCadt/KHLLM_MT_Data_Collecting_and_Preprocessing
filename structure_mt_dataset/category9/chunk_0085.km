នេះ ជា រឿង ចុងក្រោយ ដែល អ្នក ចង់បាន ។
៣៨ ប្រសិនបើអ្នក ណាមិនទទួលស្គាល់ការ នេះ អ្នក នោះនឹងមិនទទួលស្គាល់ឡើយ ។
រយៈពេល នៃ ពេលវេលា អាច ផ្លាស់ប្តូរ ការយល់ឃើញ នៃ អត្ថន័យ របស់ វា ។
នាងនៅបន្ទប់ជួលឥឡូវនេះ ។
មេដឹកនាំ ភេរវករ ប្រាប់ ពួកគេ ថា ពួកគេ ម្នាក់ ៗ ទទួលបាន សំណើ មួយ ។
ហើយប្រទាន ពរដល់ទ្រង់គ្រប់ពេល ។
គាត់ប្រាប់ខ្លួនគាត់ថា គាត់ស្តាប់ដោយគួរសមក្នុងនាមជាភ្ញៀវ ។
ម៉ូសេត្រឡប់ ទៅ ស្រុក អេស៊ីប វិញ ។
មានពេលមួយ មានបុរសពីរនាក់ដូចគ្នាកំពុងផឹកស្រាក្នុងបារ ។
ហ្គារី និយាយ ហើយ រំខាន គំនិត របស់ គាត់ ។
ជាធម្មតា វា កើតឡើង ភ្លាម ៗ បន្ទាប់ពី ទទួលទាន អាហារ រួច ។
ហ្វូងមនុស្សខ្លះស្រែករឿងមួយ ខណៈអ្នកខ្លះទៀតស្រែកអ្វីផ្សេង ។
នេះ គឺជា អ្វី ដែល នឹង ជួយ យើង នាំ ក្រុមហ៊ុន ឆ្ពោះទៅ មុខ ក្នុង វិស័យ នេះ ។
អ្នក ប្រហែលជាឆ្ងល់ថាតើគ្រឿងសមុទ្រដុតមានអ្វីពិសេស ? និង ត្រឹមត្រូវ ដូច្នេះ ។
តើគាត់និងអ្នកគាំទ្រមិនអាចមើលឃើញការពិតនៅលើដីទេ ?
ឥឡូវនេះ ខ្ញុំនឹងអាចគ្រាន់ តែផ្ញើតំណទៅពួកគេ ។
ជាមួយ មិត្តភក្តិ របស់ គាត់ ?
ប៉ុន្តែ វា ប្រាកដជា មិន ត្រូវបាន បំពេញ ដោយ ព្រះទេ ។
ខ្ញុំខ្ជិលមក រកអ្នក ថ្មី អ្នក ធ្វើដើម្បីខ្ញុំ ។
ផ្លូវ ហាយវេជាច្រើន ក្នុង តំបន់ ត្រូវបាន បិទ ។
ព្រះអម្ចាស់មានព្រះបន្ទូលមក កាន់លោកម៉ូសេ បន្ទាប់ពីកូនប្រុសទាំងពីររបស់លោកអើរ៉ុនសោយទិវង្គត គឺពេលដែលពួកគេចូលទៅជិតព្រះអម្ចាស់ ហើយសោយទិវង្គត ។
ជីវិតមនុស្សទាំងនេះមិនមាន ភាព រ អាក់រ អួលទេ ។
« ប៉ុន្តែ ពេត្រុស និងសាវ័កឆ្លើយ ថា៖ « យើងត្រូវតែស្តាប់បង្គាប់ព្រះ ជាជាងមនុស្ស » ។
28 ហើយខ្ញុំឲ្យពួកគេនូវជីវិតអស់ កល្ប ជានិច្ច ហើយ ពួកគេ នឹង មិន វិនាស ឡើយ ហើយ គ្មាន នរណា ម្នាក់ អាច ដក ពួកគេ ចេញ ពី ដៃ ខ្ញុំ ឡើយ ។
ហើយបានចាត់កូនប្រុសរបស់គាត់ មកបង្ហាញយើងពីរបៀបដែលគាត់នៅជាមួយយើង ។
បងប្អូន ជា ទីស្រឡាញ់ អើយ ចូរ យើង ស្រឡាញ់ គ្នា ទៅ វិញ ទៅ មក ព្រោះ សេចក្ដីស្រឡាញ់ កើត ចេញ ពី ព្រះជាម្ចាស់ ។
ខ្ញុំ បាន ឈាន ទៅ ដំណាក់កាល ថ្មី នៃ ជីវិត របស់ ខ្ញុំ ។
ពួកគេត្រូវបានគេទម្លាក់ ចោល ហើយវាបានបំផ្លាញទំនុក ចិត្តរបស់ពួកគេ » ។
នាង ជាមួយនឹង ខ្សែ ពួរ ។
30 ព្រះអង្គមានព្រះបន្ទូលទៅគេដូច្នេះ ព្រោះគេពោលថា៖ « វិញ្ញាណអាក្រក់ចូល មក » ។
វា ឆ្លុះបញ្ចាំង ពី បទពិសោធន៍ របស់ ខ្ញុំ ហើយ វា បាន ក្លាយជា ភ្លេង ផ្ទាល់ខ្លួន របស់ ខ្ញុំ ។
ផ្ទុយទៅវិញ យើង អាច និយាយ បាន ថា ពេលវេលា ទាំងអស់ គឺ មកពី បច្ចុប្បន្ន ។
ការស្វាគមន៍ ដូចជា ស្ត្រី នៅក្នុង ជីវិត របស់ គាត់ ហើយ ក្លិន សមុទ្រ ។
ជាមួយនឹង ល្បឿន នៃ ការអភិវឌ្ឍន៍ ?
39 ជន ជាតិសាម៉ារី ជាច្រើននាក់ដែល មកពីក្រុងនោះបានជឿលើលោក ដោយ សារស្ត្រីនោះបានថ្លែង ទី បន្ទាល់ ថា៖ « គាត់ប្រាប់ខ្ញុំនូវអ្វីៗទាំងអស់ដែលខ្ញុំបានធ្វើ » ។
ម្តង នេះ គាត់ មិន សប្បាយ ចិត្ត ក្នុង ការចូល ទៅក្នុង ស្រមោល ។
វា មិន មែន ជា រឿង ភ្ញាក់ផ្អើល ទេ ដែល ឃើញ ឈ្មោះ ធំ ៗ មួយចំនួន ចាប់អារម្មណ៍ ។
ភាគ ច្រើន នៃ ពេលវេលា ជាមួយ ស្ត្រី វ័យ ចំណាស់ វា នឹង មិន មាន សម្ពាធ សម្រាប់ កុមារ ទេ ។
នោះនឹងជាការ ភ្ញាក់ផ្អើលសម្រាប់ស្វាមី ។
ពួកគេនឹងត្រូវគេសម្លាប់ ឬចាប់ខ្លួន » ។
ក្នុង អំឡុង ពេល អាណត្តិ ប្រាំមួយ ឆ្នាំ របស់ គាត់
១៨ ពេលនោះ មេ ក្រុងត្រូវចាប់ប្ដីវាយគាត់ ។
សួស្តី យើង កំពុង ធ្វើ ការ លើ បញ្ហា នេះ ។
ខ្ញុំចង់ឲ្យកូនស្រីរបស់ខ្ញុំមានតុល្យភាពជាងនេះ » ។
សត្វ របស់ អ្នក មាន ការផ្គត់ផ្គង់ ទឹក ជាប្រចាំ ។
និង រសជាតិ ហើយ មិន ត្រូវ បំពាន ។
ហើយកន្លែងដែលគេព្យួរ ផ្លុំខ្យល់នោះគឺជាការ រំឭកដល់សេចក្ដី មេត្តា ករុណា និងសេចក្ដី សប្បុរស ។
នៅ ផ្នែក ខាងក្រោម នៃ បន្ទះ ស្រទាប់ សូម បន្ថែម របាំង មួយ ។
ម៉េចក៏ម៉ែខ្ញុំជេរថាគាត់ពិបាកសម្រាប់ខ្ញុំ ។
ឬវាមកដល់ពេលដែលអ្នកកំពុង រត់ជុំវិញ ហើយអ្នកឆ្ងល់យ៉ាងខ្លាំ ង៖
3ខ្ញុំចង់ឲ្យអ្នកស្បថនឹងព្រះ‌ អម្ចាស់ ជាព្រះ នៃស្ថាន សួគ៌ និងជាព្រះ នៃផែនដីថា អ្នកនឹងមិនជ្រើស រើសប្រពន្ធសម្រាប់កូនប្រុសរបស់ខ្ញុំ ពីចំណោមកូនស្រីរបស់កេន ណា ដែលខ្ញុំ រស់នៅ ។
ប៉ុន្តែ អធិរាជ មាន សម្លៀកបំពាក់ ថ្មី ...
ទ្រង់ បាន ប្រទាន ទឹក ដល់ យើង ។
វាគឺជាការ នេះពួកគេកំពុងតែផឹកស្រា ហើយពួកគេកំពុងដាក់វាក្នុងខ្លួនរបស់ពួកគេ ។
« កាល ណាលោកបានយករបស់លោកចេញអស់ហើយ នោះលោកក៏បន្តទៅមុខពួកគេ ហើយចៀមរបស់លោកក៏តាមលោក ព្រោះពួកគេស្គាល់សំឡេងលោក ។
« កាល ណាលោកបានយករបស់លោកទាំងអស់ចេញហើយ នោះលោកក៏បន្តទៅមុខពួកគេ ហើយចៀមរបស់លោកដើរតាមលោក ដោយព្រោះពួកគេស្គាល់សំឡេងរបស់ លោក ។
ហើយតើអ្នកចង់បាន ន័យថាអ្វីដែលវាបានធ្វើ? តើ យើង កំពុង និយាយ អំណាច អ្វី ? ?
ជនជាតិ គុយ បា ដែល រស់ នៅ ក្រៅ ប្រទេស ដែល បាន សម្តែង ការខ្វែងគំនិត ជាសាធារណៈ
តើអ្នកមិនបានគិតថាវានឹងជាការ ទះ កំផ្លៀងសម្រាប់គាត់ឬ ?
ឥឡូវនេះ អ័ដាម ស្ម៊ីធ ជា ឧទាហរណ៍
ធម្មតា ដើម្បី គេច ដល់ ចំណុច កិត្តិយស ។
ពាណិជ្ជកម្ម អេឡិចត្រូនិក ដ៏ ធំ បាន ណែនាំ ការផ្គត់ផ្គង់ នេះ នៅលើ គេហទំព័រ របស់ ខ្លួន ។
នេះ ជា ករណី សម្រាប់ ស្ត្រី ច្រើន ជាង បុរស ។
អ្នក នឹង ត្រូវបាន សួរ ឱ្យ ជ្រើសរើស ប្រភេទ សមស្រប
ដើម្បី សង្គ្រោះ កូនប្រុស របស់ នាង ពី ភាពអាម៉ាស់ ។
« បងប្អូនអើយ ខ្ញុំសូមប្រកាសប្រាប់អ្នក រាល់គ្នាថា សាច់ និងឈាមមិនអាចទទួល គ្រងរាជ្យរបស់ព្រះជា ម ត៌កបាន ហើយក៏មិនអាចទទួល មរតករបស់ដែលវិនាសសាបសូន្យបានដែរ ។
