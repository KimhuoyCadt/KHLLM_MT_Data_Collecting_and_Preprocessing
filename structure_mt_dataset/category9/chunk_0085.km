១០ « ដ្បិតម៉ូសេ បាននិយាយថា ចូរគោរពឪពុកម្ដាយរបស់អ្នក ហើយអ្នក ណាដែលនិយាយអាក្រក់ ពីឪពុក ឬម្ដាយ អ្នក នោះនឹងត្រូវ ប្រហារជីវិត » ។
ហើយគាត់នឹង សោយរាជ្យលើ វង្សយ៉ាកុបជារៀងរហូត ហើយរាជ្យរបស់គាត់នឹងគ្មាន ទី បញ្ចប់ឡើយ ។
នាគ ត្រូវបាន ការពារ ។
ខ្ញុំ មាន កញ្ចប់ មួយ ទៀត សម្រាប់ អ្នក គាត់ ញញឹម ។
សក់ ស្កូវមុនអាយុមានរោគសញ្ញាតែពីរយ៉ាង៖
ចំណងជើង រង៖ សារព័ត៌មាន ។
អញ្ចឹង អ្នក ពិតជា សម្រេចបាន ក្នុង ជីវិត ហើយ ។
អ្វីដែលយើងបានឮថាអ្នកបានធ្វើនៅក្រុងកាពើណិម ចូរធ្វើនៅ ទីនេះក្នុងស្រុករបស់អ្នកផង »។ "
ដែល ជា ទី គាប់ ព្រះហឫទ័យ របស់ ព្រះទាំងអស់ ។
« មិនអាចគិតថាអ្វីបន្ទាប់ពីល្អដូចបងប្រុសទេ ?
ហើយបើគាត់មិនធ្វើ តើអ្នក ណាហ៊ានធ្វើ បាបគាត់ ?
ប្រុស និង ស្រី ល្អ និង អាក្រក់ ច្នៃប្រឌិត និង បំផ្លាញ ។
ដូច្នេះ ខ្ញុំ គិត ថា កំហុស នេះ អាច ដោះស្រាយ បាន ។
ភាព ងងឹតងងុល នៃ អ្នក មិន ជឿ ដោយ គ្មាន វិធី ណា បង្អាក់ ពី ភាពច្បាស់លាស់ នៃ ដំណឹង ល្អ នោះ ទេ ។
នេះ គឺជា រយៈពេល ដាំដុះ ផ្លែ ឈើ ។
១៧ គាត់ភ័យខ្លាច ហើយនិយាយថា៖ « កន្លែងនេះគួរឲ្យខ្លាចយ៉ាង ណា ! នេះមិនមែនជាផ្ទះរបស់ព្រះ ទេ ហើយនេះជាទ្វារនៃស្ថាន សួគ៌ ។
ហើយ ពួកគេ នឹង នៅ ទីនេះ នៅលើ ផែនដី ជានិច្ច ។
“ ខ្ញុំត្រូវបានគេផ្តល់អំណាច ប៉ុន្តែខ្ញុំមិនមែនជាអ្នកល្អបំផុតនោះទេ ។
ថ្នាក់ A ត្រូវបាន ប្រើ សម្រាប់ បណ្តាញ ធំ ដែល មាន ឧបករណ៍ បណ្តាញ ជាច្រើន ។
ខ្ញុំ ដឹង ថា ខ្ញុំ នឹង ក្លាយជា អ្នកដំបូង នៅក្នុង ជួរ ។
វា ប្រឆាំង នឹង ច្បាប់ ដែល ធ្វើឱ្យ ពួកគេ មិន ស្រួល ។
ព្រះយេស៊ូវ គឺជា អ្នក ដែល បាន និយាយ ថា គាត់ គឺជា ផ្លូវ តែ មួយ គត់ ។
សូមកុំបន្ទោសគេ » ។
បុរសម្នាក់ដែលត្រូវបញ្ចេញពួកគេម្នាក់ ៗគឺជាអ្នកឈ្នះ ។
ភួយ ថ្មី គឺ ពិតជា អ្វី ដែល ខ្ញុំ ចង់ឱ្យ វា ក្លាយជា ។
ក្រៅពីនោះ ពួកវាផ្ទុកទៅដោយសារធាតុប្រឆាំងអុកស៊ីតកម្ម ។
ច្រើន ជាង សាប៊ូ ។
អ្នកធ្វើ បទបង្ហាញ៖ តើ អ្នក នឹង ធ្វើ អ្វី ប្រសិនបើ អ្នក ដឹង ថា អ្នក រស់ នៅ បាន តែ មួយ ថ្ងៃ ឬមួយ សប្តាហ៍ ប៉ុណ្ណោះ ?
ឈរ នៅលើ កប៉ាល់ ពួកគេ អាច ឃើញ ដី និង សមុទ្រ ខាងក្រោម ។
ម៉្យាង វិញ ទៀត រដ្ឋ បាន បរាជ័យ ក្នុង ការយកឈ្នះ លើ ប្រជាជន
នេះ គឺជា បេះដូង នៃ ការកើនឡើង មហាវិទ្យាល័យ ។
មិនដូចច្បាប់ក្រោយដែលត្រូវបានបង្កើតឡើងក្នុងលក្ខខណ្ឌនៃការ ប្រឆាំង , i .
យើងមិនធ្វើអ្វីដែលមិនគាប់ព្រះហឫទ័យព្រះអម្ចាស់របស់យើងទេ ។
៣៨ ទោះបីគាត់ មកនៅម៉ោងទីពីរ ឬទី បីនៃយប់ក៏ដោយ ។
ហើយក៏គ្មានហេតុផលអ្វីក្រៅពីរឿងល្អទាំងអស់ត្រូវ តែ បញ្ចប់ដែរ ។
ហើយឯងក៏មានកូនប្រុសមួយដែរ !
ការ បង្រៀនដោយខ្លួនឯង ខ្ញុំដឹងថាខ្ញុំត្រូវរៀនច្រើនណាស់ ។
នាង ទើបតែ ត្រូវបាន គេ មើលឃើញ ។
ដូច្នេះ តើអ្វីទៅជាការ ទទួលខុសត្រូវរបស់ គ្រិស្ត បរិស័ទ ដែល ជាអ្នកជិតខាងខ្ញុំ ?
ហើយឥឡូវនេះខ្ញុំចង់បានការ ផ្លាស់ ប្តូរ - ខ្ញុំចង់បានអ្វីមួយដែលត្រូវធ្វើ។
ខុសពីនគរ ដទៃទៀត ហើយវានឹងលេបត្របាក់ផែនដីទាំងមូល ហើយនឹងជាន់ ឈ្លីវា ហើយកម្ទេចវាចោល ។
១៨ ឥឡូវនេះ ពួកសិស្សរបស់លោក យ៉ូហានបានប្រាប់គាត់អំពី ការ ទាំងអស់នេះ ។
ខ្ញុំគ្រាន់ តែចង់បន្តធ្វើអ្វីដែលខ្ញុំជឿជាក់ » ។
ប្រសិនបើ យើង ខ្វះ សេចក្តីជំនឿ ទ្រង់ នៅតែ ស្មោះត្រង់ នឹង ព្រះបន្ទូល របស់ ទ្រង់ ពីព្រោះ ទ្រង់ មិន អាច បដិសេធ ទ្រង់ បាន ទេ ។
ទោះ ជាយ៉ាង ណា មានអ្វីមួយចង់បញ្ចប់សុភមង្គលរបស់គាត់ ។
ការ ស្លាប់ដែលគំរាមគាត់ គាត់មិនដឹងទេ
ពួកគេបានលុបចោល កិច្ចព្រមព្រៀងរបស់ពួកគេក្នុងការ ដឹក ជញ្ជូនតន្ត្រី Zappa ។
យើងបានបាញ់មួយគ្រាប់ មក ទល់ ពេលនេះ ប៉ុន្តែខ្ញុំប្រាកដថានឹងមានច្រើនទៀត » ។
សាខា ទាំង បី របស់ ខ្លួន ក្នុង របៀប មួយ ដែល ធានា សុវត្ថិភាព និង សុខុមាលភាព
ខ្ញុំជឿថាការ ប្រកួតនេះគាត់នឹង បញ្ចប់ព្រោះគាត់ខឹងខ្លាំងណាស់ ។
ហើយក្រោយមក គាត់បានបន្តថា « ត្រចៀកខ្ញុំបានឮពីអ្នក ប៉ុន្តែឥឡូវនេះ ភ្នែកខ្ញុំបានឃើញអ្នកហើយ » ។
នេះ ជា អ្វី ដែល អាជ្ញាធរ និយាយ ។
វាមិនមែនជាទំព័រ ពិភាក្សាមួយក្នុងចំណោមទំព័រ ពិភាក្សា ជាច្រើននោះទេ » ។
យ៉ាង ណាក៏ដោយ ពួកគេបានសម្រេច ចិត្តស្វែង រកជំនួយ និង ...
ក្នុង ចំណោម ពរ ជ័យ របស់ បុរស ដែល កោតខ្លាច ព្រះអម្ចាស់ ។
តក្កវិជ្ជា ក្នុង ជំហាន ពីរ បី នាំ ទៅដល់ ការសន្និដ្ឋាន
« សូម ជំរាប សួរ មិត្ត សម្លាញ់ របស់ ខ្ញុំ អេប៉េណេតុស ដែល ជា អ្នក ប្រែចិត្ត ជឿ ដំបូង បង្អស់ ទៅកាន់ ព្រះគ្រីស្ទ នៅ ខេត្ត អាស៊ី ។
ចំពោះកុមារជនភៀសខ្លួនវ័យជំទង់ ចំនួនមានត្រឹមតែ ២២% ប៉ុណ្ណោះ ។
បន្ទាប់មក គាត់បានបន្តប្រាប់ខ្ញុំថា ខ្ញុំមើលទៅដូចកូនក្មេង ។
បាន ផ្លាស់ប្តូរ យ៉ាង លឿន នៅ ថ្ងៃ នេះ ។
ហើយឥឡូវនេះមិនត្រឹម តែស្រលាញ់គ្នាទេ យើងក៏ចូល ចិត្តគ្នាដែរ ។
ក្នុង រយៈពេល 30 ឆ្នាំ ខាងមុខ ពិភពលោក នឹង ឃើញ ការឈឺចាប់ ច្រើន ជាង សុភមង្គល ។
ប នា្ទាប់ មក បនា្ទាប់ មក បនា្ទាប់ ហើយ អនុវត្ត ចំពោះ ពួកវា នីមួយ ៗ ។
“ ខ្ញុំមិនដឹងថាហេតុអ្វីបានជាគេមិនទទួលខ្ញុំ ។
វគ្គ សិក្សា កាន់តែ ច្រើន ឡើង នៅ ទីនោះ ។
ដោត ចូល ទៅក្នុង ច្រក ផ្សេង ។
