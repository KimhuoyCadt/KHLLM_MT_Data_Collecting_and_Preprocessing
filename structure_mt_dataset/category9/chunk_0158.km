ខណៈ មាន មហាជន ជាច្រើន កំពុងតែ បន្ត ការចែករំលែក យ៉ាង កក្រើក លើ ដំណឹង មួយ នេះ ៕
ស្ត្រី សម្រស់ គ្រាន់តែ ប្រើ ដៃ អ្នក នឹង អាច ទទួលបាន ទ្រូង ធំ ហើយ
ព្រឹត្តិការណ៍ នេះ បាន កើតឡើង ពេល ខ្មែរ ក្រហម បាន ឡើង កាន់អំនា ច កាលពី អ្នកស្រី នៅ អាយុ៥ ឆ្នាំ ដល់ ៩ឆ្នាំ ។
យើង ត្រូវ ឆែក ពិនិត្យមើល ខ្លួន ឯង !
យើង ប្រឈមមុខ នឹង ការប្រឡូក ចូល ទៅក្នុង ទម្លាប់ និង វប៌្ប ធម ដែល ប្រែប្រួល ទៅ តាម សម័យកាល ទំនើប នេះ ណាស់ ។
ក្នុង ការអនុវត្តន៍ សម្រាប់ ជីវិត ការងារ ជំនួញ ។
លោកស្រី ក៏ ត្រូវបាន ហាមឃាត់ មិន ឱ្យ ទាក់ទង ជាមួយ សាក្សី ណាមួយ ផងដែរ ។
អ្នកភូមិ ប្រទះឃើញ សាកសព ស្ត្រី ម្នាក់ នៅក្នុង ព្រៃ ស្បូវ
មិត្ត ដែល ដឹង ពី របៀប នៃ ការគ្រប់គ្រង ស្ថានភាព នោះ អាច ជា អ្នក ជួយ ដ៏ សំខាន់ ។
ស្តាប់ សំឡេង លោក ឈាង វុន
ខ្លួនខ្ញុំ ផ្ទាល់ បាន ចុះ ទៅតាម បណ្តា ស្រុក ទៅ ជួប បេក្ខជន ឃុំ ទាំង ពេញ សិទ្ធិ ទាំងបម្រុង ជា បន្តបន្ទាប់ ។
តែ ទោះ យ៉ាងណា ទន្ទឹមនឹង ការដេក ទទួល លុយ ស្រួល ៗ
ក៏ដោយ តែង មិន សូវ សម ដូច ប្រកប ទេ គួរ មាន ការអត់ធ្មត់ បន្តិច ទើប ប្រសើរ ។
លោក មើលឃើញ ថា វីដេអូ ដែល បាន បែក ធ្លាយ នេះ វា ពិត ណាស់ ប្រាកដជា មាន ជាប់ពាក់ព័ន្ធ ជាមួយ ជន ត្រូវ ចោទ នេះ ។
លោក យ៉ែម រ៉ាវី និយាយ ដូច្នេះ ដោយ ចង្អុល ទៅកាន់ អគារ ខ្ពស់ ៗ
ជំងឺ ជាច្រើន អាច ប៉ះពាល់ ដល់ មុខងារ ផ្លូវភេទ និង ការបះ លិង្គ ។
ពួកគេ នឹង មិន ស្តាប់ ពួកគេ នឹង មិន ផ្លាស់ប្តូរ ពួកគេ នឹង មិន ប្រើ ធនធាន ចាំបាច់ ឬ ពួកគេ នឹង មិន ពីព្រោះ ពួកគេ គិត ថា ពួកគេ ស្គាល់ ច្បាស់ ។
ទារិកា ដែល គ្រូពេទ្យ បាន ជួយសង្គ្រោះ ឱ្យ មាន ជីវិត ។
នេះ ជា រូប ដែល តួ ស្រី គូរ ផ្ទាល់ នៅក្នុង សាច់រឿង ៚
កំណត់ត្រា ទាំង នេះ មាន នៅក្នុង របាយការណ៍ ប្រចាំ សប្តាហ៍ របស់ ការិយាល័យ ស្ថិតិ កសិកម្ម ។
ពួកគាត់ បាន រស់ នៅ ជុំគ្នា យ៉ាង សប្បាយរីករាយ អស់ រយៈពេល ជាង ទសវត្សរ៍ មក ហើយ ។
ការប្រុងប្រៀប ខ្លួន និង ផែនការនាំ អ្នក ទៅ រក ជោគជ័យ ប៉ុន្តែ អ្នក នឹង មិន ដឹង ប្រាកដ ទេ បើ អ្នក មិន សាកល្បង អនុវត្ត ផែនការ នោះ ។
លោក ហ៊ុន សែន ជួប និស្សិត ហុង ភារិន ដើម្បី បំពេញ បំណង របស់ គាត់
បាន បង្កើត ទំព័រ ដែល ផ្តើម ដោយ ក្រោយមក បន្ទាប់មក ក្រោយមក ទៀត អញ្ជឹង ហើយ
នេះ អាច ជា លទ្ធផល នៃ ភាពតានតឹង រាងកាយ និង អារម្មណ៍ ដែល អាច បង្កឱ្យ មាន បញ្ហា ទាំងនេះ ឬ វា អាច …
ទំនងជា មិន ងាយ ឆាប់ ស្លាប់ ជាង អ្នកជំងឺ ដែល មាន ទម្ងន់ ធម្មតា ឬ អ្នក ដែល ធាត់ ជ្រុល ឡើយ ។
មនុស្ស ម្នាក់ ក្នុង ចំណោម មនុស្ស ៤នាក់ នៅ ទូទាំង ពិភពលោក ទទួល រង ជំងឺ ផ្លូវចិត្ត នៅ ដំណាក់កាល ណាមួយ នៃ ជីវិត របស់ គេ ។
វា គ្រាន់តែ ជា បម្រែបម្រួល ដែល អាស្រ័យ ទៅ លើ ពេលវេលា ការ ងារ និង សុខភាព រាងកាយ តែ ប៉ុណ្ណោះ ។
មិន មាន ពេលវេលា ណា សម្រាប់ យកមកវិនិយោគ លើ ការផ្លាស់ប្តូរ បាន ល្អ ជាង ចាប់ផ្តើម ឥឡូវ ទេ !
ទៀត គឺជា ដំណើរការធម្មតា របស់ រាងកាយ ។
នេះ ពុំ គ្រាន់តែ ជា វិធី បន្ថយ អម្រែក ឱ្យ មនុស្ស ជា ទីស្រឡាញ់ តែ នៅ ជា វិធី ធ្វើឱ្យ មនោសញ្ចេតនា ប្តី ប្រពន្ធ កាន់តែ ផ្អែមល្ហែម សុភមង្គល ។
ផ្នែក គរបាយការណ៍ មន្ទីរពិសោធន៍
ដទៃ ទៀត ក៏ នឹង ត្រូវបាន លើក យកមក ពិភាគ្សា ។
គំនិត នេះ បាន ផ្លាស់ប្តូរ ក្នុង រយៈពេល ថ្មី ៗ
នៅ ពេល ដែល អ្នក មានអារម្មណ៍ ប្រសើរឡើង សូម គិត ក្នុង ការបង្កើត នូវ អាហារ ដែល ល្អ សម្រាប់ អ្នក
ក្រុង នគរ បឋម វិគី ភីឌា
តាម សង្ខាង ផ្លូវ គ្រប់ ៗ
ពី ពួគាត់ ទ្វេរ ដង លើស ពី ច្បាប់ កំណត់ ។
គឺ ថ្ងៃ ដែល ពួកយើង បាន ចាប់កំណើត និង មួយ ទៀត គឺជា ថ្ងៃ ដែល ពួកយើង បាន រកឃើញ អំពី មូលហេតុ ថា ហេតុ អ្វី ។
លោក បញ្ជាក់ ថា ការស្នើសុំ ឱ្យ បែងចែក ដី ក្រុមហ៊ុន មួយចំនួន ជូន ពលរដ្ឋ គឺ មិន អាច ធ្វើ បាន ឡើយ ៖
ព្រោះ អាច អោយ អូន បាន នៅក្នុង រង្វង់ ដៃ របស់ បង រៀងរាល់ ថ្ងៃ បាន ។
ចាប់តាំងពី សមាជិក រាជ វង្ស អង់គ្លេស ចាប់ផ្តើម រៀន និយាយ គឺ គេ បាន ប្រដៅ ឱ្យ អនុវត្ត តាម ការប្រើ ពាក្យ ដូច ខាងក្រោម នេះ ៖
កម្ពុជា គឺជា ដែនដី នៃ ឱកាស វិនិយោគ
ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ពិតជា មាន សារៈសំខាន់ ណាស់ សម្រាប់ អាជីវកម្ម នា ពេល បច្ចុប្បន្ន ។
លោក ដូណាល់ ត្រាំ ជា អ្នកនយោបាយ មួយ រូប ដែល គេ លំបាក នឹង ទាយ ចិត្ត គាត់ ត្រូវ ណាស់ ។
ប៉ុន្តែ ព្រះអង្គ ត្រូវបាន គណបក្ស កាន់អំណាច រារាំង មិន ឱ្យ ចូល នយោបាយ ក្រោម ហេតុផល បន្ថយ កម្លាំង បក្ស ប្រឆាំង ។
គឺជា អាហារ ល្អ ណាស់ សម្រាប់ ពេល យប់ ។
លោក អូម៉ា អាល់ បាសៀ កំពុង ត្រូវ ក្រុម យោធា ឃុំ ខ្លួន ក្នុង ផ្ទះ
ការបណ្តុះបណ្តាល គ្រូ បង្គោល
បើ និយាយ តាម ផ្លូវ សាសនា បណ្តា ទុក្ខ ទាំងអស់ រួម មាន ត្រឹមតែ ពីរ ប៉ុណ្ណោះ គឺ ទុក្ខ ផ្លូវកាយ និង ទុក្ខ ផ្លូវចិត្ត ។
អ្នក ខ្លះ ស្រក់ ទឹកភ្នែក ដោយសារតែ លោក ចេញ វា ចា បែប នេះ ។
ចុម ញុំ ក្លាយទៅជា បង ពី អង្កាល់ ចាស់ ញុំ អស់ ហើយ ៕
ការប្រកែក របស់ លោក ជុន ច័ន្ទ បុត្រ ធ្វើឱ្យ ខ្ញុំ ហួសចិត្ត !
វា មិន មាន ជំនាញ ច្បាស់លាស់ ណាមួយ សម្រាប់ ការអនុវត្តន៍ នេះ នោះ ទេ ដូច្នេះ អ្នក អាច ដាក់ វា ចូល ទៅក្នុង ទំលាប់ ប្រចាំ ថ្ងៃ របស់ អ្នក ។
មាន តែ ការចូលរួម ទាំងអស់ គ្នា ទេ ទើប ធនធាន ធម្មជាតិ របស់ ហើយ នៅ គង់វង្ស និង ផ្តល់ ផល អោយ យើង បាន រហូត ៕
ប្រធាន តុលាការ ក្រុង ភ្នំពេញ នឹង ត្រូវ ដកហូត ពី តំណែង ?
ប៉ុន្តែ លោក ក៏ មិន ដឹង ពី មូលហេតុ អ្វី ដែល មន្ត្រី ជំនាញ ខេត្ត ព្រះសីហនុ គ្មាន វិធានការបង្ក្រាប ទៅ លើ បទល្មើស នេសាទ សមុទ្រ នេះ ទេ ។
មិន យូរ ទេ ការប្រកាស នឹង បញ្ចប់ ហើយ ។
