( បន្ទាយមានជ័យ )៖ ពុទ្ធ បរិស័ទ ជាច្រើន រយ នាក់ រស់ នៅក្នុង ក្រុង សិរី សោភ័ណ និង ក្រុង ប៉ោយប៉ែត បាន មូលមតិ គ្នា ជា ឯកច្ឆ័ន្ទ ដង្ហែ បុណ្យ អង្គ ឋិន ទាន សាមគ្គី មួយ ដើម្បី ប្រមូល បច្ច័យ វេប្រគេន ព្រះសង្ឃ ដែល រងចាំ ព្រះវស្សា អស់ ត្រី មាស និង យក ទៅ កសាង វត្ត គិរី ជុំ ចំការខ្នុរ ស្ថិត ក្នុង ភូមិ អូរ អំបិល សង្កាត់ អូរ អំបិល ក្រុង សេរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ នៅ ល្ងាច ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០២០ ដើម្បី ជា ប្រយោជន៍ ក្នុង ព្រះពុទ្ធ សាសនា ។
ព្រះគ្រូ នេតិ បណ្ឌិ តោ ណាប់ ម៉ឺន ព្រះចៅ អធិការ បាន មាន សង្ឃ ដិការបន្ត ទៀត ថា រាជ រដ្ឋាភិបាល កម្ពុជា ចាត់ទុក ព្រះពុទ្ធ សាសនា ជា សាសនា របស់ រដ្ឋ មាន ចែង ក្នុង ច្បាប់ រដ្ឋធម្មនុញ្ញ ក្នុង មាត្រា ទី ៤៣ ហើយ ក្នុង នោះ កម្ពុជា មាន បុណ្យ ព្រះពុទ្ធ សាសនា ជាច្រើន ដូច ជា៖ មាឃ បូជា ពិសាខ បូជា អាសាឡ បូជា និង ចូល ព្រះវស្សា ចេញ វស្សា បុណ្យ គឋិន ទាន នេះ ជាដើម ។
បុណ្យ ក ឋិន ទាន នេះ គឺជា បុណ្យ មួយ ដ៏ សំខាន់ ណាស់ ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា កាលណា ពុទ្ធ បរិស័ទ បាន ធ្វើ បុណ្យ ក ឋិន ទាន នេះ ហើយ អ្នក នោះ ជាតិ មុខ និង ក្លាយទៅជា រូប សម្ផស្ស ស្អាត និង មាន ធនធាន ទ្រព្យសម្បត្តិ ស្តុកស្តម្ភ ក្លាយទៅជា អ្នកប្រាជ្ញ និង កុង្សី មន្ត្រី ទៀតផង ។
បុណ្យ ក ឋិន ទាន នេះ ពុទ្ធ រិស័ទ ខ្មែរ ប្រារព្វ ធ្វើឡើង ដើម្បី បំពេញ តំរូវការ ជាក់ស្តែង របស់ ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា អស់ កាល ត្រីមាស នៅ តាម ទី វត្តអារាម នានា ក៏ ដូចជា ការរួមចំណែក កសាង ទី សេនា សនៈ និង សមិទ្ធផល ក្នុង វត្ត ព្រមទាំង រួមចំណែក លើក កំពស់ ការគោរព ប្រតិបត្តិ ព្រះពុទ្ធ សានា ដែល ជា សានា របស់ រដ្ឋ ឲ្យបាន ថ្គុំ ថ្កើន រុងរឿង ផងដែរ ។
ការធ្វើ បុណ្យ ក ឋិន ទាន នេះ ជា បុណ្យ ក្នុង ព្រះពុទ្ធ សាសនា ជា កាល ទាន ដ៏ វិសេស មួយ មាន ដែន កំណត់ ពេលវេលា ច្បាស់លាស់ ពុំ មាន ចេះតែ ធ្វើ នៅ ពេលណា ក៏ បាន តាម តែ ចិត្ត នឹកឃើញ នោះ ឡើយ ។
ការបណ្ដុះបណ្ដាល នេះ ដើម្បី ពង្រឹង សមត្ថភាព ស្ដីពី ការចុះ ផ្ដល់ សេវា សុខភាព ដល់ មូលដ្ឋាន នៅ ខេត្ត រតនគីរី និង មណ្ឌលគីរី ចំនួន ៣វគ្គ សម្រាប់ រយៈពេល ៣ ថ្ងៃ ក្នុង មួយ វគ្គ ដែល បាន ចាប់ពី ផ្ដើម ថ្ងៃទី ២០ ដល់ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០២០ ។
លើស ពី នោះ ក្រុមការងារ អនុវត្ត គម្រោង នៃ អង្គការ ហ្គូដណេប៊ឺស កម្ពុជា (PMC) បាន បណ្តុះបណ្តាល គ្រូ បង្គោល នៃ មន្ទីរ សុខាភិបាល ខេត្ត និង ស្រុក ប្រតិបត្តិ តាមរយៈ ការអញ្ជើញ សាស្រ្តាចារ្យ មកពី មជ្ឈមណ្ឌល ជាតិ គាំពារ មាតា និង ទារក មកពី រាជធានី ភ្នំពេញ ហើយ សាស្រ្តាចារ្យ ទាំងអស់ បាន បង្កើត កម្មវិធី សិក្សា រយៈពេល ៥ ថ្ងៃ នៃ ថ្នាក់ បណ្ដុះបណ្ដាល គ្រូ បង្គោល សម្រាប់ សកម្មភាព ការចុះ ផ្ដល់ សេវា សុខភាព ដល់ មូលដ្ឋាន ។
ជាពិសេស ដើម្បី ការពារ កង្វះខាត បុគ្គលិក ពេទ្យ នៅ តាម មណ្ឌល សុខភាព បាន បណ្តុះបណ្តាល សិក្ខាកាម ចម្រុះ គ្នា មកពី បុគ្គលិក មណ្ឌល សុខភាព ខេត្ត មណ្ឌលគីរី ទទួល វគ្គ បណ្ដុះបណ្ដាល នៅ ខេត្ត រតនៈគីរី និង បុគ្គលិក មណ្ឌល សុខភាព ខេត្ត រតនគិរី មក ទទួល វគ្គ បណ្តុះបណ្តាល នៅ ខេត្ត មណ្ឌលគិរី ។
ការចុះ ផ្ដល់ សេវា សុខភាព ដល់ មូលដ្ឋាន គឺជា សេវាកម្ម ដែល បុគ្គលិក មណ្ឌល សុខភាព ចុះ ទៅ ភូមិ ផ្ទាល់ ដោយ ផ្តោត សំខាន់ លើ ការចាក់ វ៉ាក់សាំង កុមារ ។ ដោយសារ ភូមិ នៅ ឆ្ងាយ ពី មណ្ឌល សុខភាព មិន អាច ទៅ មណ្ឌល សុខភាព ដើម្បី ទទួល ការចាក់ វ៉ាក់សាំង ការពារ កុមារ បាន ។
សម្រាប់ ការចុះ ផ្ដល់ សេវា សុខភាព ដល់ មូលដ្ឋាន បុគ្គលិក មណ្ឌល សុខភាព ចំនួន ២នាក់ ត្រូវបាន ចាត់តាំង ឱ្យ ចុះ តាម ភូមិ ដែល បាន កំណត់ រៀងរាល់ ពីរ ខែម្តង ប៉ុន្តែ បុគ្គលិក មណ្ឌល សុខភាព មិន អាច ផ្តល់ សេវា សុខភាព ដល់ មូលដ្ឋាន បាន គ្រប់គ្រាន់ ទេ ដោយសារតែ ថវិកា មិន គ្រប់គ្រាន់ និង កង្វះ បុគ្គលិក ពេទ្យ ។
ជាពិសេស ខេត្ត រតនៈគីរី និង មណ្ឌលគីរី ដែល មាន លក្ខណៈ ភូមិសាស្ត្រ គឺជា តំបន់ ភ្នំ ហើយ មាន ភូមិ ជាច្រើន ដែល មិន អាច មកដល់ មណ្ឌល សុខភាព បាន ដោយសារ ទឹក ជំនន់ ទឹក ទន្លេ និង មិន អាច ទទួលបាន សេវា វេជ្ជសាស្រ្ត ចាំបាច់ បាន ។
ដូច្នេះ ចាប់ពី ឆ្នាំ ២០១៩ ដល់ ឆ្នាំ ២០២៣ កយកា-KOICA ផ្ដល់ ថវិកា ចំនួន ៧លាន ដុល្លារ ដែល ជា ជំនួយ ផ្តល់ ដោយ រដ្ឋាភិបាល កូរ៉េ ដើម្បី ធ្វើឱ្យ ប្រសើរឡើង នូវ សេវា វេជ្ជសាស្រ្ត ចាំបាច់ ជាពិសេស សម្រាប់ ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត រតនគិរី និង មណ្ឌលគីរី ដែល ជា តំបន់ ភូមិសាស្ត្រ ដាច់ស្រយាល បំផុត នៅក្នុង ភូមិភាគ ឦសាន នៃ កម្ពុជា ។
ដើម្បី ធ្វើឱ្យ ប្រសើរឡើង នូវ ការចុះ ផ្ដល់ សេវា សុខភាព ដល់ មូលដ្ឋាន ដល់ ប្រជាជន នៅ តាម តំបន់ ដែល មាន ការលំបាក ការពង្រឹង សមត្ថភាព បុគ្គលិក មណ្ឌល សុខភាព គឺជា ផ្នែក សំខាន់ បំផុត ដូច្នេះ PMC បាន រៀបចំ វគ្គ បណ្តុះបណ្តាល ចំនួន ៣ សម្រាប់ បុគ្គលិក មណ្ឌល សុខភាព ។
ក្នុង វគ្គ បណ្តុះបណ្តាល នេះ សិក្ខាកាម នៃ មន្រ្តី មណ្ឌល សុខភាព ក្រង់ តេះ ក្នុង ខេត្ត មណ្ឌលគីរី លោកស្រី គង់ កុម្ភៈ បាន ឱ្យដឹង ថា ចាប់តាំងពី ចាប់ផ្តើម ធ្វើការ នៅ មណ្ឌល សុខភាព នេះ ជា លើក ដំបូង ដែល លោកស្រី ទទួលបាន ការបណ្តុះបណ្តាល ស្ដីពី ការចុះ ផ្ដល់ សេវា សុខភាព ដល់ មូលដ្ឋាន ។
មន្រ្តី មណ្ឌល សុខភាពញ៉ាង នៃ ខេត្ត រតនគិរី លោក ជុំ រត្ន័ មុនី បាន លើកឡើង ផងដែរ ថា នេះ ជា លើក ទី ដំបូង ហើយ ដែល ការបណ្តុះបណ្តាល ត្រូវបាន ធ្វើឡើង រួមគ្នា ទាំង ពីរ ខេត្ត ហើយ វា ជា ឱកាស ដ៏ ល្អ មួយ ដែល បាន មក ទទួល ការអប់រំ ពី ខេត្ត រតនគិរី ដល់ ខេត្ត មណ្ឌលគីរី ។ « ដូច្នេះ យើង អាច ពិភាក្សា គ្នា បាន រវាង បុគ្គលិក មណ្ឌល សុខភាព ខេត្ត និង រៀបចំ ផែនការ សកម្មភាព រួមគ្នា ដើម្បី រៀបចំ បរិស្ថាន ថ្មី នៃ ការផ្ដល់ សេវា សុខភាព ដល់ មូលដ្ឋាន នៅ ខេត្ត មណ្ឌលគីរី និង ខេត្ត រតនៈគិរី » ។
( អ៉ីស្តង់ ប៊ុល ) ៖ ក្រុម សង្គ្រោះ តួកគី បាន អះអាង ថា មនុស្ស សរុប ២៥ នាក់ ហើយ បាន ស្លាប់ និង ៨០៤ នាក់ ទៀត រងរបួស នៅក្នុង គ្រោះ រញ្ជួយ ផែនដី កម្រិត ធ្ងន់ ៧. ០រ៉ិច ទ័រ ដែល វាយប្រហារ ទីក្រុង ជាប់ តំបន់ ឆ្នេរ ភាគ ខាងលិច ប្រទេស នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នា រសៀល ថ្ងៃសៅរ៍ ទី ៣១ ខែតុលា ឆ្នាំ ២០២០ ។
ក្រុម សង្គ្រោះ តួកគី ប្រមាណ ជាង ៥.០០០ នាក់ និង សុន ខ ហិត ក្លិន ២០ ក្បាល កំពុង បំពេញ ប្រតិបត្តិការ ជួយសង្គ្រោះ មនុស្ស ស្ថិត នៅ តំបន់ រងគ្រោះ ខាងលើ នេះ ។ រញ្ជួយ ដី លើក នេះ ក៏ បាន បង្កឲ្យ ដែន កោះ មួយចំនួន របស់ ប្រទេស ក្រិក ដែល ស្ថិត នៅក្បែរ ៗ តួកគី ដែរ នោះ ទទួលរង នូវ រំញ័រ តិច ៗ ផងដែរ ប៉ុន្តែ ពុំ បាន បង្កឲ្យ មាន ការខូចខាត ឬ មនុស្ស រងគ្រោះ ដូច នៅ តួកគី ឡើយ ។
( កែប )៖ ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន អញ្ជើញ ជា កិត្តិយស ក្នុង ពិធី ដង្ហែរ អង្គ ឋិន ទាន ទៅកាន់ វត្ត វិបសនា ធុរៈ ខេត្ត កែប ( ហៅ វត្ត សមាធិ ) ស្ថិត ក្នុង ភូមិ កែប សង្កាត់ កែប ក្រុង កែប ខេត្ត កែប នា រសៀល ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០២០ នេះ ។
នៅក្នុង ពិធី នោះ មាន វត្តមាន លោក សំ សារីន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កែប . លោក សោម ពិសិដ្ឋ អភិបាល ខេត្ត កែប និង មហា ឧបាសិកា សុខ អ៊ីម និង លោន លោកស្រី ជា ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ជុំវិញ ខេត្ត ព្រមទាំង ពុទ្ធ បរិស័ទ្ធ ចំណុះ ជើង វត្ដ បាន អញ្ជើញ ចូលរួម យ៉ាង ច្រើន កុះករ ផងដែរ ។
ថ្លែ ក្នុង ឱកាស នោះ លោកស្រី ម៉ែន សំអន ក៏ បាន នាំ នូវ ការផ្តាំផ្ញើរ ការ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នូវ ដល់ អង្គ ពិធី ដោយ ក្តី នឹករលឹក និង ការយកចិត្ត ទុក្ខ ដាក់ អំពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស ។
លោកស្រី ក៏ បាន បន្ត ទៀត ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ដឹកនាំ ប្រទេស ឲ្យ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ក្នុង នោះ វិស័យ ពុទ្ធ ចក្រ ក៏ មាន ការរីក ច្រើន គួរឲ្យ កត់សម្គាល់ ក្រោម ម្លប់ នៃ សុខ សន្តិភាព ។
ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន ក៏ បាន ផ្តាំផ្ញើ ដល់ ពុទ្ធ បរិស័ទ ក៏ ដូចជា ប្រជាពលរដ្ឋ ត្រូវ រក្សា គម្លាត សុវត្ថិភាព សង្គម និង ធ្វើ អនាម័យ ជាប្រចាំ ដើម្បី ជៀស ផុត ពី ជំងឺ កូវីដ - ១៩ ដើម្បីឲ្យ ជំងឺ កាច នេះ ត្រូវ ។ ធ្វើ អនាម័យ ជាប្រចាំ ដូចជា លាង ដៃ និង សាប៊ូ ឬ អាកុល ឬ ទឹក ជែល កំចាត់ មេរោគ ជាដើម ៕
ថ្ងៃ ឈប់សម្រាក ព្រះរាជ ពិធី គ្រងរាជសម្បត្តិ របស់ ព្រះមហាក្សត្រ និង ថ្ងៃ អុំ ទូក ទី១ ភ្ញៀវ ទេសចរ ជាង ២០ម៉ឺន នាក់ ដើរលេង កម្សាន្ដ នៅ ទូទាំង ប្រទេស . សៀមរាប ទទួលបាន ភ្ញៀវ ច្រើន ជាង គេ
ប៉ុន្តែ ទោះ យ៉ាងណា ខេត្ត សៀមរាប នៅតែ ជា គោលដៅ ពេញនិយម ដោយ បាន ទាក់ទាញ ភ្ញៀវ ទេសចរ បាន ប្រមាណ ២៨. ៤០ % នៃ ភ្ញៀវ សរុប ដែល ភាគ ច្រើន បាន ទៅ ទស្សនា តំបន់ រមណីយដ្ឋាន និង សហគមន៍ នានា ក្នុង ខេត្ត ដូចជា តំបន់ ប្រាសាទ អង្គរវត្ត ឧទ្យាន ជាតិ ភ្នំ គូលែន សហគមន៍ ព្រៃ ទឹក ជប់ខ្នារ ពោធិ៍ សហគមន៍ ត្រាវ កុដិ សហគមន៍ បឹង ឈូក បន្ទាយស្រី រមណីយដ្ឋាន ភូមិ វប្បធម៌ កម្ពុជា ជាដើម ។
( បន្ទាយមានជ័យ )៖ ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន លើក បង្ហាញ នូវ វីរភាព ជាច្រើន នៃ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ទៅកាន់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ខេត្ត បន្ទាយមានជ័យ ។ លោក ទេសរដ្ឋមន្ត្រី បាន សង្កត់ធ្ងន់ ថា ជា ទម្លាប់ នៃ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង រយៈពេល ជាង ៤០ ឆ្នាំ មក នេះ សម្តេច មិន ដែល រត់ ចោល ពលរដ្ឋ នៅពេល មាន ទុក្ខ នោះ ឡើយ ។
ការលើក បង្ហាញ នូវ គំរូវីរភាព នៃ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង ក្នុង ពេល លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន នាំយក អំណោយ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រគល់ ជូន ពលរដ្ឋ រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ១៥០០ គ្រួសារ មកពី ឃុំ ស្រះ ជីក . ឃុំ ពន្លៃ និង ឃុំ ប៉ោយ ចារ ក្នុង ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ នៅ រសៀល ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ ។
ពិធី ចែក អំណោយ នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ ផងដែរ ។ ជួស មុខ ឱ្យ ប្រជាពលរដ្ឋ រងគ្រោះ លោក អភិបាល ខេត្ត បាន ថ្លែង នូវ អំណ គុណ យ៉ាង ជ្រៀល ជ្រៅ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល ជានិច្ចកាល បាន គិតគូរ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ដែល ទទួលរង ផល ប៉ះពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង ដោយ បាន ផ្តល់ អំណោយ សង្គ្រោះ ជា ស្បៀងអាហារ និង បាន ចុះ ទៅ សួរសុខទុក្ខ ពលរដ្ឋ ដោយ ផ្ទាល់ ។
នៅ ចំពោះ មុខ ពលរដ្ឋ រងគ្រោះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ពាំនាំ នូវ ការសាកសួរ សុខទុក្ខ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន ទទួលរង ផល ប៉ះពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង ក្នុង ខេត្ត បន្ទាយមានជ័យ និង ចូលរួម សម្តែង នូវ ការសោកស្តាយ របស់ បងប្អូន ដែល ទទួលរង ផល ប៉ះពាល់ ផ្ទះសម្បែង និង ផល ដំណាំ ជាដើម ។
លោក ទេសរដ្ឋមន្ត្រី បាន លើក បង្ហាញ ផងដែរ នូវ វីរភាព នៃ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។ លោក ទេសរដ្ឋមន្ត្រី បាន ថ្លែង ថា សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ មួយ រូប ដែល តែងតែ តម្កល់ នូវ សេចក្តីសុខ និង ទុក្ខ របស់ ប្រជាពលរដ្ឋ ជា ចម្បង ហើយ តែង គិតគូរ ខ្វាយខ្វល់ ជាប់ ជានិច្ច ចំពោះ ការលំបាក របស់ ប្រជាពលរដ្ឋ ។
លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន សង្កត់ធ្ងន់ ថា សម្តេច តេជោ ហ៊ុន សែន ជា មេដឹកនាំ ដឹកនាំ ដែល មិន ទម្លាប់ រត់ ចោល ប្រជាពលរដ្ឋ នៅពេល ពួកគាត់ មាន ទុក្ខ នោះ ឡើយ ។ លោក បាន គូសបញ្ជាក់ ថា ជាក់ស្តែង ពេល ពលរដ្ឋ ជួប គ្រោះ ទឹក ជំនន់ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ចុះ សួរសុខទុក្ខ និង ផ្តល់ ស្បៀង ដោយ ផ្ទាល់ ។
បន្ថែម ពីលើ នោះ សម្តេច តេជោ ក៏ បាន ដាក់ចេញ នូវ វិធានការបន្ទាន់ ជាច្រើន ដើម្បី ស្តារ ជីវភាព ពលរដ្ឋ ឡើងវិញ ក្រោយពេល ទឹក ជំនន់ ។
លោក ទេសរដ្ឋមន្ត្រី បាន លើកឡើង ថា ដើម្បី ស្តារ ជីវភាព ពលរដ្ឋ ឡើងវិញ សម្តេច តេជោ បាន បញ្ចេញ ថវិកា ទិញ ស្រូវ ពូជ បន្ថែម រហូតដល់ ប្រមាណ ២ពាន់ តោន និង ពូជ ដំណាំ ផ្សេង ៗ ជាច្រើន ទៀត ចែកជូន ប្រជាពលរដ្ឋ ។ ក្នុង នោះ សម្រាប់ អ្នកធ្វើ ស្រែ ទទួលបាន ស្រូវ ពូជ ប្រមាណ ១០០ គីឡូក្រាម ក្នុង មួយ គ្រួសារ ហើយ អ្នក ដាំ ដំណាំ ផ្សេង ៗ ទទួលបាន ពូជ ដំណាំ ចំនួន ៦មុខ ។ មិន តែ ប៉ុណ្តោះ ក្រសួង កសិកម្ម បាន បញ្ជា គ្រឿងចក្រ កសិកម្ម ត្រៀម ចុះ ជួយ ពលរដ្ឋ ផងដែរ ៕
( បន្ទាយមានជ័យ )៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ចាត់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ និង លោក លឹម គៀន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ឱ្យ ធ្វើ ការងារ បន្ទាន់ ក្នុង ការស្តារ ឡើងវិញ ទំនប់ ទឹក « អាង តាម៉េង » ស្ថិត នៅ ភូមិ គោក កឋិន ឃុំ គោក កឋិន ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ដែល រង ការវាយប្រការ ដោយ ជំនន់ ទឹកភ្លៀង ដែរ នោះ ។
វិធានការ នេះ ដើម្បី រក្សា ទឹក នៅក្នុង « អាង តាម៉េង » ទុក សម្រាប់ ការធ្វើ ស្រែ និង បង្កបង្កើន ផល របស់ ប្រជាពលរដ្ឋ ក្រោយ ទឹក ជំនន់ ស្រក ទៅ វិញ ។ លោក រដ្ឋមន្ត្រី លឹម គៀន ហោ បាន ចាត់ លោក ចាន់ ស៊ីណាត អនុ រដ្ឋលេខាធិការ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដឹកនាំ ការជួសជុល ទំនប់ នេះ ឡើងវិញ ។
ប្រជាពលរដ្ឋ ក្នុង ឃុំ គោក កឋិន បាន ថ្លែង ថា « អាង តាម៉េង » នេះ បាន ផ្តល់ ប្រយោជន៍ យ៉ាង ខ្លាំង សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង ឃុំ គោក កឋិន ដោយ មិន ត្រឹមតែ ផ្តល់ ជា ប្រភព ទឹក សម្រាប់ ធ្វើ ស្រែ និង ស្រោចស្រព ផល ដំណាំ ផ្សេង ៗ ប៉ុណ្ណោះ ទេ ។ « អាង តាម៉េង » នេះ ក៏ ផ្តល់ ជា ប្រភព ត្រី សម្រាប់ ពលរដ្ឋ រក មក ធ្វើជា ម្ហូប អាហារ ថែម ទៀត ផង ។ ក្រៅពី នោះ ខ្នង ទំនប់ នេះ ក៏ ផ្តល់ ជា ប្រព័ន្ធ គមនាគមន៍ សម្រាប់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ផងដែរ ។
ទំនប់ « អាង តាម៉េង » នេះ បាន រង ការខូចខាត មួយចំនួន ព្រោះតែ ទឹក ជំនន់ នា ពេល កន្លងទៅ ។ បន្ទាប់ពី ទឹក ស្រក មន្ត្រី និង គ្រឿងចក្រ របស់ ក្រសួង ធនធាន ទឹក ជាច្រើន បាន ដាក់ ទៅ ជួសជុល ខ្នង ទំនប់ នេះ ឡើងវិញ សម្រាប់ សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ និង ទប់ទឹក សម្រាប់ ស្រោចស្រព ។
ប្រជាពលរដ្ឋ ឃុំ គោក កឋិន បាន បង្ហាញ ការរីករាយ និង អរគុណ ជា អនេក ដល់ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ដាក់ចេញ វិធានការបន្ទាន់ ក្នុង ការជួសជុល ទំនប់ នេះ ឡើងវិញ សម្រាប់ ទប់ទឹក និង សម្រាប់ ការធ្វើដំណើរ របស់ ពួកគាត់ ។
ពលរដ្ឋ ក្នុង ឃុំ គោក កឋិន ក៏ បាន ថ្លែងអំណរគុណ ដល់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ផងដែរ ដែល ក្នុង នាម ជា សេនាធិការ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ហើយ បាន ចុះ ជាប់ ជាប្រចាំ តាំងពី ទឹក ចាប់ផ្តើម ជន់ លិច នៅក្នុង ឃុំ គោក កឋិន ។
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន គូសបញ្ជាក់ ទៅកាន់ ប្រជាពលរដ្ឋ ថា ការលំបាក របស់ ប្រជាពលរដ្ឋ គឺជា ការលំបាក របស់ សម្តេច តេជោ ។ ព្រោះតែ ហេតុ នេះ ហើយ សម្តេច តេជោ បាន ដាក់ បទបញ្ជា យ៉ាង ដាច់ ណាត់ ក្នុង ការដោះស្រាយ ទុក្ខលំបាក ទាំងឡាយ របស់ ប្រជាពលរដ្ឋ ក្នុង ហេតុការណ៍ គ្រោះ ទឹក ជំនន់ នេះ ។
លោក ទេសរដ្ឋមន្ត្រី បន្ត ថា បទបញ្ជា របស់ សម្តេច តេជោ ត្រូវបាន អនុវត្តន៍ យ៉ាង ខ្ជាប់ខ្ជួន ដោយ មន្ត្រី ជំនាញ ហើយ កំពុង ធ្វើការ យ៉ាង សស្រាក់សស្រាំ ដើម្បី ឆ្លើយតប តាម សំណូមពរ និង តម្រូវការ របស់ ប្រជាពលរដ្ឋ ។
ក្នុង នាម ជា សេនាធិការ របស់ សម្តេច តេជោ ហ៊ុន សែន លើ ការងារ គ្រប់គ្រង គ្រោះមហន្តរាយ ក្នុង ឱកាស ចុះ ពិនិត្យ ការជួសជុល ទំនប់ នេះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ថ្លែង កោតសរសើរ និង អរគុណ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដែល បាន ធ្វើ សកម្មភាព បន្ទាន់ ក្នុង ការជួសជុល ទំនប់ ទឹក « អាង តាម៉េង » ក៏ ដូចជា ទំនប់ ទឹក ដទៃ ទៀត ដែល រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង ៕
ដំណឹង មរណទុក្ខ ! លោក វរសេនីយ៍ ឯក ឈុន ប៊ុន ធី គ្រូ នគរបាល នៅ បណ្ឌិត្យ សភា នគរបាល កម្ពុជា ទទួលមរណភាព ដោយ រោគា ពាធ
( ភ្នំពេញ ) ៖ លោក វរសេនីយ៍ ឯក ឈុន ប៊ុន ធី បម្រើ ការងារ នៅ បណ្ឌិត្យ សភា នគរបាល ជាតិ កម្ពុជា ផ្នែក ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ គ្រូ នគរបាល ជាតិ កម្ពុជា និង ជា គ្រូបង្រៀន លំហាត់ របៀប ម្នាក់ បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ០៧៖៣០ នាទី យប់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ ដោយ រោគា ពាធ ។
លោក វរសេនីយ៍ ឯក ឈុន ប៊ុន ធី គឺជា គ្រូ លំហាត់ របៀប នគរបាល ម្នាក់ ដែល ត្រូវ សិស្ស នគរបាល ជាច្រើន គោរព ស្រលាញ់ បាន ធ្លាក់ខ្លួន ឈឺ ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ។ ដោយសារ ជំងឺ ទឹកនោម ផ្អែម ធ្ងន់ធ្ងរ កាល ឆ្នាំ ២០១៨ លោក វរសេនីយ៍ ឯក ឈុន ប៊ុន ធី បាន កាត់ ជើង ខាងស្ដាំ ផងដែរ ។
បើ តាម កូនសិស្ស របស់ លោក វរសេនីយ៍ ឯក ឈុន ប៊ុន ធី បាន បញ្ជាក់ ថា ប៉ុន្មាន ខែ មុន លោក បាន ចូល សម្រាក នៅ មន្ទីរពេទ្យ ជាថ្មី ហើយ ពេល តម្រូវការប្ដូរ ឈាម ឬ លាង ឈាម ជាប្រចាំ ដើម្បី ពន្យា ស្ថានភាព ជំងឺ របស់ លោក ប៉ុន្ដែ ជា អកុសល ស្ថានភាព ជំងឺ កាន់តែ ធ្ងន់ធ្ងរ ទៅ ៗ ទើប លោក បាន ទទួលមរណភាព នៅ យប់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ ។
ការបាត់ លោក វរសេនីយ៍ ឯក ឈុន ប៊ុន ធី គឺជា ការបាត់បង់ នូវ ឪពុក បង្កើត ឪពុក ក្មេក ជីតា ជា ទីស្រឡាញ់ ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ។ រូបកាយ លោក វរសេនីយ៍ ឯក ឈុន ប៊ុន ធី បាត់បង់ ទៅ ក៏ ពិត មែន តែ កិត្តិយស អំពើ ជា កុសល សេចក្តីថ្លៃថ្នូរ គំរូវីរភាព នៅ ស្ថិត ជាប់ ក្នុង មនោសញ្ចេតនា បុត្រា បុត្រី ចៅ ប្រុស ចៅ ស្រី ព្រមទាំង ញាតិមិត្ត ជិត ឆ្ងាយ ទាំង អស់ ជានិច្ច និរន្តរ៍ ។
ព្រះមន្រ្តី សង្ឃ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង និង ពុទ្ធ បរិស័ទ ផ្តើម អង្គក ឋិន ទាន សាមគ្គី ដង្ហែ ចូល វត្ត ធម្ម រតន សោភា ប្រមូល បច្ច័យ បាន ជាង ៥០ លាន រៀល
( កំពង់ឆ្នាំង ) ៖ អង្គក ឋិន ទាន សាមគ្គី ដែល ផ្តួចផ្តើម ឡើង ដោយ ព្រះមន្រ្តី សង្ឃ ស្រុក រលាប្អៀរ រួម និង ប្រជាពលរដ្ឋ ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត និង ពុទ្ធ បរិស័ទ ជិត ឆ្ងាយ បាន ដង្ហែរ ទៅ វេរ ប្រគេន ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា អស់ កាល ត្រីមាស ក្នុង ពុទ្ធ សីមាវត្ត ធម្ម រតន សោភា ស្ថិត ក្នុង ឃុំ ស្រែ ថ្មី ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ប្រមូល បច្ច័យ បាន ជាង ៥០ លាន រៀល ។
ព្រះសិរី ធម្មវង្សា សេង ដា ព្រះចៅ អធិការ វត្ត ធម្ម រតន សោភា បាន មាន សង្ឃ ដីការ ថា ពិធី បុណ្យ ក ឋិន ឬ កឋិន ទាន ជា ពិធី បុណ្យ ធំ មួយ ក្នុង ព្រះពុទ្ធ សាសនា ។ ដោយសារតែ ប្រទេស កម្ពុជា ជា ប្រទេស ប្រកាន់ យក ព្រះពុទ្ធ សាសនា ជា គោល ទើប ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ទិសទី បាន ប្រារព្ធ ពិធី បុណ្យ មួយ នេះ ឡើង ជារៀងរាល់ ឆ្នាំ ។
ព្រះសិរី ធម្មវង្សា សេង ដា បាន បន្ត ថា នៅក្នុង ពិធី បុណ្យ នេះ ព្រះគ្រូ មន្រ្តី សង្ឃ ស្រុក រលាប្អៀរ និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត តែង នាំគ្នា ប្រារព្ធ ពិធី បុណ្យ ក ឋិន តាម ទី អារាម ក្បែរ ផ្ទះ ឬ ឆ្ងាយ បុណ្យ ក ឋិន គឺជា កុសល ដែល ធ្វើឡើង ដោយ នាំ សំពត់ ចីវរ ទៅ ប្រគេន ព្រះសង្ឃ ដែល បាន គង់ ចាំ វស្សា អស់ ត្រី មាស ។
( វ៉ាស៊ីនតោន ) ៖ លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ បាន ប្រកាស នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ ( ពេលវេលា នៅ វ៉ាស៊ីនតោន ) ថា សហរដ្ឋ អាមេរិក នឹង ដក ការអនុគ្រោះ ពន្ធ ចេញ ពី ទំនិញ ថៃ មួយចំនួន ស្ថិត នៅក្រោម ប្រព័ន្ធ អនុគ្រោះ ពន្ធ ទូទៅ (GSP) ហើយ វា នឹង ត្រូវ ចូល ជាធរមាន នៅ ថ្ងៃទី៣០ ខែធ្នូ ខាងមុខ នេះ ហើយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នា ព្រឹក ថ្ងៃសៅរ៍ ទី ៣១ ខែតុលា ឆ្នាំ ២០២០ ។
លោក ដូណាល់ ត្រាំ បាន សរសេរ លិខិត មួយ ទៅកាន់ សភា អាមេរិក ដោយ គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ បាន មើលឃើញ ថា ប្រទេស ថៃ មិន បាន ធានា ចំពោះ អាមេរិក នៅក្នុង ការធ្វើឲ្យ ទំនិញ អាមេរិក ចូល ទៅក្នុង ទីផ្សារ របស់ ថៃ ដោយ សម ហេតុផល និង ត្រឹមត្រូវ នោះ ឡើយ ។ ហេតុ ដូច្នេះ ខ្ញុំ គិត ថា វា ជា ការសមស្រប ក្នុង ការព្យួរ ការអនុគ្រោះ ពន្ធ ស្ថិត ក្រោម ប្រព័ន្ធ GSP ទៅ លើ ទំនិញ មួយចំនួន មកពី ប្រទេស ថៃ ដោយ ស្រប តាម មាត្រា ដែល បាន ចែង » ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៥២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ៣០ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៥២ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ៣១ ខែតុលា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៥២ នាក់ នោះ មាន ៩នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១០ករណី និង ជនសង្ស័យ ៤៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៧ករណី ។
លោក ព្រុំ សុខា ជួប សំណេះសំណាល ជាមួយ ជន បង្គោល ក្រុមការងារ ចំណាកស្រុក នៃ ភូមិ ទាំង ១០៨ ក្នុង ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ ស្រុក បាភ្នំ នា រសៀល ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ បាន ជួប សំណេះសំណាល ជាមួយ ជន បង្គោល ក្រុមការងារ ចំណាកស្រុក តាម ភូមិ នីមួយ ៗ ដែល តំណាង ឲ្យ បងប្អូន កម្មករ ពលករ ចំណាកស្រុក នៃ ភូមិ ទាំងអស់ ១០៨ ក្នុង ស្រុក បាភ្នំ ។
ពិធី នេះ បាន ប្រព្រឹត្តទៅ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក បាភ្នំ ដោយ មាន ការចូលរួម ពីសំណាក់ លោកស្រី អស់ លោក អ្នកតំណាងរាស្ត្រ ថ្នាក់ដឹកនាំ ក្រសួង មន្ទីរ អង្គភាព នៅ ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ដែល ជា អនុប្រធាន ជា សមាជិក ក្រុមការងារ ស្រុក ប្រធាន ក្រុមប្រឹក្សា និង អភិបាល ស្រុក មេឃុំ មេភូមិ ទាំងអស់ សរុប ចំនួន ប្រមាណ ជាង ៣០០ នាក់ ។
ផ្អែក តាម របាយការណ៍ របស់ លោក ទេព ភារុន អភិបាល ស្រុក បាភ្នំ មកដល់ បច្ចុប្បន្ន ក្នុង ស្រុក បាភ្នំ ទាំងមូល មាន កម្មករ ពលករ ចំណាកស្រុក ចំនួន ២៥. ៣១៣ នាក់ ដែល កំពុង ធ្វើការ នៅ តាម រោងចក្រ សហគ្រាស អង្គភាព អាជីវកម្ម ការដ្ឋាន សំណង់ ឯកជន និង សេវា ផ្នែក សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ នៅ រាជធានី ភ្នំពេញ ទីប្រជុំជន នានា ក្នុង ប្រទេស ក្នុង នោះ ២៩៥ នាក់ ជា កម្មករ ពលករ ចំណាកស្រុក ក្រៅ ប្រទេស ។
ខ្លឹមសារ មតិ សំណេះសំណាល របស់ លោក រដ្ឋមន្ត្រី ព្រុំ សុខា នា ពេល នោះ ផ្តោត ជា សំខាន់ លើ ការកសាង បណ្តាញ ទំនាក់ទំនង ផ្សាភ្ជាប់ ជាប្រចាំ រវាង ក្រុមការងារ ជាមួយ កម្មករ ពលករ ចំណាកស្រុក សំដៅ លើកកម្ពស់ ស្មារតី សាមគ្គីភាព បំពេញ ការងារ ពុះពារ ការលំបាក ជា បញ្ហា ប្រឈម នានា រួមគ្នា ប្រយុទ្ធ ឈ្នះ កូវីដ - ១៩ ដើម្បី បុព្វហេតុ សុខ សន្តិភាព និង ការអភិវឌ្ឍ របស់ មាតុភូមិ ។
ខាងក្រោម ជា ទិន្នន័យ ប្រទេស ចំនួន ២០ ដែល មាន អ្នក ឆ្លង ជំងឺ COVID-19 ច្រើន ជាង គេ៖ មិន ត្រូវ បើកបរ ក្រោម ឥទ្ធិពល នៃ គ្រឿងស្រវឹង ជាដាច់ខាត ! ស្លាប់ ៤នាក់ និង របួស ២០ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៣០ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ៧នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង គ្រោះថ្នាក់ . បត់ មិន ប្រយ័ត្ន និង ស្រវឹង ៕
ក្រុមការងារ ទាំង ០៣ ខាងលើ ត្រូវបាន នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ប្រគល់ ភារកិច្ច ជូន ឧត្តមសេនីយ៍ ឯក ឌី វិជ្ជា អគ្គ ស្នងការរង ឲ្យ ទទួល ដឹកនាំ បញ្ជា បន្ថែម ពីលើ ការងារ ដែល មាន ស្រាប់ គឺ ការងារ ដឹកនាំ នាយកដ្ឋាន កណ្ដាល សន្តិសុខ និង ការងារ ប្រឆាំង ការសម្អាត ប្រាក់ ។
ជា រួម ការិយាល័យ សម្របសម្រួល កិច្ចសហប្រតិបត្តិការ ទាំង ០៣ ខាងលើ មាន តួនាទី ភារកិច្ច ប្រហាក់ប្រហែល គ្នា គឺ ការពង្រឹង ប្រសិទ្ធភាព កិច្ចសហការ ស៊ើបអង្កេត និង បង្ក្រាប ជនល្មើស ដែល ប្រព្រឹត្ត បទល្មើស ជា អាទិ៍ អំពើ ភេរវកម្ម . ការជួញដូរ និង រត់ពន្ធ មនុស្ស . ទេសចរណ៍ ផ្លូវភេទ និង អំពើ អនាចារ កុមារ . ការជួញដូរ គ្រឿងញៀន ខុស ច្បាប់ . ការរត់ ពន្ធ អាវុធ . បទល្មើស សម្អាត ប្រាក់ . បើ ទល្មើស ឧក្រិដ្ឋកម្ម បច្ចេកវិទ្យា . ការតាម ចាប់ ជនល្មើស រត់គេចខ្លួន និង បទល្មើស ផ្សេង ៗ ទៀត តាម ការឯកភាព គ្នា របស់ ភាគី ទាំង ពីរ ៕
ដោយឡែក នៅក្នុង យុទ្ធនាការជួយ បោស លាង សម្អាត ផ្ទះ និង ស្ដារ ហេដ្ឋារចនាសម្ព័ន្ធ ជូន ដល់ ប្រជាពលរដ្ឋ នា ពេលនេះ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ប្រើប្រាស់ កម្លាំង ចូលរួម ចំនួន ២០០ នាក់ និង សម្ភារៈ មាន ឡាន ទឹក ប៉ែល ចប បង្គី អំបោស ថង់ ច្រក សម្រាម គ្រប់ ដៃ រួម ជាមួយ កម្លាំង ចម្រុះ ដ៏ទៃ ទៀត ដូច ខាងលើ យកចិត្តទុកដាក់ បម្រើ ប្រជាពលរដ្ឋ ប្រកបដោយ ស្មារតី សាមគ្គីភាព ក្នុង នាម ជា ខ្មែរ តែ មួយ ។
ក្នុង ឱកាស នោះ ផងដែរ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ក៏ បាន នាំយក អាហារ សម្រន់ មាន នំប៉ាវ ភេសជ្ជៈ ប៉ូវ កម្លាំង និង ទឹក សុទ្ធ ចែកជូន ក្រុមការងារ បរិភោគ គ្រប់ ៗ គ្នា ដូច តាម ទម្លាប់ ដែល លោក តែងតែ ធ្វើ ក្នុង រយៈកាល កន្លងមក ប្រកបដោយ មនោសញ្ចេតនា រីករាយ ស្និតស្នាល ។
ក្រោយពេល បោស លាង សម្អាត ចប់ បុរី ទាំងមូល ប្រែ ជា ជ្រះ ស្អាត ឡើង វិញ ហើយ ប្រជាពលរដ្ឋ ក៏ សប្បាយ ចិត្ត យ៉ាង ខ្លាំង និង បាន ថ្លែង ការកោតសរសើរ និង អរគុណ កម្លាំង ចម្រុះ អាជ្ញាធរ មូលដ្ឋាន ក៏ ដូចជា ថ្នាក់ដឹកនាំ តែងតែ យកចិត្តទុកដាក់ ជួយសង្គ្រោះ និង បម្រើ ពួកគាត់ គ្រប់ ពេលវេលា ៕ នា ឱកាស ឈប់ សម្រាក បុណ្យ អុំ ទូក ! ក្រសួង ទេសចរណ៍ ក្រើន រំលឹក ពី ការអនុវត្ត វិធាន សុវត្ថិភាព ទេសចរណ៍ ដល់ អាជីវកម្ម សេវាកម្ម ស្នាក់ នៅ ទេសចរណ៍ (Video inside)
( ភ្នំពេញ ) ៖ នា ឱកាស ឈប់ សម្រាក បុណ្យ អ៊ុំ ទូក អក អំបុក និង សំពះ ព្រះខែ នេះ ក្រសួង ទេសចរណ៍ បាន ក្រើន រំលឹក សា ជា ថ្មី ដល់ ម្ចាស់ ឬ អ្នកគ្រប់គ្រង អាជីវកម្ម សេវាកម្ម ស្នាក់ នៅ ទេសចរណ៍ ទាំងអស់ នៅក្នុង រាជធានី ភ្នំពេញ និង បណ្ដា ខេត្ត ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត និង ត្រូវ រៀបចំ តាម វិធាន សុវត្ថិភាព ទេសចរណ៍ ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ។
វិធាន សុវត្ថិភាព ទេសចរណ៍ ដែល ត្រូវ អនុវត្ត នោះ រួម មាន៖ ការលាង សម្អាត ដៃ នឹង អាកុល ជាប្រចាំ ការរក្សា គម្លាត សុវត្ថិភាព ត្រូវ វាស់ កម្តៅ រាល់ អ្នក ចេញ ចូល បុគ្គលិក ត្រូវ ពាក់ ម៉ាស និង វិធានការណែនាំ សំខាន់ ៗ មួយចំនួន ទៀត ស្រប តាម ខ្លឹមសារ នៃ ប្រកាស លេខ ០៨១ ប្រក ចុះ ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២០ ស្ដីពី ការដាក់ ឱ្យ អនុវត្ត វិធាន សុវត្ថិភាព ទេសចរណ៍ សម្រាប់ សេវាកម្ម ស្នាក់ នៅ ទេសចរណ៍ ។
( ព្រះវិហារ ) ៖ លោក យឹម ជុង អនុ រដ្ឋលេខាធិការ តំណាង លោក បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ រយៈពេល ២ ថ្ងៃ នេះ ចាប់ពី ថ្ងៃទី ២៩ - ៣០ ខែតុលា ឆ្នាំ ២០២០ បាន ដឹកនាំ គណៈប្រតិភូ ក្រសួង សហការ ជាមួយ លោក ម៉ប់ ធិរិត ប្រធាន មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត ព្រះវិហារ និង មន្ត្រី អាជ្ញាធរ ពាក់ព័ន្ធ ចុះ ពិនិត្យ និង វាយតម្លៃ ផ្លូវ ជន បទ ចំនួន ៣ខ្សែ នៅ ស្រុក ចំនួន ៣ ដែល រង ការខូចខាត ដោយ ទឹក ជំនន់ ដើម្បី ស្តា និង ជួសជុល ឡើងវិញ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
ផ្លូវ ជនបទ ទាំង ៣ខ្សែ ដែល រង ការខូចខាត ដោយ ទឹក ជំនន់ រួម មាន៖
* ផ្លូវ ខ្សែ ទី២ ៖ ស្ថិត នៅក្នុង ភូមិ ស្រែ ឃុំ រំដោះ ស្រែ ស្រុក ជាំ ក្សាន្ត សរុប ប្រវែង ៩ ៩០០ម៉ែត្រ រង ផល ប៉ះពាល់ ជំនន់ ទឹកភ្លៀង បាន ហូរ ដាច់ តួ ផ្លូវ ចំនួន ១៥កន្លែង សរុប ប្រវែង ១ ៥០០ម៉ែត្រ ខូចខាត លូ ចំនួន ០២កន្លែង ។ ក្រុមការងារ ពិនិត្យ ឃើញ ថា ផ្លូវ នេះ មាន ការហូរ ដាច់ តួ ផ្លូវ ដោយសារ ពុំ មាន សំណង់ ដោះ ទឹក គ្រប់គ្រាន់ គួរ ស្ថាបនា បន្ថែម លូ ប្រអប់ ចំនួន ០៥កន្លែង លូមូល ០៥ កន្លែង និង ជួសជុល តួ ផ្លូវ ទឹក ហូរ ដាច់ ចំនួន ១៥កន្លែង មាន ប្រវែង សរុប ប្រហែល ១៥០០ ម៉ែត្រ ឡើងវិញ ។
( ភ្នំពេញ ) ៖ នា ឱកាស ឈប់ សម្រាក បុណ្យ អុំ ទូក អក អំបុក និង សំពះ ព្រះខែ ឆ្នាំ នេះ ក្រសួង ទេសចរណ៍ បាន ក្រើន រំលឹក សា ជា ថ្មី ដល់ ម្ចាស់ ឬ អ្នកគ្រប់គ្រង អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ទាំងអស់ នៅក្នុង រាជធានី ភ្នំពេញ និង បណ្ដា ខេត្ត ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត និង ត្រូវ រៀបចំ តាម វិធាន សុវត្ថិភាព ទេសចរណ៍ ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ។
វិធាន សុវត្ថិភាព ទេសចរណ៍ ដែល ត្រូវ អនុវត្ត នោះ រួម មាន៖ ការលាង សម្អាត ដៃ នឹង អាកុល ជាប្រចាំ ការរក្សា គម្លាត សុវត្ថិភាព ត្រូវ វាស់ កម្តៅ រាល់ អ្នក ចេញ ចូល បុគ្គលិក ត្រូវ ពាក់ ម៉ាស និង វិធានការណែនាំ សំខាន់ ៗ មួយចំនួន ទៀត ស្រប តាម ខ្លឹមសារ នៃ ប្រកាស លេខ ០៨៥ ប្រក ចុះ ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២០ ស្ដីពី ការដាក់ ឱ្យ អនុវត្ត វិធាន សុវត្ថិភាព ទេសចរណ៍ សម្រាប់ អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ។
ដើម្បី ជ្រាប កាន់តែ ច្បាស់ សូម ទស្សនា វីដេអូ ស្ដីពី ការអនុវត្ត ស្រប តាម វិធាន សុវត្ថិភាព ទេសចរណ៍ សម្រាប់ អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរ ណ៍៖
លោក ហេង សួរ និង ក្រុមគ្រួសារ ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ និង ញាតិមិត្ត ជិត ឆ្ងាយ ដែល ផ្តល់ កិត្តិយស ចូលរួម ពិធី បញ្ចុះ សព និង បុណ្យ ៧ ថ្ងៃ ឪពុក របស់ លោក
( ភ្នំពេញ ) ៖ លោក ហេង សួរ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង ក្រុមគ្រួសារ នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន សរសេរ លិខិត ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ និង ញាតិមិត្ត ជិត ឆ្ងាយ ទាំងអស់ ដែល បាន ចូលរួម ក្នុង ពិធី បញ្ចុះ សព និង កម្មវិធី បុណ្យ ៧ ថ្ងៃ ឧបសក ហេង ឃាង ដែល ត្រូវ ជា ឪពុក បង្កើត របស់ លោក ៕
ខាងក្រោម នេះ ជា លិខិត ថ្លែងអំណរគុណ របស់ លោក ហេង សួរ និង ក្រុមគ្រួសារ៖
ទេសរដ្ឋមន្ត្រី គន់ គីម៖ ការប្រឹងប្រែង រក្សា ទឹក ទុក ជា កិច្ចការ សំខាន់ សម្រាប់ ការដាំដុះ ក្រោយ ទឹក ជំនន់
( បន្ទាយមានជ័យ )៖ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន ថ្លែង ថា ការប្រឹងប្រែង ក្នុង ការទប់ទឹក ក៏ ដូចជា រក្សា ទឹក ទុក ជា កិច្ចការ ដ៏ សំខាន់ មួយ សម្រាប់ ជួយ ស្តារ ការដាំដុះ ឡើងវិញ របស់ ប្រជាពលរដ្ឋ ក្រោយពេល ទឹក ជំនន់ ស្រក ទៅ វិញ ។
លោក ទេសរដ្ឋមន្ត្រី បាន ថ្លែង បែប នេះ ក្នុង ពេល អញ្ជើញ ចុះ ទៅ ពិនិត្យមើល ការជួសជុល និង ស្តារ ឡើងវិញ ទំនប់ ទឹក « អាង តាម៉េង » ស្ថិត នៅ ភូមិ គោក កឋិន ឃុំ គោក កឋិន ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ដែល រង ការវាយប្រការ ដោយ ជំនន់ ទឹកភ្លៀង ដែរ នោះ ។
ទំនប់ ទឹក « អាតា ម៉េង » ជា កន្លែង ស្តុក ទឹង ដ៏ ធំ មួយ នៅ ឃុំ គោក កឋិន សម្រាប់ ផ្គត់ផ្គង់ ដល់ ការធ្វើ ស្រែ និង ដាំដុះ ដំណាំ ផ្សេង ៗ របស់ ប្រជាពលរដ្ឋ ។ ទំនប់ នេះ បាន រង ការខូចខាត មួយចំនួន ដោយសារ ជំនន់ ទឹកភ្លៀង នា ពេល កន្លងទៅ ។
ដោយ អនុវត្តន៍ តាម បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា . រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក លោក លឹម គៀន ហោ បាន ចាត់ លោក ចាន់ ស៊ីណាត អនុ រដ្ឋលេខាធិការ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដឹកនាំ ការជួសជុល ទំនប់ នេះ ឡើងវិញ ដើម្បី រក្សា ទឹក ជូន ប្រជាពលរដ្ឋ ។
ក្នុង នាម ជា សេនាធិការ របស់ សម្តេច តេជោ ហ៊ុន សែន លើ ការងារ គ្រប់គ្រង គ្រោះមហន្តរាយ ក្នុង ឱកាស ចុះ ពិនិត្យ ការជួសជុល ទំនប់ នេះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ថ្លែង កោតសរសើរ និង អរគុណ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដែល បាន ធ្វើ សកម្មភាព បន្ទាន់ ក្នុង ការជួសជុល ទំនប់ ទឹក « អាង តាម៉េង » ក៏ ដូចជា ទំនប់ ទឹក ដទៃ ទៀត ដែល រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង ។
សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ដាក់ ផែនការ ជាពិសេស ក្នុង ការស្តារ ជីវភាព កសិករ តាមរយៈ ជួយ បង្កើន ការដាំដុះ ឡើងវិញ ក្រោយពេល ទឹក ជំនន់ ។ ដើម្បី ជំរុញ ការដាំដុះ ទាំង ការធ្វើ ស្រែ និង ដំណាំ ផ្សេង ៗ ការរក្សា ទឹក ទុក ជា រឿង ចំបាច់ បំផុត ។ ព្រោះតែ ហេតុ នេះ ហើយ ទើប សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ជំរុញឱ្យ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក ឆ្លើយតប បន្ទាន់ លើ ការងារ ជួសជុល ទំនប់ និង ប្រឡាយ ដែល រង ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង នេះ ។
របាយការណ៍ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន បង្ហាញ ថា គ្រោះ ជំនន់ ទឹកភ្លៀង បាន ធ្វើឱ្យ ប៉ះពាល់ និង ខូចខាត ទំនប់ ទឹក ប្រឡាយ មេ ប្រឡាយ រង ប្រឡាយ ស្រោចស្រព សរុប ជាង ៧០០ គីឡូម៉ែត្រ ។ បច្ចុប្បន្ន ក្រោយពេល ទឹក ចាប់ផ្តើម ស្រក នេះ ថ្នាក់ដឹកនាំ និង មន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន និង កំពុង ធ្វើ សកម្មភាព យ៉ាង មមាញឹក ក្នុង ជួសជុល ឡើងវិញ នូវ ទំនប់ និង ប្រឡាយ ដែល ប៉ះពាល់ និង រង ការខូចខាត នេះ ។
ក្នុង ឱកាស ចុះ ពិនិត្យ ទំនប់ « អាង តាម៉េង » លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន គូសបញ្ជាក់ បន្ថែម ថា ការរក្សា ឱ្យ បាន នូវ ទឹក នៅ តាម ទំនប់ ប្រឡាយ នានា ជា កិច្ច ដ៏ ចាំបាច់ បំផុត ក្នុង ការស្តារ និង បង្កបង្កើន ផល ឡើងវិញ របស់ ប្រជាកសិករ ក្រោយពេល ទឹក ស្រក ទៅ វិញ ។
ក្នុង ន័យ នេះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន អំពាវនាវ ទៅកាន់ អាជ្ញាធរ និង ប្រជាពលរដ្ឋ គ្រប់ ខេត្ត ដែល រង ការជន់ លិច ឱ្យ យកចិត្តទុកដាក់ ចាត់ វិធានការរក្សា ទឹក ទុក នៅ គ្រប់ ប្រភព ទឹក ទាំងអស់ មិន ថា ទំនប់ ប្រឡាយ ត្រពាំង ឬ ស្រះ ទឹក នោះ ទេ ត្រូវ រិះរក គ្រប់ លទ្ធភាព ក្នុង ការរក្សា ទឹក ទុក ឱ្យ បាន ច្រើន ។
លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន ស្នើ ទៅកាន់ អាជ្ញាធរ ទាំងមូលដ្ឋាន និង ខេត្ត ឱ្យ ចុះ ទៅ ពិនិត្យ ប្រភព ទឹក នានា ហើយ រិះរក វិធី ទប់ទឹក ទុក សម្រាប់ ឱ្យ ប្រជាពលរដ្ឋ ដាំដុះ ក្រោយ ទឹក ស្រក ។ ជាពិសេស សម្រាប់ ការធ្វើ ស្រែ របស់ ពួកគាត់ តែម្តង ៕
ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ព ពឹស ស្រុក ស្វាយអន្ទរ អំពាវនាវ ដល់ កម្មករ - កម្ម ការិនី នៅ ថ្ងៃ ឈប់សម្រាក បុណ្យ អុំ ទូក ត្រូវ ថែរក្សា សុខភាព និង គោរព ច្បាប់ ចរាចរណ៍ ឲ្យបាន ខ្ជាប់ខ្ជួន
( ព្រៃវែង ) ៖ លោក ជីវ ផល្លី ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ឃុំ ព ពឹស ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង បាន ថ្លែង អំពាវនាវ ដល់ កម្មករ កម្មការិនី ក្នុង ឱកាស ឈប់ សម្រាក នៃ ពិធី បុណ្យ អុំ ទូក អក អំបុក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ ថែរក្សា សុខភាព ជាពិសេស ទៅ ណា មក ណា ត្រូវ គោរព ច្បាប់ ចរាចរណ៍ ឲ្យបាន ខ្ជាប់ខ្ជួន ។
ការថ្លែង របស់ លោក ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ឃុំ ព ពឹស បែប នេះ ក្នុង ឱកាស អញ្ជើញ ចុះ សួរសុខទុក្ខ ដល់ កម្មករ កម្ម ការិនី នៅ ភូមិ ចំនួន ៤ ក្នុង ឃុំ ពពឹស ស្រុក ស្វាយអន្ទរ ខេត្ត ព្រៃវែង ដោយ មាន ការចូលរួម ពី លោក ញ៉ែ ម សៅ គ្រី ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត និង ក្រុមការងារ ឃុំ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក ប្រធាន ក្រុមការងារ បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា ដែល ជានិច្ចកាល សម្ដេច និង តែងតែ យកចិត្ដ ទុក្ខ ដាក់ គិតគូរ ពី សុខ ទុក្ខ របស់ បងប្អូន ប្រជាពលរដ្ឋ គ្រប់ ការលៈទេសៈ គ្រប់ ពេលវេលា គ្រប់ ស្រទាប់ វណ្ណៈ ដោយ មិន ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ និង និន្នាការ នយោបាយ អ្វី ឡើយ ។
សិក្ខាសាលា នេះ ធ្វើឡើង ក្នុង គោលបំណង ២ រួម មាន៖
* ផ្តល់ ជូន ដល់ អ្នកចូល អំពី ខ្លឹមសារ លម្អិត នៃ សៀវភៅ ណែនាំ ស្តីពី សវនកម្ម លើ កិច្ច ប្រតិបត្តិការ * ពិភាក្សា ផ្លាស់ប្តូរ ចំណេះដឹង និង បទពិសោធន៍ រវាង ក្រុម សវនកម្ម ដែល បាន អនុវត្ត ការងារ កន្លងមក ដើម្បី កំណត់ នូវ បញ្ហា ប្រឈម និង រៀបចំ ផែនការ សម្រាប់ ការបណ្តុះបណ្តាល នា ពេល អនាគត ។
សៀវភៅ ណែនាំ នេះ ត្រូវបាន រៀបចំ ផ្អែក លើ ច្បាប់ ស្តីពី សវនកម្ម នៃ ព្រះរាជាណាចក្រ កម្ពុជា ស្តង់ដារ អន្តរជាតិ នៃ ស្ថាប័ន សវនកម្ម កំពូល (ISSAIs) និង បទពិសោធន៍ នៃ ការធ្វើ សវនកម្ម លើ កិច្ច ប្រតិបត្តិការ របស់ អាជ្ញាធរ សវនកម្ម ជាតិ ផងដែរ ។
ទន្ទឹមនឹង ការ ដាក់ ឱ្យ អនុវត្ត នេះ អាជ្ញាធរ សវនកម្ម ជាតិ ក៏ បាន ខិតខំ កសាង សមត្ថភាព មន្រ្តី សវនកម្ម តាមរយៈ ការបណ្តុះបណ្តាល និង សិក្ខាសាលា ផ្ទៃក្នុង ការចាត់បញ្ចូល មន្រ្តី ចូលរួម វគ្គ បណ្តុះ បណ្តាល និង សិក្ខាសាលា ក្រៅ ប្រទេស ទស្សនកិច្ច សិក្សា ក្រៅ ប្រទេស និង កិច្ចសហប្រតិបត្តិការ ជាមួយ បណ្តា ស្ថាប័ន សវនកម្ម កំពូល នានា ។
លោកស្រី បាន គូសបញ្ជាក់ ថា សក្ខីភាព ទាំងនេះ បង្ហាញ ពី ភាពរីក ចម្រើន ឥត ឈប់ឈរ នៃ អាជ្ញាធរ សវនកម្ម ជាតិ ធ្វើឱ្យ សមត្ថភាព មន្រ្តី កាន់តែ ប្រសើរ ការងារ សវនកម្ម កាន់តែ ជឿ ទុកចិត្ត បាន កាន់តែ មាន គុណភាព និង ទាន់ ពេល វេលា ។ ការសម្រេច បាន ទាំងនេះ មិន កើត ទ្បើង ដោយ ចៃដន្យ នោះ ទេ គឺ កើត ទ្បើង ដោយសារ ការខិតខំ ប្រឹងប្រែង ការប្តេជ្ញាចិត្ត ខ្ពស់ និង ការចូលរួម យ៉ាង សកម្មភាព ពី ថ្នាក់ដឹកនាំ និង មន្រ្តី គ្រប់ ជាន់ ថ្នាក់ នៃ អាជ្ញាធរ សវនកម្ម ជាតិ ។
ទន្ទឹមនឹង នេះ លោកស្រី អគ្គ សវនករ ក៏ បាន សំណូមពរ អស់ លោក លោកស្រី ទាំងអស់ ដែល បាន ចូលរួម សិក្ខាសាលា ខិតខំ យក ចំណេះដឹង និង បទពិសោធន៍ ប្រែក្លាយទៅជា ការអនុវត្ត ជាក់ស្តែង នូវ ប្រភេទ សវនកម្ម លើ កិច្ច ប្រតិបត្តិការ នេះ ឱ្យ កាន់ ល្អ ប្រសើរ ទ្បើង និង ផ្សព្វផ្សាយ បន្ត ជូន សហការី នៅ តាម បណ្តា នាយកដ្ឋាន រៀង ៗ ខ្លួន ៕ លោក ហ៊ុន ម៉ាណែត ទទួលបាន អំណោយ មួយចំនួន ពី សមាគម ស្បែកជើង កម្ពុជា ដើម្បី ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ លោក ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង កម្ពុជា បាន ដឹកនាំ អនុប្រធាន និង គណៈកម្មការ សមាគម ជួប សម្ដែង ការគួរសម ជាមួយនិង លោក ហ៊ុន ម៉ាណែត និង បាន នាំយក អំណោយ មួយចំនួន ជូន ដល់ កងទ័ព ជើងគោក ដើម្បី ចូលរួមចំណែក ជួយ ដល់ កងទ័ព ជើងគោក ក្នុង យុទ្ធនាការ ដោះស្រាយ ការងារ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ទូទាំង ប្រទេស ដែល កំពុង រងគ្រោះ ដោយ ទឹក ជំនន់ ។
អំណោយ របស់ សមាគម រួម មាន៖ មី ចំនួន ២. ១៦៦កេស ទឹក បរិសុទ្ធ ចំនួន ៦០០ កេស និង ស្បែកជើង ចំនួន ២០០កេស ។
លោក ប្រធាន សមាគម បាន លើកឡើង ថា ដោយ មើលឃើញ យុទ្ធនាការជួយ ជនរងគ្រោះ ដោយសារ ទឹក ជំនន់ រហ័ស ទាន់ ពេលវេលា ក្រោម ការដឹកនាំ របស់ មេបញ្ជាការ កងទ័ព ជើងគោក សមាគម ព្រមទាំង អ្នក វិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា បាន ចូលរួមចំណែក ឧបត្ថម្ភ គាំទ្រ ចំពោះ កងទ័ព ដើម្បី ជួយសង្គ្រោះ ប្រជាជន ឲ្យបាន ទាន់ ពេល វេលា ។
លោក បន្ត ថា នេះ គឺជា ទឹកចិត្ត និង ការថ្លែងអំណរគុណ របស់ សមាគម ស្បែកជើង កម្ពុជា ចំពោះ កងទ័ព ដែល តែងតែ ឃើញ កងទ័ព នៅ ជួរ មុខ ជានិច្ច និង តែងតែ ចុះ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រាល់ ពេល ដែល មាន គ្រោះមហន្តរាយ ផ្សេង ៗ ។
លោក ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ ចំពោះ ទឹកចិត្ត សប្បុរសធម៌ និង ការចូលរួម គាំទ្រ ដ៏ ថ្លៃថ្លា បំផុត ចំពោះ ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង កម្ពុជា និង គណៈកម្មការ ទាំងអស់ ដែល បាន ចូលរួម ឧបត្ថម្ភ អំណោយ ជួយ ដល់ កងទ័ព ដើម្បី សង្គ្រោះ ប្រជាជន នៅក្នុង គ្រា ដ៏ លំបាក នេះ ៕
អំណោយ ប្រចាំ ខែ របស់ លោក ឧត្ដមសេនីយ៍ ឯក រ័ត្ន ស៊្រាង បាន ប្រគល់ ដល់ ដៃ ពលរដ្ឋ ទី ទាល់ ក្រ១៥ គ្រួសារ !
ទុរគត ជន ចំនួន ១៥ គ្រួសារ ដែល បាន ទទួល អំណោយ ជារៀងរាល់ ខែ រួម មាន៖
អង្គក ឋិន ទាន នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ បង្ហែរ ចូល វត្ត ព្រះឥន្ទ ទេព ជិត ប្រាសាទ បាយ័ន បាន បច្ច័យ កសាង ជាង ៦ម៉ឺន ដុល្លារ !
សម្រាប់ អង្គក ឋិន ទាន នេះ បច្ច័យ ជ្រះថ្លា ក្នុង ព្រះពុទ្ធ សាសនា ទទួលបាន ពី សប្បុរសជន ហើយ បាន វេរ ប្រគេន រួចស្រេច ជូន ព្រះចៅ អធិកាវត្ត មាន ទឹកប្រាក់ ចំនួន ៦៤៦៤៨. ៥ដុល្លារ អាមេរិក ។
ដោយឡែក ក្នុង ឱកាស នេះ ដែរ នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ ក៏ បាន ចូល បច្ច័យ កសាង ប្រគេន ដល់ ព្រះសង្ឃ ក្នុង វត្ត ពោធិ៍ បាត្រ ហៅ វត្ត ច្បារអំពៅ ចំនួន ៦លាន រៀល និង សំរាប់ ប្រាសាទ ព្រះអង្គ គោក ធ្លក ៥លាន រៀល និង ប្រគេន ព្រះសង្ឃ ២៨ អង្គ ក្នុង ១អង្គ ៥ម៉ឺន រៀល ព្រមទាំង បាន ជូន ថវិកា ដល់ កងកម្លាំង រក្សា សណ្ដាប់ធ្នាប់ សន្តិសុខ ក្នុង ម្នាក់ ៥ម៉ឺន រៀល ដែល មាន នគរបាល ចរាចរណ៍ ៤នាក់ នគរបាល ការពារ បេតិកភ័ណ្ឌ ១០នាក់ នគរបាល ទេសចរ ១នាក់ នគរបាល ប៉ុស្តិ៍ ៥នាក់ ភ្នាក់ងារ អប្សរា ១២នាក់ និង ប្រជាការពារ ៨នាក់ ។
គួរ បញ្ជាក់ ថា លោក ចូ បៃ ដិន បាន រំលឹក កាល គ្រា លោក នៅ ជា អនុប្រធានានាធិបតី អាមេរិក ដែល បាន ទៅ បំពេញ ទស្សនកិច្ច នៅ តំបន់ ព្រំដែន គ្មាន យោធា (DMZ) រវាង កូរ៉េ ទាំង ពីរ ដោយ កាល ណោះ លោក បាន ឈរ តែ ប៉ុន្មាន សិប ម៉ែត្រ ប៉ុណ្ណោះ ពី ទឹកដី កូរ៉េ ខាងជើង ។ លោក បៃ ដិន បាន សង្កត់ធ្ងន់ ថា លោក មាន ការឈឺចាប់ ចំពោះ ការបែកបាក់ គ្នា នៃ កូរ៉េ ទាំង ពីរ និង ជាពិសេស ក្រុមគ្រួសារ កូរ៉េ ដែល នៅ បន្ត រស់ នៅ ព្រាត់ប្រាស់ គ្នា រាប់ ទសវត្សរ៍ មក នេះ ៕
( មណ្ឌលគិរី ) ៖ តំបន់ រមនីយដ្ឋាន ជ្រៃ យ៉ូស នៅ ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគិរី ស្ថិត នៅក្នុង ដែន របៀង ជំរក សត្វ ព្រៃ ភ្នំ ព្រេច កំពុងតែ រង ការរំលោភបំពាន ធ្វើជា កម្មសិទ្ធិ ផ្ទាល់ខ្លួន ។
បើ តាម ប្រភព ព័ត៌មាន បាន បន្ថែម ទៀត ថា តំបន់ នោះ នៅ មាន ស្ថានភាព ជា ព្រៃ ដ៏ ស្គឹមស្កៃ ពេលនេះ កំពុង បំផុស បំផុល ប្រជាពលរដ្ឋ ឲ្យ មក ឆ្ការ កាប់ ព្រៃ នឹង ទាមទារ ថា ជា កន្លែង ដែល ខ្លួន កំពុង អាស្រ័យ ផល ។
សូម ជម្រាប ថា កន្លងមក លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ដ និង មន្ទីរ ពាក់ព័ន្ធ មាន វិធានការ ជា បន្ដ បន្ទាប់ ដើម្បី ទប់ស្កាត់ នៅ តំបន់ ខាងលើ ប៉ុន្ដែ នៅតែ មិន មាន ប្រសិទ្ធិភាព ដោយសារតែ ឈ្មួញ នៅតែ បន្ដ ការកាប់ ទន្ទ្រាន ដូច្នេះ ពលរដ្ឋ សូម ទទូច ឲ្យ អភិបាល ខេត្ត ជួយ អន្តរាគមន៍ និង ទប់ស្កាត់ មាន វិធានការ តាម ច្បាប់ ៕ លោក គុយ សុផល ប្រគល់ ព្រះរាជ ទ្រព្យ សម្រាប់ បូជា ព្រះសព ព្រះអនុគណស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង
ព្រះញាណ កិត្តិធម្ម សុខ ឆេង បាន ទទួល ព្រះអនិច្ច ធម្ម កាលពី ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២០ ក្នុង ព្រះជន្មាយុ ៥៣ ព្រះវស្សា ដោយ ព្រះរោគា ពាធ នៅ វត្ត សឹង្ហ សោភ័ណ្ឌ ហៅ វត្ត ព្រះអង្គ ពាន់ ស្ថិត នៅ ឃុំ ជ័យ កំពក ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ។
នៅ ព្រឹក ថ្ងៃ ដដែល នោះ ដែរ លោក បណ្ឌិត សភាចារ្យ រដ្ឋមន្ត្រី និង ប្រតិភូ រួម ដំណើរ បាន អញ្ជើញ ទៅ ពិនិត្យ ស្ថានភាព ផ្លូវ មួយ ខ្សែ ទៀត ក្នុង គម្រោង ជួសជុល បន្ទាន់ មាន ប្រវែង ១៣ ៧០០ ម៉ែត្រ ស្ថិត នៅក្នុង ឃុំ ពពេល ឃុំ ជាង ទង និង ឃុំ ត្រពាំង ធំ ខាងជើង ស្រុក ត្រាំ កក់ ដែល បាន ខូចខាត ដោយសារ ជំនន់ ទឹកភ្លៀង ផងដែរ ។
មានប្រសាសន៍ ក្នុង ឱកាស នោះ លោក បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន បាន គូសបញ្ជាក់ ថា ស្ថានភាព ជំនន់ ទឹកភ្លៀង បាន ចាប់ផ្ដើម ស្រក ជា បណ្តើរ ៗ ហើយ បាន បន្សល់ទុក នូវ ការខូចខាត ហេដ្ឋារចនាសម្ព័ន្ធ ដូចជា ផ្លូវ ស្ពាន ជាដើម ។ ក្រសួង អភិវឌ្ឍន៍ ជនបទ កំពុង អនុវត្ត យុទ្ធសាស្រ្ដ ពីរ សំខាន់ ៗ គឺ៖
ទី ១៖ ចំពោះ ផ្លូវ ស្ពាន ដែល ខូច ធ្ងន់ធ្ងរ ឬ ដាច់ ពុំ អាច ចរាចរណ៍ បាន ត្រូវ ធ្វើ ការកែសម្រួល បន្ទាន់ ដើម្បី ភ្ជាប់ ចរាចរណ៍ ឡើងវិញ ។
ទី២៖ ត្រូវ ធ្វើ ការសិក្សា លម្អិត ដើម្បី ធ្វើ ការជួសជុល ឲ្យ មាន លក្ខណៈ រឹងមាំ ប្រកបដោយ គុណភាព ។
( បាត់ដំបង ) ៖ ពលរដ្ឋ ១០០ គ្រួសារ រស់ នៅ ឃុំ តា គ្រាម ស្រុក បាណន់ ខេត្ត បាត់ដំបង ត្រូវបាន សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ដឹកនាំ ដោយ លោក ប៊ុត គឹម ស៊ាន ប្រធាន គណៈកម្មាធិការ សាខា និង លោកស្រី រួម ជាមួយ សប្បុរសជន និង សមាជិក សមាជិកា គណៈ
លោក បណ្ឌិត ក៏ បាន គូសបញ្ជាក់ ផងដែរ ថា ថ្នាក់ដឹកនាំ ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន តែងតែ នៅ រួម សុខ រួម ទុក្ខ ជាមួយ បងប្អូន និង មិន ទុក ប្រជាពលរដ្ឋ ណា ម្នាក់ ចោល ឡេីយ ទោះ នៅក្នុង កាលៈទេសៈ ណា ក៏ដោយ ។
ថ្លែង ក្នុង ពិធី នេះ លោក បណ្ឌិត ប៊ុត គឹម ស៊ាន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ សប្បុរសជន ទាំងអស់ ក្នុង និង ក្រៅ ប្រទេស ដែល បាន ចូលរួម ឧបត្ថម្ភ ថវិកា សម្ភារ និង គ្រឿង ឧបភោគ - បរិភោគ ជូន ដល់ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ដើម្បី ជួយ ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត ដែល រងគ្រោះ ដោយសារ ជំនន់ ទឹកភ្លៀង ដែល នេះ បាន បង្ហាញ ពី កម្លាំង សាមគ្គី គ្នា ស្រឡាញ់ គ្នា ក្នុង គ្រា ក្រ ស្គាល់ មិត្ត ល្អ ក្នុង គ្រា មាន អាសន្ន ខ្មែរ ជួយ ខ្មែរ ខ្មែរ កាន់តែ រឹងមាំ ។
ជាមួយគ្នា នោះ លោក ប្រធាន គណៈកម្មាធិការ សាខា បាន ពាំនាំ នូវ សារ អំពាវនាវ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្ញើ ជូន ដល់ បងប្អូន ជន រួម ជា តិ៖
* សូម ក្រុមគ្រួសារ ដែល មាន កូន ចៅ តូច ៗ កុំ បណ្តែត បណ្តោយ ឱ្យ លេង ទឹក ពីព្រោះ វា អាច បណ្តាលឱ្យ បាត់បង់ជីវិត ដោយសារ លង់ទឹក បាន ដូចនេះ ត្រូវការពារ ពួកគេ ឱ្យ បាន ល្អ ជៀសវាង មាន វិប្បដិសារី នៅពេល បាត់បង់ សមាជិក គ្រួសារ ដោយសារ ការធ្វេសប្រហែស នេះ ។
* សូម គិតគូរ និង យកចិត្តទុកដាក់ ថែទាំ សុខភាព ឱ្យ បាន ល្អ និង រក្សា អនាម័យ ព្រោះ សុខភាព ជា កត្តា ចម្បង សម្រាប់ យើង គ្រប់ គ្នា ដូច្នេះ សូម គ្រប់ ក្រុមគ្រួសារ ត្រូវ បរិភោគ ទឹក ដាំ ឆ្អិន ល្អ ដើម្បី ការពារ កុំ ឱ្យ កើតមាន ជំងឺ រាគរូស ឬ ជំងឺ ដង្កាត់ នានា ដែល ធ្វើឱ្យ ខាតបង់ ពេលវេលា និង ថវិកា ក្នុង ការព្យាបាល ជំងឺ ។
* នៅពេល ទឹក ស្រក មុនពេល ត្រឡប់ ទៅ រស់ នៅ លំនៅដ្ឋាន វិញ សូម សម្អាត ផ្ទះ ឬ បរិស្ថាន ជុំវិញ ផ្ទះ ឱ្យ បាន ស្អាត មាន អនាម័យ និង ត្រូវ ប្រុងប្រយ័ត្ន ពី សត្វ អាសិរពិស ដែល វា បាន ទៅ រស់ នៅ តាម ដំបូល ផ្ទះ ឬ កន្លែង ផ្សេង ៗ ក្នុង ផ្ទះ របស់ យើង ដែល ពួក វា អាច បង្ក គ្រោះថ្នាក់ ដល់ ជីវិត ហេីយ សូម បន្ត ប្រកបរបរ ចិញ្ចឹម ជីវិត ដេីម្បី ស្តារ សេដ្ឋកិច្ច គ្រួសារ ឡេីង វិញ ។
* សូម បន្ត ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ ត្រូវ ពាក់ ម៉ាស លាង ដៃ នឹង សាប៊ូ និង មាន ស្មារតី ប្រុងប្រយ័ត្ន ជានិច្ច ដោយ អនុវត្ត តាម វិធានការ នានា របស់ ក្រសួង សុខាភិបាល និង ទម្លាប់ រស់ នៅ តាម បែប គន្លង ថ្មី ។
ផ្ទៃដី ស្រូវ វស្សា ជាង ៥ពាន់ ហិកតា ប៉ះពាល់ ដោយ ទឹក ជំនន់ និង ជាង ២ពាន់ ហិកតា រង ការខូចខាត នៅ ខេត្ត ព្រះវិហារ . ក្រសួង កសិកម្ម ចុះ ពិនិត្យ វាយតម្លៃ ការខូចខាត ដើម្បី រៀបចំ ស្តា ឡើងវិញ ជូន ពលរដ្ឋ
( ព្រះវិហារ ) ៖ ស្ថានភាព ទឹក ជំនន់ ដង ស្ទឹង សែន និង ជំនន់ ទឹកភ្លៀង បាន ធ្វើឲ្យ ប៉ះពាល់ ផ្ទៃដី ស្រូវ វស្សា របស់ ប្រជាពលរដ្ឋ នៅ ខេត្ត ព្រះវិហារ ទាំង ក្រុង ស្រុក ចំនួន ៨ សរុប ៥. ០២៣ ហិកតា ស្មើនឹង ៣១៤៥ គ្រួសារ និង ផ្ទៃដី ស្រូវ វស្សា របស់ ប្រជាកសិករ ៦ក្រុង ស្រុក ចំនួន ២. ៧៧៦ហិកតា ស្មើនឹង ២. ០៩៦គ្រួសារ ទៀត រង ការខូចខាត ។
តាម របាយការណ៍ របស់ ក្រុមការងារ ដែល ដឹកនាំ ដោយ លោក គុយ ម៉ារិន ឌី រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ តំណាង លោក រដ្ឋមន្ត្រី វេង សាខុន រួម ដំណើរ ដោយ លោក ពឹង ទ្រី ដា ប្រធាន មន្ទីរ កសិកម្ម ខេត្ត ព្រះវិហារ បាន ឲ្យដឹង ទៀត ថា ក្នុង ខេត្ត នេះ ដំណាំ បន្លែ និង សត្វ ចិញ្ចឹម របស់ ប្រជាពលរដ្ឋ មួយចំនួន ក៏ រង ការខូចខាត និង ឈឺ ស្លាប់ ជា បន្តបន្ទាប់ ផងដែរ ។
ក្នុង គោល បំំណង ដើម្បី ស្តា ឡើងវិញ និង ដោះស្រាយ បញ្ហា ប្រឈម នេះ ក្រុមការងារ ដោយ មាន ការឯកភាព ពី លោក គុយ ម៉ារិន ឌី បាន ធ្វើ ការស្នើ ការសម្រេច ពី លោក រដ្ឋមន្ត្រី សុំ គ្រាប់ ពូជ បន្លែ មាន រយៈពេល ខ្លី សម្រាប់ ផ្តល់ ជូន កសិករ ដែល ខូចខាត ២០៩៦ គ្រួសារ ស្នើសុំ សម្ភារ បសុសត្វ មាន វ៉ាក់សាំង អ៊ុត ក្តាម ៣០០០ ដូស ថ្នាំ បញ្ចុះ កំដៅ ២០០ ដប ថ្នាំ អង់ទីប៊ីយ៉ូទិច ២០០ ដប ស្នើសុំ ប្រភេទ ពូជ ស្រូវ ស្រាល និង ស្រូវ កណ្តាល សម្រាប់ រដូវ វស្សា ឆ្នាំ ២០២១ សម្រាប់ ប្រជាពលរដ្ឋ ២០៩៦ គ្រួសារ ស្មើ ២០៩៦០ តោន ។
( សៀមរាប ) ៖ ប្រជាពលរដ្ឋ មួយចំនួន នៅ ស្រុក អង្គរ ជុំ ខេត្ត សៀមរាប បាន ស្នើ ដល់ អាជ្ញាធរ និង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ ទាំងអស់ ឱ្យ ជួយ ទប់ស្កាត់ ការធ្វើចរាចរណ៍ របស់ រថយន្ត ធុន ធំ ដែល មួយចំនួន ត្រូវបាន សង្ស័យ ថា ដឹក លើស ទម្ងន់ ដែល បាន ធ្វើឱ្យ ខូចខាត យ៉ាង ធ្ងន់ធ្ងរ ដល់ ផ្លូវ ក្រាល កៅស៊ូ មួយ កន្លែង ភ្ជាប់ ផ្លូវ ជាតិ លេខ ៦ ( ចំណុច ផ្សារ ពួក ) ទៅ រង្វង់ មូល ស្រុក អង្គរ ជុំ ។
ប្រជាពលរដ្ឋ រស់ នៅ តាម បណ្តោយ ដង ផ្លូវ នេះ បាន ឱ្យដឹង ថា ចាប់ពី ផ្លូវ នេះ ត្រូវបាន ស្ថាបនា រួចរាល់ ដើម ឆ្នាំ ២០២០ ធ្វើឱ្យ ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង ស្រុក អង្គរ ជុំ និង ស្រុក ពួក មាន ការសប្បាយ ចិត្ត យ៉ាង ខ្លាំង ។ ប៉ុន្តែ មួយ រយៈ ចុងក្រោយ នេះ ផ្លូវ មួយ ខ្សែ នេះ កំពុង រង ការបំផ្លាញ ដោយ រថយន្ត ដឹកជញ្ជូន ធន់ ធំ ដឹក ទំនិញ ដែក ស៊ីម៉ង់តិ៍ ថ្ម ខ្សាច់ និង ស្រូវ លើស ទម្ងន់ គេច ពី ជញ្ជីង ថ្លឹង របស់ សាធារណការ ហើយ ធ្វើចរាចរណ៍ លើ ផ្លូវ នេះ យ៉ាង មមាញឹក ។
ប្រជាពលរដ្ឋ នៅ តំបន់ នេះ មាន ការខឹងសម្បារ យ៉ាង ខ្លាំង ចំពោះ ការបំផ្លាញ ពី ក្រុមហ៊ុន និង ឈ្មួញ រកស៊ី ដឹកជញ្ជូន ដោយ គ្មាន ការ ទប់ស្កាត់ ឬ អើពើ ពី សមត្ថមត្ថកិច្ច ឬ អាជ្ញាធរ ឃុំ ស្រុក ឡើយ ។ ប្រជាពលរដ្ឋ កំពុងតែ ព្រួយបារម្មណ៍ ពី ផ្លូវ នេះ បើ គ្មាន ការ ទប់ស្កាត់ ឱ្យ បាន ទាន់ ពេលវេលា ទេ ផ្លូវ នេះ នឹង ត្រូវ រង ការខូចខាត កាន់តែ ខ្លាំង ឡើង ៗ ក្នុង ពេល ឆាប់ នេះ និង ធ្វើឱ្យ ខាតបង់ ថវិកា រដ្ឋ យ៉ាង ច្រើន ។
ប្រជាពលរដ្ឋ បាន សុំ ឱ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច ជួយ ការពារ ផ្លូវ ខាងលើ និង ទប់ស្កាត់ រថយន្ត ដឹកជញ្ជូន ធន់ ធ្ងន់ កុំ ឱ្យ បើក លើ ផ្លូវ នេះ តទៅទៀត ដើម្បីឱ្យ ប្រជាពលរដ្ឋ បាន ប្រើ ផ្លូវ នេះ បាន យូរអង្វែង តទៅ មុខ ទៀត ។
ទាក់ទង នឹង ករណី នេះ លោក ខេង ញុល ប្រធាន មន្ទីរ អភិវឌ្ឍ ជនបទ ខេត្ត សៀមរាប បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង ថា កន្លងទៅ នេះ លោក បាន ជម្រាប ដល់ អាជ្ញាធរ ស្រុក និង ចុះ ពិនិត្យមើល ស្ថានភាព ផ្លូវ នេះ រួចហើយ ដោយ កំពុង រក ដំណោះស្រាយ ជូន ប្រជាពលរដ្ឋ ។ លោក អះអាង ថា ផ្លូវ នេះ បាន រង ការខូចខាត ដោយ រថយន្ត ធុន ធ្ងន់ ពិតប្រាកដ មែន ហើយ មួយចំនួន ទៀត បាន ខូចខាត ដោយសារ ជំនន់ ទឹកភ្លៀង ។
លោក អះអាង ថា រថយន្ត ទាំងនោះ មាន ការតទ្រុង ដែល ភាគរយ នៃ ការលើស ទម្ងន់ គឺ អាច មាន ច្រើន ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី នៅ តំបន់ នេះ មិន មាន ជញ្ជីង ថ្លឹង នោះ ទេ ។ លោក សង្ឃឹម ថា នឹង អាច ដោះស្រាយ នៅ ក្រោយ ថ្ងៃ ឈប់សម្រាក ផងដែរ ។
រដ្ឋមន្ត្រី ធនធាន ទឹក ចុះ ពិនិត្យ ស្ថានភាព ទឹក នៅ ខេត្ត សៀមរាប និង ខេត្ត បន្ទាយមានជ័យ ដើម្បី ពន្លឿន អន្ដរាគមន៍ រំដោះ ទឹក ឲ្យ ស្រក លឿន ចូល បឹង ទន្លេ សាប
( សៀមរាប - បន្ទាយមានជ័យ )៖ នៅ ព្រឹក ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម អម ដំណើរ ដោយ លោក អនុ រដ្ឋលេខាធិការ ដែល ជា ប្រធាន មុខ ព្រួញ ខេត្ត សៀមរាម និង ខេត្ត បន្ទាយមានជ័យ ក្រុម មន្រ្តី បច្ចេកទេស ក្រសួង និង លោក ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត សៀមរាប និង ខេត្ត បន្ទាយមានជ័យ បាន បន្ត ដំណើរ បេសកកម្ម ចុះ ពិនិត្យ ស្ថានភាព ទឹក ទូទៅ នៃ ខេត្ត ទាំង ០២ ។
ការចុះ មក ត្រូត ពិនិត្យ ស្ថានភាព ទឹក នេះ ដើម្បី បន្ថែម មធ្យោបាយ ពន្លឿន សកម្មភាព អន្តរាគមន៍ រំដោះ បរិមាណ ទឹក ជន់ ឲ្យ ស្រក លឿន ហូរ ឆ្ពោះ ចូលទៅ បឹង ទន្លេ សាប ដែល ជា វិធាន ការ ចំពោះ មុខ ដើម្បី បន្ថយ ផល ប៉ះពាល់ ដល់ ដំណាំ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ប្រព័ន្ធ អាងទឹក ត្រពាំង ថ្ម នៅ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ និង ផ្នែក ខាងក្រោម ក្នុង ខេត្ត សៀមរាម ។
ទន្ទឹម នឹង នោះ ក៏ បាន ចាត់ វិធានការ ជាបន្ទាន់ ដល់ គ្រប់ មុខ ព្រួញ តាម បណ្តា ខេត្ត ឲ្យ ខ្ចប់ រក្សា ទឹក ទុក សម្រាប់ ប្រើប្រាស់ ជា ពហុ ប្រយោជន៍ នៅពេល ខាងមុខ ផងដែរ ។
តាមរយៈ ការចុះ ពិនិត្យ ជាក់ស្តែង នា ព្រឹក នេះ លោក រដ្ឋមន្រ្តី លឹម គាន ហោ ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង ក្រុម មន្រ្តី បច្ចេកទេស បាន ចុះ ពិនិត្យ ផ្ទាល់ នៅ ប្រឡាយ កុមារ នៃ ប្រព័ន្ធ ត្រពាំង ថ្ម ដែល ជា ប្រឡាយ រំដោះ ទឹក និង ស្រោចស្រព ក្នុង ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ហើយ ក្នុង ពេល បច្ចុប្បន្ន ប្រឡាយ នេះ កំពុង បំពេញ តួនាទី ជា ប្រឡាយ រំដោះ ទឹក យ៉ាង សំខាន់ មួយ បន្លែម ពីលើ ប្រឡាយ មេ ធំ ៗ ចំនួន ៣ សម្រាប់ សម្រួល ចរន្ត ទឹក ពី អាងទឹក ត្រពាំង ថ្ម ហូរ ចុះ ទៅ បឹង ទន្លេ សាប ៕
លោក ស្មាន ទៀត សំណេះសំណាល និង ចែក អំណោយ ជូន ពលរដ្ឋ ខ្មែរ មូស្លីម នៅ ស្រុក ក្រគរ និង ស្រុក កណ្តៀង និង ប្រាប់ ពី តម្លៃ សន្តិភាព
( ពោធិ៍សាត់ )៖ លោក ស្មាន ទៀត រដ្ឋលេខាធិការ ក្រសួង រ៉ែ និង ថាមពល និង ជា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ក្រគរ និង ស្រុក កណ្តៀង នៅ ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០២០ បាន បន្ត ចុះ ជួប សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ និង ចែក កញ្ចប់ អាហារ ចំនួន ២៩៩ គ្រួសារ នៅ ភូមិ ចុង ខ្លុង ឃុំ អូសណ្តាន់ ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ដែល មាន ការចូលរួម ពី លោក អភិបាល ស្រុក ក្រគរ លោក មេឃុំ លោក មេភូមិ ហាកឹម និង សមាជិក សមាជិការ ក្រុមការងារ ព្រមទាំង យុវជន សសយក ឃុំ អូសណ្តាន់ ។
ក្នុង កិច្ច សំណេះសំណាល នេះ លោក ស្មាន ទៀត បាន សំដែង នូវ មនោសញ្ចេតនា អាណិត ស្រលាញ់ បងប្អូន ទាំង គ្រួសារ ជនរងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ក៏ ដូចជា គ្រួសារ ទី ទាល់ ក្រ ផងដែរ និង បាន ពន្យល់ ប្រាប់ ពី តម្លៃ នៃ សន្តិភាព ដែល សម្ដេច តេជោ និង សហការី ទាំងអស់ ខិតខំ រក បាន មក ទាំង លំបាក លំបិន ព្រមទាំង ដឹកនាំ នាវា មួយ នេះ ឲ្យ មាន ការរីកចំរើន ទៅ មុខ ជាលំដាប់ ។
លោក ស្មាន ទៀត ក៏ បាន ពាំនាំ នូវ ការងារ សាកសួរ សុខទុក្ខ ពី លោក កែវ រតនៈ ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ក្រគរ និង ស្រុក កណ្តៀង ដែល តែងតែ យកចិត្តទុកដាក់ ពី ក្តីកង្វល់ នានា របស់ បងប្អូន ដោយ ប្រទេស យើង មាន សន្តិភាព ពេលេញ ទើប យើង មាន លទ្ធភាព ជួយ គ្នា ទោះ ក្នុង កាលៈទេសៈ ណា ក៏ដោយ ។
លោក ក៏ បាន ផ្តាំផ្ញើ ឲ្យ បងប្អូន រស់ នៅ ស្អាត ថែរ រក្សា សុខភាព ជាពិសេស សុំឲ្យ បងប្អូន ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ ឆ្លង កូវីដ១៩ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
គួរ ជម្រាប ជូន ថា គិត មកដល់ ពេលនេះ លោក ស្មាន ទៀត បាន ចែក ដល់ បងប្អូន នៅ ស្រុក ក្រគរ និង ស្រុក កណ្តៀង សរុប ប្រមាណ ១. ៥០០ គ្រួសារ ហើយ និង នៅតែ បន្ត ជួយ សង្គម បន្តបន្ទាប់ ទៀត ៕
( អ៉ីស្តង់ ប៊ុល ) ៖ គ្រោះ រញ្ជួយ ផែនដី កម្រិត ធ្ងន់ រហូតដល់ទៅ ៧. ០រ៉ិច ទ័រ បាន វាយប្រហារ ទីក្រុង ជាប់ តំបន់ ឆ្នេរ នៃ ភាគ ខាងលិច ប្រទេស តួកគី នៅ ថ្ងៃសុក្រ ទី៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ ដោយ បាន បណ្តាលឲ្យ អគារ នានា ក្នុង ទីក្រុង ញាប់ញ័រ និង បង្កឲ្យ មនុស្សម្នា ភ័យខ្លាច ហើយ រត់ ចេញមក ឈរ តាម ដងផ្លូវ ដើម្បី គេច ចេញពី គ្រោះថ្នាក់ ជា យថាហេតុ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ CNN នៅ មុន នេះ បន្តិច នា យប់ ថ្ងៃសុក្រ ។
គួរ បញ្ជាក់ ថា ភ្លាម ៗ បែប នេះ មិន ទាន់ មាន ព័ត៌មាន អំពី ចំនួន មនុស្ស រងរបួស ឬ បាត់បង់ជីវិត នៅឡើយ ទេ ។ គ្រោះ រញ្ជួយ ដី ខាងលើ នេះ បាន កើតឡើង ចេញ ពី ក្នុង ជម្រៅ ដី ១០គីឡូម៉ែត្រ នៅក្នុង ដែន សមុទ្រ ទល់ មុខ ទីក្រុង Izmire របស់ តួកគី តែម្តង ។ ពេលនេះ អាជ្ញាធរ តួកគី កំពុងតែ ចេញ ប្រតិបត្តិការ សង្គ្រោះ យ៉ាងរហ័ស បំផុត ទៅកាន់ កន្លែង កើត ហេតុ ជាពិសេស កន្លែង ដែល មាន អគារ ដួលរលំ ៕ អភិបាល ខេត្ត កំពត ចុះ ពិនិត្យ ដង ផ្លូវ សំខាន់ ៗ ក្នុង រក្រុង ដើម្បី ជំរុញ ការកែលម្អ សោភ័ណភាព និង រៀបចំ បន្ថែម ប្រព័ន្ធ លូដោះ ទឹក
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ មន្រ្តី នៃ មន្ទីរ អង្គភាព ជំនាញ និង អាជ្ញាធរ ពាក់ព័ន្ធ ក្រុង និង សង្កាត់ ចុះ ពិនិត្យ ទីតាំង តាម ដងផ្លូវ សំខាន់ ៗ មួយចំនួន ក្នុង សង្កាត់ ទាំង៥ នៃ ក្រុង កំពត ក្នុង គោលបំណង បង្កើន ការជំរុញ រៀបចំ កែលម្អ ប្រព័ន្ធ ផ្លូវ និង លូដោះ ទឹកភ្លៀង បន្ថែម រួម នឹង ការពង្រឹង រៀបចំ សណ្ដាប់ធ្នាប់ សោភ័ណភាព អនាម័យ បរិស្ថាន ក្នុង ក្រុង កំពត ឲ្យបាន កាន់តែ ប្រសើរឡើង ផងដែរ ។
ទីបំផុត ជប៉ុន សម្រច បន្ធូរបន្ថយ ការរឹតត្បិត ធ្វើដំណើរ លើ ចិន និង ប្រទេស - កោះ ចំនួន ៨ទៀត
ប្រទេស និង ដែនដី ដែល ត្រូវបាន ជប៉ុន បន្ធូរបន្ថយ ការរឹតត្បិត នៅ ពេល នេះ មាន ដូចជា ចិន កូរ៉េ ខាងត្បូង អូស្ត្រាលី ថៃ សិង្ហបុរី នូវែលសេឡង់ ប្រ៊ុយណេ វៀតណាម និង កោះ តៃវ៉ាន់ ។ ការបន្ធូរបន្ថយ ការរឹតត្បិត ខាងលើ នេះ ត្រូវបាន រដ្ឋមន្ត្រី ការបរទេស ជប៉ុន លោក ម៉ូតេគិ តូហ្ស៊ី មីត ស៊ូ (Toshimitsu Motegi) លើកឡើង ថា ជា ការស្តារ សេដ្ឋកិច្ច ជប៉ុន ឡើងវិញ ខណៈ កម្រិត ព្រមាន បាន ធ្លាក់ មក នៅ ត្រឹម កម្រិត ណែនាំ ចំពោះ ពលរដ្ឋ ជប៉ុន ដែល ត្រូវ ធ្វើដំណើរ ទៅកាន់ បណ្តា បណ្តា ប្រទេស និង កោះ ទាំងនោះ ។
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ. រយៈពេល ១៨៣ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២០១.៦៣៦ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១៤៩ .០០២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៥២. ៦៣៤ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ១៨៣ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១៣លើក ក្នុង នោះ ស្លាប់ ០៤ នាក់ របួស ០២ នាក់ ( របួស ធ្ងន់ ២៣នាក់ ) ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ២៩ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៣៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៨៩ ខែតុលា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ៣០ ខែតុលា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៧ នាក់ នោះ មាន ៤នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ៥ករណី និង ជនសង្ស័យ ៣៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៦ករណី ។
ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣០ ខែតុលា៖ បង្ក្រាប ២១ករណី ឃាត់ខ្លួន ៥២ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៤ករណី និង ជួញដូរ ១៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥២ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៨. ៥៧១ ករណី ឃាត់ មនុស្ស ១៧. ៤៨៤ នាក់ ( ស្រី ១០៨១ នាក់ )៕ តំណាង លោក សៅ សុខា នាំ អំណោយ ប្រគល់ ជូន ពលរដ្ឋ ចាស់ជរា និង មាន ជីវភាព ខ្វះខាត ១៥០ គ្រួសារ ក្នុង ស្រុក រមាសហែក
( ស្វាយរៀង ) ៖ លោក រស់ ឆាយ សមាជិក ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ បាន ចូលរួម ជួប សំណេះសំណាល និង នាំយក អំណោយ នាយ ឧត្តមសេនីយ៍ សៅ សុខា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ស្រុក រមាសហែក ប្រគល់ ជូន ប្រជាពលរដ្ឋ ចាស់ជរា និង មាន ជីវភាព ខ្វះខាត ១៥០ គ្រួសារ ស្ថិត ក្នុង ភូមិ ត្រពាំង តាកែវ ឃុំ ជ្រៃ ធំ ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង ។
ពិធី នេះ មាន ការចូលរួម ពី លោក ស៊ូ ម៉ុល អភិបាល ស្រុក . លោក អ៉ិន សាបន ប្រធាន ក្រុមប្រឹក្សា ស្រុក លោក មេឃុំ មន្ត្រី សាលា ស្រុក និង កងកម្លាំង ព្រមទាំង ប្រជាការពារ ភូមិ ជាច្រើន នាក់ ផងដែរ ។
សមាជិក ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង បាន ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ និង ក្តី នឹករលឹក ពីសំណាក់ លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា ដែល លោក តែងតែ គិតគូរ អំពី សុខ ទុក្ខ ដល់ បងប្អូន ប្រជាពលរដ្ឋ នៅ ស្រុក រមាសហែក ជាពិសេស ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក និង ខ្វះខាត ។ លោក បន្ត ថា ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍ គ្រប់ ទីកន្លែង ធ្វើឱ្យ ប្រជាពលរដ្ឋ មាន ឱកាស បាន ធ្វើដំណើរកម្សាន្ត ប្រកបរបរ ក ស៉ី បាន ដោយ សេរី និង ធ្វើ បុណ្យ ទាន បាន គ្រប់ ទីកន្លែង ទូទាំង ប្រទេស ។
លោក ហ៊ុន ម៉ាណែត ទទួលបាន ថវិកា ២ម៉ឺន ដុល្លារ និង អង្ករ ២០តោន ពី ឧកញ៉ា ឡេង ណា វ៉ា ត្រា ក្នុង ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់
អំណោយ របស់ កាកបាទ ក្រហម កម្ពុជា ត្រូវបាន នាំយក ទៅ ចែកជូន ពលរដ្ឋ ១០០ គ្រួសារ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ សង្កាត់ ចោម ចៅ ទី២ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ក្រីក្រ បន្ថែម ដោយ គ្រោះ ជំនន់ ទឹកភ្លៀង ចំនួន ១០០ គ្រួសារ នៅ សង្កាត់ ចោម ចៅ ទី២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ បាន ទទួល អំណោយ មនុស្សធម៌ កាកបាទ ក្រហម កម្ពុជា របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ។
ពិធី ចែក អំណោយ នៅ បាន ប្រព្រឹត្តទៅ នា រសៀល ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ នៅ បរិវេណ វត្ត ព្រៃ ស្ពឺ ក្នុង សង្កាត់ ចោម ចៅ ទី២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។ ដោយ មាន ការចូលរួម ពី លោកស្រី ឈុន ស៊ុន នី អភិបាល រង ខណ្ឌ . លោកស្រី អ៊ឹម ថា វី ប្រធាន គណៈកម្មាកាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា . លោក យិន គា នាយក រដ្ឋបាល ខណ្ឌ . លោក វ៉ា សារ៉ង ចៅសង្កាត់ ចោម ចៅ ទី២ ព្រមទាំង មន្រ្តី ខណ្ឌ . សង្កាត់ . ភូមិ និង នគរបាល ជាច្រើន រូប ទៀត ផងដែរ ។
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី ឈុន ស៊ុន នី បាន នាំ នូវ ផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច កិតិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ចំពោះ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល ជានិច្ចកាល សម្តេច តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ។
លោកស្រី បាន បន្ត ថា សម្ដេច តែងតែ បាន ណែនាំឲ្យ សមាជិក សមាជិកា ប្រចាំ មណ្ឌល នីមួយ ៗ ចុះ ជាប្រចាំ តាម មូលដ្ឋាន ដើម្បី ដឹង ពី សុខ ទុក្ខ ពី បញ្ហា ប្រឈម និង ពី តម្រូវការ ជាក់ស្តែង ចាត់ វិធានការដោះស្រាយ ឲ្យបាន សមស្រប និង ជាបន្ទាន់ ។
រដ្ឋមន្ត្រី ធនធាន ទឹក បញ្ជា ឲ្យ ក្រុមការងារ សហការ ជាមួយ មន្ទីរ ជំនាញ ធ្វើ ការជួសជុល បិទ ភ្ជិត ខ្នង ប្រឡាយ ជាបន្ទាន់ ដើម្បី រក្សា ទឹក ទុក បង្កបង្កើន ផល
( សៀមរាប ) ៖ លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម អម ដំណើរ ដោយ លោក ពេជ្រ វាសនា អនុ រដ្ឋលេខាធិការ ដែល ជា ប្រធាន មុខ ព្រួញ ខេត្ត សៀមរាប ក្រុម មន្រ្តី បច្ចេកទេស និង លោក ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត សៀមរាប នៅ រសៀល ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន បន្ត បេក សកម្ម ចុះ ពិនិត្យ ស្ថានភាព ទឹក និង ចាត់ បញ្ជា អន្តរាគមន៍ តភ្ជាប់ ទំនប់ ប្រឡាយ ដូន កាយ ថ្មី នៅក្នុង ឃុំ ជន្លាស់ ដៃ ស្រុក ក្រឡាញ់ ខេត្ត សៀមរាប ។
ក្នុង ពេល ចុះ ពិនិត្យ នេះ លោក រដ្ឋមន្រ្តី លឹម គាន ហោ បាន ណែនាំ បន្ថែម ដល់ លោក ដែល ជា ប្រធាន មុខ ព្រួញ ឲ្យ សហការ ជាមួយ មន្ទីរ ជំនាញ ប្រញាប់ ធ្វើ ការជួសជុល បិទ ភ្ជិត ខ្នង ប្រឡាយ ជាបន្ទាន់ ដើម្បី ខ្ចប់ រក្សា ទឹក ទុក សម្រាប់ ប្រើប្រាស់ ការងារ បង្កបង្កើន និង ទឹក ជីវភាព ប្រចាំ ថ្ងៃ ព្រមទាំង ភ្ជាប់ បាន ផ្លូវ ខាង សង ប្រឡាយ ធ្វើចរាចរណ៍ ក្នុង ភូមិ និង ដឹក កសិផល ផងដែរ ។
កាល នា ព្រឹក មិញ នេះ លោក លឹម គាន ហោ អម ដំណើរ ដោយ លោក អនុ រដ្ឋលេខាធិការ ដែល ជា ប្រធាន មុខ ព្រួញ ខេត្ត សៀមរាម និង ខេត្ត បន្ទាយមានជ័យ ក្រុម មន្រ្តី បច្ចេកទេស ក្រសួង និង លោក ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត សៀមរាប និង ខេត្ត បន្ទាយមានជ័យ ក៏ បាន បន្ត ដំណើរ បេសកកម្ម ចុះ ពិនិត្យ ស្ថានភាព ទឹក ទូទៅ នៃ ខេត្ត ទាំង ០២ ផងដែរ ។
តាមរយៈ ការចុះ ពិនិត្យ ជាក់ស្តែង នា ព្រឹក នេះ លោក រដ្ឋមន្រ្តី លឹម គាន ហោ ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង ក្រុម មន្រ្តី បច្ចេកទេស បាន ចុះ ពិនិត្យ ផ្ទាល់ នៅ ប្រឡាយ កុមារ នៃ ប្រព័ន្ធ ត្រពាំង ថ្ម ដែល ជា ប្រឡាយ រំដោះ ទឹក និង ស្រោចស្រព ក្នុង ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ហើយ ក្នុង ពេល បច្ចុប្បន្ន ប្រឡាយ នេះ កំពុង បំពេញ តួនាទី ជា ប្រឡាយ រំដោះ ទឹក យ៉ាង សំខាន់ មួយ បន្លែម ពីលើ ប្រឡាយ មេ ធំ ៗ ចំនួន ៣ សម្រាប់ សម្រួល ចរន្ត ទឹក ពី អាងទឹក ត្រពាំង ថ្ម ហូរ ចុះ ទៅ បឹង ទន្លេ សាប ។
បន្ថែម ពី នេះ លោក រដ្ឋមន្រ្តី ក៏ បាន ជួយ សាង សាង់ ស្ពាន ឆ្លងកាត់ ប្រឡាយ មេស្ទឹង ស្រែង ១ ត្រង់ ចំណុច ភូមិ ជើង ទៀន ឃុំ ជើង ទៀន ស្រុក ចុង កាល់ ជា កាដូ អនុស្សាវរីយ៍ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដើម្បី ជួយ សម្រួល ការធ្វើដំណើរ ប្រចាំ ថ្ងៃ របស់ ពួកគាត់ ។
លោក អភិបាល ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង មន្ទីរ ជំនាញ ព្រមទាំង ប្រជាពលរដ្ឋ ក្នុង តំបន់ មាន សេចក្តី សោម ន្សរីករាយ ជាខ្លាំង និង បាន ថ្លែងអំណរគុណ លោក រដ្ឋមន្រ្តី ថ្នាក់ដឹកនាំ ក្រសួង មន្រ្តី គ្រប់ ជាន់ ថ្នាក់ ដែល បាន ខិតខំ បំពេញ ការងារ អន្តរាគមន៍ ជួយ បន្ថយ ផល ប៉ះពាល់ និង សម្រួល ការលំបាក របស់ ពួកគាត់ លើ វិស័យ ធនធាន ទឹក ៕ ដំណាំ ស្រូវ ជិត ៤ម៉ឺន ហិកតា នៅ ខេត្ត ពោធិ៍សាត់ រង ការប៉ះពាល់ ដោយ ទឹក ជំនន់ . រដ្ឋមន្ដ្រី កសិកម្ម ចុះ ចែក ពូជ ស្រូវ ដើម្បី ស្ដារ សន្ដិសុខ ស្បៀង ឡើងវិញ
( ពោធិ៍សាត់ )៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល និង នាំយក ពូជ ស្រូវ ចំនួន ២៩.២តោន និង គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ចែកជូន ប្រជាកសិករ ចំនួន ៣០៩ គ្រួសារ នៅ ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បញ្ជាក់ ថា ឥទ្ធិពល នៃ ជំនន់ ទឹកភ្លៀង បាន ធ្វើឲ្យ ប៉ះពាល់ ដល់ ផលិតកម្ម ដំណាំ ស្រូវ ដំណាំ សាក វប្បកម្ម និង ដំណាំ កសិ- ឧស្សាហកម្ម ក្នុង ស្រុក ចំនួន ៤ ឃុំ ចំនួន ៣៤ ភូមិ ចំនួន ២៩៥ និង មាន ១៨ ៧៥៨ គ្រួសារ រង ផល ប៉ះពាល់ ។
គិត មកដល់ ថ្ងៃទី ២៨ ខែតុលា ដំណាំ ស្រូវ រង នូវ ផល ប៉ះពាល់ សរុប មាន ចំនួន ៣៦. ០៦៩ ហិកតា មាន ស្រូវ ស្រាល ស្រូវ ដើម រដូវ ស្រូវ កណ្តាល ស្រូវ ឡើង ទឹក និង ស្រូវ ធ្ងន់ ហើយ ក្នុង នោះ ផ្ទៃដី ដំណាំ ស្រូវ ខូចខាត សរុប មាន ចំនួន ២០. ៤១២ ហិកតា ។ ចំពោះ ដំណាំ រួមផ្សំ មាន ផ្ទៃដី ប៉ះពាល់ សរុប ចំនួន ១០. ១០៧ ហិកតា ក្នុង នោះ ផ្ទៃដី ខូចខាត មាន ចំនួន ២. ៥១៤ហិកតា ។
លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ បាន សម្តែង ការ ចូលរួម រំលែក ទុក្ខ និង សោកស្តាយ ចំពោះ ការបាត់បង់ ខូចខាត ផល ដំណាំ សត្វ ពាហនៈ ជាមួយ បងប្អូន ប្រជាកសិករ ដែល ទទួលរងគ្រោះ នៅ ទូទាំង ខេត្ត និង ជាពិសេស បងប្អូន ក្នុង ស្រុក បាកាន ។ លោក នឹង ខិតខំ យក អស់ កំលាំង កាយ ចិត្ត ចូលរួម ស្តារ ផលិតកម្ម ស្បៀង ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត សំខាន់ ៗ ជូន បងប្អូន ប្រជាពលរដ្ឋ ឡើងវិញ ឲ្យ បាន ឆាប់ ក្រោយពេល ទឹក ស្រកចុះ ។
លោក អភិបាល ខេត្ត ក្នុង នាម ឲ្យ អាជ្ញាធរ មូលដ្ឋាន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ សម្តេច តេជោ សម្តេច កិត្តិព្រឹត្ត បណ្ឌិត និង លោក រដ្ឋមន្ត្រី វេង សាខុន ដែល បាន នាំយក ពូជ ស្រូវ ជា អំណោយ របស់ សម្តេច តេជោ តាមរយៈ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង គ្រឿង ឧបភោគ បរិភោគ មក ចែកជូន បងប្អូន ប្រជាពលរដ្ឋ ស្រុក បាកាន ផ្ទាល់ តែម្តង ។
ទទួលបាន បទបញ្ជា របស់ សម្តេច តេជោ លោក រដ្ឋមន្ត្រី និង លោក អភិបាល ខេត្ត បាន នាំយក អំណោយ របស់ សម្តេច តេជោ នូវ ពូជ ស្រូវ កូន ត្រី អណ្តែង និង គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ទៀត មក ចែកជូន បងប្អូន ប្រជាកសិករ ដើម្បី ជួយ សម្រាល នូវ បញ្ហា ជីវភាព និង ស្តារ ផលិតកម្ម ស្បៀង ឡើងវិញ ។ មិន តែ ប៉ុណ្ណោះ លោក រដ្ឋមន្ត្រី បាន នាំយក ក្រុម អន្តរាគមន៍ ភ្ជួរ រាស់ និង ម៉ាស៊ីន ព្រួស គ្រាប់ ស្រូវ មក ជួយ ស្តារ ដំណាំ ស្រូវ ជូន បងប្អូន កសិករ ឡើងវិញ ផងដែរ ។
ភ្ជាប់ ទៅនឹង ម៉ាស៊ីន ព្រោះ គ្រាប់ ស្រូវ លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ សម្តេច តេជោ ដែល បាន ជួយ ឧបត្ថម្ភ ម៉ាស៊ីន ព្រួស ស្រូវ ចំនួន ១៥០ គ្រឿង បន្ថែម ទៀត និង លើក មុន ចំនួន ១៣០ គ្រឿង សម្រាប់ យកមក ជួយ សហគមន៍ កសិកម្ម នៅ ខេត្ត គោលដៅ ទាំង៣ គឺ ខេត្ត បន្ទាយមានជ័យ បាត់ដំបង និង ខេត្ត ពោពិ៍ សាត់ ។
ផែនការ ចំពោះ មុខ ក្រោយពេល ទឹក ស្រក លោក រដ្ឋមន្ត្រី បាន លើកទឹកចិត្ត គាំទ្រ និង ជំរុញ ឲ្យ ប្រជាកសិករ ចាប់ផ្តើម ស្តារ ផល ដំណាំ ឡើងវិញ តាម គ្រប់ រូបភាព ជាពិសេស ដំណាំ ស្រូវ ទៅ តាម លទ្ធភាព ហើយ ក្រសួង នឹង រង់ចាំ ផ្តល់ អន្តរាគមន៍ គ្រប់ ពេលវេលា ជា គ្រាប់ ពូជ គ្រឿងចក្រ បច្ចេកទេស និង ធាតុ ចូល កសិកម្ម សំខាន់ ៗ មួយចំនួន ទៀត ។
លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សមាគម អ្នក ចិញ្ចឹម សត្វ កម្ពុជា ដែល បាន ជួយ ឧបត្ថម្ភ គ្រឿង ឧបភោគ បរិភោគ គិត ជា ទឹកប្រាក់ ចំនួន ២២ ៦២០ ដុល្លារ ។ កាយវិការ សប្បុរសធម៌ គឺជា សន្តាន ចិត្ត ជួយ ចែករំលែក សុខ ទុក្ខ និង ស្មារតី សាមគ្គីភាព ដ៏ ប្រពៃ និង សហការ ជួយ ឧបត្ថម្ភ គាំទ្រ គ្នា គ្រប់ កាលៈទេសៈ ក្នុង គ្រា លំបាក ។
ក្នុង ចំណោម ៣០៩ គ្រួសារ មាន ២៧១ គ្រួសារ ទទួលបាន ពូជ ស្រូវ ១០០ គីឡូក្រាម ក្នុង មួយ គ្រួសារ និង ៣៨ គ្រួសារ ទៀត ទទួលបាន ៥០ គីឡូក្រាម ក្នុង មួយ គ្រួសារ ( ទៅ តាម ទំហំ ដី ) ។ ក្រៅពី ពូជ ស្រូវ ទាំង ៣០៩ គ្រួសារ គ្រួសារ នីមួយ ៗ ទទួលបាន អង្គរ ២៥ គីឡូក្រាម សាច់ក្រក ១គីឡូក្រាម មី១កេះ ទឹកស៊ី អីវ ១យួរ និង ទឹកត្រី ១យួរ ។
ក្នុង ថ្ងៃ ដដែល នេះ លោក វេង សាខុន និង ក្រុមការងារ ក៏ បាន មក ជួប សំណេះសំណាល និង នាំយក កូន ត្រី អណ្តែង និង សម្ភារ ចិញ្ចឹម មួយចំនួន ទៀត ជូន កសិករ ចំនួន ៥៥ គ្រួសារ ដែល ពិធី នេះ បាន រៀបចំ នៅ បរិវេណ សាលា បឋមសិក្សារ បោះ រាំង ក្នុង ភូមិ របោះ រាំង ឃុំ អូរតាប៉ោង ស្រុក បាកាន ផងដែរ ។
លោក លី ចាន់ សុភក្តី នាំយក អំណោយ របស់ លោក ហ៊ុន ម៉ានី ចែកជូន ប្រជាការពារ ក្នុង សង្កាត់ សំរោង ក្រោម ខណ្ឌ ពោធិ៍សែនជ័យ
ថ្លែង ក្នុង ពី ធី សំណេះសំណាល និង ផ្តល់ អំណោយ ជូន ប្រជាការពារ ចំនួន ៥០ នាក់ នៅ សង្កាត់ សំរោង ក្រោម ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដោយ មាន ការចូលរួម ពី លោក ចៅសង្កាត់ លោក ប្រធាន ស .ស .យ . ក សង្កាត់ និង ស.ស .យ . ក ខណ្ឌ ពោធិ៍សែនជ័យ និង ចៅសង្កាត់ រង ជាច្រើន រូប នោះ ដែរ លោក លី ចាន់ សុភក្ដី ក៏ បាន ពាំនាំ ផ្ដាំផ្ញើរ ការសួរសុខទុក្ខ ពីសំណាក់ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង លោក សាយ សំអាល់ អនុប្រធាន សហភាព សហព័ន្ឋ យុវជន កម្ពុជា ។
ជា ទីបញ្ចប់ កម្មវិធី នេះ លោក ក៏ បាន ក្រើន រំលឹក ដល់ បងប្អូន កម្លាំង ប្រជាការពារ និង អាជ្ញាធរ មូលដ្ឋាន ជាពិសេស យុវជន ត្រូវ ខិតខំ ការពារ ខ្លួន អោយ ជៀស ឆ្ងាយ ផុត ពី ជំងឺ កូវីត១៩ ទាំងអស់ គ្នា ត្រូវ ផ្សព្វផ្សាយ និង ណែនាំ តាម សេចក្ដីជូនដំណឹង របស់ ក្រសួង សុខាភិបាល ៕ លោក ណុប រ័ត្ន និមល តំណាង កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង នាំ អំណោយ សម្ដេច តេជោ និង សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ចែកជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ស្រុក កណ្ដាល ស្ទឹង
លោក បាន អំពាវនាវ សូម បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម ការពារ ថែរក្សា សន្តិភាព បន្ត នូវ ការជឿជាក់ លើ ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង បន្ត ការគាំទ្រ បេក្ខភាព សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី គ្រប់ អណត្តិ ជា បន្តបន្ទាប់ ៕ កែវយឺត អវកាស Hubble ងាក រេ កាណុង ទៅ សិក្សា អាចម៍ផ្កាយ ធំ មួយ ដែល មាន តម្លៃ ខ្ពស់ ហួស ប្រមាណ
( បន្ទាយមានជ័យ )៖ ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ នៅ ថ្ងៃសុក្រ ទី៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បន្ត នាំយក អំណោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ជំនន់ ទឹកភ្លៀង ១៥០០ គ្រួសារ ស្ថិត នៅ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ។
ស្បៀងអាហារ ដែល នាំយក ទៅ ចែកជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដើម្បី រំលែក ការលំបាក ក្នុង ជីវភាព កំលុង នៃ ការលិចលង់ នេះ រួម មាន៖ អង្ករ មី ទឹក បរិសុទ្ធ ទឹកត្រី ទឹកស៊ី អ៉ីវ ត្រីខ កំប៉ុង មុង ភួយ ក្រម៉ា និង ថវិកា ប្រមាណ ៥ម៉ឺន រៀល ក្នុង មួយ គ្រួសារ ។
លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ក្នុង ឱកាស នោះ បាន នាំយក នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ នឹករលឹក និង រំលែក ការលំបាក ពីសំណាក់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ដល់ ជនរងគ្រោះ ទាំងអស់ ។ លោក ទេសរដ្ឋមន្ត្រី បាន លើកឡើង ថា សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត នឹករលឹក និង តាមដាន ជាប់ ជានិច្ច ចំពោះ ផល ប៉ះពាល់ និង ការរងគ្រោះ របស់ ប្រជាពលរដ្ឋ គ្រប់ ទីកន្លែង ក្នុង ហេតុការណ៍ ជំនន់ ទឹកភ្លៀង នេះ ។
លោក ទេសរដ្ឋមន្ត្រី បាន លើក បង្ហាញ ពី ការធ្វើអន្តរាគមន៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ចំពោះ ពលរដ្ឋ រងគ្រោះ ពីសំណាក់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ។
លោក បាន គូសបញ្ជាក់ ថា ក្នុង ពេល មាន គ្រោះ ទឹក ជំនន់ បង្ក ដោយ ទឹកភ្លៀង នេះ សម្តេច តេជោ ក្នុង នាម ជា អគ្គមេបញ្ជាការ កំពូល លើ សមរភូមិ គ្រោះ ទឹក ជំនន់ បាន ដាក់ចេញ បទបញ្ជា ដល់ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ អាជ្ញាធរ ពាក់ព័ន្ធ ទាំង ថ្នាក់ ជាតិ ថ្នាក់ ខេត្ត និង មូលដ្ឋាន ត្រូវ ចុះ ធ្វើ ប្រតិបត្តិការ បន្ទាន់ ក្នុង ការសង្គ្រោះ ប្រជាពលរដ្ឋ ដោយ ធានា ថា « មិន ត្រូវ ឱ្យ ពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ ការលិចលង់ ព្រោះ មិន បាន ជួយ ឬ មិន បាន ដឹង នោះ ឡើយ » ។
លោក ទេសរដ្ឋមន្ត្រី បញ្ជាក់ បន្ថែម ថា ក្រៅតែ ពី ការជួយសង្គ្រោះ ចេញ ពី ការជន់ លិច ហើយ នោះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ចាត់ វិធានការឆ្លើយតប បន្ទាន់ ដោះស្រាយ ការខ្វះ អាហារ ហូបចុក និង ខ្វះ ទឹក សុទ្ធ ផឹក ជាដើម ។ មិន ត្រឹមតែ ចុះ ចែក អំណោយ ដោយ ផ្ទាល់ នៅ រាជធានី ភ្នំពេញ និង នៅ ខេត្ត បន្ទាយមានជ័យ នោះ ទេ សម្តេច តេជោ បាន ចាត់ចែង បញ្ចេញ ស្បៀង ទឹក សុទ្ធ ពី ឃ្លាំង បូករួម ជាមួយ អំណោយ របស់ សប្បុរសជន ចែកជូន ប្រជាពលរដ្ឋ ភ្លាម ៗ ដោយ មិន ឱ្យ ពលរដ្ឋ ណា ម្នាក់ អត់ អាហារ ហូបចុក នោះ ឡើយ ។
លោក ទេសរដ្ឋមន្ត្រី បាន គូស រំលេច ទៅកាន់ ពលរដ្ឋ រងគ្រោះថា នេះ គឺជា វិធានការ ដោះស្រាយ បញ្ហា ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ជា អ្នកទទួលខុសត្រូវ ខ្ពស់ លើ ជោគវាសនា ជាតិ និង ប្រជាជន ។ ជាពិសេស ជា ទម្លាប់ របស់ សម្តេច តេជោ រាល់ ពេល ប្រទេសជាតិ និង ប្រជាជន ជួប ទុក្ខ គឺ សម្តេច តែងតែ បង្ហាញ មុខ និង វត្តមាន ដើម្បី ដោះស្រាយ បញ្ហា មិន ទម្លាប់ រត់ ចោល បញ្ហា នោះ ឡើយ ។
អនុប្រធាន ទី១ នៃ គណៈកម្មាធិការ ជាតិ គ្រង់ គ្រង គ្រោះមហន្តរាយ ដែល ជា សេនាធិការ របស់ សម្តេច តេជោ ហ៊ុន សែន លើ ការងារ គ្រោះមហន្តរាយ នេះ បាន លើកឡើង ថា នៅ ពេល នេះ ទឹក បាន ចាប់ផ្តើម ស្រក ទៅ វិញ ហើយ អ្វី ដែល ត្រូវ បន្ត យកចិត្តទុកដាក់ នោះ គឺ ការស្តារ ជីវភាព ឡើងវិញ តាមរយៈ ការដាំដុះ បង្កបង្កើន ផល ឡើងវិញ ទាំង ស្រូវ និង ដំណាំ រួមផ្សំ ផ្សេង ៗ ។
បន្ថែម ពីលើ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ដាក់ បទបញ្ជា ដល់ រដ្ឋមន្ត្រី ចំនួន ៤ រួម មាន៖ រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន . រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម . រដ្ឋមន្ត្រី អភិវឌ្ឍន៍ ជនបទ និង រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ចុះ ធ្វើ ការព្រម ៗ គ្នា ដើម្បី ស្តារ ឡើងវិញ ផ្លូវ ជាតិ ផ្លូវ លំ ទំនប់ ទឹក ប្រឡាយ ទឹក ដែល រង ការខូចខាត រក វិធី ទប់ទឹក ទុក ប្រើប្រាស់ ជាដើម ខណៈ ក្រសួង កសិកម្ម ត្រូវ ចុះ ចែក ពូជ ស្រូវ និង ដំណាំ ដល់ ពលរដ្ឋ រងគ្រោះ ។
ទន្ទឹមនឹង ការរំលឹក នូវ ចំណាត់ការ វិធានការ របស់ សម្តេច តេជោ ហើយ នោះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ក៏ បាន ក្រើន រំលឹក ដល់ អាជ្ញាធរ នៅ តាម ខេត្ត និង មូលដ្ឋាន ដែល រង ការជន់ លិច ត្រូវ ជួយ ធ្វើអន្តរាគមន៍ និង សម្របសម្រួល ផងដែរ ដើម្បី ជួយ ឱ្យ ការងារ បង្កបង្កើន ផល ឡើងវិញ របស់ ប្រជាពលរដ្ឋ ទទួលបាន ប្រសិទ្ធិភាព ខ្ពស់ ។
មន្ត្រី តុលាការ កំពូល ដដែល បាន បញ្ជាក់ ថា ចំពោះ សំណុំរឿង ហិង្សា បាញ់ បោះ សេរី នៅក្នុង គេហដ្ឋាន ក្នុង សង្កាត់ ព្រៃ សរ ទណ្ឌិត ហូ ចំរើន បាន អនុវត្តន៍ ទោស ចំនួន ១៨ ខែ បាន រួចរាល់ ហើយ ។ ប៉ុន្តែ ចំពោះ សំណុំរឿង ឆបោក ប្រាក់ ក្រុមហ៊ុន បរទេស រាប់ លាន ដុល្លារ គឺ តុលាការ កំពុង បន្ត នីតិវីធី ។
ពោលគឺ ជន ត្រូវ ចោទ ឈ្មោះ ហូ ចំរើន បាន សុំ នៅ ក្រៅ ឃុំ ប៉ុន្តែ តុលាការ ក្រុង ភ្នំេពញ និង សាលាឧទ្ធរណ៍ បាន បដិសេធ ចំពោះ សំណើរ នេះ ។ លុះ ដល់ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០២០ ទើប តុលាការ កំពូល សម្រេច ដោះលែង ឧកញ៉ា ហូ ចំរើន តែម្តង ។
អតីត ឧកញ៉ា ហូ ចំរើន ធ្លាប់ ត្រូវបាន តុលាការ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ រយៈពេល ១៨ ខែ ក្នុង សំណុំរឿង គំរាម បាញ់ សម្លាប់ ប្រពន្ធ នៅក្នុង ភូមិ គ្រឹះ របស់ ខ្លួន ស្ថិត ក្នុង ខណ្ឌ ដង្កោ កាលពី ខែមេសា ឆ្នាំ ២០១៨ ។
សូម ជំរាប ថា ដើម បណ្តឹង ជា អ្នក វិនិយោគ ជនជាតិ ចិន ចំនួន ២នាក់ និង ជនជាតិ កូរ៉េ ម្នាក់ បាន ដាក់ ពាក្យ បណ្តឹង ដាច់ដោយឡែក ៗ ពី គ្នា ទៅ តុលាការ ដែល មាន កម្មវត្ថុ ប្តឹង អតីត ឧកញ៉ា ហូ ចំរើន ពី បទ ស៊ី ដាច់ លុយ ជាង ២០០ លាន ដុល្លារ អាមេរិក តាម រូបភាព អភិវឌ្ឍន៍ មន្ទីរពេទ្យ ទំនើប នៅ ទីក្រុង តាខ្មៅ និង គម្រោង អភិវឌ្ឍន៍ មួយចំនួន ទៀត ។
លោក អភិបាល ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង មន្ទីរ ជំនាញ ព្រមទាំង ប្រជាពលរដ្ឋ ក្នុង តំបន់ មាន សេចក្តី សោម ន្សរីករាយ ជាខ្លាំង និង បាន ថ្លែងអំណរគុណ លោក រដ្ឋមន្រ្តី ថ្នាក់ដឹកនាំ ក្រសួង មន្រ្តី គ្រប់ ជាន់ ថ្នាក់ ដែល បាន ខិតខំ បំពេញ ការងារ អន្តរាគមន៍ ជួយ បន្ថយ ផល ប៉ះពាល់ និង សម្រួល ការលំបាក របស់ ពួកគាត់ លើ វិស័យ ធនធាន ទឹក ៕
នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត ចាន់ អ៊ាន នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ទីទ័ល ក្រ ចំនួន ១៦៦ គ្រួសារ នៅ ឃុំ ព្រៃ ព្នៅ ស្រុក ពារាំង ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត ចាន់ អ៊ាន រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ពារាំង និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ ព្រៃ ព្នៅ ស្រុក ពារាំង ខេត្ត ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន នាំយក អំណោយ ទៅ ចែក ជូន ប្រជាពលរដ្ឋ ទីទ័ល ក្រ ចំនួន ១៦៦ គ្រួសារ មកពី បណ្តាល ភូមិ នានា ក្នុង ឃុំ ព្រៃ ព្នៅ ។
ពិធី ចែក អំណោយ សម្រាល ដល់ ជីវភាព ប្រជាពលរដ្ឋ ទីទ័ល ក្រ នេះ ត្រូវបាន ធ្វើឡើង នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ឃុំ ព្រៃ ព្នៅ ស្រុក ពារាំង ខេត្ត ព្រៃវែង ។
ថ្លែង សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត ចាន់ អ៊ាន បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត ព្រៃវែង ដែល ជានិច្ចកាល សម្តេច តែងតែ គិតគូរ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ និង ចាត់ ឲ្យ ក្រុមការងារ ចុះ ជួយ សម្រាល ទុក្ខលំបាក ជូន ប្រជាពលរដ្ឋ ជាប់ ជានិច្ច និង ទាន់ ពេល វេលា ។
លោក រដ្ឋលេខាធិការ បន្ត ថា ទោះបី អំណោយ ដែល ចែកជូន នៅ ថ្ងៃ នេះ តិចតួច ក្តី ប៉ុន្តែ អាច ជួយ សម្រាល នូវ ទុក្ខលំបាក របស់ បងប្អូន ប្រជាពលរដ្ឋ បាន មួយ រយៈ ដោយ សង្ឃឹម ថា បងប្អូន នឹង ជម្នះ បាន នូវ ការលំបាក នានា ប្រឹងប្រែង បង្កបង្កើន ផល ចិញ្ចឹម សត្វ ជាដើម ដើ ម្បីឲ្យ ជីវភាពល្អ ប្រសើរ នៅពេល ខាងមុខ ។
រយៈពេល ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ មាន ការជជែក និង សរសេរ បកស្រាយ តទៅ ត មក រវាង អតីត អ្នកការទូត ដែល ចូលនិវត្តន៍ និង អ្នកការទូត ដែល កំពុង បំពេញ តួនាទី បច្ចុប្បន្ន របស់ កម្ពុជា និង អតីត អ្នកការទូត មួយ រូប របស់ សិង្ហបុរី ដែល បាន ធ្វើ អត្ថាធិប្បាយ ចង់ឲ្យ អាស៊ាន បណ្តេញ កម្ពុជា និង ឡាវ ចេញ ពី អាស៊ាន ដោយ ភ្ជាប់ ប្រទេស ២នេះ ទៅនឹង ចិន ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន អំពាវនាវ ដល់ អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ឱ្យ បាន ល្អ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ និង ទេសចរ បរទេស មាន ឱកាស បាន សប្បាយរីករាយ ក្នុង ក្នុង ថ្ងៃ ឈប់សម្រាក ក្នុង ពិធី បុណ្យ អុំ ទូក នេះ ។
សម្តេច បាន បន្ត ថា៖ សូម អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ឱ្យ បាន ល្អ ដើម្បី អោយ ប្រជាពលរដ្ឋ និង ទេសចរ បរទេស មាន ឱកាស បាន សប្បាយរីករាយ ក្នុង ក្នុង ថ្ងៃ ឈប់សម្រាក ក្នុង ពិធី បុណ្យ នេះ នៅ ទូទាំង ប្រទេស ។
សូម បញ្ជាក់ ថា នៅ អំឡុង រាជ រដ្ឋាភិបាល អនុញ្ញាតឱ្យ មន្រ្តី រាជការ កម្មករ និយោជិត ឈប់ សម្រាក រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ៣០ ខែតុលា ដល់ ថ្ងៃទី ០២ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។ ទោះជា យ៉ាង នេះ ក្តី ពិធី បុណ្យ អុំ ទូក ឆ្នាំ នេះ មិន ត្រូវបាន ប្រារព្ធ នោះ ឡើយ ដោយសារតែ កម្ពុជា ប្រឈម នឹង ការរីករាលដាល ជំងឺ កូវីដ១៩ និង ជួបប្រទះ នឹង ស្ថានភាព ទឹក ជំនន់ ៕ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ចុះ ពិនិត្យ វាយតម្លៃ ផ្លូវ ជន បទ ១១ខ្សែ ដែល ខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង នៅ ស្រុក បន្ទាយមាស ដើម្បី ស្តា និង ជួសជុល ឡើងវិញ
( កំពត ) ៖ លោក ហ៊ូត សារឹម អនុ រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ នៅ រសៀល ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០២០ បាន ដឹកនាំ គណៈប្រតិភូ ក្រសួង មន្ត្រី និង អាជ្ញាធរ ពាក់ព័ន្ធ ចុះ ពិនិត្យ និង វាយតម្លៃ ផ្លូវ ជន បទ ១១ខ្សែ នៅ ស្រុក បន្ទាយមាស ដើម្បី ស្តា និង ជួសជុល ឡើងវិញ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
លោក បន្ត ថា ផ្លូវ ទាំង ១១ខ្សែ នេះ ខូចខាត មាន ប្រវែង ជាង ៧៦ គីឡូម៉ែត្រ តែ ប៉ុណ្ណោះ ហើយ ក្រុមការងារ នឹង ធ្វើ ការស្នើសុំ ទៅ ក្រសួង ជំនាញ និង ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បី ជួយ ពន្លឿន ការស្តា និង ជួល ជុល ផ្លូវ ជនបទ ទាំងនេះ ក្នុង ពេល ឆាប់ ៗ ជូន ពលរដ្ឋ ធ្វើដំណើរ ស្រួល ដូច ដើម វិញ ។
គួរ រំលឹក ថា ជំនន់ ទឹកភ្លៀង នៅ ស្រុក បន្ទាយមាស កន្លងទៅ ថ្មី ៗ នេះ បាន បណ្តាលឲ្យ លិច ដី ស្រែ និង ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ១០០៣០ គ្រួសារ គិត មកដល់ ថ្ងៃ នេះ ស្ថានភាព បាន ត្រឡប់មក ធម្មតា វិញ ហើយ ។ ដោយឡែក ផ្លូវ ជន បទ ចំនួន ១១ខ្សែ ខូចខាត អស់ ប្រវែង ជាង ៧៦ គីឡូម៉ែត្រ បើ តាម មន្ត្រី ជំនាញ ថា មូលហេតុ ភាគ ច្រើន ដោយសារ គ្មាន ប្រព័ន្ធ ដោះ ទឹក ពលរដ្ឋ ចាក់ ដី ទី ផ្ទះ ខ្ពស់ ធ្វើឲ្យ ផ្លូវ ក្លាយជា ប្រឡាយ ជាដើម ។
ចំពោះ ខេត្ត កំពត នៅ ឆ្នាំ ២០២០ នេះ មិន បាន ទទួលរង ផល ប៉ះពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង ដូច ឆ្នាំ មុន ៗ ទេ ។ ដោយឡែក នៅក្នុង ស្រុក បន្ទាយមាស គឺ មាន ការលិចលង់ ដោយ ជំនន់ ទឹកភ្លៀង តែ បន្តិចបន្តួច នៅក្នុង ឃុំ មួយចំនួន ហើយ ថ្នាក់ដឹកនាំ ពាក់ព័ន្ធ កាកបាទ ក្រហម ក៏ បាន យក អំណោយ មនុស្សធម៌ ទៅ ចែកជូន ពលរដ្ឋ ទាន់ ពេលវេលា ផងដែរ ៕ សកម្មភាព របស់ កម្លាំង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ក្នុង ការចុះ ជួយ ប្រជាពលរដ្ឋ (Photo inside)
( ភ្នំពេញ ) ៖ អរគុណ សន្តិភាព ! អរគុណ នយោបាយ ឈ្នះ ឈ្នះ ! ដឹង គុណ ស្ថាបនិក មគ្គុទ្ទេសក៍ ឯក និង ប្រតិបត្តិករ នយោបាយ ឈ្នះ ឈ្នះ ដែល បាន នាំមក នូវ សន្តិភាព និង ការឯកភាព ជាតិ ពេញលេញ ។
