( កំពង់ស្ពឺ ) ៖ នៅក្នុង ពិធី ប្រកាស ជា ផ្លូវការ កិច្ចសហប្រតិបត្តិការ រៀប រៀង និង បោះពុម្ព សៀវភៅ មគ្គុទេសក៍ វិនិយោគ សម្រាប់ ខេត្ត កំពង់ស្ពឺ ដែល បាន ធ្វើ នៅ អគារ ប្រជុំ របស់ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត កំពង់ស្ពឺ នា ព្រឹក ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ថ្លែង ថា បច្ចុប្បន្ន នេះ ចំពោះ សក្តានុពល ខេត្ត កំពង់ស្ពឺ ទាំង កត្តា ភូមិសាស្ត្រ និង ប្រជាសាស្ត្រ បាន ទាក់ទាញ អ្នក វិនិយោគទុន មក បណ្ដាក់ទុន វិនិយោគ កាន់តែ ច្រើន ឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។
លោក វ៉ី សំណាង បាន បន្ថែម ថា សក្តានុពល នេះ គឺ ដោយ ចង់ បង្ហាញ ពី បុគ្គលិក លក្ខណៈ របស់ ប្រជាជន ខេត្ត កំពង់ស្ពឺ ដោយ មាន ចរិត ស្លូតបូត និង ខិតខំ អំណត់ តស៊ូ ធ្វើ ការងារ ព្រមទាំង មាន ភាពស្មោះត្រង់ ហើយ កត្តា ភូមិសាស្ត្រ ខេត្ត កំពង់ស្ពឺ ជា ខេត្ត មួយ មាន ផ្លូវ ជាតិ ឆ្លងកាត់ ជាច្រើន ពិសេស ផ្លូវ ជាតិ លេខ៤ ឆ្លងកាត់ ដែល បង្ក លក្ខណៈ ងាយស្រួល នាំ ផលិតផល ចេញ និង នាំចូល ។
លោក អភិបាល បញ្ជាក់ ដែរ ថា ខេត្ត កំពង់ស្ពឺ នេះ ស្ថិត ជិត បំផុត ច្រក កំពង់ផែ អន្តរជាតិ កំពង់សោម ហើយក៏ ជា ខេត្ត មួយ បង្ក លក្ខណៈ ងាយស្រួល សម្រាប់ អ្នក វិនិយោគទុន មក បណ្ដាក់ទុន ព្រមទាំង ទទួលបាន ផលចំណេញ ខ្ពស់ ផងដែរ ។
ការដាក់ទណ្ឌកម្ម បន្ថែម នេះ នឹង នាំឱ្យ ក្រុមហ៊ុន ចិន ចំនួន ៣៥ រង ផល ប៉ះពាល់ ។ ការបង្កើត បញ្ជី ឈ្មោះ នៃ ក្រុមហ៊ុន ចិន ដែល ជាប់ទាក់ទង ជាមួយ យោធា ចិន នេះ ត្រូវបាន កំណត់ ចេញ ដោយ ច្បាប់ អាមេរិក កាលពី ឆ្នាំ ១៩៩៩ ដែល តម្រូវ ឱ្យ មន្ទីរ បញ្ចកោណ នៃ ក្រសួង ការពារ ជាតិ អាមេរិក ចង ក្រង ជាបញ្ជី រាយ នាម ក្រុមហ៊ុន ដែល គ្រប់គ្រង ដោយ កងទ័ព រំដោះ ប្រជាជន ចិន ប៉ុន្តែ ក្រសួង ការពារ ជាតិ អាមេរិក ទើបតែ បាន អនុវត្ត តាម នៅ ឆ្នាំ នេះ តែ ប៉ុណ្ណោះ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៧០ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ២០ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៧០ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២១ ខែវិច្ឆិកា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៧០ នាក់ នោះ មាន ១៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៣ករណី និង ជនសង្ស័យ ៥២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ២២ករណី ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ទៀត ថា ចំណែក លោក សរ ចិត្រា អាយុ ៤៧ ឆ្នាំ ដែល ជា អ្នក ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ ០៣ វិច្ឆិកា បាន ព្យាបាល ជាសះស្បើយ ដោយ ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន កូវីដ១៩ ចំនួន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
មិន ត្រូវ បើកបរ ក្រោម ឥទ្ធិពល គ្រឿងស្រវឹង ជាដាច់ខាត ! ស្លាប់ ៦នាក់ និង របួស ២១ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ២១ នាក់ ។
( កណ្ដាល ) ៖ ស្នងការ ខេត្ត កណ្ដាល លោក ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា នេះ បាន សំណេះសំណាល សួរសុខទុក្ខ កងកម្លាំង ក្រោម ឱវាទ ក្នុង ខេត្ត និង ចែក អំណោយ របស់ អគ្គ ស្នងការ នគរបាល ជាតិ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន មក ចែកជូន នគរបាល ចំនួន ៥០០ នាក់ ។
ក្នុង ឱកាស នោះ លោក ស្នងការបាន ផ្ដាំផ្ញើ នគរបាល ត្រូវ ការពារ សន្តិសុខ សង្គម បម្រើ ពលរដ្ឋ ឲ្យបាន ល្អ ចូលរួម អនុវត្តន៍ វិធានការ កូវីដ - ១៩ និង ផ្សព្វផ្សាយ តាម មូលដ្ឋាន របស់ ខ្លួន ជាប្រចាំ ដើម្បី រួមគ្នា ទប់ស្កាត់ ការឆ្លង ជំងឺ នេះ ដល់ សហគមន៍ ។
លោក ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត ក៏ បាន ពាំនាំ ការសាកសួរ សុខទុក្ខ ពី នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន ដែល លោក តែងតែ គិតគូរ យកចិត្តទុកដាក់ មក លើ កងកម្លាំង ទាំងអស់ ព្រមទាំង បារម្ភ ចំពោះ សុខភាព របស់ កូន ចៅ ផងដែរ ដែល នេះ ជា កាយវិការ យកចិត្តទុកដាក់ យ៉ាង ត្រជាក់ របស់ ថ្នាក់ លើ មក ចំពោះ ថ្នាក់ ក្រោម ។
លោក ស្នងការបន្ត ថា « កងកម្លាំង ទាំងអស់ ជា ទីពឹង សំរាប់ ពលរដ្ឋ ដូច្នេះ ត្រូវ ធ្វើ ខ្លួន ឲ្យ ថ្លៃថ្នូរ សាមគ្គី គ្នា ល្អ ក្នុង ក្រុម ចុះ ដៃ ធ្វើ ការរួមគ្នា ល្អ ដើម្បី បម្រើ សង្គមជាតិ បម្រើ ពលរដ្ឋ យើង ឲ្យបាន ល្អ ជា ទីបំផុត ។ ពិសេស ត្រូវ អនុវត្តន៍ តាម គោល នយោបាយ ៩ចំណុច របស់ រា ជេដ្ឋាភិបាល កម្ពុជា ឲ្យ មាន ប្រសិទ្ធភាព បំផុត » ។
គួរ ជម្រាប ជូន ថា កងកម្លាំង ទាំងអស់ នៅ ខេត្ត កណ្ដាល ទទួលបាន មី ចំនួន ៣កេស ថវិកា មួយ ចំនួន ។ ពួកគាត់ បាន ថ្លែងអំណរគុណ ដល់ អគ្គ ស្នងការ នគរបាល ជាតិ ព្រមទាំង លោក ស្នងការ ដែល បាន យកចិត្តទុកដាក់ ដល់ កងកម្លាំង ជា កូន ចៅ យ៉ាង កក់ក្ដៅ ជា ទីបំផុត ៕
ព័ត៌មាន លម្អិត សូម ទស្សនា ការ លើកឡើង របស់ លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ របស់ ក្រសួង សុខាភិបាល ដូចត ទៅ៖
ជុំវិញ បញ្ហា នេះ ក្រសួង ការប្រទេស កូរ៉េ ខាងត្បូង បាន ថ្លែង ឲ្យដឹង នៅក្នុង សេចក្តីថ្លែងការណ៍ របស់ ខ្លួន យ៉ាង ដូច្នេះ ថា លោក រដ្ឋមន្ត្រី ការបរទេស កូរ៉ូ ខាងត្បូង លោក Kang នឹង ផ្លាស់ប្តូរ ទស្សនៈ ស៊ីជម្រៅ ជាមួយ សមភាគី ចិន លោក វ៉ាង ស្តីពី ទំនាក់ទំនង ទ្វេ ភាគី ក៏ ដូចជា ការផ្លាស់ប្តូរ កម្រិត ខ្ពស់ សម្រាប់ ការឆ្លើយតប នឹង ជំងឺ COVID-19 និង បញ្ហា ដែល គួរឲ្យ ព្រួយបារម្ភ ផ្សេង ទៀត រួមទាំង ឧបទ្វីប កូរ៉េ ផងដែរ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។
ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ស្រុក មុខ កំពូល និង ឧកញ៉ា លី ហួរ ចែក ម៉ាស កម្មករ ជាង ១០០០ នាក់ នៅ បុរី វិមាន ភ្នំពេញ « មង្គល រតនៈ » និង ពលរដ្ឋ ឃុំ ព្រែក អញ្ចាញ
ក្នុង ឱកាស នោះ លោក នូវ សុខសម្បត្តិ បាន លើកឡើង ថា ម៉ាស ដែល ចែកជូន កម្មករ ចំនួន ២០ម៉ឺន ម៉ាស នៃ កញ្ចប់ ២លាន ម៉ាស របស់ រាជ រដ្ឋាភិបាល នា ពេលនេះ គឺជា អំណោយ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដើម្បី ចូលរួម បង្ការ និង ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ១៩ ។
លោក នូវ សុខសម្បត្តិ បាន បញ្ជាក់ បន្ថែម អំពី ការគិតគូរ យកចិត្តទុកដាក់ ជានិច្ចជា កាល នូវ សុខ ទុក្ខ ពីសំណាក់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ជាពិសេស បងប្អូន កម្មករ កម្មការិនី និង បងប្អូន ដែល រស់ នៅក្នុង សហគមន៍ ក្រីក្រ ។
លោក ចូ បៃ ដិន ឈានចូល វ័យ « ៧៨ ឆ្នាំ » នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា នេះ ហើយ លោក នឹង ក្លាយជា ប្រធានាធិបតី អាមេរិក មាន វ័យ ចំណាស់ បំផុត ក្នុង ប្រវត្តិសាស្ត្រ
( វ៉ាស៊ីនតោន ) ៖ នៅ ថ្ងៃសុក្រ ទី ២0 ខែវិច្ឆិកា ឆ្នាំ ២០២០ គឺជា ថ្ងៃ ខួបកំណើត គំរប់ អាយុ ៧៨ ឆ្នាំ របស់ ប្រធានាធិបតី ជាប់ ឆ្នោត អាមេរិក លោក ចូ បៃ ដិន ។ បាំង តែ ចំនួន ២ខែ ទៀត ប៉ុណ្ណោះ លោក ចូ បៃ ដិន នឹង ត្រូវ ស្បថ ចូលកាន់ តំណែង ប្រធានាធិបតី អាមេរិក អាណត្តិ ថ្មី និង ជា ប្រធានាធិបតី ដែល មាន វ័យ ចំណាស់ បំផុត នៅក្នុង ប្រវត្តិសាស្ត្រ អាមេរិក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA ។
លោក ចូ បៃ ដិន ត្រូវបាន គេ រំពឹង ថា នឹង ត្រូវ មាន បន្ទុក ធ្ងន់ធ្ងរ ជា ច្រើន រង់ចាំ លោក ដោះស្រាយ ដូចជា ជំងឺ រាតត្បាត សកល COVID-19 . កំណើន នៃ ការបាត់បង់ ការងារ ធ្វើ និង ការកសាង យុត្តិធម៌ សង្គម ឡើងវិញ ជាពិសេស គឺ បញ្ហា រើសអើង ជនជាតិ ស្បែក ខ្មៅ ហើយ កាតព្វកិច្ច នេះ គឺ នឹង តម្រូវឲ្យ លោក ចំណាយ កម្លាំង កាយ និង ចិត្ត មិន ស្ទើរ នោះ ឡើយ នៅក្នុង អាណត្តិ ប្រធានាធិបតី ដែល នឹង ត្រូវ ស្បថ ចូលកាន់ តំណែង ជា ផ្លូវការ នៅ ថ្ងៃទី ២០ ខែមករា ឆ្នាំ ២០២១ ខាងមុខ នេះ ។
( បាត់ដំបង ) ៖ បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ បាន បើក ការដ្ឋាន ជួសជុល ស្តារ ឡើងវិញ ផ្លូវ ក្រាល ក្រួស ក្រហម ចំនួន មួយ ខ្សែ ប្រវែង ១៤.១០គីឡូម៉ែត្រ តភ្ជាប់ ពី ឃុំ ក កោះ ទៅ ឃុំ របស់ មង្គល ស្រុក មោង ឬ ស្សី ខេត្ត បាត់ដំបង ។ ផ្លូវ នេះ ឆ្លងកាត់ ឃុំ ចំនួន ៣ គឺ ឃុំក កោះ ឃុំ របសើ មង្គល និង ឃុំ មោង ដែល ជា ផ្លូវ ច្រកទ្វារ សេដ្ឋកិច្ច ដ៏ សំខាន់ របស់ ប្រជាកសិករ សម្រាប់ ដឹកជញ្ជូន កសិផល ។
បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន បាន បញ្ជាក់ ក្នុង ឱកាស បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ នេះ ថា ផ្លូវ ប្រវែង ១៤.១០គីឡូម៉ែត នេះ ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន ដាក់បញ្ចូល ទៅក្នុង គម្រោង កិច្ចសហប្រតិបត្តិការ គឺ « គម្រោង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ ជនបទ សម្រាប់ ព្រះរាជាណាចក្រ កម្ពុជា (RID4CAM)» ដែល គ្រោង នឹង ក្រាល កៅ សូពីរ ជាន់ ប្រភេទ DBST ជា គម្រោង សហប្រតិបត្តិការ ពី ធនាគារ អភិវឌ្ឍន៍ អាល្លឺម៉ង KfW ទីភ្នាក់ងារ បារាំង សំរាប់ ការអភិវឌ្ឍ (AFD) និង សហភាព អឺរ៉ុប (EU) ៕
សមាគម ពាណិជ្ជករ ដឹកជញ្ជូន ទំនិញ កម្ពុជា និង សភា ពាណិជ្ជកម្ម និង ឧស្សាហកម្ម អាមេរិកាំង - អឺរ៉ុប របស់ ប្រទេស ចិន ចាប់ ដៃ គ្នា ជំរុញ ឲ្យ មាន ទំនាក់ទំនង ការវិនិយោគ ពាណិជ្ជកម្ម អន្តរជាតិ និង វិស័យ ដឹកជញ្ជូន ទំនិញ
( ភ្នំពេញ ) ៖ សមាគម ពាណិជ្ជករ ដឹកជញ្ជូន ទំនិញ ប្រទេស កម្ពុជា និង សភា ពាណិជ្ជកម្ម និង ឧស្សាហកម្ម អាមេរិកាំង - អឺរ៉ុប របស់ ប្រទេស ចិន នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ចុះ អនុស្សារណៈ នៃ ការយោគយល់ គ្នា (MoU) ដើម្បី ជំរុញ ឲ្យ មាន ទំនាក់ទំនង ការវិនិយោគ ពាណិជ្ជកម្ម អន្តរជាតិ និង វិស័យ ដឹកជញ្ជូន ទំនិញ រវាង ប្រទេស ទាំង ពីរ កម្ពុជា - ចិន ។ ពិធី ចុះ MoU បាន រៀបចំឡើង តាមរយៈ ប្រព័ន្ធ វីដេអូ អនឡាញ ។
លោក ជា ចាន់ ដារា ប្រធាន សមាគម ពាណិជ្ជករ ដឹកជញ្ជូន ទំនិញ បាន លើកឡើង ថា គោលដៅ សំខាន់ នៃ MoU គឺ ចង់ឲ្យ មាន ការធ្វើ ទំនាក់ទំនង កាន់តែ ជ្រៅ រវាង អ្នក វិនិយោគ ចិន និង កម្ពុជា ។ គេ អាច និយាយ បាន ថា អ្វី ដែល ភាគី សភា ពាណិជ្ជកម្ម និង ឧស្សាហកម្ម អាមេរិកាំង - អឺរ៉ុប ប្រទេស ចិន ចង់បាន នោះ គឺ ចង់ឲ្យ មាន ការណែនាំ ពី ការនាំ ទំនិញ ចូល ពី ប្រទេស ចិន មក ប្រទេស កម្ពុជា ហើយ សមាគម ពាណិជ្ជករ ដឹកជញ្ជូន ទំនិញ កម្ពុជា ក៏ ចង់ឲ្យ មាន ការណែនាំ ពី ការនាំ ទំនិញ ពី កម្ពុជា ចូលទៅ ចិន វិញ ពិសេស ទៅ លើ វិស័យ កសិកម្ម ។
បើ តាម លោក ជា ចាន់ ដារ៉ា តាំងពី កូវីដ១៩ ចូលមក វិស័យ ដឹកជញ្ជូន ទំនិញ មាន ការធ្លាក់ចុះ ។ បញ្ហា ធ្លាក់ចុះ ដោយសារ ពេល ទំនិញ ត្រូវ បញ្ជូន ចេញ ប្រទេស ក្រៅ មួយចំនួន អត់ ទទួល ទេ ។ បញ្ហា មួយ ទៀត អ្នក ដែល បាន បញ្ជារ ទិញ ហើយ ខ្វះ គ្រឿង បន្ទាប់បន្សំ ។ ទោះជា យ៉ាងណា ចាប់តាំងពី ស្ថានភាព កូវីដ១៩ នៅ កម្ពុជា បាន ថយចុះ ការដឹកជញ្ជូន ទំនិញ ក៏ ចាប់ផ្តើម កើន ឡើងវិញ ផងដែរ ។
ក្នុង នាម ជា អ្នក យល់ដឹង ខាង ផ្នែក ដឹកជញ្ជូន លោក ជា ចាន់ ដារ៉ា បាន ណែនាំ ថា អ្នក ដែល ចង់ បញ្ជារ ទិញ ទំនិញ ពី ប្រទេស ក្រៅ សូម ព្យាយាម ទាក់ទង ឲ្យបាន ច្បាស់លាស់ រវាង អ្នកទិញ ហើយ និង អ្នកលក់ ពីព្រោះ លោក មើលឃើញ ថា បន្ទាប់ពី មាន កូវីដ១៩ ការហោះ ទៅក្នុង ប្រទេស ដទៃ ក្នុង ការទៅ មើល ទំនិញ ផ្ទាល់ មិន មាន ទេ ។ ប្រការ នេះ ហើយ ធ្វើឲ្យ ការទិញ លក់ អាច ប៉ះពាល់ ឬ មាន ការបោកប្រាស់ ហើយ ករណី ជាក់ស្តែង ក៏ ធ្លាប់ កើតមាន ផងដែរ ៕
រដ្ឋបាល រាជធានី ភ្នំពេញ អញ្ជើញ ម្ចាស់ អាជីវកម្ម ៨ ទីតាំង មក ពិភាក្សា ស្តីពី ការទូទាត់ បំណុល ថ្លៃ សេវា ប្រមូល សំរាម
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ម្ចាស់ អាជីវកម្ម ចំនួន ៨ទីតាំង មក ប្រជុំ ពិភាក្សា ស្តីពី ការទូទាត់ បំណុល ថ្លៃ សេវា ប្រមូល សំរាម ទោះបី រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ជូន ដំណឹង ជាច្រើន លើក ច្រើន សារ ហើយក៏ ដោយ ។
ក្រោយពី ពិភាក្សា គ្នា យ៉ាង ល្អិតល្អន់ រួច មក ដែល ធ្វើឡើង ក្រោម វត្តមាន លោក ហួត ហៃ អភិបាល រង រាជធានី ភ្នំពេញ តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ម្ចាស់ អាជីវកម្ម ទាំង ៨ ទីតាំង បាន ឯកភាព ទូទាត់ បំណុល ទាំងអស់ និង យល់ព្រម បង់ ថ្លៃ សេវា ប្រមូល សម្រាប់ ខែ បន្តបន្ទាប់ ទៀត ( បញ្ហា គឺ ការ មិន ទាន់ យល់ គ្នា ប៉ុណ្ណោះ ) ។
រដ្ឋបាល រាជធានី ភ្នំពេញ សូម រំឮក ដល់ ម្ចាស់ អាជីវកម្ម ទាំងអស់ សូម ធ្វើ ការទូទាត់ ថ្លៃ ប្រមូល សំរាម និង សំណល់ រឹង ឱ្យ បាន ទៀត ទាត់ ដើម្បី ជៀសវាង ការអនុវត្ត វិធានការ រដ្ឋបាល គឺ ការបិទ អាជីវកម្ម ។
ជាថ្មី ម្ដង ទៀត សូម ប្រជាពលរដ្ឋ ទាំងអស់ អញ្ជើញ បង់ ថ្លៃ សេវា ប្រមូល សំរាម ប្រចាំ ខែ ឱ្យ បាន ទៀងទាត់ និង ទាន់ ពេល វលា ព្រោះ នេះ ជា កាតាព្វកិច្ច របស់ ប្រជាពលរដ្ឋ គ្រប់ ៗ គ្នា ។
រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការប្រមូល ថ្លៃ សេវា ប្រមូល សំរាម និង សំណល់ រឹង នៅ រាជធានី ភ្នំពេញ សម្រាប់ ខែតុលា ឆ្នាំ ២០២០ ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា បច្ចុប្បន្ន រដ្ឋបាល រាជធានី កំពុង ទទួល ការបង់ ថ្លៃ សេវា ប្រមូល សំរាម និង សំណល់ រឹង សម្រាប់ ខែតុលា ឆ្នាំ ២០២០ ចំពោះ ប្រជាពលរដ្ឋ ដែល ខកខាន មិន បាន បង់ ថ្លៃ សេវា សម្រាប់ ខែកញ្ញា និង ខែ មុន ៗ កន្លងមក រដ្ឋបាល រាជធានី បាន អនុវត្ត វិធានការ ដោយ កត់ត្រា ជា បំណុល រួចហើយ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន អះអាង ថា ខ្លួន បន្ដ ប្រកាន់ យក ភាព អត់ធ្មត់ មិន អនុវត្ត វិធានការ រដ្ឋបាល និង ច្បាប់ ដោយ នៅតែ ទុក ឱកាស ឲ្យ ប្រជាពលរដ្ឋ ជា អាជីវករ ពាណិជ្ជករ សិប្បក រ ធុរៈ ជន ភ្ញាក់ រលឹក និង រួសរាន់ បង់ ថ្លៃ សេវា ប្រមូល សំរាម សំណង រឹង ឲ្យបាន ទាន់ ពេលវេលា កំណត់ ។ ដោយឡែក ថ្លៃ សេវា ប្រមូល សំរាម ខែតុលា ឆ្នាំ ២០២០ ត្រូវ កំណត់ នៅ ត្រឹម ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ៕
( ពោធិ៍សាត់ )៖ បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ និង លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន បញ្ជា គ្រឿងចក្រ បើក ការដ្ឋាន ស្ថាបនា ស្ដារ ឡើងវិញ ជាបន្ទាន់ នូវ កំណាត់ ផ្លូវ និង សំណង់ សិល្បការចំនួន ៧ខ្សែ ដែល ទទួលរង ការខូចខាត ដោយសារ ជំនន់ ទឹកភ្លៀង កាលពី ពេល កន្លងមក នៅ ខេត្ត ពោធិ៍សាត់ ដែល ប្រើប្រាស់ ថវិកា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ពិធី នេះ ប្រារព្ធ ធ្វើ នៅ ពីរ ទីតាំង ផ្សេង គ្នា គឺ នៅ ភូមិ ផ្លូវ ហ្លួង ឃុំ កញ្ជរ ស្រុក កណ្ដៀង និង នៅ ភូមិ អូរ រកា សង្កាត់ ចំរើន ផល ក្រុង ពោធិ៍សាត់ ដោយ បាន ការចូលរួម ពី រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ អភិបាល រង នៃ គណៈអភិបាល ខេត្ត នាយក រដ្ឋបាល សាលា ខេត្ត ប្រធាន អនុប្រធាន មន្ទីរ និង មន្ត្រី បច្ចេកទេស អាជ្ញាធរ ស្រុក ឃុំ ពាក់ព័ន្ធ ក្រុមហ៊ុន ម៉ៅការ ស្ថាបនា និង ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
លោក ប្រធាន មន្ទីរ បាន បន្ថែម ថា ក្នុង ចំណោម កំណាត់ ផ្លូវ ទាំង ៤៥ ខ្សែ ផ្លូវ ដែល តម្រូវឲ្យ ជួសជុល និង ស្ដារ ឡើងវិញ ជាបន្ទាន់ ដោយ ប្រើប្រាស់ ថវិកា បម្រុងទុក ឆ្នាំ ២០២០ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង អភិវឌ្ឍន៍ ជនបទ មាន ចំនួន ៧ខ្សែ ក្នុង នោះ រួម មាន៖
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ៖ ចូរ ប្រាប់ មនុស្ស ជា ទី ស្រលាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែវិច្ឆិកា៖ បង្ក្រាប ៣០ករណី ឃាត់ខ្លួន ៦៨ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣០ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១៥ករណី និង ជួញដូរ ១៥ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៦៨ នាក់ ។
ពិធី នេះ មាន ការចូលរួម ពីសំណាក់ លោក សោម អូន ប្រធាន សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា និង លោក Zhang Yaowu នាយក ការិយាល័យ មូនិធិ ចិន ដើម្បី សន្តិភាព និង អភិវឌ្ឍ ប្រចាំ ប្រទេស កម្ពុជា តំណាង ឲ្យ សហជីព ទូទាំង ប្រទេស ចិន និង សមាជិក សមាជិការ គណកម្មាធិការ ប្រតិបត្តិ របស់ សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា ជាច្រើន រូប ទៀត ។
លោក សោម អូន បាន ថ្លែង ថា បន្ទាប់ពី ការរីករាលដាល ជំងឺ កូវីដ១៩ សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា បាន បង្កើត ក្រុម ស្ម័គ្រចិត្ត ប្រយុទ្ឋ ប្រឆាំង ជម្ងឺ ដ៏ កាច សហាវ នេះ ហើយ បាន ធ្វើ សកម្មភាព រួម ចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ចុះ អប់រំ និង បាញ់ ថ្នាំ បំភាយ សម្លាប់ មេរោគ នៅ តាម បណ្តា ផ្ទះ ជួល កម្មករ កន្លែង ធ្វើការ រវស់ កម្មករ និង អគារ សាធារណៈ របស់ អាជ្ញាធរ ខេត្ត ក្រុង ។
លោក សោម អូន បាន បន្ត ថា សហជីព ប្រទេស ទាំង២ បាន និង កំពុងតែង ពង្រឹង សាមគ្គី និង ធ្វើ កិច្ចសហប្រតិបត្តិការ យ៉ាង ស៊ីជម្រៅ ដោយ បាន ការផ្លាស់ប្តូរ ទស្សនកិច្ច សិក្សា និង ដក បទពិសោធន៍ ពី គ្នា ទៅវិញ មក ជាពិសេស សហជីព ទូទាំង ប្រទេស ចិន តែងតែ ជួយ ដល់ សហជីព កម្ពុជា នៅពេល ជួប ការលំបាក ។
លោក សោម អូន បាន បញ្ជាក់ ថា អំណោយ សម្ភារ ប្រយុទ្ឋ ប្រឆាំង ជំងឺ កូវីដ១៩ របស់ មិត្ត ចិន នៅ ពេល នេះ គឺ មាន អត្ថប្រយោជន៍ ខ្លាំង ណាស់ និង សមស្រប ទៅនឹង សភាពការណ៍ បច្ចុប្បន្ន ដែល ប្រទេស កម្ពុជា កំពុងតែ ជួប នូវ បញ្ហា ប្រឈម ជាមួយ ជម្ងឺ ដ៏ កាច សាហាវ នេះ ។
លោក សូម ថ្លែង អំណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សហជីព ទូទាំង ប្រទេស ចិន ដែល បាន យកចិត្តទុកដាក់ រួមចំណែក ជាមួយ សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា ក្នុង ការចូលរួម យុទ្ឋ នាការ ការពារ សុខ មាលភាព របស់ កម្មករ ក៏ ដូចជា ប្រជាពលរដ្ឋ កម្ពុជាទូទៅ ។
លោក Zhang Yaowu បាន បញ្ជាក់ ថា « ខ្ញុំ សង្ឃឹម យ៉ាង មុតមាំ ថា ក្រោម ការប្រោសប្រទាន ពរ ពី ព្រះមហាក្សត្រ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី និង ក្រោម ការដឹកនាំ ដ៏ រឹងមាំ របស់ រដ្ឋាភិបាល សម្ដេច តេជោ ហ៊ុន សែន បងប្អូន កម្មករ កម្ពុជា និង សមាជិក សមាជិកា របស់ សភា ស ម័្ពន្ធ សហជីព ជាតិ កម្ពុជា នឹង មាន ជីវភាព ល្អ កាន់តែ ប្រសើរ ៕ ក្រសួង ការងារ ជូនដំណឹង ពី ការបើក ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ លើក ទី ៣៨ ជូន ដល់ កម្មករ និយោជិត ក្នុង វិស័យ កាត់ដេរ ដែល ត្រូវបាន ព្យួរ កិច្ចសន្យា ការងារ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ រសៀល ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការបើក ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ ( លើក ទី៣៨ ) ជូន កម្មករ និយោជិត សរុប ចំនួន ១. ៥៧១ នាក់ នៅ រោងចក្រ សហគ្រាស ចំនួន ៣ ក្នុង វិស័យ កាត់ដេរ ដែល ត្រូវបាន ព្យួរ កិច្ចសន្យា ការងារ ស្រប តាម ស្មារតី នៃ កញ្ចប់ វិធានការ របស់ រាជ រដ្ឋាភិបាល ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕
