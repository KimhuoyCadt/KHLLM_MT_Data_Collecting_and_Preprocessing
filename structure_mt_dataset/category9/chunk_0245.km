សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ឲ្យដឹង ថា៖ « ក្នុង គោលបំណង រួម ដើម្បី លើកកម្ពស់ ផលិតផល កសិកម្ម ក្នុង ស្រុក និង សុវត្ថិភាព ចំណីអាហារ ក្រុមហ៊ុន ដាវ៉ាន់ និង អង្គការ អាដ្រា កម្ពុជា បាន ព្រមព្រៀង គ្នា លើ កិច្ចសហប្រតិបត្តិការ តាមរយៈ ការចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា ដែល មាន រយៈពេល ៣ឆ្នាំ ។ អនុស្សារណៈ យោគយល់ គ្នា នេះ មាន ប្រសិទ្ធភាព ចាប់ពី ថ្ងៃ ចុះហត្ថលេខា នេះ តទៅ រហូតដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ » ។
តាមរយៈ កម្មវិធី មូលដ្ឋាន សហគមន៍ អាដ្រា ស្វែងរក ការបង្កើត ឲ្យ មាន ការគាំទ្រ សុខ មាលភាព ប្រជាជន ឲ្យបាន ពេញលេញ ដែល ទាំងអស់ នេះ ទាមទារ ឲ្យ មាន ការរៀបចំ ចង ក្រង និង ការអនុវត្ត ប្រកបដោយ និរន្តរភាព គម្រោង ដឹកនាំ ដោយ សហគមន៍ ខ្លួន ឯង ដែល គាំទ្រ ដល់ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ និរន្តរភាព ។ ក្នុង នោះ អាដ្រា បាន បញ្ចូល គោលដៅ មួយចំនួន ដូចជា គោលដៅ គ្រោះ អត់ឃ្លាន ស្មើ សូន្យ . គោលដៅ សុខភាព និង សុខ មាលភាព មាំមួន និង គោ ដៅ ការអប់រំ ប្រកបដោយ គុណភាព ។
បច្ចុប្បន្ន នេះ អង្គការ អាដ្រា កម្ពុជា ដោយ មាន ការគាំទ្រ បចេ្ចកទេស ពី កម្មវិធី អភិវឌ្ឍន៍ សហគ្រិន អន្តរជាតិ ( អាយ ឌីអ៉ី ) កំពុង គាំទ្រ កសិករ ក្នុង ៥ស្រុក នៅ ខេត្ត ពោធិ៍សាត់ ទាំងមូល ក្រោម គម្រោង « លើកកម្ពស់ ខ្សែ ច្រវាក់ ផលិតកម្ម ទីផ្សារ តាមរយៈ និរន្តរភាព ផលិតកម្ម » ដែល ហៅ កាត់ ថា ប្រូម៉ាឃីត មាន រយៈពេល ៥ ឆ្នាំ រហូតដល់ ខែធ្នូ ឆ្នាំ ២០២៣ ។ គម្រោង នេះ ដើម្បី លើកកម្ពស់ ខ្សែ ច្រវាក់ តម្លៃ ផលិតផល បន្លែ និង ផ្លែ ឈើ តាមរយៈ ការធ្វើការ ជាមួយ កសិករ ខ្នាត តូច ក្នុង ខេត្ត ពោធិ៍សាត់ ។
លោក ឆេង មករា បញ្ជាក់ បន្ថែម យ៉ាង ដូច្នេះ៖ « យើង សង្ឃឹម ថា នឹង មាន ដៃគូ ជាច្រើន ទៀត ដូច អង្គារ អាដ្រា កម្ពុជា ក្នុង ការលើកកម្ពស់ ផលិតផល ក្នុង ស្រុក និង ប្រឹងប្រែង លើ ផលិត សុវត្ថិភាព ចំណីអាហារ »៕
ឧបករណ៍ ជំរុញ សំពាធ ទឹក នេះ មាន ការធានា ត្រឹមត្រូវ ហើយ រាល់ ការមាន បញ្ហា ក្រុមហ៊ុន ដោះដូរ ថ្មី ជូន តែម្តង ។ អតិថិជន អាច ប្រឹក្សា យោបល់ ជាមួយ ជាង ជំនាញ ផ្ទាល់ មាន ជាង ជំនាញ ទៅ សិក្សា ដល់ ទីកន្លែង ។
លោកស្រី Chunying ក៏ បាន បញ្ជាក់ ជាថ្មី ម្តង ទៀត ថា ទីក្រុង ហុងកុង គឺជា ផ្នែក មួយ ដែល មិន អាច កាត់ផ្តាច់ បាន ពី ប្រទេស ចិន ហើយ កិច្ចការ ទីក្រុង ហុងកុង គឺជា កិច្ចការ ផ្ទៃក្នុង របស់ ចិន សុទ្ធសាធ ដូច្នេះហើយ អាមេរិក គួរតែ បញ្ឈប់ ការជ្រៀត ជ្រែក ចូល កិច្ចការ ទីក្រុង ហុងកុង ដោយ គ្មាន លក្ខខណ្ឌ ៕
ប្រសិនបើ ត្រូវបាន បញ្ជាក់ ដោយ ព្រឹទ្ធសភា លោក Becerra ក្នុង វ័យ ៦២ ឆ្នាំ នឹង ក្លាយជា ជនជាតិ អាមេរិកាំង ដើមកំណើត ឡាទីន ដំបូង គេ បង្អស់ ដែល ដឹកនាំ ក្រសួង សុខាភិបាល និង សេវាកម្ម មនុស្សជាតិ ជា ទីភ្នាក់ងារ មាន កញ្ចប់ ថិវិកា ប្រចាំ ឆ្នាំ ១ទ្រី លាន ដុល្លារ អាមេរិក ជាមួយនឹង បុគ្គលិក ៨០.០០០ នាក់ ទទួលបន្ទុក ត្រួតពិនិត្យ ឱសថ . វ៉ាក់សាំង . ការស្រាវជ្រាវ វេជ្ជសាស្ត្រ ក៏ ដូចជា កម្មវិធី ធានារ៉ាប់រង សុខភាព ដែល គ្របដណ្តប់ ពលរដ្ឋ អាមេរិកាំង ច្រើន ជាង ១៣០ លាន នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ លើ Facebook នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ថា « កន្លងមក ជាមួយនឹង ការតាមដាន នូវ ដំណើរការ ផលិត វ៉ាក់សាំង ប្រឆាំង កូវីដ១៩ របស់ ប្រទេស នានា ខ្ញុំ បាន ណែនាំ រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល និង រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច ហិរញ្ញវត្ថុ ឱ្យ ត្រៀម បំរុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង នេះ យកមក ចាក់ ជូន ប្រជាជន យើង ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ផងដែរ » ។
សម្តេច តេជោ ក៏ បាន បញ្ជាក់ ដែរ ថា សម្តេច បាន ណែនាំ រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច ហិរញ្ញវត្ថុ ត្រៀម ថវិកា សម្រាប់ ការទិញ ១លាន ដូស ( មួយ លាន ដូស ) ក្នុង ដំណាក់កាល ដំបូង ដើម្បី ចាក់ ជូន ចំពោះ អ្នក ដែល ធ្វើការ នៅ កន្លែង ដែល មាន ហានិភ័យ ខ្ពស់ និង អ្នក ដែល មាន ហានិភ័យ ។ មួយ លាន ដូស ចាក់ បាន ត្រឹមតែ មនុស្ស ៥០ម៉ឺន នាក់ ប៉ុណ្ណោះ ( ព្រោះ ម្នាក់ ត្រូវ ការចាក់ ២ដង ) ក្នុង ពេល យើង មាន ប្រជាជន ១៦លាន នាក់ ទាំង ចាស់ ទាំង ក្មេង ដែល ក្នុង នោះ អាច មាន មនុស្ស ប្រមាណ ១០លាន នាក់ ត្រូវ ការចាក់ វ៉ាក់សាំង ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន លើកឡើង ថា ក្នុង ស្ថានភាព ដែល កម្ពុជា នៅ ក្រខ្វះ ថវិកា សម្រាប់ ទិញ បន្ថែម សម្តេច បាន ណែនាំ រដ្ឋ មន្ត្រី ទាំង ២រូប ឱ្យ ពិភាក្សា ជាមួយ ដៃគូ អភិវឌ្ឍន៍ ទាំង ទ្វេ ភាគី ទាំង ពហុ ភាគី ដើម្បី ស្វែងរក ជំនួយ បន្ថែម មក ជួយ ដល់ ប្រជាជន ។
ហាង ហ្វ៊ុយ ជី ជា អាហារដ្ឋាន បែប ជប៉ុន នៅ ជាន់ ទី២ នៃ ផ្សារ អ៉ីន អន១ ត្រូវបាន លោក ឆែម សាវុធ អគ្គ នាយក ពន្ធនាគារ និង ភរិយា រួមទាំង អង្គរក្ស ដែល ផ្ទុក មេរោគ កូវីដ១៩ ដោយ មិន ដឹងខ្លួន បាន ទៅ ទទួលទាន អាហារ នៅ ហាង នេះ កាលពី ល្ងាច ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។ វីដេអូ ទទួលទាន នៅ អាហារ នេះ ទើបនឹង ត្រូវបាន រកឃើញ ដោយ ក្រសួង សុខាភិបាល ។
ប្រទេស កម្ពុជា បាន ចាប់ផ្តើម ឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ លើក ដំបូង កាលពី ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២០ បន្ទាប់ពី ក្រសួង សុខាភិបាល បាន រកឃើញ ករណី វិជ្ជមាន កូវីដ១៩ លើ ភរិយា របស់ លោក ឆែម សាវុធ អគ្គ នាយក ពន្ធនាគារ ហើយ ករណី នេះ បាន រីករាលដាល បន្ត រហូតដល់ មាន អ្នក ឆ្លង ចេញ ពី សហគមន៍ ចំនួន ៣២ នាក់ ។
គិត ត្រឹម ម៉ោង ៧៖០០ នាទី ព្រឹក ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នៅ កម្ពុជា រកឃើញ អ្នក ឆ្លង កូវីដ១៩ សរុប ចំនួន ៣៤៨ នាក់ ក្នុង នោះ អ្នក ព្យាបាល ជាសះស្បើយ ចំនួន ៣០៦ នាក់ និង អ្នក កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ចំនួន ៤២ នាក់ ៕ អូស្ត្រា លី៖ បុរស ម្នាក់ រួចផុត ពី ស្លាប់ ក្រោយ រង ការវាយប្រហារ ពី ត្រី ឆ្លាម
អង្គការ ស្រាវជ្រាវ វិទ្យាសាស្ត្រ និង ឧស្សាហកម្ម អូស្រ្តាលី (CSIRO) ក្នុង ឆ្នាំ ២០១៨ បាន ចេញផ្សាយ ការសិក្សា មួយ ដែល បាន រកឃើញ ថា ត្រី ឆ្លាម ពណ៌ ស ធំ ពេញ វ័យ ប្រមាណ ១.៤៦០ ក្បាល រស់ នៅ ក្បែរ ឆ្នេរសមុទ្រ ភាគ ខាងត្បូង និង ខាងលិច នៃ ប្រទេស អូស្ត្រាលី ៕
អភិបាល ខេត្ត ក្រចេះ ណែនាំ ដល់ អាជ្ញាធរ ក្នុង ខេត្ត បិទ ទីតាំង អាជីវកម្ម ទាំងឡាយ ណា ដែល បំពាន វិធានការ ការពារ ជំងឺ កូវីដ១៩
( ក្រចេះ ) ៖ លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ណែនាំ ដល់ អាជ្ញាធរ ក្នុង ខេត្ត គ្រប់ លំដាប់ថ្នាក់ ចុះ ពិនិត្យមើល និង បិទ ទីតាំង អាជីវកម្ម ទាំងឡាយ ណា ដែល បំពាន វិធានការ របស់ ក្រសួង សុខាភិបាល ក្នុង ការការពារ ជំងឺ កូវីដ១៩ ។ នេះ បើ យោង តាម សេចក្តីណែនាំ ស្តីពី វិធានការ បង្ការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នៅ សហគមន៍ ក្នុង ភូមិសាស្ត្រ ខេត្ត ក្រចេះ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
សម្តេច ក៏ បាន ចេញ សារ ណែនាំ ជាពិសេស ថ្មី មួយ ដោយ បាន ផ្តល់ សិទ្ធិ ដល់ រដ្ឋមន្ត្រី និង អភិបាល រាជធានី - ខេត្ត មាន សិទ្ធិ បិទ ផ្នែក ខ្លះ នៃ ក្រសួង ឬ បិទ ក្រសួង ក៏ ដូចជា បិទ សាលារៀន បិទ អាហារដ្ឋាន ភោជនីយដ្ឋាន ឬ ទីតាំង មួយចំនួន ដែល ជាប់ពាក់ព័ន្ធ ព្រឹត្តិការណ៍ សហគមន៍ ២៨វិច្ឆិកា ផងដែរ ៕
សូម បញ្ជាក់ ថា ការប្រកាស ពន្យា ពេល ប្រឡង បាក់ឌុប សម្រាប់ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ នេះ ក៏ ដោយសារ កម្ពុជា ផ្ទុះឡើង នូវ ជំងឺ កូវីដ - ១៩ នៅក្នុង សហគមន៍ ជា ធ្វើឲ្យ មាន អ្នក ឆ្លង ជា បន្ដ បន្ទាប់ ៕ ឯក អគ្គ រដ្ឋទូត ឥណ្ឌា ប្រចាំ កម្ពុជា ណែនាំ ឱកាស វិនិយោគ លើ វិស័យ ជាច្រើន នៅ កម្ពុជា ដល់ ក្រុមហ៊ុន ឥណ្ឌា
គួរ ជម្រាប ថា នា ថ្ងៃទី ៣- ៤ ខែធ្នូ ឆ្នាំ ២០២០ រដ្ឋាភិបាល ឥណ្ឌា ក្រសួង ពាណិជ្ជកម្ម និង ឧស្សាហកម្ម ឥណ្ឌា បាន សហការ ជាមួយ ក្រុម ប្រទេស CLMV ( កម្ពុជា ឡាវ មី យ៉ាងន់ម៉ា និង វៀតណាម ) ក៏ បាន រៀបចំ សន្និសីទ ពាណិជ្ជកម្ម លើក ទី៦ ក្រោម ប្រធានបទ៖ ការកសាង ស្ពាន ជាមួយ ក្រុម ប្រទេស CLMV សម្រាប់ ការទំនាក់ទំនង និង ការអភិវឌ្ឍ តាមរយៈ ប្រព័ន្ធ អនឡាញ ។
នា ឱកាស សន្និសីទ ពាណិជ្ជកម្ម ខាងលើ លោក V . Muraleedharan រដ្ឋមន្រ្តី ក្រសួង ការបរទេស ទទួលបន្ទុក កិច្ចការ ការបរទេស បាន លើកឡើង ថា ក្នុង រយៈកាល កូវី ដ១៩ ដូចជា ការផ្តល់ ថ្នាំ និង វេជ្ជសាស្ត្រ និង បណ្តុះបណ្តាល បុគ្គលិក ពេទ្យ តាមរយៈ កម្មវិធី ITEC ។ លោក បាន បន្ថែម ថា ប្រទេស ឥណ្ឌា ព្យាយាម បង្កើន កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស CLMV ជាមួយនឹង ការអភិវឌ្ឍ វ៉ាក់សាំង ប្រឆាំង កូវីដ - ១៩ ហើយ នឹង មាន ឆន្ទៈ ក្នុង ការចែករំលែក វ៉ាក់សាំង នៅពេល ធ្វើ បាន ជោគជ័យ ។
លោក បាន រំលឹក ឡើងវិញ នូវ ការប្តេជ្ញាចិត្ត របស់ ឥណ្ឌា ចំពោះ សមាហរណកម្ម អាស៊ាន និង កម្មវិធី តភ្ជាប់ អាស៊ាន និង បាន លើកទឹកចិត្ត ប្រទេស អាស៊ាន ជាពិសេស ប្រទេស CLMV សម្រាប់ ការប្រើប្រាស់ ឥណទាន ១.០០០ លាន ដុល្លារ សម្រាប់ ពង្រឹង ការតភ្ជាប់ តាម បែប ឌីជីថល និង តាម បែប ផ្សេង ៗ ។
ក្នុង កិច្ចប្រជុំ ដាច់ដោយឡែក រវាង ប្រទេស កម្ពុជា និង ឥណ្ឌា ខាងលើ លោកស្រី ឯ អគ្គ រដ្ឋទូត ទេ វ្យានី ខូប្រាហ្គាដេ បាន ស្នើសុំ ឱ្យ កម្ពុជា ពិនិត្យ ការប្រើប្រាស់ LoC ចំនួន ១.០០០ លាន ដុល្លារ ដែល ផ្តល់ ដោយ ឥណ្ឌា ដល់ បណ្តា ប្រទេស អាស៊ាន សម្រាប់ ការតភ្ជាប់ និង គម្រោង ផ្សេង ៗ ៕ ផ្លូវ ទាំង ៣៤ ខ្សែ នៅ ព្រះសីហនុ ចាប់ផ្តើម អ៊ុត កៅស៊ូ . លោក គួច ចំរើន រំលឹក ក្រុមហ៊ុន កុំ លួច កម្រាស់ កៅស៊ូ
( ព្រះសីហនុ) ៖ បន្ទាប់ពី បញ្ចប់ ការសាងសង់ ផ្នែក បេតុង ឥឡូវនេះ ផ្លូវ ទាំង ៣៤ ខ្សែ ក្នុង ខេត្ត ព្រះសីហនុ បាន ចាប់ផ្តើម អ៊ុត កៅស៊ូ ពីលើ ហើយ ។ ការអ៊ុត កៅស៊ូ នេះ បាន ចាប់ផ្តើម ឡើង នៅ ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២០ ហើយ គ្រោង នឹង បញ្ចប់ នៅ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២១ ។
ការចាប់ផ្តើម ដំណើរការ អ៊ុត កៅស៊ូ ពីលើ ផ្លូវ បេតុង ទាំង ៣៤ខ្សែ នៅក្នុង ក្រុង ព្រះសីហនុ ត្រូវបាន ធ្វើឡើង ក្រោម ការពិនិត្យ ដោយ ផ្ទាល់ របស់ ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ កាលពី ថ្ងៃទី ០២ ខែធ្នូ កន្លងទៅ នេះ ។
ដំណើរការ អ៊ុត កៅស៊ូ នេះ ក៏ ត្រូវបាន តាមដាន ពិនិត្យ យ៉ាង ដិតដល់ ពី លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ ផងដែរ ។ ដើម្បី ធានា ថា ការអ៊ុត កៅស៊ូ ធ្វើឡើង ត្រឹមត្រូវ ទៅ តាម បច្ចេកទេស ដែល បាន កំណត់ នោះ នៅ ព្រឹក ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ លោក គួច ចំរើន បាន ដឹកនាំ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ចុះ ពិនិត្យមើល សកម្មភាព អ៊ុត បេទី ម លើ ផ្លូវ ទាំង ៣៤ខ្សែ នេះ ។
ក្នុង ឱកាស នោះ លោក គួច ចំរើន បាន ណែនាំ ដល់ ក្រុមហ៊ុន អ៊ុត បេទីម ទាំង ០៣ ក្រុមហ៊ុន ត្រូវ បំពេញ ការងារ ប្រកាន់ភ្ជាប់ នូវ បរិមាណ គុណភាព និង សោភ័ណភាព តាម លក្ខណៈ បច្ចេកទេស និង ស្តង់ដារ ដើម្បី ធានា ការប្រើប្រាស់ បាន យូរអង្វែង សម្រាប់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ អ្នក វិនិយោគ ភ្ញៀវ ទេសចរ ជាតិ អន្តរជាតិ មក លេង កំសាន្ត នៅក្នុង ខេត្ត ព្រះសីហនុ មាន ភាពងាយស្រួល ។
សូម បញ្ជាក់ ថា ផ្លូវ ទាំង ៣៤ ខ្សែ ក្នុង ក្រុង ព្រះសីហនុ ត្រូវបាន បើក ការដ្ឋាន សាងសង់ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា កាលពី ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
ទន្ទឹមនឹង ការសោកស្ដាយ នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន លើកឡើង ថា នៅ ពេល នេះ រាជ រដ្ឋាភិបាល ស្ថាប័ន ជំនាញ អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ រួម ជាមួយ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស បាន និង កំពុង សហការ គ្នា យ៉ាង សស្រាក់សស្រាំ និង ម៉ឺងម៉ាត់ បំផុត ដើម្បី ទប់ស្កាត់ និង បង្ការ ការឆ្លង វីរុស កូរឹត - ១៩ នៅក្នុង សហគមន៍ ។
បើ តាម សេចក្ដីថ្លែងការណ៍ ដដែល នោះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន គូសបញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា តែងតែ ផ្តល់ ព័ត៌មាន ទាន់ ហេតុការណ៍ និង ព័ត៌មាន ចាំបាច់ នានា ស្តីពី វិធានការ របស់ រាជ រដ្ឋាភិបាល ជូន សាធារណជន និង ថ្វាយ ប្រគេន ព្រះថេរានុត្ថេរៈ គ្រប់ ព្រះអង្គ បាន ជ្រាប មិន ថា ពេល យប់ ឬ ពេល ថ្ងៃ នៅ ទីកន្លែងណា នោះ ទេ ។ ជាមួយគ្នា នេះ ដែរ ក្រសួង សុខាភិបាល ក៏ បាន បញ្ចេញ ព័ត៌មាន ទាន់ ហេតុការណ៍ យ៉ាង សកម្ម ពី ព្រឹត្តការណ៍ សហគមន៍ ២៨ វិច្ឆិកា ផងដែរ ។
អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន អំពាវនាវ ដល់ សាធារណជន ប្រជាពលរដ្ឋ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ អ្នកសារព័ត៌មាន និង ព្រះថេរានុត្ថេរៈ គ្រប់ ព្រះអង្គ មេត្តា ប្រុងប្រយ័ត្ន និង រួមគ្នា ទប់ស្កាត់ ចំពោះ ការផ្សព្វផ្សាយ បន្ត ព័ត៌មាន ប្រឌិត ដែល មិន មែន ជា ប្រភព ផ្លូវការ ៕
ក្រុមហ៊ុន ខ្មែរ មួយ បង្ហាញ ទឹក លាង ដៃ និង ទឹក បាញ់ សម្អាត តាម បែប បច្ចេកវិទ្យា របស់ ប្រទេស រុស្ស៉ី ដែល អាច សម្លាប់ មេរោគ រហូតដល់ ៩៩. ៩៩ ភាគរយ
លោក បណ្ឌិត នី វុទ្ធី ជំនាញ ផ្នែក ជំងឺ រុក្ខជាតិ និង លោកស្រី បណ្ឌិត អ៊ុក សាវិន ជំនាញ ផ្នែក បសុសត្វ បាន ឱ្យដឹង ដែរ ថា កម្ពុជា ត្រូវការ ពង្រឹង ការស្រាវជ្រាវ បែប បច្ចេកវិទ្យា កាន់តែ ច្រើន និង ស៊ីជម្រៅ ដោយ ប្រើប្រាស់ បច្ចេកវិទ្យា ចុងក្រោយ និង ប្រកបដោយ សុវត្តិភាព ដើម្បី បង្កើន គុណភាព និង ផលិតភាព សម្រាប់ ការផលិត នៅក្នុង ស្រុក ក៏ ដូចជា បង្កើន ភាពប្រកួតប្រជែង ជាមួយនឹង ទំនិញ ពី ក្រៅ ប្រទេស ពិសេស សម្រាប់ វិស័យ កសិកម្ម និង ចំណី ។
( កំពង់ធំ )៖ លោក ព្រឹម រដ្ឋា អភិបាល រង ខេត្ត កំពង់ធំ និង លោក ម៉ាក់ ប៊ុន ហុង អភិបាល ក្រុង ស្ទឹង សែន រួមទាំង មន្ត្រី ក្រោម ឱវាទ ច្រើន នាក់ នា ព្រឹក ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ចុះ ផ្សព្វផ្សាយ អប់រំ ណែនាំ ដល់ អាជីវក ប្រជាពលរដ្ឋ តាម ផ្សារ កំពង់ធំ ផ្សារ ចាស់ និង តាម ភោជនីយ៍ដ្ឋាន ជុំវិញ ខេត្ត ពី វិធានការ ការពារ ជំងឺ កូវីដ១៩ និង ជៀស ផុត ពី ការឆ្លង ខណៈពេល កំពុង ផ្ទុះ ចូលក្នុង សហគមន៍ ។
លោក ព្រឹម រដ្ឋា បាន ផ្តាំផ្ញើ ដល់ មន្ត្រី ស្រុក ភូមិ ឃុំ និង ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ទាំងអស់ បង្ការ ឱ្យ បាន ពី ការឆ្លង ជំងឺ ដ៏ កាច សាហារ នេះ ដោយ ត្រូវ ប្រកាន់ ឱ្យ បាន ខ្ជាប់ខ្ជួន លើ ការរក្សា អនាម័យ ខ្ពស់ ត្រូវ ហូប ស្អាត ផឹក ទឹក ស្អាត រស់ នៅ ស្អាត និង ត្រូវ សម្អាត កន្លែង បំពេញ កិច្ចការងារ ត្រូវ លាង ដៃ ជាមួយ សាប៊ូ និង អាល់កុល ឲ្យ បាន ញឹកញាប់ ជា ប្រចាំ គ្រប់ ពេលវេលា និង ជារៀងរាល់ ថ្ងៃ ។
លោក ព្រឹម រដ្ឋា អភិបាល រង ខេត្ត បាន បន្ត ថា មូលដ្ឋាន បាន ចុះ ធ្វើ ការផ្សព្វផ្សាយ អំពី វិធានការ ការពារ និង ទប់ស្កាត់ ការឆ្លង រាល់ ដាល ជម្ងឺ កូវីដ១៩ (Covid-19) តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ព្រមទាំង ពាំនាំ នូវ ប្រសាសន៍ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ក្នុង នោះ ដែល អាជ្ញាធរ ខេត្ត អាជ្ញាធរ ក្រុង ក៏ បាន ណែនាំ ដល់ ម្ចាស់ ភោជនីយដ្ឋាន ដោយ ត្រូវការ គម្លាគ្នា តុ កៅអី យ៉ាងតិច ១.៥ម៉ែត្រ ត្រូវ សម្អាត តាម តុ តាម កៅអី ឱ្យ បាន ញឹកញាប់ ដោយ ការបាញ់ ទឹក អាកុល ពេល ភ្ញៀវ ចូលមក ត្រូវ មាន ការបាញ់ កម្តៅ ប្រសិន ភ្ញៀវ មាន កម្តៅ លើស ៣៧អង្សា ត្រូវ បញ្ឈប់ ឃាត់ខ្លួន គាត់ ហើយ ប្រញាប់ រាយការ ទៅកាន់ អាជ្ញាធរ ឬ ខល ទៅកាន់ លេខ ១១៥ ជា បន្ទាន់ ឬ ឱ្យ គាត់ ទៅ ពិនិត្យ នៅ សាលា បឋមសិក្សារ កំពង់ធំ ដើម្បី ធ្វើចត្តាឡី ស័ក ហើយ ឱ្យ ក្រុម គ្រូពេទ្យ ពិនិត្យ ។
លោក ក៏ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ កុំ ធ្វើដំណើរ ចេញ ទៅ ក្រៅ មូលដ្ឋាន ភូមិ របស់ ខ្លួន ក្នុង ករណី មិន ចាំបាច់ ។ ចំពោះ ករណី ចាំបាច់ ផ្សេង ៗ ត្រូវ ប្រើប្រាស់ កន្សែង ឬ ម៉ាស់ ជាប្រចាំ ជាពិសេស ទៅ ផ្សារ ត្រូវ មាន អាកុល ឬ ជែល ដាក់ តាម ខ្លួន ដើម្បី លាងសំអាត ជាប្រចាំ ការពារ ខ្លួន ឯង ផងដែរ ៕
ក្រុមការងា រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ បើក យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល ជំងឺ កូវីដ - ១៩ នៅ តាម ក្រុង - ស្រុក នានា
( ខេត្ត កំពង់ធំ )៖ ក្រុមការងា រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ រួម ជាមួយ រដ្ឋបាល ខេត្ត កំពង់ធំ នា ព្រឹក ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បើក យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល ជំងឺ កូវីដ - ១៩ នៅ តាម មូលដ្ឋាន ក្រុង - ស្រុក នានា ទូទាំង ខេត្ត ពិសេស គឺ បាន ចែកជូន នូវ ម៉ាស់ ទឹក អាកុល ជែល និង សម្ភារ បរិក្ខារ យ៉ាង ច្រើន ផងដែរ ។
លោក គង់ សូលីដា អគ្គ នាយក រដ្ឋបាល ក្រសួង ទេសចរណ៍ ជា លេខាធិការ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ ក្នុង នាម តំណាង លោក ថោង ខុន រដ្ឋមន្រ្តី ក្រសួង ទេសចរណ៍ ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ បាន ប្រគល់ ម៉ាស់ ចំនួន ២.០០០ ទឹក អាកុល និង ទឹក ជែល ចំនួន ៥២០ ដប ដល់ រដ្ឋបាល ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក នៅក្នុង ពិធី បើក យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ការឆ្លង ជំងឺ កូវីដ - ១៩ នៅ តាម មូលដ្ឋាន ស្រុក ទាំង ពីរ នេះ ។
នា ឱកាស នោះ លោក គង់ សូលីដា បាន បញ្ជាក់ ថា ការប្រគល់ សម្ភារៈ សម្រាប់ បើក យុទ្ធនាការ នេះ គឺ អនុវត្ត តាម អនុសាសន៍ ណែនាំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី កាលពី ថ្ងៃទី ០៥ ខែធ្នូ ឆ្នាំ ២០២០ ដែល បាន ណែនាំ ដល់ រដ្ឋបាល រាជធានី - ខេត្ត ចុះ ត្រួតពិនិត្យ ឱ្យ បាន ម៉ឺងម៉ាត់ ស្តីការអនុវត្ត វិធាន សុវត្ថិភាព នៅ តាម មូលដ្ឋាន រាជធានី - ខេត្ត ក្រុង - ស្រុក - ខណ្ឌ ឃុំ - សង្កាត់ សំដៅ ចូលរួម ការពារ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ នៃ ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា ។
លោក គង់ សូលីដា ក៏ បាន រំលឹក ពី ការណែនាំ របស់ លោក ថោង ខុន ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ដែល បាន ណែនាំ ដល់ ក្រុមការងារ រដ្ឋបាល ខេត្ត ក្រុង - ស្រុក អនុវត្ត យុទ្ធនាការ នេះ ជាប់ ជាប្រចាំ និង ដូច ភ្លៀង រលឹម ។ ករណី មូលដ្ឋាន អាជីវកម្ម ណា មិន អនុវត្ត តាម វិធាន សុវត្ថិភាព និង គោលការណ៍ ណែនាំ របស់ ក្រសួង សុខាភិបាល គឺ រដ្ឋបាល ស្រុក មាន សិទ្ធិ រាយការណ៍ សុំ យោបល់ ពី អភិបាល ខេត្ត ដើម្បី បិទ អាជីវកម្ម នោះ ជា បណ្តោះអាសន្ន ។
ដោយឡែក ក្នុង យុទ្ធនាការ នេះ ក្រុមការងារ រាជ រដ្ឋាភិបាល និង រដ្ឋបាល ខេត្ត ក្រុង - ស្រុក នឹង ចុះ ពិនិត្យ បន្ថែម ទៅ លើ មូលដ្ឋាន អាជីវកម្ម មួយ ចំនួន ទៀត ដូចជា តាម ទីផ្សារ កន្លែង លក់ដូរ សាលារៀន វត្ត អារាម ការជួបជុំ និង ការរៀបចំ ពិធី បុណ្យ សាសនា អាពាហ៍ពិពាហ៍ ។
លោក ហាក់ ម៉ុង ហួត អភិបាល ស្រុក តាំង គោក បាន បញ្ជាក់ បន្ថែម ដែរ ថា នៅក្នុង សកម្មភាព ចុះ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ខាងលើ នេះ លោក បាន ចូលរួម ដឹកនាំ ក្រុមការងារ និង យុវជន ដែល ប្រដាប់ ដោយ សម្ភារៈ ការពារ គ្រប់គ្រាន់ ចុះ អប់រំ ផ្សព្វផ្សាយ ជារឿយ ៗ ដល់ ប្រជាពលរដ្ឋ មូលដ្ឋាន ដូចជា នៅ កន្លែង លក់ដូរ អាជីវកម្ម ផ្សារ វត្ត អារាម កន្លែង ប្ដូរ ប្រាក់ និង មាន ម៉ូតូកង់ បី ចាក់ មេក្រូ ជិះ ផ្សព្វផ្សាយ តាម ភូមិ ផងដែរ ។
លោក ថា ក្រុមការងារ ម្នាក់ ៗ តែង ប្រកាន់ នូវ ស្មារតី ការពារ ខ្លួន ដូចជា ការពាក់ ម៉ាស់ ដាក់ ទឹក អាល់កុល ឬ ជែល តាម ខ្លួន ពាក់ ស្រោម ដៃ រក្សា គម្លាត ពី គ្នា ជាដើម ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន ក៏ ធ្លាប់ បាន ណែនាំ យ៉ាង ម៉ឺងម៉ាត់ អំពី ការចូលរួម អនុវត្ត ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ក្នុង យុទ្ធនាការ ពិសេស មួយ នេះ ដែល ជា ការសំខាន់ និង ចាំបាច់ ណាស់ ។ យុទ្ធនាការ នេះ ត្រូវតែ ចាប់ផ្តើម ពី ឥលូវនេះ ទៅ ដោយ តម្រូវ ឱ្យ មាន ការអប់រំ ពន្យល់ នូវ ខ្លឹមសារ ថ្មី ៗ បន្ថែម របស់ ក្រសួង សុខាភិបាល ។
បើ តាម គ.ជ. ប. មាត្រា ៤១ នៃ រដ្ឋធម្មនុញ្ញ ចែង ថា « ប្រជាពលរដ្ឋ ខែ្មរ មាន សេរីភាព ខាង ការបញ្ចេញមតិ របស់ ខ្លួន សេរីភាព ខាង សារព័ត៌មាន សេរីភាព ខាង ការបោះពុម្ព ផ្សាយ សេរីភាព ខាង ការប្រជុំ ។ ជន ណា ក៏ដោយ មិន អាច ឆ្លៀត ប្រើ សិទ្ធិ នេះ ដោយ រំលោភ នាំឱ្យ ប៉ះពាល់ ដល់ កិត្តិយស របស់ អ្នកដទៃ ដល់ ទំនៀមទម្លាប់ ល្អ របស់ សង្គម ដល់ សណ្តាប់ធ្នាប់ សាធារណៈ និង ដល់ សន្តិសុខ ជាតិ បាន ឡើយ » ។
កម្មវត្ថុ នៃ បណ្តឹង គឺ ស្នើសុំ ឱ្យ ព្រះរាជអាជ្ញា ធ្វើ ការចោទប្រកាន់ ចំនួន ៣បទ លើ្ម ស រួម មាន៖
* បរិហារ កេរ្តិ៍ ជាសាធារណៈ * ជេរ ប្រមាថ ជាសាធារណៈ * ញុះញង់ ឱ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ ។
បទ លើ្មស ខាងលើ បាន ប្រព្រឹត្ត កាលពី អំឡុង ខែវិច្ឆិកា ឆ្នាំ ២០២០ តាម ប្រព័ន្ធ ទូរគមនាគមន៍ សោត ទស្សន៍ ដោយ ភ្ជាប់ ជាមួយ សារ ដែល ធ្វើឱ្យ មាន ការភាន់ច្រឡំ នាំឱ្យ បាត់បង់ ទំនុកចិត្ត លើ ស្ថាប័ន គ.ជ. ប ក៏ ដូចជា មក លើ ការបោះឆ្នោត ។
លោក សោម សូរីដា អគ្គ លេខាធិការ រង គ.ជ. ប និង ជា តំណាង ឱ្យ គ.ជ. ប នៃ បណ្តឹង នេះ បាន ថ្លែង ថា ក្រម ព្រហ្មទណ្ឌ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ បាន កំណត់ អំពី ព្រំដែន នៃ សិទ្ធិ នេះ ដែរ ថា មិន ត្រូវ ប្រើប្រាស់ សិទ្ធិ របស់ ខ្លួន ធ្វើឱ្យ ប៉ះពាល់ ដល់ បុគ្គល ដទៃ និង សង្គមជាតិ រួម មាន៖
* ប៉ះពាល់ ដល់ បុគ្គល រួម មាន ការប៉ះពាល់ ដល់ សិទ្ធិ ខាង រូបភាព សិទ្ធិ លំនៅឋាន និង ការបរិហារ កេរ្តិ៍ ផ្សេង ៗ ដែល នាំឱ្យ ប៉ះពាល់ ដល់ កិត្តិយស បុគ្គល ដែល បុគ្គល នៅ ទីនេះ រួម មាន ទាំង រូប វន្ត បុគ្គល និង នីតិបុគ្គល ។
* ការប៉ះពាល់ ដល់ សង្គមជាតិ ដូចជា ការប្រើ សិទ្ធិ នោះ នាំឱ្យ ប៉ះពាល់ ដល់ សណ្តាប់ធ្នាប់ សាធារណៈ ធ្ងន់ធ្ងរ ឬ មាន ចរិត លក្ខណៈ ញុះញង់ ដែល នាំឱ្យ បាត់បង់ នូវ សន្តិសុខ ជាតិ ។
លោក បាន បន្ត ថា ការចែកចាយ ព័ត៌មាន ឬ បញ្ចេញមតិ តាមរយៈ បណ្តាញ សង្គម ដោយ ធ្វើ ការអះអាង បំផ្លើស ឬ ការទម្លាក់ កំហុស ដោយ ទុច្ចរិត ដែល នាំឱ្យ ប៉ះពាល់ ដល់ កិត្តិយស ឬ កិត្តិសព្ទ របស់ អ្នកដទៃ ឬ ស្ថាប័ន ណាមួយ រួមទាំង ការចែកចាយ ព័ត៌មាន មិន ពិត ដែល មាន លក្ខណៈ ញុះញង់ ឱ្យ មាន ការប្រព្រឹត្ត អំពើហិង្សា ឬ បង្ក អសន្តិសុខ ដល់ សង្គម គឺជា បទល្មើស ព្រហ្មទណ្ឌ ដែល អ្នកប្រព្រឹត្ត ត្រូវ ទទួលទោស តាម ច្បាប់ ជាធរមាន ។
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បង្ហាញ តារាង តម្លៃ ស្រូវ សើម នៅ វាល ស្រែ ដែល កំពុង ប្រមូល ផល តាម បណ្តា ខេត្ត មួយចំនួន សម្រាប់ ថ្ងៃទី ០៧ ខែធ្នូ នេះ
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្រូវ អង្ក កម្ពុជា បាន បង្ហាញ តារា តម្លៃ ស្រូវ សើម នៅ វាល ស្រែ ដែល កំពុង ប្រមូល ផល តាម បណ្តា ខេត្ត មួយចំនួន សម្រាប់ ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ៕
ឆ្លង ចរន្ត អគ្គីសនី ឆាបឆេះ ផ្ទះ អតីត ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត ព្រៃវែង ខូចខាត ទាំងស្រុង
( ព្រៃវែង ) ៖ គ្រោះ អគ្គីភ័យ បណ្តាល មកពី ការឆ្លង ចរន្ត អគ្គីសនី មួយ បាន កើតឡើង នៅ ព្រឹក ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បណ្តាលឱ្យ ឆាប់ ឆេះ ផ្ទះ លោក ជុំ សុភី អាយុ ៦០ ឆ្នាំ ជា អតីត ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត ព្រៃវែង ខូចខាត ទាំងស្រុង ស្ថិត នៅ ភូមិ ៤ សង្កាត់ កំពង់លាវ ក្រុង ព្រៃវែង ខេត្ត ព្រៃវែង ។
ផ្ទះ ដែល ត្រូវបាន អគ្គីភ័យ ឆាបឆេះ នេះ មាន ទំហំ ១២ម៉ែត្រ X ២០ម៉ែត្រ និង បាន រាលដាល ទៅ ឆេះ ជញ្ជាំង ផ្ទះ មួយ ខ្នង ទៀត អស់ ជញ្ជាំង បន្តិចបន្តួច ដែល ម្ចាស់ ផ្ទះ ឈ្មោះ សួរ គឹម ហ៊ន ប្រពន្ធ ឈ្មោះ អៀង សុខ នឿន ដែល មាន ផ្ទះ នៅ ជាប់ គ្នា ។
ហេតុការណ៍ គ្រោះ អគ្គីភ័យ នេះ បាន ប្រើប្រាស់ រថយន្ត ពន្លត់ អគ្គីភ័យ ចំនួន ៤គ្រឿង ប្រើ ទឹក អស់ ចំនួន ៦ឡាន ក្នុង នោះ រថយន្ត ស្នងការដ្ឋាន នគរបាល ខេត្ត ចំនួន ៣គ្រឿង . រថយន្ត សាលា ខេត្ត ១គ្រឿង . រថយន្ត ស្រុក ស្វាយអន្ទរ ១គ្រឿង និង ជា សំណាង ល្អ មិន មាន ប៉ះពាល់ គ្រោះថ្នាក់ ដល់ អាយុជីវិត មនុស្ស ឡើយ ។
សូម បញ្ជាក់ ផងដែរ ថា ក្នុង ព្រឹត្តិការណ៍ នេះ ក៏ មាន ថ្នាក់ដឹកនាំ ខេត្ត ស្នងការ នគរបាល ខេត្ត អធិកា នគរបាល ក្រុង ព្រៃវែង ចុះ ធ្វើ អន្តរាគមន៍ បាន ទាន់ ពេលវេលា មិន បង្ក ឱ្យ មាន ការខូចខាត ដល់ ផ្ទះ ដទៃ និង មិន បណ្ដាលឱ្យ រងគ្រោះ ដល់ អាយុជីវិត និង ម្ចាស់ ផ្ទះ និង អ្នក ដ៏ទៃ ផងដែរ ៕
រដ្ឋបាល ខេត្ត សៀមរាប បន្ត ចាត់ វិធាន អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ស្ដីពី វិធានការ បង្ការ ជំងឺ កូវីដ
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប បាន និង កំពុង បន្ត ចាត់ វិធាន អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ស្ដីពី វិធានការ បង្ការ ខ្លួន ពី ជំងឺ កូវីដ - ១៩ ក្នុង នោះ គឺ មាន ការចែក ម៉ាស់ ជូន ដល់ ប្រជាពលរដ្ឋ សាធារណជន និង ភ្ញៀវ ហើយ នឹង បាន ធ្វើ អនាម័យ បាញ់ ថ្នាំ សម្លាប់ វីរុស នៅ ទីកន្លែង សំខាន់ ៗ មួយចំនួន ផងដែរ ។
រីឯ នៅ រដ្ឋបាល សាលា ខេត្ត នា ចុង សប្តាហ៍ ថ្ងៃ កន្លងទៅ នេះ បាន ធ្វើ អនាម័យ បាញ់ ថ្នាំ សម្លាប់ វីរុស នៅក្នុង បរិវេណ សាលា ខេត្ត និង តាម ទី ចាត់ការ អង្គភាព ចំណុះ ឱ្យ សាលា ខេត្ត ដើម្បី ចូលរួម អនុវត្ត នូវ អនាម័យ បរិស្ថាន ក៏ ដូចជា ការបង្ការ ទប់ស្កាត់ ករណី ឆ្លង ជំងឺ ដោយសារ មេរោគ ផ្សេង ៗ និង បង្ការ ករណី ឆ្លង ជំងឺ កូវីដ - ១៩ ផងដែរ ។
ម្យ៉ាងទៀត រដ្ឋបាល ខេត្ត និង អាជ្ញាធរ គ្រប់ ថ្នាក់ បាន សំណូម យ៉ាង ទទូច ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ កុំ ភ្លេច នូវ ៣ ចំណុច សាមញ្ញ ៗ គឺ៖ ១៖ កុំ ភ្លេច វិធានការពារ ពាក់ ម៉ាស ឬ ក្រមា ២៖ កុំ ភ្លេច ជែល អាកុល ឬ លាង ដៃ នឹង សាប៊ូ ៣៖ កុំ ភ្លេច រក្សា គម្លាត សុវត្ថិភាព និង ចៀសវាង ការជួបជុំ លក្ខណៈ ទ្រង់ទ្រាយ ធំ ដើម្បី ជា ការចូលរួម ទប់ស្កាត់ នៃ ជំងឺ កូវីដ - ១៩ នេះ កុំ ឱ្យ បន្ត ចូល សហគមន៍ ថែម ទៀត ៕
រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ថ្លែង បន្ដ ថា ការយក សំណាក លើក ទី២ សម្រាប់ ប្រជាពលរដ្ឋ ដែល បាន ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល នឹង ធ្វើឡើង ចាប់ពី ម៉ោង ៧ព្រឹក ស្អែកតទៅ ។ ចំណែក នៅ ក្រសួង មហាផ្ទៃ គឺ ក្រុមការងារ របស់ សុខាភិបាល ចំនួន ១០ក្រុម បាន នឹង កំពុង តេស្ដ សំណាក ហើយ នឹង រួចរាល់ នៅ ថ្ងៃ នេះ ផ្ទាល់ តែម្ដង សរុប តេស្ដ ប្រហែល ពី ២.០០០ - ២. ៥០០នាក់ ។
លោកស្រី បន្ដ ថា ចំពោះ មុខ នេះ យើង ដឹង ហើយ ថា យើង កំពុង ប្រយុទ្ធ ប្រឆាំង នឹង ការរាត ចូល សហគមន៍ ជំងឺ កូវីដ - ១៩ ដូច្នេះ យើង ត្រូវ រួមគ្នា ទាំងអស់ ក្រសួង សុខាភិបាល តែ មួយ ផ្នែក មិន អាច ធ្វើ បាន ទេ ដែល ទាមទារ ឱ្យ មាន សហការ គ្នា ជា ក្រុម គ្រប់ ភាគី ពាក់ព័ន្ធ ជាពិសេស គឺ ប្រជាពលរដ្ឋ តែម្ដង ។
ជាង នេះ ទៅ ទៀត ប្រជាពលរដ្ឋ ត្រូវតែ លាង សម្អាត ដៃ ឱ្យ បាន ញឹកញាប់ ពាក់ ម៉ាស និង រក្សា គម្លាត ចាប់ពី ១ម៉ែត្រ កន្លះ ឡើង ទៅ ពេល ដែល ចេញ ទៅ ក្រៅ ។ កន្លងមក អ្នកវិជ្ជមាន កូវីដ - ១៩ គឺ អត់ បាន ពាក្យ ម៉ាស ទេ ដូច្នេះ ប្រហែស តែ មួយ ភ្លាម អាច ចម្លង ជំងឺ កូវីដ នេះ ពី មនុស្ស ម្នាក់ ទៅ មនុស្ស ជាង ច្រើន នាក់ ទៀត ។
លោកស្រី រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ថ្លែង បន្ដ ថា « គួរឱ្យ សោកស្ដាយ ដែល ក្នុង ព្រឹត្ដិការណ៍ « សហគមន៍ ២៨វិច្ឆិកា » ដែល រហូតមកដល់ ពេលនេះ មាន ករណី ឆ្លង ចំនួន ៣២ ករណី ហើយ ។ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវតែ រួមគ្នា អនុវត្ដ ឱ្យ និង គោរព នូវ វិធាន សុខាភិបាល ឱ្យ បាន ម៉ត់ចត់ បើ ធ្វេសប្រហែស តែ បន្ដិច គឺ អាច ឆ្លង រីករាលដាល កាន់តែ ច្រើន » ។
លោកស្រី បញ្ជាក់ បន្ថែម ថា ជារៀងរាល់ ព្រឹក ក្រុម បច្ចេកទេស តែងតែ ប្រជុំ . ជាក់ស្ដែង នៅ ព្រឹក មិញ នេះ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ដឹកនាំ កិច្ចប្រជុំ ដោយ ផ្ទាល់ ដើម្បី អង្កេត តាមដាន នៃ ការវិវឌ្ឍ នេះ ជំងឺ នេះ ដោយ មិន មែន ពិនិត្យមើល តែ កន្លែងណា ដែល កើត ឬ ឆ្លង ហើយ នោះ ទេ គឺ ក្រសួង មាន ក្រុមការងារ បច្ចេកទេស ពិសេស ដែល រហូតមកដល់ ពេលនេះ គឺ កំពុងតែ ស្រាវជ្រាវ ជាប្រចាំ ដើម្បី រក មូលហេតុ នេះ ការចម្លង ជំងឺ កូវីដ - ១៩ នេះ ។
* យើង ត្រូវការ ច្រើន លើស ពី វ៉ាក់សាំង
៤៖ ដើម្បី ធានា និរន្តរភាព ការងារ របស់ ក្រសួង មហាផ្ទៃ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ស៊ីវិល មន្ត្រី នគរបាល ជាតិ និង មន្ត្រី ពន្ធនាគារ ដែល បម្រើ ការងារ នៅក្នុង បរិវេណ ទីស្តីការ ក្រសួង មហាផ្ទៃ ត្រូវ បំពេញ ការងារ ពី ចម្ងាយ តាមរយៈ អនឡាញ ។
៥៖ អគ្គ លេខាធិការដ្ឋាន ក្រសួង មហាផ្ទៃ ត្រូវ ប្រមូល មកវិញ នូវ ប័ណ្ណ ចេញ - ចូល ទីស្តីការ ក្រសួង មហាផ្ទៃ ដែល បាន ផ្តល់ ជូន យោង តាម សេចក្តីណែនាំ លេខ ០៥៣ ចុះ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២០ ហើយ ត្រូវ រៀបចំ ប័ណ្ណ ចេញ - ចូល ថ្មី ដើម្បី ផ្តល់ ជូន ចំពោះ តែ ថ្នាក់ដឹកនាំ និង មន្ត្រី ដែល ត្រូវបាន ចាត់ ឱ្យ មក ប្រចាំ ការ នៅ ទីស្តីការ ក្រសួង មហាផ្ទៃ ដូច បាន កំណត់ ក្នុង ចំណុច ទី៤ ខាងលើ ៕
ខាងក្រោម នេះ ជា បទបញ្ជា របស់ សម្តេច ក្រឡាហោ ម៖
ក្រសួង អប់រំ ដាក់ ចេញ វិធានការណែនាំ ៤ ចំណុច ដល់ ស្ថាប័ន អប់រំ ដើម្បី ចូលរួម បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នៃ ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ដាក់ចេញ នូវ វិធានការណែនាំ ៤ ចំណុច ផ្ញើ ជូន ដល់ ស្ថាប័ន អប់រំ ដើម្បី ចូលរួម បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នៃ ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា ។
តាម លិខិត របស់ ក្រសួង អប់រំ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៧ ខែធ្នូ នេះ បាន បញ្ជាក់ ថា ដើម្បី ចូលរួម បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នៃ ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា ក្រសួង សូម ណែនាំ នូវ វិធានការ រដ្ឋបាល និង វិធានការ សុវត្ថិភាព សុខភាព ក្នុង ការបំពេញ ការងារ ដូច ខាងក្រោម ៖
១៖ អង្គភាព ទាំងអស់ ត្រូវ ណែនាំ ដល់ បុគ្គលិក អប់រំ ក្រោម ឱវាទ ឲ្យ អនុវត្ត ការបំពេញ ការងារ ពី ចម្ងាយ ឬ អនឡាញ ក្នុង ករណី មិន មាន ការចាំបាច់ មិន ត្រូវ មកកាន់ អង្គភាព នោះ ទេ ។ បុគ្គលិក អប់រំ ត្រូវ យកចិត្តទុកដាក់ តាមដាន ព័ត៌មាន នៃ ការវិវត្ត ស្ថានភាព ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា និង មិន ត្រូវ ធ្វើដំណើរ ទៅ កន្លែង ដែល មាន ហានិភ័យ កូវីដ១៩
២៖ ក្នុង ករណី ចាំបាច់ ត្រូវ មកកាន់ អង្គភាព បុគ្គលិក អប់រំ ត្រូវ ធានា ថា ខ្លួន មាន សុខភាព ប្រក្រតី និង ត្រូវ អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ វិធានការ សុវត្ថិភាព សុខភាព ដោយ ពាក់ ម៉ាស ការពារ ជាប្រចាំ លាង សម្អាត ដៃ និង រក្សា គម្លាត សុវត្ថិភាព បុគ្គល និង សង្គម
៣៖ អង្គភាព នីមួយ ៗ ត្រូវ ចាត់ វិធានការលើកកម្ពស់ សុវត្ថិភាព សុខភាព នៅ តាម អង្គភាព ដូចជា ការវាស់ កម្ដៅ បុគ្គលិក ការចាត់ វិធានការរក្សា អនាម័យ នៅ តាម អង្គភាព និង ត្រូវ ពិចារណា ពន្យារ ពេល ឬ លើក ពេល អនុវត្ត កម្មវិធី ឬ កិច្ចប្រជុំ នានា ។
ក្នុង ករណី មិន អាច ពន្យារ ពេល ឬ លើក ពេល បាន សូម អនុវត្ត ក្នុង ទ្រង់ទ្រាយ តូច ឬ តាម ប្រព័ន្ធ អនឡាញ
៤៖ រាល់ ការស្នើសុំ យោបល់ ការឆ្លង ឯកសារ និង ការសុំ ការសម្រេច ពី ថ្នាក់ដឹកនាំ ត្រូវ អនុវត្ត តាម ប្រព័ន្ធ អនឡាញ ( ក្រុម តេឡេក្រាម )៕
អាជ្ញាធរ អូស្រ្តាលី បាន កត់សម្គាល់ ថា ស្ថានភាព បច្ចុប្បន្ន គឺ ពិតជា គ្រោះថ្នាក់ ខ្លាំង ណាស់ ហើយ ក្រុម អ្នក ពន្លត់ អគ្គិភ័យ ប្រហែលជា មិន អាច គ្រប់គ្រង ការរាល នៃ របស់ ភ្លើង ឆេះ ព្រៃ នេះ បាន ឡើយ ។ បណ្តាញ អគ្គិសនី ប្រព័ន្ធ ទឹក សេវា ទូរស័ព្ទ ចល័ត បាន ដាច់ ខណៈ ស្ថានភាព ផ្លូវថ្នល់ ស្ថិត ក្នុង សភាព គ្រោះថ្នាក់ ជាខ្លាំង ចំពោះ ការធ្វើដំណើរ ។
( ភ្នំពេញ ) ៖ អភិបាល ខណ្ឌ ឫស្សីកែវ លោក ជា ពិសី បាន បន្ត ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ ចុះ ផ្សព្វផ្សាយ ពី វិធានការ ការពារ បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជម្ងឺ កូវីដ១៩ ។
លើស ពី នេះ លោក ជា ពិសី ក៏ បាន នាំយក ម៉ាស របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា មក ចែកជូន ដល់ ប្រជាពលរដ្ឋ និអាជីវករ ផងដែរ ស្ថិត នៅ ផ្សារ ឆេកូ សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ នា ព្រឹក ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ។
លោក អភិបាល ខណ្ឌ ឫស្សីកែវ បញ្ជាក់ ថា តាម អនុសាស ន៏ ដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ទាំង១០ ចំណុច របស់ សម្តេច តេជោ ហ៊ុន សែន នៃ ព្រឹត្តិការណ៍ « សហគមន៍ ២៨ វិច្ឆិកា » ស្ដីពី ការទប់ស្កាត់ ការឆ្លង មេរោគ កូវីដ - ១៩ ដែល បាន ដាក់ចេញ កាលពី ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២០ រួម មាន៖
( កំពង់ឆ្នាំង ) ៖ អំពើ ឃាតកម្ម ដែល បាន កើតឡើង លើ យុវតី ជា សិស្ស ថ្នាក់ ទី ១២ ម្នាក់ នៅ ភូមិ អ្នកតា រង ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៍ ខេត្ត កំពង់ឆ្នាំង ពេល កំពុង ជិះ ទូក ទៅ រៀន ថែម ម៉ោង ត្រៀម ប្រឡង បាក់ឌុប ត្រូវ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ឆ្នាំង កោះហៅ សាក្សី ២នាក់ ដើម្បី មក ធ្វើ ការសួរនាំ អំពី រឿង ហេតុ ទាំងអស់ នេះ ។
សេចក្ដីរាយការណ៍ ពី ភ្នាក់ងារ Fresh News បាន ឲ្យដឹង ថា សាក្សី ទាំង ពីរ នាក់ ដែល សមត្ថកិច្ច កោះហៅ មក សួរ នាំ នៅ ថ្ងៃទី ០៥ ខែធ្នូ ឆ្នាំ ២០២០ ដែល ដឹកនាំ ប្រតិបត្តិការ ដោយ លោក វរសេនីយ៍ ទោ ហង្ស សុជាតិ មេបញ្ជាការ រង អាវុធហត្ថ ខេត្ត កំពង់ឆ្នាំង ទទួល ផែន យុត្តិធម៌ និង ដោយ មាន ការសម្របសម្រួល ពី លោក អ៉ិត សុធា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ។
សាក្សី ទាំង ពីរ នាក់ នោះ រួម មាន ទី១៖ ឈ្មោះ កាន់ ឈុន ឡេង អាយុ ៣៦ ឆ្នាំ ទីលំនៅ ភូមិ កំពង់ថ្គោល ឃុំ ផ្សារ ចំបក់ ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ និង ទី២៖ ឈ្មោះ ល ន សុខ ឡូត អាយុ ២២ ឆ្នាំ ទីលំនៅ ភូមិ ផាត់ សណ្តាយ ឃុំ សណ្តាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ដែល ជាប់សង្ស័យ ពាក់ព័ន្ធ ករណី ឃាតកម្ម កាលពី ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២០ ។ ក្រោយ បញ្ចប់ ការសួរនាំ សាក្សី ទាំង ពីរ នេះ ត្រូវបាន សមត្ថកិច្ច អនុញ្ញាតឲ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ផងដែរ ។
សូម រំលឹក ថា យុវតី ម្នាក់ ជា សិស្ស ថ្នាក់ ទី១២ នៅ វិទ្យាល័យ ហ៊ុន សែន បរិបូណ៌ បើក កាណូត ទៅ រៀន ស្រាប់តែ បាត់ខ្លួន មួយ ថ្ងៃ មិន ឃើញ ត្រឡប់មក ផ្ទះ លុះ ព្រឹកឡើង ត្រូវបាន គេ ឃើញ សព អណ្ដែត ទឹក ។ ហេតុការណ៍ នេះ បាន បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល នៅ ព្រឹក ថ្ងៃទី ០៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ នៅ ចំណុច ផ្លូវ ថ្មី ភូមិ អ្នកតា តាង ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ។
បើ តាម ប្រភព ពី ម្ដាយ ក្មេងស្រី រងគ្រោះ បាន ឲ្យដឹង ថា បច្ចុប្បន្ន គាត់ មាន ទីលំនៅ ក្នុង ភូមិ ឆ្នុក ទ្រូ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង កូនស្រី របស់ គាត់ មាន ឈ្មោះ ឡាំ រដ្ឋា អាយុ១៩ ឆ្នាំ រៀន ថ្នាក់ ទី១២ រៀន នៅ វិទ្យាល័យ ហ៊ុន សែន បរិបូណ៌ ។
( ភ្នំពេញ ) ៖ មេធាវី តំណាង អោយ ក្រុមហ៊ុន ស៊ីង បាយ អូ ថេក ខូអិលធីឌី បាន ចេញ លិខិត បំភ្លឺ ជា ផ្លូវការ មួយ ពាក់ព័ន្ធ ទៅនឹង បណ្ដាញ ព័ត៌មាន អនឡាញ មួយចំនួន បាន ធ្វើ ការផ្សព្វផ្សាយ ចោទប្រកាន់ មក លើ ក្រុមហ៊ុន ថា បាន កែន ប្រជាពលរដ្ឋ ពី បណ្ដាល ខេត្ត ផ្សេង ៗ ប្រដាប់ ដោយ រណា យន្ត គោយន្ត កន្ទ្រៃ យ៏ និង រទេះ គោ រាប់ រយ គ្រឿង និង ឃុបឃិត គ្នា ជាមួយ មន្ត្រី អភិរក្ស បរិស្ថាន ទៅ កាប់ ឈើ ពី តំបន់ ព្រៃឡង់ ដឹក យកមក លក់ អោយ ក្រុមហ៊ុន ដែល ការផ្សព្វផ្សាយ ព័ត៌មាន ខាងលើ វា មិន មែន ជា ការពិត ឡើយ ។
យោង លិខិត បំភ្លឺ បាន អោយ ដឹង ថា ក្រុមហ៊ុន ស៊ីង បាយ អូ ថេក ជា ក្រុមហ៊ុន វិនិយោគ សហការ ជាមួយ រដ្ឋបាល ព្រៃឈើ ក្រសួង កសិកម្ម រុក្ខា ប្រម៉ាញ់ និង នេសាទ ។
បច្ចុប្បន្ន ក្រុមហ៊ុន កំពុង ធ្វើ ការឈូសឆាយ ដី ព្រៃ រិច រិល ដែល ទទួលបាន ច្បាប់ ពី ក្រសួង កសិកម្ម នៅក្នុង ខេត្ត ក្រចេះ និង ស្ទឹងត្រែង ដើម្បី ដាំ កូន ឈើ ឡើងវិញ ឲ្យ គ្រប់ តាម ផែនការ ចំនួន ៨០០០ ហិកតា នៅ ឆ្នាំ ២០២១ ខាងមុខ នេះ ។ ការឈូសឆាយ ដី ព្រៃ រិច រិល ដើម្បី ដាំ កូន ឈើ ឡើងវិញ នេះ ក្រុមហ៊ុន ក៏ ប្រមូល បាន ផល អនុផល ព្រៃឈើ នៅលើ ផ្ទៃដី ខាងលើ នេះ រួម មាន ឈើ អុស និង ឈើ ក្រៅ លំដាប់ថ្នាក់ ដើម្បី លក់ យក ថវិកា បង់ ពន្ធ ជូន រដ្ឋ ផងដែរ ៕
ខាងក្រោម នេះ ជា លិខិត បំភ្លឺ ជាសាធារណៈ របស់ ក្រុមហ៊ុន ស៊ីង បាយ អូ ថេ ក៖
រដ្ឋបាល ខណ្ឌ ចំកាមន បើក យុទ្ធនាការ ផ្សព្វផ្សាយ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ក្នុង សហគមន៍
តាមរយៈ យុទ្ធនាការ នេះ បាន បង្ហាញ ឱ្យ ឃើញ ពី កម្លាំង ចលករ ដ៏ សស្រាក់សស្រាំ របស់ ថ្នាក់ដឹកនាំ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ ជាន់ ថ្នាក់ ដើម្បី ដាស់ រំលឹក ដល់ ប្រជាពលរដ្ឋ កុំ ភ្លេច ស្មារតី ឱ្យ មាន ការប្រុងប្រយ័ត្ន ជាប់ ជានិច្ច និង ចូលរួម ទាំងអស់ គ្នា ក្នុង ការប្រយុទ្ធ ប្រឆាំង ទប់ស្កាត់ និង ការពារ ខ្លួន ការពារ គ្រួសារ សហគមន៍ និង ប្រទេសជាតិ ក្នុង គ្រា កំពុង ជួប នូវ ជំងឺ រាត្បាត ដ៏ កាច សាហាវ មួយ នេះ នៅក្នុង សហគមន៍ ។
មុនពេល ចេញ ក្បួន យុទ្ធនាការ ផ្សព្វផ្សាយ នេះ លោក ថេង សុថុល អភិបាល ខណ្ឌ ចំការមន ក៏ បាន ក្រើន រំឮក ដល់ មន្រ្តី របស់ ខ្លួន ឱ្យ មាន ការប្រុងប្រយ័ត្ន ជាប់ ជានិច្ច រក្សា គម្លាត សង្គម យ៉ាងតិច ១.៥ម៉ែត្រ ហើយ ធ្វើ នាំគ្នា ធ្វើ ប្រតិបត្តិការណ៍ ឱ្យ បាន គ្រប់ ច្រកល្ហក នៅក្នុង មូលដ្ឋាន សង្កាត់ ទាំង៥ នៃ ខណ្ឌ ចំការមន ។
បន្ថែម ពី នេះ លោក ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ស្វែងយល់ នូវ ព័ត៌មាន ទាក់ទិន វិធានការណ៍ ការពារ ទប់ស្កាត់ ជំងឺ ផ្លូវ ដង្ហើម មួយ នេះ ឱ្យ បាន ល្អិតល្អន់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល នឹង រួមគ្នា ឆ្លង ឱ្យ ផុត ពី គ្រា ដ៏ អាសន្ន មួយ នេះ ។
យ៉ាងណា លោក អភិបាល ខណ្ឌ បាន បញ្ជាក់ ថា យុទ្ធនាការ ផ្សព្វផ្សាយ នេះ នឹង បន្ត ធ្វើជា ប្រចាំ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន រហូត ទទួលបាន ការណែនាំ ជាថ្មី ពី អភិបាល រាជធានី ភ្នំពេញ ក្រោយពេល ស្ថានភាព នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ មាន ភាពធូស្រាល ឡើងវិញ ៕
បញ្ជូន ជនសង្ស័យ ៤នាក់ និង វត្ថុតាង គ្រឿងញៀន ទៅ តុលាការ ខេត្ត ស្វាយរៀង ដើម្បី ចាត់ការ តាម ច្បាប់
( ស្វាយរៀង ) ៖ ជនសង្ស័យ ជា មុខសញ្ញា ជួញដូរ និង ប្រើប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ចំនួន ៤នាក់ ស្រី ១នាក់ រួម ជាមួយ វត្ថុតាង ត្រូវបាន កម្លាំង ជំនាញ ផែនការងារ ប្រឆាំង គ្រឿងញៀន នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ស្វាយរៀង បញ្ជូន ទៅកាន់ សាលាដំបូង ខេត្ត ដើម្បី ចាត់ការ បន្ត តាម ច្បាប់ នៅ រសៀល ថ្ងៃទី ០៦ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
សមត្ថកិច្ច បាន បន្ត ថា កម្លាំង ជំនាញ បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៤នាក់ មាន៖
( ស្វាយរៀង ) ៖ អាជ្ញាធរ ស្រុក ក្រុង ទាំង ៨ នៅ ខេត្ត ស្វាយរៀង និង ក្រុម យុវជន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត កំពុង បើក យុទ្ធនាការចុះ បាញ់ ថ្នាំ សម្លាប់ មេរោគ ដើម្បី ការពារ ជំងឺ ឆ្លង ផ្សេង ៗ ពិសេស ផ្សព្វផ្សាយ អំពី វិធានការ ការពារ ជំងឺ ឆ្លង កូវីដ - ១៩ របស់ ក្រសួង សុខាភិបាល ការណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក៏ ដូច សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង ។
សកម្មភាព ចុះ អប់រំ ផ្សា ព្វផ្សាយ អំពី វិធានការ សុខាភិបាល ជូន ដល់ ប្រជាពលរដ្ឋ រួម មាន៖
ទី ១៖ ក្រុង ស្វាយរៀ ដោយ លោក អភិបាល ក្រុង មន្ត្រី ពាក់ព័ន្ធ អាជ្ញាធរ មូលដ្ឋាន ដឹកនាំ ក្រុមការងារ ចុះ បាញ់ ថ្នាំ សម្លាប់ មេរោគ ដើម្បី ការពារ ជំងឺ ឆ្លង ផ្សេង ៗ ពិសេស ការពារ ជំងឺ ឆ្លង កូវីដ - ១៩ នៅក្នុង អគារ និង បរិវេណ សាលាក្រុង ស្វាយរៀង សួន កុមារ ផ្សារ ពោធិតា ហោ និង ផ្សារ វាល យន្ត ក្រុង ស្វាយរៀង ។
ទី ២៖ ស្រុក ស្វាយទាប អាជ្ញាធរ មូលដ្ឋាន មន្ត្រីរាជការ សមត្ថកិច្ច ពាក់ព័ន្ធ និង យុវជន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ស្រុក បាន ចុះ ផ្សព្វផ្សាយ ចែក ខិត្តប័ណ្ណ អំពី វិធានការ ការពារ ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ នៅ តាម បណ្ដា មូលដ្ឋាន ក្នុង ស្រុក ។
ទី ៣៖ ស្រុក រំដួល សកម្មភាព ថ្នាក់ដឹកនាំ មន្ត្រី សុខាភិបាល មន្ត្រីរាជការ សមត្ថកិច្ច ពាក់ព័ន្ធ និង យុវជន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ស្រុក រំដួល ចុះ ផ្សព្វផ្សាយ ចែក ខិត្តប័ណ្ណ អំពី វិធានការ ការពារ ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ និង ចែក ម៉ាស ជូន ប្រជាពលរដ្ឋ និង អាជីវករ នៅ តាម ទីប្រជុំជន ផ្សារ និង បណ្ដា មូលដ្ឋាន ក្នុង ស្រុក ។
និង ទី៤៖ ក្រុង បាវិត អាជ្ញាធរ មន្ត្រីរាជការ និង សមត្ថកិច្ច ពាក់ព័ន្ធ នៅ ក្រុង បាន ចុះ ផ្សព្វផ្សាយ ចែក ខិត្តប័ណ្ណ អំពី វិធានការ ការពារ ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ និង ណែនាំ ឱ្យ បុគ្គលិក សណ្ឋាគារ ភោជនីយដ្ឋាន អាជីវករ លក់ដូរ ត្រូវ ពាក់ ម៉ាស និង ដាក់ អាល់កុល ឬ ជែល លាង ដៃ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ចំណែកឯ ស្រុក ចំនួន ៤ទៀត អាជ្ញាធរ និង មន្ត្រី ពាក់ព័ន្ធ ព្រមទាំង យុវជន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ស្រុក ក៏ បាន កំពុង ដឹកនាំ អនុវត្ត វិធានការចុះ ផ្សព្វផ្សាយ ចែក ខិតប័ណ្ណ ដល់ ប្រជាពលរដ្ឋ ឱ្យ បាន យល់ដឹង អំពី វិធានការ ការពារ នៃ ជំងឺ កូវីដ - ១៩ ផងដែរ ។
អភិបាល ខណ្ឌ ឫស្សីកែ វ៖ ភោជនីយដ្ឋាន អាហារដ្ឋាន និង អតីត ទីតាំង ខារ៉ាអូខេ ប្រែក្លាយជា ភោជនីយដ្ឋាន ចំនួន ១៣កន្លែង ត្រូវ បន្ត ត្រួតពិនិត្យ ដើម្បី ទប់ស្កាត់ ការឆ្លង ជម្ងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ អភិបាល ខណ្ឌ ឫស្សីកែវ លោក ជា ពិសី បាន ចាត់ ឲ្យ លោកស្រី សួស សូលីដា អភិបាល រង ខណ្ឌ ដឹកនាំ កម្លាំង គណៈ បញ្ជាការ ឯកភាព បន្ត ចុះ ត្រួតពិនិត្យ ជាក់ស្ដែង លើ ទីតាំង ភោជនីយដ្ឋាន អាហារដ្ឋាន និង អតីត ទីតាំង ខារ៉ាអូខេ ដែល ត្រូវ ប្រែក្លាយជា ភោជនីយដ្ឋាន ចំនួន ១៣កន្លែង ។
ប៉ុន្តែ ទីតាំង ខ្លះ បាន ផ្អាក អាជីវកម្ម និង ខ្លះ ទៀត បាន ធ្វើ កិច្ចសន្យា និង កំណត់ហេតុ ឲ្យ បើក ដំណើរការ ជាធម្មតា តែ ត្រូវ រក្សា គម្លាត សុវត្ថិភាព របស់ អតិថិជន ក្នុង ការចូលរួម ទប់ស្កាត់ ការរីករាលដាល ឆ្លង ជម្ងឺ កូវីដ១៩ តាម សេចក្តីណែនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ក្រសួង សុខាភិបាល នៃ ការអនុវត្ត ឲ្យ មាន ប្រសិទ្ធភាព តាម ប្រសាសន៍ ដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
យុទ្ធនាការ របស់ គណៈ បញ្ជាការ ឯកភាព នៃ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ ក្នុង ការបន្ត ចុះ ត្រួតពិនិត្យ ជាក់ស្ដែង លើ ទីតាំង ភោជនីយដ្ឋាន អាហារដ្ឋាន និង អតីត ទីតាំង ខារ៉ាអូខេ ដែល ត្រូវ ប្រែក្លាយជា ភោជនីយដ្ឋាន ចំនួន ១៣កន្លែង ក្នុង ការចូលរួម ទប់ស្កាត់ ការរីករាលដាល ឆ្លង ជម្ងឺ កូវីដ១៩ នេះ បាន អនុវត្ត ឡើង ៤សង្កាត់ ក្នុង ចំណោម សង្កាត់ ៧ នៃ ខណ្ឌ ឫស្សីកែវ មាន សង្កាត់ ទួល សង្កែ ទី១. សង្កាត់ ស្វាយប៉ាក . សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ និង សង្កាត់ ប្ញស្សីកែវ នៅ យប់ ថ្ងៃទី ០៦ ខែធ្នូ ឆ្នាំ ២០២០ ។
បន្ថែម ពី នេះ ក្នុង នាម គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ បាន ណែនាំ ដោយ ធ្វើ កិច្ចសន្យា ម្ចាស់ ទីតាំង ភោជនីយដ្ឋាន អាហារដ្ឋាន និង អតីត ទីតាំង ខារ៉ាអូខេ ដែល ត្រូវ ប្រែក្លាយជា ភោជនីយដ្ឋាន ត្រូវតែ អនុវត្ត បាន ខ្ជាប់ខ្ជួន តាម ការណែនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ និង សេចក្ដីណែនាំ របស់ ក្រសួង សុខាភិបាល ឲ្យបាន ត្រឹមត្រូវ ដើម្បី ចូលរួម បង្ការ ការពារ និង ទប់ស្កាត់ ការរីករាលដាល ឆ្លង ជម្ងឺ កូវីដ១៩ និង ចូលរួម បញ្ចប់ អោយ បាន នូវ ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា ៕
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដោយ អនុវត្ត តាម អនុសាសន៍ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន បញ្ជា ទៅ អាជ្ញាធរ និង សមត្ថកិច្ច រាជធានី ភ្នំពេញ ត្រូវ ចុះ ពិនិត្យមើល ទីតាំង ប្រកប អាជីវកម្ម ផ្សេង ៗ ក្នុង មូលដ្ឋាន ដើម្បី បន្ដ ចូលរួម ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ - ១៩ ។
