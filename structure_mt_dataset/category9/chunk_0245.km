( ភ្នំពេញ ) ៖ មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ពន្យល់ អំពី មូលហេតុ ដែល នាំឲ្យ តម្លៃ ស្រូវ នៅក្នុង ស្រុក មាន ការធ្លាក់ចុះ ដែល ជា កង្វល់ របស់ ប្រជាកសិករ ខណៈ ក្រសួង ក៏ ដូចជា ស្ថាប័ន ពាក់ព័ន្ធ កំពុង ធ្វើ ការរួមគ្នា លើ បញ្ហា នេះ ដើម្បី ស្វែងរក ដំណោះស្រាយ ជូន កសិករ ។
លោក ងិន ឆាយ ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន កសិកម្ម បាន គូសបញ្ជាក់ ថា ការធ្លាក់ចុះ តម្លៃ ស្រូវ គឺ បណ្ដាល មកពី កត្តា ច្រើន យ៉ាង ។ លោក ថា កត្តា ផ្គត់ផ្គង់ និង កត្ដា តម្រូវការ . កត្តា ទីផ្សារ . កត្តា អាកាសធាតុ និង កត្តា គុណភាព ទើប បណ្ដាលឲ្យ តម្លៃ ស្រូវ មាន ការប្រែប្រួល ។
ក្នុង សន្និសីទ សារព័ត៌មាន ដែល រៀបចំ ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ស្ដីពី « កិច្ចអន្ដរាគមន៍ ឆ្លើយតប នឹង ស្ដារ ឡើងវិញ បន្ទាប់ពី គ្រោះមហន្ដរាយ ទឹក ជំនន់ ក្នុង ផលិតកម្ម កសិកម្ម » លោក ងិន ឆាយ បាន លើកឡើង ថា ជារៀងរាល់ ឆ្នាំ ឲ្យ តែ ដល់ រដូវ ប្រមូល ផល ស្រូវ គឺ តម្លៃ តែងតែ មាន ការធ្លាក់ចុះ ព្រោះ ការផ្គត់ផ្គង់ មាន ច្រើន ហើយ ការប្រមូល ទិញ មិន អស់ ឬ ការកែច្នៃ សម្រាប់ ការនាំចេញ មិន អស់ លទ្ធភាព ។
ដោយឡែក កត្តា អាកាសធាតុ វិញ ក៏ បណ្ដាលឲ្យ គុណភាព ស្រូវ មាន ការធ្លាក់ចុះ ហើយ បើ កាលណា គុណភាព ស្រូវ ធ្លាក់ចុះ ដូចគ្នា ដែរ ។ ចំណុច នេះ លោក អះអាង ថា ស្រូវ ដែល ធ្លាក់ ថ្លៃ ជាង គេ គឺ ស្រូវ ផ្កា រំដួល ព្រោះ ស្រូវ ប្រភេទ នេះ រងគ្រោះ ដោយ ទឹក ជំនន់ ច្រើន ។
ទន្ទឹមនឹង អ្វី ដែល ជា ប្រឈម ទាំងអស់ នេះ លោក ងិន ឆាយ បាន អះអាង ថា ក្រសួង កសិកម្ម នឹង ព្យាយាម សម្របសម្រួល ជាពិសេស ក្រសួង ត្រូវ ធ្វើការ ជាមួយ សហព័ន្ធ ស្រូវ អង្ករ និង ក្រសួង ពាណិជ្ជកម្ម ។ លោក បញ្ជាក់ ថា មន្ដ្រី ជំនាញ បាន សម្របសម្រួល ជាមួយ អ្នក ដែល ប្រមូល ទិញ សូម ព្យាយាម ជួយ ទិញ កសិករ ឲ្យបាន ច្រើន ហើយ កុំ ទម្លាក់ ថ្លៃ ខ្លាំង ពេក ទោះបី ស្រូវ របស់ គាត់ មាន គុណភាព ដោយសារ កត្តា អាកាសធាតុ បន្ដិច បន្ទួច ក៏ដោយ ។
ក្រុម ចលនា និស្សិត របស់ ថៃ បាន ធ្វើ ការតវ៉ា អស់ ជាច្រើន ខែ មក ហើយ ដោយ ក្នុង នោះ សញ្ញា ម្រាម ដៃ បី របស់ ពួកគេ នៅតែ ត្រូវបាន ប្រើប្រាស់ ដើម្បី ទាមទារ ចំណុច សំខាន់ ៗ ចំនួន ០៣ ដោយ ទី មួយ គឺ លោក ប្រាយុទ្ធ ចាញ់ អូចា ត្រូវ ចុះចេញ ពី តំណែង នាយក រដ្ឋមន្ត្រី . ទី ពីរ គឺ ការកែប្រែ រដ្ឋធម្មនុញ្ញ ឲ្យ ដូច មុន ឆ្នាំ ២០១៩ និង ទី ៣ គឺ ការធ្វើ កំណែទម្រង់ រាជានិយម ដែល ផ្តល់ អំណាច ជ្រុល ពេក ដល់ ព្រះមហាក្សត្រ បច្ចុប្បន្ន ៕
ប្រតិកម្ម របស់ អ្នកនាំពាក្យ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ធ្វើឡើង ក្រោយ លោកស្រី រ៉ូណា ស្មីត បាន ចេញ សេចក្ដីថ្លែងការណ៍ មួយ ដោយ ចាត់ទុក ថា ការជំនុំជម្រះ ក្ដី ទ្រង់ទ្រាយ ធំ ទៅ លើ សកម្មជន អតីត គណបក្ស សង្គ្រោះ ជាតិ ២ ថ្ងៃ នេះ ទំនងជា កើត ចេញពី ហេតុផល នយោបាយ ខ្វះ មូលដ្ឋាន ច្បាប់ ច្បាស់លាស់ និង ជា ការរំលោភ យ៉ាង ធ្ងន់ធ្ងរ ទៅ លើ សិទ្ធិ ទទួលបាន នីតិវិធី ត្រឹមត្រូវ ដែល បាន បង្កើតឡើង យ៉ាង រឹងមាំ ដោយ ច្បាប់ សិទ្ធិ មនុស្ស អន្តរជាតិ ។
ឆ្លើយតប នឹង ការចោទប្រកាន់ នេះ លោក ជិន ម៉ាលី ន បាន បកស្រាយ ៣ចំណុច ដូចត ទៅ៖
កិច្ចប្រជុំ ខាងលើ នេះ រៀបចំ ធ្វើ តាម ប្រព័ន្ធ វីដេអូ និង ដោយ មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា MRC ថ្នាក់ រដ្ឋមន្រ្តី នៃ ប្រទេស ជា សមាជិក MRC ៣ផ្សេង ទៀត រួម មាន៖ ឡាវ ថៃ និង វៀតណាម តំណាង នៃ ប្រទេស ដៃ គូ អភិវឌ្ឍន៍ ប្រទេស ដៃ គូ សន្ទនា ( ចិន មីយ៉ាន់ម៉ា ) និង អង្គការ តំបន់ និង អន្តរជាតិ ពាក់ព័ន្ធ ព្រមទាំង មន្រ្តី នៃ លេខាធិការដ្ឋាន MRC សរុប ចំនួន ១៥៧ រូប ។
កិច្ចប្រជុំ ខាងលើ បាន ពិនិត្យ ពិភាក្សា លើ វឌ្ឍនភាព នៃ កិច្ចសហប្រតិបត្តិការ តំបន់ . ការអនុវត្ត នីតិវិធី ស្តីពី ការគ្រប់គ្រង ការប្រើប្រាស់ ទឹក . ស្ថានភាព ជលសាស្រ្ត ក្នុង អាង ទន្លេ មេគង្គ ក្រោម . ការពិនិត្យ តាមដាន ទន្លេ និង កិច្ចការ ពាក់ព័ន្ធ សំខាន់ ផ្សេង ទៀត ។
កិច្ចប្រជុំ ក៏ បាន ពិនិត្យ អនុម័ត ឯកសារ សំខាន់ ៗ មួយចំនួន របស់ MRC ដូច ជា៖ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ អាង ឆ្នាំ ២០២១ - ២០៣០ និង ផែនការ យុទ្ធសាស្រ្ត ឆ្នាំ ២០២១ - ២០២៥ . យុទ្ធសាស្រ្ត គ្រប់គ្រង បរិស្ថាន . ផែនការ មេ ផ្នែក នាវាចរណ៍ . ផែនការការងារ MRC សម្រាប់ ឆ្នាំ ២០២០ - ២០២១ និង លក្ខន្តិកៈ ការងារ សម្រាប់ ប៉ុស្ត នាយក ប្រតិបត្តិ នៃ លេខាធិការដ្ឋាន MRC ដែល នឹង ជ្រើសរើស ចេញ ពី ប្រទេស ឡាវ សម្រាប់ អណត្តិ ០៣ ឆ្នាំ បន្ត ពី ឆ្នាំ ២០២២ ដល់ ឆ្នាំ ២០២៤ ។
ឯកសារ យុទ្ធសាស្រ្ត ក៏ ដូចជា ផែនការការងារ ដែល បាន អនុម័ត ដោយ ក្រុមប្រឹក្សា នា ពេលនេះ គឺ បាន កំណត់ នូវ អាទិភាព និង សកម្មភាព ជា យុទ្ធសាស្រ្ត ដែល MRC ត្រូវ អនុវត្ត ដើម្បី បន្ត លើកកម្ពស់ កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា ក៏ ដូចជា កិច្ចសហប្រតិបត្តិការ តំបន់ ឲ្យបាន កាន់តែ រឹង មំា និង ប្រសើរ ថែម ទៀត ដើម្បី គិតគូរ ដោះស្រាយ បញ្ហា ប្រឈម នានា ឲ្យ មាន ប្រសិទ្ធភាព និង ដើម្បី ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ក្នុង អាង ទន្លេ មេគង្គ ។
លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បាន លើកឡើង ពី វឌ្ឍនភាព លើ វិស័យ ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ នៅ កម្ពុជា ដែល កើត ចេញ ពី ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង កម្ពុជា និង កូរ៉េ ខាងត្បូង តាំងពី ភ្ជាប់ ទំនាក់ទំនង ការទូត ជាមួយគ្នា នៅ ឆ្នាំ ១៩៩៧មក ។
លោក បាន បញ្ជាក់ បន្ថែម អំពី កិច្ចសហប្រតិបត្តិការ នា ពេល កន្លងមក រវាង កម្ពុជា និង សាធារណរដ្ឋ កូរ៉េ ក្នុង នោះ បាន ជំរុញ ទំហំ ពាណិជ្ជកម្ម កម្ពុជា - កូរ៉េ ក្នុង ឆ្នាំ ២០១៩ ឱ្យ ឈានដល់ ជាង ១.៥០០ លាន ដុល្លារ អាមេរិក ។ ទុន វិនិយោគ មកពី ប្រទេស កូរ៉េ នៅ កម្ពុជា មាន តម្លៃ ជាង ៥ ពាន់ លាន ដុល្លារ អាមេរិក គិត មកដល់ ពេល បច្ចុប្បន្ន នេះ និង បាន ធ្វើឲ្យ កូរ៉េ ក្លាយជា ប្រទេស ទី២ ក្នុង ការវិនិយោគ នៅ កម្ពុជា ។
លោក បាន បន្ត ថា កម្ពុជា និង កូរ៉េ កំពុង ចរចា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ដើម្បី ឈាន ទៅ ចុះហត្ថលេខា ដាក់ ឱ្យ ដំណើរការ ជាធរមាន នា ពេល ឆាប់ ៗ នេះ ។ កិច្ចព្រមព្រៀង នេះ នឹង ជំរុញ ឱ្យ ទំហំ ពាណិជ្ជកម្ម និង ការវិនិយោគ កាន់តែ មាន ការកើនឡើង ហើយ វិនិយោគិន កូរ៉េ ក៏ នឹង មក កម្ពុជា បន្ថែម ដើម្បី ស្វែងរក ឱកាស វិនិយោគ ក្នុង វិស័យ ជាច្រើន ទៀត ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ទៅ លោក ឯក អគ្គ រដ្ឋទូត ថា ក្រសួង ការងារ នឹង ខិតខំ ពិនិត្យ ដោះស្រាយ គាំទ្រ ឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត ទៅ លើ កិច្ច សម្រួល ពាណិជ្ជកម្ម នានា ពាក់ព័ន្ធ ទៅនឹង អ្នក វិនិយោទុន កូរ៉េ ដែល មាន បំណង ចូលមក ធ្វើ ការ វិនិយោគ នៅ កម្ពុជា ។
ពាក់ព័ន្ធ នឹង ការបញ្ជូន - ទទួល ពលករ កម្ពុជា ធ្វើការ នៅ ប្រទេស កូរ៉េ ឯកឧត្តម បណ្ឌិត រដ្ឋមន្ត្រី បាន លើកឡើង ថា បន្ទាប់ពី ស្ថានភាព កូវីដ - ១៩ នៅ ប្រទេស កូរ៉េ មាន ភាពធូរស្រាល ដែល អាច ទទួលយក កម្លាំង ពលកម្ម បរទេស បាន កម្ពុជា រំពឹង ថា នឹង ក្លាយជា ប្រទេស អាទិភាព មួយ ក្នុង ចំណោម ប្រទេស ចំនួន ១៥ ផ្សេង ទៀត ដោយសារ កម្ពុជា មាន ស្ថានភាព កូវីដល្អ ប្រសើរ មាន ជើងហោះហើរ ច្រើន ។
លោក ឯក អគ្គ រដ្ឋទូត សាធារណរដ្ឋ កូរ៉េ បាន លើកឡើង ថា នៅក្នុង ឆ្នាំ ២០១៩ ពលករ កម្ពុជា មាន ចំនួន ច្រើន ជាង គេ ក្នុង ចំណោម ពលករ ដែល ធ្វើការ នៅ ប្រទេស កូរ៉េ ហើយ ក្នុង ដំណាក់កាល ជំងឺ កូវីដ - ១៩ ឆ្នាំ ២០២០ នេះ រដ្ឋាភិបាល សាធារណរដ្ឋ កូរ៉េ នៅតែ អនុញ្ញាត ទទួល ពលករ កម្ពុជា ដដែល ។
លោក បាន បញ្ជាក់ ថា « មូលហេតុ ដែល កូរ៉េ អនុញ្ញាត ទទួល ពលករ កម្ពុជា យ៉ាង ដូច្នេះ គឺ ដោយសារ និយោជក មាន ការពេញចិត្ត នឹង សមត្ថភាព ខ្ពស់ របស់ ពលករ កម្ពុជា មាន ភាពស្មោះត្រង់ នឹង ការងារ និង អនុវត្ត តាម ការណែនាំ របស់ ផ្នែក សុខាភិបាល របស់ រដ្ឋាភិបាល កូរ៉េ បាន យ៉ាង ហ្មត់ចត់ » ។
សូម ជម្រាប ថា ចាប់ពី ឆ្នាំ ២០០៧មក កម្ពុជា បាន បញ្ជូន ពលករ សរុប ៦៨.២៩៤ នាក់ ( ស្រី ១៤.២៥៥ នាក់ ) ឱ្យ ទៅ ធ្វើការ នៅ ប្រទេស កូរ៉េ ដែល រួម មាន វិស័យ ឧស្សាហកម្ម កសិកម្ម និង សំណង់ ដែល អាណត្តិ ការងារ មាន រយៈពេល ៤ ឆ្នាំ ១០ ខែ ខណៈពេល បច្ចុប្បន្ន ពលករ កម្ពុជា ដែល កំពុង ធ្វើការ នៅ កូរ៉េ មាន ចំនួន ជិត ៥០.០០០ នាក់ ៕
អភិបាល ខេត្ត ត្បូង ឃ្មុំ៖ ទោះ កម្ពុជា ជួប វិបត្តិ កូវីដ១៩ ក៏ គម្រោង សាងសង់ នៅតែ ដំណើរការអភិវឌ្ឍ ពិសេស បញ្ហា ប្រឈម ពលរដ្ឋ ត្រូវបាន ដោះស្រាយ ជា អទិភាព
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន លើកឡើង ថា ទោះបី កម្ពុជា ជួប វិបត្តិ កូវីដ១៩ ក៏ គម្រោង សាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ នានា របស់ រាជ រដ្ឋាភិបាល និង រដ្ឋបាល ខេត្ត នៅតែ ដំណើរការអភិវឌ្ឍ ទៅ មុខ ជាលំដាប់ ពិសេស បញ្ហា ប្រឈម ពលរដ្ឋ ត្រូវបាន ដោះស្រាយ ជូន ជា អទិភាព តាម លំដាប់លំដោយ ។
លោក បណ្ឌិត លើកឡើង បែប នេះ នា ព្រឹក ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ក្នុង ឱកាស លោក និង លោក ស៊ាក ឡេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បើក វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា ខេត្ត ត្បូងឃ្មុំ អាណត្តិ ទី៣ នៅ ស្រុក អូរ រាំង ឪ ។
វេទិកា ផ្សព្វផ្សាយ នោះ ធ្វើឡើង បរិវេណ វត្ត ដំរិល ក្នុង ឃុំ ដំរិល ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ សមាជិក សមាជិកា ក្រុមប្រឹក្សា ខេត្ត ថ្នាក់ដឹកនាំ សាលា ខេត្ត ប្រធាន / អនុប្រធាន មន្ទីរ - អង្គភាព ជុំវិញ ខេត្ត អាជ្ញាធរ មូលដ្ឋាន និង តំណាង ប្រជាពលរដ្ឋ ។
នា ឱកាស នោះ លោក ស៊ាក ឡេង បាន បញ្ជាក់ ថា ផងដែរ ថា វេទិកា ពិគ្រោះយោបល់ អាណត្តិ ទី៣ ឆ្នាំ ២០២០ របស់ ក្រុមប្រឹក្សា ខេត្ត ត្បូងឃ្មុំ ពិតជា មាន សារៈសំខាន់ ខ្លាំង ណាស់ ព្រោះ វេទិកា នេះ បាន ផ្តល់ ព័ត៌មាន ដល់ ប្រជាពលរដ្ឋ នូវ សមិទ្ធផល ដែល រដ្ឋបាល ខេត្ត សម្រេចបាន និង គម្រោង ជា អាទិភាព នានា ក្នុង ឆ្នាំ ខាងមុខ ។
ជាពិសេស នោះ នឹង ផ្តល់ ឱកាស ដល់ ប្រជាពលរដ្ឋ បាន បញ្ចេញ នូវ មតិ យោបល់ ព្រមទាំង លើកឡើង ពី ក្តី ព្រួយបារម្ភ រួមទាំង បញ្ហា ប្រឈម របស់ ខ្លួន ពិសេស ក្នុង មូលដ្ឋាន ដែល ប្រជាពលរដ្ឋ កំពុង រស់ នៅ ដើម្បីឲ្យ វា គ្មិន បកស្រាយ និង នាំយក បញ្ហា ទាំងនោះ មក ពិភាក្សា នាំគ្នា ដោះស្រាយ និង ឆ្លើយតប ប្រកបដោយ ប្រសិទ្ធភាព ។
សូម ជម្រាប ថា ក្នុង អង្គ វេទិកា សំណូមពរ និង បញ្ហា ប្រឈម នានា របស់ ពលរដ្ឋ នៅ តាម បណ្តា ភូមិ - ឃុំ ក្នុង មូលដ្ឋាន ស្រុក អូរ រាំង ឪ សរុប ចំនួន ១៦ករណី ត្រូវបាន មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ឡើង បំភ្លឺ ឆ្លើយតប ភ្លាម ៗ និង ត្រូវ ដោះស្រាយ ជូន តាម លំដាប់លំដោយ ផងដែរ ៕
នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន៖ នៅ គ្រប់ ដំណាក់កាល ការងារ ហ្វឹកហ្វឺន នៅតែ ដើរ តួនាទី សំខាន់ ក្នុង ការអភិវឌ្ឍន៍ សមត្ថភាព យោធិន
