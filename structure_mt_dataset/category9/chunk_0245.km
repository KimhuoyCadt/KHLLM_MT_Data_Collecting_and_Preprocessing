( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ចែកជូន ប្រជាពលរដ្ឋ ចំនួន ៦៧៥ គ្រួសារ ស្ថិត នៅ ឃុំ តាសាល ស្រុក ឱរ៉ាល់ និង ឃុំ អម លាំង ស្រុក ថ្ពង ។
នា ឱកាស នោះ លោក វ៉ី សំណាង បាន ផ្ដាំផ្ញើ សួរសុខទុក្ខ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជម្រាប ដល់ ប្រជាពលរដ្ឋ ដែល សម្ដេច ទាំង ទ្វេ តែងតែ នឹក រឭក និង គិតគូរ យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ។
លោក បាន លើកឡើង ថា គណបក្ស ប្រជាជន កម្ពុជា ពិសេស សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត តែង មាន ទម្លាប់ ចុះ ជួយ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ជានិច្ច ដាច់ខាត មិន ដែល រត់ ចោល ប្រជាពលរដ្ឋ ឬ ឱ្យ ប្រជាពលរដ្ឋ រត់ ទៅ រក សម្ដេច វិញ ឡើយ « ទីណា មាន ប្រជាពលរដ្ឋ ជួប ទុក្ខ ទៅ នោះ មាន មុខ សម្ដេច តេជោ ហ៊ុន សែន » ។
លោក ថា គណបក្ស ប្រជាជន កម្ពុជា មាន ពាក្យស្លោក មួយ ឃ្លា និង តែង អនុវត្ត ជារៀងរហូតមក នោះ គឺ « ស្រលាញ់ ជាតិ គឺ ជួយ ប្រជាជន » ។
លោក អភិបាល ខេត្ត ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ រក្សា ទឹក ទុក សម្រាប់ ប្រើប្រាស់ ទៅ ថ្ងៃ មុខ និង ទុក ក្នុង ស្រែ ដើម្បីឱ្យ ស្រូវ មាន ការលូតលាស់ ល្អ ពិសេស ត្រូវ ត្រៀម ស្រូវ ពូជ ឬ គ្រាប់ ពូជ ដំណាំ ផ្សេង ទៀត ដើម្បី បង្កបង្កើន ផល នៅ រដូវ ក្រោយ ។
លោក រដ្ឋមន្ត្រី បាន ក្រើនរំឭក បន្ថែម ដល់ ប្រជាពលរដ្ឋ ឱ្យ ត្រូវ ចូលរួម ថែរក្សា សុខភាព ឱ្យ បាន ល្អ តាមរយៈ ការហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត និង ប្រកបដោយ អនាម័យ ខ្ពស់ ។ ម្យ៉ាងទៀត ក៏ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ការអនុវត្ត វិធាន សុវត្តិភាព និង គោលការណ៍ ណែនាំ របស់ ក្រសួង សុខាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ឱ្យ បាន ល្អ ៕
បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក ទទួលបាន ស្ព្រាយ សម្លាប់ មេរោគ ជាង ១ ពាន់ ដប ពី វិស័យ ឯកជន
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ បាន ទទួល ស្ព្រាយ (Spry) សម្លាប់ មេរោគ ចំនួន ១. ០០៨ ដប ស្មើនឹង ១៤កេស សរុប ជា ទឹកប្រាក់ ចំនួន ៦.០៤៨ ដុល្លារ ជា ការជួយ ឧបត្ថម្ភ របស់ លោក ស្រ៊ាន សំណាង ប្រធាន ក្រុមហ៊ុន ក្នុង ស្រុក តាមរយៈ ឧត្តមសេនីយ៍ ឯក ជីម សុខ នាយ រង សេនាធិការ ចម្រុះ នាយក ទី ចាត់ការ បុគ្គលិក បាន ឱ្យ ឧត្តមសេនីយ៍ ត្រី គូ សាមម៉ឺ ឌី នាយ ការិយាល័យ សិក្សា គម្រោង ទី ចាត់ការ អគ្គ បញ្ជាការ ។
ក្នុង ឱកាស ប្រគល់ ទទួល និង ទទួល សម្ភារ សម្លាប់ មេរោគ នេះ លោក ស្រ៊ាន សំណាង បាន កោតសរសើរ ដល់ កងទ័ព ដែលនិច្ចកាល បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ភារកិច្ចការពារ ជាតិ និង ប្រជាជន ព្រមទាំង បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការងារ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ពី គ្រោះមហន្តរាយ ផ្សេង ៗ និង កិច្ចការ មនុស្សធម៌ ព្រមទាំង បាន រក្សា សុខ មាលភាព បាន ល្អ ប្រសើរ ។
លោក បាន បន្ត ថា សម្រាប ស្ព្រាយ សម្លាប់ មេរោគ ដែល ផ្តល់ ជូន បញ្ជាការ កងទ័ព ជើងគោក នា ពេលនេះ គឺ សម្រាប់ ឱ្យ កងទ័ព ប្រើប្រាស់ និង ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ដែល បច្ចុប្បន្ន ពិភពលោក កំពុង ទទួល រងគ្រោះ ពី ជំងឺ ដ៏ កាច សាហាវ នេះ ។
ឧត្តមសេនីយ៍ ឯក ខឹម ជា សាឃឿន មេបញ្ជាការ រង នាយ សេនាធិការ កងទ័ព ជើងគោក ជំនួស មុខ ឱ្យ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក និង ថ្នាក់ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្នុង បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក បាន សម្តែង អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ កាយវិការ មនុស្សធម៌ របស់ លោក ស្រ៊ាន សំណាង ដែល បាន ចូលរួមចំណែក ក្នុង ការគិតគូរ ពី សុខខ ទុក្ខ និង សុខ មាលភាព របស់ កងយោធពល ខេមរភូមិន្ទ ។
ឧត្តមសេនីយ៍ ឯក ខឹម ជា សាឃឿន ក៏ បាន ចាត់ទុក សម្ភារ ពេទ្យ ដែល បាន ផ្តល់ ដល់ បញ្ចា ការដ្ឋាន កងទ័ព ជើងគោក នា ពេលនេះ ពិតជា ការរួមចំណែក យ៉ាង សកម្ម ក្នុង ចលនា ជួយ ទ្រទ្រង់ កងទ័ព ជើងគោក និង ចំពេលវេលា មួយ សមស្រប ដើម្បី ជួយ ដល់ កងទ័ព ក៏ ដូចជា តម្រូវការ ចំពោះ មុខ ដោយ ផ្ដល់ គ្រប់ លទ្ធភាព ដល់ អង្គភាព របស់ កងយោធពល ខេមរភូមិន្ទ ក្នុង ការការពារ និង ទប់ស្កាត់ ការរីករាល ដាល ជំងឺ កូវីដ - ១៩ ក៏ ដូចជា ការអនុវត្តន៍ នូវ វិធានការ នានា របស់ ក្រសួង សុខាភិបាល ផងដែរ ៕
ចាប់ ជនសង្ស័យ ៨នាក់ ករណី ចែកចាយ គ្រឿងញៀន នៅ ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ ជនសង្ស័យ ស្រី ប្រុស ចំនួន ៨នាក់ ត្រូវបាន កម្លាំង នគរបាល ខេត្ត ព្រះវិហារ ស្រាវជ្រាវ ចាប់ខ្លួន បានជា បន្តបន្ទាប់ ក្នុង ករណី ដឹកជញ្ជូន ចែកចាយ និង ប្រើប្រាស់ គ្រឿងញៀន នៅ ចំណុច ផ្លូវ លំ វាល ចាក់ សម្រាម ក្នុង ភូមិភារកិច្ច សង្កាត់ ប៉ាល ហាល ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ ។
ជនសង្ស័យ ទាំង ៨នាក់ មាន ស្រី ៤នាក់ ដែល ជា មុខសញ្ញា ពាក់ព័ន្ធ ក្នុង ការជួញដូរ គ្រឿងញៀន យ៉ាង សកម្ម ក្នុង ភូមិសាស្ត្រ ក្រុង ព្រះវិហារ នៅ ពេល នេះ សមត្ថកិច្ច កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ ចាត់ការ តាម ច្បាប់ និង ស្វែងរក ចាប់ខ្លួន បក្ខពួក បន្ថែម ទៀត ផងដែរ ។
សូម បញ្ជាក់ ថា នៅក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ព្រះវិហារ កាលពី ពេល ថ្មី ៗ កន្លងទៅ នេះ លោក ឧត្តមសេនីយ៍ ទោ សួស សុខ ដារ៉ា ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ បាន លើកឡើង ដោយ ក្តីបារម្ភ ថា មិន ដឹង កូន គេ ឬ កូន យើង ទេ ដែល ត្រូវ រងគ្រោះ ដោយសារ គ្រឿងញៀន នេះ ។
ក្នុង នោះ លោក ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម រាយការណ៍ មក សមត្ថកិច្ច មិន ថា ម៉ោង ណា ពេលណា នោះ ទេ ពី ករណី គ្រឿងញៀន នេះ ដើម្បីឱ្យ សមត្ថកិច្ច បង្រ្កាប ឱ្យ ខាងតែ បាន ៕
ក្រសួង មហាផ្ទៃ ប្រាប់ ឲ្យ អភិបាល រាជធានី - ខេត្ត កែសម្រួល ព្រំប្រទល់ រាជធានី ខេត្ត ស្រុក ខណ្ឌ ក្រុង ឃុំ សង្កាត់ ដែល មិន ទាន់ ច្បាស់លាស់ សម្រាប់ បម្រើ ឱ្យ ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់
លិខិត របស់ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា ក្រសួង តម្រូវឲ្យ លោក លោកស្រី ត្រូវ ចែកចាយ ឬ លក់ ម៉ាស និង ផលិតផល សម្លាប់ មេរោគ ដែល មាន លេខ ទិដ្ឋាការ ឬ បញ្ជិការ ឬ ប្រវេទន៍ ពី ក្រសួង សុខាភិបាល ក្នុង តម្លៃ ថោក សមរម្យ ដើម្បីឲ្យ ប្រជាពលរដ្ឋ មាន លទ្ធភាព ទិញ ផលិតផល ទាំងនេះ យកមក ប្រើប្រាស់ បាន និង ហាមឃាត់ ដាច់ខាត ការចែកចាយ ឬ លក់ ផលិតផល ម៉ាស និង ផលិតផល សម្លាប់ មេរោគ ក្លែង បន្លំ ឬ អន់ គុណភាព ។
ក្នុង ករណី ម្ចាស់ គ្រឹះស្ថាន និង ឱសថការី ទទួលបន្ទុក គ្រឹះស្ថាន ខាងលើ ឬ បុគ្គល ណា ដែល មិន គោរព តាម ការណែនាំ នេះ ក្រសួង សុខាភិបាល នឹង មាន វិធានការ តឹងរ៉ឹង ដោយ ធ្វើ ការផ្អាក សកម្មភាព អាជីវកម្ម គ្រឹះស្ថាន និង វិធានការ ផ្សេង ៗ ទៀត ស្រប តាម ច្បាប់ ជាធរមាន ។
ជាមួយគ្នា នេះ ក្រសួង សុខាភិបាល ក៏ បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ ផងដែរ មុននឹង សម្រេចចិត្ត ទិញ ម៉ាស និង ផលិតផល សម្លាប់ មេរោគ ត្រូវ ពិនិត្យមើល ផលិតផល ណា ដែល មាន បិទ លតាប ត្រ ទិដ្ឋាការ ឬ បញ្ជិកា ឬ ប្រវេទន៍ ដូច មាន គំរូប ភ្ជាប់ មក ជាមួយ នៅ ទំព័រ ទី២ ទើប ជា ផលិតផល ដែល មាន ទទួលស្គាល់ ពី ក្រសួង សុខាភិបាល ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ ក្រសួង សុខាភិបាល និង ការណែនាំ អំពី គុណភាព ផលិតផល ទាំង នេះ៖
យុវជន ល្អ រួបរួម គាំទ្រ កម្ចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា៖ បង្ក្រាប ៣៤ករណី ឃាត់ខ្លួន ៨៣ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣៤ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១៣ករណី និង ជួញដូរ ២១ ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៨៣ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៩. ១៤៧ ករណី ឃាត់ មនុស្ស ១៨. ៥៩៧ នាក់ ( ស្រី ១១៦៨ នាក់ )៕ ផ្លូវ ២ខ្សែ ប្រវែង ៩គីឡូ នៅ ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ត្រូវ ជួល ជុល ឡើងវិញ ក្រោយពី រង ការខូចខាត ដោយសារ ជំនន់ ទឹកភ្លៀង
UPDATE: តុលាការ សម្រេច ឲ្យ សមត្ថកិច្ច ប្រគល់ លោកស្រី ទ្រី សុផានិត ទៅ ក្រុមគ្រួសារ វិញ ដើម្បី ព្យាបាល ជំងឺ រង់ចាំ បន្ដ នីតិវិធី នៅ ពេល ក្រោយ
( ភ្នំពេញ ) ៖ សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច យល់ព្រម ឲ្យ កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ប្រគល់ លោកស្រី ទ្រី សុផានិត ដែល ជា អ្នកលក់ ផលិតផល អនឡាញ ម្នាក់ ទៅ ក្រុមគ្រួសារ វិញ ដើម្បី ពិនិត្យ ព្យាបាល ជំងឺ ទើប បន្ដ នីតិវិធី របស់ តុលាការ នៅ ពេល ក្រោយ បន្ទាប់ពី លោកស្រី ជាសះស្បើយ ។
លោក ឧត្តមសេនីយ៍ ទោ ជា វ វិបុល បាន គូសបញ្ជាក់ ថា ដោយ អនុវត្ត តាម ដីកា បង្គាប់ ឲ្យ នាំ ខ្លួន របស់ ចៅក្រម ស៉ើប សួរ លោក ហម ម៉េង សែ លោក បាន បញ្ជា កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក ហែម បូណា នាយ ការិយាល័យ ចុះ អនុវត្ត ដីកា នេះ និង ឈាន ការឃាត់ខ្លួន ឈ្មោះ ទ្រី សុផានិត ស្ថិត នៅ តាម ផ្លូវ ១៨២ ក្នុង សង្កាត់ ទឹកល្អក់ ទី២ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
លោក បាន បន្ដ ថា ក្រោយ ឃាត់ខ្លួន កម្លាំង ជំនាញ បាន បញ្ជូន ឈ្មោះ ទ្រី សុផានិត ទៅ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ប៉ុន្ដែ ពេល បញ្ជូន ទៅ នាយកដ្ឋាន ជនសង្ស័យ មាន សុខភាព ល្អ ធម្មតា និង បាន ឡាយ វីដេអូ ក្នុង រថយន្ដ ថែម ទៀត ថា ។ លុះ ពេល រសៀល បញ្ជូន ទៅដល់ ក្លោងទ្វារ សាលាដំបូង រាជធានី ភ្នំពេញ ស្រាប់តែ ឈ្មោះ ទ្រី សុផានិត មាន អាការៈ មិន ស្រួល ខ្លួន និង ដួល សន្លប់ តែម្ដង ។ ភ្លាម ៗ កម្លាំង សមត្ថកិច្ច និង ក្រុមគ្រួសារ បាន បញ្ជូន ទៅ សង្គ្រោះ នៅ មន្ទីរពេទ្យ ផងដែរ ។
លោក អោក បូរ៉ា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក ប្រៃសណីយ៍ កម្ពុជា បាន លើកឡើង ថា ការធ្លាក់ចុះ នៃ ចំណូល នេះ ដោយសារ ការ អូស បន្លាយ នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
