( ភ្នំពេញ ) ៖ លោក ឡុង ឌីម៉ង ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សាធារណៈ រដ្ឋ កូរ៉េ និង សហការី បាន ប្រារព្ធ ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៦៧ ទិវា បុណ្យ ឯករាជ្យ ជាតិ និង ខួបកំណើត កងយោធពល ខេមរភូមិន្ទ នៅ មជ្ឍ មណ្ឌល វប្បធម៌ ខ្មែរ នៅ ទីក្រុង អាន សាន ។
ក្នុង ពិធី នោះ ក៏ មាន មន្ត្រីរាជការ ស្ថានទូត និង ក្រុមគ្រួសារ និស្សិត អនិកជន ខ្មែរ រស់នៅ កូរ៉េ ខាងត្បូង ពលករ ពលការ នី និង ភ្ញៀវ ជនជាតិ កូរ៉េ ចូលរួម ប្រមាណ ជាង ៨០ នាក់ ។
កម្មវិធី ក៏ បាន បញ្ចាំង នូវ វីដេអូ ឯកសារ ស្ដីពី ការតស៊ូ ដណ្ដើម ឯករាជ្យ ជាតិ រំលឹក អំពី ប្រវត្តិសាស្ត្រ កម្ពុជា អំពី ការតស៊ូ របស់ បុព្វបុរស ការបង្រួបបង្រួម ជាតិ រហូត ទទួលបាន សន្ដិភាព ពេញលេញ ដូច បច្ចុប្បន្ន និង បាន រៀបចំ ឲ្យ អង្គ ពិធី ទាំងមូល ចូលរួម ច្រៀង ចម្រៀង បទ ពង្សាវតារ ខ្មែរ ជនជាតិ ខ្មែរ និង បទ ដែនដី ខ្មែរ ដោយ ពរ ពេញ ដោយ ក្ដីរំភើប រំជើបរំជួល ។
ជាមួយគ្នា នេះ លោក ឡុង ឌីម៉ង និង សហការី ព្រមទាំង ភ្ញៀវ ជាតិ និង អន្តរជាតិ ក៏ បាន ប្រារព ពិធី ដាល់ អំបុក និង អក អំបុក បង្ហាញ ពី វប្បធម៍ ខ្មែរ ប្រកបដោយ ភាពរីករាយ ដោយ គោរព តាម វិធានការ សុវត្ថិភាព របស់ អាជ្ញាធរ ដើម្បី បង្កា ទប់ស្កាត់ នៃ ការរីករាលដាល នៃ មេរោគ កូវីដ - ១៩ ៕
លោក Graham បាន ចោទប្រកាន់ ថា មាន ការក្លែងបន្លំ នៅក្នុង ការបោះឆ្នោត តាមរយៈ អ៊ីមែល ដោយ គ្មាន មូលដ្ឋានគ្រឹះ ច្បាស់លាស់ ដែល ជនជាតិ អាមេរិក មួយចំនួន ធំ បាន ធ្វើឡើង កាលពី ថ្ងៃអង្គារ សប្ដាហ៍ មុន ដោយសារតែ ការឆ្លង រាលដាល នៃ ជំងឺ COVID-19 ។ លោក ហ្ក្រាហាំ ដែល ធ្លាប់ ជា អតីត អ្នករិះគន់ លោក ត្រាំ យ៉ាង ចាស់ ដៃ នោះ បាន ប្រែក្លាយ អ្នកគាំទ្រ វិញ និង បាន ហៅ ការបោះឆ្នោត តាមរយៈ អ៊ីមែល នោះ ថា « ជា ការបោះឆ្នោត ដែល ប្រៀប ដូចជា ថ្លុក កំប្លែង » ។
គួរ ជម្រាប ថា លោក ដូណាល់ ត្រាំ បាន ធ្វើ ការចោទប្រកាន់ ដោយ គ្មាន ភស្តុតាង នៃ ការក្លែងបន្លំ ម្តង ហើយ ម្តង ទៀត និង ថែមទាំង បាន អះអាង ថា លោក បាន ឈ្នះ ការបោះឆ្នោត បើ ទោះបីជា ការព្យាករណ៍ ផ្អែក លើ លទ្ធផល បង្ហាញ ថា លោក ចូ បៃ ដិន ជា អ្នក ឈ្នះ យ៉ាង ច្បាស់ ក៏ដោយ ។ បច្ចុប្បន្ន នេះ លោក បៃ ដិន ទទួលបាន តំណាង អ្នកបោះឆ្នោត ចំនួន ២៧៩ ចំណែក លោក ត្រាំ បាន ទទួល ត្រឹមតែ ២១៤ ប៉ុណ្ណោះ ៕
ថ្ងៃ នេះ នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី និង អ្នក ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល ជាមួយ ប្រតិភូ ហុង គ្រី ជាង ៩០០ នាក់ ធ្វើតេស្ត រក មេរោគ កូវីដ១៩ ជា លើក ទី២
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ព្រមទាំង រដ្ឋមន្ត្រី និង អ្នក ប៉ះពាល់ ដោយ ផ្ទាល់ និង ប្រយោល ជាមួយ លោក ភីត ធើ ស៊ី ចាតូ រដ្ឋមន្ត្រី ការបរទេស និង ពាណិជ្ជកម្ម ហុង គ្រី និង ប្រតិភូ សរុប ជាង ៩០០ នាក់ ធ្វើតេស្ត រក ជំងឺ កូវីដ១៩ ជា លើក ទី២ ដើម្បីឱ្យ មាន ភាពច្បាស់លាស់ ថា មាន ឆ្លង ឬ មិន ឆ្លង ជំងឺ កូវីដ១៩ ។
ការធ្វើតេស្ត រក ជំងឺ កូវីដ១៩ នេះ ត្រូវបាន រៀបចំ ធ្វើ នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី និង សណ្ឋាគារ សុខា សម្រាប់ មន្ត្រីរាជការ និង អ្នកសារព័ត៌មាន ដែល បាន ពាក់ព័ន្ធ ផ្ទាល់ និង ប្រយោល នោះ ។ ដោយឡែក សម្រាប់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី និង មន្ត្រី ជាន់ ខ្ពស់ មួយចំនួន ទៀត ត្រូវបាន ធ្វើតេស្ត នៅ តាម ទីតាំង ធ្វើចត្តាឡី ស័ក នៅ គេហដ្ឋាន ។
សូម រំលឹក ថា កាលពី ថ្ងៃទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០២០ កន្លងទៅ នេះ រដ្ឋមន្ត្រី ការបរទេស និង ពាណិជ្ជកម្ម ហុង គ្រី លោក ភីត ធើ ស៊ី ចាតូ និង ប្រតិភូ របស់ លោក បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច មួយ ថ្ងៃ នៅក្នុង ប្រទេស កម្ពុជា ។ បន្ទាប់ពី បញ្ចប់ ដំណើរទស្សនកិច្ច នៅ កម្ពុជា លោក ក៏ បាន អញ្ជើញ ទស្សនកិច្ច នៅ ប្រទេស ។ ពេល ទៅដល់ ប្រទេស ថៃ លោក ភីត ធើ ស៊ី ចាតូ បាន រកឃើញ ថា មាន ជំងឺ កូវីដ១៩ ។
ព័ត៌មាន នៃ ការរកឃើញ ថា លោក ស៊ី ចាតូ មាន មេរោគ កូវីដ១៩ បាន នាំឱ្យ មាន ការបារម្ភ ជាខ្លាំង សម្រាប់ កម្ពុជា ។ សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ បទបញ្ជា យ៉ាង ម៉ឹង ម៉ាត់ និង បន្ទាន់ មួយ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ នេះ នៅក្នុង ប្រទេស កម្ពុជា ។
ទាំង សម្តេច តេជោ ហ៊ុន សែន និង រដ្ឋមន្ត្រី សមាជិក សភា ប៉ះពាល់ ផ្ទាល់ មាន ដូចជា លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ . លោក វេង សាខុន រដ្ឋមន្ត្រី កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ . លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម . លោក ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្រ្តី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល និង លោក សួស យ៉ារ៉ា សមាជិក សភា ត្រូវបាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ( នៅ ដាច់ដោយឡែក ) រយៈពេល ១៤ ថ្ងៃ ។
ក្រៅពី សម្តេច តេជោ . រដ្ឋមន្ត្រី និង សមាជិក សភា ដែល ប៉ះពាល់ ផ្ទាល់ នេះ ទៅ នៅ មាន មន្ត្រីរាជការ អតីត និស្សិត សិក្សា នៅ ហុង គ្រី អង្គរក្ស និង ក្រុម អ្នក ព័ត៌មាន សរុប ជាង ៩០០ នាក់ ក៏ ត្រូវបាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ផងដែរ ។ ក្នុង នោះ អភិបាល ខេត្ត ពោធិ៍សាត់ លោក ម៉ៅ ធ និន និង មន្ត្រី ក្នុង ខេត្ត មួយចំនួន ដែល បាន ប៉ះពាល់ ជាមួយ លោក រដ្ឋមន្ត្រី វេង សាខុន នៅ ថ្ងៃទី ០៤ ខែវិច្ឆិកា ក៏ បាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ផងដែរ ។
អ្នក ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល ត្រូវបាន ធ្វើតេស្ត សុខភាព រក ជំងឺ កូវីដ១៩ លើក ទី១ កាលពី ថ្ងៃទី ០៤ ខែវិច្ឆិកា កន្លងទៅ រួច ម្តង មក ហើយ ។ អ្នក ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល នេះ មាន អង្គរក្ស ការពារ រដ្ឋមន្ត្រី ហុង គ្រី ១នាក់ ត្រូវបាន រកឃើញ ថា បាន ឆ្លង ជំងឺ កូវីដ១៩ នេះ ។
ដោយឡែក អ្នកដទៃ ទៀត មាន សុខភាព ល្អ ជាធម្មតា រហូតមកដល់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា នៃ ការធ្វើតេស្ត សុខភាព លើក ទី២ នេះ មិន ទាន់ មាន របាយការណ៍ ពី ការឆ្លង ឬ កើត មេរោគ កូវីដ១៩ នោះ ទេ ។
អ្នក ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល នេះ នឹង ត្រូវ ធ្វើតេស្ត រក ជំងឺ កូវីដ១៩ ចំនួន ពីរ លើក ទៀត នៅ ថ្ងៃទី ១៤ និង ១៨ ខែវិច្ឆិកា ដើម្បី ធានា ថា ពួកគេ នឹង មិន មាន កើត មេរោគ កូវីដ១៩ ។
រាជ រដ្ឋាភិបាល បាន សម្តេច ផ្អាក ការសិក្សា នៅ តាម សាលា រដ្ឋ និង ឯកជន ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ផងដែរ ដើម្បី ធានា ថា មិន មាន ការរីកសាយភាព នៃ ការឆ្លង ជំងឺ កូវីដ១៩ ក្នុង កំលុង ពេល តាមដាន សុខភាព អ្នក ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល ជាមួយ ប្រតិភូ ហុង គ្រី នេះ ។ រាជ រដ្ឋាភិបាល ក៏ បាន បិទ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ដើម្បី ផ្អាក សកម្មភាព កីឡា គ្រប់ ប្រភេទ នៅក្នុង ពហុកីឡដ្ឋាន នេះ ។
ពិធី អបអរសាទរ រំលឹក ខួប នៃ ការដណ្តើម បាន ឯករាជ្យ ឆ្នាំ ២០២០ នេះ ត្រូវបាន ប្រារព្ធ ឡើង ក្រោម រាជា ធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី បុត្រា ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ ព្រះបិតា ឯករាជ្យ ជាតិ ខ្មែរ ។ ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម អបអរសាទរ ពី ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល មន្ត្រីរាជការ សិស្សានុសិស្ស យុវជន និង ប្រជាពលរដ្ឋ ជាច្រើន រូប ទៀត ។
សូម ទស្សនា កម្រ រូបភាព បុណ្យ ខួប អនុស្សាវរីយ៍ លើក ទី ៦៧ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា ឆ្នាំ ២០២០៖
