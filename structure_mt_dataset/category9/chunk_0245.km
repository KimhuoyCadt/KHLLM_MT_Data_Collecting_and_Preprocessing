អំណោយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ជូន រដ្ឋាភិបាល ឡាវ រួម មាន៖
សូម ជម្រាប ថា អំណោយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ជូន រដ្ឋាភិបាល ឡាវ រួម មាន ម៉ាស និង បរិក្ខារ ពេទ្យ សរុប ចំនួន ១២មុខ នឹង ត្រូវ ដឹក តាម យន្តហោះ ពី កម្ពុជា ទៅ ប្រទេស ឡាវ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ស្អែក នេះ ។
ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់តាំង សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ ជា តំណាង ដើម្បី ដឹកនាំ គណៈប្រតិភូ នាំយក អំណោយ ម៉ាស ចំនួន ២លាន និង បរិក្ខារ ពេទ្យ ទាំង នេះ យក ទៅ ជូន រដ្ឋាភិបាល និង ប្រជាជន ឡាវ នៅ ព្រឹក ថ្ងៃចន្ទ ទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
សូម ជំរាប ថា នៅ យប់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន បាន ផ្ញើ លិខិត ផ្លូវការ ពិសេស មួយ ជូន លោក ថង លុន ស៊ី សុលីត នាយក រដ្ឋមន្រ្តី នៃ សាធារណរដ្ឋ ប្រជាធិបតេយ្យ ប្រជាមានិត ឡាវ ដោយ ថ្លែងអំណរគុណ ចំពោះ ការហៅទូរស័ព្ទ សួរសុខទុក្ខ របស់ លោក ថង លុន ស៊ី សុលីត និង បញ្ជាក់ អំពី ការជួយ ឧបត្ថម្ភ របស់ កម្ពុជា ជូន មិត្ត ឡាវ នូវ ម៉ាស ចំនួន ២លាន និង បរិក្ខា ពេទ្យ មួយចំនួន ៕
យល់ដឹង ផ្នែក ច្បាប់៖ ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ
( ភ្នំពេញ ) ៖ នៅ ពេល ដែល បុគ្គល ណា ម្នាក់ បាន ប្រព្រឹត្ត បទល្មើស ព្រហ្មទណ្ឌ នោះ ព្រះរាជអាជ្ញា និង ធ្វើ ការចោទប្រកាន់ រួច បញ្ជូន ជន នោះ ទៅ ចៅក្រម ស៊ើបសួរ ដើម្បី ធ្វើ កិច្ចស៊ើបសួរ ដាក់បន្ទុក ឬ ដោះបន្ទុក ហើយ ប្រសិនបើ ចៅក្រម ស៊ើបសួរ យល់ឃើញ ថា អំពើ ដែល បាន ប្រព្រឹត្ត ជាបទឧក្រិដ្ឋ ឬ បទ មជ្ឈឹម បាន បង្កព្យ សនកម្ម ធ្ងន់ធ្ងរ ដល់ សង្គម នោះ ចៅក្រម ស៊ើបសួរ អាច ធ្វើ ការឃុំ ខ្លួន បុគ្គល នោះ ដើម្បី បញ្ចប់ ឬ បង្ការ បទល្មើស កុំ ឲ្យ កើតឡើង ជាថ្មី និង កុំ ឲ្យ ប៉ះពាល់ ដល់ នីតិវិធី ស៊ើបសួរ ។
ប៉ុន្តែ ប្រសិនបើ អំពើ នោះ បាន បង្កព្យ សនកម្ម តិចតួច ដល់ សង្គមជាតិ ហើយ មាន មូលហេតុ សមស្រប តាម ច្បាប់ ដែល មិន ធ្វើឲ្យ ប៉ះពាល់ ដល់ នីតិវិធី ស៊ើបសួរ ទេ នោះ ចៅក្រម ស៊ើបសួរ អាច សម្រេច ដាក់ ជន ត្រូវ ចោទ ឲ្យ ស្ថិត នៅក្រោម ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ បាន គ្រប់ ពេលវេលា ដោយ ស្ថិត ក្នុង ដំណាក់កាល ស៊ើបសួរ ។
ដើម្បី យល់ កាន់តែ ច្បាស់ ដូច្នេះ ក្នុង សប្តាហ៍ នេះ អង្គភាព ព័ត៌មាន Fresh News សហការ ជាមួយ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ សូម លើក យក ប្រធានបទ ស្ដីពី « ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ » មក ធ្វើ ការបកស្រាយ ជូន បងប្អូន ប្រជាពលរដ្ឋ សិស្ស និស្សិត ដូចត ទៅ៖
ជា ផ្នែក មួយ នៃ វិធានការនិរន្ដរាយ ដើម្បី ធានា សម្រួល ដល់ ដំណើរការ នៃ កិច្ចស៊ើបសួរ ចៅក្រម ស៊ើបសួរ អាច ដាក់ ជន ត្រូវ ចោទ ឱ្យ ស្ថិត នៅក្រោម ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ( នៅ ក្រៅ ឃុំ ) ឬ សម្រេច ឃុំ ខ្លួន បណ្ដោះអាសន្ន ( នៅក្នុង ឃុំ ) ។
ចំពោះ ការដាក់ ឱ្យ ស្ថិត ក្រោម ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ អាច ធ្វើ ការកែប្រែ ឬ លុបចោល ខ្លឹមសារ នៃ កាតព្វកិច្ច និង បញ្ចូល កាតព្វកិច្ច ថ្មី បាន តាម ០៣ ( បី ) លក្ខខណ្ឌ គឺ ( ១ ) ការកែប្រែ ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ដោយ ឯកឯង ដោយ ចៅក្រម ស៊ើបសួរ និង ( ២) បណ្ដឹង សុំ កែប្រែ ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ដោយ ព្រះរាជអាជ្ញា និង ( ៣) តាមរយៈ បណ្ដឹង សុំ ឱ្យ កែប្រែ ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ដោយ ជន ត្រូវ ចោទ ។
នៅក្នុង ករណី ដែល ជន ត្រូវ ចោទ បាន គេចវេស ដោយ ចេតនា ពី កាតព្វកិច្ច នៃ ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ចៅក្រម ស៊ើបសួរ អាច សម្រេច ឱ្យ ឃុំ ខ្លួន ជន ត្រូវ ចោទ ជា បណ្ដោះអាសន្ន បាន ទោះបីជា ទោស ពន្ធនាគារ ដែល ត្រូវ រង នោះ មាន ថិរ វេលា ប៉ុន្មាន ក៏ដោយ ហើយ ទោះបីជា ជន ត្រូវ ចោទ ត្រូវបាន ឃុំ ខ្លួន បណ្ដោះអាសន្ន អស់ រយៈពេល អតិបរមា ដែល បាន កំណត់ ក៏ដោយ ។
សរុប មក ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ គឺជា នីតិវិធី ពិសេស មួយ សម្រាប់ តុលាការ ( ចៅក្រម ស៊ើបសួរ ) គ្រប់គ្រង ជន ត្រូវ ចោទ ដែល ស្ថិត នៅ ក្រៅ ឃុំ ដោយ ផ្ដល់ សិទ្ធិ អំណាច ដល់ ចៅក្រម ស៊ើបសួរ ក្នុង ការដាក់ កាតព្វកិច្ច ឬ ការហាមឃាត់ ជា កំណត់ ណាមួយ ចំពោះ ជន ត្រូវ ចោទ ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា បាន បញ្ជាក់ ថា ក្នុង កិច្ចប្រជុំ នោះ ប្រមុខ ដឹកនាំ អាសិប បាន កត់សម្គាល់ និង វាយតម្លៃ ខ្ពស់ ចំពោះ រដ្ឋមន្រ្តី និង អ្នកចរចា អាសិប ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង ក្នុង រយៈពេល ៨ ឆ្នាំ កន្លងមក នេះ និង សម្រេចបាន នូវ អាណត្តិ ដែល បាន ផ្តល់ ឱ្យ កាល ពី កិច្ច ប្រជុំ កំពូល អាសិប លើក ទី៣ ឆ្នាំ ២០១៩ កន្លងទៅ ។
សម្រាប់ កម្ពុជា រាជ រដ្ឋាភិបាល បាន ប្រគល់ សិទ្ធិ ជូន លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង នេះ ។ ការសម្រេចបាន នូវ កិច្ចព្រមព្រៀង អាសិប នា ពេលនេះ ជា សមិទ្ធិផល ដ៏ មាន សារ សំខាន់ ជា ប្រវត្តិសាស្រ្ត សម្រាប់ កម្ពុជា និង តំបន់ ដែល នឹង ចូលរួម ចំណែក ក្នុង ការ គាំពារ និង លើកកម្ពស់ សកល ភាវូបនីយកម្ម និង គាំទ្រ ប្រព័ន្ធ ពាណិជ្ជកម្ម សេរី ពហុ ភាគី ដោយ ផ្អែក លើ ច្បាប់ ដែល ជា បុរេលក្ខខណ្ឌ មិន អាច ខ្វះ បាន ស្រប តាម គោលការណ៍ នៃ ការធ្វើ ពាណិជ្ជកម្ម ដោយ សេរី និង យុត្តិធម៌ ។
កិច្ចព្រមព្រៀង នេះ ក៏ នឹង ក្លាយជា កម្លាំង ចលករ ដ៏ សំខាន់ ក្នុង ការជួយ ដល់ ដំណើរការ នៃ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ប្រកបដោយ ចីរភាព និង បរិយាប័ន្ន ។ អាសិប ក៏ ដើរ តួនាទី ជា កាតាលីករ មួយ ផងដែរ ក្នុង ការចូលរួម ចំណែក ជំរុញ កំណើន សេដ្ឋកិច្ច លើកកម្ពស់ សុខ មាលភាព និង ជីវភាព របស់ ប្រជាជន នៅក្នុង តំបន់ ព្រមទាំង ជួយ ស្តារ សង្គម - សេដ្ឋកិច្ច តំបន់ ឡើងវិញ បន្ទាប់ពី វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ បាន បញ្ចប់ ។
នៅក្នុង ឱកាស នេះ ដែរ ប្រមុខ ដឹកនាំ អាសិប បាន លើកទឹកចិត្ត ឱ្យ ប្រទេស ជា សមាជិក ពន្លឿន ការ បញ្ចប់ នីតិវិធី ក្នុង ស្រុក ក្នុង ការផ្តល់ សច្ចាប័ន ដើម្បីឱ្យ កិច្ចព្រមព្រៀង នេះ អាច ចូល ជាធរមាន ក្នុង ពេល ដ៏ ខ្លី ខាងមុខ សំដៅ អនុញ្ញាតឱ្យ ប្រទេស ជា សមាជិក ទាំងអស់ អាច ប្រើប្រាស់ និង ទាញ យក អត្ថប្រយោជន៍ ជា អតិបរមា ពី កិច្ច ព្រមព្រៀង អាសិប នេះ ។
ប្រមុខ ដឹកនាំ អាសិប ក៏ បាន បញ្ជាក់ ជាថ្មី ថា កិច្ចព្រមព្រៀង អាសិប នៅតែ បើក ចំហ ទទួល ស្វាគមន៍ ភាគី ឥណ្ឌា ជានិច្ច នា ពេល អនាគត ខាងមុខ ។
ដើម ឡើយ ប្រទេស ដែល គ្រោយ នឹង ចង ជា សមាជិក នៃ កិច្ចព្រមព្រៀង នេះ មាន ចំនួន ១៦ ប្រទេស ក្នុង នោះ ប្រទេស សមាជិក អាស៊ាន ចំនួន ១០ និង ប្រទេស ក្នុង តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក៦ ផ្សេង ទៀត រួម មាន៖ ចិន ជប៉ុន កូរ៉េ ខាងត្បូង អូស្ត្រាលី នូវែលហ្សេឡង់ និង ឥណ្ឌា ។
ប៉ុន្តែ ក្នុង កិច្ចប្រជុំ នៅ ទីក្រុង បាងកក ប្រទេស ថៃ កាលពី ឆ្នាំ ២០១៩ កន្លងទៅ នេះ ប្រទេស ឥណ្ឌា បាន ដក ខ្លួន ចេញ ពី កិច្ចព្រមព្រៀង នេះ វិញ ។ ដោយ មាន ការលើកឡើង ថា ការដក ខ្លួន ព្រោះតែ ឥណ្ឌា បារម្ភ ខ្លាច ចាញ់ ប្រៀប លើ ការធ្វើ ពាណិជ្ជកម្ម ជាមួយ ចិន ។
ការចរចា លើ ការបង្កើត កិច្ចព្រមព្រៀង នេះ មាន ភាពស្មុគស្មាញ ច្រើន ហើយ ត្រូវ ចំណាយ ពេល ជាច្រើន ឆ្នាំ ព្រោះ ការ មិន ចុះសម្រុង គ្នា លើ ចំណុច មួយចំនួន រវាង ប្រទេស ជា សមាជិក ។ មកដល់ ចុង ឆ្នាំ ២០២០ នេះ ទើប កិច្ចព្រមព្រៀង នេះ ត្រូវបាន ចុះហត្ថលេខា ជា ផ្លូវការ ។
កិច្ចព្រមព្រៀង នេះ នឹង ក្លាយជា តំបន់ ពាណិជ្ជកម្ម សេរី ធំ បំផុត លើ ពិភពលោក ដោយ មាន ការប្តេជ្ញាចិត្ត បើក ទីផ្សារ សេវាកម្ម ការវិនិយោគ ការកាត់បន្ថយ ការធ្វើ បែបបទ គយ ។ កិច្ចព្រមព្រៀង នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ជំរុញ យ៉ាង ខ្លាំង ដល់ ការអភិវឌ្ឍ ខ្សែ ច្រវាក់ តម្លៃ ក្នុង តំបន់ និង ពិភពលោក ហើយ ជួយ សេដ្ឋកិច្ច នៃ បណ្តា ប្រទេស អាស៊ាន មាន ការវិវឌ្ឍ ផងដែរ ៕ ជន ក្រីក្រ ចាស់ជរា និង ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ១៥០ គ្រួសារ ទទួលបាន អំណោយ
( បន្ទាយមានជ័យ )៖ ជន ក្រីក្រ ចាស់ជរា និង ប្រជាពលរដ្ឋ រង គ្រោះ ដោយ ទឹក ជំនន់ មាន ចំនួន ១៥០ គ្រួសារ មកពី ក្នុង ក្រុង សិរី សោភ័ណ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ បាន ទទួល អំណោយ ពី ព្រឹទ្ធសភា រដ្ឋសភា និង សប្បុរសជន តាមរយៈ អភិបាល ក្រុង សេរី សោភ័ណ នៅ សាលាក្រុង សិរី សោភ័ណ ។
ក្នុង ពិធី ចែក អំណោយ នោះ លោក អ៉ី ឡុង សមាជិក រដ្ឋសភា បាន ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល ដែល សម្ដេច តែងតែ សម្ដែង ការព្រួយបារម្ភ និង គិតគូរ ពី សុខ ទុក្ខ របស់ បងប្អូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
លោក បាន បញ្ជាក់ ឲ្យដឹង បន្ត ទៀត ថា ចាប់ពី ទឹក ជន់ លិច ខេត្ត រហូតដល់ ទឹក ស្រក រដ្ឋបាល ខេត្ត រដ្ឋបាល ក្រុង រដ្ឋបាល ស្រុក រដ្ឋបាល ឃុំ - សង្កាត់ តែងតែ យកចិត្តទុកដាក់ ជួយ ឧបត្ថម្ភ ជា ស្បៀង ជំរក ដោះស្រាយ ដល់ បងប្អូន ប្រជាពលរដ្ឋ មាន ជន ក្រីក្រ ចាស់ជរា និង ជនរងគ្រោះ ដោយសារ ទឹក ជំនន់ ឲ្យ រួចផុត ពី ការលំបាក ជាច្រើន ម៉ឺន គ្រួសារ កន្លងមក ។
លោក បញ្ជាក់ ថា ម៉្យាងទៀត ទីណា ដែល បងប្អូន ជួប ទុក្ខលំបាក រដ្ឋបាល ខេត្ត ពុំ បាន ទៅ ផ្ទាល់ ក៏ បាន ចាត់តាំង ឲ្យ ក្រុមការងារ របស់ ខេត្ត ឲ្យ ចុះ ទៅ ជួប បងប្អូន ប្រជាពរដ្ឋ ដោយ ផ្ទាល់ និង ឲ្យ អាជ្ញាធរដែនដី សមត្ថកិច្ច ពាក់ព័ន្ធ ចូលរួម ជួយសង្គ្រោះ និង រំដោះ បងប្អូន ប្រជាពលរដ្ឋ ឲ្យ រួចផុត ពី គ្រោះ ទឹក ជំនន់ ថែមទាំង បាន ផ្ដល់ ស្បៀងអាហារ ឲ្យបាន គ្រប់គ្រាន់ ដោយ មិន ទុកឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ណា ម្នាក់ អត់ អាហារ ស្លាប់ ដោយ ពុំ បាន ដឹង ឮ ពី អាជ្ញាធរ នោះ ឡើយ ។
លោក បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ យ៉ាង ប្ដូរផ្ដាច់ ដើម្បី អនុវត្ត យុទ្ធសាស្ត្រ កំណែទម្រង់ ស៊ីជម្រៅ និង អភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ជាពិសេស វិស័យ កសិកម្ម ដែល កំពុងតែ ដើរតួរ នាទី យ៉ាង សំខាន់ ក្នុង ការជំរុញ ការអភិវឌ្ឍ សង្គម និង សេដ្ឋកិច្ច ជាតិ រក្សា នៅ សន្តិសុខ ស្បៀងអាហារ ជូន ប្រជាជន កម្ពុជា នឹង កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ នៅក្នុង សមរភូមិ សង្គ្រាម ប្រយុទ្ធ ប្រឆាំង និង ជំងឺ កូវីដ១៩ រួមទាំង ដោះស្រាយ បញ្ហា ប្រឈម ពី គ្រោះ ទឹក ជំនន់ ផងដែរ ។
លោក ក៏ បាន សំណូមពរ និង ណែនាំ ប្រជាកសិករ ទាំងអស់ ថា « ត្រូវ ចាប់ផ្តើម បង្កបង្កើន ផល ក្នុង ការស្តារ ឡើងវិញ នូវ ដំណាំ ស្រូវ របស់ បងប្អូន ហើយ បងប្អូន ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ បញ្ហា ជំងឺ កូវីដ១៩ គឺ ត្រូវ ធ្វើ អនាម័យ ឲ្យបាន ជាប្រចាំ ពីព្រោះថា ជំងឺ កូវីដ១៩ នេះ វា មិន ភ្លេច យើង ទេ មាន តែ យើង គ្រប់ គ្នា ទេ ភ្លេច ជំងឺ កូវីដ » ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបទេស ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា នេះ បាន បញ្ជាក់ ថា ប្រតិកម្ម ភ្លាម ៗ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បន្ទាប់ពី លោក រ៉ូបឺត អូប្រាយ អិន ជា ទីប្រឹក្សា សន្តិសុខ ជាតិ អាមេរិក បាន សម្តែង ការព្រួយបារម្ភ នេះ នៅក្នុង កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា លើក ទី ១៥ ។
លោក រ៉ូបឺត អូប្រាយ អិន លើកឡើង ថា « អាមេរិក ក៏ មាន ការព្រួយបារម្ភ ផងដែរ អំពី ផែនការ របស់ កម្ពុជា ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ សំរាប់ កងទ័ព ជើងទឹក បរទេស និង បុគ្គលិក របស់ គេ នៅឯ មូលដ្ឋាន កងទ័ព ជើងទឹក រាម នៅ ឈូង សមុទ្រ ថៃ ។ វត្តមាន កងទ័ព ជើងទឹក បរទេស នៅ កម្ពុជា នឹង ធ្វើឱ្យ ប៉ះពាល់ ដល់ ដំណើរការ នៃ ការដោះស្រាយ វិវាទ ដោយ សន្តិវិធី ការលើកកម្ពស់ សុវត្ថិភាព នាវាចរណ៍ និង សេរីភាព នៃ ការធ្វើ នាវាចរណ៍ និង ការហោះហើរ នៅក្នុង តំបន់ » ។
លោក សង្កត់ធ្ងន់ ថា « ផ្ទុយ ស្រឡះ ពី ការចោទប្រកាន់ ដែល ថា មជ្ឈមណ្ឌល នេះ ត្រូវ បិទ ចោល នាយក រដ្ឋមន្រ្តី របស់ ខ្ញុំ បាន អញ្ជើញ មិត្តភក្តិ បរទេស ដែល ចាប់អារម្មណ៍ ទាំងអស់ ឲ្យ ចូលរួម ធ្វើ ហិរញ្ញប្បទាន ទ្រទ្រង់ ដល់ មជ្ឈមណ្ឌល នេះ ។ យើង ស្វាគមន៍ ចំពោះ ការផ្តល់ ជំនួយ និង ការបន្ត ផ្តល់ ជំនួយ ពី សហរដ្ឋ អាមេរិក អូស្រ្តាលី កូរ៉េ ខាងត្បូង ជប៉ុន ចិន និង ប្រទេស ដទៃ ទៀត ដរាបណា ជំនួយ នេះ មិន រារាំង យើង ក្នុង ការអនុវត្ត សិទ្ធិ អធិបតេយ្យ របស់ ខ្លួន » ។
សូម ជម្រាប ថា កាលពី ចុង ខែតុលា ឆ្នាំ ២០២០ កន្លងទៅ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ធ្លាប់ បាន ថ្លែង បញ្ជាក់ ថា ទាំង ពួក បរទេស និង ជនជាតិ ខ្មែរ មួយចំនួន ដែល រុញ រឿង មូលដ្ឋាន ទ័ព ចិន នៅ កម្ពុជា នេះ គឺ មាន បំណង ចង់ ឈាន ទៅ ធ្វើ រដ្ឋប្រហារ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ធុញទ្រាន់ នឹង ពួក បរទេស និង ខ្មែរ មួយចំនួន ដែល ចោទ រឿង វត្តមាន ទ័ព ចិន នៅ កម្ពុជា ។ ប្រមុខ ដឹកនាំ កំពូល រាជ រដ្ឋាភិបាល កម្ពុជា បាន ស្នើ ពួក បរទេស និង ខ្មែរ ដែល ចោទ លើ រឿង នេះ បញ្ចេញ ភស្តុតាង បើ មិន បញ្ចេញ ទេ គឺ មាន ន័យ ថា កំពុង ភូតកុហក ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ១៤ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៣៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៩ នាក់ នោះ មាន ១៣នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ០៧ ករណី និង ជនសង្ស័យ ២៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៦ករណី ។
អភិបាល ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្តាល ព្រមាន ចាត់ វិធានការ តាម ច្បាប់ អ្នក រំលោភ យក ដី សាធារណ របស់ រដ្ឋ និង ដី កម្មសិទ្ធិ ឯកជន ដោយ ត្រូវ ដក ខ្លួន ថយ ជា បន្ទាន់
ប៉ុន្តែ ទោះជា យ៉ាងណា ក្រុម ប្រជាពលរដ្ឋ ដែល កំពុង រំលោភ ដី គេ និង ដី រដ្ឋ នៅតែ រឹង ទទឹង បន្ត កាន់កាប់ ទីតាំង ដដែល ដែល បញ្ហា នេះ ឈានដល់ កម្រិត ប្រព័ន្ធ តុលាការ ចុះអនុវត្តន៍ វាស់វែង ស្វែង ការពិត កាលពី ថ្ងៃទី ១៣ ខែវិច្ឆិកា ដែល ប្រតិបត្តិការ នេះ ដឹកនាំ ដោយ តំណាង អយ្យការ អម សាលាដំបូង ខេត្ត កណ្ដាល ។
មន្រ្តី បាន បន្ត ទៀត ថា ការចុះ មក នេះ ក៏ ដើម្បី សិក្សា ឲ្យបាន ច្បាស់លាស់ ថា តើ នរណា រំលោភ ដី នរណា ហើយ ស្ថានភាព ពិតជា ដូច ការចោទ មែន ឬ មិន មែន និង ដើម្បី កំណត់ វាស់វែង មើល លើ ព្រុំ ដី ឲ្យ សមស្រប ទៅតាម ប្លង់ រឹង របស់ ម្ចាស់ ដី ដើម្បី បញ្ជៀស ការវាស់ ចូល ដី រដ្ឋ និង សិក្សា ថា ពលរដ្ឋ រំលោភ ចូល ដី គេ ក្នុង រូបភាព បែប ណា ជាដើម ។
ជាមួយគ្នា នេះ ក្រុម មន្រ្តី តុលាការ ក៏ បាន ពន្យល់ លម្អិត ដល់ ពលរដ្ឋ ឲ្យ យល់ ច្បាស់ ពី អ្វី ដែល ពួកគាត់ កំពុង ប្រព្រឹត្តិ មក លើ ដី រដ្ឋ និង ដី កម្មសិទ្ធិ ឯកជន របស់ អ្នកដទៃ ហើយ ថា បើសិនជា ករណី វាស់វែង កំណត់ ព្រុំ ដី ដាក់ បង្គោល បាន ត្រឹមត្រូវ ហើយ ហើយ ពលរដ្ឋ ធ្វើឲ្យ ខូចខាត ឬ បង្កើត បញ្ហា ទំនាស់ ណាមួយ ទៀត ពួកគាត់ អាចនឹង ត្រូវ ប្រឈម ផ្លូវ ច្បាប់ បើសិន ភាគី ម្ចាស់ ដី ប្ដឹង ទៅ តុលាការ លើ ករណី នេះ ។
ទោះ យ៉ាង នេះ ក្ដី ជាក់ស្ដែង នៅ យប់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ក៏ ស្រាប់ មាន ជនល្មើស មិន ស្គាល់ មុខ បាន នាំគ្នា មក វាយ កម្ទេច ផ្ដួល បង្គោល ព្រុំ ដី គេ ផងដែរ ។
បើ តាម តំណាង ពលរដ្ឋ ឈ្មោះ លោក ហ៊ិន ពន្លឺ និង អ្នកស្រី អ៊ាវ ស៊ីណាត បាន អះអាង ថា ពួកគាត់ ទាំង ២៨ គ្រួសារ មកកាន់កាប់ ស្នាក់ នៅលើ ប្រឡាយ ទឹក របស់ រដ្ឋ ដោយ ការចាក់ ដី លុប ហើយ កាន់កាប់ នេះ យូរ មកហើយ ដោយ ទទួលស្គាល់ ថា ពិតជា បាន រស់ នៅ លើ ដី រដ្ឋ ពិត មែន ប៉ុន្តែ ជំទាស់ ការរស់នៅ លើ ដី ឯកជន ឡើយ ហើយ បង្ហាញ ពី គោលជំហរ ថា មិន ព្រម ទទួលយក ដំណោះស្រាយ ឈ្នះ - ឈ្នះ អ្វី ទាំងអស់ គឺ សុខចិត្ត រស់នៅ លើ ដី នេះ ជា ដាច់ខាត បើ ទោះបី អាជ្ញាធរ បញ្ជាក់ ថា ចូល ក្បាល ដី ឯកជន របស់ គេ យ៉ាងណា ក្ដី ។
យោង តាម លោក Mark Timbal អ្នកនាំពាក្យ ទីភ្នាក់ងារ គ្រប់គ្រង គ្រោះមហន្តរាយ នៃ ប្រទេស ហ្វីលីពីន ការប៉ាន់ស្មាន ជា បឋម ការខូចខាត នៃ ភោគផល កសិកម្ម ដោយសារតែ ទឹក ជំនន់ បង្កឡើង ដោយ ព្យុះ Vamco មាន ទំហំ ប្រហែល ២៥ លាន ដុល្លារ ខណៈ ការខូចខាត ផ្នែក ហេដ្ឋារចនាសម្ព័ន្ធ មាន ទំហំ ប្រហែល ជិត ១០លាន ដុល្លារ ។ ចំណែក លំនៅឋាន ជិត ២៦.០០០ ខ្នង បាន ទទួលរង ការខូចខាត ។
ប៉ុន្មាន ឆ្នាំ កន្លងមក នេះ តៃវ៉ាន់ ត្រូវ គេ មើលឃើញ ថា ទទួលបាន ការគាំទ្រ យ៉ាង ខ្លាំងក្លា ពីសំណាក់ រដ្ឋាភិបាល ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ រួម មាន ដូចជា ការលក់ សព្វាវុធ កាន់តែ ច្រើន ឡើង និង ដំណើរទស្សនកិច្ច របស់ មន្រ្តី ជាន់ ខ្ពស់ អាមេរិក មកកាន់ ទីក្រុង តៃ ប៉ិ។ តៃវ៉ាន់ បាន បង្ហាញ ក្តីសង្ឃឹម ជុំវិញ ការបន្ត កិច្ចសហប្រតិបត្តិការ ជិតស្និទ្ធ ជាមួយ អាមេរិក បែប នេះ ដោយសារ ជ័យជម្នះ របស់ លោក បៃ ដិន ហាក់ បាន បង្ក ក្តី ព្រួយបារម្ភ មួយចំនួន នៅ តៃវ៉ាន់ ។
ក្នុង នាម ជា តំណាង របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ បន្ត ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា លើក ទី ១៥ តាម ប្រព័ន្ធ វីដេអូ នៅ ទីស្ដីការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា លើក ទី ១៥ បាន ផ្តោត ការពិភាក្សា ទៅ លើ ការពង្រឹង ស្មារតី សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ រវាង ប្រទេស នៅក្នុង តំបន់ អាស៊ី បូព៌ា និង ភាគី ពាក់ព័ន្ធ ដទៃ ទៀត ក្នុង ការដោះស្រាយ បញ្ហា នានា ដែល បណ្តាល មកពី វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ . ការស្តារ សង្គម - សេដ្ឋកិច្ច ឡើងវិញ តាមរយៈ ការប្រកាន់ ជំហរ ពាណិជ្ជកម្ម សេរី និង ការតភ្ជាប់ ឡើងវិញ នូវ ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ និង ផលិតកម្ម ក៏ ដូចជា រំហូរ វិនិយោគ នៅក្នុង តំបន់ ។
ថ្នាក់ដឹកនាំ នៃ ប្រទេស អាស៊ី បូព៌ា បាន សម្ដែង នូវ ការគាំទ្រ និង ប្តេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការកសាង អនាគត មួយ ប្រកប ដោយ សន្តិភាព . វិបុលភាព . ស្ថេរភាព . ចីរភាព និង បរិយាប័ន្ន ដោយ ប្រកាន់ខ្ជាប់ នូវ ស្មារតី ពហុ ភាគី និយម និង ការដោះស្រាយ បញ្ហា សកល ដោយ សន្តិវិធី ស្រប តាម គោលការណ៍ នៃ ច្បាប់ អន្តរជាតិ ។
ជា លទ្ធផល នៃ កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា លើក ទី ១៥. ថ្នាក់ដឹកនាំ អាស៊ី បូព៌ា បាន សម្រេច អនុម័ត ឯកសារ សំខាន់ ចំនួន ៥៖
ក្រសួង ការបរទេស បង្ហាញ លទ្ធផល នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន បូក បី លើក ទី ២៣ តាម ប្រព័ន្ធ វីដេអូ
( ភ្នំពេញ ) ៖ ក្នុង នាម ជា តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុន្នីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន បូក បី លើក ទី ២៣ ដែល បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
កិច្ចប្រជុំ បាន បញ្ជាក់ ជាថ្មី អំពី សារៈសំខាន់ នៃ យន្តការ អាស៊ាន បូក បី ដែល ជា វេទិកា ដ៏ សំខាន់ សម្រាប់ ការកសាង សហគមន៍ អាស៊ី បូព៌ា ។ ថ្នាក់ដឹកនាំ បាន សម្តែង សេចក្ដីសោមនស្ស ចំពោះ វឌ្ឍនភាព ក្នុង ការអនុវត្ត ផែនការការងារ នៃ កិច្ចសហប្រតិបត្តិការ អាស៊ាន បូក បី ( ២០១៨ - ២០២២) ។
ថ្នាក់ដឹកនាំ នៃ ប្រទេស អាស៊ាន បូក បី បាន ស្វាគមន៍ ការចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ភាពជា ដែគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ តំបន់ (RCEP) នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ដែល នឹង រួមចំណែក យ៉ាង សំខាន់ នៅក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង ស្ដារ សេដ្ឋកិច្ច ឡើងវិញ ។ បញ្ហា ផ្សេង ទៀត ដូចជា បញ្ហា ឧបទ្វីប កូរ៉េ និង កិច្ចសហប្រតិបត្តិការ លំហ សមុទ្រ ក៏ ត្រូវបាន ពិភាក្សា ផងដែរ ។
បន្ទាប់ពី កិច្ចប្រជុំ នេះ ថ្នាក់ដឹកនាំ អាស៊ាន បូក បី ក៏ បាន ជួប ជាមួយ ក្រុមប្រឹក្សា ធុរកិច្ច អាស៊ី បូព៌ា ដើម្បី ផ្លាស់ប្តូរ ទស្សនៈ អំពី ការពង្រឹង កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច ឱ្យ កាន់តែ ស៊ីជម្រៅ និង ដើម្បី លើក កម្ពស់ កំណើន សេដ្ឋកិច្ច ក្នុង តំបន់ នៅក្នុង ដំណាក់កាល នៃ ការស្តារ ឡើងវិញ ក្រោយពី វិបត្តិ កូវីដ - ១៩ ៕
ខាងក្រោម នេះ ជា លទ្ធផល ទាំងស្រុង នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន បូក បី លើក ទី ២៣ តាម ប្រព័ន្ធ វីដេអូ ដែល ប្រកាស ដោយ ក្រសួង ការបរទេ ស៖ ក្រុម អ្នកគាំទ្រ រាប់ ពាន់ នាក់ របស់ លោក ដូណាល់ ត្រាំ ប្រមូលផ្តុំ គ្នា ដង្ហែ ធ្វើ បាតុកម្ម នៅ រដ្ឋធានី វ៉ាស៉ីន តោន
( វ៉ាស៉ីន តោន ) ៖ ក្រុម អ្នកគាំទ្រ របស់ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ចំនួន ខ្ទង់ រាប់ ពាន់ នាក់ បាន ប្រមូលផ្តុំ គ្នា ដង្ហែ ក្បួន តវ៉ា នៅ រដ្ឋធានី វ៉ាស៉ីនតោន ដើម្បី គាំទ្រ ការអះអាង គ្មាន មូលដ្ឋាន របស់ លោក ដែល ថា មាន ការក្លែងបន្លំ សន្លឹក ឆ្នោត ក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី អាមេរិក អាណត្តិ ថ្មី ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន BBC នៅ ថ្ងៃអាទិត្យ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
គួរ បញ្ជាក់ ថា ការធ្វើ បាតុកម្ម ពីសំណាក់ ក្រុម អ្នកគាំទ្រ លោក ដូណាល់ ត្រាំ កើត មាន ឡើង ស្រប ពេល ដែល លោក ត្រាំ មកទល់ ឥឡូវ គឺ នៅតែ មិន ព្រម ទទួលស្គាល់ ជ័យជម្នះ គូ ប្រជែង របស់ ខ្លួន គឺ លោក ចូ បៃ ដិន ដែល ជា អ្នកទទួល ជ័យជម្នះ ក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី អាមេរិក អាណត្តិ ថ្មី ឡើយ ។ លោក ត្រាំ បាន ដាក់ពាក្យ តវ៉ា នៅ តាម រដ្ឋ សំខាន់ ៗ មួយចំនួន ជាមួយ ការចោទប្រកាន់ ថា មាន ការបន្លំ សន្លឹក ឆ្នោត ប៉ុន្តែ ការប្រឹងប្រែង របស់ លោក ហាក់ មិន ទទួលបាន ជោគជ័យ នោះ ទេ ៕
ដោយឡែក នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ក្រសួង សុខាភិបាល បាន ធ្វើតេស្ត អ្នក ប៉ះពាល់ ក្នុង ព្រឹត្តិការណ៍ ០៣វិច្ឆិកា បាន ចំនួន ១៣០០ សំណាក ដែល វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន ពិនិត្យ ធ្វើតេស្ត ចំនួន ១១៩៥ ដែល លទ្ធផល បង្ហាញ ថា អវិជ្ជមាន វីរុស កូវីដ - ១៩ ទាំងអស់ ។ ចំណែក វត្ថុ សំណាក វិភាគ ចំនួន ១០៥ ដែល នៅសល់ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា នឹង បន្ត ពិនិត្យ នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ បន្ត ទៀត ។
គិត ពី ថ្ងៃទី ០៤ ដល់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ សរុប ចំនួន តេស្ត ដែល បាន ធ្វើ វិភាគ មាន ៣៧៦២ វត្ថុ សំណាក ( ក្នុង ចំនួន នេះ មាន អ្នក ដែល បាន ធ្វើតេស្ត លើក ទី១ ចំនួន ១៧៤១ នាក់ និង លើក ទី២ បាន ចំនួន ៨២៥ នាក់ និង តេស្ត លើក ទី៣ បាន ចំនួន ១១៩៥ សំណាក ) ដោយ លទ្ធផល ពី វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន បង្ហាញ ថា មាន អ្នកវិជ្ជមាន វីរុស កូវីដ - ១៩ ចំនួន ០៤ នាក់ ដែល កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រម ប្រកាស ឲ្យ ប្រើ ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ អនុសញ្ញា ស្តីពី បត្យាប័ន រវាង កម្ពុជា និង បារាំង
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រម ប្រកាស ឲ្យ ប្រើ ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ អនុសញ្ញា ស្តីពី បត្យាប័ន រវាង រាជ រដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ បារាំង ។ នេះ បើ យោង តាម ព្រះរាជ ក្រម ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ ៕
សូម អាន ព្រះរាជ ក្រម ខាងក្រោម៖
បាក់ កញ្ចុះ លើ ទឹក ក្នុង ផ្ទះ វីឡា មួយ កន្លែង នៅ ខណ្ឌ សែនសុខ បណ្ដាល ឲស្ត្រី ម្នាក់ ស្លាប់
( ភ្នំពេញ ) ៖ ស្ត្រី ម្នាក់ ត្រូវបាន ស្លាប់ នៅក្នុង ទឹក បន្ទាប់ពី បាក់ កញ្ចុះ លើ ទឹក ក្នុង វីឡា មួយ កន្លែង ហេតុការណ៍ កើតឡើង នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នៅ ចំនុច ភូមិ សំរោង ទាវ សង្កាត់ ក្រាំង ធ្នង់ ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
សព ស្ត្រី រងគ្រោះ ឈ្មោះ ហ៊ុន សំបូរ អាយុ ៦១ ឆ្នាំ ជា ស្ត្រី មេមាយ ស្នាក់ នៅ ភូមិ កើត ហេតុ ខាង លើ ។ ក្រោយ កើត ហេតុ សមត្ថកិច្ច មូលដ្ឋាន នឹង អាជ្ញាធរ កំពុង រងវិធី ដើម្បី ស្រង់ ស្ត្រី រង ចេញ ពី ក្នុង ស្រះ ដែល ត្រូវ កញ្ចុះ កៀប ជាប់ នៅក្នុង ស្រះ នោះ ដើម្បី ប្រគល់ សព ឲ្យ សាច់ញាតិ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ៕
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រម ប្រកាស ឲ្យ ប្រើ ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ សន្ធិសញ្ញា ស្តីពី ការជួយគ្នា ទៅ វិញ ទៅ មក ផ្នែក ច្បាប់ ក្នុង វិស័យ ព្រហ្មទណ្ឌ រវាង កម្ពុជា និង កូរ៉េ ខាងត្បូង
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រម ប្រកាស ឲ្យ ប្រើ ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ សន្ធិសញ្ញា ស្តីពី ការជួយគ្នា ទៅ វិញ ទៅ មក ផ្នែក ច្បាប់ ក្នុង វិស័យ ព្រហ្មទណ្ឌ រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សាធារណរដ្ឋ កូរ៉េ ( កូរ៉េ ខាងត្បូង ) ។ នេះ បើ យោង តាម ព្រះរាជ ក្រម ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ ។
សូម បញ្ជាក់ ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី ការជួយគ្នា ទៅ វិញ ទៅ មក ផ្នែក ច្បាប់ ក្នុង វិស័យ ព្រហ្មទ ណ្មាន គោលបំណង កំណត់ អំពី ការជួយគ្នា ទៅ វិញ ទៅ មក ផ្នែក ច្បាប់ ក្នុង វិស័យ ព្រហ្មទណ្ឌ រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង រដ្ឋ បរទេស ទាក់ទង នឹង ដំណើរការ នីតិវិធី នានា ពាក់ព័ន្ធ នឹង បទល្មើស ព្រហ្មទណ្ឌ ព្រមទាំង ការបង្កក ការចាប់ យក និង ការរឹបអូស ទ្រព្យ ក្នុង គោលបំណង ដើម្បី ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ។
( ហ្សាការតា ) ៖ ក្រសួង សុខាភិបាល ឥណ្ឌូណេស៊ី នៅ ថ្ងៃសៅរ៍ ទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស ពី ការរកឃើញ កូវីដ១៩ ៥. ២៧២ ករណី ថ្មី ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ នេះ ធ្វើឱ្យ អ្នក ឆ្លង សរុប ទូទាំង ប្រទេស កើន ដល់ ៤៦៣. ០០៧ នាក់ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ី ន ហួ ។
បើ តាម ក្រសួង សុខាភិបាល ឥណ្ឌូណេស៊ី ក្នុង រយៈពេល ២៤ ម៉ោង ដូចគ្នា អ្នកជំងឺ ១១១ នាក់ ក៏ ត្រូវបាន គេ រាយការណ៍ ថា បាន ស្លាប់ ផងដែរ ធ្វើឱ្យ អ្នកស្លាប់ ដោយសារ កូវី ដ១៩ កើន ដល់ ១៥. ១៤៨ នាក់ ។ ក្រសួង បន្ថែម ទៀត ថា អ្នក ជាសះស្បើយ បាន កើន ដល់ ៣៨៨. ០៩៤ នាក់ បន្ទាប់ពី អ្នកជំងឺ ៣.០០០ នាក់ បាន ជាសះស្បើយ និង ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ នៅ ថ្ងៃសៅរ៍ នេះ ។
គួរ បញ្ជាក់ ថា ខណៈ ករណី ឆ្លង កូវីដ១៩ ប្រចាំ ថ្ងៃ នៅតែ បន្ត កើនឡើង ក្នុង កម្រិត ខ្ពស់ បំផុត ឥណ្ឌូណេស៊ី កាលពី ថ្ងៃសុក្រ ម្សិលមិញ ក៏ បាន ប្រកាស ដែរ ថា ខ្លួន មាន គម្រោង ចាប់ផ្ដើម យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ទ្រង់ទ្រាយ ធំ ទូទាំង ប្រទេស នៅ ត្រឹម ចុង ឆ្នាំ ២០២០ នេះ ៕ ចំណេះដឹង ទូទៅ៖ ប្រទេស ណា ដែល តូច ជាង គេ បំផុត ក្នុង ពិភពលោក ?
( កណ្ដាល ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី សំ តុលា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កណ្ដាល នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ចែក អាវ រងា ដល់ កម្លាំង ទូទាំង ខេត្ត កណ្ដាល ដោយ បាន ផ្ដាំផ្ញើ ឲ្យ អនុវត្ត តាម វិធានការណ៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ព្រមទាំង ឲ្យ ចូលរួម ផ្សព្វផ្សាយ នៅ តាម មូលដ្ឋាន របស់ ខ្លួន ជាប្រចាំ ដើម្បី ធ្វើ យ៉ាង ជួយ ទប់ស្កាត់ ជំងឺ នេះ កុំ ឱ្យ ឆ្លង ជា សហគមន៍ ជាដាច់ខាត ។
អាវ រងា ទាំង នេះ ជា អំណោយ របស់ សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ដល់ លោក លោកស្រី មេបញ្ជាការ រង នាយ រង សេនាធិការ ប្រធាន មន្ទីរ អនុប្រធាន មន្ទីរ នាយ ការិយាល័យ មេបញ្ជាការ មេបញ្ជាការ រង ក្រុង - ស្រុក ទាំង ១១ កង វរ អន្តរាគមន៍ និង នាយ ទាហាន នាយ ទាហាន រង ទាំងអស់ ចំណុះ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ បាន មានប្រសាសន៍ ថា ដំណាក់កាល នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រឹងប្រែង ទប់ស្កាត់ ខ្លាំង ណាស់ ហើយ កម្លាំង យើង ទាំងអស់ ក៍ ត្រូវ ប្ដេជ្ញា ចូលរួម អនុវត្ត ឲ្យបាន ល្អ បំផុត ពិសេស ត្រូវ ផ្សព្វផ្សាយ ដល់ ពលរដ្ឋ តាម មូលដ្ឋាន ជាប្រចាំ ដើម្បី ជូនដំណឹង ពួកគាត់ ឲ្យ ការពារ ខ្លួន ទាំងអស់ គ្នា ។
( ភ្នំពេញ ) ៖ នា ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស កម្ពុជា បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ លើ យានយន្ត សរុប ចំនួន ៨៧៣ គ្រឿង ទៀត ក្នុង នោះ មាន ម៉ូតូ ៦១២ គ្រឿង និង រថយន្ត ២៥២ គ្រឿង ។ នេះ បើ តាម ការបញ្ជាក់ របស់ ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន អគ្គ ស្នងការ រង និង ជា អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ រយៈពេល ១៩៩ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២១៤ .៩៨៦ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១៥៨ .៨៤០ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៥៦. ១៤៦ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ១៩៩ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ ស្លាប់ ០៦ នាក់ របួស ០៧ នាក់ ( របួស ធ្ងន់ ០៤ នាក់ ) ។
អំណោយ ម៉ាស ចំនួន ២លាន និង បរិក្ខារ ពេទ្យ មួយចំនួន របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ជូន រដ្ឋាភិបាល ឡាវ បាន រៀបចំ ដាក់ លើ យន្តហោះ សម្រាប់ ត្រៀម ចេញ ដំណើរ នៅ ព្រឹក ស្អែក
( ភ្នំពេញ ) ៖ អំណោយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ជូន រដ្ឋាភិបាល ឡាវ រួម មាន ម៉ាស ចំនួន ២លាន និង បរិក្ខារ ពេទ្យ សរុប ចំនួន ១២មុខ បាន រៀបចំ លើក ដាក់ លើ យន្តហោះ នៅ រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ នា ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ ដើម្បី ត្រៀម ចេញ ដំណើរ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ស្អែក នេះ ។
លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ថ្លែង ថា « ពេលនេះ យើង កំពុង រៀបចំ សម្ភារ បរិក្ខារ ពេទ្យ មួយចំនួន និង ម៉ាស ជាង ២លាន ម៉ាស ទម្ងន់ សរុប ២១តោន ដែល សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ជូន រដ្ឋាភិបាល ឡាវ សម្រាប់ ប្រើប្រាស់ ក្នុង ការបង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ដាក់ ចូល លើ យន្ដ យោះ ដើម្បី ត្រៀម ចេញ ដំណើរ ទៅ ព្រឹក ស្អែក នេះ » ។
ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់តាំង សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ ជា តំណាង ដើម្បី ដឹកនាំ គណៈប្រតិភូ នាំយក អំណោយ ម៉ាស ចំនួន ២លាន និង បរិក្ខារ ពេទ្យ ទាំង នេះ យក ទៅ ជូន រដ្ឋាភិបាល និង ប្រជាជន ឡាវ នៅ ព្រឹក ថ្ងៃចន្ទ ទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។ នេះ បើ តាម ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ប្រាប់ លោក លឹម ជា វុត្ថា នាយក ប្រតិបត្តិ អង្គភាព ព័ត៌មាន Fresh News នា ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
ក្នុង សារ រំលែក ទុក្ខ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ចាត់ទុក ថា « មរណភាព របស់ ចាន់ សម្បត្តិ គឺ មិន ត្រឹមតែ ជា ការបាត់បង់ ឧត្តម ស្វាមី បិតា ជាទីគោរព ស្រឡាញ់ ប្រកប ដោយ ព្រហ្មវិហារ ធម៌ និង ទឹកចិត្ត សន្តោស ប្រណី ដ៏ ថ្លៃថ្លា មិន ចេះ រីងស្ងួត ចំពោះ លោកស្រី និង បុត្រ ប៉ុណ្ណោះ ទេ តែ ក៏ ជា ការបាត់បង់ មន្ត្រី ជំនាញ ដ៏ ឆ្នើម មួយ រូប ដែល បាន បំពេញ ភារកិច្ច ពោរពេញ ដោយ ស្នាដៃ សម្រាប់ វិស័យ មីន និង គុណ បំណាច់ ជា ច្រើន ក្នុង គោលបំណង ជួយ ដល់ សហគមន៍ ក្រោយ បោសសម្អាត មីន » ។
ស្ថិត ក្នុង មរណទុក្ខ ដ៏ ក្រៀមក្រំ នេះ កាកបាទ ក្រហម កម្ពុជា សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ លោក ចាន់ សម្បត្តិ បាន ចាប់ បដិសន្ធិ ក្នុង សុគតិភព កុំបី ឃ្លៀង ឃ្លាត ឡើយ ៕
គួរ បញ្ជាក់ ថា សម្រាប់ ប្រទេស ១០ផ្សេង ទៀត ដែល មាន អ្នក ឆ្លង COVID-19 ខ្ទង់ លាន នាក់ ដែរ នោះ គឺ សហរដ្ឋ អាមេរិក ឥណ្ឌា ប្រេស៉ីល បារាំង រុស្ស៉ី អេស៉្បាញ ចក្រភព អង់គ្លេស អាហ្សង់ទីន កូឡុំប៊ី និង អ៉ីតាលី ៕
អភិបាល ខណ្ឌ ព្រែក ព្នៅ ចុះ ចែក ម៉ាស់ ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន ជូន ពលរដ្ឋ ក្រីក្រ នៅ សង្កាត់ ពន្សាំង
( ភ្នំពេញ ) ៖ លោក សុខ សម្បត្តិ អភិបាល ខណ្ឌ ព្រែក ព្នៅ និង លោក ម៉ៅ បូរ៉ា ប្រធាន ក្រុម បឹ្រក្សា ខណ្ឌ ព្រែក ព្នៅ ព្រមទាំង មន្រ្តី រាជការ ក្នុង ខណ្ឌ នា ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ បាន ចុះ ចែក ម៉ាស់ ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ នៅ សង្កាត់ ពន្សាំង ខណ្ឌ ព្រែក ព្នៅ ។
ក្នុង ឱកាស នេះ ដែរ លោក អភិបាល ខណ្ឌ បាន ចែក ម៉ាស ដល់ ប្រជាពលរដ្ឋ ក្នុង ម្នាក់ ទទួលបាន ម៉ាស ២ និង បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ត្រូវ មាន ការប្រុងប្រយ័ត្ន និង ការពារ ឱ្យ បាន ត្រឹមត្រូវ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ស្តីពី ការទប់ស្កាត់ និង ការបង្កា ជំងឺ កូវីដ - ១៩ ជាពិសេស ត្រូវ ប្រកាន់ភ្ជាប់ នៅ ការរស់នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត ។
លោក បាន បន្ត ថា ទីណា ប្រជាពលរដ្ឋ មាន ទុក លំបាក ទីនោះ មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី ចុះ ជួយ ៕ ព័ត៌មាន សំខាន់ ៗ ចំនួន ១០ប្រចាំ សប្តាហ៍ សម្រាប់ ថ្ងៃអាទិត្យ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ
