( ភ្នំពេញ ) ៖ ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ បញ្ចប់ គោរមងារ អ្នក ឧកញ៉ា ពី លោក ហ៊ី គឹម ហុង ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស ។
គួរ រំឭក ថា លោក ហ៉ី គឹម ហុង ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ផ្ដល់ គោរមងារ ជា អ្នក ឧកញ៉ា កាលពី ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២២ ។
សូម បញ្ជាក់ ថា កម្លាំង ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ចាប់ខ្លួន ឧកញ៉ា ហ៉ី គីម ហុង ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស និង ក្រុម អង្គរក្ស សរុប ១៤នាក់ ពាក់ព័ន្ធ ករណី បោកប្រាស់ ប្រជាពលរដ្ឋ កាលពី រសៀល ថ្ងៃទី ៧ ខែសីហា ឆ្នាំ ២០២៣ នៅ ស្នាក់ការ ក្រុមហ៊ុន ពិភព ដី មាស ស្ថិត ក្នុង ភូមិ ត្រពាំង ថ្លាន់ សង្កាត់ ពន្សាំង ខណ្ឌ ព្រែក ព្នៅ ។
ការចាប់ខ្លួន ឧកញ៉ា ម្ចាស់ ក្រុមហ៊ុន ពិភព ដី មាស រូប នេះ ធ្វើឡើង តាម ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន របស់ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។ នៅពេល ចុះ អនុវត្ត ដីកា ក្រុម អង្គរក្ស លោក បាន រារាំង សមត្ថកិច្ច និង បាន ប្រើ ហិង្សា ទៅ លើ កម្លាំង សមត្ថកិច្ច ផងដែរ ។
តែ ក្រោយ ជាប់ ពន្ធនាគារ បាន ប៉ុន្មាន ខែ លោក ត្រូវបាន ដោះលែង ឲ្យ នៅ ក្រៅ ឃុំ វិញ ខណ: ដែល បញ្ហា របស់ ប្រជាពលរដ្ឋ ដែល ចាញ់បោក បុគ្គល រូប នេះ មិន ទាន់ ដោះស្រាយ ចេញ នៅឡើយ ៕
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ នៅក្នុង ឱកាស ចម្រើន ព្រះជន្ម ថ្ងៃទី ១៤ ខែឧសភា
( ភ្នំពេញ ) ៖ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន កិត្តិយស ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ បាន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នៅក្នុង ឱកាស ខួប ចម្រើន ព្រះជន្ម គម្រប់ ៧១ យាង ចូល ៧២ ព្រះវស្សា ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃអង្គារ ៧កើត ខែពិសាខ ឆ្នាំ រោង ឆស័ក ព .ស . ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៤ ខែឧសភា ឆ្នាំ ២០២៤ ។
( ភ្នំពេញ ) ៖ ឧកញ៉ា នួន រិទ្ធី ប្រធាន ក្រុមប្រឹក្សាភិបាល ក្រុមហ៊ុន KFA Group និង ជា ទីប្រឹក្សា សភា ពាណិជ្ជកម្ម កម្ពុជា និង លោកជំទាវ សូម គោរព អបអរសាទរ អ្នក ឧកញ៉ា ទ្រី ភាព ក្នុង ឱកាស ដែល អ្នក ឧកញ៉ា ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រោស ព្រះរាជ ទាន គោរមងារ ជា « លោក អ្នក ឧកញ៉ា » តាម សេចក្តីក្រាបបង្គំទូល ថ្វាយ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
គោរមងារ លំដាប់ថ្នាក់ ទី១ ដ៏ ខ្ពង់ខ្ពស់ បំផុត និង ឧត្តុង្គឧត្តម ប្រកបដោយ មហា កិត្តិយស នេះ គឺ ពិតជា ស័ក្តិសម និង ជា សក្ខីភាព ឆ្លុះបញ្ចាំង អំពី គុណ វុឌ្ឍិ ដែល លោក អ្នក ឧកញ៉ា បាន លះបង់ ទាំង កម្លាំង កាយ កម្លាំងចិត្ត ប្រាជ្ញា ស្មារតី និង ធនធាន ជាច្រើន ដើម្បី ចូលរួម បម្រើ ឧត្តម ប្រយោជន៍ ជូន ជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា ទាំង ក្នុង វិស័យ សេដ្ឋកិច្ច សង្គមកិច្ច សាសនា និង មនុស្សធម៌ នា ពេល កន្លងមក ។
ខ្ញុំបាទ សូម ចូលរួម អបអរសាទរ និង សូម គោរព ជូនពរ លោក អ្នក ឧកញ៉ា និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ ទាំងមូល សូម ប្រកបដោយ សិរី មង្គល វិបុល សុខ និង ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ណែនាំ ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ ទាំង ១៤ នៃ ស្រុក មេមត់ បន្ត ពង្រឹង និង ពង្រីក សមាជិក រក្សា សាមគ្គីភាព ផ្ទៃក្នុង បន្ត ការអភិវឌ្ឍ ក្នុង មូលដ្ឋាន
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ សមាជិក គណៈកម្មាធិការ គណបក្ស ថ្នាក់ កណ្តាល ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ខេត្ត និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក មេមត់ បាន ណែនាំឲ្យ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ ទាំង ១៤ នៃ ស្រុក មេមត់ បន្ត ពង្រឹង និង ពង្រីក សមាជិក រក្សា សាមគ្គីភាព ផ្ទៃក្នុង រចនាសម្ពន្ធ ក្តាប់ ឲ្យបាន និង ដោះស្រាយ រាល់ សំណើ សំណូម របស់ ប្រជាពលរដ្ឋ ជាពិសេស បន្ត ការអភិវឌ្ឍ ក្នុង មូលដ្ឋាន ។
លោក ណែនាំ បែប នេះ ក្នុង ពិធី ប្រកាស ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ ទាំង ១៤ នៃ ស្រុក មេមត់ នៅ ស្នាក់ការ គណបក្ស ប្រជាជន ស្រុក មេមត់ នា ព្រឹក ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២៤ ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ប្រគល់ សេចក្តីសម្រេច តែងតាំង ប្រធាន អនុប្រធាន សមាជិក សមាជិកា ក្រុមការងារ គណបក្ស ប្រជាជន ចុះ មូលដ្ឋាន ឃុំ ទាំង ១៤ ក្នុង ស្រុក មេមត់ ព្រមទាំង សាទរ ចំពោះ ក្រុមការងារ ទាំងអស់ ៤៥៧ នាក់ ផងដែរ ។
លោក ប្រធាន បាន ផ្តាំផ្ញើ សមាជិក សមាជិកា ទាំងអស់ ទាំង ១៤ឃុំ បន្ត ផ្សព្វផ្សាយ យុទ្ធសាស្ត្រ បញ្ចកោណ - ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជាពិសេស ត្រូវ ស្រុះ ស្រួល ឯកភាព ប្រកបដោយ ឆន្ទៈ មុត ស្រួច បន្ត ពង្រឹង កិច្ចការងារ រចនាសម្ពន្ធ ត្រូវ មាន របប ជីវភាពប្រជុំ ប្រចាំ ខែ ដើម្បី ដឹង សកម្មភាព អ្វី ខ្លះ បាន ដឹង សំណូមពរ ពលរដ្ឋ ដើម្បី ដោះស្រាយ ។
លោក បាន បន្ថែម ថា ចំពោះ បញ្ហា ដោះ បាន ដោះ តែ ដោះ មិន បាន សូម ផ្តល់ ព័ត៌មាន មក ក្រុមការងារ ថ្នាក់ ខេត្ត គឺ នៅ ចាំ ជួយ គាំទ្រ ព្រមទាំង ក្រើន រំលឹក ត្រូវតែ រក្សា ខ្សែក្រវាត់ ឲ្យបាន បន្ត យក ឲ្យ សំឡេង គាំទ្រ មិន ឲ្យ មាន ការថមថយ នោះ ទេ ។
