( បាត់ដំបង ) ៖ អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង ខេត្ត បាត់ដំបង បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការឃាត់ខ្លួន ឈ្មោះ ភូ សុវណ្ណ ថា ប្រធាន គណៈកម្មាធិការ ប្រតិបត្តិ គណបក្ស ភ្លើង ទៀន ប្រចាំ ខេត្ត បាត់ដំបង ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ដឹកនាំ កិច្ចប្រជុំ ត្រៀម រៀបចំ ការពារ សន្តិសុខ និង ពិធី ហែ ព្រះសព សម្តេច ព្រះអគ្គមហាសង្ឃរាជធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស ដែល នឹង ធ្វើឡើង នៅ ថ្ងៃទី ៣ ខែមិថុនា ខាងមុខ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា អនុប្រធាន អនុគណៈកម្មការ កាំ ជ្រូច កង កិត្តិយស តែ ទ័ព ការពារ សន្តិសុខ និង សុវត្ថិភាព រៀបចំ ពិធី ហែ ព្រះបរម សព សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិឧទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ដឹកនាំ កិច្ចប្រជុំ ត្រៀម រៀបចំ ពិធី ហែ ព្រះបរម សព សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិឧទេស បណ្ឌិត ទេព វង្ស ។
កិច្ចប្រជុំ នេះ នា រសៀល ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ តំណាង ក្រសួង ស្ថាប័ន មួយចំនួន នៅ បន្ទប់ ប្រជុំ ទីស្តីការ ក្រសួង ការពារ ជាតិ ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន គូសបញ្ជាក់ ថា កិច្ចប្រជុំ នា ឱកាស នេះ គឺ ធ្វើឡើង ដើម្បី ស្នើសុំ ឱ្យ មាន ការចូលរួម ពី គ្រប់ ក្រសួង ស្ថាប័ន ពាក់ ទាំងអស់ ពិនិត្យ លទ្ធភាព ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ពិធី ហែ ព្រះសព សម្តេច ព្រះអគ្គមហាសង្ឃរាជធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល នឹង ធ្វើឡើង នៅ ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០២៤ ឱ្យ ប្រព្រឹត្តទៅ ដោយ រលូន ស្រប តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា និង តាម រាជប្បវេណី ។
អនុប្រធាន អនុគណៈកម្មការ កាំ ជ្រូច កង កិត្តិយស តែ ទ័ព ការពារ សន្តិសុខ និង សុវត្ថិភាព រៀបចំ ពិធី ហែរ ព្រះបរម សព សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិឧទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា មាន ភារកិច្ច ដូច ខាងក្រោម៖
គួរឱ្យដឹង ថា ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណា ចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ស្តេច សព្វ ព្រះរាជ ហឫទ័យ យាង ជា ព្រះរាជា ធិបតី ក្នុង ព្រះរាជ ពិធី ថ្វាយ ព្រះភ្លើង ព្រះបរម សព ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០២៤ វេលា ម៉ោង ៨:៣០ នាទី ព្រឹក ។
ព្រះរាជ ពិធី ហែ និង ថ្វាយ ព្រះភ្លើង ព្រះបរម សព សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស នឹង ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃចន្ទ ១២ រោង ខែ ពិសាខ ឆ្នាំ រោង ឆស័ក ព .ស .២៥៦៨ ត្រូវនឹង ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០២៤ វេលា ម៉ោង ៦:០០ នាទី ព្រឹក ចេញ ពី វត្ត ឧណ្ណាលោម ឆ្ពោះទៅ ព្រះមេរុ មុខ វត្ត បទុមវតី រាជ វរា រាម ចម្ងាយ ផ្លូវ ៥គីឡូ និង ៣០០ ម៉ែត្រ ប្រើ រយៈពេល ២ ម៉ោង ៕
លោក អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ និង អនុប្រធាន សមាជិក ក្រុមប្រឹក្សាភិបាល សមាជិក ទាំងអស់ នៃ សមាគម ឧកញ៉ា កម្ពុជា និង មន្ត្រី គ្រប់ ជាន់ ថ្នាក់ ចេញ ញត្តិ ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ការអនុវត្ត គម្រោង ជីក ព្រែក ហ្វូណន - តេជោ
( ភ្នំពេញ ) ៖ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា កម្ពុជា នៅ ព្រឹក ថ្ងៃចន្ទ ទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ បាន អនុញ្ញាតឱ្យ លោកស្រី ទួត បញ្ញា ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ចក្រភព អង់គ្លេស អៀរឡង់ ដាណឺម៉ាក ស៊ុយអែត ន័រវែស និង ហ្វាំងឡង់ ចូល ជួប សម្តែង ការគួរសម ដើម្បី ជម្រាប លា និង ទទួល អនុសាសន៍ នៅ មុនពេល លោកស្រី ត្រូវ ចេញ ទៅ បំពេញ បេសកកម្ម ការ ទូត ។
សម្តេច រដ្ឋសភា ធិបតី បាន សម្តែង ក្តី សោមនស្ស រីករាយ និង មាន មោទនភាព ជា ទីបំផុត ដែល លោកស្រី ទួត បញ្ញា ទទួលបាន សេចក្តីទុកចិត្ត ពី រាជ រដ្ឋាភិបាល ក្នុង ការតែង តំាង ជា ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ បណ្តា ប្រទេស ចំនួន ៦ នៅ ប៉ែក អឺរ៉ុប ។ សម្តេច បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សមត្ថភាព និង ទេពកោសល្យ របស់ លោកជំទាវ ដែល បាន បំពេញ បេសកកម្ម ក្នុង វិស័យ ការទូត និង ព័ត៌មាន តំាង ពី ទសវត្សរ៍ ឆ្នាំ ៨០មក ។
នៅក្នុង ឱកាស នោះ សម្តេច រដ្ឋសភា ធិបតី បាន ផ្តល់ ជា អនុសាសន៍ មួយចំនួន ដល់ លោកស្រី ឯក អគ្គ រាជ ទូត ដោយ ត្រូវ តម្កល់ ប្រយោជន៍ ជាតិ ជា ធំ ទោះ ក្នុង កាលៈ ទេសៈ ណា ក៏ដោយ ត្រូវ រក្សា ការពារ និង លើក តម្លៃ ជាតិ ជានិច្ច ។ ត្រូវ យកចិត្តទុកដាក់ ជួយ សម្របសម្រួល និង ដោះស្រាយ បញ្ហា នានា របស់ ពលរដ្ឋ យើង ឱ្យ មាន ប្រសិទ្ធភាព និង ទាន់ ពេលវេលា តាមរយៈ ការពង្រឹង ទំនាក់ទំនង ឱ្យ បាន ខ្ជាប់ខ្ជួន ជាមួយ បងប្អូន ពលរដ្ឋ ខ្មែរ ជាដើម ។
( ពោធិ៍សាត់ )៖ ផ្ទះ ចំនួន ៦ខ្នង ដែល សាង់ សង់ ឡើង ជា ប្លង់ រួម តែ មួយ ដូច ៗ គ្នា ធ្វើ អំពី ដែក ប្រក់ ស័ង្គ សី ជញ្ជាំង ឥដ្ឋ មាន ទំហំ ៤x៨ម៉ែត្រ ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី តាមរយៈ លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ ត្រូវបាន បន្ត ប្រគល់ ជូន ជន ចាស់ជរា និង ជា គ្រួសារ ក្រីក្រ រស់ នៅក្នុង ស្ថានភាព ទីទ័ល ជួប ការលំបាក ខ្លាំង ក្នុង សង្កាត់ រលាប សង្កាត់ ចំរើន ផល សង្កាត់ លលកស ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។
ក្នុង ឱកាស នោះ លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ បាន ពាំនាំ ផ្តាំផ្ញើ ការសួរសុខទុក្ខ ពីសំណាក់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ជូន ដល់ លោកតា លោកយាយ ជា ជន ចាស់ជរា និង ជា គ្រួសារ ក្រីក្រ ដែល កំពុង រស់ នៅក្នុង ស្ថានភាព ទីទ័ល ជួប លំបាក ខ្លាំង ទាំង ៦គ្រួសារ ស្មើនឹង ៦ខ្នង ផ្ទះ ពោលគឺ មិន ទុក ឱ្យ ពួកគាត់ រស់ នៅ ដោយ ភ័យខ្លាច ឬ ខ្វះ ស្បៀង បរិភោគ ឡើយ ។
លោក ខូយ រីដា បាន ក្រើន រំលឹក ដល់ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ យកចិត្តទុកដាក់ មើល សុខ ទុក្ខ ប្រជាជន ឱ្យ បាន ជាប់ ជាប្រចាំ និង ព្យាយាម ជួយ បងប្អូន ទាំងអស់ នោះ ឱ្យ បាន ទាន់ ពេលវេលា នៅពេល គាត់ ជួប បញ្ហា ផ្សេង ៗ ចៀសវាង ការព្យាយាម លាក់ កំបាំង ព័ត៌មាន ដែល ធ្វើឱ្យ ពួកគាត់ មាន ការថ្នាំង ថ្នាក់ មក លើ ថ្នាក់ដឹកនាំ ។
គួរ ជម្រាប ជូន ថា គិត មកដល់ ពេលនេះ ផ្ទះ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ចំនួន ៨ខ្នង ហើយ ត្រូវបាន ប្រគល់ ជា បន្តបន្ទាប់ ជូន ដល់ ជនជាស់ជរា និង គ្រួសារ ក្រីក្រ រស់ នៅក្នុង ស្ថានភាព ទីទ័ល ជួប ការលំបាក ខ្លាំង ក្នុង ខេត្ត ពោធិ៍សាត់ ដែល ក្នុង នោះ រួម មាន៖
( ភ្នំពេញ ) ៖ លោក អ៊ុន ជឹម ប្រធាន គណបក្ស ឯកភាព ជាតិ ខ្មែរ បាន លើកឡើង ថា បុគ្គល សម រង្ស៉ី ជា ជន សរសៃ ប្រសាទ ផ្នែក នយោបាយ ក្រោយ បាត់បង់ អ្នកគាំទ្រ អស់ សូម្បី មនុស្ស ជំនិត របស់ ខ្លួន ។ ការចំអក បែប នេះ របស់ លោក អ៊ុន ជឹម ធ្វើឡើង បន្ទាប់ពី លោក សម រង្ស៉ី អះអាង ថា ថ្នាក់ដឹកនាំ និង សមាជិក ក្រុម ប្រឆាំង ដែល ចាកចេញ ពី ខ្លួន ទៅ ចូលរួម ជាមួយ គណបក្ស កាន់អំណាច នោះ ថា « ជា ការចូលរួម តែ សំបក » ។
ខាងក្រោម នេះ គឺជា ការលើកឡើង ទាំងស្រុង របស់ លោក អ៊ុន ជឹម ប្រធាន គណបក្ស ឯកភាព ជាតិ ខ្មែរ៖
ប្រជាពលរដ្ឋ នៅ ខេត្ត រតនគិរី ប្រមាណ ៦៥ % ទទួលបាន សេវា ហិរញ្ញវត្ថុ ពី គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ផ្លូវការ សម្រាប់ ពង្រីក អាជីវកម្ម
( រតនគិរី ) ៖ លោកស្រី ឌិត នីតា ប្រធាន សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន ថ្លែង ថា គិត មកទល់ ពេលនេះ ប្រជាពលរដ្ឋ នៅ ខេត្ត រតនគិរី ប្រមាណ ៦៥ % បាន ទទួល សេវា ហិរញ្ញវត្ថុ ពី គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ផ្លូវកា រ ដែល នេះ បញ្ជាក់ ពី វិសាលភាព នៃ ការផ្តល់ សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ដល់ ទី ជនបទ ដាច់ស្រយាល ជាពិសេស បងប្អូន ជនជាតិ ភាគ តិច ដើម្បី ចូលរួមចំណែក លើកកម្ពស់ បរិយា បន្ន ហិរញ្ញវត្ថុ និង កំណើន សេដ្ឋកិច្ច ជាតិ ។
លោកស្រី ឌិត នីតា លើកឡើង បែប នេះ ធ្វើឡើង នៅក្នុង នៅក្នុង សិក្ខាសាលា ថ្នាក់ ខេត្ត ស្តីពី « ការផ្សព្វផ្សារ សេវា ធនាគារ និង ហិរញ្ញវត្ថុ ផ្លូវការ ប្រកបដោយ ទំនួល ខុសត្រូវ និង កិច្ចការពារ អតិថិជន » ជា លើក ទី១ ជូន ដល់ អាជ្ញាធរ មូលដ្ឋាន នៅ ក្រុង បាន លុង និង ស្រុក អូរជុំ នៃ ខេត្ត រតនគិរី នា ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២៤ ។
លោកស្រី បាន ថ្លែង ថា វិស័យ មីក្រូ ហិរញ្ញវត្ថុ បាន ពង្រីក ប្រតិបត្តិការ របស់ ខ្លូន ព្រម បាន ផ្តល់ សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ដល់ ទី ជនបទ ជាពិសេស បងប្អូន ជនជាតិ ដើម ភាគ តិច ។
លោក តូច ចៅ ចេក សមាជិក ក្រុមប្រឹក្សាភិបាល នៃ សមាគម ធនាគារ នៅ កម្ពុជា បាន បន្ថែម ថា៖ « ការពង្រីក វិសាលភាព នៃ ការផ្តល់ សេវា ហិរញ្ញវត្ថុ នេះ បាន ជួយ ឱ្យ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ នៅក្នុង ខេត្ត រតនគិរី ផ្តល់ ការងារ ដល់ សិស្ស និស្សិត និង យុវជន ក្នុង ខេត្ត និង បាន ផ្តល់ ជា ប្រភព ទុន ដែល មាន អាត្រា ការប្រាក់ ទាប ដើម្បីឱ្យ ប្រជាពលរដ្ឋ យក ទៅ វិនិយោគ ក្នុង វិស័យ នានា និង បាន ចូលរួមចំណែក ក្នុង ការជំរុញ សេដ្ឋកិច្ច ក្នុង ខេត្ត រតនគិរី ឱ្យ មាន ការរីកចម្រើន ផងដែរ » ។
លោក បាន បញ្ជាក់ ផងដែរ ថា ស្ថិរភាព និង ភាពរឹងមាំ នៃ វិស័យ ធនាគារ និង ហិរញ្ញវត្ថុ គឺ មិន អាច កើតមាន ទេ ប្រសិនបើ គ្មាន ការគាំទ្រ ពី រាជ រដ្ឋាភិបាល កម្ពុជា ធនាគា ជាតិ នៃ កម្ពុជា និង ភាគី ពាក់ព័ន្ធ ។
លោក ក៏ បាន ផ្ដល់ អនុសាសន៍ ដល់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ក្នុង ខេត្ត រតនគិរី បន្ត កិច្ចសហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ក្នុង ខេត្ដ ក្នុង ការបន្ត ចូលរួម ពង្រឹង ការអប់រំ ដល់ ប្រជាពលរដ្ឋ និង កិច្ច គាំពារ អ្នកប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ប្រកបដោយ ភាពទន់ភ្លន់ និង ការទទួលខុសត្រូវ ខ្ពស់ ។
( ភ្នំពេញ ) ៖ ប្រធាន គណបក្ស ឯកភាព ជាតិ ខ្មែរ លោក អ៊ុន ជឹម បាន រំលឹក អំពី អំពើពុករលួយ និង កិបកេង របស់ បុគ្គល សម រង្ស៉ី ពាក់ព័ន្ធ នឹង លុយ ទូរទស្សន៍ ព្រះអាទិត្យ និង លើកឡើង ថា ទណ្ឌិត រូប នេះ ធ្វើ នយោបាយ ដើម្បី តែ ផលប្រយោជន៍ និង គំនុំ ផ្ទាល់ខ្លួន ។ ការបញ្ជាក់ របស់ លោក អ៊ុន ជឹម បាន ធ្វើឡើង នៅក្នុង កម្មវិធី Fresh Talk នា ថ្ងៃសៅរ៍ សប្ដាហ៍ កន្លងទៅ ក្រោម ប្រធានបទ « នយោបាយ ប្រឆាំង ផលប្រយោជន៍ ជាតិ និង បង្ក អសន្តិសុខ របស់ លោក សម រង្ស៉ី » ។
បន្ថែម ពី នេះ លោក អ៊ុន ជឹម បាន ឲ្យដឹង ថា នៅក្នុង តំបន់ ជើង នេះ គ្មាន ឡើយ អ្នកនយោបាយ ប្រឆាំង ណា ដែល ញុះញង់ ឲ្យ ប្រទេស គេ ផ្ដាច់ ជំនួយ ពី ប្រទេស របស់ ខ្លួន ដូច្នេះ បុគ្គល សម រង្ស៉ី ឡើយ ។
( ភ្នំពេញ ) ៖ លោក សន្ដិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ដ្រី និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ចេញ សេចក្ដី អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន ទាំងអស់ ប្រើប្រាស់ កម្មវិធី ទូរស័ព្ទ App «NoDrug» ដែល អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន បង្កើត និង ដាក់ ដំណើរការ ជា ផ្លូវការ ក្នុង គោលបំណង លើកកម្ពស់ ស្មារតី ជាតិ រួមគ្នា ក្នុង ការចូលរួម ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ។
តាមរយៈ សេចក្ដី អំពាវនាវ នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន បាន ឲ្យដឹង ថា កាលពី ថ្ងៃទី ៨ ខែឧសភា ឆ្នាំ ២០២៤ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ណែនាំ ជំរុញ និង លើកទឹកចិត្ត ដល់ មហាជន ទូទៅ ជាពិសេស យុវជន យុវនារី និស្សិត និង សិស្ស ឲ្យ ទាញយក និង ប្រើប្រាស់ ឲ្យបាន ទូលំទូលាយ នូវ កម្មវិធី ទូរស័ព្ទ ដៃ ។
ការទាញយក និង ប្រើប្រាស់ កម្មវិធី ទូរស័ព្ទ ដៃ NoDrug គឺ មាន ន័យ ថា បាន ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ៕
ការ បន្ត វេន ប្រពៃណី គ្រួសារ ក្នុង អក្សរ ផ្ចង់ មួយ ផ្ទាំង
លោក Xi Jinping តែងតែ ចងចាំ ជានិច្ច ថា " មិន ថា សម័យកាល ប្រែប្រួល យ៉ាងណា ទេ ទោះ ជីវិត ផ្លាស់ប្តូរ ប៉ុណ្ណា ក៏ដោយ យើង សុទ្ធតែ ត្រូវ យកចិត្តទុកដាក់ លើ ការកសាង គ្រួសារ យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ការអប់រំ ក្នុង គ្រួសារ និង ទំនៀមទម្លាប់ គ្រួសារ " ៕
សេព គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គម ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៣ ខែឧសភា៖ បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ៦១ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៦១ នាក់ ។
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ ក្នុង សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ បាន នាំគ្នា ចេញមក ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង លើ គម្រោង ព្រែក ជីក ហ្វូណន តេជោ ដែល នឹង ផ្ដល់ អត្ថប្រយោជន៍ យ៉ាង ច្រើន ចំពោះ សង្គមជាតិ និង ប្រជាជន កម្ពុជា ។
នា ឱកាស នោះ លោកស្រី មុំ ចាន់ ដានី និង ថ្នាក់ដឹកនាំ ព្រមទាំង មន្រ្តី ប្រជាពលរដ្ឋ រស់ នៅក្នុង សហគមន៍ នៃ សង្កាត់ គោក រកា ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ បាន ជួបជុំគ្នា ដើម្បី ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ គម្រោង ជា ប្រវត្តិសាស្ត្រ « ព្រែក ជីក ហ្វូណន - តេជោ » ដែល ផ្តល់ អត្ថប្រយោជន៍ ធំធេង ចំពោះ ជាតិ និង ប្រជាពលរដ្ឋ ខ្មែរ ទាំងមូល ។
ការជួបជុំគ្នា នេះ ដឹកនាំ ដោយ លោកស្រី មុំ ចាន់ ដានី ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ គោក រកា ក្នុង ខណ្ឌ ព្រែក ព្នៅ ។
លោកស្រី ថា « ក្នុង នាម មន្ត្រីរាជការ យើង គាំទ្រ យ៉ាង ពេញ ចំពោះ គម្រោង ព្រែក ជីក ហ្វូណន តេជោ នេះ ដើម្បីឲ្យ ក្លាយជា ចលនា ឯកភាព ជាតិ តែ មួយ » ។
គួរ បញ្ជាក់ ថា គម្រោង ព្រែក ជីក ហ្វូណន - តេជោ ជា ព្រែក ជីក ប្រវត្តិសាស្ត្រ លើក ទី១ នៅ កម្ពុជា ជា គំនិត ផ្តួចផ្តើម របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី និង បច្ចុប្បន្ន ជា ប្រធាន ព្រឹទ្ធសភា កម្ពុជា ហើយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បន្ត ស្នាដៃ និង ជំរុញ បន្ថែម ក្នុង ការអភិវឌ្ឍន៍ គម្រោង ព្រែក ជីក ហ្វូណន - តេជោ ឱ្យ សម្រេចបាន នា ពេល អនាគត ។
( ភ្នំពេញ ) ៖ សកម្មជន គណបក្ស ភ្លើង ទៀន និង ឆន្ទៈ ខ្មែរ ចំនួន ៥នាក់ បាន សម្រេចចិត្ត ដើរ ចេញពី បក្ស ចាស់ របស់ ខ្លួន ទៅ រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។ ការសម្រេចចិត្ត ប្តូរ ជីវិត នយោបាយ ពី បក្ស ប្រឆាំង ទៅ ចូលរួម ជាមួយ បក្ស កាន់អំណាច ដោយសារ ពួកគេ បាត់បង់ ជំនឿចិត្ត លើ ការដឹកនាំ របស់ បក្ស ប្រឆាំង ដែល មាន ជម្លោះ និង បែកបាក់ គ្នា ជាពិសេស មិន បាន ប្រកាន់ ស្មារតី តម្កល់ ប្រយោជន៍ ជាតិ ។
លោកស្រី កង ម៉ៅ បាន ឱ្យដឹង ថា លោកស្រី បាន ចូលរួម ធ្វើ សកម្មភាព នយោបាយ ជាមួយ បក្ស ប្រឆាំង យូរ ឆ្នាំ មកហើយ ។ តែ មកដល់ ពេលនេះ លោកស្រី បាត់បង់ ជំនឿចិត្ត ចំពោះ ការដឹកនាំ របស់ ថ្នាក់ដឹកនាំ បក្ស ដែល ធ្វើឱ្យ បក្ស មាន ការបែកបាក់ ផ្ទៃក្នុង និង ជម្លោះ ជា បន្តបន្ទាប់ ។
បន្ថែម ពីលើ នោះ ថ្នាក់ដឹកនាំ បក្ស មិន បាន ធ្វើ សកម្មភាព គោរព តាម អ្វី ជា គោលការណ៍ និង ស្មារតី ដែល តែងតែ អះអាង ថា តម្កល់ នូវ ប្រយោជន៍ ជាតិ នោះ ឡើយ ។
ទន្ទឹមនឹង លើក បង្ហាញ ចំណុច មិន ពេញចិត្ត ចំពោះ គណបក្ស ប្រឆាំង ដែល ខ្លួន ធ្លាប់ រួមរស់ លោកស្រី កង ម៉ៅ ក៏ បាន លើក បង្ហាញ គុណសម្បត្តិ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល នាំឱ្យ ខ្លួន សម្រេចចិត្ត រួមរស់ ជាមួយ ។ លោកស្រី កង ម៉ៅ បាន បង្ហាញ ការមើលឃើញ របស់ ខ្លួន ថា គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន មាន គោល នយោបាយ ច្បាស់លាស់ ទាំង ការដឹកនាំ បក្ស និង ការដឹកនាំ ជាតិ ។
ការដឹកនាំ ដ៏ ត្រឹមត្រូវបាន ធ្វើឱ្យ បក្ស ប្រជាជន កម្ពុជា កាន់តែ រឹងមាំ ក្លាយទៅជា បង្អែក ដ៏ រឹងមាំ ក្នុង កិច្ច កសាង និង អភិវឌ្ឍន៍ ជាតិ ។ បន្ថែម ពីលើ នោះ តាមរយៈ តួនាទី ជា អ្នកដឹកនាំ រាជ រដ្ឋាភិបាល បក្ស ប្រជាជន កម្ពុជា បាន ដាក់ចេញ គោល នយោបាយ មួយ ច្បាស់លាស់ កសាង និង អភិវឌ្ឍន៍ ជាតិ ឱ្យ មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ។
លោកស្រី កង ម៉ៅ បាន អំពាវនាវ ដល់ សមាជិក សមាជិកា គបណ បក្ស ប្រឆាំង ទាំងអស់ ឱ្យ ភ្ញាក់ រលឹក ចូលរួម កសាង ជាតិ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ៕
លោក បណ្ឌិត ហ៉ឺ វីរៈ ប្រកាស សមាសភាព ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កំពង់ត្រឡាច និង សំណេះសំណាល ជាមួយ អង្គ បោះឆ្នោត
( កំពង់ឆ្នាំង ) ៖ លោក បណ្ឌិត ហ៊ឺ វីរៈ ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កំពង់ត្រឡាច បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស សមាសភាព ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក និង ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ ទាំង១០ ស្រុក កំពង់ត្រឡាច ដែល ប្រព្រឹត្តទៅ នៅ ទីស្នាក់ការ គណបក្ស ស្រុក កំពង់ត្រឡាច ។
កម្មវិធី នេះ ត្រូវបាន ធ្វើឡើង នា ថ្ងៃអាទិត្យ ទី ១២ ខែឧសភា ឆ្នាំ ២០២៤ ម្សិលមិញ ដោយ មាន វត្តមាន អញ្ជើញ ចូលរួម ពី លោក លោកស្រី ថ្នាក់ កណ្តាល ថ្នាក់ ខេត្ត ថ្នាក់ ស្រុក ជា អនុប្រធាន សមាជិក សមាជិកា ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក និង ឃុំ ទាំង១០ នៃ ស្រុក កំពង់ត្រឡាច ព្រមទាំង លោក លោកស្រី ជា ប្រធាន អនុប្រធាន និង សមាជិក សមាជិកា នៃ គណៈកម្មាធិការ គណបក្ស ឃុំ ទាំង១០ សរុប ជាច្រើន រូប ។
ជាមួយគ្នា នោះ ដែរ លោក បណ្ឌិត បាន ផ្ញើ បន្ថែម ដល់ គណៈ សាខា គណបក្ស ភូមិ - ឃុំ ត្រូវ យកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត សូម រាយការណ៍ ជូន ទៅ ប្រធាន ក្រុមការងារ ចុះ តាម ឃុំ ឱ្យ បាន ដឹង ដើម្បី ក្រុមការងារ រៀបចំ ចុះ សួរសុខទុក្ខ និង ពាំនាំយក អំណោយ ជូន ដល់ ផ្ទះ ដោយ ផ្ទាល់ ដៃ ។
លោក បណ្ឌិត បាន ថ្លែង បន្ត អំពី ទិសដៅ ការងារ ក្នុង ឆ្នាំ ២០២៤ នេះ ត្រូវ ចុះ ស្រង់ ស្ថិតិ ប្រជាពលរដ្ឋ ដែល មាន អាយុ ១៨ ឆ្នាំ ចុះ ក្នុង បញ្ជី ឱ្យ បាន ច្បាស់លាស់ និង ត្រូវ រៀបចំ ធ្វើ អត្តសញ្ញាណប័ណ្ណ ធ្វើ ប័ណ្ណ សមាជិក ចូល បក្ស ត្រៀមបញ្ចូល ក្នុង បញ្ជី គ.ជ. ប ដើម្បី ត្រៀមលក្ខណៈ គ្រប់គ្រាន់ ក្នុង ការបោះឆ្នោត នា អាណត្តិ បន្តបន្ទាប់ ទៀត ។
ជា កិច្ច បញ្ចប់ ក៏ មាន ពិធី ប្រគល់ សេចក្តីសម្រេច ជូន ដល់ ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្នុង ឃុំ ទាំង១០ នៃ ស្រុក កំពង់ត្រឡាច រួម ជាមួយ សៀវភៅ ស្តីពី ស្រុក កំពង់ត្រឡាច នីតិកាល ទី៧ ២០២៣ - ២០២៨ ដែល ជា សៀវភៅ ចង ក្រង អំពី ទិន្នន័យ គណបក្ស ស្រុក កំពង់ត្រឡាច ទាំងមូល ទីតាំង មណ្ឌល រដ្ឋបាល និង ពត៌មាន ផ្សេង ៗ ជាច្រើន ទៀត ៕
អគ្គ បញ្ជាការដ្ឋាន កងទ័ព ធ្វើ សន្និសីទ សារព័ត៌មាន ទាក់ទង នឹង សមយុទ្ធ យោធា នាគ មាស រវាង កងទ័ព កម្ពុជា - ចិន លើ ទឹកដី កម្ពុជា
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ទោ ថោង សូលីម៉ូ អ្នកនាំពាក្យ អគ្គ បញ្ជាការដ្ឋាន នៃ កងយោធពល ខេមរភូមិន្ទ នៅ រសៀល ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន រៀបចំ ធ្វើ សន្និសីទ សារព័ត៌មាន ទាក់ទង នឹង ការធ្វើ លំហាត់ សមយុទ្ធនាគ មាស ឆ្នាំ ២០២៤ ជា សមយុទ្ធ ទ្រង់ទ្រាយ ធំ លើក ទី៦ រវាង កងយោធពល ខេមរភូមិន្ទ ជាមួយ កងទ័ព រំដោះ ប្រជាជន ចិន ។
សម្រាប់ លំហាត់ សមយុទ្ធ យោធា រវាង កងទ័ព កម្ពុជា និង ចិន នេះ នឹង ធ្វើឡើង ក្រោម វិធាន បទ « ប្រតិបត្តិការ ប្រឆាំង អំពើ ភេរវកម្ម រួម និង ការសង្រ្គោះ មនុស្សធម៌ » ចាប់ពី ថ្ងៃទី ១៦ ដល់ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២៤ នៅ ភ្នំ ជុំ សែន រីករាយ ខេត្ត កំពង់ឆ្នាំង និង ខេត្ត ព្រះសីហនុ ។
ដោយឡែក សម្រាប់ ឆ្នាំ ២០២៣ កងទ័ព ទាំង ពីរ មាន ធ្វើ លំហាត់ សមយុទ្ធ រួមគ្នា ចំនួន ៤លើក ផងដែរ រួម មាន ទី១៖ លំហាត់ សមយុទ្ធនាគ មាស លើក ទី៤. ទី ២៖ លំហាត់ សមយុទ្ធ ទេវតា សន្តិភាព . លំហាត់ សមយុទ្ធ មាតុភូមិ ដ៏ បវរ ដែល ធ្វើឡើង លើ ទឹក កម្ពុជា និង ទី៤៖ លំហាត់ សមយុទ្ធ សន្តិភាព - មិត្តភាព លំហាត់ នេះ បាន ធ្វើឡើង លើ ទឹកដី ប្រទេស ចិន ។
កម្ពុជា - ចិន បាន បង្កើត ទំនាក់ទំនង រយៈពេល ៦៦ ឆ្នាំ មកហើយ ។ ភាគី ទាំង ពីរ បាន ដំឡើង កម្រិត ទំនាក់ទំនងជា បន្តបន្ទាប់ រហូត ក្លាយជា ដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ និង កំពុង រួមគ្នា កសាង សហគមន៍ រួម វាសនា តែ មួយ ៕ លោក ឌុច គន្ធា ដាក់ ចេញ ផែនការ៤ចំណុច ធំ ៗ ដើម្បី អនុវត្ត សកម្មភាព ប្រយុទ្ធ ប្រឆាំង ត្រួតពិនិត្យ គ្រឿងញៀន ក្នុង ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក ឌុច គន្ធា អភិបាល រង ខេត្ត បាន ដាក់ចេញ ផែនការ៤ចំណុច ធំ ៗ ដើម្បី អនុវត្ត សកម្មភាព ប្រយុទ្ធ ប្រឆាំង ត្រួតពិនិត្យ គ្រឿងញៀន ក្នុង ខេត្ត ព្រៃវែង ។ ការដាក់ចេញ ផែនការ បែប នេះ បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល លោក អភិបាល រង ខេត្ត ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា ស្ដីពី ការផ្ដល់ នូវ បច្ចុប្បន្នភាព ការងារ អនុវត្ត សកម្មភាព ប្រយុទ្ធ ប្រឆាំង ត្រួតពិនិត្យ គ្រឿងញៀន ក្នុង ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ ។
ផែនការ ទាំង ៤ នោះ រួម មាន៖
ទី១៖ រៀបចំ ផែន ផ្សព្វផ្សាយ ការប្រយុទ្ធ ប្រឆាំង នឹង គ្រឿង នៅ តាម បណ្ដាល ក្រុង ស្រុក ។ ទី ២៖ ត្រូវ ចុះ ស្រង់ បូកសរុប ទិន្នន័យ អំពី ក្លឹប កំសាន្ត ខារ៉ាអូខេ ហាង ហូបចុក ផ្សេង ៗ ដើម្បី ចុះ ផ្សព្វផ្សាយ គ្រឿងញៀន ។ ទី ៣៖ ត្រូវ អនុវត្ត នឹង ចាត់តាំង ការផ្សព្វផ្សាយ បញ្ហា គ្រឿងញៀន ។ ទី ៤៖ ចាត់តាំង អនុវត្ត តាម ប៉ុស្តិ៍ ធ្វើ ការផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលាយ ។
លោក ឌុច គន្ធា ក៏ បាន បញ្ជាក់ ថា កន្លងមក រាជ រដ្ឋាភិបាល បាន ចាត់ វិធានការ ក្នុង ការត្រួតពិនិត្យ គ្រឿងញៀន ទៅ លើ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស ក្នុង ករណី បើ រកឃើញ មាន មន្ត្រីរាជការ កង កំលាំង ណា ដែល មាន សារធាតុ ញៀន នឹង ត្រូវ បណ្ដេញចេញ ពី ក្របខណ្ឌ តែម្តង ។
លោក វរៈ សេនីយ ឯក ពៅ ជីវ័ន នាយ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន ខេត្ត ក៏ បាន លើកឡើង ដែរ ថា កន្លងមក ស្នងការដ្ឋាន នគរបាល ខេត្ត បាន បង្ក្រាប គ្រឿងញៀន បាន ចំនួន ៩៥ ករណី ឃាត់ខ្លួន បាន ចំនួន ២១៩ នាក់ ស្រី ២១ នាក់ ដកហូត ថ្នាំ ញៀន បាន ៤៨៣ កញ្ចប់ ស្មើរ និង ៧ គឺ ឡូ ៨៧២.៧០ ក្រាម ដោយ គិត ត្រឹម ឆមាស ទី១នេះ ។
នៅក្នុង កិច្ចប្រជុំ នៅ ផងដែរ ក៏ មាន ការលើកឡើង ជា មតិ យោបល់ បញ្ហា ប្រឈម យ៉ាង ផុល ផុស អំពី បញ្ហា គ្រឿងញៀន នេះ ឡើង នៅ តាម បណ្ដាល ក្រុង ស្រុក របស់ ខ្លួន ដែល បាន ជួបប្រទះ ហើយ ក្នុង នោះ សមត្ថកិច្ច ក៏ បាន ធ្វើ ការអប់រំ ផ្សព្វផ្សាយ ដែល នាំ និង បង្ក្រាប បាន ជា បន្តបន្ទាប់ ផងដែរ ។
( ភ្នំពេញ ) ៖ ប្រធាន គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ លោក អ៊ុន វិសិទ្ធ គុន បាន លើកឡើង ថា មកទល់ ពេល បច្ចុប្បន្ន នេះ ទណ្ឌិត សម រង្ស៉ី ទាល់ច្រក នៅក្នុង ការធ្វើ នយោបាយ កាន់តែ ខ្លាំង ប្ដូរ ពី ធ្លាប់ មាន អ្នកគាំទ្រ ច្រើន ឥលូវ បាត់បង់ អ្នកគាំទ្រ អស់ ទើប សាកល្បង ទៅ ធ្វើ នយោបាយ ស្រប តាម គំនិត របស់ វៀតណាម វិញ ក្រែង ទទួលបាន ផលប្រយោជន៍ តាមរយៈ ប្រឆាំង គម្រោង ជីក ព្រែក ហ្វូន ណន តេជោ ។ លោក បាន លើកឡើង បែប នេះ នៅក្នុង កម្មវិធី Fresh Talk នា ថ្ងៃសៅរ៍ សប្ដាហ៍ កន្លងទៅ ។
ពាក់ព័ន្ធ នឹង ការបាត់បង់ ប្រជាប្រិយភាព នេះ លោក អ៊ុន វិសិទ្ធ គុន បាន បញ្ជាក់ ថា ក៏ ដោយសារតែ បុគ្គល រូប នេះ បោកប្រាស់ ទាំង ទំនុកចិត្ត និង ថវិកា រហូត អ្នកគាំទ្រ ស្មោះស្ម័គ្រ ខ្លះ លះបង់ ទ្រព្យសម្បត្តិ ខ្លួន ដើរ តាម មេដឹកនាំ ដូច លោក សម រង្ស៉ី រហូត ត្រូវ អស់ ទាំង ទ្រព្យ អស់ ទាំង ក្រុមគ្រួសារ រស់ នៅ និរាស ព្រាត់ប្រាស គ្នា ដល់ បច្ចុប្បន្ន ។
សូម ទស្សនិកជន ទស្សនា កិច្ចពិភាក្សា ទាំងស្រុង ដូចត ទៅ៖
ទេសរដ្ឋមន្រ្តី អៀង មូលី អញ្ជើញ បើក កិច្ចប្រជុំ ស្តីពី ការឆ្លើយតប នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ លើ ផ្នែក សុខាភិបាល
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្រ្តី អៀង មូលី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ បាន បើក នូវ កិច្ចប្រជុំ ស្តីពី ការឆ្លើយតប នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ លើ ផ្នែក សុខាភិបាល នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នៅ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ។ កិច្ចប្រជុំ ត្រូវ អញ្ជើញ ចូលរួម ពីសំណាក់ លោក លោកស្រី ជា ក្រុមការងារ នៃ គណៈកម្មាធិការ ប្រយុទ្ធ ជំងឺ អេដស៍ របស់ ក្រសួង សុខាភិបាល ដែល ដឹកនាំ ដោយ លោក អ៊ឹង ភី រុន ប្រធាន គណៈកម្មាធិការ ប្រយុទ្ធ ក្រសួង សុខាភិបាល ។
កិច្ចប្រជុំ នេះ មាន គោលបំណង សំខាន់ ៗ ដូច ខាងក្រោម៖
ទី១៖ សមិទ្ធផល ឆ្លើយតប នឹង មេរោគ អេដស៍ ប្រទេស កម្ពុជា ដែល សម្រេចបាន កន្លងមក ក្នុង វិស័យ សុខាភិបាល ទី ២៖ ពិនិត្យ នូវ ឋាម វ័ន្ត នៃ ប្រព័ន្ធ រួមគ្នា ក្នុង ការឆ្លើយតប នឹង មេរោគ អេដស៍ ទី ៣៖ ពិនិត្យ និង អនុវត្ត នូវ វិធានការ នៃ នូវ គោល នយោបាយ ជាតិ បញ្ចប់ អេដស៍ និង ចីរភាព កម្មវិធី អេដស៍ ក្នុង វិស័យ សុខាភិបាល ។
លោក ទេសរដ្ឋមន្រ្តី អៀង មូលី ប្រធាន អាជ្ញាធរ ជាតិ បាន ថ្លែង នូវ ការកោតសរសើរ ដល់ ក្រសួង សុខាភិបាល ដែល បាន ប្រឹងប្រែង ចូលរួម ក្នុង ការអនុវត្ត ការឆ្លើយតប នឹង មេរោគ អេដស៍ កន្លងមក ។ ក្នុង ឱកាស នេះ លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន បញ្ជាក់ ពី តួនាទី ភារកិច្ច របស់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ស្រប តាម អនុក្រឹត្យ លេខ ១០៩ ផងដែរ ។ ជា បន្ត លោក ទេសរដ្ឋមន្រ្តី ប្រធាន អង្គប្រជុំ បាន អនុញ្ញាតិ ឱ្យ មាន ការបង្ហាញ ដូច ខាងក្រោម៖
* បទ បង្ហាញ ស្តីពី ឋាមវន្ត នៃ ការឆ្លើយតប នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ ដោយ លោក វេជ្ជបណ្ឌិត . ទា ផលា អនុប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ដោយ បាន បង្ហាញ ដូច ជា៖ សារ បាន និង បុព្វហេតុ នៃ ការឆ្លើយតប នឹង មេរោគ អេដស៍ ការចូលរួម ហិរញ្ញប្បទាន ពី ប្រភព នានា និង ការកំណត់ អាទិភាព នៃ បញ្ហា នានា ព្រមទាំង បង្ហាញ ពី ការរួមបញ្ចូល គ្នា ប្រកបដោយ ឋាម វ័ន្ត ។ លោក ក៏ បាន បង្ហាញ វិធាន នៃ ការសម្របសម្រួល ក្នុង វិស័យ សុខាភិបាល ដើម្បី ឈានទៅ សម្រេចបាន នូវ គោលដៅ នៃ ការឆ្លើយតប នឹង មេរោគ អេដស៍ ។
លោក អ៊ឹង ភី រុន ប្រធាន គណៈកម្មាធិការ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ បាន ថ្លែង នៅក្នុង កិច្ចប្រជុំ នោះ ថា សូម អនុញ្ញាតិ គ្រប់ ស្ថាប័ន ក្រោម ឱវាទ ក្រសួង ត្រូវ សហការ ជាមួយ អាជ្ញាធរ ជាតិ ក្នុង ការតាមដាន និង អនុវត្ត ការឆ្លើយតប នឹង មេរោគ អេដស៍ ។ គណៈកម្មាធិការ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ក្រសួង អាច រាយការណ៍ ជូន អាជ្ញាធរ ជាតិ រៀងរាល់ ១ ត្រីមាសម្តង ។
អភិបាល ស្រុក ស្ទោង ណែនាំ រដ្ឋបាល ឃុំ ត្រូវ ផ្ដល់ ប័ណ្ណ សមធម៌ ប្រកបដោយ តថ ភាព ជាក់ស្ដែង បំផុត
( កំពង់ធំ )៖ លោក សាយ គឹម ឡម អភិបាល ស្រុក ស្ទោង ណែនាំ រដ្ឋបាល ឃុំ ត្រូវ ផ្ដល់ ប័ណ្ណ សមធម៌ ប្រកបដោយ តថ ភាព ជាក់ស្ដែង បំផុត ។
លោក សាយ គឹម ឡម បាន ថ្លែង ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ប្រគល់ ប័ណ្ណ សមធម៌ ជូន ពលរដ្ឋ ក្រីក្រ និង ងាយ រង ហានិភ័យ ស្ថិត នៅក្នុង ឃុំ ពពក ស្រុក ស្ទោង ខេត្ត កំពង់ធំ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ ។
លោក បាន ណែនាំ ដល់ នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល និង លោក មេឃុំ ពពក ត្រូវ សហការ គ្នា ជាមួយ អធិការដ្ឋាន នគរបាល ស្រុក ស្ទោង ក្នុង ការពន្លឿន និង ធ្វើ សៀវភៅ គ្រួសារ ក៏ ដូចជា ឯកសារ អត្រានុកូលដ្ឋាន ផ្សេង ៗ ទៀត ជូន ពុក ម៉ែ បងប្អូន ប្រជាពលរដ្ឋ ឲ្យបាន ជិត និង ដល់ ផ្ទះ ពលរដ្ឋ តែម្ដង ដើម្បី ឆ្លើយតប ទៅនឹង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក៏ដូចជា ការចូលរួម កាត់បន្ថយ ភាពក្រីក្រ ជូន ពលរដ្ឋ នៅក្នុង មូលដ្ឋាន បានជាក់លាក់ ផងដែរ ។
លោក បាន អំពាវនាវ ដោយ ទទូច ដល់ ពុក ម៉ែ បងប្អូន នៅក្នុង មូលដ្ឋាន សូម នាំគ្នា ថែរក្សា ធនធាន ធម្មជាតិ ពិសេស ព្រៃឈើ នៅក្នុង ឃុំ ពពក ក៏ ដូចជា ស្រុក ស្ទោង ទាំងមូល ឲ្យបាន នូវ គង់វង្ស ទុក ជា កេរ ដំណែល មនុស្សជាតិត ទៅ ។
គួរ បញ្ជាក់ ថា ប័ណ្ណ សមធម៌ ដែល ប្រគល់ ជូន ពុក ម៉ែ បងប្អូន នៅក្នុង ឱកាស នេះ មាន ចំនួន ១៦៧ប័ណ្ណ ក្នុង នោះ គ្រួសារ ក្រីក្រ១ ចំនួន ១៣ប័ណ្ណ គ្រួសារ ក្រីក្រ ២ចំនួន ៩៦ប័ណ្ណ និង គ្រួសារ រង ហានិភ័យ ចំនួន ៥៨ប័ណ្ណ ៕ បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៥នាក់ និង របួស ១៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៣ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ១៦ នាក់ ។
អគ្គ លេខាធិការ អាស៊ាន ចូលរួម ការតាំងពិព័រណ៌ រូបថត អាស៊ាន - អូស្ត្រាលី ទទួល សារ តាំងពី ទូត វៀតណាម និង ជួប ទូត បណ្តា ប្រទេស អាមេរិក ឡាទីន ប្រចាំ អាស៊ាន
នៅក្នុង ឱកាស នោះ លោក អគ្គ លេខាធិការ អាស៊ាន បាន សង្កត់ធ្ងន់ ថា តាមរយៈ ការតាំងពិព័រណ៌ រូបថត ប្រកបដោយ អត្ថន័យ នេះ អាស៊ាន និង អូស្ត្រាលី ពិតជា អាច ឆ្លុះបញ្ចាំង ពី សមិទ្ធផល នា ពេល កន្លងទៅ ដែល រួម មាន កិច្ចសហប្រតិបត្តិការ ដែល មាន ប្រយោជន៍ ទៅ វិញ ទៅ មក ក្នុង វិស័យ ជាច្រើន នៅក្រោម ក្របខណ្ឌ នៃ ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - អូស្ត្រាលី ។
នៅក្នុង ជំនួប សំដែង ការគួរសម ក្រោយពី ពិធី ជូន សារ តាំង លោក អគ្គ លេខាធិការ អាស៊ាន បាន អបអរសាទរ លោកស្រី បណ្ឌិត Ton Thi Ngoc Huong សម្រាប់ តួនាទី ថ្មី និង បាន បង្ហាញ ពី ទំនុកចិត្ត ចំពោះ សមត្ថភាព របស់ គាត់ ក្នុង ការចូលរួមចំណែក យ៉ាង ធំធេង ដល់ ការកសាង សហគមន៍ និង កិច្ច ខិតខំ ប្រឹងប្រែង ធ្វើ សមាហរណកម្ម របស់ អាស៊ាន ។ លោក ទទួលស្គាល់ ថា បទពិសោធន៍ ដ៏ សម្បូរបែប របស់ លោកជំទាវ នៅក្នុង អាស៊ាន ពិតជា មាន តម្លៃ ចំពោះ កិច្ចការ និង សមត្ថកិច្ច របស់ គណៈកម្មាធិការ តំណាង អចិន្ត្រៃយ៍ ប្រចាំ អាស៊ាន (CPR) ។
អគ្គ លេខាធិការ អាស៊ាន បាន កោតសរសើរ វៀតណាម សម្រាប់ តួនាទី ប្រកបដោយ ប្រសិទ្ធភាព ក្នុង នាម ជា ប្រទេស សម្របសម្រួល សម្រាប់ ទំនាក់ទំនង ដៃគូ សន្ទនា អាស៊ាន - សាធារណរដ្ឋ កូរ៉េ និង បាន ជូន ពរ ឱ្យ វៀតណាម ទទួលបាន ជោគជ័យ សម្រាប់ តួនាទី ជា ប្រទេសម្របសម្រួល ទំនាក់ទំនង ដៃគូ សន្ទនា អាស៊ាន - ចក្រភព អង់គ្លេស ដែល នឹង ចាប់ផ្តើម នៅ ខែសីហា ឆ្នាំ ២០២៤ ខាងមុខ ។
លោក បណ្ឌិត កៅ គឹម ហួន ក៏ បាន កោតសរសើរ វៀតណាម សម្រាប់ គំនិត ផ្តួចផ្តើម រៀបចំ វេទិកា អនាគត អាស៊ាន កាលពី ថ្ងៃទី ២៣ ខែមេសា ឆ្នាំ ២០២៤ ដែល លោក បាន ចូលរួម ផ្តល់ សន្ទរកថា រួម ជាមួយ ឥស្សរជន អាស៊ាន សំខាន់ ៗ ផ្សេង ទៀត ។ វេទិកា អនាគត អាស៊ាន នេះ ត្រូវបាន ប្រព្រឹត្តទៅ ចំពេលវេលា ក្នុង គោលបំណង ផ្តល់ នូវ ទស្សនៈ ផ្សេង ៗ សម្រាប់ ចក្ខុវិស័យ សហគមន៍ អាស៊ាន ឆ្នាំ ២០៤៥ និង លើស ពី ឆ្នាំ ២០៤៥ ។
អគ្គ លេខាធិការ អាស៊ាន បាន បញ្ជាក់ សា ជា ថ្មី នូវ ការត្រៀមខ្លួន ជាស្រេច របស់ លេខាធិការដ្ឋាន អាស៊ាន ក្នុង ការគាំទ្រ លោកស្រី Ton Thi Ngoc Huong និង ស្ថាន បេសកកម្ម អចិន្ត្រៃយ៍ របស់ វៀតណាម ប្រចាំ អាស៊ាន ដោយ ផ្តោត លើ ការបន្ត សហការ និង កិច្ចសហប្រតិបត្តិការ រវាង CPR និង លេខាធិការដ្ឋាន អាស៊ាន ដើម្បី សម្រេចបាន គោលបំណង និង គោលដៅ របស់ អាស៊ាន សម្រាប់ ឆ្នាំ ២០២៥ និង លើស ពី ឆ្នាំ ២០២៥ ។
អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ធំ ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការផ្ទេរ សមត្ថកិច្ច សំណុំរឿង ពាក់ព័ន្ធ នឹង ឈ្មោះ ស៊ុន ចន្ធី . អ៉ី សារៀម និង ត្រឹក ញឿន មក តុលាការ ក្រុង ភ្នំពេញ
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ របស់ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការផ្ទេរ សមត្ថកិច្ច សំណុំរឿង ពាក់ព័ន្ធ នឹង ឈ្មោះ ស៊ុន ចន្ធី ឈ្មោះ អ៉ី សារៀម និង ឈ្មោះ ត្រឹក ញឿន ពី ខេត្ត កំពង់ធំ ទៅកាន់ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ វិញ ។
ក្រោយពី ដំណើរការ ស៊ើបអង្កេត យ៉ាង ល្អិតល្អន់ តំណាង អយ្យការ បាន ធ្វើ ការបើក ការស៊ើបសួរ និង ស្នើឲ្យ ដាក់ ស្ថិត នៅក្រោម ការពិនិត្យ ទៅ លើ ឈ្មោះ ស៊ុន ចន្ធី . ឈ្មោះ អ៉ី សារៀម . និង ឈ្មោះ ត្រឹក ញឿន ពី បទ ឆ បោក តាម មាត្រា ៣៧៧ និង មាត្រា ៣៧៨ នៃ ក្រម ព្រហ្មទណ្ឌ ឆ្នាំ ២០០៩ ។ ប៉ុន្តែ កាលពី ថ្ងៃទី ០៩ ខែឧសភា ឆ្នាំ ២០២៤ ឈ្មោះ ស៊ុន ចន្ធី ត្រូវបាន សមត្ថកិច្ច ធ្វើ ការចាប់ខ្លួន និង ឃាត់ខ្លួន នៅ រាជធានី ភ្នំពេញ ពាក់ព័ន្ធ នឹង បទល្មើស មួយ ផ្សេង ទៀត ។
អ្នកនាំពាក្យ របស់ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ធំ បាន បញ្ជាក់ ទៀត ថា ដើម្បី ធានា ដល់ ប្រយោជន៍ សាធារណៈ សុវត្ថិភាព សន្តិសុខ សង្គម និង ដំណើរការ ល្អ ក៏ ដូចជា ភាព ឆាប់រហ័ស នៃ យុត្តិធម៌ តុលាការ តំណាង អយ្យការ បាន ធ្វើ ការស្នើសុំ ការអនុញ្ញាត ដើម្បី ផ្ទេរ សំណុំរឿង ព្រហ្មទណ្ឌ លេខ ១៧៣ ចុះ ថ្ងៃទី ១៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ របស់ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ធំ ទៅ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ វិញ តាមរយៈ លិខិត លេខ ១០៩៧ ក យ. រប/ ២៤ ចុះ ថ្ងៃទី ១០ ខែឧសភា ឆ្នាំ ២០២៤ របស់ ក្រសួង យុត្តិធម៌ ។
នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ ស្ថាប័ន អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ធំ ក៏ បាន បញ្ជូន សំណុំរឿង ខាងលើ មកដល់ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ ជា សមត្ថកិច្ច រួចរាល់ ផងដែរ ៕ ឯកឧត្តម វង្សី វិស្សុត ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម ៧១ យាង ចូល ៧២ ព្រះវស្សា
( ភ្នំពេញ ) ៖ ឯកឧត្តម វង្សី វិស្សុត ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ទទួលបន្ទុក ទីស្តីការ គណៈ រដ្ឋមន្រ្តី និង មន្ត្រីរាជការ ទាំងអស់ បាន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា នៅក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម គម្រប់ ៧១ យាង ចូល ៧២ ព្រះវស្សា ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃអង្គារ ៧កើត ខែពិសាខ ឆ្នាំ រោង ឆស័ក ព .ស . ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៤ ខែឧសភា ឆ្នាំ ២០២៤ ។
នា ឱកាស ប្រកបដោយ សិរី មង្គល ដ៏ ឧត្តុង្គឧត្តម នេះ ទូលព្រះបង្គំ យើងខ្ញុំ ទាំងអស់ គ្នា សូម សម្តែង នូវ កតញ្ញូតាធម៌ ដ៏ ជ្រាលជ្រៅ បំផុត ថ្វាយ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ដែល ជានិច្ច ព្រះអង្គ តែង យក ព្រះទ័យ ទុកដាក់ អស់ ពី ព្រះកម្លាំង ព្រះកាយ ពល និង ព្រះបញ្ញាណ បំពេញ ព្រះរាជ សកម្មភាព ដ៏ ឧត្តុង្គឧត្តម បម្រើ ជាតិ មាតុភូមិ និង ប្រជារាស្ត្រ ជាទី ស្រលាញ់ ដ៏ ជ្រាលជ្រៅ របស់ ព្រះអង្គ ។
ក្រុម ជម្លៀស បាន ធ្វើ ការ មិន ឈប់ឈរ ពេញ មួយ ថ្ងៃ ដើម្បី ទទួលយក អ្នកស្រុក ភៀសខ្លួន ដែល ភាគ ច្រើន ជា មនុស្ស ចាស់ ចេញ ពី ផ្លូវ គ្រោះថ្នាក់ ។
ទាហាន អ៊ុយក្រែន បាន និយាយ ថា នេះ គឺជា យុទ្ធសាស្ត្រ របស់ រុស្ស៊ី ដោយ ធ្វើ ការ វាយលុក ក្នុង ពេល ដែល កម្លាំង អ៊ុយក្រែន មាន ចំនួន មិន ដល់ កម្លាំង រុស្ស៊ី ទាំង កម្លាំង ទាហាន និង ចំនួន គ្រាប់ រំសេវ ។
លោក Mick Ryan បាន និយាយ ថា ក្នុង ពេល ច្រើន សប្តាហ៍ ខាងមុខ នេះ វា នឹង ក្លាយជា រឿង អាក្រក់ មួយ សម្រាប់ កងកម្លាំង ជើង គោក អ៊ុយក្រែន នា ភាគ ខាងកើត ប្រទេស ។ លោក ថ្លែង បន្ត ថា គ្រា ដែល ការវាយប្រហារ នា ពេលនេះ មើល ទៅ ដូចជា មាន ទ្រង់ទ្រាយ តូច ប៉ុន្តែ គោលបំណង នៃ ការវាយប្រហារ របស់ រុស្ស៊ី គឺ ដើម្បី ធ្វើឱ្យ ទាហាន អ៊ុយក្រែន និង ប្រជាជន ស៊ីវិល ផងដែរ ធ្លាក់ ទឹកចិត្ត និង បាត់បង់ ស្មារតី ក្នុង ការប្រយុទ្ធ ជាមួយនឹង រុស្ស៊ី ។
ក្នុង កិច្ចប្រជុំ ប្រទេស ទាំង ពីរ គ្រោង នឹង ពិភាក្សា គ្នា លើ ប្រធានបទ ជាច្រើន រួមទាំង ហានិភ័យ ផ្នែក បច្ចេកវិទ្យា ដែល ទាក់ទង នឹង AI និង ទិដ្ឋភាព នៃ អភិបាលកិច្ចសកល ដែល ពាក់ព័ន្ធ នឹង ការអភិវឌ្ឍន៍ និង ការដាក់ ឱ្យ ប្រើប្រាស់ បច្ចេកវិទ្យា AI ព្រមទាំង បញ្ហា ផ្សេង ទៀត ដែល ជា កង្វល់ រៀង ៗ ខ្លួន ផងដែរ ។
ក្រសួង បាន ឱ្យដឹង ទៀត ថា កិច្ចប្រជុំ នេះ កើត ចេញពី ការឯកភាព គ្នា នៅក្នុង កិច្ចប្រជុំ កំពូល នៅ សាន់ហ្វ្រាន់ស៊ីស្កូ រវាង មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ក្នុង គោលបំណង បកប្រែ កិច្ចព្រមព្រៀង ទាំងនោះ ទៅជា ជំហាន ដែល អាច អនុវត្ត បាន ៕
ក្រុមការងារ គណបក្ស ចុះ ជួយ ខណ្ឌ និង គណបក្ស ខណ្ឌ ៧មករា រួមគ្នា ប្តេជ្ញា ដណ្ដើម ជ័យជម្នះ នៅក្នុង ការបោះឆ្នោត នា ពេល ខាងមុខ
( ភ្នំពេញ ) ៖ នា រសៀល ថ្ងៃចន្ទ ទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នៅ មន្ទីរ គណបក្ស ខណ្ឌ ៧មករា មាន ការរៀបចំ « ពិធី សំណេះសំណាល ជាមួយ សមាជិក គណបក្ស នៅក្នុង សង្កាត់ ទាំង៨ នៃ ខណ្ឌ ៧មករា ដើម្បី ពិភាក្សា ការងារ ត្រៀម លក្ខណៈ ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ អាណត្តិ ទី៤ ឆ្នាំ ២០២៤ » ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក នួន ផារ័ត្ន សមាជិក គណៈកម្មាធិការ កណ្តាល អនុប្រធាន គណបក្ស រាជធានី និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខណ្ឌ ៧មករា និង មាន ការចូលរួម ជា គណៈអធិបតី ពី សំណាក់ លោក - លោកស្រី អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ខណ្ឌ . លោក ប្រធាន - អនុប្រធាន គណបក្ស ខណ្ឌ និង វត្តមាន អញ្ជើញ ចូលរួម ពីសំណាក់ លោក - លោកស្រី ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ សង្កាត់ ទាំង៨ ព្រមទាំង សមាជិក - សមាជិកា គណបក្ស នៅ តាម សង្កាត់ ទាំង៨ នៃ ខណ្ឌ ៧មករា សរុប ចំនួន ១០០ នាក់ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ជម្រាប ដល់ គណបក្ស ខណ្ឌ អំពី កិច្ចការ ដែល ត្រូវ យកចិត្តទុកដាក់ ទាំង ក្នុង ដំណាក់កាល បើក យុទ្ធនាការ ឃោសនា - អំឡុង ពេល យុទ្ធនាការ ឃោសនា និង ក្នុង ពេល បិទ យុទ្ធនាការ ឃោសនា ជាពិសេស កិច្ចការ ដែល ត្រូវ បំពេញ ក្នុង ថ្ងៃ បោះឆ្នោត និង រាប់ សន្លឹក ឆ្នោត ។ បន្ថែម លើ នេះ លោក នួន ផារ័ត្ន ក៏ បាន ស្នើសុំ ឱ្យ សមាជិក បក្ស ទាំងអស់ ដែល ជា អង្គ បោះឆ្នោត បន្ត គាំទ្រ គណបក្ស និង បោះឆ្នោត ជូន គណបក្ស ទាំងអស់ គ្នា ផងដែរ ។
ជា ចុងក្រោយ ក្រុមការងារ គណបក្ស ចុះ ជួយ ខណ្ឌ និង គណបក្ស ខណ្ឌ ៧មករា បាន រួមគ្នា ប្តេជ្ញា ដណ្ដើម ជ័យជម្នះ នៃ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ អាណត្តិ ទី៤ ឆ្នាំ ២០២៤ ក្នុង ពេល ខាងមុខ ដើម្បីឱ្យ គណបក្ស បាន បន្ត សកម្មភាព បម្រើ ប្រជាពលរដ្ឋ បាន កាន់តែ ល្អ ប្រសើរ តាមរយៈ តំណាង របស់ ខ្លួន នៅ នឹង មូលដ្ឋាន ផ្ទាល់ ៕
អ្នកនាំពាក្យ៖ សមយុទ្ធ « នាគ មាស » រវាង កងទ័ព កម្ពុជា - ចិន មិន គំរាមកំហែង ដល់ ប្រទេស ណា ឡើយ . កម្ពុជា ស្វាគមន៍ ប្រទេសជា មិត្ត ដែល មាន បំណង ធ្វើ សមយុទ្ធតែ ត្រូវ គោរព សិទ្ធិ កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ថោង សូលីម៉ូ អ្នកនាំពាក្យ អគ្គ បញ្ជាការដ្ឋាន នៃ កងយោធពល ខេមរភូមិន្ទ បាន បញ្ជាក់ ជាថ្មី ថា ការធ្វើ លំហាត់ សមយុទ្ធនាគ មាស លើក ទី៦ ឆ្នាំ ២០២៤ នេះ រវាង កងយោធពល ខេមរភូមិន្ទ និង កងទ័ព រំដោះ ប្រជាជន ចិន នៅលើ ទឹកដី កម្ពុជា មិន មាន បំណង គំរាមកំហែង ឬ ធ្វើឱ្យ ប៉ះពាល់ ដល់ ប្រទេស ណាមួយ ឡើយ ។ កម្ពុជា ស្វាគមន៍ ជានិច្ច ចំពោះ ប្រទេសជា មិត្ត ដែល មាន បំណង ធ្វើ លំហាត់ សមយុទ្ធ ប៉ុន្តែ ត្រូវ គោរព សិទ្ធិ របស់ កម្ពុជា ។
លំហាត់ សមយុទ្ធនាគ មាស លើក ទី៦ នឹង ធ្វើឡើង ក្រោម ប្រធានបទ « ប្រតិបត្តិការ ប្រឆាំង ភេរវកម្ម រួមគ្នា និង ការងារ មនុស្សធម៌ » ដែល មាន រយៈពេល ១៤ ចាប់ពី ថ្ងៃទី ១៦ ដល់ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២៤ ដោយ មាន ការចូលរួម ពី កងទ័ព ជើងគោក និង កងទ័ព ជើងទឹក កម្ពុជា ក្នុង នោះ សម្រាប់ កងទ័ព ជើងគោក នឹង ត្រូវ ធ្វើឡើង នៅ មជ្ឈមណ្ឌល ហ្វឹកហ្វឺន កងរាជអាវុធហត្ថ ស្ថិត នៅក្នុង ភូមិ ច្រក កូវ ឃុំ ពាម ស្រុក សាមគ្គី មាន ជ័យ ខេត្ត កំពង់ឆ្នាំង ហើយ សមយុទ្ធ នៅលើ សមុទ្រ គឺ ធ្វើឡើង នៅឯ ខេត្ត ព្រះសីហនុ ។
ថ្លែង ក្នុង ឱកាស ធ្វើ សន្និសីទ សារព័ត៌មាន នៅ រសៀល ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ លោក ឧត្តមសេនីយ៍ ទោ ថោង សូលីម៉ូ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ការធ្វើ សមយុទ្ធ រវាង កងទ័ព កម្ពុជា និង កងទ័ព រំដោះ ប្រជាជន ចិន ធ្វើឡើង តាម កិច្ចសហប្រតិបត្តិការ នៃ ប្រទេស ទាំង ពីរ ប្រចាំ ឆ្នាំ ដូច ដែល បាន ធ្វើឡើង ៥លើក រួច មកហើយ ដើម្បី ដក បទពិសោធន៍ ពី គ្នា ទៅ វិញ ទៅ មក ពង្រឹង សន្តិសុខ ទប់ស្កាត់ អំពើ ភេរវកម្ម ដូច្នេះ ការធ្វើ សមយុទ្ធ នេះ មិន មាន គោលបំណង គំរាមកំហែង ឬ ធ្វើឱ្យ ប៉ះពាល់ ដល់ បណ្តា ប្រទេស ណាមួយ នោះ ឡើយ » ។
ជាមួយគ្នា នេះ ដែរ អ្នកនាំពាក្យ អគ្គ បញ្ជាការដ្ឋាន នៃ កងយោធពល ខេមរភូមិន្ទ បាន ឱ្យដឹង ថា ក្រៅពី ការរៀបចំ ធ្វើ សមយុទ្ធនាគ មាស ជាមួយ កងទ័ព រំដោះ ប្រជាជន ចិន កងទ័ព កម្ពុជា នឹង រៀបចំ ធ្វើ សមយុទ្ធ រួមគ្នា ជាមួយ កងទ័ព ឡាវ និង វៀតណាម លើ ប្រធានបទ សង្គ្រោះ គ្រោះមហន្តរាយ ផងដែរ ។
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៤.២៩៥ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៣.២២៧ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.០៦៨ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង ញៀន ភ្លើង / ផ្លាក ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ឆៀក ដឹក សំពីង សំពោង ស្រវឹង ល្មើស ល្បឿន ស្រវឹង កែច្នៃ អត់ បណ្ណ បើកបរ និង ភ្លើង - ផ្លាក ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១១លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៥ នាក់ របួស ចំនួន ១៦នាក់ ( របួស ធ្ងន់ ចំនួន ១០នាក់ ) ។ រយៈពេល ១៣ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១០៩ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៦១ នាក់ របួស ១១១ នាក់ ( របួស ធ្ងន់ ៧២ នាក់ )៕
( ភ្នំពេញ ) ៖ លោក អ៊ុន វិសិទ្ធ គុន ប្រធាន គណប ក្រកម្លាំង ប្រជាធិបតេយ្យ បាន លើកឡើង ថា លោក សម រង្ស៉ី មិន មែន អ្នកនយោបាយ ទេ ប៉ុន្តែ ជា អ្នក យក នយោបាយ ដើម្បី ប្រកប អាជីវកម្ម ហើយ យក លុយ ពី អ្នកគាំទ្រ ដើម្បី តែ ចិញ្ចឹម ជីវិត តែ ប៉ុណ្ណោះ ។ ប្រធាន គណប ក្រកម្លាំង ប្រជាធិបតេយ្យ លើកឡើង បែប នេះ នៅក្នុង កម្មវិធី Fresh Talk ដែល បាន ផ្សាយ ចេញ នា ល្ងាច ថ្ងៃសៅរ៍ សប្ដាហ៍ កន្លងទៅ ។
ទង្វើ របស់ បុគ្គល សម រង្ស៉ី នេះ ដែរ ត្រូវបាន លោក អ៊ុន វិសិទ្ធ គុន មើលឃើញ ថា មិន មែន ជា ជាតិ ខ្មែរ ឡើយ ព្រោះថា បើសិនជា អ្នកស្នេហាជាតិ ពិតប្រាកដ នោះ នឹង មិន ធ្វើ នយោបាយ ណាមួយ ធ្វើឲ្យ ប៉ះពាល់ ដល់ ផលប្រយោជន៍ ជាតិ និង បម្រើ តែ ផលប្រយោជន៍ បរទេស បែប នេះ ឡើយ ។
តំណាង រដ្ឋមន្ត្រី ប៉េង ពោធិ៍នា ជួប សំណេះសំណាល ជាមួយ ក្រុម និស្សិត សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង មុន ចេញដំណើរ ទៅ ប្រកួត សវនាការប្រតិដ្ឋ នៅ ប្រទេស ហូឡង់
( ភ្នំពេញ ) ៖ លោក ប៊ុន សុផាត អនុ រដ្ឋលេខាធិការ តំណាង លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន ជួប សំណេះសំណាល ជាមួយ ក្រុម និស្សិត នីតិសាស្ត្រ អន្តរជាតិ នៃ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង មុនពេល ចេញដំណើរ ចូលរួម ការប្រកួត សវនាការប្រតិដ្ឋ នៅ ទីក្រុង ឡាអេ ប្រទេស ហូឡង់ ដោយ មាន ការចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ផងដែរ ។
ជំនួប នេះ ធ្វើឡើង ដើម្បី ចែករំលែក អំពី បទពិសោធន៍ អនុសាសន៍ និង ការអនុវត្ត ល្អ ៗ ដែល ជា ទស្សនទាន ដ៏ មាន តម្លៃ បំផុត សម្រាប់ និស្សិត នៅក្នុង ការប្រកួត លើ ឆាក អន្តរជាតិ ដើម្បី ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ ធនធាន មនុស្ស ក្នុង វិស័យ យុត្តិធម៌ ក៏ ដូចជា ផ្តល់ ឱកាស ឱ្យ និស្សិត ក្នុង ការផ្សព្វផ្សាយ ពី ប្រទេស កម្ពុជា ទៅកាន់ ពិភពលោក ផងដែរ ។
( ភ្នំពេញ ) ៖ លោកស្រី ឡង ឌី សាន់ ណារ៉ា រដ្ឋលេខាធិការ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ថ្លែង ថា ការគាំទ្រ អ្នកនិពន្ធ នឹង នាំឱ្យ ពួកគេ មាន កម្លាំងចិត្ត ខិតខំ ប្រឹងប្រែង ច្នៃប្រតិដ្ឋ តែង និពន្ធ និង បញ្ចេញ ស្នាដៃ ថ្មី ៗ ជា បន្តបន្ទាប់ ទៀត ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង វប្បធម៌ ថ្លែង បែប នេះ ក្នុង ឱកាស អនុញ្ញាតឱ្យ ម្ចាស់ វណ្ណកម្ម ប្រលោមលោក « ៣រាត្រី » ចូល ជួប សម្តែង ការគួរសម និង ជូន សៀវភៅ ប្រលោមលោក នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ ។
បើ តាម លោកស្រី ឡង ឌី សាន់ ណារ៉ា លោកស្រី ជា អ្នក លើកស្ទួយ ការតែង និពន្ធ ព្រោះ ការបង្កើត បាន សៀវភៅ រឿង មួយ ក្បាល ៗ ពុំ មែន ជា ភាពងាយស្រួល ទេ តោង ទាល់តែ ដាក់ចិត្ត ដាក់ កាយ និង រៀប ផ្លូវ ដើរ ច្បាស់លាស់ ។ លោកស្រី បាន លើកទឹកចិត្ត ដល់ អ្នក តែង និពន្ធ បញ្ចេញ វណ្ណកម្ម ថ្មី ៗ ដើម្បី លើកស្ទួយ ការអាន និង ការតែង និពន្ធ ផងដែរ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា ការកំណត់ យក នេះ ក្នុង គោលបំណង បង្កើន គុណ តម្លៃ និង ជំរុញ លើកកម្ពស់ ស្នាដៃ តែង និពន្ធ ដើម្បី រួមចំណែក ដល់ ការអប់រំ ការលើកកម្ពស់ សុខដុមភាព វប្បធម៌ សាសនា និង ការយល់ដឹង អំពី អក្សរសាស្ត្រ អក្សរសិល្ប៍ សិល្បៈ ប្រវត្តិសាស្ត្រ និង វិទ្យាសាស្ត្រ ។
នេះ ជា សមយុទ្ធ ទ្រង់ទ្រាយ ធំ លើក ទី៦ហើយ រវាង កងទ័ព កម្ពុជា - ចិន ដែល ធ្វើឡើង លើ ទឹកដី កម្ពុជា ចាប់តាំងពី សមយុទ្ធ នេះ បង្កើតឡើង លើក ដំបូង កាលពី ឆ្នាំ ២០១៦ ខណៈ ដែល ប្រទេស ទាំង ពីរ គឺជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ហើយ កំពុង កសាង សហគមន៍ រួម វាសនា តែ មួយ ។
កម្ពុជា - ចិន បាន បង្កើត ទំនាក់ទំនង រយៈពេល ៦៦ ឆ្នាំ មកហើយ ។ ភាគី ទាំង ពីរ បាន ដំឡើង កម្រិត ទំនាក់ទំនងជា បន្តបន្ទាប់ រហូត ក្លាយជា ដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ និង កំពុង រួមគ្នា កសាង សហគមន៍ រួម វាសនា តែ មួយ ៕ ចំណេះដឹង ទូទៅ៖ អ្វី ទៅជា ទស្សនវិជ្ជា ?
( ភ្នំពេញ ) ៖ ទស្សនវិជ្ជា ត្រូវបាន ពន្យល់ បកស្រាយ ដោយ អ្នកប្រាជ្ញ ផ្សេង ៗ គ្នា ទៅតាម ការយល់ឃើញ រៀង ៗ ខ្លួន របស់ ពួកគាត់ ក្នុង នោះ មាន ទាំង អ្នកប្រាជ្ញា បស្ចឹម ប្រទេស និង បូព៌ា ប្រទេស ។
ដើម្បី ផ្ដល់ នូវ ខ្លឹមសារ មួយចំនួន ពាក់ព័ន្ធ នឹង ទស្សនវិជ្ជា នេះ កម្មវិធី ចំណេះដឹង ទូទៅ របស់ បណ្ដាញ ព័ត៌មាន Fresh News បាន ជួប សម្ភាស ជាមួយ លោក សរ រិទ្ធី ដែល បច្ចុប្បន្ន លោក ជា ប្រធាន មជ្ឈមណ្ឌល សិក្សា នៅ ប្រទេស ចិន អនុប្រធាន សមាគម អប់រំ និង តម្រង់ ទិស សិស្ស មធ្យមសិក្សា កម្ពុជា អគ្គ លេខាធិការ សមាគម កម្ពុជា - ចិន និង ជា បេក្ខជន បណ្ឌិត ទស្សនវិជ្ជា នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ដោយ នៅ ភាគ ១ នេះ ដែរ លោក បាន លើកឡើង អំពី « និយមន័យ ទស្សនវិជ្ជា » ជាមុន សិន ។
បេក្ខជន បណ្ឌិត ទស្សនវិជ្ជា រូប នេះ ពន្យល់ ដោយ ខ្លី ថា « ទស្សនវិជ្ជា គឺជា មុខវិជ្ជា សម្រាប់ មនុស្ស ដែល ចូលចិត្ត ការគិត ត្រិះរិះ ការវិភាគ ការពិចារណា ដើម្បី ស្វែងរក នូវ សច្ច ភាព »៕
សូម ទស្សនា វីដេអូសម្ភាសន៍ របស់ កម្មវិធី ចំណេះដឹង ទូទៅ ជាមួយ លោក សរ រិទ្ធី ដូចត ទៅ៖ សេព គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គម ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៣ ខែឧសភា៖ បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ៦១ នាក់
សម្ព័ន្ធ គ្រូពេទ្យ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ចុះ ពិនិត្យ ព្យាបាល ជំងឺ អប់រំ សុខភាព និង ផ្ដល់ អាហារូបត្ថម្ភ ដល់ សិស្សានុសិស្ស នៅ វិទ្យាល័យ មង្គលបរ ពិត្រ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ លោក បណ្ឌិត ហេង សុខ គង់ សមាជិក គណៈ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្តាល ស.ស .យ . ក និង ជា ប្រធាន សម្ព័ន្ធ គ្រូពេទ្យ ស .ស .យ . ក នៅ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០២ បាន ដឹកនាំ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា សម្ព័ន្ធ គ្រូពេទ្យ ស .ស .យ . ក ចំនួន ២៥២ នាក់ ចុះ ពិនិត្យ ព្យាបាល ជំងឺ អប់រំ សុខភាព សាធារណ: និង ផ្តល់ អាហារូបត្ថម្ភ ដល់ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង អាណាព្យាបាល ចំនួន ២. ៤០៣នាក់ នៅ វិទ្យាល័យ មង្គលបរ ពិត្រ ស្ថិត ក្នុង ឃុំ ផុង ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ ។
កម្មវិធី នេះ ធ្វើឡើង ក្រោម ពាក្យស្លោក « សុខ ទុក្ខ កូន ៗ ជា សុខ ទុក្ខ ប៉ា ប៉ា ហ៊ុន ម៉ានី » ដែល ជា ចក្ខុវិស័យ មួយ ដ៏ វែងឆ្ងាយ របស់ លោក ហ៊ុន ម៉ានី ដែល តែង គិតគូរ ពី អនាគត យុវជន នៅ កម្ពុជា ហើយ លោក តែង ចាត់ទុក សុខ ទុក្ខ របស់ យុវជន និង ប្រជាពលរដ្ឋ ទាំងអស់ ដូចជា សុខ ទុក្ខ របស់ លោក ដែរ ។
លោកគ្រូ អ្នកគ្រូ ក៏ ដូចជា សិស្សានុសិស្ស និង អាណាព្យាបាល ទាំងអស់ សូម ថ្លែងអំណរគុណ ដល់ ក្រុម គ្រូពេទ្យ ស្ម គ្រចិត្ត នៃ សម្ព័ន្ធ គ្រូពេទ្យ ស .ស .យ . ក ទាំងអស់ ជាពិសេស ដល់ លោក ហ៊ុន ម៉ានី និង លោកស្រី ដែល តែងតែ គិតគូរ ពី សុខ ទុក្ខ និង សុខុមាលភាព របស់ បងប្អូន និង សូម ជូនពរ ឲ្យ លោក ទាំង ពីរ និង ក្រុមគ្រួសារ បាន សមប្រកប តែ នឹង ពុទ្ធ ពរ ទាំង ៤ប្រការ កុំបី ឃ្លៀងឃ្លាត ឡើយ ហើយ សំណូមពរ សុំឲ្យ បន្ត កម្មវិធី « សុខ ទុក្ខ កូន ៗ ជា សុខ ទុក្ខ ប៉ា ប៉ា ហ៊ុន ម៉ានី » នេះ ឲ្យបាន កាន់តែ ទូលំទូលាយ ថែម ទៀត ៕
ក្នុង ជំនួប នោះ តាង នាម រាជ រដ្ឋាភិបាល កម្ពុជា ទេសរដ្ឋមន្ត្រី លី ធុជ បាន ថ្លែងអំណរគុណ ដល់ មូលនិធិ Sir Bobby Charlton ដែល បាន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង កិច្ច សង្រ្គោះ ជនរងគ្រោះ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ក៏ ដូចជា ជួយ ដល់ ការលើកកម្ពស់ ការយល់ដឹង និង បង្ការ គ្រោះ ដល់ អាយុជីវិត ប្រជាពលរដ្ឋ មូលដ្ឋាន ពី គ្រាប់ មីន និង យុទ្ធភ័ណ្ឌ ទាន់ ផ្ទុះ ។
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ រដ្ឋបាល រាជធានី ភ្នំពេញ ទាំងអស់ នា ព្រឹក ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ បាន ជួបជុំគ្នា ដើម្បី ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ គម្រោង ជា ប្រវត្តិសាស្ត្រ « ព្រែក ជីក ហ្វូណន - តេជោ » ដែល ផ្តល់ អត្ថប្រយោជន៍ ធំធេង ចំពោះ ជាតិ និង ប្រជាពលរដ្ឋ ខ្មែរ ទាំងមូល ។
ការជួបជុំគ្នា នេះ ដឹកនាំ ដោយ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ សាលា រាជធានី ភ្នំពេញ ដែល មាន មន្ត្រី ចូលរួម ប្រមាណ ៤០០ នាក់ ។
លោក ថា « មាន ព្រែក ជីក ហ្វូណន តេជោ ទំនិញ របស់ យើង នឹង មាន ការប្រកួតប្រជែង ជា អន្តរជាតិ ។ ក្នុង នាម មន្ត្រីរាជការ យើង គាំទ្រ យ៉ាង ពេញ ចំពោះ គម្រោង ព្រែក ជីក ហ្វូណន តេជោ នេះ ដើម្បីឲ្យ ក្លាយជា ចលនា ឯកភាព ជាតិ តែ មួយ » ។
រដ្ឋបាល ខេត្ត កំពង់ធំ រៀបចំ កសាង « ស្ដូប តេជោ សន្ដិភាព » នៅ ស្រុក កំពង់ស្វាយ
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ធំ កំពុង សិក្សា រៀបចំ កសាង « ស្ដូប តេជោ សន្ដិភាព » នៅ ចំណុច សួន អាពាហ៍ពិពាហ៍ ស្ថិត ក្នុង ភូមិ ត្រពាំង ចំបក ឃុំ ត្រពាំង ឫស្សី ស្រុក កំពង់ស្វាយ ។ លោក ញ៉ឹក បាន ខេង អភិបាល រង ខេត្ត កំពង់ធំ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន ដឹកនាំ ក្រុមការងារ ប្រជុំ ដើម្បី ត្រៀម សាងសង់ ស្ដូប នេះ ។
* ទី១៖ ការសិក្សា លើ ប្លង់ គោល ស្ថាបត្យកម្ម នៃ ស្តូប តេជោ សន្តិភាព ត្រូវ ធ្វើ ការពិភាក្សា និង ពិគ្រោះយោបល់ ជាមួយ ក្រុមការងារ សិក្សា ស្រាវជ្រាវ ដែល មាន ស្ថាបត្យកម្ម ពីព្រោះ ការរៀបចំ ការកសាង ជាមួយ ដំណើរការ ជាក់ស្តែង ទាមទារ មាន ការកែសម្រួល បត់បែន ជា ហូរហែរ លើ ខ្នាត និង រូបភាព សម ឬ មិន សម ចម្លាក់ ត្រឹមត្រូវ ឬ មិន ត្រឹមត្រូវ យើង តែង ធ្វើ កិច្ចការ នេះ ជា បទពិសោធន៍ សម្រាប់ អ្នកដឹកនាំ វិចិត្រករ ស្ថាបត្យករ រួមទាំង ជាមួយ ក្រុម ខ្លឹមសារ ប្រវត្តិកាល ។
* ទី២៖ រៀបចំ យន្តការ មួយ ដែល មាន សមាសភាព ច្បាស់លាស់ អ្នកដឹកនាំ និង សមាជិក ជា អ្នកជំនាញ មាន វត្តមាន ជាប់ ជាប្រចាំ ដោយ មិន ត្រូវ មាន ការផ្លាស់ប្តូរ ញឹកញាប់ ដែល នាំឲ្យ ជួប ការលំបាក ក្នុង ការបន្ត តាម ស្រាវ រៀបចំ បង្កើត ក្រុមការងារ រួមរវាង ក្រុមការងារ សិក្សា ស្រាវជ្រាវ ថ្នាក់ ក្រោម ជាតិ ដើម្បី បង្កើត កិច្ច ទំនាក់ទំនង យ៉ាង ជិតស្និទ្ធ ។
* ទី៣៖ រៀបចំ ប្រមែប្រមូល ប្រវត្តិ ខ្លឹមសារ រឿងរ៉ាវ ព្រឹត្តិការណ៍ ដែល មាន លក្ខណៈ ជា ប្រវត្តិសាស្ត្របស់ រដ្ឋបាល ខេត្ត ឬ អង្គភាព នីមួយ ៗ ឲ្យបាន ជា អតិបរមា សម្រាប់ យកមក ធ្វើ ការជ្រើសរើស សម្រិត សម្រាំង ទាំងនេះ ចាត់ទុក ថា ជា ដំណាក់កាល ប្រមូល សន្សំ ឯកសារ សម្រាប់ ធ្វើ ការពិនិត្យ ។
* ទី៤៖ ត្រូវ យក ព្រឹត្តិការណ៍ ទាំងអស់ នេះ មក សម្រិត សម្រាំង បំប្លែង ពី ខ្លឹមសារ អក្ខរាវិរុទ្ធ ពី សម្ភារៈ មក ជា រូបភាព គំនូរ និង ចម្លាក់ ។ ហើយ ចាំបាច់ ដែល ទាមទារ អ្នកជំនាញ បង្រួម បង្កើត ជា តំណាង និមិត្តរូប អត្តសញ្ញាណ និង ឲ្យ មាន ការឯកភាព មាន លក្ខណៈ វិទ្យាសាស្ត្រ ជាមួយនឹង ប្រវត្តិសាស្ត្រ ។
* ទី៥៖ រដ្ឋបាល ខេត្ត អាច រៀបចំ ជា សិក្ខាសាលា ឬ វេទិកា នានា ដើម្បី ប្រមូល ធាតុ ចូល ពី គ្រប់ មជ្ឈដ្ឋាន ឲ្យបាន ស៊ីជម្រៅ លើ ខ្លឹមសារ ចម្លាក់ ២ភាគ៣ របស់ រដ្ឋបាល ខេត្ត នីមួយ ៗ បង្កើត ជា ទម្រង់ និង ខ្លឹមសារ ឲ្យ មាន ការឯកភាព គ្នា សំដៅ ចារឹក ខ្លឹមសារ ចម្លាក់ ជា ភាសា យូរអង្វែង ។
* ទី៦៖ ដំណាក់កាល ចុងក្រោយ ជា ដំណាក់កាល ពិនិត្យ កែសម្រួល សម្រេច ដែល ទាមទារ ឲ្យ មាន ការកសាង ឯកសារ មួយ ឡើងវិញ ជា ឯកសារ ខុសពីមុន ដូចជា សៀវភៅ ប្រវត្តិ នៃ ចម្លាក់ ដែល មាន « ស្តូប តេជោ សន្តិភាព » នេះ បាន ធ្វើជា និទាន ក ថា មក ជា រូប ដែល មាន ន័យ សមស្រប ទទួល តាម តំបន់ ភូមិសាស្ត្រ និង ថ្នាក់ ជាតិ ។
* ទី៧៖ នៅក្នុង ទិដ្ឋភាព នេះ ខ្លឹមសារ ដែល ត្រូវ ណែនាំ ត្រូវ មាន ការចាប់អារម្មណ៍ ខ្លឹមសារ ចម្លង និង ចម្លាក់ ព្រមទាំង ខ្លឹមសារ ដែល ត្រូវ រៀបចំ ថ្មី ជា ប្រវត្តិ និង កែច្នៃ ។ នៅក្នុង ការសាងសង់ « ស្តូប តេជោ សន្តិភាព » លើក ក្រោយ នេះ ព្រឹត្តិការណ៍ ថ្មី ៗ ជា ប្រវត្តិសាស្ត្រ ដែល លើក មុខមាត់ ខេត្ត កំពង់ធំ ក្នុង ប្រទេស កម្ពុជា លើ ឆាក អន្តរជាតិ ។
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ប្រធាន គណបក្ស ប្រជាជន ខេត្ត ត្បូងឃ្មុំ ក្រើន រំលឹក សមាជិក បក្ស ទាំងអស់ កុំ ធ្វេសប្រហែស ឲ្យ សោះ គ្រប់ កាលៈទេស មិន ត្រូវ ជិះ សេះ លែង ដៃ ត្រូវ យកចិត្តទុកដាក់ ដូច ពាក្យ ថា « ច្រេះស៊ី ដែក » គណបក្ស យើង ខ្លាំង តែ បើ មាន ចន្លោះប្រហោង បក្ស ដ៏ ទៃ នឹង ឆ្លៀត ឱកាស ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បន្ថែម ថា ត្រូវ ពង្រឹង ការងារ ផ្ទៃក្នុង និង តាម បណ្តា មូលដ្ឋាន បន្ត តាមដាន សកម្មភាព គណបក្ស ដ៏ ទៃ ពិសេស អង្គការ សមាគមន៍ ដែល មាន និន្នាការ លើ គណបក្ស ប្រឆាំង ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ សមាជិក គណៈកម្មាធិការ កណ្តាល ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ខេត្ត និង ជា ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន ខេត្ត ត្បូងឃ្មុំ មានប្រសាសន៍ ក្រើន រំលឹក បែប នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ក្នុង កិច្ចប្រជុំ បូកសរុប ការងារ គណបក្ស ប្រជាជន ខេត្ត ត្បូងឃ្មុំ ប្រចាំ ខែមេសា និង ទិសដៅ ភារកិច្ចការងារ ប្រចាំ ខែឧសភា ឆ្នាំ ២០២៤ នា ព្រឹក ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ ។
ជាមួយគ្នា នោះ ចំពោះ ការបោះឆ្នោត ក្រុមប្រឹក្សា ខេត្ត ក្រុង ស្រុក នា ពេល ខ្លី ខាងមុខ នេះ ពាក់ព័ន្ធ នឹង អង្គ បោះឆ្នោត ទាំង ៤៣២ រូប របស់ គណបក្ស ប្រជាជន ខេត្ត ត្បូងឃ្មុំ លកក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ណែនាំ ដមក លោក លោកស្រី គ្រប់ ឋានានុក្រម របស់ គណបក្ស ខេត្ត ត្បូងឃ្មុំ ទាំងអស់ ពិសេស ប្រធាន - អនុប្រធាន គណបក្ស តាម បណ្តា ក្រុង - ស្រុក ទាំង ០៧ ត្រូវ យកចិត្តទុកដាក់ ប្រមូល ព័ត៌មាន មើល ថែ ទាំង សុខភាព និង លទ្ធភាព ជីវភាព ចំពោះ ពួកគាត់ ឲ្យ ដិតដល់ មិន ថា មុនពេល អំឡុង ពេល និង ក្រោយពេល បោះឆ្នោត ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ការងារ យ៉ាង ច្រើន ដែល សម្រេចបាន និង ផែនការខែ បន្ទាប់ តាមរយៈ របាយការណ៍ បូកសរុប ការងារ គណបក្ស ប្រចាំ ខែមេសា និង ទិសដៅ ភារកិច្ច ខែឧសភា ឆ្នាំ ២០២៤ ដែល អាន ដោយ លោក កេង ប៊ុន ណា អនុប្រធាន គណបក្ស និង ជា ប្រធាន ប្រចាំ ការ គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ គណបក្ស ខេត្ត ផងដែរ ៕ អ្នក ឧកញ៉ា គិត ម៉េង នឹង ដឹកនាំ គណៈប្រតិភូសភា ពាណិជ្ជកម្ម កម្ពុជា អម ដំណើរ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ចេញ ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ សាធារណរដ្ឋ កូរ៉េ
( ភ្នំពេញ ) ៖ ដោយ ទទួលបាន ការអនុញ្ញាត របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា . អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង ជា ប្រធាន ក្រុមប្រឹក្សា ពិគ្រោះយោបល់ ធុរកិច្ច អាស៊ាន សម្រាប់ កម្ពុជា នឹង ត្រូវ ដឹកនាំ គណៈប្រតិភូសភា ពាណិជ្ជកម្ម កម្ពុជា អញ្ជើញ អម ដំណើរ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ សាធារណរដ្ឋ កូរ៉េ ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ១៩ ខែឧសភា ឆ្នាំ ២០២៤ ។
ក្នុង កំឡុង ពេល នៃ ដំណើរទស្សនកិច្ច នេះ គណៈប្រតិភូសភា ពាណិជ្ជកម្ម កម្ពុជា នឹង អញ្ជើញ ចូលរួម វេទិកា ធុរកិច្ច កម្ពុជា - កូរ៉េ ដែល សហការរៀបចំ ដោយ សភា ពាណិជ្ជកម្ម កម្ពុជា និង សភា ពាណិជ្ជកម្ម និង ឧស្សាហកម្ម ជាតិ កូរ៉េ ដែល ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ។
ក្រៅពី នេះ សភា ពាណិជ្ជកម្ម កម្ពុជា នឹង ចុះ អនុស្សរណៈ យោគយល់ ជាមួយ សភា ពាណិជ្ជកម្ម និង ឧស្សាហកម្ម កូរ៉េ ដើម្បី ចូលរួម លើកកម្ពស់ ទំនាក់ទំនង ពាណិជ្ជកម្ម និង សេដ្ឋកិច្ច ក៏ ដូចជា ជំរុញ កាលានុវត្តភាព ធុរកិច្ច រវាង ប្រទេស ទាំង ពីរ ៕
គួរ បញ្ជាក់ ថា ការស៉ើប អង្កេត កំពុង បន្ត ហើយ ប៉ូលិស មិន បាន ផ្តល់ ព័ត៌មាន លម្អិត អំពី ករណី នេះ ទេ ។ បុរស ទាំង ៣នាក់ ខាងលើ នេះ ត្រូវបាន ចោទប្រកាន់ ក្រោម ច្បាប់ សន្តិសុខ ជាតិ របស់ ចក្រភព អង់គ្លេស ដែល អនុម័ត កាលពី ឆ្នាំ មុន និង មាន វិធានការ ថ្មី ដើម្បី កំណត់ គោលដៅ លើ ការគំរាមកំហែង ពី បរទេស ៕ ប្រធាន គណបក្ស ឯកភាព ជាតិ ខ្មែរ៖ ទណ្ឌិត សម រង្ស៊ី ធ្វើ នយោបាយ រួម ដៃ ជាមួយ បរទេស ប្រឆាំង ផលប្រយោជន៍ ជាតិ
( ភ្នំពេញ ) ៖ ការជីក ព្រែក ហ្វូណន តេជោ ដែល ជា គម្រោង ដ៏ ធំ មួយ បម្រើ ដល់ ផលប្រយោជន៍ សេដ្ឋកិច្ច និង ភូមិសាស្រ្ត របស់ កម្ពុជា មាន ប្រជាជន ពេញ មួយ ប្រទេស បាន ប្រកាស គាំទ្រ តែ បែរជា បុគ្គល សម រង្ស៊ី ចេញមុខ មក ជំទាស់ ទៅ វិញ ។ នេះ មិន មែន ជា លើក ទី១ ទេ ដែល បុគ្គល រូប នេះ ចេញមុខ មក ជំទាស់ ព្រោះថា រាល់ គម្រោង អភិវឌ្ឍន៍ របស់ កម្ពុជា គឺ តែងតែ ឃើញ បុគ្គល រូប នេះ ចេញមុខ មក ជំទាស់ ប្រឆាំង និង ញុះញង់ ជានិច្ច ។
ប្រធាន គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ៖ ទណ្ឌិត សម រង្ស៉ី មិន មែន ជា ជនជាតិ ខ្មែរ ទេ ព្រោះតែ ជា ជន បម្រើ បរទេស
( ភ្នំពេញ ) ៖ លោក អ៊ុន វិសិទ្ធ គុន ប្រធាន គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ បាន ថ្លែង ថា ការធ្វើ នយោបាយ ប្រឆាំង នឹង ផលប្រយោជន៍ របស់ ជាតិ ជារៀងរហូតមក ទល់ បច្ចុប្បន្ន នេះ របស់ ទណ្ឌិត សម រង្ស៉ី គឺ បង្ហាញ ថា បុគ្គល រូប នេះ មិន មែន ជា ជនជាតិ ខ្មែរ នោះ ទេ ហើយ ជា ខ្ញុំ បម្រើន យោបាយ បរទេស ប៉ុណ្ណោះ ។ ការលើកឡើង របស់ លោក អ៊ុន វិសិទ្ធ គុន បាន ធ្វើឡើង នៅក្នុង កម្មវិធី Fresh Talk នា ថ្ងៃសៅរ៍ សប្ដាហ៍ កន្លងទៅ ក្រោម ប្រធានបទ « នយោបាយ ប្រឆាំង ផលប្រយោជន៍ ជាតិ និង បង្ក អសន្តិសុខ របស់ លោក សម រង្ស៉ី » ។
ខាងក្រោម នេះ ជា ការលើកឡើង របស់ លោក អ៊ុន វិសិទ្ធ គុន៖
អ្នកនាំពាក្យ នាយក រដ្ឋមន្ដ្រី បង្ហាញ លទ្ធផល ផ្លូវការ នៃ ជំនួប រវាង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត និង អគ្គ រដ្ឋទូត កាណាដា ប្រចាំ កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រុម អ្នកនាំពាក្យ ខុទ្ទកាល័យ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នៅ រសៀល ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ លទ្ធផល ផ្លូវការ នៃ ជំនួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ រវាង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ជាមួយ លោកស្រី ពីង គិត នីកន អគ្គ រដ្ឋទូត នៃ ប្រទេស កាណាដា ប្រចាំ នៅ កម្ពុជា កាលពី ព្រឹក មិញ នា វិមាន សន្ដិភាព ។
ខាងក្រោម នេះ ជា សេចក្ដីប្រកាស ព័ត៌មាន បង្ហាញ លទ្ធផល ផ្លូវការ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ជួប សំណេះសំណាល និង សួរសុខទុក្ខ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៅ បញ្ជាការដ្ឋាន ទ័ព ពិសេស
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នៅ ព្រឹក ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ សំណេះសំណាល និង សួរសុខទុក្ខ ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៅ បញ្ជាការដ្ឋាន ទ័ព ពិសេស ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ។ ពិធី នេះ ដោយ មាន ការចូលរួម ពី ប្រតិភូ អម ដំណើរ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ បញ្ជាការដ្ឋាន ទ័ព ពិសេស ជាច្រើន រូប ផងដែរ ។
ថ្លែង ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន បង្ហាញ ក្តី សោមនស្ស សប្បាយរីករាយ ក្រៃលែង ដោយ បាន មក សួរ សុខទុក្ខ សំណេះសំណាល ដោយ ផ្ទាល់ ជាមួយ បងប្អូន នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ បញ្ជាការដ្ឋាន កងទ័ព ពិសេស ការជួបជុំគ្នា ដ៏ ច្រើន កុះករ នា ពេលនេះ គឺ ស្រប ពេល នឹង ការគម្រប់ ខួប លើក ទី ៤៦ ឆ្នាំ នៃ ការបង្កើត កងកម្លាំងប្រដាប់អាវុធ សាមគ្គី សង្រ្គោះ ជាតិ កម្ពុជា ១២ ឧសភា ១៩៧៨ - ១២ ឧសភា ២០២៤ ។
នាយ ឧត្តមសេនីយ៍ មេបញ្ជាការ បាន បន្ត ថា កម្ពុជា មាន សន្តិភាព ឯកភាព ជាតិ ឯកភាព ទឹកដី ពេញលេញ បាន ២៦ ឆ្នាំ ៧ខែ និង ១៦ ថ្ងៃ ហើយ ។ បន្ទាប់ពី ប្រទេស ធ្លាក់ ទៅក្នុង ភ្នក់ភ្លើង សង្រ្គាម នា ថ្ងៃទី ១៨ ខែមីនា ឆ្នាំ ១៩៧០ និង របប ប្រល័យ ពូជសាសន៍ អស់ រយៈពេល ២៨ ឆ្នាំ ៨ខែ និង ១១ ថ្ងៃ គិត ត្រឹម ថ្ងៃ នេះ ពេលនេះ តែ បើ ក្រឡេក ត្រឡប់ ទៅ អាន ប្រវត្តិសាស្ត្រ កម្ពុជា នោះ នឹង ឃើញ ថា នេះ ជា លើក ដំបូង ហើយ ដែល ប្រទេស និង ប្រជាជន កម្ពុជា ស្គាល់ ពាក្យ សន្តិភាព ឯកភាព ជាតិ ឯកភាព ទឹកដី ក្នុង រយៈ ជាង ៥០០ ឆ្នាំ ។
ត្រូវ មាន ទស្សនៈ ត្រឹមត្រូវ គោលជំហរ រឹងមាំ អង់អាច ក្លាហាន មាន វិន័យ គោរព ច្បាប់ និង មាន សាមគ្គី ឯកភាព ផ្ទៃក្នុង ល្អ គោរព ម៉ឺងម៉ាត់ ឋានានុក្រ មកងទ័ព ។ ជាមួយ និង ស្នាដៃ សមិទ្ធផល មោទនភាព សន្តិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ ដ៏ ល្អ នេះ យើង ក៏ ប្រឈម និង បញ្ហា ដែល កើតឡើង ថ្មី ៗ ជាច្រើន ដែល គម្បី ត្រូវ បន្ត រួមគ្នា ស្វែងយល់ និង មាន ការយល់ដឹង បាន ត្រឹមត្រូវ មាន សកម្មភាព ព្រម ៗ គ្នា ។
នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន ថ្លែងអំណរគុណ ចំពោះ ការរៀបចំ បដិសណ្ឋារកិច្ច យ៉ាង រាក់ទាក់ កក់ក្តៅ និង ការតាមដាន ស្តាប់ ឯកភាពយល់ព្រម គាំទ្រ មតិ សំណេះសំណាល ជាមួយនិង ការប្តេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការលើកកម្ពស់ ស្មារតី ប្រុងប្រយ័ត្ន ទប់ស្កាត់ នូវ រាល់ ឧបាយកល បំផ្លិចបំផ្លាញ សន្តិភាព សន្តិសុខ ពី មជ្ឈដ្ឋាន ប្រតិកិរិយា ទាំង ក្នុង និង ក្រៅ ប្រទេស ។ សូម ជូនពរ អស់ លោក លោកស្រី អ្នកនាង កញ្ញា និង អង្គ ពិធី ទាំងមូល ។
ក្នុង ឱកាស សំណេះសំណាល នោះ នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន នាំមក ជាមួយ នូវ ភេសជ្ជ ចំនួន ៥០៤ កេស និង ថវិកា ៦០ លាន រៀល នារី ចំនួន ១៣នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ៥០ ម៉ឺន រៀល ផងដែរ ៕
លោក Cameron បញ្ជាក់ ថា « លើក ចុងក្រោយ ដែល ខ្ញុំ ត្រូវបាន ជំរុញ ឱ្យ ធ្វើ ដូច្នេះ ... ប៉ុន្មាន ថ្ងៃ ក្រោយ ការវាយប្រហារ របស់ អ៉ីរ៉ង់ លើ អ៉ី ស្រាអែល ។ យើង គ្រាន់តែ អាច ប្រកាស ថា នឹង ផ្លាស់ប្តូរ វិធីសាស្រ្ត ក្នុង ការនាំចេញ អាវុធ ជាជាង បញ្ឈប់ ដំណើរការ របស់ យើង ។ វា នឹង ធ្វើឱ្យ ក្រុមហា ម៉ាស បាន ចិត្ត ទាមទារ កាន់តែ ច្រើន ក្នុង កិច្ចព្រមព្រៀង ដោះលែង ចំណាប់ខ្មាំង ខ្ញុំ មិន គិត ថា វិធីសាស្រ្ត នោះ ត្រឹមត្រូវ ទេ » ។
គួរ បញ្ជាក់ ថា អ៉ី ស្រាអែល បាន បញ្ជា ឱ្យ ប្រជាជន ប៉ាឡេ ស្ទីន ជាច្រើន នាក់ ទៀត ចាកចេញ ពី ទីក្រុង ភាគ ខាងត្បូង តំបន់ ហ្កាហ្សា មួយ នេះ នៅក្នុង សញ្ញា មួយ បង្ហាញ ថា ផែនការវាយលុក កំពុង ឆ្ពោះទៅ មុខ បើ ទោះបីជា មាន ការព្រមាន ពី រដ្ឋបាល លោក បៃ ដិន អំពី ការផ្អាក បញ្ជូន អាវុធ ឱ្យ អ៉ី ស្រាអែល ៕ ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ ប្រតិភូ ក្រុមហ៊ុន កូរ៉េ លើ គម្រោង កែច្នៃ កាកសំណល់ ផលិត ជា ថាមពល អគ្គិសនី
ឆ្លើយតប ក្នុង អង្គប្រជុំ លោក ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បង្ហាញ ការស្វាគមន៍ ជូន ដល់ ក្រុមហ៊ុន និង វិនិយោគិន ទាំងអស់ ចំពោះ គម្រោង វិនិយោគ លើ ការទាញយក ថាមពល អគ្គិសនី តាមរយៈ ការកែច្នៃ សំរាម នេះ និង ស្នើសុំ ឱ្យ ក្រុមហ៊ុន ផ្ញើ ជូន ព័ត៌មាន លម្អិត ទាំងស្រុង នៃ គម្រោង មក ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ដើម្បី អាច ឱ្យ ស្ថាប័ន រដ្ឋាភិបាល សម្របសម្រួល អនុវត្ត នីតិវិធី បន្ត ៕
សម្តេច ធិបតី ក៏ បាន លើកទឹកចិត្ត ដល់ លោក ឯក អគ្គ រាជ ទូត ឱ្យ បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយ ក្រសួង - ស្ថាប័ន របស់ ភាគី កម្ពុជា ជាពិសេស បន្ត ជំរុញ កិច្ចសហប្រតិបតិ្តការ រវាង ប្រទេស ទាំង ពីរ លើ វិស័យ ពាណិជ្ជកម្ម វិនិយោគ ទេសចរណ៍ និង វិស័យ សក្ដានុពល ផ្សេង ៗ ទៀត ផងដែរ ៕ ព្រះចៅ ស៊ុលតង់ ព្រះមហាក្សត្រ ប្រទេស ព្រុយណេ អញ្ជើញ សម្ដេច តេជោ ហ៊ុន សែន ទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស ព្រុយណេ
ក្នុង ព្រះរាជ សារ នោះ ព្រះចៅ ស៊ុលតង់ ហា ជី ហាស សាណាល់ បុល គីយ៉ាស់ នៃ ប្រទេស ព្រុយណេ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖
វា ជា ឱកាស ដ៏ ល្អ ដែល បាន ជួប ជាមួយ កូនប្រុស ៗ របស់ សម្ដេច តេជោ ដែល រួម ទាំង នាយក រដ្ឋមន្តី ហ៊ុន ម៉ាណែត ហើយ ខ្ញុំ សប្បាយរីករាយ ណាស់ ចំពោះ ការសន្ទនា របស់ ពួកយើង ។
ខ្ញុំ មាន ក្តី សោមនស្ស ដែល បាន ឮ ថា សម្តេច តេជោ បាន ទទួល នូវ តួនាទី ថ្មី ជា ប្រធាន ព្រឹទ្ធសភា និង ខ្ញុំ សូម ជូន សព្ទ សាធុការពរ មហា ប្រសើរ ចំពោះ សម្តេច តេជោ សូម សម្រេចបាន នូវ សមិទ្ធផល ឧត្តុង្គឧត្ដម ក្នុង ពេល អនាគត ។
ជា ចុងក្រោយ នេះ ខ្ញុំ សូមអញ្ជើញ សម្តេច តេជោ ទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស ព្រុយណ ដារូស្សា ឡាម ដើម្បី ពង្រឹង បន្ថែម ទៀត នូវ ចំណង មិត្តភាព ដ៏ យូរអង្វែង រវាង ប្រជាជន និង ប្រទេស យើង ទាំង ពីរ ។ ដោយ ការគោរព រាប់អាន និង សូម ជូន សព្ទ សាធុការ ពរ មហា ប្រសើរ ចំពោះ សម្ដេច តេជោ និង ក្រុមគ្រួសារ សូម បន្ត មាន សុខភាព ល្អ បរិបូណ៌ និង សុភមង្គល » ។
សូម រំលឹក ថា ព្រះចៅ ស៊ុលតង់ ហា ជី ហាស សាណាល់ បុល គីយ៉ាស់ នៃ ប្រទេស ព្រុយណេ ទើបតែ បាន យាង មក កម្ពុជា កាលពី ថ្ងៃទី ២៩ ខែមេសា ឆ្នាំ ២០២៤ កន្លងទៅ ថ្មី ៗ នេះ ។ ការយាង មកកាន់ កម្ពុជា នា ពេលនេះ របស់ ព្រះអង្គ គឺ ដើម្បី សោយ ព្រះក្រយា នា ព្រឹក ថ្ងៃទី៣០ ខែមេសា ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ដែល ជា ប្អូន ធម៌ ៕
ក្នុង ឱកាស នៃ ជំនួប លោកស្រី អគ្គ រដ្ឋទូត បាន ថ្លែងអំណរគុណ ជូន ចំពោះ សម្តេច ធិបតី ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មមាញឹក អនុញ្ញាតឲ្យ រូប លោកស្រី និង គណៈប្រតិភូ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ព្រមទាំង បាន បញ្ជាក់ អំពី ការពេញចិត្ត ចំពោះ ទំនាក់ទំនង ការទូត ជា ប្រវត្តិសាស្រ្ត និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង កាណាដា - កម្ពុជា ដែល ជា ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ប្រកបដោយ ផ្លែផ្កា ។
ក្នុង អាណត្តិការ ទូត នៅ កម្ពុជា លោកស្រី ឯក អគ្គ រដ្ឋទូត ប្តេជ្ញា ខិតខំ បន្ត ពង្រឹង និង ពង្រីក ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ឲ្យ កាន់តែ រីកចម្រើន ។ បន្ថែម លើ នេះ លោកស្រី ឯក អគ្គ រដ្ឋទូត ក៏ បាន គោរព ជម្រាប ជូន សម្តេច ធិបតី អំពី ការបន្ត ជំរុញ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ពាណិជ្ជកម្ម និង វិនិយោគ រវាង កាណាដា - កម្ពុជា ក៏ ដូចជា ការពង្រឹង ការវិនិយោគ ប្រកបដោយ គុណភាព របស់ ក្រុមហ៊ុន កាណាដា នៅ កម្ពុជា ផងដែរ ។
ពាក់ព័ន្ធ នឹង វិស័យ ពាណិជ្ជកម្ម និង វិនិយោគ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា បច្ចុប្បន្ន នេះ សភា ពាណិជ្ជកម្ម កម្ពុជា បាន បង្កើត នូវ តំណាង សភា ពាណិជ្ជកម្ម នៅ ប្រទេស កាណាដា ដែល ជា ផ្នែក មួយ នៃ ការភ្ជាប់ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ពាណិជ្ជកម្ម និង វិនិយោគ រវាង ប្រទេស ទាំង ពីរ ។
បន្ថែម លើ នេះ សម្តេច ធិបតី បាន បញ្ជាក់ ជូន លោកស្រី ឯក អគ្គ រដ្ឋទូត អំពី គោល នយោបាយ ទាក់ទាញ និង លើកទឹកចិត្ត វិនិយោគិន នៅ កម្ពុជា តាមរយៈ ការអនុវត្ត ច្បាប់ ស្តី អំពី វិនិយោគ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ ដូចជា ការដាក់ចេញ នូវ គោល នយោបាយ ជាក់ស្ដែង ដើម្បី គាំទ្រ ដល់ បរិយាកាស វិនិយោគ និង រក្សា ភាព ប្រកួតប្រជែង របស់ កម្ពុជា ទាំង ក្នុង ក្របខ័ណ្ឌ តំបន់ និង សកលលោក ។
ទន្ទឹម នោះ សម្ដេច ធិបតី ក៏ បាន គូស រំលេច អំពី ការដាក់ចេញ នូវ គោល នយោបាយ និង យន្តការបន្ថែម ទៀត ក្នុង ការគាំទ្រ និង ដោះស្រាយ នូវ បញ្ហា ប្រឈម នានា របស់ វិនិយោគិន នៅ កម្ពុជា តាមរយៈ ការរៀបចំ នូវ វេទិកា រវាង រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន និង ការបង្កើត ក្រុមការងារ តាមដាន លើ ការអនុវត្ត គោល នយោបាយ វិធានការ និង ការស្វែងរក ដំណោះស្រាយ ចំពោះ បញ្ហា ប្រឈម នានា របស់ វិនិយោគិន ។
ប្រជាពលរដ្ឋ ដែល ទទួលបាន លក្ខណៈ បច្ចេកទេស ក្នុង ដំណើរការ សាងសង់ លំនៅដ្ឋាន ទាំង ១៤៧ ករណី រួម មាន៖១. ក្រុង សៀមរាប ចំនួន ៤២ ករណី ២. ស្រុក ប្រាសាទ បាគង ចំនួន ១២ករណី ៣. ស្រុក បន្ទាយស្រី ចំនួន ៣០ ករណី ៤. ស្រុក ពួក ចំនួន ៣១ ករណី ៥. ស្រុក អង្គរ ធំ ចំនួន ២៧ ករណី ៦. ស្រុក ស្វាយលើ ចំនួន ០៥ ករណី
សូម បញ្ជាក់ ថា ក្នុង ចំណោម ១៤៧ ករណី មាន ៨៩ ករណី សាងសង់ ត្រឹមត្រូវ តាម ការអនុញ្ញាត មាន ៥៧ ករណី មិន ទាន់ សាងសង់ នៅឡើយ និង សាងសង់ ពុំ ត្រឹមត្រូវ តាម ការអនុញ្ញាត មាន ១ករណី មាន ឈ្មោះ លន់ រ៉ាវី នៅ ភូមិ សណ្ដាន់ សង្កាត់ ទឹក វិល ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
ករណី ដែល ប្រជាពលរដ្ឋ សាងសង់ ពុំ ត្រឹមត្រូវ តាម ការអនុញ្ញាត ក្រុមការងារ បាន សម្របសម្រួល ឱ្យ ពួកគាត់ កែប្រែ ឡើងវិញ ទៅ តាម ខ្លឹមសារ នៃ ការអនុញ្ញាត និង កិច្ចសន្យា ដែល បាន ព្រមព្រៀង ជាមួយនឹង អាជ្ញាធរ ជាតិ អប្សរា ៕ អគ្គីសនី កម្ពុជា បរិច្ចាគ ថវិកា ១២០ លាន រៀល ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤
( ភ្នំពេញ ) ៖ អគ្គីសនី កម្ពុជា បាន បរិច្ចាគ ថវិកា ចំនួន ១២០ លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ។
អគ្គីសនី កម្ពុជា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២៤ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ១២០ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៦. ០៦១ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ អ្នកគ្រូពេទ្យ ម្នាក់ ត្រូវ ខ្មាន់ កាំភ្លើង ចូល បាញ់ប្រហារ ដល់ បន្ទប់ ប៉ុស្ដិ៍ សុខភាព អណ្ដូង ក្រឡឹង នៅ ស្រុក អូរ រាំង រួច បាញ់ សម្លាប់ ខ្លួន ឯង តាម ក្រោយ តែ គ្រាប់ មិន ផ្ទុះ . ខ្មាន់ កាំភ្លើង ជា មនុស្ស មាន ប្រពន្ធ កូន ហើយ តាម ស្រលាញ់ ជនរងគ្រោះ
( មណ្ឌលគិរី ) ៖ អ្នកគ្រូពេទ្យ ម្នាក់ ត្រូវបាន ខ្មាន់ កាំភ្លើង ប្រដាប់ ដោយ អាវុធ AK 47 ចូលទៅ បាញ់ប្រហារ បណ្ដាលឲ្យ ស្លាប់ នៅក្នុង បន្ទប់ ប៉ុស្ដិ៍ សុខភាព អណ្ដូង ក្រឡឹង រួច គ្រាប់ ផ្លាត ទៅ ត្រូវ កូន អាយុ៦ ឆ្នាំ ម្នាក់ ទៀត បណ្ដាលឲ្យ រងរបួស ។ ហេតុការណ៍ នេះ បាន កើតឡើង នៅ យប់ រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០២៤ ស្ថិត នៅ ភូមិ អណ្ដូង ក្រឡឹង ឃុំ សែនមនោរម្យ ស្រុក អូរ រាំង ខេត្ត មណ្ឌលគិរី ។
យោង តាម សេចក្ដីរាយការណ៍ បាន ឲ្យដឹង ថា ខ្មាន់ កាំភ្លើង ក្រោយ បាញ់ សម្លាប់ ជនរងគ្រោះ បាន ព្យាយាម បាញ់ សម្លាប់ ខ្លួន តាម ក្រោយ ដែរ ប៉ុន្ដែ គ្រាប់ មិន ផ្ទុះ ។ ខ្មាន់ កាំភ្លើង ជា មនុស្ស មាន ប្រពន្ធ កូន ហើយ តែ តាម ស្រលាញ់ ជនរងគ្រោះ ខណៈ មុន ឈានដល់ ការបាញ់ប្រហារ នេះ គឺ ឮ សំឡេង ឈ្លោះប្រកែកគ្នា រវាង ជន បង្ក និង ជនរងគ្រោះ ផងដែរ ។
លោក ហាក់ ទិត្យ ឬ ទ្ធី វង្ស អធិការ នគរបាល ស្រុក អូរ រាំង បាន ឲ្យដឹង ថា ខ្មាន់ កាំភ្លើង នេះ ប្រើប្រាស់ អាវុធ ម៉ាក AK 47 បាញ់ ចំ កណ្តាល ក្បាល ធ្លាយ មក ឆ្អឹង ខ្នង ធ្លាយ ពី ឆ្អឹង ខ្នង គ្រាប់ កាំភ្លើង ផ្លាត ទៅ ត្រូវ ចំ ក្មេងស្រី ម្នាក់ ទៀត បណ្តាលឲ្យ រងរបួស ដែល ត្រូវ ជា កូនស្រី របស់ ជនរងគ្រោះ តែម្ដង ។
សមត្ថកិច្ច បាន បញ្ជាក់ ទៀត ថា ជនរងគ្រោះ ឈ្មោះ កែប កែវ កន្និកា អាយុ ៣៨ ឆ្នាំ មុខរបរ ពេទ្យ មាន ទៅ លំនៅ ភូមិ អណ្ដូង ក្រឡឹង ឃុំ សែនមនោរម្យ ស្រុក អូរ រាំង ( ស្លាប់ ភ្លាម ៗ ) ខណៈ ម្នាក់ ទៀត ដែល ជា កូនស្រី រងរបួស ដោយសារ គ្រាប់ ផ្លាត ត្រូវ នោះ ឈ្មោះ ជូ សាណា អាយុ ៦ឆ្នាំ ។ ដោយឡែក ខ្មាន់ កាំភ្លើង ឈ្មោះ សុខា នុត អាយុ ៤១ ឆ្នាំ មុខរបរ កសិករ ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃសុក្រ សប្តាហ៍ មុន អាហ្វ្រិក ខាងត្បូង បាន ស្នើ ICJ បង្គាប់ឱ្យ អ៉ី ស្រាអែល ដក កងទ័ព ចេញ ពី ទីក្រុង Rafah ស្រប តាម លក្ខខណ្ឌ នៃ វិធានការបន្ទាន់ ដែល កំពុង អនុវត្ត ជុំវិញ ការចោទប្រកាន់ ថា អ៉ី ស្រាអែល បាន ប្រព្រឹត្ត អំពើ ប្រល័យ ពូជសាសន៍ ប្រឆាំង ប្រជាជន ប៉ាឡេស្ទីន ៕
ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ជូនដំណឹង ដល់ រដ្ឋាករ សាធារណៈ និង ប្រតិបត្តិករ សេវា ទឹក ស្អាត ដាក់ សារ ប្រឆាំង គ្រឿងញៀន នៅលើ វិក្កយបត្រ ទឹក ស្អាត
គួរ បញ្ជាក់ ថា កាលពី ខែធ្នូ ឆ្នាំ ២០២៣ មនុស្ស យ៉ាងហោច ២០ នាក់ ត្រូវបាន សម្លាប់ បន្ទាប់ពី ភ្នំ ភ្លើង Marapi បាន ផ្ទុះ ហើយ ការផ្ទុះ ភ្នំ ភ្លើង នេះ ជា បន្តបន្ទាប់ ក៏ បាន កើតឡើង ផងដែរ ៕
ប្រកាស តែងតាំង មេបញ្ជាការ អាវុធហត្ថ ស្រុក មណ្ឌល សីមា ខេត្ត កោះកុង . លោក អនុ សេនីយ៍ ឯក ដូង ភារ៉ូត ជំនួស លោក សួស មិថុនា
( កោះកុង ) ៖ លោក អនុ សេនីយ៍ ឯក ដូង ភារ៉ូត ត្រូវបាន ប្រកាស ផ្លាស់ប្តូរ មុខតំណែង និង ប្រគល់ ភារកិច្ច ថ្មី ជា មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក មណ្ឌល សីមា ខេត្ត កោះកុង ជំនួស លោក វរសេនីយ៍ ត្រី សួស មិថុនា ដែល ត្រូវបាន ផ្លាស់ប្ដូរ ទៅជា មេបញ្ជាការ រង អាវុធហត្ថ ក្រុង បាត់ដំបង ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ឧត្តមសេនីយ៍ ត្រី តាំង ឈុន ស្រេង មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កោះកុង និង ដោយ មាន ការចូលរួម ពី លោក សុខ ភិរម្យ អភិបាល ស្រុក មណ្ឌល សីមា រួមទាំង មន្ត្រីរាជការ និង មន្ត្រី កងរាជអាវុធហត្ថ ជាច្រើន រូប ។
( កំពង់ធំ )៖ លោក សួស យ៉ារ៉ា ប្រធាន កិតិ្តយ ស ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កំពង់ស្វាយ និង លោកស្រី ឃួន ឃុន ឌី ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ជួប សំណេះសំណាល ជា
មួយ ក្រុមប្រឹក្សា ឃុំ ក្នុង តំណែង គណបក្ស ប្រជាជន និង បេក្ខជន ពេញ សិទ្ធិ និង បម្រុង ដែល ឈរឈ្មោះ ជា ក្រុមប្រឹក្សា ស្រុក ចំនួន ១២២ នាក់ ។
លោកស្រី ឃួន ឃុន ឌី ជំរុញ ការចិញ្ចឹម ចលនា នៅ មូលដ្ឋាន ឱ្យ បាន ខ្លាំងក្លា និង ដោះស្រាយ សំណូមពរ បញ្ហា ប្រឈម និង ការលំបាក ផ្សេង ៗ របស់ ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ខ្ពស់ ប្រកបដោយ ការពារ ថែរក្សា ពង្រឹង ភាពខ្លាំង និង ប្រៀប ឈ្នះ របស់ គណបក្ស ដើម្បី គណបក្ស រក្សា បាន នូវ តួនាទី ក្នុង ការដឹកនាំ គ្រប់គ្រង ប្រទេសជាតិ យូរអង្វែង តាមរយៈ ការដណ្តើម ជ័យ ជំនះ ឱ្យ បាន ដាច់ខាត នៅ គ្រប់ ការបោះឆ្នោត ៕
មនុស្ស ៤នាក់ រងរបួស ក្នុង ហេតុការណ៍ ផ្ទុះ គ្រាប់ ចាស់ សល់ ពី សង្គ្រាម នៅក្នុង ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌
( កំពង់ឆ្នាំង ) ៖ មនុស្ស ៤នាក់ បាន រងរបួស ធ្ងន់ និង ស្រាល នៅក្នុង ហេតុការណ៍ ផ្ទុះ គ្រាប់ ដែល បន្សល់ទុក ពី សម័យ សង្គ្រាម មួយ គ្រាប់ មិន ស្គាល់ ប្រភេទ គ្រាប់ ដែល ជនរងគ្រោះ រើស បាន ពី ក្នុង ទឹក ទន្លេ និង បាន យកមក គប់ លេង បណ្តាល គ្រាប់ នោះ ផ្ទុះឡើង ។
ហេតុការណ៍ ខាង លើ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង នៅ ៤៖០០ នាទី រសៀល ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២៤ នៅ ចំណុច កោះ មនោ ក្នុង ភូមិ ឆ្នុក ទ្រូ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ។
លោក ចេង ចាន់ ដូរ ណា អភិបាល ស្រុក បរិបូណ៌ បាន ឲ្យដឹង នៅ ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០២៤ នេះ ថា ជនរងគ្រោះ ទាំង៤នាក់ ខាងលើ នេះ រួម មាន ឈ្មោះ សេន សារី ភេទ ប្រុស អាយុ ២៣ ឆ្នាំ រងរបួស ធ្ងន់ ឈ្មោះ សេន ពូកៅ ភេទ ប្រុស អាយុ ៤៣ ឆ្នាំ រងរបួស ធ្ងន់ ឈ្មោះ សេន ម៉ាលិច ភេទ ប្រុស អាយុ១០ ឆ្នាំ រងរបួស ស្រាល និង ក្មេង ម្នាក់ ទៀត ទើបតែ មាន អាយុ ជាង ១ខូប រងរបួស ស្រាល ។ ជនរងគ្រោះ ទាំងអស់ ជា ជនជាតិ ខ្មែរ ឥស្លាម រស់ នៅក្នុង ភូមិ ឆ្នុក ទ្រូ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ។
បន្ទាប់ពី កើតមាន នូវ ករណី គ្រោះថ្នាក់ ខាងលើ នេះ ដោយ មាន ការយកចិត្ត ទុក្ខ ដាក់ ពី លោក អភិបាល ខេត្ត កំពង់ឆ្នាំង លោក ក៏ បាន ឲ្យ រថយន្ត សង្គ្រោះ របស់ មន្ទីពេទ្យ បង្អែក ស្រុក បរិបូណ៌ ប្រញាប់ ចេញ ទៅ ដឹកជញ្ជូន ជនរងគ្រោះ យកមក សង្គ្រោះ បន្ទាន់ ភ្លាម ៗ នៅ មន្ទីរពេទ្យ និង បាន ចាត់ កម្លាំង សមត្ថកិច្ច ជំនាញ សហការ ជាមួយ អង្គភាព កំចាត់ មីន ស៊ីម៉ាក់ (CMAC) ចុះ ទៅដល់ ទីតាំង ដើម្បី ពិនិត្យ កន្លែង កើត ហេតុ ជាក់ស្តែង ក្រែង មាន សេសសល់ គ្រាប់ មិន ទាន់ ផ្ទុះ នៅ ទីនោះ ទៀត ។
អ្នកនាំពាក្យ នាយក រដ្ឋមន្ដ្រី បង្ហាញ លទ្ធផល ផ្លូវការ នៃ ជំនួប រវាង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត និង ឯក អគ្គ រាជ ទូត អេមីរ៉ាត់ អារ៉ាប់ ប្រចាំ កម្ពុជា
សកម្មភាព នេះ បាន ធ្វើឡើង កាលពី ចុង សប្ដាហ៍ នេះ ដោយ ចូលរួម សហការ ផងដែរ ពី តំណាង សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្ដាល ដែល មាន លោកស្រី ម៉ា រីណា ជា តំណាង ។
កញ្ញា លី មួយ លាង បាន ថ្លែង ថា កញ្ញា និង ក្រុមគ្រួសារ ចូលចិត្ត និង ស្រលាញ់ អំពើ សប្បុរសធម៌ ការចែក អំណោយ ដល់ ជន ក្រីក្រ កុមារ កំព្រា ជាដើម ដែល បាន ធ្វើជាច្រើន មក ហើយ ហើយ លើក នេះ កញ្ញា និង គ្រួសារ បាន មកដល់ សមាគម នេះ ដើម្បី ផ្ដល់ជូន អំណោយ ថវិកា និង ផ្ដល់ ក្ដី ស្រលាញ់ ដល់ កុមារ កំព្រា ទាំងអស់ ដែល កំពុង ស្នាក់ នៅ សិក្សា រៀសូត្រ នៅ ទីនេះ ។
កញ្ញា បន្ត ថា ក្ដី ស្រលាញ់ ពិត នេះ សបញ្ជាក់ ឲ្យ ឃើញ ពី ទឹកចិត្ត ខ្មែរ ស្រលាញ់ ខ្មែរ ខ្មែរ ជួយ ខ្មែរ ពិសេស គឺ កុមារ កំព្រា នេះ តែម្ដង ដែល ពួកគាត់ គ្មាន ទីពឹងពាក់ ឡើយ ហើយក៍ កោតសរសើរ ជាពិសេស ដល់ លោក ប៉េន សុផល ប្រធាន សមាគម ដែល បាន ខិតខំ បីបាច់ ថែរក្សា និង ផ្ដល់ ចំណេះដឹង ដល់ កុមា កំព្រា ទាំងអស់ ។
កញ្ញា បញ្ជាក់ ទៀត ថា នៅតែ បន្ត ចុះ ជួយ ដល់ សមាគម ជា បន្តបន្ទាប់ ទៅ តាម លទ្ធភាព និង បន្ត ចុះ ជួយ ជន ក្រីក្រ ចាស់ជរា គ្មាន ទីពឹង ជាដើម ហើយ សូម អំពាវនាវ កូន ខ្មែរ ទាំងអស់ មេត្តា ជួយ ដល់ កុមារ កំព្រា នៅ សមាគម ស្នាមញញឹម ថ្មី នៃ ក្តីសង្ឃឹម របស់ កុមារ ដែល មាន ទីតាំង ស្ថិត នៅ ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្ដាល ផង ដើម្បី បន្ត ជីវភាព និង ជួយ ដល់ កុមារ កំព្រា ចំនួន ១២០ នាក់ នេះ ឲ្យ មាន ក្ដីសង្ឃឹម កាន់តែ ល្អ ប្រសើរឡើង ។
លោក ប្រធាន សមាគម សូម អំពាវនាវ សប្បុរសជន ទាំងអស់ ទាំង ជិត - ឆ្ងាយ មេត្តា ជួយ ផ្ដល់ នូវ អំណោយ បន្ថែម ទៀត ជា បន្តបន្ទាប់ សម្រាប់ ចិញ្ចឹម បីបាច់ ថែរក្សា កុមារ កំព្រា ទាំងអស់ នៅ ទីនេះ ។ ពិសេស ក៏ សូម ថ្លែងអំណរគុណ លោក គង់ សោភ័ណ្ឌ ប្រធាន សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្ដាល ដែល លោក តែងតែ បាន ជួយ ឧបត្ថម្ភ ទំនុកបម្រុង ជា បន្តបន្ទាប់ រហូតមក ។
សូម ជម្រាប ថា សមាគម ស្នាមញញឹម ថ្មី នៃ ក្តីសង្ឃឹម តបស់ កុមារ បាន បង្កើតឡើង ឆ្នាំ ២០០២ បាន ចុះបញ្ជី ជាមួយ ក្រសួង មហាផ្ទៃក្នុង ឆ្នាំ ២០១៦ ដឺល ដំបូង បាន ចាប់ផ្តើម ឡើង ដោយ ប្រមូល កុមារ បាន ចំនួន ១៥នាក់ រហូតមក បច្ចុប្បន្នភាព នេះ កុមារ ចំនួន ១២០ នាក់ ហើយ កំពុង ស្នាក់ នៅ និង សិក្សា រៀនសូត្រ ។ សមាគម មាន បុគ្គលិក និង អ្នកថែទាំ កុមារ ចំនួន ១៦ នាក់ ។
សូម បញ្ជាក់ ថា កុមារ ទាំងអស់ ដែល បាន ស្នាក់ នៅក្នុង សមាគម គ្រប់ ទម្រង់ និង គ្រប់ រសជាតិ ទាំងអស់ សុទ្ធតែ កុមារ បញ្ហា ទាំងអស់ ហើយ សមាគម យើង ទទួល កុមារ គ្រប់ ២៤ ខេត្ត ក្រុង ។ គោលដៅ ដ របស់ សមាគម គឺ ជួយ កុមារ ងាយ រងគ្រោះ និង កុមារ រងគ្រោះ ត្រូវបាន គេ បោះបង់ ចោល ត្រូវបាន រំលោភបំពាន ត្រូវ គេ គំរាមកំហែង កេងប្រវញ្ច័ កម្លាំង ពលកម្ម ត្រូវ គេ ធ្វើបាប និង កុមារ អនាថា ដែល ពុំ បាន ទទួល អ្វី ទាំងអស់ យកមក ចឹញ្ចឹម បីបាច់ ថែរក្សា ស្នាក់ នៅ សិក្សា រៀនសូត្រ ។
គោលបំណង របស់ សមាគម គឺ ចង់ឲ្យ កុមារ ទាំងអស់ នោះ ទទួល នូវ សិទ្ធិ សេរីភាព សិទ្ធ រស់រាន មាន ជីវិត សិទ្ធិ ទទួលបាន ការអប់រំ រៀនសូត្រ សិទ្ធិ ទទួល ការថែទាំ និង ទទួល អាហារ រូបត្ថម្ភ ទទួលបាន នូវ ភាពកក ក្តៅ ផ្តល់ ក្តីស្រឡាញ់ ផ្តល់ នូវ ក្តីសង្ឃឹម ដល់ ពួកគេ ទាំងអស់ នោះ ដូចជា កុមារ ដទៃ ទៀត ដូច នៅក្នុង ពិភពលោក យើង នេះ ដែរ ។
សម្តេច ប្រធាន រដ្ឋសភា បាន គូសបញ្ជាក់ ថា ប្រទេស កាណាដា បាន ដើរ តួនាទី ដ៏ សំខាន់ ក្នុង ការរួមចំណែក ដល់ ដំណើរការ កសាង សន្តិភាព ស្តារ និង អភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម របស់ កម្ពុជា ដែល ក្នុង នោះ ជំនួយ គាំទ្រ ទាំង ផ្នែក បច្ចេកទេស និង ហិរញ្ញវត្ថុ បាន រួម ជា វិភាគទាន ដ៏ មាន តម្លៃ ចូលរួម ស្តារ កសាង និង អភិវឌ្ឍន៍ កម្ពុជា ក្នុង នោះ មាន វិស័យ ពាណិជ្ជកម្ម វិនិយោគ បោស សំអាត មីន កងកម្លាំង រក្សា សន្តិភាព បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង ជំនួយ មនុស្សធម៌ ផ្សេង ៗ ជាច្រើន ទៀត ។
សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី បាន គូសបញ្ជាក់ ថា ប្រទេស កម្ពុជា បាន ប្រែក្លាយ ពី ប្រទេស ដែល ទទួល ជំនួយ សន្តិភាព ពី បរទេស ទៅជា ប្រទេស ដែល បាន បញ្ជូន កងកម្លំាង រក្សា សន្តិភាព ទៅកាន់ ប្រទេស នានា នាំមុខ គេ នៅក្នុង តំបន់ អាស៊ាន ។ បច្ចុប្បន្ន ក្រោម ឆត្រ អង្គការ សហ ប្រជាជាតិ កងកម្លំាង មួក ខៀវ កម្ពុជា បាន ចួល រួម រក្សា សន្តិភាព នៅក្នុង ប្រទេស ចំនួន ៩ នៅក្នុង ពិភពលោក ៕
ទេសរដ្ឋមន្រ្តី លី ធុជ៖ កម្ពុជា នៅតែ ត្រូវការ ជំនួយ ពី ប្រទេស ជា មិត្ត និង ដៃគូ អភិវឌ្ឍន៍ ពាក់ព័ន្ធ ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន
ទេសរដ្ឋមន្រ្តី បាន គូសបញ្ជាក់ ថា ទោះបី កម្ពុជា ទទួលបាន ជោគជ័យ ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន បាន ច្រើន យ៉ាងណា ក្តី ប៉ុន្តែ កម្ពុជា នៅតែ បន្ត រង ផល ប៉ះពាល់ ដោយសារ គ្រាប់ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ដែល នៅ សេសសល់ ដែល តម្រូវ ឱ្យ មាន ចូលរួមចំណែក ពី ប្រទេស ជា មិត្ត និង ដៃគូ អភិវឌ្ឍន៍ ពាក់ព័ន្ធ ផងដែរ ៕ មេបញ្ជាការ មូលដ្ឋាន សមុទ្រ រាម ទទួលស្វាគមន៍ នាវា ១ គ្រឿង របស់ ចិន ដែល គ្រោង ធ្វើ សមយុទ្ធនាគ មាស នៅ សប្តាហ៍ នេះ
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ក្រាបបង្គំទូល ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម ៧១ យាង ចូល ៧២ ព្រះវស្សា
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ក្រាបបង្គំទូល ថ្វាយ សារ លិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ឱកាស ដ៏ មហាន ក្ខត្ត ឫក្ស ឧត្តុង្គឧត្តម នៃ ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម គម្រប់ ៧១ យាង ចូល ៧២ ព្រះវស្សា ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៤ ខែឧសភា ឆ្នាំ ២០២៤ នេះ ។
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ប្រារព្ធ ព្រះរាជ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម វស្សា របស់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី
ទូលព្រះបង្គំ យើងខ្ញុំ សូម សម្តែង នៅ ទឹកចិត្ត ស្វាមី ភក្ត័ និង ដង្ហែ តាម មាគ៌ា នយោបាយ ដ៏ ភ្លឺស្វាង ពោរពេញ ដោយ ព្រះរាជ គតិបណ្ឌិត របស់ ព្រះករុណា ព្រះអម្ចាស់ ជីវិត លើ ត្បូង សម្រាប់ ជា និមិត្តរូប នៃ ឯករាជ្យភាព អធិបតេយ្យភាព វឌ្ឍនភាព និង បូរណភាព ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ទូលព្រះបង្គំ យើងខ្ញុំ ទាំងអស់ គ្នា សូម លើកហត្ថ បួងសួង ដល់ គុណ បុណ្យ ព្រះរតន ត្រយ័ និង សូម តេជ្ជះ បារមី ទេវតា ថែរក្សា មហា ស្វេតច្ឆត្រ ព្រមទាំង បារមី នៃ ព្រះវិញ្ញាណក្ខន្ធ ព្រះអង្គ ព្រះមហាក្សត្រ ព្រះមហាក្សត្រ យ៉ានី សូម ជួយ ប្រោស ព្រំ បី បាច់ ថែរក្សា ព្រះករុណា ព្រះអម្ចាស់ ជីវិត តំកល់ លើ ត្បូង សូម ព្រះអង្គ ប្រកបដោយ ព្រះរាជ បញ្ញា ញាណ ភ្លឺ ថ្លា កាយ ពល សេរី វឌ្ឍនា ព្រះរាជ សុខភាព ល្អ បរិបូណ៌ ព្រះជន្មាយុ យឺនយូ ជាង រយ ព្រះវស្សា ៕
( បន្តាយ មានជ័យ ) ៖ បុរស វ័យ ចំណាស់ ម្នាក់ បាន យក គ្រាប់បែក DK75 ចាស់ ដែល បន្សល់ទុក តាំងពី សម័យ សង្គ្រាម យក ដំជា បំណែក ធ្វើជា កណ្តឹង គោ ស្រាប់តែ ផ្ទុះ អំបែង គ្រាប់ ខ្ទាត ត្រូវ ចំសុះ សាច់ បណ្តាលឲ្យ ស្លាប់ ភ្លាម ៗ នៅនឹង កន្លែង តែម្តង កាលពី រសៀល ថ្ងៃទី ១២ ខែឧសភា ឆ្នាំ ២០២៤ នៅ ផ្ទះ ជនរងគ្រោះ ស្ថិត ក្នុង ភូមិ ត្រាង ឃុំ ភ្នំ ដី ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ។
