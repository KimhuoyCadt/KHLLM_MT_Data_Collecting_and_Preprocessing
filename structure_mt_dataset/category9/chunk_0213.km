លោក ឈាង វណ្ណា រិទ្ធ ប្រធាន វិទ្យាស្ថាន ចក្ខុវិស័យ អាស៊ី (AVI) មានប្រសាសន៍ ថា ការខកចិត្ត របស់ សហរដ្ឋ អាមេរិក គឺ អាស្រ័យ លើ របៀប ដែល សហរដ្ឋ អាមេរិក យល់ឃើញ ពី ការរុះរើ អគារ ។
លោក បន្ត ថា ការពិភាក្សា និង ការពិគ្រោះយោបល់ ទ្វេ ភាគី មាន សារៈសំខាន់ ក្នុង ការជំរុញ ការយោគយល់ គ្នា ទៅ វិញ ទៅមក ។
នៅពេល សួរ ថា តើ គាត់ ជឿ ថា មាន កិច្ចព្រមព្រៀង សម្ងាត់ ជាមួយ ប្រទេស ចិន ឬ យ៉ាងណា នោះ វណ្ណា រិទ្ធ បាន និយាយ ថា៖ យើង ត្រូវ ផ្លាស់ប្តូរ ពី ពិភព ក្រោយ ការពិត ទៅកាន់ ពិភព ពិត ។ យើង ត្រូវការអង្គហេតុ និង ភ័ស្តុតាង ដើម្បី គាំទ្រ ការលើកឡើង និង ជំហរ របស់ យើង ។ ប្រសិនបើ សហរដ្ឋ អាមេរិក នៅតែ ជឿ ថា កម្ពុជា និង ចិន មាន " កិច្ចព្រមព្រៀង សម្ងាត់ " នោះ គួរតែ បញ្ចេញ ភស្តុតាង ជាសាធារណៈ ។ អ្នកសង្កេតការណ៍ ក្នុង តំបន់ និង អ្នកវិភាគ ពិតជា ចាប់អារម្មណ៍ ចង់ ឃើញ វា ។
ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា លោក សុខ ទូច មានប្រសាសន៍ ថា កម្ពុជា គួរតែ ជូនដំណឹង ទៅ សហរដ្ឋ អាមេរិក អំពី ការរុះរើ អគារ ដើម្បី បង្ហាញ ការគោរព ចំពោះ ជំនួយ មនុស្សធម៌ របស់ សហរដ្ឋ អាមេរិក ។ ប៉ុន្តែ ក្នុង ករណី នេះ លោក ថា កម្ពុជា អាច រុះរើ អគារ ទាំងនោះ ចេញ បាន ប្រសិនបើ ពួកគេ ឆ្លើយតប នឹង តម្រូវការ ជាក់ស្តែង ដូច នៅក្នុង ទឹកដី កម្ពុជា ។
ទូច បាន និយាយ ថា លោក មិន ជឿ ថា មាន កិច្ចព្រមព្រៀង សម្ងាត់ រវាង ប្រទេស ទាំង ពីរ ទេ ដោយសារ រដ្ឋធម្មនុញ្ញ របស់ កម្ពុជា មិន អនុញ្ញាតឲ្យ មាន កិច្ចព្រមព្រៀង បែប នេះ ។ លោក បន្ត ថា កិច្ចព្រមព្រៀង ទាំងអស់ ត្រូវ តាក់តែង ដោយ រដ្ឋាភិបាល និង អនុម័ត ដោយ រដ្ឋសភា ។
តាមពិត វា ជា បញ្ហា ភូមិសាស្ត្រ នយោបាយ ។ សហរដ្ឋ អាមេរិក ព្យាយាម គ្រប់គ្រង ប្រទេស នៅក្នុង សមាគម ប្រជាជាតិ អាស៊ី អាគ្នេយ៍ អាស៊ាន ។ វៀតណាម ជា ប្រទេស កុម្មុយនិស្ត ជា ដៃគូ របស់ អាមេរិក ។ ដូច្នេះ នៅពេល កម្ពុជា មាន ទំនាក់ទំនង ជិតស្និទ្ធ ជាមួយ ចិន អាមេរិក ចាញ់ ក្នុង ភូមិសាស្ត្រ នយោបាយ ។ មិន មាន អ្វី ទាក់ទង នឹង ការផ្លាស់ប្តូរ ទីតាំង អគារ ទាំងនោះ ទេ ។
គិត ត្រឹម ខែវិច្ឆិកា នេះ គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា (BAKC) បាន ផ្តល់ តំណាង ផ្លូវ ច្បាប់ ក្នុង សំណុំរឿង ប្រជាពលរដ្ឋ ក្រីក្រ ជិត ៥០០០ ករណី នៅ សាលាដំបូង រាជធានី ភ្នំពេញ និង ខេត្ត កើនឡើង ជិត ៣០ ភាគរយ បើ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ឆ្នាំ មុន ។
លោក លី ចាន់តូឡា ប្រធាន គណៈ មេធាវី បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ថា គណៈ មេធាវី មាន ប្រតិភូ ឈរ នៅ តុលាការ ក្នុង តំបន់ ចំនួន ៤ នៃ រាជធានី និង ខេត្ត ទូទាំង ប្រទេស ។ គណៈប្រតិភូ BAKC ផ្តោត លើ ជនសង្ស័យ ដែល ត្រូវបាន ចោទប្រកាន់ ពី បទឧក្រិដ្ឋ ។
ការងារ នេះ គឺ ស្ម័គ្រចិត្ត ។ យើង ក៏ ស្នើសុំ ឱ្យ រដ្ឋាភិបាល បន្ត បង្កើន ការគាំទ្រ ផ្នែក ហិរញ្ញវត្ថុ ប្រចាំ ឆ្នាំ របស់ ខ្លួន ដល់ របារ ។ សង្ឃឹម ថា សមាគម ជួយសម្របសម្រួល អនុវត្ត ការងារ ស្ម័គ្រចិត្ត នេះ ដើម្បី ការពារ ករណី ជួយ ជន ក្រីក្រ ។ ករណី បាន កើនឡើង យ៉ាង ខ្លាំង នា ពេល ថ្មី ៗ នេះ ។
អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ លោក ជិន ម៉ាលីន ថ្លែង នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ថា BAKC បាន ធ្វើការ យ៉ាង ទូលំទូលាយ ជាមួយ ក្រសួង ទាក់ទង នឹង ជំនួយ ផ្នែក ច្បាប់ ។
BAKC ចាត់តាំង មេធាវី ជូន ប្រជាពលរដ្ឋ ដែល ខ្វះខាត ដោយ មិន គិត ថ្លៃ ហើយ ក្រសួង បង់ ថ្លៃ ដើម្បី ជួយ មេធាវី ការពារ ក្តី ស្ម័គ្រចិត្ត តំណាង ឱ្យ ជនសង្ស័យ ។
លោក បាន បន្ត ថា៖ ធនាគារ បាក ស៊ី ក៏ បាន ចូលរួម ជាមួយ ក្រសួង យុត្តិធម៌ ក្នុង យុទ្ធនាការ របស់ ខ្លួន ដើម្បី ជម្រះ សំណុំរឿង នៅ សាលាដំបូង រាជធានី និង ខេត្ត ។
នៅលើ ភព ព្រះអង្គារ វា នឹង ស្វែងរក សញ្ញា នៃ ជីវិត បុរាណ និង ប្រមូល សំណាក ថ្ម និង ដី សម្រាប់ ការវិលត្រឡប់មក ផែនដី វិញ ។ គិត ត្រឹម ថ្ងៃច័ន្ទ វា បាន ឈានដល់ 56 ភាគរយ នៃ ការធ្វើដំណើរ ទៅកាន់ ភព ព្រះអង្គារ នេះ បើ យោង តាម រដ្ឋបាល អាកាសចរណ៍ និង អវកាស ជាតិ ( ណា សា) ។
ឪពុក ម្តាយ របស់ អ្នក បាន រួច ជីវិត ពី របប ខ្មែរ ក្រហម ។ តើ អ្នក អាច ប្រាប់ យើង យ៉ាង ខ្លី អំពី ការធ្វើដំណើរ របស់ ពួកគេ ទៅកាន់ សហរដ្ឋ អាមេរិក បាន ទេ ?
ឪពុក ម្តាយ របស់ ខ្ញុំ បាន ចែករំលែក ថា ប្រទេស កម្ពុជា ជា ប្រទេស ដ៏ ស្រស់ស្អាត ហើយ ប្រជាជន ក៏ មាន ចិត្ត ល្អ ផងដែរ ។ វា ជា រឿង ដ៏ គួរឱ្យ ភ័យខ្លាច ដែល ខ្មែរ ក្រហម បាន បំផ្លាញ ប្រទេស និង ប្រជាជន យ៉ាង ច្រើន ។ ឪពុក ម្តាយ របស់ ខ្ញុំ មាន ការចងចាំ ដ៏ រីករាយ នៃ ឆ្នាំ ដ៏ អស្ចារ្យ មុនពេល របប ខ្មែរ ក្រហម ចូល កាន់ តំណែង ។
ខ្ញុំ ជា វិស្វករ ប្រព័ន្ធ នៅ JPL ។ ខ្ញុំ ប្រាកដ ថា ផ្នែក ជាច្រើន នៅលើ រ៉ូវ័រ បង្វិល និង ចង្អុល ផ្លូវ ដែល ពួកគេ គួរ ។ យាន រ៉ូវឺរ មាន បង្គោល - ក្បាល របស់ វា ជា មូលដ្ឋាន - និង អង់តែន ដែល ទទួលបាន ខ្ពស់ ដែល ទទួលបញ្ជា ពី ផែនដី ។ យន្តការ ទាំង ពីរ ត្រូវ បង្វិល និង ចង្អុល ទៅ ទិស ផ្សេង ៗ គ្នា ។ បង្គោល ចង្អុល កាមេរ៉ា រុករក របស់ វា ដើម្បីឱ្យ អ្នកបើកបរ និង វិស្វករ អាច មើលឃើញ ផ្លូវ នៅ ខាងមុខ និង កន្លែង ធ្វើការ នៅ ពីមុខ រ៉ូវ័រ ។
ដើមទ្រូង ក៏ ចង្អុល ឧបករណ៍ របស់ វា ដើម្បីឱ្យ អ្នកវិទ្យាសាស្ត្រ អាច រុករក ភព អង្គារ បាន ។ អង់តែន ត្រូវតែ ចង្អុល ទៅ កន្លែង ដែល ផែនដី ស្ថិត នៅលើ មេឃ ដើម្បីឱ្យ យើង ទាក់ទង ផ្ទាល់ ជាមួយនឹង រ៉ូវឺរ ។
