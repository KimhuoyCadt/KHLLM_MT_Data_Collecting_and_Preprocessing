លោក នេត្រ វន្ថា ប្រធាន នាយកដ្ឋាន នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា បាន អំពាវនាវ ជាថ្មី ឲ្យ ប្រជាពលរដ្ឋ ជាពិសេស អ្នក នៅក្នុង រាជធានី ភ្នំពេញ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ។
៤០ ភាគរយ នៃ អគ្គីភ័យ ទាំងអស់ គឺ បណ្តាល មកពី ការផ្ទុះ អគ្គិសនី ហើយ ៣៩ ភាគរយ គឺ បណ្តាល មកពី ការប្រើប្រាស់ ភ្លើង ដោយ មិន ប្រុងប្រយ័ត្ន ចង្ក្រាន ទៀន ភ្លើង ធូប ។ នៅសល់ ២១ ភាគរយ ទៀត កំពុង ស្ថិត ក្រោម ការស៊ើបអង្កេត ។
បើ តាម លោក វ៉ាន់ ថា ក្នុង អំឡុង ពេល រដូវ ស្លឹកឈើ ជ្រុះ ដែល នាំមក នូវ អាកាសធាតុ ត្រជាក់ ដល់ ខេត្ត មួយចំនួន នៅ ភូមិភាគ ឦសាន និង ជួរ ភ្នំ ដងរែក ក៏ ដូចជា តំបន់ ទំនាប កណ្តាល ប្រជាពលរដ្ឋ អាច ពន្លត់ ភ្លើង ដើម្បី ទប់ស្កាត់ សីតុណ្ហភាព ត្រជាក់ ។ ប្រការ នេះ បង្កឱ្យ មាន ភ្លើង ឆេះ កាន់តែ ច្រើន ប្រសិនបើ ប្រជាពលរដ្ឋ មិន មាន ការប្រុងប្រយ័ត្ន និង មិន ពន្លត់ ភ្លើង មុនពេល ចេញ ទៅ ក្រៅ ។
អគ្គីភ័យ បាន ឆាបឆេះ ផ្ទះ ប្រជាពលរដ្ឋ នៅ សង្កាត់ ផ្សារ ដើម ថ្កូវ រាជធានី ភ្នំពេញ កាលពី ថ្ងៃអង្គារ ។ នាយកដ្ឋាន ពន្លត់ អគ្គីភ័យ ក្រុង
ទន្ទឹមនឹង ជំរុញ ឱ្យ សមត្ថកិច្ច បង្កើត វគ្គ បណ្តុះបណ្តាល បច្ចេកទេស ក្នុង ការបង្ការ អគ្គិភ័យ លោក វ៉ាន់ ថា ក៏ បាន ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ទិញ បំពង់ ពន្លត់ អគ្គិភ័យ ដើម្បី ការពារ ភ្លើង ឆេះ ផ្ទះ ។ លោក ថា ប្រជាពលរដ្ឋ មិន គួរ ដុត ស្មៅ ឬ ព្រៃឈើ ក្នុង រដូវ នេះ ទេ ព្រោះ ខ្យល់ បក់ ខ្លាំង អាច បង្កឱ្យ មាន កំទេចកំទី ប៉ះពាល់ ផ្ទះ អ្នកដទៃ បង្ក ជា អគ្គិភ័យ ។
លោក អ៊ឹង យូឡាយ ប្រធាន អង្គភាព ផ្សព្វផ្សាយ ព័ត៌មាន បង្ការ ពន្លត់ អគ្គីភ័យ នៃ ការិយាល័យ បង្ការ ពន្លត់ អគ្គីភ័យ និង សង្គ្រោះ ខេត្ត ឧត្តរមានជ័យ បាន ដឹកនាំ មន្ត្រី នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ចុះ អប់រំ ប្រជាពលរដ្ឋ និង អាជីវករ ផ្សារ សំរោង អំពី របៀប ប្រើប្រាស់ និង ថែទាំ បំពង់ ពន្លត់ អគ្គិភ័យ ដូចជា ក៏ ដូចជា វិធីសាស្រ្ត ពន្លត់ អគ្គីភ័យ ផ្សេង ទៀត ។
ការពន្លត់ ភ្លើង មិន មែន ជា ការងាយស្រួល នោះ ទេ វា ទាមទារ ការអត់ធ្មត់ និង ភាពក្លាហាន ។ បញ្ហា គឺ ផ្សែង ខ្មៅ និង អណ្តាត ភ្លើង ក្តៅ អាច ប៉ះពាល់ ដល់ សុខភាព និង អាយុជីវិត ប្រសិនបើ យើង មិន មាន ឧបករណ៍ បច្ចេកទេស គ្រប់គ្រាន់ ដើម្បី ជួយ ។
ក្រសួង សុខាភិបាល និង រដ្ឋបាល រាជធានី ភ្នំពេញ កំពុង ពន្លឿន ការសាងសង់ មជ្ឈមណ្ឌល ដាក់ ឲ្យ នៅ ដាច់ដោយឡែក ថ្មី ដើម្បី ត្រៀម ជាស្រេច នៅ ចុង ឆ្នាំ នេះ ។
ការសាងសង់ បាន ចាប់ផ្តើម នៅក្នុង ខែកញ្ញា ។ រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល លោក ម៉ម ប៊ុន ហេង និង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ចុះ ពិនិត្យ ការវិវឌ្ឍន៍ នៅ ថ្ងៃទី ៥ ខែវិច្ឆិកា ហើយ ថា ពួកគេ ចង់ បញ្ចប់ ឱ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន ។
អ្នកនាំពាក្យ ក្រសួង លោកស្រី ឱ វណ្ណឌីន ថ្លែង នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ថា មជ្ឈមណ្ឌល នេះ មាន អគារ ចំនួន ៤ លើ ផ្ទៃដី ជិត ១ហិកតា ក្នុង សង្កាត់ ព្រែក ព្នៅ ខណ្ឌ ព្រែក ព្នៅ ។
លោកស្រី បាន បន្ត ថា៖ យើង នឹង ខិតខំ ប្រឹងប្រែង ដើម្បី បញ្ចប់ មជ្ឈមណ្ឌល នេះ តាម ផែនការព្រោះ តម្រូវការ មាន សារៈសំខាន់ ។
រដ្ឋលេខាធិការ ក្រសួង ការបរទេស យ៉ក សម្បត្តិ បាន ប្រាប់ អ្នកសារព័ត៌មាន ថា មជ្ឈមណ្ឌល នេះ នឹង អាច ផ្ទុក មនុស្ស បាន ចំនួន ៤៦០ នាក់ ។ ក្រសួង មាន គម្រោង សាងសង់ អគារ ពីរ បន្ថែម ទៀត ដើម្បី អាច ផ្ទុក មនុស្ស បាន ៨០០ នាក់ ។ គម្រោង នេះ នឹង ត្រូវ ចំណាយ ថវិកា ប្រមាណ ៧៩ ម៉ឺន ដុល្លារ ដោយ មាន ថវិកា ពី ថវិកា របស់ រដ្ឋាភិបាល ។
រដ្ឋាភិបាល បាន និង កំពុង ប្រើ សាលា មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ ដើម្បី ដាក់ ឲ្យ នៅ ដាច់ដោយឡែក ពី ពលរដ្ឋ ខ្មែរ ដែល ធ្វើដំណើរ មកពី បរទេស ។
ប្រជាជន កម្ពុជា ដែល ធ្វើដំណើរ មកពី បរទេស នឹង ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក ពី គេ នៅក្នុង មជ្ឈមណ្ឌល នេះ បន្ទាប់ពី វា រួចរាល់ ខណៈ ដែល ជន បរទេស ត្រូវ ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក នៅក្នុង សណ្ឋាគារ ។ នេះ នឹង ធ្វើឱ្យ មាន ភាពងាយស្រួល ក្នុង ការគ្រប់គ្រង ។ នៅក្នុង មជ្ឈមណ្ឌល ដាក់ ឲ្យ នៅ ដាច់ គេ នឹង មាន គ្រូពេទ្យ និង ឧបករណ៍ ដែល បាន រៀបចំ ។
ខ្ញុំ បាន បញ្ជា ឲ្យ ក្រសួង សុខាភិបាល និង អាជ្ញាធរ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ពិនិត្យ លើ មនុស្ស ទាំងអស់ ដែល ត្រូវបាន ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក ។ លោក បន្ត ថា ប្រសិនបើ ពួកគេ មិន ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក នៅ ផ្ទះ ទេ ពួកគេ នឹង ត្រូវ អញ្ជើញ ឱ្យ ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក តាម កន្លែង ដែល រៀបចំ ដោយ ក្រសួង សុខាភិបាល ។
តុលាការ កំពូល នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា បាន បញ្ជូន សំណុំរឿង ជួញដូរ កាំភ្លើង ទៅ សាលាឧទ្ធរណ៍ ដើម្បី បើក សវនាការ ។
ជនជាប់ចោទ ឈ្មោះ ជា ហៀប អាយុ ២០ ឆ្នាំ ត្រូវបាន តុលាការ រកឃើញ ថា មាន ពិរុទ្ធ ពី បទ ជួញដូរ កាំភ្លើង ខ្លី ចំនួន ៣០ ដើម និង កាំភ្លើង ១ដើម កាលពី ឆ្នាំ ២០១៨ នៅ ខេត្ត សៀមរាប ។
លោក ចៅក្រម សាលី ធារ៉ា បាន និយាយ បន្ទាប់ពី ស្តាប់ មេធាវី ការពារ ក្តី របស់ លោក ហ៊ាប ហោ និង ការសន្និដ្ឋាន របស់ ព្រះរាជអាជ្ញា តុលាការ ទទួលស្គាល់ ថា ចុង ចោទ បាន ទទួលស្គាល់ កំហុស របស់ ខ្លួន ហើយ បាន ស្នើ ឱ្យ តុលាការ ជាន់ ទាប បន្ធូរបន្ថយ ទោស ។
ជនសង្ស័យ បាន ប្រាប់ តុលាការ ថា គាត់ មាន ឪពុក ម្តាយ ចាស់ ហើយ ចង់បាន ទោស ទាប ជាង នេះ ទើប គាត់ អាច បន្ត ការសិក្សា បាន ។
តុលាការ មើលឃើញ ថា ជនសង្ស័យ នៅ ក្មេង ហើយ ត្រូវ បន្ត ការអប់រំ ។ គាត់ បាន ទទួលស្គាល់ កំហុស របស់ គាត់ ដូច្នេះ តុលាការ កំពូល បញ្ជូន សំណុំរឿង នេះ ទៅ សាលាឧទ្ធរណ៍ ដើម្បី បើក សវនាការ ម្ដង ទៀត ។
លោក ហៀប ហោ ត្រូវបាន ចាប់ខ្លួន កាលពី ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ មុន ។
សាលាដំបូង ខេត្ត សៀមរាប បាន ចេញ សាលក្រម កាលពី ថ្ងៃទី ២ ខែវិច្ឆិកា ឆ្នាំ មុន ដោយ ផ្ដន្ទាទោស ម្នាក់ ៗ ឲ្យ ជាប់ ពន្ធនាគារ ៥ ឆ្នាំ ពី បទ ជួញដូរ អាវុធ និង រំសេវ តាម មាត្រា ៤៨៨ នៃ ក្រម ព្រហ្មទណ្ឌ ។
លោក ហៀប ហោ បាន ប្តឹង ឧទ្ធរណ៍ ចំពោះ សាលក្រម នេះ ហើយ តុលាការ ជាន់ ខ្ពស់ បាន បន្ថយ ទោស គាត់ ត្រឹម មួយ ឆ្នាំ ។
មន្ត្រី ប៉ូលិស ម្នាក់ ដែល ចោទ ថា បាន បើក រថយន្ត ចូល ផ្ទះ សម្លាប់ មនុស្ស ៤នាក់ នៅ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង កាលពី ឆ្នាំ មុន ត្រូវបាន កោះហៅ ឲ្យ ចូល ខ្លួន ទៅ សាលាដំបូង ខេត្ត នៅ ថ្ងៃទី ២២ ខែវិច្ឆិកា ដើម្បី សាកសួរ ។
មន្ត្រី រូប នេះ ឈ្មោះ សុខ សុភ័ក្ត្រ អាយុ ៣៥ ឆ្នាំ រស់ នៅ សង្កាត់ ផ្សារ ដើម គរ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ត្រូវបាន កោះហៅ មុន នេះ ប៉ុន្តែ មិន បាន ចូល បំភ្លឺ នៅ តុលាការ ទេ ។
ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី ថ្ងៃទី ១០ ខែមីនា ឆ្នាំ មុន នៅ ឃុំ តា សួស ស្រុក ស្វាយ ជ្រំ ។ បើ តាម បង ប្រុស របស់ ជនរងគ្រោះ ម្នាក់ ឈ្មោះ នាង រិន បាន ឲ្យដឹង ថា មន្ត្រី រូប នោះ បាន បើក រថយន្ត ចូល ផ្ទះ បង ប្រុស របស់ គាត់ បណ្តាលឲ្យ ស្លាប់ និង ប្រពន្ធ និង កូនប្រុស ទាំង ពីរ អាយុ ពី ២ខែ ទៅ ២ឆ្នាំ ។
តាំងពី ថ្ងៃ កើត ហេតុ មក តុលាការ បាន កោះហៅ ខ្ញុំ ចូល បំភ្លឺ នៅ តុលាការ បី ដង ហើយ ជនល្មើស មិន ដែល បង្ហាញ ខ្លួន ទេ ។
លោក សុភ័ក្រ្ត ត្រូវបាន ចោទប្រកាន់ ពី បទ បើកបរ មិន ប្រកាន់ ស្ដាំ និង បណ្ដាលឲ្យ មាន របួស និង ស្លាប់ តាម មាត្រា ៨៣ និង ៨៥ នៃ ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ។
ខ្ញុំ គ្រាន់តែ ចង់ ជួប ជនល្មើស ។ ខ្ញុំ បាន ទៅ តុលាការ ប៉ុន្តែ ខ្ញុំ មិន ដែល ឃើញ គាត់ ទេ ។ ខ្ញុំ គ្រាន់តែ ទាមទារ សំណង ។ លោក បន្ត ថា ការផាកពិន័យ នឹង ត្រូវ ទុកឲ្យ នៅ ចំពោះ មុខ ច្បាប់ ។
គាត់ បាន និយាយ ថា ប្អូន ប្រុស គាត់ ជាជាង ជួសជុល ម៉ូតូ ហើយ ធ្វើការ នៅ រោង ជាង នៅមុខ ផ្ទះ ។ ក្រោយពេល កើត ហេតុ ម្ចាស់ រថយន្ត បាន ចូលរួមចំណែក បុណ្យ សព ចំនួន ២លាន រៀល ។
អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត លោក ទេ ព ផល្លា ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ១០ ខែវិច្ឆិកា ថា តុលាការ នឹង ចេញ ដីកា ចាប់ខ្លួន លោក សុភ័ក្រ្ត ប្រសិនបើ លោក មិន ចូលខ្លួន មក តុលាការ ។
លោក បាន បន្ត ថា៖ តាម នីតិវិធី របស់ តុលាការ ជំហាន ដំបូង គឺ កោះហៅ ជនល្មើស មក ប៉ុន្តែ ប្រសិនបើ គាត់ ត្រូវ កោះហៅ ហើយ មិន ចូលខ្លួន ជា លើក ទី បី នោះ ដីកា ចាប់ខ្លួន នឹង ចេញ ។
អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន លោក នេត្រ ភក្ត្រា មានប្រសាសន៍ ថា ក្រសួង បរិស្ថាន កំពុង បោះ បង្គោល ព្រំដែន ជុំវិញ តំបន់ ការពារ ដើម្បី ទប់ស្កាត់ ការទន្ទ្រាន ព្រៃឈើ ខុស ច្បាប់ ។
លោក ភក្ត្រា បាន និយាយ ថា បង្គោល ព្រំដែន ត្រូវបាន បង្កើត រួចហើយ ដើម្បី សម្គាល់ តំបន់ ការពារ ធម្មជាតិ ចំនួន ៥។ ដែន ជម្រក សត្វ ព្រៃ ពាម ក្រសោប ដែន ជម្រក សត្វ ព្រៃ ភ្នំ ព្រិច ដែន ជម្រក សត្វ ព្រៃ ស្រែ ពក ដែន ជម្រក សត្វ ព្រៃ សៀម ប៉ាង និង ដែន ជម្រក សត្វ ព្រៃ លំ ផាត់ ។
ការបោះ បង្គោល និង ការបែងចែក អាច រួមបញ្ចូល តំបន់ ចំនួន ២០ បន្ថែម ទៀត រួម មាន ដែន ជម្រក សត្វ ព្រៃឡង់ ដែន ជម្រក សត្វ ព្រៃ កែវ សីមា និង ដែន ជម្រក សត្វ ព្រៃ ដទៃ ទៀត ដែល ស្ថិត នៅក្រោម យុត្តាធិការ របស់ ក្រសួង ។
យើង បាន បង្កើត បង្គោល ព្រំដែន សំខាន់ ចំនួន ២០០០ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ហើយ បន្ត ដំឡើង បន្ថែម ទៀត ។
លោក បន្ត ថា៖ ពាក់ព័ន្ធ នឹង ការដាំ បង្គោល ព្រំដែន វា សំខាន់ ណាស់ ក្នុង ការកំណត់ តំបន់ ដែល យើង ត្រូវការ ការពារ ឱ្យ បាន ច្បាស់លាស់ ។ យើង បែងចែក តំបន់ ការពារ ជា បួន ប្រភេទ គឺ តំបន់ ស្នូល តំបន់ អភិរក្ស តំបន់ ប្រើប្រាស់ ច្រើន និង តំបន់ សហគមន៍ ។
លោក ភក្ត្រា បាន មានប្រសាសន៍ ថា ក្រសួង កំពុង បន្ត អនុវត្ត អនុសាសន៍ ដែល បាន បង្ហាញ ក្នុង កិច្ចប្រជុំ ពេញ អង្គ នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី កាលពី ថ្ងៃទី ៣ ខែកក្កដា ដែល លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន បញ្ជា ឱ្យ ក្រសួង ចំនួន បី គឺ បរិស្ថាន ។ ការគ្រប់គ្រង ដីធ្លី ការធ្វើ ផែនការ ទីក្រុង និង សំណង់ ; និង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ - ដើម្បី សិក្សា និង ចង ក្រង ការស្រាវជ្រាវ លើ ដី ដែល ប្រជាពលរដ្ឋ បាន អាស្រ័យ អស់ រយៈពេល ជាច្រើន ឆ្នាំ នៅក្នុង តំបន់ ការពារ ។ ដី នឹង ត្រូវ ប្រគល់ឲ្យ ប្រជាជន ។
លោក ជា ហ៊ាន នាយក អង្គការ ប្រឆាំង អំពើពុករលួយ ការពារ ធនធាន ធម្មជាតិ និង ការពារ សិទ្ធិ ពលរដ្ឋ (ACNCIPO) មានប្រសាសន៍ ថា កាលពី ថ្ងៃទី ១០ ខែវិច្ឆិកា ការបោះ បង្គោល ព្រំដែន នៅ តំបន់ ការពារ និង អភិរក្ស គឺជា វិធី ដ៏ ល្អ មួយ ក្នុង ការការពារ ដី រដ្ឋ ។ ទោះជា យ៉ាងណា លោក ថា ការកាប់ រាន និង ទន្ទ្រាន យក ដី ព្រៃ របស់ រដ្ឋ បាន ផ្ទុះឡើង ហើយ មិន មាន មន្ត្រី អនុ រក្ស គ្រប់គ្រាន់ ដើម្បី ទប់ស្កាត់ ។
បច្ចុប្បន្ន ដី រដ្ឋ នៅ តំបន់ ការពារ ព្រៃឡង់ និង ឧទ្យាន ជាតិ នៅតែ ត្រូវបាន ទន្ទ្រាន យក បើ ទោះជា រដ្ឋាភិបាល បាន បញ្ជា ឱ្យ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ទប់ស្កាត់ ក៏ដោយ ។ ការទន្ទ្រាន ហាក់ កំពុង កើតឡើង ជាថ្មី ទៀត ព្រោះ ការអនុវត្ត ច្បាប់ ក្នុង មូលដ្ឋាន មិន មាន ប្រសិទ្ធភាព ។
យោង តាម របាយការណ៍ របស់ ក្រសួង បរិស្ថាន រដ្ឋាភិបាល បាន អនុវត្ត ផែនការ យុទ្ធសាស្រ្ត ជាតិ សម្រាប់ ការគ្រប់គ្រង តំបន់ ការពារ ឆ្នាំ ២០១៧ - ២០៣១ ។ ផែនការ នេះ ត្រូវបាន គេ រំពឹង ថា នឹង រួមចំណែក យ៉ាង សំខាន់ ដល់ កំណើន សេដ្ឋកិច្ច ជាតិ និង ការអភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព រួមទាំង ការកាត់បន្ថយ ភាពក្រីក្រ ជាពិសេស តាមរយៈ ការអភិរក្ស និង ការប្រើប្រាស់ ប្រកបដោយ និរន្តរភាព នៃ ជីវ ចម្រុះ ធនធាន ធម្មជាតិ និង ធនធាន វប្បធម៌ ធម្មជាតិ និង សេវា ប្រព័ន្ធ អេកូឡូស៊ី ។
តំបន់ ការពារ ចំនួន ៦៨ រួម មាន ឧទ្យាន ជាតិ ចំនួន ១១ ដែន ជម្រក សត្វ ព្រៃ ចំនួន ១៩ តំបន់ ការពារ ទេសភាព ចំនួន ១៣ តំបន់ ប្រើប្រាស់ ច្រើន ចំនួន ៨ តំបន់ រ៉ាម សារ ( តំបន់ ដី សើម ) តំបន់ បេតិកភណ្ឌ ធម្មជាតិ ឧទ្យាន ជាតិ សមុទ្រ និង តំបន់ ច្រក របៀង អភិរក្ស ចម្រុះ មួយ ។
គូស្នេហ៍ ជាច្រើន នៅ កម្ពុជា កំពុង ផ្អាក ពិធី មង្គលការ ដោយសារ ជំងឺ កូវីដ - ១៩ ខណៈ ខ្លះ ទៀត កំពុង ស្វែងរក ជម្រើស ផ្សេង ទៀត ។
ឪពុក ម្តាយ និង គូស្នេហ៍ មួយចំនួន មិន ប្រាថ្នា ពន្យារ ពេល បាន សម្រេចចិត្ត ប្តូរ ពី ពិធី មង្គលការ តាម ប្រពៃណី ទៅ ពិធី មង្គលការ តូច ជាង នៅមុខ អាសនៈ គ្រួសារ ដែល ជា កន្លែង គូស្នេហ៍ សុំ ការយល់ព្រម ពី បុព្វបុរស នៃ គ្រួសារ ទាំង ពីរ ។
លោក សាខុន បាន សរសេរ ក្នុង ហ្វេសប៊ុក ថា ពួកយើង ក្នុង នាម ជា ឪពុក ម្តាយ សូម ជម្រាប ជូន ភ្ញៀវ កិត្តិយស ថា ពិធី មង្គលការ របស់ កូន ៗ របស់ យើង ដែល គ្រោង នឹង ធ្វើឡើង នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា នៅ មជ្ឈមណ្ឌល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ នឹង ត្រូវ ពន្យារ ពេល ។
អ្នក ផ្សេង ទៀត បាន ចូល ទៅក្នុង ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ជាមួយនឹង ការប្រកាស ស្រដៀង គ្នា ។ អ្នកស្រី Van Kimmuy រស់ នៅ ខេត្ត ពោធិ៍សាត់ បាន បង្ហោះ នៅលើ គណនី ហ្វេសប៊ុក របស់ ខ្លួន អំពី ការពន្យារ ពេល ពិធី មង្គលការ របស់ នាង ដែល គ្រោង ធ្វើឡើង នៅ ថ្ងៃទី ២១ ខែវិច្ឆិកា ។
លោក កុយ ពិសី រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង ជា អនុប្រធាន គណៈកម្មាធិការ កិច្ចការ ព្រំដែន កម្ពុជា បាន ពន្យារ ពេល ពិធី មង្គលការ របស់ នាង នៅ ខែមីនា ។ នាង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ថា ដើម្បី ជួយ ទប់ស្កាត់ ការរីករាលដាល នៃ Covid-19 អាពាហ៍ពិពាហ៍ ដែល នាង ថា ជា រឿង ផ្ទាល់ខ្លួន គួរតែ រង់ចាំ ។
នាង បាន និយាយ ថា ដើម្បី សុវត្ថិភាព សាធារណៈ នៅក្នុង ប្រទេស របស់ យើង និង ដើម្បី ការពារ ការរីករាលដាល នៃ Covid-19 ក្រុមគ្រួសារ របស់ យើង បាន សម្រេចចិត្ត ផ្អាក ការប្រារព្ធ ពិធី អាពាហ៍ពិពាហ៍ ។
ពិសី បាន និយាយ ថា ការជួបជុំ ធំ ៗ ដូចជា អាពាហ៍ពិពាហ៍ ខួបកំណើត និង ពិធី ឡើង គេហដ្ឋាន គួរតែ ត្រូវបាន លុបចោល ឬ ពន្យារ ពេល ឬ កាត់បន្ថយ មក ត្រឹម កម្រិត គ្រួសារ តូច ជាង នេះ ។
លោក សេង ថា វរៈ រស់ នៅ សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ខណ្ឌ ឬស្សីកែវ រាជធានី ភ្នំពេញ កំពុង ជំរុញ ពិធី មង្គលការ របស់ លោក នៅ ថ្ងៃទី ១៦ ខែវិច្ឆិកា ។ លោក បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា លោក បាន ពន្យារ ពេល ម្តង រួច មកហើយ កាលពី ខែឧសភា ។
លោក បាន បន្ត ថា៖ យើង នឹង គោរព តាម ច្បាប់ របស់ ក្រសួង សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ដោយ ប្តូរ ពិធី មង្គលការ ទៅជា ពិធី សូត្រ មន្ត តូច តាម ប្រពៃណី ខ្មែរ ។
កាលពី ថ្ងៃទី ១០ ខែវិច្ឆិកា ក្រសួង សុខាភិបាល បាន អំពាវនាវ ជាថ្មី ដល់ សាធារណជន រក្សា គម្លាត សង្គម ដើម្បី ការពារ ការឆ្លង ពី សហគមន៍ ។
គោលការណ៍ ណែនាំ ថ្មី នេះ ណែនាំ ប្រជាជន ឱ្យ ជៀសវាង ការជួបជុំគ្នា ក្នុង សង្គម ដូចជា ពិធី មង្គលការ ពិធី ជាតិ ពិធី ប្រពៃណី ការសម្តែង តន្ត្រី ការធ្វើដំណើរ ការទទួលទាន អាហារ ក្រៅ និង ពិធី ខួបកំណើត ធំ ៗ ។
មន្ត្រី សាលា សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ ចំនួន ៤០ នាក់ រួមទាំង សមាជិក ក្រុមប្រឹក្សា សង្កាត់ និង មេភូមិ បាន និយាយ ថា ពួកគាត់ គ្រោង នឹង ដាក់ ញត្តិ ជូន អភិបាល ខណ្ឌ លោក ហែម ដារិទ្ធ ស្នើសុំ ដក តំណែង មេឃុំ កង វង្ស ចេញ ពី តំណែង ។ ភាព មិន ប្រក្រតី នៃ ការដឹកនាំ របស់ គាត់ ។
យោង តាម ញត្តិ ចុះ ថ្ងៃទី ៦ ខែវិច្ឆិកា បាន ឲ្យដឹង ថា លោក វង្ស អតីត សមាជិក នៃ គណបក្ស សង្គ្រោះ ជាតិ ដែល រំលាយ ដោយ តុលាការ កំពូល ខ្វះ ជំនាញ ដឹកនាំ ប្រព្រឹត្ត អសីលធម៌ ពុករលួយ និង មើលងាយ មន្ត្រី ក្រោម ឱវាទ ។
ញត្តិ លើកឡើង ពី ការ មិន ទុកចិត្ត ពី មន្ត្រី ទាំងអស់ ក្នុង ឃុំ សង្កាត់ ដែល ត្រូវបាន បន្ទោស ផងដែរ ចំពោះ ការយឺតយ៉ាវ ក្នុង គម្រោង សាធារណៈ ។
មេឃុំ ឃោរឃៅ រូប នេះ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា លោក បាន ប្រឹងប្រែង បម្រើ ប្រជាពលរដ្ឋ ក្នុង ឃុំ ប៉ុន្តែ ការចោទប្រកាន់ បែប នេះ ជា រឿង ធម្មតា ។ លោក ថា វា តែងតែ កើតឡើង រវាង អ្នកគ្រប់គ្រង និង អ្នកក្រោម បង្គាប់ ហើយ បាន ច្រានចោល វា ជា វិវាទ ការងារ ។
ខ្ញុំ បាន ចំណាយ ពេល ជាមួយ មនុស្ស ។ ខ្ញុំ មិន ដែល មាន ពេល ទំនេរ ទេ ព្រោះ ក្នុង នាម ជា មេឃុំ ខ្ញុំ មាន តួនាទី បំពេញ តម្រូវការ របស់ ប្រជាពលរដ្ឋ ។ ខ្ញុំ មិន ស្រឡាញ់ អំណាច ទេ ។ ខ្ញុំ មិន ដែល ធ្វេសប្រហែសភារកិច្ច របស់ ខ្ញុំ ទេ ។ ចំពោះ ប្រាក់ រង្វាន់ ដែល ប្រគល់ ជូន មន្ត្រី ក្រោម ឱវាទ គឺ ខ្ញុំ បែងចែក ទៅតាម ឋានៈ និង មុខ តំណែង ហើយ ប្រសិនបើ មន្ត្រី ក្រោម ឱវាទ ណា មិន ធ្វើ ការ គឺ មិន ទទួលបាន ប្រាក់ រង្វាន់ ទេ ។
" ខ្ញុំ ជឿ ថា អ្នកគ្រប់គ្រង នឹង ធ្វើ ការសម្រេចចិត្ត ត្រឹមត្រូវ ហើយ ខ្ញុំ មិន មាន ការសោកស្តាយ ចំពោះ ការធ្វើជា ផ្នែក នៃ សេវាកម្ម សង្គម នោះ ទេ ។
លោក វង្ស បាន កាន់ តំណែង ជា មេឃុំ កាលពី ឆ្នាំ ២០១៧ ខណៈ លោក នៅ ជា សមាជិក គណបក្ស សង្គ្រោះ ជាតិ ។ គណបក្ស ប្រឆាំង ត្រូវបាន ហាមប្រាម នៅ ឆ្នាំ នោះ ហើយ ពេល កាន់ តំណែង លោក វង្ស បាន ប្តូរ ភក្តីភាព ទៅ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក ស៊ូ សារ៉ាត់ សមាជិក ក្រុមប្រឹក្សា ឃុំ ដែល បច្ចុប្បន្ន កំពុង សម្រាក ពី ការងារ ដោយសារ បញ្ហា សុខភាព និង បាន ផ្តិត មេដៃ ញត្តិ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃទី ១២ ខែវិច្ឆិកា ថា ញ ត្តិ ត្រូវបាន ដាក់ ជូន គណៈប្រតិភូ គណបក្ស ប្រជាជន កម្ពុជា ប្រចាំ មណ្ឌល កាលពី ថ្ងៃទី ១០ ខែវិច្ឆិកា ។
ជំហាន ដំបូង របស់ យើង គឺ សុំ គណៈកម្មាធិការ គណបក្ស ស្រុក ដើម្បី ដោះស្រាយ បញ្ហា នេះ ហើយ ជំនួស លោក វង្ស ។ ប្រសិនបើ មិន មាន វិធានការ ទេ យើង នឹង បន្ត ដាក់ ញត្តិ តាម មធ្យោបាយ ផ្សេង ទៀត រហូតដល់ យើង អាច ជំនួស គាត់ ។
លោក ប៉ា ចាន់ រឿន ប្រធាន អង្គការ វិទ្យាស្ថាន កម្ពុជា ដើម្បី ប្រជាធិបតេយ្យ បាន ថ្លែង ថា តាម គោលការណ៍ រដ្ឋបាល មន្ត្រី ក្រោម ឱវាទ មាន សិទ្ធិ ស្នើសុំ ផ្លាស់ប្តូរ មេដឹកនាំ តាមរយៈ ក្រសួង មហាផ្ទៃ ។
ក្នុង បញ្ជី នោះ រួម មាន មន្ទីរ អប់រំ ខេត្ត ចំនួន ២ ក្លឹប ការ៉ាតេ មួយ សាលា រដ្ឋ ចំនួន ៦ និង សាលា ឯកជន ចំនួន ១០ ។
អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល លោក រស់ សុវិជ្ជា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃទី ១១ ខែវិច្ឆិកា ថា អង្គភាព នានា កំពុង អនុវត្ត វិធានការ កំណត់ ពី ក្រសួង សុខាភិបាល ។
យើង បាន ផ្អាក ថ្នាក់រៀន ជា បណ្ដោះអាសន្ន រយៈពេល ពីរ សប្តាហ៍ ហើយ បាន បន្ត ការសិក្សា តាម ប្រព័ន្ធ អនឡាញ ក្នុង រាជធានី ភ្នំពេញ ខេត្ត កណ្តាល និង តំបន់ ផ្សេង ៗ ទៀត ។ ក្រសួង បាន ផ្អាក ប្រតិបត្តិការ នៅ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ជា បណ្ដោះអាសន្ន រហូតដល់ មាន ការជូនដំណឹង បន្ថែម ។
លោក ថា ក្លឹប បណ្តុះបណ្តាល ការ៉ាតេ មាន គ្រូបង្វឹក ម្នាក់ ដើរតួ ជា អង្គរក្ស ចំណែក មន្ទីរ អប់រំ ខេត្ត ចំនួន ពីរ មាន បុគ្គលិក ដែល ចូលរួម ជាមួយ អ្នកដទៃ ក្នុង អំឡុង ពេលព្រឹត្តិការណ៍ នេះ ។
លោក សុវិជ្ជា មានប្រសាសន៍ ថា អ្នក ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ នូវ វិធានការ សុខភាព និង សុវត្ថិភាព ដែល ដាក់ចេញ ដោយ ក្រសួង សុខាភិបាល ។
ក្រសួង សុខាភិបាល បាន រកឃើញ ថា មនុស្ស ប្រហែល ៩០០ នាក់ មាន ទំនាក់ទំនង ផ្ទាល់ ឬ ប្រយោល ជាមួយ គណៈប្រតិភូ ហុង គ្រី ។
នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន ក្រសួង បាន និយាយ ថា ស្ត្រី រូប នេះ បាន មកដល់ ប្រទេស កម្ពុជា នៅ ថ្ងៃទី 4 ខែវិច្ឆិកា ។ នាង បាន ធ្វើតេស្ត វិជ្ជមាន លើ ការធ្វើតេស្ត លើក ទី ពីរ នៅ ថ្ងៃទី 7 នៃ ការដាក់ ឱ្យ នៅ ដាច់ ពី គេ ហើយ ឥឡូវនេះ កំពុង ទទួល ការព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
ករណី ចុងក្រោយ នេះ នាំឱ្យ ចំនួន អ្នក ឆ្លង កូវីដ - ១៩ សរុប កើន ដល់ ៣០១ នាក់ គិត ត្រឹម ថ្ងៃទី ១១ ខែវិច្ឆិកា ដោយ នៅសល់ ១៣ នាក់ ទៀត កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ។
រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល លោក ម៉ម ប៊ុន ហេង បាន អំពាវនាវ ជាថ្មី ឲ្យ ប្រជាពលរដ្ឋ រក្សា គម្លាត សង្គម ។
កាលពី ថ្ងៃទី ១១ ខែវិច្ឆិកា លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន បញ្ជា ឱ្យ ក្រសួង បញ្ចេញ ម៉ាស់ ចំនួន ២លាន សម្រាប់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដើម្បី ចែកជូន ប្រជាពលរដ្ឋ ក្រីក្រ នៅ តាម សហគមន៍ ក្រីក្រ ក្នុង រាជធានី ។
រដ្ឋបាល ខេត្ត កណ្តាល បាន ប្រកាស នៅ ថ្ងៃ ដដែល នេះ ឱ្យ មន្ត្រីរាជការ ដែល បម្រើ ការងារ នៅ សាលា ខេត្ត មក ធ្វើតេស្ត រក មេរោគ កូវីដ - ១៩ ដោយ ឥត គិត ថ្លៃ នៅ មន្ទីរពេទ្យ បង្អែក ជ័យ ជំនៈ ក្រុង តាខ្មៅ ដើម្បី ជួយ ទប់ស្កាត់ និង បញ្ចៀស នូវ ហានិភ័យ ដែល មិន អាច ទាយ ទុក ជាមុន បាន នៃ ការរីករាលដាល ជំងឺ ដ៏ កាច សាហាវ នៅក្នុង សហគមន៍ ។
