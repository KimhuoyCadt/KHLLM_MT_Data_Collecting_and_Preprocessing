ការសិក្សា ដែល ធ្វើឡើង ដោយ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី (ADB) បាន ផ្តល់ អនុសាសន៍ ថា កម្ពុជា បង្កើត ផែនទី បំលាស់ ប្តូរ ឧស្សាហកម្ម ក្នុង វិស័យ សំខាន់ ៗ ដើម្បី អនុញ្ញាតឱ្យ មាន ការផ្លាស់ប្តូរ នៅក្រោម បដិវត្តន៍ ឧស្សាហកម្ម ទី បួន (4IR) ។ នេះ គួរតែ ត្រូវបាន អម ដោយ ការវិនិយោគ គ្រប់គ្រាន់ ក្នុង ការអភិវឌ្ឍ ជំនាញ សម្រាប់ ការងារ ថ្មី និង ផ្លាស់ប្តូរ ទីតាំង ។
របាយការណ៍ មួយ ដែល មាន ចំណងជើង ថា ការទាញយក អត្ថប្រយោជន៍ នៃ ឧស្សាហកម្ម 4.0 តាមរយៈ ការអភិវឌ្ឍន៍ ជំនាញ នៅ កម្ពុជា ត្រូវបាន ចេញផ្សាយ នៅ ថ្ងៃទី 20 ខែមករា ហើយ បាន ពិនិត្យ លើ ឧស្សាហកម្ម កាត់ដេរ និង ទេសចរណ៍ ក្នុង ស្រុក ដែល ជា ឧស្សាហកម្ម កំពូល ពីរ ទាក់ទង នឹង ការងារ ជាតិ វា ជា កត្តា ជំរុញ ដ៏ សំខាន់ សម្រាប់ កំណើន និង ការប្រកួតប្រជែង អន្តរជាតិ ។
បច្ចេកវិទ្យា ថ្មី ដែល ទាក់ទង នឹង 4IR នឹង លុបបំបាត់ ការងារ មួយចំនួន នៅក្នុង ឧស្សាហកម្ម ទាំង នេះ ប៉ុន្តែ ការខាតបង់ អាច ត្រូវបាន ទូទាត់ ដោយ តម្រូវការ ខ្ពស់ ដែល បង្កើតឡើង ដោយ ការកើនឡើង ផលិតភាព ដែល អាច បង្កើត ប្រាក់ ចំណូល សុទ្ធ ចំនួន 39 ភាគរយ នៅក្នុង ឧស្សាហកម្ម កាត់ដេរ និង 2 ភាគរយ នៅក្នុង វិស័យ ទេសចរណ៍ ។ របាយការណ៍ បាន អះអាង ។
ការសិក្សា នេះ ព្រមាន ថា មិន មាន ការធានា ថា កម្មករ និយោជិត ដែល ផ្លាស់ ទីលំនៅ នឹង ចាំបាច់ ផ្លាស់ទី ទៅក្នុង ការងារ ដែល ទើប បង្កើត ថ្មី ដោយ គ្មាន ការវិនិយោគ គ្រប់គ្រាន់ និង ទាន់ ពេលវេលា ក្នុង ការអភិវឌ្ឍន៍ ជំនាញ នោះ ទេ ទោះបីជា មាន ការរំពឹងទុក ជា វិជ្ជមាន ជា រួម សម្រាប់ ការងារ សុទ្ធ ក៏ដោយ ។
ការផ្លាស់ប្តូរ ការងារ ក៏ ទំនងជា ប៉ះពាល់ ដល់ ស្ត្រី ដែល មាន ចំនួន ជិត ៨១ ភាគរយ នៃ កម្មករ រោងចក្រ កាត់ដេរ នៅ កម្ពុជា ។
" យើង ត្រូវតែ ធ្វើឱ្យ ប្រសើរឡើង នូវ ចំណេះដឹង នៃ បច្ចេកវិទ្យា 4IR និង អត្ថប្រយោជន៍ របស់ ពួកគេ គាំទ្រ ដល់ អាជីវកម្ម រួមទាំង សហគ្រាស ធុន តូច និង មធ្យម ដើម្បី ទទួលយក បច្ចេកវិទ្យា ទំនើប និង ផ្តល់ ការគាំទ្រ សម្រាប់ កម្មវិធី បណ្តុះបណ្តាល និង ជំនាញ ឡើងវិញ តាមរយៈ មធ្យោបាយ រួមទាំង ការលើកទឹកចិត្ត ផ្នែក ពន្ធ ដើម្បី ធានា ថា គ្មាន នរណា ម្នាក់ ត្រូវបាន ទុកចោល នោះ ទេ " ។ .
កម្ពុជា គួរ ដាក់ចេញ នូវ វិធីសាស្រ្ត ថ្មី ៗ ដើម្បី ពង្រឹង ការដាក់បញ្ចូល និង ការការពារ សង្គម សម្រាប់ កម្មករ និយោជិត កម្រិត ចូល អ្នក ដែល ប្រឈម នឹង ហានិភ័យ នៃ ការផ្លាស់ ទីលំនៅ និង អ្នក ដែល ត្រូវការ ការបណ្តុះបណ្តាល ជំនាញ កម្រិត ខ្ពស់ ។ របាយការណ៍ បាន និយាយ ថា មាន តម្រូវការ ក្នុង ការអភិវឌ្ឍ កម្មវិធី អប់រំ និង បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ ជាមួយនឹង លិខិត សម្គាល់ 4IR ដែល ខិតខំ ប្រឹងប្រែង នៅក្នុង ឧស្សាហកម្ម សំខាន់ ៗ ។
" ឥឡូវ នេះ គឺជា ពេលវេលា ដើម្បី គិត ឡើងវិញ នូវ ការផ្តល់ ជំនាញ ដោយ ប្រើប្រាស់ វេទិកា និម្មិត និង បច្ចេកវិទ្យា ទូរស័ព្ទ ហើយ អភិវឌ្ឍ ស្ថាប័ន បណ្តុះបណ្តាលរហ័ស រហួន ជាមួយនឹង វគ្គ សិក្សា និង លិខិត សម្គាល់ ដែល ត្រូវ នឹង តម្រូវការ ទីផ្សារ ។
លោក អ៊ុំ សុថា អ្នកនាំពាក្យ ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ បាន និយាយ នៅ ថ្ងៃទី ២០ ខែមករា ថា កម្ពុជា កំពុង អនុវត្ត គោល នយោបាយ អភិវឌ្ឍន៍ វិស័យ ឧស្សាហកម្ម សម្រាប់ ឆ្នាំ ២០១៥ - ២០២៥ រួម ជាមួយនឹង យន្តការគាំទ្រ បន្ថែម ដើម្បី សម្រប ខ្លួន ទៅនឹង 4IR ។ ប៉ុន្តែ ប្រទេស នេះ ប្រឈមមុខ នឹង បញ្ហា ដោយសារតែ មាន ធនធាន មនុស្ស នៅ មាន កម្រិត ក្នុង វិស័យ STEM ។
លោក បន្ត ថា៖ ដើម្បី ដោះស្រាយ បញ្ហា នេះ ក្រសួង កំពុង កៀរគរ អ្នកជំនាញ ផ្នែក វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ និង ចង ក្រង បញ្ជី ឈ្មោះ ។
លោក បាន បន្ថែម ថា ទោះបីជា ក្រសួង របស់ លោក មាន ភារកិច្ច ជួយ សម្រួល ដល់ ការផ្លាស់ប្តូរ 4IR ក៏ដោយ វា នឹង ជា ការខិតខំ ប្រឹងប្រែង រួមគ្នា ព្រោះ ការផ្លាស់ប្តូរ នឹង ប៉ះពាល់ ដល់ គ្រប់ វិស័យ នៃ សេដ្ឋកិច្ច ។
ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២០ ខែមករា នេះ បាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ - ១៩ ថ្មី ចំនួន ៧នាក់ ទៀត លើ ពលករ ចំណាកស្រុក ដែល ទើប ត្រឡប់ មកពី ប្រទេស ថៃ ។
នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន ក្រសួង បាន និយាយ ថា ជន ចំណាកស្រុក ចំនួន ប្រាំ នាក់ បាន ត្រឡប់ មកវិញ នៅ ថ្ងៃទី 17 ខែមករា និង ពីរ នាក់ ទៀត នៅ ថ្ងៃទី 6 ខែមករា ។
អ្នក ទាំង ពីរ ត្រូវបាន ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក ក្នុង ខេត្ត បន្ទាយមានជ័យ មុនពេល ការធ្វើតេស្ត លើក ទី ពីរ របស់ ពួកគេ ដែល គ្រប់គ្រង ដោយ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា (IPC) ត្រឡប់ មក ជា វិជ្ជមាន វិញ ។ ពួកគេ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ។
