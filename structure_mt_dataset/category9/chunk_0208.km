លោក បន្ត ថា៖ ជំនាញ កសិកម្ម បច្ចុប្បន្ន មាន តែ នៅ ថ្នាក់ ខេត្ត និង ស្រុក ប៉ុណ្ណោះ ហើយ មិន ផ្ទាល់ តាម ឃុំ សង្កាត់ ទេ ។
លោក សាំង កុមារ បាន មានប្រសាសន៍ ថា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នឹង រៀបចំ ឲ្យ មន្ត្រី កសិកម្ម ជាពិសេស និស្សិត កសិកម្ម ដែល ទើបតែ បញ្ចប់ ការសិក្សា មក ធ្វើ ការ ផ្ទាល់ ជាមួយ កសិករ នៅ គ្រប់ ឃុំ សង្កាត់ ដើម្បីឲ្យ ពួកគេ អាច លើកកម្ពស់ ជីវភាព រស់ នៅ បាន ។
លោក បាន កត់សម្គាល់ ថា ដោយសារ ប្រទេស កម្ពុជា ជា ប្រទេស កសិកម្ម ប្រពៃណី កង្វះ អ្នកជំនាញ កសិកម្ម នៅ ថ្នាក់ មូលដ្ឋាន គឺជា បញ្ហា ប្រឈម មួយ ដោយ លោក បាន កត់សម្គាល់ ថា ចាំបាច់ ត្រូវ មាន អ្នកជំនាញ យ៉ាងហោចណាស់ ម្នាក់ នៅក្នុង ឃុំ នីមួយ ៗ ដើម្បី ជួយ កសិករ ។
អ្នកជំនាញ កសិកម្ម ត្រូវបាន តម្រូវ ឱ្យ គាំទ្រ សហគមន៍ ជនបទ ក្នុង ការទទួលយក វិធីសាស្រ្ត ចុងក្រោយ បំផុត ដើម្បី ក្លាយជា កសិករ ទំនើប ដែល មាន សមត្ថភាព ផលិត និង ស្វែងរក ទីផ្សារ ។
លោក បាន បន្ថែម ថា រដ្ឋាភិបាល ដាក់ចេញ នូវ គោល នយោបាយ បែប នេះ នឹង កាត់បន្ថយ ការចំណាយ របស់ វិស័យ ឯកជន លើ ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស ។
លោក សារ៉ាន់ បាន មានប្រសាសន៍ ថា កង្វះ អ្នកជំនាញ កសិកម្ម ជា បញ្ហា ប្រឈម ដូច្នេះ វា ជា ការ ល្អ ប្រសិនបើ រដ្ឋាភិបាល ដោះស្រាយ បញ្ហា នេះ ។
លោក គិន ភា នាយក វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ដែល បាន ឃើញ គោល នយោបាយ ពេញលេញ បាន និយាយ ថា យុទ្ធសាស្ត្រ របស់ CPP រួម មាន ការធ្វើ ពិពិធកម្ម ផលិតផល នាំចេញ ដោយ ឥឡូវនេះ ផ្តោត លើ វិស័យ កសិកម្ម បន្ថែម លើ វិស័យ កាត់ដេរ ។
ប្រសិនបើ យើង អាច បង្កើន ការនាំចេញ វិស័យ កសិកម្ម ដូចជា CPP បាន ដាក់ចេញ ជាមួយ ការពង្រីក អាជីវកម្ម កសិផល ខ្ញុំ គិត ថា វា តំណាង ឱ្យ ការរីកចម្រើន ដ៏ ល្អ ។
លោក បាន មានប្រសាសន៍ ថា ប្រសិនបើ គោល នយោបាយ នេះ ត្រូវបាន អនុវត្ត ដោយ ជោគជ័យ វា នឹង ក្លាយជា ឆ្អឹង ខ្នង សេដ្ឋកិច្ច សម្រាប់ ប្រទេស កម្ពុជា និង លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាជន យើង ជាពិសេស កសិករ ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន អំពាវនាវ ឲ្យ សមាជិក ជន បរទេស កម្ពុជា ដែល និរទេស ខ្លួន ទៅ ទស្សនា ព្រះរាជាណាចក្រ កម្ពុជា និង ធ្វើជា សាក្សី ក្នុង ការអភិវឌ្ឍន៍ របស់ ខ្លួន ដោយ លោក បាន រំលឹក ឡើងវិញ ថា គោល នយោបាយ របស់ លោក គឺជា ការផ្សះផ្សា ជាតិ ដោយ ផលប្រយោជន៍ ជាតិ ជា ចម្បង ។
លោក ថា កាល ដែល ពួកគេ បាន គាំទ្រ ក្រុម ប្រឆាំង មិន ត្រូវ ចាញ់បោក អ្នក ដែល និយាយ អាក្រក់ អំពី ប្រទេស កម្ពុជា ឡើយ ។
ថ្លែង ទៅកាន់ សិស្សានុសិស្ស និទ្ទេស A ជាង ១ ពាន់ នាក់ កាលពី ថ្ងៃទី២ ខែកុម្ភៈ លោក ហ៊ុន សែន មានប្រសាសន៍ ថា លោក ភ្ញាក់ផ្អើល ពេល ឮ ថា ពលរដ្ឋ ខ្មែរ ខ្លះ ដែល រស់ នៅ បរទេស និយាយ ថា ពួកគេ ខ្លាច វិល មក កម្ពុជា ដូច កាលពី អតីតកាល គាំទ្រ គណបក្ស ប្រឆាំង និង រិះគន់ រដ្ឋាភិបាល ។
ខ្ញុំ សូម យក ឱកាស នេះ និយាយ ថា កម្ពុជា ជា ប្រទេស សម្រាប់ យើង ទាំងអស់ គ្នា ។ ប្រសិនបើ អ្នក មិន ស្ថិត ក្រោម ដីកា ចាប់ខ្លួន ដែល ចេញ ដោយ តុលាការ ឬ មិន ត្រូវបាន តាម ចាប់ខ្លួន ពី អាជ្ញាធរ ទេ អ្នក អាច ត្រឡប់មក កម្ពុជា វិញ ទោះបីជា អ្នក ធ្លាប់ បាន ប្រមាថ រដ្ឋាភិបាល កាលពី អតីតកាល ក៏ដោយ ។
ជន រួម ជាតិ របស់ យើង មួយចំនួន ដែល រស់ នៅ ក្រៅ ប្រទេស បាន និយាយ ថា ពួកគេ មិន អាច ត្រឡប់ មកវិញ បាន ទេ ដោយសារ ពួកគេ ធ្លាប់ គាំទ្រ ក្រុម ប្រឆាំង ពីមុន ។ សូម កុំ យល់ច្រលំ លើ បញ្ហា នេះ អ្នក អាច ត្រលប់មក ផ្ទះ វិញ បាន លោក បាន និយាយ ដោយ យោង ជាក់ស្តែង ចំពោះ គណបក្ស សង្គ្រោះ ជាតិ ដែល ត្រូវបាន រំលាយ ដោយ តុលាការ កំពូល ។
នាយក រដ្ឋមន្ត្រី បាន មានប្រសាសន៍ ថា អ្នកណា ដែល មាន ជំនឿ ខុស ថា កម្ពុជា បាន " លក់ " ដី របស់ ខ្លួន ទៅ ឱ្យ ប្រទេស ជិតខាង គួរតែ មក ទស្សនា ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក ហ៊ុន សែន បញ្ជាក់ ថា អ្នកណា ដែល ប្រកាន់ខ្ជាប់ នូវ ទង្វើ ជ្រុលនិយម ដែល អាច ឈានដល់ ការបែកបាក់ និង ការបំផ្លាញ ជាតិ មិន អាច លើកលែង ទោស បាន ទេ អ្នក ដែល ប្រមាថ រដ្ឋាភិបាល អាច ត្រូវបាន លើកលែង ទោស ។ លោក ថា លោក និង គណបក្ស ប្រជាជន កម្ពុជា ដែល កំពុង កាន់អំណាច នឹង មិន ចាត់ទុក ពួកគេ ជា សត្រូវ អស់ មួយ ជីវិត ឡើយ ។
លោក បាន មានប្រសាសន៍ ថា សូម្បីតែ ខ្មែរ ក្រហម ដែល បាន ប្រយុទ្ធ ជាមួយ យើង លើ បញ្ហា ជីវិត និង ការស្លាប់ ក៏ យើង អាច ធ្វើការ ជាមួយគ្នា បាន ដែរ ព្រោះ យើង កំពុង ដើរ លើ មាគ៌ា នៃ នយោបាយ ផ្សះផ្សា ជាតិ ។
ប្រធាន វិទ្យាស្ថាន កម្ពុជា ដើម្បី ប្រជាធិបតេយ្យ លោក ប៉ា ចាន់ រឿន មានប្រសាសន៍ ថា ខណៈពេល ដែល កម្ពុជា ទទួលបាន សន្តិភាព ក្រោយ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ឆ្នាំ ១៩៩១ ព្រះរាជាណាចក្រ នៅតែ ត្រូវការធ្វើ ការផ្សះផ្សា ក្នុង សង្គម ព្រោះ ស្លាកស្នាម ពី សម័យ នោះ មិន ទាន់ បាន ជាសះស្បើយ ពេញលេញ នៅឡើយ ។
លោក ថា ការបែកបាក់ កាន់តែ ធំ ក៏ កើត ចេញពី ការរំលាយ អតីត គណបក្ស សង្គ្រោះ ជាតិ ក្នុង ឆ្នាំ ២០១៧ ដែរ ។
ដើម្បី ធានា ការពារ ពង្រឹង និង ពង្រីក សន្តិភាព នៅ កម្ពុជា យើង ត្រូវ ប្រកាន់ខ្ជាប់ នូវ គោល នយោបាយ នៃ ការផ្សះផ្សា ជាតិ ដោយ ឈរ លើ គោលការណ៍ ប្រជាធិបតេយ្យ ពហុ បក្ស និង ការគោរព សិទ្ធិ មនុស្ស ។
លោក ចាន់ រឿន បាន ថ្លែង ថា៖ នេះ នឹង ពង្រឹង ការផ្សះផ្សា សន្តិភាព និង ការអភិវឌ្ឍ និង ការពារ រាល់ សមិទ្ធផល ដែល បាន ធ្វើ ។
ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ លោក ស ខេង បាន មានប្រសាសន៍ ថា ថ្នាក់ដឹកនាំ កម្ពុជា និង ថៃ តែងតែ មាន ទំនាក់ទំនង ល្អ ប្រពៃ ហើយ ព្រះរាជាណាចក្រ ទាំង ពីរ សហការ គ្នា យ៉ាង ជិតស្និទ្ធ លើ ផ្នែក នយោបាយ សន្តិសុខ និង ទំនាក់ទំនង ពាណិជ្ជកម្ម ។
នេះ បើ តាម ការបង្ហោះ តាម បណ្តាញ សង្គម របស់ លោក រដ្ឋមន្ត្រី ស ខេង ស្វាគមន៍ ការតែងតាំង បេសកជន ថ្មី ។
លោក បាន ថ្លែងអំណរគុណ ចំពោះ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ក៏ ដូចជា ក្នុង ក្របខ័ណ្ឌ អាស៊ាន ។
លោក ស ខេង បាន ប្រាប់ ឯក អគ្គ រដ្ឋទូត ថា លោក បាន ធ្វើជា សហ ប្រធាន ផ្ទាល់ ក្នុង ជំនួប រវាង រដ្ឋបាល នៃ ខេត្ត ទាំង ពីរ តាម បណ្តោយ ព្រំដែន រួម ។
កិច្ចប្រជុំ ដែល ដឹកនាំ ដោយ សមភាគី របស់ ខ្ញុំ គឺ រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ថៃ ធ្វើឡើង ក្នុង ស្មារតី ធ្វើ ការរួមគ្នា ដើម្បី រក្សា សន្តិសុខ តាម ព្រំដែន ។ យើង ក៏ បាន ពិភាក្សា យ៉ាង ទូលំទូលាយ អំពី ការអភិវឌ្ឍ រួម នៃ ខេត្ត ទាំង សងខាង នៃ ព្រំដែន ផងដែរ ។
ខ្ញុំ បាន ឃើញ ការអភិវឌ្ឍ យ៉ាង ច្រើន នៅ ទីនេះ ។ ខ្ញុំ ក៏ សូម អបអរសាទរ កម្ពុជា ចំពោះ តួនាទី ដ៏ ជោគជ័យ របស់ ខ្លួន ក្នុង នាម ជា ប្រធាន អាស៊ាន ក្នុង ឆ្នាំ ២០២២ ។
លោក បាន បន្ថែម ថា ខ្ញុំ ក៏ សូម អបអរសាទរ ដល់ ប្រទេស កម្ពុជា ចំពោះ ការដោះស្រាយ ជំងឺ រាតត្បាត Covid-19 ក៏ ដូចជា ការបើក ដំណើរការ ឡើងវិញ ជា បន្តបន្ទាប់ និង ការស្តារ សេដ្ឋកិច្ច សង្គម ឡើងវិញ ។
ក្នុង ជំនួប នោះ លោក ជឺ គាត បាន សរសើរ ការដឹកនាំ របស់ លោក ស ខេង ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ជាពិសេស ការក្លែងបន្លំ ទូរគមនាគមន៍ និង ការរត់ ពន្ធ ឆ្លង ដែន ។
ទាំង នេះ គឺជា បញ្ហា ដែល ត្រូវការ កិច្ចសហប្រតិបត្តិការ ក្នុង តំបន់ ដើម្បី ដោះស្រាយ ។ ប្រសិនបើ យើង ចង់ ឃើញ ការបញ្ចប់ ឧក្រិដ្ឋកម្ម ទាំង នេះ ភាគី ពាក់ព័ន្ធ នីមួយ ៗ ត្រូវតែ សហការ គ្នា ។
ពួកគេ បាន ផ្លាស់ប្តូរ យោបល់ លើ ការជួយ ដល់ ពលករ ចំណាកស្រុក ខ្មែរ នៅ ប្រទេស ថៃ និង បន្ត កិច្ចសហប្រតិបត្តិការ ជិតស្និទ្ធ ដើម្បី បង្ក្រាប ការជួញដូរ មនុស្ស ឆ្លង ដែន ។
សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ក្រើន រំលឹក ដល់ សាលារៀន ក្នុង ព្រះរាជាណាចក្រ កម្ពុជា អំពី ការបន្ត ទទួលខុសត្រូវ ក្នុង ការអនុវត្ត វិធានការ បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
លោក បាន ធ្វើ ការលើកឡើង នេះ ខណៈ ដែល លោក បាន ជួប ជាមួយ សិស្ស និទ្ទេស A ពី ការប្រឡង មធ្យមសិក្សា ទុតិយភូមិ កាលពី ឆ្នាំ មុន ។
ឆ្នាំ នេះ បញ្ហា Covid-19 បាន ធូរស្រាល ហើយ ដែល អនុញ្ញាតឲ្យ គ្រូបង្រៀន និង សិស្ស ត្រឡប់ ទៅ ថ្នាក់រៀន និង សាល បង្រៀន របស់ ពួកគេ ។ ខ្ញុំ ស្នើ ឱ្យ សិស្សានុសិស្ស និង បុគ្គលិក អប់រំ ទាំងអស់ បន្ត ធ្វើ អ្វី ៗ តាម តែ អំពើចិត្ត ដើម្បី ទប់ស្កាត់ ការចម្លង មេរោគ នៅ តាម សាលារៀន នានា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ ប្រសិនបើ ករណី គួរតែ លេចឡើង យើង នឹង ត្រូវ សហការ គ្នា ដើម្បី ទប់ស្កាត់ ការរីករាលដាល របស់ វា និង ការពារ គ្នា ទៅ វិញ ទៅមក ។
សម្ដេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ប្រាកដ ថា ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ មាន ភាពទាន់សម័យ ព្រោះ ជំងឺ កូវីដ - ១៩ នៅតែ រីករាលដាល ។
យើង មិន ត្រូវ ទុកឲ្យ អ្នកយាម របស់ យើង ចុះខ្សោយ ឡើយ ។ កាលពី មុន ដើម្បី ការពារ អាយុជីវិត របស់ សាធារណៈ ជន យើង ត្រូវបាន គេ បង្ខំឱ្យ បិទ សាលារៀន ដើម្បី ការពារ ការផ្ទុះឡើង ដ៏ ធំ ដែល អាច កើតមាន ។
វិធានការ បង្ការ នៅតែ មាន ។ ខ្ញុំ សង្ឃឹម ថា អ្នក ទាំងអស់ គ្នា គោរព តាម ពួកគេ ហើយ ធានា ថា សាលា នៅតែ ជា កន្លែង ដែល មាន ការចែករំលែក ចំណេះដឹង ជាជាង ជំងឺ ។
រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល លោក ឱ វណ្ណឌីន ដែល កាន់ តួនាទី ជា ប្រធាន គណៈកម្មាធិការ ជាតិ ទទួល ថ្នាំ បង្ការ ជំងឺ កូវីដ - ១០ មានប្រសាសន៍ ថា គ្មាន សមាជិក សាធារណៈ ណា ម្នាក់ មិន គួរ ពន្យារ ពេល ចាក់ ថ្នាំ បង្កើន កម្លាំង របស់ ពួកគេ នោះ ទេ ។
វ៉ាន់ ឌីន ណែនាំ ដល់ គណៈកម្មការ សាលា បន្ត លើកទឹកចិត្ត សិស្ស លោកគ្រូ អ្នកគ្រូ និង បុគ្គលិក ផ្សេង ទៀត ឱ្យ ទទួល ថ្នាំ បង្ការ Covid-19 ដោយ ស្នើ ឱ្យ ពួកគេ សម្របសម្រួល ជាមួយ ក្រុម គ្រូពេទ្យ ដើម្បី រៀបចំ ការចាក់ ថ្នាំ បង្ការ នៅ បរិវេណ សាលា ។
លោកស្រី ថា ក្រសួង បាន បង្កើត មជ្ឈមណ្ឌល ចាក់ ថ្នាំ បង្ការ ជំងឺ កូវីដ - ១៩ នៅ តាម គ្រឹះស្ថាន សុខាភិបាល សាធារណៈ ទូទាំង ប្រទេស ដើម្បី សម្រួល ដល់ ប្រជាពលរដ្ឋ ។
អ្នកស្រី បាន បន្ថែម ថា " ការចាក់ វ៉ាក់សាំង ក៏ មាន នៅ មន្ទីរពេទ្យ បង្អែក នីមួយ ៗ ដែរ ដូច្នេះ ប្រជាជន គួរតែ រក ឱ្យ ឃើញ វា ងាយស្រួល ក្នុង ការ រក្សា ការចាក់ វ៉ាក់សាំង របស់ ពួកគេ ឱ្យ ទាន់សម័យ " ។
គណៈកម្មការ សេដ្ឋកិច្ច ហិរញ្ញវត្ថុ ធនាគារ និង សវនកម្ម នៃ រដ្ឋសភា និង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន បើក កិច្ចប្រជុំ នៅ ថ្ងៃទី២ ខែកុម្ភៈ ដើម្បី ពិនិត្យ សេចក្តីព្រាង ច្បាប់ ស្តីពី ប្រព័ន្ធ ហិរញ្ញវត្ថុ សាធារណៈ មុនពេល សេចក្តីព្រាង ច្បាប់ នេះ បញ្ជូន ទៅ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា ពិនិត្យ ។ និង ការអនុម័ត ។
នៅ ពេល ដែល សេចក្តីព្រាង ច្បាប់ នេះ ត្រូវបាន អនុម័ត ដោយ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ នៃ រដ្ឋសភា នោះ នឹង ត្រូវ ពិភាក្សា និង អនុម័ត នៅក្នុង សម័យ ប្រជុំ ពេញ អង្គ រដ្ឋសភា ។
លោក ឈាង វុន ប្រធាន គណៈកម្មាធិការ សេដ្ឋកិច្ច នៃ សភា បាន មានប្រសាសន៍ ថា កិច្ចប្រជុំ នេះ ជា ឱកាស សម្រាប់ សមាជិក រដ្ឋសភា ដើម្បី ស្វែងរក ការបំភ្លឺ បន្ថែម លើ ចំណុច មួយចំនួន នៃ ច្បាប់ ដែល បាន ស្នើ ឡើង ។
រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ លោក អូន ព័ន្ធ មុនីរ័ត្ន មានប្រសាសន៍ ថា សេចក្តីព្រាង ច្បាប់ នេះ ត្រូវបាន រៀបចំឡើង ដើម្បី បង្កើត ក្របខ័ណ្ឌ ច្បាប់ ចាំបាច់ សម្រាប់ ការអនុវត្ត ប្រព័ន្ធ ថវិកា ផ្អែក លើ ការអនុវត្ត ឬ ហៅ ម្យ៉ាងទៀត ថា ការអនុវត្ត ថវិកា ដែល ជា គំរូ សមស្រប សម្រាប់ កម្ពុជា ។
លោក បាន បន្ថែម ថា " រដ្ឋាភិបាល បាន ប្រគល់ ឱ្យ ក្រសួង ហិរញ្ញវត្ថុ ដឹកនាំ ការតាក់តែង ច្បាប់ នេះ ក្នុង ឆ្នាំ 2010 ។ នេះ គឺជា ច្បាប់ មូលដ្ឋាន ដែល គ្របដណ្តប់ លើ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ និង ពង្រឹង ការអនុវត្ត ការអនុវត្ត ថវិកា " ។
នេះ គឺជា ជំហាន ដ៏ សំខាន់ មួយ ឆ្ពោះ ទៅរក ការកែលម្អ គណនេយ្យភាព ។ វា មាន គោលបំណង ធ្វើ ទំនើបកម្ម ប្រព័ន្ធ គ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ របស់ ប្រទេស កម្ពុជា ស្រប តាម កំណែទម្រង់ ដែល មាន ចែង ក្នុង យុទ្ធសាស្ត្រ កំណែទម្រង់ ប្រព័ន្ធ ថវិកា ( ២០១៨ - ២០២៥ ) របស់ រដ្ឋាភិបាល ។ វា ក៏ ស្រប តាម ការអនុវត្ត ល្អ បំផុត ជា អន្តរជាតិ ផងដែរ ។
បន្ទាប់ពី ពិភាក្សា រួច អង្គប្រជុំ បាន ឯកភាព លើ ខ្លឹមសារ រួម នៃ សេចក្តីព្រាង ច្បាប់ នេះ ។ នៅ ពេល ដែល ពាក្យ និង វេយ្យាករណ៍ ត្រូវបាន ផ្ទៀងផ្ទាត់ វា នឹង ត្រូវ បញ្ជូន ទៅ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ របស់ រដ្ឋសភា ។
អ្នកនាំពាក្យ រដ្ឋាភិបាល លោក ផៃ ស៊ីផាន មានប្រសាសន៍ ថា សេចក្តីព្រាង ច្បាប់ នេះ នឹង អនុញ្ញាតឱ្យ មាន ការអនុវត្ត ថវិកា អនុវត្ត ដែល ជា គំរូ សមស្រប សម្រាប់ កម្ពុជា ។
លោក បាន បន្ថែម ថា វា នឹង អនុញ្ញាតឱ្យ មាន ភាពជឿជាក់ លើ ថវិកា គណនេយ្យភាព ហិរញ្ញវត្ថុ តំណ ភ្ជាប់ គោល នយោបាយ - ថវិកា ច្បាស់លាស់ និង ការអនុវត្ត គណនេយ្យ ដែល ប្រសើរឡើង ។
លោក បាន សន្និដ្ឋាន ថា វា ក៏ នឹង ធានា បាន នូវ ប្រសិទ្ធភាព និង និរន្តរភាព នៃ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ខណៈពេល ដែល រក្សា បាន នូវ ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច កំណើន សេដ្ឋកិច្ច និង សមធម៌ សង្គម ។
រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ លោក ប្រាក់ សុខុន បាន ចាកចេញ ពី ប្រទេស កម្ពុជា នៅ ថ្ងៃទី២ ខែកុម្ភៈ ទៅកាន់ រដ្ឋធានីហ្សាកាតា ប្រទេស ឥណ្ឌូនេស៊ី ដើម្បី ចូលរួម កិច្ចប្រជុំ ក្រុមប្រឹក្សា សម្របសម្រួល អាស៊ាន លើក ទី ៣២ (ACC) និង រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន (AMM) Retreat នៅ ថ្ងៃទី ៣- ៤ ខែកុម្ភៈ ។
ក្រសួង ការបរទេស បាន ប្រកាស កាលពី ថ្ងៃទី 1 ខែកុម្ភៈ ថា កិច្ចប្រជុំ ACC លើក ទី 32 គឺ ផ្តោត ទៅ លើ ការតាមដាន " សេចក្តីថ្លែងការណ៍ របស់ មេដឹកនាំ អាស៊ាន ស្តីពី ការអនុវត្ត ប្រទេស ទីម័រ ខាងកើត សម្រាប់ សមាជិកភាព អាស៊ាន " និង " សេចក្តីប្រកាស ស្តីពី សេដ្ឋកិច្ច ខៀវ " ។
រដ្ឋមន្ត្រី ការបរទេស ដែល បាន ជួបប្រជុំគ្នា ក៏ នឹង ពិភាក្សា អំពី អាទិភាព សម្រាប់ ឆ្នាំ ខាងមុខ ។
នៅឯ AMM Retreat រដ្ឋមន្ត្រី នានា នឹង ពិចារណា លើ ការតាមដាន កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤០ និង ទី ៤១ រួមទាំង ការពិនិត្យ និង សេចក្តីសម្រេច របស់ មេដឹកនាំ អាស៊ាន ស្តីពី ការអនុវត្ត ការឯកភាព ប្រាំ ចំណុច លើ ប្រទេស មីយ៉ាន់ម៉ា ។
" អនុសាសន៍ ស្តីពី ការពង្រឹង សមត្ថភាព និង ប្រសិទ្ធភាព ស្ថាប័ន របស់ អាស៊ាន ដោយ ក្រុមការងារ កម្រិត ខ្ពស់ ស្តីពី ចក្ខុវិស័យ ក្រោយ ឆ្នាំ 2025 របស់ សហគមន៍ អាស៊ាន " ក៏ នឹង ត្រូវបាន ពិភាក្សា ផងដែរ ដោយ មាន ការផ្លាស់ប្តូរ ទស្សនៈ លើ ទំនាក់ទំនង ខាងក្រៅ ក៏ ដូចជា បញ្ហា តំបន់ និង អន្តរជាតិ ដែល មាន ចំណាប់អារម្មណ៍ និង កង្វល់ រួម ។
ឥណ្ឌូណេស៊ី នឹង ដឹកនាំ ដំណើរការ អាស៊ាន នៅ ឆ្នាំ នេះ ក្រោម ប្រធានបទ បញ្ហា អាស៊ាន៖ ចំណុច កណ្តាល នៃ កំណើន ដើម្បី ធានា ថា ប្លុក ក្នុង តំបន់ ក្លាយជា ចំណុច ស្នូល នៃ កិច្ចសហប្រតិបត្តិការ ដែល រួមចំណែក ដល់ សន្តិភាព ស្ថិរភាព និង វិបុលភាព នៃ អាស៊ី អាគ្នេយ៍ និង ពិភពលោក ។
សេចក្តីប្រកាស របស់ ក្រសួង បាន បន្ត ថា៖ នៅ ក្រៅ ការជួបជុំ នេះ លោក សុខុន រំពឹង ថា នឹង មាន កិច្ចពិភាក្សា ដាច់ដោយឡែក ពី គ្នា ជាមួយ សមភាគី អាស៊ាន មួយចំនួន របស់ លោក ។
កិច្ចប្រជុំ AMM នឹង ក្លាយជា កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ដំបូង ក្នុង អំឡុង ពេល ឥណ្ឌូណេស៊ី ធ្វើជា ប្រធាន អាស៊ាន ក្នុង ឆ្នាំ ២០២៣ ។
នៅក្នុង កិច្ចប្រជុំ ជា បន្តបន្ទាប់ របៀបវារៈ ជាច្រើន នឹង ត្រូវបាន ពិភាក្សា រួមទាំង អាទិភាព សម្រាប់ ការធ្វើជា ប្រធាន របស់ ប្រទេស ឥណ្ឌូនេស៊ី និង តាមដាន លទ្ធផល នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី 40 និង លើក ទី 41 នៅ ឆ្នាំ 2022 ។
ឥណ្ឌូណេស៊ី នឹង ស្ថិត ក្រោម ការដឹកនាំ របស់ ខ្លួន ជំរុញ កិច្ចសហប្រតិបត្តិការ អាស៊ាន ឱ្យ កាន់តែ រឹងមាំ ដើម្បី ឆ្លើយតប ទៅនឹង បញ្ហា ប្រឈម នានា ក្នុង តំបន់ និង ពិភពលោក ដូចជា ការប្រកួតប្រជែង ភូមិសាស្ត្រ នយោបាយ និង ផល ប៉ះពាល់ ជា បន្តបន្ទាប់ នៃ Covid-19 ក៏ ដូចជា គ្រោះមហន្តរាយ ធម្មជាតិ និង វិបត្តិ ហិរញ្ញវត្ថុ ថាមពល និង អាហារ ។
ឥណ្ឌូនេស៊ី បន្ត ការប្តេជ្ញាចិត្ត របស់ ខ្លួន ក្នុង ការរក្សា ស្ថិរភាព និង សន្តិភាព នៅក្នុង តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក តាមរយៈ គំរូ នៃ កិច្ចសហប្រតិបត្តិការ ។
ក្រសួង ការបរទេស ឥណ្ឌូនេស៊ី បាន និយាយ ថា " ទស្សនវិស័យ អាស៊ាន ស្តីពី ឥណ្ឌូ - ប៉ាស៊ីហ្វិក AOIP ដែល ជា គំនិត ផ្តួចផ្តើម របស់ ឥណ្ឌូនេស៊ី ត្រូវបាន អនុម័ត ដោយ មេដឹកនាំ អាស៊ាន ក្នុង ខែមិថុនា ឆ្នាំ 2019 និង មាន គោលបំណង រក្សា ស្ថិរភាព ក្នុង តំបន់ តាមរយៈ ភាព ជាដៃគូ ការសន្ទនា និង កិច្ចសហប្រតិបត្តិការ " ។
ការធ្វើឱ្យ ប្រសើរឡើង តាម ផែនការ នឹង លាតសន្ធឹង លើ ចម្ងាយ ជាង 106 គីឡូម៉ែត្រ ហើយ ត្រូវបាន គេ រំពឹង ថា នឹង ចំណាយ អស់ ជាង 121 លាន ដុល្លារ ដោយ ថវិកា សម្រាប់ គម្រោង នេះ បាន ផ្តល់ ហិរញ្ញប្បទាន តាមរយៈ កម្ចី ពី ប្រទេស ចិន និង កិច្ចសន្យា ជាមួយ ក្រុមហ៊ុន សំណង់ សហគ្រាស រដ្ឋ របស់ ពួកគេ រួម ជាមួយនឹង ការរួមចំណែក ផ្ទាល់ មួយចំនួន ពី ព្រះរាជាណាចក្រ ។
លោក ហ៊ុន សែន ថា ផ្លូវ មាន សារៈសំខាន់ ណាស់ ព្រោះ វា តភ្ជាប់ ខេត្ត តាកែវ ទៅ ខេត្ត កំពត មុននឹង ចេញ ទៅ វៀតណាម ។ ផ្លូវថ្នល់ ដើរ តួនាទី ជា ច្រក របៀង សេដ្ឋកិច្ច ដ៏ សំខាន់ និង ដើរតួ ជា ការបំពេញ បន្ថែម លើ ច្រក របៀង សមុទ្រ ដែល តភ្ជាប់ ពី ប្រទេស វៀតណាម ទៅ ប្រទេស ថៃ តាមរយៈ ប្រទេស កម្ពុជា ។
លោក បាន បន្ថែម ថា នេះ គឺជា សមិទ្ធិផល ធំ មួយ ទៀត ហើយ ក្នុង ចំណោម ព្រឹត្តិការណ៍ សំខាន់ ៗ ជាច្រើន ដែល យើង ត្រូវ ឈានដល់ ដើម្បី ធ្វើឱ្យ វា អាច ទៅ រួច សម្រាប់ ប្រជាជន របស់ យើង ក្នុង ការកសាង ជីវិត កាន់តែ ប្រសើរឡើង ។
លោក ហ៊ុន សែន ក៏ បាន អរគុណ រដ្ឋាភិបាល ចិន ដែល បាន ផ្តល់ ជំនួយ ផ្នែក ហេដ្ឋារចនាសម្ព័ន្ធ ដល់ កម្ពុជា ក្នុង ទំហំ ដែល កំពុង ផ្លាស់ប្តូរ ប្រទេស យ៉ាង ឆាប់រហ័ស ។
លោក បញ្ជាក់ ថា មាន ផ្លូវ ជាង ៣០០០ គីឡូម៉ែត្រ ក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ហើយ ដែល ចិន បាន ជួយ សាងសង់ ហើយ កំពុង បន្ត សាងសង់ ផ្លូវ រាប់ រយ គីឡូម៉ែត្រ ទៀត នា ពេល បច្ចុប្បន្ន ។
លោក នាយក រដ្ឋមន្ត្រី ក៏ បាន សុំទោស ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម ដងផ្លូវ ទាំង ពីរ នេះ ចំពោះ ការរំខាន ដែល ពួកគាត់ នឹង ត្រូវ ដោះស្រាយ ដោយសារ ការស្ថាបនា នា ពេលនេះ ។
ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ប្រកាស ថា គម្រោង កែលម្អ ផ្លូវ ជាតិ លេខ ៣១ មាន ប្រវែង ប្រមាណ ៥៣. ៥៣ គីឡូម៉ែត្រ ចាប់ពី ចំណុច ប្រសព្វ ផ្លូវ គ្រួស ( ផ្លូវ ជាតិ លេខ ៣) ដល់ ផ្សារ កំពង់ត្រា ច ( ប្រសព្វ ផ្លូវ ជាតិ លេខ ៣៣) ឆ្លងកាត់ ខេត្ត តាកែវ និង កំពត ។
ក្រសួង បាន បញ្ជាក់ ថា ផ្លូវ ជាតិ ទាំង ពីរ ខ្សែ នេះ គឺជា ផ្លូវ តភ្ជាប់ សេដ្ឋកិច្ច ដ៏ សំខាន់ ដែល ដើរ តួនាទី សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ភ្ញៀវ ទេសចរ រួមទាំង ការដឹកជញ្ជូន ទំនិញ និង កសិផល គ្រប់ ប្រភេទ រួម មាន អង្ករ កៅស៊ូ ម្រេច ត្រី អំបិល និង ផ្សេង ៗ ទៀត ។ ផ្លែ ឈើ ។
ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី៣០ ខែធ្នូ នេះ បាន រាយការណ៍ ពី ករណី វិជ្ជមាន កូវីដ - ១៩ ក្នុង សហគមន៍ ចំនួន ១៤ករណី និង ជាសះស្បើយ ថ្មី ចំនួន ១១នាក់ ។
វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា និង ក្លឹប អ្នកកាសែត កម្ពុជា (CCJ) បាន រៀបចំ សិក្ខាសាលា មួយ ជាមួយ ក្រសួង ព័ត៌មាន កាលពី ថ្ងៃទី 28-29 ខែធ្នូ ស្តីពី តួនាទី របស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ ជា ផ្នែក នៃ ដំណើរការបោះឆ្នោត ដោយ សម្លឹង ឆ្ពោះ ទៅរក ឆ្នាំ ក្រោយ ។ ការបោះឆ្នោត ជាតិ កាន់តែ ខិត ជិត មកដល់ ហើយ ការផ្សាយ របស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ នៃ ប្រធានបទ នេះ កាន់តែ កើនឡើង ជាលំដាប់ ។
ក្រសួង ព័ត៌មាន បាន មានប្រសាសន៍ ថា សិក្ខាសាលា នេះ មាន គោលបំណង លើកកម្ពស់ ការយល់ដឹង របស់ អ្នកសារព័ត៌មាន អំពី ច្បាប់ ពាក់ព័ន្ធ នីតិវិធី និង ដំណើរការបោះឆ្នោត ក៏ ដូចជា តួនាទី របស់ អ្នកសារព័ត៌មាន និង បទដ្ឋាន សីលធម៌ សមរម្យ សម្រាប់ អ្នកសារព័ត៌មាន ដែល ធ្វើ របាយការណ៍ បោះឆ្នោត ដោយ មាន គោលបំណង ផ្តល់ សិទ្ធិ អំណាច ដល់ អ្នកសារព័ត៌មាន ដែល បាន ចូលរួម ជាមួយ ។ ជំនាញ និង ចំណេះដឹង ចាំបាច់ ដើម្បី ចូលរួម ក្នុង ការវិភាគ ព័ត៌មាន និង ត្រឹមត្រូវ នៃ បញ្ហា ពាក់ព័ន្ធ នឹង ការបោះឆ្នោត ។
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញារីទ្ធ ដែល បាន អញ្ជើញ ជា អធិបតី ក្នុង សិក្ខាសាលា នេះ បាន មានប្រសាសន៍ ថា សង្គម ប្រជាធិបតេយ្យ អាច ដំណើរការ ទៅ មុខ បាន លុះត្រាតែ មាន ការចូលរួម ពី សង្គម ស៊ីវិល និង ជាពិសេស អ្នកសារព័ត៌មាន និង អ្នកសារព័ត៌មាន អាជីព ដែល មាន ចំណេះដឹង និង អាច ផ្តល់ ព័ត៌មាន ដល់ អ្នកបោះឆ្នោត ដែល ជា ការពិត និង ផ្ទៀងផ្ទាត់ បាន ។
លោក ថា នេះ ជាមុខងារ សំខាន់ មួយ ដែល ប្រព័ន្ធ ផ្សព្វផ្សាយ បម្រើ ព្រោះ វា មិន អាច ទៅ រួច ទេ សម្រាប់ អ្នកបោះឆ្នោត ក្នុង ការសម្រេចចិត្ត ល្អ លុះត្រាតែ ពួកគេ អាច ធ្វើ ការសម្រេចចិត្ត ប្រកបដោយ ការយល់ដឹង ។
លោក ពុយ គា ប្រធាន CCJ បាន មានប្រសាសន៍ ក្នុង សិក្ខាសាលា ថា ប្រព័ន្ធ ផ្សព្វផ្សាយ និង អ្នកសារព័ត៌មាន ត្រូវ រៀបចំ ផែនការការផ្សាយ ព័ត៌មាន ការបោះឆ្នោត របស់ ពួកគេ ដោយ ប្រុងប្រយ័ត្ន ហើយ រាយការណ៍ តែ ព័ត៌មាន ដែល បាន ត្រួតពិនិត្យ ប៉ុណ្ណោះ ដើម្បី ការពារ ខ្លួន ពី ការផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ឬ ព័ត៌មាន ក្លែងក្លាយ ដោយ មិន ដឹងខ្លួន ។
លោក ថា អ្នកសារព័ត៌មាន អាជីព អាច ចូលរួមចំណែក ដ៏ មាន តម្លៃ ក្នុង ការធ្វើឲ្យ សង្គម ប្រសើរឡើង ដោយ ដើរតួ ជា តម្រង ការពារ ការផ្សព្វផ្សាយ ព័ត៌មាន លម្អៀង ដែល អាច បង្ក ភាពចលាចល ក្នុង ពេល បោះឆ្នោត ។
សិក្ខាសាលា នេះ មាន សិក្ខាកាម ចូលរួម ចំនួន ៥៤ នាក់ មក ពី អង្គភាព សារព័ត៌មាន កម្ពុជា ចំនួន ២៦ រួម ជាមួយ វា គ្មិន ៩រូប និង គ្រូបង្គោល សំខាន់ ៗ ដែល ជា អ្នកសារព័ត៌មាន ជើង ចាស់ អ្នកជំនាញ ផ្នែក ច្បាប់ និង វិទ្យាសាស្ត្រ នយោបាយ មកពី ព្រះរាជាណាចក្រ ព្រមទាំង មកពី ប្រទេស បារាំង អាល្លឺម៉ង់ និង អូស្ត្រាលី ។
កម្លាំង សមត្ថកិច្ច នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន នៃ អគ្គ ស្នងការ នគរបាល ជាតិ និង ខណ្ឌ ដង្កោ បាន ចាប់ខ្លួន បុរស ២នាក់ ដែល សង្ស័យ ថា បាន បាញ់ សម្លាប់ មន្ត្រី នគរបាល ម្នាក់ ក្នុង ប្រតិបត្តិការ ប្រឆាំង គ្រឿងញៀន នៅ ទីតាំង មួយ នៅ ជាយ រាជធានី ភ្នំពេញ កាលពី ល្ងាច ថ្ងៃទី ២៨ ខែធ្នូ ។ .
លោក អ៊ិន សុង អ្នកនាំពាក្យ នាយកដ្ឋាន ប្រឆាំង គ្រឿងញៀន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃទី ២៩ ខែធ្នូ ថា បច្ចុប្បន្ន អាជ្ញាធរ កំពុង ស៊ើបអង្កេត ហើយ ករណី នេះ រួមទាំង ការបាញ់ សម្លាប់ មនុស្ស នៅតែ បើកចំហ ។
សូម យល់ ថា ឥឡូវនេះ យើង កំពុង ប្រមូល ព័ត៌មាន បឋម ហើយ យើង មាន បំណង នាំ ខ្លួន ជនល្មើស នៃ ទង្វើ នេះ មក កាត់ទោស ។ យើង មិន អាច ពិភាក្សា លម្អិត បាន ទេ ខណៈ ដែល សំណុំរឿង នេះ បើក ចំហ ដូច្នេះ យើង នឹង ផ្តល់ ការពិត ទាំងអស់ ទាក់ទង នឹង ហេតុការណ៍ នៅ ពេល ក្រោយ ។ គាត់ បាន និយាយ ថា ។
លោក ថា មន្ត្រី នគរបាល ដែល ត្រូវ គេ បាញ់ សម្លាប់ នោះ គឺ លោក ឧត្តមសេនីយ៍ ទោ ម៉ិច ឆៃ ភី មាន តួនាទី ជា នាយ រង ការិយាល័យ អប់រំ នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ។ គាត់ ត្រូវបាន គេ បាញ់ សម្លាប់ ក្នុង ពេល សមត្ថកិច្ច ចុះ ប្រតិបត្តិការ នៅ បុរី ជីប ម៉ុង ក្នុង សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ ។
លោក ជាង ហុក សែ អធិការ រង នគរបាល ខណ្ឌ ដង្កោ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ២៩ ខែធ្នូ ថា នេះ ជា ប្រតិបត្តិការ ប្រឆាំង ការជួញដូរ គ្រឿងញៀន ហើយ មាន ការផ្ទុះ អាវុធ នៅ ពេល ដែល សមត្ថកិច្ច ព្យាយាម ឃាត់ រថយន្ត ដែល កំពុង បើកបរ ក្បែរ អាសយដ្ឋាន ដែល ខ្លួន កំពុង ឆ្មក់ ចូល ។
លោក ហុក សេង បញ្ជាក់ ថា៖ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បង្ក្រាប បទល្មើស គ្រឿងញៀន ប៉ុន្តែ យើង ជា កម្លាំង ល្បាត គាំទ្រ ។ ក្រោយពី យើង ដឹង ថា មន្ត្រី ប៉ូលិស នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ត្រូវបាន គេ បាញ់ នោះ មេ ប៉ូលិស របស់ ខ្ញុំ បាន បញ្ជា ខ្ញុំ តាម វិទ្យុ ដើម្បី ស្វែងរក ជនសង្ស័យ ។ ពេល នោះ យើង ឃើញ រថយន្ត ហើយ យើង ក៏ ឈប់ ដោយ មិន មាន ហេតុការណ៍ អ្វី កើតឡើង ហើយ ប្រគល់ ទៅ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ។
លោក ហុក សែ បន្ត ថា ពួកគេ បាន ឈប់ រថយន្ត នៅ ភ្លើង ស្តុប ផ្លូវ ៥០ម៉ែត្រ ត្រង់ ចំណុច ផ្លូវ ៦០ម៉ែត្រ ក្នុង ភូមិ ព្រែក ថ្លឹង សង្កាត់ ជើងឯក ។ មនុស្ស ៣នាក់ ក្នុង នោះ មាន ស្ត្រី ម្នាក់ ជា ជន បរទេស ត្រូវបាន ឃាត់ខ្លួន ទាំងអស់ ។
ធនាគារ ទាំងនោះ មាន ធនាគារ អេស៊ីលីដា ភី អិល ស៊ី ធនាគារ កាណាឌីយ៉ា ភី អិល ស៊ី និង ធនាគារ វីង ( ខេមបូឌា ) ភី អិល ស៊ី ។ គំនិត ផ្តួចផ្តើម នេះ ត្រូវបាន ដឹកនាំ ដោយ ក្រសួង មុខងារ សាធារណៈ ដែល បាន ទទួល ការអនុញ្ញាត ពី រដ្ឋាភិបាល កាលពី ថ្ងៃទី 5 ខែវិច្ឆិកា ឆ្នាំ 2021 ដើម្បី ដំណើរការ គម្រោង នេះ ។
ថ្លែង ក្នុង ពិធី សម្ពោធ នោះ រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ បាន បញ្ជាក់ ថា អត្តសញ្ញាណប័ណ្ណ Smart នឹង មាន សុពលភាព១០ ឆ្នាំ ហើយ អាច ប្រើប្រាស់ ដើម្បី ទទួល ប្រាក់ បៀវត្សរ៍ ក៏ ដូចជា មធ្យោបាយ ផ្សេង ៗ ជាច្រើន ប៉ុន្តែ បាន កត់សម្គាល់ ថា មិន អាច ប្រើប្រាស់ ជំនួស បាន ទេ ។ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ គ្រប់ កាលៈទេសៈ ។
លោក ព្រំ សុខា បាន សង្កត់ធ្ងន់ ថា ក្រសួង រួម ជាមួយនឹង គណៈកម្មាធិការ រដ្ឋាភិបាល ឌីជីថល បាន ផ្តោត ជា សំខាន់ លើ គំនិត ផ្តួចផ្តើម នេះ ជា ប្លុក អគារ ក្នុង ទំនើបកម្ម និង ន វានុវត្តន៍ នៃ រដ្ឋបាល សាធារណៈ ដែល ត្រូវបាន គេ មើលឃើញ ថា ជា កត្តា ជំរុញ ដ៏ សំខាន់ នៃ ដំណើរ របស់ រដ្ឋាភិបាល ឌីជីថល ។
លោក កឹម សុខា មានប្រសាសន៍ ថា កិច្ច ខិតខំ ប្រឹងប្រែង ទាំងនេះ ត្រូវបាន បំផុស គំនិត ដោយ បដិវត្តន៍ ឧស្សាហកម្ម ទី៤ និង និន្នាការ Covid-19 ក៏ ដូចជា ក្របខ័ណ្ឌ គោល នយោបាយ សេដ្ឋកិច្ច និង សង្គម ឌីជីថល កម្ពុជា ឆ្នាំ ២០២១ - ២០៣៥ ដែល លោក បាន ពិពណ៌នា ថា ជា ផែនទី បង្ហាញ ផ្លូវ ដ៏ ទូលំទូលាយ សម្រាប់ ការផ្លាស់ប្តូរ ឌីជីថល សេដ្ឋកិច្ច សង្គម របស់ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក បាន បន្ត ថា៖ កិច្ចសហការ នេះ បាន បង្កើត ជា ផ្នែក មួយ នៃ គោល នយោបាយ របស់ រដ្ឋាភិបាល និង សង្គម ឌីជីថល ព្រមទាំង កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រសួង មុខងារ សាធារណៈ ក្នុង ការធ្វើ ទំនើបកម្ម ប្រព័ន្ធ ឌីជីថល ។
ការដាក់ ឱ្យ ប្រើប្រាស់ អត្តសញ្ញាណប័ណ្ណ ថ្មី សម្រាប់ មន្ត្រីរាជការ បង្ហាញ ពី ទំនាក់ទំនង យ៉ាង ជិតស្និទ្ធ គាំទ្រ គ្នា ទៅ វិញ ទៅមក និង សូម្បីតែ ផ្នែក សាធារណៈ និង ឯកជន មិន អាច បំបែក បាន ក៏ដោយ ។
លោកស្រី បាន មានប្រសាសន៍ ថា លើស ពី នេះ លទ្ធផល ទាំងនេះ បង្ហាញ ថា វិស័យ សាធារណៈ និង ឯកជន ឬ ទូលំទូលាយ ជាង នេះ ប្រទេស កម្ពុជា ទាំងមូល កំពុង ប្រើប្រាស់ បច្ចេកវិទ្យា ទំនើប ដើម្បី ឈាន ទៅ មុខ ក៏ ដូចជា ប្រទេស អភិវឌ្ឍន៍ ផ្សេង ទៀត នៅក្នុង តំបន់ និង លើស ពី នេះ ទៅ ទៀត ។
លោក បាន មានប្រសាសន៍ ថា គិត ត្រឹម ថ្ងៃទី ២៨ ខែធ្នូ ទីភ្នាក់ងារ រដ្ឋាភិបាល សរុប ចំនួន ១៧ បាន បញ្ជូន ពាក្យ សុំ ចូល បម្រើ ការងារ របស់ មន្ត្រីរាជការ ចំនួន ១.៨៥៩ នាក់ ក្នុង ចំណោម ការប៉ាន់ស្មាន របស់ ព្រះរាជាណាចក្រ កម្ពុជា ជាង ២២ ម៉ឺន នាក់ ហើយ ប័ណ្ណ ចំនួន ៤៩៧ ត្រូវបាន បោះពុម្ព សម្រាប់ មន្ត្រី នៅ ទីភ្នាក់ងារ ចំនួន ១១ ក្រសួង ទាំងស្រុង ។ ភ្នំពេញ ប៉ុស្តិ៍ យល់ ថា សន្លឹក បៀ ទាំង ៤៩៧ សន្លឹក នេះ ត្រូវបាន ប្រគល់ ឱ្យ នៅក្នុង ព្រឹត្តិការណ៍ នោះ ។
កិច្ចប្រជុំ អន្តរ ក្រសួង កាលពី ថ្ងៃទី 19 ខែមករា បាន ពិភាក្សា អំពី ការលើកទឹកចិត្ត ដ៏ មាន សក្តានុពល និង វិធានការ ផ្សេង ទៀត ដែល អាច ត្រូវបាន ប្រើប្រាស់ ដើម្បី ដោះស្រាយ បញ្ហា អគារ និង គម្រោង វិនិយោគ រាប់ រយ ដែល មិន ទាន់ រួចរាល់នៅ ខេត្ត ព្រះសីហនុ ។
គម្រោង ដែល បាន បញ្ចប់ ដោយ ផ្នែក ត្រូវបាន គេ មើលឃើញ ថា ជា សញ្ញា នៃ អស្ថិរភាព និង ជា ភ្នែក សម្រាប់ អ្នក វិនិយោគ នា ពេល អនាគត ចំពេល មាន ផែនការប្រែក្លាយ ខេត្ត មាត់ សមុទ្រ ទៅជា " តំបន់ សេដ្ឋកិច្ច ពិសេស ពហុ គោលបំណង គំរូ " ក៏ ដូចជា មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ និង ពាណិជ្ជកម្ម ក្នុង តំបន់ ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង នៅ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ក្រោម អធិបតីភាព ឯកឧត្តម ហ៊ាន សាហ៊ីប រដ្ឋលេខាធិការ ក្រសួង ដែល ជា ប្រធាន ក្រុមការងារ ទទួលបន្ទុក ដោះស្រាយ បញ្ហា ពាក់ព័ន្ធ គម្រោង វិនិយោគ នៅ ខេត្ត ព្រះសីហនុ ផងដែរ ។
អ្នកចូលរួម បាន ទំពារ លើ ស្ថានភាព ទាំងមូល រួមទាំង ទិដ្ឋភាព ច្បាប់ និង វឌ្ឍនភាព ដែល បាន ធ្វើ ក៏ ដូចជា មធ្យោបាយ ដែល អាច ធ្វើ ទៅ បាន ក្នុង ការដោះស្រាយ បញ្ហា និង បញ្ហា ប្រឈម ដែល ពាក់ព័ន្ធ របស់ វា ។
ពួកគេ បាន តស៊ូ មតិ សម្រាប់ ការធ្វើ បច្ចុប្បន្នភាព ចំពោះ ព័ត៌មាន លម្អិត នៃ គម្រោង ដែល មិន ទាន់ បាន បញ្ចប់ ។ ការសិក្សា និង ការកែសម្រួល វិធានការ ដើម្បី ដោះស្រាយ បញ្ហា ក៏ ដូចជា ការពិភាក្សា លម្អិត នា ពេល អនាគត របស់ វា ; និង ផែនការ សកម្មភាព ។
មិន មាន ព័ត៌មាន ជាក់លាក់ ណាមួយ អាច រកឃើញ ភ្លាម ៗ អំពី វិធានការ ដែល បាន ពិភាក្សា ក្នុង កិច្ចប្រជុំ នោះ ទេ ។
អភិបាល ខេត្ត ព្រះសីហនុ លោក ស កក្កដា នៅ ថ្ងៃទី ១៩ ខែមករា នេះ បាន ចេញ សេចក្តីជូនដំណឹង មួយ ដោយ បញ្ជា ឱ្យ យានជំនិះ រួមទាំង រទេះ អាជីវករ និង សណ្ដោង រ៉ឺម៉ក ត្រូវ បិទបាំង ឆ្នេរ និង ផ្លូវ មាត់ សមុទ្រ ក្នុង ក្រុង ប្រកបដោយ ប្រសិទ្ធភាព ភ្លាម ៗ ដោយ លើកឡើង ពី ការខូចខាត ផ្លូវ ក៏ ដូចជា សុវត្ថិភាព ទេសចរណ៍ និង ហានិភ័យ សណ្តាប់ធ្នាប់ សាធារណៈ ។
សេចក្តីជូនដំណឹង នេះ បាន ណែនាំ ដល់ ប៉ូលីស ឱ្យ " រឹបអូស " យានយន្ត ជា បណ្តោះអាសន្ន ដែល បំពាន លើ បទបញ្ជា ដោយ ហេតុផល ថា ការផ្លាស់ប្តូរ នេះ នឹង ធានា សុវត្ថិភាព របស់ អ្នកទេសចរ និង រក្សា ឆ្នេរសមុទ្រ ដ៏ ស្រស់ស្អាត ។
រដ្ឋបាល ខេត្ត ព្រះសីហនុ បង្ហាញ ជំនឿចិត្ត ថា ប្រជាពលរដ្ឋ នឹង មាន ទំនួល ខុសត្រូវ និង បំពេញ ការងារ របស់ ខ្លួន ដើម្បី ធានា បាន នូវ ការគោរព តាម បទបញ្ជា របស់ អភិបាល ខេត្ត ។
នាយក អង្គការ ស្រាវជ្រាវ ជាតិ កម្ពុជា (CNRO) លោក សុខ សុខុម បាន កត់សម្គាល់ ថា ចំណាត់ការ នេះ កើតឡើង ទាន់ ពេលវេលា ដោយ លើក ហេតុផល ថា ការពន្យារ ពេល យូរ អាច នាំឱ្យ មាន ការរំខាន ដល់ សណ្តាប់ធ្នាប់ សាធារណៈ គួរឱ្យ កត់សម្គាល់ និង កាត់បន្ថយ ភាពទាក់ទាញ នៃ មាត់ សមុទ្រ ។
លោក បាន លើកឡើង ថា៖ តំបន់ ឆ្នេរ ខេត្ត ព្រះសីហនុ ជា សម្បត្តិ សាធារណៈ សម្រាប់ ការកម្សាន្ត មិន អាច អនុញ្ញាតឲ្យ ប្រជាពលរដ្ឋ ជិះ ម៉ូតូ បើក រថយន្ត ឬ អូសរទេះ ឬ រ៉ឺម៉ក នៅ ទីនោះ បាន ទេ បើ មិន ដូច្នេះ ទេ វា អាច ធ្វើឲ្យ ខូច អារម្មណ៍ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ។
នាយកដ្ឋាន ព័ត៌មានវិទ្យា នៃ ក្រសួង មហាផ្ទៃ បាន ចេញ ការព្រមាន ថ្មី សម្រាប់ សាធារណជន ឱ្យ មាន ការប្រុងប្រយ័ត្ន ចំពោះ អ្នក បោកប្រាស់ ដែល ក្លែង ធ្វើជា អ្នកលក់ អនឡាញ ស្រប ច្បាប់ ។
នាយកដ្ឋាន បាន កត់សម្គាល់ ថា នៅ ពេល ដែល បច្ចេកវិទ្យា ឌីជីថល មាន ភាពប្រសើរឡើង និង ផ្លាស់ប្តូរ របៀប ដែល មនុស្ស ដឹកនាំ ជីវិត របស់ ពួកគេ និង ធ្វើ អាជីវកម្ម អ្នក បោកប្រាស់ បង្កើត យុទ្ធសាស្ត្រ លើ អ៊ីនធឺណិត កាន់តែ ទំនើប និង ទាញយក អ្នកប្រើប្រាស់ ដែល មិន មាន ការសង្ស័យ ជាមួយនឹង ការទាក់ទាញ ការផ្សាយ ពាណិជ្ជកម្ម សម្រាប់ ផលិតផល ឬ សេវាកម្ម នៅលើ គេហទំព័រ ឬ វេទិកា ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ។
នាយកដ្ឋាន បាន ណែនាំ សាធារណៈ ជន ឱ្យ រកមើល ព័ត៌មាន អ្នកផ្គត់ផ្គង់ ច្បាស់លាស់ និង ភាព មិន ប្រក្រតី ដែល អាច កើតមាន មុនពេល ផ្តល់ ការបង់ប្រាក់ ឬ ព័ត៌មាន ផ្ទាល់ខ្លួន សំខាន់ ៗ និង រាយការណ៍ ពី ការឆបោក ដែល សង្ស័យ ដូច្នេះ អ្នក ផ្សេង ទៀត អាច ត្រូវបាន ព្រមាន ។
វា បាន ចង្អុលបង្ហាញ ថា គណនី ទូទាត់ ក្លែង បន្លំ ត្រូវបាន បង្កើតឡើង ជាញឹកញាប់ ដោយ " លុយកាក់ " ឬ អន្តរ ការី ដែល ប្រើ ដោយ អ្នក បោកប្រាស់ ។
សាខា កាកបាទ ក្រហម កម្ពុជា ស្រុក កំរៀង ខេត្ត បាត់ដំបង បាន បើក យុទ្ធនាការ ស្តារ ទំនាក់ទំនង គ្រួសារ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ធានា សុវត្ថិភាព ការធ្វើ ចំណាកស្រុក របស់ ប្រជាពលរដ្ឋ តាម សហគមន៍ មូលដ្ឋាន ដើម្បី ការពារ កុំ ឱ្យ ធ្លាក់ ចូល ក្នុង ដៃ របស់ ឈ្មួញ កណ្តាល ដែល មិន សម ហេតុផល ។
ថ្លែង នៅក្នុង ព្រឹត្តិការណ៍ មួយ នៅ ភូមិ កំរៀង ឃុំ តាក្រី ស្រុក កំរៀង ដែល ប្រារព្ធ ពិធី នេះ មន្ត្រី បាន សង្កត់ធ្ងន់ ថា កង្វះ ព័ត៌មាន សម្រាប់ ជន ចំណាកស្រុក ដែល មាន សក្តានុពល នៅតែ ជា បញ្ហា ប្រឈម ។
ភាពងាយ រងគ្រោះ នេះ បាន ជំរុញ ឱ្យ អ្នកប្រព្រឹត្ត អំពើ ទុច្ចរិត ទាញយក ផលប្រយោជន៍ ពី ជន ចំណាកស្រុក ដែល ប្រាថ្នា ចង់បាន ជាពិសេស អ្នក ដែល ស្វែងរក ការងារ ដែល រក បាន ច្រើន ជាង មាន នៅក្នុង ស្រុក ដោយ មនុស្ស ជាច្រើន ក្លាយជា ជនរងគ្រោះ នៃ ការជួញដូរ មនុស្ស ។
យុទ្ធនាការ នេះ មាន គោលបំណង បំពេញ គម្លាត ព័ត៌មាន នោះ អប់រំ ទាំង ជន ចំណាកស្រុក ដែល មាន សក្តានុពល និង ក្រុមគ្រួសារ របស់ ពួកគេ អំពី ហានិភ័យ ដែល ពាក់ព័ន្ធ ក៏ ដូចជា ការផ្តល់ ការណែនាំ អំពី ការការពារ សុវត្ថិភាព និង បទពិសោធន៍ ជីវិត ពិត របស់ អ្នក ដែល ធ្វើ ចំណាកស្រុក ពីមុន មក ។
ក្រុមការងារ កាកបាទ ក្រហម កម្ពុជា បាន ចែក ខិតប័ណ្ណ និង សម្ភារៈ ផ្សេង ៗ ដល់ អ្នកចូលរួម ក្នុង ព្រឹត្តិការណ៍ នេះ ។
តាមរយៈ យន្តការ នេះ ប្រទេស សមាជិក បាន បង្កើន ប្រសិទ្ធភាព នៃ វិធានការ ទប់ស្កាត់ និង បង្រ្កាប ទំនិញ ខុស ច្បាប់ ការជួញដូរ ការគេច ពន្ធ និង ការប្រើប្រាស់ ខុសឆ្គង ដោយ អសីលធម៌ និង សកម្មភាព ភេរវករ ។
ក្នុង ដំណើរទស្សនកិច្ច ទៅកាន់ អង្គភាព ត្រួតពិនិត្យ កុងតឺន័រ (CCU) នៃ សាខា គយ និង រដ្ឋាករ នៃ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ គណៈប្រតិភូ បាន ស្គាល់ ទីតាំង ត្រួតពិនិត្យ ទំនិញ និង ឧបករណ៍ កុងតឺន័រ និង ស្ថានីយ៍ ចត ប្រព័ន្ធ ការបញ្ជាក់ ដោយ ខ្លួន ឯង និង ប្រព័ន្ធ អេឡិចត្រូនិក និង ការបោសសំអាត គយ និង នីតិវិធី ពាក់ព័ន្ធ ។
ប្រទេស កម្ពុជា នៅតែ ជា ជម្រក របស់ សត្វ ត្រយ៉ង ស្មាស ជាង ពាក់កណ្តាល នៃ ពិភពលោក ដែល មាន ចំនួន ៧៥៤ ក្បាល នៃ ចំនួន ប្រជាជន ប៉ាន់ស្មាន ទូទាំង ពិភពលោក ចំនួន ១.០០០ ក្បាល មាន វត្តមាន នៅក្នុង ព្រះរាជាណាចក្រ នេះ បើ យោង តាម ជំរឿន ថ្មី ៗ នេះ ។
អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន លោក នេត្រ ភក្ត្រា នៅ ថ្ងៃទី ២០ ខែធ្នូ បាន ប្រកាស ថា សំបុក ថ្មី ចំនួន ២ ត្រូវបាន កត់ត្រា នៅក្នុង ដែន ជម្រក សត្វ ព្រៃ លំ ផាត់ ខេត្ត រតនគិរី ដោយ កត់សម្គាល់ ថា ប្រភេទ សត្វ នេះ ក៏ មាន វត្តមាន នៅក្នុង តំបន់ ការពារ មួយចំនួន ទៀត ។
លោក ភក្ត្រា បាន និយាយ ថា ប្រភេទ សត្វ នេះ ត្រូវបាន ដាក់បញ្ចូល ក្នុង បញ្ជី ក្រហម របស់ សហភាព អន្តរជាតិ សម្រាប់ ការអភិរក្ស ធម្មជាតិ (IUCN) ។ វា ធ្លាប់ ជា រឿង ធម្មតា នៅ អាស៊ី អាគ្នេយ៍ ប៉ុន្តែ ចំនួន ប្រជាជន បាន ធ្លាក់ចុះ យ៉ាង ខ្លាំង នៅក្នុង សតវត្ស ទី 20 ។
លោក ភក្ត្រា បាន មានប្រសាសន៍ ថា នេះ ជា ការបង្ហាញ ពី ការងារ វិជ្ជមាន របស់ ខ្លួន ក្នុង ការការពារ ធនធាន ធម្មជាតិ និង រតនសម្បត្តិ របស់ ព្រះរាជាណាចក្រ ។
លោក បាន បន្ថែម ថា ប្រភេទ សត្វ នេះ មាន វត្តមាន នៅក្នុង ដែន ជម្រក សត្វ ព្រៃ សៀម ប៉ាង ដែន ជម្រក សត្វ ព្រៃ គូលែន ព្រហ្ម ទេព ដែន ជម្រក សត្វ ព្រៃ លំ ផាត់ តំបន់ ទំនាប ខាងកើត និង តាម ដងទន្លេ មេគង្គ ។ ទោះជា យ៉ាងណា ក៏ដោយ ពួកគេ ត្រូវបាន គំរាមកំហែង ដោយ ការបាត់បង់ ទីជម្រក ការបំពុល និង ការរំខាន ដោយ សកម្មភាព របស់ មនុស្ស ។
ដែន ជម្រក សត្វ ព្រៃ សៀម ប៉ាង គឺជា ជម្រក ដ៏ សំខាន់ សម្រាប់ ពួកវា ដោយ មាន កត់ត្រា សរុប ចំនួន ៣៧៣ ក្បាល បន្ទាប់មក ដែន ជម្រក សត្វ ព្រៃ សំបូរ ក្នុង ខេត្ត ក្រចេះ ដែល មាន សត្វ ចំនួន ២៥២ ក្បាល ។
ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២១ ខែធ្នូ នេះ បាន រាយការណ៍ ពី ករណី វិជ្ជមាន កូវីដ - ១៩ ក្នុង សហគមន៍ ថ្មី ចំនួន ១៩ នាក់ និង ជាសះស្បើយ ថ្មី ចំនួន ២១ នាក់ ។
កម្ពុជា បាន ផ្តល់ ការគាំទ្រ ចំពោះ សំណើ របស់ ក្រុមហ៊ុន កូរ៉េ ខាងត្បូង ក្នុង ការសិក្សា ពី លទ្ធភាព នៃ ការកែច្នៃ កាកសំណល់ ទៅជា ឥន្ធនៈ ដើម្បី បង្កើត ថាមពល ។
យោង តាម ក្រសួង បរិស្ថាន បាន ឲ្យដឹង ថា បច្ចុប្បន្ន ព្រះរាជាណាចក្រ កម្ពុជា ផលិត សំរាម ប្រមាណ ៤លាន តោន ក្នុង មួយ ឆ្នាំ ។
សម្តេច ហ៊ុន សែន បាន បញ្ជូន សំណើ នេះ ទៅ លោក សុខ ចិន្តា សោភា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា (CDC) ដែល នឹង ធ្វើការ ជាមួយ លោក ស៊ុយ សែម រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង សាលា រាជធានី ភ្នំពេញ ដើម្បី សម្រួល ដល់ ការសិក្សា លទ្ធភាព ។
ក្រសួង បរិស្ថាន បាន ឲ្យដឹង ថា កម្ពុជា ផលិត កាកសំណល់ បាន ជាង ១ ម៉ឺន តោន ក្នុង មួយ ថ្ងៃ ដោយ រាជធានី ភ្នំពេញ មាន ចំនួន ចន្លោះ ពី ២ ៧០០ ទៅ ៣ ០០០ តោន ។
អ្នកស្រាវជ្រាវ ផ្នែក សេដ្ឋកិច្ច នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា (RAC) លោក គី សេរី វឌ្ឍន៍ មានប្រសាសន៍ ថា ប្រទេស កូរ៉េ ខាងត្បូង មាន បទពិសោធន៍ រួចហើយ ក្នុង ការកែច្នៃ សំរាម ទៅជា ថាមពល ហើយ ប្រព័ន្ធ បែប នេះ ច្រើន តែ ពឹងផ្អែក លើ មនុស្ស ក្នុង ការរៀបចំ កាកសំណល់ របស់ ពួកគេ ដោយ ខ្លួន ឯង ដើម្បី ជា ប្រយោជន៍ ដល់ បរិស្ថាន ថាមពល និង សុខុមាលភាព ប្រជាជន ។
នេះ ជា ការ ល្អ ជាពិសេស ប្រសិនបើ កាកសំណល់ ក្នុង ផ្ទះ អាច ប្រើ ជា ថាមពល ។ វា ពិតជា ល្អ ណាស់ ក្នុង ការគាំទ្រ ការកែច្នៃ សំរាម ទៅជា ថាមពល គ្រប់ ប្រភេទ ។
ដោយ បារម្ភ ពី លទ្ធភាព នៃ ការនាំចូល សំរាម ពី បរទេស មក ធ្វើជា យន្តការផលិត ថាមពល នេះ នៅ ពេល ដែល រោងចក្រ អគ្គិសនី ដំណើរការ ហើយ នោះ លោក ស្នើ ឱ្យ រដ្ឋាភិបាល និង ភាគី ពាក់ព័ន្ធ ហាមឃាត់ ការនាំចូល សំរាម និង កាកសំណល់ ចូល ប្រទេស ជាពិសេស ក្រោម ការក្លែងបន្លំ ជា ទំនិញ ផ្សេង ៗ ឬ សម្រាប់ គោលបំណង ផ្សេង ទៀត ។
លោក ហេង គឹម ហុង អ្នកគ្រប់គ្រង កម្មវិធី ស្រាវជ្រាវ និង តស៊ូ មតិ នៅ បណ្តាញ យុវជន កម្ពុជា (CYN) បាន គាំទ្រ គម្រោង នេះ ដោយ មានប្រសាសន៍ ថា អនុញ្ញាតឱ្យ កម្ពុជា ប្រឹងប្រែង អស់ ពី សមត្ថភាព ក្នុង ការគ្រប់គ្រង សំរាម ការពារ បរិស្ថាន និង ពន្លឿន ការប្រមូល សំរាម ដើម្បី ការពារ សំរាម ពាសពេញ ផ្លូវ ។
លោក បាន ស្នើ ឱ្យ រដ្ឋាភិបាល ពន្លឿន គម្រោង នេះ និង លើកទឹកចិត្ត និង ជំរុញ ការវិនិយោគ លើ ការកែច្នៃ សំរាម ទៅជា ឥន្ធនៈ ផលិត ថាមពល ព្រោះ ការគ្រប់គ្រង សំរាម នៅ កម្ពុជា ត្រូវការ ការកែលម្អ ។
ខ្ញុំ នៅតែ មាន សុទិដ្ឋិនិយម ចំពោះ ការកែច្នៃ ឡើងវិញ នេះ ព្រោះ វា អាច ជា ការលើកទឹកចិត្ត មួយ ដើម្បី ធានា ថា វិធានការប្រមូល សំរាម មាន ល្បឿន លឿន ស្តង់ដារ និង ធ្វើ បាន ត្រឹមត្រូវ ។ វា ក៏ អាច កាត់បន្ថយ សារធាតុ ពុល ដែល បាន មកពី កាកសំណល់ មួយចំនួន និង ជួយ ធ្វើឱ្យ បរិយាកាស រស់ នៅ របស់ ប្រជាជន កាន់តែ មាន ផាសុកភាព ។
លោក ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ដល់ ប្រទេស អូស្ត្រាលី ដែល បាន ជួយ ដល់ កម្ពុជា ក្នុង ការធ្វើជា ប្រធាន អាស៊ាន ដោយ បន្ថែម ថា លោក Kang បាន ខិតខំ ប្រឹងប្រែង អស់ ពី សមត្ថភាព ដើម្បី ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ រួមទាំង វិស័យ កសិកម្ម ផងដែរ ។
សម្តេច ហ៊ុន សែន បាន រំឮក ដល់ លោកស្រី កង អំពី ភាពច្របូកច្របល់ និង ពេល ខ្លះ គួរឱ្យ ព្រួយបារម្ភ នៅ ថ្ងៃ ដំបូង នៃ ជំងឺ រាតត្បាត ដោយ លោក មានប្រសាសន៍ ថា ការអនុញ្ញាតឱ្យ នាវា ទេសចរណ៍ MS Westerdam ចូល ចត ក្នុង គ្រា អាសន្ន ក្នុង អំឡុង ជំងឺ រាតត្បាត រាតត្បាត ឆ្នាំ ២០២០ គឺជា សក្ខីភាព នៃ តម្លៃ មនុស្សធម៌ របស់ កម្ពុជា ដែល ផ្តល់ សិទ្ធិ រស់រាន មាន ជីវិត លើស អ្វី ៗ ទាំងអស់ ។ ផ្សេង ទៀត ។
នៅក្នុង ការបង្ហោះ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម លោក ហ៊ុន សែន បាន ដកស្រង់ សម្តី លោក Kang ថា ទោះបីជា បេសកកម្ម ការ ទូត របស់ លោក ប្រព្រឹត្តទៅ ក្នុង អំឡុង ពេល ជំងឺ រាតត្បាត និង ដោយ ហេតុ នេះ កំណត់ តួនាទី ឯក អគ្គ រដ្ឋទូត ធម្មតា មួយ ចំនួន ក៏ដោយ ក៏ លោក មាន មោទនភាព ចំពោះ ការពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង កាន់តែ ប្រសើរឡើង ។ ពួកគេ មិន ត្រឹមតែ ទាក់ទង នឹង Covid-19 ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ មាន នៅក្នុង ផ្នែក ដូចជា ជំនួយ មីន អាហារូបករណ៍ កិច្ចសហប្រតិបត្តិការ យោធា និង ពាណិជ្ជកម្ម សេរី ។
