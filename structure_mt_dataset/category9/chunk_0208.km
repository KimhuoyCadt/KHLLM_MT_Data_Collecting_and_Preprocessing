លោក រំពឹង ថា កិច្ចសហប្រតិបត្តិការ នឹង រីកចម្រើន លើ វិស័យ រក្សា សន្តិភាព ជាពិសេស ក្នុង វិស័យ ដោះ មីន ។
សម្តេច បាន កោតសរសើរ ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន បញ្ជូន ទាហាន របស់ ខ្លួន ទៅ បំពេញ បេសកកម្ម នៅ ក្រៅ ប្រទេស និង បាន កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ខ្លួន ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៤០ និង ទី៤១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នានា ។
សុវណ្ណ នី បាន ថ្លែងអំណរគុណ ចំពោះ ប្រទេស ជប៉ុន ដែល បាន ជួយ ដល់ កម្ពុជា ។ ឆ្នាំ នេះ ជា ខួប លើក ទី៣០ នៃ ការចូលរួម របស់ ជប៉ុន ក្នុង អាជ្ញាធរ អន្តរកាល នៃ អង្គការ សហ ប្រជាជាតិ ប្រចាំ កម្ពុជា ( អ៊ុន តាក់ ) ។ ជនជាតិ ជប៉ុន ពីរ នាក់ ត្រូវបាន គេ សម្លាប់ ក្នុង អំឡុង ពេល បេសកកម្ម ប៉ូលិស ម្នាក់ និង អ្នកស្ម័គ្រចិត្ត អង្គការ សហ ប្រជាជាតិ ។
លោក បាន ស្នើសុំ ការបណ្តុះបណ្តាល បន្ថែម ពី ប្រទេស ជប៉ុន ដើម្បី ពង្រឹង សមត្ថភាព កងទ័ព របស់ ព្រះរាជាណាចក្រ និង អនុញ្ញាតឱ្យ ពួកគេ ចូលរួមចំណែក បន្ថែម ទៀត ដល់ អង្គការ សហ ប្រជាជាតិ ។
ចាប់តាំងពី ឆ្នាំ ២០០៦មក កម្ពុជា បាន ចូលរួមចំណែក ក្នុង បេសកកម្ម រក្សា សន្តិភាព នៅ អាហ្វ្រិក មជ្ឈិមបូព៌ា និង អឺរ៉ុប ។ នៅ ពេល នោះ ខ្លួន បាន បញ្ជូន កង រក្សា សន្តិភាព ចំនួន ៨. ៤៧៥ នាក់ ទៅ បំពេញ បេសកកម្ម មនុស្សធម៌ ជាមួយ អង្គការ សហ ប្រជាជាតិ នៅក្នុង ប្រទេស ចំនួន ៩ រួម មាន ស៊ូ ដង់ ស៊ូ ដង់ ខាងត្បូង ឆាដ លី បង់ ស៊ីរី ម៉ាលី សាធារណរដ្ឋ អាហ្វ្រិក កណ្តាល ស៊ី ប និង យេម៉ែន ។
បច្ចុប្បន្ន ប្រជាពលរដ្ឋ ខ្មែរ ជាង ៨០០ នាក់ កំពុង បំពេញ បេសកកម្ម រក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ នៅ ប្រទេស ស៊ូ ដង់ ខាងត្បូង ម៉ាលី លី បង់ និង សាធារណរដ្ឋ អាហ្វ្រិក កណ្តាល ។
ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ រៃ អង្គាស ថវិកា បាន ជាង ៨ម៉ឺន ដុល្លារ ពី កម្មវិធី សប្បុរសធម៌ ថ្ងៃទី ១៦ ខែធ្នូ នៅ ខេត្ត សៀមរាប ដែល ប្រារព្ធ ខួប លើក ទី៣០ នៃ ឧទ្យាន បុរាណវិទ្យា អង្គរ បញ្ចូល ទៅក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្ស ជាតិ របស់ អង្គការ យូណេស្កូ ។ ថវិកា ត្រូវបាន ប្រគល់ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា ។
ព្រឹត្តិការណ៍ នេះ បាន លក់ សំបុត្រ ចូលរួម កម្មវិធី អាហារ ពេលល្ងាច ផ្តាច់ មុខ នៅ ប្រាសាទ បាយ័ន ។ ភ្ញៀវ ត្រូវបាន ទទួលស្វាគមន៍ ចំពោះ ការសម្ដែង ជាច្រើន ដែល បង្ហាញ ពី សម្បត្តិ វប្បធម៌ ដ៏ សម្បូរបែប របស់ ព្រះរាជាណាចក្រ ។ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន ក្រុមការងារ អង្គការ យូណេស្កូ និង ដៃគូ អន្តរជាតិ នៃ អាជ្ញាធរ ជាតិ អប្សរា (ANA) ។
ភ្ញៀវ ដែល បាន ជួបប្រជុំគ្នា បាន ឃើញ ការសម្តែង ដោយ អនុវិទ្យាល័យ វិចិត្រ សិល្បៈ ; នាយកដ្ឋាន សិល្បៈ សម្តែង ; ក្លឹប សិល្បៈ វប្បធម៌ អ៊ុំ យូវណ្ណឌី; ក្រុមព្រះសូរិយា ; សហព័ន្ធ យុទ្ធ ក្រម ខម ; សាលា ជ័យ តិច ល្បុក្កតោ ; លក្ខិណា សមាគម ល្បុក្កតោ ; ក្រុម តន្ត្រី បុរាណ ទេព បុទុមវង្ស ; និង ក្រុម កីឡា ល្បុក្កតោ ពេជ្រ ចរណៃ ។
សិល្បករ ទាំងអស់ បាន សហការ គ្នា យ៉ាង ជិតស្និទ្ធ ដើម្បី បង្កើត កម្មវិធី មួយ ដែល ពង្រឹង ទ្រព្យសម្បត្តិ វប្បធម៌ របស់ ប្រទេសជាតិ និង រំលឹក ប្រជាជន អំពី អរិយធម៌ ខ្មែរ ដ៏ អស្ចារ្យ ។
លោក ឡុង ប៊ុណ្ណា សិរីវឌ្ឍន៍ អ្នកនាំពាក្យ ក្រសួង វប្បធម៌ បាន ថ្លែង ថា ថវិកា ដែល បាន រៃ អង្គាស បាន ត្រូវបាន ប្រគល់ ជូន មន្ទីរពេទ្យ រួចហើយ ។
នេះ ជា ព្រឹត្តិការណ៍ មួយ ។ យើង បាន រៀបចំ វា ជា ពិសេស ដើម្បី ផ្តល់ ផលប្រយោជន៍ ដល់ មន្ទីរពេទ្យ កុមារ និង ប្រារព្ធ ខួប នៃ សិលាចារឹក អង្គរ ក្នុង បញ្ជី បេតិកភណ្ឌ របស់ អង្គការ យូណេស្កូ ។
ចាប់តាំងពី ឆ្នាំ ១៩៩២ បាន បើក ដំណើរការ ឡើងវិញ មន្ទីរពេទ្យ គន្ធ បុប្ផា បាន ជួយសង្គ្រោះ ជីវិត កុមារ កម្ពុជា រាប់ លាន នាក់ ។
អាជ្ញាធរ មូលដ្ឋាន នៅ ទីនោះ បាន និយាយ ថា ទោះបីជា រដូវ វស្សា ប្រពៃណី បាន កន្លងផុត ទៅ ហើយក៏ ដោយ ប៉ុន្តែ ភ្លៀង ធ្លាក់ ខ្លាំង រយៈពេល ពីរ ថ្ងៃ បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត កំពត និង ខេត្ត ព្រះសីហនុ មាន ភ្លៀង ធ្លាក់ ខ្លាំង ។
លោក មុំ គ្រឹង នាយក ប្រតិបត្តិកាកបាទ ក្រហម កំពត បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ចាប់តាំងពី ល្ងាច ថ្ងៃទី ១៧ ខែធ្នូ មក ខ្យល់ មូសុង ឦសាន បាន បង្រ្កាប ជា ព្យុះភ្លៀង បោកបក់ មក លើ ក្រុង បូក គោ និង ស្រុក បន្ទាយមាស និង ស្រុក កំពង់ត្រា ច ខេត្ត កំពត ធ្វើឱ្យ ខូចខាត ផ្ទះ ប្រជាពលរដ្ឋ សរុប ចំនួន ១២០០ ខ្នង ។ សាលា ចំនួន ៩ និង កុដិ មួយ សម្រាប់ ព្រះសង្ឃ ។
ព្យុះ ផ្គរ រន្ទះ ថែមទាំង ត្រូវបាន គេ រាយការណ៍ ថា បាន លិច ទូក នេសាទ ចំនួន ៤ គ្រឿង ទោះបី មិន មាន អ្នកស្លាប់ ឬ របួស ធ្ងន់ធ្ងរ ក៏ដោយ ។
លោក បាន បន្ថែម ថា នៅ ពេល នេះ កម្លាំង សមត្ថកិច្ច របស់ យើង កំពុង ធ្វើ ការជួសជុល សង្គ្រោះ បន្ទាន់ ដល់ ផ្ទះ របស់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ហើយ អំណោយ ជា សម្ភារៈ សង្គ្រោះ ត្រូវបាន ផ្តល់ ជូន គ្រួសារ រងគ្រោះ ដើម្បី សម្រាល ការលំបាក ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ពួកគេ ។
លោក បាន បន្ត ថា គិត ត្រឹម រសៀល ថ្ងៃទី ១៩ ខែធ្នូ ស្ថានភាព អាកាសធាតុ ក្នុង ខេត្ត មាន ភាពស្ងប់ស្ងាត់ ប៉ុន្តែ សីតុណ្ហភាព នៅតែ ចុះ ត្រជាក់ នៅ ត្រឹម ២០ អង្សា សេ ។
ខេត្ត ព្រះសីហនុ អាជ្ញាធរ ខេត្ត បាន អំពាវនាវ ជាថ្មី ឲ្យ ប្រជាពលរដ្ឋ តាមដាន ការវិវត្ត អាកាសធាតុ ដោយ ប្រយ័ត្នប្រយែង ជាពិសេស ប្រជា នេសាទ និង អ្នក រស់ នៅក្នុង តំបន់ កោះ រ៉ុង ដែល ត្រូវបាន ស្នើ ឱ្យ ផ្អាក ការងារ និង ធ្វើដំណើរ តាម ទូក ជា បណ្តោះអាសន្ន ។
អភិបាល ក្រុង កោះ រ៉ុង លោក នួន ប៊ុន ថុល បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា នៅ ពេល នេះ ខ្យល់ កន្ត្រាក់ នៅតែ បន្ត បោកបក់ មក លើ តំបន់ មាត់ សមុទ្រ បណ្តាលឱ្យ មាន រលក ធំ ៗ ដូច្នេះ អាជ្ញាធរ បាន ចេញ សេចក្តីប្រកាស ហាមប្រាម មិន អោយ ធ្វើ នាវាចរណ៍ ក្នុង ផ្ទៃ ទឹក សម្រាប់ ប្រតិបត្តិករ ទូក ទេសចរណ៍ និង អ្នកនេសាទ ដែល ត្រូវបាន ព្រមាន ថា នៅតែ មាន ។ ប្រុងប្រយ័ត្ន ដោយសារ រលក សមុទ្រ ខ្លាំង និង រលក ធំ ៗ ។
លោក បាន បន្ថែម ថា៖ នៅ ពេល នេះ អ្នកស្រុក របស់ យើង ត្រូវបាន ស្នើ ឱ្យ បញ្ឈប់ ការធ្វើ នាវាចរណ៍ និង ការនេសាទ ហើយ ត្រូវ នៅ ផ្ទះ ដោយ សុវត្ថិភាព និង តាមដាន ព័ត៌មាន ពី ការព្យាករណ៍ អាកាសធាតុ ពី មន្ត្រី ជំនាញ ។
លោក បាន បន្ត ទៀត ថា ទោះបី មាន ភ្លៀង ផ្គរ រន្ទះ រយៈពេល ពីរ ថ្ងៃ ក៏ដោយ ក៏ ផ្ទះ របស់ ប្រជាពលរដ្ឋ នៅ ក្រុង គង រ៉ុង មិន បាន រង ផល ប៉ះពាល់ នោះ ទេ ទោះបីជា ផ្ទះ ប្រជាពលរដ្ឋ ក្នុង ស្រុក ព្រៃនប់ រាប់ ពាន់ ខ្នង ត្រូវបាន ខូចខាត ក៏ដោយ ។
លោក អ៊ី ធារិន អភិបាល ស្រុក ព្រៃនប់ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ខ្យល់ កន្ត្រាក់ រយៈពេល ២ ថ្ងៃ បាន បំផ្លាញ ផ្ទះ ប្រជាពលរដ្ឋ ជិត ២០០០ ខ្នង យ៉ាង ធ្ងន់ធ្ងរ ក្នុង ឃុំ ចំនួន ៥ គឺ ទឹក ថ្លា ទឹក ល្អក់ សាមគ្គី វាល រេញ និង សង្កាត់ ជើងឯក ប៉ុន្តែ គ្មាន ប្រជាពលរដ្ឋ ណា ម្នាក់ មាន រងរបួស ជា និរន្តរភាព ឬ មាន អាយុជីវិត ជិត ផុត ពូជ ។
លោក បាន បន្ថែម ថា៖ នៅ ពេល នេះ ព្យុះ ផ្គរ រន្ទះ បាន ស្ងប់ស្ងាត់ ហើយ មន្ត្រី ប៉ូលិស របស់ យើង កំពុង ជួយ ជួសជុល ផ្ទះ របស់ ប្រជាពលរដ្ឋ មួយចំនួន ។
ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ព្យាករណ៍ ថា ខ្យល់ មូសុង ឦសាន នឹង បន្ត មាន សកម្មភាព រហូតដល់ ចុង សប្តាហ៍ ហើយ អ្នក ដែល រស់ នៅ តាម តំបន់ មាត់ សមុទ្រ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ដោយសារ ភ្លៀង ធ្លាក់ ខ្លាំង និង ស្ថានភាព សមុទ្រ គ្រោះថ្នាក់ ។
យោង តាម ទិន្នន័យ របស់ អគ្គ ស្នងការ នគរបាល ជាតិ ស្តី ពី គ្រោះ ធម្មជាតិ ក្នុង ឆ្នាំ ២០២២ ដែល ទទួលបាន ដោយ កាសែត ភ្នំពេញ ប៉ុស្តិ៍ បាន ឲ្យដឹង ថា ក្នុង រយៈពេល មួយ ឆ្នាំ កន្លងមក នេះ ព្យុះភ្លៀង បាន បណ្តាលឲ្យ មនុស្ស ២នាក់ ស្លាប់ និង របួស ចំនួន ៤៤ នាក់ ខណៈ ភ្លើង ឆេះ បាន សម្លាប់ មនុស្ស ៦៨ នាក់ និង របួស ៣៦ នាក់ ផ្សេង ទៀត ។
ខេត្ត និង រាជធានី សរុប ចំនួន ប្រាំ ត្រូវបាន ប្រកាស ថា គ្មាន មីន គិត ត្រឹម ខែធ្នូ ដែល ជា គោលដៅ ឆ្នាំ 2025 របស់ កម្ពុជា ក្នុង ការក្លាយជា វិធីសាស្រ្ត គ្មាន មីន ។ មន្ត្រី ជាន់ ខ្ពស់ មួយ រូប បាន និយាយ ថា ព្រះរាជាណាចក្រ កម្ពុជា ឥឡូវនេះ កំពុង ស្ថិត នៅលើ ផ្លូវ ដើម្បី ប្រកាស ខេត្ត ចំនួន ប្រាំមួយ បន្ថែម ទៀត ដែល គ្មាន មីន នៅ ចុង ឆ្នាំ ក្រោយ ។
លោក លី ធុច ទេសរដ្ឋមន្ត្រី និង ជា អនុប្រធាន ទី១ នៃ អាជ្ញាធរ សកម្មភាព កម្ចាត់ មីន និង ជំនួយ ជនរងគ្រោះ ដោយសារ មីន កម្ពុជា (CMAA) បាន និយាយ នៅ ថ្ងៃទី ១៨ ខែធ្នូ ថា រាជធានី និង ខេត្ត ចំនួន ៥ រួម មាន ស្ទឹងត្រែង កែប ព្រៃវែង ព្រះសីហនុ និង ត្បូងឃ្មុំ គឺជា របស់ ខ្ញុំ ។ - ឥត គិត ថ្លៃ នៅ ពាក់កណ្តាល ខែធ្នូ ។
លោក បាន មានប្រសាសន៍ ថា អរគុណ ចំពោះ ការងារ របស់ STP-MA ដែល ដំណើរការ ក្រោម ប្រធានបទ ការផ្តល់ ដី ប្រកបដោយ សុវត្ថិភាព បង្កើត ស្នាមញញឹម ដោយ សហការ ជាមួយ ដៃគូ អភិវឌ្ឍន៍ ខេត្ត ចំនួន ប្រាំមួយ បន្ថែម ទៀត នឹង ត្រូវបាន ប្រកាស ថា គ្មាន មីន នៅ ឆ្នាំ 2023 ។ ពួកគេ គឺ ខេត្ត កំពង់ចាម ។ តាកែវ កំពង់ឆ្នាំង កំពត ស្វាយរៀង និង កណ្តាល ។
យ៉ាងណា ក៏ដោយ លោក ធុច មានប្រសាសន៍ ថា ឧបសគ្គ មួយចំនួន នៅតែ មាន នៅឡើយ ខណៈ ដែល គោលដៅ គ្មាន មីន ខិត ជិត មកដល់ ។
លោក បាន និយាយ ថា រដ្ឋាភិបាល បាន បញ្ចេញ ថវិកា ចំនួន ៣០លាន ដុល្លារ តាមរយៈ មូលនិធិ កម្ពុជា គ្មាន មីន ឆ្នាំ ២០២៥ ដើម្បី សម្រេច គោលដៅ នេះ ដោយ មាន ការគាំទ្រ បន្ថែម ពី ដៃគូ អភិវឌ្ឍន៍ ។
ក្រៅពី ខេត្ត គោលដៅ កម្ពុជា គ្រោង នឹង បោសសម្អាត មីន តាម បណ្តោយ ព្រំដែន របស់ ខ្លួន ។
ជនសង្ស័យ ជាង ១០នាក់ កំពុង ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ព្រះសីហនុ កំពុង ធ្វើ ការសាកសួរ ពាក់ព័ន្ធ ករណី គ្រឿងញៀន ខេតាមីន ជិត ៩០០ គីឡូក្រាម ដែល ត្រូវបាន រកឃើញ ក្នុង ឃ្លាំង ជួល មួយ កន្លែង ស្ថិត ក្នុង ភូមិ១ សង្កាត់ ២ ក្រុង ព្រះសីហនុ និង ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ១១ ខែធ្នូ ។
អគ្គ លេខាធិការ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន (NACD) លោក មាស វីរិទ្ធ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ១៩ ខែធ្នូ ថា អាជ្ញាធរ បាន ចាប់ខ្លួន ជាច្រើន នាក់ ។ ភស្តុតាង នៅតែ ត្រូវបាន ប្រមូល ក្នុង ករណី នេះ ប៉ុន្តែ គាត់ រំពឹង ថា នឹង មាន ការចាប់ខ្លួន បន្ថែម ទៀត នឹង តាមដាន ។
លោក បន្ត ថា៖ យើង បាន ចាប់ខ្លួន ជនសង្ស័យ ជាង ដប់ នាក់ ទៅ ឃុំឃាំង ហើយ កំពុង បន្ត កំណត់ មុខ សញ្ញា ជន ចាប់អារម្មណ៍ បន្ថែម ទៀត ។ ការស៊ើបអង្កេត របស់ យើង ត្រូវតែ មាន ភាពហ្មត់ចត់ បំផុត ព្រោះ យើង មាន ការប្រុងប្រយ័ត្ន ក្នុង ការកាត់ទោស បុគ្គល ខុស ។ ជនសង្ស័យ បច្ចុប្បន្ន ជា ជនជាតិ ខ្មែរ និង ជន បរទេស ចម្រុះ ។
លោក បាន បន្ត ថា ករណី នេះ បាន ពង្រីក លើស ពី ការរកឃើញ ដើម ខណៈ ការស៊ើបអង្កេត ជា បន្តបន្ទាប់ បាន រកឃើញ ប្រតិបត្តិការ គ្រឿងញៀន ជាច្រើន ទៀត នៅក្នុង ក្រុង ។ ដោយសារ ករណី ទាំងនេះ កំពុង បន្ត លោក មិន បាន ត្រៀម ខ្លួន ដើម្បី ចែករំលែក ព័ត៌មាន លម្អិត បន្ថែម ទៀត ទេ ។
លោក វីរិទ្ធ បាន និយាយ ថា អង្គការ ឧក្រិដ្ឋ ជន ហាក់ដូចជា កំពុង ប្រើប្រាស់ ប្រទេស កម្ពុជា ជា ចំណុច ឆ្លងកាត់ សម្រាប់ ប្រតិបត្តិការ ជួញដូរ ដែល មាន ន័យ ថា គ្រឿងញៀន ទំនងជា ត្រូវបាន ចង ភ្ជាប់ ទៅនឹង ទីតាំង ទី បី ដែល សន្មត ថា ជា ប្រទេស អភិវឌ្ឍន៍ ។
លោក ថា កងរាជអាវុធហត្ថ កម្រ រឹបអូស បាន ថ្នាំ ញៀន ក្នុង បរិមាណ ច្រើន បែប នេះ ណាស់ ដែល ជា មូលហេតុ ដែល ករណី នេះ តម្រូវ ឱ្យ មាន ការស៊ើបអង្កេត យ៉ាង ទូលំទូលាយ បែប នេះ ។ ប្រតិបត្តិការ ទំហំ នេះ ស្ទើរតែ ប្រាកដ ជាជាប់ពាក់ព័ន្ធ នឹង ការលាង លុយក ខ្វក់ ហើយ ការស៊ើបអង្កេត ពេញលេញ នឹង ត្រូវ ទាមទារ ដើម្បី ស្វែងរក មនុស្ស ដែល នៅ ពីក្រោយ វា ។
លោក បាន បន្ថែម ថា៖ ឧក្រិដ្ឋ ជន ប្រើប្រាស់ ឆ្នេរសមុទ្រ កម្ពុជា ជា មធ្យោបាយ ជួញដូរ ការនាំចេញ របស់ ខ្លួន ទៅ អន្តរជាតិ ព្រោះ ប៉ុស្តិ៍ ត្រួតពិនិត្យ និង មន្ត្រី គយ ងាយ គេច ចេញ ។
ដើម្បី ដោះស្រាយ បញ្ហា ទំហំ នេះ និង ចាក់ ឫស មនុស្ស នៅ ពីក្រោយ វា យើង កំពុង ធ្វើការ យ៉ាង ជិតស្និទ្ធ ជាមួយ សមភាគី របស់ យើង នៅក្នុង ប្រទេស ជិតខាង ។ យើង ក៏ ត្រូវ កំណត់ អត្តសញ្ញាណ គោលដៅ ដែល បាន គ្រោង ទុក នៃ ការដឹកជញ្ជូន នេះ ផងដែរ ។
ក្រោយ ការរឹបអូស បាន ថ្នាំ ខេតាមីន ដ៏ ច្រើន នៅ ខេត្ត ព្រះសីហនុ លោក ស ខេង រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន អំពាវនាវ ឱ្យ មាន ការស៊ើបអង្កេត ឱ្យ បាន ស៊ីជម្រៅ ។
ប្រសិនបើ យើង ចាប់ បាន គ្រឿងញៀន ជិត ៩០០ គីឡូក្រាម ប៉ុន្តែ មិន អាច ចាប់ អ្នក នៅ ពីក្រោយ បាន នោះ យើង មិន គួរ ចាត់ទុក បេសកកម្ម របស់ យើង ជោគជ័យ នោះ ទេ ។ អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវតែ ធ្វើ ការកំណត់ ប្រភព នៃ ថ្នាំ ញៀន និង កាត់ទោស អ្នកទទួលខុសត្រូវ ។
រដ្ឋមន្ត្រី ការបរទេស នៃ ប្រទេស អាស៊ាន ចំនួន ប្រាំ រួមទាំង ប្រទេស មីយ៉ាន់ម៉ា បាន ជួបប្រជុំគ្នា នៅ ថ្ងៃទី ២២ ខែធ្នូ ក្នុង ការពិគ្រោះយោបល់ ក្រៅ ផ្លូវការ នៅ ប្រទេស ថៃ ។ កិច្ចពិភាក្សា ត្រូវបាន ធ្វើឡើង ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង ស្វែងរក ដំណោះស្រាយ ដោយ សន្តិវិធី ចំពោះ វិបត្តិ មីយ៉ាន់ម៉ា ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ស្នើ ឡើង ដោយ រដ្ឋមន្ត្រី ក្រសួង ការបរទេស ថៃ Don Pramudwinai និង មាន ការចូលរួម ពី រដ្ឋមន្ត្រី ការបរទេស កម្ពុជា វៀតណាម និង ឡាវ បន្ថែម ពីលើ ម្ចាស់ ផ្ទះ ។ មាន វត្តមាន រដ្ឋមន្ត្រី សហភាព មីយ៉ាន់ម៉ា ដែល ទទួលបន្ទុក កិច្ចការ បរទេស និង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ការវិនិយោគ និង ទំនាក់ទំនង សេដ្ឋកិច្ច បរទេស ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ ថ្ងៃទី ២២ ខែធ្នូ ក្រសួង ការបរទេស កម្ពុជា បាន និយាយ ថា កិច្ចប្រជុំ នេះ គឺ សមស្រប នឹង ចំណុច ទី ១៤ នៃ ការពិនិត្យ ឡើងវិញ និង សេចក្តីសម្រេច របស់ មេដឹកនាំ អាស៊ាន ស្តីពី ការអនុវត្ត ការឯកភាព ៥ ចំណុច ។ វា គូសបញ្ជាក់ អំពី សារៈសំខាន់ នៃ ការស្វែងរក វិធីសាស្រ្ត ផ្សេង ទៀត ដែល អាច គាំទ្រ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង រួម របស់ អាស៊ាន ក្នុង ការជួយ មីយ៉ាន់ម៉ា នាំមក នូវ ដំណោះស្រាយ ដោយ សន្តិវិធី ចំពោះ វិបត្តិ បច្ចុប្បន្ន ។
ការពិគ្រោះយោបល់ ក្រៅ ផ្លូវការ បើកចំហ បាន ផ្តល់ ឱកាស ដ៏ ល្អ សម្រាប់ រដ្ឋមន្ត្រី និង អ្នកតំណាង ផ្សេង ទៀត ក្នុង ការពិភាក្សា ដោយ បើក ចំហ ស្មោះត្រង់ និង ប្រកបដោយ អត្ថន័យ និង ទទួលបាន ព័ត៌មាន ថ្មី ៗ ពី ប្រទេស មីយ៉ាន់ម៉ា ស្តីពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ខ្លួន ក្នុង ការអនុវត្ត ការឯកភាព ប្រាំ ចំណុច ។
ជា សំខាន់ ពួកគេ ក៏ បាន ផ្លាស់ប្តូរ ទស្សនៈ លើ វិធីសាស្រ្ត ជាក់ស្តែង ដែល អាច ពន្លឿន ការអនុវត្ត ការឯកភាព ប្រាំ ចំណុច ។ ក្រសួង បាន និយាយ ថា នេះ រួមបញ្ចូល ទាំង យុទ្ធសាស្ត្រ ចាកចេញ ដែល អាច ជួយ ឱ្យ ប្រទេស មីយ៉ាន់ម៉ា វិល មក ភាព ប្រក្រតី និង សន្តិភាព ឱ្យ បាន ឆាប់ តាម ដែល អាច ធ្វើ បាន ។
រដ្ឋមន្ត្រី ការបរទេស កម្ពុជា លោក ប្រាក់ សុខុន ក្នុង តួនាទី ជា បេសកជន ពិសេស របស់ ប្រធាន អាស៊ាន ក៏ ទទួលបាន ការកោតសរសើរ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ លោក ក្នុង ការសម្របសម្រួល ការអនុវត្ត ការឯកភាព ទាំង ប្រាំ ចំណុច ជាពិសេស ការទទូច របស់ លោក លើ ការផ្តល់ ជំនួយ មនុស្សធម៌ ដល់ អ្នក ដែល ត្រូវការ ជំនួយ បំផុត ។
ក្រសួង បាន និយាយ ថា កម្ពុជា នឹង ផ្តល់ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ដល់ ប្រធាន អាស៊ាន ដែល ចូលមក ប្រទេស ឥណ្ឌូនេស៊ី និង បេសកជន ពិសេស របស់ ខ្លួន ក្នុង ការជួយ មីយ៉ាន់ម៉ា ស្វែងរក ដំណោះស្រាយ នយោបាយ ដោយ សន្តិវិធី និង ត្រលប់ ទៅ មាគ៌ា ប្រជាធិបតេយ្យ ដើម្បី ផលប្រយោជន៍ ប្រជាជន និង អាស៊ាន ទាំងមូល ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន ព្រមាន ថា ជន ណា ដែល ចោទ គណបក្ស ប្រជាជន កម្ពុជា ពី បទ លួច សន្លឹក ឆ្នោត នឹង ប្រឈមមុខ នឹង វិធានការ ផ្លូវ ច្បាប់ ព្រោះ លោក មាន បំណង លុបបំបាត់ នូវ អ្វី ដែល ជា និន្នាការទូទៅ នៃ ការចោទប្រកាន់ ដែល ធ្វើឡើង ក្រោយ ការបោះឆ្នោត នីមួយ ៗ ។
ការព្រមាន នេះ ធ្វើឡើង បន្ទាប់ពី លោក សម រង្ស៊ី អតីត ប្រធាន គណបក្ស សង្រ្គោះ ជាតិ និង លោក សុន ឆ័យ ប្រធាន គណបក្ស ភ្លើង ទៀន លើកឡើង ពី ការទិញ - លក់ សន្លឹក ឆ្នោត និង ការក្លែងបន្លំ សន្លឹក ឆ្នោត ។
ក្នុង ពិធី សម្ពោធ ផ្លូវ ថ្មី ចំនួន 2 ខ្សែ ក្នុង ខេត្ត ព្រះសីហនុ កាលពី ថ្ងៃទី 22 ខែធ្នូ លោក ហ៊ុន សែន បាន មានប្រសាសន៍ ថា គណបក្ស ប្រជាជន កម្ពុជា ត្រូវបាន ចោទប្រកាន់ ថា បាន លួច សន្លឹក ឆ្នោត បន្ទាប់ពី ការបោះឆ្នោត ម្តង ៗ ដែល ប្រថុយ នឹង ការលើក ស្លាក គណបក្ស របស់ លោក ថា ជា ចោរ ។
លោក បាន បន្ថែម ថា ដើម្បី បញ្ចប់ ការចោទប្រកាន់ ដ៏ នឿយហត់ ទាំងនេះ ដែល ធ្វើឡើង តាម ការបោះឆ្នោត ម្តង ៗ ចាំបាច់ ត្រូវ ប្តឹង ជន ណា ដែល ដាក់ ការចោទប្រកាន់ ទាំងនេះ មក លើ គណបក្ស ប្រជាជន ។
បើ មិន ដូច្នេះ ទេ យើង នឹង ត្រូវ គេ ដាក់ ឈ្មោះ ថា ជា ចោរ រហូត ។ បើ យើង ចោទប្រកាន់ ខុស ជនល្មើស ត្រូវ សង ការខូចខាត ។ តាម របៀប នេះ យើង នឹង លុបចោល ការសម្តែង ដដែល ៗ ទាំងនេះ ពី វប្បធម៌ របស់ បក្ស ប្រឆាំង ។
ឧទាហរណ៍ បន្ទាប់ពី ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ថ្ងៃទី ៥ ខែមិថុនា បាន បញ្ចប់ នៅ ម៉ោង ៣រសៀល ការរាប់ សន្លឹក ឆ្នោត បាន ចាប់ផ្តើម ។ គណបក្ស ពាក់ព័ន្ធ ទាំងអស់ បាន រាប់ សន្លឹក ឆ្នោត ជាមួយគ្នា ប៉ុន្តែ បុគ្គល មួយចំនួន នៅតែ ចោទប្រកាន់ គណបក្ស ប្រជាជន ថា បាន លួច សន្លឹក ឆ្នោត ។
លោក មិន បាន លើកឡើង ពី ឈ្មោះ អ្នក ចោទ នោះ ទេ ប៉ុន្តែ ទំនងជា ចង់ សំដៅ លើ លោក សុន ឆ័យ អនុប្រធាន គណបក្ស ពន្លឺ ភ្លើង ដែល ចោទ ថា ការបោះឆ្នោត ត្រូវបាន គេ លួច បន្លំ ខណៈ ចូលរួម សម្ភាសន៍ តាម វិទ្យុ ។
លោក គី តិច មេធាវី គណបក្ស ប្រជាជន កម្ពុជា និង គណៈកម្មាធិការ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន លើក យក សំណុំរឿង បរិហារ កេរ្តិ៍ លោក សុន ឆ័យ តាមរយៈ តុលាការ ក្រុង ភ្នំពេញ ។ តុលាការ បាន ប្រកាស សាលក្រម ពីរ លើក ម្តង ទៀត នៅ ថ្ងៃទី៧ តុលា ។ លោក បាន ប្តឹង ឧទ្ធរណ៍ ទៅ សាលាឧទ្ធរណ៍ រាជធានី ភ្នំពេញ ដែល តម្កល់ ការសម្រេច របស់ សាលាដំបូង រាជធានី ភ្នំពេញ ។
អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា លោក សុខ ឥសាន យល់ស្រប នឹង ការលើកឡើង របស់ លោក ហ៊ុន សែន ដោយ ថា ប្រសិនបើ រកឃើញ ភាព មិន ប្រក្រតី ក្នុង ដំណើរការបោះឆ្នោត គ.ជ. ប តំណាង គណបក្ស និង សកម្មជន នយោបាយ ទាំងអស់ មាន សិទ្ធិ ប្តឹង តវ៉ា ដែល នឹង ដោះស្រាយ បញ្ហា នេះ ។
ការប្រកាស ថា ការបោះឆ្នោត នេះ មាន ការក្លែងបន្លំ ឬ ថា គណបក្ស ប្រជាជន កម្ពុជា បាន លួច សន្លឹក ឆ្នោត ជា ការជួយ ដល់ ការរីកចម្រើន លទ្ធិ ប្រជាធិបតេយ្យ របស់ ប្រទេស កម្ពុជា ។
នេះ មិន មែន ជា ការអនុវត្ត សិទ្ធិ បញ្ចេញមតិ ដោយ សេរី ទេ ។ វា បង្កាច់បង្ខូច យើង និង បង្ខូច កិត្តិយស គណបក្ស របស់ យើង ដែល ជា ការប្រមាថ ។
លោក Eysan បាន អំពាវនាវ ដល់ អ្នករិះគន់ នា ពេល អនាគត ឱ្យ ពិនិត្យ ឡើងវិញ នូវ រដ្ឋធម្មនុញ្ញ មុនពេល បញ្ចេញមតិ របស់ ពួកគេ ក្នុង ករណី ដែល ប៉ះពាល់ ដល់ សិទ្ធិ អ្នកដទៃ សណ្តាប់ធ្នាប់ សាធារណៈ ឬ ស្ថិរភាព នយោបាយ នៃ ព្រះរាជាណាចក្រ ។
អ្នកនាំពាក្យ គណបក្ស ភ្លើង ទៀន លោក ថាច់ សេដ្ឋា មានប្រសាសន៍ ថា ការពិត គឺ ថា ភាពត្រឹមត្រូវ នៃ ការបោះឆ្នោត អាច ឈរ លើ តម្លាភាព របស់ ពួកគេ មិន មែន ជា ការយល់ឃើញ របស់ បុគ្គល ណា ម្នាក់ នោះ ទេ ។
ជាធម្មតា នៅក្នុង សង្គម ប្រជាធិបតេយ្យ ប្រជាពលរដ្ឋ គ្រប់ រូប មាន សិទ្ធិ លើកឡើង ឬ បញ្ចេញមតិ របស់ ខ្លួន នៅ ពេល ដែល ពួកគេ មិន សប្បាយ ចិត្ត ឬ មិន ពេញចិត្ត ។ នេះ មិន មែន ជា រឿង ធម្មតា ទេ ។
ប្រសិនបើ បណ្ដឹង របស់ លោក សុន ឆ័យ ត្រូវបាន រៀបចំឡើង ដើម្បី លុបបំបាត់ វប្បធម៌ នៃ ការបង្កាច់បង្ខូច ក្រោយ ការបោះឆ្នោត នោះ មិន ចាំបាច់ ប្តឹង ទាមទារ សំណង ជំងឺ ចិត្ត ចំនួន ១ លាន ដុល្លារ នោះ ទេ ។ វា មិន មែន ជា ការបង្កាច់បង្ខូច ឡើយ យើង អ្នកនយោបាយ តែងតែ បញ្ចេញ វោហារ សាស្ត្រ អំពី ភាព មិន ប្រក្រតី ណាមួយ ដែល យើង មិន ពេញចិត្ត ។
អគ្គ លេខាធិការ រាជ បណ្ឌិត្យ សភា កម្ពុជា លោក យ៉ង ពៅ យល់ ថា លោក ហ៊ុន សែន គ្រាន់តែ ការពារ តំណែង ឈ្នះ ៗ របស់ គណបក្ស លោក ប៉ុណ្ណោះ ។
នេះ ជា មេរៀន មួយ សម្រាប់ អ្នកនយោបាយ និង សកម្មជន ដទៃ ទៀត ។ មុននឹង រិះគន់ អ្នកណា ម្នាក់ យើង គួរ គិត ឱ្យ បាន ហ្មត់ចត់ អំពី ច្បាប់ និង ថា តើ យើង កំពុង ដើរ ចេញពី សេរីភាព នៃ ការបញ្ចេញមតិ របស់ យើង ឬ អត់ ។ បើ យើង ល្មើស ច្បាប់ យើង នឹង ត្រូវ ទទួលទោស តាម ច្បាប់ ហើយ នេះ ជា ការពិត សម្រាប់ យើង ទាំងអស់ គ្នា ។
លោក បន្ត ថា វា ជា ការប្រសើរ ក្នុង ការប្រើ យន្តការ នយោបាយ ផ្លូវ ច្បាប់ ដើម្បី ព្យាយាម ប៉ះពាល់ ដល់ ការផ្លាស់ប្តូរ ជាជាង ការប្រើ វោហារ សាស្ត្រ និង សកម្មភាព នយោបាយ បែប ហិង្សា ដូចជា ការប្រមូលផ្តុំ បាតុករ ដែល បង្កើត ភាពចលាចល ក្នុង សង្គម និង អាច ឈានដល់ បដិវត្តន៍ ពណ៌ ។
លោក ឯ ម សុវណ្ណារ៉ា សាស្ត្រាចារ្យ វិទ្យាសាស្ត្រ នយោបាយ និង ជា អ្នកវិភាគ មានប្រសាសន៍ ថា ដើម្បី កាត់បន្ថយ ឬ លុបបំបាត់ ចំនួន ប្រជាពលរដ្ឋ ដែល ជំទាស់ នឹង លទ្ធផល បោះឆ្នោត គ.ជ. ប ត្រូវ ធានា ថា ដំណើរការ ប្រព្រឹត្តទៅ ដោយ សេរី យុត្តិធម៌ និង តម្លាភាព ។ នេះ នឹង ធានា ដល់ ការបោះឆ្នោត គួរឱ្យ ទុកចិត្ត ។
ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ២៣ ខែធ្នូ នេះ បាន រាយការណ៍ ករណី វិជ្ជមាន កូវីដ១៩ ថ្មី ចំនួន ១៧ សហគមន៍ និង ជាសះស្បើយ ថ្មី ចំនួន ២២ នាក់ ។
ក្រសួង អប់រំ យុវជន និង កីឡា បាន ប្រកាស លទ្ធផល ប្រឡង បាក់ឌុប ឆ្នាំ នេះ ។ បេក្ខជន ជាង ៧០ ភាគរយ បាន ប្រឡង ជាប់ ហើយ ជាង ១០០០ នាក់ ក្នុង ចំណោម ពួកគេ បាន ជាប់ និទ្ទេស A ។
អ្នកនាំពាក្យ ក្រសួង លោក រស់ សុវាចា មានប្រសាសន៍ ថា សិស្ស ប្រឡង ជាប់ ចំនួន ៩០. ៩៥០ នាក់ ស្មើនឹង ៧២. ៣៣ ភាគរយ នៃ ចំនួន បេក្ខជន សរុប ។
លោក ឱម យ៉ិនទៀង ប្រធាន អង្គភាព ប្រឆាំង អំពើពុករលួយ បាន មានប្រសាសន៍ ក្នុង បទសម្ភាសន៍ ថា ដំណើរការប្រឡង ឆ្នាំ នេះ ប្រព្រឹត្តទៅ ដោយ រលូន ដែល គួរឲ្យ សរសើរ ។
លោក បាន បន្ថែម ថា ខ្ញុំ សូម សរសើរ និង ថ្លែងអំណរគុណ ដល់ ក្រសួង ស្ថាប័ន និង មន្ត្រី ពាក់ព័ន្ធ ទាំងអស់ ដែល ធានា ដំណើរការប្រឡង ឆ្នាំ នេះ ប្រព្រឹត្តទៅ បាន ល្អ ។
លោក រ៉ុង ឈុន ទីប្រឹក្សា សមាគម គ្រូបង្រៀន កម្ពុជា ឯករាជ្យ (CITA) មានប្រសាសន៍ ថា ប្រសិនបើ យើង ពិនិត្យមើល ទិន្នន័យ កាលពី ឆ្នាំ មុន អត្រា ប្រឡង ជាប់ សរុប គឺ ស្រដៀង គ្នា ខ្លាំង ណាស់ ។
វា ពិបាក ក្នុង ការប្រៀបធៀប ការប្រឡង ជាមួយនឹង ឆ្នាំ មុន ៗ ។ ការប្រឡង ឆ្នាំ នេះ មាន មុខវិជ្ជា ច្រើន ជាង ហើយ ដូច្នេះ ពិបាក ជាង ។
លោក ក៏ បាន និយាយ ដែរ ថា នេះ មាន ន័យ ថា មុខវិជ្ជា បន្ថែម ទៀត ត្រូវការវាយតម្លៃ ។
លោក បាន ថ្លែង ថា៖ ការប្រឡង ឆ្នាំ នេះ បាន រៀបចំ យ៉ាង ល្អ និង ប្រព្រឹត្តទៅ ដោយ រលូន ដោយ មិន មាន ការលួច ចម្លង ឬ ក្លែងបន្លំ ។
ខ្ញុំ ក៏ សូម ថ្លែងអំណរគុណ ចំពោះ លោកគ្រូ អ្នកគ្រូ របស់ ប្រទេសជាតិ សម្រាប់ ការខិតខំ ប្រឹងប្រែង របស់ ពួកគេ ក្នុង ការជួយ សិស្ស ឱ្យ ទទួលបាន លទ្ធផល ល្អ ប្រសើរ ។ ខ្ញុំ ក៏ សូម អរគុណ ដល់ គណៈកម្មការ ប្រឡង និង អាជ្ញាធរ មូលដ្ឋាន ទូទាំង ប្រទេស ដែល បាន យកចិត្តទុកដាក់ យ៉ាង យកចិត្តទុកដាក់ ក្នុង ការរៀបចំ ការប្រឡង ដោយ ជោគជ័យ ។
ខណៈពេល ដែល ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ (UNSC) បាន អនុម័ត ដំណោះស្រាយ ជំរុញ ឱ្យ បញ្ចប់ អំពើហិង្សា និង ការដោះលែង អ្នកទោស នយោបាយ ក្នុង ប្រទេស មីយ៉ាន់ម៉ា រដ្ឋមន្ត្រី ការបរទេស កម្ពុជា លោក ប្រាក់ សុខុន បាន ធ្វើដំណើរ ទៅកាន់ ប្រទេស ថៃ សម្រាប់ " ការពិគ្រោះយោបល់ ក្រៅ ផ្លូវការ " ដែល ធ្វើឡើង ដើម្បី ពន្លឿន ការអនុវត្ត អាស៊ាន ប្រាំ ចំណុច ។ ការយល់ស្រប (5PC) ។
ក្រសួង បាន និយាយ ថា " ក្នុង អំឡុង ពេល នៃ ការពិគ្រោះយោបល់ អ្នកចូលរួម រំពឹង ថា នឹង ចូលរួម ក្នុង ការពិភាក្សា ដោយ ស្មោះត្រង់ និង ច្បាស់លាស់ អំពី របៀប បង្កើន ល្បឿន នៃ ដំណើរការ នៃ ការអនុវត្ត 5PC" ។
លោក Thong Mengdavid អ្នកស្រាវជ្រាវ នៃ មជ្ឈមណ្ឌល មេគង្គ សម្រាប់ ការសិក្សា យុទ្ធសាស្ត្រ នៃ វិទ្យាស្ថាន ចក្ខុវិស័យ អាស៊ី បាន និយាយ ថា ប្រទេស កម្ពុជា បាន ទទួល ការជឿទុកចិត្ត ពី អាជ្ញាធរ ដែល កំពុង កាន់អំណាច របស់ ប្រទេស មីយ៉ាន់ម៉ា ។ ប្រការ នេះ បាន អនុញ្ញាតឱ្យ លោក សុខុន ធ្វើ ទស្សនកិច្ច នៅ ប្រទេស នេះ ពីរ ដង រួច មកហើយ ដោយ 5PC ត្រូវបាន ពិភាក្សា ជាមួយ មេដឹកនាំ នៃ ក្រុមប្រឹក្សា រដ្ឋបាល រដ្ឋ ដែល កំពុង កាន់អំណាច របស់ ប្រទេស មីយ៉ាន់ម៉ា (SAC) ។
ទោះ យ៉ាងណា លោក ម៉េង ដាវីត កត់សម្គាល់ ថា ការខិតខំ ស្វែងរក សន្តិភាព មិន បាន ប្រព្រឹត្តទៅ ដោយ រលូន នោះ ទេ ។ លោក រំពឹង ថា ការធ្វើដំណើរ ទៅ ទីក្រុង បាងកក របស់ លោក សុខុន នឹង បង្កើត មូលដ្ឋានគ្រឹះ សម្រាប់ ប្រធាន អាស៊ាន ឆ្នាំ ក្រោយ របស់ ឥណ្ឌូនេស៊ី ដើម្បី ពង្រីក ខ្លួន ។
កិច្ចប្រជុំ ក្រៅ ផ្លូវការ គឺជា យន្តការ ដ៏ ល្អ មួយ សម្រាប់ ពិភាក្សា អំពី បញ្ហា នេះ ដោយ ផ្ទាល់ បើក ចំហ និង ជិតស្និទ្ធ ។ វា ក៏ នឹង ជួយ បញ្ចៀស ស្ថានការណ៍ តានតឹង ជាមួយ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន ផ្សេង ទៀត ផងដែរ ដោយ បន្ថែម ថា បញ្ហា មីយ៉ាន់ម៉ា មាន ភាពស្មុគ្រស្មាញ ដោយសារ កត្តា ប្រវត្តិសាស្ត្រ វប្បធម៌ និង សាសនា ក៏ ដូចជា ការជ្រៀត ជ្រែក ពី មហា អំណាច ខាងក្រៅ ។
លោក គិន ភា នាយក វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន មានប្រសាសន៍ ថា កិច្ចប្រជុំ ក្រៅ ផ្លូវការ នៅ ទីក្រុង បាងកក គឺជា ឱកាស មួយ ដើម្បី ចែករំលែក អនុសាសន៍ ស្តីពី ការអនុវត្ត 5PC ប៉ុន្តែ គ្មាន អ្វី ទៀត ទេ ។
លោក បាន និយាយ ថា វា នឹង មិន នាំ ទៅ រក ដំណោះស្រាយ ភ្លាម ៗ ណាមួយ សម្រាប់ មីយ៉ាន់ម៉ា ទេ ហើយ សមាជិក មួយចំនួន នៃ ប្លុក អាស៊ាន នឹង អវត្តមាន ។
