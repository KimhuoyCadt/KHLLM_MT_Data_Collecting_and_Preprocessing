( បាត់ដំបង ) ៖ មេបញ្ជាការ កងកម្លាំងប្រដាប់អាវុធ របស់ ថៃ ដែល នៅជាប់ ច្រកទ្វារ អន្តរជាតិ ដូង ក្នុង ខេត្ត បាត់ដំបង បាន អញ្ជើញ ចូលរួម ហូប អំបុក ជាមួយ កងកម្លាំង និង អាជ្ញាធរ របស់ កម្ពុជា ស្ថិត នៅ ច្រកទ្វារ អន្តរជាតិ ដូង ដោយ មាន ភាព ក្តីរីករាយ និង សហការ យ៉ាង ល្អ លើ ការរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ តាម ព្រំដែន នៃ ប្រទេស ទាំង២ ។
ជាមួយគ្នា នេះ មន្ត្រី ជាន់ ខ្ពស់ អគ្គ ស្នងការដ្ឋាន គនគរបាល ជាតិ ក៏ បាន ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ រសៀល ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ថា កម្លាំង សមត្ថកិច្ច បាន និង កំពុង ដាក់ពង្រាយ ទូទាំង ប្រទេស ពិសេស នៅ តាម ព្រំដែន កម្ពុជា - ថៃ យ៉ាង តឹងរ៉ឹង និង ម៉ឺងម៉ាត់ បំផុត ដើម្បី ត្រៀម ចាប់ខ្លួន មេ ឧទ្ទាម សម រង្ស៉ី ដែល ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ និង អ្នក រួម គំនត់ ក្បត់ តាម ដីការ របស់ តុលាការ ខណៈ ស្ថានភាព តាម ក្រវ៉ាត់ ព្រំដែន នៅ វេលា ម៉ោង ៥ល្ងាច នេះ មាន សភាពការណ៍ យ៉ាង ល្អ ។
មន្ត្រី ជាន់ ខ្ពស់ ដដែល រូប នេះ បាន អះអាង ទៀត ថា ទន្ទឹមនឹង សមត្ថកិច្ច ថៃ ទាំង ប៉ូលិស និង យោធា ក៏ បាន សហការ យ៉ាង ល្អ ជាមួយ កម្ពុជា ដើម្បី ចាត់ វិធានការលើ ក្រុម ដែល ប្រើប្រាស់ ទឹកដី ថៃ មក ផ្តួលរំលំ រាជ រដ្ឋាភិបាល កម្ពុជា ។
មន្រ្ដី ជាន់ ខ្ពស់ ដដែល រូប នោះ បាន បញ្ជាក់ ទៀត ថា បន្ទាប់ពី បរាជ័យ ក្នុង ផែនការ ចង់ ផ្ដួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ពីសំណាក់ ក្រុម ឧទ្ទាម សម រង្ស៉ី នោះ នៅ ថ្ងៃ នេះ សមាជិក ដែល មាន បំណង ចូលរួម ជាមួយ ក្រុម ឧទ្ទាម បាន នាំគ្នា ចូលមក សារភាព កំហុស កាន់តែ ច្រើន ។ ដោយឡែក ចំពោះ ក្រុម ទេសចរ បាតុករ ដែល បាន ធ្វើដំណើរ មក ចាំ ទទួល មេដឹកនាំ ក្រុម ឧទ្ទាម នៅ តាម ព្រំដែន ក៏ បាន វិលត្រឡប់ ជា បណ្ដើរ ៗ វិញ ហើយ ៕
( ភ្នំពេញ ) ៖ នៅ រាត្រី ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ មាន បងប្អូន ប្រជាពលរដ្ឋ អញ្ជើញ ចូលរួម យ៉ាង ច្រើន កុះករ ដើម្បី ទស្សនាការ បាញ់ កាំជ្រួច ចម្រុះ ពណ៌ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ នៅ ខាងមុខ ព្រះបរម រាជ វាំង ដើម្បី អបអរសាទរ ក្នុង ព្រះរាជ ពិធី បុណ្យ ឯករាជ្យ ជាតិ និង ខួប លើក ទី៦៦ នៃ ការបង្កើត កងយោធពល ខេមរភូមិន្ទ ។
សូម បញ្ជាក់ ថា នា ល្ងាច នេះ តាម បណ្តោយ សួនច្បារ មាត់ ទន្លេ គិត ចាប់ពី មុខ ផ្សារ រាត្រី រហូតដល់ កំពង់ចម្លង ភ្នំពេញ - អរី យក្សត្រ និង ព្រះបរម រាជ វាំង ក៏ ដូចជា សួនច្បារ នានា ក្នុង មូលដ្ឋាន ខណ្ឌ ដូនពេញ ឃើញ ថា មាន បងប្អូន ប្រជាពលរដ្ឋ ប្រមាណ ជាង ១០ម៉ឺន នាក់ បាន ចូលរួម ទស្សនា និង លេង កម្សាន្ត យ៉ាង សប្បាយរីករាយ និង ទឹកមុខ ស្រស់ ញញឹម ក្នុង ព្រះរាជ ពិធី បុណ្យ ឯករាជ្យ ជាតិ នេះ ។
ទន្ទឹម គ្នា នេះ រដ្ឋបាល ខណ្ឌ ដូនពេញ សូម ជម្រាប ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល អញ្ជើញ មក លេង កម្សាន្ត នា ពេលនេះ សូម មេត្តា រក្សាទុក សំរាម នៅក្នុង ធុង សំរាម ឲ្យបាន ត្រឹមត្រូវ ជៀសវាង កាចោល សំរាម ពាសវាលពាសកាល ដែល ធ្វើឱ្យ បាត់បង់ សោភ័ណភាព នៅក្នុង ទីក្រុង ៕ ទស្សនា បណ្តុំ រូបភាព ស្តែង ពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ (Photo inside)
( ពិភពលោក ) ៖ នៅ ថ្ងៃសៅរ៍ ទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ ស្ថានការណ៍ ទូទាំង សកលលោក និង រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ផ្សេង ៗ ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ ក្រៅពី ការពង្រឹង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម មូលដ្ឋាន ពិសេស ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ យប់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នេះ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ឯក អ៉ិន បូរ៉ា អគ្គ ស្នងការ រង នគរបាល ជាតិ និង លោក ឧត្តមសេនីយ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ព្រមទាំង មាន ការចូលរួម ពី កងកម្លាំង ក្នុង នាយកដ្ឋាន ជាច្រើន រូប ទៀត ផងដែរ ។
ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ ដឹកនាំ រៀបចំ ពិធី ពិសា អំបុក សាមគ្គី ជាមួយ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ខណ្ឌ ឫស្សីកែវ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស បាន អញ្ជើញ ចូលរួម ពិធី ពិសា អំបុក សាមគ្គី ជាមួយ ពុក ម៉ែ បងប្អូន ប្រជាពលរដ្ឋ នៅ ភូមិ ៤ សង្កាត់ ច្រាំង ចំរេះទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ដែល មាន ការចូលរួម សំណាក់ អាជ្ញាធរ មូលដ្ឋាន និង បងប្អូន ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
គួរ ជម្រាប ថា ទិវា ពិសារ អំបុក នេះ ស្រប ពេល ជាមួយនឹង ខួប អនុស្សាវរីយ៍ លើក ទី ៦៦ នៃ ទិវា ឯករាជ្យ ជាតិ ដែល កម្ពុជា ដណ្ដើម បាន ពី បារាំង នៅ ឆ្នាំ ១៩៥៣ និង ចំពេល ខួប លើក ទី៦៦ នៃ ការបង្កើត កងយោធពល ខេមរភូមិន្ទ ដូចគ្នា ហើយក៏ ចំ ពេល ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃស្អែក នេះ ។
ពិធី ពិសា អំបុក សាមគ្គី នេះ ទៀតសោត ក៏ ជា ទិវា មួយ ជំនួស ឲ្យ ដំណឹង ដ៏ អកុសល របស់ ក្រុម ប្រឆាំង ក្រៅ ច្បាប់ ដែល មាន បំណង បង្ក ចលាចល បង្ក អសន្តិសុខ អស្ថេរភាព និង ចង់ បំផ្លាញ សុខ សន្តិភាព នៅ កម្ពុជា ផងដែរ ដែល ពិធី នេះ សម្ដេច តេជោ ហ៊ុន សែន បាន ឲ្យ ឈ្មោះ ថា អំបុក ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ៕ សមាជិក ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខេត្ត ត្បូងឃ្មុំ រៀបចំ ពិធី ពិសារ អំបុក ជាមួយ ពលរដ្ឋ ខ្មែរ មូស្លីម ជាង ៤០០ នាក់ យ៉ាង រីករាយ
( ត្បូងឃ្មុំ ) ៖ លោក លី វាសនា និង លោកស្រី ដាតុ ម៉ាន ម៉ារីយ៉ាន សមាជិក ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខេត្ត ត្បូងឃ្មុំ និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ឃុំ គរ បាន រៀបចំ ពិធី អបអរសាទរ ខួប ឯករាជ្យ ជាតិ លើក ទី៦៦ និង ពិធី ពិសារ អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នា ថ្ងៃទី ៩ ខែវិច្ឆិកា នេះ ។
ក្នុង ពិធី យ៉ាង ឱឡារឹក នេះ ក៏ មាន ការចូលរួម ពី សមាជិក ព្រមទាំង ក្រុមប្រឹក្សា ស្រុក ត្បូងឃ្មុំ លោកស្រី មេឃុំ គរ លោក លោកស្រី ក្រុមប្រឹក្សា ឃុំ ហាកឹម តួន លោក នាយក លោកគ្រូ អ្នកគ្រូ ក្រុម យុវជន ប្រជាការពារ ភូមិ និង បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ មូស្លីម ក្នុង ភូមិ បាន ចូលរួម ជាង ៤០០ នាក់ ផងដែរ ។
នា ឱកាស នោះ លោក លី វាសនា និង លោកស្រី ដាតុ ម៉ាន ម៉ារីយ៉ាន បាន ណែនាំ និង ផ្តាំផ្ញើ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មក ចូលរួម កុំ ឲ្យ ចាញ់ ឧបាយកល ទុច្ចរិត មហា ពិស ពុល ក្រឡិច ក្រឡុច របស់ ទណ្ឌិត សម រង្ស៊ី ឲ្យ សោះ ព្រោះ ជន នេះ ជា មនុស្ស គ្រោះថ្នាក់ បំផុត សំរាប់ ប្រជាជាតិ និង ប្រជាជន យើង យើង ហើយ ជន ឧក្រិដ្ឋ ម្នាក់ នេះ នឹង នាំមក នូវ ភាពវឹកវរ ដល់ សង្គមជាតិ យើង និង នាំ ដល់ ការបែកបាក់ ជាតិ ក៏ អាច ថា បាន ដែរ ។
ទន្ទឹមនឹង សារ នេះ លោក ទាំង២ ក៏ បាន លើកឡើង ពី ស្នាដៃ ល្អ ឯក របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ដឹកនាំ ប្រទេសជាតិ ពី បាត ដៃ ទទេ រហូតដល់ មាន ការអភិវឌ្ឍន៍ ប្រទេសជាតិ រីកចំរើន មាន សុខ សុវត្ថិភាព សន្តិភាព ស្ថេរភាព សេដ្ឋកិច្ច មាន ការលូតលាស់ មាន មុខមាត់ លើ ឆាក អន្តរជាតិ ពិសេស គឺ គោល នយោបាយ សុខដុមនីយកម្ម សាសនា ដ៏ ល្អ ប្រសើរ ផងដែរ ៕
កម្លាំង នគរបាល ប៉ុស្ដិ៍ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ត្រពាំង ស្រែ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ
( ក្រចេះ ) ៖ កងកម្លាំង នគរបាល ប៉ុស្ដិ៍ ច្រកទ្វារ អន្ដរជាតិ ត្រពាំង ស្រែ ស្ថិត ក្នុង ខេត្ត ក្រចេះ នៅ យប់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
( អូស្ត្រាលី - នូវ៉ែលហ្សេឡង់ ) ៖ នៅ ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ និង និស្សិត ខ្មែរ ជាច្រើន កុះករ ដែល កំពុង រស់ នៅ និង សិក្សា នៅ ទីក្រុង នានា នៃ ប្រទេស អូស្រ្តាលី និង នូវ៉ែលហ្សេឡង់ បាន ជួបជុំ អបអរសាទរ ខួប លើ ទី ៦៦ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា និង ហូប អំបុក តេជោ សន្តិភាព ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ទាំង រួម មាន នៅ ប្រទេស អូស្ត្រាលី៖ ទីក្រុង កង់ បេរ៉ា ទីក្រុង ម៉ែល ប៊ន ទីក្រុង ស៊ីដនី ទីក្រុង អាឌឺឡែត ទីក្រុង ប្រីស ស្បែន ទីក្រុង ដាវីន ទីក្រុង ភឺត និង នៅ ប្រទេស នូវែលហ្សេឡង់ រួម មាន ទីក្រុង អូក្លិន ទីក្រុង ហាមិល តុន ទីក្រុង វែល្លីង តុន ទីក្រុង ផាមើ ស្តុនណត៍ ទីក្រុង ក្រៃឈឺច ។
ក្នុង ឱកាស ដ៏ សប្បាយរីករាយ នេះ បងប្អូន ទាំងអស់ បាន អំពាវនាវ និង ប្រកាស ថា៖
* ការហូប អំបុក ៩ វិច្ឆិកា ដើម្បី ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
* ទណ្ឌិត សម រង្សី និង បក្សពួក មិន បាន ផ្តល់ ផលប្រយោជន៍ អ្វី ទេ ដល់ ប្រទេសជាតិ មាន តែ ការញុះញង់ ឱ្យ ប្រជាជន ឈ្លោះគ្នា បំបែកបំបាក់ សាមគ្គីភាព ប្រជាជន ព្រមទាំង បង្ក ភាពវឹកវរ ចលាច ល និង គ្រោះថ្នាក់ ដល់ សង្គមជាតិ ។
* ប្រឆាំង ដាច់ខាត ចំពោះ ក្រុម ឧទ្ទាម សម រង្សី ដែល ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ផ្តួល រំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ និង របប រាជានិយម នៅ ថ្ងៃទី ០៩ វិច្ឆិកា ក្នុង គោលបំណង បំផ្លិចបំផ្លាញ សន្តិសុខ ជាតិ ភាព សុខដុមរមនា របស់ ប្រជាជន ក៏ ដូចជា ការអភិវឌ្ឍ ជាតិ ។
* សំណូមពរ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច ពាក់ព័ន្ធ ចាត់ វិធាន ផ្លូវ តាម ច្បាប់ ឱ្យ បាន តឹងរ៉ឹង ចំពោះ ទង្វើ ខុស ច្បាប់ ដ៏ ធ្ងន់ធ្ងរ របស់ លោក សម រង្សី និង បក្សពួក ។
* សូម គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការដឹកនាំ ប្រទេសជាតិ ឆ្ពោះ ទៅរក ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ និង ភាពរុងរឿង ថ្កុំថ្កើង សម្បូរសប្បាយ របស់ ប្រជាជន ៕ តំណាង រដ្ឋមន្រ្តី ថោង ខុន រៀបចំ ពិធី ទទួលទាន អំបុក ខ្មែរ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ វត្ត ត្នោត ជុំ. ប្រជាពលរដ្ឋ ប្តេជ្ញា សាមគ្គី ចូលរួម ថែរក្សា សន្តិភាព
កម្មវិធី នេះ មាន ការចូលរួម ពី ព្រះសង្ឃ សហការី បងប្អូន ប្រជាពលរដ្ឋ យុវជន និង សិស្សានុសិស្ស សរុប ប្រមាណ ១០០០ នាក់ ខណៈ ដែល ពិធី នេះ ក៏ បាន រៀបចំ នៅ តាម បណ្តា ភូមិ នានា ក្នុង ឃុំ ត្នោត ជុំ ផងដែរ ។
ក្នុង ពិធី ជួបជុំ ដ៏ ច្រើន កុះករ និង សប្បាយរីករាយ នេះ ប្រជាពលរដ្ឋ បាន ប្តេជ្ញា សាមគ្គី ចូលរួម ថែរក្សា សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង ប្រឆាំង ដាច់ខាត នឹង ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រដ្ឋាភិបាល ស្រប ច្បាប់ ក្រោម ការដឹកនាំ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នា រសៀល ថ្ងៃ ដដែល លោក ប្រធាន ក្រុមការងារ និង លោកស្រី បាន នាំយក ម៉ាស៊ីនភ្លើង មួយ គ្រឿង ប្រគេន ដល់ ព្រះសង្ឃ សម្រាប់ ប្រើប្រាស់ ក្នុង វត្ត សេរី សោភណ្ឌ ស្ថិត នៅក្នុង ភូមិ ព្នៅ និង បាន អញ្ជើញ ចូលរួម បុណ្យ ក ឋិន ទាន សាមគ្គី នាំយក បច្ច័យ កសាង វត្ត និង ប្រគេន បច្ច័យ ដល់ ព្រះសង្ឃ 45 អង្គ នៅ វត្ត ត្នោត ជុំ ផងដែរ ៕ ត្រូវ និយាយ ថា ទេ ចំពោះ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា៖ បង្ក្រាប ១៤ករណី ឃាត់ខ្លួន ២៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៤ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៧ករណី និង ជួញដូរ ៧ករណី ឃាត់ខ្លួន ជនសង្ស័យ ២៧ នាក់ ។
ថ្នាក់ដឹកនាំ មន្ត្រី សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត កំពត នាំគ្នា ហូប អំបុក សាមគ្គី អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត កំពត បាន នាំគ្នា រៀបចំ ពិធី ហូប អំបុក សាមគ្គី អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ក្រោម បរិយាកាស ស្និតស្នាល សប្បាយរីករាយ ។
ពិធី ហូប អំបុក នេះ បាន ការចូលរួម ពី ប្រធាន សាលាដំបូង និង ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពត តប តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល សម្ដេច តេជោ បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះ មហាក្សត្រ នៅ ទូទាំង ប្រទេស ។
មន្ត្រី សាលាដំបូង ខេត្ត កំពត អះអាង ថា ការរៀបចំ ពិធី ហូប អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការ សាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សុខ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ ទណ្ឌិត សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោល ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕
ក្រុម ឧក្រិដ្ឋ ជន បាន ខ្លឹមសារតែ មួយ ដែល មាន ន័យ យ៉ាង ដូច្នេះ ថា « កងទ័ព ជាតិ មាន តួនាទី ការពារ ជាតិ ការពារ ប្រជាជន ខ្មែរ ការពារ ព្រំដែន ការពារ បូរណភាព ដែនដី ការពារ លទ្ធិ ប្រជាធិបតេយ្យ ។ កងទ័ព ត្រូវតែ អព្យាក្រឹត មិន ប្រកាន់ បក្សពួក ឬ បក្ស នយោបាយ ណាមួយ ទេ ។ ដាច់ខាត ត្រូវ ជៀសវាង អំពើហិង្សា ឬ ការបង្ហូរ ឈាម ណាមួយ » ។
ទង្វើ នេះ គឺជា ផែនការ រដ្ឋប្រហារ មួយ ដែល ក្រុម ពួក ឧទ្ទាម សម រង្ស៉ី រៀបចំ ដើម្បី ប៉ុង ប៉ង ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ក្រៅ ការប្រកាស ប្រមូលផ្តុំ មនុស្ស ដើម្បី ធ្វើ បាតុកម្ម ផ្តួលរំលំ រាជ រដ្ឋាភិបាល និង ស្ថាប័ន ព្រះមហាក្សត្រ ។
យុទ្ធនាការ ដ៏ ខ្មៅ ងងឹត របស់ ក្រុម ឧក្រិដ្ឋ ជន ទាំងអស់ នេះ បាន កើតឡើង ស្រប ពេល ដែល ចំ ថ្ងៃ ០៩ វិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ដែល ទណ្ឌិត សម រង្ស៉ី បាន ប្រកាស វិល ចូល ស្រុក ៕
មន្រ្តី ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ទោះបី សម រង្ស៉ី និង មេដឹកនាំ សំខាន់ ៗ បាន មកដល់ ប្រទេស ក្នុង តំបន់ តាម លិខិត ឆ្លង ដែន បរទេស និង ទិដ្ឋាការ ទេសចរណ៍ ក៏ដោយ ក៏ មិន អាច ស្តារ បរាជ័យ បាន ដែរ ព្រោះ ខ្វះ អ្នកគាំទ្រ ទាំង ក្នុង និង ក្រៅ ប្រទេស » ។
លោក សម រង្ស៉ី បាន ចេញ ពី បារាំង ហើយ ទៅដល់ ព្រលានយន្តហោះ នាទីក្រុង កូឡាឡាំពួរ ប្រទេស ម៉ាឡេស៊ី នៅ ម៉ោង ៣៖ ៥០នាទី រសៀល ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។ នៅពេល ទៅដល់ ព្រលានយន្តហោះ ម៉ាឡេស៊ី លោក ត្រូវបាន សមត្ថកិច្ច អន្តោប្រវេសន៍ ម៉ាឡេស៊ី ឃាត់ខ្លួន និង បាន ដាក់ បំរាម ឱ្យ លោក នៅ ម៉ាឡេស៊ី សម្រាប់ តែ ធ្វើដំណើរ ទេសចរ ប៉ុណ្ណោះ និង បាន ហាម មិន ឱ្យ ធ្វើ សកម្មភាព នយោបាយ នៅ ប្រទេស ម៉ាឡេស៊ី ជាដាច់ខាត ។
ទណ្ឌិត សម រង្ស៉ី បាន ប្រកាស ផ្តួលរំលំ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ដំណើរ មាតុភូមិ និវត្តន៍ របស់ លោក នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ដោយ ធ្វើ ចលនា ចេញ ពី ទឹកដី ថៃ ទម្លុះ ព្រំដែន ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
មន្រ្ដី ជាន់ ខ្ពស់ អគ្គ ស្នងការ នគរបាល ជាតិ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា គិត មក ត្រឹម ម៉ោង ៤៖០០ នាទី រសៀល ថ្ងៃទី ០៩ ខែវិច្ឆិកា នេះ ស្ថានភាពសន្ដិសុខ នៅ ប្រទេស កម្ពុជា ពោល ទាំង នៅ រាជធានី ភ្នំពេញ និង តាម បណ្ដា ខេត្ត នានា ពិសេស នៅ តាម ខ្សែ បន្ទាប់ ព្រំដែន ជាពិសេស ស្ថានភាព នៅ តំបន់ ប៉ោយប៉ែត គឺ មាន ស្ថានភាព ល្អ ដូច ធម្មតា ហើយ ប្រជាពលរដ្ឋ កំពុង សប្បាយរីករាយ ក្នុង ការទទួលទាន អំបុក ។
បន្ទាប់ពី បរាជ័យ ក្នុង ផែនការ ចង់ ផ្ដួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ពីសំណាក់ ក្រុម ឧទ្ទាម សម រង្ស៉ី នោះ នៅ ថ្ងៃ នេះ សមាជិក ដែល មាន បំណង ចូលរួម ជាមួយ ក្រុម ឧទ្ទាម បាន នាំគ្នា ចូលមក សារភាព កំហុស កាន់តែ ច្រើន ។ ដោយឡែក ចំពោះ ក្រុម ទេសចរ បាតុករ ដែល បាន ធ្វើដំណើរ មក ចាំ ទទួល មេដឹកនាំ ក្រុម ឧទ្ទាម នៅ តាម ព្រំដែន ក៏ បាន វិលត្រឡប់ ជា បណ្ដើរ ៗ វិញ ហើយ ។
លោក ប្រាយុទ្ធ ច័ន្ទ អ៊ូចា បាន ប្រកាស ថា នឹង មិន អនុញ្ញាតឱ្យ លោក សម រង្ស៉ី ប្រើប្រាស់ ទឹកដី ថៃ ដើម្បី ប្រឆាំង នឹង រដ្ឋាភិបាល ស្រប ច្បាប់ របស់ ប្រទេស កម្ពុជា ឡើយ ។
ដោយឡែក នាយក រដ្ឋមន្រ្តី ម៉ាឡេស៊ី លោក មហា ធៀ មហា ម៉ាត់ ក៏ បាន អះអាង ដែរ ថា ម៉ាឡេស៊ី នឹង មិន អនុញ្ញាតឱ្យ ក្រុម ណាមួយ ដោយ សំដៅ លើ លោក សម រង្ស៉ី ធ្វើ សកម្មភាព ប្រឆាំង នឹង ប្រទេស ណាមួយ ជា សមាជិក អាស៊ាន ឡើយ ៕
លោក ប៉ាន សូរស័ក្តិ៖ អំបុក ខ្មែរ ប្រហារ ពួក ក្បត់ ជាតិ សម រង្ស៉ី
( កំពង់ចាម ) ៖ ថ្ងៃ នេះ អំបុក ត្រូវបាន ប្រជាពលរដ្ឋ នាំគ្នា បរិភោគ នៅ ទូទាំង ប្រទេស យ៉ាង គគ្រឹកគគ្រេង រហូត ចាត់ទុក ជា ព្រឹត្តិការណ៍ ដ៏ ទាក់ទាញ មួយ ទៀត សម្រាប់ ឆ្នាំ ២០១៩ បន្ទាប់ពី ព្រឹត្តិការណ៍ ហូប នំបញ្ចុក កាលពី ថ្ងៃទី ០៩ ខែមិថុនា កន្លងទៅ ។ ប្រជាពលរដ្ឋ ក្នុង ស្រុក ព្រៃឈរ និង ស្រុក បាធាយ ខេត្ត កំពង់ចាម និង ក្រុមការងារ ចុះ ជួយ ស្រុក ទាំង ពីរ នេះ សរុប ប្រមាណ ១៣០០ នាក់ ក៏ បាន នាំគ្នា ចូលរួម ហូប អំពុក ផងដែរ ។
លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត កំពង់ចាម ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ស្រុក ព្រៃឈរ និង ស្រុក បាធាយ បាន លើកឡើង ថា ព្រឹត្តិការណ៍ ហូប អំពុក នៅ ថ្ងៃ គឺជា ប្រហារ ចលនា ក្បត់ ជាតិ របស់ សម រង្ស៉ី និង បក្ខពួក ។
លោក ប៉ាន សូរស័ក្តិ បាន ថ្លែង ថា « ការរៀបចំ ពិធី ពិសា អំបុក គឺជា យុទ្ធនាការ ពិសេស ដែល សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា រៀបចំឡើង ដើម្បី ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ពី ទង្វើ ទុច្ចរិត ដ៏ ពិស ពុល របស់ ក្រុម ក្បត់ ជាតិ ។ ការជួប ជួបជុំ ហូប អំបុក បាន បង្ហាញ ថា ពលរដ្ឋ ខ្មែរ នៅតែ រីករាយ ហើយ បំណង បំផ្លាញ ជាតិ របស់ ក្រុម សម រង្ស៉ី ត្រូវបាន បរាជ័យ » ។
អង្គភាព អន្តរាគមន៍ ប្រចាំ ការ នៅ អគ្គ ស្នងការ បាន រៀបចំ កម្មវិធី អក អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ អង្គភាព អន្តរាគមន៍ ដែល ប្រចាំ ការ នៅ អគ្គ ស្នងការ នៅ ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន រៀបចំ កម្មវិធី អក អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នេះ ក្រោម ការដឹក ដោយ ឧត្តមសេនីយ៍ ទោ អ៊ឹង ដារ៉េត ប្រធាន អង្គភាព អន្តរាគមន៍ ។
លោក ឧត្តមសេនីយ៍ ទោ បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ រដ្ឋបាល ខេត្ត សៀមរាប ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន កុះករ រៀបចំ ពិសារ អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( សៀមរាប ) ៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ រ បស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
រដ្ឋបាល ខេត្ត សៀមរាប បាន រៀប ពិធី ពិសារ អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ដោយ មាន ពិធី បួងសួង មួយ នៅ ព្រះវិហារ ព្រះអង្គ ចេក ព្រះអង្គ ចម ដើមី្ប សុំ នូវ សេចក្តីសុខ ដល់ ប្រជាជាតិ កម្ពុជា រួម និង ប្រជាពលរដ្ឋ នៅ ខេត្ត សៀមរាប ផ្ទាល់ ផងដែរ ។
បន្ទាប់ពី បាន ធ្វើ ការបូជា ទៀន ធូក និង ថ្វាយ ផ្កា ភ្ញី រួច មក ក្នុង ពិធី បួងសួង បាន ប្រព្រឹត្ត ធ្វើ ទៅ តាម គន្លង ប្រពៃណី ទំនៀមទម្លាប់ នៃ ព្រះពុទ្ធ សាសនា ដោយ លោក អាចារ្យ បាន ធ្វើ ពិធី ឧទ្ទិស បួងសួង សូម នូវ ព្រះបារមី ដ៏ ស័ក្ត សិទ្ធិ ដែល គង់ ប្រថាប់ ថែរក្សា នៅលើ ទឹកដី សៀមរាប - អង្គរ តាម ជួយ ថែរក្សា នូវ ថ្នាក់ដឹកនាំ ប្រទេស និង ពលរដ្ឋ កម្ពុជា ផងដែរ ។
លោក ទៀ សីហា បាន បញ្ជាក់ ថា ថ្ងៃទី ៩ វិច្ឆិកា គឺជា ថ្ងៃ មួយ ដែល ប្រទេស កម្ពុជា ទទួលបាន នូវ ឯករាជ្យ ពី ពួក អាណានិគម បារាំង សេស ក្រោម ព្រះរាជ បូជនីយកិច្ច របស់ ព្រះករុណា សម្តេច ព្រះនរោត្តម សីហនុ ព្រះបរម រតន កោដ្ឋ ហើយ ស្មា តី ៩ វិច្ឆិកា បាន ស្ថិត នៅ ជាប់ ក្នុង ក្រអៅបេះដូង ប្រជានុរាស្ត្រ ខ្មែរ យើង គ្រប់ រូប ។
លោក បាន បន្ថែម ទៀត ថា ការពិសារ អំបុក ស្រូវ ថ្មី ដោយ សេរី ពិសារ អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ដោយ មាន ការសម្រិត សម្រាំង យ៉ាង ពិសេស ដោយ មាន ការដាល់ អំបុក ដែល ជា ទំនៀមទម្លាប់ របស់ ដូនតា ខ្មែរ នៅក្នុង កម្មវិធី នេះ ទាំង ភ្ញៀវ ជាតិ អន្តរជាតិ អាច ចូលរួម ដាល់ អំបុក ជាមួយ ក្រុមគ្រួសារ និង មិត្ដ ភ័ក្ត្រ បាន យ៉ាង សប្បាយរីករាយ និង ល្បែង កម្សាន្ត របាំ បុរាណ ខ្មែរ ទៀតផង ។
ប្រមុខ ការទូត កម្ពុជា៖ សារ រដ្ឋមន្រ្តី ក្រសួង ការបរទេស អាមេរិក អបអរសាទរ ខួប ៦៦ ឆ្នាំ ទិវា ឯករាជ្យភាព កម្ពុជា គឺជា ការផ្តល់ កិត្តិយស ឱ្យ កម្ពុជា ដែល គោរព ឯករាជ្យ និង អធិបតេយ្យភាព គ្នា
សារ ឆ្លើយតប របស់ ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស កម្ពុជា ចំពោះ សារ អបអរសាទរ របស់ លោក Michael Pompeo បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ប្រទេស កម្ពុជា ចាត់ទុក ការរាប់អាន ពី សហរដ្ឋ អាមេរិក និង សារ របស់ លោក Pompeo គឺជា ការផ្តល់ កិត្តិយស ឱ្យ កម្ពុជា ប្រកបដោយ ក្តីសង្ឃឹម ថ្មី ចំពោះ កិច្ចសហប្រតិបត្តិការ កាន់តែ ស៊ីជម្រៅ និង មាន អត្ថន័យ កាន់តែ ធំ ធេង រវាង កម្ពុជា និង សហរដ្ឋ អាមេរិក ដែល គោរព ឯករាជ្យ និង អធិបតេយ្យភាព គ្នា ទៅ វិញទៅ មក » ។
នៅ ពេល ដែល យើង អបអរ ចំពោះ ទិវា ជា ប្រវត្តិសាស្ត្រ នេះ ដោយ ក្តីរីករាយ យើង ឆ្លៀត ពេល ដើម្បី សាទរ ភាព ជឿនលឿន និង វឌ្ឍនភាពសង្គម ដែល ប្រទេសជាតិ មួយ បង្ហាញ នូវ សេចក្តីប្រាថ្នា និង ការសម្រេចបាន របស់ ប្រជាជន ខ្លួន ។ ការរួបរួម និង ការទុកចិត្ត គ្នា ក្នុង សង្គម ពិតជា មាន សារៈសំខាន់ សម្រាប់ ប្រទេសជាតិ ហើយ យើង ជឿជាក់ ថា មិត្តភាព និង ការគាំទ្រ ពី បណ្តា ប្រទេស ជា មិត្ត ដែល បាន ជួយ យើង ក្នុង គ្រា ដ៏ លំបាក គឺជា ភាពសំខាន់ បំផុត ។ នេះ បើ តាម លោក ប្រាក់ សុខុន ។
សូម បញ្ជាក់ ថា Facebook ផ្លូវការ របស់ ស្ថានទូត អាមេរិក ប្រចាំ កម្ពុជា បាន ផ្សព្វផ្សាយ នៅ ព្រឹក នេះ នូវ សេចក្តីថ្លែង របស់ ប្រមុខ ការទូត អាមេរិក ទាំងស្រុង យ៉ាង ដូច្នេះ ថា៖ « តាង នាម ឲ្យ រដ្ឋាភិបាល សហរដ្ឋ អាមេរិក ខ្ញុំ សូម សម្តែង អំណរ សាទរ ដល់ ប្រជាជន កម្ពុជា នៅក្នុង ឱកាស ខួប លើក ទី ៦៦ នៃ ឯករាជ្យ របស់ អ្នក នៅ ថ្ងៃទី ៩ ខែវិច្ឆិកា » ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ គឺជា ខួប ៦៦ ឆ្នាំ ដែល ប្រជាជាតិ កម្ពុជា ទាំងមូល បាន រំដោះ ខ្លួន ទាំងស្រុង ចេញ ពី អាណានិគម បារាំង ក្រោម ព្រះរាជ បូជនីយកិច្ច ដឹកនាំ ដ៏ ក្លៀវខ្លា របស់ ព្រះមហា វីរក្សត្រ ខ្មែរ ព្រះបរម រតន កោដ្ឋ ព្រះករុណា ព្រះបាទ សម្តេច នរោត្តម សីហនុ ។ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ខ្មែរ ៩វិច្ឆិកា ត្រូវបាន ប្រជាជន កម្ពុជា ប្រារព្ធ ពិធី អបអរ ជារៀងរាល់ ឆ្នាំ ៕
ទូត អាមេរិក ថ្មី ប្រចាំ កម្ពុជា កោតសរសើរ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការលើកកម្ពស់ សុខុមាល ប្រជាពលរដ្ឋ ក្រីក្រ ពិសេស ស្រ្ដី មាន ផ្ទៃពោះ
ឯក អគ្គ រដ្ឋទូត រូប នេះ បាន បន្ដ ថា បន្ទាប់ពី លោក ធ្វើដំណើរទស្សនកិច្ច នៅ តាម បណ្ដា ខេត្ដ ក្នុង នោះ មាន ខេត្ដ សៀមរាប ដែល បាន សង្កេតឃើញ ថា ប្រជាពលរដ្ឋ ភាគ ច្រើន ដែល មក ទទួល សេវា ពិនិត្យ - ព្យាបាល សម្រាល កូន គឺ រាល់ ការចំណាយ ដោយ ថវិកា រដ្ឋ ។
ជា កិច្ច ឆ្លើយតប រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ថ្លែងអំណរគុណ ចំពោះ កិច្ចសហការ កន្លងមក នេះ របស់ រដ្ឋាភិបាល សហរដ្ឋ អាមេរិក ដែល បាន ការគាំទ្រ និង ធ្វើ ការងារ ជាមួយគ្នា កន្លងមក លើ វិស័យ សុខាភិបាល កម្ពុជា លើ ផ្នែក គាំពាំ សុខភាព មាតា ទារក និង កុមារ ។ លើស ពី នោះ ចំពោះ ការប្ដេជ្ញា រួមគ្នា រឹត ចំណង មិត្ដភាព រវាង កម្ពុជា - អាមេរិក ឱ្យ កាន់តែ ទទួលបាន ផ្លែ ផ្កា បន្ថែម ទៀត ។
រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ថ្លែង បន្ដ ទៀត ថា ក្រៅ ការប្ដេជ្ញា ពង្រឹង កិច្ចសហប្រតិបត្ដិការ រវាង គ្នា រដ្ឋមន្ដ្រី សង្ឃឹម ថា នឹង បន្ដ ពិនិត្យ លើ កិច្ចព្រមព្រៀង កន្លងមក និង ទៅក្នុង ថ្ងៃ ខាងមុខ ជា និរន្ដ ។
ក្នុង ឱកាស នោះ រដ្ឋមន្ដ្រី សុខាភិបាល បាន លើកឡើង ពី ការប្រយុទ្ធ ប្រឆាំង ទៅនឹង ជំងឺ អេដស៍ រ បេង និង គ្រុញ ចាញ់ ដែល ត្រូវការ ដៃគូ អភិវឌ្ឍ បន្ដ ជួយ ក្នុង ការលុបបំបាត់ ទោះ ពេលនេះ កម្ពុជា ទទួលបាន សមិទ្ធិផល ល្អ ហើយ ក្ដី ។
( រតនគិរី ) ៖ ក្រៅពី ការពង្រឹង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម មូលដ្ឋាន និង តាម ច្រក ព្រំដែន នោះ កងកម្លាំង នគរបាល ទូទាំង ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នេះ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន ស្នងការ នគរបាល ខេត និង មាន ការផ្តល់ កិត្តិយស ដោយ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត រតនគិរី ។
លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ រដ្ឋបាល ខេត្ត ព្រៃវែង រៀបចំ ពិធី ហូប អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ព្រៃវែង ) ៖ នៅ ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ លោក ស្បោង សារ៉ាត់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ព្រៃវែង និង លោក ជា សុមេធី អភិបាល ខេត្ត បាន ដឹកនាំ មន្រ្តី រាជការ ប្រារព្ធ ពិធី រំលឹក ខួប អនុស្សាវរីយ៍ លើក ទី ៦៦ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា និង ទិវា កំណើត កង យោពល ខេមរភូមិន្ទ ដែល ពិធី នេះ ប្រារព្ធ ឡើង នៅ សួនច្បារ សម្តេច ជា ស៊ីម កំចាយ មារ ( ស្តូប ) ។
ក្រោយ ចប់ កម្មវិធី ប្រធាន ក្រុមប្រឹក្សា និង អភិបាល ខេត្ត បាន ដឹកនាំ មន្ត្រីរាជការ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ និង បងប្អូន ប្រជាពលរដ្ឋ ជួបជុំ ទទួលទាន អំបុក ខ្មែរ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ក្រោម ទិដ្ឋភាព សាមគ្គីភាព ក្នុង នាម ជា ខ្មែរ តែ មួយ ប្រកបដោយ ភាពសប្បាយរីករាយ ក្រៃលែង ។
ថ្នាក់ដឹកនាំ ចុះ ជួយ មូលដ្ឋាន រួម ជាមួយ ពលរដ្ឋ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក ជុំគ្នា ហូប អំបុក ខ្មែរ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កំពង់ធំ )៖ ដោយ អនុវត្ត តាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នា ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ថ្នាក់ដឹកនាំ ចុះ ជួយ មូលដ្ឋាន ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក រួម ជាមួយ ប្រជាពលរដ្ឋ ទាំង ពីរ ស្រុក នេះ បាន ចូលរួម ហូប អំបុក ជុំគ្នា យ៉ាង សប្បាយរីករាយ ក្រោម ស្មារតី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ក្នុង នោះ ក៏ មាន វត្តមាន របស់ លោក ជា បូរ៉ា អនុប្រធាន ក្រុមការងារ បក្ស ទទួលបន្ទុក រួម ស្រុក បារាយណ៍ និង លោក ទិត ចន្ថា អនុប្រធាន ក្រុមការងារ បក្ស ទទួលបន្ទុក រួម ស្រុក តាំង គោក និង ប្រជាពលរដ្ឋ ក្នុង ភូមិ នានា នៃ ឃុំ បល្ល័ង្ក ស្ថិត ក្នុង បរិយាកាស ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញ បរិបូណ៌ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ថ្នាក់ដឹកនាំ ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ស្រុក ទាំង ពីរ បាន លើកឡើង មតិ យ៉ាង ដូច្នេះ ថា ការរៀបចំ ពិធី អក អំបុក នា ពេលនេះ គឺ ដើម្បី អបអរ ខួប លើក ទី ៦៦ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ហើយ ការទទួលទាន អំបុក នេះ ក៏ បង្ហាញ ឱ្យ ឃើញ ពី សាមគ្គីភាព របស់ ប្រជាពលរដ្ឋ ក្នុង ការការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ទន្ទឹម នេះ លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ រួមគ្នា ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍ មិន ត្រូវ ចាញ់បោក ឧបាយកល របស់ ក្រុម ឧទ្ទាម ក្បត់ ជាតិ ទណ្ឌិត សម រង្ស៊ី និង បក្ខពួក ដែល មាន បំណង បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដេីម្បី ធ្វេី រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ និង របប រាជានិយម អាស្រ័យ រដ្ឋធម្មនុញ្ញ ៕ ប្រជាពលរដ្ឋ នៅ ឃុំ ពង ទឹក ស្រុក រំដួល ខេត្ត ស្វាយរៀង សប្បាយរីករាយ ការទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ស្វាយរៀង ) ៖ លោក ចាន់ កុលបុត្រ អនុ រដ្ឋលេខាធិការ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ឃុំ ពង ទឹក ស្រុក រំដួល ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ ក្រុមការងារ ចុះ ជួយ តាម ភូមិ ទាំង ៩ ក្នុង ឃុំ ជួបជុំគ្នា ហូប អំបុក សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ការរៀបចំ ទទួលទាន អំបុក របស់ ប្រជាពលរដ្ឋ នៅ ឃុំ ពង ទឹក ក៏ ដូចជា ប្រជាពលរដ្ឋ និង បណ្តា ក្រសួង - អង្គភាព និង ប្រជាពលរដ្ឋ នៅ ខ្មែរ ដែល រស់ នៅ ក្រៅ ស្រុក បាន បង្ហាញ ពី ការគាំទ្រ ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ធ្វើឱ្យ ប្រទេសជាតិ មាន សន្តិភាព ពេញលេញ និង សម្បូរសប្បាយ ជាមួយនឹង ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ទៅ មុខ ជាលំដាប់ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ មេ ក្រុម ឧទ្ទាម សម រង្ស៉ី ដែល ញុះញង់ ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕
លោក អ៉ឹម ឈុន លឹម ផ្តល់ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា ដល់ ទូកង ចំនួន ៦ មកពី ខេត្ត ក្រចេះ
( ភ្នំពេញ ) ៖ គ្រឿង ឧបភោគ បរិភោគ រួម នឹង ថវិកា មួយ ចំនួន ផង ត្រូវបាន លោក អ៉ឹម ឈុន លឹម ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ឧបត្ថម្ភ ទៅដល់ ទូកង ចំនួន ៦ មកពី ខេត្ត ក្រចេះ ដែល ចូលរួម ប្រកួតប្រជែង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក រយៈពេល ៣ ថ្ងៃ ក្នុង រាជធានី ភ្នំពេញ ។
គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា ដែល ជា ជំនួយ ឧបត្ថម្ភ របស់ លោក អ៉ឺម ឈុន លឹម ត្រូវបាន លោក តាំង រតនា អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ យក ទៅ ប្រគល់ ជូន ដល់ តំណាង ទូក នីមួយ ៗ នៅ រសៀល ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។
ការឧបត្ថម្ភ ដល់ ទូកង ទាំង៦ នេះ គិត ទាំង គ្រឿង ឧបភោគ បរិភោគ និង ថិវកា សរុប ជា ថវិកា មាន ចំនួន ប្រមាណ ១៥លាន រៀល ។ លោក អ៉ឺម ឈុន លឹម តែង បាន ឧបត្ថម្ភ ដល់ ទូកង មកពី ខេត្ត ក្រចេះ ជារៀងរាល់ ឆ្នាំ ។
មន្រ្ដី ជាន់ ខ្ពស់ ដដែល រូប នោះ បាន បញ្ជាក់ ទៀត ថា បន្ទាប់ពី បរាជ័យ ក្នុង ផែនការ ចង់ ផ្ដួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ពីសំណាក់ ក្រុម ឧទ្ទាម សម រង្ស៉ី នោះ នៅ ថ្ងៃ នេះ សមាជិក ដែល មាន បំណង ចូលរួម ជាមួយ ក្រុម ឧទ្ទាម បាន នាំគ្នា ចូលមក សារភាព កំហុស កាន់តែ ច្រើន ។ ដោយឡែក ចំពោះ ក្រុម ទេសចរ បាតុករ ដែល បាន ធ្វើដំណើរ មក ចាំ ទទួល មេដឹកនាំ ក្រុម ឧទ្ទាម នៅ តាម ព្រំដែន ក៏ បាន វិលត្រឡប់ ជា បណ្ដើរ ៗ វិញ ហើយ ។
មន្រ្ដី ជាន់ ខ្ពស់ រូប នេះ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ជា រួម សភាពការណ៍ រហូតមកដល់ រសៀល ម៉ោង ៤៖០០ នាទី ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ នៅ ទូទាំង ប្រទេស កម្ពុជា ទាំង ក្រុង ភ្នំពេញ និង តាម បណ្ដាល ខេត្ត គឺ ស្ថានភាព មាន ភាពល្អ ប្រសើរ ដូច ធម្មតា ហើយ យើង ឃើញ ប្រជាពលរដ្ឋ នាំគ្នា សប្បាយរីករាយ ជាមួយនឹង ការអក អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ » ។
មន្ត្រី ដដែល បាន បញ្ជាក់ ទៀត ថា « យើង សង្កេតឃើញ នៅ ថ្ងៃ នេះ បន្ទាប់ពី ផែនការ របស់ ក្រុម ឧទ្ទាម ត្រូវ បរាជ័យ មាន សមាជិក នៃ ក្រុម ឧទា្ទម កាន់តែ ច្រើន ជាង មុន បាន មក សារ ភាព កំហុស ហើយ ចំពោះ ទេសចរ បាតុកម្ម ដែល ត្រៀម ទទួល មេក្លោង រដ្ឋប្រហារ ក៏ បាន ធ្វើ ការត្រឡប់ ទៅ កន្លែង ដើម វិញ ជា បណ្ដើរ ៗ ផងដែរ បន្ទាប់ពី ពួកគេ អស់ ជំនឿ ក្នុង ការរង់ចាំ ទទួល មេ ឧទ្ទាម » ។
សូម ជម្រាប ថា កំលាំង សមត្ថកិច្ច ត្រូវបាន ដាក់ពង្រាយ យ៉ាង តឹងរឹង បំផុត នៅ តាម រាជធានី ភ្នំពេញ និង តាម បណ្ដា ខេត្ត ពិសេស ខេត្ត ជាប់ ព្រំដែន ប្រទេស ថៃ ដើម្បី ទប់ស្កាត់ ការ វិលត្រឡប់ របស់ មេក្លោង ឧទ្ទាម ក្រៅ ច្បាប់ សម រង្ស៉ី ដែល បាន កំណត់ ផែនការ ផ្ដួល រំលំ រាជ រដ្ឋាភិបាល និង របប រាជានិយម ។ ប៉ុន្ដែ បំណង ដ៏ អាក្រក់ នេះ មិន បាន សម្រេច បំណង ឡើយ ៕ អភិបាល ខណ្ឌ ដង្កោ ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ដោយឡែក នៅ ខណ្ឌ ដង្កោ នា ព្រឹក ថ្ងៃ នេះ លោក នុត ពុធ ដារ៉ា ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា អភិបាល ខណ្ឌ ដង្កោ និង លោកស្រី បាន រៀបចំ និង ដឹកនាំ មន្រ្តី រាជការ យុវជន និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ចូលរួម ហូប អំបុក យ៉ាង សប្បាយរីករាយ ។
លោក នុត ពុធ ដារ៉ា បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
លោក បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខណ្ឌ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ លោក បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
សូម បញ្ជាក់ ថា ក្នុង ភូមិសាស្ត្រ ខណ្ឌ ដង្កោ សរុប មាន ចំនួន ១៥០ ទីតាំង មនុស្ស ចូលរួម ២១. ៩៦៨ នាក់ រួម មាន៖
ទង្វើ នេះ គឺជា ផែនការ រដ្ឋប្រហារ មួយ ដែល ក្រុម ពួក ឧទ្ទាម សម រង្ស៉ី រៀបចំ ដើម្បី ប៉ុង ប៉ង ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ក្រៅ ការប្រកាស ប្រមូលផ្តុំ មនុស្ស ដើម្បី ធ្វើ បាតុកម្ម ផ្តួលរំលំ រាជ រដ្ឋាភិបាល និង ស្ថាប័ន ព្រះមហាក្សត្រ ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន ប្រកាស ប្រព័ន្ធ ទូរស័ព្ទ ចំនួន ៣ខ្សែ បន្ថែម ទៀត ក្រៅពី លេខ ១១៩ ដើម្បី ទទួលបាន ការសង្គ្រោះ បន្ទាន់ និង សង្គ្រោះ បឋម ពេល មាន បញ្ហា សុខភាព អំឡុង មក ដំណើរកំសាន្ដ និង ទស្សនា ការប្រណាំង ទូក ក៏ ដូចជា ការប្រគំ តន្រ្ដី ជាដើម នៅ រាជធានី ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល ឈាន មកដល់ នៅ ថ្ងៃទី ១០ - ១១ - ១២ ខែ វិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។
រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ណឌីន បាន ថ្លែង ថា ដើម្បី បង្កើន ឱកាស ភាព សប្បាយ ដោយ គ្មាន ក្តីបារម្ភ ពី សុខភាព ក្រសួង សុខាភិបាល ក្រោម ការដឹកនាំ របស់ រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង បាន ចាត់ មន្ត្រី និង ក្រុម គ្រូពេទ្យ របស់ ខ្លួន ទូទាំង ប្រទេស ត្រៀមលក្ខណៈ ដើម្បី ផ្តល់ សេវា ថែទាំ សុខភាព ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម ទស្សនា វីដេអូ អប់រំ សុខភាព ពី រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ណឌីន ដូច ខាងក្រោម នេះ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង រៀបចំ ពិធី ពិសា អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( បាត់ដំបង ) ៖ លោក ងួន រ តនៈ អភិបាល ខេត្ត បាត់ដំបង នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ប្រជាពលរដ្ឋ ពិសារ អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ក្រោម បរិយាកាស សប្បាយរីករាយ ។
ការរៀបចំ ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ គឺ ស្រប តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
នា ឱកាស នេះ លោក អភិបាល ខេត្ត បាន អំពាវនាវ ឱ្យ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ជាពិសេស ប្រជាពលរដ្ឋ ត្រូវ រួម គសាមគ្គី គ្នា ជា ធ្លុង មួយ ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដើម្បី ការពារ សុខ សន្តិភាព អធិបតេយ្យភាព និង ឯករាជ្យ របស់ ប្រទេស កម្ពុជា ឱ្យ ស្ថិតស្ថេរ គង់វង្ស ព្រោះ សន្តិភាព គឺជា គ្រឹះ យ៉ាង រឹងមាំ សម្រាប់ ប្រទេសជាតិ ធ្វើ ការអភិវឌ្ឍន៍ ឱ្យ កាន់តែ រីកចម្រើន ខ្លាំងក្លា ថែម ទៀត ។
អភិបាល ខេត្ត បាន បន្ត ថា ៖ ពិធី ពិសា អំបុក សាមគ្គី ជាតិ ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ថ្ងៃ នេះ បាន ធ្វើឡើង នៅ ទូទាំង ឃុំ - សង្កាត់ របស់ ខេត្ត និង តាម មន្ទីរ អង្គភាព រៀង ៗ ខ្លួន ដោយ រៀបចំ ជាច្រើន កន្លែង មាន ប្រជាពលរដ្ឋ និង មន្រ្តី រាជការ ចូលរួម រាប់ ម៉ឺន នាក់ ប្រើប្រាស់ អំបុក ជាច្រើន តោន ចេក ជាច្រើន ស្និត ដូង ជាច្រើន ផ្លែ ព្រមទាំង សម្ភារ មួយចំនួន ទៀត សម្រាប់ ការរៀបចំ ពិធី ពិសារ អំបុក នេះ ។
លោក អភិបាល ខេត្ត ក៏ បាន ធ្វើ ការអំពាវនាវ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ទាំងអស់ ចូលរួម ពិធី ពិសារ អំបុក សាមគ្គី ជាតិ នេះ នៅ តាម មូលដ្ឋាន នៅ ទូទាំង ខេត្ត ហើយ កុំ មាន ការព្រួយបារម្ភ ពី បញ្ហា សុវត្ថិភាព អ្វី ឱ្យ សោះ ព្រោះ ប្រទេសជាតិ មាន សុខ សន្តិភាព ១០០ ភាគរយ ហើយ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ បាន ធានា ការពារ សុខ សុវត្ថិភាព សាធារណៈ និង សុវត្ថិភាព បងប្អូន ប្រជាពលរដ្ឋ មិន ឱ្យ មាន បញ្ហា អ្វី កើតឡើង នោះ ទេ ។
កម្លាំង នគរបាល ទូទាំង ខេត្ត កំពង់ចាម ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កំពង់ចាម ) ៖ ក្រៅពី ការពង្រឹង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម មូលដ្ឋាន ពិសេស ប្រឆាំង ត្រៀម អនុវត្ត បទបញ្ជា របស់ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល ក្នុង ការកម្ចាត់ ក្រុម ក្បត់ ជាតិ នោះ កងកម្លាំង នគរបាល ទូទាំង ខេត្ត កំពង់ចាម នៅ យប់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នេះ និង មាន ការចង្អុលបង្ហាញ ពី លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម ។
( ព្រះវិហារ ) ៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ដោយឡែក នៅ ក្រុមហ៊ុន ទ្រី ភាព ស្ថិត នៅ ចំការ កៅស៊ូ បឹង ទន្លេ ម្រេច ក្នុង ភូមិ អូរ ពោធិ ឃុំ រម្មណីយ៍ ស្រុក រវៀង ខេត្ត ព្រះវិហារ នា ព្រលប់ ថ្ងៃ នេះ ក្រោម វត្តមាន លោក ហេង សំណាង នាយក គ្រប់គ្រង ក្រុម ចំការ កៅស៊ូ ក្រុមហ៊ុន ទ្រី ភាព បឹង ទន្លេ ម្រេច តំណាង លោក ឧកញ៉ា ទ្រី ភាព អគ្គ នាយក ក្រុមហ៊ុន ទ្រីភាព អ៊ីម ផត អិច ផត បាន រៀបចំ និង ដឹកនាំ កម្មករ កម្ម ការិនី និង ប្រជាពលរដ្ឋ ជិត ១០០០ នាក់ ចូលរួម ហូប អំបុក និង អារ ហារ សាមគ្គី ព្រមទាំង រាំ លេង កំសាន្ត យ៉ាង សប្បាយរីករាយ ។
នៅក្នុង ឱកាស នោះ លោក ហេង សំណាង បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក ឧកញ៉ា បណ្ឌិត ទ្រី ភាព ដែល ជានិច្ច ជាកាល តែង គិតគូរ ជានិច្ច អំពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ បងប្អូន កម្មករ យើង ។
លោក ឲ្យ ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
លោក ហេង សំណាង បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ តំណាង ឲ្យ លោក ឧកញ៉ា ទ្រី ភាព លោក ហេង សំណាង ក៏ បាន ឧបត្ថម្ភ ថវិកា ចំនួន ១០លាន រៀល ដល់ បុគ្គលិកកម្ម រ ដែល បាន ចូលរួម និង អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ លោក បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឲ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា ពិធី ហូប អំបុក ខ្មែរ « ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ »
( ភ្នំពេញ ) ៖ នៅ សាលា បឋមសិក្សា កំបូល ស្ថិត នៅ ខណ្ឌ កំបូល នា ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា បាន រៀបចំ ពិធី ហូប អំបុក ខ្មែរ « ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ » ដើម្បី បង្ហាញ ពី សាមគ្គីភាព ឯកភាព ជាតិ និង រួមគ្នា ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង ជ្រោង ទង់ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ជាតិ ។
ពី ធី នេះ រៀបចំឡើង ដោយ មាន កិច្ចសហការ ជាមួយ អាជ្ញាធរ ខណ្ឌ និង មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សាភិបាល សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា ក្រុមប្រឹក្សា សង្កាត់ សហជីព កម្មករ លោកគ្រូ អ្នកគ្រូ និង ប្រជាពលរដ្ឋ ប្រកបដោយ បរិកាស សប្បាយរីករាយ ។
ជាពិសេស ក៏ បាន ឆ្លៀត ពេល អញ្ជើញ ចូលរួម សួរសុខទុក្ខ ដល់ អ្នកចូលរួម កម្មវិធី ទាំងអស់ ផងដែរ ពីសំណាក់ ថ្នាក់ដឹកនាំ សមាជិក ព្រឹទ្ឋ សភា និង លោក អភិបាល រង រាជធានី ភ្នំពេញ ៕ ក្រុមការងារ ថ្នាក់ ជាតិ បើក វេទិកា សាធារណៈ នៅ ឃុំ ភ្នំ សំពៅ ខេត្ត បាត់ដំបង ដោះស្រាយ បញ្ហា ជូន ប្រជាពលរដ្ឋ
( បាត់ដំបង ) ៖ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ ភ្នំ សំពៅ ស្រុក បាណន់ ខេត្ត បាត់ដំបង លោក ហែម ថេង បាន ចុះ ធ្វើ វេទិកា សាធារណៈ ជុំ ទី២ បន្ត ដើម្បី ក្តាប់ សំណូមពរ ប្រជាពលរដ្ឋ យកមក ដោះស្រាយ ជូន ពួកគាត់ ពិសេស ពង្រឹង គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព និង រៀបចំ ពិធី អបអរសាទរ ទិវា បុណ្យ ឯករាជ្យ ជាតិ លើក ទី៦៦ ( ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០១៩ ) និង ទិវា កំណើត នៃ កងយោធពល ខេមរភូមិន្ទ ។
ក្នុង ពិធី នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ លោក ហែម ថេង ក៏ បាន លើកឡើង ថា ដើម្បី បម្រើ សេវា សាធារណៈ និង ពង្រឹង សន្តិសុខ នៅ មូលដ្ឋាន និង ឆ្លើយតប តាម សំណូមពរ របស់ ប្រជាពលរដ្ឋ ក្នុង នាម ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ឃុំ ភ្នំ សំពៅ លោក និង ក្រុមការងារ តែង បាន ចុះ មូលដ្ឋាន ជាប្រចាំ ជាក់ស្តែង ថ្ងៃ នេះ បាន បើក វេទិកា សាធារណៈ ជុំ ទី២ ដើម្បី យក សំណូមពរ ទាំង នេះ ធ្វើ ការដោះស្រាយ ។
លោក ប្រធាន ក្រុមការងារ បាន បញ្ជាក់ ថា រាល់ សំណូមពរ របស់ ប្រជាពលរដ្ឋ នៅក្នុង វេទិកា សាធារណៈ កន្លងទៅនឹង ត្រូវ យកមក ធ្វើ ការដោះស្រាយ តាម សំណូមព របស់ ពួកគាត់ រួចហើយ និង ស្តាប់ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ដែល បាន ធ្វើឡើង នៅ ជុំ ទី២ ដើម្បី ធ្វើ ការដោះស្រាយ បន្ថែម ទៀត ។
ក្នុង វេទិកា នេះ លោក ប្រធាន ក្រុមការងារ បាន អនុញ្ញាតឲ្យ ប្រជាពលរដ្ឋ មកពី បណ្តា ភូមិ ទាំង១០ឡើង មាន សំណូមពរ មួយចំនួន បន្ថែម ទៀត សុំ ដល់ លោក ប្រធាន ជួយ ដោះស្រាយ តាម សំណូមពរ របស់ គាត់ ផងដែរ ។ រាល់ សំណូមពរ ទាំងអស់ របស់ ប្រជាពលរដ្ឋ លោក ប្រធាន ក្រុមការងារ បាន នាំយក ទៅ ពិភាក្សា និង ដោះស្រាយ ជាបន្ទាន់ ចំពោះ សំណូម ចាំបាច់ ជាមុន និង រឿង ផ្សេង ៗ ទៀត ទុក ដោះស្រាយ តាម ក្រោយ បន្តបន្ទាប់ ឲ្យបាន ចប់ ដូចគ្នា ។
លោក ហែម ថេង បាន ធ្វើ ការបូកសរុប ក្នុង វេទិកា នេះ ថា រាល់ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ទាំងអស់ នា ពេលនេះ ក្នុង នាម ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ត្រូវ យកមក ដោះស្រាយ ជូន គាត់ នៅ តា មូលដ្ឋាន របស់ ពួកគាត់ ឲ្យបាន ទាន់ ពេលវេលា ហើយ ក្រុមការងារ យើង ធ្វើ ការ ទាំង ការងារ នៅ មូលដ្ឋាន និង ការងារ ស្នូល របស់ ខ្លួន យើង ដោយ មិន អាច ខាន មួយ ណា បាន ឡើយ ៕ TOP NEWS: មន្ត្រី ជាន់ ខ្ពស់ នគរបាល ជា តិ៖ គិត ត្រឹម ម៉ោង ៧៖៣០ នាទី យប់ ថ្ងៃ នេះ ស្ថានភាព នៅ តាម ព្រំដែន ទូទាំង ប្រទេស មាន ភាពល្អ ប្រសើរ ដូច ធម្មតា
( ភ្នំពេញ ) ៖ មន្រ្ដី ជាន់ ខ្ពស់ អគ្គ ស្នងការ នគរបាល ជាតិ បាន អះអាង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង នៅ រសៀល ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ថា គិត មក ត្រឹម ម៉ោង ៧៖៣០ នាទី យប់ ថ្ងៃ នេះ ស្ថានភាពសន្ដិសុខ នៅ ប្រទេស កម្ពុជា ពោល ទាំង នៅ រាជធានី ភ្នំពេញ និង តាម បណ្ដា ខេត្ត នានា ពិសេស នៅ តាម ខ្សែ បន្ទាប់ ព្រំដែន គឺ មាន ស្ថានភាព ល្អ ដូច ធម្មតា ហើយ ប្រជាពលរដ្ឋ សប្បាយរីករាយ ក្នុង ការទទួលទាន អំបុក ។
មន្រ្ដី ជាន់ ខ្ពស់ ដដែល រូប នោះ បាន បញ្ជាក់ ទៀត ថា បន្ទាប់ពី បរាជ័យ ក្នុង ផែនការ ចង់ ផ្ដួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ពីសំណាក់ ក្រុម ឧទ្ទាម សម រង្ស៉ី នោះ នៅ ថ្ងៃ នេះ សមាជិក ដែល មាន បំណង ចូលរួម ជាមួយ ក្រុម ឧទ្ទាម បាន នាំគ្នា ចូលមក សារភាព កំហុស កាន់តែ ច្រើន ។ ដោយឡែក ចំពោះ ក្រុម ទេសចរ បាតុករ ដែល បាន ធ្វើដំណើរ មក ចាំ ទទួល មេដឹកនាំ ក្រុម ឧទ្ទាម នៅ តាម ព្រំដែន ក៏ បាន វិលត្រឡប់ ជា បណ្ដើរ ៗ វិញ ហើយ បន្ទាប់ពី ពួកគេ អស់ ជំនឿ ក្នុង ការរង់ចាំ ទទួល មេ ឧទ្ទាម ។
មន្រ្ដី ជាន់ ខ្ពស់ រូប នេះ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ជា រួម សភាពការណ៍ រហូតមកដល់ រសៀល ម៉ោង ៧៖៣០ នាទី ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ នៅ ទូទាំង ប្រទេស កម្ពុជា ទាំង ក្រុង ភ្នំពេញ និង តាម បណ្ដាល ខេត្ត គឺ ស្ថានភាព មាន ភាពល្អ ប្រសើរ ដូច ធម្មតា ហើយ យើង ឃើញ ប្រជាពលរដ្ឋ នាំគ្នា សប្បាយរីករាយ ជាមួយនឹង ការអក អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ » ។
សូម ជម្រាប ថា កំលាំង សមត្ថកិច្ច ត្រូវបាន ដាក់ពង្រាយ យ៉ាង តឹងរឹង បំផុត នៅ តាម រាជធានី ភ្នំពេញ និង តាម បណ្ដា ខេត្ត ពិសេស ខេត្ត ជាប់ ព្រំដែន ប្រទេស ថៃ ដើម្បី ទប់ស្កាត់ ការ វិលត្រឡប់ របស់ មេក្លោង ឧទ្ទាម ក្រៅ ច្បាប់ សម រង្ស៉ី ដែល បាន កំណត់ ផែនការ ផ្ដួល រំលំ រាជ រដ្ឋាភិបាល និង របប រាជានិយម ។ ប៉ុន្ដែ បំណង ដ៏ អាក្រក់ នេះ មិន បាន សម្រេច បំណង ឡើយ ៕
លោក ងួន ញ៉ិល អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កីឡាករ ទូក ង មកពី ខេត្ត កំពង់ធំ ដើម្បី ត្រៀម ចូលរួម ប្រកួត
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ងួន ញ៉ិល អនុប្រធាន ទី១ នៃ រដ្ឋសភា រួម ជាមួយ សមាជិក សមាជិកា ព្រឹទ្ធសភា រដ្ឋសភា រាជ រដ្ឋាភិបាល និង ថ្នាក់ដឹកនាំ មកពី ខេត្ត កំពង់ធំ នៅ រសៀល ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន អញ្ជើញ ជួប សំណេះសំណាល និង នាំយក អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ ទៅ ឧបត្ថម្ភ ជូន ដល់ ក្រុម កីឡាករ ទូក ង របស់ ខេត្ត កំពង់ធំ ដែល មក ចូលរួម ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង អក អំបុក សំពះ ព្រះខែ នៅ រាជធានី ភ្នំពេញ ។
ពិធី សំណេះសំណាល នេះ រៀបចំឡើង២ ទីតាំង ដាច់ ឡែក ពី គ្នា មួយ នៅក្នុង តំបន់ អភិវឌ្ឍន៍ របស់ ក្រុមហ៊ុន OCIC ខាងជើង រង្វង់មូល ស្ពាន ជ្រោយ ចង្វារ និង មួយ កន្លែង ទៀត នៅក្នុង បរិវេណ វិទ្យាល័យ ជា ស៉ី ម ជ្រោយ ចង្វារ ស្ថិត នៅក្នុង សង្កាត់ ជ្រោយចង្វារ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។ ព្រមទាំង មាន ការរៀបចំ ពិធី ហូប អំបុក ខ្មែរ « ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ » ផងដែរ ។
ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ កីឡាករ ទូកង លោក ងួន ញ៉ិល បាន លើកឡើង ថា ការប្រារព្ធ ពិធី នេះ រួមទាំង ភាពសប្បាយរីករាយ នា ពេលនេះ កើតឡើង ក៏ អាស្រ័យ ដោយ ប្រទេសជាតិ យើង មាន សុខ សន្តិភាព ពេញ បរិបូរណ៍ និង សេដ្ឋកិច្ច សង្គម មាន ការរីកចម្រើន គួរ ជា ទី មោទនៈ ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ។
លោក បណ្ឌិត ងួន ញ៉ិល បាន បន្ត ថា ថ្មី ៗ នេះ ក៏ នៅ មាន ក្រុម អមិត្ត មួយ ក្តាប់ តូច បាន និង កំពុង បង្ក ភាព អសកម្ម ដល់ ដំណើរ វិវឌ្ឍន៍ នៃ សេដ្ឋកិច្ច សង្គម របស់ យើង និង សុខ សន្តិភាព ដែល យើង ទាំងអស់ គ្នា កំពុង មាន នា ពេល បច្ចុប្បន្ន នេះ ។
លោក ងួន ញ៉ិល បាន សុំឲ្យ ពុក ម៉ែ បងប្អូន ពិសេស ក្មួយ ៗ ជា កីឡាករ ទាំងអស់ កុំ ចាញ់បោក រាល់ ការឃោសនា អូសទាញ ទាំងឡាយ របស់ ក្រុម អមិត្ត ទាំងនេះ ឲ្យ សោះ តែ ត្រូវ ជំនួស មកវិញ នូវ ការខិតខំ ប្រឹងប្រែង សហការ គ្នា ស្រឡាញ់ គ្នា និង ថែរក្សា ការពារ ឲ្យបាន ជាដាច់ខាត នូវ សន្តិភាព ស្ថេរភាព នយោបាយ និង សន្តិសុខ សម្រាប់ ប្រទេស យើង ខេត្ត យើង ស្រុក យើង ឃុំ យើង និង ភូមិ យើង ។
ជាមួយគ្នា នេះ លោក ងួន ញ៉ិល ក៏ បាន ផ្តាំផ្ញើ ដល់ កីឡាករ ត្រូវ ពង្រឹង មេត្រីភាព ភាតរភាព និង សាមគ្គីភាព រវាង គ្នា និង គ្នា ដោយ ប្រកាន់ខ្ជាប់ នូវ ទស្សនៈ « ស្មារតី ជា កីឡាករ » និង ត្រូវ ចេះ សហការ ជួយគ្នា ទៅ វិញ ទៅមក និង រួមគ្នា ដោះស្រាយ បញ្ហា ដែល កើតមាន ដោយ សន្តិវិធី និង ចូលរួម រក្សា និង លើកកម្ពស់ អនាម័យ និង បរិស្ថាន ឲ្យបាន ល្អ ដោយ មិន ត្រូវ បោះចោល សំរាម ទៅក្នុង ទឹក ឬ ក្រៅ ធុង ។
សូម ជម្រាប ថា ក្នុង ឆ្នាំ ២០១៩ នេះ ខេត្ត កំពង់ធំ មាន ទូក ចូលរួម សរុប ១៣ទូក មាន ចំណុះ ទូក ៧៣៤ នាក់ កម្លាំង បម្រុង ចំនួន ១៦៨ នាក់ ។
ក្រុមការងារ ចុះ ជួយ សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែនសុខ និង ប្រជាពលរដ្ឋ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ខណ្ឌ សែនសុខ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ សមាជិក ក្រុមការងារ ចុះ ជួយ សង្កាត់ ទឹក ថ្លា និង ប្រជាពលរដ្ឋ ចូលរួម ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
លោកស្រី ឱ វណ្ណឌីន បាន ថ្លែង ថា ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ នេះ បាន បង្ហាញ ថា ប្រទេសជាតិ យើង មាន សុខ សន្ដិភាព ប្រជាពលរដ្ឋ សុខ សាន្ដ និង មាន សិទ្ធិ សេរីភាព ពេញលេញ ពិសេស ស្រប ថ្ងៃ នេះ កម្ពុជា អបអរសាទរ ថ្ងៃ ប្រវត្តិសាស្រ្ត នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ លើក ទី៦៦ និង ខួប នៃ ការបង្កើត កងយោធពល ខេមរភូមិន្ទ ។
ជាពិសេស ក៏ ដើម្បី ឆ្លើយតប តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ក្នុង ការទទួលទាន អំបុក នេះ គឺ ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ សហភាព អឺរ៉ុប ចូលរួម ឧបត្ថម្ភ ដល់ ទូក ចែវ នារី « ព្រះពៃស្រពណ៍ » មកពី ខេត្ត កំពង់ឆ្នាំង ដែល ចូលរួម ប្រណាំង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
( ភ្នំពេញ ) ៖ ដើម្បី ជា ផ្នែក មួយ នៃ កិច្ចសហការ អភិវឌ្ឍន៍ របស់ សហភាព អឺរ៉ុប ជាមួយ ប្រទេស កម្ពុជា សហភាព អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា បាន ចូលរួម លើកកម្ពស់ ទាំង កេរ ដំណែល វប្បធម៌ ដ៏ សម្បូរបែប របស់ ប្រទេស កម្ពុជា ទាំង សមភាព យេនឌ័រ ដោយ បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ ទូក ចែវ នារី នៅក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ក្នុង ឆ្នាំ ២០១៩ ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ សហភាព អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា ដែល Fresh News ទទួលបាន នៅ ល្ងាច ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ឱ្យដឹង ទៀត ថា សហភាព អឺរ៉ុប មាន មោទនភាពឧបត្ថម្ភ ទូក ចែវ នារី ព្រះពៃស្រពណ៍ មកពី ភូមិ កំពង់បា ស្រូវ ឃុំ ជល សា ស្រុក ជលគិរី ខេត្ត កំពង់ឆ្នាំង ដែល ជា ការឧបត្ថម្ភ ពីរ ឆ្នាំ ជាប់ គ្នា ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ នឹង ប្រារព្ធ ធ្វើឡើង នៅ ថ្ងៃទី ១០ ដល់ ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
ភូមិ កំពង់បាស្រូវ មាន ទូក ចែវ នារី ចូលរួម ប្រកួត ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ចាប់តាំងពី ចុង ទស្សវត្ស ឆ្នាំ ១៩៩០ម ក ម្លេះ ។ ការឧបត្ថម្ភ របស់ សហភាព អឺរ៉ុប រួម មាន ការឧបត្ថម្ភ ជា សម្ភារ ( ការជួស ជុល ទូក និង ឯកសណ្ឋាន សម្លៀកបំពាក់ ) ព្រមទាំង ការចំណាយ លើ ម្ហូប អាហារ និង ចំណាយ ផ្សេង ៗ នៅក្នុង អំឡុង ពេល ហាត់ សម និង អំឡុង ពេល ការចូលរួម ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ សហភាព អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា៖
នាយ ឧត្តមសេនីយ៍ សៅ សុខា និង មន្ត្រី អាវុធហត្ថ ក្រោម ឱវាទ អញ្ជើញ ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
នាយ ឧត្តមសេនីយ៍ បាន បន្ត ថា ថ្ងៃ នេះ ជា ខួប លើក ទី៦៦ ទិវា បុណ្យ ឯករាជ្យ ជាតិ និង ថ្ងៃ បង្កើត កយោធពល ខេមរភូមិន្ទ ជា ថ្ងៃ ដែល យើង ទាំងអស់ គ្នា មាន មោទនៈ ភាព ចំពោះ ឯករាជ្យ ជាតិ ដែល បាន កើតឡើង ក្រោម ព្រះរាជ្យ កិច្ចដឹកនាំ តស៊ូ ដណ្តើម ឯករាជ្យ ពី អាណានិគម និយម បារាំង របស់ សម្តេច ព្រះករុណា ព្រះបាទ ព្រះបរម រតន កោដ្ឋ ហើយក៏ ជា ខួប នៃ ការបង្កើត កងយោធពល ខេមរភូមិន្ទ ផងដែរ ។
រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ រៀបចំ ពិធី អបអរសាទរ ខួប លើក ទី ៦៦ បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា និង ពិសា អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ឧត្តរមានជ័យ )៖ លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ប្រជាពលរដ្ឋ ប្រារព្ធ ធី បុណ្យ ឯករាជ្យ ជាតិ ខួប លើក ទី៦៦ និង ពិសារ អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ក្រោម បរិយាកាស សប្បាយរីករាយ ។
ថ្លែង នៅក្នុង ឱកាស ប្រារព្ធ ពិធី បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា នា ឱកាស នេះ លោក ប៉ែន កុសល្យ បាន អំពាវនាវ ឱ្យ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ជាពិសេស ប្រជាពលរដ្ឋ ត្រូវ រួម គសាមគ្គី គ្នា ជា ធ្លុង មួយ ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដើម្បី ការពារ សុខ សន្តិភាព អធិបតេយ្យភាព និង ឯករាជ្យ របស់ ប្រទេស កម្ពុជា ឱ្យ ស្ថិតស្ថេរ គង់វង្ស ព្រោះ សន្តិភាព គឺជា គ្រឹះ យ៉ាង រឹងមាំ សម្រាប់ ប្រទេសជាតិ ធ្វើ ការអភិវឌ្ឍន៍ ឱ្យ កាន់តែ រីកចម្រើន ខ្លាំងក្លា ថែម ទៀត ។
បន្ទាប់ពី បញ្ចប់ កម្មវិធី បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា លោក អភិបាល ខេត្ត រួម នឹង ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ ប្រជាពលរដ្ឋ នៅ ទូទាំង ខេត្ត ព្រះវិហារ បាន នាំគ្នា ប្រាព្ធ ពិធី អក អំបុក សាមគ្កី ជាតិ ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
អភិបាល ខេត្ត ឧត្តរ មាន ជយ័ បាន បន្ត ថា ៖ ពិធី ពិសា អំបុក សាមគ្គី ជាតិ ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ថ្ងៃ នេះ បាន ធ្វើឡើង នៅ ទូទាំង ឃុំ - សង្កាត់ របស់ ខេត្ត និង តាម មន្ទីរ អង្គភាព រៀង ៗ ខ្លួន ដោយ រៀបចំ ជាច្រើន កន្លែង មាន ប្រជាពលរដ្ឋ និង មន្រ្តី រាជការ ចូលរួម រាប់ ម៉ឺន នាក់ ប្រើប្រាស់ អំបុក ជាច្រើន តោន ចេក ជាច្រើន ស្និត ដូង ជាច្រើន ផ្លែ ព្រមទាំង សម្ភារ មួយចំនួន ទៀត សម្រាប់ ការរៀបចំ ពិធី ពិសារ អំបុក នេះ ។
លោក អភិបាល ខេត្ត ឧត្តរ មាន ជយ័ ប៉ែន កុសល្យ ក៏ បាន ធ្វើ ការអំពាវនាវ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ទាំងអស់ ចូលរួម ពិធី ពិសារ អំបុក សាមគ្គី ជាតិ នេះ នៅ តាម មូលដ្ឋាន នៅ ទូទាំង ខេត្ត ហើយ កុំ មាន ការព្រួយបារម្ភ ពី បញ្ហា សុវត្ថិភាព អ្វី ឱ្យ សោះ ព្រោះ ប្រទេសជាតិ មាន សុខ សន្តិភាព ១០០ ភាគរយ ហើយ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ បាន ធានា ការពារ សុខ សុវត្ថិភាព សាធារណៈ និង សុវត្ថិភាព បងប្អូន ប្រជាពលរដ្ឋ មិន ឱ្យ មាន បញ្ហា អ្វី កើតឡើង នោះ ទេ ៕
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ សម្តេច ហេង សំរិន អញ្ជើញ ពិសារ អំបុក ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ជាមួយ ពលរដ្ឋ ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា នា ល្ងាច ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ទទួលទាន អំបុក សាមគ្គី អំបុក ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ជាមួយ ប្រជាពលរដ្ឋ នៅ ភូមិ អន្លង់ ជ្រៃ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ យ៉ាង សប្បាយរីករាយ និង ស្និទ្ធស្នាល ជា ទីបំផុត ។
នៅក្នុង ឱកាស រីករាយ ដែល ប្រារព្ធ ធ្វើ នៅ ភូមិ កំណើត ផ្ទាល់ សម្តេច ប្រធាន រដ្ឋសភា បាន និពន្ធ កំណាព្យ ខ្លី មួយ និយាយ ពី អំបុក សាមគ្គី នៃ គ្រួសារ ខ្មែរ ក្នុង ការថែរក្សា សុខ សន្តិភាព ផ្ញើ ជូន ជន រួម ជាតិ កម្សាន្ត អារម្មណ៍ ទៀតផង ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ រួម សាមគ្គី គ្នា ជា ធ្លុង មួយ ក្នុង ការការពារ សុខ សន្តិភាព ដែល កម្ពុជា ទទួលបាន ដោយ លំបាក កន្លងមក នោះ ។
សម្តេច ហេង សំរិន បាន លើកឡើង ថា « បងប្អូន ជន រួម ជាតិ ទំាង ក្នុង និង ក្រៅ ប្រទេស រួមគ្នា ជា ធ្លុង មួយ ពង្រឹង សាមគ្គីភាព ជាតិ ការពារ ឱ្យ បាន នូវ សុខ សន្តិភាព ដែល យើង ខិតខំ រក មក ដោយ លំបាក និង រួមគ្នា អភិវឌ្ឍន៍ ប្រទេសជាតិ ឱ្យ កាន់តែ មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ទៀត » ។
សម្តេច ប្រធាន រដ្ឋសភា បាន ជូន ពរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សប្បាយរីករាយ មាន សុភមង្គល គ្រប់ ក្រុមគ្រួសារ ដោយ បាន គូសបញ្ជាក់ ដូច្នេះ « បងប្អូន កូនក្មួយ ជន រួម ជាតិ ទំាង អស់ មាន សុខភាព ល្អ សុភមង្គល និង វិបុលភាព ក្នុង ក្រុមគ្រួសារ និង សប្បាយរីករាយ ក្នុង ឱកាស ឈប់ សម្រាក បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង អក អំបុក សំពះ ព្រះខែ ដែល ជា ប្រពៃណី ដ៏ ថ្លៃថ្លា របស់ ជាតិ យើង » ។
ខ្លឹមសារ កំណាព្យ ដែល សម្តេច ប្រធាន រដ្ឋសភា បាន និពន្ធ មាន អត្ថន័យ ដូច ខាងក្រោម៖
អំបុក សាមគ្គី អំបុក សាម គា អំបុក ការពារ . ប្រជាជាតិ ខ្មែរ ការពារ មហាក្សត្រ រាជា ដែន ខ្មែរ សន្តិភាព ហូរហែ នគរ រុងរឿង »៕
( បាត់ដំបង ) ៖ លោក សួស អង្គារ៍ អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ តាម៉ឺន និង ឃុំ អូរតាគី ស្រុក ថ្មគោល ជួបជុំគ្នា ចូលរួម អបអរសាទរ ទិវា បុណ្យ ឯករាជ្យ ជាតិ លើក ទី៦៦ ( ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០១៩ ) និង ទទួលទាន អំបុក ជាមួយ ចេក ទុំ ដូង ខ្ចី ទឹក ត្នោត ជាមួយ ប្រជាពលរដ្ឋ ប្រកបដោយ បរិយាកាស សប្បាយរីករាយ ក្រៃលែង « អំបុក ខ្មែរ ថែរជាតិ សាសនា និង ព្រះមហាក្សត្រ » ។
លោក សួស អង្គារ៍ បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឲ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕
គិត ត្រឹម រសៀល ម៉ោង ៥៖០០ នាទី ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ស្ថានភាព នៅ ទូទាំង ប្រទេស កម្ពុជា ពិសេស តាម ព្រំដែន កម្ពុជា - ថៃ គឺ កំពុង ដំណើរការ បាន យ៉ាង ល្អ ដូច ធម្មតា មិន មាន អ្វី ប្រែប្រួល ទេ ហើយ ប្រជាពលរដ្ឋ សប្បាយរីករាយ នឹង ការចូលរួម ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
លោក ប៊ិន ឡាដា អភិបាល ស្រុក បាន រាយការណ៍ ជូន អង្គ ពិធី ជ្រាប អំពី កម្មវត្ថុ នៃ ការរៀបចំ ពិធី នា រសៀល ថ្ងៃ នេះ និង ជាពិសេស ស្ថានភាព ជា រួម នៃ ការរៀបចំ ពិធី នេះ នៅ ទូទាំង ១៥ ឃុំ ដោយ មាន ការចូលរួម ពី មហាជន យ៉ាង ច្រើន កុះករ ញាំង ឲ្យ ពិធី ដែល ជា ប្រពៃណី និង ទំនាម ទំលាប់ ដ៏ ប្រពៃ របស់ ជាតិ យើង កាន់តែ ត្រូវបាន លើកតម្កើង និង ថែរក្សា បាន គង់វង្ស ទុក ជា មរតក ដល់ កូន ខ្មែរ ជំនាន់ ក្រោយ ។
មាន មតិ នា ឱកាស នេះ នៅ ចំពោះមុខ បងប្អូន ប្រជាពលរដ្ឋ សមាជិក សមាជិកា យ៉ាង ច្រើន កុះករ ប្រកបដោយ ទឹកចិត្ត សប្បាយរីករាយ លោក រដ្ឋមន្រ្តី បាន សម្តែង នូវ អំណរគុណ ចំពោះ វត្តមាន របស់ បងប្អូន ប្រជាពលរដ្ឋ នា ពេលនេះ ។ វត្តមាន យ៉ាង សស្រាក់សស្រាំ នេះ បាន បង្ហាញ ឲ្យ ឃើញ នូវ កម្លាំង សាមគ្គី ជាតិ ជា ធ្លុង មួយ យ៉ាង រឹងមាំ ក្នុង ការគាំទ្រ និង ការពារ សុខ សន្តិភាព ស្ថិរភាព និង ជា ពិសេស ការពារ ដាច់ខាត រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី ការពារ សាសនា និង ព្រះមហាក្សត្រ នៃ កម្ពុជា ។
ក្នុង ពិធី សំណេះសំណាល លោក បាន ជម្រាប ជូន បងប្អូន អំពី ដំណើរការវិវឌ្ឍន៍ របស់ ប្រទេសជាតិ ជា ជំហាន ៗ ក្រោម ការដឹកនាំ ប្រកប ដ៏ ភាពឈ្លាសវៃ របស់ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ គោល នយោបាយ ឈ្នះ - ឈ្នះ ធ្វើឲ្យ ប្រទេស ជាតិ ទទួលបាន នូវ សុខ សន្តិភាព ស្ថិរភាព ពេញ ទូទាំង ផ្ទៃ ប្រទេស និង ឈាន ទៅ ធ្វើ ការអភិវឌ្ឍ ជា បណ្តើរ ៗ ដោយ ជោគជ័យ ស្រប តាម បរិបទ នៃ កំណើន សេដ្ឋកិច្ច កំណើន ប្រជាជន បើ ទោះបី មាន ការគំរាមកំហែង ពី ការប្រែប្រួល អាកាសធាតុ យ៉ាងណាក្តី ។
លោក ថា ដូច្នេះ ដើម្បី ឈានទៅ សម្រេច មហិច្ឆតា នេះ លោក ប្រធាន បាន ផ្តាំផ្ញើ សមាជិក សមាជិកា ក្រុមការងារ អាជ្ញាធរ មូលដ្ឋាន និង កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ជាន់ ថ្នាក់ ជាពិសេស បងប្អូន ប្រជាពលរដ្ឋ សូម បន្ត រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ឲ្យបាន ល្អ ដើម្បី រក្សា ភាព សុខសាន្ត និង សុខដុមនីយកម្ម ក្នុង សង្គមជាតិ យើង ឲ្យបាន គង់វង្ស ត រៀង ទៅ ។
លោក វេង សា ខុន បាន បញ្ជាក់ ជូន សមាជិក ដែល បាន ចូលរួម ថា ប្រទេស យើង មាន ច្បាប់ ហើយ ច្បាប់ បាន ដាក់ទោស ទាន់ ដល់ ជន ណា ដែល មិន គោរព ច្បាប់ តែ ប៉ុណ្ណោះ ។ ដូច្នេះ ក្នុង នាម ពលរដ្ឋ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ម្នាក់ ត្រូវតែ គោរព និង ដើរ តាម មាគ៌ា ដ៏ ត្រឹមត្រូវ ច្បាស់លាស់ របស់ រាជ រដ្ឋាភិបាល ។
លោក បាន ថ្លែងអំណរគុណ ជូន ចំពោះ សហការី និង អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ ទាំងអស់ ដែល បាន រួមចំណែក ក្នុង ការរៀបចំ ធ្វើ ពិធី ដ៏ ពៃណី ជា ប្រវត្តិសាស្រ្ត តាម អនុសាសន៍ របស់ សម្តេច តេជោ ដ៏ យ៉ាង អធិកអធម និង សប្បាយរីករាយ នា រសៀល ថ្ងៃ នេះ ហើយ លោក រដ្ឋមន្ត្រី និង លោកស្រី ព្រមទាំង សហការី បាន ចូលរួម ទទួលទាន អំបុក ជា អាហារ ផលិត ចេញ ពី ស្រូវ ថ្មី ដើម រដូវ ដែល ប្រជាកសិករ យើង កំពុង សប្បាយរីករាយ និង មមាញឹក ក្នុង ការប្រមូល ផល នា ពេលនេះ ៕
( កាណាដា ) ៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ប្រទេស កម្ពុជា ។
លោក ព្រហ្ម ប៊ែន ផល្លី តំណាង ប្រជាពលរដ្ឋ ខ្មែរ នៅ ទីក្រុង Vancouver បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ លោក ព្រហ្ម ប៊ែន ផល្លី ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
អភិបាល ខេត្ត កំពង់ចាម ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ រៀបចំ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កំពង់ចាម ) ៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ជាក់ស្តែង នា ព្រឹក ថ្ងៃសៅរ៍ ទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន ចូលរួម ពិសារ អំបុក សាមគ្គី ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ក្នុង ស្មារតី អបអរសាទរ ថ្ងៃ បុណ្យ ឯករាជ្យ ជាតិ និង រក្សា ឲ្យបាន នូវ សុខ សន្តិភាព សម្រាប់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស តាម ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក អ៊ុន ចាន់ ដា បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ លោក បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ អភិបាល ខេត្ត ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឲ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ តំណាងរាស្រ្ត មណ្ឌល កំពត និង អភិបាល ខេត្ត ដឹកនាំ មន្ដ្រីរាជការ និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ចូលរួម ពិធី ហូប អំបុក សាមគ្គី អក អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ
( កំពត ) ៖ លោក បណ្ឌិត ប៉ែន ស៊ីម៉ន តំណាងរាស្រ្ត មណ្ឌល កំពត ជា ប្រធាន គណៈកម្មការ ទី១០ នៃ រដ្ឋសភា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ត កំពត នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន ចូលរួម ជា អធិបតី អបអរសាទរ បុណ្យ ខួប អនុស្សាវរីយ៍ លើក ទី៦៦ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា និង ទិវា កំណើត នៃ កងយោធពល ខេមរភូមិន្ទ ឆ្នាំ ២០១៩ និង ពិធី ទទួលទាន អំបុក ខ្មែរ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពីសំណាក់ លោក ជា វ តាយ អភិបាល ខេត្ត និង លោក ជឹង ផល្លា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ព្រមទាំង អស់ លោក លោកស្រី សមាជិក ក្រុមប្រឹក្សា ខេត្ត អភិបាល រង ខេត្ត ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ស្ថាប័ន សាលាដំបូង ខេត្ត ស្ថាប័ន អយ្យការ អម សាលាដំបូង ខេត្ត កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ អភិបាល ក្រុង ស្រុក យុវជន កាយ រឹទ្ធ យុវជន កាកបាទ ក្រហម យុវជន សយសស យុវជនសសយក លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ សរុប ៣. ៦៤៨ នាក់ ។
លោក ប៉ែន ស៊ីម៉ន បាន រំលឹក ទៀត ថា រយៈពេល កន្លងមក នេះ មាតុភូមិ កម្ពុជា និង ប្រជាពលរដ្ឋ យើង មាន ការប្រែប្រួល មុខមាត់ ថ្មី គួរឲ្យ កោតសរសើរ សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ រាជ រដ្ឋាភិបាល ដ៏ ឆ្លាតវៃ បាន ដាក់ចេញ នូវ គោល នយោបាយ ដ៏ ត្រឹមត្រូវ បាន នាំមក នូវ សុខ សន្តិភាព សាមគ្គីភាព ឯកភាព ជាតិ និង កិត្យានុភាព ជាតិ ល្បីរន្ទឺ លើ ឆាក អន្តរជាតិ ។
លោក បណ្ឌិត ប៉ែន ស៊ីម៉ន ក៏ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន រួមគ្នា សាមគ្គី ជា ធ្លុង មួយ ក្រោម ដំបូល រដ្ឋធម្មនុញ្ញ និង ច្បាប់ រដ្ឋ ដើម្បី ចូលរួមចំណែក ការពារ និង កសាង មាតុភូមិ យើង លើ គ្រប់ វិស័យ ។
ក្នុង ពិធី អបអរសាទរ បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា នា ព្រឹក នេះ រដ្ឋបាល ខេត្ត កំពត ក៏ បាន ចែកជូន អំបុក ដល់ ប្រជាពលរដ្ឋ និង ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ដើម្បី ឆ្លើយតប តាម ការប្រកាស របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ៕ ថ្នាក់ដឹកនាំ ស្រុក ប្រជាពលរដ្ឋ យុវជន និង មន្រ្តី រាជការ ទូទាំង ស្រុក កណ្តាល ស្ទឹង ចូលរួម ហូប អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កណ្តាល ) ៖ ស្រប ពេល ប្រជាពលរដ្ឋ ខ្មែរ ក្នុង ប្រទេស ធ្វើ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ យ៉ាង សប្បាយរីករាយ គគ្រឹកគគ្រេង ទូទាំង ប្រទេស នោះ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ថ្នាក់ដឹកនាំ ស្រុក ប្រជាពលរដ្ឋ យុវជន និង មន្រ្តី រាជការ ទូទាំង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ក៏ បាន នាំគ្នា ទទួលទាន អំបុក សាមគ្គី នេះ ផងដែរ ដើម្បី ឆ្លើយតប នឹង ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ប្រជាពលរដ្ឋ យុវជន មន្រ្តី រាជការ ថ្នាក់ដឹកនាំ ស្រុក ទូទាំង ស្រុក កណ្តាល ស្ទឹង បាន ប្តេជ្ញា ការពារ និង គាំទ្រ ពេញ ទំហឹង សម្តេច តេជោ ហ៊ុន សែន ដើម្បី បន្ត ដឹកនាំ ប្រទេសជាតិ ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ មេ ក្រុម ឧទ្ទាម សម រង្ស៉ី ដែល ញុះញង់ ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។
គ្រាន់តែ មកដល់ ថ្ងៃទី ៩ ខែវិច្ឆិកា នេះ ភ្លាម គេ ឃើញ តាម បណ្តា ក្រសួង ស្ថាប័ន រដ្ឋ និង ឯកជន ព្រមទាំង ប្រជាពលរដ្ឋ តាម បណ្តា ខេត្ត ក្រុង ស្រុក ខណ្ឌ ភូមិ ឃុំ បាន ជួបជុំគ្នា ដាល់ អំបុក និង ពិសា អំបុក យ៉ាង សប្បាយរីករាយ ក្នុង បរិយាកាស ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញ បរិបូរណ៌ ។
សូម ជម្រាប ថា ក្នុង ឱកាស ថ្លែង លើ វេទិកា សាធារណៈ នានា និង តាម បណ្តាញ សង្គម Facebook ក្តី សម្តេច តេជោ ហ៊ុន សែន តែងតែ បាន អំពាវនាវ សូមឲ្យ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ ចូលរួម ហូប អំបុក ពី ថ្ងៃទី ៩ ដល់ ថ្ងៃទី ១២ វិច្ឆិកា ដើម្បី ចូលរួម ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ៕
លោក ឧត្តមសេនីយ៍ ឯក ស្រី ឌឹក ដឹកនាំ កងទ័ព និង គ្រួសារ កងទ័ព ជួបជុំគ្នា ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ស្រី ឌឹក មេបញ្ជាការ រង កង ទព័ជើង គោក និង ជា មេបញ្ជាការ កងពល ធំ អន្តរាគមន៍ លេខ ៣ នៅ ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ព្រមទាំង គ្រួសារ ទ័ព បាន រៀបចំ ប្រារព្ធ ពិធី ពិសា អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ យ៉ាង សប្បាយរីករាយ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ ស្រី ឌឹក បាន ថ្លែង ថា ក្រៅពី តួនាទី ក្នុង ការពង្រឹង ការការពារ បូរណភាព ទឹកដី និង ភាពសុខសាន្ត ជូន ប្រជាពលរដ្ឋ នៅ តាម ព្រំដែន នោះ កងកម្លាំង ទាំងអស់ ទូទាំង កងពល ធំ បាន រៀបចំ ពិធី នេះ ឡើង យ៉ាង សប្បាយរីករាយ ស្រប តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
លោក ឧត្តមសេនីយ៍ ផ្កាយ៣ ស្រី ឌឹក បាន ឱ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការ សាមគ្គី គ្នា របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល មាន បំណង ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោរ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំង និង ពលរដ្ឋ នៅ ស្រុក ស្វាយអន្ទរ ហូប អំបុក សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ (Video inside)
( ព្រៃវែង ) ៖ នាយ ឧត្តមសេនីយ៍ យុន ឈុន្នី អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ស្វាយអន្ទរ តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ស្វាយអន្ទរ និង ស្រុក កញ្ជៀច ខេត្ត ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ មន្ត្រីរាជការ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស ក្រុម យុវជន កងកម្លាំង ទាំ បី ប្រភេទ និង ព្រះសង្ឃ ប្រជាពលរដ្ឋ នៅ ស្រុក ស្វាយអន្ទរ នាំគ្នា ហូប អំបុក សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ពិធី មាន នេះ ក៏ ការចូលរួម ពី ព្រះសង្ឃ ចំនួន ៤៨វត្ត និង មន្ត្រីរាជការ យុវជន សិស្សានុសិស្ស ប្រជាពលរដ្ឋ ប្រមាណ ជាង ២ពាន់ អង្គ / នាក់ នៅ សួនច្បារ មុខ សាលា ស្រុក ស្វាយអន្ទរ ។
នាយ ឧត្តមសេនីយ៍ យុន ឈុន្នី បាន ថ្លែង នូវ ការផ្តាំ សាកសួរ សុខទុក្ខ ពី នាយ ឧត្តមសេនីយ៍ ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ស្វាយអន្ទរ ជូន ដល់ អង្គ ពិធី និង ធ្វើ ការកោតសរសើរ ដល់ អាជ្ញាធរ ស្រុក ដែល បាន រៀបចំ ពិធី ហូប អំបុក នេះ ឡើង ដោយ បាន បង្ករឲ្យ ភាពសប្បាយរីករាយ ស្និតស្នាល និង សាមគ្គី គ្នា ជា ធ្លុង មួយ ដើម្បី ចូលរួម អភិវឌ្ឍន៍ ប្រទេស ជាមួយ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ។
លោក បាន ថ្លែង ជំរុញ ដល់ អាជ្ញាធរ ប្រជាពលរដ្ឋ កងកម្លាំង ទាំងអស់ ត្រូវ ចូល រក្សា ការពារ សុខ សន្តិភាព ឲ្យបាន យូអង្វែង ជា និរន្ត និង ប្រឆាំង ដាច់ខាត នូវ ការ ប៉ុនប៉ង ណាមួយ របស់ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល មាន ទណ្ឌិត សម រង្ស៉ី ចង់ ផ្តួលរំលំ រាជ រដ្ឋា ស្រប ច្បាប់ និង មាន គោលបំណង ផ្តួលរំលំ របប រាជានិយម ហើយ យើង ទាំងអស់ គ្នា ត្រូវតែ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង រាជ រដ្ឋាភិបាល ស្រប ដែល ប្រសូត្រ ចេញពី ការបោះឆ្នោត ត្រឹម ។
ក្នុង ពិធី នេះ បាន ហូប អំបុក ជួបជុំគ្នា នេះ បាន បង្ហាញ ពី ភាពស្និទស្នាល ខ្មែរ ស្រឡាញ់ ខ្មែរ រួបរួម គ្នា ថែរក្សា សន្តិភាព ជាមួយនឹង សំឡេង ចេញ ពី ភាសា បេះដូង នៃ ជន រួម ជាតិ យ៉ាង ដូច្នេះ ថា៖ « យើង ចូលរួម កសាង អំពើ ល្អ ចែករំលែក ក្តីស្រឡាញ់ និង ស្នាមញញឹម គ្រប់ ទីកន្លែង » ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅ នឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕
ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ និង ក្រសួង មហាផ្ទៃ ចុះ ទៅ សួរសុខទុក្ខ និង ហូប អំបុក ជាមួយ កងកម្លាំងប្រដាប់អាវុធ នៅ ច្រកទ្វារ អន្ដរជាតិ ប៉ោយប៉ែត
( បន្ទាយមានជ័យ )៖ ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ និង ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចុះ ទៅ សួរសុខទុក្ខ និង ហូប អំបុក ជាមួយ កងកម្លាំងប្រដាប់អាវុធ ដែល កំពុង ប្រចាំ ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ ជូន ពលរដ្ឋ នៅ ច្រកទ្វារ អន្ដរជាតិ ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
តំណាង នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង ដឹកនាំ ក្រុមការងារ ជួបជុំគ្នា ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កណ្ដាល ) ៖ តំណាង នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង ប្រធាន គណៈអចិន្ត្រៃយ៍ ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក កណ្ដាល ស្ទឹង នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ ក្រុមការងារ ជួបជុំគ្នា ទទួលទាន អំបុក ជាមួយ ចេក ទុំ ដូង ខ្ចី ទឹក ត្នោត ប្រកបដោយ បរិយាកាស សប្បាយរីករាយ ក្រៃលែង « អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ » ។
ការជួបជុំគ្នា ហូប អំបុក នេះ ធ្វើឡើង ក្នុង ពិធី សម្ភោធ អាគារ សាល ប្រជុំ គណបក្ស ឃុំ ទ្រា ស្រុក កណ្ដាល ស្ទឹង ក្រោម ការដឹកនាំ ដោយ លោក រឿង វុទ្ធី នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
ក្នុង របាយការណ៍ របស់ លោក អ៊ូច សាវឿន អភិបាល ស្រុក កណ្ដាល ស្ទឹង បាន ឲ្យដឹង ថា ដោយឡែក ការសាងសង់ អគារ សាល ប្រជុំ គណបក្ស ឃុំ ទ្រា ចាប់ផ្ដើម សាងសង់ ពី ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០១៩ មកដល់ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ដែល មាន ទទឹង ៩ម៉ែត្រ បណ្ដោយ ១៦ម៉ែត្រ ចំណាយ ថវិកា ចំនួន ២៧.០០០ ដុល្លារ អាមេរិក ដែល ជា អំណោយ របស់ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង និង ក្រុមការងារ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក រឿង វុទ្ធី បាន ថ្លែង ថា ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី បាន ខិតខំ ធ្វើឲ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថេរភាព នយោបាយ និង ការអភិវឌ្ឍន៍ រីកចំរើន លើ គ្រប់ វិស័យ ក៏ មកដល់ សព្វ ថ្ងៃ នេះ ។
លោក ក៏ បាន អបអរសាទរ ថ្ងៃ បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា ដែល ប្រទេស កម្ពុជា បាន ទទួល ឯករាជ្យ ពេញលេញ ពី អាណានិគម និយម បារាំង នៅ ឆ្នាំ ១៩៥៣ ក្រោម ព្រះរាជ បូជនីយកិច្ច ទាមទារ ឯករាជ្យ ពី ព្រះករុណា ព្រះមហា វីរក្សត្រ សម្ដេច ព្រះនរោត្តម សីហនុ ។
លោក បាន អំពាវនាវ ដល់ បងប្អូន ចូលរួម ថែរក្សា សន្តិភាព និង សមិទ្ធផល សង្គមជាតិ កុំ ជឿ តាម ការភូតកុហក បោកប្រាស់ របស់ ទណ្ឌិត សម រង្ស៊ី ដែល បាន ដើរ ហួស បន្ទាត់ ក្រហម ប៉ុន ពង ធ្វើ រដ្ឋប្រហារ ផ្ដួលរលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ និង ប្រមាថ ព្រះមហាក្សត្រ ឲ្យ ដាក់ រាជ្យ មាន ទោស ក្បត់ ជាតិ
លោក បន្ដ ថា ហើយ បើសិន មាន ការគាំទ្រ ទណ្ឌិត សម រង្ស៊ី នៅក្នុង មូលដ្ឋាន សូម ចេញមក សារភាព កុំ មាន ការភ័យខ្លាច ក្នុង ថ្ងៃ បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា និង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក អក អំបុក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ ចាប់ពី ថ្ងៃទី ១០ - ១១ - ១២ ខែវិច្ឆិកា ។
ក្នុង នាម សម្ដេច តេជោ ហ៊ុន សែន សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត និង លោក ហ៊ីង ប៊ុន ហៀង . លោក បាន នាំយក អំណោយ របស់ សម្ដេច ចែកជូន ដល់ ប្រជាពលរដ្ឋ ចំនួន ៤២០ នាក់ ក្នុង មួយ នាក់ ម្នាក់ ថវិកា ១៥.០០០ រៀល និង ក្រុមប្រឹក្សា ឃុំ សាលា ស្រុក ផងដែរ ។ កងទ័ព ត្រូវតែ អព្យាក្រឹត មិន ប្រកាន់ បក្សពួក ឬ បក្ស នយោបាយ ណាមួយ ទេ ។ ដាច់ខាត ត្រូវ ជៀសវាង អំពើហិង្សា ឬ ការបង្ហូរ ឈាម ណាមួយ ៕
លោក ដូណាល់ ត្រាំ កំពុង ពិចារណា ទៅកាន់ ទីក្រុង ម៉ូស្គូ ដើម្បី ចូលរួម ទិវា ជ័យជម្នះ របស់ រុស្ស៊ី
នៅពេល ត្រូវ ក្រុម អ្នកសារព័ត៌មាន សួរ តើ លោក អាចនឹង ទៅ ចូលរួម តាម ការអញ្ជើញ របស់ រុស្ស៊ី ដែរ ឬ យ៉ាងណា ? លោក ត្រាំ បាន ឆ្លើយតប វិញ ថា « វា ចំ រដូវកាល យុទ្ធនាការ ឃោសនា បោះឆ្នោត យ៉ាង សកម្ម ពេញ ទំហឹង តែម្តង តែ ខ្ញុំ ច្បាស់ជា នឹង ពិចារណា អំពី វា ខ្ញុំ នឹង មើល ថា តើ ខ្ញុំ អាច ឆ្លៀត ពេល ទៅ បាន ឬក៏ អត់ ប៉ុន្តែ ខ្ញុំ ពិតជា ចង់ ទៅ ចូលរួម ប្រសិនបើ អាច ធ្វើ បាន » ។
ការប្រកាស ដើរ ចេញ ដោយសារ ក្រុមគ្រួសារ មិន ពេញចិត្ត និង ឈប់ គាំទ្រ រាល់ សកម្មភាព ទាំងឡាយ របស់ ទណ្ឌិត សម រង្ស៊ី របស់ អតីត សមាជិក ដ៏ សកម្ម នៃ អតីត គណបក្ស សង្គ្រោះ ជាតិ លោក លឹម ហុង គៀង រូប នេះ បាន ធ្វើឡើង នៅ ចំពោះ មុខ លោក ប្រាជ្ញ សីហា សមាជិក អចិន្ត្រៃយ៍ និង ប្រធាន គណៈ ឃោសនា អប់រំ ខណ្ឌ ឫស្សីកែវ តំណាង លោក ជា ពិសី ប្រធាន គណបក្ស ខណ្ឌ នា រសៀល ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។
ជាមួយគ្នា នេះ ពួកគេ ទាំង ២នាក់ ក៏ បាន ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ផងដែរ ។
សមាជិក ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ទាំង ២នាក់ ដែល បាន ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា រួម មាន៖
ក្រោយ បញ្ចប់ ការសារភាព និង ធ្វើ កិច្ចសន្យា អាជ្ញាធរ បាន អនុញ្ញាតឲ្យ ពួកគេ ត្រឡប់ ទៅ ផ្ទះ វិញ ធម្មតា ។
ទណ្ឌិត សម រង្ស៉ី បាន ថ្លែង ថា « គម្រោង មាតុភូមិ និវត្តន៍ របស់ ថ្នាក់ដឹកនាំ គណបក្ស សង្គ្រោះ ជាតិ ប្រហែល ត្រូវ ពន្យារ ពេល បន្តិច ... . ពីព្រោះ ក្រុមហ៊ុន អាកាសចរណ៍ របស់ ថៃ មិន ឱ្យ ខ្ញុំ ឡើង លើ យន្តហោះ ដែល ត្រូវ ហោះ មក ប្រទេស ថៃ ដើម្បី ខ្ញុំ បន្ត ដំណើរ ទៅ ប្រទេស កម្ពុជា » ។
សកម្មភាព ទាំងនេះ ហើយ ដែល ទណ្ឌិត សម រង្ស៊ី និង បក្ខពួក ត្រូវបាន តុលាការ ចោទប្រកាប ពី បទល្មើស ឧបឃាត និង រួម គំនិត ក្បត់ ព្រមទាំង មាន ដីកា បង្គាប់ ឲ្យ ចាប់ខ្លួន ដែល តម្រូវឲ្យ រាជ រដ្ឋាភិបាល កម្ពុជា ចាំបាច់ ត្រូវតែ អនុវត្ត ច្បាប់ តាម ដីកាតុលាការ និង ចាត់ វិធានការ នានា ដើម្បី ការពារ រដ្ឋធម្មនុញ្ញ ការពារ សុខ សន្តិភាព ក្នុង នាម ជា រដ្ឋ ឯករាជ្យ និង អធិបតេយ្យ មួយ ដែល ទើបតែ ងើប ផុត ពី សង្គ្រាម ស៊ីវិល ដ៏ រ៉ាំរ៉ៃ និង របប ប្រល័យ ពូជសាសន៍ ដែល បាន បំផ្លិចបំផ្លាញ សង្គមជាតិ យើង ស្ទើរ រលាយ សូន្យ សុង ។
ទោះជា សម រង្ស៊ី និង បក្ខពួក បាន និង កំពុង ប្រឈមមុខ នឹង ផ្លូវ ច្បាប់ យ៉ាង ធ្ងន់ធ្ងរ យ៉ាងណា ក៏ដោយ ក៏ គេ មិន បោះបង់ ចោល នូវ ផែនការ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ដោយ កម្លាំង ខុស ច្បាប់ នោះ ឡើយ ហើយ នៅតែ ផ្គើន អះអាង អំពី ផែនការ នេះ ចំពោះ អ្នកគាំទ្រ មួយ ក្រុម តូច រហូតមកដល់ បច្ចុប្បន្ន ។ ប៉ុន្តែ ផែនការ នេះ មិន ត្រូវបាន ទទួលស្វាគមន៍ ដោយ សហគមន៍ អន្តរជាតិ និង ប្រជាពលរដ្ឋ ខ្មែរ នោះ ឡើយ ។
នៅ ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៩ លោកស្រី មួរ សុខ ហួរ ជា មនុស្ស ជំនិត នឹង ទណ្ឌិត សម រង្ស៊ី បាន សាកល្បង វិលត្រលប់ ដោយ ប្រើប្រាស់ ប្រទេស ថៃ ជា កន្លែង ផ្លាស់ប្តូរ យន្តហោះ ហើយ ត្រូវបាន នគរបាល អន្តោប្រវេសន្ដ ថៃ បដិសេធ មិន ឲ្យ ចូល ប្រទេស ក្រោម ហេតុផល ថា វត្តមាន របស់ លោកស្រី នៅក្នុង ប្រទេស នេះ អាច នាំឱ្យ មាន ភាពវិកវរ ក្នុង សង្គម ឬ ប៉ះពាល់ ដល់ សន្តិសុខ នៃ រដ្ឋ ។
លោក ប្រាយុទ្ធ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « យោង តាម ការប្តេជ្ញាចិត្ត របស់ យើង ចំពោះ អាស៊ាន យើង នឹង មិន ជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង របស់ គ្នា ទៅ វិញ ទៅ មក ទេ ហើយ យើង ក៏ នឹង មិន អនុញ្ញាតឱ្យ មាន អ្នកប្រឆាំង រដ្ឋាភិបាល ប្រើប្រាស់ ប្រទេស ថៃ សម្រាប់ ធ្វើ សកម្មភាព ដែរ » ។
ការប្រកាស របស់ ប្រទេស ថៃ មួយ លើក ជា ពីរ លើក នេះ ទណ្ឌិត សម រង្ស៊ី និង បក្ខពួក ពិតជា ដឹង យ៉ាង ច្បាស់ ហើយ ថា មិន អាច មាន វិធី ដឹកនាំ កម្លាំង របស់ ខ្លួន ចូលមក ប្រទេស កម្ពុជា បាន ឡើយ ប៉ុន្តែ លោក សម រង្ស៊ី នៅតែ បន្ត ភូត កុហក អ្នកគាំទ្រ ថា នឹង ចូលមក កម្ពុជា នៅ ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
រហូត ពេលនេះ ជាមួយនឹង ការបិទបាំង ភាពអាម៉ាស នៃ ការបរាជ័យ ក្នុង ផែនការចូលមក កម្ពុជា ទណ្ឌិត សម រង្ស៊ី និង បក្ខពួក បាន ខិតខំ ស្វែងរក លេស ជាច្រើន ដើម្បី ចោទប្រកាន់ ថា រដ្ឋាភិបាល កម្ពុជា ជា អ្នក រារាំង ។
ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្ត្រី មហាផ្ទៃ កម្ពុជា សម្តេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ ច្បាស់ ហើយ ថា ការពង្រាយ កងកម្លាំង នៅ តាម បណ្តោយ ព្រំដែន ជាពិសេស ជាប់ នឹង ប្រទេស ថៃ នោះ គឺជា ការត្រៀម អនុវត្ត តាម ដីកាតុលាការ ដើម្បី ចាប់ខ្លួន សមាជិក ក្រុម ឧទ្ទាម និង ដើម្បី ថែរក្សា សន្តិសុខ សណ្តាប់ សាធារណៈ និង របៀបរៀបរយ សាធារណៈ នៅ តាម តំបន់ ព្រំដែន គឺ ពុំ មែន ជា ការបិទ ច្រក ព្រំដែន នោះ ឡើយ ។
រហូតមកទល់ ពេលនេះ មិន មាន ការបិទ ច្រក ព្រំដែន ណាមួយ ឡើយ ហើយ សកម្មភាព ចរាចរ និង ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ឆ្លងកាត់ ព្រំដែន នានា មាន ដំណើការ ជាធម្មតា ។ នៅ ពេល នេះ មិន មាន ការប្រកាស ណា មួយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការហាម ប្រាម ទណ្ឌិត សម រង្ស៊ី និង ក្រុម របស់ គាត់ មិន ឲ្យ ចូល ប្រទេស ឡើយ ។
បាន ន័យ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នៅតែ គោរព និង អនុវត្ត យ៉ាង ខ្ជាបខ្ជួន នូវ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង គោរព សិទ្ធិ សេរីភាព របស់ ប្រជារាស្រ្ត ខ្មែរ គ្រប់ ៗ រូប ដោយ ស្មើភាព ។ ដូច្នេះ ការវិលត្រឡប់ ចូល ប្រទេស របស់ ទណ្ឌិត សម រង្ស៊ី និង បក្ខពួក ក្នុង នាម ជា ពលរដ្ឋ ខ្មែរ គឺ ពុំ មាន អ្វី រារាំង ឡើយ ។
ប៉ុន្តែ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន ប្រកាស ផងដែរ ពី ការរក្សា សិទ្ធិ ក្នុង ការចាត់ វិធានការ ច្បាប់ ចំពោះ សកម្មភាព ទាំងឡាយ ដែល ប៉ុនប៉ង បំផ្លិចបំផ្លាញ សន្តិភាព ស្ថិរភាព សង្គម និង សន្តិសុខ នៃ រដ្ឋ ដើម្បី ធានា ការពារ ឲ្យបាន ជាដាច់ខាត នូវ សន្តិភាព សន្តិសុខ និង សុវត្ថិភាព សង្គម ជូន ជាតិ និង ប្រជាជន កម្ពុជា ៕
អភិបាល ខណ្ឌ ឫស្សីកែវ ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ចូលរួម ពិធី ពិសា អំបុក ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ
ឆ្លៀត នា ឱកាស ក្រោយ ពិធី ដាល់ អំបុក និង ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ យ៉ាង សប្បាយរីករាយ ដែល ជា ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា . លោក ជា ពិសី បាន បន្ត ជំរុញ បន្ថែម ទៀត ឲ្យ សមត្ថកិច្ច និង មន្ត្រីរាជការ ទាំងអស់ ចូលរួម ថែរក្សា សន្តិសុខ សុវត្ថិភាព ឲ្យបាន ល្អ ប្រសើរ ជូន ដល់ បង - ប្អូន ប្រជាពលរដ្ឋ ក្នុង ឱកាស ពិធី បុណ្យ ឯករាជ្យ ជាតិ និង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក អក អំបុក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ ។
( ភ្នំពេញ ) ៖ ក្រោយ ជួប សំណេះសំណាល ជាមួយ ក្រុម កីឡាករ អុំ ទូក ប្រមាណ ជិត ៣០០ នាក់ មកពី ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា នេះ រួច មក លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន ដឹកនាំ ក្រុម កីឡាករ អុំ ទូក ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ក្រសួង ទេសចរណ៍ ទទួល អំបុក ខ្មែរ ជុំគ្នា ដើម្បី ពង្រឹង ស្មារតី រួមគ្នា ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ យ៉ាង ប្ដូរផ្ដាច់ ។
បរិយាកាស នៃ ពិធី អក អំបុក ដ៏ តូច តែ មាន អត្ថន័យ ធំ ធេង នេះ កើត ចេញ ពី ស្មារតី ឆន្ទៈ ពិតប្រាកដ របស់ ប្រជាពលរដ្ឋ អ្នកស្រុក បារាយណ៍ ។ ពួកគាត់ បាន តាំងចិត្ត ប្រឹងប្រែង អុំ ទូក នាំ ជ័យជម្នះ នាំ សុខ សន្តិភាព ឆ្ពោះទៅ មុខ ពន្លិច ឱ្យ អស់ រាល់ ក្រុម អគតិ ទាំងឡាយ ដែល ចង់ បំផ្លាញ សុខ សន្តិភាព ស្ថិរភាព និង ចង់ បំផ្លាញ ជាតិ សាសនា និង ព្រះមហាក្សត្រ នៃ កម្ពុជា ។
ក្នុង ពិធំ សំណេះសំណាល នា ពេល នោះ លោក រដ្ឋមន្ត្រី ថោង ខុន បាន ប្រកាស ជំនួយ ឧបត្ថម្ភ ដល់ ក្រុម កីឡាករ ទូក ទាំ៣ នេះ មាន ប្រមាណ ៣៨ លាន រៀល និង លុយ ដុល្លារ ប្រមាណ ១ម៉ឺន ដុល្លារ រួមទាំង ការឧបត្ថម្ភ អង្ករ ស្បៀង ភេសជ្ជៈ ទឹក បរិសុទ្ធ និង អំណោយ ផ្សេង ទៀត ជាច្រើន ( គិត ត្រឹម ថ្ងៃទី ០៩ នេះ ) ។
សូម ជម្រាប ថា ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល នឹង ត្រូវ ប្រារព្ធ ធ្វើ នៅ ថ្ងៃទី ១០ - ១១ - ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ខាងមុខ នេះ គឺ ធ្វើឡើង ដើមី្ប រំលឹក និង គោរព ដល់ វីរភាព របស់ បុព្វបុរស ទាហាន ជើង ទឹក ជំនាន់ ដើម ដែល បាន ពលី ជីវិត ក្នុង ការធ្វើ សឹក សង្រ្គាម តាម ផ្លូវ ទឹក កម្ចាត់ ពួក សត្រូវ ឈ្លានពាន ការពារ ទឹកដី ។
នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ គឺជា ខួប ៦៦ ឆ្នាំ ដែល ប្រជាជាតិ កម្ពុជា ទាំងមូល បាន រំដោះ ខ្លួន ទាំងស្រុង ចេញ ពី អាណានិគម បារាំង ក្រោម ព្រះរាជ បូជនីយកិច្ច ដឹកនាំ ដ៏ ក្លៀវខ្លា របស់ ព្រះមហា វីរក្សត្រ ខ្មែរ ព្រះបរម រតន កោដ្ឋ ព្រះករុណា ព្រះបាទ សម្តេច នរោត្តម សីហនុ ។ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ខ្មែរ ៩វិច្ឆិកា ត្រូវបាន ប្រជាជន កម្ពុជា ប្រារព្ធ ពិធី អបអរ ជារៀងរាល់ ឆ្នាំ ។
លោក ស៉ី ជីន ភីង បាន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ និង អបអរសាទរ ជូន ព្រះមហាក្សត្រ កម្ពុជា និង ប្រជាជន កម្ពុជា ដែល មាន ខ្លឹមសារ ទាំងស្រុង ដូចត ទៅ៖
សូម ប្រសិទ្ធ ពរ ឱ្យ ព្រះអង្គ មាន ព្រះរាជ សុខភាព ល្អ បរិបូរណ៌ និង សម្រេច ព្រះរាជ កិច្ច ដោយ ជោគជ័យ និង រលូន ។ សូម ជូនពរ ឱ្យ ប្រទេស កម្ពុជា មាន ភាពរុងរឿង ថ្កុំថ្កើង ប្រជាជន កម្ពុជា មាន សុភមង្គល និង សុខសាន្ត ត្រាណ ៕
ប្រធាន សាធារណរដ្ឋ ប្រជាមានិត ចិន ស៉ី ជីន ភីង ថ្ងៃទី ៩ វិច្ឆិកា ពី ក្រុង ប៉េកាំង
TinhTinh គ្រោង ចំណាយ ទឹកប្រាក់ ១០ម៉ឺន ដុល្លារ ជា កាដូ សម្រាប់ អតិថិជន ដែល បញ្ជាទិញ ផលិតផល តាម ប្រព័ន្ធ អេឡិចត្រូនិក ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក រយៈពេល ៣ ថ្ងៃ
( ភ្នំពេញ ) ៖ ដើម្បី ឆ្លើយតប នឹង ការគាំទ្រ របស់ អតិថិជន ស្រប ទៅនឹង គោលបំណង របស់ ក្រុមហ៊ុន ក្នុង ការផ្តល់ ជូន នូវ ភាពរីករាយ ដល់ ប្រជាជន កម្ពុជា ចំពោះ ការជាវ ផលិតផល ផ្ទាល់ ដោយ ធ្វើ ការបញ្ជាទិញ តាមរយៈ ប្រព័ន្ធ អេឡិចត្រូនិច ដូច ទៅនឹង បណ្តា ប្រទេស ដទៃ ទៀត ក្នុង អំឡុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ក្នុង ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩. TinhTinh បាន ចំណាយ ទឹកប្រាក់ សរុប ប្រមាណ ជា១០ម៉ឺន ដុល្លារ ជា កាដូ ជូន ដល់ អតិថិជន ។
ការផ្តល់ ជូន នេះ សម្រាប់ តែ ការបញ្ជាទិញ ( នៅ ស្តង់ និង គេហទំព័រ ) ដែល ត្រូវបាន ធ្វើឡើង ចាប់ពី ថ្ងៃទី ១០ ខែវិច្ឆិកា ដល់ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
បើ តាម អ្នកគ្រប់គ្រង ភោជនីដ្ឋាន « សួន ឫស្សី » បាន ឱ្យដឹង ថា ការរៀបចំ ឱ្យ មាន ការពិសា អំបុក នេះ បាន ធ្វើឡើង ស្រប តាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ។
លោក បាន បន្ត ថា ដូច្នេះ ក្នុង នាម ជា វិស័យ ឯកជន មួយ ដែល កំពុងតែ ប្រកបរបររស៊ី ដោយ សេរី នៅក្នុង ប្រទេស កម្ពុជា នោះ គឺ មាន តែ ទឹកចិត្ត បន្តិចបន្តួច ទៅ តាម លទ្ធភាព របស់ ខ្លួន ដោយ បាន រៀបចំ ពិធី ហូប អំបុក នេះ ឡើង ហើយ អំបុក ដែល រៀបចំ រយៈពេល ៤ ថ្ងៃ នេះ រួម មាន៖ អំបុក ទឹក ដូង ចេក និង ស្ករ ផែន ផងដែរ ។
ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រឡាញ់ សន្តិភាព ស្ថិរភាព នយោបាយ និង ការរីកចម្រើន លើ គ្រប់ វិស័យ ផងដែរ ។
ភោជនីយដ្ឋាន បៀរ ហ្គារ ដិន « សួន ឬ ស្សី » មាន រៀបចំ ម្ហូប សម្រាប់ ថ្ងៃត្រង់ ពេល ល្ងាច ព្រមទាំង មាន បម្រើ សេវាកម្ម រៀបចំ ខួបកំណើត ពិធី ជប់លៀង និង កម្មវិធី ផ្សេង ៗ ដែល មាន ទីតាំង ស្ថិត នៅ ផ្លូវ OCIC ត្រើយ ខាងកើត រង្វង់ មូល ជ្រោយ ចង្វារ ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។ បន្ថែម ពី នេះ អតិថិជន កក់តុ មុន នឹង បញ្ចុះ តម្លៃ ១០ភាគរយ លើ គ្រប់ មុខ ម្ហូប ផងដែរ ៕
រដ្ឋបាល ខេត្ត ព្រះវិហារ រៀបចំ ពិធី បុណ្យ ឯករាជ្យ ជាតិ លើក ទី៦៦ និង ពិសារ អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ព្រះវិហារ ) ៖ លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ប្រជាពលរដ្ឋ ប្រារព្ធ ធី បុណ្យ ឯករាជ្យ ជាតិ ខួប លើក ទី៦៦ និង ពិសារ អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្យ ក្រោម បរិយាកាស សប្បាយរីករាយ ។
ថ្លែង នៅក្នុង ឱកាស ប្រារព្ធ ពិធី បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា នា ឱកាស នេះ លោក ប្រាក់ សុវណ្ណ បាន ធ្វើ ការអំពាវនាវ ឱ្យ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ជាពិសេស ប្រជាពលរដ្ឋ ត្រូវ រួម គសាមគ្គី គ្នា ជា ធ្លុង មួយ ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដើម្បី ការពារ សុខ សន្តិភាព អធិបតេយ្យភាព និង ឯករាជ្យ របស់ ប្រទេស កម្ពុជា ឱ្យ ស្ថិតស្ថេរ គង់វង្ស ព្រោះ សន្តិភាព គឺជា គ្រឹះ យ៉ាង រឹងមាំ សម្រាប់ ប្រទេសជាតិ ធ្វើ ការអភិវឌ្ឍន៍ ឱ្យ កាន់តែ រីកចម្រើន ខ្លាំងក្លា ថែម ទៀត ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង ប្រារព្ធ ពិធី ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ស្វាយរៀង ) ៖ លោក ជុំ ហាត ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ម៉ែន វិបុល អភិបាល អភិបាល ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២១០៩ នេះ បាន អញ្ជើញ ចូលរួម ជា អធិបតី ក្នុង ពិធី មិទ្ទិញ អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៦៦ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា ( ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០១៩ ) និង ទិវា កំណើត នៃ កងយោធពល ខេមរភូមិន្ទ ឆ្នាំ ២០១៩ ។
ក្នុង ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម លោក លោកស្រី កម្លាំង ទាំង បី ប្រភេទ ប្រធាន មន្ទី អង្គភាព នានា ជុំវិញ ខេត្ត មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ទាំង ៣ប្រភេទ ព្រះសង្ឃ និស្សិត សាស្រ្តាចារ្យ លោកគ្រូ អ្នកគ្រូ យុវជន ស .ស .យ .ក . ខេត្ត យុវជន កាយ រឹទ្ធិ យុវជន កាកបាទ ក្រហម កម្ពុជា និង សិស្សានុសិស្ស ចូលរួម សរុប ប្រមាណ ជា ៤.០០០ អង្គ / នាក់ ។
បន្ទាប់មក ទៀត លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង និង លោក ជុក មុន្នី រដ្ឋលេខាធិការ ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ក្រុង ស្វាយរៀង លោក ណុប ចំរើន អភិបាល នៃ គណៈអភិបាល ក្រុង ស្វាយរៀង បាន ចូលរួម ពិសារ និង ដាល់ អំបុក ថែរក្សា ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ព្រមទាំង រាំ កម្សាន នៅ សួន ឯកឧត្តម ឯកឧត្តមសេនីយ៍ ហុក ឡង់ ឌី ពោធិ៍ ព្រឹក្ស និង តាម បណ្ដា សង្កាត់ ទាំង៧ ក្នុង ក្រុង ស្វាយរៀង ដោយ ភាពស្និទ្ធស្នាល និង សប្បាយរីក ប្រកបដោយ សាមគ្គីភាព ។
លោក តូច ប៉ូលីវ៉ា អភិបាល រង ខេត្ត ស្វាយរៀង បាន ថ្លែង ថា ការហូប អំបុក សាមគ្គី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ មាន ទូទាំង ខេត្ត ស្វាយរៀង ទាំង ៨០ ឃុំ សង្កាត់ ៦៩០ ភូមិ មាន គ្រប់ ភូមិ គ្រប់ វត្ត អារាម ៕ កម្លាំង អាវុធហត្ថ ទូទាំង ខេត្ត កំពង់ស្ពឺ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កំពង់ស្ពឺ ) ៖ ក្រៅពី ការពង្រឹង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម មូលដ្ឋាន និង តាម ច្រក ព្រំដែន នោះ កងកម្លាំង អាវុធហត្ថ ទូទាំង ខេត្ត កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នេះ ។
មន្រ្តី អាវុធហត្ថ បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
លោក អ៊ាវ ចំរើន ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ នៅ ឃុំ ស្អាង ភ្នំ ស្រុក ស្អាង ចូលរួម ពិធី ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កណ្ដាល ) ៖ ប្រធាន គណៈ ពង្រឹង ឃុំ ស្អាង ភ្នំ ស្រុក ស្អាង ខេត្ត កណ្ដាល លោក អ៊ាវ ចំរើន និង ប្រធាន - អនុប្រធាន ចុះ ជួយ ឃុំ ស្អាង ភ្នំ ស្រុក ស្អាង នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ សមាជិក សមាជិកា និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ចូលរួម ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ នេះ បាន បង្ហាញ ថា ប្រទេសជាតិ យើង មាន សុខ សន្ដិភាព ប្រជាពលរដ្ឋ សុខ សាន្ដ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ក្នុង ការទទួលទាន អំបុក នេះ គឺ ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
លោក អ៊ាវ ចំរើន បាន ឲ្យដឹង ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការប្រឆាំង ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឲ្យ ប្រជាពលរដ្ឋ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ដឹកនាំ ក្រុមការងារ កីឡាករ ប្រណាំង ទូក និង ប្រជាពលរដ្ឋ ក្នុង ស្រុក ល្វាឯ ម ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ
ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន បាន បញ្ជាក់ ទៀត ថា នៅក្នុង ឱកាស បុណ្យ ប្រពៃណី ជាតិ ដែល ជា ឱកាស ដែល ធ្វើឱ្យ បងប្អូន សប្បាយរីករាយ បែរជា ពួក ប្រឆាំង មួយ ក្តាប់ តូច នោះ មិន បាន នាំគ្នា អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ សប្បាយរីករាយ ជាមួយគ្នា នោះ ទេ បែរជា នាំគ្នា អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ធ្វើ អំពើ ខុស ច្បាប់ ទៅ វិញ ហើយ បើ ប្អូន ទៅ ធ្វើ តាម ពួក ប្រឆាំង នោះ និង មិន បាន អី ដល់ ប្អូន ក្រៅពី ទុក្ខវេទនា នោះ ទេ ព្រោះ បើ ប្រទេស អសន្តិសុខ ហើយ យើង មិន អាច រស់ នៅ បាន ស្រួល នោះ ទេ ។
ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ក៏ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម សប្បាយរីករាយ ទាំងអស់ គ្នា ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក អក អំបុក និង បណ្ដែត ប្រទី ប សំពះ ព្រះខែ ទាំងអស់ គ្នា និង មិន ត្រូវ ជឿជាដាច់ខាត ទៅ លើ ក្រុម ក្បត់ ជាតិ ដែល តែងតែ កុហក បងប្អូន ប្រជាពលរដ្ឋ រហូតមក ។
នៅក្នុង ឱកាស នោះ ដែរ លោក គង់ វិបុល ក៏ បាន ណែនាំ ដល់ ក្រុមការងារ គណៈកម្មការ និង ក្រុម កីឡាករ ទូក ង ត្រូវ គោរព វិន័យ បទបញ្ជា មាន សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ល្អ និង ចេះ យោគយល់ អធ្យាស្រ័យ គ្នា ទៅ វិញ ទៅ មក ពិសេស ត្រូវ ខិតខំ រួម កម្លាំង គ្នា ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ល្បឿន ទូក .ង បាន កាន់តែ លឿន ជាង មុន ថែម ទៀត និង យក ជ័យជម្នះ ឱ្យ បាន ដើម្បី ជួយ លើកកម្ពស់ មុខមាត់ ជូន ខេត្ត ។
សូម ជម្រាប ថា នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ជា ខួប លើក ទី៦៦ ទិវា បុណ្យ ឯករាជ្យ ជាតិ និង ក៏ ជា ថ្ងៃ ដែល បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ចូលរួម ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ដែល ជា ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ប្រឆាំង គម្រោង ធ្វើ រដ្ឋប្រហារ និង ផ្តួលរំលំ របប រាជានិយម ពីសំណាក់ ក្រុម ឧទ្ទាម ក្បត់ ជាតិ សម រង្ស៉ី ៕ កម្លាំងប្រដាប់អាវុធ ដែល កំពុង ឈរជើង ការពារ សន្តិសុខ នៅ ព្រលានយន្ដហោះ កង កេង ខេត្ត ព្រះសីហនុ រៀបចំ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ព្រះសីហនុ) ៖ ក្រៅពី ការពង្រឹង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម មូលដ្ឋាន និង ប្រចាំ ការការពារ នៅ ព្រលានយន្ដហោះ កង កេង ខេត្ត ព្រះសីហនុ ដើម្បី អនុវត្ត ច្បាប់ ចំពោះ ជន ក្បត់ ជាតិ និង បក្ខពួក នោះ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នេះ ដឹកនាំ ដោយ នាយ ឧត្តមសេនីយ៍ ថោង លីម អគ្គ ស្នងការ រង នគរបាល ជាតិ ដែល ដឹកនាំ ប្រចាំ ការ នៅ ព្រលានយន្ដហោះ កង កេង ខេត្ត ព្រះសីហនុ ។
លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ ទំព័រ Facebook ផ្លូវការ របស់ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ ត្រូវ ជន អនាមិក លួច យក ទៅ គ្រប់គ្រង . លោក ប្រកាស មិន ទទួលខុសត្រូវ
កម្លាំង អាវុធហត្ថ ទូទាំង ខេត្ត ស្ទឹងត្រែង ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ស្ទឹងត្រែង ) ៖ ក្រៅពី ការពង្រឹង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម មូលដ្ឋាន និង តាម ច្រក ព្រំដែន នោះ កងកម្លាំង អាវុធហត្ថ ទូទាំង ខេត្ត ស្ទឹងត្រែង នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ពិធី ដែល បាន ធ្វើឡើង យ៉ាង សប្បាយរីករាយ តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា នេះ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ ឌី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ។
លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ ឌី បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ថ្នាក់ដឹកនាំ ស្ថាប័ន អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ នាំគ្នា ហូប អំបុក សាមគ្គី អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩នេះ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន នាំគ្នា រៀបចំ ពិធី ហូប អំបុក សាមគ្គី អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ក្រោម បរិយាកាស ស្និតស្នាល សប្បាយរីករាយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ ទណ្ឌិត សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោល ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ មនុស្ស ប្រមាណ ៣ម៉ឺន នាក់ ត្រូវ រំពឹង នឹង ចូលរួម ពិព័រណ៍ ម្ហូប អាហារ ចុង ខែ នេះ
ពិរព័ណ៍ នេះ មាន ឈ្មោះ ថា « កូន ស្លាបព្រា » នឹង មាន ការចូលរួម សហការ ជា ដោយ ស្ថាប័ន សង្គម ស៊ីវិល និង រដ្ឋាភិបាល ជាច្រើន ដូចជា ក្រសួង អប់រំ យុវជន និង កីឡា សហភាព សហព័ន្ធ យុវជន កម្ពុជា ក្រសួង ទេសចរណ៍ អង្ក ការ UNDP និង ស្ថាប័ន ជាច្រើន ទៀត ។
ក្រៅពី ភាពសប្បាយរីករាយ និង ការចងចាំ ល្អ ៗ សម្រាប់ ក្រុមគ្រួសារ ទាំងអស់ កូន ស្លាបព្រា គឺជា ឱកាស ដ៏ ល្អ សម្រាប់ ក្រុមហ៊ុន ដែល នៅក្នុង និង ខាងក្រៅ ឧស្សាហកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ ដើម្បី ដាក់ តាំង បង្ហាញ ពី ផលិតផល និង សេវាកម្ម របស់ ពួកគេ ដល់ អ្នកចូលរួម ទាំងអស់ ។
ពិព័រណ៍ នេះ នឹង ក្លាយជា ឱកាស ដើម្បី អនុវត្ត សុវត្ថិភាព ចំណីអាហារ និង និរន្តរភាព តាមរយៈ ការកសាង សមត្ថភាព លើ ការប្រឆាំង នឹង ថ្នាំ សំលាប់ មេរោគ និង ការបែងចែក កាកសំណល់ បូករួម ទាំង ការផ្តល់ ជម្រើស អេកូឡូស៊ី សម្រាប់ ការវេច ខ្ចប់ ជំនួស ប្លាស្ទិច ។
កូន ស្លាបព្រា ធ្វើឡើង ស្រប ពេល ជាមួយនឹង ព្រឹត្តិការណ៍ ដ៏ ធំ មួយ ទៀត សម្រាប់ ប្រទេស កម្ពុជា គឺ ការប្រកួត ជើងឯក ប៉េតង់ ពិភពលោក ។ តាម ការគ្រោងទុក នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ការប្រកួត ពានរង្វាន់ នេះ នឹង នាំ ភ្ញៀវ រា ប់រយ នាក់ រួមទាំង អត្ត ពលិក មកពី ជាង ៤០ ប្រទេស ទៅ ពហុកីឡាដ្ឋាន ជាតិ អូឡាំពិក រួម មាន ម្ចាស់ ជើងឯក កម្ពុជា កញ្ញា អ៊ុកស្រី មុំ និង ម្ចាស់ មេដាយ មាស ៣សម័យ លោក កែវ ឡេង ។
( កណ្តាល ) ៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
សម្រាប់ នៅ ឃុំ ដើម ឬ ស ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល នា ព្រឹក ថ្ងៃ នេះ លោក បណ្ឌិត ដួង ហេង ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ បាន រៀបចំ និង ដឹកនាំ យុវជន និង ប្រជាពលរដ្ឋ ជាង ១០០០ នាក់ ចូលរួម ហូប អំបុក និង ប្រារព្ធ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០១៩ និង ទិវា កំណើត កងយោធពល ខេមរភូមិន្ទ យ៉ាង សប្បាយរីករាយ ។
លោក បណ្ឌិត ដួង ហេង បាន ឱ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ លោក បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ លោក បណ្ឌិត ដួង ហេង ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។
នៅក្នុង ឱកាស នោះ ក្នុង នាម ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន . លោក បណ្ឌិត ដួង ហេង បាន ផ្តាំផ្ញើ ការសួរសុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ដិត ហ៊ីង ប៊ុន ហៀង និង លោកស្រី ជូន ចំពោះ ប្រជាពលរដ្ឋ ។ លោក ថា ទីណា ប្រជាពលរដ្ឋ មាន ទុក្ខលំបាក ទីនោះ តែងតែ មាន ក្រុមការងារ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការណែនាំ របស់ សម្តេច តេជោ ចុះ ទៅ ជួយ ភ្លាម ៗ មិន ឲ្យ ពលរដ្ឋ ណារងគ្រោះ ឬ អត់ឃ្លាន ដោយសារ អត់ អាហារ នោះ ឡើយ ។
ពាក់ព័ន្ធ នឹង បញ្ហា ប្រទេសជាតិ វិញ លោក បណ្ឌិត ដួង ហេង នៅតែ លើកឡើង និង ចាត់ទុក តម្លៃ សន្តិភាព របស់ ជាតិ មិន អាច កាត់ថ្លៃ បាន ឡើយ ពោល មិន ថា តែ នៅក្នុង ឃុំ ដើម ឬ ស នោះ ទេ ប៉ុន្តែ នៅ ទូទាំង ប្រទេស ប្រជាពលរដ្ឋ ដើរ ហើរ គ្រប់ ទីកន្លែង ប្រកប មុខរបរ និង មាន ជីវភាព កាន់តែ ធូរធាពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
ប្រជាពលរដ្ឋ បាន ប្រកាស ផងដែរ ថា ពួកគាត់ នឹង គំាទ្រ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី គ្រប់ អាណត្តិត ទៅ មុខ ទៀត ។
នៅក្នុង ឱកាស នោះ លោក ដួង ហេង ក៏ បាន ចែក ថវិកា ជា ទ្រនាប់ ដៃ ជូន ប្រជាពលរដ្ឋ សិស្សានុសិស្ស និង ក្មេង ៗ សរុប ជិត ២០ លាន រៀល ផងដែរ ៕ លោក ឈឹម សារ៉េត ជួបជុំ ជាមួយ ប្រជាពលរដ្ឋ នៅ ឃុំ កំពង់ចំលង និង ឃុំ បាក់ ដាវ ស្រុក ខ្សាច់ កណ្តាល ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កណ្តាល ) ៖ លោក ឈឹម សារ៉េត ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន លទ្ធកម្ម សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ កំពង់ចំលង និង ឃុំ បាក់ ដាវ ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្តាល រួម ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន បាន រៀបចំ ពិធី ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ប្រកបដោយ ក្តី សោមនស្ស រីករាយ សាមគ្គីភាព មិត្តភាព ក្នុង សុខ សន្តិភាព មួយ ពេញ ផ្ទៃ ប្រទេស ។
កងកម្លាំងប្រដាប់អាវុធ មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ កម្ពុជា ទូទាំង ប្រទេស បាន បង្ហាញ នូវ ការគាំទ្រ ពេញ ទំហឹង ទទួល អនុវត្ត ដោយ ស្មោះស្ម័គ្រ ចំពោះ ការជួបជុំ ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ និង បាន ត្រៀម លក្ខណៈ សម្បត្តិ រួច ជាស្រេច ក្នុង ការចូលរួម ទប់ស្កាត់ រាល់ ការបំផ្លាញ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ចំណែក ពិធី អក អំបុក សំពះ ព្រះខែ ត្រូវបាន ពណ៌នា ថា គឺជា ពិធី មួយ ដែល គេ ធ្វើឡើង ដើម្បី ឧទ្ទិស ដល់ ការបំពេញ បុណ្យ បារមី របស់ ព្រះពោធិសត្វ ក្នុង ពេល ដែល យោន យក កំណើត ជា សត្វ ទន្សាយ ។ បណ្ឌិត ដែល ជា ទន្សាយ ពោធិសត្វ បាន បូជា ព្រះកាយ ដោយ លោត ចូល គំនរ ភ្លើង ដ៏ ធំ ដើម្បី ចម្អិន សាច់ ឲ្យ ឥន្ទ ព្រាហ្មណ៍ ដែល កំពុង ស្រេកឃ្លាន បរិភោគ ជា អាហារ ។ ការណ៍ នេះ បាន ធ្វើឲ្យ ព្រះឥន្ទ្រ យក ថ្ម ទៅ គូស ជា សត្វ ទន្សាយ នៅ មណ្ឌល ព្រះច័ន្ទ ។
ផ្អែក លើ ជំនឿ និង ការគោរព បូជា តាម បែប ព្រះពុទ្ធ សាសនា ប្រជាពលរដ្ឋ ខ្មែរ បាន ប្រារព្ធ ពិធី អក អំបុក ត ៗ គ្នា ដោយ បាន រៀបចំ រណ្តាប់ គ្រឿង សក្ការៈបូជាជាច្រើន មុខ រួម ជាមួយ អំបុក ចេក ទុំ ដូង ស្ករ ត្នោត ឬ ស្ករ ស និង ផ្លែ ឈើ ថ្វាយ ដល់ ព្រះច័ន្ទ ឧទ្ទិស បួងសួង សុំ សេចក្តីសុខ ចម្រើន គ្រប់ ៗ រូប រហូតដល់ ពេល បច្ចុប្បន្ន ។ ប្រជាជន ខ្មែរ និយម បរិភោគ អំបុក ជាមួយ ចេក ទុំ ដូង ស្ករ ត្នោត ឬ ស្ករ ស ទៅ តាម ចំណូលចិត្ត រៀង ៗ ខ្លួន និង តាម តំបន់ នីមួយ ៗ ៕
តំណាងរាស្រ្ដ មណ្ឌល កំពង់ចាម ដឹកនាំ សមាជិក សមាជិកា និង ប្រជាពលរដ្ឋ ចូលរួម ពិធី ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កំពង់ចាម ) ៖ តំណាងរាស្ដ្រ មណ្ឌល កំពង់ចាម សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក ជើង ព្រៃ លោក បណ្ឌិត ម៉ា ឈឿន នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ សមាជិក សមាជិកា និង ប្រជាពលរដ្ឋ ចូលរួម ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ការទទួលទាន អំបុក នេះ ក៏ ជា ការប្រឆាំង ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕
( ត្បូងឃ្មុំ ) ៖ នា ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ បាន ប្រារព្ធ ខួប លើក ទី ៦៦ នៃ ទិវា បុណ្យ ឯករាជ ជាតិ ៩ វិច្ឆិកា ១៩៥៣ - ៩វិច្ឆិកា ២០១៩ និង ទិវា កំណើត កងយោធពល ខេមរភូមិន្ទ ដែល បាន តស៊ូ យ៉ាង ជោគជ័យ រំដោះ ទឹកដី ចេញ ផុត ពី នឹម ត្រួតត្រា អាណានិគម និយម បារាំង និង ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ បរិវេណ មុខ សាលា ខេត្ត ក្រោម អធិបតីភាព លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ គណៈ អភិបាល ខេត្ត សមាជិក ក្រុមប្រឹក្សា ខេត្ត មន្ទីរ អង្គភាព មន្រ្តី រាជការ នានា ជុំវិញ ខេត្ត កងកម្លាំង ទាំង៣ ប្រភេទ សិស្ស និស្សិត យុវជន និង ប្រជាពលរដ្ឋ ចូលរួម ប្រមាណ ៤ពាន់ នាក់ ។
លោក ជា ម ច័ន្ទ សោភ័ណ ថ្លែង ថា ខួប អនុស្សាវរីយ៍ លើក ទី ៦៦ នៃ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា ទូទាំង ប្រទេស កម្ពុជា តែងតែ ប្រារព្ធ ធ្វើជា រៀងរាល់ ឆ្នាំ ព្រោះ ជា ទិវា ប្រវត្តិសាស្ត្រ ដ៏ រុងរឿង ដែល កម្លាំង មហាសាមគ្គី របស់ ប្រជាជាតិ ទាំងមូល ដណ្តើម បាន ទាំងស្រុង មកវិញ ពី អាណានិគម និយម បារាំង នា ឆ្នាំ ១៩៥៣ នូវ ឯករាជ្យ ពិតប្រាកដ ក្រោម ព្រះរាជ បូជនីកិច្ច ដ៏ ថ្លៃថ្លា នៃ ព្រះបរម រតន កោដ្ឋ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហនុ ព្រះមហា វីរក្សត្រ ព្រះវរ រាជ បិតា ជាតិ នៃ យើង ទាំងអស់ គ្នា ។
អភិបាល ខេត្ត បាន បន្ត ទៀត ថា សម្តេច ព្រះនរោត្តម សីហនុ ព្រះអង្គ ជា បិតា សន្តិភាព ព្រះបិតា បង្រួបបង្រួម និង ផ្សះផ្សារ ជាតិ ទ្រង់ បាន លះបង់ នូវ ព្រះកាយ ពល ព្រះបញ្ញា ញាណ រក គន្លឹះ ដោះស្រាយ បញ្ហា កម្ពុជា រហូត ទទួលបាន សុខ សន្តិភាព រស់ ក្រោម ដំបូល ឆ័ត្រ តែ មួយ គឺ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក អភិបាល ខេត្ត បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ក្រោម ម្លប់ របស់ ព្រះមហាក្សត្យ កម្ពុជា តែងតែ ដង្ហែរ តាម ព្រះរាជ តំរិះ ដ៍ ថ្លៃថ្លា ជារៀងរហូតមក ។ លោក បន្ត ថា ដោយសារ ការខិតខំ ប្រឹងប្រែង យ៉ាង ខ្លាំង របស់ ប្រមុខ រាជ រដ្ឋាភិបាល បាន ធ្វើឲ្យ សង្គមជាតិ ទាំងមូល មាន ការអភិវឌ្ឍន៍ រីកចំរើន លើ គ្រប់ វិស័យ ។
ក្នុង ឱកាស នោះ លោក បាន ប្តេជ្ញា ថា នឹង ប្រើប្រាស់ កម្លាំង សរុប មធ្យោបាយ សរុប និង គ្រប់ រូបភាព ទាំងអស់ ដើម្បី ទប់ស្កាត់ ទាំង វិធានការ ច្បាប់ រដ្ឋបាល សាធារណមតិ និង ការទូត ឲ្យបាន ជាដាច់ខាត នូវ ល្បិច បោកប្រាស់ អំពើ ក្បត់ ជាតិ និង ការប៉ុនប៉ង់ រដ្ឋាភិបាល ស្រប ច្បាប់ ដោយ ទណ្ឌិត សម រង្សី និង បក្ខពួក របស់ ខ្លួន ទោះ ក្នុង តម្លៃ ណា ក៏ដោយ ៕
រដ្ឋបាល ខេត្ត កំពង់ធំ ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កំពង់ធំ )៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
សម្រាប់ នៅ ខេត្ត កំពង់ធំ នា ព្រឹក ថ្ងៃ នេះ លោក ឈុន ឈន់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ និង លោកស្រី បាន រៀបចំ និង ដឹកនាំ មន្រ្តី រាជការ យុវជន និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ចូលរួម ហូប អំបុក និង ប្រារព្ធ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០១៩ និង ទិវា កំណើត កងយោធពល ខេមរភូមិន្ទ យ៉ាង សប្បាយរីករាយ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ កងកម្លាំងប្រដាប់អាវុធ មន្ត្រីរាជការ ប្រជាពលរដ្ឋ សិស្សានុសិស្ស ប្រមាណ ៥.០០០ នាក់ ។
លោក ឈុន ឈន់ បាន ឱ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
លោក ឈុន ឈន់ បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ លោក សុខ លូ ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ លោក បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
( ត្បូងឃ្មុំ ) ៖ បងប្អូន សាសនិក ឥស្លាម នៅ ភូមិ ៥ ឃុំ ស្វាយ ឃ្លាំង ស្រុក ក្រួចឆ្មារ នា រសៀល ថ្ងៃទី ៩ វិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ជួបជុំគ្នា នៅក្នុង ស៊ូរ៉ាវ អាត់ តាក់ វ៉ា ដើម្បី ចូលរួម អបអរសាទរ ពិធី ពិសារ អំបុក តប តាម ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
សាសនិក ខ្មែរ មូស្លីម នៅ ភូមិ នេះ បាន គោរព តាម យ៉ាង ខ្ចាប់ ខ្ចួន នូវ ការ អំពាវនាវ របស់ សម្ដេច នាយក រដ្ឋមន្ត្រី ខណៈ អំបុក ត្រូវបាន ពលរដ្ឋ ខ្មែរ មូស្លីម លាយ ជាមួយ ទឹក ដូង ទឹកដោះគោ ទឹកដោះគោ ខាប់ ទឹក ដូង ឆ្ងុយ ឆ្ងាញ់ ខណៈ ដែល ពួកគាត់ បាន ពិសារ យ៉ាង សប្បាយ ចិត្ត ពោរពេញ ដោយ ចិត្ត សប្បាយរីករាយ ឥត ឧបមា ។
សាសនិក ឥស្លាម ក្នុង ភូមិ បាន សំដែង ចំណាប់អារម្មណ៍ ដ៏ មាន តម្លៃ មាន ន័យ ដូចគ្នា ថា ពួកគាត់ ពិសារ អំបុក នេះ គឺ ដើម្បី អបអរសាទរ ពិធី ពិសា អំបុក សាមគ្គី ជាតិ ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ដែល នេះ សបញ្ជាក់ ពី តម្លៃ នៃ សុខ សន្តិភាព ភាពជាតិ ឯកភាព ជាតិ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
បងប្អូន ខ្មែរ មូស្លីម នៅ មូលដ្ឋាន ភូមិ៥ ឃុំ ស្វាយ ឃ្លាំង ស្រុក ក្រូចឆ្មារ នេះ បាន សំដែង នូវ អំណរ អរគុណ ដល់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន បើក ទូលាយ ដល់ សាសនិក ឥស្លាម និង បាន ដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន សុខ សន្តិភាព ការអភិវឌ្ឍន៍ សុខដុមនីយកម្ម សាសនា ដ៍ ល្អ ប្រសើរ និង មាន ក្ដី សុខ ៕
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល នឹង ប្រព្រឹត្ដទៅ នៅ ថ្ងៃទី១០ - ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ទូរទស្សន៍ Fresh News បាន ធ្វើ កិច្ចសម្ភាស ជាមួយ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា ពី ការសហការ ចូលរួម ជាមួយ អាជ្ញាធរ សាធារណៈ ក្នុង ការរៀបចំ សណ្ដាប់ ធា្នប់ និង សុខុមាលភាព ជូន ប្រជាពលរដ្ឋ ។
លោកស្រី ម៉ែន នារី សោភ័គ បាន ថ្លែង ថា កាកបាទ ក្រហម កម្ពុជា ដែល ជា ស្ថាប័ន នាំមុខ គេ ក្នុង ការងារ មនុស្សធម៌ និង ដើរ តួនាទី យ៉ាង សំខាន់ បំផុត ជា ជំនួយការ ឱ្យ អាជ្ញាធរ សាធារណៈ ជួយ សម្រាល ទុក្ខលំបាក របស់ បងប្អូន ប្រជាពលរដ្ឋ ដែល ងាយ រងគ្រោះ និង រងគ្រោះ បំផុត ពី គ្រោះមហន្ដរាយ ផ្សេង ៗ ទៀត ។ លើស ពី នោះ កាកបាទ ក្រហម កម្ពុជា ក៏ មាន សកម្មភាព ការងារ ជាច្រើន ផ្សេង ទៀត ដើម្បី ជួយ ដល់ សង្គមជាតិ ។
ជាពិសេស « អំឡុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល នឹង ប្រារព្ធ ធ្វើឡើង នៅ ថ្ងៃទី១០ - ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ខាងមុខ កាកបាទ ក្រហម កម្ពុជា សហការ ជាមួយ ក្រសួង សុខាភិបាល មន្ទីរ បរិស្ថាន រាជធានី ភ្នំពេញ រួម ជាមួយ អ្នក ពាក់ព័ន្ធ ផ្សេង ទៀត ក្នុង ការងារ សុវត្ថិភាព ចរាចរណ៍ ការអប់រំ ផ្សព្វផ្សាយ ពី ការថែទាំ សុខភាព - អនាម័យ នឹង ចូលរួម ក្នុង ការសម្អាត បរិស្ថាន នៅ តាម គោលដៅ មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ ផងដែរ » ។
ក្នុង ឱកាស នោះ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា បាន អំពាវនាវ ផ្ដាំផ្ញើ ជាមួយនឹង សារ អប់រំ គន្លឹះ មួយចំនួន ទៀត ផងដែរ ៕
សូម លោក អ្នកនាង ទស្សនា វីដេអូ កិច្ចសម្ភាស ដែល មាន ដូច ខាងក្រោម នេះ៖ រដ្ឋមន្ត្រី ឆាយ ថន និង មន្រ្តី រាជការ នៃ ក្រសួង ផែនការ ជួបជុំគ្នា ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ផែនការ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នៃ ក្រសួង ផែនការ ជួបជុំគ្នា ចូលរួម អបអរសាទរ ទិវា បុណ្យ ឯករាជ្យ ជាតិ លើក ទី៦៦ ( ៩ វិច្ឆិកា ១៩៥៣ - ៩ វិច្ឆិកា ២០១៩ ) និង ទទួលទាន អំបុក ជាមួយ ចេក ទុំ ដូង ខ្ចី ទឹក ត្នោត ជាមួយ ក្រុមគ្រួសារ មន្ត្រីរាជការ នៃ ក្រសួង ផែនការ ប្រកបដោយ បរិយាកាស សប្បាយរីករាយ ក្រៃលែង « អំបុក ខ្មែរ ថែរជាតិ សាសនា និង ព្រះមហាក្សត្រ » ។
លោក រដ្ឋមន្រ្តី ឆាយ ថន បាន ឲ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
លោក រដ្ឋមន្រ្តី ឆាយ ថន បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ រដ្ឋមន្ត្រី ក្រសួង ផែនការ ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឲ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕
ប្រជាពលរដ្ឋ នៅ ឃុំ កណ្តែ ក ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប សប្បាយរីករាយ ការទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( សៀមរាប ) ៖ លោក តា លោកយាយ ព្រមទាំង ប្រជាពលរដ្ឋ ទូទាំង ឃុំ កណ្តែ ក ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម និង សម្តែង នូវ ភាពសប្បាយរីករាយ ជាមួយនឹង ការទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ការរៀបចំ ទទួលទាន អំបុក របស់ ប្រជាពលរដ្ឋ នៅ ឃុំ កណ្តែ ក ក៏ ដូចជា ប្រជាពលរដ្ឋ និង បណ្តា ក្រសួង - អង្គភាព និង ប្រជាពលរដ្ឋ នៅ ខ្មែរ ដែល រស់ នៅ ក្រៅ ស្រុក បាន បង្ហាញ ពី ការគាំទ្រ ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ធ្វើឱ្យ ប្រទេសជាតិ មាន សន្តិភាព ពេញលេញ និង សម្បូរសប្បាយ ជាមួយនឹង ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ទៅ មុខ ជាលំដាប់ ។
គ្រាន់តែ មកដល់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា នេះ ភ្លាម គេ ឃើញ តាម បណ្តា ក្រសួង ស្ថាប័ន រដ្ឋ និង ឯកជន ព្រមទាំង ប្រជាពលរដ្ឋ តាម បណ្តា ខេត្ត ក្រុង ស្រុក ខណ្ឌ ភូមិ ឃុំ បាន ជួបជុំគ្នា ដាល់ អំបុក និង ពិសា អំបុក យ៉ាង សប្បាយរីករាយ ក្នុង បរិយាកាស ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញ បរិបូរណ៌ ។
សូម ជម្រាប ថា ក្នុង ឱកាស ថ្លែង លើ វេទិកា សាធារណៈ នានា និង តាម បណ្តាញ សង្គម Facebook ក្តី សម្តេច តេជោ ហ៊ុន សែន តែងតែ បាន អំពាវនាវ សូម ឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ ចូលរួម ហូប អំបុក ពី ថ្ងៃទី ៩ ដល់ ថ្ងៃទី ១២ វិច្ឆិកា ដើម្បី ចូលរួម ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ៕
ស្មារតី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ បង្កប់ ក្នុង ពិធី ហូប អំបុក នៅ ក្រសួង ការងារ
( ភ្នំពេញ ) ៖ ៩ វិច្ឆិកា គឺជា ថ្ងៃ ដែល កម្ពុជា ប្រារព្ធ ពិធី បុណ្យ ឯករាជ្យ ជាតិ និង ជា ថ្ងៃ បុណ្យ កំណើត នៃ កងយោធពល ខេមរភូមិន្ទ ផង នោះ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន រៀបចំ ពិធី ហូប អំបុក ខ្មែរ « ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ » ដើម្បី បង្ហាញ ពី ការរួបរួម សាមគ្គី ជា កម្លាំង ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង ជ្រោង ទង់ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ជាតិ ។
ប្រជារាស្រ្ត ខ្មែរ ទូទាំង នគរ រួបរួម សាមគ្គី គាំទ្រ រាល់ វិធានការ ផ្លូវ ច្បាប់ ទាំងអស់ របស់ រាជ រដ្ឋាភិបាល ប្រឆាំង ដាច់ខាត នូវ ទង្វើ រដ្ឋប្រហារ រដ្ឋធម្មនុញ្ញ រដ្ឋប្រហារ ដូរ របប រាជានិយម និង រដ្ឋប្រហារ ទម្លាក់ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ពីសំណាក់ មេ ច លនា ឧទ្ទាម ក្រៅ ច្បាប់ សម រង្ស៊ី និង គូកន ។
៩ វិច្ឆិកា ប្រជារាស្រ្ត ខ្មែរ សូម ចូលរួម អបអរសាទរ ប្រារព្ធ ទិវា ឯករាជ្យ ជាតិ ខ្មែរ និង ចូលរួម ពិធី ទទួលទាន អំបុក ខ្មែរ ដើម្បី ថែរក្សា ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ឱ្យ បាន ស្ថិត ស្ថិរ គង់វង្ស ជាដាច់ខាត ដូច្នះ ស្មារតី ៩វិច្ឆិកា គឺ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
កម្មវិធី ដ៏ មាន សារៈសំខាន់ នេះ រៀបចំឡើង កហរោម ការចូលរួម ពី លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល លោកស្រី វី សាឌី អនុប្រធាន គណៈកម្មការ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ក្លែងក្លាយ ព្រមទាំង មាន វត្តមាន របស់ តំណាង ស្ថានទូត ស្ថាប័ន ពាណិជ្ជកម្ម និង ក្រុមហ៊ុន ជាតិ - អន្តរជាតិ ជាច្រើន ផ្សេង ទៀត ។
លោកស្រី បន្ដ ថា គំនិត ផ្តួចផ្តើម គំនិត បង្កើត កម្មវិធី ដ៏ មាន សារៈសំខាន់ នៅ ថ្ងៃ នេះ ជា ការឆ្លើយតប យ៉ាង ល្អ ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ការអភិវឌ្ឍ វិស័យ ពាណិជ្ជកម្ម ជាពិសេស អាជីវកម្ម ពាក់ព័ន្ធ នឹង សុខភាព បង្កើន ភាពរីកចម្រើន ប្រកបដោយ ភាពវិជ្ជមាន និង អនុលោម ទៅតាម លក្ខខណ្ឌ ត្រឹមត្រូវ ដែល កំណត់ ដោយ ក្រសួង សុខាភិបាល ។
លោក ឧកញ៉ា បន្ដ ថា បច្ចុប្បន្ន នេះ ប្រទេស កម្ពុជា កំពុង មាន សុខ សន្តិភាព និង ស្ថិរភាព ល្អ ដែល កម្រិត នៃ ការរស់នៅ របស់ ប្រជាជន កាន់តែ ប្រសើរឡើង ជាមួយនឹង កំណើន សេដ្ឋកិច្ច ដ៏ ល្អ ។ហេតុ នេះ នៅពេល មនុស្ស មាន ការរស់នៅ កាន់តែ ប្រសើរ នោះ ពួកគាត់ នឹង ចាប់ផ្តើម គិតគូ កាន់តែ ច្រើន លើ គុណភាព នៃ ការរស់នៅ និង ភាពស្រស់ស្អាត ដែល ធ្វើឱ្យ វិស័យ សម្ផស្ស ក្លាយជា វិស័យ ប្រកបដោយ សក្តានុពល មួយ នៅ កម្ពុជា ទាំង ពេល បច្ចុប្បន្ន និង អនាគត ។
ទោះបី ទណ្ឌិត សម រង្ស៊ី មក ឬ មិន មក កម្ពុជា មិន ជា រឿង សំខាន់ នោះ ទេ សូម បងប្អូន កុំ មាន ការព្រួយបារម្មណ៍ ពី សន្តិសុខ សង្គម ឱ្យ សោះ ។ បច្ចុប្បន្ន នេះ ក្រោម ការដឹកនាំ របស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន និង កំពុង ដឹកនាំ ប្រទេស ឆ្ពោះ ទៅរក ការអភិវឌ្ឍ ក្រោម ម្លប់ សន្តិភាព រក្សា ធានា បាន សន្តិសុខ សុវត្ថិភាព សណ្ដាប់ធ្នាប់ សង្គម ទូទាំង ប្រទេស រក្សា បាន នូវ បូរណភាព ទឹកដី មាន កិត្យានុភាព ជាតិ ស្មើ មុខមាត់ ជាមួយ ប្រទេស ដ៍ទៃ នៅលើ ពិភពលោក ។
លោក Shipton នា ថ្ងៃសុក្រ សប្តាហ៍ នេះ បាន ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន នៅ ទីក្រុង ហ្សឺណែវ ក្នុង ប្រទេស ស្វីស ថា កូនប្រុស លោក នឹង អាច បាត់បង់ជីវិត នៅក្នុង ពន្ធនាគារ ហើយ នេះ មិន មែន ជា ការសម្តែង ក្តី ខក បំណង របស់ ឪពុក ម្នាក់ នោះ ឡើយ ប៉ុន្តែ វា គឺជា ការពិត ជាក់ស្តែង ។
ពលរដ្ឋ ទូទាំង ឃុំ ភ្នំ សំពៅ ខេត្ត បាត់ដំបង រៀបចំ ពិធី អប អំបុក ខ្មែរ ថែរក្សា ជាតិ សាសនា ព្រះមហាក្សត្រ
លោក ហែម ថេង បាន ធ្វើ ការបូកសរុប ក្នុង វេទិកា នេះ ថា រាល់ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ទាំងអស់ នា ពេលនេះ ក្នុង នាម ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ត្រូវ យកមក ដោះស្រាយ ជូន គាត់ នៅ តា មូលដ្ឋាន របស់ ពួកគាត់ ឲ្យបាន ទាន់ ពេលវេលា ហើយ ក្រុមការងារ យើង ធ្វើ ការ ទាំង ការងារ នៅ មូលដ្ឋាន និង ការងារ ស្នូល របស់ ខ្លួន យើង ដោយ មិន អាច ខាន មួយ ណា បាន ឡើយ ។
បន្ទាប់មក គណៈអធិបតី បាន ចូលរួម ហូប អក អំបុក សន្តិភាព ដើម្បី អបអរសាទរ ក្នុង ទិវា បុណ្យ ឯករាជ ជាតិ លើក ទី ៦៦ ថ្ងៃទី ៩ វិច្ឆិកា និង ទិវា ខួបកំណើត ទិវា កំណើត នៃ កងយោធពល ខេមរភូមិន្ទ នេះ ផងដែរ ។ លោក ក៏ បាន ឧត្ថម អ្នកចូលរួម ជាង ៣០០ នាក់ ម្នាក់ ទទួលបាន ២ម៉ឺន រៀល ។ ដោយឡែក កម្មវិធី អក អំបុក ធ្វើ តាម ភូមិ ទាំង១០ ផងដែរ ៕ ថ្នាក់ដឹកនាំ គ្រឹស្ទ បរិស័ទ និង ថ្នាក់ដឹកនាំ ក្រសួង ធម្មការ និង សាសនា ជួបជុំគ្នា ហូប អំបុក សាមគ្គី អក អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ
លោក សៀ សុភ័ក្រ្ត បន្ថែម ទៀត ថា ស្នាមញញឹម នៃ គ្រឹស្ទ បរិស័ទ កម្ពុជា បាន បង្ហាញ នូវ ការគាំទ្រ ថែរក្សា សន្តិភាព សម័យ តេជោ សែន ដើម្បី នាវា កម្ពុជា ឆ្ពោះ ទៅការអភិវឌ្ឍន៍ ប្រកប ដោយ និរន្តរភាព ទាំង ក្នុង តំបន់ និង ឆាក អន្តរជាតិ ។ ឯករាជ បូរណភាព ទឹកដី សន្តិភាព គឺជា អ្វី ៗ ទាំងអស់ ដែល ប្រជាពលរដ្ឋ នៅ ទូទាំង សកលលោក ប្រាថ្នា ចង់បាន និង រស់ នៅ ប្រកបដោយ ក្តីសង្ឃឹម ៕ លោក វង្សី វិស្សុត ដឹកនាំ ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ នៅ ស្រុក មុខ កំពូល
( ភ្នំពេញ ) ៖ ស្រប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ប្រជាពលរដ្ឋ កម្ពុជា នៅ ទូទាំង ប្រទេស កំពុងតែ ចូលរួម យ៉ាង សប្បាយរីករាយ ហូប អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
មិន ត្រឹមតែ ប៉ុណ្ណោះ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ នេះ បាន ប្រមាថ ដល់ អង្គ ព្រះមហាក្សត្រ ដែល ត្រូវបាន ការពារ ដោយ ច្បាប់ និង ជា ទី ស្កការៈ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស ដែល ប្រការ នេះ គឺជា ការរំលោភបំពាន លើ រដ្ឋធម្មនុញ្ញ ដែល ជា ច្បាប់ កំពូល របស់ ប្រទេស យ៉ាង ជាក់ស្តែង មិន អាច ប្រកែក បាន ។ រាជ រដ្ឋាភិបាល នឹង ប្រើប្រាស់ គ្រប់ មធ្យោបាយ ទាំងអស់ ដើម្បី ទប់ស្កាត់ នូវ រាល់ សកម្មភាព ទាំងឡាយ ដែល ប៉ុនប៉ង បង្ក ចលាចល នៅក្នុង ប្រទេស កម្ពុជា ។
លោក បាន វង្សី វិស្សុត បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សូម រួបរួម គ្នា ជា កម្លាំង មហាសាមគ្គី ជាតិ ខ្មែរ ទាំងមូល ដើម្បី ការពារ និង ថែរក្សា សន្តិភាព ដែល សម្រេច បាន មក ដោយ លំបាក លំបិន នេះ ឱ្យ ស្ថិតស្ថេរ គង់វង្ស ដើម្បី ការអភិវឌ្ឍ . ការរីកចម្រើន រុងរឿង និង ភាពសុខដុមរម្យ នា របស់ សង្គមជាតិ ខ្មែរ ដើម្បី នាំ នាវា កម្ពុជា ឆ្ពោះ ទៅកាន់ ត្រើយ សុខ សន្តិភាព យូរអង្វែង វឌ្ឍនភាព វិបុលភាព និង យុត្តិធម៌ សង្គម ។
ទន្ទឹមនឹង នេះ លោក ក៏ បាន ស្នើសុំ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ បន្ត ចូលរួម ពិធី ពិសារ អំបុក សាមគ្គី ជាតិ និង កំសាន្ត សប្បាយ នៅក្នុង ព្រះរាជ ពិធី បុណ្យ អ៊ុទូក អក អំបុក និង សំពះ ព្រះខែ ដោយ កុំ មាន ការព្រួយបារម្ភ ពី បញ្ហា សុវត្ថិភាព អ្វី ឲ្យ សោះ ព្រោះ ប្រទេសជាតិ យើង មាន សុខ សន្តិភាព ១០០ % ហើយ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ធានា ការពារ សុខ សុវត្ថិភាព សាធារណៈ និង សុវត្ថិភាព បងប្អូន ប្រជាពលរដ្ឋ មិន ឲ្យ មាន បញ្ហា អ្វី កើតឡើង នោះ ទេ ៕
រដ្ឋមន្រ្តី លឹម គាន ហោ ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ ទូទាំង ស្រុក ពញា ឮ ខេត្ត កណ្តាល រៀបចំ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
ជាក់ស្តែង នា ព្រឹក ថ្ងៃសៅរ៍ ទី៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ពញា ឮ បាន ចូលរួម ពិសារ អំបុក សាមគ្គី ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ក្នុង ស្មារតី អបអរសាទរ ថ្ងៃ បុណ្យ ឯករាជ្យ ជាតិ និង រក្សា ឲ្យបាន នូវ សុខ សន្តិភាព សម្រាប់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស តាម ប្រសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ពិធី ដ៏ សប្បាយរីករាយ នេះ ប្រារព្ធ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ពញា ឮ ដោយ មាន ការចូលរួម ពី បងប្អូន ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។ លោក រដ្ឋមន្ត្រី បាន បន្ត ដំណើរ ចុះ និង ចូលរួម អបអរសាទរ ពិសារ អំបុក នៅ តាម បណ្តា ឃុំ ទាំង ១១ របស់ ស្រុក ពញា ឮ ដែល បាន និង កំពុង ប្រារព្ធ ពិធី ពិសារ អំបុក សាមគ្គី នេះ ផងដែរ ។
លោក រដ្ឋមន្រ្តី លឹម គាន ហោ បាន ឱ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។ លោក បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ប្រជាពលរដ្ឋ ខ្មែរ អនិក ជន ទាំងនោះ បាន សម្តែង ភាពរីករាយ ជាមួយនឹង ការទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ហើយ បង្ហាញ ពី ការគាំទ្រ ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ធ្វើឱ្យ ប្រទេសជាតិ មាន សន្តិភាព ពេញលេញ និង សម្បូរសប្បាយ ជាមួយនឹង ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ទៅ មុខ ជាលំដាប់ ។
សូម ទស្សនា វីដេអូ ប្រជាពលរដ្ឋ ខ្មែរ រស់ នៅ សហរដ្ឋ អាមេរិក ហូប អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ខាងក្រោម នេះ៖
កម្លាំង អាវុធហត្ថ ទូទាំង ខេត្ត ព្រៃវែង ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ព្រៃវែង ) ៖ ក្រៅពី ការពង្រឹង ការការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព នៅ តាម មូលដ្ឋាន និង តាម ច្រក ព្រំដែន នោះ កងកម្លាំង អាវុធហត្ថ ទូទាំង ខេត្ត ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ដោយឡែក នៅ សួនច្បារ « សម្តេច ជា ស៊ីម » ក៏ មាន មន្ត្រីរាជការ តាម មន្ទីរ ជុំវិញ ខេត្ត ប្រជាពលរដ្ឋ សិស្សានុសិស្ស យ៉ាង ច្រើន កុះករ ចូលរួម ដាល់ អំបុក ហូប ជួបជុំគ្នា បង្ហាញ ពី ភាពស្និទស្នាល ខ្មែរ ស្រឡាញ់ ខ្មែរ រួបរួម គ្នា ថែរក្សា សន្តិភាព ជាមួយនិង សំឡេង ចេញ ពី ភាសា បេះដូង នៃ ជន រួម ជាតិ យ៉ាង ដូច្នេះ ថា៖ « យើង ចូលរួម កសាង អំពើ ល្អ ចែករំលែក ក្តីស្រឡាញ់ និង ស្នាមញញឹម គ្រប់ ទីកន្លែង » ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ ទេសរដ្ឋមន្រ្តី លី ធុជ ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ ហូប អំបុក ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( រតនគិរី ) ៖ នា ឱកាស ប្រារព្ធ បុណ្យ ឯករាជ្យ ជាតិ លើក ទី៦៦ នៃ ព្រះរាជាណាចក្រ កម្ពុជា នា ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ បាន លើកឡើង ថា ក្រោម ផ្ទៃ មេឃ ដ៏ ស្រស់ស្អាត ប្រទេស កម្ពុជា ទើប ទទួលបាន នូវ សុខ សន្តិភាព ពេញលេញ រយៈពេល ជាង ២០ ឆ្នាំ បន្ទាប់ពី បាន ហែល ឆ្លង ផុត ពី របប ប្រល័យ ពូជសាសន៍ និង ការបញ្ចប់ នូវ សង្រ្គាម ស៊ីវិល ដ៏ រ៉ាំរ៉ៃ នៅ ចុង ឆ្នាំ ១៩៩៨ ក្រោម គោល នយោបាយ « ឈ្នះ - ឈ្នះ » របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ។
ជាមួយគ្នា នេះ លោក ទេសរដ្ឋមន្រ្តី បាន ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ ចូលរួម ហូប អំបុក ដើម្បី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ខេត្ត រតនគីរី ផងដែរ ។
សមិទ្ធិផល ជា ប្រវត្តិសាស្រ្ត ក្រោម ការពលី និង ការលះបង់ ដ៏ ខ្ពង់ខ្ពស់ ដោយ មិន ខ្លាច ការនឿយហត់ របស់ សម្តេច តេជោ ប្រទេស កម្ពុជា សម្រេចបាន និង ប្រែក្លាយជា ប្រជាជាតិ តែ មួយ ទឹកដី តែ មួយ និង គ្រួសារ ខ្មែរ តែ មួយ ដែល មិន ធ្លាប់ មាន ក្នុង ប្រវត្តិសាស្រ្ត ជាង ១៥០ ឆ្នាំ ចុងក្រោយ នេះ ។
ជាមួយនឹង ម្លប់ សុខ សន្តិភាព និង ក្រោម ជើង មេឃ ដ៏ ស្រស់ស្អាត នេះ ប្រជាជន កម្ពុជា មាន ឱកាស ច្រើន ឥត ដែន កំណត់ សម្រាប់ ការកសាង នូវ អនាគត មួយ ដ៏ រុងរឿង ។ យើង នឹង បន្ត ធ្វើ ការរួមគ្នា ដើម្បី កសាង ប្រទេស យើង សម្រាប់ យើង ទាំងអស់ គ្នា និង សម្រាប់ អនាគត កូន ចៅ របស់ យើង ក្រោម ទស្សនៈ វិស័យ ដឹកនាំ ដ៏ វែងឆ្ងាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង រាជ រដ្ឋាភិបាល ម្ពុជា ដែល មាន សម្តេច តេជោ ជា ប្រធាន និង ជា នាយក រដ្ឋមន្រ្តី ។
លោក ទេសរដ្ឋមន្រ្តី បាន អំពាវនាវ ឲ្យ ប្រជាជន ទាំងអស់ គ្នា ត្រូវ ស្រឡាញ់ ប្រទេស យើង ស្រឡាញ់ ប្រជាជន និង អ្នកជិតខាង យើង ស្រឡាញ់ និង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា និង សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ៕ រដ្ឋបាល រាជធានី ភ្នំពេញ ចាប់ផ្ដើម ពង្រាយ ធុង សំរាម នៅ តាម សួនច្បារ និង ចិញ្ចើមផ្លូវ សាធារណៈ សម្រាប់ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
មន្ទីរ សាធារណការ រាជធានី ភ្នំពេញ បាន សរសេរ យ៉ាង ដូច្នេះ ថា « នៅ ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន និង កំពុង ពង្រាយ ធុង សំរាម ចំនួន ១៥៥៦ ធុង នៅ តាម សួនច្បារ និង ចិញ្ចើមផ្លូវ សាធារណៈ ក្នុង តំបន់ សប្បាយ ភាព ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ។ សូម ចូលរួម ការគ្រប់គ្រង សំរាម ឲ្យបាន ដើម្បី បរិស្ថាន និង សុខភាព ! » ។
សូម ជម្រាប ថា ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ មាន រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១២ ខែវិច្ឆិកា នៅក្នុង រាជធានី ភ្នំពេញ ។ ដើម្បី រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ដើរលេង កម្សាន្ត ក្នុង ព្រះរាជ ពិធី នេះ រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ដាក់ពង្រាយ កងកម្លាំងប្រដាប់អាវុធ សរុប ជិត ២ម៉ឺន នាក់ ។
ក្រៅពី កម្លាំងប្រដាប់អាវុធ ជិត ២ម៉ឺន នាក់ នេះ រាជ រដ្ឋាភិបាល បាន ត្រៀម កម្លាំង ពិសេស ផ្សេង ទៀត ដើម្បី ត្រៀម ការពារ និង អន្ដរាគមន៍ ពេល មាន បញ្ហា ផ្សេង ៗ ។ ក្នុង នោះ ក្រុម គ្រូពេទ្យ ក៏ ត្រូវបាន ដាក់ពង្រាយ ដើម្បី ជួយ ដល់ ប្រជាពលរដ្ឋ មាន បញ្ហា សុខភាព ផងដែរ ។
ប្រជាពលរដ្ឋ មួយចំនួន ទាំង អ្នក នៅ រាជធានី ភ្នំពេញ និង តាម បណ្តា ខេត្ត ផង ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ មក នេះ បាន បង្ហាញ ក្តី ព្រួយបារម្ភ មួយ ខ្លាច មាន បាតុភាព ចលាចល កើតឡើង ក្នុង រាជធានី ភ្នំពេញ នៅ ថ្ងៃ ប្រារព្ធ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ បន្ទាប់ពី ក្រុម ជន ក្បត់ ជាតិ ដឹកនាំ ដោយ សម រង្ស៉ី រៀបចំ គម្រោង វិល ចូលមក កម្ពុជា វិញ ។
ក្នុង ពិធី ពិសា អំបុក « ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ » នៅ ទីតាំង វត្តភ្នំ នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ លោក ឃួង ស្រេង បាន ឱ្យដឹង ថា កងកម្លាំងប្រដាប់អាវុធ ជាច្រើន នាក់ ត្រូវបាន ដាក់ពង្រាយ ដើម្បី រក្សា ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ដើរលេង កម្សាន្ដ សប្បាយ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ ។
« សន្ដិសុខ សណ្ដាប់ធ្នាប់ ព្រមទាំង ប្រជាពលរដ្ឋ នៅក្នុង រាជធានី ភ្នំពេញ របស់ យើង នេះ ទទួលបាន សុខ សន្ដិភាព យ៉ាង ពេញលេញ ទាំង ចរាចរណ៍ ទាំង សណ្ដាប់ធ្នាប់ ទាំង សន្ដិសុខ បងប្អូន ប្រជាពលរដ្ឋ យើង អត់ មាន ការព្រួយបារម្ភ ទេ ។ ជាពិសេស ទៀត យើង សង្កេត នៅ តាម ទីផ្សារ អត់ មាន អតិផរណា ទេ ទំនិញ រក្សា តម្លៃ ដដែល ។ នេះ ជា ការជឿជាក់ របស់ ប្រជាជន ទៅ លើ រាជ រដ្ឋាភិបាល » ។ លោក ឃួង ស្រេង បញ្ជាក់ ។
លោក បាន បន្ថែម ទៀត ថា « មិន មាន បាតុភាព អ្វី កើតឡើង ទេ ដោយសារ ប្រជាពលរដ្ឋ សព្វ ថ្ងៃ នេះ លោក ជឿជាក់ លើ ការដឹកនាំ របស់ សម្តេច តេជោ ។ មាន សម្តេច តេជោ មាន សន្តិភាព មាន សេដ្ឋកិច្ច រីកចម្រើន អ៊ីចឹង ទេ គាត់ ជឿជាក់ លើ បញ្ហា នេះ ណាស់ » ។
អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង ក៏ បាន អំពាវនាវ ដល ប្រជាពលរដ្ឋ នៅក្នុង រាជធានី ភ្នំពេញ និង នៅ ទូទាំង ប្រទេស អាច មក ដើរលេង កម្សាន្ដ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក នៅ រាជធានី ភ្នំពេញ ឱ្យ បាន ច្រើន កុះករ ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នឹង រៀបចំ ប្រារព្ធ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១២ ខែវិច្ឆិកា នៅក្នុង រាជធានី ភ្នំពេញ ។ ដើម្បី រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ដើរលេង កម្សាន្ត ក្នុង ព្រះរាជ ពិធី នេះ រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ដាក់ពង្រាយ កងកម្លាំងប្រដាប់អាវុធ សរុប ជិត ២ម៉ឺន នាក់ ។
លោកស្រី មួរ សុខ ហួរ ដែល កំពុង ស្ថិត នៅ ទីក្រុង កូឡាឡំ ពួរ ប្រទេស ម៉ាឡេស៊ី ទី ដែល គេ វាស់ ដី ឲ្យ ដើរ នោះ បាន លួច ផ្តល់ បទសម្ភាសន៍ ជាមួយ វិទ្យុ អាស៊ី សេរី កាលពី យប់ ថ្ងៃទី ៨ វិច្ឆិកា ដោយ បាន ប្រើ ភាសា បោកប្រាស់ អ្នកគាំទ្រ របស់ ខ្លួន ជាពិសេស ពលករ នៅ ប្រទេស ថៃ ឲ្យ ចេញមុខ ក្រោកឈរ ធ្វើ ចលនា ដោយ មិន ចាំបាច់ រង់ចាំ មេដឹកនាំចូលរួម ទេ ។
ពាក្យសម្តី នេះ ខុសពី ការអះអាង កាលពី មុន ដែល ថា លោក សម រង្ស៊ី និង ថ្នាក់ដឹកនាំ អតីត បក្ស សង្គ្រោះ ជាតិ ផ្សេង ទៀត នឹង មក ដឹកនាំ ក្បួន ផ្ទាល់ ចូល កម្ពុជា ។ លោកស្រី មួរ សុខ ហួរ បាន ខិតខំ បញ្ចុះបញ្ចូល អ្នកគាំទ្រ របស់ ខ្លួន ដែល ជា ពលរដ្ឋ ស្លូត ត្រង់ ឲ្យ ធ្លាក់ ក្នុង អន្ទាក់ របស់ ខ្លួន ហើយ ហ៊ាន ប្រព្រឹត្ត ល្មើស ច្បាប់ ក្នុង ផែនការ រដ្ឋប្រហារ ថ្ងៃ ៩ វិច្ឆិកា ដោយ មាន វិទ្យុ អាស៊ី សេរី ជា អ្នក ចាក់ ចេក ចាក់ ស្ករ ។
ចំណែកឯ លោក សម រង្ស៉ី និង មួរ សុខ ហួរ ខ្លួន ឯង ដេក ក្នុង បន្ទប់ ម៉ាស៊ីន ត្រជាក់ ធ្វើ ព្រងើយ ហើយ រង់ចាំ មើល ពី ចម្ងាយ ។ នេះ បាន ចំជា អ្នកនយោបាយ ដែល យក ពលរដ្ឋ ធ្វើ ឈ្នាន់ ដើម្បី កេង ចំណេញ នយោបាយ លើ ខ្នង រាស្ត្រ ដ៏ អាក្រក់ និង ឃោរឃៅ បំផុត ។ អ្នកនយោបាយ បែប នេះ គេ ហៅ ថា ជា អ្នកនយោបាយ ដ៏ ថោក ទាប បំផុត ដែល រស់ ដោយសារ ជញ្ជក់ ឈាម និង ទឹកភ្នែក របស់ ពលរដ្ឋ ស្លូត ត្រង់ ជាពិសេស គឺ សកម្មជន និង អ្នកគាំទ្រ របស់ ខ្លួន ។
ប៉ុន្តែ ផែនការ វិល ចូល ស្រុក វិញ នៅ ថ្ងៃ ៩ វិច្ឆិកា របស់ លោក សម រង្ស៊ី ពិតជា បាន បរាជ័យ ទាំងស្រុង ពីព្រោះ នៅ ចាប់ពី ព្រលឹម រហូតដល់ ថ្ងៃត្រង់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា នេះ ស្ថានការណ៍ នៅ ប៉ោយប៉ែត មាន សភាព ស្ងប់ស្ងាត់ ធម្មតា ដោយ គ្មាន អ្វី កើតឡើង ទាំងអស់ ។ មាន មូលហេតុ មួយចំនួន ដែល អាច បញ្ជាក់ ថា ផែនការ របស់ សម រង្ស៉ី បាន បរាជ័យ៖
* មូលហេតុ ទី១៖ ដោយសារតែ មេ ច លនា ឧទ្ទាម ខុស ច្បាប់ គឺ លោក សម រង្ស៊ី និង គូក ន មិន អាច ឈានជើង ចូល ទឹកដី ថៃ បាន ឡើយ ពីព្រោះ អាជ្ញាធរ ថៃ បាន បិទ រូបថត លោក សម រង្ស៊ី និង គូក ន ដែល ជា ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ និង មាន ដីកា ចាប់ខ្លួន នៅ គ្រប់ ទីកន្លែង ទាំងអស់ ។ បើ ហ៊ាន អើត ក្បាល ច្បាស់ជា ត្រូវ អាជ្ញាធរ ថៃ ចាប់ខ្លួន បញ្ជូន មក កម្ពុជា ជា មិន ខាន ។
ដូច្នេះ គ្មាន អ្វី ដែល យើង ត្រូវ ឆ្ងល់ និង មន្ទិល សង្ស័យ ទៀត ទេ ព្រោះ ចលនា ឬ សកម្មភាព ណាមួយ ពិតជា មិន អាច សម្រេចបាន នោះ ទេ បើ គ្មាន មេដឹកនាំ គឺ ប្រៀប ដូចជា សត្វ ពស់ ដែរ បើ អត់ ក្បាល ក៏ មិន អាច វារ ទៅ មុខ បាន ដែរ ។ បើ និយាយ ឲ្យ ខ្លី ផែនការ រដ្ឋប្រហារ ៩ វិច្ឆិកា នេះ គឺ រលាយ រលត់ ព្រោះ អត់ ក្បាល ម៉ាស៊ីន ដឹកនាំ ផ្ទាល់ ហើយ ចង់ យក ពលរដ្ឋ ធ្វើជា ឈ្នាន់ តែ ប៉ុណ្ណោះ ។
បើ និយាយ តាម បែប ផ្សេង ក្នុង សមរភូមិ មួយ បើ គ្មាន មេដឹកនាំ ឬ បើ មាន មេទ័ព មហាកំសាក ដូច សម រង្ស៊ី ប្រាកដជា ចាញ់ ១០០ ភាគរយ ពីព្រោះ គ្មាន កូន ទាហាន ណា ហ៊ាន ចេញមុខ ច្បាំង នោះ ឡើយ ។
* មូលហេតុ ទី ៣៖ អាជ្ញាធរ ថៃ មិន អនុញ្ញាតឲ្យ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ធ្វើ សកម្មភាព ណាមួយ នៅលើ ទឹក ដី របស់ គេ ដើម្បី ប្រឆាំង នឹង ប្រទេស ជិតខាង ឡើយ ។ នេះ ជា គោលការណ៍ របស់ អាស៊ាន ផង និង ជា កិច្ចសហការណ៍ រវាង ប្រទេស ជិតខាង ផង ។ ដូច្នេះ ប្រសិនបើ ហ៊ាន ប្រមូលផ្តុំ ឬ ធ្វើ សកម្មភាព អ្វី មួយ ច្បាស់ជា ត្រូវ អាជ្ញាធរ ថៃ ចាប់ខ្លួន ជា មិន ខាន ។
ពលករ ខ្មែរ ដែល ស្នាក់ នៅ និង ធ្វើ ការលើ ទឹកដី ថៃ ប្រាកដជា បាន ដឹង ច្បាស់ ពី ច្បាប់ នៅ ស្រុក ថៃ ថា តឹង តែង យ៉ាងណា ។ ដូច្នេះ ពួកគេ មិន ចាញ់ ការបោកប្រាស់ របស់ សម រង្ស៉ី និង មួរ សុខ ហួរ ឡើយ ហើយ បើ ហ៊ាន ធ្វើ សកម្មភាព គឺ ពិតជា ត្រូវ អាជ្ញាធរ ថៃ ចាប់ ញាត់ ទ្រុង ជាក់ ជា មិន ខាន ។
* មូលហេតុ ទី៤៖ នៅ ខាង ភាគី កម្ពុជា វិញ សមត្ថកិច្ច ក៏ បាន ឈរជើង ការពារ សន្តិសុខ យ៉ាង រឹងមាំ ដែរ ដោយ មិន អនុញ្ញាតឲ្យ កម្លាំង ខុស ច្បាប់ ណាមួយ មក បំផ្លាញ សុខ សន្តិភាព និង សណ្តាប់ធ្នាប់ សាធារណៈ បាន ឡើយ ជាពិសេស ក្នុង កំឡុង ពេល បុណ្យ ឯករាជ្យ ជាតិ និង បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក នេះ ។ ប្រសិនបើ មាន សកម្មភាព មិន ប្រក្រតី កើតឡើង សមត្ថកិច្ច នឹង ចាត់ វិធានការ ភ្លាម យ៉ាង មាន ប្រសិទ្ធភាព បំផុត ។
* មូលហេតុ ទី ៥៖ ពលរដ្ឋ ខ្មែរ នៅក្នុង ប្រទេស ឯណេះ វិញ កំពុង សប្បាយរីករាយ អបអរសាទរ ទិវា បុណ្យ ឯករាជ្យ ជាតិ និង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល ជា ពេលវេលា ដ៏ សប្បាយរីករាយដ៍ ធំ បំផុត ប្រចាំ ឆ្នាំ ។ ដូច្នេះ គ្មាន អ្នកណា ទៅនឹក នា ដល់ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដឹកនាំ ដោយ លោក សម រង្ស៉ី ដែល ចង់ មក បង្ក ចលាចល សង្គម នោះ ឡើយ ។
សរុប ទៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា នេះ គឺ ពិតជា គ្មាន ស្រមោល សម រង្ស៉ី នៅលើ ទឹកដី កម្ពុជា ទេ ហើយក៏ គ្មាន អ្វី កើតឡើង ទាំងអស់ ក្រៅតែ ពី ការសប្បាយរីករាយ ក្រោម ដំបូល សន្តិភាព ក្រោម ការដឹកនាំ របស់ រដ្ឋាភិបាល សម្ដេច តេជោ ហ៊ុន សែន ដែរ ៕
ដោយ៖ អ្នកវិភាគ នយោបាយ ម្នាក់
រដ្ឋា បាល ខេត្ត ក្រចេះ ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( ក្រចេះ ) ៖ ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ត្រូវបាន រៀបចំឡើង យ៉ាង គគ្រឹកគគ្រេង នៅ ទូទាំង ប្រទេស នា ព្រឹក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ តប តាម ការអំពាវនាវ រ បស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ដោយឡែក នៅ ខេត្ត ក្រចេះ នា ព្រឹក ថ្ងៃ នេះ លោក ហឿ ស៊ីយ៉ែម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ និង លោកស្រី បាន រៀបចំ និង ដឹកនាំ មន្រ្តី រាជការ យុវជន និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ចូលរួម ហូប អំបុក យ៉ាង សប្បាយរីករាយ នៅ ចំណុច វិមាន ឯករាជ្យ ស្ថិត នៅ សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ។
លោក វ៉ា ថន បាន ឱ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
លោក វ៉ា ថន បាន បញ្ជាក់ ថា ការទទួលទាន អំបុក នេះ ក៏ ជា ការឆ្លើយតប ចំពោះ ក្រុម ក្បត់ ជាតិ ដែល ចង់ បំផ្លិចបំផ្លាញ ដល់ សន្តិភាព ដោយ បង្ហាញ ថា ប្រជាពលរដ្ឋ ស្រលាញ់ សន្តិភាព មិន ចាញ់ ឧបាយកល ជន ក្បត់ ជាតិ ឡើយ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ លោក បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ អភិបាល ខណ្ឌ ច្បារអំពៅ ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
ដោយឡែក នៅ ខណ្ឌ ច្បារអំពៅ នា ព្រឹក ថ្ងៃ នេះ អភិបាល ខណ្ឌ ជ្រោយ ចង្វារ លោក ចេង មុនីរ៉ា និង លោកស្រី បាន រៀបចំ និង ដឹកនាំ មន្រ្តី រាជការ យុវជន និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ចូលរួម ហូប អំបុក យ៉ាង សប្បាយរីករាយ ។
លោក ចេង មុនីរ៉ា បាន ឱ្យដឹង ថា ការរៀបចំ ពិធី អក អំបុក ថ្ងៃ នេះ គឺ ដើម្បី អបអរសាទរ ដល់ បុណ្យ ឯករាជ្យ ជាតិ ក៏ ដូចជា បង្ហាញ អំពី ការសាមគ្គី របស់ ប្រជាពលរដ្ឋ ក្នុង ការទទួលទាន អំបុក ដើម្បី ការពារ សន្តិភាព ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខណ្ឌ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ រួមគ្នា រួមគ្នា ថែរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ ហើយ លោក បាន អំពាវនាវ ដល់ ពលរដ្ឋ កុំ ចូលរួម ជាមួយ ក្រុម ណា មួយ ដែល បង្ក អសន្តិសុខ បំផ្លិចបំផ្លាញ សន្តិភាព ដែល កំពុង មាន ផងដែរ ។
អភិបាល ខណ្ឌ ច្បារអំពៅ ដឹកនាំ មន្រ្តី និង ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ចូលរួម ពិធី ពិសា អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ ចលនា ទទួលទាន អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ទូទាំង ប្រទេស ដើម្បី ឆ្លើយតប ទៅនឹង ការអំពាវនាវ របស់ លោក សម រង្ស៉ី ឱ្យ ប្រជាពលរដ្ឋ បះបោ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ៕ ប្រធាន ក្រុមប្រឹក្សា និង អភិបាល ខេត្ត កែប ដឹកនាំ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ ចូលរួម ហូប អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កែប )៖ លោក សំ សារិន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កែប និង លោក កែន សត្ថា អភិបាល ខេត្ត កែប នៅ ព្រឹក ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ ប្រជាពលរដ្ឋ គ្រូបង្រៀន សិស្ស និស្សិត ចូលរួម ហូប អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ សាល ប្រជុំ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កែប ។
លោក អភិបាល ខេត្ត កែប បាន រម្លឹក ថា នៅ ថ្ងៃ ៩ វិច្ឆិកា នេះ ពិធី អក អំបុក សំពះ ព្រះខែ បាន និង កំពុង ប្រព្រឹត្តទៅ ស្រប ពេល មាន ចលនា ក្រុម ឧទ្ទាម ដឹកនាំ ដោយ ទណ្ឌិត សម រង្ស៊ី បាន ដាក់ចេញ គម្រោង ដើម្បី ធ្វើ រដ្ឋប្រហារ ប្រឆាំង រាជ រដ្ឋាភិបាល និង របប រាជានិយម ។
ដោយឡែក នៅ ថ្ងៃ នេះ រដ្ឋបាល ខេត្ត កែប បាន រៀបចំ សប្បាយរីករាយ ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ យើង ទោះបី មិន បាន ជួបជុំគ្នា ទាំងអស់ មែន ប៉ុន្តែ ថ្ងៃ នេះ សម្រាប់ ខេត្ត កែប ត្រូវ ធ្វើ ពិធី គោរព ទូទាំង ខេត្ត ក្នុង ទី វត្តអារាម និង នៅ តាម ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ភូមិ ឃុំ សង្កាត់ ស្រុក ក្រុង ទាំងអស់ ។
លោក អភិបាល ខេត្ត ក៏ ឆ្លៀត ឱកាស អរគុណ ដល់ មន្ត្រី ក្រោម ឱវាទ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និស្សិត ព្រមទាំង ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន រួមគ្នា បង្កើត ពិធី ហូប អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ នេះ ឡើង ហើយ នឹង បន្ត ពេញ មួយ ថ្ងៃ នេះ រហូតដល់ បងប្អូន យើង បាន ហូប អំបុក គ្រប់ ៗ គ្នា បាន ឆ្អែត និង បន្ត សប្បាយ ជាមួយគ្នា ទៀត ឆ្លើយតប ទៅនឹង ការប្រកាស របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ៕
ថ្នាក់ដឹកនាំ មន្រ្ដី រាជការ និង ប្រជាពលរដ្ឋ នៅ ខេត្ត ព្រះសីហនុ នាំគ្នា ហូប អំបុក សាមគ្គី អក អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ
( ព្រះសីហនុ) ៖ ឆ្លើយតប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ចូលរួម ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា នេះ . ថ្នាក់ដឹកនាំ មន្រ្ដី រាជការ និង ប្រជាពលរដ្ឋ ខេត្ត ព្រះសីហនុ បាន រៀបចំ ពិធី ហូប អំបុក សាមគ្គី អក អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ប្រកបដោយ ក្តី សប្បាយរីករាយ ។
ពិធី នេះ ដឹកនាំ ដោយ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត លោក ជា ម ហ៊ីម និង អភិបាល ខេត្ត លោក គួច ចំរើន ព្រមទាំង ថ្នាក់ដឹកនាំ ជាច្រើន នាក់ ទៀត ។
សូម ជម្រាប ថា នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ជា ខួប លើក ទី៦៦ ទិវា បុណ្យ ឯករាជ្យ ជាតិ និង ក៏ ជា ថ្ងៃ ដែល បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ចូលរួម ពិសា អំបុក ខ្មែរ ថែ ជាតិ សាសនា ព្រះមហាក្សត្រ ដែល ជា ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ប្រឆាំង គម្រោង ធ្វើ រដ្ឋប្រហារ និង ផ្តួលរំលំ របប រាជានិយម ពីសំណាក់ ក្រុម ឧទ្ទាម ក្បត់ ជាតិ សម រង្ស៉ី ។
គ្រាន់តែ មកដល់ ថ្ងៃទី ០៩ ខែវិច្ឆិកា នេះ ភ្លាម គេ ឃើញ តាម បណ្តា ក្រសួង ស្ថាប័ន រដ្ឋ និង ឯកជន ព្រមទាំង ប្រជាពលរដ្ឋ តាម បណ្តា ខេត្ត ក្រុង ស្រុក ខណ្ឌ ភូមិ ឃុំ បាន ជួបជុំគ្នា ដាល់ អំបុក និង ពិសា អំបុក យ៉ាង សប្បាយរីករាយ ក្នុង បរិយាកាស ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញ បរិបូរណ៍ ។
ក្នុង ឱកាស ថ្លែង លើ វេទិកា សាធារណៈ នានា និង តាម បណ្តាញ សង្គម Facebook ក្តី សម្តេច តេជោ ហ៊ុន សែន តែងតែ បាន អំពាវនាវ សូមឲ្យ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ ចូលរួម ហូប អំបុក ពី ថ្ងៃទី ៩ ដល់ ថ្ងៃទី ១២ វិច្ឆិកា ដើម្បី ចូលរួម ការពារ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ប្រឆាំង ជាមួយ ផែនការ របស់ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ សម រង្ស៊ី ៕ ថ្នាក់ដឹកនាំ និង មន្រ្ដី បុគ្គលិក គ្រប់ ជាន់ ថ្នាក់ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា នាំគ្នា ហូប អំបុក សាមគ្គី អក អំបុក ខ្មែរ ថែ ជាតិ សាសនា និង ព្រះមហាក្សត្រ
