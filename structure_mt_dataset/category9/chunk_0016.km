( ព្រះវិហារ ) ៖ លោក សំ លាង ទ្រី ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ បាន ប្តេជ្ញាចិត្ត ថា នឹង ធ្វើ ការថែទាំ ជួសជុល ផ្លូវ ក្នុង ខេត្ត ព្រះវិហារ ទាំងអស់ ដែល គ្រប់គ្រង ដោយ មន្ទីរ មិន ឲ្យ មាន គ្រលុក និង សំបុក មាន់ ទេ ពិត មែន តែ ផ្លូវ នៅ ខេត្ត ព្រះវិហារ មិន បាន ស្អាត ពិត មែន តែ ផ្លូវ នៅ ខេត្ត ព្រះវិហារ សំបូរ ទៅ ដោយ គ្រួស ក្រហម លើកលែងតែ ផ្លូវ ក្នុង ទី រួម ខេត្ត ប៉ុណ្ណោះ ។
លោក ថា លើកលែងតែ ផ្លូវ ក្នុង ទី រួម ខេត្ត ប៉ុន្តែ យើង កំពុងតែ ខិតខំ ព្យាយាម លុប សំបុក មាន់ ហើយ រហូតដល់ ថ្ងៃ នេះ យើង កំពុង ចាប់ផ្តើម អ៊ុត AC បន្ត ទៀត ចឹង គំរោង ទៅ ថ្ងៃ អនាគត ផ្លូវកាត់ ទទឹង យើង នឹង ចាក់ បេតុង សរសៃ ដែក យើង បាន ធ្វើ នៅមុខ ម្លប់ ត្រសេក មិន មែន ធ្វើ សាកល្បង ទេ គឺ ធ្វើ យក មែនទែន តែ ម្តង ហើយ ចំពោះ ផ្លូវ ជាតិ នៅ ស្រុក គូលែន នៅ ថ្ងៃ ខាងមុខ យើង នឹង ធ្វើ ការពង្រីក ឲ្យ ធំ ជាង នេះ បន្ថែម ទៀត ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ដើម្បីឱ្យ ការប្រារព្ធ ពិធី ខាងលើ ប្រព្រឹត្តទៅ ដោយ រលូន រក្សា បាន នូវ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ និង របៀបរៀបរយ សាធារណៈ ព្រមទាំង បញ្ចៀស បាន នូវ ការកកស្ទះ ចរាចរ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង បញ្ចៀស ចរាចរ នៅ តាម ផ្លូវ ក្នុង តំបន់ ជុំវិញ បរិវេណ ទីតាំង ប្រារព្ធ ពិធី ចាប់ពី វេលា ម៉ោង ១៤:០០ នាទី រហូតដល់ ពិធី ត្រូវបាន បញ្ចប់ ។
អាស្រ័យ ហេតុ នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ មេត្តា ជ្រាប និង បញ្ចៀស ការធ្វើដំណើរ ឆ្លងកាត់ តាម ទីតាំង ខាងលើ តាម កាលបរិច្ឆេទ ដោយ អនុគ្រោះ ។ ផុត រយៈពេល ហាមឃាត់ បណ្តោះអាសន្ន នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង បើក ឱ្យ ធ្វើចរាចរ ជាធម្មតា វិញ ។
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ទទួល ជួប ពិភាក្សា ការងារ និង ជម្រាប លា ពី លោកស្រី Angela Corcoran ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី ប្រចាំ នៅ កម្ពុជា ក្នុង ខណៈ ដែល លោកស្រី ត្រូវ បញ្ចប់ បេសកកម្ម ការ ទូត នៅ កម្ពុជា ក៏ ដូចជា ពិភាក្សា លើ ការបន្ត ពង្រឹង បន្ថែម ទៀត នូវ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី កម្ពុជា - អូស្រ្តាលី ។ ជំនួប នេះ ធ្វើឡើង នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ ទីស្ដីការ ក្រសួង សេដ្ឋកិច្ច ។
អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ប្រជាជន និង រាជ រដ្ឋាភិបាល អូស្រ្តាលី ដែល ប្រទេស អូស្រ្តាលី គឺជា ដៃគូ ដ៏ សំខាន់ ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច កម្ពុជា នា ពេល កន្លងមក ។ សមិទ្ធិផល ដែល កម្ពុជា ទទួលបាន គឺ មិន អាច កាត់ផ្តាច់ ពី ការគាំទ្រ របស់ រដ្ឋាភិបាល អូស្រ្តាលី ក៏ ដូច លោកស្រី ឯក អគ្គ រដ្ឋទូត ផ្ទាល់ ក្នុង អាណត្តិ ការងារ ការទូត របស់ លោកស្រី នៅ កម្ពុជា ។
អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី ក៏ បាន ជូន ពរ លោកស្រី Angela Corcoran ឲ្យ ទទួលបាន ជោគជ័យ ក្នុង តួនាទី ថ្មី របស់ លោកស្រី នា ពេល ខាងមុខ និង បាន គូសបញ្ជាក់ ថា កម្ពុជា នឹង បន្ត ខិតខំ លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ និង មិត្តភាព ឲ្យ កាន់តែ ស្និត រមួត បន្ថែម ទៀត ដើម្បី ជា ឧត្តម ប្រយោជន៏ សម្រាប់ ប្រទេស និង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ កម្ពុជា - អូស្រ្តាលី ៕ ក្រុមហ៊ុន ថៃ ចាប់អារម្មណ៍ សកម្មភាព មនុស្សធម៌ របស់ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្ដេច តេជោ (TYDA)
លោក និង លោកស្រី ដែល តំណាង ឲ្យ គណៈប្រតិភូ ថៃ ក៏ បាន បន្ថែម ថា លោក នឹង ខិតខំ គៀង គរ មិត្តភក្តិ និង សប្បុរសជន ដទៃ ទៀត ឲ្យ ចូលរួម នៅក្នុង សកម្មភាព សង្គម ដ៏ ល្អ ប្រពៃ នេះ ។
សូម បញ្ជាក់ ថា នេះ គឺជា ការចាប់អារម្មណ៍ សកម្មភាព មនុស្សធម៌ និង ការចូលរួម ពីសំណាក់ ក្រុមហ៊ុន មួយ នៅក្នុង ចំណោម បណ្ដា ក្រុមហ៊ុន អង្គការ ដៃគូរ ជាច្រើន ទៀត ដែល បាន ចូលរួមចំណែក នៅក្នុង សកម្មភាព មនុស្សធម៌ របស់ សមាគម TYDA នា ពេល កន្លងមក ៕ ទេសរដ្ឋមន្ដ្រី គន់ គីម ចុះ ពិនិត្យ ផ្ទះ ១៨០ ខ្នង ដែល ត្រៀម ប្រគល់ ជូន អតីត យុទ្ធជន នៅ ខេត្ត ឧត្ដរ មានជ័យ
( ឧត្តរមានជ័យ )៖ នៅ រសៀល ទី ២៩ ខែវិច្ចិកា ឆ្នាំ ២០១៩ នេះ ទេសរដ្ឋមន្ដ្រី គន់ គីម អនុប្រធាន និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា បាន អញ្ជើញ ចុះ ពិនិត្យមើល ផ្ទះ ចំនួន ១៨០ ខ្នង អំណោយ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កត្តិ ព្រឹទ្ធបណ្ឌិត ដែល ត្រៀម ផ្តល់ ជូន អតីត យុទ្ធជន មកពី ភ្នំពេញ ដែល អត់ ដី អត់ ផ្ទះ ១០១ គ្រួសារ នា ថ្ងៃទី ០៦ ខែធ្នូ ខាងមុខ នេះ នៅ ភូមិ បាត់ ថ្កូវ ឃុំ ចុង កាល់ ស្រុក ចុង កាល់ ខេត្ត ឧត្ដរ មានជ័យ ។
ថ្លែង ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្ដ្រី គន់ គីម បាន ណែនាំឲ្យ ក្រុមការងារ ត សំយ៉ាបផ្ទះ ជូន ពួកគាត់ បន្ថែម ទៀត គ្រប់ ខ្នង ផ្ទះ និង ធ្វើ ការសម្អាត ផ្ទះ ដាំ ដើមឈើ តាម ផ្ទះ ឲ្យបាន គ្រប់ ។
ជាមួយគ្នា នេះ លោក គន់ គីម ក៏ បាន ឲ្យ ក្រុមការងារ ត្រៀមលក្ខណៈ ដើម្បី ទទួល បងប្អូន អតីត យុទ្ធជន ដែល ត្រូវ ចូលមក នៅ នា ពេល ខាងមុខ នេះ ដោយ ជួយសម្រួល ពី ជីវភាព និង សុខភាព ក្នុង ស្ថានភាព ដែល ពួកគាត់ មក រស់ នៅ ដំបូង ជួប ការខ្វះខាត និង មិន ទាន់ សាំ ជាមួយ អាកាសធាតុ និង ភូមិសាស្ត្រ នៅ ទីនេះ ៕ យ៉េមែន៖ ក្រុម ឧទ្ទាម ហ៊ូទី បាញ់ ទម្លាក់ ឧទ្ធម្ភាគចក្រ អារ៉ាប៊ី សាអូឌីត ផ្ដាច់ ជីវិត ពី ឡុត ពីរ នាក់
ប៉ុន្តែ ភ្លាម ៗ អារ៉ាប៊ី សាអូឌីត មិន ទាន់ ទទួលស្គាល់ ការអះអាង របស់ ក្រុម ឧទ្ទាម ហ៊ូទី នៅឡើយ ទេ ខណៈ គេ ដឹង ថា Apache គឺជា ឧទ្ធម្ភាគចក្រ ដែល ទីក្រុង រីយ៉ាដ ទិញ ពី សហរដ្ឋ អាមេរិក ៕
សាលា បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្នុង វិស័យ សក់ និង សម្ផស្ស ថ្មី មួយ ត្រូវបាន បើក សម្ពោធ ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ
ពិធី សម្ពោធ ជា ផ្លូវការ សាលា បណ្តុះបណ្តាល នេះ ដោយ មាន ការចូលរួម ជា អធិបតីភាព ពី លោក ហ៊ីង ស៊ី ដេត អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន អប់រំ បណ្ដុះបណ្ដាល បច្ចេកទេស និង វិជ្ជាជីវៈ (TVET) នៃ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ។
លោក ហ៊ីង ស៊ី ដេត បាន បញ្ជាក់ ថា ការបង្កើត សាលា បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្នុង វិស័យ សក់ និង សម្ផស្ស នេះ គឺជា ការចូលរួម ចំណែក មួយ ក្នុង វិស័យ អភិវឌ្ឍន៍ លើ ធនធាន មនុស្ស មួយចំណែក ដែល នៅក្នុង ប្រទេស កម្ពុជា ហើយ ស្រប តាម គោល នយោបាយ យុទ្ធសាស្រ្ត ចតុកោណ របស់ រាជ រដ្ឋាភិបាល ដែល ផ្ដោត សំខាន់ លើ វិស័យ អភិវឌ្ឍន៍ លើ ធនធាន មនុស្ស នេះ ផងដែរ ។
លោក បាន បន្ត ថា ក្រុមហ៊ុន នឹង ធ្វើការ ជាមួយ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្នុង ការរៀបចំ ឲ្យ ការបណ្តុះបណ្ដាល ដែល មាន ស្តង់ដារ អឺរ៉ុប មួយ នេះ ឲ្យ ត្រូវ តាម ប្រព័ន្ធ គុណ វឌ្ឍន របស់ កម្ពុជា និង ប្រព័ន្ធ គុណ វឌ្ឍន កម្រិត តំបន់ អាជីព ជាង សក់ ដែល កំពុង បម្រើ ការងារ ក្នុង វិស័យ នេះ និង អ្នក ដែល ចាប់អារម្ម ណ៏ ចង់ ប្រកប មុខរបរ ក្នុង វិស័យ នេះ ។
