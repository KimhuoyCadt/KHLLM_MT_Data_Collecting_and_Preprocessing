( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត នៅ ល្ងាច ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន ដឹកនាំ មន្ត្រី ពាក់ព័ន្ធ ចុះ ពិនិត្យ សិក្សា ផល ប៉ះពាល់ លើ គម្រោង ការសាងសង់ ផ្លូវ បេតុង វាង ក្រុង កំពត១ ខ្សែ ស្ថិត នៅក្នុង ភូមិ កំពង់បាយ ខាងជើង សង្កាត់ កំពង់បាយ ក្រុង កំពត ។
តាម គម្រោង នៃ ការកសាង ផ្លូវ វាង ក្រុង មួយ ខ្សែ នេះ មាន ទទឹង ១៥ម៉ែត្រ បណ្ដោយ ១៣៨០ ម៉ែត្រ ធ្វើ ពី បេតុង សរសៃ ដែក អម ដោយ ប្រព័ន្ធ លូរំដោះ ទឹក ចេញ ពី ក្នុង ក្រុង កំពត ដោយ ផ្លូវ នេះ តបំបែក ចេញ ពី ផ្លូវ ជាតិ លេខ ៣ ឆ្ពោះទៅ ទល់ នឹង ផ្លូវ បេតុង ម៉ាកេង ស្រប តាម បណ្ដោយ ផ្លូវ រថភ្លើង ដែល មាន គំលាត ពី ផ្លូវ រថភ្លើង ចំងាយ ១២ម៉ែត្រ និង ចិញ្ចើមផ្លូវ ម្ខាង ទៀត មាន ចំនួន ៣ម៉ែត្រ ក្រោម គម្រោង ប្រើប្រាស់ ថវិកា របស់ រដ្ឋបាល ខេត្ត កំពត ។
លោក អភិបាល ខេត្ត បាន លើក បញ្ជាក់ ថា ផ្លូវ វាង ក្រុង មួយ ខ្សែ នេះ គឺ ពិតជា មាន សារៈសំខាន់ ក្នុង ការកាត់បន្ថយ ការកកស្ទះ នូវ រថយន្ត តូច ធំ បើកបរ លើ ដង ផ្លូវ ជាតិ លេខ ៣ ក្បែរ ផ្សារ សាមគ្គី ក្នុង ក្រុង កំពត និង ក៏ ដូចជា ការកាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ព្រមទាំង របៀបរៀបរយ សណ្ដាប់ធ្នាប់ សាធារណៈ ក្នុង ក្រុង កំពត ព្រោះ បច្ចុប្បន្ន ក្រុង កំពត ផ្លូវ វាង ក្រុង ប៉ែក ខាងជើង ឬ ខាងលិច នៃ ក្រុង កំពត នៅ ពុំ ទាន់ មាន ផ្លូវ សម្រាប់ សម្រួល ចរាចរណ៍ នៅឡើយ ទេ ។
នៅ ថ្ងៃត ទៅ មុខ ទៀត ផ្លូវ វាង ក្រុង មួយ ខ្សែ នេះ ដែរ ក៏ មាន គម្រោង កសាង បន្ត ទៀត ទិសដៅ ស្រប តាម ផ្លូវ រថភ្លើង នេះ ដែរ រហូត ទល់ នឹង មាត់ ព្រែក កំពត ក្បែរ ស្ពាន ដែក រថភ្លើង ហើយ រដ្ឋបាល ខេត្ត មាន គម្រោង នឹង ធ្វើ សំណើ ទៅ រាជ រដ្ឋាភិបាល ដើម្បី កសាង ស្ពាន ឆ្លងកាត់ ព្រែក កំពត ផ្លូវ វាង ក្រុង មួយ ខ្សែ នេះ ផងដែរ ។
អ្វី ដែល គួរឲ្យ កត់សម្គាល់ គឺ នៅ ឆ្នាំ នេះ លោក ប្រធានាធិបតី ចិន មិន បាន ថ្លែង ពាក់ព័ន្ធ នឹង សង្រ្គាម ពាណិជ្ជកម្ម ជាមួយ សហរដ្ឋ អាមេរិក ឡើយ ស្រប ពេល ដែល ភាគី ទាំង ពីរ នា ខណៈ នេះ កំពុងតែ ព្យាយាម សម្រេច ឲ្យបាន ជា ផ្លូវការ នូវ កិច្ចព្រមព្រៀង ដំណាក់កាល ទី មួយ ដែល ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន ប្រកាស កាលពី ខែតុលា កន្លងទៅ ។
( ភ្នំពេញ ) ៖ កិត្តិបរិរក្ស បណ្ឌិត គាត ឈន់ ប្រធាន កិត្តិយស ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង ជា ប្រធាន កិត្តិយស នៃ សមាគម អតីត និស្សិត សាកលវិទ្យាល័យ ឆាល ស្ទឺត កម្ពុជា បាន ថ្លែង ថា សុខ សន្តិភាព គឺជា បុព្វលក្ខខណ្ឌ មួយ មិន អាច ខ្វះ បាន ឡើយ សម្រាប់ ការអភិវឌ្ឍ សង្គម និង សេដ្ឋកិច្ច របស់ ប្រទេស កម្ពុជា ។
លោក បណ្ឌិត បាន ថ្លែង បែប នេះ នៅក្នុង ឱកាស លោក អញ្ជើញ ជា អធិបតី ក្នុង កម្មវិធី លាង សាយ ភោជន៍ របស់ សមាគម ប្រចាំ ឆ្នាំ ២០១៩ នៅ រាត្រី ថ្ងៃទី ០៤ ខែវិច្ឆិកា ។
កិត្តិបរិរក្ស បណ្ឌិត គាត ឈន់ បាន ថ្លែង ថា ប្រជាជន កម្ពុជា ទូទាំង ប្រទេស បាន និង កំពុង ទទួល អត្ថប្រយោជន៍ ពី សុខ សន្តិភាព ពេញ បរិបូរណ៌ លើ ផ្ទៃ ប្រទេស ដែល ជា អត្ថមនុញ្ញ ផល ពី នយោបាយ ឈ្នះ - ឈ្នះ ដែល ត្រូវបាន ដាក់ចេញ និង ដឹកនាំ អនុវត្ត ផ្ទាល់ ប្រកបដោយ ជោគជ័យ ដ៏ ត្រចះត្រចង់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក បញ្ជាក់ ថា « សុខ សន្តិភាព នេះ គឺជា បុព្វលក្ខខណ្ឌ មិន អាច ខ្វះ បាន សម្រាប់ ការអភិវឌ្ឍ សង្គម - និង សេដ្ឋកិច្ច កម្ពុជា សំដៅ លើកកម្ពស់ កម្រិត ជីវភាព របស់ ប្រជាជន យើង កាន់តែ ប្រសើរឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ » ។
លោក បន្ត ថា « ការជួបជុំគ្នា របស់ យើង នា រាត្រី នេះ អាច ធ្វើ ទៅ បាន ក៏ ព្រោះតែ ប្រទេស កម្ពុជា យើង មាន សុខ សន្តិភាព បរិបូរណ៌ ។ ឫសគល់ នៃ ស្ថិរភាព នយោបាយ ម៉ាក្រូ សេដ្ឋកិច្ច ទំនាក់ទំនង ការទូត បាន កើត ចេញពី ការដឹកនាំ ដ៏ វៃ ឈ្លាស ប្រកបដោយ គតិបណ្ឌិត ទេពកោសល្យ ដ៏ ប៉ិនប្រសប់ មាន ចក្ខុវិស័យ ច្បាស់លាស់ និង វែងឆ្ងាយ ហើយ ប្រាកដ និយម របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី » ។
ឧកញ៉ា ស៊ុន សុខ ណា ប្រធាន សមាគម បាន ថ្លែង ថា ក្នុង ឆ្នាំ ២០១៩ នេះ សមាគម បាន ធ្វើ សកម្មភាព ជួយ សង្គម ជាច្រើន ។ លោក អះអាង ថា ការងារ សង្គម ទាំងអស់ នោះ សុទ្ធតែ កើត ចេញ ពី សណ្តាចិត្ត ដ៏ ប្រពៃ របស់ សមាជិក ទាំងមូល ។
លោក បញ្ជាក់ ថា « ខ្ញុំ ពិតជា មាន សេចក្តី សោមនស្ស រីករាយ ណាស់ ដែល បាន រួមចំណែក នៅក្នុង សកម្មភាព នេះ និង សូម លើកទឹកចិត្ត ដល់ បងប្អូន ឲ្យ បន្ត នូវ ការងារ នេះ បន្ត ទៀត ដើម្បី ជា ឧត្តម ប្រយោជន៍ ដល់ សង្គមជាតិ យើង »៕
អតីត ថ្នាក់ដឹកនាំ ទាំង នេះ បាន អំពាវនាវ ឱ្យ សហការី ដែល ជា ចលនា សង្គ្រោះ ជាតិ ខុស ច្បាប់ ប្រញ៉ាប់ ចេញមុខ និង មក រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដោយ មិន ត្រូវ ចាញ់បោក ជន ក្បត់ ជាតិ ទណ្ឌិត សម រង្សី ត ទៅទៀត ឡើយ ។ ពួកគេ បាន លើកឡើង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ទេ ដែល ជា អ្នកស្រឡាញ់ ប្រជាជន និង ប្រទេសជាតិ ពិត ៗ ។
អតីត មន្ត្រី ជាន់ ខ្ពស់ ប្រចាំ ខេត្ត របស់ អតីត គណបក្ស សង្គ្រោះ ជាតិ ទាំង ៤រូប រួម មាន៖
ពួកគេ បញ្ជាក់ ថា ការចាកចេញ នេះ ដោយ ឃើញ សកម្មភាព របស់ ទណ្ឌិត សម រង្ស៊ី បាន រំលោភបំពាន យ៉ាង ធ្ងន់ធ្ងរ បំផុត មក លើ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន ប្រមាថ កាត ទាន ធ្ងន់ ៗ លើ អង្គ ព្រះមហាក្សត្រ ដែល ពលរដ្ឋ ខ្មែរ ទាំងមូល មិន អាច ទទួលយក បាន ជាដាច់ខាត និង ថ្កោល ទោស យ៉ាង ខ្លាំងក្លា បំផុត ៕
គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត បាត់ដំបង បើក កិច្ចប្រជុំ ស្តាប់ របាយការណ៍ ប្រចាំ ខែតុលា ដើម្បី ដោះស្រាយ បញ្ហា នានា និង លើក ទិសដៅ បន្ត
( បាត់ដំបង ) ៖ លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង និង ជា ប្រធាន គណ: បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត បាន បើក កិច្ចប្រជុំ ស្តាប់ របាយការណ៍ ប្រចាំ ខែតុលា ដើម្បី ធ្វើ ការដោះស្រាយ បញ្ហា នានា និង លើក ទិសដៅ បន្ត ។
កិច្ចប្រជុំ នេះ បាន ធ្វើ នា រសៀល ថ្ងៃទី ៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ នៅ សាល ប្រជុំ សាលា ខេត្ត ដោយ មាន ការចូលរួម ពី ថ្នាក់ គណៈ អភិបាល ខេត្ត ព្រះរាជអាជ្ញា ប្រធាន សាលាដំបូង ខេត្ត មេបញ្ជាការ ថ្នាក់ យោធ ភូមិភាគ ទី៥ ថ្នាក់ តំបន់ ប្រតិបត្តិការ សឹក រង បាត់ដំបង កងរាជអាវុធហត្ថ ខេត្ត លោក ស្នងការ នគរបាល ខេត្ត អភិបាល ក្រុង ស្រុក ប្រធាន មន្ទីរ អង្គភាព រដ្ឋ នានា ជុំវិញ ខេត្ត និង មន្រ្តី ពាក់ព័ន្ធ ជាច្រើន នាក់ ចូលរួម ផងដែរ ។
បន្ទាប់ពី បាន ស្តាប់ របាយការណ៍ ក្នុង អង្គប្រជុំ រួច មក លោក ងួន រតនៈ និង ជា ប្រធាន គណ: បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត បាន អនុញាត ឱ្យ ប្រធាន អង្គភាព នីមួយ ៗ ឡើង រាយការណ៍ ពី បញ្ហា ដែល កើត មាន ឡើង តាម ជំនាញ របស់ ខ្លួន ក្នុង នោះ លោក បាន សង្កត់ធ្ងន់ អំពី បញ្ហា គ្រឿងញៀន បទល្មើស ផ្សេង ៗ ពិសេស ការពង្រឹង ច្បាប់ និង អនុវត្ត ច្បាប់ ចរាចរណ៍ លើ អ្នក ជិះ យានយន្ត គ្រប់ ប្រភេទ មិន គោរព ច្បាប់ ចរាចរណ៍ ក្នុង គោលបំណង ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គោរព ច្បាប់ ទាំងអស់ គ្នា ។
ក្នុង កិច្ចប្រជុំ នេះ ដែរ លោក វរសេនីយ៍ ឯក ដាញ់ អេង ប៊ុន ចាន់ ស្នងការង នគរបាល ទទួលបន្ទុក ការិយាល័យ អន្តោប្រវេស្តន៍ បាន ឡើង រាយការណ៍ អំពី ជន បរទេស ជា ជន អន្តោប្រវេស្តន៍ ដែល កពុង រស់ នៅ ស្រប ច្បាប់ និង មិន ស្រប ច្បាប់ ក្នុង ទឹកដី ខេត្ត បាត់ដំបង បាន លទ្ធផល ល្អ ប្រសើ ។
ក្នុង ឱកាស នោះ ដែរ ប្រធាន គណៈ បញ្ជាការ ខេត្ត ក៏ បាន អនុញ្ញាតឱ្យ រដ្ឋបាល ក្រុង - ស្រុក ឡើង រាយការណ៍ ពី បញ្ហា ផ្សេង ៗ នៅ តាម មូលដ្ឋាន របស់ ខ្លួន ជា បន្តបន្ទាប់ រួច លោក ងួន រតនៈ បាន ធ្វើ ការបូកសរុប ដោយ រំលឹក និង ជំរុញ ដល់ សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ផ្សេង ទៀត ថា រាល់ បទល្មើស ផ្សេង ទៀត ក៏ យើង ត្រូវ ទប់ស្កាត់ ឱ្យ បាន គឺ យើង ជា មន្រ្តី ជំនាញ របស់ ខ្លួន ទទួលខុស យើង ត្រូវ នាំគ្នា ទប់ស្កាត់ កុំ ឱ្យ កើត មាន ឡើង បន្ត ទៀតផងដែ៕
អាជ្ញាធរ មន្ត្រី ជំនាញ និង សមាគម មៀន ប៉ៃលិន ចំនួន ៣ខេត្ត បើក កិច្ចប្រជុំ រក ដំណោះស្រាយ បញ្ហា របាំង បច្ចេកទេស ដែល រាំងស្ទះ ដល់ ការនាំចេញ ផ្លែ មៀន ប៉ៃលិន ទៅ ក្រៅ ប្រទេស
លោក អភិបាល ខេត្ត ក៏ បាន ថ្លែង កោតសរសើរ ដល់ សមាគម មៀន ប៉ៃលិន ទាំង៣ ខេត្ត ដែល បាន ខិតខំ រួម ចង ក្រង គ្នា ជា សមាគម និង ចូលរួម លើកស្ទួយ គុណភាព កសិផល ខ្មែរ សម្គាល់ ភូមិសាស្ត្រ ហើយ ត្រូវ រួមគ្នា ផលិត ផ្លែ មៀន ឲ្យបាន បរិមាណ ច្រើន ព្រមទាំង មាន គុណភាព អនាម័យ ស្រម តាម ស្តង់ដា និង តម្រូវការ ទីផ្សារ អន្តរជាតិ ផងដែរ ។
ក្នុង ឱកាស នោះ លោក ផាន់ ចាន់ ធុល ក៏ បាន ស្នើ ដល់ អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ រៀបចំ ឯកសារ ទៅ ក្រសួង សាមី របស់ ខ្លួន ដើម្បី ត្រៀម កិច្ចប្រជុំ អន្តរ ក្រសួង នា ពេល ខាងមុខ ក្នុង ធ្វើ ការដោះស្រាយ នូវ បញ្ហា នាំចេញ ផ្លែ មៀន ប៉ៃលិន នេះ ឲ្យ ទទួលបាន ជោគជ័យ ។
បើ តាម របាយការណ៍ របស់ លោក សុខ សាធី ម ទីប្រឹក្សា ក្រសួង ពាណិជ្ចកម្ម និង ជា ប្រធាន មន្ទីរ ពាណិជ្ចកម្ម ខេត្ត ប៉ៃលិន បាន ឲ្យដឹង ថា បច្ចុប្បន្ន ក្នុង ១ ឆ្នាំ ក្រុមហ៊ុន ឆាយ ណា ជីន វ័រ យន្ត អ៊ីម ផត អិច ផត ( ខេមបូឌា ) បាន បញ្ជាទិញ ផ្លែ មៀន ប៉ៃលិន ពី ខេត្ត ចំនួន ៨ មាន ដូច ជា៖
ការប្រកាស ពី ជំហរ ដាច់ ណាត់ ដើម្បី អនុវត្ត ច្បាប់ ចំពោះ ក្រុម ក្បត់ ជាតិ របស់ ប្រមុខ ការពារ ជាតិ កម្ពុជា បាន ធ្វើឡើង ក្រោយ បញ្ចប់ ដំណើរទទួល ដំណើរ និវត្តន៍ កង វិស្វកម្ម លេខ ៥៩៤ ដែល បាន បញ្ចប់ បេសកកម្ម រក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ នៅ សាធារណរដ្ឋ អាហ្វ្រិក កណ្តាល នា រសៀល ថ្ងៃទី ៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ថ្លែង ថា « កម្ពុជា មិន អាច ទុក ឱ្យ ក្រុម ជន ក្បត់ ជាតិ សាសនា ព្រះមហាក្សត្រ បង្ក ភាព អសន្តិសុខ និង ចលាចល ផ្សេង ៗ ដើម្បី បង្អាក់ ដំណើរ រីកចម្រើន របស់ កម្ពុជា ជាដាច់ខាត » ។
នៅក្នុង ឱកាស នោះ ដែរ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ បាន ហៅ សកម្មភាព របស់ ទណ្ឌិត សម រង្ស៊ី និង បក្ខពួក ថា ជា សកម្មភាព ដ៏ ធ្ងន់ធ្ងរ ដែល បាន ប្រមាថ ព្រះមហាក្សត្រ និង ជា សកម្មភាព ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រដ្ឋាភិបាល ស្រប ច្បាប់ ។
សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ បាន បន្ថែម ថា ចំពោះ ការប្រកាស របស់ ទណ្ឌិត សម រង្ស៊ី ដោយ មាន ទាំង ផែនការបង្ក អសន្តិសុខ ក្នុង ប្រទេស ដោយ ការធ្វើ ចលនា កៀរ គរ ពលករ នៅ ថៃ ចូល កម្ពុជា មក គាំទ្រ ចលនា របស់ ខ្លួន ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ នោះ កងទ័ព កម្ពុជា ក៏ បាន ត្រៀម រួចរាល់ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ទៅ លើ សកម្មភាព ដែល មាន គោលដៅ បំផ្លាញ សុខ សន្តិភាព នេះ ។
សារ របស់ ជន ក្បត់ ជាតិ សម រង្ស៊ី ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា ស្ថាប័ន តុលាការ កងកម្លាំង សមត្ថកិច្ច និង កងទ័ព គ្រប់ លំដាប់ថ្នាក់ ចាត់ទុក ថា ជា អំពើ ល្មើស ច្បាប់ ដ៏ ធ្ងន់ធ្ងរ បំផុត ដែល បង្ក គ្រោះថ្នាក់ ភាពវឹកវរ ដល់ ប្រទេសជាតិ និង ប្រជាពលរដ្ឋ ហើយ ប្រកាស ចាត់ វិធានការ តាម ច្បាប់ និង តួនាទី ដើម្បី ការពារ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ សង្គម ។
ជាមួយគ្នា នេះ ស្ថាប័ន មាន សមត្ថកិច្ច បាន ព្រមាន ថា អ្នកចូលរួម និង គាំទ្រ ដល់ ផែនការ រដ្ឋប្រហារ របស់ ទណ្ឌិត សម រង្ស៉ី នឹង ត្រូវ ផ្តន្ទាទោស ទៅតាម ច្បាប់ ពី បទ « រួម គំនិត ក្បត់ » ដែល ប្រឈម នឹង ការដាក់ ពន្ធនាគារ ពី ១៥ រហូតដល់ ៣០ ឆ្នាំ ។ ទោះជា យ៉ាង នេះ ក្តី សម្រាប់ អ្នក ដែល ចូល សារភាព ទទួលស្គាល់ កំហុស នឹង ត្រូវ អនុញ្ញាតឱ្យ រួច ទោស ឡើងវិញ ៕
កម្លាំងប្រដាប់អាវុធ ជិត ២ម៉ឺន នាក់ នឹង ត្រូវ ដាក់ពង្រាយ ដើម្បី ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ ក្នុង ឱកាស បុណ្យ អុំ ទុក
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ដាក់ពង្រាយ កងកម្លាំងប្រដាប់អាវុធ សរុប ជិត ២ម៉ឺន នាក់ ដើម្បី ថែរក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក នៅ រាជធានី ភ្នំពេញ ដែល នឹង ប្រារព្ធ ធ្វើឡើង ចាប់ពី ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ។ នេះ បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
លោក បន្ត ថា ក្រៅពី កម្លាំងប្រដាប់អាវុធ ជិត ២ម៉ឺន នាក់ នេះ រាជ រដ្ឋាភិបាល បាន ត្រៀម កម្លាំង ពិសេស ផ្សេង ទៀត ដើម្បី ត្រៀម ការពារ និង អន្ដរាគមន៍ នៅ អាកាសយានដ្ឋាន អន្ដរជាតិ ភ្នំពេញ ដើម្បី ត្រៀម ចាប់ខ្លួន ជន ដែល មាន ដីការ តុលាការ ។
ឆ្លើយតប នឹង ការលើកឡើង ថា រាជ រដ្ឋាភិបាល ប្រើប្រាស់ កម្លាំងប្រដាប់អាវុធ ច្រើន ជាង បណ្ដា ឆ្នាំ កន្លងទៅ ត្រូវបាន ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន អះអាង ថា មិន មាន អ្វី ច្រើន នោះ ទេ ពោល គ្រាន់តែ បណ្ដា ឆ្នាំ កន្លងទៅ ពិធី បុណ្យ ឯករាជ្យ ជាតិ មិន ជាប់ គ្នា ជាមួយ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ឡើយ ប៉ុន្ដែ ឆ្នាំ នេះ បុណ្យ ឯករាជ្យ គឺជាប់ គ្នា ជាមួយ ថ្ងៃ បុណ្យ អុំ ទូក ហេតុ ដូច្នេះ ទើប សមត្ថកិច្ច ប្រើប្រាស់ កម្លាំង សរុប រួម តែម្ដង ។
អគ្គ ស្នងការ រង នគរបាល ជាតិ រូប នេះ បាន សង្កត់ធ្ងន់ ទៀត ថា ចំនួន កងកម្លាំង ដែល ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក នេះ មិន បាន បូក បញ្ចូល កម្លាំង ត្រៀម ពិសេស ផ្សេង ទៀត ដើម្បី អនុវត្ត ដីកា ចាប់ ជន ក្បត់ ជាតិ នៅ អាកាសយានដ្ឋាន អន្ដរជាតិ ភ្នំពេញ នោះ ឡើយ ។
ជាមួយគ្នា នេះ ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន គូសបញ្ជាក់ ទៀត ថា ការបន្ថែម កម្លាំង ក៏ ស្រប ពេល ដែល មាន ការប្រកាស របស់ ក្រុម ឧទ្ទាម ក្បត់ ជាតិ ប្រកាស ថា នឹង វិលត្រឡប់ មកកាន់ ប្រទេស កម្ពុជា ផងដែរ ។ លោក បាន សង្កត់ធ្ងន់ ថា ចំនួន កងកម្លាំងប្រដាប់អាវុធ ជិត ២ម៉ឺន នាក់ នេះ គឺ គ្រប់គ្រាន់ សម្រាប់ ថែរក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ ក្នុង ពិធី បុណ្យ ឯករាជ្យ ជាតិ និង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ៕ ចិន៖ ដោយសារតែ នារី ម្នាក់ ប៉ុណ្ណោះ ធ្វើឲ្យ ពី ឡុត ម្នាក់ បាត់បង់ ការងារ អស់ មួយ ជីវិត !
( ប៉េកាំង ) ៖ ពី ឡុត ចិន ម្នាក់ ត្រូវ ជាប់ បំរាម បើក យន្ដហោះ អស់ មួយ ជីវិត បន្ទាប់ពី រូបថត របស់ អ្នកដំណើរ ជា ស្រ្ដី ម្នាក់ អង្គុយ ថត រូប លេង នៅក្នុង កន្លែង បញ្ជា យន្ដហោះ ត្រូវបាន គេ បង្ហោះ លើ បណ្ដាញ ទំនាក់ទំនង សង្គម នា ពេល ថ្មី ៗ នេះ ។ នេះ បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ ចិន ដកស្រង់ ចេញផ្សាយ ដោយសារព័ត៌មាន BBC នៅ រសៀល ថ្ងៃអង្គារ ទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
គួរ បញ្ជាក់ ថា បើ តាម រដ្ឋបាល អាកាសចរណ៍ ស៊ីវិល ចិន អ្នកដំណើរ មិន ត្រួវ បាន អនុញ្ញាតឱ្យ ចូល កន្លែង បញ្ជា យន្ដហោះ របស់ ពី ឡុត នោះ ទេ លើកលែងតែ មាន ការអនុញាត ពិសេស តែ ប៉ុណ្ណោះ ។ ដូច្នេះ ក្រុមហ៊ុន Air Guilin បាន បញ្ជាក់ ថា ពី ឡុត បើក យន្ដហោះ ខាងលើ បាន រំលោភ ពាន លើ ច្បាប់ ស្ដីពី សុវត្ថិភាព អាកាសចរណ៍ ៕
