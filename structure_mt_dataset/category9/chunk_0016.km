( ភ្នំពេញ ) ៖ ជនសង្ស័យ ម្នាក់ ដែល កំពុង ពាក់ ពន្ធ័ករណី លួច ផលិត . វេចខ្ចប់ គ្រឿង សំអាង ដោយ គ្មាន ច្បាប់ អនុញ្ញាតិ នៅ ចំណុច ផ្ទះ លេខ ៣៧២ ផ្លូវ ព្រះមុន្នីរ៉េត ក្រុម ទី១០ ភូមិ ភ្នាត សង្កាត់ ស្ទឹងមានជ័យ ទី២ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ត្រូវបាន សមត្ថកិច្ច នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច នៃ ក្រសួង មហាផ្ទៃ ចាប់ និង បញ្ជូន ទៅកាន់ តុលាការ នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
យោង តាម របាយការណ៍ របស់ សមត្ថកិច្ច នគរបាល នាយកដ្ឋាន ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច កាលពី ថ្ងៃទី ២៦ ខែវិច្ឆិកា បាន ផ្សាយ ថា ការចុះបង្ក្រាប នេះ បាន ធ្វើឡើង នៅ វេលា ម៉ោង ១១៖ ០៥ នាទី ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ដោយ កម្លាំង នាយកដ្ឋាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ក្រសួង មហាផ្ទៃ និង ដោយ មាន ការចូលរួម ពី មន្រ្តី ក្រសួង សុខាភិបាល អាជ្ញាធរ មូលដ្ឋាន និង ក្រោម ការសម្របសម្រួល នីតិវិធី ពី លោក សេង ហៀង ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
ទីតាំង បង្រា្ក បករណី ផលិត វេចខ្ចប់ គ្រឿង សំអាង គ្មាន ច្បាប់ នៅ ចំណុច ផ្ទះ លេខ ៣៧២ ផ្លូវ មុន្នីរ៉េត ក្រុម ទី១០ ភូមិ ភ្នាត សង្កាត់ ស្ទឹងមានជ័យ ទី២ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
របាយការណ៍ នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច ដដែល បាន បន្ថែម ទៀត ថា ក្រោយពី ធ្វើ ការឆែកឆេរ សមត្ថកិច្ច ចម្រុះ រកឃើញ ផលិតផល និង សម្ភារ មួយចំនួន បម្រើ ឲ្យ ការផលិត គ្រឿង សំអាង ចំនួន ប្រមាណ ១៤ ប្រភេទ ចំនួន ប្រមាណ ២. ៥៣២គីឡូក្រាម ។
ចំពោះ វត្ថុតាង ទាំងអស់ ខាងលើ លោក ព្រះរាជអាជ្ញា រង បាន សម្រេច ឲ្យ ដកហូត រក្សាទុក ជា បណ្តោះអាសន្ន និង បិទ ផ្លុំ បេ នៅ ទីតាំង ខាងលើ និង បាន យក វត្ថុតាង មួយចំនួន ទៅ ធ្វើ ការពិសោធន៍ រក សារធាតុ ហាមឃាត់ និង បាន នាំ ខ្លួន ម្ចាស់ ទីតាំង ឈ្មោះ ជា ច័ន្ទ សម្បត្តិ ទៅ សាកសួរ បំភ្លឺ នៅ នាយកដ្ឋាន ដើម្បី បន្ត នីតិវិធី មុន សំណុំរឿង នេះ ត្រូវ បញ្ជូន ទៅកាន់ តុលាការ ៕ ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ ៥ ឆ្នាំ នៅ ខេត្ត កំពត ត្រូវ មាន ការចូលរួម ទាំងអស់ គ្នា ដើម្បីឲ្យ ទទួលបាន ជោគជ័យ
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត និង ជា ប្រធាន គណៈកម្មការគ្រប់គ្រង អភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កំពត បាន ជំរុញ ដល់ គ្រប់ ភាគី ពាក់ព័ន្ធ ភ្នាក់ងារ អភិវឌ្ឍន៍ អង្គការ ជាតិ អន្តរជាតិ ក្រសួង មន្ទីរ ស្ថាប័ន ម្ចាស់ ជំនួយ វិស័យ ឯកជន ក៏ ដូច ប្រជាពលរដ្ឋ ទាំងអស់ សូម ចូលរួម គាំទ្រ សហការណ៍ គ្នា និង ចូលរួម ឲ្យបាន យ៉ាង សកម្ម ក្នុង ការអនុវត្ត ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កំពត រយ :៥ ឆ្នាំ ( ២០១៩ - ២០២៣ ) ឱ្យ ទទួលបាន ជោគជ័យ ជា ស្ថាពរ ។
លោក ជា វ តាយ បាន ជំរុញ បែប នេះ នា ព្រឹក ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ ឆ្លង នូវ សេចក្ដីព្រាង ផែនការ អភិវឌ្ឍ ទេសចរណ៍ ខេត្ត កំពត រយៈពេល ៥ឆ្នាំ ( ២០១៩ - ២០២៣ ) ដែល បាន រៀបចំឡើង នៅ សាលា ខេត្ត កំពត និង ដោយ ចូលរួម ពី ប្រធាន អនុប្រធាន នៃ ស្ថាប័ន ពាក់ព័ន្ធ និង សមាជិក សមាជិកា គណៈកម្មការគ្រប់គ្រង អភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត ជាច្រើន រូប ផងដែរ ។
លោក ជា វ តាយ បាន បន្ត ថា ឯកសារ ព្រាង ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កំពត រយៈពេល ៥ឆ្នាំ ( ២០១៩. ២០២៣ ) ដែល ដាក់ ឆ្លង ក្នុង កិច្ចប្រជុំ ពេលនេះ គឺ ពិតជា មាន សារៈសំខាន់ ក្នុង គោលបំណង ដើម្បី បង្ហាញ ជូន ដល់ ក្រសួង មន្ទីរ ស្ថាប័ន ភ្នាក់ងារ អភិវឌ្ឍន៍ នានា អង្គការ មិន មែន រដ្ឋាភិបាល ជាតិ - អន្តរជាតិ និង ផ្នែក ឯកជន សម្រាប់ ជា ឯកសារ ក្នុង ការគៀងគរ ធនធាន និង គាំទ្រ រាល់ គម្រោង ដែល បាន លើកឡើង ក្នុង ផែនការ នេះ ។
លោក ជា វ តាយ ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ នៃ មន្ទីរ ទេសចរណ៍ ខេត្ត កំពត ដែល បាន សហការ ប្រមូលផ្តុំ គំនិត្យ ក្នុង ការសម្របសម្រួល ប្រមែប្រមូល រក ទិន្នន័យ និង បង្កើត បានជា ឯកសារ ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កំពត មាន រយៈពេល ៥ ឆ្នាំ ( ២០១៩ ២០២៣ ) ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ក្នុង ក្របខណ្ឌ ការងារ អភិវឌ្ឍន៍ ខេត្ត ក្នុង វិស័យ ទេសចរណ៍ របស់ ខ្លួន ។
មន្ត្រី ក្រសួង រៀបចំ ដែន ដី៖ ច្បាប់ គុណភាព សំណង់ នឹង ត្រៀម ការពារ បញ្ហា រញ្ជួយ ដី
( ភ្នំពេញ ) ៖ ដោយសារ ថ្មី ៗ នេះ មាន ការរញ្ជួយ ដី នៅ ព្រំដែន ប្រទេស ឡាវ និង ថៃ ធ្វើឲ្យ អគារ និង ផ្ទះសម្បែង របស់ ប្រជាពលរដ្ឋ នៃ ប្រទេស នេះ ខូចខាត យ៉ាង ខ្លាំង នោះ ធ្វើឲ្យ រាជ រដ្ឋាភិបាល ប្រទេស កម្ពុជា បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បី ការពារ សំណង់ អគារ ក្នុង ការការពារ ការរញ្ជួយ ដី តាមរយៈ ការបង្កើត ច្បាប់ ទាក់ទង ទៅ នឹង ការពង្រឹង គុណភាព សំណង់ អគារ ។
នេះ បើ តាម មន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ថ្លែង នៅក្នុង ឱកាស ក្រសួង សហការ ជាមួយ អង្គការ សហ ប្រជាជាតិ ប្រចាំ ប្រទេស កម្ពុជា (UN) រួមគ្នា បើក វេទិកា នគរូបនីយកម្ម កម្ពុជា ស្តីពី « ការអភិវឌ្ឍ ទីក្រុង ប្រកបដោយ ភាពឆ្លាតវៃ ចីរភាព និង បរិយាប័ន្ន » នៅ ថ្ងៃពុធ ទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ នៅ សណ្ឋាគារ សូហ្វីតែល ភ្នំពេញ ភូគី ត្រា ។
លោក ម៉េង ប៊ុណ្ណា រិទ្ធិ អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន រៀបចំ ដែនដី និង នគរូបនីយកម្ម បាន ថ្លែង ថា « យើង បាន ត្រៀម បញ្ហា គតិយុត្ត រួចហើយ » ។
បើ តាម លោក ម៉េង ប៊ុណ្ណា រិទ្ធិ បទពិសោធន៍ នៅ ប្រទេស ឡាវ និង ថៃ ហាក់បីដូចជា រឿង ថ្មី ប៉ុន្តែ នៅ ប្រទេស កម្ពុជា អត់ ទាន់ មាន ទេ រឿង រញ្ជួយ ដី ។ លោក បន្ត ថា បើ និយាយ ក្នុង បញ្ហា ច្បាប់ និង បទដ្ឋាន គតិយុត្ត ដែល ត្រូវបាន រៀបចំ ក្នុង វិស័យ សំណង់ នេះ ក៏ ក្រសួង បាន គិត ដែរ អំពី ភាពរឹងមាំ នៃ សំណង់ អគារ ។
មន្ត្រី ក្រសួង រៀបចំ ដែនដី រូប នេះ បាន បន្ថែម ថា ប្រហែលជា ត្រូវ មាន កិច្ចការ លម្អិត បន្ថែម ទៀត ដើម្បី ធ្វើ ការគណនា ថា តើ ផ្ទៃដី របស់ កម្បុជា នៅពេល ខាងមុខ អាច មាន ការប្រែប្រួល ឬ ជួប ឧបសគ្គ យ៉ាងម៉េច ហើយ ផ្ទៃ ក្រោម ដី មាន លក្ខណៈ យ៉ាងម៉េច ដើម្បីឲ្យ ក្រសួង បញ្ជាក់ ឲ្យ កាន់តែ ច្បាស់ អំពី ស្រទាប់ ដី នីមួយ ៗ ថា តើ វា អាច ទទួលរង ការរញ្ជួយ ដី យ៉ាងម៉េច ផងដែរ ។
កាលពី ពេល ថ្មី ៗ នេះ គ្រោះ ធម្មជាតិ រញ្ជួយ ផែនដី ដ៏ កម្រ បំផុត កម្រិត ៦.១រ៉ិច ទ័រ បាន វាយប្រហារ តំបន់ ព្រំដែន រវាង ប្រទេស ថៃ និង ឡាវ បាន បង្កឲ្យ បណ្តា ខេត្ត ជាច្រើន នៃ ប្រទេស ទាំង ពីរ ញាប់ញ័រ ខណៈ ទីក្រុង បាងកក វិញ ក៏ បាន ទទួលរង ការញ័រ រញ្ជួយ នេះ ផងដែរ ជាពិសេស គឺ អ្នក ស្ថិត នៅលើ អគារ ខ្ពស់ ៗ នានា ។
ចំពោះ ប្រទេស ឡាវ វិញ សេចក្តីរាយការណ៍ ជា លើក ដំបូង បាន ឲ្យដឹង ថា រោងចក្រ ផលិត ថាមពល អគ្គិសនី ធំ បំផុត ឈ្មោះ ហុង សា (Hongsa) ដែល មាន សមត្ថភាព ផលិត ថាមពល ១.៨៧៨ មេហ្គាវ៉ាត់ ត្រូវបាន សម្រេច ឲ្យ ផ្អាក ដំណើរការ ដើម្បី ត្រួតពិនិត្យ ផ្នែក បច្ចេកទេស បន្ទាប់ពី មាន ការបញ្ជាក់ ថា ទីតាំង នោះ បាន ទទួលរង ការញ័រ រញ្ជួយ ខ្លាំង ស្ថិត នៅ ភាគ ពាយ័ព្យ ប្រទេស ឡាវ ៕
លោក កើត ខេង ចេញមុខ បំភ្លឺ ជាសាធារណៈ និង បដិសេធ ទៅនឹង គណនី ហ្វេសប៊ុក ចំនួន ២ ដែល បង្ហោះ ព័ត៌មាន ចោទ ថា លោក ជា ជន ឆបោក
ខាងក្រោម នេះ ជា លិខិត បំភ្លឺ ជាសាធារណៈ របស់ លោក កើត ខេង រួម ជាមួយ ឯកសារ ពាក់ព័ន្ធ មួយ ចំនួន ទៀ ត៖
កាលពី ខែតុលា កន្លងទៅ ឧត្តម ស្នងការទទួលបន្ទុក បញ្ហា អាកាសធាតុ របស់ EU លោក Frans Timmermans បាន និយាយ ថា ការស្រាវជ្រាវ នឹង ចាប់ផ្តើម ទៅ លើ គម្រោង ពន្ធ ថ្មី ខាងលើ ដែល មាន គោលដៅ ការពារ ក្រុមហ៊ុន របស់ អឺរ៉ុប ពី ការប្រកួតប្រជែង ដែល ពុំ មាន តម្លាភាព តាមរយៈ ការដំឡើង តម្លៃ ផលិតផល មកពី ប្រទេស ទាំងឡាយ ណា ដែល មិន អាច ចាត់ វិធានការ គ្រប់គ្រាន់ ប្រឆាំង នឹង បញ្ហា បម្រែបម្រួល អាកាសធាតុ ។
ថ្លែង ពាក់ព័ន្ធ គម្រោង ខាងលើ លោក Zhao Yingman អនុ រដ្ឋមន្រ្តី បរិស្ថាន ចិន បាន និយាយ ថា សំណើ របស់ សហភាព អឺរ៉ុប បូករួម ជាមួយ ការសម្រេចចិត្ត របស់ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ក្នុង ការដក សហរដ្ឋ អាមេរិក ចេញ ពី កិច្ចព្រមព្រៀង អាកាសធាតុ ទីក្រុង ប៉ារីស នឹង បំផ្លាញ កិច្ចប្រឹងប្រែង អន្តរជាតិ ក្នុង ការរួមគ្នា ទប់ស្កាត់ ការកើនឡើង កម្តៅ សកល ។
គួរ ជម្រាប ថា បើ តាម លោក Zhao ផែនការពន្ធ ខាងលើ ច្បាស់ជា នឹង ដំឡើង តម្លៃ ទំនិញ ភាគ ច្រើន របស់ ចិន នៅក្នុង ទីផ្សារ អឺរ៉ុប ហើយ វា នឹង រំលោភ លើ គោលការណ៍ ស្នូល នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ស្តីពី បញ្ហា បម្រែបម្រួល អាកាសធាតុ ពិភពលោក ដែល បាន ចែង ថា ប្រទេស អ្នក មាន ៗ គួរតែ ទទួលបន្ទុក ច្រើន ជាង គេ ក្នុង ការកាត់បន្ថយ ការបញ្ចេញ ឧស្ម័ន ផ្ទះ កញ្ចក់ ៕
សាលា ក្តី ខ្មែរ ក្រហម បើក សវនាការ ស្តាប់ ទឡ្ហីករណ៍ ពី ភាគី នៅក្នុង សំណុំរឿង ០០៣ ទាក់ទង នឹង លោក មាស មុត ជា ជន ត្រូវ ចោទ
( ភ្នំពេញ ) ៖ អង្គ បុរេជំនុំជម្រះ នៃ អង្គ ជំនុំជម្រះ វិសាមញ្ញ ក្នុង តុលាការ កម្ពុជា ចាប់ផ្តើម សវនាការ ដែល មាន រយៈពេល បី ថ្ងៃ នៅក្នុង សំណុំរឿង ០០៣ ប្រឆាំង មាស មុត នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។ ការបើក សវនាការ នេះ ធ្វើឡើង ដើម្បី ស្តាប់ នូវ អំណះអំណាង ដោយ ផ្ទាល់ មាត់ របស់ ភាគី ពាក់ព័ន្ធ នានា ក្នុង សំណុំរឿង ០០៣ ដែល មាន លោក មាស មុត ជា ជន ត្រូវ ចោទ ។ នេះ បើ តាម លោក នេត្រ ភក្ត្រា ប្រធាន ផ្នែក កិច្ចការ សាធារណៈ នៃ អ. វ.ត .ក ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា សវនាការ នៅ ពេល នេះ មិន មែន ជា សវនាការ លើ អង្គសេចក្តី ពិនិត្យ លើ ភស្តុតាង ឡើយ ប៉ុន្តែ ជា សវនាការ លើ បណ្តឹង ឧទ្ធរណ៍ ក្នុង សំណុំរឿង ០០៣ ដែល ភាគី ពាក់ព័ន្ធ នានា បាន ប្តឹង ជំទាស់ នឹង ដីកា ដំណោះស្រាយ របស់ សហចៅក្រម ស៊ើបអង្កេត ដែល បាន ចេញ នា ពេល កន្លងទៅ ។
ជា កិច្ច ចាប់ផ្តើម ប្រធាន អង្គ ជំនុំជម្រះ ប្រកាស បើក សវនាការ ជាសាធារណៈ បន្ទាប់មក មាន ការអាន របាយការណ៍ នៃ សំណុំរឿង នេះ ជាសាធារណៈ ដែល លើកឡើង នូវ អង្គហេតុ ពាក់ព័ន្ធ នានា និង ប្រវត្តិ នីតិវិធី នៃ សំណុំរឿង ០០៣ ព្រមទាំង សេចក្តី លម្អិត នៃ បណ្តឹង ឧទ្ធរណ៍ នានា ដែល បាន ដាក់ នៅ ចំពោះមុខ អង្គ ជំនុំជម្រះ ។ របាយការណ៍ នេះ ត្រូវបាន ចេញ ក្នុង នាម អង្គ បុរេជំនុំជម្រះ ទាំងមូល និង បាន ដាក់បញ្ចូល ទៅក្នុង សំណុំរឿង ។ សាធារណជន ជាង ៥០០ នាក់ បាន ចូលរួម ស្តាប់ សវនាការ ដែល បើក ជាសាធារណៈ ដោយ ផ្ទាល់ ។
អង្គ បុរេជំនុំជម្រះ បាន សម្រេច ថា សវនាការ នឹង ត្រូវ ធ្វើឡើង នៅក្នុង សំណុំរឿង ០០៣ ដើម្បី ស្តាប់ ទឡ្ហីករណ៍ ពី ភាគី នៅក្នុង សំណុំរឿង មុន ពេល ដែល អង្គ បុរេជំនុំជម្រះ ចេញ សាល ដីកា លើ បណ្តឹង ឧទ្ធរណ៍ ទាំងនោះ ។
លោក នេត្រ ភក្ត្រា បាន ឱ្យដឹង ថា អង្គ បុរេជំនុំជម្រះ បាន ព្យាករ ថា នឹង អាច ចេញ សាល ដីកា លើ បណ្តឹង ឧទ្ធរណ៍ ប្រឆាំង នឹង ដីកា ដំណោះស្រាយ ក្នុង សំណុំរឿង ០០៣ នេះ នៅ ត្រឹម ត្រីមាស ទី១ ឆ្នាំ ២០២០ ខាងមុខ នេះ ថា តើ សំណុំរឿង នេះ ត្រូវ បញ្ជូន ទៅ ជំនុំជម្រះ ឬ ការទម្លាក់ ចោល គឺ អាស្រ័យ លើ ការសម្រេច របស់ ចៅ ក្រុម នៃ អង្គ បុរេជំនុំជម្រះ ដែល មាន ចៅក្រម ជាតិ ៣រូប និង ចៅក្រម អន្តរជាតិ ចំនួន ២រូប ៕
គ្រួសារ សព ពលករ ដែល បាន ទទួលមរណភាព នៅ កូរ៉េ ដោយ ជំងឺ បាន ទទួល បច្ច័យ និង សម្ភារ ពី កាកបាទ ក្រហម កម្ពុជា
ជាមួយគ្នា នោះ ដែរ ក្រុមគ្រួសារ សព បន្ទាប់ពី បាន ទទួល អំណោយ ដ៏ ថ្លៃថ្លា នេះ ក៏ បាន លើក ដៃ ប្រណម្យ សូម ថ្លែងអំណរ គុណ យ៉ាង ជ្រាលជ្រៅ ដល់ សម្ដេច ទាំង ពីរ ព្រមទាំង ថ្នាក់ដឹកនាំ ខេត្ត កំពង់ចាម និង ក្រុមការងារ ទាំងអស់ ដែល បាន នាំ អំណោយ នេះ មក ផ្តល់ ជូន ក្រុមគ្រួសារ គាត់ ផងដែរ ។
ការអញ្ជើញ នេះ គឺជា ការចាប់ផ្ដើម តំណាក់កាល ថ្មី មួយ នៃ ការស៊ើបអង្កេត ដើម្បី ដំណើការ នីតិវិធី ដក លោក ដូណាល់ ត្រាំ ពី តំណែង ជា ប្រធានាធិបតី អាមេរិក ។ លោក ត្រាំ មិន ត្រូវបាន តម្រូវ ឱ្យ ចូលរួម ក្នុង សវនាការ នេះ ទេ ប៉ុន្តែ តាមរយៈ ការអញ្ជើញ របស់ គណៈកម្មាធិការ យុត្តិធម៌ អាច អនុញ្ញាតឱ្យ លោក និង ក្រុម មន្ត្រី ច្បាប់ របស់ លោក ចូលរួម ដើម្បី តាមដាន អំពី នីតិវិធី ដក តំណែង ប្រធានាធិបតី របស់ សភា តំណាងរាស្ត្រ ។ តែ យ៉ាងណា ក៏ដោយ ខាង សេតវិមាន មិន ទាន់ ឆ្លើយតប អ្វី នឡើយ ទេ ។
គួរ បញ្ជាក់ ថា គណៈកម្មធិការ ស៊ើបអង្កេត នៃ សភា តំណាងរាស្ត្រ ដែល កំពុង ដឹកនាំ ការស៊ើអង្កេត ដើម្បី ឈាន ទៅរក ការដំណើរការ នីតិវិធី ចោទប្រកាន់ ឬ ដក តំណែង ប្រធានាធិបតី ត្រូវបាន គេ រំពឹង ថា នឹង ចេញផ្សាយ នូវ របាយការណ៍ ភស្ដុតាង ផ្លូវការ មួយ ក្រោយ សមាជិក សភា ត្រឡប់ មកកាន់ សភា វិញ នៅ ថ្ងៃទី ០៣ ខែធ្នូ ក្រោយ សម្រាក នា ឱកាស ពី បុណ្យ Thanksgiving ។
ម្យ៉ាង វិញ ទៀត បើសិនជា របាយការណ៍ នេះ ត្រូវបាន ចេញផ្សាយ មែន នោះ គណកម្មាធិការ យុត្តិធម៌ អាចនឹង ប្រើប្រាស់ វា ដើម្បី ពិចារណា ក្នុង ការចោទប្រកាន់ ជា ផ្លូវការប្រឆាំង លោក ដូណាល់ ត្រាំ មុននឹង បញ្ជូន បន្ត ឱ្យ សភា តំណាងរាស្ត្រ បោះឆ្នោត អនុម័ត នៅ ពាក់កណ្ដាល ខែធ្នូ ខាងមុខ ។
ការស៊ើបអង្កេត ដើម្បី ដំណើរការ នីតិវិធី ដក តំណែង ប្រធានាធិបតី មាន គោលដៅ ស្វែងរក ការពិត ថា តើ លោក ត្រាំ ពិតជា បាន រំលោភ អំណាច ដោយ ដាក់ ការគំរាម និង សម្ពាធ លើ អ៊ុយក្រែន ឲ្យ បើក ការស៊ើបអង្កេត ពី បទ ពុករលួយ ប្រឆាំង នឹង លោក ចូ បៃ ដិន (Joe Biden) ដែល ត្រូវបាន គេ រំពឹង ថា នឹង ក្លាយជា គូ ប្រជែង ដ៏ ធំ របស់ លោក សម្រាប់ ការបោះឆ្នោត ប្រធានាធិបតី អាមេរិក ឆ្នាំ ២០២០ ដែរ ឬ ក៏ យ៉ាងណា ខណៈ ការធ្វើ បែប នេះ ត្រូវបាន គេ ចាត់ទុក ថា ជា លើកទឹកចិត្ត ឱ្យ បរទេស លូក ដៃ ចូលក្នុង កិច្ចការ បោះឆ្នោត អាមេរិក ៕
អង្គការ សហ ប្រជាជាតិ ស្នើឲ្យ មាន កិច្ចសហប្រតិបត្តិការ លើ គំនិត ផ្តួចផ្តើម ផែនការ នៅ ទីក្រុង ក្នុង ការបញ្ចប់ ការចម្លង មេរោគ អេដស៍ ឆាប់រហ័ស
ជា ការឆ្លើយតប លោក ទេសរដ្ឋមន្រ្តី បាន ថ្លែង ថា អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ បាន ឯកភាព ក្នុង កិច្ចសហប្រតិបត្តិការ យ៉ាង សកម្ម និង មាន យន្ត ការ ប្រកបដោយ សក្តានុពល ក្នុង ការអនុវត្ត កាតព្វកិច្ច ជាមួយនឹង ក្រសួង ស្ថាប័ន ព្រមទាំង អង្គការ ដៃគូ នានា ដើម្បី ដាក់ចេញ នូវ វិធានការ ទប់ស្កាត់ ការការពារ កុំ ឲ្យ មាន ជំងឺ នេះ រីករាលដាល ដោយ អនុវត្ត តាម សូចនាករ ។
ក្រសួង ប្រៃសណីយ៍ ប្រកាស ប្រឡង ជ្រើសរើស និស្សិត និង មន្ត្រីរាជការ ស៊ីវិល ឲ្យ ចូល បម្រើ ការងារ ក្នុង ក្របខ័ណ្ឌ ក្រសួង ចំនួន ៣០កន្លែង
( ភ្នំពេញ ) ៖ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន ប្រកាស ប្រឡង ប្រជែង ជ្រើសរើស និស្សិត និង មន្ត្រីរាជការ ស៊ីវិល ឲ្យ ចូល បម្រើ ការងារ ក្នុង ក្របខ័ណ្ឌ ក្រសួង ប្រៃសណីយ៍ សម្រាប់ ឆ្នាំ ២០១៩ ក្របខ័ណ្ឌ ( ក) ចំនួន ៣០កន្លែង ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង របស់ ក្រសួង ប្រៃសណីយ៍ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
ក្រសួង បៃ្រសណីយ៍ និង ទូរគមនាគមន៍ សូម ជូនដំណឹង ដល់ និស្សិត និង មន្ត្រីរាជការ ស៊ីវិល ដែល មាន បំណង ដាក់ពាក្យ ស្នើសុំ សិទ្ធិ ប្រឡង ប្រជែង ចូល បម្រើ ការងារ ក្នុង ក្របខ័ណ្ឌ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ សម្រាប់ ឆ្នាំ ២០១៩ ឱ្យ បាន ជ្រាប ថា កាលបរិច្ឆេទ ឈប់ ទទួល ពាក្យ និង បង់ ថវិកា សុំ សិទ្ធិ ប្រឡង ត្រូវបាន កំណត់ ត្រឹម ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ វេលា ម៉ោង ១៧៖០០ នាទី ល្ងាច ។
សូម បញ្ជាក់ ថា ចំពោះ បេក្ខជន - បេក្ខ នារី ដែល បាន បង្កើត គណនី ដាក់ពាក្យ ប្រឡង តាម ប្រព័ន្ធ កុំព្យូទ័រ រួចរាល់ សូម ប្រញាប់ រួសរាន់ មក បំពេញ បែបបទ ស្នើសុំ សិទ្ធិ ប្រឡង ជា ផ្លូវការ និង ភ្ជាប់ មក ជាមួយ នូវ ឯកសារ ដូច បាន កំណត់ ក្នុង សេចក្តីជូនដំណឹង នៅ ទីស្តីការ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ៕
អារ៉ាប៊ី សាអូឌីត អញ្ជើញ សម្តេច ហេង សំរិន ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវការ និង មិត្តភាព នៅ ប្រទេស របស់ ខ្លួន
ជាមួយគ្នា នេះ សម្តេច ប្រធាន រដ្ឋសភា ក៏ បាន លើកឡើង ពី ទំនាក់ទំនង ដ៏ ល្អ រវាង រដ្ឋសភា កម្ពុជា និង រដ្ឋសភា អារ៉ាប៊ី សាអូឌីត ផងដែរ ។ រដ្ឋសភា ប្រទេស ទាំង ពីរ មាន កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា យ៉ាង ល្អ នៅក្នុង វេទិកា អង្គការ អន្តរសភា ក្នុង តំបន់ និង សកលលោក ដូចជា នៅក្នុង ក្របខ័ណ្ឌ សហភាព អន្តរសភា (IPU) និង សភា តំបន់ អាស៊ី (APA) ជាដើម នោះ ។
លោក សាអ៊ូត អាល់ សូវ៉េលីម បាន សម្តែង ក្តីរីករាយ ដែល បាន មក បំពេញ បេសកកម្ម ការ ទូត នៅ កម្ពុជា ព្រម ទំាង បាន សន្យា ថា នឹង ខិតខំ ពង្រឹង ពង្រីក ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ប្រទេស ទំាង ពីរ ឲ្យ កាន់តែ រឹងមាំ ឡើង ពិសេស នៅក្នុង វិស័យ ពាណិជ្ជកម្ម ។ លោក ឯក អគ្គ រាជ ទូត បាន ជូន លិខិត អញ្ជើញ របស់ លោក ប្រធាន រដ្ឋសភា អារ៉ាប៊ី សាអូឌីត ចំពោះ សម្តេច ប្រធាន រដ្ឋសភា អញ្ជើញ បំពេញ ទស្សនកិច្ច ផ្លូវការ និង មិត្តភាព នៅ ប្រទេស អារ៉ាប៊ី សាអូឌី ។
សម្តេច បាន ទទួលយក ការគោរព អញ្ជើញ នេះ ដោយ បាន គូសបញ្ជាក់ ថា នឹង រក ពេលវេលា សមស្រប ណាមួយ ដើម្បី បំពេញ ទស្សនកិច្ច តាម ការអញ្ជើញ ។ ក្នុង នាម រដ្ឋសភា សម្តេច បាន គាំទ្រ រាល់ កិច្ចសហប្រតិបត្តិការ ទេ្វភាគី និង ពហុ ភាគី ដែល រាជ រដ្ឋាភិបាល កម្ពុជា និង អារ៉ាប៊ី សាអូឌីត បាន និង កំពុង អនុវត្ត ជាមួយគ្នា សំដៅ នាំមក នូវ ផលប្រយោជន៍ ដល់ ប្រជាជាតិ ទាំង សងខាង ។
សម្តេច បាន ថ្លែង ថា កិច្ចសហប្រតិបត្តិការ ទំាង អស់ នេះ មិន ត្រឹមតែ ជា មូលដ្ឋាន នាំមក នូវ ផលប្រយោជន៍ និង ទំនាក់ទំនង ល្អ រវាង ប្រជាជន និង ប្រជាជន ប្រទេស ទាំង ពីរ ប៉ុណ្ណោះ ទេ គឺ ថែមទាំង បាន រួមចំណែក យ៉ាង សំខាន់ ដល់ ការថែរក្សា ស្ថិរភាព សន្តិសុខ សន្តិភាព ក្នុង តំបន់ និង សកលលោក ផងដែរ ៕ រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច ណែនាំ ឲ្យ ប្រធាន មន្ទីរ សង្គមកិច្ច ខេត្ត កំពង់ធំ ថ្មី ពង្រឹង ការងារ និង តួនាទី ខ្លួន ដើម្បី បម្រើ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ឲ្យបាន ល្អ ប្រសើរ
( កំពង់ធំ )៖ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង កិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ជំរុញ ឲ្យ ប្រធាន មន្ទីរ សង្គមកិច្ច ខេត្ត កំពង់ធំ ថ្មី ដែល ទើប ឡើង កាន់ តំណែង ជា ផ្លូវការ នៅ ថ្ងៃទី ២៧ ខែវិច្ឆកា ឆ្នាំ ២០១៩ នេះ ត្រូវ ពង្រឹង ការងារ និង តួនាទី បម្រើ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ឲ្យបាន ល្អ ប្រសើរ និង បន្ត យកចិត្តទុកដាក់ បំពេញ ការងារ ឲ្យបាន ល្អ ជាពិសេស ធ្វើ យ៉ាងណា បម្រើ ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ និង គោរព តួនាទី ការងារ របស់ ខ្លួន ឲ្យបាន ត្រឹមត្រូវ ។
ការស្នើ របស់ ដ្ឋមន្រ្តី វង សូត នា ពេលនេះ បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល លោក និង លោកស្រី អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ផ្ទេរ តំណែង ប្រធាន មន្ទីរ សង្គមកិច្ច ខេត្ត កំពង់ធំ ថ្មី លោក លី សុភា ជំនួស លោក អ៊ាប ឈុន ស្រ៊ាង នៅ ថ្ងៃទី ២៧ ខែវិច្ឆកា ឆ្នាំ ២០១៩ នេះ ។
ពិធី នោះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ឈុន ឈន់ ប្រធាន ក្រុង ប្រឹក្សា ខេត្ត កំពង់ធំ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ និង មន្រ្តី រាជការ និង កងកម្លាំង អាវុធហត្ថ ជាច្រើន នាក់ ទៀត ។
ក្រោយ ទទួលបាន តំណែង ជា ផ្លូវការ លោក លី សុភា ដែល ទើប បាន ក្លាយជា ប្រធាន មន្ទីរ សង្គមកិច្ច ខេត្ត កំពង់ធំ បាន ប្តេជ្ញាចិត្ត ថា នឹង ប្រឹងប្រែង បំពេញ ការងារ ឲ្យបាន ល្អ ហើយ នឹង គោរព តាម តួនាទី ដើម្បី បម្រើ ផលប្រយោជន៍ ជូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ឲ្យបាន ល្អ បំផុត ។
ចាប់ខ្លួន យុវជន ម្នាក់ ក្លែងបន្លំ ឯកសណ្ឋាន នគរបាល ជាតិ នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ប៉ុស្តិ៍ ចោម ចៅ ទី៣ នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ បាន ឃាត់ខ្លួន យុវជន ម្នាក់ ដែល ក្លែងបន្លំ ស្លៀកពាក់ ជា ឯកសណ្ឋាន ជា នគរបាល ជាតិ ដើម្បី អុក ឡុក ធ្វើ រឿង មិន ប្រក្រតី ទៅ លើ ជន ស្លូតត្រង់ ដូចជា ដេញ ឃាត់ ម៉ូតូ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន និង នៅ ខណ្ឌ ដ៏ទៃ ទៀត ក្នុង រាជធានី ភ្នំពេញ ។
