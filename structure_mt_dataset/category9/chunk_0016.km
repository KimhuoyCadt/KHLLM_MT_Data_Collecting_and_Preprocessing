( ភ្នំពេញ ) ៖ ចៅក្រម ជំនុំជម្រះ សាលាដំបូង រាជធានី ភ្នំពេញ លោកស្រី អ៊ុក រ៉េត គន្ធា នៅ ព្រឹក ថ្ងៃទី ២៩ ខែវិច្ឆិការ ឆ្នាំ ២០១៩ នេះ បាន បើក សវនាការប្រកាស សាលក្រម ដោយ សម្រេច អនុញ្ញាតឲ្យ ជន ត្រូវ ចោទ ឈ្មោះ គង់ រ៉ៃយ៉ា បាន នៅ ក្រៅ ឃុំ តាម ការស្នើរ សុំ ជា បណ្តោះ ប៉ុន្តែ សាលក្រម ដដែល នោះ ក៏ បាន បង្គាប់ ឲ្យ ជន ត្រូវ ចោទ ត្រូវ ចូល ខ្លួន មកកាន់ តុលាការ វិញ នៅ ព្រឹក ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០១៩ ដើម្បី ជំនុំជម្រះ លើ អង្គសេចក្តី ។
សូម រំលឹក ថា លើ សំណុំរឿង នេះ ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ លោក ឯក ប៉ូលីហ្វីល កាលពី រសៀល ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០១៩ បាន សម្រេច ចេញ ដីកា ឃុំ ខ្លួន ជន ត្រូវ ចោទ គង់ រ៉ៃយ៉ា ក្រោម ការចោទប្រកាន់ ពាក់ព័ន្ធ នឹង ករណី ញុះញង់ ឲ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ ។
ជន ត្រូវ ចោទ រូប នេះ ក៏ ធ្លាប់ ត្រូវបាន សាលាដំបូង រាជធានី ភ្នំពេញ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ រយៈពេល ១៨ ខែ ម្តង រួច មកហើយ កាលពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០១៦ ដោយ ចោទ ពី បទ ញុះញង់ ឲ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ ដោយសារតែ យុវជន នេះ បាន ប្រកាស ឲ្យ មហាជន ចូលរួម ធ្វើ បដិវត្តន៍ ពណ៌ តាម បណ្ដាញ សង្គម Facebook ជាមួយនឹង រូប គេ កាលពី ឆ្នាំ ២០១៥ ។
( ភ្នំពេញ ) ៖ អ្នកស្រី សោម សោភា ដែល មាន ទីលំនៅ បច្ចុប្បន្ន ក្នុង ស្រុក បាធាយ ខេត្ត កំពង់ចាម មាន សំណាង ត្រូវ រង្វាន់ ៤០ លាន រៀល គ្រា ដែល លោកស្រី និង ក្រុមគ្រួសារ បាន ធ្វើដំណើរកម្សាន្ត នៅ ខេត្ត ព្រះសីហនុ កាលពី ថ្ងៃទី ៨ វិច្ឆិកា កន្លងទៅ ។
អ្នកស្រី រៀបរាប់ ដំណើរ រឿង ឈ្នះ រង្វាន់ ស្ទើរតែ មិន នឹកស្មាន ដល់ នេះ ថា អ្នកស្រី បាន ទិញ ស្រាបៀរ កម្ពុជា ១កេស ដើម្បី ហូប ជុំគ្នា ជាមួយ គ្រួសារ លើ ឆ្នេរសមុទ្រ ពេលល្ងាច ។ ញុំា អស់ ប្រហែល ជិត កន្លះ កេស ប្តី របស់ គាត់ ក៏ ឃើញ គេ ដាក់ ថា ៤០ ។ ដំបូង គាត់ ស្មាន ថា ឈ្នះ ៤០នាទី ប៉ុន្តែ ដល់ ពេល អ្នកស្រី ពិនិត្យមើល ឱ្យ ច្បាស់ ក៏ ដឹង ថា មិន មែន ៤០ នាទី អ្វី ទេ គឺ ៤០ លាន រៀល ។
ទឹកប្រាក់ នេះ លោកស្រី នឹង យក ទៅ សង ធនាគារ ខ្លះ និង ចែក ឱ្យ ដល់ បងប្អូន ដែល ទៅ លេង កំពង់សោម ជុំគ្នា ខ្លះ ព្រោះ នេះ ហាក់ដូចជា សំណាង បាន មកពី ការសាមគ្គី និង រាប់អាន គ្នា ល្អ រវាង បងប្អូន ទាំងអស់ ៕
រាជធានី ភ្នំពេញ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ មហាសន្និបាត សមាគម អន្ដរជាតិ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង លើក ទី ៣៩ នៅ សប្ដាហ៍ ក្រោយ នេះ
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០២ ដល់ ថ្ងៃទី ០៤ ខែធ្នូ ឆ្នាំ ២០១៩ ខាងមុខ នេះ នឹង ធ្វើជា ម្ចាស់ ផ្ទះ នៃ មហាសន្និបាត សមាគម អន្ដរជាតិ នៃ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង (AIMF) ក្រោម ប្រធានបទ « ទីក្រុង ដែល មាន ភាពធន់ ការគិតគូ ពី បញ្ហា ប្រឈម និង ការស្ថាបនាទីក្រុង ឡើងវិញ » ដែល មាន ប្រតិភូ ជាង ៤០ ប្រទេស ចូលរួម ។
ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន ជុំវិញ ការរៀបចំ មហាសន្និបាត នេះ លោក នួន ផារ័ត្ន អភិបាល រង រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ឲ្យដឹង ថា រាជធានី ភ្នំពេញ ត្រូវបាន គណៈកម្មាធិការ អអចិន្ត្រៃយ៍ របស់ AIMF ក្នុង កិច្ចប្រជុំ លើក ទី ៣៨ របស់ AIMF នៅ ទីក្រុង លីល ប្រទេស បារាំង កាលពី ថ្ងៃទី ៥ដល់ ថ្ងៃទី ៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ កន្លងទៅ បាន ជ្រើសរើស ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ លើក ទី ៣៩ ។
បើ តាម លោក នួន ផារ័ត្ន ការធ្វើជា ម្ចាស់ ផ្ទះ លើក នេះ ជា លើក ទី១ ហើយ ដែល នេះ ជា ឧិកាស ដ៏ មាន តម្លៃ ដែល រាជធានី ភ្នំពេញ បង្ហាញ ស្នាដៃ និង បទពិសោធន៍ ក្នុង ការអភិវឌ្ឍន៍ ទីក្រុង ដែល ងើប ចេញ ពី វាល ពិឃាត ប្រល័យ ពូជសាសន៍ រហូត មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ។
អភិបាល រង រាជធានី ភ្នំពេញ រូប នេះ បាន អះអាង ទៀត ថា នៅក្នុង អាស៊ី អាគ្នេយ៍ មាន តែ រាជធានី ភ្នំពេញ មួយ គត់ ដែល ជា សមាជិក សមាគម អន្តរជាតិ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង (AIMF) ដែល មាន ផលប្រយោជន៍ ដើម្បី បង្ហាញ ទៅដល់ ទីក្រុង ២៩៤ ទីក្រុង ពី ភាពរឹងមាំ ពី សក្តានុពល ជូន ទៅ ប្រទេស ទាំងនោះ ពី បញ្ហា វិនិយោគ បេតិកភណ្ឌ ពិភពលោក ។
លោក រំពឹង និង ជឿជាក់ ថា តាមរយៈ ការធ្វើជា ម្ចាស់ ផ្ទះ នេះ រាជធានី ភ្នំពេញ និយាយ ដោយឡែក និង និយាយ ជា រួម ប្រទេស កម្ពុជា ទាំងមូល នឹង ទទួលបាន បទពិសោធន៍ ថ្មី បន្ថែម ទៀត និង ជា ឱកាស បង្ហាញ អំពី ការរីកចម្រើន របស់ ប្រទេស កម្ពុជា ប្រទេស ផ្សេង ទៀត នៅក្នុង ពិភពលោក ។ ឆ្លៀត ក្នុង ឱកាស នៃ កិច្ចប្រជុំ ប្រតិភូ ប្រទេស ដែល មក ចូលរួម នឹង ធ្វើ ទស្សនកិច្ច ទៅកាន់ ទឹកដី អង្គរ នៃ ខេត្ត សៀមរាប ផងដែរ ដើម្បី ទស្សនា ប្រាសាទ របស់ កម្ពុជា ។
សូម ជម្រាប ថា សមាគម អន្ដរជាតិ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង ត្រូវបាន បង្កើតឡើង តាំងពី ឆ្នាំ ១៩៧៩ ដើម្បី ចង ក្រប ប្រទេស ប្រើប្រាស់ ភាសា បារាំង ក្នុង ន័យ ផ្លាស់ប្ដូរ បទពិសោធន៍ និង គំនិត ល្អ ឲ្យ គ្នា ទៅ វិញ ទៅមក ។ រាជធានី ភ្នំពេញ បាន ចូល ជា សមាជិក នៃ សមាគម នេះ នៅ ឆ្នាំ ១៩៩០ ហើយ បាន ក្លាយជា សមាជិក អចិន្ដ្រៃយ៍ នៅ ឆ្នាំ ២០០៣៕ បញ្ជូន នគរបាល ក្លែងក្លាយ ម្នាក់ ទៅ តុលាការ ក្រោយ ចាប់ខ្លួន នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ យុវជន ម្នាក់ ដែល បាន បន្លំ ខ្លួន និង បាន ស្លៀកពាក់ ឯកសណ្ឋាន នគរបាល ជាតិ ត្រូវបាន បញ្ជូន ទៅកាន់ តុលាការ នា ព្រឹក ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ក្រោយ បញ្ចប់ ការសួរនាំ ពី សំណាក់ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ រួច មក ។
សូម បញ្ជាក់ ថា កម្លាំង នគរបាល ប៉ុស្តិ៍ ចោម ចៅ ទី៣ នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ បាន ឃាត់ខ្លួន យុវជន ម្នាក់ ដែល ក្លែងបន្លំ ស្លៀកពាក់ ជា ឯកសណ្ឋាន ជា នគរបាល ជាតិ ដើម្បី អុក ឡុក ធ្វើ រឿង មិន ប្រក្រតី ទៅ លើ ជន ស្លូតត្រង់ ដូចជា ដេញ ឃាត់ ម៉ូតូ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន និង នៅ ខណ្ឌ ដ៏ទៃ ទៀត ក្នុង រាជធានី ភ្នំពេញ ។
ការឃាត់ខ្លួន ជនសង្ស័យ ក្លែង បន្លំ ឯកសណ្ឋាន នគរបាល ជាតិ បាន ធ្វើឡើង នៅ វេលា ទាប ភ្លឺ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ តាម ផ្លូវ ជាតិ ៤ ភូមិ ព្រៃ ស្វាយ សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
អធិការ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ លោក យឹម សារ៉ាន់ បាន ឲ្យដឹង ថា ជនសង្ស័យ មាន ឈ្មោះ ទូច ដេវីត អាយុ ២៤ ឆ្នាំ មាន មុខរបរ លក់ ផលិតផល តាម អនឡាញ ស្នាក់ នៅ ម្ដុំ ទូល ទំពូង ទី២ ខណ្ឌ ចំការមន និង ដកហូត មធ្យោបាយ ម៉ូតូ មួយ គ្រឿង ម៉ាក ហុងដាឌ្រី ម សង់ សេ១២៥ ស៊េរី ០១៤ ពាក់ ស្លាកលេខ ភ្នំពេញ 1CU-9499 និង ឯកសណ្ឋាន នគរបាល ពណ៌ ទឹកដោះគោ មួយ កំផ្លេ មួក នគរបាល មួយ ។ ចំណែកឯ ជនរងគ្រោះ មាន ឈ្មោះ ជា សុផាន់ ណាត់ អាយុ ២៥ ឆ្នាំ មុខរបរ កម្មករ រោងចក្រ ស្នាក់ នៅ បន្ទប់ ជួល ភូមិ អង្គ សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិ៍សែនជ័យ ៕
នគរបាល បញ្ជូន ចោរ លួច ២នាក់ ទៅ តុលាការ ក្រោយ លួច ម៉ូតូ នៅ ខណ្ឌ ឫស្សីកែវ ហើយ ត្រូវ បង្ក្រាប បាន
( ភ្នំពេញ ) ៖ ជនសង្ស័យ ចំនួន ២នាក់ ដែល ជា ចោរ លួច ម៉ូតូ១ គ្រឿង បាន សម្រេច របស់ ស្ត្រី រងគ្រោះ ម្នាក់ និង ត្រូវ បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ទទួល ទោស ទណ្ឌ តាម នីតិវិធី នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បន្ទាប់ពី កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កំរិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ តាម ស្រាវជ្រាវ រហូត ឃាត់ខ្លួន បាន ។
លោក ថា ចំណែក ជនសង្ស័យ ឈ្មោះ នូ សីហា ហៅ ភិន អាយុ ២១ ឆ្នាំ មុខរបរ ជាង ជួសជុល ម៉ូតូ ស្នាក់ នៅ ផ្ទះ លេខ ៨៨ ផ្លូវ រថភ្លើង សង្កាត់ បឹងកក់២ ខណ្ឌ ទួលគោក និង ម្នាក់ ទៀត ឈ្មោះ អ៊ឹម រិទ្ធី ហៅ វ៉ា អាយុ ២៩ ឆ្នាំ មុខរបរ រើស អេត ចាយ ស្នាក់ នៅ ផ្ទះ លេខ ៨៨ ផ្លូវ រថភ្លើង សង្កាត់ បឹងកក់២ ខណ្ឌ ទួលគោក ដូចគ្នា ៕
លោក ជា ចាន់ តូ៖ វិស័យ ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ បាន រីកចម្រើន ឥត ឈប់ឈរ ក្រោម ម្លប់ សន្តិភាព សម្តេច តេជោ រយៈពេល ៤០ ឆ្នាំ កន្លងមក
នៅក្នុង មតិ ស្វាគមន៍ ដោយ នាយ ឧត្តមសេនីយ៍ ជា តារា ប្រកបដោយ មនោសញ្ចេតនា ស្រឡាញ់ រាប់អាន ដ៏ ជ្រាលជ្រៅ របស់ លោក ជា ចាន់តូ អគ្គ ទេសាភិបាល ចំពោះ កងទ័ព តាំងពី ព្រឹត្តិការណ៍ ឆ្នាំ ២០០៨ នៅ តំបន់ ព្រំដែន ទិស ប្រាសាទ ព្រះវិហារ ប្រាសាទ តា មាន់ តា ក្របី ទៅ ចុះ សួរសុខទុក្ខ កងទ័ព ញឹកញាប់ ។
នាយ ឧត្តមសេនីយ៍ ជា តារា បាន គូសបញ្ជាក់ ថា សន្តិភាព និង ការអភិវឌ្ឍ នៅ កម្ពុជា ដែល បាន មកពី នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន បញ្ចប់ នូវ សង្គ្រាម រ៉ាំរ៉ៃ ជាង ៣ទសវត្ស នាំមក នូវ សុខ សន្តិភាព ពេញលេញ បង្ក ជា មូលដ្ឋានគ្រឹះ ដល់ ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
ក្នុង នោះ ដែរ ធនាគារ ជាតិ នៃ កម្ពុជា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ឲ្យ រីកចម្រើន ទៅ មុខ ។ ការប្រឹងប្រែង ឥត ឈប់ឈរ នេះ បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា ក្លាយជា ប្រទេស មួយ ដែល មាន ការអភិវឌ្ឍន៍ ស្ទើរ គ្រប់ វិស័យ ។ ជាក់ស្ដែង វិស័យ ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ បាន រីកចម្រើន ឥត ឈប់ឈរ ជាពិសេស កងទ័ព បាន ទទួល នូវ ការតម្លើង ប្រាក់ខែ ពីរ ដង ក្នុង មួយ ឆ្នាំ ៗ ។
នាយ ឧត្តមសេនីយ៍ បាន ថ្លែង ទៀត ថា ការបណ្តុះ ឲ្យ ក្លាយជា កងទ័ព ម្នាក់ ៗ មាន សមត្ថភាព ដឹកនាំ បំពេញ ភារកិច្ចការពារ ជាតិ មាតុភូមិ ថែរក្សា សុខ សន្តិភាព ប្រឆាំង ដាច់ខាត ចលនា ឧទ្ទាម ចលនា បដិវត្តន៍ ពណ៌ ដែល មាន ចរិក ប៉ុនប៉ង ផ្តួលរំលំ រាជ រដ្ឋាភិបាល និង ឲ្យ ក្លាយជា កម្លាំង ពិត មួយ ដែល ស្មោះត្រង់ ដាច់ខាត ចំពោះ ជាតិ មាតុភូមិ សម្ដៅ ដាច់ខាត ការពារ រដ្ឋធម្មនុញ្ញ ការពារ ព្រះមហាក្សត្រ ការពារ និង គោរព ជឿជាក់ លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ។
នៅក្នុង បាឋ កថា របស់ លោក ជា ចាន់តូ បាន លើកឡើង ថា ជោគជ័យ របស់ វីរកងទ័ព លើ សមរភូមិ ប្រយុទ្ធ គឺ ស្គាល់ ច្បាស់ អំពី ខ្លួន ឯង អំពី សត្រូវ និង ក្តាប់ ឲ្យ បាន នូវ ឱកាស ជាពិសេស កត្តា មេបញ្ជាការ ដូចជា ព្រឹត្តិការណ៍ តំបន់ ប្រាសាទ ព្រះវិហារ ដែល កងទ័ព មេបញ្ជាការ កងទ័ព បាន អនុវត្ត បទបញ្ជា ដ៏ មាន ប្រសិទ្ធិភាព និង ជំហរ ចង់បាន សន្តិភាព ព្រំដែន របស់ សម្តេច តេជោ ហ៊ុន សែន ទើប សភាពការណ៍ បាន វិល មក រក សភាព ដើម ដូច ថ្ងៃ នេះ ។
យ៉ាងណាមិញ ការគ្រប់គ្រង វិស័យ ធនាគារ ជាតិ នៃ កម្ពុជា ក៏ ដូចគ្នា ដែរ គឺ នៅក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច ដែល បាន ដាក់ចេញ នូវ គោល នយោបាយ ជា យុទ្ធសាស្ត្រ ទើប ប្រព័ន្ធ ធនាគារ និង រូបិយវត្ថុ ត្រូវបាន ស្តារ ឡើងវិញ ប្រែក្លាយ ពី ប្រព័ន្ធ ធនាគារ មួយ ថ្នាក់ ទៅ ប្រព័ន្ធ ធនាគារ ពីរ ថ្នាក់ កសាង សេដ្ឋកិច្ច ទីផ្សារ និង ការបើក ទូលាយ ប្រព័ន្ធ ធនាគារ ។
នៅក្នុង បាឋ កថា ជាង បី ម៉ោង អម ដោយ បទ បង្ហាញ ជាស្លាយ លោក ជា ចាន់តូ បាន ពន្យល់ យ៉ាង ច្បាស់ អំពី ប្រវត្តិ ការ រីកចម្រើន និង ទស្សនវិស័យ នៃ ប្រព័ន្ធ ធនាគារ កម្ពុជា ព្រមទាំង ទិសដៅ នៃ ការអភិវឌ្ឍន៍ ប្រព័ន្ធ ធនាគារ ជាតិ ក្នុង រយៈពេល វែង ។
ការចាប់ផ្តើម ចាក់ ឬ ស ប្រជាធិបតេយ្យ នៅ កម្ពុជា តាំងពី ឆ្នាំ ១៩៩៣ នីតិកាល ទី១ នៃ រដ្ឋសភា រហូតមកដល់ នីតិកាល ទី៦ នៃ នេះ គឺ មាន រយ : ពេល ៣០ ឆ្នាំ មកហើយ មាន ន័យ ថា ប្រជាធិបតេយ្យ នៅ កម្ពុជា បាន ចាក់ គ្រឹះ យ៉ាង រឹងមាំ និង បាន ចូល ស៊ុប ក្នុង ប្រអប់ ប្រជាធិបតេយ្យ ពេញលេញ និង ពេញ លក្ខណ : ត្រឹមត្រូវ តាម បែប ប្រជាធិបតេយ្យ សភា និយម ពិភពលោក និង តម្រូវ តាម បែប កម្ពុជា ។
ដូច្នេះ ក្នុង ដំណាក់កាល នេះ កម្ពុជា គ្មាន ប្រធានបទ « ប្រជាធិបតេយ្យ » ត្រូវ និយាយ ទៀត ទេ ។ បញ្ហា សំខាន់ ចំពោះមុខ ដែល កម្ពុជា ត្រូវ ធ្វើ គឺ ការ « កែទម្រង់ ស៉ី ជំរៅ » ដើម្បី ធ្វើឲ្យ កាន់តែ ប្រសើរឡើង ថែម ទៀត នូវ ចំណុច ខ្វះខាត ចំណុច អសកម្ម មួយ ចំនួន តែ ប៉ុណ្ណោះ ។
ប្រជាពលរដ្ឋ កម្ពុជា ត្រូវការ ប្រព័ន្ធ រដ្ឋបាល សង្គម មួយ ដែល ស្អាតស្អំ ហើយ បាន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី កែទម្រង់ តាម រយ : ការផ្តល់ ព័ត៌មាន ពិត អំពី ភាពអសកម្ម និង អំពើ ខុសឆ្គង របស់ មន្ត្រី ។ ឯ មន្ត្រី ខិល ខូច មន្ត្រី ដែល មិន បាន បំពញ តួនាទី បម្រើ ប្រជាពលរដ្ឋ ត្រឹមត្រូវ ដាច់ខាត ត្រូវ ប្រឈមមុខ ចំពោះ អភិក្រម ទី៥ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ។ នេះ គឺជា ប្រធានបទ សំខាន់ របស់ កម្ពុជា ដែល កំពុងតែ សកម្ម នា បច្ចុប្បន្ន កាល ៕
ដោយ៖ ជុំ កុសល ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន និង ជា រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ការអធ្យាស្រ័យ ខ្ពស់ ! ស្លាប់ ៤នាក់ និង របួស ៨នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ . របួស ធ្ងន់ - ស្រាល ៨នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៨ លើក នេះ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . បត់ គ្រោះថ្នាក់ និង ងងុយដេក ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ ស្ថានការណ៍ ទូទាំង សកលលោក និង រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ផ្សេង ៗ ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
គួរ បញ្ជាក់ ថា លោក Pham Van Diep គឺជា សកម្មជន ទី៣ ហើយ ដែល ត្រូវបាន តុលាការ វៀតណាម កាត់ទោស ដាក់ ពន្ធនាគារ នៅក្នុង ខែវិច្ឆិកា នេះ បន្ទាប់ពី គ្រូបង្រៀន តន្ត្រី ម្នាក់ ត្រូវ ជាប់ ពន្ធនាគារ ១១ ឆ្នាំ កាលពី ថ្ងៃទី ១៥ ខែវិច្ឆិកា ក្រោម បទ ចោទ ស្រដៀង គ្នា នេះ និង បុរស ម្នាក់ ទៀត មាន អាយុ ៣៨ ឆ្នាំ ជាប់ចោទ ថា បាន បង្ហោះ វីដេអូ ចំនួន ៣៣ ឃ្លីប ដែល ញុះញង់ ឱ្យ ប្រជាជន វៀតណាម ធ្វើ ការតវ៉ា ប្រឆាំង រដ្ឋាភិបាល ។
ជាក់ស្ដែង មនុស្ស យ៉ាងហោចណាស់ ១៦នាក់ ត្រូវបាន ចាប់ ឃុំ ខ្លួន ឬ ត្រូវបាន កាត់ទោស នៅក្នុង ឆ្នាំ ២០១៩ នេះ ពី បទ បង្ហោះ សារ ប្រឆាំង រដ្ឋាភិបាល នៅលើ Facebook ខណៈ អង្គការ សិទ្ធិ មនុស្ស អន្តរជាតិ នានា អះអាង ថា នៅ មាន អ្នកទោស នយោបាយ ១២នាក់ ទៀត កំពុង ជាប់ ឃុំ ក្រោម បទ ចោទ ដូចគ្នា នេះ ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៨ ខែវិច្ឆការ ឆ្នាំ ២០១៩
១៖ សម្តេច តេជោ ហ៊ុន សែន បន្ត លុបចោល កម្មវិធី មួយចំនួន សម្រាប់ ចុង សប្តាហ៍ នេះ និង សប្តាហ៍ ក្រោយ ដើម្បី ថែទាំ ម្តាយ ក្មេក ក្នុង ស្ថានភាព នៃ ការបន្ត សង្គ្រោះ បន្ទាន់ ( ចុច អាន )
២៖ សម្ដេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សម្រេច ផ្តល់ អគារ សិក្សា ជូន លោកគ្រូ អ្នកគ្រូ និង សិស្ស នៅ សាលា អូរ ជុញ ខេត្ត ព្រះវិហារ ក្រោយ មាន កូនសិស្ស រៀន ក្រោម ដើមឈើ ( ចុច អាន )
៣៖ សម្តេច ទៀ បាញ់៖ ការគ្រប់គ្រង ចំនួន ទ័ព ជា រឿង សំខាន់ និង បាន ទប់ស្កាត់ ឧបាយកល បដិវត្តន៍ ពណ៌ ( ចុច អាន )
៦៖ មន្ដ្រី ពន្យល់ ថា គ្រប់ ការចំណាយ ថវិកា រដ្ឋ ទាំងអស់ សុទ្ធតែ មាន ផលប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ គ្រប់ ៗ រូប ( ចុច អាន )
៧៖ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សេដ្ឋកិច្ច៖ ទោះបី មាន ឥទ្ធិពល អន្តរជាតិ ក៏ សេដ្ឋកិច្ច កម្ពុជា នឹង សម្រេចបាន ក្នុង អត្រា ៧.១ ភាគរយ នៅ ឆ្នាំ ២០១៩ នេះ ( ចុច អាន )
៨៖ កម្ពុជា - អាល្លឺម៉ង ចុះ កិច្ចព្រមព្រៀង ហិរញ្ញប្បទាន សហប្រតិបត្តិការ ចំនួន ២ ក្នុង ទំហំ ទឹកប្រាក់ សរុប ៧៤ លាន ដុល្លារ ( ចុច អាន )
៩៖ ថ្ងៃ នេះ ខួប១ ឆ្នាំ នៃ ការដាក់បញ្ចូល ល្ខោន ខោល ក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្ស ជាតិ របស់ អង្គការ យូណេស្កូ ( ចុច អាន )
៣៖ ចិន កោះហៅ ឯក អគ្គ រដ្ឋទូត អាមេរិក ក្រោយ លោក ត្រាំ ចុះហត្ថលេខា លើ ច្បាប់ ដែល ជ្រៀត ជ្រែក បញ្ហា ទីក្រុង ហុងកុង ( ចុច អាន )
៥៖ ក្រុម បាតុករ នៅ អ៊ីរ៉ាក់ នាំគ្នា ដុត ស្ថាន កុងស៊ុល អ៊ីរ៉ង់ និង ស្រែក ទាមទារ ឲ្យ អ៊ីរ៉ង់ ចាកចេញ ពី អ៊ីរ៉ាក់ ( ចុច អាន )
៩៖ មន្ត្រី ចិន ១៩ នាក់ ប្រឈមមុខ ផ្លូវ ច្បាប់ ពាក់ព័ន្ធ ការបិទបាំង ករណី ឃាតកម្ម ក្រោយ រកឃើញ សាកសព កប់ ក្នុង តារាង បាល់ សាលារៀន កាលពី ១៦ ឆ្នាំ មុន ( ចុច អាន )
ប្រធាន គណបក្ស ប្រជាជន ខណ្ឌ ឬ ស្សីកែវ៖ សម រង្ស៉ី យក ជីវិត ពលរដ្ឋ ដណ្ដើម អំណាច ដើម្បី បុគ្គល ខ្លួន ឯង តែ សម្ដេច តេជោ ហ៊ុន សែន យក ជីវិត ផ្ទាល់ខ្លួន ធ្វើ ដើមទុន ដើម្បី ពលរដ្ឋ និង កសាង ជាតិ
លោក ជា ពិសី អភិបាល ខណ្ឌ ឫស្សីកែវ និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខណ្ឌ បាន ក្រើន រំលឹក ថា យុទ្ធសាស្ត្រ ចតុកោណ តំណាក់កាល ទី១ រហូតដល់ តំណាក់កាល ទី៤ និង គោល នយោបាយ ឈ្នះ ឈ្នះ ដែល ដាក់ចេញ ដោយ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា គឺជា គ្រូ ដែល ទាមទារ ឲ្យ យើង ទាំងអស់ គ្នា ព្យាយាម សិក្សា អនុវត្ត ក្នុង ការចូលរួម ចលនា ឲ្យបាន ផុសផុល ដើម្បី រួមចំណែក កសាង និង អភិវឌ្ឍន៍ ជាតិ កម្ពុជា ទាំង ពេល ប្ចុ ប្បន្ន និង ទៅ ថ្ងៃ អនាគត ។
ជាមួយគ្នា នេះ លោកស្រី ទូច សារ៉ុម បាន លើក ថា ការជួប ជំសំណេះសំណាល គ្នា នា ពេលនេះ ក្នុង គោលបំណង រំលឹក ខួប អនុស្សាវរីយ៍ លើក ទី ៤១ ថ្ងៃ បង្កើត សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ដែល ជា លទ្ធផល សម្រេចបាន យ៉ាង គាប់ ប្រសើរ បំផុត រយៈពេល ១ឆ្នាំ នេះ មិន មែន សំដៅ តែ លើ បុគ្គល ម្នាក់ សម្រេចបាន លទ្ធផល ល្អ នោះ ទេ លើ ការងារ បម្រើ គាំពារ កុមារ និង ជួយ សង្គម គឺ ទាល់តែ ផ្ដើម ចេញ ពី យើង ទាំងអស់ គ្នា ៕
គ្រឿងញៀន បំផ្លាញ ជីវិត អ្នក ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា៖ បង្ក្រាប ៣៤ករណី ឃាត់ខ្លួន ៨៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣៤ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១៣ករណី និង ជួញដូរ ២១ ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៨៥ នាក់ ។
មន្ត្រី រដ្ឋាភិបាល កម្ពុជា ជិត ២០០ នាក់ ទទួលបាន ការបណ្តុះបណ្តាល ពី សហភាព អឺរ៉ុប អំពី សុវត្ថិភាព គីមី
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ មន្ត្រី រាជ រដ្ឋាភិបាល កម្ពុជា ចំនួន ១៧០ នាក់ បាន ទទួល ការបណ្តុះបណ្តាល ជា ចម្បង លើ ទិដ្ឋភាព ពាក់ព័ន្ធ ជាមួយ សុវត្ថិភាព គីមី ក្នុង រយៈពេល ២សប្តាហ៍ នៅក្នុង ក្របខណ្ឌ នៃ មជ្ឈមណ្ឌល កាត់បន្ថយ ហានិភ័យ គីមី . ជីវសាស្ត្រ . វិទ្យុសកម្ម និង នុយក្លេអ៊ែរ (CBRN) នៃ គំនិត ផ្តួចផ្តើម សំរាប់ ឧត្តមភាព(CoE) របស់ សហភាព អឺរ៉ុប ។
សិក្ខាកាម មួយ ក្រុម ត្រូវបាន ជ្រើសរើស និង ទទួលបាន ការបណ្តុះបណ្តាលឲ្យ ក្លាយជា គ្រូបង្គោល ដើម្បី ពួកគេ អាច ផ្តល់ នូវ ការ បណ្តុះបណ្តាល និង ការអនុវត្ត ល្អ ៗ បន្ត ដល់ សិក្ខាកាម ផ្សេង ៗ ទៀត នៅ ទូទាំង ប្រទេស កម្ពុជា ផងដែរ ។
ប្រតិភូ សហភាព អឺរ៉ុប ប្រចាំ ប្រទេស កម្ពុជា បាន សំដែង នូវ ការកោតសរសើរ ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន ការចាប់អារម្មណ៍ ក្នុង ការលើកកម្ពស់ សុវត្ថិភាព គីមី និង សន្តិសុខ គីមី នៅក្នុង ប្រទេស កម្ពុជា និង ទីកន្លែង ផ្សេង ទៀត ក្រៅពី ប្រទេស កម្ពុជា ។ ដោយសារ វិស័យ កសិកម្ម និង ឧស្សាហកម្ម កាត់ដេរ ប្រើប្រាស់ នូវ បរិមាណ សារធាតុ គីមី ដ៏ ច្រើន នៅក្នុង ប្រទេស កម្ពុជា រដ្ឋាភិបាល មាន ការយល់ដឹង យ៉ាង ច្បាស់ អំពី សារៈសំខាន់ នៃ បញ្ហា សារធាតុ គីមី និង ការចាត់ចែង គ្រប់គ្រង សារធាតុ ទាំង នេះ ឲ្យបាន ត្រឹមត្រូវ ។
គម្រោង នេះ គ្របដណ្តប់ លើ ប្រទេស ចំនួន ១០ នៅ អាស៊ី អាគ្នេយ៍ និង មាន គោលបំណង ជួយ ដោះស្រាយ បញ្ហា ពាក់ព័ន្ធ ជាមួយ សុវត្ថិភាព និង សន្តិសុខ គីមី នៅក្នុង វិស័យ ច្បាប់ លិខិត បទដ្ឋាន គតិយុត្តិ ការទប់ស្កាត់ និង បង្កា ការរាវ រក ការត្រៀម បម្រុង និង ការឆ្លើយតប ចំពោះ ហេតុកាណ៍ ពាក់ព័ន្ធ នឹង សារធាតុ គីមី នេះ ។
គម្រោង កាត់បន្ថយ ហានិភ័យ គីមី . ជីវសាស្ត្រ . វិទ្យុសកម្ម និង នុយក្លេអ៊ែរ របស់ សហភាព អឺរ៉ុប បាន ទទួល ការឧបត្ថម្ភ មូលនិធិ ពី សហភាព អឺរ៉ុប ហើយ គម្រោង នេះ ត្រូវបាន អនុវត្ត រួមគ្នា ដោយ វិទ្យាស្ថាន ស្រាវជ្រាវ យុត្តិធម៌ និង ឧក្រិដ្ឋកម្ម អន្តរ តំបន់ របស់ អង្គការ សហ ប្រជាជាតិ (UNICRI) និង មជ្ឈមណ្ឌល ស្រាវជ្រាវ រួម (JRC) របស់ គណៈកម្មាធិការ អឺរ៉ុប ។
គម្រោង នេះ ត្រូវបាន រៀបចំ ដោយ មាន ការជួយគាំទ្រ បច្ចេកទេស ពី អង្គការ អន្តរជាតិ និង តំបន់ រដ្ឋ សមាជិក របស់ សហភាព អឺរ៉ុប និង ដៃគូ ពាក់ព័ន្ធ ផ្សេង ទៀត តាមរយៈ សហប្រតិបត្តិការ ស្អិត រមួត និង មាន ប្រសិទ្ធិភាព នៅ ថ្នាក់ ជាតិ តំបន់ និង អន្តរជាតិ ។ គម្រោង នេះ មាន ការចូលរួម ពី ប្រទេស ដៃ គូ ចំនួន ៦១ នៅក្នុង តំបន់ និង ពិភពលោក ៕
ជន មាន ពិការភាព ជើង ទាំង សងខាង រស់ នៅ ខេត្ត តាកែវ ម្នាក់ ទៀត ទទួលបាន ផ្ទះ ១ខ្នង ជា ការឧបត្ថម្ភ ពី មូលនិធិ ជន ពិការ
ថ្លែង ក្នុង កម្មវិធី នេះ លោក សៅ ឡែន បាន ឱ្យដឹង ថា កម្មវិធី ប្រគល់ ផ្ទះ ជូន ជន ពិការ ក្រីក្រ នេះ គឺ បាន រៀបចំ ជា លើក ទី២ ហើយ ដែល កាលពី លើក មុន មូលនិធិ ជន ពិការ បាន រៀបចំ នៅ ខេត្ត បាត់ដំបង ដោយ មាន ការចូលរួម ពី លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ។
លោក បាន បញ្ជាក់ ថា ការសាងសង់ ផ្ទះ នេះ គឺ បាន ប្រើប្រាស់ ថវិកា មួយ ផ្នែក ពី ហិប ប្រាក់ វិភាគទាន សប្បុរសធម៌ មូលនិធិ ជន ពិការ ដោយ អស់ ថវិកា សរុប ចំនួន ១៤.២៨០ .០០០ រៀល ដោយឡែក ថវិកា មួយ ផ្នែក ទៀត កន្លងមក មូលនិធិ ជន ពិការ បាន ប្រើប្រាស់ លើ ការទិញ អំណោយ សប្បុរស ធម៌ សម្រាប់ ផ្តល់ ជូន ដល់ ជន ពិការ ក្រីក្រ ចំនួន ៩៤៦ នាក់ ។
ក្នុង ថ្ងៃ នេះ ផងដែរ មូលនិធិ ជន ពិការ ក៏ មាន អំណោយ សប្បុរសធម៌ សម្រាប់ ផ្តល់ លោក តុត ប្រុស រួម មាន៖ ថវិកា ១០ម៉ឺន រៀល អង្ករ ២៥ គីឡូ ក្រោម ត្រីខ ០២ យួរ ទឹក ស៊ីវ អ៊ីវ០១ យួរ ទឹកត្រី ០១យួរ អំបិល ០២ កញ្ចប់ និង មី ០១កេស ។
លោក បន្ត ថា កត្តា សុខ សន្តិភាព និង ការអភិវឌ្ឍ បាន ជម្រុញ ឱ្យ ជន ពិការ បាន ទទួល ការគាំពារ ពី រាជ រដ្ឋាភិបាល ដូច អ្វី ដែល មាន នៅ ទីនេះ ស្រាប់ គឺ កម្មវិធី សាងសង់ ផ្ទះ ជូន ជន ពិការ ក្រីក្រ របស់ មូលនិធិ ជន ពិការ នេះ គឺ បាន ជួយ លើកកម្ពស់ ដល់ ជីវភាព របស់ ជន ពិការ ក្រីក្រ ក្នុង ការរស់នៅ ប្រកបដោយ សុខុមាលភាព និង សេចក្តីថ្លៃថ្នូរ ។
លោក បន្ត ថា ក្រៅពី នេះ ជន មាន ពិការភាព ក៏ ទទួលបាន ការយកចិត្តទុកដាក់ ពី រាជ រដ្ឋាភិបាល តាមរយៈ ការផ្តល់ សេវា ស្តារ លទ្ធភាព ពលកម្ម ដោយ ឥត គិត ថ្លៃ ការផ្តល់ របប គោល នយោបាយ ពិនិត្យ ថែទាំ សុខភាព ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ការជម្រុញ ឱ្យ ទទួលបាន ការងារ ធ្វើ ការសម្របសម្រួល សមស្រប សម្រាប់ ជន ពិការ និង ការដាក់បញ្ចូល ជន ពិការ ទៅក្នុង សកម្មភាព សង្គម ៕
ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ អញ្ជើញ ជា អធិបតី ក្នុង កម្មវិធី យុវជន ស្ម័គ្រចិត្ត ប្រទេស ម៉ាឡេស៊ី នៅ ស្ថានទូត ម៉ាឡេស៊ី ប្រចាំ កម្ពុជា
ថ្លែង ទៅកាន់ អ្នកចូលរួម ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ទឹកចិត្ត សប្បុរសធម៌ របស់ យុវជន ក្នុង ការជួយ រំលែក ទុក្ខ លំបាក របស់ ប្រជាជន កម្ពុជា នេះ គឺជា សក្ខីភាព នៃ ការជួយ យកអាសា គ្នា ទៅ វិញ ទៅ មក ក្នុង នាម ជា មនុស្សជាតិ និង ប្រជាជាតិ សកល ។ លោក ក៏ បាន ផ្ដាំផ្ញើ ដល់ ប្អូន ៗ យុវជន ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ភាពស្មោះត្រង់ ក្នុង ការអនុវត្ត ការងារ ។
យុវជន ស្ម័គ្រចិត្ត បាន ទទួល ការឧបត្ថម្ភ អង្ករ ៣៥ បាវ សម្រាប់ ការងារ បរិស្ថាន ៥សប្តាហ៍ នៅ ខេត្ត ព្រះសីហនុ
( ភ្នំពេញ ) ៖ ឧកញ៉ា សួរ វីរៈ បាន ឧបត្ថម្ភ ជា អង្ករ ចំនួន ៣៥ បាវ និង រថយន្តក្រុង ១គ្រឿង ក្នុង ការធ្វើដំណើរ ចំនួន ៥សប្តាហ៍ ចាប់ពី ថ្ងៃទី ២៩ ខែវិច្ឆិកា ដល់ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៩ ខាងមុខ នេះ ដើម្បីឲ្យ យុវជន ស្ម័គ្រចិត្ត មួយ ក្រុម ធ្វើ ការងារ សម្អាត បរិស្ថាន នៅក្នុង មូលដ្ឋាន ខេត្ត ព្រះសីហនុ ។
លោក ឧកញ៉ា សួរ វីរៈ បាន ឲ្យដឹង ថា ហេតុផល ដែល លោក ជួយ ឧបត្ថម ដល់ កម្មវិធី សម្អាត បរិស្ថាន នេះ ព្រោះ គ្រប់ កិច្ចការងារ សង្គម លោក តែង ចូលរួម ឧបត្ថម ជានិច្ច ។ លោក បន្ត ថា បើសិន គ្រប់ គ្នា មិន ចូលរួម ជួយសង្គម នោះ សង្គម នឹង ខ្វះ ការអភិវឌ្ឍ ជា មិន ខាន ។
ឧកញ៉ា សួរ វីរៈ ក៏ បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម និង រួមគ្នា ក្នុង កិច្ចការពារ បរិស្ថាន ដើម្បី កម្ពុជា ស្អាត និង គ្មាន សំរាម ។
កញ្ញា កែវ ទិត្យ លីដា តំណាង ឱ្យ ក្រុម យុវជន ស្ម័គ្រចិត្ត ស្ត្រី ដើម្បី សង្គម បាន ថ្លែងអំណរគុណ ដល់ ឧកញ៉ា សួ វីរៈ ដែល បាន ឧបត្ថម្ភ កម្មវិធី សម្អាត បរិស្ថាន នេះ ។
កញ្ញា បញ្ជាក់ ថា ការងារ សម្អាត បរិស្ថាន នៅក្នុង មូលដ្ឋាន ខេត្ត ព្រះសីហនុ នឹង ត្រូវ ធ្វើឡើង ដោយ និស្សិត មកពី សាកលវិទ្យាល័យ នានា ក្នុង រាជធានី ភ្នំពេញ ជាពិសេស សាកលវិទ្យាល័យ RULE និង សាកលវិទ្យាល័យ សហគ្រិន ភាព និង ន វានុវត្តន៍ ៕
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ អនុញ្ញាតឱ្យ ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី ចប់ អាណត្តិ ជួប សម្តែង ការគួរសម
នៅក្នុង ជំនួប ពិភាក្សា គ្នា រវាង ប្រមុខ ការពារ ជាតិ កម្ពុជា និង ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី ចប់ អាណត្តិ នេះ នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ក៏ បាន លើកឡើង ពី កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ដោយ ក្នុង នោះ ក៏ ជជែកគ្នា ពី កិច្ចសហប្រតិបត្តិការ យោធា ការហ្វឹកហ្វឺន សាលា ភាសា សន្តិសុខ សមុទ្រ ព្រមទាំង ការចូល សំចត នាវា យោធា របស់ អូស្ត្រាលី និង កិច្ចសហប្រតិបត្តិការ មួយចំនួន ទៀត ផងដែរ ។
កិច្ច ជំនួប នេះ ក៏ បាន ជជែក ពី ការជួយ សៀវភៅ « ស» ការពារ ជាតិ ដល់ ក្រសួង ការពារ ជាតិ កម្ពុជា ការជួយ ជួសជុល រោង ជាង នៅ មូលដ្ឋាន កងទ័ព ជើងទឹក សមុទ្រ រាម ព្រមទាំង ជំរុញ ឱ្យ មាន ការចូលរួម លើ កិច្ចប្រជុំ ផ្សេង ៗ រវាង ប្រទេស កម្ពុជា និង អូស្ត្រាលី ជាពិសេស ការប្រជុំ ផ្លាស់ប្តូរ ទស្សនៈ បទពិសោធន៍ រវាង កងទ័ព ប្រទេស ទាំង ពីរ ជាពិសេស កងទ័ព ជើងទឹក ៕
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន Smart Axiata នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន ប្រកាស កម្មវិធី ប្រគំ តន្ត្រី សប្បុរសធម៌ ដែល មាន កាចូលរួម ពី ក្រុម សិល្បៈ ករ - សិល្បៈ ការិនី ល្បី ៗ ក្នុង ស្រុក ជាច្រើន ដើម្បី លើកកម្ពស់ ការយល់ដឹង បន្ថែម ពី មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង មួយ ជួយ ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ដែល ជា មន្ទីរពេទ្យ ដែល បាន ផ្តល់ ការព្យាបាល ដោយ ឥត គិត ប្រាក់ ដល់ កុមារ កម្ពុជា រាប់ លាន នាក់ ។
ក្នុង នោះ « បុគ្គលិក និង និយោជិត ជាច្រើន របស់ យើង ក៏ ធ្លាប់ ទទួលបាន ការថែទាំ ពី មន្ទីរពេទ្យ គន្ធ បុប្ផា ផងដែរ ហេតុ នេះ ហើយ បានជា យើង សម្រេចចិត្ត មិន ត្រឹមតែ ធ្វើ ការបរិច្ឆា គ ប្រាក់ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ ប្រើប្រាស់ ធនធាន ដែល យើង មាន ដើម្បី ជួយ លើកកម្ពស់ មូលនិធិ មួយ នេះ ឲ្យ កាន់តែ ល្អ ប្រសើរ ផងដែរ » ។
ក្នុង នាម ជា អ្នកផ្តួចផ្តើម កម្មវិធី ប្រគំ តន្ត្រី នេះ ក្រុមហ៊ុន Smart រួម ជាមួយនឹង ដៃ គូ សហការ ជាច្រើន ទៀត នឹង រ៉ាប់រង រាល់ ការចំណាយ ទាំងអស់ ដែល មាន ចំនួន មិន តិច ជាង ១០០.០០០ ដុល្លារ ឡើយ សម្រាប់ ការរៀបចំ ការប្រគំ តន្ត្រី ក៏ ដូចជា ការបង្កើត យុទ្ធនាការ ស្វែងយល់ បន្ថែម ដើម្បី បង្កើន ការបរិច្ឆាក ជាសាធារណៈ សម្រាប់ មូលនិធិ នេះ ។
លើស ពី នេះ ទៅ ទៀត ក្រុមហ៊ុន Smart ក៏ បាន សន្យា ផ្ដល់ ថវិកា បង្គ្រប់ ចំនួន ទឹកប្រាក់ បរិច្ឆា គ ផងដែរ ប្រសិនបើ ទឹកប្រាក់ ដែល ប្រមូល បាន ពី ការលក់ សំបុត្រ និង សម្ភារ ផ្សេង ៗ មាន ចំនួន តិច ជាង គោលដៅ ដែល ត្រូវបាន កំណត់ ចំនួន ១០០ ០០០ ដុល្លារ នោះ ។
ជាង នេះ ទៅ ទៀត « ក្នុង នាមជា អ្នកតំណាង ឲ្យ មន្ទីរពេទ្យ ទាំងមូល អ្នកជំងឺ និង ក្រុមគ្រួសារ របស់ អ្នកជំងឺ ក៏ ដូចជា លោក អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ខ្ញុំ សូម សម្តែង ការដឹងគុណ ដ៏ ជ្រាលជ្រៅ បំផុត របស់ យើង ដល់ ក្រុមហ៊ុន Smart សិល្បៈ ករ - សិល្បៈ ការិនី និង រាល់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដែល នឹង ចូលរួមចំណែក ក្នុង កម្មវិធី ផ្តួចផ្តើម នេះ » ។
តារាចម្រៀង ដែល នឹង ចូលរួម ក្នុង ព្រឹត្តិការណ៍ នោះ បាន ថ្លែង ស្រដៀង ៗ គ្នា ថា « មន្ទីរពេទ្យ គន្ធ បុប្ផា គឺជា មន្ទីរពេទ្យ ដ៏ ពិសេស មួយ ស្ថិត ក្នុង បេះដូង របស់ យើងខ្ញុំ ទាំងអស់ គ្នា ដោយសារតែ ក្តីស្រឡាញ់ និង ការជួយ របស់ មន្ទីរពេទ្យ នេះ ទៅ លើ សុខភាព និង សុខុមាលភាព របស់ កុមារ កម្ពុជា ។
លើស ពី នោះ « យើងខ្ញុំ ពិតជា មាន កិត្តិយស ណាស់ ដែល ចូលរួមចំណែក ក្នុង កម្មវិធី ប្រគំ តន្ត្រី សប្បុរសធម៌ ដ៏ ពិសេស មួយ នេះ របស់ ក្រុមហ៊ុន Smart ហើយ ខ្ញុំ សង្ឃឹម ថា ប្រជាពលរដ្ឋ កម្ពុជា ទាំងអស់ នឹង ចូលរួម ក្នុង យុទ្ធនាការ រ៉ៃ អង្គាស ប្រាក់ ថវិកា ឲ្យបាន កាន់តែ ច្រើន តាម តែ អាច ធ្វើ ទៅ បាន សម្រាប់ មន្ទីរពេទ្យ » ។
មន្ដ្រី ជាន់ ខ្ពស់ ធនាគារ ជា តិ៖ យុទ្ធសាស្ត្រ បរិយាប័ន្ន ហិរញ្ញវត្ថុ ថ្នាក់ ជាតិ ជា ឧបករណ៍ គោល នយោបាយ សំដៅ សម្រេច ឲ្យបាន នូវ ប្រព័ន្ធ ហិរញ្ញវត្ថុ មួយ ប្រកបដោយ ស្ថិរភាព និង ប្រសិទ្ធភាព
( ភ្នំពេញ ) ៖ លោកស្រី នាវ ច័ន្ទ ថា នា ទេសាភិបាល រង ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើកឡើង ថា យុទ្ធសាស្ត្រ បរិយាប័ន្ន ហិរញ្ញវត្ថុ ថ្នាក់ ជាតិ ឆ្នាំ ២០១៩ - ២០២៥ ជា ឧបករណ៍ គោល នយោបាយ មួយ សំដៅ សម្រេច ឲ្យបាន នូវ ប្រព័ន្ធ ហិរញ្ញវត្ថុ មួយ ប្រកបដោយ ស្ថិរភាព ប្រសិទ្ធភាព និង ពិពិធកម្ម ទីផ្សារ ហិរញ្ញវត្ថុ ប្រកបដោយ បរិយាប័ន្ន ព្រមទាំង ឆ្លើយតប ទៅនឹង តម្រូវការ សេវា ហិរញ្ញវត្ថុ ក្នុង ប្រទេស ។
លើស ពី នោះ ទៅ ទៀត លោកស្រី នាវ ច័ន្ទ ថា នា បាន បន្ថែម ថា យុទ្ធសាស្ត្រ បរិយាប័ន្ន ហិរញ្ញវត្ថុ ថ្នាក់ ជាតិ ក៏ គាំទ្រ ដល់ ចីរភាព នៃ កំណើន សេដ្ឋកិច្ច សម្រេចបាន សមភាព យេនឌ័រ ផ្តល់ សិទ្ធិ អំណាច ដល់ ស្ត្រី ការបង្កើន ប្រាក់ ចំណូល របស់ ប្រជាជន និង ការកាត់បន្ថយ ភាពក្រីក្រ ផងដែរ ។
ទេសាភិបាល រង ធនាគារ ជាតិ នៃ កម្ពុជា រូប នេះ បាន បញ្ជាក់ ទៀត ថា យុទ្ធសាស្ត្រ នេះ ក៏ បាន កំណត់ ទិសដៅ សម្រាប់ រាជ រដ្ឋាភិបាល ដៃគូ អភិវឌ្ឍ នានា និង វិស័យ ឯកជន រួមគ្នា អនុវត្ត និង ផ្តោត ការយកចិត្តទុកដាក់ ទៅ លើ ផ្នែក ដែល ទាមទារ ឲ្យ មាន វិធានការ ជាបន្ទាន់ ។
លោកស្រី ថា ធនាគារ ជាតិ នៃ កម្ពុជា ត្រៀមខ្លួន រួច ជាស្រេច ក្នុង ការជួយសម្របសម្រួល ការអនុវត្ត ផែនការ សកម្មភាព និង ធានា ឲ្យ មាន កិច្ចសហប្រតិបត្តិការ រវាង ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដើម្បី សម្រេច គោលដៅ បរិយាប័ន្ន ហិរញ្ញវត្ថ ក្នុង ការបង្កើន លទ្ធភាព ទទួលបាន សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ដែល មាន គុណភាព កាត់បន្ថយ អត្រា ស្ត្រី ដែល មិន ទាន់ ទទួលបាន សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ឲ្យបាន ពាក់កណ្តាល ពី ចំនួន ២៧% មក ១៣% ។
បន្ថែម ពី នោះ ទៀត ក៏ ពង្រីក ការប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ពី ចំនួន ៥៩ % មក ៧០ % ត្រឹម ឆ្នាំ ២០២៥ ព្រមទាំង ធ្វើឲ្យ ប្រសើរឡើង នូវ សុខុមាលភាព គ្រួសារ និង គាំទ្រ ដល់ កំណើន សេដ្ឋកិច្ច ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោកស្រី នាវ ច័ន្ទ ថា នា ។
អ្នក ឧកញ៉ា ពុង ឃាវ សែ បាន ថ្លែង ថា ការសម្រេចបាន សមភាព យេនឌ័រ គឺជា ផ្នែក មួយ របស់ រាជ រដ្ឋាភិបាល ក្នុង យុទ្ធសាស្ត្រ ចតុកោណ របស់ ប្រទេស កម្ពុជា សម្រាប់ កំណើន សមធម៌ និង ប្រសិទ្ធភាព ការងារ ។ រាជ រដ្ឋាភិបាល ទទួលស្គាល់ ការចូលរួម កាន់តែ ច្រើន របស់ ស្ត្រី នៅក្នុង សេដ្ឋកិច្ច នឹង ជួយ ពន្លឿន ការសម្រេច គោលដៅ ជាតិ ដូចជា ការអភិវឌ្ឍ សេដ្ឋកិច្ច ប្រកបដោយ ចីរភាព និង ភាពយុត្តិធម៌ ។
គូសបញ្ជាក់ ថា កម្មវិធី ស្រ្តី និង ហិរញ្ញវត្ថុ រៀបចំឡើង ក្នុង គោលបំណង ផ្តោត លើ ការពិភាក្សា អំពី បរិយាប័ន្ន ហិរញ្ញវត្ថុ ក្នុង ការលើកកម្ពស់ តម្លៃ ស្រ្តី ក្នុង វិស័យ ហិរញ្ញវត្ថុ និង បញ្ហា វិសមភាព យេនឌ័រ តាមរយៈ យុទ្ធសាស្ត្រ គោល នយោបាយ បច្ចេកវិទ្យា និង ការអប់រំ ផ្នែក ហិរញ្ញវត្ថុ ដែល អាច ជួយ ឲ្យ សម្រេចបាន សមភាព យេនឌ័រ និង កាត់បន្ថយ អត្រា ស្ត្រី ដែល មិន ទាន់ ទទួលបាន សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ។ ដែល នេះ ជា ផ្នែក មួយ នៃ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី បរិយាប័ន្ន ហិរញ្ញវត្ថុ ឆ្នាំ ២០១៩ - ២០២៥ ៕
ខ្មែរ ប៊ែ វើរី ជីស តម្លើង ប្រព័ន្ធ ទាញយក ឧស្ម័ន ទៅ ប្រើប្រាស់ ម្តង ទៀត ដើម្បី ជួយ បរិស្ថាន !
( ភ្នំពេញ ) ៖ នៅក្នុង ប្រព័ន្ធ សម្អាត សំណល់ ទឹក ដែល បង្ហូរ ចេញ ពី រោងចក្រ ខ្មែរ ប៊ែ វើរី ជីស . ឧស្ម័ន មេតាន ត្រូវបាន បំលែង ពី ទឹក កខ្វក់ និង ទាញ ចេញ យក ទៅ រក្សាទុក សម្រាប់ ប្រើប្រាស់ ជា ប្រភព ថាមពល ជំនួយ នៅក្នុង ឡ ចំហាយ ។
ក្រុមហ៊ុន បាន តម្លើង ប្រព័ន្ធ ទាញយក ឧស្ម័ន មេតាន ទៅ ប្រើប្រាស់ ឡើងវិញ នេះ ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ដើម្បី ចែករំលែក ការទទួលខុសត្រូវ ក្នុង ការចូលរួម ការពារ បរិស្ថាន យើង ។
ប្រព័ន្ធ ទាញយក ឧស្ម័ន យកមក ប្រើប្រាស់ ម្តង ទៀត នេះ មាន អត្ថប្រយោជន៍ ណាស់ ក្នុង ការកាត់បន្ថយ ការប្រើប្រាស់ ធនធាន ធម្មជាតិ និង បំពុល បរិស្ថាន ជាពិសេស នោះ ការពារ ការបំភាយ ឧស្ម័ន មេតាន កាបូន ម៉ូណូ អុក ស៉ីត និង អុក ស៉ីត អាសូត ចូលក្នុង បរិយាកាស ។
ឧស្ម័ន មេតាន ត្រូវបាន ផលិត ដោយ ការរំលាយ អាហារ សរីរាង្គ និង បំលែង ជា មេតាន ឧស្ម័ន កាបូនិច អាសូត និង ស៊ុល ផូរ ។ មេតាន ត្រូវបាន ឆ្លងកាត់ ប្រព័ន្ធ ដក ស៊ុល ផូរ ដោយ បន្សុទ្ធ មេតាន បន្ទាប់មក មេតាន នេះ ឆ្លងកាត់ ឧបករណ៍ ដក សំណើម ចេញ មុន បញ្ជូន ទៅកាន់ ឡចំហាយ ។
មេតាន ត្រូវបាន ដុត ក្នុង ឡ ចំហាយ ហើយ ផលិត បានជា ចំហាយ ក្តៅ យក ទៅ ប្រើប្រាស់ សម្រាប់ តម្រូវ ការកម្តៅ ក្នុង ដំណើរការ ម៉ាស៊ីន នៃ ខ្សែ សង្វាក់ ផលិតកម្ម ដូចជា កន្លែង ស្ងោរ ស្រាបៀរ រោងចក្រ វេចខ្ចប់ និង ប្រព័ន្ធ សម្អាត ទឹក ជាដើម ៕
ផលិត ករ ជាតិ និង អន្ដរជាតិ បង្ហាញ ពី កត្តា ប្រឈម ក្នុង ការផលិតភាពយន្ដ និង យុទ្ធសាស្រ្ដ ថ្មី ៗ ដើម្បី លើកស្ទួយ ភាពយន្ដ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន រៀបចំ សិក្ខាសាលា មួយ ស្ដីពី អនាគត នៃ ឧស្សាហកម្ម ភាពយន្ដ នៅ កម្ពុជា ដោយ សិក្ខាសាលា នេះ អនុញ្ញាតឲ្យ ផលិត ករ ជាតិ និង អន្ដរជាតិ ជុំ ជួបគ្នា បើក បង្ហា ពី កត្តា ប្រឈម ក្នុង ការផលិតភាពយន្ដ និង វិធីសាស្រ្ដ ថ្មី ៗ ក្នុង ការលើកស្ទួយ វិស័យ ភាពយន្ដ ឲ្យ កាន់តែ រីកចម្រើន ឡើង ។
លោក ប៉ុក បូរ ក្ស ប្រធាន នាយកដ្ឋាន ភាពយន្ដ និង សិល្បៈ នៃ ក្រសួង វប្បធម៌ ការរៀបចំ សិក្ខាសាលា ស្ដីពី អនាគត នៃ ឧស្សាហកម្ម ភាពយន្ដ កម្ពុជា ដើម្បី បើក បង្ហាញ ឲ្យដឹង ថា រហូតមកដល់ ឆ្នាំ នេះ តើ ឧស្សាហកម្ម ភាពយន្ដ កម្ពុជា ឈរ នៅ ត្រង់ណា ? មាន ចំណុច ខ្វះខាត ត្រង់ណា ខ្លះ ? និង ត្រូវ បំពេញ បន្ថែម នូវ ចំណុច ណា ខ្លះ ? ព្រោះ បច្ចុប្បន្ន មាន មតិ មួយចំនួន លើកឡើង ថា ឧស្សាហកម្ម ភាពយន្ដ កម្ពុជា នៅពេល បច្ចុប្បន្ន កំពុងតែ ដើរ ថយ ក្រោយ ជាដើម ។
លោក បញ្ជាក់ ថា ជាក់ស្ដែង សម្រាប់ សិក្ខាសាលា ថ្ងៃ នេះ បាន ផ្ដល់ អត្ថប្រយោជន៍ ច្រើន ដល់ សិក្ខាកាម និង ដល់ ផលិត ករ កម្ពុជា ដើម្បី បើក បង្ហាញ ពី ផលលំបាក ក្នុង ការផលិតភាពយន្ដ និង ការបង្កើន សមត្ថភាព នៃ ការផលិតភាពយន្ដ ជាដើម ។
ផលិត ករ ទាំង ពីរ បាន បាន បង្ហាញ ពី បញ្ហា ប្រឈម មួយ ចំនួន ទៅ លើ ផលិត ខ្សែភាពយន្ដ នៅ កម្ពុជា ដោយ បាន លើក ស្រដៀង គ្នា ថា ភាពយន្ដ កម្ពុជា មាន ការរីកចម្រើន ខ្លះ ដែរ ប៉ុន្ដែ អត្រា នៃ ការគាំទ្រ រឿង ជាតិ នៅ មាន កម្រិត នៅឡើយ ព្រោះ ទស្សនជន គាំទ្រ រឿង បរទេស ច្រើន ជាង ។
បន្ថែម ពី នេះ ផលិត ករ ទាំង ពីរ ក៏ បាន បង្ហាញ អំពី យុទ្ធសាស្រ្ដ ផ្សេង ៗ ក្នុង ការជំរុញ និង ធ្វើ យ៉ាងណា ឲ្យ វិស័យ ភាពយន្ដ ជាតិ កាន់តែ រីកចម្រើន និង បន្ដ ឈានជើង ចូល ទីផ្សារ អន្ដរជាតិ ៕
ក្រសួង ធនធាន ទឹក និង រដ្ឋបាល ខេត្ត ក្រចេះ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន និង រួមគ្នា ថែរក្សា ទឹក ទុក សម្រាប់ ប្រើប្រាស់ នា រដូវ ប្រាំង
( ក្រចេះ ) ៖ លោក ម៉ី លី ហួត អនុ រដ្ឋលេខាធិការ ក្រសួង ធនធាន ទឹក និង រដ្ឋបាល ខេត្ត ក្រចេះ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ កង្វះ ទឹក ប្រើប្រាស់ នា រដូវ ប្រាំង ដែល ឈាន មកដល់ ពេល ខាងមុខ នេះ ។
ការអំពាវនាវ បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ជា អធិបតី ក្នុង វេទិការ សាធារណៈ ដែល ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅក្នុង ភូមិ យៀវ ឃុំ កំពង់ចាម ស្រុក សំបូរ ខេត្ត ក្រចេះ ដែល មាន ការអញ្ចើញ ចូលរួម ពី អភិបាល រង ខេត្ត ក្រុមការងារ ថ្នាក់ ជាតិ ខេត្ត ស្រុក និង មន្រ្តី អាជ្ញាធរ ពាក់ព័ន្ធ គ្រប់ លំដាប់ថ្នាក់ និង ប្រជាពលរដ្ឋ សរុប ចំនួន ២៥៥ នាក់ ។
កម្ម ការិនី សិប្បកម្ម ធ្វើ ធូប នៅ ខេត្ត កោះកុង មាន សំណាង ឈ្នះ រង្វាន់ ធំ ១០០ លាន រៀល ពី តែ បៃតង អ៊ីឈីតាន់
( កោះកុង ) ៖ កម្ម ការិនី បម្រើ ការងារ នៅ សិប្បកម្ម ផលិត ធូប ម្នាក់ មាន ឈ្មោះ ណុប សោភា អាយុ ៣០ ឆ្នាំ ស្នាក់ នៅ បន្ទប់ ជួល មួយ កន្លែង ស្ថិត ក្នុង ភូមិ ៣ សង្កាត់ ដង ទង់ ក្រុង ខេមរៈ ភូមិន្ទ ខេត្ត កោះកុង មាន សំណាង បាន ឈ្នះ រង្វាន់ ធំ ពី តែ បៃតង អ៊ីឈីតាន់ នូវ ទឹកប្រាក់ សុទ្ធ ចំនួន ១០០ លាន រៀល បន្ទាប់ពី ទិញ ទទួលទាន ចំនួន ១ដប កាលពី ចុង សប្ដាហ៍ កន្លងទៅ នេះ ។
ថ្លែង ប្រាប់ ក្រុមការងារ ដែល បាន ចុះ ប្រគល់ រង្វាន់ ធំ ដល់ បន្ទប់ ជួល ផ្ទាល់ អ្នកនាង ណុប សោភា បាន រៀបរាប់ប្រាប់ ឱ្យដឹង ថា អ្នកនាង មាន ស្រុក កំណើត នៅ ខេត្ត ពោធិ៍សាត់ ប៉ុន្តែ ដោយសារតែ ជីវភាព គ្រួសារ ជួប ការលំបាក ខ្វះខាត និង រស់ នៅក្នុង ភាពជា ស្ត្រី មេម៉ាយ មាន កូន តូច ចំនួន ២នាក់ នៅក្នុង បន្ទុក ផង នោះ អ្នកនាង ក៏ បាន សម្រេចចិត្ត ចាក់ ចេញ ពី ស្រុក កំណើត មក រស់ នៅ ខេត្ត កោះកុង ដោយ ជួល បន្ទប់ គេ និង បម្រើ ការងារ ជា កម្មការិនី ក្នុង សិប្បកម្ម ផលិត ធូប ។
អ្នកនាង បាន បន្ត ថា លុះ ពេល មួល គម្រប ដប ទទួលទាន ក៏ ស្រាប់តែ ឃើញ មាន រង្វាន់ ១០០ លាន រៀល នៅក្នុង គម្រប ដប តែម្ដង ភ្លាម នោះ អ្នកនាង ពិតជា មានអារម្មណ៍ រំភើប ខ្លាំង មែនទែន ហើយក៏ បាន ស្រែក ប្រាប់ អ្នក នៅជិតខាង គ្នា ឱ្យ ជួយ ពិនិត្យមើល និង ទូរស័ព្ទ ជូនដំណឹង ដល់ ក្រុមហ៊ុន តាមរយៈ លេខ ទូរស័ព្ទ ដែល មាន ស្រាប់ នៅនឹង គម្រប ដប ។
អ្នកនាង បាន បញ្ជាក់ ទាំង អារម្មណ៍ រំជើបរំជួល ទៀត ថា ក្រោយពី ទទួលបាន លុយ រង្វាន់ ធំ ១០០ លាន រៀល ពី តែ បៃតង អ៊ីឈីតាន់ អ្នកនាង នឹង យក មួយចំនួន ទៅ សង បំណុល គេ ហើយ ទុក មួយចំនួន ទៀត សម្រាប់ បង្កើត មុខរបរ ដើម្បី ទ្រទ្រង់ ជីវភាព គ្រួសារ ទៅ ថ្ងៃ អនាគត ។
សន្និសីទ ពិនិត្យ ឡើងវិញ នៃ រដ្ឋ ភាគី អនុសញ្ញា អូតា វ៉ា អនុម័ត គាំទ្រ ដល់ សំណើ សុំ ពន្យារ ពេល បោសសម្អាត មីន របស់ កម្ពុជា និង គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ការប្តេជ្ញាចិត្ត ក្នុង ការដោះស្រាយ បញ្ហា មីន និង សំណល់ ជាតិ ផ្ទុះ របស់ កម្ពុជា
ជាមួយគ្នា នោះ លោក ទេសរដ្ឋមន្រ្តី បាន ឲ្យដឹង ថា គណៈប្រតិភូម អាជ្ញាធរ មីន បាន ជួបប្រជុំ ទ្វេ ភាគី គ្រប់ ប្រទេស ដែល កំពុង ផ្តល់ ជំនួយ ប្រទេស ដែល អាចនឹង ផ្តល់ ជំនួយ ព្រមទាំង ដៃគូរ អភិវឌ្ឍន៍ ផ្សេង ៗ ហើយ ជា លទ្ធផល នៃ ជំនួប នោះ តំណាង មកពី ប្រទេស កាណាដា បាន គាំទ្រ យ៉ាង ខ្លាំង ហើយ បាន សន្យា ថា នឹង ស្នើសុំ ឲ្យ រាជ រដ្ឋាភិបាល របស់ គេ ឲ្យ បង្កើន ជំនួយ សម្រាប់ វិស័យ សកម្មភាព មីន នៅ កម្ពុជា បន្ថែម ទៀត ។
បើ តាម លោក ទេសរដ្ឋមន្រ្តី តំណាង មកពី ប្រទេស ស៊ុយអែត ក៏ បាន គាំទ្រ យ៉ាង ខ្លាំង ដោយ សន្យា ថា នឹង ស្នើសុំ ឲ្យ រដ្ឋាភិបាល របស់ គេ ផ្តល់ ជំនួយ មនុស្សធម៌ ដល់ វិស័យ សកម្មភាព មីន នៅ កម្ពុជា ផងដែរ ដើម្បី ជួយ ឲ្យ ប្រទេស កម្ពុជា សម្រេចបាន តាម ផែនការ យុទ្ធសាស្រ្ត សកម្មភាព មីន ២០១៩ - ២០២៥ ។
ស្នងការ ខេត្ត កំពង់ចាម បញ្ជា កម្លាំង នគរបាល ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ ថែរក្សា សន្ដិសុខ សុវត្ថិភាព និង សណ្ដាប់ ជូន ប្រជាពលរដ្ឋ
( កំពង់ចាម )៖ ស្នងការ នគរបាល ខេត្ដ កំពង់ចាម លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ដាក់ បទបញ្ជា ជាថ្មី ម្ដង ទៀត ឲ្យ កម្លាំង នគរបាល ទូទាំង ខេត្ត កំពង់ចាម ត្រូវតែ បង្កើន និង ពង្រឹង ការយកចិត្តទុកដាក់ បន្ថែម ទៀត ដើម្បី ការពារ ថែរក្សា សន្ដិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ សាធារណៈ ជូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ។
បទបញ្ជាថ្មី នេះ ត្រូវបាន រំលេចឡើង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ដឹកនាំ កិច្ចប្រជុំ បូកសរុប សភាពការណ៍ លទ្ធផល កិច្ច ប្រតិបត្តិការ សន្តិសុខ សង្គម ការងារ នគរបាល និង សហគមន៍ ប្រចាំ ខែវិច្ឆិកា និង ទិសដៅ ខែធ្នូ ឆ្នាំ ២០១៩ ។
ក្នុង កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពី លោក លោកស្រី ស្នងការ រង លោក អនុប្រធាន ផែន ជំនាញ លោក លោកស្រី នាយ នាយ រង ការិយាល័យ លោក នាយ ផ្នែក បេតិកភ័ណ្ឌ លោក អធិការ អធិការង នគរបាល ស្រុក ក្រុង ទាំង១០ លោក នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទាំង ១០៩ សរុប អ្នកចូលរួម មាន ចំនួន ៣៤១ នាក់ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន សង្កត់ធ្ងន់ ថា កិច្ចការពារ ថែរក្សា សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សាធារណៈ ជូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន កម្លាំង នគរបាល ត្រូវតែ ពង្រឹង ការអនុវត្ត ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ទៅ តាម អ្វី ដែល ជា ភារកិច្ច ថ្នាក់ដឹកនាំ ប្រគល់ ជូន ៕
កូរ៉េ បន្ត ជួយ គាំពារ សុខភាព សុវត្ថិភាព កម្មករ តាម រោងចក្រ នៅ កម្ពុជា ក្នុង គម្រោង ចំណាយ ថវិកា ជាង ២៧ម៉ឺន ដុល្លារ
( ភ្នំពេញ )៖ គណៈប្រតិភូ នៃ ទីភ្នាក់ងារ សុខភាព និង សុវត្ថិភាព ការងារ កូរ៉េ (KOSHA) នៃ សាធារណរដ្ឋ កូរ៉េ បាន អញ្ជើញ ទស្សនកិច្ច នៅ កម្ពុជា ដើម្បី ប្រមូល ព័ត៌មាន ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ និង សន្យា ថា នឹង បន្ត ជួយ កម្ពុជា ក្នុង ការលើកកម្ពស់ បញ្ហា សុវត្ថិភាព និង សុខភាព ការងារ ដល់ កម្មករ និយោជិត នៅ តាម រោងចក្រ សហគ្រាស ឱ្យ កាន់តែ ប្រសើរ បន្ថែម ទៀត និង ដើម្បី បង្ហាញ នូវ ការគាំទ្រ ដល់ គម្រោង សិក្សា ស្រាវជ្រាវ និង រៀបចំ ច្បាប់ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ សម្រាប់ កម្ពុជា ផងដែរ ។
ឆន្ទៈ ដ៏ មោះ មុត នេះ ត្រូវបាន បញ្ជាក់ ក្នុង ជំនួប រវាង លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង លោកស្រី Heaeun CHOI អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន អភិវឌ្ឍ កិច្ចសហប្រតិបត្តិការ ក្រសួង ការងារ កូរ៉េ នា ព្រឹក ថ្ងៃព្រហស្បតិ៍ ២កើត ខែមិគសិរ ឆ្នាំ កុរ ឯកស័ក ព .ស ២៥៦៣ ត្រូវនឹង ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ ទីស្ដីការ ក្រសួង ការងារ ។
លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បាន ស្នើ ដល់ ភាគី កូរ៉េ ជួយ ពន្លឿន ការអនុវត្ត គម្រោង សិក្សា ស្រាវជ្រាវ និង រៀបចំ ច្បាប់ ស្ដីពី សុវត្ថិភាព និង សុខភាព ការងារ នៅ កម្ពុជា ឲ្យ រួចរាល់ នៅ ឆ្នាំ ២០២៣ ខាងមុខ នេះ ដើម្ប កាត់បន្ថយ នូវ គ្រោះថ្នាក់ ការងារ ជំងឺ វិជ្ជាជីវៈ របស់ កម្មករ និយោជិត នៅ កន្លែង ធ្វើការ ដែល ច្បាប់ នេះ បាន ប្រើប្រាស់ នៅក្នុង តំបន់ អាស៊ាន រួច មកហើយ ដែរ លើកលែងតែ ប្រទេស កម្ពុជា និង ប្រទេស ឡាវ ប៉ុណ្ណោះ ដែល មិន ទាន់ មាន ច្បាប់ នេះ នៅឡើយ ។
ជា ការឆ្លើយតប លោកស្រី Heaeun CHOI បញ្ជាក់ ថា រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ កូរ៉េ បាន កំពុងតែ រៀបចំ ច្បាប់ គតិយុត្ត និង ចុះ សិក្សា ស្រាវជ្រាវ បន្ថែម ទៀត ដើម្បី ធានា ថា ក្រោយពី ច្បាប់ នេះ ត្រូវបាន ដាក់ ឲ្យ អនុវត្ដ គឺ ទទួល ការគាំទ្រ ពី គ្រប់ ភាគី ពាក់ព័ន្ធ និង ផ្ដល់ ផលប្រយោជន៍ ដល់ កម្មករ និយោជិត កាន់តែ ប្រសើរឡើង ។
លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង បញ្ជាក់ បន្ថែម ថា ការរៀបចំ ច្បាប់ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ បាន កំណត់ នៅក្នុង កម្មវិធី ទី១ នៃ ផែនការ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ វិស័យ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដំណាក់កាល ទី២ ឆ្នាំ ២០១៩ - ២០២៣ របស់ ក្រសួង ការងារ និង រួមចំណែក ដល់ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ជាពិសេស ការយកចិត្តទុកដាក់ លើ សុខ មាលភាព និង សុវត្ថិភាព ការងារ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី ចំពោះ កម្មករ និយោជិត ។
ជាង នេះ ទៅ ទៀត ការរៀបចំ ច្បាប់ ស្តីពី សុវត្ថិភាព ការងារ នឹង រួមចំណែក ក្នុង ការកែលម្អ ក្របខណ្ឌ ច្បាប់ បំពេញការខ្វះខាត លិខិត បទដ្ឋាន គតិយុត្ត ក្នុង វិស័យ នេះ ពង្រឹង ប្រព័ន្ធ គ្រប់គ្រង សុវត្ថិភាព និង សុខភាព ការងារ ថ្នាក់ ជាតិ ថ្នាក់ ក្រោម ជាតិ និង ថ្នាក់ សហគ្រាស គ្រឹះស្ថាន ការកាត់បន្ថយ គ្រោះថ្នាក់ ការងារ និង ជំងឺ វិជ្ជាជីវៈ ដែល រួមចំណែក យ៉ាង សំខាន់ ដល់ វឌ្ឍនភាព និង ពិពិធកម្ម ផ្នែក សេដ្ឋកិច្ច - សង្គម នៅ កម្ពុជា ព្រមទាំង ការប្រកួតប្រជែង ក្នុង តំបន់ និង អន្តរជាតិ ។
សូម បញ្ជាក់ ថា ដោយ មាន ការស្នើសុំ ពី ភាគី កម្ពុជា លើ ការរៀបចំ ច្បាប់ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ KOSHA បាន ឯកភាព លើ ការគាំទ្រ ដល់ កម្ពុជា ក្នុង ការសិក្សា ស្រាវជ្រាវ និង រៀបចំ ដោយ នាយកដ្ឋាន ពេទ្យ ការងារ នៃ ក្រសួង ការងារ តាមរយៈ គម្រោង សម្រាប់ រយៈពេល ៣ ឆ្នាំ ( ២០២១ - ២០២៣) ។
គម្រោង នេះ មាន គោលបំណង សិក្សា ស្រាវជ្រាវ និង ដំណើរការ រៀបចំ ច្បាប់ ស្តីពី សុវត្ថិភាព និង សុខភាព ការងារ ដែល នាយកដ្ឋាន ពេទ្យ ការងារ នៃ ក្រសួង ការងារ ជា អ្នក អនុវត្ត គម្រោង ដោយ មាន ការគាំទ្រ ផ្នែក បច្ចេកទេស និង ហិរញ្ញវត្ថុ ពី ក្រសួង មុខរបប និង ការងារ និង KOSHA ដែល ប្រើប្រាស់ ថវិកា សរុប ចំនួន ២៧៧. ៨៦៣ ដុល្លារ អាមេរិក ៕
ប្រទេស ក្នុង មហា អនុ តំបន់ មេគង្គ គាំទ្រ គម្រោង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ តភ្ជាប់ បណ្ដាញ ទេសចរណ៍ ពី ប្រទេស មួយ ទៅ មួយ ទៀត
ការឯកភាព គ្នា នេះ ត្រូវបាន ធ្វើឡើង ក្នុង ពិធី បើក កិច្ចប្រជុំ ក្រុមការងារ ទេសចរណ៍ លើក ទី៤៤ នៃ ប្រទេស ក្នុង មហា អនុ តំបន់ មេគង្គ ក្រោម អធិបតីភាព លោក ទិត ចន្ថា រដ្ឋលេខាធិការ ប្រចាំ កា នៃ ក្រសួង ទេសចរណ៍ និង ដឹកនាំ កិច្ចប្រជុំ ដោយ លោក ថោង រដ្ឋសក្តិ អគ្គ នាយក អភិវឌ្ឍន៍ ទេសចរណ៍ និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ក្រសួង ទេសចរណ៍ ។
កិច្ចប្រជុំ ក៏ ទទួលបាន នូវ ការគាំទ្រ ពី ដៃគូរ អភិវឌ្ឍន៍ នានា លើ ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស ក្នុង វិស័យ ទេសចរណ៍ និង ការអភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ពន្ធ ក្នុង ការតភ្ជាប់ នៃ បណ្តា ប្រទេស ក្នុង តំបន់ GMS ៕
មន្ដ្រី ពន្យល់ ថា គ្រប់ ការចំណាយ ថវិកា រដ្ឋ ទាំងអស់ សុទ្ធតែ មាន ផលប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ គ្រប់ ៗ រូប (Video inside) ( ភ្នំពេញ ) ៖ មិន ថា ក្នុង កម្រិត ណា នោះ ទេ អ្វី ដែល ជា ការចំណាយ ទាំងអស់ របស់ រាជ រដ្ឋាភិបាល គឺ សុទ្ធតែ ផ្ដល់ ផលប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ ទាំង ប្រយោជន៍ ផ្ទាល់ និង ប្រយោជន៍ ដោយ ប្រយោល ។ នេះ ជា ការលើកឡើង របស់ លោក ហាវ រតនៈ ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ថវិកា ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
ក្នុង សន្និសីទ សារព័ត៌មាន ស្ដីពី « វឌ្ឍនភាព ជាតិ និង ការបែងចែក ភាគលាភ ប្រកបដោយ សមធម៌ » នៅ ព្រឹក ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ លោក ហាវ រតនៈ បាន ពន្យល់ ថា ការបែងចែក ភាគលាភ ទៅកាន់ ប្រជាពលរដ្ឋ ត្រូវបាន ធ្វើឡើង យ៉ាង ប្រាកដប្រជា ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ ផលប្រយោជន៍ ទាំងអស់ នោះ ធ្លាក់ ទៅ លើ ដៃ ប្រជាពលរដ្ឋ វិញ ។
លោក អះអាង ថា យន្ដ ការសារពើពន្ធ ក៏ ជា ផលប្រយោជន៍ សំខាន់ មួយ ដល់ ប្រជាពលរដ្ឋ តាមរយៈ ការ មិន បង់ ពន្ធ លើ ទោចក្រយានយន្ដ និង ត្រី ចក្រ ជាដើម ។ លើស ពី នេះ រាជ រដ្ឋាភិបាល ក៏ បាន ទម្លាក់ ថវិកា ជាតិ យ៉ាង ច្រើន ទៅ លើ វិស័យ សង្គមកិច្ច តាមរយៈ ក្រសួង អប់រំ . ក្រសួង សុខាភិបាល និង ក្រសួង ការងារ ដែល ការចំណាយ សរុប កើនឡើង ១. ៨ដង ( ឆ្នាំ ២០១៩ ធៀប ឆ្នាំ ២០១៣) ។
