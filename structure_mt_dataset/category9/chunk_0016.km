( កំពង់ស្ពឺ ) ៖ សមត្ថកិច្ច នគរបាល ខេត្ត កំពង់ស្ពឺ ក្រោម ការបញ្ជា ពី លោក ឧត្តមសេនីយ៍ ទោ សម សាមួន ស្នងការ នគរបាល ខេត្ត បាន ឃាត់ខ្លួន ជនសង្ស័យ ដែល ជា ជនជាតិ ខ្មែរ និង វៀតណាម ចំនួន ៥នាក់ ជា បន្តបន្ទាប់ ពាក់ព័ន្ធ នឹង ករណី យក ម៉ាស៉ីន ខួង ទៅ ខួង រក ថ្ម ម៉ាប នៅ ដែន ជម្រក បរិស្ថាន ដោយ គ្មាន ច្បាប់ អនុញ្ញាត ត្រឹមត្រូវ ។
លោក ញ៉ែ ម សៅ ស្នងការ រង នគរបាល ខេត្ត កំពង់ស្ពឺ បាន បញ្ជាក់ ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ថា ជនសង្ស័យ ទាំង ៥នាក់ នោះ រួម មាន៖ ជនជាតិ ខ្មែរ ៣នាក់ និង ជនជាតិ វៀតណាម ២នាក់ ។ ជនសង្ស័យ ទាំងនេះ ត្រូវបាន ឃាត់ខ្លួន ពី បទ លួច ធនធាន ធម្មជាតិ ខុស ច្បាប់ ដែល ប្រព្រឹត្តិ នៅ ភូមិ ក្បាល ដំរី ឃុំ ត្រពាំង ជោរ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ។
លោក ញ៉ែ ម សៅ បាន រៀបរាប់ ថា កាលពី ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៩ មាន ជនជាតិ វៀតណាម ៣នាក់ និង ខ្មែរ ម្នាក់ បាន យក ម៉ាស៉ីន ខួង ទៅ ខួង ដី នៅ ដែនដី ជម្រក បរិស្ថាន របស់ ក្រសួង បរិស្ថាន ដោយ គ្មាន ច្បាប់ អនុញ្ញាត ត្រូវ ត្រូវ ដើម្បី រុករក ធនធាន ធម្មជាតិ ជា ប្រភេទ ថ្ម ម៉ាប ។
បន្ទាប់មក ថ្មី ៗ នេះ មាន អង្គការ ប្រយុទ្ធ ប្រឆាំង អំពើពុករលួយ បាន ឃើញ សកម្មភាព បែប នេះ ក៏ បាន រាយការណ៍ ទៅ សមត្ថកិច្ច ។ ក្រោយមក ពួក ឈ្មួយ ដែល ជា ជនសង្ស័យ ទាំងនោះ បាន រុះរើ សម្ភារ ខួង ដី យក ទៅ រក្សាទុក នៅឯ ផ្ទះ ប្រជាពលរដ្ឋ ម្នាក់ ឈ្មោះ ឈន ធុល ដែល ផ្ទះ នោះ មាន ចម្ងាយ ជាង ១គីឡូម៉ែត្រ ពី ទីកន្លែង ធ្វើ សកម្មភាព ខួង ដី ។
ស្នងការ រង នគរបាល ខេត្ត កំពង់ស្ពឺ បាន ឲ្យដឹង បន្ត ថា ក្រោយពី លាក់ ទុក សម្ភារ ខួង ដី រួចហើយ ជនសង្ស័យ វៀតណាម ចំនួន ៣នាក់ បាន រត់ មក រាជធានី ភ្នំពេញ នៅសល់ ជនសង្ស័យ ម្នាក់ ឈ្មោះ ទីន សិដ្ឋ ។ ជនសង្ស័យ ទីន សិដ្ឋ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន និង ប្រាប់ ឲ្យ ទាក់ទង ទៅ បក្ខពួក ។
ក្រោយមក ទៀត នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ មាន ជនជាតិ ខ្មែរ ២ និង វៀតណាម ២ បាន ទៅ យក សម្ភារ ខួង ដី នោះ ដែល បាន លាក់ ទុក នៅឯ ផ្ទះ ឈ្មោះ ឈន ធុល នៅឯ ខេត្ត កំពង់ស្ពឺ វិញ ក៏ ត្រូវ សមត្ថកិច្ច ឃាត់ខ្លួន ទាំងអស់ តែម្តង ។
ប្រធាន មន្ទីរ ធនធាន ទឹក ខេត្ត ឧត្តរមានជ័យ អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ត្រូវ ចេះ ថែរក្សា ប្រភព ទឹក ដែល មាន និង កុំ ប្រើប្រាស់ ទឹក ដោយ ខ្ជះខ្ជាយ
( ឧត្តរមានជ័យ )៖ លោក ញឺន កួន ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧត្តុនិយម ខេត្ត ឧត្តរមានជ័យ តាមរយៈ អង្គភាព ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ថ្លែង អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ត្រូវ ចូលរួម ថែរក្សា ប្រភព ដែល មាន ស្រាប់ ឲ្យបាន ល្អ និង ត្រូវ ប្រើប្រាស់ ទឹក ឲ្យបាន ត្រឹមត្រូវ ពោលគឺ កុំ ប្រាស់ ទឹក ដោយ ការខ្ជះខ្ជាយ ដូចជា បូម បាច យក ត្រី ជាដើម ។
លោក ញឺន កួន បាន គូសបញ្ជាក់ ទៀត ថា នៅ តាម អាង ស្តុក ទឹក សំខាន់ ៗ គឺ បាន បិទ ទ្វារ ទឹក ហើយ ពោលគឺ នៅ ឆ្នាំ ២០១៩ នេះ ក្រោយ បញ្ចប់ ទឹកភ្លៀង មន្ទីរ បាន បិទ ទ្វារ ទឹក តាម បណ្តាល អាងទឹក សំខាន់ ៗ ដូច្នេះ យើង មាន ទឹក ពេញ អាង សំខាន់ ៗ ដើម្បី ត្រៀម សម្រាប់ ពេល ខាងមុខ ។
ប៉ុន្តែ ទន្ទឹម និង អាង ស្តុក ទឹក មាន ទឹក ពេញ ហើយក៏ ដោយ លោក ញឺន កួន បាន សំណូមពរ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ អនុវត្ត តាម សារាចរណ៍ ណែនាំ របស់ រាជ រដ្ឋាភិបាល គឺ ធ្វើ ស្រូវ ប្រាំង បាន តែ ម្តង មិន អាច ធ្វើ លើក ទី២ បាន ទេ និង ត្រូវ ប្រើប្រាស់ ដោយ សន្សំ សំចៃ កុំ ប្រើ ដោយ ខ្ជះខ្ជាយ ចៀសវាង ការខ្វះ ទឹក នៅពេល ខាងមុខ ដោយសារ យើង នៅ រយៈពេល យូរ គឺ ចាប់ពី ខែ ១១ ឆ្នាំ ២០១៩ ដល់ ខែ៥ ឆ្នាំ ២០២០ ពោលគឺ រយៈពេល ៧ខែ ដែល យើង ទាំងអស់ គ្នា ត្រូវ មាន ការប្រុងប្រយ័ត្ន ។
លោក ញឺន កួន បាន ឲ្យដឹង ទៀត ថា សម្រាប់ ខេត្ត ឧត្តរមានជ័យ គឺ មិន មាន ការព្រួយបារម្ភ រឿង ការខ្វះខាត ទឹក ប្រើប្រាស់ នោះ ទេ ដោយសារ អាង ស្តុក ទឹក ក៏ ដូចជា ប្រភព ទឹក ធម្មជាតិ ផ្សេង ៗ ទៀត នៅ មាន ទឹក ពេញ ទាំងអស់ ចឹង លោក គិត ថា សម្រាប់ ខេត្ត ឧត្តរមានជ័យ គឺ មិន មាន ការព្រួយបារម្ភ ខ្លាំង ពេក ទេ ។ ប៉ុន្តែ លោក បញ្ជាក់ ថា លើកលែងតែ តំបន់ មួយចំនួន តូច ទេ អាច និង ប្រឈម បើសិនជា ប្រជាពលរដ្ឋ គាត់ អត់ បាន គិត ឲ្យបាន វែងឆ្ងាយ ដូចជា នាំគ្នា បូម ស្រះ ត្រពាំង បាច យក ត្រី ជាដើម ។
ទន្ទឹម និង បញ្ហា ដែល លោក លើកឡើង ខាងលើ នេះ លោក ញឺន កួន ក៏ បាន ធ្វើ ការសំណូមពរ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ ចេះ ថែរក្សា ប្រភព ទឹក ដែល មាន ស្រាប់ ឲ្យបាន ល្អ និង កុំ ប្រើប្រាស់ ទឹក ដោយ ខ្ជះខ្ជាយ ឲ្យ សោះ ៕ អង្គការ បរិស្ថាន អាល្លឺម៉ង់៖ « សមយុទ្ធ យោធា នៃ អង្គការ NATO ធ្វើឲ្យ សត្វ សមុទ្រ ងាប់ ជាច្រើន ក្បាល និង បរិស្ថាន រង ផល ប៉ះពាល់ »
ជំហរ របស់ លោក កឹម សុខា ហាក់ ផ្ទុយ ទាំងស្រុង នឹង សកម្មភាព និង ផែនការ របស់ លោក សម រង្ស៉ី ដែល តែ បង្ក ភាពវឹកវរ នៅក្នុង សង្គម ខ្មែរ ដូចជា ការប្រកាស ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល កាលពី ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ជាដើម ។ កន្លងទៅ ទោះបីជា ការបង្ហាញ ជំហរ របស់ លោក កឹម សុខា ផ្ទុយ ពី ខ្លួន យ៉ាងណា ក្តី ប៉ុន្តែ លោក សម រង្ស៉ី និង បក្ខពួក នៅតែ និយាយ និង ខិតខំ ផ្សព្វផ្សាយ ថា លោក និង លោក កឹម សុខា ជា មនុស្ស តែ មួយ ។
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ខ្មែរ និង ជប៉ុន ប្រមាណ ជាង ១៣០០ នាក់ ដែល មកពី ស្ថាប័ន រដ្ឋ និង ឯកជន បាន ចូលរួម កម្មវិធី « ភ្នំពេញ ទីក្រុង ស្អាត រៀបចំឡើង ដោយ ជនជាតិ ជប៉ុន លើក ទី២ » សហការរៀបចំ ដោយ ក្រសួង បរិស្ថាន រដ្ឋបាល សាលា រាជធានី ភ្នំពេញ និង ស្ថានទូត ជប៉ុន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា ប្រារព្ធ ធ្វើឡើង សួនច្បារ មាត់ ទន្លេ នៅ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
កម្មវិធី ភ្នំពេញ ទីក្រុង ស្អាត នេះ មាន ការចូលរួម អធិបតី ពី លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន លោក មិកា មិ ម៉ាសាហ៊ីរ៉ូ ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា និង លោក ហួត ហៃ អភិបាល រង រាជធានី ភ្នំពេញ ។
ជាមួយគ្នា នេះ លោក រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ គិតគូរ ពី ការទប់ស្កាត់ ការ បំពុល ដោយ ប្លាស្ទិក ដោយ ជៀសវាង ឬ បញ្ឈប់ ការ ប្រើប្រាស់ ផលិតផល ប្លាស្ទិក ដែល ប្រើ តែ ម្តង បោះចោល ដូចជា បំពង់ បឺត ទឹក ជ័រ ចាន ស្លាបព្រា ជ័យ ស្នោរ និង កែវ ជ័យ ជាដើម ដោយ ងាក មក ប្រើប្រាស់ ផលិតផល ដែល មាន មេត្រីភាព បរិស្ថាន ។
នៅ ចំពោះមុខ អ្នក ចូលរួម ទាំងអស់ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន ថ្លែង ថា កម្មវិធី ភ្នំពេញ ទីក្រុង ស្អាត ដែល ប្រារព្ធ ធ្វើ នៅ ថ្ងៃ នេះ នឹង ក្លាយជា និមិត្តរូប សាមគ្គីភាព ជា អមតៈ រវាង កម្ពុជា និង ជប៉ុន ទាំង ផ្នែក ទំនាក់ទំនង ការទូត និង ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ហើយ រួមគ្នា គិតគូរ និង ស្រឡាញ់ បរិស្ថាន ។
ក្រៅពី សម្អាត អនាម័យ បរិស្ថាន កម្មវិធី ភ្នំពេញ ទីក្រុង ស្អាត រៀបចំ ដោយ ជនជាតិ ជប៉ុន លើក ទី២ ក៏ មាន ការយតាំងពិព័រណ៌ ពីសំណាក់ ក្រុមហ៊ុន ដែល វិនិយោគិន ជប៉ុន នានា ដែល សុទ្ធសឹង ជា ផលិតផល ដែល ជួយ លើកស្ទួយ បរិស្ថាន ដើម្បី បង្ហាញ ដល់ អ្នកចូលរួម ដូចជា ថង់ បរិស្ថាន ដប ទឹក បរិស្ថាន ផលិតផល ដែល ផលិត ពី វត្ថុធាតុ ដើម ធម្មជាតិ និង ក៏ មាន ការផ្តល់ ព័ត៌មាន និង បញ្ជ្រាប ចំណេះដឹង ដល់ អ្នកចូលរួម ផងដែរ ៕
សំណើ របស់ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន ធ្វើឡើង នៅក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ អភិបាល ក្រុង ប៊ូសាន នា ព្រឹក ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។ បើ តាម លោកស្រី អ៊ាត សោភា បាន គូសបញ្ជាក់ ថា នៅក្នុង ទីក្រុង ប៊ូសាន បច្ចុប្បន្ន មាន ពលរដ្ឋ កម្ពុជា ប្រមាណ ៩ ពាន់ នាក់ កំពុង ស្នាក់ នៅ និង ធ្វើការ ។
ក្រៅពី ការស្នើ ឱ្យ អភិបាល ក្រុង ប៊ូសាន គាំពារ លើ សុខ មាលភាព របស់ ប្រជាពលរដ្ឋ កម្ពុជា ហើយ នោះ នៅក្នុង ជំនួប នេះ ការងារ ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ទីក្រុង ប៊ូសាន ជាមួយ ប្រទេស កម្ពុជា និង រវាង ទីក្រុង ប៊ូសាន និង រាជធានី ភ្នំពេញ ដែល មាន សម្ព័ន្ធ មេត្រីភាព ជាមួយគ្នា រួច មកហើយ នោះ ក៏ ត្រូវបាន លើក មក ជជែក ផងដែរ ។
សំណើ ទាំង៣ នេះ ត្រូវបាន អភិបាល ក្រុង ស្វាគមន៍ និង ទទួលយក ។ លោក អភិបាល ក្រុង ប៊ូសាន ក៏ បាន បង្ហាញ ពី បំណង ចង់ បង្កើត កិច្ចសហប្រតិបត្តិការ ចំនួន ពីរ ជាមួយ កម្ពុជា ផងដែរ គឺ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ កំពង់ផែ ( ទីក្រុង ប៊ូសាន ជា ទីក្រុង មាន កំពង់ផែ ដ៏ ធំ មួយ នៅលើ ពិភពលោក ) និង ការអភិវឌ្ឍ វិស័យ ភាពយន្ត ។
ក្រៅពី ការពិភាក្សា លើ ការងារ ទ្វេ ភាគី រវាង ក្រុង ប៊ូសាន និង កម្ពុជា ទៅ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន និង អភិបាល ក្រុង ប៊ូសាន បាន ពិភាក្សារ លើ ការងារ រៀបចំ កិច្ចប្រជុំ កំពូល អនុស្សាវរីយ៍ លើក ទី៣០ នៃ ទំនាក់ទំនង អាស៊ាន - សាធារណរដ្ឋ កូរ៉េ ផងដែរ ។
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន ថ្លែង ស្វាគមន៍ និង គាំទ្រ ចំពោះ គម្រោង បង្កើត អង្គការ ភាពយន្ត អាស៊ាន - សាធារណរដ្ឋ កូរ៉េ នេះ ។ លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន គូសបញ្ជាក់ ដែរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ កិច្ចសន្ទនា និង ទំនាក់ទំនង រវាង អាស៊ាន និង សាធារណរដ្ឋ កូរ៉េ ។ បន្ថែម ពីលើ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ ជា អ្នកជំរុញឱ្យ មាន កិច្ចពិភាក្សា កំពូល រវាង មេគង្គ និង សាធារណរដ្ឋ កូរ៉េ ជា លើក ដំបូង ដែល នឹង ធ្វើឡើង នា ពេលនេះ ផងដែរ ៕
ងាក ទៅ មើល កាលពី ខែតុលា គឺ នៅ ពេល ដែល កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម តំណាក់កាល ទី ១ ត្រូវបាន មន្ត្រី តំណាង នៃ សហរដ្ឋ អាមេរិក និង ប្រទេស ចិន ឯកភាព គ្នា យក ជា ផ្លូវការ និង រង់ចាំ តែ ប្រធានាធិបតី ប្រទេស ទាំង ពីរ ចុះហត្ថលេខា រួមគ្នា នោះ លោក ដូណាល់ ត្រាំ ភ្លាម ៗ ក៏ បាន លើកឡើង អំពី ក្តី រំពឹង របស់ លោក ក្នុង ការឈាន ទៅ បង្កើត កិច្ចព្រមព្រៀង តំណាក់កាល ទី ២ បើសិនជា កិច្ចព្រមព្រៀង តំណាក់កាល ទី ១ ទទួលបាន ជោគជ័យ ជា ស្ថាពរ ។
កាល ណោះ លោក ដូណាល់ ត្រាំ បាន បង្ហើប ថា កិច្ចព្រមព្រៀង តំណាក់កាល ទី ២ អាចនឹង មាន នូវ ការលើកឡើង អំពី ក្តី ព្រួយបារម្ភ របស់ សហរដ្ឋ អាមេរិក ចំពោះ ការផ្ទេរ បច្ចេកវិទ្យា របស់ ខ្លួន ទៅឲ្យ ក្រុមហ៊ុន ចិន នានា ដែល ជា គូ ប្រជែង ។ ទោះបីជា បែប នេះ ក្តី ប្រទេស ចិន នៅតែ បង្ហាញ ក្តី ស្ទាក់ស្ទើរ នៅឡើយ នៅក្នុង ការចុះហត្ថលេខា នៅក្នុង កិច្ចព្រមព្រៀង តំណាក់កាល ទី ១ ហើយ ការចុះហត្ថលេខា នេះ ទៀតសោធ ក៏ ត្រូវបាន លើក ពេល រហូតដល់ ដើម ឆ្នាំ ២០២០ ថែម ទៀត ។
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៣គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន៣ គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ ៣ គ្រឿង ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន បញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ៕ សូម កុំ ប្រើប្រាស់ ទូរស័ព្ទ ពេល កំពុង បើកបរ ! ស្លាប់ ៥នាក់ និង របួស ១៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៤ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ស្រាល ៦នាក់ និង របួស ធ្ងន់ ៩នាក់ ។
ពលករ ខ្មែរ ដែល ត្រៀមខ្លួន ចាំ សម្ដេច តេជោ ហ៊ុន សែន រួច ជាស្រេច នោះ បាន អះអាង ថា បើ ទោះបី ដំណើរ លើក នេះ សម្ដេច មាន ការអាក់ខាន ក៏ ពិត មែន ប៉ុន្ដែ ទំហំ ចិត្ត និង ក្ដី ស្រលាញ់ របស់ គាត់ នៅតែ បន្ដ ទន្ទឹងរង់ចាំ វត្តមាន របស់ សម្ដេច គ្រប់ ពេលវេលា ហើយ ពួកគេ សង្ឃឹម ថា នៅ ថ្ងៃ ណាមួយ នឹង បាន ជួប ជាមួយ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ។
លើស ពី នេះ ពលករ ខ្មែរ ទាំងអស់ បាន បួងសួង ដល់ វត្ថុ ស័ក្ត សិទ្ធ ក្នុង លោក ជួយ បីបាច់ ថែរក្សា មហា ឧបាសិកា ប៊ុន ស៊ាង លី ដែល ជា ម្ដាយ បង្កើត របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នឹង ត្រូវ ជា ម្ដាយ ក្មេក របស់ សម្តេច តេជោ ហ៊ុន សែន សូមឲ្យ បាន ឆាប់ ជាសះស្បើយ ដើម្បី ជា ម្លប់ ដល់ កូន ចៅ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន សម្រេច ប្រកាស លុបចោល ដំណើរ ទៅ ប្រជុំ អាស៊ាន - កូរ៉េ និង មេគង្គ - កូរ៉េ នៅ ទីក្រុង ប៊ូសាន នៃ សាធារណរដ្ឋ កូរ៉េ ដោយសារ ជំងឺ ម្តាយ ក្មេក របស់ សម្តេច ស្ថិត នៅក្នុង ស្ថានភាព សង្រ្គោះ បន្ទាន់ ។ សម្ដេចក៏ សូម ការយោគយល់ ពីសំណាក់ បងប្អូន ខ្មែរ ដែល ជា និស្សិត ជា ពលករ ជា អាជីវករ និង បងប្អូន ដែល មាន គ្រួសារ ជា ជនជាតិ កូរ៉េ ដែល ត្រៀមខ្លួន មក ទទួល និង សំណេះសំណាល ជាមួយ សម្ដេច ៕
រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បើក កិច្ចប្រជុំ ពង្រឹង ការងារ គ្រប់គ្រង និង អភិរក្ស តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង សំឡូត និង ដែន ជម្រក សត្វ ព្រៃ ភ្នំ សំកុស ក្នុង ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ លោក សាយ សំអាល់ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន នៅ ព្រឹក ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ស្តីពី « ការពង្រឹង ការងារ គ្រប់គ្រង តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង សំឡូត និង ដែន ជម្រក សត្វ ព្រៃ ភ្នំ សំកុស » នា សាលា ស្រុក សំឡូត ខេត្ត បាត់ដំបង ។
កិច្ចប្រជុំ នេះ មាន ការចូលរួម ពីសំណាក់ លោក អ៊ុយ សុធាវី អភិបាល រង ខេត្ត បាត់ដំបង . លោក ធូ ភា អភិបាល រង ខេត្ត ប៉ែលិន . លោក សើ សាម៉េត អភិបាល ស្រុក សំឡូត និង ដោយ មាន ការចូលរួម ពីសំណាក់ មន្រ្តី នៃ ក្រសួង បរិស្ថាន និង អាជ្ញាធរ មូលដ្ឋាន ជាច្រើន រូប ផងដែរ ។
លោក សាយ សំអាល់ បាន ថ្លែង ថា កិច្ចប្រជុំ នេះ មាន គោលដៅ ផ្តោត សំខាន់ ទៅ លើ ការទប់ស្កាត់ និង បង្ក្រាប ការទន្រ្ទាន និង កាន់កាប់ ដីធ្លី ដោយ ខុស ច្បាប់ នៅក្នុង តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង សំឡូត និង ដែន ជម្រក សត្វ ព្រៃ ភ្នំ សំកុស » ក្នុង ភូមិសាស្ត្រ ស្រុក សំឡូត ខេត្ត បាត់ដំបង ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្រ្តី នឹង ពិនិត្យ និង ចូលរួម ដោះស្រាយ បញ្ហា ប្រឈម មួយ ចំនួន ដែល បាន និង កំពុង កើតមាន ទាក់ទង នឹង ការគ្រប់គ្រង និង អភិរក្ស ធនធាន ធម្មជាតិ និង ព្រមទាំង ចូលរួម ក្នុង ការអភិវឌ្ឍ សហគមន៍ ការពារ ធម្មជាតិ ដើម្បី លើកកម្ពស់ ជីវភាព ប្រជា សហគមន៍ តាមរយៈ ការគិតគូរ ពី ការធ្វើ ហេដ្ឋារចនាសម្ព័ន្ធ នានា ដែល ក្នុង នោះ រួមទាំង គម្រោង ទឹក ស្អាត ផ្តល់ នូវ ចំណេះដឹង លើ ការចិញ្ចឹម សត្វ ដើម្បី ប្រជា សហគមន៍ អាច ដោះស្រាយ ជីវភាព រស់ នៅ បាន ធូរធា ផងដែរ ។
គួរ បញ្ជាក់ ថា តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង សំឡូត មាន ភូមិសាស្ត្រ ស្ថិត ក្នុង ខេត្ត បាត់ដំបង មួយ ផ្នែក និង ខេត្ត ប៉ៃលិន មួយ ផ្នែក ដែល មាន ផ្ទៃដី សរុប ចំនួន ៦០.០០០ ហិកតា ហើយ ដែន ជម្រក សត្វ ព្រៃ ភ្នំ សំកុស មាន ទីតាំង ស្ថិត ក្នុង ខេត្ត បាត់ដំបង ពោធិ៍សាត់ និង កោះ កុង មាន ផ្ទៃដី ទំហំ ៣៣៥ . ៧៥០ ហិកតា ៕ អ្នក សិល្បៈ លាក់ មុខ ជួបជុំ ប្រមូលផ្តុំ គ្នា បង្កើត « សមាគម មិត្ត អ្នកបញ្ចូល សំឡេង »
( ភ្នំពេញ ) ៖ បន្ទាប់ពី សង្គមជាតិ ទទួលបាន សុខ សន្តិភាព ពេញលេញ ក្រោម គោល នយោបាយ ឈ្នះ ឈ្នះ ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា មក ប្រទេស កម្ពុជា ទាំងមូល បាន និង កំពុង ក្លាយជា គោលដៅ ប្រកបដោយ ភាពទាក់ទាញ បំផុត សម្រាប់ អ្នក វិនិយោគ ចូលមក បណ្តាក់ទុន ប្រកប មុខរបរ រក ទទួលទាន នៅ កម្ពុជា ។ ក្នុង នោះ វិស័យ សិល្បៈ ភាព យន្ត ទាំង ភាពយន្ត ក្នុង ស្រុក និង ភាពយន្ត ដែល នាំចូល ពី បរទេស ក៏ បាន និង កំពុង ចាត់ទុក កម្ពុជា ជា ទីផ្សារ ក្នុង ការប្រកួតប្រជែង ប្រកបដោយ សក្តានុពលភាព ផងដែរ ។
ភាពយន្ត ជា សិល្បៈ ចម្បង ទី៧ ដោយ ការបូក បញ្ចូល គ្នា រវាង សិល្បៈ ចម្បង ទាំង៦ គឺ៖ ចម្រៀង . របាំ . គំនូរ . ចម្លាក់ . ស្ថាបត្យកម្ម និង អក្សរ សិល្បិ៍ ដែល ត្រូវបាន នាំចូល យកមក ដាក់ បញ្ចាំង នៅ ប្រទេស កម្ពុជា ជា លើក ដំបូង នៅក្នុង អំឡុង ឆ្នាំ ១៩០៩ ។ ប៉ុន្តែ ភាពយន្ត ក្នុង សម័យកាល នោះ គេ ដាក់បញ្ចាំង បាន ត្រឹមតែ « រូបភាព និង កាយវិការ » ប៉ុណ្ណោះ ព្រោះ ពុំ ទាន់ មាន សំឡេង នៅឡើយ ។
លុះ ចំណេរតមក នៅក្នុង អំឡុង ឆ្នាំ ១៩២៧ ទើប អ្នកស្រាវជ្រាវ រកឃើញ ការប្រើ សំឡេង អម ជាមួយ រូបភាព និង កាយវិការ ដែល ញ៉ាំង ឲ្យ សិល្បៈ ប្រភេទ នេះ ទទួលបាន ប្រសិទ្ធិភាព ខ្ពស់ ដល់ ការឆ្លុះបញ្ចាំង នូវ ទស្សនៈ ព្រមទាំង គំនិត របស់ អ្នកនិពន្ធ ដែល ចង់ បង្ហាញ និង ត្រូវ គេ ដាក់ ឈ្មោះ ថា ភាពយន្ត « រូបភាព កាយវិការ និង សំឡេង » ។
ភាពយន្ត គឺជា សិល្បៈ « រូបភាព កាយវិការ និង សំឡេង » ទើប អ្នកផលិតភាពយន្ត ពិសេស ភាពយន្ត បរទេស ដែល នាំចូល យក ចាក់បញ្ចាំង នៅ កម្ពុជា ត្រូវការ អ្នក សិល្បៈ ២ប្រភេទ ដាច់ដោយឡែក ពី គ្នា ចូលរួម គឺ៖ ប្រភេទ អ្នក សិល្បៈ ផ្នែក សម្តែង និង ប្រភេទ អ្នក សិល្បៈ ផ្នែក បញ្ចូល សំឡេង ។
ក្នុង ចំណោម អ្នក សិល្បៈ ទាំង ពីរ ប្រភេទ នេះ ជាទូទៅ អ្នកទស្សនា ភាពយន្ត ភាគ ច្រើន បាន ឃើញ បាន ស្គាល់ ត្រឹមតែ អ្នក សិល្បៈ ផ្នែក សម្តែង តែ ប៉ុណ្ណោះ រីឯ អ្នក សិល្បៈ ផ្នែក បញ្ចូល សំឡេង គឺ ពុំ សូវ មាន អ្នក បាន ជួប បាន ស្គាល់ និង បាន ដឹង ពី សុខ ទុក្ខ របស់ ពួកគាត់ ឡើយ ។ ហេតុ នេះ ហើយ ទើប គេ តែងតែ ប្រសិទ្ធិ នាម ឲ្យ ពួកគាត់ ថា « អ្នក សិល្បៈ លាក់ មុខ » ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៨ករណី និង ជួញដូរ ១៣ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៣៣ នាក់ ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង អំពាវនាវ ឲ្យ អ្នក ធ្វើដំណើរ តាម ដងផ្លូវ អនុវត្ត អនុសាសន៍ សម្តេច តេជោ « ថ្ងៃ នេះ ថ្ងៃស្អែក កុំ ឲ្យ មាន គ្រោះថ្នាក់ ចរាចរណ៍ »
( ស្វាយរៀង ) ៖ លោកស្រី ឯក សុវណ្ណ ភារៈ អភិបាល រង ខេត្ត ស្វាយរៀង បាន ថ្លែង ថា ដើម្បី ទប់ស្កាត់ កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក អនុគណៈកម្មការ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ខេត្ត សូម ធ្វើ ការអំពាវនាវ ដល់ អ្នកប្រើប្រាស់ ផ្លូវ និង អ្នកដំណើរ តាម ផ្លូវថ្នល់ ចូលរួម អនុវត្ត ឲ្យបាន នូវ អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា « ថ្ងៃ នេះ ថ្ងៃស្អែក កុំ ឲ្យ មាន គ្រោះថ្នាក់ ចរាចរណ៍ » ។
ការថ្លែង បែប នេះ ខណៈ ដែល លោកស្រី តំណាង លោក ម៉ែន វិបុល អភិបាល ខេត្ត ជា ប្រធាន អនុគណៈកម្មការ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ខេត្ត បាន អញ្ជើញ ជា អធិបតី ក្នុង ទិវា អន្តរជាតិ រំលឹក ដល់ អ្នក រងគ្រោះ ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក លើក ទី ១៤ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ សាលា ស្រុក ស្វាយ ជ្រំ ។
លោកស្រី ឯក សុវណ្ណ ភារៈ បាន ថ្លែង ការចាប់អារម្មណ៍ និង យកចិត្តទុកដាក់ ជា សំខាន់ ទៅ លើ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល កើតឡើង ក្នុង ទឹកដី ខេត្ត ស្វាយរៀង ដើម្បី បង្កើន ស្មារតី ទប់ស្កាត់ ឲ្យបាន នូវ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល បង្កឲ្យ មាន ការបាត់បង់ អាយុជីវិត មនុស្ស ទ្រព្យសម្បត្តិ រដ្ឋ និង ឯកជន យ៉ាង ច្រើន ។
លោក នួន លី ហួន ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត បាន ធ្វើ របាយការណ៍ បញ្ជាក់ អំពី គ្រោះថ្នាក់ ចរាចរណ៍ រយៈពេល ៩ខែ ឆ្នាំ ២០១៩ ប្រៀបធៀប នឹង រយៈពេល ៩ខែ ឆ្នាំ ២០១៨ គឺ ថយចុះ ០៦ លើក ស្មើ ៥% ៕ ពលរដ្ឋ ៩៥ គ្រួសារ ដែល មិន ទាន់ ទទួល ដី យល់ព្រម ទទួល ដី ក្នុង ដំណោះស្រាយ របស់ អាជ្ញាធរ ខេត្ត កោះកុង ហើយ
ការចុះ រក ដំណោះស្រាយ ក្រោម ការដឹកនាំ ដោយ លោក សុខ សុទ្ធី អភិបាល រង ខេត្ត កោះកុង និង លោក ជា ច័ន្ទ កញ្ញា អភិបាល ស្រុក ស្រែ អំបិល និង មន្ត្រី ជំនាញ គ្រប់ ស្ថាប័ន ដែល ពាក់ព័ន្ធ អាជ្ញាធរ ភូមិ ឃុំ ព្រមទាំង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ នេះ ផងដែរ ។
លោក សុខ សុទ្ធី បាន ថ្លែង ថា ការដោះស្រាយ បញ្ហា នេះ អាជ្ញាធរ បាន ធ្វើ កិច្ចព្រមព្រៀង ជាមួយ ពួកគាត់ ថា ដី នៅ ចំណុច C នោះ មិន ទាន់ មាន ផ្លូវ សម្រាប់ ធ្វើដំណើរ ចេញ ចូល ទេ ព្រោះង់ចាំ ថវិកា ថ្នាក់ ជាតិ ធ្លាក់ចុះ មក ទើប អាច ធ្វើ ផ្លូវ បាន និង ធ្វើ ការវាស់វែង បាន ។ ប៉ុន្តែ ដី នៅ ចំណុច C នេះ អាជ្ញាធរ នឹង ថែរក្សាទុក សម្រាប់ ទាំង ៩៥ គ្រួសារ ដែល មិន ទាន់ បាន ទទួល ដីធ្លី ជា ដី ទំនាស់ នោះ ។
លោក បាន បញ្ជាក់ ថា ដោយ មាន ការសម្របសម្រួល ពី អាជ្ញាធរ ខេត្ត និង អាជ្ញាធរ មូលដ្ឋាន ទើប ប្រជាពលរដ្ឋ ទាំង ៩៥ គ្រួសារ យល់ព្រម ទទួល រងចាំ ការវាស់វែង ដី នៅ ចំណិច Cជូន ពួកគាត់ នៅពេល មាន ផ្លូវ ធ្វើដំណើរ ៕ ដើម្បី ទទួលបាន សុវត្ថិភាព ចំណីអាហារ អ្នកប្រើប្រាស់ គួរតែ ស្វែងយល់ ពី អាហារ ដែល គួរ ប្រើប្រាស់ និង មិន គួរ ប្រើប្រាស់ ជាមុន សិន
លោក ក៏ បាន ស្នើសុំ ឱ្យ អ្នកផលិត ម្ហូប អាហារ បន្លែ ត្រូវ មាន គុណធម៌ សច្ចធម៌ មាន បច្ចេកទេស ខ្ពស់ ដើម្បី ជួយ បំរើ ដល់ សុខភាព របស់ អ្នកប្រើប្រាស់ កុំ ដើម្បី តែ ប្រយោជន៍ ផ្ទាល់ខ្លួន ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភាព របស់ អ្នកដទៃ តាម រយៈ ការលក់ របស់ ដែល មិន មាន គុណភាព ទៅ ឱ្យ អតិថិជន ។ ចំពោះ អ្នកប្រើប្រាស់ ក៏ គួរគប្បី ស្វែងយល់ ឱ្យ បាន ច្រើន នូវ រាល់ ផលិតផល ណា ដែល គួរ ប្រើប្រាស់ និង មិន គួរ ប្រើប្រាស់ ដូចគ្នា ផងដែរ ។
នា អំឡុង ពេល ស្នាក់ នៅ ប្រទេស កម្ពុជា សិស្ស របស់ អាមេរិក ទាំងនេះ បាន ឈ្វេងយល់ ពី វប្បធម៌ ជាច្រើន របស់ កម្ពុជា ជាពិសេស នោះ ពួកគេ បាន ហាត់ រាំ ក្បាច់ រាំ បុរាណ មាន ចង្វាក់ សារ៉ា វ៉ាន់ របស់ កម្ពុជា យើង ផងដែរ ។
ក្នុង កិច្ចសម្ភាស ជាមួយ ភ្នាក់ងារ របស់ អង្គភាព ព័ត៌មាន Fresh News គ្រីស្ទាន លី បាន បញ្ជាក់ ថា ខ្លួន បាន ធ្វើដំណើរ ទៅ កន្លែង កម្សាន្ត នានា ផ្សារ ទំនើប ថែមទាំង តំបន់ ទេសចរណ៍ នៅក្នុង ប្រទេស កម្ពុជា ។ ពេល ដែល ទៅដល់ ខេត្ត សៀមរាប ដែល ជា គោលដៅ ទេសចរណ៍ ដ៏ សំខាន់ មួយ របស់ កម្ពុជា ក្មេងស្រី ម្នាក់ នេះ បាន បង្ហាញ អារម្មណ៍ រំភើប ដោយ បញ្ជាក់ យ៉ាង ខ្លី ថា ប្រាសាទ អង្គរវត្ត គឺជា ប្រាសាទ ដ៏ អស្ចារ្យ មួយ របស់ កម្ពុជា ។
ប្រាសាទ អង្គរវត្ត ជា ប្រាសាទ ព្រហ្មញ្ញ សាសនា ធំ បំផុត និង ជា វិមាន សាសនា ដ៏ ធំ បំផុត នៅក្នុង លោក ។ ប្រាសាទ នេះ ត្រូវបាន កសាងឡើង ដោយ ព្រះបាទ សូរ្យ វរ្ម័ន ទី២ ដែល ជា ស្នាដៃ ដ៏ ធំ ចម្បង អស្ចារ្យ និង មាន ឈ្មោះ ល្បីល្បាញ រន្ទឺ សុះ សាយ ទៅ គ្រប់ ទិសទី លើ ពិភពលោក ។ ប្រាសាទ នេះ សាងសង់ ឡើង នៅ ដើម សតវត្ស ទី ១២ ដែល ស្ថិត នៅក្នុង រាជធានីយ សោធរ បុរៈ ( សម័យ បច្ចុប្បន្ន អង្គរ ) អធិរាជាណាចក្រ ខ្មែរ ជា ប្រាសាទ តំណាង ឱ្យ ភ្នំ សុមេរុ ។
ប្រាសាទ អង្គរវត្ត ជា ប្រាសាទ កសាងឡើង ដើម្បី ឧទ្ទិស ដល់ ព្រះវិស្ណុ ។ ប្រាសាទ នេះ គឺជា ប្រាសាទ តែ មួយ គត់ ដែល បាន បន្សល់ទុក នូវ មជ្ឈមណ្ឌល សាសនា ដ៏ សំខាន់ មួយ ចាប់តាំងពី មូលដ្ឋានគ្រឹះ របស់ ខ្លួន ដែល ដំបូង ព្រហ្មញ្ញ សាសនា បូជា ដល់ ព្រះវិស្ណុ ក្រោយមក ពុទ្ធសាសនា ។ ប្រាសាទ នេះ ស្ថិត នៅក្នុង រចនាបថ បុរាណ ជាន់ ខ្ពស់ កំពូល នៃ ស្ថាបត្យកម្ម ខ្មែរ ។
ប្រាសាទ អង្គរវត្ត បាន ក្លាយជា និមិត្តរូប នៃ ប្រទេស កម្ពុជា ដែល រំលេច លើ ទង់ជាតិ របស់ ប្រទេស កម្ពុជា ជា រូបភាព តំណាង ប្រទេសជាតិ ខ្មែរ និង ជា ប្រាសាទ មួយ សម្រាប់ ការទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ ជាតិ និង អន្តរជាតិ ផងដែរ ។
សិស្ស ទាំង១០ រូប មកពី សហរដ្ឋ អាមេរិក បាន ឈ្វេងយល់ ពី វប្បធម៌ អរិយធម៌ ទំនៀមទម្លាប់ នៃ ប្រជាជន កម្ពុជា ជាពិសេស បាន យល់ដឹង ស៉ី ជម្រៅ ពី ការរស់នៅ ប្រចាំ ថ្ងៃ តាមរយៈ ការស្នាក់ នៅ ជាមួយ ក្រុមគ្រួសារ ដែល កំពុង រស់ នៅ កម្ពុជា ផ្ទាល់ ។ បន្ថែម ពី ចំណេះដឹង ទាំងនេះ ពួកគេ ទទួលបាន បទពិសោធន៍ ក្នុង ការសិក្សា ថ្មី ៗ សម្រាប់ ចែក រម្លែក ដល់ សិស្សានុសិស្ស ដទៃ ទៀត ដែល ពុំ ទាន់ បាន ចូលរួម ផងដែរ ។
លោក គង់ សំនៀង ប្រធាន នាយក ប្រតិបត្តិការ របស់ វេសឡាញ អេឌ្យូ ខេ សិន គ្រុប បាន ថ្លែងអំណរគុណ ដល់ ភាគី អាមេរិក ដែល បាន សហការ ក្នុង ការរៀបចំ កម្មវិធី ដ៏ មាន សារៈសំខាន់ នេះ ឡើង ។ លោក ថ្លែង ថា នេះ មិន មែន ជា លើក ទី មួយ ទេ ដែល វេសឡាញ រៀបចំ ការផ្លាស់ប្តូរ ការសិក្សា បែប នេះ ពោល សាលា តែងតែ មាន ការរៀបចំ ឲ្យ សិស្ស ទៅ ផ្លាស់ប្តូរ ការសិក្សា នៅ ប្រទេស នានា ផ្សេង ទៀត ផងដែរ ។
សូម ជំរាប ថា នៅ ព្រឹក ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហោះ សារ និង បង្ហាញ រូបភាព ដើម្បី បង្ហាញ ជូន ជន រួម ជាតិ អំពី ស្ថានភាព ជំងឺ ម្តាយ ក្មេក របស់ សម្តេច ដែល កំពុង ស្ថិត ក្នុង ដំណាក់ការសង្រ្គោះ បន្ទាន់ នៅឡើយ តម្រូវ ឱ្យ កូន ចៅ នៅក្បែរ ជានិច្ច ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ គឺជា ខួប ទី ១៤ ឆ្នាំ ដែល ល្ខោន ស្រមោល ស្បែក ធំ របស់ កម្ពុជា ត្រូវបាន ចុះ ក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្សជាតិ កាលពី ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០០៥ របស់ អង្គការ យូណេស្កូ ។
សិល្បៈ ល្ខោន ស្បែក ធំ មាន ប្រវត្តិ និង អាយុកាល ជា យូរ លង់ ណាស់ មកហើយ លើ ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវបាន សកលលោក ទទួលស្គាល់ និង ឲ្យ តម្លៃ ថា ជា សម្បត្តិ មនុស្សជាតិ ដ៏ អស្ចារ្យ និង បាន ដាក់បញ្ចូល ជា បេតិកភណ្ឌ ពិភពលោក ខាង បេតិកភណ្ឌ បញ្ចេញ សំឡេង និង អរូបីយ៍ របស់ មនុស្សជាតិ ក្នុង ឆ្នាំ ២០០៥ របស់ អង្គការ យូណេស្កូ ទៀតផង ដែល នេះ ជា មោទនភាព ជាតិ មួយ ដ៏ ត្រចះត្រចង់ មិន អាច កាត់ថ្លៃ បាន ។
ល្ខោន ស្បែក ធំ គឺជា សិល្បៈ មួយ មាន ប្រវត្តិ នៅពេល ព្រហ្ម សាសនា ចូលមក ទឹកដី ខ្មែរ ។ កាលពី ដើម ឡើយ សិល្បៈ ប្រភេទ នេះ ត្រូវបាន គេ ឃើញ សម្តែង ក្នុង ពិធី តែ ពីរ ឬ បី ប៉ុណ្ណោះ ក្នុង មួយ ឆ្នាំ ហើយ កម្រ សម្តែង ជា សាធារណៈ ណាស់ ។ ពិធី ទាំងនោះ មាន ដូចជា ពិធី បុណ្យ ចូល ឆ្នាំ ខ្មែរ ពិធី បុណ្យ ចម្រើន ព្រះជន្ម ព្រះមហាក្សត្រ និង ពិធី គ្រងរាជ្យ ឬ ក្នុង ពិធី សក្ការៈ របស់ ឥស្សរជន ល្បី ៗ ។
( ឃ្យុង យូ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី បាន លើកឡើង ពី តម្លៃ នៃ វប្បធម៌ តាមរយៈ ការលើកកម្ពស់ វប្បធម៌ ចម្រុះ ដែល ជា មូលដ្ឋានគ្រឹះ នៃ សន្តិភាព ការអភិវឌ្ឍ ការផ្សារ ភ្ជាប់គ្នា និង ន វានុវត្តន៍ ដើម្បី លើកកម្ពស់ សន្តិភាព និង ការអភិវឌ្ឍ ដោយ ចីរភាព ។
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោកស្រី អញ្ជើញ ចូលរួម ជា សហអធិបតី និង បាន ថ្លែង សុន្ទរកថា បិទ ក្នុង ពិធី « ពិព័រណ៍ វប្បធម៌ ពិភពលោក ឃ្យុង យូ - ២០១៩ » នៅ ទីក្រុង ឃ្យុង យូ នៅ សាធារណរដ្ឋ កូរ៉េ នា ល្ងាច ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
លោកស្រី បាន គូសបញ្ជាក់ ថា ព្រឹត្តការណ៍ នេះ បាន ប្រព្រឹត្តទៅ អស់ រយៈពេល ៤៥ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១១ ខែតុលា មក ទល់ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ប្រកបដោយ ភាពជោគជ័យ និង វិជ្ជាជីវៈ ខ្ពស់ ។
លោកស្រី បាន បញ្ជាក់ បន្ថែម ថា ពិព័រណ៌ វប្បធម៌ ពិភពលោក ឃ្យុង យូ ធ្វើឡើង ក្នុង គោលបំណង រួមចំណែក ដល់ ការជម្រុញ វប្បធម៌ ចម្រុះ ដោយ ផ្តោត លើ តួនាទី វប្បធម៌ ដែល ជា ប្រភព នៃ សន្តិភាព សុខដុមនីយកម្ម ការអភិវឌ្ឍ ការផ្សារ ភ្ជាប់ ការច្នៃប្រឌិត និង ន វានុវត្តន៍ ។
លោកស្រី បាន លើក សរសើរ និង អបអរសាទរ អំពី ទីតាំង នៃ ពិព័រណ៌ វប្បធម៌ នៃ ទីក្រុង ឃ្យុង យូ ដែល ជា ទីកន្លែង ប្រវត្តិសាស្រ្ត ហ៊ុមព័ទ្ធ ដោយ រិក ធាតុ និង បូជនិយ ស្ថាន វប្បធម៌ ប្រវត្តិសាស្រ្ត ក្នុង អតីត ទីក្រុង បុរាណ នៃ ព្រះរាជាណាចក្រ សិលា ដែល បាន កកើត មុន សម័យ អង្គរ បន្តិច គឺ អំឡុង សតវត្សរ៍ ទី១ដល់ ទី១០ ។
ជាពិសេស ជាង នេះ ទៀត ពិធី តាំង ពិព័រណ៌ នេះ ផ្តល់ ឱកាស ឲ្យ មនុស្ស យល់ ពី តម្លៃ នៃ វប្បធម៌ កាន់តែ ខ្លាំង ជាង មុន ។ លោកស្រី បាន បញ្ជាក់ បន្ថែម ទៀត ថា វប្បធម៌ មិន ត្រឹមតែ មាន តួនាទី ជម្រុញ នូវ សុខ សន្តិភាព ស្ថិរភាព ប៉ុណ្ណោះ ទេ ថែមទាំង ជា ចលករ សេដ្ឋកិច្ច ដ៏ សំខាន់ សម្រាប់ ការអភិវឌ្ឍ ដោយ ចីរភាព តាមរយៈ វិស័យ ទេសចរណ៍ និង ឧស្សាហកម្ម មាន ភាពច្នៃប្រឌិត ជា ប្រភព នៃ ន វានុវត្តន៍ និង ភាពច្នៃប្រឌិត និង ជា ប្រភព របស់ មនុស្សជាតិ និង អត្តសញ្ញាណ របស់ មនុស្ស ។
មុននឹង បញ្ចប់ ការថ្លែង សុន្ទរកថា លោកស្រី បាន អំពាវនាវ ឱ្យ រួមគ្នា ក្នុង ការអភិរក្ស បេតិកភ័ណ្ឌ វប្បធម៌ និង ប្រវត្តិសាស្រ្ត ធ្វើ សមាហរណកម្មការ រីកចម្រើន នៃ បច្ចេកវិទ្យា ទៅក្នុង ការអភិរក្ស វប្បធម៌ និង អភិវឌ្ឍ របៀង វប្បធម៌ សម្រាប់ សន្តិភាព និង ការអភិវឌ្ឍ ដោយ ចីរភាព ។
សូម ជម្រាប ថា ពិព័រណ៍ វប្បធម៌ ពិភពលោក ឃ្យុង យូ ២០១៩ រយៈពេល ៤៥ ថ្ងៃ នេះ មាន ការសម្តែង សិល្បៈ និង ការតាំង បង្ហាញ ពិព័រណ៍ ចម្រុះ ដែល មាន ការចូលរួម ពី ២៧ ប្រទេស និង មាន ភ្ញៀវ ទេសចរណ៍ ទស្សនា សរុប ប្រមាណ កន្លះ លាន នាក់ ។
ប្រទេស កម្ពុជា និង កូរ៉េ ធ្លាប់ បាន សហការ គ្នា រៀបចំ ពិព័រណ៍ វប្បធម៌ ពិភពលោក អង្គរ - ឃ្យុង យូ នៅ ខេត្ត សៀមរាប កាលពី ថ្ងៃទី ២១ ខែវិច្ឆិកា ឆ្នាំ ២០០៦ ដល់ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០០៧ ដោយ មាន ការចូលរួម ពី ៣០ ប្រទេស និង ភ្ញៀវ ទេសចរ ជាង មួយ លាន នាក់ ។ នៅក្នុង វិស័យ អភិរក្ស ប្រទេស កូរ៉េ បាន ចូលរួម យ៉ាង សកម្ម ក្នុង កិច្ចប្រឹងប្រែង អភិរក្ស ប្រាសាទ បុរាណ ជាពិសេស ការបញ្ចប់ ដោយ ជោគជ័យ នូវ គម្រោង អភិរក្ស និង ជួសជុល ប្រាសាទ ព្រះពិទូ និង លាន ជល់ ដំរី នៅក្នុង បរិវេណ ប្រាសាទ អង្គរ ធំ ៕
តុលាការ ចេញ ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន បុរស ម្នាក់ ក្រោយ បោកប្រាស់ លុយ គេ ជាង ៤ម៉ឺន ដុល្លារ នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
គួរ ជម្រាប ថា ជន ត្រូវ ចោទ ឈ្មោះ សាំង ឃុន ឯក បុរី ត្រូវបាន កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ ចាប់ខ្លួន កាលពី ថ្ងៃទី ២២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ កន្លងទៅ បាន តាម ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន របស់ លោក កែវ សុធា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
យោង តាម ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន នៅ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ជន ត្រូវ ចោទ សាំង ឃុន ឯក បុរី ត្រូវ ដាក់ ឲ្យ ស្ថិត ក្រោម ការពិនិត្យ ពី បទ ឆ បោក និង រំលោភ លើក ទំនុកចិត្ត ប្រព្រឹត្ត នៅ ចំណុច បុរី មនោរម្យ ភូមិ កន្ទោក សង្កាត់ កន្ទោក ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ កាលពី អំឡុង ខែវិច្ឆិកា ឆ្នាំ ២០១៧ បទល្មើស ព្រហ្មទណ្ឌ ដែល មាន ចែង ឲ្យ ផ្ដន្ទាទោស តាម មាត្រា ៣៧៧ មាត្រា ៣៧៨ និង មាត្រា ៣៩២ នៃ ក្រម ព្រហ្មទណ្ឌ ។
ដើមហេតុ ដែល នាំឲ្យ មាន ការចាប់ខ្លួន ជន ត្រូវ ចោទ ខាងលើ គឺ ធ្វើឡើង តាម ពាក្យបណ្ដឹង របស់ ស្ដ្រី ជនរងគ្រោះ ឈ្មោះ រួន នីតា អាយុ ៣៥ ឆ្នាំ ផ្លូវ លំ ភូមិ កន្ទោក សង្កាត់ កន្ទោក ខណ្ឌ ពោធិ៍សែនជ័យ ។ កាល អំឡុង ខែវិច្ឆិកា ឆ្នាំ ២០១៧ ឈ្មោះ សាំង ឃុន ឯក បុរី និង ឈ្មោះ សឿន គឹម ទាង ( ប្រពន្ធ ) បាន ពឹងពាក់ ខ្លួន ដើម្បីឲ្យ ជួយ រក ប្រាក់ ចំនួន ៤៦. ៨០០ ដុល្លារ ក្នុង គោលបំណង ទិញ ផ្ទះ ដោយ សន្យា ថា នឹង ធ្វើ ការទូទាត់ សង វិញ រយៈពេល ១ ខែ ។
( ឧត្តរមានជ័យ )៖ លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ នៅ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន ដឹកនាំ ប្រធាន មន្ទីរ អង្គភាព និង កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ចុះ ស្តារ ពើក ( ល្បាប់ ផុក ) ចេញ ពី អាង ស្តុក ទឹក កណ្តែ ក ស្ថិត ក្នុង សង្កាត់ សំរោង ក្រុង សំរោង ។
លោក ញឺន កួន ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧត្តុនិយម ខេត្ត បាន ឲ្យដឹង ថា អាង ស្តុក ទឹក កណ្តែក នេះ មាន ទំហ៊ំ ៨០ ហិកតា អាច ស្តុក ទឹក បាន ចំនួន ១.៦លាន ម៉ែត្រ គូប និង មាន លទ្ធភាព ស្រោចស្រព លើ ផ្ទៃដី ស្រូវ វស្សា បាន ចំនួន ៥១៥ ហិកតា ផ្ទៃដី ស្រូវ ប្រាំង បាន ចំនួន ៥៨ ហិកតា និង ដំណាំ ផ្សេង ៗ បាន ៥ហិកតា ផងដែរ ។
លោក ញឺន កួន បាន គូសបញ្ជាក់ ទៀត ថា អាង ស្តុក ទឹក កណ្តែក នេះ ក្រៅពី បម្រើ ឲ្យ ការងារ ស្រោចស្រព ដំណាំ ស្រូវ និង ដំណាំ រួមផ្សំ ផ្សេង ៗ ទៀត នោះ គឺជា ប្រភព ទឹក ដ៏ សំខាន់ សម្រាប់ ផលិត ទឹក ស្អាត ប្រើប្រាស់ ក្នុង ទី រួម ខេត្ត ឧត្តរមានជ័យ ទាំងមូល ទៀត ផងដែរ ៕
មេភូមិ ល្អ នឹង នាំ លាភ សំណាង មែន ! ជប់លៀង ឱ្យ អ្នកភូមិ ហើយ ឈ្នះ រង្វាន់ ៤០ លាន រៀល ពី ស្រាបៀរ កម្ពុជា ចែក ស្មើគ្នា ទៀត
( ភ្នំពេញ ) ៖ មេភូមិ ជប់ ឃុំ តា ត្រាវ ស្រុក អង្គរ ធំ ខេត្ត សៀមរាប លោក យុត ស្រូច បាន រៀបចំ ពិធី ជប់លៀង អបអរ បុណ្យ ឯករាជ្យ ជាតិ ដែល បាន អញ្ជើញ អ្នកភូមិ របស់ គាត់ ទាំងអស់ មក ពិសា អារ ហារ និង ស្រាបៀរ កម្ពុជា រហូត គាស់ ត្រូវ សំណាង ទទួលបាន ទឹកប្រាក់ ៤០ លាន រៀល ។
លោក បាន បញ្ជាក់ ថា លោក នឹង ចែក ប្រាក់ សំណាង នេះ ឱ្យ ដល់ អ្នកភូមិ ក្នុង ចំនួន ស្មើរ គ្ន ដែល សរុប មាន ចំនួន ជិត ៣០០ នាក់ ក្នុង ម្នាក់ នឹង ទទួលបាន ទឹកប្រាក់ សំណាង យ៉ាងហោចណាស់ ៥០ ដុល្លា អាមេរិក ៕
អស់ កង្វល់ បញ្ហា ជី ថ្នាំ កសិកម្ម ជាមួយ ក្រុមហ៊ុម ឯកទេស របស់ ជប៉ុន
មកទល់ ពេលនេះ ក្រុមហ៊ុន បាន បើក ដំណើរការ អាជីវកម្ម របស់ ខ្លួន បាន រយៈពេល ជាង ៥ឆ្នាំ មកហើយ ប៉ុន្តែ ដើម្បី ជំរុញ ឱ្យ អ្នកប្រើប្រាស់ ទទួលបាន នូវ ចំណេះដឹង ច្បាស់លាស់ អំពី ការប្រើប្រាស់ ដែល ត្រឹមត្រូវ តាមរយៈ ក្រុមហ៊ុន នោះ ទើប ក្រុមហ៊ុន ឯកទេស កសិកម្ម មួយ នេះ ពង្រឹង សកម្មភាព ទីផ្សារ និង ការលក់ ដល់ ដៃ អតិថិជន ដែល ជា អ្នកប្រើប្រាស់ ដោយ ផ្ទាល់ ទើប ក្រុមហ៊ុន នេះ យល់ ច្បាស់ អំពី ក្តីកង្វល់ របស់ អតិថិជន និង ផ្តល់ ជូនដំណោះស្រាយ យ៉ាង ប្រាកដប្រជា ជូន អតិថិជន របស់ ខ្លួន
ដូច្នេះ រាល់ ឧបសគ្គ អំពី ការដាំដុះ និង ធាតុ ចូល កសិកម្ម ដែល មាន គុណភាព និង ប្រសិទ្ធភាព ខ្ពស់ នោះ អាច ទំនាក់ទំនង ស្វែង ការប្រឹក្សារ ជាមួយ ក្រុមការងារ បច្ចេកទេស របស់ ក្រុមហ៊ុន ហាយ៉ាស៊ីដា បាន ដូច ខាងក្រោម៖
ស្វែងយល់ ពីមុខងារ នៃ ម៉ាស៊ីន ត្រជាក់ ដែល លោក អ្នក គួរ ជ្រើសរើស សម្រាប់ ប្រើប្រាស់ ដើម្បី ថែរក្សា សុខភាព ប្រចាំ ថ្ងៃ
