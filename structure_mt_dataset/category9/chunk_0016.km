( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ . របួស ស្រាល ៤នាក់ និង របួស ធ្ងន់ ១០នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៨ លើក នេះ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង និង បត់ គ្រោះថ្នាក់ ៕
នេះ បើ តាម ការឲ្យដឹង ពី នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា រដ្ឋលេខាធិការ និង ជា ប្រធាន គណៈកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ និង ជា ប្រធាន ក្រុមការងារ ប្រឆាំង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ក្នុង ក្របខណ្ឌ អាស៊ាន ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន នៅ យប់ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ក្រោយ ដឹកនាំ គណៈប្រតិភូ ក្រសួង មហាផ្ទៃ ត្រឡប់ មកពី ចូលរួម កិច្ចប្រជុំ នៅ ប្រទេស ថៃ ។
នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ប្រតិភូ កម្ពុជា បាន លើកឡើង នូវ ការអរគុណ ដល់ បណ្ដា ប្រទេស នានា ដែល បាន សហការ ចូលរួម ជាមួយ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង បទឧក្រិដ្ឋ ឆ្លង ដែន កន្លងមក នេះ ហើយ កម្ពុជា ក៏ ប្ដេជ្ញាចិត្ត ថា នឹង ចូលរួម ជាមួយ សហគមន៍ អន្ដរជាតិ ដើម្បី ប្រយុទ្ធ ប្រឆាំង ជាមួយ សត្រូវ រួម នេះ គឺ ឧក្រិដ្ឋ ជន ឆ្លង ដែន នេះ » ។
បើ តាម នាយ ឧត្តមសេនីយ៍ មៀច សុផាន់ ណា ក្នុង កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ដ្រី អាស៊ាន នេះ ប្រទេស កម្ពុជា ក៏ ទទួលបាន នូវ ការកោតសរសើរ អំពី បណ្ដា ប្រទេស ផ្សេង ៗ ហើយ ប្រទេស ចិន ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បិទ មិន អនុញ្ញាតឲ្យ មាន ការលេង ល្បែង តាម អនឡាញ ។
រដ្ឋមន្ដ្រី អាស៊ាន បូក៣ បាន ឯកភាព គ្នា ថា បទឧក្រិដ្ឋ ឆ្លង ដែន នេះ គ្មាន ប្រទេស ណាមួយ តែ ឯក ឯង ដែល អាច ដោះស្រាយ បញ្ហា នេះ បាន ឡើយ ព្រោះ ដែល ហៅ ថា បទឧក្រិដ្ឋ ឆ្លង ដែន គឺ ឧក្រិដ្ឋ ជន បាន ប្រព្រឹត្ត បទល្មើស ពី ប្រទេស មួយ ហើយ ជះ ឥទ្ធិពល និង ផលវិបាក ដល់ ប្រទេស មួយ ទៀត ឬ ឧក្រិដ្ឋ ជន ឆ្លង ពី ប្រទេស មួយ ទៅ ប្រទេស មួយ ដើម្បី បង្កបទឧក្រិដ្ឋ ដូច្នេះ ទាល់តែ ប្រទេស ដែល មាន ការពាក់ព័ន្ធ ពួត ដៃ គ្នា ផ្លាស់ប្ដូរ ព័ត៌មាន សហការ គ្នា ជួយ គ្នា ទៅ វិញ ទៅមក ។
គួរ ជម្រាប ថា បាតុកម្ម ហិង្សា បាន បន្ត ផ្ទុះឡើង នៅ ទីក្រុង បាកដាដ និង តំបន់ ដទៃ ទៀត នៅ ភាគ ខាងត្បូង ប្រទេស អ៊ីរ៉ាក់ ចាប់តាំងតែពី ដើម ខែតុលា ឆ្នាំ ២០១៩ នេះ ហើយ គិត មកដល់ ឥឡូវ មនុស្ស សរុប ជាង ៣៥០ នាក់ បាន បាត់បង់ជីវិត និង រហូតដល់ ១៥.០០០ នាក់ បាន ទទួលរង របួស ។
លោក Adel Abdul-Mahdi បាន ឡើង កាន់អំណាច កាលពី ជាង មួយ ឆ្នាំ មុន ជាមួយ ការសន្យា ធ្វើ កំណែទម្រង់ ស៊ីជម្រៅ ក៏ប៉ុន្តែ មក ទល់ បច្ចុប្បន្ន ហាក់ ពុំ មាន លទ្ធផល ជា ដុំកំភួន អ្វី ឡើយ ទើប បង្ខំ ឲ្យ ប្រជាជន អ៊ីរ៉ាក់ ខឹងសម្បារ ហើយ សម្រេច នាំគ្នា ធ្វើ បាតុកម្ម ទ្រង់ទ្រាយ ធំ ជា លើក ដំបូង កាលពី ថ្ងៃទី ០១ ខែតុលា កន្លងទៅ ដោយ ទាមទារ ឲ្យ រដ្ឋាភិបាល អ៊ីរ៉ាក់ លុបបំបាត់ ចោល អំពើពុករលួយ បង្កើត ការងារ បន្ថែម និង ផ្តល់ សេវា សាធារណៈ ដែល ល្អ ប្រសើរ ជាង មុន ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ ស្ថានការណ៍ ទូទាំង សកលលោក និង រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ផ្សេង ៗ ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ កម្លាំង សមត្ថកិច្ច បាន ដឹកនាំ កម្លាំង ចុះបង្ក្រាប ទីតាំង មជ្ឍ មណ្ឌល កំសាន្ត ក្មេង លេង ស្ថិត ក្នុង កោះ ពេជ្រ ដែល នៅ ផ្គើន គឃ្លើន នឹង អាជ្ញាធរ ដែល ខ្លួន ធ្វើ កិច្ចសន្យា មិន រកស៊ី ដាក់ ទូរហ្គេម ប្រភេទ ស៊ីសង បែប នេះ នៅ ទីតាំង ខ្លួន ។
ក្នុង ប្រតិបត្តិការ នេះ ដកហូត ទូរហ្គេម បាញ់ ត្រី៦ គ្រឿង និង ឃាត់ខ្លួនអ្នកមើល ការ ម្នាក់ . បុគ្គលិក ស្រី ៣នាក់ និង អ្នកលេង ប្រុស ស្រី ៨នាក់ ដើម្បី អប់រំ និង ធ្វើ កិច្ចសន្យា បញ្ឈប់ ការលេង ។ ប្រតិបត្តិការ បង្ក្រាប ទូរហ្គេម បាញ់ ត្រី នៅក្នុង មជ្ឈមណ្ឌល កោះ ពេជ្រ ដឹកនាំ ពី ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី លោក សាយ ណូរ៉ា និង មាន ការចូលរួម ដោយ ផ្ទាល់ ពី អភិបាល រង រាជធានី ភ្នំពេញ លោក មាន ចាន់ យ៉ាដា និង លោក ថេង សុថុល អភិបាល ខណ្ឌ ចំការមន ។
លោក ថេង សុថុល បាន ឲ្យដឹង ថា បើក ប្រតិបត្តិការ នេះ ក្រោម បញ្ជា ពី អភិបាល រាជធានី ភ្នំពេញ បាន ចុះបង្ក្រាប ទីតាំង ហ្គេម ក្មេង លេង មាន បង្កប់ ល្បែងស៊ីសង ទូរបាញ់ ត្រី ដែល ស្ថិត នៅ ទីតាំង ក្នុង មជ្ឍ មណ្ឌល កោះ ពេជ្រ ។ បច្ចុប្បន្ន មេ ការ និង អ្នកលេង ទាំងអស់ រួម នឹង វត្ថុ តាំង ទាំងអស់ ត្រូវបាន បញ្ចូន ទៅកាន់ សាលា ខណ្ឌ ចំការមន ដើម្បី ចាត់ការ ទៅតាម និតិវិធី ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២៩ ខែវិច្ឆការ ឆ្នាំ ២០១៩
២៖ សន្និសីទ មេគង្គ - ឡាន ឆាង ជំរុញ ឱ្យ ប្រទេស ជា សមាជិក ត្រូវ បង្កើត ខ្សែ ទស្សនកិច្ច ទេសចរណ៍ វប្បធម៌ និង ធម្មជាតិ ជាមួយគ្នា ( ចុច អាន )
៤៖ រដ្ឋបាល រាជធានី ភ្នំពេញ ចេញ សេចក្តីជូនដំណឹង ការបញ្ចៀស ចរាចរ ជា បណ្តោះអាសន្ន ក្នុង អំឡុង ពេល ប្រារព្ធ ពិធី អភិសេក រូបសំណាក នាង គង្ហីង ( ចុច អាន )
៥៖ រដ្ឋមន្ត្រី ថោង ខុន លើកទឹកចិត្ត ទេសចរ ដែល បើកបរ ដោយ ខ្លួន ឯង ពង្រីក ខ្សែ ទស្សនកិច្ច ឱ្យ ដល់ តំបន់ សមុទ្រ កម្ពុជា ( ចុច អាន )
៦៖ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការងារ អំពាវនាវ និង លើកទឹកចិត្ត ឲ្យ យុវជន ងាក មក រៀន ជំនាញ បច្ចេកទេស ដែល ទីផ្សារ ត្រូវការ ( ចុច អាន )
៥៖ អាជ្ញាធរ អាកាសចរណ៍ ស៊ីវិល ហុងកុង ប្រកាស ដំណឹង ទៅកាន់ អាកាសចរណ៍ នានា ចំពោះមុខ ការធ្លាក់ចុះ យ៉ាង គំហុក នៃ អ្នកដំណើរ ( ចុច អាន )
៧៖ ក្នុង ខែវិច្ឆិកា នេះ វៀតណាម កាត់ទោស សកម្មជន ៣នាក់ ឲ្យ ជាប់ ពន្ធនាគារ ពី បទ បង្ហោះ សារ លើ បណ្តាញ សង្គម ប៉ះពាល់ ដល់ រដ្ឋអំណាច ( ចុច អាន )
កម្មវិធី នេះ មាន គណៈប្រតិភូ និស្សិត ថ្នាក់ ក្រោយ បរិញ្ញាបត្រ ចំនួន ២៧ រូប ចូលរួម និង ដឹកនាំ ដោយ លោក បណ្ឌិត ជា សុភាព សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប និង សម្របសម្រួល ដោយ លោក បណ្ឌិត ស៊ូ វាសនា សាស្រ្តាចារ្យ នៃ វិទ្យាល័យ អាស៊ី អឺរ៉ុប និង សាស្រ្តាចារ្យ បណ្ឌិត កាវ ជួយ ចុង ព្រឹទ្ធ បុរស រង នៃ មហាវិទ្យាល័យ ទំនាក់ទំនង អន្តរជាតិ សាកលវិទ្យាល័យ ជាតិ កៅ ស៊ុង នៃ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា ។
ក្នុង រយៈពេល ១ សប្តាហ៍ នៃ កម្មវិធី នេះ និស្សិត អាស៊ី អឺរ៉ុប បាន សិក្សា ស្រាវជ្រាវ និង ទទួលបាន នូវ បច្ចេកទេស ព្រមទាំង បទពិសោធន៍ ជាច្រើន ពី សាកលវិទ្យាល័យ ជាតិ កៅ ស៊ុង នៃ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា ក្នុង ការបណ្តុះបណ្តាល ផ្លាស់ប្តូរ បទពិសោធន៍ វប្បធម៌ គ្នា ទៅ វិញ ទៅ មក ជាពិសេស គណៈប្រតិភូ បាន ចុះ ទស្សនកិច្ច តាម គ្រប់ Campus របស់ សាកលវិទ្យា - និង បាន ចូលរួម ប្រកួត មិត្តភាព កីឡា បាល់ ទះ ផ្លាស់ប្តូរ បទពិសោធន៍ គ្នា ពី របៀប ហែលទឹក និង សង្រ្គោះ បឋម ដល់ អ្នក ហែលទឹក ។
ក្នុង ឱកាស នោះ ក៏ បាន ចុះ ទស្សនកិច្ច សិក្សា ពី របៀប រៀបចំ លក់ និង រៀបចំ កញ្ចប់ ទេសចរណ៍ ការដឹកនាំ ភ្ញៀវ ទេសចរណ៍ នៅ តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្រ្ត ការរៀបចំ និង លក់ នៅ ផ្សារ រាត្រី សិក្សា ពី សារមន្ទីរ ជាតិ ជីវសាស្រ្ត និង ចិញ្ចឹម សត្វ សមុទ្រ គ្រប់ ប្រភេទ ក្នុង ការរៀបចំ បង្ហាញ ការចិញ្ចឹម ថែរក្សា សត្វ សមុទ្រ ទាំងនោះ ឱ្យ ភ្ញៀវ ទេសចរណ៍ បាន ទស្សនា ទស្សនកិច្ច កសិដ្ឋាន ចិញ្ចឹម អយ ស្ទ័រ ដោយ សិក្សា ពី របៀប ចិញ្ចឹម ថែរក្សារ ការពារ . ការរៀបចំ កញ្ចប់ ឱ្យ ភ្ញៀវ ទេសចរណ៍ ទស្សនា និង ទទួលទាន អយស្ទ័រ ។
បន្ថែម ពីលើ នេះ ទៀត គណៈប្រតិភូ និស្សិត ថ្នាក់ ក្រោយ បរិញ្ញាបត្រ នៃ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប ក៏ បាន ស្វែងយល់ នៅ ការិយាល័យ រដ្ឋាភិបាលកិច្ចការ កម្លាំង ពលកម្ម ក្នុង ទីក្រុង កៅស៊ុង ពី ការងារ អប់រំ ខាង កម្លាំង ពលកម្ម ទស្សនកិច្ច សិក្សា ស្វែងយល់ ពី ការធ្វើ ទីផ្សារ សង្វាក់ ផលិតកម្ម ការគ្រប់គ្រង និង ការនាំចេញ ម៉ាស៊ីន ហាត់ប្រាណ សម្រាប់ មនុស្ស ធម្មតា និង សម្រាប់ អ្នកជំងឺ ទៅកាន់ ទីផ្សារ អឺរ៉ុប សហរដ្ឋ អាមេរិក អាស៊ី និង ចិន របស់ ក្រុមហ៊ុន Sports Art Fitness ។
លើស ពី នោះ ចុះ ទៅ សិក្សា ស្រាវជ្រាវ នៅ វិទ្យាស្ថាន ជាតិ កសិកម្ម តៃវ៉ាន់ ពី របៀប ដាំ ថែរក្សា ព្យាបាល បង្កាត់ ពូជ ដំណាំ ហូប ផ្លែ និង បន្លែ បង្ការ គ្រប់ មុខ ជាពិសេស របៀប ដាំ ស្វាយ ប៉ោម ឱ្យ រស់ ឱ្យ បាន ជារៀងរហូត មិន ចេះ ស្លាប់ ដើម និង ទទួលបាន ផល គ្រប់ រដូវ ។
មុននឹង បញ្ចប់ ទស្សនកិច្ច គណៈប្រតិភូ បាន ទៅ វិទ្យាស្ថាន ស្រាវជ្រាវ បច្ចេកវិទ្យា ឧស្សាហកម្ម I. T. R. I ទទួលបាន នូវ មូលដ្ឋាន គំនិត ចំណេះ សំខាន់ ៗ និង បាន ស្វែងយល់ ពី បច្ចេកវិទ្យា ចុងក្រោយ នៃ បដិវត្តន៍ ឧស្សាហកម្ម 4.0 ដើម្បី ផ្សារ ភ្ជាប់ រវាង ទ្រឹស្តី និង ការអនុវត្តន៍ ផ្ទាល់ និង របកគំឃេីញ ថ្មី នៃ បច្ចេកវិទ្យា និង ស្វែងយល់ ពី បច្ចេកវិទ្យា ចុងក្រោយ ដូចជា ប្រព័ន្ធ ការពារ មហារីក ការចាក់ ស្ទីម សែល ក្នុង វិស័យ វិជ្ជសាស្រ្ត ។
សូម បញ្ជាក់ ផងដែរ ថា វគ្គ សិក្សា ថ្មី សម្រាប់ ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ និង ថ្នាក់ បណ្ឌិត នៅ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប នឹង ចាប់ផ្តើម នៅ ថ្ងៃទី ០២ ខែមករា ឆ្នាំ ២០២០ សម្រាប់ វគ្គ ចន្ទ - សុក្រ និង នៅ ថ្ងៃទី ០៤ ខែមករា ឆ្នាំ ២០២០ សម្រាប់ វគ្គ ចុង សប្តាហ៍ ៕
ពិតជា ពូកែ មែន ! កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា បន្ត ជាប់ លេខ មួយ ក្នុង កម្មវិធី ប្រកួត គណិតវិទ្យា ទាំង តំបន់ អាស៊ី និង ថ្នាក់ ពិភពលោក (Video inside) ( ភ្នំពេញ ) ៖ យោង តាម តារាង ប្រកួតប្រជែង គណិតវិទ្យា ទាំង តំបន់ អាស៊ី និង ថ្នាក់ ពិភពលោក បាន បន្ត បង្ហាញ នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ឲ្យដឹង ថា កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា ចៅ ស្រី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បន្ត ដណ្តើម បាន លេខ មួយ នៃ កម្មវិធី ប្រកួតប្រជែង សមត្ថភាព ផ្នែក គណិតវិទ្យា ទាំង នៅក្នុង តំបន់ អាស៊ី និង ពិភពលលោក ។
កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា បាន ឈរ នៅលើ កំពូល តារាង ក្នុង ចំណោម សិស្ស ១០០ នាក់ ទាំង នៅក្នុង តំបន់ អាស៊ី និង ពិភពលោក ជាមួយ ពិន្ទុ ១៨១៤០ ។ ដោយឡែក អ្នក ដណ្តើម បាន លេខ ២ សម្រាប់ តំបន់ អាស៊ី បាន ទៅ លើ សិស្ស មកពី កោះ តៃវ៉ាន់ ជាមួយ ពិន្ទុ ៣៥៨០ និង សម្រាប់ ថ្នាក់ ពិភពលោក បាន ទៅ លើ សិស្ស នៅ ប្រទេស អូស្រ្តាលី ជាមួយ ពិន្ទុ ១៧៥៨០ ។
កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា ជា កូនស្រី ទី២ របស់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ។ តាមរយៈ គេហទំព័រ ប្រកួតប្រជែង គណិតវិទ្យា កម្រិត ថ្នាក់ អាស៊ី និង ពិភពលោក នេះ កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា តែងតែ បាន ចូលរួម ប្រកួតប្រជែង សមត្ថភាព ជារឿយ ៗ ហើយ តែងតែ ទទួលបាន ចំណាត់ថ្នាក់ ល្អ ៗ ជានិច្ចកាល ។
តាមរយៈ លទ្ធផល នេះ បាន លើក តម្លៃ អប់រំ នៅ កម្ពុជា នា ពេល បច្ចុប្បន្ន ហើយ បាន បង្ហាញ ថា ភាព វៃឆ្លាត របស់ កុមារ កម្ពុជា មិន ចាញ់ កុមារ នៅលើ ពិភពលោក នោះ ឡើយ ៕ ពេល ទៅដល់ សៀមរាប ក្បួន រថយន្ដ ការ៉ាវ៉ាន់ ចូលរួម ផ្សព្វផ្សាយ វប្បធម៌ ទេសចរណ៍ យ៉ាង សកម្ម ក្នុង ក្របខណ្ឌ ទន្លេ មេគង្គ - ឡា ឆាង
ក្បួន រថយន្ដ ការ៉ាវ៉ាន់ ក៏ បាន ជំរុញ យុទ្ធនាការ កម្ពុជា៖ ព្រះរាជាណាចក្រ អច្ឆរិយៈ ផ្ដល់ ភាពកក់ក្ដៅ ឲ្យ កាន់តែ ទូលំទូលាយ និង មាន ប្រសិទ្ធភាព ខ្ពស់ ថែម ទៀត នៅក្នុង ទីផ្សារ ទេសចរ ចិន ដែល ជា ទីផ្សារ ឈរ លំដាប់ លេខ១ នៅក្នុង ប្រទេស កម្ពុជា ។
នា ឱកាស នេះ លោកស្រី Wang បាន បង្ហាញ ពី ចំណាប់អារម្មណ៍ យ៉ាង ខ្លាំង ចំពោះ ការវិវឌ្ឍន៍ រីកចម្រើន លើ គ្រប់ វិស័យ របស់ កម្ពុជា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី ។
លោកស្រី បាន បញ្ជាក់ បន្ថែម ថា នេះ ពិតជា បាន មក ដោយសារ ចំណង សាមគ្គីភាព មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ពេញលេញ គ្រប់ ជ្រុងជ្រោយ និង យូរអង្វែង រវាង ប្រជាជន និង រដ្ឋាភិបាល នៃ ប្រទេស ទាំង ពីរ ហើយ លោកស្រី ក៏ បាន សម្តែង នូវ អំណរ សាទរ ចំពោះ សមិទ្ធផល ដែល រាជ រដ្ឋាភិបាល ក៏ ដូច ប្រជាជន កម្ពុជា សម្រេចបាន នា ពេល កន្លងមក ។
ឆ្លៀត យក ឱកាស នេះ លោក រដ្ឋមន្ត្រី បាន ស្នើសុំ ឲ្យ រាជ បណ្ឌិត សភា ពិចារណា ផ្តល់ អាហារូប ករណ៍ សម្រាប់ រយ : ពេល ខ្លី ឬ វែង គ្រប់ កម្រិត ឬ ជា លក្ខណ បណ្តុះបណ្តាល រយ: ពេល ខ្លី ឬ វែង សម្រាប់ និស្សិត កម្ពុជា ឲ្យបាន ទៅ បន្ត ការសិក្សា នៅ សាធារណរដ្ឋ ប្រមានិត ចិន ក្នុង វិស័យ កសិកម្ម ឲ្យបាន កាន់តែ ច្រើន នា ពេល អនាគត ។
ដោយឡែក ចំពោះ កិច្ចសហប្រតិបត្តិការ ជាមួយ សាកលវិទ្យាល័យ ភូមិន្ទ កសិកម្ម លោក រដ្ឋមន្ត្រី ស្នើសុំ ឲ្យ រាជ បណ្ឌិត សភាព រៀបចំ ឯកសារ អនុស្សរណ នៃ ការយោគយល់ គ្នា (MOU) ឲ្យ បាន ឆាប់ ដើម្បី ដាក់ ជូន ក្រុមការងារ របស់ ភាគី ទាំង ពីរ ពិនិត្យ និង ចុះហត្ថលេខា ប្រើប្រាស់ ជា ផ្លូវការ ក្នុង ពេល ឆាប់ ខាងមុខ ៕ វិស័យ គ្រឿង សម្អាង នៅ កម្ពុជា មាន កំណើន យ៉ាង ឆាប់រហ័ស ខណៈ ពលរដ្ឋ ខ្មែរ ពេញនិយម ការតុបតែង ខ្លួន
( ភ្នំពេញ ) ៖ វិស័យ លក់ គ្រឿង សម្អាង សម្រាប់ ប្រើប្រាស់ ផ្ទាល់ខ្លួន នៅ ប្រទេស កម្ពុជា បច្ចុប្បន្ន នេះ មាន តម្លៃ ទីផ្សារ ហក់ ឡើង យ៉ាង ខ្លាំង ដោយសារតែ កំណើន យុវជន ខ្មែរ ចេះតែ កើនឡើង ជាលំដាប់ ខណៈ ការពេញនិយម ប្រើប្រាស់ គ្រឿង សម្អាង ដើម្បី តុបតែង ខ្លួន សម្រាប់ ចូលរួម ក្នុង កម្មវិធី ផ្សេង ៗ តម្រូវ ឱ្យ ពួកគេ ប្រើប្រាស់ ផងដែរ ។
ជាក់ស្តែង នៅ យប់ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ក្រុមហ៊ុន ដី ម៉ាសែល ឯ . ក បាន បើក សម្ពោធ ជា ផ្លូវការ នៅ សណ្ឋាគារ ភ្នំពេញ ដើម្បី ចូលរួមចំណែក បម្រើ ដល់ តម្រូវការ គ្រឿង សម្អាង ដែល មាន គុណភាព ដល់ អតិថិជន នៅ កម្ពុជា ។
បើ តាម លោកស្រី ចុង ធា អគ្គ នាយក ក្រុមហ៊ុន ដឺ ម៉ាសែល ឯ . ក បាន ឱ្យដឹង ថា ក្រុមហ៊ុន ត្រូវបាន បង្កើតឡើង នៅក្នុង ឆ្នាំ ២០១៩ នេះ ទទួល សិទ្ធិ ជា ផ្លូវការ ក្នុង ការចែកចាយ ផលិតផល ពី រោងចក្រ ផ្ទាល់ ទៅ លើ ម៉ាក ល្បី ៗ ច្រើន មកពី ប្រទេស កូរ៉េ សម្រាប់ ផលិតផល គ្រឿង សម្អាង ជូន ដល់ អតិថិជន ហើយក៏ បាន ចូលរួមចំណែក ក្នុង ការអភiវឌ្ឍន៍ ប្រទេស កម្ពុជា ផងដែរ ។
លោកស្រី បាន បន្ត ថា ការសម្រេចចិត្ត បើក ក្រុមហ៊ុន នេះ ឡើង ដោយសារ ប្រទេស កម្ពុជា ដែល ជា ប្រទេស កំពុង អភិវឌ្ឍន៍ និង មាន ការអភិវឌ្ឍន៍ ដ៏ លឿន និង មាន សក្តានុពល ទន្ទឹមនឹង នេះ សម្រាប់ សុភាពនារី និង សុភាពបុរស សម័យ ថ្មី ក៏ មាន តម្រូវការ ខាង គ្រឿង សម្អាង យ៉ាង ខ្លាំង ផងដែរ ។ ដូច្នេះ ដើម្បី បំពេញ តម្រូវ ការចាំបាច់ ទាំងអស់ នេះ ក្រុមហ៊ុន ដី ម៉ាសែល បាន បើក ក្រុមហ៊ុន របស់ ខ្លួន ហើយ ផ្តល់ ជូន អតិថិជន ទាំងអស់ នូវ បាវចនា « ដឺម៉ាសែល តែងតែ ឈាន មុខ គេ ជានិច្ច ទាំង គុណភាព និង តម្លៃ សម្រម » ។
លោកស្រី ចុង ធា ដែល នាំយក ផលិតផល គ្រឿង សម្អាង យកមក លក់ ចែកចាយ នៅក្នុង ប្រទេស កម្ពុជា បាន ថ្លែង ឱ្យដឹង ថា បន្ទាប់ពី លោកស្រី ទៅ ទស្សនកិច្ច នៅ ប្រទេស កូរ៉េ ជាច្រើន លើក ច្រើន សារ បាន មើលឃើញ ថា ផលិតផល គ្រឿង សម្អាង ដែល លោក សម្រេច នាំចូល មក ពេលនេះ ពិតជា ល្បីល្បាញ នៅ ប្រទេស កូរ៉េ ប្រាកដ មែន ដោយ មាន ប្រជាជន កូរ៉េ ជាពិសេស ស្ត្រី តែម្ដង និយម ប្រើ ដើម្បី តុបតែង ខ្លួន និង ថែរក្សា សម្ផស្ស ។
លោកស្រី បាន បន្ថែម គ្រឿង សម្អាង ដែល នាំចូល ពី ប្រទេស កូរ៉េ ដើម្បី ចរាចរ នៅលើ ទីផ្សារ កម្ពុជា នេះ គឺជា ភាគ ច្រើន ជា ហ្វូម លាង មុខ ជម្រុះ ធូលី លើ ផ្ទៃ មុខ ចម្ចាត់ មុន សាច់ មុន អង្កាម និង កម្ចាត់ បាក់តេរី នៅលើ ផ្ទៃ មុខ បំបាត់ មុខ ជាំ ខ្មៅ ភាព ជ្រាវ ជ្រួញ ។ បន្ថែម ពី នេះ ផលិតផល នេះ ទទួលបាន គាំទ្រ យ៉ាង ខ្លាំង ពីសំណាក់ អ្នកប្រើប្រាស់ និង តំណាង ចែកចាយ ទូទាំង ប្រទេស កម្ពុជា ។
ផ្តើម ចេញ ពី អាជីវករ លក់ ដូច តូចតាច គ្មាន ដើមទុន ច្រើន និង គ្មាន តូប តូច មួយ សម្រាប់ លក់ ផលិតផល អ្នកស្រី ចុង ធា បាន ពុះពារ គ្រប់ ឧបសគ្គ ទោះបីជា ពេល នោះ ការលក់ ផលិតផល តូចតាច របស់ អ្នកស្រី សឹងតែ មិន ដាច់ ទាល់តែសោះ តែ អ្នកស្រី មាន ឆន្ទៈ មួយ ថា អ្នកស្រី នឹង ក្លាយជា អ្នក មាន ឱ្យ បាន ដូចនេះ អ្នកស្រី មិន រាថយ ឡើយ នៅក្នុង ការធ្វើ អាជីវកម្ម ។
ចាប់ពី ពេល នោះ អ្នកស្រី បាន ប្រឹងប្រែង ក្នុង ការលក់ ផង និង ចុះ រក ទីផ្សារ លក់ ដោយ ខ្លួន ឯង រហូតដល់ ការលក់ របស់ អ្នកស្រី មាន ការកើនឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។ ដោយ មើលឃើញ ពី ភាពរីកចម្រើន នេះ លោកស្រី ក៏ បាន អភិវឌ្ឍន៍ ខ្លួន ពី អ្នកលក់ តូចតាច មក បើក ជា ដេប៉ូលក់ វិញ ម្តង ។ ក្នុង ការធ្វើ អាជីវកម្ម នេះ លោកស្រី ចុង ធា គឺ ផ្តោត សំខាន់ ខ្លាំង លើ ការប្រមូល យក ទីផ្សារ និង ផ្សព្វផ្សាយ ពី គុណភាព និង តម្លៃ ផលិតផល របស់ អ្នកស្រី រហូត មាន ការទទួលស្គាល់ និង គាំទ្រ ច្រើន ពី អតិថិជន ។
លោកស្រី បញ្ជាក់ ថា រាល់ ផលិតផល ដែល នាំចូល និង ចែកចាយ ដោយ ក្រុមហ៊ុដី ម៉ាសែល សុទ្ធតែ ត្រូវបាន ត្រួតពិនិត្យ គុណភាព និង សុវត្ថិភាព ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ទាំង នៅក្នុង ប្រទេស កម្ពុជា និង កូរ៉េ ហើយ ផលិតផល ទាំងនោះ មាន ការគាំទ្រ និង ពេញនិយម ជាខ្លាំង ពីសំណាក់ ប្រជាជន កូរ៉េ ប្រជាជន កម្ពុជា និង បណ្តា ប្រទេស ជាច្រើន នៅលើ ពិភពលោក ៕ អាជ្ញាធរ ទន្លេ សាប ក្រើន រម្លឹក មន្ត្រី គ្រប់ លំដាប់ថ្នាក់ និង ប្រជាពលរដ្ឋ ត្រៀម ដោះស្រាយ បញ្ហា ខ្វះ ទឹក ឲ្យបាន មុន រដូវ ប្រាំង មកដល់ នៅ ឆ្នាំ ២០២០
( កណ្ដាល ) ៖ លោក ម៉ៅ ហាក់ អនុប្រធាន អាជ្ញាធរ ទន្លេ សាប បាន ក្រើន រម្លឹក ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ ធ្វើ ការផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលាយ ដល់ ប្រជាពលរដ្ឋ បាន យល់ដឹង ដើម្បី រួមគ្នា អនុវត្ត ប្រកបដោយ ជោគជ័យ ដោយ តម្រូវឲ្យ ពួកគាត់ ធ្វើ ស្រូវ រដូវ ប្រាំង តែម្ដង ប៉ុណ្ណោះ ព្រោះ ឆ្នាំ នេះ អាច ខ្វះ ទឹក ចៀសវាង កុំ ឱ្យ មាន ការខាតបង់ ។
លោក ថ្លែង បែប នេះ នៅក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ សារាចរ ណែនាំ លេខ ១១ ស. រ.ណ .ន របស់ រាជ រដ្ឋាភិបាល ស្ដីពី ការចាត់ វិធានការរក្សា ទឹក ទុក នៅ រសៀល ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ សាលា ខេត្ត កណ្ដាល ។
លោក បន្ត ថា អាជ្ញាធរ ត្រូវ អប់រំ ប្រជាពលរដ្ឋ ឲ្យ ប្រើប្រាស់ ដោយ សន្សំ សំចៃ ខ្ពស់ ទាំង ការប្រើប្រាស់ ប្រចាំ ថ្ងៃ និង ក្នុង វិស័យ កសិកម្ម ជាដើម ពិសេស ត្រូវ នាំគ្នា ជួយ ថែរក្សា ប្រភព ទឹក ដូចជា អាងទឹក ស្រះ ទឹក បឹង ទន្លេ ដោយ ការស្ដារ ស្រះ កុំ បំពុល ប្រភព ទឹក ដោយ ការចោល សំរាម និង បង្ហូរ ទឹក កខ្វក់ ចូល ឲ្យ សោះ ធ្វើ យ៉ាងណា រួមគ្នា ថែរក្សា ប្រភព ទឹក ប្រើប្រាស់ ឲ្យបាន យូរអង្វែង ។
លោក តាំង ម៉េង លាង អភិបាល រង ខេត្ត កណ្ដាល បាន បញ្ជាក់ ឱ្យដឹង ដែរ ថា សម្រាប់ ការប្រែប្រួល អាកាសធាតុ ក្នុង ឆ្នាំ ២០១៩ នេះ បាន បង្កឲ្យ មាន ព្យុះ ចំនួន ២៤លើ ក និង មាន ខ្យល់ កន្ត្រាក់ បណ្ដាលឲ្យ ប៉ះពាល់ ផ្ទះសម្បែង ប្រជាពលរដ្ឋ ជាច្រើន ខ្នង ស្ទើរ គ្រប់ ស្រុក មាន ផ្គរ រន្ទះ បាញ់ មនុស្ស ស្លាប់ ម្នាក់ នៅ ឃុំ ព្រែក រកា ស្រុក កណ្ដាល ស្ទឹង និង ងាប់ គោ ៣ក្បាល នៅ ឃុំ បាក់ ដាវ ស្រុក ខ្សាច់ កណ្ដាល ។
លោក បាន បន្ត ថា ចំពោះ ស្រូវ ប្រាំង ឆ្នាំ ២០១៨ - ២០១៩ ប៉ះពាល់ និង ខ្វះ ទឹក ជាង ៣.០០០ ហិកតា រួម មាន នៅ ស្រុក លើក ដែក ស្រុក កោះ ធំ និង ស្រុក ស្អាង ដែល ត្រូវបាន សង្គ្រោះ បាន ចំនួន ២. ៤២០ហិកតា ដោយ មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ។ ដោយឡែក ស្រូវ រដូវ វស្សា ឆ្នាំ ២០១៩ - ២០២០ ប៉ះពាល់ និង រាំងស្ងួត លើ ផ្ទៃដី ១.៤០០ ហិកតា នៅ ស្រុក កណ្ដាល ស្ទឹង និង ស្រុក អង្គ ស្រួល ដែល ត្រូវបាន សង្គ្រោះ បាន ចំនួន ៤៧១ ហិកតា ដោយ មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត ។
លោក បាន បន្ត ទៀត ថា បច្ចុប្បន្ន នេះ ស្រូវ ចុង រដូវ វស្សា និង ស្រូវ ប្រាំង នៅ ស្រុក កណ្ដាល ស្ទឹង ប្រមាណ ២៥០ ហិតា និង ស្រូវ ប្រាំង ប្រដេញ ទឹក នៅ ស្រុក ខ្សាច់ កណ្ដាល ជាង ៥០០ ហិកតា កំពុង ជួប ការខ្វះ ទឹក ដែល មន្ទីរ កំពុង អន្តរាគមន៍ បូម ទឹក ជួយសង្គ្រោះ ផងដែរ ៕ MICHELIN បង្ហាញ សំបក កង់ រថយន្ត ថ្មី ២ប្រភេទ ដែល ផ្តល់ ជូន ទាំង គុណភាព ប្រើប្រាស់ បាន យូរ និង សុវត្ថិភាព រហូតដល់ សឹក រិល
ពិធី បើក សម្ពោធ សំបក កង់ រថយន្ត ម៉ាក ថ្មី ២ ប្រភេទ បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ។ សំបក កង់ Michelin ត្រូវបាន រចនា ឡើង ដើម្បី រក្សា ផ្តល់ នូវ គុណភាព សុវត្ថិភាព និង សមត្ថភាព ខ្ពស់ សូម្បីតែ នៅ ពេល ដែល សំបក កង់ សឹក ក៏ដោយ ហើយ វា បាន ផ្តោត លើ អ្នកប្រើប្រាស់ ដែល កំពុង ស្វែងរក សំបក កង់ ដែល មាន គុណភាព ខ្ពស់ សុវត្ថិភាព ខ្ពស់ និង អាយុកាល ប្រើប្រាស់ បាន យូរ ។
លោក បាន បន្ថែម ថា បន្ថែម ពីលើ ចង្អូរ ក្រឡា ដែល រចនា ឡើង ជាមួយនឹង ក្រឡាកាន់តែ រឹងមាំ និង បង្កើន ភាព ភាព ខាំ ជាប់ នឹង ផ្លូវ នៃ ផ្នែក សងខាង សំបក កង់ បាន ល្អ ក្រឡា សំបក កង់ នេះ ក៏ ត្រូវបាន បំពាក់ នូវ បច្ចេកវិទ្យា ឆ្លើយតបរហ័ស និង ក្រវ៉ាត់ សំបក កង់ ដែល មាន ការពង្រឹង ដោយ កម្លាំង ហាយ ប្រ៊ីដ ដែល ផលិត ចេញ ពី អារ៉ាមីត (aramid) និង នីឡុង សម្រាប់ ធ្វើឱ្យ ការបើកបរ កាន់តែ កាន់ ល្អ ផងដែរ ។
នាយក ផ្នែក ពាណិជ្ជកម្ម របស់ ក្រុមហ៊ុន អាកាសចរណ៍ ខេមបូឌា អ៊ែរវ៉េ បាន សម្តែង នូវ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ភ្នាក់ងារ និង អតិថិជន ទាំងអស់ ដែល បាន ចូលរួម ក្នុង ពិធី នោះ ។
បន្ទាប់មក លោក បាន លើកឡើង ថា ក្នុង នាម ជា ក្រុមហ៊ុន អាកាសចរណ៍ ក្នុង ស្រុក របស់ កម្ពុជា ក្រុមហ៊ុន អាកាសចរណ៍ ខេមបូឌា អ៊ែរវ៉េ បាន ប្តេជ្ញាចិត្ត ក្នុង ការអភិវឌ្ឍ ទីផ្សារ ចាប់តាំងពី ការបើក ជើងហោះហើរ ដំបូង នៅ ខែកក្កដា ឆ្នាំ ២០១៨ ។
រហូតមកដល់ ពេលនេះ ក្រុមហ៊ុន បាន បំរើ និង ដឹកជញ្ជូន អ្នកដំណើរ ជាង ៤០០០០០ នាក់ ដោយ សុវត្ថិភាព ទៅកាន់ គោលដៅ របស់ ពួកគេ ។
ជាមួយនឹង ការរីកចម្រើន យ៉ាង ឆាប់រហ័ស របស់ ក្រុមហ៊ុន និង ការកែលំអ បណ្តាញ ផ្លូវ ហោះហើរ ក្រុមហ៊ុន អាកាសចរណ៍ ខេមបូឌា អ៊ែរវ៉េ បាន បង្កើត និង ដាក់ ឱ្យ ប្រើប្រាស់ ការិយាល័យ លក់ សំបុត្រ កណ្តាល ក្រុង ជា ផ្លូវការ នៅក្នុង អាគារ Prince Phnom Penh Tower ដើម្បី ផ្តល់ នូវ សេវាកម្ម ប្រកបដោយ គុណភាព និង ភាពងាយស្រួល ជាង មុន ដល់ ភ្នាក់ងារ ទេសចរណ៍ និង អតិថិជន ជាមួយនិង សេវា អតិថិជន ដ៏ ល្អ ។
ការិយាល័យ លក់ សំបុត្រ ក្នុង ក្រុង នេះ មិន ត្រឹមតែ ផ្តល់ ភាពងាយស្រួល ដល់ អ្នកដំណើរ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែមទាំង ឆ្លុះបញ្ចាំង ពី ការប្តេជ្ញាចិត្ត របស់ ក្រុមហ៊ុន អាកាសចរណ៍ ខេមបូឌា អ៊ែវ៉េ ដើម្បី បង្កើត បណ្តាញ ផ្លូវ ធំ ទូលាយ ដែល គ្របដណ្តប់ ទាំង ប្រទេស ចិន និង អាស៊ាន និង នៅលើ ពិភពលោក ដែល ប្រើប្រាស់ រាជធានី ភ្នំពេញ ជា មជ្ឈមណ្ឌល ។
បនា្ទប់ មក តាម ការអញ្ចើញ របស់ ពិធី ករ ប្រធាន គ្រប់គ្រង ពាណិជ្ជកម្ម នៃ ក្រុមហ៊ុន អាកាសចរណ៍ ខេមបូឌា អ៊ែរវ៉េ បាន ប្រារព្ធ ពិធី កាត់ ខ្សែបូរ ដើម្បី អបអរសាទរ ការបើក ការិយាល័យ លក់ សំបុត្រ កណ្តាល ទីក្រុង ជា ផ្លូវការ ។
បុគ្គលិក ក្រុមហ៊ុន អាកាសចរណ៍ ខេមបូឌា អ៊ែរវ៉េ បាន ចែក កាដូ ដល់ ភ្ញៀវ ក្នុង ពិធី អ្នក ដែល បាន ទិញ សំបុត្រ នៅ ថ្ងៃ តែ មួយ នឹង ទទួលបាន នូវ បន្តោង សោរ ក្រៅពី នេះ ក៏ មាន ការចាប់ឆ្នោត ផ្សង សំណាង ផងដែរ ការចែកជូន នេះ ត្រូវបាន ធ្វើឡើង នៅ ថ្ងៃ ដដែល នៅ ការិយាល័យ លក់ សំបុត្រ សម្រាប់ ភ្ញៀវ គ្រប់ រូប ដែល មក ទិញ សំបុត្រ ។
( ឡូស អាន់ ជែល ឡែ ស) ៖ ភ្លើង ឆេះ ព្រៃ បាន លេប ត្របាក់ ផ្នែក ជាច្រើន នៅ រដ្ឋ កាលីហ្វរញ៉ា ដែល បាន បណ្តាលឲ្យ ដើមឈើ រាប់ លាន ដើម ត្រូវបាត់បង់ ក្នុង មួយ ឆ្នាំ ៗ ហើយ អាកាសធាតុ ក៏ កាន់តែ ក្តៅ ឡើង ៗ ដោយសារ ខ្យល់ ស្ងួត បោកបក់ ពី មហាសមុទ្រ ប៉ាស៊ីហ្វិក កាន់តែ អូសបន្លាយ យូរ ជាង មុន ។ បញ្ហា ទាំងអស់ នេះ ត្រូវបាន ក្រុម ជំនាញ បរិស្ថាន អះអាង ថា បង្កឡើង ដោយ ការប្រែប្រួល បរិយាកាស ភព ផែនដី យ៉ាង ពិតប្រាកដ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី៣០ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
លោក ហ៊ុន ម៉ានី បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « អនាគត របស់ សង្គមជាតិ និង សុភមង្គល របស់ ប្រជាជន គឺ មាន សារៈសំខាន់ បំផុត ដែល មិន អាច បណ្តោយ ទៅ តាម យថា ហេតុ ឬ ឲ្យ មាន ភាព ចៃដន្យ ណាមួយ កើតឡើង ធ្វើឲ្យ ប៉ះពាល់ នោះ ទេ ។ ប្រាកដ ណាស់ ពេលនេះ ពេល ដែល កម្ពុជា រីករាយ នឹង សន្តិភាព ស្ថិរភាព . វា ក៏ ជា ពេល ដែល យុវជន កម្ពុជា ត្រូវតែ គិត បន្ថែម ទៀត អំពី តួនាទី ទំនួល ខុសត្រូវ និង ការចូលរួមចំណែក របស់ ខ្លួន ដើម្បី សង្គមជាតិ និង ប្រជាជន » ។
ពិធី អបអរសាទរ ខួប លើក ទី ៤១ នេះ ត្រូវ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ៣គឺ៖ ១៖ ដើម្បី រម្លឹក នូវ គុណូការៈ និង ការលះបង់ របស់ យុវជន ជំនាន់ មុន និង បុព្វបុរស របស់ យើង . ២៖ អបអរសាទរ នូវ សមិទ្ធផល នានា ដែល សម្រេចបាន កន្លងមក រហូតដល់ បច្ចុប្បន្ន នេះ . និង ៣៖ ត្រៀមខ្លួន ក្នុង ការចូលរួមចំណែក ដើម្បី នាំ កម្ពុជា ទៅ អនាគត ឱ្យ កាន់តែ ប្រសើរ ។
លោក ហ៊ុន ម៉ានី បាន រំលេច ពី ឆន្ទៈ យ៉ាង មុះ មុត និង ហ៊ាន លះបង់ ក្រោម ស្មារតី ២ធ្នូ របស់ ថ្នាក់ដឹកនាំ និង យុវជន ជំនាន់ មុន ដែល បាន ដាក់ ជីវិត ធ្វើជា ដើមទុន ក្នុង ការបំពេញ បេសកកម្ម ដ៏ គ្រោះថ្នាក់ ដើម្បី សុខ សុវត្ថិភាព របស់ ប្រជាជន ខ្មែរ ខណៈពេល ដែល ពិភពលោក មិន បាន ខ្វាយខ្វល់ ទាល់តែសោះ អំពី ឧក្រិដ្ឋកម្ម ប្រឆាំង មនុស្សជាតិ និង ទុក្ខសោក ដែល ប្រជាជន កម្ពុជា រងគ្រោះ នា ពេល នោះ ។
លោក បាន បន្ត ថា៖ « កម្ពុជា មិន មាន ជម្រើស ណា ផ្សេង ក្រៅពីក្រោកឈរ ឡើង ដោយ ខ្លួន ឯង ហ៊ាន លះបង់ ដោយ យក ជីវិត ធ្វើជា ដើមទុន ដើម្បី រំដោះ សង្គ្រោះ ប្រជាជន និង កសាង ជាតិ ឲ្យ រស់ ឡើងវិញ » ។
លោក ក៏ បាន បង្ហាញ ពី ការចងចាំ មិន ភ្លេច នូវ គម្រូ វីរភាព របស់ យុវជន ជំនាន់ មុន បើ ទោះបីជា ៤១ ឆ្នាំ បាន កន្លងផុត ទៅ តែ ស្មារតី ២ ធ្នូ នៅតែ ដក់ ជាប់ ជាមួយ យុវជន ជំនាន់ ក្រោយ គ្រប់ ៗ រូប ។
ផើ្តម ចេញ ពី កិច្ចការងារ សម្រាប់ យុវជន ស .ស .យ .ក . បាន ក្លាយជា វេទិកា មួយ ដែល ផ្តល់ ឱកាស ដល់ យុវជន គ្រប់ រូប ដែល មាន ចិត្ត និង គោលបំណង ដូចគ្នា ក្នុង ការផ្តល់ ក្តី ស្រលាញ់ លះបង់ ពេលវេលា ធនធាន ផ្ទាល់ខ្លួន ដើម្បី សង្គមជាតិ និង ប្រជាជន ។ ទន្ទឹមនឹង នេះ ស .ស .យ .ក . ក៏ បាន ចូលរួម យ៉ាង សកម្ម ក្នុង សកម្មភាព វប្បធម៌ សាសនា តាមរយៈ ការជំរុញ ការស្វែងយល់ ពី ប្រវត្តិសាស្រ្ត ការចូលរួមចំណែក ក្នុង វិស័យ អប់រំ សង្គម មនុស្សធម៌ កីឡា សិល្បៈ កំសាន្ត ដែល អនុញ្ញាតឲ្យ យុវជន គ្រប់ និន្នាការ ចូលរួម បាន យ៉ាង ទូលំទូលាយ ។
ជាមួយគ្នា នោះ ស .ស .យ .ក . បាន ចូលរួម ពង្រឹង អត្តសញ្ញាណ ជាតិ តាមរយៈ ការរៀបចំ ព្រឹត្តិការណ៍ ធំ ៗ ជាច្រើន រួម មាន ព្រឹត្តិការណ៍ អង្គរ សង្គ្រាន្ត ពិធី ថ្វាយ ព្រះពរ សង្ក្រាន្ត ឆ្នាំ ថ្មី ការបំបែក ឯតទគ្គកម្ម ក្រមា វែង និង ទូក វែង ជាង គេ និង ព្រឹត្តិការណ៍ នានា ផ្សេង ៗ ។
សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ធ្វើដំណើរ មក យ៉ាង វែងឆ្ងាយ ហើយក៏ សម្រេចបាន នូវ សមិទ្ធិផល ជាច្រើន សម្រាប់ ជាតិ មាតុភូមិ ។ ប៉ុន្តែ លោក ហ៊ុន ម៉ានី បាន បញ្ជាក់ ថា ស .ស .យ .ក . នៅ មាន ការងារ ជាច្រើន ទៀត ដែល ត្រូវ ធ្វើ ។
លោក បាន ថ្លែង ថា៖ « យើង ត្រូវ រំលឹក ខ្លួន ឯង ជាប់ ជានិច្ច ថា សង្គម អនាគត នឹង អាច ប្រែប្រួល ទាំង លើ ទិដ្ឋភាព ឱកាស និង បញ្ហា ប្រឈម ដែល ទាមទារ ឲ្យ យើង មិន ត្រឹមតែ ត្រៀមខ្លួន ដើម្បី ទប់ទល់ ប៉ុន្តែ ថែមទាំង ប្រើប្រាស់ ឲ្យ អស់ សមត្ថភាព និង ឆន្ទៈ មនសិការ ដើម្បី កែប្រែ បញ្ហា ប្រឈម ទាំងនោះ ទៅជា កាលានុវត្តភាព ថ្មី សម្រាប់ ការរីកចម្រើន របស់ ជាតិ យើង បន្ត ទៅ ទៀត » ។
( ភ្នំពេញ ) ៖ លោក កែវ សុធា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ចេញ ដីកា មួយ ដោយ បញ្ជា ឲ្យ លោក ឧកញ៉ា លី សាយ ឃាង ចូល ខ្លួន ឆ្លើយ បំភ្លឺ ក្នុង សំណុំរឿង ព្រហ្មទណ្ឌ ពី បទ បំភាន់ មន្ត្រី សុរិយោដី ក្នុង ការបំពេញ បេសកកម្ម ឬ បំភាន់ អាជ្ញាធរ ក្នុង ការចុះបញ្ជី ដី លួច លក់ ឬ លួច បញ្ចាំ អចលន វត្ថុ ដែល មិន មែន ជា របស់ ខ្លួន និង រំលោភ លើ ទំនុកចិត្ត តាម បណ្ដឹង របស់ ឈ្មោះ បាន ម៉េង ទូច ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ៣០ ខែវិច្ឆិកា នេះ បាន បង្ហោះ សារ ចូលរួម អបអរសាទរ ខួប៣ ឆ្នាំ នៃ ការដាក់បញ្ចូល ចា ប៉ី ដង វែង ក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី នៃ មនុស្សជាតិ របស់ អង្គការ យូណេស្កូ និង បាន អំពាវនាវ ដល់ បងប្អូន ជន រួម ជាតិ បន្ត ថែរក្សា សម្បត្តិ បេតិកភណ្ឌ វប្បធម៌ ជាតិ ឱ្យ នៅ គង់វង្ស ។
ជាមួយគ្នា នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន អរគុណ ដល់ ព្រឹទ្ធាចារ្យ សិល្បករ ចា ប៉ី ដង វែង ទាំងឡាយ ដែល បាន ចូលរួម ក្នុង ការថែរក្សា នូវ សិល្បៈ មួយ នេះ ឲ្យបាន គង់វង្ស និង អរគុណ ដល់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដែល តែងតែ ខ្នះ ខ្នែង ក្នុង ការសិក្សា ស្រាវជ្រាវ ក៏ ដូចជា រៀបចំ ស្នើ ទៅ អង្គការ យូណេស្កូ ក្នុង ការដាក់បញ្ចូល សម្បត្តិ វប្បធម៌ របស់ កម្ពុជា មួយចំនួន ចូលក្នុង សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក ។
ចាប៉ី ដង វែង ជា ឧបករណ៍ តន្ត្រី វ័យ ចំណាស់ មួយ របស់ កម្ពុជា ដែល ជា ឧបករណ៍ ដែល មាន ឆ្លាក់ នៅ ជញ្ជាំង ប្រាសាទ អង្គរវត្ត ផងដែរ ។ ចាប៉ី អាច លេង បាន មាន អម ជាមួយ បទចម្រៀង ព្រមទាំង អាច ច្នៃប្រឌិត និង បង្កើត បទ ថ្មី ៗ ដោយ ខ្លួន ឯង ទៀតផង ។ បទចម្រៀង ចាប៉ី ជាទូទៅ រៀបរាប់ អំពី រឿង បុរាណ ឬ រឿង អប់រំ ខ្លី ៗ ដល់ ប្រជាជន ពី គុណធម៌ និង វប្បធម៌ ជាដើម ។
អរគុណ ដល់ ព្រឹទ្ធាចារ្យ សិល្បករ ចា ប៉ី ដង វែង ទាំងឡាយ ដែល បាន ចូលរួម ក្នុង ការថែរក្សា នូវ សិល្បៈ មួយ នេះ ឲ្យបាន គង់វង្ស និង អរគុណ ដល់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដែល តែងតែ ខ្នះ ខ្នែង ក្នុង ការសិក្សា ស្រាវជ្រាវ ក៏ ដូចជា រៀបចំ ស្នើ ទៅ អង្គការ យូណេស្កូ ក្នុង ការដាក់បញ្ចូល សម្បត្តិ វប្បធម៌ របស់ កម្ពុជា មួយចំនួន ចូលក្នុង សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក ។
សូម បងប្អូន ជន រួម ជាតិ បន្ត ថែរក្សា សម្បត្តិ បេតិកភណ្ឌ វប្បធម៌ ជាតិ យើង ឱ្យ នៅ គង់វង្ស ជា បន្តបន្ទាប់ ទៀត »៕
សារលិខិត របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ វេទិកា ភាព ជា អ្នកដឹកនាំ តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក ឆ្លើយតប មេរោគ អេដស៍ និង ជំងឺ អេដស៍ នៅ កម្ពុជា បាន ចេញ ដើម្បី ចូលរួម ក្នុង ឱកាស ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ១ធ្នូ ឆ្នាំ ២០១៩ ក្រោម ប្រធានបទ « ទាំងអស់ គ្នា ចូលរួម ជា ចរន្ត ជាតិ មួយ ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ មេរោគ អេដស៍ និង ជំងឺ អេដស៍ » ។
លើស ពី នេះ ទៅ ទៀត អត្រា ធ្វើតេស្ត ឈាម រក មេរោគ អេដស៍ ក្នុង ចំណោម ស្ត្រី មាន ផ្ទៃពោះ បាន កើនឡើង ខ្ពស់ អត្រា ចម្លង ពី ម្តាយ ដែល មាន ផ្ទុក មេរោគ អេដស៍ ទៅ កូន និង សន្ទស្សន៍ នៃ ការរើសអើង មើលងាយ អ្នក ផ្ទុក មេរោគ អេដស៍ អ្នកជំងឺ អេដស៍ មាន ការថយចុះ ខ្លាំង គួរ ជា ទី មោទនៈ ។
ក្នុង ឱកាស នេះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ផ្តល់ អនុសាសន៍ ចំណុច ៦ សម្រាប់ ការងារ ប្រយុទ្ធ ទប់ស្កាត់ ការរាលដាល មេរោគ អេដស៍ និង ជំងឺ អេដស៍ នៅ កម្ពុជា៖
១៖ សូម សាខា កាកបាទ ក្រហម កម្ពុជា យុវជន អ្នកស្ម័គ្រចិត្ត ពង្រឹង ពង្រីក សកម្មភាព ផ្សព្វផ្សាយ អប់រំ លើកកម្ពស់ ការយល់ដឹង ពី បញ្ហា អេដស៍ ឱ្យ បាន ដល់ សហគមន៍ ជនបទ និង ត្រូវ ផ្តល់ ការជួយ ឧបត្ថម្ភ គំាពារ ដល់ អ្នក ផ្ទុក មេរោគ អេដស៍ អ្នកជំងឺ អេដស៍ ។
២៖ ចំពោះ អ្នក ដែល សង្ស័យ ថា ខ្លួន បាន ប្រឈម នឹង ការឆ្លង មេរោគ អេដស៍ សូម ប្រញាប់ រួសរាន់ ទៅ ពិនិត្យ ឈាម រក មេរោគ អេដស៍ និង ទៅ ទទួល សេវា ថែទាំ ពី មណ្ឌល សុខភាព ឱ្យ បាន ទៀងទាត់ ព្រមទាំង ជៀសវាង ដាច់ខាត កុំ ចម្លង ទៅ អ្នកដទៃ និង ចូលរួម សហការអប់រំ ផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ ។
៣៖ ចំពោះ ស្ត្រី មាន ផ្ទៃពោះ ត្រូវ ទៅ ពិនិត្យ សុខភាព ឱ្យ បាន ទៀងទាត់ និង ជាពិសេស ឆាប់ ធ្វើតេស្ត ឈាម ដើម្បី ទទួល សេវា ការពារ ការចម្លង មេរោគ អេដស៍ ទៅ ទារ ក និង ជម្រុញ លើកទឹកចិត្ត ដៃគូ មក ពិនិត្យ និង ទទួល សេវា ព្យាបាល ទាំងអស់ គ្នា ។
៤៖ សូម បងប្អូន ជន រួម ជាតិ ទាំងអស់ ត្រូវ បន្ត ស្វែងយល់ ពី ការបង្ការ មេរោគ អេដស៍ និង ការពារ ខ្លួន កុំ ឱ្យ ឆ្លង មេរោគ អេដស៍ នេះ ជា ដាច់ខាត ជាពិសេស ក្មួយ ៗ ជា យុវជន យុវនារី ត្រូវ ប្រុងប្រយ័ត្ន និង ចងចាំ ថា ការការពារ គឺ ចាប់ផ្តើម ពី ខ្លួនអ្នក ផ្ទាល់ ។
៥៖ មិន ត្រូវ មាក់ងាយ និង រើសអើង អ្នក ផ្ទុក មេរោគ អេដស៍ និង អ្នកជំងឺ អេដស៍ ជាដាច់ខាត ហើយ ត្រូវ បង្កើត បរិយាកាស គាំទ្រ ដល់ ក្រុម ប្រឈម ខ្ពស់ នៅ គ្រប់ ទីកន្លែង ដើម្បី ទទួលបាន សេវា សុខភាព សេវា គាំពារ សង្គម និង ការការពារ ផ្លូវ ច្បាប់ ។
៦៖ សូម អ្នក ផ្ទុក មេរោគ អេដស៍ កុំ មាន ការ ខ្មាស អៀន និង រើសអើង ខ្លួន ឯង ហើយ ត្រូវ ប្រញាប់ រួសរាន់ ទៅ ទទួល ការប្រឹក្សា និង ការព្យាបាល ឱ្យ បាន ទាន់ ពេល វេលា ។
តាមរយៈ សារលិខិត មួយ នេះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន សង្ឃឹម យ៉ាង មុតមាំ ថា បងប្អូន ជន រួម ជាតិ ទាំងអស់ ពិតជា យល់ ច្បាស់ និង បន្ត ផ្សព្វផ្សាយ ទៅកាន់ សមាជិក គ្រួសារ បងប្អូន មិត្តភក្តិ និង សហគមន៍ ឱ្យ បាន កាន់តែ ទូលំទូលាយ ថែម ទៀត ៕
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចេញ សារលិខិត ក្នុង ឱកាស ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ១ធ្នូ ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ វេទិការភាព ជា អ្នកដឹកនាំ តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក ឆ្លើយតប មេរោគ អេដស៍ និង ជំងឺ អេដស៍ នៅ កម្ពុជា បាន ចេញ នូវ សារលិខិត ដើម្បី ចូលរួម ក្នុង ឱកាស ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ១ធ្នូ ឆ្នាំ ២០១៩ ក្រោម ប្រធានបទ « ទាំងអស់ គ្នា ចូលរួម ជា ចរន្ត ជាតិ មួយ ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ មេរោគ អេដស៍ និង ជំងឺ អេដស៍ » ។
ប្រធានបទ ដែល បាន កំណត់ ឡើង នេះ មាន គោលបំណង គូសបញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត ខ្ពស់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការបន្ត កិច្ច ខិតខំ ប្រឹងប្រែង ប្រកប ដោយ ឆន្ទៈ មោះ មុត ឈាន ទៅ សម្រេចបាន គោលដៅ បញ្ចប់ បញ្ហា អេដស៍ នៅ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ឆ្នាំ ២០២៥ ។
លើស ពី នេះ ទៅ ទៀត អត្រា ធ្វើតេស្ត ឈាម រក មេរោគ អេដស៍ ក្នុង ចំណោម ស្ត្រី មាន ផ្ទៃពោះ បាន កើនឡើង ខ្ពស់ អត្រា ចម្លង ពី ម្តាយ ដែល មាន ផ្ទុក មេរោគ អេដស៍ ទៅ កូន និង សន្ទស្សន៍ នៃ ការរើសអើង មើលងាយ អ្នក ផ្ទុក មេរោគ អេដស៍ អ្នកជំងឺ អេដស៍ មាន ការថយចុះ ខ្លាំង គួរ ជា ទី មោទនៈ ។
ក្នុង ឱកាស នោះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ផ្តល់ អនុសាសន៍ ដូចត ទៅ៖
១៖ សូម សាខា កាកបាទ ក្រហម កម្ពុជា យុវជន អ្នកស្ម័គ្រចិត្ត ពង្រឹង ពង្រីក សកម្មភាព ផ្សព្វផ្សាយ អប់រំ លើកកម្ពស់ ការយល់ដឹង ពី បញ្ហា អេដស៍ ឱ្យ បាន ដល់ សហគមន៍ ជនបទ និង ត្រូវ ផ្តល់ ការជួយ ឧបត្ថម្ភ គំាពារ ដល់ អ្នក ផ្ទុក មេរោគ អេដស៍ អ្នកជំងឺ អេដស៍ ។
សូម អាន សារលិខិត របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ទាំង ស្រុង៖
( ភ្នំពេញ ) ៖ អគ្គិភ័យ ឆេះ ផ្ទះ ស្តុក គ្រឿង អេឡិចត្រូនិក ក្នុង បុរី ពិភព ថ្មី សង្កាត់ ក្រាំង ធ្នង់ បណ្ដាលឲ្យ រង ការខូចខាត ទ្រព្យសម្បត្តិ មួយចំនួន និង បណ្ដាលឲ្យ បុរស ម្នាក់ រងរបួស ស្រាល ។
ប្រភព ព័ត៌មាន ពី កន្លែង កើត ហេតុ បាន ប្រាប់ ឲ្យដឹង ថា មុនពេល កើត ហេតុ គេ បាន លឺ សំឡេង ជនជាតិ បរទេស ម្នាក់ បាន ស្រែក ឲ្យ គេ ជួយ ខណៈ ដែល ផ្ទះ របស់ គាត់ ត្រូវបាន ភ្លើង ឆាបឆេះ ជាន់ ខាងក្រោម ហើយ ផ្ទះ របស់ គាត់ បាន ជាប់ សោ ។
ភ្លាម ៗ នោះ ប្រជាពលរដ្ឋ ដែល រស់ នៅ ក្បែរ នោះ បាន នាំគ្នា ជួយ វាយ កញ្ចក់ ទ្វារ ផ្ទះ ដើម្បី ជួយ យក បំពង់ ពន្លត់ អគ្គិភ័យ បាញ់ អន្តរាគមន៍ កុំ ឲ្យ មាន ការឆាបឆេះ ខ្លាំង ។ ចំណែកឯ ជនបទ ខាងលើ បាន លោត ចុះ ពីលើ ផ្ទះ ក៏ មុត កញ្ចក់ ទ្វារ រងរបួស ស្រាល ត្រូវបាន បញ្ជូន ទៅ សង្គ្រោះ ភ្លាម ៗ ហើយ ប្រជាពលរដ្ឋ បាន រាយការណ៍ ទៅ សមត្ថកិច្ច ប៉ុស្តិ៍ ដើម្បី ទាក់ទង ទៅ សមត្ថកិច្ច ជំនាញ បង្ការ និង ពន្លត់ អគ្គិភ័យ ឲ្យ ចេញមក ជួយ អន្តរាគមន៍ បាញ់ ទប់ស្កាត់ នៃ ការឆាបឆេះ ខាងលើ នេះ ផងដែរ ។
សូម បញ្ជាក់ ផងដែរ ថា អគ្គិភ័យ ដែល បាន ឆាបឆេះ ខាងលើ នេះ ត្រូវបាន រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន៦ គ្រឿង ចេញមក ជួយ អន្តរាគមន៍ បាញ់ ទឹក អស់ ជាច្រើន គ្រឿង ទើប អាច ទប់ស្កាត់ នៃ ការឆាបឆេះ មិន ឲ្យ រាលដាល ទៅ ផ្ទះ ជិតខាង ផងដែរ ។
ចំពោះ ករណី អគ្គិភ័យ ខាងលើ នេះ បាន បណ្ដាលឲ្យ បុរស ជនជាតិ បរទេស ម្នាក់ រងរបួស ស្រាល ដោយសារ មុត កញ្ចក់ ទ្វារ ផ្ទះ ត្រូវបាន ដឹក បញ្ជូន ទៅ សង្គ្រោះ នៅឯ មន្ទីរពេទ្យ ។ ដោយឡែក ទំហំ នៃ ការខូចខាត សមត្ថកិច្ច ជំនាញ នៅ មិន ទាន់ អាច បញ្ជាក់ ច្បាស់ នៅឡើយ នោះ ទេ ៕
អង់គ្លេស៖ មាន ករណី ចាក់ មនុស្ស មួយចំនួន ឲ្យ របួស នៅលើ ស្ពាន មួយ កន្លែង ក្នុង ទីក្រុង ឡុងដ៍
គួរ ជម្រាប ថា យ៉ាងណាមិញ វា មិន ច្បាស់ នោះ ទេ ថា មាន មនុស្ស ប៉ុន្មាន នាក់ ឲ្យ ប្រាកដ បាន រងរបួស ឬ មួយ មាន មនុស្ស បាត់បង់ជីវិត ដែរ ឬ យ៉ាងណា ក្នុង ករណី នេះ ៕
រដ្ឋបាល រាជធានី ភ្នំពេញ ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការបញ្ចៀស ចរាច ជា បណ្តោះអាសន្ន ក្នុង អំឡុង ពេល ប្រារព្ធ ពិធី អបអរសាទរ ខួប លើក ទី ៤១ នៃ កំណើត ស .ស .យ . ក
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការបញ្ចៀស ចរាច ជា បណ្តោះអាសន្ន ក្នុង អំឡុង ពេល ប្រារព្ធ ពិធី អបអរសាទរ ខួប លើក ទី ៤១ នៃ កំណើត សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) ដែល នឹង ប្រព្រឹត្តទៅ នៅ ព្រឹក ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ ស្តាត អូឡាំពិក និង វិមាន ឈ្នះ - ឈ្នះ ។
អាស្រ័យ ហេតុ នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ មេត្តា ជ្រាប និង បញ្ចៀស ការធ្វើដំណើរ ឆ្លងកាត់ តាម ទីតាំង ទាំង២ ខាងលើ តាម កាលបរិច្ឆេទ ដោយ អនុគ្រោះ ។ ផុត រយៈពេល ហាមឃាត់ បណ្តោះអាសន្ន នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង បើក ឱ្យ ធ្វើចរាចរ ជាធម្មតា វិញ ។
( ព្រះសីហនុ) ៖ នា រសៀល ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៩ នេះ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត បាន អនុញ្ញាតឲ្យ ប្រតិភូនគរបាល ខេត្ត យូណាន សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល ដឹកនាំ ដោយ លោក HU SHUIWANG ស្នងការ រង នគរបាល ខេត្ត យូណាន និង សហការី ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ។
ក្នុង ជំនួប នេះ ភាគី ទាំង ពីរ បាន ពិភាក្សា សំខាន់ ផ្តោត ទៅ លើ កិច្ចសហប្រតិបត្តិការ ផ្លាស់ប្តូរ បទពិសោធន៍ និង ព័ត៌មាន ក៏ ដូចជា ការបង្ការ បង្រ្កាប បទល្មើស ឧក្រិដ្ឋកម្ម ឆ្លង ដែន និង អំពើ ភេវរកម្ម ។ ជាពិសេស ការកសាង សមត្ថភាព នគរបាល ( បណ្តុះបណ្តាល ) សការណ៍ បង្រ្កាប និង ផ្លាស់ប្តូរ ព័ត៍មាន គ្នា និង គា្ន ។
លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ មានប្រសាសន៍ ថា ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ នឹង បន្ត កិច្ចសហប្រតិបត្តិការ ល្អ ជាមួយ កម្លាំង សមត្ថកិច្ច ចិន ក្នុង ការបង្ការ ទប់ស្កាត់ បទល្មើស ឧក្រិដ្ឋកម្ម និង ភេវរកម្ម ឆ្លង ដែន ជាពិសេស ការផ្លាស់ប្តូរ បទពិសោធន៍ និង ព័ត៌មាន នៃ ប្រទេស ទាំង ពីរ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន បន្ថែម ថា ស្នងការ នគ បាល ខេត្ត ព្រះសីហនុ ត្រៀមលក្ខណៈ ជានិច្ច ដើម្បី ទទួល នូវ សំណូមពរ រាល់ កិច្ចសហប្រតិបត្តិការ បង្ការ ទប់ស្កាត់ បទល្មើស ឧក្រិដ្ឋកម្ម និង ភេវរកម្ម ឆ្លង ដែន ជាពិសេស បទល្មើស សេដ្ឋកិច្ច ផងដែរ ដោយ ផ្អែក លើ ច្បាប់ ជា ចម្បង ៕
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ខិតខំ ធ្វើ យ៉ាងណា ឲ្យ ភ្នាក់ងារ សន្តិសុខ ឯកជន ទាំងអស់ មាន សមត្ថភាព ចំណេះដឹង វិជ្ជាជីវៈ ក្រមសីលធម៌
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សន្ដិសុខ ឯកជន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ល្ងាច ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន លើកឡើង ថា អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន និង កំពុង ខិតខំ ប្រឹងប្រែង ធ្វើ យ៉ាងណា ឲ្យ ភ្នាក់ងារ សន្ដិសុខ ឯកជន ទាំងអស់ មាន សមត្ថភាព ចំណេះដឹង វិជ្ជាជីវៈ ក្រមសីលធម៌ ពិតប្រាកដ ។
ក្នុង ពិធី បិទ វគ្គ បំប៉ន ជំនាញ ភ្នាក់ងារ សន្ដិសុខ ឯកជន លើក ទី២៤ លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី បាន លើកឡើង ថា វិស័យ សន្តិសុខ ឯកជន ក៏ ជា វិស័យ ដ៏ សំខាន់ មួយ ដែល ត្រូវ ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ក៏ ដូចជា ការពារ ផលប្រយោជន៍ ជាតិ និង ការអភិវឌ្ឍ ប្រទេសជាតិ ផងដែរ ។
ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សន្ដិសុខ ឯកជន រូប នេះ បាន គូសបញ្ជាក់ ថា កិច្ចការពារ សន្តិសុខ សុវត្ថិភាព សង្គម គឺជា ការតព្វកិច្ច របស់ យើង ទាំងអស់ គ្នា ដែល ត្រូវ រួមគ្នា បង្ការ ទប់ស្កាត់ និង បង្ក្រាប រាល់ បទល្មើស នានា តាម គ្រប់គ្រប់ រូបភាព ដើម្បី ភាព សុខសាន្ត របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ជាតិ និង អន្តរជាតិ ដែល កំពុង ស្ថិត នៅ ប្រទេស កម្ពុជា ។
បើ តាម លោក ឧត្តមសេនីយ៍ ឯក លឹម សុខា រស្មី ភ្នាក់ងារ សន្តិសុខ ឯកជន ពុំ មែន មាន តួនាទី ត្រឹមតែ ជា អ្នកការពារ ទ្រព្យសម្បត្តិ ឯកជន ឬ សហគ្រាស គ្រឹះស្ថាន ឯកជន ប៉ុណ្ណោះ ទេ តែ ក៏ មាន កាតព្វកិច្ច ចូលរួម ការពារ ទ្រព្យសម្បត្តិ សាធារណៈ សន្តិសុខ សង្គម និង អាយុជីវិត របស់ ប្រជាពលរដ្ឋ ផងដែរ ជាពិសេស មាន តួនាទី ជា កម្លាំង ជំនួយ ដ៏ សំខាន់ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច ។
រយៈពេល ២ ថ្ងៃ នេះ លោក ជឿជាក់ ថា សិក្ខាកាម ទាំងអស់ បាន ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ អស់ កម្លាំង កាយ ចិត្ត ហើយ ទទួលបាន ចំណេះដឹង ជាច្រើន ដើម្បី យក ទៅ បំពេញ តួនាទី របស់ ខ្លួន បម្រើ ផលប្រយោជន៍ សង្គមជាតិ ក្នុង ផ្លូវ វិជ្ជមាន ឲ្យបាន សមស្រប តាម ក្រម សិលធម៌ វិជ្ជាជីវៈ របស់ សន្តិសុខ ឯកជន និង អនុលោម ទៅតាម ច្បាប់ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ អ្នកនាំពាក្យ ខេត្ត កំពង់ឆ្នាំង សូម ចេញ សេចក្តី បំភ្លឺ ជុំវិញ ការចោទប្រកាន់ នេះ ដូច នៅក្នុង លិខិត ទាំង ស្រុង៖
ប្រធាន សមាគម សារ ការី ចិន ជួប ពិភាក្សា ការងារ ជាមួយ នាយក ខុទ្ទកាល័យ រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ លោក សន សោភ័ណ អនុ រដ្ឋលេខាធិការ និង ជា នាយក ខុទ្ទកាល័យ តំណាង លោក អង្គ វង្ស វឌ្ឍានា រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ បាន ទទួល ជួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ លោក HAO CHIYONG ប្រធាន សមាគម សារ ការី ប្រទេស ចិន និង ជា អនុប្រធាន គណៈកម្មការសារ ការី អន្ដរជាតិ ទទួលបន្ទុក កិច្ចការ អាស៊ាន ព្រមទាំង ប្រតិភូ ចិន ០៥ រូប ទៀត ក្នុង កិច្ច ដំណើរទស្សនកិច្ច រយៈពេល ៣ ថ្ងៃ នៅ ប្រទេស កម្ពុជា ។
