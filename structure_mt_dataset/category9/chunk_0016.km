( ភ្នំពេញ ) ៖ ចោរ ជនជាតិ ចិន ម្នាក់ ដែល តែងតែ ធ្វើ សកម្មភាព គាស់ ផ្ទះ ប្រជាពលរដ្ឋ នៅ តាម បុរី ធំ ៗ ក្នុង ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ ត្រូវ តំណាង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ លោក ផែង ហេង បាន បញ្ចប់ ការសួរនាំ និង សម្រេច ចោទប្រកាន់ ពី បទ « លួច មាន ស្ថាន ទម្ងន់ ទោស » ។
លោក គុជ គឹម ឡុង អ្នកនាំពាក្យ ស្ថាប័ន អយ្យការ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ថា បន្ទាប់ពី ព្រះរាជអាជ្ញា បញ្ចប់ ការសួរនាំ និង សម្រេច ចោទប្រកាន់ ហើយ នោះ សំណុំរឿង នេះ ត្រូវបាន បញ្ជូន បន្ដ ទៅ ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី បន្ដ នីតិវិធី ។
ជាមួយគ្នា នេះ ជនរងគ្រោះ ក៏ បាន អំពាវនាវ ដល់ ស្ថាប័ន តុលាការ មេត្តា ផ្ដន្ទាទោស ជនសង្ស័យ រូប នេះ ឲ្យបាន ធ្ងន់ធ្ងរ បំផុត ដើម្បីឲ្យ សាកសម នូវ អ្វី ដែល គេ បាន ប្រព្រឹត្ត កន្លងមក ព្រោះ ជនរងគ្រោះ ជាច្រើន នាក់ បាន បាត់ ទ្រព្យសម្បតិ្ដ ដោយសារ ចោរ រូ នេះ ។ បន្ថែម ពី នេះ ជនរងគ្រោះ ក៏ ស្នើ ដល់ តុលាការ និង សមត្ថកិច្ច ពាក់ព័ន្ធ បន្ដ ស្រាវជ្រាវ រក មេក្លោង និង រក ទីតាំង ដែល ជនសង្ស័យ រូប នេះ យក វត្ថុ មាន តម្លៃ របស់ ពួកគាត់ ទៅ លក់ ផងដែរ ក្រែង យក មកវិញ បាន ខ្លះ ។
សូម ជម្រាប ថា ជនជាតិ ចិន ម្នាក់ ធ្លាប់ ជាប់ ពន្ធនាគារ ក្នុង ប្រទេស របស់ ខ្លួន រយៈពេល ៣ ឆ្នាំ ពី បទ លួច ពេលនេះ ជាប់ ខ្នោះ កម្លាំង នគរបាល ខណ្ឌ ឫស្សីកែវ ក្រោយ លួច គាស់ ទ្ទារ ផ្ទះ លើក យក ទូរ ដែក ដែល មាន លុយ ដុល្លារ និង គ្រឿងអលង្ការ មួយចំនួន នៅ បុរី ប៉េង ហួត បឹង ស្នោរ ខណ្ឌ មានជ័យ ខណៈ ជនរងគ្រោះ មិន នៅ ផ្ទះ ។
ប្រតិបត្តិការ ចាប់ខ្លួន ជនសង្ស័យ ជនជាតិ ចិន រូប នេះ ធ្វើឡើង ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក វរសេនីយ៍ ទោ ហ៊ាង ថា រេត អធិការ ខណ្ឌ ឫស្សីកែវ នៅ យប់ ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ ក្នុង បូរី ប៉េង ហួត ផ្ទះ លេខ ២៥ ផ្លូវ លេខ P06 ក្រុម៤ ភូមិ ៤ សង្កាត់ ច្រាំង ចំរេះទី១ ខណ្ឌ ឫស្សីកែវ ខណៈ រូប គេ បម្រុង ធ្វើ សកម្មភាព នៅ ទីនេះ ។
លោក អធិការ រង បញ្ជាក់ ទៀត ថា បន្ទាប់ពី ឃាត់ខ្លួន ជនជាតិ ចិន ដែល ជាប់សង្ស័យ លួច គាស់ ទ្វារ ផ្ទះ ជនរងគ្រោះ លើក យក ទូរ ដែក ដែល មាន លុយ ដុល្លារ និង គ្រឿងអលង្ការ សរុប ជាង ៨ម៉ឺន ដុល្លារ នេះ ដើម្បី សាកសួរ ទៅ តាម ជំនាញ ប៉ុន្មាន ម៉ោង ក្រោយ គេ ( ជនសង្ស័យ ) បាន ឆ្លើយ សារភាព ថា ធ្លាប់ ជាប់ ពន្ធនាគារ រយៈពេល ៣ ឆ្នាំ នៅ ប្រទេស ចិន ពី បទ លួច ។
ដោយឡែក ជនរងគ្រោះ បាន ប្រាប់ សមត្ថកិច្ច ថា ចំពោះ សម្ភារ បាត់បង់ រួម មាន៖ ទូ ដែក១ មាន លុយ និង គ្រឿងអលង្ការ មួយចំនួន . ប្រាក់ ដុល្លារ ចំនួន ៤ម៉ឺន ដុល្លារ . សរុប ជាង ៨ម៉ឺន ដុល្លារ . ប្រាក់ រៀល ២លាន រៀល ប៉ុន្តែ ជាក់ស្ដែង ក្រោយពី ឃាត់ខ្លួន ជនជាតិ ចិន នេះ សមត្ថកិច្ច បាន រកឃើញ សម្ភារ មួយចំនួន ដែល ពាក់ព័ន្ធ សកម្មភាព ចោរកម្ម ដូច ជា៖ ឧបកណ៍ ផ្សា ដែក១ ( ប៉ុស្តិ៍ ផ្សារ ). ញ ញួ១. ព្រលៀក១. ស្រោម ដែ១ គូរ . និង កាបូប ២៕
ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ក្នុង ឆ្នាំ នេះ បាន ប្រព្រឹត្តទៅ ដោយ មាន កិច្ច ដំណើរការ យ៉ាង ល្អ ត្រចះត្រចង់ ក្រោម ព្រះរាជា ធិបតី ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ធ្វើឲ្យ ជន រួម ជាតិ យើង គ្រប់ ស្រទាប់ មាន សេចក្តី សោមនស្ស រីករាយ ដោយ ឥត ឧបមា ។
ចំពោះ លទ្ធផល នៃ ការព្យាករណ៍ ដំណើរ ទឹកភ្លៀង ២៥ រាជធានី - ខេត្ត នេះ ព្រះជ័យាធិបតី កង កេន បាគូ ព្រះបរម រាជ វាំង បាន ទូល ថ្វាយ និង ជម្រាប ជូន ដូច ខាងក្រោម៖
នៅក្នុង រាត្រី ដ៏ មនោរម្យ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ក្នុង ថ្ងៃទី ២នេះ គណៈកម្មាធិការ ជាតិ រៀបចំ បុណ្យ ជាតិ និង អន្តរជាតិ បាន ប្រារព្ធ ឡើង នូវ ការ បាញ់ កាំជ្រួច នៅក្នុង ដង ទន្លេ សាប ខាងមុខ ព្រះបរម រាជ វាំង ជា លើក ទី២ បន្ទាប់ពី ព្រះរាជ ពិធី សំរក់ ទៀន ដើម្បី អបអរសាទរ និង ញ៉ាំង ឲ្យ ព្រះរាជ ពិធី បុណ្យ តាម ប្រពៃណី ជាតិ និង តាម គន្លង ព្រះពុទ្ធ សាសនា ដ៏ ថ្កើងថ្កាន នៃ យើង កាន់តែ ទទួលបាន នូវ ភាព ដ៏ មហោឡារិក អធិកអធម ទ្វេ ឡើង ថែម ទៀត ។
តមក ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះបាទ សម្តេច ព្រះបរម នាថ ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត រួម ដង្ហែ ដោយ សម្តេច ព្រះអង្គម្ចាស់ លោក លោកស្រី ជា ព្រះរាជ វង្សានុវង្ស និង នាហ្មឺន សព្វ មុខ មន្ត្រី ព្រះបរម រាជ វាំង បាន យាង អញ្ជើញ សោយ និង អក អំបុក ទៅ តាម ប្រពៃណី ទំនៀមទំលាប់ ដ៏ ល្អ ផូរផង់ របស់ ប្រជាជាតិ ខ្មែរ យើង ៕
សិស្ស ប្រឡង ជាប់ និទ្ទេស A នៅ ខេត្ត ឧត្តរមានជ័យ ដែល មាន ជីវភាព ក្រីក្រ ទទួលបាន ផ្ទះ មួយ ខ្នង ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត
( ឧត្តរមានជ័យ )៖ ផ្ទះ មួយ ខ្នង ដែល ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ត្រូវបាន លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ នៅ រសៀល ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ចុះ ទៅ ប្រគល់ ជូន គ្រួសារ ក្រីក្រ រស់ នៅ ស្រុក ត្រពាំងប្រាសាទ ខេត្ត ឧត្តរមានជ័យ ដែល មាន កូន ប្រឡង ជាប់ និទ្ទេស A ។
នៅក្នុង ឱកាស នោះ លោក ប៉ែន កុសល្យ បាន នាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ជានិច្ច ជាកាល សម្តេច តែង គិតគូរ ជានិច្ច អំពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ពិសេស ប្រជាពលរដ្ឋ ក្រីក្រ និង ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ផ្សេង ៗ ។
លោក អភិបាល ខេត្ត ឧត្តរមានជ័យ ប៉ែន កុសល្យ បាន បញ្ជាក់ ថា ផ្ទះ នេះ ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្តល់ ជូន គ្រួសារ ក្រីក្រ ដែល កូន បាន ប្រឡង ជាប់ និទ្ទេស A ទូទាំង ខេត្ត ។ លោក បន្ត ថា នេះ ជា កិត្តិយស ណាស់ សម្រាប់ ខេត្ត ឧត្តរមានជ័យ ដែល ការប្រឡង មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ ២០១៨ - ២០១៩ នេះ មាន សិស្ស ប្រឡង ជាប់ និទ្ទេស A តែ ម្នាក់ គត់ ហើយ អ្វី ដែល គួរឲ្យ កោតសរសើរ នោះ គឺ ចេញ ពី គ្រួសារ ដែល មាន ជីវភាព ក្រីក្រ ទៀត ។
ព្រឹទ្ធសភា នឹង រៀបចំ កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ មាន របៀបវារៈ ចំនួន ៦
សេចក្តីជូនដំណឹង របស់ អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា បាន ឲ្យដឹង ថា របៀបវារៈ ចំនួន ៦ នោះ មាន ដូច ខាងក្រោម៖
១៖ ពិនិត្យ និង សម្រេច លើ សំណើ របស់ គណៈកម្មការ ទី៤ ព្រឹទ្ធសភា សុំ ដាក់ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ សន្ធិសញ្ញា បំពេញ បន្ថែម លើ សន្ធិសញ្ញា កំណត់ ព្រំដែន រដ្ឋ ឆ្នាំ ១៩៨៥ និង សន្ធិសញ្ញា បំពេញ បន្ថែម ឆ្នាំ ២០០៥ រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សាធារណរដ្ឋ សង្គម និយម វៀតណាម ទៅក្នុង របៀបវារៈ នៃ សម័យ ប្រជុំ លើក ទី៤ ព្រឹទ្ធសភា នីតិកាល ទី៤ ។
២៖ ពិនិត្យ និង សម្រេច លើ សំណើ របស់ គណៈកម្មការ ទី២ព្រឹទ្ធសភា សុំ ដាក់ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង រវាង រាជ រដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង រដ្ឋាភិបាល នៃ តំបន់ រដ្ឋបាល ពិសេស ហុងកុង នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ស្តីពី ការចៀសវាង ការយក ពន្ធ ត្រួត គ្នា និង ការបង្ការ ការកិបកេងបន្លំ ពន្ធ ពាក់ព័ន្ធ នឹង ពន្ធ លើ ប្រាក់ ចំណូល ទៅក្នុង របៀបវារៈ នៃ សម័យ ប្រជុំ លើក ទី៤ព្រឹទ្ធសភា នីតិកាល ទី៤ ។
៣៖ ពិនិត្យ និង សម្រេច លើ សំណើ របស់ គណៈកម្មការ ទី២ ព្រឹទ្ធសភា សុំ ដាក់ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ ពិធីសារ ទី២ ស្តីពី ការកំណត់ ច្រកទ្វារ ព្រំដែន ឆ្លងកាត់ នៃ កិច្ចព្រមព្រៀង ក្របខ័ណ្ឌ អាស៊ាន ស្តីពី កិច្ចសម្របសម្រួល ការដឹកជញ្ជូន ទំនិញ ឆ្លងកាត់ ទៅក្នុង របៀបវារៈ នៃ សម័យ ប្រជុំ លើក ទី៤ព្រឹទ្ធសភា នីតិកាល ទី៤ ។
៤៖ ពិនិត្យ និង សម្រេច លើ សំណើ របស់ គណៈកម្មការ ទី៩ព្រឹទ្ធសភា សុំ ដាក់ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង អាស៊ាន ស្តីពី ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក ទៅក្នុង របៀបវារៈ នៃ សម័យ ប្រជុំ លើក ទី៤ព្រឹទ្ធសភា នីតិកាល ទី៤ ។
៥៖ ពិនិត្យ និង សម្រេច លើ សំណើ របស់ គណៈកម្មការ ទី៣ព្រឹទ្ធសភា សុំ ដាក់ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម ឱ្យ ព្រះរាជាណាចក្រ កម្ពុជា ចូល ជា សមាជិក នៃ កិច្ចព្រមព្រៀង ក្របខ័ណ្ឌ ស្តីពី ការបង្កើត សម្ព័ន្ធភាព ថាមពល ព្រះអាទិត្យ អន្តរជាតិ ទៅក្នុង របៀបវារៈ នៃ សម័យ ប្រជុំ លើក ទី៤ព្រឹទ្ធសភា នីតិកាល ទី៤ ។
៦៖ កំណត់ របៀបវារៈ និង កាលបរិច្ឆេទ បន្ត សម័យ ប្រជុំ លើក ទី៤ព្រឹទ្ធសភា នីតិកាល ទី៤៕
អ្នក បាត់ដំបង នឹង ទទួលបាន ឱកាស ការងារ ជាច្រើន កន្លែង ពី ពិព័រណ៍ ការងារ និង ផលិតភាព នា ដើម ខែធ្នូ ឆ្នាំ ២០១៩ ខាងមុខ នេះ
( បាត់ដំបង ) ៖ ក្រុមហ៊ុន ធំ ៗ ចំនួន ៥០ បាន ប្រកាស ជ្រើសរើស បុគ្គលិក ជាច្រើន កន្លែង និង ច្រើន មុខតំណែង នៅក្នុង ពិព័រណ៍ ការងារ និង ផលិតភាព ខេត្ត បាត់ដំបង នា ថ្ងៃទី ០៦ - ០៧ ខែធ្នូ ឆ្នាំ ២០១៩ ខាងមុខ នេះ ចាប់ពី ម៉ោង ០៨៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១៨៖០០ នាទី ល្ងាច នៅក្នុង បរិវេណ វិទ្យាស្ថាន បច្ចេកវិទ្យា បាត់ដំបង តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៥ ភូមិ រំចេក ៤ សង្កាត់ រតនៈ ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ។
ពិព័រណ៍ ការងារ នេះ មាន រយៈពេល ២ ថ្ងៃ នេះ ត្រូវបាន រំពឹង ថា នឹង មាន អ្នកចូលរួម ទស្សនា ពី យុវជន សិស្ស និស្សិត និង អ្នក ស្វែងរក ការងារ ជាង ៤ពាន់ នាក់ ។ ក្រៅពី ទទួលបាន ឱកាស ការងារ តាមរយៈ ការដាក់ពាក្យ និង សម្ភាស ភ្លាម ៗ អ្នកចូលរួម ក៏ នឹង មាន ឱកាស ទទួលបាន ការណែនាំ អាជីព បទពិសោធន៍ ជំនាញ ទីផ្សារ ការងារ កំពុង ត្រូវការ និង ឱកាស បណ្តុះបណ្តាល គ្រប់ ប្រភេទ ទទួលបាន គំនិត ជំនាញ ចំណេះដឹង និង បទពិសោធន៍ ពី វា គ្មិន ល្បី ៗ ក្នុង សិក្ខាសាលា ផងដែរ ។
រយៈពេល ៣ ថ្ងៃ នេះ តាម ការណែនាំ របស់ លោក រដ្ឋមន្រ្តី ម៉ម ប៊ុន ហេង . ក្រសួង សុខាភិបាល បាន រៀបចំ ក្រុម គ្រូពេទ្យ សរុប ទាំងអស់ ១០៧៦ នាក់ ដើម្បី ផ្តល់ សេវា ពិនិត្យ និង ព្យាបាល ជំងឺ នៅ តាម ទីតាំង ដែល បាន កំណត់ ផង និង ចល័ត ក្នុង ហ្វូង ប្រជាជន ផង ដើម្បី បម្រើ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ ដែល មាន បញ្ហា សុខភាព តិចតួច ដែល បាន មក ដើរលេង កំសាន្ត សប្បាយ នៅក្នុង ព្រះរាជ ពិធី បុណ្យ និង ទស្សនា ការប្រណាំង ទូក ។
គួរ កត់សម្គាល់ ថា ក្រុម គ្រូពេទ្យ ការពារ សុខភាព ទាំងអស់ បាន ជួយ សង្រ្គោះ បន្ទាន់ ភ្លាម ៗ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន បញ្ហា សុខភាព រហូតដល់ ពួកគាត់ បាន ធូរស្បើយ ដោយ មិន មាន បញ្ហា ធ្ងន់ធ្ងរ អ្វី ឡើយ ហើយ ពួកគាត់ ក៏ បាន បន្ត ការដើរលេង កំសាន្ត បន្ត ទៀត រហូតដល់ ចប់ ព្រះរាជ ពិធី ប្រកបដោយ ក្តី សប្បាយរីករាយ ជា ទីបំផុត ។
ជាមួយ ការចូលរួម កម្មវិធី ខាងលើ ផងដែរ លោក បណ្ឌិត គីម ហ៊ាង បាន ចាត់ទុក នេះ គឺជា ឱកាស មួយ ដ៏ ល្អ សម្រាប់ ផ្សព្វផ្សាយ អំពី សក្ដានុពល នៃ វិស័យ អចលន ទ្រព្យ កម្ពុជា ការផ្សាភ្ជាប់ ទំនាក់ទំនង អន្ដរជាតិ និង ពង្រីក ទីផ្សារ កម្ពុជា ទៅកាន់ ពិភពលោក ។ លើស ពី នេះ លោក បាន បង្ហើប អំពី គោលបំណង និង ការប្ដេជ្ញាចិត្ត នឹង ខិតខំ នាំយក កម្មវិធី KW ASIA Summit នេះ មក ធ្វើ នៅ កម្ពុជា ឲ្យបាន នៅ ឆ្នាំ ២០២០ ទៀតផង ខណៈ ការរៀបចំ លើក ដំបូង នៅ អាស៊ី នេះ គឺ ផ្ដើម ចេញ ពី ការស្នើសុំ មុន គេ ដោយ រូប លោក ផ្ទាល់ ។
( ភ្នំពេញ ) ៖ បេឡា ជាតិ អតីត យុទ្ធជន នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ប្រាក់ របប សន្តិសុខ សង្គម ប្រចាំ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ សម្រាប់ ២សប្តាហ៍ លើក ទី១ ជូន អតីត យុទ្ធជន គ្រប់ ប្រភេទ និង គ្រួសារ អតីត យុទ្ធជន ចាប់ពី ម៉ោង ០២រសៀល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
យោង តាម សេចក្តីជូនដំណឹង របស់ បេឡា ជាតិ អតីត យុទ្ធជន ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន បញ្ជាក់ ថា « ប្រាក់ របប សន្តិសុខ សង្គម ប្រចាំ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ សម្រាប់ ២សប្តាហ៍ លើក ទី១ ជូន អតីត យុទ្ធជន គ្រប់ ប្រភេទ និង គ្រួសារ អតីត យុទ្ធជន ចាប់ពី ម៉ោង ០២រសៀល នា ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ត ទៅ » ។
ទណ្ឌិត សម រង្ស៉ី និង លោកស្រី មូរ សុខ ហួរ រួមទាំង បក្ខពួក បាន ប្រកាស ផ្តួលរំលំ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ដំណើរ មាតុភូមិ និវត្តន៍ របស់ លោក នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ដោយ ធ្វើ ចលនា ចេញ ពី ទឹកដី ថៃ ទម្លុះ ព្រំដែន ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ចូលមក កម្ពុជា ដើម្បី ទាមទារ ទម្លាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ចេញ ពី តំណែង ។
ភ្ញៀវ ជាតិ - អន្តរជាតិ ជិត ២ម៉ឺន នាក់ ទៅ កម្សាន្ត នៅ ខេត្ត រតនគិរី ក្នុង រយៈពេល ៣ ថ្ងៃ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
លោក ប្រធាន មន្ទីរ បាន បញ្ជាក់ ថា មាន កត្តា ៥យ៉ាង ដែល ធ្វើឲ្យ លំហូរ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ចូលមក កម្សាន្ត ក្នុង ខេត្ត រតនគិរី នា ឱកាស បុណ្យ ធំ ៗ៖
លោក ង៉ែត ពិទូ បញ្ជាក់ ឲ្យដឹង ទៀត ថា ពាក់ព័ន្ធ ម្ហូប អាហារ តាម រមណីយដ្ឋាន សណ្ឋាគារ ផ្ទះសំណាក់ លោក បាន ចាត់ ឲ្យ ក្រុមការងារ ចុះ អប់រំ ណែនាំ អំពី អនាម័យ និង មិន ឲ្យ មាន ការដំឡើង ថ្លៃ នោះ ទេ ។ ប៉ន្តែ លោក ក៏ ទទួលស្គាល់ ដែរ ថា មាន សេវាកម្ម ម្ហូប អាហារ សណ្ឋាគារ ផ្ទះសំណាក់ បាន ដំឡើង ថ្លៃ លើស ការកំណត់ របស់ មន្ទីរ បន្តិចបន្តួច ។
សម្តេច តេជោ ក៏ បាន ជូនពរ ឲ្យ ការធ្វើដំណើរ របស់ បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា កូនក្មួយ យុវជន និង កូនក្មួយ កម្មករ កម្មការ នី មាន សុខ សុវត្ថិភាព តាម ផ្លូវ ពេល វិលត្រឡប់ មកកាន់ លំនៅដ្ឋាន និង កន្លែង ធ្វើការរៀង ៗ ខ្លួន ។
សូម ជូនពរ ឲ្យ ការធ្វើដំណើរ របស់ បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា កូនក្មួយ យុវជន និង កូនក្មួយ កម្មករ កម្មការ នី មាន សុខ សុវត្ថិភាព តាម ផ្លូវ ពេល វិលត្រឡប់ មកកាន់ លំនៅដ្ឋាន និង កន្លែង ធ្វើការរៀង ៗ ខ្លួន របស់ កូនក្មួយ ទាំងអស់ គ្នា » ៕
ចៅ ចាក់ ស្មុក មិន មែន អ្នក សម្រេច ជំនួស ក្រុម នយោបាយ បែកបាក់ ទាំង២ ទេ ប៉ុន្តែ សូម ចូលរួម បង្ហាញ ទិដ្ឋភាព មួយចំនួន ជុំវិញ ការដណ្តើម គ្នា គ្រប់គ្រង កម្លាំង ប្រឆាំង នេះ ។
អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ ខ្លះ ក៏ បាន លើកឡើង ថា សម រង្ស៊ី ភូតកុហក ច្រើន ពេក និង ក្លាយជា អ្នកនយោបាយ គ្មាន តម្លៃ ដែល ត្រូវ លើក មក និយាយ ឡើយ ។ ប្រទេស នានា ក៏ មិន បាន និយាយ ពី ឈ្មោះ សម រង្ស៊ី ឡើយ ព្រោះ សកម្មភាព ទាំងឡាយ ដែល សម រង្ស៊ី និង ក្រុម ខ្លួន បាន ធ្វើ គឺជា សកម្មភាព ដែល ប្រឆាំង នឹង ច្បាប់ ។ ចុងក្រោយ នេះ សម រង្ស៊ី បាន ប្រកាស ធ្វើ រដ្ឋប្រហារ ទម្លាក់ រដ្ឋាភិបាល ស្រប ច្បាប់ និង ប្រមាថ ព្រះចេស្តា ព្រះមហាក្សត្រ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ពលរដ្ឋ ខ្មែរ ។
របាយការណ៍៖ ថ្ងៃទី ០៣ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក មាន ប្រពលរដ្ឋ កម្សាន្ត សប្បាយ ជិត ៣លាន នាក់ ខណៈ សន្តិសុខ សណ្តាប់ធ្នាប់ មាន ភាពល្អ ប្រសើរ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ បុណ្យ ជាតិ - អន្តរជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ត្រូវនឹង ថ្ងៃទី ០៣ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ មាន ប្រជាពលរដ្ឋ មក កម្សាន្ត សប្បាយ ជិត ៣លាន នាក់ ខណៈ សភាពការណ៍ សន្តិសុខ សណ្តាប់ធ្នាប់ មាន ភាពល្អ ប្រសើរ ។
របាយការណ៍ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ បុណ្យ ជាតិ - អន្តរជាតិ បាន កត់សម្គាល់ ថា៖
១៖ សភាពការណ៍ បទល្មើស ព្រហ្មទ ណ្ឌ៖ កើតឡើង ២លើក គឺ លួច ២លើក (A6. A4) បណ្តាលឲ្យ បាត់ ទឹកប្រាក់ ចំនួន ៥០០ ដុល្លា អាមេរិក អត្តសញ្ញាណប័ណ្ណ ប័ណ្ណ បើកបរ និង ទូរស័ព្ទ ១គ្រឿង ។ ករណី ខាងលើ សមត្ថកិច្ច ឃាត់ខ្លួន ជនសង្ស័យ ១នាក់ ដកហូត ទូរស័ព្ទ ១គ្រឿង និង បាន ប្រគល់ ជូន ម្ចាស់ វិញ (A4) ។
( ភ្នំពេញ ) ៖ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ប្រជាពលរដ្ឋ រាប់ ម៉ឺន នាក់ មក ពី គ្រប់ ទិសទី បាន និង កំពុង នាំគ្នា សម្រុក ដើរលេង កម្សាន្ដ យ៉ាង សប្បាយរីករាយ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែង ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល ត្រូវនឹង ថ្ងៃទី៣ នៃ ព្រះរាជ ពិធី ។ ប្រជាពលរដ្ឋ ម្នាក់ ៗ បាន បង្ហាញ នូវ ទឹកមុខ សប្បាយរីករាយ បន្ទាប់ពី ពួកគាត់ បាន ដើរលេង សប្បាយ ដោយ គ្មាន ការភ័យខ្លាច អ្វី ទាំងអស់ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៤ករណី និង ជួញដូរ ៤ករណី ឃាត់ខ្លួន ជនសង្ស័យ ១៧នាក់ ។
ព័ត៌មាន នេះ ខុសពី អ្វី ដែល លោក សម រង្ស៉ី បាន ផ្សព្វផ្សាយ ថា លោក ត្រូវបាន រដ្ឋសភា ម៉ាឡេស៊ី អញ្ជើញ ឱ្យ ចូលរួម ក្នុង កិច្ចពិភាក្សា មួយ នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ដើម្បី ស្តារ អ្វី ដែល ហៅ ថា លទ្ធិ ប្រជាធិបតេយ្យ នៅក្នុង ប្រទេស កម្ពុជា បន្ទាប់ពី លោក បាន ទៅដល់ ប្រទេស ម៉ាឡេស៊ី ។
មន្រ្តី ការទូត ដដែល រូប នោះ បាន បញ្ជាក់ ថា លោក សម រង្ស៉ី គ្រាន់តែ ត្រូវបាន តំណាងរាស្រ្ត ម្នាក់ របស់ ម៉ាឡេស៊ី អញ្ជើញ ទៅ ជួប ជា លក្ខណៈ បុគ្គល ប៉ុណ្ណោះ មិន ពាក់ព័ន្ធ នឹង រដ្ឋសភា ទាំងមូល របស់ ម៉ាឡេស៊ី នោះ ទេ ហើយ ការជជែក នោះ គឺ ធ្វើឡើង ក្នុង បន្ទប់ ផ្ទាល់ខ្លួន ក្នុង សភា ម៉ាឡេស៊ី របស់ តំណាងរាស្រ្ត រូប នោះ ប៉ុណ្ណោះ ។
ជាមួយ នោះ ដែរ ម ន្រ្តី ជាន់ ខ្ពស់ ក្រសួង ការបរទេស កម្ពុជា ក៏ បាន បញ្ជាក់ បន្ថែម ថា ដោយឡែក ជំនួប របស់ រវាង លោក សម រង្ស៉ី ជាមួយ រដ្ឋមន្រ្តី ការបរទេស ម៉ាឡេស៊ី ក៏ មិន មែន ជា ជំនួប ក្នុង នាម រដ្ឋមន្រ្តី ការបរទេស ម៉ាឡេស៊ី នោះ ទេ គ្រាន់តែ ជា ជំនួប រវាង លោក សម រង្ស៉ី និង អគ្គ លេខាធិការ គណបក្ស របស់ លោក តែ ប៉ុណ្ណោះ ។
អ្នកវិភាគ មួយ រូប ក៏ បាន លើកឡើង ដែរ ថា បើ ក្នុង នាម រដ្ឋសភា របស់ ម៉ាឡេស៊ី អញ្ជើញ នោះ គឺ មាន តែ ប្រធាន សភា របស់ ម៉ាឡេស៊ី ជា អ្នក ចេញ លិខិត អញ្ជើញ លោក សម រង្ស៉ី មិន មែន តំណាងរាស្រ្ត ណាមួយ អញ្ជើញ នោះ ទេ ។
បរិស្ថាន ស្អាត ក្នុង រយៈពេល ២ ថ្ងៃ កន្លងមក នេះ ដោយសារតែ មាន ក្រុម អ្នក សម្អាត អនាម័យ បរិស្ថាន ផ្ទាល់ សកម្ម ខ្លាំង មាន ក្រុម យុវជន ស្ម័គ្រចិត្ត ជាច្រើន ចូលរួម និង ការកែប្រែ ឥរិយាបថ របស់ ប្រជាពលរដ្ឋ ទុកដាក់ សំរាម បាន ត្រឹមត្រូវ ទុកដាក់ ក្នុង ធុង សំរាម ដែល បាន ដាក់ពង្រាយ នៅ តាម ទីតាំង នានា ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា៖ « សកម្មភាព របស់ ប្អូន នឹង បន្សល់ទុក នូវ ការចងចាំ សម្រាប់ ពលរដ្ឋ ខ្មែរ បាន បន្សល់ នូវ ការគោរព ស្រឡាញ់ បរិស្ថាន ក្នុង ក្រអៅបេះដូង របស់ មនុស្ស រាប់ ម៉ឺន សែន នាក់ ដែល បាន ឃើញ ប្អូន ៗ សម្អាត អនាម័យ បរិស្ថាន នៅក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទីប និង សំពះ ព្រះខែ អក អំបុក » ។
សាលា រាជធានី ភ្នំពេញ ក៏ បាន ដាក់ពង្រាយ ធុង សំ រាម និង កញ្ឆេរ ជាង ២០០០ នៅក្នុង តំបន់ ប្រារព្ធ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដើម្បី បង្ក ភាពងាយស្រួល ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទុកដាក់ សំរាម របស់ ខ្លួន ។
លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន ថ្លែង ថា ដើម្បី កុំ ឱ្យ សំរាម កកស្ទះ ក្រុម យុវជន ស្ម័គ្រចិត្ត មួយចំនួន បាន ដើរ បារ សំរាម ពី ធុង និង វេច ខ្ទប់ទុកដាក់ ត្រឹមត្រូវ ដើម្បី ងាយស្រួល ក្នុង ការប្រមូល សំរាម ។
ជាមួយគ្នា នេះ លោក នេត្រ ភក្ត្រា បាន លើកទឹកចិត្ត ក្រុម យុវជន បន្ត កិច្ច ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត ដើម្បី បញ្ជ្រាប ចំណេះដឹង អំពី បរិស្ថាន ជាពិសស ការគ្រប់គ្រង សំណល់ សំរាម ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មក ដើរកម្សាន្ត ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ។ រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន ក៏ បាន ជំរុញ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ ដែល ចូលរួម ទស្សនា ព្រះរាជ ពិធី បុណ្យ អុំ ទូក សូម ទុកដាក់ សំរាម របស់ ខ្លួន ឱ្យ បាន ត្រឹមត្រូវ កុំ បោះ សំរាម ពាសវាលពាសកាល គឺ ត្រូវ ដាក់ ក្នុង ធុង សំរាម ៕
សម្តេច តេជោ ហ៊ុន សែន កំពុង អង្គុយ ទស្សនា ការប្រណាំង ទូក ថ្ងៃ ចុងក្រោយ ប្រជាពលរដ្ឋ នៅមុខ ព្រះបរម រាជ វាំង
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន និង កំពុង អង្គុយ ទស្សនា ការប្រណាំង ទូក ថ្ងៃ ចុងក្រោយ ប្រជាពលរដ្ឋ នៅមុខ ព្រះបរម រាជ វាំង ។
នៅក្នុង ឱកាស នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ជូនពរ បងប្អូន ជន រួម ជាតិ ជួប តែ សេចក្តីសុខ និង បាន សប្បាយរីករាយ ក្នុង ថ្ងៃទី ៣ ដែល ជា ថ្ងៃ ចុងក្រោយ នៃ ពិធី បុណ្យ អុំ ទូក ទាំងអស់ គ្នា ផងដែរ ។
តាម ទំនៀមទម្លាប់ ខ្មែរ យើង ជារៀងរាល់ ឆ្នាំ នៅ រាត្រី ថ្ងៃទី២ នៃ ព្រះ រាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ តែងតែ រៀបចំ ព្រះរាជ ពិធី សម្រក់ ទៀន ជ័យ បួងសួង ព្យាករណ៍ អំពី ដំ ណើរ ទឹកភ្លៀង ទៅ តាម លក្ខណៈ ជំនឿ ប្រពៃណី ខ្មែរ បាន ទស្សន៍ទាយ ដោយ ការបន្តក់ ទៀន ពី ក្បាល ទៅ កន្ទុយ នាគ ដែល មាន តាំងពី បុរាណ កាល រៀង មក ដើម្បី ផ្សង ចង់ ដឹង អំពី ទឹកភ្លៀង នា ឆ្នាំ ខាងមុខ ។
តាម លទ្ធផល ពី ការផ្សង ប្រផ្នូល តាមរយៈ សម្រក់ ភ្លៀង ទៀន ជ័យ ដើម្បី ចង់ ដឹង នូវ ទឹកភ្លៀង ទូទាំង ២៥ ខេត្ត រាជធានី សម្រាប់ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៤ ត្រូវបាន ព្រះជា យា ធិបតី កង កេន បាគូ ព្រះបរម រាជ វាំង បាន ទូល ថ្វាយ និង ជំរាប ជូន ថា៖
( ភ្នំពេញ ) ៖ អតីត សកម្ម និង ជា អតីត សមាជិក ក្រុមប្រឹក្សា សង្កាត់ កន្ទោក ខណ្ឌ កំបូល រាជធានី ភ្នំពេញ របស់ អតីត គណបក្ស សង្គ្រោះ ជាតិ លោក សួង គូរ នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ប្រកាស ឈប់ គាំទ្រ គណបក្ស ខ្មោច មួយ នេះ និង ប្រកាស សុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដោយសារ គាត់ ដឹង ពី សណ្ដាន អាក្រក់ របស់ ទណ្ឌិត សម រង្ស៉ី ដែល បន្ដ បោកប្រាស់ មិន វិល ចូល ស្រុក ខ្មែរ តាម ការសន្យា ។
លោក សួង គូរ បាន លើកឡើង ថា ដោយ មើលឃើញ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ជា អ្នកស្រឡាញ់ ជាតិ ស្រឡាញ់ ប្រជាជនពិតប្រាកដ និង បាន ខិតខំ ដឹកនាំ ប្រទេស ពី បាត ដៃ ទទេ រហូត ប្រទេស មាន សន្តិភាព ពេញលេញ មាន ការអភិវឌ្ឍ រីកចម្រើន ជា បន្តបន្ទាប់ ជាពិសេស ទាក់ទាញ វិនិយោគ ពី បរទេស បង្កើត និង បង្កើន ការងារ ជូន ប្រជាពលរដ្ឋ កម្ពុជា ទើប សម្រេច សុំ ចូលរួម ជីវភាព នយោបាយ ជាមួយ តែម្ដង ។
លោក ក៏ បាន អំពាវនាវ ដល់ សកម្មជន អតីត គណបក្ស សង្គ្រោះ ជាតិ ផ្សេង ៗ ទៀត ឈប់ ចាញ់បោក ពួក ឧទ្ទាម សម រង្ស៊ី និង សូម មក ចូលរួម រស់ និង គាំទ្រ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការ ដើម្បី ចូលរួម ថែរក្សា សន្តិភាព និង បន្ត ការអភិវឌ្ឍ ប្រទេស ឲ្យ កាន់តែ រីកចម្រើន ជា បន្តបន្ទាប់ ទៀត ។
លោក មុត ចន្ថា បាន បញ្ជាក់ ដូច្នេះ ថា៖ « ជំនួប នេះ មិន ខុស អ្វី ពី ជំនួប មុន ៗ ទេ ឯកឧត្តម អគ្គ រដ្ឋទូត គាត់ បាន មក សម្តែង ការសួរសុខទុក្ខ ក៏ ដូចជា ពិភាក្សា អំពី បញ្ហា សុខភាព ព្រោះ បង ប្អូន ឃើញ ហើយ នៅក្នុង សេចក្តីសម្រេច របស់ តុលាការ ការបន្ធូរបន្ថយ លក្ខខណ្ឌ ចំពោះ ការដាក់ ឱ្យ ស្ថិត នៅក្រោម ការត្រួតពិនិត្យ របស់ តុលាការ ហ្នឹង គឺ ផ្អែក លើ បញ្ហា សុខភាព » ។
លោក មុត ចន្ថា បាន បន្ត ទៀត ថា ក្រៅពី នោះ នៅក្នុង ជំនួប ក៏ មាន ការជជែក អំពី បញ្ហា ប្រជាធិបតេយ្យ នៅក្នុង ប្រទេស កម្ពុជា ។ លោក អះអាង ថា៖ « ហើយក៏ បាន ជជែកគ្នា អំពី បញ្ហា ប្រជាធិបតេយ្យ នៅ ប្រទេស កម្ពុជា រួមគ្នា កសាង ប្រជាធិបតេយ្យ ទៅ មុខ ទៀត និង ផលប្រយោជន៍ សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ ទូទៅ » ។
លោក បន្ត ថា លោក អគ្គ រដ្ឋទូត បាន រំលេច ប្រាប់ លោក កឹម សុខា អំពី សេចក្តីថ្លែងការណ៍ របស់ អឺរ៉ុប កាលពី ម្សិលមិញ ។ ជំនួប នោះ មិន មាន ជជែក ពាក់ព័ន្ធ នឹង លោក សម រង្ស៉ី នោះ ទេ ។
សូម បញ្ជាក់ ថា លោក កឹម សុខា កាលពី ថ្ងៃទី ១០ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ត្រូវបាន សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច ដាក់ ឲ្យ ស្ថិត ក្រោម ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ដដែល ប៉ុន្តែ ទទួលបាន ការបន្ធូរបន្ថយ លក្ខខណ្ឌ ត្រួតពិនិត្យ មួយចំនួន ។ លក្ខខណ្ឌ ថ្មី នេះ រួម មាន៖ ១៖ មិន ត្រូវ ចេញ ក្រៅ ព្រំប្រទល់ ដែនដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ ២៖ មិន ត្រូវ ធ្វើ សកម្មភាព នយោបាយ និង ៣៖ ត្រូវ ឆ្លើយតប នឹង ការកោះហៅ ពី គ្រប់ សមត្ថកិច្ច ។
នៅ ពេលព្រឹត្តិការណ៍ ខាង លើ នេះ កើតឡើង ភព ពុធ បាន បង្ហាញ ខ្លួន ក្នុង ទម្រង់ ជា ចំណុច ខ្មៅ ដ៏ តូចឆ្មា មួយ ដែល ស្មើនឹង ០.៥ ភាគរយ នៃ អង្កត់ផ្ចិត របស់ ព្រះអាទិត្យ ប៉ុណ្ណោះ ហើយ ក្រុម អ្នក អង្កេត ផ្ទៃ មេឃ បាន ប្រើប្រាស់ កែវយឺត ដែល មាន កម្លាំង ពង្រីក យ៉ាងហោចណាស់ 50x ទើប អាច ផ្តិច យក រូបភាព ឬ មើលឃើញ វា ច្បាស់ ប្រកបដោយ ការអត់ធ្មត់ បំផុត ព្រោះ ពួកគេ ត្រូវ ថត បញ្ច្រាស ពន្លឺ ព្រះអាទិត្យ ដ៏ ក្តៅ ។
គួរ ជម្រាប ថា នៅ ថ្ងៃចន្ទ សប្តាហ៍ នេះ ភព ពុធ បាន ចំណាយ ពេល ជិត ៥ ម៉ោង កន្លះ ដើម្បី គោចរ ពី គែម ម្ខាង ទៅ គែម ម្ខាង ទៀត នៃ ព្រះអាទិត្យ ខណៈ ព្រឹត្តិការណ៍ នេះ ប្រជាជន នៅ តំបន់ ទ្វីប អាមេរិក អឺរ៉ុប អាហ្រ្វិក អាស៊ី ខាងលិច និង នូវែលសេឡង់ អាច មើលឃើញ នៅពេល អាកាសធាតុ ល្អ ប្រសើរ ( មេឃ ស្រឡះ ) ប៉ុន្តែ ប្រទេស អូស្រ្តាលី និង អាស៊ី ខាងកើត ដែល រួម មាន ទាំង កម្ពុជា យើង ដែរ នោះ គឺ មិន អាច មើលឃើញ ឡើយ ៕
( ភ្នំពេញ ) ៖ មុខ សញ្ញា ចោរ លួច រថយន្ដ ជនជាតិ វៀតណាម ម្នាក់ ត្រូវ កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បើក ប្រតិបត្តិការ បង្ក្រាប បាន ក្រោយ រូប គេ បាន ធ្វើ សកម្មភាព លួច រថយន្ដ Prius មួយ គ្រឿង នៅ ភូមិ ស្វាយប៉ាក សង្កាត់ ច្រាំង ចំរេះ១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។ ប្រតិបត្តិការ បង្ក្រាប នេះ ត្រូវបាន ធ្វើឡើង ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ ផ្លូវ ៣៧០ សង្កាត់ បឹងកេងកង១ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ ។
លោក វរសេនីយ៍ ឯក ជា វ វិបុល បាន អះអាង ថា ជនសង្ស័យ ដែល បង្ក្រាប បាន នេះ ជា មុខសញ្ញា គ្រោះថ្នាក់ បំផុត ដោយ រូប គេ មាន មុខរបរ ជាជាង សោ ហើយ មាន ទាំង ឧបករណ៍ គ្រប់គ្រាន់ ដើម្បី ប្រើប្រាស់ សម្រាប់ ធ្វើ សកម្មភាព ពិសេស ការលួច រថយន្ដ ស្មាត ឃី ។ បច្ចុប្បន្ន ជនសង្ស័យ សមត្ថកិច្ច ជំនាញ កំពុង កសាង សំណុំរឿង ដើម្បី បញ្ជូន ទៅ តុលាការ ផ្ដន្ទាទោស តាម ច្បាប់ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ដែល ជា ថ្ងៃ ចុងក្រោយ នៃ ព្រះរាជ បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក បាន អំពាវនាវ ដល់ បងប្អូន ជន រួម ជាតិ ខ្មែរ សូមអញ្ជើញ មក លេង កម្សាន្ត សប្បាយ ឲ្យបាន ច្រើន កុះករ កុំ ជឿ លើ ពាក្យ ចចាមអារាម និង ពាក្យ ប្រឌិត បំពុល សង្គម ដែល បង្កើតឡើង ដោយ ជន អគតិ មួយចំនួន ដោយ រាជ រដ្ឋាភិបាល សូម ធានា ជូន នូវ សន្តិសុខ មិន ឲ្យ មាន អ្វី កើតឡើង ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន ចាត់ទុក ការបំប៉ោង ព័ត៌មាន ពី បញ្ហា សន្តិសុខ របស់ ក្រុម បំពុល សង្គម មួយ ចំនួន តូច គឺជា បំណង មិន ចង់ ឃើញ ពី ការរីកចម្រើន របស់ ប្រទេសជាតិ ។ ជាមួយ សគ្នា នេះ សម្តេច តេជោ ក៏ បាន ជូន ពរ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ជួប តែ សេចក្តីសុខ និង បាន សប្បាយរីករាយ នៅក្នុង ថ្ងៃ ចុងក្រោយ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ថ្ងៃ នេះ ។
សូម ជម្រាប ថា ក្នុង រយៈពេល ២ ថ្ងៃ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក នៅ រាជធានី ភ្នំពេញ មាន ប្រជាពលរដ្ឋ រាប់ ម៉ឺន នាក់ មក ពី គ្រប់ ទិសទី បាន នាំគ្នា ដើរលេង កម្សាន្ដ យ៉ាង សប្បាយរីករាយ ខណៈ បញ្ហា សន្ដិសុខ សណ្ដាប់ធ្នាប់ ត្រូវបាន ធានា បាន យ៉ាង ល្អ ប្រសើរ គ្មាន បាតុភាព ណាមួយ កើតឡើង នោះ ទេ ៕
លោក កឹម សុខា បន្ត ជួប អគ្គ រដ្ឋទូត អាល្លឺម៉ង់ និង អូស្រ្តាលី នៅ ថ្ងៃ នេះ
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បាន ជួប អគ្គ រដ្ឋទូត បារាំង និង អាមេរិក កាលពី ម្សិលមិញ នោះ នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ លោក កឹម សុខា អតីត ប្រធាន គណបក្ស សង្រ្គោះ ជាតិ បាន បន្ត ទទួល ជួប ឯក អគ្គ រដ្ឋទូត សហព័ន្ធ អាល្លឺម៉ង់ និង ឯក អគ្គ រាជ ទូត អូស្រ្តាលី ប្រចាំ ប្រទេស កម្ពុជា ។ នេះ បើ តាម ការប្រកាស របស់ លោក មុត ចន្ថា នាយក ខុទ្ទកាល័យ លោក កឹម សុខា ។
ជំនួប ទាំង២ នេះ ធ្វើឡើង នៅ គេហដ្ឋាន លោក កឹម សុខា ស្ថិត នៅ សង្កាត់ បឹងកក់២ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ក្នុង នោះ ជួប ជាមួយ ឯក អគ្គ រដ្ឋទូត សហព័ន្ធ អាល្លឺម៉ង់ នៅ ម៉ោង ០៩:៣០ ព្រឹក និង ជួប ជាមួយ ឯក អគ្គ រាជ ទូត អូស្រ្តាលី នៅ ម៉ោង ១៖៣០ នាទី រសៀល ។
ក្នុង ជំនួប ជាមួយ អគ្គ រដ្ឋទូត បារាំង និង អគ្គ រដ្ឋទូត អាមេរិក កាលពី ម្សិលមិញ ភាគី ទាំងអស់ បាន ចែករំលែក បទពិសោធន៍ និង សួរសុខទុក្ខ គ្នា ទៅ វិញ ទៅមក ដោយ មិន បាន ពិភាក្សា អំពី បញ្ហា នយោបាយ នោះ ឡើយ ៕
នៅ ថ្ងៃអង្គារ នេះ ដែរ អាជ្ញាធរ ឧតុនិយម របស់ អូស្ត្រាលី បាន ប្រកាស សីតុណ្ហភាព ជា មធ្យម បាន កើនឡើង ដល់ ៣៥ អង្សា សេ ហើយ បូករួមទាំង ខ្យល់ ក្តៅ និង ស្ងួត ផង នោះ វា បាន និង កំពុង ធ្វើឲ្យ ស្ថានភាព ភ្លើង ឆេះ ព្រៃ កាន់តែ រីករាលដាល នៅ ទូទាំង រដ្ឋ ដែល ព័ទ្ធ ជុំវិញ ទីក្រុង ស៊ីដនី មួយ នេះ ។
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កំពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ១២ ខែវិច្ឆិកា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
ជាមួយនឹង ការប្រារព្ធ ពិធី នេះ គេ សង្កេតឃើញ មាន ការពង្រាយ កម្លាំង សមត្ថកិច្ច ជាច្រើន នាក់ ដើម្បី រឹត បណ្តឹង សន្តិសុខ និង សុវត្ថិភាព ជូន បងប្អូន ប្រជាពលរដ្ឋ ព្រមទាំង ភ្ញៀវ ទេសចរណ៍ ដែល បាន មក ចូលរួម ទស្សនា ការប្រគុំត ន្រ្តី រាំ លេង កម្សាន្ត ការតាំងពិព័រណ៌ ផលិតផល ការបាញ់ កាំជ្រូច ការបង្ហោះ គោ ម ដើម្បី ចូល រួម អបអរ សា ទរ និង បង្កើ ន ភាពសប្បាយរីករាយ ឱ្យ កាន់តែ មាន ភាពអធិកអធម បន្ថែម ទៀត ។
លោក អាចារ្យ បាន បន្ថែម ថា ខេត្ត ពោធិ៍សាត់ ពិតជា មាន ភ័ព្វសំណាង ណាស់ ដែល មាន អភិបាល ខេត្ត យកចិត្តទុកដាក់ គិតគូរ ពី ទំនៀមទម្លាប់ ប្រពៃណី វប្បធម៌ និង សិល្បៈ រៀបចំ ពិធី ផ្សេង ៗ ឡើង ជាក់ស្តែង ដូចជា ពិធី ប្រណាំង ទូក ខ្នាត អន្តរជាតិ ដែល ពុំ ធ្លាប់ មាន ទាល់តែសោះ ក្នុង ទឹកដី ខេត្ត ពោធិ៍សាត់ ហើយ ទើបតែ ប្រារព្ធ ធ្វើ ជា លើក ទី២ កាលពី ថ្ងៃទី ០៧ - ០៨ ខែវិច្ឆិកា កន្លងទៅ នៅ តាម ដងស្ទឹង ពោធិ៍សាត់ ទល់ មុខ ផ្លូវ ចូល វត្ត ពាល ញែក ផ្លូវ លេខ ១០១ ដោយ មាន ទូក ចូលរួម ប្រគួត ចំនួន ៣១ ទូក ស្នើ នឹង ១៥គូ ។
សូម បញ្ជាក់ ថា ថ្ងៃ បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក នៅលើ កោះ សំពៅ មាស នា ពេលនេះ ក៏ មាន រៀបចំ គ្រឿង រន្តាប់ បុស បុក ទៅ តាម ទម្លាប់ ព្រះពុទ្ធ សាសនា និង ព្រហ្មញ សាសនា ព្រមទាំង មាន ជូន ភ្ជាប់ ទស្សនីយភាព របាំ ជូនពរ និង របាំ ក្ងោក ពោធិ៍សាត់ ដែល ជា ទំនៀមរាំ លេង ថ្វាយ អ្នកតា ព្រៃ ភ្នំ របស់ អ្នកស្រុក ជនជាតិ ព័រ ស្រុក ភ្នំ ក្រវាញ តំបន់ ក្សេត្រ បូរី ជូន ប្រជាពលរដ្ឋ ទស្សនា ដើម្បី អបអរ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ផងដែរ ៕
សូម កុំ ប្រើប្រាស់ ទូរស័ព្ទ ពេល កំពុង បើកបរ ! ស្លាប់ ម្នាក់ និង របួស ៣២ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១១ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ម្នាក់ . របួស ស្រាល ១៤នាក់ និង របួស ធ្ងន់ ១៨ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . ប្រជែង និង មិន គោរព សិទ្ធិ ៕
