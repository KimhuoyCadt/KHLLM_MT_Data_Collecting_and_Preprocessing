( ភ្នំពេញ ) ៖ ម៉ូតូ ថ្មី ចំនួន ៤គ្រឿង ទៀត ជា អំណោយ របស់ លោក ហែម ដារិទ្ធ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ សម្រាប់ លើកទឹកចិត្ត ដល់ ប្អូន ៗ សិស្សានុសិស្ស ដែល ប្រឡង ជាប់ សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ និទ្ទេស A ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ ត្រូវបាន ប្រគល់ ជូន សិស្សានុសិស្ស ចំនួន ៤នាក់ នៅ វិទ្យាល័យ ចំណេះ ទូទៅ និង បច្ចេកទេស ហ៊ុន សែន ជម្ពូវ័ន ក្នុង ឱកាស ប្រារព្ធ ពិធី បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ២០១៩ - ២០២០ នា ព្រឹក ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។
ក្នុង ឱកាស នោះ លោក ហែម ដារិទ្ធ បាន លើកឡើង ថា នេះ ជា ការឆ្លើយតប នឹង ការសន្យា របស់ លោក ចំពោះ សិស្សានុសិស្ស នៅក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ ទៅនឹង ការប្រឹងប្រែង ខិតខំ រៀនសូត្រ របស់ ប្អូន ៗ រហូត ទទួលបាន លទ្ធផល និទ្ទេស A ក្នុង ពេល បញ្ចប់ ការសិក្សា មធ្យមសិក្សា ទុតិយភូមិ ប្រចាំ ឆ្នាំ ។
លោក ហែម ដារិទ្ធិ បាន បញ្ជាក់ ថា ម៉ូតូ ទាំងនេះ មិន មែន ជា ថវិកា របស់ លោក តែ ម្នាក់ឯង នោះ ទេ គឺ បាន មក ពី ការចូលរួម ពី មិត្តភ័ក្ត្រ និង សប្បុរសជន ដែល ជា អ្នក មាន ធនធាន កំពុង រកស៊ី ក្នុង មូលដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ ដែល ឆ្នាំ នេះ ចំណាយ ម៉ូតូ ២០ គ្រឿង ក្នុង នោះ ៤គ្រឿង ផ្តល់ ជូន សិស្សានុសិស្ស ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ . ៤គ្រឿង ទៀត ផ្តល់ ជូន ប្អូន ៗ នៅ វិទ្យាល័យ ហ៊ុន សែន ជម្ពូវ័ន និង ក្រៅពី នេះ ជួយ ទៅ សិស្សានុសិស្ស នៅ ខេត្ត ព្រៃវែង ។
ក្នុង ឱកាស នោះ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ចែក សម្ភារ សិក្សា មាន សៀវភៅ ប៊ិច ដល់ ប្អូន ៗ ដែល រៀន បាន លេខ ១ ដល់ លេខ ៣ នា ឆ្នាំ កន្លងមក និង ឧបត្តម្ភ ថវិកា ១០លាន រៀល សំរាប់ ដំណើរកសាន្ត របស់ លោកគ្រូ - អ្នកគ្រូ ទៅកាន់ ខេត្ត ជាយ ដែន ផងដែរ ៕
អាវុធហត្ថ រាជធានី ភ្នំពេញ បញ្ជូន បុរស ម្នាក់ ទៅ តុលាការ ក្រោយ ចាប់ខ្លួន ពាក់ព័ន្ធ ការប្រើ ហិង្សា ដល់ អ្នកជិតខាង
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បញ្ជូន បុរស ម្នាក់ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ផ្តន្ទាទោស តាម ច្បាប់ លើ ករណី បង្ក ហិង្សា ដោយ យក ដុំ ថ្ម គប់ ទៅ លើ ផ្ទះ អ្នកជិតខាង បណ្តាលឲ្យ ខូចខាត សម្ភារ ។
មន្ដ្រី អាវុធហត្ថ បាន ឲ្យដឹង ថា ជន បង្ក ឈ្មោះ អំ វិសាល អាយុ ២០ ឆ្នាំ ត្រូវបាន សមត្ថកិច្ច ជំនាញ នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ឃាត់ខ្លួន កាលពី ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៩ នៅ ចំណុច ផ្ទះ លេខ ២២០ ផ្លូវ លំ ភូមិ ត្នោត សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ព្រោះតែ រូប គេ តែងតែ ប្រើ ហិង្សា រក រឿង អ្នកជិតខាង ព្រមទាំង យក ដុំ ថ្ម គប់ ទៅ លើ ផ្ទះ អ្នកជិតខាង បណ្តាលឲ្យ មាន ការខូចខាត បែក ទ្វារ កញ្ចក់ បង្អួច កញ្ចក់ និង បង្ក ជា ការភ័យខ្លាច ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅក្បែរ នោះ ។
គួរ ជម្រាប ថា វា គឺជា ការធ្វើតេស្ត មីស៊ីល លើក ទី ១២ហើយ របស់ កូរ៉េ ខាងជើង នៅក្នុង ឆ្នាំ ២០១៩ នេះ ខណៈ កាលពី កំឡុង ដើម ខែតុលា កន្លងទៅ ទីក្រុង ព្យុងយ៉ាង ទើបតែ បាន សម្រេច ជោគជ័យ ក្នុង ការធ្វើតេស្ត បាញ់ មីស៊ីល ផ្លោង ចេញ ពី នាវា មុជទឹក ៕
ម៉ាឡេស៊ី បើក យុទ្ធនាការ ផ្សព្វផ្សាយ ទេសចរណ៍ សុខាភិបាល ទាក់ទាញ អតិថិជន ឱ្យ ងាក មក ប្រើប្រាស់ សេវា ថែទាំ សុខភាព របស់ ខ្លួន
( ម៉ាឡេស៊ី ) ៖ ដើម្បី ទាក់ទាញ អ្នកជំងឺ ពី បណ្ដា ប្រទេស ជុំវិញ ពិភពលោក មក ទទួល សេវា សុខភាព នៅ ប្រទេស របស់ ខ្លួន រាជ រដ្ឋាភិបាល ម៉ាឡេស៊ី បាន អញ្ជើញ អ្នកសារព័ត៌ មកពី ប្រទេស ចិន អូស្ដ្រាលី បង់ក្លាដេស រួមទាំង តំបន់ អាស៊ាន ដែល មាន កម្ពុជា ផងដែរ នោះ សរុប ប្រមាណ ជាង ១០០ នាក់ ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ ពី កញ្ចប់ សេវាកម្ម សុខាភិបាល នៅ ប្រទេស ខ្លួន ។
ជាពិសេស ដោយ ផ្សារភ្ជាប់ ជាមួយនឹង គុណភាព សេវា និង ការថែទាំ អ្នកជំងឺ ដ៏ ល្អ បំផុត ជាមួយ កញ្ចប់ តម្លៃ សេវាកម្ម ទាប ជាង ប្រទេស ដទៃ ។ លើស ពី នោះ ធ្វើ យ៉ាងណា ឱ្យ អ្នកជំងឺ ទទួលបាន សុខភាពល្អ ប្រសើរ បន្ទាប់ពី ការពិនិត្យ ព្យាបាល ជាមួយនឹង ពេទ្យ របស់ ខ្លួន ។
ជាង នេះ ទៅ ទៀត លោកស្រី បាន ថ្លែង បន្ដ ថា « ក្នុង ឆ្នាំ ២០២០ ខាងមុខ នេះ យើង សង្ឃឹម យ៉ាង មុតមាំ ថា នឹង អាច ទាក់ទាញ អតិថិជន ពី បណ្ដា ប្រទេស មក ទទួល សេវា ពិនិត្យ ថែទាំ សុខភាព រហូតដល់ទៅ ៣០លាន នាក់ » បន្ទាប់ពី ទទួលបាន ជោគជ័យ ក្នុង ការផ្ដល់ សេវា ពិនិត្យ ព្យាបាល ជូន អ្នកជំងឺ ជាច្រើន ម៉ឺន នាក់ មកពី បណ្ដា ប្រទេស ក្នុង មួយ ឆ្នាំ ៗ ។
លើស ពី នោះ នៅ ដើម ឆ្នាំ ២០២០ ខាងមុខ នេះ MHTC នឹង ចុះ អនុស្សរណៈ យោគយល់ គ្នា ជាមួយ កម្ពុជា ដើម្បី ផ្ដល់ កញ្ចប់ សេវា សុខភាព ឱ្យ មាន ល្អ ប្រសើរ និង មាន ភាពងាយស្រួល ទាំង ការធ្វើដំណើរ ការស្នាក់ នៅ ក៏ ដូចជា បរិភោគ ជាដើម នឹង មាន តម្លៃ ធូរ ថ្លៃ ប្រកបដោយ គុណភាព ស្ដង់ដារ អន្ដរជាតិ បើ ធៀប ទៅនឹង នៅ ប្រទេស វៀតណាម ថៃ និង សិង្ហបុរី . ម៉ាឡេស៊ី មាន តម្លៃ ទាប ជាង ជិត ពាក់កណ្ដាល ឯណោះ ។
សូម ជម្រាប ថា ម៉ាឡេស៊ី បាន ផ្ដោត សារៈសំខាន់ ទៅ លើ ការពង្រីក និង ការអភិវឌ្ឍន៍ សេវា ថែទាំ សុខភាព ដោយ ប្រើប្រាស់ ៥% នៃ ថវិកា រដ្ឋ សម្រាប់ ការអភិវឌ្ឈន៍ សង្គម ក្នុង វិស័យ ថែទាំ សុខភាព សាធារណៈ ។ ដើម្បី ឆ្លើយតប នឹង កំណើន ប្រជាជន និង កំណើន ជន ចាស់ជរា រដ្ឋាភិបាល មាន គម្រោង អភិវឌ្ឈ ប្រព័ន្ឋ សុខាភិបាល តាមរយៈ ការ ជួសជុល កែលំអ មន្ទីរពេទ្យ ដែល មាន ស្រាប់ ស្ថាបនា និង បំពាក់ បរិក្ខារ សម្រាប់ មន្ទីរពេទ្យ ថ្មី ៗ បង្កើន ចំនួន ពហុ គ្លីនីក និង ការពង្រីក បណ្តាញ ផ្ដល់ សេវា សុខភាព ។
គួរ បញ្ជាក់ ថា អ្នក រងរបួស ជា ជនជាតិ កូរ៉េ ខាងត្បូង ដែល បាន ជិះ នៅលើ ទូក នេសាទ នោះ ត្រូវបាន គេ របាយការណ៍ ថា បាន ទទួលរង របួស និង ត្រូវបាន ទូក នេសាទ មួយ ដឹក ទៅកាន់ កោះ ដុក ដូ ដើម្បី រង់ចាំ ឧទ្ធម្ភាគចក្រ មក សង្គ្រោះ ។ ក្រសួង ការពារ ជាតិ កូរ៉េ ខាងត្បូង មិន ទាន់ បញ្ជាក់ ថា តើ មូលហេតុ អ្វី ដែល បាន បង្កឲ្យ ឧទ្ធម្ភាគចក្រ ខាងលើ នេះ ធ្លាក់ នោះ ឡើយ ប៉ុន្តែ យន្តហោះ យោធា និង ក្រុម អ្នកមុជទឹក ត្រូវបាន បញ្ជូន ទៅកាន់ ទីនោះ ហើយ ដើម្បី ស្វែងរក អ្នក បាត់ខ្លួន ។
រកឃើញ ប្រហិត ចំរុះ និង ចាហ៊ួយ ក្មេង ខូច គុណភាព ដាក់ លក់ តាម ស្តង់ តាំងពិព័រណ៌ ស្ថិត នៅ ក្រុង ស្ទឹងត្រែង . មន្រ្តី កាំ កុងត្រូល ដកហូត កំទេចចោល
( ស្ទឹងត្រែង ) ៖ ដើម្បី សុវត្ថិភាព ម្ហូប អាហារ ក៏ ដូចជា សុខភាព ប្រជាពលរដ្ឋ មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត ស្ទឹងត្រែង ដឹកនាំ ដោយ លោក គឹម ប្រុស ប្រធាន សាខា នៅ ថ្ងៃទី ១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង អាជ្ញាធរ រដ្ឋបាល ក្រុង ស្ទឹងត្រែង បាន ចុះ ត្រួតពិនិត្យ ទំនិញ តាម ស្តង់ តាំង ពិពណ៌ ស្ថិត នៅ ក្រុង ស្ទឹងត្រែង ក្នុង ឱកាស បុណ្យ អុំ ទូក ខេត្ត ស្ទឹងត្រែង រកឃើញ ប្រហិត ចំរុះ ខូច គុណភាព ចំនួន ១០គីឡូក្រាម និង ចាហ៊ួយ ក្មេង ខូច គុណភាព ចំនួន ៣kgs ដកហូត កំទេចចោល តែម្តង ។
លោក គឹម ប្រុស បាន ឱ្យដឹង ថា នៅក្នុង ប្រតិបត្តិការ ចុះអង្កេត ទំនិញ តាម ស្តង់ តាំង ពិពណ៌ ស្ថិត នៅ ក្រុង ស្ទឹងត្រែង ក្នុង ឱកាស បុណ្យ អុំ ទូក ខេត្ត ស្ទឹងត្រែង ខាងលើ រួច មក ក្រុមការងារ បាន រកឃើញ ប្រហិត ចំរុះ ខូច គុណភាព ចំនួន ១០គីឡូក្រាម និង ចាហ៊ួយ ក្មេង ខូច គុណភាព ចំនួន ៣kgs ក្រុមការងារ បាន ធ្វើ កំណត់ ដកហូត ដុត កម្ទេចចោល ភ្លាម ៗ ។
ជាមួយគ្នា នេះ ដែរ មន្រ្តី កាំ កុងត្រូល ក៏ បាន អំពាវនាវ ដល់ អាជីវករ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន និង យកចិត្តទុកដាក់ ឱ្យ បាន ម៉ត ចត់ មុននឹង ធ្វើចរាចរ ចែកចាយ លក់ដូរ និង ទិញ ទំនិញ ម្ហូប អាហារ ទទួលទាន ដោយ សុវត្ថិភាព មិន ប៉ះពាល់ សុខភាព អ្នកប្រើប្រាស់ ៕ លោក គីម រិទ្ធី ជំរុញ សិស្សសាលា ខិតខំ រៀនសូត្រ ដើម្បី ក្លាយជា ធនធាន មនុស្ស ជួយ អភិវឌ្ឍន៍ ប្រទេសជាតិ យើង
( កណ្ដាល ) ៖ លោក គីម រិទ្ធី អភិបាល រង ខេត្ត កណ្ដាល បាន លើកឡើង ថា ការអប់រំ ប្រកបដោយ ចីរភាព ពិតជា មាន សារៈសំខាន់ ដើម្បី ធានា ការផ្ដល់ សេវា អប់រំ ប្រកបដោយ គុណភាព និង បរិយាប័ន្ន ដែល ផ្ដល់ ឱកាស ស្មើ ៗ គ្នា ដល់ កុមារ និង យុវជន កម្ពុជា ទាំង ក្នុង ប្រព័ន្ធ និង ក្រៅ ប្រព័ន្ធ នៅ ទូទាំង ប្រទេស ។
លោក បាន ថ្លែង បែប នេះ នៅក្នុង ឱកាស បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី នៅ វិទ្យាល័យ ហ៊ុន សែន តា ខ្មៅ ខេត្ត កណ្ដាល នា ថ្ងៃទី ១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ ។
លោក បាន បន្ត ទៀត ថា ពេលនេះ រាជ រដ្ឋាភិបាល បាន និង កំពុង ខិតខំ ប្រឹងប្រែង ក្នុង ការអភិវឌ្ឍ សង្គម សេដ្ឋកិច្ច បន្ត ទៀត និង បាន ចាត់ទុក ការអភិវឌ្ឍ ធនធាន មនុស្ស គឺជា អាទិភាព ទី១ រួម ជាមួយនឹង ការប្ដេជ្ញា ឱ្យ បាន នូវ មុំ ទី១ គឺ ការពង្រឹង គុណភាព អប់រំ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា តាមរយៈ ការទាញយក ផលប្រយោជន៍ ពី ការអនុវត្តភាព នៅក្នុង តំបន់ និង អន្តរជាតិ ដើម្បី ធានា បាន កំណើន សេដ្ឋកិច្ច ខ្ពស់ ប្រកបដោយ ថីរភាព ។
គួរ ជម្រាប ថា បវេសនកាល ឆ្នាំ សិក្សា ២០១៩ - ២០២០ នៅ វិទ្យាល័យ ហ៊ុន សែន តា ខ្មៅ ថ្ងៃទី ១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ ទូទាំង ប្រទេស សំរាប់ សិស្ស គ្រប់ គ្រឹះស្ថាន គឺជា ថ្ងៃ ដែល សិស្ស ទាំងអស់ អបអរសាទរ ថ្ងៃ ចាប់ផ្ដើម ជីវិត សិក្សា ដំបូង របស់ កូន ក្មួយ ចៅ តូច ៗ ដែល ទើប គ្រប់ អាយុ ត្រូវ ចូល សាលារៀន និង ជា ថ្ងៃ ដែល ក្មួយ ៗ សិស្សានុសិស្ស និស្សិត របស់ យើង បន្ត ចូលរៀន សាលារៀន នៅ កម្រិត ថ្នាក់ ខ្ពស់ បន្ត ទៀត ក្នុង មនោសញ្ចេតនា រីករាយ កក់ក្ដៅ និង មោទនភាព បំផុត ។
ជាមួយគ្នា នេះ ដែរ នៅ វិទ្យាល័យ ហ៊ុន សែន តា ខ្មៅ ខេត្ត កណ្ដាល សិស្ស ជិត ២០០០ នាក់ បាន ជួបជុំ ប្រារព្ធ ពិធី បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី របស់ ខ្លួន ប្រកបដោយ ទឹកមុខ ញញឹម និង សង្ឃឹម ក្នុង ថ្ងៃ ថ្មី របស់ ខ្លួន ផងដែរ ៕ ប្រាសាក់ ផ្តល់ ឱកាស ការងារ ជាច្រើន មុខតំណែង ដល់ និស្សិត ក្នុង ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២ - ៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ប្រាសាក់ ដែល ជា គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ដ៏ ធំ ជាង គេ នៅ កម្ពុជា និង ជា និយោជក នៃ ជម្រើស នឹង ចូលរួម ក្នុង ព្រឹត្តិការណ៍ ពិព័រណ៍ ការងារ និង ផលិតភាពជាតិ ឆ្នាំ ២០១៩ នៅ មជ្ឈមណ្ឌល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ ចាប់ពី ម៉ោង ៨ព្រឹក រហូតដល់ ម៉ោង ៨យប់ ដើម្បី ចែករំលែក បទពិសោធន៍ និង ផ្តល់ ឱកាស ការងារ ជាច្រើន មុខតំណែង ដល់ និស្សិត និង បេក្ខជន ដែល កំពុង ស្វែងរក ការងារ ធ្វើ ។
សូម បញ្ជាក់ ថា ប្រាសាក់ ជា គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ដែល មាន បទដ្ឋាន ការងារ ច្បាស់លាស់ បរិយាកាស ការងារ ល្អ ទទួលបាន អត្ថប្រយោជន៍ ច្រើន ធ្វើការ នៅជិត ផ្ទះ អាច អភិវឌ្ឍ និង បង្កើន សមត្ថភាព ខ្លួន ផ្តល់ និរន្តរភាព ការងារ យូរអង្វែង ជាពិសេស ទៅ ទៀត នោះ គឺ គោរព តាម ច្បាប់ ការងារ កម្ពុជា ។
នៅក្នុង កម្មវិធី នេះ បេក្ខជន ទាំងអស់ អាច ដាក់ពាក្យ និង ទទួលបាន ការប្រឹក្សា អំពី អាជីព ការងារ ជាមួយ ក្រុមការងារ ជ្រើសរើស បុគ្គលិក របស់ ប្រាសាក់ បាន ភ្លាម ៗ ដោយ ភាពរាក់ទាក់ និង ស្និទ្ធស្នាល បំផុត ។
សុម បញ្ជាក់ ថា គិត ត្រឹមត្រីមាស ទី៣ ឆ្នាំ ២០១៩ នេះ ប្រាសាក់ មាន បុគ្គលិក សរុប ប្រមាណ ជា៩.០០០ នាក់ ក្នុង មុខ តំណែង និង ជំនាញ ផ្សេង ៗ គ្នា ជាច្រើន និង កំពុង ប្រតិបត្តិការ ទូទាំង កម្ពុជា ៕
នាយ ឧត្តមសេនីយ៍ ប៊ុត លើ ត៖ យើង ត្រូវ រក្សា តម្លៃ នៃ សន្តិភាព ឲ្យបាន កុំ ជឿ លើ ការញុះញង់ សម្តី ជន ក្បត់ ជាតិ ទណ្ឌិត សម រង្ស៊ី
( កោះកុង) ៖ នាយ ឧត្តមសេនីយ៍ ប៊ុន លើ ត រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ក្រុង ខេមរភូមិន្ទ បាន ថ្លែង ថា យើង រក្សា តម្លៃ នៃ សន្តិភាព ឲ្យបាន ជាដាច់ខាត កុំ ជឿ លើ សម្តី ញុះញង់ របស់ ជន ក្បត់ ជាតិ ទណ្ឌិត សម រង្ស៊ី ដែល ចង់ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ កើត ចេញ ពី បេះដូង ប្រជាពលរដ្ឋ កម្ពុជា ។
នាយ ឧត្តមសេនីយ៍ ប៊ុន លើត បាន ថ្លែង ថា « ប្រទេសជាតិ មាន ការរីកចំរើន គ្រប់ វិស័យ មាន ការអភិវឌ្ឍន៍ មាន ធនធាន មនុស្ស ទាំងនេះ ហើយ ដោយសារ ការខិតខំ ប្រឹងប្រែង ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល លោក ខិតខំ អស់ ពី កម្លាំង កាយ ចិត្ត ដើម្បី ស្វែងរក សន្តិភាព ជូន ប្រជាពលរដ្ឋ និង ប្រទេសជាតិ ដូច្នេះ សូម ប្រជាពលរដ្ឋ ទាំងអស់ កុំ ជឿង សម្តី ទណ្ឌិត រត់ ចោល ស្រុក សម រង្ស៊ី »៕
ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ីន ដាស្ទ្រីស៍ ទទួល ដំណើរទស្សនកិច្ច សិក្សា និសិ្សត វិទ្យាស្ថាន បច្ចេកទេស កម្ពុជា
ទស្សនកិច្ច សិក្សា នេះ ក្នុង គោលបំណង ឲ្យ និសិ្សត មាន ឱកាស ក្នុង ការស្វែងយល់ ពី ការប្រើប្រាស់ ជំនាញ បច្ចេកទេស ដែល ពួកគាត់ កំពុង សិក្សា និង ការអនុវត្ត ជាក់ស្តែង ពី សង្វាក់ ផលិតកម្ម និង គុណភាព របស់ ក្បឿង និង ទុយោ ជីប ម៉ុង នៃ ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ីន ដាស្រ្ទីស៍ ។
តំណាង អ្នកចូលរួម ក៏ បាន បង្ហាញ ពី ចំណាប់អារម្មណ៍ ចំពោះ ដំណើរទស្សនកិច្ច នៅ រោងចក្រ ផលិត ក្បឿង និង ទុយោ របស់ ក្រុមហ៊ុន ជីប ម៉ុង អ៊ីន ដាស្រ្ទីស៍ ថា នេះ គឺជា លើក ទី១ សម្រាប់ ពួកគាត់ ដែល មាន ឱកាស បាន មក ទស្សនា រោងចក្រ ផលិត ក្បឿង និង ទុយោ ដោយ ផ្ទាល់ ដែល ប្រើប្រាស់ បច្ចេកវិទ្យា ទំនើប និង មាន សមត្ថភាព ខ្ពស់ ក្នុង ការផលិត ក្បឿង និង ទុយោ សម្រាប់ ផ្គត់ផ្គង់ នៅលើ ទីផ្សារ ។
ឆ្លៀត ក្នុង ឱកាស នេះ ផងដែរ និស្សិត ក៏ បាន ចូល ទស្សនា រោងចក្រ បេតុង លាយ ស្រេច និង បាន ឃើញ ការអនុវត្ត ផ្ទាល់ ពី ដំណើរការ នៃ ការលាយ បេតុង ដើម្បីឲ្យ ត្រឹមត្រូវ តាម លក្ខណៈ ស្តង់ដា ក៏ ដូច សង្វាក់ ផលិតកម្ម របស់ រោងចក្រ ទាំងមូល ។
គួរ បញ្ជាក់ ថា ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ីន ដាស្រ្ទីស៍ គឺជា ក្រុមហ៊ុន ក្នុង ស្រុក ឈាន មុខ គេ មួយ ក្នុង ការផលិត និង ផ្គត់ផ្គង់ ប៉េតុង លាយ ស្រេច ក្បឿង និង ទុយោ គ្រប់ ប្រភេទ ។ រាល់ ផលិតផល ទាំងអស់ របស់ ក្រុមហ៊ុន ជីប ម៉ុង អ៊ីន ដាស្រ្ទីស៍ ត្រូវបាន ផលិត ឡើង ដោយ ប្រើប្រាស់ វត្ថុធាតុ ដើម ដ៏ ល្អ ឥត ខ្ចោះ ដោយ ប្រើប្រាស់ បច្ចេកវិទ្យា ចុងក្រោយ របស់ អ៊ីតាលី ៕
( ភ្នំពេញ ) ៖ ស្ពត ពាណិជ្ជកម្ម ថ្មី របស់ ភេសជ្ជៈ ប៉ូវ កម្លាំង លំដាប់ ពិភពលោក ប៊ូសស្ត្រង ពិតជា ឡូយ ដូច រឿង ហូលីវូដ ដែល មាន ឈុត ឆាក ថ្មី ប្លែក ភ្នែក និង មាន កម្រិត គុណភាព នៃ ការផលិត ខ្ពស់ លំដាប់ អន្តរជាតិ ។
យ៉ាងណាមិញ នៅក្នុង ស្ពត នេះ យើង ឃើញ តួអង្គ ក្នុង សាច់រឿង ស្ពត ពាណិជ្ជកម្ម ប៊ូសស្ត្រង ថ្មី នេះ មាន បុរស ម្នាក់ បាន ក្លាយជា វីរបុរស ជួយសង្គ្រោះ មនុស្សលោក ដែល ជិះ ក្នុង រថភ្លើង លើ អាកាស ដែល បម្រុង នឹង មាន គ្រោះថ្នាក់ ឲ្យ រួច ជីវិត បាន ទាំងអស់ គ្នា ដោយ សុវត្ថិភាព និង ជួយ ទីក្រុង ដែល ងងឹត ឲ្យ មាន អគ្គិសនី ឡើងវិញ បន្ទាប់ពី គាត់ ទទួលទាន ប៊ូសស្ត្រង អស់ មួយ កំប៉ុង ហើយ បាន ប្រែ កាយ ក្លាយជា វីរបុរស ប៊ូសស្ត្រង ។
ពិតជា វិសេសវិសាល ណាស់ សម្រាប់ ប៊ូសស្ត្រង ដែល បាន ផលិត ស្ពត ថ្មី ប្រកបដោយ គុណភាព កម្រិត លំដាប់ អន្តរជាតិ ដែល បន្ស៉ី គ្នា ជាមួយ ប៊ូសស្ត្រង ដែល ជា ភេសជ្ជៈ ប៉ូវ កម្លាំង លំដាប់ ពិភពលោក មែន ៕
គម្រោង អភិវឌ្ឍន៍ ប្រព័ន្ធ បង្ហូរ ទឹក កខ្វក់ ក្នុង រាជធានី ភ្នំពេញ នេះ មាន ទិសដៅ ច ម្រោះ ទឹក កខ្វក់ មុនពេល បង្ហូរ ចូល ទន្លេ តាមរយៈ ការសាងសង់ រោងចក្រ ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ មួយ កន្លែង នៅ បឹង ជើងឯក ក្នុង សង្កាត់ ជើងឯក ខ័ណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ និង បំពង់ បង្ហូរ ទឹក កខ្វក់ ដែល មាន ប្រវែង២.០០០ម៉ែត្រ មាន មុខកាត់៥០០ មីលីម៉ែត្រ តភ្ជាប់ ពី ស្ថានីយ៍ បូម បឹងត្របែក ។
រោងចក្រ ប្រព្រឹត្តកម្ម នេះ មាន សមត្ថភាព ចម្រោះ ទឹក កខ្វក់ បាន ៥.០០០ ម៉ែត្រ គូប ក្នុង មួយ ថ្ងៃ ។ ការសាងសង់ នឹង ត្រូវ ចាប់ផ្តើម នៅ ចុង ឆ្នាំ ២០២០ ដែល មាន រយៈពេល ប្រមាណ ៣២ ខែ ។ បន្ថែម ពីលើ ការសាងសង់ គម្រោង ក៏ នឹង ផ្តល់ ជំនួយ បច្ចេកទេស សម្រាប់ ពង្រឹង សមត្ថភាព មន្ត្រី ក្នុង ការគ្រប់គ្រង រោងចក្រ ដំណើរការ និង ហិរញ្ញវត្ថុ ផងដែរ ។
គម្រោង អភិវឌ្ឍន៍ ប្រព័ន្ធ បង្ហូរ ទឹក កខ្វក់ ក្នុង រាជធានី ភ្នំពេញ នេះ ជា គម្រោង បំពេញ បន្ថែម ឲ្យ គម្រោង ការពារ ទឹក ជំនន់ និង កែលម្អ ប្រព័ន្ធ ប្រឡាយ លូ ក្នុង រាជធានី ភ្នំពេញ ជំហាន ទី១ ទី២ ទី៣ និង ទី៤ ដែល ត្រូវបាន សាងសង់ ដោយ ហិរញ្ញប្បទាន ឥត សំណង របស់ ប្រទេស ជប៉ុន ផងដែរ ។
គម្រោង នេះ នឹង ចូលរួមចំណែក ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ សាលា រាជធានី ភ្នំពេញ ក៏ ដូចជា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ឆ្លើយតប យ៉ាង ជាក់ច្បាស់ ទៅនឹង សេចក្តីត្រូវការ ជា អាទិភាព ក្នុង ការអភិវឌ្ឍ ប្រព័ន្ធ ច ម្រោះ ទឹក កខ្វក់ ដែល នាំមក នូវ ការ ការពារ និង លើកម្ពស់ គុណភាព ទឹក និង អនាម័យ បរិស្ថាន ស្រប ទៅនឹង មុំ ទី១ នៃ ចតុកោណ ទី៤ ដូច មាន ចែង ក្នុង ឯកសារ យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
កិច្ចព្រមព្រៀង ហិរញ្ញប្បទាន ឥត សំណង ដែល ត្រូវ ចុះហត្ថលេខា នេះ គឺជា ឯកសារ គតិយុត្តិ មួយ ទៀត បន្ទាប់ពី លិខិត ប្តូរ សារ ដែល ទើប ត្រូវបាន ចុះហត្ថលេខា កាលពី ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ កន្លងទៅ រវាង ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា និង ស្ថានទូត ជប៉ុន ប្រចាំ នៅ កម្ពុជា ដែល អាច នាំឲ្យ ឈាន ទៅដល់ ការអនុវត្ត នីតិវិធី បន្តបន្ទាប់ ទៀត សម្រាប់ ការអនុវត្ត គម្រោង ជាក់ស្តែង ។
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន១ គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន បញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ៕ អាមេរិក ផ្អាក ជំនួយ ១០៥ លាន ដុល្លារ ទៅ លី បង់ ដោយ មិន បញ្ជាក់ មូលហេតុ ខណៈ បាតុកម្ម ធ្ងន់ធ្ងរ បាន កើតឡើង
( វ៉ាស៊ីនតោន ) ៖ រដ្ឋបាល ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នៅតែ មិន ព្រម ផ្តល់ ជំនួយ ផ្នែក សន្តិសុខ ទំហំ ១០៥ លាន ដុល្លារ សម្រាប់ ប្រទេស លី បង់ ដោយ ពុំ មាន ការបញ្ជាក់ ពី មូលហេតុ ច្បាស់លាស់ ឡើយ ខណៈ ប្រទេស នេះ បាន កើតមាន បាតុកម្ម ដែល បាន បង្ខំ ឲ្យ នាយក រដ្ឋមន្ត្រី លា លែង ពី តំណែង រួច មកហើយ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន CNA នៅ ព្រឹក ថ្ងៃសុក្រ ទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
យោង តាម ប្រភព ព័ត៌មាន ពី មន្រ្តី អាមេរិក ពីរ រូប ក្រសួង ការបរទេស អាមេរិក នា ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ បាន ប្រាប់ សភា អាមេរិក ថា ការិយាល័យ កញ្ចប់ ថវិកា របស់ សេតវិមាន និង ក្រុមប្រឹក្សា សន្តិសុខ ជាតិ បាន សម្រេចចិត្ត បង្ខាំង ទុក ជំនួយ ផ្នែក យោធា សម្រាប់ លី បង់ ដោយ មិន បញ្ជាក់ ហេតុផល នោះ ឡើយ ។
គួរ ជម្រាប ថា កាលពី ថ្ងៃអង្គារ សប្តាហ៍ នេះ នាយក រដ្ឋមន្រ្តី លី បង់ លោក សាអាដ អាល់ហារីរី (Saad al-Hariri) ទើបតែ បាន ប្រកាស លា លែង ពី តំណែង នៅ ចំពោះមុខ ការធ្វើ បាតុកម្ម ទ្រង់ទ្រាយ ធំ ខណៈ មុនពេល ចុះ ចេញ ពី អំណាច លោក បាន បរាជ័យ ក្នុង បញ្ចុះបញ្ចូល បរទេស ឲ្យ បញ្ចេញ ជំនួយ របស់ ពួកគេ សរុប ទំហំ ប្រមាណ ១១ ពាន់ លាន ដុល្លារ ដែល ត្រូវបាន សន្យា ផ្តល់ឲ្យ ប្រទេស មជ្ឈិមបូព៌ា មួយ នេះ កំឡុង សន្និសីទ មួយ ក្នុង ទីក្រុង ប៉ារីស កាលពី ឆ្នាំ ២០១៨ ៕
ខេត្ត កំពង់ធំ ផ្សព្វផ្សាយ ថ្នាំ កម្ចាត់ ស្មៅ ចង្រៃ លើ ដំណាំ ស្រូវ ថ្មី ប្រកបដោយ ប្រសិទ្ធភាព ជូន ដល់ កសិករ
( កំពង់ធំ )៖ មន្រ្តី ជំនាញ និង ភាគី ពាក់ព័ន្ធ នៅ ខេត្ត កំពង់ធំ ពេលនេះ បាន និង កំពុង យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ទៅ វិស័យ កសិកម្ម នៅក្នុង ខេត្ត ជាពិសេស ដំណាំ ស្រូវ ដើម្បី ធ្វើ យ៉ាងណា ជំរុញ កំណើន កសិផល របស់ កសិករ កាន់តែ ច្រើន ឡើង ។
ក្នុង គោល ដំណង ជំរុញ កំណើន កសិផល ក្នុង ខេត្ត នេះ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត កំពង់ធំ បាន សហការ ជាមួយ ក្រុមហ៊ុន ឯកជន បាន ផ្សព្វផ្សាយ ពី ផលិតផល កសិកម្ម ថ្មី ឈ្មោះ ថា ហ្សេវេឡូ ដែល ជា ថ្នាំ កម្ចាត់ ស្មៅ ចង្រៃ នៅលើ ដំណាំ ស្រូវ ដ៏ មាន ប្រសិទ្ធភាព មួយ នៅលើ ពិភពលោក ។
អនុប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត កំពង់ធំ លោក កាន់ សាឡន បាន លើកឡើង ក្នុង សិក្ខាសាលា នេះ ថា បច្ចុប្បន្ន ខេត្ត កំពង់ធំ គឺជា ខេត្ត ដែល ពោរពេញ ទៅ ដោយ វិស័យ កសិកម្ម សម្បូរបែប ហើយ ជាពិសេស នោះ គឺ ដំណាំ ស្រូវ ។ ដំណាំ ស្រូវ ក្នុង ខេត្ត កំពង់ធំ មាន ជាង ២២ម៉ឺន ហិកតា ដែល ទទួលបាន ទិន្នផល ជា មធ្យម បាន ត្រឹមតែ ៣១៥០ គីឡូក្រាម ក្នុង ១ហិកតា ហើយ ទិន្នផល នេះ មិន ទាន់ គ្រប់គ្រាន់ តាម តម្រូវការ ដែល ត្រូវ នាំ ស្រូវ អង្ករ ចេញ ទៅ ក្រៅ ប្រទេស ឡើយ ។
លោក គូរ រ៉ាណា សារ៉ាត់ ប្រធាន គ្រប់គ្រង ពាណិជ្ជកម្ម ប្រចាំ ប្រទេស ថៃ និង ឧបទ្វីប អាស៉ី ដែល ចែកចាយ ផលិតផល កសិកម្ម ហ្សេវេឡូ បាន ថ្លែង ថា ផលិតផល កសិកម្ម ហ្សេវេឡូ ត្រូវបាន នាំចូល មក កម្ពុជា តាមរយៈ ក្រុមហ៊ុន កតេរ៉ា. ឌោវ និង ឌូផន ដែល ជា ក្រុមហ៊ុន មាន របប គំហើយ ថ្មី និង មាន ការល្បីល្បាញ លើ ពិភពលោក ។ ក្រុមហ៊ុន នេះ បាន ផ្តល់ នូវ ដំណោះស្រាយ ផ្អែក លើ វិទ្យាសាស្ត្រ កសិកម្ម ដោយ បាន ធ្វើឲ្យ ភាព មាន ប្រសើរឡើង ក្នុង ជីវិត រស់ នៅ របស់ មនុស្ស នៅ ជុំវិញ ពិភពលោក ។
លោក បន្ត ថា « ហ្សេវេឡូ បាន ប្រតិបត្តិការ ជាង ៧០ ប្រទេស នៅ ជុំវិញ ពិភពលោក ដែល ផ្តល់ សេវាកម្ម ច្នៃប្រឌិត ថ្មី ៗ ជាច្រើន សម្រាប់ ដំណោះស្រាយ លើ បញ្ហា កសិកម្ម ។ ក្រុមហ៊ុន របស់ យើង ដែល បាន នាំចូល ថ្នាំ ថ្មី មិន មាន ផល ប៉ះពាល់ ដល់ បរិស្ថាន ដើម្បី ជួយ កម្ចាត់ ស្មៅ ចង្រៃ ចេញពី ស្រែ បង្កើន ទនិ្នផល ដល់ កសិករ ផ្តល់ ស្រូវ មាន គុណភាព ដើម្បី ប្រកួតប្រជែង ជាមួយ បណ្តា ប្រទេស ផ្សេង ទៀត នៅលើ ពិភពលោក » ។
លោក គូរ រ៉ាណា សារ៉ាត់ បាន បន្ថែម ថា ប្រទេស កម្ពុជា គឺជា ប្រទេស មួយ ដែល ជាប់ ចំណាត់ថ្នាក់ លេខ ១០ នៅលើ ពិភពលោក ក្នុង ការនាំ អង្ករ ចេញ ។ នេះ ជា លើក ទី១ ហើយ ដែល ហ្សេវេឡូ ត្រូវបាន ធ្វើ ការសម្ពោធ និង បើក ផ្សព្វផ្សាយ នៅក្នុង ខេត្ត កំពង់ធំ ព្រោះ លោក បាន សង្កេតឃើញ ថា នេះ ជា ខេត្ត ដែល មាន សក្តានុពល ខាង កសិកម្ម ហើយ ប្រជាពលរដ្ឋ មួយចំនួន កំពុងតែ នូវ ជួប បញ្ហា ស្មៅ ចង្រៃ ដែល យាយី ទៅ លើ ដំណាំ កសិកម្ម ជាពិសេស គឺ ដំណាំ ស្រូវ ។
លោក បន្ត ថា « អញ្ចឹង កាត់បន្ថយ កម្រៃ អ្នកប្រើប្រាស់ ចំណេញ ពេលវេលា ទៅ ធ្វើ ការងារ ជាច្រើន ទៀត ។ ម្យ៉ាង វិញ ទៀត សូម្បីតែ ស្មៅ ដែល ស៊ាំ នឹង ថ្នាំ ក៏ ហ្សេវេឡូ នៅតែ អាច កម្ចាត់ បាន កសិករ ប្រើ តែ ម្តង គឺ គាត់ នឹង ទទួល ផល ដោយ មិន បាច់ អារម្មណ៍ » ។
បន្ទាប់ពី ក្រុមហ៊ុន កតេរ៉ា បាន ជ្រើសយក ខេត្ត កំពង់ធំ ជា ខេត្ត គោលដៅ ដំបូង ក្នុង ការផ្សព្វផ្សាយ ស្តីពី គុណភាព ហ្សេវេឡូ នេះ លោក ជួយ ជំរុញ ឲ្យ កសិករ ប្រើ ថ្នាំ កសិកម្ម ប្រភេទ នេះ ទៅ ប្រើ លើ ដំណាំ ស្រូវ របស់ ពួកគាត់ ។ លោក សង្ឈឹម ថា ទិន្និផល ស្រូវ របស់ ប្រជាកសិករ នឹង ទទួលបាន ទិន្នផល ខ្ពស់ បើសិនជា ប្រើ ផលិតផល កសិកម្ម មួយ នេះ ៕
តម្លៃ ប្រេងឥន្ធនៈ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា៖ សាំង ធម្មតា តម្លៃ ៣. ៦០០ រៀល និង ម៉ាស៊ូត តម្លៃ ៣.៥០០ រៀល ក្នុង ១លីត្រ
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការកំណត់ ថ្លៃ ប្រេងឥន្ធនៈ ត្រូវ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ដោយ សាំង ធម្មតា ត្រូវ លក់ តម្លៃ ៣. ៦០០ រៀល ក្នុង មួយ លីត្រ និង ម៉ាស៊ូត លក់ ក្នុង តម្លៃ ៣.៥០០ រៀល ក្នុង ១លីត្រ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្ដីជូនដំណឹង របស់ ក្រសួង ពាណិជ្ជកម្ម ទាំង ស្រុង៖ ថៃ៖ មន្ត្រីរាជការ និង គ្រូបង្រៀន ចូលក្នុង ជំរំមួយ ជា បន្តបន្ទាប់ ដើម្បី ពង្រឹង ការងារ សហគមន៍ និង ភាពស្មោះត្រង់ ចំពោះ ស្តេច
( បាងកក )៖ មន្រ្តី រាជការ ប៉ូលិស និង គ្រូបង្រៀន កំពុង ត្រូវ បញ្ជូន ជា បន្តបន្ទាប់ ទៅកាន់ ជំរំបណ្តុះបណ្តាល នៅក្នុង ប្រទេស ថៃ ដើម្បី ចូលរួម វគ្គ ហ្វឹកហាត់ ក្នុង ផ្នែក ការងារ សហគមន៍ និង ការពង្រឹង ភាពស្មោះត្រង់ ចំពោះ ព្រះមហាក្សត្រ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ពី សារព័ត៌មាន CNA នៅ ព្រឹក ថ្ងៃសុក្រ ទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
យោង តាម អ្នកជំនាញ មួយចំនួន កម្មវិធី បណ្តុះបណ្តាល ខាងលើ ដែល ត្រូវបាន បង្កើតឡើង កាលពី ឆ្នាំ មុន គឺជា ការរំលេច ឲ្យ ឃើញ ពី របៀប ដែល ព្រះមហាក្សត្រ ថៃ បច្ចុប្បន្ន គឺ ព្រះបាទ មហា វិជ្ជរ៉ាឡុង កន កំពុងតែ ពង្រឹង អំណាច របស់ ទ្រង់ នៅក្នុង សង្គម ឲ្យ កាន់តែ រឹងមាំ ថែម ទៀត ។
គួរ ជម្រាប ថា បើ តាម ការយល់ឃើញ របស់ ក្រុម អ្នកជំនាញ មួយចំនួន ខណៈ ការគោរព យ៉ាង ជ្រាលជ្រៅ ចំពោះ ព្រះមហាក្សត្រ គឺជា វប្បធម៌ ដ៏ យូរ លង់ ណាស់ មកហើយ របស់ ប្រទេស ថៃ នោះ ព្រះបាទ វិជ្ជរ៉ាឡុង កន ក៏ កំពុងតែ ព្យាយាម ធានា នូវ ភក្តីភាព ពី ប្រជានុរាស្រ្ត របស់ ទ្រង់ ក្នុង របៀប ដែល ពុំ ធ្លាប់ ឃើញ ពីមុន មក ឡើយ ៕
( បន្ទាយមានជ័យ )៖ កងកម្លាំង ទាំង ៣ប្រភេទ រួម មាន កងទ័ព កងរាជអាវុធហត្ថ និង នគរបាល ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នេះ បាន ចាប់ផ្តើម បើក ការហ្វឹកហាត់ រួមគ្នា ដើម្បី បង្កើន ការថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាព នៅក្នុង ខេត្ត ។ ( ទស្សនា រូបភាព ខាងក្រោម )
ជាមួយនឹង ការហ្វឹកហាត់ នេះ មាន ការចល័ត កម្លាំង ទ័ព ចេញពី ទី បញ្ជាការដ្ឋាន ទិសទី១ និង ទី បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ ឆ្ពោះទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ផងដែរ ។ នេះ បើ យោង តាម សេចក្តីជូន ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ ។
ជាមួយ ការចល័ត កម្លាំង ដើម្បី ហ្វឹកហាត់ នេះ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត បន្ទាយមានជ័យ កុំ មាន ការភ្ញាក់ផ្អើល និង ព្រួយបារម្ភ ពេល មាន ការចល័ត កម្លាំង ។
បើ តាម របាយការណ៍ ចំណូល ដែល ទទួលបាន ជាង ៨០ លាន ដុល្លារ នេះ រាជ រដ្ឋាភិបាល បាន ដក ចំនួន ៣. ៦០៨. ០១៤ ដុល្លារ ឧបត្ថម្ភ ចូល មន្ទីរពេទ្យ គន្ធ បុប្ផា ដើម្បី ទ្រទ្រង់ ដំណើរការ ពិនិត្យ និង ព្យាបាល កុមារ កម្ពុជា ។
សូម ជម្រាប ថា បណ្ណ ចូល ទស្សនា តំបន់ អង្គរ ត្រូវបាន បែងចែក ជា៣ ប្រភេទ៖
( ភ្នំពេញ ) ៖ គិត មកដល់ ពេលនេះ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ហៅ កាត់ ថា ADB បាន ផ្តល់ ហិរញ្ញប្បទាន សហប្រតិបត្តិការ សរុប ចំនួន ប្រមាណ ៣. ៣៦ប៊ីលាន ដុល្លារ អាមេរិក ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង នោះ ឥណទាន សម្បទាន មាន ទឹកប្រាក់ សរុប ចំនួន ប្រមាណ ២.៨៦ ប៊ីលាន ដុល្លារ អាមេរិក និង ហិរញ្ញប្បទាន ឥត សំណង មាន ទឹកប្រាក់ សរុប ចំនួន ប្រមាណ ៤៩៨ លាន ដុល្លារ អាមេរិក ។
ទំហំ ហិរញ្ញប្បទាន នេះ ត្រូវបាន ប្រកាស ឡើង នៅក្នុង ពិធី ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ហិរញ្ញប្បទាន សម្រាប់ កម្មវិធី ចំនួន ០២ ដែល មាន ទឹកប្រាក់ សរុប ចំនួន ៩០ លាន ដុល្លារ អាមេរិក៖ ១) កម្មវិធី អភិវឌ្ឍ វិស័យ ហិរញ្ញវត្ថុ ប្រកបដោយ បរិយាប័ន្ន ( អនុកម្មវិធី ទី២ ) និង ២) កម្មវិធី ផ្គត់ផ្គង់ ទឹក ស្អាត និង អនាម័យ ជនបទ ជំហាន ទី ៣ រវាង រាជ រដ្ឋាភិបាល និង ធនាគារ អភិវឌ្ឍន៍ អាស៊ី (ADB) នៅ ក្រសួង សេដ្ឋកិច្ច ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០១ ខែវិច្ឆិកា នេះ ។
សូម ជម្រាប ថា កិច្ចព្រមព្រៀង ហិរញ្ញប្បទាន សម្រាប់ កម្មវិធី ចំនួន ០២ ដែល មាន ទឹកប្រាក់ សរុប ចំនួន ៩០ លាន ដុល្លារ អាមេរិក ត្រូវបាន ចុះហត្ថលេខា នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ រួម មាន៖
១៖ កម្មវិធី អភិវឌ្ឍ វិស័យ ហិរញ្ញវត្ថុ ប្រកបដោយ បរិយាប័ន្ន ( អនុកម្មវិធី ទី២) ៖
* ការពង្រីក សេវាកម្ម ហិរញ្ញវត្ថុ ឱ្យ បាន ទូលំទូលាយ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ; * ការធ្វើឱ្យ ស្ថេរភាព វិស័យ ហិរញ្ញវត្ថុ កាន់តែ មាន លក្ខណៈ ល្អ ប្រសើរ និង * ការធ្វើឱ្យ ហេដ្ឋារចនាសម្ព័ន្ធ ប្រព័ន្ធ ហិរញ្ញវត្ថុ កាន់តែ ប្រសើរឡើង ។
២៖ កម្មវិធី ផ្គត់ផ្គង់ ទឹក ស្អាត និង អនាម័យ ជនបទ ជំហាន ទី ៣៖
គ្រោង ចំណាយ ថវិកា សរុប ៥៥.៦៣ លាន ដុល្លារ អាមេរិក សម្រាប់ គាំទ្រ យុទ្ធសាស្ត្រ ផ្គត់ផ្គង់ ទឹក ស្អាត អនាម័យ និង អនាម័យ ជនបទ ២០១៤ - ២០២៥ និង ផែនការ សកម្មភាព ជាតិ សម្រាប់ ការផ្គត់ផ្គង់ ទឹក ស្អាត អនាម័យ ជនបទ ២០១៩ - ២០២៣ ដោយ ផ្តោត សំខាន់ លើ៖
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ អនុប្រធាន តំណាង ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន អម ដំណើរ ដោយ ថ្នាក់ដឹកនាំ អគ្គ លេខាធិការ ដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស មាតាបិតា សិស្ស ចូលរួម ជា អធិបតី បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ២០១៩ - ២០២០ និង សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ នូវ តារាង បាល់បោះ នៅ វិទ្យាល័យ ឥន្ទ្រ ទេវី ។
លោក នាក់ សុទ្ធា នាយក វិទ្យាល័យ ឥន្រ្ទ ទេវី បាន ថ្លែង នូវ ការស្វាគមន៍ និង របាយការណ៍ បង្ហាញ ពី ទឹកចិត្ត សប្បាយរីករាយ ជាមួយនឹង ការអភិវឌ្ឍ រីកចម្រើន ហេដ្ឋារចនាសម្ព័ន្ធ ទីតាំង លេង កីឡា របស់ សាលា ដែល កើត ចេញ ពី ការចូលរួម ពីសំណាក់ សប្បុរ រសជន ។
ជាមួយនឹង ភាពសប្បាយរីករាយ ក្មួយ ស្រី បូរ៉ា យ៉ានុត តំណាង សិស្សនុសិស្ស បាន ធ្វើ ការប្តេជ្ញាចិត្ត ធ្វើជា កូន ល្អ សិស្ស ល្អ មិត្ត ល្អ ខិតខំ រៀនសូត្រ និង ចូលរួម សកម្មភាព សង្គម បង្ការ ទប់ស្កាត់ បញ្ហា គ្រឿងញៀន ក្នុង សាលា ជា សាលា បែតង គ្មាន គ្រឿងញៀន និង គោរព ច្បាប់ ចរាចរណ៍ ។
ជា កិច្ចតបស្នង ចំពោះ គុណូបការ លោកគ្រូ អ្នកគ្រូ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ក៏ បាន ចែក អំណោយ ដល់ លោកគ្រូ អ្នកគ្រូ ចូលនិវត្តន៍ ផងដែរ ៕ ប្រធាន មូលនិធិ សកល សន្យា ផ្តល់ ហិរញ្ញប្បទាន ដល់ កម្ពុជា ឲ្យកាន់តែ ធំ ជាង មុន ដើម្បី ឈាន ទៅ លុបបំបាត់ ការរីករាលដាល ជំងឺ អេដស៍ រ បេង និង ជំងឺ គ្រុនចាញ់
អគ្គ បណ្ឌិត សភាចារ្យ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហប្រតិបត្តិការ របស់ មូលនិធិ សកល នៅ កម្ពុជា អស់ រយៈពេល ជាង ២ទសវត្សរ៍ កន្លងមក ដែល គិត រហូតមកដល់ ពេលនេះ បាន ទទួល ហិរញ្ញប្បទាន ពី មូលនិធិ សកល ចំនួន ប្រមាណ ៥១៥. ៩៥ លាន ដុល្លារ អាមេរិក ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ទាំង បី រួម មាន ជំងឺ អេដស៍ រ បេង និង ជំងឺ គ្រុនចាញ់ និង ជាពិសេស ជួយ ឱ្យ កម្ពុជា សម្រេចបាន គោលដៅ ៩០ - ៩០ - ៩០ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ អេដស៍ មុន ការគ្រោងទុក ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បន្ត ថា សមិទ្ធផល ដែល កម្ពុជា ទទួលបាន នា ពេលនេះ គឺ បាន រួមចំណែក ដ៏ ធំធេង ក្នុង ដល់ ការអភិវឌ្ឍ ជាតិ ដែល ស្រប តាម ចក្ខុវិស័យ ប្រកប ដោយ មហិច្ឆិតា នៃ ផែនការ យុទ្ធសាស្ត្រ សុខាភិបាល ២០១៦ - ២០២០ គឺ « ប្រជាពលរដ្ឋ កម្ពុជា ទាំងអស់ មាន សុខភាព និង សុខ មាលភាព កាន់តែ ប្រសើរឡើង ដើម្បី រួមចំណែក ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គមកិច្ច ប្រកបដោយ ចីរភាព » ។
លើ មូលដ្ឋាន នៃ សមិទ្ធផល ដែល សម្រេចបាន នេះ លោក Dr. Donald Kaberuka ក្នុង នាម មូលនិធិ សកល . បាន សន្យា បន្ដ ពង្រីក កិច្ចសហប្រតិបត្ដិការ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង បេសកកម្ម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ទាំង បី នេះ បន្ត ទៀត ក្នុង ទំហំ ហិរញ្ញប្បទាន សហប្រតិបត្តិការ កាន់តែ ធំ ជាង មុន ដើម្បី ជួយសង្គ្រោះ ជីវិត មនុស្ស កាត់បន្ថយ អត្រា មរណៈ និង ឈាន ទៅ លុបបំបាត់ ការរីករាលដាល ទាំងស្រុង នៃ ជំងឺ ទាំង បី មុន ដំណាច់ ឆ្នាំ ២០៣០ ។
( ម៉ានីល) ៖ មនុស្ស យ៉ាងហោចណាស់ ១៩ នាក់ បាន ស្លាប់ និង ២២ នាក់ ទៀត រងរបួស បន្ទាប់ពី រថយន្ត ដែល ពួកគេ ជិះ បាន ជ្រុល ចង្កូត ធ្លាក់ ចូល ទៅក្នុង ជ្រោះ ក្បែរ ដង ផ្លូវ ស្ថិត នៅក្នុង ខេត្ត អាផាយ៉ាវ (Apayao) ជា តំបន់ ប្រជុំ ភ្នំ នៃ ភាគ ខាងជើង ប្រទេស ហ្វីលីពីន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ស៊ីន ហួរ នា ព្រឹក ថ្ងៃសុក្រ ទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។
គួរ បញ្ជាក់ ថា បញ្ហា ភូមិសាស្ត្រ ពិបាក អាច ជា កត្តា ចម្បង ដែល បាន បង្កឲ្យ គ្រោះថ្នាក់ ខាងលើ នេះ កើត មាន ឡើង ។ ប៉ូលិស បាន បន្ថែម ទៀត ថា ជនរងគ្រោះ ភាគ ច្រើន សុទ្ធសឹងតែ ជា មនុស្ស ដែល មាន វ័យ ចំណាស់ ដោយ ពួកគេ បាន ព្យាយាម ធ្វើដំណើរ ទៅកាន់ ខេត្ត ខាងលើ នេះ ក្នុង គោលបំណង ស្នើសុំ ជំនួយ ពី រដ្ឋាភិបាល ហើយ គ្រោះថ្នាក់ បាន កើត មាន ឡើង នៅពេល ពួកគេ ជិះ ត្រឡប់ មកវិញ ៕
ក្រុមហ៊ុន ផលិត ទឹក អូគូលែន ចំណាយ ផ្ទៃដី ជាង ៣០ ហិកតា សម្រាប់ ដាំ កូន ឈើ ដើម្បី ស្ដារ ព្រៃឈើ ឡើងវិញ ទុក ជា សម្បត្តិ មនុស្សជាតិ
ការបណ្ដុះ និង ដាំ កូន ឈើ នេះ ក៏ ទទួលបាន ការចូលរួម សហការ ពីសំណាក់ មូលនិធិ បុរាណវិទ្យា និង ការអភិវឌ្ឍ ឬ ហៅ ថា អង្គការ ADF ផងដែរ ដែល អង្គការ នេះ មាន មូលដ្ឋាន នៅលើ ភ្នំ គូលែន តែម្ដង ហើយ បាន ធ្វើការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ប្រជា សហគមន៍ សាលារៀន ក្រុមហ៊ុន Kulara Water មន្ទីរ បរិស្ថាន និង អាជ្ញាធរ ពាក់ព័ន្ធ នានា ។ រីឯ ការដាំ ដើមឈើ នេះ ក៏ ទទួលបាន ការអនុញ្ញាត ពី មន្ទីរ បរិស្ថាន ខេត្ត សៀមរាប និង អាជ្ញាធរ ជាតិ អប្សរា ផងដែរ ។
កញ្ញា ជួប សុភី បាន បន្ត ថា ក្រៅពី ចូលរួម ស្ដារ ព្រៃឈើ ការពារ ប្រភព ទឹក រក្សា ស្ថិរភាព បរិស្ថាន ផ្ដល់ គម្រប ព្រៃឈើ ឡើងវិញ នោះ កូន ឈើ ដែល ត្រូវបាន ដាំ ទាំងនោះ ក៏ អាច ទាក់ទាញ សត្វ ឃ្មុំ ឱ្យ រស់ នៅ ទីនោះ ដែរ ពីព្រោះ ឈើ ដែល បាន ដាំ នេះ មាន ប្រភេទ ផ្សេង ៗ គ្នា ហើយ មាន ផ្កា តាម រដូវ ផ្សេង គ្នា ដែរ ។
គម្រោង វិនិយោគ ថ្មី ៗ ទាំង១៩ នោះ រួម មាន៖
សូម កុំ ប្រើប្រាស់ ទូរស័ព្ទ ពេល កំពុង បើកបរ ! ស្លាប់ ៣នាក់ និង របួស ៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ៣១ ខែតុលា ម្សិលមិញ
