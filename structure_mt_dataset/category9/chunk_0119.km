* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ឱ្យ ពង្រឹង ការថែទាំ ផ្លូវ ជាតិ លេខ ៥ និង ផ្លូវ ដទៃ ទៀត ឱ្យ បាន ល្អ ប្រសើរ ។ បើ មាន ការខូចខាត ប្រញាប់ ជួសជុល ។ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ឱ្យ សហការ គ្នា ទប់ស្កាត់ និង កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៦៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២១ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៦៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២១ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៦៧ នាក់ នោះ មាន ៥៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៧ករណី និង ជនសង្ស័យ ០៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ១០ករណី ។
សាលាដំបូង ខេត្ត កំពត ចេញ ដីកា កោះអញ្ជើញ ឈ្មោះ គង់ និមល ឲ្យ ចូល ខ្លួន ពាក់ព័ន្ធ សំណុំរឿង រដ្ឋប្បវេណី នៅ ថ្ងៃទី ២៧ ខែ ធ្នួ
( កំពត ) ៖ លោកស្រី លី ម៉ារីណា ចៅក្រម នៃ សាលាដំបូង ខេត្ត កំពត បាន ចេញ ដីកា កោះអញ្ជើញ ឈ្មោះ គង់ និមល ភេទ ស្រី អាយុ ៣៩ ឆ្នាំ រស់ នៅ ភូមិ កោះ កុក ឃុំ កោះ ទន្ទឹម ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម ជា ចុងចម្លើយ ឱ្យ ចូល ខ្លួន នៅ ថ្ងៃទី ២៧ ខែធ្នូ ឆ្នាំ ២០២៣ វេលា ម៉ោង ៩៖០០ នាទី ព្រឹក បន្ទប់ ( គ) នៃ សាលាដំបូង ខេត្ត កំពត ពាក់ព័ន្ធ សំណុំរឿងក្តី រដ្ឋប្បវេណី លេខ ២៩៤ ចុះ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២២ ។
ខាងក្រោម នេះ ជា ដីកា កោះអញ្ជើញ របស់ តុលាការ៖ តុលាការ បើក ការស៊ើបសួរ លើ ជនជាតិ ចិន ដី គោក ចិន តៃវ៉ាន់ និង វៀតណាម ៣៣ នាក់ ពាក់ព័ន្ធ ការបង្ខាំង មនុស្ស ខុស ច្បាប់ នៅ ខណ្ឌ ឫស្សីកែវ
( ភ្នំពេញ ) ៖ ក្រុម ជនសង ស្ស័យ ពាក់ព័ន្ធ ករណី ចាប់បង្ខាំង មនុស្ស ដោយ ខុស ច្បាប់ ដើម្បី ជម្រិត ទារ ប្រាក់ ចំនួន ៣៣ នាក់ ក្នុង នោះ មាន ជនជាតិ ចិន ដី គោក ចំនួន ៣១ នាក់ ចិន តៃវ៉ាន់ ម្នាក់ និង វៀតណាម ម្នាក់ ត្រូវបាន លោក ជា សា ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ បើក ការស៊ើបសួរ ដើម្បី ឈាន ទៅរក ការចោទប្រកាន់ តាម ផ្លូវ ច្បាប់ ។ នេះ បើ យោង តាម ប្រភព ពី មន្ត្រី សាលាដំបូង បាន ឱ្យ អង្គភាព ព័ត៌មាន Fresh News នៅ ព្រឹក ថ្ងៃទី ២២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ប្រសិនបើ តំណាង អយ្យការ ដែល ទទួល ចំណាត់ការ លើ រឿងក្តី នេះ រកឃើញ ថា ក្រុម ជនសង្ស័យ ពាក់ព័ន្ធ ខាងលើ មាន ពិរុទ្ធភាព គ្រប់គ្រាន់ ពួកគេ គេ នឹង ត្រូវ ចោទប្រកាន់ ជា ផ្លូវការ និង ហើយ ត្រូវ បន្ត បញ្ជូន សំណុំរឿង ទៅកាន់ ចៅក្រម ស៊ើបសួរ តាម នីតិវិធី ។
យោង តាម របាយការណ៍ សមត្ថកិច្ច បញ្ជាក់ ថា ដោយ មាន ការដឹកនាំ បញ្ជា ពី លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ . កម្លាំង នគរបាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ កាលពី សៀល ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន បញ្ជូន ខ្លួន ក្រុម ជនសង្ស័យ ពាក់ព័ន្ធ ករណី ចាប់បង្ខាំង មនុស្ស ដោយ ខុស ច្បាប់ ដើម្បី ជម្រិត ទារ ប្រាក់ ទៅកាន់ តុលាការ ចំនួន ៣៣ នាក់ ក្នុង នោះ មាន ជនជាតិ ចិន ដី គោក ចំនួន ៣១ នាក់ ចិន តៃវ៉ាន់ ម្នាក់ និង វៀតណាម ម្នាក់ ។
ដោយឡែក ចំពោះ ខ្មែរ ចំនួន ៨នាក់ ត្រូវបាន សមត្ថកិច្ច អនុញ្ញាតឱ្យ ទៅ ផ្ទះ វិញ ព្រោះ ពួកគេ សុទ្ធសឹង ជា កម្មករ ស៊ី ឈ្នួល ដាំ បាយ និង ជូត ផ្ទះ ឱ្យ ជនជាតិ ចិន មួយ ក្រុម នោះ តែ ប៉ុណ្ណោះ ។
គួរ រំលឹក ថា កាលពី រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នគ បាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ រាជធានី ភ្នំពេញ បាន សហការ ជាមួយ កម្លាំង មូលដ្ឋាន ចុះ ធ្វើ ការឡោមព័ទ្ធ និង ឃាត់ខ្លួន មនុស្ស ចំនួន ៤១ នាក់ នៅ ចំណុច មុខ សាលា អូស្ត្រាលី សង្កាត់ ទួល សង្កែទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ពាក់ព័ន្ធ ករណី បង្ខាំង មនុស្ស ជម្រិត ទារ ប្រាក់ និង បើក ល្បែងស៊ីសង អនឡាញ ដោយ ខុស ច្បាប់ ។
ការចុះបង្ក្រាប របស់ សមត្ថកិច្ច ធ្វើឡើង តាម ពាក្យបណ្តឹង របស់ នារី ម្នាក់ ជា ជនជាតិ វៀតណាម ដែល ចេះ និយាយ ភាសា ខ្មែរ ដោយ អះអាង ថា ប្អូន ប្រុស របស់ នាង ត្រូវបាន ជនជាតិ ចិន មួយ ក្រុម ចាប់ បង្ខាំង និង ជម្រិត ទារ ប្រាក់ ចំនួន ២.៥០០ ដុល្លារ ។
ក្រោយពី ពួកគេ ល្បួង លួងលោម ឱ្យ មក ធ្វើការ នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង ក្រុម ឧក្រិដ្ឋ ជន ទាំងអស់ នោះ បែរជា ចាប់ ប្អូន ប្រុស គាត់ ( ដើម បណ្តឹង ) បញ្ជូន មកកាន់ រាជធានី ភ្នំពេញ កាលពី យប់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ដើម្បី បង្ខាំង ជម្រិត ទារ ប្រាក់ ទៅ វិញ ។
នៅក្នុង ប្រតិបត្តិការ កម្លាំង សមត្ថកិច្ច នគរបាល បាន ឡោមព័ទ្ធ ទីតាំង មួយ កន្លែង ដែល មាន អគារ កម្ពស់ ៣ជាន់ រួច ឃាត់ខ្លួន មនុស្ស ចំនួន ៤១ នាក់ ក្នុង នោះ មាន ជនជាតិ បរទេស ចំនួន ៣៣ នាក់ ( ស្រី ម្នាក់ ) និង ជនជាតិ ខ្មែរ ចំនួន ៨នាក់ ។
ក្រោយ ប្រតិបត្តិការ កម្លាំង សមត្ថកិច្ច បាន ដកហូត រថយន្ត ចំនួន ៤គ្រឿង រួម មាន៖ រថយន្ត ម៉ាក រ៉ូស រ៉ូយ មួយ គ្រឿង . រថយន្ត ម៉ាក ធន់ ត្រា មួយ គ្រឿង . រថយន្ត ម៉ាក អាល់ហ្វាត មួយ គ្រឿង . រថយន្ត ម៉ាក ឡង់ គ្រីស័រ មួយ គ្រឿង និង ទូរស័ព្ទដៃ ចំនួន ១៧ គ្រឿង ព្រមទាំង ម៉ូតូ ០២ គ្រឿង ៕
កម្ពុជា និង UN បិទ បញ្ចប់ សិក្ខាសាលា ផ្ទៀងផ្ទាត់ លើ លទ្ធផល រកឃើញ បឋម នៃ ការវាយតម្លៃ វាស់វែង ឱកាស របស់ ស្រ្តី ក្នុង ប្រតិបត្តិការ រក្សា សន្តិភាព អ.ស.ប
ប្រធាន កម្មវិធី អភិបាលកិច្ចសន្តិភាព និង សន្តិសុខ អាស៊ាន នៃ ភ្នាក់ងារ សហ ប្រជាជាតិ UN Women បាន ថ្លែង ថា សិក្ខាសាលា នេះ បាន ឆ្លុះបញ្ចាំង ពី កិច្ចពិភាក្សា យ៉ាង សកម្ម ពី អ្នកចូលរួម ជាពិសេស ពី យោធិន នារី ដែល ចូលរួម ក្នុង បេសកកម្មកសាង សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ ក្នុង រយៈពេល ពីរ ថ្ងៃ កន្លងមក នេះ ដើម្បី ប្រមូល ធាតុ ចូល និង ពត៌មាន បន្ថែម ដាក់ បញ្ចូល ក្នុង របាយការណ៍ សិក្សា ស្រាវជ្រាវ ឱ្យ កាន់តែ មាន គុណភាព ។
លោកស្រី បាន លើកឡើង ពី ចំណាប់អារម្មណ៍ របស់ សមាគម អាស៊ាន ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង និង ការប្តេជ្ញាចិត្ត របស់ កម្ពុជា ក្នុង ការលើកកម្ពស់ ការចូលរួម របស់ ស្ត្រី ក្នុង ការកសាង សន្តិភាព ប្រកបដោយ អត្ថន័យ ។
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី យន្ដ ការលើកទឹកចិត្ដ នានា សម្រាប់ ការចុះបញ្ជី ពាណិជ្ជកម្ម ដោយ ស្ម័គ្រចិត្ដ របស់ វិស័យ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖ ធនាគារ ពិភពលោក ផ្ដល់ ថវិកា ១៦៣ លាន ដុល្លារ សម្រាប់ ជួយ កម្ពុជា ក្នុង ការពង្រឹង សេវា ផ្គត់ផ្គង់ ទឹក ស្អាត និង អនាម័យ នៅ ខេត្ដ ចំនួន ៤
( ភ្នំពេញ ) ៖ ធនាគារ ពិភពលោក បាន ផ្តល់ ការយល់ព្រម លើ គម្រោង មួយ ដែល មាន តម្លៃ ១៦៣ លាន ដុល្លារ អាមេរិក សម្រាប់ ជួយ ប្រទេស កម្ពុជា នៅក្នុង កិច្ចប្រឹងប្រែង ពង្រឹង សេវា ផ្គត់ផ្គង់ ទឹក ស្អាត និង អនាម័យ ជា ប្រយោជន៍ ដល់ ប្រជាជន ជាង ១៧៥ ០០០ នាក់ នៅក្នុង ខេត្ត ចំនួន បួន ។ នេះ បើ តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ ធនាគារ ពិភពលោក ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
លោកស្រី ម៉ារីយ៉ាម សាលីម ប្រធាន គ្រប់គ្រង នៃ ធនាគារ ពិភពលោក ប្រចាំ នៅ កម្ពុជា បាន ថ្លែង ថា « កិច្ច គាំទ្រ នេះ នឹង ជួយ រដ្ឋាភិបាល ក្នុង ការកសាង គ្រឹះ រឹងមាំ មួយ សម្រាប់ ផ្តល់ សេវា ចាំបាច់ ទាំងនេះ ទៅដល់ ប្រជាជន កម្ពុជា ហើយ វា នឹង នាំមក នូវ អត្ថប្រយោជន៍ ភ្លាម ៗ ដល់ ស្ត្រី និង អ្នកក្រីក្រ នៅ តាម ទី ជនបទ ដែល បច្ចុប្បន្ន មិន ទាន់ ទទួលបាន សេវា ទាំងនេះ » ។
គម្រោង នេះ មាន សកម្មភាព មួយ សម្រាប់ បង្កើន ការវិនិយោគ ហិរញ្ញវត្ថុ ឲ្យ អស់ លទ្ធភាព សម្រាប់ ការអភិវឌ្ឍ ដោយ ធ្វើការ ជាមួយ ប្រតិបត្តិករ ផ្គត់ផ្គង់ ទឹក ស្អាត ឯកជន ដែល កំពុង និង បាន ចូលរួមចំណែក ជាង ពាក់កណ្តាល នៃ បណ្តាញ ទុយោ ទឹក ទាំងអស់ នៅ កម្ពុជា នៅក្នុង ការកៀរគរ ធនធាន ចំនួន ប្រមាណ ប្រហែល ១៧.៦លាន ដុល្លារ អាមេរិក បន្ថែម ទៀត ពី ប្រភព ឯកជន សម្រាប់ ពង្រីក ការផ្គត់ផ្គង់ សេវា ទឹក ស្អាត ។
លោក ហែម វណ្ណឌី រដ្ឋមន្ត្រី ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ បាន ថ្លែង ថា « ការផ្គត់ផ្គង់ ទឹក ស្អាត ជា វិស័យ អាទិភាព មួយ សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ភាពធន់ និង ចីរភាព និង សម្រាប់ ការពង្រឹង សេដ្ឋកិច្ច ។ គម្រោង នេះ នឹង ជួយ រដ្ឋាភិបាល ក្នុង ការអនុវត្ត ចក្ខុវិស័យ និង យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ រួម របស់ ខ្លួន ហើយ យើង ប្តេជ្ញា ថា និង ធានា ឲ្យ មាន កំណើន ប្រកបដោយ ចីរភាព នៅក្នុង វិស័យ នេះ ក៏ ដូចជា ក្នុង ការឈានទៅ សម្រេច គោលដៅ SDG 6 ឲ្យបាន ផងដែរ » ។
លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ថ្លែង ថា « រាជ រដ្ឋាភិបាល កម្ពុជា ផ្តល់ ការយកចិត្តទុកដាក់ ខ្លាំង ទៅ លើ ការគ្រប់គ្រង សំណល់ ទឹក កខ្វក់ និង ភក់ សំណល់ បង្គន់ ដូច្នេះ ការវិនិយោគ ទៅ លើ ប្រព័ន្ធ អនាម័យ ក្រោម គម្រោង នេះ ពិតជា មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ធានា ឱ្យ បាន នូវ និរន្តរភាព របស់ សេវា អនាម័យ ដែល នឹង ធ្វើឱ្យ វិស័យ នេះ មាន ការវិវឌ្ឍ ប្រែប្រួល ជា វិជ្ជមាន ទៅ ថ្ងៃ មុខ » ។
ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ជា ភាគី អនុវត្តន៍ សកម្មភាព ពាក់ព័ន្ធ ការផ្គត់ផ្គង់ ទឹក ស្អាត ហើយ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ជា ភាគី អនុវត្ត សកម្មភាព សេវា អនាម័យ ទីក្រុង នៅក្រោម គម្រោង នេះ ។ ខេត្ត ទាំង បួន ដែល ជា គោលដៅ របស់ គម្រោង មាន ខេត្ត បាត់ដំបង . ពោធិ៍សាត់ . មណ្ឌលគិរី និង កណ្តាល ៕
លោកស្រី ម៉ារីយ៉ាម សាលីម នាយក គ្រប់គ្រង នៃ ធនាគារ ពិភពលោក ប្រចាំ នៅ កម្ពុជា បាន ថ្លែង ថា « ដើម្បី រក្សា បាន នូវ កំណើន សេដ្ឋកិច្ច កម្ពុជា ចាំបាច់ ត្រូវ ជួយ ដល់ វិស័យ ឯកជន ឱ្យ បំពេញ មុខងារ ជា ក្បាល ម៉ាស៊ីន កំណើន មួយ ហើយ កិច្ចការ នេះ អាច សម្រេចបាន ដោយ ធ្វើ សកម្មភាព ភ្លាម ៗ ក្នុង ការកែលម្អ ការបំពេញ កិច្ច របស់ វិស័យ សាធារណៈ » ។ លោកស្រី បន្ថែម ទៀត ថា « ការរក្សា ស្ថេរភាព ហិរញ្ញវត្ថុ ក៏ ជា អាទិភាព មួយ ដែរ ហើយ ចាំបាច់ ត្រូវតែ ខិតខំ ថែម ទៀត ក្នុង ស្តារ លំហ សារពើពន្ធ ឡើងវិញ » ។
ឆ្ពោះទៅ មុខ កំណើន សេដ្ឋកិច្ច អាច នៅតែ រង ផល ប៉ះពាល់ បន្ថែម ទៀត ពី ការចុះខ្សោយ នៃ តម្រូវការ ពិភពលោក ឬ ពី ការឡើង ថ្លៃ ប្រេងឥន្ធនៈ និង ថ្លៃ ស្បៀងអាហារ ឡើងវិញ ។ នៅក្នុង ស្រុក ការកើនឡើង នៃ បំណុល គ្រួសារ និង ឥណទាន ក្នុង ស្រុក នៅក្នុង វិស័យ អចលន ទ្រព្យ នៅតែ ជា ហានិភ័យ ដដែល ។
បេសកកម្មសិទ្ធិ មនុស្ស UN ប្រចាំ អ៊ុយក្រែន ដែល មាន ភ្នាក់ងារ ឃ្លាំមើល ជាច្រើន នៅក្នុង ប្រទេស នេះ បាន និយាយ ថា បើ តាម ការរំពឹងទុក តួលេខ ជាក់ស្តែង ពិតប្រាកដ នៃ អ្នកស្លាប់ បើ ធៀប ជាមួយនឹង តួលេខ ផ្លូវការ គឺ មុខ ជា នឹង ខ្ពស់ ខ្លាំង ជាង ដ្បិត ការងារ ផ្ទៀងផ្ទាត់ តួលេខ កំពុងតែ ប្រព្រឹត្តទៅ ជាពិសេស ព្រឹត្តិការណ៍ អំលុង ប៉ុន្មាន ខែ ដំបូង ក្រោយ សង្រ្គាម ផ្ទុះឡើង រួម មាន ទាំង សមរភូមិ ទីក្រុង Mariupol ជា ទី ដែល អ្នកស្រុក បាន រាយការណ៍ អំពី ចំនួន ជន ស៉ី វិល ស្លាប់ ច្រើន ជាដើម ។
សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្រៅពី ផ្លូវថ្នល់ យើង នឹង ពង្រឹង ផ្លូវ ដែក បន្ថែម ទៀត ចំពោះ ផ្លូវ ដែក ដែល នឹង ត្រូវ ធ្វើ អទិភាព សំខាន់ បំផុត គឺ ត្រូវ ពង្រឹង ផ្លូវ ដែក ខាងជើង និង ខាងត្បូង ។ ខ្សែ ផ្លូវ ដែក មាន ចំនួន ២ខ្សែ ដោយ ខ្សែ ទី១ ស្ថិត នៅ ខាងជើង ចាប់ពី ប៉ោយប៉ែត កាត់ ទៅ ភ្នំពេញ ពោសាត់ ធ៍ បាត់ ដឹង និង បាត់ដំបង ចំណែក ខ្សែ ខាងត្បូង ចាប់ពី ភ្នំពេញ តាកែវ កំពត និង ខេត្ត ព្រះសីហនុ ។
សម្ដេច មហា បវរធិបតី បាន ថ្លែង បញ្ជាក់ ថា ដើម្បី ពង្រឹង អ្វី ដែល មាន ស្រាប់ និង ជំរុញ ការដឹកជញ្ជូន បាន ស្រួល និង លឿន កាត់បន្ថយ ចំណាយ កម្ពុជា ចាំបាច់ ត្រូវ ធ្វើ ផ្លូវ ដែក មួយ ទៀត ដើម្បី សម្រួល ការដឹកជញ្ជូន កាត់បន្ថយ នៃ តម្លៃ ដឹកជញ្ជូន បច្ចុប្បន្ន នេះ កម្ពុជា បាន ធ្វើ ផ្លូវ ល្បឿន លឿន រួចរាល់ និង បាន ជួយ សម្រួល យ៉ាង សំខាន់ ក្នុង ការធ្វើដំណើរ អ្វី ដែល ត្រូវ ពង្រឹង បន្ថែម ទៀត គឺ គម្រោង ធ្វើ ផ្លូវ ដែក ។
សម្ដេច មហា បវរធិបតី បាន មានប្រសាសន៍ បញ្ជាក់ ថា « គម្រោង ធ្វើ ផ្លូវ ដែក ចាំបាច់ ត្រូវតែ ធ្វើ តាម គម្រោង នឹង ធ្វើ ភ្ជាប់ ពី ខាងកើត ទន្លេ ភ្ជាប់ ពី ប៉ោយប៉ែត សៀមរាប ភ្នំពេញ ចំណែក ផ្លូវ រថភ្លើង ល្បឿន លឿន នឹង រៀបចំ តាម ក្រោយ នា ពេល ខាងមុខ ចំពោះ ពេលនេះ ត្រូវ ពង្រឹង អ្វី ដែល មាន ស្រាប់ មិន ចំណាយ ច្រើន លឿន និង បម្រើ ទៅ លើ ការដឹកជញ្ជូន ពិសេស ដឹកជញ្ជូន ទំនិញ ព្រមទាំង កាត់បន្ថយ ថ្លៃ ដឹក ទំនិញ » ។
សូម ជម្រាប ថា ប្រទេស កម្ពុជា មាន ផ្លូវ ដែក ចំនួន ២ខ្សែ ដោយ ខ្សែ ទី១ ចេញ ពី ភ្នំពេញ ទៅ អូជ្រៅ កាត់ រាជធានី ភ្នំពេញ កណ្តាល កំពង់ស្ពឺ កំពង់ឆ្នាំង ពោធិ៍សាត់ បាត់ដំបង បន្ទាយមានជ័យ មាន ប្រវែង ៣៨៥ គូឡូម៉ែត្រ ។
ចំណែក ខ្សែ ទី២ ចេញ ពី ភ្នំពេញ ទៅ ក្រុង ព្រះសីហនុ កាត់ ភ្នំពេញ កណ្តាល តាកែវ កំពត កែប និង ក្រុង ព្រះសីហនុ ប្រវែង ២៦៦ គីឡូម៉ែត្រ ៕ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ចេញ អនុក្រឹត្យ ស្តីពី លក្ខខណ្ឌ និង នីតិវិធី នៃ ការចុះបញ្ជី ដី រដ្ឋ
អនុក្រឹត្យ នេះ កំណត់ អំពី លក្ខខណ្ឌ និង នីតិវិធី នៃ ការចុះបញ្ជី ដី រដ្ឋ តាមរយៈ ការធ្វើ អត្តសញ្ញាណកម្ម ការធ្វើ ផែនទី និង ការធ្វើ ចំណាត់ថ្នាក់ ដី រដ្ឋ ក្នុង គោលបំណង ដើម្បី ធានា ការពារ កម្មសិទ្ធិ និង សិទ្ធិ ផ្សេង ទៀត លើ ដី រដ្ឋ ៕
( កែប )៖ ឆ្នេរ អង្កោល មាន ទីតាំង ស្ថិត នៅ ភូមិ អង្កោល ឃុំ អង្កោល ស្រុក ដំណាក់ ចង្អើរ ខេត្ត កែប ដែល ជា ទីតាំង កម្សាន្ត ដ៏ ទាក់ទាញ មួយ ស្ថិត ក្នុង ខេត្ត កែប ។
