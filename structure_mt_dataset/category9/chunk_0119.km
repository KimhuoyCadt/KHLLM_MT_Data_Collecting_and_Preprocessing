( ភ្នំពេញ ) ៖ ប្រទេស ចិន បាន បញ្ជាក់ ជាថ្មី ពី ការបន្ត គាំទ្រ ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្រោយ រយៈពេល ៣ខែ នៃ ការចេញដំណើរ របស់ រដ្ឋាភិបាល ថ្មី ដើម្បី ធានា នូវ កំណើន សេដ្ឋកិច្ច និង នាំមក នូវ ផ្លែ ផ្កា សម្រាប់ ប្រទេស និង ប្រជាជន កម្ពុជា ។
សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន វាយតម្លៃ ខ្ពស់ ចំពោះ តួនាទី ដ៏ សំខាន់ របស់ ប្រទេស ចិន ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម របស់ ប្រទេស កម្ពុជា ដែល ចូលរួមចំណែក ក្នុង ការពង្រឹង ឯករាជ្យភាព របស់ ព្រះរាជាណាចក្រ កម្ពុជា ។
ចិន គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ កម្ពុជា ដើម្បី ការពារ អធិបតេយ្យភាព ជាតិ សន្តិសុខ និង ប្រយោជន៍ នៃ ការអភិវឌ្ឍ ខណៈ បញ្ជាក់ ពី ការប្រឆាំង ដាច់ខាត ចំពោះ ការជ្រៀត ជ្រែក ពី បរទេស ចូល កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ។
ចិន និង កម្ពុជា ប្រឆាំង ដាច់ខាត ចំពោះ ការធ្វើ នយោបាយ លើ បញ្ហា សិទ្ធ មនុស្ស ការអនុវត្ត ស្តង់ដារ ពីរ និង ការជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ដទៃ ក្រោម ហេតុផល សិទ្ធ មនុស្ស ឬ ប្រជាធិបតេយ្យ និង ឯកភាព គ្នា ពង្រឹង កិច្ចសហប្រតិបត្តិការ ប្រឆាំង នឹង ការជ្រៀត ជ្រែក ពី ខាងក្រៅ និង បដិវត្តន៍ ពណ៌ ។
រក្សា ការចូលរួម យោធា កម្រិត ខ្ពស់ ដើម្បី ពង្រឹង ការប្រាស្រ័យទាក់ទង គ្នា និង ការផ្លាស់ប្តូរ រវាង ស្ថាប័ន និង អង្គភាព ពាក់ព័ន្ធ នៃ កងកម្លាំងប្រដាប់អាវុធ ទាំង ពីរ ធ្វើឱ្យ ស៊ីជម្រៅ នូវ កិច្ចសហប្រតិបត្តិការ ជាក់ស្តែង ក្នុង ការបណ្តុះបណ្តាល ការធ្វើ សមយុទ្ធ រួមគ្នា សេវាកម្ម វេជ្ជសាស្ត្រ ភស្តុភារកម្ម និង ការដោះ មីន ។ល ។ ក៏ ដូចជា ការបង្កើន ការសម្របសម្រួល និង កិច្ចសហប្រតិបត្តិការ ក្នុង វេទិកា ពហុ ភាគី ។
បន្ត ធ្វើឱ្យ ស៊ីជម្រៅ កិច្ចសហប្រតិបត្តិការ ជាក់ស្តែង លើ វិស័យ នគរបាល និង ការកសាង សមត្ថភាព ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ មូលដ្ឋាន នៃ ប្រទេស ទាំង ពីរ ក្នុង ការប្រយុទ្ធ ប្រឆាំង ការលេង ល្បែង ស៊ីសង ឆ្លង ដែន ការបោកប្រាស់ តាម ប្រព័ន្ធ ទូរគមនាគមន៍ អនុវត្ត កិច្ចសហប្រតិបត្តិការ សន្តិសុខ លើ គម្រោង នៃ ខ្សែក្រវាត់ និង ផ្លូវ សំខាន់ ៗ ។
បង្កើន ការផ្លាស់ប្តូរ និង កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ សុខាភិបាល រួមទាំង ឱសថ បុរាណ ចិន និង វិទ្យាសាស្ត្រ វេជ្ជសាស្ត្រ បុរាណ ចិន ជំរុញ ការបង្កើត មជ្ឈមណ្ឌល សហប្រតិបត្តិការ ឱសថ បុរាណ កម្ពុជា - ចិន ។ ភាគី ចិន នឹង បន្ត បញ្ជូន ក្រុម គ្រូពេទ្យ ឱសថ បុរាណ ចិន មក កម្ពុជា ។
កម្ពុជា និង ចិន បាន ចុះហត្ថលេខា លើ ផែនការ សកម្មភាព នៃ ការ កសាង សហគមន៍ វាសនា រួម កម្ពុជា - ចិន ក្នុង យុគសម័យ ថ្មី រវាង រាជ រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋាភិបាល ចិន ( ឆ្នាំ ២០២៤ - ២០២៨ ) និង ឯកសារ កិច្ចសហប្រតិបត្តិការ មួយចំនួន ទៀត ស្តីពី៖ ច្រក របៀង ឧស្សាហកម្ម និង បច្ចេកវិទ្យា ច្រក របៀង មច្ឆា និង អង្ករ ហេដ្ឋារចនាសម្ព័ន្ធ សេដ្ឋកិច្ច ឌីជីថល ការអភិវឌ្ឍ បៃតង ការត្រួតពិនិត្យ និង ចត្តាឡី ស័ក ព្រៃឈើ និង សត្វ ព្រៃ កិច្ចសហប្រតិបត្តិការ អភិវឌ្ឍន៍ ។
ដោយ លោក អ៊ុច លា ង៖ អ្នកសិក្សា ស្រាវជ្រាវ នៃ នាយកដ្ឋាន សិក្សា អាស៊ី អាហ្វ្រិក និង មជ្ឈិមបូព៌ា នៃ វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ថវិកា មូលនិធិ មហា គ្រួសារ កងរាជអាវុធហត្ថ ត្រូវបាន ប្រគល់ ជូន គ្រួសារ សព សមាជិក មន្ត្រី អាវុធហត្ថ រាជធានី ភ្នំពេញ
ថវិកា ទាំងអស់ នេះ គឺ បាន មកពី ការបរិច្ចាគ ដោយ ស្ម័គ្រចិត្ត ប្រកបដោយ ទឹកចិត្ត សប្បុរសធម៌ របស់ លោក នាយ ឧត្តមសេនីយ៍ លោក លោកស្រី ដែល ជា នាយ ទាហាន នាយ ទាហាន រង នៃ កងរាជអាវុធហត្ថ ទូទាំង ប្រទេស ក្នុង ការចូលរួម ចែករំលែក ទុក្ខលំបាក គ្នា ទៅ វិញ ទៅមក ។
ព្រម ជាមួយគ្នា នោះ ក្រុមការងារ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា ជូន ចំពោះ ក្រុមគ្រួសារ សព ផងដែរ ។
នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ក្រុម អ្នកនាំពាក្យ នៃ ខុទ្ទកាល័យ នាយក រដ្ឋមន្ត្រី ស្តីពី ខ្លឹមសារ នៃ ជំនួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ រវាង សម្តេច មហា បវរធិបតី ជាមួយ នាយ ឧត្តមសេនីយ៍ ហឺ វ័យ ទុង ដែល បាន ធ្វើឡើង នៅ វិមាន សន្តិភាព នៅ ព្រឹក ថ្ងៃចន្ទ ទី៤ ខែធ្នូ ឆ្នាំ ២០២៣ ។
នាយ ឧត្តមសេនីយ៍ បាន មាន ជំនឿ ថា ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ក្នុង អាណត្តិ ទី៧ ទំនាក់ទំនង ជា ប្រពៃណី រវាង ប្រទេស ទាំង ពីរ កាន់តែ រឹងមាំ និង សម្រេចបាន នូវ លទ្ធផល ជា ផ្លែ ផ្កា នៃ ការជំរុញ ការកសាង សហគមន៍ ជោគវាសនា រួម កម្ពុជា - ចិន ផងដែរ ៕ ក្រុមហ៊ុន ផលិតផលិតផល វេជ្ជសាស្ត្រ ដ៏ ធំ មួយ របស់ ចិន សម្លឹង រក ការវិនិយោគ នៅ កម្ពុជា
ជំនួប នេះ បាន ជជែក ពិភាក្សា លើ គម្រោង វិនិយោគ របស់ ក្រុមហ៊ុន ក្នុង ការបង្កើត រោងចក្រ ផលិតផលិតផល វេជ្ជសាស្រ្ត និង ឧបករណ៍ សម្រាប់ ធ្វើ រោគវិនិច្ឆ័យ ទំនើប ដើម្បី ផ្គត់ផ្គង់ នៅលើ ទីផ្សារ ប្រទេស កម្ពុជា និង នៅក្នុង តំបន់ ។ បន្ថែម ក្នុង កិច្ចប្រជុំ ក្រុមហ៊ុន ក៏ បាន បង្ហាញ គោលបំណង ក្នុង ការពិនិត្យ លទ្ធភាព បង្កើត ឱ្យ មាន តំបន់ ឧស្សាហកម្ម ផ្នែក វេជ្ជសាស្រ្ត ដែល រួមបញ្ចូល លើ ការផលិត សម្ភារ វេជ្ជសាស្រ្ត កន្លែង សិក្សា ស្រាវជ្រាវ ន វានុវត្តន៍ មន្ទីរពេទ្យ និង គ្លីនិក ជាដើម ។
សន្និសីទ អគ្គ ព្រះរាជអាជ្ញា អាស៊ាន - ចិន លើក ទី១៣ រៀបចំឡើង ក្រោម ប្រធានបទ ស្តីពី « ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង ការទប់ស្កាត់ និង ការប្រយុទ្ធ ប្រឆាំង នឹង ឧក្រិដ្ឋកម្ម បច្ចេកវិទ្យា កម្រិត ខ្ពស់ និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន » តប តាម ការអញ្ជើញ របស់ លោក លី មិញ ទ្ធី អគ្គ ព្រះរាជអាជ្ញា នៃ មហា អយ្យការ អម តុលាកា រ ប្រជាជន សាធារណៈ រដ្ឋ សង្គម និយម វៀតណាម ។
គោលបំណង សំខាន់ នៃ សន្និសីទ អគ្គ ព្រះរាជអាជ្ញា អាស៊ាន - ចិន គឺ កំណត់ ឱ្យ បាន ច្បាស់ នូវ ការតាំងចិត្ត ដើម្បី ប្រយុទ្ធ ប្រឆាំង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន និង ឆ្លង តំបន់ ដោយ អំពាវនាវ ដល់ ស្ថាប័ន អយ្យការ ឱ្យ សហការ គ្នា ឱ្យ បាន ជិតស្និទ្ធិ ដើម្បី ប្រយុទ្ធ ប្រឆាំង អំពើ ភេរវកម្ម ភេរវកម្ម ហិរញ្ញវត្ថុ ការជួញដូរ គ្រឿងញៀន ការរត់ ពន្ធ ឆ្លង ដែន អំពើពុករលួយ ឧក្រិដ្ឋកម្ម បច្ចេកវិទ្យា និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ដែល មាន អង្គការ ចាត់តាំង ។
សន្និសីទ អគ្គ ព្រះរាជអាជ្ញា អាស៊ាន - ចិន លើក ទី ១៣ ខាងមុខ នេះ គឺ ត្រូវបាន ចាត់ទុក ជា វេទិកា នៃ មហា អយ្យការ ក្នុង តំបន់ មួយ ពោល គឺ៖ អគ្គ ព្រះរាជអាជ្ញា អគ្គ រដ្ឋអាជ្ញា និង ប្រធាន ប្រតិភូ មកពី បណ្តា ប្រទេស អាស៊ាន និង ប្រទេស ចិន រួមគ្នា ជជែក ចែករំលែក ផ្លាស់ប្តូរ បទពិសោធន៍ បង្ហាញ នូវ ធាតុ ចូល និង ឧត្តមានុវត្តន៍ ដើម្បី រួមគ្នា ដោះស្រាយ បញ្ហា ឧក្រិដ្ឋកម្ម បច្ចេកវិទ្យា និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ។
ចុងបញ្ចប់ នៃ សន្និសីទ អគ្គ ព្រះរាជអាជ្ញា អាស៊ាន - ចិន លើក ទី១៣ អគ្គ ព្រះរាជអាជ្ញា អាស៊ាន - ចិន នឹង ចេញ នូវ សេចក្តីប្រកាស រួម មួយ ដែល ជា ឧបករណ៍ គតិយុត្ត មួយ សម្រាប់ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង តំបន់ ទប់ស្កាត់ និង ប្រយុទ្ធ ប្រឆាំង ឧក្រិដ្ឋកម្ម បច្ចេកវិទ្យា និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ហើយ ស្រប ទៅនឹង អនុសញ្ញា អង្គការ សហ ប្រជាជាតិ ស្តីពី ការប្រយុទ្ធ ប្រឆាំង នឹង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ៕ ពិធី បើក វេទិកា អ្នកវិទ្យាសាស្ត្រ Tengchong ឆ្នាំ ២០២៣ បាន បើក ធ្វើ នៅ ខេត្ត Yunnan
ពិធី ប្រកាស ដាក់ ឱ្យ អនុវត្ត គោល នយោបាយ ជាតិ និង ផែនការ យុទ្ធសាស្ត្រ ជាតិ សុខភាព ជន ទេសន្តរប្រវេសន៍ ២០២២ - ២០៣០
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល នា ព្រឹក ថ្ងៃ ០៤ ខែធ្នូ ឆ្នាំ ២០២៣ បាន អញ្ជើញ ចូលរួម ក្នុង ឱកាស ប្រារព្ធ ពិធី ប្រកាស ដាក់ ឱ្យ អនុវត្ត គោល នយោបាយ ជាតិ និង ផែនការ យុទ្ធសាស្ត្រ ជាតិ សុខភាព ជន ទេសន្តរប្រវេសន៍ ២០២២ - ២០៣០ ដែល ប្រព្រឹត្ដទៅ នៅ សណ្ឋាគារ សូហ្វី តែ ល ភ្នំពេញ ភូគី ត្រា ។
ការដាក់ចេញ ឱ្យ អនុវត្ត នូវ គោល នយោបាយ ជាតិ និង ផែនការ យុទ្ធសាស្រ្ត ជាតិ ស្តីពី សុខភាព ជន ទេសន្តរប្រវេសន៍ ២០២២ - ២០៣០ នា ថ្ងៃ នេះ ពិតជា ឆ្លើយតប ទៅនឹង កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា គឺ ការគាំពារ ដល់ ប្រជាជន ក្នុង ការឆ្លើយតប ចំពោះ ហានិភ័យ សេដ្ឋកិច្ច ហានិភ័យ សុខភាព សាធារណ: ។
ពលរដ្ឋ ទាំងនេះ រង ផល ប៉ះពាល់ ដោយ គ្រោះ រាំងស្ងួត និង គ្រោះ ទឹក ជំនន់ ក្នុង ភូមិសាស្រ្ដ ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ចំនួន ២៦៨ គ្រួសារ ដែល មកពី ឃុំ ៣ ក្នុង នោះ មាន៖ ឃុំ ព្រែក នរិន្ទ ចំនួន ៩០ គ្រួសារ . ឃុំ សំរោង ក្នុង ចំនួន ៧គ្រួសារ . ឃុំ ព្រែក ខ្ពប ចំនួន ១៧១ គ្រួសារ ៕
លោក ហ៊ុន ម៉ានី៖ យុទ្ធនាការ ភ្នំពេញ ស្អាត បាន កំពុង រួមចំណែក យ៉ាង សកម្ម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ និង ជា សហ ស្ថាបនិក នៃ គម្រោង ស្អាត បាន លើកឡើង ថា យុទ្ធនាការ ភ្នំពេញ ស្អាត បាន កំពុង រួមចំណែក យ៉ាង សកម្ម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៣ ខែធ្នូ ឆ្នាំ ២០២៣ ក្នុង ពិធី បិទ យុទ្ធនាការ ភ្នំពេញ ស្អាត ឆ្នាំ ២០២៣ នៅ មជ្ឃ មណ្ឌល មានី (KAMPUS) តំណាង ក្រសួង ស្ថាប័ន មួយចំនួន ក្រុមហ៊ុន ឯកជន សមាគម អង្គការ សង្គម ស៊ីវិល យុវជន សុច្ឆន្ទៈ ស្អាត ជាច្រើន រូប ។
លោក បាន បន្ដ ថា យុទ្ធនាការ ភ្នំពេញ ស្អាត បាន កំពុង រួមចំណែក យ៉ាង សកម្ម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ពេល កន្លងមក និង សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ជាពិសេស ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ក្រោម ការដឹកនាំ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ ដូចជា ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ក្នុង ការចូលរួម ដោះស្រាយ បញ្ហា សំរាម នៅក្នុង រាជធានី ភ្នំពេញ ។
ជាក់ស្ដែង យុទ្ធនាការ ភ្នំពេញ ស្អាត បាន ផ្ដោត លើ សកម្មភាព ធំ ៗ ចំនួន ៤ រួម មាន៖ ទី១៖ ចិត្ត ខ្ញុំ ស្អាត ខ្មែរ ស្អាត . ទី ២៖ ការងារ ខ្ញុំ ស្អាត ខ្មែរ ស្អាត . ទី ៣៖ ខ្ញុំ ទំពាំង ស្អាត ខ្មែរ ស្អាត និង ទី៤៖ ធុរកិច្ច យើង ស្អាត ខ្មែរ ស្អាត ។ នៅ ឆ្នាំ ២០២៣ « យុទ្ធនាការ ភ្នំពេញ ស្អាត » មាន ការ ដាក់ចេញ នូវ គម្រោង ផែនការ សកម្មភាព ចំនួន បួន ធំ ៗ ក្រោម ទិស ស្លោក « សីលធម៌ យើង ប្រពៃណី ខ្មែរ យើង ថ្លា ថ្លៃ » ផ្ដោត សំខាន់ លើ ការបជ្រោប សារ អប់រំ ដើម្បី លើកតម្កើន វប្បធម៌ និង សីលធម៌ សមរម្យ ។
( ភ្នំពេញ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ៤ ខែធ្នូ ឆ្នាំ ២០២៣ បាន អញ្ជើញ ពិនិត្យមើល ដំណើរការងារ របស់ មន្រ្តី កំពុង ប្រចាំ ការ នៅ ច្រក ចេញ ចូល តែ មួយ របស់ ក្រសួង ព័ត៌មាន ។ ក្រសួង ព័ត៌មាន បាន រៀបចំ ដាក់ ឲ្យ ដំណើរការច្រក ចេញ ចូល តែ មួយ កាលពី ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២៣ ដែល មាន មន្រ្តី មកពី អគ្គ នាយកដ្ឋាន ទាំង៥ ប្រចាំ ការ ដើម្បី ទទួល ឯកសារ និង ផ្តល់ សេវា សាធារណៈ ។
ក្រសួង ព័ត៌មាន បាន កំណត់ ទីតាំង ជាក់លាក់ នៅ ខាងមុខ អគារ ទីស្តីការ ក្រសួង ព័ត៌មាន និង មាន មន្ត្រី ប្រចាំ ការ នៅ ច្រក ចេញ ចូល តែ មួយ ដើម្បី ទទួល បម្រើ សេវា ជូន អតិថិជន ឱ្យ បាន ទាន់ ពេលវេលា តាម ការកំណត់ ។
តាមរយៈ ប្រកាស រួម ស្តីពី ការផ្តល់ សេវា សាធារណៈ របស់ ក្រសួង ព័ត៌មាន គឺ ក្រសួង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ សម្រច អនុញ្ញាតឲ្យ ក្រសួង ព័ត៌មាន អនុវត្ត ការប្រមូល ចំណូល ពី កម្រៃ សេវា សាធារណៈ ដើម្បី ជា គុណ ប្រយោជន៍ ថវិកា ជាតិ ។
កម្រង សេវា សាធារណៈ នេះ មាន បញ្ជាក់ លម្អិត អំពី តម្លៃ សេវា រយៈពេល ផ្តល់ សេវា និង សុពលភាព ទៅ តាម ប្រភេទ សេវា សាធារណៈ នីមួយ ៗ ដូច មាន ចែង នៅក្នុង តារាង ឧបសម្ព័ន្ធ ភ្ជាប់ មក ជាមួយនឹង ប្រកាស រួម នេះ ។
ក្រសួង ព័ត៌មាន ត្រូវ បិទ ផ្សាយ ជាសាធារណៈ ជាពិសេស នៅ កន្លែង ផ្តល់ សេវា នូវ ស្តង់ដារ សេវា ក្នុង នោះ រួម មាន៖ តារាង តម្លៃ ទម្រង់ ឯកសារ និង នីតិវិធី សម្រាប់ ការផ្តល់ សេវា ពាក់ព័ន្ធ នឹង ការប្រមូល ចំណូល ខាងលើ នេះ ។ ក្រសួង ព័ត៌មាន ត្រូវ រៀបចំ ឱ្យ មាន កន្លែង ទទួលបណ្ដឹង តវ៉ា ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ជាពិសេស ក្នុង ករណី មាន ការអនុវត្ត ខុសពី ស្តង់ដារ សេវា ឬ មាន ការយក កម្រៃ លើស ការកំណត់ ឬ មាន ការយឺតយ៉ាវ ជាដើម ។
ក្រសួង ព័ត៌មាន មាន ភារកិច្ច ប្រមូល ចំណូល ទទួលខុសត្រូវ ប្រាក់ ចំណូល ដែល ប្រមូល បាន និង បង់ប្រាក់ ចំណូល ចូល ថវិកា ជាតិ ក្នុង នោះ ត្រូវ ចុះ កិច្ច បញ្ជី កាគណនេយ្យ ស្តីពី កិច្ច ប្រតិបត្តិការ ចំណូល និង កត់ត្រា តាមដាន ប្រាក់ ចំណូល នៅក្នុង ជំពូក គណនី អនុគណនី នៃ មាតិកា ថវិកា ព្រមទាំង ធ្វើ សលាក ប័ត្រ ចំណូល ។
ការបែងចែក ការកិច្ច លើ ការគ្រប់គ្រង ការប្រមូល ចំណូល ពី ការផ្តល់ សេវា សាធារណៈ រវាង រដ្ឋបាល កណ្ដាល នៃ ក្រសួង ព័ត៌មាន និង មន្ទីរព័ត៌មាន រាជធានី ខេត្ត ត្រូវ កំណត់ ដោយ ប្រកាស របស់ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ។
ក្រសួង ព័ត៌មាន ត្រូវ ផ្ញើ សេចក្តីប្រកាស នេះ ចំនួន មួយ ច្បាប់ ជូន ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដើម្បី ជូន ជ្រាប ជា ព័ត៌មាន និង សម្រាប់ តាមដាន ការអនុវត្ត ចំណូល ។
រាល់ ការប្រមូល ចំណូល ពី កម្រៃ សេវា សាធារណៈ ដូច មាន ចែង នៅក្នុង តារាង ឧបសម្ព័ន្ធ ភ្ជាប់ មក ជាមួយ ប្រកាស រួម នេះ ត្រូវ ប្រើប្រាស់ បង្កាន់ដៃ បង់ប្រាក់ ដែល បាន បើក ផ្តល់ ដោយ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ស្រប តាម ប្រកាស ចុះ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០១១ ស្ដីពី ការដាក់ ឱ្យ ប្រើប្រាស់ បង្កាន់ដៃ បង់ប្រាក់ និង សារាចរ ណែនាំ ស្ដីពី ការគ្រប់គ្រង បង្កាន់ដៃ បង់ប្រាក់ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
ក្រសួង ព័ត៌មាន ត្រូវ ធ្វើ របាយការណ៍ ស្តីពី ការអនុវត្ត ចំណូល ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ ដើម្បី ផ្ញើ មក ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ឱ្យ បាន មុន ថ្ងៃទី១០ នៃ ខែ បន្ទាប់ សម្រាប់ របាយការណ៍ ប្រចាំ ខែ និង ឱ្យ បាន មុន ថ្ងៃទី ១៥ ខែមករា នៃ ឆ្នាំ បន្ទាប់ សម្រាប់ របាយការណ៍ ប្រចាំ ឆ្នាំ ៕
សូម ទស្សនិកជន ទស្សនា ការ លើកឡើង របស់ លោក បណ្ឌិត ដូចត ទៅ៖
កម្លាំង អាវុធហត្ថ ខេត្ត ព្រះសីហនុ ឃាត់ខ្លួន ជនសង្ស័យ ៦នាក់ បន្លំ ជា ព្រះសង្ឃ ដើរ ប្រមូល បច្ច័យ នៅ ស្រុក ព្រៃនប់
( ព្រះសីហនុ) ៖ កម្លាំង កងរាជអាវុធហត្ថ ក្រុង ព្រះសីហនុ សហការ ជាមួយ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក ព្រៃនប់ បាន ឃាត់ ជនសង្ស័យ ចំនួន ៦នាក់ ដែល បន្លំ ធ្វើជា ព្រះសង្ឃ ដើរ ប្រមូល បច្ច័យ ប្រជាពុទ្ធ បរិស័ទ នៅ ចំណុច ភោជនីយដ្ឋាន ម៉ាម៉ា ក្នុង ភូមិ ពូធឿង ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ ។
ប្រតិបត្តិការ នេះ បាន ធ្វើឡើង ដោយ មាន ការចង្អុលបង្ហាញ ពី លោក ឧត្ដមសេនីយ៍ ត្រី ហេង ប៊ុន ទី មេបញ្ជា កងរាជអាវុធហត្ថ ខេត្ត ព្រះសីហនុ និង ក្រោម ការសម្របសម្រួល ពី លោក ពេញ ពិសិដ្ឋ ព្រះរាជអាជ្ញា រង ខេត្ត ព្រះសីហនុ ។
ក្រោយ ទទួលបាន ព័ត៌មាន ភ្លាម លោក វរសេនីយ៍ ត្រី អ៊ុក ពិសិដ្ឋ មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ព្រះសីហនុ បាន ចុះ ស្រាវជ្រាវ និង ឃាត់ បាន ជនសង្ស័យ ទាំងនេះ ដែល កំពុង ដើរ ប្រមូល បច្ច័យ ពី ប្រជាពុទ្ធ បរិស័ទ យ៉ាង សកម្ម បង្កឱ្យ ប៉ះពាល់ ដល់ វិស័យ ព្រះពុទ្ធ សាសនា ដែល ជា សាសនា របស់ រដ្ឋ ។
បច្ចុប្បន្ន ជនសង្ស័យ កំពុង សួរនាំ បន្ត នៅ ទីបញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង និង ចាត់ វិធានការ តាម នីតិវិធី ច្បាប់ តាម ពេល ក្រោយ ៕ លោក បណ្ឌិត កា ម៉ាធុល៖ ប៉ាឡេ ស្ទីន អាច ក្លាយជា ប្រទេស ពេញលេញ មួយ លុះត្រាតែ ប៉ាឡេស្ទីន ដើរ ចេញ ពី អង្គការ សហ ប្រជាជាតិ (Video inside)
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត កា ម៉ាធុល អ្នកជំនាញ ផ្នែក វិទ្យាសាស្រ្ត នយោបាយ បាន លើកឡើង ថា សង្រ្គាម នៅ ហ្កាហ្សា មិន អាច ធ្វើឲ្យ ប៉ាឡេ ស្ទីន ទទួលបាន នូវ សិទ្ធិ ស្រប ច្បាប់ ក្នុង នាម ជា ប្រទេស ឯករាជ្យ មួយ ដែល ទទួលស្គាល់ ដោយ អង្គការ សហ ប្រជាជាតិ បាន នោះ ឡើយ ។ ការ មិន អាច ទទួលបាន នូវ សិទ្ធិ ស្រប ច្បាប់ នេះ ព្រោះ ក្នុង អង្គការ សហ ប្រជាជាតិ មាន សហរដ្ឋ អាមេរិក ជា អ្នកជំទាស់ ហើយ ប្រទេស មួយចំនួន ទៀត អាចនឹង ខាតបង់ ប្រយោជន៍ ប្រសិជា ប៉ាឡេស្ទីន ក្លាយជា ប្រទេស ស្រប ច្បាប់ មួយ បាន ។
បើ តាម អ្នកជំនាញ វិទ្យាសាស្រ្ត នយោបាយ ខាងលើ អាច មាន ផ្លូវ មួយ ដែល ប៉ាឡេស្ទីន អាច ក្លាយជា ប្រទេស ដែល មាន ការទទួលស្គាល់ ជា សកល បាន គឺ ចាកចេញ ពី អង្គការ សហ ប្រជាជាតិ ហើយ ស្វែងរក អង្គការ ក្នុង តំបន់ ឬ អន្តរជាតិ ណា ផ្សេង ដែល ព្រម ទទួលស្គាល់ ប៉ាឡេ ស្ទីន ជា រដ្ឋ ឯករាជ្យ និង អាច ការពារ ភាព ស្រប ច្បាប់ របស់ ប៉ាឡេ ស្ទីន លើ ឆាក អន្តរជាតិ បាន ។
សូម ទស្សនិកជន ទស្សនា កិច្ចសម្ភាសន ដូចត ទៅ៖
ទិវា ពិភពលោក ប្រយុទ្ធ និង ជំងឺ អេដស៍ ១ ធ្នូ ២០២៣ ក្រោម ប្រធានបទ « សហគមន៍ តែ មួយ ដឹកនាំ ឆ្ពោះទៅ បញ្ចប់ ជំងឺ អេដស៍ »
( ព្រៃវែង ) ៖ លោក ហ៊ី ធួក អភិបាល រង ខេត្ត និង ប្រធាន គណៈកម្មាធិការ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ៤ ខែធ្នូ ឆ្នាំ ២០២៣ បាន ប្រារព្ធ ពិធី ទិវា ពិភពលោក ប្រយុទ្ធ និង ជំងឺ អេដស៍ ១ ធ្នូ ២០២៣ ក្រោម ប្រធានបទ « សហគមន៍ តែ មួយ ដឹកនាំ ឆ្ពោះទៅ បញ្ចប់ ជំងឺ អេដស៍ » ។
លោក ហ៊ី ធួក ក៏ បាន អាន សាលិខិត សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង ជា ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ វេទិកា ភាព ជា អ្នកដឹកនាំ តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក ឆ្លើយតប មេរោគ អេដស៍ ជំងឺ អេដស៍ និង ការអភិវឌ្ឍ នៅ កម្ពុជា ក្នុង ឱកាស ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ១ ធ្នូ ២០២ ក្រោម ប្រធានបទ « សហគមន៍ តែ មួយ ដឹកនាំ ឆ្ពោះទៅ បញ្ចប់ ជំងឺ អេដស៍ » ។
ក្នុង ឱកាស ដ៏ មាន អត្ថន័យ នេះ សូម ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល កន្លងមក ក្រោម ការ ដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន និង បច្ចុប្បន្ន បន្ត ដឹកនាំ ដោយ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ដែល តែងតែ ប្ដេជ្ញាចិត្ត យ៉ាង មោះ មុត ក្នុង ការដឹកនាំ បំផុស ចលនា ចូលរួម ជា ចរន្ត ជាតិ តែ មួយ ក្នុង ការទប់ស្កាត់ ការចម្លង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ ឱ្យ ទទួលបាន ជោគជ័យ ជា បន្តបន្ទាប់ និង មាន ការទទួលស្គាល់ ពី មជ្ឈដ្ឋាន ជាតិ អន្តរជាតិ ជាពិសេស ពី ស្ថាប័ន អង្គការ សហ ប្រជាជាតិ ថែម ទៀត ផង ។
ជាមួយគ្នា នេះ កាកបាទ ក្រហម កម្ពុជា និង ក្រុមការងារ ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ បាន ប្តេជ្ញាចិត្ត ខ្ពស់ ក្នុង ការចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ឆ្ពោះទៅ សម្រេច គោលដៅ ដែល ជា មោទនភាព ថ្មី មួយ ទៀត ដែល នោះ គឺជា ការឈាន ទៅ បញ្ចប់ ជំងឺ អេដស៍ នៅ ឆ្នាំ ២០២៥ ។
តំណាង អយ្យការ កំពុង ចាត់ការករណី ស្រ្តី ម្នាក់ ស្រវឹង ស្រា បើក រថយន្ត ស៊េរី ទំនើប បុក បុរស ជិះ ម៉ូតូ អាគុយ បណ្ដាលឱ្យ ស្លាប់ នៅមុខ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ
( ភ្នំពេញ ) ៖ មន្ត្រី សាលាដំបូង រាជធានី ភ្នំពេញ បាន ឱ្យ បណ្តាញ អង្គភាព ព័ត៌មាន Fresh News ដឹង នៅ រសៀល ថ្ងៃទី ៤ ខែធ្នូ ឆ្នាំ ២០២៣ ថា ព្រះរាជអាជ្ញា រង អម សាលាដំបួង ដែល ទទួលបន្ទុក ករណី ស្រ្តី ស្រស់ស្អាត ម្នាក់ ស្រវឹង ស្រា បើក រថយន្ត ស៊េរី ទំនើប បុក បុរស ជិះ ម៉ូតូ អាគុយ បណ្ដាលឱ្យ ស្លាប់ នៅមុខ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ កំពុង សាកសួរ ជន បង្ក ទៅតាម នីតិវិធី ។
សូម រំលឹក ថា មាន ហេតុការ ដ៏ រន្ធត់ មួយ បាន កើតឡើង ដោយ បុរស ម្នាក់ បាន ស្លាប់ បាត់បង់ជីវិត ភ្លាម ៗ បន្ទាប់ពី ជិះ ម៉ូតូ អាគុយ សុខ ៗ ត្រូវបាន នារី ស្រស ស្អាត ស្រវឹង ស្រា ម្នាក់ បើក រថយន្ត ស៊េរី ទំនើប បុក អូស ជាច្រើន ម៉ែត្រ កាលពី វេលា ម៉ោង ១៖៣០ នាទី យប់ រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃសៅរ៍ ទី២ ខែធ្នូ ឆ្នាំ ២០២៣ ត្រង់ ចំណុច មុខ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ តាម បណ្ដោយ ផ្លូវ សហព័ន្ធ រុស្ស៊ី ក្នុង សង្កាត់ កាកាបទី១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
បើ តាម សមត្ថកិច្ច បាន ប្រាប់ ឲ្យដឹង ថា ជនរងគ្រោះ មាន ឈ្មោះ សុខ ម៉ាល័យ អាយុ ៣៤ ឆ្នាំ មុខរបរ លើ ឥវ៉ាន់ ក្នុង ប្រលានយន្តហោះ រស់ នៅក្នុង សង្កាត់ កាកាបទី១ ខណ្ឌ ពោធិ៏ សែន ជ័យ រាជធានី ភ្នំពេញ ។
ចំណែក សមត្ថកិច្ច ជំនាញ បាន ចុះ មក វាស់វែង យកមធ្យោបាយ ទាំង ពីរ គ្រឿង ទៅ រក្សាទុក នៅ ការិយាល័យ ចរាចរណ៍ ផ្លូវគោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ រង់ចាំ ដោះស្រាយ តាម ច្បាប់ នៅ ពេល ក្រោយ ។ ដោយឡែក សព សមត្ថកិច្ច ធ្វើ កំណត់ហេតុ រួច ប្រគល់ ឱ្យ សាច់ញាតិ ដឹក ទៅ គេហដ្ឋាន ធ្វើ បុណ្យ តាម ប្រពៃណី ៕ គណៈកម្មការ កិច្ចការ បរទេស រដ្ឋសភា កម្ពុជា និង ឡាវ ជួប ពិភាក្សា ទ្វេ ភាគី ដេីម្បី បន្ត ពង្រឹង ពង្រីក កិច្ចសហប្រតិបត្តិការ រដ្ឋសភា ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ប្រសើរឡើង
• ភាគី ទាំង ពីរ ស្វាគមន៍ ទំនាក់ទំនង ជា ប្រពៃណី នៃ ការផ្លាស់ប្តូរ ទៅ វិញ ទៅ មក កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី និង ពហុ ភាគី ដោយ បន្ត គាំទ្រ គ្នា ទៅ វិញ ទៅ មក នៅក្នុង វេទិកា សភា តំបន់ និង អន្តរជាតិ ។
• រដ្ឋសភា ទាំង ពីរ នឹង បន្ត សហការ គ្នា អនុវត្ត អនុស្សរណៈ យោគយល់ គ្នា ដែល បាន ចុះហត្ថលេខា រួចហើយ រវាង រដ្ឋសភា ទាំង ពីរ និង បន្ត តាមដាន ការអនុវត្ត កិច្ចព្រមព្រៀង នានា ដែល រដ្ឋាភិបាល នៃ ប្រទេស ទាំង ពីរ បាន ព្រមព្រៀង រួចហើយ ។ ភាគី ទាំង ពីរ ក៏ បាន កោតស សើរ អំពី ការផ្លាស់ប្តូរ ក្រុម មិត្តភាព រដ្ឋសភា កម្ពុជា - ឡាវ ដែល បាន សហការ គ្នា យ៉ាង ល្អ ក្នុង វិស័យ វប្បធម៌ អប់រំ កីឡា និង ទេសចរណ៍ ។
គួរ បញ្ជាក់ ថា មេដឹកនាំ បេឡារុស កំពុង ស្ថិត នៅក្នុង ទីក្រុង ប៉េកាំង សម្រាប់ កិច្ចពិភាក្ស ដែល ផ្តោត លើ វិស័យ ពាណិជ្ជកម្ម និង ជា ដំណើរទស្សនកិច្ច លើក ទី ២ ក្នុង ឆ្នាំ ២០២៣ គិត ចាប់ពី ខែមីនាមក ៕ រូបភាព ពី Reuters វេទិកា ដោះស្រាយ សំណូមពរ និង កង្វល់ របស់ ពលរដ្ឋ ស្រុក ចំការលើ . ក្រុមប្រឹក្សា និង រដ្ឋបាល ខេត្ត ដោះស្រាយ ភ្លាម ៗ បាន ៤ករណី និង នៅសល់ មួយចំនួន យក ទៅ ពិភាក្សា ដោះស្រាយ តាម និតិវិធី រដ្ឋបាល
( កំពង់ចាម ) ៖ ក្នុង វេទិកា ផ្សព្វផ្សាយ ពិគ្រោះយោបល់ ដើម្បី ដោះស្រាយ សំណើរ សំណូមពរ និង កង្វល់ របស់ ប្រជាពលរដ្ឋ នៅក្នុង ស្រុក ចំការលើ ក្រុមប្រឹក្សា និង រដ្ឋបាល ខេត្ត ទទួលបាន សំណើរ សំណូមពរ និង កង្វល់ ចំនួន សរុប ចំនួន ២២ ក្នុង នោះ ដោះស្រាយ ភ្លាម ៗ បាន ចំនួន ៤ករណី និង នៅ សេសសល់ ត្រូវបាន យក ទៅ ពិភាក្សា ដោះស្រាយ តាម និតិវិធី រដ្ឋបាល ។
វេទិកា នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ៤ ខែធ្នូ ឆ្នាំ ២០២៣ ក្នុង បរិវេណ វត្ត តា អុង ភូមិ តា អុង ឃុំ តា អុង ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម ក្រោម អធិបតីភាព លោក ខ្លូត ផន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ខ្លូត ចិន្តា អភិបាល រង ខេត្ត កំពង់ចាម ព្រមទាំង មាន ការចូលរួម ពី មន្រ្តី អង្គភាព ពាក់ព័ន្ធ និង ប្រជាពលរដ្ឋ សរុប ៥៣៨ នាក់ ។
ស្ថិត ក្នុង ឱកាស នោះ លោក ខ្លូត ផន បាន ថ្លែង ថា ថ្មី ៗ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា នីតិកាល ទី៧ នៃ រដ្ឋសភា ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ ដើម្បី កំណើន ការងារ សមធម៌ ប្រសិទ្ធភាព និង ចីរភាព ព្រមទាំង បន្ត ការអនុវត្ត អភិក្រម ឆ្លុះបញ្ចក់ ងូតទឹក ដុស ក្អែល ព្យាបាល និង វះកាត់ ។ យុទ្ធសាស្ត្រ - ដំណាក់កាល ទី១ កំណត់ យក នូវ អាទិភាព គន្លឹះ ចំនួន ៥ គឺ៖ មនុស្ស ផ្លូវ ទឹក ភ្លើង និង បច្ចេកវិទ្យា ។
លោក ខ្លូត ផន បាន គូសបញ្ជាក់ ថា វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ នា ពេលនេះ ពិតជា បាន ផ្ដល់ ឱកាស ដល់ ប្រជាពលរដ្ឋ ទទួលបាន នូវ ព័ត៌មាន និង បាន ស្តាប់ នូវ របាយការណ៍ បូកសរុប លទ្ធផល ការងារ ដែល ក្រុមប្រឹក្សា និង គណៈ អភិបាល ខេត្ត សម្រេចបាន ក្នុង ឆ្នាំ កន្លងទៅ ហើយក៏ ជា ឱកាស មួយ សម្រាប់ ប្រជាពលរដ្ឋ លើកឡើង នូវ សំណួរ និង សំណូមពរ ដើម្បី ក្រុមប្រឹក្សា ធ្វើ ការពិភាក្សា និង ឆ្លើយតប ។
ការកោតសរសើរ បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង ក្នុង ឱកាស សម្តេច អញ្ជើញ ជា អធិបតី ប្រកាស បិទ ពិធី បុណ្យ សមុទ្រ នៅ ខេត្ត កែប នៅ ថ្ងៃទី ៣ ខែធ្នូ ឆ្នាំ ២០២៣ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំ ក៏ សូម យក ឱកាស នេះ កោតសរសើរ ដល់ ឯកឧត្តម បណ្ឌិត សោម ពិសិដ្ឋ ក៏ ដូចជា ថ្នាក់ដឹកនាំ នៃ គណៈអភិបាល ខេត្ត កែប ដែល បាន ខិតខំ ក្នុង ការបំពេញ កិច្ចកាកសាង និង អភិវឌ្ឍន៍ ខេត្ត កែប ជាពិសេស ក្នុង ការរៀបចំ សោភណ្ឌភាព បរិស្ថាន ក្នុង ខេត្ត កែប ដែល នាំឱ្យ ខេត្ត ទទួលបាន ជ័យលាភី ពានរង្វាន់ ថ្នាក់ ជាតិ និង ថ្នាក់ តំបន់ ជាបន្ទាប់ » ។
សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន បន្ថែម ថា ការអភិវឌ្ឍន៍ ទាំងនេះ បាន ផ្តល់ ផលប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ ខេត្ត កែប ទាំងមូល និង បាន ចែក ផល លាភ ទៅដល់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ។ សម្តេច ក៏ បាន ជំរុញ ឱ្យ អភិបាល ខេត្ត កែប បន្ត រៀបចំ ទីតាំង នៅ តាម បណ្តោយ ឆ្នេរ ប្រវែង ២.៧០០ម៉ែត្រ ទៅជា សួនច្បារ ដើម្បី ផលប្រយោជន៍ សាធារណៈ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ត ថា៖ « ផែនការ មេ ដែល បាន រៀបចំ រួច នៅ តាម បណ្តោយ ឆ្នេរ ២៧០០ម៉ែត្រ ត្រូវ រៀបចំ ជា សួនច្បារ សាធារណៈ ដែល អាចនឹង បង្កើត សក្តានុពល សម្រាប់ ខេត្ត កែប បន្ថែម ទៀត និង បន្ត រៀបចំ កម្មវិធី ទាក់ទាញ ភ្ញៀវ ទេសចរ » ។
សម្តេច ធិបតី ម៉ាណែត ក៏ បាន លើកឡើង ទៀត ថា រាជ រដ្ឋាភិបាល មាន ផែនការ សម្រាប់ អភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប នៅ ឆ្នាំ ២០២៣ - ២០៤៥ ដោយ បាន កំណត់ ចក្ខុវិស័យ ប្រែក្លាយ ខេត្ត កែប ជា ទេសចរណ៍ ធម្មជាតិ និង សមុទ្រ សម្រាក កម្សាន្ត បែប កម្រិត ខ្ពស់ ៕ ក្រុមហ៊ុន មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ និង វិភាគទាន ច្បាប់ បន្ត ចុះ អនុស្សរណៈ នៃ ការយោគយល់ លើក ទី៣
គួរ បញ្ជាក់ ផងដែរ ថា ស្ថាប័ន ទាំង ពីរ ធ្លាប់ បាន ចុះ អនុស្សរណៈ នៃ ការយោគយល់ ចំនួន ២លើក រួច មកហើយ ពោល ចាប់តាំងពី ឆ្នាំ ២០២០ មក ម្ល៉េះ ដោយ បាន ផ្តល់ នូវ ការ បណ្តុះបណ្តាល ជាពិសេស ផ្តោត សំខាន់ ទៅ លើ មុខវិជ្ជា រដ្ឋប្បវេណី ជូន ដល់ ព្រះសង្ឃ បុគ្គលិក មេធាវី ជំនួយការ ផ្នែក ច្បាប់ និស្សិត ឱ្យ បាន យល់ កាន់តែ ច្បាស់ អំពី មុខវិជ្ជា នេះ ផងដែរ ។ ការចុះអនុស្សរណៈ នៃ ការយោគយល់ លើក ទី៣ នេះ មាន គោលបំណង ធំ ៗ ចំនួន ០៣ គឺ៖
លោក មេធាវី លី រដ្ឋ ធី ប្រធាន ក្រុមហ៊ុន មេធាវី បាន ថ្លែង នៅក្នុង ពិធី ចុះ អនុស្សរណៈ នៃ ការយោគយល់ លើក ទី៣ នេះ ថា ក្រុមហ៊ុន មេធាវី CIC ពិតជា មាន ក្តី សោមនស្ស រីករាយ ដែល បាន សហការ ជាមួយ វិភាគទាន ច្បាប់ ដែល ជា ស្ថាប័ន បណ្តុះបណ្តាល និង ផ្សព្វផ្សាយ ច្បាប់ ដ៏ មាន សមត្ថភាព និង សក្តានុពល ពាក់ព័ន្ធ នឹង វិស័យ រដ្ឋប្បវេណី ថែមទាំង បាន ក្លាយទៅជា ដៃគូ សហការ យ៉ាង ស្អិត រមួត ក្នុង ការបណ្តុះបណ្តាល ធនធាន មនុស្ស និង ផ្សព្វផ្សាយ ច្បាប់ រដ្ឋប្បវេណី ផងដែរ ។
ជំនួប ពិភាក្សា រវាង ប្រធាន រដ្ឋសភា ទំាង ពីរ ធ្វើឡើង ក្រោម បរិយាកាស ដ៏ ស្និទ្ធស្នាល ប្រកបដោយ ការជឿ ទឹកចិត្ត និង យោគយល់ គ្នា ជា លក្ខណៈ បងប្អូន ។ ថ្នាក់ដឹកនាំ រដ្ឋសភា ប្រទេស ទំាង ពីរ បាន ប្តេជ្ញា រួមគ្នា ខិតខំ លើកកម្ពស់ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ នៃ ប្រទេស ទំាង ពីរ ដែល មាន ស្រាប់ ឱ្យ កាន់តែ សកម្ម គ្រប់ ជ្រុងជ្រោយ ថែម ទៀត ទំាង ខាង រដ្ឋសភា និង រដ្ឋាភិបាល ដើម្បី ធ្វើ យ៉ាងណា នាំមក នូវ ផលប្រយោជន៍ ជូន ពលរដ្ឋ ទំាង សងខាង ។
លោក THONGLOUN SISOULITH បាន ចាត់ទុក ដំណើរទស្សនកិច្ច របស់ សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ថា ជា ផ្នែក សំខាន់ មួយ នៅក្នុង ការបន្តពូន ជ្រំ ទំនាក់ទំនង ដ៏ ល្អ របស់ ប្រទេស ទំាង ពីរ ឱ្យ ស្ថិតស្ថេរ គង់វង្ស ។ ឯកឧត្តម បាន អបអរសាទរ ចំពោះ លទ្ធផល បោះឆ្នោត នៅ កម្ពុជា កាលពី ខែកក្កដា កន្លងមក ដែល នាំ ដល់ ការបង្កើត បាន នូវ រដ្ឋាភិបាល និង រដ្ឋសភា ថ្មី ពោរពេញ ដោយ សក្តានុពល ក្នុង ការបម្រើ ប្រទេសជាតិ ធ្វើឱ្យ ប្រទេស កម្ពុជា កាន់តែ រីកចម្រើន ទៅ មុខ ជាលំដាប់ ។
លោក ប្រធាន រដ្ឋ ក៏ បាន ចូលរួម អបអរសាទរ ជូន ចំពោះ សម្តេច រដ្ឋសភា ធិបតី ដែល ត្រូវបាន រដ្ឋសភា បោះឆ្នោត ជ្រើសតំាង ជា ប្រធាន រដ្ឋសភា អាណត្តិ ទី៧ និង ជា ស្រ្តី ដំបូង ប្រកបដោយ សមត្ថភាព ក្នុង ការកាន់ តួនាទី សំខាន់ នេះ ។
( បន្ទាយមានជ័យ )៖ នៅ ព្រឹក ថ្ងៃចន្ទ ទី៤ ខែធ្នូ ឆ្នាំ ២០២៣ ដោយ មាន ការយកចិត្តទុកដាក់ ពី លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ និង អនុវត្ត តាម បទបញ្ជា ផ្ទាល់ របស់ លោក វរសេនីយ៍ ឯក ហាំ វណ្ណៈ មេបញ្ជាការវរសេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៨៩១ លោក វរសេនីយ៍ ទោ ឈិន ឈាង មេបញ្ជាការ រង និង លោក វរសេនីយ៍ ត្រី អៀ ទ្រី មេបញ្ជាការ រង បាន ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ផែនការ និង លើក ទិសដៅ អនុវត្តន៍ បន្ត ។
ក្នុង ឱកាស នោះ លោក វរសេនីយ៍ ទោ ឈិន ឈាង បាន ណែនាំ ដល់ កងកម្លាំង ក្នុង ប៉ុស្តិ៍ ក្បាល ស្ពាន ទាំងអស់ ត្រូវ ត្រៀម កម្លាំង អន្តរាគមន៍ ២៤ ម៉ោង លើ ២៤ ម៉ោង ដើម្បី ប្រជាពលរដ្ឋ មាន ហេតុការណ៍ កើតឡើង ត្រូវ ចុះ ជួយ អន្តរាគមន៍ បាន ទាន់ ពេល ត្រូវ យាម តាម គោលដៅ ប្រចាំ ដើរល្បាត ត្រួតពិនិត្យ ដើម្បី រក្សា ការពារ សន្តិសុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ រស់ នៅ ក្បែរ ព្រំដែន កម្ពុជា - ថៃ ជាពិសេស បង្កើន ការ ទប់ស្កាត់ រាល់ បទល្មើស លួច ឆ្លង ដែន ដោយ ខុស ច្បាប់ ផងដែរ ៕
