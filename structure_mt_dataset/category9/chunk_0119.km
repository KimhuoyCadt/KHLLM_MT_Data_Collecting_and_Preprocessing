ក្រោយ ត្រូវបាន ពន្យារ ពេល ជាច្រើន ថ្ងៃ មក នេះ សេចក្ដីព្រាង ដំណោះស្រាយ ចុងក្រោយ បំផុត មួយ ដែល AFP បាន ឃើញ បាន អំពាវនាវ ឱ្យ មាន ការអនុញ្ញាត ជាបន្ទាន់ នូវ ការ បញ្ជូន ជំនួយ មនុស្សធម៌ សម្រាប់ ជន ស៊ីវិល ដោយ សុវត្ថិភាព និង គ្មាន ការរំខាន ។ ដំណោះស្រាយ នេះ ក៏ បាន អំពាវនាវ ផងដែរ ការបង្កើត លក្ខខណ្ឌ សម្រាប់ បទ ឈប់ បាញ់ មួយ ប្រកបដោយ និរន្តរភាព ប៉ុន្តែ មិន បាន អំពាវនាវ ឱ្យ មាន ការបិទ បញ្ចប់ សង្រ្គាម ភ្លាម ៗ នោះ ទេ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសុក្រ ១០ កើត ខែមិគសិរ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា អញ្ជើញ ជា អធិបតីភាព បើក ការដ្ឋាន សាងសង់ ចំណត ផែ កុងតឺន័រ ទឹក ជ្រៅ ជំហាន ទី១ ស្ថិត នៅ កំពង់ស្វយ័ត ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
ចំណត ផែ កុងតឺន័រ ទឹក ជ្រៅ ថ្មី ជំហាន ទី២ និង ជំហាន ទី៣នេះ គ្រោង នឹង ចំណាយ ថវិកា សាងសង់ សរុប ប្រមាណ ៦៩៨ លាន ដុល្លារ អាម៉េរិក បន្ថែម ទៀត ដែល ទឹកប្រាក់ ជាង ៥០០ លាន ដុល្លារ អាម៉េរិក ជា ឥណទាន សម្បទាន ពី រដ្ឋាភិបាល ប្រទេស ជប៉ុន និង ជាង ១០០ លាន ដុល្លារ អាម៉េរិក ជា ថវិកា បដិភាគ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
តាម ការសិក្សា សមិទ្ធិ លទ្ធភាព គម្រោង សាងសង់ ចំណត ផែ កុងតឺន័រ ថ្មី ទាំង ៣ជំហាន នេះ នឹង ប្រែក្លាយ សមត្ថភាព កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ ដែល បច្ចុប្បន្ន ជា កំពង់ផែ អន្តរជាតិ ខ្នាត តូច ឱ្យ ទៅជា កំពង់ផែ អន្តរជាតិ ខ្នាត ធំ ប្រកបដោយ ភាពប្រកួតប្រជែង ដែល អនុញ្ញាតឱ្យ នាវា កុងតឺន័រ ធុន ធំ ពី គ្រប់ តំបន់ នៅក្នុង ពិភពលោក អាច ចូល ចត បាន ដោយ ងាយស្រួល និង ឆាប់រហ័ស ដោយ ពុំ មាន ឧបសគ្គ លើ ជម្រៅ ទឹក ទៀត ឡើយ ។
ទន្ទឹមនឹង ការបើក ការដ្ឋាន សាងសង់ ចំណត ផែ កុងតឺន័រ ទឹក ជ្រៅ ជំហាន ទី១ ហើយ នោះ ក៏ មាន ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ គ្រឿងចក្រ លើក ដាក់ ចល័ត នៅ គែម ផែ ចំនួន ២គ្រឿង ដែល ជា ប្រភេទ រថយន្ត ស្ទូច មាន សមត្ថភាព លើក ដាក់ ទំនិញ បាន រហូតដល់ ១០០តោន ។ គ្រឿងចក្រ ទាំង ពីរ គ្រឿង នេះ គឺជា ជំនួយ ឥត សំណង ពី រដ្ឋាភិបាល ជប៉ុន ផ្តល់ ជូន មក រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម កម្មវិធី អភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ដោយ បាន ចំណាយ ថវិកា សរុប ប្រមាណ ១៣. ៩លាន ដុល្លារ អាម៉េរិក ។
