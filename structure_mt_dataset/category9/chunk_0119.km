( ភ្នំពេញ ) ៖ កំណើន គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ បាន កើនឡើង ជា បន្តបន្ទាប់ ដោយសារ មូលដ្ឋាន សេដ្ឋកិច្ច កម្ពុជា មាន ការរីកលូតលាស់ និង តម្រូវការ ហិរញ្ញវត្ថុ សម្រាប់ បង្កើត អាជីវកម្ម សហគ្រាស និង ពង្រីក អាជីវកម្ម ក៏ ដូចជា គាំទ្រ ដល់ តម្រូវ ការចាំបាច់ ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ពលរដ្ឋ កម្ពុជា ។
( ភ្នំពេញ ) ៖ លោកស្រី ឡង ឌី សាន់ ណារ៉ា រដ្ឋលេខាធិការ តំណាង លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា រដ្ឋមន្រ្តី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ថ្លែង ថា ក្រសួង វប្បធម៌ បាន ចូលរួម សហការ យ៉ាង សកម្ម ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ការជួញដូរ មនុស្ស ក្នុង គោលដៅ កាត់បន្ថយ និង លុបបំបាត់ នូវ សកម្មភាព អមនុស្សធម៌ ទាំង នេះ ចេញ ពី សង្គម ។
លោកស្រី ថ្លែង បែប នេះ ក្នុង ឱកាស ពិធី បើក សិក្ខាសាលា ស្តីពី « តួនាទី នៃ វិស័យ វប្បធម៌ ក្នុង ការប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស » ដែល រៀបចំឡើង ដោយ ក្រុមការងារ បង្ការ ទប់ស្កាត់ រាល់ ទម្រង់ នៃ អំពើ ជួញដូរ មនុស្ស នៃ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នៅ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
យោង តាម របាយការណ៍ ស្តីពី លទ្ធផល ការងារ រយៈពេល ៥ ឆ្នាំ ២០១៩ - ២០២៣ អំពី ការលើកកម្ពស់ ការបង្ការ ទប់ស្កាត់ រាល់ ទម្រង់ នៃ អំពើ ជួញដូរ មនុស្ស របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ឲ្យដឹង ថា ក្រុមការងារ បង្ការ ទប់ស្កាត់ រាល់ ទម្រង់ នៃ អំពើ ជួញដូរ មនុស្ស និង ការរំលោភបំពាន ផ្លូវភេទ លើ ស្រ្តី និង កុមារ របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដែល មាន អង្គភាព ថ្នាក់ រដ្ឋបាល កណ្តាល និង ថ្នាក់ មន្ទីរ រាជធានី - ខេត្ត បាន ចូលរួម អនុវត្ត ក្នុង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ សម្រាប់ រយៈពេល ៥ឆ្នាំ ។
កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្រ្តី ការបរទេស ចិន ជប៉ុន និង កូរ៉េ ខាងត្បូង លើក ទី១០ បាន បើក ធ្វើ នៅ ក្រុង ប៊ូសាន នៃ ប្រទេស កូរ៉េ ខាងត្បូង
ភាគី ចិន នឹង បន្ត ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ ដែល រាប់អាន ជាមួយ ប្រទេស ជិតខាង និង យក ប្រទេស ជិតខាង ជា ដៃគូ ធ្វើ កិច្ច ខិតខំ ប្រឹងប្រែង ជាមួយ កូរ៉េ ខាងត្បូង និង ជប៉ុន ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង បី ឱ្យ វិលត្រឡប់ ទៅ រក ផ្លូវ ត្រឹមត្រូវ ក៏ ដូចជា រក្សា ការអភិវឌ្ឍ ជា និរន្តរភាព ដែល ប្រកបដោយ ភាព ល្អ បរិសុទ្ធ និង ស្ថិរភាព ក្នុង ន័យ រួមចំណែក ថ្មី សម្រាប់ សន្តិភាព និង វិបុលភាព ក្នុង តំបន់ និង ពិភពលោក ។
អត្ថបទ និង រូបភាព ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន ខេត្ត ព្រះវិហារ ទទួលបាន ភ្ញៀវ ទេសចរ ជាង ១ម៉ឺន នាក់ ក្នុង ពេល ឈប់ សម្រាក នា ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ៣ ថ្ងៃ
( ព្រះវិហារ ) ៖ ក្នុង រយៈពេល ៣ ថ្ងៃ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ខេត្ត ព្រះវិហារ មាន ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ដើរលេង កម្សាន្ត ជាង ១ម៉ឺន នាក់ នៅ តាម តំបន់ រមណីយដ្ឋាន នានា ។
លោក ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ព្រះវិហារ បាន ថ្លែង បញ្ជាក់ ថា មូលហេតុ ដែល ភ្ញៀវ ទេសចរ ធ្លាក់ចុះ បន្តិច នៅ ខេត្ត ព្រះវិហារ រយៈពេល ៣ ថ្ងៃ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ឆ្នាំ នេះ ដោយ ឆ្នាំ មុន ខេត្ត ព្រះវិហារ បាន រៀបចំ ពិធី អុំ ទូក នៅ ទំនប់ ៩៥ ចំ ថ្ងៃ ឈប់សម្រាក ។ តែ ឆ្នាំ នេះ ធ្វើ ពិធី ប្រណាំង ទូក នៅ ទំនប់ ៩៥ មុន ថ្ងៃ ឈប់សម្រាក ទើប ធ្វើឱ្យ ភ្ញៀវ ទេសចរ ធ្លាក់ចុះ ។
សូម បញ្ជាក់ ថា ទីតាំង ទេសចរណ៍ នៅក្នុង ខេត្ត ព្រះវិហារ ដែល ភ្ញៀវ តែងតែ មក កម្សាន្ត រួម មាន៖ ប្រាសាទ ព្រះវិហារ ស្ថិត ក្នុង ស្រុក ជាំ ក្សាន្ត ប្រាសាទ កោះ កេរ ស្ថិត ក្នុង ស្រុក គូលែន ភ្នំ ត្បែងមានជ័យ ស្ថិត ក្នុង ស្រុក ត្បែងមានជ័យ និង ទឹក ធ្លាក់ ព្រះនិម្មិត ស្ថិត ក្នុង ស្រុក ឆែប ជាប់ ព្រំដែន ឡាវ និង តំបន់ ទេសចរណ៍ ជាច្រើន កន្លែង ទៀត ផងដែរ ៕
ប៉ុន្តែ មន្ត្រី ជាន់ ខ្ពស់ ម្នាក់ ទៀត មកពី ក្រសួង ការពារ ជាតិ ជប៉ុន បាន និយាយ នៅក្នុង សភា ដែរ ថា កងកម្លាំង ស្វ័យ ការពារ ជប៉ុន ដែល កំពុង ធ្វើ ប្រតិបត្តិការ យន្ដហោះ Ospreys ដែរ នោះ នឹង បញ្ឈរ ជើង ការហោះហើរ របស់ យន្ដហោះ យោធា ប្រភេទ នេះ រហូត ទាល់តែ មូលហេតុ ធ្លាក់ ត្រូវ បាន បញ្ជាក់ ។
( តាកែវ )៖ កង់ ចំនួន ៩៧០ គ្រឿង ដែល ជា ជំនួយ របស់ មូលនិធិ ចិន ន ដើម្បី អភិវឌ្ឍ ជនបទ តាមរយៈ វេទិកា សម្ព័ន្ធ សង្គម ស៊ីវិល ត្រូវបាន ប្រគល់ ជូន សិស្សានុសិស្ស នៅ សាលា បឋមសិក្សា ក្រ ពុំ ឈូក ស្ថិត នៅក្នុង ភូមិ ក្រពុំ ឈូក ឃុំ ក្រ ពុំ ឈូក ស្រុក កោះ អណ្តែ ត ខេត្ត តាកែវ ។
ពិធី ប្រគល់ និង ទទួល អំណោយ ជា កង់ នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
