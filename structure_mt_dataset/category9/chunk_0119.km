( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន ស្ដីពី ក្របខណ្ឌ អភិវឌ្ឍន៍ សាលារៀន ជំនាន់ ថ្មី ដែល ក្រសួង បាន សាកល្បង ដំណើរការ កម្មវិធី សាលារៀន នៅ វិទ្យាល័យ ព្រះស៉ី សុវត្ថិ រាជធានី ភ្នំពេញ ដោយ សហការ ជាមួយ អង្គការ សកម្មភាព សម្រាប់ បឋមសិក្សា (KAPE) ។
ការដាក់ ឱ្យ ដំណើរការ ក្របខណ្ឌ អភិវឌ្ឍន៍ សាលារៀន ជំនាន់ ថ្មី នេះ ដែរ គឺ ក្នុង គោលដៅ បង្កើត នូវ ម៉ូដែល នៃ ការអភិវឌ្ឍ ការអប់រំ ឱ្យ ដល់ កម្រិត ស្ដង់ដា អតិបរមា ដែល ឆ្ពោះ ទៅការកើតឡើង នូវ ជំនាន់ ថ្មី មួយ នៃ គ្រឹះស្ថាន សិក្សា សាធារណៈ នៅ កម្ពុជា ដោយ ផ្ដល់ ជា គំរូ អភិបាលកិច្ច ល្អ ស្ដង់ដា វិជ្ជាជីវៈ ខ្ពស់ និង ស្ដង់ដា សិក្សា ដែល មាន គុណភាព ខ្ពស់ ៕
តៃវ៉ាន់ ដែល ចិន អះអាង ថា ជា ខេត្ត មួយ របស់ ខ្លួន តែងតែ ចោទប្រកាន់ ទីក្រុង ប៉េកាំង ជារឿយ ៗ ថា កំពុង បង្កើន ការដាក់ សម្ពាធ យោធា និង សេដ្ឋកិច្ច ដើម្បី កែប្រែ លទ្ធផល បោះឆ្នោត ឱ្យ ស្រប ទៅនឹង អ្វី ដែល រដ្ឋាភិបាល ចិន ចង់បាន ។ ចិន បាន បង្កើន ការដាក់ សម្ពាធ យោធា លើ តៃវ៉ាន់ គួរឱ្យ កត់សម្គាល់ ក្នុង រយៈពេល ៤ឆ្នាំ ចុងក្រោយ នេះ ក្នុង នោះ រួម មាន ទាំង ការធ្វើ សមយុទ្ធ ទ្រង់ទ្រាយ ធំ ចំនួន ២លើក ព័ទ្ធ ជុំវិញ កោះ តៃវ៉ាន់ កាលពី ឆ្នាំ ២០២២ និង កាលពី ពាក់កណ្ដាល ឆ្នាំ ២០២៣ នេះ ។
លោក រ៉ៃស៊ី ធ្វើការកត់សម្គាល់ បែប នេះ នៅក្នុង ជំនួប ជាមួយ លោក ប្រធានាធិបតី រុស្ស៉ី វ្ល៉ាឌីមៀ ពូទីន ក្នុង ទីក្រុង មូស្គូ ហើយ ដែល ជំនួប ផ្តោត លើ តំបន់ មជ្ឈិមបូព៌ា នេះ ដែរ កើត មាន ឡើង មួយ ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី លោក ពូទីន បិទ បញ្ចប់ ដំណើរទស្សនកិច្ច នៅឯ ប្រទេស អេមីរ៉ាត អារ៉ាប់ រួម និង អារ៉ាប៊ី សាអូឌីត ជា ទី ដែល លោក បាន ពិភាក្សា ពី សង្រ្គាម នៅ ហ្កាហ្សា អ៊ុយក្រែន និង តម្លៃ ប្រេង ជាមួយ មេដឹកនាំ នៃ ប្រទេស អារ៉ាប់ ទាំង២ ។
ទាំង លោក ពូទីន និង លោក រ៉ៃស៊ី មិន បាន លើកឡើង ឡើយ ពី ការរីកចម្រើន នៃ កិច្ចសហប្រតិបត្តិការ យោធា រវាង រុស្ស៉ី និង អ៉ីរ៉ង់ ដែល ជា ប្រភព នៃ ក្ដីកង្វល់ មួយ របស់ សហរដ្ឋ អាមេរិក ដែល បាន ចោទ អ៉ីរ៉ង់ ថា កំពុង ផ្គត់ផ្គង់ អាវុធ ឱ្យ រុស្ស៉ី ប្រើ ក្នុង សង្រ្គាម ឈ្លានពាន អ៊ុយក្រែន ។ តាម លោក ពូទីន វា ពិត ជា មាន សារៈសំខាន់ បំផុត ក្នុង ការពិភាក្សា ពី ស្ថានការណ៍ នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា ជាពិសេស គឺ ដែនដី ប៉ាឡេស្ទីន ។
ចំណែក លោក រ៉ៃស៊ី វិញ តាមរយៈ អ្នកបកប្រែ បាន ប្រាប់ លោក ពូទីន ថា អ្វី ដែល កំពុង កើតឡើង ក្នុង ដែនដី ប៉ាឡេស្ទីន និង តំបន់ ហ្កាហ្សា ជា ការពិត ណាស់ ជា អំពើ ប្រល័យ ពូជសាសន៍ និង ជា ឧក្រិដ្ឋកម្ម ប្រឆាំង មនុស្សជាតិ គាំទ្រ ដោយ សហរដ្ឋ អាមេរិក និង លោក ខាងលិច ។
( ភ្នំពេញ ) ៖ កម្ពុជា លើកទឹកចិត្ដ ដល់ មិត្ដ ចិន ក្នុង ការរៀបចំ វេទិកា ឱសថ បុរាណ មេគង្គ - ឡាន ឆាង ឱ្យ កាន់តែ ទូលំទូលាយ និង សហការ កាន់តែ ជិតស្និទ្ធ ជាមួយ ក្រុម ជំនាញ វេជ្ជសាស្រ្ដ បុរាណ កម្ពុជា ។
លោក បណ្ឌិត ប៉ៃ សំបូរ អគ្គ លេខាធិការ វេទិកា សម្ព័ន្ធ សង្គម ស៊ីវិល នៃ ទីស្ដីការ គណៈ រដ្ឋមន្រ្ដី បាន ជំរុញ លើកទឹកចិត្ដ ដល់ មិត្ដ ចិន ក្នុង ការរៀបចំ វេទិកា ឱសថ បុរាណ មេគង្គ - ឡាន ឆាង ឱ្យ កាន់តែ ទូលំទូលាយ និង សហការ កាន់តែ ជិតស្និទ្ធ ជាមួយ ក្រុម ជំនាញ វេជ្ជសាស្រ្ដ បុរាណ កម្ពុជា ដើម្បី ជា ប្រយោជន៍ ដល់ ការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ។ ការជំរុញ បែប នេះ ក្នុង វេទិកា ឱសថ បុរាណ មេគង្គ - ឡាន ឆាង លើក ទី១ នា ព្រឹក ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២៣ នៅ រាជធានី ភ្នំពេញ ។
លោក បណ្ឌិត ប៉ៃ សំបូរ បាន មានប្រសាសន៍ សម្ដែង នូវ ការគាំទ្រ លើ ខឹ្លម សារ និង បេសកកម្ម ការងារ ដែល មិត្ដ ចិន បាន ចូលរួមចំណែក លើកកម្ពស់ ផ្នែក វេជ្ជសាស្រ្ដ បុរាណ ចិន ដែល ជា ជ្រុង ដ៏ សំខាន់ នៃ វប្បធម៌ ចិន ហើយក៏ ជា ការរួមចំណែក ដល់ កិច្ច កសាង សហគមន៍ រួម វាសនា ដោយ ផ្ដោត លើ វិស័យ សុខភាព សាធារណៈ ជា អាទិភាព ។
ចំណែក លោក Wang Xiaopin លេខា គណៈកម្មាធិការ បក្ស នៃ មន្ទីរពេទ្យ កង អាន មិន បណ្ឌិត សភា វិទ្យាសាស្រ្ដ វេជ្ជសាស្រ្ដ ចិន បាន លើកឡើង ថា តាំងពី បុរាណកាល មក ឱសថ បុរាណ ចិន គឺជា ផ្នែក សំខាន់ នៃ ការផ្លាស់ប្ដូរ និង កិច្ចសហប្រតិបត្តិការ រវាង បណ្ដា ប្រទេស នៅ តាម បណ្ដោយ ផ្លូវ សូត្រ បុរាណ ។
លោក បាន ឱ្យដឹង ថា ប្រសិទ្ធភាព និង តួនាទី របស់ ឱសថ បុរាណ ចិន ក្នុង ការបង្ការ និង ព្យាបាល ជំងឺ ទូទៅ ជំងឺ ដែល កើតឡើង ញឹកញាប់ ជំងឺ រ៉ាំរ៉ៃ និង ជំងឺ ធំ ៗ ត្រូវបាន សហគមន៍ អន្ដរជាតិ ទទួលស្គាល់ និង ទទួលយក កាន់តែ ខ្លាំង ឡើង ។
លោកស្រី ក៏ បាន រម្លឹក ថា កាលពី ថ្ងៃទី ១២ ខែតុលា កន្លងមក មជ្ឈមណ្ឌល ស្រាវជ្រាវ ឱសថ បុរាណ ចិន - កម្ពុជា ត្រូវបាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ចិន ព្រះកុសុមៈ ហើយ ការបង្កើត មជ្ឈមណ្ឌល នេះ នឹង ជួយ ដល់ ការស្វែងរក គំរូ ថ្មី និង ផ្លូវ ថ្មី សម្រាប់ ការសាងសង់ មជ្ឈមណ្ឌល ឱសថ បុរាណ ចិន នៅ បរទេស ដែល ក៏ នឹង ជួយ ធ្វើឱ្យ ចំណង មិត្ដភាព កម្ពុជា - ចិន កាន់តែ ស៊ីជម្រៅ ក៏ ដូចជា រួមចំណែក កសាង សហគមន៍ រួម វាសនា រួម ចិន - កម្ពុជា ក្នុង យុគ្គ សម័យ ថ្មី ។
សូម ជម្រាប ជូន ថា ក្នុង វេទិកា ឱសថ បុរាណ មេគង្គ - ឡាន ឆាង លើក ទី១ នេះ ត្រូវបាន រៀបចំឡើង នៅ កម្ពុជា ដោយ មាន កិច្ចសហការ រវាង មន្ទីរពេទ្យ កង អាន មិន បណ្ឌិត សភា វិទ្យាសាស្រ្ដ វេជ្ជសាស្រ្ដ ចិន ជាមួយ មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ចិន ព្រះកុសុមៈ និង ដោយ មាន ការគាំទ្រ ពី ស្ថានទូត ចិន ប្រចាំ នៅ កម្ពុជា ៕ មិន ត្រូវ បើកបរ ក្នុង ស្ថានភាពងងុយដេក ជាដាច់ខាត ! ស្លាប់ ៣នាក់ និង របួស ១នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៧ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៧ ខែធ្នូ ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ១នាក់ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២៣ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ៣១៥. ២៥១ នាក់ ។ ក្នុង នោះ រួម មាន៖
ក្រោម កិច្ច សម្របសម្រួល របស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល និង កិច្ចសហការ ពី ប្រជាពលរដ្ឋ បច្ចុប្បន្ន នេះ ប្រជាពលរដ្ឋ ស្ម័ត្រ ចិត្ត ប្តូរ ទីលំនៅ ចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ ទៅ រស់ នៅ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក មាន ចំនួន ៥. ៨៦៥ គ្រួសារ និង តំបន់ អភិវឌ្ឍន៍ ពាក់ ស្នែង ចំនួន ៤. ០៣២ គ្រួសារ ។ គ្រួសារ ប្រជាពលរដ្ឋ បាន ចាកចេញ ទៅ រស់ នៅ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក ចំនួន ៤. ៧៣០ ខ្នង ផ្ទះ ស្មើនឹង ៤៧. ៧៩ ភាគរយ នៃ ចំនួន គ្រួសារ ដែល បាន ចាប់ ឆ្នោត សរុប និង បាន រៀបចំ រួចរាល់ នូវ បណ្ណ កម្មសិទ្ធិ ចំនួន ៤. ៥៥៤បណ្ណ ។
ក្រៅពី នោះ ដើម្បី គាំទ្រ ដល់ ជីវភាព ប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តល់ បណ្ណ ក្រីក្រ កម្រិត ១ ជូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន ស្ម័គ្រចិត្ត ផ្លាស់ទី មក រស់នៅ លើ តំបន់ អភិវឌ្ឍន៍ ទាំង ពីរ ទីតាំង ខាងលើ នេះ ។
លោក ជួន សុខា ជា ប្រជាពលរដ្ឋ មួយ រូប ដែល បាន ស្ម័គ្រចិត្ត រើ លំនៅឋាន ចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ ។ លោក បាន ចូលមក រស់ នៅ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក រយៈពេល ប្រមាណ មួយ ឆ្នាំ មកហើយ ។
លោក សុខា ពេញចិត្ត នឹង ការមក រស់ នៅ រុន តា ឯក ព្រោះ បាន ដី ជា កម្មសិទ្ធិ ផ្ទាល់ខ្លួន ទំហំ ២០ម៉ែត្រ គុណ នឹង ៣០ម៉ែត្រ ហើយ អាច សង់ លំនៅឋាន តាម ការចង់បាន របស់ ខ្លួន ។
បើ ទោះបីជា យ៉ាងណា ដើម្បី លើកកម្ពស់ ជីវភាព ពលរដ្ឋ នៅ រុន តា ឯក ឱ្យ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត នោះ លោក សុខា បាន លើក ជា សំណូមពរ មួយចំនួន ផងដែរ ។ លោក បាន សំណូម ឱ្យ មាន ការរៀបចំ បង្កើត ជា មូលដ្ឋាន ការងារ នៅក្បែរ ឬ នៅ តំបន់ រុន តា ឯក តែម្តង ដើម្បី ពលរដ្ឋ មាន ការងារ ធ្វើ មិន លំបាក ឡើង ទៅ រក នៅក្នុង ក្រុង សៀមរាប ។
លោក សុខា ក៏ បាន ស្នើ ឱ្យ អាជ្ញាធរ ឱស្សាហ៍ ចុះ ទៅកាន់ តំបន់ រុន តា ឯក ដើម្បី បាន ដឹង ពី ស្ថានភាព នៃ ការរស់នៅ របស់ ពួកគាត់ ។
បន្ថែម ពីលើ នេះ លោក សុខា ក៏ បាន សំណូមពរ ឱ្យ អាជ្ញាធរ ដាំ ដើមឈើ នៅ តាម ដងផ្លូវ ដើម្បី បង្កើត គម្រប បៃតង ៕
វិភាគ អន្តរជាតិ៖ គោលបំណង នៃ ទស្សនកិច្ច របស់ លោក ពូទីន នៅ អេមីរ៉ាត អារ៉ាប់ រួម និង អារ៉ាប៊ី សាអូឌីត
ទី ១៖ ធានា ឱ្យ បាន នូវ កិច្ចសហប្រតិបត្តិការ ឱ្យ បាន កាន់តែ ឆាប់ ស្ដីពី បញ្ហា ទាក់ទង នឹង តម្លៃ ប្រេង សកល និង សង្រ្គាម នៅ អ៊ុយក្រែន៖ រុស្ស៉ី ចង់ រក្សា តម្លៃ ប្រេង សកល ឱ្យ ស្ថិត នៅ ក្នុង តម្លៃ ខ្ពស់ នៅ ឆ្នាំ ២០២៤ ក្នុង គោលបំណង ដុត បញ្ឆេះ បន្ថែម នូវ « ការនឿយណាយ នឹង សង្រ្គាម » នៅក្នុង តំបន់ អឺរ៉ុប ក៏ ដូចជា បំផ្លាញ ឱកាស ជាប់ ឆ្នោត ជា ប្រធានាធិបតី មួយ អាណត្តិ ទៀត របស់ លោក ចូ បៃ ដិន ដែល វិមាន ក្រឹមឡាំង ជឿ ថា ការធ្វើ បែប នេះ អាចនឹង នាំ ទៅ រក ការកាត់បន្ថយ ជំនួយ យោធា របស់ លោក ខាងលិច សម្រាប់ អ៊ុយក្រែន ។
លោក អភិសន្តិ បណ្ឌិត ស សុខា ក៏ បាន បង្ហាញ ក្ដីរីករាយ ចំពោះ វឌ្ឍនភាព យ៉ាង លឿន រហ័ស និង ប្រកបដោយ គុណភាព ដែល សាកលវិទ្យាល័យ ជាតិ មួយ នេះ សម្រេចបាន ជាក់ស្ដែង សាកលវិទ្យាល័យ មាន និស្សិត ទទួលបាន ជោគជ័យ លើ ការសិក្សា ចំនួន ១. ៦៩៣ នាក់ បន្ថែម ទៀត ចាប់ពី ថ្នាក់ បរិញ្ញាបត្រ ថ្នាក់ បរិញ្ញាបត្រ និង ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ ។ លោក បាន ចាត់ទុក ភាពជោគជ័យ នេះ ថា ជា អ្វី ដែល រាជ រដ្ឋាភិបាល ប្រាថ្នា ចង់ ឃើញ ទាំង រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ។
គ.ជ. ប ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ជំនួប រវាង ប្រធាន គ.ជ. ប និង អ្នក រាយការណ៍ ពិសេស ទទួលបន្ទុក ស្ថានភាព សិទ្ធិ មនុស្ស នៅ កម្ពុជា
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង គ.ជ. ប៖
ជំនួប នា រសៀល នេះ គឺ បាន ធ្វើឡើង ដើម្បី ពង្រឹង កិច្ចសហការ រវាង ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ក្រុមហ៊ុន BUCG ពាក់ព័ន្ធ នឹង ប្រព័ន្ធ ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ - ទឹក ស្អាត នៅ តាម បណ្តា ខេត្ត - ក្រុង គោលដៅ ក៏ ដូចជា ការការចូលរួម សហការ ជាមួយ វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន ក្នុង ការបណ្តុះបណ្តាល សមត្ថភាព ធនធាន មនុស្ស សំដៅ រួមចំណែក ដល់ ការអភិវឌ្ឍ កម្ពុជា ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ - ដំណាក់កាល ទី១ និង គន្លឹះ អាទិភាព ទាំង៥ របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ ។
លើស ពី នេះ គឺ ដើម្បី ជា ការចូលរួម រឹតបន្តឹង ចំណង ការទូត កម្ពុជា - ចិន ដោយ ក្នុង ឆ្នាំ ២០២៣ នេះ ជា ខួប លើក ទី ៦៥ ព្រមទាំង ត្រូវបាន ប្រសិទ្ធ នាម ថា « កិច្ចសហប្រតិបត្តិការ ត្បូង ពេជ្រ » ផងដែរ ។
ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក ពេជ្រ សម្បត្តិ អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា អនុប្រធាន ក្រុមការងារ ដោះស្រាយ គម្រោង វិនិយោគ ជាប់គាំង ក្នុង ខេត្ត ព្រះសីហនុ . លោក សុខ ដារ៉ា អគ្គ នាយក នៃ និយ័តករបរ ធន បាលកិច្ច និង លោក ម៉ាង ស៊ីណេត អភិបាល រង ខេត្ត ព្រះសីហនុ ។
សម្តេច បាន ថ្លែង ទៀត ថា មាន ប្រទេស មួយចំនួន នៅលើ ពិភពលោក ដែល បាន ដាក់ សម្បត្តិ បេតិកភណ្ឌ របស់ ខ្លួន ទៅក្នុង បញ្ជីសម្បត្តិ បេតិកភណ្ឌ ពិភពលោក របស់ អង្គការ យូណេស្កូ ប៉ុន្តែ មិន គោរព តាម លក្ខខណ្ឌ កំណត់ ត្រូវបាន អង្គការ នេះ ដក សម្បត្តិ បេតិកភណ្ឌ ទាំងនោះ ចេញ ពី បញ្ជី បេតិកភណ្ឌ ពិភពលោក មិន ថា ប្រទេស នោះ ជឿនលឿន ប៉ុណ្ណា នោះ ទេ ។ សម្រាប់ កម្ពុជា យើង មិន ចង់ ឃើញ ដូច្នេះ ទេ គឺ ចង់ឱ្យ ប្រាសាទ របស់ យើង ទទួលបាន ការថែទាំ ដើម្បី រក្សា បាន រាប់ ពាន់ ឆ្នាំ តទៅទៀត ។
សម្តេច បន្ថែម ថា ការស្ម័គ្រចិត្ត របស់ ប្រជាពលរដ្ឋ ផ្លាស់ ទីលំនៅ ពី តំបន់ រមណីយដ្ឋាន អង្គរ មក ភូមិ ធម្មជាតិ រុន តា ឯក និង ពាក់ ស្នែង គឺជា កិច្ចការ ដ៏ សំខាន់ ដើម្បី គោរព តាម លក្ខខណ្ឌ បច្ចេកទេស របស់ អង្គការ យូណេស្កូ ។
ការថ្លែង របស់ សម្តេច នាយក រដ្ឋមន្ត្រី ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ រុន តា ឯក និង ពាក់ ស្នែង ជិត ៣ពាន់ នាក់ នា ព្រឹក ថ្ងៃទី ៨ ខែធ្នូ ២០២៣ ។
សូម ជម្រាប ថា ប្រាសាទ អង្គរ ត្រូវបាន ចុះបញ្ចូល ក្នុង បញ្ជីសម្បត្តិ បេតិកភណ្ឌ ពិភពលោក របស់ អង្គការ យូណេស្កូ នៅ ថ្ងៃទី ១៤ ខែធ្នូ ឆ្នាំ ១៩៩២ នាទីក្រុង សាន់តា ហ្វេសហរដ្ឋ អាមេរិក ។
ដើម្បី បំពេញ តាម លក្ខខណ្ឌ អង្គការ យូណេស្កូ ជាពិសេស ការពារ តម្លៃ ជា សកល នៃ រមណីយដ្ឋាន អង្គរ បន្ត ស្ថិត ក្នុង បញ្ជី បេតិកភណ្ឌ ពិភពលោក រាជ រដ្ឋាភិបាល បង្កើតឡើង បាន បង្កើត ភូមិ ធម្មជាតិ រុន តា ឯក ស្ថិត នៅក្នុង ឃុំ រុន តា ឯក ស្រុក បន្ទាយស្រី និង តំបន់ ពាក់ ស្នែង ស្ថិត ស្ថិត នៅក្នុង ឃុំ ពាក់ ស្នែង ស្រុក អង្គរ ធំ ខេត្ត សៀមរាប សម្រាប់ ប្រជាពលរដ្ឋ ដែល ផ្លាស់ ចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ ។
ការថ្លែង បែប នេះ របស់ សម្ដេច ធិបតី នាយក រដ្ឋមន្ត្រី ធ្វើឡើង ក្នុង ពិធី សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ ធម្មជាតិ រុន តា ឯក និង តំបន់ ពាក់ ស្នែង សរុប ជិត ៣ពាន់ នាក់ ដែល ពិធី នេះ ប្រព្រឹត្តទៅ នា ព្រឹក ថ្ងៃទី ៨ ខែធ្នូ ឆ្នាំ ២០២៣ នៅ ភូមិ ធម្មជាតិ រុន តា ឯក ស្រុក បន្ទាយស្រី ខេត្ត សៀមរាប ។
សម្ដេច ធិបតី បាន ថ្លែង ថា « រវាង សម្បត្តិ បេតិកភណ្ឌ និង ប្រជាពលរដ្ឋ គឺ រាជ រដ្ឋាភិបាល ជ្រើសរើស ទាំង ពីរ . ការជ្រើសរើស គឺ មិន លំបាក ទេ តែ អ្វី ដែល លំបាក គឺ យើង ត្រូវ សម្រេច យ៉ាងណា ដូច្នេះហើយ ទើប រាជ រដ្ឋាភិបាល បាន រៀបចំ តំបន់ អភិវឌ្ឍន៍ រុន តា ឯក នេះ ដើម្បី កសាង ទីតាំង ថ្មី ជូន ប្រជាពលរដ្ឋ ដែល ស្ម័គ្រ ផ្លាស់ទី ពី តំបន់ អង្គរ » ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ត ថា សម្ដេច តេជោ ហ៊ុន សែន កាល នៅ ជា នាយក រដ្ឋមន្ត្រី បាន ចុះ មក ទីនេះ ៤ដង ក្នុង រយៈពេល មិន ដល់ ១ ឆ្នាំ ផង ហើយ ថ្ងៃ នេះ សម្ដេច ធិបតី ដែល ជា នាយក រដ្ឋមន្ត្រី បន្ត វេន ក៏ បាន មកកាន់ ទីនេះ ទៀត គឺ ដើម្បី បញ្ជាក់ ការប្ដេជ្ញាចិត្ត ជំរុញ ការកសាង ទី កន្លែង នេះ ជូន ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ល្អ ប្រសើរ ។
សម្ដេច ធិបតី បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « សម្ដេច តេជោ បាន ចុះ មក ទីនេះ ៤ដង ហើយ ថ្ងៃ នេះ ខ្ញុំ បាន មកកាន់ ទីនេះ ទៀត គឺ ដើម្បី បញ្ជាក់ ការប្ដេជ្ញាចិត្ត ជំរុញ ការកសាង ទី កន្លែង នេះ ជូន ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ល្អ ប្រសើរ . នេះ ហើយ ជា កិច្ចការ » ។
សម្ដេច ធិបតី បាន បន្ត ទៀត ថា រាជ រដ្ឋាភិបាល ត្រូវតែ ការពារ ព្រលឹង ជាតិ គឺ សំដៅ ទៅ លើ សម្បត្តិ បេតិកភណ្ឌ វប្បធម៌ ដែល ដូនតា ទុក ឱ្យ យើង ជា និម្មិត រូប ទន្ទឹម នឹង នោះ ក៏ ត្រូវ ទទួលខុសត្រូវ ចំពោះ ជីវិត ជាតិ ផងដែរ នោះ គឺ ជីវិត ប្រជាជន ព្រោះ ប្រសិនបើ ប្រជាពលរដ្ឋ វេទនា ជាតិ យើង ក៏ វេទនា ដូចគ្នា ។
សម្ដេច ធិបក៏ តី បាន ណែនាំ ឱ្យ ក្រសួង រៀបចំ ដែនដី អាជ្ញាធរ ខេត្ត សៀមរាប ស្រុក បន្ទាយស្រី ក្រសួង ស្ថាប័ន ផ្សេង ទៀត សហការ រៀបចំ ភូមិ រុន តា ឯក នេះ ឱ្យ ក្លាយទៅជា ទីក្រុង រុន តា ឯក តែម្ដង ៕
ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ ធម្មជាតិ រុន តា ឯក និង តំបន់ ពាក់ ស្នែង សរុប ជិត ៣ពាន់ នាក់ នៅ ព្រឹក ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន អះអាង ថា សម្ដេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដែល បាន រៀបចំ ឲ្យ ប្រជាពលរដ្ឋ ផ្លាស់ទីនេះ មិន បាន យក ដី រមណីយដ្ឋាន អង្គរ លក់ ទៅឲ្យ វិស័យ ឯកជន ណាមួយ នោះ ទេ ពោល សម្ដេច ធ្វើ បែប នេះ ដើម្បី តែ ប្រយោជន៍ ជាតិ តែ ប៉ុណ្ណោះ ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត . ផ្ដើម ចេញ ពី ការជឿជាក់ លើ ការដឹកនាំ និង គិតគូ របស់ សម្ដេច តេជោ ហ៊ុន សែន នោះ ហើយ បានជា ប្រជាពលរដ្ឋ សម្រេចចិត្ត ផ្លាស់ប្ដូរ ទីលំនៅ របស់ ខ្លួន មក រស់ នៅ លើ ទីតាំង ថ្មី បែប នេះ ។ សម្ដេច ធិបតី បាន អះអាង ថា មួយ ជីវិត របស់ សម្ដេច តេជោ គឺ តស៊ូ ដើម្បី ជាតិ និង ប្រជាជន របស់ សម្ដេច តែ ប៉ុណ្ណោះ ។
ជាមួយគ្នា នេះ សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ក៏ បាន ថ្លែងអំណរគុណ ជាថ្មី ដល់ ប្រជាពលរដ្ឋ នៅ តំបន់ រុន តា ឯក និង ពាក់ ស្នែង ក៏ ដូចជា អ្នក ខេត្ត សៀមរាប ទាំងអស់ ដែល បាន ផ្ដល់ ការទុកចិត្ត ជឿ ចិត្ត ទៅ លើ សម្ដេច តេជោ និង គណបក្ស ប្រជាជន កម្ពុជា ហើយ នៅក្នុង រយៈពេល នៃ ការបោះឆ្នោត ខែកក្កដា កន្លងទៅ នេះ ដែល ធ្វើឲ្យ ខេត្ត សៀមរាប ទាំងមូល គណបក្ស ប្រជាជន កម្ពុជា បាន ឈ្នះ ភ្លូក ទឹក ភ្លូក ដី ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ សុំ នូវ ការ យោគយល់ ពីសំណាក់ ប្រជាពលរដ្ឋ ដែល មក រស់ នៅ តំបន់ ថ្មី នេះ ទាំងអស់ ដែល តាំងពី ថ្ងៃ ដំបូង មិន ទាន់ មាន ហេដ្ឋារចនាសម្ព័ន្ធ តភ្ជាប់ សាលារៀន មន្ទីរពេទ្យ វត្ត អារាម ទីផ្សារ ប៉ុន្ដែ នៅ ពេល នេះ សមិទ្ធផល ជាច្រើន បាន លេចចេញ ជា រូបរាង ឡើង ហើយ នឹង បន្ដ កសាង នូវ សមិទ្ធផល សំខាន់ ៗ ជាច្រើន បន្ថែម ទៀត ជូន ដល់ ប្រជាពលរដ្ឋ មិន យូរ មិន ឆាប់ តំបន់ រុន តា ឯក និង ប្រជាពលរដ្ឋ ដែល រស់ នៅ ទីនេះ ជីវភាព កាន់តែ រឹងមាំ សប្បូរសប្បាយ ។
សម្ដេច បាន អះអាង ថា ដំណើរ សម្តេច អញ្ជើញ ចុះ មក រុន តា ឯក នា ពេលនេះ បង្ហាញ ឲ្យ ឃើញ ពី ការប្តេជ្ញាចិត្ត បន្ត ស្មារតី អភិវឌ្ឍន៍ តំបន់ រុន តា ឯក ឲ្យ កាន់តែ ល្អ ប្រសើរ សម្រាប់ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ។ ខណៈ ការរៀបចំ ហេដ្ឋារចនាសម្ព័ន្ធ និង ប្រព័ន្ធ រដ្ឋបាល នៅ រុន តា ឯក ជា ទិសដៅ ប្រែក្លាយ តំបន់ នេះ ទៅជា ក្រុង ។
ការណែនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក្នុង ឱកាស ដែល សម្តេច អញ្ជើញ សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ ធម្មជាតិ រុន តា ឯក និង តំបន់ ពាក់ ស្នែង សរុប ជិត ៣ពាន់ នាក់ នៅ ព្រឹក ថ្ងៃទី ៨ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ ។
សម្តេច ធិបតី មានប្រសាសន៍ ថា ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ សហការ គ្នា ពិនិត្យ លើ លទ្ធភាព ទាក់ទាញ វិនិយោគ និង រៀបចំ ផែនការ ក្នុង រៀបចំ កន្លែង នេះ ទៅជា ប៉ូល សេដ្ឋកិច្ច សំខាន់ មួយ ទៀត សម្រាប់ ខេត្ត រុញ ការងារ ឱ្យ ដល់ ប្រជាពលរដ្ឋ ដើម្បី ពង្រីក សក្តានុពល តំបន់ នេះ ឱ្យ ក្លាយជា តំបន់ អភិវឌ្ឍន៍ ។
ទន្ទឹម គ្នា នេះ សម្តេច ធិបតី បាន ណែនាំ ដល់ ក្រសួង និង មន្ទីរ ការងារ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ព្រមទាំង ស្ថាប័ន អាជ្ញាធរ ពាក់ព័ន្ធ ពិនិត្យ លទ្ធភាព ផ្តល់ ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ដល់ ប្រជាពលរដ្ឋ នៅក្នុង តំបន់ នេះ ជាពិសេស យុវជន ។
