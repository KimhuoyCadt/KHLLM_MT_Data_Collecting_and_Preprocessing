( សេអ៊ូល ) ៖ កូរ៉េ ខាងជើង នៅ ថ្ងៃចន្ទ ទី ២៧ ខែវិច្ឆិកា នេះ បាន ប្ដេជ្ញា ជាថ្មី ថា នឹង បន្ត អនុវត្ត សិទ្ធិ អធិបតេយ្យ របស់ ខ្លួន ក្នុង នោះ រួម មាន ទាំង ការបាញ់ បង្ហោះ ផ្កាយ រណប បន្ថែម ខណៈ មាន សេចក្ដីរាយការណ៍ ថា ទីក្រុង ព្យុងយ៉ាង បាន ដាក់ពង្រាយ ទាហាន និង អាវុធ ធុន ធ្ងន់ ឡើងវិញ នៅ តំបន់ ព្រំដែន ជាប់ ជាមួយ កូរ៉េ ខាងត្បូង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters ។
គួរ បញ្ជាក់ ថា ទីភ្នាក់ងារ សារព័ត៌មាន កូរ៉េ ខាងត្បូង Yonhap នៅ ថ្ងៃចន្ទ នេះ ក៏ បាន រាយការណ៍ ដែរ ថា កូរ៉េ ខាងជើង បាន ដាក់ពង្រាយ ទាហាន និង អាវុធ ធុន ធ្ងន់ ឡើងវិញ នៅ តាម ប៉ុស្តិ៍ យាម ស្ថិត នៅក្បែរ ព្រំដែន ជាមួយ កូរ៉េ ខាងត្បូង បន្ទាប់ពី បាន ប្រកាស រៀង ៗ ខ្លួន ពី ការព្យួរ កិច្ចព្រមព្រៀង យោធា អន្តរ កូរ៉េ ។
នៅក្រោម កិច្ចព្រមព្រៀង យោធា អន្តរ កូរ៉េ ឆ្នាំ ២០១៨ កូរ៉េ ទាំង២ បាន បំផ្លាញ ប៉ុស្តិ៍ យាម ចំនួន ១០ ក្នុង ចំណោម ប៉ុស្តិ៍ យាម ទាំង ១១ទីតាំង នៅឯ តំបន់ ព្រំដែន គ្មាន យោធា ដើម្បី បន្ធូរបន្ថយ ភាពតានតឹង និង បង្ការ កុំ ឱ្យ ជម្លោះ ប្រដាប់អាវុធ ផ្ទុះឡើង ជា យថាហេតុ ណាមួយ ៕ រូបភាព ពី Reuters ឧត្តមសេនីយ៍ ឯក អ៉ី សុខ ឃី និង ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ ដឹកនាំ កិច្ចប្រជុំ ដកស្រង់ បទពិសោធន៍ ថ្ងៃទី១ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក អ៉ី សុខ ឃី អគ្គ ស្នងការ រង នគរបាល ជាតិ និង លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ដកស្រង់ បទពិសោធន៍ កិច្ចការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ថ្ងៃទី១ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ។
សូម ជម្រាប ថា ថ្ងៃទី១ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក បញ្ហា សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ត្រូវបាន ធានា ទាំងស្រុង យ៉ាង ល្អ ប្រសើរ ។ នេះ បើ តាម របាយការណ៍ របស់ អនុគណៈកម្មការ ការពារ រក្សា សន្ដិសុខ របៀបរៀបរយ សណ្ដាប់ធ្នាប់ សង្គម ចរាចរណ៍ សង្គ្រោះ ទូក លិច និង អ្នកជំងឺ ។
សភាព បទល្មើស ព្រហ្មទណ្ឌ ពុំ មាន អ្វី កើតឡើង គួរឲ្យ កត់សម្គាល់ ឡើយ ។ ក្រុម គ្រូពេទ្យ ប្រចាំ ការ នៅ តាម គោលដៅ បាន ធ្វើ ការសង្រ្គោះ បឋម ដល់ អ្នក ដែល មាន បញ្ហា សុខភាព សរុប ចំនួន ១. ៦៧៤ នាក់ ( ស្រី ២៤៣ នាក់ ) និង បញ្ជូន ទៅ សង្រ្គោះ នៅ មន្ទីរពេទ្យ ចំនួន ០១ នាក់ ។
កម្លាំង ការពារ គៅល ដៅ បាន រកឃើញ ក្មេង វង្វេង សាច់ញាតិ ចំនួន ០៦ នាក់ ដោយ បាន ធ្វើ ការផ្សព្វផ្សាយ ហើយ ត្រូវបាន សាច់ញាតិ មក ទទួលយក ទៅ វិញ ចំនួន ០៤ នាក់ និង កំពុង ស្វែងរក សាច់ញាតិ ចំនួន ០២ នាក់ បន្ត ទៀត ។
កម្លាំង ត្រៀម អន្តរាគមន៍ បាន ចេញ ជួយ សង្រ្គោះ ករណី ទូក ប្រណាំង លិច ទឹក ចំនួន ០៩ ទូក ដោយ បាន ជួយ សង្រ្គោះ កីឡាករ សរុប ១៩៨ នាក់ ប្រកបដោយ សុវត្ថិភាព ។ បាន ចុះ ផ្សព ផ្សាយ អប់រំ ស្ដីពី ការបង្ការ ទប់ស្កាត់ និង ពន្លត់ អគ្គិភ័យ តាម បណ្តា យានដ្ឋាន ផ្ទះ ជួល ផ្ទះសំណាក់ ភោជនីយ៍ដ្ឋាន នៅ ជុំវិញ តំបន់ ប្រារព្ធ ព្រះរាជ ពិធី បុណ្យ ។
កម្លាំង សមត្ថកិច្ច ចម្រុះ ប្រមាណ ជាង ១៦.០០០ នាក់ ត្រូវបាន ដាក់ពង្រាយ តាម គោលដៅ សំខាន់ ៗ ដើម្បី ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល នឹង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ៕
គណៈកម្មាធិការ ជាតិ រៀបចំ បុណ្យ ជាតិ - អន្ដរជាតិ បង្ហាញ បញ្ចី ផ្គូផ្គង ការប្រណាំង ទូក ថ្ងៃទី ២
ខាងក្រោម នេះ ជា បញ្ជី ផ្គូផ្គ ង៖
មន្ត្រី យោធា ដែល វាយ សន្តិសុខ មួយ ពិល បណ្តាលឲ្យ បែក ក្បាល ហើយ ទារ ឲ្យ ជនរងគ្រោះ សង ថ្លៃ ពិល នោះ ត្រូវបាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បញ្ជូន ទៅ តុលាការ
( ភ្នំពេញ ) ៖ មន្ត្រី យោធា ដែល វាយ សន្តិសុខ ម្នាក់ មួយ ពិល បណ្តាលឲ្យ បែក ក្បាល ហើយ ទាមទារ ឲ្យ ជនរងគ្រោះ សង ថ្លៃ ពិល ទៀត នោះ ត្រូវបាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បញ្ជូន ទៅកាន់ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ ។
គួរ ជម្រាប ថា មន្រ្តី យោធា ដែល ប បង្ក អំពើហិង្សា លើ សន្តិសុខ ត្រូវបាន កម្លាំង នគរបាល ប៉ុស្តិ៍ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ ចាប់ខ្លួន ក្រោយ ជន បង្ក រូប នេះ បាន ប្រើ ហិង្សា ដោយ វាយ សន្តិសុខ មួយ ពិល បណ្តាលឱ្យ បែក លើ ផ្ទៃ មុខ រងរបួស ធ្ងន់ កាលពី វេលា ម៉ោង ១រំលង អាធ្រាត្រា ចូល ថ្ងៃទី ២៤ ខែ វិច្ឆិកា ឆ្នាំ ២០២៣ នៅ ចំណុច ផ្លូវ ច្រក ចូល បុរី ពិភព ថ្មី ភូមិ ត្រពាំង ថ្លឹង៤ សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ការចាប់ខ្លួន មន្រ្តី យោធា រូប នេះ បាន ធ្វើឡើង ក្រោយ វាយ សន្តិសុខ ការពារ នៅ ច្រកទ្វារ ចូល បុរី ពិភព ថ្មី បណ្តាលឲ្យ បែក មុខ រួច ជេរ ប្រមាថ និង គំរាម បាញ់ នគរបាល មូលដ្ឋាន ដែល បាន ចុះ ទៅ ជួយ អន្តរាគមន៍ ទៀតផង ។ មិន តែ ប៉ុណ្ណោះ ជន នេះ បាន វាយ ជនរងគ្រោះ មួយ ពិល ហើយ ថែមទាំង ឲ្យ ជនរងគ្រោះ សង ថ្លៃ ពិល ទៀតផង ទាំងអការៈ ស្រវឹង ត្រេតទ្រោត និង ទូរស័ព្ទហៅ ខាង នគរបាល ព្រហ្មទណ្ឌ មក ជួយ ទៀត ។
តាម សេចក្តីរាយការណ៍ របស់ សមត្ថកិច្ច មូលដ្ឋាន បាន ឲ្យដឹង ថា នៅពេល កម្លាំង នគរបាល ចុះ ទៅ ជួយ អន្តរាគមន៍ នោះ ជន ខាងលើ នេះ បាន ស្រែក ជេរ និង គំរាម បាញ់ មកដល់ សមត្ថកិច្ច ទៀត ។ ដោយ អនុវត្ត តាម ច្បាប់ កម្លាំង នគរបាល បាន ចាប់ បញ្ជូន មក ប៉ុស្តិ៍ នគរបាល និង បញ្ជូន បន្ត ទៅកាន់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ចាត់ការ បន្ត ៕ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ដាក់ ចេញ វិធានការ ពង្រឹង សន្តិសុខ សុវត្ថិភាព ព្រមទាំង បង្ក្រាប បទល្មើស
( ព្រះសីហនុ) ៖ រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ដាក់ចេញ នូវ វិធានការពង្រឹង យន្តការថែរក្សា សន្តិសុខ សុវត្ថិភាព ព្រមទាំង បង្ក្រាប បទល្មើស ព្រហ្មទណ្ឌ នានា និង បទល្មើស តាម ប្រព័ន្ធ បច្ចេកវិទ្យា ដែល កើតមាន ក្នុង ភូមិសាស្ត្រ ខេត្ត ព្រះសីហនុ ។
ការដាក់ចេញ វិធានការ នេះ ធ្វើឡើ តាមរយៈ កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ព្រះសីហនុ នា ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ សាល ប្រជុំ ក្រុមប្រឹក្សា ខេត្ត ព្រះសីហនុ ក្រោម អធិបតីភាព លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ។
អង្គប្រជុំ បាន សម្រេច ដូច ខាងក្រោម៖
* ធានា រក្សា ឱ្យ បាន សុខ សុវត្ថិភាព ដែល ជា មូលដ្ឋានគ្រឹះ ដ៏ សំខាន់ ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម និង ទេសចរណ៍ ។
* ត្រូវ ធ្វើ ការស្រាវជ្រាវ ឱ្យ ដល់ ឫស គល់ ដើម្បី រក ទ្រព្យសម្បត្តិ និង គណនី ធនាគារ របស់ ជនសង្ស័យ ដែល បាន ប្រព្រឹត្តិ បទឧក្រិដ្ឋ ដើម្បី បង្កក់ ទុក ។
* ស្នងការដ្ឋាន នគរបាល ខេត្ត និង បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ត្រូវ បើក ការស្រាវជ្រាវ អោយ ដល់ ឫសគល់ នៃ ប្រភព អាវុធ ចំពោះ ជនសង្ស័យ មាន អាវុធ តើ អាវុធ នោះ បាន មកពី ណា ? ឬ ទិញ ដូរ ពី ណា ? និង ត្រូវតែ បំផ្លាញ ចោល ក្រុម ឧក្រិដ្ឋ ជន ណា ដែល មាន ប្រើប្រាស់ អាវុធ ជាតិ ផ្ទុះ បង្ក ហានិភ័យ ក្នុង ខេត្ត ព្រះសីហនុ ទោះជា ជនជាតិ ណា ក៏ដោយ មិន ត្រូវ លើកលែង ដាច់ខាត ។
* ស្នងការដ្ឋាន នគរបាល ខេត្ត ត្រូវ បង្កើន ប៉ុស្តិ៍ ត្រួតពិនិត្យ ការអនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ឱ្យ បាន ម៉ឺងម៉ាត់ ។
* ស្នងការដ្ឋាន នគរបាល ខេត្ត និង បញ្ហា ការដ្ឋាន កងរាជ ខេត្ត ត្រូវ បន្ត អនុវត្ត វិធានការ ចុះ ត្រួតពិនិត្យ ចល័ត ជាប្រចាំ ។
* គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង ស្រុក ត្រូវ បន្ត យកចិត្តទុកដាក់ ចុះ ត្រួតពិនិត្យ អាវុធ ជាតិ ផ្ទុះ និង ធ្វើ រដ្ឋបាល ចំហរ ជាប្រចាំ ។
* ពន្ធនាគារ ខេត្ត ត្រូវ ធ្វើ ការគ្រប់គ្រង ឱ្យ បាន ច្បាស់លាស់ ហ្មត់ចត់ ចំពោះ មុខ សញ្ញា ជា ឧក្រិដ្ឋ ជន ឃោរឃៅ ធ្ងន់ធ្ងរ ដល កំពុង ជាប់ ឃុំ នៅក្នុង ពន្ធនាគារ និង ត្រូវ រាយការណ៍ មក រដ្ឋបាល ខេត្ត ជាបន្ទាន់ គ្រប់ ពេលវេលា ដែល មាន ការប្រែប្រួល ។
* ចំពោះ ការចែករំលែក រូបភាព អំពើហិង្សា ឃោរឃៅ និង ព័ត៌មាន ឧក្រិដ្ឋកម្ម ត្រូវ ចាត់ទុក ជា វិន័យ មួយ របស់ កងកម្លាំង ដោយ ត្រូវ គ្រប់គ្រង ឱ្យ បាន ហ្មត់ចត់ នូវ ការចែករំលែក ព័ត៌មាន ទាក់ទង នឹង បទល្មើស ឧក្រិដ្ឋ ដែល មិន ទាន់ បង្ក្រាប បាន ទាំងស្រុង ដាច់ខាត កុំ ឱ្យ មាន ការបែកធ្លាយ ធ្វើឱ្យ ប៉ះពាល់ ទៅដល់ ដំណើរ ការស្រាវជ្រាវ បទល្មើស ទាំងនោះ ។ ស្ថាប័ន មាន សមត្ថកិច្ច ត្រូវ ធ្វើ សេចក្តីប្រកាស ព័ត៌មាន ជូន សាធារណជន បាន ជ្រាប នៅពេល ដំណើរការ នៃ ការស្រាវជ្រាវ ករណី បទល្មើស ត្រូវបាន បិទ បញ្ចប់ ។
* មន្ទីរ ធម្មការ និង សាសនា ខេត្ត ត្រូវ រៀបចំ ធ្វើ ពិធី សាសនា បួងសួង សុំ សេចក្តីសុខ នៅ ទីតាំង ដែល ឧស្សាហ៍ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ ជាញឹកញាប់ ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ និង ក្រើន រំលឹក ដល់ អ្នកធ្វើដំណើរ តាម ដងផ្លូវ ឱ្យ មាន ការប្រុងប្រយ័ត្ន និង គោរព ច្បាប់ ចរាចរណ៍ ដើម្បី កាត់បន្ថយ គ្រោះថ្នាក់ ដែល អាច កើតឡើង ជា យថាហេតុ ។
* សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ចូលរួម សហការ រាយការណ៍ ផ្ដល់ ព័ត៌មាន អំពី ការប្រព្រឹត្ត អំពើហិង្សា ការកាន់កាប់អាវុធ ខុស ច្បាប់ ការប្រើប្រាស់ និង ជួញដូរ គ្រឿងញៀន និង បទល្មើស ផ្សេង ៗ ទៀត ជូន អាជ្ញាធរ មាន សមត្ថកិច្ច ដើម្បី ចាត់ វិធានការ ឱ្យ បាន ទាន់ ពេល វេលា ។
* កងកម្លាំង មាន សមត្ថកិច្ច ត្រូវ ចុះ ប្រតិបត្តិការ ស្រាវជ្រាវ បន្ទាន់ និង ត្រូវ រក្សា ការសម្ងាត់ ជូន ប្រជាពលរដ្ឋ ណា ដែល បាន ផ្ដល់ ព័ត៌មាន ទាក់ទង នឹង បទល្មើស ទាំងនោះ ៕
អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ នឹង រៀបចំ ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ឆ្នាំ ២០២៣ នៅ ដើម ខែ ក្រោយ នេះ
គួរ បញ្ជាក់ ដែរ ថា ខណៈពេល ដែល ពិភពលោក មាន ការរីកចម្រើន គួរឱ្យ កត់សម្គាល់ ក្នុង រយៈពេល ប៉ុន្មាន ទសវត្សរ៍ កន្លងមក នេះ ការឆ្លើយតប នឹង មេរោគ អេដស៍ / ជំងឺ អេដស៍ ជា សកល កំពុង ប្រឈមមុខ នឹង ការគំរាមកំហែង យ៉ាង ធ្ងន់ធ្ងរ រួមទាំង ការផ្តល់ មូលនិធិ មិន គ្រប់គ្រាន់ អត្រា ខ្ពស់ គ្រោះថ្នាក់ នៃ ការចម្លង មេរោគ អេដស៍ ថ្មី ចំនួន ១.៣ លាន នាក់ ជារៀងរាល់ ឆ្នាំ ការស្លាប់ ប្រមាណ ៦៣ម៉ឺន នាក់ ជារៀងរាល់ ឆ្នាំ ហើយ ការឆ្លើយតប មិន ត្រូវបាន ផ្តល់ អាទិភាព ខ្ពស់ គ្រប់គ្រាន់ នោះ ទេ ជាពិសេស នៅក្នុង ប្រទេស ដែល មាន ចំណូល ទាប ។
បើ តាម ការបញ្ជាក់ របស់ លោកស្រី វេជ្ជបណ្ឌិត ហ៊ុយ ស៊ី ខេង ប្រធាន គ្រប់គ្រង កម្មវិធី ប្រចាំ ប្រទេស មានប្រសាសន៍ ថា ការប្រយុទ្ធ នឹង មេរោគ អេដស៍ / ជំងឺ អេដស៍ មិន ទាន់ ចប់ ទេ ! យើង កំពុង អំពាវនាវ ជា សំឡេង តែ មួយ ជាមួយនឹង សហគមន៍ ដែល រស់ នៅ ជាមួយ មេរោគ អេដស៍ ក្រុម ប្រឈមមុខ ខ្ពស់ ឬ រង ផល ប៉ះពាល់ ដោយ មេរោគ អេដស៍ គឺជា ការអំពាវនាវ ឱ្យ មាន សកម្មភាព ក្នុង ការឆ្លើយតប នឹង មេរោគ អេដស៍ ។
ទិវា ពិភពលោក ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ប្រារព្ធ ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ នៅ ថ្ងៃទី១ ខែធ្នូ បាន ផ្តល់ ឱកាស ឱ្យ អ្នកតស៊ូ មតិ មេរោគ អេដស៍ / ជំងឺ អេដស៍ នូវ ឱកាស មួយ ដើម្បី នាំយក ការយល់ដឹង និង មាន ការឆ្លើយតប ជា សកល ក្នុង ការប្រយុទ្ធ ទៅនឹង ការមាក់ងាយ និង ការរើសអើង ដែល អ្នក រស់ នៅ ជាមួយ មេរោគ អេដស៍ មាន ឧបសគ្គ រារាំង ក្នុង ការស្វែងរក សេវា ធ្វើតេស្ត ឈាម និង ព្យាបាល ។ ជំរុញ ឱ្យ រដ្ឋាភិបាល ទូទាំង ពិភពលោក ធានា ឱ្យ បាន មាន ធនធាន និង ឆន្ទៈ នយោបាយ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង មេរោគ អេដស៍ / ជំងឺ អេដស៍ ។
តំណាង អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ (AHF) លោកស្រី វេជ្ជបណ្ឌិត នូ វណ្ណារី បាន ឱ្យដឹង ដែរ ថា នៅក្នុង ឱកាស បុណ្យ អុំ ទូក នេះ ដែរ អង្គការ AHF ក៏ បាន ចូលរួម ជាមួយ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ចែក អនាម័យ ប្រមាណ ៤ម៉ឺន ស្រោម និង មាន ក្រុមការងារ ធ្វើតេស្ត ឈាម រក មេរោគ អេដស៍ ដោយ ឥត គិត ថ្លៃ និង មាន ក្រុមការងារ ចល័ត ចុះ ផ្សព្វផ្សាយ ពី ជំងឺ អេដស៍ ដល់ ប្រជាពលរដ្ឋ និង កីឡាករ អុំ ទូក ផងដែរ ។
សូម បញ្ជាក់ ដែរ ថា អង្គការ មូលនិធិ ថែទាំ សុខភាព អ្នកជំងឺ អេដស៍ AHF ដែល ជា អង្គការ ជំងឺ អេដស៍ ពិភពលោក ដ៏ ធំ បំផុត បច្ចុប្បន្ន កំពុង ផ្តល់ សេវា ថែទាំ វេជ្ជសាស្រ្ត និង / ឬ សេវាកម្ម ដល់ អតិថិជន ជាង ១. ៩លាន នាក់ ក្នុង ៤៥ ប្រទេស ជុំវិញ ពិភពលោក នៅ សហរដ្ឋ អាមេរិក អាហ្វ្រិក អាមេរិក ឡាទីន / ការា បៀន តំបន់ អាស៊ី / ប៉ាស៊ីហ្វិក និង អឺរ៉ុប ៕
( បេរូត ) ៖ ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ស៊ីរី បាន ឱ្យដឹង ថា ការវាយប្រហារ តាម ផ្លូវ អាកាស កាលពី ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ កន្លងទៅ នេះ បាន បណ្ដាលឱ្យ អាកាស យានដ្ឋាន អន្តរជាតិ ក្នុង រដ្ឋធានី ដាម៉ាស ត្រូវ ផ្អាក ដំណើរការ ជា បណ្ដោះអាសន្ន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃចន្ទ ទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
មាន សន្តិភាព ទើប មាន បុណ្យ អុំ ទូក ដ៏ សប្បាយរីករាយ នា ពេលនេះ !
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ខ្មែរ និង ភ្ញៀវ ទេសចរ បរទេស យ៉ាង ច្រើន កុះករ បាន ចូលរួម ពិធី បុណ្យ អុំ ទូក យ៉ាង សប្បាយរីករាយ នៅមុខ ព្រះបរម រាជ វាំង និង ទីកន្លែង ជាច្រើន ទៀត ក្នុង រាជធានី ភ្នំពេញ ។ នៅ តាម បណ្តា ខេត្ត នានា ក៏ ទទួលបាន ភ្ញៀវ ជាតិ និង បរទេស យ៉ាង ច្រើន ដែរ ។
ពិធី បុណ្យ ប្រពៃណី ដ៏ ធំ នេះ ធ្វើឡើង ដើម្បី រម្លឹក វីរភាព កងទ័ព ជើងទឹក គុណ ព្រះគង្គា និង ព្រះធរណី ។ ប៉ុន្តែ បច្ចុប្បន្ន បុណ្យ អុំ ទូក ក៏ ជា ឱកាស រម្លឹក គុណ សន្តិភាព ដែរ ពីព្រោះ ពិធី បុណ្យ ដ៏ ធំ និង ដ៏ សប្បាយរីករាយ នេះ មិន អាច ប្រារព្ធ ធ្វើ បាន ទេ ក្នុង កំឡុង ពេល ដែល ប្រទេស កើត សង្គ្រាម និង ក្នុង របប ខ្មែរ ក្រហម ។ ក្តី សប្បាយរីករាយ កើតមាន តែ នៅក្រោម ម្លប់ សុខ សន្តិភាព តែ ប៉ុណ្ណោះ ។
ជាក់ស្តែង ពិធី បុណ្យ អុំ ទូក ឆ្នាំ នេះ អាច រៀបចំ ធ្វើ បាន ដោយសារតែ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ធានា ការពារ បាន នូវ សុខ សន្តិភាព ដែល រកបាន ដោយ កម្រ និង ជា សមិទ្ធផល នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ដ៏ លំបាក បំផុត របស់ សម្តេច តេជោ ហ៊ុន សែន ។ ខណៈ ដែល ពលរដ្ឋ ខ្មែរ កំពុង សប្បាយ រីករាយ មនុស្ស រាប់ រយ លាន នាក់ លើ ពិភពលោក គ្មាន ឱកាស បែប នេះ ទេ ដោយ ពួកគេ កំពុង រង ទុក្ខវេទនា ដោយសារ ការ បាត់បង់ សន្តិភាព ហើយ សង្គ្រាម កំពុង កើតឡើង នៅក្នុង ប្រទេស របស់ ខ្លួន ។
ឆ្លៀត ឱកាស នេះ យើង ក្រឡេក ថយ ក្រោយ បន្តិច ទៅ មើល អតីតកាល របស់ កម្ពុជា៖ ចាប់តាំងពី រដ្ឋប្រហារ ១៨ មីនា ឆ្នាំ ១៩៧០ ប្រទេស បាន ធ្លាក់ ក្នុង ភ្នក់ភ្លើង សង្គ្រាម ហើយ បាន រអិល ធ្លាក់ ចូល ក្នុង របប វាល ពិឃាដ នៅ ថ្ងៃទី ១៧ មេសា ១៩៧៥ ។ ទម្រាំ អាច សង្គ្រោះ ចេញ ពី ជ្រោះ មរណៈ បាន មក វិញ នា ថ្ងៃ ៧មក រា ១៩៧៩ ខ្មែរ ត្រូវ ហែល ឆ្លង ឆ្អឹង ភ្នំ ស្ទឹង ឈាម សមុទ្រ ទឹកភ្នែក អស់ ជិត ៤ឆ្នាំ ដោយ ក្នុង កំឡុង ពេល នោះ ជីវិត ខ្មែរ ប្រមាណ ៣លាន នាក់ បាន បាត់បង់ ។
ក្រោយ ថ្ងៃ រំដោះ ៧មករា ដំណើរការស្តារ ប្រទេស ឡើងវិញ និង ការស្វែងរក សន្តិភាព ត្រូវបាន ធ្វើជា បន្តបន្ទាប់ រហូត ទីបំផុត សន្តិភាព ត្រូវបាន រកឃើញ ពិតប្រាកដ នៅ ថ្ងៃទី ២៩ ធ្នូ ១៩៩៨ ដោយ ស្នាដៃ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន ។ ដូច្នេះ អំណឹះត ទៅ មេដឹកនាំ ថ្មី រូប ណា ក៏ដោយ ដែល រក្សា ការពារ បាន នូវ សុខ សន្តិភាព ត្រូវ ចាត់ទុក ជា សមិទ្ធផល ធំ ទី១ ដ៏ សំខាន់ ជាង គេ បង្អស់ មុននឹង និយាយ ពី ស្នាដៃ ផ្សេង ទៀត ពីព្រោះ សន្តិភាព ពិតជា មាន តម្លៃ ខ្លាំង ណាស់ សម្រាប់ កម្ពុជា ។
នេះ គឺជា ហេតុផល ដែល ត្រូវ ចាត់ទុក ការធានា ការពារ បាន នូវ សន្តិភាព គឺជា សមិទ្ធផល ទី១ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី ៧ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ។ ដោយសារ សន្តិភាព ទើប យើង អាច ប្រារព្ធ បុណ្យ អុំ ទូក ដ៏ សប្បាយរីករាយ បែប នេះ បាន ៕
ក្រសួង ធនធាន ទឹក ជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ ព្រះរាជាណាចក្រ កម្ពុជា សម្រាប់ ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ក្រសួង បញ្ជាក់ ថា ប្រព័ន្ធ សម្ពាធ ខ្ពស់ ពី ប្រទេស ចិន បន្ត លាតសន្ធឹង និង បង្កើន ឥទ្ធិពល មក លើ ប្រទេស កម្ពុជា ជាមួយនឹង ខ្យល់ មូសុង ឦសាន បក់ ពី មធ្យម ទៅ បង្គួរ ។ ស្ថានភាព បែប នេះ នឹង ធ្វើឱ្យ ធាតុអាកាស ចាប់ពី ថ្ងៃទី ២៧ ដល់ ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ៖
ដោយ ជឿ តាម រឿង នេះ ហើយ បានជា នៅ វេលា យប់ ពេញ បូរមី ខែកត្តិក រៀងរាល់ ឆ្នាំ ខ្មែរ យើង យក ចំណី មាន អំបុក និង ចេក ជាដើម មក បូជា ព្រះចន្ទ ហៅ ថា ពិធី សំពះ ព្រះខែ អក អំបុក ៕ សូម ពាក់ មួក សុវត្ថិភាព ជានិច្ច ពេល បើកបរ ម៉ូតូ ! ស្លាប់ ៥នាក់ និង របួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៦ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ៩នាក់ ។
ក្រុម ជន ប្រដាប់អាវុធ រឹបអូស កប៉ាល់ ដឹក ប្រេង១ គ្រឿង ដែល មាន ទំនាក់ទំនង ជាមួយ អ៉ី ស្រាអែល នៅ ឈូង សមុទ្រ Aden ក្បែរ ប្រទេស យេម៉ែន
( រកាខ្នុរ - ត្បូងឃ្មុំ ) ៖ លោក ទេសរដ្ឋមន្រ្តី ព្រុំ សុខា និង លោកជំទាវ ព្រមទាំង ក្រុម ញាតិ គ្រួសារ បាន ដង្ហែរ អង្គក ឋិន ទាន ទៅ វេរ ប្រគេន ភិក្ខុ សង្ឃ គង់ ចាំ ព្រះវស្សា អស់ កាល ត្រីមាស ក្នុង ពុទ្ធ សីមាវត្ត ហ្លួង រកាខ្នុរ ហៅ វត្ត កណ្តាល ស្ថិត នៅ ឃុំ រកាខ្នុរ ស្រុក ក្រូចឆ្មា ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ក្នុង ឱកាស នោះ ដែរ លោក ទេសរដ្ឋមន្រ្តី និង លោកជំទាវ បាន វេប្រគេន បច្ច័យ សង្កត់ ត្រៃយ៍ ដែល ជា ការចូលរួម ដោយ សទ្ធា ជ្រះថ្លា ក្នុង ពិធី បុណ្យ ក ឋិន សាមគ្គី ពីសំណាក់ ពុទ្ធ បរិស័ទ ជិត ឆ្ងាយ ទាំងអស់ សរុប ចំនួន ១០៨ លាន រៀល សម្រាប់ ជា ប្រយោជន៍ ទ្រទ្រង់ ការកសាង សមិទ្ធិផល នាន ក្នុង វត្ត ។
ជាមួយគ្នា នេះ លោក ទេសរដ្ឋមន្រ្តី បាន ផ្តាំផ្ញើ ដល់ ព្រះសង្ឃ ប្រជាពលរដ្ឋ និង មន្រ្តី អាជ្ញាធរដែនដី ស្រុក ក្រូចឆ្មា ខេត្ត ត្បូងឃ្មុំ ក៏ ដូចជា ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស បន្ត ចូលរួម គាំទ្រ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ក្នុង ការថែរក្សា ការពារ សន្តិភាព វឌ្ឍនភាព និង វិបុលភាព ប្រទេសជាតិ សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ត រៀង ទៅ ៕
ក្រុមហា ម៉ាស អះអាង ថា មេបញ្ជាការ យោធា របស់ ខ្លួន ៤នាក់ ស្លាប់ ក្នុង សង្រ្គាម ជាមួយ អ៉ី ស្រាអែល
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១១ករណី ឃាត់ខ្លួន ជនសង្ស័យ ២៣នាក់ ។
* ករណី ដឹកជញ្ជូន រក្សាទុក ៩ករណី ឃាត់ខ្លួន ១៦ នាក់ * ករណី ប្រើប្រាស់ ២ករណី ឃាត់ខ្លួន ៧នាក់
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នា ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន ចុះ ត្រួតពិនិត្យ កម្លាំង កងរាជអាវុធហត្ថ គោលដៅ ការពារ សន្តិសុខ សុវត្ថិភាព រក្សា សណ្ដាប់ធ្នាប់ និង សង្គ្រោះ បន្ទាន់ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ។
គួរ ជម្រាប ថា រាជ រដ្ឋាភិបាល បាន បញ្ចេញ កម្លាំង ជាង ១ម៉ឺន នាក់ ទាំង នគរបាល អាវុធហត្ថ និង យោធា ទាំង អាជ្ញាធរ ពាក់ព័ន្ធ ដើម្បី ការពារ ថែរក្សា សន្តិសុខ សុវត្ថិភាព រក្សា សណ្ដាប់ធ្នាប់ និង សង្គ្រោះ បន្ទាន់ ជូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ដែល ទៅ មក ចូលរួម កម្សាន្ត ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ៕
កន្លងមក ទីក្រុង សេអ៊ូល ប៉េកាំង និង តូក្យូ បាន ព្រមព្រៀង គ្នា រៀបចំ កិច្ចប្រជុំ កំពូល រៀងរាល់ ឆ្នាំ ដោយ ចាប់ពី ឆ្នាំ ២០០៨ ដើម្បី ពង្រឹង ទំនាក់ទំនង ផ្នែក ការទូត និង សេដ្ឋកិច្ច រវាង គ្នា ប៉ុន្តែ ផែនការ នេះ ត្រូវបាន រារាំង ដោយ បញ្ហា វិវាទ ទ្វេ ភាគី បូករួម ជាមួយ ការរាតត្បាត ជា សកល នៃ ជំងឺ កូវីដ១៩ ។ កិច្ចប្រជុំ ត្រី ភាគី ចុងក្រោយ បង្អស់ រវាង មេដឹកនាំ ប្រទេស ទាំង៣ គឺ ត្រូវបាន ធ្វើឡើង តាំងតែពី ឆ្នាំ ២០១៩ ។
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ តំណាង គ្រួសារ សព បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ ជូន ថ្នាក់ដឹកនាំ ចំពោះ សមាន ចិត្ត ចូលរួម រំលែក មរណទុក្ខភាព របស់ មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ យិប ថាំ កេសន ដែលា ត្រូវ ជា ម្តាយ ក្មេក ។
កាយវិការ ដ៏ ប្រពៃ ខាងលើ នេះ ជា កម្លាំងចិត្ត ដ៏ មាន សារៈសំខាន់ ដែល ស្ដែង ឱ្យ ឃើញ នូវ សមាន ចិត្ត ស្រលាញ់ រាប់អាន ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច ឯកឧត្តម លោកជំទាវ អ្នក ឧកញ៉ា ឧកញ៉ា លោក លោកស្រី នាង កញ្ញា ចំពោះ សព មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ យិប ថាំ កេសន និង ក្រុមគ្រួសារ របស់ យើងខ្ញុំ ។
ជាថ្មី ម្ដង ទៀត ខ្ញុំ និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ សព មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ យិប ថាំ កេសន សូម ថ្លែងអំណរគុណ និង សូម ជូនពរ ចំពោះ សម្តេច ឯកឧត្ដម លោកជំទាវ អ្នក ឧកញ៉ា ឧកញ៉ា លោក លោក សី នាង កញ្ញា សូម បាន ប្រកបដោយ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
លោក ប្រធានាធិបតី អ៊ុយក្រែន បាន បន្ត ថា ទីក្រុង កៀវ សង្ឃឹម នឹង អាច ដោះស្រាយ បញ្ហា ខ្វះខាត ប្រព័ន្ធ ការពារ ដែន អាកាស តាមរយៈ ការជួយ ផ្គត់ផ្គង់ ថ្មី ៗ ពីសំណាក់ ដៃគូ និង ការបង្កើន សមត្ថភាព ផលិត ដោយ ខ្លួន ឯង ។ កាលពី ថ្ងៃសៅរ៍ រុស្ស៉ី បាន បើក ការវាយប្រហារ ដោយ ដ្រូន ចំនួន ៧៥ គ្រឿង មក លើ រដ្ឋធានី របស់ អ៊ុយក្រែន និង តំបន់ ជុំវិញ ដែល ជា ការវាយប្រហារ ធំ បំផុត របស់ រុស្ស៉ី ដោយ ប្រើប្រាស់ យន្តហោះ ដ្រូន គិត ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
ចិន បាន ចោទប្រកាន់ ថា ឧប្បត្តិហេតុ នា ចុង សប្តាហ៍ នេះ សបញ្ជាក់ ឱ្យ ឃើញ ថា សហរដ្ឋ អាមេរិក គឺជា អ្នកបង្កើត ហានិភ័យ សន្តិសុខ សុទ្ធសាធ នៅ តំបន់ សមុទ្រ ចិន ខាងត្បូង ។ រីឯ កងទ័ព ជើងទឹក អាមេរិក បាន ចេញ សេចក្តីថ្លែងការណ៍ ថា សហរដ្ឋ អាមេរិក ប្រកាន់ ជំហរ តវ៉ា ជានិច្ច ចំពោះ ការទាមទារ ដែន សមុទ្រ ជ្រុល ហួសហេតុ នៅ ជុំវិញ ពិភពលោក ដោយ មិន ខ្វល់ អំពី អត្តសញ្ញាណ នៃ អ្នក ទាមទារ ឡើយ ខណៈ ការទាមទារ បែប នោះ នៅ សមុទ្រ ចិន ខាងត្បូង បង្ក ការគំរាមកំហែង ធ្ងន់ធ្ងរ មួយ ចំពោះ សេរីភាព នៃ ដែន សមុទ្រ ។
( ភ្នំពេញ ) ៖ ដោយ មាន ការអនុញ្ញាត ពី នាយ ឧត្តមសេនីយ៍ សៅ សុខា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ឧត្តមសេនីយ៍ ត្រី អេង ហ៊ី អ្នកនាំពាក្យ នៅ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ បាន ចេញមក ឆ្លើយតប បំភ្លឺ ចំពោះ ការបញ្ចេញមតិ របស់ បុគ្គល ចំនួន ២រូប នៅក្នុង គណនី ហ្វេសប៊ុក របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ។
ចំពោះ ករណី នេះ លោក ឧត្តមសេនីយ៍ ត្រី អេង ហ៉ី សូម ឆ្លើយតប និង បកស្រាយ ជូន សាធារណជន អ្នកសារព័ត៌មាន និង បុគ្គល ដែល ពាក់ព័ន្ធ ជ្រាប ថា៖
ទី៣៖ កងរាជអាវុធហត្ថ បាន អប់រំ យោធិន គ្រប់ រូប ឱ្យ គោរព ច្បាប់ គោរព វិន័យ កងទ័ព ក្រមសីលធម៌ វិជ្ជាជីវៈ និង ប្រកាន់ខ្ជាប់ខ្ជួន នូវ ទិស ស្លាក « ចំពោះ ប្រទេសជាតិ ត្រូវតែ ការពារ ចំពោះ ប្រជា ត្រូវតែ បម្រើ ច្បាប់ ត្រូវតែ គោរព បទល្មើស ត្រូវតែ បង្ក្រាប »៕ រដ្ឋមន្ត្រី សុខាភិបាល ចុះ ពិនិត្យ ទីតាំង តង់ សុខភាព តាម គោលដៅ ទាំង១០ សម្រាប់ ផ្តល់ សេវា សុខាភិបាល ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ឈាង រ៉ា រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល រួម ជាមួយ ថ្នាក់ដឹកនាំ ក្រសួង សុខាភិបាល និង អភិបាល រង រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ២៥ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បាន អញ្ជើញ ចុះ ពិនិត្យ ទីតាំង ជម្រក តង់ សុខភាព ចំនួន ១០ទីតាំង នៅ តាម បណ្តា គោលដៅ នានា ត្រៀម ក្នុង ការផ្តល់ សេវា សុខាភិបាល ជូន ប្រជាពលរដ្ឋ ដែល ចូលរួម ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ចាប់ពី ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នៅ រាជធានី ភ្នំពេញ ។
សូម បញ្ជាក់ ថា ក្រសួង សុខាភិបាល បាន ត្រៀម ក្រុម គ្រូពេទ្យ និង រថយន្ត គិលានុសង្រ្គោះ សរុប ចំនួន ៧០ គ្រឿង ដែល មាន រថយន្ត ប្រចាំ ការតាម គោលដៅ ចំនួន ៥០ គ្រឿង រថយន្ត គ្លីនិក ចល័ត ចំនួន ៤គ្រឿង និង ជម្រក តង់ ពិនិត្យ សុខភាព ដើម្បី ផ្តល់ សេវា សុខាភិបាល ចំនួន ១៥កន្លែង ដែល ផ្តល់ សេវា ២៤ ម៉ោង លើ ២៤ ម៉ោង ។ ដោយឡែក នៅ ទីស្តីការ ក្រសួង សុខាភិបាល ក៏ បាន ត្រៀម រថយន្ត គិលាន សង្រ្គោះ ចំនួន ២០ គ្រឿង ដើម្បី ប្រចាំ ការត្រៀម អន្តរាគមន៍ សង្រ្គោះ បន្ទាន់ ក្នុង ករណី ចាំបាច់ បំផុត ។
ក្នុង ឱកាស ចុះ ពិនិត្យ នោះ ដែរ លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី ក៏ បាន ថ្លែងអំណរគុណ ដល់ មន្រ្តី សុខាភិបាល ពាក់ព័ន្ធ ដែល បាន លះបង់ ទាំង កម្លាំង កាយ ចិត្ត ចូលរួម បំពេញ ភារកិច្ច ដើម្បី ផ្តល់ សេវា ជូន ប្រជាពលរដ្ឋ នា ឱកាស ដ៏ វិសេសវិសាល នេះ ។ លោក រដ្ឋមន្រ្តី ក៏ បាន ថ្លែង ជូនពរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ទទួលបាន នូវ សុខភាព ល្អ និង សប្បាយរីករាយ នា ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក នេះ ៕
ផែនការ នេះ រដ្ឋាភិបាល បាន យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការទាក់ទាញ អ្នក វិនិយោគ បរទេស តាមរយៈ ការដោះស្រាយ បញ្ហា ដែល អ្នកវិនិយោគ បរទេស ត្រូវការ គឺ ការផ្គត់ផ្គត់ កម្លាំង ពលកម្ម ជំនាញ គ្រប់គ្រាន់ ។ នៅ រយៈពេល មធ្យម ខាងមុខ នោះ ប្រាក់ ចំណូល របស់ ពលរដ្ឋ កម្ពុជា ម្នាក់ ៗ ជា មធ្យម នឹង កើន ដល់ ប្រមាណ ៤ពាន់ ដុល្លារ អាមេរិក ដែល មាន កំណើន ពីរ ដង បើ ធៀប នឹង ពេល បច្ចុប្បន្ន ៕
ស្រោម អនាម័យ ប្រមាណ ១០ម៉ឺន ស្រោម នឹង ចែកជូន ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក
យុទ្ធនាការ ផ្សេព្វផ្សាយ អប់រំ ក្នុង ព្រឹត្តិការណ៍ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក មាន រៀប ជា ស្តង់ និង ក្រុម ចល័ត សម្រាប់ ផ្សព្វផ្សាយ អប់រំ សុខភាព ដល់ កីឡាករ អុំ ទូក និង ប្រជាពលរដ្ឋ ទូទៅ ស្តីពី ការបង្ការ ការចម្លង មេរោគ អេដស៍ ការធ្វើតេស្ត រក មេរោគ អេដស៍ ការចែកជូន អាវយឺត ចែក ទឹក រំអិល និង ស្រោម អនាម័យ ដោយ ឥត គិត ថ្លៃ ។
( ភ្នំពេញ ) ៖ នៅក្នុង ឱកាស ពិធី បុណ្យ ឯករាជ្យ ជាតិ និង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ឆ្នាំ ២០២៣ នេះ យោង តាម សេចក្តីក្រាបបង្គំទូល ថ្វាយ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី . ព្រះមហាក្សត្រ ទ្រង់ សព្វ ព្រះរាជ ហឫទ័យ ប្រោសប្រទាន ការបន្ធូរបន្ថយ ទោស និង លើកលែង ទោស ដល់ ទណ្ឌិត សម្រាប់ ពិធី បុណ្យ ទាំង ពីរ នេះ សរុប ចំនួន ៥៣៨ នាក់ ( ក្នុង នោះ មាន ស្រី ៤៣ នាក់ ) ។ នេះ បើ តាម លោក គឹម សន្តិភាព រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ ។
ក្នុង ចំណោម ទណ្ឌិត ដែល ត្រូវបាន បន្ធូរបន្ថយ និង លើកលែង ទោស នោះ រួម មាន៖
ជាមួយគ្នា នេះ លោក គឹម សន្តិភាព បាន បញ្ជាក់ ថា គណៈកម្មការ ជាតិ ពុំ លើក យកមក ពិនិត្យ ពិចារណា នោះ ឡើយ ចំពោះ សំណើ ទាំងឡាយ ណា ទាក់ទង នឹង ទណ្ឌិត ដែល បាន ប្រព្រឹត្ត អំពើ ដូច ខាងក្រោម៖
១៖ ចំពោះ បទល្មើស ទូទៅ * ឧក្រិដ្ឋ ជន គ្រឿងញៀន * អំពើ សាហាវ យង់ឃ្នង * ករណី មិន រាងចាល * ប្រព្រឹត្ត លើ ជនរងគ្រោះ ដែល ជា សាច់ញាតិ ឬ សហព័ទ្ធ * ប្រព្រឹត្ត លើ ជនរងគ្រោះ ជា មន្ត្រីរាជការ ឬ មន្ត្រី សាធារណៈ * ទណ្ឌិត ធ្លាប់ ទទួលបាន ការបន្ធូរបន្ថយ ទោស ម្តង រួច មកហើយ
ថ្ងៃទី១ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ត្រូវបាន ធានា យ៉ាង ល្អ ប្រសើរ ជាមួយ អ្នកទេសចរ ជាង ១លាន នាក់ (Video inside) ( ភ្នំពេញ ) ៖ ថ្ងៃទី១ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក បញ្ហា សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ត្រូវបាន ធានា ទាំងស្រុង យ៉ាង ល្អ ប្រសើរ ។ នេះ បើ តាម របាយការណ៍ របស់ អនុគណៈកម្មការ ការពារ រក្សា សន្ដិសុខ របៀបរៀបរយ សណ្ដាប់ធ្នាប់ សង្គម ចរាចរណ៍ សង្គ្រោះ ទូក លិច និង អ្នកជំងឺ ។
សភាព បទល្មើស ព្រហ្មទណ្ឌ ពុំ មាន អ្វី កើតឡើង គួរឲ្យ កត់សម្គាល់ ឡើយ ។ ក្រុម គ្រូពេទ្យ ប្រចាំ ការ នៅ តាម គោលដៅ បាន ធ្វើ ការសង្រ្គោះ បឋម ដល់ អ្នក ដែល មាន បញ្ហា សុខភាព សរុប ចំនួន ១. ៦៧៤ នាក់ ( ស្រី ២៤៣ នាក់ ) និង បញ្ជូន ទៅ សង្រ្គោះ នៅ មន្ទីរពេទ្យ ចំនួន ០១ នាក់ ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០១ នៃ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ត្រូវនឹង ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ សភាពការណ៍ សន្តិសុខ សណ្តាប់ធ្នាប់ មាន ភាពល្អ ប្រសើរ ដែល មាន ប្រជាពលរដ្ឋ មក ចូលរួម កម្សាន្ត សប្បាយ យ៉ាង ច្រើន កុះករ ប្រមាណ ១ ២០០ ០០០ នាក់ ។ នេះ បើ តាម របាយការណ៍ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក កម្លាំង សមត្ថកិច្ច ចម្រុះ ប្រមាណ ជាង ១៦.០០០ នាក់ ត្រូវបាន ដាក់ពង្រាយ តាម គោលដៅ សំខាន់ ៗ ដើម្បី ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
ក្នុង នោះ កម្លាំង នគរបាល មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ដែល ដឹកនាំ ផ្ទាល់ ដោយ លោក ឧត្តមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ នាយក មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ក៏ បាន ចូលរួម ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សុវត្ថិភាព ក្នុង ឱកាស ប្រារព្ធ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ផងដែរ ក្នុង រយៈពេល ៣ ថ្ងៃ នេះ ៕ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បង្ហាញ លេខ ទូរស័ព្ទ ៥ខ្សែ សម្រាប់ ឱ្យ ប្រជាពលរដ្ឋ សុំ ជំនួយ ពេល មាន បទល្មើស ឬ ករណី បាត់ មនុស្ស ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
ជាមួយគ្នា នេះ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ បង្កើន នូវ ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ នៅពេល ដើរកម្សាន្ដ ទាំង សម្ភារៈ មាន តម្លៃ និង សមាជិក ក្រុមគ្រួសារ ជាដើម ខណៈ កម្លាំង សមត្ថកិច្ច ត្រូវបាន ពង្រាយ គ្រប់ គោលដៅ ដើម្បី ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ក្នុង បុណ្យ ជាតិ ដ៏ សំខាន់ មួយ នេះ ៕ បងប្អូន ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ នាំគ្នា ដើរលេង កម្សាន្ត នៅ តាម មាត់ ទន្លេ និង មុខ ព្រះបរម រាជ វាំង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក យប់ ទី១
( ភ្នំពេញ ) ៖ បងប្អូន ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ នាំគ្នា ដើរលេង កម្សាន្ត នៅ តាម មាត់ ទន្លេ និង មុខ ព្រះបរម រាជ វាំង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ យប់ ទី១ អម ដោយ ការប្រគុំតន្ត្រី និង ការសម្តែង ទស្សនីយភាព ផ្សេង ៗ ដែល បង្ក ការសប្បាយរីករាយ យ៉ាង ខ្លាំង ។
ជាមួយគ្នា នេះ គេ សង្កេតឃើញ កងកម្លាំង សមត្ថកិច្ច ជាច្រើន នាក់ ត្រូវបាន ដាក់ពង្រាយ គ្រប់ គោលដៅ ដើម្បី ការពារ សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ ជូន បងប្អូន បាន យ៉ាង ល្អ ប្រសើរ ។
ទិដ្ឋភាព ទាំងនេះ បាន បង្ហាញ ឲ្យ ឃើញ ពី សង្គមជាតិ មាន សុខ សន្តិភាព ពេញលេញ ដែល បាន ផ្តល់ ឱកាស ឲ្យ ប្រជាពលរដ្ឋ ដើរលេង កម្សាន្ត ដោយ សេរី និង សប្បាយរីករាយ ខណ: ដែល ប្រទេស ខ្លះ កំពុង កើតមាន សង្គ្រាម ហែក ហួរ ស្លាប់ និង របួស មនុស្ស រាប់ ពាន់ នាក់ ។ សូម រួមគ្នា ការពារ សន្តិភាព ឲ្យបាន ។
( ភ្នំពេញ ) ៖ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន លោក បណ្ឌិត អ៊ាង សុផល្លែត និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ បាន ឧបត្ថម្ភ ថវិកា ដល់ កីឡា អ្នក ប្រណាំង ទូក ចំនួន ២លាន រៀល ក្នុង មួយ ទូក ដែល ក្នុង នេះ ទូក មកពី ខេត្ត ត្បូងឃ្មុំ មាន ចំនួន ១០ទូក បាន មក ចូលរួម ប្រកួត ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក នៅ រាជធានី ភ្នំពេញ ។
នាយ ឧត្តមសេនីយ៍ ស ថេត ពិនិត្យ កាមេរ៉ា សុវត្ថិភាព បម្រើ ឲ្យ កិច្ចការពារ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
( ភ្នំពេញ ) ៖ នា រសៀល ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ អញ្ជើញ ពិនិត្យ កាមេរ៉ា សុវត្ថិភាព បម្រើ ឲ្យ កិច្ចការពារ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សុវត្ថិភាព ក្នុង ឱកាស ប្រារព្ធ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ឆ្នាំ ២០២៣ នៅ នាយកដ្ឋាន អង្គរក្ស ។
ការបំពាក់ កាមេរ៉ា សុវត្ថិភាព នៅ តាម ទីតាំង សំខាន់ ៗ ស្ទើរតែ ពេញ ទីតាំង ប្រារព្ធ ពិធី នេះ ដេីម្បី ការពារ នូវ សុវត្ថិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ ថ្វាយ អង្គ ព្រះមហាក្សត្រ ថ្នាក់ដឹកនាំ ជាតិ កំពូល ៗ ភ្ញៀវ ជាតិ និង អន្តរជាតិ និង ប្រជាពលរដ្ឋ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដើម្បីឲ្យ ព្រះរាជ ពិធី នេះ ប្រព្រឹត្តទៅ ប្រកបដោយ ភាពសប្បាយរីករាយ ។
គិត ត្រឹម ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ កម្លាំង សមត្ថកិច្ច ចម្រុះ ប្រមាណ ជាង ១៦.០០០ នាក់ ត្រូវបាន ដាក់ពង្រាយ តាម គោលដៅ សំខាន់ ៗ រួចរាល់ហើយ ដើម្បី ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល នឹង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ១៧៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១១.២០២ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១០.២១៤ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៥៧០ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង ល្មើស ភ្លើង - ផ្លាក សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ល្មើស ភ្លើង - ផ្លាក សញ្ញា អត់ បណ្ណ បើកបរ និង ល្មើស ល្បឿន ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៥ នាក់ របួស ចំនួន ០៩ នាក់ ( របួស ធ្ងន់ ចំនួន ០៥ នាក់ ) ។ រយៈពេល ២៦ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២៣៦ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១១១ នាក់ របួស ៣៤៧ នាក់ ( របួស ធ្ងន់ ២១៥ នាក់ )៕
