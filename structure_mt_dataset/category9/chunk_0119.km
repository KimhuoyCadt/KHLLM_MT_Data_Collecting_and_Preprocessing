( ភ្នំពេញ ) ៖ លោក ចាន់ តារា អភិបាល នៃ គណៈអភិបាល ក្រុង អរិយក្សត្រ រួម ជាមួយ សមាជិក ក្រុមប្រឹក្សា ក្រុង អភិបាល រង ក្រុង និង សហការី មន្រ្តី រាជការ ក្រោម ឱវាទ បាន អញ្ជេីញ ចូលរួម ក្នុង ពិធី បេីក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ២០២៣ - ២០២៤ ជា និមិត្តរូប ទូទាំង ក្រុង អរិយក្សត្រ ស្ថិត នៅ វិទ្យាល័យ ហ៊ុន សែន ពាម ឧកញ៉ា អុង ស្ថិត ក្នុង សង្កាត់ ពាម ឧកញ៉ា អុង ក្រុង អរិយក្សត្រ ខេត្ត កណ្តាល ។
ថ្លែង ក្នុង ពិធី បេីក បវេសនកាល លោក អភិបាល ក្រុង បាន សម្តែង នូវ ការកោតសរសេី រ ចំពោះ លោកគ្រូ - អ្នកគ្រូ មាតា - បិតា អាណាព្យាបាល សិស្ស ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង រួមចំណែក ទាំង កម្លាំង កាយ កម្លាំងចិត្ត ទាំង ធនធាន សម្រាប់ ជួយ ជ្រោមជ្រែង និង អភិវឌ្ឍន៍ វិស័យ អប់រំ ឱ្យ មាន ដំណើរការ ប្រកបដោយ ជោគជ័យ ក្នុង រយៈកាល កន្លងមក នេះ ។
ក្នុង ឆ្នាំ សិក្សា ថ្មី នេះ សូម ផ្តាំផ្ញើរ ដល់ សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង រៀនសូត្រ ដើម្បី ក្លាយទៅជា សិស្ស ល្អ ពលរដ្ឋ ល្អ មាន ចំណេះដឹង សម្រាប់ ជា សសរ ទ្រូង ប្រទេសជាតិ និង ជា ធនធាន មនុស្ស ដ៏ ល្អ របស់ សង្គមជាតិ ៕ សន្និសីទ កំពូល ស្តីពី ការប្រែប្រួល អាកាសធាតុ COP28 នៅ ទីក្រុង ឌូបៃ ចាប់ផ្តើម ហើយ !
សន្និសីទ កំពូល នេះ មាន ការអញ្ជើញ ចូលរួម ពី ប្រតិភូ នៃ ប្រទេស សមាជិក ចំនួន ១៩៦ រួមទាំង អ្នកដឹកនាំ ធុរកិច្ច យុវជន អ្នកវិទ្យាសាស្ត្រ ជនជាតិ ដើម ភាគ តិច អ្នកសារព័ត៌មាន អ្នកសង្កេតការណ៍ តំណាង ស្ថាប័ន អង្គការ សហ ប្រជាជាតិ អង្គការ អន្តរជាតិ អង្គការ មិន មែន រដ្ឋាភិបាល និង អ្នក ពាក់ព័ន្ធ ផ្សេង ទៀត សរុប ប្រមាណ ជិត ៧០ ០០០ នាក់ ។
រាជ រដ្ឋាភិបាល ចេញ អនុក្រឹត្យ ស្តីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ របស់ អគ្គ លេខាធិការដ្ឋាន នៃ អាជ្ញាធរ ជាតិ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ
( ភ្នំពេញ ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន សម្រេច បង្កើត អគ្គ លេខាធិការដ្ឋាន មួយ ដើម្បី ប្រតិបត្តិការ នូវ ការងារ របស់ អាជ្ញាធរ ជាតិ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ២ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ព្រះមហាក្សត្រ បាន ឡាយ ព្រះហស្ថលេខា បង្កើត អាជ្ញាធរ ជាតិ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ។
យោង តាម ព្រះរាជ ក្រឹត្យ បាន គូសបញ្ជាក់ ថា អាជ្ញាធរ ជាតិ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ជា យន្តការបំពេញ បន្ថែម ឱ្យ ប្រព័ន្ធ ដោះស្រាយ វិវាទ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ដែល សំដៅ លើកកម្ពស់ គុណភាព ប្រសិទ្ធភាព និង ភាពឆាប់រហ័ស នៃ ការដោះស្រាយ វិវាទ តាមរយៈ ការស្រុះ ស្រួល ក្រៅ ប្រព័ន្ធ តុលាការ និង កាត់បន្ថយ ការកកស្ទះ សំណុំរឿង ដើម្បី ធានា បាន នូវ ភាព សុខដុមរមនា ក្នុង សង្គមជាតិ ។
សម្តេច តេជោ ហ៊ុន សែន អនុញ្ញាតឱ្យ រដ្ឋមន្ត្រី ការពារ ជាតិ ថៃ ជួប សម្តែង ការគួរសម
យោង តាម បណ្តាញ សង្គម សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឱ្យដឹង ថា ក្នុង ជំនួប លោក សុធីន ខ្លាំង សែង បាន ថ្លែងអំណរគុណ សម្តេច ធិបតី ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មមាញឹក អនុញ្ញាតឱ្យ រូប លោក និង គណៈប្រតិភូ ជួប សម្តែង ការគួរសម ។ លោក រដ្ឋមន្ត្រី ការពារ ជាតិ ថៃ ក៏ បាន នាំយក ការសាកសួរ សុខទុក្ខ ពីសំណាក់ លោក នាយក រដ្ឋមន្ត្រី ថៃ ជូន សម្តេច ធិបតី ប្រកបដោយ មនោសញ្ចេតនា ជិតស្និទ្ធ និង ស្មារតី នៃ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ល្អ លើ គ្រប់ វិស័យ ជាពិសេស លើ វិស័យ ការពារ ជាតិ ឱ្យ បាន កាន់តែ រឹងមាំ ថែម ទៀត ។
លោក រដ្ឋមន្ត្រី ការពារ ជាតិ ក៏ បាន បញ្ជាក់ អំពី ការគាំទ្រ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ការពារ ជាតិ តាមរយៈ ការបន្ត ផ្តល់ អាហារូបករណ៍ ដល់ សិក្ខាកាម យោធា កម្ពុជា ផងដែរ ។
សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន សម្តែង ការស្វាគមន៍ រដ្ឋមន្ត្រី ការពារ ជាតិ ថៃ និង គណៈប្រតិភូ ដែល បាន បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ កម្ពុជា ។ សម្តេច ធិបតី បាន អរគុណ ដល់ ភាគី មិត្ត ថៃ ដែល បន្ត ផ្តល់ ការគាំទ្រ ដល់ ការហ្វឹកហ្វឺន បណ្តុះបណ្តាល ធនធាន មនុស្ស កម្ពុជា តាម បណ្តា យោធ ភូមិភាគ និង មជ្ឈមណ្ឌល ហ្វឹកហ្វឺន នានា ។
សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ បាន គាំទ្រ ការ បន្ត រៀបចំ លំហាត់ រួម គ្រប់ កម្រិត និង ប្រភេទ ទ័ព ព្រមទាំង បាន បញ្ជាក់ អំពី ការគាំទ្រ ដល់ កិច្ចសហប្រតិបត្តិការ ដែល បាន ឯកភាព គ្នា រវាង ក្រសួង ការពារ ជាតិ ប្រទេស ទាំង ពីរ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន គូសបញ្ជាក់ ផងដែរ អំពី ការបន្ត កិច្ចសហការ ជិតស្និទ្ធ តាម ខ្សែ បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ក្នុង ការគ្រប់គ្រង គ្រោះមហន្តរាយ ធម្មជាតិ និង ទប់ស្កាត់ រាល់ បទល្មើស ឆ្លង ដែន នានា សំដៅ ធានា បាន តំបន់ ព្រំដែន សន្តិភាព ជូន ប្រជាពលរដ្ឋ ទាំង ពីរ ដែល កំពុង រស់ នៅ ប្រកប ការងារ និង ធ្វើ ពាណិជ្ជកម្ម ផ្សេង ៗ ប្រកបដោយ សុខ សុវត្ថិភាព ៕ លោក កែវ រតនៈ៖ ថាមពល ស្អាត រួមចំណែក ទាក់ទាញ ការវិនិយោគ (Video inside)
( ភ្នំពេញ ) ៖ លោក កែវ រតនៈ រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល បាន គូស រំលេច ថា ថាមពល អគ្គិសនី ស្អាត ដែល ជា ថាមពល បាន មកពី កម្លាំង ទឹក ព្រះអាទិត្យ និង ខ្យល់ មិន ត្រឹមតែ ជួយ ដល់ បរិស្ថាន ភព ផែនដី ប៉ុណ្ណោះ ទេ តែ ក៏ បាន រួមចំណែក ទាក់ទាញ ការវិនិយោគ មកកាន់ កម្ពុជា ផងដែរ ។
អគ្គិសនី មិន ស្អាត ឬ អគ្គិសនី បង្ក ផល ប៉ះពាល់ ដល់ បរិស្ថាន ដល់ ភព ផែនដី កំពុង ត្រូវបាន ពិភពលោក រួមគ្នា លុបបំបាត់ ។ ក្នុង ន័យ នេះ ផលិតផល ទាំងឡាយ ដែល ផលិត ដោយ ប្រើ ថាមពល អគ្គិសនី មិន ស្អាត នឹង រង សម្ពាធ ពី អ្នកទិញ ផងដែរ ។ ពួក នឹង គេ មិន គាំទ្រ លើ ផលិតផល ដែល ផលិត ដោយ ថាមពល មិន ស្អាត នោះ ឡើយ ដើម្បី ជា ចំណែក ជួយ ដល់ យុទ្ធនាការ ការពារ បរិស្ថាន ឬ សង្គ្រោះ ភព ផែនដី ។ ក្រោម ហេតុផល នេះ អ្នកផលិត ទាំងឡាយ មុននឹង ទៅ វិនិយោគ នៅ ប្រទេស ណាមួយ ពួកគេ ក៏ នឹង ពិនិត្យ លក្ខខណ្ឌ នៃ ប្រភព ថាមពល អគ្គិសនី ផងដែរ ។
លោក កែវ រតនៈ បាន ពន្យល់ បែប នេះ « អ្នក វិនិយោគ គាត់ មាន សម្ពាធ ពី អ្នកប្រើប្រាស់ ។ ឧទាហរណ៍ នៅពេល យើង ផលិត ខោអាវ ផលិត កង់ ផលិត ស្បែកជើង នាំចេញ ទៅ ទីផ្សារ ពិភពលោក អ្នកប្រើប្រាស់ នៅ ជប៉ុន នៅ អាមេរិក នៅ អាមេរិក កណ្តាល និង ទ្វីប ផ្សេង ទៀត អ្នកប្រើប្រាស់ ទាំងនោះ ចង់ ចូលរួមចំណែក ការពារ កម្តៅ ផែនដី កុំ ឱ្យ ឡើង ។ ដូច្នេះ គេ ចង់ ទិញ ផលិតផល ណា ដែល ចេញ ពី ថាមពល ស្អាត » ។
ក្រោម និន្នាការ បែប នេះ លោក កែវ រតនៈ បាន អះអាង ថា គោលដៅ កម្ពុជា ផលិត ថាមពល ស្អាត ឱ្យ បាន ៧០ ភាគរយ នៅ ឆ្នាំ ២០៣០ នឹង រួមចំណែក ដល់ ការទាក់ទាញ អ្នក វិនិយោគ កាន់ កម្ពុជា ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ បែប នេះ « បើ កម្ពុជា យើង រុញ ថាមពល ស្អាត ឱ្យ ដល់ ៧០ ភាគរយ នេះ ជា ក្តីសង្ឃឹម ថ្មី ។ មាន ន័យ ថា ជា ការទាក់ទាញ វិនិយោគ ឱ្យ មក ផលិត នៅ កម្ពុជា ពីព្រោះ បើ អ្នកផលិត ទៅ ប្រទេស ដែល ប្រើ ថាមពល មិន ស្អាត ច្រើន គេ អត់ ចង់ ទិញ ការធ្វើ ទីផ្សារ លំបាក ។ ដូច្នេះហើយ ទើប ប៉ុន្មាន ឆ្នាំ នេះ ដោយសារ ថាមពល យើង ស្អាត ដល់ ៦២ ភាគរយ រួចហើយ អ៊ីចឹង ហើយ បាន យើង ឃើញ ថា រោងចក្រ កាត់ដេរ ច្រើន ណាស់ កំពុង បន្ត វិនិយោគ នៅ កម្ពុជា » ។
សូម បញ្ជាក់ ថា គិត ត្រឹម ចុង ឆ្នាំ ២០២២ កម្ពុជា អាច ផលិត ថាមពល អគ្គិសនី បាន រហូតដល់ទៅ ៤. ៤៩៥. ៤២ មេហ្គាវ៉ាត់ ។ ក្នុង នោះ ៦២ ភាគរយ ជា ថាមពល ស្អាត បាន មកពី វារី អគ្គិសនី និង ពន្លឺ ព្រះអាទិត្យ ៕
ភាព ញៀន គ្រឿងញៀន ជា ជំងឺ ខួរក្បាល អាច ព្យាបាល បាន ! បង្ក្រាប បទល្មើស គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី១ ខែ ធ្នូ៖ បង្ក្រាប ៨ករណី ឃាត់ខ្លួន ២៦ នាក់
ក្នុង កិច្ចពិភាក្សា នៅ ថ្ងៃ តី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ លោកស្រី រដ្ឋមន្ដ្រី ចម និម្មល បាន លើកឡើង អំពី វឌ្ឍនភាព និង កាលានុវត្តភាព នៃ ការធ្វើ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង អេមីរ៉ាត អារ៉ាប់ រួម និង អំពី សារៈសំខាន់ នៃ ការធ្វើ សមាហរណកម្ម ពាណិជ្ជកម្ម នៅក្នុង តំបន់ និង សកល ជាពិសេស ភាព ចាំបាច់ ក្នុង ការតភ្ជាប់ តំបន់ អាស៊ាន និង ឈូង សមុទ្រ (Gulf Cooperation Council) ដែល ជា គន្លឹះ ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ប្រកបដោយ ចីរភាព ការចូលរួម ក្នុង ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ និង ការលើកកម្ពស់ ន វានុវត្តន៍ ជាដើម ។
រដ្ឋមន្ត្រី ទាំង ពីរ រូប បាន លើកឡើង អំពី សុទិដ្ឋិនិយម ខ្ពស់ ចំពោះ សក្តានុពល ដែល នឹង ទទួលបាន ពី កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ Cambodia-UAE CEPA ហើយ បាន កត់សម្គាល់ រួមគ្នា អំពី តួនាទី របស់ ប្រទេស អភិវឌ្ឍន៍ និង កំពុង អភិវឌ្ឍន៍ ក្នុង ការជំរុញ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ឌីជីថល បរិស្ថាន ការប្រកួតប្រជែង ការអភិវឌ្ឍ សមត្ថភាព យុវជន និង ការសម្រប ខ្លួន ទៅនឹង បដិវ ដ្តកម្ម បច្ចេកវិទ្យា ដែល កំពុង មាន ការប្រែប្រួល យ៉ាង ឆាប់រហ័ស ។
សូម ជម្រាប ថា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី នេះ កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ រវាង កម្ពុជា និង អេមីរ៉ាត អារ៉ាប់ រួម ត្រូវបាន ចុះហត្ថលេខា នៅ រសៀល ថ្ងៃទី ៨ ខែមិថុនា ឆ្នាំ ២០២៣ កន្លងទៅ ។
កម្ពុជា នឹង មាន លទ្ធភាព ក្នុង ការធ្វើ ពិពិធកម្ម ទីផ្សារ សម្រាប់ ការនាំចេញ ទៅកាន់ ប្រទេស អារ៉ាប់ រួម និង អាច ឈាន ទៅ ចាប់ យក ឱកាស ទីផ្សារ អារ៉ាប់ ដទៃ ទៀត ក្នុង តំបន់ បជ្ឈឹម បូព៌ា និង អាហ្រ្វិក ខាងជើង ដែល ជា តំបន់ ស្ថិត នៅក្បែរ នោះ ។ ចំពោះ ទំនិញ សំខាន់ ៗ របស់ កម្ពុជា មួយចំនួន ជាពិសេស សម្លៀកបំពាក់ ស្បែកជើង នឹង ត្រូវកាត់បន្ថយ ពន្ធ ឬ ត្រូវ លើកលែង ពន្ធ ។
ទន្ទឹម គ្នា នេះ កម្ពុជា អាច ពិចារណា ក្នុង ការនាំចូល នូវ មុខ ទំនិញ អទិភាព ដែល មាន គុណភាព ខ្ពស់ និង តម្លៃ ប្រកួតប្រជែង ដើម្បី បំពេញ តម្រូវការ ក្នុង ស្រុក ដូចជា ប្រេង រំអិល ជ័រ កៅស៊ូ ក្រាល ថ្នល់ និង ចំណី សត្វ ៕
មរតក ដ៏ ថ្លៃថ្លា ដែល លោក Kissinger បាន បន្សល់ទុក ឱ្យ អាមេរិក គឺ ថា ទោះបីជា ប្រទេស ទាំង ពីរ ចិន និង អាមេរិក មាន ភាពខុសប្លែក ពី គ្នា ក៏ដោយ ប៉ុន្តែ យុទ្ធសាស្ត្រ ការទូត ដ៏ ឆ្លាតវៃ អាច ពុះពារ ភាពខុសប្លែក ពី គ្នា ទាំងនេះ ព្រមទាំង ធ្វើ ការប្រាស្រ័យទាក់ទង និង កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា ដើម្បី បង្កើត ទំនាក់ទំនង ទ្វេ ភាគី ដោយ ឈរ លើ មូលដ្ឋាន នៃ ការផ្ដល់ ផលប្រយោជន៍ ដល់ គ្នា ។ ការធ្វើ បែប នេះ គឺ សមស្រប នឹង ផលប្រយោជន៍ រួម រវាង ចិន និង អាមេរិក ហើយក៏ ត្រូវបាន ស្វាគមន៍ ដោយ សហគមន៍ អន្តរជាតិ ផងដែរ ។
( ភ្នំពេញ ) ៖ លោក ឌីន បូរី អគ្គ នាយក សេវា សង្គមកិច្ច តំណាង លោក ជា សុមេធី រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី ប្រគល់ វិញ្ញាបនបត្រ ទទួលស្គាល់ កុមារ មណ្ឌល ថែទាំ កុមារ ទាំង ១៦ របស់ អង្គការ សមាគម ជា ដៃគូ ចំនួន ១២ ។
ដើម្បី ធានា បាន ឧត្តម ប្រយោជន៍ និង សិទ្ធិ ជាមូលដ្ឋាន របស់ កុមារ ចំពោះ កុមារ នៅក្នុង មណ្ឌល និង នៅ តាម សហគមន៍ ក្រសួង សង្គមកិច្ច បាន ដាក់ ឲ្យ អនុវត្ត គោល នយោបាយ ស្តីពី ការថែទាំ ជំនួស ចំពោះ កុមារ នៅ ឆ្នាំ ២០០៦ ក្នុង ទិស ដៅ ការពារ សិទ្ធិ របស់ កុមារ និង ធានា ការ អភិវឌ្ឍន៍ ផ្លូវកាយ ផ្លូវចិត្ត បញ្ញា ស្មារតី យូរអង្វែង របស់ កុមារ កំព្រា និង កុមារ ងាយ រងគ្រោះ ផ្សេង ៗ ។
លោក បាន បញ្ជាក់ ថា សារៈសំខាន់ នៃ ការផ្តល់ វិញ្ញាបនបត្រ ទទួលស្គាល់ មណ្ឌល ទាំង ១៦ ក្នុង គោលបំណង គឺ ១. ទប់ស្កាត់ ការបើក មណ្ឌល ដែល គ្មាន គុណភាព និង អាណាធិបតេយ្យ ២. ទប់ស្កាត់ ការរំលោភបំពាន កុមារ ៣. ទប់ស្កាត់ ការប្រើប្រាស់ ពលកម្ម កុមារ ៤. អាច ត្រួតពិនិត្យ បាន នូវ ឥរិយាបថ របស់ អ្នក ថែទាំ កុមារ ៥. គ្រប់គ្រង បាន នូវ ប្រភព ហិរញ្ញវត្ថុ របស់ អង្គការ ។
លោក ស៊ីន ចាន់ សិរី វុត្ថា អនុ រដ្ឋលេខាធិការ នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល បាន ធ្វើជា តំណាង របស់ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ឋលេខាធិការ អាកាសចរ ស៉ី វិល ទទួល ដំណើរទស្សនកិច្ច របស់ លោក ឯក អគ្គ រដ្ឋទូត សហរដ្ឋ អាមេរិក ប្រចាំ នៅ កម្ពុជា ។
សូម ជម្រាប ថា អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ត្រូវបាន សម្ពាធ ដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ កាលពី ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ មាន ទីតាំង ស្ថិត នៅ ភូមិ ក្រៀល ពង ឃុំ ពពេល និង ភូមិ ប្រវ៉ាល ឃុំ តា យ៉ែក ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប ចម្ងាយ ពី ប្រាសាទ អង្គរវត្ត ៤០ គីទ្បូម៉ែត្រ និង ៥១ គីទ្បូម៉ែត្រ ពី ក្រុង សៀមរាប ។
( ភ្នំពេញ ) ៖ នៅ ទីស្នាក់ការ អាជ្ញាធរ មីន លោក បណ្ឌិត លី ធុជ ទេសរដ្ឋមន្ត្រី និង ជា អនុប្រធាន ទី១ អាជ្ញាធរ មីន នៅ ព្រឹក ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន អនុញ្ញាតឲ្យ លោកស្រី CHOI Moon Jung នាយក ទីភ្នាក់ងារ កយកាប្រចាំ កម្ពុជា ដែល ត្រូវបាន តែងតាំង ថ្មី ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ស្តីពី ភាព ជាដៃគូ និង កិច្ចសហប្រតិបត្តិការ សកម្មភាព មីន នៅ កម្ពុជា ។
ក្នុង នាម សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ មីន . លោក បណ្ឌិត លី ធុជ បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ កូរ៉េ តាមរយៈ ទីភ្នាក់ងារ កយកាប្រចាំ កម្ពុជា ដែល បាន ចូលរួម ដល់ សកម្មភាព មីន មនុស្សធម៌ នៅ កម្ពុជា ហើយ ការរួមចំណែក នេះ នឹង បាន ជួយ សង្រ្គោះ ជីវិត មនុស្ស រួចផុត ពី ការគំរាម ដោយសារ មីន លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ នៅ តាម ជនបទ និង រួមចំណែក ដោយ ការកាត់បន្ថយ ភាពក្រីក្រ នៅ កម្ពុជា តាមរយៈ ការប្រើប្រាស់ ដី ប្រកបដោយ សុវត្ថិភាព ។
ទេសរដ្ឋមន្រ្តី លី ធុជ បាន បន្ដ ថា ការរួមចំណែក របស់ សាធារណរដ្ឋ កូរ៉េ គឺជា ការបង្កើត នូវ ក្តីសង្ឃឹម ថ្មី ជូន ដល់ ក្រុមគ្រួសារ ក្រីក្រ នៅក្នុង សហគមន៍ ដែល ទទួលបាន ការគាំទ្រ ផ្នែក មនុស្សធម៌ លើ ការងារ បោសសម្អាត មីន ។ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ អាជ្ញាធរ មីន ពេញចិត្ត នឹង បន្ត សហការ ជាមួយ ទីភ្នាក់ងារ កយកា លើ ការងារ បោសសម្អាត មីន នេះ សម្រាប់ ភាពជោគជ័យ នៃ « គម្រោង បោសសម្អាត មីន ដើម្បី លទ្ធផល ដំណាក់កាល ទី៤ (CFR-IV)- សកម្មភាព មីន សម្រាប់ គម្រោង អភិវឌ្ឍន៍ មនុស្ស » ។
ក្នុង កិច្ចពិភាក្សា លោកស្រី CHOI Moon Jung បាន លើកឡើង អំពី តួនាទី របស់ ទីភ្នាក់ងារ កយកា ក្នុង ការគាំទ្រ ដល់ កិច្ចការ អភិវឌ្ឍ នៅ កម្ពុជា លើ វិស័យ ធ្វើឲ្យ ប្រសើរឡើង នូវ ការថែទាំ សុខភាព ជា សកល និង ការអប់រំ វិទ្យាសាស្ត្រ ដើម្បី លើកកម្ពស់ ទេពកោសល្យ នា ពេល អនាគត និង លើកកម្ពស់ ភាព ចម្រុះ ឧស្សាហកម្ម និង ការអភិវឌ្ឍ ជនបទ ជាដើម ។
លោក បាន ឱ្យ ថា គិត ត្រឹម ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នេះ អ្នកដំណើរ តាម ផ្លូវ អាកាស ដែល ធ្វើដំណើរ នៅ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ជា មធ្យម ចំនួន ៤១០០ នាក់ ក្នុង មួយ ថ្ងៃ ស្រប ពេល ជើងហោះហើរ បាន កើនឡើង ដល់ ៤២ ជើង ក្នុង មួយ ថ្ងៃ ( ទ្វេ ទិស ) ។ ភាគ ច្រើន ហោះហើរ គឺ ពី តំបន់ អាស៊ាន និង ចិន ដោយ មាន ៥៦សញ្ជាតិ ចូលមក កម្ពុជា ។
ជនជាតិ ដែល ធ្វើដំណើរ មក សៀមរាប នៅ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ច្រើន ជាង គេ ឈរ នៅ លំដាប់ លេខ ទី១ គឺ សហរដ្ឋ អាមេរិក បន្ទាប់មក គឺ កូរ៉េ ហើយ តាម ពីក្រោយ ដោយ ឥណ្ឌា ចិន និង បារាំង ។
លោក ស៉ីន ចាន់ សិរី វុត្ថា បាន ឱ្យដឹង ទៀត ថា បច្ចុប្បន្ន មាន ក្រុមហ៊ុន អាកាសចរណ៍ ចំនួន ៩ ធ្វើ ការហោះហើរ ចេញ - ចូល អាកាសយានដ្ឋាន សៀមរាប អង្គរ ក្នុង នោះ មាន ក្រុមហ៊ុន អាកាសចរណ៍ អន្តរជាតិ ចំនួន ៨ និង ក្រុមហ៊ុន អាកាសចរណ៍ ក្នុង ស្រុក ចំនួន ១៕ អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី៖ ការបរិច្ចាគ ទាន ការធ្វើ ការងារ មនុស្សធម៌ និង អំពើ ល្អ នាំឲ្យ សុខភាព ផ្លូវចិត្ត ល្អ និង ជួប រឿង ល្អ (Video inside)
ក្នុង កិច្ចសម្ភាស ជាមួយ ទូរទស្សន៍ Fresh News ស្តីពី « សេចក្តីអំណរ ក្នុង ការបរិច្ចាគ ទាន » ដែល ពាក់ព័ន្ធ នឹង ការងារ មនុស្សធម៌ អ្នក ឧកញ៉ា គួច ម៉េង លី បាន មើលឃើញ ថា សកម្មភាព មនុស្សធម៌ នៅ កម្ពុជា កំពុងតែ មាន សន្ទុះ ខ្លាំង ហើយ អ្នក ឧកញ៉ា មាន សេចក្តីរីករាយ ដែល បាន ឃើញ សកម្មភាព បែប នេះ ខណៈ អ្នក ឧកញ៉ា ក៏ ធ្លាប់ ជា មនុស្ស ជួប ការលំបាក និង យល់ ពី អារម្មណ៍ អ្នក ដែល ខ្វះខាត ៕
សូម ទស្សនា កិច្ចសម្ភាស ទាំងស្រុង ខាងក្រោម នេះ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ប្រកាស សមាសភាព ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ណែនាំ ប្រធាន ក្រុមការងារ ថ្នាក់ រាជធានី - ខេត្ត ឱ្យ ចាត់តាំង បង្កើត ក្រុមការងារ ថ្នាក់ ក្រុង - ស្រុក - ខណ្ឌ ឱ្យ បាន រួចរាល់ មុន ដំណាច់ ឆ្នាំ ២០២៣
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ប្រកាស សមាសភាព ថ្នាក់ដឹកនាំ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ទូទាំង ប្រទេស ដោយ បាន ណែនាំ ប្រធាន ក្រុមការងារ ថ្នាក់ រាជធានី - ខេត្ត ចាត់តាំង បង្កើត ក្រុមការងារ ថ្នាក់ ក្រុង ស្រុក ខណ្ឌ ឱ្យ បាន រួចរាល់ មុន ដំណាច់ ឆ្នាំ ២០២៣ ដើម្បី ចាប់ផ្ដើម ការចុះ ស្វែងយល់ និង ទទួល សំណើ សំណូមពរ របស់ ប្រជាពលរដ្ឋ ហើយ ខិតខំ ដោះស្រាយ ឱ្យ បាន សមស្រប និង ទាន់ ពេល វេលា ។
ការប្រកាស ខាងលើ នេះ បាន ធ្វើឡើង ពេល សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី ដោយ ពិនិត្យ និង ពិភាក្សា លើ របៀបវារៈសំខាន់ ៗ មួយចំនួន នៅ ព្រឹក ថ្ងៃសុក្រ ទី១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ ។
ក្រុមការងារ ត្រូវ សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ដើម្បី ធានា ថា គោល នយោបាយ អាទិភាព ទាំងឡាយ ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ ត្រូវបាន អនុវត្ត ដោយ ជោគជ័យ ដើម្បី បម្រើ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ យ៉ាង ពិតប្រាកដ ៕ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជំរុញ ឱ្យ ផ្តោត អាទិភាព សំខាន់ លើ ធនធាន មនុស្ស និង ឱសថ ដើម្បី លើកកម្ពស់ វិស័យ សុខាភិបាល
( ភ្នំពេញ ) ៖ នៅក្នុង កិច្ចពិភាក្សា លើ របៀបវារៈ របាយការណ៍ វឌ្ឍនភាព នៃ ការរៀបចំ និង ការអនុវត្ត វិធានការ គន្លឹះ ក្នុង វិស័យ សុខាភិបាល នៅក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី នា ព្រឹក ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ជំរុញ ឱ្យ មាន ការផ្តោត អាទិភាព សំខាន់ លើ ធនធាន មនុស្ស និង ឱសថ ដើម្បី លើកកម្ពស់ វិស័យ សុខាភិបាល ឱ្យ មាន ប្រសិទ្ធភាព ។
ក្នុង ចំណោម គោល នយោបាយ អាទិភាព ចំនួន ៦ ដែល សម្តេច ធិបតី ប្រកាស ដាក់ ឱ្យ អនុវត្ត ក្នុង សម័យ ប្រជុំ ដំបូង គណៈ រដ្ឋមន្រ្តី កាលពី ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២៣ អាទិភាព ទី១ គឺ « ពង្រីក សេវា ថែទាំ សុខភាព ឆ្ពោះ ទៅរក ការគ្របដណ្ដប់ សុខភាព ជា សាកល » ។ ជាមួយនឹង អាទិភាព នេះ វិធានការ គន្លឹះ ចំនួន ៣ ត្រូវបាន ដាក់ចេញ ដើម្បី លើកកម្ពស់ គុណភាព សេវា សុខាភិបាល ដោយ ផ្ដោត ជា ចម្បង លើ ការពង្រឹង សមត្ថភាព ផ្ដល់ សេវា សុខភាព បឋម នៅ មូលដ្ឋាន រួម មាន៖
* ទី១៖ ការពង្រឹង សមត្ថភាព ផ្ដល់ សេវា នៅ មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ បង្អែក ដោយ យកចិត្តទុកដាក់ លើ ការពង្រាយ បុគ្គលិក គ្រប់ ចំនួន ដែល មាន ក្រមសីលធម៌ ល្អ និង ទទួល ការបណ្ដុះបណ្ដាល ត្រឹមត្រូវ ការផ្គត់ផ្គង់ ឱសថ សម្ភារ បរិក្ខារ និង ការបំពាក់ ឧបករណ៍ ពេទ្យ ការកែលម្អ ហេដ្ឋារចនាសម្ព័ន្ធ និង ការប្រើប្រាស់ បច្ចេកវិទ្យា ព័ត៌មាន / សុខាភិបាល ឌីជីថល ។
* ទី២៖ ការអភិវឌ្ឍ សមត្ថភាព ស្ថាប័ន សុខាភិបាល ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ក្នុង ការគ្រប់គ្រង ធនធាន មនុស្ស និង ហិរញ្ញវត្ថុ ការងារ និយ័តកម្ម ការឆ្លើយតប នឹង ការគំរាមកំហែង សុខភាព សាធារណៈ និង គ្រោះអាសន្ន សុខភាព និង ការផ្ដល់ សេវា ថែទាំ សុខភាព ឱ្យ កាន់តែ មាន ភាព ឆ្លើយតប ប្រកបដោយ សមធម៌ និង គណនេយ្យភាព ខ្ពស់ ព្រមទាំង ការលើកកម្ពស់ ប្រសិទ្ធភាព នៃ កិច្ច ដំណើរការ មុខងារ ស្ថាប័ន
* ទី៣៖ ការកសាង ភាពជាដៃគូ រឹងមាំ រវាង វិស័យ សុខាភិបាល សាធារណៈ និង ឯកជន ដើម្បី ធានា ឱ្យ ប្រជាជន ទទួលបាន សេវា ថែទាំ សុខភាព មាន គុណភាព សុវត្ថិភាព និង ប្រសិទ្ធភាព ខ្ពស់ ។ ក្រសួង សុខាភិបាល បាន អនុវត្ត វិធានការ គន្លឹះ ទាំង ៣ នេះ ដោយ សម្រេចបាន លទ្ធផល ការងារ យ៉ាង ធំធេង គួរឱ្យ កត់សម្គាល់ ។
ឈរ លើ មូលដ្ឋាន ខាងលើ នេះ ក្រសួង សុខាភិបាល បាន ដាក់ចេញ សកម្មភាព សំខាន់ ៗ ចំនួន ៨ ដើម្បីឱ្យ វិធានការ គន្លឹះ ទាំង៣ បន្ត សម្រេចបាន វឌ្ឍនភាព ថ្មី ៗ បន្ថែម ទៀត ដែល រួម មាន៖
( កំពង់ធំ )៖ លោក សាយ គឹម ឡម អភិបាល ស្រុក ស្ទោង នៅ ព្រឹក ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតី បើក បវេសនកាល ឆ្នាំ ថ្មី ឆ្នាំ ២០២៣ - ២០២៤ នៅ វិទ្យាល័យ ជា ស៊ីម ប្រឡាយ ស្ថិត នៅក្នុង ភូមិ ក្រែក ឃុំ ប្រឡាយ ស្រុក ស្ទោង ខេត្ត កំពង់ធំ ដោយ មាន ការចូលរួម ពី លោកគ្រូ អ្នកគ្រូ មាតាបិតា សិស្ស និង សិស្សានុសិស្ស ជាច្រើន ជាច្រើន នាក់ ។
លោក អភិបាល ស្រុក ស្ទោង បាន បន្ថែម ថា ដើម្បីឱ្យ វិស័យ អប់រំ មាន ការរីកចម្រើន ត្រូវតែ មាន ការចូលរួម ពី គ្រប់ អ្នក ពាក់ព័ន្ធ ដូចជា សិស្សានុសិស្ស ខ្លួន ឯង ផ្ទាល់ លោកគ្រូ អ្នកគ្រូ នាយក សាលា សហគមន៍ ដៃគូ អភិវឌ្ឍ នានា ជាពិសេស អាណាព្យាបាល ដែល នៅជិតស្និទ្ធ ជាមួយនឹង កូន ចៅ ខ្លួន ជាប្រចាំ ត្រូវ បន្ថែម ការគាំទ្រ លើកទឹកចិត្ត និង គាំពារ គ្រប់ បែបយ៉ាង ក៏ ដូចជា ការគាំទ្រ យ៉ាង ពឹង ទំហឹង ពី ក្រសួង អប់រំ យុវជន និង កីឡា និង រាជ រដ្ឋាភិបាល កម្ពុជា យើង ផងដែរ ។
លោក បន្ត ថា សម្រាប់ សាលារៀន ផ្ទាល់ ត្រូវ ពង្រឹង លើ អភិបាលកិច្ច ល្អ ការពិនិត្យ កែសម្រួល រៀបចំ កម្មវិធី សិក្សា ពង្រឹង វិន័យ ចំណេះដឹង សីលធម៌ ឥរិបទ សិស្ស សុខភាព អាហារូបត្ថម្ភ ការលើកទឹកចិត្ត ជំរុញ ការចូលរួម របស់ មាតាបិតា សហគមន៍ ការបង្កើន នូវ គុណ វុឌ្ឍ គ្រូបង្រៀន និង ចំណេះ ជំនាញ បទពិសោធន៍ ថ្មី ៗ ក្នុង ការឆ្លើយតប បរិបទ បច្ចេកវិទ្យា ទំនើប ឌីជីថល ។
លោក ឆាត់ សុភាព បាន បញ្ជាក់ ដូចនេះ នា ព្រឹក ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ នា ឱកាស ដែល អង្គការ វ័ត ធឺ អេត កម្ពុជា ទទួលបាន ថវិកា ពី សប្បុរសធម៌ ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត អេទី កា ចំនួន ៥០ ០០០ ដុល្លារ អាមេរិក សម្រាប់ គាំទ្រ សកម្មភាព លើកកម្ពស់ វិស័យ ទឹក ស្អាត ដែល ថវិកា នេះ នឹង យក ទៅ អនុវត្ត គម្រោង ពន្លឿន លទ្ធភាព ទទួលបាន សេវា ទឹក ស្អាត ប្រើប្រាស់ នៅ តាម គ្រួសារ នៅ ខេត្ត កណ្តាល ដែល រំពឹង ថា នឹង ផ្តល់ ផលប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ ប្រមាណ ២០០០ នាក់ ក្នុង រយៈពេល ៦ខែ ។
លោក ឆាត់ សុភាព បាន បន្ត ទៀត ថា អង្គការ វ័ត ធឺ អេក នឹង ប្រើប្រាស់ ថវិកា សប្បុរសធម៌ ដែល ទទួលបាន នៅ ថ្ងៃ នេះ ឱ្យ មាន ប្រសិទ្ធភាព ដើម្បី រួមចំណែក គាំទ្រ សុខុមាលភាព ប្រជាជន ក្នុង តំបន់ គោលដៅ របស់ គម្រោង ដែល ក្នុង រយៈពេល ៦ខែ ខាងមុខ នេះ ដោយ រំពឹង ថា គម្រោង នឹង ជួយ ផ្ដល់ឲ្យ ប្រជាពលរដ្ឋ ប្រមាណ ២០០០ នាក់ មាន ទឹក ស្អាត ប្រើប្រាស់ តាម តម្រូវការ ។ កង្វះខាត ផ្នែក ណាមួយ នៃ ទឹក ស្អាត និង អនាម័យ នឹង បង្ក ផលវិបាក ចំពោះ ជន ងាយ រងគ្រោះ ដូចជា កុមារ ស្ត្រី ជន ចាស់ជរា និង ជន មាន ពិការភាព ។
លោក ឆាត់ សុភាព បាន បញ្ជាក់ ទៀត ថា គ្រប់ ភាគី ពាក់ព័ន្ធ បាន និង កំពុង ព្យាយាម យ៉ាង សកម្ម ក្នុង ការស្វែងរក ដំណោះស្រាយ ដើម្បី ឆ្លើយតប នឹង តម្រូវការ និង បញ្ហា ប្រឈម ទាំងឡាយ សម្រាប់ ជន ងាយ រងគ្រោះ ហើយ ការធ្វើ ដូចនេះ ទើប យើង នឹង សម្រេចបាន គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព គោលដៅ ទី៦ ស្ដីពី ទឹក ស្អាត និង អនាម័យ នៅ ត្រឹម ឆ្នាំ ២០៣០ ខាងមុខ ។
នាយក ប្រចាំ ប្រទេស នៃ អង្គការ វតធឺ អេត កម្ពុជា លោក ឆាត់ សុភាព មានប្រសាសន៍ បន្ថែម ថា យើង អាច និយាយ បាន ថា គ្មាន ជន ណា ម្នាក់ អាច រស់ នៅក្នុង ជីវិត ដែល មាន សុខភាពល្អ ពេញលេញ បាន ដោយ គ្មាន ទឹក ស្អាត និង គ្មាន បង្គន់ អនាម័ យ សម្រាប់ ប្រើប្រាស់ បាន នោះ ទេ ។ បញ្ហា ទឹក ស្អាត និង អនាម័យ គួរតែ ជា របស់ ចាំបាច់ ជា មូលដ្ឋាន សម្រាប់ ជន គ្រប់ រូប នៅ គ្រប់ ទីកន្លែង តែម្តង ។
អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បង្ហាញ លទ្ធផល កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី (Video inside) ( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសុក្រ ទី១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី ដោយ ពិនិត្យ និង ពិភាក្សា លើ របៀបវារៈសំខាន់ ៗ មួយចំនួន ។
របៀបវារៈ ដែល បាន ពិភាក្សា នោះ រួម មាន៖ ទី ១៖ របាយការណ៍ ស្តីពី វឌ្ឍនភាព នៃ ការអនុវត្ត វិធានការ គន្លឹះ ក្នុង វិស័យ អប់រំ ។ទី ២៖ របាយការណ៍ ស្តីពី វឌ្ឍនភាព នៃ ការរៀបចំ និង ការអនុវត្ត វិធានការ គន្លឹះ ក្នុង វិស័យ សុខាភិបាល ។ ទី ៣៖ សេចក្តីព្រាង គោល នយោបាយ ជាតិ ស្តីពី កម្មសិទ្ធិ បញ្ញា ឆ្នាំ ២០២៤ - ២០២៨ ។ ទី៤៖ បញ្ហា ផ្សេង ៗ ។
ខាងក្រោម នេះ ជា លទ្ធផល កិច្ច ប្រជុំ៖ អភិបាល រង ខេត្ត កំពង់ធំ ផ្តាំផ្ញើ ដល់ សិស្សានុសិស្ស ខិតខំ រៀនសូត្រ ដើម្បី ការរីកចម្រើន នៅក្នុង គ្រួសារ សង្គម និង ប្រទេសជាតិ
( កំពង់ធំ )៖ លោក លី វ៉េត អភិបាល រង ខេត្ត កំពង់ធំ បាន ផ្តាំផ្ញើ ដល់ សិស្សានុសិស្ស សូម ខិតខំ រៀនសូត្រ ដើម្បី ការរីកចម្រើន នៅក្នុង គ្រួសារ សង្គម និង ប្រទេសជាតិ យើង ។
លោក បន្ត ថា ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្ដេច មហា បវរអធិបតី ហ៊ុន ម៉ាណែត ពិតជា ទាមទារ ឱ្យ មាន ការយកចិត្តទុកដាក់ អភិវឌ្ឍ សមត្ថភាព ធនធាន មនុស្ស ដែល ជា កន្សោម អាទិភាព ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ប្រទេសជាតិ ។ ដូច្នេះ ប្អូន ៗ ត្រូវ ខិតខំ ប្រឹងប្រែង អភិវឌ្ឍ សមត្ថភាព របស់ ខ្លួន ជាប្រចាំ ទាំង ខាង ផ្នែក ចំណេះដឹង រួមទាំង ការប្រើប្រាស់ បច្ចេកវិទ្យា ព័ត៌មាន និង ភាសា បរទេស ផងដែរ ។
លោក អភិបាល រង ខេត្ត បន្ត ទៀត ថា សាលារៀន ត្រូវតែ អនុវត្ត តួនាទី ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ជាពិសេស លើ ការបង្រៀន និង ការរៀន ដែល នាំ ទៅ រក ការប្រែប្រួល ជា វិជ្ជមាន នៃ លទ្ធផល សិក្សា របស់ សិស្ស ការពង្រឹង អភិបាលកិច្ច សាលារៀន នឹង ឈាន ទៅ លើកកម្ពស់ គុណភាព អប់រំ ។
ចុងក្រោយ លោក បាន កោតស សើរ ចំពោះ គណៈ គ្រប់គ្រង សាលា គ្រប់ ជាន់ ថ្នាក់ បុគ្គលិក សិក្សា លោកគ្រូ អ្នកគ្រូ និង បុគ្គលិក គាំទ្រ គ្រប់ ផ្នែក ទាំងអស់ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ខិតខំ បំពេញ ការងារ តាម តួនាទី និង ភារកិច្ច របស់ ខ្លួន បាន យ៉ាង ល្អ ។
( កោះកុង) ៖ ក្នុង ពិធី បើក បវេសនកាល ឆ្នាំ ២០២៣ - ២០២៤ នា ថ្ងៃទី១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ លោកស្រី មិថុនា ភូថង អភិបាល កោះ កុង បាន ដាស់តឿន ឱ្យ សិស្សានុសិស្ស ខិតខំ សិក្សា ធ្វើជា សិស្សិ ល្អ កូន ល្អ ពលរដ្ឋ ល្អ ដើម្បី ក្លាយជា ទំពាំង ស្នង ឫស្សី សម្រាប់ ប្រទេសជាតិ នា ពេល អនាគត ។
ពិធី បើក បវេសនកាល នេះ ធ្វើឡើង នៅ វិទ្យាល័យ ហ៊ុន សែន ចំការលើ ស្ថិត នៅ ឃុំ ថ្ម ស ស្រុក បូទុម សាគរ ខេត្ត កោះកុង ដោយ មាន ការចូលរួម ពី លោក ក្រូច បូរី សីហា អភិបាល ស្រុក បូទុម សាគរ លោក ង៉ែត ឡឹង ប្រធាន មន្ទីរ អបរំ យុវជន និង កីឡា ខេត្ត មន្ត្រីរាជការ អាណាព្យាបាល សិស្ស លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស ចំនួន ៣០០ នាក់ ។
លោកស្រី អភិបាល ខេត្ត ក៏ បាន គ្រោន រំលឹក ដល់ សិស្សានុសិស្ស ត្រូវ ខិតខំ យកចិត្ទុក ដាក់ ផ្តោត សំខាន់ ទៅ លើ ការសិក្សា ចេះ បង្កើន ធនធាន មនុស្ស ត្រូវ ខិតខំ ស្វែង ក្នុង ការសិក្សា នៅ លោកគ្រូ អ្នកគ្រូបង្ហាត់ បង្រៀន ពីព្រោះ សិស្សានុសិស្ស គឺជា អនាគត ជា ទំពាំង ស្នង ឫស្សី នៃ ប្រទេសជាតិ ហើយ ចំណេះវិជ្ជា វា អាច ធ្វើឲ្យ ជីវភាព ក្នុង គ្រួសារ មាន ជីវភាព ល្អ ទៅ ថ្ងៃ មុខ ហើយ ត្រូវ ជៀស ឲ្យ ផុត ពី គ្រឿងញៀន ៕
ស្នងការ នគរបាល ខេត្ត កំពត នាំយក ម៉ូតូ និង អំណោយ របស់ អភិសន្តិ បណ្ឌិត ស សុខា ជូន សិស្ស និទ្ទេស A ម្នាក់ នៅ ស្រុក អង្គរ ជ័យ ខេត្ត កំពត ដែល មាន ជីវភាព ខ្សត់ខ្សោយ យ៉ាង ខ្លាំង
អំណោយ នេះ ត្រូវបាន នាំយក ទៅ ប្រគល់ ជូន ដល់ ផ្ទះ គ្រួសារ យុវសិស្ស ម៉ៅ កើន តាមរយៈ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ស្នងការ នគរបាល ខេត្ត កំពត នា ថ្ងៃទី១ ខែធ្នូ ឆ្នាំ ២០២៣ ។
ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ក៏ បាន ថ្លែង នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ និង ចូលរួម អបអរសាទរ ពីសំណាក់ ឧប នាយក រដ្ឋមន្ដ្រី ស សុខា រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ ជូន យុវជន ម៉ៅ កើត ដែល ប្រឡង ជាប់ ហើយ ទទួលបាន និទ្ទេស «A» នៅ ពេល នេះ លើកទឹកចិត្ត ឲ្យ បន្ដ ខិតខំ ប្រឹងប្រែង រៀនសូត្រ បន្ថែម ទៀត ដើម្បី ទទួលបាន ជោគជ័យ នៅ ថ្ងៃ អនាគត ៕ អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស វិលត្រឡប់ ធ្វើ សង្គ្រាម សា ជា ថ្មី ក្រោយ ឱសានវាទ ៧ ថ្ងៃ
សកម្មភាព នៅក្នុង ឱកាស នេះ គឺជា ផ្នែក មួយ នៃ គម្រោង របស់ ស្ថាន ឯក អគ្គ រាជ ទូត ថៃ ដែល សំដៅ បង្កើត ចំណេះដឹង និង ការយល់ដឹង រួមគ្នា ក្នុង ន័យ ស្ថាបនា រវាង ប្រជាជន នៃ ប្រទេស ទាំង ២ អំពី ភាពស្រដៀង គ្នា ក្នុង ផ្នែក វប្បធម៌ ។
ការចែករំលែក របស់ តន្ត្រី ករ - តន្ត្រី ការ នី របស់ វង់ តន្ត្រី កផៃ នៅក្នុង ឱកាស នេះ គឺជា ឧទាហរណ៍ ជាក់ស្ដែង នៅក្នុង ការពង្រឹង ភាពស្រដៀង គ្នា រវាង យ៉ាង ច្នៃប្រឌិត របស់ ប្រទេស ទាំង ២ និង បង្កើត បានជា ប្រយោជន៍ ជូន ដល់ ភាគី ទាំង ២ ជាពិសេស តាមរយៈ ការពង្រឹង ចំណេះដឹង និង ការអភិវឌ្ឍ ធនធាន មនុស្ស ៕
បើក វគ្គ ហ្វឹកហ្វឺន បំប៉ន លំហាត់ របៀប អប់រំ ចិត្តសាស្ត្រ និង ក្បាច់គុន ដល់ តំបន់ ប្រតិបត្តិការ សឹក រង ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោក ម៉ែន ក ល្យាណ អភិបាល រង ខេត្ត ស្វាយរៀង តំណាង លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត និង លោក ឧត្តមសេនីយ៍ ត្រី ថុល សុធី មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត នៅ ព្រឹក ថ្ងៃទី១ ខែធ្នូ ឆ្នាំ ២០២៣ បាន អញ្ជើញ បើក វគ្គ ហ្វឹកហ្វឺន បំប៉ន លំហាត់ របៀប អប់រំ ចិត្តសាស្ត្រ និង ក្បាច់គុន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត ដែល មាន សិក្ខាកាម ចំនួន ៨០ នាក់ មាន រយៈពេល ៩២ ថ្ងៃ ។
លោក បន្ថែម ថា គោលការណ៍ មួយចំនួន ជា កត្តា ចាំបាច់ ដែល ធ្វើឲ្យ ជោគជ័យ គឺ ការបណ្តុះបណ្តាល ធនធាន មនុស្ស នៃ កងយោធពល ខេមរភូមិន្ទ បាន ល្អ និង ជោគជ័យ ត្រូវ មាន សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង គណៈ គ្រប់គ្រង វគ្គ ត្រូវ មាន គោលការណ៍ និង ចក្ខុវិស័យ ច្បាស់លាស់ រីឯ គ្រូ យោធាចារ្យ ត្រូវ មាន និង រៀបចំ ឯកសារ មេរៀន គ្រប់គ្រាន់ និង ល្អ ៗ សម្រាប់ អនុវត្តន៍ នូវ វិន័យ ម៉ឺងម៉ាត់ ទាំង នៅក្នុង ថ្នាក់ ក៏ ដូចជា នៅលើ ទីលាន ។
ជាមួយគ្នា នេះ តំណាង សិក្ខាកាម បាន ប្ដេជ្ញាចិត្ត ខិតខំ រៀនសូត្រ មាន វិន័យ ខ្ពស់ គោរព វិន័យ បទបញ្ជា ផ្ទៃក្នុង វគ្គ មាន សាមគ្គី ផ្ទៃក្នុង ល្អ និង គោរព ពេលវេលា រៀនសូត្រ អោយ បាន ទៀងទាត់ ពេល បញ្ជប់ វគ្គ ទទួលបាន លទ្ធផល ល្អ ។ នៅក្នុង ឱកាស នោះ លោក អភិបាល រង ខេត្ត បាន នាំយក នូវ ថវិកា របស់ លោក ប៉េង ពោធិ៍សា អភិបាល ខេត្ត ចំនួន ២លាន រៀល ឧបត្ថម្ភ ដល់ វគ្គ ហ្វឹកហ្វឺន នេះ ផងដែរ ៕
ប៉ុស្ដិ៍ រដ្ឋបាល ឬស្សីកែវ តំណាង សង្កាត់ - ខណ្ឌ នាំយក សម្ភារ និង បច្ច័យ ចូលរួម រំលែក ទុក្ខ គ្រួសារ អតីត យុទ្ធជន និង ឪពុក ប្រជាការពារ មរណភាព
( ភ្នំពេញ ) ៖ ជាទូទៅ ហើយ សម្រាប់ ប្រជាពលរដ្ឋ ដែល ជា អ្នក រាប់អាន មិន ថា ឆ្ងាយ ឬ រស់ នៅ ជិត ភូមិ ផង របង ជាមួយគ្នា ក្ដី និង ថ្នាក់ដឹកនាំ គ្រប់ ស្រទាប់ វណ្ណ : រវាង មន្ត្រី និង ក្រុមការងារ ក្រោម ឱវាទ តែង យកចិត្តទុកដាក់ ចែករំលែក នូវ ផល ទាន ក្នុង ការ ជួយ យកអាសារ ទៅ វិញ ទៅមក ទាំង កាល នៅរស់រាន និង លាចាក លោក ទៅ ដោយ មិន បោះបង់ គ្នា ចោល ឡើយ ស្ទើរតែ គ្រប់ កម្មវិធី បុណ្យ ពិសេស ពិធី បុណ្យ សព្វ តាំងពី ថ្ងៃ ដំបូង និង ៧ ថ្ងៃ រហូត បង្គ្រប់ បញ្ចប់ កិច្ច បុណ្យ ១០០ ថ្ងៃ ។
បន្ថែម ពី នេះ និង នៅ ថ្ងៃ ដដែល ក្នុង នាម តំណាង ឲ្យ ថ្នាក់ដឹកនាំ សង្កាត់ - ខណ្ឌ នេះ ដែរ បន្ទាប់ពី លោក វរសេនីយ៍ ត្រី តូច គឹម សុង ជាមួយ ក្រុមការងារ ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ សព្វ លោក ឈៀង ហួន ( ឪពុក របស់ ប្រជាការពារ សង្កាត់ ) រួចហើយក៏ ឆ្លៀត នាំយក សម្ភារ និង បច្ច័យ មួយចំនួន ទៀត មក ចូលរួម រំលែក មរណទុក្ខ ចំពោះ ក្រុមគ្រួសារ សព្វ លោក ឌិន តុង ម្នាក់ ទៀត ដែល ជា អតីត យុទ្ធជន និង បាន ទទួលមរណភាព ដោយ រោគារ ពាធ ។
ជាមួយគ្នា នេះ ក្រុមគ្រួសារ សព្វ អតីត យុទ្ធជន និង ក្រុមគ្រួសារ សព្វ ឪពុក ប្រជាការពារ សង្កាត់ បាន ថ្លែងអំណរ អរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ថ្នាក់ដឹកនាំ ខណ្ឌ - សង្កាត់ - ប៉ុស្ដិ៍ ហើយ នឹង សូម បួងសួង ដល់ វត្ថុ សក្តិសិទ្ធិ ក្នុង លោក ជួយ ឃុំ គ្រង ថែរក្សា ឲ្យ មាន សុខភាព ល្អ បរិបូរណ៍ ប្រាជ្ញា វាង វ៉ៃ និង ជោគជ័យ ជានិច្ច លើ ភារកិច្ច បម្រើ ប្រជាពលរដ្ឋ ពិសេស ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លៀត ឡើយ តាម រយ : ក្រុមការងារ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ត្រី នាយ ប៉ុស្ដិ៍ តូច គឹម សុង ៕
អភិបាល ខេត្ត ព្រះសីហនុ ចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ១៤០ បណ្ណ ជូន ប្រជាពលរដ្ឋ នៅ ឃុំ កំពង់សីលា ស្រុក កំពង់សីលា
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន លើកឡើង ថា គោល នយោបាយ ដីធ្លី របស់ រាជ រដ្ឋាភិបាល គឺ ដើម្បី លើកស្ទួយ ដល់ ការអភិវឌ្ឍ របស់ ប្រទេសជាតិ ការពារ ផលប្រយោជន៍ ជូន ប្រជាពលរដ្ឋ ជា ម្ចាស់ ក្បាល ដី និង រាជ រដ្ឋាភិបាល ។ រដ្ឋ គ្រប់គ្រង ដីធ្លី ទាំង ដី រដ្ឋ និង ដី ឯកជន ដែល ធ្វើឱ្យ រដ្ឋ មាន ការងាយស្រួល ក្នុង ការរៀបចំ ដែនដី រដ្ឋបាល ដីធ្លី ការបែងចែក ដី និង កាត់បន្ថយ ទំនាស់ ដីធ្លី ធានា សុវត្ថិភាព នៃ ការកាន់កាប់ ដីធ្លី របស់ ប្រជាពលរដ្ឋ បម្រើ ដល់ ជីវភាព គ្រួសារ និង ការវិនិយោគ ។
ការលើកឡើង នេះ នា ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្នុង កម្ម ពិធី ចែក វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ( បណ្ណ កម្មសិទ្ធិ ) ភូមិ ចាំ ស្រី ( ៨៧ បណ្ណ ) និង ភូមិ ក្រាំង អាត់ ( ៥៣ បណ្ណ ) ឃុំ កំពង់សីលា ស្រុក កំពង់សីលា ខេត្ត ព្រះសីហនុ ជូន ប្រជាពលរដ្ឋ ចំនួន ១១២ គ្រួសារ ដោយ មាន ការចូលរួម ពី លោកស្រី ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព ពាក់ព័ន្ធ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ចូលរួម យ៉ាង ច្រើន កុះករ ។
លោក គួច ចំរើន បាន ជួប សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម នា ថ្ងៃ នេះ ព្រមទាំង បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត ព្រះសីហនុ ដែល បាន ខិតខំ ប្រឹងប្រែង ក្នុង ការចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ ភូមិ ចាំ ស្រី និង ភូមិ ក្រាំង អាត់ ឃុំ កំពង់សីលា ស្រុក កំពង សីលា ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក បាន អំពាវនាវ ប្រជាពលរដ្ឋ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា គ្រោះថ្នាក់ ចរាចរណ៍ បាន សម្លាប់ មនុស្ស ២នាក់ គឺ ម៉ូតូ និង ម៉ូតូ ដែល បាន បាត់បង់ កម្លាំង ពលកម្ម ដូច្នេះ យើង ត្រូវតែ យកចិត្តទុកដាក់ ទាំងអស់ គ្នា យើង ត្រូវតែ គោរព ច្បាប់ ចរាចរណ៍ ត្រូវ ប្រើប្រាស់ ផ្លូវថ្នល់ ដោយ ការប្រុងប្រយ័ត្ន ចៀសវាង មាន គ្រោះ ព្រោះថា អាយុជីវិត មិន ទិញ មកវិញ បាន ទេ ៕ " width="730
លោក គួច ម៉េង លី ឧបត្ថម្ភ ៤លាន រៀល ដល់ សហគមន៍ ចា ប៉ី អមតៈ និង ប្រកាស ផ្ដល់ អាហារូបករណ៍ ដល់ សិស្ស ដែល ចង់ រៀន ជំនាញ អក្សរសាស្ត្រ ខ្មែរ ប្រវត្តិសាស្ត្រ ខ្មែរ និង សិល្បៈ
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី ប្រធាន មូលនិធិ ម៉េង លី ជេ. គួច បាន ឧបត្ថម្ភ ថវិកា ចំនួន ៤លាន រៀល ដល់ សហគមន៍ ចា ប៉ី អមតៈ និង បាន ប្រកាស ផ្ដល់ អាហារូបករណ៍ ដល់ សិស្ស ដែល ចង់ រៀន ជំនាញ អក្សរសាស្ត្រ ខ្មែរ ប្រវត្តិសាស្ត្រ ខ្មែរ និង សិល្បៈ ទៀតផង ។
ការឧបត្ថម្ភ និង ការប្រកាស របស់ លោក បាន ធ្វើឡើង ពេល សហគមន៍ ចា ប៉ី អមតៈ ដឹកនាំ សិល្បករ ចា ប៉ី ដង វែង ចំនួន ២៣នាក់ មក ពី គ្រប់ ខេត្ត ក្រុង រៀបចំ កម្មវិធី « តន្រ្តី ចាប៉ី ភូមិ ខ្ញុំ » នៅ សាលា មធ្យម វិចិត្រ សិល្បៈ ដើម្បី អបអរសាទរ ខួប៧ ឆ្នាំ នៃ ការដាក់បញ្ចូល ចា ប៉ី ដង វែង ក្នុង បញ្ជី បេតិកភណ្ឌ វប្បធម៌ អរូបី មនុស្សជាតិ របស់ អង្គការ យូណេស្កូ នៅ ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ។
អ្នក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី បាន សម្តែង ចំណាប់អារម្មណ៍ ថា៖ « ខ្ញុំ សូម កោតសរសើរ និង គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ការរៀបចំ កម្មវិធី នេះ ឡើង បើ ទោះបី ខ្ញុំ ពុំ សូវ មាន ជំនាញ ចំណេះ ខាង សិល្បៈ មួយ នេះ ក៏ ពិត មែន ប៉ុន្តែ ខ្ញុំ នឹង ប្រកាន់ ជំហ គាំទ្រ ចូលរួម ថែរក្សា លើកស្ទួយ គ្រប់ សកម្មភាព សីលធម៌ សិល្បៈ វប្បធម៌ ប្រពៃណី របស់ ខ្មែរ » ។
បទ វិភាគ៖ គួរតែ ធ្វើជា អ្នកចូលរួម និង ស្ថាបនិក នៃ កិច្ចសហប្រតិបតិ្តការ ផ្នែក ខ្សែ សង្វាក់ ឧស្សាហកម្ម និង ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ សកល មិន មែន ធ្វើជា អ្នក បំផ្លាញ និង អ្នកបង្ក រឿង ហេតុ ឡើយ
( ប៉េកាំង ) ៖ ថ្ងៃទី ២៨ ខែវិច្ឆិកា ពិព័រណ៍ ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ ចិន អន្តរជាតិ បាន សម្ពោធ បើក នៅ ក្រុង ប៉េកាំង ចំណុច លេចធ្លោ មួយ នៃ ពិព័រណ៍ នេះ គឺ បាន ទាក់ទាញ សហគ្រាស អាមេរិក និង អឺរ៉ុប ជាច្រើន ។ សហគ្រាស អាមេរិក និង អឺរ៉ុប ដែល បាន ចូលរួម ពិព័រណ៍ លើក នេះ មាន ចំនួន លើស ពី ការប៉ាន់ប្រមាណ យ៉ាង ច្រើន ចំនួន ពាណិជ្ជករ បរទេស ដែល ចូលរួម ពិព័រណ៍ លើក នេះ ត្រូវ ជា១ ភាគ ៣នៃ ចំនួន ពាណិជ្ជករ សរុប ។
ក្នុង ពិព័រណ៍ ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ ចិន អន្តរជាតិ លើក នេះ ប្រសាសន៍ របស់ លោក Joko Widodo ប្រធានាធិបតី ឥណ្ឌូណេស៊ី បាន ក្រើន រំលឹក ដល់ អ្នកផង ទាំងពួង ថា យើង គួរតែ ធ្វើជា អ្នកចូលរួម និង ស្ថាបនិក នៃ កិច្ចសហប្រតិបតិ្តការ ផ្នែក ខ្សែ សង្វាក់ ឧស្សាហកម្ម និង ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ សកល មិន មែន ធ្វើជា អ្នក បំផ្លាញ និង អ្នកបង្ក រឿង ហេតុ ឡើយ ។ ការពិត ជាក់ស្តែង បាន បញ្ជាក់ ថា “ ប្រទេស ចិន ”បន្ទាប់ ទៀត នៅតែ ជា ប្រទេស ចិន នេះ ជា មូលហេតុ ពី ឬ សគល់ ដែល សហគ្រាស អាមេរិក និង អឺរ៉ុប “ បោះឆ្នោត ដោយ ប្រើ ជើង ” ៕
អត្ថបទ និង រូបភាព ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន សម្តេច ធិបតី ហ៊ុន ម៉ាណែត៖ មហិច្ឆតា ក្លាយជា ប្រទេស ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ នឹង មិន ជោគជ័យ បើ គ្មាន មូលធន មនុស្ស ដែល មាន សុខភាព រឹងមាំ មាន ចំណេះដឹង និង ចរិត ល្អ ប្រសើរ
( ភ្នំពេញ ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន លើកឡើង ថា មហិច្ឆតា ប្រែក្លាយ កម្ពុជា ទៅជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ មិន អាច ទទួលបាន ជោគជ័យ នោះ ឡើយ ប្រសិនបើ គ្មាន មូលធន មនុស្ស ដែល មាន សុខភាព រឹងមាំ មាន ចំណេះដឹង និង ចរិត ល្អ ប្រសើរ ទេ នោះ ។
ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី នា ព្រឹក ថ្ងៃសុក្រ ទី១ ខែធ្នូ ឆ្នាំ ២០២៣ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ក្នុង ដំណើរ ដ៏ វែងឆ្ងាយ លើ ការប្រែក្លាយ កម្ពុជា ពី ប្រទេស វិនាស ហិនហោច ដោយសារ សង្គ្រាម ទៅជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ មនុស្ស គឺជា សមាសធាតុ សង្គម និង សេដ្ឋកិច្ច ដ៏ សំខាន់ បំផុត ដែល មិន អាច ខ្វះ បាន ។ ក្នុង នោះ មូលធន មនុស្ស ដែល មាន គុណភាព ខ្ពស់ និង សុខភាព ល្អ គឺជា ទ្រព្យ សកម្ម របស់ ជាតិ និង រឹងមាំ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា « បើ គ្មាន មូលធន មនុស្ស ដែល មាន សុខភាព រឹងមាំ មាន ចំណេះដឹង និង មាន ចរិត ល្អ ប្រសើរ នោះ ទេ មហិច្ឆតា បាន ត្រឹមតែ ជា ក្តីស្រមៃ ហើយ មិន អាច ក្លាយទៅជា ការពិត នោះ ឡើយ » ។
វិធានការ គន្លឹះ ក្នុង វិស័យ អប់រំ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា និង សុខាភិបាល កំពុង ត្រូវបាន អនុវត្តន៍ យ៉ាង យកចិត្តទុកដាក់ ខ្ពស់ បំផុត ដោយ ក្រសួង អប់រំ យុវជន និង កីឡា ក៏ ដូចជា ក្រសួង សុខាភិបាល ។ ដើម្បី ធានា ប្រសិទ្ធភាព ក្នុង ការអនុវត្តន៍ វិធានការ គន្លឹះ លើ វិស័យ ទាំង ពីរ នេះ រាជ រដ្ឋាភិបាល បាន បង្កើត គណៈកម្មាធិការ ជាតិ ជំរុញ ការអនុវត្ត វិធានការ គន្លឹះ ទាំង ពីរ នេះ ដែល មាន សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ជា ប្រធាន ផ្ទាល់ តែម្តង ។
ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី នា ព្រឹក មិញ នេះ វឌ្ឍនភាព ជាច្រើន លើ ការអនុវត្តន៍ វិធានការ គន្លឹះ ទាំង ពីរ នេះ ត្រូវបាន លើក បង្ហាញ ដោយ លោក ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា និង លោក ឈាង រ៉ា រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ៕
រដ្ឋសភា កម្ពុជា - វៀតណាម ឯកភាព រួមគ្នា នៅក្នុង ការពូន ជ្រុំ និង ផ្សព្វផ្សាយ វប្បធម៌ នៃ ទំនាក់ទំនង ដ៏ ល្អ ដល់ យុវជន ជំនាន់ ក្រោយ បាន ដឹង និង បន្ត ថែរក្សា ឱ្យ បាន គង់វង្ស
ជំនួប ពិភាក្សា ការងារ ទ្វេ ភាគី រវាង រដ្ឋសភា ទាំង ពីរ បាន ធ្វើឡើង បន្ទាប់ពី គណៈប្រតិភូ ជាន់ ខ្ពស់ រដ្ឋសភា ដឹកនាំ ដោយ សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី បាន អញ្ជើញ ដាក់ កម្រង ផ្កា នៅ វិមាន វិរៈ បុរស យុទ្ធជន ពលី Bac Son និង គោរព វិញ្ញា ក្ខន្ធ លោក ហូជីមិញ នៅក្នុង ដំណើរទស្សនកិច្ច ផ្លូវការ លើក ដំបូង នៅកាន់ ប្រទស វៀតណាម ។
ភាគី ទាំង ពីរ បាន ឯកភាព រួមគ្នា នៅក្នុង ការពូន ជ្រុំ និង ផ្សព្វផ្សាយ វប្បធម៌ នៃ ទំនាក់ទំនង ដ៏ ល្អ និង កម្រ នេះ ដល់ យុវជន ជំនាន់ ក្រោយ បាន ដឹង និង បន្ត ថែរក្សា ឱ្យ បាន គង់វង្ស ត រៀង ទៅ ។ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិ រវាង ប្រទេស ជិតខាង នេះ មិន ត្រឹមតែ បាន ផ្តល់ នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ដល់ ប្រទេស ទំាង ពីរ ប៉ុណ្ណោះ ទេ តែ បាន ចូលរួមចំណែក កសាង នូវ សន្តិភាព និង វិបុលភាព ដល់ តំបន់ និង ពិភពលោក ទំាង មូល ថែម ទៀត ។
សម្តេច រដ្ឋសភា ធិបតី ក៏ បាន សម្តែង ការពេញចិត្ត ជា ខ្លំាង នៃ ការរីកចម្រើន លើ កិច្ចសហប្រតិបត្តិការ គ្រប់ វិស័យ របស់ រដ្ឋាភិបាល ប្រទេស ទំាង ពីរ ជាពិសេស កំណើន ពាណិជ្ជកម្ម រវាង កម្ពុជា និង វៀតណាម ដែល សម្រេច ដល់ ១០ពាន់ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ជា ចំនុច វិជ្ជមាន មួយ បាន បម្រើ ផលប្រយោជន៍ ដល់ ប្រជាជន នៃ ប្រទេស ទំាង ពីរ ។ រដ្ឋសភា កម្ពុជា គំាទ្រ នូវ ការដាក់ចេញ គោល នយោបាយ ទេសចរណ៍ របស់ ប្រទេស កម្ពុជា វៀតណាម និង ឡាវ គឺ កញ្ចប់ ទេសចរណ៍ មួយ គោលដៅ បី ។
ទេសរដ្ឋមន្ដ្រី អូស្មាន ហាស្សាន់ ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ចូលរួម សន្និបាត ហាឡាល ថៃ លើក ទី១០
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ លោក បណ្ឌិត អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា អនុប្រធាន គណៈកម្មាធិការ ត្រួតពិនិត្យ ផលិតផល ហាឡាល កម្ពុជា បាន ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ចំនួន ១៣រូប ទៅ ចូលរួម សន្និបាត ហាឡាល ថៃ លើក ទី១០ ឆ្នាំ ២០២៣ នៅ ទីក្រុង បាងកក ប្រទេស ថៃ ។
សន្និសីទ នេះ ធ្វើឡើង រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១ - ៣ ខែធ្នូ ឆ្នាំ ២០២៣ ដែល មាន សារៈសំខាន់ ក្នុង ការជួយ ពង្រឹង វិស័យ ផលិផល ហាឡាល កម្ពុជា ដែល ជា រៀងរាល់ ឆ្នាំ ចាប់តាំងពី ឆ្នាំ ២០១៤មក ស្ថាប័ន ហាឡាល ថៃ ចំនួន ៣ បាន រួមគ្នា រៀបចំ សន្និបាត ហាឡាល ថៃ ដើម្បី អញ្ជើញ ស្ថាប័ន ហាឡាល នៅ បណ្តា ប្រទេស តំបន់ អាស៊ាន និង ពិភពលោក មក ចែករំលែក បទពិសោធន៍ និង ភាពរីកចម្រើន របស់ ខ្លួន ។
សិន្ន បាត ហាឡាល ថៃ ឆ្នាំ នេះ ក្រោម ប្រធានបទ គំនិត ផ្តួចផ្តើម នៃ ឌីជីថល ហាឡាល ដើម្បី ជំរុញ ទំនុកចិត្ត ហាឡាល និង មាន គោលបំណង ធានា ថា គុណភាព នៃ ផលិតផល ហាឡាល ដែល ប្រើប្រាស់ បច្ចេកវិទ្យា ឌីជីថល និង កសាង ទំនុកចិត្ត ក្នុង ប្រព័ន្ធ អេកូហាឡាល ដែល ធ្វើឲ្យ អតិថិជន មាន ភាពងាយស្រួល ក្នុង ការប្រកប អាជីវកម្ម ប្រកបដោយ តម្លាភាព ។
( ប៉េកាំង ) ៖ ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ នៅ ទីក្រុង ហៀង ហៃ លោក Xi Jinping អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនីស្ត ចិន ប្រធាន រដ្ឋ ចិន និង ជា ប្រធាន គណៈកម្មាធិការ យោធា មជ្ឈិម ចិន បាន ធ្វើជា អធិបតី ក្នុង កិច្ចប្រជុំ សំណេះសំណាល អំពី ការជំរុញ ការអភិវឌ្ឍ រួម នៅ តំបន់ ដី សន្ត ទន្លេ យ៉ង សេ ឱ្យ កាន់តែ ស៊ីជម្រៅ ។
ការស្ទង់ ប្រជាមតិ អន្តរជាតិ៖ អ្នក ផ្តល់ បទសម្ភាសន៍ ចំនួន ៩១. ៤% នៅលើ ពិភពលោក សរសើរ ពី ការរួម វិភាគទាន របស់ ប្រទេស ចិន ក្នុង ការប្រែប្រួល នៃ អាកាសធាតុ
របាយការណ៍ វឌ្ឍនភាព នៃ ការអនុវត្ត វិធានការ គន្លឹះ ក្នុង វិស័យ អប់រំ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា ក្នុង កិច្ចប្រជុំ ដំបូង គណៈ រដ្ឋមន្រ្តី នីតិកាល ទី៧ នៃ រដ្ឋសភា កាលពី ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២៣ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ដាក់ចេញ វិធានការ គន្លឹះ ចំនួន ៤ ដើម្បី ពង្រឹង គុណភាព គ្រឹះស្ថាន សិក្សា រដ្ឋ ចាប់ពី មត្តេយ្យ សិក្សា ដល់ មធ្យមសិក្សា ។
វិធានការ គន្លឹះ នោះ រួម មាន៖ ទី ១៖ ការពង្រឹង អភិបាលកិច្ច សាលារៀន . ទី ២៖ ការពិនិត្យ កែសម្រួល និង រៀបចំ កម្មវិធី សិក្សា និង សកម្មភាព ក្រៅ ម៉ោង សិក្សា ដើម្បី ពង្រឹង ចំណេះដឹង វិន័យ សីលធម៌ និង ឥរិយាបថ របស់ សិស្ស . ទី ៣៖ ការយកចិត្តទុកដាក់ លើ សុខភាព របស់ សិស្ស និង ទី៤៖ ភាពជាដៃគូរដ្ឋ និង សហគមន៍ ដើម្បី លើកកម្ពស់ ការអប់រំ ។
ក្រសួង អប់រំ យុវជន និង កីឡា ក៏ ពិនិត្យ ឡើងវិញ លើ ស្តង់ដា សាលារៀន ដែល ដាក់ចេញ កន្លងមក ដោយ បាន បញ្ជ្រាប វិធានការ គន្លឹះ ទាំង៤ ទៅក្នុង « ស្តង់ដា សាលារៀន គំរូ » ចំនួន ៥ សម្រាប់ មត្តេយ្យ សិក្សា ដល់ មធ្យមសិក្សា ដែល ផ្ដោត លើ លទ្ធផល សិក្សា របស់ សិស្ស ការបង្រៀន និង រៀន ការចូលរួម របស់ សហគមន៍ ដំណើរការ ប្រតិបត្តិការ និង រដ្ឋបាល សាលារៀន និង គណនេយ្យភាព របស់ សាលារៀន ។
រាជ រដ្ឋាភិបាល បាន បង្កើត គណៈកម្មាធិការ ជាតិ ជំរុញ ការអនុវត្ត វិធានការ គន្លឹះ ដោយ មាន នាយក រដ្ឋមន្ត្រី ជា ប្រធាន អម ដោយ សមាភាព ឧប នាយក រដ្ឋមន្ត្រី ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ចំនួន ១៦រូប និង អភិបាល នៃ គណៈអភិបាល រាជធានី ខេត្ត ជា សមាជិក ផងដែរ ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ឯកភាព ជា គោលការណ៍ ក្នុង ការអនុវត្ត « ស្តង់ដា សាលារៀន គំរូ » និង « ពានរង្វាន់ សាលា គំរូ សម្តេច មហា បវរធិបតី » ព្រមទាំង « យុទ្ធនាការ សាលារៀន ស្អាត គ្មាន សំរាម » នៅ ទូទាំង ប្រទេស ចាប់ពី ឆ្នាំ សិក្សា ២០២៣ - ២០២៤ ក្នុង នោះ ស្តង់ដា សាលារៀន គំរូ នឹង ចាប់ ផ្ដើម អនុវត្ត និង ពង្រឹង ចាប់ពី ឆ្នាំ សិក្សា ថ្មី នេះ តទៅ ។
អ្វី ទៅជា សាលារៀន គំរូ ? សាលារៀន គំរូ គឺ សាលារៀន ដែល មាន ដំណើរការ ពេញលេញ រួម មាន៖
ទី១៖ សាលារៀន មាន គណនេយ្យភាព ជាមួយ សហគមន៍ និង ធ្វើ ការកែលម្អ សាលារៀន ស្រប តាម ស្ដង់ដា សាលារៀន គំរូ ដោយ មាន ការចូលរួម ពី គ្រប់ អ្នក ពាក់ព័ន្ធ ជាពិសេស មាតាបិតា ឬ អាណាព្យាបាល តាមរយៈ ការបង្កើត និង ដំណើរការ គណៈកម្មការគ្រប់គ្រង សាលារៀន និង គណៈកម្មការគ្រប់គ្រង ថ្នាក់រៀន ។
ទី២៖ សាលារៀន មាន ស្វ័យភាព ក្នុង ការងារ ផែនការកែលម្អ សាលារៀន និង ថ្នាក់រៀន ព្រមទាំង ការផ្ដល់ ការអភិវឌ្ឍ វិជ្ជាជីវៈ ជា ប្រចាំ ដល់ គណៈ គ្រប់គ្រង សាលារៀន និង គ្រូបង្រៀន ។
ទី៣៖ សាលារៀន អនុវត្ត តេស្ត ស្តង់ដា ជាប្រចាំ និង ប្រើប្រាស់ លទ្ធផល នៃ តេស្ត ស្តង់ដា ដើម្បី ធ្វើ ការកែលម្អ ការបង្រៀន និង រៀន ការជួយ សិស្ស រៀន យឺត និង ផ្ដល់ ព័ត៌មាន ដល់ មាតាបិតា ឬ អាណាព្យាបាល និង សហគមន៍ ឱ្យ ចូលរួម គាំទ្រ បន្ថែម ។
ទី៤៖ សាលារៀន មាន ស្វ័យភាព ក្នុង ការអនុវត្ត កម្មវិធី សិក្សា និង ការរៀបចំ កម្មវិធី ក្រៅ ម៉ោង សិក្សា ដោយ ផ្ដោត លើ កម្មវិធី អភិវឌ្ឍន៍ យុវជន កម្មវិធី អប់រំ ច្បាប់ ចរាចរណ៍ ការងារ ស្ម័គ្រចិត្ត ការងារ សហគមន៍ និង ការអប់រំ សីលធម៌ ។
ទី៥៖ សាលារៀន យកចិត្តទុកដាក់ លើ ការអប់រំ សុខភាព អនាម័យ បរិស្ថាន ស្អាត សាលារៀន គ្មាន សំរាម និង គិតគូរ ដល់ អាហារូបត្ថម្ភ ដល់ សិស្សានុសិស្ស និង ទី៦ - ការជំរុញ ការចូលរួម របស់ មាតាបិតា ឬ អាណាព្យាបាល និង សហគមន៍ ក្នុង ការគាំទ្រ និង ការអភិវឌ្ឍ សាលារៀន ។ នៅក្នុង អំឡុង ឆ្នាំ សិក្សា ថ្មី ២០២៣ - ២០២៤ នេះ ក្រសួង នឹង ជ្រើសរើស សាលារៀន សំណាក ដែល មាន សក្ដានុពល ចំនួន ៥០០ សាលា ដើម្បី ទទួល ការជួយគាំទ្រ និង ធ្វើ ការវាយតម្លៃ ដោយ រំពឹង ថា សម្រេចបាន តាម ស្តង់ដា សាលារៀន គំរូ ក្នុង រយៈពេល ២ឆ្នាំ ។
ក្រសួង អប់រំ យុវជន និង កីឡា បាន ប្តេជ្ញាចិត្ត អនុវត្ត គំនិត ផ្តួចផ្តើម របស់ សម្តេច ធិបតី ឱ្យ បាន ជោគជ័យ ប្រកបដោយ ផ្លែផ្កា ក្នុង រយៈពេល ២ឆ្នាំ ខាងមុខ ដោយ ត្រូវ ប្រែក្លាយ គ្រឹះស្ថាន យ៉ាងហោចណាស់ ចំនួន ៥០០ ទៅ ១.០០០ ក្លាយទៅជា សាលារៀន គំរូ ដោយ ចាប់ផ្តើម រៀបចំ សាលារៀន គំរូ សម្រាប់ ប្រកាស ក្នុង សន្និបាត អប់រំ ដែល គ្រោង ប្រារព្ធ ឡើង នា ខែមេសា ឆ្នាំ ២០២៤ ខាងមុខ ឱ្យ បាន ពី ៥០ ទៅ ១០០ សាលា ។
ក្នុង ដំណើរ ការពិភាក្សា និង ឆ្លង លើ របាយការណ៍ វឌ្ឍនភាព នៃ ការអនុវត្ត វិធានការ គន្លឹះ ក្នុង វិស័យ អប់រំ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ប្រសាសន៍ ថា ការបង្កើត គណៈកម្មាធិការ ជាតិ ដែល ដឹកនាំ ដោយ នាយក រដ្ឋមន្ត្រី គឺ ដើម្បី ប្រមូលផ្តុំ កម្លាំង បន្ថែម ក្នុង ការធ្វើ សកម្មភាព ឱ្យ ចំ គោលដៅ ។
សម្តេច ធិបតី បាន ណែនាំ ក្រសួង អប់រំ យុវជន និង កីឡា កំណត់ អាទិភាព និង សកម្មភាព ជាក់ស្តែង ឱ្យ បាន ច្បាស់លាស់ ដោយ ផ្តោត សំខាន់ លើ ធនធាន មនុស្ស កម្មវិធី សម្ភារ ដែល ត្រូវ បំពាក់ ផែនការ សកម្មភាព និង ពេលវេលា ដែល ត្រូវ អនុវត្ត ៕ កម្ពុជា - កូរ៉េ បិទ បញ្ចប់ ជំហាន ទី១ នៃ គម្រោង កសាង ផែនការ មេ សម្រាប់ សញ្ញា ជំនួយ នាវាចរណ៍ នៅ កម្ពុជា
នា ឱកាស នោះ លោក រស់ វណ្ណា បាន ឱ្យដឹង ដែរ ថា ផែនការ មេ សម្រាប់ សញ្ញា ជំនួយ នាវាចរណ៍ នៅ កម្ពុជា បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការធានា សុវត្ថិភាព និង សន្តិសុខ សម្រាប់ ប្រតិបត្តិការ នាវា ចរ និង អ្នកដំណើរ នៅ តាម ដងទន្លេ មេគង្គ និង តំបន់ ឆ្នេរ នៅ កម្ពុជា ។ ជំនួយ សម្រាប់ ប្រព័ន្ធ នាវាចរណ៍ បាន និង កំពុង ជួយ ដល់ កម្ពុជា ក្នុង ការបង្កើន សក្តានុពល ពាណិជ្ជកម្ម របស់ ខ្លួន ខណៈ ទន្លេ នឹង ក្លាយជា កន្លែង ដឹកជញ្ជូន តាម ផ្លូវ ទឹក ដ៏ សំខាន់ និង សេដ្ឋកិច្ច សម្រាប់ ការដឹកជញ្ជូន តាម ផ្លូវ ទឹក ។
លោក រស់ វណ្ណា ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ ក្រុម អ្នកជំនាញ កូរ៉េ សម្រាប់ ការខិតខំ ធ្វើ ការសម្របសម្រួល និង ការគាំទ្រ ដោយ រលូន ហើយ បើ គ្មាន កិច្ចសហប្រតិបត្តិការ ល្អ នៃ ក្រុមការងារ ទាំង ពីរ ទេ នឹង មិន អាច សម្រេចបាន ជោគជ័យ នេះ ឡើយ ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ កូរ៉េ ខាងត្បូង ជួប ពិភាក្សា ការងារ ជាមួយ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី ផ្តោត សំខាន់ លើ វគ្គ ហ្វឹកហ្វឺន គម្រោង ត្រី ភាគី កម្ពុជា - អសប - កូរ៉េ
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ ការមកដល់ របស់ លោក Woo KyoungSuk និង បាន នាំយក ពាក្យពេចន៍ សួរសុខទុក្ខ របស់ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ ជូន គណៈប្រតិភូ នៃ សាធារណរដ្ឋ កូរ៉េ ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន បន្ត ថា វគ្គ ហ្វឹកហ្វឺន ត្រី ភាគី កម្ពុជា - អសប - កូរ៉េ បាន ដំណើរការ៦សប្តាហ៍ ដោយ ជោគជ័យ ដោយ នឹង បិទ បញ្ចប់ ក្រោម វត្តមាន ដ៏ ខ្ពង់ខ្ពស់ ឧប នាយក រដ្ឋមន្រ្តី ទៀ សីហា រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ ។
ឧត្តមសេនីយ៍ ត្រី Woo KyoungSuk បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រៀល ជ្រៅ ចំពោះ កម្ពុជា ដែល បាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ វត្តមាន មកដល់ របស់ លោក ។ ទន្ទឹម នោះ លោក ក៏ បាន អរគុណ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ កម្ពុជា លើ វគ្គ ហ្វឹកហ្វឺន ត្រី ភាគី TPP ប្រកបដោយ ប្រសិទ្ធិភាព ។ ឧត្តមសេនីយ៍ ត្រី បាន លើកឡើង ថា ការបិទ វគ្គ ហ្វឹកហ្វឺន នេះ ពិតជា មាន សារៈសំខាន់ និង អត្ថន័យ ធំ ធេង ណាស់ ដែល វា បង្ហាញ ពី ទំនាក់ទំនង រវាង ត្រី ភាគី កម្ពុជា - អសប - កូរ៉េ ក្នុង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ រក្សា សន្តិភាព ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន បន្ថែម ថា កម្ពុជា - កូរ៉េ មាន ទំនាក់ទំនង ល្អ ជាមួយគ្នា យូរ លង់ ណាស់ មកហើយ ។ នាយ ឧត្តមសេនីយ៍ ជឿជាក់ ថា ប្រទេស ទាំង ពីរ នឹង មាន កិច្ចសហប្រតិបត្តិការ កាន់តែ ល្អ ប្រសើរ ទៅ មុខ ទៀត ៕
ឯក អគ្គ រដ្ឋទូត អាមេរិក ផ្ដល់ មូលនិធិ ដើម្បី ការអភិរក្ស វប្បធម៌ លើ គម្រោង ជំនួយ សម្រាប់ ជួសជុល ប្រាសាទ ភ្នំ បា ខែង
លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា បាន លើកឡើង ថា សហរដ្ឋ អាមេរិក មិន ត្រឹមតែ ផ្ដល់ ជំនួយ សម្រាប់ ជួសជុល ប្រាសាទ ភ្នំ បាខែង និង ប្រាសាទ ដទៃ ទៀត ក្នុង រមណីយដ្ឋាន អង្គរ ប៉ុណ្ណោះ ទេ គឺ កន្លងមក អាមេរិក ក៏ បាន ជួយ ជាច្រើន ដូចជា គម្រោង ជួសជុល ជណ្ដើរ ខាងជើង របស់ ប្រាសាទ ព្រះវិហារ ព្រមទាំង បាន បញ្ជូន វត្ថុ សិល្បៈ បុរាណ របស់ ខ្មែរ មួយចំនួន ឱ្យ វិលត្រឡប់មក មាតុភូមិ វិញ ផង ។
លោកស្រី បណ្ឌិត សភាចារ្យ ភឿង ស កុណា បាន បន្ត ទៀត ថា កិច្ចសហប្រតិបត្តិការ នៃ ជំនួយ របស់ អាមេរិក នេះ បាន ផ្ដល់ នូវ ផលប្រយោជន៍ យ៉ាង ខ្លាំង រវាង ប្រទេស ទាំង ពីរ លើ វិស័យ វប្បធម៌ និង ជាពិសេស មិន ត្រឹមតែ បាន ជួយ ជ្រោមជ្រែង លើ ការជួសជុល ប្រាង្គ ប្រាសាទ ទេ តែ ថែមទាំង បាន ជួយ សម្របសម្រួល ក្នុង ការនាំយក មកវិញ នូវ វត្ថុ សិល្បៈ ដែល កម្ពុជា បាន បាត់បង់ ជា យូរ ឆ្នាំ កន្លងមក ផងដែរ ។
ជាមួយគ្នា នេះ នៅក្នុង ដំណើរការ ពិនិត្យ ពិភាក្សា និង អនុម័ត សេចក្តីព្រាង គោល នយោបាយ ជាតិ ស្តីពី កម្មសិទ្ធិ បញ្ញា ឆ្នាំ ២០២៤ - ២០២៨ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា គោល នយោបាយ ជាតិ នេះ ក៏ ស្ថិត ក្នុង យុទ្ធសាស្រ្ត បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល ដែរ ។ ដូច្នេះ សម្តេច បាន ស្នើ ទីស្ដីការ គណៈ រដ្ឋមន្រ្តី ផ្ដល់ ការសម្របសម្រួល ដើម្បីឱ្យ គោល នយោបាយ នេះ ទទួលបាន ជោគជ័យ ។
សូម ជម្រាប ថា សេចក្ដីព្រាង គោល នយោបាយ ជាតិ ស្តីពី កម្មសិទ្ធិ បញ្ញា ឆ្នាំ ២០២៤ - ២០២៨ មាន ចក្ខុវិស័យ អភិវឌ្ឍ ប្រព័ន្ធ កម្មសិទ្ធិ បញ្ញា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ឱ្យ ក្លាយជា កម្លាំង ចលករ ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ឧស្សាហកម្ម វប្បធម៌ ទេសចរណ៍ និង កសិកម្ម ឆ្លើយតប នឹង បរិបទ សេដ្ឋកិច្ច និង សង្គម ឌីជីថល និង បដិវត្ត ឧស្សាហកម្ម ជំនាន់ ទី៤ និង ចូលរួមចំណែក ក្នុង ការសម្រេចបាន នូវ ចក្ខុវិស័យ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ឆ្នាំ ២០៥០ ។
សេចក្ដីព្រាង គោល នយោបាយ នេះ ត្រូវបាន តាក់តែង ឡើង ដោយ ឆ្លងកាត់ កិច្ចប្រជុំ លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង កម្មសិទ្ធិ បញ្ញា ចំនួន ៨លើ ក និង កិច្ចប្រជុំ ពិគ្រោះយោបល់ ចំនួន ១លើ ក ដោយ មាន ការចូលរួម ពី តំណាង សមាគម សហគ្រាស ធុន តូច និង មធ្យម សមាគម កម្មសិទ្ធិ បញ្ញា កម្ពុជា សមាគម សហគ្រិន ស្រ្តី កម្ពុជា សភា ពាណិជ្ជកម្ម និង សាកលវិទ្យាល័យ វិទ្យាសាស្រ្ត ស្រាវជ្រាវ ។
សេចក្ដីព្រាង គោល នយោបាយ នេះ មាន គោលដៅ សំខាន់ ៣រួម មាន៖
* ទី១ - រៀបចំ ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ដែល ទាក់ទង នឹង កម្មសិទ្ធិ បញ្ញា ឱ្យ ស្រប តាម បទដ្ឋាន អន្តរជាតិ និង ពង្រឹង ការអនុវត្ត ច្បាប់ កម្មសិទ្ធិ បញ្ញា ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ សេដ្ឋកិច្ច សង្គម និង ការអភិវឌ្ឍ ។
* ទី២ - ពង្រឹង និង លើកកម្ពស់ សមត្ថភាព មន្រ្តី និង អង្គភាព ក្នុង ការអនុវត្ត ប្រព័ន្ធ កម្មសិទ្ធិ បញ្ញា ដើម្បី គាំទ្រ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម ។
* ទី៣ - ផ្សព្វផ្សាយ និង លើកកម្ពស់ ចំណេះដឹង សាធារណៈ អំពី ការប្រើប្រាស់ កម្មសិទ្ធិ បញ្ញា ក្នុង ការអភិវឌ្ឍ សហ - គ្រាស ធុន តូច និង មធ្យម ដើម្បី ជំរុញ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា ។
( ភ្នំពេញ ) ៖ លោក ហែម ដារិទ្ធិ អភិបាល ខណ្ឌ មានជ័យ បាន ផ្តល់ រង្វាន់ ម៉ូតូ ចំនួន ៣គ្រឿង ដល់ សិស្ស និទ្ទេស A និង ផ្តល់ រង្វាន់ លើកទឹកចិត្ត ដល់ សិស្ស រៀន ពូកែ ព្រមទាំង ឧបត្ថម្ភ ថវិកា ដល់ គ្រូ ដែល ចូលនិវត្ត នៅ តាម សាលា នានា ក្នុង ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
ការប្រកាស ផ្ដល់ រង្វាន់ នេះ ធ្វើឡើង ក្នុង ឱកាស លោក អភិបាល ខណ្ឌ ហែម ដារិទ្ធិ ចូលរួម បើក បវេសនកាល ឆ្នាំ ២០២៣ - ២០២៤ នា ថ្ងៃទី១ ខែធ្នូ នៅ សាលា បឋមសិក្សា ហ៊ុន សែន ចាក់អង្រែ ។
លោក ហែម ដារិទ្ធ បាន អំពាវនាវ ឱ្យ សិស្សានុសិស្ស បន្ត យកចិត្តទុកដាក់ ខិតខំ រៀនសូត្រ ឱ្យ បាន ពូកែ ទទួលបាន និទ្ទេស A ឱ្យ បាន ច្រើន ថែម ទៀត ដើម្បី ទទួលបាន រង្វាន់ គ្រប់ ៗ គ្នា ។ លោក ថា ឆ្នាំ នេះ ក្នុង ខណ្ឌ មានជ័យ ទទួលបាន និទ្ទេស A តែ ៣នាក់ ប៉ុណ្ណោះ លោក ចង់ ឃើញ ឆ្នាំ ក្រោយ ៗ និទ្ទេស A កើនឡើង ជាច្រើន ដង ទៀត ហើយ លោក រីករាយ នឹង ផ្តល់ ការលើកទឹកចិត្ត សម្រាប់ ការប្រឹងប្រែង រៀនសូត្រ របស់ ជានិច្ច ។
សម្រាប់ ឆ្នាំ នេះ លោក ហែម ដារិទ្ធ បាន ផ្តល់ ម៉ូតូ ថ្មី ចំនួន ៣គ្រឿង ជា ការលើកទឹកចិត្ត ជូន សិស្ស ទទួលបាន និទ្ទេស A ចំនួន ៣នាក់ រួម មាន៖ ទី១. កុមារី ហាន ទេពរីណា មកពី វិទ្យាល័យ ចំរើន ផល ទី២. កុមារី វ៉ាត សុសូរិយា មកពី វិទ្យាល័យ ចាក់អង្រែ ទី៣. កុមារី ហង្ស សុវណ្ណ សៀង លី មកពី វិទ្យាល័យ ចាក់អង្រែ ។
មន្ទីរ បញ្ចកោណ បាន ប្រកាស កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ ថា នៅតែ បន្ត ប្រតិបត្តិការ ហោះហើរ យន្តហោះ Ospreys ហើយ ថា មិន បាន ដឹង អំពី សំណើ ផ្លូវការ ណាមួយ ទេ ខណៈ មូលហេតុ នៃ ការធ្លាក់ ស្ថិត ក្រោម ការស៉ើប អង្កេត ។
នៅក្នុង ឱកាស នៃ ជំនួប នោះ លោក នួន ផារ័ត្ន បាន ជម្រាប ថា ដំណើរទស្សនកិច្ច របស់ គណៈប្រតិភូ នៅ ពេល នេះ គឺជា ការរួមចំណែក ក្នុង ការពង្រឹង និង ពង្រីក ទំនាក់ទំនង ដ៏ ស្អិត រមួត និង កិច្ចសហប្រតិបត្តិការ ដ៏ ជិតស្និទ្ធ រវាង រដ្ឋាភិបាល និង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ក្នុង នាម ជា អ្នកជិតខាង ល្អ មិត្តភាព ជា ប្រពៃណី កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ ស្ថិតស្ថេរ រឹងមាំ យូរអង្វែង ។
លោក បាន បន្ត ជម្រាប ជូន គណៈប្រតិភូ ក្រសួង ការបរទេស វៀតណាម ថា ក្រោម ការបន្ត ដឹកនាំ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា លោក ជឿជាក់ ថា កម្ពុជា នឹង បន្ត អភិវឌ្ឍ ឈាន ទៅ មុខ ប្រកបដោយ ភាពជឿជាក់ ខ្ពស់ លើ មាគ៌ា សន្តិភាព ប្រជាធិបតេយ្យ និង ការអភិវឌ្ឍ ជាមួយនឹង ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ កាន់តែ ជិតស្និទ្ធ រវាង រដ្ឋាភិបាល និង ប្រជាជន នៃ ប្រទេស ទាំង ពីរ ដើម្បី ជា ផលប្រយោជន៍ រួម របស់ ប្រជាជន យើង ។
ជា ការឆ្លើយតប លោកស្រី អនុ រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម បាន លើក សរសើរ និង អបអរសាទរ ចំពោះ សមិទ្ធផល ដែល កម្ពុជា និង រាជធានី ភ្នំពេញ សម្រេចបាន ក្នុង ការរក្សា កំណើន សេដ្ឋកិច្ច ស្ថិរភាព សណ្តាប់ធ្នាប់ សង្គម និង សុខ សន្តិភាព ជាពិសេស ការអភិវឌ្ឍ យ៉ាង ឆាប់រហ័ស របស់ រាជធានី ភ្នំពេញ និង បាន ជូន ពរ ដល់ ប្រទេស កម្ពុជា និង រាជធានី ភ្នំពេញ ឱ្យ សម្រេចបាន ជោគជ័យ បន្ថែម ទៀត នា ពេល អនាគត ។
( ភ្នំពេញ ) ៖ លោក សុខ សម្បត្តិ អភិបាល ខណ្ឌ បឹងកេងកង នា ព្រឹក ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ២០២៣ - ២០២៤ នៅ វិទ្យាល័យ ជា ស៊ីម បឹងកេងកង ស្ថិត នៅ សង្កាត់ បឹងកេងកង ទី១ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ និង បាន ចែក សម្ភារៈ សិក្សា ដល់ សិស្សានុសិស្ស ដែល បាន ជាប់ ចំណាត់ថ្នាក់ លេខ ១ ដល់ លេខ ៣ ផងដែរ ។
