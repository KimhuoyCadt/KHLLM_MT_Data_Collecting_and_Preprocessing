ខ្ញុំ គ្រាន់តែ ឈ្នះ ល្បែង ដោយ ចៃដន្យ ទេ ។
សូម កុំ លេងសើច នឹង ខ្ញុំ ។
តើ ល្បែង របស់ អ្នក យ៉ាងម៉េច ដែរ ប៉ុន្មាន ថ្ងៃ នេះ ?
ខ្ញុំ វាយ ចូល រន្ធ ទី ប្រាំបួន ។
ខ្យល់ គឺ ប្រឆាំង នឹង ខ្ញុំ ។
អ្នក អាច វាយ ចូល បាន ប៉ែតសិប ។
បញ្ចេញ អោយ អស់ សមត្ថភាព ។
វា មាន បញ្ហា ជាមួយ កណ្តាប់ដៃ របស់ អ្នក ។
កាន់ ដំបង របស់ អ្នក អោយ ខ្លី ។
ជំហរ របស់ អ្នក គឺ តូច បន្តិច ។
ស្មៅ នៅ តំបន់ ចន្លោះ រវាង ទីតាំង ដើម និង ទី គោលដៅ គឺ ស្អាត ។
ធ្វើអោយ ក្បាល របស់ អ្នក នៅ នឹង ។
អ្នក នៅលើ វាល ស្មៅ ។
អ្នក ខុស ច្បាប់ ហើយ ។
វា ប្រហែល សែសិប ហ្វីត ទៅកាន់ ពាន ។
ខ្ញុំ មាន បញ្ហា ក្នុង ការធ្វើអោយ ក្បាល របស់ ខ្ញុំ នៅនឹង ។
ប្រសិនបើ អ្នក វាយ ខុស អ្នក នឹង ទៅ ក្រៅ តំបន់ ចន្លោះ រវាង ទីតាំង ដើម និង ទី គោលដៅ ។
គាត់ បរាជ័យ ជាមួយ វិធីសាស្ត្រ វាយ ជិត របស់ គាត់ ។
ខ្ញុំ ចង់ លេង កីឡា តិន្និស ជាមួយ នរណា ម្នាក់ ។
វា គឺ ល្អ ក្នុង ការលេង កីឡា តិន្និស នៅក្នុង កន្លែង ស្អាត ដូច្នេះ ។
កូនប្រុស របស់ ខ្ញុំ គឺ ពូកែ ខាង វាយ បាល់ ផ្តើម ។
ការវាយ ចុះក្រោម របស់ អ្នក គឺ ល្អ ណាស់ ។
កូនប្រុស របស់ ខ្ញុំ កំពុង ចូលរៀន សាលា ឧត្តម សិក្សា នៅ សកល វីទ្យាល័យ ហា វើត ។
គាត់ គឺ សាស្ត្រាចារ្យ នៅ សកលវិទ្យាល័យ អេ ។
គ្រូ របស់ ខ្ញុំ ហៅ បញ្ជី ឈ្មោះ រៀងរាល់ ថ្ងៃ ។
នាង ពូកែ ខាង គណិតវិទ្យា ។
ខ្ញុំ ធ្លាប់ ជា សមាជិក ក្រុម តន្ត្រី វង់ ត្រែ ។
អ្នកការពារ និង មេដឹកនាំ គឺ បងប្អូន ប្រុស ។
អ្នករិះគន់ និយាយ ថា រឿង នេះ គឺ ល្អ ខ្លាំង ណាស់ ។
រឿង នេះ មាន រយះពេល វែង នៅ មហោស្រព គ្រប់ ទីកន្លែង ។
ខ្ញុំ ស្តាប់ តន្ត្រី ហ៊ីប ហុប រៀងរាល់ ពេល ។
ម៉ាដន ណា គឺ ម្នាក់ នៃ វិចិត្រករ ដ៏ ល្បី នៅក្នុង ពិភពលោក ។
ខ្ញុំ នឹង រង់ចាំ អ្នក នៅ ជាន់ ផ្ទាល់ ដី ។
បន្ទប់ទឹក គឺ រវល់ ហើយ ។
ខ្ញុំ ចង់ ទិញ អាវ មួយ សំរាប់ វត្ថុអនុស្សាវរីយ៍ ។
អាវយឺត ក្រៅ នេះ គឺ ថ្លៃ ពេក ហើយ សំរាប់ ខ្ញុំ ។
ប៉ា របស់ ខ្ញុំ ចូលចិត្ត អាវយឺត ក្រៅ ក អាវ អក្សរ វី ណាស់ ។
អាវយឺត ក្រៅ សាច់ សំពត់ ឡែន នេះ គឺ ធ្វើ នៅ ប្រទេស ជប៉ុន ។
វ៉ែនតា ការពារ ពន្លឺ ព្រះអាទិត្យ នេះ គឺ រាង ឆើត បន្តិច ហើយ សំរាប់ ខ្ញុំ ។
ខ្ញុំ បាន ទិញ ក្រែម លាប មាត់ មួយ សំរាប់ កាដូ មួយ ។
សូម កុំ ទុក របស់របរ ផ្ទាល់ ខ្ញុំ នៅ ខាងក្រោយ ។
សំបុត្រ សំរាប់ ការប្រកួត កីឡា បេហ្ស៍ប័ល រវាង វ៉ាសេដា និង ខេអ៊ីអូ ត្រូវបាន លក់ អស់ ហើយ ។
មនុស្ស ក្មេង ចូលចិត្ត អាហារ ទាន់ចិត្ត ។
ខ្ញុំ ចូលចិត្ត ផ្លែ ឈើ ណាស់ លើកលែងតែ ផ្លែ ល្វា ។
ជនជាតិ ជប៉ុន ចូលចិត្ត បរិភោគ មឹក ធំ និង មឹក បំពង់ ។
នាង ដាក់ គ្រឿង សំម្ល ជាមួយ ខ្លឹម ស ។
ខ្ញុំ បាន បរិភោគ កាហ្វេ មួយ កែវ និង នំបុ័ង មួយ បន្ទះ នៅ ព្រឹក នេះ ។
មើល ការណែនាំ នៅលើ កញ្ចប់ អាហារ ខ្ចប់ ដែល ឥត មាន ខ្យល់ ។
ពួកគេ មិន បរិភោគ ស៊ុត ឆៅ នៅក្នុង រដ្ឋ ទេ ។
យក នំបុ័ង សាំង វ៉ិច សំរាប់ ខ្លួនអ្នក ។
ខ្ញុំ មាន ប្រាក់ តិចតួច នៅ ជាមួយ ខ្ញុំ ។
ខ្ញុំ មាន សៀវភៅ ច្រើន ណាស់ ។
អ្នក ត្រូវការ ប្រាក់ ច្រើន ណាស់ ដើម្បី ទិញ កុំព្យូទ័រ ថ្មី នោះ ។
ខ្ញុំ កុម្ម៉ង់ សាឡាត គ្រឿង សមុទ្រ ។
ខ្ញុំ ចង់បាន ទឹក សាឡាត់ អ៊ីតាលី ។
នាង បាន បំរើ កាហ្វេ ខ្លាំង អោយ យើង ។
ខ្ញុំ ចូលចិត្ត ការ៉េម បន្ទាប់មក ទឹក ផ្លែ ឈើ ។
ខ្ញុំ ត្រូវតែ បង្ហាញ លិខិត ឆ្លង ដែន របស់ អ្នក នៅឯ កន្លែង ត្រួតពិនិត្យ លិខិត ឆ្លង ដែន ។
សំបុត្រ នេះ គ្មាន សុពុល ភាព ទេ ។
អ្នក គួរតែ ទៅកាន់ ការិយាល័យ ព័ត៌មាន ទេសចរណ៍ សិន ។
តើ មាន ព្រឹត្តិការណ៍ សំខាន់ ក្នុង ខែមីនា នៅក្នុង ប្រទេស ជប៉ុន ទេ ?
ទីកន្លែង កំណើត របស់ សេក ស្ពៀរ គឺ ស្អាត ណាស់ ។
ខ្ញុំ បាន ទៅ ប្រទេស បារាំង បួន ប្រាំ ដង ហើយ ។
ខ្ញុំ បាន បើក គណនេយ្យ សន្សំ ជាមួយ ធនាគារ ។
ប៉ា របស់ ខ្ញុំ គឺ មេធាវី ហើយ ម៉ាក់ របស់ ខ្ញុំ គឺ អ្នក រដ្ឋការ ។
ការប្រជុំ បន្ទាន់ ត្រូវបាន អញ្ជើញ ។
ខ្ញុំ បាន តាំងពិព័រណ៍ ទំនិញ សំរាប់ លក់ ។
ការគ្រប់គ្រង បញ្ជី សារពើភ័ណ្ឌ គឺ សំខាន់ ខ្លាំង ណាស់ សំរាប់ ក្រុមហ៊ុន មួយ ។
ខ្ញុំ ធ្វើការ នៅ សាខា ប្រទេស ចិន ។
ទីបំផុត ប៉ា របស់ ខ្ញុំ បាន ការឈប់ សំរាក ដែល ទទួលបាន ប្រាក់ ចំណូល ហើយ ។
ទីផ្សារ គឺ ធ្លាក់ចុះ ។
ដំណើរ ធ្លាក់ចុះ មាន រយះពេល បី ឆ្នាំ ។
កំណើន សេដ្ឋកិច្ច គឺ ត្រូវបាន រំពឹងទុក ។
ពួកយើង ត្រូវ កាត់បន្ថយ ប្រាក់ ចំណាយ ។
ក្រុមហ៊ុន បាន ខាត ទុន ។
ហ៊ុន ទាំងនេះ គួរតែ រក ប្រាក់ ចំណេញ បាន ច្រើន ។
ខ្ញុំ បាន រក ប្រាក់ ខ្លះ តាម ហ៊ុន ទីផ្សារ ។
ខ្ញុំ ធ្លាប់ ធ្វើការ នៅ ក្រុមហ៊ុន ធានារ៉ាប់រង ។
ខ្ញុំ ដាក់ ប្រាក់ នៅ ធនាគារ ទីក្រុង ។
ធនាគារ មិន អោយ ប្រាក់ ខ្ចី ដោយ គ្មាន សុវត្ថិភាព ទេ ។
គាត់ គឺ ធ្វើការ នៅ កន្លែង គ្រប់គ្រង បញ្ជី សារពើភ័ណ្ឌ ។
អតិថិជន របស់ ពួកយើង បាន ក្ស័យ ធន ហើយ ។
គាត់ បាន សរសេរ រូបិយ បណ័្ណ សំរាប់ មួយ រយ ដុល្លារ នៅ ធនាគារ ។
ពួកយើង បាន ធ្វើ វិក័យប័ត្រ ហើយ ។
ពួកយើង ទិញ លក់ កាតាប ។
ប្រព័ន្ធ ប្រតិបត្តិការ មិន ដំណើរការ ទេ ។
សូម ផ្ញើរ អ៊ីមែល អោយ ខ្ញុំ កាន់តែ ឆាប់ កាន់តែ ល្អ ។
និស្សិត ភាគ ច្រើន នៅ សកលវិទ្យាល័យ របស់ ខ្ញុំ មាន កុំព្យូទ័រ ដែល ងាយស្រួល យក តាម ខ្លួន និង ទូរស័ព្ទ ដៃ ផ្ទាល់ខ្លួន ។
សូម កុំ បត់ សំបុត្រ ពីព្រោះ រូបថត នៅ ខាងក្នុង ។
ពួកយើង បាន ទទួល ការហៅទូរស័ព្ទ រយះ ចំងាយ ឆ្ងាយ ពី លោក តា លោកយាយ របស់ ពួកយើង ។
ភី អេស តំណាង អោយ បច្ឆា លិខិត ។
នាង បាន ឡើង ទំងន់ ច្រើន ណាស់ ឆ្នាំ មុន ។
តើ អ្នក ត្រូវការ ថ្នាំ អាស្ពារីន ទេ ?
អ្នករិះគន់ ល្បីល្បាញ បាន ក្លាយទៅជា រដ្ឋមន្ត្រី ។
ជនជាប់ចោទ ត្រូវតែ មាន ទោស ។
ការកាត់សេចក្តីត្រូវបាន ធ្វើឡើង កាលពី សប្ដាហ៍ មុន ។
ការបំពុល បរិយាកាស គឺជា បញ្ហា ធ្ងន់ធ្ងរ មួយ នៅក្នុង ទីក្រុង ។
គាត់ ប្រហែលជា នឹង ឈរឈ្មោះ ដើម្បី ក្លាយជា សមាជិក ព្រឹទ្ធសភា ។
ខ្ញុំ ត្រូវបាន អញ្ជើញ អោយ ចូលរួម ក្នុង ពិធី ជប់លៀង អាពាហ៍ពិពាហ៍ របស់ មិត្ត សំលាញ់ ខ្ញុំ ។
សាលា ជាច្រើន មាន ជំនួប អត្តពលកម្ម នៅ ថ្ងៃ កីឡា នា រដូវ ស្លឹកឈើ ជ្រុះ ។
កីឡា បោក ចំបាប់ ស៊ូមូ គឺជា កីឡា ជាតិ របស់ ប្រទេស ជប៉ុន ។
ធ្វើអោយ បាន ច្រើន ជាង និយាយ ។
បក្សី ស្អាត ដោយសារ រោម ។
អ្វី ក៏ ឆ្ងាញ់ ដែល នៅពេល ឃ្លាន ។
កុំ ព្រួយបារម្ភ ខ្លាំង ពេក ។
ស្នេហា គឺជា សេរីភាព ។
បុរស ៗ តែងតែ និយាយ កុហក ។
គាត់ ជា មនុស្ស ចុងក្រោយ ដែល និយាយ កុហក ។
ខ្យល់ព្យុះ កើតឡើង រយះពេល ពីរ សប្ដាហ៍ ។
អ្នកគ្រប់គ្រង បាន មក ប្រជុំ យឺត ។
ខ្ញុំ ក្រោក ពី ដំណេក យឺត រាល់ ថ្ងៃអាទិត្យ ។
ខ្ញុំ ខ្លាច ការងារ ថ្មី បំផុត របស់ គាត់ និង ក្លាយជា ការងារ ចុងក្រោយ ។
ឡាន របស់ ខ្ញុំ មិន ទំនេរ ទេ នៅ ថ្ងៃស្អែក ។
សត្វ មួយ ក្នុង ដៃ ប្រសើរ ជាង សត្វ ពីរ នៅក្នុង ព្រៃ ។
មនុស្ស ជាទូទៅ តែងតែ គិត ថា អ្នកដទៃ ល្អ ជាង ខ្លួន ។
សំដី មនុស្ស ស្រួច ជាង អាវុធ ។
គ្មាន ទីកន្លែងណា ដូច ផ្ទះ របស់ យើង ទេ ។
គ្នា ច្រើន អន្សម ខ្លោច ។
ជញ្ជាំង មាន ត្រចៀក ។
មនុស្ស ស្រី និង អាកាសធាតុ សុទ្ធតែ មិន គួរអោយ ទុកចិត្ត ។
មាន ឆន្ទៈ មាន ដំណោះស្រាយ ។
អ្នកដំណើរ នៅតែ អង្គុយ ។
ខ្ញុំ មាន សុខភាព មិន ល្អ ។
លោក ថា ណាកា ពាក់ ក្រវ៉ាត់ ករ ឆ្នូត រាល់ ថ្ងៃ ។
គាត់ មើល ទៅ ដូចជា កើតទុក្ខុ ។
អ្នក មិន គួរ មើល ខ្សែភាពយន្ត អ៊ិច រ៉េត ទេ ។
