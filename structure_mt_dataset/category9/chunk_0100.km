ទៅ បូជា នៅ ទីនោះ ជារៀងរាល់ ឆ្នាំ ដើម្បី សុំ សេចក្តីសុខ ពី ទន្លេ លឿង នោះ ។
ទោះជា ថ្ងៃ នេះ គាត់ មាន សភាព ធូរស្រាល ជាង ថ្ងៃ កើត ហេតុ បន្តិច មែន ប៉ុន្តែ គាត់ នៅតែ ប្រឈម នៅឡើយ ដោយសារ របួស ធ្ងន់ ធ្ង រ ខ្លាំង ពេក ។
២១ ខ្ញុំ សុំ អង្វរ អ្នក នៅ ចំពោះ ព្រះភក្ត្រ ព្រះជាម្ចាស់ នៅ ចំពោះ ព្រះភក្ត្រ ព្រះគ្រិស្ដ យេស៊ូ និង នៅ ចំពោះ មុខ ទេវតា * ដែល ព្រះអង្គ បាន ជ្រើស រើស ថា ចូរ ធ្វើ តាម ពាក្យ ដែល ខ្ញុំ ផ្ដែ ផ្ដាំ ទាំង នេះ ដោយ ឥត កាន់ ជើង ឬ រើស មុខ បង ប្អូន ណា ឡើយ ។
កាល នោះ ខ្ញុំ មាន មិត្តភក្កិ ជាច្រើន ដែល ម្នាក់ ៗ
សូម ឲ្យ បងប្អូន ទស្សនិកជន ទាំងអស់ ពិចារណា តាម ការគួរ ផង ចុះ ។
សូម សង្គ្រោះ អ្នក បំរើ របស់ ព្រះអង្គ
ជាពិសេស អ្នក ខ្លះ ថែមទាំង បាន ជំរុញ ឲ្យ នាង ទៅ ធ្វើ អត្តឃាត នោះ ថែម ទៀត ។
ពេលនេះ ប្រសិនបើ លោក ធ្វើរ ដូច មុន ខ្ញុំ នឹង បញ្ឈប់ ការគាំទ្រ ដល់ លោក
ព្រះកាយ តែ មួយ បែង ចែក ជា ច្រើន ផ្នែក
អ្នកស្រុក ប្រហែល ១០០ ក្នុង នោះ មាន សាច់ញាតិ ជនរងគ្រោះ បាន ចាប់ផ្តើម ស្វែងរក ស្ត្រី រងគ្រោះ បន្ទាប់ នាង ពុំ បាន ឃើញ វិល ត្រឡប់មក ផ្ទះ វិញ ពី ចម្ការ នៅ យប់ ថ្ងៃ ព្រហស្បតិ៍ ។
អ្នក ភូមិ ទាំង ពីរ ក្រុម សុទ្ធតែ មាន បញ្ជី សមាជិក រៀង ៗ
យ៉ាងណាមិញ ទោះបីជា មាន រឿង អ្វី កើតឡើង ក៏ដោយ អ្នក ត្រូវ ចាំ ថា ប្តី ឬ ប្រពន្ធ របស់ អ្នក ជា ជម្រើស ទី មួយ ៕
ប៉ុន្តែ ទ្រង់ បាន បោះ បង់ ចោល ហើយ បណ្តេញ ទៅ ទ្រង់ មាន សេចក្ដី ក្រោធ នឹង អ្នក ដែល ទ្រង់ ចាក់ ប្រេង តាំង ឲ្យ
ជាមួយនឹង ថ្ងៃ ពិសេស នេះ ឆុំ វត្តី បាន បង្ហាញ អារម្មណ៍ ថា " អរគុណ ប្តី សម្លាញ់ សម្រាប់ គ្រប់ យ៉ាង ដែល បង ធ្វើ មក លើ អូន ។
លោក ដូណាល់ ត្រាំ សុំ អោយ ប្រធានាធិបតី ចិន ចាត់ការ រឿង កូរ៉េ ខាងជើង អោយ ឆាប់ រហ័ស
ការ ស្តារ នីតិ សម្បទា គឺជា គន្លឹះ នៅក្នុង ករណី បែប នេះ ។
សកម្មភាព អាក្រក់ ១០យ៉ាង ដែល មនុស្ស ប្រុស មិន ត្រូវ ធ្វើ ចំពោះ មនុស្ស ស្រី _ ខ្ញុំ និង អ្នក
វា មិន មែន មាន ន័យ ថា អ្នក មិន គួរ ធ្វើ ការសម្រេចចិត្ត ក្រុម នោះ ទេ ប៉ុន្តែ អ្នក ត្រូវ បង្កើត បែប ផែន ការងារ ត្រឹមត្រូវ មួយ សម្រាប់ ការសម្រេច ចិត្ត ក្រុម ។
កីឡាករ កម្ពុជា បច្ចុប្បន្ន នេះ ពិតជា ធ្វើ បាន ល្អ ជាង មុន ឆ្ងាយ ណាស់ ៕
នាង បាន និយាយ ថា : ' ខ្ញុំ បាន នៅលើ ថ្ងៃ ឈប់សម្រាក និង ជា លើក ដំបូង នៅក្នុង រូបភាព នេះ ត្រូវបាន គេ គ្រាន់តែ កំប្លែង , ប៉ុន្តែ នៅ ពេល ដែល ខ្ញុំ បាន ទទួល មកវិញ ទៅ កោះ តៃវ៉ាន់ ដែល ខ្ញុំ មាន ទាំងអស់ មនុស្ស ទាំងនេះ កំពុង ព្យាយាម ដើម្បី បន្ថែម ខ្ញុំ ជា មិត្តភក្តិ នៅលើ ហ្វេសប៊ុក ។
ប៉ុន្តែ លោក បញ្ជាក់ ថា រដ្ឋា ភិបាល ប្រទេស ជប៉ុន បាន ចាត់ វិធានការ ចំពោះ រឿង នេះ៖
សូម អោយ គេ រំលឹក ឈ្មោះ ពុក
អានីយល់ព្រម ព្រោះ នាង ក៏ មាន
ជា សុជាតិ និង កែវ ពន្លឺ បាត់ ឡាន កាលពី យប់ មិញ
ការ ផឹក ទឹក ដាំ ពុះ គឺជា ការ ប្រសើរ បំផុត សម្រាប់ សុខភាព អ្នក ។
ទិដ្ឋភាព ខាង ក្នុង ព្រះវិហារ ប្លែក ភ្នែក មែន ទែន ។
នៅ ក្នុង សហរដ្ឋ អាមេរិក មនុស្ស ចំនួន ១០ លាន នាក់ រួម មាន យុវវ័យ ក្មេង ៗ
នៅ ពេល នោះ ខ្ញុំ មាន បំណង គ្រាន់ តែ ផលិត ភាពយន្ត ឯកសារ ខ្លី មួយ ប៉ុណ្ណោះ ។
" ខ្ញុំ ស្គាល់ កន្លែង លក់ របស់ គាត់ ដោយ សារតែ មិត្ដភក្ដិ ធ្លាប់ ចូល ទិញ ផ្ញើ ឲ្យ ខ្ញុំ ។
អង្គការ អន្តរជាតិ ដែល ទទួលស្គាល់ ដោយ រដ្ឋាភិបាល
ថា ឪ ម្ចាស់ ថ្លៃ ឧត្ដម ម្ល៉េះ សម យើងខ្ញុំ នឹង ក្ស័យ ជីវិត ពុំ ខាន ។
ឡើយ ពីព្រោះ វា អាច ធ្វើ អោយ ក្មេង ៗ
ខ្ញុំ មាន មោទកភាព ខ្លាំង ណាស់ ដែល បាន ឃើញ នូវ ភាព ច្នៃប្រឌិត របស់ ពួកគាត់ ។
មក ថា ជួបគ្នា ឆាប់ ៗ
អោយ បាន មួយ អាទិត្យ ម្ដង កាន់តែ ល្អ ។
តែ កូន បែរជា ភ្លើតភ្លើន ភ្លេច គិត ទៅ វិញ ជាពិសេស គឺ មិត្ត នារី ៗ
ចុះ គ្រាន់តែ ពាក្យ អរគុណ មិន ទៅ ធ្ងន់ អី ប៉ុន្មាន ក្មួយ !
ពេល ព្រឹក របស់ យើង អាច កំណត់ អារម្មណ៍ ពេញ មួយ ថ្ងៃ បាន ។
ស្រ្តី ៣នាក់ ទទួលបាន ពានរង្វាន់ ណូបែល សន្តិភាព
ក្រោយពេល ដែល ឆ្អិន រួច អ្នក អាច រោយ ល្ងស ពីលើ ជា ការ ស្រេច ៕
រហូតដល់ សប្ដាហ៍ ចុងក្រោយ ហើយ មាន ទាំង បង្ហាត់ ឲ្យ លោក វិរៈ សិទ្ធ ចេះ ផ្លុំ ខ្លុយ ថែម ទៀត ផង ។
ទណ្ឌកម្ម អាច ធ្វើ បាន នៅ ពេល ក្រោយ ក្នុង ករណី ចាំបាច់ ។
ចំណែក សេដ្ឋី ហើយ ទ្រង់ គ្មាន ព្រះ រាជ ឳង្កា អ្វី បន្តិច សោះ ឡើយ ទ្រង់ លែង ទៅ វិញ ។
ជីវិត ខ្ញុំ បាន ជួប ការ លំបាក ច្រើន ។
បង្កើត ឡើង ដោយ ជនជាតិ ដើម ភាគ តិច ។
ជាធម្មតា វា មាន ទាំង អ្នក ចូលចិត្ត និង មិន ចូលចិត្ត ប៉ុន្តែ មាន អ្នក មិន ចូលចិត្ត ច្រើន ជាង អ្នក ដែល ចូលចិត្ត ។
ទៀត ព្រោះ មិន អាច មើល ស្រាល កីឡាករ ជំនាន់ ក្រោយ បាន ទេ ។
អ្នក មិន ត្រូវ ស្ទាក់ស្ទើ ឡើង ក្នុង ការ សួរ សំនួរ ទៅ គ្រូពេទ្យ នូវ សំនួរ ដែល អ្នក ចង់ សួរ អោយ សោះ ។
ខ្ញុំ អាច និយាយ បាន ថា មាន កត្តា ច្រើន យ៉ាង ។
