ប៉ុន្តែ ពេល ខ្លះ លំពែង របស់ អ្នក មិន អាច ធ្វើ ការងារ នេះ បាន ទេ ។
សម្រាប់ ប្រជាជន ធម្មតា កម្សាន្ត ។
ទៅ ក្នុង អត្តភាព ដទៃ ណាមួយ ដទៃ អំពី បច្ចុប្បន្ន នេះ ។
អ៊ីចឹង ទឹក ចិត្ដ គាត់ នៅ មាន ។
យើង កំពុង រស់ នៅ ក្នុង ពិភពលោក មួយ ខ្វះ តុល្យភាព ។
អរគុណ លោក អ៊ុំ ដែល ខិត ខំ ស្វែង រក ចម្លើយ សម្រាប់ ក្មួយ ។
ជាមួយ នរណា ម្នាក់ ក្នុង ការិយាល័យ ។
ខ្ញុំ ចូលចិត្ត ប្រើ អាសយដ្ឋាន អ៊ីមែល បច្ចុប្បន្ន របស់ ខ្ញុំ ជាង
យើងខ្ញុំ មាន សេវាកម្ម ជួល គ្រប់ ប្រភេទ ដោយ ជួល គិត ជា ថ្ងៃ ខែ នឹង ឆ្នាំ
" សុវត្ថិភាព និង ការធ្វើដំណើរ បន្ទាន់ " អ។
ម៉េចបាច់ ព្រួយបារម្ភ ទេ ពីព្រោះ ៈ
ហើយ រាប់ ចំនួន អំពើ បាប ដែល ពួក គេ ប្រព្រឹត្ត ។
ផ្លូវ ចេញ ចូល ងាយស្រួល
ដល់ ក្រុង យុវជន ឲ្យ ចេះ ស្រឡាញ់ ប្រទេស ជា តិ៖
កាល ពី មុន ពួកគេ មាន សុវត្ថិភាព ណាស់ ។
ព្រះអង្គ ធ្វើ អោយ ពពក អាប់ អួរ
ម៉ា រីណែត បន្ត ថា ខ្លួន ចាប់ចិត្ត និង កោតសរសើរ យ៉ាង ខ្លាំង ពី ការសម្តែង របស់ ថា រ័ត្ន ហើយ ថា នាង ពិតជា ស័ក្តិសម ជា ម្ចាស់ ពានរង្វាន់ តារា សម្តែង ឆ្នើម ពិត មែន ។
ទៀត ជំរុញ ការគាំទ្រ ដល់ វិស័យ សេដ្ឋកិច្ច តៃវ៉ាន់ ។
ដោយឡែក ទីតាំង ដែល មិន មាន ច្បាប់ គឺ យើង បិទ អាជីវកម្ម តែម្តង ។
សម្តេច ស ខេង ថា ការអនុវត្ត ច្បាប់ ចរាចរណ៍ មាន អ្នករិះគន់ មិន ដល់ ១ភាគរយ ទេ
មាន តែ ក្រុម ភ្នំពេញ ក្រោន មួយ គត់ ដែល ខ្ញុំ ចូល ចិត្ត ព្រោះ បាន ផ្ដល់ លក្ខខ័ណ ល្អ ដល់ កីឡាករ ។
ពួកគេ គាំទ្រ លើ គម្រោង អភិវឌ្ឍន៍ បន្ត របស់ អា ជ្ញា ធរ ជាតិ អប្សរា ។
១៥ លុះ គេ បាន បរិភោគ រួច រាល់ ហើយ ព្រះយេស៊ូ មាន ព្រះបន្ទូល សួរ លោក ស៊ីម៉ូន ពេត្រុស ថា៖
អូន មិន សប្បាយ បង មិន រីករាយ ព្រោះតែ មេត្ដា
លោក អ្នក មាន ការ ខ្វាយខ្វល់ ហើយ ទោះ ធ្វើ អ្វី ៗ
វិធី ទាំង ១២ យ៉ាង ដែល យើង អាច ជៀសវាង ពី ការចាញ់ បោក ហាង អនឡាញ
ក្រុម និស្សិត ដែល នាំ គ្នា ទៅ កាន់ ទីនោះ បាន លើក ឡើង ថា ពួក គេ ចង់បាន លទ្ធិ ប្រជាធិបតេយ្យ និង ចង់បាន មេដឹកនាំ មួយ រូប ដែល ហ៊ាន ទទួលខុសត្រូវ ។
ប្រសិនបើ អ្នក គេង មិន លក់ ចូរ ទទួលទាន តែ ជី អង្កាម ១ពែង ។
នោះ ទី បន្ទាល់ របស់ នាង
ចូរ ព្យាយាម ចង ចាំ ទុក នូវ អារម្មណ៍ ក្នុង ដំណាក់កាល ដំបូង នេះ ក៏ ព្រោះ អ្នក អាច នឹង ត្រូវការ វា នៅ ពេល ក្រោយ ដើម្បី រលឹក ការ ចង ចាំ ល្អ ៗ
ពោរពេញ ដោយ លាភ សំណាង ផ្ទួន ៗ
ខ្សែ រថភ្លើង និង ជើងហោះហើរ ជាច្រើន ផងដែរ ត្រូវបាន ផ្អាក ដំណើរការ ជា បណ្តោះអាសន្ន ។
មិត្ត ស្រី និង កូនស្រី របស់ លោក ប៉រ
ជូនពរ អ្នកនាង ឲ្យ រស់ នៅ ប្រទេស អាមេរិក សុខសប្បាយ និង មាន ក្តីសុខ ៕
បុណ្យ សប្បាយ ជួបជុំគ្នា ។
លោក បាន សម្អាត កាយ ជាមួយ សាប៊ូ រៀងរាល់ ពេល ដែល ងូតទឹក ។
លោក បន្ត ថា សមត្ថកិច្ច កំពុង រៀប កម្លាំង ទប់ស្កាត់ ភ្លើង ដើម្បី កាន់ បន្ថយ កុំ ឲ្យ ឆេះ រាលដាល មុខ ទៀត ។
បាន ដាក់ពាក្យ គន្លឹះ ៖
តែ គាត់ មិន បាន ទៅ ប្តឹង សន្តិសុខ ផ្សារ ឬ ក៏ ប៉ុស្តិ៍ ប៉ូលិស ទេ ។
បើ អ្នកឯង ខ្លាច កុំ ដើរ ។
នា ពេលនេះ គឺ ថា ទាំង ខាង អាមេរិក ទាំង ខាង អ៊ីរ៉ង់ សុទ្ធតែ អះអាង ថា មិន ចង់ ធ្វើ សង្រ្គាម ទេ ។
១) សេដ្ឋកិច្ច ជាន់ ទាប ជា ការទាក់ទង ជាមួយ សេដ្ឋកិច្ច ផ្ទាល់ខ្លួន របស់ មនុស្ស ម្នាក់ ៗ
យើង ដឹង ច្បាស់ ថា អ្នក ប្រាកដជា មាន មិត្តភក្តិ សាច់ញាតិ ឬ នរណា ម្នាក់ ដែល អ្នក ស្រលាញ់ កំពុងតែ កើត ជំងឺ ទឹកនោម ផ្អែម ហើយ ។
គឺ ដូច បុត្រ និយាយ អញ្ចឹង ។
គ្មាន នរណា ម្នាក់ ជួយ សង្គ្រោះ យើង ក្រៅ ពី ខ្លួន យើង ទេ ។
ជាមួយគ្នា នេះ ដែរ បើ ទោះបីជា អ្នកនាង គង់ សុជាតិ មាន វ័យ កាន់ ច្រើន និង មាន កូន ៗ
ចក្ខុ របស់ ព្រះ ដ៏ មាន ព្រះភាគ មាន ៥ យ៉ាង គឺ៖
ទាំង អស់ សុទ្ធ តែ មាន ពេល កំណត់
ដែល នាង មាន ការយកចិត្តទុកដាក់ ទៅ លើ ការងារ ចង់ សាង ប្រជាប្រិយភាព ឲ្យ ល្បី លេចធ្លោ ។
ប៉ូលិស កំពុង តែ ស៊ើប នៅ ក្នុង ករណី នេះ ។
មិន បាន ឆ្លុះ បញ្ចាំង ពី គំនិត និង ទស្សនៈ របស់ សារព័ត៌មាន តោះ អាន នោះ ទេ ។
ម្នាល សេ្តច កាឡ កណ្ណី ព្រះអង្គ ធា្លប់ ឃើញ អ្នកណា ដែល សម្លាប់ បុត្រ ភរិយា និង សេដ្ឋី គហបតី ជា អ្នក មិន ប្រទូស្ត ព្រោះ ប្រាថ្នា ឋានសួគ៌ ។
ស្រឡាញ់ ពិបាក បំភ្លេច ជាង ស្អប់ - ទំព័រ ដួង ចិត្ត កវី
ដូច ខាងក្រោម នេះ ដែល ធ្វើឱ្យ ពួកគេ មាន អាយុ វែង ។
គ្ឺរម័យកាល រនាះ ពួ ក្មនុរស ពាល រុច រច ត្ ិ ទាំង រំព័រ រលវ
ឧទាហរណ៍ ជំនាន់ ប៉ុល ពត គាត់ បាត ដៃ ប្រឡាក់ ឈាម ហើយ
នឹង អ្នក ដែល កំពុង ត្រូវការ ការជួយ ជាបន្ទាន់ ។
ធ្លាប់ មាន អារម្មណ៍ ធុញ ថប់ នឹង រឿង រ៉ាវ ជា ច្រើន ស្មុគស្មាញ នៅ ភ្នំពេញ ទេ ?
ហើយ វា មិន មាន បញ្ហា ទេ ប្រសិនបើ វា មកពី កសិដ្ឋាន ឬ ចាប់ បាន នៅក្នុង ព្រៃ ។
ជា អ្នកកាង បង្កប់ ឲ្យ បើក ល្បែង ទាំងនេះ ។
ពួក ខ្ញុំ បាត់ មិត្ត ភ័ ក្គ ម្នាក់ ដែល កំពុង មុជទឹក ជាមួយ គ្នា ។
អ្នក មិន បាន ឃើញ ខិត្តប័ណ្ណ បែប សិល្បៈ តាម ផ្លូវ បែប នេះ ទេ ឬ ក៏ កម្មវិធី ជាច្រើន ។
ប៉ុន្តែ ធ្លាប់ មាន របាយការណ៍ មួយចំនួន និយាយ អំពី ការស្លាប់ ក្នុង សុបិន្ត ។
មាត់ រឺ ប្រមាថ មាក់ងាយ លោក ហ៊ុន សែន ក៏ នៅតែ អាច ជា បណ្តាញ ចារកម្ម របស់ គាត់ ដែរ ។
ត្រូវតែ យក អគ្គ មហេសី នេះ ទៅ ឲ្យ បាន ក្នុង ពេលនេះ ។
យើង នឹង ធ្វើ ការវាយតម្លៃ ជា ស្ថាពរ មួយ ។
វា ធ្លាក់ ចូល ក្នុង នោះ ។
សូម ចុច ទស្សនា វីដេអូ ដូច ខាងក្រោម ៖
សុវត្ថិភាព - ប្លក់ ផ្ទាល់ខ្លួន
ជាទូទៅ គ្រប់ អាហារ ដែល ទទួលទាន តិច ឬ ច្រើន សុទ្ធតែ ជះ ឥទ្ធិពល លើ ផ្នែក ផ្សេង ៗ
ប្រសិនបើ លោក សម្រេច គោលដៅ របស់ លោក លោក នឹង ក្លាយ ជា មនុស្ស ក្មេង បំផុត ដែល បាន ទៅ ទស្សនា តំបន់ ចំនួន ៤១១ និង ជា មនុស្ស តែ ម្នាក់ គត់ ដែល បាន ធ្វើ ដំណើរ កម្សាន្ត នេះ នៅ ក្នុង ដំណើរ កម្សាន្ត ជាប់ ៗ
ប្រសិនបើ អ្នក ស្ថិត ក្នុង ស្ថានភាព ដូច ខាង ក្រោម សូម អ្នក ឈប់ ស៊ូទ្រាំ ត ទៅ ទៀត !
ខ្ញុំ បាន រកឃើញ ថា ប្រសិនបើ ខ្ញុំ មិន រៀបចំ ជីវិត ខ្ញុំ ប្រកបដោយ យុទ្ធសាស្ត្រ ក្នុង ការ ចំណាយ ពេលវេលា ជាមួយនឹង គ្រួសារ របស់ ខ្ញុំ នោះ ទេ វា នឹង មិន កើត ឡើង ឡើយ ៕
ស្រប ពេល គ្នា នេះ ដែរ លោក ក៏ អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ កុំ ឲ្យ ចាប់ អារម្មណ៍ នឹង បញ្ហា នេះ និង ត្រូវ គេ ច ចេញ ឲ្យ ឆ្ងាយ ពី ក្បួន បាតុកម្ម ហើយ ងាក មក យក ចិត្ត ទុក ដាក់ ការពារ ទ្រព្យ សម្បត្តិ របស់ ខ្លួន ប្រសើរ ជាង ។
ទាក់ទង នឹង ការ រៀបចំ រដ្ឋសភា និង រាជ រដ្ឋាភិបាល រហូត ដល់ ទៅ ចំនួន ៦ លើក ក្នុង រយៈពេល តែ ត្រឹម ១២ ឆ្នាំ ។
ប៉ុន្តែ នៅ លើក នេះ ទៀត ព្រះអម្ចាស់ ឆ្លើយ ត ប នឹង ពាក្យ ទូល អង្វរ របស់ ខ្ញុំ ។
កម្រិត នៃ ការប្រុងប្រយ័ត្ន ក៏ ត្រូវ បាន គេ បង្កើន ឡើង ដូចគ្នា " ។
តើ មាន អ្វី ផ្លាស់ប្ដូរ ខ្លះ សម្រាប់ សេដ្ឋកិច្ច សាកល ទាំងមូល ក្នុង រយៈពេល ១០ឆ្នាំ ចុងក្រោយ នេះ ?
ចូរ លើក យក បញ្ហា មក ពិភាក្សា ជាមួយ ដៃគូ របស់ អ្នក ។
បើសិនជា លោក មាន គំនិត ឆ្កួត ៗ
លោក អ្នក នាង នឹង បាន ស្ដាប់ សេចក្ដី រាយការណ៍ អំពី រឿង នេះ នៅ ពេល ក្រោយ ៕
យ៉ាង យូរ មួយ សប្តាហ៍ ទៀត ពលរដ្ឋ កោះ កុង អាច នឹង មាន ទឹក សាប ប្រើប្រាស់ វិញ
រដ្ឋាភិបាល ឥណ្ឌា ត្រូវ គេ រំពឹង ថា នឹង ធ្វើ សច ក្តី សម្រេច នៅ ក្នុង សប្តាហ៍ នេះ ។
ប៉ុន្តែ នេះ គ្រាន់ តែ ជា ទស្សន ផ្ទាល់ ខ្លួន របស់ លោក ប៉ុណ្ណោះ យ៉ាង ណា ការ ប្រកួត មក ដល់ ទើប ដឹង ។
ទោះបីជា មាន ការបកស្រាយ ហើយ ក្តី
នៅ ក្នុង កម្មវិធី ជា ច្រើន ៕
នៅ ក្នុង អំឡុង ពេល នោះ អាញ់ ស្តាញ់ មាន ភាព ប្រាកដ ក្នុង ចិត្ត ថា តាមរយៈ ទ្រឹស្តី ដែល លោក បាន រកឃើញ លោក ប្រាកដ ជា នឹង ទទួល ពានរង្វាន់ ណូបែល ។
អនុវត្ត ម្ដង ឬ ២ ដង ក្នុង មួយ សប្តាហ៍ គឺ គ្រប់គ្រាន់ ហើយ ។
រំពេច នោះ ខ្សែ ភ្នែក របស់ គេ ប្រទាក់ នឹង ខ្សែ ភ្នែក របស់ ខ្ញុំ ដោយ ចៃ ដន្យ ម្តង ទៀត ។
ឈ្នះ អ្វី គ្រប់ យ៉ាង ដោយ ចាប់ផ្តើម ពី ការយក ឈ្នះ ខ្លួន ឯង
ស្ត្រី ជាច្រើន មិន បាន ដឹង ថា ពួក នាង មាន ផ្ទៃពោះ ឡើយ ។
ពួក គេ មិន បាន ធ្វើ អ្វី សោះ ក្នុង ការ បង្កើត ទំនាក់ទំនង ដែល ខ្ញុំ មាន ជា មួយ អ្នក គាំទ្រ ។
ខ្ញុំ ដឹង ថា ជញ្ជាំង ព្រំដែន គឺ ជា រូបភាព ដ៏ អាក្រក់ ។
ដោយសារ សមត្ថកិច្ច ថៃ បាន អនុញ្ញាត អោយ ចូល ៕
ជាមួយ អាមេរិក នេះ គ្រាន់តែ ចោទ ជា សម្ដី ក្រៅ ផ្លូវការ ទេ " ។
កំហុស ប្រមាថ ព្រះមហាក្សត្រ ដោយ សា តែ ភ្លា ត់ មាត់
សន្តិភាព និង ស្ថិរភាព បាន ជំរុញ ឲ្យ មាន ភាព ចម្រុង ចម្រើន សម្រាប់ ប្រជាពលរដ្ឋ រាប់ ពាន់ លាន នាក់ អស់ រយៈពេល ជា ច្រើន ទសវត្សរ៍ កន្លង មក នេះ ហើយ យើង នឹង ធ្វើ ការ រួម គ្នា ដើម្បី ធានា ថា យើង អាច រក្សា សន្តិភាព និង ស្ថិរភាព ទាំង នេះ បាន " ។
ដែល ធ្វើ ប៉ះពាល់ ដល់ ស្ថាប័ន នគរបាល ជាតិ ។
មាន ន័យ ថា សម្បក កាយ របស់ វា ត្រូវ បាន រៀបចំ ល្អ ឥត ខ្ចោះ សម្រាប់ អ្នក ដំណើរការ អង្គុយ ។
ភ្ញៀវ ទេសចរ សុំ ឲ្យ សហគមន៍ បុរី អូរ ស្វាយ ពង្រឹង គុណភាព វិស័យ ទេសចរ ណ៍
កំពុង ឃ្លាន ស្រាប់ អ្ហេ !
ដុស សម្អាត ផ្ទៃ ខាងក្នុង និង ខាងក្រៅ នៃ ធ្មេញ របស់ អ្នក ។
ដើម្បី ធានា ថា អគារ សិក្សា និង ទ្រព្យសម្បត្តិ របស់ ក្រុមហ៊ុន មាន សុវត្ថិភាព ២៤ ម៉ោង និង ៧ ថ្ងៃ ក្នុង មួយ សប្តាហ៍ យើង មាន បុគ្គលិក ស្នាក់ នៅ សាលា ប្រចាំ ការ នៅ គ្រប់ អគារ ។
២៤ លោក ម៉ូសេ ចាក ចេញ ពី ព្រះពន្លា ហើយ នាំ ព្រះបន្ទូល របស់ ព្រះអម្ចាស់ ទៅ ប្រាប់ ប្រជាជន ។
គាត់ ជា ប្រធាន ចលនា និស្សិត នៅ ពេល គាត់ ជា និស្សិត ។
ប្រទេស រុស្ស៊ី ក៏ បាន បដិសេធ ការចោទប្រកាន់ នេះ ផងដែរ នៅពេល នោះ ។
៣ គួរ ឲ្យ គេ សរសើរ ព្រះនាម ទ្រង់ ដោយ លោត កញ្ឆេង
ខ្ញុំ ក៏ ក្រោក ឈរ ឡើង យ៉ាង រហ័ស បំផុត រួច ឆ្លើយ នឹង អ្នក គ្រូ ថា៖
ដែល ធ្វើ អាជីវកម្ម នៅ ទី នោះ ។
ញ បាន ឃុបឃិត ជាមួយ អាជា
ចំពោះ ព្រះ អង្គម្ចាស់ នរោត្តម រណ ឬទ្ធិ វិញ ក៍ ធ្លាប់ មាន បន្ទូល នា ពេល ថ្មី ៗ
ម្នាល ភិក្ខុ ទាំង ឡាយ បុគ្គល ៣ពួក នេះ ឈ្មោះ ថា មាន ឧបការៈ ច្រើន ដល់ បុគ្គល ។
លោក ដឹង ហើយ ថា មនុស្ស មាន ការ ភ័យ ខ្លាច គ្រប់ ប្រភេទ ដូច្នេះ ខ្ញុំ ប្រាកដ ជា មិន អាច និយាយ អំពី បញ្ហា នេះ ទេ ។
នេះ ហើយ គឺជា បញ្ហា ដែល ក្រុម គ្រួសារ ជា ច្រើន តែងតែ ជួប ប្រទះ ។
សុំឲ្យ សម រង្ស៊ី ចេញមុខ មក បកស្រាយ ពី រឿង ស្អី ទៅ ហ្គាដាហ្វ៊ី នោះ ចង់ និយាយ យ៉ាងម៉េច ?
ដែល ខ្ញុំ ចង់ ឃើញ នៅ ក្នុង ភាពយន្ត ឯកសារ នោះ ។
កម្ពុជា គ្រប់ ជំនាន់ ធ្វើអោយ បែកបាក់ គ្នា មក ទល់ សព្វ ថ្ងៃ នេះ !
តាំងពី ពេល នោះ មក
អ្នក វិនិយោគ ភាគហ៊ុន ចាំបាច់ ត្រូវ ប្រយ័ត្នប្រយែង ។
ក្រោយ ពី ពួក គេ មាន ឯកសារ គ្រប់គ្រាន់ ហើយ នោះ ពួក គេ នឹង អាច ចុះ ឈ្មោះ សុំ សិទ្ធិ ជា ម្ចាស់ ស្រប ច្បាប់ នៅ មន្ទីរ ស្រុក ។
ខ្ញុំ មិន ដែល ស្គាល់ គាត់ ផង មិន ដឹង ថា មុខ អ្នកស្រី ឈិន សុគន្ធារី ដែល ប្តឹង ខ្ញុំ នោះ មុខ យ៉ាងម៉េច ផង ។
