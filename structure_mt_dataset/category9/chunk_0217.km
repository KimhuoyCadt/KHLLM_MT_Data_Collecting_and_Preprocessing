លោក ប៉ែន ប៊ុណ្ណា មន្ត្រី កម្មវិធី ពង្រឹង សិទ្ធិ អំណាច សហគមន៍ មូលដ្ឋាន នៃ សមាគម ការពារ សិទ្ធិ មនុស្ស អាដហុក បាន ថ្លែង ថា មនុស្ស ភាគ ច្រើន រួមទាំង រូបលោក មិន ពេញចិត្ត នឹង ការស៊ើបអង្កេត របស់ ACU ទេ ។
លោក ប៊ុណ្ណា មានប្រសាសន៍ ថា រស្មី បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការកាប់បំផ្លាញ ព្រៃឈើ ក្នុង ខេត្ត រតនគិរី តាំងពី ឆ្នាំ ២០១០ មក ។ លោក អះអាង ថា រយៈពេល ១០ ថ្ងៃ ក្នុង ខេត្ត នេះ មាន រថយន្ត ប្រមាណ ២៦០ គ្រឿង ត្រូវបាន អនុញ្ញាតឲ្យដឹកជញ្ជូន ឈើ ១០០ តោន ទៅ ប្រទេស វៀតណាម ដោយ គិត កម្រៃ ២៣.០០០ ដុល្លារ ក្នុង មួយ ឡាន ។ .
លោក ប៊ុណ្ណា អះអាង ថា ការស្វែងរក ភស្តុតាង នៃ អំពើពុករលួយ និង ការជាប់ពាក់ព័ន្ធ បទល្មើស ព្រៃឈើ របស់ រស្មី មិន ពិបាក ទេ ព្រោះ មាន សាក្សី ជាច្រើន អាច ផ្តល់ សក្ខីកម្ម បាន ។
លោក មានប្រសាសន៍ ថា វា មិន ពិបាក ទេ ព្រោះ មាន អ្នកសារព័ត៌មាន ជាច្រើន ដែល ធ្វើ ការ លើ បញ្ហា នេះ ហើយ អាច ផ្តល់ សក្ខីកម្ម និង ជួប ជាមួយ ACU ដើម្បី ជួយ ស្វែងរក តម្រុយ និង ភស្តុតាង ដើម្បី គាំទ្រ ការចោទប្រកាន់ លើ រស្មី និង អ្នកដទៃ ។
លោក ព្រាប កុល នាយក ប្រតិបត្តិ នៃ អង្គការ តម្លាភាព កម្ពុជា មានប្រសាសន៍ ថា ការផ្តល់ សែក គ្មាន តម្លៃ ដល់ កូន ខ្លួន ឯង ក្នុង ពិធី ខួបកំណើត គឺជា រឿង ចម្លែក និង ពិបាក នឹង ជឿ ។
បើ តាម លោក យ៉ិនទៀង អង្គភាព ប្រឆាំង អំពើពុករលួយ នៅតែ ស៊ើបអង្កេត រស្មី ជុំវិញ ការចោទប្រកាន់ ថា ទទួល សំណូក ពី លោក ហួយ ជីវៃ ជនល្មើស ដែល ត្រូវបាន គេ ស្គាល់ ថា ប្រព្រឹត្ត បទល្មើស ព្រៃឈើ ។
ចំពោះ បទល្មើស ព្រៃឈើ ការស៊ើបអង្កេត របស់ យើង គឺ ផ្តោត ទៅ លើ លោក ហួរ ជីវ៉ា ដែល អ្នកកាសែត បាន អះអាង ថា គឺជា មេក្លោង នៅ ពីក្រោយ បទល្មើស ព្រៃឈើ ហើយ អាច សង ប្រាក់ មន្ត្រី ណា ម្នាក់ បាន ។ នៅពេល យើង សួរ រស្មី គាត់ អះអាង ថា ជីវ៉ា ជា អ្នកក្រ ហើយ គ្មាន លុយ ។
ប៉ុន្តែ លោក យ៉ិនទៀង ថា ដូច រស្មី ដែរ នេះ ជា ឧទាហរណ៍ មួយ ទៀត នៃ ការបង្ហាញ ទ្រព្យសម្បត្តិ ដោយ ឥត ប្រយោជន៍ និង បំភាន់ ជាជាង អំពើពុករលួយ ។
នាឡិកា របស់ គាត់ ក្លែងក្លាយ និង គ្មាន តម្លៃ ចំណែក រថយន្ត ជា របស់ អ្នក ផ្សេង ។ គាត់ បាន យក រូបភាព ឡាន មក បង្ហោះ ដែល បង្កើត ការយល់ ច្រឡំ ។ គាត់ គ្រាន់តែ ថត រូប ដើម្បី បង្ហាញ ។ នៅពេល សួរ អំពី នាឡិកា ពេជ្រ លោក សុខា ឆ្លើយ ថា វា ក្លែងក្លាយ ហើយ តម្លៃ ត្រឹមតែ ២៥ ដុល្លារ ប៉ុណ្ណោះ ។
នគរបាល ខេត្ត ព្រៃវែង កំពុង បន្ត សាកសួរ ជនជាតិ វៀតណាម ៥នាក់ ក្នុង ចំណោម ៦នាក់ កាលពី ថ្ងៃអាទិត្យ បន្ទាប់ពី ពួកគេ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង ការបង្រ្កាប កាលពី ថ្ងៃសុក្រ ដែល ប៉ូលិស បាន បាញ់ ជិត ៣០ គ្រាប់ ដើម្បី បញ្ឈប់ ប្រតិបត្តិការ នេសាទ ខុស ច្បាប់ តាម ដងទន្លេ មេគង្គ ។
ហេតុការណ៍ នេះ កើតឡើង នៅ ឃុំ ស្វាយ ផ្លុស ស្រុក ពាម ជរ ឃើញ ជនសង្ស័យ ម្នាក់ ត្រូវ គ្រាប់ ចំកំភួនជើង ដែល ប៉ូលិស និយាយ ថា បាន ស្ទុះ មក ច្រាំង ទន្លេ ។
ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រៃវែង លោក អ៊ុក សំណាង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃអាទិត្យ ថា អាជ្ញាធរ របស់ លោក កំពុង សាកសួរ ជនសង្ស័យ ចំនួន ៥នាក់ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រៃវែង ពាក់ព័ន្ធ នឹង សកម្មភាព នេសាទ ខុស ច្បាប់ ។
លោក ថា ជនសង្ស័យ ទី៦ កំពុង ទទួល ការព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ។
លោក សំណាង បាន និយាយ ថា លោក មិន ដឹង ថា ពេលណា ប៉ូលិស នឹង បញ្ជូន ជនសង្ស័យ ទៅ សាលាដំបូង ខេត្ត ទេ ។
លោក បាន បន្ត ថា នៅ យប់ ថ្ងៃសុក្រ កម្លាំង ចម្រុះ ខេត្ត កំពុង ចុះបង្ក្រាប ការ នេសាទ ខុស ច្បាប់ ក្នុង តំបន់ ការពារ ។ លោក បន្ត ថា ក្នុង ប្រតិបត្តិការ នេះ សមត្ថកិច្ច បាន បាញ់ ចំនួន ២៧ គ្រាប់ បណ្ដាលឲ្យ ជនសង្ស័យ ម្នាក់ ក្នុង ចំណោម ៦នាក់ រងរបួស ត្រង់ កំភួនជើង ។
លោក សំណាង បន្ត ថា ស្នងការ រង នគរបាល ខេត្ត ព្រៃវែង លោក កែវ រ៉េត មុនី បាន ដឹកនាំ ប្រតិបត្តិការ នេះ ដោយ សហការ ជាមួយ នគរបាល ឃុំ ស្វាយ ផ្លុស ។
ក្រុមការងារ របស់ ខ្ញុំ មិន បាន ចូលរួម ក្នុង ប្រតិបត្តិការ ជាក់ស្តែង ទេ ។ ប៉ុន្តែ ជនសង្ស័យ កំពុង ឃាត់ខ្លួន នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រៃវែង ហើយ ក្រុម ជំនាញ និង ប៉ូលិស កំពុង សាកសួរ ពួកគេ ។
លោក សំណាង បាន និយាយ ថា ជនសង្ស័យ ទាំង៦ នាក់ បាន ជិះ ទូក នេសាទ ចំនួន៣ គ្រឿង ពេល ប៉ូលីស សុំ ឈប់ ដើម្បី សួរនាំ ប៉ុន្តែ ជនសង្ស័យ មិន ព្រម ហើយ បែរជា ព្យាយាម កាច់ ចង្កូត ទូក ចូល ទូក ប៉ូលីស ទៅ វិញ ។
លោក បាន បន្ត ថា ប៉ូលិស ដែល ជិះ ម៉ូតូ ពីរ គ្រឿង បាន បាញ់ ទៅ លើ ជនសង្ស័យ មុនពេល ពួកគេ អាច ស្ទាក់ ចាប់ ទូក នេសាទ ខុស ច្បាប់ និង ចាប់ខ្លួន ជនសង្ស័យ ទាំង ៦ នាក់ ។
ទាំង ស្នងការ នគរបាល ខេត្ត ព្រៃវែង លោក ព្រំ សន្ធរ និង លោក រ៉េត មុនី ដែល ដឹកនាំ ប្រតិបត្តិការ នោះ មិន អាច ទាក់ទង សុំ ការអត្ថាធិប្បាយ បាន ទេ នៅ ថ្ងៃអាទិត្យ ។
លោក បញ្ជាក់ ថា ជនសង្ស័យ របួស ជើង ខាងស្តាំ ត្រូវបាន បញ្ជូន ទៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រៃវែង ។
នៅ ពេល ដែល ទូក នេសាទ ឃើញ ប៉ូលីស តាម ពីក្រោយ ពួកគេ បាន ព្យាយាម រត់គេចខ្លួន ដោយ បុក ទូក ប៉ូលីស ។ ពេល សមត្ថកិច្ច ឃើញ ដូច្នេះ ក៏ បាញ់ គ្រាប់ កាំភ្លើង បាញ់ ឡើង លើ ដី ភក់ ប៉ុន្តែ គ្រាប់ កាំភ្លើង មួយ គ្រាប់ បាន ស្ទុះ មក វាយ ជនសង្ស័យ ម្នាក់ ចំកំភួនជើង ខាងស្ដាំ បណ្ដាលឲ្យ រងរបួស ។
លោក បន្ត ថា កាលពី ឆ្នាំ ២០១៧ មន្ត្រី របស់ លោក ម្នាក់ ត្រូវបាន សម្លាប់ ក្នុង ពេល ចុះបង្ក្រាប ការ នេសាទ ខុស ច្បាប់ ។
លោក បន្ត ថា សកម្មភាព នេះ ធ្វើឡើង បន្ទាប់ពី អ្នកភូមិ ដាក់ ពាក្យបណ្ដឹង សុំ អន្តរាគមន៍ ពី លោក ពេជ្រ ជីវ័ន នាយ រង ក្រុមការងារ ដើម្បី បង្ក្រាប អ្នក ដែល ប្រើ ឧបករណ៍ នេសាទ ហាមឃាត់ នៅ ស្រុក ពាម ជរ ខេត្ត ព្រៃវែង ។
រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ លោក ស ខេង បាន កំណត់ ការ ពង្រឹង សន្តិសុខ ស្តារ ហេដ្ឋារចនាសម្ព័ន្ធ ការត្រួតពិនិត្យ ស្តង់ដារ សំណង់ ការទប់ស្កាត់ ការបញ្ចេញ ទឹក ស្អុយ ទៅក្នុង សមុទ្រ និង ការដោះស្រាយ វិវាទ ដីធ្លី ជា បញ្ហា សំខាន់ ដែល កំពុង បន្ត ក្នុង ខេត្ត ព្រះសីហនុ ។
កាលពី ថ្ងៃសៅរ៍ លោក បាន ជំរុញ ឲ្យ ក្រសួង ពាក់ព័ន្ធ និង អភិបាល ខេត្ត ទើបតែងតាំង ថ្មី សហការ គ្នា រក ដំណោះស្រាយ ។
ថ្លែង ក្នុង ពិធី ចូលកាន់ តំណែង អភិបាល ខេត្ត ថ្មី លោក គួច ចំរើន លោក ស ខេង ឧប នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា វិវាទ ដីធ្លី នៅតែ បន្ត ជា បញ្ហា ហើយ បញ្ហា ត្រូវ ដោះស្រាយ ដោយ មិន ប្រើ អំពើហិង្សា ។
ពាក់ព័ន្ធ នឹង ស្តង់ដារ សំណង់ លោក ស ខេង បាន មានប្រសាសន៍ ថា សុវត្ថិភាព គុណភាព និង ស្តង់ដារ បច្ចេកទេស នៅ កន្លែង សំណង់ និង អាជីវកម្ម ដែល កំពុង ដំណើរការ នឹង ត្រូវ ត្រួតពិនិត្យ បន្ទាប់ពី មាន ការដួលរលំអគារ នា ពេល ថ្មី ៗ នេះ ដែល បាន សម្លាប់ មនុស្ស ២៨ នាក់ និង របួស ២៦ នាក់ ផ្សេង ទៀត ។
លោក បាន បន្ត ថា៖ ត្រូវតែ យកចិត្តទុកដាក់ ជាពិសេស ហើយ បញ្ហា សុវត្ថិភាព អគារ និង ភ្លើង ត្រូវ ពិនិត្យ ។
ដើម្បី ធានា សុវត្ថិភាព ភ្ញៀវ ទេសចរ លោក ស ខេង ថ្លែង ថា អាជ្ញាធរ ត្រូវ ពង្រឹង វិធានការ សន្តិសុខ របស់ ខ្លួន ។ គួរ ដាក់ កម្លាំង ប៉ូលិស ការពារ កោះ រួម ជាមួយ អង្គភាព បម្រុង ដែល អាច ជួយ អន្តរាគមន៍ បាន រហ័ស ពេល មាន ឧបទ្ទវហេតុ កើតឡើង ។
ទាក់ទិន នឹង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ លោក ថា ដោយសារ ខេត្ត មាន ការអភិវឌ្ឍន៍ លឿន ហើយ ផ្លូវ ជាច្រើន នៅ តូច ចង្អៀត ទីតាំង ខ្លះ រង ការខូចខាត ។ ទោះ យ៉ាងណា លោក ថា បញ្ហា នេះ បច្ចុប្បន្ន កំពុង ត្រូវបាន រដ្ឋាភិបាល ថ្នាក់ ជាតិ ពិចារណា ។
ការដោះស្រាយ បញ្ហា ទឹក ស្អុយ នេះ លោក ស ខេង មានប្រសាសន៍ ថា ក្រសួង ពាក់ព័ន្ធ រួមទាំង ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ។ សាធារណការ និង ដឹកជញ្ជូន ; បរិស្ថាន ; និង ធនធាន ទឹក និង ឧតុនិយម នឹង ធ្វើ ការរួមគ្នា ដើម្បី ដោះស្រាយ បញ្ហា នេះ ។
ការការពារ ទឹក តាម ឆ្នេរសមុទ្រ របស់ យើង គឺជា កិច្ចការ ដំបូង និង សំខាន់ បំផុត ។ បើ ការប្រយុទ្ធ នេះ ត្រូវ ចាញ់ នោះ នឹង គ្មាន ការវិនិយោគ ឬ អ្នកទេសចរ ទៀត ទេ ។ យើង ទាំងអស់ គ្នា ត្រូវតែ ចែករំលែក វិធីសាស្រ្ត ដូចគ្នា ហើយ រួបរួម គ្នា ក្នុង ការងារ របស់ យើង
មិន មែន ការវិនិយោគ ទាំងអស់ សុទ្ធតែ ល្អ នោះ ទេ ។ អ្នក វិនិយោគ ខ្លះ ធ្វើ មិន បាន ត្រឹមត្រូវ ដូច្នេះ យើង ស្វាគមន៍ អ្នក វិនិយោគ ល្អ និង ភ្ញៀវ ទេសចរ ដែល គោរព ច្បាប់ កម្ពុជា ។
លោក ស ខេង ក៏ បាន ដាក់ចេញ នូវ ផែនការ ពង្រឹង សន្តិសុខ និង សណ្តាប់ធ្នាប់ ក្នុង ខេត្ត ផងដែរ ។
លោក បាន សង្កត់ធ្ងន់ លើ វិធានការ ដំបូង ដើម្បី ជំរុញ ការផ្សព្វផ្សាយ អប់រំ ទូលំទូលាយ ដល់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដើម្បី បង្កើន ការយល់ដឹង អំពី ច្បាប់ និង បទប្បញ្ញត្តិ និង ធានា សន្តិសុខ និង សណ្តាប់ធ្នាប់ សម្រាប់ ការវិនិយោគ អាជីវកម្ម និង ទេសចរណ៍ ។
លោក ស្នើឲ្យ មាន វិធានការ ពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ទប់ស្កាត់ រាល់ ទម្រង់ បទល្មើស ជាតិ និង ឆ្លង ដែន ដើម្បី បង្កើត បរិយាកាស សន្តិភាព ក្នុង ខេត្ត ។
លោក ចំរើន អភិបាល ខេត្ត ថ្មី បាន ប្តេជ្ញា ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ភារកិច្ច លើក កំពស់ ការអភិវឌ្ឍន៍ ខេត្ត ។
លោក បាន ថ្លែង ថា៖ ដើម្បី ឆ្លើយតប នឹង ការគាំទ្រ និង ជំនឿ ដែល បាន ប្រគល់ មក លើ ខ្ញុំ ខ្ញុំ ប្តេជ្ញា គោរព យ៉ាង ម៉ឺងម៉ាត់ ចំពោះ រដ្ឋធម្មនុញ្ញ ច្បាប់ និង ការណែនាំ របស់ រដ្ឋាភិបាល ។
លោក ចំរើន មានប្រសាសន៍ ថា លោក នឹង ខិតខំ ផ្តល់ ការដឹកនាំ ប្រកបដោយ គោលការណ៍ និង តម្លាភាព ក្នុង ការបំពេញ ភារកិច្ច ដឹកនាំ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
លោក បាន មានប្រសាសន៍ ថា ខ្ញុំ បន្ត ខិតខំ ប្រឹងប្រែង លុបបំបាត់ ភាព អសកម្ម ណាមួយ ដែល ប៉ះពាល់ ដល់ ប្រជាពលរដ្ឋ ខេត្ត និង លើកកម្ពស់ ជីវភាព និង កាត់បន្ថយ ភាពក្រីក្រស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ជាពិសេស ការណែនាំ របស់ សម្តេច តេជោ ដើម្បី អនុវត្ត ច្បាប់ ដោយ គ្មាន ករណី លើកលែង ។ .
នាយក អង្គការ ស្រាវជ្រាវ ជាតិ កម្ពុជា លោក សុខ សុខុម មានប្រសាសន៍ ថា លោក ស ខេង ទាមទារ ឱ្យ ថ្នាក់ដឹកនាំ ខេត្ត ព្រះសីហនុ ទាំងមូល រួបរួម គ្នា ដោះស្រាយ បញ្ហា បន្ទាន់ និង ទទួលបាន លទ្ធផល ល្អ ប្រសើរ ។
គ្មាន មេដឹកនាំ ណា ម្នាក់ ចង់ឱ្យ គ្រោះថ្នាក់ កើតឡើង នោះ ទេ ។ ប៉ុន្តែ ដើម្បី បញ្ចៀស ករណី បែប នេះ ថ្នាក់ដឹកនាំ ខេត្ត ត្រូវ អនុវត្ត នីតិវិធី ច្បាប់ ឲ្យបាន ត្រឹមត្រូវ និង ត្រឹមត្រូវ ។ ដូច្នេះ គិត រួមគ្នា ធ្វើ ការរួមគ្នា ដោះស្រាយ បញ្ហា រួមគ្នា ដើម្បី ប្រយោជន៍ ខេត្ត ។
