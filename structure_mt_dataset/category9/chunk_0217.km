ប្រសិនបើ កិច្ចសហប្រតិបត្តិការ របស់ ចិន ជាមួយ កម្ពុជា មិន ធ្វើឱ្យ ព្រះរាជាណាចក្រ កម្ពុជា ប្រសើរឡើង ទេ វា នឹង មិន ក្លាយជា គំរូ សម្រាប់ ប្រទេស ដទៃ ឡើយ ។
សាលាដំបូង រាជធានី ភ្នំពេញ កាលពី ថ្ងៃពុធ បាន បញ្ចប់ សំណុំរឿង រដ្ឋប្បវេណី ប្រឆាំង នឹង លោក រ័ត្ន រត្ន មុនី ជុំវិញ ការថត ភាពយន្ត ឯកសារ RT ដ៏ ចម្រូងចម្រាស ថា ម៉ែ ខ្ញុំ លក់ ខ្ញុំ ។
កាលពី ដើម សប្តាហ៍ នេះ RT ដែល ជា បណ្តាញ ទូរទស្សន៍ ដែល ផ្តល់ មូលនិធិ ដោយ រដ្ឋាភិបាល រុស្ស៊ី ដែល ផលិតភាពយន្ត ឯកសារ ស្តីពី ការចោទប្រកាន់ ថា បាន លក់ ព្រហ្មចារីយ៍ របស់ នារី វ័យ ក្មេង នោះ បាន សរសេរ សំបុត្រ មួយ ច្បាប់ ទៅកាន់ ស្ថានទូត កម្ពុជា នៅ ទីក្រុង មូស្គូ ដោយ សម្តែង ការព្រួយបារម្ភ អំពី ការឃុំ ខ្លួន លោក រ័ត្ន មុន្នី ។
សវនាការ របស់ សាលាដំបូង រាជធានី ភ្នំពេញ ដែល មាន លោក ចៅក្រម កុយ សៅ និង ព្រះរាជអាជ្ញា រង វង្ស ប៊ុន វិសុទ្ធ បាន ស្តាប់ ឮ ពី ដើម បណ្តឹង ទេព សាលីន និង កូនស្រី លឹម ស្រី ធី ថា រ័ត្ន មុន្នី បាន ប្រាប់ ពួកគេ ថា លោក នឹង ជួយ រាជធានី ក្នុង ការបង្កើត ហាង អ៊ុត សក់ និង ហាង បោក អ៊ុត ។ .
លោក ថា ភាពយន្ត នេះ នឹង មិន ត្រូវបាន ដាក់បញ្ចាំង នៅ កម្ពុជា ទេ ។ RT នឹង ចាក់ផ្សាយ នៅ ក្រៅ ប្រទេស ហើយ ប្រសិនបើ វា ទទួលបាន ជោគជ័យ ពួកគេ នឹង ជួយ នាង ដោយ លុយកាក់ នោះ រ័ត្ន មុន្នី ត្រូវបាន គេ ចោទ ថា បាន និយាយ ។
ប្រសិនបើ ខ្ញុំ ដឹង រឿង នេះ កូនស្រី ខ្ញុំ និង ខ្ញុំ នឹង មិន ពាក់ព័ន្ធ ទេ ។ ទោះ ក្រ ក៏ដោយ ខ្ញុំ មិន លក់ កូនស្រី ខ្ញុំ ទេ ហើយ ខ្ញុំ ទារ សំណង ជំងឺ ចិត្ត ១០ម៉ឺន ដុល្លារ ។
ស្រី ធី បាន ប្រាប់ ចៅក្រម ថា នាង បាន ស្ម័គ្រចិត្ត ធ្វើ សកម្មភាព នៅក្នុង ក្រុមហ៊ុន ដោយសារតែ រ័ត្ន មុន្នី ប្រាប់ នាង ថា វា និយាយ អំពី ជីវិត គ្រួសារ ក្រីក្រ នៅ កម្ពុជា ។
លោក សំ ទិត្យ សីហា និង លោក ឡោ ឈុន ធី មេធាវី ការពារ ក្តី របស់ លោក រ័ត្ន មុនី បាន ប្រកែក ថា កូនក្តី របស់ ពួកគេ មិន បាន ណែនាំ នរណា ម្នាក់ ឱ្យ ប្រើ ពាក្យ ថា លក់ ខ្លួន នោះ ទេ ។ អ្នក ដែល ពាក់ព័ន្ធ ឆ្លើយ សំណួរ ទាំងអស់ ដោយ ស្ម័គ្រចិត្ត ។
លើស ពី នេះ ក្រុមការងារ ភាពយន្ត RT បាន ដាក់ លិខិត មួយ ច្បាប់ ទៅ ស្ថានទូត កម្ពុជា ប្រចាំ ប្រទេស រុស្ស៊ី ដោយ ប្រាប់ ថា រ័ត្ន មុន្នី ធ្វើការ ឱ្យ ពួកគេ ត្រឹមតែ ជា អ្នកបកប្រែ ប៉ុណ្ណោះ ។
មេធាវី ការពារ ក្តី លោក ឈុន ធី បាន ថ្លែង ថា៖ ដូច្នេះ ខ្ញុំ សុំឲ្យ តុលាការ ទម្លាក់ បទ ចោទ ដោយ ផ្អែក លើ មាត្រា ៤៩៦ នៃ ក្រម ព្រហ្មទណ្ឌ ។
លោក ព្រះរាជអាជ្ញា ប៊ុន វិសុទ្ធ មានប្រសាសន៍ ថា ផ្អែក លើស ក្ខីកម្ម របស់ ដើម បណ្តឹង ទាំង ប្រាំ នាក់ ភស្តុតាង និង របាយការណ៍ របស់ នគរបាល រ័ត្ន មុន្នី បាន ចូលរួម យ៉ាង ច្បាស់ ក្នុង ការផលិត ខ្សែភាពយន្ត នេះ និង ជា ផលិត ករ ក៏ ដូចជា អ្នកបកប្រែ ផងដែរ ។
ភាពយន្ត នេះ ធ្វើឲ្យ ខូច កេរ្តិ៍ឈ្មោះ កម្ពុជា ។ ដូច្នេះ ខ្ញុំ សូមឲ្យ តុលាការ យល់ស្រប នឹង ការចោទប្រកាន់ របស់ ចៅក្រម ស៊ើបសួរ ។
សាលក្រម នឹង ត្រូវ ប្រកាស នៅ ថ្ងៃទី ២៦ ខែមិថុនា ។
ភាពយន្ត ឯកសារ នេះ ត្រូវបាន កែសម្រួល នៅ ទីក្រុង មូស្គូ ក្នុង ខែសីហា និង ខែកញ្ញា ឆ្នាំ មុន ដោយ ក្រុម បុគ្គលិក RT តែ មួយ គត់ ។
លិខិត នោះ បាន បន្ថែម ថា ពួកគេ ចង់ បញ្ជាក់ ឱ្យ ច្បាស់ ថា ក្រុម នាវិក RT បាន ចុះហត្ថលេខា លើ លិខិត យល់ព្រម ពី តួអង្គ ស្រី សំខាន់ ៗ នីមួយ ៗ ទាក់ទង នឹង ការចូលរួម និង ការបង្ហាញ ខ្លួន របស់ ពួកគេ នៅក្នុង ខ្សែភាពយន្ត នេះ ។
សាលាដំបូង រាជធានី ភ្នំពេញ បាន កោះហៅ មន្ត្រី ការិយាល័យ រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ខេត្ត កណ្តាល និង បក្ខពួក ឲ្យ ចូល ខ្លួន សាកសួរ នៅ ថ្ងៃទី ១៣ - ១៤ ខែមិថុនា ជុំវិញ ការក្លែងឯកសារ ដីធ្លី ។
ដីកា កោះហៅ ដោយ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ លោក ងិន ពេជ្រ នៅ ដើម ខែ នេះ បាន ឲ្យដឹង ថា លោក នូ សាត ប្រធាន ការិយាល័យ រៀបចំ ដែនដី ខេត្ត កណ្តាល ត្រូវបាន ចោទប្រកាន់ ពី បទ ក្លែង បន្លំ ឯកសារ និង ផ្ទេរ ដី ជាង ៨០ ហិកតា របស់ ប្រជាពលរដ្ឋ ចំនួន ៤ គ្រួសារ នៅ ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ដោយ គ្មាន ពួកគេ ។ ការយល់ព្រម ។ សៅរ៍ ត្រូវ បង្ហាញ ខ្លួន នៅ តុលាការ នៅ ថ្ងៃព្រហស្បតិ៍ ។
តុលាការ ក៏ បាន កោះហៅ អ្នកសមគំនិត របស់ លោក សៅ គឺ លោក យ៉ែម រតនា ឲ្យ ចូល ខ្លួន ដើម្បី សាកសួរ នៅ ថ្ងៃសុក្រ ។ សំណុំរឿង នេះ ត្រូវ តុលាការ ក្រុង បើក សវនាការ ជំនុំជម្រះ ព្រោះ អ្នក ទាំង ពីរ មាន ទីលំនៅ ក្នុង រាជធានី ភ្នំពេញ ។
ដីកា កោះហៅ ថា៖ តុលាការ បង្គាប់ ឲ្យ អ្នក ទាំង ពីរ ចូល ខ្លួន ទៅ តុលាការ ក្រុង ភ្នំពេញ ពាក់ព័ន្ធ នឹង ការឃុបឃិត ក្នុង ការក្លែងឯកសារ និង លក់ អចលន ទ្រព្យ ដែល មិន មែន ជា កម្មសិទ្ធិ របស់ ពួកគេ ។
យោង តាម ពាក្យបណ្តឹង របស់ តុលាការ ប្រជាពលរដ្ឋ ទាំង បួន គ្រួសារ បាន ទិញ ដី នៅ ឃុំ អំពៅ ព្រៃ ស្រុក កណ្តាល ស្ទឹង ចន្លោះ ឆ្នាំ ២០០៧ ដល់ ២០១៨ ដោយ មាន ការទទួលស្គាល់ ពី អាជ្ញាធរ ឃុំ និង ភូមិ ។
កាលពី ខែវិច្ឆិកា ឆ្នាំ ២០១៥ ពាក្យបណ្តឹង បាន និយាយ ថា ឈ្មួញ ដី ម្នាក់ ឈ្មោះ នូ ភារម្យ បាន ផ្តិត មេដៃ ក្នុង ចេតនា ផ្ទេរ កម្មសិទ្ធិ លើ ដី ស្រែ របស់ ពួកគេ ទៅ ឱ្យ អ្នក ផ្សេង ។
ការក្លែងបន្លំ នេះ ត្រូវបាន គេ ចោទ ថា សម្របសម្រួល ដោយ សៅរ៍ និង ធ្វើឱ្យ ផ្ទេរ កម្មសិទ្ធិ ដី ទៅ ឱ្យ លោក រ៉ា ចាន់ ណា ។ ដី នោះ ត្រូវបាន គេ លក់ ទៅឲ្យ អ្នក ផ្សេង ឈ្មោះ ឡាយ ពិសិដ្ឋ យុគ ទើប ជំរុញ ឲ្យ ពលរដ្ឋ ទាំង ៤ គ្រួសារ ដាក់ពាក្យបណ្ដឹង ។
បណ្ដឹង នោះ បាន បន្ត ថា៖ ឯកសារ ប្រតិបត្តិការ ដីធ្លី ត្រូវបាន ពិនិត្យ និង បង្ហាញ ជា ផ្លូវការ ថា មាន ស្នាម មេដៃ មិន មែន ជា កម្មសិទ្ធិ របស់ ដើម បណ្តឹង ទាំង បួន នោះ ទេ ។
