( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៤៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៩ នាក់ នោះ មាន ១៧នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្ន បទល្មើស ព្រហ្មទណ្ឌ ១០ករណី និង ជនសង្ស័យ ៣២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស គ្រឿងញៀន ១៦ករណី ។
ការធ្វើជា ម្ចាស់ ផ្ទះ នៃ ព្រឹត្តិការណ៍ កីឡា ស៉ី ហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម គឺជា មោទនភាព និង មុខមាត់ សម្រាប់ ប្រទេស និង ប្រជាជន កម្ពុជា ទាំងមូល ។
( ភ្នំពេញ ) ៖ លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ បាន ថ្លែង ថា ខេត្ត ឧត្តរមានជ័យ ជា ខេត្ត មាន អំណោយផល លើ វិស័យ កសិកម្ម ដែល ក្នុង មួយ ឆ្នាំ ៗ ខេត្ត នេះ ផលិត ដំណាំ កសិឧស្សាហកម្ម ដែល មាន សក្តានុពល សម្រាប់ ផ្គត់ផ្គង់ ក្នុង ស្រុក និង នាំចេញ បាន ប្រមាណ ជាង ២លាន តោន ។
លោក កត់សម្គាល់ ថា បច្ចុប្បន្ន នេះ តម្លៃ កសិផល បាន កើនឡើង ជាពិសេស ដំឡូង មី និង ស្វាយ ដែល បាន ធ្វើឱ្យ ជីវភាព កសិករ កាន់តែ ល្អ ប្រសើរ ។
ជា ការកត់សម្គាល់ ចរន្ត ភ្ញៀវ ទេសចរ ក្នុង ស្រុក បន្ត ស្ថិត ក្នុង រង្វង់ ប្រមាណ ៣០ម៉ឺន នាក់ ក្នុង មួយ សប្តាហ៍ ខណៈ ដែល សប្តាហ៍ កន្លងមក យើង ទទួល ភ្ញៀវ ក្នុង ស្រុក ប្រមាណ ១. ៥លាន នាក់ ក្នុង នោះ ការប្រារព្ធ ពិធី បុណ្យ ទន្លេ នៅ ខេត្ត កំពង់ធំ ចាប់ពី ថ្ងៃទី ៨ - ១០ ខែមីនា ឆ្នាំ ២០២៣ បាន ទាក់ទាញ ភ្ញៀវ ជាង ១លាន នាក់ ។
ក្រសួង ទេសចរណ៍ បាន ផ្សព្វផ្សាយ អំពី ព្រឹត្តិការណ៍ ព្រះអាទិត្យ រះ ចំ កណ្តាល កំពូល ប្រាសាទ អង្គរវត្ត ដែល តែង កើតឡើង នា រៀងរាល់ ថ្ងៃទី ២០ និង ២១ ខែមីនា ។
ទន្ទឹមនឹង នេះ នា ថ្ងៃចន្ទ ទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ក្រសួង ទេសចរណ៍ បាន ដាក់ចេញ សារាចរ ណែនាំ ស្តីពី ការរៀបចំ គ្រប់គ្រង ចរន្ត ភ្ញៀវ ទេសចរ និង ការពង្រឹង គុណភាព ផលិតផល និង សេវាកម្ម ទេសចរណ៍ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ។
ដោយឡែក ក្រុមការងារ សភាព សហព័ន្ធ យុវជន កម្ពុជា បាន កំពុង ខិតខំ ជំរុញ ការរៀបចំ អង្គរ សង្រ្កាន្ត ខណៈ ដែល បណ្តា រាជធានី - ខេត្ត ផ្សេង ៗ ក៏ បាន កំពុង ខិតខំ ជំរុញ ការរៀបចំ កម្មវិធី សង្រ្កាន្ត នៅ តាម មូលដ្ឋាន របស់ ខ្លួន ផងដែរ ៕
ក្រសួង មុខងារ សាធារណៈ បើក សន្និបាត បូកសរុប សមទ្ធិផល ការងារ ៥ ឆ្នាំ ២០១៨ - ២០២២ និង លើក ទិសដៅ ការងារ បន្ត
( ភ្នំពេញ ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ បាន អញ្ជើញ ជា អធិបតីភាព បើក សន្និបាត បូកសរុប សមទ្ធិផល ការងារ ឆ្នាំ ( ២០១៨ - ២០២២ ) និង លើក ទិសដៅ ការងារ បន្ត របស់ ក្រសួង មុខងារ សាធារណៈ ដែល ប្រព្រឹត្តទៅ រយៈពេល ១ ថ្ងៃ កន្លះ ចាប់ពី ថ្ងៃទី ២១ ដល់ ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៣ ។
លោក រដ្ឋមន្រ្តី ព្រុំ សុខា បាន គូសបញ្ជាក់ ថា ក្នុង រយៈពេល ៥ឆ្នាំ កន្លងទៅ ជាមួយ បេសកកម្ម និង ភារកិច្ច ទទួលខុសត្រូវ ដ៏ ធ្ងន់ធ្ងរ ប្រកបដោយ កិត្តិយស របស់ ខ្លួន ដែល ជានិច្ចកាល ស្ថិត ក្រោម ការដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ និង ដោយ ផ្ទាល់ របស់ សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្រសួង មុខងារ សាធារណៈ ខិតខំ ពុះពារ សម្រេចបាន នូវ សមិទ្ធផល សំខាន់ ៗ ដូច ខាងក្រោម៖
ទន្ទឹម នោះ ក្រសួង មុខងារ សាធារណៈ បាន ប្រមូលផ្តុំ បង្កើន សមត្ថភាព អភិវឌ្ឍ ផ្នែក រឹង និង ផ្នែក ទន់ នៃ ប្រព័ន្ធ គ្រប់គ្រង មន្រ្តី រាជការ តាម ព័ត៌មានវិទ្យា (HRMIS) និង បាន យកចិត្តទុកដាក់ ពង្រឹង អធិការកិច្ច មុខងារ សាធារណៈ និង បាន ពង្រីក ទំនាក់ទំនង អន្តរជាតិ លើ វិស័យ មុខងារ សាធារណៈ ។ល ។
ទន្ទឹម នោះ យើង បាន បង្កើត ថ្មី នូវ នាយកដ្ឋាន គាំពារ សុខុមាលភាព មន្រ្តី រាជការ ចំណុះ អគ្គ នាយកដ្ឋាន គ្រប់គ្រង មុខងារ សាធាណៈ និង បង្កើត នាយកដ្ឋាន មួយចំនួន ទទួលបន្ទុក អធិការកិច្ច ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ និង នាយកដ្ឋាន ដោះស្រាយ វិវាទ មុខងារ សាធារណៈ ចំណុះ អគ្គាធិការដ្ឋាន ។ល ។
ទី៣៖ ការប្រើប្រាស់ បច្ចេកវិទ្យា ទំនើប ឌីជីថល តាមរយៈ ម៉ាស៊ីន ហាត វែរ ថ្មី សម្រាប់ អភិវឌ្ឍ ប្រព័ន្ធ គ្រប់គ្រង មន្រ្តី រាជការ តាម ព័ត៌មានវិទ្យា (HRMIS) បាន លើកកម្ពស់ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង ទិន្នន័យ មន្រ្តី រាជការ ការបើកប្រាក់ បៀវត្ស ការរៀបចំ ឡើងវិញ នូវ ប្រព័ន្ធ គ្រប់គ្រង សលាក បត្រ ព័ត៌មាន ការចូលនិវត្តន៍ របស់ មន្រ្តី រាជការ ការគ្រប់គ្រង មន្ត្រី ជាប់ កិច្ចសន្យា គ្រូបង្រៀន ជាប់ កិច្ចសន្យា និង ប្រភេទ បុគ្គលិក អណ្តែត ដទៃ ទៀត ។
ទី៥៖ ការកសាង និង អភិវឌ្ឍន៍ សមត្ថភាព មន្រ្តី រាជការ និង សមត្ថភាព ស្ថាប័ន នៅ ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ តាមរយៈ ការបើក វគ្គ បណ្តុះបណ្តាល សិក្ខាសាលា កិច្ចប្រជុំ ផ្សេង ៗ ក្នុង ប្រទេស និង ការបញ្ជូន មន្រ្តី រាជការ ទៅ ទទួល ការបណ្តុះបណ្តាល នៅ ក្រៅ ប្រទេស ត្រូវបាន ធ្វើឡើង ជាប្រចាំ ឥត មាន អាក់ខាន ពិសេស ក្នុង អំឡុង ពេល ដែល មាន ការរាតត្បាត ខ្លាំង នៃ ជំងឺ កូវីដ - ១៩ យើង បាន ពុះពារ រៀបចំ វគ្គ សិក្សា និង កិច្ចប្រជុំ នានា តាម ប្រព័ន្ធ អនឡាញ ។
អង្គ សន្និបាត បន្ត ដំណើរការងារ នឹង បញ្ចប់ នៅ ព្រឹក ស្អែក ថ្ងៃទី ២២ ខែមិនា ឆ្នាំ ២០២៣ ដោយ មាន វត្តមាន ជា អធិបតីភាពអញ្ជើញ បិទ សនិ្ន បាត របស់ ឯកឧត្តម អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ តំណាង ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « ភាពជោគជ័យ រយៈពេល ៥ឆ្នាំ កន្លងមក របស់ រដ្ឋបាល ខេត្ដ ឧត្តរមានជ័យ » នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី សាល សេរីភាព ជាន់ ផ្ទាល់ ដី ។
ក្រុមប្រឹក្សា សន្តិសុខ UN ដែល មាន សមាជិក ចំនួន ១៥រូប បាន បើក កិច្ចប្រជុំ ក្រោយពី ទីក្រុង ព្យុងយ៉ាង បាញ់ មីស៊ីល ផ្លោង អន្តរ ទ្វីប Hwasong-17 កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ មុន ។ នៅឯ UN ចិន និង រុស្ស៉ី បាន ស្តីបន្ទោស លើ សមយុទ្ធ យោធា រួមគ្នា រវាង សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង ថា ជា ការបង្ក រឿង ឲ្យ ទីក្រុង ព្យុងយ៉ាង បាញ់ មីស៉ីល នោះ ខណៈ ទីក្រុង វ៉ាស៉ីនតោន ចោទ ទីក្រុង ប៉េកាំង និង ទីក្រុង មូស្គូ ថា កាន់ ជើង ទីក្រុង ព្យុងយ៉ាង ពី ការដាក់ទណ្ឌកម្ម បន្ថែម ទៀត ។
លើស ពី នេះ ទៀត កិច្ចព្រមព្រៀង នេះ នឹង មិន ត្រូវការ ការយល់ព្រម ពី ម្ចាស់ ភាគហ៊ុន ឡើយ បន្ទាប់ពី រដ្ឋាភិបាល ស៊្វីស បាន យល់ព្រម ផ្លាស់ប្តូរ ច្បាប់ ដើម្បី ដក ចេញ នូវ ភាព មិន ច្បាស់លាស់ ណាមួយ អំពី កិច្ចព្រមព្រៀង នេះ ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន ក្រសួង ការបរទេស ជប៉ុន បាន គូសបញ្ជាក់ ឱ្យដឹង ថា « លោក គីស៉ី ដា នឹង ផ្ដាំផ្ញើ ដោយ ផ្ទាល់ ទៅកាន់ លោក ហ្សេលេន ស្គី ពី ការគោរព ដល់ ភាពក្លាហាន និង ឆន្ទៈ តស៊ូ យ៉ាង មុះមុត របស់ ប្រជាជន អ៊ុយក្រែន ដែល បាន ក្រោក ឈរ ឡើង ដើម្បី ការពារ ប្រទេសជាតិ របស់ ខ្លួន នៅក្រោម ការដឹកនាំ របស់ លោក ហ្សេលេន ស្គី » ។ បើ តាម សេចក្ដីថ្លែងការណ៍ ដដែល លោក គីស៉ី ដា ក៏ នឹង បង្ហាញ ផងដែរ ពី សាមគ្គីភាព និង ការគាំទ្រ ឥត ងាក រេ របស់ ជប៉ុន និង ក្រុម ប្រទេស G7 ចំពោះ អ៊ុយក្រែន ។
ទីភ្នាក់ងារ សារព័ត៌មាន Kyodo ធ្វើ សេចក្ដីរាយការណ៍ បែប នេះ ដោយ ផ្អែក លើ ប្រភព ពី មន្ត្រី ជប៉ុន ដែល ខ្លួន ទទួលបាន ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ ហើយ នេះ គឺជា រឿង ដ៏ កម្រ មួយ ដែល មេដឹកនាំ ជប៉ុន បំពេញ ទស្សនកិច្ច នៅ ក្រៅ ប្រទេស ដោយ មិន បាន ប្រកាស ឱ្យដឹង ជាមុន ៕
គួរ បញ្ជាក់ ថា ជប៉ុន ក្នុង ឆ្នាំ ២០២៣ នេះ គឺជា ប្រធាន G7 ហើយ លោក គីស៉ី ដា នឹង ត្រូវ ធ្វើជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ កំពូល G7 រយៈពេល ៣ ថ្ងៃ ដោយ ចាប់ផ្ដើម ពី ថ្ងៃទី ១៩ ខែឧសភា ក្នុង ទីក្រុង ហ៉ីរ៉ូស៊ីម៉ា ។ ប្រទេស G7 មាន សមាជិក ដូចជា កាណាដា បារាំង អាល្លឺម៉ង់ អ៉ីតាលី ជប៉ុន ចក្រភព អង់គ្លេស និង សហរដ្ឋ អាមេរិក ៕
គួរ បញ្ជាក់ ថា ការអះអាង ខាងលើ របស់ ក្រសួង ការពារ ជាតិ រុស្ស៉ី ក្រោយ មាន ឧប្បត្តិហេតុ មួយ បាន កើតឡើង នៅក្នុង ដែន អាកាស សមុទ្រ ខ្មៅ កាលពី ទី ១៤ ខែមីនា កន្លងទៅ នេះ រវាង យន្ដហោះ ដ្រូន អាមេរិក មួយ គ្រឿង និង យន្ដហោះ ចម្បាំង រុស្ស៉ី ២គ្រឿង ។ សហរដ្ឋ អាមេរិក បាន ចោទប្រកាន់ ថា យន្ដហោះ ចម្បាំង រុស្ស៉ី មួយ គ្រឿង ក្នុង ចំណោម ២គ្រឿង បាន ចាក់ សាំង ចោល លើ យន្ដហោះ ដ្រូន របស់ ខ្លួន ហើយ បាន ហោះ ទៅ បុក ទង្គិច នឹង ស្លាបចក្រ ពី ខាងក្រោយ ជា ហេតុ ធ្វើឱ្យ យន្ដហោះ ដ្រូន នេះ ធ្លាក់ ៕
ទស្សនា រូបភាព៖ ព្រះមហាក្សត្រ កម្ពុជា ព្រះរាជ ទាន ព្រះអគ្គីជ័យ កីឡា សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣
( សៀមរាប ) ៖ ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ កម្ពុជា បាន យាង ព្រះរាជ ទាន ព្រះអគ្គីជ័យ កីឡា សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ នា ព្រឹក ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ខេត្ត សៀមរាប ។
ក្រោយ ព្រះរាជ ពិធី ខាងលើ ព្រះអគ្គី អាទិទេព កីឡា នឹង ត្រូវ រក្សា ក្នុង ចង្កៀង ពិសេស មួយ នៅ វត្ត រាជ បូណ៌ ខេត្ត សៀមរាប ដើម្បី រង់ចាំ ពិធី ដង្ហែ ទៅកាន់ បណ្ដា ប្រទេស តំបន់ អាស៊ាន និង ទីម័រ ខាងកើត ចាប់ពី ថ្ងៃទី ២២ ខែមីនា ដល់ ថ្ងៃទី ២៧ ខែមេសា ឆ្នាំ ២០២៣ ខាងមុខ ដោយ នឹង ត្រូវ ចេញ ពី ខេត្ត សៀមរាប នា ល្ងាច ថ្ងៃទី ២២ ខែមីនា ស្អែក នេះ ឆ្ពោះ ទីក្រុង ហាណូយ ប្រទេស វៀតណាម មុន គេ ហើយ ដង្ហែ ឆ្លងកាត់ ប្រទេស ជា បន្ដ បន្ទាប់ រហូតដល់ ប្រទេស ឡាវ ក្រោយ គេ មុន ត្រឡប់ ចូលមក កម្ពុជា វិញ ។
ជាមួយ បេសកកម្ម ដ៏ ពិសេស នៃ ដំណើរ ឆ្ពោះទៅ ពិធី បើក ការប្រកួត កីឡា ស៊ីហ្គេម - អាស៊ាន ប៉ារ៉ាហ្គេម នៅ កម្ពុជា នេះ សម្ដេច ពិជ័យ សេនា ទៀត បាញ់ បាន ចាត់តាំង ប្រតិភូ មួយ ក្រុម ដឹកនាំ ដោយ លោក ហោ សារុន រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ គឺជា បេសកជន ពិសេស តំណាង CAMSOC ព្រមទាំងអនុប្រធាន និង សមាជិក ៨រូប ទៀត ដើម្បី ធ្វើការ ជាមួយ ស្ថានទូត និង ស្ថាន តំណាង កម្ពុជា ប្រចាំ ប្រទេស នានា រៀបចំ ពិធី ដង្ហែ ព្រះអគ្គី អាទិទេព កីឡា ចាប់ពី ខេត្ត សៀមរាប រហូត ត្រឡប់មក កម្ពុជា វិញ ឲ្យ ទទួលបាន ជោគជ័យ ។
បន្ទាប់ពី ព្រះអគ្គី អាទិទេព កីឡា ចូល ដល់ ទឹកដី កម្ពុជា តំណាង CAMSOC និង រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង នឹង ត្រូវ ទទួល ព្រះអគ្គីកីឡា ហើយ ដង្ហែ តាម រថយន្ដ ឆ្ពោះ មក ខេត្ត ស្ទឹងត្រែង ហើយ សម្រាក នៅ ទីនោះ មួយ យប់ មុន បន្ដ ដំណើរ មកកាន់ រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៨ ខែមេសា ។ ដូច្នេះ រាល់ ការឈប់ សម្រាក នៅ ប្រទេស ឬ រាធានី - ខេត្ត នីមួយ ៗ ចង្កៀង ព្រះអគ្គី អាទិទេព កីឡា នឹង ត្រូវ រក្សា នៅ ស្ថានទូត ឬ ទី វត្តអារាម យ៉ាង ត្រឹមត្រូវ បំផុត ។
ក្រោយ បញ្ចប់ ពិធី ដង្ហែ ព្រះអគ្គីកីឡា នៅ បណ្ដា ប្រទេស តំបន់ អាស៊ាន និង ទីម័រ ខាងកើត គឺជា ពេលវេលា រៀបចំ ពិធី ដង្ហែ ព្រះអគ្គីកីឡា តាម បណ្ដា ខេត្ត ជាប់ បឹង ទន្លេ សាប វិញ ម្ដង ដោយ ចេញដំណើរ ពី រាជធានី ភ្នំពេញ ឆ្ពោះទៅ ខេត្ត កំពង់ឆ្នាំង ពោធិ៍ សាច់ បាត់ដំបង បន្ទាយមានជ័យ សៀមរាប កំពង់ធំ កំពង់ចាម ចាប់ពី ថ្ងៃទី ២៩ ខែមេសា រហូតដល់ ល្ងាច ថ្ងៃទី ០៥ ខែឧសភា ខ្ទង់ វេលា ម៉ោង ៨៖៣០ នាទី យប់ ពោលគឺ ចំពេល ប្រារព្ធ ពិធី បើក ការប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ ឆ្នាំ ២០២៣ នៅ កម្ពុជា ជា ផ្លូវការ តែម្ដង ។
កម្ពុជា មាន មោទនភាព ក្នុង ការធ្វើ ម្ចាស់ ផ្ទះ ការប្រកួត កីឡា ស៊ីហ្គេម - អាស៊ាន ប៉ារ៉ាហ្គេម ឆ្នាំ ២០២៣ ដែល ជា ឱកាស ដ៏ វិសេសវិសាល មួយ ក្នុង ការផ្ដួច ផ្ដើម ព្រះរាជ ពិធី បួងសួង សុំ ព្រះអគ្គី អាទិទេព កីឡា ពី ព្រះអាទិត្យ នៅ ប្រសាទ អង្គរវត្ត ដ៏ ល្បីល្បាញ ពាសពេញ ពិភពលោក ក៏ ដូចជា រៀបចំ ពិធី ដង្ហែ នៅក្នុង ប្រទេស និង ទៅកាន់ បណ្ដា ប្រទេស នានា ក្នុង តំបន់ អាស៊ាន និង ទីម័រ ខាងកើត ។
គួរ បញ្ជាក់ ថា នៅ ចំពោះ មុខ ដំណាក់កាល ដ៏ សំខាន់ នៃ សង្រ្គាម អ៊ុយក្រែន បាន ប្រាប់ សហភាព អឺរ៉ុប ថា ទាហាន របស់ ខ្លួន ត្រូវការ ប្រើ គ្រាប់ កាំភ្លើង ធំ ៣៥០.០០០ គ្រាប់ ក្នុង មួយ ខែ ដើម្បី អាច វាយ បក លើ ទាហាន រុស្ស៉ី និង បើក ប្រតិបត្តិការ វាយលុក ជាថ្មី នៅក្នុង ឆ្នាំ នេះ ៕ និយ័តករ អាជីវកម្ម អចលន វត្ថុ និង បញ្ចាំ កោះអញ្ជើញ ម្ចាស់ បុរី និង ក្រុមហ៊ុន សរុប ចំនួន ៣ ឲ្យ ចូលមក បង់ប្រាក់ ពិន័យ ករណី ធ្វើ អាជីវកម្ម អភិវឌ្ឍ លំនៅឋាន ដោយ គ្មាន អាជ្ញាបណ្ណ
និយ័តករ អាជីវកម្ម អចលន វត្ថុ និង បញ្ចាំ សង្កត់ធ្ងន់ ថា « ម្ចាស់ បុរី និង ក្រុមហ៊ុន ខាងលើ ត្រូវ មក បង់ប្រាក់ ពិន័យ និង ត្រូវ រស់ រាន់ មក ដាក់ ពាក្យ ស្នើសុំ អាជ្ញាបណ្ណ មិន លើស ពីរ ១៥ ថ្ងៃ យ៉ាង យូរ គិត ចាប់ កាលបរិច្ឆេទ នៃ សេចក្ដីជូនដំណឹង នេះ »៕ គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន ! ស្លាប់ ៣នាក់ និង របួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៦លើ ក បណ្តាលឲ្យ មនុស្ស ៤នាក់ ស្លាប់ និង ៩នាក់ របួស ។
លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី៖ សម្តេច តេជោ នៅតែ បន្ត ផ្តល់ អាហារូបរណ៍ ដល់ ប្អូន និស្សិត ដែល មាន បំណង ចង់ សិក្សា ថ្នាក់ វេជ្ជបណ្ឌិត ឯកទេស
( ភ្នំពេញ ) ៖ លោកស្រី បណ្ឌិត ពេជ ចន្ទ មុន្នី អនុប្រធាន ក្រុមប្រឹក្សាភិបាល ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) ប្រធាន មូលនិធិ អាហារូបករណ៍ សម្តេច តេជោ ហ៊ុន សែន ជួប សំណេះសំណាល និង ចែករំលែក នូវ បទពិសោធន៍ ល្អ ៗ ជាមួយនិស្សិត ថ្នាក់ វេជ្ជបណ្ឌិត ឯកទេស នៃ សាកលវិទ្យាវិទ្យាសាស្ត្រ សុខាភិបាល ដែល បាន ទទួល អាហារូបករណ៍ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដោយ ប្រឡង ជាប់ អាហារូបករណ៍ ចូលរៀន ចំនួន ៦៤ នាក់ ( ស្រី ២៣ នាក់ ) ។
ក្នុង ពិធី នេះ ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នា សាកលវិទ្យាល័យ វិទ្យាសាស្រ្ត សុខាភិបាល លោកស្រី បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅតែ បន្ត ផ្តល់ អាហារូបរណ៍ ដល់ ប្អូន និស្សិត ដែល មាន បំណង ចង់ សិក្សា ថ្នាក់ វេជ្ជបណ្ឌិត ឯកទេស ។
ទន្ទឹម និង នោះ ដែរ លោកស្រី បណ្ឌិត បាន លើកទឹកចិត្ត ដល់ ក្រុម និស្សិត អាហារូបករណ៍ ចូលរួម ស្ម័គ្រចិត្ត ជាមួយ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ ដើម្បី ទទួលបាន នូវ បទពិសោធន៍ ថ្មី ៗ ដោយ ផ្ទាល់ និង ប្រើប្រាស់ ចំណេះដឹង ដែល ខ្លួន មាន ដើម្បី ជួយ ពិនិត្យ ព្យាបាល ជំងឺ ដល់ ប្រជាពលរដ្ឋ ។
ចំណេះដឹង ទូទៅ៖ តើ សម រាត្រី មាន កិច្ច ពិធី អ្វី ខ្លះ តាម ទំនៀមព្រាហ្មណ៍ ?
សម រាត្រី ( វិសុវ / ពិសុព ) ជា ព្រឹត្តិការណ៍ មួយ ដែល រយៈពេល ថ្ងៃ និង យប់ មាន រយៈពេល ស្មើគ្នា ជាពិសេស ចំពោះ អង្គរវត្ត នា វេលា ព្រឹក ស្រាង ៗ មាន ព្រះអាទិត្យ រះ ចំ កណ្តាល កំពូល ប្រាសាទ បើ គិត នៅ ឆ្នាំ ២០២៣ ត្រូវ ចំ នៅ ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក អ៉ឹ ម សុខ រិទ្ធី បុរាណវិទូ និង ជា ប្រធាន នាយកដ្ឋាន ស្រាវជ្រាវ បណ្តុះបណ្តាល និង ផ្សព្វផ្សាយ នៃ អាជ្ញាធរ ជាតិ អប្សរា បាន ឱ្យដឹង ថា សម រាត្រី រដូវ ប្រាំង ប្រហែល មាន ប្រារព្ធ កិច្ច ពិធី ធំ ៗ តាម ទំនៀមព្រាហ្មណ៍ នា សម័យ អង្គរ ប៉ុន្តែ ពិធី ទាំងនោះ មិន មាន បន្ត រៀបចំ មក ទល់ សព្វ ថ្ងៃ នាំឱ្យ យើង បាត់ ដាន ឈឹង ។
លោក បាន បន្ត ថា ដើម្បី ជា ការពិចារណា យើង សាកល្បង មើល ទៅ ប្រភព ដើម នៃ អារ្យធម៌ ខ្មែរ ដ្បិត យើង ទទួល ឥទ្ធិពល ពី ឥណ្ឌា ហើយ ប្រហែល តិច ឬ ច្រើន យើង ប្រតិបត្តិ តាម ប្រពៃណី ព្រាហ្មណ៍ ខ្លះ ហើយ ។
ករណី ទី២. ព្រឹត្តិការណ៍ សម រាត្រី នេះ អាច ជាប់ពាក់ព័ន្ធ នឹង រឿង ជ័យជម្នះ របស់ ព្រះនរាយណ៍ ដែរ គឺ ព្រះក្រឹស្ណ ដែល ជា អវតារ មួយ យ៉ាង សំខាន់ របស់ ព្រះអង្គ ដែល បាន កម្ចាត់ ឬ បំផ្លាញ សភាវ អាក្រក់ ។ ព្រាហ្មណ៍ តែង ប្រារព្ធ កិច្ច ដើម្បី បង្ហាញ ថា សភាវ ល្អ ឈ្នះ លើសភាវ អាក្រក់ យុត្តិធម៌ ឈ្នះ លើ អយុត្តិធម៌ ។
លោក អ៉ឹ ម សុខ រិទ្ធី បាន បន្ថែម ថា បើ ពិចារណា លើ ករណី ទី៤ ពិធី ខាងលើ នោះ យើង ឃើញ មាន ទាក់ទង នឹង ព្រះនរាយណ៍ ជាពិសេស ។
វិមាន ក្រឹមឡាំង ប្រាប់ មន្ត្រី របស់ ខ្លួន ឱ្យ បញ្ឈប់ ប្រើប្រាស់ ទូរសព្ទ iPhone ដោយសារ ព្រួយបារម្ភ អំពី ចារកិច្ច លោក ខាងលិច
ប្រភព ដដែល នេះ បាន គូសបញ្ជាក់ ថា វិមាន ក្រឹមឡាំង អាចនឹង ផ្តល់ ឧបករណ៍ ផ្សេង ទៀត ជាមួយនឹង ប្រព័ន្ធ ប្រតិបត្តិការ ផ្សេង គ្នា ដើម្បី ជំនួស ទូរសព្ទ iPhone ។
វិមាន ក្រឹមឡាំង៖ លោក ពូទីន នឹង បញ្ជាក់ ជំហរ រុស្ស៉ី ចំពោះ អ៊ុយក្រែន យ៉ាង ច្បាស់លាស់ ក្នុង កំឡុង ទស្សនកិច្ច របស់ លោក ស៊ី ជីន ពីង
( មូស្គូ) ៖ វិមាន ក្រឹមឡាំង បាន និយាយ ថា ប្រធានាធិបតី រុស្សី លោក វ្ល៉ាឌីមៀ ពូទីន នឹង « ពន្យល់ លម្អិត » អំពី ជំហរ របស់ រុស្ស៊ី ចំពោះ ជម្លោះ នៅ អ៊ុយក្រែន ដល់ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង ក្នុង អំឡុង ដំណើរទស្សនកិច្ច ផ្លូវ រដ្ឋ របស់ លោក ទៅកាន់ ប្រទេស រុស្ស៊ី ដែល ចាប់ផ្តើម នៅ ថ្ងៃចន្ទ ទី២០ ខែមីនា នេះ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃចន្ទ ទី២០ ខែមីនា ឆ្នាំ ២០២៣ ។
អ្នកនាំពាក្យ វិមាន ក្រឹមឡាំង លោក Dmitry Peskov បាន និយាយ នៅក្នុង ការហៅទូរសព្ទ ជាមួយ អ្នកសារព័ត៌មាន ថា មេដឹកនាំ ទាំង ពីរ នឹង ពិភាក្សា អំពី បញ្ហា នៅក្នុង ផែនការ សន្តិភាព សម្រាប់ អ៊ុយក្រែន ដែល ស្នើ ឡើង ដោយ ទីក្រុង ប៉េកាំង កាលពី ខែ មុន ។
លោក បាន សង្កត់ធ្ងន់ ថា « ប៉ុន្តែ នៅ ទីនេះ ពិត ណាស់ ប្រធានាធិបតី ពូទីន នឹង ផ្តល់ ការពន្យល់ យ៉ាង ទូលំទូលាយ មួយ ដើម្បីឱ្យ លោក ប្រធានាធិបតី ស៊ី អាច យល់ ពី ស្ថានភាព បច្ចុប្បន្ន ដោយ ផ្ទាល់ ពី ភាគី រុស្ស៊ី » ។
ចិន បាន បញ្ចេញ ផែនការ សន្តិភាព ១២ ចំណុច របស់ ខ្លួន ដោយ អំពាវនាវ ឱ្យ មាន ការសន្ទនា រវាង ភាគី ទាំង ពីរ តែ មិន បាន រួមបញ្ចូល ផែនទី បង្ហាញ ផ្លូវ សម្រាប់ របៀប បញ្ចប់ សង្រ្គាម នោះ ទេ ។ ដោយសារ ការបដិសេធ របស់ ចិន ក្នុង ការថ្កោលទោស ការលុកលុយ របស់ រុស្ស៊ី អ៊ុយក្រែន បាន ស្វាគមន៍ យ៉ាង ប្រុងប្រយ័ត្ន ខណៈ ដែល សហរដ្ឋ អាមេរិក បាន ច្រានចោល ។
ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ចិន បាន រាយការណ៍ ថា ប្រធានាធិបតី ចិន លោក ស៉ី ជិន ពីង បាន ធ្វើដំណើរ ទៅដល់ ទីក្រុង មូស្គូ នៃ ប្រទេស រុស្ស៉ី ហើយ នា ល្ងាច ថ្ងៃចន្ទ នេះ សម្រាប់ ដំណើរ បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ ដែល មាន រយៈពេល សរុប ៣ ថ្ងៃ ។
គួរ បញ្ជាក់ ថា វត្តមាន របស់ លោក ស៉ី នៅ រុស្ស៉ី នា ពេលនេះ ធ្វើឱ្យ លោក ប្រធានាធិបតី ចិន ក្លាយជា មេដឹកនាំ ពិភពលោក ដំបូង បំផុត ដែល នឹង បាន ចាប់ ដៃ លោក ពូទីន ចាប់តាំងពី តុលាការ អន្តរជាតិ ព្រហ្មទណ្ឌ អន្តរជាតិ ICC ចេញ ដីកា ចាប់ខ្លួន លោក ប្រធានាធិបតី រុស្ស៉ី ជុំវិញ ការចោទប្រកាន់ ពី ឧក្រិដ្ឋកម្ម សង្រ្គាម នៅ អ៊ុយក្រែន ៕
ដាច់ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន ក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ និង ស្រុក អង្គស្នួល ដោយសារ អេស្កាវ៉ាទ័រ កាយ ដី ដាក់ លូ ប៉ះ ខ្សែ បណ្ដាញ តង់ ស្យុង មធ្យម ក្រោម ដី
ក្រុមការងារ បច្ចេកទេស កំពុង ធ្វើ ការដោះ ខ្នែង បំបែក ខ្សែ បណ្ដាញ ដើម្បី ភ្ជាប់ ចរន្ត ជូន អតិថិជន ឲ្យ មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ មុន វេលា ម៉ោង ២០៖០០ នាទី យប់ ។
អគ្គិសនី កម្ពុជា សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ នៅពេល បំពេញ ការងារ នៅជិត គន្លង ខ្សែ បណ្ដាញ អគ្គិសនី ពីព្រោះ អាច បណ្ដាលឲ្យ មាន ការរអាក់រអួល ក្នុង ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី និង គ្រោះថ្នាក់ ជា យថាហេតុ ៕ ប្រធាន អង្គការ សង្គម ស៉ី វិល ដើម្បី ការអភិវឌ្ឍ ផ្តាំ ទៅ អាឡិច « បើ ស្រឡាញ់ ខ្មែរ ពិត ឈប់ យក រូបភាព ការពារ បរិស្ថាន ធ្វើជា នយោបាយ វាយប្រហារ រាជ រដ្ឋាភិបាល កម្ពុជា » (Video inside)
លោក វ៉ែន ឧត្តម បាន ចាត់ទុក បទសម្ភាស ទាំងអស់ របស់ លោក អាឡិច និង លោក សាន់ម៉ាឡា គឺជា ព័ត៌មាន មិន ពិត ទេ ។
លោក លើកឡើង ថា ក្នុង បទសម្ភាស មាន ការលើក ថា មាន យុវជន ប្រមាណ ជាង ៥ភាគរយ ប៉ុណ្ណោះ បាន ចូលរួម ក្នុង អង្គការ សង្គម ស៉ីវិល ជាមួយ រាជ រដ្ឋាភិបាល គឺ មិន ពិត ព្រោះ បើ តាម ស្ថិតិ ដែល លោក ទទួលបាន យុវជន ដែល ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល មាន មិន ក្រោម ពី ជាង ៣០ ស្ថាប័ន នោះ ទេ ។
ជាមួយគ្នា នេះ ប្រធាន អង្គការ សង្គម ស៉ី វិល ដើម្បី ការអភិវឌ្ឍ រួម នេះ បាន ផ្តាំ ទៅ លោក អាឡិច ថា បើ ស្រឡាញ់ ខ្មែរ ពិត ត្រូវ បញ្ឈប់ ការយក រូបភាព ការពារ បរិស្ថាន ធ្វើជា នយោបាយ វាយប្រហារ រាជ រដ្ឋាភិបាល កម្ពុជា ទៀត ទៅ ។
លោក វ៉ែន ឧត្តម បាន ថ្លែង ថា « ខ្ញុំបាទ ផ្ទាល់ សូម អរគុណ ដល់ លោក អាឡិច ដែល ស្រឡាញ់ ជាតិ ខ្មែរ ប៉ុន្តែ ខ្ញុំ សុំឲ្យ ការស្រឡាញ់ របស់ អាឡិច ឲ្យ ក្លាយជា ការស្រឡាញ់ ពិត ចេញ ពី បេះដូង មិន មែន ដោយ ការស្រឡាញ់ ដោយ គ្រាន់តែ រូបភាព នយោបាយ ដើម្បី វាយប្រហារ រដ្ឋាភិបាល ទេ ព្រោះ រាល់ អ្វី ដែ លោក អាឡិច លើកឡើង គឺជា រឿង មិន ពិត ទេ » ។
ការអំពាវនាវ នេះ បាន ធ្វើឡើង បន្ទាប់ពី វិទ្យុ ទាំង ពីរ ខាងលើ បាន រៀបចំ វេទិកា តុ មូល កាលពី ពេល ថ្មី ៗ នេះ ជាមួយ លោក អាឡិច និង លោក សាន់ ម៉ាឡា ដើម្បី វាយប្រហារ ដល់ ពួកគេ ដែល បាន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ។
លោក មួង សូនី បាន ទាមទារ ឱ្យ វិទ្យុ ទាំង ពីរ នេះ អញ្ជើញ ប្រធាន អង្គការ មាតា ធម្មជាតិ លោក ម៉េង ហេង និង អញ្ជើញ ប្រធាន ក្រុម យុវជន ខ្មែរ មហានគរ ដើម្បី បកស្រាយ ឱ្យ ច្បាស់លាស់ និង ផ្តល់ នូវ ព័ត៌មាន ជាក់លាក់ មួយ ដល់ អ្នកស្តាប់ វិទ្យុ ទាំង ពីរ នេះ ។
លោក ក៏ បាន ជំរុញ ឱ្យ ព័ត៌មាន ទាំងអស់ ដែល ត្រូវបាន ផ្សព្វផ្សាយ អំពី ក្រុម យុវជ ត្រូវ គិតគូរ ២ ចំណុច ក្នុង នោះ រួម មាន ទី ១៖ ការឯកភាព នៃ យុវជន ដោយ មិន ត្រូវ និយាយ បំបែកបំបាក់ យុវជន និង មួយ ទៀត គឺ ត្រូវ លើកតម្កើន ប្រទេសជាតិ នៅលើ ឆាក អន្តរជាតិ ៕
គ.ជ. ប សេចក្តីប្រកាស ព័ត៌មាន លទ្ធផល នៃ ដំណើរទស្សនកិច្ច សិក្សា ស្វែងយល់ និង ផ្លាស់ប្តូរ បទពិសោធន៍ អំពី ការរៀបចំ ការបោះឆ្នោត នៅ សាធារណរដ្ឋ បារាំង
( ភ្នំពេញ ) ៖ លោក ប្រាជ្ញ ចន្ទ ប្រធាន គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) ដែល បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ កម្ពុជា អញ្ជើញ ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវការ ដើម្បី សិក្សា ស្វែងយល់ និង ផ្លាស់ប្តូរ បទពិសោធន៍ ពាក់ព័ន្ធ នឹង ការរៀបចំ ការបោះឆ្នោត នៅ ទីក្រុង ប៉ារីស នៃ សាធារណរដ្ឋ បារាំង ចាប់ពី ថ្ងៃទី ១៣ ដល់ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២៣ បាន ធ្វើ មាតុភូមិ និវត្តន៍ មកដល់ មាតុ ប្រទេស វិញ នៅ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២៣ ប្រកបដោយ សុខ សុវត្ថិភាព និង ទទួលបាន លទ្ធផល ប្រកបដោយ ផ្លែផ្កា ។
ថ្លែង នៅក្នុង ឱកាស សន្និសីទ សារព័ត៌មាន ពេល ត្រឡប់ មកដល់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ( ច្រក VIP) លោក ទេព នី ថា អគ្គ លេខាធិការ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ឱ្យដឹង ថា នៅក្នុង ដំណើរ បំពេញ បេសកកម្ម នៅ សាធារណរដ្ឋ បារំាង នេះ ប្រតិភូ កម្ពុជា ទទួលបាន ការសម្របសម្រួល យ៉ាង ល្អ ពី ក្រសួង មហាផ្ទៃ នៃ ប្រទេស បារំាង ក៏ ដូចជា ឯកឧត្តម ឯក អគ្គ រដ្ឋទូត និង មន្ត្រី ស្ថានទូត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រចាំ ប្រទេស បារំាង ។
ក្នុង ដំណើរទស្សនកិច្ច នេះ ភាគ ច្រើន ប្រតិភូ កម្ពុជា បាន ជួប ជាមួយ ស្ថាប័ន រៀបចំ ការបោះឆ្នោត បារំាង និង ស្ថាប័ន មួយចំនួន ទៀត ពាក់ព័ន្ធ នឹង ការបោះឆ្នោត នៃ ប្រទេស បារំាង ។ ប្រព័ន្ធ បោះឆ្នោត បារាំង មិន ដូច កម្ពុជា ទេ ដោយ បារំាង បាន រៀបចំ ការបោះឆ្នោត តាំងពី សតវត្ស ទី ១៩មក និង បាន កែលម្អ ប្រព័ន្ធ បោះឆ្នោត របស់ ខ្លួន ជា បន្តបន្ទាប់ ហើយ រហូតដល់ បច្ចុប្បន្ន បារាំង កំពុង ប្រើ ប្រព័ន្ធ បច្ចេកវិទ្យា ទំនើប ។
គណៈប្រតិភូ កម្ពុជា ត្រូវបាន ទទួលស្វាគមន៍ យ៉ាង រាក់ទាក់ និង បាន ផ្លាស់ប្តូរ បទពិសោធន៍ និង ព័ត៌មាន ពី គ្នា ទៅ វិញ ទៅមក ។ ជាមួយគ្នា នេះ គណៈប្រតិភូ ក៏ បាន លើកឡើង អំពី ការងារ រៀបចំ ការបោះឆ្នោត របស់ កម្ពុជា ជូន ភាគី បារាំង ឱ្យ បាន ជ្រាប ផងដែរ ។ ជា រួម ក្នុង ដំណើរទស្សនកិច្ច នៅ ប្រទេស បារំាង របស់ គណៈប្រតិភូ កម្ពុជា បាន ការចូលរួម គ្រប់ កម្មវិធី ដែល បាន គ្រោង ទុក និង បាន ដំណើរការ យ៉ាង ល្អ ។
ចំពោះ លទ្ធផល លោក ទេព នី ថា បាន គូសបញ្ជាក់ លើ ៣ចំណុច សំខាន់ ៗ រួម មាន៖
ទី១៖ យើង បាន ស្វែងយល់ អំពី ប្រព័ន្ធ បោះឆ្នោត នៅ ប្រទេស បារាំង ហើយ កម្ពុជា ក៏ បាន ជម្រាប ជូន ពី ដំណើរការ នៃ ប្រព័ន្ធ បោះឆ្នោត របស់ ខ្លួន ជូន ដល់ ស្ថាប័ន ពាក់ព័ន្ធ នៃ បារាំង ដែរ ។ យើង បាន ពង្រឹង ទំនាក់ទំនង ល្អ ជាមួយ ស្ថាប័ន ពាក់ព័ន្ធ នឹង ការបោះឆ្នោត បារាំង ។
ទី២៖ ការបោះឆ្នោត នៅ ប្រទេស បារំាង បើ ប្រៀបធៀប នឹង ប្រព័ន្ធ បោះឆ្នោត កម្ពុជា មិន ដូចគ្នា ទេ តែ មាន ចំណុច បច្ចេកទេស មួយចំនួន ល្អ ដែល យើង សង្កេតឃើញ បារាំង បាន រៀបចំ នីតិវិធី នៃ ការបោះឆ្នោត នីមួយ ៗ ជាស្រេច ហើយ នៅពេល បោះឆ្នោត បាន កែសម្រួល បន្តិចបន្តួច ជា សេចក្តីសម្រេច ជា មូលដ្ឋាន គតិយុត្ត ដាក់ ប្រើប្រាស់ ខុសពី កម្ពុជា យើង ដែល យើង ធ្វើ នីតិវិធី ថ្មី សម្រាប់ ការបោះឆ្នោត នីមួយ ៗ ។ ទម្រង់បែបបទ រៀបចំ ការបោះឆ្នោត បារាំង សម្រាប់ ខេត្ត ឬ ឃុំ សង្កាត់ របស់ ខ្លួន មាន ពណ៌ ផ្សេង គ្នា ដែល ងាយស្រួល ចំណាំ ។
ស្ថានីយ ទូរទស្សន៍ រដ្ឋ ចិន CCTV បាន រាយការណ៍ យ៉ាង ដូច្នេះ ថា « នៅ វេលា រសៀល ថ្ងៃចន្ទ នេះ ( ពេលវេលា នៅ ទីក្រុង មូស្គូ ) ប្រធានាធិបតី ស៉ី ជិន ពីង បាន ធ្វើដំណើរ ទៅដល់ រដ្ឋធានី មូស្គូ នៃ ប្រទេស រុស្ស៉ី តាមរយៈ យន្តហោះ ពិសេស » ។ ដំណើរទស្សនកិច្ច របស់ លោក ស៉ី ជិន ពីង គឺ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ ប្រធានាធិបតី រុស្ស៉ី លោក វ៉្លាឌីមៀ ពូទីន ហើយ នឹង ប្រព្រឹត្តទៅ រហូតដល់ ថ្ងៃទី ២២ ខែមីនា ។
អាជ្ញាធរ ខណ្ឌ ទួលគោក ចុះ ណែនាំ ហាង « បេប៊ី អោត ឡេត » បំពាន លើ ចិញ្ចើមផ្លូវ ចាក់ បេតុង ហ៊ុំ ដើមឈើ សាធារណៈ ចំនួន ៤ដើម
លោក ចាន់ បណ្ឌិត បាន ឲ្យដឹង ថា ក្រោយ មាន ការណែនាំ ពី លោក ជា ពិសី អភិបាល ខណ្ឌ ទួលគោក . លោក បាន ដឹកនាំ ក្រុមការងារ ចុះ ណែនាំ ហាង « បេប៊ី អោត ឡេត » បំពាន លើ ចិញ្ចើមផ្លូវ ចាក់ បេតុង ហ៊ុំ ដើមឈើ សាធារណៈ ចំនួន ៤ដើម នៅ ផ្លូវ ២៨៩ ក្នុង សង្កាត់ បឹងកក់២ ។
ក្នុង ឱកាស នោះ អាជ្ញាធរ បាន ធ្វើ កំណត់ហេតុ ណែនាំ មិន អនុញ្ញាតឲ្យ មាន ការធ្វើ បែប នេះ ម្តង ទៀត ឡើយ ក្នុង ករណី ម្ចាស់ ហាង មិន សហការ និង ធ្វើឲ្យ ប៉ះពាល់ ឬ ងាប់ ដើមឈើ ខាងលើ នេះ និង ត្រូវ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ៕
និយ័តករបរ ធន បាលកិច្ច ផ្សព្វផ្សាយ ពី កិច្ច ដំណើរការអភិវឌ្ឍ វិស័យ បរធន បាលកិច្ច នៅ កម្ពុជា ដល់ និស្សិត សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង
( ភ្នំពេញ ) ៖ និយ័តករបរ ធន បាលកិច្ច ( ន. ប.ធ. ) និង សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង នា ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ បាន សហការ គ្នា រៀបចំ សិក្ខាសាលា ស្ដីពី ការឈ្វេងយល់ ពី កិច្ច ដំណើរការអភិវឌ្ឍ វិស័យ បរធន បាលកិច្ច នៅ កម្ពុជា ក្រោម អធិបតីភាព លោក សុខ ដារ៉ា អគ្គ នាយក នៃ និយ័តករបរ ធន បាលកិច្ច និង លោក ហោ ប៉េង សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង នៅ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង ។
សិក្ខាសាលា នេះ ត្រូវបាន រៀបចំឡើង ក្នុង គោលដៅ បញ្ជ្រាប ការយល់ដឹង ជាសាធារណៈ ឱ្យ បាន កាន់តែ ទូលំទូលាយ និង ស៊ីជម្រៅ សម្រាប់ និស្សិត នៅ សាកលវិទ្យាល័យ អំពី យន្តការប្រតិបត្តិការបរ ធន បាលកិច្ច បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ គុណ ប្រយោជន៍ នៃ វិស័យ បរធន បាលកិច្ច ។ សិក្ខាសាលា នេះ ក៏ បាន ផ្ដល់ ឱកាស ដល់ និស្សិត បង្កើន ចំណេះដឹង បន្ថែម ពាក់ព័ន្ធ វិស័យ ហិរញ្ញវត្ថុ មិន មែន ធនាគារ ផងដែរ ។
កម្មវិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ នៃ ន . ប.ធ . និង មន្ត្រី ជំនាញ ព្រឹទ្ធ បុរស សាស្រ្តាចារ្យ និង និស្សិត នៃ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង ៕
សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ រំលែក ទុក្ខ ផ្ញើ ជូន លោកស្រី ឆាត់ គឹម ហូវ ចំពោះ មរណភាព លោក ឡាយ ខែក ទីប្រឹក្សា អាជ្ញាធរ មីន
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ រសៀល ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ផ្ញើ ជូន លោកស្រី ឆាត់ គឹម ហូវ ចំពោះ មរណភាព របស់ ស្វាមី លោកស្រី គឺ លោក ឡាយ ខែក ទីប្រឹក្សា អាជ្ញាធរ គ្រប់គ្រង សកម្មភាព កំចាត់ មីន និង សង្គ្រោះ ជន ពិការ ដោយសារ មីន និង ជា អតីត អ្នកតំណាង រាស្ត្រ ក្នុង អាណត្តិ ទី១ ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ ខ្ញុំ និង ភរិយា សូម សម្តែង នូវ ការសោកស្តាយ ជាមួយ លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ នៃ សព ។ មរណភាព របស់ ឯកឧត្តម ឡាយ ខែក ជា ការបាត់បង់ នូវ ស្វាមី ឪពុក ជីតា និង ជា ការបាត់បង់ ឥស្សរជន ខ្មែរ មួយ រូប ដែល កន្លងមក បាន ខិតខំ តស៊ូ លះបង់ កម្លាំង កាយ ចិត្ត ធនធាន និង បញ្ញា ស្មារតី ដើម្បី បម្រើ ដល់ បុព្វហេតុ នៃ សន្តិភាព និង ការអភិវឌ្ឍ ជាតិ មាតុភូមិ ។
ខ្ញុំ និង ភរិយា សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ ឯកឧត្តម ឡាយ ខែក សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។ សូម លោកជំទាវ ទទួល នូវ មនោសញ្ចេតនា រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ពី ខ្ញុំ និង ភរិយា »៕ ក្រសួង សារាចរ ណែនាំ ឱ្យ ពង្រឹង សេវាកម្ម ទេសចរណ៍ និង គ្រប់គ្រង ចរន្ត ភ្ញៀវ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ខ្មែរ
ក្រសួង ទេសចរណ៍ សូម ធ្វើ ការណែនាំ ដល់ មន្ទីរ ទេសចរណ៍ រាជធានី - ខេត្ត ដូច ខាងក្រោម៖
១. ត្រូវ សហការ ជាមួយ រដ្ឋបាល រាជធានី - ខេត្ត មន្ទីរ ជំនាញ និង ដៃគូ ពាក់ព័ន្ធ រៀបចំ ឱ្យ មាន ព្រឹត្តិការណ៍ សង្ក្រាន្ត ចូល ឆ្នាំ និង កម្មវិធី កម្សាន្ត សប្បាយ នានា តាម ទំនៀមទម្លាប់ ប្រពៃណី ។ ដោយឡែក មន្ទីរ ទេសចរណ៍ ខេត្ត សៀមរាប ត្រូវ ខិតខំ សហការ ជាមួយ ក្រុមការងារ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ក្នុង ការរៀបចំ ព្រឹត្តិការណ៍ អង្គរ សង្ក្រាន្ត ក្រោម ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
២. ត្រូវ បន្ត ជំរុញ ការអនុវត្ត ឱ្យ បាន យ៉ាង ខ្ជាប់ខ្ជួន នូវ វិធានការ ទាំងឡាយ ដែល ត្រូវបាន ដាក់ចេញ ដោយ រាជ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ព្រម ជាមួយ ការពង្រឹង ការអនុវត្ត វិធាន សុវត្ថិភាព ទេសចរណ៍ និង នីតិវិធី ស្តង់ដា ប្រតិបត្តិ អប្បបរមា (SOP) តាម គន្លង ប្រក្រតី ភាព ថ្មី ដើម្បី រក្សា ស្ថិរភាព អាជីវកម្ម និង ធានា សុវត្ថិភាព ជូន ភ្ញៀវ ទេសចរ ។
៥. ត្រូវ សហការ ជាមួយ មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ និង មន្ទីរ អប់រំ យុវជន និង កីឡា បំផុស ចលនា ឱ្យ មាន ការប្រឡង ចម្រៀង បុរាណ សម័យ កំណាព្យ អាយ៉ៃ ចាប៉ី និង ការលេង ល្បែង ប្រជាប្រិយ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន និង ត្រូវ ជួយ សម្រួល ឱ្យ មាន ការសម្ដែង របាំ ត្រុដិ នៅ តាម គោលដៅ សំខាន់ ៗ ដូចជា សណ្ឋាគារ ផ្ទះសំណាក់ ភោជនីយដ្ឋាន កន្លែង កម្សាន្ត និង មូលដ្ឋាន អាជីវកម្ម នានា ។
៦. ត្រូវ សហការ ជាមួយ មន្ទីរ ធម្មការ និង សាសនា រៀបចំ វត្ត ទេសចរណ៍ គំរូ សម្រាប់ ភ្ញៀវ ទេសចរ អន្តរជាតិ អាច ស្វែងយល់ ពី ប្រវត្តិ និង ទំនៀមទម្លាប់ នៃ ការរៀបចំ ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ។
មូលនិធិ គ្រួសារ ត្រកូល « អ៉ឹង » ឧបត្ថម្ភ ថវិកា ៥៦ លាន រៀល ជូន ពលរដ្ឋ ៥៦ គ្រួសាជួប គ្រោះ ភ្លើង ឆេះ ផ្ទះ នៅ ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ នា ព្រឹក ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២៣ មូលនិធិ « អ៉ឹង ហ្វោន ដេហ្ស៊ិន » បាន ឧបត្ថម្ភ ថវិកា ៥៦ លាន រៀល ជូន ប្រជាពលរដ្ឋ ៥៦ គ្រួសារ រងគ្រោះ ដោយសារ ភ្លើង ឆេះ ផ្ទះ នៅ ខេត្ត កំពង់ឆ្នាំង ។
ពិធី នោះ មាន ការចូលរួម ពី ក រុណា សីល វិសុទ្ធិ អគ្គ មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភ ក៍ ចាយ គង់ . ឧកញ៉ា អ៉ឹង ប៊ុន ហ៊ូវ និង លោកស្រី ហេង សុខា និង ក្រុមគ្រួសារ ព្រមទាំង អាជ្ញាធរ មូលដ្ឋាន ផងដែរ ។
មូលនិធិ « អ៉ឹង ហ្វោន ដេហ្ស៊ិន » បាន ឧបត្ថម្ភ ប្រជាពលរដ្ឋ រងគ្រោះ សរុប ៥៦ គ្រួសារ ដែល ត្រូវបាន ភ្លើង ឆេះ ផ្ទះ ចំនួន ០២ ករណី ទី១ នៅ ភូមិ ចុង កោះ សង្កាត់ ផ្សា ឆ្នាំង ក្រុង កំពង់ឆ្នាំង នា ថ្ងៃទី ០៥ ខែធ្នូ ឆ្នាំ ២០២២ ចំនួន ០៩ គ្រួសារ និង ករណី ។ទី២ នា ពេល ថ្មី ៗ នេះ កាលពី ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២៣ នៅ ភូមិ ផ្សា ឆ្នាំង សង្កាត់ ផ្សា ឆ្នាំង ក្រុង កំពង់ឆ្នាំង បណ្ដាលឱ្យ រងគ្រោះ ចំនួន ៤៧ គ្រួសារ ។ អំណោយ ដែល ចែកជូន ក្នុង ០១ គ្រួសារ ទទួលបាន ថវិកា ០១ លាន រៀល និង ទឹក ស្ព្រីង ធម្មជាតិ ប្រូវីដា ១០កេស ។
ឧកញ៉ា អ៉ឹង ប៊ុន ហ៊ូវ ប្រធាន មូលនិធិ « អ៉ឹង ហ្វោន ដេហ្ស៊ិន » ពិតជា មាន ការសោកស្ដាយ និង រន្ធត់ នៅពេល ទទួលបាន ដំណឹង នេះ ដោយ ខ្លួន លោក ផ្ទាល់ ធ្លាប់ ត្រូវ ភ្លើង ឆេះ ផ្ទះ រហូតដល់ទៅ ០២ ដង នៅ អំឡុង ពេល លោក រស់ នៅ ខេត្ត កំពង់ឆ្នាំង កាលពី ឆ្នាំ ១៩៨៦ និង នៅ ភ្នំពេញ កាលពី ២០០៤ ម្ដង ទៀត ។ ដូច្នេះ លោក ពិតជា យល់ ច្បាស់ ពី ទំហំ នៃ ការបាត់បង់ នេះ ។
ក្នុង ពិធី នោះ លោក បាន លើកឡើង ថា នេះ ជា អំណោយ មួយចំនួន សម្រាប់ ប្រើប្រាស់ តាម តម្រូវការ ចំពោះ មុខ តែ ប៉ុណ្ណោះ តែ សូម ប្រជាពលរដ្ឋ ទាំងអស់ កុំ បាក់ទឹកចិត្ត ត្រូវ ខិតខំ ប្រឹងប្រែង ក្នុង ការងារ និង អាជីវកម្ម បន្ត ទៀត ។
ឧកញ៉ា ក៏ សូម អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ជៀសវាង ការធ្វេសប្រហែស ដែល នាំអោយ មាន ការរងគ្រោះ ដល់ ខ្លួន ឯង និង អ្នកដទៃ ។
ប្រជាពលរដ្ឋ រងគ្រោះ បាន សម្ដែង ការត្រេកអរ យ៉ាង ខ្លាំង ដែល ឧកញ៉ា អ៉ឹង ប៊ុន ហ៊ូវ និង ក្រុមគ្រួសារ បាន ឧបត្ថម្ភ ជា ថវិកា និង ទឹក ដែល ជា តម្រូវ ការចាំបាច់ សម្រាប់ ពួកគាត់ នា ពេលនេះ ។
សូម បញ្ជាក់ មូលនិធិ គ្រួសារ ត្រកូល « អ៉ឹង » តែង ចុះ ធ្វើ សកម្មភាព មនុស្សធម៌ ជាពិសេស ពេល ពលរដ្ឋ ជួប គ្រោះអាសន្ន នានា ដើម្បី រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ដោះស្រាយ ការលំបាក របស់ ប្រជាពលរដ្ឋ ៕
សម្តេច តេជោ ហ៊ុន សែន ថ្លែងអំណរគុណ លោកស្រី អ្នក ឧកញ៉ា ជឹង សុភាព ដែល ជួយ ឧបត្ថម្ភ ថវិកា ៥០ម៉ឺន ដុល្លារ អាមេរិក សម្រាប់ ថត ភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី »
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ផ្ញើ លិខិ ថ្លែងអំណរគុណ ប្រកបដោយ ក្តី សោមនស្ស រីករាយ យ៉ាង ក្រលែង ចំពោះ អ្នក ឧកញ៉ា ជឹង សុភាព និង ស្វាមី ដែល បាន ជួយ ឧបត្ថម្ភ ថវិកា ចំនួន ៥០០.០០០ ( ប្រាំ រយ ពាន់ ) ដុល្លារ អាមេរិក សម្រាប់ ថត ភាពយន្ត ភាគ រឿង « កូនប្រុស ក្រោម ពន្លឺ ព្រះចន្ទ ពេញ បូណ៌មី » ។
ទន្ទឹមនឹង នេះ សម្តេច សូម ថ្លែង នូវ ការកោតសរសើរ ដោយ ស្មោះ ចំពោះ សន្តាន ចិត្ត ដ៏ សប្បុរស ថ្លៃថ្លា របស់ អ្នក ឧកញ៉ា និង ស្វាមី ដែល បាន រួមចំណែក គាំទ្រ ដល់ ការផលិត ខ្សែភាពយន្ត ភាគ ជា ប្រវត្តិសាស្ត្រ របស់ សម្តេច និង ភរិយា ។
ជាថ្មី ម្តង ទៀត ភរិយា សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ប្រសិទ្ធ ពរ ជ័យ សិរី មង្គល វិបុល សុខ ជូន ចំពោះ អ្នក ឧកញ៉ា និង ស្វាមី ព្រមទាំង ក្រុមគ្រួសារ សូម បាន ប្រកបដោយ ពរ ទាំង ៥ ប្រការ គឺ៖ អាយុ វណ្ណៈ សុខៈ ពលៈ និង បដិភាណៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
សូម ទស្សនា នូវ ការលើកឡើង របស់ លោក បណ្ឌិត ដៀប សុផល ដូចតទៅ៖ </ មេបញ្ជាការ អាវុធហត្ថ ខេត្ត កំពង់ស្ពឹ ជួប សំណេះសំណាល ជាមួយ យោធិន សោធន និវត្តន៍ និង ពិការ មុន បុណ្យ ចូល ឆ្នាំ ខ្មែរ ចំនួន ២៩ នាក់
លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន បាន លើកឡើង ថា បងប្អូន ជា អតីត យុទ្ធជន ទង អស់ ដែល មាន វត្តមាន នៅ ទីនេះ ពិតជា បាន សាង ស្នាដៃ ក្នុង បុព្វហេតុ ជាតិ និង បាន ចូលរួម លើ ការងារ កសាង ការពារ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន ជាតិ មាតុភូមិ ជាពិសេស ការពារ បាន សន្តិសុខ ជូន ពលរដ្ឋ នា ពេល កន្លងមក ។ ស្នាដៃ ទាំងនេះ បាន បន្សល់ទុក ដល់ យើងខ្ញុំ ជា កងកម្លាំង ជំនាន់ ក្រោយ ដែល មិន អាច បំភ្លេច និង កាត់ ថ្លៃ បាន ឡើយ ។
លោក មេបញ្ជាការ បាន បន្ត ថា ក្នុង រយៈពេល ជាច្រើន ឆ្នាំ នាយ ឧត្តមសេនីយ៍ តែងតែ ក្រើន រំលឹក តាម បណ្តា អង្គភាព រាជធានី - ខេត្ត ឲ្យ គិតគូរ យកចិត្តទុកដាក់ ចំពោះ អតីត យុទ្ធជន និង យុទ្ធជន ពិការ និង យកចិត្តទុកដាក់ ជាពិសស គ្រប់ បែបយ៉ាង ដល់ អតីត យុទ្ធជន របស់ យើង ដោយ មិន បំភ្លេច ចោល ឡើយ ។
( កំពង់ធំ )៖ លោក សាយ គឹម ឡម អភិបាល ស្រុក ស្ទោង បាន លើកទឹកចិត្ត ឲ្យ សិស្សានុសិស្ស ត្រូវ ខិតខំ រៀនសូត្រ ដើម្បី អនាគត ភ្លឺស្វាង និង ជា សរស ទ្រូង ប្រទេសជាតិ ។
លោក សាយ គឹម ឡម បាន អំពាវនាវ ដូច្នេះ ក្នុង ឱកាស ដែល លោក និង សហការី អញ្ជើញ ចុះ សំណេះសំណាល សួរសុខទុក្ខ លោក នាយក លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ នៅ បឋមសិក្សា ប្រគាប ឃុំ ម្សា ក្រង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ។
លោក បាន បញ្ជាក់ ថា ការសិក្សា ពិតជា មាន តម្លៃ ណាស់ ព្រោះ ជា ចំណេះដឹង និង ជា ទ្រព្យ ពិតប្រាកដ ដែល នៅជាប់ ខ្លួន យើង អាច ឲ្យ យើង ប្រើប្រាស់ បាន គ្រប់ កាលៈទេសៈ និង នាំឲ្យ យើង ឈាន ទៅ រក អនាគត ភ្លឺស្វាង ត្រចះត្រចង់ ផងដែរ ។
ជាមួយគ្នា នេះ លោក បាន កោតសរសើរ លោក នាយក លោកគ្រូ អ្នកគ្រូ ដែល បាន គ្រប់គ្រង ដឹកនាំ អង្គភាព និង បង្ហាត់ បង្រៀន សិស្សានុសិស្ស ប្រកបដោយ វីជ្ជាជីវៈ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ហើយ ត្រូវ បន្ត វប្បធម៌ នេះ តទៅទៀត ជាពិសេស ត្រូវ បង្កើន សាមគ្គីភាព ផ្ទៃក្នុង ឲ្យ កាន់តែ ប្រសើរឡើង ដើម្បីឲ្យ សាលារៀន មាន វឌ្ឍនភាព ជាលំដាប់ ។
លើស ពី នេះ លោក អភិបាល ស្រុក ក៏ បាន កោតសរសើរ និង ថ្លែងអំណរគុណ ក្រៃលែង ដល់ អាជ្ញាធរ មូលដ្ឋាន និង សប្បុរសជន នានា ដែល តែងតែ សហការ ជាមួយ រដ្ឋបាល ស្រុក ស្ទោង ក្នុង ការធ្វើ កិច្ចការ មនុស្សធម៌ សុខុមាលភាព សង្គម ជាពិសេស ការសង្គ្រោះ ពលរដ្ឋ ងាយ រង ហានិភ័យ ឲ្យបាន ប្រសើរឡើង ។
( សៀមរាប ) ៖ កម្ពុជា បាន រៀបចំ ពិធី ក្រុង ពាលី បួងសួង តាម បែប សាសនា មុន ព្រះរាជ ពិធី ព្រះរាជ ទាន ព្រះអគ្គិជ័យ សម្រាប់ ព្រឹត្តិការណ៍ ស៊ីហ្គេម លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី១២ ខណៈ ពិធី នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នៅ ក្តារ បែន ខាងមុខ ប្រាសាទ អង្គរវត្ត ។
ពិធី នេះ ប្រារព្ធ ឡើង ក្រោម អធិបតីភាព លោក ថោង ខុន ប្រធាន ក្រុមប្រឹក្សា សហព័ន្ធ កីឡា អាស៊ី អាគ្នេយ៍ និង ជា រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ លោកស្រី ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល អាជ្ញាធរ ជាតិ អប្សរា លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ហង់ ពៅ អគ្គ នាយក អាជ្ញាធរ ជាតិ អប្សរា ព្រមទាំង តំណាង អាជ្ញាធរ ខេត្ត សៀមរាប និង អ្នកមុខអ្នក ការជាច្រើន រូប ទៀត ។
ក្នុង នាម ជា ម្ចាស់ ផ្ទះ រៀបចំ ការប្រកួត កីឡា អាស៊ី អាគ្នេយ៍ លើក ទី ៣២ និង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ នា ពេល ខាងមុខ នេះ កម្ពុជា ក៏ បាន ចាប់ផ្តើម រៀបចំ ព្រះរាជ ពិធី សុំ ព្រះអគ្គិកីឡា ពី ព្រះអាទិទេព សម្រាប់ ព្រះអគ្គិ កីឡា អាស៊ី អាគ្នេយ៍ និង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម នៅ ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ស្អែក នេះ នៅ ប្រាសាទ អង្គរវត្ត ។
ព្រះរាជ ពិធី សុំ ព្រះអគ្គិកីឡា ពី ព្រះអាទិទេព នឹង ប្រារព្ធ ឡើង ក្រោម ព្រះរាជា ធិបតី ដ៏ ខ្ពង់ខ្ពស់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រមទាំង រៀបចំ ពិធី រត់ ដង្ហែ ព្រះអគ្គិ កីឡា នេះ នៅ តាម បណ្តា ប្រទេស ក្នុង តំបន់ អាស៊ាន និង នៅ តាម បណ្តា ខេត្ត មួយចំនួន ក្នុង ប្រទេស ផងដែរ ៕ ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី២០ ខែមីនា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ លោក ស៊ី ជិន ពីង ថា ផែនការ សន្តិភាព របស់ ចិន ឆ្លុះបញ្ចំាង ពី សាមគ្គីភាព នៃ ទស្សនសកល មុន ចេញដំណើរ ទៅ មូស្គូ
២៖ លោក គីម ជុង អ៊ុន ប្រាប់ ឱ្យ យោធា កូរ៉េ ខាងជើង ត្រៀមខ្លួន ជានិច្ច សម្រាប់ ការវាយប្រហារ ដោយ ប្រើ « អាវុធ នុយក្លេអ៊ែរ »
៣៖ ប្រធានាធិបតី អ៉ីរ៉ង់ ស្វាគមន៍ ការអញ្ជើញ ពី ព្រះមហាក្សត្រ អារ៉ាប៊ី សាអូឌីត ដើម្បី ធ្វើ ទស្សនកិច្ច ទៅកាន់ ទីក្រុង រីយ៉ាដ
៤៖ លោក ពូទីន សាទរ ដល់ ឆន្ទៈ របស់ ចិន ដែល ចង់ ជួយ ផ្សះផ្សា ជម្លោះ អ៊ុយក្រែន មុន ដំណើរទស្សនកិច្ច របស់ លោក ស៊ី ជិន ពីង
៥៖ នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក គីស៉ី ដា ធ្វើដំណើរ ទៅដល់ ឥណ្ឌា ហើយ ដើម្បី បើក កិច្ចប្រជុំ កំពូល ជាមួយ លោក ម៉ូឌី ">
រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង សូម ធ្វើ ការបំភ្លឺ និង បដិសេធន៍ ទាំងស្រុង ថា ការផ្សព្វផ្សាយ អត្ថបទ ព័ត៌មាន ខាងលើ នេះ គឺជា ការមួល បង្កាច់ ប្រឌិត រឿង និង បំផ្លើស បំភ្លៃ ការពិត និង មាន គោលបំណង ប្រែក្លាយ ឱ្យ ទៅជា បញ្ហា នយោបាយ ដើម្បី តែ ផលប្រយោជន៍ របស់ ក្រុម ខ្លួន ប៉ុណ្ណោះ ។
បី ថ្ងៃ បន្ទាប់ពី មាន ការចោទប្រកាន់ ដោយ តុលាការ អន្តរជាតិ ដោយសារ ឧក្រិដ្ឋកម្ម សង្គ្រាម នោះ រួច មក ប្រធានាធិបតី រុស្ស៊ី លោក វ្លាឌីមៀរ ពូទីន បាន ត្រៀម រងចាំ ទទួល ការចាប់ដៃ បង្ហាញ សាម គ្គីភាព ជាមួយនឹង មេដឹកនាំ ចិន លោក ស៊ី ជីន ពីង ដែល អញ្ជើញ បំពេញ ទស្សនកិច្ច ក្រុង ម៉ូស្គូ នៅ ថ្ងៃ ចន្ទ ទី ២០មីនា ឆ្នាំ ២០២៣ ។
សហរដ្ឋ អាមេរិក និង ប្រទេស លោក ខាងលិច បាន ព្រមាន ប្រទេស ចិន មិន ត្រូវ ធ្វើ អន្តរាគមន៍ ជួយ រុស្ស៊ី ក្នុង សង្គ្រាម ក្នុង អ៊ុយក្រែន ឡើយ ប៉ុន្តែ ការព្រមាន នោះ មិន អាច រារាំង ចិន ក្នុង ដំណើរ ការ នៃ ភាពដៃគូ ជា យុទ្ធសាស្ត្រ គ្មាន ដែន កំណត់ ជាមួយនឹង រុស្ស៊ី បាន ឡើយ ។
រដ្ឋមន្ត្រី ការបរទេស ចិន លោក ជីន កាង បាន ថ្លែង មុន នេះ ថា បើ ប្រទេស ចិន និង រុស្ស៉ី បាន ធ្វើ កិច្ចការ ជាមួយគ្នា ពិភពលោក នឹង មាន កម្លាំង ចលករ ធ្វើដំណើរ ទៅ មុខ ឆ្ពោះទៅរក ប៉ូល ពហុ ភាគី និយម និង មាន ដំណើរការលទ្ធិ ប្រជាធិបតេយ្យ និង ទំនាក់ទំនង អន្តរជាតិ កាន់តែ ប្រសើរ ។ លោក បន្ត ថា កិច្ចសហការ គ្នា រវាង ចិន និង រុស្ស៊ី នឹង ជួយ ឱ្យ មាន តុល្យភាពយុទ្ធសាស្ត្រ ជា សកល និង ធានា មាន ស្ថិរភាព កាន់តែ ប្រសើរ ល្អ និង ថា វា ចាំបាច់ ណាស់ សម្រាប់ ចិន និង រុស្ស៊ី ដែល ត្រូវ តែ ជំរុញ ទំនាក់ទំនង ឱ្យ បាន រឹងមាំ នោះ ។
លោក Nikolenko បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ភ្លាម ៗ បន្ទាប់ពី មេដឹកនាំ ចិន លោក ស៊ី ជីន ពីង បាន ទៅដល់ ទីក្រុង មូស្គូ ដើម្បី ពិភាក្សា ជាមួយ ប្រធានាធិបតី រុស្ស៊ី លោក ពូទីន ថា « អ៊ុយក្រែន កំពុង តាមដាន យ៉ាង ជិតស្និត នូវ ដំណើរទស្សនកិច្ច របស់ ប្រធានាធិបតី ចិន ទៅកាន់ ប្រទេស រុស្ស៊ី » ។
លោក បាន បន្ថែម ថា « យើង រំពឹង ថា ទីក្រុង ប៉េកាំង នឹង ប្រើប្រាស់ ឥទ្ធិពល របស់ ខ្លួន លើ ទីក្រុង ម៉ូស្គូ ដើម្បី បញ្ចប់ សង្រ្គាម ឈ្លានពាន ប្រឆាំង នឹង អ៊ុយក្រែន » ។
លោក Nikolenko បាន និយាយ ថា « យើង ត្រៀមខ្លួន រួច ជាស្រេច ដើម្បី ចូល ទៅក្នុង កិច្ចសន្ទនា កាន់តែ ជិតស្និទ្ធ ជាមួយ ប្រទេស ចិន ដើម្បី ស្ដារ សន្តិភាព ក្នុង ប្រទេស អ៊ុយក្រែន ស្រប តាម គោលការណ៍ ដែល មាន ចែង ក្នុង ធម្មនុញ្ញ អង្គការ សហ ប្រជាជាតិ និង ដំណោះស្រាយ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ នា ពេល ថ្មី ៗ នេះ លើ បញ្ហា នេះ » ។
អាជ្ញាធរ ជាតិ ព្រះវិហារ សេចក្តីប្រកាស ព័ត៌មាន ស្ដី អំពី លទ្ធផល នៃ សន្និសីទ អន្តរជាតិ ពិសេស ស្ដីពី តំបន់ បេតិកភណ្ឌ ព្រះវិហារ និង កោះ កេរ
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ អាជ្ញាធរ ជាតិ ព្រះវិហា រ៖
ការប្រើប្រាស់ រូបិយវត្ថុ ជាតិ សំខាន់ ណាស់ ក្នុង ការពង្រឹង ឯករាជ្យ នយោបាយ រូបិយវត្ថុ រក្សា ស្ថិរភាព ម៉ាក្រូ សេដ្ឋកិច្ច និង កាត់បន្ថយ ផល ប៉ះពាល់ ពី វិបត្តិ ខាងក្រៅ
( ភ្នំពេញ ) ៖ លោកស្រី ជា សិរី ទេសាភិបាល រង ធនាគារ ជាតិ នៃ កម្ពុជា នៅតែ បន្ដ លើកកម្ពស់ ការប្រើប្រាស់ ប្រាក់ រៀល តាមរយៈ រូបភាព និង មធ្យោបាយ ផ្សេង ។
ក្នុង នោះ លោកស្រី សង្កត់ធ្ងន់ ថា ការប្រើប្រាស់ ប្រាក់ រៀល មាន សារៈសំខាន់ ក្នុង ការពង្រឹង ឯករាជ្យ នយោបាយ រូបិយវត្ថុ ដើម្បី រួមចំណែក រក្សា ស្ថិរភាព មាំក្រូ សេដ្ឋកិច្ច និង កាត់បន្ថយ ផល ប៉ះពាល់ ពី វិបត្តិ ខាងក្រៅ ។
លោកស្រី ជា សិរី បាន ថ្លែង ថា ការប្រើប្រាស់ ប្រាក់ រៀល កាន់តែ ច្រើន នឹង ផ្តល់ លទ្ធភាព ដល់ ធនាគារ ជាតិ នៃ កម្ពុជា ក្នុង ការអនុវត្ត នយោបាយ រូបិយវត្ថុ និង អត្រា ប្តូរ ប្រាក់ កាន់តែ មាន ប្រសិទ្ធភាព ពិសេស ការកំណត់ អត្រា ការប្រាក់ គោល និង ការផ្តល់ សាច់ប្រាក់ បន្ថែម ដល់ សេដ្ឋកិច្ច ដែល អាច មាន ឥទិ្ធពល លើ អត្រា ការប្រាក់ ទីផ្សារ ការវិនិយោគ និង ផលិតកម្ម និង ឈាន ទៅ ជំរុញ ឱ្យ មាន ការបង្កើត ការងារ ធ្វើ និង បង្កើន ប្រាក់ ចំណូល របស់ ប្រជាពលរដ្ឋ ។
លោកស្រី បាន បញ្ជាក់ ថា បទពិសោធន៍ ពី វិបត្តិ កូវីដ - ១៩ បាន បង្ហាញ ឱ្យ ឃើញ យ៉ាង ច្បាស់ ថា ធនាគារ កណ្តាល នៃ បណ្ដា ប្រទេស ភាគ ច្រើន ដែល មាន ឯករាជ្យ ផ្នែក រូបិយវត្ថុ បាន អនុវត្ត នយោបាយ រូបិយវត្ថុ វិត្ថារកម្ម យ៉ាង សកម្ម តាមរយៈ ការកាត់បន្ថយ អត្រា ការប្រាក់ គោល និង កម្មវិធី ចាក់បញ្ចូល សាច់ប្រាក់ ទៅក្នុង ទីផ្សារ ដែល បាន រួមចំណែក ជំរុញ សកម្មភាព សេដ្ឋកិច្ច ឱ្យ ងើប ឡើងវិញ បាន ឆាប់ រហ័ស ។
លោកស្រី បាន បញ្ជាក់ ថា ម្យ៉ាងទៀត រាជ រដ្ឋាភិបាល អាច កាត់បន្ថយ ការពឹងផ្អែក លើ បំណុល ពី បរទេស តាមរយៈ ការកៀរគរ មូលនិធិ ជា រូបិយវត្ថុ ក្នុង ស្រុក ដើម្បី គាំទ្រ ដល់ ការផ្តល់ ហិរញ្ញប្បទាន សម្រាប់ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ និង គម្រោង អភិវឌ្ឍន៍ ផ្សេង ៗ ។
លោក បណ្ឌិត សំ វិចិត្រ សេដ្ឋវិទូ ជាន់ ខ្ពស់ នៃ ធនាគារ ជាតិ នៃ កម្ពុជា បាន បញ្ជាក់ ថា បច្ចុប្បន្ន ការប្រើប្រាស់ ប្រាក់ រៀល មាន ស្ថានភាពល្អ ប្រសើរ ដោយ ក្នុង នោះ ការសន្សំ ជា ប្រាក់ រៀល មាន ការកើនឡើង ច្រើន ដូច្នេះ ប្រសិនបើ មាន ការលើ កម្ពស់ ការបើកប្រាក់ បៀវត្សន៍ ជា ប្រាក់ រៀល នោះ យើង នឹង ទទួលបាន ការការចំណាយ និង ការសន្សំ ជា លុយ រៀល មាន ច្រើន ។
លោក បាន បញ្ជាក់ ថា ដើម្បី លើ កម្ពស់ គោល នយោបាយ នៃ ការប្រើប្រាស់ ប្រាក់ រៀល ត្រូវ ផ្សារភ្ជាប់ នឹង គោល នយោបាយ នៃ សហគ្រាស ធុន តូច និង មធ្យម កាលណា សហគ្រាស ធុន តូច និង មធ្យម ត្រូវបាន អភិវឌ្ឍន៍ បាន ល្អ នោះ ការប្រើប្រាស់ ប្រាក់ រៀល នឹង កើនឡើង ៕
ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ស្ទឹង បត់ - បាន ណង អៀន សម្រេច ការសាងសង់ បាន ជាង ៨២ ភាគរយ គ្រោង បញ្ចប់ ក្នុង ខែឧសភា នេះ
( បន្ទាយមានជ័យ )៖ លោក ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ថ្លែង បញ្ជាក់ ថា គិត ត្រឹម ខែមីនា ឆ្នាំ ២០២៣ នេះ គម្រោង ការងារ រៀបចំ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ស្ទឹង បត់ - បាន ណង អៀន ដែល គ្រោង ប្រើប្រាស់ ថវិកា សាងសង់ ប្រមាណ ២៦. ៤២ លាន ដុល្លារ អាមេរិក បាន សម្រេច ការសាងសង់ ប្រមាណ ៨២.៣០ ភាគរយ ហើយ តាម ផែក ការគម្រោង គ្រោង នឹង បញ្ចប់ ការសាងសង់ នៅ បំណាច់ ខែឧសភា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល បាន ថ្លែង បញ្ជាក់ យ៉ាង ដូចនេះ នា រសៀល ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដឹកនាំ ប្រតិភូ ក្រសួង ចុះ ពិនិត្យ វឌ្ឍនភាព ការងារ គម្រោង ការងារ រៀបចំ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ស្ទឹង បត់ - បាន ណង អៀន ដោយ មាន ការចូលរួម អម ដំណើរ ពីសំណាក់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ជាច្រើន រូប ។
ទាក់ទង នឹង ការងារ រៀបចំ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ស្ទឹង បត់ - បាន ណង អៀន លោក ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល បាន ថ្លែង ដូចនេះ ថា « សូម ជម្រាប ថា គិត មកដល់ ពេលនេះ ខែមីនា នេះ គាត់ ធ្វើ បានជាង ៨២ % ហើយ ការគ្រោងទុក នឹង បញ្ចប់ នៅតែ ឧសភា ( នេះ ជា ការអះអាង របស់ ក្រុមហ៊ុន សាងសង់ ) ប៉ុន្តែ យើង មក មើលឃើញ ផ្ទាល់ ភ្នែក ហើយ យើង យល់ឃើញ ថា ខែឧសភា ក៏ ប្រហែលជា មិន ហើយ ដែរ ទោះជា មាន ថវិកា គ្រប់គ្រាន់ ក៏ យើងខ្ញុំ យល់ឃើញ ថា មិន ហើយ ដែរ » ។
ជាមួយនឹង ភាពយឺតយ៉ាវ នៃ ការសាងសង់ ដោយសារតែ ថវិកា មិន ទាន់ បាន ទម្លាក់ គ្រប់គ្រាន់ សម្រាប់ ក្រុមហ៊ុន សាងសង់ នេះ . លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ទៀត ថា ក្រសួង នឹង ពិភាក្សា ជាមួយ ភាគី ថៃ ដើម្បី ជំរុញ ពន្លឿន និតិវិធី ក្នុង ការទំលាក់ ថវិកា ឱ្យ ក្រុមហ៊ុន សាងសង់ ឱ្យ បាន លឿន ដើម្បី អាច បញ្ជប់ គម្រោង នេះ ឱ្យ ទាន់ តាម ផែនការ ដែល នឹង ត្រូវ បញ្ជប់ ក្នុង ខែឧសភា ខាងមុខ នេះ ផងដែរ ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល គោលបំណង ធំ នៃ កសាង ស្ពាន ស្ទឹង បត់ - បាន ណង អៀន ដើម្បី បញ្ជៀស ការកកស្ទះ ចរ រាចរណ៍ នៅ ប៉ោយប៉ែត ដោយ រថយន្ត ដឹក ទំនិញ ទាំងអស់ គឺ ត្រូវ ឱ្យ ឆ្លងកាត់ លើ ផ្លូវ ស្ពាន នេះ ហើយ សម្រាប់ ភ្ញៀវ ទេសចរណ៍ គឺ នៅតែ បន្ត ឱ្យ តាម ច្រក ប៉ោយប៉ែត ដដែល ផងដែរ ។
ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ដាក់ចេញ នូវ ការងារ អាទិភាព ចំនួន ១៨ ជំរុញ ការអនុវត្ត កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ដំណាក់កាល ទី៤
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី . រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន គណៈកម្មាធិការ ដឹកនាំ ការងារ កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ នៅ រសៀល ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ក្នុង ពិធី បិទ ការប្រកាស ដាក់ ឱ្យ អនុវត្ត ដំណាក់កាល ទី ៤ ( ឆ្នាំ ២០២៣ - ២០២៧ ) « គណនេយ្យភាព សមិទ្ធកម្ម » នៃ កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ។
ក្នុង ឱកាស នោះ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន ទាញ ការយកចិត្តទុកដាក់ របស់ ក្រសួង - ស្ថាប័ន . ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ . អគ្គ លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ ដឹកនាំ ការងារ កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ . អគ្គ នាយកដ្ឋាន នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . និង គ្រប់ អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ . លើ សកម្មភាព ជាក់ស្តែង មួយចំនួន ដែល ជា អាទិភាព ខ្ពស់ នៅក្រោម កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ - ដំណាក់កាល ទី ៤ ដូចត ទៅ៖
ទី ៤៖ ជំរុញ ការរៀបចំ នូវ លិខិត បទដ្ឋាន ពាក់ព័ន្ធ សម្រាប់ ធានា ដល់ ការអនុវត្ត ច្បាប់ ស្តីពី ប្រព័ន្ធ ហិរញ្ញវត្ថុ សាធារណៈ និង ច្បាប់ ស្តីពី លទ្ធកម្ម សាធារណៈ ( បន្ទាប់ពី សេចក្តីព្រាង ច្បាប់ ស្តីពី លទ្ធកម្ម សាធារណៈ នេះ ទទួលបាន ការអនុម័ត និង ត្រូវបាន ប្រកាស ដាក់ ឱ្យ អនុ - វត្ត តាម នីតិវិធី ជាធរមាន ) ។
ទី ៥៖ សហការ ជិតស្និទ្ធ ជា ក្រសួង - ស្ថាប័ន មាន សមត្ថកិច្ច ពាក់ព័ន្ធ ដើម្បី ជំរុញ ការ- រៀបចំ បញ្ចប់ នូវ វិសោធនកម្ម ច្បាប់ ស្តីពី របប ហិរញ្ញវត្ថុ និង ការគ្រប់គ្រង ទ្រព្យសម្បត្តិ រដ្ឋ របស់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ដោយ អនុលោម តាម ច្បាប់ ស្តីពី ប្រព័ន្ធ ហិរញ្ញវត្ថុ សាធារណៈ ឆ្នាំ ២០២៣ ។
ទី ៦៖ ជំរុញ ការធ្វើ ស្វ័យប្រវត្តិកម្ម ពេញលេញ នៃ ការអនុវត្ត ថវិកា តាម FMIS និង ធានា ប្រសិទ្ធភាព នៃ ការប្រើប្រាស់ FMIS ឱ្យ បាន ប្រសើរ បំផុត ។ ទី៧៖ បន្ត ជំរុញ ការពិនិត្យ និង ការកែលម្អ នីតិវិធី អនុវត្ត ថវិកា . ទាំង ក្នុង ក្របខណ្ឌ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . ទាំង ក្នុង ក្របខណ្ឌ ក្រសួង - ស្ថាប័ន ជំនាញ . ដើម្បី ឈាន ទៅ « អនុវត្ត ជា មូលដ្ឋាន » នូវ ថវិកា ព័ត៌មាន សមិទ្ធកម្ម ចាប់ពី ឆ្នាំ ២០២៦ ត ទៅ ។
ទី៨៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ក្រសួង - ស្ថាប័ន ជំនាញ ត្រូវ បន្ត បង្កើន ការ - យកចិត្តទុកដាក់ លើ ការកែលម្អ គុណភាព . ខ្លឹមសារ និង រចនាសម្ព័ន្ធ កម្មវិធី . ក៏ ដូចជា រចនា - សម្ព័ន្ធ រដ្ឋបាល ; ព្រមទាំង ការកំណត់ បន្ទាត់ គណនេយ្យភាព ឱ្យ ច្បាស់លាស់ តាម កម្រិត នីមួយ ៗ នៃ រចនាសម្ព័ន្ធ កម្មវិធី និង រចនាសម្ព័ន្ធ រដ្ឋបាល ។
ទី១០៖ ជំរុញ ការពង្រឹង ប្រព័ន្ធ ត្រួតពិនិត្យ ផ្ទៃក្នុង ឱ្យ មាន ប្រសិទ្ធភាព តាមរយៈ ការ- ផ្ដល់ សិទ្ធិ អំណាច កាន់តែ ច្រើន ដល់ អ្នក អនុវត្ត ដែល ក្នុង នោះ ថ្នាក់ដឹកនាំ ឬ ថ្នាក់ គ្រប់គ្រង ត្រូវ មាន តួនាទី ទទួលខុសត្រូវ ចំពោះ សមិទ្ធកម្ម ឬ ការត្រួតពិនិត្យ លើ លទ្ធផល នៃ ការអនុវត្ត . ចំណែក ការទទួលខុសត្រូវ ផ្នែក ហិរញ្ញវត្ថុ ត្រូវ ធ្វើឡើង តាមរយៈ ការពង្រឹង មុខងារ ត្រួតពិនិត្យ ហិរញ្ញវត្ថុ នៅ តាម ក្រសួង - ស្ថាប័ន សាមី . មុខងារ សវនកម្ម ផ្ទៃក្នុង និង មុខងារ អធិការ - កិច្ច ហិរញ្ញវត្ថុ ។
ទី១១៖ បន្ត ជំរុញ រៀបចំ និង អនុវត្ត កិច្ចព្រមព្រៀង សមិទ្ធកម្ម រវាង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ក្រសួង - ស្ថាប័ន ជំនាញ ។ ក្នុង កិច្ចការ នេះ . អគ្គ នាយកដ្ឋាន ថវិកា នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ត្រូវ បន្ត គាំទ្រ និង បណ្តុះបណ្តាល បន្ថែម លើ ការរៀបចំ កិច្ចព្រមព្រៀង សមិទ្ធកម្ម ព្រមទាំង ធ្វើការតាមដាន និង វាយតម្លៃ ជាប្រចាំ លើ ការអនុវត្ត កិច្ចព្រមព្រៀង សមិទ្ធកម្ម ។
ទី១២៖ អគ្គ លេខាធិការដ្ឋាន គណៈកម្មាធិការ ដឹកនាំ ការងារ កែទម្រង់ ការគ្រប់ - គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ត្រូវ ជំរុញ រៀបចំ បញ្ចប់ គោលការណ៍ ណែនាំ ស្តីពី ការគ្រប់គ្រង ហិ- រញ្ញវត្ថុ សាធារណៈ របស់ រដ្ឋាភិបាល និង របស់ ក្រសួង - ស្ថាប័ន និង ក្របខណ្ឌ រួម ផែនទី បង្ហាញ ផ្លូវ និង ផែនការ សកម្មភាព សម្រាប់ ដោះស្រាយ ចំណាយ កកស្ទះ (Expenditure Arrears) ដើម្បី បង្កើន ប្រសិទ្ធភាព និង ស័ក្តិសិទ្ធភាព នៅក្នុង ការគ្រប់គ្រង និង ការអនុវត្ត ចំណាយ ថវិកា ។
ទី១៣៖ បន្ដ យកចិត្តទុកដាក់ លើ ការពង្រឹង សមត្ថភាព ផ្នែក គ្រប់គ្រង ហិរញ្ញវត្ថុ សាធា - រណៈ . ទាំង ផ្ទៃក្នុង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . ទាំង នៅ តាម ក្រសួង - ស្ថាប័ន និង ទាំង នៅ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ . ដើម្បី ទ្រទ្រង់ ដល់ ការងារ កែទម្រង់ ផង និង ដើម្បី ជំរុញ ប្រសិទ្ធភាព នៃ ការអនុវត្ត កិច្ចការ ប្រចាំ ថ្ងៃ ផង ។
ទី១៤៖ បន្ដ យកចិត្តទុកដាក់ ឱ្យ បាន កាន់តែ ខ្លាំងក្លា ថែម ទៀត លើ ការគ្រប់គ្រង ទ្រព្យ - សម្បត្តិ រដ្ឋ តាមរយៈ ការអនុវត្ត ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន គ្រប់គ្រង បញ្ជី សារពើ ភណ្ឌ ទ្រព្យ - សម្បត្តិ រដ្ឋ ( ឬ ហៅ កាត់ ថា SARMIS) និង ការរៀបចំ បញ្ចប់ ផែនការគោល សម្រាប់ គ្រប់គ្រង ទ្រព្យសម្បត្តិ រដ្ឋ ។
ទី១៦៖ បន្ត កិច្ចសហការ ជាមួយ ដៃគូ អភិវឌ្ឍន៍ ពាក់ព័ន្ធ លើ គំនិត ផ្តួចផ្តើម មួយ ចំនួន នៅក្នុង ក្របខណ្ឌ នៃ កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ រួម មាន៖ ការ- គ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ តាម គោលការណ៍ បៃតង . ការបញ្រ្ជាប យេនឌ័រ ក្នុង ថវិកា . និង ការធ្វើ ពិពិធកម្ម បំណុល សាធារណៈ . ពិសេស តាមរយៈ ការអភិវឌ្ឍ មូលបត្រ រដ្ឋ ។
ទី១៧៖ ជំរុញ អនុវត្ត ផែនការ សកម្មភាព លម្អិត និង យន្តការត្រួតពិនិត្យ និង តាមដាន សម្រាប់ ការអនុវត្ត ឯកសារ « ចក្ខុវិស័យ និង យុទ្ធសាស្រ្ត ស្តីពី សុខដុមនីយកម្ម ការ កែទម្រង់ ៣ បូក ១» រួម មាន៖ កម្មវិធី ជាតិ សម្រាប់ ការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ; កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ; កម្មវិធី ជាតិ សម្រាប់ ការកែ - ទម្រង់ រដ្ឋបាល សាធារណៈ និង កម្មវិធី កែទម្រង់ ច្បាប់ និង ប្រព័ន្ធ យុត្តិធម៌ ។
( បន្ទាយមានជ័យ )៖ លោក និត វុទ្ធី ជា ស្មៀន ឃុំ អូរ បី ជាន់ ស្រុក អូជ្រៅ ខេត្ត បន្ទាយមានជ័យ បាន ចេញមក បកស្រាយ និង ច្រានចោល នូវ ព័ត៌មាន ចោទប្រកាន់ ពីសំណាក់ ជំទប់ ទី២ មក គណបក្ស ភ្លើង ទៀត ដែល បាន ចោទប្រកាន់ ថា លោក បាន ដុត បំផ្លាញ ឯកសារ សំខាន់ ៗ ចោល ដោយ គ្មាន ការសុំ យោបល់ ពី លោក មេឃុំ នោះ ឡើយ ក្រោយ ដឹង ថា ខ្លួន លេង បាន ធ្វើជា ស្មៀន ទៀត ហើយ ។
លោក និត វុទ្ធី បាន ចាត់ទុក ការផ្សព្វផ្សាយ ព័ត៌មាន ខាងលើ នេះ ជា ការចោទប្រកាន់ ដោយ គ្មាន ការពិត មក លើ រូបលោក ។
សូម បញ្ជាក់ ថា លោក និត វុទ្ធី កាលពី ពេល ថ្មី ៗ នេះ ត្រូវបាន បណ្តាញ ព័ត៌មាន មួយចំនួន ចុះផ្សាយ ដោយ ដក ប្រភព ពី លោក យ៉ន សុខា ជំទប់ ទី២ របស់ គណបក្ស ភ្លើង ទៀន ថា លោក ត្រូវបាន សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ចាត់ ក្រុម អធិការកិច្ច ចុះ មក ធ្វើ ការស៊ើបអង្កេត និង ស្រាវជ្រាវ ក៏ រកឃើញ នៅ ចំណុច មួយចំនួន ទើប សម្រេច ដក ចេញ ពី តួនាទ ឱ្យ មក ធ្វើការ នៅ សាលា ស្រុក អូរ ជ្រៅ វិញ ។
ក្រោយ មាន ការផ្លាស់ប្តូរ តំណែង ភ្លាម លោក និត វុទ្ធី ក៏ បាន រង ការចោទប្រកាន់ ពី ជំទប់ ឃុំ មកពី បក្ស ភ្លើង ទៀន ថា លោក បាន ដុត ឯកសារ សំខាន់ ៗ ចោល ទៀតផង ។ ជុំវិញ ករណី នេះ លោក និត វុទ្ធី បាន បង្ហាញ ការហួសចិត្ត យ៉ាង ខ្លាំង នៅ ពេល ដែល បាន ឃើញ មាន ការចុះផ្សាយ ព័ត៌មាន បំភ្លើស ខុសពី ការពិត ដោយ គ្មាន មូលដ្ឋាន ច្បាស់លាស់ ឡើយ ហើយ ប្រភព បញ្ចេញ ព័ត៌មាន នេះ គឺជា ការញុះញង់ របស់ ឈ្មោះ លោក យ៉ន សុខា ( ជា ជំទប់ ទី២ ) ដែល មកពី គណបក្ស ភ្លើង ទៀន យក ទៅ ឱ្យ សារព័ត៌មាន បង្ហោះ បង ខូច កេរ្តិ៍ឈ្មោះ របស់ លោក ។
លោក និត វុទ្ធី បាន បញ្ជាក់ ថា ឯកសារ ដែល រូប លោក បាន ដុត ចោល នោះ រួម មាន៖ ឯកសារ សរសេរ ខុស ៗ . ឯកសារ ហួស ការប្រើប្រាស់ ដូចជា បញ្ជី ឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០០៤ . ឯកសារ ផ្សព្វផ្សាយ ការចាក់ វ៉ាក សាំង និង ជំងឺ ផ្តាសសាយ បក្សី ឆ្នាំ ២០០៦ និង លិខិតប័ណ្ណ ផ្សព្វវ ផ្សាយ ចុះឈ្មោះ ឆ្នោត ឆ្នាំ ២០០៩ ជាដើម ។ ចំណែកឯកសារជា ដែល មាន សារៈសំខាន់ នោះ លោក បាន រក្សាទុក យ៉ាង ល្អ មិន មាន បាត់បង់ ឡើយ ។
ស្មៀន ឃុំ រូប នេះ ក៏ បាន ទទូច សុំ ឱ្យ សាធារណជន មេត្ត ជ្រាប និង កុំ ជឿ លើ ការផ្សព្វផ្សាយ ញុះញង់ របស់ ជំទប់ ទី២ មកពី គណបក្ស ភ្លើង ទៀន នេះ ឱ្យ សោះ ។
សូម កុំ ចង់ សាកល្បង គ្រឿងញៀន សូម្បី កន្លះ ដង ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែមីនា៖ បង្ក្រាប ២៦ ករណី ឃាត់ខ្លួន ៥៩ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៦ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១០ករណី . ដឹកជញ្ជូន រក្សាទុក ៧ករណី . ជួញដូរ ៨ករណី និង សម្រួល ចាត់ចែង ១ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥៩ នាក់ ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក ថ ន សេង តារា អគ្គ នាយក ក្រុមហ៊ុន តារា ធី ស៊ី ហ្គាស ដែល បាន ផ្តល់ អំណោយ ជូន អាវុធហត្ថ រាជធានី ភ្នំពេញ
ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ទទួលស្វាគមន៍ លោក ថ ន សេង តារា អគ្គ នាយក ក្រុមហ៊ុន តារា ធី ស៊ី ហ្គាស ប្រកបដោយ មនោសញ្ចេតនា ស្និទ្ធិ ស្នាល កក់ក្តៅ និង បាន សម្តែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក អគ្គ នាយក ដែល តែងតែ មាន ចិត្ត សប្បុរស ឧបត្ថម្ភ អំណោយ ដល់ អាវុធហត្ថ រាជធានី ភ្នំពេញ រាល់ ពេល មាន កម្មវិធី ផ្សេង ៗ កន្លងមក ក៏ ដូចជា ក្នុង ពេលនេះ ផងដែរ ៕
ប្រតិកម្ម របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត កើតមាន បន្ទាប់ពី សារព័ត៌មាន ខេមបូឌា ដេលី កាលពី ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣ កន្លងទៅ នេះ បាន អត្ថបទ មួយ មាន ចំណងជើង « សារព័ត៌មាន អន្តរជាតិ លាតត្រដាង ពី បណ្ដាញ រកស៊ី ឈើ ខុស ច្បាប់ របស់ លោក ហ៊ុន ម៉ាណែត » ។ ក្នុង អត្ថបទ នេះ សារព័ត៌មាន ខេមបូឌា ដេលី បាន ដកស្រង់ ការផ្សាយ របស់ សារព័ត៌មាន អន្តរជាតិ Mongabay មាន មូលដ្ឋាន នៅ អង់គ្លេស សរសេរ ដោយ អតីត អ្នកសារព័ត៌មាន នៅ វីអូឌី ។
លោក ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា លោក បាន ឱ្យ ក្រុមការងារ ស្រាវជ្រាវ និង អាន ព័ត៌មាន Mongabay នេះ ឡើងវិញ តែ មិន មាន កន្លែងណា ដែល ព័ត៌មាន នេះ បញ្ជាក់ ថា ក្រុម ឈ្មួញ កាប់ ឈើ ជាប់ពាក់ព័ន្ធ នឹង រូបលោក នោះ ឡើយ ។ ប៉ុន្តែ សារព័ត៌មាន ខេមបូឌា ដេលី បែរជា បំផ្លើស និង បញ្ចេញ បញ្ចូល បន្ថែម ចោទប្រកាន់ ប្រកាន់ ថា រូប លោក ជា មេ ឈ្មួញ រកស៊ី ឈើ នេះ ទៅ វិញ ។
អភិបាល រាជធានី ជំរុញ ឲ្យ មន្ទីរ ពាក់ព័ន្ធ - អាជ្ញាធរ ខណ្ឌ ទាំង ១៤ និង កម្លាំង សមត្ថកិច្ច រៀបចំ សណ្ដាប់ធ្នាប់ ត្រៀម អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ជំរុញ ឲ្យ មន្ទីរ ពាក់ព័ន្ធ អាជ្ញាធរ ខណ្ឌ ទាំង ១៤ និង កម្លាំង មាន សមត្ថកិច្ច ទាំងអស់ ត្រៀម អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ និង ត្រៀម ពិធី ទទួលគោរមងារ អ្នកសង្គ្រោះ សាសនា ពិភពលោក នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២៣ ខាងមុខ ដោយ ត្រូវ ជួសជុល កែលំអរ រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ វត្តភ្នំ ជាមួយនិង ការរៀបចំ សណ្ដាប់ធ្នាប់ របៀបរៀបរយ អនាម័យ បរិស្ថាន ការតុបតែង កែលម្អ សោភណភាព ទីតាំង នេះ ឲ្យបាន ល្អ ប្រសើរ ។
ការជំរុញ បែប នេះ បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នេះ ក្នុង ខណ្ឌ ប្រជុំ ជាមួយ អភិបាល ខណ្ឌ ទាំង ១៤ មន្ទីរ ពាក់ព័ន្ធ និង កម្លាំង មាន សមត្ថកិច្ច ទាំង ប៉ូលីស និង កងរាជអាវុធហត្ថ នៅ សាលា រាជធានី ភ្នំពេញ ។
កម្ពុជា ត្រៀម ធ្វើជា ម្ចាស់ ផ្ទះ នៃ សន្និសីទ សកល ស្តីពី ជំនួយ ដល់ ជនរងគ្រោះ ដោយសារ មីន នៅ ខែតុលា ឆ្នាំ ២០២៣
ការថ្លែង បែប នេះ ក្នុង ដំណើរទស្សនកិច្ច ស្វែងយល់ អំពី វឌ្ឍនភាព នៃ ការងារ បោសសម្អាត មីន នៅ កម្ពុជា ក្នុង ក្របខណ្ឌ អនុសញ្ញា អូតាវ៉ា ។ ជាមួយគ្នា នេះ លោក Juan Carlos Ruan បាន កោតសរសើរ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង និង ការយកចិត្ត ទុក ក្នុង ការដោះស្រាយ បញ្ហា មីន ហើយ លោក នាយក សង្ឃឹម ថា កម្ពុជា នឹង ទទួលបាន ជោគជ័យ តាម ផែនការគ្រោងទុក ដើម្បី បញ្ចប់ ការងារ បោសសម្អាត មីន ឲ្យ អស់ ក្នុង ឆ្នាំ ២០២៥ ។
ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា ទេសរដ្ឋមន្រ្តី បាន ថ្លែងអំណរគុណ ISU-APMBC ដែល តែងតែ ផ្តល់ ការគាំទ្រ ដល់ កម្ពុជា ក្នុង ការរៀបចំ ផែនការបោសសម្អាត មីន ឱ្យ សម្រេច ទៅ តាម មាត្រា ៥ នៃ អនុសញ្ញា អូតា វ៉ា ក្នុង នាម កម្ពុជា ជា រដ្ឋ ភាគី ។
លោក បាន បញ្ជាក់ បន្ថែម ថា ដោយ មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ពី សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី សកម្មភាព មីន នៅ កម្ពុជា បាន ឈានដល់ របត់ ថ្មី មួយ ទៀត ដែល មាន ការចូលរួម យ៉ាង ផុសផុល ពី វិស័យ ឯកជន សប្បុរសជន និង ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ លំដាប់ថ្នាក់ ព្រមទាំង មាន ការតាំងចិត្ត ខ្ពស់ រួមគ្នា ក្នុង ការបញ្ចប់ ការងារ បោសសម្អាត មីន ឲ្យ អស់ ត្រឹម ឆ្នាំ ២០២៥ ។
លោក បាន បន្ត ទៀត ថា បន្ទាប់ពី កម្ពុជា ទទួល ធ្វើជា ម្ចាស់ ផ្ទះ នៃ ការរៀបចំ សន្និសីទ សកល ស្តីពី ជំនួយ ដល់ ជនរងគ្រោះ ដោយសារ មីន ក្នុង ខែតុលា ឆ្នាំ ២០២៣ កម្ពុជា បាន ដាក់ ជា បេក្ខភាព ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ ត្រួត ពិនិត្យ ឡើងវិញ លើក ទី៥ អនុសញ្ញា អូតាវ៉ា សម្រាប់ ឆ្នាំ ២០២៤ ផងដែរ ដែល ក្នុង នោះ ស្នើសុំ ឲ្យ មាន ការជួយគាំទ្រ ពី ISU-APMBC ៕ បណ្ឌិត ហ៊ុន ម៉ាណែត អញ្ជើញ ប្រគល់ សញ្ញាបត្រ ជូន និស្សិត ជ័យលាភី នៃ សាកលវិទ្យាល័យ កំពង់ចាម
( កំពង់ចាម ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ប្រធាន គណៈកម្មាធិការ អាហារូបករណ៍ សិស្ស - និស្សិត ក្រីក្រ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ បាន ប្រគល់ សញ្ញាបត្រ ជូន និស្សិត ជ័យលាភី នៃ សាកលវិទ្យាល័យ កំពង់ចាម ។
លោក ថា សុខភាព គឺជា ទ្រព្យធន ដ៏ ចម្បង របស់ បុគ្គល ម្នាក់ ៗ និង សង្គមជាតិ ទាំងមូល ហើយ ទ្រព្យធន នេះ នឹង ផ្តល់ ផល វិជ្ជមាន ច្រើន សន្ធឹកសន្ធាប់ ដរាបណា មាន ការថែទាំ និង លើកកម្ពស់ ឱ្យ បាន រឹងមាំ តាមរយៈ កត្តា មួយ ចំនួន រួម មាន ជា អាទិ៍៖
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន ថ្លែងអំណរគុណ ដល់ គណៈ គ្រប់គ្រង . វេជ្ជបណ្ឌិត . សាស្រ្តាចារ្យ . លោកគ្រូ . អ្នកគ្រូ និង បុគ្គលិក ទាំងអស់ នៃ សាកលវិទ្យាល័យ កំពង់ចាម ដែល បាន ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការអប់រំ បណ្តុះបណ្តាល ធនធាន មនុស្ស លើ ជំនាញ សុខាភិបាល ដែល កំពុង មាន តម្រូវការ ខ្ពស់ បម្រើ ឱ្យ ការថែទាំង សុខភាព និង សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ ។ កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា នេះ នឹង ញ៉ាំង ឱ្យ វិស័យ សុខាភិបាល របស់ យើង អាច បន្ត បោះជំហាន រីកចម្រើន ទៅ មុខ ប្រកបដោយ គុណភាព បន្ថែម ទៀត ៕
ឧត្តមសេនីយ៍ ត្រី ជុំ សេដ្ឋា ដាក់ ផែនការ ឱ្យ គ្រប់ អង្គភាព បន្ត ខិតខំ ការងារ កសាង ហេដ្ឋារចនាសម្ព័ន្ធ បង្កបង្កើន ផល និង ចិញ្ចឹម សត្វ បន្ថែម លើ គោល របប ហូប ប្រចាំ ថ្ងៃ
( បន្ទាយមានជ័យ )៖ ឧត្តមសេនីយ៍ ត្រី ជុំ សេដ្ឋា មេបញ្ជាការ ស្តីទី កងពល តូច ថ្មើរជើង លេខ ៥១ នៅ ថ្ងៃអាទិត្យ ទី១៩ ខែមីនា ឆ្នាំ ២០២៣ ម្សិលមិញ បាន អញ្ជើញ ដឹកនាំ នាយ ទាហាន ចំណុះ ទី បញ្ជាការ កងពល ចុះ ធ្វើ ទស្សនកិច្ច សិក្សា ការងារ កសាង ពង្រឹង អង្គភាព រឹងមាំ លើ គ្រប់ វិស័យ អង្គភាព ការិយាល័យ ទី៤ និង វរសេនា តូច ថ្មើរជើង លេខ ៥១២ ស្ថិត នៅ ទីបញ្ជាការ កងពល ភូមិ ភ្នំ ជញ្ជាំង ឃុំ ជប់ វារី ស្រុក ព្រព្រះនេត្រ ព្រះ ខេត្ត បន្ទាយមានជ័យ ។
លោក មេបញ្ជាការ ស្តីទី កងពល បាន អញ្ជើញ ទស្សនា តាម ខ្លឹមសារ នីមួយ ៗ និង បាន ថ្លែង កោតសរសើរ ដល់ អង្គភាព ដែល បាន ខិតខំ យកចិត្តទុកដាក់ អនុវត្ត តាម ផែនការ ដែល ថ្នាក់ លើ ប្រគល់ ជូន និង អនុវត្ត តួនាទី ភារកិច្ច ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ តាម ផែនការ កសាង អង្គភាព រឹងមាំ លើ គ្រប់ វិស័យ ។
ក្នុង នោះ ដែរ ឧត្តមសេនីយ ត្រី ជុំ សេដ្ឋា បាន ដាក់ ផែនការ ឱ្យ គ្រប់ អង្គភាព បន្ត ខិតខំ ការងារ កសាង ហេដ្ឋារចនាសម្ព័ន្ធ ការងារ បង្កបង្កើន ផល និង ចិញ្ចឹម សត្វ បន្ថែម លើ គោល របប ហូប ប្រចាំ ថ្ងៃ ក៏ ដូចជា គ្រួសារ យោធិន ជួប ការលំបាក និង មួយចំនួន លើស តម្រូវការ លក់ ទៅ ទីផ្សារ សន្សំ ថវិកា កសាង ក្នុង អង្គភាព នីមួយ ៗ ឲ្យ កាន់តែ ល្អ ប្រសើរ ។
បន្ទាប់ពី មាន ការផ្សព្វផ្សាយ សេចក្តីជូនដំណឹង ស្ដីពី ការជ្រើសរើស ការដាក់ពាក្យ ទទួល ពាក្យ និង ការពិនិត្យ ពាក្យ កន្លងមក នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២៣ នេះ គណៈកម្មការរៀបចំ ការបោះឆ្នោត ខេត្ត កំពង់ឆ្នាំង ក៏ បាន រៀបចំ ការប្រឡ ង ជ្រើសរើស មន្ត្រី បម្រើ ការ រយៈពេល ខ្លី នៅ លេខាធិការដ្ឋាន នៃ គណៈកម្មការរៀបចំ ការបោះឆ្នោត ខេត្ត កំពង់ឆ្នាំង ចំនួន ៣០ រូប តែ បេក្ខជន ដែល ត្រូវ ប្រឡង មាន ចំនួ៥៥ រូប ក្នុង នោះ ស្រ្តី ៤រូប ។
ការតម្រូវការមន្ត្រី ដែល ត្រូវ ចូល បម្រើ ការងារ ខាងលើ នេះ រួម មាន៖
* ទី១៖ ជំនួយការ រដ្ឋបាល និង លេខាធិការ *ទី ២៖ គណៈនីករណ៍ * ទី ៣៖ បេឡាធិការ *ទី ៤៖ អនុប្រធាន ផ្នែក ប្រតិបត្តិការ ទទួលបន្ទុក ភស្តុភារ* ទី ៥៖ មន្ត្រី ប្រតិបត្តិការ និង ភស្តុភារ មាន ២រូប ក្រៅពី នោះ គឺ មាន តែ មួយ រូប ៗ * ទី ៦៖ មន្ត្រី ទទួល ដោះស្រាយ ពាក្យ បណ្ដឹង ១រូប ជំនួយ ការកុំព្យូទ័រ ១ រូប ការី កុំព្យូទ័រ ១ រូប អ្នកបើកបរ រថយន្ត ១រូប អ្នកយាម ចំនួន ៣រូប ការី វិទ្យុ ទាក់ទង ១ រូប សរុប គឺ មាន ៣០ រូប ។
ការប្រឡង ជ្រើសរើស មន្ត្រី បម្រើការ នៅ លេខាធិការដ្ឋាន នៃ គណៈកម្មការរៀបចំ ការបោះឆ្នោត ខេត្ត កំពង់ឆ្នាំង ក៏ មាន វត្តមាន លោក នុត សុខុម អនុប្រធាន គណៈកម្មការ ជាតិ រៀបចំ ការបោះឆ្នោត ហៅ កាត់ ថា ( គ.ជ. ប ) អញ្ជើញ ជា អធិបតី ភាព ក្នុង ការបើក វិញ្ញាសា ប្រឡង ផងដែរ ។
លោកស្រី នួន ចាន់ នី ប្រធាន គណៈកម្មការរៀបចំ ការបោះឆ្នោត ខេត្ត កំពង់ឆ្នាំង បាន ប្រាប់ ឲ្យដឹង ថា ការបោះឆ្នោត គឺ មាន ៤ដំណាក់កាល ដូច ខាងក្រោម៖
* ទី១៖ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត * ទី ២៖ ការចុះបញ្ជី គណបក្ស នយោបាយ *ទី ៣៖ ការឃោសនា បោះឆ្នោត ការបោះឆ្នោត ការរាប់ សន្លឹក ឆ្នោត * ទី ៤៖ ការប្រកាស លទ្ធផល បោះឆ្នោត ។ ហេតុ នេះ សម្រាប់ ខេត្ត កំពង់ឆ្នាំង ក៏ ដូចជា នៅ ទូទាំង ប្រទេស ផងដែរ ផ្អែក ទៅ តាម ដំណាក់កាល ទាំង៤ និង អនុវត្ត ទៅ តាម ប្រតិទិន គឺ បាន ឆ្លងកាត់ ដំណាក់កាល ទី១ រួចហើយ គឺ ការពិនិ ត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ។
ហេតុ នេះ នៅ ខេត្ត កំពង់ឆ្នាំង គឺ បាន ធ្វើ រួចរាល់ សម្រាប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២២ កន្លងទៅ ដែល បាន ធ្វើ ក្នុង រយៈពេល ៥០ ថ្ងៃ ដោយ ចាប់ពី ថ្ងៃទី ២០ ខែតុលា រហូតដល់ ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២២ ។
និស្សិត វិទ្យាសាស្រ្ត សុខាភិបាល មកពី សមាគម និស្សិត វិទ្យាសាស្ត្រ សុខាភិបាល មូស្លី ម កម្ពុជា ទស្សនកិច្ច បណ្ណាល័យ សម្តេច ម៉ែ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២៣ ម្សិលមិញ ក្រុម និស្សិត ពេទ្យ មូស្លីម កម្ពុជា ចំនួន ៥០ នាក់ ដឹកនាំ ដោយ លោក សាន់ សាប អ៉ី រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន សមាគម និសិ្សត វិទ្យាសាស្រ្ត សុខាភិបាល មូស្លីម កម្ពុជា បាន មក ទស្សនកិច្ច បណ្ណាល័យ សម្តេច ម៉ែ នៃ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ដោយ មាន ការទទួលស្វាគមន៍ ពី លោក ឆាំង យុ នាយក មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ។
នៅក្នុង ឱកាស នោះ លោក ឆាំង យុ បាន ឲ្យដឹង ថា មាន ប្រជាជន ចំនួន ៥លាន នាក់ ដែល នៅរស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល ស្មើនឹង ៣៣ % នៃ ប្រជាជន ទូទាំង ប្រទេស កម្ពុជា ដែល ហាក់ មិន សូវ ទទួលបាន ការយកចិត្តទុកដាក់ ។ អ្នក រស់រាន មាន ជីវិត ទាំងនេះ បាន កសាង ប្រទេស ឡើងវិញ ពី បាត ដៃ ទទេ ដែល ត្រូវ ជា មា មីង អ៊ំ យាយ និង តា របស់ យើង ។ បច្ចុប្បន្ន អ្នក ទាំងនេះ មាន វ័យ កាន់តែ ចាស់ ៗ អស់ ហើយ និង ចាប់ផ្ដើម មាន ជំងឺ ។
( ភ្នំពេញ ) ៖ គម្រោង « ការលើកកម្ពស់ សិទ្ធិ និង ការធ្វើឲ្យ ប្រសើរឡើង នូវ ស្ថានភាព សុខភាព របស់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម » នៃ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា បាន រៀបចំ សិក្ខាសាលា « ការអប់រំ អំពី សុខភាព » រយៈពេល មួយ ថ្ងៃ គឺ នៅ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២៣ ម្សិលមិញ នៅ សណ្ឋាគារ កាំបូឌីយ៉ាណា ជាមួយនិស្សិត វិទ្យាសាស្រ្ត សុខាភិបាល មកពី សមាគម និស្សិត វិទ្យាសាស្ត្រ សុខាភិបាល មូស្លីម កម្ពុជា ចំនួន ៥០ នាក់ និង និស្សិត អាហារ រូបករណ៍ មុខវិជ្ជា សុខភាព សាធារណៈ របស់ មជ្ឈមណ្ឌល ឯកសារ កម្ព ជា ចំនួន ២នាក់ ។
គម្រោង នេះ ធ្វើ យ៉ាងណា ឲ្យ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ទទួលបាន នូវ សេវា សុខភាព កាន់តែ ប្រសើរឡើង និង ចង់ មាន ឲ្យ មាន ការចូលរួម ពី ក្រុម និស្សិត ស្ម័គ្រចិត្ត ដែល ត្រូវ ជា កូន ចៅ របស់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ទាំងនោះ ។ ក្រុម និស្សិត ស្ម័គ្រចិត្ត អាច ត្រឡប់ ទៅ ធ្វើ ការងារ នៅ សហគមន៍ របស់ ខ្លួន ។
លោកស្រី សូ ហ្វារី ណា ក៏ បាន បង្ហាញ អំពី ផែនទី ដែល ក្រុម អ្នកស្ម័គ្រចិត្ត កម្ពុជា របស់ មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ចំនួន ១០៣០ នាក់ បាន ចុះ ទៅ សម្ភាស អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ចំនួន ៣២០០០ ដែល រស់ នៅ តាម តំបន់ ជនបទ ដាច់ស្រយាល ក្នុង ប្រទេស កម្ពុជា និង គ្លីនិក ឯកជន ដែល មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ធ្វើការ ជាមួយ កន្លងមក ។
តមក បណ្ឌិត លីហ្សា ប្រោន សាស្រ្តាចារ្យ នៅ សាកលវិទ្យាល័យ ស្តែន ហ្វត និង ប៉ាឡូ អាតូ បាន លើកឡើង អំពី សារសំខាន់ នៃ ការព្យាលបាល ជំងឺ ផ្លូវចិត្ត ជូន អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ថា ជំងឺ ទាំង នេះ បាន កើត ចេញ ពី ហេតុការណ៍ ដែល អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម បាន ជួបប្រទះ កន្លងមក ។ ជំងឺ ផ្លូវចិត្ត នេះ បាន កើតឡើង ភ្លាម ៗ បន្ទាប់ពី អ្នករស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម បាន ជួប ហេតុការណ៍ ភ្លាម ៗ និង ជំងឺ ផ្លូវចិត្ត មួយចំនួន ទៀត បាន អូសបន្លាយ រយៈពេល យូរ ។
អ្នក រស់រាន មាន ជីវិត មួយចំនួន បាន ព្យាយាម លាក់បាំង និង គេច ចេញ ពី ជំងឺ ផ្លូវចិត្ត ដោយ មិន មាន ការព្យាបាល ប៉ុន្តែ ជំងឺ នេះ នឹង ត្រឡប់ មកវិញ នៅពេល អ្នក ទាំងនោះ មាន វ័យ កាន់តែ ចាស់ និង រស់ នៅ ឯកោ ។ ម្យ៉ាងទៀត អ្នកជំងឺ ត្រូវ ទទួលស្គាល់ ថា គាត់ មាន បញ្ហា ផ្លូវចិត្ត ដើម្បីឲ្យ គាត់ ត្រៀមខ្លួន ដើម្បី ប្រឹក្សា ជាមួយ ក្រុម គ្រូពេទ្យ ជំនាញ ។
ដោយឡែក វេជ្ជបណ្ឌិត គួច ម៉េង លី ប្រធាន មូលនិធិ ម៉េង លី ជេ. គួច បាន លើកឡើង ថា សុខភាព និង ការថែទាំង សុខភាព គឺ សំខាន់ ខ្លាំង ណាស់ សម្រាប់ ប្រជាជន កម្ពុជា ។ ទោះបី យ៉ាងណា គាត់ បាន ឲ្យដឹង ថា បញ្ហា ទាំងនេះ ក៏ ជាប់ទាក់ទង នឹង ការយល់ដឹង របស់ ក្រុម គ្រូពេទ្យ ដែល ផ្តល់ សេវា សុខភាព ដែរ ។ ជាក់ស្តែង គ្រូពេទ្យ ត្រូវ មាន ពេលវេលា គ្រប់គ្រាន់ ដើម្បី ប្រឹក្សា ដល់ អ្នកជំងឺ ដើម្បី ដឹង ពី ដើមហេតុ ដំបូង នៃ ជំងឺ ហើយ ត្រូវ ប្រើ វិធីសាស្រ្ត ផ្សេង ៗ ដើម្បី ព្យាបាល ។
លោក សាន់ សាប់ អី រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន សមាគម និសិ្សត វិទ្យាសាស្រ្ត សុខាភិបាល មូស្លីម កម្ពុជា បាន គូសបញ្ជាក់ ថា ការរៀនសូត្រ មុខវិជ្ជាវិទ្យាសាស្រ្ត សុខាភិបាល គឺ មិន មែន ងាយស្រួល ឡើយ ។ នៅពេល យើង ចាប់ យក មុខវិជ្ជា នេះ គឺ យើង ត្រូវ សួរ ខ្លួន ឯង ថា យើង រៀន ដើម្បី អ្វី ?
លោក បន្ត ថា ប្រសិនបើ យើង រៀន ដើម្បី ជួយ សង្រ្គោះ ដល់ មនុស្ស នោះ យើង នឹង ពង្រឹង សមត្ថភាព និង មាន ក្រមសីលធម៌ ល្អ ចំពោះ អ្នកជំងឺ ។ យើង នឹង ឃើញ ពី តម្លៃ ការងារ និង មាន មោទកភាព ចំពោះ ខ្លួន ឯង ។ លោក បាន ផ្តាំផ្ញើ ដល់ និស្សិត ទាំងអស់ ឲ្យ យកចិត្តទុកដាក់ ត្រងត្រាប់ ស្តាប់ សិក្ខាសាលា និង ចូលរួម ឲ្យបាន សកម្ម ហើយ យក ចំណេះដឹង ដែល ទទួលបាន ទៅ អនុវត្ត នៅក្នុង កិច្ចការ របស់ ខ្លួន ។
លោក សាន់ សាប់ អី បាន គូសបញ្ជាក់ នៅក្នុង សាសនា អ៊ីស្លាម អ្វី ដែល យើង អាច យក ទៅតាម ខ្លួន បាន គឺ មាន តែ បី ចំណុច ប៉ុណ្ណោះ គឺ ៖
១៖ ការគោរព ប្រណិប័តន៍ សាសនា អ៊ីស្លាម ២៖ ការបរិច្ចាគ ទាន ៣៖ ការចែករំលែក ចំណេះដឹង ដល់ សាសនិក អ៊ីស្លាម និង មនុស្ស ទូទៅ ។
ជា ចុងក្រោយ លោក បាន ផ្តាំផ្ញើ ដល់ និស្សិត ទាំងអស់ ឲ្យ ចេះ បណ្តុះ គំនិត ទាំងអស់ តាំងពី នៅ រៀន ហើយ ត្រៀមខ្លួន ឲ្យបាន រួចរាល់ នៅពេល បញ្ចប់ ការសិក្សា និង ចេញ ទៅ ធ្វើការ តាម មន្ទីរពេទ្យ ។
ដំបូង គាត់ បាន ធ្វើដំណើរ ទៅ តំបន់ ជនបទ ដាច់ស្រយាល នៅក្នុង ប្រទេស កម្ពុជា ជាមួយ បុគ្គលិក មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ដើម្បី សាកសួរ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល បាន ដាក់ ពាក្យ បណ្តឹង ទៅកាន់ សាលា ក្តី ខ្មែរ ក្រហម អំពី បញ្ហា សុខភាព បន្ទាប់មក ទើប គាត់ ធ្វើ ការងារ លើ គម្រោង « ការលើកកម្ពស់ សិទ្ធិ និង ការធ្វើឲ្យ ប្រសើរឡើង នូវ ស្ថានភាព សុខភាព របស់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម » ដើម្បី ជួយ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល មាន អាយុ ចាប់ពី ៥០ ឆ្នាំ ឡើង ទៅ ។
ទោះបី យ៉ាងណា ភាពភ័យខ្លាច ដែល បន្សល់ទុក ដោយ របប ខ្មែរ ក្រហម បាន កើតឡើង អស់ ជាច្រើន ឆ្នាំ ដូច្នេះ រឿងរ៉ាវ ទាំងនេះ មិន គួរ ត្រូវបាន បំភ្លេច ចោល ឡើយ ខណៈ អ្នក រស់រាន មាន ជីវិត ពី អំពើ ឃោរឃៅ នេះ កាន់តែ មាន វ័យ ចំណាស់ ពិសេស ចាស់ ៗ នៅ តាម ទី ជនបទ ដាច់ស្រយាល នៅក្នុង ប្រទេស កម្ពុជា ។ ជាង ៤០ ឆ្នាំ បាន កន្លងផុត ទៅ ហើយ ហើយ ឥឡូវនេះ សំឡេង របស់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម នៅតែ ត្រូវបាន គេ ឮ ។
ស្នាម របួស និង ការចងចាំ មិន ល្អ របស់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ដែល បាន អូសបន្លាយ ពេល ជាច្រើន ឆ្នាំ កន្លងមក និង មិន បាន ចាកចេញ ឆ្ងាយ ពី ពួកគេ ឡើយ ។ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ស្ទើរតែ ទាំងអស់ សុទ្ធតែ មាន ជីវភាព ក្រីក្រ និង ទទួល រង ជំងឺ ដែល ទាក់ទង នឹង វ័យ ចំណាស់ គួបផ្សំ ជាមួយ ការខ្វះខាត ការយល់ដឹង អំពី ការថែទាំ សុខភាព និង កង្វះ លទ្ធភាព ទទួលបាន ការព្យាបាល នៅ តាម គ្លីនិក និង មន្ទីរពេទ្យ ។
មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា បាន ធ្វើ កិច្ចការ នេះ តាំងពី ដើម ឆ្នាំ ២០១៦មក ម្ល៉េះ ហើយ កម្រង សំណួរ ត្រូវបាន បង្កើតឡើង សម្រាប់ ប្រមូល ទិន្នន័យ ផ្ទាល់ខ្លួន និង បញ្ហា សុខភាព ដោយ ផ្អែក លើ រោគសញ្ញា នៃ ជំងឺ ទូទៅ និង ផល ប៉ះពាល់ ផ្លូវចិត្ត លើ សុខភាព របស់ អ្នក រស់រាន មាន ជីវិត ពី របប ខ្មែរ ក្រហម ។ បន្ទាប់ពី រយៈពេល ជាង ១ ឆ្នាំ ដែល ស្ទើរតែ ៩៥ ភាគរយ នៃ អ្នករស់រាន មាន ជីវិត ពី ខ្មែរ ក្រហម ចំនួន ១៧៥០ រស់ នៅក្នុង ខេត្ត ចំនួន ៧ ត្រូវបាន សម្ភាសន៍ ពិនិត្យ សុខភាព និង ព្យាបាល តាម ការណែនាំ ពី វេជ្ជបណ្ឌិត ។
