សេចក្ដីប្រកាស ព័ត៌មាន បាន ឱ្យដឹង ថា នា ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២៣ គណៈកម្មាធិការ អចិន្រ្តៃយ៍ ព្រឹទ្ធសភា បាន រៀបចំ កិច្ចប្រជុំ មួយ ក្រោម អធិបតីភាព សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ។ បន្ទាប់ពី បាន ពិនិត្យ និង ពិភាក្សា រួច មក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ ព្រឹទ្ធសភា បាន កំណត់ យក ថ្ងៃចន្ទ ទី១០ ខែមេសា ឆ្នាំ ២០២៣ វេលា ម៉ោង ៨៖០០ នាទី ព្រឹក ដើម្បី បន្ត សម័យ ប្រជុំ លើក ទី១០ ព្រឹទ្ធសភា នីតិកាល ទី៤ ។
ចំពោះ រោងចក្រ សហគ្រាស ទាំងឡាយ ណា ដែល កម្មវត្ថុ អាជីវកម្ម មាន ចរិត លក្ខណៈ សកល ត្រូវ ប្រព្រឹត្តទៅ ជាប្រចាំ និង មិន អាច បញ្ឈប់ សកម្មភាព បាន ហើយ ការឈប់ សម្រាក បុណ្យ នៃ កម្មករ និយោជិត ទាំងអស់ ព្រម គ្នា ក្នុង ពេល តែ មួយ នាំឱ្យ ខូច ប្រយោជន៍ ដល់ សាធារណជន ឬក៏ ធ្វើឱ្យ ខូច ដំណើរការ របស់ រោងចក្រ សហគ្រាស នោះ ម្ចាស់ ឬ នាយក រោងចក សហគ្រាស ត្រូវ រៀបចំ បែងចែក ឱ្យ កម្មករ និយោជិត បាន ឈប់ សម្រាក ទៅ តាម ថ្ងៃ បុណ្យ នីមួយ ៗ ដោយ ផ្លាស់ប្ដូរ វេន គ្នា ។
កម្មករ និយោជិត ដែល ធ្វើការ ថ្ងៃ ឈប់បុណ្យ ចូល ឆ្នាំ ថ្មី នេះ មាន សិទ្ធិ ទទួល នូវ ប្រាក់ បំណាច់ បន្ថែម ដែល មាន ចំនួន ស្មើនឹង ប្រាក់ ឈ្នួល ថ្ងៃ ធ្វើ ការធម្មតា ។ ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ត្រូវ រៀបចំ បញ្ជី ឈ្មោះ កម្មករ និយោជិត ដែល ត្រូវ ផ្លាស់ប្តូរ គ្នា ឈប់ សម្រាក តាម កាលបរិច្ឆេទ នីមួយ ៗ ខាងលើ និង រក្សាទុក ជាប្រចាំ សម្រាប់ ការត្រួតពិនិត្យ របស់ អធិការ ការងារ ។
ក្រសួង ការងារ បាន ក្រើន រំលឹក ដល់ ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស និង កម្មករ និយោជិត ទាំងអស់ ត្រូវ បន្ត ចូលរួម អនុវត្ត វិធានការ ៣ការពារ និង ៣កុំ និង វិធានការ សុវត្ថិភាព ផ្នែក សុខាភិបាល ផ្សេង ទៀត ឱ្យ បាន ខ្ជាប់ខ្ជួន ៕ មន្ត្រីរាជការ អ្នកអភិរក្ស ពលរដ្ឋ និង សិស្សានុសិស្ស ជាង ៣០០ នាក់ ចាប់ផ្តើម ដង្ហែ ក្បួន បើក យុទ្ធនាការ អន្ទាក់ សូន្យ លើក ទី២ នៅ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ មន្ត្រី ក្រសួង បរិស្ថាន អង្គការ សង្គម ស៊ីវិល និង ក្រុម អ្នកសារព័ត៌មាន ព្រមទាំង រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ និង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ ជាង ៣០០ នាក់ បាន ដង្ហែ ក្បួន បើក យុទ្ធនាការ អន្ទាក់ សូន្យ លើក ទី២ នៅ ទី ខេត្ត ពោធិ៍សាត់ នៅ ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
យុទ្ធនាការ អន្ទាក់ សូន្យ លើក ទី២ នៅ ខេត្ត ពោធិ៍សាត់ ក្នុង គោលបំណង សំខាន់ កាត់បន្ថយ និង ទប់ស្កាត់ ចំនួន អន្ទាក់ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ក្នុង ខេត្ត ពោធិ៍សាត់ ក៏ ដូចជា នៅក្នុង តំបន់ ការពារ ធម្មជាតិ នានា នៅក្នុង ប្រទេស កម្ពុជា និង បណ្តុះ ស្មារតី ស្រឡាញ់ សត្វ ព្រៃ កាន់តែ ខ្លាំង ឡើង ក្នុង ចំណោម សាធារណជន ។
រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន គូសបញ្ជាក់ ថា យុទ្ធនាការ អន្ទាក់ សូន្យ រៀបចំឡើង ក្នុង គោលដៅ បន្ត បង្កើន ការយល់ដឹង របស់ សាធារណជន ទៅ អំពី ផលវិបាក នៃ ការដាក់ អន្ទាក់ សត្វ ព្រៃ ការជួញដូរ សត្វ ព្រៃ និង ការបរិភោគ សាច់ សត្វ ព្រៃ ក្នុង នោះ រួម មាន ហានិភ័យ ចំពោះ សុខភាព សាធារណៈ និង ការបាត់បង់ ធនធាន ធម្មជាតិ ផងដែរ ។ យុទ្ធនាការ ក៏ នឹង បន្ត ផ្សព្វផ្សាយ ឱ្យ កាន់តែ ទូលំទូលាយ អំពី ភាពចាំបាច់ ក្នុង ការអភិរក្ស សត្វ ព្រៃ និង ធនធាន ធម្មជាតិ ដ៏ សម្បូរបែប របស់ កម្ពុជា ដើម្បី គាំទ្រ ដល់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា ខេត្ត ពោធិ៍សាត់ មាន តំបន់ ការពារ ធម្មជាតិ ចំនួន ០៦ គឺ ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវាញ ខាងត្បូង ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវាញ កណ្ដាល ដែន ជម្រក សត្វ ព្រៃ ភ្នំ សំកុស ដែន ជម្រក សត្វ ព្រៃ ភ្នំ ឱរ៉ាល់ តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង បឹង ទន្លេ សាប និង របៀង អភិរក្ស ជីវៈ ចម្រុះ ប្រព័ន្ធ តំបន់ ការពារ ធម្មជាតិ មាន ផ្ទៃដី សរុប ៦៨៩. ២៩៧ ហិកតា ។
ជម្លោះ ក្នុង គ្រួសារ ! បុរស ម្នាក់ បាញ់ សម្លាប់ ប្រពន្ធ និង បង ថ្លៃ រួច បាញ់ សម្លាប់ ខ្លួន តាម ក្រោយ ទាំង ព្រឹក នៅ ក្រុង សៀមរាប
( សៀមរាប ) ៖ សេចក្ដីរាយការណ៍ ជំហាន ដំបូង បាន ឲ្យដឹង ថា នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២៣ នេះ មាន ហេតុការណ៍ បាញ់ប្រហារ មួយ កើតឡើង នៅ ក្រុង សៀមរាប ខេត្ត សៀមរាប ។ ក្នុង ហេតុការណ៍ នេះ មាន បុរស ម្នាក់ បាញ់ សម្លាប់ ប្រពន្ធ និង បង ថ្លៃ រួច បាញ់ សម្លាប់ ខ្លួន តាម ក្រោយ បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ។
សាក្សី នៅ កន្លែង កើត ហេតុ បាន អះអាង ថា ដើម ឡើយ ខ្មាន់ កាំភ្លើង បាន បាញ់ ប្រពន្ធ នៅក្នុង ផ្ទះ រួច ដើរ ទៅ បាញ់ បង ថ្លៃ ដែល កំពុង អង្គុយ លក់ បន្លែ ទើប បាញ់ ក្បាល ខ្លួន ឯង តាម ក្រោយ ដើម្បី បញ្ចប់ ជីវិត ។
ប្រភព ព័ត៌មាន បាន បន្ដ ទៀត ថា ខ្មាន់ កាំភ្លើង និង ប្រពន្ធ ទើបតែ លែងលះ គ្នា ហើយ ការបាញ់ប្រហារ នេះ សង្ស័យ ផ្ដើម ចេញ ពី ជម្លោះ ទ្រព្យសម្បត្តិ ។ យ៉ាងណា ក៏ដោយ សមត្ថិច្ច មិន ទាន់ បញ្ជាក់ លម្អិត នៅឡើយ ទេ ជុំវិញ ហេតុការណ៍ នេះ ។
ក្រោយ កើត ហេតុ ប្រពន្ធ និង បង ថ្លៃ របស់ ខ្មាន់ កាំភ្លើង ត្រូវបាន ប្រជាពលរដ្ឋ បញ្ជូន ទៅ មន្ទីរពេទ្យ ខណៈ ខ្មាន់ កាំភ្លើង ទំនង ស្លាប់ នៅ កន្លែង កើត ហេតុ ដោយសារ បាញ់ ខ្លួន ឯង ចំ ក្បាល ៕
កាណាដា បញ្ជូន យន្ដហោះ យោធា ទៅ ជប៉ុន ដើម្បី ពង្រឹង ទណ្ឌកម្ម ប្រឆាំង កូរ៉េ ខាងជើង (Video inside) ( អូតាវ៉ា ) ៖ កាណាដា នៅ ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ បាន និយាយ ថា ខ្លួន នឹង បញ្ជូន យន្ដហោះ យោធា មួយ គ្រឿង ទៅកាន់ ប្រទេស ជប៉ុន ដើម្បី គាំទ្រ ដល់ អនុវត្ត ក៏ ដូចជា ពង្រឹង ការដាក់ទណ្ឌកម្ម របស់ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ប្រឆាំង នឹង កូរ៉េ ខាងជើង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP នៅ ថ្ងៃសុក្រ ទី៧ ខែមេសា ឆ្នាំ ២០២៣ ។
គួរ បញ្ជាក់ ថា កូរ៉េ ខាងជើង បាន ជាប់ នៅក្រោម ទណ្ឌកម្ម អង្គការ សហ ប្រជាជាតិ ចាប់តាំងពី ឆ្នាំ ២០០៦ មក ជុំវិញ ការធ្វើតេស្ដមីស៊ីល បាលិស្ទី គ និង អាវុធ នុយក្លេអ៊ែរ ។ តែ មិន មាន ដំណោះស្រាយ ជាមួយ ទីក្រុង ព្យុងយ៉ាង នោះ ទេ ខណៈ ជារឿយ ៗ ចិន និង រុស្ស៉ី តែងតែ បោះឆ្នោត វេតូ ដើម្បី ការពារ កូរ៉េ ខាងជើង ៕ គម្រោង អភិវឌ្ឍន៍ ថាមពល អគ្គិសនី ចំនួន ៥ទៀត ត្រូវបាន រាជ រដ្ឋាភិបាល សម្រេច ឱ្យ វិនិយោគ
( ភ្នំពេញ ) ៖ គម្រោង អភិវឌ្ឍន៍ ថាមពល អគ្គិសនី ចំនួន ៥ទៀត ដែល មាន អានុភាព សរុប ៥២០ មេហ្គាវ៉ាត់ ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច ឱ្យ វិនិយោគ ។ ការសម្រេច បាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នា ព្រឹក ថ្ងៃសុក្រ ទី ០៧ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
គម្រោង វិនិយោគ ផលិត ថាម អគ្គិសនី ទាំង៥ ដែល រាជ រដ្ឋាភិបាល សម្រេច ឱ្យ វិនិយោគ នេះ រួម មាន៖ ១៖ គម្រោង វារី អគ្គិសនី ស្ទឹង ឬ ស្សី ជ្រុំ កណ្ដាល និង វារី អគ្គិសនី ស្ទឹង វាយ ថ្ម កំបុត ( ផ្គួប គ្នា ) . ២៖ គម្រោង ស្ថានីយ អគ្គិសនី ពន្លឺ ព្រះអាទិត្យ ៤គម្រោង ( នៅ ខេត្ត ពោធិ៍សាត់ ១គម្រោង ខេត្ត កំពង់ឆ្នាំង ១គម្រោង ខេត្ត ស្វាយរៀង ១គម្រោង និង ខេត្ត ព្រៃវែង ១គម្រោង ) ។
លោក ផៃ ស៊ីផាន រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន ឱ្យដឹង ថា គម្រោង វិនិយោគ ផលិត ថាមពល អគ្គិសនី ទាំង៥ នេះ នឹង ធ្វើឱ្យ កម្ពុជា ទទួលបាន អគ្គិសនី ពី ប្រភព ថាមពល ស្អាត កាត់បន្ថយ ការប្រើប្រាស់ ឥន្ធនៈ ដែល បញ្ចេញ ឧស្ម័ន កាបូន ច្រើន និង ធានា រក្សា បាន នូវ បរិស្ថាន ធនធាន ធម្មជាតិ និង ការប្រែប្រួល អាកាសធាតុ ។
គម្រោង ទាំង ៥នេះ ក៏ ជួយ ឱ្យ ធានា បាន អត្រា ថ្លៃ ប្រភព អគ្គិសនី មួយ ដែល ថេរ ២០ ឆ្នាំ សម្រាប់ គម្រោង ថាមពល ពន្លឺ ព្រះអាទិត្យ និង ៤០ ឆ្នាំ សម្រាប់ គម្រោង វារី អគ្គិសនី . នាំមក នូវ បច្ចេកវិទ្យា ថ្មី ផ្តល់ ការងារ ជូន ប្រជាពលរដ្ឋ ទាំង ក្នុង ពេល សាងសង់ និង ដំណើរការ ។
បន្ថែម ពីលើ នេះ ឈើ លើ មូលដ្ឋាន នៃ ច្បាប់ ស្តីពី សារពើពន្ធ ដែល មាន ជាធរមាន នោះ គម្រោង វិនិយោគ ទាំង ៥នេះ នឹង ជួយ ឱ្យ រាជ រដ្ឋាភិបាល ទទួលបាន ចំណូល ពន្ធ សរុប ប្រមាណ ៣២២. ៨៨០. ៣៨២ ដុល្លារ អាមេរិក ក្នុង រយ: ពេល អាជីវកម្ម នៃ គម្រោង ទាំង ៥ ដោយ មិន ទាន់ គិត បញ្ចូល ចំណូល ពន្ធ មួយ ចំនួន ទៀត ដូចជា ពន្ធ លើ ប្រាក់ បៀវត្សរ៍ ពន្ធ កាត់ទុក លើ ការជួល នានា និង ពន្ធ ដោយ ប្រយោល ដ៏ទៃ ទៀត ព្រមទាំង ពន្ធ ដទៃ ទៀត ដែល អគ្គិសនី កម្ពុជា និង អ្នកចែកចាយ អគ្គិសនី ដទៃ ទៀត ត្រូវ បង់ នៅឡើយ ។
ការអភិវឌ្ឍន៍ ប្រភព ថាមពល អគ្គិសនី គឺជា កិច្ចការ មួយ ដែល រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា យកចិត្តទុកដាក់ ខ្ពស់ ដើម្បី បំពេញការប្រើប្រាស់ របស់ ប្រជាពលរដ្ឋ និង បំពេញ ទៅ លើ ការប្រើប្រាស់ ក្នុង វិស័យ ឧស្សាហកម្ម ទេសចរណ៍ វិស័យ កសិកម្ម ក៏ ដូចជា វិស័យ ដទៃ ទៀត ។
របាយការណ៍ របស់ ក្រសួង រ៉ែ និង ថាមពល បាន ឱ្យដឹង ថា គិត ត្រឹម ឆ្នាំ ២០២២ កម្ពុជា មាន ទំហំ ប្រភព អគ្គិសនី សរុប ៤.២៤៦. ៧៧ មេហ្គាវ៉ាត់ ។ ក្នុង នោះ ៣. ១១៦. ៤២ មេហ្គាវ៉ាត់ ស្មើនឹង ជាង ៧៣ ភាគរយ ជា ប្រភព អគ្គិសនី បាន ពី ការអភិវឌ្ឍ ក្នុង ស្រុក ហើយ ១. ១៣០. ៧៥ មេហ្គាវ៉ាត់ ស្មើនឹង ជាង ២៦ ភាគរយ ជា ប្រភព អគ្គិសនី ដែល បាន នាំចូល ពី ប្រទេស ជិតខាង ។
របាយការណ៍ បាន ឱ្យដឹង ដែរ ថា គិត ត្រឹម ចុង ឆ្នាំ ២០២២ ផ្ទះ របស់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស សរុប ប្រមាណ ៣. ៧២លាន ខ្នង ផ្ទះ ទទួលបាន ការផ្គត់ផ្គង់ អគ្គិសនី ពី បណ្តាញ ជាតិ ស្មើនឹង ប្រមាណ ៩០ ភាគរយ ៕ សាលា ខណ្ឌ ព្រែក ព្នៅ រៀបចំ ពិធី សូត្រ មន្ត ចម្រើន ព្រះបរិត្ត ដើម្បី ប្រសិទ្ធ ពរ ជ័យ សិរី មង្គល ក្នុង ឱកាស ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ
លោក ធឹម សំអាន បាន ឲ្យដឹង ថា ជារៀងរាល់ ឆ្នាំ នៅពេល ឆ្នាំ ថ្មី ចូល មកដល់ លោក ព្រមទាំង មន្រ្តី ចៅសង្កាត់ តែងតែ ជួបជុំគ្នា និមន្ដ ព្រះសង្ឃ បង្សុកូល ដើម្បី កាត់ផ្ដាច់ នូវ រាល់ ឧបទ្រព ចង្រៃ នៅក្នុង ឆ្នាំ ចាស់ ចាប់ យក សិរី សួរ ស្ដី នៅក្នុង ឆ្នាំ ថ្មី ឲ្យ ពរ ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ ជូន ប្រជាពលរដ្ឋ នា ឱកាស អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ។
លោក អភិបាល ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ នៅក្នុង ខណ្ឌ ព្រែក ព្នៅ ទាំងអស់ នៅក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ខាងមុខ នេះ ចៀសវាង ការលេង ប៉ាត ម្សៅ ជះ ទឹក ដាក់ គ្នា ព្រោះ នេះ មិន មែន ជា ប្រពៃណី ខ្មែរ ទេ និង ត្រូវ មាន ការប្រុងប្រយ័ត្ន នូវ រាល់ ភ្លើង ធូប ទៀន គ្រោះ អគ្គិភ័យ ជា យថាហេតុ ។
គួរ បញ្ជាក់ ថា យោធា អ៉ី ស្រាអែល កាលពី យប់ ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ ក៏ បាន ដឹកនាំ ការវាយប្រហារ តាម ផ្លូវ អាកាស មួយ លើ តំបន់ ហ្កាហ្សា ដែនដី ប៉ាឡេស្ទីន ផងដែរ ក្រោយ នាយក រដ្ឋមន្ត្រី លោក Benjamin Netanyahu បាន ថ្លែង សារ នៅក្នុង វីដេអូ មួយ ដោយ សន្យា ថា នឹង ធ្វើឱ្យ សត្រូវ របស់ អ៉ី ស្រាអែល តបស្នង មកវិញ នូវ តម្លៃ មួយ យ៉ាង ស័ក្តិសម សម្រាប់ សកម្មភាព ឈ្លានពាន ទាំងឡាយ បន្ទាប់ពី មាន សេចក្តីរាយការណ៍ ថា មាន គ្រាប់ រ៉ុក្កែត បាញ់ ចេញ ពី ទឹកដី លី បង់ ចូលក្នុង ទឹកដី អ៉ី ស្រាអែល ។
ការវាយប្រហារ ខាងលើ កើត មាន ឡើង ចំពេល អ៉ី ស្រាអែល និង ប៉ាឡេស្ទីន កំពុង តានតឹង នឹង គ្នា ជាថ្មី បន្ទាប់ពី កងកម្លាំង អ៉ី ស្រាអែល បើក ការវាយឆ្មក់ លើ អ្នក ថ្វាយបង្គំ ជា ជនជាតិ ប៉ាឡេស្ទីន នៅឯ វិហារ អាល់ អឹក ស (Al-Aqsa) ៕
ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី ពិភាក្សា លើ សេចក្តីព្រាង ផែនការជាតិ ស្តីពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក និង គម្រោង អភិវឌ្ឍន៍ ថាមពល អគ្គិសនី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសុក្រ ទី ០៧ ខែមេសា ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី ដើម្បី ពិនិត្យ និង ពិភាក្សា លើ របៀបវារៈសំខាន់ ៗ ចំនួន ៣ ។
យោង តាម ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា របៀបវារៈ ដែល នឹង លើក មក ពិនិត្យ និង ពិភាក្សា នា ព្រឹក នេះ រួម មាន៖
ការវាយប្រហារ ខាងលើ ពីសំណាក់ យោធា អ៉ី ស្រាអែល កើត មាន ឡើង ក្រោយ មាន សេចក្ដីរាយការណ៍ ពី ស្នូរ សំឡេង ផ្ទុះ នៅ ទូទាំង តំបន់ ហ្កាហ្សា ខណៈ យន្ដហោះ ចម្បាំង ហោះ ពេញ អាកាស ។ ភ្លាម ៗ មិន ទាន់ មាន ការបញ្ជាក់ ថា តើ មាន អ្នកស្លាប់ ឬ រងរបួស នៅក្នុង ការវាយប្រហារ នេះ នោះ ទេ ។ ប៉ុន្តែ ទីតាំង ជាច្រើន កន្លែង ក្នុង តំបន់ ហ្កាហ្សា ដែល ជា មូលដ្ឋាន របស់ ក្រុមហា ម៉ាស់ ប៉ាឡេស្ទីន បាន រង ការវាយប្រហារ ដោយ មីស៊ីល ។
គួរ បញ្ជាក់ ថា បើ តាម ខាង យោធា អ៉ី ស្រាអែល ការវាយប្រហារ តាម ផ្លូវ អាកាស របស់ ខ្លួន មាន គោលដៅ រូង ក្រោម ដី ២កន្លែង និង មូលដ្ឋាន ស្ដុក អាវុធ ២កន្លែង ក្នុង តំបន់ ហ្កាហ្សា ហើយ ព្រម ពេល ជាមួយគ្នា ក៏ មាន ការបាញ់ រ៉ុក្កែត តបត ចេញពី តំបន់ ហ្កាហ្សា វិញ ផងដែរ ៕
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ត្រឡប់មក ផ្ទះ វិញ ដោយ សុវត្ថិភាព ! ស្លាប់ ២នាក់ និង របួស ៣នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៦ ខែមេសា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ៣នាក់ ។
ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២៣ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ កូរ៉េ ខាងជើង ថា សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង កំពុង រុញ ច្រាន ឧបទ្វីប កូរ៉េ ទៅកាន់ មាត់ ជ្រោះ នៃ សង្រ្គាម នុយក្លេអ៊ែរ
២៖ តៃវ៉ាន់ អះអាង ថា ឧទ្ធម្ភាគចក្រ ១គ្រឿង និង នាវា ចម្បាំង ៣គ្រឿង របស់ ចិន ធ្វើ សកម្មភាព ជុំវិញ ដែន កោះ របស់ ខ្លួន
៣៖ លោក ពូទីន បើក កិច្ចពិភាក្សា ជាមួយ មេដឹកនាំ បេឡារុស តែ មិន និយាយ ពី អ៊ុយក្រែន ជាសាធារណៈ
៤៖ ប្រធានា ធីបតី បារាំង ជួប នាយក រដ្ឋមន្រ្តី ចិន ខណៈ មេដឹនាំ អឺរ៉ុប ចាប់ផ្តើម កិច្ចពិភាក្សា នៅ ទីក្រុង ប៉េកាំង
៦៖ លោក បៃ ដិន ទទួលយក ការអញ្ជើញ ទៅ បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ ពីសំណាក់ ព្រះមហាក្សត្រចក្រភព អង់គ្លេស កម្ពុជា បង្ហាញ សមិទ្ធផល ជោគជ័យ វិស័យ សុខាភិបាល ក្នុង ពិធី អបអរសាទរ គម្រប់ ខួប លើក ទី ៧៥ របស់ អង្គការ សុខភាព ពិភពលោក
( ភ្នំពេញ ) ៖ នា ឱកាស ទិវា សុខភាព ពិភពលោក នា ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២៣ រាជ រដ្ឋាភិបាល កម្ពុជា និង អង្គការ សុខភាព ពិភពលោក (WHO) បាន បង្ហាញ សមិទ្ធផល ជោគជ័យ វិស័យ សុខាភិបាល គួរឱ្យ កត់សម្គាល់ ជាច្រើន ដែល សម្រេចបាន នៅ កម្ពុជា ដើម្បី អបអរសាទរ គម្រប់ ខួប លើក ទី ៧៥ នៃ ការបង្កើត អង្គការ សុខភាព ពិភពលោក (WHO) នា ឆ្នាំ ១៩៤៨ ក្រោម ប្រធានបទ « សុខភាព សម្រាប់ ទាំងអស់ គ្នា » និង ជា ការចាប់ផ្ដើម យុទ្ធនាការ រយៈពេល ពេញ មួយ ឆ្នាំ ប្រារព្ធ ពិធី អបអរសាទរ ។
ព្រះរាជាណាចក្រ កម្ពុជា ក៏ សូម វាយតម្លៃ ខ្ពស់ និង កោតសរសើរ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ បុគ្គលិក ថែទាំ សុខភាព សហគមន៍ និង មន្ត្រី សុខាភិបាល គ្រប់ លំដាប់ថ្នាក់ សហគមន៍ និង ប្រជាជន កម្ពុជា ទាំងអស់ ដែល បាន សហការ ជាមួយ អង្គការ សុខភាព ពិភពលោក និង ដៃគូ សុខាភិបាល ជាច្រើន ផ្សេង ទៀត ក្នុង ការចូលរួមចំណែក ធ្វើឱ្យ ប្រជាជន កម្ពុជា កាន់តែ មាន សុខ សុវត្ថិភាព និង សុខភាពល្អ ប្រសើរ ” ។
ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង នាម ជា រដ្ឋ សមាជិក ដ៏ សកម្ម របស់ អង្គការ សុខភាព ពិភពលោក កម្ពុជា ប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ ក្នុង ការលើកកម្ពស់ និង គាំពារ សុខភាព សាធារណៈ និង សមធម៌ សុខាភិបាល នៅក្នុង ប្រទេស ក៏ ដូចជា នៅ ជុំវិញ ពិភពលោក ហើយ យើង ពិតជា មាន មោទនភាព យ៉ាង ក្រៃលែង ដែល « យើង គឺជា អង្គការ WHO» ។
ជំងឺ មិន ឆ្លង (NCDs) ក៏ កំពុង មាន ការកើនឡើង គួរឱ្យ កត់សម្គាល់ ហើយ បាន ក្លាយជា កត្តា បណ្តាលឱ្យ មាន អត្រា មរណភាព ប៉ាន់ស្មាន ប្រមាណ ២ភាគ ៣ នៃ ចំនួន មរណភាព ទូទៅ នៅក្នុង ប្រទេស ដែល កម្ពុជា ចាំបាច់ ត្រូវ ពង្រឹង ការគាំពារ និង ការទប់ស្កាត់ ជំងឺ មិន ឆ្លង ព្រមទាំង ត្រូវ ដោះស្រាយ តម្រូវការ របស់ ប្រជាជន វ័យ ចំណាស់ នា ពេល អនាគត ផងដែរ ។
កាលពី ខែមីនា កន្លងមក នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន រៀបចំ កិច្ចសន្ទនា ប្រចាំ ឆ្នាំ ជាមួយ ក្រុមការងារ ប្រចាំ ប្រទេស របស់ អង្គការ សហ ប្រជាជាតិ ដែល កិច្ចពិភាក្សា បាន ផ្តោត ទៅ លើ ការពង្រឹង ប្រព័ន្ធ សុខាភិបាល ឆ្ពោះ ទៅរក ការគ្របដណ្តប់ សុខភាព ជា សកល និង ការពង្រីក វិសាលភាព កិច្ច គាំពារ សង្គម ដែល កត្តា ទាំង ពីរ នេះ ពិតជា មាន សារៈសំខាន់ ណាស់ ក្នុង ការសម្រេចបាន នូវ គោលដៅ ដែល បាន កំណត់ នៅក្នុង គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ កម្ពុជា ។
ការណែនាំ របស់ នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក ធ្វើឡើង ក្នុង ពិធី ប្រកាស មុខតំណែង ជូន នាយ ទាហាន ជាន់ ខ្ពស់ និង ប្រជុំ បូកសរុប លទ្ធផល ការងារ ត្រីមាស ទី១ និង ទិសដៅ ត្រីមាស ទី២ ឆ្នាំ ២០២៣ របស់ កងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ ។
នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត ក៏ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ថ្នាក់ដឹកនាំ មេបញ្ជាការ មេបញ្ជាការ រង គ្រប់ លំដាប់ថ្នាក់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទូទាំង កងទ័ព ជើងគោក ដែល ក្នុង រយៈកាល ត្រីមាស ដើម ឆ្នាំ ២០២៣ នេះ បាន ខិតខំ ប្រឹងប្រែង រួមគ្នា បំពេញ តួនាទី - ភារកិច្ច ទទួលបាន លទ្ធផល ល្អ ប្រសើរ ស្រប តាម ផែនការ ដែល បាន ដាក់ចេញ ក៏ ដូចជា ការឆ្លើយតប បាន ទាន់ ពេលវេលា និង ប្រកបដោយ ប្រសិទ្ធភាព ចំពោះ ស្ថានការណ៍ ជា យថាហេតុ ផ្សេង ៗ ។
លោក បន្ដ ថា ស្នាដៃ និង សមិទ្ធផល ការងារ ដែល សម្រេចបាន មក នេះ គឺ ពិតជា បាន ឆ្លុះបញ្ចាំង ឲ្យ ឃើញ អំពី ឆន្ទៈ មនសិការ និង ការប្តេជ្ញាចិត្ត ខ្ពស់ របស់ ថ្នាក់ដឹកនាំ និង យោធិន យើង ក្នុង ការតស៊ូ ប្រឹងប្រែង បំពេញ តួនាទី - ភារកិច្ច បម្រើ ជាតិ មាតុភូមិ និង ប្រជាជន ស្រប តាម រដ្ឋធម្មនុញ្ញ ច្បាប់ នយោបាយ ការពារ ជាតិ និង បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ដោយ មិន គិត ពី ការនឿយហត់ និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ រួមផ្សំ នឹង គំនិត ច្នៃប្រឌិត ទៅ តាម សភាពការណ៍ ជាក់ស្តែង ចំពោះ មុខ ៕
លោក បាន ពណ៌នា ឧបទ្ទវហេតុ នេះ ថា ជា « ឧក្រិដ្ឋកម្ម ដ៏ សាហាវ ក៏ ដូចជា ឧទាហរណ៍ ជាក់ស្តែង មួយ ទៀត នៃ ការឈ្លានពាន របស់ អ៊ីស្រាអែល ជាប់ លាប់ និង ជា ការបំពាន យ៉ាង ធ្ងន់ធ្ងរ លើ ច្បាប់ អន្តរជាតិ នៅលើ ទឹកដី ស៊ីរី » ។
លោក បាន អំពាវនាវ ដល់ សហគមន៍ អន្តរជាតិ និង ជាពិសេស ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ឱ្យ ចាត់ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ ដើម្បី បញ្ឈប់ ការបំពាន បែប នេះ ហើយ ឱ្យ អ៊ីស្រាអែល ទទួលខុសត្រូវ ចំពោះ រាល់ សកម្មភាព ប្រឆាំង ច្បាប់ អន្តរជាតិ របស់ ខ្លួន ។
គួរ បញ្ជាក់ ថា យោង តាម ទូរទស្សន៍ ជាតិ ស៊ីរី បាន ឲ្យដឹង ថា អ៊ីស្រាអែល បាន បើក ការវាយប្រហារ ដោយ កាំ ជ្រួច ចំនួន ពីរ លើ ទីតាំង ក្នុង ទីក្រុង Damascus កាលពី ថ្ងៃព្រហស្បតិ៍ និង ថ្ងៃសុក្រ សប្តាហ៍ មុន ៕
រដ្ឋបាល ក្រុង បាវិត និង ស្រុក បេន កូវ និង ទី រួម ខេត្ត ត្រាំង បាង ប្រទេស វៀតណាម បើក កិច្ចប្រជុំ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ទ្វេរ ភាគី និង រៀបចំ អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ
( ស្វាយរៀង ) ៖ លោក ណេប សារ៉ុន ប្រធាន ក្រុមប្រឹក្សា ក្រុម បាវិត និង លោក លឹម សៀង ហេង អភិបាល ក្រុង បាវិត រួម និង កងកម្លាំង ទាំង បី មន្ត្រីរាជការ ក្រុង នៅ រសៀល ថ្ងៃទី ៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ កិច្ចប្រជុំ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ទ្វេរ ភាគី ដើម្បី បង្កើន ចំណង សាមគ្គីភាព មិត្តភាព ជាមួយ ស្រុក ជាប់ ព្រំដែន រវាង ក្រុង បាវិត និង ស្រុក បេន កូវ និង ទី រួម ខេត្ត ត្រាំង បាង ប្រទេស វៀតណាម និង រៀបចំ ពិធី អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៦ គ. ស២០២៣ ។
ពិធី អបអរសាទរ ចូល ឆ្នាំ ថ្មី នេះ ដែរ ក៏ មាន ការចូលរួម ជូនពរ ពី ភាគី វៀតណាម លោក វ៉ វ៉ន់ យុង លេខា បក្ស ថ្មី មុខេត្ត ត្រាង បាង . លោក ហូ វ៉ន់ ហុង អនុអចិន្ត្រៃយ៍ គណបក្ស និង ជា ប្រធាន ក្រុមប្រឹក្សា ប្រជាជន ទី រួម ខេត្ត ត្រាង បាង . លោក គ្រឹង ទឿង ង៉ុក ប្រធាន គណៈកម្មាធិការ ប្រជាជន ទី រួម ខេត្ត ត្រាង បាង និង គណៈប្រតិភូ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក បាន បន្ត ថា ចំពោះ ការងារ សន្តិសុខ មាន លក្ខណៈ ល្អ ប្រសើរ ដោយ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង បាន យកចិត្តទុកដាក់ ក្នុង ការថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សង្គម និង បាន យកចិត្តទុកដាក់ អនុវត្ត នូវ គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្តិភាព នៅក្នុង មូលដ្ឋាន ក្រុង បាវិត ដើម្បី ទប់ស្កាត់ បង្ការ បង្ក្រាប នូវ បទល្មើស នានា ដូចជា បង្ក្រាប បទល្មើស គ្រឿងញៀន ខុស ច្បាប់ ល្បែងស៊ីសង ខុស ច្បាប់ ចោ លួច ឆក់ ប្លន់ និង ក្មេង ទំនើង និង ការរិត បន្តឹង នូវ ការអនុវត្ត ច្បាប់ ចរាចរ ផ្លូវគោក ។
លោក អភិបាល ក្រុង បាវិត ក៏ បាន បង្ហាញ ក្តីសង្ឃឹម យ៉ាង មុខ មាំ ថា ចំណង សាមគ្គី មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ រវាង ប្រទេស កម្ពុជា និង ប្រទេស វៀតណាម ដោយឡែក ក្រុង បាវិត ស្រុក ឃេន កូវ និង ទី រួម ខេត្ត គ្រោង បាង ក៏ ទទួលបាន លទ្ធផល វិជ្ជមាន ប្រកបដោយ ផ្លែផ្កា ផងដែរ ដែល ជា ការចូលរួមចំណែក យ៉ាង ធំធេង នៅក្នុង ការ ពង្រឹង ចំណង សាមគ្គីភាព ឲ្យ កាន់តែ រឹងមាំ ទ្វេ ឡើង ឆ្ពោះ ទៅ ការសម្រេច រួមគ្នា នូវ ការកសាង តំបន់ ព្រំដែន សន្តិភាព មិត្តភាព កិច្ចសហការ ប្រតិបត្តិការ និង ការអភិវឌ្ឍ ៕
និយ័តករ សន្តិសុខ សង្គម រៀបចំ សិក្ខាសាលា ផ្សព្វផ្សាយ ស្តីពី ការធ្វើ និយ័តកម្ម និង ការត្រួតពិនិត្យ ប្រព័ន្ធ សន្តិសុខ សង្គម នៅ កម្ពុជា
លោក រស់ សីល វ៉ា រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ថ្លែង ថា ប្រព័ន្ធ សន្តិសុខ សង្គម នៅ កម្ពុជា គឺ នៅ មាន ភាព ក្មេងខ្ចី ដែល ទាមទារ ឱ្យ មាន ការយកចិត្តទុកដាក់ ខ្ពស់ បំផុត ជាពិសេស ក្នុង ដំណាក់កាល ដំបូង នៃ ការអភិវឌ្ឍ នេះ ដើម្បី កសាង ប្រព័ន្ធ សន្តិសុខ សង្គម មួយ ប្រកបដោយ ភាពជោគជ័យ និង និរន្តភាព ។
លោក បន្ថែម ថា « វត្តមាន របស់ និយ័តករ សន្តិសុខ សង្គម មាន សារៈសំខាន់ ណាស់ ក្នុង ការធានា ថា ដំណើរការ គ្រប់គ្រង និង ការចាត់ចែង របប សន្តិសុខ សង្គម នានា ត្រូវបាន អនុវត្ត ប្រកបដោយ ភាពត្រឹមត្រូវ តម្លាភាព និង គណនេយ្យភាព ចំពោះ សាធារណជន ជាពិសេស ចំពោះ និយោជក និង កម្មករ - និយោជិត ដែល មាន កាតព្វកិច្ច បង់ ភាគ ទាន ចូល ទៅក្នុង មូលនិធិ រួមគ្នា » ។
លោក លើកទឹកចិត្ត ឱ្យ សមាជិក - សមាជិការ នៃ អង្គ សិក្ខាសាលា ធ្វើ ការចែករំលែក ព័ត៌មាន និង ការយល់ដឹង ដែល ទទួលបាន បន្ត ឱ្យ បាន ទូលំទូលាយ ផងដែរ ទៅ មិត្តភក្តិ . សាច់ញាតិ - បងប្អូន និង សហការី ដែល ជា ការរួមចំណែក ក្នុង ការពង្រឹង និង ជំរុញ ការចូលរួម ក្នុង ការកសាង របប សន្តិសុខ សង្គម ដ៏ សំខាន់ ផងដែរ ៕ សម្ដេច តេជោ ហ៊ុន សែន ផ្ទេរ ភារកិច្ច អភិបាល ស្រុក កោះ ធំ មក ជា អភិបាល ក្រុង សំពៅ ពូន និង តែងតាំង អភិបាល ក្រុង អរិយក្សត្រ និង ស្រុក កោះ ធំ
ក្នុង អនុក្រឹត្យ ដដែល នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន តែងតាំង លោក ចាន់ តារា ជា អភិបាល ក្រុង អរិយក្សត្រ និង លោក ឆែ វណ្ណឌី ជា អភិបាល ស្រុក កោះ ធំ ។
ខាងក្រោម នេះ ជា អនុក្រឹត្យ របស់ សម្ដេច តេជោ ហ៊ុន សែន៖ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សង្គមកិច្ច៖ អំពើ ជួញដូរ មនុស្ស និង ការធ្វើ អាជីវកម្ម លើ មនុស្ស បាន កើតឡើង និង កំពុង រីកសាយភាយ គ្រប់ ទីកន្លែង គ្រប់ រូបភាព ភាគ ច្រើន ជា ឧក្រិដ្ឋកម្ម ឆ្លង ដែន
( ភ្នំពេញ ) ៖ លោក ញ៉ឹក វណ្ណារ៉ា រដ្ឋលេខាធិការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ថ្លែង បញ្ជាក់ ថា អំពើ ជួញដូរ មនុស្ស និង ការធ្វើ អាជីវកម្ម លើ មនុស្ស បាន កើតឡើង និង កំពុង រីកសាយភាយ គ្រប់ ទីកន្លែង គ្រប់ រូបភាព ហើយ ភាគ ច្រើន ជា ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ដែល មាន អង្គការ ចាត់តាំង ហើយ ឧក្រិដ្ឋកម្ម នេះ បាន ធ្វើឲ្យ ប៉ះពាល់ ទាំង ថ្នាក់ ជាតិ តំបន់ និង លើ ពិភពលោក ។
លោក បាន បន្ថែម ថា បញ្ហា នេះ ប្រទេស កម្ពុជា បាន នឹង កំពុង បង្កើត រៀបចំ ចង់ ក្រង ផ្សព្វផ្សាយ អនុវត្ត គោល នយោបាយ ផែនការ យុទ្ធសាស្រ្ត កិច្ចព្រមព្រៀង ទ្វេ ភាគី ពហុ ភាគី និង យន្តការ នានា សំដៅ ប្រយុទ្ធ ប្រឆាំង និង ចូលរួម កាត់បន្ថយ ឲ្យបាន ជា អតិបរិមា នូវ អំពើ ជួញដូរ មនុស្ស ទាំង ក្នុង ក្របខ័ណ្ឌ ជាតិ តំបន់ និង លើ ពិភពលោក ពិសេស ជាង នោះ ទៅ ទៀត សព្វ ថ្ងៃ នេះ ជនរងគ្រោះ ក៏ បាន និង កំពុងតែ កើតមាន នៅក្នុង ប្រទេស គោលដៅ ផងដែរ ដូចជា ប្រទេស ចិន ឥណ្ឌូនេស៊ី ថៃ ។
លោក ញ៉ឹក វណ្ណារ៉ា ក៏ បាន បង្ហាញ ក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា ការចូលរួម ក្រុមការងារ បច្ចេកទេស ( អ្នក អនុវត្ត ជាក់ស្តែង ) របស់ លោក លោកស្រី ស្តីពី នីតិវិធី នៃ ដំណើរការ មាតុភូមិ និវត្តន៍ ជនរងគ្រោះ និង ជនសង្ស័យ ថា រងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស តាម ផ្លូវ អាកាស ដើម្បី ជា ប្រយោជន៍ ដល់ ជនរងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស និង រំលោភបំពាន ផ្លូវភេទ ពិសេស កុមារ រងគ្រោះ ដោយ អំពើ ជួញដូរ មនុស្ស និង កេងប្រវ័ញ្ច ផ្លូវភេទ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ផងដែរ ៕
សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប បើក កិច្ចប្រជុំ បូកសរុប ផែនការ យុទ្ធសាស្ត្រ រយៈពេល ៥ ឆ្នាំ និង ដាក់ ចេញ ផែនការ យុទ្ធសាស្ត្រ ថ្មី ចំនួន ៦ សម្រាប់ ឆ្នាំ ២០២៣ - ២០២៧
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប (AEU) នា រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន បើក កិច្ចប្រជុំ បូកសរុប ផែនការ យុទ្ធសាស្ត្រ រយៈពេល ៥ឆ្នាំ ( ២០១៨ - ២០២២ ) និង រៀបចំ ផែនការ យុទ្ធសាស្ត្រ ថ្មី ឆ្នាំ ( ២០២៣ - ២០២៧ ) ដើម្បី ជា ការប្រមូល នូវ ធាតុ ចូល ពី បណ្តាម ហាវិទ្យាល័យ ផ្សេង ៗ របស់ សាកលវិទ្យាល័យ ដើម្បី ធ្វើ ការអភិវឌ្ឍ បន្ថែម សម្រាប់ សកម្មភាព សម្រាប់ ៥ឆ្នាំ បន្ទាប់ សំដៅ ធ្វើ យ៉ាងណា ឱ្យ សាកលវិទ្យាល័យ កាន់តែ មាន ភាពរីកចំរើន ទៅ មុខ ទៀត ។
កិច្ចប្រជុំ បូកសរុប ផែនការ យុទ្ធសាស្ត្រ រយៈពេល ៥ ឆ្នាំ និង រៀបចំ ផែនការ យុទ្ធសាស្ត្រ ថ្មី នេះ បាន ធ្វើឡើង នៅ បន្ទប់ ប្រជុំ អគារ មាស ជាន់ ទី ១៣ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប ក្រោម អធិបតីភាព លោក លោក ស៊ុន សេដ្ឋា សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ អាសុី អឺរ៉ុប និង មាន ការចូលរួម ពី គណៈ គ្រប់គ្រង បុគ្គលិក សាស្រ្តាចារ្យ និស្សិត បុគ្គលិក សាកលវិទ្យាល័យ មក ពី គ្រប់ ផ្នែក ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
លើកឡើង នា ឱកាស នោះ លោក ស៊ុន សេដ្ឋា បាន ឱ្យដឹង ថា កិច្ចប្រជុំ បូកសរុប ផែនការ យុទ្ធសាស្ត្រ ការងារ នេះ ដើម្បី ជា ការប្រមូល ជា ធាតុ ចូល ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ដើម្បី ធ្វើ យ៉ាងណា ឱ្យដឹង ថា ការអនុវត្តន៍ កន្លងមក អាច យក ធ្វើជា ផែនការ សម្រាប់ ឆ្នាំ បន្ត ទៅ មុខ ទៀត ឫ អាច បំពេញ បន្ថែម នូវ នូវ ចំណុច ខ្វះខាត សម្រាប់ ផែនការ ដែល ធ្លាប់ បាន អនុវត្តន៍ កន្លងមក ដែល ជាក់ស្តែង ផែនការ ដែល អនុវត្តន៍ កន្លងមក នូវ តែ អាច មាន បច្ចុប្បន្នភាព សម្រាប់ រយៈពេល ៥ ឆ្នាំ បន្ត ទៅ មុខ ទៀត ផងដែរ ។
លោក ស៊ុន សេដ្ឋា បាន បន្ថែម ដែរ ថា ដោយ ផ្អែក ការកំណត់ យុទ្ធសាស្រ្ត និង គោលដៅ ខាងលើ សាកលវិទ្យាល័យ អាស៊ី អឺរ៉ុប មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការស្រូបយក និស្សិត ឱ្យ ចុះឈ្មោះ ចូលរៀន តាម ផែនការ ជារៀងរាល់ ឆ្នាំ ជាពិសេស សាកលវិទ្យាល័យ មាន បទពិសោធន៍ និង និរន្តភាព យូរ អង្វែង ក្នុង វិស័យ អប់រំ ដោយសារ សាកលវិទ្យាល័យ មាន ធនធាន មនុស្ស មាន សមត្ថភាព និង គុណ វុឌ្ឍិគ្រប់គ្រាន់ អគារ សិក្សា ផ្ទាល់ខ្លួន សម្ភារៈ សម្បូរបែប ក្នុង ការសិក្សា និង ការស្រាវជ្រាវ ជាពិសេស មាន មូលដ្ឋាន ធនធាន ហិរញ្ញវត្ថុ រឹងមាំ ផងដែរ ។
យ៉ាងហោចណាស់ ជនជាតិ ប៉ាឡេ ស្ទីន ១២ នាក់ បាន រងរបួស និង រាប់ រយ នាក់ ទៀត ត្រូវបាន ចាប់ខ្លួន បន្ទាប់ពី ប៉ូលិស អ៊ីស្រាអែល បាន ឆ្មក់ ចូល វិហារ Al-Aqsa កាលពី ថ្ងៃពុធ ។ វីដេអូ ដែល បាន ផ្សព្វផ្សាយ នៅលើ ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម បាន បង្ហាញ ពី មន្រ្តី អ៊ីស្រាអែល បាន វាយដំ អ្នក ថ្វាយបង្គំ ដោយ រុញ ពួកគេ ចេញ ពី បរិវេណ និង រារាំង ពួកគេ មិន ឱ្យ ប្រតិបត្តិការ ថ្វាយបង្គំ តាម បែប សាសនា ។
ប្រទេស ម៉ាឡេស៊ី គឺជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស ចុងក្រោយ គេ ដែល ប្រតិកម្ម ចំពោះ អំពើហឹង្សា របស់ អ៊ីស្រាអែល កាលពី ថ្ងៃព្រហស្បតិ៍ បន្ទាប់ពី មាន ការថ្កោលទោស យ៉ាង ទូលំទូលាយ ពី ពិភព អារ៉ាប់ និង មូស្លីម ។
ក្រសួង ការបរទេស បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា « សហគមន៍ អន្តរជាតិ ត្រូវតែ ទាមទារ ឱ្យ របប អ៊ីស្រាអែល បញ្ឈប់ ជាបន្ទាន់ នូវ សកម្មភាព បង្កហេតុ ណាមួយ ដើម្បី ផលប្រយោជន៍ សន្តិភាព និង ស្ថិរភាព » ។
ដោយឡែក ប្រទេស ឥណ្ឌូណេស៊ី ដែល ជា ប្រទេស កាន់ សាសនា ឥស្លាម ធំ ជាង គេ លើ ពិភពលោក ក៏ បាន ជំរុញ ឱ្យ អង្គការ សហ ប្រជាជាតិ និង សហគមន៍ អន្តរជាតិ « ចាត់ វិធានការ ជាក់ស្តែង ដើម្បី បញ្ឈប់ ការរំលោភ ផ្សេង ៗ ដែល ប្រព្រឹត្ត ដោយ អ៊ីស្រាអែល ក្នុង វិហារ Al-Aqsa» ។
ក្រសួង ការបរទេស ឥណ្ឌូណេស៊ី បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា ឧបទ្ទវហេតុ នេះ « ពិតជា ធ្វើឱ្យ ប៉ះពាល់ ដល់ អារម្មណ៍ របស់ ប្រជាជន ម៉ូស្លីម ជុំវិញ ពិភពលោក ។ វា ជា ការបំពាន យ៉ាង ពិតប្រាកដ ចំពោះ ភាព បរិសុទ្ធ របស់ Al-Aqsa ហើយ នឹង ធ្វើឱ្យ ជម្លោះ និង អំពើហិង្សា កាន់តែ ធ្ងន់ធ្ងរ » ។
គួរ បញ្ជាក់ ថា ប្រទេស អាស៊ី អាគ្នេយ៍ ទាំង ពីរ ជា អ្នកគាំទ្រ រដ្ឋ ប៉ាឡេ ស្ទីន ឯករាជ្យ ជា យូរ មកហើយ ដែល ផ្អែក លើ ព្រំដែន មុន ឆ្នាំ ១៩៦៧ ជាមួយនឹង ក្រុង ហ្សេរុយ សាឡឹម ខាងកើត ជា រដ្ឋធានី របស់ ខ្លួន ៕
ចំណេះដឹង ទូទៅ៖ រដ្ឋ បុរាណ សំខាន់ ៗ ក្នុង ប្រវត្តិសាស្ត្រ អាស៉ី អាគ្នេយ៍
( ភ្នំពេញ ) ៖ តំបន់ អាស៉ី អាគ្នេយ៍ គឺ មាន ប្រវត្តិសាស្ត្រ របស់ ខ្លួន យូរ លង់ ណាស់ មកហើយ អាច និយាយ បាន ថា ជា តំបន់ មួយ ដែល មាន រដ្ឋ ចំណាស់ កកើតឡើង និង បាន ពង្រីក ឥទ្ធិពល អរិយធម៌ ក៏ ដូចជា ទទួល ឥទ្ធិពល ពី គ្នា ទៅ វិញ ទៅ មក ខណៈ រដ្ឋ ខ្លះ ក៏ បាន ពង្រីក អំណាច កាន់តែ ខ្លាំងក្លា រហូត បង្កើត បានជា ចក្រភព ប្រចាំ តំបន់ ហើយក៏ ធ្លាក់ចុះខ្សោយ ទៅវិញ ផងដែរ ។
១៣. សិង្ហា សារិ (Singhasari) អាណាចក្រ សិង្ហា សារិ ត្រូវបាន បង្កើតឡើង ដោយ ជនជាតិ ជ្វា កាន់ សាសនា ហិណ្ឌូ ដែល មាន មូលដ្ឋាន នៅលើ កោះ ជ្វា ភាគ ខាងកើត ។ អាណាចក្រ នេះ មាន អត្ថិភាព ចាប់ពី ឆ្នាំ ១២២២ - ១២៩២ ។ ទោះ មាន រយៈពេល ខ្លី ប៉ុន្តែ ក្នុង ពេល ឫ ទ្ធានុភាព ឡើង ដល់ កំពូល ចក្រភព សិង្ហា សារិបាន វាយ ត្រួតត្រា លើ ទីប្រជុំ កោះ ធំ ៗ នៃ ប្រទេស ឥណ្ឌូណេស៉ី បច្ចុប្បន្ន ដូចជា កោះ ជ្វា កោះ ស៊ូម៉ាត្រា កោះ កាលីម៉ាន់តាន់ កោះ ស៊ូឡា វេស៉ី ឧបទ្វីប ម៉ាឡេ និង ប្រជុំ កោះ តូច ៗ ជាច្រើន ទៀត ។
២៥. មល្លកា (Melaka) អាណាចក្រមល្លកា ឬ ម៉ាឡាកា ត្រូវបាន បង្កើត ដោយ ជនជាតិ ម៉ាឡា កាន់ សាសនា ឥស្លាម ដែល មាន អត្ថិភាព ចាប់ពី ឆ្នាំ ១៤០០ - ១៥១១ ។ អាណាចក្រ នេះ ធ្លាប់ មាន វិសាលភាព លាតសន្ធឹង លើ រដ្ឋ ម៉ាឡាកា និង រដ្ឋ ផ្សេង ទៀត នៃ ប្រទេស ម៉ាឡេស៉ី ព្រមទាំង ប្រទេស សិង្ហបុរី ផងដែរ ។
ក្នុង ឱកាស នោះ ក្រសួង សុខាភិបាល និង អាជ្ញាធរ រាជធានី ភ្នំពេញ បាន ជំរុញ ឲ្យ ក្រុមហ៊ុន ដែល ទទួល ម៉ៅការសាងសង់ មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព ពន្លឿន ការសាងសង់ ឲ្យបាន លឿន ពោល គឺ ធ្វើ យ៉ាងណា ឲ្យ រួចរាល់ ទៅ តាម ផែនការ ដែល បាន គ្រោង ទុក ។
សូម ជម្រាប ថា មន្ទីរពេទ្យ ជាតិ តេជោ សន្ដិភាព នេះ ត្រូវបាន រដ្ឋបាល រាជធានី ភ្នំពេញ ធ្វើ ពិធី ក្រុង ពាលី តាម បែប សាសនា សុំ ម្ចាស់ ទឹក ម្ចាស់ ដី ដើម្បី សាងសង់ កាលពី រសៀល ថ្ងៃទី ១៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ ក្រោម វត្តមាន លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ . លោក ឃួង ស្រេង អភិបាល នៃ គណៈអភិបាល រាជធានី ភ្នំពេញ និង លោកស្រី ។
( មូស្គូ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ វិមាន ក្រឹមឡាំង បាន និយាយ ថា ខ្លួន មើល មិន ឃើញ មាន លទ្ធភាព នោះ ឡើយ សម្រាប់ ឱ្យ ចិន អាច ជួយ សម្រុះសម្រួល ជម្លោះ អ៊ុយក្រែន ហើយ បាន សង្កត់ធ្ងន់ ថា មិន មាន មធ្យោបាយ អ្វី ផ្សេង ក្រៅតែ ពី បន្ត ប្រតិបត្តិការ យោធា របស់ ខ្លួន នោះ ទេ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នៅ ថ្ងៃព្រហស្បតិ៍ ទី៦ ខែមេសា ឆ្នាំ ២០២៣ ។
( វៀតណាម )៖ លោក អ៉ិត សំហេង រដ្ឋមន្រ្តី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ដឹកនាំ គណៈប្រតិភូ ជួប សំណេះសំណាល សួរសុខទុក្ខ ដោយ ផ្ទាល់ ជាមួយនិស្សិត កម្ពុជា ចំនួន ១០៨ នាក់ ដែល កំពុង សិក្សា នៅ សាលា ថៃ ង្វៀន ដោយ ទទួលបាន អាហារូបករណ៍ ពី រដ្ឋាភិបាល វៀតណាម ។
ការអភិវឌ្ឍ ធនធាន មនុស្ស បាន ក្លាយជា អាទិភាព ទី១ សម្រាប់ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។ គោល នយោបាយ ជាច្រើន បាន និង កំពុង អនុវត្ត ដើម្បី ជំរុញ កសាង ធនធាន មនុស្ស គ្រប់ ប្រភេទ ជាពិសេស ធនធាន មនុស្ស ផ្នែក វិជ្ជាជីវ : ដើម្បី ឆ្លើយតប ទៅនឹង កំណើន រីកចម្រើន យ៉ាង ឆាប់រហ័ស នៃ សេដ្ឋកិច្ច សង្គម កម្ពុជា នា ពេល បច្ចុប្បន្ន ។
ទន្ទឹម គ្នា នេះ ដែរ លោក រដ្ឋមន្ត្រី ក៏ បាន ផ្តាំផ្ញើ ដល់ និស្សិត ទាំងអស់ ឱ្យ ចេះ ស្រឡាញ់ គ្នា ជួយ ថែរក្សា គ្នា គោរព ឱ្យ បាន តាម បទបញ្ជ ផ្ទៃក្នុង វិន័យ ក៏ ដូចជា ច្បាប់ ទម្លាប់ នៅ ប្រទេស វៀតណាម ហើយ ខិតខំ ប្រឹងប្រែង សិក្សា រៀនសូត្រ ឱ្យ ក្លាយជា ធនធាន មនុស្ស ដ៏ ពូកែ របស់ កម្ពុជា ក្នុង ការចូលរួម អភិវឌ្ឍ សេដ្ឋកិច្ច សង្គមជាតិ របស់ ខ្លួន ។
( ព្រះសីហនុ) ៖ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ដឹកនាំ ដោយ លោក ប៊ូ វឌ្ឃ នា ប្រធាន អន្តរ វិស័យ នៅ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ បាន ដឹកនាំ ក្រុម កាងារ ចុះ រៀបចំ ដីឡូតិ៍ ជូន ប្រជាពលរដ្ឋ ជាច្រើន គ្រួសារ ជួបជុំគ្នា នៅ ចំណុច ភូមិ ចំណោទ រាម ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ក្រោយ មាន ការរៀបចំ ក្នុង គោល នយោបាយ ឈ្នះ ៗ ដែល ត្រៀម រៀបចំ នូវ ទីតាំង ដី ថ្មី សម្រាប់ ប្រជាពលរដ្ឋ មាន ទំហំ ទទឹង ៥ម៉ែត្រ និង បណ្តោយ ២០ ម៉ែត្រ ។
( ភ្នំពេញ ) ៖ លោក សឿង សុធានី ប្រធាន សមាគម សប្បុរសធម៌ ខ្មែរ កម្ពុជា ក្រោម បាន ប្រតិកម្ម នឹង ថ្នាក់ដឹកនាំ បក្ស ភ្លើង ទៀន ដែល បាន ប្រមាថ ចំពោះ ប្រព័ន្ធ អប់រំ នៅ កម្ពុជា និង ចាត់ទុក គោល នយោបាយ អប់រំ របស់ ពួកគេ ជា គោល នយោបាយ ផ្កាយ លើ មេឃ ។
ប្រតិកម្ម របស់ លោក សឿង សុធានី បាន ធ្វើឡើង ក្រោយពេល មន្ត្រី ជាន់ ខ្ពស់ បក្ស ភ្លើង ទៀន លោក សុខ គឹម សេង អគ្គ លេខាធិការ រង គណបក្ស ភ្លើង ទៀន និង ជា ប្រធាន ក្រុមការងារ បក្ស ភ្លើង ទៀន ខេត្ត សៀមរាប បាន ថ្លែង វាយប្រហារ លើ ប្រព័ន្ធ អប់រំ ថា ខ្សោយ ។
សម្រាប់ លោក សឿង សុធានី ការថ្លែង របស់ លោក សុខ គឹម សេង គឺជា ការថ្លែង ដោយ មិន ឆ្លុះបញ្ចាំង ពី តថភាព ពិត នៃ វិស័យ អប់រំ នៅ កម្ពុជា នោះ ឡើយ ។ លោក សឿង សុធានី បាន លើកឡើង ថា ធៀប នឹង ស្ថាន អប់រំ ក្រោយ ថ្ងៃ រំដោះ ឆ្នាំ ១៩៧៩ ការអប់រំ នា ពេល បច្ចុប្បន្ន មាន ស្ថានភាព កាន់តែ ល្អ ប្រសើរ កូន ចៅ ប្រជាពលរដ្ឋ មាន ឱកាស ស្មើគ្នា ក្នុង ការសិក្សា រៀនសូត្រ ។
បន្ថែម ពីលើ នោះ ក្រោម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បាន ព្យាយាម ពង្រាយ សាលា ទៅ កៀក លំនៅឋាន ប្រជាពលរដ្ឋ ធ្វើឱ្យ អត្រា បោះបង់ ការសិក្សា កាន់តែ ទៀប ។
យោង តាម របាយការណ៍ របស់ ក្រសួង អប់រំ បាន បង្ហាញ ថា ក្នុង ឆ្នាំ សិក្សា ២០២១ - ២០២២ គ្រឹះស្ថាន សិក្សា ចំណេះ ទូទៅ ទាំង រដ្ឋ និង ឯកជន មាន រហូតដល់ទៅ ១៨. ៤៣០ សាលា ហើយ មាន សិស្ស រហូតដល់ទៅ ជាង ៣.៥លាន នាក់ កំពុង សិក្សា រៀនសូត្រ ។ តាមរយៈ ទិន្នន័យ នេះ បង្ហាញ ថា សាសា ជាច្រើន បាន បង្កើតឡើង ហើយ កូន ចៅ ប្រជាពលរដ្ឋ ច្រើន លើសលុប កំពុង ទទួលបាន ការអប់រំ ក្រោម ការយកចិត្តទុកដាក់ របស់ រាជ រដ្ឋាភិបាល ។
សម្រាប់ លោក សុធានី ដែល ជា ខ្មែរ កម្ពុជា ក្រោម បាន មើលឃើញ ថា ពានរង្វាន់ នេះ ជា ការទទួលស្គាល់ ចំពោះ កិច្ចប្រឹងប្រែង របស់ កម្ពុជា ក្នុង ការលើកកម្ពស់ ការអប់រំ ហើយ បាន បញ្ជាក់ គ្រប់គ្រាន់ តប ការចោទប្រកាន់ របស់ មេដឹកនាំ បក្ស ភ្លើង ទៀន ។
ឈរ លើ មូលដ្ឋាន ខាងលើ នេះ លោក សឿង សុធានី ចាត់ទុក អ្វី ដែល មេដឹកនាំ បក្ស ភ្លើង ទៀន គឺជា សារ មួយ ដែល មិន ឆ្លុះបញ្ចាំង តថ ភាព ពិត នៃ ការអប់រំ នៅ កម្ពុជា នោះ ឡើយ ។
លោក សុធានី បាន អំពាវនាវ ប្រជាពលរដ្ឋ កុំ ឱ្យ ជឿ លើ នយោបាយ ប្រជាភិថុតិ របស់ ក្រុម ប្រឆាំង ហើយ ត្រូវ ជឿជាក់ លើ គោល នយោបាយ អប់រំ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ បក្ស ប្រជាជន កម្ពុជា ដែល ធ្វើឱ្យ ការអប់រំ កាន់តែ ប្រសើរឡើង ៕ ប៉េកាំ ង៖ គ្មាន ការធ្វើចរាចរណ៍ ថ្នាំ fentanyl ដោយ ខុស ច្បាប់ រវាង ចិន និង ម៉ិក ស៉ិក នោះ ទេ
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៤ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៩ករណី . ជួញដូរ ៩ករណី . ដាំដុះ ១ករណី និង ដឹកជញ្ជូន រក្សាទុក ៥ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥០ នាក់ ។
១៖ លោក ម៉ារ យ៉ារិទ្ធ អ្នកជំនាញ សារព័ត៌មាន ជាង ៣០ ឆ្នាំ ២៖ ឯកឧត្តម សួន សេរី រដ្ឋា ប្រធាន ក្រុមប្រឹក្សាភិបាល វេទិកា សន្តិភាព កម្ពុជា ៕
ការដំា ដុះ ក្តីសង្ឃឹម បៃតង
ការណែនាំ របស់ នាយ ឧត្តមសេនីយ៍ អគ្គ ស្នងការ នគរបាល ជាតិ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ ជាមួយ ស្នងការ នគរបាល រាជធានី - ខេត្ត នៅ នាយកដ្ឋាន អង្គរក្ស ដែល មាន ការចូលរួម ពី អគ្គ ស្នងការរង . ប្រធាន នាយកដ្ឋាន កណ្ដាល . អនុប្រធាន សេនាធិការ និង ប្រធាន នាយកដ្ឋាន ពាក់ព័ន្ធ ។
នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន អះអាង ថា ព្រឹត្តិការណ៍ សំខាន់ ៗ ដែល កងកម្លាំង នគរបាល ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ នៅ ចំពោះមុខ នេះ រួម មាន៖ ពិធី បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ខ្មែរ ពិសេស ព្រឹត្តិការណ៍ អង្គរ សង្ក្រាន្ដ និង សង្ក្រាន្ដ ដែល នឹង រៀបចំ នៅ តាម បណ្ដា រាជធានី - ខេត្ត . ការធ្វើជា ម្ចាស់ ផ្ទះ ស៉ី ហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម និង ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ ។
នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បាន ធ្វើ ការណែនាំ ថា សម្រាប់ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ នៅ ឆ្នាំ នេះ ត្រូវបាន រាជ រដ្ឋាភិបាល បើក ទូលាយ ឲ្យ រៀបចំ នៅ ទូទាំង ប្រទេស ក្រោយ គ្រប់គ្រង បាន នូវ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ដូច្នេះ ភារកិច្ច របស់ កងកម្លាំង នគរបាល ជាតិ ត្រូវ យកចិត្តទុកដាក់ ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ជោគជ័យ ពិសេស នៅ តាម ទីតាំង សប្បាយ ភាព ក្នុង មូលដ្ឋាន ។
ក្នុង អំឡុង ពេល បុណ្យ ចូល ឆ្នាំ នេះ កងកម្លាំង នគរបាល ទាំងអស់ មិន ត្រូវបាន អនុញ្ញាតឲ្យ ឈប់ សម្រាក ឬ មាន ការផ្លាស់ប្ដូរ ចេញ ពី នោះ ទេ ពោល ត្រូវ ធានា កម្លាំង ឲ្យបាន គ្រប់គ្រាន់ ផ្លាស់ប្ដូរ វេន ប្រចាំ ការ ប្រចាំ បញ្ជា និង ត្រៀម អន្ដរាគមន៍ គ្រប់ ពេល ២៤ ម៉ោង លើ ២៤ ម៉ោង ព្រោះ នេះ កាតព្វកិច្ច របស់ កងកម្លាំង នគរបាល ជាតិ ដែល ត្រូវ បម្រើ សង្គមជាតិ ។ នេះ ជា អ្វី ដែល នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត អគ្គ ស្នងការ នគរបាល ជាតិ បាន គូសបញ្ជាក់ ។
ដោយឡែក សម្រាប់ ព្រឹត្តិការណ៍ ស៉ី ហ្គេម និង អាស៊ាន ប៉ារ៉ាហ្គេម ដែល កម្ពុជា ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ នេះ នាយ ឧត្តមសេនីយ៍ បាន លើកឡើង ថា រាជធានី - ខេត្ត ដែល មាន ការពាក់ព័ន្ធ ការដង្ហែម ភ្លើង គប់ . ពិធី បើក និង បិទ នៅ ពហុកីឡដ្ឋាន មរតក តេជោ និង នៅ កន្លែង ប្រកួត ក្នុង រាជធានី ភ្នំពេញ ព្រមទាំង ខេត្ត ចំនួន ៤ទៀត រួម មាន ខេត្ត សៀមរាប . ព្រះសីហនុ . កែប និង កំពត ត្រូវតែ ធានា សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ឲ្យបាន ១០០ ភាគរយ ដោយ ត្រូវ រៀបចំ ផែនការ ច្បាស់លាស់ ជាមួយ គណៈ បញ្ជាការ ឯកភាព ។
ព្រឹត្តិការណ៍ ដែល សំខាន់ ជាង នេះ ទៅ ទៀត នោះ គឺ ដំណើរការ នៃ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧ ដែល នឹង ប្រព្រឹត្ដទៅ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២៣ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន សង្កត់ធ្ងន់ ថា កងកម្លាំង នគរបាល មាន កាតព្វកិច្ចការពារ ការ ដំណើរការទូទៅ នៃ ការបោះឆ្នោត ទាំង មុនដំណើរការបោះឆ្នោត . ពេល បោះឆ្នោត និង ក្រោយ ការបោះឆ្នោត ហើយក៏ កងកម្លាំង នគរបាល មាន កាតព្វកិច្ច ជា ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម បោះឆ្នោត ផងដែរ ។
ពាក់ព័ន្ធ កិច្ចការពារ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន បញ្ជា ឲ្យ ប្រើប្រាស់ កម្លាំង ឲ្យ អស់ លទ្ធភាព ក្នុង នោះ មាន ទាំង ការប្រចាំ ការ ក្នុង គណៈ បញ្ជាការអចិន្ដ្រៃយ៍ របស់ ខេត្ត . ប្រចាំ បញ្ជា អន្ដរាគមន៍ នៅ ខេត្ត ស្រុក ឃុំ និង ការពារ នៅ តាម គោលដៅ ដែល បាន កំណត់ ដែល ក្នុង នោះ ក៏ ត្រូវ មាន ការចូលរួម ពី ប្រជាការពារ ផងដែរ ។ លើស ពី នេះ ក៏ ត្រូវ រៀបចំ ការបណ្ដុះបណ្ដាល ដល់ ប្រជាការពារ ទាំងអស់ អំពី ក្រមសីលធម៌ និង តួនាទី ការពារ ដែល ត្រូវ អនុវត្ត ជាដើម ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ អគ្គ ស្នងការ នគរបាល ជាតិ ក៏ បាន ណែនាំ នូវ ការងារ ជំនាញ មួយចំនួន ផងដែរ ដល់ ស្នងការ នគរបាល រាជធានី - ខេត្ត និង យកចិត្ដទុកដាក់ ពង្រឹង ការងារ ប្រចាំ បញ្ជា . តាមដាន ព័ត៌មាន តាម បណ្ដាញ សង្គម ដែល ពាក់ព័ន្ធ ក្នុង មូលដ្ឋាន របស់ ខ្លួន ហើយ ឆ្លើយតប ឲ្យបាន ទាន់ ពេលវេលា ទាន់ សភាពការណ៍ និង មាន ចំណាត់ការ រដ្ឋបាល ឲ្យបាន លឿន និង កែប្រែ ឥរិយាបថ ប្រើប្រាស់ ពាក្យសម្ដី ឲ្យបាន សមរម្យ ជាមួយ ប្រជាពលរដ្ឋ ពិសេស មន្ដ្រី នគរបាល ចរាចរណ៍ និង នគរបាល ប៉ុស្ដិ៍ រដ្ឋបាល ។
ស្រប ពេល ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល នឹង ឈានចូល មកដល់ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ក៏ បាន ជូន ពរ ដល់ កងកម្លាំង នគរបាល ទូទាំង ប្រទេស និង ក្រុមគ្រួសារ ព្រមទាំង អតីត យុទ្ធជន សូម ជួប តែ សុខភាព ល្អ សុភមង្គល និង ជោគជ័យ គ្រប់ ភារកិច្ច ៕ សល់ តែ ២៨ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ! កម្ពុជា នឹង ធ្វើជា ម្ចាស់ ផ្ទះ នៃ ព្រឹត្តិការណ៍ កីឡា ស៉ី ហ្គេម លើក ទី ៣២
នា ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ព្រះរាជ ពិធី សុំ ព្រះអគ្គីកីឡា សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អាស៊ី អាគ្នយ៍ លើក ទី ៣២ និង កីឡា អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ឆ្នាំ ២០២៣ បាន ចាប់ផ្តើម ជា ផ្លូវការ ហើយ នឹង បន្ត រត់ តាម បណ្តា ប្រទេស តំបន់ អាស៊ី អាគ្នេយ៍ ទាំង ១០ប្រទេស មុន វិលត្រលប់មក ប្រទេស កម្ពុជា ដើម្បី ប្រារព្ធ ពិធី បើក ការប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ ជា ផ្លូវការ តែម្ដង ៕ សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣
១៖ ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ គ្មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ទេ ខណៈ អ្នក ជាសះស្បើយ ក៏ គ្មាន ដែរ
២៖ ប្រមុខ ការទូត អ៉ីរ៉ង់ - អារ៉ាប៊ី សាអូឌីត ជួបគ្នា លើក ដំបូង ក្នុង រយៈពេល ៧ ឆ្នាំ ក្រោយ ចាប់ផ្តើម ផ្សះផ្សារ ទំនាក់ទំនង ឡើងវិញ
៣៖ សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ អនុសាស ន៏ សំខាន់ ៗ ឲ្យ សមាគម ឧកញ៉ា កម្ពុជា រួមគ្នា ជួយ កិច្ចការ សង្គម ការងារ មនុស្សធម៌ ចូលរួម ជំរុញ ការធ្វើ ពាណិជ្ជកម្ម និង ពង្រឹង ការវិនិយោគ ដើម្បី អភិវឌ្ឍ ន៏ សេដ្ឋកិច្ច ជាតិ
៤៖ គណបក្ស ភឿ ថៃ ប្រកាស ទទួលស្គាល់ កូនស្រី ពៅ លោក ថាក់ស៊ីន ជា បេក្ខជន នាយក រដ្ឋមន្ត្រី ជា ផ្លូវការ
៥៖ សម្ដេច ក្រឡាហោម ស ខេង៖ កម្លាំង សមត្ថកិច្ច ប្រមាណ ១០ម៉ឺន នាក់ ត្រៀម សម្រាប់ ការពារ ការបោះឆ្នោត ជ្រើសរើស តាំង តំណាងរាស្ដ្រ នីតិកាល ទី៧
៦៖ កូរ៉េ ខាងជើង ថា សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងត្បូង កំពុង រុញ ច្រាន ឧបទ្វីប កូរ៉េ ទៅកាន់ មាត់ ជ្រោះ នៃ សង្រ្គាម នុយក្លេអ៊ែរ
៧៖ ទេសាភិបាល រង ធនាគារ ជាតិ នៃ កម្ពុជា ពន្យល់ មូលហេតុ បោះ ក្រដាស ប្រាក់ រៀល មាន ទំហំ និង ពណ៌ ខុស ៗ គ្នា
៨៖ លោក ហ្សេលេន ស្គី៖ ប៉ូឡូញ នឹង ជួយ បញ្ចុះបញ្ចូល លោក ខាងលិច ឲ្យ ផ្តល់ យន្តហោះ ចម្បាំង មក អ៊ុយក្រែន
៩៖ ទេសាភិបាល រង ធនាគារ ជាតិ អំពាវនាវ ប្រជាពលរដ្ឋ ពិនិត្យ ឲ្យបាន ម៉ត់ចត់ លើ កិច្ចសន្យា ខ្ចី ប្រាក់ ពី ធនាគារ ជៀសវាង បញ្ហា ជម្លោះ ខណៈ ធនាគារ មួយចំនួន ដំឡើង ការប្រាក់
១០៖ ប្រមុខ អង្គការ សហ ប្រជាជាតិ ថ្កោល ទោស តាលី បង់ ជុំវិញ បម្រាម លើ ស្រ្តី អាហ្វហ្កានីស្ថាន ដែល ធ្វើការ ឱ្យ UN
១១៖ ក្រសួង និង សហព័ន្ធ ស្រូវ អង្ករ រំពឹង ថា ពូជ ស្រូវ ថ្មី « ចំប៉ី ស៧០ » នឹង មាន ការទទួលស្គាល់ ពី ទីផ្សារ ជាតិ និង អន្តរជាតិ ដែល អាច ចាប់ យក ទីផ្សារ ថ្មី បាន លឿន
១២៖ លោក ពូទីន បើក កិច្ចពិភាក្សា ជាមួយ មេដឹកនាំ បេឡារុស តែ មិន និយាយ ពី អ៊ុយក្រែន ជាសាធារណៈ
១៤៖ ចិន កំពុង ឃ្លាំមើល សកម្មភាព នាវា នៅ ច្រក សមុទ្រ តៃវ៉ាន់ ខណៈ តៃវ៉ាន់ ថា មិន សហការ
១៥៖ ចិន សន្យា ចាត់ វិធានការឆ្លើយតប ដាច់ខាត ខណៈ មេដឹកនាំ តៃវ៉ាន់ ជំរុញ ឱ្យ អាមេរិក ពន្លឿន ការផ្គត់ផ្គង់ អាវុធ
១៦៖ ចិន កំពុង ឃ្លាំមើល សកម្មភាព នាវា នៅ ច្រក សមុទ្រ តៃវ៉ាន់ ខណៈ តៃវ៉ាន់ ថា មិន សហការ
២៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ មានប្រសាសន៍ ថា ទីលាន នៅ ពហុកីឡដ្ឋាន ជាតិ សម្រេចបាន ស្ទើរ ទាំងស្រុង ដើម្បី ធានា ដល់ ការប្រកួត ស៊ីហ្គេម
នេះ បើ យោង តាម របាយការណ៍ ផ្លូវការ ពី ក្រសួង សុខាភិបាល ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃ នេះ ៕ អគ្គ ស្នងការ រង ឧត្តមសេនីយ៍ ឯក កឹង ឃ ន ណែនាំ កម្លាំង នគរបាល ខេត្ត រតនគិរី បន្ដ ខិតខំ ប្រឹងប្រែង អភិវឌ្ឍន៍ សមត្ថភាព ដើម្បី បន្ដ ពង្រឹង សន្ដិសុខ សណ្ដាប់ធ្នាប់
លោក ឧត្តមសេនីយ៍ ឯក អគ្គ ស្នងការ រង បាន បន្ថែម ថា ទោះបី សភាពការណ៍ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ មាន បញ្ហា ប្រឈម មួយ ចំនួន លេចឡើង ស្មុគស្មាញ ជាពិសេស ឧបាយកល ទុច្ចរិត របស់ ពួក ប្រឆាំង ក្នុង ការបំផុស បំផុល ចលនា ក្នុង ចេតនា នាំឲ្យ មាន ចលាចល ក្នុង សង្គម រួម ជាមួយនឹង ការកើត មាន ឡើង នូវ បទល្មើស ផ្សេង ៗ ក៏ កងកម្លាំង នគរបាល នៅតែ សម្រេចបាន ក្នុង ការធានា នូវ របៀបរៀបរយ សន្តិសុខ សុវត្ថិភាព ស្ថិរភាព នយោបាយ និង សណ្តាប់ធ្នាប់ សង្គម បាន យ៉ាង ល្អ ប្រសើរ ។
( កំពង់ធំ )៖ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ យោធ ភូមិភាគ ទី៤ និង លោក ឧត្តមសេនីយ៍ ត្រី ផាំ វ៉ាន់ រុឹម មេបញ្ជាការ រង នៃ បញ្ជាការដ្ឋាន យោធា ទីក្រុង ហូជីមិញ នៃ កងទ័ព ប្រជាជន វៀតណាម នា ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ អាគារ ទី បញ្ជាការ ផ្នែក សឹក រង តាំង គោក នៃ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ក្រោម ជំនួយ ឧបត្ថម្ភ របស់ ខណ្ឌ ទី១០ នៃ បញ្ជាការដ្ឋាន យោធា ទីក្រុង ហូជីមិញ ។
បើ តាម លោក វរសេនីយ៍ ត្រី សេង សូត្រ មេបញ្ជាការ ផ្នែក សឹក រង តាំង គោក បាន ឱ្យដឹង ថា ការសាងសង់ទី បញ្ជាការ ផ្នែក សឹក រង តាំង គោក នេះ ដែល មាន ទំហំ ២០០ ម៉ែត្រ ការ៉េ ធ្វើ ពី បេតុង ប្រក់ ក្បឿង មាន បន្ទប់ ធ្វើការ របស់ មេបញ្ជាការ និង សាល ប្រជុំ ដែល បាន ចំណាយ ថវិកា សាងសង់ ចំនួន ៤៥. ៦៦៦ ដុល្លារ ដែល ជា ជំនួយ ឧបត្ថម្ភ របស់ ខណ្ឌ ទី១០ ដែល ជា ដៃគូ សហប្រតិបត្តិការ ជាមួយ ផ្នែក សឹក រង តាំង គោក ។
ថ្លែង នា ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន ក៏ បាន ថ្លែងអំណរគុណ ដល់ ភាគី មិត្ត នៃ បញ្ជាការដ្ឋាន យោធា ទីក្រុង ហូជីមិញ ដែល បាន ជួយ សាងសង់ អាគារ ស្នាក់ នៅ និង ធ្វើ ការងារ ជូន ដល់ អង្គភាព ផ្នែក សឹក រង ទាំង៩ និង កង វរសេនា តូច ទាំង ពីរ ព្រមទាំង សាងសង់ អគារ នៅ ទីបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ផងដែរ ដែល សរុប អគារ ទាំងអស់ មាន ចំនួន ១៣ខ្នង រួច មកហើយ ។
