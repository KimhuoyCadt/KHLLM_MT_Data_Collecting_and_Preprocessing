( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ១២ ខែមីនា ឆ្នាំ ២០២៣ នេះ ប្រជាពលរដ្ឋ ៥គ្រួសារ រស់ នៅ សង្កាត់ ព្រៃវែង ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ដែល រងគ្រោះ ភ្លើង ឆេះ ផ្ទះ ទទួលបាន អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ពី សប្បុរសជន ។
អំណោយ ទាំងនេះ ត្រូវបាន មកពី សមាគម សប្បុរសធម៌ ខ្មែរ កម្ពុជា ក្រោម រួម ជាមួយ ក្រុមការងារ នៃ អង្គភាព ចុះបញ្ជី រថយមន្ត មន្ទីរ សាធារណការ រាជធានី ភ្នំពេញ និង សប្បុរស ជន មួយចំនួន ទៀត យក ទៅ ប្រគល់ ជូន ដល់ ដៃ ពលរដ្ឋ រងគ្រោះ ទាំង ៥គ្រួសារ ។
អំណោយ ទាំងនេះ ជា ការឧបត្ថម្ភ របស់ លោក សាំ ពិសិដ្ឋ សមាជិក គណៈ អចិន្ត្រៃយ៍ កម្មាធិការ គណបក្ស រាជធានី ភ្នំពេញ និង ជា ប្រធាន គណបក្ស មូលដ្ឋាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ និង ព្រះតេជគុណ ឈឹង ភក្ដី គង់ នៅ វត្ត មហាមន្ត្រី លោក បណ្ឌិត ហោ សេរី វឌ្ឍ ប្រធាន មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ និង លោក តាំង សុខ ឃី អនុប្រធាន សាខា កាកបាទ ក្រហម ខេត្ត កណ្ដាល ។
អំណោយ ទាំងនោះ រួម មាន៖ អង្ករ ៥០ គីឡូក្រាម ទឹកត្រី ២យួរ ទឹក សុី អុីវ ២យួរ ប៊ី ចេង ១កញ្ចប់ មី ម៉ាម៉ា ២កេះ ត្រីខ ១យួរ ប្រេង ឆា ស្ករ អំបិល សម្លៀកបំពាក់ សម្ភារៈ ប្រើប្រាស់ ផ្សេង ៗ រួម នឹង ថវិកា ២០ មុឺន រៀល ក្នុង មួយ គ្រួសារ ៕
នាយក ទី ចាត់ការ គីមីសាស្ត្រ អគ្គ បញ្ជាការ ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ទណ្ឌិត ក្បត់ ជាតិ បី ជំនាន់ សម រង្ស៉ី ដែល ផ្សព្វផ្សាយ បំភ្លៃ និង ញុះញង់ លើ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ និង ក្រុមគ្រួសារ
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ឈឹម សាវុធ នាយ រង សេនាធិការ ចំរុះ នាយក ទី ចាត់ការ គីមីសាស្ត្រ អគ្គ បញ្ជាការ បាន ប្រកាស ប្រឆាំង និង ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ទណ្ឌិត ក្បត់ ជាតិ បី ជំនាន់ សម រង្ស៉ី ដែល បាន ផ្សព្វផ្សាយ បំភ្លៃ និង ញុះញង់ តាម បណ្តាញ សង្គម មក លើ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ក្រុមគ្រួសារ ។
ជន ក្បត់ ជាតិ សម រង្ស៉ី តែងតែ មាន ចរិត អាក្រក់ វាយប្រហារ រិះគន់ ដល់ ឥស្សរជន ខ្មែរ គ្រប់ រូប ដែល កំពុង ដឹកនាំ ប្រទេស ធ្វើឱ្យ ប្រទេស មាន សន្តិភាព មាន ការរីកចម្រើន ពិភពលោក កោត ស្ងប់ ស្ងែង ប្រជាជន ខ្មែរ រស់នៅ សុខ សប្បាយ ហើយ បន្ត សុខ សប្បាយ ទៅ មុខ រហូត ។ ផ្ទុយទៅវិញ ទណ្ឌិត សម រង្ស៉ី មិន ដែល មាន ស្នាដៃ អ្វី សោះ នៅក្នុង ប្រវត្តិសាស្ត្រ គិត តាំងពី ពូជ អំបូរ រហូតដល់ ខ្លួន ឯង គឺ មាន តែ ចរិត ក្បត់ ជាតិ ញុះញង់ ឱ្យ មាន ការរើសអើង និង ហិង្សា ដែល យើង ទាំងអស់ គ្នា ត្រូវ ថ្កោល ទោស យ៉ាង ដាច់ខាត ។
សូម កុំ ធ្វើឱ្យ សាច់ញាតិ ជនរងគ្រោះ ស្រក់ ទឹកភ្នែក ព្រោះតែ ការបើកបរ ធ្វេសប្រហែស របស់ អ្នក ! ស្លាប់ ៦នាក់ និង របួស ៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១១ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៣ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ និង ស្រាល ៦នាក់ ។
( ពោធិ៍សាត់ )៖ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ថ្លែង ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដឹកនាំ កម្ពុជា មាន សន្តិភាព ពេញលេញ ជាង ២ទសវត្ស មាន ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍ គ្រប់ វិស័យ កំណើន សេដ្ឋកិច្ច ប្រកបដោយ ចិរភាព និង សមធម៌ ។
ការថ្លែង បែប នេះ របស់ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ធ្វើឡើង ក្នុង ឱកាស សំណេះសំណាល ជាមួយ មន្រ្តី រាជការ និង ប្រជាពលរដ្ឋ និង សម្ពោធ ជា ផ្លូវការ នូវ សាខា គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ វ៉ាយ អិល ភី នៅ ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៣ នេះ ។
លោក កែ សួន សុភាព តំណាង អគ្គ នាយក បាន ថ្លែង ស្វាគមន៍ និង រាយការណ៍ ពី ការអភិវឌ្ឍ រីកចម្រើន និង ការងារ ចូលរួម ជួយសង្គម របស់ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ វ៉ាយ អិល ភី មក ។
លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ បាន រាយការណ៍ ពី ការរីកចម្រើន របស់ ខេត្ត ក្រោម មាគ៌ា ដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច តេជោ ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ពាំនាំ បណ្តាំ សួរសុខទុក្ខ ពី ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ ពិសេស សម្តេច តេជោ ហ៊ុន សែន និង កោតស សើរ ដល់ ថ្នាក់ដឹកនាំ អាជ្ញាធរ គ្រប់ ថ្នាក់ ប្រជាពលរដ្ឋ ទាំងអស់ ពិសេស ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ ដែល បាន សាមគ្គីភាព ឯកភាព រួមគ្នា ជាមួយ រាជ រដ្ឋាភិបាល ថែរក្សា បាន នូវ សន្តិភាព និង បន្ត អភិវឌ្ឍ មូលដ្ឋាន បាន រីកចម្រើន ។
ជាមួយគ្នា នេះ ដែរ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ថ្លែង បន្ត ទៀត ថា ដើម្បី ចូលរួម ពន្លឿន សេដ្ឋកិច្ច ជាតិ ក្រោយ វិបត្តិ កូវីដ១៩ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ វ៉ាយ អិល ភី ម . ក ត្រូវបាន ដាក់ សម្ភោធ ជា ផ្លូវការ នូវ សមិទ្ធផល ថ្មី នៅក្នុង ឃុំ ថ្ម ដា ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ និង ជា សាខា ទី១០ ផ្តល់ ឥណទាន៖ រហ័ស ខ្នាត តូច បំផុត ខ្នាត តូច ខ្នាត មធ្យម មន្ត្រីរាជការ និង ទិញ សម្ភារៈ ប្រើប្រាស់ សម្រាប់ សាធារណជន ដោយ មិន រើសអើង ជាតិ សាសន៍ ពណ៌ សម្បុរ ជំនឿ សាសនា និន្នាការ នយោបាយ និង ឋានៈ សង្គម ។
ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ឧបត្ថម្ភ អ្នកចូលរួម ទាំងអស់ ក្នុង ម្នាក់ ៗ ទទួលបាន អាវយឺតYLP១ សារុង១ និង ថវិកា ១មុឺន រៀល ៕
យុវជន ខេត្ត ក្រចេះ កាន់តែ ច្រើន ឡើង ស្រឡាញ់ គាំទ្រ និង ចូលរួម ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា
( ក្រចេះ ) ៖ លោក ឈឿន ប៊ុណ្ណា រ័ត្ន សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ បាន លើកឡើង ថា យុវជន ខេត្ត ក្រចេះ កាន់តែ ច្រើន ឡើង ស្រឡាញ់ គាំទ្រ និង ចូលរួម ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
ការលើកឡើង បែប នេះ របស់ លោក ឈឿន ប៊ុណ្ណា រ័ត្ន បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល លោក រួម ជាមួយ លោក វ៉ា ថន សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណបក្ស ខេត្ត ក្រចេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស បញ្ចូល សមាជិក គណបក្ស ថ្មី របស់ គណបក្ស សង្កាត់ ក្រគរ និង សង្កាត់ រការ កណ្តាល ចំនួន ៣៥៨ នាក់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្រុង ក្រចេះ នៅ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៣ នៅ សាល មហោស្រព ខេត្ត ក្រចេះ ។
លោក សំ វ៉ាត តំណាង ក្រុមការងារ គណបក្ស ខេត្ត ចុះ ជួយ សង្កាត់ អូរឬស្សី . លោក សេក ប៊ុន ហេង ប្រធាន គណបក្ស ក្រុង ព្រមទាំង ការអញ្ជើញ ចូលរួម ពី លោក លោកស្រី អនុប្រធាន ក្រុមការងារ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ចុះ មូលដ្ឋាន ក្រុង ក្រចេះ គណៈកម្មាធិការ គណបក្ស ក្រុង គណៈកម្មាធិការ គណបក្ស សង្កាត់ ទាំង៥ គណៈកម្មាធិការ សាខា បក្ស ភូមិ សាខា ចំណុះ ស្មៀន សង្កាត់ យុវជន គណបក្ស ក្រុង យុវជន គណបក្ស សង្កាត់ និង សមាជិក គណបក្ស ទើប ចូល ថ្មី ដែល មាន សមាសភាព ចូលរួម សរុប ចំនួន ៤៩២ នាក់ ។
បន្ទាប់ពី លោកស្រី អ៊ុយ ធី ដែន សមាជិក អចិន្ត្រៃយ៍ គណបក្ស ក្រុង បាន អាន សេចក្តីសម្រេច បញ្ចូល សមាជិក បក្ស ថ្មី ទាំង ៣៥៨ នាក់ រួច មក ឯកឧត្តម ប្រធាន គណ: អធិបតី បាន ប្រគល់ សេចត្តីដល់ តំណាង សមាជិក ថ្មី ទាំង ៣៥៨ នាក់ និង បាន មាន មតិ សំណេះសំណាល និង ផ្តាំផ្ញើ ដល់ សមាជិក សមាជិកា ថ្មី ដែល មាន ខ្លឹមសារ សំខាន់ ៗ ដូច ខាងក្រោម៖
ក្នុង ឱកាស នេះ ដែរ ឯកឧត្តម ប្រធាន បាន ប្រគល់ សេចក្តីសម្រេច បញ្ចូល សមាជិក ថ្មី នៅ សង្កាត់ ក្រគរ ចំនួន ១៦០ នាក់ និង សង្កាត់ រការ កណ្តាល ចំនួន ១៩៨ នាក់ សរុប ចំនួន ៣៥៨ នាក់ និង បាន ជូន វត្ថុអនុស្សាវរីយ៍ ដល់ សមាជិក ថ្មី ទាំងអស់ ក្នុង ម្នាក់ ៗ ទទួលបាន អាវ បក្ស ០១. មួក បក្ស ០១. សារ៉ុង ០១ និង ក្រម៉ា ០១ ។
មុននឹង បញ្ចប់ លោក ឈឿន ប៊ុណ្ណា រ័ត្ន បាន ឧបត្ថម្ភ ថវិកា សម្រាប់ ខែមីនា ដល់ គណកម្មកា គណបក្ស សង្កាត់ ទាំង៥ ចំនួន ១.០០០.០០០ រៀល ក្នុង មួយ សង្កាត់ ដើម្បី អនុវត្ត ការងារ ប្រចាំ ខែ របស់ គណ: បក្ស សង្កាត់ សរុប ថវិកា អស់ ចំនួន ៥.០០០.០០០ រៀល ។
លោក វ៉ា ថន ឧបត្ថម្ភ អាវ បក្ស ចំនួន ៣៥៨ អាវ និង មួក បក្ស ចំនួន ៣៥៨ មួក . លោក ឈឿន ប៊ុណ្ណា រ័ត្ន និង ក្រុមការងារ ឧបត្ថម្ភ ក្រម៉ាចំនួន ៣៥៨ ក្រម៉ា សារុង ចំនួន ៣៥៨ សារ៉ុង និង ថវិកា ចំនួន ៥.០០០.០០០ រៀល ៕ ប្រធាន គណៈកម្មការ ទី៨ ព្រឹទ្ធសភា ជំរុញ ឲ្យ ស្ត្រី ប្រឹងប្រែង អភិវឌ្ឍន៍ សមត្ថភាព ដើរ ទាន់សម័យ ឌីជីថល ដើម្បី ទទួល ឱកាស ចូលរួម អភិវឌ្ឍន៍ និង ដឹកនាំ ប្រទេស
( កំពត ) ៖ លោកស្រី មាន សំអាន ប្រធាន គណៈកម្មការ ទី៨ ព្រឹទ្ធសភា និង ជា អនុប្រធាន សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ បាន ជំរុញ ឲ្យ ស្ត្រី ប្រឹងប្រែង អភិវឌ្ឍន៍ សមត្ថភាព ដើរ ឲ្យ ទាន់ សម័យ ឌីជីថល ដើម្បី ទទួលបាន ឱកាស ចូលរួម អភិវឌ្ឍន៍ និង ដឹកនាំ ប្រទេស ។
ការជំរុញ បែប នេះ ធ្វើឡើង ខណៈ លោកស្រី មាន សំអាន ចូលរួម ជា អធិបតី ក្នុង ពិធី អបអរសាទរ ទិវា អន្ដរជាតិ នារី ៨មីនា ឆ្នាំ ២០២៣ នៅ សាល សន្និសិទ សាលា ខេត្ត កំពត នា ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៣ ដោយ ចូលរួម ពីសំណាក់ លោក បណ្ឌិត ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត និង ភរិយា . លោក ញូវ សាឯ ម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង ភរិយា ព្រមទាំង ជួរ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ទាំង ៣ប្រភេទ អាជ្ញាធរ និង អ្នក ពាក់ព័ន្ធ ជាច្រើន រយ នាក់ ។
ទន្ទឹម នោះ លោកស្រី មាន សំអាន បាន បន្ត លើកឡើង ថា បច្ចុប្បន្ន ពិភពលោក ក៏ ដូចជា ប្រទេស កម្ពុជា កំពុង ខិតខំ កសាង សង្គម ឌីជីថល ឲ្យ បាន ឆាប់ រហ័ស ពិសេស ការកសាង ធនធាន ពលរដ្ឋ ឌីជីថល ដូច្នេះហើយ ស្ត្រី ក៏ ត្រូវ ខិតខំ ប្រឹងប្រែង អភិវឌ្ឍន៍ សមត្ថភាព ដើរ ឲ្យ ទាន់ សម័យ ឌីជីថល ដែរ ។ នារី មាន តួនាទី សំខាន់ នៅក្នុង កិច្ចការ ស្វែងរក នូវ សន្តិភាព ជូន ប្រទេសជាតិ និង ក្នុង គ្រួសារ ពិសេស ជួយ ស្តារ សេដ្ឋកិច្ច ។
ដូច្នេះហើយ ទើប សម្តេច តេជោ ជានិច្ចជាកាល បាន ផ្ដល់ ការគាំទ្រ លើកទឹកចិត្ត ការពារ សិទ្ធិ និង ផលប្រយោជន៍ របស់ ស្ត្រី និង ក្មេងស្រី ព្រមទាំង មាន គោល នយោបាយ និង យុទ្ធសាស្ត្រ ផ្តោត យ៉ាង ជាក់លាក់ ទៅ លើ ការលើកកម្ពស់ សមភាព យេនឌ័រ ការបង្កើន ភាពអង់អាច ដល់ ស្ត្រី និង ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស ដែល គ្រប់ ក្រសួង ស្ថាប័ន កំពុង អនុវត្ត ដើម្បី ប្រជាពលរដ្ឋ កម្ពុជា ។
លោក ម៉ៅ ធ និន អភិបាល ខេត្ត បាន លើកឡើង ថា ស្ត្រី នៅក្នុង ខេត្ត កំពត បាន រួមចំណែក សំខាន់ ក្នុង ការការពារ សន្តិភាព និង រក្សា បាន នូវ គោល នយោបា ភូមិ ឃុំ មាន សុវត្ថិភាព ល្អ ប្រសើរ ។
ប្រធាន មន្ទីរ កិច្ចការ នារី ខេត្ត កំពត លោកស្រី ហួត រី បាន បញ្ជាក់ ថា ដោយ មាន ការយកចិត្តទុកដាក់ លើ ការបង្កើន ចំនួន ស្ត្រី ក្នុង វិស័យ សាធារណៈ និង នយោបាយ ពី ប្រមុខ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ថ្នាក់ដឹកនាំ ក្រសួង - ស្ថាប័ន ជាពិសេស ថ្នាក់ដឹកនាំ ខេត្ត ធ្វើឲ្យ ចំនួន ស្ត្រី មាន ការកើនឡើង ជាលំដាប់ ក្នុង វិស័យ សាធារណៈ និង នយោបាយ ជាក់ស្តែង ខេត្ត កំពត មាន ចំនួន ស្ត្រី ១.៦៨៧ រូប ស្មើនឹង ៣១. ៥២ ភាគរយ បើ ធៀប នឹង ចំនួន សរុប ៥. ៣៥១ រូប ៕
មន្ត្រី នៅ ប៉ុស្ត ត្រួតពិនិត្យ ក្នុង តំបន់ លោក យូលី យ៉ាន់តូ (Yulianto) បាន និយាយ ថា នៅ មិន ទាន់ ការ អ្នកស្រុក ជម្លៀស ចេញ នោះ ទេ ។ ប៉ុន្តែ គេ សង្កេតឃើញ មាន ផេះ រអិល ធ្លាក់ ចេញ ពី ភ្នំ ភ្លើង ប្រហែល ៥ទៅ ៦លើក ប្រសិនបើ ការគ្របដណ្តប់ នៅតែ បន្ត កើនឡើង នៅ ចម្ងាយ ឆ្ងាយ ជាង ៧គីឡូម៉ែត្រ វា ទំនងជា នឹង នាំ ទៅដល់ ការជម្លៀស អ្នកស្រុក ។
ចូរ ប្រាប់ មនុស្ស ជា ទី ស្រលាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែមីនា៖ បង្ក្រាប ៩ករណី ឃាត់ខ្លួន ២៦ នាក់
លោក ថោង ខុន ដឹកនាំ ប្រជុំ ជីវភាព បក្ស នៅ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក ដើម្បី ត្រៀម ក្នុង ការចូលរួម បោះឆ្នោត សកល
( កំពង់ធំ )៖ លោក ថោង ខុន អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ និង ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក នា ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៣ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ជាមួយ ប្រធាន និង សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ទាំង ពីរ ដើម្បី ត្រៀមលក្ខណៈ ក្នុង ការចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ខាងមុខ ។
នា ឱកាស នោះ លោក ថោង ខុន ណែនាំ ដល់ ក្រុមការងារ គណបក្ស ត្រូវ បន្ត ចុះ ជួបប្រជាពលរដ្ឋ តាម ភូមិ តាម ខ្នង ផ្ទះ ដើម្បី ក្ដាប់ ពី សភាពការណ៍ និង តម្រូវការ ផ្សេង ៗ របស់ ប្រជាពលរដ្ឋ ។ ពិនិត្យ ការប្រើប្រាស់ ទឹក របស់ ប្រជាពលរដ្ឋ ដែល កំពុង ខ្វះខាត ក្នុង រដូវ ប្រាំង នេះ ។ ពិនិត្យ ដោះស្រាយ លើ ការកសាង ផ្លូវ ធ្វើដំណើរ នៅ តាម មូលដ្ឋាន ប្រជាពលរដ្ឋ ។
លោក បាន ណែនាំ ឱ្យ បន្ត ពិនិត្យមើល ការចុះឈ្មោះ បោះឆ្នោត របស់ ប្រជាពលរដ្ឋ ដោយ ស្រង់ ទិន្នន័យ ប្រជាពលរដ្ឋ ចុះឈ្មោះ ថ្មី ឱ្យ បាន ច្បាស់លាស់ ដោយ ខិតខំ ជំរុញ និង កសាង សមាជិក បក្ស ឱ្យ បាន កាន់ ច្រើន បន្ថែម ទៀត ជាមួយ នោះ ត្រូវ ខិតខំ តាមដាន និង ស្វែងរក ប្រជាពលរដ្ឋ ដែល ទើប បាន ចុះឈ្មោះ បោះឆ្នោត និង ដាក់បញ្ចូល ជា សមាជិក គណបក្ស ឱ្យ បាន គ្រប់ ៗ គ្នា ។
លោក ប្រធាន ថោង ខុន បាន ណែនាំ ដល់ ប្រធាន គណបក្ស ស្រុក ឃុំ ភូមិ ពិសេស ក្រុមប្រឹក្សា ឃុំ ត្រូវ រួមគ្នា ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ និង ចុះ ជួយ ដោះស្រាយ នូវ បញ្ហា របស់ ប្រជាពលរដ្ឋ ឱ្យ បាន ជាប់ លាប់ ជាប្រចាំ ដោយ ធ្វើ យ៉ាងណា កុំ ឱ្យ មាន ប្រជាពលរដ្ឋ ណា ម្នាក់ ជួប បញ្ហា ដោយ មិន មាន ការដោះស្រាយ ហើយ ការធ្វើ ដូចនេះ ដើម្បី បង្កើន ភាពស្និទ្ធស្នាល ជាមួយ ប្រជាពលរដ្ឋ និង ដើម្បី ទាក់ទាញ ការគាំទ្រ ពី ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ។
បន្ថែម ពី នេះ លោក ថោង ខុន ក៏ បាន ណែនាំ ឱ្យ គណបក្ស ស្រុក ទាំង២ ខិតខំ ពង្រឹង សមាជិក បក្ស នៅ តាម ភូមិ ឃុំ ឱ្យ បាន ច្បាស់ ទាក់ទង នឹង ការផ្ទៀងផ្ទាត់ បញ្ជី ឈ្មោះ បោះឆ្នោត និង ការផ្ទៀងផ្ទាត់ សមាជិក បក្ស ឱ្យ បាន ច្បាស់លាស់ នៅ តាម ភូមិ ឃុំ ដែល ជា មុខសញ្ញា ហើយ អ្វី ដែល កាន់តែ ពិសេស នោះ គឺ ត្រូវ ធ្វើ ការគ្រប់គ្រង សតិអារម្មណ៍ របស់ សមាជិបក្ស តាមរយៈ ការចុះ ជួយ ដោះស្រាយ នូវ រាល់ បញ្ហា របស់ ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេលវេលា ៕
ពីរ៉ាមីត ហ្គីហ្សា ជា ស្ថាបត្យកម្ម សាងឡើង សម្រាប់ តម្កល់ ព្រះសព របស់ ព្រះចៅ ផារ៉ា អុង នានា ក្នុង សម័យ អេហ្ស៉ី ប បុរាណ ( ផារ៉ា អុង មិន មែន ជា ព្រះនាម របស់ ព្រះមហាក្សត្រ នោះ ឡើយ តែ ជា ព្រះឧត្តម គោរមងារ របស់ ព្រះមហាក្សត្រ អេហ្ស៉ីប បុរាណ ) ។
ពីរ៉ាមីត ឃីហ្វ្រិន ស្ថិត នៅ ភាគ ខាងលិច ឆៀង ខាងត្បូង នៃ ពីរ៉ាមីត គូហ្វូ ដែល មាន លក្ខណៈ លេខ ធ្លោរ ផងដែរ ។ ពីរ៉ា មីត នេះ ត្រូវបាន សាង ពី ថ្ម កំបោរ ពណ៌ ស ។ ចំណែក ពីរ៉ា មីត ម៉ៃ ស៉ី រីណា សវិញ មាន កម្ពស់ ៦៥.៥ ម៉ែត្រ ដែល ត្រូវបាន គេ ចាត់ទុក ថា ជា ពីរ៉ាមីត ដែល តូច បំផុត ក្នុង ចំណោម ពីរ៉ា មីត ទាំង បី នេះ ៕ លោកស្រី យក់ សម្បត្តិ ដឹកនាំ គណៈប្រតិភូ ទស្សនកិច្ច សិក្សា ស្វែងយល់ ពី រចនាសម្ព័ន្ធ ការគ្រប់គ្រង ផ្តល់ សេវា និង ការបណ្តុះបណ្តាល ធនធាន មនុស្ស នៅ តាម មន្ទីរពេទ្យ សាកលវិទ្យាល័យ ល្បី ៗ នៅ កូរ៉េ
( ភ្នំពេញ ) ៖ តប តាម ការអញ្ជើញ របស់ ក្រុមហ៊ុន Inje Joint Venture ដែល ជា ទីប្រឹក្សា អនុវត្ត គម្រោង មន្ទីរពេទ្យ សាកលវិទ្យាល័យ វិទ្យាសាស្រ្ត សុខាភិបាល និង ដោយ បាន ទទួលគោលការណ៍ អនុញ្ញាត ពី ទីស្តីការ គណៈ រដ្ឋមន្រ្តី លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្តិ រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សុខាភិបាល បាន ដឹកនាំ គណៈប្រតិភូ អញ្ជើញ ទៅ ធ្វើ ទស្សនកិច្ច សិក្សា នៅ សាធារណរដ្ឋ កូរ៉េ ពី ថ្ងៃទី ៩ ដល់ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៣ ។
នៅ តាម មន្ទីរពេទ្យ នីមួយ ៗ លោកស្រី រដ្ឋលេខាធិការ ប្រចាំ ការ និង គណៈប្រតិភូ បាន កត់សម្គាល់ ឃើញ ថា មន្ទីរពេទ្យ ទាំងនោះ សុទ្ធតែ បាន បំពាក់ នូវ សម្ភារៈ បរិក្ខារ វេជ្ជសាស្រ្ត ទំនើប និង បច្ចេកវិទ្យា ថ្មី ៗ ជាពិសេស ប្រព័ន្ធ ព័ត៌មានវិទ្យា (ICT) គ្រូពេទ្យ មាន ជំនាញ និង បាន ទទួល ការបណ្តុះបណ្តាល ច្បាស់លាស់ ។
