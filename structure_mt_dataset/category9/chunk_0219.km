( សិង្ហបុរី ) ៖ ទំនាក់ទំនង រវាង កម្ពុជា និង ចិន ត្រូវបាន ប្រទេស ទាំង២ហៅ ថា ជា « មិត្ត ដែក ថែប » ។ ចិន គឺជា ដៃគូ ពាណិជ្ជកម្ម ធំ បំផុត សម្រាប់ កម្ពុជា និង ចាប់តាំងពី ឆ្នាំ ២០១២មក ចិន បាន វ៉ា ដាច់ ជប៉ុន ក្លាយជា អ្នក ផ្ដល់ ជំនួយ និង កម្ចី អភិវឌ្ឍន៍ ដ៏ ធំ បំផុត សម្រាប់ កម្ពុជា ។ ដោយសារតែ ទំនាក់ទំនង មិត្ត ដែក ថែប នេះ ឯង នៅ ពេល ដែល កម្ពុជា ទទួលយក ញញួរ ជា ប្រធាន អាស៊ាន កាលពី ចុង ឆ្នាំ ២០២១ វា បាន ធ្វើឱ្យ មនុស្ស មួយចំនួន គិត ថា កិច្ចប្រជុំ អាស៊ាន ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នឹង ទទួលបរាជ័យ ។
នៅក្នុង បរិបទ ភូមិសាស្ត្រ នយោបាយ សព្វ ថ្ងៃ ដើម្បី អនាគត សេដ្ឋកិច្ច និង សន្តិសុខ ប្រទេស ណា ក៏ដោយ ក៏ មិន អាច ពង្រឹង ទំនាក់ទំនង ឬ ផ្ដេក ផ្ដួល លើ ទំនាក់ទំនង ជាមួយ មហា អំណាច តែ មួយ គត់ ឡើយ ម្លោះ ហើយ អ្នកដឹកនាំ ជំនាន់ ក្រោយ របស់ កម្ពុជា គួរតែ បន្ត « ធ្វើ ពិពិធកម្ម នយោបាយ ការបរទេស » របស់ ខ្លួន និង បង្ហាញ ថា « កម្ពុជា នឹង មិន យក ពង មាន់ របស់ ខ្លួន ទាំងអស់ ទៅ ដាក់ ក្នុង កន្ត្រក របស់ ចិន នោះ ទេ »៕ សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣
១៖ ព្រះមហាក្សត្រ និង សម្តេច ព្រះវរ រាជ មាតា បាន យាង មកដល់ មាតុភូមិ កម្ពុជា វិញ ហើយ
២៖ ប្រធានាធិបតី កូរ៉េ ខាងត្បូង ជាន់ ដី ជប៉ុន ជា លើក ដំបូង ក្នុង រយៈពេល ១២ ឆ្នាំ ដើម្បី បើក ទំព័រ ថ្មី នៃ ទំនាក់ទំនង ប្រទេស ទាំង ២
៤៖ ប្រធានាធិបតី ស៉ីរី បង្ហាញ ការស្វាគមន៍ ចំពោះ លទ្ធភាព នៃ ការបង្កើន វត្តមាន យោធា រុស្ស៉ី នៅក្នុង ប្រទេស របស់ លោក
៥៖ សម្តេច តេជោ ហ៊ុន សែន៖ មិន ថា អស់ ថវិកា ប៉ុន្មាន ទេ ត្រូវតែ សង់ ព្រះរាជ ដំណាក់ នៅ ខេត្ត សៀមរាប ឡើងវិញ
៦៖ បារាំង រង ការចោទប្រកាន់ ថា ពន្យឺត ពេល ផ្តល់ ជំនួយ ជាង ២ពាន់ លាន ដុល្លារ របស់ EU សម្រាប់ អ៊ុយក្រែន
៧៖ សម្ដេច តេជោ ហ៊ុន សែន ណែនាំ ឲ្យ ដាក់ តម្លៃ លើ ចំណីអាហារ និង យកចិត្ដទុកដាក់ លើ សុវត្ថិភាព ចំណីអាហារ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី
៩៖ សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ កុំ ភ័យ ស្លន់ស្លោ ទៅដក លុយ ពី ធនាគារ រឿង ធនាគារ អាមេរិក ដួលរលំ មិន ប៉ះពាល់ ដល់ កម្ពុជា ទេ សូម ជឿជាក់ លើ សមត្ថភាព គ្រប់គ្រង របស់ រាជ រដ្ឋាភិបាល
១០៖ ប្រមុខ ការពារ ជាតិ អាមេរិក និង រុស្ស៉ី ពិភាក្សា គ្នា តាម ទូរស័ព្ទ ក្រោយ ឧប្បត្តិហេតុ យន្ដហោះ ដ្រូន
១១៖ ធនាគារ នៅ តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក រង ផល ប៉ះពាល់ តិចតួច ពី ការដួលរលំ ធនាគារ នៅ អាមេរិក
១២៖ សម្តេច តេជោ ហ៊ុន សែន សោកស្តាយ ចំពោះ ករណី ឆេះ ព្រះរាជ ដំណាក់ ខេត្ត សៀមរាប និង ជំរុញ ការជួសជុល ឱ្យ បាន ត្រឹមត្រូវ
១៣៖ កូរ៉េ ខាងជើង បាញ់ សាកល្បង មីស៊ីល រយៈ ចម្ងាយ ឆ្ងាយ មួយ គ្រាប់ មុន ជំនួប កំពូល ជប៉ុន - កូរ៉េ ខាងត្បូង
១៥៖ សម្តេច តេជោ ហ៊ុន សែន ព្រមាន ទម្លាយ លិខិត របស់ រដ្ឋមន្ត្រី មួយចំនួន ដែល មាន កំហុសឆ្គង តាម បណ្តាញ សង្គម
១៦៖ នាយក រដ្ឋមន្រ្តី សិង្ហបុរី ថា នឹង ធ្វើការ ជាមួយ ឥណ្ឌូណេស៉ី អាស៊ាន និង UN ដើម្បី ជំរុញ ផែនការ សន្តិភាព មីយ៉ាន់ម៉ា
១៧៖ សម្តេច តេជោ ហ៊ុន សែន បន់ស្រន់ ឱ្យ បារមី ព្រះអង្គ ចេក ព្រះអង្គ ចម កុំ ត្រា ប្រណី លើ ជន បំភ្លៃ ព័ត៌មាន និង ចោទ ថា រាជ រដ្ឋាភិបាល និង បក្ស ប្រជាជន ដុត ព្រះរាជ ដំណាក់
១៨៖ ក្រុមហ៊ុន ផលិត អាវុធ ឥណ្ឌា - រុស្ស៉ី សម្លឹង ឆ្ពោះ ទៅរក ការលក់ មី ស៉ីល តម្លៃ ប្រហែល ២០០ លាន ដុលា្លរ ឲ្យ ប្រទេស ឥណ្ឌ ណេស៉ី
១៩៖ សម្ដេច តេជោ ហ៊ុន សែន៖ គណបក្ស ប្រជាជន កម្ពុជា គឺជា និមិត្តរូប នៃ ការផ្លាស់ប្ដូរ នៅ កម្ពុជា . ប្ដូរ ពី សង្គ្រាម មក សន្ដិភាព និង ការអភិវឌ្ឍ
២០៖ ចិន រារាំង អាមេរិក មិន ឱ្យ ផ្សាយ កិច្ចប្រជុំ របស់ UN ស្តីពី បញ្ហា សិទ្ធិ មនុស្ស នៅ កូរ៉េ ខាងជើង
២១៖ សម្តេច តេជោ ហ៊ុន សែន អង្វរករ ដល់ រដ្ឋ មន្ត្រី ទាំងឡាយ កុំ ខ្ជីខ្ជា ត្រូវ ពិនិត្យ ឱ្យ ច្បាស់ លើ លិខិត ទាំងអក្ខរាវិរុទ្ធ និង ការដាក់ ថ្ងៃ ខែ មុន ចុះហត្ថលេខា ដាក់ ជូន សម្តេច . មាន តែ ក្រសួង ចំនួន ៤ ដែល ធ្វើ លិខិត បាន ល្អ និង មិន វែងឆ្ងាយ
២២៖ គ្រូបង្រៀន ៥០.០០០ នាក់ នាំគ្នា ធ្វើ កូដកម្ម នៅ នូវែលសេឡង់ ជុំវិញ បញ្ហា ប្រាក់ខែ និង លក្ខខណ្ឌ ការងារ ចំពោះមុខ ការកើនឡើង នៃ តម្លៃ សម្រាប់ ការរស់នៅ ប្រចាំ ថ្ងៃ
២៣៖ សម្តេច តេជោ ហ៊ុន សែន គាំទ្រ សេចក្តីណែនាំ របស់ ក្រសួង អប់រំ ពាក់ព័ន្ធ ការនាំ សិស្ស លេង ល្បែង និង របាំ ប្រជាប្រិយ ខ្មែរ ក្នុង ឱកាស ត្រៀម អបអរសាទរ ថ្ងៃ ប្រារព្ធ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ
២៤៖ វិភាគ អន្តរជា តិ៖ តាមរយៈ នាវា មុជទឹក នុយក្លេអ៊ែរ . តើ អ្វី ទៅ ជាសារ ដែល អាមេរិក អង់គ្លេស និង អូស្រ្តាលី ចង់ ផ្ញើ ទៅ ចិន ?
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៤២៨ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២៣.៥៥០ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១៩.៥៥២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៣. ៩៩៨ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក ស្រវឹង ផ្លាកលេខ និង ល្មើស សញ្ញា ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ខ្សែក្រវាត់ បត់ ជែង ឆៀក អត់ បណ្ណ បើកបរ លើស ចំណុះ ទូរស័ព្ទ អត់ ផ្លាកលេខ និង ល្មើស សញ្ញា ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៦ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០២ នាក់ របួស ចំនួន ០៩ នាក់ ( របួស ធ្ងន់ ចំនួន ០៤ នាក់ ) ។ រយៈពេល ៧៥ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៦១១ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៣០៥ នាក់ របួស ៨០៣ នាក់ ( របួស ធ្ងន់ ៥៣៤ នាក់ )៕
ស ស យ ក ខេត្ត សៀមរាប រៀបចំ ពិធី ក្រុង ពាលី នៅ តាម ការដ្ឋាន ដើម្បី ត្រៀម ក្មុង ព្រឹត្តិការណ៍ អង្គរ សង្រ្តាន្ត ឆ្នាំ ២០២៣ ដែល នឹង ចូលមក ក្នុង ពេល ឆាប់ ៗ នេះ
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត សៀមរាប បាន រៀបចំ ពិធី សែន ក្រុង ពាលី ស សេចក្តីសុខ នឹង បើក ការដ្ឋាន សាងសង់ របស់ ក្រុមការងារ ល្បែង ប្រជាប្រិយ ក្នុង ព្រឹត្តិការណ៍ អង្គរ សង្ក្រាន្ត ឆ្នាំ ២០២៣ នៅមុខ ប្រាសាទ អង្គរវត្ត ។
លោក Wang បាន កត់សម្គាល់ ថា ការឈ្លានពាន និង ការគ្រប់គ្រង អាណានិគម នៃ របប យោធានិយម របស់ ជប៉ុន កាលពី អតីតកាល បាន នាំមក នូវ គ្រោះមហន្តរាយ ដ៏ ធំ ដល់ ប្រទេស ចិន កូរ៉េ ខាងត្បូង ក៏ ដូចជា អាស៊ី ទាំងមូល ។
ដោយ កត់សម្គាល់ ថា ប្រទេស ចិន ជប៉ុន និង កូរ៉េ ខាងត្បូង គឺជា ដៃគូ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ដ៏ សំខាន់ របស់ គ្នា ទៅ វិញ ទៅ មក លោក Wang បាន និយាយ ថា វា គឺជា ផលប្រយោជន៍ រួម របស់ ភាគី ទាំង បី និង ក្នុង តំបន់ ដើម្បី រួមគ្នា រក្សា ស្ថិរភាព និង ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ ដោយ គ្មាន ការរារាំង នៅ កម្រិត តំបន់ និង ពិភពលោក ៕
គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ ប្រកាស ទទួលស្គាល់ សមាជិក ថ្មី ចំនួន ៤៦១ នាក់ នៅ សង្កាត់ ស្រយ៉ូវ ក្រុង ស្ទឹង សែន
( កំពង់ធំ )៖ លោក ងួន រតនៈ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពង់ធំ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ស្ទឹង សែន បាន អញ្ជើញ ប្រកាស បញ្ចូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ថ្មី ៤៦១ នាក់ អញ្ជើញ មកពី ១៣ភូមិ ស្ថិត នៅ សង្កាត់ ស្រយ៉ូវ ក្រុង សែន ខេត្ត កំពង់ធំ រសៀល ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៣ ។
លោក ងួន រតនៈ បាន លើកឡើង ពី គោល នយោបាយ ក្នុង ការដឹកនាំ ប្រទេស និង គុណ បំណាច់ ដ៏ មហា ធំធេង របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន សង្គ្រោះ ជាតិ ឲ្យ រស់ ឡើងវិញ រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ នា ថ្ងៃ ៧ មក រា ១៩៧៩ និង បាន ទប់ស្កាត់ មិន ឲ្យ របប ដ៏ យង់ឃ្នង នេះ វិលត្រឡប់ មកវិញ ។
លោក ថា គណបក្ស ប្រជាជន កម្ពុជា បាន ដណ្តើម មក ជូន ប្រជាជន វិញ នូវ សិទ្ធិ សេរីភាព គ្រប់ យ៉ាង កិត្តិយស សេចក្ដីថ្លៃថ្នូរ និង លទ្ធិ ប្រជាធិបតេយ្យ ដែល បាន បាត់បង់ ក្នុង របប ប្រល័យ ពូជសាសន៍ ។ សម្រេចបាន ការបោះឆ្នោត ដោយ សេរី និង យុត្តិធម៌ ជា បន្តបន្ទាប់ ទាំង នៅ ថ្នាក់ ជាតិ និង មូលដ្ឋាន ទាំង សកល និង អសកល ។
លោក បាន លើកទឹកចិត្ត ដល់ សមាជិក សមាជិកា ឱ្យ យល់ កាន់ ច្បាស់ ពី គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការស្ដារ ខឿន សេដ្ឋកិច្ច សង្គម ឡើងវិញ ជា ជំហាន ៗ តាំងពី លេខ សូន្យ រហូត មាន ការរីកចម្រើន យ៉ាង ខ្លាំង ដូច បច្ចុប្បន្ន ។
