តើការទទួលពរពីព្រះយេ ហូវ៉ាផ្អែកលើអ្វី ?
ព្រះយេ ហូវ៉ាបានប្រទានពរខាងវិញ្ញាណនិងខាងសម្ភារៈលើពួកយូដានោះ ហើយទ្រង់ក៏នឹងប្រទានពរលើយើងផងដែរ ពេលយើងខិតខំធ្វើកិច្ចការដែលទ្រង់ប្រគល់ឲ្យដោយរីករាយ ។ ពរទាំងនោះរួមបញ្ចូលសេចក្ដីសុខ សាន្ដ សុវត្ថិភាព ភាពចម្រុងចម្រើន និងការរីកចម្រើនខាងវិញ្ញាណក្នុងចំណោមបងប្អូនយើង ។ ប៉ុន្ដែ យើងត្រូវទទួលស្គាល់ថា យើងអាចទទួលពរពីព្រះយេ ហូវ៉ាបាន ឲ្យតែយើងធ្វើការនៅឯព្រះវិហារខាងវិញ្ញាណ តាមរបៀបដែលទ្រង់សព្វព្រះហឫទ័យ ។
តើយើងអាចពិនិត្យមើលអាទិភាពក្នុងជីវិតយើងដោយសួរសំណួរអ្វីខ្លះ ?
នៅសព្វថ្ងៃនេះ យើងអាចទទួលពរពីព្រះយេ ហូវ៉ាបាន ស្របទៅតាមកម្រិតដែលយើងលើកត ម្កើងព្រះនាមទ្រង់និងឈានទៅមុខក្នុងកិច្ចការរបស់យើងនៅឯព្រះវិហារខាងវិញ្ញាណរបស់ទ្រង់ ។ ចូរសួរខ្លួនឯងថា៖ ‹ តើខ្ញុំបានចាប់ផ្ដើមចាត់ទុកអ្វីផ្សេងជាអាទិភាពក្នុងជីវិតខ្ញុំឬទេ ?
តើខ្ញុំផ្ដោតអារម្មណ៍លើការរស់នៅដោយស្រណុកស្រួលដល់ម៉្លេះបានជានេះមានឥទ្ធិពលលើការបម្រើព្រះយេ ហូវ៉ានិងការលើកត ម្កើងព្រះរាជាណាចក្ររបស់ទ្រង់ឬ ?
តើខ្ញុំខ្លាចមនុស្សនិងទស្សនៈរបស់គេដល់ម៉្លេះបានជាខ្ញុំអាក់ខានលើកត ម្កើងព្រះយេ ហូវ៉ាយ៉ាងពេញលេញឬទេ ? ›
តើយើងគួរធ្វើអ្វីស្របទៅតាមមេរៀនក្នុងហាកាយ ១: ៦, ៩ ?
បើយើងចង់ទទួលពរពីព្រះយេ ហូវ៉ាជានិច្ច យើងត្រូវជៀសវាងការស្វែងរកតែប្រយោជន៍ខ្លួនឯងដល់ម៉្លេះបានជាភ្លេចលើកត ម្កើងព្រះយេ ហូវ៉ា មែនទេ ?
នេះមានន័យថាយើងត្រូវជៀសវាងការស្វែងរកលុយហួសហេតុពេក ហើយជៀសវាងការជក់ស្លុងនឹងវិធីរកលុយឲ្យបានភ្លាម ៗ ការរៀនសូត្រយ៉ាងច្រើនដើម្បីឲ្យមានអាជីពក្នុងលោកិយនេះដែលនាំឲ្យមានប្រាក់ខែច្រើន និងការរកវិធីបំពេញតែចិត្ដប្រាថ្នារបស់ខ្លួន ។
ស្រដៀងគ្នាដែរ ការធានារ៉ាប់រងថាការថ្វាយបង្គំពិតនឹងមានជ័យ ជំនះផ្ដាច់ព្រ័ត្រគួរជំរុញយើងឲ្យមានសកម្មភាពដែរ ទាំងជំរុញយើងឲ្យយកចិត្ដទុកដាក់ចំពោះទីកន្លែងថ្វាយបង្គំព្រះយេ ហូវ៉ា ។ សូមសួរខ្លួនឯងថា៖ ‹ បើខ្ញុំជឿថានេះជាគ្រាដែលយើងគួរធ្វើកិច្ចការផ្សព្វផ្សាយដំណឹងល្អអំពីព្រះរាជាណាចក្ររបស់ព្រះនិងគួរបញ្ចុះបញ្ចូលឲ្យមានសិស្ស តើគោលដៅនិងរបៀបរស់នៅរបស់ខ្ញុំបង្ហាញពីជំនឿស៊ប់នេះឬទេ ?
តើខ្ញុំចំណាយពេលគ្រប់គ្រាន់ក្នុងការសិក្សាទំនាយផ្សេង ៗក្នុងព្រះបន្ទូលរបស់ព្រះ ទាំងយកចិត្ដទុកដាក់ចំពោះបន្ទូលទ្រង់ដោយពិភាក្សារឿងនេះជាមួយនឹងបងប្អូនគ្នីគ្នាហើយជាមួយមនុស្សឯទៀតដែលខ្ញុំជួបឬទេ ? ›
យោងទៅតាមសាការីជំពូក១៤ តើមានព្រឹត្ដិការណ៍អ្វីខ្លះនៅខាងមុខ ?
នេះជាការធានាដ៏អស្ចារ្យណាស់ !
យើងនឹងពិសោធដោយផ្ទាល់នូវអ្វីដែលបានទាយទុកជាមុននោះ ហើយនឹងឃើញការដែលលើកត ម្កើងព្រះយេ ហូវ៉ាជាព្រះដែលមានសិទ្ធិគ្រប់គ្រងមែន ។ ថ្ងៃនោះពិតជាថ្ងៃដ៏ពិសេសមួយដែលជារបស់ផងព្រះយេ ហូវ៉ា !
ព្រះយេ ហូវ៉ាប្រទានពរជារៀងរហូត
តើយើងគួរតាំងចិត្ដធ្វើអ្វី ?
ហាកាយនិងសាការីបានលើកទឹកចិត្ដពួកយូដា ឲ្យធ្វើការអស់ពីចិត្ដដើម្បីបានទទួលពរ
តើអ្នក« គិតតែខ្នះ ខ្នែងពីរឿងផ្ទះសំបែងរបស់ខ្លួន »ឬទេ ?
ព្រះយេ ហូវ៉ាបានសន្យាថានឹងប្រទានពរឲ្យគេ ហើយទ្រង់បានធ្វើដូច្នេះមែន !
ពួកអ្នកគង្វាលដែលជា« គំរូដល់ហ្វូងចៀម »
ហេតុអ្វីក៏ព្រះយេស៊ូមិនបង់ប្រយោជន៍ដោយទុកចិត្ដលើពេត្រុស ?
នៅសព្វថ្ងៃនេះ ព្រះយេ ហូវ៉ាប្រើព្រះយេស៊ូគ្រី ស្ទដើម្បីតែងតាំងបុរសនានាដែលមានគុណ សម្បត្ដិគ្រប់គ្រាន់ឲ្យធ្វើកិច្ចការបម្រើជាអ្នកគង្វាលខាងវិញ្ញាណ ដើម្បីនាំមុខចៀមទ្រង់ក្នុងកំលុងគ្រាដ៏លំបាកបំផុតនេះក្នុងប្រវត្ដិសាស្ដ្រមនុស្ស ។ តើព្រះយេ ហូវ៉ាបង់ប្រយោជន៍ដោយទុកចិត្ដលើមនុស្សបែបនេះឲ្យធ្វើជាអ្នកគង្វាលឬទេ ?
តើអ្វីអាចជួយពួកអ្នកគង្វាលខាងវិញ្ញាណឲ្យគាប់ចិត្ដឃ្វាលចៀមដោយស្ម័គ្រពីចិត្ដ ?
តើរឿងនោះបានត្រូវដោះស្រាយដោយរបៀបណា ?
ហេតុអ្វីក៏ព្រះយេស៊ូត្រូវមានព្រះទ័យអត់ធ្មត់និងប្រព្រឹត្ដដោយសុភាពចំពោះពួកសាវ័កទ្រង់ ?
ទោះជាពួកសាវ័ករបស់ព្រះយេស៊ូចេះតែធ្វើខុសដដែល ៗ ទ្រង់តែងតែមានព្រះទ័យអត់ធ្មត់ហើយប្រព្រឹត្ដដោយសុភាពចំពោះពួកគាត់ ។ ជាឧទាហរណ៍ ព្រះយេស៊ូបានបង្រៀនម្ដងហើយម្ដងទៀតថា ពួកគាត់ត្រូវតែចេះបន្ទាបខ្លួន ។ យ៉ាងណាក៏ដោយ នៅរាត្រីចុងបង្អស់ដែលព្រះយេស៊ូគង់នៅលើផែនដីជាមនុស្ស ទ្រង់ទើបតែបានលាងជើងពួកសាវ័កទុកជាមេរៀនអំពីការបន្ទាបខ្លួន ស្រាប់តែ« កើតមានសេចក្ដីទាស់ទែងគ្នាអំពីអ្នកណាដែលរាប់ជាធំជាងគេ » ។ តើព្រះយេស៊ូស្ដីបន្ទោសពួកសាវ័កទេ ?
អ្នកដែលអង្គុយនៅតុ ឬអ្នកដែលបំរើ ?
តើមិនមែនជាអ្នកដែលអង្គុយនៅតុទេឬអី ?
ប៉ុន្ដែ ខ្ញុំនៅកណ្ដាលពួកអ្នករាល់គ្នាទុកដូចជាអ្នកបំរើវិញ » ។ យូរ ៗទៅ ព្រះទ័យអត់ធ្មត់សុភាពរាបសារបស់ព្រះយេស៊ូ ព្រមទាំងគំរូដ៏ល្អរបស់ទ្រង់មានឥទ្ធិពលលើចិត្ដគំនិតរបស់ពួកសាវ័កទ្រង់ ។
តើពួកអ្នកគង្វាលបង្ហាញសេចក្ដីសប្បុរសដូចព្រះយេ ហូវ៉ាដោយធ្វើអ្វី ?
តើអ្វីជំរុញពួកអ្នកចាស់ទុំឲ្យធ្វើការផ្សព្វផ្សាយ ?
តើពេត្រុសបានទាញយកមេរៀនអ្វីពីព្រះយេស៊ូ ?
។ ពេត្រុសបានទាញយកមេរៀនពីព្រឹត្ដិការណ៍នោះ ហើយប៉ុន្មានឆ្នាំក្រោយមកបានរំលឹកពួកគ្រីស្ទានថា៖ « ព្រះគ្រី ស្ទក៏បានរងទុក្ខជំនួសយើងដែរ ទាំងទុកដំរាប់ឲ្យយើងរាល់គ្នាដើរតាមលំអានដាននៃទ្រង់ ។ ...
គ្មានការសង្ស័យអ្វីឡើយ ថាព្រះយេ ហូវ៉ានិងព្រះយេស៊ូសព្វព្រះហឫទ័យចំពោះពួកអ្នកគង្វាលរាប់ពាន់នាក់ដែលខំធ្វើកិច្ចការមើលថែរក្សាយ៉ាងស្ម័គ្រអស់ពីចិត្ដនូវហ្វូងចៀមដែលមានទូទាំងពិភពលោកនេះ ។ ព្រះយេ ហូវ៉ានិងរាជ បុត្រាទ្រង់ក៏ស្រឡាញ់ពួកអ្នកងារជំនួយរាប់ពាន់នាក់ដែលគាំទ្រពួកអ្នកចាស់ទុំក្នុងការ« បំរើពួកបរិសុទ្ធ » ។ បើដូច្នេះ ហេតុអ្វីក៏បងប្អូនប្រុស ៗខ្លះមិនចង់រួមចំណែកក្នុង« ការល្អប្រសើរ »នេះ ទោះជាបានធ្វើបុណ្យជ្រមុជទឹកហើយក៏ដោយ ?
ហើយតើព្រះយេ ហូវ៉ាបង្វឹកបង្វឺនពួកអ្នកដែលទ្រង់តែងតាំងជាអ្នកគង្វាលដោយរបៀបណា ?
យើងនឹងឆ្លើយសំណួរទាំងនេះក្នុងអត្ថបទជាបន្ទាប់ ។
សេចក្ដីស្រឡាញ់ជំរុញពួកអ្នកចាស់ទុំឲ្យបម្រើក្រុម ជំនុំ
ពួកអ្នកចាស់ទុំចំណាយពេលជាមួយក្រុមគ្រួសាររបស់ខ្លួនក្នុងការកម្សាន្ដលំហែចិត្ដកាយ ...
ពួកអ្នកចាស់ទុំបង្កើតឲ្យមានអំណរនិងភាពសុខ សាន្ដក្នុងក្រុម ជំនុំដោយចេះពិភាក្សាគ្នា
ព្រះយេ ហូវ៉ាបង្វឹកបង្វឺនពួកអ្នកគង្វាលដើម្បីឃ្វាលហ្វូងចៀមទ្រង់
តើអ្វីជំរុញពួកប្រុស ៗដែលបានធ្វើបុណ្យជ្រមុជទឹកឲ្យខំទទួលភារកិច្ចបន្ថែមក្នុងក្រុម ជំនុំ ?
ចុះយ៉ាងណាចំពោះបុរសគ្រីស្ទានដែលបានធ្វើបុណ្យជ្រមុជទឹកតែមានអារម្មណ៍ថាខ្លួនខ្វះសមត្ថភាព ដូច្នេះមិនចង់ទទួលភារកិច្ចជាអ្នកងារជំនួយឬនៅទីបំផុតជាអ្នកចាស់ទុំដែរ ?
ប្រហែលជាគាត់ខ្វល់ខ្វាយដូចបងប្រុសនិកដែរ ថាខ្លួនគ្មានបំ និនគ្រប់គ្រាន់ដើម្បីធ្វើជាអ្នកគង្វាលដែលមានប្រសិទ្ធភាព ។ តើអ្នកជាបុរសដែលបានធ្វើបុណ្យជ្រមុជទឹកហើយមានអារម្មណ៍ដូចនេះឬទេ ?
ផ្ទុយទៅវិញ ព្រះយេ ហូវ៉ាផ្ដល់ជំនួយដែលមិនគ្រាន់តែជួយពួកអ្នកបម្រើនោះឲ្យស៊ូទ្រាំប៉ុណ្ណោះទេ តែជួយគាត់ឲ្យលូតលាស់ទៀតផងដែរ ។ ដូចបានពិគ្រោះក្នុងអត្ថបទមុននេះ ព្រះយេ ហូវ៉ាប្រទានវិញ្ញាណបរិសុទ្ធដល់ពួកអ្នកបម្រើក្នុងក្រុម ជំនុំ ហើយផល ផ្លែនៃវិញ្ញាណទ្រង់ជួយពួកគាត់ឲ្យថែទាំហ្វូងចៀមរបស់ទ្រង់ដោយសេចក្ដីស្រឡាញ់ ។ បន្ថែមទៅទៀត ព្រះយេ ហូវ៉ាក៏ប្រទានឲ្យពួកអ្នកបម្រើមានប្រាជ្ញា ចំណេះនិងសមត្ថភាពវែកញែក ។ ( សុភាសិត ២: ៦) តើព្រះយេ ហូវ៉ាប្រទានជំនួយនេះដោយរបៀបណា ?
ហេតុអ្វីក៏ពេត្រុសនិងយ៉ូហានជាអ្នកគង្វាលដែលមានប្រសិទ្ធភាព ?
បទពិសោធន៍របស់បងឆាឌបង្ហាញថា ពួកអ្នកគង្វាលដែលចេះគិតពិចារណានោះ គួរចាប់ផ្ដើមបង្វឹកបង្វឺនបងប្អូនប្រុស ៗយូរឆ្នាំមុនគាត់មានលក្ខណៈគ្រប់គ្រាន់ដើម្បីទទួលឯក សិទ្ធិជាអ្នកងារជំនួយឬអ្នកចាស់ទុំ ។ ហេតុអ្វីក៏គួរបង្វឹកបង្វឺនពួកគេមុននឹងប្រគល់ឯក សិទ្ធិ ?
ពីព្រោះព្រះគម្ពីរបង្គាប់ថា ពួកប្រុស ៗត្រូវតែប្រកបដោយសីលធម៌ហើយបំពេញតាមតម្រូវការខាងវិញ្ញាណមុនគាត់អាចទទួលមុខតំណែងជាអ្នកងារជំនួយឬអ្នកចាស់ទុំ ។ ព្រះគម្ពីរបង្គាប់ឲ្យ ‹ ល្បង លអ្នកទាំងនោះជាមុនដំបូង › ទើបគាត់អាចទទួលភារកិច្ចបាន ។ — ធី ម៉ូថេ ទី១ ៣: ១-១០
ហេតុអ្វីបានជាពួកគាត់មានភារកិច្ចធ្វើដូច្នេះ ?
ត្រូវមែន បើចង់ល្បង លលក្ខណៈរបស់បងប្អូនប្រុស ៗ នោះគួរគប្បីឲ្យបង្វឹកបង្វឺនគាត់ជាមុនសិន ។ ឧបមាថា បើគ្រូឲ្យសិស្សប្រឡងពិបាកមួយ តែមិនបង្រៀនគេទុកជាមុននោះ តើសិស្សមានលទ្ធភាពប្រឡងជាប់ទេ ?
គេច្បាស់ជាធ្លាក់ហើយ !
តើពួកអ្នកគង្វាលអាចធ្វើអ្វីខ្លះដើម្បីបង្វឹកបង្វឺនបងប្អូនប្រុស ៗឲ្យចេះទទួលភារកិច្ចផ្សេង ៗក្នុងក្រុម ជំនុំ ?
តើពួកអ្នកគង្វាលដែលមានបទពិសោធន៍ច្រើនអាចធ្វើអ្វីខ្លះដើម្បីបង្វឹកបង្វឺនបងប្អូនប្រុស ៗឲ្យចេះទទួលភារកិច្ចផ្សេង ៗក្នុងក្រុម ជំនុំ ?
តើពួកអ្នកគង្វាលដែលមានបទពិសោធន៍ច្រើនអាចជួយបង្វឹកបង្វឺនអ្នកចាស់ទុំដែលទើបតែបានទទួលមុខតំណែងនោះដោយរបៀបណា ?
ព្រះយេស៊ូពន្យល់ថា៖ « អ្នកណាដែលនិយាយដោយអាងខ្លួនឯង នោះចង់តែលើកដំកើងដល់ខ្លួនទេ » ។ — យ៉ូហាន ៧: ១៦, ១៨
តើពួកអ្នកគង្វាលមិនលើកត ម្កើងខ្លួនឯងដោយធ្វើអ្វី ?
ប្រហែលជាយោបល់របស់អ្នកចាស់ទុំនោះចង្អៀតចង្អល់ដោយព្រោះគាត់មិនសូវមានចំណេះច្រើន ឬច្រើនតែទាក់ទងនឹងទំនៀមទម្លាប់ដែលមាននៅតំបន់នោះ ។ តាមធម្មតា ទំនៀមទម្លាប់មិនមែនអាក្រក់ទេ ហើយអ្នកចាស់ទុំប្រហែលជាមានបទពិសោធន៍ច្រើនដែរ ប៉ុន្ដែ ពួកចៀមនឹងទទួលប្រយោជន៍ច្រើនបំផុតពេលដែលអ្នកគង្វាលលើកទឹកចិត្ដបងប្អូនឲ្យស្តាប់តាមសំឡេងរបស់ព្រះយេស៊ូនិងព្រះបន្ទូលនៃព្រះយេ ហូវ៉ា ជាជាងស្តាប់តាមទស្សនៈរបស់មនុស្សឬទំនៀមទម្លាប់ណាមួយ ។ — ទំនុក ដំកើង ១២: ៦; សុភាសិត ៣: ៥, ៦
មូលហេតុមួយគឺដោយព្រោះពួកគាត់បានបង្វឹកបង្វឺនបងប្អូនពីចំណោមពួក« ចៀមឯទៀត »ឲ្យជួយធ្វើការផ្សព្វផ្សាយនិងការបង្រៀនដែរ ។ នៅសព្វថ្ងៃនេះ កិច្ចការផ្សព្វផ្សាយភាគច្រើនបានត្រូវធ្វើដោយក្រុមពួកចៀមឯទៀតដ៏ស្មោះត្រង់ ។
តើក្រុមអ្នកបម្រើកំពុងតែបង្វឹកបង្វឺនបុរសតែងតាំងដោយរបៀបណាខ្លះ ?
ពួកអ្នកចាស់ទុំគ្រីស្ទានបង្វឹកបង្វឺនប្អូនប្រុស ៗក្នុងក្រុម ជំនុំ
ចូរមានចិត្ដស្មោះភក្ដីក្នុងការបម្រើព្រះគ្រី ស្ទជាស្ដេច
តើអ្វីបង្ហាញថាព្រះគ្រី ស្ទមិនបានទទួលអំណាចទាំងស្រុងក្នុងព្រះរាជាណាចក្ររបស់ព្រះនៅឆ្នាំ៣៣ គ.
តើមានអ្នកគ្រប់គ្រងអង្គណាមួយអាចធ្វើពលីខ្លួនដើម្បីរាស្ដ្រទ្រង់ ហើយមានលទ្ធភាពរស់ឡើងវិញនិងគ្រប់គ្រងតទៅទៀតបានទេ ?
តើអាចមានស្ដេចណារស់នៅលើផែនដីមួយរយៈដើម្បីជួយឲ្យរាស្ដ្រមានទំនុកចិត្ដនិងចិត្ដស្មោះភក្ដីចំពោះទ្រង់ ហើយក្រោយមកឡើងទៅសោយរាជ្យនៅស្ថាន សួគ៌ឬទេ ?
មានបុគ្គលតែមួយអង្គគត់ដែលអាចធ្វើដូចនោះហើយធ្វើអ្វី ៗផ្សេងទៀតបាន គឺព្រះយេស៊ូគ្រី ស្ទ ។ ក្រោយព្រះគ្រី ស្ទបានសោយទិវង្គត មានព្រះជន្មរស់ឡើងវិញ ហើយឡើងទៅស្ថាន សួគ៌នោះ ព្រះយេ ហូវ៉ាបាន ‹ ប្រទានឲ្យទ្រង់ធ្វើជាសិរសាលើគ្រប់ទាំងអស់ដល់ពួកជំនុំ › ។ នេះបានកើតឡើងនៅបុណ្យថ្ងៃទី ៥០ ឆ្នាំ៣៣ គ.
។ នៅពេលនោះ ព្រះគ្រី ស្ទចាប់ផ្ដើមមានអំណាចគ្រប់គ្រងខ្លះ ៗ ។ ពួកគ្រីស្ទានដែលបានតែងតាំងដោយវិញ្ញាណរបស់ព្រះ ជារាស្ដ្រដំបូងរបស់ព្រះគ្រី ស្ទដែលរួមគ្នាជាសាសន៍អ៊ីស្រាអែលខាងវិញ្ញាណឬ« សាសន៍អ៊ីស្រាអែលនៃព្រះ » ។ — កាឡាទី ៦: ១៦; កូល៉ុ ស ១: ១៣
សាវ័កយ៉ូហានដែលមានវ័យចាស់បានឃើញចក្ខុ និ មិត្ដពីព្រឹត្ដិការណ៍នាអនាគតកាល ។ គាត់ឃើញព្រះយេ ហូវ៉ាជាព្រះមហាក្សត្រសកលលោកប្រគល់អំណាចឲ្យព្រះគ្រី ស្ទយេស៊ូក្នុងព្រះរាជាណាចក្រថ្មីរបស់ទ្រង់នៅស្ថាន សួគ៌ ។ ពេលពិនិត្យព្រឹត្ដិការណ៍ក្នុងប្រវត្ដិសាស្ដ្រ យើងអាចឃើញទីសំអាងយ៉ាងជាក់ច្បាស់ថា ព្រះគ្រី ស្ទដែលជាព្រះ មេស្ ស៊ីបានចាប់ផ្ដើមសោយរាជ្យជាស្ដេចនៅឆ្នាំ១៩១៤ ។ *
តើយើងអាចបង្ហាញចិត្ដស្មោះភក្ដីបានយ៉ាងណា ចំពោះស្ដេចមួយអង្គដែលសោយរាជ្យពីស្ថាន សួគ៌មក ?
មុនដំបូង យើងសូមពិភាក្សាអំពីមូលហេតុដែលយើងគួរមានចិត្ដស្មោះភក្ដីចំពោះព្រះគ្រី ស្ទ ។
គឺដោយប្រើកម្លាំង !
រីឯព្រះយេស៊ូគ្រី ស្ទវិញ ទ្រង់តែមួយអង្គប៉ុណ្ណោះបានស្ថាបនាព្រះរាជាណាចក្ររបស់ទ្រង់ដោយសេចក្ដីស្រឡាញ់ ហើយមកទល់សព្វថ្ងៃនេះ មនុស្សរាប់លាននាក់ស៊ូស្លាប់ដើម្បីទ្រង់ដែរ » ។
ពេលឡា សារស្លាប់ តើព្រះយេស៊ូមានអារម្មណ៍បែបណា ?
ហេតុអ្វីក៏គួរគប្បីឲ្យយើងមានចិត្ដស្មោះភក្ដីចំពោះព្រះគ្រី ស្ទ ?
ប៉ុន្ដែ តើមានសេចក្ដីតម្រូវអ្វីដើម្បីធ្វើជារាស្ដ្ររបស់ព្រះគ្រី ស្ទ ?
តើមានសេចក្ដីតម្រូវអ្វីដើម្បីធ្វើជារាស្ដ្ររបស់ព្រះគ្រី ស្ទ ?
តើយើងអាចបង្ហាញចិត្ដស្មោះភក្ដីចំពោះព្រះគ្រី ស្ទដោយរបៀបណាខ្លះ ?
តើយើងអាចបង្ហាញចិត្ដស្មោះភក្ដីបានយ៉ាងណា ( ក) ក្នុងរង្វង់គ្រួសារ ?
តើរាស្ដ្ររបស់ព្រះគ្រី ស្ទធ្វើតាមក្រឹត្យវិន័យអ្វីខ្លះ ?
ពេលក្លាយជាប្រជាពលរដ្ឋនៅប្រទេសណាមួយ អ្នកត្រូវធ្វើតាមច្បាប់របស់ប្រទេសនោះ ។ ដូចគ្នាដែរ រាស្ដ្ររបស់ព្រះគ្រី ស្ទក៏ធ្វើតាម« ក្រិត្យវិន័យនៃព្រះគ្រី ស្ទ »ដោយមានរបៀបរស់នៅស្របទៅតាមសេចក្ដីបង្រៀននិងសេចក្ដីបង្គាប់ទាំងឡាយរបស់ព្រះយេស៊ូ ។ ជាពិសេស ពួកគេមានចិត្ដស្មោះភក្ដីដោយរស់ស្របទៅតាម« ក្រិត្យវិន័យដ៏ប្រសើរ »ដែលបង្គាប់ឲ្យបង្ហាញសេចក្ដីស្រឡាញ់ ។ តើក្រឹត្យវិន័យរបស់ព្រះគ្រី ស្ទរួមបញ្ចូលអ្វីខ្លះ ?
តើយើងធ្វើតាម« ក្រិត្យវិន័យនៃព្រះគ្រី ស្ទ »យ៉ាងស្មោះភក្ដីដោយរបៀបណាខ្លះ ?
រាស្ដ្ររបស់ព្រះគ្រី ស្ទមានភាពមិនគ្រប់លក្ខណ៍ហើយក៏ចេះធ្វើខុសដែរ ។ អាស្រ័យហេតុនេះបានជាពួកគេត្រូវខំបណ្ដុះឲ្យមាន ‹ សេចក្ដីស្រឡាញ់ឥតពុតមាយាចំពោះគ្នាជាបងប្អូន › ដើម្បី« ស្រឡាញ់គ្នាទៅវិញទៅមក ...
ការល្បង លចិត្ដស្មោះភក្ដីនៃរាស្ដ្ររបស់ព្រះគ្រី ស្ទ
ហេតុអ្វីការផ្សព្វផ្សាយជាកិច្ចការសំខាន់ម៉្លេះ ?
ហេតុអ្វីក៏មានការល្បង លចិត្ដស្មោះភក្ដីរបស់ពួកគ្រីស្ទាន ?
ពេលចិត្ដស្មោះភក្ដីត្រូវល្បង លនោះ ហេតុអ្វីក៏យើងអាចមានចិត្ដក្លាហានបាន ?
ពេលទទួលទុក្ខបៀតបៀន រាស្ដ្ររបស់ព្រះគ្រី ស្ទត្រូវតែមានចិត្ដក្លាហានដើម្បីរក្សាឲ្យមានចិត្ដស្មោះភក្ដីចំពោះស្ដេចរបស់ពួកគេ ។ យ៉ាងណាក្ដី ព្រះយេស៊ូបានមានបន្ទូលថា៖ « អ្នករាល់គ្នាមានពរក្នុងកាលដែលគេជេរ បៀតបៀន ហើយនិយាយបង្ខុសគ្រប់ទាំងសេចក្ដីអាក្រក់ ពីអ្នករាល់គ្នាដោយព្រោះខ្ញុំ ។ ចូរមានចិត្ដអំណរហើយរីករាយជាខ្លាំងចុះ !
ហេតុអ្វីក៏រាស្ដ្ររបស់ព្រះគ្រី ស្ទរង់ចាំព្រឹត្ដិការណ៍នាអនាគតដោយមានទំនុកចិត្ដ ?
គឺជា នគរដែលបានរៀបចំទុកសំរាប់អ្នករាល់គ្នាតាំងពីកំណើតលោ កីយមក » ។ យ៉ាងនេះ ចូរឲ្យរាស្ដ្រទាំងឡាយនៃព្រះរាជាណាចក្ររបស់ព្រះប្ដេជ្ញាមានចិត្ដស្មោះភក្ដីក្នុងការបម្រើព្រះគ្រី ស្ទដែលជាស្ដេចយើង ។
សូមមើលសៀវភៅចំណេះដែលនាំទៅដល់ជីវិតអស់ កល្បជានិច្ច ទំព័រ៩៥-៩៦ វគ្គ១៤-១៧ បោះពុម្ពដោយស្ម របន្ទាល់ព្រះយេ ហូវ៉ា ។
គុណ សម្បត្ដិឯទៀតដ៏អស្ចារ្យរបស់ព្រះគ្រី ស្ទ
តើគុណ សម្បត្ដិរបស់ព្រះគ្រី ស្ទជំរុញអ្នកឲ្យបម្រើទ្រង់ដោយចិត្ដស្មោះភក្ដីឬទេ ?
យើងបង្ហាញចិត្ដស្មោះភក្ដីពេលធ្វើតាម« ក្រិត្យវិន័យនៃព្រះគ្រី ស្ទ »ដោយបង្ហាញសេចក្ដីស្រឡាញ់ដល់គ្នាទៅវិញទៅមក
តើអ្វីជាគោលបំណងរបស់ព្រះសម្រាប់ផែនដី ?
ហេតុអ្វីបានជាអ្នកចូលចិត្ដដើរលេងកម្សាន្ដនៅទីរមណីយដ្ឋាន ឬដើរកម្សាន្ដតាមវាលស្រែដែលមានផ្កាប្រកបដោយក្លិនពិដោរឈ្ងុយឈ្ងប់ ?
ហេតុអ្វីបានជាអ្នកមានចិត្ដសប្បាយពេលដែលឃើញទន្លេដ៏ល្អប្រណីតឬជួរភ្នំដែលមានកំពូលខ្ពស់កប់ពពក ?
ហេតុអ្វីបានជាអ្នកចំណាយពេលស្តាប់សត្វបក្សាបក្សីយំយ៉ាងពីរោះលើចុងព្រឹក្សា ?
ពេលឃើញសត្វឈ្លូសដែលលោតចុះលោតឡើងយ៉ាងសប្បាយឬហ្វូងចៀមនៅវាលស្មៅខៀវខ្ចី ហេតុអ្វីនេះគួរឲ្យគយគន់ម៉្លេះ ?
មានចម្លើយតែមួយចំពោះសំណួរទាំងនោះ ពោលគឺយើងត្រូវបានបង្កើតមកដើម្បីរស់នៅកន្លែងមួយដែលស្អាតគួរជាទីម នោរម្យ !
ហេតុអ្វីបានជាព្រះយេ ហូវ៉ាបង្កើតផែនដី ?
គ្មានសត្វណាមួយបណ្ដាលឲ្យមានគ្រោះថ្នាក់ដល់មនុស្សជាតិឡើយ ។ មច្ឆាជាតិនិងសត្វដទៃទៀតដែលកម្រើករំពើកនៅក្នុងទឹកស្អាតដ៏ថ្លាឆ្វង់ក៏គួរឲ្យគយគន់ណាស់ដែរ ។ សំខាន់បំផុត អ័ដាមនិងនាងអេ វ៉ារស់នៅជួបជុំគ្នា ។ ពួកគាត់អាចបង្កើតកូននិងពង្រីកកន្លែងស្អាតគួរជាទីម នោរម្យដែលជាលំនៅស្ថានដ៏ល្អអស្ចារ្យ ហើយរួបរួមយ៉ាងសប្បាយជាមួយក្រុមគ្រួសាររបស់ខ្លួនដែលមានគ្នាកាន់តែច្រើនឡើង ៗ ។
ដោយសារព្រះអាទិត្យបានបំភ្លឺនិងផ្ដល់កម្ដៅ និងព្រះច័ន្ទបញ្ចេញពន្លឺដ៏ស្រទន់នៅពេលរាត្រី ។ ( លោកុប្បត្ដិ ១: ១៤-១៨ ) នៅក្នុងដីមានឥន្ធនៈ ធ្យូងថ្ម និងប្រេងដែលយើងអាចដុតកម្ដៅបាន ។ ដោយសារដំណើរទឹកវិលនិងប្រព័ន្ធនៃទន្លេ បឹង និងសមុទ្រ នោះយើងមានទឹក ។ ហើយមានស្មៅពណ៌បៃតងខ្ចីក្រាលលើផែនដីហាក់ដូចជាកម្រាលព្រំ ។
ធម្មតា នៅក្នុងផ្ទះមានកន្លែងសម្រាប់ទុកម្ហូប អាហារ រីឯផែនដីក៏មានកន្លែងដូចជាទូផ្ទុកចំណីអាហារពាសពេញដែរ ។ ព្រះយេ ហូវ៉ា‹ ប្រទាន ឲ្យមានរដូវដ៏សំបូរ ដើម្បីនឹងបំពេញចិត្ដយើងដោយសេចក្ដីអំណរ › ។ ដោយឃើញថាផែនដីជាលំនៅស្ថានដ៏ប្រសើរបែបនេះទៅហើយ សូមគិតទៅមើលនៅពេល ‹ ព្រះប្រកបដោយសុភមង្គល › គឺព្រះយេ ហូវ៉ារៀបចំផែនដីឲ្យទៅជាកន្លែងមួយស្អាតគួរជាទីម នោរម្យ នោះនឹងទៅជាបែបណាវិញ ! — ធី ម៉ូថេ ទី១ ១: ១១, ខ.
គោលបំណងរបស់ព្រះសម្រាប់ផែនដី ជិតនឹងសម្រេចហើយ !
ត្រូវបង្ក្រាបផែនដី ហើយមានអំណាចលើត្រីសមុទ្រ សត្វហើរលើអាកាសនឹងជីវិតផងទាំងឡាយដែលកំរើកនៅផែនដីផង » ។ — លោកុប្បត្ដិ ១: ២៨
ការបង្ក្រាបផែនដីមិនមែនមានន័យថាគ្រាន់តែដាំដុះសាបព្រោះ ឬថែទាំមួយចំណែកតូចនៃផែនដីនោះទេ ។ អ័ដាមនិងនាងអេ វ៉ាព្រមទាំងកូនចៅរបស់ពួកគាត់ត្រូវពង្រីកសួនម នោរម្យឲ្យបានពេញផែនដី ។ ក៏ប៉ុន្ដែ គូស្វាមីភរិយាទីមួយនោះបានធ្វើអំពើបាប ហើយបានត្រូវបណ្ដេញចេញពីសួនច្បារអេ ដែន ។ ( លោកុប្បត្ដិ ៣: ២៣, ២៤ ) តែនេះមិនមានន័យថាផែនដីនឹងលែងត្រូវបង្ក្រាបជារហូតនោះឡើយ ។
ជិតមានពិភពលោកថ្មីហើយ !
គឺជាសង្គមមនុស្សថ្មីដែលជាអ្នកថ្វាយបង្គំព្រះពិត និងមាន« ចិត្ដទៀង ត្រង់ » ។ ( ទំនុក ដំកើង ១២៥ : ៤; យ៉ូហាន ទី១ ២: ១៧) « ផ្ទៃមេឃថ្មី »នឹងរៀបចំច្បាប់ទាំងអស់សម្រាប់« ផែនដីថ្មី » ។ បុរសស្មោះភក្ដីនៅផែនដីនឹងចាត់ចែងឲ្យមនុស្សទាំងអស់ប្រព្រឹត្ដតាមច្បាប់ទាំងនោះ ។
នឹងមានអ្វី ៗថ្មីហើយប្រសើរកន្លង !
អំពីគ្រាដែលប្រកបដោយសន្ដិ ភាពនិងសេចក្ដីសុខ !
សូមស្រមៃគិតពីទឹកចិត្ដដ៏សែនសប្បាយពេលឃើញមនុស្សខ្វាក់ ថ្លង់ ខ្វិន និងគបានជាឡើងវិញ ។
កាលដែលអ្នកស្តាប់បង្គាប់ព្រះក្លាយទៅជាគ្រប់លក្ខណ៍ អ្នកចាស់ជរាក្នុងចំណោមពួកគេនឹងក្លាយទៅជាក្មេងវិញ ។ លែងត្រូវការវ៉ែនតា ឈើច្រត់ មន្ទីរពេទ្យ និងថ្នាំពេទ្យ ។ នេះពិតជាការកែប្រែដ៏អស្ចារ្យណាស់ ពេលដែលយើងនឹងបានទទួលកម្លាំងយុវវ័យឡើងវិញ !
យើងនឹងមានអំណរពេលដែលអ្នកជាទីស្រឡាញ់និងមនុស្សឯទៀតត្រូវប្រោសឲ្យរស់ឡើងវិញ ។ ពិតជាគួរឲ្យរំភើបមែនពេលដែលអ្នកបម្រើស្មោះភក្ដីនៅសម័យបុរាណបានត្រូវប្រោសឲ្យរស់ឡើងវិញ ហើយយើងនឹងទទួលស្វាគមន៍ពួកគាត់ ដូចជាអេ បិល ណូ អេ អ័ ប្រា ហាំ សា រ៉ា យ៉ូប ម៉ូសេ នាង រស់ ដាវីឌ អេ លី យ៉ា នាង អេស ធើរជាដើម !
អ្វីដែលល្អបំផុតគឺយើងអាចថ្វាយបង្គំព្រះពិតតែមួយជារៀងរហូត ។ យើងនឹងមានកិ ត្ដិ យស« គោរពប្រតិ បត្ដិដល់ព្រះយេ ហូវ៉ា ដោយអរសប្បាយ » ហើយធ្វើការជាមួយគ្នាយ៉ាងសស្រាក់សស្រាំក្នុងការសង់លំនៅស្ថានដ៏ល្អប្រណីត ភ្ជួរ រាស់ដី រហូតដល់ទីបំផុតបង្ក្រាបផែនដីទាំងមូលឲ្យទៅជាសួនម នោរម្យ ។ ( ទំនុក ដំកើង ១០០ : ១-៣; អេសាយ ៦៥ : ២១-២៤ ) យើងពិតជានឹងរីករាយមែន !
ពេលរស់ជារៀងរហូតលើផែនដីម នោរម្យដែលផ្ដល់ភោគផលដ៏បរិបូរ មានសន្ដិ ភាព និងជាសួនម នោរម្យដ៏ស្រស់ស្អាត ។ ទាំងអស់នេះជាអ្វីដែលពិតជាផ្ដល់កិ ត្ដិ យសដល់ព្រះនាមដ៏បរិសុទ្ធរបស់ព្រះយេ ហូវ៉ាមែន ! — ទំនុក ដំកើង ១៤៥ : ២១; យ៉ូហាន ១៧: ៣
ការសាកល្បងចុងក្រោយរបស់មនុស្សជាតិ
ដោយសារព្រះយេ ហូវ៉ាប្រទានពរ នោះស្រែចម្ការរបស់អ៊ីស្រាអែលធ្លាប់បង្កើតភោគផលដ៏បរិបូរ
តើស្ថានភាពបែបណា នៃសួនម នោរម្យដែលអ្នករង់ចាំ ?
បើត្រូវជ្រើសរើសចំណងជើងសម្រាប់សៀវភៅមួយក្នុងព្រះគម្ពីរដែលច្រើនតែជាបទចម្រៀងសរសើរព្រះយេ ហូវ៉ាជាអ្នកបង្កើតយើង តើគួរនឹងដាក់ឈ្មោះអ្វី ?
ជួនកាលពាក្យផ្ដើមនោះប្រាប់ឈ្មោះអ្នកតែង ឬមានព័ត៌មានអំពីព្រឹត្ដិការណ៍ដែលទាក់ទងនឹងបទនោះ ដូចក្នុងករណីបទទំនុកទី៣ ។ ពាក្យផ្ដើមក៏ប្រហែលជាពន្យល់អំពីគោលបំណងឬរបៀបប្រើទំនុកនោះ ( ដូចនៅទំនុកទី៤និង៥) ព្រមទាំងមានការណែនាំអំពីបទភ្លេង ( ដូចនៅទំនុកទី៦ ) ។
៤: ៥: ព្រះយេ ហូវ៉ាចាត់ទុកអ្វី ៗដែលយើងថ្វាយខាងវិញ្ញាណជា« គ្រឿងបូជានៃសេចក្ដីសុចរិត »ឲ្យតែយើងថ្វាយរបស់ទាំងនោះដោយបំណងចិត្ដល្អត្រឹមត្រូវ ហើយមានកិរិយាសមស្របនឹងតម្រូវការរបស់ទ្រង់ ។
១៩ : ១-៦: របស់សព្វ សារពើដែលបានបង្កើតមកគ្មានសមត្ថភាពនិយាយឬវែកញែកហេតុផល តែអាចសម្ដែងពីសិរីរុងរឿងរបស់ព្រះយេ ហូវ៉ា ។ បើដូច្នេះ តើមនុស្សយើងដែលចេះគិត ចេះនិយាយនិងចេះថ្វាយបង្គំព្រះគួរសរសើរទ្រង់ប៉ុណ្ណាទៅ ? — វិវរណៈ ៤: ១១
១៩: ១៤: យើងគួរប្រុងប្រយ័ត្ននឹងទង្វើរបស់យើងមែន តែក៏ត្រូវប្រយ័ត្ននឹងពាក្យសម្ដីហើយគំនិតរបស់យើងផងដែរ ។
ក្នុងបទទំនុកពីរដំបូងនៃបទទាំងប៉ុន្មាននេះ ដាវីឌបង្ហាញពីក្ដីប៉ងប្រាថ្នាយ៉ាងខ្លាំងចង់តាំងចិត្ដរក្សាឲ្យមានភាពសុចរិតនិងចិត្ដគ្រប់លក្ខណ៍ !
បទទំនុកទី៤០ : ៧, ៨ ជាទំនាយរៀបរាប់អំពីព្រះយេស៊ូគ្រី ស្ទថា៖ « ទូលបង្គំមកហើយ សេចក្ដីនេះបានកត់ទុកពីទូលបង្គំនៅក្នុងគម្ពីរហើយ គឺថា ឱព្រះនៃទូលបង្គំអើយ !
អាសនៈនេះតំណាងព្រះហឫទ័យរបស់ព្រះយេ ហូវ៉ាក្នុងការព្រមទទួលយកយញ្ញ បូជាលោះរបស់ព្រះយេស៊ូគ្រី ស្ទដែលប្រោសមនុស្សឲ្យរួចពីបាប ។ យើងដើរក្រឡឹងអាសនៈរបស់ព្រះយេ ហូវ៉ាដោយបង្ហាញពីជំនឿរបស់យើងទៅលើយញ្ញ បូជាលោះនោះ ។
បើនិយាយឲ្យចំទៅ ការប្រៀបធៀបនេះមានបំណងបញ្ជាក់អំពីតេជានុភាពដ៏អស្ចារ្យរបស់ព្រះយេ ហូវ៉ា !
៣១: ២៣ — តើព្រះយេ ហូវ៉ាសងដល់មនុស្សឆ្មើង ឆ្មៃជាបរិបូរយ៉ាងដូចម្ដេច ?
ក្នុងទំនុកនេះ ការសងនោះសំដៅទៅលើការដាក់ទោស ។ ពេលដែលមនុស្សសុចរិតភ្លាត់ធ្វើខុស ព្រះយេ ហូវ៉ាសងគាត់ដោយប្រដៅតម្រង់ ។ ដោយសារមនុស្សឆ្មើង ឆ្មៃមិនកែតម្រង់ខ្លួនដោយឈប់ប្រព្រឹត្ដអំពើខុសឆ្គង នោះព្រះយេ ហូវ៉ាសងអ្នកនោះជាបរិបូរដោយដាក់ទោសយ៉ាងធ្ងន់ ។ — សុភាសិត ១១: ៣១; ពេត្រុស ទី១ ៤: ១៨
២៦ : ៤: យកល្អកុំឲ្យយើងមានទំនាក់ទំនងសោះជាមួយពួកមានពុតដែលលាក់អ ត្ដ សញ្ញាណពិតរបស់ខ្លួនដោយឆ្លើយឆ្លងគ្នាតាមប្រព័ន្ធអ៊ីនធឺណិត ( ភាសាអង់គ្លេសហៅថា “chat rooms ”) ។ ក៏កុំឲ្យយើងសេព គប់ជាមួយពួកអ្នកនៅសាលានិងនៅកន្លែងធ្វើការដែលធ្វើដូចជាពួកម៉ាកយើងដើម្បីបោកប្រាសយើង ឬពួកមនុស្សដែលមានមុខពីរ និងអ្នកក្បត់ជំនឿដែលមានលក្ខណៈជាមនុស្សស្មោះត្រង់តែសម្បកក្រៅប៉ុណ្ណោះ ។
២៦: ៧, ១២; ៣៥ : ១៨; ៤០ : ៩: យើងត្រូវសរសើរព្រះយេ ហូវ៉ានៅមុខមនុស្សពេលមានការជួបជុំជាមួយពួកគ្រីស្ទានគ្នីគ្នា ។
២៦ : ៨; ២៧ : ៤: តើយើងស្រឡាញ់និងចូលចិត្ដទៅកិច្ចប្រជុំគ្រីស្ទានដែរឬទេ ?
បានន័យថាព្រះយេ ហូវ៉ាចេះប្រើប្រាស់តេជានុភាពរបស់ទ្រង់យ៉ាងល្អ ។
៣០: ៥: សេចក្ដីស្រឡាញ់ជាគុណ សម្បត្ដិចម្បងបង្អស់របស់ព្រះយេ ហូវ៉ា មិនមែនសេចក្ដីខ្ញាល់ទេ ។
៣៤: ១០: ចំពោះអស់អ្នកដែលទុកកិច្ចបម្រើព្រះជាអាទិភាពក្នុងជីវិត ខនេះពិតជាជួយពង្រឹងទំនុកចិត្ដណាស់ !
៤០ : ១, ២: ការទុកចិត្ដលើព្រះយេ ហូវ៉ាអាចជួយយើងស៊ូទ្រាំពេលធ្លាក់ទឹកចិត្ដ ហើយជួយយើងងើបចេញពី« អន្លង់គួរស្បើម រួចពីភក់ស្អិត » ។
៤០ : ៥, ១២: មិនថាយើងភ្លាត់ធ្វើខុសឬជួបប្រទះសេចក្ដីអាក្រក់ច្រើនក៏ដោយ យើងមិនអស់សង្ឃឹមឡើយ ឲ្យតែយើងចាំថាពរដែលយើងទទួល« នោះមានច្រើនហួសកំណត់នឹងរាប់បាន » ។
បទទំនុកទាំង៤១ក្នុងប៉ែកទីមួយនេះពិតជាលើកទឹកចិត្ដនិងធ្វើឲ្យយើងធូរក្នុងអារម្មណ៍ណាស់ !
មិនថាយើងកំពុងតែជួបប្រទះការលំបាកផ្សេង ៗ ឬមនសិការធ្វើទុក្ខដល់យើងក្ដី យើងអាចមានកម្លាំងចិត្ដឡើងហើយទទួលការលើកទឹកចិត្ដបាន ដោយសារផ្នែកនេះនៃព្រះបន្ទូលរបស់ព្រះដែលពូកែណាស់ !
បទទំនុកទាំងនេះមានព័ត៌មានល្អដែលជួយណែនាំជីវិតយើង ។ បទទាំងនេះបញ្ជាក់ម្ដងហើយម្ដងទៀតថា ព្រះយេ ហូវ៉ាមិនបោះបង់ចោលយើងឡើយ ទោះជាយើងប្រឈមមុខទុក្ខលំបាកណាក៏ដោយ ។
បទទំនុក ដំកើងប៉ែកទីមួយនេះមានពាក្យបញ្ចប់ថា៖ « សូមលើកសរសើរដល់ព្រះយេ ហូវ៉ាជាព្រះនៃសាសន៍អ៊ីស្រាអែល ចាប់តាំងពីអតីតទៅដល់អនាគតអស់ កល្បជានិច្ច ។ អា ម៉ែ នហើយអា ម៉ែ ន » ។ ( ទំនុក ដំកើង ៤១ : ១៣ ) ការពិនិត្យមើលបទទំនុកទាំងប៉ុន្មាននេះ ពិតជាជំរុញយើងឲ្យចង់សរសើរព្រះយេ ហូវ៉ា មែនទេ ?
បទទំនុកទី២មានការសម្រេចដំបូងនៅសម័យដាវីឌ ។
បើរបស់ដែលបានបង្កើតមកអាចសរសើរព្រះយេ ហូវ៉ាទោះជាគ្មានសមត្ថភាពនិយាយឬគិតក្ដីយើងគួរសរសើរទ្រង់ច្រើនជាងទៅទៀត !
ដាវីឌបានតែងបទទំនុកភាគច្រើនក្នុងបទទាំង៤១ដំបូង
តើអ្នកដឹងថា បទទំនុក ដំកើងមួយណាពណ៌នាអំពីព្រះយេ ហូវ៉ាជាអ្នកគង្វាលដ៏ឧត្ដមទេ ?
រៀងរាល់ថ្ងៃ ចូរធ្វើអ្វី ៗខាងវិញ្ញាណកុំខានឡើយ !
តើអ្នកប្រុងប្រៀបជាស្រេចដើម្បីរួចរស់ជីវិតទេ ?
ការកសាងទូកធំនោះ មិនជាការងាយស្រួលទេ ។ មនុស្សជាច្រើនប្រហែលជាបានកោតស្ងើចចំពោះកិច្ចការដែលណូ អេនិងក្រុមគ្រួសារគាត់កំពុងតែធ្វើ តែនេះមិនផ្ដល់ហេតុគ្រប់គ្រាន់ទេ ឲ្យគេជឿថាត្រូវចូលទៅក្នុងទូកធំដើម្បីទទួលសេចក្ដីសង្គ្រោះ ។ នៅទីបំផុត ព្រះយេ ហូវ៉ាលែងមានព្រះទ័យអត់ធ្មត់ទៀតចំពោះរបបលោកិយដ៏អាក្រក់នោះ ។ — លោកុប្បត្ដិ ៦: ៣; ពេត្រុស ទី១ ៣: ២០
ស្ថានភាពសព្វថ្ងៃដូចសម័យលោកណូ អេ
ជាពិសេសតាំងពីឆ្នាំ១៩១៩ មានសារព្រមានមួយបានផ្សាយដល់មនុស្សនៅគ្រប់ទាំងសាសន៍ ដូចសារដែលណូ អេបានផ្សាយនោះដែរ ។ បើនិយាយជាទូទៅ មនុស្សមានប្រតិកម្មចំពោះសារនេះដូចមនុស្សនៅសម័យណូ អេដែរ ។
មនុស្សនៅសម័យណូ អេមិនទទួលស្គាល់ទេ ថាលោកកំពុងតែធ្វើតាមបង្គាប់របស់ព្រះយេ ហូវ៉ា ហើយទ្រង់ក៏កំពុងតែគាំទ្រគាត់វិញ ។ ដូច្នេះ មនុស្សនៅសម័យនោះមិនចាត់ទុកសារដែលណូ អេផ្សាយដល់គេជារឿងសំខាន់ទេ ហើយក៏មិនបានធ្វើតាមការព្រមាននោះសោះ ។ ចុះយ៉ាងណានៅសព្វថ្ងៃនេះវិញ ?
ជាឧទាហរណ៍ ពួកស្ម របន្ទាល់ព្រះយេ ហូវ៉ានៅប្រទេសរុស្ស៊ីកំពុងកសាងសាល ព្រះរាជាណាចក្រមួយខ្នង ។ បុរសម្នាក់បានឆ្លៀតនិយាយជាមួយអ្នកធ្វើការសំណង់ម្នាក់នៅទីនោះថា៖ « ការដ្ឋានអ្វីចម្លែកម៉្លេះ !
អ្នកមិនមែនជាស្ម របន្ទាល់ព្រះយេ ហូវ៉ាទេឬអី ? »
។ អ្នកធ្វើការសំណង់បានសួរគាត់វិញថា៖ « បើខ្ញុំឆ្លើយថា យើងមិនមែនជាស្ម របន្ទាល់ព្រះយេ ហូវ៉ាទេ តើលោកជឿឬអត់ ? »
តើយើងត្រូវធ្វើអ្វីដើម្បីរួចរស់ជីវិតពីទី បញ្ចប់នៃរបបលោកិយដ៏អាក្រក់នេះ ?
ក្នុងកំលុងគ្រាដែល« លោ កីយពីចាស់បុរាណ »ហៀបនឹងផុតទៅដោយសារទឹកជំនន់នោះ ណូ អេ« ជាអ្នកប្រកាសប្រាប់ពីសេចក្ដីសុចរិត »ដោយចិត្ដស្មោះភក្ដី ។ នៅជាន់ក្រោយបង្អស់នៃរបបលោកិយសម័យនេះ រាស្ដ្ររបស់ព្រះយេ ហូវ៉ាកំពុងតែប្រកាសប្រាប់ពីខ្នាតតម្រាសុចរិតរបស់ព្រះ ហើយផ្សាយដំណឹងល្អអំពីលទ្ធភាពរួចរស់ជីវិតដើម្បីចូលទៅក្នុងពិភពលោកថ្មី ។ ណូ អេនិងក្រុមគ្រួសាររបស់គាត់បានកោតខ្លាចព្រះ ហើយត្រូវបានការពារក្នុងទូកធំនោះ !
ដូចគ្នាដែរ លទ្ធភាពរួចរស់ជីវិតនៅសព្វថ្ងៃនេះតម្រូវឲ្យមនុស្សម្នា ក់ ៗមានជំនឿស្មោះនិងទំនាក់ទំនងទៀងទាត់ជាមួយនឹងអង្គការរបស់ព្រះយេ ហូវ៉ានៅលើផែនដី ដែលជាផ្នែកមួយនៃអង្គការរបស់ទ្រង់ទូទាំងសកលលោក ។
ចាំបាច់ត្រូវមានជំនឿដើម្បីរួចរស់ជីវិត
ហេតុអ្វីក៏ចាំបាច់ត្រូវឲ្យយើងមានជំនឿដើម្បីរួចរស់ជីវិតពីទី បញ្ចប់នៃរបបលោកិយនេះរបស់សាតាំង ?
តើមនុស្សត្រូវធ្វើអ្វីដើម្បីរួចរស់ជីវិតពីការបំផ្លាញចោលរបបលោកិយនេះដែលដេកក្នុងឱវាទឬអំណាចនៃសាតាំង ?
មុនដំបូង មនុស្សត្រូវទទួលស្គាល់ថា គេត្រូវមានអ្វីការពារខ្លួន ។ រួចមក គេត្រូវធ្វើអ្វីដើម្បីទទួលការការពារនោះ ។ បណ្ដា ជននៅសម័យណូ អេមានរបៀបរស់នៅធម្មតាហើយមិនគិតថា គេត្រូវការអ្វីដើម្បីការពារខ្លួនពីមហ ន្ដ រាយដែលជិតដល់ទេ ។ ពួកគេក៏បានខ្វះអ្វីមួយទៀត ពោលគឺខ្វះជំនឿទៅលើព្រះយេ ហូវ៉ា ។
ពីព្រោះព្រះយេ ហូវ៉ាបានបង្គាប់ម៉ូសេថា៖ « ត្រូវយកឈាម ប្រឡាក់នៅក្របទ្វារទាំងសងខាង ហើយលើធ្នឹម ទ្វាររបស់ផ្ទះដែលគេបរិភោគផង ។ ...
តើយើងគួរសួរខ្លួនឯងនូវសំណួរអ្វី ?
នេះហើយផ្ដល់ហេតុឲ្យយើងចង់គិតវែងឆ្ងាយអំពីស្ថានភាពក្នុងជីវិតរបស់យើងផ្ទាល់ ។ តើយើងពិតជាស្ថិតនៅក្នុងការរៀបចំរបស់ព្រះយេ ហូវ៉ាដើម្បីការពារយើងខាងវិញ្ញាណឬទេ ?
ការកែសម្រួលជាបណ្ដើរ ៗជួយយើងប្រុងប្រៀបខ្លួន
តើភាពបរិសុទ្ធនៃក្រុម ជំនុំគ្រីស្ទានបានត្រូវរក្សាដោយរបៀបពីរយ៉ាងណាខ្លះ ?
បុគ្គលណាដែលចង់រួមចំណែកក្នុងក្រុម ជំនុំគ្រីស្ទាន ត្រូវតែបំពេញតាមតម្រូវការខ្លះ ៗ ។ គឺសមហេតុសមផលមែន !
តើរាស្ដ្ររបស់ព្រះយេ ហូវ៉ាមានស្ថានភាពបែបណាខាងវិញ្ញាណ ?
ពួកអ្នកបំរើអញនឹងបានស៊ី តែឯងរាល់គ្នានឹងត្រូវឃ្លាន ។ មើល !
ពួកអ្នកបំរើអញនឹងបានផឹក តែឯងរាល់គ្នានឹងត្រូវស្រេក ។ មើល !
ពួកអ្នកបំរើអញនឹងអរសប្បាយ តែឯងរាល់គ្នានឹងត្រូវខ្មាស ។ មើល !
ពួកអ្នកបំរើអញនឹងច្រៀងដោយមានចិត្ដអំណរ តែឯងរាល់គ្នានឹងស្រែកឡើងដោយមានចិត្ដព្រួយ ហើយនឹងទ្រហោយំដោយមានវិញ្ញាណគ្រាំគ្រាវិញ » ។ ( អេសាយ ៦៥ : ១៣, ១៤) ព្រះយេ ហូវ៉ារមែងប្រទានអាហារល្អខាងវិញ្ញាណជាបរិបូរ ហើយទ្រង់ប្រទានអាហារនោះតាមត្រូវពេលដើម្បីឲ្យយើងមានកម្លាំងខាងវិញ្ញាណជានិច្ច ។ — ម៉ាថា យ ២៤ : ៤៥
តើអ្វីនឹងជួយឲ្យយើងត្រៀមលក្ខណៈដើម្បីរួចរស់ជីវិត ?
ហេតុអ្វីក៏អ្នកបានតាំងចិត្ដឲ្យមានភាពជិតស្និទ្ធនឹងក្រុម ជំនុំគ្រីស្ទាន ?
មនុស្សនៅសម័យណូ អេមិនចាត់ទុកសាររបស់គាត់ជារឿងសំខាន់ទេ
គប្បីឲ្យយើងចាត់ទុកការព្រមានពីព្រះយេ ហូវ៉ាជារឿងសំខាន់
តើសាលាកិច្ចបម្រើព្រះរាជាណាចក្រមានគោលដៅអ្វី ?
ពេលឥឡូវនេះ ចូរមានភាពជិតស្និទ្ធជាមួយនឹងក្រុម ជំនុំគ្រីស្ទាន
អំណរដែលមកពីការដើរដោយទៀង ត្រង់
ហេតុអ្វីក៏យើងគួរប្រុងប្រយ័ត្នកុំឲ្យគិតច្រើនពេកអំពីពេលអនាគត ?
តែចុះយ៉ាងណាបើយើងគិតច្រើនពេកអំពីស្ថានភាពល្អ ៗនៅពេលអនាគតដល់ម៉្លេះបានជាលែងទទួលស្គាល់ពរដែលយើងមានខាងវិញ្ញាណពេលឥឡូវនេះ ?
គួរឲ្យស្តាយណាស់បើធ្វើដូច្នេះ !
តើយើងនឹងប្រមូលអារម្មណ៍ទៅលើអ្វីក្នុងអត្ថបទនេះ ?
ឥឡូវ សូមយើងពិភាក្សាអំពីលក្ខណៈផ្សេង ៗនៃភាពចម្រុងចម្រើនខាងវិញ្ញាណរបស់យើង ហើយគិតពិចារណាថា តើយើងមានទស្សនៈយ៉ាងណាចំពោះពរទាំងនេះ ?
ការឆ្លៀតឱកាសរំពឹងគិតអំពីពរដែលព្រះយេ ហូវ៉ាប្រសិទ្ធឲ្យ ‹ មនុស្សសុចរិតដែលដើរតាមផ្លូវទៀង ត្រង់របស់ខ្លួន › ប្រាកដជាជួយយើងឲ្យតាំងចិត្ដកាន់តែរឹងមាំថា យើងនឹងបម្រើព្រះវរ បិតារបស់យើងនៅស្ថាន សួគ៌ដោយអំណរជាដរាប ។ — សុភាសិត ២០: ៧
ក្នុងចំណោមសេចក្ដីបង្រៀនទាំងឡាយក្នុងព្រះគម្ពីរ តើអ្នកចូលចិត្ដមួយណាជាងគេ ?
អ្នកទាំងនោះលះបង់ការប្រព្រឹត្ដទាំងនោះចោល !
ការបោះបង់ទម្លាប់មិនល្អជាការពិបាកណាស់សម្រាប់មនុស្សជាច្រើន ។ យ៉ាងណាក៏ដោយ រៀងរាល់ឆ្នាំមនុស្សរាប់ម៉ឺននាក់កំពុងតែធ្វើដូច្នេះមែន ។ ពួកគេឧទ្ទិសថ្វាយខ្លួនដល់ព្រះយេ ហូវ៉ានិងធ្វើបុណ្យជ្រមុជទឹកទុកជាការបង្ហាញដល់មនុស្សដទៃថា ពួកគេលែងធ្វើនូវអំពើដែលព្រះយេ ហូវ៉ាមិនសព្វព្រះហឫទ័យ ។ ទង្វើនោះពិតជាលើកទឹកចិត្ដយើងដែរ !
ដ្បិតនេះក៏ជួយរំលឹកយើងឲ្យប្ដេជ្ញាចិត្ដជាស្រេចកុំឲ្យប្រព្រឹត្ដអំពើដែលបង្ខូចប្រយោជន៍ ។
តើព្រះគម្ពីរមានដំបូន្មានល្អអ្វីខ្លះដែលនាំឲ្យគ្រួសារមានសុភមង្គល ?
សូមអានសៀវភៅអេភេសូរ ៥: ២២–៦: ៤ និងកត់សម្គាល់ដំបូន្មានដ៏ល្អដែលព្រះបន្ទូលរបស់ព្រះជូនចំពោះស្វាមីភរិយានិងបុត្រធីតា ។ ការអនុវត្ដតាមបទគម្ពីរនេះនិងបទគម្ពីរឯទៀតពិតជាពង្រឹងចំណងអាពាហ៍ ពិពាហ៍ ព្រមទាំងជួយមាតាបិតាឲ្យចេះប្រៀន ប្រដៅកូនយ៉ាងល្អនិងនាំឲ្យមានសុភមង្គលគ្រួសារជាមិនខាន ។ នេះពិតជាពរម្យ៉ាងដែលគួរនាំឲ្យមានអំណរមែនទេ ?
តើទស្សនៈរបស់យើងចំពោះពេលអនាគតនិងទស្សនៈរបស់លោកិយនេះមានលក្ខណៈខុសគ្នាយ៉ាងណា ?
រីឯយើង យើងមានអារម្មណ៍ធូរចិត្ដវិញ ដោយដឹងថាព្រះយេ ហូវ៉ាបានរៀបចំអ្វីមួយដែលមានលទ្ធភាពដោះស្រាយបញ្ហាទាំងឡាយរបស់មនុស្សជាតិ ពោលគឺព្រះរាជាណាចក្ររបស់ព្រះក្រោមអំណាចនៃព្រះ មេស្ ស៊ី !
សូមពន្យល់ ។ ( ខ ) តើអ្វីនាំឲ្យមានសុភមង្គលពិត ?
យើងដឹងពីអ្វីដែលនាំឲ្យមានសុភមង្គលពិត ។ តើអ្វីទៅនាំឲ្យមានសុភមង្គលពិត ?
អ្នកចិត្ដវិជ្ជាម្នាក់មានប្រសាសន៍ថា សុភមង្គលផ្អែកទៅលើកត្ដាបីយ៉ាង គឺការសប្បាយ ជាប់រវល់ធ្វើការ ( រួមបញ្ចូលសកម្មភាពដូចជាការងារឬកិច្ចការគ្រួសារ ) និងភាពស្កប់ចិត្ដ ( ដោយខំប្រឹងសម្រេចគោលដៅឬបំពេញបំណងក្នុងការជួយអ្នកដទៃ ) ។ ក្នុងចំណោមកត្ដាទាំងបីនេះ សាស្ត្រា ចារ្យនោះចាត់ទុកការសប្បាយជាអ្វីដែលមិនសូវសំខាន់ ហើយមានប្រសាសន៍ថា៖ « នេះជាចំណុចគួរឲ្យកត់សម្គាល់មែន ពីព្រោះមនុស្សជាច្រើនចេះតែដេញតាមការសប្បាយ » ។ តើព្រះគម្ពីរចែងយ៉ាងណាអំពីរឿងនេះ ?
ស្ដេចសាឡូម៉ូននៅប្រទេសអ៊ីស្រាអែលសម័យបុរាណមានប្រសាសន៍ថា៖ « យើងបាននិយាយចំពោះចិត្ដយើងថា៖ ‹ មកចុះ !
។ ( សាស្តា ២: ១, ២) ដូច្នេះ ព្រះគម្ពីរបញ្ជាក់ថា សុភមង្គលណាដែលមកពីការសប្បាយប៉ុណ្ណោះ នោះមានតែបណ្ដោះអាសន្នទេ ។ ចុះយ៉ាងណាចំពោះការងារដែលយើងធ្វើ ?
ពេលមានទុក្ខព្រួយលំបាក តើយើងអាចទទួលជំនួយភ្លាម ៗដោយរបៀបណា ?
កុំឲ្យយើងភ្លេចសោះ នូវប្រយោជន៍ជាច្រើនដែលយើងទទួលពីចំណងមេត្រីភាពទាំងនេះ ។
តើការរំពឹងគិតពីពរដែលព្រះយេ ហូវ៉ាប្រទានឲ្យ គួរមានអានុភាពយ៉ាងណាមកលើយើង ?
ព្រះយេស៊ូគ្រី ស្ទមានបន្ទូលអំពីព្រះវរ បិតារបស់ទ្រង់នៅស្ថាន សួគ៌ថា៖ « ទ្រង់ធ្វើឲ្យថ្ងៃរបស់ទ្រង់រះឡើងបំភ្លឺទាំងមនុស្សអាក្រក់នឹងមនុស្សល្អ ហើយទ្រង់បង្អុរឲ្យភ្លៀងធ្លាក់មកលើទាំងមនុស្សសុចរិតនឹងមនុស្សទុច្ចរិតផង » ។ ប្រសិនបើព្រះយេ ហូវ៉ាប្រទានពរលើមនុស្សទុច្ចរិតនិងមនុស្សអាក្រក់ផង ទ្រង់ពិតជាប្រសិទ្ធ ពរកាន់តែច្រើនថែមទៀតលើពួកអ្នកដែលដើរដោយទៀង ត្រង់ !
ទ្រង់នឹងមិនសំចៃទុករបស់ល្អអ្វីដល់ពួកអ្នកដែលដើរដោយទៀង ត្រង់ឡើយ » ។ ពេលយើងរំពឹងគិតអំពីរបៀបដែលព្រះយេ ហូវ៉ាថ្នាក់ថ្នមនិងបង្ហាញព្រះទ័យទុកដាក់ចំពោះពួកអ្នកដែលស្រឡាញ់ទ្រង់ នោះយើងក៏មានចិត្ដកតញ្ញូនិងអំណរ អរកាន់តែច្រើនផងដែរ !
តើអស់អ្នកដែលដើរដោយទៀង ត្រង់អាចទទួលពរអ្វីខ្លះ ?
ការមានភាពចម្រុងចម្រើនខាងវិញ្ញាណតម្រូវឲ្យយើងចូលទៅជិតព្រះយេ ហូវ៉ា ។ ពេលដែលយើងបង្កើតឲ្យមានចំណងមេត្រីភាពជិតស្និទ្ធជាមួយទ្រង់ យើងកំពុងតែ« ប្រមូលទ្រព្យសម្បត្ដិទុកជាគោលយ៉ាងល្អសំរាប់ខ្លួនដល់ថ្ងៃក្រោយវិញ ដើម្បីឲ្យ ...
បានត្រូវបោះបង់ពេលមានវ័យចាស់
រឿងនេះប្រហែលជាមិនធម្មតាមែន តែគួរឲ្យសោកស្តាយណាស់ដើមហេតុ នៃរឿងរ៉ាវបែបនេះកើតមានឡើងជារឿយ ៗ ដ្បិត ការធ្វើបាបមនុស្សវ័យចាស់កើតមានស្ទើរតែពាសពេញផែនដីទៅហើយ ។ សូមពិចារណាឧទាហរណ៍ដូចតទៅនេះ :
ទស្សនាវដ្ដីនោះបញ្ជាក់មូលហេតុមួយថា៖ « បើប្រៀបធៀបជាមួយក្មេងឬស្វាមីឬភរិយាដែលត្រូវធ្វើបាប ការធ្វើបាបមនុស្សវ័យចាស់មិនងាយដឹងបាន ដោយហេតុមួយថា មនុស្សវ័យចាស់គិតថាមកពីរូបគាត់បានជាកូនចៅធ្វើបាប ហើយក៏ដោយសាររដ្ឋាភិបាលនិងអ្នកចាត់ចែងកិច្ចការរដ្ឋបាលតាមតំបន់មិនទាន់បានដោះស្រាយបញ្ហានោះឲ្យមានលទ្ធផលជាដុំកំភួន » ។
ឧទាហរណ៍មួយចំនួននេះស្ដីអំពីការដែលកើតឡើងនៅជុំវិញពិភពលោកបណ្ដាលឲ្យយើងសួរសំណួរថា ហេតុអ្វីបានជាមនុស្សវ័យចាស់ច្រើនម៉្លេះបានត្រូវធ្វើបាបហើយបោះបង់ ?
តើមានសេចក្ដីសង្ឃឹមអ្វីដែលនឹងជួយឲ្យស្ថានភាពនេះបានល្អប្រសើរឡើង ?
តើអ្វីអាចជួយសម្រាលទុក្ខអ្នកដែលមានវ័យចាស់ ?
ព្រះទ្រង់យកព្រះទ័យទុកដាក់ចំពោះមនុស្សវ័យចាស់
សព្វថ្ងៃនេះមិនចម្លែកទេ ដែលការធ្វើបាបមនុស្សវ័យចាស់មានច្រើនគ្រប់ទីកន្លែង ។ តាំងពីសម័យបុរាណ ព្រះគម្ពីរបានទាយទុកជាមុនថា៖ នៅ« ជាន់ក្រោយបង្អស់ »នៃរបបលោកិយនេះដែលឥតកោតខ្លាចព្រះ មនុស្សនឹង« ស្រឡាញ់តែខ្លួនឯង ...
មិនស្រឡាញ់តាមធម្មតាមនុស្ស » ។ ភាសាក្រិចពាក្យ« ស្រឡាញ់តាមធម្មតាមនុស្ស »នេះអាចរួមបញ្ចូលសេចក្ដីស្រឡាញ់ដែលធម្មតាមានរវាងមាតាបិតានិងបុត្រធីតា ។ ដូចព្រះគម្ពីរបានទាយ សព្វថ្ងៃសេចក្ដីស្រឡាញ់បែបនេះមិនមានទេ ។
ដូច្នេះហើយ គ្រាន់តែមិនធ្វើបាបមនុស្សវ័យចាស់ប៉ុណ្ណោះ មិនគ្រប់គ្រាន់ទេ តែយើងគួរបង្ហាញការយកចិត្ដទុកដាក់ដ៏ស្មោះ ដោយធ្វើកិច្ចការដែលជាប្រយោជន៍ដល់ពួកគាត់វិញ ។ ( សូមមើលប្រអប់« ការប្រព្រឹត្ដិដែលបង្ហាញពីសេចក្ដីស្រឡាញ់ »នៅទំព័រ៦) យ៉ាកុបបានសរសេរថា៖ « សេចក្ដីជំនឿ បើគ្មានការប្រព្រឹត្ដតាម នោះឈ្មោះថាស្លាប់ហើយ » ។ — យ៉ា កុប ២: ២៦
មនុស្សបែបនេះអាចទទួលការលើកទឹកចិត្ដដោយដឹងថា ទោះបីជាព្រះយេ ហូវ៉ាទ្រង់គ្រប់ល័ក្ខណ៍ក៏ដោយ តែទ្រង់មិនតម្រូវឲ្យយើងគ្រប់លក្ខណ៍នោះទេ ។ ទោះបីទ្រង់ជ្រាបពីកំហុសរបស់យើងក៏ពិតមែន ព្រះគម្ពីរបានចែងអំពីទ្រង់ថា៖ « បើសិនជាទ្រង់កត់ចំណាំអស់ទាំងអំពើទុច្ចរិត នោះ ឱព្រះអម្ចាស់អើយ !
តើអ្នកណានឹងធន់នៅបាន ? »
។ ( ទំនុក ដំកើង ១៣០ : ៣) ពិតមែនហើយ ព្រះយេ ហូវ៉ាទ្រង់មិនខំរកមើលកំហុសយើងទេ តែទ្រង់រកយល់ពីអ្វីដែលមាននៅក្នុងចិត្ដវិញ ។ តើតាមរបៀបណាដែលយើងអាចដឹងបាន ?
ស្ដេចដាវីឌ អង្គទ្រង់ផ្ទាល់បានប្រព្រឹត្ដអំពើបាបនិងមានភាពឥតគ្រប់ល័ក្ខណ៍ តែព្រះទ្រង់បានបណ្ដាលឲ្យដាវីឌនិពន្ធពាក្យដូចខាងក្រោមនេះ ដែលបានកត់ទុកនៅទំនុក ដំកើង ១៣៩ : ១-៣ « ឱព្រះយេ ហូវ៉ាអើយ !
ព្រះវរ បិតាសួគ៌ាដែលប្រកបដោយសេចក្ដីមេ ត្ដា ក រុណារបស់យើង ទ្រង់នឹងនឹកចាំហើយរក្សាទុកនូវកិច្ចការល្អរបស់យើងរហូត ដរាបណាយើងនៅតែស្មោះត្រង់ចំពោះទ្រង់នោះ ។ ប្រាកដមែន ព្រះគម្ពីរចែងថាព្រះទ្រង់ចាត់ទុកជាការរ មិល គុណ បើទ្រង់នឹងភ្លេចការដែលយើងធ្វើនិងសេចក្ដីស្រឡាញ់ ដែលយើងបានសម្ដែងដល់ព្រះនាមទ្រង់ ។ — ហេព្រើរ ៦: ១០
ព្រះគម្ពីរបង្ហាញថា ព្រះមិនមានគោលបំណងឲ្យមនុស្សជាតិឆ្លងកាត់ជរាភាពនិងការលំបាក ។ ភាពចាស់ជរានិងទ្រុឌទ្រោមបានក្លាយទៅជាផ្នែកមួយនៃជីវិតរបស់មនុស្សជាតិ បន្ទាប់ពីបុរសនិងស្រីទីមួយដែលជាឪពុកម្ដាយដើមរបស់យើង បានបះបោរប្រឆាំងនឹងព្រះជាអ្នកបង្កើត ។ ( លោកុប្បត្ដិ ៣: ១៧-១៩; រ៉ូម ៥: ១២) នេះនឹងមិនបន្ដជារៀងរហូតឡើយ ។
ពិតថា ពួកមេម៉ាយខ្លះមិនមែនជាមនុស្សវ័យចាស់ទេ ។ ការពិតព្រះទ្រង់ក៏យកព្រះទ័យទុកដាក់ដល់ពួកមេម៉ាយវ័យក្មេងដែរ ដូចបានចែងជាក់ស្ដែងនៅលេវី វិន័យ ២២: ១៣ ។
មិនមែនឈ្មោះពិតប្រាកដ ។
ក៏ប៉ុន្ដែ តើធ្វើដូចម្ដេចបើបងប្រុសឬបងស្រីវ័យចាស់ណាម្នាក់ មានសេចក្ដីត្រូវការជាបន្ទាន់ ដូចជាខ្វះលុយកាក់ជាដើម ?
យកល្អជាដំបូងគួររកមើលក្រែង លោមានបុត្រធីតាឬសាច់ញាតិផ្សេងទៀតរបស់គាត់ដែលអាចជួយពួកគាត់បាន ។ ធ្វើបែបនេះគឺសមស្របនិងអ្វីដែលបានចែងនៅធី ម៉ូថេ ទី១ ៥: ៤ « តែបើស្រីមេម៉ាយណាមានកូនចៅ នោះត្រូវឲ្យកូនចៅនោះរៀនឲ្យចេះគោរពប្រតិ បត្ដិ ដល់ពួកផ្ទះខ្លួនជាដើម ទាំងសងគុណឪពុកម្ដាយ ដ្បិតព្រះទ្រង់សព្វព្រះហឫទ័យយ៉ាងដូច្នោះ » ។
ដើម្បីបានព័ត៌មានបន្ថែម សូមអញ្ជើញអានអត្ថបទក្រោមចំណងជើង« ការមើលថែរក្សាមនុស្សចាស់ ជាភារកិច្ចរបស់ជនគ្រីស្ទាន » សៀវភៅប៉ម យាមថ្ងៃទី១ ខែសីហា ឆ្នាំ២០០៤ ។
ប៉ែកទី ពីរក្នុងប៉ែកទាំងប្រាំនៃសៀវភៅទំនុក ដំកើង អាចជួយឲ្យយើងស៊ូទ្រាំបាន ។ ទំនុកទី៤២ដល់៧២ឲ្យដឹងថា យើងត្រូវទុកចិត្ដព្រះយេ ហូវ៉ាទាំងស្រុង ហើយរៀនឲ្យចេះអត់ធ្មត់រង់ចាំឲ្យទ្រង់សង្គ្រោះយើង ទើបយើងអាចស៊ូទ្រាំនឹងទុក្ខលំបាកបាន ។ នេះជាមេរៀនសំខាន់ណាស់ !
សូម្បីតែសព្វថ្ងៃនេះក៏ដោយ ព័ត៌មានក្នុងទំនុក ដំកើងប៉ែកទី ពីរក៏ដូចជាបទគម្ពីរឯទៀតក្នុងព្រះគម្ពីរដែរ ដ្បិតនោះ« រស់នៅ ហើយពូកែផង » ។ — ហេព្រើរ ៤: ១២
បុរសម្នាក់ពីកុលសម្ព័ន្ធលេ វីជាឈ្លើយសឹកនៅស្រុកឆ្ងាយមួយ ។ គាត់ស្រណោះស្រណោកព្រះវិហាររបស់ព្រះយេ ហូវ៉ា ជាកន្លែងដែលគាត់ធ្លាប់ទៅថ្វាយបង្គំ ហើយពោលពាក្យលួងលោមចិត្ដខ្លួនឯងឲ្យបំបាត់ទុក្ខព្រួយ ។ គាត់ពោលថា៖ « ឱព្រលឹងអញអើយ ! ហេតុអ្វីបានជាត្រូវបង្អោនចុះ ហើយមានសេចក្ដីរ សាប់រសល់នៅក្នុងខ្លួនដូច្នេះ ?
អ្នកតែងទំនុកនេះប្រហែលជាសំដៅទៅលើសមរភូមិ ដោយសារនៅទីនោះខ្មោចទាហានទៅជាចំណីរបស់ឆ្កែព្រៃ ។
បុត្រីនេះរបស់ព្រះយេ ហូវ៉ាដែលជា « ស្ដេចនៃអស់ទាំងកល្ប » ។ បុត្រីនេះតំណាងក្រុមអ្នកចាក់ប្រេងតាំង១៤៤.០០០នាក់ពេលទទួលសិរីរុងរឿងនៅស្ថាន សួគ៌ ។ ព្រះយេ ហូវ៉ាទទួលពួកគាត់ជាបុត្រទ្រង់ដោយ តែងតាំងពួកគាត់ដោយវិញ្ញាណ ។ « បុត្រី »នេះរបស់ព្រះយេ ហូវ៉ា ដែលត្រូវ« តាក់តែងដូចជាប្រពន្ធថ្មោងថ្មីតែងខ្លួនទទួលប្ដី » នឹងត្រូវនាំទៅឯប្ដី គឺជាស្ដេចដែលជាព្រះ មេស្ ស៊ី ។ — វិវរណៈ ២១: ២
ពួកគេតំណាង« មនុស្ស១ហ្វូងយ៉ាងធំ »ជាអ្នកថ្វាយបង្គំពិត ដែលរួបរួមជាមួយនិងជួយពួកអ្នកចាក់ប្រេងតាំងដែលនៅសល់ ។ ដោយសារពួកគេរួចរស់ជីវិត« ចេញពីគ្រាវេទនាយ៉ាងធំមក » នោះពួកគេនឹងនៅលើផែនដីពេលដែលអាពាហ៍ ពិពាហ៍របស់ស្ដេចដែលជាព្រះ មេស្ ស៊ីកើតឡើងនៅស្ថាន សួគ៌ ។ នៅគ្រានោះ ពួកគេនឹង« មានសេចក្ដីរីករាយសប្បាយ » ។
នៅពេលព្រះយេស៊ូប្រសូតនៅផែនដី ទ្រង់មានឪពុកឬបុព្វបុរសជាមនុស្ស ។ ពួកគេនឹងទៅជាព្រះរាជ បុត្រារបស់ទ្រង់ ពេលដែលទ្រង់ប្រោសឲ្យពួកគេរស់ឡើងវិញក្នុងកំលុងការសោយរាជ្យមួយពាន់ឆ្នាំរបស់ទ្រង់ ។ ពួកគេខ្លះនឹងរួមចំណែកជាមួយអ្នកដែលត្រូវតែងតាំងជា« ចៅហ្វាយនៅគ្រប់លើផែនដី » ។
៥០ : ២ — ហេតុអ្វីបានជាខនេះរៀបរាប់ថាទីក្រុងយេ រូ សា ឡិម« មានលំអដ៏គ្រប់លក្ខណ៍ » ?
៤៦ : ១-៣: មិនថាយើងជួបនឹងទុក្ខលំបាកអ្វីក៏ដោយ យើងត្រូវមានទំនុកចិត្ដទាំងស្រុងថា ព្រះ« ជាទីពឹងជ្រក ក៏ជាកំឡាំង »របស់យើង ។
ភាពស្និទ្ធស្នាលជាមួយព្រះដែលសង្គ្រោះយើង គួរជំរុញឲ្យ« ច្រៀងពីកិ ត្ដិ យសនៃព្រះនាមទ្រង់ » ។ ( ទំនុក ដំកើង ៦៦ : ២) នៅទំនុកទី៦៥ ព្រះយេ ហូវ៉ាបានត្រូវសរសើរជាព្រះដែលទំនុកបម្រុងយើងដោយព្រះទ័យទូលាយ ។ នៅទំនុកទី៦៧និង៦៨ទ្រង់បានត្រូវសរសើរជាព្រះដែលជួយសង្គ្រោះ ហើយនៅទំនុកទី៧០និង៧១ ទ្រង់ជាអ្នកប្រោសឲ្យរួច ។
ពាក្យល្ងង់ខ្លៅក្នុងខនេះមិនសំដៅទៅលើអ្នកអវិជ្ជាឡើយ តែសំដៅទៅលើអ្នកដែលគ្មានសីលធម៌វិញ ។ យើងយល់ដូច្នេះដោយទំនុក ដំកើង ៥៣ : ១-៤ ដែលបញ្ជាក់ថាពួកគេប្រព្រឹត្ដដោយអសីលធម៌នោះ ។
ពួកគេជាបុរសដែលបានត្រូវចាប់ជាឈ្លើយសឹកក្នុងកំលុងការដណ្ដើមយកស្រុកសន្យា ។ ក្រោយមក បុរសទាំងនេះបានត្រូវតម្រូវឲ្យជួយពួកកុលសម្ព័ន្ធលេ វីក្នុងកិច្ចការរបស់ពួកគេ ។ — អែស រ៉ា ៨: ២០
ដាវីឌបានប្រដូចសត្រូវរបស់រាស្ដ្រព្រះយេ ហូវ៉ាទៅនឹងសត្វ ហើយបានសុំទ្រង់បន្ទោសឬឃាត់កុំឲ្យពួកគេធ្វើទុក្ខរាស្ដ្រទ្រង់ ។
សាច់ដុំនៅចង្កេះគឺចាំបាច់សម្រាប់ធ្វើការធ្ងន់ដូចជាការលីសែង ។ ចង្កេះដែលញ័រនាំឲ្យយល់ន័យថាបុគ្គលនោះបាត់បង់កម្លាំង ។ ដាវីឌបានអធិស្ឋានសុំឲ្យសត្រូវរបស់គាត់បាត់បង់កម្លាំងទៅ ។
៥១ : ១-៤, ១៧: បាបរបស់យើងមិនចាំបាច់ជាហេតុផ្ដាច់ចំណងមិត្ដ ភាពរបស់យើងជាមួយព្រះយេ ហូវ៉ាឡើយ ។ ប្រសិនបើយើងប្រែចិត្ដ យើងអាចជឿជាក់ថា ទ្រង់នឹងបង្ហាញសេចក្ដីមេ ត្ដា ក រុណា ។
៥១ : ១៨: បាបរបស់ដាវីឌមានផលប៉ះពាល់អាក្រក់ដល់សាសន៍អ៊ីស្រាអែលទាំងមូល ។ ដូច្នេះគាត់បានអធិស្ឋានសុំទ្រង់សម្ដែងព្រះហឫទ័យល្អចំពោះស៊ីយ៉ូន ។ នៅពេលដែលយើងធ្វើអំពើបាបធ្ងន់ នោះច្រើនតែនាំឲ្យមានការដៀលត្មិះដល់ក្រុម ជំនុំនិងព្រះនាមព្រះយេ ហូវ៉ា ។ យើងត្រូវអធិស្ឋានសុំព្រះដោះស្រាយបញ្ហាដែលយើងបានបង្កឡើង ។
៦៣ : ៣: ‹ សេចក្ដីសប្បុរសនៃព្រះ នោះវិសេសជាងជីវិត › ពីព្រោះបើគ្មានសេចក្ដីសប្បុរសពីទ្រង់នោះ ជីវិតយើងគ្មានន័យឬគោលបំណងឡើយ ។ យកល្អយើងបណ្ដុះឲ្យមានមិត្ដ ភាពជាមួយនឹងព្រះយេ ហូវ៉ា ។
៧១ : ៥, ១៧: ដាវីឌបានបណ្ដុះឲ្យមានចិត្ដក្លាហាននិងកម្លាំងចិត្ដរឹងមាំដោយយកព្រះយេ ហូវ៉ាជាទីទុកចិត្ដពេលនៅក្មេង សូម្បីតែមុនបានត យុទ្ធជាមួយកូ លី យ៉ាតក៏ដោយ ។ ( សាំ យូអែល ទី១ ១៧: ៣៤-៣៧ ) យុវជនយុវនារីគប្បីរៀនឲ្យចេះពឹងផ្អែកលើព្រះយេ ហូវ៉ាក្នុងគ្រប់រឿងទាំងអស់ ។
ដូចជាសន្ដិ ភាពដ៏បរិបូរ លែងមានការជិះ ជាន់និងអំពើហិង្សា និងស្រូវជាបរិបូរដែរ !
តើយើងនឹងនៅក្នុងចំណោមអ្នកដែលទទួលពរទាំងនេះនិងពរឯទៀតពីព្រះរាជាណាចក្រព្រះទេ ?
យើងអាចនៅក្នុងចំណោមពួកគេមែន ប្រសិនបើយើងប្រព្រឹត្ដដូចអ្នកតែងទំនុក ដំកើង ហើយព្រមរង់ចាំព្រះយេ ហូវ៉ា ដោយយកទ្រង់ជាទីពឹងជ្រកនិងកម្លាំងរបស់យើង ។
តើអ្នកដឹងថា« បុត្រីនៃស្ដេច »តំណាងអ្នកណាទេ ?
ទីក្រុងយេ រូ សា ឡិមត្រូវហៅថា ក្រុងដែល« មានលំអដ៏គ្រប់លក្ខណ៍ » ។ តើអ្នកដឹងមូលហេតុអ្វីទេ ?
ព្រះយេ ហូវ៉ា« រមែងសំដែងប្រាប់ពីការដែលត្រូវមកខាងចុងបំផុត »
ហេតុអ្វីព្រឹត្ដិការណ៍ទាក់ទងនឹងការវាយលុកទីក្រុងបា ប៊ី ឡូនគឺអស្ចារ្យម៉្លេះ ?
តើយើងនឹងពិនិត្យមើលចម្លើយចំពោះសំណួរអ្វីខ្លះ ?
តើព្រះយេ ហូវ៉ាជ្រាបអំពីព្រឹត្ដិការណ៍នាអនាគតកាលច្រើនប៉ុណ្ណា ?
តើទ្រង់ជ្រាបពីគ្រប់អ្វី ៗដែលយើងនឹងធ្វើឬទេ ?
បើដូច្នេះ តើនេះមានន័យថាព្រះយេ ហូវ៉ាកំណត់វាសនាអនាគតឲ្យមនុស្សយើងឬ ?
ក្នុងអត្ថបទនេះនិងអត្ថបទជាបន្ទាប់យើងនឹងពិនិត្យមើលចម្លើយក្នុងព្រះគម្ពីរចំពោះសំណួរទាំងនេះ និងសំណួរឯទៀតដែរ ។
ព្រះយេ ហូវ៉ាជាព្រះមួយអង្គដែលចេះទាយទុកជាមុន
ពេលមនុស្សដឹងទុកជាមុនអំពីអ្វីដែលព្រះយេ ហូវ៉ានឹងធ្វើ តើពួកគេមានភារកិច្ចអ្វី ?
តើមានអ្នកណាដែលមិនព្រមខ្លាច ? »
តើមានអ្នកណានឹងទប់មិនទាយបានឬ ? »
ក្នុងករណីទាក់ទងការដណ្ដើមយកទីក្រុងបា ប៊ី ឡូន តើព្រះយេ ហូវ៉ាបានសម្រេចតាម« គំនិត »របស់ទ្រង់យ៉ាងដូចម្ដេច ?
ហេតុអ្វីក៏យើងមានទំនុកចិត្ដថា « ពាក្យ »របស់ព្រះយេ ហូវ៉ាតែងតែសម្រេច ?
ជិតបួនរយឆ្នាំមុនលោកស៊ីរូសទន្ទ្រានចូលទីក្រុងបា ប៊ី ឡូននោះ ពលទ័ពរបស់សាសន៍អាំ ម៉ូននិងសាសន៍ម៉ូ អាប់បានមូលកម្លាំងគ្នា ហើយគំរាមកំហែងដល់ស្ដេចយ៉ូ សា ផា តនៅស្រុកយូដា ។ ស្ដេចយ៉ូ សា ផា តបានអធិស្ឋានដោយមានទំនុកចិត្ដថា៖ « ឱព្រះយេ ហូវ៉ា ជាព្រះនៃពួកឰ យុកោយើងខ្ញុំរាល់គ្នាអើយ !
តើទ្រង់មិនគ្រប់គ្រងលើអស់ទាំងនគររបស់សាសន៍ដទៃទេឬអី ?
ហើយនៅព្រះហស្ដទ្រង់ នោះក៏មានព្រះចេស្តានឹងឥទ្ធិ ឫទ្ធិដែរ ដល់ម៉្លេះបានជាគ្មានអ្នកណាអាចនឹងទប់ទល់នឹងទ្រង់បានឡើយ » ។ ( របាក្សត្រ ទី២ ២០: ៦) អេសាយក៏បានបង្ហាញទំនុកចិត្ដដូចគ្នាដែរ ពេលមានប្រសាសន៍ថា៖ « ព្រះយេ ហូវ៉ានៃពួកពល បរិវា រ ទ្រង់បានសំរេចនឹងធ្វើហើយ តើអ្នកណានឹងរំលប់រំលាងបាន ?
តាំងពីដំបូងមក តើព្រះយេ ហូវ៉ាបានកំណត់ទុកជាមុនឲ្យអ័ដាមនិងអេ វ៉ាធ្វើអំពើបាបឬទេ ?
សាវ័កពេត្រុសបានរៀបរាប់អំពីមុខនាទីដែលព្រះយេស៊ូមានក្នុងបំណងព្រះហឫទ័យរបស់ព្រះយេ ហូវ៉ា ដោយសរសេរថា ព្រះយេ ហូវ៉ា« ស្គាល់ តាំងពីមុនកំណើតលោ កីយមក តែទើបនឹងលេចមកនៅជាន់ក្រោយបង្អស់នេះដើម្បីជាប្រយោជន៍ដល់អ្នករាល់គ្នា » ។ តាំងពីដំបូងមក តើព្រះយេ ហូវ៉ាបានកំណត់ទុកជាមុនឲ្យអ័ដាមនិងអេ វ៉ានឹងធ្វើអំពើបាបដែលតម្រូវឲ្យព្រះយេស៊ូគ្រី ស្ទថ្វាយជីវិតទ្រង់ជាយញ្ញ បូជាលោះឬទេ ?
ដ្បិតក្នុងបទគម្ពីរពាក្យថា« កំណើត »លោកិយ មកពីភាសាក្រិចដែលមានន័យចំ ៗថា « ព្រោះពូជ » ។ តើមានការ« ព្រោះពូជ »ឬការបង្កើតកូនមុនអ័ដាមនិងអេ វ៉ាធ្វើបាបឬទេ ?
តើព្រះយេ ហូវ៉ាតម្រូវទុកជាមុនឲ្យមានព្រឹត្ដិការណ៍អ្វីទៀត ដើម្បីសម្រេចបំណងព្រះហឫទ័យរបស់ទ្រង់ ?
អ្វីដែលព្រះយេ ហូវ៉ាជ្រាបទុកជាមុន
តើសមត្ថភាពជ្រាបទុកជាមុនរបស់ព្រះយេ ហូវ៉ាតែងតែមានលក្ខណៈសមស្របនឹងអ្វី ?
ដោយសារព្រះយេ ហូវ៉ាជាព្រះមួយអង្គដែលមានគោលបំណងព្រមទាំងទាយទុកជាមុនផង តើទ្រង់ប្រើព្រះត ម្រិះដែលទ្រង់មានទុកជាមុនយ៉ាងដូចម្ដេច ?
សំខាន់ទីមួយ មានការធានាថាគ្រប់ទាំងផ្លូវប្រព្រឹត្ដរបស់ទ្រង់សុទ្ធតែពិតត្រង់ សុចរិតនិងប្រកបទៅដោយសេចក្ដីស្រឡាញ់ ។ ពេលដែលសាវ័កប៉ុលសរសេរសំបុត្រទៅបណ្ដាគ្រីស្ទានសាសន៍ហេព្រើរនៅសតវត្សរ៍ទីមួយគ.
នៅក្នុងសួនច្បារអេ ដែននោះ តើព្រះយេ ហូវ៉ាទុកឲ្យអ័ដាមមានឱកាសជ្រើសរើសអ្វី ?
ពេលដែលព្រះយេ ហូវ៉ាដាក់ច្បាប់មិនអនុញ្ញាតឲ្យអ័ដាមបរិភោគផ្លែពី« ដើមដឹងខុសត្រូវ » ទ្រង់ក៏បានផ្ដល់ការណែនាំគ្រប់គ្រាន់ដើម្បីឲ្យអ័ដាមចេះសម្រេចចិត្ដ ។ ព្រះយេ ហូវ៉ាអនុញ្ញាតឲ្យអ័ដាមបរិភោគផ្លែពីគ្រប់ដើម« ឈើទាំងអស់ក្នុងសួនច្បារ » លើកលែងតែដើមឈើមួយគត់ ហើយទ្រង់ក៏ព្រមានអំពីលទ្ធផលអាក្រក់ដែលមកពីការបរិភោគផ្លែឈើពី ដើមដែលទ្រង់ដាក់បម្រាមលើនោះ ។ ( លោកុប្បត្ដិ ២: ១៦, ១៧) ព្រះយេ ហូវ៉ាបានពន្យល់ដល់អ័ដាមអំពីអ្វីដែលត្រូវកើតឡើងបើគាត់មិនស្តាប់បង្គាប់ ។ តើអ័ដាមសម្រេចចិត្ដធ្វើអ្វី ?
តើយើងដឹងយ៉ាងដូចម្ដេចថា ព្រះយេ ហូវ៉ាអាចជ្រើសរើសនូវអ្វីដែលទ្រង់ចង់ជ្រាបទុកជាមុន ?
ទោះជាព្រះយេ ហូវ៉ាមានសមត្ថភាពជ្រាបអំពីអ្វី ៗទាំងអស់ទុកជាមុនក្ដី តាមមើលទៅទ្រង់បានសម្រេចមិនចង់ជ្រាបទុកជាមុនអំពីអ្វីដែលអ័ដាមនិងអេ វ៉ានឹងធ្វើនោះ ។ ដូច្នេះ រឿងនេះមិនទាក់ទងសំណួរថា តើព្រះយេ ហូវ៉ាមានសមត្ថភាពជ្រាបអំពីអ្វីដែលនឹងកើតឡើងនៅពេលអនាគតឬអត់ ?
តែទាក់ទងសំណួរថា តើទ្រង់មានបំណងព្រះហឫទ័យជ្រាបទុកជាមុនអំពីព្រឹត្ដិការណ៍ទាំងអស់នៅខាងមុខឬយ៉ាងណា ?
ម្យ៉ាងទៀត យើងអាចវែកញែកហេតុផលថា ព្រះយេ ហូវ៉ាជាព្រះមួយអង្គដែលពេញទៅដោយសេចក្ដីស្រឡាញ់ ដូច្នេះទ្រង់ពិតជាមិនកំណត់វាសនាឲ្យមនុស្សដំបូងបះបោរប្រឆាំងនឹងទ្រង់ហើយនាំឲ្យមនុស្សជាតិមានទុក្ខវេទនានោះឡើយ ។ យ៉ាងនេះយើងឃើញថា ព្រះយេ ហូវ៉ាគ្រាន់តែជ្រើសរើសនូវអ្វីដែលទ្រង់ចង់ជ្រាបទុកជាមុនប៉ុណ្ណោះ ។
ពេលព្រះយេ ហូវ៉ាសម្រេចមិនចង់ជ្រាបអំពីអ្វីខ្លះទុកជាមុននោះ តើនេះមានន័យថាទ្រង់ខ្វះអំណាចឬមិនមានគ្រប់លក្ខណៈឬទេ ?
តើយើងនឹងឆ្លើយសំណួរអ្វីខ្លះក្នុងអត្ថបទជាបន្ទាប់ ?
សូមមើលសៀវភៅចំណេះដែលនាំទៅដល់ជីវិតអស់ កល្បជានិច្ច ទំព័រ១៨ វគ្គ១៧ បោះពុម្ពដោយស្ម របន្ទាល់ព្រះយេ ហូវ៉ា ។
ស្ដេចយ៉ូ សា ផា តមានទំនុកចិត្ដលើព្រះយេ ហូវ៉ា
ព្រះយេ ហូវ៉ាបានទាយទុកជាមុនអំពីការសោយទិវង្គតនិងការប្រោសឲ្យព្រះយេស៊ូរស់ឡើងវិញ
តើព្រះយេ ហូវ៉ាកំណត់វាសនា ឲ្យអ័ដាមនិងអេ វ៉ាប្រឆាំងទ្រង់ឬទេ ?
ក្នុងនាមជាកូនចៅរបស់អ័ដាម យើងក៏មានភាពដូចព្រះយេ ហូវ៉ាដែរ ។ ប៉ុន្ដែ តើការប្រព្រឹត្ដរបស់យើងបានត្រូវកំណត់រួចហើយទេ ?
ឬមួយតើយើងពិតជាជ្រើសរើសដោយខ្លួនឯងថាយើងនឹងប្រព្រឹត្ដយ៉ាងណា ?
តើក្រឹត្យទីមួយក្នុងចំណោមក្រឹត្យវិន័យទាំង១០ប្រការចែងយ៉ាងណា ?
ព្រះយេ ហូវ៉ាមានបន្ទូលទៅកាន់ពួកអ៊ីស្រាអែលថា៖ « អញជាព្រះយេ ហូវ៉ា ជាព្រះនៃឯងដែលបាននាំឯងចេញពីផ្ទះបាវបំរើនៅស្រុកអេស៊ីព្ទមក » ។ ( ចោទិយក ថា ៥: ៦) បណ្ដា ជនអ៊ីស្រាអែលមិនសង្ស័យសោះចំពោះការសម្រេចនៃបន្ទូលនោះ ដ្បិតព្រះយេ ហូវ៉ាបានធ្វើដូច្នេះមែន នៅឆ្នាំ១៥១៣ មុន គ.
ដើម្បីឲ្យឯងបានរស់នៅ ព្រមទាំងពូជឯងតរៀងទៅផង » ។ ( ចោទិយក ថា ៣០: ១៩ ) ស្រដៀងគ្នា នៅសព្វថ្ងៃនេះយើងក៏មានឱកាសជ្រើសរើសផងដែរ ។ យើងអាចរើសយកការស្តាប់បង្គាប់ព្រះយេ ហូវ៉ាដោយចិត្ដស្មោះដើម្បីទទួលជីវិតជារៀងរហូត ឬក៏យើងអាចរើសយកការមិនស្តាប់បង្គាប់ទ្រង់ហើយទទួលលទ្ធផលអាក្រក់វិញ ។ សូមពិចារណាមើលគំរូពីរដែលបង្ហាញអំពីការសម្រេចចិត្ដរើសយកផ្លូវខុសស្រឡះពីគ្នា ។
តើយ៉ូស្វេបានរើសយកផ្លូវអ្វី ?
លោកយ៉ូស្វេជាអ្នកដឹកនាំពួកអ៊ីស្រាអែលឲ្យចូលទៅក្នុងស្រុកសន្យា ។ មុនយ៉ូស្វេបានទទួលមរណភាព គាត់បានអង្វរបណ្ដា ជនអ៊ីស្រាអែលទាំងឡាយព្រមទាំងដាស់តឿនពួកគេផងដោយពោលថា៖ « បើសិនជាឯងរាល់គ្នាមិនគាប់ចិត្ដនឹងគោរពប្រតិ បត្ដិដល់ព្រះយេ ហូវ៉ាទេ នោះចូររើសយកព្រះណាដែលឯងចង់គោរពប្រតិ បត្ដិតាមនៅថ្ងៃនេះចុះ !
ការរើសយកអ្វីដែលប្រសើរជាង
តើយើងអាចបង្ហាញសេចក្ដីស្រឡាញ់ចំពោះព្រះយេ ហូវ៉ាយ៉ាងដូចម្ដេច ?
ការស្រឡាញ់ព្រះយេ ហូវ៉ា ។ យើងរើសយកការបម្រើព្រះយេ ហូវ៉ាពីព្រោះយើងស្រឡាញ់ទ្រង់ ។ គំរូពីសម័យពួកអ៊ីស្រាអែលជួយព្រមានយើងឲ្យទប់ទល់នឹងការបង្ខិតបង្ខំដែលទាញចិត្ដយើងឲ្យប្រព្រឹត្ដអំពើអសីលធម៌ ។ គំរូនោះក៏ជួយយើងបដិសេធរបៀបរស់នៅដែលទាក់ចិត្ដឲ្យស្រឡាញ់វត្ថុទ្រព្យដូចមនុស្សជាច្រើនក្នុងលោកិយនេះ ។ យើងតោងជាប់នឹងព្រះយេ ហូវ៉ា ហើយកាន់តាមច្បាប់ទ្រង់ជានិច្ច ។ ( យ៉ូស្វេ ២៣: ៨; ទំនុក ដំកើង ១១៩ : ៥, ៨) មុនពួកអ៊ីស្រាអែលបានចូលទៅក្នុងស្រុកសន្យានោះ ម៉ូសេបានដាស់តឿនពួកគេថា៖ « មើល !
អញបានបង្រៀនច្បាប់ហើយនឹងបញ្ញ ត្ដដល់ឯងរាល់គ្នាតាម ដែលព្រះយេ ហូវ៉ាជាព្រះនៃអញបានបង្គាប់មកដើម្បីឲ្យឯងបានប្រព្រឹត្ដតាមនៅក្នុងស្រុកដែលឯងត្រូវចូលទៅទទួលយក ដូច្នេះចូរឲ្យឯងរាល់គ្នាកាន់ហើយប្រព្រឹត្ដតាមចុះ !
ដ្បិតនេះនឹងបានជាប្រាជ្ញា ហើយជាយោបល់ដល់ឯងរាល់គ្នានៅភ្នែកនៃអស់ទាំងសាសន៍ដែលនឹងឮថ្លែងពីបញ្ញ ត្ដច្បាប់ទាំងប៉ុន្មាននេះ » ។ ( ចោទិយក ថា ៤: ៥, ៦) គឺពេលឥឡូវនេះដែលយើងត្រូវបង្ហាញថាយើងស្រឡាញ់ព្រះយេ ហូវ៉ាដោយចាត់ទុកការធ្វើតាមព្រះហឫទ័យទ្រង់ជាអាទិភាពក្នុងជីវិត ។ បើយើងរើសយកទង្វើនេះ យើងពិតជានឹងទទួលពរមែន ! — ម៉ាថា យ ៦: ៣៣
ពេលគិតពិចារណាអំពីអ្វីដែលបានកើតឡើងនៅសម័យណូ អេ តើយើងទាញយកមេរៀនអ្វី ?
ក៏ប៉ុន្ដែ សូមគិតពីអ្វីដែលណូ អេនិងក្រុមគ្រួសាររបស់គាត់បានរើសយកវិញ ។ មុនដំបូង « ព្រះបានមានបន្ទូលពន្យល់លោកណូ អេពីការដែលមើលមិនទាន់ឃើញនៅឡើយ » ។ ក្រោយមក ‹ សេចក្ដីជំនឿនិងសេចក្ដីកោតខ្លាចបានជំរុញលោកឲ្យធ្វើទូក១យ៉ាងធំ › ។ ជាលទ្ធផល ដោយសារណូ អេធ្វើតាមការព្រមានពីព្រះ នោះក្រុមគ្រួសាររបស់គាត់បានទទួលសេចក្ដីសង្គ្រោះ ។ ចូរឲ្យយើងឆាប់នឹងស្តាប់សាររបស់ព្រះយេ ហូវ៉ាដែរ ព្រមទាំងធ្វើតាមសេចក្ដីបង្គាប់របស់ទ្រង់ចុះ ! — យ៉ា កុប ១: ១៩, ២២-២៥
យោងទៅតាមចោទិយក ថា ៤: ៩ តើម៉ូសេរំលឹកពួកអ៊ីស្រាអែលថា ពួកគេមានភារកិច្ចពីរយ៉ាងអ្វី ?
យើងត្រេកអរណាស់ចំពោះអ្វីដែលបងប្អូនវ័យចាស់បានធ្វើ ហើយកំពុងតែធ្វើនៅឡើយ ។ ការពិចារណាប្រ វត្ដិជីវិតរបស់ពួកគាត់តែងតែលើកទឹកចិត្ដយើង ពីព្រោះពេលយើងឃើញនូវអ្វីដែលព្រះយេ ហូវ៉ាបានធ្វើដើម្បីជួយបងប្អូនដែលមានចិត្ដស្មោះភក្ដីនោះ នេះក៏ជំរុញឲ្យយើងតាំងចិត្ដបម្រើព្រះយេ ហូវ៉ាតទៅទៀតដែរ ។ តើអ្នកគិតពិចារណាជាញឹកញាប់ពីបទពិសោធន៍ដ៏អស្ចារ្យរបស់បងប្អូនវ័យចាស់ឬទេ ?
ចំពោះមាតាបិតាដែលជឿលើព្រះយេស៊ូ តើគាត់អាចប្រើប្រ វត្ដិជីវិតរបស់បងប្អូនដែលមានចិត្ដស្មោះភក្ដីបានយ៉ាងណា ?
ដោយការស្តាប់តាមព្រះបន្ទូលរបស់ព្រះយេ ហូវ៉ា ណូ អេបានសង្គ្រោះក្រុមគ្រួសាររបស់គាត់
បងស្រីមេរី អូ ល សុន
បងស្រីនេនស៊ី ភធើ
តើអ្នកមានសុភមង្គលប៉ុណ្ណា ?
ម្ដង ម្កាលអ្នកប្រហែលជាអាចសួរខ្លួនឯងថា ‹ តើខ្ញុំមានសុភមង្គលប៉ុណ្ណា ? ›
តើពួកគាត់មានសុភមង្គលទេ ?
ដើម្បីលូតលាស់ល្អ រុក្ខជាតិដែលមានផ្កាត្រូវការដីមានជីជាតិ ទឹក ហើយអាកាសធាតុសមស្របផងដែរ ។ ដូចគ្នាដែរ អ្នកស្រាវជ្រាវទទួលស្គាល់ថា មានល័ក្ខខ័ណ្ឌជាក់លាក់មួយចំនួនដែលជួយឲ្យមានសុភមង្គល ។ ល័ក្ខខ័ណ្ឌទាំងនោះរួមបញ្ចូលសុខភាពល្អ ការងារដែលមានប្រយោជន៍ ចំណីអាហារគ្រប់គ្រាន់ ផ្ទះសម្បែង សម្លៀកបំពាក់ មិត្ដល្អ និងសេរីភាពក្នុងការប្រឌិតអ្វីមួយទៅតាមចិត្ដប្រាថ្នាចង់ធ្វើ ។
អ្នកប្រហែលជាយល់ស្របថា ល័ក្ខខ័ណ្ឌទាំងនោះអាចមានឥទ្ធិពលទៅលើសេចក្ដីសង្ឃឹមរបស់ពួកគេដើម្បីមានសុភមង្គល ។ ក៏ប៉ុន្ដែ មានកត្ដាមួយទៀតដែលសំខាន់ជាង គឺជាចំណេះដែលមកពីព្រះយេ ហូវ៉ាជាព្រះដែលប្រកបដោយ« សុភមង្គល » ។ តើចំណេះនោះនឹងជួយយើងតាមរបៀបណា ?
ផ្លូវដែលពិតជានាំទៅសុភមង្គល
ពេលអ្នកជាទីស្រឡាញ់បាត់បង់ជីវិតសូន្យ
តើអាចមានអ្វីល្អខ្លះ ៗដែលគួរនិយាយអំពីសេចក្ដីស្លាប់ទេ ?
ហេតុអ្វីបានជាទ្រង់យកគាត់ពីខ្ញុំ ? »
ច្បាស់ណាស់ គំនិតយល់ច្រឡំអំពីមនុស្សស្លាប់បែបនេះ ជារឿយ ៗមិនបានជួយសម្រាលទុក្ខដល់អស់អ្នកដែលបានព្រាត់ប្រាសគ្នាដោយសារសេចក្ដីស្លាប់នោះទេ ។ ហេតុអ្វី ?
ក្នុងព្រះគម្ពីរនៅសាស្តា ៩: ៥, ១០ ចែងថា៖ « មនុស្សស្លាប់ឥតដឹងអ្វីឡើយ ...
នៅក្នុងស្ថានឃុំព្រលឹងមនុស្សស្លាប់ ជាកន្លែងដែលឯងត្រូវនៅ នោះគ្មានការធ្វើ គ្មានការគិតគូរ គ្មានដំ រិះ ឬប្រាជ្ញាឡើយ » ។ តើស្ថានឃុំព្រលឹងមនុស្សស្លាប់ជាអ្វី ?
សេចក្ដីសង្ឃឹមនាំឲ្យមានសុភមង្គល
តើដំណើររស់ឡើងវិញនឹងកើតឡើងនៅទីណា ?
ម៉ា រី យ៉ានិយាយថា៖ « ពេលមានបញ្ហាខ្ញុំមិនប្រឹងគិតពីបញ្ហានោះច្រើនពេកទេ ។ ខ្ញុំជៀសវាងសួរសំណួរដូចជា ‹ ហេតុអ្វីក៏កើតឡើងចំពោះខ្ញុំ ?
តាមរយៈការសិក្សាព្រះគម្ពីរ អ្នកអាចរកឃើញសុភមង្គលពិតបាន ទោះបីជាអ្នកមានបញ្ហាក៏ដោយ ។ ក៏ប៉ុន្ដែ អ្នកប្រហែលជាឆ្ងល់ថា តើការសិក្សាព្រះគម្ពីរមានប្រយោជន៍ឬទេ ?
ស្ម របន្ទាល់ព្រះយេ ហូវ៉ាមានសេចក្ដីរីករាយនឹងបង្ហាញជូនអ្នកនូវចម្លើយពីបទគម្ពីរដែលអ្នកត្រូវស្គាល់ដើម្បីមានសុភមង្គលពិត ។ ពេលអ្នកទន្ទឹងចាំការសម្រេចនៃសេចក្ដីសង្ឃឹមដែលព្រះយេ ហូវ៉ាផ្ដល់ជូននោះ អ្នកអាចស្ថិតនៅក្នុងចំណោមអស់អ្នកដែលត្រូវរៀបរាប់ដូចតទៅនេះ « គេនឹងបានសេចក្ដីត្រេកអរ នឹងសេចក្ដីរីករាយ ឯអស់ទាំងសេចក្ដីទុក្ខព្រួយ នឹងដំ ងូរទាំងប៉ុន្មាននោះនឹងរត់បាត់ទៅ » ។ — អេសាយ ៣៥ : ១០
មានតែព្រះគម្ពីរទេ ដែលអាចបន្ថយសេចក្ដីទុក្ខសោកបាន
សេចក្ដីសង្ឃឹមនៃដំណើររស់ឡើងវិញ នៅក្នុងព្រះគម្ពីរអាចជួយឲ្យមានសុភមង្គល
ហេតុអ្វីបានជាគាត់មានអារម្មណ៍បែបនោះ ?
ទូលបង្គំស្រឡាញ់ក្រិត្យវិន័យរបស់ទ្រង់ណាស់ហ្ន៎ !
គប្បីឲ្យអ្នកឆ្ងល់ថា « តើក្រឹត្យវិន័យរបស់ព្រះអាចសម្រាលឬរំលែកទុក្ខអ្នកតែងបទទំនុកនេះយ៉ាងដូចម្ដេច ? »
នៅសព្វថ្ងៃនេះ ហេតុអ្វីក៏ពិបាកម៉្លេះឲ្យពួកគ្រីស្ទានរស់ស្របទៅតាមខ្នាតតម្រារបស់ព្រះ?
តើអ្នកតែងបទទំនុកទី១១៩បានធ្វើអ្វីដែលបង្ហាញថាគាត់មានចិត្ដអបអរចំពោះក្រឹត្យវិន័យរបស់ព្រះ?
ឥឡូវយើងសូមពិនិត្យមើលលក្ខណៈបីយ៉ាងនៃក្រឹត្យវិន័យលោកម៉ូសេដែលអាចលើកទឹកចិត្ដយើងបាន គឺការរៀបចំឲ្យមានថ្ងៃឈប់សម្រាក ការទុកឲ្យប្រជាជនរើសសន្សំផលដំណាំ និងច្បាប់ដែលហាមការលោភចង់បាន ។ ពេលពិនិត្យមើលក្រឹត្យវិន័យនី មួយ ៗ យើងនឹងកត់សម្គាល់ថា ជាការចាំបាច់ណាស់ឲ្យយើងមានចិត្ដអបអរចំពោះគោលការណ៍ដែលជាមូលដ្ឋាននៃក្រឹត្យវិន័យទាំងនោះ ដើម្បីយកឈ្នះលើការបង្ខិតបង្ខំដែលមានជាទូទៅនៅសម័យនេះ ។
តើមនុស្សទាំងឡាយមានសេចក្ដីត្រូវការអ្វីខ្លះ ?
នៅសព្វថ្ងៃនេះ ទោះជាព្រះយេ ហូវ៉ាមិនតម្រូវឲ្យរាស្ដ្រទ្រង់ឈប់សម្រាកអស់២៤ម៉ោងដូចនៅសម័យពួកអ៊ីស្រាអែលក្ដី យើងក៏មិនត្រូវចាត់ទុកថាច្បាប់អំពីថ្ងៃឈប់សម្រាកគ្រាន់តែជាវិន័យបុរាណមួយដែលគួរឲ្យចាប់អារម្មណ៍ប៉ុណ្ណោះដែរ ។ ដ្បិតច្បាប់អំពីថ្ងៃឈប់សម្រាកក៏រំលឹកយើងថា អ្វី ៗខាងវិញ្ញាណគួរមានអាទិភាពក្នុងជីវិតយើងដែរ មែនទេ ?
តើការសិក្សាព្រះគម្ពីរ ការអធិស្ឋាន ការចូលរួមកិច្ចប្រជុំគ្រីស្ទាននិងការផ្សព្វផ្សាយដំណឹងល្អអំពីព្រះរាជាណាចក្ររបស់ព្រះមានអាទិភាពឬទេ ?
។ បើយើងតែងតែធ្វើអ្វី ៗខាងវិញ្ញាណជាមុនសិន នោះព្រះយេ ហូវ៉ាធានាថាយើងនឹងមិនខ្វះអ្វីដែលយើងត្រូវការក្នុងជីវិត ។ — ម៉ាថា យ ៦: ២៤-៣៣
តើការកំណត់ពេលសម្រាប់អ្វី ៗខាងវិញ្ញាណអាចនាំឲ្យមានប្រយោជន៍អ្វីខ្លះ ?
។ ពេលដែលយើងទទួលស្គាល់សេចក្ដីកម្សត់របស់ខ្លួនខាងវិញ្ញាណដោយយកចិត្ដទុកដាក់ជាទៀងទាត់ចំពោះអ្វី ៗខាងវិញ្ញាណ នោះយើងក៏នឹងមានអំណរផងដែរ !
ច្បាប់វិន័យរបស់ព្រះអំពីការរើសសន្សំផលដំណាំ
តើការរៀបចំឲ្យជនក្រីក្ររើសសន្សំផលដំណាំហុចឱកាសឲ្យម្ចាស់ស្រែចម្ការធ្វើអ្វី ?
តើច្បាប់វិន័យពីបុរាណដែលបើកឲ្យជនក្រីក្ររើសសន្សំផលដំណាំបង្រៀនអ្វីខ្លះ ?
តើមានបងប្អូនវ័យចាស់ ឈឺឬពិការក្នុងក្រុម ជំនុំដែលយើងអាចទៅលេងដើម្បីលើកទឹកចិត្ដ ឬជួយធ្វើកិច្ចការអ្វីមួយឲ្យគាត់ឬទេ ?
របៀបសំខាន់មួយទៀតដែលបណ្ដាគ្រីស្ទានបង្ហាញចិត្ដគំនិតលះបង់ប្រយោជន៍ខ្លួនឯង គឺដោយចំណាយពេលនិងកម្លាំងរបស់ខ្លួនក្នុងការជម្រាបអ្នកដទៃអំពីគោលបំណងរបស់ព្រះយេ ហូវ៉ា ។ ការជួយបង្រៀនសិស្សរហូតដល់ពេលដែលគេថ្វាយខ្លួនចំពោះព្រះយេ ហូវ៉ា ពិតជានាំឲ្យមានអំណរមែន ។ បងប្អូនដែលធ្លាប់ធ្វើដូច្នេះបានពិសោធនូវស ច្ចភាពនៃបន្ទូលរបស់ព្រះយេស៊ូដែលថា៖ « ឲ្យ នោះបានពរជាជាងទទួល » ។ — កិច្ចការ ២០: ៣៥
ការប្រុងប្រយ័ត្ននឹងចិត្ដលោភចង់បាន
តើក្រឹត្យវិន័យទី១០ហាមអំពីអ្វី ?
តើមនុស្សភាគច្រើនក្នុងលោកិយសព្វថ្ងៃនេះមានចិត្ដគំនិតបែបណា ?
តើទស្សនៈរបស់លោកិយអាចនាំឲ្យមានផលអាក្រក់ណាខ្លះ ?
ក្នុងចំណោមខទាំង១៧៦ក្នុងបទទំនុកទី១១៩ មានខតែ៤ប៉ុណ្ណោះដែលមិនប្រើពាក្យសំដៅទៅលើសេចក្ដីបង្គាប់ ខច្បាប់ ក្រឹត្យវិន័យ សេចក្ដីបញ្ញ ត្ដិ សេចក្ដីបន្ទាល់ ព្រះបន្ទូលឬផ្លូវរបស់ព្រះយេ ហូវ៉ា ។
តើក្រឹត្យវិន័យដែលតម្រូវឲ្យមាន ថ្ងៃឈប់សម្រាក បានលើកបញ្ជាក់អំពីអ្វី ?
តើយើងរៀនអ្វីខ្លះពីក្រឹត្យវិន័យអំពីការរើសសន្សំផលដំណាំ ?
ឥឡូវយើងនឹងផ្ដោតអារម្មណ៍ទៅលើកំណត់ហេតុបីក្នុងព្រះគម្ពីរ ។ កំណត់ហេតុទីមួយគឺអំពីរបៀបដាវីឌប្រព្រឹត្ដចំពោះស្ដេចសូល ។ ទី ពីរគឺអំពីអា ន៉្នា នា សនិងប្រពន្ធគាត់ឈ្មោះសា ភី រ៉ា ហើយទីបីគឺអំពីរបៀបដែលយ៉ូសែបប្រព្រឹត្ដចំពោះប្រពន្ធរបស់ប៉ូ ទី ផារ ។ កំណត់ហេតុនី មួយ ៗនេះបង្កប់មេរៀនដ៏សំខាន់សម្រាប់យើង ។
ភាពស្មោះត្រង់នឹងរបៀបរៀបចំរបស់ព្រះ
ហេតុអ្វីយើងគួរចាប់អារម្មណ៍នឹងកំណត់ហេតុអំពីដាវីឌនិងស្ដេចសូល ?
កំណត់ហេតុនេះបង្កប់មេរៀនដ៏សំខាន់ណាស់ ។ តើអ្នកធ្លាប់ឆ្ងល់ពីមូលហេតុដែលមានបញ្ហាណាមួយកើតឡើងក្នុងក្រុម ជំនុំទេ ?
ដោយសារចង់យកចិត្ដទុកដាក់នឹងបងប្អូនគ្រីស្ទានរបស់អ្នក ហើយដោយសារចង់ស្មោះត្រង់នឹងព្រះយេ ហូវ៉ា នោះប្រហែលជាអ្នកសម្រេចចិត្ដនិយាយជាមួយគាត់ដោយជ្រើសរើសសម្ដីសប្បុរសក្នុងបំណងជួយឲ្យគាត់កែប្រែ ។ ក៏ប៉ុន្ដែចុះបើបញ្ហានោះនៅតែមានបន្ដ ?
ក្រោយអ្នកបានខំអស់ពីសមត្ថភាពហើយ អ្នកអាចទុកឲ្យព្រះយេ ហូវ៉ាដោះស្រាយរឿងនោះចុះ ។ នេះហើយជាអ្វីដែលដាវីឌបានធ្វើ ។
ដោយយកត ម្រាប់តាមដាវីឌ តើយើងគួរប្រព្រឹត្ដយ៉ាងណាប្រសិនបើយើងជួបនឹងអំពើអ យុត្ ដិ ធម៌ឬការរើសអើងសាសនា ?
តើស្ម របន្ទាល់ព្រះយេ ហូវ៉ានៅប្រទេសម៉ូ សំប៊ិចបានប្រព្រឹត្ដតបយ៉ាងណាពេលដែលភាពស្មោះត្រង់របស់ពួកគេចំពោះព្រះយេ ហូវ៉ាត្រូវល្បង ល ?
ក្រោយបុណ្យថ្ងៃទី ៥០ ឆ្នាំ៣៣គ.
យ៉ូសែបបានធំឡើងក្នុងក្រុមគ្រួសារមួយដែលកោតខ្លាចព្រះ ហើយគាត់យល់ថា ការរួមដំណេករវាងមនុស្សដែលមិនមែនជាប្ដីប្រពន្ធគឺខុស ។ គាត់បានសួរថា៖ « ធ្វើដូចម្ដេចឲ្យខ្ញុំប្រព្រឹត្ដការដែលអាក្រក់យ៉ាងធំនេះទៅបាន ?
ចូរធ្វើតាមការក្រើនរំលឹករបស់ព្រះ!
តើយើងទទួលប្រយោជន៍យ៉ាងដូចម្ដេចពីការអាននិងរំពឹងគិតអំពីជីវប្រវត្ដិរបស់បុគ្គលដែលត្រូវរៀបរាប់ក្នុងព្រះគម្ពីរ ?
តើយើងត្រូវយកត ម្រាប់តាមឬជៀសចេញពីលក្ខណៈឬទំនោរចិត្ដអ្វីខ្លះរបស់បុគ្គលក្នុងកំណត់ហេតុនោះ ?
ឈ្មោះបានត្រូវប្ដូរ ។
ហេតុអ្វីដាវីឌមិនព្រមឲ្យសម្លាប់ស្ដេចសូល ?
តើយើងអាចទាញយកមេរៀនអ្វី ពីកំណត់ហេតុអំពីអា ន៉្នា នា សសា ភី រ៉ា ?
ហេតុអ្វីយ៉ូសែបមិនព្រមប្រព្រឹត្ដអំពើអសីលធម៌ ?
ពួកគាត់បានកើតមកជាសមាជិកនៃសាសន៍រើសតាំងរបស់ព្រះ
តើសាសន៍អ៊ីស្រាអែលចាប់ផ្ដើមមានទំនាក់ទំនងពិសេសអ្វីជាមួយនឹងព្រះ?
ហើយតើមានសាសន៍ដ៏ធំណាមួយ ដែលមានច្បាប់ នឹងបញ្ញ ត្ដដ៏ត្រឹមត្រូវ ឲ្យដូចជាក្រិត្យព្រះវិន័យនេះ ដែលអញដាក់នៅមុខឯងរាល់គ្នានៅថ្ងៃនេះដូច្នេះ ? » ។ — ចោទិយក ថា ៤: ៧, ៨
ពួកគាត់កើតជាសមាជិកសាសន៍មួយ ដែលសុទ្ធសឹងជាស្ម របន្ទាល់
តើមានមូលហេតុសំខាន់អ្វីដែលអ៊ីស្រាអែលបានត្រូវរៀបចំឡើងជាសាសន៍មួយ ?
រាប់រយឆ្នាំក្រោយមក ព្រះយេ ហូវ៉ាបានរំលឹកសាសន៍អ៊ីស្រាអែលតាមរយៈព្យាការីអេសាយ អំពីមូលហេតុសំខាន់មួយដែលពួកគេបានត្រូវរៀបចំជាសាសន៍មួយ ។ អេសាយបានមានប្រសាសន៍ថា៖ « ឱពួកយ៉ាកុបអើយ !
ឥឡូវនេះ ព្រះយេ ហូវ៉ាជាព្រះដែលបង្កើតឯងមក ហើយឱពួកអ៊ីស្រាអែលអើយ !
ជាអ្នកដែលអញបានតែងតាំងឡើង › ។ ព្រះយេ ហូវ៉ាទ្រង់មានបន្ទូលថា៖ ‹ ឯងរាល់គ្នាជាស្ម របន្ទាល់របស់អញ ហើយជាអ្នកបំរើដែលអញបានរើសតាំង ...
តើអ៊ីស្រាអែលជាសាសន៍មួយដែលបានត្រូវថ្វាយចំពោះព្រះក្នុងន័យអ្វី ?
ពួកគេអាចជ្រើសរើសដោយខ្លួនឯង
តើជនជាតិអ៊ីស្រាអែលម្នា ក់ ៗអាចធ្វើការសម្រេចចិត្ដដោយខ្លួនឯងអំពីអ្វី ?
ទោះជាជនជាតិអ៊ីស្រាអែលម្នា ក់ ៗកើតមកជាសមាជិកសាសន៍មួយដែលបានត្រូវថ្វាយចំពោះព្រះរួចហើយក៏ពិតមែន តែពួកគេម្នា ក់ ៗត្រូវធ្វើការសម្រេចចិត្ដថា តើនឹងបម្រើឬក៏មិនបម្រើព្រះ?
ដោយសារជនជាតិអ៊ីស្រាអែលម្នា ក់ ៗមានចិត្ដសេរី នោះពួកគេត្រូវទទួលខុសត្រូវចំពោះលទ្ធផលដែលមកពីការសម្រេចចិត្ដរបស់ខ្លួន ។ — ចោទិយក ថា ៣០:១៦-១៨
តើអ្វីកើតឡើងក្រោយជំនាន់យ៉ូស្វេស្លាប់ទៅ ?
ការបំពេញតាមការថ្វាយខ្លួន
ព្រះយេ ហូវ៉ាបានផ្ដល់ឱកាសជាច្រើនឲ្យសាសន៍អ៊ីស្រាអែលបំពេញតាមភារកិច្ចជារាស្ដ្រមួយពួកដែលបានត្រូវថ្វាយចំពោះទ្រង់ ។ ជាឧទាហរណ៍ ក្រឹត្យវិន័យរបស់ទ្រង់បានរៀបចំឲ្យមានតង្វាយផ្សេង ៗ ។ តង្វាយខ្លះចាំបាច់ត្រូវថ្វាយ ។ ចំណែកតង្វាយឯទៀត នោះបានថ្វាយដោយស្ម័គ្រចិត្ដទៅវិញ ។ តង្វាយស្ម័គ្រចិត្ដរួមមានតង្វាយដុត តង្វាយម្សៅ និងតង្វាយមេត្រី ដែលពួកគេថ្វាយចំពោះព្រះយេ ហូវ៉ាដើម្បីអរព្រះគុណទ្រង់ ហើយដើម្បីឲ្យទ្រង់សព្វព្រះហឫទ័យនឹងពួកគេ ។ — លេវី វិន័យ ៧: ១១-១៣
ជនជាតិអ៊ីស្រាអែលគ្រប់រូបជាអ្នកដែលបានត្រូវថ្វាយចំពោះព្រះយេ ហូវ៉ាដោយសារកើតមកក្នុងសាសន៍នោះ ។ ក៏ប៉ុន្ដែ បុគ្គលម្នា ក់ ៗដែលថ្វាយតង្វាយស្ម័គ្រពីចិត្ដ ដើម្បីធ្វើឲ្យការថ្វាយខ្លួនរបស់ពួកគេមានអត្ថន័យជ្រាលជ្រៅថែមទៀត បានទទួលពរជាច្រើនហើយបាន« ទទួលព្រះគុណពីទ្រង់ » ។ — ម៉ាឡាគី ៣: ១០
នៅសម័យអេសាយនិងម៉ាឡាគី តើព្រះយេ ហូវ៉ាបញ្ជាក់ថាទ្រង់មិនសព្វព្រះហឫទ័យយ៉ាងដូចម្ដេច ?
តើសាសន៍អ៊ីស្រាអែលមានឱកាសអ្វី ?
តើព្រះយេស៊ូមានបន្ទូលយ៉ាងណា ដែលបង្ហាញថាព្រះយេ ហូវ៉ាលែងទទួលស្គាល់អ៊ីស្រាអែលជាសាសន៍ដែលបានត្រូវថ្វាយចំពោះទ្រង់នោះ ?
ដូច្នេះ ខ្ញុំប្រាប់អ្នករាល់គ្នាថា នគរព្រះនឹងត្រូវហូតចេញពីអ្នករាល់គ្នា ប្រគល់ទៅឲ្យសាសន៍១ទៀត ដែលគេនឹងបង្កើតផលរបស់នគរនោះ » ។ ដោយបញ្ជាក់ថាព្រះយេ ហូវ៉ាលែងទទួលស្គាល់អ៊ីស្រាអែលជាសាសន៍ដែលថ្វាយចំពោះទ្រង់នោះ ព្រះយេស៊ូមានបន្ទូលថា៖ « ឱយេ រូ សា ឡិម ក្រុងយេ រូ សា ឡិមអើយ !
ឯងដែលសំឡាប់ពួកហោរា ហើយយកថ្មចោលពួកអ្នកដែលបានចាត់មកឯឯង តើប៉ុន្មានដងហើយ ដែលអញចង់ប្រមូលកូនឯងទាំងប៉ុន្មាន ដូចជាមេមាន់ក្រុងកូនវាឲ្យជ្រកក្រោមស្លាប តែឯងមិនព្រមទេ មើល !
សាសន៍ថ្មីមួយដែលបានត្រូវថ្វាយចំពោះព្រះ
តើសាសន៍ថ្មីដែលថ្វាយចំពោះព្រះយេ ហូវ៉ាបានកើតឡើងនៅពេលណា ?
។ ក៏ប៉ុន្ដែ កិច្ចព្រមព្រៀងថ្មីចាប់មានសុពលភាព ពេលដែលវិញ្ញាណបរិសុទ្ធត្រូវចាក់លើសិស្សព្រះយេស៊ូនៅបុណ្យថ្ងៃទី ៥០ ឆ្នាំ៣៣គ.
ព្រះយេ ហូវ៉ាបានឈប់ផ្ដល់ព្រះគុណដល់សាសន៍អ៊ីស្រាអែល ហើយចាប់ផ្ដើមផ្ដល់ទៅលើអ៊ីស្រាអែលខាងវិញ្ញាណវិញ ជាក្រុម ជំនុំគ្រីស្ទាន ដែលជា ‹ សាសន៍១ដែលបង្កើតផល › ព្រះរាជាណាចក្រ ។ — ម៉ាថា យ ២១: ៤៣
តើពេត្រុសបានជំរុញឲ្យអ្នកស្តាប់ទទួលបុណ្យជ្រមុជទឹកបែបណា ?
នៅសម័យប៉ុល តើមនុស្សដែលមានចិត្ដគំនិតត្រឹមត្រូវទាំងសាសន៍យូដានិងសាសន៍ដទៃ បានទៅជាសមាជិកអ៊ីស្រាអែលខាងវិញ្ញាណយ៉ាងដូចម្ដេច ?
សាសន៍អ៊ីស្រាអែលម្នា ក់ ៗត្រូវធ្វើការសម្រេចចិត្ដដោយខ្លួនថាតើនឹងបម្រើឬមិនបម្រើព្រះ?
ការថ្វាយតង្វាយស្ម័គ្រពីចិត្ដផ្ដល់ឱកាសឲ្យសាសន៍អ៊ីស្រាអែលបង្ហាញនូវសេចក្ដីស្រឡាញ់ចំពោះព្រះយេ ហូវ៉ា
អ្នកកាន់តាមព្រះគ្រី ស្ទត្រូវថ្វាយខ្លួនឯងចំពោះព្រះ និងបង្ហាញពីការថ្វាយខ្លួននោះដោយទទួលបុណ្យជ្រមុជទឹក
តើអ្វីអាចជួយឲ្យកូនរបស់មាតាបិតាដែលជាគ្រីស្ទានពិតស្ម័គ្រចិត្ដថ្វាយខ្លួនដល់ព្រះ?
ព្រះគម្ពីរបញ្ជាក់ថា ព្រះចាត់ទុកកូនក្មេងជាស្អាតឬបរិសុទ្ធ ទោះបើមានតែមាតាប៉ុណ្ណោះឬបិតាជាគ្រីស្ទានស្មោះត្រង់ ។ តើនេះមានន័យថាកូនទាំងនេះជាអ្នកបម្រើព្រះយេ ហូវ៉ាដែលបានថ្វាយខ្លួនទេ ?
កាលណាឯងដើរដំណើរ បណ្ដាំនោះនឹងនាំមុខឯង កាលណាដេកលក់ នោះនឹងចាំយាមរក្សាឯង ហើយកាលណាភ្ញាក់ នោះនឹងនិយាយរកឯង ដ្បិតពាក្យបណ្ដាំនោះ ជាចង្កៀង ហើយដំបូន្មាននោះ ជាពន្លឺ ឯសេចក្ដីបន្ទោសនៃពាក្យប្រៀន ប្រដៅ នោះជាផ្លូវជីវិតហើយ » ។ — សុភាសិត ៦: ២០-២៣
ដូច្នេះ ដើម្បីទទួលប្រយោជន៍ពីការអប់រំពីមាតាបិតា ប្អូន ៗត្រូវព្រមទទួលការណែនាំនិងការកែតម្រង់ ។ ប្អូន ៗមិនកើតមកជាអ្នកមានប្រាជ្ញាស្រាប់នោះទេ តែប្អូន ៗអាច« ទៅជាមនុស្សមានប្រាជ្ញា » ហើយស្ម័គ្រចិត្ដដើរតាម« ផ្លូវជីវិត » ។
តើសាវ័កប៉ុលបានផ្ដល់ការណែនាំអ្វីសម្រាប់កូននិងបិតា ?
សាវ័កប៉ុលបានសរសេរថា « ក្មេងរាល់គ្នាអើយ ! ចូរស្តាប់បង្គាប់មាតាបិតាខ្លួនក្នុងព្រះអម្ចាស់ ដ្បិតធ្វើដូច្នោះទើបបានត្រូវ ‹ ចូរគោរពប្រតិ បត្ដិដល់មាតាបិតាខ្លួន › នេះជាបញ្ញ ត្ដមុនដំបូង ដែលជាប់មានទាំងសេចក្ដីសន្យាផង ‹ ដើម្បីឲ្យឯងរាល់គ្នាបានសេចក្ដីសុខ ហើយរស់នៅផែនដីជាយូរអង្វែងទៅ › ។ ឪពុករាល់គ្នាអើយ !
កុំឲ្យចាក់រុកកូនរបស់ខ្លួនឡើយ ចូរបង្រៀនវាទៅតាមដំបូន្មាន នឹងសេចក្ដីដាស់តឿនរបស់ព្រះអម្ចាស់វិញ » ។ — អេភេសូរ ៦: ១-៤
មិនមែនទេ ។ តើអ្នកណាអាចរិះគន់មាតាបិតាដោយសារខំបង្រៀនកូនអ្វី ៗដែលពួកគាត់ចាត់ទុកថាត្រឹមត្រូវនិងជាសីលធម៌ដែលនាំឲ្យទទួលប្រយោជន៍ ?
គ្មានអ្នកណារិះគន់មនុស្សដែលមិនជឿព្រះ ពេលដែលពួកគាត់បង្រៀនកូនថាគ្មានព្រះនោះឡើយ ។ មនុស្សដែលកាន់សាសនាកា តូ លិចឬពុទ្ធសាសនាចាត់ទុកថា ពួកគាត់មានភារកិច្ចអប់រំកូនឲ្យកាន់ជំនឿដូចខ្លួន ហើយកម្រមានអ្នកណារិះគន់ពួកគាត់ដោយសារខំធ្វើយ៉ាងនេះ ។ ស្រដៀងគ្នាដែរ មិនគួរមានអ្នកណាចោទប្រកាន់ស្ម របន្ទាល់ព្រះយេ ហូវ៉ាថា ចង់បង្វិលខួរកូនខ្លួន នៅពេលអប់រំពួកគេឲ្យមានគំនិតដូចព្រះយេ ហូវ៉ាអំពីសេចក្ដីពិតដែលជាមូលដ្ឋាននិងអំពីគោលការណ៍សីលធម៌ ។
ប្រសិនបើមិត្ដ ភក្ដិរបស់កូនកំពុងតែអូសទាញឲ្យប្រើថ្នាំញៀន ផឹកស្រាច្រើន ឬធ្វើអំពើអសីលធម៌នោះ តើគួររិះគន់មាតាបិតាដោយសារពួកគាត់ខំជួយឲ្យកូនកែគំនិត និងជួយឲ្យយល់ពីផលវិបាកដែលមកពីការប្រព្រឹត្ដដ៏គ្រោះថ្នាក់របស់កូនឬទេ ?
តើប្អូនមានអាយុល្មមយល់អ្វីដែលបានរៀននិងចាប់ផ្ដើមមានចំណងមិត្ដ ភាពជាមួយព្រះយេ ហូវ៉ាដោយខ្លួនឯងនោះទេ ?
គឺសមហេតុសមផលដែលព្រះចាត់ទុកថា ប្អូនមានសមត្ថភាពសម្រេចចិត្ដបម្រើទ្រង់ដែរ មែនទេ ?
តើគប្បីឲ្យយុវជនយុវនារីដែលមិនទាន់ទទួលបុណ្យជ្រមុជទឹកសួរខ្លួនឯងនូវសំណួរអ្វីខ្លះ ?
តើអ្នកជាគ្រីស្ទានយុវវ័យម្នាក់មិនទាន់ទទួលបុណ្យជ្រមុជទឹក ហើយបានត្រូវចិញ្ចឹមអប់រំដោយមាតាបិតាដែលថ្វាយបង្គំព្រះយេ ហូវ៉ាឬ ?
តើប្អូនទៅកិច្ចប្រជុំនិងរីកចម្រើនរហូតដល់ចូលរួមកិច្ចផ្សព្វផ្សាយដំណឹងល្អអំពីព្រះរាជាណាចក្រដែរឬទេ ?
បើដូច្នេះ សូមសួរខ្លួនឯងដោយស្មោះថា ‹ ហេតុអ្វីខ្ញុំចូលរួមអ្វី ៗទាំងអស់នោះ ?
តើខ្ញុំទៅប្រជុំនិងផ្សព្វផ្សាយដោយសារមាតាបិតារបស់ខ្ញុំតម្រូវឲ្យខ្ញុំធ្វើឬ ?
ឬដោយសារខ្ញុំចង់ធ្វើឲ្យព្រះយេ ហូវ៉ាសព្វព្រះហឫទ័យវិញ ? ›
តើចាំបាច់ពន្យារពេលទទួលបុណ្យជ្រមុជទឹកទេ ?
តើមានគំរូអ្វីខ្លះក្នុងព្រះគម្ពីរដែលបង្ហាញថាមិនគួរពន្យារពេលទទួលបុណ្យជ្រមុជទឹកយូរពេកនោះ ?
ប្អូនពិតជាមិនគិតដូច្នេះទេ !
ប្អូនក៏មិនគួរស្ទាក់ស្ទើរ មិនទទួលបុណ្យជ្រមុជទឹកប្រសិនបើមានលក្ខណៈគ្រប់គ្រាន់ដែរ ។ បើប្អូនបានថ្វាយខ្លួនចំពោះព្រះយេ ហូវ៉ាហើយសន្យាធ្វើតាមបំណងព្រះហឫទ័យទ្រង់អស់មួយជីវិត នោះនឹងជំរុញចិត្ដប្អូនយ៉ាងខ្លាំងឲ្យព្យាយាមអស់ពីសមត្ថភាពដើម្បីជៀសចេញពីអំពើអាក្រក់ ។ ប្អូន ៗទាំងអស់គ្នាអើយ !
ការថ្វាយខ្លួននិងបុណ្យជ្រមុជទឹកជាទីចាប់ផ្ដើមនៃវិថីជីវិតមួយ ដែលក្នុងនោះយើងគិតពីព្រះយេ ហូវ៉ាក្នុងគ្រប់ការទាំងអស់ ។ ការបំពេញតាមការថ្វាយខ្លួនតម្រូវឲ្យ« លៃយកឱកាស » ។ តើយើងធ្វើនោះយ៉ាងដូចម្ដេច ?
ស្ម របន្ទាល់ព្រះយេ ហូវ៉ាដែលជាយុវវ័យរាប់ពាន់នាក់ កំពុងតែរីករាយ ហើយក៏អាចប្រាប់ប្អូនថា មានរបៀបជាច្រើនដ៏ល្អសម្រាប់សប្បាយដោយមិនធ្វើខុសពី« បំណងព្រះហឫទ័យព្រះ » ។ — អេភេសូរ ៥: ១៧-១៩
តើប្អូន ៗយុវវ័យគួរសួរខ្លួនឯងសំណួរអ្វីខ្លះ ?
តើអ្វីឃាត់មិនឲ្យប្អូនទទួលបុណ្យជ្រមុជទឹកបាន ?
តើប្អូននឹងស្តាប់តាមអ្នកណា ?
តើព្រះរាជាណាចក្ររបស់ព្រះជាអ្វី ?
មានសេចក្ដីវេទនាមួយដ៏ធំបានកើតឡើង មិនយូរប៉ុន្មានបន្ទាប់ពីព្រះបានបង្កើតមនុស្សជាតិ ។ តើជាអ្វីទៅ ?
តើនាងអេ វ៉ាបានជឿតាមសាតាំងទេ ?
តើព្រះយេ ហូវ៉ាដែលជាព្រះមហាក្សត្រសកលលោកបានដោះស្រាយយ៉ាងដូចម្ដេច ?
តើព្រះរាជាណាចក្ររបស់ព្រះមានលក្ខណៈបែបណា ?
ហើយតើខុសគ្នាពីការគ្រប់គ្រងរបស់មនុស្សយ៉ាងដូចម្ដេច ?
តើព្រះរាជាណាចក្ររបស់ព្រះត្រូវចាប់ផ្ដើមគ្រប់គ្រងពីពេលណា ?
អត្ថបទបន្ទាប់នឹងឆ្លើយសំណួរទាំងនេះ ។
តាមរយៈព្រះរាជាណាចក្ររបស់ព្រះ ទ្រង់នឹងលើកព្រះនាមទ្រង់ឲ្យបរិសុទ្ធ ដោយជម្រះអស់ទាំងការតិះដៀលពីព្រះនាមទ្រង់ចេញ ដែលបណ្ដាលមកពីការបះបោរប្រឆាំងរបស់សាតាំងនិងមនុស្សជាតិ ។ នេះសំខាន់ណាស់ !
សុភមង្គលរបស់ទេវតានិងមនុស្សជាតិទាំងអស់អាស្រ័យទៅលើការចាត់ទុកព្រះនាមរបស់ព្រះជាបរិសុទ្ធ និងការស្ម័គ្រចិត្ដទទួលស្គាល់សិទ្ធិគ្រប់គ្រងរបស់ទ្រង់ ។ — វិវរណៈ ៤: ១១
បន្ថែមទៀត ព្រះរាជាណាចក្ររបស់ព្រះត្រូវរៀបចំឡើងដើម្បី« ឲ្យព្រះហឫទ័យ បានសំរេចនៅផែនដីដូចនៅស្ថាន សួគ៌ដែរ » ។ តើអ្វីទៅជាព្រះហឫទ័យរបស់ទ្រង់ ?
ព្រះរាជាណាចក្ររបស់ព្រះមានស្ដេចមួយអង្គដែលមានលក្ខណៈល្អជាងអ្នកដឹកនាំដែលជាមនុស្សជាតិ ។ សូមពិនិត្យមើលតើស្ដេចអង្គនោះជាអ្នកណា ?
តើមាននរណាម្នាក់នៅក្នុងចំណោមមនុស្សជាតិដែលមានគុណ សម្បត្ដិសមជាអ្នកគ្រប់គ្រងស្មើនឹងទ្រង់ទេ ?
កូនចៀមតំណាងព្រះយេស៊ូដែលជាស្ដេចក្នុងព្រះរាជាណាចក្ររបស់ព្រះ ។ ភ្នំស៊ីយ៉ូនសំដៅទៅស្ថាន សួគ៌ ។ * ព្រះយេស៊ូនិងអ្នកចូលរួមគ្រប់គ្រងជាមួយទ្រង់ដែលមានចំនួន១៤៤.០០០នាក់នឹងគ្រប់គ្រងពីស្ថាន សួគ៌មក ។ ពិតជាទីតាំងដ៏ខ្ពង់ខ្ពស់មែនសម្រាប់ការគ្រប់គ្រង !
ព្រះរាជាណាចក្ររបស់ព្រះនៅផែនដីមានអ្នកតំណាងដែលគួរឲ្យទុកចិត្ដ ។ ហេតុអ្វីយើងដឹង ?
ការគ្រប់គ្រងរបស់ព្រះរាជាណាចក្រចាប់ផ្ដើម
ស្ដេចចុងក្រោយដែលបានសោយរាជ្យនៅទីក្រុងយេ រូ សា ឡិមត្រូវបានទូលថា៖ « ចូរដោះក្បាំង ដោះមកុដចេញ ...
ពេលដែលពួកបា ប៊ី ឡូនបំផ្លាញទីក្រុងយេ រូ សា ឡិម ។ ក្នុងកំលុង« គ្រារបស់សាសន៍ដទៃ »ដែលមានបន្ទាប់ពីនោះ ព្រះមិនមានរដ្ឋាភិបាលនៅលើផែនដីដែលតំណាងការគ្រប់គ្រងរបស់ទ្រង់ទេ ។ រហូតដល់ទី បញ្ចប់នៃគ្រាទាំងនោះ ទើបព្រះយេ ហូវ៉ាប្រគល់អំណាចឲ្យដល់អ្នក« ដែលមានច្បាប់ទទួល »គឺជាព្រះយេស៊ូគ្រី ស្ទ ។ តើគ្រារបស់សាសន៍ដទៃនោះមានរយៈពេលប៉ុន្មាន ?
បទទំនាយនៅក្នុងសៀវភៅដានី យ៉ែលបានចែងថា៖ « ចូរកាប់ដើមឈើនេះចុះ !
ទាល់តែបានកន្លងអស់៧ខួបទៅ » ។ ( ដានី យ៉ែល ៤: ២៣) យើងនឹងឃើញថា« ៧ខួប »នោះស្មើនឹងកំលុងពេលនៃ« គ្រារបស់សាសន៍ដទៃ » ។
មែន ។ ក៏ប៉ុន្ដែ មិនឈប់រហូតទេ ។ ដើមឈើត្រូវវ័ណ្ឌរហូតបានកន្លងអស់« ៧ខួប » ។ នៅទី បញ្ចប់នៃរយៈពេលនោះ ព្រះយេ ហូវ៉ានឹងប្រគល់អំណាចគ្រប់គ្រងទៅអ្នកដែលមានសិទ្ធិគ្រប់គ្រង គឺព្រះយេស៊ូគ្រី ស្ទ ។ យើងបានឃើញច្បាស់ថា « ៧ខួប »និង« គ្រារបស់សាសន៍ដទៃ »សំដៅទៅរយៈពេលដូចគ្នា ។
។ គឺនៅឆ្នាំនោះដែល« គ្រារបស់សាសន៍ដទៃ »ឬ៧ខួបបានត្រូវបញ្ចប់ ។ នេះមានន័យថាព្រះយេស៊ូគ្រី ស្ទចាប់ផ្ដើមគ្រប់គ្រងជាស្ដេចក្នុងព្រះរាជាណាចក្ររបស់ព្រះនៅឆ្នាំ១៩១៤ ។
បើព្រះរាជាណាចក្ររបស់ព្រះ មេស្ ស៊ីបានត្រូវស្ថាបនានៅស្ថាន សួគ៌រួចហើយ តើយើងគួរបន្ដអធិស្ឋានឲ្យរាជ្យទ្រង់បានមកដល់ដូចដែលព្រះយេស៊ូបានបង្រៀនក្នុងសេចក្ដីអធិស្ឋានគំរូឬទេ ?
យើងគួរអធិស្ឋានមែន ។ ព្រោះពាក្យសុំនោះគឺសមត្រឹមត្រូវ និងនៅតែមានសារៈសំខាន់ ។ នៅអនាគតឆាប់ ៗ ព្រះរាជាណាចក្ររបស់ព្រះនឹងគ្រប់គ្រងទៅលើផែនដីទាំងមូល ។
និងបានបញ្ចប់នៅឆ្នាំ១៩១៤គ.
រាស្ដ្រនៃព្រះរាជាណាចក្ររបស់ព្រះ នឹងទទួលពរយ៉ាងសន្ធឹក
គោលសំ ខាន់ ៗពីសៀវភៅទំនុក ដំកើង ប៉ែកទីបីនិងទីបួន
អ្នកតែងទំនុកបានអធិស្ឋានទូលសួរព្រះថា៖ « តើនឹងមានគេថ្លែងពីសេចក្ដីសប្បុរសទ្រង់នៅក្នុងផ្នូរ ឬពីសេចក្ដីស្មោះត្រង់របស់ទ្រង់ នៅទីហិន វិនាសដែរឬអី ? »
ទំនុក ដំកើងប៉ែកទីបីនិងទីបួនគឺទំនុកទី៧៣រហូតដល់ទំនុកទី១០៦ ។ ទំនុកទាំងនោះបញ្ជាក់មូលហេតុជាច្រើន ដែលយើងគួរសរសើរព្រះជាអ្នកបង្កើតហើយលើកត ម្កើងព្រះនាមទ្រង់ ។ ការរំពឹងគិតទៅលើទំនុកទាំងនោះគួរធ្វើឲ្យយើងមានការអបអររឹតតែខ្លាំងចំពោះ« ព្រះបន្ទូលនៃព្រះ » ព្រមទាំងគួរលើកទឹកចិត្ដយើងឲ្យសរសើរទ្រង់កាន់តែច្រើនថែមទៀតហើយបង្កើនសមត្ថភាពយើងក្នុងការសរសើរទ្រង់ ។ មុនបង្អស់សូមផ្ដោតអារម្មណ៍លើទំនុក ដំកើងប៉ែកទីបី ។
ទំនុកមួយរបស់កូនចៅលោកកូរេសរសេរថា « ព្រលឹងទូលបង្គំរឭក អើ !
ចម្លើយចំពោះសំណួរអំពីបទគម្ពីរ :
ដោយសារមនុស្សទុច្ចរិតមិនគោរពអ្នកណានៅស្ថាន សួគ៌ឬនៅផែនដីឡើយ នោះពួកគេហ៊ានប្រមាថតិះដៀលព្រះហើយក៏និយាយបង្កាច់បង្ខូចមនុស្សឯទៀត ។
៧៦ : ១០ — តើ« សេចក្ដីឃោរឃៅរបស់មនុស្ស »អាចសរសើរព្រះយេ ហូវ៉ាយ៉ាងដូចម្ដេច ?
នោះក៏អាចនាំឲ្យព្រះយេ ហូវ៉ាទទួលសេចក្ដីសរសើរដែរ ដ្បិតអ្នកដែលឃើញយើងស៊ូទ្រាំយ៉ាងស្មោះត្រង់ ប្រហែលជាក៏នឹងចាប់ផ្ដើមសរសើរព្រះដែរ ។
ឃ្លាទាំងពីរនេះសំដៅទៅលើមនុស្សដែលធ្វើជាចៅក្រមនៅអ៊ីស្រាអែល ។ គឺសមរម្យណាស់ដែលពួកគេត្រូវពណ៌នាហៅថា « ព្រះ »ដូច្នេះ ដ្បិតពួកគេត្រូវបម្រើជាអ្នកនាំពាក្យរបស់ព្រះហើយក៏បានតំណាងទ្រង់ដែរ ។ — យ៉ូហាន ១០:៣៣-៣៦
៧៧ : ៦: ការត្រិះរិះក្នុងចិត្ដអំពីសេចក្ដីពិតពីព្រះ ហើយការស្វះស្វែងរកសេចក្ដីពិតនោះតម្រូវឲ្យយើងចំណាយពេលសិក្សានិងរំពឹងគិត ។ ហេតុនេះហើយ ជាការសំខាន់ណាស់ដែលយើងលៃទុកពេលឲ្យនៅស្ងាត់ម្នាក់ឯង !
៨១: ១៣, ១៦: ការស្តាប់ព្រះសូរសៀងរបស់ព្រះយេ ហូវ៉ានិងការដើរតាមផ្លូវរបស់ទ្រង់នាំឲ្យទទួលពរជាបរិបូរ ។ — សុភាសិត ១០: ២២
៨៤ : ១-៤, ១០-១២: អ្នកតែងទំនុកនោះបានស្រឡាញ់កន្លែងថ្វាយបង្គំព្រះយេ ហូវ៉ា ហើយក៏មានចិត្ដស្កប់ស្កល់នឹងឯក សិទ្ធិដែលគាត់មានក្នុងកិច្ចបម្រើទ្រង់ ។ នោះជាគំរូល្អសម្រាប់យើង ។
៨៦ : ៥: យើងពិតជាមានចិត្ដអំណរដែលព្រះយេ ហូវ៉ា« បំរុងតែនឹងអត់ទោស »ឲ្យយើង !
៨៧ : ៥, ៦: តើអ្នកដែលរស់ក្នុងសួនម នោរម្យនឹងអាចស្គាល់ឈ្មោះរបស់អស់អ្នកដែលបានត្រូវប្រោសឲ្យរស់ឡើងវិញនៅស្ថាន សួគ៌ឬទេ ?
ហើយតើយើងអាច« នៅជាប់ »ទីនោះដោយដូចម្ដេច ?
ដើមលម៉ើត្រូវគេស្គាល់ជាដើមដែលបង្កើតផលច្រើន ។ មនុស្សសុចរិតគឺដូចជាដើមលម៉ើក្នុងន័យថា ព្រះយេ ហូវ៉ាចាត់ទុកពួកគាត់ជាអ្នកទៀង ត្រង់ដែលបង្កើត« ផល ផ្លែល្អ » ។ ផលនោះរួមបញ្ចូលការប្រព្រឹត្ដដ៏ល្អ ។ — ម៉ាថា យ ៧: ១៧-២០
យើងត្រូវ« មានចិត្ដខ្មី ឃ្មាត ឲ្យបានសតិបញ្ញា » ឬត្រូវប្រើប្រាជ្ញារិះរករបៀបចំណាយពេលធ្វើអ្វីដែលធ្វើឲ្យព្រះយេ ហូវ៉ាសព្វព្រះហឫទ័យ ជាជាងបង្ខាតបង់ពេលវេលានោះ ។ នេះតម្រូវឲ្យយើងចាត់ទុកអ្វីខាងវិញ្ញាណជាអាទិភាព ហើយប្រើពេលវេលាតាមរបៀបមានប្រយោជន៍បំផុត ។ — អេភេសូរ ៥: ១៥, ១៦; ភីលីព ១: ១០
៩០ : ១៧: ការអធិស្ឋានសុំព្រះយេ ហូវ៉ា ‹ តាំងការនៃដៃយើង ឲ្យខ្ជាប់ខ្ជួនឡើង › និងប្រទានពរលើការព្យាយាមរបស់យើងក្នុងកិច្ចផ្សព្វផ្សាយគឺជាសំណូមពរសមត្រឹមត្រូវ ។
៩៥: ៧, ៨: បើយើងស្តាប់ឱវាទពីព្រះគម្ពីរ ហើយរហ័សអនុវត្ដ នោះនឹងបង្ការ កុំឲ្យយើងចាប់ផ្ដើមមានចិត្ដរឹងរូស ។ — ហេព្រើរ ៣: ៨, ៩
យើងអាចស៊ូទ្រាំនឹងអំពើអាក្រក់ ដោយ« ចូលទៅជិតព្រះ »ដូចអេ សាភដែរ
ផា រោ៉នបានបរាជ័យនៅសមុទ្រក្រហម
តើអ្នកដឹងមូលហេតុនំ ម៉ា ន៉ាត្រូវហៅថា« នំរបស់ពួកទេវតា »ទេ ?
តើអ្វីជួយបំបាត់« គំនិតសាន់ វ័ណ្ឌក្នុងចិត្ដ »យើង ?
តើសាវ័កប៉ុលបានជូនឱវាទអ្វីដល់បងប្អូនគ្រីស្ទាននៅទីក្រុងភីលីពនិងកូរិន ថូស ?
ប៉ុលដឹងថាការត្អូញត្អែរអាចនាំឲ្យមានបញ្ហា ។ ពីរ បីឆ្នាំមុននោះ គាត់បានរំលឹកបងប្អូននៅទីក្រុងកូរិន ថូសថា ការត្អូញត្អែរអាចបង្កគ្រោះថ្នាក់ ។ ប៉ុលបានលើកចំណុចថា ប្រជាជនអ៊ីស្រាអែលបានធ្វើឲ្យព្រះយេ ហូវ៉ាខ្ញាល់ម្ដងហើយម្ដងទៀតពេលពួកគេនៅទី រហោស្ថាន ។ តើពួកគេធ្វើឲ្យទ្រង់ខ្ញាល់ដោយដូចម្ដេច ?
ពួកជំនុំអាក្រក់រ ទូរទាំទាស់នឹងព្រះយេ ហូវ៉ា
តើជនជាតិអ៊ីស្រាអែលបានត្អូញត្អែរយ៉ាងណានៅទី រហោស្ថាន ?
ដូចបញ្ជាក់នៅជន គណនា ១៤: ១-៣ តើចិត្ដគំនិតរបស់ជនជាតិអ៊ីស្រាអែលបានផ្លាស់ប្ដូរយ៉ាងដូចម្ដេច ?
ការត្អូញត្អែរនៅសតវត្សរ៍ទីមួយ
ឧទាហរណ៍យើងទើបតែបានពិចារណា គឺអំពីក្រុមមនុស្សដែលបានត្អូញត្អែរឮ ៗដើម្បីបញ្ជាក់នូវការមិនស្កប់ចិត្ដ ។ ក៏ប៉ុន្ដែ នៅពេលព្រះយេស៊ូគ្រី ស្ទមានវត្ដ មាននៅទីក្រុងយេ រូ សា ឡិមសម្រាប់បុណ្យបារាំនៅឆ្នាំ៣២គ.
មានការ« ខ្សឹបខ្សៀវពីដំណើរទ្រង់ជាច្រើន » ។ ពួកគេបានខ្សឹបខ្សៀវអំពីទ្រង់ដោយមានខ្លះថា ទ្រង់ជាបុរសល្អ ខ្លះទៀតថាទ្រង់មិនមែនបុរសល្អទេ ។
អ្នកគង្វាលដែលផ្ដល់ជំនួយខាងវិញ្ញាណនេះ ប្រុងប្រយ័ត្នកុំឲ្យខ្លួន« ចុកត្រចៀកមិនស្តាប់ពាក្យអំពាវនាវ របស់មនុស្សទាល់ក្រ » ។ — សុភាសិត ២១: ១៣; ព .
ដូចជាដែកមានលក្ខណៈដែលធ្វើឲ្យកើតមានច្រែះស៊ីបំផ្លាញនោះ មនុស្សឥតគ្រប់លក្ខណ៍មានលក្ខណៈធ្វើឲ្យកើតមានចិត្ដចង់ត្អូញត្អែរ ។ យើងគួរប្រុងប្រយ័ត្នជានិច្ច ដើម្បីឆាប់ទទួលស្គាល់ថាតើយើងចាប់ផ្ដើមមានលក្ខណៈនោះឬទេ ?
ហេតុអ្វីយើងមិនត្រូវបណ្ដោយឲ្យខ្លួនត្អូញត្អែរនោះ ?
ទោះបើយើងមានហេតុត្រឹមត្រូវក្នុងការត្អូញត្អែរ ហេតុអ្វីយើងត្រូវព្យាយាមមានទស្សនៈដូចព្រះយេ ហូវ៉ា ?
ហេតុមួយ ប្រហែលជាទ្រង់ចង់ជួយឲ្យយើងបណ្ដុះនូវគុណ សម្បត្ដិដូចជាចិត្ដអត់ធ្មត់ ចេះស៊ូទ្រាំ ជំនឿ និងចេះអត់ ធន់ ។ — យ៉ា កុប ១: ២-៤
មិនត្រឹមតែប៉ុណ្ណោះ គាត់សន្យាថា លើកក្រោយពេលស្ម របន្ទាល់ព្រះយេ ហូវ៉ាមកផ្សព្វផ្សាយនៅផ្ទះគាត់ គាត់នឹងអញ្ជើញពួកគេចូល ហើយនឹងស្តាប់ដោយយកចិត្ដទុកដាក់ ។ ស្ម របន្ទាល់ដែលជាភ្ញៀវនោះបានមានឥទ្ធិពលល្អណាស់លើគាត់ !
ដោយសារតែបាន« ធ្វើគ្រប់ការទាំងអស់ ដោយឥតត្អូញត្អែរ » ។
ការអត់ឱនទោសធ្វើឲ្យមានសាមគ្គីភាព
ហេតុអ្វីយើងគួរអត់ឱនទោសគ្នា ?
ចុះបើយើងមានមូលហេតុត្អូញត្អែរអំពីអ្នកជឿគ្នីគ្នាម្នាក់ ?
ព្រះយេ ហូវ៉ាមានហេតុត្អូញត្អែរអំពីយើងដែរ មែនទេ ?
តើការត្អូញត្អែរប្រហែលមានឥទ្ធិពលយ៉ាងណាលើអ្នកដែលស្តាប់ ?
បើយើងគ្រហឹម នោះប្រហែលជាធ្វើឲ្យអ្នកឯទៀតកត់សម្គាល់យើង ប៉ុន្ដែច្បាស់ជាមិនធ្វើឲ្យពួកគេចង់នៅជាមួយយើងទេ ។
តើអត្ថបទបន្ទាប់នឹងពន្យល់រឿងអ្វី ?
បើយើងអបអរនឹងពរទាំងឡាយដែលយើងទទួលជាអ្នកថ្វាយបង្គំព្រះយេ ហូវ៉ាជាព្រះពិត នោះនឹងជួយឲ្យយើងមានសាមគ្គីភាពនិងជៀសចេញពីការត្អូញត្អែរអំពីអ្នកជឿគ្នីគ្នា ។ អត្ថបទបន្ទាប់នឹងពន្យល់របៀបគុណ សម្បត្ដិដែលព្រះបង្រៀនឲ្យយើងមាន នឹងជួយឲ្យជៀសចេញពីការត្អូញត្អែរមួយយ៉ាងដែលមានគ្រោះថ្នាក់ជាងនេះទៅទៀត ពោលគឺការត្អូញត្អែរទាស់នឹងអង្គការព្រះយេ ហូវ៉ាផ្នែកផែនដី ។
ជនជាតិអ៊ីស្រាអែលបានត្អូញត្អែរទាស់នឹងព្រះយេ ហូវ៉ា !
តើអ្នកព្យាយាមឲ្យមានទស្សនៈដូចព្រះយេ ហូវ៉ាទេ ?
ការអត់ឱនទោសធ្វើឲ្យមានសាមគ្គីភាពក្នុងក្រុម ជំនុំគ្រីស្ទានពិត
ចូរផ្ដោតអារម្មណ៍លើសេចក្ដីល្អដែលទទួលពីអង្គការរបស់ព្រះយេ ហូវ៉ា
សូមពិចារណាពីសេចក្ដីល្អខ្លះ ៗ ។
យើងមានហេតុជាច្រើន ឲ្យដឹងគុណ‹ អ្នកបំរើស្មោះត្រង់ដែលមានវិនិច្ឆ័យល្អ › ដែលព្រះយេស៊ូគ្រី ស្ទបានតែងតាំងឲ្យត្រួតលើទ្រព្យទ្រង់នៅផែនដី ។ ក្រុមអ្នកបម្រើនោះដែលជាគ្រីស្ទានតែងតាំងដោយវិញ្ញាណ នាំមុខក្នុងការផ្សាយដំណឹងល្អ ហើយក៏រៀបចំកិច្ចប្រជុំសម្រាប់ថ្វាយបង្គំ ថែមទាំងបោះពុម្ពព័ត៌មានផ្សេង ៗអំពីព្រះគម្ពីរជាង៤០០ភាសា ។ មនុស្សរាប់លាននាក់ទូទាំងផែនដីមានចិត្ដកតញ្ញូដោយសារទទួល‹ អាហារបរិភោគ ›ខាងវិញ្ញាណ« តាមត្រូវពេល » ។ ច្បាស់ជាគ្មានហេតុឲ្យយើងត្អូញត្អែរអំពីរឿងនោះឡើយ ។
ដែលយើងអាចចូលរួមជាសមាជិកហ្វូងនោះ ហើយរីករាយនឹងសេចក្ដីស្រឡាញ់និងសាមគ្គីភាពដែលមានក្នុងចំណោម« បងប្អូន »ទូទាំងពិភពលោក ។ — ពេត្រុស ទី១ ២: ១៧; ៥: ២, ៣
បងស្រីគើ ទ្រូ តបានបម្រើព្រះយេ ហូវ៉ាយូរហើយ ។ ពេលគាត់ជាយុវនារី បងស្រីធ្លាប់ត្រូវគេចោទប្រកាន់ដោយមិនពិតថា គាត់គ្រាន់តែធ្វើពុតជាអ្នកផ្សព្វផ្សាយពេញពេល ។ តើបងស្រីធ្វើដូចម្ដេច ?
តើគាត់ត្អូញត្អែរអំពីរបៀបពួកគេប្រព្រឹត្ដមកលើគាត់ទេ ?
មិនត្អូញត្អែរទេ ។ មិនយូរមុនពេលដែលគាត់ស្លាប់នៅឆ្នាំ២០០៣ ក្នុងអាយុ៩១ឆ្នាំនោះ បងស្រីគើ ទ្រូ តបានគិតអំពីជីវិតរបស់គាត់ហើយពន្យល់ថា៖ « បទពិសោធន៍នេះនិងបទពិសោធន៍ឯទៀតបានបង្រៀនខ្ញុំថា ទោះជាមនុស្សភ្លាត់ធ្វើខុស គឺព្រះយេ ហូវ៉ាទេដែលដឹកនាំកិច្ចការដ៏អស្ចារ្យរបស់ទ្រង់ ហើយក្នុងនោះទ្រង់ប្រើមនុស្សឥតគ្រប់លក្ខណ៍ » ។ នៅពេលបងស្រីបានប្រឈមមុខនឹងភាពឥតគ្រប់លក្ខណ៍របស់អ្នកបម្រើឯទៀតរបស់ព្រះ នោះគាត់អធិស្ឋានដល់ព្រះយេ ហូវ៉ាអស់ពីចិត្ដ ។
សូម្បីតែបងប្អូនគ្រីស្ទានស្មោះត្រង់បំផុត ក៏ជាមនុស្សឥតគ្រប់លក្ខណ៍ដែរ ។ ដូច្នេះពេលបុរសតែងតាំងធ្វើខុស ចូរយើងបន្ដ« ធ្វើគ្រប់ការទាំងអស់ ដោយឥតត្អូញត្អែរ » ។ គួរឲ្យសោកស្តាយណាស់ !
តើអ្នកខ្លះបានឆ្លើយតបនឹងសេចក្ដីបង្រៀនខ្លះរបស់ព្រះយេស៊ូគ្រី ស្ទយ៉ាងដូចម្ដេច ?
នៅសតវត្សរ៍ទីមួយ មនុស្សខ្លះបានត្អូញត្អែរអំពីបងប្អូនដែលបានត្រូវតែងតាំង រីឯអ្នកឯទៀតបានត្អូញត្អែរអំពីសេចក្ដីបង្រៀនរបស់ព្រះយេស៊ូ ។ ដូចបានកត់នៅយ៉ូហាន ៦: ៤៨-៦៩ ព្រះយេស៊ូបានមានបន្ទូលថា៖ « អ្នកណាដែលបរិភោគសាច់នឹងឈាមរបស់ខ្ញុំ នោះមានជីវិតដ៏នៅអស់ កល្បជានិច្ច » ។ ពេលដែលឮសេចក្ដីទាំងនោះ« ពួកសិស្សទ្រង់ជាច្រើន ...
ក៏និយាយថា៖ ‹ ពាក្យនេះពិបាកស្តាប់ណាស់ តើអ្នកណាយល់បាន ? › »
។ ព្រះយេស៊ូជ្រាបថា« ពួកសិស្សរ ទូរទាំពីសេចក្ដីនោះ » ។ ម្យ៉ាងវិញទៀត « តាំងពីនោះមក ជាច្រើនដកខ្លួនថយចេញ មិនតាមទ្រង់ទៀតទេ » ។ ប៉ុន្ដែមិនមែនសិស្សទាំងអស់បានត្អូញត្អែរទេ ។ សូមកត់សម្គាល់អ្វីដែលបានកើតឡើងនៅពេលព្រះយេស៊ូសួរសាវ័ក១២នាក់ថា៖ « អ្នករាល់គ្នាចង់ថយទៅដែរឬ ? »
។ សាវ័កពេត្រុសទូលឆ្លើយថា៖ « ព្រះអម្ចាស់អើយ ! តើយើងខ្ញុំនឹងទៅឯអ្នកណាវិញ ?
គឺទ្រង់ហើយ ដែលមានព្រះបន្ទូលនៃជីវិតដ៏នៅអស់ កល្បជានិច្ច ។ យើងខ្ញុំក៏បានជឿ ហើយដឹងថា ទ្រង់ជាព្រះគ្រី ស្ទ ជាព្រះរាជ បុត្រានៃព្រះដ៏មានព្រះជន្មរស់ពិត » ។
ចុះបើយើងមានចិត្ដចង់ត្អូញត្អែរដោយសារយើងសង្ស័យទៅលើសេចក្ដីបង្រៀនខ្លះ ៗរបស់រាស្ដ្រព្រះយេ ហូវ៉ា ?
បើដូច្នេះ ចូរមានចិត្ដអត់ធ្មត់ ។ « អ្នកបំរើស្មោះត្រង់ »ប្រហែលជានឹងបោះពុម្ពព័ត៌មានដែលជួយឆ្លើយសំណួររបស់យើង ហើយជួយបំបាត់នូវការសង្ស័យ ។ យកល្អយើងសុំជំនួយពីអ្នកចាស់ទុំក្នុងក្រុម ជំនុំ ។ ការអធិស្ឋាន ការសិក្សាដោយខ្លួនឯង និងការសេព គប់ជាមួយបងប្អូនដែលខំឲ្យមានចិត្ដគំនិតដូចព្រះ ក៏អាចជួយឲ្យយើងបំបាត់នូវការសង្ស័យ ហើយអាចធ្វើឲ្យមានការអបអរច្រើនជាងចំពោះសេចក្ដីពិតពីព្រះគម្ពីរដែលពង្រឹងជំនឿ ដែលយើងបានរៀនតាមខ្សែរយៈរបស់ព្រះយេ ហូវ៉ា ។
ចូរផ្ដោតអារម្មណ៍លើលក្ខណៈល្អជានិច្ច
ជា ជាងត្អូញត្អែរ តើយើងគួរមានចិត្ដគំនិតបែបណា ?
ពិតមែនថា មនុស្សឥតគ្រប់លក្ខណ៍មានភាពទន់ទោរទៅរកអំពើបាប ហើយមនុស្សខ្លះមានភាពទន់ទោរយ៉ាងខ្លាំងទៅរកការត្អូញត្អែរដោយគ្មានមូលដ្ឋានត្រឹមត្រូវ ។ ( លោកុប្បត្ដិ ៨: ២១; រ៉ូម ៥: ១២) ប៉ុន្ដែប្រសិនបើយើងទៅជាមនុស្សដែលមានទម្លាប់ត្អូញត្អែរ យើងអាចបាត់បង់ចំណងមិត្ដ ភាពរបស់យើងជាមួយព្រះយេ ហូវ៉ា ។ ហេតុនេះហើយ យើងត្រូវចេះទប់ចិត្ដពេលមានចិត្ដចង់ត្អូញត្អែរ ។
ទំ រាំដល់ព្រះរាជាណាចក្ររបស់ព្រះគ្រប់គ្រងលើផែនដីទាំងមូល តើយើងគួរផ្ដោតអារម្មណ៍លើអ្វី ?
មិនយូរទៀត របបលោកិយអាក្រក់នេះនឹងត្រូវបំផ្លាញចោល ហើយព្រះរាជាណាចក្ររបស់មេស្ ស៊ីនឹងគ្រប់គ្រងលើផែនដីទាំងមូល ។ ទំ រាំពេលនោះមកដល់ ជាការសំខាន់ណាស់ !
បើយើងផ្ដោតអារម្មណ៍លើលក្ខណៈល្អជានិច្ច នោះនឹងជួយឲ្យយើងនឹកចាំពីពរជាច្រើនដែលយើងមានដោយសារចូលរួមជាមួយអង្គការព្រះយេ ហូវ៉ាផ្នែកផែនដី ។ នេះជាអង្គការតែមួយគត់លើពិភពលោកដែលស្មោះត្រង់នឹងព្រះមហាក្សត្រសកលលោក ។ តើអ្នកមានអារម្មណ៍យ៉ាងណាអំពីចំណុចនោះ និងឯក សិទ្ធិថ្វាយបង្គំព្រះយេ ហូវ៉ាដែលជាព្រះពិតតែមួយអង្គ ?
ចូរមានទស្សនៈដូចដាវីឌដែលច្រៀងថា៖ « ឱព្រះដែលស្តាប់សេចក្ដីអធិស្ឋានអើយ !
អ្នកណាដែលទ្រង់រើស ហើយនាំមកនៅចំពោះទ្រង់ ដើម្បីឲ្យបានអាស្រ័យនៅក្នុងព្រះលានទ្រង់ យើងខ្ញុំនឹងបានស្កប់ចិត្ដដោយសេចក្ដីលំអនៃដំណាក់ទ្រង់ » ។ — ទំនុក ដំកើង ៦៥ : ២, ៤
ដាវីឌបានប្រទានប្លង់ព្រះវិហារដល់សាឡូម៉ូន ហើយបានគាំទ្រការថ្វាយបង្គំពិតអស់ពីព្រះទ័យ
អ្នកចាស់ទុំក្នុងក្រុម ជំនុំគ្រីស្ទានពិត សប្បាយចិត្ដជួយយើងខាងវិញ្ញាណ
ព្រះយេ ហូវ៉ាប្រោសមនុស្សដែលមានទុក្ខលំបាកឲ្យរួច
តើគ្រីស្ទានស្មោះត្រង់ម្នាក់ធ្លាប់មានបញ្ហាអ្វី ?
ហេតុអ្វីយើងអាចមានអារម្មណ៍ស្រដៀងនឹងគាត់ដែរ ?
តើអ្នកធ្លាប់មានអារម្មណ៍អស់សង្ឃឹមបែបនោះទេ ?
ដោយសារអ្នកជាស្ម របន្ទាល់ព្រះយេ ហូវ៉ា មានហេតុជាច្រើនដែលអ្នកគួរមានអំណរ ដ្បិតការគោរពប្រតិ បត្ដិដល់ព្រះ « មានសេចក្ដីសន្យាឲ្យបានជីវិតនៅជាន់ឥឡូវនេះ ហើយទៅខាងនាយផង » ។ ឥឡូវនេះអ្នកកំពុងតែស្ថិតក្នុងសួនម នោរម្យខាងវិញ្ញាណ !
សូមឲ្យឧទាហរណ៍ពីព្រះគម្ពីរអំពីអ្នកបម្រើព្រះដែលធ្លាប់កើតទុក្ខយ៉ាងខ្លាំង ។
ហេតុអ្វីមិនចម្លែកដែលមាន ‹ ពួកអ្នកដែលមានសេចក្ដីទន់ក្រំចិត្ដ › ក្នុងចំណោមគ្រីស្ទានពិតសព្វថ្ងៃនេះ ?
ចុះគ្រីស្ទានពិតវិញ ?
សូមពិចារណាមូលហេតុធម្មតាបីយ៉ាង ។
ភាពឥតគ្រប់លក្ខណ៍របស់យើង អាចធ្វើឲ្យយើងកើតទុក្ខ
គ្រីស្ទានពិតតែងពិបាកចិត្ដដោយសារខ្លួនមានបាប ហើយនេះធ្វើឲ្យពួកគេខុសពីមនុស្សខូចអាក្រក់ដែល« លែងខ្លាចបាប » ។ ពួកគេប្រហែលជាមានអារម្មណ៍ដូចប៉ុលដែលសរសេរថា « តាមប៉ែកខាងក្នុង ខ្ញុំត្រេកអរចំពោះក្រិត្យវិន័យរបស់ព្រះ តែខ្ញុំឃើញមានអំណាច១ទៀត ក្នុងអស់ទាំងអវយវៈរបស់រូបកាយខ្ញុំ ដែលច្បាំងនឹងអំណាចនៃគំនិតខ្ញុំ ទាំងចាប់នាំខ្ញុំទៅជាប់ក្រោមអំណាចអំពើបាប ដែលនៅក្នុងអវយវៈនៃខ្លួនខ្ញុំទាំងប៉ុន្មានផង » ។ រួចប៉ុលឧទានថា « វេទនាណាស់ខ្ញុំ ! »
តើអ្នកធ្លាប់មានអារម្មណ៍ដូចប៉ុលទេ ?
គឺមិនខុសទេដែលអ្នកកត់សម្គាល់យ៉ាងច្បាស់នូវកំហុសរបស់ខ្លួន ដ្បិតនេះអាចជួយឲ្យយល់ថាបាបជាអ្វីដ៏ធ្ងន់ធ្ងរមែន ហើយពង្រឹងការតាំងចិត្ដឲ្យបដិសេធរាល់ការអាក្រក់ ។ ប៉ុន្ដែអ្នកមិនចាំបាច់ព្រួយលំបាកជាប់រហូតដោយសារកំហុសរបស់ខ្លួនទេ ។ ប៉ុលបានបន្ថែមពាក្យថា « អរព្រះគុណដល់ព្រះអង្គ គឺដោយសារព្រះយេស៊ូវគ្រី ស្ទ ! »
។ ប៉ុលជឿជាក់ថាព្រះលោហិតរបស់ព្រះយេស៊ូដែលបានត្រូវបង្ហូរចេញអាចលោះគាត់ពីបាបដែលបានទទួលពីអ័ដាមមក ។ — រ៉ូម ៥: ១៨
ហេតុអ្វីយើងមិនគួរចោទប្រកាន់និងផ្ដន្ទាទោសខ្លួន ?
នៅវិវរណៈ ១២: ១០ សាតាំងបានត្រូវហៅថា « អានោះដែលចោទប្រកាន់ពីពួកបងប្អូនយើងរាល់គ្នា » គឺគ្រីស្ទានចាក់ប្រេងតាំង ។ វា« ចេះតែចោទពីគេ នៅចំពោះព្រះទាំងយប់ទាំងថ្ងៃ » ។ គិតអំពីខនោះ ប្រហែលជានឹងជួយឲ្យអ្នកយល់ថាសាតាំង ដែលជាអ្នកចោទប្រកាន់មិនពិត នឹងពេញចិត្ដបើអ្នកចោទប្រកាន់និងផ្ដន្ទាទោសខ្លួន ទោះជាព្រះយេ ហូវ៉ាមិនចោទប្រកាន់ឬផ្ដន្ទាទោសអ្នកឡើយ ។ តើចាំបាច់ព្រួយលំបាកលើកំហុសរបស់ខ្លួនរហូតដល់ចង់ឈប់ព្យាយាមទៀតទេ ?
កុំឲ្យសាតាំងបំផ្លាញចំណងមិត្ដ ភាពរបស់អ្នកជាមួយព្រះយេ ហូវ៉ាឡើយ ។ កុំឲ្យអារក្សធ្វើឲ្យភ្លេចថា ព្រះយេ ហូវ៉ាជាព្រះមួយអង្គដែល« មានព្រះហឫទ័យមេ ត្ដា ក រុណា ហើយទន់សន្ដោស ទ្រង់យឺតនឹងខ្ញាល់ ហើយមានសេចក្ដីសប្បុរស នឹងសេចក្ដីទៀង ត្រង់ជាបរិបូរ » ។ — និក្ខម នំ ៣៤: ៦
កម្រិតសមត្ថភាពរបស់យើងអាចធ្វើឲ្យធ្លាក់ទឹកចិត្ដ
តើកម្រិតសមត្ថភាពអាចធ្វើឲ្យយើងធ្លាក់ទឹកចិត្ដយ៉ាងដូចម្ដេច ?
ប្រហែលជាជំងឺរ៉ាំរ៉ៃ អាយុច្រើន ឬបញ្ហាណាផ្សេងទៀតរារាំងមិនឲ្យអ្នកចំណាយពេលច្រើនក្នុងកិច្ចបម្រើដូចពីមុន ។ ពិតមែនថា បងប្អូនគ្រីស្ទានលៃយកពេលសម្រាប់កិច្ចបម្រើ ។ ក៏ប៉ុន្ដែ ចុះបើកម្រិតសមត្ថភាពរបស់យើងរារាំងមិនឲ្យធ្វើច្រើនក្នុងកិច្ចបម្រើ ហើយនេះធ្វើឲ្យយើងធ្លាក់ទឹកចិត្ដ ?
យើងមានចិត្ដរំភើបពេលដែលរង់ចាំទទួលជីវិតក្នុងពិភពលោកថ្មីរបស់ព្រះ ដែលពោរពេញដោយសេចក្ដីសុចរិត ។ ក៏ប៉ុន្ដែ ឥឡូវនេះយើងកំពុងតែរស់នៅ« គ្រាលំបាកណាស់ » ។ យើងសប្បាយដោយដឹងថា ព្រឹត្ដិការណ៍ដ៏គួរឲ្យព្រួយបារម្ភសព្វថ្ងៃនេះ បញ្ជាក់ថាយើងជិតទទួលសេចក្ដីសង្គ្រោះហើយ ។ ទោះជាយ៉ាងនោះក្ដី ក៏យើងនៅតែជួបទុក្ខលំបាកដោយសារស្ថានភាពនៅជុំវិញយើង ។ ជាឧទាហរណ៍ ចុះបើអ្នកគ្មានការងារធ្វើ ?
ប្រហែលជានៅតំបន់ដែលអ្នករស់នៅ មិនសូវមានការងារធ្វើទេ ហើយក្រោយប៉ុន្មានខែកន្លងទៅ ប្រហែលជាអ្នកចាប់ផ្ដើមឆ្ងល់ថា តើព្រះយេ ហូវ៉ាទតឃើញស្ថានភាពរបស់អ្នកទេ ?
តើទ្រង់បានសណ្ដាប់នូវសេចក្ដីអធិស្ឋានរបស់អ្នកឬទេ ?
ឬមួយក៏ប្រហែលជាអ្នកជាជនរងគ្រោះដោយសារការរើសអើងឬអំពើអ យុត្ ដិ ធម៌ណាផ្សេងទៀត ។ សូម្បីតែការមើលចំណងជើងផ្សេង ៗក្នុងកាសែតអាចធ្វើឲ្យយើងមានអារម្មណ៍ដូចឡុតជាបុរសសុចរិតនោះ ដែល « មានចិត្ដព្រួយលំបាក »ដោយអំពើអសីលធម៌របស់មនុស្សនៅជុំវិញគាត់ ។ — ពេត្រុស ទី២ ២: ៧
ហេតុអ្វីសេចក្ដីស្រឡាញ់របស់ព្រះយេ ហូវ៉ាគឺប្រសើរជាងសេចក្ដីស្រឡាញ់របស់មនុស្ស ?
ដោយដឹងថាព្រះយេ ហូវ៉ាស្រឡាញ់យើងច្រើនជាងមាតាបិតាយើងទៀត ។ ពិតមែនថា ពេលមាតាឬបិតាកាត់កាល ធ្វើបាប ឬបោះបង់យើងចោល នោះធ្វើឲ្យឈឺចិត្ដខ្លាំងណាស់ តែនោះមិនមានឥទ្ធិពលទៅលើព្រះទ័យព្រះយេ ហូវ៉ាចំពោះយើងឡើយ ។ សូមចាំថា ព្រះទាញនាំអស់អ្នកដែលទ្រង់ស្រឡាញ់ឲ្យមកឯទ្រង់ ។ មិនថាមនុស្សធ្លាប់ប្រព្រឹត្ដចំពោះអ្នកយ៉ាងណាក៏ដោយ ព្រះវរ បិតារបស់អ្នកនៅស្ថាន សួគ៌ស្រឡាញ់អ្នកណាស់ !
អ្វីដែលអាចធ្វើ ដើម្បីកាត់បន្ថយអារម្មណ៍ធ្លាក់ទឹកចិត្ដ
ពេលមានអារម្មណ៍ធ្លាក់ទឹកចិត្ដ តើយើងអាចធ្វើអ្វីខ្លះដើម្បីរក្សាឲ្យមានកម្លាំងខាងវិញ្ញាណ ?
មានអ្វីខ្លះដែលអ្នកអាចធ្វើដើម្បីស៊ូទ្រាំពេលមានអារម្មណ៍ធ្លាក់ទឹកចិត្ដ ។ ជាឧទាហរណ៍ ចូរចូលរួមឲ្យបានច្រើនបំផុតក្នុងកិច្ចការខាងវិញ្ញាណ ។ ចូររំពឹងគិតអំពីព្រះបន្ទូលរបស់ព្រះ ជាពិសេសពេលអារម្មណ៍ធ្លាក់ទឹកចិត្ដគឺខ្លាំងពេកស្ទើរទ្រាំមិនបាន ។ អ្នកតែងទំនុក ដំកើងបានច្រៀងថា៖ « កាលទូលបង្គំបានពោលថា ‹ ជើងទូលបង្គំរ ឥលភ្លាត់ហើយ › នោះឱព្រះយេ ហូវ៉ាអើយ !
តើអ្នកដែលធ្លាក់ទឹកចិត្ដអាចធ្វើអ្វី ?
ទោះជាមិនទាន់ដល់គ្រាដែលព្រះយេ ហូវ៉ានឹង« ជូតអស់ទាំងទឹកភ្នែក »ពីភ្នែកអ្នកចេញក៏ពិតមែន តែទ្រង់នឹងជួយឲ្យអ្នកស៊ូទ្រាំ ។ — វិវរណៈ ២១: ៤; កូរិន ថូស ទី១ ១០: ១៣
ការរស់« នៅក្រោមព្រះហស្ដដ៏ពូកែរបស់ព្រះ »
តើព្រះយេ ហូវ៉ាសន្យាអ្វីនឹងអ្នកដែលមានទុក្ខលំបាក ?
ព្រះគម្ពីរផ្ដល់ទំនុកចិត្ដថា ទោះជាមនុស្សសុចរិតមានទុក្ខលំបាកជាច្រើនក៏ដោយ « តែព្រះយេ ហូវ៉ាទ្រង់ជួយឲ្យរួចពីសេចក្ដីទាំងនោះ » ។ ( ទំនុក ដំកើង ៣៤: ១៩ ) តើព្រះជួយឲ្យរួចដោយដូចម្ដេច ?
តើទ្រង់សន្យាអ្វីនឹងអ្នកដែរ ?
មិនមែនសន្យាប្រោសឲ្យជានៅសព្វថ្ងៃនេះទេ តែទ្រង់ផ្ដល់កម្លាំងឲ្យស៊ូទ្រាំវិញ ។
ទោះជាយើងជួបនឹងទុក្ខលំបាកក៏ពិតមែន តើពេត្រុស ទី១ ៥: ៦, ៧ផ្ដល់ទំនុកចិត្ដដូចម្ដេច ?
ជំងឺផ្លូវចិត្ដនេះមិនត្រឹមតែជាការធ្លាក់ទឹកចិត្ដទេ តែជាអារម្មណ៍សោកសង្រេងយ៉ាងខ្លាំងមិនស្រា ក ស្រា ន្ដ ។
ទោះជាមានទុក្ខលំបាកក៏ពិតមែន រាស្ដ្ររបស់ព្រះយេ ហូវ៉ាមានហេតុអរសប្បាយ
ការផ្សព្វផ្សាយតាមទូរស័ព្ទជាវិធីមួយ ដើម្បីថ្វាយអ្វីដ៏ល្អបំផុតដល់ព្រះយេ ហូវ៉ា
តើមនុស្សម្នាក់ដែលប្រព្រឹត្ដអំពើស្មោក គ្រោកអាចត្រូវបណ្ដាច់មិត្ដ ភាពពីក្រុមជំនុំគ្រិស្ដសាសនិក ដូចអ្នកដែលប្រព្រឹត្ដអំពើប្រាសចាកសីលធម៌ខាងផ្លូវភេទឬអ្នកដែលមានសីលធម៌ធូររ លុងឬទេ ?
អំពើប្រាសចាកសីលធម៌ខាងផ្លូវភេទ ( ពាក្យភាសាក្រិច ផូ នៀ ) គឺជាការរួមភេទរវាងមនុស្សដែលមិនបានរៀបការស្របតាមគោលការណ៍ក្នុងគម្ពីរ ។ នេះរួមបញ្ចូលការផិតក្បត់ ពេស្យាចារ និងការរួមភេទរវាងអ្នកដែលមិនទាន់រៀបការជាមួយគ្នា ថែមទាំងការរួមភេទតាមមាត់និងតាមផ្លូវបាត និងការស្ទាបអង្អែលសរីរាង្គភេទរបស់អ្នកដែលមិនមែនជាគូអាពាហ៍ ពិពាហ៍របស់ខ្លួន ។ អ្នកដែលប្រព្រឹត្ដអំពើប្រាសចាកសីលធម៌ខាងផ្លូវភេទដោយមិនប្រែចិត្ដ គាត់មិនសមជាសមាជិកនៃក្រុមជំនុំទេ ។
ដូចបានបង្ហាញនៅខាងលើ«ការមានសីលធម៌ធូររ លុង»រួមបញ្ចូលអ្វីពីរយ៉ាង ( ១ ) ការប្រព្រឹត្ដនោះបំពានយ៉ាងធ្ងន់ធ្ងរលើច្បាប់របស់ព្រះ និង( ២ ) ចិត្ដគំនិតរបស់អ្នកដែលធ្វើខុសគឺព្រហើននិងមិនបង្ហាញការគោរព ។
យោងទៅតាមអេភេសូរ ៤: ១៩ ប៉ូលបានស្រដីថាអ្នកខ្លះ«លែងស្គាល់ល្អស្គាល់អាក្រក់»ហើយ«ពួកគេបណ្ដោយខ្លួនទៅតាមសីលធម៌ធូររលុង ដើម្បីធ្វើអំពើស្មោក គ្រោកគ្រប់បែបយ៉ាងដោយចិត្ដលោភលន់» ។ យ៉ាងនេះ ប៉ូលចង់បញ្ជាក់ថា«អំពើស្មោក គ្រោក ...
ដោយចិត្ដលោភលន់»គឺធ្ងន់ដូចការមានសីលធម៌ធូររ លុងដែរ ។ ដូច្នេះ ប្រសិនបើបុគ្គលម្នាក់ដែលទទួលការជ្រមុជទឹកហើយ មិនប្រែចិត្ដពីការប្រព្រឹត្ដ«អំពើស្មោក គ្រោក ...
ដោយចិត្ដលោភលន់»នោះទេ ។ ក្នុងករណីនេះ បើអ្នកចាស់ទុំម្នាក់ឬពីរនាក់ជូនឱវាទពីគម្ពីរ និងមានជំនួយពីឪពុកម្ដាយរបស់គាត់ នោះជាអ្វីដែលគ្រប់គ្រាន់ហើយ ។ ប៉ុន្ដែ ប្រសិនបើប្អូនប្រុសនោះជក់បារីជាញឹកញាប់ នេះនឹងបង្ហាញថាគាត់ធ្វើដោយចេតនានូវអ្វីដែលនាំឲ្យស្មោក គ្រោក ហើយគណៈកម្មាធិការវិនិច្ឆ័យត្រូវតែបង្កើតឡើងដើម្បីពិចារណាអំពីរឿងនេះដែលជាអំពើស្មោក គ្រោកធ្ងន់ធ្ងរ ។ ( កូរិន ថូស ទី២ ៧: ១ ) បើប្អូនប្រុសនោះមិនប្រែចិត្ដ គាត់នឹងត្រូវបណ្ដាច់មិត្ដ ភាព ។
ដោយចិត្ដលោភលន់»ទេ ហើយថាគាត់ក៏មិនបង្ហាញចិត្ដគំនិតព្រហើនឥតកោតក្រែងដែលជាលក្ខណៈសម្គាល់នៃការមានសីលធម៌ធូររ លុងដែរ ។ ស្ដីអំពីអំពើស្មោក គ្រោកបែបនេះមិនចាំបាច់មានគណៈកម្មាធិការវិនិច្ឆ័យទេ ប៉ុន្ដែត្រូវផ្ដល់ដំបូន្មានយ៉ាងម៉ឺងម៉ាត់ដែលមានមូលដ្ឋានលើគម្ពីរដល់គាត់ ហើយយូរៗម្ដង ប្រហែលជាអ្នកចាស់ទុំត្រូវនិយាយជាមួយគាត់អំពីអ្វីដែលគាត់បានធ្វើដើម្បីជួយដោះស្រាយបញ្ហានោះ ។
ហេតុអ្វីមនុស្សជាច្រើនពិបាកយល់អត្ថន័យនៃការកោតខ្លាចព្រះ?
តើអ្វីអាចជួយឲ្យយើង« ចេះកោតខ្លាចដល់ព្រះយេ ហូវ៉ា » ?
យើងត្រូវតែកោតខ្លាចព្រះ ទើបអាចធ្វើការសម្រេចចិត្ដដ៏ល្អនិងទទួលពរពីទ្រង់ ។ បើដូច្នេះ តើយើងអាចរៀនឲ្យ« ចេះកោតខ្លាចដល់ព្រះយេ ហូវ៉ា »យ៉ាងត្រឹមត្រូវដោយដូចម្ដេច ?
សូមបង្រៀនទូលបង្គំឲ្យស្គាល់ផ្លូវនៃទ្រង់ ទូលបង្គំនឹងដើរក្នុងសេចក្ដីពិតរបស់ទ្រង់ សូមបំព្រួមចិត្ដទូលបង្គំមកឲ្យកោតខ្លាចដល់ព្រះនាមទ្រង់ » ។ — ទំនុក ដំកើង ៨៦ :១០, ១១
តើការកោតខ្លាចព្រះបានជួយឲ្យដាវីឌសម្លាប់កូ លី យ៉ាតយ៉ាងដូចម្ដេច ?
នៅពេលសាសន៍ភី លី ស្ទីនបានរុករានស្រុកអ៊ីស្រាអែល បុរសខ្លាំងពូកែបំផុតរបស់ពួកគេឈ្មោះកូ លី យ៉ាតដែលមានកម្ពស់ប្រមាណបីម៉ែត្រ បាននិយាយចំអកឲ្យសាសន៍អ៊ីស្រាអែលថា៖ ‹ ចូររើសបុរសម្នាក់ឲ្យចុះមកច្បាំងនឹងអញមើល !
តើគំរូរបស់អ្នកកោតខ្លាចព្រះបង្រៀនយើងអ្វីខ្លះ ?
ប្រហែលជាយើងកំពុងតែប្រឈមមុខឧបសគ្គឬសត្រូវណាមួយដែលគួរឲ្យខ្លាច ដូចសត្រូវដែលដាវីឌបានប្រឈមមុខដែរ ។ តើយើងអាចធ្វើយ៉ាងណា ?
យើងអាចកោតខ្លាចព្រះដូចដាវីឌនិងមនុស្សស្មោះត្រង់ឯទៀតនៅសម័យបុរាណដែរ ។ ការកោតខ្លាចព្រះអាចឈ្នះការខ្លាចមនុស្ស ។ ពេលមានអ្នកប្រឆាំងបៀតបៀន នោះអ្នកបម្រើស្មោះត្រង់ម្នាក់របស់ព្រះឈ្មោះនេហេមាបានដាស់តឿនសាសន៍អ៊ីស្រាអែលគ្នីគ្នាថា៖ « កុំឲ្យខ្លាចគេឡើយ !
ចូរនឹករឭកដល់ព្រះអម្ចាស់ដែលទ្រង់ធំ ហើយគួរស្ញែងខ្លាចវិញ » ។ ( នេហេមា ៤: ១៤) ដោយមានការគាំទ្រពីព្រះយេ ហូវ៉ា ដាវីឌ នេហេមា និងអ្នកបម្រើឯទៀតរបស់ព្រះបានបំពេញកិច្ចការដែលទ្រង់ប្រទាន ។ បើយើងកោតខ្លាចព្រះ យើងក៏អាចទទួលជោគជ័យដូចពួកគាត់ដែរ ។
របៀបប្រឈមមុខបញ្ហាដោយកោតខ្លាចព្រះ
តើដាវីឌបានបង្ហាញដោយដូចម្ដេចថា គាត់កោតខ្លាចព្រះនៅចំពោះមុខគ្រោះថ្នាក់ ?
នៅគ្រាមួយ ដាវីឌត្រូវជ្រកកោននៅទីក្រុងកាថនាស្រុកសាសន៍ភី លី ស្ទីន ដែលគ្រប់គ្រងដោយស្ដេចអ័ គីស ហើយជាស្រុកកំណើតរបស់កូ លី យ៉ាត ។ ( សាំ យូអែល ទី១ ២១: ១០-១៥ ) អ្នកបម្រើរបស់ស្ដេចបានចោទប្រកាន់ដាវីឌថា គាត់ជាសត្រូវនៃសាសន៍ភី លី ស្ទីន ។ តើដាវីឌបានប្រព្រឹត្ដយ៉ាងណាក្នុងកាលៈទេសៈដែលប្រកបដោយគ្រោះថ្នាក់នោះ ?
ដូចដាវីឌដែរ យើងអាចបង្ហាញថាយើងកោតខ្លាចព្រះ ដោយទុកចិត្ដលើសេចក្ដីសន្យារបស់ទ្រង់ដែលថាទ្រង់នឹងជួយឲ្យយើងស៊ូទ្រាំបញ្ហារបស់យើង ។ ដាវីឌបានពោលថា៖ « ចូរទុកដាក់ផ្លូវអ្នកនឹងព្រះយេ ហូវ៉ាចុះ !
ហេតុអ្វីយើងត្រូវចាត់ទុកសេចក្ដីអធិស្ឋានជារឿងសំខាន់ ?
ពេលដាវីឌបានខានកោតខ្លាចព្រះ
ពេលដែលដាវីឌរាប់ចំនួនទាហានរបស់អ៊ីស្រាអែល តើមានលទ្ធផលអ្វី ?
តើអ្វីបានបណ្ដាលឲ្យដាវីឌធ្វើអំពើអសីលធម៌ខាងកាម ?
តើដាវីឌទទួលលទ្ធផលយ៉ាងណាពីអំពើបាបរបស់ទ្រង់ ?
សព្វថ្ងៃនេះ ការមិនកោតខ្លាចព្រះក្នុងរឿងសីលធម៌អាចមានលទ្ធផលខ្លោចផ្សាដែលបន្សល់ទុកស្លាកស្នាមផ្លូវចិត្ដ ។ សូមគិតអំពីការព្រួយលំបាកចិត្ដរបស់ភរិយាគ្រីស្ទានមួយរូប ពេលនាងដឹងថាប្ដីរបស់នាងបានផិតក្បត់ពេលទៅធ្វើការនៅប្រទេសក្រៅ ។ នាងបានឱនខ្លួនក្ដោបមុខយំយ៉ាងខ្លាំង ដោយស្លុតផងខ្លោចចិត្ដផង ។ តើនឹងត្រូវការពេលយូរប៉ុន្មានទើបគាត់ទុកចិត្ដនឹងគោរពប្ដីរបស់គាត់វិញ ?
ការកោតខ្លាចព្រះជួយឃាត់យើង ពីការប្រព្រឹត្ដអំពើបាប
តើសាតាំងមានគោលដៅអ្វី ?
តើវាខំសម្រេចគោលដៅនោះដោយវិធីណា ?
តើការកោតខ្លាចព្រះបានជួយគ្រីស្ទានម្នាក់មិនឲ្យចាញ់សេចក្ដីល្បួងយ៉ាងដូចម្ដេច ?
បើពិតជាកោតខ្លាចព្រះ នោះតែងតែជាផ្លូវប្រកបដោយប្រាជ្ញា ។ នោះក៏ជាផ្លូវនាំឲ្យទទួលសុភមង្គលដ៏ពិតផងដែរ ។ ( ទំនុក ដំកើង ៣៤ : ៩) អត្ថបទបន្ទាប់នឹងបញ្ជាក់ចំណុចនេះយ៉ាងច្បាស់ ។
ដាវីឌបានរៀនឲ្យចេះកោតខ្លាចព្រះ ដោយមើលស្នាព្រះហស្ដរបស់ព្រះយេ ហូវ៉ា
តើអ្នកនឹងប្រព្រឹត្ដយ៉ាងណាពេលជួបនឹងសេចក្ដីល្បួង ?
តើការកោតខ្លាចព្រះអាចជួយឲ្យយើងទទួលសុភមង្គលឡើងវិញយ៉ាងដូចម្ដេច ?
តើអ្វីបានឃាត់ដាវីឌកុំឲ្យប្រព្រឹត្ដអំពើបាប ?
ហេតុអ្វីដាវីឌមិនបានសម្លាប់សូល ទោះជាពីរដងគាត់មានឱកាសសម្លាប់ទ្រង់ក៏ដោយ ?
ការកោតខ្លាចព្រះនាំឲ្យមានសុភមង្គល
តើការកោតខ្លាចព្រះបានជួយពង្រឹងកម្លាំងដាវីឌយ៉ាងដូចម្ដេច ?
តើដាវីឌចង់ប្រគល់អ្វីដល់កូនចៅ ?
តើមាតាបិតាអាចអប់រំកូនឲ្យកោតខ្លាចព្រះយេ ហូវ៉ាយ៉ាងដូចម្ដេច ?
តើយើងនឹងទទួលអ្វីបើយើងកោតខ្លាចព្រះដ៏ពិត ?
ឈ្មោះបានត្រូវប្ដូរ ។
នេះប្រហែលជាបទពិសោធន៍មួយដែលជំរុញឲ្យដាវីឌតែងទំនុក ដំកើងទី៥៧និងទី១៤២ ។
តើការកោតខ្លាចព្រះអាច
ការកោតខ្លាចព្រះយេ ហូវ៉ាបានឃាត់ដាវីឌមិនឲ្យសម្លាប់ស្ដេចសូល
ការកោតខ្លាចព្រះជាកេរ្ដិ៍មត៌កថ្លៃវិសេស ដែលមាតាបិតាអាចឲ្យដល់កូន
ចូរស៊ូទ្រាំនិងមានចិត្ដស្មោះគ្រប់លក្ខណ៍ដូចយ៉ូប
តើព្រះយេ ហូវ៉ាមានទស្សនៈយ៉ាងណាចំពោះយ៉ូប ?
ហេតុអ្វីយើងអាចទទួលប្រយោជន៍ពីការពិនិត្យឡើងវិញនូវបទពិសោធន៍របស់យ៉ូប ?
ភាពស្មោះត្រង់ត្រូវចោទប្រកាន់ ហើយចិត្ដស្មោះគ្រប់លក្ខណ៍ត្រូវសាកល្បង
តើសាតាំងបានចោទប្រកាន់រឿងសំខាន់អ្វី ?
ឬក៏នៅទីបំផុតតើការគ្រប់គ្រងរបស់ទ្រង់ត្រូវមានមូលដ្ឋានលើការចង់បានផលប្រយោជន៍វិញ ដូចសាតាំងបានចោទប្រកាន់នោះឬ ?
ទោះជាយ៉ាងនោះក៏ដោយ ក៏សាតាំងអាចឆ្លៀតយកប្រយោជន៍ពីទុក្ខលំបាកដែលយើងជួបប្រទះ ដើម្បីបំផ្លាញជំនឿរបស់យើង ។ សាវ័កប៉ុលបាននិយាយថាគាត់« មានបន្លា១ចាត់មកក្នុងសាច់ឈាម .. .
គឺជាទេវតារបស់អារក្សសាតាំង »ដែល« មកធ្វើទុក្ខ »គាត់ ។ មិនថាបន្លានោះសំដៅទៅលើបញ្ហាភ្នែកអន់ឬបញ្ហាមួយផ្សេងទៀតក៏ដោយ ក៏ប៉ុលយល់ថាសាតាំងអាចឆ្លៀតយកប្រយោជន៍ពីបញ្ហានោះនិងអារម្មណ៍ធ្លាក់ទឹកចិត្ដដែលបញ្ហានោះបណ្ដាលឲ្យមាន ដើម្បីធ្វើឲ្យប៉ុលបាត់បង់អំណរនិងភាពស្មោះគ្រប់លក្ខណ៍ ។ ( សុភាសិត ២៤ : ១០) សព្វថ្ងៃនេះ សាតាំងប្រហែលជាញុះញង់សមាជិកក្រុមគ្រួសារ រដ្ឋាភិបាលផ្ដាច់ការ ឬមិត្ដរួមថ្នាក់ឲ្យបៀតបៀនអ្នកបម្រើព្រះ ។
ហេតុអ្វីយើងមិនសូវភ្ញាក់ផ្អើលពេលមានទុក្ខលំបាកឬការបៀតបៀន ?
តើយើងអាចប្រឈមមុខទុក្ខវេទនាបែបនោះយ៉ាងដូចម្ដេច ?
យើងអាចចាត់ទុកគ្រាដែលមានទុក្ខលំបាកជាឱកាសបង្ហាញថា យើងស្រឡាញ់ព្រះយេ ហូវ៉ាហើយចុះចូលចំពោះការគ្រប់គ្រងរបស់ទ្រង់ដោយឥតរេរាឡើយ ។ មិនថាទុក្ខលំបាករបស់យើងមកពីប្រភពណាក៏ដោយ ការយល់ដឹងអំពីសារៈសំខាន់នៃភាពស្មោះត្រង់ចំពោះព្រះនឹងជួយឲ្យយើងរក្សាលំនឹងខាងវិញ្ញាណ ។ សាវ័កពេត្រុសបានសរសេរទៅកាន់បណ្ដាគ្រិស្ដសាសនិ កថា៖ « ពួកស្ងួន ភ្ងាអើយ !
តើយ៉ូបមិនបានដឹងអំពីអ្វី ?
យ៉ូបបានធ្លាក់ទឹកចិត្ដយ៉ាងខ្លាំង តែមិនរហូតដល់ប្រមាថតិះដៀលព្រះតាមយោបល់ប្រពន្ធគាត់ឡើយ ។ ( យ៉ូប ២: ៩, ១០) យ៉ូបបាននិយាយថា៖ ‹ មនុស្សទុច្ចរិតមានភាពសុខស្រួលជាងខ្ញុំឆ្ងាយណាស់ › ។ ( យ៉ូប ២១: ៧-៩) គាត់ច្បាស់ជាបានឆ្ងល់ថា ‹ ហេតុអ្វីព្រះកំពុងតែដាក់ទោសខ្ញុំយ៉ាងនេះ ? ›
។ មានពេលខ្លះដែលយ៉ូបចង់ស្លាប់ជាជាងរស់នៅ ។ គាត់ធ្លាប់ឧទានថា៖ « ឱបើទ្រង់នឹងលាក់ទូលបង្គំ នៅស្ថានឃុំព្រលឹងមនុស្សស្លាប់ទៅអេះ !
តើសម្ដីនៃមិត្ដបីនាក់របស់យ៉ូបមានឥទ្ធិពលយ៉ាងណាទៅលើគាត់ ?
ពិតមែនថាយ៉ូបប្រហែលជានឹងមានអារម្មណ៍ធូរស្រាលជាងបើអាចរៀបរាប់ប្រាប់មិត្ដភក្ដិអំពីក្ដីទុក្ខរបស់គាត់ តែបុរសបីនាក់នោះបាននាំឲ្យយ៉ូបកាន់តែច្របូកច្របល់ក្នុងអារម្មណ៍ ហើយតូចចិត្ដតូចថ្លើមជាងមុនទៅទៀត ។ — យ៉ូប ១៩: ២; ២៦ : ២
ហេតុនោះគឺមិនចម្លែកទេ បើយ៉ូបសួរខ្លួនឯងថា ‹ ហេតុអ្វីខ្ញុំត្រូវលំបាកយ៉ាងនេះ ?
តើខ្ញុំបានធ្វើអ្វីឲ្យគួរនឹងអន្ដរា យខ្លួនដូច្នេះ ? ›
តាមដែលខ្ញុំបានឃើញ នោះគឺអស់អ្នកដែលភ្ជួរបំផុលសេចក្ដីទុច្ចរិតឡើង ហើយសាបព្រោះសេចក្ដីកំណាចចុះ គេរមែងច្រូតបានសេចក្ដីនោះឯងវិញ » ។ — យ៉ូប ៤: ៧, ៨
ហេតុអ្វីយើងមិនគួរសន្និដ្ឋានភ្លាម ៗថាការរងទុក្ខបណ្ដាលមកពីការប្រព្រឹត្ដមិនត្រឹមត្រូវ ?
ពិតមែនថា ប្រសិនបើយើងសាបព្រោះខាងសាច់ឈាមជាជាងខាងវិញ្ញាណ យើងអាចមានបញ្ហាមែន ។ ក៏ប៉ុន្ដែ ក្នុងរបបលោកិយនេះ យើងអាចមានបញ្ហាមិនថាយើងប្រព្រឹត្ដល្អឬអាក្រក់ក៏ដោយ ។ ម្យ៉ាងទៀត យើងពុំអាចនិយាយដោយត្រឹមត្រូវថាមនុស្សដែលគ្មានទោសមិនដែលមានទុក្ខលំបាកទេ ។ ព្រះយេស៊ូគ្រិស្ដដែល« ឥតសៅ ហ្មង ...
តើការវែកញែកបែបណានឹងជួយឲ្យយើងស៊ូទ្រាំទុក្ខវេទនា ?
តើកំណត់ហេតុនេះបង្កប់មេរៀនសម្រាប់យើងទេ ?
តើខ្ញុំចង់ផ្ដល់ទីសំអាងដើម្បីឲ្យព្រះយេ ហូវ៉ា« ត បឆ្លើយចំពោះអ្នកដែលដៀល តិះដល់ទ្រង់ ? »›
តើសំវិធានការអ្វីខ្លះពីព្រះអាចជួយឲ្យយើងស៊ូទ្រាំ ?
គឺដោយគាត់រៀនឲ្យចេះពឹងលើព្រះចេស្តារបស់ព្រះ ។ ប៉ុលបានសរសេរថា « ខ្ញុំអាចនឹងធ្វើគ្រប់ទាំងអស់បាន ដោយសារព្រះ...
តើអ្វីបានជួយឲ្យយ៉ូបរក្សាលក្ខណៈខ្លួននៅចំពោះមុខការខំប្រឹងរបស់សាតាំង ?
ហេតុអ្វីការស៊ូទ្រាំមានប្រយោជន៍ ?
បើយើងប្ដេជ្ញាចិត្ដដូចយ៉ូបដែរ នោះនឹងជួយឲ្យយើងរក្សាចិត្ដស្មោះគ្រប់លក្ខណ៍មិនថាជួបនឹងការល្បួង ការប្រឆាំង ឬទុក្ខលំបាកក៏ដោយ ។ ព្រះយេស៊ូមានបន្ទូលប្រាប់បណ្ដាគ្រិស្ដសាសនិ កនៅក្រុម ជំនុំនៅទីក្រុងស្មឺ ន៉ាថា៖ « កុំឲ្យឯងខ្លាចសេចក្ដីដែលឯងត្រូវរងទុក្ខនោះឡើយ មើល !
អារក្សវារៀបនឹងបោះពួកឯងខ្លះទៅក្នុងគុកហើយ ដើម្បីនឹងល្បង លមើលឯង នោះឯងរាល់គ្នានឹងត្រូវរងវេទនា អស់១០ថ្ងៃ ដូច្នេះ ចូរនៅជាស្មោះត្រង់ដរាបដល់ស្លាប់ចុះ នោះអញនឹងឲ្យមកុដនៃជីវិតដល់ឯង » ។ — វិវរណៈ ២: ១០
