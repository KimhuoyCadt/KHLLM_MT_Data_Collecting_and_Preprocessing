ដើរចុះឡើងក្នុងស្រុកនេះ តាមបណ្ដោយនឹងទទឹងចុះ ! »
តើព្រះបង្គាប់ឲ្យអ័ ប្រា ហាំធ្វើអ្វីគួរឲ្យចម្លែកនោះ ?
តើអ្នកចូល ចិត្ដទៅលេងស្រុកស្រែឬជនបទទេ ?
ដ្បិតអញនឹងឲ្យដល់ឯងហើយ » ។ — លោកុប្បត្ដិ ១៣: ១៧
ក្រោយពីអ័ ប្រា ហាំបានចាកចេញពីស្រុកអេ ស៊ី ប តើគាត់បានទៅណា ?
ហេតុ អ្វីបានជាពិបាកឲ្យយើងស្រមៃ គិតអំពីទីកន្លែងដែលអ័ ប្រា ហាំបានដើរចុះឡើងនោះ ?
តើអ្នកដឹងថា ទីកន្លែងផ្សេង ៗនោះមានទំនាក់ទំនងនឹងគ្នាយ៉ាងណាឬទេ ?
កន្លែងនោះជាតំបន់ដែលមនុស្សធ្លាប់រស់នៅ ពោលគឺ មនុស្សដែលរួមចំណែកក្នុងការសម្រេចបទទំនាយមួយនោះពីព្រះ ។
តើអ្វីបានជួយឲ្យសិស្សព្រះគម្ពីរខ្លះទទួលស្គាល់នូវតម្លៃនៃការប្រើផែនទី ?
តែសាំ សុនអាចធ្វើបាន ប៉ុន្ដែតើគាត់បានលីរបស់នោះទៅកន្លែងណា ?
យើងមិនដឹងថា« ភ្នំដែលនៅមុខហេ ប្រុន »នោះស្ថិតនៅកន្លែងណាទេ ប៉ុន្ដែទីក្រុងហេ ប្រុនមានចម្ងាយប្រហែលជា៦០គីឡូម៉ែត្រពីទីក្រុងកា សា ហើយគាត់ក៏ត្រូវឡើងភ្នំទៀត !
។ នេះបានធ្វើឲ្យសត្រូវនោះសុញគំនិតទាំងភ័យរន្ធត់ផង ដល់ម៉្លេះបានជាពួកគេសំឡាប់គ្នាឯងទៅ វិញ ទៅ មក ។ ( ពួក ចៅហ្វាយ ៦: ៣៣ ; ៧: ១-២២ ) តើមានព្រឹត្ដិការណ៍តែប៉ុណ្ណេះឬ ដែលពួកគេត យុទ្ធគ្នាមួយភ្លែតក្នុងមួយយប់តែប៉ុណ្ណោះ ?
មនុស្សខ្លះបើកមើលផែនទីអំពីស្រុកដែលរៀបរាប់ក្នុងព្រះគម្ពីរដើម្បីស្គាល់ទីកន្លែងផ្សេង ៗ ប៉ុន្ដែតើអ្នកគិតថា ផែនទីអាចជួយយើងយល់ធ្លុះនូវចិត្ដគំនិតរបស់មនុស្សបានទេ ?
ហើយហេតុ អ្វីបានជាគួរគប្បីឲ្យយើងរំពឹងគិតអំពីកាលៈទេសៈនោះ ?
សូមពិចារណាចំណុចនេះដោយគិតពីស្ថានភាពដែលទាក់ទងលក្ខណៈភូមិ សា ស្ដ្ រ ។ ប្រសិនបើសាសន៍អ៊ីស្រាអែលបានបង្ហាញជំនឿដោយធ្វើតាមយោបល់របស់យ៉ូស្វេនិងកា លែបនោះ តើពួកគេនឹងត្រូវធ្វើដំណើរឆ្ងាយទើបចូលទៅក្នុងស្រុកសន្យាឬ ?
ស្ដីអំពីបទគម្ពីរគ្រីស្ទានភាសាក្រិច តើហេតុ អ្វីក៏យើងគួរចាប់អារម្មណ៍នឹងភូមិ សា ស្ដ្ រដែរ ?
តើបងប្អូនគ្រីស្ទានពីទីក្រុងបេ រាបានបង្ហាញយ៉ាងណា ថាពួកគាត់មានចិត្ដអបអរចំពោះប៉ុល ?
ពេលដឹងអំពីចម្ងាយពីទីក្រុងអេភេសូរទៅដល់ក្រុងមី លេ ត តើនេះជួយយើងឲ្យយល់ច្បាស់ជាងអំពីអ្វី ?
តើយើងអាចតាំងចិត្ដធ្វើអ្វីស្ដីអំពីទីកន្លែងផ្សេង ៗដែលរៀបរាប់ក្នុងព្រះគម្ពីរ ?
តើគួរគប្បីឲ្យយើងបន្ដយកចិត្ដទុកដាក់នឹងសួនម នោរម្យពីរប្រភេទអ្វី ?
នៅឯមហាសន្និបាតនាឆ្នាំ២០០៣និង២០០៤ ស្ម របន្ទាល់ព្រះយេ ហូវ៉ាមានចិត្ដរីករាយពេលដែលបានទទួលសៀវភៅស្ដើង« ចូរមើលស្រុកល្អ » ។ ប្រកាស ន វត្ថុថ្មីនេះបានត្រូវបោះពុម្ពប្រមាណ៨០ភាសា ហើយពេញទៅដោយផែនទីគ្រប់ពណ៌ដែលបង្ហាញពីទីកន្លែងផ្សេង ៗដែលរៀបរាប់ក្នុងព្រះគម្ពីរ ជាពិសេសស្រុកសន្យាក្នុងកំឡុងគ្រាផ្សេង ៗ ។
វាលច្រកភ្នំយេ សរាល
ភ្នំខាងលិចទន្លេយ័រ ដាន់
ភ្នំទាំងប៉ុន្មាននៅស្រុកសា ម៉ា រី
ភ្នំទាំងប៉ុន្មាននៅស្រុកយូដា
ទី រហោស្ថានប៉ា រ៉ា ន
វាលទំនាបភក់ល្បាប់ហ៊ូ ឡា
តំបន់ជុំវិញសមុទ្រកា លី ឡេ
ជ្រលងទន្លេយ័រ ដាន់
សមុទ្រអំបិល ( សមុទ្រស្លាប់ )
តំបន់អា រ៉ា បា ( ខាងត្បូងសមុទ្រអំបិល )
ខ្ពង់រាបស្រុកអេ ដំម
លោកអ័ ប្រា ហាំបានដើរចុះឡើងក្នុងស្រុកនោះ
កោះសា ម៉ូត្ រាស
ក្រុងអាំ ភី ប៉ូលី
ក្រុងថែស្សា ឡូនីច
ការស្វែងរកមេដឹកនាំល្អម្នាក់
យើងធុញទ្រាន់នឹងលោកហើយ ។ ដោយនូវព្រះនាមព្រះ យើងដេញលោកឲ្យចេញ ! »
។ — ពាក្យរបស់លោកអូ លី វើ ក្រម វែល ដកស្រង់ដោយលោកលី អូ ផូល អេ មើ រី ជាសមាជិកម្នាក់នៃរដ្ឋសភាអង់គ្លេស ។
តើមនុស្សលោកត្រូវ « អត់ទ្រាំ » នឹងមេដឹកនាំមិនគ្រប់ល័ក្ខណ៍ឬ ?
ដោយសារមេដឹកនាំមនុស្សមិនធ្លាប់បំពេញនូវសេចក្ដីត្រូវការរបស់ប្រជានុ រាស្ដ្រឲ្យបានពេញលេញនោះ តើនេះបានន័យថាយើងនឹងមិនអាចរកបានមេដឹកនាំល្អជារៀងរហូតឬ ?
ពិតជាអាចមានមេដឹកនាំដ៏ល្អបំផុតមួយរូបមែន ។ អត្ថបទបន្ដ បន្ទាប់នឹងពិនិត្យមើលអំពីនរណាដែលអាចដឹកនាំមនុស្សជាតិយ៉ាងល្អគ្រប់ល័ក្ខណ៍ ហើយអំពីរបៀបដែលការគ្រប់គ្រងរបស់បុគ្គលនោះនឹងនាំឲ្យមនុស្សរាប់លាននាក់ពីគ្រប់ស្រទាប់វណ្ណៈ រួមទាំងលោកអ្នកផងដែរនឹងទទួលប្រយោជន៍មែន ។
ខាងលើប៉ែកខាងឆ្វេង : លោកនេ វីល ចេ ម ប៊ី លីន
ខាងលើប៉ែកខាងស្ដាំ : លោកលី អូ ផូល អេ មើ រី
សព្វថ្ងៃនេះ តើអ្នកណាសមជាមេដឹកនាំល្អ ?
សំដីរបស់លោកល យ្ឌ ចចសឲ្យឃើញច្បាស់ថា មហាជនចេះតែសង្ឃឹមថាមេដឹកនាំទាំងឡាយមានសមត្ថភាព ហើយក៏សង្ឃឹមថាពួកគេនឹងព្យាយាមយ៉ាងស្មោះអស់ពីចិត្ដក្នុងការធ្វើឲ្យមានការរីកចំរើន ។ បុគ្គលិកម្នាក់ខាងយុទ្ធនាការបោះឆ្នោតបានពន្យល់ថា ៖ « នៅពេលដែលមនុស្សបោះឆ្នោតជ្រើសរើសប្រធានាធិបតី នោះពួកគេកំពុងតែជ្រើសរើសបុគ្គលម្នាក់ដែលនឹងទទួលខុស ត្រូវចំពោះជីវិត អនាគត និងកូនរបស់គេដែរ » ។ ការទទួលបញ្ញើនេះគឺជាភារកិច្ចធ្ងន់ធ្ងរមែន ។ ហេតុអ្វី ?
លោកីយ៍នេះពេញទៅដោយបញ្ហាដែលគ្មានដំណោះស្រាយ ។ ជាឧទាហរណ៍ តើយើងធ្លាប់មានមេដឹកនាំណាម្នាក់ដែលមានប្រាជ្ញានិងអំណាចគ្រប់គ្រាន់ដើម្បីបំបាត់ចោលឧក្រិដ្ឋ កម្មនិងសង្គ្រាមឬទេ ?
ក្នុងចំណោមមេដឹកនាំទាំងឡាយសព្វថ្ងៃនេះ តើមាននរណាម្នាក់មានចិត្ដមេ ត្ដានិងមានធនធានគ្រប់គ្រាន់ដើម្បីផ្ដល់អាហារនិងទឹកដល់មហាជន ព្រមទាំងថែទាំសុខភាពរបស់ពួកគេទាំងអស់គ្នាឬទេ ?
តើអ្នកណាមានចំណេះគ្រប់គ្រាន់ឬបានតាំងចិត្ដការពារនិងជួយធ្វើឲ្យបរិស្ថានបានស្អាតឡើងវិញ ?
តើមានមេដឹកនាំដែលមានសមត្ថភាពនិងអំណាចគ្រប់គ្រាន់ដើម្បីធានាឲ្យមនុស្សជាតិទាំងឡាយមានជីវិតយូរអង្វែងនិងមានសុភមង្គលឬទេ ?
មនុស្សពុំអាចសម្រេចការទាំងនោះបានទេ
មេដឹកនាំខ្លះបានសម្រេចការយ៉ាងល្អពិតមែន ។ ក៏ប៉ុន្ដែ ក្រោយមេដឹកនាំបានកាន់អំណាចអស់មួយរយៈ តើអ្នកណានឹងទទួលអំណាចជំនួសគាត់វិញ ?
មេដឹកនាំដ៏ល្បីម្នាក់នៅប្រទេសអ៊ីស្រាអែលពីសម័យបុរាណ នាមសាឡូម៉ូន បានត្រិះរិះពិចារណាសំនួរនេះដែរ ។ ស្ដេចសាឡូម៉ូនបានសន្និដ្ឋានថា ៖ « យើងបានស្អប់បណ្ដាការនឿយហត់ទាំងប៉ុន្មានដែលយើងបានខំធ្វើនៅក្រោមថ្ងៃ ដោយយល់ឃើញថាយើងត្រូវទុកទាំងអស់ឲ្យដល់មនុស្សដែលបន្ដក្រោយយើង ។ ហើយតើមានអ្នកណាដឹងពីអ្នកនោះ ថានឹងត្រឡប់ជាមនុស្សមានប្រាជ្ញា ឬជាមនុស្សល្ងីល្ងើវិញ ?
ប៉ុន្ដែអ្នកនោះ នឹងគ្រប់គ្រងលើអស់ទាំងការដែលយើងបានខំធ្វើ ជាការដែលបានធ្វើ ដើម្បីសំដែងខ្លួនជាអ្នកមានប្រាជ្ញានៅក្រោមថ្ងៃ ។ នេះក៏ឥតមានទំនងដែរ » ។ — សាស្តា ២: ១៨, ១៩
ស្ដេចសាឡូម៉ូនមិនដឹងថាអ្នកស្នងរាជ្យក្រោយទ្រង់នឹងចំរើនការល្អដែលទ្រង់បានធ្វើ ឬនឹងបំផ្លាញការល្អនោះវិញ ។ ស្ដេចសាឡូម៉ូនបានចាត់ទុកបំ លាស់ប្ដូរអ្នកគ្រប់គ្រងថ្មីជាការ « ឥតមានទំនង » ។ សេចក្ដីបកប្រែផ្សេងទៀតនៃព្រះគម្ពីរបរិសុទ្ធហៅបំ លាស់ប្ដូរនេះជាអ្វីដែល « ឥតបានការ » ឬ « គ្មានបំណង » ។ សេចក្ដីបកប្រែមួយទៀតចែងថា ៖ « ជាអ្វីដែលយើងរកយល់ពុំបានឡើយ » ។
មេដឹកនាំណា សូម្បីតែមនុស្សដ៏ល្អបំផុតក្ដី ក៏មិនអាចធានាអនាគតរបស់ខ្លួនគេផ្ទាល់បានឡើយ ។ បើដូច្នេះ តើអ្នកគួរទុកចិត្ដលើពួកគេឲ្យធានាអនាគតរបស់អ្នកឬទេ ?
ប្រហែលជាលោកអ្នកពិបាកយល់ស្របនឹងយោបល់ដែលថា កុំឲ្យទុកចិត្ដនឹងមនុស្សដែលធ្វើជាមេដឹកនាំ ។ យ៉ាងណាក៏ដោយ ព្រះគម្ពីរមិនចែងថា លោកីយ៍នឹងមិនមានការដឹកនាំល្អដែលស្ថិតស្ថេររហូតនោះទេ ។ ដ្បិតអេសាយ ៣២ : ១ ចែងថា ៖ « មើល !
នឹងមានស្ដេច១អង្គសោយរាជ្យដោយសុចរិត » ។ ក្នុងនាមជាព្រះដែលបានបង្កើតមនុស្សជាតិ ព្រះយេ ហូវ៉ាបានរៀបចំឲ្យមាន « ស្ដេច១អង្គ » ជាមេដឹកនាំដែលឆាប់ ៗ ខាងមុខនេះនឹងចាត់ចែងការទាំងអស់នៅលើផែនដី ។ តើទ្រង់ជាអ្នកណា ?
បទទំនាយក្នុងព្រះគម្ពីរអាចជួយសម្គាល់ទ្រង់បាន ។
បុគ្គលមួយរូបដែលសមជាមេដឹកនាំមែន
ព្រះយេស៊ូបានរក្សាចិត្ដស្មោះភក្ដីយ៉ាងគ្រប់ល័ក្ខណ៍ ។ ព្រះយេស៊ូមានចរិយាដ៏ល្អត្រឹមត្រូវនិងទៀង ត្រង់ដល់ម៉្លេះបានជាទ្រង់ឲ្យឱកាសដល់មារសត្រូវរកហេតុដើម្បីចោទប្រកាន់ទ្រង់ តែពួកគេរកហេតុមិនបានសោះ ។ ដោយការបង្រៀនរបស់ព្រះយេស៊ូដូចនឹងការប្រព្រឹត្ដនោះបានជំរុញចិត្ដមនុស្សស្មោះសជាច្រើននាក់ឲ្យក្លាយជាអ្នកកាន់តាមទ្រង់ ។ — យ៉ូហាន ៧: ៤៦; ៨: ២៨-៣០; ១២: ១៩
ព្រះយេស៊ូយកព្រះទ័យទុកដាក់យ៉ាងជ្រាលជ្រៅចំពោះមនុស្ស ។ ព្រះយេស៊ូបានប្រទានអាហារដល់មនុស្សស្រេកឃ្លាន ។ ទ្រង់បានជួយសំរាលទុក្ខមនុស្សដែលអស់សង្ឃឹម ។ ព្រះយេស៊ូបានប្រោសអ្នកខ្វាក់ឲ្យមើលឃើញ មនុស្សថ្លង់ឲ្យស្តាប់ឮ ហើយទ្រង់ក៏បានប្រោសអ្នកជំងឺឲ្យជាផងដែរ ។ ទ្រង់បានលើកទឹកចិត្ដពួកសាវ័ករបស់ទ្រង់ដែលធ្វើការយ៉ាងនឿយហត់ ។ ( យ៉ូហាន ជំពូក១៣-១៧) ព្រះយេស៊ូពិតជា « អ្នកគង្វាលល្អ » ដែលចេះថែរក្សាចៀមទ្រង់ ។ — យ៉ូហាន ១០: ១១-១៤
ព្រះយេស៊ូក៏បានចុះប្រឡូកដោយផ្ទាល់ដែរ ។ ព្រះយេស៊ូបានលាងជើងរបស់ពួកសាវ័កដើម្បីបង្រៀនមេរៀនដ៏សំខាន់មួយ ។ ពេលដែលព្រះយេស៊ូដើរផ្សព្វផ្សាយដំណឹងល្អតាមផ្លូវនៅស្រុកអ៊ីស្រាអែល ព្រះបាទរបស់ទ្រង់ផ្ទាល់ក៏ប្រឡាក់ដីដែរ ។ សូម្បីតែពេលដែលព្រះយេស៊ូចង់សំរាកនៅ « ឯទីស្ងាត់ដោយឡែក » ទ្រង់សព្វព្រះហឫទ័យធ្វើតាមសំណូមពររបស់បណ្ដា ជនដែលចង់បានការណែនាំថែមទៀត ។ ដោយធ្វើដូច្នេះ ព្រះយេស៊ូបានតាំងគំរូជាអ្នកខ្នះ ខ្នែងឲ្យគ្រីស្ទានទាំងឡាយយកត ម្រាប់តាម ។ — យ៉ូហាន ទី១ ២: ៦
