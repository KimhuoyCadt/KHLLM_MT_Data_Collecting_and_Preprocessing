( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ ក្នុង សង្កាត់ កាកាប២ រាជធានី ភ្នំពេញ ទទួលបាន អំណោយ ពី អនុ សាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី ជួល សម្រួល ដល់ ជីវភាព ក្នុង អំឡុង ពេល វិបត្តិ ជំងឺ កូវីដ១៩ កំពុង រីករាលដាល ។
ពិធី ចែក អំណោយ នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២១ ក្រោម វត្តមាន លោក ហែម ដារិទ្ធ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ និង ជា ប្រធាន ប្រធាន កិត្តិយស អនុសាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ពោធិ៍សែនជ័យ រួម និង ក្រុមការងារ អនុសាខា ជាច្រើន នាក់ នៅ បរិវេណ វត្ត តាំង ក្រសាំង ខាងជើង ស្ថិត ក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
លោក ហែម ដារិទ្ធ បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ដល់ គ្រួសារ ទាំងអស់ ប្រកបដោយ សេចក្តីនឹករលឹក ។
លោក ក៏ សូម អំពាវនាវ ដល់ គ្រួសារ ទាំងអស់ បន្ត ការប្រុងប្រយត្ន័ បន្ថែម ទៀត និង ជាពិសេស សូម បន្ត អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ វិធានការ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា គឺ « ៣ការពារ និង ៣កុំ » ដើម្បី ចូលរួម ទប់ស្កាត់ និង ការពារ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ទាំងអស់ គ្នា ។
គួស បញ្ជាក់ ថា អំណោយ មនុស្សធម៌ ដែល ផ្តល់ ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ ក្នុង សង្កាត់ កាកាប២ រាជធានី ភ្នំពេញ នា ពេលនេះ ក្នុង ១គ្រួសារ ៗ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម មី មួយ កេស ទឹក ស៊ីវ អ៊ីវ១យួរ ត្រីខ១យួរ រួម និង ថវិកា ៣០០០០ រៀល ផងដែរ ៕ កាកបាទ ក្រហម ខេត្ត កម្ពុជា កំពង់ចាម ប្រគល់ ផ្ទះ ១ខ្នង ដល់ ស្ត្រី មេម៉ាយ ក្រីក្រ មួយ គ្រួសារ និង មាន កូន ក្នុង បន្ទក ២នាក់ នៅ ស្រុក បាធាយ
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន សាខា កាកបាទ ក្រហម ខេត្ត នៅ ព្រឹក ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២១ បាន ដឹកនាំ សហការី រួម ជាមួយ មេ គណ ខេត្ត ចុះ ប្រគល់ ផ្ទះ មនុស្សធម៌ ១ខ្នង ជូន ស្ត្រី មេម៉ាយ ទីទ័ល ក្រ ១នាក់ ឈ្មោះ ឆៃ អ៊ូ អាយុ ៤៥ ឆ្នាំ រស់ នៅ ភូមិ ប្រយុគ ឃុំ ទំនប់ ស្រុក បាធាយ ។
លោក ទូច ឆៃ បាន បន្ត ថា ស្ត្រី រូប នោះ ក្រៅពី ការជួយ ឧបត្ថម្ភ របស់ រាជ រដ្ឋាភិបាល តាមរយៈ ប័ណ្ណ សមធម៌ ក្រមួយ គាត់ ត្រូវ ដើរ រើស អេត ចាយ និង ជួយ លាង ចាន ឆ្នាំង តាម ផ្ទះ គេ គ្រាន់ បាន កម្រៃ ប្រចាំ ថ្ងៃ ចិញ្ចឹម កូន តូច ៗ ទាំង ២នាក់ ។
ដោយ បាន ដឹង អំពី ស្ថានភាព លំបាក នេះ ទើប លោក អ៊ុន ចាន់ ដា ប្រធាន គណៈកម្មាធិការ សាខា បាន សម្រេច ផ្តល់ ជូន ផ្ទះ ឈើ ខ្ពស់ ផុត ពី ដី ប្រក់ ស័ង្កសី ទំហំ ៤ម គុណ៦ម៉ែត្រ ចំនួន មួយ ខ្នង តម្លៃ ៩.៨០០.០០០ រៀល ជា ថវិកា បដិភាគ របស់ សាខា សាលា គណៈ អនុសាខា ស្រុក សាលា អនុគណ ចៅអធិការ វត្ត និង សប្បុរសជន ជូន ស្ត្រី ឆៃ អ៊ូ សម្រាប់ ស្នាក់ នៅជា កម្មសិទ្ធិត ទៅ ។
ដោយឡែក ប្រជាពលរដ្ឋ ខ្វះខាត ជីវភាព ចំនួន ១២គ្រួសារ ទៀត ដែល បាន ចូលរួម នា ពេល នោះ ក៏ ទទួលបាន អំណោយ មនុស្សធម៌ ក្នុង មួយ គ្រួសារ រួម មាន៖ អង្ករ . ត្រីខ. ឃីត . មី . ទឹកត្រី . ទឹកស៊ីអ៊ីវ និង អាវយឺត ព្រមទាំង ថវិកា ចំនួន ២០.០០០ រៀល ផងដែរ ៕ ក្រសួង ការបរទេស ប្រកាស ពី លទ្ធផល សន្និសីទ ក្រោយ កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន ជាមួយ កូរ៉េ ចិន និង ជប៉ុន និង កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន បូក បី លើក ទី ២២
( ភ្នំពេញ ) ៖ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា នៅ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២១ បាន អញ្ជើញ ចូលរួម ក្នុង សន្និសីទ ក្រោយ កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន ជាមួយ សាធារណរដ្ឋ កូរ៉េ សាធារណរដ្ឋ ប្រជាមានិត ចិន និង ជប៉ុន និង កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន បូក បី លើក ទី ២២ តាម ប្រព័ន្ធ វីដេអូ ។
ខាងក្រោម នេះ ជា លទ្ធផល សន្និសីទ ក្រោយ កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន ជាមួយ សាធារណរដ្ឋ កូរ៉េ សាធារណរដ្ឋ ប្រជាមានិត ចិន និង ជប៉ុន និង កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន បូក បី លើក ទី ២២ ដែល ប្រកាស ដោយ ក្រសួង ការបរទេស កម្ពុជា៖ និយ័តករ គណនេយ្យ និង សវនកម្ម ប្រកាស ពី ការប្រើប្រាស់ និមិត្ត សញ្ញា និង ត្រា របស់ ខ្លួន ជា ផ្លូវការ
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្ដីជូនដំណឹង របស់ និយ័តករ គណនេយ្យ និង សវនកម្ម ខាងក្រោម៖ រយៈពេល មួយ ខែ យុទ្ធនាការ « ទឹកចិត្ត កម្ពុជា » ឧបត្ថម្ភ ទឹក បរិសុទ្ធ ជូន កម្លាំង ចម្រុះ ឈរ ជើង ប្រចាំ ការជិត ២០០ គោលដៅ
( ភ្នំពេញ ) ៖ នៅក្នុង រយៈពេល ពេញ មួយ ខែកក្កដា ឆ្នាំ ២០២១ យុទ្ធនាការ « ទឹកចិត្ត កម្ពុជា » បាន បរិច្ចាគ ទឹក បរិសុទ្ធ កម្ពុជា ជូន កម្លាំង ចម្រុះ ដែល កំពុង ឈរជើង យាម កាម សរុប ជិត ២០០ គោលដៅ ក្នុង ប្រទេស កម្ពុជា ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ការរាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ ។
នេះ គឺជា ការបរិច្ចាគ ប្រចាំ ខែ ជូន ដល់ គោលដៅ នៅ ទូទាំង ២៥ ខេត្ត ក្រុង ដើម្បី លើកទឹកចិត្ត ការចូលរួម ក្នុង សកម្មភាព កិច្ចការ សង្គម និង ផ្តល់ កម្លាំងចិត្ត ដល់ កម្លាំង ចម្រុះ ដែល ខិតខំ បំពេញ ភារកិច្ច យ៉ាង សស្រាក់សស្រាំ ជាពិសេស ក្នុង ស្ថានភាព នា ពេលនេះ ។ ក្រុមហ៊ុន ក៏ នឹង បរិច្ចាគ បន្ថែម ទៀត សម្រាប់ ខែសីហា ឆ្នាំ ២០២១ ។
គួរ បញ្ជាក់ ថា ក្រៅពី ការបរិច្ចាគ ខាងលើ យុទ្ធនាការ « ទឹកចិត្ត កម្ពុជា » ក៏ បាន ឧបត្ថម្ភ ទឹក បរិសុទ្ធ កម្ពុជា និង ភេសជ្ជៈ ជាច្រើន ម៉ឺន កេស ជូន ស្ថាប័ន ផ្សេង ៗ ដើម្បី ប្រើប្រាស់ ក្នុង បេសកកម្ម ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ ផងដែរ ៕
អ្នកភូមិ ឈើ ទាល២ ស្រុក កៀនស្វាយ ចំនួន ១៤៣ នាក់ រងគ្រោះ ដោយសារ គេ កាយ ផ្ដាច់ ផ្លូវ សាធារណ: មិន អាច ធ្វើដំណើរ បាន ស្នើសុំ អភិបាល ខេត្ត កណ្ដាល ជួយ ដោះស្រាយ បញ្ហា នេះ ផង
( កណ្តាល ) ៖ បន្ទាប់ពី ឈ្មោះ ចាន់ វិទូ ជា មន្ត្រី នគរបាល នៅ ក្រសួង មហាផ្ទៃ បញ្ជា ឲ្យ កូន ចៅ កាយ ផ្តាច់ ផ្លូវ សាធារណ: មិន ឲ្យ ពលរដ្ឋ ធ្វើដំណើរ រួច មក ក្រុម ប្រជាពលរដ្ឋ ទាំង ១៤៣ នាក់ បាន ស្នើសុំ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល ជួយ ដោះស្រាយ បញ្ហា នេះ ផង ។
លោក បន្ត ថា ផ្លូវ នេះ ពួកគាត់ ប្រើប្រាស់ សម្រាប់ ធ្វើដំណើរ ទៅ នេសាទ ត្រី ដក ព្រលឹត ដក ក្រអៅ ឈូក បេះ ត្រកួន និង ស្លឹក ឈូក នៅ បឹង ធំ ព្រមទាំង ធ្វើដំណើរ ទៅកាន់ ទី សក្ការៈបូជា កំពង់ រទេះ កោះ លៀស និង កោះ ស្លែង អណ្តែត ត តាំងពី ដូនតាម កម្ល៉េះ ។ សូម្បីតែ អាជ្ញាធរ ក៏ ទទួលស្គាល់ ដែរ មិន ដែល កើតមាន បញ្ហា អ្វី នោះ ទេ ហើយ កន្លងមក ដោយសារតែ ឃើញ ផ្លូវ នេះ ទាប លិច ទឹក ពិបាក ធ្វើដំណើរ ក៏ មាន សប្បុរ ជន បាន ជួយ ចេញ ប្រាក់ ដើម្បី ចាក់ ដី បំពេញ ស្រួល ធ្វើដំណើរ ធ្វើឱ្យ ពួកគាត់ សប្បាយ ចិត្ត ណាស់ ។
លោក បញ្ជាក់ ទៀត ថា ស្រាប់តែ កាលពី ថ្ងៃទី ១៩ ខែកក្ត ដា កន្លងទៅ នេះ លោក ចាន់ វិទូ ដែល ជា ម្ចាស់ អាជីវកម្ម បូម ខ្សាច់ នៅក្បែរ ផ្លូវ មួយ ខ្សែ នេះ បាន បញ្ជា ឱ្យ កូន ចៅ យក អេស្កាវ៉ា កាយ ផ្តាច់ ផ្លូវ នេះ ធ្វើឱ្យ ពួកគាត់ មិន អាច ដំណើរ បាន ទើប បានជា ពួកគាត់ ដាក់ ពាក្យ បណ្តឹង ទៅកាន់ សាលា ឃុំ ឈើ ទាល និង សាលា ស្រុក កៀនស្វាយ ។
លោក អះអាង ទៀត ថា លុះ នៅ រសៀល ថ្ងៃទី ៣១ ខែកក្ត ដា ឆ្នាំ ២០២១ អាជ្ញាធរ ស្រុក បាន ដឹកនាំ គ្រឿងចក្រ ទៅកាយ លុប ផ្លូវ នោះ ឡើងវិញ ប៉ុន្តែ បន្តិច ក្រោយមក ក៏ ត្រូវ ផ្អាក វិញ ដោយ មន្ត្រី ប្រាប់ ថា មាន អន្តរាគមន៍ ពី ថ្នាក់ លើ ។ បើ ផ្លូវ នេះ ត្រូវ កាត់ផ្តាច់ ពួកគាត់ គ្មាន ផ្លូវ សម្រាប់ ធ្វើដំណើរ ទៅ បឹង ប្រកបរបរ ចិញ្ចឹម ជីវិត និង មិន អាច ទៅកាន់ ទី សក្ការៈបូជា បាន ឡើយ ដូច្នេះ សូម ថ្នាក់ លើ មេត្តា អន្តរាគមន៍ ឱ្យ ឈ្មួញ កាយ លុប ផ្លូវ ឱ្យ បាន ដូច ដើម វិញ ផង ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការបន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៥៨៣ នាក់ ខណៈ អ្នកជំងឺ ៦៥៨ នាក់ ជាសះស្បើយ ។
សូម ជម្រាប ថា គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៧៩. ៦៣៤ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ សរុប ចំនួន ៧២. ៨០៣ នាក់ និង ស្លាប់ សរុប ចំនួន ១. ៤៨៨ នាក់ ៕ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ទទួលបាន បំពង់ អុកស៊ីហ្សែន ១០បំពង់ ពី សប្បុរសជន សម្រាប់ ជួយសង្គ្រោះ អ្នកជំងឺ ធ្ងន់ធ្ងរ
( កំពង់ឆ្នាំង ) ៖ ដោយ មើលឃើញ ពី ស្ថានភាព អ្នកជំងឺ កូវីដ១៩ ចូល សម្រាក ក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង មាន ចំនួន ច្រើន ឡើង ៗ និង ខ្វះ ឧបករណ៍ បំពង់ អុកស៊ីហ្សែន លោក ឧកញ៉ា លី ម៉ាន នៅ ព្រឹក ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២១ នេះ តាមរយៈ កូនប្រុស របស់ លោក បាន នាំយក បំពង់ អុកស៊ីហ្សែ ១០បំពង់ ប្រគល់ ជូន មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ដើម្បី រួមចំណែក ជាមួយ មន្ទីរពេទ្យ ក្នុង ការជួយសង្គ្រោះ ដល់ ពលរដ្ឋ ដែល ត្រូវការ ជំនួយ ខ្យល់ អុកស៊ីហ្សែន ។
កូនប្រុស លោក ឧកញ៉ា លីម៉ាន បាន បញ្ជាក់ ប្រាប់ ថា រយៈពេល ថ្មី ៗ កន្លងទៅ នេះ ឪពុក របស់ លោក បាន ជួយ បំពង់ អុកស៊ីហ្សែន ដល់ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ៥បំពង់ ម្ដង រួច មកហើយ តែ ជា តម្រូវការ ខាង មន្ទីរពេទ្យ ត្រូវការ បំពង់ អុកស៊ីហ្សែន ជាច្រើន ទៀត ដើម្បី សង្គ្រោះ អ្នកជំងឺ កូវីដ - ១៩ នៅ តាម មណ្ឌល ព្យាបាល ជាច្រើន មណ្ឌល ក្នុង ខេត្ត កំពង់ឆ្នាំង ទើប ឪពុក របស់ លោក បាន ជួយ បំពង់ អុកស៊ីហ្សែន ចំនួន ១០បំពង់ បន្ថែម ទៀត ។
លោក វេជ្ជបណ្ឌិត ទុំ សម្បត្តិ ប្រធាន មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង បាន កោតសរសើរ នូវ ទឹកចិត្ត សប្បុរសធម៌ របស់ លោក ឧកញ៉ា លី ម៉ាន ដែល បាន រួមចំណែក ជាមួយ មន្ទីរ ពេទ្យ ក្នុង ការជួយ ឧបត្ថម្ភ បំពង់ អុកស៊ីហ្សែន ពីរ លើក ដែល មាន បំពង់ អុកស៊ីហ្សែន សរុប ១៥ បំពង់ ជួយសង្គ្រោះ ដល់ អ្នកជំងឺ ទូទៅ នៅក្នុង មន្ទីរពេទ្យ ដែល ត្រូវការ ខ្យល់ អុកស៊ីហ្សែន ដើម្បី ជំនួយ ផ្លូវ ដង្ហើម ។
ក្រសួង សុខាភិបាល ថៃ បាន គូសបញ្ជាក់ ថា ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ២០. ០១៣ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ថៃ ទូទៅ និង ១៨៧ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ អ្នកជំងឺ ចំនួន ១៨៨ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ នៅក្នុង កំលុង ពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ១៧. ៩៧៥ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាត ឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ពលរដ្ឋ មួយចំនួន នៅ ស្រុក អង្គរ ធំ មិន ទាន់ ទៅ ចាក់ វ៉ាក់សាំង . លោក ស ថា វី អំពាវនាវ អាជ្ញាធរ ចុះ ជំរុញ អ្នក នៅ សេសសល់ ទៅ ចាក់ វ៉ាក់សាំង
( សៀមរាប ) ៖ ប្រជាពលរដ្ឋ ជាង ៣ពាន់ នាក់ ទៀត នៅក្នុង ស្រុក អង្គរ ធំ ខេត្ត សៀមរាប មិន ទាន់ ទៅ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នៅឡើយ ។ លោក ឧត្តមសេនីយ៍ ឯក ស ថា វី អនុ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុម សម្របសម្រួល ការងារ ចាក់ វ៉ាក់សាំង ស្រុក អង្គរ ធំ បាន អំពាវនាវ ដល់ អាជ្ញាធរ ចុះ ជួយ ជំរុញ អ្នក មិន ទាន់ បាន ចាក់ នោះ ឱ្យ ទៅ ចាក់ វ៉ាក់សាំង ឱ្យ បាន គ្រប់ គ្នា ។
ក្រុមការងារ ចាក់ វ៉ាក់សាំង របស់ ក្រសួង ការពារ ជាតិ បាន ចាប់ផ្តើម ដំណើរការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូសទី១ ជូន ប្រជាពលរដ្ឋ ក្នុង ស្រុក អង្គរ ធំ កាលពី ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០២១ កន្លងទៅ នេះ ។ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដំណាក់កាល ទី១ បាន បិទ បញ្ចប់ ហើយ នៅ សប្តាហ៍ កន្លងទៅ ។
ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ចាក់ វ៉ាក់សាំង ក្នុង សប្តាហ៍ នេះ លោក ឧត្តមសេនីយ៍ ឯក ស ថា វី បាន ឱ្យដឹង ថា ប្រជាពលរដ្ឋ ក្នុង ស្រុក អង្គរ ធំ ដែល ត្រូវ ចាក់ វ៉ាក់សាំង មាន ចំនួន ប្រមាណ ១៧. ៨៦៣ នាក់ ។ ប៉ុន្តែ អ្នក មក ចាក់ វ៉ាក់សាំង មាន ចំនួន ត្រឹមតែ ១៥.៤០០ នាក់ ប៉ុណ្ណោះ ។
តាម ទិន្នន័យ នេះ មាន ប្រជាពលរដ្ឋ ជាង ២ពាន់ នាក់ ទៀត មិន ទាន់ បាន មក ចាក់ វ៉ាក់សាំង នៅឡើយ ។ ក្នុង កិច្ចប្រជុំ បូកសរុប ការងារ ចាក់ វ៉ាក់សាំង នោះ លោក ឧត្តមសេនីយ៍ ឯក ស ថា វី ដែល បាន ឈរជើង ជួយ សម្របសម្រួល ការចាក់ វ៉ាក់សាំង នោះ បាន ស្នើ ដល់ អាជ្ញាធរ មូលដ្ឋាន ជួយ រក អ្នក មិន ទាន់ បាន ចាក់ វ៉ាក់សាំង ហើយ ជំរុញ ពួកគាត់ មក ចាក់ វ៉ាក់សាំង ឱ្យ បាន គ្រប់ គ្នា ។
« នេះ ជា ការសោកស្តាយ មួយ ដែល ប្រជាពលរដ្ឋ យើង មិន បាន មក ចាក់ វ៉ាក់សាំង ។ យើង ត្រូវ បន្ត អប់រំ ណែនាំ និង ជំរុញ ពួកគាត់ មក ចាក់ វ៉ាក់សាំង ឱ្យ បាន គ្រប់ គ្នា ។ បើ យើង ចាក់ ជូន ពួកគាត់ មិន បាន គ្រប់ គ្នា ទេ យើង មិន អាច បង្កើត ភាពសុាំ ក្នុង សហគមន៍ ដើម្បី ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ បាន ឡើយ » ។ នេះ ជា ការលើកឡើង របស់ លោក ឧត្តមសេនីយ៍ ឯក ស ថា វី ក្នុង កិច្ចប្រជុំ បូកសរុប ការងារ នោះ ។
បើ ទោះជា យ៉ាងណា លោក ស ថា វី បាន វាយតម្លៃ ថា ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដំណាក់កាល ទី១ រយៈពេល ជិត ២០ ថ្ងៃ នៅក្នុង ស្រុក អង្គរ ធំ ទទួលបាន លទ្ធផល ល្អ ប្រសើរ គួរឱ្យ កត់សម្គាល់ ។
ក្នុង នាម ជា ប្រធាន សម្របសម្រួល ការងារ ចាក់ វ៉ាក់សាំង នេះ លោក ស ថា វី បាន ថ្លែង កោតសរសើរ ក្រុមការងារ ចាក់ វ៉ាក់សាំង នៃ អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង ក្រសួង ការពារ ជាតិ ដែល បាន ប្រឹងប្រែង យ៉ាង យកចិត្តទុកដាក់ លើ ការងារ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ។
លោក ស ថា វី ក៏ បាន ថ្លែងអំណរគុណ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ បាន ជួយ សម្របសម្រួល ការងារ ចាក់ វ៉ាក់សាំង . អរគុណ ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី ដែល បាន ចូលរួម គាំទ្រ យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង របស់ រដ្ឋបាល មូលដ្ឋាន ហើយ បាន ទៅ ចាក់ វ៉ាក់សាំង ក្នុង ចំនួន មួយ ដ៏ ច្រើន ។
( កណ្ដាល ) ៖ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត កណ្ដាល នៅ ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចាត់ តំណាង នាំយក ប្រគល់ រថយន្ត សង្គ្រោះ បន្ទាន់ ចំនួន ២គ្រឿង . អាល់កុល ១០កេស . ម៉ាស់ ចំនួន ១ម៉ឺន និង ថវិកា ចំនួន ២០ លាន រៀល ដល់ រដ្ឋបាល ខេត្ត កណ្ដាល ដើម្បី ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
តំណាង លោក អគ្គ បណ្ឌិត ក៏ បាន ពាំនាំ ការកោតសរសើរ របស់ លោក អគ្គ បណ្ឌិត ដល់ លោក អភិបាល ខេត្ត និង ក្រុម មន្ត្រី ទាំងអស់ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ត ស៊ូ ប្រឹងប្រែង យ៉ាង ស្វាហាប់ ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ១៩ ព្រមទាំង ព្យាបាល អ្នកជំងែ កូវីដ១៩ ឱ្យ ជាសះស្បើយ កាន់តែ ច្រើន ឡើង ៗ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។
នៅក្នុង ពិធី ប្រគល់ - ទទួល នេះ លោក គង់ សោភ័ណ្ឌ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ លោក អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី និង លោកស្រី ដែល តែងតែ ឧបត្ថម្ភ ជា បន្តបន្ទាប់ ជូន រដ្ឋបាល ខេត្ត កណ្តាល ដើម្បី ដោះស្រាយ បញ្ហា ចំពោះ ដែល បណ្តាល មកពី ជំងឺ កូវីដ១៩ នេះ ។
គួរ ជម្រាប ថា លោក អគ្គ បណ្ឌិត បាន ឧបត្ថម្ភ ជួយ មកដល់ រដ្ឋបាល ខេត្ត កណ្ដាល យ៉ាង ច្រើន ក្រាស់ក្រែល ចាប់តាំងពី កើត ជំងឺ កូវីដ១៩ មក ម្ល៉េះ ៕
ក្រសួង រ៉ែ ទទួលបាន ថ្នាំ គ្រាប់ ចិន ចំនួន ៥ម៉ឺន ប្រអប់ ពី សមាគម ឧស្សាហកម្ម ស៊ីម៉ង់ត៍ កម្ពុជា ដើម្បី យក ទៅ ចែកជូន ប្រជាពលរដ្ឋ
រដ្ឋមន្រ្ដី ស៊ុយ សែម បាន គូសបញ្ជាក់ ថា ក្រសួង នឹង យក ថ្នាំ គ្រាប់ ចិន ទាំងអស់ នេះ ទៅ ចែកជូន ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត ពោធិ៍សាត់ ក្នុង គោលបំណង ដើម្បី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរីករាល នៃ ជំងឺ កូវីដ - ០៩ ។
