( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៤ករណី និង ជួញដូរ ៧ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ២៦ នាក់ ។
សម្តេច ក្រឡាហោម ស ខេង៖ ក្រសួង នឹង កំណត់ ចំនួន នគរបាល ប៉ុស្តិ៍ ឃុំ - សង្កាត់ ឡើងវិញ ឱ្យ បាន សមស្រប លើ កត្តា ភូមិសាស្ត្រ និង កត្តា ប្រជាសាស្ត្រ
( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន ឱ្យដឹង ថា ក្រសួង ក៏ នឹង មាន ការគិតគូរ បន្ថែម ទៀត ដូចជា ការវិភាគ ក្របខណ្ឌ និង មុខងារ ឱ្យ បាន សមស្រប ដោយ ផ្អែក លើ កត្តា ភូមិសាស្រ្ត និង ប្រជាសាស្រ្ត ពោលគឺ ផ្អែក លើ ចំនួន ប្រជាពលរដ្ឋ តិច ឬ ច្រើន និង វិសាលភាព ទឹកដី រដ្ឋបាល នោះ ធំ ឬ តូច ឬ មាន ភាពស្មុគស្មាញ ជាដើម ដើម្បី ដាក់ពង្រាយ បរិមាណ កងកម្លាំង ឱ្យ ត្រូវ នឹង ស្ថានភាព ជាក់ស្ដែង ។
បន្ថែម ពី នេះ សម្ដេច ក្រឡាហោម ក៏ បាន លើកឡើង ដែរ អំពី ការបណ្ដុះបណ្ដាល ធនធាន មនុស្សជា « មន្រ្តី ស្មៀន ឃុំ សង្កាត់ និង មន្រ្តី កងកម្លាំង នគរបាល នៅ មូលដ្ឋាន ព្រមទាំង បាន បន្ថែម ថា អធិការដ្ឋាន នគរបាល និង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ។
សម្ដេច ក្រឡាហោម ស ខេង ទទួលស្គាល់ ថា នៅ ភ្នំពេញ នគរបាល ប៉ុស្តិ៍ មាន ការខ្វះខាត និង ទទួលខុសត្រូវ បំពេញ ការងារ ច្រើន ដែល ទាមទារ ឱ្យ មាន ការគិតគូ ឡើងវិញ ។
យ៉ាងណា សម្ដេច បាន គូសបញ្ជាក់ ថា កិច្ចការ ដែល នៅ សេសសល់ ប្រមាណ ៥០ ភាគរយ នោះ គឺ ការសាងសង់ អគា រដ្ឋបាល សាលា ឃុំ សង្កាត់ ។
សម្ដេច ក្រឡាហោម ក៏ បាន លើកឡើង ថា កន្លងមក សម្ដេចក៏ បាន ណែនាំ ឱ្យ មាន ការគិតគូរ អំពី អង្គភាព នីមួយ ៗ នៅ ថ្នាក់ ក្រសួង តើ មាន តម្រូវការមន្រ្តី នគរបាល ប៉ុន្មាន នាក់ ឱ្យ ពិតប្រាកដ ដើម្បី ដាក់ មន្រ្តី ឱ្យ សមល្មម ហើយ រំលែក ក្របខណ្ឌ នេះ ទៅ ឱ្យ ប៉ុស្តិ៍ រដ្ឋបាល ឃុំ សង្កាត់ និង អធិការដ្ឋាន នគរបាល វិញ ។ ចំណុច នេះ សម្ដេច បាន សង្កត់ធ្ងន់ ថា ជា វិធានការ កាត់បន្ថយ ការស្នើសុំ ក្របខណ្ឌ បន្ថែម សម្រាប់ កងកម្លាំង នគរបាល ជាតិ ពី រាជ រដ្ឋាភិបាល ។
សម្ដេចក៏ បាន បន្ថែម ថា បញ្ហា ដែល កំពុង ដោះស្រាយ នេះ មិន មែន កើតឡើង ដោយសារ កំហុស នរណា ម្នាក់ នោះ ទេ ពីព្រោះ កម្ពុជា បាន ឆ្លងកាត់ ប្រវត្តិសាស្រ្ត ដែល រដ្ឋ ចាប់ផ្ដើម បំពេញ ការងារ ជាមួយនឹង ភាពខ្វះខាត ធនធាន មនុស្ស ទើប បណ្ដាលឱ្យ ជួប ស្ថានភាពខ្វះ តែ សល់ ពោលគឺ ខ្វះ អ្នក មាន សមត្ថភាព ធ្វើ ការ តែ សល់ អ្នក មិន មាន សមត្ថភាព ធ្វើ ការ ៕
អភិបាល ខេត្ត កំពង់ធំ ជំរុញ ពលរដ្ឋ ឱ្យ បន្ត ចូលរួម បង្ការ ជំងឺ កូវីដ១៩
( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន ជំរុញ ដល់ ប្រជាពលរដ្ឋ ឱ្យ បន្ត ចូលរួម បង្ការ ជំងឺ កូវីដ១៩ ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ទៅ ទទួល ចាក់ វ៉ាក់សាំង អោយ បាន គ្រប់ ៗ គ្នា ដោយ ស្ម័គ្រចិត្ត ។
ការថ្លែង ដូច្នេះ នៅក្នុង ឱកាស ដែល លោក និង សហការី បន្ដ ចុះ បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ- ១ ជូន ប្រជាពលរដ្ឋ រស់ នៅក្នុង ស្រុក សណ្តាន់ ស្រុក ប្រាសាទ សំបូរ និង ស្រុក ប្រាសាទ បល្ល័ង្ក នា ព្រឹក ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ ។
ជាមួយគ្នា នេះ លោក សុខ លូ បន្ត ទៀត ថា « យើង ពិតជា មាន សំណាង ណាស់ ដែល មាន សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ជា ប្រមុខ ដឹកនាំ ដ៏ ឈ្លាសវៃ បំផុត តែងតែ យកចិត្ត ទុកដាក់ ខ្ពស់ ចំពោះ សុខ មាលភាព របស់ បងប្អូន ប្រជាពលរដ្ឋ កម្ពុជា ជាពិសេស ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ ឆ្លង កូវីដ - ១៩ ដោយ ខិតខំ ប្រឹងប្រែង ស្វែងរក វ៉ាក់សាំង បង្ការ ចាក់ ជូន ប្រជាពលរដ្ឋ ឲ្យបាន គ្រប់ ៗ គ្នា នឹង ដោយ ឥត គិត ថ្លៃ » ។
នៅក្នុង នោះ ដែរ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត កំពង់ធំ មាន ការសប្បាយរីករាយ ណាស់ ដោយ មាន ថ្នាក់ដឹកនាំ ជាពិសេស គឺ សម្តេច តេជោ ដែល បាន គិតគូរ ពី សុខ ទុក្ខ របស់ ពួកគាត់ គ្រប់ ពេលវេលា និង បាន គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ និង ជូនពរ សម្តេច តេជោ សូម ទទួលបាន នូវ សុខភាព ល្អ បរិបូរណ៍ កម្លាំង មាំ មួន ខ្លាំងក្លា បញ្ញា ញាណ វាង វៃ ជន្មាយុ យឺន យូរ និង ទទួលបាន ជោគជ័យ ត្រចះត្រចង់ ក្នុង ការដឹកនាំ ប្រទេសជាតិ ឱ្យ មាន ការរីកចម្រើន ។
បន្ថែម ពី នេះ អភិបាល ខេត្ត ក៏ បាន ធ្វើ ការណែនាំ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន មក ធ្វើ ការចាក់ វ៉ាក់សាំង សូម ចូលរួម អនុវត្ត រក្សា គម្លាត សុវត្ថិភាព រក្សា សណ្តាប់ធ្នាប់ មិន ត្រូវ ប្រជ្រៀត ដណ្តើម គ្នា ជៀសវាង មាន ការកកស្ទះ ដើម្បី ចាក់ វ៉ាក់សាំង មុន នោះ ឡើយ ព្រោះ វា អាចនឹង មាន ហានិភ័យ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ នេះ មកដល់ ខ្លួន យើង ក្រុមគ្រួសារ និង សហគមន៍ របស់ យើង ។
អាជ្ញាធរ អូស្រ្តាលី ព្រមាន ពី ការឆ្លង រាលដាល នៃ វីរុស បំប្លែង ថ្មី Delta ក្នុង ទីក្រុង ស៊ីដនី
មូលនិធិ ជន ពិការ បាន ប្រគល់ ផ្ទះ ១ខ្នង ដល់ ជន ពិការ ក្រីក្រ តាម សហគមន៍ ១គ្រួសារ នៅ ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោក ស៊ឹម សុធន នាយក មូលនិធិ ជន ពិការ បាន ដឹកនាំ ប្រតិភូ ចុះ ប្រគល់ ផ្ទះ ១ខ្នង ដល់ ជន ពិការ ក្រីក្រ តាម សហគមន៍ ១គ្រួសារ នៅ ខេត្ត ស្វាយរៀង នា ថ្ងៃទី ៦ ខែសីហា ឆ្នាំ ២០២១ ។ កម្មវិធី នេះ ក៏ មាន ការចូលរួម ពី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត ប្រធាន សាខា មូលនិធិ ជន ពិការ ខេត្ត ស្វាយរៀង និង អាជ្ញាធរ មូលដ្ឋាន ជាច្រើន រូប ផងដែរ ។
ក្នុង កម្មវិធី នេះ លោក ស៊ឹម សុធន នាយក មូលនិធិ ជន ពិការ បាន ថ្លែង ថា លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ដល់ បងប្អូន ជន ពិការ ក្នុង ខេត្ត ស្វាយរៀង តាមរយៈ រូបលោក ផ្ទាល់ កន្លងមក នេះ រដ្ឋមន្រ្តី វង សូត តែងតែ យកចិត្តទុក ដល់ បងប្អូន ជន ពិការ ជាក់ស្តែង ក្រសួង តាមរយៈ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត បាន សហការ និង សម្របសម្រួល រៀបចំ កម្មវិធី ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ដល់ ជន ពិការ ផងដែរ ។
លោក បន្ត ថា ថវិកា នៃ ការសាងសង់ ផ្ទះ នេះ បាន មកពី សប្បុរសជន នានា ដែល បាន បរិច្ចាគ ថវិកា ចូលក្នុង ហិប ប្រាក់ វិភាគទាន សប្បុរសធម៌ មូលនិធិ ជន ពិការ ហើយ តាមរយៈ ថវិកា ទាំងនេះ មូលនិធិ ជន ពិការ បាន យក ទៅ ប្រើប្រាស់ ជួយ ដល់ ជន ពិការ ក្រីក្រ លើ កម្មវិធី ការងារ ចំនួន ៣រួម មាន៖ ការសាងសង់ ផ្ទះ ការផ្តល់ ជា អំណោយ សប្បុរសធម៌ និង ការផ្តល់ ប្រាក់ កម្ចី ។
លោក បន្ត ថា សម្រាប់ ខេត្ត ស្វាយរៀង នេះ កន្លងមក មូលនិធិ ជន ពិការ បាន សាងសង់ ផ្ទះ ជូន ជន ពិការ ក្រីក្រ ១ខ្នង រួច មកហើយ ។ ចំពោះ ថ្ងៃ នេះ ដែរ មូលនិធិ ជន ពិការ បាន សាងសង់ ផ្ទះ១ ខ្នង ទៀត ដល់ គ្រួសារ របស់ លោកស្រី ចាន់ ស៊ីណាត ដែល ជា ជន ពិការ រស់ នៅ ភូមិ ថ្មី ឃុំ ចំបក់ ស្រុក ស្វាយជ្រុំ ខេត្ត ស្វាយរៀង ដើម្បីឲ្យ ពួកគាត់ ទទួលបាន ទី ជម្រក សមរម្យ ។
លោក នាយក មូលនិធិ ជន ពិការ ក៏ បាន ផ្តាំផ្ញើ ដល់ ជន ពិការ ម្ចាស់ ផ្ទះ សូម ថែរក្សា សុខភាព និង អនុវត្ត វិធានការ៣ការពារ ៣កុំ របស់ រាជ រដ្ឋាភិបាល ដើម្បី ការពារ ខ្លួន និង គ្រួសារ ពី ជំងឺ កូវីដ - ១៩ និង ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ឱ្យ បាន គ្រប់ ៗ គ្នា នៅ កន្លែង ដែល ជិត បំផុត ក្នុង មូលដ្ឋាន របស់ គាត់ ។
ជា កិច្ច បញ្ចប់ លោក នាយក ក៏ បាន ផ្តល់ នូវ កញ្ចប់ អំណោយ សប្បុរសធម៌ របស់ មូលនិធិ ជន ពិការ និង មន្ទីរ សង្គមកិច្ច ខេត្ត ស្វាយរៀង ជូន ដល់ ជន ពិការ ម្ចាស់ ផ្ទះ ផងដែរ ៕
អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ បន្ត នាំ អំណោយ កាកបាទ ក្រហម កម្ពុជា ចែកជូន ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ ទៀត នៅ សង្កាត់ ចោម ចៅ ទី១
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ ក្នុង សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ទទួលបាន អំណោយ ពី អនុ សាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី ជួល សម្រួល ដល់ ជីវភាព ក្នុង អំឡុង ពេល វិបត្តិ ជំងឺ កូវីដ១៩ កំពុង រីករាលដាល ។
ពិធី ចែក អំណោយ នេះ ត្រូវបាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ៦ ខែសីហា ឆ្នាំ ២០២១ ក្រោម វត្តមាន លោក ហែម ដារិទ្ធិ អភិបាល ខណ្ឌ ពោសែន ជ័យ និង ជា ប្រធាន ប្រធាន កិត្តិយស អនុសាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ពោធិ៍សែនជ័យ រួម និង ក្រុមការងារ អនុសាខា ជាច្រើន នាក់ នៅ បរិវេណ វត្ត តាំង កំពែង ស្ថិត ក្នុង ភូមិ ត្រពាំង រំចេក សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
លោក ហែម ដារិទ្ធិ បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ដល់ គ្រួសារ ទាំងអស់ ប្រកបដោយ សេចក្តីនឹករលឹក ។
លោក ក៏ សូម អំពាវនាវ ដល់ គ្រួសារ ទាំងអស់ បន្ត ការប្រុងប្រយត្ន័ បន្ថែម ទៀត និង ជាពិសេស សូម បន្ត អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ វិធានការ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន គឺ៖ « ៣ការពារ និង ៣កុំ » ដើម្បី ចូលរួម ទប់ស្កាត់ និង ការពារ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ទាំងអស់ គ្នា ។
គួស បញ្ជាក់ ថា អំណោយ មនុស្សធម៌ ដែល ផ្តល់ ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ ក្នុង សង្កាត់ កាកាប២ រាជធានី ភ្នំពេញ នា ពេលនេះ ក្នុង ១គ្រួសារ ៗ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម មី មួយ កេស ទឹក សុី អុីវ ១យួរ ត្រីខ១យួរ ម៉ាស់ ១ ប្រអប់ រួម និង ថវិការ ៣០០០០ រៀល ផងដែរ ៕
អាជ្ញាធរ អាហ្វ្រិក ខាងត្បូង បាន ប្រាប់ ឲ្យដឹង ថា លោក Zuma ត្រូវបាន បញ្ជូន ទៅ មន្ទីរពេទ្យ ដើម្បី ត្រួតពិនិត្យ សុខភាព ក្រោយពី អតីត ផ្នែក ថែ សុខភាព របស់ លោក ទទួលបាន ការអនុញ្ញាត ពី មន្ត្រី គ្រប់គ្រង ពន្ធនាគារ ក្នុង ការសម្រួល ដំណើរការ ដ៏ ចាំបាច់ នេះ ។ មន្ត្រី ពន្ធនាគារ អាហ្វ្រិក ខាងត្បូង បាន គូសបញ្ជាក់ ទៀត ថា អ្នកទោស មាន សិទ្ធិ ទទួល ការព្យាបាល សុខភាព អាហារូបត្ថម្ភ ត្រឹមត្រូវ អាន ព័ត៌មាន - សៀវភៅ និង តាមដាន ស្ថានភាព នៃ ការឃុំ ខ្លួន ជាដើម ។
គួរ បញ្ជាក់ ថា អតីត ប្រធានាធិបតី អាហ្វ្រិក ខាងត្បូង លោក Jacob Zuma ត្រូវបាន ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ រយៈពេល ១៥ខែ កាលពី ចុង ខែមិថុនា ឆ្នាំ ២០២១ ។ ការផ្ដន្ទាទោស ឱ្យ ជាប់ ពន្ធនាគារ នេះ ត្រូវបាន ធ្វើឡើង បន្ទាប់ពី តុលាការ ធម្មនុញ្ញ បាន រកឃើញ ថា លោក Jacob Zuma ពិតជា មាន ទោស ពី បទ ម៉ាក់ងាយ ចំពោះ បទបញ្ជា នៃ តុលាការ ធម្មនុញ្ញ ក្នុង ការសាកសួរ អំពី ការប្រព្រឹត្ត អំពើពុករលួយ ក្នុង កំលុង ពេល ដែល លោក កាន់ តំណែង ជា ប្រធានាធិបតី ។
ពេលវេលា កាន់អំណាច របស់ លោក Jacob Zuma ត្រូវបាន បញ្ចប់ កាលពី ឆ្នាំ ២០១៨ និង ក្រោយមក លោក បាន ប្រឈម នឹង ការចោទប្រកាន់ ពី បទ ពុករលួយ និង លាង លុយក ខ្វក់ ប៉ុន្តែ អតីត ប្រធានាធិបតី អាហ្រ្វិក ខាងត្បូង រូប នេះ បាន ច្រានចោល រាល់ ការចោទប្រកាន់ មក លើ រូបលោក ក៏ ដូចជា អះអាង ផងដែរ ថា ខ្លួន មិន បាន ប្រព្រឹត្ត ទោស កំហុស អ្វី ទាំងអស់ ៕
សម្តេច ក្រឡាហោម ស ខេង៖ នៅក្នុង អំឡុង ពេល រីករាលដាល ជំងឺ កូវីដ១៩ បទល្មើស គ្រឿងញៀន មាន ការថយចុះ
( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន បញ្ជាក់ ថា នៅក្នុង អំឡុង ពេល នៃ ការរីករាដាល នៃ ជំងឺ កូវីដ១៩ បទល្មើស គ្រឿងញៀន មាន ការថយចុះ គួរឱ្យ កត់សម្គាល់ ដោយសារ កងកម្លាំង នគរបាល ជាតិ ដែល មាន ឆន្ទៈ មោះ មុត ក្នុង ការបង្ក្រាប បទល្មើស គ្រឿងញៀន នេះ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន បន្ត ថា « ជា ការពិត ហើយ យើង ត្រូវ គោរព តាម វិធានការ សុខាភិបាល ប៉ុន្តែ ទន្ទឹម គ្នា នេះ យើង ក៏ ត្រូវ យកចិត្តទុកដាក់ បំពេញ ភារកិច្ច ជា ចាំបាច់ ដើម្បី ថែរក្សា សន្តិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ សាធារណៈ ជូន ប្រជាពលរដ្ឋ ។ ខ្ញុំ សូម កោតសរសើរ ដ្បិត ជាក់ស្ដែង ក្នុង រយៈពេល ក្លងទៅ នេះ ការបង្ក្រាប បទល្មើស បាន ទទួល លទ្ធផល យ៉ាង ល្អ ប្រសើរ » ។
ពាក់ព័ន្ធ នឹង បទល្មើស គ្រឿងញៀន ក្នុង ស្ថានភាពប្រឈម នេះ សម្ដេច ក្រឡាហោម បាន គូសបញ្ជាក់ ថា បទល្មើស នេះ បាន ថយចុះ បន្តិច ប៉ុន្តែ ក្រុម ឧក្រិដ្ឋ ជន នៅតែ ឆ្លៀត ឱកាស លួច កែច្នៃ ផលិត និង នាំចូល សារធាតុ ញៀន អាភៀន ពី បណ្ដា ប្រទេស ជុំវិញ ពិសេស ពី តំបន់ ត្រីកោណ មាស មក កម្ពុជា ធ្វើឱ្យ មាន ការកែច្នៃ និង ផលិត គ្រឿងញៀន កើនឡើង ជាង ពេល មុន ។
សម្តេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « បទល្មើស គ្រឿងញៀន ក៏ មាន ការថយចុះ បន្ដិច មែន ក៏ប៉ុន្ដែ គឺ ចាត់ទុក ថា ជា ជោគជ័យ មួយ យ៉ាង ធំ ផងដែរ ក្នុង ពេល កូវីដ១៩ នេះ ព្រោះថា ទោះបី កូវីដ១៩ ក៏ដោយ ក៏ មាន ជន ឆក់ យក ឱកាស នេះ ដើម្បី លួច ផលិត និង នាំចូល នូវ សារធាតុ ញៀន ផងដែរ » ។
សម្ដេច ក្រឡាហោម បាន គូសបញ្ជាក់ ថា៖ « ចាប់តាំ ពី យុទ្ធនាការ បង្ក្រាប គ្រឿងញៀន ដំបូង ឆ្នាំ ២០១៧ មកដល់ ពេលនេះ គិត ទាំង អាភៀន និង សារធាតុ គីមី ផ្សុំ មាន ជាង ១១តោន ហើយក៏ មិន ដឹង ថា រួចផុត ចេញ ពី យើង ទៅ ប៉ុន្មាន ទៀត ដែរ យ៉ាងណា នេះ គឺជា លទ្ធផល ដែល កើត ចេញ ពី ឆន្ទៈ មុះ មុត នៃ ការបំពេញ ភារកិច្ច ជា រួម របស់ កងកម្លាំង នគរបាល ជាតិ និង មន្រ្តី រាជការ ពាក់ព័ន្ធ ទាំ អស់ » ។
ទាក់ទង នឹង បញ្ហា សន្តិសុខ សណ្ដាប់ធ្នាប់ និង ការផ្ដល់ សេវា នៅ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ សម្ដេច ក្រឡាហោម ស ខេង ក៏ បាន គូសបញ្ជាក់ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ឃុំ សង្កាត់ ត្រូវបាន ចាត់ទុក ថា ជា ថ្នាក់ រដ្ឋបាល ដែល នៅជិត ប្រជាពលរដ្ឋ បំផុត ពោលគឺ បេសកកម្ម របស់ ថ្នាក់ ក្រោម ជាតិ នេះ ក៏ មិន ខុសពី ថ្នាក់ ជាតិ ដែរ ហើយ រឹតតែ សំខាន់ ជាង ថ្នាក់ ជាតិ ទៅ ទៀត នៅ ត្រង់ ថា ពួក គាត់ នៅ គៀក នឹង ប្រជាពលរដ្ឋ ប្រជាពលរដ្ឋ អាច ដឹង ថា ពួក គាត់ ធ្វើ ល្អ និង មិន ធ្វើ ល្អ ដោយ ងាយ ៕
តំបន់ ឆ្នេរ ព្រែក កំពង់កណ្ដាល នៅ ខេត្ត កំពត នឹង ក្លាយជា តំបន់ ទេសចរ ដ៏ ទាក់ទាញ ថ្មី មួយ បន្ថែម ទៀត . រដ្ឋបាល ខេត្ត នឹង ជំរុញ គម្រោង នេះ ជូន ទៅ ក្រសួង ពាក់ព័ន្ធ ដើម្បី ពិនិត្យ និង សម្រេច ជា គោលការណ៍ ផ្លូវ ច្បាប់
( កំពត ) ៖ ក្នុង កិច្ចប្រជុំ នា ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ រដ្ឋបាល ខេត្ត កំពត បាន ឯកភាព សម្រេច ដាក់ សំណើ ជូន ទៅ ក្រសួង និង ស្ថាប័ន ជំនាញ ពាក់ព័ន្ធ ដើម្បី ពិនិត្យ និង សម្រេច ជា គោលការណ៍ ផ្លូវ ច្បាប់ ក្នុង ការអនុវត្ត គម្រោង ការកែលម្អ និង អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ សេវាកម្ម ទេសចរណ៍ នៅ តំបន់ ឆ្នេរ ព្រែក កំពង់កណ្ដាល ស្ថិត នៅ ឃុំ ជុំ គ្រៀល ស្រុក ទឹក ឈូ ឲ្យ មាន ភាពទាក់ទាញ បន្ថែម ទៀត សម្រាប់ ខេត្ត កំពត ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ជា វ តាយ អភិបាល ខេត្ត កំពត និង មាន ការចូលរួម ពីសំណាក់ មន្ត្រី នៃ មន្ទីរ ស្ថាប័ន ជំនាញ និង អាជ្ញាធរ ពាក់ព័ន្ធ ។
ក្នុង កិច្ចប្រជុំ នេះ លោក ជា វ តាយ បាន បញ្ជាក់ ថា គម្រោង ការកែលម្អ និង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ សេវាកម្ម ទេសចរណ៍ ឆ្នេរ ព្រែក កំពង់កណ្ដាល នេះ រដ្ឋបាល ខេត្ត កំពត បាន គ្រោង ជា យូរ មកហើយ ប៉ុន្តែ នៅ មិន ទាន់ មាន ការឯកភាព គ្នា ពី មន្ទីរ ជំនាញ អង្គភាព ពាក់ព័ន្ធ និង អាជ្ញាធម៌ មូលដ្ឋាន នៅ ឡើយ ។
លោក ថា ឆ្លង តាមរយៈ កិច្ចប្រជុំ នេះ ដែរ រដ្ឋបាល ខេត្ត បាន ឯកភាព គ្នា ពី បណ្ដា មន្ទីរ ជំនាញ ពាក់ព័ន្ធ និង អាជ្ញាធរ ក្នុង ការជំរុញ ដាក់ គម្រោង នេះ ជូន ទៅ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ថ្នាក់ ជាតិ ពិនិត្យ និង សម្រេច ជា គោលការណ៍ ផ្លូវ ច្បាប់ ក្នុង ដំណើរការ អនុវត្ត គម្រោង ។
លោក ជា វ តាយ បន្ត ថា « គម្រោង ការកែលម្អ និង អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ សេវាកម្ម ទេសចរណ៍ ឆ្នេរ ព្រែក កំពង់កណ្ដាល ខាងលើ ជា គម្រោង វិនិយោគ រយៈពេល ១៥ ឆ្នាំ ជាមួយនឹង ដៃគូ វិនិយោគ ចំនួន ១១នាក់ ដែល ពួកគាត់ នឹង រៀបចំ ឲ្យ មាន សេវាកម្ម ទេសចរណ៍ ផ្សេង ៗ ដូចជា មាន កន្លែង សម្រាប់ អង្គុយ លម្ហែ មើល ទេសភាព និង ស្រូបយក ខ្យល់អាកាស កន្លែង ទទួលទាន អាហារ សួនច្បារ កន្លែង កីឡា កន្លែង កម្សាន្ត របស់ កុមារ និង ចំណត រថយន្ត ជាដើម ប៉ុន្តែ មិន អនុញ្ញាតឲ្យ សង់ អគារ ខ្ពស់ ឬ កន្លែង ស្នាក់ នៅ ទេ » ។
ទន្ទឹម នេះ លោក អភិបាល ខេត្ត ក៏ បាន ស្នើ ដល់ ជំនាញ និង អាជ្ញាធរ ពាក់ព័ន្ធ ធ្វើ យ៉ាងណា សហការ គ្នា ឲ្យបាន ល្អ ដើម្បីឱ្យ គម្រោង ការអភិវឌ្ឍ តំបន់ ឆ្នេរ កំពង់កណ្តាល មួយ នេះ បាន សម្រេច ជោគជ័យ សម្រាប់ ជា សក្ដានុពល បម្រើ សេវាកម្ម ទេសចរណ៍ ខេត្ត កំពត ឲ្យបាន កាន់តែ រីកចំរើន បន្ថែម ទៀត ៕ អាជ្ញាធរ ខេត្ត កោះកុង នឹង បើក ដំណើរការផ្សារ ថ្ម ស នៅ ស្រុក បូទុម សាគរ ឡើងវិញ នៅ ថ្ងៃទី ៧ ខែសីហា ស្អែក នេះ
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ស្រុក បូទុម សាគរ៖ ដុត កម្ទេចចោល កាំភ្លើង កែច្នៃ ១៤០ ដើម ក្រោយ ដកហូត ពី ប្រជាពលរដ្ឋ នៅ ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ ដើម្បី ជា ការរួមចំណែក ធ្វើ យ៉ាងណា ឱ្យ ភូមិ ឃុំ មាន សុវត្ថិភាព គ្មាន បទល្មើស លួច ឆក់ ប្លន់ និង អំពើ ល្មើស ច្បាប់ ផ្សេង ៗ នៅក្នុង មូលដ្ឋាន ជូន ពលរដ្ឋ និង សង្គម កម្លាំង នគរបាល តែងតែ ចុះល្បាត និង បង្ក្រាប បាន អំពើ ល្មើស ច្បាប់ ផ្សេង ៗ ។
ជាក់ស្តែង នៅ ព្រឹក ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ បាន ដុត កម្ទេច កាំភ្លើង កែ ឆ្នៃ ១៤០ ដើម ដែល បាន ដកហូត ជា បន្តបន្ទាប់ពី អ្នក ល្មើស ច្បាប់ នៅក្នុង មូលដ្ឋាន ។
លោក ឧត្តមសេនី ត្រី ប៊ុន ផេង ស្នងការ រង ទទួល ការងារ អាវុធ ជាតិ ផ្ទុះ និង អគ្គិភ័យ បាន ថ្លែង ថា កាំភ្លើង ដែល បាន ដុត ចោល ថ្ងៃ នេះ ជា កាំភ្លើង កែច្នៃ ពី ឈើ មាន ដូចជា បាញ់ គ្រាប់ កិប ខ្លះ ប្រើ ខ្យល់ បាញ់ គ្រាប់ កង់ និង កាំភ្លើង ស្នា កេះ មាន ចំនួន សរុប ១៤០ ដើម ។ កំា ភ្លើង ទាំង នេះ គឺ បាន ប្រមូល ពី ប្រជាពលរដ្ឋ ទាំង ៩ស្រុក / ក្រុង ក្នុង ខេត្ត ដែល ប្រព្រឹត្ត បទល្មើស និង អ្នក រក្សាទុក ដើម្បី បាញ់ កណ្ដុរ សត្វ ផ្សេង ៗ តាំងពី ឆ្នាំ ២០១៧ ជា បន្តបន្ទាប់ រហូតដល់ បច្ចុប្បន្ន ។
លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ បាន បញ្ជាក់ ថា ការដុត កម្ទេច កាំភ្លើង កែ ឆ្នៃ ថ្ងៃ នេះ គឺជា ការរួមចំណែក ធ្វើ យ៉ាងណា ឱ្យ ភូមិ ឃុំ មាន សុវត្ថិភាព នៅក្នុង មូលដ្ឋាន ជូន ពលរដ្ឋ និង សង្គម ។
លោក ស្នងការ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ និង យុវជន ទាំងឡាយ បើ មាន ការច្នៃ ផលិត ឬ រក្សាទុក កាំភ្លើង កែ ឆ្នៃ និង គ្រាប់ យុទ្ធភណ្ឌ ផ្សេង ៗ ត្រូវ សហការណ៍ និង ប្រគល់ជូន សមត្ថកិច្ច បើ ក្នុង ករណី រកឃើញ ថា មាន បទល្មើស នឹង ត្រូវ ផ្ដន្ទាទោស តាម ច្បាប់ ៕
ការទូទាត់ សាច់ប្រាក់ តាម ប្រព័ន្ធ អេឡិចត្រូនិក កើនឡើង ក្នុង អំឡុង ពេល រីករាលដាល នៃ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ ការទូទាត់ សាច់ប្រាក់ តាម ប្រព័ន្ធ អេឡិចត្រូនិក បាន និង កំពុង កើនឡើង ខ្លាំង ។ កើនឡើង ដោយសារតែ ក្នុង អំឡុង ពេល នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ប្រជាពលរដ្ឋ បាន ផ្លាស់ប្ដូរ ផ្នត់គំនិត របស់ ខ្លួន ពី ការប្រើប្រាស់ ការទូទាត់ ជា សាច់ប្រាក់ សុទ្ធ មក ប្រើប្រាស់ ការទូទាត់ តាម ប្រព័ន្ធ អេឡិចត្រូនិក វិញ ដើម្បី ចូលរួម កាន់ បន្ថយ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ តាមរយៈ ក្រដាស់ ប្រាក់ ។
ធនាគារ ជាតិ នៃ កម្ពុជា លើកឡើង ថា « ការប្រើប្រាស់ សេវា ធនាគារ ឌីជីថល អាច ជួយ កាត់បន្ថយ ការចម្លង ជំងឺ កូវីដ១៩ តាមរយៈ ការកាត់បន្ថយ តម្រូវការ នៃ ការប្រើប្រាស់ ក្រដាស ប្រាក់ ដោយ ផ្ទាល់ រវាង បុគ្គល ម្នាក់ ទៅ បុគ្គល ម្នាក់ ទៀត » ។
ទន្ទឹម នោះ ធនាគារ ជាតិ នៃ កម្ពុជា ក៏ បាន ជំរុញ ឱ្យ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ និង ស្ថាប័ន នានា ក្នុង ប្រទេស កម្ពុជា ផ្តល់ ការលើកទឹកចិត្ត ដល់ អតិថិជន និង ក្រុមហ៊ុន សហគ្រាស ដែល ជ្រើសរើស យក ប្រតិបត្តិការ ទូទាត់ ជា អេឡិចត្រូនិក ជំនួស ឱ្យ ប្រតិបត្តិការ ទូទាត់ ដែល ប្រើប្រាស់ ក្រដាស ប្រាក់ ។
ជាក់ស្ដែង ធនាគារ អេស៊ីលីដា ភី អិល ស៊ី ដែល មាន អភិវឌ្ឍ នូវ សេវា ធនាគារ ឌីជីថល ឈាន មុខ គេ មួយ នៅ កម្ពុជា ក៏ បាន និង កំពុង ចូលរួម យ៉ាង សកម្ម ជា ក្នុង ការផ្ដល់ ភាពងាយស្រួល សុវត្ថិភាព និង លឿន រហ័ស សម្រាប់ ការទូទាត់ តាម អេឡិចត្រូនិក នេះ តាមរយៈ អេប អេស៊ីលីដា ម៉ូបាល ដែល មាន មុខងារ យ៉ាង សម្បូរបែប ។ ការប្រើប្រាស់ ការទូរទាត់ តាម ប្រព័ន្ធ អេឡិចត្រូនិក នេះ បាន ចូលរួម មួយ ផ្នែក ធំ ក្នុង ការទប់ស្កាត់ ការឆ្លង មេរោគ កូវីដ១៩ ។
លោកស្រី សុខ សោភា នាយិកា ប្រតិបត្តិ ជាន់ ខ្ពស់ ទីផ្សារ នៃ ធនាគារ អេស៊ីលីដា បាន ឲ្យដឹង ថា « ការ ដែល អតិថិជន នាំគ្នា មក ទូទាត់ ចាយវាយ តាម បែប ឌីជីថល ដែល ជា បច្ចេកវិទ្យា សម័យ ថ្មី វិញ កាន់តែ ល្អ ប្រសើរ ព្រោះថា ការទូទាត់ តាម បច្ចេកវិទ្យា ថ្មី គឺ តាម អេស៊ីលីដា ម៉ូបាល ជួយ ឲ្យ អតិថិជន មិន ប្រឈមមុខ នឹង ហានិភ័យ ផេ្សង ៗ ដោយសារ អតិថិជន មិន ប៉ះពាល់ ក្រដាស់ ប្រាក់ ដែល មិន បាន សម្លាប់ មេរោគ ជាមុន នោះ ទេ » ។
លោកស្រី សុខ សោភា បញ្ជាក់ ថា ធនាគារ អេស៊ីលីដា ភី អីល ស៊ី ចូលរួម យ៉ាង ពេញ ទំហឹង ជាមួយនឹង គោល នយោបាយ ធនាគារ ជាតិ នៃ កម្ពុជា ហើយ លោកស្រី ក៏ សូម លើកទឹកចិត្ត ដល់ អតិថិជន ទាំងអស់ គ្នា ឲ្យ ចូលរួម ទូទាត់ ថ្លៃ ទំនិញ ផ្សេង តាមរយៈ ស្កេន ឃ្យូអកូដ អេស៊ីលីដា ម៉ូបាល ក្នុង ការបញ្ជាទិញ ទំនិញ ចំណីអាហារ ។
ងាក ត្រឡប់ មក ការប្រកប អាជីវកម្ម របស់ ប្រជាពលរដ្ឋ តាម បណ្តា ហាង ជាច្រើន ក៏ ដូចជា នៅ ស្ទើរ គ្រប់ ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ ក៏ បាន ទទួលយក ការវិវត្ត ថ្មី នៃ ការទូទាត់ ប្រាក់ តាម ប្រព័ន្ធ អេឡិចត្រូនិក នេះ ផងដែរ ។
អ្នកនាង វ៉ាន់ សុខ ហេង ម្ចាស់ ហាង លក់ សម្ភារ ផ្គត់ផ្គង់ ទារក បាន ឲ្យដឹង ថា « ខ្លួន បាន ចាប់ផ្ដើម ផ្តល់ ជម្រើស ទូទាត់ មិន ប្រើប្រាស់ ក្រដាស ប្រាក់ ដល់ អតិថិជន ៣ឆ្នាំ ហើយ ។ ដោយសារតែ មាន ការរាត ត្បាត ជំងឺ កូវីដ១៩ ធ្វើឱ្យ ការទូទាត់ មិន ប្រើប្រាស់ ក្រដាស ប្រាក់ នៅ ហាង របស់ ខ្លួន កើនឡើង ដល់ ៣០%» ។
អ្នកនាង បាន បន្ថែម ថា ក្រដាស ប្រាក់ ត្រូវបាន បម្លាស់ ទី ពី មនុស្ស ម្នាក់ ទៅ ម្នាក់ យ៉ាង ឆាប់រហ័ស ដូច្នេះ មិន អាច កំណត់ បាន ថា តើ ក្រដាស ប្រាក់ ទាំងនោះ ត្រូវបាន កាន់ ដោយ បុគ្គល មាន វិជ្ជមាន ជំងឺ កូវីដ - ១៩ ឬ អត់ នោះ ទេ ដូច្នេះ ការប្រើប្រាស់ នូវ ការ ទូទាត់ តាម ប្រព័ន្ធ អេឡិចត្រូនិក នេះ ជា ជម្រើស ដ៏ ល្អ បំផុត សម្រាប់ អតិថិជន ។
អ្នកស្រី បន្ថែម ថា « អំឡុង ពេល នៃ ការរាត ត្បាត ជំងឺ កូវីដ១៩ ខ្ញុំ បាន មើលឃើញ ពី កំណើន នៃ ប្រតិបត្តិការ ទូទាត់ ដោយ មិន ប្រើប្រាស់ ក្រដាស ប្រាក់ នៅក្នុង ហាង ខ្ញុំ កើនឡើង ពី ២០ - ៣០ ភាគរយ បើ ធៀប នឹង មុនពេល មាន ការរាត ត្បាត ជំងឺ នេះ ។ ចំពោះ វិធីសាស្រ្ត នៃ ការទូទាត់ ខ្ញុំ ក៏ តែងតែ អនុវត្ត ពេល ខ្ញុំ ធ្វើ ការទូទាត់ ប្រាក់ បន្ត ជូន ក្រុមហ៊ុន ផ្គត់ផ្គង់ ផងដែរ » ។
អ្នកស្រី ប៊ុន សាដេត ម្ចាស់ ហាង លក់ ម៉ូតូ លើកឡើង ថា ការទូទាត់ ដោយ មិន ប្រើប្រាស់ ក្រដាស ប្រាក់ នៅ ហាង របស់ ខ្លួន កើនឡើង ខ្លាំង រហូតដល់ ៦០ % បើ ធៀប នឹង មុនពេល មាន ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ ។
អ្នកស្រី បាន បន្ថែម ថា « អំឡុង ពេល នៃ ការរាត ត្បាត ជំងឺ នេះ ខ្ញុំ ចង់ឱ្យ អតិថិជន ផ្ទេរ ប្រាក់ តាមរយៈ កម្មវិធី សេវា ធនាគារ ចល័ត ពីព្រោះ យើង មិន ចាំបាច់ ព្រួយបារម្ភ ពី ការជួប អតិថិជន ដោយ ផ្ទាល់ ដោយ គ្រាន់តែ បង្ហាញ លេខ គណនី ធនាគារ របស់ យើង ទៅ អតិថិជន ហើយ អតិថិជន អាច ផ្ញើ ប្រាក់ មក បាន យ៉ាង ងាយស្រួល ក្នុង នោះ ក៏ ចំណេញ ពេល ចំពោះ ការរាប់ ប្រាក់ ផងដែរ » ។
អត្ថប្រយោជន៍ នៃ ការទូទាត់ ដោយ មិន ប្រើប្រាស់ ក្រដាស ប្រាក់ ត្រូវបាន មើលឃើញ កាន់តែ ច្បាស់ ក្នុង អំឡុង ពេល នៃ ការរាត ត្បាត ជំងឺ កូវីដ១៩ ដែល ជំរុញ ឱ្យ អតិថិជន ទូទាត់ ទំនិញ ជា លក្ខណៈ អនឡាញ ដែល ការអនុវត្ត នេះ អាច កាត់បន្ថយ ការកាន់ ក្រដាស ប្រាក់ ដោយ ផ្ទាល់ ៕
បទ អត្ថាធិប្បាយ៖ សហរដ្ឋ អាមេរិក បាន សំយោគ សិប្បនិម្មិត នូវ វីរុស កូរ៉ូណា បែប SARS នៅ ឆ្នាំ ២០០៨
ខេត្ត សៀមរាប រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ៩៨ នាក់ ជាសះស្បើយ ១០០ នាក់ និង ស្លាប់ ០២ នាក់ នៅ ថ្ងៃទី ០៥ ខែសីហា
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ០៥ ខែសីហា ម្សិលមិញ នេះ រដ្ឋបាល ខេត្ត សៀមរាប បាន រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៩៨ នាក់ បន្ថែម ទៀត ខណៈ អ្នកជំងឺ ២នាក់ បាន ស្លាប់ និង ជាសះស្បើយ ១០០ នាក់ ។
ករណី ទី២៦ ដល់ ទី ៣២ ជា ករណី ឆ្លង បន្ត ពី សព ឈ្មោះ លីវ សារ៉ែ ន និង ករណី ទី៣៣ ដល់ ទី៣៤ ឆ្លង បន្ត ពី សព ឈ្មោះ ចក់ វឿន ។ ចំពោះ ករណី ទី៣៥ ដល់ ទី ៥២ មាន ប្រភព ចម្លង បន្ត ពី អ្នកដំណើរ មកពី រាជធានី ភ្នំពេញ ខេត្ត បាត់ដំបង ខេត្ត កែប ខេត្ត ឧត្តរមានជ័យ និង ខេត្ត កំពង់ធំ និង ករណី ទី៥៣ ដល់ ទី៨៨ គឺជា ករណី ពុំ ទាន់ អាច សន្និដ្ឋាន ពី ប្រភព ចម្លង ច្បាស់លាស់ នៅឡើយ ។
ដោយឡែក ករណី ទី៨៩ ដល់ ករណី ទី៩៨ គឺជា ប្រជាពលរដ្ឋ ត្រឡប់ ពី ប្រទេស ថៃ មកដល់ ខេត្ត សៀមរាប ហើយ ជា ករណី សង្ស័យ ត្រូវបាន ក្រុម គ្រូពេទ្យ ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក នៅ វិទ្យាល័យ សម្តេច ឪ និង វិទ្យាល័យ ហ៊ុន សែន វត្ត ស្វាយ ។
សូម បញ្ជាក់ ថា មកទល់ ពេលនេះ ខេត្ត សៀមរាប មាន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ សរុប ចំនួន ៤.៩៤៥ នាក់ ។ ក្នុង នោះ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ២. ៦៩៥នាក់ ស្លាប់ ៥៧ នាក់ និង ២. ១៩៣នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប មណ្ឌល ចត្តាឡី ស័ក គរុកោសល្យ និង វិក្រឹត ការ ខេត្ត វិទ្យាល័យ អង្គរ វិទ្យាល័យ ហ៊ុន សែន វត្ត ស្វាយ និង វិទ្យាល័យ ដំ ដែក ។
រដ្ឋបាល ខេត្ត សៀមរាប សង្ឃឹម យ៉ាង មុតមាំ ថា ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម អនុវត្ត ឱ្យ បាន ម៉ឺងមាត់ និង អនុវត្ត នូវ វិធានការ ការពារ របស់ រាជ រដ្ឋាភិបាល និង ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕ លោកយាយ អាយុ ១០៤ ឆ្នាំ និង តា អាយុ ១០០ ឆ្នាំ នៅ ស្រុក កញ្ច្រៀច ខេត្ត ព្រៃវែង ទទួលបាន អំណោយ សម្ដេច តេជោ ហ៊ុន សែន ក្រោយ ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង កូវីដ១៩
( ព្រៃវែង ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ នៅ រសៀល ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បន្ដ នាំយក ថវិកា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋក មន្ដ្រី កម្ពុជា ទៅ ប្រគល់ ជូន លោកយាយ អាយុ ១០៤ ឆ្នាំ និង លោកតា អាយុ ១០០ ឆ្នាំ ដែល បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ទទួលបាន ថវិកា ចំនួន ៣លាន រៀល និង សម្ភារ ជា គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ទៀត ។
លោកយាយ និង លោកតា ដែល ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង ហើយ ទទួលបាន អំណោយ ពី សម្ដេច តេជោ ហ៊ុន សែន នា ឱកាស នេះ មាន ឈ្មោះ ពេជ ប៊ុន អាយុ ១០៤ ឆ្នាំ រស់ នៅ ភូមិ គោក គង់ កណ្ដាល ឃុំ គោក គង់ លិច និង តា ឈ្មោះ ឈឹម ផុត អាយុ ១០០ ឆ្នាំ រស់ នៅ ភូមិ ព្រាល ទី១ ឃុំ ថ្ម ពូន ស្រុក កញ្ច្រៀច ខេត្ត ព្រៃវែង ។
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី ឱ វណ្ណឌីន បាន នាំ នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ជូន លោក តា ឈឹម ផុត និង លោកយាយ ពេជ ប៊ុន ព្រមទាំង បាន ជម្រាប សាកសួរ អំពី ស្ថានភាព សុខភាព របស់ លោក តា ក្រោយពី ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ផងដែរ ។
លោក តា ឈឹម ផុត និង លោកយាយ ពេជ ប៊ុន ដែល បាន ចាក់ វ៉ាក់សាំង នេះ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ដែល បាន ផ្ដល់ អំណោយ ជូន ពួកគាត់ នៅ ឱកាស នេះ ៕ លោកស្រី ឱ វណ្ណឌីន បន្ដ នាំយក អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ជូន លោក តា អាយុ ១០១ ឆ្នាំ ដែល ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង កូវីដ១៩ នៅ ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បន្ដ នាំយក ថវិកា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋក មន្ដ្រី កម្ពុជា ទៅ ប្រគល់ ជូន លោក តា អាយុ ១០១ ឆ្នាំ ដែល បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ទទួលបាន ថវិកា ចំនួន ៣លាន រៀល និង សម្ភារ ជា គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ទៀត ។
លោក តា ដែល ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង ហើយ ទទួលបាន អំណោយ ពី សម្ដេច តេជោ ហ៊ុន សែន នា ឱកាស នេះ ឈ្មោះ ជៃ ជុំ អាយុ ១០១ ឆ្នាំ រស់ នៅ ភូមិ ល្បើក ឃុំ សម្បត្តិ មាន ជ័យ ស្រុក រមាសហែល ខេត្ត ស្វាយរៀង ។
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី ឱ វណ្ណឌីន បាន នាំ នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ជូន លោក តា ជៃ ជុំ ព្រមទាំង បាន ជម្រាប សាកសួរ អំពី ស្ថានភាព សុខភាព របស់ លោក តា ក្រោយពី ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ផងដែរ ។
លោក តា ជៃ ជុំ និង ប្រពន្ធ ឈ្មោះ ម៉ៃ សាន់ អាយុ ៨៧ ឆ្នាំ ដែល បាន ចាក់ វ៉ាក់សាំង ទាំង ពីរ នាក់ រួចរាល់ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ដែល បាន ផ្ដល់ អំណោយ ជូន លោក តា នៅ ឱកាស នេះ ។
ពាក់ព័ន្ធ ស្ថានភាព សុខភាព ក្រោយ ចាក់ វ៉ាក់សាំង នេះ លោក តា បាន រៀបរាប់ ថា សុខភាព របស់ លោក តា គឺ ល្អ ប្រសើរ ទាំងអស់ មិន មាន អ្វី ខុសប្លែក នោះ ទេ ពោល ធម្មតា ទាំងអស់ ទាំង ការហូបចុក និង ការស្នាក់ នៅ ប្រចាំ ថ្ងៃ ៕
បើ តាម ការប្រកាស របស់ លោក បៃ ដិន ពលរដ្ឋ ហុងកុង នឹង ទទួលបាន សិទ្ធិ បន្ត ស្នាក់ នៅក្នុង សហរដ្ឋ អាមេរិក សម្រាប់ រយៈពេល ១៨ ខែ បន្ថែម បើ ទោះជា ទិដ្ឋាការ របស់ ពួកគេ អស់ សុពលភាព ក៏ដោយ ហើយ ការសម្រេចចិត្ត នេះ ទៀតសោត គឺ ស្រប តាម ការចោទប្រកាន់ របស់ សហរដ្ឋ អាមេរិក ទៅ លើ រដ្ឋាភិបាល ទីក្រុង ប៉េកាំង អំពី ការលុបបំបាត់ សិទ្ធិ និង សេរីភាព របស់ ប្រជាជន ហុងកុង ។
លោក ចូ បៃ ដិន បាន ធ្វើការកត់សម្គាល់ នៅក្នុង សេចក្ដីថ្លែងការណ៍ យ៉ាង ដូច្នេះ ថា « តាមរយៈ ការដាក់ ច្បាប់ របស់ ប្រទេស ចិន ទៅ លើ ទីក្រុង ហុងកុង ដោយ ឯកតោ ភាគី វា បាន បំផ្លាញ សិទ្ធិ និង សេរីភាព នៅក្នុង ទីក្រុង ហុងកុង ក៏ ដូចជា ចាប់ខ្លួនអ្នកនយោបាយ ប្រឆាំង សកម្មជន និង បាតុករ ច្រើន ជាង ១០០ នាក់ ក្រោម ហេតុផល នយោបាយ » ។ លោក បៃ ដិន បាន បន្ថែម ទៀត ថា មនុស្ស ច្រើន ជាង ១.០០០ នាក់ ផ្សេង ទៀត ក៏ ត្រូវបាន ចាប់ខ្លួន ផងដែរ ជាប់ពាក់ព័ន្ធ នឹង ការតវ៉ា ប្រឆាំង រដ្ឋាភិបាល ទីក្រុង ហុងកុង ផងដែរ ។
តែ យ៉ាងណា ក៏ដោយ ស្ថានទូត ចិន ប្រចាំ ទីក្រុង វ៉ាស៊ីនតោន បាន ប្រកាស « ថ្កោល ទោស យ៉ាង ខ្លាំងក្លា » ចំពោះ ការប្រកាស របស់ លោក ចូ បៃ ដិន និង ចាត់ទុក ថា វា ជា ការ « លូកលាន់ កិច្ចការ ផ្ទៃក្នុង » របស់ ចិន យ៉ាង ពិតប្រាកដ ។
គួរ បញ្ជាក់ ថា រដ្ឋាភិបាល ទីក្រុង ប៉េកាំង បាន ដាក់ ច្បាប់ សន្តិសុខ ជាតិ លើ ទីក្រុង ហុងកុង កាលពី ខែមិថុនា ឆ្នាំ ២០២០ ខណៈ ក្រុម អ្នករិះគន់ ចោទ ថា ច្បាប់ នេះ មាន បំណង បំផ្លាញ គោលការណ៍ « ប្រទេស មួយ ប្រព័ន្ធ ពីរ » និង សិទ្ធិ សេរីភាព រួមទាំង ប្រជាជនធិបតេយ្យ របស់ ទីក្រុង ហុងកុង ។ ប៉ុន្តែ រដ្ឋាភិបាល ចិន បាន ច្រានចោល រាល់ ការរិះគន់ និង អះអាង ថា ច្បាប់ មាន គោលដៅ ថែរក្សា សន្តិភាព និង សណ្ដាប់ធ្នាប់ ទីក្រុង ហុងកុង តែ ប៉ុណ្ណោះ ៕
ខេត្ត ត្បូងឃ្មុំ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៣០ នាក់ និង ជាសះស្បើយ ៤២ នាក់
ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៤៥ នាក់ ជាសះស្បើយ ៥០ នាក់ និង ស្លាប់ ១នាក់
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៤៥ នាក់ បន្ថែម ទៀត ជាសះស្បើយ ចំនួន ៥០ នាក់ និង ស្លាប់ ១នាក់ មកពី ស្រុក កំពង់សៀម ។
ការិយាល័យ ផ្នែក សមុទ្រ នៃ រដ្ឋបាល ជាតិ ទទួលបន្ទុក ផ្នែក សមុទ្រ និង បរិយាកាស របស់ ក្រសួង ពាណិជ្ជកម្ម អាមេរិក បាន បញ្ជាក់ ថា ជាមួយនឹង ការផ្លាស់ទី នៃ ទឹក ដែល មាន ល្បឿន ៨ ហ្វីត ក្នុង មួយ វិនាទី ចរន្ត រលក មរណៈ អាច ធ្វើ ចលនា លឿន ជាង អត្តពលិក ហែលទឹក នៅ កីឡា អូឡាំពិក ទៅ ទៀត ។
អ្នក ហែលទឹក ដែល ភ័យ ស្លន់ស្លោ ជារឿយ ៗ ព្យាយាម ប្រមុខ នឹង ចរន្ត រលក មរណៈ ដោយ ការហែល សំដៅ ទៅកាន់ ច្រាំង ។ ពួកគេ ប្រថុយ នឹង ការលង់ទឹក ពីព្រោះ ភាព អស់កម្លាំង កំហែង ។
គួរ ជម្រាប ថា អ្នកការពារ នៅ តាម សមុទ្រ តែងតែ សង្គ្រោះ មនុស្ស រាប់ ពាន់ នាក់ ពី ចរន្ត រលក មរណៈ នៅក្នុង សហរដ្ឋ អាមេរិក ជារៀងរាល់ ឆ្នាំ ។ ប៉ុន្តែ ក្នុង មួយ ឆ្នាំ ៗ បើ តាម ការសន្និដ្ឋាន មនុស្ស ប្រមាណ ១០០ នាក់ បាន សម្លាប់ ដោយសារ ចរន្ត រលក មរណៈ នេះ ។
* កុំ ប្រឹង ហែល ប្រឆាំង បញ្ច្រាស ជាមួយ ចរន្ត ទឹក កំពុងតែ ហូរ
អធិការ នគរបាល ខណ្ឌ ឬស្សីកែវ បន្តបញ្ជា កម្លាំង ដាក់ គោលដៅ ត្រួតពិនិត្យ បទល្មើស ចរាចរ ផ្លូវគោក ក្រោយ មាន បទ បញ្ជា ពី ឧត្តមសេនីយ៍ ឯក ស ថេត
( ភ្នំពេញ ) ៖ លោក វរសេនីយ៍ ឯក ហ៊ាង ថា រេត អធិការ នគរបាល ខណ្ឌ ឫស្សីកែវ បាន បន្ត ដាក់ បទបញ្ជា ឱ្យ លោក វរសេនីយ៍ ទោ គង់ រតនៈ ភ័ណ្ឌ អធិការ រង ទទួល ដឹកនាំ ផែនការងារ សណ្ដាប់ធ្នាប់ សាធារណ: នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ បន្ត ដឹកនាំ កម្លាំង ចុះ ដាក់ គោលដៅ ត្រួតពិនិត្យ បទល្មើស ចរាចរ ផ្លូវគោក ក្រោយពី មាន បទបញ្ជា ណែនាំ ពី ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ។
ការដាក់ បទបញ្ជា របស់ លោក វរសេនីយ៍ ឯក ហ៊ាង ថា រេត លើ បញ្ហា ត្រួតពិនិត្យ បទល្មើស ចរាចរ នេះ បាន បន្ត ចាប់ផ្ដើម អនុវត្ត ឡើង ជា បន្តបន្ទាប់ ស្ថិត នៅ ចំណុច គោលដៅ ក្បែរ ក្រុមហ៊ុន ភេសជ្ជៈ កម្ពុជា ( កូកា - កូឡា ) តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៥ ក្នុង សង្កាត់ ឫស្សីកែវ ខណ្ឌ ឫស្សីកែវ នា ព្រឹក ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ ។
លោក វរសេនីយ៍ ឯក ហ៊ាង ថា រេត បាន បញ្ជាក់ ថា ការបន្ត ដាក់ គោលដៅ ត្រួតពិនិត្យ បទល្មើស ចរាចរ ជា បន្តបន្ទាប់ នេះ ក្នុង គោលបំណង ក៏ ដូចជា សំណូមពរ ឱ្យ ប្រជាពលរដ្ឋ យល់ដឹង កាន់តែ ច្បាស់ ពី ច្បាប់ ចរាចរ និង ចេះ គោរព ច្បាប់ ចរាចរ ដែល អាច ចូលរួម កាត់បន្ថយ អាត្រា គ្រោះថ្នាក់ ចរាចរ កាត់បន្ថយ ការចំណាយ ផ្សេង ៗ តាមរយៈ ការបើកបរ មាន ស្លាកលេខ ត្រឹមត្រូវ កញ្ចក់ និង ពាក់ មួក សុវត្ថិភាព លើ បញ្ហា បច្ចេកទេស ផ្សេង ៗ នៃ យានយន្ដ និង ទោ ចក្រក្រយានយន្ដ ពិសេស ការគោរព ភ្លើង សញ្ញា ចរាចរ ។
អភិបាល ខេត្ត កំពង់ចាម បន្ត ផ្ដល់ អំណោយ រដ្ឋបាល ខេត្ត ជូន មន្ត្រី នៃ មន្ទីរព័ត៌មាន ដែល កំពុង ធ្វើចត្តាឡី ស័ក
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន គណៈកម្មការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នា ព្រឹក ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បន្ត នាំ អំណោយ រដ្ឋបាល ខេត្ត ផ្ដល់ជូន មន្ត្រី នៃ មន្ទីរព័ត៌មាន ខេត្ត កំពង់ចាម ដែល កំពុង ធ្វើចត្តាឡី ស័ក ។
មន្ត្រី រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ឲ្យដឹង ថា រហូតមកដល់ ពេលនេះ ខេត្ត កំពង់ចាម មាន មន្ទីរ ចំនួន ៤ ដែល មាន មន្ត្រី ជាប់ពាក់ព័ន្ធ នឹង អ្នកវិជ្ជមាន កូវីដ១៩ ហើយ ត្រូវបាន ដាក់ ឲ្យ ធ្វើចត្តាឡី ស័ក នៅក្នុង អង្គភាព តែម្ដង ។ មន្ទីរ ទាំង បួន នោះ រួម មាន មន្ទីរ ពាណិជ្ជកម្ម មន្ទីរ ទេសចរណ៍ មន្ទីរ ផែនការ និង មន្ទីរព័ត៌មាន ។
មន្ត្រី ដដែល បាន បន្ត ថា ក្រោម ការយកចិត្តទុកដាក់ ខ្ពស់ ពីសំណាក់ អភិបាល ខេត្ត កំពង់ចាម ក៏ បាន នាំ អំណោយ របស់ រដ្ឋបាល ខេត្ត ផ្ដល់ជូន អង្គភាព មន្ទីរ នីមួយ ៗ ដើម្បីឲ្យ មន្ត្រី ដែល ជាប់ ធ្វើចត្តាឡី ស័ក ដោះស្រាយ បញ្ហា ហូបចុក និង សម្ភារៈ សម្រាប់ ប្រើប្រាស់ ការពារ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ផងដែរ ក្នុង នោះ មាន ដូចជា មន្ត្រី ម្នាក់ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម និង មី ១កេស ។
ជាមួយគ្នា នោះ ដែរ លោក អភិបាល ខេត្ត អ៊ុន ចាន់ ដា ក៏ បាន ឧបត្ថម្ភ បន្ថែម នូវ ទឹក បរិសុទ្ធ ១០កេស ជែល ១កេស និង ម៉ាស ចំនួន ១.០០០ ម៉ាស ផងដែរ សម្រាប់ ប្រើប្រាស់ រួម ក្នុង អង្គភាព នីមួយ ៗ ៕ ខេត្ត ប៉ៃលិន បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ១៣នាក់ និង ជាសះស្បើយ ១៤ នាក់
រដ្ឋបាល ខេត្ត ប៉ៃលិន បាន អំពាវនាវ ចំពោះ អ្នក ដែល បាន ប្រាស្រ័យទាក់ទង ប៉ះពាល់ ដោយ ផ្ទាល់ ឬ ប្រយោល ជាមួយ បុគ្គល វិជ្ជមាន កូវីដ១៩ ខាងលើ សូម ដាក់ ខ្លួន ដាច់ដោយឡែក តាមដាន សុខភាព រយៈពេល ១៤ ថ្ងៃ និង រាយការណ៍ មក អាជ្ញាធរ ដើម្បី យក សំណាក និង ធ្វើចត្តាឡី ស័ក ៕
បើ តាម ក្រសួង សុខាភិបាល ថៃ ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ២០. ៨៩៥ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ថៃ ទូទៅ និង ៤៨៤ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ អ្នកជំងឺ ចំនួន ១៩១ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ដែល ជា ចំនួន ករណី ស្លាប់ ច្រើន បំផុត មិន ធ្លាប់ មាន ក្នុង មួយ ថ្ងៃ ។ ដោយឡែក អ្នកជំងឺ ចំនួន ២២. ១៧២ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
អភិបាល ខេត្ត កំពត ជំរុញ ឱ្យ មន្ទីរ - អង្គភាព បង្កើន ស្មារតី លើ ការរៀបចំ គម្រោង ចំណូល សម្រាប់ ឆ្នាំ ២០២២ សំដៅ បម្រើ ប្រយោជន៍ សាធារណៈ ឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ជំរុញ ឲ្យ ថ្នាក់ដឹកនាំ នៃ មន្ទីរ - អង្គភាព នីមួយ ៗ ត្រូវ បង្កើន ស្មារតី លើ ការរៀបចំ គម្រោង ចំណូល ថវិកា របស់ ខេត្ត កំពត់ សម្រាប់ ឆ្នាំ ២០២២ ដើម្បី ជួយ បន្ត ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ពន្ធ និង សេដ្ឋកិច្ច - សង្គម នៅក្នុង ខេត្ត សំដៅ បម្រើ ប្រយោជន៍ សាធារណៈ ក៏ ដូចជា ប្រជាពលរដ្ឋ បាន កាន់តែ ប្រសើរឡើង ថែម ទៀត ។
ការលើកឡើង របស់ លោក អភិបាល ខេត្ត ជា វ តាយ ត្រូវបាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ពិនិត្យ ពិភាក្សា ស្ដីពី ការរៀប គម្រោង ចំណូល របស់ រដ្ឋបាល ខេត្ត សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០២២ ។ កិច្ចប្រជុំ នេះ ធ្វើឡើង នៅ សាល ប្រជុំ សាលា ខេត្ត នា ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ ដោយ ចូលរួម ពី មន្ត្រី នៃ មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ ដែល មាន លទ្ធភាព អាច ប្រមូល ប្រភព ចំណូល ចូល ថវិកា រដ្ឋ ។
ដោយ ការប្រមូល នេះ ទៀតសោត ផ្អែក លើ មូលដ្ឋាន ទិន្នន័យ សមស្រប និង ផ្អែក តាម ប្រភេទ និង តម្លៃ សេវា ដែល បាន កំណត់ ក្នុង លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន និង ត្រូវ គ្រោង ចំណូល ដែល បាន ប៉ាន់ស្មាន នេះ នៅក្នុង គម្រោង ថវិកា ប្រចាំ ឆ្នាំ របស់ ខ្លួន ទៅតាម ចំណាត់ថ្នាក់ នៃ មាតិកា ថវិកា ។
លោក ជា វ តាយ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ថ្នាក់ដឹកនាំ មន្ទីរ - អង្គភាព នីមួយ ៗ ដែល ពាក់ព័ន្ធ មាន ប្រភព ចំណូល ត្រូវ បង្កើន ស្មារតី យកចិត្តទុកដាក់ ក្នុង ការប្រមូល ឲ្យ មាន ប្រសិទ្ធភាព គ្រប់ ប្រភព ចំណូល ថវិកា ខេត្ត សម្រាប់ បន្ត ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ពន្ធ និង សេដ្ឋកិច្ច - សង្គម នៅក្នុង ខេត្ត សំដៅ បម្រើ ប្រយោជន៍ សាធារណៈ ក៏ ដូចជា ប្រជាពលរដ្ឋ បាន កាន់តែ ប្រសើរឡើង ថែម ទៀត » ។
កិច្ចប្រជុំ នេះ គឺជា ការផ្ដល់ ឱកាស ដល់ មន្ទីរ - អង្គភាព វិស័យ ជំនាញ ពាក់ព័ន្ធ តាមរយៈ ការប្រគល់ ឬ ការធ្វើ ប្រតិភូកម្ម មុខងារ ពី ក្រសួង - ស្ថាប័ន នានា ក្នុង ការបម្រើ សេវា រដ្ឋបាល និង សេវា សាធារណៈ ផ្សេង ទៀត ព្រមទាំង ប្រភព ចំណូល ដែល មិន មែន សារពើពន្ធ ។
