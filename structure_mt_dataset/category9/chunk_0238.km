* ផល ប៉ះពាល់ បង្កឡើង ដោយ រដ្ឋប្រហារ
ព្រឹត្តិការណ៍ ថ្ងៃទី១ ខែកុម្ភៈ កន្លងទៅ ដែល បណ្ដា ប្រទេស លោក ខាងលិច ជាពិសេស សហរដ្ឋ អាមេរិក ចាត់ទុក ថា ជា ការធ្វើ រដ្ឋប្រហារ ទម្លាក់ រដ្ឋាភិបាល ស៊ីវិល ជាប់ ឆ្នោត របស់ លោកស្រី អោង សាន ស៊ូជី បាន បង្កឱ្យ មាន បាតុករ តវ៉ា នៅ ទូទាំង ប្រទេស មីយ៉ាន់ម៉ា ហើយ ក្នុង នោះ ក៏ មាន ផងដែរ ការវាយប្រហារ លើ រោងចក្រ ចិន ជាច្រើន ក្នុង ទីក្រុង រ៉ង់ ហ្គូន និង នៅ តាម ទីក្រុង ដទៃ ទៀត ។
ដោយឡែក ក្រុម អ្នកតាមដាន ស្ថានការណ៍ នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា យល់ ថា ការប្រមូលផ្ដុំ កងទ័ព នេះ គឺជា ការត្រៀមខ្លួន ការពារ ផលប្រយោជន៍ របស់ ចិន . ថែរក្សា ស្ថិរភាព នៅ តំបន់ ព្រំដែន ក៏ ដូចជា ត្រៀមខ្លួន ទប់ស្កាត់ កុំ ឱ្យ ជម្លោះ រាលដាល ឬ លំហូរ ជនភៀសខ្លួន ចូលមក ក្នុង ទឹកដី ចិន ចំពេល វិបត្តិ នៅ ប្រទេស មីយ៉ាន់ម៉ា ហាក់ដូចជា មិន មាន សញ្ញា ថា មាន ច្រក ចេញ ទាល់តែសោះ ។
គួរ បញ្ជាក់ ថា ចិន ធ្លាប់ បាន អះអាង ថា ជារឿយ ៗ ថា ខ្លួន គាំទ្រ ជានិច្ចការ ដោះស្រាយ វិបត្តិ នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា ដោយ សន្តិវិធី និង តាមរយៈ យន្ដ ការអាស៊ាន ។ អាស៊ាន ក៏ ធ្លាប់ បាន បើក កិច្ចប្រជុំ ពិសេស ជាមួយ អគ្គ មេបញ្ជាការ យោធា មីយ៉ាន់ម៉ា លោក មីង អោង ហ្លេង ហើយ ថែមទាំង បាន ឈានដល់ ការឯកភាព គ្នា អំពាវនាវ ឱ្យ បទ ឈប់ បាញ់ និង បញ្ឈប់ រាល់ អំពើហិង្សា ជាបន្ទាន់ ទៀតផង ។ ប៉ុន្តែ មក ទល់នឹង ពេល នេះ គេ មិន ទាន់ ឃើញ មាន សញ្ញា ធូរស្រាល ឬ វិជ្ជមាន ណាមួយ នៅឡើយ ទេ ៕
រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ១៣នាក់
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ថា គិត មកដល់ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ខេត្ត ស្ទឹងត្រែង មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ៣៦៤ នាក់ ជាសះស្បើយ ចំនួន ២៣នាក់ និង កំពុង សម្រាក ព្យាបាល ចំនួន ៣១៤ នាក់ ៕
សូម អាន ការប្រកាស ដំណឹង របស់ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង ប្រមុខ ការទូត កម្ពុជា លើកឡើង ពី សារសំខាន់ ក្នុង ការជំរុញ ឱ្យ វ៉ាក់សាំង បង្ការ កូវីដ១៩ ក្លាយជា ទំនិញ សាធារណៈ សកល
( ភ្នំពេញ ) ៖ នៅ កិច្ចប្រជុំ ពិសេស រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន - រុស្ស៊ី ដើម្បី រំលឹក ខួប អនុស្សាវរីយ៍ លើក ទី ២៥ នៃ ភាពជាដៃគូ សន្ទនា អាស៊ាន - រុស្ស៊ី តាម ប្រព័ន្ធ វីដេអូ នៅ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ក្រសួង ការបរទេស កម្ពុជា បាន សង្កត់ធ្ងន់ ពី សារសំខាន់ នៃ ការជំរុញ ឱ្យ វ៉ាក់សាំង បង្ការ កូវីដ១៩ ក្លាយជា ទំនិញ សាធារណៈ សកល សម្រាប់ ប្រទេស នានា លើ ពិភពលោក ។
សៀវភៅ នេះ ត្រូវបាន តំកល់ នៅ បណ្ណាល័យ ជាតិ . បណ្ណាល័យ សម្តេច តេជោ សាលា ភូមិន្ទ ភ្នំពេញ . បណ្តាល័យ ហ៊ុន សែន សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង ផងដែរ សម្រាប់ និស្សិត ជា ឯកសារ សិក្សា ស្រាវជ្រាវ ។ បន្ថែម ពីលើ ការតំកល់ទុក នៅ តាម បណ្តាល័យ នានា ខាងលើ ក៏ មាន តំកល់ នៅ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . ក្រសួង ឧស្សហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង និវានុវត្តន៍ និង សាលា រាជធានី ភ្នំពេញ ផងដែរ ។
អាជ្ញាធរ ជាតិ ព្រះវិហារ ដាំ ដើម ធ្នង់ ចំនួន ១១១៣ ដើម តាម ដងផ្លូវ ចូលក្នុង រមណីយដ្ឋាន ប្រាសាទ ព្រះវិហារ ក្នុង ឱកាស ខួប លើក ទី ១៣ នៃ ការចុះ ប្រាសាទ ព្រះវិហារ ជា បេតិកភណ្ឌ ពិភពលោក
( ព្រះវិហារ ) ៖ នា ព្រឹក ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ អាជ្ញាធរ ជាតិ ព្រះវិហារ បាន ប្រារព្ធ ពិធី ដាំ ដើម ធ្នង់ ចំនួន ១១១៣ ដើម តាម ដងផ្លូវ ចូលក្នុង រមណីយដ្ឋាន ប្រាសាទ ព្រះវិហារ ក្នុង ឱកាស អបអរសាទរ ខួប លើក ទី ១៣ នៃ ការចុះ ប្រាសាទ ព្រះវិហារ ជា បេតិកភណ្ឌ ពិភពលោក ។
ពិធី នេះ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ មន្រ្តី សន្តិសុខ អភិរក្ស នៃ អាជ្ញាធរ ជាតិ ព្រះវិហារ សរុប ប្រមាណ ៣០ រូប ។
ការរៀបចំ ពិធី អបអរសាទរ ដោយ ការដាំ ដើមឈើ តាម ដងផ្លូវ ជាតិ លេខ ៦២ ឆ្ពោះ ទៅកាន់ ប្រាសាទ ព្រះវិហារ ក្នុង ចម្ងាយ ផ្លូវ ១៥គីឡូម៉ែត្រ នេះ មាន គោលបំណង លើកកម្ពស់ ទេសភាព តាម ដងផ្លូវ ចូល ទៅកាន់ ប្រាសាទ ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ ផង និង ដើម្បី បំផុស ស្មារតី ប្រជាពលរដ្ឋ អោយ ស្រលាញ់ បរិស្ថាន ព្រៃឈើ និង ធនធាន ធម្មជាតិ ស្រប តាម ពាក្យស្លោក “ រួមគ្នា ថែរក្សា ព្រៃឈើ និង ធនធាន ធម្មជាតិ ដើម្បី បេតិកភណ្ឌ របស់ យើង ” ។
ការដាំ ដើមឈើ នេះ នឹង ជា សមិទ្ធិផល ថ្មី មួយ បន្ថែម ទៀត លើ កិច្ច ខិតខំ ប្រឹងប្រែង ការពារ បរិស្ថាន ព្រៃឈើ និង ធនធាន ធម្មជាតិ ដែល អាជ្ញាធរ ជាតិ ព្រះវិហារ តែងតែង អនុវត្ត ប្រចាំ ឆ្នាំ ក្នុង ការទប់ស្កាត់ ភ្លើង ឆេះ ព្រៃ ការពារ ដំណុះ កូន ឈើ ធម្មជាតិ ការដាំ កូន ឈើ ឡើងវិញ និង សកម្មភាព ទប់ស្កាត់ ការកាប់បំផ្លាញ ព្រៃឈើ ការឈូសឆាយ ដី ព្រៃ ជាដើម ៕
រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា អ្នកជំងឺ កូវីដ១៩ ទាំង ៥៩ នាក់ ខាងលើ នេះ មូលដ្ឋាន ក្នុង ស្រុក ចំនួន ១១ រួម មាន ក្រុង ព្រៃវែង ៦នាក់ . ស្រុក ពាមរក៍ ចំនួន ១៩ នាក់ . ស្រុក ស្វាយអន្ទរ ចំនួន ១០នាក់ . ស្រុក បាភ្នំ ចំនួន ៥នាក់ . ស្រុក ព្រះសេ្ដច ចំនួន ៥នាក់ . ស្រុក កញ្ច្រៀច ចំនួន ៤នាក់ . ស្រុក មេសាង ចំនួន ៣នាក់ . ស្រុក ពារាំង ចំនួន ២នាក់ . ស្រុក ពាម ជរ ចំនួន ២នាក់ . ស្រុក កំពង់ត្របែក ចំនួន ២នាក់ និង ស្រុក សុីធរ កណ្តាល ចំនួន ១នាក់ ។
បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ទាំង ៥៩ នាក់ ខាងលើ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង តាម មន្ទីរពេទ្យ បង្អែក ស្រុក របស់ ពួកគេ នីមួយ ៗ ។
ការសម្រេច ដាក់ រតនសម្បត្តិ របស់ កម្ពុជា ទៅក្នុង បញ្ជី បេតិកភណ្ឌ ពិភពលោក នេះ ត្រូវបាន ធ្វើឡើង នា សម័យ ប្រជុំ លើក ទី ៣២ នៅ ទីក្រុង កេបិក ប្រទេស កាណាដា ។ ការសម្រេច របស់ អង្គការ យូណេស្កូ គឺជា ជោគជ័យ ដ៏ ធំធេង មួយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ និង ចង្អុលបង្ហាញ របស់ សម្តេច តេជោ ហ៊ុន សែន និង ការប្រឹងប្រែង របស់ មន្ត្រី ពាក់ព័ន្ធ ជា សេនាធិការ ដឹកនាំ ដោយ សម្តេច វិបុល បញ្ញា សុខ អាន ។
មុន ឈានដល់ ការសម្រេច យល់ព្រម ពី អង្គការ យូណេស្កូ នេះ កម្ពុជា បាន ប្រឹងប្រែង តស៊ូ មតិ និង ការរៀបចំ ដាក់ សំណុំ ឯកសារ មិន តិច នោះ ឡើយ ។
ប្រវត្តិ នៃ ការកសាង ប្រាសាទ ព្រះវិហារ មាន នៅលើ សិលាចារឹក ខ្មែរ នៅឯ ប្រាសាទ បាពួន ក្នុង ខេត្ត សៀមរាប គឺ កាលេខ ៥៨៣៖ « អ្នក ដែល សរសេរ សិលាចារឹក ហ្នឹង ឈ្មោះ ហរិ វា ហៈ នៅក្នុង រជ្ជកាល ព្រះបាទ រាជិន្រ្ទ វ រ័ន្ម គ្រិស្ត សករាជ ៩៤៤ ដល់ ៩៦៨ ។ គេ សរសេរ ជា ភាសា សំស្រ្កឹត និង ជា ភាសា ខ្មែរ ។
ចំពោះ សេចក្តីសិលាចារឹក នេះ អ្នកប្រាជ្ញ ខាង ប្រវត្តិសាស្ត្រ គិត ថា មិន មាន សិលាចារឹក ឯណា ទៀត និយាយ ពី ចម្បាំង ទៅ ចាប់ ស្តេច ចាម នោះ ទេ ក៏ប៉ុន្តែ ស្តេច ដែល លោក ចាប់ បាន នោះ ប្រហែលជា មិន មែន ជា ស្តេច ចាម ដែល ត្រួត ប្រទេស ចាម ទាំងមូល នោះ ទេ ។ ប្រហែលជា ស្តេច អង្គ តូច មួយ ដែល ត្រួត នៅ នគរ មួយ ដែល មាន ព្រំប្រទល់ នៅជាប់ នឹង ប្រទេស ខ្មែរ ៕ អបអរសាទរ ខួប ១៣ឆ្នាំ នៃ ការដាក់បញ្ចូល ប្រាសាទ ព្រះវិហារ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក (Video inside)
( ភ្នំពេញ ) ៖ ថ្ងៃទី ៧ ខែកក្កដា នេះ គឺជា ខួប ១៣ឆ្នាំ ហើយ នៃ ការដាក់បញ្ចូល ប្រាសាទ ព្រះវិហារ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក នា កិច្ចប្រជុំ ទី៣២ របស់ គណៈកម្មាធិការ បេតិកភណ្ឌ ពិភពលោក របស់ អង្គការ យូណេស្កូ (UNESCO) កាលពី ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០០៨ នៅ ទីក្រុង កេបិច ប្រទេស កាណាដា ។
សូម ទស្សនា វីដេអូ ឯកសារ រៀបចំ ដោយ អាជ្ញាធរ ជាតិ ព្រះវិហារ ។ បច្ចុប្បន្នភាព ប្រចាំ ថ្ងៃ៖ គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៧ ខែកក្កដា នេះ តំបន់ អាស៊ាន មាន អ្នក ឆ្លង កូវីដ១៩ ជាង ៥. ១៩លាន នាក់ ស្លាប់ ជាង ៩. ៩៦ម៉ឺន នាក់
តាមរយៈ ទំព័រ ហ្វេសប៊ុក សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ចូលរួម អបអរសាទរ ចំពោះ ថ្ងៃ ដែល ប្រាសាទ ព្រះវិហារ ត្រូវបាន តម្កល់ ជា សម្បត្តិ មនុស្សជាតិ ពិភពលោក នេះ ។
សម្តេច តេជោ បាន ចាត់ទុក ព្រឹត្តិការណ៍ នៃ ការដាក់ ប្រាសាទ ព្រះវិហារ ក្នុង បញ្ជី បេតិកភណ្ឌ ពិភពលោក នេះ ជា ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ថ្មី មួយ បើ គិត ចាប់តាំងពី កម្ពុជា ទទួលបាន ប្រាសាទ ដ៏ ពិសិដ្ឋ មួយ នេះ ក្រោយ ឈ្នះ ក្តី លើ ប្រទេស ថៃ នៅ តុលាការ អន្តរជាតិ ក្រុង ឡាអេ នា ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ១៩៦២ ។
ជាមួយ ការអបអរសាទរ សម្តេច តេជោ ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាជាតិ កម្ពុជា រួមគ្នា រក្សា ការពារ ប្រាសាទ បុរាណ របស់ ខ្មែរ ទាំងអស់ ឱ្យ បាន គង់វង្ស ដើម្បី ជា មរតក ជូន ដល់ កូន ខ្មែរ ជំនាន់ ក្រោយ ។
ប្រាសា ព្រះវិហារ ជា ប្រាសាទ ដ៏ ពិសិដ្ឋ របស់ កម្ពុជា ស្ថិត នៅលើ ភ្នំ ដងរែក មាន កម្ពស់ ៦២៥ ម៉ែត្រ ធៀប ផ្ទៃ ទឹក សមុទ្រ ក្នុង ភូមិសាស្ត្រ ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ មាន ចម្ងាយ ប្រហែល ១០០ គីឡូម៉ែត្រ ខាងជើង ទីក្រុង ព្រះវិហារ និង ប្រមាណ ២៣០ គីឡូម៉ែត្រ ភាគ ឦសាន នៃ ក្រុង សៀមរាប និង ប្រមាណ ៤១៤ គីឡូម៉ែត្រ ភាគ ខាងជើង រាជធានី ភ្នំពេញ ។
សូម រំលឹក ថា ក្នុង បុព្វហេតុ លើក តម្លៃ មរតក វប្បធម៌ ជាតិ និង ការពារ អធិបត យ្យភាព ជាតិ ឱ្យ បាន គង់វង្ស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ផ្ញើ លិខិត ទៅ អង្គការ យូណេស្កូ ឆ្នាំ ២០០១ ដើម្បី ស្នើសុំ ចុះបញ្ជី ប្រាសាទ ព្រះវិហារ ជា បេតិកភណ្ឌ ពិភពលោក ។ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី មានប្រសាសន៍ ថា ការដាក់ ប្រសាទ ព្រះវិហារ ទៅក្នុង បញ្ជី បេតិកភណ្ឌ ពិភពលោក គឺ ធ្វើឡើង តាម ផែនការ ដែល គ្រោង ទុក ដែល ជា អាទិភាព នៃ គោល នយោបាយ បរទេស របស់ កម្ពុជា ។
ដើម្បី អបអរសាទរ ចំពោះ ជោគជ័យ ដ៏ ធំធេង នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន កំណត់ យក ថ្ងៃទី ១០ ខែកក្កដា ជា ទិវា ជាតិ នៃ ការចងចាំ ចំពោះ ការដាក់ ប្រាសាទ ព្រះវិហារ រួម និង ប្រាសាទ សំបូរ ព្រៃ គុក ទៅក្នុង បញ្ជីសម្បត្តិ បេតិកភណ្ឌ ពិភពលោក និង ណែនាំ ឱ្យ រៀបចំ ពិធី អបអរសាទរ នេះ ឱ្យ បាន អធិកអធម ថែម ទៀត ផង ៕ បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៣នាក់ និង របួស ២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៦ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ២នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន និង បត់ / មិន ប្រយ័ត្ន ៕
