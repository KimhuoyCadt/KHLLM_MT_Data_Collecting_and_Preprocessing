( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ៩ ខែកក្កដា ឆ្នាំ ២០២១ នេះ អម ដំណើរ ដោយ ព្រះនាគ មុនី មេ គណ ខេត្ត និង សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា បាន និមន្ត និង អញ្ជើញ ចុះ ប្រគល់ ផ្ទះ បន្ទាប់ ទី២ ជា ផ្ទះ មនុស្សធម៌ ខេត្ត ក្រោម កិច្ចសហការ រវាង សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត និង សាលា គណ ខេត្ត ជូន ជន មាន ពិការ ភាព ក្រ លំបាក ម្នាក់ ឈ្មោះ ឆែក ភ័ក្ត្រ អាយុ ៣១ ឆ្នាំ រស់ នៅ ភូមិ ព្រែក ទក់ ឃុំ ខ្ពប តា ងួន ស្រុក ស្ទឹងត្រង់ ។
នាយក ប្រតិបត្តិ សាខា កាកបាទ ក្រហម ខេត្ត កំពង់ចាម លោក ទូច ឆៃ បាន ឲ្យដឹង ថា ឈ្មោះ ឆែក ភ័ក្ត្រ មាន ប្រពន្ធ និង កូនស្រី ២នាក់ ក្នុង បន្ទុក ។ ដើម ឡើយ គាត់ មាន មុខរបរ ជាជាង ផ្សារ ដែក ប៉ុន្តែ ជា អកុសល កាលពី ២ឆ្នាំ មុន ពេល កំពុង ផ្សារ ដំបូល ផ្ទះ គេ ស្រាប់តែ ឆក់ ចរន្ត អគ្គិសនី បណ្តាលឲ្យ ជើង ទាំង២ របស់ គាត់ រលាក រលួយ ហើយ ទីបំផុត ត្រូវ កាត់ចោល ក្រោម ជង្គង់ ធ្លាក់ខ្លួន ពិការ បាត់បង់ សមត្ថភាព ពលកម្ម រហូតមក ។
លោក ទូច ឆៃ បន្ត ថា គ្រួសារ នោះ ក្រៅពី ការជួយ ឧបត្ថម្ភ របស់ រដ្ឋ តាមរយៈ ប័ណ្ណ ក្រ១ អម្រែក មេ គ្រួសារ បាន ធ្លាក់ មក លើ ប្អូន ស្រី ជា ប្រពន្ធ ដែល ធ្លាប់ ជា មេផ្ទះ បង្ខំ ចិត្ត ដើរ ស៉ី ឈ្នួល ជម្រះ ស្មៅ ឬ មើល ថែ ចំការតាម រដូវ ដើម្បី បាន កម្រៃ ប្រចាំ ថ្ងៃ ចិញ្ចឹម ប្តី ពិការ និង កូនស្រី ទាំង ២នាក់ ។ ដោយ លទ្ធភាព ខ្សត់ខ្សោយ គ្រួសារ នេះ រស់ នៅក្នុង កូន ខ្ទម ទ្រុឌទ្រោម ដែល បិទបាំង ដោយ ដែក សង្កសី ចាស់ ៗ ដែល បងប្អូន អ្នកជិតខាង ផ្តល់ឲ្យ ។
ដោយ មើលឃើញ ពី ស្ថានភាព លំបាក នេះ ទើប លោក អ៊ុន ចាន់ ដា បាន សម្រេច ផ្តល់ ជូន ផ្ទះ ឈើ ខ្ពស់ ផុត ពី ដី ប្រក់ ស័ង្កសី ( ទំហំ ៤ម ×៦ម ) ១ខ្នង ជូន គ្រួសារ នោះ សម្រាប់ ស្នាក់ នៅ តទៅ ដែល ត្រូវ ចំណាយ ទឹកប្រាក់ ក្នុង ការសាងសង់ អស់ ជិត ១០លាន រៀល ក្នុង នេះ សាខា កាក បាត ក្រហម ខេត្ត បាន បដិភាគ ចំនួន ១លាន រៀល និង លោក អ៊ុន ចាន់ ដា បាន ឧបត្ថម្ភ ១លាន រៀល . ព្រះមេ គណ ខេត្ត ១លាន រៀល ។ ក្រៅពី នោះ ជា ការចូលរួម បំពេញ បន្ថែម របស់ សប្បុរសជន និង ក្រុមការងារ ចលនា កៀរគរ និង គ្រប់គ្រង មូលនិធិ នៃ កម្មវិធី ។
ដោយឡែក ពលរដ្ឋ ខ្វះខាត ជីវភាព ចំនួន ១៣គ្រួសារ ទៀត ដែល បាន ចូលរួម នា ពេល នោះ ទទួលបាន អំណោយ ក្នុង ១គ្រួសារ មាន អង្ករ ត្រីខ ឃីត មី ទឹកត្រី ទឹក ស៉ី អ៉ីវ និង អាវយឺត ព្រមទាំង ថវិកា ចំនួន ២០.០០០ រៀល ផងដែរ ៕
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការបន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៩៨៨ នាក់ ខណៈ អ្នកជំងឺ ចំនួន ៨៩៧ នាក់ ជាសះស្បើយ ។
សូម ជម្រាប ថា គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៥៩. ០៤៥ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ សរុប ចំនួន ៥០. ៩១៧ នាក់ និង ស្លាប់ សរុប ចំនួន ៨៥៥ នាក់ ៕ សេចក្តីព្រាង ច្បាប់ ស្តីពី វិនិយោគ ត្រូវបាន រាជ រដ្ឋាភិបាល អនុម័ត ទាំងស្រុង ហើយ
( ភ្នំពេញ ) ៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការវិនិយោគ ត្រូវបាន រាជ រដ្ឋាភិបាល អនុម័ត ទាំងស្រុង ហើយ ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី ដឹកនាំ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នា ព្រឹក ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ។
លោក ផៃ ស៊ីផាន រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ ថា សេចក្តីព្រាង ច្បាប់ នេះ មាន ការកែសម្រួល នូវ ពាក្យពេចន៍ និង ខ្លឹមសារ នៃ មាត្រា ៩ ជំពូក ទី៣ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ក្នុង កិច្ចប្រជុំ នោះ ថា សំណើ ច្បាប់ នេះ ជា មូលដ្ឋាន គតិយុត្តិ សម្រាប់ ទាក់ទាញ និង ផ្តល់ វិសាលភាព ដល់ វិនិយោគិន ងាយស្រួល ក្នុង កិច្ច វិនិយោគ មក កម្ពុជា ។
សូម បញ្ជាក់ ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី វិនិយោគ ជា សេចក្តីព្រាង ច្បាប់ ថ្មី មួយ ដែល ត្រូវបាន ផ្តួចផ្តើម និង ចង្អុលបង្ហាញ ដោយ ឯកសារ គោល នយោបាយ អភិវឌ្ឍន៍ វិស័យ ឧស្សាហកម្ម កម្ពុជា ឆ្នាំ ២០១៥ - ២០២៥ ។
លោក ផៃ ស៊ីផាន បាន បញ្ជាក់ ថា ការងារ សិក្សា និង តាក់តែង សេចក្តីព្រាង ច្បាប់ បឋម នេះ ត្រូវបាន ធ្វើឡើង យ៉ាង ម៉ត់ចត់ ដោយ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ( ក . អ. ក) ។ នៅក្នុង កិច្ច ដំណើរការ នៃ ការតាក់តែង សេចក្តីព្រាង ច្បាប់ បាន ប្រជុំ ពិគ្រោះយោបល់ ជាមួយ តំណាង ផ្នែក ឯកជន និង អង្គ ពាក់ព័ន្ធ ផ្សេង ទៀត ជាច្រើន លើក ច្រើន សារ ដើម្បី ធ្វើ ការប្រមូល ធាតុ ចូល ។
រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី រូប នេះ បាន បន្ថែម ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី ការវិនិយោគ រៀបចំឡើង ក្នុង គោលបំណង បង្កើត នូវ ក្របខ័ណ្ឌ គតិយុត្ត ដែល បើកចំហ មាន តម្លាភាព អាច ប៉ាន់ប្រមាណ ទុក ជាមុន បាន ប្រកបដោយ ភាព អំណោយផល សម្រាប់ ការវិនិយោគ ដើម្បី ទាក់ទាញ និង លើកកម្ពស់ ការវិនិយោគ ដោយ បុគ្គល សញ្ជាតិ ខ្មែរ ឬ បរទេស ប្រកបដោយ គុណភាព ប្រសិទ្ធភាព និង ប្រសិទ្ធផល សំដៅ អភិវឌ្ឍ សង្គម សេដ្ឋកិច្ច នៅ កម្ពុជា ។
សេចក្តីព្រាង ច្បាប់ ក៏ ត្រូវបាន រៀបចំឡើង ឱ្យ មាន ភាពបត់បែន ដោយ មាន ការផ្តល់ ការលើកទឹកចិត្ត ពិសេស ចំពោះ វិស័យ និង សកម្មភាព វិនិយោគ ជាក់លាក់ ណាមួយ ដែល មាន សក្តានុពល ខ្ពស់ ក្នុង ការចូលរួមចំណែក អភិវឌ្ឍ ជាតិ ស្រប ទៅតាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដោយ ការលើកទឹកចិត្ត ពិសេស នេះ នឹង ត្រូវ កំណត់ នៅក្នុង ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ។
