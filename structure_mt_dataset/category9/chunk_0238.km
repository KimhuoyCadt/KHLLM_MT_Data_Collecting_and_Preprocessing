( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០២១ បាន ថ្លែងអំណរគុណ ដល់ ក្រុម សប្បុរសជន យ៉ាង ជ្រាលជ្រៅ បំផុត ដែល បាន ជួយ ឧបត្ថម្ភ អាវ ពេទ្យ PPE ម៉ាស ថ្នាំ ចិន និង គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ដល់ រដ្ឋបាល ខេត្ត សម្រាប់ ចូលរួម ក្នុង ប្រតិបត្តិការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ដែល កំពុង បង្ក គ្រោះ ភ័យ ដល់ សុខភាព និង អាយុជីវិត របស់ ប្រជាជន ។
ជាមួយគ្នា នេះ ក្នុង នាម អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល លោកស្រី បាន ស្នើ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ជាធរមាន លើ ការក្លែងបន្លំ ផេក ហ្វេសបុក ក្រសួង សុខាភិបាល បែប នេះ ៕ តើ ជីវភាព ធូរធារ បង្គួរ គឺ យ៉ាងដូចម្តេច ? ចម្លើយ គឺ ស្ថិត នៅលើ ការស្លៀកពាក់ ការហូបចុក លំនៅដ្ឋាន និង វិធី ធ្វើដំណើរ របស់ ប្រជាជន ចិន
( ប៉េកាំង ) ៖ ក្នុង មហាសន្និបាត អបអរសាទរ ខួប ទី ១០០ នៃ ការបង្កើត បក្ស កុម្មុយនិស្ត ចិន កាលពី ថ្ងៃទី១ ខែកក្កដា លោក Xi Jinping មេដឹកនាំ កំពូល របស់ ចិន បាន ប្រកាស យ៉ាង ម៉ឺងម៉ាត់ ថា ប្រទេស ចិន បាន សម្រេច ការកសាង សង្គម ដែល ប្រជាជន មាន ជីវភាព ធូរធារ បង្គួរ ដោយ គ្រប់ ជ្រុងជ្រោយ ។ តើ ជីវភាព ធូរធារ បង្គួរ គឺ យ៉ាងដូចម្តេច ? ចម្លើយ គឺ ស្ថិត នៅលើ ការស្លៀកពាក់ ការហូបចុក លំនៅដ្ឋាន និង វិធី ធ្វើដំណើរ របស់ ប្រជាជន ចិន ។
ដើម្បី ដោះស្រាយ បញ្ហា ហូបចុក របស់ ប្រជាជន ដែល មាន ចំនួន ១ ភាគ ៥ លើ ពិភពលោក ប្រទេស ចិន បាន ខិតខំ ប្រឹងប្រែង ជាប់ រហូតមក ។ មួយ ផ្នែក បាន លើកកម្ពស់ បរិមាណ បង្កបង្កើន ផល ស្បៀងអាហារ មួយ ផ្នែក ទៀត គឺ ផ្តួចផ្តើម គំនិត ស្តីពី ការសន្សំ សំចៃ ស្បៀងអាហារ ។
គណៈ បញ្ជាការ រដ្ឋបាល ឯកភាព ខេត្ត បាត់ដំបង ណែនាំ និង ពង្រឹង បន្ត ទៀត ដល់ អាជ្ញា មូលដ្ឋាន ពី ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នៅ តាម សហគម របស់ ខ្លួន
( បាត់ដំបង ) ៖ លោក ងួន រតនៈ អភិបាល ខេត្ត និង ជា ប្រធាន គណៈ បញ្ជាការ រដ្ឋបាល ឯកភាព ខេត្ត បាត់ដំបង បាន ជំរុញឱ្យ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ និង អាជ្ញាធរ មូលដ្ឋាន បន្ត ទប់ស្កាត់ ការពារ ជំងឺ ឆ្លង កូវីដ១៩ បន្ត ទៀត ដើម្បី កុំ ឱ្យ រីករាលដាល នៅ តាម សហគមន៍ ឃើញ មាន ការកើនឡើង ជារៀងរាល់ ថ្ងៃ ។
ការជំរុញ បែប នេះ បាន ធ្វើឡើង នៅក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ កិច្ចប្រជុំ គណៈ បញ្ជាការ រដ្ឋបាល ឯកភាព ខេត្ត បាត់ដំបង ប្រចាំ ខែមិថុនា នា ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០២១ នៅ សាលា ខេត្ត ដោយ មាន ការចូលរួម ពី ថ្នាក់ អភិបាល រង ខេត្ត លោក មេបញ្ជាការ មេបញ្ជាការ យោធ ភូមិភាគ ទី៥ មេបញ្ជាការប្រតិបត្តិការ សឹក រង បាត់ដំបង ស្នងការ នគរបាល ខេត្ត មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត អភិបាល ក្រុង - ស្រុក មន្ទីរ ជំនាញ នានា ជុំវិញ ខេត្ត ចូលរួម ផងដែរ ។
ក្នុង កម្មវិធី នៃ កិច្ចប្រជុំ នេះ ដែរ មន្ទីរ ជំនាញ បាន ឡើង រាយការណ៍ ទៅ តាម ជំនាញ របស់ ខ្លួន ដូច ខាងក្រោម : អំណាន របាយការណ៍ ប្រចាំ ខែមិថុនា ឆ្នាំ ២០២១ របស់ គណ: បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ដោយ មន្រ្តី លេខាធិការដ្ឋាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ស្តីពី លទ្ធផល និង សកម្មភាព ដែល បាន កើត មាន ឡើង ក្នុង ខេត្ត ប្រចាំ ខែមិថុនា ឆ្នាំ ២០២១ កន្លងមក ។
ក្នុង ឱកាស នោះ ដែរ មន្រ្តី ជំនាញ ពាក់ព័ន្ធ នៅ តាម អង្គភាព នានា និង អាជ្ញាធរ មូលដ្ឋាន ក្រុង ស្រុក បាន ឡើង រាយការណ៍ ពី សកម្មភាព ដែល បាន កើតឡើង នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ជូន ដល់ កិច្ចប្រជុំ គណ: បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ដើម្បី សុំ យោបល់ និង រក វិធានការ ទប់ស្កាត់ បន្ត ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ពលករ ដែល ត្រូវ សមត្ថកិច្ច បាន បញ្ជូន មក យើង ត្រូវ ធ្វើចត្តាឡី ស័ក ដែល មាន ស្រាប់ នៅ តាម មណ្ឌល រយ : ១៤ ថ្ងៃ សិន ដោយ មាន មន្រ្តី ជំនាញ ប្រចាំ ការចុះ ពិនិត្យ សុខភាព ជូន ពលករ រាល់ ថ្ងៃ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការរីករាលដាល និង នាំចូល ពី ប្រទេស ថៃ តាម ច្រក ផ្សេង ៗ តាម បន្ទាត់ ព្រំដែន កម្ពុជា . ថៃ គ្រប់ ពេល និង បន្ត ធ្វើ ប្រចាំ ថ្ងៃ ដោយ ម៉ាស៊ីន តេស្តិ៍រហ័ស ឬ ពិនិត្យ ទៅ តាម ការជាក់ស្តែង ។
ជាមួយគ្នា នេះ ដែរ មន្រ្តី ជំនាញ ស៊ីវិល នានា យើង ក៏ ត្រូវ សហការ ជាមួយ កងកម្លាំង គ្រប់ ប្រភេទ ពិសេស កងកម្លាំង ការពារ ព្រំដែន គោក ដើម្បី អនុវត្ត ការងារ ឲ្យបាន ល្អ តាម ការងារ ជំនាញ រៀង ៗ ខ្លួន បន្ថែម ទៀត ។ ក្នុង នោះ លោក អភិបាល ខេត្ត ក៏ បាន ធ្វើ ការដោះស្រាយ បញ្ហា មួយចំនួន ផងដែរ តាម ការស្នើសុំ របស់ មន្ទី ជំនាញ ពាក់ព័ន្ធ រៀង ៗ ខ្លួន និង អាជ្ញាធរ មូលដ្ឋាន ក្រុង . ស្រុក ក្រៅពី ការងារ កូវីដ - ១៩ នេះ ដោយ អនុវត្ត តាម ៣កុំ និង ៣ការពារ ផងដែរ ៕
ជា ការឆ្លើយតប រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច លោក ឯ ម ច័ន្ទ មករា បាន ថ្លែង ថា ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ កំពុង ធ្វើ ការរៀបចំ សេចក្តីព្រាង ច្បាប់ ថ្មី សម្រាប់ ជន មាន ពិការភាព កម្ពុជា ។ លោក ឯ ម ច័ន្ទ មករា បាន មានប្រសាសន៍ អរគុណ ចំពោះ ការគាំទ្រ របស់ UNDP ហើយ លោក រដ្ឋលេខាធិការ ក៏ កំពុង ទន្ទឹងរងចាំ គម្រោង ថ្មី ជាច្រើន ទៀត ដើម្បី ជួយ ដល់ តម្រូវការ របស់ ជន មាន ពិការភាព នៅ កម្ពុជា ។
ជាមួយនឹង ការនាំ មកដល់ ផ្ទះ នៅ ខណ្ឌ បឹងកេងកង វិញ នេះ បុរស ជនជាតិ ចិន ជា ម្ចាស់ ក៏ បាន រៀបចំ ធ្វើជា របង ដាក់ សត្វ តោ នៅក្នុង ផ្ទះ ដើម្បី ធានា សុវត្ថិភាព នៃ ការរស់នៅ តាម ការណែនាំ របស់ សម្តេច តេជោ ផងដែរ ។
ម្ចាស់ តោ បាន បញ្ជាក់ ថា តោ ដែល គេ ឱ្យ ខ្លួន នេះ គឺ មិន បាន ដក ធ្មេញ ឬ ដក ក្រចក ដូច ការលើកឡើង នោះ ឡើយ ។ ប៉ុន្តែ បាន ទទួលស្គាល់ ថា ខ្លួន បាន កាត់ ក្រចក ជើង តោ ដើម្បី ការពារ គ្រោះថ្នាក់ ដល់ អ្នក ចិញ្ចឹម ។
