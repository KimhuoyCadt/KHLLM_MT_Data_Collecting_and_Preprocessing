( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា អ៉ឹង ប៊ុន ហ៊ូវ ប្រធាន អគ្គ នាយ ក្រុមហ៊ុន ដូន ពេញ ( ខេមបូឌា ) គ្រុប និង ភរិយា លោកស្រី ហេង សុខា បាន ឧបត្ថម្ភ ទឹក ពិសា ភ្នំ ជបចំនួន ១ពាន់ យួរ ជា លើក ទី២ ជូន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ដែល កំពុង ចូលរួម ធ្វើ សកម្មភាព យ៉ាង សកម្ម ក្នុង ប្រតិបត្តិការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ទឹក ពិសា ភ្នំ ជប១ ពាន់ យួរ នេះ ត្រូវបាន ក្រុមការងារ របស់ លោក ឧកញ៉ា យក ទៅ ប្រគល់ ជូន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស កាល ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២១ កន្លងទៅ នេះ ។
ថ្លែង ក្នុង ពិធី ប្រគល់ - ទទួល ឧត្តមសេនីយ៍ ឯក សេង សុង តំណាង នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស បាន ថ្លែងអំណរគុណ ជ្រាលជ្រៅ ជូន ចំពោះ ទឹកចិត្ត សប្បុរសធម៌ របស់ លោក ឧកញ៉ា អ៉ឹង ប៊ុន ហ៊ូវ និង លោកស្រី ហេង សុខា ដែល តែង ឧបត្ថម្ភ ជា បន្តបន្ទាប់មកកាន់ កងកម្លាំងប្រដាប់អាវុធ ក៏ ដូចជា សកម្មភាព នានា ក្នុង យុទ្ធនាការ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
សូម បញ្ជាក់ ថា លោក ឧកញ៉ា អ៉ឹង ប៊ុន ហ៊ូវ និង ភរិយា តែងតែ បាន ធ្វើ សកម្មភាព មនុស្សធម៌ ដោយ ចូលរួម ជាមួយ ក្រសួង ស្ថាប័ន រដ្ឋ ឧបត្ថម្ភ នូវ សម្ភារ និង របស់របរ ប្រើប្រាស់ នានា ដើម្បី គាំទ្រ ដល់ សកម្មភាព ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ កំពុង រាតត្បាត នៅ កម្ពុជា ៕
( ភ្នំពេញ ) ៖ នៅ គ្រា ដែល កម្ពុជា កំពុង កើតមាន ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ពិសេស វីរុស បំប្លែង ថ្មី ប្រភេទ ដែល តា ដែល រំខាន ដល់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ . អគ្គ នាយកដ្ឋាន ពន្ធដារ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដែល ជា សេនាធិការ របស់ រាជ រដ្ឋាភិបាល លើ ការងារ ប្រមូល ពន្ធ ផ្ទៃក្នុង បាន បង្កើត នូវ កម្មវិធី ឌីជីថល ( កម្មវិធី ទូរស័ព្ទ និង កុំ ព្យួរ ទ័រ ) ដើម្បី សម្រួល ដល់ ការងារ បំពេញ កាតព្វកិច្ច ពន្ធ ជូន អ្នក ជាប់ ពន្ធ ឲ្យ កាន់តែ ងាយស្រួល ។
កម្មវិធី មួយ ក្នុង ចំណោម កម្មវិធី ទូរស័ព្ទ ដៃ ជាច្រើន ដែល បង្កើតឡើង ដោយ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៅ ពេល នេះ កំពុង ទទួល បាន ការចាប់អារម្មណ៍ និង សាទ រ ពី ប្រជាពលរដ្ឋ នោះ គឺ កម្មវិធី បង់ ពន្ធ មធ្យោបាយ ដឹកជញ្ជូន និង យានជំនះ គ្រប់ ប្រភេទ ឆ្នាំ ២០២១ តាមរយៈ ទូរស័ព្ទ ។
មិន ត្រឹមតែ បង្កើត កម្មវិធី ងាយស្រួល បង់ ពន្ធ ប៉ុណ្ណោះ ទេ បន្ទាប់ពី បំពេញ បែបបទ និង បង់ ពន្ធ រួច អ្នក បង់ ពន្ធ នឹង ទទួលបាន នូវ លតាបត្រ ពន្ធ ( សន្លឹក ពន្ធ ) តាមរយៈ ក្រុមការងារ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ដឹក ជូន ដល់ ផ្ទះ ថែម ទៀត ផង ។
ប្រជាពលរដ្ឋ និយាយ ថា កម្មវិធី បង់ ពន្ធ នេះ ងាយស្រួល រហ័ស និង ពិតជា អស្ចារ្យ ណាស់ ដោយ មិន បាច់ ទៅ បង់ ពន្ធ ដោយ ផ្ទាល់ នោះ ទេ ៕
ថ្នាក់ដឹកនាំ សហគមន៍ បន្ត នាំយក អំណោយ ចែកជូន ក្រុមគ្រួសារ សាសនិក ខ្មែរ ឥស្លាម ដែល មាន សមាជិក ឆ្លង ជំងឺ កូវីដ១៩ និង កំពុង ធ្វើចត្តាឡី ស័ក
( សៀមរាប ) ៖ លោក អែល សៀត សមាជិក ក្រុមប្រឹក្សា ខេត្ត និង ជា អនុប្រធាន គណៈ អ៉ីមាំ ខេត្ត សៀមរាប និង លោក ស្រេន សុព្រី ប្រធាន សមាគម សម្ព័ន្ធ យុវជន មូស្លីម កម្ពុជា សាខា ខេត្ត សៀមរាប និង មាន ការចូលរួម ពី សមាជិក សមាជិកា សមាគម សម្ព័ន្ធ យុវជន មូស្លីម កម្ពុជា ផង នោះ បាន យក អំណោយ ទៅ ចែកជូន សមាជិក ក្រុមគ្រួសារ សាសនិក ឥស្លាម ដែល មាន សមាជិក ឆ្លង ជំងឺ កូវីដ១៩ និង កំពុង ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ ។
ដោយឡែក បងប្អូន ខ្មែរ ឥស្លាម មួយ គ្រួសារ ទៀត ដែល មាន សមាជិក ៦នាក់ មាន វិជ្ជមាន កូវីដ១៩ ទាំងអស់ គ្នា និង ត្រូវបាន នាំយក ទៅ ព្យាបាល ហើយ បាន ជាសះស្បើយ ពី ជំងឺ កូវីដ១៩ និង ត្រូវ មក បន្ត ធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ ចំនួន ១៤ ថ្ងៃ ទៀត ស្ថិត ក្នុង ភូមិ ស្ទឹង ថ្មី សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ។ អំណោយ ទាំងនោះ រួម មាន៖ អង្ករ ២៥ គីឡូ មី១កេះ ត្រីខ កំប៉ុង ១យួរ ទឹក បរិសុទ្ធ ៣យួរ ទឹកដោះគោ ៣យួរ និង ថវិកា ៣០០.០០០ រៀល ។
លោក អែល សៀត ក៏ អំពាវនាវ ឲ្យ បងប្អូន ទាំងអស់ ដែល មាន សមាជិក គ្រួសារ ឆ្លង ជំងឺ កូវីដ១៩ សូម អត់ធ្មត់ និង ធ្វើចត្តាឡី ស័ក ស្តាប់ តាម ការណែនាំ របស់ អាជ្ញាធរ ដើម្បី ចូលរួម កាត់បន្ថយ ការរីករាលដាល នៃ ជំងឺ ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ខេត្ត សៀមរាប ។
សូម ជម្រាប ផងដែរ សហគមន៍ ខ្មែរ ឥស្លាម ខេត្ត សៀមរាប ចាប់តាំងពី ផ្ទុះ ព្រឹត្តិការណ៍ ២០កុម្ភៈ មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ២២នាក់ និង ជាសះស្បើយ ១១នាក់ ៕
ពិធី ប្រគល់ រថយន្ត នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ នៅ បរិវេណ មុខ អគារ ទីស្ដីការ ក្រសួង មហាផ្ទៃ ដោយ មាន ការអនុវត្ត យ៉ាង ត្រឹមត្រូវ តាម វិធានការ សុខាភិបាល ដើម្បី បង្ការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ដូចជា ការពាក់ ម៉ាស់ វាស់ កំដៅ យក សំណាក បាញ់ អាល់កុល និង រក្សា គម្លាត សុវត្ថិភាព ជាដើម ។
នា ឱកាស នោះ សម្ដេច ក្រឡាហោម ស ខេង បាន សម្ដែង សេចក្ដីរីករាយ ដែល បាន ប្រគល់ រថយន្ត សម្រាប់ ចែកជូន អធិការដ្ឋាន នគរបាល បង្គ្រប់ ទូទាំង ប្រទេស ខណៈ ក្រសួង ក៏ គ្រោង ផ្ដល់ជូន រថយន្ត ដូចគ្នា នេះ ជូន វរសេនា តូច ដែល មិន ទាន់ ទទួលបាន រថយន្ត ចំនួន ១៦ អង្គភាព ទៀត នា ពេល ខាងមុខ ។
សម្ដេច ក្រឡាហោម ក៏ បាន គូសបញ្ជាក់ ដែរ ថា ការផ្ដល់ រថយន្ត ជូន នា ពេលនេះ គឺជា កិច្ចការ ចាំបាច់ មួយ ដើម្បីឱ្យ អធិការ នគរបាល ក្រុង ស្រុក យក ទៅ ប្រើប្រាស់ សម្រាប់ បំពេញ បេសកកម្ម បម្រើ ជាតិ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ឱ្យ បាន ទាន់ ពេល វេលា ។
សម្ដេច ក្រឡាហោម ស ខេង ក៏ បាន ថ្លែងអំណរគុណ ជូន សម្ដេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន ដែល ជានិច្ចជាកាល បាន យកចិត្តទុកដាក់ ជួយ ជ្រោមជ្រែង និង លើកទឹកចិត្ត ដល់ កម្លាំង នគរបាល ជាតិ របស់ យើង ជាក់ស្ដែង នៅ ពេល នេះ រថយន្ត ៨៧ គ្រឿង នេះ គឺជា ថយន្ត ដែល នាំចូល ដោយ ពន្ធ ជា បន្ទុក របស់ រដ្ឋ ដែល ទទួលបាន ការឯកភាព ពី សម្ដេច តេជោ នាយក រដ្ឋមន្រ្តី ។
ជាមួយគ្នា នេះ ដែរ សម្ដេចក៏ បាន ថ្លែង កោតសរសើរ ចំពោះ ការធ្វើ ពលីកម្ម គ្រប់ បែបយ៉ាង របស់ កម្លាំង នគរបាល ជាតិ ក្នុង ស្ថានភាព កូវីដ១៩ ដ្បិត កម្លាំង មួយ ផ្នែក នៃ មន្រ្តី រាជការ អាច មាន ឱកាស ស្នាក់ នៅ ផ្ទះ តែ សម្រាប់ កម្លាំង នគរបាល ជាតិ ស្ទើរ ទាំងអស់ បាន ចេញ ប្រតិបត្តិការ គ្រប់ ទីកន្លែង ដើម្បី រក្សា សន្តិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ពិសេស នៅ តាម តំបន់ ប្រឈម ខ្ពស់ ដូចជា តំបន់ ក្រហម តំបន់ លឿង ទុំ ជាដើម ។
ទន្ទឹមនឹង ការថ្លែង កោតសរសើរ ដល់ កងកម្លាំង នគរបាល ជាតិ ក្រោម ការដឹកនាំ របស់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន សម្ដេច ក្រឡាហោម ក្នុង នាម ថ្នាក់ដឹកនាំ ក្រសួង មហាផ្ទៃ និង សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ថ្លែង នូវ ការចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត ជូន ចំពោះ ក្រុមគ្រួសារ សព កងកម្លាំង នគរបាល ជាតិ ដែល បាន ពលី ជីវិត ក្នុង បេសកកម្ម ដ៏ ឧត្តុង្គឧត្តម ប្រយុទ្ធ ប្រឆាំងង នឹង ជំងឺ កូវីដ១៩ និង ក្រុមគ្រួសារ សព មន្រ្តី រាជការ ស៊ីវិល ដែល ទទួលមរណភាព ប ដោយសារ ជំងឺ ឆ្លង នេះ ។
ពាក់ព័ន្ធ នឹង ស្ថានភាព ជំងឺ កូវីដ១៩ នេះ សម្ដេច ក្រឡាហោម ស ខេង បាន គូសបញ្ជាក់ ថា មកដល់ ពេលនេះ អត្រា ឆ្លង ជំងឺ កូវីដ១៩ លើ ពិភពលោក នៅតែ ស្ថិត ក្នុង កម្រិត ខ្ពស់ នៅឡើយ ខណៈ ប្រទេស កម្ពុជា និង បណ្ដា ប្រទេស ជា បន្តបន្ទាប់ បាន រកឃើញ វត្តមាន មេរោក បំប្លែង ខ្លួន ថ្មី ដែល តា ។
សម្ដេច ក្រឡាហោម បាន បន្ត ក្នុង ន័យ ដើម ថា « ជា ការពិត ហើយ យើង ត្រូវ គោរព តាម វិធានការ សុខាភិបាល ប៉ុន្តែ ទន្ទឹម គ្នា នេះ យើង ក៏ ត្រូវ យកចិត្តទុកដាក់ បំពេញ ភារកិច្ច ជា ចាំបាច់ ដើម្បី ថែរក្សា សន្តិសុខ សុវត្ថិភាព និង សណ្ដាប់ធ្នាប់ សាធារណៈ ជូន ប្រជាពលរដ្ឋ ។ ខ្ញុំ សូម កោតសរសើរ ដ្បិត ជាក់ស្ដែង ក្នុង រយៈពេល ក្លងទៅ នេះ ការបង្ក្រាប បទល្មើស បាន ទទួល លទ្ធផល យ៉ាង ល្អ ប្រសើរ » ។
សម្ដេចក៏ បាន ណែនាំ ឱ្យ អគ្គ នាយកដ្ឋាន ភស្តុភារ និង ហិរញ្ញវត្ថុ គិតគូរ ការផ្ដល់ ប្រេងឥន្ធនៈ ប្រើប្រាស់ សម្រាប់ រថយន្ត នេះ ឱ្យ បាន ល្អ និង បាន សម្ដែង ក្ដីសង្ឃឹម ជឿជាក់ ថា ទោះបីជា ត្រូវ បន្ត ប្រឈមមុខ នឹង ការរីករាលដាល ជំងឺ កូវីដ១៩ ដែល មិន មាន ភាពប្រាកដប្រជា យ៉ាងណា ក្ដី ថ្នាក ដឹកនាំ មន្រ្តី រាជការ ស៊ីវិល និង កងកម្លាំង ទាំងអស់ និង រួមគ្នា បន្ត ខិតខំ បំពេញ ភារកិច្ច ប្រកបដោយ ការទទួលខុសត្រូវ ដើម្បី បំរើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ៕
ឧទាហរណ៍ ដូចជា លោក Peter Daszak ប្រធាន សម្ព័ន្ធ សុខភាព អេកូឡូស៊ី អាមេរិក ធ្លាប់ ធ្វើដំណើរ ទៅ ប្រទេស ចិន នៅ ឆ្នាំ នេះ ក្នុង នាយ មជា អ្នកជំនាញ របស់ អង្គការ សុខភាព ពិភពលោក ដើម្បី ធ្វើ ការសិក្សា ស្រាវជ្រាវ អំពី ការតាមដាន រក ប្រភព ដើម នៃ វីរុស ។ ទីបំផុត លោក ត្រូវបាន កាត់ផ្តាច់ប្រាក់ ទុន សិក្សា ស្រាវជ្រាវ ដោយ វិទ្យាស្ថាន ជាតិ សុខាភិបាល អាមេរិក ពីព្រោះ លោក បាន បញ្ចេញមតិ ដ៏ ត្រឹមត្រូវ ក្នុង ន័យ ផ្តល់ ការគាំទ្រ និង ឆ្លើយតប នឹង ប្រទេស ចិន ។
សូម បញ្ជាក់ ថា ក្នុង បញ្ហា តាមដាន រក ប្រភព ដើម នៃ ជំងឺ កូវីដ ១៩ យើង គួរ គោរព វិទ្យាសាស្ត្រ មិន ត្រូវ លេង ល្បែង នយោបាយ នោះ ទេ ។ ការប្រព្រឹត្ត " ភេរវ និយម ក្នុង ការតាមដាន រក ប្រភព ដើម នៃ វីរុស " របស់ អាមេរិក កំពុង បង្ក ផល ប៉ះពាល់ ដល់ ពិភពលោក ទាំងមូល ។
ទី មួយ ធាតុ ពិត នៃ ទង្វើ បែប នេះ គឺ រារាំង មជ្ឈដ្ឋាន វិទ្យាសាស្ត្រ សកល ក្នុង ការស្វែងរក ប្រភព ដើម នៃ វីរុស កូវីដ ១៩ និង រំខាន ដល់ ដំណើរ យក ជ័យជម្នះ លើ ការរីករាលដាល នៃ ជំងឺ ឆ្លង ដោយ ប្រើ មធ្យោបាយ វិទ្យាសាស្ត្រ របស់ មនុស្សជាតិ វា ជា ទង្វើ ដែល មិន ទទួលខុសត្រូវ យ៉ាង ខ្លាំង ចំពោះ ប្រជាជន ទូទាំង ពិភពលោក ក្នុង នោះ ក៏ បូករួមទាំង ប្រជាជន អាមេរិក ផង ។
ទី ពីរ អ្នកនយោបាយ អាមេរិក មួយចំនួន ប៉ុនប៉ង ធ្វើឱ្យ បញ្ហា ស្វែងរក ប្រភព ដើម នៃ វីរុស កូវីដ ១៩ ផ្សារភ្ជាប់ ជាមួយ ប្រទេស ចិន រហូតដល់ បណ្តា ប្រទេស អាស៊ី ដើម្បី ធ្វើឱ្យ " អារម្មណ៍ ប្រឆាំង ពលរដ្ឋ ដើមកំណើត អាស៊ី " របស់ ប្រទេស លោក ខាងលិច មួយចំនួន តូច ដូចជា អាមេរិក ជាដើម មាន ភាព កាន់តែ ផុយ ស្រួយ ហើយ បាន បង្កើន ការរើសអើង ពូជសាសន៍ និង ការចង គំនុំ ។
កាលពី ថ្ងៃទី ២ ខែសីហា បក្ស នយោបាយ អង្គការ សង្គម និង ធនាគារ គំនិត ជាង ៣០០ នៃ ប្រទេស និង តំបន់ ជាង ១០០ នៅ ទូទាំង ពិភពលោក បាន ប្រគល់ « សេចក្តីថ្លែងការណ៍ រួម » ជូន លេខាធិការដ្ឋាន នៃ អង្គការ សុខភាព ពិភពលោក ដោយ អំពាវនាវ ឱ្យ អង្គការ សុខភាព ពិភពលោក ធ្វើ ការសិក្សា ស្រាវជ្រាវ ពី ការរក ប្រភព ដើម នៃ វីរុស កូវីដ ១៩ ជា សកល ដោយ សត្យានុម័ត និង យុត្តិធម៌ ប្រឆាំង ជាដាច់ខាត ចំពោះ ការធ្វើឱ្យ បញ្ហា តាមដាន រក ប្រភព ដើម នៃ វីរុស ទៅជា រឿង នយោបាយ ។ នេះ គឺជា ស្នូរ សំរែក រួម របស់ ប្រជាជន ទូទាំង ពិភពលោក ។
( កំពង់ឆ្នាំង ) ៖ លោក ឈៀង ចន្ធី អនុប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត កំពង់ឆ្នាំង និង លោក ចក់ កែវ ចំរើន ប្រធាន ការិយាល័យ បេឡា ជាតិ សា ខា ខេត្ត កំពង់ឆ្នាំង រួមទាំង ក្រុមការងារ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន នាំយក អំណោយ រាជ រដ្ឋាភិបាល ចុះ ប្រគល់ ជូន គ្រួសារ អតីត មន្ត្រីរាជការ ស៊ីវិល និង គ្រួសារ យោ ធិន ពលី ចំនួន ៣គ្រួសារ ផ្សេង ៗ គ្នា ។
អតីត មន្ត្រីរាជការ ស៊ីវិល និង គ្រួសារ យោធិន ពលី ទាំង ៣គ្រួសារ បាន ថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល ដែល តែងតែ គិតគូរ អំពី សុខ ទុក្ខ និង បាន យកចិត្តទុកដាក់ ដល់ គ្រួ សារ អតីត យុទ្ធជន មន្ត្រីរាជការ ស៊ីវិល ចូលនិវត្តន៍ និង គ្រួសារ យោធិន ពលី ជាដើម ៕
អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ សម្រេច បិទ ខ្ទប់ ផ្សារ មង្គល បូរី ថ្មី ហៅ « ផ្សារ តាយ៉ាវ » នៅ ស្រុក មង្គលបុរី រយៈពេល ១៤ ថ្ងៃ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩
( បន្ទាយមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីសម្រេច បិទ ខ្ទប់ ផ្សារ មង្គល បូរី ថ្មី ហៅ ( ផ្សារ តាយ៉ាវ ) ដែល ជា ទីតាំង ពាក់ព័ន្ធ អ្នក មាន វិជ្ជមាន កូវីដ១៩ ស្ថិត ក្នុង ភូមិ ហ្លួង ឃុំ ឫស្សី ក្រោក ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ ។
បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា អាជ្ញាធរ សម្រេច បិទ ខ្ទប់ ផ្សារ នេះ ក្នុង រយៈពេល ២សប្តាហ៍ គិត ចាប់ពី ថ្ងៃទី ០៦ ដល់ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ ក្នុង គោលបំណង ធានា ដល់ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ នៅក្នុង ភូមិសាស្ត្រ ដេល ត្រូវ បិទ ខ្ទប់ និង ទប់ស្កាត់ កុំ ឱ្យ ជំងឺ កូវីដ១៩ នេះ ឆ្លង ទៅ រាលដាល ទៅកាន់ តំបន់ ផ្សេង ៗ ទៀត ។
បើ តាម លោក រ័ត្ន ដាស៊ីណង់ អភិបាល ស្រុក មង្គល បូរី បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ថា ការសម្រេច បិទ ផ្សារ មង្គលបុរី ថ្មី ហៅ ផ្សារ តាយ៉ាវ នេះ បន្ទាប់ពី មន្ត្រី សុខាភិបាល និង អាជ្ញាធរ បាន ធ្វើតេស្ត ឃើញ អាជីវករ ចំនួន ១៦ នាក់ ក្នុង ចំណោម អាជីវករ ចំនួន ៣២៦ នាក់ ។
បើ តាម លោក រ័ត្ន ដាស៊ីណង់ បាន ឱ្យដឹង ថា « អាជ្ញាធរ បាន បិទ ខ្ទប ផ្សារ តាយ៉ាវ នេះ នៅ ម៉ោង ៥៖០០ ទាប ភ្លឺ ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២១ នេះ មន្ត្រី បាន យក សំណាក លើ អាជីវករ ចំនួន ៣២៦ នាក់ ឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ១៦ នាក់ ក្រោម ការបញ្ជា ផ្ទាល់ ពី ឯកឧត្តម អភិបាល ខេត្ត ដោយ សំណាក ចប់ សព្វគ្រប់ នៅ ព្រឹក មិញ » ។
លោក អភិបាល ស្រុក បាន បញ្ជាក់ ថា នៅ ពេល នេះ មន្ត្រី សុខាភិបាល កំពុងតែ ស្វែងរក អ្នក ដែល ជាប់ពាក់ព័ន្ធ បន្ថែម ទៀត ដើម្បី ធ្វើ សំណាក រក មេរោគ កូវីដ១៩ ក្រោម ការដឹកនាំ បញ្ជា ផ្ទាល់ របស់ លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ ។
លោក រ័ត្ន ដាស៊ីណង់ បាន ឱ្យដឹង ទៀត ថា ក្នុង ចំណោម អ្នក ឆ្លង ជំងឺ កូវីដ១៩ នៅ ផ្សារ តាយ៉ាវ នេះ គឺ ភាគ ច្រើន ជា អាជីវករ លក់ដូរ ចម្រុះ នៅក្នុង ផ្សារ ព្រមទាំង បាន ចម្លង ទៅ ឪពុក ម្តាយ ព្រមទាំង ទារក ម្នាក់ អាយុ ៧ខែ ផងដែរ ៕ ខេត្ត បន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ១៨៥ នាក់ និង ជាសះស្បើយ ៣១៨ នាក់
បើ តាម រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា អ្នកជំងឺ កូវីដ១៩ ទាំង ១៨៥ នាក់ ខាងលើ នេះ ភាគ ច្រើន ជា ពលករ មកពី ប្រទេស ថៃ មន្ត្រី នគរបាល កម្លាំង កងរាជអាវុធហត្ថ ប្រជាពលរដ្ឋ អាជីវករ សិស្សសាលា និង ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ខេត្ត ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ៖ ខេត្ត ព្រះវិហារ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ២៤ នាក់ ភាគ ច្រើន នៅ ស្រុក ជាំ ក្សាន្ត និង ជាសះស្បើយ ៣០ នាក់
បើ តាម សេចក្តីប្រកាស់ របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង ថា ក្នុង ចំណោម អ្នកជំងឺ កូវីដ ទាំង ២៤ នាក់ ត្រូវបាន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល ជំងឺ កូវីដកម្រិត ស្រាល នៅ វិទ្យាល័យ ជា ស៉ី ម ត្បែងមានជ័យ ក្រុង ព្រះវិហារ និង មណ្ឌល ព្យាបាល ជំងឺ កូវីដ១៩ កម្រិត ស្រាល នៅ វិទ្យ ល័យ ជាំ ក្សាន្ត ស្រុក ជាំ ក្សាន្ត ។
