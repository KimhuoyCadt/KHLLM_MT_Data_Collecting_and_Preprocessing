( កំពង់ចាម ) ៖ លោក រិន វីរៈ រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង ផែនការ និង ក្រុមការងារ នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន នាំ អំណោយ ផ្ដល់ជូន លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន គណៈកម្មការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ទុក ប្រើប្រាស់ ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
ស្ថិត ក្នុង ឱកាស នោះ ដែរ លោក អ៊ុន ចាន់ ដា សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ លោក រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង ផែនការ និង ក្រុមការងារ ដែល បាន ផ្ដល់ អំណោយ ដ៏ ថ្លៃថ្លា ឱ្យ មក គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ខេត្ត កំពង់ចាម នា ពេលនេះ ពិតជា មាន សារៈសំខាន់ ស្រប ពេល ដែល ខេត្ដ កំពង់ចាម កំពុង ប្រឈនឹង ជំងឺ កូវីដ១៩ នេះ ៕ ថៃ ត្រូវការ ពេល៦ - ១០ ថ្ងៃ ទៀត ទើប អាច សម្អាត សារធាតុ គីមី នៅ រោងចក្រ ដែល បាន ផ្ទុះ ឆេះ ក្នុង ខេត្ត សាមុត ប្រាកាន
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នឹង ធ្វើ សន្និសីទ សារព័ត៌មាន ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ ខាងមុខ ដើម្បី ផ្សព្វផ្សាយ ពី នីតិវិធី និង យន្តការដាក់ ព្យាបាល តាម ផ្ទះ ចំពោះ អ្នកជំងឺ កូវីដ - ១៩ កម្រិត ស្រាល និង គ្មាន រោគសញ្ញា សម្រាប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។ នេះ បើ តាម សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ សារព័ត៌មាន Fresh News ទទួលបាន នា ថ្ងៃទី ១០ ខែកក្កដា នេះ ។
ខាងក្រោម នេះ ជា សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រសួង សុខាភិបាល៖ សប្បុរសជន និង មេបញ្ជាការ រង នគរបាល ព្រំដែន គោក ៨៩១ នាំយក គ្រឿង បរិភោគ និង ថវិកា មួយ ចំនួន ប្រគេន ព្រះសង្ឃ នៅ វត្ត តាម បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ដែល ជួប បញ្ហា កូវីដ
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ លោក ឧកញ៉ា ឡាច ប៊ុន លិម អគ្គ នាយក សំណង់ ផ្ទះល្វែង និង វីឡា មាន ជ័យ និង លោកស្រី ខា លីនដា និង លោក វរសេនីយ៍ ទោ ពៅ រិទ្ធី មេបញ្ជាការ រង នគរបាល ព្រំដែន គោក ៨៩១ បាន នាំយក គ្រឿង បរិភោគ ថវិការ ផ្ទាល់ខ្លួន មួយចំនួន ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត តាម បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ក្នុង ភូមិសាស្ត្រ ស្រុក ម៉ាទ្បៃ ខេត្ត បន្ទាយមានជ័យ ដែល កំពុង បញ្ហា កូវីដ១៩ ។
ព្រះសង្ឃ ទាំង ៧វត្ត ក្នុង ១វត្ត ទទួលបាន៖
នា ឱកាស នោះ ដែរ ព្រះតេជគុណ បាន ថ្លែងអំណរគុណ ដល់ លោក ឧកញ៉ា ឡាច ប៊ុន លិម និង លោកស្រី ខា លីនដា និង លោក វរសេនីយ៍ ទោ ពៅ រិទ្ធី ព្រមទាំង ក្រុមគ្រួសារ ដែល បាន ជួយ ដោះស្រាយ បញ្ហា ខ្វះខាត របស់ ព្រះសង្ឃ នៅ ពេល នេះ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៧៣១ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ទូរស័ព្ទ ល្មើស សញ្ញា ស្រវឹង និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ស្លាកលេខ ទូរស័ព្ទ អត់ ខ្សែក្រវ៉ាត់ អាជីវកម្ម ជាដើម ។
យុវជន ល្អ រួបរួម គាំទ្រ កម្ចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១០ ខែកក្កដា៖ បង្ក្រាប ៧ករណី ឃាត់ខ្លួន ១៧នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៤ករណី និង ជួញដូរ ៣ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ១៧នាក់ ។
ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាព កម្ពុជា - ចិន ៧០ រូប ទទួល ប័ណ្ណ សរសើរ ក្រោយ ចូលរួម យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ២ខែ នៅ ភ្នំពេញ
( ភ្នំពេញ ) ៖ សមាគម និស្សិត កម្ពុជា ប្រចាំ ប្រទេស ចិន នៅ ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ បាន រៀបចំ ពិធី សំណោះ សំណាល និង ប្រគល់ នូវ ប័ណ្ណ សរសើរ ជូន ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាព កម្ពុជា - ចិន ចំនួន ៧០ រូប ។
ក្នុង រយៈពេល ជាង ២ខែ កន្លងមក នេះ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាពយុវជន កម្ពុជា - ចិន បាន ឈរជើង ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ជូន ប្រជាពលរដ្ឋ ក្នុង ខណ្ឌ សែនសុខ និង ខណ្ឌ ជ្រោយ ចង្វារ សរុប ប្រមាណ ៣៣. ៦០០ នាក់ សម្រាប់ ដូសទី១ និង ដូស ទី២ ក្នុង យុទ្ធនាការ ចាក់ វ៉ាក់ សាង កូវីដ - ១៩ វគ្គ ទី២ និង ទី៣ ។
លោក សុក ហ៊ុយ តំណាង អ្នក ឧកញ៉ា ពុង ឃាវ សែ ប្រធាន សមាគម សម្ព័ន្ធ ខ្មែរ ចិន នៅ កម្ពុជា បាន លើកឡើង ថា កិច្ចការ របស់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាព កម្ពុជា - ចិន គឺជា ការកសាង បុណ្យ កុសល ដែល បាន ចូលរួមចំណែក ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ពី ជំងឺ កូវីដ - ១៩ ។
លោក An Jia តំណាង សប្បុរសជន ចិន បាន លើកឡើង ថា ទុក្ខលំបាក របស់ ប្រទេស កម្ពុជា ប្រៀប បាន នឹង ទុក្ខលំបាក របស់ ប្រទេស ចិន ហើយ លោក នឹង ខិតខំ កៀរ គរ ជំនួយ ពី ខាង អ្នក វិនិយោគ និង សប្បុរសជន ចិន បន្ត ជួយ ដល់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាព កម្ពុជា - ចិន ។
លោក អ៊ុ វុទ្ធ ទី ប្រធាន ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន កម្ពុជា - ចិន បាន បន្ត ថា « ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យើងខ្ញុំ ពិតជា មោទនភាព ណាស់ ដែល បាន ចូលរួម ក្នុង បុព្វហេតុ ជាតិ ក្នុង យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ - ១៩ ដោយ មិន គិត ថ្លៃ ជូន ប្រជាពលរដ្ឋ ខ្មែរ និង បរទេស ដែល កំពុង រស់ នៅ ទឹកដី ខ្មេរ ដែល ជា យន្តការ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ ដូចជា ការចួល រួម សម្រាល បន្ទុក របស់ រាជា រដ្ឋាភិបាល កម្ពុជា យើង ផងដែរ » ។
លោក បណ្ឌិត ថ្លែង យ៉ាង ដូច្នេះ ថា « កសិកម្ម បម្រើ ឲ្យ វិស័យ សេដ្ឋកិច្ច គឺ ដើរ តួនាទី សំខាន់ ពីព្រោះ គេ អាច អស់ ស្លៀក ខោអាវ គេ អាច អត់ ពាក់ ស្បែកជើង តែ គេ ត្រូវ ទទួលទាន ចាំបាច់ ណាស់ ។ ដើម្បីឲ្យ វិស័យ កសិកម្ម ដំណើរការ ទៅ មុខ បាន ត្រូវ មាន ក្រសួង ចំនួន ៧ អង្គុយ រួមគ្នា ដោះស្រាយ » ។
លោក បណ្ឌិត ក៏ បាន ណែនាំ ដល់ ប្រជាកសិករ ត្រូវ ចេះ ចង ក្រង គ្នា ជា សហគមន៍ ដើម្បី មាន កម្លាំង រួម មួយ ស្វែងរក ទីផ្សារ ដើមទុន បច្ចេកទេស និង ការផលិតផល ត្រូវ នឹង តម្រូវការ ទីផ្សារ ។
ជាមួយគ្នា នេះ លោក បាន លើកឡើង ពី ការជួយជ្រោមជ្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការជួយ ដល់ ប្រជាកសិករ អំឡុង ពេល នៃ ការផ្ទុះឡើង នៃ ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស កម្ពុជា ។
ការលើកឡើង របស់ បណ្ឌិត សុខ ទូច ធ្វើឡើង ក្នុង កិច្ចពិភាក្សា តុ មូល មួយ ក្រោម ប្រធានបទ « តើ អ្វី ទៅ ជា ឆ្អឹង ខ្នង សេដ្ឋកិច្ច កម្ពុជា ? » រៀបចំឡើង នៅ រាជ បណ្ឌិត សភាព នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ ។
លោក បណ្ឌិត សុខ ទូច បាន ថ្លែង ថា « រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រឹងប្រែង អស់ សមត្ថភាព ក្នុង ការជួយ ដល់ ប្រជាកសិករ ជួយ គ្រប់ បែបយ៉ាង ទាំងអស់ ។ ជាក់ស្ដែង ដូចជា ពេល ផ្ទុះឡើង នៃ ជំងឺ កូវីដ១៩ រាជ រដ្ឋាភិបាល ជួយ គ្រប់ បែបយ៉ាង ជួយ ទប់ស្កាត់ នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ជួយ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជាដើម » ។
លោក បាន បន្ដ ថា ឆ្អឹង ខ្នង នៃ សេដ្ឋកិច្ច ដើរ តួនាទី នៅ ស្រុក ខ្មែរ មាន ៣ធំ ៗ ដូច ជា៖ ១៖ ធនធាន មនុស្ស . ២៖ វិស័យ កសិកម្ម . ៣៖ វិស័យ ទេសចរណ៍ ចំពោះ វិស័យ កសិកម្ម ត្រូវ ផ្ដោត លើក សិឧស្សាហកម្ម ចំណែក វិស័យ ទេសចរណ៍ គឺ ត្រូវតែ ក្លាយជា ទេសចរណ៍ មួយ បម្រើ ឲ្យ វិស័យ កសិកម្ម បម្រើ លើ វិស័យ បរិស្ថាន ទាំងនេះ បាន ធ្វើឲ្យ វិស័យ សេដ្ឋកិច្ច កម្ពុជា រឹងមាំ ៕
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ កុំ ប្រើប្រាស់ ពាក្យ ស្នេហាជាតិ តែ នៅលើ បបូរមាត់ ពោល ត្រូវ ជួយ គាំទ្រា ផលិតផល ក្នុង ស្រុក ដើម្បី បង្កើន ទីផ្សារ និង បង្កើន ជីវភាព របស់ ប្រជាពលរដ្ឋ ខ្លួន ឲ្យ កាន់តែ ប្រសើរឡើង ជាជាង គាំទ្រ ផលិត ក្រៅ ស្រុក ដែល នាំចូល ។
លោក បាន បញ្ជាក់ ថា ការជំរុញ ឲ្យ ប្រជាពលរដ្ឋ គាំទ្រ ផលិតផល ក្នុង ស្រុក នេះ គឺជា ចំណុច ចិត្ត សាស្ដ្រ មួយ ក្នុង ចំណោម ៤ចំណុច ផ្សេង ទៀត ដែល ធ្វើឲ្យ វិស័យ កសិកម្ម នៅក្នុង ប្រទេស កម្ពុជា មាន ការរីកចម្រើន និង កាន់តែ ជួយ រុញ កំណើត សេដ្ឋកិច្ច ជាតិ បន្ថែម ទៀត ព្រមទាំង សម្ដៅ កាត់បន្ថយ ការនាំចូល ផងដែរ ។
ទន្ទឹមនឹង ការគាំទ្រ របស់ ប្រជាពលរដ្ឋ ហើយ នោះ អាជីវករ ផ្ទាល់ ដែល ជា ម្ចាស់ ផលិតផល ត្រូវតែ មាន ភាពស្មោះត្រង់ និង មាន សីលធម៌ ក្នុង ការលក់ នូវ ផលិតផល របស់ ខ្លួន ជៀសវាង នូវ ការបោកប្រាស់ អតិថិជន ។ លោក បណ្ឌិត សុខ ទូច បាន លើក ជា ឧទាហរណ៍ ថា បើក សិផល នោះ ជា របស់ នាំចូល ត្រូវ ប្រាប់ ត្រង់ ទៅកាន់ អតិថិជន ថា នោះ ជា កសិផល នាំចូល កុំ យក កសិផល នាំចូល ហើយ បោកប្រាស់ អតិថិជន ថា ជា ក សិផល ក្នុង ស្រុក ។
លោក បាន អះអាង ទៀត ថា ប្រជាពលរដ្ឋ ខ្មែរ មួយចំនួន មិន មាន សីលធម៌ ក្នុង ការលក់ដូរ គឺ ការ មិន សោះ ត្រង់ ក្នុង ការរក ស៉ី ។ លោក ថា នៅពេល ក្រូច បាត់ដំបង ឆ្ងាញ់ ដឹក ក្រូច នាំចូល មកពី ប្រទេស វៀតណាម យក ទៅ ដាក់ ក្រោម ដើម ក្រូច បាត់ដំបង ៕
ខេត្ត កំពង់ចាម បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៨៣ នាក់ ជាសះស្បើយ ៧១ នាក់ និង ស្លាប់ ២នាក់
ពាក់ព័ន្ធ កត្តា ធនធាន មនុស្ស នេះ លោក បណ្ឌិត សុខ ទូច បាន លើក ជា ឧទាហរណ៍ ថា នៅ ប្រទេស អ៉ីស្រា អ៊ែល ដែល ជា ប្រទេស មួយ មាន ផ្ទៃដី តូច ជាង កម្ពុជា ទៀត នោះ ប៉ុន្ដែ អាច នេះ ផលិតផល កសិកម្ម ចូល ទៅក្នុង ទីផ្សារ អ៉ឺរ៉ុប បាន ដោយសារតែ កត្តា ធនធាន មនុស្ស នេះ ហើយ ។ ខណៈ ប្រទេស ជប៉ុន មាន តែ ទឹក សមុទ្រ និង ដុំ ថ្ម ប៉ុន្ដែ អាច ក្លាយជា មហាអំណាច សេដ្ឋកិច្ច ទី៣ គឺ ដោយសារ ធនធាន មនុស្ស ។
ខាងក្រោម នេះ ជា វីដេអូ ទាំងស្រុង របស់ លោក បណ្ឌិត សុខ ទូច ដែល បាន លើកឡើង អំពី កត្តា ធនធាន មនុស្ស៖
ឧត្តមសេនីយ៍ ត្រី ឡុង សំអឿន ស្នងការ រង ខេត្ត ព្រះវិហារ ទទួលមរណភាព ដោយ ជំងឺ កូវីដ១៩
( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ឡុង សំអឿន ស្នងការ រង នគរបាល ខេត្ត ព្រះវិហារ ទទួល ផែន ប្រឆាំង គ្រឿងញៀន បាន ទទួលមរណភាព នៅ ថ្ងៃទី ១០ ខែកក្កដា ដោយសារ ជំងឺ កូវីដ១៩ នៅ បន្ទប់ សង្គ្រោះ បន្ទាន់ (ICU) មន្ទីរពេទ្យ បង្អែក ១៦មករា ខេត្ត ព្រះវិហារ ។
សូម បញ្ជាក់ ថា លោក ឧត្តមសេនីយ៍ ត្រី ឡុង សំអឿន បាន រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ កាលពី ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០២១ កន្លងទៅ និង បាន នាំយក មក សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល កម្រិត ស្រាល ។
ដោយ ស្ថានភាព ធ្ងន់ធ្ងរ លោក ត្រូវបាន បញ្ជូន មក សម្រាក ព្យាបាល បន្ត នៅ មន្ទីរពេទ្យ បង្អែក ១៦មករា ខេត្ត ព្រះវិហារ និង បាន ស្លាប់ នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ តែម្តង ៕ ឥណ្ឌូណេស៊ី រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ ចំនួន ៣៥. ០៩៤ នាក់ និង ស្លាប់ ៨២៦ នាក់ ក្នុង របាយការណ៍ ថ្ងៃសៅរ៍ នេះ
( សៀមរាប ) ៖ នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក ឡុង រដ្ឋារក្ស អភិបាល ស្រុក អង្គរ ធំ និង សហការី បាន នាំយក សម្ភារ ជា គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ចែកជូន កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក អាវុធហត្ថ ស្រុក ដែល កំពុង ធ្វើចត្តាឡី ស័ក ក្រោយ ប៉ះពាល ជាមួយ អ្នកវិជ្ជមាន កូវីដ១៩ ។ អំណោយ ដែល យក ទៅ ចែកជូន រួម មាន មី ៧កេស ត្រីខ ៧យួ អាល់កុល៣ដប ។
លោក អភិបាល ស្រុក បាន លេីក ឡេីង ថា ទោះ អំណោយ ទាំងនេះ មិន ច្រើន ក៏ដោយ តែ អាច ជួយ កាត់បន្ថយ ការលំបាក បាន មួយ គ្រា ផងដែរ ។ អំណោយ ទាំងនេះ បាន មក ពី អង្គការ ភ្លែន អន្តរជាតិ កម្ពុជា ប្រចាំ ខេត្ដ សៀមរាប ។
លោក ក៏ បាន ណែនាំ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវតែ អនាម័យ លាង ដៃ នឹង សាប៊ូ ឬ អាកុល ហើយ ពាក់ ម៉ាស់ ជា ប្រចាំ នៅ ពេល ដែល ចេញ ទៅ ខាងក្រៅ និង រក្សា គំលាត ដើម្បី កាត់បន្ថយ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
គួរ បញ្ជាក់ ផងដែរ ស្រុក អង្គរ ធំ ចាប់តាំងពី ផ្ទុះ ព្រឹត្តិការណ៍ ២០ កុម្ភៈ មក មាន អ្នក ឆ្លង ចំនួន ៤នាក់ ហើយ អ្នក ប៉ះពាល់ ផ្ទាល់ មាន ចំនួន ៣៨ នាក់ ដែល កំពុង ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ និង អង្គភាព រៀង ៗ ខ្លួន ៕
រដ្ឋបាល ខេត្ត ស្វាយរៀង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ៥៩ នាក់ ខណៈ ជាសះស្បើយ ៦៨ នាក់ និង ស្លាប់ ១ នាក់
រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ២០ នាក់ តាមរយៈ ការធ្វើតេស្ត រហ័ស
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ថា គិត មកដល់ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ខេត្ត ស្ទឹងត្រែង មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ៤០៥ នាក់ ជាសះស្បើយ ចំនួន ៥៧ នាក់ និង កំពុង សម្រាក ព្យាបាល ចំនួន ៣៤៨ នាក់ ៕
ខេត្ត បាត់ដំបង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ៦៥ នាក់ ជាសះស្បើយ ២២ នាក់ និង ស្លាប់ ១ នាក់
ខេត្ត ក្រចេះ ប្រកាស រកឃើញ អ្នកជំងឺ កូវីដ ចំនួន ១៩ នាក់ បន្ថែម ទៀត
រដ្ឋបាល ខេត្ត ក្រចេះ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ប្រយោល ជាមួយ អ្នក ទាំង ១៩ នាក់ ត្រូវ រួសរាន់ មក ជួប ក្រុម គ្រូពេទ្យ ដើម្បី យក សំណាក ទៅ ពិនិត្យ និង ធ្វើចត្តាឡី ស័ក ៕
រដ្ឋបាល ខេត្ត កោះកុង បង្ហាញ អត្តសញ្ញាណ អ្នក វិជ្ជមាន កូវីដ១៩ ចំនួន ៩១ នាក់ ទៀត និង ជាសះស្បើយ ចំនួន ៣៧ នាក់
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត កោះកុង៖ អភិបាល ខេត្ត កំពង់ឆ្នាំង ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ ដែល កំពុង ស្ថិត នៅ តំបន់ បិទ ខ្ទប់ នៅ សង្កាត់ ផ្សារ ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ អភិបាល ខេត្ត កំពង់ឆ្នាំង និង មន្ត្រីរាជការ បាន ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ ចំនួន ៩៣ គ្រួសារ ដែល កំពុង ស្ថិត នៅ តំបន់ បិទ ខ្ទប់ មិន ឱ្យ ចេញ ចូល នៅ តំបន់ ជុំវិញ ផ្សារ ឆ្នាំង ក្រុង កំពង់ឆ្នាំង ។
នៅក្នុង ឱកាស នោះ លោក ស៊ុន សុវណ្ណា រិទ្ធិ បាន លើកឡើង ថា ទុក្ខ កង្វល់ របស់ បងប្អូន ប្រជាពលរដ្ឋ គឺជា ទុក្ខ កង្វល់ របស់ អាជ្ញាធរ ខេត្ត និង រាជ រដ្ឋាភិបាល ។ ថ្ងៃ នេះ ក្នុង នាម អាជ្ញាធរ ខេត្ត ក្រុង បាន នាំ អំណោយ មក ចែកជូន បងប្អូន ក្នុង ការជួយ សម្រាល បន្ទុក ជីវភាព បាន មួយ ចំណែក ផងដែរ សម្រាប់ បងប្អូន ដែល កំពុងតែ ជាប់ ធ្វើ ចិត្តាឡី ស័ក នៅ តាម ផ្ទះ ក្នុង តំបន់ បិទ ខ្ទប់ ក្នុង សង្កាត់ ផ្សារ ឆ្នាំង នេះ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ការបិទ ខ្ទប់ នេះ គឺជា វិធានការ ដ៏ ចាំបាច់ របស់ អាជ្ញាធរ ខេត្ត និង មន្ទីរ សុខាភិបាល ដែល បាន អនុវត្ត ទៅ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង រាជ រដ្ឋាភិបាល ដើម្បី ទប់ស្កាត់ ការចម្លង រីករាល ដាល នៃ ជំងឺ កូវីដ១៩ ។ ដូច្នេះ សូម បងប្អូន នៅ តាម លំនៅដ្ឋាន បន្ត ភាព អត់ធ្មត់ និង ចូលរួម ទប់ស្កាត់ ទាំងអស់ គ្នា ដើម្បី សេចក្តីសុខ ក្នុង ក្រុមគ្រួសារ និង សហគមន៍ របស់ យើង ។
ឆ្លើយតប នឹង សំណូមពរ នេះ លោក ស៊ុន សុវណ្ណា រិទ្ធិ បាន ជួយ សម្រួល ឱ្យ ខាង អគ្គីសនី បើក ដំណើរការ ឡើងវិញ និង បាន ជួយ ឧបត្ថម ប្រាក់ ចំនួន ១លាន ៥០ម៉ឺន សម្រាប់ បង់ ថ្លៃ បន្ទប់ ជួល រយៈពេល ១ ខែ ជំនួស ឱ្យ អ្នក ស្នាក់ នៅ ទាំង១០ បន្ទប់ ផងដែរ ។
ប្រជាពលរដ្ឋ រស់ នៅ បន្ទប់ ជួល ទាំង ១០គ្រួសារ ក៏ ដូចជា បងប្អូន ដែល រស់ នៅ ជុំវិញ បរិវេណ ផ្សារ ឆ្នាំង ដែល កំពុងតែ បិទ ខ្ទប់ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ លោក អភិបាល ខេត្ត ដែល បាន ដោះស្រាយ រាល់ បញ្ហា ដែល កំពុង ជួប ការលំបាក នេះ ។
ចំពោះ អំណោយ ដែល បាន ចែកជូន នៅ ពេល នោះ មាន អង្ករ មី ទឹកក្រូច ទឹកត្រី ទឹកស៊ីអ៊ីវ និង ថវិកា ផងដែរ ចែកជូន ចំពោះ ប្រជាពលរដ្ឋ ខ្វះខាត ខ្លាំង ចំណែក ខ្លះ ទៀត នៅ មាន លទ្ឋភាព ត្រូវ រង់ចាំ វគ្គ ក្រោយ ។ ដោយឡែក កម្លាំង ការពារ ការបិទ ខ្ទប់ មាន ៣ក្រុម គឺ ក្រុម នគរបាល ក្រុង ក្រុម រដ្ឋបាល សាលាក្រុង និង ក្រុម ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ ឆ្នាំង គឺ ក្នុង មួយ ក្រុម ៗ ទទួលបាន ថវិកា ៤០ ម៉ឺន រៀល ៕ រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង សម្រេច បិទ ផ្សារ លើ ជា បណ្ដោះអាសន្ន បន្ទាប់ពី រកឃើញ អ្នក ឆ្លង កូវីដ ជា បន្តបន្ទាប់
( កំពង់ឆ្នាំង ) ៖ រដ្ឋបាល សាលា ខេត្ត កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ បាន ចេញ លិខិត សម្រេច បិទ ជា បណ្ដោះអាសន្ន ផ្សា លើ ក្រុង កំពង់ឆ្នាំង រហូតដល់ មាន ការជូនដំណឹង ថ្មី បន្ទាប់ពី សន្ទុះ នៃ ការឆ្លង កូវីដ១៩ កើតឡើង ច្រើន ពេក ។
រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ៩ ខែកក្កដា អ្នក ឆ្លង កូវីដ មាន រហូតដល់ទៅ ៦៦ នាក់ ក្នុង នោះ មាន អាជីវករ . កម្មករ . បុគ្គលិក ធនាគារ និង មន្ត្រីរាជការ ជាច្រើន នាក់ ផងដែរ ។
ក្នុង លិខិត ជូន ដំណឹង របស់ រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង បាន បញ្ជាក់ ថា ចំពោះ អ្នកវិជ្ជមាន កូវីដ១៩ ថ្មី ទាំង ៦៦ នាក់ ត្រូវបាន យក ទៅ ដាក់ ឲ្យ សម្រាក នៅ មន្ទីពេទ្យ ខេត្ត កំពង់ឆ្នាំង . មណ្ឌល ព្យាបាល វិទ្យាល័យ តេជោ ហ៊ុន សែន ទឹក ហូត . មណ្ឌល ព្យាបាល វិទ្យាល័យ ហ៊ុន សែន កំពង់ត្រឡាច និង មណ្ឌល ព្យាបាល វិទ្យាល័យ ហ៊ុន សែន បរិបូណ៌ ។
សេចក្តីជូនដំណឹង ស្តីពី ការហ៊ុព័ទ្ធ បិទ ខ្ទប់ ផ្សា លើ ក្រុង កំពង់ឆ្នាំង ដោយ ផ្អាក ការលក់ដូរ ជា បណ្ដោះអាសន្ន នេះ រដ្ឋបាល ខេត្ត ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ នៅ ជុំវិញ ផ្សារ និង អាជីវករ សូម ប្រញាប់ ទៅ យក សំណាក ជា បន្ទាន់ ចាប់ ពី ថ្ងៃទី ១០ ខែកក្កដា រៀងរាល់ ម៉ោង ធ្វើការ និង សូអាជីវករ ទាំងអស់ ដាក់ ខ្លួន ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ ឲ្យបាន ត្រឹមត្រូវ ផងដែរ ប៉ា ការណែនាំ របស់ អាជ្ញាធរ ក្នុង មូលដ្ឋាន របស់ ប្អូន ។
បើ តាម មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង ដែល បាន យក សំណាក អ្នក ពាក់ព័ន្ឋ លើ អាជីវករ ទាំង ផ្សារ ឆ្នាំង និង ផ្សារ លើ ក្រុង កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ ជា លទ្ឋ ផល បណ្តោះ អាសន្ន លើ តេស្តរហ័ស បាន រកឃើញ អ្នកវិជ្ញ មាន ថ្មី ចំនួន ១៩ នាក់ បន្ថែម ទៀត នេះ នៅ មិន ទាន់ គិត ពី តាម បណ្តា ស្រុក ទាំង ៧ទៀតផង ។
សូម បញ្ជាក់ ថា ការបិទ ផ្សារ ឆ្នាំង និង ផ្សារ លើ ក្នុង ក្រុង កំពង់ឆ្នាំង ជា បណ្តោះអាសន្ន នេះ ធ្វើឡើង ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ នៅ ពេល ដែល បើក ផ្សារ ទាំង ២នេះ ឲ្យ ដំណើរការ ឡើងវិញ ជាថ្មី នោះ អាជ្ញាធរ នឹង ជូន ដំណឹង នៅ ជាថ្មី ទៀត ៕
រដ្ឋ កាលីហ្វ័រញ៉ា សហរដ្ឋ អាមេរិក នៅតែ បន្ត ការណែនាំឲ្យ ពាក់ ម៉ាស ក្នុង សាលារៀន ទោះបីជា សិស្ស និង គ្រូបង្រៀន បាន ចាក់ វ៉ាក់សាំង រួច ក្តី
( ឡូស អាន់ ជែឡែ ស) ៖ នាយកដ្ឋាន សុខាភិបាល សាធារណៈ (CDPH) នៃ រដ្ឋ កាលីហ្វ័រញ៉ា បាន ប្រកាស នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ថា រដ្ឋ ដែល មាន ប្រជាជន ច្រើន បំផុត នៅ សហរដ្ឋ អាមេរិក មួយ នេះ នឹង បន្ត ទាមទារ ឱ្យ អនុវត្ត វិធានការពាក់ ម៉ាស នៅ តាម សាលារៀន នៅក្នុង វគ្គ សិក្សា ថ្មី នា ពេល ខាងមុខ នេះ ដដែល ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ចិន ស៉ីន ហួរ នៅ រសៀល ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ ។
ជាន់ ខ្ពស់ ផ្នែក សុខាភិបាល នៃ រដ្ឋ កាលីហ្វ័រញ៉ា លោក វេជ្ជបណ្ឌិត ម៉ាក ហ្គាលី (Mark Ghaly) បាន គូសបញ្ជាក់ នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ថា ការពាក់ ម៉ាស គឺជា មធ្យោបាយ ដ៏ ជោគជ័យ បំផុត ដើម្បី ការពារ សុខភាព សិស្សានុសិស្ស ទាំងអស់ និង ធ្វើឱ្យ ពួកគេ ត្រលប់ ទៅ រៀនសូត្រ នៅ សាលារៀន វិញ ដោយ សុវត្ថិភាព ចាប់តាំងពី សាលារៀន ភាគ ច្រើន នៅ រដ្ឋ នេះ មិន មាន សមត្ថភាព ក្នុង ការរក្សា គម្លាត យ៉ាងតិច ១ម៉ែត្រ ដើម្បី ការពារ ការឆ្លង រីករាលដាល នៃ ជំងឺ COVID-19 ទៅ តាម ការស្នើសុំ របស់ មជ្ឈមណ្ឌល គ្រប់គ្រង និង បង្ការ ជំងឺ (CDC) ។
សមាគម សហព័ន្ធ វិនិយោគិន កម្ពុជា ចាត់ទុក សេចក្តីព្រាង ច្បាប់ វិនិយោគ ដែល ទើប ត្រូវបាន រាជ រដ្ឋាភិបាល អនុម័ត ជា ឧបករណ៍ គតិយុត្ត ដ៏ សំខាន់ សម្រាប់ ការវិនិយោគ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ សមាគម សហព័ន្ធ វិនិយោគិន កម្ពុជា បាន ប្រកាស គាំទ្រ រាជ រដ្ឋាភិបាល ដែល ខិតខំ រៀបចំ សេចក្ដីព្រាង ច្បាប់ ស្ដីពី វិនិយោគ ដោយ សមាគម បាន ចាត់ទុក ថា សេចក្ដីព្រាង ច្បាប់ ថ្មី នេះ នឹង ក្លាយជា ឧបករណ៍ គតិយុត្ត ដ៏ សំខាន់ ក្នុង ការធ្វើឱ្យ វិស័យ វិនិយោគ នៅ កម្ពុជា កាន់តែ រីកចម្រើន បន្ថែម ទៀត ។
ថ្លែង ប្រាប់ បណ្ដាញ សារព័ត៌មាន Fresh News នា ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក បណ្ឌិត ឡី សុភាព ប្រធាន សមាគម សហព័ន្ធ វិនិយោគិន កម្ពុជា បាន ឱ្យដឹង ថា ថ្នាក់ដឹកនាំ ក្រុមប្រឹក្សាភិបាល គណៈកម្មការ ប្រតិបត្តិ សមាជិក - សមាជិកា នៃ សមាគម សហព័ន្ធ វិនិយោគិន កម្ពុជា ដែល ជា អ្នក វិនិយោគ ពាណិជ្ជករ អាជីវករ ឧស្សាហករ សិប្បក រ សហគ្រិន និង អ្នក មាន វិជ្ជាជីវៈ នានា នោះ ពិតជា មាន ក្ដីរីករាយ ខ្លាំង ណាស់ ចំពោះ កិច្ចខិតខំ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការបង្កើត ឱ្យ មាន សេចក្ដីព្រាង ច្បាប់ វិនិយោគ នេះ ។
ប្រធាន សមាគម រូប នេះ បាន បន្ត ថា នៅពេល ច្បាប់ ថ្មី នេះ ត្រូវបាន ប្រកាស ឱ្យ ប្រើប្រាស់ នៅក្នុង ឆ្នាំ នេះ ឬ នៅ ឆ្នាំ ក្រោយ វា ក៏ ជា ឱកាស ល្អ សម្រាប់ វិស័យ វិនិយោគ នៅ កម្ពុជា ពីព្រោះ មាន កិច្ចព្រមព្រៀង ជាច្រើន ដែល ភាគី កម្ពុជា ត្រៀម ធ្វើជាមួយ ភាគី អន្តរជាតិ នានា ស្រប ពេល ដែល បរិបទ នៃ វិស័យ វិនិយោគ នៅ កម្ពុជា ក៏ កាន់ មាន សក្ដានុពល ខ្លាំង ឡើង ៗ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក ឡី សុភាព បាន គូសបញ្ជាក់ ថា សម្រាប់ សមាគម សហព័ន្ធ វិនិយោគិន កម្ពុជា បាន ប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ក្នុង ការចូលរួម អនុវត្ត តាម ខ្លឹមសារ នៃ ច្បាប់ ស្ដីពី វិនិយោគ ថ្មី នេះ និង ចូលរួម ក្នុង កិច្ចការ ជំរុញ ការអភិវឌ្ឍ វិស័យ វិនិយោគ នៅ កម្ពុជា បង្កើន ទំនាក់ទំនង ល្អ ជាមួយ វិនិយោគ អន្តរជាតិ ដើម្បី រួមចំណែក ធ្វើឱ្យ វិស័យ វិនិយោគ ជាតិ កាន់តែ មាន ភាពរីកចម្រើន ។
សូម ជម្រាប ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី វិនិយោគ មាន ១២ ជំពូក និង ៤២ មាត្រា ហើយ ត្រូវបាន សម័យ ប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ អនុម័ត រួចរាល់ ហើយ ដែល នឹង ត្រូវ បញ្ជូន ទៅ រដ្ឋសភា ដើម្បី ពិនិត្យ និង អនុម័ត បន្ត ។
រាជ រដ្ឋាភិបាល កម្ពុជា បាន អះអាង ថា សេចក្តីព្រាង ច្បាប់ ស្ដីពី វិនិយោគ ដែល បាន តាក់តែង ឡើង ថ្មី នេះ គឺ ដើម្បី ជំនួស ច្បាប់ ស្ដីពី វិនិយោគ ចាស់ ដែល បាន ចូល ជាធរមាន តាំងពី ឆ្នាំ ១៩៩៤ និង ឆ្នាំ ២០០៣ ។
ជាមួយគ្នា នេះ ដែរ ដើម្បី បង្កើន ភាពប្រកួតប្រជែង និង ភាពទាក់ទាញ របស់ កម្ពុជា ពីសំណាក់ វិនិយោគិន សេចក្តីព្រាង ច្បាប់ នេះ បាន បំព្រួញ ពេលវេលា ក្នុង ការចេញ វិញ្ញាបនបត្រ ចុះបញ្ជី ពី ៣១ ថ្ងៃ ទៅ ២០ ថ្ងៃ ហើយ ការបំពេញ ពាក្យ សុំ ចុះបញ្ជី អាច ធ្វើ ទៅ បាន តាមរយៈ ការដាក់ ឱ្យ ប្រើប្រាស់ ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន (Online) ។
បន្ថែម លើ នេះ ផងដែរ សេចក្តីព្រាង ច្បាប់ នេះ ក៏ បាន ដាក់ចេញ នូវ ការ ពង្រឹង យន្តការតាមដាន និង ត្រួតពិនិត្យ របស់ ក្រសួង - ស្ថាប័ន ជំនាញ ពាក់ព័ន្ធ តាមរយៈ ការ ចុះ ត្រួតពិនិត្យ ក្នុង ពេល តែ មួយ និង រួមគ្នា ព្រមទាំង កំណត់ នូវ របប លើកទឹកចិត្ត ចំពោះ គម្រោង គ.ល. គ. ទាំង ផ្នែក ពន្ធ និង មិន មែន ពន្ធ ដើម្បី ទាក់ទាញ រំហូរ វិនិយោគ មកកាន់ វិស័យ ដែល កម្ពុជា ត្រូវការ ជា ចាំបាច់ ក្នុង បរិបទ នៃ ការធ្វើ ពិពិធកម្ម សេដ្ឋកិច្ច និង ការបង្កើន ភាពប្រកួតប្រជែង ។
ដើម្បី ផ្ដល់ ភាពកក់ក្ដៅ ដល់ វិនិយោគិន សេចក្ដីព្រាង ច្បាប់ នេះ បាន ដាក់បញ្ចូល នូវ កាតព្វកិច្ច ជា អន្តរជាតិ មួយចំនួន របស់ កម្ពុជា ដើម្បី បង្ហាញ ដល់ វិនិយោគិន ទាំងអស់ នូវ ការប្ដេជ្ញា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការការពារ វិនិយោគ និង ផ្ដល់ ការធានា ដោយ អនុលោម តាម ច្បាប់ អន្តរជាតិ នូវ ប្រព្រឹត្តកម្ម ដែល មិន រើសអើង ព្រមទាំង ផ្ដល់ សេវា ថែទាំ វិនិយោគ ផងដែរ ៕
បទ អត្ថាធិប្បាយ៖ ភាព ក្រអឺត ក្រទម និង ភាព មានះ បែប អាមេរិក មិន អាច ធ្វើឱ្យ រង្គោះរង្គើ ដល់ និន្នាការ ស្ថិរភាព ជាទូទៅ របស់ ហុងកុង នោះ ទេ
( ប៉េកាំង ) ៖ សេតវិមាន អាមេរិក បាន ប្រកាស កាលពី ថៃ្ង ទី៧ ខែកក្កដា ថា នឹង ពន្យារ ពេល អ្វី ដែល ហៅ ថា « សភាព អាសន្ន ថ្នាក់ ជាតិ ដែល សំដៅ ចំពោះ ស្ថានការណ៍ ហុងកុង » ព្រមទាំង នឹង អនុវត្ត វិធានការ ដាក់ទណ្ឌកម្ម ពាក់ព័ន្ធ នឹង ហុងកុង ជាបន្ត ទៀត ។ ទង្វើ របស់ អាមេរិក បែប នេះ បាន ល្មើស យ៉ាង ធ្ងន់ធ្ងរ នូវ ច្បាប់ អន្តរជាតិ និង ក្រម មូលដ្ឋាន នៃ ទំនាក់ទំនង អន្តរជាតិ គឺជា ទង្វើ អនុត្តរភាព ដែល មិន គិត ពិចារណា ពី ការកែតម្រូវ កំហុស របស់ ខ្លួន និង ជា ទង្វើ ខុស ជាន់ លើ ខុស ។
ប្រទេស ចិន បាន សម្តែង ការខឹងសម្បា និង ការថ្កោលទោស យ៉ាង ខ្លាំងក្លា ចំពោះ ការ នេះ ។ ហុងកុង ជា តំបន់ រដ្ឋបាល ពិសេស មួយ របស់ ប្រទេស ចិន ហើយ ការអនុវត្ត សិទ្ធិ គ្រប់គ្រង ដោយ គ្រប់ ជ្រុងជ្រោយ របស់ រដ្ឋាភិបាល មជ្ឈិម ចំពោះ តំបន់ រដ្ឋបាល ពិសេស ហុងកុង គឺជា កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ចិន សុទ្ធសាធ ។ « សៀវភៅ ស ស្តីពី សហគ្រាស អាមេរិក នៅ ប្រទេស ចិន » ដែល ចេញផ្សាយ ដោយ សភា ពាណិជ្ជកម្ម អាមេរិក នៅ ចិន នា ពេល ថ្មី ៗ កន្លងទៅ នេះ បាន បង្ហាញ ថា សហគ្រាស អាមេរិក ចំនួន ២ភាគ៣ គ្រោង នឹង បង្កើន ការវិនិយោគ នៅ ប្រទេស ចិន ។
តាមពិត ទៅ គឺ ភាគី អាមេរិក ហ្នឹង ឯង ដែល បាន គាំទ្រ និង លើកទឹកចិត្ត ដល់ ពួក ឧទ្ទាម ប្រឆាំង ប្រទេស ចិន និង បង្ក ភាពចលាចល នៅ ហុងកុង ក្នុង រយៈពេល ជា យូរ ដើម្បី វាយប្រហារ និង លាប ពណ៌ ទៅ លើ ប្រទេស ចិន ដោយ មិន សំចៃ ដៃ ម្តង ហើយ ម្តង ទៀត ដែល បាន បង្ក ការគំរាមកំហែង ដ៏ ធ្ងន់ធ្ងរ ដល់ អធិបតេយ្យភាព សន្តិសុខ និង ផលប្រយោជន៍ អភិវឌ្ឍន៍ របស់ ចិន !
សមត្ថភាព កៀរគរ ទុន បរទេស របស់ ហុងកុង ក៏ ត្រូវបាន លើកកម្ពស់ ឥត ឈប់ឈរ ផងដែរ ។ នៅ ឆ្នាំ ២០២០ ទំហំ ប្រាក់ ទុន ដែល ហូរ ចូល តំបន់ ហុងកុង បាន ឡើង ដល់ ៥ ម៉ឺន លាន ដុល្លារ អាមេរិក ទំហំ ប្រាក់ ទុន ដែល ទីផ្សារ ភាគហ៊ុន នៃ តំបន់ ហុងកុង ប្រមូល បាន សម្រាប់ ធ្វើ IPO កាន់ លំដាប់ថ្នាក់ ទី ពីរ លើ ពិភពលោក ។ របាយការណ៍ ដែល ចេញ ផ្សាយ ដោយ អង្គការ មូលនិធិ រូបិយវត្ថុ អន្ដរជាតិ នា ពេល ថ្មី ៗ កន្លងទៅ នេះ បាន បញ្ជាក់ ម្តង ទៀត នូវ ឋានៈ ជា មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ អន្តរជាតិ របស់ ហុងកុង ។
ការអភិវឌ្ឍ របស់ តំបន់ ហុងកុង គឺ ពឹងផ្អែក លើ ការតស៊ូព្យាយាម របស់ អ្នក ក្រុង ហុងកុង ពឹងផ្អែក លើ ការគាំទ្រ យ៉ាង ខ្លាំងក្លា ពី ចិន ដី គោក ហើយ វា មិន ដែល ពឹងផ្អែក លើ ការប្រទាន និង សប្បុរសធម៌ របស់ បរទេស ណាមួយ នោះ ឡើយ ។ ការ ដែល អាមេរិក ប៉ុនប៉ង ចង់ គំរាមកំហែង និង ទប់ស្កាត់ ការអភិវឌ្ឍ របស់ ហុងកុង វា មិន អាច ធ្វើ បាន នា អតីតកាល នោះ ទេ ហើយក៏ នឹង មិន មាន ប្រសិទ្ធភាព នា ពេល បច្ចុប្បន្ន នេះ ឬ នៅពេល អនាគត ផងដែរ ៕
សម្តេច ក្រឡាហោម ស ខេង តែងតាំង លោក តាន់ សុខ វិជ្ជា និង លោក កែវ សុផាន់ ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ពារាំង ខេត្ត ព្រៃវែង
ការតែងតាំង លោក ឧត្តមសេនីយ៍ ឯក តាន់ សុខ វិជ្ជា ជា អនុប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក ពារាំង ខេត្ត ព្រៃវែង បន្ទាប់ពី ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា បាន ឃើញ ការខិតខំ ប្រឹងប្រែង របស់ លោក មាន ស្នាដៃ ល្អ លះបង់ កម្លាំង កាយ ចិត្ត ការបម្រើ ជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា មិន ខ្លាច នឿត ហត់ មាន ទំនាក់ទំនង ល្អ ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ និង មាន ការគាំទ្រ និង ជំនឿ ទុកចិត្ត ពី ប្រជាពលរដ្ឋ ដល់ គណបក្ស ប្រជាជន កម្ពុជា ។
សម្តេច ក្រឡាហោម ស ខេង បាន កោតសរសើរ លោក ឧត្តមសេនីយ៍ ឯក តាន់ សុខ វិជ្ជា ជា អនុប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក ពារាំង ខេត្ត ព្រៃវែង បាន បំពេញ ការងារ ដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ លើកកម្ពស់ សេវា សាធារណៈ ដោះស្រាយ សំណូមពរ នានា របស់ ប្រជាពលរដ្ឋ ក្នុង រយ ពេល កន្លងមក ។
ទីស្នាក់ការត្រួតពិនិត្យ ច្រកទ្វារ អន្តរជាតិ ចាំ យាម រៀបចំ កន្លែង ធ្វើតេស្ត រហ័ស កូវីដ១៩ ថ្មី លើ អ្នក ដឹក ទំនិញ ឆ្លង ដែន តាម ព្រំដែន ចាំ យាម ហាលិក
លោក សុវណ្ណ ប៊ុន ធឿន ប្រធាន ទីស្នាក់ការត្រួតពិនិត្យ ច្រកទ្វារ អន្តរជាតិ ចាំ យាម ស្រុម ណ្ឌល សីមា ហាលិក បាន លើកឡើង នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ថា នៅ តាម ទីស្នាក់ការច្រកទ្វារ អន្តរជាតិ ចាំ យាម ហាលិក សមត្ថកិច្ច ប្រចាំ ការ២៤ ម៉ោង គ្រប់ អង្គភាព មាន ការទំនាក់ទំនង គ្នា បាន ល្អ ដោយ មិន មាន ការធ្វេសប្រហែស ឡើយ ហើយ គ្រប់ អង្គភាព មាន វិធានការ ខ្ពស់ ក្នុង ការរឹត បណ្តឹង ចំពោះ ទីតាំង របស់ ខ្លួន ដែល ឈរ ជើង ប្រចាំ បុស្តិ៍ នីមួយ ៗ ទាំង ផ្លូវ ទឹក ទាំង ផ្លូវគោក ។
ក្រសួង សេដ្ឋកិច្ច ចេញ ប្រកាស ស្ដីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ ក្រុមប្រឹក្សា បច្ចេកវិទ្យា ព័ត៌មាន
( ភ្នំពេញ ) ៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នា ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ ប្រកាស ស្ដីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ ក្រុមប្រឹក្សា បច្ចេកវិទ្យា ព័ត៌មាន ដែល សរសេរ ជា អក្សរ កាត់ ថា ក . ប. ព ដើម្បី ដឹកនាំ សម្របសម្រួល និង ជំរុញ ការកសាង និង ការអភិវឌ្ឍ បច្ចេកវិទ្យា ព័ត៌មាន និង ឌីជីថល ប្រកបដោយ ជវភាព សង្គតិភាព និង សុខដុមភាព សំដៅ កសាង ទំនុកចិត្ត និង ភាពជឿជាក់ លើ ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន និង ឌីជីថល របស់ ក្រសួង សេដ្ឋកិច្ច ៕
ខាងក្រោម នេះ ជា ប្រកាស របស់ ក្រសួង សេដ្ឋកិច្ច៖ អាជ្ញាធរ អំពាវនាវ ពលរដ្ឋ នៅ ក្រុង ស្វាយរៀង បន្ត ចូលរួម ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ តាម ការកំណត់ របស់ អាជ្ញាធរ
( ស្វាយរៀង ) ៖ លោក សរ សុដានី អភិបាល រង ក្រុង ស្វាយរៀង ខេត្ត ស្វាយរៀង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ នៅ ក្រុង ស្វាយរៀង បន្ត ចូលរួម ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ តាម ការអញ្ជើញ និង ពេលវេលា កំណត់ របស់ អាជ្ញាធរ មូលដ្ឋាន ព្រោះ គុណ ប្រយោជន៍ របស់ វ៉ាក់សាំង បាន ជួយ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ដល់ យើង ទាំងអស់ គ្នា ។
ការអំពាវនាវ នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស ដែល លោក ចុះ ពិនិត្យ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ ឆ្លង កូវីដ១៩ ប្រគេន ព្រះសង្ឃ ជូន ដល់ ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង ទៅ ដោយ ឥត គិត ថ្លៃ នៅក្នុង មូលដ្ឋាន ក្រុង ស្វាយរៀង ។
លោក សរ សុដានី បាន បន្ត ថា ដោយ មាន ការយកចិត្តទុកដាក់ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្ដេច តេជោ ហ៊ុន សែន មកដល់ ថ្ងៃ នេះ ក្រុង ស្វាយរៀង បាន បើក យុទ្ធនាការ ចាក់ វាក់ សាំង ជូន ដល់ ប្រជាពលរដ្ឋ បាន ៣ ថ្ងៃ ហើយ ដោយ បាន បន្ត ដំណើរការ ទៅ យ៉ាង រលូន បន្ទាប់ពី ប្រជាពលរដ្ឋ បាន អញ្ជើញ មក ទទួល ការចាក់ វ៉ាក់សាំង ទៅ តាម ការអញ្ជើញ និង ពេលវេលា កំណត់ របស់ អាជ្ញាធរ ហើយ បាន ចូលរួម សហការ បាន យ៉ាង ល្អ ជាមួយ ក្រុមការងារ ទាំងអស់ ។
លោក ក៏ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ក្រុមការងារ រដ្ឋបាល ក្រុង - សង្កាត់ ជាពិសេស ប្អូន ៗ ក្មួយ ៗ យុវជន ( សសយក ) ក្រុង ស្វាយរៀង ដែល បាន ចូលរួម យ៉ាង សកម្ម ជួយ សម្របសម្រួល ការងារ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ យ៉ាង សស្រាក់សស្រាំ មិន ខ្លាច នឿយហត់ ឡើយ ។
លោក បាន បន្ថែម ថា ក្រោយ ទទួលបាន វ៉ាក់សាំង រួច សូម ពុក ម៉ែ បង ប្អូន ប្រជាពលរដ្ឋ ត្រូវតែ បន្ត ប្រកាន់ភ្ជាប់ នូវ វិធានការ « ៣ការពារ និង ៣កុំ » របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ឱ្យ បាន ខ្ជាប់ខ្ជួន ជានិច្ច ទើប ធ្វើឱ្យ ស្ថានភាព វិល ទៅរក ភាព ដើម វិញ នា ពេល ខាងមុខ នេះ ជាក់ ជា មិន ខាន ៕
សមាគម ស្បែកជើង កម្ពុជា ឧបត្ថម្ភ សម្លៀកបំពាក់ ពេទ្យ ម៉ាស អាល់កុល ទឹក សុទ្ធ និង ថ្នាំ បុរាណ ចិន ជូន រដ្ឋបាល ខេត្ត កំពង់ចាម រួមចំណែក ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ
( កំពង់ចាម ) ៖ ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង កម្ពុជា បាន បន្ត ដឹកនាំ សមាជិក នាំយក អំណោយ មួយចំនួន មាន ដូចជា សម្លៀកបំពាក់ ពេទ្យ ម៉ាស អាល់កុល ទឹក សុទ្ធ និង ថ្នាំ បុរាណ ចិន ប្រគល់ជូន រដ្ឋបាល ខេត្ត កំពង់ចាម ដើម្បី រួមចំណែក ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នា ពេល បច្ចុប្បន្ន នេះ ។
ពិធី ប្រគល់ និង ទទួលបាន ធ្វើឡើង នា ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ ហើយ ក្នុង ចំណោម សម្ភារៈ ទាំងអស់ គឺ សមាគម ស្បែកជើង កម្ពុជា បាន ឧបត្ថម្ភ ជូន រដ្ឋបាល ខេត្ត កំពង់ចាម នូវ សម្លៀកបំពាក់ ពេទ្យ PPE ចំនួន ២.០០០ ឈុត ម៉ាស ចំនួន ១២.៥០០ បន្ទះ ថ្នាំ បុរាណា ចិន ៤០០ ប្រអប់ ព្រមទាំង អាល់កុល និង ទឹក សុទ្ធ មួយចំនួន ផងដែរ ។
សម្រាប់ កំពង់ចាម ក្រៅពី សមាគម ស្បែកជើង កម្ពុជា ក៏ មាន អ្នកឧបត្ថម្ភ បន្ថែម ដូចជា រោងចក្រ វ៉ា ឡុង ( ខេមបូឌា ) ហ៊្វូត វែរ អ៉ិន ដាស ស្ទ្រី ឯ . ក ដែល បាន ផ្តល់ នូវ ស្រោម ដៃ ពេទ្យ ចំនួន ១០០០ ប្រអប់ និង រោងចក្រ ស៉ី ភីស៉ី ជី អ៉ិនធើណេសិន ណល ដែល បាន ផ្តល់ ជូន នូវ សម្លៀកបំពាក់ ពេទ្យ ចំនួន ៥០ ឈុត ហើយ អាល់កុល ៥ កាន ព្រមទាំង រោងចក្រ កាលីង តុន ដែល ឧបត្ថម្ភ នូវ ទឹក សុទ្ធ ១០កេស ខណៈ រោងចក្រ ជូ ហួយ ហ៊្វួត វែរ ផ្តល់ ជូន អាល់កុល ១០កាន ។
សូម ជម្រាប ថា សមាគម ស្បែកជើង កម្ពុជា តែងតែ យកចិត្តទុកដាក់ ជួយ ឧបត្ថម្ភ ដល់ រាជ រដ្ឋាភិបាល និង ប្រជាពលរដ្ឋ ខ្មែរ ដែល ទទួល រងគ្រោះ ដោយសារ ជំងឺ កូវីដ១៩ តាមរយៈ រូបភាព ផ្សេង ៗ កន្លងមក នេះ ៕ ក្រុម សកម្ម ប្រយុទ្ធ តាលី បង់ ១០៩ នាក់ ត្រូវបាន សម្លាប់ ក្នុង សមរភូមិ នៅឯ ភាគ ខាងត្បូង ប្រទេស អាហ្វហ្គានីស្ថាន
( កាន់ ដាហារ) ៖ យោធា អាហ្វហ្គានីស្ថាន នៅ ថ្ងៃ សោរ៍ នេះ បាន ឱ្យដឹង ថា ក្រុម សកម្ម ប្រយុទ្ធ តាលី បង់ យ៉ាងហោច ១០៩ នាក់ ត្រូវបាន សម្លាប់ និង ២៥ នាក់ ទៀត រងរបួស ក្នុង ការវាយប្រយុទ្ធ គ្នា នៅឯ ខេត្ត ចំនួន ២ ស្ថិត នៅ ភាគ ខាងត្បូង នៃ ប្រទេស កាលពី ថ្ងៃសុក្រ ម្សិលមិញ នេះ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ចិន ស៉ីន ហួរ នៅ ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ ។
ចំណែកឯ ក្រុម សកម្ម ប្រយុទ្ធ តាលី បង់ ចំនួន ៣៩ នាក់ ផ្សេង ទៀត ក៏ ត្រូវបាន សម្លាប់ និង ១៧នាក់ ផ្សេង ទៀត ក៏ រងរបួស នៅក្នុង ខេត្ត Helmand ហើយ អាវុធ និង គ្រាប់ រំសេវ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ របស់ ពួកគេ ក៏ ត្រូវបាន បំផ្លាញ ផងដែរ នៅក្នុង ខេត្ត ទាំង ពីរ ខាងលើ នេះ ។
យ៉ាងណា ក៏ដោយ ព័ត៌មាន លម្អិត អំពី ការស្លាប់ និង រងរបួស ដែល អាច កើតមាន នៅ ខាង កងកម្លាំង សន្តិសុខ អាហ្វហ្គានីស្ថាន មិន ត្រូវបាន គេ ដឹង ច្បាស់ នោះ ទេ ។ រីឯ ក្រុម សកម្ម ប្រយុទ្ធ តាលី បង់ ក៏ មិន ទាន់ បាន ធ្វើ ការអត្ថាធិប្បាយ លើ របាយការណ៍ នេះ នៅឡើយ ដែរ ។
ក្រសួង សុខាភិបាល . ក្រសួង ការងារ និង អភិបាល រាជធានី ភ្នំពេញ បើក កិច្ចប្រជុំ រួមគ្នា រិះរក វិធានការ ទប់ស្កាត់ ជំងឺ កូវីដ តាម រោងចក្រ
សមាគម រោងចក្រ កាត់ដេរ កម្ពុជា បាន លើកឡើង ថា វិស័យ ឯកជន បើ បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ចំនួន ២ដូស ហើយ គួរ កាត់បន្ថយ ពី ការធ្វើចត្តាឡី ស័ក ពី ១៤ ថ្ងៃ មក នៅ ៧ ថ្ងៃ វិញ ហើយ វិស័យ ឯកជន ពេលនេះ ក៏ មាន ឧបករណ៍ សម្រាប់ ធ្វើតេស្តរហ័ស រក ជំងឺ កូវីដ១៩ ចំនួន ៧០ ម៉ឺន ផងដែរ ដែល ការចំណាយ ជាបន្ទុក របស់ រោងចក្រ ឬ ក្រុមហ៊ុន ។
ពួកគាត់ ជឿជាក់ ថា ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ បាន ចំនួន ២ដូស ហើយ បើ ឆ្លង កូវីដ១៩ ក៏ វា មាន លក្ខណៈ ស្រាល ដែរ មិន ធ្ងន់ធ្ងរ ពិបាក ក្នុង ការព្យាបាល នោះ ទេ ។
អង្គប្រជុំ ក៏ បាន លើកឡើង ពី ការអនុវត្ត នៃ ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ ត្រូវតែ កែសម្រួល មិន ត្រូវ អនុវត្ត ដូច ពេល ដែល យើង មិន ទាន់ បាន ចាក់ វ៉ាក់សាំង នោះ ទេ ។ ជាក់ស្តែង នៅ ពេល នេះ រាជធានី ភ្នំពេញ បាន ចាក់ វ៉ាក់សាំង ដូស ទី២ បញ្ចប់ ហើយ ដូច្នេះ យើង គួរតែ កែប្រែ ការអនុវត្ត វិធាន មួយចំនួន មិន គួរ នៅ រក្សា ដដែល នោះ ទេ ៕ គ្រោះ រញ្ជួយ ដី កម្រិត ៥. ៩រ៉ិច ទ័រ វាយប្រហារ ប្រទេស តាហ្ស៊ី គីស្ថាន ផ្ដាច់ ជីវិត មនុស្ស ៥នាក់
គួរ បញ្ជាក់ ថា បើ តាម មជ្ឈមណ្ឌល ឃ្លាំមើល គ្រោះ រញ្ជួយ ដី អឺរ៉ុប គ្រោះ រញ្ជួយ ដី នេះ បាន កើតឡើង នៅ ចម្ងាយ ១៧០ គីឡូម៉ែត្រ ពី ភាគ អាគ្នេយ៍ ទីក្រុង ខូហ្សាន (Khujand) និង មាន ជម្រៅ រញ្ជួយ ទៅក្នុង ដី ៩គីឡូម៉ែត្រ ៕ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង បិទ ជា បណ្តោះអាសន្ន ផ្សារ លើ ក្រុង កំពង់ឆ្នាំង ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩
( កំពង់ឆ្នាំង ) ៖ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង បាន ចេញ សេចក្តីសម្រេច បិទ ជា បណ្តោះអាសន្ន ផ្សារ លើ ក្រុង កំពង់ឆ្នាំង ស្ថិត ក្នុង ភូមិសាស្រ្ត ភូមិ ត្រពាំង៣ សង្កាត់ ផ្សារ ឆ្នាំង ក្រុង កំពង់ឆ្នាំង ខេត្ត កំពង់ឆ្នាំង ចាប់ពី ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃ ជូនដំណឹង សារជាថ្មី ។
បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា ការសម្រេច បិទ ជា បណ្តោះអាសន្ន នូវ ផ្សារ កំពង់ឆ្នាំង នេះ គឺ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ បន្ទាប់ពី បាន រកឃើញ អ្នកជំងឺ កូវីដ១៩ បាន ចេញ - ចូល ក្នុង ផ្សារ ខាងលើ នេះ ៕
បើ តាម មន្ត្រី របស់ សម្តេច Pope សម្តេច ពិតជា ចង់ បំពេញ ទស្សនកិច្ច ទៅកាន់ ប្រទេស កូរ៉េ ខាងជើង ខ្លាំង ណាស់ ដោយ ស្ថិត នៅក្នុង គោលដៅ លើកកម្ពស់ នូវ សន្តិភាព ក្នុង ឧបទ្វីប កូរ៉េ បើ ទោះបីជា ទ្រង់ ដឹង ថា ព្រះរាជ បំណង មួយ នេះ មាន សង្ឃឹម តិចតួច ដែល អាច កើតឡើង ក្តី ។
ស្ថានទូត ចិន ប្រចាំ កម្ពុជា ឧបត្ថម្ភ ម៉ាស់ ពេទ្យ ចំនួន ៣ម៉ឺន ម៉ាស ដល់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាព កម្ពុជា - ចិន
( ភ្នំពេញ ) ៖ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាព កម្ពុជា - ចិន នៃ សមាគម និស្សិត កម្ពុជា ប្រចាំ សាធារណរដ្ឋ ប្រជាមានិត ចិន (ACSC) ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ លោក Wang Wentian ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ កម្ពុជា ដែល បាន បន្ត ឧបត្ថម្ភ ម៉ាស់ ពេទ្យ ចំនួន ៣ម៉ឺន ម៉ាស សម្រាប់ គាំទ្រ ដល់ សកម្មភាព ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន មិត្តភាព កម្ពុជា - ចិន ក្នុង ការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ និង សកម្មភាព មនុស្សធម៌ ផ្សេង ទៀត របស់ សមាគម និស្សិត កម្ពុជា ប្រចាំ ប្រទេស ចិន ។
ទន្ទឹម គ្នា នេះ ដែរ លោក អ៊ុំ វុទ្ធ ទី ប្រធាន ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន កម្ពុជា - ចិន បាន បន្ត ថា « ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យើងខ្ញុំ ពិតជា មោទនភាព ណាស់ ដែល បាន ចូលរួម ក្នុង បុព្វហេតុ ជាតិ ក្នុង យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ-19 ដោយ មិន គិត ថ្លៃ ជូន ប្រជាពលរដ្ឋ ជាតិ និង អន្តរជាតិ ទូទាំង ប្រទេស ដែល ជា យន្តការ របស់ សម្តេច អគ្គ មហ សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ ដូចជា ការចួល រួម សម្រាល បន្ទុក របស់ រាជា រដ្ឋាភិបាល កម្ពុជា យើង ផងដែរ » ។
លោក បន្ត ថា ប្រជាពលរដ្ឋ ខ្មែរ និង បរទេស ទាំង ចាស់ ទាំង ក្មេង បាន ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ-19 ដោយ ស្ម័គ្រចិត្ត និង ក្តី សប្បាយរីករាយ ។
សូម ជម្រាប ថា គិត ត្រឹម ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្ន ក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៥៩. ៩៧៨ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ សរុប ចំនួន ៥១. ៦៦០ នាក់ និង ស្លាប់ សរុប ចំនួន ៨៨១ នាក់ ៕ សង្កាត់ ទាំង៣ ត្រូវបាន កាត់ ចេញ ពី ស្រុក ទឹក ឈូ ខេត្ត កំពត បង្កើត ជា ក្រុង បូក គោ ថ្មី
( កំពត ) ៖ លោក ជា វ តាយ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត និង ថ្នាក់ដឹកនាំ មួយចំនួន ទៀត នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចុះ ជួប សំណេះសំណាល ជាមួយ អង្ក បោះឆ្នោត នៃ សង្កាត់ ទាំង បី ដែល កាត់ ចេញ ពី ស្រុក ទឹក ឈូ បង្កើត ជា ក្រុង បូក គោ ថ្មី តាម អនុក្រឹត្យ លេខ ៣៨ អន ក្រ ចុះ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២១ ដែល ប្រព្រឹត្ត ឡើង នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ឃុំ បឹង ទូក ស្រុក ទឹក ឈូ ខេត្ត កំពត ។
លោក ជា វ តាយ បាន បន្ត ថា ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ក្រុង បូក គោ ខេត្ត កំពត ដែល រៀបចំឡើង ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត នឹង ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២១ ខាងមុខ នេះ រួម មាន គណបក្ស នយោបាយ ចូលរួម ប្រកួតប្រជែង ចំនួន ៤៖
ទី១៖ គណបក្ស ប្រជាជន កម្ពុជា ទី២៖ គណបក្ស យុវជន កម្ពុជា ទី៣៖ គណបក្ស សញ្ជាតិ កម្ពុជា និង ទី៤៖ គណបក្ស ហ៊្វុនស៊ិនប៉ិច ។
ទន្ទឹម នេះ លោក ជា វ តាយ ក៏ បាន ផ្ដាំផ្ញើ ដល់ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ បង្កើន ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ឱ្យ បាន ល្អ ។ ពិសេស សមាជិក សមាជិកា ក្រុមប្រឹក្សា សង្កាត់ ទាំង ១៧រូប ក្នុង សង្កាត់ ទាំង បី ដែល ជា អង្គ បោះឆ្នោត ត្រូវ ត្រៀមលក្ខណៈ សម្បត្តិ ឯកសារ ឱ្យ បាន គ្រប់គ្រាន់ និង ថែរក្សា សុខភាព ឱ្យ បាន ល្អ សម្រាប់ ត្រៀម ការបោះឆ្នោត នៅពេល ដ៏ ខ្លី ខាងមុខ នេះ ។
លោក នឹង សម្ដែង ការសង្ឃឹម ចំពោះ លទ្ធផល នៃ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ក្រុង បូក គោ នា ពេល ខាងមុខ នេះ ពិតជា នឹង ទទួលបាន លទ្ធផល ជោគជ័យ ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បន្ត កិច្ចអភិវឌ្ឍ មូលដ្ឋាន ឱ្យ បាន កាន់តែ រីកចម្រើន និង ធ្វើឱ្យ ជីវភាព ប្រជាពលរដ្ឋ កាន់តែ ល្អ ប្រសើរ ថែម មួយ កម្រិត ទៀត ។
( កោះកុង) ៖ រដ្ឋបាល ស្រុក បូទុម សាគរ ខេត្ត កោះកុង បាន ចេញ សេចក្តីជូនដំណឹង ផ្អាក់ ដំណើរការ ជា បណ្ដោះអាសន្ន នូវ ផ្សារ អណ្ដូង ទឹក ឃុំ អណ្ដូង ទឹក ស្រុក បុទុម សាគរ រយៈពេល ១៤ ថ្ងៃ ដោយ ចាប់ គិត ពី ម៉ោង ០០ នាទី ថ្ងៃទី ១០ រហូតដល់ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២១ ដើម្បី បង្កា និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ដល់ អាជីវករ អតិថិជន ក៏ ដូចជា ប្រជាពលរដ្ឋ ដែល ចេញ ចូលក្នុង ទីតាំង សារ ខាងលើ ។
ទន្ទឹម នេះ រដ្ឋបាល ស្រុក សូម អំពាវនាវ ដល់ អាជីវករ និង ក្រុមគ្រួសារ អាជីវករ ពាក់ព័ន្ធ ព្រមទាំង ប្រជាពលរដ្ឋ បើ មាន អាការៈ ក្តៅ ខ្លួន ក្អក ពិបាក ដកដង្ហើម ហើយ មាន អាការសង្ស័យ ថា ឆ្លង មេរោគ កូវីដ១៩ សូមអញ្ជើញ ទំនាក់ទំនង ជាមួយ អាជ្ញាធរ មូលដ្ឋាន និង មណ្ឌល សុខភាព អណ្ដូង ទឹក លេខ ទូរស័ព្ទ ០១៥ ២១០៦៦៦ ដើម្បី មក យក សំណាក ធ្វើតេស្ត រក មេរោគ កូវីដ១៩ ព្រមទាំង អនុវត្ត វិធានការចត្តាឡី ស័ក តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ត្រឹមត្រូវ បំផុត ។
( ភ្នំពេញ ) ៖ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ចំនួន ៤លាន ដូស ថែម ទៀត បាន ដឹក ពី ប្រទេស ចិន មកដល់ ប្រទេស កម្ពុជា បន្ត ទៀត ហើយ នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ។
បើ តាម លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ថា វ៉ាក់សាំង ដែល ដឹក មកដល់ នៅ ថ្ងៃ នេះ មាន វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ចំនួន ៣លាន ដូស និង វ៉ាក់សាំងស៊ីណូ ហ្វាម ១លាន ដូស ។ លោកស្រី បាន បញ្ជាក់ ថា វ៉ាក់សាំង ៤លាន ដូស នេះ គឺជា ការបញ្ជាទិញ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
អាហ្វហ្គានីស្ថាន ងាក ទៅ ពឹង រុស្ស៉ី ចិន និង ឥណ្ឌា ឲ្យ ជួយ ក្រោយ អាមេរិក ប្រកាស ដក ទ័ព ចេញ ទាំងស្រុង
( កាប៊ុល) ៖ រដ្ឋាភិបាល ទីក្រុង កាប៊ុល បាន ធ្វើ ការអំពាវនាវ ទៅកាន់ ប្រទេស រុស្ស៉ី ចិន និង ឥណ្ឌា ដែល សុទ្ធសឹង ជា ប្រទេស ក្បែរខាង ឲ្យ ជួយ ប្រទេស នេះ ទប់ទល់ នឹង អំពើ ភេរវកម្ម ខណៈ កងទ័ព អាមេរិក នឹង ត្រូវ ដក ចេញ ទាំងស្រុង នៅ ត្រឹម ដំណាច់ ខែសីហា ខាងមុខ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នា ព្រឹក ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ ។
ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ទីប្រឹក្សា សន្តិសុខ ជាតិ អាហ្វហ្គានីស្ថាន លោក ហាំឌុលឡាហ៍ ម៉ូហ៊ីប (Hamdullah Mohib) បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « សន្តិភាព និង ស្ថិរភាព ទាមទារ ឱ្យ មាន កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស នានា នៅក្នុង តំបន់ និង នៅ ក្រៅ តំបន់ ដើម្បី ជួយ ពួកយើង ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជាមួយ ក្រុម ភេរវករ ដោយ មិន ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ ពួកយើង ឡើយ » ។ លោក Mohib បាន បន្ថែម ថា អាហ្វហ្គានីស្ថាន ស្វាគមន៍ ជានិច្ច ប្រទេសជា ដៃគូ ដូចជា ចិន ឥណ្ឌា និង រុស្ស៊ី ។
គួរ បញ្ជាក់ ថា មក ទល់នឹង ពេល នេះ សហរដ្ឋ អាមេរិក បាន ដក កងទ័ព ចេញ ពី អាហ្វហ្គានីស្ថាន បាន ច្រើន ជាង ៩០ ភាគរយ ហើយ នឹង ត្រូវ ដក ចេញ ទាំងស្រុង ឱ្យ បាន មុន ថ្ងៃ ខួប នៃ ការវាយប្រហារ ភេរវកម្ម ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០០១ ។ ប៉ុន្តែ ព្រម ពេល ជាមួយ ក្រុម តាលី បង់ ត្រូវបាន គេ រាយការណ៍ ថា កំពុង កាន់កាប់ ទឹកដី ជាង ៨៥ ភាគរយ នៅក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន រួចទៅហើយ ៕ បច្ចុប្បន្នភាព ប្រចាំ ថ្ងៃ៖ គិត ត្រឹម ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា នេះ តំបន់ អាស៊ាន មាន អ្នក ឆ្លង កូវីដ១៩ ជាង ៥. ៣៨លាន នាក់ ស្លាប់ ជាង ១០.៣ម៉ឺន នាក់
សភា ពាណិជ្ជកម្ម កម្ពុជា ចាត់ទុក សេចក្តីព្រាង ច្បាប់ វិនិយោគ ថ្មី ដែល ទើប ត្រូវបាន រាជ រដ្ឋាភិបាល អនុម័ត ជា ដែក ឆក់ ស្រូប ទាញ វិនិយោគ បន្ថែម មក កម្ពុជា
( ភ្នំពេញ ) ៖ លោក លឹម ហេង អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា បាន បង្ហាញ ពី ការគាំទ្រ ចំពោះ ច្បាប់ វិនិយោគ ថ្មី បន្ទាប់ពី សេចក្ដីព្រាង ច្បាប់ នេះ ត្រូវបាន អនុម័ត ដោយ រាជ រដ្ឋាភិបាល នៅក្នុង កិច្ចប្រជុំ ពេញ អង្គ នៅ ថ្ងៃទី ៩ ខែកក្កដា ឆ្នាំ ២០២១ ។
លោក ថា ក្នុង នាម សភា ពាណិជ្ជកម្ម កម្ពុជា សូម អបអរសារទរ ចំពោះ ច្បាប់ វិនិយោគ ថ្មី ដែល បាន ដាក់ចេញ ព្រោះ សភា ពាណិជ្ជកម្ម កម្ពុជា និង ដៃគូ ពាក់ព័ន្ធ បាន ចូលរួម ប្រជុំ ពីរ លើ ក ហើយ ជាមួយ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ដែល បាន ផ្ដល់ ធាតុ ចូល ជាច្រើន ដល់ ច្បាប់ ថ្មី នេះ ។
លោក បន្ថែម ថា នេះ ក៏ ទន្ទឹម ពេល ដែល ប្រមុខ រាជ រដ្ឋាភិបាល បាន ប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ក្នុង ការកែទម្រង់ ស៊ីជម្រៅ ផ្នែក សេដ្ឋកិច្ច នេះ ដើម្បី ដើរ ឲ្យ ទាន់ សភាពការណ៍ នៃ ការដាក់ ឧស្សាហកម្ម ឌីជីថល នេះ ជា យុទ្ធសាស្ដ្រ ដ៏ ល្អ ហើយ ជា ការលើកទឹកចិត្ត បន្ថែម សម្រាប់ អ្នក វិនិយោគ ក្នុង ស្រុក ក៏ ដូចជា បរទេស ដែល អាច ទទួលបាន ផលប្រយោជន៍ ពី ពី ច្បាប់ វិនិយោគ ថ្មី នេះ ផងដែរ ។
អ្វី ដែល ពិសេស ជាង នេះ ទៀត នោះ ច្បាប់ ថ្មី អនុញ្ញាតឲ្យ អនុគណៈកម្មការ វិនិយោគ ខេត្ត អាច អនុម័ត គម្រោង មាន ទឹកប្រាក់ ធំ ជាង មុន ដែល ច្បាប់ ចាស់ មាន ត្រឹម ២លាន ដុល្លារ ប៉ុណ្ណោះ ។
ឧកញ៉ា លឹម ហេង អះអាង ថា ក្នុង ពេល ចូលរួម កិច្ចប្រជុំ សម្រាប់ ជា ធាតុ ចូលក្នុង សេចក្តីព្រាង ច្បាប់ វិនិយោគ ថ្មី វិស័យ ឯកជន បាន ស្នើសុំ ឲ្យ អនុគណៈកម្មការ វិនិយោគ ខេត្ត អាច អនុម័ត គម្រោង វិនិយោគ ក្នុង តម្លៃ ក្រោម ១០លាន ដុល្លារ ដែល ការធ្វើ បែប នេះ នឹង ជួយ បង្ខិត រោងចក្រ សហគ្រាស ទៅកាន់ បណ្ដា ខេត្ត ផ្សេង ៗ ងាយស្រួល ឲ្យ ប្រជាពលរដ្ឋ និង កម្មករ មាន ការងារ ធ្វើ នៅនឹង កន្លែង នេះ ជា ការជួយ កាត់បន្ថយ ភាពក្រីក្រ ដោយ មិន ចំបាច់ ចំណាកស្រុក មកកាន់ រាជធានី ភ្នំពេញ ឬ ទៅ ស្រុក ក្រៅ ដើម្បី រក ការងារ ធ្វើជាដើម ។
សូម ជម្រាប ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី វិនិយោគ ថ្មី ដែល មាន ១២ជំពូក និង ៤២ មាត្រា ត្រូវបាន សម័យ ប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី នៅ ថ្ងៃទី ៩ ខែកក្កដា ឆ្នាំ ២០២១ អនុម័ត រួចរាល់ ហើយ ដែល នឹង ត្រូវ បញ្ជូន ទៅ រដ្ឋភាស ដើម្បី ពិនិត្យ និង អនុម័ត បន្ត ។
ដើម្បី ផ្ដល់ ភាពកក់ក្ដៅ ដល់ វិនិយោគិន សេចក្ដីព្រាង ច្បាប់ នេះ បាន ដាក់បញ្ចូល នូវ កាតព្វកិច្ច ជា អន្តរជាតិ មួយចំនួន របស់ កម្ពុជា ដើម្បី បង្ហាញ ដល់ វិនិយោគិន ទាំងអស់ នូវ ការប្ដេជ្ញា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការការពារ វិនិយោគ និង ផ្ដល់ ការធានា ដោយ អនុលោម តាម ច្បាប់ អន្តរជាតិ នូវ ប្រព្រឹត្តកម្ម ដែល មិន រើសអើង ព្រមទាំង ផ្ដល់ សេវា ថែទាំ វិនិយោគ ផងដែរ ៕ ខេត្ត ព្រៃវែង បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ចំនួន ៩០ នាក់ ថែម ទៀត
បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ទាំង ៩០ នាក់ ខាងលើ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង តាម មន្ទីរពេទ្យ បង្អែក ស្រុក របស់ ពួកគេ នីមួយ ៗ ។
ជាថ្មី ម្តង ទៀត រដ្ឋបាល ខេត្ត ព្រៃវែង សូម អំពាវនាវ ចំពោះ អ្នក ដែល បាន ប្រាស្រ័យទាក់ទង ប៉ះពាល់ ដោយ ផ្ទាល់ ឬ ប្រយោល ជាមួយ បុគ្គល វិជ្ជមាន កូវីដ - ១៩ ខាងលើ សូម ដាក់ ខ្លួន ដាច់ដោយឡែក តាមដាន សុខភាព រយៈពេល ១៤ ថ្ងៃ និង រាយការណ៍ មក អាជ្ញាធរ ដើម្បី យក សំណាក និង ធ្វើចត្តាឡី ស័ក ៕
ព្រឹក នេះ រាជ បណ្ឌិត្យ សភា កម្ពុជា រៀបចំ កិច្ចពិភាក្សា តុ មូល ក្រោម ប្រធានបទ « តើ អ្វី ទៅ ជា ឆ្អឹង ខ្នង សេដ្ឋកិច្ច កម្ពុជា ? »
ព្រឹក ថ្ងៃស្អែក វ៉ាក់សាំង ៤លាន ដូស ទៀត នឹង ដឹក ពី ប្រទេស ចិន មកដល់ ប្រទេស កម្ពុជា
( ភ្នំពេញ ) ៖ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ចំនួន ៤លាន ដូស ថែម ទៀត នឹង ដឹក ពី ប្រទេស ចិន មកដល់ ប្រទេស កម្ពុជា បន្ត ទៀត នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ ស្អែក នេះ ។
បើ តាម លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ថា វ៉ាក់សាំង ដែល ដឹកនាំ មកដល់ នៅ ថ្ងៃស្អែក នេះ មាន វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ចំនួន ៣លាន ដូស និង វ៉ាក់សាំងស៊ីណូ ហ្វាម ១លាន ដូស ។ លោកស្រី បាន បញ្ជាក់ ថា វ៉ាក់សាំង ៤លាន ដូស នេះ គឺជា ការបញ្ជាទិញ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
គិត ចាប់តាំងពី ថ្ងៃទី ០៧ ខែកុម្ភៈ ដល់ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ កម្ពុជា ទទួលបាន វ៉ាក់សាំង ចំនួន ១២លាន ដូស រួចហើយ ។ ក្នុង នោះ វ៉ាក់សាំងស៊ីណូ ហ្វាម ជា ជំនួយ របស់ ចិន មាន ចំនួន ២.២លាន ដូស . វ៉ាក់សាំង អាស្ត្រា ហ្សេនីកា ជំនួយ របស់ ខូវ៉ាក់ ចំនួន ៣២៤.០០០ ដូស និង វ៉ាក់សាំង ចំនួន ៩. ៥លាន ដូស ជា ការបញ្ជាទិញ របស់ កម្ពុជា ពី ប្រទេស ចិន ។
សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ក្នុង ឱកាស ថ្លែង សារ ពិសេស កាលពី ថ្ងៃទី ០១ ខែកក្កដា បាន ឱ្យដឹង ថា នៅ ខែកក្កដា និង ខែសីហា ឆ្នាំ ២០២១ នេះ កម្ពុជា នឹង ទទួលបាន វ៉ាក់សាំង ចំនួន ៩លាន ដូស ពី ប្រទេស ចិន ដែល ជា ចំនួន វ៉ាក់សាំង គម្រប់ ២០លាន ដូស តាម ផែនការ ដែល រាជ រដ្ឋាភិបាល ស្វះស្វែងរក ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ។
វ៉ាក់សាំង គឺ ឧបករណ៍ យុទ្ធសាស្ត្រ មួយ សម្រាប់ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ក៏ ដូចជា ការពារ សុខភាព របស់ ប្រជាពលរដ្ឋ ពី ជំងឺ កូវីដ១៩ ។ តាមរយៈ វ៉ាក់សាំង ដែល កម្ពុជា ទទួលបាន ជា បន្តបន្ទាប់ ជួយ ឱ្យ កម្ពុជា សម្រេច ផែនការលើ ការងារ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ផងដែរ ។
គិត ត្រឹម ថ្ងៃទី ០៩ ខែកក្កដា កម្ពុជា ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ក៏ ដូចជា ជន បរទេស នៅ កម្ពុជា បាន ចំនួន ជាង ៤. ៧៩លាន នាក់ ហើយ ស្មើនឹង ជាង ៤៧. ៩៣ ភាគរយ នៃ ចំនួន ប្រជាពលរដ្ឋ ត្រូវ ចាក់ ក្នុង ផែនការ ។
លទ្ធផល ដែល សម្រេចបាន លើ ការងារ ចាក់ វ៉ាក់សាំង នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក រដ្ឋាភិបាល ចិន គឺជា អ្នកគាំទ្រ ដ៏ ខ្លាំងក្លា មួយ លើ កម្មវិធី ចាក់ វ៉ាក់សាំង ។
សម្តេច តេជោ បាន លើកឡើង ថា បើ គ្មាន ការជួយគាំទ្រ របស់ ចិន ទេ នោះ កម្ពុជា ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ មិន បាន ២០ម៉ឺន នាក់ នោះ ឡើយ ។ កាលពី ថ្ងៃទី ០១ ខែកក្កដា សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស យកចិត្ត ធ្វើជា បង្អែក យុទ្ធសាស្ត្រ ក្នុង ការផ្គត់ផ្គង់ វ៉ាក់សាំង មក កម្ពុជា ផងដែរ ៕
អត្ថន័យ នៃ ឃ្លា ដើម គឺ៖ ឆ្លុះ កញ្ចក់ ស្ពាន់ អាច សារេ ខោអាវ និង មួក ឱ្យ ត្រង់ ល្អ ឆ្លុះ កញ្ចក់ នៃ ប្រវត្តិសាស្ត្រ អាច យល់ដឹង ពី មេរៀន នៃ ការរីកចម្រើន និង ភាពបរាជ័យ មើល អ្នក នៅក្បែរ ខ្លួន អាច វាយតម្លៃ លើ ខ្លួន ឯង បាន ។
រំលឹក ពី ប្រវត្តិសាស្ត្រ អាច បូកសរុប បទពិសោធន៍ ដើម្បី ជួយ បង្កើន ទឹកចិត្ត ក្លាហាន ដើរ ឆ្ពោះទៅ មុខ ។ ពេល បោះជំហាន ទៅ មុខ សូម កុំ ភ្លេច មាគ៌ា ដែល ធ្លាប់ ឆ្លងកាត់ ទោះ ដើរ ដល់ អនាគត ដ៏ ឆ្ងាយ វែង និង ភ្លឺស្វាង ប៉ុន ណា ក្តី ក៏ មិន ត្រូវ បំភ្លេច ទី ចាប់ផ្តើម ដែរ សូម កុំ ភ្លេច អតីតកាល ដែល បាន យើង ឆ្លងកាត់ កុំ ភ្លេច ថា ការចេញដំណើរ គឺ ដើម្បី អ្វី ដើម្បី នរណា ។ មាន តែ អ្នក ដែល រួម សុខ រួម ទុក្ខ ជាមួយ ប្រវត្តិសាស្ត្រ និង យុគសម័យ ប៉ុណ្ណោះ ទេ ទើប អាច កសាង នូវ អនាគត ដ៏ ត្រចះត្រចង់ ៕
ចំណេះដឹង ទូទៅ៖ មនុស្ស បាន មក រស់ នៅ តំបន់ អង្គរ យ៉ាងហោចណាស់ តាំងពី ៣៨០០ ឆ្នាំ មុន
( សៀមរាប ) ៖ ថ្វីដ្បិត អរិយធម៌ សម័យ អង្គរ បាន ស្គាល់ នូវ ភាពរុងរឿង ចាប់ពី សតវត្ស ទី ៩ ដល់ សតវត្ស ទី ១៥ ក៏ ពិត មែន ប៉ុន្តែ បុព្វបុរស ខ្មែរ យើង បាន មក រស់ នៅ តំបន់ អង្គរ តាំងពី សម័យ បុរេប្រវត្តិ មក ម្ល៉េះ ដោយ អ្នក បុរាណវិទ្យា បាន ធ្វើ កំណាយ រកឃើញ គ្រោង ឆ្អឹង មនុស្ស ដែល មាន អាយុកាល ប្រមាណ ៣. ៨០០ ឆ្នាំ មុន រួម ជាមួយ អាថ៌កំបាំង មួយចំនួន ទៀត ដែល ស្ថិត នៅ ជាមួយ កន្លែង បញ្ចុះ សាកសព ទាំងនោះ ។
ភស្តុតាង ទាំងឡាយ គឺ មាន តម្កល់ ទុក នៅក្នុង « សារ មន្ទីរ ព្រះនរោត្តម សីហនុ - អង្គរ » ដែល មាន ទីតាំង ស្ថិត នៅ សង្កាត់ ស្ល ក្រាម ក្រុង សៀមរាប ខេត្ត សៀមរាប ។ នៅក្នុង សារ មន្ទីរ នេះ គឺ មាន ដាក់តាំងពិព័រណ៍ នូវ ផ្នូរ សាកសព និង គ្រោងឆ្អឹង ចម្លង ( សិប្បនិម្មិត ) លលាដ៍ ក្បាល កុលាល ភាជន៍ គ្រឿងអលង្ការ និង ឧបករណ៍ ប្រើប្រាស់ របស់ មនុស្ស សម័យ បុរេប្រវត្តិ ដែល បាន ពី ការធ្វើ កំណាយ រកឃើញ កាលពី អំលុង ឆ្នាំ ២០០៤ - ២០០៥ កន្លងទៅ ។
លោក គុន ផល្លី មគ្គុទ្ទេសក៍ ប្រចាំ សារ មន្ទីរ ព្រះនរោត្តម សីហនុ - អង្គរ បាន ឱ្យដឹង ថា ទីតាំង ដែល គេ ធ្វើ កំណាយ រកឃើញ ទី បញ្ចុះ សព និង គ្រោងឆ្អឹង របស់ មនុស្ស សម័យ បុរេប្រវត្តិ ទាំងនោះ គឺ ស្ថិត នៅ ស្ថានីយ បុរេប្រវត្តិសាស្ត្រ « កោះ មាស » ដែល ជា កូន កោះ តូច មួយ ស្ថិត នៅក្នុង បារាយណ៍ ទឹក ថ្លា ( បារាយណ៍ ខាងលិច ) ពោល គឺ មាន ចម្ងាយ ប្រមាណ ១.៣០០ ម៉ែត្រ ខាងលិច ប្រាសាទ មេ បុណ្យ ខាងលិច ។
លោក ផល្លី បាន បញ្ជាក់ ថា « ស្ថានីយ កោះ តា មាស គឺជា ស្ថានីយ បុរេប្រវត្តិសាស្ត្រ ដែល ចាស់ ជាង គេ នៅ ខេត្ត សៀមរាប » ។ ស្ថានីយ នេះ កើត មាន ឡើង នៅក្នុង យុគសំរឹទ្ធ ដែល ត្រូវបាន ចែកចេញ ជា ពីរ ដំណាក់កាល ដោយ ដំណាក់កាល ទី១ មាន អាយុកាល ចាប់ពី ឆ្នាំ ១៨០០ - ១៦០០ មុន គ្រិស្ដ សករាជ និង ដំណាក់កាល ទី២ មាន អាយុកាល ចាប់ពី ឆ្នាំ ១៦០០ - ១០០០ មុន គ្រិស្ដ សករាជ ។
នៅ ស្ថានីយ បុរេប្រវត្តិ ដ៏ ចំណាស់ មួយ នេះ ក្រុម បុរាណវិទូ បាន ធ្វើ កំណាយ រកឃើញ ផ្នូរ សាកសព ឬ ទី បញ្ចុះ សព គ្រោង ឆ្អឹង មនុស្ស កុលាល ភាជន៍ គ្រឿងអលង្ការ ធ្វើ អំពី សំរឹទ្ធ និង ធ្វើ អំពី ដែក និង ឧបករណ៍ ប្រើប្រាស់ របស់ មនុស្ស ក្នុង សម័យ យុគសំរឹទ្ធ ជាច្រើន ទៀត ។ គេ ថែមទាំង បាន រកឃើញ គ្រឿង សំណែន ឬ គ្រឿង ដង្វាយ ដែល មនុស្ស ជំនាន់ នោះ សែន ថ្វាយ ជូន អ្នកស្លាប់ ក្នុង នោះ មាន ក្បាល ជ្រូក គ្រាប់ ធញ្ញជាតិ កុលាល ភាជន៍ និង ឧបករណ៍ ប្រើប្រាស់ ផ្សេង ទៀត ជាដើម ។
មគ្គុទ្ទេសក៍ វា ចារ ចំណាន រូប នេះ បាន បន្ត ថា ក្រុម បុរាណវិទូ ថែមទាំង បាន សិក្សា ស្រាវជ្រាវ រកឃើញ អំពី មូលហេតុ ដែល បណ្ដាលឱ្យ អ្នកស្រុក ជំនាន់ បុរេប្រវត្តិ នោះ ស្លាប់ ក្នុង នោះ មាន ការស្លាប់ ដោយសារ ដក ធ្មេញ ដង្កូវ ស៉ី ធ្មេញ ក៏ ដូចជា ស្លាប់ ដោយសារ ជំងឺ ឈាម សស៉ី ឈាម ក្រហម ឬ ជំងឺ មហារីក គ្រាប់ ឈាម ។ ការសិក្សា នេះ គឺ ធ្វើឡើង តាម បែប វិទ្យាសាស្ត្រ និង តាម បែប ជាតិពន្ធុវិទ្យា ។
( តូក្យូ ) ៖ អាជ្ញាធរ ជប៉ុន នៅ ថ្ងៃសៅរ៍ នេះ បាន បង្គាប់ ឱ្យ ប្រជាជន ច្រើន ជាង ១២០.០០០ នាក់ ដែល រស់ នៅក្នុង តំបន់ មួយចំនួន នៃ បណ្ដា ខេត្ត ភាគ ខាងត្បូង ជម្លៀស ខ្លួន ទៅ រក ទី ទួល មាន សុវត្ថិភាព រៀបចំ ដោយ រដ្ឋ ដោយសារតែ បារម្ភ ពី ភ្លៀង ធ្លាក់ ខ្លាំង ។ នេះ បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ នៅក្នុង ស្រុក ដកស្រង់ ចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ ។
ទូរទស្សន៍ ជប៉ុន NHK បាន រាយការណ៍ ថា អាជ្ញាធរ ឧតុនិយម ជប៉ុន បាន ប្រកាស អាសន្ន ពី ភ្លៀង ធ្លាក់ ខ្លាំង កម្រិត ខ្ពស់ នៅក្នុង ខេត្ត ចំនួន ស្ថិត នៅលើ កោះ Kyushu ហើយ តាមរយៈ ការប្រកាស អាសន្ន នេះ អាជ្ញាធរ នៅក្នុង តំបន់ ត្រូវ បង្គាប់ ឱ្យ ប្រជាជន ជម្លៀស ខ្លួន ទៅ រក កន្លែង មាន សុវត្ថិភាព ។
គួរ បញ្ជាក់ ថា ការបង្គាប់ ឱ្យ ប្រជាជន ជប៉ុន ជម្លៀស ខ្លួន ខាងលើ ធ្វើឡើង តែ ជាង មួយ សប្ដាហ៍ ប៉ុណ្ណោះ បន្ទាប់ពី ភ្លៀង ធ្លាក់ ខ្លាំង បាន វាយប្រហារ និង បង្កឱ្យ មាន ទឹក ជំនន់ ព្រមទាំង គ្រោះ រអិល បាក់ដី នៅក្នុង ទីក្រុង Atami ដោយ ផ្ដាច់ ជីវិត មនុស្ស យ៉ាងហោច ៩នាក់ និង ២០ នាក់ បាត់ខ្លួន ៕
ប្រជាពលរដ្ឋ ២៥០ គ្រួសារ នៅ ខណ្ឌ បឹងកេងកង ទទួល អំណោយ ពី សប្បុរសជន សម្រាប់ ដោះស្រាយ ជីវភាពនា ដំណាក់កាល កូវី ដ១៩
ខណៈ ចុះ នាំយក ស្បៀងអាហារ នា ឱកាស នោះ លោក ធឹម សំអាន បាន ស្នើ ដល់ ប្រជាពលរដ្ឋ បន្ត អនុវត្តន៍ តាម ការណែនាំ នូវ វិធានការ សុខាភិបាល និង វិធានការ « ៣ការពារ និង ៣កុំ » ឱ្យ បាន ខ្ជាប់ខ្ជួន ។
ជាមួយគ្នា នោះ លោក ធឹម សំអាន បាន ក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ ដោយ បាន នាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម អត់ធ្មត់ រស់ នៅ ដោយ រក្សា គម្លាត បន្ត មួយ រយៈ ទៀត ដើម្បីឱ្យ ប្រាកដ ថា មាន សុវត្ថិភាព ជៀស ឆ្ងាយ ពី ជំងឺ ឆ្លង កូវីដ១៩ និង សូម ចូលរួម អនុវត្ត ឱ្យ បាន នូវ វិធានការ នានា របស់ ក្រសួង សុខាភិបាល ក្នុង ការចូលរួម បង្កា ទប់ស្កាត់ កូវីដ១៩ ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក ធឹម សំអាន ក៏ បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង ក្ដី នឹករលឹក ពីសំណាក់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដែល ជានិច្ចកាល លោក តែង គិតគូរ យកចិត្តទុកដាក់ ចំពោះ ស្បៀងអាហារ ដល់ ប្រជាពលរដ្ឋ នៅ តាម ទីតាំង នានា ក្នុង រាជធានី ។
ប្រជាជន ទាំង ២៥០ គ្រួសារ ខាងលើ នោះ គឺ ពួកគាត់ មាន ទឹកចិត្ត សប្បាយរីករាយ ជាខ្លាំង ខណៈ បាន ទទួល អំណោយ ទុក ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ នា សម័យ កូវីដ១៩ និង សូម អរគុណ ដល់ លោក អភិបាល ខណ្ឌ បឹងកេងកង ធឹម សំអាន និង ម្ចាស់ អំណោយ ដែល បាន ផ្ដល់ អំណោយ ដល់ ពួកគាត់ នា ពេលនេះ ៕
យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ពលរដ្ឋ នៅ ខេត្ត កំពង់ចាម អាច បញ្ចប់ ត្រឹម ពាក់កណ្ដាល ខែសីហា ខាងមុខ នេះ
( កំពង់ចាម ) ៖ នៅក្នុង ពិធី ចែក អំណោយ គ្រឿង ឧបភោគ បរិភោគ ជូន ប្រជាពលរដ្ឋ ២០០ គ្រួសារ នៅ សាលា ស្រុក ស្ទឹងត្រង់ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន ឱ្យដឹង ថា យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពង់ចាម នឹង ត្រូវ បិទ បញ្ចប់ ក្នុង កំឡុង ពេល ពាក់កណ្ដាល ខែសីហា ឆ្នាំ ២០២១ ខាងមុខ នេះ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា បន្ទាប់ពី បាន ទទួល វ៉ាក់សាំង ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា រដ្ឋបាល ខេត្ត បាន បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ចំនួន ជាង ៣០ម៉ឺន នាក់ នៃ ស្រុក ចំនួន ៤ និង ក្រុង ១ បាន សម្រេច លទ្ធផល ប្រមាណ ៨០ % ហើយ ។
ដោយឡែក នៅ ស្រុក ចំនួន ៥ទៀត ដែល មាន ប្រជាពលរដ្ឋ ជាង ៤០ម៉ឺន នាក់ ដែល រដ្ឋបាល ខេត្ត និង រៀបចំ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន នៅក្នុង សប្តាហ៍ ក្រោយ ដែល នឹង ត្រូវ ប្រើប្រាស់ វ៉ាក់សាំង ជិត ១លាន ដូស ទៀត ហើយ យុទ្ធនាការ នេះ ដែរ នឹង ត្រូវ បិទ បញ្ចប់ នៅ ពាក់កណ្ដាល ខែសីហា ឆ្នាំ ២០២១ ។
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន នាំយក នូវ សម្ភារ និង ឧបករណ៍ ជាច្រើន ជូន ទៅ កងកម្លាំង ទី បញ្ជាការដ្ឋាន អង្គរក្ស ទុក សម្រាប់ ប្រើប្រាស់ ក្នុង ប្រតិបត្តិការ សង្គ្រោះ គ្រោះមហន្តរាយ ។ ការផ្តល់ សម្ភារ និង ឧបករណ៍ ជា ការគិតគូរ និង ត្រៀមលក្ខណៈ សម្បត្តិ ទុក ជាមុន សម្រាប់ កងកម្លាំង ក្នុង ការចុះអន្តរាគមន៍ ក្នុង ករណី កម្ពុជា កើត គ្រោះមហន្តរាយ បង្កឡើង ដោយ ធម្មជាតិ ក្នុង រដូវ វស្សា នេះ ។
ពិធី ប្រគល់ សម្ភារ និង ឧបករណ៍ សង្គ្រោះ គ្រោះមហន្តរាយ ត្រូវបាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក ហង្ស សាមឿន អនុប្រធាន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ព្រមទាំង អគ្គ លេខាធិការ រង និង ទីប្រឹក្សា គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ។
ក្នុង ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ បញ្ជាការដ្ឋាន អង្គរក្ស . លោក សួស យ៉ារ៉ា អនុប្រធាន គណៈកម្មាការ កិច្ចការ បរទេស សហប្រតិបត្ត ការអន្តរជាតិ ឃោសនា ការ និង ព័ត៌មាន នៃ រដ្ឋសភា និង ជា តំណាងរាស្ត្រ មណ្ឌល ខេត្ត ព្រះវិហារ ។
លោក ឧត្តមសេនីយ៍ ឯក អ៊ុង សារិទ្ធ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ បញ្ជាការដ្ឋាន អង្គរក្ស ក្នុង នាម នាយ ឧត្តមសេនីយ៍ ហ៊ុយ ពិសិដ្ឋ និង នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង បាន រំលឹក ពី ការពី ការដឹកនាំ បញ្ជារ ផ្ទាល់ របស់ នាយ ឧត្តមសេនីយ៍ គន់ គីម លើកម្លាំង អន្តរាគមន៍ ពិសេស ចល័ត ប្រយុទ្ធ រហ័ស ទាន់ ពេលវេលា ទាំង អាវុធ ធន់ ធ្ងន់ ក្នុង ពេល ប៉ះទង្គិច តាម បណ្តោយ ព្រំដែន និង ការចូលរួម ការពារ សន្តិសុខ សង្គម ។
ជាមួយគ្នា នេះ ក្នុង ដំណាក់កាល ជួប វិបត្តិ កូវីដ១៩ នេះ កងកម្លាំង នាយ ទាហាន ពល ទាហាន នៃ បញ្ជាការដ្ឋាន អង្គរក្ស ចំនួន ៣.០០០ នាក់ បាន ចេញ ប្រតិបត្តិការ ដោយ ប្រឈម ក្នុង តំបន់ មាត់ ជ្រោះ តំបន់ ក្រហម ដោយ បាន ដឹកជញ្ជូន លី វេចខ្ចប់ លើក ដាក់ ស្បៀងអាហារ គ្រប់ បែបយ៉ាង នៅ ក្នុង រាជធានី ភ្នំពេញ និង តាម បណ្តា ខេត្ត នានា ស្រប ទៅតាម បទបញ្ជា របស់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ។
ពាក់ព័ន្ធ ការងារ គ្រោះមហន្តរាយ វិញ លោក ឧត្តមសេនីយ៍ ឯក អ៊ុង សារិទ្ធ បាន ឱ្យដឹង ថា គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ធ្លាប់ បាន បញ្ជូន មន្ត្រី ជំនាញ និង បាន ផ្តល់ ជូន សម្ភារ ឧបករណ៍ ដល់ បញ្ជាការដ្ឋាន អង្គរក្ស ដើម្បី ម្ចាស់ ការ ក្នុង ការត្រៀម ប្រតិបត្តិការ សង្រ្គោះ គ្រោះមហន្តរាយ ផ្សេង ៗ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ។
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន បន្ត ក្រើន រំលឹក ដល់ កងកម្លាំង ឱ្យ បន្ត ប្រកាន់ខ្ជាប់ នូវ ស្មារតី ក្នុង ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រាល់ គ្រោះអាសន្ន ទាំងអស់ រួមទាំង ការងារ គ្រោះមហន្តរាយ ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី បាន ថ្លែង រំលឹក យ៉ាង ដូច្នេះ « ប្រតិបត្តិការ សង្គ្រោះ គ្រោះមហន្តរាយ វា ក៏ ជា សមរភូមិ មួយ ផងដែរ ។ សមរភូមិ នេះ ក៏ មាន សារសំខាន់ ណាស់ ព្រោះថា យើង ត្រូវ ជួយ ដល់ អាយុជីវិត របស់ ជនរងគ្រោះ ។ គ្មាន អ្វី សំខាន់ ជាង អាយុជីវិត នេះ ទេ ដូច្នេះ ពេល ចូល សមរភូមិ សង្គ្រោះ នេះ យើង ជា អ្នកសង្គ្រោះ ត្រូវតែ តាំងចិត្ត និង ប្តេជ្ញា ជម្នះ រាល់ ការលំបាក ទាំងឡាយ ដោយ ស្វាហាប់ បំផុត ដើម្បី សម្រេច គោលដៅ ចម្បង របស់ យើង គឺ ត្រូវតែ ជួយ យក អាយុជីវិត ជនរងគ្រោះ ឱ្យ បាន » ។
ជាមួយគ្នា នោះ លោក ទេសរដ្ឋមន្រ្តី គន់ គីម ក៏ បាន ជំរុញ ដល់ នាយ ទាហាន ពល ទាហាន នៃ បញ្ជាការដ្ឋាន អង្គរក្ស ទាំងអស់ បន្ត ខិតខំ កិច្ចការងារ របស់ ខ្លួន ឱ្យ បាន ល្អ បន្ថែម ទៀត ជាពិសេស សកម្មភាព ចុះ ជួយ ប្រជាពលរដ្ឋ ដែល កំពុង រងគ្រោះ ដោយសារ បញ្ហា កូវីដ១៩ និង គ្រោះមហន្តរាយ ផ្សេង ៗ ទៀត ។
លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន អំពាវនាវ ដល់ នាយ ទាហាន ពល ទាហាន ទាំងអស់ ត្រូវ បន្ត អនុវត្ត វិធានការ របស់ ក្រសួង សុខាភិបាល និង រាជ រដ្ឋាភិបាល ដោយ ត្រូវ ប្រកាន់ខ្ជាប់ គ្រប់ ពេលវេលា ទាំងអស់ នូវិធាន « ៣ការពារ និង ៣កុំ » ដើម្បី កុំ ឱ្យ ឆ្លង ជំងឺ កូវីដ១៩ ទៅ ខ្លួន ឯង គ្រួសារ និង សហគមន៍ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ចំនួន ៤លាន ដូស បន្ថែម ទៀត ត្រូវបាន ដឹក មកដល់ ប្រទេស កម្ពុជា ។ ក្នុង នោះ ៣លាន ដូស ជា វ៉ាក់សាំងស៊ីណូ វ៉ាក់ និង ១លាន ដូស ជា វ៉ាក់សាំងស៊ីណូ ហ្វាម ។
ក្នុង ឱកាស អញ្ជើញ ទទួល វ៉ាក់សាំង នៅ ព្រលានយន្តហោះ លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល ក៏ បាន ឆ្លៀត បញ្ជាក់ ព័ត៌មាន ពាក់ព័ន្ធ ការមកដល់ វ៉ាក់សាំង និង ផែនការចាក់ វ៉ាក់សាំង នៅក្នុង ប្រទេស កម្ពុជា ផងដែរ ។
លោកស្រី យក់ សម្បត្តិ បាន ឱ្យដឹង ថា មកដល់ ពេលនេះ វ៉ាក់សាំង បាន មកដល់ ប្រទេស កម្ពុជា សរុប ចំនួន ១៦លាន ដូស ហើយ ហើយ នៅ ខែ ក្រោយ វ៉ាក់សាំង ប្រមាណ ៤លាន ដូស ទៀត នឹង មកដល់ ប្រទេស កម្ពុជា ជា ចំនួន គម្រប់ ២០លាន ដូស ដែល រាជ រដ្ឋាភិបាល ស្វះស្វែងរក ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ។
លោកស្រី ក៏ បាន ឱ្យដឹង ផងដែរ ថា សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជា ឱ្យ បញ្ជាទិញ វ៉ាក់សាំង មួយ លាន ដូស បន្ថែម ទៀត សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដែល មិន ទាន់ បាន ចាក់ វ៉ាក់សាំង ។
បើ តាម លោកស្រី យក់ សម្បត្តិ វ៉ាក់សាំង ដែល កម្ពុជា ទទួលបាន នៅ ថ្ងៃ នេះ នឹង បន្ត ចែកចាយ ទៅ តាម បណ្តា ខេត្ត នានា ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ។
ក្នុង កិច្ចសម្ភាសន៍ នោះ លោកស្រី យក់ សម្បត្តិ ក៏ បាន បញ្ជាក់ ផងដែរ ពី ការគិតគូរ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការរៀបចំ ផែនការចាក់ វ៉ាក់សាំង ជូន មនុស្ស អាយុ ក្រោម ១៨ ឆ្នាំ និង ការចាក់ដូស ទី៣។ បើ តាម លោកស្រី យក់ សម្បត្តិ ក្រុមការងារ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កំពុង ពិភាក្សា លំអិត លើ ការងារ នេះ ៕
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការបន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៩៣៣ នាក់ ខណៈ អ្នកជំងឺ ចំនួន ៧៤៣ នាក់ ជាសះស្បើយ ។
សូម ជម្រាប ថា គិត ត្រឹម ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៥៩. ៩៧៨ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ សរុប ចំនួន ៥១. ៦៦០ នាក់ និង ស្លាប់ សរុប ចំនួន ៨៨១ នាក់ ៕ លោក វង សូត ចាត់ តំណាង នាំ អំណោយ ប្រគល់ ជូន ពលរដ្ឋ ១០០ គ្រួសារ នៅ ឃុំ ក្រែក ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង ឃុំ ជា ច ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង បាន ចាត់ តំណាង នាំយក អំណោយ ជា ម៉ាស ទឹក អាល់កុល និង គ្រឿង ឧបភោគ បរិភោគ ចំនួន ១០០ គ្រួសារ ផ្តល់ ជូន សាលា ឃុំ ក្រែក ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ដេីម្បី ចែកជូន បន្ត ដល់ គ្រួសារ ប្រជាពលរដ្ឋ ដែល ជាប់ពាក់ព័ន្ធ ទៅនឹង ព្រឹត្តិការណ៍ ២០ កុម្ភៈ ។
អំណោយ នេះ ត្រូវបាន លោក ជា ចំណាន រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ ក្រែក ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ និង ក្រុមការងារ នាំ ទៅ ប្រគល់ ជូន នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ។
ទន្ទឹមនឹង នេះ ដែរ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ ក្រែក បាន អំពាវនាវ បន្ថែម លេី វិធានការ ទប់ស្កាត់ របស់ អាជ្ញាធរ ដូច ការបិទ ខ្ទប់ តំបន់ ដែល រក ឃេីញ ករណី កូវីដ១៩ អាជ្ញាធរ តែងតែ ស្វែងរក ប្រភព និង កាត់ផ្តាច់ ខ្សែ ចម្លង ដោយ ធ្វេី តេស្ត រហ័ស ករណី សង្ស័យ បុគ្គល ណា ម្នាក់ ជាប់ពាក់ព័ន្ធ និង ដាក់ ខ្លួន ឱ្យ នៅ ដោយឡែក ដោយ ធ្វេី ចត្តាឡី ស័ក ។
ហាក់ ទំនិញ និង ផ្សារ នឹង ត្រូវ បិទ ទ្វារ ចាប់ពី ម៉ោង ៨៖០០ នាទី យប់ ដល់ ម៉ោង ៤៖០០ នាទី ទាប ភ្លឺ នៅក្នុង ទីក្រុង បាងកក ហើយ រដ្ឋាភិបាល ថៃ ក៏ បាន ចេញ បទបញ្ជា ឲ្យ មាន ការបិទ ជា បណ្តោះអាសន្ន ចំពោះ ហាង លក់ ទំនិញ និង ផ្សារ តូច ៗ នៅក្នុង ខេត្ត ចំនួន ០៦ ក្នុង ចំណោម ខេត្ត ទាំង ប៉ុន្មាន ខាងលើ ផងដែរ លើកលែងតែ ផ្សារ ទំនើប ធំ ៗ និង តំបន់ លក់ ថ្នាំ ពេទ្យ ភោជនីយដ្ឋាន កាហ្វេ ធនាគារ ព្រមទាំង ទីតាំង ដែល ត្រូវបាន ចាត់ ជា កន្លែង ចាក់ វ៉ាក់សាំង ដែល នឹង អាច ធ្វើ ប្រតិបត្តិការ បាន ដល់ ម៉ោង ៨៖០០ នាទី យប់ ។
ចាប់ពី ថ្ងៃចន្ទ សប្តាហ៍ ក្រោយ ទាំង វិស័យ ឯកជន និង រដ្ឋ នៅក្នុង ទីក្រុង បាងកក និង ខេត្ត ក្បែរ នឹង តម្រូវឲ្យ អនុវត្ត គោលការណ៍ បំពេញ ការងារ ពី ផ្ទះ ជា អតិបរមា ខណៈ មធ្យោបាយ ធ្វើដំណើរ សាធារណៈ នឹង ត្រូវ ធ្វើ ប្រតិបត្តិការ ក្រោម ការរឹតត្បិត ។ រីឯ ការជួបជុំគ្នា ក្នុង សង្គម នឹង ត្រូវ កំណត់ ឲ្យ អាច មាន មនុស្ស ច្រើន បំផុត ត្រឹម ០៥ នាក់ នៅ តាម តំបន់ ទាំងនេះ ។
រូបភាព ជាច្រើន សន្លឹក ដែល ត្រូវបាន បង្ហោះ តាម បណ្តាញ សង្គម ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ បង្ហាញ អំពី ការសម្រុក ទៅ ធ្វើតេស្ត នៅ តាម ទីកន្លែង សំខាន់ ៗ ដែល រដ្ឋ បាន ដាក់ចេញ ហើយ ខ្លះ ត្រូវ បង្ខំ ចិត្ត សម្រាក នៅ ហ្នឹង កន្លែង ដើម្បី រង់ចាំ ទទួល ការធ្វើតេស្ត រក COVID-19 ជាពិសេស នៅ ទីក្រុង បាងកក ៕ លោក ចូ បៃ ដិន និង លោក ពូទីន ពិភាក្សា គ្នា តាម ទូរស័ព្ទ លើ បញ្ហា ស៊ីរី និង សន្តិសុខ ព័ត៌មានវិទ្យា
( ម៉ូស្គូ) ៖ ប្រធានាធិបតី រុស្ស៊ី លោក វ្ល៉ាឌីមៀ ពូទីន បាន ធ្វើ កិច្ចសន្ទនា តាម ទូរស័ព្ទ ជាមួយ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ដើម្បី ពិភាក្សា ពី បញ្ហា សន្តិសុខ ព័ត៌មានវិទ្យា និង ស្ថានភាព នៅក្នុង ប្រទេស ស៊ីរី ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ ។
ដោយឡែក ពាក់ព័ន្ធ នឹង ស្ថានការណ៍ នៅក្នុង ប្រទេស ស៊ីរី មេដឹកនាំ នៃ ប្រទេស ទាំង២ បាន ជជែកគ្នា ដោយ ផ្ដោត ជា សំខាន់ លើ ស្ថានភាព មនុស្សធម៌ និង កិច្ច ខិតខំប្រឹង ប្រែង រួមគ្នា រវាង អាមេរិក និង រុស្ស៊ី នៅឯ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ៕
ប្រកាស ទទួលស្គាល់ សមាសភាព ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ក្នុង រចនាសម្ព័ន្ធ នៅ ស្រុក តំបែរ ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ លោក ហាក់ សុខ មករា សមាជិក យុវជន គណបក្ស ថ្នាក់ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ខេត្ត ត្បូងឃ្មុំ នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ប្រកាស ទទួលស្គាល់ សមាសភាព ក្រុមការងារ យុវជន គណបក្ស ក្នុង រចនាសម្ព័ន្ធ ស្រុក តំបែរ ខេត្ត ត្បូងឃ្មុំ ។
ពិធី នេះ មាន ការចូលរួម ពីសំណាក់ លោក គុយ ម៉ារិនឌី អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក តំបែរ ទទួលបន្ទុក ការងារ យុវជន នា ស្នាក់ការបក្ស ស្រុក តំបែរ ព្រមទាំង សមាជិក សមាជិក គណបក្ស មូលដ្ឋាន ដោយ អនុវត្ត តាម វិធានការ សុខាភិបាល និង ការអនុវត្ត តាម វិធានការ « ៣កុំ និង ៣ការពារ » បាន យ៉ាង ខ្ជាប់ខ្ជួន ផងដែរ ។
ថ្លែង ក្នុង ពិធី នេះ ដែរ លោក ហាក់ សុខ មករា បាន ផ្តាំផ្ញើ ការសាកសួរ សុខ ពីសំណាក់ លោក ហ៊ុន មាណែត ប្រធាន យុវជន គណបក្ស ថ្នាក់ កណ្តាល និង បាន ផ្សព្វផ្សាយ នូវ ខ្លឹមសារ រួម នៃ ផែនការ សកម្មភាព របស់ ក្រុមការងារ គណបក្ស ខេត្ត ត្បូងឃ្មុំ ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ បន្ទាប់ពី ទទួលបាន ការឯកភាព ពី គណៈកម្មាធិការ គណបក្ស ខេត្ត ត្បូងឃ្មុំ ។
ជាមួយគ្នា នេះ ដែរ លោក គុយ ម៉ារិនឌី ក៏ បាន ឧបត្ថម ដល់ យុវជន ក្នុង រចនាសម្ព័ន្ធ ក្នុង ម្នាក់ ៗ ទទួលបាន ១០.០០០ រៀល និង ក្រមា ១។ ក្រុមការងារ យុវជន ស្រុក តំបែរ ទទួលបាន Laptop ចំនួន២ គ្រឿង និង ម៉ាសុីន ព្រីង ធ័រ ចំនួន ១គ្រឿង ផងដែរ ៕ ខេត្ត បន្ទាយមានជ័យ ចាប់ផ្តើម ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ នៅ ក្រុង សិរី សោភ័ណ
( បន្ទាយមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ សហការ ជាមួយ យោធ ភូមិភាគ ទី៥ នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ដល់ ព្រះសង្ឃ ប្រជាពលរដ្ឋ និង ក ម្មករ កម្ម ការិនី នៅ សង្កាត់ ចំនួន ៤ នៃ ក្រុង សិរី សោភ័ណ ។
នៅក្នុង ឱកាស នោះ ដែរ អ៊ុ រាត្រី បាន ថ្លែង ថា ដើម្បី រួមគ្នា ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ប្រមុខ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ រ កម្ពុជា បាន ផ្ដល់ នូវ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដើម្បី ចាក់ ជូន ដល់ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។
លោក អភិបាល ខេត្ត ក៏ បាន បញ្ជាក់ ផងដែរ ថា អ្នក ដែល បាន ចាក់ វ៉ាក់សាំង លើក ទី១ រួចហើយ ត្រូវតែ អនុវត្ត តាម វិធាន សុខាភិបាល ឱ្យ បាន ត្រឹមត្រូវ ទាំង មុនពេល ចាក់ និង ក្រោយពេល ចាក់ ដូសទី១ រហូតដល់ ថ្ងៃ ចាក់ ដូស ទី២ ត្រូវ អនុវត្ត តាម ការណែនាំ របស់ គ្រូពេទ្យ រហូតដល់ ថ្ងៃ កំណត់ ដែល គ្រូពេទ្យ បាន ណែនាំ នោះ ទើប វ៉ាក់សាំង មាន ប្រសិទ្ធភាព ខ្ពស់ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា បើ ទោះបីជា បងប្អូន បាន ធ្វើ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ហើយ ក្ដី ក៏ បងប្អូន ត្រូវតែ បន្ត អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង អនុវត្ត វិធានការ « ៣ការពារ និង ៣កុំ » ឱ្យ បាន ខ្ជាប់ខ្ជួន ។
បន្ថែម ពី នេះ លោក អ៊ុ រាត្រី បាន បញ្ជាក់ ថា វ៉ាក់សាំង ដែល ចាក់ ជូន ប្រជាពលរដ្ឋ នា ពេលនេះ គឺជា ការផ្តល់ ជូន ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ដែល សម្តេច បាន ខិតខំ គ្រប់ បែបយ៉ាង ដើម្បី រក វ៉ាក់សាំង និង បាន ដាក់ចេញ វិធានការ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ របស់ យើង ឱ្យ បាន គ្រប់ ៗ គ្នា ដូច្នេះហើយ ប្រជាពលរដ្ឋ ត្រូវ គោរព ដឹងគុណ ចំពោះ សម្តេច ។
សូម បញ្ជាក់ ថា ផែនការចាក់ វ៉ាក់ ក្នុង ក្រុង សិរី សោភ័ណ នេះ មាន ប្រជាពលរដ្ឋ ជាង ៥០.០០០ នាក់ លើ ៤សង្កាត់ ក្នុង នោះ បាន កំណត់ យក ក្នុង ១សង្កាត់ មាន ទីតាំង ចាក់ សាំង ចំនួន ២កន្លែង ។
ក្នុង នោះ ទី១៖ សម្រាប់ ពលរដ្ឋ នៅ សង្កាត់ ទឹក ថ្លា ត្រូវ ទទួល ការចាក់ វ៉ាក សាំង នៅ ទីតាំង សាលា បឋមសិក្សា គាប និង ទីតាំង តំបន់ ប្រតិបត្តិ នារ សឹក រង ខេត្ត ( យោធា ខេត្ត ) ។
* ទី២៖ សង្កាត់ អូរ អំបិល នៅ ទីតាំង សាលា បឋមសិក្សា គោ រដ្ឋាន និង ទីតាំង តំបន់ ប្រតិបត្តិ នារ សឹក រង ខេត្ត ( យោធា ខេត្ត ។* ទី៣៖ សង្កាត់ ព្រះពន្លា នៅ ទីតាំង វត្ត សមាធិ ភូមិ៤ និង នៅ វិទ្យាល័យ ពុទ្ធ កៈ សម្តេច ធម្មពោធិសាល ជា ស៊ីម នាវត្ត ស្វាយ ចាស់ ភូមិ ១។ និង ទី៤៖ សង្កាត់ កំពង់ស្វាយ នៅ ទីតាំង សាលា បឋមសិក្សា ហ៊ុន សែន សូភី ភូមិ សូភី និង នៅ សាលា បឋមសិក្សា ប៉ោយ សូភី ភូមិ ២៕
បើ តាម ទីភ្នាក់ងារ ឧតុនិយម និង ភូមិសាស្ត្រ ឥណ្ឌូណេស៊ី គ្រោះ រញ្ជូយ ដី ខាងលើ បាន កើតឡើង នៅ ម៉ោង ប្រមាណ ជា ៧៖ ៤៣ នាទី ព្រឹក ( ម៉ោង ក្នុង តំបន់ ) ។ ប៉ុន្តែ មិន មាន ការប្រកាស អាសន្ន ពីរ លក យក្ស ស៊ូណាមិ ឡើយ ហើយក៏ មិន ទាន់ មាន សេចក្ដីរាយការណ៍ ពី ជនរងគ្រោះ ឬ ក៏ ការបំផ្លិចបំផ្លាញ នៅឡើយ ដែរ ៕
រមណីយដ្ឋាន ប្រាសាទ សំបូរ ព្រៃ គុក មាន ទីតាំង ស្ថិត នៅក្នុង ភូមិ សំបូរ ឃុំ សំបូរ ស្រុក ប្រាសទ សំបូរ ខេត្ត កំពង់ធំ មាន ចម្ងាយ ប្រហែល៣០ គីគូ ម៉ែត្រ ភាគ ខាងជើង ក្រុង ស្ទឹង សែន ។ តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក មាន ទំហំ ធំ ទូលាយ ហើយ ក្នុង តំបន់ នោះ មាន ភូមិ ចំនួន ៧។ រមណីយដ្ឋាន សំបូរ ព្រៃ គុក ចែក ជា តំបន់ ធំ ៗ គឺ៖ តំបន់ អតីត រាជធានី នៅ ផ្នែក ខាងលិច និង តំបន់ ប្រាសាទ នៅ ផ្នែក ខាងកើត ខណ្ឌ គ្នា ដោយ អូរ មួយ ឈ្មោះ គ្រូកែ ។
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ២៦ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ២៦ នាក់ នោះ មាន ១៤នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៣ករណី និង ជនសង្ស័យ ១២នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៦ ករណី ។
យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត សៀមរាប អ្នកជំងឺ ថ្មី ទាំងនោះ រួម មាន ករណី ទី១ ដល់ ទី៩ ជា ករណី មាន ប្រភព ចម្លង ចេញ ពី ផ្សារ កំពង់ក្តី ករណី ទី១០ ដល់ ទី ៥១ ជា ករណី មាន ប្រភព ចម្លង ចេញ ពី ផ្សារ លើ ធំ ថ្មី និង ករណី ទី៥២ ដល់ ទី ៥៨ ជា ករណី ឆ្លង មាន ប្រភព ចម្លង ចេញពី សង្កាត់ ស្រង៉ែ ។
ករណី ទី៧៨ ដល់ ទី៨១ គឺជា ករណី ពុំ ទាន់ អាច សន្និដ្ឋាន ពី ប្រភព ចម្លង ច្បាស់លាស់ នៅឡើយ ។ ករណី ទី៨២ ដល់ ទី៩១ គឺជា ប្រជាពលរដ្ឋ ត្រឡប់ ពី ប្រទេស ថៃ មកដល់ ខេត្ត សៀមរាប ហើយ ជា ករណី សង្ស័យ ត្រូវបាន ក្រុម គ្រូពេទ្យ ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក នៅ វិទ្យាល័យ សម្តេច ឪ ។
ចំណែក អ្នក ជាសះស្បើយ ទាំង ៣១ នាក់ ត្រូវបាន ក្រុម គ្រូពេទ្យ បាន អនុញ្ញាតឱ្យ ចេញ ពី មន្ទីរពេទ្យ បង្អែក ខេត្ត និង មន្ទីរពេទ្យ បង្អែក ស្រុក សូទ្រនិគម ត្រឡប់ ទៅ លំនៅឋាន វិញ ដោយ ត្រូវ បន្ត ការធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ។
ករណី ស្លាប់ អ្នកជំងឺ មាន ឈ្មោះ ឈុត ទុំ ភេទ ប្រុស អាយុ ៦៣ ឆ្នាំ អាសយដ្ឋាន ភូមិ ស្ទឹង ថ្មី សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ខេត្ត សៀមរាប ដែល បាន រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ - ១៩ នៅ ថ្ងៃទី ៧ ខែកក្កដា និង បាន ស្លាប់ នៅ ថ្ងៃទី ៩ ខែកក្កដា វេលា ម៉ោង ១៧៖ ០៥នាទី ដោយសារ ជំងឺ រលាក សួត បង្ក ដោយ មេរោគ កូវីដ - ១៩ ។
សូម បញ្ជាក់ ថា មកទល់ ពេលនេះ ខេត្ត សៀមរាប មាន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ២១៣៨ នាក់ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ៧៣៨ នាក់ ស្លាប់ ២២ នាក់ និង ១៣៧៨ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប មណ្ឌល ចត្តាឡី ស័ក គរុកោសល្យ និង វិក្រឹត ការ ខេត្ត វិទ្យាល័យ អង្គរ និង វិទ្យាល័យ ដំដែក ៕ ព្រឹក ថ្ងៃ នេះ វ៉ាក់សាំង ៤លាន ដូស ទៀត នឹង ដឹក ពី ប្រទេស ចិន មកដល់ ប្រទេស កម្ពុជា
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ចំនួន ៤លាន ដូស ថែម ទៀត នឹង ដឹក ពី ប្រទេស ចិន មកដល់ ប្រទេស កម្ពុជា បន្ត ទៀត ។
វ៉ាក់សាំង គឺ ឧបករណ៍ យុទ្ធសាស្ត្រ មួយ សម្រាប់ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ក៏ ដូចជា ការពារ សុខភាព របស់ ប្រជាពលរដ្ឋ ពី ជំងឺ កូវីដ១៩ ។ តាមរយៈ វ៉ាក់សាំង ដែល កម្ពុជា ទទួលបាន ជា បន្តបន្ទាប់ ជួយ ឱ្យ កម្ពុជា សម្រេច ផែនការលើ ការងារ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ផងដែរ ។
សម្តេច តេជោ បាន លើកឡើង ថា បើ គ្មាន ការជួយគាំទ្រ របស់ ចិន ទេ នោះ កម្ពុជា ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ មិន បាន ២០ម៉ឺន នាក់ នោះ ឡើយ ។ កាលពី ថ្ងៃទី ០១ ខែកក្កដា សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស យកចិត្ត ធ្វើជា បង្អែក យុទ្ធសាស្ត្រ ក្នុង ការផ្គត់ផ្គង់ វ៉ាក់សាំង មក កម្ពុជា ផងដែរ ៕ បើកបរ សូម ពាក់ មួក សុវត្ថិភាព ជានិច្ច ! ស្លាប់ ៥នាក់ និង របួស ៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៩ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន មិន គោរព សិទ្ធិ ប្រជែង និង មិន ប្រកាន់ ស្តាំ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ លោក ចូ បៃ ដិន ប្រកាស៖ « បេសកកម្ម យោធា អាមេរិក នៅ អាហ្វហ្គានីស្ថាន នឹង បញ្ចប់ នៅ ថ្ងៃទី ៣១ ខែសីហា . ប្រជាជន អាហ្វហ្គានីស្ថាន មាន សិទ្ធិ និង ទំនួល ខុសត្រូវ ដើម្បី កំណត់ ជោគវាសនា ខ្លួន ឯង »
២៖ ថៃ ចេញ វិធានការរឹតត្បិត ថែម ទៀត សម្រាប់ ទីក្រុង បាងកក និង បណ្តា ខេត្ត ដែល មាន ការឆ្លង កូវីដ - ១៩ ខ្លាំង
៣៖ អូស្រ្តាលី ប្រកាស ពី ការបង្កើន ចំនួន វ៉ាក់សាំង ក្នុង ស្តុក ដើម្បី ទប់ទល់ ការឆ្លង រាលដាល កូវីដ - ១៩
៤៖ ក្រុម តាលី បង់ ទើប វាយ កាន់កាប់ តំបន់ ព្រំដែន ដ៏ សំខាន់ មួយ រវាង អាហ្វហ្គានីស្ថាន និង អ៉ីរ៉ង់
កន្លងមក នេះ ប្រទេស កូរ៉េ ខាងជើង ធ្លាប់ រំពឹង ទទួលបាន វ៉ាក់សាំង ប្រមាណ ២លាន ដូស ពី កម្មវិធី ចែកចាយ វ៉ាក់សាំង អន្តរជាតិ COVAX ប៉ុន្តែ វ៉ាក់សាំង ទាំងនោះ មិន ទាន់ ត្រូវបាន ដឹក ទៅកាន់ កូរ៉េ ខាងជើង នៅឡើយ ទេ ។
យ៉ាងណា ក៏ដោយ កូរ៉េ ខាងជើង ហាក់ដូចជា មិន ទាន់ ត្រៀមខ្លួន រួចរាល់ ដើម្បី ទទួលយក វ៉ាក់សាំង ណាមួយ នៅឡើយ ទេ ព្រោះតែ កម្មវិធី ចាក់ វ៉ាក់សាំង ក៏ មិន ទាន់ ត្រូវបាន បាន រៀបចំ ហើយ ចំនួន ប្រជាជន ដែល នឹង ត្រូវ ទទួល ការចាក់ ក៏ មិន មាន ការប្រកាស នៅឡើយ ដែរ ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ផងដែរ ថា សម្រាប់ អ្នក ជាសះស្បើយ មាន ចំនួន ១៤នាក់ និង ស្លាប់ ចំនួន ០៣ នាក់ ផងដែរ ។
ខេត្ត មណ្ឌលគិរី រកឃើញ អ្នកជំងឺ កូវីដ ចំនួន ១៤នាក់ តាមរយៈ ការធ្វើតេស្ដរហ័ស
រដ្ឋបាល ខេត្ត មណ្ឌលគិរី ក៏ បាន អំពាវនាវ ដល់ អ្នក ប៉ះពាល់ ផ្ទាល់ សូម រួសរាន់ ទៅ ជួប ក្រុម គ្រូពេទ្យ និង ធ្វើចត្តាឡី ស័ក ដើម្បី យក សំណាក ទៅ ពិនិត្យ និង អ្នក ប៉ះពាល់ ប្រយោល សូម ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ រៀង ៗ ខ្លួន ដោយ មិន ត្រូវ ពាក់ព័ន្ធ និង ប៉ះពាល់ ជាមួយ អ្នកដទៃ ដាច់ខាត ៕
អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង បិទ ជា បណ្តោះអាសន្ន រោងចក្រ មួយ កន្លែង នៅ ស្រុក កំពង់ត្រឡាច ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩
( កំពង់ឆ្នាំង ) ៖ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង បាន ចេញ សេចក្តីសម្រេច បិទ ជា បណ្តោះអាសន្ន រោងចក្រ ត្រី ប៉ូស អ៉ីនធើណេសិន ណល ( ខេមបូឌា ) ខូអិលធីឌី ស្ថិត ក្នុង ភូមិសាស្ត្រ ភូមិ ច្រក រមៀត ឃុំ ឈូក ស ស្រុក កំពង់ត្រឡាច ខេត្ត កំពង់ឆ្នាំង ចាប់ពី ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃ ជូនដំណឹង សារជាថ្មី ។
