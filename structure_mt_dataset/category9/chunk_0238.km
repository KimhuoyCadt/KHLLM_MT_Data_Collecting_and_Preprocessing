៦៖ កូរ៉េ ខាងត្បូង រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ច្រើន បំផុត « ១. ៦១៥ នាក់ ក្នុង ១ ថ្ងៃ ». ការរឹតបន្តឹង វិធានការ សុវត្ថិភាព ត្រូវ អនុវត្ត ទូទាំង ប្រទេស
៧៖ អ្នក ចាក់ វ៉ាក់សាំង ទី ៥លាន ត្រេកអរ ក្រោយ ទទួលបាន រង្វាន់ លើកទឹកចិត្ត ពី សម្តេច តេជោ ហ៊ុន សែន
៩៖ កម្ពុជា ផ្អាក ជា បណ្ដោះអាសន្ន ការធ្វើដំណើរ ចេញ - ចូល ឆ្លងកាត់ ព្រំដែន កម្ពុជា - វៀតណាម រយៈពេល ១ ខែ អនុវត្ត ចាប់ពី ថ្ងៃទី ១៨ ខែកក្កដា ត ទៅ
១០៖ អូស្ត្រាលី បន្ត បិទ ខ្ទប់ ទីក្រុង ស៊ីដនី « ពីរ សប្តាហ៍ ទៀត » ដើម្បី ទប់ទល់ ការរាតត្បាត កូវីដ - ១៩
១១៖ ប្រមុខ ការទូត កម្ពុជា៖ បើ មិន ប្រកាន់ ពហុ ភាគី និយម ពិភពលោក នឹង មិន អាច យកឈ្នះ លើ ជំងឺ រាតត្បាត បាន ទេ
១២៖ ក្រសួង បរិស្ថាន អំពាវនាវ ពលរដ្ឋ ទុកដាក់ សំណល់ ថ្ម ពិល ឱ្យ បាន ត្រឹមត្រូវ និង ដាក់ ក្នុង ធុង តាម ទី សាធារណៈ ផ្សារ ទំនើប និង តាម ស្ថានីយ ប្រេង ឥន្ទនៈ នានា នៅ ភ្នំពេញ
១៣៖ អាមេរិក ទទូច ឲ្យ អាស៊ាន ដោះស្រាយ វិបត្តិ នៅ មីយ៉ាន់ម៉ា កំលុង ជំនួប ពិភាក្សា លើក ដំបូង រវាង ប្រមុខ ការទូត របស់ ភាគី ទាំង ពីរ
១៤៖ បទ វិភាគ៖ តារាង ចំណាត់ថ្នាក់ ដ៏ ចម្លែក ស្តីពី ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ របស់ ទីភ្នាក់ងារ សារព័ត៌មាន Bloomberg មិន គិត ពិចារណា ពី ការពិត ជាក់ស្តែង ដែល ធ្វើឱ្យ មនុស្ស មិន យល់
សមាគម ធុរកិច្ច កម្ពុជា - ថៃ ប្ដេជ្ញា រួមគ្នា លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ វិស័យ ឯកជន នៃ ប្រទេស ទាំង ពីរ
ថ្លែង នៅក្នុង ពិធី នោះ លោក សម្បត្តិ សុធា បាន ជម្រាប ភ្ញៀវ កិត្តិយស ពី បេសកកម្ម របស់ CBC ក្នុង ការបង្កើត វេទិកា មួយ ដើម្បី កសាង ទំនាក់ទំនង រឹងមាំ ជាមួយ សមាគម ធុរកិច្ច ផ្សេង ៗ និង ជួយ គាំទ្រ សមាជិក សមាជិកា នៃ សហគមន៍ ធុរកិច្ច ទាំង នៅក្នុង ប្រទេស កម្ពុជា និង ប្រទេស ថៃ ព្រមទាំង លើកស្ទួយ អត្ថប្រយោជន៍ របស់ ពួកគេ ទៅកាន់ អ្នកតាក់តែង គោល នយោបាយ ។
យ៉ាងណា ក៏ដោយ រដ្ឋបាល លោក ចូ បៃ ដិន បាន សន្យា ថា នឹង បន្ត គាំទ្រ រដ្ឋាភិបាល ទីក្រុង កាប៊ុល ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជាមួយ ក្រុម តាលី បង់ ។ ក៏ប៉ុន្តែ ការសន្យា នេះ មិន អាច ធ្វើ ទៅ រួច ឡើយ បើសិនជា អាមេរិក គ្មាន មូលដ្ឋាន ទ័ព ណាមួយ ផ្សេង ក្នុង ប្រទេស ក្បែរខាង របស់ អាហ្វហ្គានីស្ថាន ខណៈ តំបន់ អាស៊ី កណ្ដាល ត្រូវបាន ក្រុម អ្នកជំនាញ ខ្លះ យល់ ថា នឹង ក្លាយជា ជម្រើស ល្អ របស់ យោធា អាមេរិក ។
