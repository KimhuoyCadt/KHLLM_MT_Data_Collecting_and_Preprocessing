( មណ្ឌលគិរី ) ៖ មន្រ្តី នគរបាល ប៉ុស្តិ៍ ស្ពាន មានជ័យ ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគិរី ម្នាក់ បាន រងរបួស ធ្ងន់ ដោយសារ គ្រាប់ កាំភ្លើង កាលពី យប់ ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២១ ។ ក្រុម ជនបង្ក បាន រត់គេចខ្លួន ហើយ កម្លាំង សមត្ថកិច្ច កំពុង តាម ចាប់ ។
សេចក្តីរាយការណ៍ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ល្ងាច ថ្ងៃទី ៥ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ឲ្យដឹង ថា កាលពី យប់ ម្សិលមិញ មាន ករណី ប្តី ប្រពន្ធ ២នាក់ ឈ្លោះប្រកែកគ្នា ពេល នោះ ពួកគេ បាន ប្តឹង មក នគរបាល ប៉ុស្តិ៍ ។ ក្រោយ ទទួលបាន ព័ត៌មាន នេះ កើតឡើង នាយ នគរបាល ប៉ុស្តិ៍ ស្ពាន មាន ជ័យ ដែល កំពុង ផឹក ស៊ី ជាមួយ ជន បង្ក ២នាក់ ទៀត មាន ម្នាក់ ឈ្មោះ ក្របី និង ម្នាក់ ទៀត ក៏ បាន ទៅ ជួយ អន្តរាគមន៍ ទាំងអស់ គ្នា ។
សេចក្តីរាយការណ៍ បាន បន្ត ថា នៅពេល ទៅដល់ ផ្ទះ ប្តី ប្រពន្ធ ទាំង ២នាក់ ស្រាប់តែ ជនសង្ស័យ ឈ្មោះ ក្របី បាន ទាញ កំាភ្លើង ពី កូនប្រសារ របស់ អធិការ នគរបាល ស្រុក កោះ ញែក ទៅ ភ្ជង់ បុរស ជា ប្តី ប៉ុន្តែ បែរជា រាល កៃ ទៅ ត្រូវ ចំមន្រ្តី នគរបាល ប៉ុស្តិ៍ ម្នាក់ ដែល ចូលរួម ដោះស្រាយ ដែរ នោះ បណ្តាលឲ្យ រងរបួស ធ្ងន់ ។
ស្នងការ នគរបាល ខេត្ត មណ្ឌលគិរី លោក ឧត្តមសេនីយ៍ ទោ ឡោ សុខា បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ល្ងាច ថ្ងៃ នេះ ថា កម្លាំង នគរបាល របស់ លោក កំពុង តាម ចាប់ ជន បង្ក ឈ្មោះ ក្របី ដែល បាន រត់គេចខ្លួន ។ សម្រាប់ ជនរងគ្រោះ ដែល ជា មន្រ្តី នគរបាល នោះ ត្រូវបាន លោក ឧត្តមសេនីយ៍ ស្នងការ បញ្ជូន មក សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ក្នុង រាជធានី ភ្នំពេញ ។
យ៉ាងណា ក៏ដោយ លោក ស្នងការ ខេត្ត មណ្ឌលគីរី បាន បញ្ជាក់ ថា ជនរងគ្រោះ ដែល ជា មន្រ្តី នគរបាល ប៉ុស្តិ៍ នោះ មិន ទាន់ បាន ទទួល សំណង និង ទារ សំណង នោះ ឡើយ ។ ជាមួយគ្នា នេះ លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន បដិសេធ ថា ជន បង្ក មាន តែ ឈ្មោះ ក្របី ម្នាក់ ប៉ុណ្ណោះ ហើយក៏ គ្មាន កូនប្រសារ អធិការ នគរបាល ស្រុក កោះ ញែក នោះ ឡើយ ។
នៅ ពេល នេះ ជន បង្ក ទាំងអស់ បាន និង កំពុង រត់គេចខ្លួន ខណៈ ជនរងគ្រោះ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ៕
គណៈកម្មការ ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ខេត្ត ត្បូងឃ្មុំ បើក កិច្ចប្រជុំ រួមគ្នា លើ ការងារ អនុវត្តន៍ ច្បាប់ ការអប់រំ បណ្តុះបណ្តាល គ្រប់គ្រង និង ចាត់ចែង សាកសព អ្នកជំងឺ កូវីដ
( ត្បូងឃ្មុំ )៖ គណៈកម្មការ ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ខេត្ត ត្បូងឃ្មុំ នៅ ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បើក កិច្ចប្រជុំ រួមគ្នា មួយ ជាមួយ អនុគណៈកម្មការ ចំរុះ រួម មាន អនុគណៈកម្មការ អនុវត្ត ច្បាប់ . អនុគណៈកម្មការ អប់រំ បណ្ដុះបណ្ដាល និង ទាក់ទង សាធារណៈ និង អនុគណៈកម្មការគ្រប់គ្រង និង ចាត់ចែង សាកសព អ្នកជំងឺ កូវីដ១៩ ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក កេង ប៊ុន ណា អភិបាល រង ខេត្ត ត្បូងឃ្មុំ និង ជា ប្រធាន អនុគណៈកម្មការ និង មាន ការចូលរួម ពី ប្រធាន / អនុប្រធាន មន្ទីរ / អង្គភាព ជុំវិញ ខេត្ត អភិបាល ស្រុក ក្រុង ទាំង៧ ដែល ជា សមាជិក ក្រុមការងារ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ប្រមាណ ជាង ២០ រូប ។
នា ឱកាស នោះ លោក កេង ប៊ុន ណា បាន លើកឡើង ថា កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្នុង គោលបំនង ដើម្បី ដាក់ចេញ នូវ វិធានការ ចាំបាច់ នានា លើ ការពង្រឹង ប្រសិទ្ធភាព នៃ ការអនុវត្ត វិធានការ ការពារ ការបង្ការ ទប់ស្កាត់ និង គ្រប់គ្រង ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ តាមដាន និង ត្រួតពិនិត្យ ការអនុវត្ត វិធានការ នានា ទាំង វិធានការ សុខាភិបាល ទាំង វិធានការ រដ្ឋបាល និង វិធានការ ច្បាប់ ដែល ត្រូវ ដាក់ ចេញ ដើម្បី បង្ការ ទប់ស្កាត់ និង គ្រប់គ្រង ការឆ្លង រាលដាល នៃ កូវីដ១៩ ក្នុង ខេត្ត ត្បូងឃ្មុំ ។
លោក បាន ថ្លែងអំណរគុណ ដ៏ ជ្រាលជ្រៅ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ចំពោះ ជោគជ័យ នៃ យុទ្ធសាស្ត្រ វ៉ាក់សាំង និង យុទ្ធនាការ ប្រយុទ្ធ ទប់ស្កាត់ កូវីដ១៩ របស់ សម្តេច ដោយ ជឿជាក់ យ៉ាង មុតមាំ លើ ចលនា ជាតិ ក្រោម មគ្គុទេ្ទស ក៏ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន ថា យើង ពិតជា ប្រយុទ្ធ ឈ្នះ កូវីដ១៩ ដើម្បី អនាគត ភ្លឺស្វាង របស់ ប្រទេសជាតិ និង ប្រជាជន យើង ជាក់ ជា មិន ខាន ។
ការថ្លែង បែប នេះ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ត្រូវបាន ធ្វើឡើង ក្នុង ឱកាស ញ្ជើញ ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ដែល ជា ជំនួយ របស់ ចក្រភព អង់គ្លេស ចំនួន ៤១៥.០០០ ដូស នៅឯ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ នា រសៀល ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០២១ ។
នា ឱកាស នោះ សម្ដេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ដោយ ឈរ លើ ស្មារតី ប្រុងប្រយ័ត្ន ខ្ពស់ និង ការយកចិត្តទុកដាក់ ជា ចម្បង ចំពោះ សុខភាព សាធារណៈ និង ការជួយសង្គ្រោះ អាយុជីវិត របស់ ប្រជាពលរដ្ឋ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា បណ្ដា ប្រទេស ជាច្រើន បាន និង កំពុង ផ្តោត ការយកចិត្តទុកដាក់ ជា សំខាន់ លើ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ដែល ជា ដំណោះស្រាយ ដ៏ សមស្រប បំផុត ក្នុង ការប្រយុទ្ធ និង ការគ្រប់គ្រង ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ជាមួយនឹង ភាពច្បាស់លាស់ និង ប្រាកដ និយម នៃ ការមកដល់ នូវ ចំនួន វ៉ាក់សាំង តាម គ្រប់ យន្តការ ដែល មាន កាលពី ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០២១ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច មួយ ជំហាន បន្ថែម ទៀត គឺ ការចាប់ផ្ដើម បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន កុមារ និង យុវវ័យ អាយុ ចាប់ពី ១២ - ១៧ ឆ្នាំ ដែល មាន ចំនួន សរុប ប្រមាណ ២ លាន នាក់ បន្ថែម ទៀត » ។
ស្រប ពេល ជាមួយគ្នា នេះ ដែរ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន សម្រេច ដាក់ចេញ នូវ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ដូស ទី៣ ឬ ដូស ជំរុញ ជូន ដល់ មន្ត្រី បម្រើ សេវា សាធារណៈ ជួរ មុខ ដែល កំពុង បម្រើការ នៅ តាម បណ្តា ខេត្ត នានា ដែល ស្ថិត នៅ តាម ព្រំដែន ជាមួយនឹង ប្រទេស ថៃ ដែល មេរោគ បំប្លែង ថ្មី ប្រភេទ ដែល តា កំពុង វាយលុក និង រាលដាល ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ កម្ពុជា គ្រប់ រូប សូម ចូលរួម សហការ យ៉ាង សកម្ម និង ពេញលេញ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ដោយ អនុវត្ត និង ប្រកាន់ខ្ជាប់ នូវ វិធានការ សុខាភិបាល ជាពិសេស វិធានការ « ៣ - ការពារ និង ៣ - កុំ » និង ចូលរួម នៅក្នុង យុទ្ធនាការ ជាតិ ចាក់ វ៉ាក់សាំង ដើម្បី ការពារ សុវត្ថិភាព សុខភាព ក៏ ដូចជា សុខុមាលភាព របស់ គ្រួសារ សហគមន៍ និង សង្គមជាតិ ទាំងមូល ។
សម្ដេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ជាថ្មី ទៀត ជាពិសេស ដល់ មាតាបិតា និង អាណាព្យាបាល ក្នុង ការអនុញ្ញាត និង នាំ កូន ចៅ និង កូនក្មួយ ដែល មាន អាយុ ចាប់ពី ១២ ឆ្នាំ ដល់ ក្រោម ១៨ ឆ្នាំ មក ចាក់ វ៉ាក់សាំង ឱ្យ បាន គ្រប់ ៗ គ្នា និង មិន ត្រូវ ឱ្យ មាន ប្រជាជន កម្ពុជា ណា ម្នាក់ មិន បាន ចាក់ វ៉ាក់សាំង នៅពេល ដល់ វេន របស់ ខ្លួន នោះ ឡើយ ៕
មន្ទីរ សុខាភិបាល ខេត្ត កោះកុង ចុះ បាញ់ ថ្នាំ សម្លាប់ មេរោគ ក្នុង ផ្សារ ដង ទង់ ដើម្បី ត្រៀម ឱ្យ អាជីវករ ចូល លក់ដូរ ក្នុង ពេល ឆាប់ ៗ នេះ
( កោះកុង) ៖ ដោយ អនុវត្តន៍ ទៅ តាម ការណែនាំ របស់ លោកស្រី មិថុនា ភូថង អភិបាល ខេត្ត កោះកុង នៅ ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០២១ នេះ លោក ឈឹម ចិន អភិបាល រង ក្រុង ខេមរភូមិន្ទ លោក វេជ្ជបណ្ឌិត ទៅ ម៉ឹង ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កោះកុង . លោក លឹម ឌី ចៅសង្កាត់ ដង ទង់ និង ប្រធាន គ្រប់គ្រង ផ្សារ ដង ទង់ បាន បើក ប្រតិបត្តិការ បាញ់ ថ្នាំ សម្រាប់ មេរោគ ក្នុង ផ្សារ និង ជុំវិញ បរិវេន ផ្សារ ដង ទង់ ដើម្បី ត្រៀម បើក ឱ្យ អាជីវករ ចូល ប្រកប អាជីវកម្ម លក់ដូរ ឡើងវិញ នៅពេល ឆាប់ ៗ ខាងមុខ នេះ ក្រោយពី មាន អាត្រា កូវីដ១៩ ថយចុះ ។
លោក អភិបាល រង ក្រុង បាន បន្ថែម ថា នេះ បញ្ជាក់ ឱ្យ ឃើញ យ៉ាង ច្បាស់ជា ការយកចិត្តទុកដាក់ យ៉ាង ខ្លាំង របស់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ទៅ លើ ជីវភាព រស់ នៅ និង សេដ្ឋកិច្ច គ្រួសារ របស់ ប្រជាពលរដ្ឋ ។ ប៉ុន្តែ អ្វី ដែល សំខាន់ បំផុត សុខភាព របស់ ប្រជាពលរដ្ឋ ដែល មាន ហានិភ័យ ខ្ពស់ គឺ ជំងឺ កូវីដ១៩ ដូច្នេះ សូម បងប្អូន គ្រប់ មជ្ឈដ្ឋាន ទូទៅ ត្រូវតែ មាន ការប្រុងប្រយ័ត្ន និង មាន វិធានការចូលរួម ទប់ស្កាត់ ឱ្យ បាន គ្រប់ ៗ គ្នា នូវ វិធានការ « រ៣ការពារ និង ៣កុំ » នេះ ជា ជម្រើស ដ៏ ល្អ បំផុត ។
លោក វេជ្ជបណ្ឌិត ទៅ មឹុង បាន ឱ្យដឹង ថា ដោយ គោរព តាម គោលការណ៍ របស់ រាជ រដ្ឋ ភិបាល និង ក្រោម ការចង្អុលបង្ហាញ ពី លោកស្រី មិថុនា ភូថង អភិបាល ខេត្ត កោះកុង លោក បាន បញ្ជូន ក្រុមការងារ មន្ទីរ សុខាភិបាល ទៅ បាញ់ ថ្នាំ កម្ចាត់ មេរោគ នៅ បរិវេន ផ្សារ ដង ទង់ ដើម្បី ត្រៀមលក្ខណៈ ឱ្យ អាជីវករ ប្រកប អាជីវកម្ម លក់ដូរ ឡើងវិញ នៅពេល ឆាប់ ៗ នេះ បើសិន អាត្រា កូវីដ១៩ មាន ការថយចុះ ។
លោក បាន បន្ថែម ថា ក្រោយ មាន ការ បាញ់ ថ្នាំ សម្លាប់ មេរោគ រួចរាល់ហើយ អាជ្ញាធរ តម្រូវ ឱ្យ អាជីវក ចូល ប្រកប អាជីវកម្ម លក់ដូ ឡើងវិញ ក៏ដោយ ក៏ មន្ទ្រី សុខាភិបាល ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ជានិច្ច គឺ ឱ្យ អាជីវករ ធ្វើតេស្ត យក សំណាក ម្តង ទៀត មុន ឱ្យ គាត់ ចូល លក់ដូរ នៅ តាម តូប នីមួយ ៗ នេះ ជា វិធានការ ដើម្បី ទប់ស្កាត់ ការពារ កូវិដ១៩ កុំ ឱ្យ មាន ការរីករាលដាល ឆ្លង ចូលក្នុង សហគមន៍ និង ក្រុមគ្រួសារ និង ដើម្បី សុខភាព យើង ទាំងអស់ គ្នា ។
លោក បាន បញ្ជាក់ ថា ដើម្បី សុវត្ថិភាព សុខភាព ប្រជាពលរដ្ឋ នៅ តាម ច្រក ផ្លូវ ចូល ផ្សារ អាជ្ញាធរ អាជ្ញាធរ ត្រៀម ដាក់ ម៉ាស៊ីន តាមដាន កំដៅ អាកុល លាង ដៃ និង ពាក់ ម៉ាស ជាប់ ជានិច្ច មុន ឱ្យ ប្រជាពលរដ្ឋ ចូលក្នុង ផ្សារ ដើម្បី ទិញ ឥវ៉ាន ៕ សម្ព័ន្ធមិត្ត សំខាន់ ៗ របស់ អាមេរិក នៅ អឺរ៉ុប មិន ចង់ ចូលរួម ប្រឆាំង ចិន ខ្លាំង ពេក ឡើយ . នេះ បើ តាម ការផ្សាយ របស់ NBC News
( ឡុងដ៍ ) ៖ សារព័ត៌មាន អាមេរិក NBC News បាន បញ្ជាក់ នៅក្នុង របាយការណ៍ មួយ ដែល ត្រូវបាន ចេញផ្សាយ កាលពី ពេល ថ្មី ៗ នេះ ថា សហរដ្ឋ អាមេរិក បាន ទាមទារ ឱ្យ មាន ការឆ្លើយតប ជា ឯកច្ឆន្ទ ពីសំណាក់ សម្ព័ន្ធមិត្ត អឺរ៉ុប សំខាន់ ៗ របស់ ខ្លួន ដើម្បី យក ជំហរ រួម ប្រឆាំង នឹង ប្រទេស ចិន ប៉ុន្តែ បណ្តា ប្រទេស អឺរ៉ុប មួយចំនួន បាន ព្យាយាម « ដើរ លើ ផ្លូវ ដែល ប្រសើរ ជាង នេះ » ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ចិន ស៉ីន ហួរ នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី០៥ ខែសីហា ឆ្នាំ ២០២១ ។
អឺរ៉ុប ត្រូវបាន គេ មើលឃើញ ថា កំពុង ពឹងផ្អែក លើ ប្រទេស ចិន កាន់តែ ខ្លាំង សម្រាប់ វិស័យ ផ្នែក ពាណិជ្ជកម្ម ហើយ ក្នុង ពេល ជាមួយគ្នា នេះ វា ក៏ កំពុង ធ្វើឱ្យ សហរដ្ឋ អាមេរិក កាន់តែ មាន ភាព មិន ទុកចិត្ត ផងដែរ ៕
ខេត្ត បន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ១៣៨ នាក់ និង ជាសះស្បើយ ២៦២ នាក់
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ដូចនេះ នា រសៀល ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស ដែល សម្តេច អញ្ជើញ ទទួល វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដែល ជា ជំនួយ របស់ ចក្រភព អង់គ្លេស ចំនួន ៤១៥.០០០ ដូស នៅឯ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ឱ្យដឹង ដែរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន សម្រេច ដាក់ចេញ នូវ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ដូស ទី ៣ ឬ ដូស ជំរុញ ជូន ដល់ មន្ត្រី បម្រើ សេវា សាធារណៈ ជួរ មុខ ដែល កំពុង បម្រើការ នៅ តាម បណ្តា ខេត្ត នានា ដែល ស្ថិត នៅ តាម ព្រំដែន ជាមួយនឹង ប្រទេស ថៃ ដែល មេរោគ បំប្លែង ថ្មី ប្រភេទ ដែល តា កំពុង វាយលុក និង រាលដាល ផងដែរ ។
គូសបញ្ជាក់ ថា វ៉ាក់សាំង ដែល ចក្រភព អង់គ្លេស ផ្តល់ មក កម្ពុជា នេះ គឺជា ជំនួយ ទ្វេ ភាគី ជា ការផ្តល់ ដោយ ផ្ទាល់ មក កម្ពុជា តែម្តង មិន បាន ឆ្លងកាត់ តាម មជ្ឈមណ្ឌល កូវ៉ាក់ នោះ ឡើយ ។ ចក្រភព អង់គ្លេស ជា ប្រទេស ទី៣ហើយ ដែល បាន ផ្តល់ ជំនួយ វ៉ាក់សាំង មកកាន់ កម្ពុជា ជា លក្ខខណៈ ទ្វេ ភាគី បន្ទាប់ពី ប្រទេស ចិន និង ជប៉ុន ។
មកដល់ ពេលនេះ កម្ពុជា ទទួលបាន ជំនួយ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ពី ប្រទេស ជា មិត្ត រួម មាន៖ ចិន ចំនួន ៣.២លាន ដូស . ជប៉ុន ១លាន ដូស និង អង់គ្លេស ៤១៥.០០០ ដូស ។ កម្ពុជា ក៏ ទទួលបាន វ៉ាក់សាំង ពី មជ្ឈមណ្ឌល កូវ៉ាក់ ចំនួន ១. ៣៨៤. ១០០ ដូស ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៥៤៦ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០២១
បើ តាម អ្នកនាំពាក្យ . គិត ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ០៥ ខែសីហា ក្នុង ឆ្នាំ ២០២១ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១៣០ .០២៥ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៩៦.៦៣១ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៣៣. ៧១៣ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ល្មើស សញ្ញា ទូរស័ព្ទ និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ស្លាកលេខ លើស ចំណុះ ទូរស័ព្ទ អត់ ខ្សែក្រវ៉ាត់ ឆៀក អាជីវកម្ម ជាដើម ។
ទូត អង់គ្លេស៖ ការប្រយុទ្ធ ប្រឆាំង នឹង កូវីដ១៩ ត្រូវការពេល យូរ តែ អង់គ្លេស រីករាយ អាច រួម ដៃ ជាមួយ កម្ពុជា ដោះស្រាយ បញ្ហា នេះ
លោក ម៉ាក ហ៊ែរ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ត្រូវការ ពេលវេលា យូរ ហើយ នឹង មាន បញ្ហា ប្រឈម ថ្មី ៗ ។ ទោះជា យ៉ាង នេះ ក្តី វ៉ាក់សាំង ទាំងនេះ រួម ជាមួយ វ៉ាក់សាំង ដទៃ ទៀត គឺជា ជំហាន ដ៏ សំខាន់ ក្នុង ការបើក ឡើងវិញ នូវ អាជីវកម្ម សាលារៀន រួមទាំង ការស្តារ ជីវភាព រស់ នៅ ឡើងវិញ » ។
លោក បាន បន្ត ថា រាជ រដ្ឋាភិបាល អង់គ្លេស មាន សេចក្តី សោមនស្ស រីករាយ ដែល អាច មាន ភាព ជាដៃគូ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង នេះ ។ នៅក្នុង អំឡុង ពេល ជំងឺ រាតត្បាត គ្មាន នរណា ម្នាក់ មាន សុវត្ថិភាព ទេ រហូតដល់ មនុស្ស គ្រប់ គ្នា មាន សុវត្ថិភាព ។
ស្រប ពេល នឹង សម្តែង ការស្វាគមន៍ និង អំណរគុណ ដល់ អង់គ្លេស ដែល បាន ផ្តល់ វ៉ាក់សាំង . សម្តេច តេជោ ហ៊ុន សែន អះអាង ថា វ៉ាក់សាំង របស់ អង់គ្លេស ដែល ផ្ដល់ជូន ក្នុង ឱកាស នេះ នឹង ប្រើប្រាស់ សម្រាប់ ចាក់ដូស ទី៣ ឬ ដូស ជំរុញ ។
សម្ដេច តេជោ ហ៊ុន សែន អំពាវនាវ ប្រជាពលរដ្ឋ ចូលរួម សហការ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ និង ការពារ ជំងឺ កូវីដ១៩ ដោយ ប្រកាន់ខ្ជាប់ នូវ វិធានការ សុខាភិបាល ពិសេស ៣ការពារ និង ៣កុំ ព្រមទាំង ចូលរួម ចាក់ វ៉ាក់សាំង ។
