* ក្នុង ករណី រកឃើញ ថា បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល ប៉ះពាល់ ដោយ ផ្ទាល់ និង ប្រយោល មាន ចេតនា មិន ចូលរួម សហការ ឬ មាន ប័ណង គេចវេស និង មិន ចូលរួម ក្នុង ការធ្វើតេស្ត រក មេរោគ កូវីដ១៩ នោះ និង ទទួល ការពិន័យ ដូច ខាងក្រោម៖
ទទួល ការផាកពិន័យ ជា អន្តរការណ៍ ស្រប តាម វិធាន សុខាភិបាល និង វិធានការ រដ្ឋបាល នានា របស់ រដ្ឋបាល ខេត្ត ជាធរមាន ៕ នគរបាល ទូទាំង ខេត្ត ព្រៃវែង ធ្វើតេស្តរហ័ស រក មេរោគ កូវីដ១៩ . រកឃើញ មន្ត្រី នគរបាល ម្នាក់ វិជ្ជមាន
នគរបាល ខេត្ត ព្រៃវែង ក៏ បាន ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ នៃ អគ្គ ស្នងការ នគរបាល ជាតិ ក៏ ដូចជា លោក អភិបាល ខេត្ត ព្រៃវែង មន្ទីរ ជំនាញ ដែល បាន យកចិត្តទុកដាក់ គិត គូរ អំពី សុខ មាលភាព និង សុខ ទុក្ខ មន្ត្រី នគរបាល នៅ ទូទាំង ខេត្ត ជាពិសេស បាន យកចិត្តទុកដាក់ ទៅ លើ ស្ថានភាព កំពុង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ហើយ ពិនិត្យ និង ធ្វើតេស្ត រក មេរោគ កូវីដ ជូន នគរបាល នៅ ទូទាំង ខេត្ត ព្រៃវែង ។
សូម បញ្ជាក់ ថា គិត ត្រឹម យប់ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ខេត្ត ព្រៃវែង មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ២. ៧៣៩នាក់ ជាសះស្បើយ សរុប ចំនួន ១. ៥៤៨ នាក់ កំពុង សម្រាក ព្យាបាល សរុប ចំនួន ១. ១៥២ នាក់ និង ស្លាប់ សរុប ៣៩ នាក់ ៕ សាលា ខណ្ឌ កំបូល និង មណ្ឌល សុខភាព ចំនួន ២ នៅ រាជធានី ភ្នំពេញ ទទួលបាន អំណោយ ជា សម្ភារ សម្រាប់ ប្រយុទ្ធ នឹង កូវីដ១៩ ពី ក្រុមហ៊ុន មី នេបៀ ( ខេមបូឌា )
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការការពារ ទប់ស្កាត់ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ក្រុមហ៊ុន មី នេបៀ ( ខេមបូឌា ) បាន ឧបត្ថម្ភ សម្ភារ ការពារ សុវត្ថិភាព ពី ជំងឺ កូវីដ១៩ ជាច្រើន ឈុត មាន ដូចជា សម្លៀកបំពាក់ ការពារ ម៉ាស និង របាំង មុខ ជូន ដល់ សាលា ខណ្ឌ កំបូល . ការិយាល័យ សុខាភិបាល ស្រុក ប្រតិបត្តិ ពោធិ៍ សែនជ័យ និង ការិយាល័យ សុខាភិបាល ស្រុក ប្រតិបត្តិ ព្រែក ព្នៅ ដើម្បី ការពារ សុវត្ថិភាព របស់ ក្រុម គ្រូពេទ្យ និង ក្រុមការងារ នៅពេល ចុះ បំពេញ បេសកកម្ម ផ្សេង ៗ ។
ពិធី ប្រគល់ និង ទទួល នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ខេ នីហ្ស៊ី ហារ៉ា អគ្គ នាយក រង ក្រុមហ៊ុន មី នេបៀ ( ខេមបូឌា ) និង វត្ដមាន លោក ឃឹម ស៊ុន សូដា អភិបាល នៃ គណៈអភិបាល ខណ្ឌ កំបូល និង លោក ហោ វាសនា អភិបាល រង ខណ្ឌ ទទួលបន្ទុក ការងារ ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ - ១៩ នា ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២១ នៅក្នុង តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ ។
ក្នុង ឱកាស នោះ តំណាង ក្រុមហ៊ុន មី នេបៀ ( ខេមបូឌា ) បាន ថ្លែង ថា « យើងខ្ញុំ សង្ឃឹម ថា សម្ភារ ការពារ សុវត្ថិភាព ទាំងនេះ នឹង អាច ជួយ សម្រួល ដល់ ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ របស់ ក្រុម គ្រូពេទ្យ និង ក្រុមការងារ បាន » ។
ជាមួយគ្នា នោះ លោក អភិបាល ខណ្ឌ ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ក្រុមហ៊ុន មី នេបៀ ដែល កន្លងមក តែងតែ ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី អភិវឌ្ឍ សេដ្ឋកិច្ច តាមរយៈ ការបង្កើន ការងារ ជាច្រើន សម្រាប់ កម្មករ កម្មការ នី ដែល កំពុង បំពេញ ការងារ ក្នុង រោងចក្រ នេះ ដែល ជា ចំណែក មួយ នៃ ការលើកកម្ពស់ សេដ្ឋកិច្ច គ្រួសារ ។
លើស ពី នោះ នៅ ថ្ងៃ នេះ បាន ឧបត្ថម្ភ សម្ភារ វេជ្ជសាស្ត្រ ដែល មាន សម្លៀកបំពាក់ និង ឧបករណ៍ ពេទ្យ មួយចំនួន ទៀត ជូន ដល់ រដ្ឋបាល ខណ្ឌ សម្រាប់ ប្រើប្រាស់ នៅ ទីបញ្ជាការ ស្រាល ដែល បង្កើតឡើង ក្នុង គោលបំណង ព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ ដែល មាន ស្ថានភាព ស្រាល នៅ តាម ផ្ទះ ៕
( ភ្នំពេញ ) ៖ ច្បាប់ ស្តីពី កិច្ចការពារ អ្នកប្រើប្រាស់ ត្រូវបាន ចាប់ផ្តើម អនុវត្ត ហើយ ចាប់ពី ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២១ ដោយ មន្រ្តី ស៊ើបអង្កេត របស់ អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ « ក. ប. ប. » នៃ ក្រសួង ពាណិជ្ជកម្ម ។
លោក ផាន អូន ជា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្រ្កាប ការក្លែងបន្លំ ( ក .ប.ប ) នៃ ក្រសួង ពាណិជ្ជកម្ម បាន លើកឡើង ថា ច្បាប់ ស្តីពី កិច្ចការពារ អ្នកប្រើប្រាស់ នេះ នឹង ជំរុញ ឲ្យ ការប្រកួតប្រជែង ក្នុង វិស័យ ពាណិជ្ជកម្ម ប្រព្រឹត្តទៅ ប្រកបដោយ សមធម៌ ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News លោក ផាន អូន បាន ឲ្យដឹង ថា ស្រប ពេល ដែល អនុវត្ដ ច្បាប់ នេះ មាន វិធានការ មួយចំនួន ក៏ ត្រូវបាន ដាក់ ឲ្យ អនុវត្ត ផងដែរ ដោយ រួម មាន៖ វិធានការពិន័យ អន្តរការណ៍ ទណ្ឌកម្ម ផ្នែក រដ្ឋបាល និង ទណ្ឌកម្ម ដោយ តុលាការ មាន សមត្ថកិច្ច ។
លោក ផាន អូន បាន បញ្ជាក់ ថា រហូតមកដល់ ពេលនេះ មន្រ្តី ស៊ើបអង្កេត របស់ អគ្គ នាយកដ្ឋាន ក . ប. ប . បាន ចុះ ស៊ើបអង្កេត ស្រាវជ្រាវ និង បាន រកឃើញ បទល្មើស មួយចំនួន នៅ តាម បណ្តា ទីតាំង អាជីវកម្ម នានា ដោយ បាន អនុវត្ត វិធានការ ពិន័យ អន្តរការណ៍ ចំពោះ ម្ចាស់ អាជីវកម្ម ដែល បាន ប្រព្រឹត្ត បទល្មើស ផងដែរ ។
លោក បន្ដ ទៀត ថា ការអនុវត្ត វិធានការ ច្បាប់ ចំពោះ អំពើ ល្មើស និង ច្បាប់ ស្តីពី កិច្ចការពារ អ្នកប្រើប្រាស់ នឹង បង្កើត បាន នូវ បរិយាកាស នៃ ការប្រកួតប្រជែង ក្នុង វិស័យ ពាណិជ្ជកម្ម សេវាកម្ម ប្រកបដោយ យុត្តិធម៌ សមធម៌ ផ្តល់ នូវ ទំនុកចិត្ត រវាង អ្នកប្រើប្រាស់ និង ធុរ ជន ដែល ជា កត្តា ជំរុញ ឲ្យ មាន កំណើន អតិថិជន សម្រាប់ ធុរ ជន ដែល ប្រកប អាជីវកម្ម ដោយ សុចរិត ។
លោក ផាន អូន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ការអនុវត្ត វិធានការ ច្បាប់ ចំពោះ អំពើ ល្មើស នឹង ច្បាប់ ស្តីពី កិច្ចការពារ អ្នកប្រើប្រាស់ គឺ ដើម្បី ការពារ ផលប្រយោជន៍ អ្នកប្រើប្រាស់ ទប់ស្កាត់ ការប្រព្រឹត្ត អំពើ និង សកម្មភាព មិន សុចរិត ការពារ ផលប្រយោជន៍ ពាណិជ្ជករ បង្កើន ផលិតភាព និង ជំរុញ ឲ្យ ការប្រកួតប្រជែង ក្នុង វិស័យ ពាណិជ្ជកម្ម ប្រព្រឹត្តទៅ ប្រកបដោយ សមធម៌ » ។
បើ តាម ប្រកាស អន្ដរ ក្រសួង ស្ដីពី នីតិវិធី ពិន័យ អន្ដរការណ៍ លើ អំពើ ល្មើស នឹង ច្បាប់ ស្ដីពី កិច្ចការពារ អ្នកប្រើប្រាស់ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ក្រសួង យុត្តិធម៌ និង ក្រសួង ពាណិជ្ជកម្ម បាន ឲ្យដឹង ថា មន្ត្រី ស៊ើបអង្កេត នៃ អគ្គ នាយកដ្ឋាន ក . ប. ប. មាន ភារកិច្ច៖
ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ផ្ញើ ព្រះរាជ លិខិត ជូន លោក ឆាំង យុ នាយក មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា
( ភ្នំពេញ ) ៖ ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ក្នុង សេរីភាព សេចក្តីថ្លៃថ្នូរ និង សុភមង្គល ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ នៅ ខែកក្កដា ឆ្នាំ ២០២១ ព្រះអង្គ សព្វ ព្រះរាជ ហឫទ័យ ផ្ញើ ព្រះរាជ លិខិត មួយ ច្បាប់ ជូន លោក ឆាំង យុ នាយក មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា និង ជា ស្ថាបនិក វិទ្យាស្ថាន ស្លឹក រឹត ។
ព្រះរាជ លិខិត នេះ មាន ខ្លឹមសារ ទាំងស្រុង ដូច ខាងក្រោម៖
CCSA បាន គូសបញ្ជាក់ បន្ថែម ថា ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ អ្នកជំងឺ ចំនួន ៩៨ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ដែល ជា កំណត់ ត្រា ថ្មី មួយ ទៀត ខណៈ អ្នក ជាសះស្បើយ ចំនួន ៥. ៥៤៣ នាក់ ទើបតែ ត្រូវបាន អនុញ្ញាត ឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ។
ប្រកាស ចូលកាន់ តំណែង អភិបាល រង ខេត្ត ព្រះវិហារ . លោក យ៉ុង គឹម ហ៊ាន ជំនួស លោក គោ ស៊ុំ ប៊ុន សឿត ដែល ផ្ទេរ ភារកិច្ច ទៅកាន់ តំណែង ជា អភិបាល រង ខេត្ត ប៉ៃលិន
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ ស្តីពី ការប្រកាស ការចូលកាន់ តំណែង អភិបាល រង ខេត្ត ព្រះវិហារ ដោយ លោក យ៉ុង គឹម ហ៊ាន សមាជិក ក្រុមប្រឹក្សា ខេត្ត ត្រូវបាន តែងតាំង ជា អភិបាល រង ខេត្ត ជំនួស លោក គោ ស៊ុំ ប៊ុន សឿត អតីត អភិបាល រង ខេត្ត ព្រះវិហារ ដែល បាន បញ្ចប់ អាណត្តិ និង ផ្ទេរ ភារកិច្ច ទៅកាន់ តំណែង ជា អភិបាល រង ខេត្ត ប៉ៃលិន វិញ ។
កិច្ចប្រជុំ ផ្សព្វផ្សាយ ប្រកាស ពី ការចូលកាន់ តំណែង អភិបាល រង ខេត្ត ព្រះវិហារ នៅ ពេល នេះ ស្ថិត ក្រោម វត្តមាន លោក ឡុង សុវណ្ណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ដោយ មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត លោក លោកស្រី ជា ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត មេបញ្ជាការ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ លោក អភិបាល ក្រុង ស្រុក និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ។
នៅក្នុង ឱកាស នោះ លោក ប្រាក់ សុវណ្ណ ក្នុង នាម ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ មន្ត្រីរាជការ នៅ តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង អាជ្ញាធរ ក្រុង ស្រុក បាន ថ្លែង នូវ ការចូលរួម អបអរសារទរ ចំពោះ ការចូលកាន់ តំណែង របស់ លោក យ៉ុង គឹម ហ៊ាន ជា អភិបាល រង នៃ គណៈអភិបាល ខេត្ត ព្រះវិហារ នៅ ពេល នេះ ។
លោក អភិបាល ខេត្ត ព្រះវិហារ ក៏ បាន ថ្លែង ណែនាំ ដល់ លោក អភិបាល រង ខេត្ត ព្រះវិហារ ថ្មី ដែល បាន ប្រកាស ចូលកាន់ តំណែង នៅ ពេល នេះ ត្រូវ៖
ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៨៩ នាក់ ជាសះស្បើយ ១១៣ នាក់ និង ស្លាប់ ៥នាក់
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៨៩ នាក់ បន្ថែម ទៀត ជាសះស្បើយ ១១៣ នាក់ និង ស្លាប់ ៥នាក់ មកពី ស្រុក កំពង់សៀម ១នាក់ . ស្រុក ព្រៃឈរ ១នាក់ . ស្រុក បាធាយ ១នាក់ . ស្រុក កង មាស ១នាក់ និង ស្រុក ជើង ព្រៃ ១នាក់ ។
( ភ្នំពេញ ) ៖ គ្រឿង ឧបភោគ បរិភោគ សម្លៀកបំពាក់ និង ថវិកា មួយ ចំនួន ដែល ជា ព្រះរាជ អំណោយ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន យកមក ប្រគល់ ជូន ប្រជាពលរដ្ឋ មាន ពិការភាព ចំនួន ៤៤៦ នាក់ ដែល ទទួលរង ផល ប៉ះពាល់ ដោយ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ។
ពិធី ប្រគល់ និង ទទួល ព្រះរាជ អំណោយ នេះ ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២១ នេះ នៅក្នុង វិទ្យាល័យ ចតុមុខ ក្រោម អធិបតីភាព របស់ សម្ដេច ចៅហ្វា វាំង វរ វៀង ជ័យ អធិបតី ស្រឹង្គារ គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង និង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ក្រោយពី ប្រជាពលរដ្ឋ រងគ្រោះ និង ងាយ រងគ្រោះ ជន ពិការ ទាំង នេះ បាន ទទួល ការធ្វើតេស្ត យកសំណាក់ រក ជំងឺ កូវីដ១៩ ទៅ តាម វិធាន របស់ ក្រសួង សុខាភិបាល រួចរាល់ ។
លោក ឃួង ស្រេង បាន លើកឡើង ថា រាជធានី ភ្នំពេញ ក្នុង រយៈពេល ០៦ ខែ ដើម ឆ្នាំ នេះ បាន ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ យ៉ាង ខ្លាំងក្លា ពិសេស ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ នេះ ។ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ គោល នយោបាយ ជា បន្តបន្ទាប់ ពិសេស ការប្រតិបត្តិ នូវ គោលការណ៍ គ្រឹះ ទាំង ៦ចំណុច របស់ សម្តេច តេជោ ដើម្បី គ្រប់គ្រង សភាពការណ៍ កូវីដ - ១៩ នេះ ឲ្យបាន ល្អ ប្រសើរ ។
លោក ឃួង សេ្រង ក៏ បាន បញ្ជាក់ ផងដែរ ថា ប្រជាពលរដ្ឋ ដែល រង នូវ ផល ប៉ះពាល់ ដោយ ជំងឺ កូវីដ១៩ នៅ រាជធានី ភ្នំពេញ ចំនួន ៥០ម៉ឺន គ្រួសារ ហើយ ទទួលបាន អំណោយ ក្នុង នោះ មាន ទាំង ព្រះរាជ អំណោយ របស់ ព្រះមហាក្សត្រ . ព្រះរាជ អំណោយ របស់ សម្ដេច ម៉ែ . អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន . សម្ដេច ពញ្ញា ចក្រី ហេង សំរិន . សម្ដេច វិបុល សេនា ភក្តី សាយ ឈុំ. សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ . សម្ដេច ចៅហ្វា វាំង គង់ សំអុល និង អំណោយ ផ្សេង ៗ ទៀត របស់ សប្បុរសជន ។
ក្នុង ឱកាស នោះ ក្នុង នាម ក្រុមប្រឹក្សា គណៈ អភិបាល រាជធានី មន្ដ្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទាំងអស់ នៅ រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ថ្លែងអំណរ ព្រះរាជ គុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ថ្វាយ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ បាន សព្វ ព្រះរាជ ហប្ញ ទ័យ ប្រោស ព្រះរាជ ទាន ព្រះរាជ អំណោយ តាមរយៈ សម្ដេច ចៅហ្វា វាំង វរ វៀង ជ័យ អធិបតី ស្រឹង្គារ គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី ជូន បងប្អូន មាន ពិការភាព ចំនួន ៤៤៦ នាក់ នៅ ភ្នំពេញ ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខណ្ឌ ជ្រោយ ចង្វារ សូម ជម្រាប ជូនដំណឹង ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង មូលដ្ឋាន ខណ្ឌ ឲ្យបាន ជ្រាប ថា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ក្នុង ការពិគ្រោះយោបល់ គ្រប់គ្រង ថែទាំ និង ព្យាបាល អ្នក មាន ជំងឺ កូវីដ១៩ ដោយ ស្ម័គ្រចិត្ត តាម ផ្ទះ រដ្ឋបាល ខណ្ឌ បាន បង្កើត គណៈ បញ្ជាការ ស្រាល ដើម្បី ងាយស្រួល ក្នុង ការទំនាក់ទំនង និង ឆ្លើយតប ជាបន្ទាន់ ។
កិច្ចប្រជុំ បូកសរុប ការងារ គយ និង រដ្ឋាករ ប្រចាំ ឆមាស ទី១ ឆ្នាំ ២០២១ ធ្វើឡើង តាម ប្រព័ន្ធ វីដេអូ ក្រោម អធិបតីភាព លោក បណ្ឌិត គុណ ញឹម រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ដោយ មាន ការចូលរួម ពី លោក លោកស្រី អគ្គ នាយក រង ប្រធាន នាយកដ្ឋាន ប្រធាន សាខា ប្រធាន ការិយាល័យ និង មន្ត្រី គយ និង រដ្ឋាករ មួយចំនួន នៅ ទូទាំង ប្រទេស នា ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២១ នៅ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ។
បើ ពិនិត្យមើល តួលេខ នៃ ទំហំ ពាណិជ្ជកម្ម អន្តរជាតិ ក្នុង ឆមាស ទី១ ឆ្នាំ ២០២១ ធៀប នឹង ឆមាស ទី១ ឆ្នាំ ២០២០ មាន ដូច ខាងក្រោម៖
* ការនាំចេញ ផលិតផល វិនិយោគ មិន មែន កាត់ដេរ ( ដូចជា កង់ គ្រឿង បំណែក អេឡិចត្រូនិក បង្គុំ ខ្សែភ្លើង គ្រឿង បន្លាស់ រថយន្ត អំពូល លម្អ កុង ផ្លាកេ និង ផលិតផល ឧស្សាហកម្ម ផ្សេង ៗ ទៀត ) មាន ចំនួន ១. ៨៩៩.៧ លាន ដុល្លារ អាមេរិក កើនឡើង ប្រមាណ ៦៣២.៥ លាន ដុល្លារ អាមេរិក ស្មើនឹង ៤៩. ៩% ។ កំណើន ល្អ ប្រសើរ នៃ ការនាំចេញ ផលិតផល វិនិយោគ មិន មែន កាត់ដេរ បាន ឆ្លុះបញ្ចាំង ពី លទ្ធផល នៃ ការអនុវត្ត គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការធ្វើ ពិពិធកម្ម វិស័យ ឧស្សាហកម្ម នៅ កម្ពុជា ។
ទន្ទឹមនឹង ការងារ ប្រមូល ចំណូល នេះ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ក៏ សម្រេចបាន លទ្ធផល ល្អ លើ ការងារ សំខាន់ ៗ មួយចំនួន ទៀត ដែល មាន ចែង ក្នុង ផែនការ សកម្មភាព ប្រចាំ ឆ្នាំ ២០២១ ដូច ជា៖
ជា ទិសដៅ បន្ត ដើម្បី ធានា បាន នូវ លទ្ធផល ល្អ ប្រសើរ ក្នុង បរិបទ ដែល ប្រទេស កម្ពុជា ក៏ ដូចជា សាកល - លោក ទាំងមូល កំពុង ជួបប្រទះ នឹង រោគ រាតត្បាត កូវីដ - ១៩ លោក រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី បាន ធ្វើ ការក្រើន រម្លឹក នូវ អនុសាសន៍ ណែនាំ របស់ លោក អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ រួម មាន៖
លោក រដ្ឋមន្រ្តី ប្រតិភូ បាន ណែនាំ បន្ថែម ដល់ មន្រ្តី ក្រោម ឱវាទ អគរ ទាំងអស់ ឲ្យ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការពង្រឹង ការកៀរ គរ ចំណូល ប្រកបដោយ ភាពសកម្ម បុរេសកម្ម និង វៃ ឆ្លាត ព្រមទាំង ប្រើប្រាស់ ឲ្យ អស់ សក្តានុ - ពល បញ្ញា ស្មារតី ដើម្បី ប្រមូល ចំណូល ឲ្យបាន គ្រប់ និង លើស ផែនការ ហើយ ទន្ទឹម នឹង នោះ ត្រូវ រក្សា បាន នូវ និរន្តរភាព ការងារ និង ប្រកាន់ នូវ វិធានការ អនាម័យ បទាំង ក្នុង ការងារ និង ការរស់នៅ ដើម្បី ធានា បាន សុវត្ថិភាព ដោយ អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ វិធានការ សុខាភិបាល ៣ កុំ និង ៣ ការពារ ។
លោក រដ្ឋមន្រ្តី ប្រតិភូ ក៏ បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ អគរ ឲ្យ បន្ត ចូលរួម ក្នុង ការងារ សង្គម ក្នុង គ្រា ដ៏ លំបាក នេះ តាមរយៈ ការបន្ត អនុវត្ត យុទ្ធនាការ មនុស្សធម៌ ចុះ ជួយ សម្រួល ការលំបាក របស់ ជន ងាយ រងគ្រោះ ដូចជា កុមារ កំព្រា និង ក្រុម ជន ទី ទាល់ ក្រ ជាដើម ៕
ក្រសួង ទេសចរណ៍ ចេញ សារាចរ ស្តីពី ការប្រើប្រាស់ ប្រព័ន្ធ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍
* មន្ទីរ ទេសចរណ៍ រាជធានី - ខេត្ត ត្រូវ រៀបចំ មន្រ្តី ជំនាញ ដើម្បី សម្របសម្រួល លើ ការប្រើប្រាស់ នៅក្នុង ប្រព័ន្ធ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ។
* គ្រឹះស្ថាន អប់រំ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ សាលា បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ អង្គភាព ស្ថាប័ន រដ្ឋ និង ឯកជន ក្រុមហ៊ុន និង ដៃគូ អភិវឌ្ឍ ដែល មាន ផ្តល់ សេវា បណ្តុះបណ្តាល ជំនាញ ក្នុង វិស័យ ទេសចរណ៍ បដិសណ្ឋារកិច្ច និង ការធ្វើដំណើរ និង មជ្ឈមណ្ឌល វាយតម្លៃ សមត្ថភាព អាច ប្រើប្រាស់ ប្រព័ន្ធ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ជា មូលដ្ឋាន សម្រាប់ ធ្វើ ការបើក វគ្គ បណ្តុះបណ្តាល និង វាយតម្លៃ សមត្ថភាព តាម ប្រព័ន្ធ អនឡាញ របស់ ខ្លួន ។
* ភាគី ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ បញ្ចូល ទិន្នន័យ ទាក់ទង នឹង វគ្គ បណ្តុះបណ្តាល និង វាយតម្លៃ សមត្ថភាព លើ ជំនាញ ក្នុង វិស័យ ទេសចរណ៍ បដិសណ្ឋារកិច្ច និង ការធ្វើដំណើរ របស់ ខ្លួន ទៅក្នុង ប្រព័ន្ធ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ។
* ភាគី ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ សហការ ជំរុញ ផ្សព្វផ្សាយ វគ្គ បណ្តុះបណ្តាល និង វាយតម្លៃ សមត្ថភាព លើ ប្រព័ន្ធ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ឱ្យ បាន ទូលំទូលាយ ។
* ភាគី ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ សហការ ជាមួយ ក្រុមការងារ ត្រួតពិនិត្យ តាមដាន និង វាយតម្លៃ សមត្ថភាព អ្នកជំនាញ ទេសចរណ៍ របស់ ក្រសួង ទេសចរណ៍ ដើម្បី ធ្វើ ការប្រមូល និង បញ្ចូល ព្រមទាំង ធ្វើ បច្ចុប្បន្នភាព ទិន្នន័យ ពាក់ព័ន្ធ នឹង សមត្ថភាព និង ជំនាញ របស់ អ្នកបម្រើ ការងារ យុវជន សិស្ស និស្សិត និង សិក្ខាកាម របស់ ខ្លួន ។
( កំពត ) ៖ ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង កម្ពុជា និង សមាជិក នា ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២១ បាន នាំយក អំណោយ មួយចំនួន មាន ដូចជា សម្លៀកបំពាក់ ពេទ្យ ម៉ាស និង ថ្នាំ បុរាណ ចិន ប្រគល់ជូន រដ្ឋបាល ខេត្ត កំពត ដើម្បី រួមចំណែក ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
សម្ភារ ដែល ប្រគល់ជូន រដ្ឋបាល ខេត្ត កំពត រួម មាន សម្លៀកបំពាក់ ពេទ្យ ២.០០០ ឈុត ម៉ាស ១០.០០០ បន្ទះ និង ថ្នាំ បុរាណ ចិន ៤០០ ប្រអប់ ។
សូម ជម្រាប ថា សមាគម ស្បែកជើង កម្ពុជា តែងតែ យកចិត្តទុកដាក់ ជួយ ឧបត្ថម្ភ ដល់ រាជ រដ្ឋាភិបាល និង ប្រជាពលរដ្ឋ ខ្មែរ ដែល ទទួល រងគ្រោះ ដោយសារ ជំងឺ កូវីដ១៩ តាមរយៈ រូបភាព ផ្សេង ៗ កន្លងមក នេះ ៕ ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បន្ត ចាត់ ក្រុមការងារ នាំយក ស្បៀង ឧបត្ថម្ភ ដល់ ប្រជាពលរដ្ឋ ៩នាក់ ទៀត ជាប់ពាក់ព័ន្ធ ជាមួយ បុគ្គល វិជ្ជមាន ជំងឺ កូវីដ ក្នុង សង្កាត់ ព្រែក កំពឹស
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខណ្ឌ ដង្កោ បាន បន្ត ចាត់ ឲ្យ ក្រុមការងារ នាំយក អំណោយ ជា ស្បៀង ឧបត្ថម្ភ ដល់ ពលរដ្ឋ ៩នាក់ បន្ថែម ទៀត ដែល ជាប់ពាក់ព័ន្ធ ជាមួយ បុគ្គល មាន វិជ្ជមាន ជំងឺ កូវីដ - ១៩ កំពុង ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ រៀង ៗ ខ្លួន ក្នុង ភូមិ ព្រែករ ទាំង សង្កាត់ ព្រែក កំពឹស ខណ្ឌ ដង្កោ ។
អំណោយ ដែល ត្រូវបាន លោក ឧត្ដមសេនីយ៍ ត្រី ឈុន ប៊ុន ទី មេបញ្ជាការ រង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ នាំយក ទៅ ប្រគល់ ជូន ប្រជាពលរដ្ឋ នៅ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២១ រួម មាន អង្ករ មី ត្រីខ ទឹកត្រី ទឹក ស៉ី អ៉ីវ ទឹក សុទ្ធ ព្រមទាំង ឱសថ បុរាណ ចិន ព្យាបាល ក្អក ផ្តាស់ សាយ ក្តៅ ខ្លួន ឈឺ ក្បាល ការពារ សួត ផងដែរ ។
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការបើក ផ្ដល់ ប្រាប់ ឧបត្ថម្ភ ជូន កម្មករ និយោជិត ក្នុង វិស័យ កាត់ដេរ និង ទេសចរណ៍ ដែល ត្រូវ ព្យួរ កិច្ចសន្យា ការងារ សរុប ចំនួន ៣ ១៨០ នាក់ នៃ រោងចក្រ - សហគ្រាស ទាំង ៣២ ស្រប តាម ស្មារតី នៃ កញ្ចប់ វិធានការ របស់ រាជ រដ្ឋាភិបាល ( លើក ទី ៦៣) ។
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ ក្រសួង ការងារ៖ ទោះ ក្នុង វិបត្តិ កូវីដ១៩ ខេត្ត ព្រៃវែង នៅតែ ឈានមុខ ក្នុង ការនាំ ស្រូវ ទៅ លក់ នៅ វៀតណាម បាន ជាង ១លាន តោន ក្នុង រយៈពេល ជាង ៧ ខែ
លោក អ៊ុក សំណាង បាន បន្ត ថា សម្រាប់ ខេត្ត ព្រៃវែង ការនាំ ស្រូវ ទៅ លក់ នៅ ប្រទេស ជិតខាង មួយ ថ្ងៃ មាន ចំនួន ចាប់ពី ៣០០០ ទៅ៤០០០ តោន ហើយ ភាគ ច្រើន ស្រូវ នៅក្នុង ខេត្ត និង ក្រៅ ខេត្ត មាន តិចតួច ប៉ុណ្ណោះ ។ ចំពោះ ស្រូវ ដែល នាំទៅ លក់ នេះ ដែរ គឺ មាន ជារៀងរាល់ ខែ គ្រាន់តែ ខែ ខ្លះ តិច និង ច្រើន តែ ប៉ុណ្ណោះ ប៉ុន្តែ មិន ដែល ដាច់ នោះ ទេ គឺ មាន លក់ ជា ហូរហែ តាម ច្រក ទ្វារ អន្តរជាតិ បន្ទាយ ចក្រី និង ច្រកទ្វារ អន្តរជាតិ កោះ រកា ក្នុង ខេត្ត ព្រៃវែង ។
( ក្រចេះ ) ៖ លោក គង់ គឹម នី អភិបាល រង ខេត្ត ក្រចេះ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ស្នួល ព្រមទាំង ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ អភិបាល ស្រុក ប្រធាន មន្ទីរ អង្គភាព និង ពុទ្ធ បរិស័ទ នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន យក នូវ ទៀន ព្រះវស្សា គ្រឿង ឧបភោគ បរិភោគ និង បច្ច័យ ទៅ វេរ ប្រគេន ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា ចំនួន ៦វត្ត ដែល ស្ថិត នៅក្នុង ឃុំ ឃ្សឹម ស្រុក ស្នួល ខេត្ត ក្រចេះ ។
លោក គង់ គឹម នី បាន លើកឡើង ថា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ធ្វើឱ្យ វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ មាន ការរីកចម្រើន ទន្ទឹម គ្នា ពិសេស ពុទ្ធ បរិស័ទ មាន ជីវភាព ធូរធា បាន ចូលរួម កសាង ទី វត្តអារាម ឲ្យ មាន ការអភិវឌ្ឍ យ៉ាង ល្អ ប្រសើរ ។
ឆ្លៀត ក្នុង ឪកាស នោះ ដែរ លោក គង់ គឹម នី បាន ផ្ដាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ត្រូវ បន្ត ចូលរួម ធ្វើ អនាម័យ ជាប្រចាំ ដោយ អនុវត្ត តាម វិធានការ របស់ រាជ រដ្ឋាភិបាល ( ៣ការពារ ៣កុំ ) និង ការណែនាំ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ត្រឹមត្រូវ និង ត្រូវ អនុវត្ត ឱ្យ បាន ម៉ឺងម៉ាត់ នូវ វិធានការ បង្ការ ការពារ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ COVID-១៩ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ។
លោ កាំង តុង ងី បាន ថ្លែង ថា « គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ទាំង ១១៤ ជា សមាជិក របស់ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន រៀបចំ ឥណទាន ឡើងវិញ ជូន ដល់ អតិថិជន មាន ចំនួន ៣៤៨ ០៩៤ នាក់ ក្នុង ទំហំ ឥណទាន សរុប ជាង ១៦៦៤ លាន ដុល្លា គិត គិត ត្រឹម ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២១ នេះ » ។
លោក បន្ថែម ថា រយៈពេល ប្រមាណ ៥ សប្តាហ៍ ចុងក្រោយ នេះ ការស្នើសុំ រៀបចំ ឥណទាន ឡើងវិញ មាន ការធ្លាក់ចុះ បន្តិច ។ តែ ទោះជា យ៉ាង នេះ ក្ដី សមាគម នៅតែ មិន ទាន់ អាច វាយតម្លៃ បាន ថា ផល ប៉ះពាល់ នឹង មាន ការថយចុះ នោះ ដែរ ។
លោក បាន បញ្ជាក់ ថា « តាម ការសង្កេត របស់ សមាគម ឃើញ ថា ស្ថានភាព នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ មាន ស្ថានភាព មិន ល្អ ប្រសើរឡើយ ហើយ រឹតតែ រីករាលដាល ទៅកាន់ គ្រប់ ខេត្ត ក្រុង នៃ ប្រទេស កម្ពុជា ។ ជា ការប្តេជ្ញាចិត្ត របស់ វិស័យ មីក្រូ ហិរញ្ញវត្ថុ នឹង បន្ត រៀបចំ ឥណទាន ឡើងវិញ ជូន អតិថិជន ដ៏ រាបណា ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ១៩ នៅតែ មាន បើ ទោះជា គ្រឹះស្ថាន ខ្លួន កំពុង ធ្លាក់ចុះ ប្រាក់ ចំណូល និង កើនឡើង ថ្លៃ ប្រត្តិបត្តិការ ក្តី » ។
លោក កាំង តុង ងី បញ្ជាក់ ទៀត ថា យន្តការ នៃ ការរៀបចំ ឥណទាន ឡើងវិញ មាន សារៈសំខាន់ ណាស់ ក្នុង ការជួយ សម្រាល បន្ទុក អតិថិជន ដែល ទទួលរង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវី១៩ ក្នុង កំរិត ធ្ងន់ និង មធ្យម ។ យន្តការ នេះ បាន ជួយ បន្ធូរបន្ទុក អតិថិជន ក្នុង ការបង់ សង ត្រលប់ មកកាន់ គ្រឹះស្ថាន និង បាន ផ្តល់ ឪកាស ឲ្យ អតិថិជន យក ប្រាក់ ដែល ខ្លួន មាន ទៅ ប្រើប្រាស់ សម្រាប់ កិច្ចការងារ ផ្សេង ចាំបាច់ ក៏ ដូចជា ប្រើប្រាស់ សម្រាប់ ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ។
លោក បន្ថែម ថា ក្នុង ករណី ខ្លះ គ្រឹះស្ថាន បាន ផ្តល់ ជំរើស មិន បាច់ បង់ សង ត្រលប់ ទាំង ដើម ទាំង ការ រហូតដល់ រយៈពេល ៦ខែ ហើយ អាច រៀបចំ ឥណទាន ឡើងវិញ រហូតដល់ បី ដង ។
លោក បញ្ជាក់ ទៀត ថា ក្រៅពី យន្តការរៀបចំ ឥណទាន គ្រឹះស្ថាន ហិរញ្ញវត្ថុ នៅ កម្ពុជា រួមទាំង ធនាគា មីក្រូ ហិរញ្ញវត្ថុ តាមរយៈ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា និង សមាគម ធនាគារ នៅ កម្ពុជា កាលពី ដើម ខែមេសា បាន ដាក់ចេញ នូវ អន្តរាគមន៍ បន្ថែម ដើម្បី ជួយ ដល់ អ្នករង ផល ប៉ះពាល់ ដោយ ផ្ទាល់ ដូចជា អ្នក ជាប់ ក កាតព្វកិច្ចចត្តាឡី ស័ក អ្នក ឆ្លង ជំងឺ ឬ អ្នក ដែល មាន សមាជិក ស្លាប់ ដោយសារ ជំងឺ នេះ ផងដែរ ។ ការផ្តល់ ជូន នេះ បាន ទទួល ការសាទរ ពី សាធារណជន និង ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ផងដែរ ៕
វិស័យ ឯកជន ស្នើសុំ ឲ្យ មាន ការរៀបចំ គោល នយោបាយ កៅស៊ូ ដើម្បី ជួយ គាំពារ វិស័យ កៅស៊ូ បាន ល្អ ប្រសើរ
( ភ្នំពេញ ) ៖ វិស័យ ឯកជន បាន ស្នើសុំ ដល់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ឲ្យ មាន ការរៀបចំ គោល នយោបាយ កៅស៊ូ នៅ កម្ពុជា ដូចជា គោល នយោបាយ ស្រូវ អង្ករ ដើម្បី រក្សា ស្ថិរភាព នៃ តម្លៃ កៅស៊ូ ។
លោក លឹម ហេង អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង ជា អគ្គ នាយក រង ក្រុមហ៊ុន អាន ម៉ាឌី គ្រុប ដែល វិនិយោគ ដំណាំ កៅស៊ូ បាន ថ្លែង ថា « រាជ រដ្ឋាភិបាល គួរតែ បង្កើត គោល នយោបាយ កៅស៊ូ ដើម្បី ទ្រទ្រង់ គាំពារ វិស័យ កៅស៊ូ បាន ល្អ ប្រសើរ ជួយ ឲ្យ អ្នក ដាំ កៅស៊ូ អាច ដាំ អាច ដំណើរការបាន ល្អ ប្រសើរ ។ កន្លងមក កម្ពុជា មាន គោល នយោបាយ ស្រូវ អង្ករ រួច មកហើយ ហើយ ថ្មី ៗ នេះ មន្រ្ដី នៃ ក្រសួង ពាណិជ្ជកម្ម បាន និង កំពុង រៀបចំ គោល នយោបាយ ស្វាយចន្ទី បន្ថែម ទៀត » ។
លោក បាន បន្ថែម ថា « ខ្ញុំ សង្ឃឹម ថា បន្ទាប់ពី បាន រៀបចំ គោល នយោបាយ ស្វាយចន្ទី រួច នឹង អាច ឈានដល់ ការរៀបចំ គោល នយោបាយ ស្ដីពី កៅស៊ូ ដើម្បី ជួយ ដល់ អ្នក ដាំ កៅស៊ូ ទាំង អ្នក ដាំ លក្ខណៈ គ្រួសារ និង អ្នក ដាំ ជា ក្រុមហ៊ុន មាន ទំនុកចិត្ត បន្ដ ការដាំដុះ និង ពង្រីក ផ្ទៃដី ដាំដុះ បន្ថែម » ។
លោក លឹម ហេង បាន បន្ថែម ថា ប្រហែលជា ៧ឆ្នាំ ចុងក្រោយ នេះ ការវិវត្ត នៃ ដំណាំ កៅស៊ូ មាន ការយឺតយ៉ាវ ខ្លាំង ដោយសារតែ បញ្ហា តម្លៃ កៅស៊ូ ធ្លាក់ ថ្លៃ ធ្វើឲ្យ កសិករ និង ក្រុមហ៊ុន មួយចំនួន បាន ផ្លាស់ប្ដូរ ការដាំ កៅស៊ូ ទៅ ដំដាំ ណាំ ផ្សេង ៗ មួយ ទៀត ប៉ុន្ដែ មិន មែន ឈប់ ដាំ ដំណាំ កៅស៊ូ ឡើយ ដែល ការផ្លាស់ប្ដូរ ដំណាំ នេះ គឺ ដើម្បី បាន ថវិកា ទ្រទ្រង់ ក្រុមហ៊ុន ក៏ ដូចជា ទ្រទ្រង់ ជីវភាព របស់ ខ្លួន និង ទន្ទឹងរង់ចាំ ឱកាស កៅស៊ូ ឡើង ថ្លៃ និង មាន ទីផ្សារ ល្អ ប្រសើរ ឡើងវិញ ។
រយៈពេល ៦ខែ ដំបូង ឆ្នាំ នេះ ចំណូល បាន ពី ការនាំចេល កៅស៊ូ សម្រេចបាន ចំនួន ២២២ ៤៣២ ៧៦២.៩៣ ដុល្លារ ក្នុង នោះ ចំណូល ពី ជ័រ កៅស៊ូ៖ ២២១ ៦៧៥ ៧៧០. ០៩ ដុលា្លរ និង ចំណូល ពី ឈើ កៅស៊ូ ៧៥៦ ៩៩២. ៨៤ ដុលា្លរ ៕ រដ្ឋបាល ខេត្ត កំពង់ធំ បន្ដ អនុវត្ត វិធានការ រដ្ឋបាល ផ្អាក ការលក់ដូរ គ្រឿងស្រវឹង និង ការជួបជុំ ពិសារ គ្រឿងស្រវឹង រយៈពេល ២សប្ដាហ៍ បន្ថែម ទៀត
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ដ កំពង់ធំ នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីសម្រេច បន្ដ ផ្អាក ជា បណ្ដោះអាសន្ន ការលក់ គ្រឿងស្រវឹង គ្រប់ ប្រភេទ ការជួបជុំគ្នា ពិសារ គ្រឿងស្រវឹង និង ការទទួល ភ្ញៀវ ចូល ទទួលទាន អាហារ ឬ ភេសជ្ជៈ តាម អាហារដ្ឋាន រយៈពេល ២សប្ដាហ៍ បន្ថែម ទៀត ចាប់ពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២១ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ដ្រ ខេត្ត កំពង់ធំ ។ នេះ បើ តាម សេចក្ដីសម្រេច ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
ខាងក្រោម នេះ ជា សេចក្ដីសម្រេច របស់ រដ្ឋបាល ខេត្ត កំពង់ធំ៖ មន្រ្តី នគរបាល ខេត្ត កោះកុង ៩រូប រកឃើញ វិជ្ជមាន កូវីដ
អការយក សំណាក របស់ មន្ត្រី នគរបាល គឺ អនុវត្ត តាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ព្រមទាំង មាន ការចង្អុល ដឹកនាំ ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ដើម្បី យកចិត្តទុកដាក់ ចំពោះ សុខុមាលភាព របស់ មន្រ្តី នគរបាល ជាតិ ដូចជា ការចូលរួម ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង និង កាត់ផ្តាច់ការឆ្លង រាលដាល កូវីដ១៩ នៅក្នុង សហគមន៍ ។
