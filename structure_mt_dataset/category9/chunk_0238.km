( ភ្នំពេញ ) ៖ កាលពី ថ្ងៃទី ២៨ - ២៩ ខែកក្កដា ឆ្នាំ ២០២១ លោក លឹម ប៊ុន ហុក អគ្គ នាយក រង ក្រុមប្រឹក្សា វប្បធម៌ អាស៊ី តំណាង លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី និង ប្រធាន ក្រុមប្រឹក្សា វប្បធម៌ អាស៊ី បាន ចូលរួម ថ្លែង ក្នុង កម្មវិធី សន្និសីទ ថ្នាក់ដឹកនាំ អន្តរជាតិ ក្រោម ប្រធានបទ ឆ្ពោះ ទៅរក ការបង្រួបបង្រួម ដោយ សន្តិភាព នៃ ឧបទ្វីប កូរ៉េ តាមរយៈ គំនិត ផ្តួចផ្តើម វប្បធម៌ សិល្បៈ និង កីឡា និង គម្រោង ផ្លូវ សន្តិភាព ។
លោក ក៏ បាន បន្ថែម ទៀត ថា វប្បធម៌ គួរតែ ជា កម្លាំង មួយ នៃ ការឯកភាព គ្នា មិន មែន ជា កម្លាំង បំបែកបំបាក់ គ្នា នោះ ទេ ។ បទពិសោធន៍ ជាច្រើន បាន បង្ហាញ ថា តើ វប្បធម៌ ផ្ដល់ ជា ច្រកទ្វារ ចូល សម្រាប់ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ បែប ណា ដើម្បី បង្រួបបង្រួម ប្រជាជាតិ ដែល មាន ព្រំដែន ជាប់ គ្នា ក្នុង ការការពារ បេតិកភណ្ឌ វប្បធម៌ រួមគ្នា ឬ ផ្លាស់ប្ដូរ វប្បធម៌ ជាមួយគ្នា ជា អាទិ៍ តាមរយៈ ការអនុវត្ត កម្មវិធី ផ្លាស់ប្តូរ វប្បធម៌ ការសម្ដែង សិល្បៈ ពិព័រណ៍ សិល្បៈ និង ការលើកតម្លៃ វប្បធម៌ រួមគ្នា ជាដើម ។
លោក បង្ហាញ ការជឿជាក់ ថា ការបង្រួបបង្រួម ប្រទេស កូរ៉េ ទាំង ពីរ គឺ អាច ទៅ រួច ដើម្បី ជា ប្រយោជន៍ ដ៏ ធំ របស់ ប្រជាជន កូរ៉េ ជា ប្រយោជន៍ តំបន់ និង ពិភពលោក ទាំងមូល ដូច្នេះ សូម ចូលរួម ជំរុញ ឱ្យ មិត្ត កូរ៉េ ចាប់ផ្ដើម ដំណើរការ បង្រួបបង្រួមគ្នា នេះ ដើម្បីឱ្យ ប្រទេស ទាំង ពីរ ក្លាយជា ប្រទេស តែ មួយ ទទួលបាន សុខ សន្តិភាព និង សេចក្ដីចម្រុង ចម្រើន ៕ ប្រជាពលរដ្ឋ ដែល ត្រូវ សមត្ថកិច្ច រឹបអូស ត្រាក់ទ័រ សាទ រ នឹង ចំណាត់ របស់ លោក ថោង ខុន ដោះស្រាយ បញ្ហា ជូន ពួកគាត់ និង រង់ចាំ ការដោះស្រាយ របស់ មន្ត្រី ពាក់ព័ន្ធ
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ដែល ត្រូវ កម្លាំង សមត្ថកិច្ច ជំនាញ រឹបអូស ត្រាក់ទ័រ កាលពី ពេល កន្លងទៅ នោះ បាន បង្ហាញ ការសាទរ យ៉ាង ខ្លាំង ចំពោះ ចំណាត់ការ ទាន់ ពេល របស់ លោក រដ្ឋមន្ត្រី ថោង ខុន ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ និង លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ ដែល បាន ដាក់ យន្តការដោះស្រាយ បញ្ហា ជូន ពួកគាត់ ក៏ ដូចជា បង្ការ ការ កៀប សង្កត់ លើ ប្រជាពលរដ្ឋ ផ្សេង ទៀត ខណៈ ពួកគាត់ ក៏ កំពុង ទន្ទឹងរង់ចាំ មើល ការដោះស្រាយ របស់ មន្ត្រី ពាក់ព័ន្ធ បន្ត ទៀត ដែរ ។
លោក ថោង ខុន បាន បញ្ជាក់ ហើយ បញ្ជាក់ ទៀត ថា « ការប្រគល់ គ្រឿងចក្រ ជូន ប្រជាពលរដ្ឋ ជា ម្ចាស់ វិញ នេះ មិន តម្រូវ ឱ្យ ពួកគាត់ បង់ប្រាក់ ផាក ពិន័យ នោះ ឡើយ » ។
បន្ទាប់ពី បាន ឃើញ ចំណាត់ការ និង ការយកចិត្តទុកដាក់ ដោះស្រាយ យ៉ាង ដូច្នេះហើយ ប្រជាពលរដ្ឋ នៅ ស្រុក ប្រាសាទ បល្ល័ង្ក ស្រុក ស្ទោង ស្រុក សណ្ដាន់ ស្រុក ប្រាសាទ សំបូរ ស្រុក សន្ទុក ប្រជាពលរដ្ឋ នៅ ទី រួម ខេត្ត កំពង់ធំ មន្ត្រី មូលដ្ឋាន ផង នោះ បាន សម្ដែង នូវ ការគាំទ្រ សាទ រ យ៉ាង ខ្លាំង ចំពោះ ការយកចិត្តទុកដាក់ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ មកកាន់ បណ្ដាញ សារព័ត៌មាន Fresh News នៅ មុន បន្តិច ។
ប្រជាពលរដ្ឋ បាន បង្ហាញ ការជឿជាក់ ថា ចំណាត់ការ ពីសំណាក់ ថ្នាក់ លើ នៃ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត នឹង មាន ប្រសិទ្ធភាព ស្រប តាម ការណែនាំ របស់ ថ្នាក់ លើ ព្រមទាំង អាច លួងលោម ឱ្យ ប្រជាពលរដ្ឋ បាន ធូរស្បើយ ពី ការភ័យខ្លាច ព្រួយបារម្ភ មកវិញ ដើម្បី បន្ត ការបង្កបង្កើន ផល កសិកម្ម ស្រោចស្រង់ ជីវភាព រស់ នៅ ឱ្យ ល្អ ប្រសើរ ឡើងវិញ ខណៈ រដូវ ធ្វើ ស្រែ ចម្ការ បាន ចូល មកដល់ បណ្ដើរ ៗ ហើយ ។
ប្រជាពលរដ្ឋ បាន បង្ហាញ អារម្មណ៍ មួយ ទៀត ថា ពួកគាត់ ក៏ សុទ្ធតែ រងគ្រោះ ដោយសារ វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ ណាមួយ ខ្លាច ឆ្លង កូវីដ ផង ណាមួយចំណូល ក៏ មាន ការថយចុះ ផង ក៏ ដាច់ចិត្ត ទៅ ខ្ចី លុយ ពី ធនាគារ ឬ មីក្រូ ហិរញ្ញវត្ថុ ដើម្បី យកមក ធ្វើ ស្រែ ចម្ការ គ្រាន់ បាន ដោះស្រាយ ជីវភាព គ្រួសារ ដោះស្រាយ តម្រូវ ការចាំបាច់ ប្រចាំ ថ្ងៃ ត ទៅ មុខ ទៀត ។ ពួកគាត់ ក៏ បាន បង្ហាញ ការសន្យា ដែរ ថា នៅពេល ទទួលបាន សម្ភារៈ គ្រឿងចក្រ មកវិញ ហើយ ពួកគាត់ នឹង គោរព តាម ការណែនាំ ចង្អុលបង្ហាញ របស់ អាជ្ញាធរ ។
លើស ពី នេះ ទៅ ទៀត ប្រជាពលរដ្ឋ ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ព្រមទាំង លោក ប្រធាន ថោង ខុន និង លោក អភិបាល ខេត្ត សុខ លូ ដែល តែងតែ ខិតខំ យកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ ការពារ ប្រជាពលរដ្ឋ ណាមួយ រវល់ នឹង កិច្ចការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ ផង ណាមួយ ជួយ ប្រជាពលរដ្ឋ បង្កបង្កើន ផល កសិកម្ម ផង ណាមួយ ក៏ ជួយ ដោះស្រាយ បញ្ហា ប្រឈម នានា ជូន ប្រជាពលរដ្ឋ គ្មាន ពេល ស្រាកស្រាន្ត ។
អ្វី ដែល ប្រជាពលរដ្ឋ ទាំងនោះ ចង់ សង្កត់ធ្ងន់ នោះ គឺ ពួកគាត់ នៅតែ ជឿជាក់ លើ ការដឹកនាំ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា គណបក្ស ដែល មិន ទុក ប្រជាពលរដ្ឋ ចោល ហើយ បាន ប្ដេជ្ញា បន្ត ការគាំទ្រ តាមរយៈ សន្លឹក ឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា និង សម្ដេច តេជោ ហ៊ុន សែន បន្ត ទៀត ក្នុង ការបោះឆ្នោត ខាងមុខ ៗ ទៀត ។
ជា ការសំណូមពរ ចុងក្រោយ របស់ ប្រជាពលរដ្ឋ ដែល ជួប បញ្ហា ខាងលើ គឺ ចង់ឱ្យ ក្រុមការងារ និង មន្ត្រី ពាក់ព័ន្ធ ជួយ ពន្លឿន ការដោះស្រាយ និង ប្រគល់ គ្រឿងចក្រ របស់ ពួកគាត់ មកវិញ ឱ្យ បាន ឆាប់់ ខណៈ រដូវ បង្កបង្កើន ផល ក៏ កំពុង រំកិល ទៅ មុខ ដែល អាចនឹង ហួស ពេល ភ្ជួរ រាស់ សាប ព្រោះ ប្រសិនបើ គ្មាន គ្រឿងចក្រ ប្រើ ការ ម្យ៉ាង ប្រសិនបើ ជួល គេ ក៏ អស់ ប្រាក់ ច្រើន ជាង ប្រើ គ្រឿងចក្រ ខ្លួន ឯង ដែរ ហើយក៏ នៅតែ មិន ស្រណុកចិត្ត ទៀត ព្រោះ គ្រឿងចក្រ របស់ ខ្លួន មិន ទាន់ ដោះស្រាយ បាន ៕
ស្អែក នេះ គ.ជ. ប នឹង រៀបចំ ផ្ទៀងផ្ទាត់ សន្លឹក ឆ្នោត សម្រាប់ ការបោះឆ្នោត លើក ទី១ ជ្រើសរើស ក្រុមប្រឹក្សា ក្រុង បូក គោ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ហៅ កាត់ ថា ( គ.ជ. ប ) នឹង រៀបចំ ផ្ទៀងផ្ទាត់ សន្លឹក ឆ្នោត សម្រាប់ ការបោះឆ្នោត លើក ទី១ ដើម្បី ជ្រើសរើស ក្រុមប្រឹក្សា ក្រុង បូក គោ ខេត្ត កំពត នៅ វេលា ម៉ោង ៩ព្រឹក ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ នៅ ជាន់ ទី១ នៃ ទីស្នាក់ គ.ជ.ប ។
សម្រាប់ ការបោះ ជ្រើសរើស សមាជិក ក្រុមប្រឹក្សា ក្រុង បូក គោ ខេត្ត កំពត បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២១ គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន សំឡេង ឆ្នោត ចំនួន ១៧ លើ ១៧ ខណៈ គណបក្ស នយោបាយ ចំនួន ៣ទៀត មិន ទទួលបាន សម្លេង នោះ ឡើយ ។
ក្រុង បូក គោ ជា ក្រុង ដែល ទើប ត្រូវបាន រាជ រដ្ឋាភិបាល បាន បង្កើតឡើង ថ្មី ហើយ ដើម្បីឱ្យ ស្រប តាម ច្បាប់ ស្ដីពី ការគ្រប់គ្រង រដ្ឋបាល រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ គឺ ទើប ឈានដល់ ការរៀបចំ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ក្រុង នេះ ឡើង ក្រោម ការរៀបចំ ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ហៅ គ.ជ. ប ដែល ជា ស្ថាប័ន អព្យាក្រឹត្យ ជា អ្នករៀបចំ ធ្វើឡើង ឱ្យ ស្រប ទៅតាម ច្បាប់ កំណត់ ស្ដីពី ការគ្រប់គ្រង រដ្ឋបាល រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ។
* ទី១៖ គណបក្ស ប្រជាជន កម្ពុជា * ទី២៖ គណបក្ស យុវជន កម្ពុជា * ទី៣៖ គណបក្ស សញ្ជាតិ កម្ពុជា * ទី៤៖ គណបក្ស ហ៊្វុនស៊ិនប៉ិច ។
តំណាង លោក មេធាវី គី តិច ប្រគេន ទៀន ព្រះវស្សា ទេយ្យ ទាន និង បច្ច័យ ដល់ ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៅ វត្ត ចំនួន ២០ ក្នុង ស្រុក បាទី ខេត្ត តាកែវ
ព្រះរតន វិសុទ្ធិ ធម្ម ភង មុិញ មាន សង្ឃ ដីការបន្ត ថា ពិធី បុណ្យ ចូល ព្រះវស្សា គឺជា ពិធី បុណ្យ មួយ ដែល មាន សារៈសំខាន់ ក្នុង ព្រះពុទ្ធ សាសនា ជា ពេលវេលា ដ៏ សំខាន់ សម្រាប់ ភិក្ខុ សង្ឃ និង សាមណេ បាន រៀនធម៌ និង វិន័យ យ៉ាង ខ្ជាប់ខ្ជួន តាម ពុទ្ធ ឱវាទ ។
ពិធី បុណ្យ ចូល ព្រះវស្សា គឺជា ការរៀបចំ ឱ្យ ឈប់ សម្រាក នៅ ទី ណាមួយ ឬ ក្នុង វត្ត អារាម ណា មួយ ក្នុង រយៈពេល ៣ ខែ ក្នុង រដូវ ធ្លាក់ ភ្លៀង និង មិន អនុញ្ញាតឱ្យ និមន្ត ទៅ ទី ឆ្ងាយ ដោយ ដាច់ រាត្រី ឆ្លង ថ្ងៃ នោះ ឡើយ លើកលែងតែ មាន ភារកិច្ច សំខាន់ ចាំបាច់ ដូចជា ឪពុក ម្តាយ ឈឺ ធ្ងន់ រឺ និមន្ត ទៅ សម្តែង ធម៌ ជាដើម ដោយ តាំងចិត្ត ត្រលប់ មកវិញ ក្នុង រយៈពេល ៧ ថ្ងៃ ។
តាម ទម្លាប់ ពុទ្ធ បរិស័ទ តែងតែ នាំយក នូវ ទេយ្យ ទាន ដូច ជា៖ អង្ករ ទៀន ធូប ប្រេង ស្បង់ ចីវរ សំពត់ សាដក និង គ្រឿង សម្ភារៈ ដទៃ ទៀត ទៅ ប្រគេន ព្រះសង្ឃ តាម វត្ត អារាម ដើម្បី ផ្គត់ផ្គង់ ព្រះអង្គ ក្នុង កំឡុង ពេល នៃ ការចូល ព្រះវស្សា នេះ ។
ក្រៅពី របស់ ប្រើប្រាស់ និង ម្ហូប អាហារ បងប្អូន ខ្មែរ ក៏ បានជា វ ទាន វស្សា ទៅ ប្រគេន ព្រះសង្ឈ ផងដែរ ព្រោះ យើង មាន ជំនឿ ថា ពន្លឺ ទៀន គឺ ជួយ បំភ្លឺ អនាគត ជាតិ អោយ ភ្លឺ ស្រស់បំព្រង និង មាន សេចក្តីសុខ ចម្រើន ដោយ អំពើ ល្អ សេចក្តី ល្អ ហើយ គេ ត្រូវ រក្សា ភ្លើង ទៀន ឱ្យ ឆេះ ជាប់ រហូត គ្រប់ រយៈពេល ៣ខែ ។ មួយ វិញទៀត នេះ ជា ការជួយ ដល់ វត្ត អារាម ក្នុង ការមាន ទៀន ប្រើប្រាស់ ដើម្បី ដុត បំភ្លឺ នៅ ពេល យប់ ផងដែរ ។
សូម បញ្ជាក់ ថា ទៀន ព្រះវស្សា ទេយ្យ ទាន រួម នឹង បច្ច័យ ដែល ត្រូវ យក ទៅ ប្រគេន ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា នៅ វត្ត ចំនួន ២០ នា ពេលនេះ ក្នុង មួយ វត្ត ៗ ទទួលបាន ទៀន ព្រះវស្សា ១គូ ធំ ទឹកក្រូច ទឹក ផ្លែ ឈើ តែ និង ស្ករ ស១ ឈុត ទឹក បរិសុទ្ធ ត្រីខ មី អង្ករ ២០០ គីឡូក្រាម និង បច្ច័យ មួយចំនួន ផងដែរ ៕
រដ្ឋមន្រ្តី ការពារ ជាតិ អាមេរិក ទៅដល់ វៀតណាម ដើម្បី ព្យាយាម លើកកម្ពស់ ទំនាក់ទំនង
មុន ជំនួប ពិភាក្សា ជាមួយ រដ្ឋមន្រ្តី ការពារ ជាតិ វៀតណាម នៅ ទីក្រុង ហាណូយ លោក អូស្ទីន បាន ថ្លែង ថា សហរដ្ឋ អាមេរិក មិន បាន ស្នើឲ្យ វៀតណាម ដាច់ខាត ត្រូវ ជ្រើសរើស យក ប្រទេស ណាមួយ ឡើយ ។ ប្រមុខ ការពារ ជាតិ អាមេរិក បាន និយាយ ដូច្នេះ ថា « គោលដៅ កណ្តាល មួយ របស់ យើង គឺ ធានា ថា សម្ព័ន្ធមិត្ត ក៏ ដូចជា ដៃគូ នានា របស់ សហរដ្ឋ អាមេរិក មាន សិទ្ធិ សេរីភាព ពេញលេញ ដើម្បី កំណត់ អនាគត ដោយ ខ្លួន ឯង » ។
ខណៈ ទំនាក់ទំនង យោធា រវាង អាមេរិក និង វៀតណាម កំពុង មាន ភាព កាន់តែ ស៉ី ជម្រៅ ទៅ ៗ រដ្ឋបាល ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បាន លើកឡើង ថា វា នៅ មាន កម្រិត នៅឡើយ ក្នុង ចំណង ទាក់ទង ប្រទេស ទាំង ពីរ លុះត្រាតែ ទីក្រុង ហាណូយ សម្រេចបាន នូវ ឌ្ឍនភាព លើ បញ្ហា សិទ្ធិ មនុស្ស ។
គួរ បញ្ជាក់ ថា លោក អូស្ទីន មិន បាន លើកឡើង ចំឈ្មោះ ប្រទេស ចិន ទេ ប៉ុន្តែ បច្ចុប្បន្ន មាន ទស្សនៈ យល់ឃើញ ថា នៅ តំបន់ អាស៉ី ភាពតានតឹង រវាង សហរដ្ឋ អាមេរិក និង ចិន កំពុង កើនឡើង ដែល រហូតដល់ ថ្នាក់ អាច ត្រូវ បង្ខំ ឲ្យ ប្រទេស នីមួយ ៗ ធ្វើ ការជ្រើសរើស រវាង មហា អំណាច ទាំង ពីរ ៕
រកឃើញ បុរស ម្នាក់ វិជ្ជមាន ជំងឺ កូវីដ១៩ ពេល ទៅ ទទួល សេវា សារណៈ នៅ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ បុរស អ្នកបើកបរ រថយន្ត ដឹក ទំនិញ ម្នាក់ ត្រូវបាន រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ខណៈ រូប គាត់ បាន ទៅ រក សេវា សាធារណៈ នៅ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ ។
លោក សំ លាង ទ្រី ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង ថា បុរស តៃ កុង រថយន្ត ដែល រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ មាន ឈ្មោះ ធុង រដ្ឋា ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ រស់ នៅ ភូមិ ទ ទារ ឃុំ ចេក ក្រុង ស្វាយរៀង ខេត្ត ស្វាយរៀង ។
ដោយឡែក ចំពោះ បុរស តៃ កុង រថយន្ត បន្ទាប់ពី បាន ធ្វើតេស្ត សំណាក រក ជំងឺ កូវីដ.១៩ គឺ លទ្ធផល វិជ្ជមាន ជំងឺ កូវីដ .១៩ ភ្លាម ៗ នោះ រូបលោក ក៏ បាន ទំនាក់ទំនង ទៅ មន្ទីរ សុខាភិបាល ខេត្ត ដើម្បី ទទួល បុរស វិជ្ជមាន ជំងឺ កូវីដ. ១៩ រូប នេះ ទៅ មណ្ឌល ព្យាបាល ចំណែក អ្នក ដែល ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ដែល រួម ដំណើរ ជាមួយ បុរស រូប នេះ ត្រូវបាន នាំយក ទៅ ធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល នឹង បាន បាញ់ ថ្នាំ សម្លាប់ មេរោគ នៅក្នុង បរិវេណ មន្ទីរ ផងដែរ ។
( ភ្នំពេញ ) ៖ អាជ្ញាធរ អប្សរា និង គ្រឹះស្ថាន អង្គរ ចេញ សេចក្ដីជូនដំណឹង រួម ស្ដីពី ការបិទ ការចូល ទស្សនា ប្រាសាទ នានា និង ផ្អាក ការលក់ សំបុត្រ ការ ចូល ទស្សនា នៅក្នុង រមណីយដ្ឋាន អង្គរ រយៈពេល ១៤ ថ្ងៃ ដោយ គិត ចាប់ពី ថ្ងៃទី៣០ ខែកក្កដា ដល់ ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០២១ ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ៕
