( កំពត ) ៖ តាម របាយការណ៍ លទ្ធផល របស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពត បាន ឲ្យដឹង ថា ក្នុង ឆមាស ទី១ ឆ្នាំ ២០២១ ក្រុមការងារ ចុះ មូលដ្ឋាន បាន ដោះស្រាយ សំណូមពរ និង បញ្ហា ប្រឈម នានា ជុំវិញ ភូមិសាស្ត្រ ខេត្ត កំពត បាន ជាង ៥០០ ករណី ហើយ បញ្ហា ដែល នៅ សេសសល់ តិចតួច កំពុង បន្ត ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ ថែម ទៀត ។
ក្រុមការងារ ចុះ មូលដ្ឋាន គ្រប់ មុខ សញ្ញា គោលដៅ បាន ជួប ដោះស្រាយ និង ស្វែងរក តម្រូវការ បញ្ហា ប្រឈម និង សំណូមពរ ពី ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ឃុំ សង្កាត់ តាម បណ្ដា ក្រុង ស្រុក នីមួយ ៗ បាន ចំនួន ១៧២ លើក លើ ៩៣ ឃុំ សង្កាត់ ដោយ ប្រមូល បាន នូវ បញ្ហា សំណូមពរ ចំនួន ៥៧២ ករណី ដោះស្រាយ រួចរាល់ ចំនួន ៥៤៩ ករណី និង មិន ទាន់ បាន ដោះស្រាយ មាន ចំនួន ២៣ករណី ។
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត នៅ ថ្ងៃទី ១១ ខែកក្ត ដា ឆ្នាំ ២០២១ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ និង រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ១២៩ គ្រួសារ មកពី ឃុំ ចំនួន ៧ នៅ ស្រុក ទឹក ឈូ។ ពិធី នេះ រៀបចំ ធ្វើឡើង នៅ ទីតាំង វត្ត ពោធិ៍ ក្នុង ឃុំ ថ្មី ស្រុក ទឹក ឈូ ខេត្ត កំពត ។
លោក ជា វ តាយ ក៏ បាន ផ្តាំផ្ញើ ដល់ អាជ្ញាធរ ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ បន្ត ពិនិត្យមើល ឱ្យ បាន ច្បាស់លាស់ នូវ គ្រួសារ ដែល ងាយ រងគ្រោះ និង រង ផល ប៉ះពាល់ ដោយសារ កូវីដ១៩ ពិតប្រាកដ ដើម្បី ជួយសង្គ្រោះ ដោះស្រាយ ជូន ពួកគាត់ មិន ត្រូវ ទុកឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ អត់ អាហារ និង គ្មាន ការ ដោះស្រាយ អ្វី ឡើយ ។
ក្នុង ដំណើរ ចុះ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ ខាងលើ លោក អភិបាល ខេត្ត បាន នាំយក អំណោយ កាកបាទ ក្រហម ចែកជូន ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ និង រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ១២៩ គ្រួសារ មកពី ឃុំ ចំនួន ៧ នៅ ស្រុក ទឹក ឈូ ទទួល អំណោយ ពី កាកបាទ ក្រហម កម្ពុជា ក្នុង មួយ គ្រួសារ ទទួលបាន៖ អង្ករ ២៥ គីឡូ . មី១ កេស . ត្រីខ ១យួរ . ទឹកត្រី ១យួរ និង ថវិកា ២ម៉ឺន រៀល និង ជូន ថា វិកា ចំនួន ៤៥ ម៉ឺន រៀល ដល់ ទីប្រឹក្សា យុវជន យុវជន កាកបាទ ក្រហម អ្នកស្ម័គ្រចិត្ត កាកបាទ ក្រហម គ្រូពេទ្យ និង កងកម្លាំង ក្នុង មូលដ្ឋាន ផងដែរ ៕
មិន ថា វិស័យ ការពារ ដែន សមុទ្រ ការគ្រប់គ្រង លំហ សមុទ្រ ឬ ការស្រាវជ្រាវ រុករក បែប វិទ្យាសាស្ត្រ លើ គ្រប់ វិស័យ សុទ្ធតែ មាន នាវា ឬ យន្តហោះ ដែល ផលិត ដោយ ប្រទេស ចិន ផ្ទាល់ ។
ក្នុង ឱកាស ទិវា នាវាចរណ៍ ចិន ១១ កក្កដា សូម ទស្សនា បណ្តុំ រូបភាព ខាងក្រោម ដើម្បី ស្វែងយល់ ពី នាវា ចិន ជាមួយ គ្នា៖ រដ្ឋបាល ខេត្ត កំពង់ធំ បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ នៅ ក្រុង ស្ទឹង សែន ស្រុក សន្ទុក ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក
( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ និង ក្រុមការងារ បាន ចុះ ត្រួតពិនិត្យ ការចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ នៅ ក្រុង ស្ទឹង សែន ស្រុក សន្ទុក ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក នា ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ ។
លោក បាន លើកឡើង ថា ដំណើរការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ នេះ មាន ចំនួន ៤ក្រុង ស្រុក ដំបូង ដោយ ដំណើរការ ចាប់ពី ថ្ងៃទី ១២ ខែកក្ត ដា នេះ តទៅ ហើយ ស្រុក ៥ទៀត ដែល នៅសល់ នឹង ត្រូវ ចាក់ ក្នុង ខែសីហា ខាងមុខ ។
លោក សុខ លូ បាន បន្ថែម ថា សម្រាប់ បងប្អូន ដែល ទទួលបាន វ៉ាក់សាំង ហើយ មិន ត្រូវ មើល ស្រាល ជំងឺ កូវីដ១៩ នោះ ទេ ព្រោះ វា អាច ឆ្លង គ្រប់ ពេល បើសិនជា យើង មាន ការធ្វេសប្រហែស ហើយ យើង ត្រូវតែ បន្ត ចូលរួម អនុវត្ត វិធានការ សុខាភិបាល ឲ្យបាន ខ្ជាប់ខ្ជួន ទាំងអស់ គ្នា ពិសេស អនុវត្ត វិធានការ « ៣ការពារ និង ៣កុំ » ឲ្យបាន ទាំងអស់ គ្នា ដើម្បី ចូលរួម ទប់ស្កាត់ ការឆ្លង រាលដាល ជម្ងឺ កូវីដ១៩ ចូល សហគមន៍ ។
គួរ បញ្ជាក់ ថា ៤ក្រុង ស្រុក ដែល បាន ផ្តល់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ មាន ៣៧ ទីតាំង ក្នុង នោះ រួម មាន៖
* ទី១៖ ក្រុង ស្ទឹង សែន មាន ៦ទីតាំង ( មណ្ឌល សុខភាព ស្រយ៉ូវ. មណ្ឌល សុខភាព ដំរី ជាន់ ខ្លា. មណ្ឌល សុខភាព អាចារ្យលាក់ . មន្ទីរពេទ្យ ខេត្ត កំពង់ធំ . អនុវិទ្យាល័យ ព្រែក ស្បូវ . អនុវិទ្យាល័យ កំពង់ក្រ បៅ
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា សុង សារ៉ន ប្រធាន សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន ថ្លែង ថា បញ្ហា ដឹកជញ្ជូន នៅ ជា ឧបសគ្គ ធ្វើឲ្យ ការនាំចេញ អង្ករ កម្ពុជា ទៅ ទីផ្សារ អន្ដរជាតិ ធ្លាក់ចុះ ដោយសារ តម្លៃ ដឹកជញ្ជូន កើនឡើង ពី៥ ទៅ១០ ដង បើ ធៀប ពេល មុន មិន ទាន់ មាន បញ្ហា ជំងឺ កូវីដ១៩ ។
ការលើ ឡើង បែប នេះ ឧកញ៉ា សុង សារ៉ន ធ្វើឡើង ក្នុង កិច្ចសម្ភាស ក្នុង កម្មវិធី « ភ្ញៀវ ពិសេស ប្រចាំ សប្ដាហ៍ » លើ ប្រធានបទ « ការថយចុះ នៃ ការនាំចេញ អង្ករ កម្ពុជា ទៅ ទីផ្សារ អន្តរជាតិ » ។
ឧកញ៉ា បញ្ជាក់ ថា ប្រទេស ជឿនលឿន មួយចំនួន បាន បើក សេដ្ឋកិច្ច ធ្វើឲ្យ មាន តម្រូវការ ខ្ពស់ នៅ បណ្ដាល ប្រទេស ទាំងនោះ ។ ជាទូទៅ មិន មែន តែ ទំនិញ ស្បៀង មួយ មុខ ទេ គឺ ទំនិញ ស្ទើរតែ ទាំងអស់ ទទួល ផល រំខាន នៃ ការក្រោក ឡើងវិញ នូវ សេដ្ឋកិច្ច នេះ គឺ ធ្វើឲ្យ ប៉ះពាល់ ដល់ ទំនិញ ធុន ធ្ងន់ ដូចជា ស្រួវ - អង្ករ នេះ ដែល ពិបាក នឹង រក កុងតឺន័រ ដោយ កុងតឺន័រ មួយ ភាគ ធំ ត្រូវបាន យក ទៅ ដឹក ទំនិញ ស្រាល ៗ ដើម្បី បំពេញ សេចក្ដីត្រូវការ របស់ ប្រទេស ទាំងនោះ ។
លោក ឧកញ៉ា បន្ត ថា « តម្រូវការ បញ្ជាទិញ យើង មាន តែ យើង ជួប វិបត្តិ លើ ការដឹកជញ្ជូន ដោយ ពុំ មាន លទ្ធភាព រក កុងតឺន័រ ហើយ តម្លៃ ដឹកជញ្ជូន មាន ការកើនឡើង ពី៥ ទៅ១០ ដង ។ បើ យើង ពិនិត្យមើល ទីតាំង និង តម្លៃ កាលពី ឆ្នាំ ២០១៩ ជាពិសេស ទៅ សហគម អឺរ៉ុប មាន ការកើនឡើង ខ្លាំង ស្ទើរតែ ១០ដង បើ ធៀប មុនពេល ផ្ទុះ ជំងឺ កូវីដ១៩ » ។
ឧកញ៉ា បាន បន្ថែម ថា « ការឡើង ថ្លៃ ដឹកជញ្ជូន នេះ ធ្វើឲ្យ អ្នក បញ្ជាទិញ មួយចំនួន មាន ការស្ទាក់ស្ទើរ ព្រោះ តម្លៃ អង្ករ ស្ទើរតែ ស្មើនឹង តម្លៃ ដឹកជញ្ជូន ទៅ ហើយ ។ ជាក់ស្ដែង បើ ពិនិត្យមើល ទៅ អង្ករ ក្នុង មួយ កុងតឺន័រ ប្រហែល ១ម៉ឺន ៥ពាន់ ដុល្លារ ទៅ ២ម៉ឺន ដុល្លារ ទេ ហើយ បើ ដឹកជញ្ជូន យើង ត្រូវ បង់ អស់ ៧ ពាន់ ដុល្លារ ទៅ ១ម៉ឺន ដុល្លារ ដូច្នេះ វា ស្ទើរតែ ជិត ៥០% នៃ តម្លៃ ទំនិញ ត្រូវបាន ទូទាត់ ឲ្យ ក្រុមហ៊ុន ដឹកជញ្ជូន » ។
លោក ថា យ៉ាងណា ក៏ដោយ ក៏ នៅ មាន អ្នក បញ្ជាទិញ ប៉ុន្តែ មាន ការធ្លាក់ចុះ ព្រោះ អ្នក បញ្ជាទិញ ដែល ហ៊ាន បង់លុយ ទិញ នៅក្នុង កម្រិត នោះ គឺ មាន កម្រិត តិច ដូច្នេះ ប្រទេស មួយចំនួន គាត់ ត្រូវ ខ្សត់ ស្បៀង ដើម្បី ផ្គត់ផ្គង់ ឲ្យ ពលរដ្ឋ គាត់ ក៏ ធ្វើឲ្យ តម្លៃ អតិផរណា កើនឡើង ខ្លាំង នៅក្នុង ប្រទេស របស់ ពួកគាត់ ដូចជា សហរដ្ឋ អាមេរិក សហគម អឺរ៉ុប និង ប្រទេស មួយចំនួន មាន អតិផរណា ខ្លស់ នៅក្នុង សម័យកាល នៃ ការក្រោក ឡើង នូវ សេដ្ឋកិច្ច ។
ឧកញ៉ា លើកឡើង ថា នៅ រយៈពេល ៦ខែ ឆ្នាំ ២០២១ នេះ សហព័ន្ធ ស្រូវ អង្ករ ក្រសួង ពាណិជ្ជកម្ម និង ក្រសួង កសិកម្ម បាន ព្យាយាម បញ្ចៀស ហានិភ័យ នៃ ការធ្លាក់ចុះ នេះ ដោយ បាន សម្លឹងមើល ទៅ ទីផ្សារ ចិន ។ ៦ខែ មក នេះ កម្ពុជា បាន នាំចេញ ទៅ ចិន ជាង ៥០ ភាគរយ នៃ ចំនួន សរុប លើ ការនាំចេញ អង្ករ កម្ពុជា ការកើនឡើង ទៅ ចិន នេះ គឺ ជួយ ដល់ វិស័យ មួយចំនួន ធំ ហើយ ប្រសិនបើ គ្មាន ទីផ្សារ ចិន ទីផ្សារ អាស៊ី ទេ គឺ កម្ពុជា ពិតជា លំបាក ។
ឧកញ៉ា បន្ត ថា កម្ពុជា រង់ចាំ តែ ការដឹកជញ្ជូន តាម កុងតឺន័រ ទេ ឲ្យ ត្រឡប់មក សភាព ដើម វិញ ទេ ប្រសិនបើ មាន កុងតឺន័រ គឺ កម្ពុជា មាន លទ្ធភាព នាំចេញ បាន ភ្លាម ៗ ជាពិសេស នៅ ត្រីមាស ទី២ ឆ្នាំ នេះ តែម្ដង ។
សូម ជម្រាប ថា ឆមាស ទី១ ឆ្នាំ ២០២១ នេះ កម្ពុជា បាន នាំចេញ អង្ករ ទៅកាន់ ទីផ្សារ គោលដៅ ទាំង ៤៩ នៅលើ សកលលោក ក្នុង បរិមាណ អង្ករ សរុប ចំនួន ២៨០ ៤៥០ តោន ដែល គិត ជា ទឹកប្រាក់ ចំនួន ២០២.៦៧ លាន ដុល្លារ សហរដ្ឋ អាមេរិក ។ ការនាំចេញ ក្នុង ឆមាស ទី១នេះ បាន ធ្លាក់ចុះ ប្រមាណ ជា ២៩. ៤៧% បើ ធៀប ទៅ រយៈពេល ដូចគ្នា ក្នុង ឆ្នាំ ២០២០៕ រដ្ឋបាល ខេត្ត ស្វាយរៀង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ ឆ្លង កូវីដ១៩ នៅ ស្រុក ស្វាយ ជ្រំ
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន អំពាវនាវ ប្រជាពលរដ្ឋ ដែល មក ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ត្រូវ មក តាម ការកំណត់ របស់ អាជ្ញាធរ និង ចៀសវាង មក ប្រជ្រៀត គ្នា ធ្វើឱ្យ បាត់ សណ្ដាប់ធ្នាប់ ។
ការអំពាវនាវ បែប នេះ របស់ អភិបាល ខេត្ត ស្វាយរៀង បាន ធ្វើឡើង ក្នុង ពិធី បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ ឆ្លង កូវីដ១៩ ប្រគេន ព្រះសង្ឃ ជូន ប្រជាពលរដ្ឋ និង កម្មករ កម្មការិនី ស្រុក ស្វាយ ជ្រំ នា ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ។
លោក ម៉ែន វិបុល បាន បញ្ជាក់ ថា យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដែល បាន ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃ នេះ គឺជា ការគិតគូ ដោយ យកចិត្តទុកដាក់ បំផុត របស់ សម្តេច តេជោ ហ៊ុន សែន ជូន ដល់ ប្រជាពលរដ្ឋ ឱ្យ មាន សុខភាព មាំមួន ក្នុង ការបង្កើន ភាពស៊ាំ និង អង់ទី គ័រ ការពារ ប្រឆាំង នឹង ជំងឺ ឆ្លង រាតត្បាត កូវីដ១៩ ជាពិសេស វ៉ាក់សាំង នេះ អាច ជួយ កាត់បន្ថយ ការឆ្លង រាលដាល បាន មួយ ផ្នែក ធំ ទោះបី វា មាន ការឆ្លង ក៏ អ្នកជំងឺ មិន ធ្ងន់ធ្ងរ មិន មាន ហានិភ័យ ដល់ អាយុជីវិត នោះ ឡើយ ។
លោក បាន បន្ថែម ថា ចំពោះ ប្រជាពលរដ្ឋ ដែល ដល់ វេន មក ទទួល វ៉ាក់សាំង ត្រូវ អញ្ជើញ មក ទទួល វ៉ាក់សាំង ដូសទី១ ដោយ យក ឯកសារ មក ជាមួយ មាន ដូចជា អត្តសញ្ញាណប័ណ្ណ សៀវភៅ គ្រួសារ សំបុត្រ កំណើត ឬ ឯកសារ ពាក់ព័ន្ធ នានា ។ ម្យ៉ាងទៀត ក្រោយ ទទួលបាន វ៉ាក់ រួច ត្រូវតែ បន្ត ប្រកាន់ភ្ជាប់ នូវ វិធានការ « ៣ការពារ និង ៣កុំ » របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ឱ្យ បាន ខ្ជាប់ខ្ជួន ។
ទន្ទឹមនឹង នេះ ដែរ លោក បាន គូសបញ្ជាក់ ថា ការគិតគូរ ដ៏ ឈ្លាស វ៉ៃ និង ប៉ិនប្រសព្វ របស់ សម្តេច តេជោ ហ៊ុន សែន សម្តេច បាន ផ្តល់ វាក់ សាំង ដើម្បី ជូន ដល់ ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី ព្រះសង្ឃ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង ទៅ ដោយ ឥត គិត ថ្លៃ ហើយ នៅ ថ្ងៃ នេះ និង ជំហាន បន្ត បន្តបន្ទាប់ ទៀត នៅពេល ខាងមុខ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ស្វាយរៀង ទាំងមូល និង ទទួលបាន ការចាក់ វ៉ាក់សាំង គ្រប់ ៗ គ្នា ក្នុង ទប់ស្កាត់ នៃ ការឆ្លង ជំងឺ កូវីដ១៩ ព្រមទាំង ធ្វើឱ្យ ស្ថានភាព សេដ្ឋកិច្ច វិល ទៅរក ភាព ដើម វិញ នា ពេល ខាងមុខ ។
សូម ជម្រាប ជូន ថា យុទ្ធនាការ ចាក់ វ៉ាក់ នៅក្នុង ស្រុក ស្វាយ ជ្រំ ចាប់ផ្ដើម ពី ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ នៅ តាម ទីតាំង ដែល បាន រៀបចំ ចំនួន ១៦ ទីតាំង ៕
នៅក្នុង សេចក្តីថ្លែងការណ៍ របស់ PLA ដដែល បាន សង្កត់ធ្ងន់ ទៀត ថា « ប្រទេស ចិន អំពាវនាវ ឲ្យ សហរដ្ឋ អាមេរិក បញ្ឈប់ ជាបន្ទាន់ នូវ សកម្មភាព បង្កហេតុ របៀប ៗ នេះ » ។ យ៉ាងណា ក៏ដោយ យោធា អាមេរិក មិន ទាន់ ធ្វើ ការឆ្លើយតប ណាមួយ ចំពោះ សេចក្តីថ្លែងការណ៍ ពីសំណាក់ យោធា ចិន នេះ ឡើយ ។
ស .ស .យ . ក ស្រុក បរិបូរណ៍ ខេត្ត កំពង់ឆ្នាំង នាំ អំណោយ សប្បុរសជន ឧបត្ថម្ភ គ្រួសារ កូន ភ្លោះ ៣នាក់ នៅ ភូមិ កំពង់ ព្រះ ឃុំ ឆ្នុក ទ្រូ
( កំពង់ឆ្នាំង ) ៖ ក្រុមការងារ ស .ស .យ . ក ស្រុក បរិបូរណ៍ អាជ្ញាធរ ស្រុក និង អាជ្ញាធរ ឃុំ ឆ្នុក ទ្រូ ដឹកនាំ ដោយ លោក ផល សុភាព អភិបាល រង ស្រុក បរិបូរណ៍ និង លោក សាំង គឹម ស៊ន មេឃុំ ឆ្នុក ទ្រូ នៅ ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ សប្បុរសជន យក ទៅ ចែកជូន គ្រួសារ ក្រីក្រី កូន ភ្លោះ ៣នាក់ ។
គ្រួសារ កូន ភ្លោះ ៣នាក់ នេះ មាន ឪពុក ឈ្មោះ ឡុង ហុក សេង អាយុ ៤១ ឆ្នាំ ជនជាតិ ខ្មែរ និង ប្រពន្ធ ឈ្មោះ សេង ស្រី វ័ន្ត អាយុ ៤០ ឆ្នាំ ជនជាតិ ខ្មែរ ស្ថិត នៅ ភូមិ កំពង់ ព្រះ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូរណ៍ ខេត្ត កំពង់ឆ្នាំង ។
លោក អភិបាល រង ស្រុក ក៏ បាន បញ្ជាក់ ផងដែរ ថា បើ ទោះជា អំណោយ មាន តិចតួច ក៏ ពិត មែន តែ ក៏ អាច ជួយ ដោះស្រាយ នូវ ទុក្ខលំបាក កំពង់ខ្វះខាត ក្នុង កាលៈទេសៈ ឪពុក ម្ដាយ កំពុងតែ មើលថែ កូន តូច ៗ ដោយ មិន បាន ចេញ ទៅ រកស៊ី ឆ្ងាយ បាន ។ ជាមួយគ្នា នេះ ដែរ អាជ្ញាធរ ក៏ បាន ផ្ដាំផ្ញើ ដល់ គ្រួ សារ កូន ៣នាក់ ខាងលើ នេះ បើ មាន ការលំបាក ក្នុង ជីវភាព ឬ មាន ជំងឺ ដង្កាត់ ផ្សេង ៗ សូម រាយការណ៍ ដល់ អាជ្ញាធរ ភូមិ ឃុំ ដើម្បីឱ្យ ក្រុមការងារ ស្រុក និង ឃុំ ចុះ ដោះស្រាយ ឱ្យ បាន ទាន់ ពេល វេលា ។
អំណោយ ដែល បាន នាំយក ទៅ ចែកជូន ដល់ គ្រួសារ កូន ភ្លោះ ៣នាក់ ដែល កំពុង ជួប ការខ្វះខាត ខាងលើ នេះ ក្នុង នោះ មាន អំណោយ របស់ លោក សាន់ យូ អភិបាល រង ខេត្ត កំពង់ឆ្នាំង ១កញ្ចប់ ធំ៖ មាន ប្រេង សណ្ដែក ស្កសរ ប៊ី ចេង អំបិល អង្ករ ៤០ គីឡូក្រាម និង ថវិកា ១០០.០០០ រៀល ។
គ្រួសារ កូន ភ្លោះ ៣នាក់ ដែល បាន ទទួល អំណោយ ខាងលើ នេះ ព្រមទាំង លោកយាយ ត្រូវ ជា ជីដូន កូន ភ្លោះ ក៏ បាន ថ្លែ ងអំណរគុណ ដល់ អាជ្ញាធរ និង សប្បុរសជន ដែល ជា ម្ចាស់ អំណោយ ទាំងអស់ សុំឲ្យ ជួបប្រទះ តែ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ សមាគម ស្បែកជើង កម្ពុជា បន្ត ឧបត្ថម្ភ អាវ ពេទ្យ ម៉ាស ថ្នាំ បុរាណ ចិន និង ទឹក សុទ្ធ ដល់ រដ្ឋបាល ខេត្ត កណ្តាល ដើម្បី រួមចំណែក ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ
( កណ្តាល ) ៖ ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង កម្ពុជា នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បន្ត ដឹកនាំ សមាជិក នាំយក អំណោយ មួយចំនួន មាន ដូចជា សម្លៀកបំពាក់ ពេទ្យ ម៉ាស ទឹក សុទ្ធ និង ថ្នាំ បុរាណ ចិន ប្រគល់ជូន រដ្ឋបាល ខេត្ត កណ្តាល ដើម្បី រួមចំណែក ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នា ពេល បច្ចុប្បន្ន នេះ ។
ក្នុង ចំណោម សម្ភារៈ ទាំងអស់ គឺ សមាគម ស្បែកជើង កម្ពុជា បាន ឧបត្ថម្ភ ជូន រដ្ឋបាល កណ្តាល នូវ សម្លៀកបំពាក់ ពេទ្យ PPE ចំនួន ២.០០០ ឈុត ម៉ាស ចំនួន ១០.០០០ បន្ទះ ថ្នាំ បុរាណា ចិន ៤០០ ប្រអប់ និង ទឹក សុទ្ធ ៣៥០ កេស ផងដែរ ។
សូម ជម្រាប ថា សមាគម ស្បែកជើង កម្ពុជា តែងតែ យកចិត្តទុកដាក់ ជួយ ឧបត្ថម្ភ ដល់ រាជ រដ្ឋាភិបាល និង ប្រជាពលរដ្ឋ ខ្មែរ ដែល ទទួល រងគ្រោះ ដោយសារ ជំងឺ កូវីដ១៩ តាមរយៈ រូបភាព ផ្សេង ៗ កន្លងមក នេះ ៕ ពលរដ្ឋ ជាង ៣ម៉ឺន នាក់ នៅ ក្រុង ក្រចេះ ស្រុក ឆ្លូង និង ព្រែក ប្រសព្វ ចាប់ផ្តើម ទទួល វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ពី រដ្ឋាភិបាល
( ក្រចេះ ) ៖ រដ្ឋបាល ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ជូន ប្រជាពលរដ្ឋ រស់ នៅ ក្រុង ក្រចេះ ស្រុក ឆ្លូង និង ស្រុក ព្រែក ប្រសព្វ ប្រមាណ ជាង ៣០.០០០ នាក់ ។
យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ នេះ ធ្វើឡើង ចំនួន ៦ទីតាំង ផ្សេង ៗ គ្នា នៃ ក្រុង ស្រុក ទាំង៣ ខាងលើ រួម មាន៖
ទី ១៖ ក្រុង ក្រចេះ ត្រូវ ចាក់ នៅ ទីតាំង នៅក្នុង មន្ទីរ សុខាភិបាល ខេត្ត ក្រោយ សាលា ខេត្ត មណ្ឌល សុខភាព សង្កាត់ អូឫស្សី សាលា បឋមសិក្សា ក្រគរ និង នៅ សាលា សង្កាត់ កោះ ទ្រង់ ក្រុង ក្រចេះ ។
ទី ២៖ ស្រុក ឆ្លូង មាន ទីតាំង នៅ ការិយាល័យ សុខាភិបាល ស្រុក ប្រតិបត្តិ ឆ្លូង ។
និង ទី៣៖ ស្រុក ព្រែក ប្រសព្វ មាន ទីតាំង នៅក្នុង មន្ទីរពេទ្យ បង្អែក ស្រុក ។
បើ តាម លោក ឈ្នាង សុវត្ថា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ក្រចេះ បាន លើកឡើង ថា « នេះ ជា យុទ្ឋនា ការ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ លើក ទី៣ សម្រាប់ ខេត្ត ក្រចេះ ដែល មាន ប្រជាពលរដ្ឋ ជាង ៣ មុឺន នាក់ » ។
លោក បាន បន្ត ថា ដោយ មាន ការគិតគូ ពី ប្រមុខ ថ្នាក់ដឹកនាំ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ខិតខំ ពុះពារ ស្វះស្វែងរក វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ដល់ ប្រជាពលរដ្ឋ ដើម្បី ការពារ ពី ការចម្លង ជំងឺ កូវីដ - ១៩ ដែល កំពុងតែ យាយី ពិភពលោក ក៏ ដូចជា ប្រទេស កម្ពុជា ផងដែរ ។
ក្រសួង ការបរទេស កូរ៉េ ខាងជើង ក៏ បាន ចុះផ្សាយ ពី ការរិះគន់ របស់ លោក Kang ចំពោះ ជំនួយ អាមេរិក នៅលើ វែបសាយ ផ្លូវការ របស់ ខ្លួន ថែម ទៀត ផង កាលពី ថ្ងៃអាទិត្យ កន្លងទៅ នេះ ដែល ជា សញ្ញា យ៉ាង ជាក់ច្បាស់ ថា វា ក៏ ឆ្លុះបញ្ចាំង នូវ ទស្សន របស់ រដ្ឋាភិបាល ទីក្រុង ព្យុងយ៉ាង ផងដែរ ។
លោក Kang បាន មានប្រសាសន៍ ថា « នេះ បង្ហាញ ឱ្យ ឃើញ ច្បាស់ ថា ចេតនា របស់ សហរដ្ឋ អាមេរិក ក្នុង ការភ្ជាប់ « ជំនួយ មនុស្សធម៌ » ជាមួយនឹង « បញ្ហា សិទ្ធិ មនុស្ស » គឺ ដើម្បី ដាក់ សម្ពាធ ទៅ លើ រដ្ឋ អធិបតេយ្យ និង ដើម្បី សម្រេចបាន នូវ ផែនការ នយោបាយ ដ៏ អាក្រក់ របស់ ពួកគេ ។ នៅក្នុង ការអនុវត្ត ជាក់ស្តែង ប្រទេស ជាច្រើន បាន ភ្លក្ស រសជាតិ ល្វីង ជូរ ចត់ ដែល ជា លទ្ធផល នៃ ការសង្ឃឹម ទុក ច្រើន ពេក លើ ជំនួយ មនុស្សធម៌ និង ការជួយជ្រោមជ្រែង របស់ សហរដ្ឋ អាមេរិក » ។
គួរ បញ្ជាក់ ថា ប្រទេស កូរ៉េ ខាងជើង មិន បាន បង្ហាញ សញ្ញា ជាសាធារណៈ នៃ ការចាប់អារម្មណ៍ ទទួលយក ជំនួយ ពី កូរ៉េ ខាងត្បូង ឬ សហរដ្ឋ អាមេរិក នោះ ទេ ទោះបីជា ប្រទេស នេះ បាន ទទួលយក ជំនួយ ក្នុង កម្រិត មួយ ពី ប្រទេស ចិន និង រុស្ស៊ី ក៏ដោយ ៕
ការបង្ហាញ អំពី គោលការណ៍ នេះ បាន ធ្វើឡើង នៅក្នុង សន្និសីទ សារព័ត៌មាន រួម របស់ ក្រសួង សុខាភិបាល ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ដើម្បី ផ្សព្វផ្សាយ ពី នីតិវិធី និង យន្តការដាក់ ព្យាបាល តាម ផ្ទះ ចំពោះ អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល និង គ្មាន រោគសញ្ញា សម្រាប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។
ការអនុញ្ញាតឱ្យ ព្យាបាល នៅ តាម ផ្ទះ បាន ធ្វើឡើង ស្រប ទៅតាម វិធាន ដែល ពិភពលោក កំពុង ប្រើប្រាស់ ខណៈ ដែល ការឆ្លង ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស កម្ពុជា មាន ការកើនឡើង កាន់តែ ច្រើន ៕
( ភ្នំពេញ ) ៖ បុគ្គល ដែល លួច លាក់ បើក ខារ៉ាអូខេ ក្លឹប កម្សាន្ត សប្បាយ ល្មើស វិធានការ រដ្ឋបាល ដោយ រឹង រួស ដែល បាន ដាក់ចេញ ដោយ រដ្ឋបាល រាជធានី ភ្នំពេញ នា ដំណាក់កាល រាតត្បាត ជំងឺ កូវីដ១៩ នឹង មិន អនុញ្ញាតឱ្យ បើក អាជីវកម្ម របស់ ខ្លួន បន្ត ទៀត ជា អចិន្ត្រៃយ៍ ។ នេះ បើ តាម លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ បញ្ជាក់ នៅក្នុង សន្និសីទ កាសែត នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ។
ការបញ្ជាក់ បែប នេះ របស់ មន្ត្រី ជាន់ ខ្ពស់ រាជធានី ភ្នំពេញ បាន ធ្វើឡើង ក្រោយ មាន ម្ចាស់ ទីតាំង ខារ៉ាអូខេ ទីតាំង កម្សាន្ត មួយចំនួន តូច បន្ត លួច បើក ដំណើរការ អាជីវកម្ម របស់ ខ្លួន ដែល ល្មើស នឹង បំរាម វិធានការ រដ្ឋបាល របស់ អាជ្ញាធរ រាជធានី ភ្នំពេញ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគន៍ ២០ កុម្ភៈ ។
លោក កើត ឆែ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « អាឡូវ មិន ខ្វះ ទេ អ្នក ដែល បើក ខារ៉ាអូខេ ឈ្មោះ ហ្នឹង ទីតាំង ហ្នឹង ត្រូវបាន ដកហូត ជា អចិន្ត្រៃយ៍ អត់ ឱ្យ ប្រកប អាជីវកម្ម ហ្នឹង ទេ បញ្ជាក់ យ៉ាង ច្បាស់ ទោះ គាត់ ជួល ដី គេ ក៏ដោយ ឱ្យ តែ ឈ្មោះ ហ្នឹង មក សុំ គឺ ត្រូវបាន កត់ត្រា មិន អនុញ្ញាត មក រហូត ហើយ បើ បើក ដំណើរការខារ៉ាអូខេ លួចលាក់ ហើយ ឆ្លង ជំងឺ កូវីដ១៩ ទៅ អ្នក ផ្សេង ត្រូវ កសាង សំណុំរឿង ទៅ តុលាការ ហើយ » ។
ជាមួយគ្នា នេះ ដែរ លោក កើត ឆែ បាន លើកឡើង ថា បើ គ្មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ គឺ មិន អាច បិទ បញ្ចប់ ព្រឹត្តិការណ៍ ២០ កុម្ភៈ បាន នោះ ទេ ។
មន្ត្រី រូប នេះ បាន បន្ថែម ទៀត ថា៖ « បើ គ្មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ គឺ មិន អាច បិទ បញ្ចប់ ព្រឹត្តិការណ៍ ២០ កុម្ភៈ បាន នោះ ទេ កាលពី សប្តាហ៍ មុន នៅ ខណ្ឌ សែនសុខ អាជ្ញាធរ បាន បិទ ហាង ខារ៉ាអូខេ មួយ អញ្ចឹង កាលណា បងប្អូន ប្រជាពលរដ្ឋ មួយចំនួន គាត់ នៅតែ មិន ភ្ញាក់ រឮ ក ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ការបិទ បញ្ចប់ ព្រឹត្តិការណ៍ ២០ កុម្ភៈ មិន អាច ទៅ រួច នោះ ទេ ការបិទ បញ្ចប់ ព្រឹត្តិការណ៍ ២០ កុម្ភៈ នេះ គឺ ផ្តើម ចេញ ពី បងប្អូន ទាំងអស់ គ្នា » ។
លោក បាន បញ្ជាក់ ថា ការចូលរួម ផ្តល់ ព័ត៌មាន របស់ បណ្តាញ ផ្សព្វផ្សាយ នានា គឺ មាន សារៈសំខាន់ ខ្លាំង ណាស់ ដើម្បី ទប់ស្កាត់ ការចម្លង ជំងឺ កូវីដ១៩ នៅក្នុង សហគមន៍ និង ឈាន ទៅរក ការបិទ សបញ្ចប់ ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ ផងដែរ ។ បន្ថែម ពី នេះ ការចូលរួម ពីសំណាក់ ប្រជាពលរដ្ឋ គឺជា វិធានការ ដ៏ មាន ប្រសិទ្ធភាព និង ស័ក្តិសិទ្ធភាព ក្នុង បញ្ចប់ ព្រឹត្តិការណ៍ ២០កុម្ភៈ នេះ ជាដើម ។
សូម ជម្រាប ថា រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ កន្លងទៅ បាន ចេញ សេចក្ដីសម្រេច ដាក់ចេញ នូវ វិធានការ រដ្ឋបាល ដោយ ផ្អាក ជា បណ្ដោះអាសន្ន ចំពោះ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ដែល មាន ហានី ភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ និង ការជួបជុំ ឬ ការប្រមូលផ្ដុំ មនុស្ស ជា លក្ខណៈ ឯកជន ក្នុង ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ សម្រាប់ រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ម៉ោង សូន្យ ថ្ងៃទី ១០ ខែកក្កដា រហូតដល់ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២១ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ទៀត ថា ក្នុង អំឡុង ពេល នៃ ការដាក់ចេញ វិធានការ រដ្ឋបាល ត្រូវបាន ផ្អាក ជា បណ្ដោះអាសន្ន ការជួបជុំ ឬ ការប្រមូលផ្ដុំ មនុស្ស ជា លក្ខណៈ ឯកជន ដែល មាន លក្ខណៈ កុះក រក កកុញ មិន ឱ្យ លើស ទី ១៥នាក់ លើកលែងតែ ចំពោះ ករណី ដូច មាន កំណត់ នៅក្នុង ប្រការ៣ នៃ សេចក្ដីសម្រេច នេះ ៕ រដ្ឋបាល ខេត្ត បាត់ដំបង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ពលរដ្ឋ នៅ ក្រុង បាត់ដំបង
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង និង មន្ទីរ សុខាភិបាល ខេត្ត នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ ពលរដ្ឋ ទាំង ១០សង្កាត់ ក្រុង បាត់ដំបង ចំនួន ១០ម៉ឺន ដូស នៅ តាម ទីតាំង ចំនួន ៨កន្លែង ជា ជំហាន ៗ និង បន្ត ទៅ ចាក់ នៅ ស្រុក ផ្សេង ៗ ទៀត ទូទាំង ខេត្ត រយៈពេល ១ ខែ រហូត ទាល់តែ អស់ ។
យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ នេះ ធ្វើឡើង ក្រោម វត្តមាន លោក ងួន រតនៈ អភិបាល ខេត្ត អភិបាល រង ខេត្ត លោក ឱសថ បណ្ឌិត វឿង ប៊ុន រ៉េត ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត លោក ផេង សិទ្ធី អភិបាល ក្រុង បាត់ដំបង និង ថ្នាក់ដឹកនាំ ខេត្ត ក្រុង មន្ទីរ ពាក់ព័ន្ធ ចៅសង្កាត់ ទាំង១០ ជាដើម ។
បើ តាម លោក ឱសថ បណ្ឌិត វឿង ប៊ុន រ៉េត បាន ឱ្យដឹង ថា៖ « បន្ទាប់ពី បាន ទទួល វ៉ាក់សាំង ពី ក្រសួង សុខាភិបាល ចំនួន ១០ម៉ឺន ដូស នេះ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង សង្កាត់ ទាំង១០ នៃ ក្រុង បាត់ដំបង គឺ យើង បាន ចាប់ផ្តើម អនុវត្ត ពី ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ ហើយ យុទ្ធនាការ នេះ មាន រយៈ១ ខែ ចំពោះ នៅ តាម បណ្តា ស្រុក ផ្សេង ៗ ទៀត នៃ ខេត្ត បាត់ដំបង » ។
បន្ថែម ពី នេះ លោក ងួន រតនៈ បាន បន្ត ថា សម្រាប់ រដ្ឋបាល ខេត្ត បាត់ដំបង បន្ទាប់ពី បាន បើក យុទ្ធនា ចាក់ វ៉ាក់សាំង លើ ដំបូង ចាប់តាំងពី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២១ កន្លងមក ដោយ បាន អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល គឺ បាន ចាក់ ជូន មន្រ្តី រាជការ ដែល ជា បុគ្គល មាន អាទិភាព ព្រមទាំង កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ជា ជំហាន ៗ ជា បន្ទាប់ រហូត មក បាន ជោគជ័យ ។
ជាមួយគ្នា នេះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន អំពាវនា ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ នាំគ្នា ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នេះ ដោយ នាំ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ « ៣កុំ និង ៣ការពារ » របស់ រាជ រដ្ឋាភិបាល ឱ្យ បាន គ្រប់ ៗ គ្នា ៕ រដ្ឋមន្ត្រី មុខងារ សាធារណៈ កំពុង ដឹកនាំ រៀបចំ ផែនការពង្រឹង សេវា សាធារណៈ ដើម្បី ឆ្លើយតប នឹង ការកសាង ទីក្រុង វៃ ឆ្លាត ភ្នំពេញ ក្រុង សៀមរាប ក្រុង បាត់ដំបង
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បា ន ជ្រើសរើស យក ទីក្រុង ចំនួន ៣ ក្នុង ការរៀបចំ កសាង ឱ្យ ក្លាយជា ទីក្រុង ឆ្លាតវៃ រួម មាន រាជធានី ភ្នំពេញ ក្រុង បាត់ដំបង នៃ ខេត្ត បាត់ដំបង និង ក្រុង សៀមរាប នៃ ខេត្ត សៀមរាប ដើម្បី ចូលរួម គំនិត ផ្តួចផ្តើម ក សាង បណ្តាញ ទីក្រុង ឆ្លាត សម្រាប់ ប្រទេស សមាជិក អាស៊ាន ទាំង ១០ ។
អង្គការ សហ ប្រជាជាតិ បាន ប៉ាន់ស្មាន ថា រហូតដល់ ឆ្នាំ ២០៥០ គឺ មាន ប្រជាជន ២ ភាគ ៣ នៃ ប្រជាជន នៅក្នុង ប្រទេស នីមួយ ៗ នឹង ចូលមក រស់ នៅក្នុង ទីក្រុង ។ ដូច្នេះ ទីក្រុង ត្រូវ កសាង ទៅជា ទីក្រុង ឆ្លាត ដើម្បី អាច បន្ត ភាព ស្ថិត ស្ថិរ និង ការអភិវឌ្ឍ បន្ត ទៀត បាន ។ នេះ បើ តាម ការរំឭក របស់ លោក រដ្ឋមន្ត្រី ។
នៅក្នុង ពិធី បើក សិក្ខាសាលា នេះ ដែរ លោក មន្ត្រី ព្រុំ សុខា បាន លើកឡើង នៅ ចំណុច សំខាន់ ៗ ចំនួន ៣ ជូន ដល់ អង្គ សិក្ខាសាលា រួម មាន៖
ទី ១៖ អំពី ទីក្រុង ឆ្លាត ។
ទី២៖ ការដឹកនាំ រដ្ឋបាល សាធារណៈ ឬ ការដឹកនាំ គ្រប់គ្រង ដើម្បី កសាង ទីក្រុង ឆ្លាត ដែល ចាត់ទុក ជា ផ្នែក មួយ នៃ កំណែទម្រង់ រដ្ឋបាល សាធារណៈ ដែល កម្ពុជា កំពុងតែ ដំណើរការ ។
ទី ៣៖ តើ ទីក្រុង ឆ្លាត ត្រូវការ សេវា សាធារណៈ ឬ ការផ្តល់ សេវា សាធារណៈ បែប ណា សម្រាប់ ទីក្រុង ឆ្លាត ។
គួរ បញ្ជាក់ ថា សិក្ខាសាលា នេះ រៀបចំឡើង ក្រោម កិច្ចសហការ រវាង សាលា ភូមិន្ទ រដ្ឋបាល នៃ ក្រសួង មុខងារ សាធារណៈ និង មូលនិធិ Temasek អន្តរជាតិ របស់ សិង្ហបុរី តាមរយៈ គម្រោង កសាង ក្របខណ្ឌ សមត្ថភាព ដឹកនាំ សម្រាប់ ថ្នាក់ដឹកនាំ កម្រិត អគ្គ នាយក អគ្គ នាយក រង និង ថ្នាក់ ប្រហាក់ប្រហែល ៕ ក្រសួង ឧស្សាហកម្ម ចាប់ផ្តើម អនុវត្ត ការធ្វើតេស្តរហ័ស ទ្រង់ទ្រាយ ធំ ជា លើក ទី១ ជូន ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ក្រោម ឱវាទ
( ភ្នំពេញ ) ៖ ដេីម្បី ចូលរួម អនុវត្ត តាម ប្រសាសន៍ ណែនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក្នុង កិច្ចប្រជុំ ពេញ អង្គ គណ: រដ្ឋមន្រ្តី នា ពេល កន្លងទៅ ថ្មី ៗ នេះ ស្តីពី លទ្ធភាព ត្រៀម បម្រុង ការធ្វើតេស្ដរហ័ស ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រី ក្រោម ឱវាទ នៃ ក្រសួង - ស្ថាប័ន សុី វិល ក្នុង គោលដៅ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ការគិតគូ ខ្ពស់ ដល់ សុខភាព សាធារណ: និង ឈាន ទៅ កាត់ផ្តាច់ការចម្លង ដែល កំពុង បាត់ ដាន នោះ ។
ក្រៅពី នោះ ដោយ ទទួលបាន ជំនួយ ពី ប្រភព ផ្សេង ៗ បូក និង ជំនួយ ផ្ទាល់ របស់ លោក កិត្តិ សេដ្ឋា បណ្ឌិត និង លោកស្រី គឺ បាន ឧបត្តម្ភ ជា ម៉ាស់ ជា អាល់កុល ជា ថវិកា និង គ្រឿង ឧបភោគ - បរិភោគ ដល់ តំបន់ គោលដៅ មួយចំនួន ដូចជា សាលា រាជធានី ភ្នំពេញ ខេត្ត កែប ខេត្ត កំពត និង រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ជា ដេីម ៕ លោក ម៉ឹង មករា នាំយក ទេយ្យ ទាន របស់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ប្រគេន ដល់ ព្រះសង្ឃ គង់ នៅ ចំនួន ១៦វត្ដ ក្នុង ស្រុក ជើង ព្រៃ ខេត្ដ កំពង់ចាម
( កំពង់ចាម ) ៖ សមាគម យុវជន ក្រុម៨ តាមរយៈ លោក បណ្ឌិត ម៉ឹង មករា បាន នាំយក បច្ច័យ ទេយ្យ ទាន និង ស្បៀងអាហារ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ប្រគេ ព្រះសង្ឃ ដែល នៅ ចំនួន ១៦វត្ត នៅ ស្រុក ជើង ព្រៃ ខេត្ដ កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ។
សូម ជម្រាប ថា បច្ចុប្បន្ន សមាគម យុវជន ក្រុម៨ ក្រោម ការដឹកនាំ របស់ លោបណ្ឌិត ម៉ឹង មករា បាន រួមចំណែក ក្នុង ការជួយ ដល់ កិច្ចការ មនុស្សធម៌ ជាច្រើន មាន ដូចជា វិស័យ សុខាភិបាល វិស័យ អប់រំ វិស័យ ក សកម្ម និង ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ ជូន ប្រជាពលរដ្ឋ នៅ ជនបទ រួម មាន ការកសាង ផ្លូវថ្នល់ សាលារៀន មន្ទីពេទ្យ វត្ត អារាម ទំនប់ ទឹក ប្រលាយ ទឹក ស្រះ ទឹក ការដាំ កូន ឈើ លម្អរ អម សងខាង ផ្លូវ ព្រមទាំង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្សេង ៗ ទៀត ។
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២១ បាន បន្ត រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ សរុប ១៦១ នាក់ ទៀត ខណៈ អ្នកជំងឺ ២នាក់ ស្លាប់ និង ជាសះស្បើយ ថ្មី ៥៥នាក់ ។
យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត សៀមរាប បាន ឱ្យដឹង ថា អ្នកវិជ្ជមាន ថ្មី នេះ ករណី ទី១ ដល់ ទី៣៤ ជា ករណី មាន ប្រភព ចម្លង ចេញ ពី ផ្សារ លើ ធំ ថ្មី ។ ករណី ទី៣៥ ដល់ ទី ៤១ ជា ករណី មាន ប្រភព ចម្លង ចេញពី សង្កាត់ ស្រង៉ែ និង ករណី ទី ៤២ ជា ករណី ឆ្លង មាន ប្រភព ចម្លង ចេញ ពី ផ្សារ ដំដែក ។
ករណី ទី១៣១ ដល់ ទី១៤៧ គឺជា ករណី ពុំ ទាន់ អាច សន្និដ្ឋាន ពី ប្រភព ចម្លង ច្បាស់លាស់ នៅឡើយ ។ ចំពោះ ករណី ទី១៤៨ ដល់ ទី១៦១ គឺជា ប្រជាពលរដ្ឋ ត្រឡប់ ពី ប្រទេស ថៃ មកដល់ ខេត្ត សៀមរាប ហើយ ជា ករណី សង្ស័យ ត្រូវបាន ក្រុម គ្រូពេទ្យ ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក នៅ វិទ្យាល័យ សម្តេច ឪ ។
ដោយឡែក អ្នកជំងឺ ដែល ជាសះស្បើយ ទាំង ៥៥នាក់ ត្រូវ ក្រុម គ្រូពេទ្យ បាន អនុញ្ញាតឱ្យ ចេញ ពី មន្ទីរពេទ្យ បង្អែក ខេត្ត និង មន្ទីរពេទ្យ បង្អែក ស្រុក សូទ្រនិគម ត្រឡប់ ទៅ លំនៅឋាន វិញ ដោយ ត្រូវ បន្ត ការធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ។
ករណី ស្លាប់ អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ២នាក់ រួម មាន៖ ទី១៖ ឈ្មោះ តូច សត្យា ភេទ ប្រុស អាយុ ៤៩ ឆ្នាំ អាសយដ្ឋាន ភូមិ ទ្រាំង សង្កាត់ ស្ល ក្រាម ក្រុង សៀមរាប ដែល បាន រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ - ១៩ នៅ ថ្ងៃទី ៧ ខែកក្កដា និង បាន ស្លាប់ នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២១ វេលា ម៉ោង ១៥៖ ០៥នាទី ដោយសារ ជំងឺ រលាក សួត បង្ក ដោយ មេរោគ កូវីដ - ១៩ ។
ទី២៖ ឈ្មោះ ម៉ាប់ សុខុម ភេទ ស្រី អាយុ ៥៨ ឆ្នាំ អាសយដ្ឋាន ភូមិ គោក ដូង ឃុំ ពួក ស្រុក ពួក ខេត្ត សៀមរាប ដែល បាន រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ - ១៩ នៅ ថ្ងៃទី ១០ ខែកក្កដា និង បាន ស្លាប់ នៅ ថ្ងៃទី ១១ ខែកក្កដា វេលា ម៉ោង ១៦៖១០នាទី ដោយសារ ជំងឺ រលាក សួត បង្ក ដោយ មេរោគ កូវីដ - ១៩ ។
សូម បញ្ជាក់ ថា មកទល់ ពេលនេះ ខេត្ត សៀមរាប មាន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ២. ៤៤១នាក់ ។ ក្នុង នោះ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ៨១៨ នាក់ ស្លាប់ ២៤ នាក់ និង ១. ៥៩៩ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប មណ្ឌល ចត្តាឡី ស័ក គរុកោសល្យ និង វិក្រឹត ការ ខេត្ត វិទ្យាល័យ អង្គរ និង វិទ្យាល័យ ដំ ដែក ៕
ចំណេះដឹង ទូទៅ៖ តើ ផែនដី យើង វិល បាន ប៉ុន្មាន បែប ?
ទាំង ផែនដី និង ព្រះច័ន្ធ សុទ្ធតែ គោចរ ជុំវិញ ចំណុច ទំនាញ ដូចគ្នា ដូច ៗ គ្នា ដែល នៅ ជ្រៅ ចុះ ទៅ ក្រោម ផ្ទៃ ផែនដី ប្រហែល ១.៦០០ គីឡូម៉ែត្រ ។ ចលនា រង្វិល ទាំងនេះ គឺ កើតឡើង ដោយសារតែ មាន ទំនាញ ។
លោក អ៉ីសាក់ ញូតុន ដែល ជា ប្រាជ្ញ រកឃើញ ច្បាប់ ទំនាញ នោះ ក៏ ធ្លាប់ និយាយ ដែរ ថា គ្រាន់តែ ចលនា បម្លាស់ ទី របស់ ព្រះច័ន្ទ លោក ក៏ ឈឺ ក្បាល ណាស់ ទៅ ហើយ ៕
សន្និសីទ នេះ ត្រូវបាន រៀបចំឡើង ដើម្បី ផ្សព្វផ្សាយ ពី នីតិវិធី និង យន្តការដាក់ ព្យាបាល តាម ផ្ទះ ចំពោះ អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល និង គ្មាន រោគសញ្ញា សម្រាប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។
លោក កើត ឆែ បាន អះអាង ថា អាជ្ញាធរ រាជធានី ភ្នំពេញ នៅតែ អាច គ្រប់គ្រង បាន នូវ ការបូជា សព អ្នកជំងឺ កូវីដ១៩ នេះ ។ លោក បាន ឱ្យដឹង ទៀត ថា នៅ ពេល នេះ សាកសព អ្នក ដែល ស្លាប់ ដោយ ជំងឺ កូវីដ១៩ នៅសល់ ប្រមាណ ជា ៥០ សាកសព នៅក្នុង ទូរក្លាសេស្ស សព ។ ប៉ុន្តែ លោក ថា ចំនួន នេះ បាន ធ្លាក់ចុះ ច្រើន ហើយ ព្រោះ កាលពី សប្តាហ៍ មុន សាកសព មិន ទាន់ បូជា នៅ កកស្ទះ ប្រមាណ ជាង ១០០ សាកសព ឯណោះ ។
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ អាជ្ញាធរ រាជធានី ភ្នំពេញ បាន យក សព អ្នកស្លាប់ ដោយ ជំងឺ កូវីដ១៩ ទៅ បូជា នៅ វត្ត ចំនួន ៣ នៅក្នុង រាជធានី ភ្នំពេញ គឺ វត្ត ទឹក ថ្លា វត្ត ឫស្ស៊ី សាញ់ និង វត្ត មួយ ទៀត នៅ ខណ្ឌ ព្រែក ព្នៅ ។
បើ តាម លោក កើត ឆែ បាន គូសបញ្ជាក់ ថា ការសម្រេច បូជា សព នៅក្នុង វត្ត ទាំង៣ នេះ គឺ ដោយសារតែ កន្លែង បូជា សព នៅក្នុង ខេត្ត កំពង់ស្ពឺ ពុំ ទាន់ មាន ហេដ្ឋារចនាសម្ព័ន្ធ និង ទីតាំង មាន ចង្ងាយ ឆ្ងាយ ពី រាជធានី ភ្នំពេញ ។ ខណៈ នៅក្នុង សប្តាហ៍ នេះ អាជ្ញាធរ រាជធានី ភ្នំពេញ នឹង ទទួលបាន ម៉ាស៊ីន បូជា សព អេឡិចត្រូនិក២ គ្រឿង ដែល បញ្ជាទិញ ពី ក្រៅ ប្រទេស ហើយ ម៉ាស៊ីន ទាំង២ នេះ នឹង បំពាក់ នៅក្នុង វត្ត ដែល មិន សូវ មាន ប្រជាជន រស់ នៅ អ៊ូអរ ដើម្បី បូជា សព ឱ្យ ទាន់ ទៅ តាម ស្ថានភាព ជាក់ស្តែង ។
អភិបាល រង រាជធានី ភ្នំពេញ រូប នេះ បាន ឱ្យដឹង ថា ចំពោះ ការបញ្ចុះ សព អ្នក ដែល ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ នេះ អភិបាល រាជធានី ភ្នំពេញ គ្រោង នឹង ដឹកនាំ កិច្ចប្រជុំ នៅក្នុង សប្តាហ៍ ហើយ នឹង ជម្រាប ជូន លក្ខខណ្ឌ នៃ ការបញ្ចុះ សាកសព ដែល កើត ជំងឺ កូវីដ១៩ នេះ ខណៈ ក្រសួង សុខាភិបាល បាន សរសេរ លក្ខខណ្ឌ នេះ បាន មួយចំនួន ហើយ តាម លក្ខណៈ បច្ចេកទេស សុខាភិបាល ប៉ុន្តែ អាជ្ញាធរ រាជធានី ភ្នំពេញ នឹង រៀបចំ កិច្ចការងារ បន្ថែម ទៀត ដើម្បី បំពេញ សហការ ជាមួយ ក្រសួង សុខាភិបាល ធ្វើ ការងារ ឱ្យ បាន រលូន ជាដើម ។
លោក កើត ឆែ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « មកដល់ បច្ចុប្បន្ន នេះ យើង ឈាន ទៅដល់ ការគ្រប់គ្រង បាន ចំពោះ សាកសព ដែល ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ ហើយ ទីតាំង ឈាប នដ្ឋាន មាន នៅ ភ្នំពេញ រួចហើយ យើង នឹង សុំ ទៅ រាជ រដ្ឋាភិបាល ដើម្បី បំពាក់ នៅ រាជធានី ភ្នំពេញ បន្ថែម ទៀត ... ! មាន ការណែនាំ ពី ក្រសួង សុខាភិបាល បើ មាន ការស្នើសុំ ពី ក្រុមគ្រួសារ អនុញ្ញាតឱ្យ មាន ការបញ្ចុះ សព ដែរ ប៉ុន្តែ ត្រូវតែ អនុវត្ត តាម វិធានការ សុខាភិបាល ហើយ កិច្ចការ នេះ » ។
« អភិបាល រាជធានី ភ្នំពេញ នឹង ធ្វើ ការដឹកនាំ កិច្ចប្រជុំ នៅក្នុង សប្តាហ៍ នេះ ដើម្បី សរសេរ នីតិវិធី លម្អិត ចំពោះ សាកសព ចំនួន ដែល សាច់ញាតិ គាត់ ស្នើសុំ បញ្ចុះ ត្រូវ ធ្វើ យ៉ាងម៉េច ? បាទ យើង នឹង អនុញ្ញាតឱ្យ គាត់ បញ្ចុះ ដែរ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី បាន អនុញ្ញាត ឱ្យ ធ្វើ ការបញ្ចុះ ប៉ុន្តែ ត្រូវ អនុវត្ត តាម វិធាន សុខាភិបាល ដើម្បី ធ្វើ យ៉ាងណា ឆ្លង ជំងឺ កូវីដ១៩ » ។ នេះ បើ តាម លោក កើត ឆែ ។
ជាមួយគ្នា នេះ ដែរ មន្ត្រី ជាន់ ខ្ពស់ រាជធានី ភ្នំពេញ រូប នេះ បាន បញ្ជាក់ ថា ការអនុញ្ញាតឱ្យ ក្រុមគ្រួសារ យក សព អ្នកជំងឺ កូវីដ១៩ ទៅ បូជា ដោយ ខ្លួន ឯង នេះ ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន នាយ រកដ្ឋមន្រ្តី នៃ កម្ពុជា ឯកភាព រួចរាល់ ប៉ុន្តែ ក រុម គ្រួសារ សព ត្រូវ គោរព តាម ការណែនាំ និង វិធានការ ការពារ ផ្សេង ៗ ដើម្បី ចៀសវាង កុំ មាន ការឆ្លង ជំងឺ កូវីដ១៩ ទៅកាន់ អ្នកដទៃ ក្នុង ពេល បូជា ៕
រដ្ឋមន្រ្តី កសិកម្ម ស្នើ ក្រុមហ៊ុន សម្បទាន ដី សេដ្ឋកិច្ច ទាំងអស់ ឱ្យ ផ្អាក ការចេញ ចូល រាល់ បុគ្គលិក ជនជាតិ វៀតណាម ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ស្នើ ដល់ ក្រុមហ៊ុន សម្បទាន សេដ្ឋកិច្ច ទាំងអស់ របស់ វៀតណាម ឱ្យ ផ្អាក រាល់ ការចេញ ចូល កម្ពុជា ជាបណ្តោះអាសន្ន ចំពោះ បុគ្គលិក កម្មករ ជនជាតិ វៀតណាម ទាំងអស់ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
ប្រទេស វៀតណាម ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ នេះ បាន រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ក្នុង អត្រា មួយ ខ្ពស់ គឺ ឈានដល់ ខ្ទង់ ជាង ពាន់ នាក់ ។ ជាពិសេស នៅក្នុង ទីក្រុង ហូជីមិញ ដែល នាំឱ្យ អាជ្ញាធរ ចាត់ វិធានការបិទ ទីក្រុង នេះ ថែម ទៀត ផង ។
« ស្ពាន អាកាស យក្ស » បាន បញ្ជូន ជីវភាព ធូរធារ បង្គួរ ទៅដល់ មាត់ទ្វារ កសិករ ចិន
ផ្លូវ ស្រួល ហើយ អាជីវកម្ម គ្រប់ យ៉ាង នឹង រីកចម្រើន ។ តំបន់ ក្រីក្រ ភាគ ច្រើន នៅ ចិន មិន ខ្វះ ធនធាន ទេ ក៏ប៉ុន្តែ ដោយសារ ផ្លូវ ចេញ ចូល មិន ល្អ ការដឹកជញ្ជូន ជួប នឹង ភាពពិបាក មហាជន ទៅ ខាងក្រៅ មិន កើត បណ្តាលឱ្យ មាន ជីវភាព រស់ នៅ ក្រ លំបាក ។ បើ ចង់ លុបបំបាត់ ភាពក្រីក្រ និង បង្កើន ប្រាក់ ចំណូល សំខាន់ ត្រូវ កែលម្អ លក្ខខណ្ឌ ហេដ្ឋារចនាសម្ព័ន្ធ ។
សូម បញ្ជាក់ ថា ចាប់ពី សមាជ បក្ស កុម្មុយនិស្ត ចិន លើក ទី១៨ មក ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ នៅ ជនបទ ចិន ជាពិសេស តំបន់ ជនបទ ក្រីក្រ ចិន បាន ដំណើរការ ក្នុង ល្បឿន លឿន និង ប្រកបដោយ គុណភាព ខ្ពស់ ។ គិត ត្រឹម បច្ចុប្បន្ន បណ្តាញ ផ្លូវថ្នល់ តភ្ជាប់ ជន បទ ទូទាំង ប្រទេស ចិន មាន ប្រវែង សរុប លើស ពី ៤២០ ម៉ឺន គីឡូម៉ែត្រ ភូមិ ឃុំ ១០០ % មាន ផ្លូវ បេតង់ ទទួលបាន សេវា ដឹកជញ្ជូន មនុស្ស ខណៈ សេវា ដឹក ទំនិញ ដល់ ផ្ទះ បាន គ្របដណ្តប់ ភូមិ ចំនួន ជាង ៥៥ម៉ឺន ៦ពាន់ នៃ ទូទាំង ប្រទេស ។
រូបភាព ឯកសារ នៃ ទីភ្នាក់ងារ ស៊ីន ហួរ៖
រដ្ឋបាល ថ្មី ខេត្ត កំពង់ឆ្នាំង ចេញ ចំណាត់ការ អាជីកម្ម ពុះ ដីឡូតិ៍ ដែល គ្មាន ច្បាប់ អនុញ្ញាត ដើម្បី កំណត់ ឲ្យ ប្រើប្រាស់ ដី បាន ត្រឹមត្រូវ និង ចំ ទិសដៅ
( កំពង់ឆ្នាំង ) ៖ លោក ស៊ុន សុវណ្ណា រិទ្ធ អភិបាល ខេត្ត កំពង់ឆ្នាំង ថ្មី បាន បើក កិច្ចប្រជុំ ពិនិត្យ និង ពិភាក្សា ករណី អាជីវករ ធ្វើ អាជីវកម្ម ពុះ ដីឡូត៍ លក់ ដែល គ្មាន ច្បាប់ អនុញ្ញាត ដើម្បី ជំរុញ ឱ្យ ការរៀបចំ ប្រើប្រាស់ ដី ឱ្យ បាន ត្រឹមត្រូវ ចំ ទិសដៅ និង ដើម្បី ធានា ឱ្យ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក សាន់ យូ អភិបាល រង ខេត្ត លោក នាយក រង រដ្ឋបា ល សាលា ខេត្ត មន្ទីរ ជំនាញ ពាក់ព័ន្ធ និង លោក អភិបាល ក្រុង ស្រុក ទាំង៨ ផងដែរ នៅ សាល ប្រជុំ សាលា ខេត្ត កំពង់ឆ្នាំង
យោង តាម ស្មារតី ក្នុង កិច្ចប្រជុំ គឺ គោលបំណង សំខាន់ ដើម្បី ផ្សព្វផ្សាយ អំពី ខ្លឹមសារ ច្បាប់ និង គោលការណ៍ ណែនាំ នានា ដើម្បី អាជ្ញាធរ និង ជំនាញ ពាក់ព័ន្ធ យក ទៅ អនុវត្ត ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ដល់ ម្ចាស់ អាជីវកម្ម អភិវឌ្ឍ ដីឡូតិ៍ ឱ្យ គោរព និង អនុវត្ត តាម ។
ជំរុញ ការធ្វើ បច្ចុប្បន្នភាព ឡើងវិញ ចំពោះ គម្រោង អាជីវកម្ម នៅ ទូទាំង ខេត្ត ។ ពង្រឹង អាជ្ញាធរ និង ជំនាញ ពាក់ព័ន្ធ ឱ្យ អនុវត្ត ភារកិច្ច ក្នុង ដែន សម្ថកិច្ច របស់ ខ្លួន ( ការផ្តល់ សេវា ) ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ និង ដំណើរការ គ្រប់គ្រង គម្រោង អភិវឌ្ឍន៍ ដីឡូតិ៍ ឱ្យ បាន ស្រប តាម ច្បាប់ និង គោលការណ៍ ។
សិក្សា ពី ផែនការ យុទ្ធសាស្ត្រ ក្នុង ការរៀបចំ ប្លង់ គោល ប្រើប្រាស់ ដី នៅ ថ្នាក់ ក្រុង ស្រុក និង ផែនការប្រើប្រាស់ ដី នៅ ឃុំ / សង្កាត់ ដើម្បី ជម្រុញ ឱ្យ ការរៀបចំ ប្រើប្រាស់ ដី ឱ្យ បាន ត្រឹមត្រូវ ចំ ទិសដៅ និង ដើម្បី ធានា ឱ្យ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
កិច្ចប្រជុំ ពិនិត្យ និង ពិភាក្សា ករណី អាជីវករ ធ្វើ អាជីវកម្ម ពុះ ដីឡូលក់ ដោយ គ្មាន ច្បាប់ អនុញ្ញាត ដែល ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព របស់ លោក ស៊ុន សុវណ្ណ រិទ្ធ ដែល ទើបនឹង ឡើង កាន់ តំណែង ថ្មី ខាងលើ នេះ គឺ មាន ការគាំទ្រ និង អបអរសាទរ ពី សាធារណៈ ជន នៅក្នុង ខេត្ត កំពង់ឆ្នាំង ក្នុង ការជំរុញ ឱ្យ មាន ការធ្វើ បច្ចុប្បន្នភាព ឡើងវិញ ចំពោះ គម្រោង អាជីវកម្ម នៅ ទូទាំង ខេត្ត កំពង់ឆ្នាំង ខាងលើ នេះ ៕
លោក ឯ ម ច័ន្ទ មករា បើក វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី វិធីសាស្ត្រ ប្រទាក់ ប្រទង និង លក្ខខណ្ឌ នានា សម្រាប់ ការអភិវឌ្ឍ ពិការ ភាព ប្រកបដោយ បរិយា បន្ន
( ភ្នំពេញ ) ៖ លោក ឯ ម ច័ន្ទ មករា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ បាន រៀបចំ បើក បើក វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី វិធីសាស្ត្រ ប្រទាក់ ប្រទង និង លក្ខខណ្ឌ នានា សម្រាប់ ការអភិវឌ្ឍ ពិការ ភាព ប្រកបដោយ បរិយា បន្ន តាម ប្រព័ន្ធ វីដេអូ នា ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ ។
លោក ឯ ម ច័ន្ទ មករា បាន លើកឡើង ថា វគ្គ បណ្តុះបណ្តាល នេះ ដល់ តំណាង មន្ត្រី រដ្ឋាភិបាល ដៃគូ អភិវឌ្ឍន៍ អង្គការ តំណាង ជន មាន ពិការ ភាព វេទិកា ស្រ្តី មាន ពិការភាព និង អង្គការ សង្គម ស៊ីវិល ដែល ធ្វើ ការងារ ពាក់ព័ន្ធ នឹង វិស័យ ពិការ ភាព ក្នុង ប្រទេស កម្ពុជា ក្នុង គោលបំណង ផ្តល់ ជូន អ្នកចូលរួម អាច៖
* ទី១៖ យល់ ច្បាស់ ពី វិធី អនុវត្ត អនុសញ្ញា សិទ្ធិ ជន ពិការ និង គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ដែល មាន បរិយា បន្ន ពិការភាព ទៅក្នុង ការអនុវត្ត ឆ្លើយតប នឹង កាតព្វកិច្ច របស់ រដ្ឋ ភាគី ។
* ទី២៖ យល់ ច្បាស់ ពី ទ្រឹស្តី នៃ ការផ្លាស់ប្តូរ របស់ អង្គការ សហ ប្រជាជាតិ ក្នុង ភាពជាដៃគូ ដើម្បី លើកកម្ពស់ សិទ្ធិ ជន មាន ពិការភាព (UNPRPD) ដើម្បី គាំទ្រ ដល់ បរិយា បន្ន ពិការភាព នៅ កម្រិត ប្រទេស ( ការអនុវត្ត អនុសញ្ញា សិទ្ធិ ជន ពិការ CRPD និង គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ប្រកបដោយ បរិយា បន្ន ) ដោយ ផ្តោត លើ ការផ្លាស់ប្តូរ គោល នយោបាយ និង ប្រព័ន្ធ របស់ រដ្ឋាភិបាល ។
បន្ថែម ពីលើ នេះ លោក ឯ ម ច័ន្ទ មករា បាន ឲ្យដឹង ថា វគ្គ បណ្តុះបណ្តាល ស្តីពី វិធីសាស្រ្ត ប្រទាក់ ប្រទង និង លក្ខខណ្ឌ នានា សម្រាប់ ការអភិវឌ្ឍ ពិការ ភាព ប្រកបដោយ បរិយា បន្ន មាន គោលបំណង ស្នើសុំ ការផ្តល់ អនុសាសន៍ ពី អ្នកចូលរួម ទាំងអស់ លើ ឯកសារ ដើម ទាំងអស់ ដែល នឹង ផ្តល់ វគ្គ បណ្តុះបណ្តាល នេះ ថា តើ គួរ ធ្វើ ការកែសម្រួល យ៉ាងណា ដើម្បីឱ្យ ឯកសារ ទាំងអស់ នេះ ប្រើប្រាស់ បានជា ឯកសារ បណ្តុះបណ្តាល ការអភិវឌ្ឍ ពិការ ភាព ប្រកបដោយ បរិយា បន្ន ថ្នាក់ ជាតិ ដែល អាច ប្រើប្រាស់ បាន ។
រដ្ឋលេខាធិការ វ័យ ក្មេង រូប នេះ បាន បញ្ជាក់ ថា សមិទ្ធផល នៃ វិស័យ ពិការភាព ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ អាច សម្រេច ទៅ បាន គឺ ដោយសារ កិច្ច ខិតខំ ប្រឹងប្រែង និង ការប្តេជ្ញាចិត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការធានា នូវ ការ លើកកម្ពស់ ស្ថានភាព និង គុណ ជីវិត របស់ ជន មាន ពិការភាព ឱ្យ មាន ភាពប្រសើរឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។ កាកបាទ ក្រហម កម្ពុជា និង សប្បុរសជន នានា ក៏ បាន យកចិត្តទុកដាក់ ដល់ ជន មាន ពិការ ភាព គួរឱ្យ កត់សំគាល់ ទោះ ក្នុង កាលៈទេសៈ ដ៏ លំបាក នេះ ក៏ដោយ ។
សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ខេត្ត កំពង់ធំ ផ្តល់ អំណោយ ជូន ពលរដ្ឋ ក្រីក្រ ៣០ គ្រួសារ នៅ ស្រុក តាំង គោក
( កំពង់ធំ )៖ ដើម្បី លើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ ក្នុង ការរកាត់បន្ថយ ភាពក្រីក្រ និង ការចូលរួមចំណែក ជាមួយ រដ្ឋាភិបាល ក្នុង សម័យ កូវីដ១៩ សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ខេត្ត កំពង់ធំ បាន ផ្តល់ អំណោយ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៣០ គ្រួសារ មកពី បី ឃុំ នៅ ស្រុក តាំង គោក ខេត្ត កំពង់ធំ ។
ពិធី ប្រគល់ អំណោយ នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក គៀង សេង គី ប្រធាន សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ខេត្ត កំពង់ធំ និង ជា មេឃុំ ត្បូង ក្រពើ ស្រុក សន្ទុក ដោយ មាន ការចូលរួម ពី សមាជិក សមាជិកា អង្គការ ដៃគូ អាជ្ញាធរដែនដី ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ។
ជាមួយគ្នា នេះ លោក គៀង សេង គី បាន ថ្លែងអំណរគុណ ដល់ អង្គការ ដៃគូ និង អាជ្ញាធរដែនដី ដែល តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ ជាពិសេស ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ចាស់ជរា ជន ពិការ ស្ត្រី មេមាយ កុមារ កំព្រា ឬ ជន ងាយ រងគ្រោះ ដោយ ប្រការ ផ្សេង ៗ ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ អ្វី ឡើយ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ គិតគូរ ពី បញ្ហា ការថែទាំ សុខភាព ដោយ បរិភោគ ទឹក ស្អាត សម្រាក ក្នុង មុង ជានិច្ច និង សម្អាត បរិស្ថាន ជុំវិញ ផ្ទះ ចៀសវាង ការកើតមាន នូវ ជម្ងឺ គ្រុន ឈាម រឺ ជម្ងឺ ផ្សេង ៗ ។
ម្យ៉ាងទៀត ត្រូវ ខិតខំ ចិញ្ចឹម សត្វ និង បង្កើន ការដាំដុះ ដំណាំ ចម្រុះ ផ្សេង ៗ ដើម្បី ធ្វើ យ៉ាងណា លើកស្ទួយ កម្រិត ជីវភាព រស់ នៅ ឱ្យ មាន លក្ខណៈ សមរម្យ និង កាត់បន្ថយ ការចំណាយ ប្រចាំ ថ្ងៃ ដោយ ផ្លាស់ប្តូរ ទំលាប់ មិន ល្អ និង ផ្តល់ ឱកាស ឱ្យ កូន បាន សិក្សា រៀនសូត្រ ដោយ ប្រែក្លាយ ខ្លួន ទៅជា ប្រជាពលរដ្ឋ ល្អ ចូលរួម អភិវឌ្ឍន៍ ប្រទេសជាតិ ឱ្យ មាន ការរីកចម្រើន ។
លោក គៀង សេង គី បាន ផ្ដាំផ្ញើ និង សំណូមពរ ដល់ ប្រជាពលរដ្ឋ សូម ប្រើប្រាស់ ស្បៀង ឱ្យ ចំ គោលដៅ ទុកដាក់ ឯកសារ ឲ្យបាន ត្រឹមត្រូវ និង មាន ការប្រុងប្រយ័ត្ន ចំពោះ ផ្គរ រន្ទះ ខ្យល់ កន្ត្រាក់ ត្រូវ អប់រំ កូន ឱ្យ ជៀស ឆ្ងាយ ពី គ្រឿងញៀន ពេល បើកបរ ត្រូវ ពាក់ មួក សុវត្ថិភាព នឹង ដាក់ ខ្សែក្រវាត់ ដើម្បី ចៀសវាង គ្រោះថ្នាក់ ចរាចរណ៍ និង ចូលរួម ទប់ស្កាត់ នូវ ជំងឺ កូវីដ១៩ ដោយ អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
គួរ បញ្ជាក់ ផងដែរ ថា ជា ពលរដ្ឋ ដែល ទទួលបាន មាន ឃុំ ទ្រៀល ១០គ្រួសារ ឃុំ ស្រឡៅ ១០គ្រួសារ និង ឃុំ សូយោង ១០គ្រួសារ ដោយ ក្នុង មួយ គ្រួសារ មាន អង្ករ ៥០ គីឡូក្រាម មី ១ កេស ប្រេង ឆា១ ដប ទឹកត្រី ១យួរ ទឹកស៊ី អុីវ ១យួរ ត្រីខ ១យួរ ម៉ាស១ ប្រអប់ មុង១ ភួយ១ និង សាប៊ូ ៤ដុំ ៕
ខេត្ត បន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ៨៩ នាក់ និង ជាសះស្បើយ ២១៨ នាក់
ក្រសួង សុខាភិបាល បង្ហាញ តារាង វាយតម្លៃ ពី ស្ថានភាព អ្នកជំងឺ កូវីដ១៩ មុននឹង អនុញ្ញាតឱ្យ ធ្វើ ការព្យាបាល នៅ តាម ផ្ទះ
( ភ្នំពេញ ) ៖ មុននឹង អនុញ្ញាតឱ្យ ធ្វើ ការព្យាបាល នៅ តាម ផ្ទះ បាន អ្នកជំងឺ កូវីដ១៩ នោះ ត្រូវ ឆ្លងកាត់ ការវាយតម្លៃ ពី ក្រសួង សុខាភិបាល ជាមុន សិន ។ នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ក្រសួង សុខាភិបាល បាន បង្ហាញ ពី តារាង វាយតម្លៃ មុន អនុញ្ញាត ឱ្យ ធ្វើការ ថែទាំ និង ព្យាបាល ជំងឺ កូវីដ១៩ នៅ ផ្ទះ តាម ផ្ទះ ចំពោះ អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល និង គ្មាន រោគសញ្ញា ។
ការបង្ហាញ តារាង វាយតម្លៃ នេះ បាន ធ្វើឡើង នៅក្នុង សន្និសីទ សារព័ត៌មាន រួម រវាង ក្រសួង សុខាភិបាល និង រដ្ឋបាល សាលា រាជធានី ភ្នំពេញ នៅ ព្រឹក នេះ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ នៅ សាលា រាជធានី ភ្នំពេញ ដើម្បី ផ្សព្វផ្សាយ ពី នីតិវិធី និង យន្ដ ការដាក់ ព្យាបាល តាម ផ្ទះ ចំពោះ អ្នកជំងឺ ជំងឺ កូវីដ១៩ កម្រិល ស្រាល និង គ្មាន រោគសញ្ញា សម្រាប់ ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ ។
បើ តាម ការបញ្ជក់ របស់ លោក ង៉ូវ កាង រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ថា « យន្ដ ការដាក់ ព្យាបាល តាម ផ្ទះ សម្រាប់ ជំងឺ កូវីដ១៩ នេះ កម្រិត ស្រាល នេះ គឺ មាន ការគិតគូរ យ៉ាង ល្អិតល្អន់ ណាស់ ជាមួយ ថ្នាក់ដឹកនាំ និង អ្នកបច្ចេកទេស ដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។ ការដាក់ ព្យាបាល អ្នកជំងឺ កូវីដកម្រិត ស្រាល នៅ តាម ផ្ទះ ក្នុង រយៈពេល ជិត ២ខែ មក នេះ បាន សង្កេតឃើញ ថា ទទួលបាន ប្រសិទ្ធភាព ល្អ » ។
ជំនួប តាម ប្រព័ន្ធ វីដេអូ នេះ ឆ្លុះបញ្ចាំង អំពី ឆន្ទៈ នយោបាយ និង ការប្តេជ្ញា ក្នុង ការជំរុញ បន្ថែម ទៀត ភាពជាដៃគូ យុទ្ធសាស្រ្ត អាស៊ាន - សហរដ្ឋ អាមេរិក សម្រាប់ កិច្ចសហប្រតិបត្តិការ យូរអង្វែង ដើម្បី សន្តិភាព ស្ថិរភាព សន្តិសុខ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម ។
សូម ជម្រាប ថា កិច្ចប្រជុំ ពិសេស រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន - សហរដ្ឋ អាមេរិក ធ្លាប់ បាន គ្រោង ប្រព្រឹត្តទៅ តាម ប្រព័ន្ធ វីដេអូ នៅ ថ្ងៃទី ២៥ ខែឧសភា ឆ្នាំ ២០២១ ប៉ុន្តែ នៅ ថ្ងៃ ប្រជុំ ដ៏ សំខាន់ ខាងលើ ស្រាប់តែ រដ្ឋមន្រ្តី ការបរទេស អាមេរិក លោក អេនតូនី ប្លីន ខេន (Antony Blinken) បែរជា ទៅ ធ្វើ ទស្សនកិច្ច តំបន់ មជ្ឈិមបូព៌ា នៅឯ ប្រទេស អ៉ី ស្រាអែល ទៅ វិញ ដោយ មិន ជូន ដំណឹង ជាមុន និង មិន បាន ចាត់ មន្ត្រី ឲ្យ ជំនួស ដែរ ។
គួរ បញ្ជាក់ ថា កំលុង រដូវ ភ្លៀង នៅ ប្រទេស ចិន ជារឿយ ៗ តែង មាន ការជន់ លិច ដោយ កាលពី ខែសីហា ឆ្នាំ ២០២០ ផ្លូវ ជាច្រើន ខ្សែ ត្រូវបាន ទឹក ជន់ ហូរ កាត់ផ្តាច់ ហើយ មនុស្ស រាប់ ម៉ឺន នាក់ ត្រូវ បង្ខំ ឲ្យ ភៀសខ្លួន ចេញ ពី លំនៅឋាន ៕
រដ្ឋមន្ត្រី ថោង ខុន៖ ចុង សប្ដាហ៍ ទី ពីរ នៃ ខែកក្កដា កម្ពុជា ទទួលបាន ភ្ញៀវ ទេសចរ ជិត ៧ ម៉ឺន នាក់
ការបន្ត ថយចុះ បន្តិច នៃ ចំនួន ភ្ញៀវ ទេសចរ ធៀប នឹង សប្តាហ៍ កន្លងមក នេះ ដោយសារ ការរឹតបន្តឹង វិធានការ រដ្ឋបាល របស់ រាជធានី - ខេត្ត មួយចំនួន ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ពិសេស ការផ្អាក សកម្មភាព រមណីយដ្ឋាន ទេសចរណ៍ និង គោលដៅ ទេសចរណ៍ មួយចំនួន ដែល ប្រឈម ហានិភ័យ នៃ ការកើនឡើង ជំងឺ កូវីដ - ១៩ ។
ក្នុង ន័យ នេះ រដ្ឋបាល រាជធានី - ខេត្ត បាន អនុញ្ញាតឱ្យ ភ្ញៀវ និង ប្រជាពលរដ្ឋ ធ្វើដំណើរ ក្នុង ក្រុង ធម្មតា លើកលែងតែ តំបន់ ហាមឃាត់ មួយចំនួន តូច ដែល ប្រឈម ហានិភ័យ នៃ អត្រា ឆ្លង កូវីដ - ១៩ ខ្ពស់ ប៉ុន្តែ គោលដៅ ទេសចរណ៍ តំបន់ ឆ្នេរ រួម ជាមួយ គោលដៅ អេកូ ទេសចរណ៍ និង ទេសចរណ៍ ធម្មជាតិ នៅតែ ជា គោលដៅ សំខាន់ សម្រាប់ ភ្ញៀវ ទេសចរ ផ្ទៃក្នុង ។
ដោយឡែក នៅ តាម គោលដៅ ទេសចរណ៍ នានា ភ្ញៀវ ទេសចរ មាន ការចូលរួម អនុវត្ត បាន ត្រឹមត្រូវ ភាគ ច្រើន នូវ វិធាន សុវត្ថិភាព ទេសចរណ៍ និង វិធានការ សុខាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ជាពិសេស ការរក្សា គម្លាត និង ការប្រមូលផ្តុំ តែ ក្នុង ទ្រង់ទ្រាយ តូច ក្នុង ចំណោម សមាជិក គ្រួសារ ជាដើម ៕ ក្រសួង សុខាភិបាល ត្រៀម ដាក់ ឲ្យ ខេត្ត កណ្តាល មាន ការព្យាបាល អ្នក កើត កូវីដ នៅ តាម ផ្ទះ ខណៈ ខេត្ត ផ្សេង ទៀត ស្ថិត ក្នុង ការពិចារណា (Video inside)
( ភ្នំពេញ ) ៖ លោក ង៉ូវ កាង រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា ឆាប់ ៗ នេះ នឹង មាន ការដាក់ ឱ្យ ព្យាបាល នៅ តាម ផ្ទះ ក្នុង ខេត្ត កណ្តាល ហើយ នឹង បន្ត គិតគូរ ទៅ ខេត្ត ផ្សេង ទៀត នៅ ជំហាន បន្ទាប់ ផងដែរ ។
លោក ថ្លែង បែប នេះ ក្នុង ឱកាស ដែល ក្រសួង សុខាភិបាល រៀបចំ ធ្វើ សន្និសីទ សារព័ត៌មាន ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ ដើម្បី ផ្សព្វផ្សាយ ពី នីតិវិធី និង យន្តការដាក់ ព្យាបាល តាម ផ្ទះ ចំពោះ អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល និង គ្មាន រោគសញ្ញា សម្រាប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ ។
រហូតមកដល់ ពេលនេះ មាន អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល ចំនួន ១០៣៣ នាក់ ហើយ ត្រូវបាន ដាក់ ឱ្យ ព្យាបាល នៅ តាម ផ្ទះ នៅក្នុង រាជធានី ភ្នំពេញ ហើយ ក្នុង នោះ មាន អ្នកជំងឺ ប្រមាណ ២៦៨ នាក់ ផងដែរ ដែល បាន ជាសះស្បើយ ។ នេះ បើ តាម លោក ងី មាន ហេង ប្រធាន មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ
ការរៀបចំ ព្យាបាល និង ថែទាំ អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល នៅ តាម ផ្ទះ គឺ ដើម្បី ទុកន្លែង ព្យាបាល នេះ ឱ្យ អ្នកជំងឺ ធ្ងន់ធ្ងរ បាន ចូល សម្រាក ព្យាបាល ដើម្បី ជួយសង្គ្រោះ ជីវិត របស់ ពួកគាត់ ពី ជំងឺ កាច សាហាវ ៕ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បង្ហាញ វិធី ប្រើ ប្រព័ន្ធ ស្វ័យប្រវត្តិកម្ម សម្រាប់ បញ្ជាទិញ ឧបករណ៍ តេស្ត រហ័ស អង់ទី ហ្សែន កូវីដ - ១៩ (Video inside)
( ភ្នំពេញ ) ៖ ដើម្បី ពន្លឿន និង សម្រួល ដល់ ការចែកចាយ ឧបករណ៍ តេស្ត រហ័ស អង់ទី ហ្សែន កូវីដ - ១៩ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន បង្កើត ប្រព័ន្ធ ស្វ័យប្រវត្តិកម្ម សម្រាប់ ការបញ្ជាទិញ ឧបករណ៍ នេះ ។ ដើម្បី ដាក់ សំណើ បញ្ជាទិញ លោក អ្នក ត្រូវ អនុវត្ត តាម ជំហ៊ាន ដូច ខាងក្រោម៖
លោក អ្នក ត្រូវ បំពេញ ព័ត៌មាន ៤ប្រភេទ គឺ ឈ្មោះ អ្នកទិញ ឈ្មោះ ស្ថាប័ន ចំនួន បុគ្គលិក ចំនួន ឧបករណ៍ តេស្តរហ័ស គិត ជា ឯកតា ។ សូម បញ្ជាក់ ថា ការបញ្ចូល ចំនួន បុគ្គលិក និង ចំនួន ឧបករណ៍ តេស្ត មិន ត្រូវ សរសេរ ជា លេខ ខ្មែរ ឬ មាន អក្សរ ផ្សេង មក ជាមួយ នោះ ទេ ។
បន្ទាប់ពី អនុវត្ត ជំហាន ខាងលើ រួច លោក អ្នក នឹង ទទួលបាន សារ ដែល បញ្ជាក់ អំពី ព័ត៌មាន ដែល អ្នក បាន បំពេញ ខាងលើ ។ ដូចនេះ សូម ពិនិត្យ មើល ឡើងវិញ ក្នុង ករណី ដែល ព័ត៌មាន បញ្ជាទិញ របស់ អ្នក ត្រឹមត្រូវ ត្រូវ ចុច លើ ពាក្យ « ត្រឹមត្រូវ »លោក អ្នក នឹង ទទួលបាន សារ បញ្ជាក់ អំពី ការទទួលបាន សំណើ បញ្ជាទិញ ដោយ សំណើ នេះ នឹង ត្រូវ អនុម័ត ជា មុន អំពី ចំនួន ដែល អាច ផ្តល់ ជូន ទើប អាច បង់ប្រាក់ បាន ។
សូម រង់ចាំ ការអនុម័ត តាម លំដាប់ អាទិភាព ក្រោយ ការអនុម័ត លោក អ្នក នឹង ទទួលបាន សារ បញ្ជាក់ អំពី ចំនួន ឧបករណ៍ ដែល អាច ផ្តល់ ជូន និង នីតិវិធី ដើម្បី ទូទាត់ ប្រាក់ ព្រមទាំង តេឡេក្រាម របស់ មន្ត្រី ទទួលបន្ទុក លើ សំណើ របស់ អ្នក នៅពេល ទូទាត់ ប្រាក់ រួចរាល់ លោក អ្នក នឹង ទទួលបាន សារ បញ្ជាក់ អំពី ការបង់ប្រាក់
លោក អ្នក នឹង ទទួលបាន សារ កំណត់ អំពី កាលបរិច្ឆេទ មកទទួល ឧបករណ៍ នៅ មណ្ឌល ផ្តល់ សេវា សាធារណៈ នៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ។ អ្នក បញ្ជាទិញ មុននឹង ទទួលបាន ឧបករណ៍ មុន ។ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ក៏ បាន បន្ថែម ពេលវេលា សម្រាប់ ការមក ទទួលយក ឧបករណ៍ តេស្ត រហ័ស នេះ ពី ថ្ងៃចន្ទ ដល់ ថ្ងៃអាទិត្យ ចាប់ពី ម៉ោង ៨ព្រឹក ដល់ ម៉ោង ៦ល្ងាច ។
នៅក្នុង ប្រទេស កាណាដា អាជ្ញាធរ បាន ប្រកាស ដាក់ ចេញ វិធានការ ថ្មី ជាច្រើន ដើម្បី ទប់ស្កាត់ ភ្លើង ឆេះ ព្រៃ ខណៈ បច្ចុប្បន្ន ប្រទេស មួយ នេះ កំពុង ប្រឈមមុខ នឹង រលក កម្ដៅ និង ភ្លើង ឆេះ ដែល នៅតែ បន្ត ឆេះ រាលដាល ក្នុង នោះ មាន ទាំង ភ្លើង ឆេះ ព្រៃ ៥០ ទីតាំង នៅ បន្ត ឆេះ រាលដាល នៅឡើយ ។ សម្រាប់ នៅ កាណាដា មនុស្ស រាប់ រយ នាក់ ហើយ បាន បាត់បង់ជីវិត ព្រោះតែ រលក កម្តៅ ដ៏ អាក្រក់ នេះ ។
ដោយឡែក ទីភ្នាក់ងារ ឧតុនិយម អាមេរិក ក៏ បាន ព្រមាន ដែរ ថា សីតុណ្ហភាព ក្ដៅ អាចនឹង ឡើង ដល់ ចំណុច មួយ ដ៏ គ្រោះថ្នាក់ ឬ ឡើង ក្ដៅ បំបែក កំណត់ ត្រា ថ្មី មួយ នៅ តំបន់ ភាគ ខាងលិច នៃ ប្រទេស ខណៈ អាជ្ញាធរ ឧតុនិយម កាណាដា ក៏ បាន ព្យាករណ៍ ដែរ ថា សីតុណ្ហភាព អាចនឹង ឡើង ក្ដៅ រហូតដល់ ៣២ អង្សា សេ មិន ធ្លាប់ មាន នៅ ផ្នែក ខ្លះ នៃ ភាគ ខាងលិច ប្រទេស កាណាដា ។
ប្រកាស កែសម្រួល ក្រុមការងារ យុជន ក្នុង រចនាសម្ព័ន្ធ ស្រុក យុវជន ឃុំ និង សកម្មជន យុវជន ភូមិ ក្នុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ លោក ហាក់ សុខ មករា សមាជិក យុវជន គណបក្ស ថ្នាក់ កណ្ដាល និង ជា ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ប្រកាស កែសម្រួល ក្រុមការងារ យុជន ក្នុង រចនាសម្ព័ន្ធ ស្រុក យុវជន ឃុំ និង សកម្មជន យុវជន ភូមិ ក្នុង ស្រុក ពញា ក្រែក នៃ ខេត្ត ត្បូងឃ្មុំ ។
លោក ក៏ បាន លើកឡើង អំពី គោលការណ៍ ក្នុង ការគ្រប់គ្រង រចនាសម្ព័ន្ធ បក្ស ក្នុង ជួរ យុវជន ការកសាង បក្ស ការពង្រឹង សតិអារម្មណ៍ យុវជន គណបក្ស និង បាន ផ្ដោត ជា សំខាន់ ដើម្បី ធានា បាន នូវ ប្រៀប ឈ្នះ របស់ គណបក្ស ប្រជាជន កម្ពុជា នៅពេល បោះឆ្នោត ខាងមុខ និង ផ្សព្វផ្សាយ ផែនការ សកម្មភាព របស់ ក្រុមការងារ យុវជន គណបក្ស ខេត្ត ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ។
លោក បាន បញ្ជាក់ ថា យុវជន សមាជិក បក្ស ១រូប គឺ សម្លេង ឆ្នោត គាំទ្រ គណបក្ស ១សន្លឹក ។
លោក យីកន្និដ្ឋា តំណាង លោក ឡេង តុង បាន ឧមត្ថម ម៉ាស ២កេស អាល់កុល២កាន និង ផ្តល់ ថវិកា មួយ ចំនួន ដល់ សមាជិក សមាជិកា ដែល បាន អញ្ជើញ ចូលរួម ផងដែរ ៕
ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៦២ នាក់ . ជាសះស្បើយ ៣៥ នាក់ និង ស្លាប់ ២នាក់
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៦២ នាក់ បន្ថែម ទៀត . ជាសះស្បើយ ៣៥ នាក់ និង ស្លាប់ ២នាក់ ក្នុង នោះ ស្រុក កោះ សូទិន ម្នាក់ និង ស្រុក ជើង ព្រៃ ម្នាក់ ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក ប៉ែន សុវិជាតិ អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន ឲ្យដឹង ថា ក្រសួង ពាណិជ្ជកម្ម ជឿជាក់ ថា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី រវាង កម្ពុជា - ចិន នឹង អាច ចូល ជាធរមាន នៅ ដើម ឆ្នាំ ២០២២ ។
លោក ប៉ែន សុវិជាតិ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ប្រសិនបើ កម្ពុជា អាច រៀបចំ នីតិវិធី ផ្ទៃក្នុង ឲ្យបាន ចប់ សព្វគ្រប់ មុន ខែកញ្ញា ឆ្នាំ ២០២១ ក្រសួង ពាណិជ្ជកម្ម ជឿជាក់ ថា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី រវាង កម្ពុជា - ចិន នឹង អាច ចូល ជាធរមាន នៅ ដើម ឆ្នាំ ២០២២» ។
លើស ពី នោះ ទៀត មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង ពាណិជ្ជកម្ម រូប នេះ បាន គូសបញ្ជាក់ ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី កម្ពុជា - ចិន នឹង ត្រូវ ដាក់ ឲ្យ ត្រួតពិនិត្យ និង វាយតម្លៃ ក្នុង កិច្ចប្រជុំ ពេញ អង្គ នៃ គណៈអចិន្ត្រៃយ៍ រដ្ឋសភា ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
លោក ប៉ែន សុវិជាតិ បាន អះអាង ទៀត ថា កម្ពុជា នឹង ទទួល អត្ថប្រយោជន៍ បន្ថែម ទៀត ពី កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី កម្ពុជា - ចិន លើ អ្វី ដែល កម្ពុជា កំពុង ទទួលបាន ពី ភាគី ចិន ក្នុង ការជំរុញ ទំហំ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ និង ការនាំចេញ របស់ កម្ពុជា ។
លោក ប៉ែន សុវិជាតិ បាន បញ្ជាក់ ឲ្យដឹង ថា ប្រសិនបើ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ទ្វេ ភាគី កម្ពុជា - ចិន ចូល ជាធរមាន កម្ពុជា អាច នាំចេញ ទំនិញ ជាង ៣០០ មុខ ទៅ ប្រទេស ចិន ដោយ មិន ចាំបាច់ បង់ ពន្ធ នោះ ទេ ។
បើ តាម លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម ក្នុង ឱកាស ឡើង ការពារ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី កម្ពុជា - ចិន ជាមួយ គណៈកម្មការ ជំនាញ រដ្ឋសភា កាលពី ថ្ងៃទី ០៨ ខែកក្កដា ឆ្នាំ ២០២១ អត្ថប្រយោជន៍ ដែល កម្ពុជា ទទួលបាន រួម មាន៖
១៖ ការទទួលបាន ការបើក ទីផ្សារ ឲ្យបាន ធំ ជាង មុន និង ប្រសើរ ជាង មុន សម្រាប់ មុខ ទំនិញ កសិផល បន្លែ ផ្លែ ឈើ ផលិតផល កែច្នៃ និង សិប្បកម្ម និង ផលិតផល ជាច្រើន ទៀត ស្រប ពេល ដែល កម្ពុជា អាច ផលិត បាន និង អនុលោម តាម វិធាន អនាម័យ និង ស្តង់ដារ ។
២៖ ការទទួលបាន លំហូរ ទីផ្សារ ពាណិជ្ជកម្ម សេវាកម្ម ដែល កម្ពុជា អាច នាំចេញ ក្នុង ករណី មាន ការបណ្តុះបណ្តាល ជំនាញ និង មាន គុណ វុឌ្ឍិគ្រប់គ្រាន់ ជាពិសេស នៅ ពេល ដែល កម្ពុជា អាច ពង្រឹង ខ្លួន ឯង ឲ្យ រឹងមាំ ក្នុង វិស័យ សេវាកម្ម នា ពេល អនាគត ។
៣៖ ផ្តល់ កាលានុវត្តភាព ផ្នែក វិនិយោគ ដល់ កម្ពុជា បាន កាន់តែ ច្រើន ដែល នឹង ផ្តល់ ឱកាស ដល់ ធុរ ជន កម្ពុជា ដែល មាន បំណង ពង្រីក ទីផ្សារ សេវាកម្ម និង ទំនិញ នាំចេញ ឲ្យ កាន់តែ សម្បូរបែប ទៅកាន់ ទីផ្សារ ចិន ។
៤៖ ការទទួលបាន ផលប្រយោជន៍ ពី ការផ្ទេរ បច្ចេកវិទ្យា ចំណេះដឹង ចំណេះ ធ្វើ និង ជំនាញ ថ្មី ៗ ពី ការវិនិយោគ ផ្ទាល់ របស់ បរទេស ព្រមទាំង បង្កើត ការងារ ថ្មី ៗ ជូន ប្រជាជន កម្ពុជា ហើយក៏ ជា កត្តា ដ៏ សំខាន់ ចូលរួម ពង្រឹង ដល់ វិស័យ ផលិតកម្ម ក្នុង ស្រុក ។
៥៖ ការកំណត់ ឲ្យ កាន់តែ ច្បាស់ នូវ រាល់ នីតិវិធី ទាក់ទង នឹង វិធាន ដើមកំណើត ទំនិញ គយ និង សម្រួល ពាណិជ្ជកម្ម អនាម័យ និង ភូត គាម អនាម័យ និង របាំង បច្ចេកទេស លើ ការធ្វើ ពាណិជ្ជកម្ម និង ការធ្វើ សាមញ្ញ កម្ម ដើម្បី ងាយស្រួល អនុវត្ត និង សម្រួល ដល់ ការធ្វើ ពាណិជ្ជកម្ម ។
៦៖ ការរៀបចំ និង ការបង្កើត នូវ បរិយាកាស វិនិយោគ និង នយោបាយ ទាក់ទាញ វិនិយោគទុន ពី បរទេស ជាដើម ។
ជាក់ស្ដែង រយៈពេល ៥ខែ ពោល គិត ចាប់ពី ខែមករា ដល់ ខែឧសភា ឆ្នាំ ២០២១ ទំហំ ពាណិជ្ជកម្ម កម្ពុជា - ចិន សម្រេចបាន សរុប ចំនួន ជិត ៤ពាន់ លាន ដុល្លារ កើនឡើង ជិត ២៥% បើ ប្រៀបធៀប នឹង រយៈពេល ដូចគ្នា នៅ ឆ្នាំ ២០២០ ។ នេះ បើ តាម របាយការណ៍ របស់ ក្រសួង ពាណិជ្ជកម្ម ។
ទំនិញ កម្ពុជា ដែល នាំចេញ ទៅកាន់ ទីផ្សារ ចិន រួម មាន៖ អង្ករ ចំណិត ដំឡូង ក្រៀម ស្វាយ ស្រស់ និង គ្រាប់ ស្វាយចន្ទី និង ទំនិញ ផ្សេង ជាច្រើន មុខ ទៀត ខណៈ ទំនិញ នាំចូល ពី ចិន មក វិញ មាន ដូចជា៖ គ្រឿង អេឡិចត្រូនិច គ្រឿង បរិភោគ កែច្នៃ ជាដើម - ល - ៕
CCSA បាន គូសបញ្ជាក់ ថា ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ៨. ៥៨៣ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ថៃ ទូទៅ ខណៈ ១០៨ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ អ្នកជំងឺ ចំនួន ៨០ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ខណៈ អ្នក ជាសះស្បើយ ចំនួន ៣. ៦៨៧ នាក់ ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាត ឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ។
KOICA ផ្តល់ វគ្គ បណ្តុះបណ្តាល ស្តីពី « ការបណ្តុះបណ្តាល ការអភិវឌ្ឍ បច្ចេកវិទ្យា វេចខ្ចប់ ដើម្បី បង្កើន ផលិតភាពសហគ្រាស ធុន តូច និង មធ្យម »
( ភ្នំពេញ ) ៖ ការិយាល័យ « កយកា-KOICA» ប្រចាំ នៅ កម្ពុជា នឹង ផ្តល់ វគ្គ បណ្តុះបណ្តាល ដល់ មន្រ្តី រដ្ឋាភិបាល កម្ពុជា ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ការបណ្តុះបណ្តាល តាម ប្រព័ន្ធ អ៉ីនធឺណែត សម្រាប់ ឆ្នាំ ទី២ នៃ វគ្គ បណ្ដុះបណ្ដាល រយៈពេល ៣ឆ្នាំ ជាប់ ៗ គ្នា ( ២០២០ - ២០២២ ) ស្តីពី « ការបណ្តុះបណ្តាល ការអភិវឌ្ឍ បច្ចេកវិទ្យា វេចខ្ចប់ ដើម្បី បង្កើន ផលិតភាពសហគ្រាស ធុន តូច និង មធ្យម » ។
កយកា-KOICA ចាប់ផ្តើម បើក វគ្គ បណ្តុះបណ្តាល តាម អ៉ិនធឺណែត នេះ វិញ ដោយ ពិចារណា ថា វា នឹង មាន ការលំបាក ក្នុង ការអនុវត្ត កម្មវិធី អញ្ជើញ ទៅ បណ្តុះបណ្តាល ដោយ ផ្ទាល់ នៅ ប្រទេស កូរ៉េ នៅក្នុង ឆ្នាំ ២០២១ ដោយសារ ស្ថានភាព ជំងឺ កូវីដ - ១៩ ។ គោលបំណង នៃ កម្មវិធី នេះ ដើម្បី កែលំអ នាវនុវត្តន៍ បច្ចេកវិទ្យា នៅក្នុង ប្រទេស កម្ពុជា តាមរយៈ ការណែនាំ បច្ចេកវិទ្យា វេចខ្ចប់ វេចខ្ចប់ ទំនើប របស់ កូរ៉េ និង គោល នយោបាយ ពាក់ព័ន្ធ ផ្សេង ៗ ទៀត របស់ ប្រទេស កូរ៉េ ។
កម្មវិធី ឆ្នាំ នេះ មាន សិក្ខាកាម ចូលរួម ចំនួន ២៣នាក់ មក ពី ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ (MISTI) នៃ ប្រទេស កម្ពុជា ។ ក្នុង ចំណោម សិក្ខាកាម ទាំង ២៣នាក់ មាន មន្ត្រី ជាន់ ខ្ពស់ មួយចំនួន រួម មាន អគ្គ នាយក រង១ រូប ប្រធាន នាយកដ្ឋាន ២រូប និង អនុប្រធាន នាយកដ្ឋាន ៦ រូប ចូលរួម ផងដែរ ។
( កំពង់ស្ពឺ ) ៖ លោក ឌី វិជ្ជា និង លោកស្រី ហ៊ុន ម៉ាណា បាន ចាត់ ឲ្យ លោក ជិន ប៊ុន ធឿន និង ក្រុមការងារ មនុស្សធម៌ បាន នាំយក អំណោយ ជា ស្បៀងអាហារ និង សម្ភារៈ ប្រើប្រាស់ មួយចំនួន ធំ ទៅ ប្រគល់ ជូន សហគមន៍ និង មណ្ឌល ទាំង ០៨ ដើម្បី ជួយ សម្រាល ជីវភាព រស់ នៅ នា ពេល បច្ចុប្បន្ន នេះ នា ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២១ ។
ក្នុង ឱកាស នោះ លោក ជិន ប៊ុន ធឿន នាំ នូវ ការ សួរសុខទុក្ខ ពីសំណាក់ លោក ឌី វិជ្ជា និង លោកស្រី ហ៊ុន ម៉ាណា ដែល លោក ទាំង ពីរ តែងតែ យកចិត្តទុកដាក់ គិតគូរ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ រូប ពិសេស ក្មួយ ៗ ជា កុមារ កំព្រា ដែល កំពុង ជួប ការលំបាក ដោយ មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុរ ជំនឿ សាសនា ឬ និន្នាការ នយោបាយ អ្វី ឡើយ ។
ជាពិសេស លោក ណែនាំឲ្យ ក្មួយ ៗ បង្កើន ការយកចិត្តទុកដាក់ ថែរក្សា អនាម័យ សុខភាព ប្រចាំ ថ្ងៃ ដើម្បី ការពារ ជំងឺ ឆ្លង កូវីដ - ១៩ ហើយ សូម រក្សា គម្លាត សង្គម និង ពាក់ ម៉ាស់ នៅ កន្លែង មាន មនុស្ស អូរ អរ ច្រើន និង បាន ផ្តាំផ្ញើ ឲ្យ ក្មួយ ខិតខំ រៀនសូត្រ ដើម្បី ទទួលបាន ចំណេះដឹង មក អភិវឌ្ឍន៍ ប្រទេសជាតិ យើង ។
ដោយឡែក ស្បៀងអាហារ គ្រឿង ឧបភោគ បរិភោគ ជាច្រើន មុខ នេះ អាច ជួយ សម្រួល ការលំបាក ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ របស់ ក្មួយ ៗ ហើយ អំណោយ ផ្តល់ ជូន អាស្រ័យ ទៅ តាម ចំនួន កុមារ កំព្រា និង បុគ្គលិក តាម សហគមន៍ និង មណ្ឌលកុមារ កំព្រា នីមួយ ៗ ។
សូម បញ្ជាក់ ថា មណ្ឌលកុមារ កំព្រា ទាំងនេះ គឺជា កន្លែង ជួយសង្គ្រោះ កុមារ ងាយ រងគ្រោះ និង កុមារ កំព្រា ដើម្បីឲ្យ មាន លទ្ធភាព ក្នុង ការសិក្សា និង ផ្តល់ ជំនាញ វិជ្ជាជីវៈ ផ្សេង ៗ ដល់ ពួកគេ ៕
លោក ប្រធាន មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ខ្ញុំបាទ សូម ជម្រាប ជូន អំពី ករណី ចំនួន អ្នកថែទាំ ជំងឺ កូវីដ១៩ នៅ តាម ផ្ទះ បច្ចុប្បន្ន បើ គិត តួលេខ នៅ ព្រឹក នេះ មាន ចំនួន ១. ០៣៣ នាក់ កំពុងតែ ទទួល ការព្យាបាល ថែទាំ នៅ តាម ផ្ទះ តាំងតែពី យើង អនុវត្ត ការព្យាបាល ថែទាំ តាម ផ្ទះ មក គឺ មាន អ្នកជំងឺ ដែល ព្យាបាល ជាសះស្បើយ ចំនួន ២៦៨ នាក់ បូក ពីលើ ចំនួន ដែល កំពុងតែ ព្យាបាល នេះ » ។
ការរៀបចំ ព្យាបាល និង ថែទាំ អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល នៅ តាម ផ្ទះ គឺ ដើម្បី ទុកន្លែង ព្យាបាល នេះ ឱ្យ អ្នកជំងឺ ធ្ងន់ធ្ងរ បាន ចូល សម្រាក ព្យាបាល ដើម្បី ជួយសង្គ្រោះ ជីវិត របស់ ពួកគាត់ ពី ជំងឺ កាច សាហាវ ៕ អំណោយ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ត្រូវ ផ្តល់ ជូន ពលរដ្ឋ ងាយ រងគ្រោះ និង រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ ១២៩ គ្រួសារ នៅ ស្រុក ទឹក ឈូ
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត នៅ ថ្ងៃទី ១១ ខែកក្ត ដា ឆ្នាំ ២០២១ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ផ្តល់ ជូន ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ និង រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ១២៩ គ្រួសារ មកពី ឃុំ ចំនួន ៧ នៅ ស្រុក ទឹក ឈូ។ ពិធី នេះ រៀបចំ ធ្វើឡើង នៅ ទីតាំង វត្ត ពោធិ៍ ក្នុង ឃុំ ថ្មី ស្រុក ទឹក ឈូ ខេត្ត កំពត ។
ខេត្ត ឧត្តរមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ថ្មី ចំនួន ២៤០ នាក់ ភាគ ច្រើន ជា ពលករ មកពី ប្រទេស ថៃ និង អ្នកសះស្បើយ ៥៨ នាក់
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា ក្នុង ចំណោម អ្នកជំងឺ កូវីដ ទាំង ២៤០ នាក់ ក្នុង នោះ អ្នកជំងឺ ចំនួន ៧៩ នាក់ ជា ពលករ ដែល កំពុង ធ្វើចត្តាឡី ស័ក និង ១៦០ នាក់ ទៀត ជា ពលករ ទើប មកពី ប្រទេស ថៃ តាម ច្រក អន្តរជាតិ អូរ ស្មាច់ និង ចំនួន ១នាក់ ទៀត ជា ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ។
សូម បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ខេត្ត ឧត្តរមានជ័យ បាន រកឃើញ ជំងឺ កូវីដ១៩ ចំនួន ១៨២៥ ករណី ក្នុង នោះ ករណី នាំចូល ពី បរទេស ចំនួន ១៦៧៧ ករណី និង ករណី ឆ្លង ក្នុង សហគមន៍ ២០កុម្ភៈ ចំនួន ១៤៨ ករណី បាន ព្យាបាល ជាសះស្បើយ ចំនួន ៣៧១ នាក់ កំពុង សម្រាក ព្យាបាល ចំនួន ១៤៥០ នាក់ និង ស្លាប់ បាត់បង់ជីវិត ៤នាក់ ផងដែរ ៕
ខេត្ត ព្រៃវែង ប្រកាស ពី ការរក ឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ១៣០ នាក់
បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ទាំង ១៣០ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង តាម មន្ទីរពេទ្យ បង្អែក ស្រុក របស់ ពួកគេ នីមួយ ៗ ។
ជាថ្មី ម្តង ទៀត ចំពោះ អ្នក ដែល បាន ប្រាស្រ័យទាក់ទង ប៉ះពាល់ ដោយ ផ្ទាល់ ឬ ប្រយោល ជាមួយ បុគ្គល វិជ្ជមាន កូវីដ១៩ ខាងលើ សូម ដាក់ ខ្លួន ដាច់ដោយឡែក តាមដាន សុខភាព រយៈពេល ១៤ ថ្ងៃ និង រាយការណ៍ មក អាជ្ញាធរ ដើម្បី យក សំណាក និង ធ្វើចត្តាឡី ស័ក ៕ ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ៦នាក់ និង របួស ១៣នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១១ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៦នាក់ និង របួស ធ្ងន់ ស្រាល ១៣នាក់ ។
