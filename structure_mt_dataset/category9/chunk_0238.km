* ទី២៖ សូម បដិសេធ និង មោឃ ភាព រាល់ លិខិត និង ឯកសារ ទាំងឡាយ ណា ដែល មាន ពាក់ព័ន្ធ ទៅនឹង ការកាន់កាប់ ប្រើប្រាស់ ដីធ្លី ក្នុង តំបន់ ឧទ្យាន ជាតិ ដែល នាងខ្ញុំ និង ខ្ញុំបាទ បាន ចុះហត្ថលេខា នា ពេល កន្លងមក ។
ដូច្នេះ ប្រជាពលរដ្ឋ ក៏ ដូចជា បងប្អូន មាន មុខរបប រកស៊ី ទិញ - លក់ ដី ពាក់ព័ន្ធ នឹង តំបន់ ខាងលើ ច្បាស់ជា ត្រូវ មោឃ ភាព តាម កិច្ចសន្យា របស់ មន្ត្រី មូលដ្ឋាន នេះ ទាំងអស់ ដោយ មិន មាន ការតវ៉ា ឡើយ ៕ លោក Xi Jinping ៖ បក្ស កុម្មុយនិស្ត ចិន នឹង ខិតខំ ជំរុញ យ៉ាង សកម្ម ចំពោះ ការធ្វើឱ្យ មាន សុក្រឹតភាព នូវ អភិបាលកិច្ចសកល
( ប៉េកាំង ) ៖ ថ្ងៃទី ៦ ខែកក្កដា លោក Xi Jinping អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនិស្ត ចិន និង ជា ប្រធាន រដ្ឋ ចិន បាន ថ្លែង ក្នុង កិច្ចប្រជុំ រវាង ថ្នាក់ដឹកនាំ បក្ស កុម្មុយនិស្ត ចិន និង បក្ស នយោបាយ លើ ពិភពលោក ថា ប្រទេស ចិន នឹង ជំរុញ យ៉ាង សកម្ម ចំពោះ ការធ្វើឱ្យ មាន សុក្រឹតភាព នូវ អភិបាលកិច្ចសកល ដើម្បី រួមចំណែក ថ្មី ដល់ ការចាប់ ដៃ គ្នា របស់ មនុស្សជាតិ ក្នុង ការទប់ទល់ នឹង បញ្ហា ប្រឈម រួម ។
លោក Xi Jinping បាន ថ្លែង ថា ច្បាប់ កំណត់ អន្តរជាតិ ត្រូវតែ ជា ច្បាប់ កំណត់ ដែល ប្រទេស នានា លើ ពិភពលោក សុទ្ធតែ ទទួលស្គាល់ តែ មិន ត្រូវ កំណត់ ដោយ មនុស្ស ភាគ តិច នោះ ទេ ។ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស នានា គួរតែ ចាត់ទុក ការបម្រើ មនុស្សជាតិ ទាំងមូល ជា កម្មវត្ថុ តែ មិន មែន ស្វែងរក ការធ្វើ អនុត្តភាព លើ ពិភពលោក ដោយ ក្រុម នយោបាយ មួយ ក្តាប់ តូច នោះ ទេ ។
ភាគី នានា ត្រូវ រួមគ្នា ប្រឆាំង នឹង អនុត្តរភាព និយម និង នយោបាយ អំណាច ខ្លាំង ។ លោក បាន រំលឹក ឡើងវិញ ថា ប្រទេស ចិន ជា សមាជិក មួយ ក្នុង ចំណោម មហា គ្រួសារ នៃ ប្រទេស កំពុង អភិវឌ្ឍន៍ ជាប់ ជានិច្ច ហើយ នឹង ខិតខំ ប្រឹងប្រែង ដោយ មិន ងាក រេ ដើម្បី លើកកម្ពស់ ភាព តំណាង និង សិទ្ធិ បញ្ចេញមតិ របស់ ប្រទេស កំពុង អភិវឌ្ឍន៍ ក្នុង ប្រព័ន្ធ អភិបាលកិច្ច អន្តរជាតិ ។
លោក Xi Jinping បាន គូសបញ្ជាក់ ថា មាគ៌ា ទំនើប ភាវូបនីយកម្ម គ្មាន រូបមន្ត ដាច់ខាត នោះ ទេ រូប មន្ត អភិវឌ្ឍន៍ ដែល សមស្រប នឹង ខ្លួន គឺជា រូបមន្ត ល្អ បំផុត ។ ការខិតខំ ប្រឹងប្រែង របស់ ប្រទេស នីមួយ ៗ ក្នុង ការស្វែងរក មាគ៌ា ទំនើប ភាវូបនីយកម្ម ដែល សមស្រប នឹង សភាពការណ៍ របស់ ប្រទេស ខ្លួន គួរតែ ទទួលបាន ការគោរព ។
ស្ថិត នៅក្នុង ឱកាស ប្រគល់ ប័ណ្ណ សរសើរ និង ថ្លែងអំណរគុណ នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក ង៉ោ សុវណ្ណ បាន ថ្លែង ថា សូម អរគុណ យ៉ាង ជ្រាលជ្រៅ ជា ទីបំផុត ដល់ បងប្អូន ក្រុម គ្រូពេទ្យ ទាំងឡាយ និង ក្រុម អាជ្ញាធរ ទាំងអស់ ដែល បាន ខិតខំ លះបង់ កម្លាំង កាយ ចិត្ត ក្នុង ការចុះ ចាក់ វ៉ាក់សាំង និង រៀបចំ ដំណើរការ នៃ ការចាក់ នេះ ដែល មាន ភាពរលូន ល្អ និង ទទួលបាន ជោគជ័យ គួរឱ្យ សរសើរ ។
លោក បាន កោតសរសើរ ផងដែរ ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ សង្កាត់ កំពង់សំណាញ់ ទាំងអស់ ដែល មាន ការយល់ដឹង ខ្ពស់ ក្នុង ការចូលរួម ទទួលយក ការចាក់ វ៉ាក់សាំង និង ចូលរួម គ្រប់ ៗ គ្នា ដែល នេះ សបញ្ជាក់ ឱ្យ ឃើញ ពី តម្លៃ នៃ សន្តិភាព ដែល ស្រុក ទេស យើង មាន មេដឹកនាំ ខ្លាំង ដែល បាន គិតគូរ សុខទុក្ខ ប្រជាពលរដ្ឋ ទាំង យប់ ទាំង ថ្ងៃ ។
លោក ង៉ោ សុវណ្ណ ក៏ បាន លើកឡើង គុណូប ក្ការៈ ដ៏ ថ្លៃថ្លា បំផុត របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល លោក ខិតខំ យកចិត្តទុកដាក់ ដល់ សុខ មាលភាព ប្រជាជន ទូទាំង ប្រទេស ធ្វើ យ៉ាងណា ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កាច សាហាវ កូវីដ១៩ នេះ ចេញ ឱ្យ អស់ ពី កម្ពុជា ខណៈ ដែល សម្ដេច បាន បញ្ជា ឱ្យ ចាក់ វ៉ាក់សាំង ដល់ ប្រជាពលរដ្ឋ គ្រប់ ៗ រូប ដែល ត្រូវ លក្ខណ ក្នុង ការចាក់ វ៉ាក់សាំង នេះ ។
ទោះ យ៉ាងណា ក៏ លោក ង៉ោ សុវណ្ណ ក៏ នៅតែ បន្ត អំពាវនាវ ពលរដ្ឋ សង្កាត់ កំពង់សំណាញ់ ទាំងអស់ ត្រូតែ បន្ត រួមគ្នា ទប់ស្កាត់ ការឆ្លង ជម្ងឺ កូវីដ១៩ តាម វិធានការ « ៣កុំ និង ៣ការពារ » ឱ្យ បាន ម៉ត់ចត់ ដ្បិត បាន ចាក់ វ៉ាក់សាំង យ៉ាងណា ក្ដី ប៉ុន្តែ វិធានការ ការពារ ក៏ ត្រូវតែ អនុវត្តន៍ ហើយ សូម កុំ ប្រហែល ចំពោះ រឿង នេះ ៕ លោក ផៃ ស៉ី ផាន រំលឹក ថា សម្តេច តេជោ ពុំ បាន សម្រាក ពេញ មួយ យប់ តាមដាន លទ្ធផល កាត់ក្តី ប្រាសាទ ព្រះវិហារ ដាក់ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស ខួប ១៣ ឆ្នាំ នៃ ការដាក់ ប្រាសាទ ព្រះវិហារ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភព នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក លោក ផៃ ស៉ី ផាន ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ថ្លែង សារ រំលឹក ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ពេល នោះ ពុំ បាន សម្រាក ពេញ មួយ យប់ ដើម្បី តាមដាន លទ្ធផល កាត់ក្តី ប្រាសាទ ព្រះវិហារ ដាក់ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក កាលពី ឆ្នាំ ២០០៨ ។
លោក ផៃ ស៉ី ផាន បាន ថ្លែង សារ យ៉ាង ដូច្នេះ៖ « នៅក្នុង នេះ ដែរ ខ្ញុំ នៅ ចាំ បាន ថា សម្តេច តេជោ លោក ពុំ បាន សម្រាក ពេញ មួយ យប់ នៅ តាមដាន លទ្ធផល សម្រេច របស់ គណៈកម្មាធិការ នៅ ក្រុង កេបិច ប្រទេស កាណាដា ។ យើង ចាំ បាន ថា នៅ តាម វត្ត អារាម គ្រឹះស្ថាន រដ្ឋ និង សាលារៀន មាន ពិធី ជួបជុំ ព្រះសង្ឃ មន្ត្រីរាជការ និង សិស្សសាលា ដើម្បី ទូង ស្គរ និង វាយ ជួង នៅ ម៉ោង ៧ ព្រឹក ដើម្បី អបអរសាទរ ប្រាសាទ ព្រះវិហារ បាន ដាក់ បញ្ជូល ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក » ។
លោក ថ្លែង ទៀត ថា « ជាមួយ នេះ ផងដែរ យើងខ្ញុំ សូម គោរព នូវ វិញ្ញាណក្ខ័ន្ធ របស់ សម្តេច វិបុល បញ្ញា សុខ អាន ជាមួយនឹង បទពិសោធន៍ ដែល លោក បាន បន្សល់ទុក ជា មេរៀន និង ប្រវត្តិសាស្រ្ត ដែល សម្រេចបាន ដោយ ជោគជ័យ ដ៏ ធំធេង សម្រាប់ ជាតិ នេះ » ។
សូម ជម្រាប ផងដែរ ថា នៅ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៣ តុលាការ យុត្តិធម៌ ទីក្រុង ឡាអេ បាន សម្រេច រក្សា សេចក្តីសម្រេច ឆ្នាំ ១៩៦២ ដែល ប្តឹង ដោយ សម្តេច ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ ដោយ បញ្ជាក់ ថា ប្រាសាទ ព្រះវិហារ គឺជា របស់ សម្បត្តិ របស់ កម្ពុជា ៕
កងទ័ព និង រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ នឹង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ពលរដ្ឋ នៅ ក្រុង សិរី សោភ័ណ ចាប់ពី ថ្ងៃទី ៩ ខែកក្កដា
( បន្ទាយមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ បាន ចេញ សេចក្តីជូនដំណឹង មួយ ថា នឹង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ប្រជាពល ដោយ ស្ម័គ្រចិត្ត ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង នៅ សង្កាត់ កំពង់ស្វាយ . សង្កាត់ ព្រះពន្លា . សង្កាត់ អូរ អំបិល និង សង្កាត់ ទឹក ថ្លា ក្រុង សិរី សោភ័ណ ។
រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា សម្រាប់ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នេះ ដោយ សហការ ជាមួយ យោធ ភូមិភាគ ទី៥ ដោយ ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ៩ ខែកក្កដា ឆ្នាំ ២០២១ ត ទៅ ចាប់ពី ម៉ោង ៧៖៣០ នាទី ព្រឹក ដល់ ម៉ោង ១១៖៣០ នាទី និង ចាប់ពី ម៉ោង ១រសៀល ដល់ ម៉ោង ៤រសៀល តាម គោលដៅ កំណត់ ចំនួន ៤ ទីតាំង នៅក្នុង ក្រុង សិរិសោភ័ណ ។
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ទៀត ថា ចំពោះ ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូចី ដ១៩ នេះ ប្រជាពលរដ្ឋ ក៏ ដូចជា កម្មករ កម្មការិនី រោងចក្រ ត្រូវ ភ្ជាប់ មក ជាមួយ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ឬ លិខិត ឆ្លង ដែន ឬ បណ្ណ សម្គាល់ ការងារ ឬ សំបុត្រ កំណើត ជាដើម ៕ អាស៊ាន ឯកភាព គ្នា រៀបចំ ព្រឹត្តិការណ៍ ស៉ី ហ្គេម ២០២៣ នៅ កម្ពុជា ឱ្យ ក្លាយជា យុទ្ធនាការ ទាក់ទាញ ទេសចរ អន្តរជាតិ មក អាស៊ាន ឡើងវិញ
( ភ្នំពេញ ) ៖ ប្រទេស សមាជិក អាស៊ាន ទាំង ១០ បាន ឯកភាព គ្នា យ៉ាង ម៉ឺងម៉ាត់ ក្នុង ការសហការ រៀបចំ ព្រឹត្តិការណ៍ កីឡា ស៉ី ហ្គេម ឆ្នាំ ២០២៣ ឱ្យ ក្លាយជា យុទ្ធនាការ ទាក់ទាញ ភ្ញៀវ ទេសចរ អន្តរជាតិ ឱ្យ មក ទស្សនា នៅក្នុង តំបន់ អាស៊ាន ឡើងវិញ ក្រោយ មាន ការធ្លាក់ចុះ ដោយសារ វិបត្តិ ជំងឺ កូវីដ - ១៩ ចូលមក រំខាន ដល់ ការធ្វើដំណើរ របស់ ភ្ញៀវ អន្តរជាតិ ចូលមក ក្នុង តំបន់ នេះ ។
ការឯកភាព គ្នា នេះ ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ស្ថាប័ន ទេសចរណ៍ ជាតិ អាស៊ាន លើក ទី ៥៤ តាម ប្រព័ន្ធ អនឡាញ នា ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ ដឹកនាំ ដោយ កម្ពុជា ។
នា ឱកាស នោះ ដែរ តំណាង ប្រទេស សមាជិក អាស៊ាន បាន ដាក់ចេញ នូវ គំនិត ផ្តួចផ្តើម និង ផែនការស្តារ វិស័យ ទេសចរណ៍ អាស៊ាន នៅពេល ខាងមុខ ជាពិសេស បាន សម្រេច រៀបចំ សកម្មភាព ផ្សព្វផ្សាយ ទេសចរណ៍ អាស៊ាន ដោយ យក ព្រឹត្តិការណ៍ កីឡា ស៊ីហ្គេម ២០២៣ (SEA Game 2023) ជា ព្រឹត្តិការណ៍ ទាក់ទាញ ទេសចរ អន្តរជាតិ មក ទស្សនា តំបន់ របស់ ខ្លួន ។
ក្រសួង ទេសចរណ៍ កម្ពុជា បាន បញ្ជាក់ ថា ការរៀបចំ ផែនការផ្សព្វផ្សាយ នេះ នឹង ពិភាក្សា លម្អិត ក្នុង កម្រិត គណៈកម្មាការ ទេសចរណ៍ អាស៊ាន ។
ស្រប នឹង គំនិត ផ្តួចផ្តើម នេះ អាស៊ាន ក៏ បាន ឯកភាព លើ ការដាក់ ឲ្យ អនុវត្ត នៅពេល ខាងមុខ នូវ ផែន ការស្តារ វិស័យ ទេសចរណ៍ អាស៊ាន អម ដោយ ការរៀបចំ គោលការណ៍ អាស៊ាន រួម ស្តីពី អនាម័យ និង សុវត្ថិភាព ដែល នឹង ដាក់ ឲ្យ ប្រើប្រាស់ ក្នុង ឆ្នាំ ២០២១ នេះ ។
សូម រំលឹក ថា ប្រទេស សមាជិក អាស៊ាន ទាំងអស់ រួមទាំង កម្ពុជា ផងដែរ បាន និង កំពុង រៀបចំ បើក ទទួល ឡើងវិញ នូវ វិស័យ ទេសចរណ៍ អន្តរជាតិ របស់ ខ្លួន ៕ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ណែនាំ ផ្ទាល់ មាត់ ទៅកាន់ អាវុធហត្ថ ទូទាំង ប្រទេស លើ ការងារ បង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ និង បញ្ជា ឲ្យ រៀបចំ បន្ទាយ ឡុង ឈិន ដើម្បី ជា កន្លែង ព្យាបាល កម្រិត ស្រាល (Video inside)
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នៅ ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ធ្វើ ការណែនាំ ដោយ ផ្ទាល់ មាត់ តាមរយៈ សារ អេឡិចត្រូច និច ទៅកាន់ ថ្នាក់ដឹកនាំ និង មន្ដ្រី អាវុធហត្ថ ទូទាំង ប្រទេស លើ ការងារ ទប់ស្កាត់ និង បង្ការ ជំងឺ កូវីដ១៩ ក្នុង ជួរ អាវុធហត្ថ ។
បន្ថែម ពី នេះ ដើម្បី ធានា សុវត្ថិភាព ក្នុង ជួរ អង្គភាព ចំណុះ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន ណែនាំឲ្យ រៀបចំ បញ្ជី ឈ្មោះ មន្ដ្រី អាវុធហត្ថ ដើម្បី ធ្វើតេស្ដរហ័ស រក ជំងឺ កូវីដ១៩ បន្ទាន់ ភ្លាម ៗ ៕
សូម ស្ដាប់ ខ្លឹមសារ ណែនាំ របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា នៅ ខាងក្រោម នេះ៖
មន្ទីរ សាធារណការ រាជធានី ភ្នំពេញ និង JICA ចុះ ពិនិត្យ ប្រព័ន្ធ លូ ខ្នាត ធំ ក្រោម ដី នៅ តំបន់ វត្តភ្នំ
( ភ្នំពេញ ) ៖ ក្រុមការងារ នៃ គម្រោង ការពារ ទឹក ជំនន់ និង កែលម្អរ ប្រព័ន្ធ ប្រឡាយ លូជំហាន ទី៤ របស់ JICA និង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ បាន ចុះ ត្រួតពិនិត្យ ប្រព័ន្ធ លូ ក្រោម ដី ជាច្រើន រយ ម៉ែត្រ នៅ ផ្លូវ លេខ ៤៧ នៅ ខាងជើង វត្តភ្នំ និង ចុះ ពិនិត្យមើល ការសាងសង់ ស្ថានីយ៍ បូម ទឹកមុខ CDC ជាប់ ដង ទន្លេ សាប ស្ថិត ក្នុង សង្កាត់ ស្រះចក ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ដែល ជា ជំនួយ ឥត សំណង របស់ ជប៉ុន តារយៈ JICA ។
លោក បន្ត ទៀត ថា ស្ថានីយ៍ បូម ទឹក ថ្មី នេះ ជា ស្ថានីយ៍ បូម ទឹក ទី៦ ដែល មាន សមត្ថភាព បូម ទឹក បាន ១.៤ម៉ែត្រ គូប ក្នុង ១វិនាទី ជាមួយ ការបំពាក់ ម៉ាស៊ីន ស្វ័យប្រវត្តិ ចាប់ សំរាម ផងដែរ ។ គម្រោង នេះ គ្រោង នឹង ភ្ជាប់ លូ ផ្សេង ៗ ទៀត ចូលមក ប្រព័ន្ធ លូមេ ថ្មី នេះ នៅក្នុង អំឡុង ខែតុលា ខាងមុខ នេះ ។ ក្រោយ បញ្ចប់ គម្រោង នេះ ហើយ វា អាច រំដោះ ទឹកភ្លៀង ចេញ ពី តំបន់ ផ្នែក ខាងជើង វត្តភ្នំ និង ខាងកើត មហាវិថី ព្រះមុនីវង្ស រហូតដល់ ស្ពាន ជ្រោយ ចង្វា និង មួយ ផ្នែក ខ្លះ ទៀត នៅ ខណ្ឌ ទួលគោក ។
គួរ បញ្ជាក់ ថា គម្រោង ការពារ ទឹក ជំនន់ និង កែលម្អ ប្រព័ន្ធ ប្រឡាយ លូជំហាន ទី៤ ក្នុង រាជធានី ភ្នំពេញ ត្រូវបាន បើក ការដ្ឋាន សាងសង់ កាលពី ថ្ងៃទី ០៤ ខែមិនា ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។ គម្រោង នេះ ប្រើប្រាស់ ទឹកប្រាក់ សរុប ប្រមាណ ៣៦ លាន ដុល្លារ សហរដ្ឋ អាមេរិក ដែល ជា ជំនួយ ឥត សំណង របស់ រដ្ឋាភិបាល ជប៉ុន ដែល គម្រោង នេះ រួម មាន ការសាងសង់ អាង ស្តុក ទឹក ក្រោម ដី ស្ថានីយ៍ បូម ទឹក របារ ត្រង់ សំរាម មេ កានិច ស្វ័យប្រវត្តិ រថយន្ត បំពាក់ ម៉ាស៊ីន បូម ទឹក ៕
អាជ្ញាធរ រាជធានី ភ្នំពេញ បាន និង កំពុង ជួសជុល ផ្លូវ និង ដាក់ បណ្ដាញ លូ ផ្លូវ ២០០៤
លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ចាត់ ក្រុមការងារ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ឲ្យ ដាក់ គ្រឿងចក្រ ធ្វើ ការជួសជុល ផ្លូវ និង ដាក់ បណ្ដាញ លូ ផ្លូវ នេះ បន្ទាន់ និង ការដាក់ លូ ជាច្រើន ខ្សែ ទៀត នៅ អម ទីតាំង នេះ ផងដែរ ដើម្បី សម្រួល ចរាចរណ៍ ជូន ប្រជាពលរដ្ឋ និង ការដោះស្រាយ ការលិចលង់ ដោយ ជំនន់ ទឹកភ្លៀង ។
មន្ត្រី ជំនាញ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា កំណាត់ ផ្លូវ សម្ដេច ចៅហ្វា វាំង គង់ សំអុល ក្រុមការងារ នៃ មន្ទីរ សាធារណៈ ការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ពេលនេះ បាន និង កំពុង ធ្វើ ការជួសជុល ដោយ ចាក់ បេតុង ឆ្អឹង ដែក កំរាស់ ២តឹក ចាប់ពី ផ្លូវ លេខ ២៧១ រហូតដល់ អតីត បញ្ជរបង់ប្រាក់ មាន ប្រវែង ២០៩ ម៉ែត្រ និង ទទឹង ពី ១៨ម៉ែត្រ ទៅ២០ ម៉ែត្រ ស្ថិត ក្នុង មូលដ្ឋាន ខណ្ឌ សែនសុខ ។
ជាមួយនឹង ការជួសជុល កំណាត់ ផ្លូវ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ មាន ការដាក់ ប្រព័ន្ធ លូ បង្ហូរ ទឹក ទំហំ ១ម៉ែត្រ សង្ខាង ផ្លូវ ដាក់ លូកាត់ ទទឹង ផ្លូវ ទំហំ ១ម៉ែត្រ ២តឹក ចំនួន ២ខ្សែ ដោយ ភ្ជាប់ ទៅ លូ នៅ ផ្លូវ ៣៧១ ផងដែរ ។
មន្ត្រី ដដែល បាន បន្ត ឱ្យដឹង ទៀត ថា ក្រៅពី ការងារ ខាងលើ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ មាន ការកែលម្អ ប្រព័ន្ធ លូ ចំណុច ប្រសព្វ ផ្លូវ សម្ដេច ចៅហ្វា វាំង គង់ សំអុល កែង ផ្លូវ ៣៧១ ផងដែរ ដោយ ដាក់ លូជ្រុង (U) ដើម្បី ដោះស្រាយ ការលិច ដោយ ជំនន់ ទឹកភ្លៀង នៅ តំបន់ នេះ ៕ មន្ត្រី ជាន់ ខ្ពស់ សាធារណការ ស្នើ ភាគី សាងសង់ ផ្លូវ ៣៨ ខ្សែ ក្នុង ក្រុង សៀមរាប ជួយ សន្សំ សំចៃ ថវិកា ជាតិ ឱ្យ អស់ កាន់តែ តិច តែ ទទួលបាន ផ្លូវ រឹងមាំ ជាប់ បាន យូរ
( ភ្នំពេញ ) ៖ លោក សួង ហេង រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ស្នើ ឱ្យ គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន ចូលរួម សាងសង់ ផ្លូវ ៣៨ ខ្សែ ក្នុង ក្រុង សៀមរាប ជួយ កាត់បន្ថយ ការចំណាយ ថវិកា សន្សំ សំចៃ ថវិកា ជាតិ ឱ្យ អស់ កាន់តែ តិច តាម ដែល អាច ធ្វើ ទៅ បាន ប៉ុន្តែ ត្រូវ រក្សា បាន នូវ គុណភាព ផ្លូវ រឹងមាំ ប្រើប្រាស់ ជាប់ បាន យូរអង្វែង ។
លោក សួង ហេង បាន ស្នើ យ៉ាង ដូចនេះ នា ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ ក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ ចរចា ថ្លៃ ការសាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ៣៨ ខ្សែ ក្នុង ក្រុង សៀមរាប ខេត្ត សៀមរាប ដោយ មាន ការចូលរួម ដោយ ផ្ទាល់ ពី ថ្នាក់ដឹកនាំ ក្រសួង ទទួលបន្ទុក និង ការចូលរួម តាម ប្រព័ន្ធ វីដេអូ ចម្ងាយ ពី តំណាង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ អង្គភាព សាងសង់ ផ្លូវ ៣៨ ខ្សែ ក្រុមការងារ ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស សាងសង់ និង ភាគី ពាក់ព័ន្ធ ផងដែរ ។
បន្ថែម ពី នេះ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ រូប នេះ ក៏ បាន ស្នើ ឱ្យ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ជួយ ពន្លឿន ការ រៀបចំ កិច្ចសន្យា ការងារ សាងសង់ ដើម្បី អាច បើក ផ្ដល់ ថវិកា ជូន ដល់ អង្គភាព សាងសង់ ទាំងអស់ តាម ពេល កំណត់ ផងដែរ ។
សូម ជម្រាប ជូន ថា យោង តាម របាយការណ៍ របស់ អគ្គ នាយកដ្ឋាន បច្ចេកទេស នៃ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន វឌ្ឍនភាព គម្រោង សាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ចំនួន ៣៨ ខ្សែ នៅ ក្រុង សៀមរាប ខេត្ត សៀមរាប នេះ គិត ត្រឹម ថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ២០២១ សម្រេច លទ្ធផល ការងារ បាន ៦៣. ៨៧% ហើយ ៕ អាជ្ញាធរ សម្រេច ផ្អាក ជា បណ្តោះអាសន្ន ផ្សារ ដើម ស្រល់ ស្ថិត នៅ ភូមិ២ ខណ្ឌ ជ្រោយ ចង្វារ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩
មជ្ឈមណ្ឌល CCSA បាន គូសបញ្ជាក់ ប្រាប់ ថា ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ៦.៤៦៤ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ទូទៅ ខណៈ ៥៥ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។
មជ្ឈមណ្ឌល CCSA បាន គូសបញ្ជាក់ ប្រាប់ បន្ថែម ថា ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ អ្នកជំងឺ ចំនួន ៥៤ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ នៅក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ហើយ អ្នកជំងឺ ចំនួន ៤.១៤៨ នាក់ ផ្សេង ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង នឹង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ ជូន ពលរដ្ឋ នៅ ក្រុង ស្វាយរៀង ចាប់ពី ថ្ងៃទី ៨ ខែកក្កដា ស្អែក នេះ
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន ចេញ សេចក្តីជូនដំណឹង មួយ ថា នឹង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ កម្មករ - កម្ម ការិនី ដោយ ស្ម័គ្រចិត្ត ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង ទៅ ចាប់ពី ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២១ ត ទៅ ចាប់ពី ម៉ោង ៧៖៣០ នាទី ព្រឹក ដល់ ម៉ោង ១១៖៣០ នាទី និង ចាប់ពី ម៉ោង ១រសៀល ដល់ ម៉ោង ៤រសៀល តាម គោលដៅ កំណត់ ចំនួន ៧ ទីតាំង នៅក្នុង ក្រុង ស្វាយរៀង ។
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ទៀត ថា ចំពោះ ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូចី ដ១៩ នេះ ប្រជាពលរដ្ឋ ក៏ ដូចជា កម្មករ កម្មការិនី រោងចក្រ ត្រូវ ភ្ជាប់ មក ជាមួយ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ឬ លិខិត ឆ្លង ដែន ឬ បណ្ណ សម្គាល់ ការងារ ឬ សំបុត្រ កំណើត ជាដើម ៕ ដំណឹង មរណភាព ! ម្តាយ បង្កើត លោក សុក ផេង រដ្ឋលេខាធិការ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី បាន ទទួលមរណភាព ក្នុង ជន្មាយុ ៩០ ឆ្នាំ ដោយ រោគា ពាធ
( ភ្នំពេញ ) ៖ ឧបាសិកា គួន សុខា ( ហៅ ហ្គូយ ហ្គេច បួយ ) ជា មាតា បង្កើត របស់ លោក សុក ផេង រដ្ឋលេខាធិការ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី និង ជា អនុប្រធាន ក្រុមប្រឹក្សា អ្នក ច្បាប់ បាន ទទួលមរណភាព នា ថ្ងៃអង្គារ ១២រោច ខែ បឋ មាសាឍ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស . ២៥៦៥ ត្រូវនឹង ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ វេលា ម៉ោង ១៩៖០០ នាទី ក្នុង ជន្មាយុ ៩០ ឆ្នាំ ដោយ រោគា ពាធ ។
ឧបាសិកា គួន សុខា កើត ឆ្នាំ ១៩៣១ នៅ ស្រុក អង្គស្នួល ខេត្ត កណ្តាល បាន ឆ្លងកាត់ សម័យ អាណានិគម និយម ចាស់ ថ្មី និង របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ក្រោយមក ក៏ ត្រូវ បែក ស្វាមី ជារៀងរហូត ក្លាយ ខ្លួន ជា ស្ត្រី មេម៉ាយ ដែល ត្រូវ ចិញ្ចឹម កូន ចំនួន ៧នាក់ ( ស្រី ២នាក់ ) ជម្នះ គ្រប់ ឧបសគ្គ រហូត មាន អនាគត ល្អ គ្រប់ ៗ គ្នា និង មាន កិត្តិយស ក្នុង សង្គម ។
ដោយសារ ការរីករាល នៃ ជំងឺ កូវីដ១៩ និង ការគោរព តាម វិធានការ សុខាភិបាល ក្រុមគ្រួសារ សព នឹង រៀបចំ កម្មវិធី បុណ្យ ប្រពៃណី ៧ ថ្ងៃ ជា លក្ខណៈ ក្រុមគ្រួសារ ក្នុង ចំណោម កូន បង្កើត របស់ ឧបាសិកា នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២១ នៅ វត្ត ចំពុះ ក្អែក ដោយ ពុំ មាន ការចូលរួម ពីសំណាក់ សាធារណជន នោះ ទេ ។
សេចក្តីជូនដំលឹង នេះ ជា ការគោរព ជម្រាប ជូន លោក លោកស្រី និង សាធារណជន ទាំងអស់ ដើម្បី ជូន ជ្រាប និង មេត្តា ចូលរួម រំលែក មរណទុក្ខ ជាមួយ លោក សុក ផេង និង បងប្អូន ញាតិមិត្ត ជិត ឆ្ងាយ នៃ ក្រុមគ្រួសារ សព ៕ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង ទទួល អំណោយ ជា បន្តបន្ទាប់ពី មន្ត្រី សង្ឃ និង សប្បុរសជន ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( កំពង់ឆ្នាំង ) ៖ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង និង មន្ត្រី រដ្ឋបាល សាលា ខេត្ត កំពង់ឆ្នាំង បាន ទទួល អំណោយ ជា បន្តបន្ទាប់ពី មន្រី្ដសង្ឃ និង សប្បុរសជន ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នា ព្រឹក ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ ម្សិលមិញ ។
លោក សាង អ៊ាប ជា តំណាង ដឹកនាំ អំណោយ ក្រុម ទី៣ ខាងលើ នេះ បាន ឱ្យដឹង ថា អំណោយ ដែល លោក ដឹកនាំ មក នេះ ជា របស់ លោក សមូហក បណ្ឌិត ឡី សុភាព ផ្តល់ ជូន អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង ក្នុង នោះ មាន ទឹក លាងសំអាត បំបាត់ ក្លិន ចំណុះ ១០០ មីលីត្រ ចំនួន ១កេស . ទឹក លាងសំអាត បំបាត់ ក្លិន ចំណុះ ៥០០ មីលីត្រ ចំនួន ១កេស . ជែល លាងសំអាត ដៃ ចំណុះ ១០០ មីលីត្រ ចំនួន ៥កេស . ម៉ាស ចំនួន ២កេស ធំ និង ម៉ាស៊ីន វាស់ កំដៅ ចំនួន ៣គ្រឿង សរុប ទឹកប្រាក់ មាន ចំនួន ១.៨៨០ ដុល្លារ ។
ក្នុង ឱកាស នោះ ដែរ លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត កំពង់ឆ្នាំង និង លោកស្រី ប៊ន សុភី អភិបាល រង ខេត្ត ក៏ បាន ថ្លែង នៅអំណរ ព្រះគុណ ដល់ មន្ត្រី សង្ឃ គង្គ ក្នុង វត្ត ទាំង៣ និង អរគុណ ដល់ សប្បុរសជន ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ រួមគ្នា ផ្តល់ អំណោយ ជា សម្ភារៈ សម្រាប់ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នា ពេលនេះ ។
លោក ស៊ុន សុវណ្ណា រិទ្ធិ សូម សន្យា ថា នឹង យក ទេយ្យ ទាន មាន អង្ករ និង សម្ភារៈ ផ្សេង ៗ ទៀត ទៅ ចែកជូន ប្រជាពលរដ្ឋ កំពុង ធ្វើចត្តាឡី ស័ក នៅ តាម លំនៅដ្ឋាន ។ ចំណែក សម្ភារៈ មួយចំនួន ទៀត និង យក ទៅតាម មណ្ឌល ចត្តាឡី ស័ក ក្នុង ខេត្ត កំពង់ឆ្នាំង សម្រាប់ ជូន ប្រជាពលរដ្ឋ ប្រើប្រាស់ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ជាមួយគ្នា នេះ ដែរ លោក អភិបាល ខេត្ត ក៏ បាន រាយការណ៍ ពី ស្ថានភាព ជំងឺ កូវីដ១៩ កំពុងតែ មាន សន្ទុះ កើនឡើង នៅក្នុង ខេត្ត កំពង់ឆ្នាំង ក៏ ដូចជា នៅ ទូទាំង ប្រទេស ផងដែរ ។
លោក ក៏ បាន បន្ដ ថា ចំពោះ អំណោយ ដែល ទទួលបាន នៅ ពេល នេះ គឺ ស្រប ទៅនឹង កាលៈទេសៈ ដែល រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង ត្រូវការ ជា ចាំបាច់ សម្រាប់ ចែកជូន ជូន ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ ក្នុង ការរួមគ្នា ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។
( កោះកុង ) ៖ ប្រព័ន្ធ លូរ រំដោះ ទឹក នៅមុខ លំនៅដ្ឋាន ប្រជាពលរដ្ឋ រស់ នៅ តាម បណ្តោយ ដង ផ្លូវ ស្ថិត ភូមិ ៣ សង្កាត់ ស្មាច់ មានជ័យ ក្រុង ខេមរភូមិន្ទ ខេត្ត កោះកុង ដែល ជួបប្រទះ នៅ ការលិចលង់ នៅក្នុង រដូវ វស្សា ពិបាក ក្នុង ការធ្វើចរាច ចេញ ចូល ត្រូវបាន សាងសង់ រួច និង ត្រូវបាន ក្រុមការសាងសង់ ជួសជុល ទីលាន ផ្នូរ យុទ្ធជន ខេត្ត ប្រគល់ ជូន អាជ្ញាធរ ក្រុង សម្រាប់ គ្រង គ្រង វិញ នៅ ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ តទៅ ។
ការប្រគល់ ប្រព័ន្ធ លូរ និង រឺហ្កា ជូន អាជ្ញាធរ ក្រុង គ្រប់គ្រង វិញ ដោយ មាន ការចូលរួម ក្រោម វត្តមាន លោក វរសេនីយ៍ ឯក ប្រាក់ យន្ត មេបញ្ជាការ រង តំបន់ ប្រតិបត្តិការ សឹក រង កោះ កុង និង ជា ប្រធាន ក្រុមការងារ សាងសង់ ជួសជុល ទីលាន ផ្នូរ យុទ្ធជន ខេត្ត កោះកុង លោក ទួន ភារម្យ អភិបាល រង ក្រុង ខេមរភូមិន្ទ លោក ចៅសង្កាត់ ស្មាច់ មាន ជ័យ មេភូមិ និង ប្រជាពលរដ្ឋ ផងដែរ ។
លោក បាន បន្ថែម ថា ក្រោយពី ការសាសង ស្ថាបនា ប្រព័ន្ធ លូរ រំដោះ ទឹក រួចរាល់ ហើយ នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ដោយ មាន អនុញ្ញាត ពី នាយ ឧត្តមសេនីយ៍ យន្ត មីន ក្រុមការងារ បាន ប្រគល់ ទៅ ឱ្យ អាជ្ញាធរ ក្រុង គ្រប់គ្រង វិញ ចាប់ពី ថ្ងៃ នេះ តទៅ ។
ក្នុង ឱកាស លោក វរសេនីយ៍ ឯក ប្រាក់ យន្ត បាន បង្ហើប ឱ្យដឹង ថា ការសាងសង់ ជួសជុល ផ្នូរ យុទ្ធជន បាន ប្រហែល ៦០ ភាគរយ ហើយ តែ ក្នុង ឆ្នាំ ២០២២ គឺ រួចរាល់ ក្នុង ការសាងសង់ ។
ខេត្ត សៀមរាប បន្ត រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៥១ នាក់ បន្ថែម ទៀត
រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា ករណី ទី១ ដល់ ទី ១៥ ជា ករណី ពុំ ទាន់ អាច សន្និដ្ឋាន ពី ប្រភព ចម្លង ច្បាស់លាស់ នៅឡើយ ។ ករណី ទី ១៦ដល់ ទី ២៨ ជា ករណី មាន ប្រភព ចម្លង ចេញ ពី ផ្សារ លើ ធំ ថ្មី ។ ចំពោះ ករណី ទី២៩ ដល់ ករណី ទី ៣១ មាន ប្រភព ចម្លង ចេញពី សង្កាត់ ស្រង៉ែ ។ ដោយឡែក ករណី ទី ៣២ ជា ករណី អ្នកធ្វើដំណើរ មកពី ខេត្ត បន្ទាយមានជ័យ និង ករណី ទី៣៣ ដល់ ទី៥១ គឺជា ប្រជាពលរដ្ឋ ត្រឡប់ ពី ប្រទេស ថៃ មកដល់ ខេត្ត សៀមរាប ហើយ ជា ករណី សង្ស័យ ត្រូវបាន ក្រុម គ្រូពេទ្យ ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក នៅ វិទ្យាល័យ សម្តេច ឪ ។
រដ្ឋបាល ខេត្ត សៀមរាប សូម ជម្រាប ជូន ប្រជាពលរដ្ឋ ដែល បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ឬ ដោយ ប្រយោល ជាមួយ អ្នកវិជ្ជមាន ខាងលើ សូម រួសរាន់ ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ ក្នុង ក្រុមគ្រួសារ រៀង ៗ ខ្លួន ឱ្យ បាន គ្រប់ ១៤ ថ្ងៃ ដោយ មិន ត្រូវ ពាក់ព័ន្ធ និង ប៉ះពាល់ ជាមួយ អ្នកដទៃ ជាដាច់ខាត ក្នុង ករណី មិន អនុវត្ត កាតព្វកិច្ចចត្តាឡី ស័ក រដ្ឋបាល ខេត្ត នឹង ចាត់ វិធានការ ផ្លូវ ច្បាប់ ចំពោះ បុគ្គល ទាំងឡាយ ណា ដែល ល្មើស នឹង វិធាន សុខាភិបាល នេះ ។
( ប៉េកាំង ) ៖ លោក Xi Jinping អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនិស្ត ចិន និង ជា ប្រធាន រដ្ឋ ចិន បាន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល រវាង ថ្នាក់ដឹកនាំ នៃ បក្ស កុម្មុយនិស្ត ចិន និង គណបក្ស នយោបាយ ពិភពលោក នា ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២១ ដោយ បាន គូសបញ្ជាក់ ថា វិធីសាស្ត្រ ក្នុង ការសម្រេច ប្រជាធិបតេយ្យ គឺ មាន ច្រើន បែប យ៉ាង មិន អាច ដូចគ្នា ទាំងស្រុង នោះ ទេ ។ តើ ប្រទេស មួយ មាន ប្រជាធិបតេយ្យ ឬ អត់ គឺ ត្រូវ វាយតម្លៃ ដោយ ប្រជាជន របស់ ប្រទេស នោះ តែ មិន មែន ដោយ ប្រទេស មួយចំនួន តូច នោះ ទេ ។
លោក Xi Jinping បាន ថ្លែង ថា មាគ៌ា ឆ្ពោះ ទៅរក សុភមង្គល គឺ ខុស ៗ គ្នា ប្រជាជន គ្រប់ ប្រទេស មាន សិទ្ធិ ដើម្បី ជ្រើសរើស មាគ៌ា អភិវឌ្ឍន៍ និង រូបមន្តរបប របស់ ខ្លួន ។ គណបក្ស នយោបាយ ត្រូវ បន្ត បង្កើន សមត្ថភាព ស្វែងរក សុភមង្គល ជូន ប្រជាជន ទំនួល ខុសត្រូវ នៃ ការបង្កើន កិច្ចសហប្រតិបត្តិការ ចាប់ ដៃ គ្នា ដើម្បី ទប់ទល់ នឹង គ្រោះមហន្តរាយ និង បញ្ហា ប្រឈម ជា សកល ។
របាយការណ៍ ថ្មី ចុងក្រោយ បាន បង្ហាញ ថា ក្រុម ភ្នាក់ងារ ពន្លត់ អគ្គីភ័យ កំពុងតែ ប្រឹងប្រែង គ្រប់គ្រង ការរាលដាល និង ពន្លត់ ភ្លើង ឆេះ ព្រៃ ខាងលើ នៅ តាម តំបន់ ភ្នំ ព្រមទាំង ជួយ រៀបចំ ការ ការពារ សំណង់ ផ្សេង ៗ នៅ តាម សហគមន៍ ជិតខាង ដែល មកទល់ ពេលនេះ អគារ ប្រហែលជា ៤១ ខ្នង ក្នុង នោះ រួម មាន ផ្ទះសម្បែង ២៧ ខ្នង បាន រង ការខូចខាត ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ដឹកនាំ លោក ថោង រដ្ឋសក្តិ អគ្គ នាយក អភិវឌ្ឍន៍ ទេសចរណ៍ និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ក្រសួង ទេសចរណ៍ ដោយ បាន ពិភាក្សា អំពី គម្រោង បើក ទេសចរណ៍ ក្នុង តំបន់ អាស៊ាន ឡើងវិញ ប្រកបដោយ ការទទួលខុសត្រូវ និង សុវត្ថិភាព ។
កិច្ចប្រជុំ ក៏ បាន ពិភាក្សា លើ ការងារ ទេសចរណ៍ អាស៊ាន ដែល បាន អនុវត្ត កន្លងមក និង បន្ត ពិនិត្យ លើ ការងារ មួយចំនួន បន្ថែម ទៀត សំដៅ ត្រៀម រៀបចំ ខ្លួន បើក វិស័យ ទេសចរណ៍ ឡើងវិញ រួម មាន ជា អាទិ៍៖
១៖ ការអនុវត្ត យុទ្ធសាស្រ្ត ទីផ្សារ ទេសចរណ៍ អាស៊ាន ២០២១ - ២០២៥ សំដៅ ផ្សព្វផ្សាយ ពី ការរៀបចំ ខ្លួន រួចរាល់ ក្នុង ការទទួល ទេសចរណ៍ អន្តរជាតិ និង បង្កើន ទំនុកចិត្ត ដល់ ភ្ញៀវ ទេសចរ ។
៣៖ គោលការណ៍ ណែនាំ ស្តីពី អនាម័យ និង សុវត្ថិភាព សម្រាប់ អ្នកធ្វើការ និង សហគមន៍ ក្នុង ឧស្សាហកម្ម ទេសចរណ៍ ។
៤៖ ការសិក្សា លើ ផល ប៉ះពាល់ នៃ វិបត្តិ កូវីដ - ១៩ គោល នយោបាយ និង ការអនុវត្ត ល្អ បំផុត អនុសាសន៍ សម្រាប់ ផែនការស្តារ ឡើងវិញ ក្រោយ វិបត្តិ កូវីដ - ១៩ សម្រាប់ ទេសចរណ៍ អាស៊ាន ។
៥៖ ផែនការ សកម្មភាព ស្តីពី សេចក្តីថ្លែងការណ៍ ភ្នំពេញ ស្តីពី ទេសចរណ៍ អាស៊ាន ប្រកបដោយ និរន្តភាព បរិយា បន្ន និង ភាពរឹងមាំ ។
គួរ បញ្ជាក់ ថា កិច្ចប្រជុំ មន្ត្រី ជាន់ ខ្ពស់ ទេសចរណ៍ ជាតិ អាស៊ាន លើក ទី ៥៤ នេះ នឹង ប្រព្រឹត្តទៅ ពេញ មួយ ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ ភ្ជាប់ ជាមួយ កិច្ចប្រជុំ មន្ត្រី ជាន់ ខ្ពស់ ទេសចរណ៍ ជាតិ អាស៊ាន បូក បី និង កិច្ចប្រជុំ មន្ត្រី ជាន់ ខ្ពស់ ទេសចរណ៍ ជាតិ អាស៊ាន បូក បី បូក ឥណ្ឌា នៅ ថ្ងៃទី ០៨ ខែកក្កដា ឆ្នាំ ២០២១ ៕
រដ្ឋបាល ខេត្ត តាកែវ ចាប់ផ្តើម ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ពលរដ្ឋ ក្រុង ដូន កែវ ចាប់ពី ថ្ងៃទី ០៩ ខែកក្កដា
( តាកែវ )៖ រដ្ឋបាល ខេត្ត តាកែវ នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង មួយ ស្ដីពី ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ជូន ប្រជាពលរដ្ឋ នៅ ក្រុង ដូន កែវ ចាប់ពី ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០២១ ខាងមុខ នេះ ។
បើ តាម សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខត្ត តាកែវ ការចាក់ ថ្នាំ បង្ការ ជំងឺ កូវីដ១៩ ធ្វើឡើង នៅ ទីតាំង មន្ទីរ សុខាភិបាល ខេត្ត មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ការិយាល័យ ស្រុក ប្រតិបត្តិ ដូន កែវ សាលា សង្កាត់ រកា ក្រៅ និង សាលា សង្កាត់ បារាយណ៍ ។
ផ្អែក តាម គោលការណ៍ ណែនាំ ការយក សំណាក ធ្វើតេស្តិ៍រហ័ស (Rapid Test) ដល់ មន្រ្តី នគរបាល ដែល មាន ភារកិច្ច ចេញ - ចូល បំពេញ ភារកិច្ច ក្នុង បរិវេណ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នឹង ត្រូវ អនុវត្ត រៀងរាល់ មួយ សប្តាហ៍ ម្តង ដើម្បី ចូលរួម បង្ការ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។ ចំពោះ មន្ត្រី នគរបាល ដែល ពិនិត្យ ឃើញ វិជ្ជមាន មេរោគ កូវីដ - ១៩ តាមរយៈ ការយកសំណាក់ ធ្វើតេស្តិ៍ រហ័ស នេះ ត្រូវបាន បញ្ជូន ទៅ ធ្វើ PCR តេស្ត ដើម្បី ផ្ទៀងផ្ទាត់ លទ្ធផល មុន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ ទីកន្លែង ដែល បាន កំណត់ ។
នៅ កន្លែង បញ្ជរ យក សំណាក ធ្វើតេស្ត លោក ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន អគ្គ ស្នងការ រង នគរបាល ជាតិ បាន ក្រើន រំលឹក និង ជំរុញ ស្មារតី ចំពោះ កងកម្លាំង នគរបាល ជាតិ ដែល មាន ភារកិច្ច បំពេញ ការងារ ប្រចាំ ថ្ងៃ តាម ការចាត់តាំង របស់ អង្គភាព ត្រូវ ចូលរួម គោរព និង អនុវត្ត ការយក សំណាក ធ្វើតេស្ត រហ័ស នេះ តាម គោលការណ៍ ណែនាំ របស់ ថ្នាក់ដឹកនាំ អគ្គ ស្នងដ្ឋាន ការ នគរបាល ជាតិ និង សូម កុំ មាន ការព្រួយបារម្ភ ភ័យខ្លាច ចំពោះ ការយក សំណាក ធ្វើតេស្ត នេះ ។
លោក ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន ថ្លែង ថា បើ ចៃដន្យ មន្ត្រី ណា ម្នាក់ វិជ្ជមាន កូវីដ - ១៩ អង្គភាព អាច ពិនិត្យ លទ្ធភាព ជួយ អន្តរាគមន៍ ដោះស្រាយ បញ្ជូន ទៅ សង្គ្រោះ និង ពិនិត្យ ព្យាបាល បាន ទាន់ ពេលវេលា ព្រមទាំង មាន វិធានការ បង្ការ ទប់ស្កាត់ ការឆ្លង រាលដាល ពី មន្ត្រី ម្នាក់ ទៅ មន្ត្រី ម្នាក់ ទៀត នៅ កន្លែង ធ្វើការ បាន ទាន់ ពេលវេលា ផងដែរ ។
សំណើ នេះ បាន ធ្វើឡើង នៅក្នុង សន្និសីទ ដែល បាន ធ្វើឡើង នៅ យប់ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ ដែល មាន ប្រទេស ចិន ជា ម្ចាស់ ផ្ទះ ។ សន្និសីទ ដែល ធ្វើឡើង ក្រោម ប្រធានបទ « ការធ្វើការ ដើម្បី សុភមង្គល ប្រជាជន៖ ទំនួល ខុសត្រូវ របស់ គណបក្ស នយោបាយ » នេះ មាន ការអញ្ជើញ ចូលរួម ដោយ គណៈប្រតិភូ ជាង ១០.០០០ នាក់ តំណាង ឱ្យ គណបក្ស នយោបាយ និង អង្គការ ជាង ៥០០ មកពី ១៦០ ប្រទេស ។
លោក ប្រធានាធិបតី ចិន ស៊ី ជីន ពីង អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ កណ្តាល បក្ស កុម្មុយនីស្ដ ចិន . សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក៏ ដូចជា តំណាង គណបក្ស នយោបាយ នានា សុទ្ធតែ បាន ថ្លែង សុន្ទរកថា គន្លឹះ នៅក្នុង សន្និសីទ កំពូល នេះ ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល ចេញផ្សាយ ដោយ គណបក្ស ប្រជាជន កម្ពុជា បាន គូសបញ្ជាក់ ថា ក្នុង សន្និសីទ កំពូល ដ៏ មាន សារសំខាន់ មួយ នេះ បាន សម្រេច នូវ លទ្ធផល សំខាន់ ៗ ចំនួន ៣រួម មាន៖
១៖ ស្នើ ឱ្យ គណបក្ស នយោបាយ នៅ តាម បណ្តា ប្រទេស ទាំងអស់ ប្តេជ្ញាចិត្ត ក្នុង ការកសាង គុណ តម្លៃ រួមគ្នា រួម មាន សន្តិភាព ការអភិវឌ្ឍ សមភាពយុត្តិធម៌ ប្រជាធិបតេយ្យ និង សេរីភាព ។
២៖ គណបក្ស នយោបាយ ទាំងអស់ ចាំបាច់ ត្រូវតែ ចាត់ វិធានការសកម្ម ដើម្បី អនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ អង្គការ សហ ប្រជាជាតិ ឆ្នាំ ២០៣០ ដើម្បី សម្របសម្រួល គោល នយោបាយ ម៉ាក្រូ សេដ្ឋកិច្ច ពង្រឹង កិច្ចសហប្រតិបត្តិការ សកល លើ ន វានុវត្តន៍ បច្ចេកវិទ្យា និង លើកកម្ពស់ ការចែករំលែក ចំណេះដឹង និង បច្ចេកវិទ្យា ។
៣៖ គណបក្ស នយោបាយ មកពី បណ្តា ប្រទេស ទាំងអស់ ត្រូវ ប្តេជ្ញា សម្របសម្រួល ការផ្លាស់ប្ដូរ គ្នា និង ការរៀនសូត្រ ទៅ វិញ ទៅ មក លើ អរិយធម៌ ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ដ៏ រឹងមាំ ព្រមទាំង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អប់រំ វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា វប្បធម៌ និង សិល្បៈ កីឡា ទេសចរណ៍ និង រវាង ស្ថាប័ន ស្រាវជ្រាវ ។
សូម បញ្ជាក់ ថា សន្និសីទ កំពូល នេះ គឺជា កិច្ចប្រជុំ ជាន់ ខ្ពស់ បំផុត និង ធំ ជាង គេ បំផុត នៃ គណបក្ស នយោបាយ ពិភពលោក ដែល បាន រៀបចំ ដោយ គណបក្ស កុម្មុយនីស្ដ ចិន ព្រមទាំង បាន រៀបចំ ក្នុង ទម្រង់ នៃ អន្តរកម្ម ដ៏ ស្និទ្ធស្នាល និង កិច្ចសន្ទនា ដ៏ ស៊ីជម្រៅ ។
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៥២ នាក់ បន្ថែម ទៀត ជាសះស្បើយ ៩៩ នាក់ និង ស្លាប់ ម្នាក់ នៅ ស្រុក កង មាស ។
ក្នុង សេចក្ដីប្រកាស ព័ត៌មាន នេះ បាន បញ្ជាក់ ថា សន្និសីទ កំពូល នេះ សម្រេចបាន លទ្ធផល សំខាន់ ៗ ដូច ខាងក្រោម៖
* ទី ១៖ សន្និសីទ កំពូល នេះ បាន ស្នើឲ្យ គណបក្ស នយោបាយ នៅ តាម បណ្ដា ប្រទេស ទាំងអស់ ប្ដេជ្ញាចិត្ត ក្នុង ការកសាង គុណ តម្លៃ គ្នា រួម មាន សន្ដិភាព ការអភិវឌ្ឍ សមភាព យុត្តិធម៌ ប្រជាធិបតេយ្យ និង សេរីភាព
* ទី ២៖ គណបក្ស នយោបាយ ទាំងអស់ ចាំបាច់ ត្រូវតែ ចាត់ វិធានការសកម្ម ដើម្បី អនុវត្ត គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ អង្គការ សហ ប្រជាជាតិ ឆ្នាំ ២០៣០ ដើម្បី សម្របសម្រួល គោល យោបាយ ម៉ាក្រូ សេដ្ឋកិច្ច ពង្រឹង កិច្ចសហការ ប្រតិបត្ដិការ សកល លើ ន វានុវត្តន៍ បច្ចេកវិទ្យា និង លើកកម្ពស់ ការចែករំលែក ចំណេះដឹង និង បច្ចេកវិទ្យា
* ទី ៣៖ គណបក្ស នយោបាយ មកពី បណ្ដា ប្រទេស ទាំងអស់ ត្រូវ ប្ដេជ្ញា សម្របសម្រួល ការផ្លាស់ប្ដូរ គ្នា និង ការរៀនសូត្រ ទៅ វិញ ទៅ មក លើ អរិយធម៌ ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ដ៏ រឹងមាំ ព្រមទាំង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អប់រំ វិទ្យាសាស្ដ្រ និង បច្ចេកវិទ្យា វប្បធម៌ និង សិល្បៈ កីឡា ទេសចរណ៍ និង រវាង ស្ថាប័ន ស្រាវជ្រាវ ។
សូម ជម្រាប ថា នៅ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន អញ្ជើញ ចូលរួម នៅក្នុង សន្និសីទ កំពូល រវាង គណបក្ស កុម្មុយនីស្ដ ចិន និង គណបក្ស នយោបាយ លើ ពិភពលោក តាមរយៈ ប្រព័ន្ធ វីដេអូ ក្រោម ប្រធានបទ « ការធ្វើការ ដើម្បី សុភមង្គល ប្រជាជន៖ ទំនួល ខុសត្រូវ របស់ គណបក្ស នយោបាយ » ។
សន្និសីទ កំពូល នេះ ត្រូវបាន អញ្ជើញ ចូលរួម ដោយ គណៈប្រតិភូ ជាង ១ម៉ឺន នាក់ តំណាង ឲ្យ គណបក្ស នយោបាយ និង អង្គការ ជាង ៥០០ មកពី ១៦០ ប្រទេស ៕
សប្បុរសជន ឧបត្ថម្ភ ផ្លែ ល្មើ ៣០០ គីឡូក្រាម ដល់ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ ដែល កំពុង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩
ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ចេញ សេចក្តីប្រកាស ព័ត៌មាន ពាក់ព័ន្ធ ការសាងសង់ ប្រាសាទ ថ្ម នៅ ខេត្ត បុរីរម្យ ប្រទេស ថៃ ដែល ស្រដៀង ប្រាសាទ អង្គរវត្ត (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ពាក់ព័ន្ធ នឹង ការសាងសង់ ប្រាសាទ ថ្ម នៅ ខេត្ត បុរីរម្យ នៃ ប្រទេស ថៃ ដែល ស្រដៀង ប្រាសាទ អង្គរវត្ត ។
សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ថា ពាក់ព័ន្ធ នឹង ការសាងសង់ ប្រាសាទ ថ្ម មួយ នៅ ខេត្ត បុរីរម្យ ក្នុង ប្រទេស ថៃ នា រយៈពេល ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ទំនាក់ទំនង និង សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ស្ថាន ឯក អគ្គ រាជ ទូត ព្រះរាជាណាចក្រ កម្ពុជា ប្រចាំ នៅ ព្រះរាជាណាចក្រ ថៃ ដើម្បី ស្រាវជ្រាវ ប្រមូល ព័ត៌មាន បន្ថែម ។
ស្ថាន ឯក អគ្គ រាជ ទូត ព្រះរាជាណាចក្រ កម្ពុជា បាន ចុះ ធ្វើ ការស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ និង ប្រមូល បាន ព័ត៌មាន ជា បឋម មួយ ចំនួន ដូច ខាងក្រោម៖
១៖ សំណង់ ប្រាសាទ នេះ ជា សំណង់ មួយ ក្នុង ចំណោម សំណង់ ប្រាសាទ ថ្ម ដទៃ ៗ ទៀត មាន ភាព ចម្រុះ គ្នា ជា ទីប្រតិស្ឋាន នៃ ព្រះពុទ្ធរូប សម្រាប់ បូជា ស្ថិត ក្នុង វត្ត ពុទ្ធបាទ សិលា ភូម៉ាន ហ្វា នៃ ភូមិ ណង បួឡាយ ឃុំ បាន ស៉ិង ស្រុក ណាង រ៉ង ខេត្ត បុរីរម្យ នៃ ព្រះរាជាណាចក្រ ថៃ ។ សំណង់ នេះ ធ្វើ ពី ថ្ម ភក់ នៅ ផ្នែក ក្រៅ និង ចាក់ បេតុង បង្កប់ ដែកពី ខាងក្នុង ។
២៖ តាមរយៈ ការបំភ្លឺ និង បង្ហាញ ឯកសារ ប្លង់ សំណង់ នានា ព្រះចៅ អធិការ វត្ត បាន បញ្ជាក់ ថា ការសាងសង់ ប្រាសាទ នេះ មិន បាន លួច ចម្លង ប្លង់ ឬ សាងសង់ តាម រចនាបថ ស្ថាបត្យកម្ម ដូចគ្នា ទៅនឹង ប្រាសាទ អង្គរវត្ត ឬ ប្រាសាទ បុរាណ ណាមួយ នៅក្នុង ប្រទេស កម្ពុជា ឡើយ ពោលគឺ សាងសង់ តាម គំនូស ប្លង់ ដោយ ខ្លួន ឯង និង រចនា ទៅ តាម ស្ថាបត្យកម្ម ប្រាសាទ មួយ ចំនួន ដែល មាន ក្នុង តំបន់ នោះ ។
៣៖ តំណាង អ្នកសម្របសម្រួល នៃ គម្រោង ស្ថាបនា ប្រាសាទ ក៏ ស្វាគមន៍ ក្នុង ការទទួល ស្នើ ឱ្យ មន្ត្រី ជំនាញ ផ្នែក ស្ថាបត្យកម្ម កម្ពុជា ចុះ ពិនិត្យ ដោយ ផ្ទាល់ បាន ក្នុង ករណី មាន ការ មន្ទិល សង្ស័យ ។
ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ បងប្អូន ជន រួម ជាតិ ដែល តែង យកចិត្តទុកដាក់ ការពារ លើក តម្កើង កិត្យានុភាព អត្តសញ្ញាណ ជាតិ ព្រមទាំង សិល្បៈ វប្បធម៌ ដ៏ ថ្លៃថ្លា របស់ ជាតិ ប្រកបដោយ សេចក្តីថ្លៃថ្នូរ ដ៏ ខ្ពង់ខ្ពស់ ។ ក្រសួង នឹង ធ្វើ ការ ហើយ តាមដាន ការងារ នេះ ជាបន្ត ដោយ យកចិត្តទុកដាក់ ។
លោកស្រី ទ្រី ដាណា និង ឧកញ៉ា ហ៊ីង បញ្ញា រិទ្ធ ឧបត្ថម្ភ ថវិកា ៣៥.០០០ ដុល្លារ ជូន កាកបាទ ក្រហម កម្ពុជា ជួយ សាងសង់ ផ្ទះ ជូន អតីត យុទ្ធជន កម្ពុជា ក្រីក្រ នៅ ស្រុក ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់
( ភ្នំពេញ ) ៖ លោកស្រី ទ្រី ដាណា អគ្គ នាយិកា ក្រុមហ៊ុន ដាណា ទ្រី ( ខេមបូឌា ) ត្រេឌីង ខូអិលធីឌី និង ឧកញ៉ា ហ៊ីង បញ្ញា រិទ្ធ ឧបត្ថម្ភ ថវិកា ៣៥.០០០ ដុល្លារ ជូន កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ជួយ សាងសង់ ផ្ទះ ជូន អតីត យុទ្ធជន កម្ពុជា ក្រីក្រ នៅ ស្រុក ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់ ។
ពិធី ប្រគល់ និង ទទួល ថវិកា បាន ប្រព្រឹត្តទៅ នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា នា ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ ក្រោម អធិបតីភាព លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា ជាមួយ លោកស្រី ទ្រី ដាណា អគ្គ នាយិកា ក្រុមហ៊ុន ដាណា ទ្រី ( ខេមបូឌា ) ត្រេឌីង ខូអិលធីឌី និង ឧកញ៉ា ហ៊ីង បញ្ញា រិទ្ធ ។
ក្នុង ឱកាស នោះ លោកស្រី អគ្គ លេខាធិការ រង ទី១ បាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ និង បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ និង បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ទឹកចិត្ត សប្បុរសធម៌ របស់ លោកស្រី ទ្រី ដាណា និង ឧកញ៉ា ហ៊ីង បញ្ញា រិទ្ធ ដែល បាន ឧបត្ថម្ភ ថវិកា ជូន កាកបាទ ក្រហម កម្ពុជា ។
ជាមួយគ្នា នេះ លោកស្រី អគ្គ លេខាធិការ រង ទី១ បាន ជម្រាប ជូន ថា កាកបាទ ក្រហម កម្ពុជា បាន ផ្តល់ ថវិកា តាមរយៈ សមាគម អតីត យុទ្ធជន កម្ពុជា ចំនួន ៥០ ម៉ឺន ដុល្លារ ជា ជំហាន ទី១ កាលពី ថ្ងៃទី ៨ ខែកុម្ភៈ ឆ្នាំ ២០២១ កន្លងទៅ និង ថវិកា ចំនួន ១លាន ដុល្លារ ជា ជំហាន ទី២ កាលពី ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២១ ។
កាកបាទ ក្រហម កម្ពុជា ក៏ បាន ប្រគល់ ផ្ទះ ចំនួន ៥០ ខ្នង ជា ជំហាន ទី១ ជូន អតីត យុទ្ធជន កម្ពុជា ក្រីក្រ ចំនួន ៥០ គ្រួសារ រួច មកហើយ ដែរ កាលពី ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២១ កន្លងទៅ ហើយ គ្រោង នឹង រៀបចំ ពិធី ប្រគល់ - ទទួល ផ្ទះ ចំនួន ១៣០ ខ្នង - ១៥០ ខ្នង ទៀត ជា ជំហាន ទី២ នៅ ដេីម ខែសីហា ឆ្នាំ ២០២១ ខាងមុខ នេះ ផងដែរ ។
ជា កិច្ច ឆ្លើយតប លោកស្រី ទ្រី ដាណា និង ឧកញ៉ា ហ៊ីង បញ្ញា រិទ្ធ បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន អនុញ្ញាតឱ្យ បាន ចូលរួមចំណែក ការងារ មនុស្សធម៌ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដែល ជា សមាគម ជាតិ តែងតែ ធ្វើ សកម្មភាព មនុស្សធម៌ យ៉ាង សកម្ម ជួយ ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត យ៉ាង ពិតប្រាកដ និង បាន កសាង នូវ ភាព ជឿជាក់ ពី សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន ។
សូម បញ្ជាក់ ថា ផ្ទះ នីមួយ ៗ មាន ទំហំ ៥ម៉ែត្រ X ៧ម៉ែត្រ . គ្រឿង បង្គុំ ធ្វើ ពី ដែក . សសរ ចាក់ស៊ីម៉ង់តិ៍ . ជញ្ជាំង ស្មាត បត . ដំបូល ស័ង្កសី និង តតាក ខាងក្រោយ ផ្ទះ ធ្វើជា ចង្ក្រាន បាយ ដែល ចំណាយ ថវិកា តម្លៃ ៣.៥០០ ដុល្លារ អាមេរិក ។ ដោយឡែក បង្គន់ អនាម័យ ដាច់ដោយឡែក មួយ ទៀត មាន តម្លៃ ២៧០ ដុល្លារ អាមេរិក ៕ ខេត្ត បន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ១០៧ នាក់
រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ សូម ជម្រាប ជូន ប្រជាពលរដ្ឋ ដែល បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ឬ ដោយ ប្រយោល ជាមួយ អ្នកវិជ្ជមាន ខាងលើ សូម រួសរាន់ ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ ក្នុង ក្រុមគ្រួសារ រៀង ៗ ខ្លួន ឱ្យ បាន គ្រប់ ១៤ ថ្ងៃ ដោយ មិន ត្រូវ ពាក់ព័ន្ធ និង ប៉ះពាល់ ជាមួយ អ្នកដទៃ ជាដាច់ខាត ក្នុង ករណី មិន អនុវត្ត កាតព្វកិច្ចចត្តាឡី ស័ក រដ្ឋបាល ខេត្ត នឹង ចាត់ វិធានការ ផ្លូវ ច្បាប់ ចំពោះ បុគ្គល ទាំងឡាយ ណា ដែល ល្មើស នឹង វិធាន សុខាភិបាល នេះ ៕
គួរ បញ្ជាក់ ថា ប្រជាជន រស់ នៅក្នុង តំបន់ ទីប្រជុំជន ទីក្រុង ស៊ីដនី និង តំបន់ ជុំវិញ សរុប ប្រមាណ ជាង ៥លាន នាក់ នឹង បន្ត ស្នាក់ នៅក្នុង លំនៅឋាន រយៈពេល ១សប្តាហ៍ គឺ រហូតដល់ ថ្ងៃសុក្រ សប្តាហ៍ ក្រោយ ។ ដោយឡែក សាលារៀន នានា ក៏ នឹង បន្ត បិទ ទ្វារ រហូតដល់ ពេល នោះ ដូចគ្នា ។
អាជ្ញាធរ រដ្ឋ ញូសោត វែលស៍ បាន គូសបញ្ជាក់ ថា ការបិទ ខ្ទប់ បន្ត ទៀត នេះ ពិត ណាស់ ថា នឹង បង្ក ផលវិបាក បន្ថែម ដល់ ផ្នែក សតិអារម្មណ៍ និង ការប្រកបរបរ អាជីវកម្ម របស់ ប្រជាជន ប៉ុន្តែ នេះ ជា វិធានការចាំបាច់ បំផុត ដើម្បី ទប់ទល់ ការឆ្លង រាតត្បាត COVID-19 បម្លែង ថ្មី Delta ដែល មាន គ្រោះថ្នាក់ បំផុត ខណៈ បច្ចុប្បន្ន ប្រជាជន អូស្ត្រាលី មិន ដល់ ១០% នោះ ឡើយ ដែល ទទួលបាន ការចាក់ វ៉ាក់សាំង បង្ការ COVID-19 ពេញលេញ ៕ រដ្ឋបាល ខេត្ត កំពង់ចាម បន្ត ទទួល អំណោយ ពី សប្បុរសជន ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន គណៈកម្មការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន បន្ត ទទួល អំណោយ ពី សប្បុរសជន ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល កំពុង ឆ្លង រាលដាល ជា បន្តបន្ទាប់ នៅក្នុង ខេត្ត កំពង់ចាម ។
( ព្រៃវែង ) ៖ រដ្ឋបាល ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ នៅ ក្រុង ព្រៃវែង ចាប់ពី ថ្ងៃទី ០៨ ដល់ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២១ ។
បើ តាម សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខត្ត ព្រៃវែង បាន ឱ្យដឹង ថា ការចាក់ ថ្នាំ បង្ការ ជំងឺ កូវីដ១៩ ធ្វើឡើង នៅ ទីតាំង វិទ្យាល័យ អង្គ ដួង ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ ខ្មែរ ប៊ែ វើរី ជីស បាន បន្ត ឧបត្ថម្ភ ទឹក បរិសុទ្ធ កម្ពុជា ៣.០០០ កេស បន្ថែម ដល់ សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្ដេច តេជោ (TYDA) ក្រោយ ទើប បរិច្ចាគ ទឹក បរិសុទ្ធ កម្ពុជា និង ភេសជ្ជៈ សរុប ៧. ១០០ កេស ដើម្បី អរគុណ ដល់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ទាំងអស់ សម្រាប់ ការលះបង់ ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា នេះ ។
លោក បណ្ឌិត អ៊ឹម សុធារិទ្ធ នាយក ទំនាក់ទំនង សាធារណៈ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស មានប្រសាសន៍ ថា៖ « ស្រប ពេល ដែល សង្គម កម្ពុជា បច្ចុប្បន្ន ត្រូវការ ការរួបរួមគ្នា បែប នេះ ការបន្ត ឧបត្ថម្ភ របស់ ខ្មែរ ប៊ែ វើរី ជី ស ដល់ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត នឹង នៅតែ បន្ត ជានិច្ច ដើម្បី ជា កម្លាំងចិត្ត ក្នុង ការបន្ត បេសកកម្ម ការពារ និង ព្យាបាល ពលរដ្ឋ ខ្មែរ ទាំងអស់ គ្នា » ។
គួរ បញ្ជាក់ ផងដែរ ថា យុទ្ធនាការ « ទឹកចិត្ត កម្ពុជា » របស់ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស នៅតែ បន្ត យ៉ាង សកម្ម នៅ ទូទាំង ប្រទេស ក្នុង ការបរិច្ចាគ ទឹក បរិសុទ្ធ កម្ពុជា និង ភេសជ្ជៈ ជូន ដល់ ស្ថាប័ន ជាច្រើន ផ្សេង ទៀត ដែល កំពុង បំពេញ បេសកកម្ម យ៉ាង សស្រាក់សស្រាំ ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សាធារណការ អរគុណ កូរ៉េ ផ្តល់ គ្រូ ឧទ្ទេស ជំនាញ ចែករំលែក ចំណេះដឹង ដល់ មន្ត្រី បច្ចេកទេស កម្ពុជា
( ភ្នំពេញ ) ៖ លោក យិត បុណ្ណា រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ថ្លែង អរគុណ ដល់ វិទ្យាស្ថាន កូរ៉េ សំណង់ ស៊ីវិល និង បច្ចេកវិទ្យាសាងសង់ នៃ ក្រសួង ដែនដី ហេដ្ឋារចនាសម្ព័ន្ធ និង ដឹកជញ្ជូន សាធារណរដ្ឋ កូរ៉េ ដែល បាន ចំណាយ ពេលវេលា ដ៏ មាន តម្លៃ និង បាន ផ្តល់ គ្រូ ឧទ្ទេសនាម ពោរពេញ ដោយ បទពិសោធន៍ បាន ចែករំលែក និង ផ្ទេរ នូវ ចំណេះដឹង ចំណេះ ធ្វើ ដល់ មន្ត្រី បច្ចេកទេស និង និស្សិត នៃ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
បន្ថែម ជាមួយគ្នា នោះ លោក យិត បុណ្ណា ក៏ បាន ជំរុញ លើកទឹកចិត្ត ដល់ មន្ត្រី បច្ចេកទេស និង និស្សិត របស់ ក្រសួង ដែល បាន ចូលរួម ក្នុង វគ្គ បណ្តុះបណ្តាល ត្រូវ ខិតខំ យកចិត្តទុកដាក់ ក្រេប យក នូវ បច្ចេកវិទ្យា ថ្មី ៗ ដើម្បី បង្កើន នូវ សមត្ថភាព ចំណេះ ជំនាញ របស់ ខ្លួន ប្រកបដោយ គុណភាព និង សក្តានុពល ខ្ពស់ ក្នុង ការរួមចំណែក អភិវឌ្ឍ សង្គមជាតិ ជាមួយ រដ្ឋាភិបាល លើ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ផងដែរ ៕
ព្រះរាជអាជ្ញា ខេត្ត តាកែវ ឧបត្ថម្ភ សម្ភារ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដល់ ពន្ធនាគារ ខេត្ត តាកែវ
( តាកែវ )៖ ខណៈពេល ដែល មាន ទណ្ឌិត មួយចំនួន បាន ឆ្លង ជំងឺ កូវីដ១៩ នៅ ព្រឹក ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០២១ នេះ លោក ជីវ ចាន់ តារា ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត តាកែវ បាន ដឹកនាំ ក្រុមការងារ នាំយក ម៉ាស់ អាល់កុល ថ្នាំ ពេទ្យ និង ទឹក បរិសុទ្ធ មួយចំនួន ប្រគល់ ជូន មន្ត្រី ពន្ធនាគារ ខេត្ត តាកែវ ដើម្បី ចូលរួមចំណែក ក្នុង យុទ្ធនាការ បង្ការ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ នៅក្នុង ពន្ធនាគារ ។
លោក ជីវ ចាន់ តារា ក៏ បាន ធ្វើ ការណែនាំ ដល់ មន្រ្តី ពន្ធនាគារ ធ្វើ យ៉ាងណា បង្ការ និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩ កុំ ឱ្យ បន្ត ឆ្លង រីករាលដាល នៅក្នុង ពន្ធនាគារ តាមរយៈ ការសហការ ជាមួយ មន្រ្តី សុខាភិបាល ឱ្យ បាន ល្អ ប្រសើរ ដោយ ធ្វើ យ៉ាងណា យក សំណាក ទណ្ឌិត និង អ្នក ពាក់ព័ន្ធ ទៅ ពិនិត្យ រក ជំងឺ កូវីដ១៩ ហើយ ប្រសិនបើ រកឃើញ ទណ្ឌិត ណា មាន ផ្ទុក ជំងឺ កូវីដ១៩ ត្រូវ យក ទៅ ព្យាបាល ឱ្យ បាន ទាន់ ពេលវេលា ហើយ ទណ្ឌិត ដែល ពាក់ព័ន្ធ ត្រូវ យក ទៅ ដាក់ នៅ អាគារ ដាច់ដោយឡែក របស់ ពន្ធនាគារ ។
ស្នងការដ្ឋាន ខេត្ត រតនគិរី ធ្វើតេស្ត រក មេរោគ កូវីដ១៩ លើ មន្ត្រី របស់ ខ្លួន លទ្ធផល អវិជ្ជមាន ទាំងអស់
លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន បាន ឱ្យដឹង ថា ដើម្បីឱ្យ កម្លាំង ដែល ចូលរួម ជាមួយ គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ខេត្ត ទាំងអស់ មាន សុខភាពល្អ . កម្លាំង មាំ មួន បម្រើ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន នោះ រូប លោក បាន ណែនាំ ពួកគេ ឱ្យ ធ្វើតេស្ត វិភាគ សំណាក ។
លោក ឧត្តមសេនីយ៍ ទោ បាន បន្ត ថា កម្លាំង ខាងលើ នេះ មកពី កង អន្តរាគមន៍ ពិសេស និង តាម ការិយាល័យ ជំនាញ មួយចំនួន ចំណុះ ឱ្យ ស្នងការដ្ឋាន ។
ទន្ទឹម នោះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ផ្តល់ ឧបករណ៍ តេស្តរហ័ស (Rapid Test) ដល់ ខេត្ត ដើម្បីឱ្យ ក្រុម គ្រូពេទ្យ ជួរ មុខ នៃ មន្ទីរ សុខាភិបាល ខេត្ត រតនគិរី ធ្វើតេស្ត វិភាគ សំណាក ជូន មន្ត្រី នគរបាល និង ប្រជាពលរដ្ឋ ក្នុង ខេត្ត រតនគិរី ៕
លោក Xi Jinping បាន ថ្លែង បន្ត ថា ការអភិវឌ្ឍន៍ គឺជា សិទ្ធិ របស់ ប្រទេស ទាំងអស់ នៅលើ ពិភពលោក មិន មែន ជា សិទ្ធិ ផ្តាច់ មុខ របស់ ប្រទេស មួយចំនួន តូច នោះ ទេ ។ គណបក្ស នយោបាយ ត្រូវ ជំរុញ ប្រទេស នានា ឱ្យ ពង្រឹង កិច្ចសហប្រតិបត្តិ ផ្អែក អភិវឌ្ឍ ជំរុញ ប្រជាជន នៃ ប្រទេស ទាំងអស់ ឱ្យ ចែករំលែក នូវ សមិទ្ធផល នៃ ការអភិវឌ្ឍ រួមគ្នា លើកកម្ពស់ ភាពយុត្តិធម៌ ប្រសិទ្ធភាព និង ភាពស៊ី ចង្វាក់ គ្នា នៃ ការអភិវឌ្ឍ ពិភពលោក និង រួមគ្នា ប្រឆាំង នឹង បុគ្គល ម្នាក់ ដែល បិទ ខ្ទប់ បច្ចេកវិទ្យា និង រារាំង ដល់ ការអភិវឌ្ឍ ៕
ខេត្ត ត្បូងឃ្មុំ បង្ហាញ អត្តសញ្ញាណ មនុស្ស ៣២ នាក់ ឆ្លង ជំងឺ កូវីដ តាមរយៈ ការធ្វើតេស្ដរហ័ស និង ជាសះស្បើយ ៥១ នាក់
សមាគម មិត្ដភាព កម្ពុជា - ចិន គាំទ្រ គោល នយោបាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល ប្រកាន់ យ៉ាង ខ្ជាប់ នូវ គោល នយោបាយ ចិន តែ មួយ
ការលើកឡើង បែប នេះ របស់ លោក ឯក សំអុល បាន ធ្វើឡើង ក្នុង ឱកាស ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល ថ្នាក់ដឹកនាំ បក្ស កុម្មុយនិស្ត ចិន និង គណបក្ស នយោបាយ លើ ពិភពលោក ដែល រៀបចំ តាម ប្រព័ន្ធ វីដេអូ អនឡាញ ក្រោម ប្រធានបទ « ការបំពេញ ការងារ ដើម្បី សុភមង្គល ប្រជាជន ការទទួលខុសត្រូវ របស់ គណបក្ស នយោបាយ » ។
កិច្ចប្រជុំ នេះ រៀបចំ ធ្វើឡើង នា យប់ ថ្ងៃទី ០៦ ខែកក្កដា ឆ្នាំ ២០២១ ដោយ មាន ចូលរួម ពី សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ព្រមទាំង មាន ការចូលរួម ពី លោក ស៊ី ជីន ពីង ប្រធានាធិបតី ចិន និង ថ្នាក់ដឹកនាំ នយោបាយ ជាច្រើន រូប ។
លោក ឯក សំអុល បាន ឲ្យដឹង ថា ក្នុង នាម សមាគម មិត្ដភាព កម្ពុជា - ចិន មាន សេចក្ដីសប្បាយរីករាយ យ៉ាង ក្រៃលែង ដែល បាន ចូលរួម ក្នុង កិច្ចប្រជុំ កំពូល បក្ស កុម្មុយនិស្ត ចិន និង បក្ស នយោបាយ លើ ពិភពលោក និង សូម ចូលរួម អបអរសាទរ ក្នុង ឱកាស ខួប ១០០ ឆ្នាំ នៃ ការបង្កើត គណបក្ស កុម្មុយនីស្ដ ចិន ។
ក្នុង នាម សមាគម មិត្ដភាព កម្ពុជា - ចិន លោក ឯក សំអុល សូម ប្រកាស គាំទ្រ នូវ គោល នយោបាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល ប្រកាន់ យ៉ាង ខ្ជាប់ខ្ជួន នូវ គោល នយោបាយ ចិន តែ មួយ ដែល សម្ដេច តេជោ បាន ចាត់ទុក ប្រទេស ចិន គឺជា មូលដ្ឋានគ្រឹះ នៃ ការកសាង ការពារ សន្ដិភាព និង វិបុលភាព ជូន ប្រជាជន ។
បន្ថែម ពី នោះ ទៀត លោក ឯក សំអុល បាន លើកឡើង ថា ការប្រារព្ធ ខួប ១០០ ឆ្នាំ របស់ គណបក្ស កុម្មុយនីស្ដ ចិន នេះ នឹង នាំមក នូវ ក្ដីសង្ឃឹម ថ្មី ៗ បន្ថែម ទៀត ជូន ដល់ ប្រជាជន កម្ពុជា និង ប្រទេស កម្ពុជា ។
លោក ឯក សំអុល បាន លើកឡើង ទៀត ថា ការចូលរួម កិច្ចប្រជុំ នេះ បញ្ជាក់ ឲ្យ ឃើញ ថា ទំនាក់ទំនង និង សហប្រតិបត្ដិការ រវាង គណបក្ស ប្រជាជន និង គណបក្ស កុម្មុយនីស្ដ ចិន គឺ មាន ភាពតភ្ជាប់ យ៉ាង ជិតស្និត បំផុត រវាង ថ្នាក់ដឹកនាំ នៃ គណបក្ស ទាំង ពីរ និង ទំនាក់ទំនង រវាង ប្រជាជន ចិន និង ប្រជាជន កម្ពុជា ។
ទន្ទឹម គ្នា នេះ លោក ឯក សំអុល សង្ឃឹម ថា កិច្ចប្រជុំ នេះ នឹង នាំមក ទិសដៅ ក្នុង ការរួមគ្នា ការពារ នូវ សន្ដិភាព នៅលើ ពិភពលោក និង រួមគ្នា កសាង សហគមន៍ វាសនា មួយ ជាមួយគ្នា និង រួមគ្នា កសាង វិបុលភាព ជូន ប្រជាជន កម្ពុជា និង ប្រជាជន ចិន ក៏ ដូចជា ប្រជាជន នៅលើ ពិភពលោក ។
ក្នុង សុន្ទរកថា គន្លឹះ ថ្លែង ទៅកាន់ កិច្ចប្រជុំ ធ្វើឡើង តាម អនឡាញ នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ជំរុញ ឲ្យ គណបក្ស នយោបាយ ទាំងអស់ រួមគ្នា ប្តេជ្ញា រក្សា ស្ថិរភាព នយោបាយ និង រារាំង ឲ្យបាន ដាច់ខាត នូវ ការជ្រៀត ជ្រែក នយោបាយ ពី ប្រទេស ដទៃ ។
សម្តេច តេជោ ក្នុង នាម ប្រធាន គណបក្ស ប្រជាជន បាន សង្កត់ធ្ងន់ ថា គណបក្ស នយោបាយ ទាំងអស់ ទោះជា មាន និន្នាការណា ក៏ដោយ ត្រូវ គិត ពី ប្រយោជន៍ ជាតិ និង ប្រជាជនជា ធំ ដោយ មិន ត្រូវ ឱន ក្បាល ធ្វើជា ឈ្នាន់ នយោបាយ និង វិទ្ធង្ស នា របស់ បរទេស បើ ទោះបីជា ស្ថិត ក្រោម រូបភាព ណា ក៏ដោយ ។
ទន្ទឹមនឹង ការថ្លែង ជំរុញ ឲ្យ បណ្តា គណបក្ស នយោបាយ លើ ពិភពលោក រួមគ្នា ទប់ស្កាត់ ការច្រៀត ជ្រែក នយោបាយ ពី មជ្ឈដ្ឋាន ខាងក្រៅ ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន រំលឹក ពី ការរួមចំណែក របស់ ចិន ជួយ ដល់ ការពង្រឹង នូវ ឯករាជ្យភាព របស់ កម្ពុជា តាមរយៈ ការផ្តល់ ជំនួយ ផ្សេង ៗ ផងដែរ ។
គូសបញ្ជាក់ ថា ប្រទេស ចិន បាន ក្លាយទៅជា ប្រទេស ជា មិត្ត ដ៏ ធំ មួយ របស់ កម្ពុជា ដែល បាន ផ្តល់ ជំនួយ និង កម្ចី យ៉ាង ច្រើន សម្រាប់ ការអភិវឌ្ឍ នៅ កម្ពុជា ។
តាមរយៈ ជំនួយ និង កម្ចី នេះ បាន រួមចំណែក ឲ្យ កម្ពុជា ពង្រឹង ដល់ ការអភិវឌ្ឍ ជាតិ លើ គ្រប់ វិស័យ ជាពិសេស លើ ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ ថ្នល់ និង ស្ពាន ដែល ជា សរសៃ ឈាម ដ៏ សំខាន់ សម្រាប់ សេដ្ឋកិច្ច ជាតិ ៕
បើ តាម រូបភាព ផ្កាយ រណប របស់ ក្រុម អ្នកស្រាវជ្រាវ មកពី វិទ្យាស្ថាន ស្រាវជ្រាវ ដែល តារែស (Deltares) មាន មូលដ្ឋាន នៅក្នុង ប្រទេស ហូឡង់ បណ្ដា ប្រទេស នៅ តំបន់ ទំនាប ដែល ងាយ រងគ្រោះ ជាង គេ ដោយសារតែ ការកើនឡើង កម្រិត ទឹក សមុទ្រ និង ការលិចលង់ ដោយសារ ទឹក ជំនន់ ក្នុង នោះ រួម មាន ឥណ្ឌូណេស៊ី . ថៃ . វៀតណាម និង ហ្វីលីពីន ។
ក្រុម អ្នកស្រាវជ្រាវ មកពី វិទ្យាស្ថាន ដដែល បាន ឱ្យដឹង ទៀត ថា ប្រជាជន នៃ បណ្ដា ប្រទេស ទាំងនេះ អាចនឹង ត្រូវ ប្រឈមមុខ នឹង គ្រោះថ្នាក់ នៃ ការកើនឡើង កម្រិត ទឹក សមុទ្រ ជា ប្រចាំ ឆ្នាំ ដែល បង្កឡើង ដោយ ការប្រែប្រួល អាកាសធាតុ កំពុង ឈាន ទៅ រក ស្ថានភាព កាន់តែ អាក្រក់ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ។
មកទល់ ពេលនេះ ពុំ ទាន់ រកឃើញ មាន ជនរងគ្រោះ ណា ម្នាក់ នៅ រស់រាន មាន ជីវិត ឡើយ បន្ទាប់ពី ផ្នែក មួយ នៃ អគារ ខុនដូ ខាងលើ បាន បាក់ រលំ ជាង មួយ សប្តាហ៍ មក នេះ ហើយ មនុស្ស ១០៩ នាក់ នៅតែ បន្ត បាត់ខ្លួន នៅ ឡើយ ។ អគារ ខុនដូរ ដែល បាន បាក់ រំលំ មួយ ផ្នែក ខាងលើ នេះ ត្រូវបាន គេ រាយការណ៍ ថា សាងសង់ ឡើង នៅក្នុង ឆ្នាំ ១៩៨១ ដោយ មាន សរុប ទាំងអស់ ១៣៦ បន្ទប់ ហើយ ប្រមាណ ៥៥ បន្ទប់ បាន បាក់ រលំចុះ មក ហើយ បន្ទាប់មក ទៀត ក្រុម សង្គ្រោះ បាន សម្រេច បំផ្ទុះ អគារ ដែល នៅសល់ តែម្តង ។
ទន្ទឹមនឹង នេះ កិច្ចប្រឹងប្រែង ស្វែងរក និង ជួយសង្គ្រោះ ក៏ ត្រូវបាន បង្ខំ ចិត្ត ផ្អាក ប្រហែល ២ ម៉ោង នៅ រសៀល ថ្ងៃអង្គារ សប្ដាហ៍ នេះ ផងដែរ ដោយសារតែ មាន ផ្គរ រន្ទះ និង ខ្យល់ បក់ ខ្លាំង ក្នុង ល្បឿន លើស ពី ៤៨ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង ជាមួយនិង ព្យុះ ត្រូពិច អេល សា (Elsa) ។
