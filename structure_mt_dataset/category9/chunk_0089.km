អ្នក ប្រហែលជា ដឹង ហើយ ក្នុង រយៈពេល ប៉ុន្មាន ចុងក្រោយ នេះ ។
រឿង ពីរ បាន កើតឡើង ។
អ្នក មិន ឈ្លោះ ជាមួយ ពួកគេ ទេ ។
លោកុប្បត្តិ 3:4 បន្ទាប់មក ព្រះអង្គមានព្រះ‌បន្ទូលសួរគេ ថា៖ « នៅថ្ងៃ ស ប្ប័ទ តើយើងត្រូវអនុញ្ញាតឲ្យប្រព្រឹត្តអំពើល្អ ឬប្រព្រឹត្តអំពើអាក្រក់ ដើម្បី សង្គ្រោះជីវិត ឬបំផ្លាញជីវិតមួយ ? » ។
មិន អាច ផ្លាស់ទី ឬ និយាយ បាន ដូចជា ជាប់គាំង ។
ឥឡូវនេះ អ្នក អាច ក្លាយជា បុរស លាក់ មុខ ដ៏ អាថ៌កំបាំង នៅក្នុង សំលៀកបំពាក់ វីរបុរស បុរាណ នេះ ។
មេទ័ពចង់ សង្គ្រោះជីវិតរបស់ប៉ុល ។
ក្រុមហ៊ុន នេះ លែង ដំណើរការ ទៀត ហើយ ។
ពេលក្រុមគ្រួសាររបស់គាត់បានឮដូច្នេះ ក៏ នាំគ្នាទៅទទួល បន្ទុកលើលោក ព្រោះពួកគេនិយាយថា “ គាត់អស់គំនិតហើយ ” ។
ពេលក្រុមគ្រួសាររបស់គាត់បានឮដូច្នេះ ក៏ នាំគ្នាទៅចាប់គាត់ ព្រោះគេថាគាត់អស់ ចិត្ត ។
នាងបាននិយាយថា៖ « គាត់បាននិយាយមកយើងថា៖ ' អ្នកគួរតែនៅឱ្យឆ្ងាយពីខ្ញុំព្រោះខ្ញុំមិនដឹងថាពួកគេជានរណាជា ដែលបានចូល មកក្នុងរាងកាយរបស់ខ្ញុំនោះទេ » ហើយបានដើរចេញពីផ្ទះ។
5 ដូច្នេះ កូនរបស់អ៊ីស្រា ‌ អែលបានទៅទិញស្រូវ ជាមួយនឹងអ្នក ឯទៀតដែលនឹងទៅ ព្រោះមានទុរ្ភិក្សនៅស្រុកកាណានដែរ ។
ក្នុង នាម ដៃ ទៅ ទ្រូង របស់ គាត់ ភ្នាល់ ដាក់ ។
បេះដូងខ្ញុំទ្រុឌទ្រោមដូចដើមស្វាយ ។
ព្រះអង្គម្ចាស់ បាន សោយទិវង្គត មួយ សប្តាហ៍ និង ពីរ ថ្ងៃ មុន ។
យើង ត្រូវតែ នាំមុខ ជាមួយ នាង ។
កុំយករឿងនេះដោយឥតប្រយោជន៍ » ។
សូម មាន អារម្មណ៍ ចំពោះ ពួកគេ ។
ម៉ូសេ និងអើរ៉ុនបានទៅ ឯផារ៉ោន ។
គ្មាន អ្វី ត្រូវបាន ប្រើប្រាស់ ដោយ គ្មាន ជាតិ អាល់កុល ទេ ។
ការអនុញ្ញាតឱ្យ ធ្វើ ការសិក្សា នេះ ត្រូវបាន ផ្តល់ ដោយ មន្ទីរ ខេត្ត រៀង ៗ ខ្លួន ។
រោគសញ្ញា ទាំង នេះ គួរតែ ត្រូវបាន រាយការណ៍ ទៅ វេជ្ជបណ្ឌិត ។
ពួកគេ រស់ នៅក្នុង ទីក្រុង គ្រោះថ្នាក់ ។
ដូច្នេះហើយបានបញ្ជូនបុរសរបស់គាត់ទៅស្រាវជ្រាវខាងក្នុង ។
បង្ហូរ ហើយ លាង ជមែះ ជាមួយ ទឹក ។
ការថ្វាយបង្គំ ព្រះពន្លា និង ព្រះវិហារ ) ។
លក្ខខណ្ឌ នៃ អ្វី ដែល ត្រូវបាន ទាមទារ របស់ ពួកគេ ;
ជំហាន អំពី អ្វី ដែល ឥឡូវនេះ ហើយ ទទួលបាន ឈ្មោះ របស់ អ្នក ។
គ្រោះថ្នាក់ចរាចរណ៍បានកិនក្មេងប្រុសកំសត់ម្នាក់ស្លាប់។
ចំណុច ផ្សេង ទៀត ទាក់ទង នឹង អនាគត នៃ អង្គការ ដែល យើង ចាប់អារម្មណ៍ និង ដែល យើង ចង់ ឃើញ មាន សេរីភាព ។
« យើងកំពុងកំណត់អ្នកជំងឺដល់អ្នកគាំទ្រម្នាក់ក្នុងមួយថ្ងៃ ។
បន្ទាប់មកគាត់សួរថាតើយើងមាននរណាដែលមានឆន្ទៈប្រយុទ្ធនឹងភ្លើង។
អី យ៉ា ផ្ទះឯងមកដល់ឆ្ងាយហើយ !
ដាក់ វា នៅក្នុង វា ផងដែរ ។
ហើយនាងនឹកឃើញពាក្យ សម្ដីរបស់ខ្លួនឯង ...
ប៉ុន្តែយើងមានប្រទេស ឬក៏យើងមិនមានប្រទេសដែរ » ។
គាត់នឹងអាចសម្គាល់ឈ្មោះរបស់គាត់បាននៅពេលដែលអ្នកហៅទូរសព្ទ ហើយឆ្លើយតបទៅវា។
ខ្ញុំចាប់ផ្ដើមលេងបានយ៉ាងល្អដោយប្រើដៃខាងក្រោយ ។
សូមអធិស្ឋានឲ្យពួកគេមានការ ផ្គត់ផ្គង់គ្រប់គ្រាន់ » ។
ការ ស្លាប់របស់សម្ដេច សង្ឃមានតម្លៃធួនមួយចំនួន
យើង សូម ថ្លែងអំណរគុណ ដល់ សង្គម កាណាដា នៃ ក្រុមប្រឹក្សា វេជ្ជសាស្ត្រ ផ្ទៃក្នុង និង
ម៉ោងក្នុងមួយថ្ងៃ និងផ្ដល់ការ ចូលប្រើអ៊ីនធឺណិតដោយឥតគិតថ្លៃពេញមួយរយៈពេលនេះ ។
អញ្ចឹង .. . យើងនៅមិនទាន់ដឹងច្បាស់ថា តាលិនជាអ្វីទេ ។
ការ ឃើញគឺការ ជឿ ហើយអ្វីដែលគេនឹងឃើញនឹងធ្វើឲ្យ ចិត្តរបស់ពួកគេ !» ។
អរគុណ ព្រះ នាង មិន ឈឺចាប់ ទេ ។ ខ្ញុំមិនគិតថានាងមានស្នាមប្រេះលើនាងទេ ។
នេះ គឺជា ការសន្សំ ដ៏ ធំ សម្រាប់ អ្នក ។
មិន នឹកស្មាន ថា ការចែចង់ អាច ជួយ អ្នក បាន ក្នុង ពេល នោះ ។
ក្នុងនាមជាស្ត្រី តើយើងត្រូវលាក់បាំងការ ពិតដែលថាយើងប្រហែលជាចង់មានកូនឬ ?
ខ្ញុំ បរាជ័យមិនដឹងប៉ុន្មានដងទេ ប៉ុន្តែខ្ញុំនៅ តែក្រោកឡើង ។
ប្រសិនបើ ខ្ញុំ និយាយ ថា " ខ្ញុំ ស្គាល់ ខ្លួន ឯង " វា គឺជា ចំណេះដឹង ដែល ខ្ញុំ បាន ទទួល ក្នុង ការសង្កេតមើល ខ្លួន ឯង ។
រំលឹក ខ្ញុំ ឱ្យ នៅ ក្រៅ ប្រទេស អ៊ីរ៉ង់ ។
ផ្ទះ និង ដី ពីរ បី ហិចតា នៅ ប្រទេស ព័រទុយហ្គាល់ ។
" សម្រាប់ ព័ត៌មាន របស់ អ្នក ខ្ញុំ បាន ព្យាយាម ចេញ ។
បន្ទាប់មក យើង ដឹង ថា គាត់ គ្រាន់តែ ចង់ និយាយ ។
តើអាចធ្វើអ្វីបានទៀតទើបយើងទាំងអស់គ្នាអាចគាំទ្រសមភាព សម្រាប់កុមារីនៅកម្ពុជា ?
ដើម្បី សម្លាប់ ពួកគេ ។
ជាមួយ ក្មេងស្រី ម្នាក់ ៗ ខ្ញុំ បាន ដឹង ថា ពួកគេ ។
« បន្ទាប់មក ព្រះអម្ចាស់មានព្រះបន្ទូលទៅគាត់ថា ចូរដោះស្បែកជើងចេញ ដ្បិតកន្លែងដែលអ្នកកំពុងឈរនោះជាដីបរិសុទ្ធ » ។
២ហើយ ដូច្នេះ ពេលដែលខ្ញុំ មកដល់អ្នក រាល់គ្នា បងប្អូនអើយ ខ្ញុំមិនបានមកដោយការ និយាយដ៏លើស លប់ ឬដោយប្រាជ្ញាដែលប្រកាសពីអាថ៌កំបាំងដ៏ពិសិដ្ឋនៃព្រះដល់អ្នកឡើយ ។
ហើយត្រឹមត្រូវ ពួកគេនឹងមិនត្រូវបានអនុញ្ញាតឡើយ » ។
ពួកគេ កុហក ខ្ញុំ ។
ពេលរាង កាយអ្នកឈឺ តើអ្នកមានទំនោរធ្វើអ្វី ?
ប៉ុន្តែឥឡូវនេះ ខ្ញុំគ្រាន់ តែផ្សាយនូវអ្វីដែលខ្ញុំចង់ធ្វើ ដែលជាសេណារីយ៉ូ គួរឲ្យ កត់សម្គាល់ ។
យោង ទៅតាម ពួកគេ ព្រះគ្រីស្ទ មិន អាច ស្លាប់ បាន ទេ ។
បន្ទាប់ពីណាត់យើងទៅរៀបចំ ពេលល្ងាច ។
តោះ បំបែក វា បន្តិច មើល៖
គ្មាន អ្វី ត្រូវ ខ្ជះខ្ជាយ ទេ ហើយ ការបាត់បង់ ទឹក តាមរយៈ ការហួត គឺ តិចតួច បំផុត ។
