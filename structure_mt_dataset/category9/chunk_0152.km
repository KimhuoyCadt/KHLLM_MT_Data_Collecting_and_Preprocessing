នេះ ជា ភាពយឺតយ៉ាវ មួយ ដែល បង្កអោយ មាន ការថ្នាំង ថ្នាក់ ពី ប្រជាពលរដ្ឋ ។
នោះ ដោយសារតែ យើង មិន គួរ បង្ហាញ ទិន្នន័យ ឯកជន ទេ ។
ើ មីពឹង អ្ក ដឹក នុំម ជំនុំ និង
មាន កត្តា ចម្បង ៗ
អ្នកណា ធ្វើ អ្វី អ្នកណា ដឹង អ្វិ គឺ ពួកគេ ជា អ្នកដឹង ជា អ្នកទទួល !
សិក្សា ជំនាញ បញ្ចុះ សព នៅ ចិន មិន ខ្លាច ខ្វះ ទីផ្សារ
គួរតែ មាន បញ្ចូល ការគោរព សិទ្ធិ អ្នកដទៃ ដែល ប្រើប្រាស់ ដង ផ្លូវ រួមគ្នា ទៅក្នុង កម្មវិធី សិក្សា ។
ប្រសិន អ្នក ចូលចិត្ត បរិភោគ គ្រឿង ក្នុង សត្វ នេះ ជា រឿង ចាំបាច់ ត្រូវ ដឹង
សារ៉ាត់ ដែល បាត់ មុខ រាប់ ឆ្នាំ មកហើយ នោះ បាន វិល មក វិញ ហើយ ការប្រកួត របស់ គេ ភាគ ច្រើន បាន ទទួល ជ័យជំនះ ។
ចុងចោទ សំខាន់ ជាង គេ បាន ប្រកាស ស្រេច ហើយ ថា ខ្លួន នឹង តវ៉ា ឡើង ឧទ្ធរណ៍ ហើយ ការកាត់ទោស ម្តង ទៀត អាច ត្រូវ កំណត់ នៅ ឆ្នាំ ក្រោយ ៕
សង្គម វិទ្យា គឺជា មុខវិជ្ជា មួយ ក្នុង វិទ្យាសាស្ត្រ សង្គម ដែល ជួយ បង្រៀន មនុស្ស ពី របៀប រស់ នៅក្នុង សង្គម និង បែបបទ សង្គម ។
អ៎រ៉ាវី ទុក វា ចោល ចឹង មិច មិន យកមក ឱ្យ ខ្ញុំ ប្រើ
ខ្ញុំ ដឹង ពី របៀប ដោះស្រាយ ខ្ញុំ ពូកែ កាត់បន្ថយ កម្រិត នៃ អារម្មណ៍ តានតឹង ណាស់ នៅ ពេល ដែល ខ្ញុំ កត់សម្គាល់ ថា វា នឹង កើតឡើង មក លើ ខ្ញុំ ។
នៅពេល កាត់ក្តី ត្រូវ វិនិច្ឆ័យ តាម សេចក្តីពិត ហើយ សំរុះ សំរួល គ្នា តាម យុត្តិធម៌ ។
ពួកគេ ដាក់ទោស នាង ទុក ជា មេរៀន ដល់ ស្ត្រី ឯទៀត ៗ
ចាប់ខ្លួន ជនសង្ស័យ ពាក់ព័ន្ធ ប្លន់ អ្នកលក់ មាស ម្នាក់
តាម ការពិត ភ្លេង ពិណពាទ្យ មាន កំណើត ចេញ ពី ប្រទេស ឥណ្ឌា តាំងពី សម័យ ព្រេង នាយ មក ម្ល៉េះ ។
ដី សំរាប់ លក់ លើ ផ្លូវ កៅស៊ូ
ប្រកាស តែងតាំង អភិបាល ខណ្ឌ ច្បារអំពៅ ថ្មី ជា ផ្លូវការរស្មី កម្ពុជា
ចំនួន នេះ បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០១៤ កន្លងទៅ ឃើញ ថា មាន ការថយចុះ ។
ជំនោរ ស្នេហ៍ ដែល បក់ មក សូម កុំ នាំយក ស្នេហ៍ ទៅ
ក្នុង ឱកាស នោះ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ប្រធាន ក្រុមការងារ បាន ផ្តល់ ជូន និវត្ត ជន ចំនួន ១១នាក់ ក្នុង ម្នាក់ ៗ
ការបញ្ចេញ ជាតិ អាស៊ីត របស់ អ្នក ក៏ ត្រូវ កាត់បន្ថយ ផងដែរ ដូច្នេះ អាហារ អាច នៅសល់ ក្នុង រយៈពេល យូរ នៅក្នុង ពោះវៀន របស់ អ្នក ។
ប្រទេស អាល្លឺម៉ង់ និង ប្រទេស សង្គម និយម មួយ ចំនួន ទៀត ព្យាយាម កំណត់ ប្រព័ន្ធ អប់រំ របស់ ខ្លួន ឱ្យ ត្រូវ ជាមួយនឹង ការងារ ដែល ខ្លួន បាន ទស្សន៍ទាយ ។
អក្សរឞ នេះ ត្រូវ នឹង អក្សរ សំស្ក្រឹត ។
ធ្វើពុទ្ធ ក្រឹត្យា អស់ វស្សា សែសិប ប្រាំ ។
របាយការណ៍ របស់ លោក ឧត្តមសេនីយ៍ ស្នងការ បាន ឱ្យដឹង ថា ជនសង្ស័យ ទាំង ៣នាក់ ទី
សេចក្តី នេះ គឺ វា ប្រៀប បាន ហ្នឹង ផែនដី យើង រាល់ ថ្ងៃ កំពុងតែ ឆះ ហើយ យើង ម្នាក់ ៗ
ក្នុង ករណី នេះ ទៀតសោត គ្មាន ថ្នាំ ណា ដែល អាច លេប ទៅ អាច បង្គ្រប់ សរីរាង្គ កូន ក្នុង ផ្ទៃ បាន ហើយ ។
គេ ទំនងជា ត្រូវ រង់ចាំ រាប់ ខែ ទៀត ឯណោះ ។
គួរឱ្យដឹង ដែរ ថា ដួង ម៉ានិច ទទួលបាន ប្រជាប្រិយភាព យ៉ាង ខ្លាំង តាមរយៈ ការសម្តែង ខ្សែភាពយន្ត ថ្មី ជាច្រើន រឿង ។
នៅក្នុង ចំណុច ប្រទាក់ ការគ្រប់គ្រង អតិថិជន អ្នក រក ប្រអប់ តម្រង ។
ជា ពលរដ្ឋ រក ទុក
គេ បាន ដឹង ទៀត ថា ដំបូង វារីករាលដាល បន្តិច ៗ
មក មើល សាក់ ដ៏ កំប្លែង របស់ គន់ រៀមរតនៈ
លោក ខាន់ ជេមស៍ បញ្ជាក់ ។
សុខភាព មាន តម្លៃ ណាស់ សម្រាប់ មនុស្ស ម្នាក់ ៗ
ពត៌មាន មុន សត្វ ល្អិត សម្រាប់ អាហារ ពេលល្ងាច ?
បំផុត នៅក្នុង ចក្រវាឡ បាន មកពី ទីណា ។
លោក បន្ថែម ថា ក្នុង មួយ ជំនាន់ ៗ
សិរីកា បាន ចូល រៀន នៅ សាលារៀន អន្តរ ទ្វីប អាមេរិកាំង តាំងពី ថ្នាក់ ទី១ រហូត សព្វ ថ្ងៃ នេះ ។
ក៏ប៉ុន្តែ រាល់ ពេល រដូវ ប្រមូល ផល ម្តង ៗ
និយាយ ពី ព្រះ ដ៏ មាន ព្រះភាគ ទ្រង់ ហិត ថ្នាំ បញ្ចុះ ៩១
នោះ ដែរ លុះត្រាតែ យើង បាន ចូលរួម ក្នុង សកម្មភាព អ្វី មួយ ។
ថោក ទាប ណាស់ អ្នកដឹកនាំ ក្បាល យួន ខ្លួន ប្រែត !
គោលដៅ តែ មួយ គត់ របស់ លោក គឺ ធ្វើឱ្យ ជាប់ ឆ្នោត ជាថ្មី តែ ប៉ុណ្ណោះ ។
សូម ថ្លែងអំណរគុណ ដល់ ម្ចាស់ ឆានែល ដែល បាន កោតសរសើរ និង ផ្តល់ តម្លៃ ដល់ នាងខ្ញុំ គឺជា ការផ្តល់ កិត្តិយស ដ៏ ធំធេង មិន មែន ត្រឹមតែ ខ្ញុំ គឺ បាន ដល់ លោកឪពុក អ្នកម្តាយ និង ត្រកូល របស់ ខ្ញុំ ទាំងមូល ផងដែរ សូម អរគុណ ណាស់ អរគុណ មែនទែន
អ្នក ទាំងនោះ ម្នាក់ ៗ
ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម គឺ សាមញ្ញ អ្នក គ្រាន់តែ ធ្វើ វា . ទេ !
បណ្តឹង នេះ ត្រូវបាន ដាក់ ឡើង ទៅ ប្រព័ន្ធ យុត្តិធម៌ នៃ ក្រុង …
សិស្សានុសិស្ស ដោយ ឥត គិត ថ្លៃ ជាង ៣០០ នាក់
ទីក្រុង អង់ការ៉ា - អាកាសធាតុ ខែធ្នូ
ដំណើរការ ដោយ ម៉ាស៊ូត
អត្តពលិក ជាង ៦០ នាក់ នឹង ត្រៀម ប្រកួត ព្រឹត្តិការណ៍ កីឡា ជាតិ ឆ្នាំ នេះ
បណ្តាំ ហូជីមិញ ផ្តាំផ្ញើរ ចំពោះ សម មិត្ត កម្មាភិបាល របស់ ខ្លួន ឱ្យ ប្រុងប្រយ័ត្ន !
គួរឱ្យ ស្រលាញ់ ដូចគ្នា ឯង ឯណា ។
ព្រះអង្គ នាំ អ្នក ជាប់ ឃុំឃាំង
ជនជាប់ចោទ នេះ ត្រូវបាន ចាប់ខ្លួន តាំងពី ខែមករាម កម្លេះ ។
អ្នកជំនាញ ថា ម៉ាស់ គឺ គ្រោះថ្នាក់ ណាស់ សម្រាប់ ក្មេង …
លោក សួន សេរី រដ្ឋា អះអាង ថា គណបក្ស អំណាច ខ្មរ របសែ់ លោក នឹង មិន ដង្ហែរ ក្បួន ឃោសនា នោះ ទេ ៕
នេះ មាន ន័យ ថា លោក អ្នក ចូលចិត្ត ទស្សនវិជ្ជា ។
ការងារ អ្នក នឹង ទទួល ព័ត៌មាន រីករាយ ច្រើន ។
ចជចំនួន កេរបនេទ ។
អ្នកដឹកនាំ ល្អ ជាង គេ តែងតែ មាន ភាពក្លាហាន តែ មាន ការប្រុងប្រយ័ត្ន ។
កម្មវិធី ដែល លោក កំពុង កាន់ បច្ចុប្បន្ន មាន រហូតដល់ទៅ ៥កម្មវិធី ។
ពពួក មេរោគ ទាំងនោះ នឹង ត្រូវបាន ចាប់ បញ្ជូន មកកាន់ ផែនដី ដើម្បី សិក្សា ស្រាវជ្រាវ ត្រូវបាន ម៉ត់ចត់ ។
យើង ចង់ បង្កើន ចំនួន មនុស្ស ដែល ចង់ ចូលរួម ជាមួយ ក្លឹប អ្នកគាំទ្រ ។
ការរើសអើង របស់ តារា នេះ គឺជា ក្បួន ឬ គោលការណ៍ ដែល ត្រូវបាន អនុវត្ត ដោយ មិន ត្រឹមត្រូវ ក្នុង វិធី ផ្សេង គ្នា ទៅកាន់ ក្រុម មនុស្ស ឬ ភេទ ផ្សេង គ្នា ។
ការដើរ គឺជា វិធី ធម្មជាតិ ដ៏ ល្អ បំផុត មួយ ក្នុង ការរក្សា អ្នក អោយ មាន សុខភាពល្អ ។
ហើយ បន្ទាប់ពី ជាប់គាំង អស់ រយៈពេល ប្រមាណ ១៥យប់ កន្លង
ខ្ញុំបាទ ពុំ មាន ចេតនា ធ្វើឱ្យ ប៉ះពាល់ ដល់ កិត្តិយស កងកម្លាំង ជាតិ ឬ ធ្វើឱ្យ មាន ភាព មិន ប្រក្រតី ណាមួយ សម្រាប់ សង្គមជាតិ យើង ទេ ។
ការថែរក្សា សក់ របស់ អ្នក មាន សារសំខាន់ ដូចគ្នា ទៅនឹង ការថែរក្សា ស្បែក យ៉ាង ដូច្នោះ ដែរ ។
ដូច្នេះ អ្នក ដែល តែងតែ មាន ទំនោរ ទៅក្នុង រឿង ហេតុ ទាំងអស់ នេះ សូម ពិចារណា ដោយ ឧបាយ ប្រាជ្ញា ចុះ ៕
ភស្តុតាង វីដេអូ ខាងក្រោម ។
ចូរ សម្រេច កាម ដោយ ប្រើ ដៃ ក្នុង រយៈពេល ប៉ុន្មាន ម៉ោង មុនពេល ជួប គូណាត់ របស់ អ្នក ឬ មុនពេល អ្នក ទៅ ជិត ដិតស្និទ្ធស្នាល ជាមួយ គូស្នេហ៍ នារី របស់ អ្នក ដើម្បី រួមភេទ ។
ពួកគេ ប្រៀប ដូចជា ចង្រិត ត្រដាង ស្លាប
ភាសា របស់ អ្នក ត្រូវ ប្រាកដ ថា វា ជា ភាសា ដែល មិន បង្កឱ្យ មាន ភាព មិន ល្អ ចំពោះ ការអត្ថាធិប្បាយ របស់ អ្នក ឡើយ ។
ត្រូវ ចាំ ថា បើ បុគ្គល ជោគជ័យ ក្នុង លោក មាន ការតស៊ូ ល្មម ៗ
ខ្ញុំ ខំប្រឹង ឱ្យ អស់ លទ្ធភាព ដើម្បី បាល់ទាត់ ខ្មែរ
បន្ថយ កត្តា រំខាន ៖
នៃ ចលនា និង ចរន្ត អក្សរសិល្ប៍ បារាំង ដែល កើត មាន ឡើង នៅក្នុង សតវត្សរ៍ ទី២០ ។
គ្មាន អ្វី ត្រូវ បដិសេធ បាន ទេ ដែល ថា នៅ ពេល ដែល ស្ត្រី ចូល ដល់ វ័យ ៣០ ឆ្នាំ អាយុ ក្លាយជា រឿង មួយ ដែល គួរឱ្យ កត់សម្គាល់ ។
កំពុង ប្រកួតប្រជែង ជាមួយ អ្នកលក់ តូច ៗ
មក ច្បាំង ជាមួយ ស៊ី សេរ៉ា ។
តែ ភាពពិត គឺ កម្លាំង ស្នូល របស់ គេ ហ្នឹង ឯង ដែល គេ ធ្វើ ការបំភិតបំភ័យ ដល់ ពលរដ្ឋ ។
វីដេអូ បំភ្លឺ ពិភពលោក
មុននឹង ពិភាក្សា ចំនុច នេះ ឱ្យ បាន ជាក់លាក់ នោះ មាន រឿងរ៉ាវ មួយចំនួន ដែល ត្រូវ លើក មក
នេះ ជា ករណី ដំបូង នៅ ទ្វីប អឺរ៉ុប ដែល ទារក ម្នាក់ ត្រូវបាន បង្កើត ពី មនុស្ស ប្តូរ ភេទ ។
