ហើយ នោះ គឺជា ការស្លាប់ ដោយ គ្មាន សេចក្តីថ្លៃថ្នូរ ។
គាត់អូស ប បូរមាត់ទៅត្រចៀកនាង ហើយខ្សឹបចូល ។
លោកម៉ូសេ ត្រូវបានលាក់កំបាំងពីព្រះចៅផារ៉ោន ។
ពួកគេ មិន ស្គាល់ ពន្លឺ ទេ ។
សូមប្រុងប្រយ័ត្ន ហើយប្រយ័ត្នខ្លួនផង » ។
ទទួលយក គ្នា ទៅ វិញ ទៅ មក ដូច ព្រះគ្រីស្ទ បាន ទទួលយក អ្នក ដើម្បី នាំ ការសរសើរ ដល់ ព្រះ។
លក់ វា ទៅ អ្នកជិតខាង របស់ អ្នក ។
នៅលើ បល្ល័ង្ក ; ហើយ មាន ការឈ្លោះប្រកែកគ្នា គ្រប់ បែបយ៉ាង អំពី សាសនា និង
ជូនលោកអ្នកផងដែរ !
មាតា / បិតា ត្រូវបាន គេ ហៅ ថា ទិដ្ឋភាព ព្រះរាជ បុត្រា ឬ កូន របស់ ព្រះ។
គន្លឹះ សម្រាប់ វត្ថុ ។
គាត់ បាន បង្កើត ក្រុមហ៊ុន ច្បាប់ ដែល រក្សា បេះដូង របស់ ខ្លួន និង ការប្តេជ្ញាចិត្ត ដើម្បី ឧត្តមភាព ។
មានអ្វីដែលអ្នកមិនអាចធ្វើបាន, ស្ត្រី?
ព្រះយេស៊ូវ បាន ក្លាយជា ការពិត សម្រាប់ ខ្ញុំ ក្នុង រយៈពេល យូរ ។
ដែល ពួកវា ស្មើគ្នា ហើយ ដែល ត្រូវបាន បង្ហាញ ថា មាន ក្នុង ចំណោម ពួកគេ ទាំងអស់ ។
ម្នាក់ ទៀត ( ជនជាតិ អាមេរិក ដើម ) បាន និយាយ ថា “ ខ្ញុំ ព្រួយបារម្ភ យ៉ាង ខ្លាំង អំពី គ្រោះថ្នាក់ ដែល វា នឹង កើតឡើង ចំពោះ មិត្តភក្តិ និង សាច់ញាតិ របស់ ខ្ញុំ ។
នាងបានស៊ុតបាល់ បញ្ចូលទីបានយ៉ាងល្អក្នុងផ្នែកនេះ ។
ជំនោរ បាន ប្រែ ទៅជា ពិតប្រាកដ ។
មានអ្វីមិនប្រក្រតីអាចនឹងកើតឡើងក្នុងគ្រួសាររបស់អ្នក ឬនៅផ្ទះ ។
អាគុយ ម៉ង់ សម្រាប់ វិធីសាស្រ្ត គួរតែ ដូចគ្នា នឹង វិធីសាស្រ្ត អរូបី ។
សញ្ញាព្រមានអ្នកថាអ្នកនឹងធ្លាក់ដល់ស្លាប់ប្រសិនបើអ្នកមិនប្រយ័ត្ន ។
ប្រពន្ធពីរនាក់ស្រីបម្រើទាំងពីរនិងកូនទាំងដប់មួយរបស់គាត់បានទៅដីប្រាំពីរដងរហូតដល់គាត់ចូលមកជិតគាត់
នរណា ម្នាក់ នឹង ចូល ទៅក្នុង ភ្នែក របស់ ខ្ញុំ ។
យន្តហោះពាណិជ្ជកម្មរាងទូលាយដែល សហការផលិតដោយចិននិងរុស្ស៊ីមានឈ្មោះថា CR929 ។
១៤ បានទទួលស្គាល់ខ្ញុំ ។
ហើយ បន្ទាប់មក ត្រូវបាន ដុត ។
21បន្ទាប់ពីព្រះ‌ យេស៊ូបានជម្រាបសួរគេម្ដងទៀតហើយ ទ្រង់មានព្រះ‌បន្ទូល ថា៖ « ខ្ញុំចាត់អ្នកឲ្យមក ដូចព្រះ‌បិតាបានចាត់ខ្ញុំ មក » ។
ខ្ញុំ អាច មើលឃើញ ចំណុច របស់ ញូវយ៉ក ។
ចូរប្រោសអ្នកជំងឺដែលនៅ ទីនោះជាសះ ស្បើយ ហើយប្រាប់ពួកគេថា « ព្រះរាជាណាចក្ររបស់ព្រះ នៅជិតអ្នកហើយ » ។
ប៉ុន្តែវាមកដល់ពេលដែលគាត់ឈឺដែរ ។
ហើយខ្ញុំនឹងបន្តរស់នៅជាមួយនឹងការ សោកស្ដាយនោះរហូតដល់ថ្ងៃដែលខ្ញុំស្លាប់ » ។
៤ ខ្ញុំមិនអង្គុយជាមួយនឹងមនុស្សគ្មានតម្លៃ ឬសេព គប់នឹងមនុស្សមានពុតឡើយ ។
ផែនដីជាកន្លែងដ៏គួរឱ្យស្រឡាញ់ដើម្បីរស់នៅ ។
ខ្ញុំ កំពុង ធ្វើជា សាក្សី ។
ព្រោះយើងដើរលើផ្លូវរួចហើយ …» ។
« ឯងមិនដឹងថាយើងនឹងវិនិច្ឆ័យទេវតាឬ ? »
យើង ទាំងអស់ គ្នា ត្រូវបាន ល្បួង ឱ្យ ឃ្លាត ឆ្ងាយ ពី អ្នក ដែល បាន ប្រព្រឹត្ត អំពើ បាប ។
តើអ្នកពិតជានឹងមិនសប្បាយ ចិត្តក្នុង រយៈពេលនោះទេ ?
កុំ ប្រើ ពួកវា លើ មនុស្ស
' ពាក្យ គឺ នៅជិត អ្នក ; វាគឺនៅក្នុងមាត់របស់អ្នក និងក្នុង ចិត្តរបស់អ្នក ,' ។
យើងប្រហែលជាត្រូវបានល្បួងឲ្យជឿថា ព្រះ កំពុង តែចាប់យើង ។
ខ្ញុំ គ្រាន់តែ មើល ការខុសត្រូវ របស់ ខ្ញុំ !
នេះ អាច ត្រូវបាន គេ ហៅ ថា ផែនការខ ។
« ស្រឡាញ់ភាតរភាពនៃអ្នកជឿ កោតខ្លាច ដល់ព្រះ ហើយលើក ត ម្កើងស្ដេច » ។
យើងត្រូវបាន ហ៊ុំព័ទ្ធដោយការ រីក ចម្រើន
គាត់បានបន្ថែមថា គាត់មិនដឹងថាកូនគាត់ រស់នៅទី ណាទេ ។
អ្នកដែលចូល មកអាចឃើញពន្លឺ » ។
និង ទ្រព្យសម្បត្តិ នៃ ការមក រដូវ ។
“ ខ្ញុំគិតថាវាល្អជាងព្រោះក្មេងចូលក្នុងបច្ចេកវិទ្យា ។
បន្ទាប់មក យើង អាច ទៅ គ្លីនីក ។
ទាំងនោះជាការ មើលឃើញពិត ឬក៏ជាការ បំភាន់ភ្នែក ។
នេះ គឺជាមួយ ទៀត ដែល គាត់ អាច សម្លាប់ បាន ។
យើងត្រូវបានល្បួងឱ្យឆ្ងល់ថាតើយើងនឹងត្រូវបានបណ្ដេញចេញពីវត្តមានរបស់គាត់ហើយយើងសួរថាតើមាន វិធី ណាមួយដើម្បីបំបាត់ ភាព អាម៉ាស់របស់យើងមុនថ្ងៃនោះមកដល់ ?
បន្ទាប់មកនៅ ទីបំផុតលេខសម្ងាត់សម្រាប់នាងត្រូវបានលេច ធ្លាយ ដូច្នេះនាងបានបោះបង់គណនី ។
« បើយើងស្លាប់ជាមួយគាត់ យើងក៏នឹង រស់នៅជាមួយគាត់ដែរ ។
ហើយ បុរស ទាំងអស់ ចង់ ក្លាយជា ។
ហើយបន្ទាប់មកបានរង់ចាំយ៉ាងអន្ទះសាដោយអ្នកភ្នាល់ ។
នាងបាននិយាយថាគ្មានអ្វីងាយស្រួលដូចដែលវាហាក់ដូចជានៅពេលដែលវាមកដល់ការ បង្កើតតន្ត្រីរបស់នាងនៅក្នុងឧស្សាហកម្មអាមេរិក។
ភាពអាម៉ាស់ ដែល ខ្ញុំ មិន អាច ។
« លោកម្ចាស់ តើលោកនឹងស្ដាររាជាណាចក្រដល់អ៊ីស្រាអែលឥឡូវនេះឬ ? » ។
នេះ គឺជា កូនប្រុស ទាំង បី របស់ ឪពុក ពួកគេ ។
បញ្ជី ទាំង នេះ នឹង មាន ប្រយោជន៍ សម្រាប់ អ្នក ទាំងអស់ គ្នា ។
ប៉ុន្តែ ទ្រង់ បាន យាង មក ក្នុង ភាពពេញលេញ នៃ ពេលវេលា ។
តើអ្នកបដិសេធថាអ្នក ជឿលើការ ព្យាបាលដោយអព្ភូតហេតុដោយការ ដាក់ដៃឬ ?
ហើយ ពួកគេ នឹង ដំណើរការ ក្នុង រយៈពេល បួន ខែ ទៀត ។
២ - តើ វា មិន ប្រាកដ ទេ ថា ពួក បរិសុទ្ធ នឹង ក្លាយជា ចៅក្រម នៃ ពិភពលោក ? ប្រសិនបើលោកីយ៍នឹងត្រូវវិនិច្ឆ័យដោយអ្នក តើអ្នកមិនអាចសម្រេច ចិត្តអំពីរឿងតូចបំផុតបានទេ ?
អ្នក បច្ចេកទេស មន្ទីរពិសោធន៍ ធ្វើការ ជាមួយ អ្នក ។
បច្ចុប្បន្ន មិន មាន ការគាំទ្រ សម្រាប់ លីនុច ទេ ។
នេះ គឺជា ពេលវេលា ដ៏ ល្អ បំផុត សម្រាប់ ពួកគេ ។
គាត់ នឹង មកដល់ ឆាប់ ៗ នេះ ; ចូរ កាន់តាមអ្វីដែលអ្នកមាន ដើម្បីកុំឲ្យអ្នក ណាដកមកុដរបស់អ្នកបានឡើយ ។
មិនមែននៅពេលនោះទេ ប៉ុន្តែអ្នក ណាដែលទៅមុខ វាទុករន្ធនៅពីក្រោយ » ។
១០ ដោយហេតុនេះហើយបានជាឃើញថាអ្នក ណាជាកូនរបស់ព្រះ ហើយអ្នក ណាជាកូនរបស់អារក្ស អ្នក ណាមិនប្រព្រឹត្តតាមសេចក្ដី សុចរិត អ្នកនោះមិនមែនមកពីព្រះ ហើយក៏មិនស្រឡាញ់បងប្អូនដែរ ។
