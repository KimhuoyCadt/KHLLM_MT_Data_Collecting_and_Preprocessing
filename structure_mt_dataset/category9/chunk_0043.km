ខ្ញុំ៖ ថ្ងៃ នេះ ខ្ញុំ មាន កិច្ចការ ជាច្រើន ដែល ត្រូវ ធ្វើ ។
សេចក្តី សុចរិតរបស់ទ្រង់ ទ្រង់បានបើកសម្ដែងនៅចំពោះមុខប្រជាជាតិនានា ។
បន្ទាប់មក ទ្រង់ បាន ដកដង្ហើម លើ ពួកគេ ហើយ មាន បន្ទូល ទៅកាន់ ពួកគេ ថា « ចូរ ទទួល ព្រះវិញ្ញាណ បរិសុទ្ធ ចុះ » ។
ពួកគេ នឹង ស្តាប់ សំឡេង របស់ ខ្ញុំ
យើង ទាំងអស់ គ្នា ដែល មាន ភាព ចាស់ទុំ គួរ ទទួលយក នូវ ទស្សនៈ បែប នេះ ។ ហើយប្រសិនបើអ្នកគិតខុសពីចំណុច ណាមួយ ព្រះ ក៏នឹងបញ្ជាក់ឲ្យអ្នកច្បាស់ដែរ ។
ដូច្នេះពួកគេស្រកទម្ងន់ដោយ សារ តែពួកគេមិនបានបរិភោគ ។
៣០ ព្រះយេស៊ូមានព្រះបន្ទូល តប ថា៖ « សំឡេងនោះមិនមែនជាប្រយោជន៍ដល់ខ្ញុំទេ គឺសម្រាប់អ្នក រាល់គ្នា ។
វាជាអ្វីដែលពួកគេបាននិយាយថាពួកគេបានធ្វើ ហើយបន្ទាប់មកបានផ្តល់ធ្មេញឲ្យវាដើម្បីអាចអនុវត្តវាបាន » ។
សត្រូវ នឹង ត្រូវ បំផ្លាញ ឥឡូវនេះ និង ជារៀងរហូត ។
« ខ្ញុំប្រាប់អ្នកតាមការ ពិត ម្នាក់ក្នុងចំណោមអ្នក រាល់គ្នានឹងក្បត់ខ្ញុំ ។
គាត់ មិន អាច ធ្វើ អព្ភូតហេតុ នៅ ទីនោះ បាន ទេ លើកលែងតែ ដាក់ ដៃ លើ មនុស្ស ពីរ បី នាក់ ដែល ឈឺ និង ព្យាបាល ពួកគេ ។
ពួកគេថ្វាយបង្គំស្ដេចដែលដឹកនាំពួកគេ ហើយស្បថនឹងភក្ដីភាព ។
នេះ នឹង អនុញ្ញាតឱ្យ អ្នក កំណត់ ការពិត ឬ មិន ពិត របស់ ពួកគេ ។
ទ្រង់បានដកដង្ហើមលើពួកគេ ហើយមាន បន្ទូលទៅពួកគេថា៖ ‹ សូមទទួលព្រះវិញ្ញាណបរិសុទ្ធ ។
នៅ ពេល ដែល អំពើ បាប ត្រូវបាន លើកលែង ទោស វា ត្រូវបាន ទម្លាក់ ទៅក្នុង សមុទ្រ នៃ ការភ្លេចភ្លាំង ហើយ វា មិន មាន ទៀត ទេ ។
បន្ទាប់ពីការ បោះឆ្នោត ពួកគេបានហៅគាត់ ហើយគាត់បានត្រឡប់ទៅបង្រៀនវិញយ៉ាងអន្ទះសា ។
បុរសនឹង លះចោលការ រីករាយ ណាមួយដែលអ្នកចូល ចិត្ត ប៉ុន្តែគាត់មិនបោះបង់ការ រងទុក្ខឡើយ ។
អ្នកត្រូវបានចាក់សោក្នុងរយៈពេលជាងបួនម៉ោង ។
យើង ស្គាល់ ព្រះអង្គ ដែល ពោល ថា យុត្តិធម៌ ជា របស់ ខ្ញុំ ។ ខ្ញុំ នឹង សង ពួកគេ ។
អបអរសាទរ ទិវា ឪពុក ដំបូង របស់ ស្វាមី ។
គាត់ គឺជា ការអត់ទោស របស់ ព្រះសម្រាប់ ពួកគេ ។
ចូលរួម យ៉ាង សកម្ម ក្នុង គ្រប់ សកម្មភាព របស់ សហគមន៍
ដូច្នេះហើយ ពួកគេ មិន អាច ផ្តល់ឱ្យ អ្នក នូវ អ្វី ដែល អ្នក ចង់បាន នោះ ទេ ។
យើង ស្នាក់ នៅក្នុង ផ្ទះល្វែង ចំនួន 4 ។
ខ្ញុំ នឹង ប្រមូល ពួកគេ ពី គ្រប់ ទិសទី ហើយ នាំ ពួកគេ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
សប្តាហ៍ និង ខែ នៃ ក្តីសុបិន្ត បាន បញ្ចប់ ។
គាត់ ធ្លាប់ នៅក្នុង សួនច្បារ ហើយ នៅ ពេល ដែល កាំភ្លើង ត្រូវបាន រំសាយ ចេញ បន្តិច
៨ ប៉ុន្តែ ទ្រង់ជ្រាបពីគំនិតរបស់គេ ហើយទ្រង់មាន បន្ទូលទៅបុរសដែលដៃស្វិតនោះថា
ម៉ូសេ បានទទួល ការ អប់រំតាមប្រាជ្ញារបស់ជន ជាតិអេស៊ីប ។
ឱ ព្រះបិតាអើយ សូមលើក ត ម្កើងនាមរបស់ព្រះអង្គចុះ » បន្ទាប់មកមានសំឡេងមួយ មកពីលើមេឃ ថា៖ « ខ្ញុំបានលើក ត ម្កើងវា ហើយខ្ញុំនឹងលើក ត ម្កើងវាម្ដងទៀត » ។
បើឯងធ្វើបែបនេះទៀត ខ្ញុំនឹងចាប់ឯង » ។
បន្ទាប់មកគាត់បាននិយាយម្តងទៀតថា “ សូមអរគុណលោកម្ចាស់ ។
« បើបងប្រុសរបស់អ្នក » មាន ន័យថា « ធ្វើ បាបនឹងអ្នក ចូរបន្ទោសគាត់ ហើយប្រសិនបើគាត់ ប្រែ ចិត្ត សូមអត់ទោសគាត់ ។
គ្មានការ ឆ្លើយ តបមកវិញទេ ព្រោះគាត់នៅឆ្ងាយហើយ ។
ចេញ ពី ស្មារតី ខណៈពេល ដែល សម្អាត វា ។
កុំ បំពុល បច្ចុប្បន្ន ដោយ ការភ័យខ្លាច ពី អតីតកាល ។
« ហេតុអ្វីបានជាគាត់បរិភោគជាមួយនឹងអ្នក ទារ ពន្ធ និងមនុស្សមាន បាប ? » ។
ប៉ុន្តែអ្នក ណាវាយអ្នកក្រោយក៏ទទួលបានប្រយោជន៍ដែរ ។
ខ្ញុំនឹងប្រឈមមុខនឹង ភាព ភ័យរន្ធត់ដូច្នេះអ្នកអាចងាកចេញ , ងាកចេញ .
អ្នក ទាំងអស់គ្នា បើអ្នកបានឮគេមិនជឿ ។
ហើយសម្រាប់ព្រះ ដ៏បរិសុទ្ធនៃ សាសន៍អ៊ីស្រាអែល ដោយ សារទ្រង់បាន (X) លើក ត ម្កើងអ្នក ។
ពេលឃើញព្រះអង្គក៏ក្រាបថ្វាយបង្គំព្រះអង្គ ប៉ុន្តែមានអ្នកខ្លះ សង្ស័យ ។
៥៣ បន្ទាប់មក ពួកគេម្នាក់ ៗទៅផ្ទះរៀងខ្លួន ។
ម្យ៉ាងទៀត អ្នកដែលមាន ចិត្តបរិសុទ្ធ មាន ពរហើយ ដ្បិតគេនឹងឃើញព្រះ។
ថ្ងៃ នេះ និង ថ្ងៃស្អែក គឺ សម្រាប់ អ្នក ។
ឈឺខាងក្នុងហើយចង់និយាយរឿងហ្នឹង ។
លើកឡើងក្នុងកិត្តិយសនៃ សមិទ្ធិ ផល។
លោកយេស៊ូបាននៅក្រោយក្រុងយេរូសាឡិម ប៉ុន្តែឪពុកម្ដាយរបស់លោកមិនបានដឹងទេ ។
ហើយគ្រូដ៏ល្អមាន ប្រសាសន៍ ថា៖ « ឥឡូវនេះកូនអើយ !
ហើយមិនបានឮពីមុនមកទេ ) ។
គាត់ បាន វង្វេង ក្នុង ចំណោម កុមារ ដទៃ ទៀត ។
ដោយ សារព្រះ‌បន្ទូលនៃព្រះ‌ អម្ចាស់ គាត់បានបិទផ្ទៃមេឃ ហើយក៏បានពន្លត់ ភ្លើងបីដងដែរ ។
នៃ មុខ ផ្កា ឈូក របស់ ព្រះអម្ចាស់ នៃ ពិភពលោក ទាំង បី ។
គេអាច មកសាកយកវាពីខ្ញុំ » ។
កូនស្រីបីនាក់និងកូនប្រុសបួននាក់ទាំងអស់ត្រូវបានគេកំណត់
យើងនឹងបន្តធ្វើការ ជាមួយអ្នក ដើម្បីជាប្រយោជន៍ដល់ពលរដ្ឋអ៊ីស្រាអែលរហូតដល់ចប់អាណត្តិ » ។
គាត់បានត្រូវបានណែនាំតាមរបៀបរបស់ព្រះអម្ចាស់ ហើយបាននិយាយដោយរីករាយ ។
ពេលម៉ូសេ ត្រូវបានបង្គាប់ឲ្យទៅជួបផារ៉ោន គាត់ត្រូវបានជួបនឹងការ ប្រឆាំងដោយគ្រូ មន្តអាគមរបស់ផារ៉ោន ។
ទុតិ យក ថា 2:21 លោកអប្រាហាំជាបិតារបស់យើងបានវិនិច្ឆ័យដោយអំពើសុចរិតរបស់លោកទេ គឺពេលដែលលោកធ្វើ តង្វាយអ៊ីសាក ជាកូនរបស់លោកនៅលើអាសនៈ ។
ដោយ សារ តែរឿងនេះ គាត់បានរងគ្រោះដោយដៃ ហើយត្រូវគេចាប់ដាក់គុករហូតដល់ស្លាប់ ។
ខ្ញុំនឹងមិនត្រឡប់ទៅវិញទេ រហូតទាល់ តែពួកគេមិនបានធ្វើការ ខូចខាតវិញ ។
នៅអ៊ីស្រាអែល គ្មាននរណាទំនេរទេ ។
ការដោះលែង ភាពតានតឹង៖ កំណត់ អត្តសញ្ញាណ .. .
ខ្ញុំបានទៅសហរដ្ឋអាមេរិក ខ្ញុំក៏បានចាកចេញពីពេលនោះដែរ ។
« កូនស្រីអើយ ជំនឿរបស់អ្នកបានព្យាបាលអ្នកហើយ » ។
