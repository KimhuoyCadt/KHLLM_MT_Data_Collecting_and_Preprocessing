បទគម្ពីរចែងថា៖ « ពេលពួកគេងើបមុខឡើង នោះមិនឃើញអ្នក ណាក្រៅពីលោកយេស៊ូឡើយ » ។
8 ខ្ញុំ បាន ជ្រមុជ ទឹក អោយ អ្នក ប៉ុន្តែ ទ្រង់ នឹង ធ្វើ ពិធី ជ្រមុជ អ្នក ដោយ ព្រះវិញ្ញាណ បរិសុទ្ធ ។
ហើយអ្នកនឹងមានសេចក្តី អំណរ និងសេចក្តី រីករាយ ហើយមនុស្សជាច្រើននឹង រីករាយនៅពេលដែលទ្រង់ប្រសូត ( លូកា ១: ១៤) ។
នៃ ដំណាំ ដោយ បន្សល់ទុក ពីរ ភាគ បី សម្រាប់ អ្នក ជួល ។
« ប៉ុន្តែ ព្រះទ្រង់មានព្រះបន្ទូលដូច្នេះថា កូនចៅរបស់ទ្រង់នឹង រស់នៅក្នុងស្រុកក្រៅ ហើយនឹង នាំពួកគេទៅជាទាសករ ហើយសង្កត់ ស ង្កិនពួកគេបួន រយឆ្នាំ ។
វាមានរយៈពេលវែង ដែលក្នុងនោះស្ថិតនៅក្នុងប្រទេសកាហ្សាក់ ស្ថាន ។
៩ ទោះជា យ៉ាងណា ក៏ដោយ ចូរ ប្រយ័ត្ន ថា ការអនុវត្ត សេរីភាព របស់ អ្នក មិន ក្លាយជា ឧបសគ្គ ចំពោះ អ្នក ទន់ខ្សោយ នោះ ទេ ។
មានពាក្យចាស់បុរាណចិនមួយពោលថា “ គិតបីដងមុននឹងធ្វើ ” ។
ដូច្នេះតើអ្នកអាចនិយាយថា៖ « សូមបង្ហាញព្រះវរ បិតាឲ្យយើងឃើញ?
បើគេមិនទទួលគេបដិសេធ » ។
« ឯងឲ្យខ្ញុំយកក្មេងនេះទៅផ្ទះជាមួយខ្ញុំឬ ?
ភ្លៀងធ្លាក់ពេញមួយយប់ ហើយមាន សភាពទ្រុឌទ្រោមនៅតាមផ្លូវ ។
វាដុះឡើងយ៉ាងលឿន ព្រោះដីរាក់ ។
26 ទូលបង្គំបានប្រកាសអំពីមាគ៌ារបស់ទូលបង្គំ ហើយព្រះអង្គបានឆ្លើយ តបមកទូលបង្គំ ។ បង្រៀន ខ្ញុំ អំពី លក្ខន្តិកៈ របស់ អ្នក ។
អរគុណ សម្លាញ់ ខ្ញុំ ទៅដល់ ទីនោះ ហើយ ។
តើអ្នកមិនដឹងថារូបកាយរបស់អ្នកគឺជាផ្នែកនៃរូបកាយរបស់ព្រះគ្រីស្ទឬ ?
បណ្តាសា របស់ ព្រះជា ម្ចាស់ មក លើ មនុស្សជាតិ ដោយសារ អំពើ បាប របស់ អ័ដាម ។
« បើអ្នក ណាមក ឯអ្នក រាល់គ្នាហើយមិនយកការ បង្រៀននេះមកទេ កុំយកគាត់ចូលផ្ទះឬស្វាគមន៍គាត់ឡើយ ។
៨៨ ដ្បិតយើងមិនអាចធ្វើអ្វីដែលប្រឆាំងនឹងសេចក្ដី ពិតបានឡើយ គឺសម្រាប់ តែសេចក្ដី ពិតប៉ុណ្ណោះ ។
វា ធ្វើឱ្យ ច្បាស់ ថា អ្នក កំពុង ខិតខំ ប្រឹងប្រែង ។
ហើយ នៅសល់ នឹង ទទួលបាន សញ្ញាបត្រ កម្រិត ខ្ពស់ ។
អ៊ីស្រាអែលទាំងអស់នឹងត្រូវបាន សង្គ្រោះ ដូចមានចែងទុកមកថា៖ « ព្រះ ដ៏ សង្គ្រោះនឹងចេញពីស៊ីយ៉ូន ហើយទ្រង់នឹង បង្វែរអំពើទុច្ចរិតចេញពីយ៉ាកុប » ។
ខ្ញុំ ប្រកាស អំពី អ្វី ដែល ខ្ញុំ បាន ឃើញ នៅក្នុង វត្តមាន របស់ ព្រះបិតា ។ រីឯអ្នក វិញ អ្នក រាល់គ្នាត្រូវធ្វើតាមអ្វីដែលអ្នក រាល់គ្នាបានឮ មកពីព្រះ‌បិតា » ។
សូម ប្រាប់ ខ្ញុំ ប្រសិនបើ អ្នក មិន អាច បើក វា បាន ។
ហើយមិនបាននិយាយដោយភ័យខ្លាច ។
« កូនមនុស្សអើយ តើ សាសន៍អ៊ីស្រា ‌ អែលដែលបះ ‌ បោរមិនបានសួរអ្នកថាអ្នកកំពុងធ្វើអ្វី ?
ក្រុមដែលយើងកំពុង តែនិយាយជាមួយ ពួកគេនឹងមិនចាកចេញពីទីក្រុងទេ ។
ទោះ ជាយ៉ាង ណា ការ គំរាម កំហែងរបស់អ្នក គោរពបូជាមិនទាន់ចប់ទេ ។
ការសន្យា គឺ ថា ដូច្នេះ យើង ត្រូវបាន សង្គ្រោះ ។
វាជារយៈពេលដែលភ្លៀងធ្លាក់ក្នុងទឹក ជំនន់ដ៏ធំនៅសម័យ ណូ អេ ។
ជា ចុងក្រោយ ខ្ញុំ បាន ធ្វើ បច្ចុប្បន្នភាព ប្លក់ របស់ ខ្ញុំ ។
អ្នក នៅ រស់ រានមានជីវិតមានកូនស្រីបួននាក់គឺលោកស្រី ។
លេបមិនរួច ហើយខ្លាចធ្វើ សក្ការៈ
យើងសម្រេចហើយប្រកាសថាពន្លឺចែងចាំងក្នុង ភាពងងឹត ហើយ ភាពងងឹតមិនអាចបង្ក្រាបវាបានឡើយ !
បដាពីររបស់អ្នកបោក ប្រាស់ និងអ្នក បន្លំ ។
ហើយពេលឪពុកម្តាយដឹងរឿងនេះ
« ព្រោះវាត្រូវបានផ្ដល់ឲ្យអ្នក រាល់គ្នាដើម្បីដឹងពីអាថ៌កំបាំងនៃ នគរស្ថាន សួគ៌ ប៉ុន្តែវាមិនបានប្រទានដល់ពួកគេទេ ។
« បន្ទាប់មក ស៊ីម្មាន បាន ប្រទាន ពរ ដល់ ពួកគេ ហើយនិយាយ ទៅកាន់ ម៉ារា ថា មាតា របស់ ទ្រង់ ថា កូន នេះ ត្រូវ កំណត់ ថា នឹង ធ្វើឲ្យ មនុស្ស ជាច្រើន ដួល សន្លប់ និង កើនឡើង ក្នុង ប្រទេស អ៊ីស្រាអែល ហើយ ជា ទី សំគាល់ ដែល នឹង ត្រូវ និយាយ ដូច្នេះ គំនិត នៃ ចិត្ត ជាច្រើន នឹង ត្រូវបាន បង្ហាញ ។
១៧ បើអ្នក យល់សេចក្ដី ទាំងនេះ នោះអ្នកនឹងបាន ពរ បើអ្នកធ្វើតាម ។
អ្នកជំពាក់ វា ដោយ ខ្លួន ឯង ដើម្បី ស្វែងយល់ នៅ វគ្គ នា ពេល ខាងមុខ ។
គាត់កំពុងបង្រៀននៅក្នុងសាលា ប្រជុំ ហើយអ្នក រាល់គ្នាសរសើរគាត់ (NIV) ។
ប្រហែលជា គំនិត ល្អ នៅក្នុង ប្រទេស ខ្លះ ។
ខណៈពេល ដែល ពួកគេ ប្រហែលជា មិន អាច ធានា អ្នក បាន ពួកគេ អាច ផ្តល់ ការគាំទ្រ និង ការណែនាំ ។
ការបង្កើត វេទិកា ។
ខ្ញុំ ត្រូវការ មនុស្ស ។
នៅពេលជិតថ្ងៃមុខរបស់គាត់ កាន់ តែច្រើន ។
ពួកគេ សម្លឹងមើល គ្នា ទៅ វិញ ទៅ មក ម្នាក់ ស្លាប់ និង ម្នាក់ ទៀត មើល គាត់ ស្លាប់ ។
យើងមិនដែលនិយាយថា " តើអ្នកអាចធ្វើការ ពិនិត្យមើលនេះបានទេ ? " ឬ " តើអ្នកអាច វាសម្រាប់យើងនៅពេលដែលវាបានចាប់ ផ្តើ ម? "
តើអ្នកគិតថាជនជាតិអាស៊ីត្រូវបានគេដាក់ឈ្មោះលើសចំណុះក្នុងប្រព័ន្ធផ្សព្វផ្សាយទេ?
ចង់ប្រាប់អ្នក រាល់គ្នាក្នុងហ្វេស ប៊ុកទេ ? »
ដូច្នេះ ខ្ញុំ យក គាត់ នៅ ថ្ងៃ នេះ ។
ប៉ុលបានសរសេរថា៖ « ហើយខ្ញុំអើយ ពេលខ្ញុំមក ឯអ្នក រាល់គ្នាមិនបានមកប្រាប់អ្នក រាល់គ្នានូវទី បន្ទាល់អំពីព្រះ ដោយពាក្យ សម្ដីឬប្រាជ្ញាដ៏ខ្ពង់ខ្ពស់ឡើយ ។
ពួកគេកំពុង តែប្រកែកគ្នាថាមួយ ណាជាអ្នកខ្លាំងជាងគេ ។
ឥណ្ឌូណេស៊ី ផ្តោត សំខាន់៖ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ត្រៀមខ្លួន ជាស្រេច ដើម្បី ប្រកួតប្រជែង ជាមួយ ចិន និង ឥណ្ឌា ?
ទាំងនេះ រក្សា ភាពអស្ចារ្យ របស់ ពួកគេ ។
ដ្បិតខ្ញុំនឹងនៅ ជាមួយអ្នកដូចជាខ្ញុំនៅ ជាមួយនឹងលោកម៉ូសេ ។
ថ្ងៃ ណាមួយ ដែល យើង ប្រាថ្នា យើង អាច ចាប់ផ្តើម សកម្មភាព ថ្មី ។
តើ យើង រស់ នៅ តាម សេចក្តីពិត ដែល យើង ដឹង ឥឡូវនេះ ទេ ដូច្នេះ យើង នឹង ត្រៀមខ្លួន សម្រាប់ ពន្លឺ និង សេចក្តីពិត បន្ថែម ទៀត នៅ ពេល ដែល ព្រះបើក សម្តែង វា ដល់ យើង ?
ហើយ មើល ព័ត៌មាន អំពី សំឡេង ។
