េយ ខ្លួន សន៍ ច យកមក ពេិយ ខ្លួន ឯង បចចត្តេំវ ទិតេព្វ ។
លោក ថា ប្រសិនបើ អារម្មណ៍ កាន់តែ អាក្រក់ ទៅ ៗ
ស្លាប់ នៅក្នុង ផ្ទះ ជួល ប៉ុន្តែ ត្រូវបាន ម្ចាស់ ផ្ទះ យកមក បោះចោល
តោះ ប្រិយមិត្ត ទៅ មើល ទាំងអស់ គ្នា តើ នាង ស្អាត ប៉ុណ្ណា ទៅ !
ខ្ញុំ ផ្ទៃក្នុង ច្រក អូរ
គាត់ និយាយ ថា គាត់ គ្រាន់តែ ជា អ្នកដំណើរ ប៉ុណ្ណោះ នៅក្នុង កប៉ាល់ នេះ ។
វា ជា ទម្លាប់ ដែល រដ្ឋាភិបាល ធ្វើ តាំងពីដើម មក ។
ខាងក្រោម នេះ គឹជា រឿង និទាន ខ្លី ៗ
យោង តាម របាយការណ៍ការ របស់ ក្រសួង ទ…
មួយវិញទៀត រហូតមកដល់ សព្វ ថ្ងៃ នេះ ប្រាសាទ បាយ័ន មាន អត្ថន័យ ប្រវត្តិសាស្ត្រ និង សាកល យ៉ាង ពេញ បន្ទុក ដោយ ការប្រៀបធៀប ខាងក្រោយ នេះ ៖
ផឹក ស្រា ទំពាំងបាយជូរ មួយ ថ្ងៃ មួយ កែវ ជួយ ឱ្យ អ្នក មាន រាង ស្អាត
ប៉ុន្តែ បើ ទោះបី លទ្ធផល ផ្សេង ៗ
ដែល ពួកគាត់ បរិភោគ ។
ព្រោះ ហេតុ អ្វី ព្រាហ្មណ៍ ទើប ចូលទៅ រក ព្រះ ដ៏ មាន ព្រះភាគ ?
ប្រហែល ប៉ុន្មាន នាទី ស្រាប់តែ ខ្ញុំ ក្រឡេក ឃើញ ស្រី ម្នាក់ កំពុងតែ ឈរ នៅ ពីមុខ ខ្ញុំ ប្រហែល ដប់ ប្រាំ ម៉ែត្រ ។
ក្រៅពី ប្រើ ស្នៀត ជើង ទាំងនេះ បាន ល្អ នោះ ស្នៀត កណ្តាប់ដៃ ជង្គង់ កែង របស់ គេ ក៏ មិន អាច មើលស្រាល បាន ដែរ ។
ប្រសិនបើ អ្នក ពិតជា ត្រជាក់ ឬ ពិតជា ក្តៅ នោះ ប្រសើរ ជាង !
បញ្ហា ស្នេហា នឹង មាន ការថ្នាំង ថ្នាក់ ព្រោះតែ ពាក្យសម្តី ជាក់ ជា ពុំ ខាន ។
គេ មិន អាច បញ្ជាក់ បាន ទេ អំពី ភាពត្រឹមត្រូវ នៃ រូបថត ទាំងនេះ ។
ហើយ យើង ក៏ អាច ត្រូវបាន ជ្រើសតាំង ជា មន្ត្រី និង សិល្បករ ដូចគ្នា ។
កុំ ជឿក ម្លៅនុ៎ះ ។
កុំ ពាល ដូច នាយក មន្ទ្រី ណា ពេល ក្ស័យ សង្ខារ កេរ្ត ឈ្មោិ៍ះល្អ ។
ពួកគេ មាន ការភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ពេល ដែល ខ្ញុំ ឱ្យ ពួកគេ ម្នាក់ ៗ
ព្រះអង្គ មិន ព្រម រក យុត្តិធម៌ អោយ ខ្ញុំ ទេ ។
ហើយ អ្នក កំពុង ស្វែងរក នូវ វិធី ងាយ ៗ
ផលិតផល តែ ស្ករ ថ្នាំជក់ ជ័រ អំបិល និង ឫស្សី ត្រូវបាន នាំចេញ ពី ម៉ាត ម្លឺ ។
ត្រូវ គិត ថា អ្នក មិន នៅតែ ម្នាក់ឯង ទេ ។
ប៉ុន្តែ លោក នឹង មិន បង់ប្រាក់ តាម ការបង្គាប់ របស់ តុលាការ នោះ ទេ ៕
សូម ជំរាប បងប្អូន ថាះងារ ជា ស្តេច មួយ ៗ
ព្រះជាម្ចាស់ បាន រាប់ ពួកគេ ទុក ជា បុត្រ របស់ ព្រះអង្គ ពួកគេ មាន សិរី រុងរឿង មាន សម្ពន្ធ មេត្រី នានា មាន គម្ពីរ វិន័យ ស្គាល់ របៀប គោរព បំរើ ព្រះអង្គ ទទួល ព្រះបន្ទូល សន្យា ផ្សេង ៗ
លោក គាត ឈន់ មានប្រសាសន៍ ថា គម្រោង ថវិកា ទាំងនេះ នឹង ត្រូវ ផ្តោត ទៅ
ប៉ុន្តែ ដល់ ពេល សម័យ បច្ចុប្បន្ន វិញ ដូចជា មិន សូវ មាន នរណា ចូលចិត្ត ញ៉ាំ ស្លឹក ម្លូ លេង ទៀត ណាស់ ។
ហេតុ ដូច្នេះ លោក មិន ចាំបាច់ តាមដាន ច្រើន លើ រឿង នេះ ទៀត ទេ ។
ស្ទើរតែ រក កន្លែង អង្គុយ មិន បាន … យើង មាន តែ ផ្កា ហើយ ផ្កា នោះ យើង បាន ប្រគល់ ដល់ លោក អ៊ំ និង លោកយាយ លោក តា ដែល គាត់ កំពុង អង្គុយ សូត៌្រ ធម នៅ ទីនោះ បន្ទាប់មក ពួក ខ្ញុំ ក៏ បាន អង្គុយ ស្មឹងស្មាធ មួយ សំទុះ ដើម្បី គោរព និង រំឭក ដល់ ព្រះវិញ្ញាណក្ខន្ធ របស់ ព្រះអង្គ ។
ផ្ទះ គ្មាន មនុស្ស នៅ ខ្មោច លង អ្នកភូមិ ទាំង យប់ ទាំង ថ្ងៃ
ហេតុ នេះ ហើយ ទើប ពួកគេ គិត ថា ក្រុម ពួកគេ មិន ចាំបាច់ មាន អ្នកណា ម្នាក់ ធ្វើជា មេ ក្រុម គឺជា រឿង ល្អ មួយ ៕
ខាង វៀតណាម យក ទៅ ចិញ្ចឹម ។
ការងារ រីកចម្រើន ល្អ ធ្វើ ការ អ្វី ក៏ ងាយស្រួល ។
ឥឡូវ ធ្វើ យ៉ាងម៉េច ឆាប់ បាន ការងារ ធ្វើ វិញ ហ្ន៎ ?
លោក បាន ភ្ជាប់ ករណី នេះ ថា នៅ កម្ពុជា ក៏ មាន ការបង្រៀន ការធ្វើ បាតុកម្ម ផងដែរ ។
ក្រៅពី ប្រាក់ ខែ ខ្ពស់ បុគ្គលិក ទាំងអស់ នឹង ទទួលបាន អត្ថប្រយោជន៍ ដូចជា …
រហូតដល់ ពាក់កណ្តាល យប់ មន្ត្រី បាន និយាយ ថា ភ្លើង ភាគ ច្រើន ត្រូវបាន រលត់ ។
ទោះជា បណ្តាល មកពី មូលហេតុ អ្វី ក៏ដោយ យើង អាច ធ្វើ ការងារ ពីរ យ៉ាង ៖
ទៅ មុខ បន្ទាប់ កំហុស ផ្នែក ទីផ្សារ ធំ ៗ
ឃើញ បង អែន ឌីគាត់ និយាយ សរសើរ ល្អ ៗ
ពេល គាត់ នៅ ភូមិ អ្នកភូមិ គោរព រាប់អាន គាត់ ណាស់ ។
មិន មែន ជា វិធី នៃ ជន ដែល ជោគជ័យ ព្រោះថា សូម្បីតែ សច៌្ចធម ប្រវត្តិសាស្ត្រ ក៏ មិន ទទួលស្គាល់ ផង នោះ ។
ដូច មិន ទំនង សោះ
យ៉ាង រដូករណែល … ខ្លះ ស្លាប់ ភ្លាម ៗ
ឧទាហរណ៍ និង លំហាត់ ថែម ទៀត
វ៉ុល លទ្ធផល របស់ យូអេសប៊ី 5វ៉
ប្រធាន សហគមន៍ ព្រៃឈើ លោក ពៅ កុសល យល់ស្រប នឹង គំនិត នេះ ។
ពួកគេ ចង់ ដឹង ថា តើ រឿង ខ្លោចផ្សា បែប នេះ កើតឡើង ដល់ ពួកគេ ដោយសារ មូលហេតុ អ្វី ?
ខ្ញុំ នឹង ផ្សាយ អត្ថបទ ប្រភេទ នេះ បន្ថែម ទៀត ព្រោះ រៀបចំ រួចហើយ នៅសល់ ច្រើន ទៀត ។
ខេត្ត បាត់ដំបង ស្ត្រី ម្នាក់ មាន ផ្ទៃពោះ ៨ខែ បាន ស្លាប់ ភ្លាម ៗ
ខ្ញុំ និង ប៉ូលែន កំពង់ញ៉ាំ លតលត មាន ៖
វិប្បដិសារី ចំពោះ មិត្ត សម្លាញ់ របស់ ខ្ញុំ ម្នាក់ កាលពី រៀន ថ្នាក់ ទី៧ ។
និង សេចក្តីស្រឡាញ់ ដែល ទ្រង់ ចាក់ បង្ហូរ មក លើ យើង ។
ជា បុគ្គលិក ឆ្នើម ម្នាក់ ត្រូវ មាន លក្ខណៈ សម្បត្តិ ជាច្រើន ដូចជា ៖
យើង នឹង មាន អ្វី បន្ថែម ទៀត ដែល ត្រូវ ចែករំលែក ។
១ផ្កា រីក តាម រដូវ ៖
កិច្ច ប្រតិបត្តិការ ត្រូវបាន បញ្ចប់ នៅ វេលា ម៉ោង ១៤ និង ០០នាទី ៕
បច្ចុប្បន្ន នេះ គ្មាន សេចក្តីរាយការណ៍ ពី អ្នកស្លាប់ និង របួស ទេ ។
អ្នកធ្វើដំណើរ ដែល មិន បាន ដឹង រឿង កូដកម្ម របស់ កម្មករ ក្រុម …
ក្រុមហ៊ុន នេះ បាន ប្រកាស កាលពី ពេល ថ្មី ៗ
ហើយ ខាងមុខ នេះ យើងខ្ញុំ នៅ ធ្វើជាង នេះ ទៅ ទៀត ។
ឆ្នាំ ២០២០ នេះ ថវិកា ជាតិ សម្រាប់ រដ្ឋបាល ឃុំ - សង្កាត់ កើនឡើង ដល់ ទៅ ជាង ១២ម៉ឺន ដុល្លារ
យើង ទាំងអស់ គ្នា ប្រាកដជា បាន ដឹង ច្បាស់ ហើយ ថា ទំនុកចិត្ត លើ ខ្លួន ឯង ជា អារម្មណ៍ របស់ ខ្លួន ឯង ។
ដូច្នេះ នៅពេល មាន សេចក្តីលំអិត បន្ថែម យើង នឹង ជម្រាប ប្រាប់ លោក អ្នក បន្ត ទៀត ៕
ឯកឧត្តម សម រង្ស៊ី នៅតែ អះអាង ថា ប្រជាពលរដ្ឋ ទាមទារ ឱ្យ មាន ការផ្លាស់ប្តូរ
អ្នក បាន ចូលរួម បោកប្រាស់ អ្នកដទៃ ជាមួយនឹង ឈ្មួញ ទុច្ចរិត ។
សិទ្ធិ និង សេរីភាព ។
ថា ក្នុង ពេល លោក នៅ មាន វត្តមាន នៅឡើយ គ្មាន អ្នកណា អាច បង្ក្រាប លោក បាន ទេ ។
កុំ ថា ទ្រព្យធន នោះ ទោះ ទ្រព្យ ខ្ពស់ ប៉ុន្មាន ក្តី
មនោសញ្ចេតនា មិន ត្រូវ ទាមទារ ខ្ពស់ ពេក ក្នុង រឿង មនោសញ្ចេតនា ។
សម្តេច សូម កែប្រសាសន៍ ចេះ វិញ ថា បែប នេះ មិន អាច ហៅ ថា ឯកឧត្តម ភ្លើ លោកជំទាវ ភ្លើ ឬ
ឱ ព្រះយេហូវ៉ា អើយ សូម កុំ ឱ្យ ទូលបង្គំ ត្រូវ ខ្មាស ឡើយ
ទោះជា យ៉ាងណា នៅ មាន ចន្លោះប្រហោង ជាច្រើន ទៀត ដែល ខ្ញុំ ត្រូវ កែលំអ ។
ពិភព កំណាព្យ ខ្មែរ ក វី ខេត្ត ស្ទឹងត្រែង សំណាង ខ្ញុំ មែន
បើ ខ្ញុំ វិញ ខ្ញុំ ចូលចិត្ត លេង អាកូស្តីក និង ក្លាស៊ីក ។
ចូរ នឹក ដល់ ឫទ្ធិ បាដិ ហារិយ៍ និង
ជាមួយ អ្នកស្នេហា ខ្មែរ អាច ជួយ អ្នក បាន ។
ផ្កា ឈូក ក៏ ជា និមិត្តរូប ដ៏ ខ្ពង់ខ្ពស់ ក្នុង វប៌្បធម ឥណ្ឌា តាំងពី បុរាណកាល មក ។
អ្នកកាន់តែ ឆាប់ សន្សំ ប្រាក់ វា កាន់តែ ល្អ បំផុត សម្រាប់ អ្នក ។
លោក អប្រាហាំ ជា បុព្វបុរស របស់ យើង ថា
ដើម្បី គ្រួសារ សាលារៀន និង សង្គម ទាំងមូល បន្ត មាន សកម្មភាព ជាក់ស្តែង ថែទាំ
ដោយ អះអាង ថា ភ្លើង បាន ឆេះ ទ្រព្យសម្បត្តិ អស់ ទាំងស្រុង តែម្តង ។
៣នាក់ ទៀត ដែល ត្រូវបាន លើកលែង ទោស ដែរ មាន ៖
ដោយសារតែ មាន សម្រស់ ស្រស់ស្អាត ជារឿយ ៗ
ក្រោយពេល កើត ហេតុ ជនរងគ្រោះ ត្រូវបាន បញ្ជូន ទៅ មន្ទីរពេទ្យ ផងដែរ ៕
ថា ថ្ងៃ ណាមួយ ព្រះនាង ត្រឡប់ មកវិញ ស្រុក នេះ នឹង រុងរឿង ដូច ដើម វិញ ។
ដោយឡែ អ្នក ដែល មិន ធ្វើ អត្តសញ្ញាណប័ណ្ណ វិញ លោក អាត់ ខែម បាន អំពាវនាវ ឱ្យ ទៅ ធ្វើ គ្រប់ ៗ
ខ្ញុំ សុខចិត្ត ផ្ញើ នៅ សាលារៀន ឱ្យ ក្មួយ ៗ
បណ្តា អគារ បុរាណ នៅ ទីនោះ ជាប់ ៗ
ហេតុ នោះ ទ្រង់ ត្រាស់ ថា ជន មាន ចិត្ត ស្លុង ទៅកាន់ ព្រះនិព្វាន ។
ឡើង ម៉ាក់ ខ្ញុំ ឈឺ នៅ មន្ទីរពេទ្យ ។
ភ្នែក របស់ យើង ព្រិច បេះដូង កំពុង ច្របាច់ ឈាម ខួរក្បាល របស់ យើង កំពុង …
សារ អំពី ការលាង ដៃ នេះ ត្រូវបាន ផ្សព្វផ្សាយ ដោយ មេដឹកនាំ និង អ្នកជំនាញ វេជ្ជសាស្ត្រ នៅ ទូទាំង ពិភពលោក ។
ខ្ញុំ ហ៊ាន និយាយ ទស្សនាវដ្តី នេះ នឹង មិន ឈឺចាប់ ចំពោះ ការបក អាក្រាត ជាក់ស្តែង នេះ ទេ
ទាក់ទង នឹង ទំនាក់ទំនង អំពើ បាប ខាងឯ ផ្លូវភេទ បាន រុះរើ បំផ្លាញ ចោល នោះ ផល ផ្លែ នៃ ការកែប្រែ ចិត្ត នឹង ចាប់ផ្តើម ស្តារ ឡើងវិញ នូវ ទំនាក់ទំនង នោះ ជាសារជាថ្មី ម្តង ទៀត ខណៈពេល រាល់ បុគ្គល នីមួយ ៗ
នៅលើ ពិភពលោក ការគ្រប់គ្រង រដ្ឋ មាន ពីរ ប្រព័ន្ធ ផ្សេង គ្នា គឺ ៖
គ្រា នោះ លោក ក៏ បាន ចាប់ យក ជំនាញ ច្នៃ គ្រឿងអលង្ការ ដោយសារតែ ក្តីស្រឡាញ់ ។
គួរតែ មាន ធុង សម្រាម ដើម្បី ទុកដាក់ សម្រាម ឬ ក៏ គួរ ដាក់ វា នៅក្នុង ថង់ បិទ ជិត ។
ក្នុង នោះ ដកហូត វត្ថុតាង រួម មាន ៖
អ៊ីមែល ច្រើន អាច ផ្តាច់ គ្នា ដោយ ប្រើ
អ្វី ដែល បាន កើតឡើង នៅក្នុង ទ្វីប អាព្រិក គឺ ជនជាតិ ឯង សំលាប់ គ្នា ឯង !
១៨ នៅ ថ្ងៃ បន្ទាប់ លោក ប៉ូល បាន ទៅ ផ្ទះ លោក យ៉ាកុប ជាមួយ យើង រីឯ ពួក ព្រឹទ្ធាចារ្យ ទាំងអស់ ក៏ ជួបជុំគ្នា នៅ ទីនោះ ដែរ ។
១០ឥឡូវនេះ តើ ខ្ញុំ ចង់ ផ្គាប់ ចិត្ត មនុស្ស ឬ ធ្វើអោយ គាប់ ព្រះហឫទ័យ ព្រះជាម្ចាស់ ?
អ្នក ដែល ត្រូវ ទទួលខុសត្រូវ មុន គេ លើ ករណី នេះ គឺ លោក ជួន ណារិន ពីព្រោះ សមត្ថកិច្ច ទាំងអស់ ធ្វើ តាម តែ បញ្ជា ។
អញ មិន ចាំបាច់ ធ្វើជា ទន់ខ្សោយ តទៅទៀត ទេ ទោះបីជា ឯង មាន ហេតុផល ត្រឹមត្រូវ ប៉ុណ្ណា ក៏ដោយ !
ដែរ ប៉ុន្តែ គ្មាន ស្រី ណា ម្នាក់ ដែល សក្តិសម ធ្វើជា អនាគត ភរិយា របស់ លោក ទេ ។
ឌុច និង មេធាវី ទាំង ពីរ នាក់ នៅក្នុង អង្គ សវនាការ
ប្រវត្តិសាស្ត្រ ប្រាសាទ អង្គរវត្ត ការដាក់បញ្ចូល តំណ ភ្ជាប់ កែប្រែ
ជា ឧទាហរណ៍ ប្រសិនបើ លោកអ្នកធ្វើ វិភាគទាន ទៅ ស្ថាប័ន ស្រប ច្បាប់ ណាមួយ ក្នុង ប្រទេស របស់ លោក អ្នក នោះ ឈ្មោះ និង ព័ត៌មាន ទំនាក់ទំនង របស់ លោក អ្នក នឹង ត្រូវ ផ្តល់ឱ្យ ទៅ ស្ថាប័ន ស្រប ច្បាប់ នោះ ដូច ដែល បាន បញ្ជាក់ ប្រាប់ លោក អ្នក នៅពេល ដំណើរការ ក្នុង ការធ្វើ វិភាគទាន ។
អា ហ្នឹង គ្រាន់តែ បញ្ជាក់ ទុក ជាមុន ។
លោក និយាយ ទៀត ថា ពេលវេលា ជា ការសំខាន់ ហើយ ការចាត់ វិធានការណ៍ មិន អាច ពន្យា ពេល បាន ទេ ។
ដោយសារតែ មាន ចំណាប់អារម្មណ៍ អាន ស្នាដៃ មួយ នេះ របស់ បង ស្រី ។
ខ្ញុំ នឹង ស្មូត្រ ទំនុកតម្កើង ថ្វាយ ព្រះរបស់ ខ្ញុំ
តើ អ្នក ធ្លាប់ ប្រើប្រាស់ បង្គន់ សាធាណៈ ដែរ ឬ ទេ មិន ថា បង្គន់ នៅក្នុង សាលា ឬ កន្លែង ធ្វើការ នោះ ទេ ?
ទ្រង់ ត្រាស់ ថា ម្នាល ភិក្ខុ ទាំងឡាយ អ្នក ទាំងឡាយ ចំរើន អានា បាន ស្សតិ ឬ ទេ ។
ប្រព័ន្ធ អ៊ិនធើណែត គឺជា ឧបករណ៍ មួយ ដែល ត្រូវបាន ប្រើប្រាស់ កាន់តែ ច្រើន ឡើង ៗ
តែ ការពិត ទៅ អ្នក ដឹង ច្បាស់ ហើយ ថា អ្នក គ្មាន សមត្ថភាពយកចិត្ត គេ ម្នាក់ នោះ បាន ឬ ក៏ មកពី គ្មាន និស្ស័យ ក៏ ថា បាន ។
ព្រះទ្រង់ ឆ្លើយតប សេចក្តី អធិស្ឋាន នៅក្នុង ជ្រលង ភ្នំ ។
ពួកគេ ត្រូវបាន សង្ស័យ …
ជាក់ស្តែង ការអធិដ្ឋាន នេះ បាន ផ្តល់ នូវ ផល ផ្លែ ដោយ មាន យុវជន ម្នាក់ ថ្មី និង និស្សិត ចាស់ ៨នាក់ ទៀត បាន ស្ម័គ ចិត្ត ចូល ទេវ វិទ្យាល័យ ដើម្បី រិះគិត អំពី ដំណើរ ជីវិត ជា បូជាចារ្យ ក្នុង ឆឆ្នាំ ២០១៧ នេះ ។
តន្ត្រី គឺជា បទភ្លេង ជីវិត របស់ ខ្ញុំ វា នៅក្នុង សុបិន របស់ ខ្ញុំ ។
តែ សម្រាប់ ២៥ ភាគរយ ទៀត គឺ អាច មាន អាការៈ ដូច ខាងក្រោម នេះ ៖
សាកសម្យ សម្រាប់ ដប និង ដប់ ទឹក ទាំងអស់ មាន ចំណុះ រហូតដល់ ១លីត្រ ។
ស្ត្រី ជាច្រើន ចាប់ផ្តើម ផ្លាស់ប្តូរ របប អាហារ របស់ ខ្លួន ភ្លាម ៗ
ស្ត្រី ទាំង២រូប នេះ ធ្លាប់ បាន រិះគន់ ខ្លាំង ៗ
លើស ពី ការជួយ ទ្រទ្រង់ ពួកគេ តាម អាកាស យើង នៅ បាន ជួយ ផ្តល់ អាវុធ គ្រាប់ រំសេវ ដល់ ពួកគេ ពោល យើង ជួយ ទ្រទ្រង់ ខាង សម្ភារ ។
ជា រុក្ខជាតិ រស់ បាន យូរ ឆ្នាំ ។
គ្រប់ ទីកន្លែង ដែល យើង ទៅ យើង នឹង ទទួលរង ការទម្លាក់ គ្រាប់បែក ជានិច្ច ។
ប្រសិនបើ អ្នក មានអារម្មណ៍ ដូចជា មាន ភាពអន់ចិត្ត តិចតួច អំពី រឿងរ៉ាវ ទាំងអស់ មិន ថា ផ្តល់ឱ្យ គេ ឬ ទទួលយក នោះ ទេ ចូរ កុំ ព្យាយាម យល់ឃើញ ដូច្នេះ ទៀត អី ។
ក - នៅតែ ផ្ញើ មកដដែល ប៉ុន្តែ គ្រាន់តែ មិន ច្រើន ដូច ពេល មុន ប៉ុណ្ណោះ ។
និង ក្លាយទៅជា ស្ត្រី មេម៉ាយ
ខ្ញុំ ចង់ ទិញ ផ្ទះ ។
យើង ទាំងអស់ គ្នា បាន ដឹង ហើយ ថា ការសំរក ទំងន់ មិន មែន ជា ការងាយស្រួល នោះ ទេ
គឺ ត្រូវ មាន ទាំង ក្រុមគ្រួសារ ភរិយា ឬ ក៏ ស្វាមី ឬ ក៏ កូន ចៅ គាត់ នៅក្នុង ក្រុមគ្រួសារ ហ្នឹង ឱ្យ បាន ដឹង ។
លុះ ចាប់ពី ឆ្នាំ ១៩៩០មក លោក ក៏ មាន ភារកិច្ចការពារ ផ្ទាល់ ទាំង នៅក្នុង និង ក្រៅ ប្រទេស តែម្តង ។
នេះ គឺ មាន នៅតែ សហរដ្ឋ អាមេរិក តែ ប៉ុណ្ណោះ ។
សាក្សី ម្នាក់ ក្នុង ហេតុការណ៍ នេះ និយាយ ថា ៖
លោក គឺជា គ្រោះថ្នាក់ យ៉ាង ច្បាស់ និង ជា គ្រោះថ្នាក់ នា ពេល បច្ចុប្បន្ន នេះ ដល់ ប្រទេសជាតិ ដែល យើង ទាំងអស់ គ្នា ស្រឡាញ់ ។
អញ្ចឹង ទេ បាន អោយ មាន ផេក ជំនួយការ ខ្ញុំ ម្នាក់ សម្រាប់ ផុស តែ រូបថត ហ្នឹង តែម្តង ។
សេតវិមាន បាន និយាយ ថា ខ្លួន មិន អាច បញ្ជាក់ ថា ការអះអាង នេះ ជា ការពិត នៅ ទ្បើយ ទេ ។
រហូត ផ្តាច់ ចោល ទាំងស្រុង និង មាន រយៈពេល ២៨ ឆ្នាំ មកហើយ ។
នៅពេល ត្រូវបាន គេ សួរ អំពី ជំនួប នៅពេល ខាងមុខ នោះ លោក ត្រាំ បាន និយាយ ថា ៖
ថ្ងៃទី ២២មីនា នឹង មិន អាច ជា ថ្ងៃ ធម្មតា ដូច ថ្ងៃ ផ្សេង ទេ ។
ទាំងអស់ គ្នា ឃើញ ហើយ សូម្បី លោក ថោង ចំរើន អង្គុយ ក៏ មិន នឹង ដែរ ។
ជាង ១០ភាគរយ នៃ ផ្ទៃដី សរុប នៅ សហរដ្ឋ អាមេរិក ត្រូវបាន គេ ចាត់ទុក ជា តំបន់ ការពារ អភិរក្ស ។
ស្លាក នៅក្នុង ហាង
ដោយសារតែ យើង មិន ដឹង ថា ទីណា ឬ ពេលណា ដែល ផល ប៉ះពាល់ ធំ បន្ទាប់ របស់ អាចម៍ផ្កាយ នឹង កើតឡើង នោះ រឿង តែ មួយ គត់ ដែល អាច ទប់ស្កាត់ មហន្តរាយ ពី អាចម៍ផ្កាយ ដែល មាន ទំហំ ប៉ុន អ្នក ពិឃាត ទីក្រុង បាន គឺ មាន តែ ពឹង លើ សំណាង ទាំងស្រុង តែ ប៉ុណ្ណោះ ៕
សូម អាន អត្ថបទ នេះ ហើយ បន្ទាប់មក មាន ការសាកល្បង ។
គ្រប់ បែបយ៉ាង ដើម្បី គាត់ ឬ នាង
មិត្ត ខ្ញុំ កំពុង កុម្ម៉ង់ ម្ហូប … ឆ្ងាញ់ មាត់ ហើយ ខ្ញុំ
មធ្យោបាយ ទាំង ៧ចំណុច នេះ ជា គន្លឹះ យ៉ាង សំខាន់ ជួយ រំលត់ ភ្លើង ទោសៈ ចេញពី ចិត្ត និង នាំឱ្យ ចិត្ត ស្ងប់ ត្រជាក់ សុខ ស្រួល ជា ប្រក្រតី ។
ជា សិទ្ធិ របស់ ប្រជាពលរដ្ឋ កុំ ឱ្យ តែ ប៉ះពាល់ សិទ្ធិ ឬ ប៉ះពាល់ សុខភាព របស់ អ្នកដទៃ ។
ទៀត នៅក្នុង វិស័យ ខ្សែភាពយន្ត ។
ដូចនេះ សូម ឈប់ ប្រើ ពាក្យ និង ឥរិយាបទ អាក្រក់ ៗ
បើ ពិតជា អ៊ីចឹង មែន អ្វី ៗ
ដូចនេះ ជនជាតិ ថៃ ពុំ បាន ទទួល ព្រះពុទ្ធ សាសនា ដោយ ផ្ទាល់ ពី ជនជាតិ ឥណ្ឌា ដូចជា ជនជាតិ ខ្មែរ យើង ទេ ។
អាត្មាភាព សូមអធិប្បាយ តាម ន័យ ព្រះពុទ្ធ ដីកា ខាងលើ ដូច សេចក្តីតទៅ នេះ
១២ ចំពោះ យើង យើង ពុំ បាន ទទួល វិញ្ញាណ លោកីយ៍ ទេ គឺ យើង បាន ទទួល ព្រះវិញ្ញាណ ដែល មកពី ព្រះជាម្ចាស់ ដើម្បី អោយ ស្គាល់ អ្វី ៗ
រដ្ឋាភិបាល នៅ ប្រទេស អាស៊ី ទាំងអស់ ត្រូវតែ ដើរ តាម ឧទាហរណ៍ នេះ ដើម្បី ជា ប្រយោជន៍ ដល់ សុខភាព មនុស្ស ក៏ ដូចជា ដើម្បី ការអភិរក្ស សត្វ ព្រៃ ផងដែរ ៕
ខ្ញុំ ចេះតែ គិត ថា ឧបករណ៍ ទាំងនេះ មាន ប្រសិទ្ធភាព តែ មួយ រយៈពេល ប៉ុណ្ណោះ ។
បំភាន់ ភ្នែក - ប៉ារ៉ាឡែល ឬ មិន
ពេញចិត្ត ឬ ពេញចិត្ត
លោក បាន បន្ថែម ថា អ្នក មិន អាច លុបបំបាត់ នូវ ពួក ទុច្ចរិត នេះ បាន ទេ ដូច្នេះ ការប្រុងប្រយ័ត្ន ជាប់ ជានិច្ច គឺជា ការងារ ចាំបាច់ ។
តើ មាន ទំរង់ ការអ្វី ដែល ពួកគេ ត្រូវ ហាត់ ធ្វើ មុននឹង ត្រូវបាន ធ្វើដំណើរ មកដល់ ?
១ចូរ ប្រាប់ ដល់ ពួក បងប្អូន ប្រុស របស់ ឯង ថា អាំមី ហើយ ដល់ បងប្អូន ស្រី ថា រូហា ម៉ាចុះ ។
ឧទាហរណ៍ វា អាច ជា ការផ្លាស់ប្តូរ ការមើល អេក្រង់ ព្រឹត្តិការណ៍ ឬ ការមើល រូប ព្រះ។
បទបញ្ជា ផ្ទៃក្នុង នេះ នឹង កំណត់ សិទ្ធិ ករណី យកិច្ច និង ទំនួល ខុសត្រូវ របស់ ម្ចាស់ កម្មសិទ្ធិ ជា ជន បរទេស ។
តម្លៃ វ៉ុល ផ្សេង ទៀត
គ្នា ខណៈ ក្រុម នៅ តាម ខេត្ត ឆ្ងាយ ៗ
ម្ចាស់ មេដាយ មាស កែ ឡេង ប្រាប់ ពី មូលហេតុការ មិន បាន ចេញ ទៅ ប្រកួត ជើងឯក ពិភពលោក
ហើយ ប្រតិបត្តិ តាម ក្រឹត្យ វិន័យ របស់ ព្រះអម្ចាស់
ដើម្បី សុខភាព ទាំងអស់ គ្នា មុន ប្រើប្រាស់ …
មិន អាច ជំនុំជម្រះ សេចក្តី នោះ បាន ក៏ បណ្តេញ ចៅ ទាំង ២នាក់ ថា ឯង ជា ម្ចាស់ ខ្ញុំ រត់ ត្រូវ ទៅ តាម ខ្ញុំ ទៅ ឯ ម្ចាស់ គោរត់ ត្រូវ ទៅ តាម គោ ទៅ ចៅ ទាំង ២នាក់ ពុំ សុខចិត្ត ឡើយ ទើប ចៅក្រម នាំ ឡើង ទៅ ក្រាបបង្គំ ទូល ព្រះមហាក្សត្រ ដោយ នូវ ដំណើរ នោះ ។
ក្តី ស្រលាញ់ កើន ទ្វេ រង់ចាំ ថ្ងៃ ថ្មី មកដល់ ។
