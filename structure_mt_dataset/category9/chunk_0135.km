ប៉ុន្តែ សព្វ ថ្ងៃ នេះ ពិធី បុណ្យ នេះ ប្រព្រឹត្តទៅ នៅ
ចំណែក បងប្អូន ខាង ប្រុស ក៏ រវល់ ធ្វើ ការងារ រៀង ៗ
ហើយ មូលហេតុ នោះ ប្រហែល បណ្តាល មកពី ៖
អ្នក អាច អនុវត្ត បិត ម៉ាស នេះ រៀងរាល់ យប់ មុនពេល ចូល គេង ។
តែ យ៉ាងណា រូបភាព នេះ ទំនងជា បាន កើតឡើង នៅក្នុង ប្រទេស វៀតណាម ៕
ពួក្រពាហមបាប ឱ្យ ត្ផិត្រ ពាហម ជារោីងបាបរ ហើយ
សូម្បីតែ អ្នក ការពារ សិទ្ធិ មនុស្ស ក៏ បាន រង ការគំរាមកំហែង ។
ខ្ញុំ សង្ឃឹម ថា នេះ គ្រាន់តែ ទង្វើ របស់ បុគ្គល ម្នាក់ ប៉ុណ្ណោះ ដែល មិន ឆ្លុះបញ្ចាំង ពី ទង្វើ របស់ ក្រុមហ៊ុន ឬ ក៏ ប្រជាពលរដ្ឋ ទូទៅ ឡើយ ៕
នេះ ជា អត្តសញ្ញាណ របស់ នាង ។
នេះ គឺ ដោយសារតែ សម្ពាធ អន្តរជាតិ ។
ក្រោយ រញ្ជួយ ដី កម្រិត ធ្ងន់ វាយប្រហារ ហ្វីលីពីន - ជីវិត និង សង្គម
មិន ត្រឹមតែ រំលាយ យើង ចោល ទេ ហាមឃាត់ មិន ឱ្យ យើង ធ្វើ នយោបាយ ទៀត ។
ជា ការពិត ណាស់ តម្លៃ នៃ ការសិក្សា មាន ភាពខុសប្លែក ពី គ្នា ទៅតាម សកលវិទ្យាល័យ នៅក្នុង ប្រទេស នីមួយ ៗ
បន្ទប់ គេង 2ភ្លោះ បន្ទប់ ទិក២
មុនពេល ដោយ ប្រើ ថាំពទ្យ នេះ អ្នក ត្រូវតែ ជៀសវាង ការតែ ឬ កាហ្វេ ។
ក្រុមហ៊ុន យ៉ាន់ ចាវ
ស្ថានភាព នោះ ហើយ ដែល ធ្វើឱ្យ គ្រួសារ នេះ ធ្លាក់ខ្លួន ក្រ ។
សូម កុំ បន្ទោស គេ ខ្លាំង បើសិនជា មាន កំហុសឆ្គង កើតឡើង ។
នៅ សហរដ្ឋ អាមេរិក ប្រទេស ដែល អស្ចារ្យ ជាង គេ បំផុត ក្នុង ពិភពលោក យើង ជឿ ថា អ្នកគ្រប់ គ្នា ត្រូវបាន បង្កើតឡើង ដោយ ស្មើភាព !
ប៉ុន្តែ លោកស្រី ចេះតែ អូសបន្លាយ រហូតមកដល់ ពេលនេះ ដោយ មិន ដឹង មកពី មូលហេតុ អ្វី ឡើយ ?
ខាងក្រោម នេះ ខ្ញុំ នឹង បង្ហាញ អំពី អាហារ ខ្លះ ៗ
ដំបូន្មាន សម្រាប់ អ្នកជិត ដល់ វ័យ ៣០ ៖
នៅពេល អ្នក ក្រោក ពី គេង ។
ដល់ តែ យូរ ហើយ វែង ទៀត បើ មិន ចូល ប្រយ័ត្ន ស្តាយក្រោយ ។
គ្មាន ប្រទេស ណា មួយ មាន សិទ្ធិ គំរាមកំហែង យើង ទេ ។
គេ បាន ឆ្លើយ ថាៈ ប្រាកដជា មាន . ហើយ ពិតប្រាកដ ណាស់ ពេល នោះ ពួក អ្នក នឹង ស្ថិត ក្នុង ចំណោម អ្នកជំនិត របស់ យើង ។
ឃុំ ស្វាយ ភ្លើង
ហើយ ស្តេច តែង ទៅ បង្គំ គាល់ ហ្វៅ ព្រះវរ បិតា
ស្រី អ៊ីត បើក កកាយ រឿង ទ្រព្យសម្បត្តិ បន្ទាប់ពី អតីត ស្វាមី រៀបការ ប្រពន្ធ ថ្មី
ទី ណា មាន ទឹក ទីនោះ មាន ត្រី ទស្សនវិជ្ជា
ជា រួម គ្រោះថ្នាក់ ចរាចរណ៍ នេះ អ្នក ទាំង៣ បាន ត្រឹមតែ របួស បន្តិចបន្តួច ប៉ុណ្ណោះ ។
បច្ចុប្បន្ន ភរិយា របស់ លោក កំពុង មាន ផ្ទៃពោះ ៦ខែ ។
ទូលបង្គំ បាន យក ច្បាប់ របស់ ព្រះអង្គ
ក៏ប៉ុន្តែ គុក ទួល ស្លែង ដែល ស្ថិត ក្រោម ការគ្រប់គ្រង របស់ ឌុច គឺជា ទីតាំង ធ្វើ ទារុណកម្ម ដែល មាន ឈ្មោះ អសោច ជាង គេ ។
មាន ទាំង បាល់ ខោអាវ ស្បែកជើង !
តែ នៅក្នុង ការចាប់ផ្តើម រកស៊ី មិន អាច ដើរ ផ្លូវ នេះ បាន ទេ អ្នក ត្រូវ មាន ភាពអត់ធ្មត់ នឹង ការងារ ក្នុង រយៈពេល យូរ ណាស់ ។
យើង ត្រូវ មើល គេ ឱ្យ បាន ច្រើន ជាពិសេស ប្រទេស ដែល មាន សិល្បៈ រីកចម្រើន ។
កូនក្មេង កំពុង អត់ បាយ ដាច់ ពោះ ស្លាប់ ។
រ៉ូប វែង តែ ប្រវែង
ប្រជាជន អាមេរិក ទាំងអស់ …
ទូលបង្គំ នៅ មាន ដង្ហើម ចេញ ចូល
ពលរដ្ឋ រូប នេះ បន្ត ថា ពេលនេះ អ្នកភូមិ ម្នាក់ ៗ
បន្ថែម ប្រេង ឆា និង ខ្ទឹម បារាំង ចូលក្នុង ខ្ទះ ចៀន និង ចៀន អោយ ឡើង ក្រហម ល្អ ប្រមាណ ៣នាទី ។
ខ្ញុំ ធ្វើ ដើម្បី ស្នេហា ភ្លេច ឈ្មោះ អ្នក ចំរៀង ប្រុស បាត់ ទៅ ហើយ
ដឹងខ្លួន ថា ល្ងង់ គង់ បាន ចេះ ។
ម៉ោង ៥ល្ងាច ខ្ញុំ ត្រូវ ចេញ ពី ការិយាល័យ
ហើយ ដើម្បី ដឹង បាន អ្នក ត្រូវ នៅ ជុំវិញ មនុស្ស ដែល ចំណុច ខ្លាំង របស់ ពួកគេ ជា ចំណុច ខ្សោយ របស់ អ្នក ៕
ឥឡូវ ដល់ ពេល កូន ត្រូវ ឱ្យ ម៉ាក់ សម្រាក ម្តង ហើយ ទុក ភារកិច្ច ដល់ កូន ។
កូន ជាង ភ្លើង និង ទឹក
បើសិនជា អញ្ចឹង មែន អ្នក ពិតជា រក អូស ប្រទះច ង្គ្រាន ហ្គាស ហើយ ។
ការអនុវត្ត ទៅ តាម ទណ្ឌកម្ម អន្តរជាតិ ទាំងនេះ របស់ រដ្ឋាភិបាល ក្រុង ប៉េកាំង ត្រូវបាន គេ ចាត់ទុក ថា មាន សារៈសំខាន់ ដោយសារ ៩០ ភាគរយ នៃ ទំនិញ របស់ កូរ៉េ ខាងជើង ចូល ទៅក្នុង ប្រទេស ចិន ឬ ត្រូវ ឆ្លងកាត់ ប្រទេស ចិន ។
ព្រះអម្ចាស់ មាន បារមី ទន់ខ្សោយ
នេះ ជា វិធី ដ៏ ប៉ិនប្រសប់ ដើម្បី ធានា ថា អ្នក នឹង ញ៉ាំ បន្លែ ជារៀងរាល់ ថ្ងៃ ។
តើ បរិភោគ អ្វី ដើម្បី មិន ឱ្យ មាន ក្លិន ខ្លួន
ចំពោះ ការខូចខាត ផ្ទះសម្បែង នេះ គាត់ មិន
យើង តែងតែ គិត ថា យើង មិន អាច មាន លក្ខណៈ ពេញលេញ បាន ទេ ប្រសិនបើ យើង គ្មាន បុគ្គល ណា ម្នាក់ នៅក្នុង ជីវិត របស់ យើង ។
លោក អ៊ូវីរៈ ប្រធាន មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា បាន មានប្រសាសន៍ ថា ព្រឹត្តិការណ៍ កាលពី ប៉ុន្មាន ថ្ងៃ មុន គឺ គួរឱ្យ ព្រួយបារម្ភ ជាខ្លាំង ។
សូម មើល ពី សកម្មភាព របស់ យើង ក្នុង រូបភាព ខាងក្រោម នេះ ។
ដល់ អ៊ីចឹង ប្រជាពលរដ្ឋ ភ័យខ្លាច មិន ចូលរួម ធ្វើ ការវាស់វែង ដី នេះ បាន ទេ !
ខ្លួន តាម ព្រំដែន រួមគ្នា ។
ហេតុ នេះ ហើយ ខ្ញុំ សម្រេចចិត្ត ចូលរៀន មហាវិទ្យាល័យ ផ្នែក គណិតវិទ្យា ឱ្យ បាន ។
គាត់ ផ្តល់ គ្រប់ យ៉ាង ដល់ ពួកយើង ។
សម តុល្យ សាច់ប្រាក់
អ្នកសង្កេតការណ៍ រកឃើញ ថា មាន ភាព មិន ប្រក្រតី ខ្លះ ពេល បោះឆ្នោត នៅ កំពង់ឆ្នាំង
សាងសង់ អគារ ព្រះវិហារ កម្ពស់ ២ជាន់ ទី២ នៅជិត ព្រះវិហារ នេះ ។
ទាំង ទាសី នៃ អ្នក អគ្គ នារី
ពួកគេ នឹង ប្រាប់ អ្នក ថា ត្រូវ វិនិច្ឆ័យ រឿង នេះ បែប ណា ។
ជំហាន ដំបូង គេ នៅ មិន ទាន់ ស្គាល់ អត្តសញ្ញាណ អ្នកស្លាប់ នៅឡើយ ទេ ។
ឬ ចង់ សន្សំ ប្រាក់ គេ នឹង ចាំបាច់ ត្រូវ ធ្វើ អ្វី ៗ
ខ្ញុំ ពិតជា សុំទោស !
