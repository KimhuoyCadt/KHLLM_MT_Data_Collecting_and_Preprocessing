( ភ្នំពេញ ) ៖ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ កង ការពារ ព្រំដែន គោក លេខ ៤០៣ កងទ័ព ជើងគោក នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
( ភ្នំពេញ ) ៖ យុវជន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ម្នាក់ ត្រូវបាន រថយន្ត កុងតឺន័រ សណ្តោង កន្ទុយ កិន ពីលើ ស្លាប់ យ៉ាង អណោច អធម នៅ វេលា ម៉ោង ០៨៖៣០ នាទី យប់ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២២ នៅ ចំណុច មុខ បុរី សន្តិភាព២ ផ្លូវ៣០ ម៉ែត្រ ភូមិ ស្រែ ជម្រៅ សង្កាត់ ចោម ចៅ២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
មន្ត្រី កងរាជអាវុធហត្ថ ជា មិត្ត រួម ការងារ បាន ឲ្យដឹង ថា ជនរងគ្រោះ មាន ឈ្មោះ ព្រិន្ទ បាល ឯក ឃួន វិសាល កាល នៅ មាន ជីវិត គឺជា មនុស្ស សុភាព រាបសារ ស្រឡាញ់ ការងារ គោរព វិន័យ គោរព ពេលវេលា មាន ការស្រឡាញ់ រាប់អាន ពី មិត្តភ័ក្តិ ជុំវិញ ខ្លួន និង បងប្អូន សាច់ញាតិ គ្រប់ ៗ គ្នា ។
ជិត ៣ឆ្នាំ ចុងក្រោយ នេះ លោក ព្រិន្ទ បាល ឯក ឃួន វិសាល បាន ទទួល បេសកកម្ម រួម ជាមួយ ក្រុមការងារ ចុះ ការពារ និង រៀបចំ សណ្តាប់ធ្នាប់ នៅ មន្ទីរពេទ្យ ហ្លួង ម៉ែ ដែល ត្រូវបាន ដាក់ ជា កន្លែង ព្យាបាល អ្នកជំងឺ កូវីដ១៩ រហូតដល់ ស្ថានភាព បាន ធូរស្រាល មណ្ឌល ព្យាបាល ត្រូវបាន បិទ តែ បេសកកម្ម របស់ លោក ព្រិន្ទ បាល ឯក ឃួន វិសាល នៅតែ បន្ត យាម ការពារ សម្ភារៈ បរិក្ខា ព្យាបាល ជំងឺ កូវីដ១៩ នៅ មន្ទីរពេទ្យ ហ្លួង ម៉ែ ដដែល ។
ដោយ ក្តីអាណិតអាសូរ នា ព្រឹក ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២២ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក និង ជា ប្រធាន អនុគណៈកម្មការគ្រប់គ្រង សន្តិសុខ និង សណ្តាប់ធ្នាប់ នៅ តាម គោលដៅ និង តំបន់ ចត្តាឡី ស័ក ព្រមទាំង លោកស្រី បាន ចាត់ ក្រុមការងារ នាំយក ថវិកា ចំនួន ៤លាន រៀល ទឹក សុទ្ធ ៣០ កេស ចូលរួម បុណ្យ សព លោក ព្រិន្ទ បាល ឯក ឃួន វិសាល និង បាន ផ្តាំផ្ញើ ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ដល់ គ្រួសារ សព ។
ជាមួយគ្នា នោះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ក៏ បាន ចាត់ ក្រុមការងារ នាំយក ថវិកា ២លាន រៀល ចូលរួម បុណ្យ សព និង បាន ផ្តាំផ្ញើរ ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ដល់ គ្រួសារ សព ដូចគ្នា ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ក៏ បាន នាំយក ថវិកា ២០ លាន រៀល ទឹក សុទ្ធ រួម និង ភេសជ្ជ៣០ កេស អង្ករ ៤ការ៉ុង ទៅ ប្រគល់ឲ្យ ក្រុមគ្រួសារ សព សម្រាប់ រៀបចំ ធ្វើ បុណ្យ ជាមុន និង ជា បន្ត មិត្ត រួម ការងារ ក្នុង អង្គភាព កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ចូល បុណ្យ បន្ថែម រួម ជាមួយ ថវិកា មហា គ្រួសារ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ដែល ផ្តួចផ្តើម ដោយ នាយ ឧត្តមសេនីយ៍ សៅ សុខា នឹង ប្រគល់ ជូន គ្រួសារ សព តាម ក្រោយ ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន សម្តែង នូវ ការសោកស្តាយ យ៉ាង អនេក ចូលរួម រំលែក មរណៈ ទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ និង សាច់ញាតិ នៃ សព ព្រោះ ការបាត់បង់ លោក ព្រិន្ទ បាល ឯក ឃួន វិសាល ដែល ជា យុវជន មាន ឆន្ទៈ ប្តូរផ្តាច់ ចំពោះ ជាតិ មាតុភូមិ ជា ធនធាន មនុស្ស ដ៏ កម្រ ក្នុង កងរាជអាវុធហត្ថ និយាយ ជា រួម ជា ធនធាន ដ៏ សំខាន់ សម្រាប់ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ និយាយ ដោយឡែក និង ជា កូន ល្អ ក្នុង គ្រួសារ ។
សូម បញ្ជាក់ ផងដែរ ថា អង្គភាព កីឡា នគរបាល ជាតិ កម្ពុជា ដែល មាន ការដឹកនាំ ពី លោក ឆេង សុភ័ក្រ អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា កីឡា ក្រសួង មហាផ្ទៃ បាន ដឹកនាំ កីឡាករ កីឡាការិនី ចេញ ទៅ ប្រកួតប្រជែង លើក នេះ មាន កីឡា ចំនួន ០៦ រួម មាន៖ តេក្វាន់ ដូ WT វាយ សី វាយ កូន ឃ្លី លើ តុ ចំបាប់ យូដូ និង ការ៉ាតេ ហើយ ព្រឹត្តិការណ៍ នេះ ធ្វើឡើង ចាប់ពី ថ្ងៃទី ២២ដល់ ៣១ ខែកក្កដា ឆ្នាំ ២០២២ ៕
ការិយាល័យ ទី៤ កងទ័ព ជើងគោក ចេញ ញត្តិ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ ការិយាល័យ ទី៤ កងទ័ព ជើងគោក នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
លោក ផែង វណ្ណៈ ចេញ ញត្តិ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ លោក ផែង វណ្ណៈ និង ក្រុមគ្រួសារ នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែកក្កដា៖ បង្ក្រាប ២៤ ករណី ឃាត់ខ្លួន ២៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៤ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១០ករណី . ដឹកជញ្ជូន រក្សាទុក ៤ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២៧ នាក់ ។
កងពល តូច ថ្មើជើង លេខ ២១ ចេញ ញត្តិ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ កងពល តូច ថ្មើង ជើង លេខ ២១ នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ និង ជា ប្រធាន សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី - ខេត្ត ចេញ សេចក្តីថ្លែងការណ៍ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ និង ជា ប្រធាន សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី - ខេត្ត នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
សមាគម គ្រឹះស្ថាន ឧត្ដម សិក្សា បច្ចេកទេស និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ឯកជន ចេញ សេចក្តីថ្លែងការណ៍ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ សមាគម គ្រឹះស្ថាន ឧត្ដម សិក្សា បច្ចេកទេស និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ឯកជន នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
( ភ្នំពេញ ) ៖ សមាគម សិស្ស និស្សិត បញ្ញា វ័ន្ត ក្មេង វត្ត រួមទាំង សាខា សមាគម សិស្ស និស្សិត បញ្ញា វ័ន្ត ក្មេង វត្ត តាម បណ្តាល ខេត្ត និង ខណ្ឌ នៃ រាជធានី ភ្នំពេញ ចេញ ញត្តិ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ ។ របស់ កម្ពុជា ។
ឧកញ៉ា សំ ប៊ន ទីប្រឹក្សា សម្ដេច ក្រឡាហោម ស ខេង ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ ឧកញ៉ា សំ ប៊ន ទីប្រឹក្សា សម្ដេច ក្រឡាហោម ស ខេង នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
ពិធី សំណេះសំណាល និង ចែក ប័ណ្ណ សរសើរ នេះ បាន ធ្វើឡើង នា រសៀល ថ្ងៃសៅរ៍ ២កើត ខែ ស្រា ពណ៍ ឆ្នាំ ខាល ចត្វា ស័ក ព .ស .២៥៦៦ រាជធានី ភ្នំពេញ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ នៅ មន្ទីរ គណបក្ស រាជធានី ភ្នំពេញ ដោយ មាន ការចូលរួម ពីសំណាក់ ប្រធាន ផ្នែក អនុប្រធាន សមាជិក - សមាជិកា និង ក្រុម ជំនួយការប្រមាណ ជិត ២០០ នាក់ ។
បន្ទាប់មក លោក បណ្ឌិត ជ្រុន ថេរ៉ាវ៉ាត បាន អញ្ជើញ ប្រគល់ ប័ណ្ណ សរសើរ ជូន ដល់ សមាជិក - សមាជិកា ក្រុម ជំនួយការ ផ្នែក ក្រសួង - ស្ថាប័ន នៃ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ព្រមទាំង បាន ចូលរួម ពិសា អាហារ សាមគ្គី និង រាំ កម្សាន្ត ក្នុង បរិយាកាស ស្និតស្នាល និង សប្បាយរីករាយ ៕
សហភាព សហជីព យុវជន ការពារ សិទ្ធិ កម្មករ កម្ពុជា ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ សហភាព សហជីព យុវជន ការពារ សិទ្ធិ កម្មករ កម្ពុជា ដែល មាន លោក ឡុង សុផាត ជា ប្រធាន បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី ១០ របស់ កម្ពុជា ។
សូម អាន ញត្តិ គាំទ្រ ដូច ខាងក្រោម៖ ឧត្តមសេនីយ៍ ទោ ចាន់ សារ៉ាន់ ចេញ ញត្តិ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ទោ ចាន់ សារ៉ាន់ នាយក មជ្ឈមណ្ឌល ហ្វឹកហ្វឺន ជំនាញ ការពារ ព្រំដែន នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
លោក សុខ សូកាន៖ សាមគ្គីភាព ជា ធ្លុង មួយ របស់ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន នាំមក នូវ ជោគជ័យ ដល់ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក គិរី វង់ ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់
( តាកែវ )៖ លោក សុខ សូកាន សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក គិរី វង់ លើកឡើង ថា សាមគ្គីភាព ជា ធ្លុង មួយ របស់ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក - ឃុំ គណបក្ស ស្រុក - ឃុំ និង អាជ្ញាធរ ស្រុក - ឃុំ គឺ នាំមក នូវ ជោគជ័យ ដល់ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក គិរី វង់ ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ។
លោក បាន បន្ត ថា តួអង្គ ទាំង បី ខាងលើ គឺជា ធាតុ ផ្សំ ដ៏ សំខាន់ និង ចាំបាច់ ដែល ធ្វើឱ្យ កម្រិត ជីវភាព របស់ ប្រជាពលរដ្ឋ ស្រុក គិរី វង់ កាន់តែ ប្រសើរឡើង ឥត ឈប់ឈរ ហើយ រស់ នៅ យ៉ាង សុខដុមរមនា ប្រកបដោយ កិត្តិយស ភាព កក់ក្ដៅ និង ភាពថ្លៃថ្នូរ ហើយ បាន បង្កើន ទំនុកចិត្ត ខ្ពស់ ចំពោះ ការដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក គិរី វង់ យើង ។
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែរ លោក សុខ សូកាន បាន ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ លទ្ធផល សន្និបាត គណៈកម្មាធិការ កណ្តាល វិសាមញ្ញ របស់ គណបក្ស ប្រជាជន កម្ពុជា ជូន ដល់ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក គិរី វង់ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ ទាំង ១២ គណៈកម្មាធិការ គណបក្ស ស្រុក គិរី វង់ និង គណៈកម្មាធិការ គណបក្ស ឃុំ ទាំង ១២ នៅ ស្នាក់ការ គណបក្ស ស្រុក គិរី វង់ នា ថ្ងៃសៅរ៍ ទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ជា អធិបតី ពី លោក បណ្ឌិត ជីវ កេង សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា សហ ប្រធាន កិត្តិយស ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក គិរី វង់ លោក លោកស្រី ជា អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក គិរី វង់ លោក លោកស្រី ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន តាម បណ្តា ឃុំ ទាំង ១២ ព្រមទាំង មាន ការចូលរួម ពី សមាជិក សមាជិកា សាខា គណបក្ស ស្រុក និង ប្រធាន គណៈកម្មាធិការ គណបក្ស ឃុំ ទាំង ១២ សរុប ប្រមាណ ១៦៦ នាក់ ។
លោក ស៊ុត ខុន អនុប្រធាន គណៈកម្មាធិការ គណបក្ស ស្រុក គិរី វង់ បាន ឡើង អាន របាយការណ៍ ស្ដីពី ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ និង ទិសដៅ ការងារ ឆ្ពោះ ទៅ ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ នៃ សន្និបាត គណៈកម្មាធិការ កណ្តាល វិសាមញ្ញ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។ ចំណែក លោក តឹក តុង លីម ប្រធាន គណៈកម្មាធិការ គណបក្ស ស្រុក បាន ឡើង អាន របាយការណ៍ ស្តីពី ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ នៅ ស្រុក គិរី វង់ ។
លោក សុខ សូកាន ក៏ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ នៅ ស្រុក គិរី វង់ ដែល បាន ប្រព្រឹត្តទៅ ប្រកបដោយ លក្ខណៈ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ ក្នុង បរិយាកាស អព្យាក្រឹត្យ សន្តិសុខ របៀបរៀបរយ គ្មាន អំពើហិង្សា និង ការគំរាមកំហែង ។
ដើម្បី ជា ការថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ក្រុមការងារ ទាំងអស់ និង ជា ការចូលរួម អបអរសាទរ ចំពោះ លទ្ធផល បោះឆ្នោត នៅ ស្រុក គិរី វង់ លោក សុខ សូកាន ក៏ បាន ប្រគល់ ជូន លិខិត អបអរសាទរ និង រង្វាន់ ដល់ ឃុំ កំណប់ និង ឃុំ រាម អណ្តើក ដែល បាន ឈ្នះ អាសនៈ ដាច់ ៥/ ៥ ព្រមទាំង ជូន លិខិត អបអរសាទរ និង រង្វាន់ ជូន ដល់ ក្រុមការងារ គណបក្ស តាម ការិយាល័យ បោះឆ្នោត និង រាប់ សន្លឹក ឆ្នោត ដែល ជាប់ ចំណាត់ថ្នាក់ លេខ ១ ដល់ លេខ ៥។
ជាមួយគ្នា នេះ លោក ក៏ បាន ជូន លិខិត ថ្លែងអំណរគុណ ជូន ដល់ ឯកឧត្តម សហ ប្រធាន កិត្តិយស នៃ ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក គិរី វង់ លោក លោកស្រី ជា ប្រធាន កិត្តិយស ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ ទាំង ១២ គណៈកម្មាធិការ គណបក្ស ឃុំ ទាំង ១២ សាខា បក្ស ចំណុះ គណបក្ស ស្រុក ទាំង៥ និង ក្រុមការងារ យុវជន គណបក្ស ស្រុក គិរី វង់ ។
ជា ចុងក្រោយ នោះ លោក សុខ សូកាន ក៏ បាន រម្លឹក ដល់ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក គិរី វង់ គ្រប់ ជាន់ ថ្នាក់ ត្រូវ អនុវត្ត ការងារ ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម ទិសដៅ ការងារ ដែល បាន ដាក់ចេញ និង ត្រូវ ក្តាប់ ឱ្យ ជាប់ ការប្តេជ្ញាចិត្ត ជា យុទ្ធសាស្ត្រ របស់ គណបក្ស គឺ « ខិតខំ រក្សា ប្រៀប ឈ្នះ និង បន្ត ពង្រីក ប្រៀប ឈ្នះ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧» ។
ក្រោយពេល ចប់ កិច្ចប្រជុំ ក្រុមការងារ ទាំងអស់ បាន ចូលរួម ពិសា អាហារ សាមគ្គី រួមគ្នា ប្រកបដោយ ភាពស្និទ្ធស្នាល និង ភាតរភាព ដ៏ រឹងមាំ ៕ លោក យឹម សារី អនុ រដ្ឋលេខាធិការ ក្រសួង យុត្តិធម៌ ចេញ ញត្តិ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ លោក យឹម សារី អនុ រដ្ឋលេខាធិការ ក្រសួង យុត្តិធម៌ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា នៅ ទ្វីប អាស៊ី ខាងកើត និង អាគ្នេយ៍ ចេញ ញត្តិ គាំទ្រ ការធ្វើ វិសោធនកម្ម លើក ទី១០ នៃ រដ្ឋធម្មនុញ្ញ
( ភ្នំពេញ ) ៖ លោក ហេង សួរ ប្រធាន ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា នៅ ទ្វីប អាស៊ី ខាងកើត និង អាគ្នេយ៍ ព្រមទាំង ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា ទាំងអស់ នៃ ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា នៅ ទ្វីប អាស៊ី ខាងកើត និង អាគ្នេយ៍ បាន ប្រកាស គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ការធ្វើ វិសោធនកម្ម លើក ទី១០ នៃ រដ្ឋធម្មនុញ្ញ ព្រះរាជាណាចក្រ កម្ពុជា ។
ក្នុង ញត្តិ គាំទ្រ នេះ បាន គូសបញ្ជាក់ ថា ការធ្វើ វិសោធនកម្ម នេះ គឺ ពិតជា បាន បំពេញ ចន្លោះ ខ្វះខាត នៃ រដ្ឋធម្មនុញ្ញ ដើម្បី ធានា បាន នូវ ឧត្តម ប្រយោជន៍ របស់ ជាតិ ជាពិសេស ធានា បាន ថា អំណាច នីតិប្រតិបត្តិ អាច ដំណើរការបានជា ប្រក្រតី និង មិន ជាប់គាំង នៅ គ្រប់ កាលៈទេសៈ ក្នុង ការបំពេញ បេសកកម្ម ជូន ជាតិ និង មាតុភូមិ តាម ការកំណត់ របស់ រដ្ឋធម្មនុញ្ញ និង ច្បាប់ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ញត្តិ បន្ត ថា ការធ្វើ វិសោធនកម្ម នេះ ពិតជា មាន ភាពចាំបាច់ ដើម្បី ធានា បាន នូវ ការគោរព គោលការណ៍ គ្រឹះ នៅក្នុង រដ្ឋធម្មនុញ្ញ គឺ របប ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង របប រាជានិយម អាស្រ័យ រដ្ឋធម្មនុញ្ញ ។
តាមរយៈ ញត្តិ នេះ ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា នៅ ទ្វីប អាស៊ី ខាងកើត និង អាគ្នេយ៍ បាន បដិសេធ ចំពោះ គំនិត ទុដ្ឋិនិយម របស់ ក្រុម ជន អគតិ លើ ការផ្ដួច ផ្តើម ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ នា ពេលនេះ ដោយ គ្មាន មូលដ្ឋាន ច្បាស់លាស់ មិន ត្រឹមត្រូវ តាម ខ្លឹមសារ ពិតប្រាកដន សំណើ វិសោធនកម្ម នា ពេលនេះ និង ជា ការលើកឡើង ដែល មាន ចរិត ជា ការបំភ្លៃ ការពិត ខុសពី ខ្លឹមសារ ពិតប្រាកដ ទាំងស្រុង នៃ សំណើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ នេះ ។
បញ្ជាការដ្ឋាន កាំភ្លើង ធំ កងទ័ព ជើងគោក ចេញ ញត្តិ គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០
( ភ្នំពេញ ) ៖ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ បញ្ជាការដ្ឋាន កាំភ្លើង ធំ កងទ័ព ជើងគោក នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ ញត្តិ ប្រកាស គាំទ្រ ទាំងស្រុង ចំពោះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ លើក ទី១០ របស់ កម្ពុជា ។
