( ភ្នំពេញ ) ៖ លេខាធិការដ្ឋាន នៃ ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ឯកជន ដើម្បី ស្ដារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ ក្នុង និង ក្រោយ វិបត្តិ ជំងឹកូវីដ - ១៩ នា ព្រឹក ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២២ បាន រៀបចំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ស្រប តាម ផែនទី ចង្អុល ផ្លូវ គិត ត្រឹម ឆមាស ទី១ ឆ្នាំ ២០២២ នៅ ទីស្តីការ ក្រសួង ទេសចរណ៍ ។
លោក ថោង រដ្ឋសក្ដិ អគ្គ នាយក អភិវឌ្ឍន៍ ទេសចរណ៍ និង សហប្រតិបត្ដិការ អន្តរជាតិ និង ជា ប្រធាន លេខាធិការដ្ឋាន ស្ដី ទី នៃ ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ឯកជន ដើម្បី ស្ដារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ ក្នុង និង ក្រោយ វិបត្តិ ជំងឹកូវីដ - ១៩ បាន ដឹកនាំ កិច្ចប្រជុំ នេះ ដោយ មាន ការចូលរួម ពី ប្រធាន អង្គភាព នាយកដ្ឋាន ពាក់ព័ន្ធ ទទួលខុសត្រូវ និង ប្រធាន មន្ទីរ ទេសចរណ៍ រាជធានី - ខេត្ត តាមរយៈ ប្រព័ន្ធ វីដេអូ Zoom សរុប ប្រមាណ ៧០ នាក់ ។
ថ្លែង ក្នុង កិច្ចប្រជុំ នេះ លោក ថោង រដ្ឋសក្ដិ បាន បញ្ជាក់ ពី ស្ថានភាព ភ្ញៀវ ទេសចរ អន្តរជាតិ ជា រួម ដែល កំពុង មាន កំណើន ត្រលប់ មកវិញ ជា បណ្តើរ ៗ ក្នុង នោះ គិត ត្រឹម ៦ខែ ដើម ឆ្នាំ ២០២២ នេះ ស្ថានភាព ទេសចរ ក្នុង តំបន់ អ អឺរ៉ុប និង អាមេរិក មាន ការកើនឡើង ពី ២០ - ២៥% និង សម្រាប់ តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក បាន កើនឡើង ១% ដោយសារ មិន ទាន់ មាន ដំណើរការ ទេសចរ ជនជាតិ ចិន ។ ក្នុង នោះ ផងដែរ ក្នុង ខែកក្កដា ឆ្នាំ ២០២២ នេះ កម្ពុជា ទទួលបាន ការហោះហើរ ចូលមក បន្ថែម គួរឱ្យ កត់សម្គាល់ ។
លោក បាន បន្ត ថា បច្ចុប្បន្ន នេះ កម្ពុជា បាន ទទួល ទេសចរ អន្តរជាតិ ជា រួម កើនឡើង ជិត ១៥០ % បើ ធៀប នឹង រយៈពេល ដូចគ្នា ក្នុង ឆ្នាំ ២០២១ ។
បច្ចុប្បន្ន នេះ ប្រទេស ជា សមាជិក អាស៊ាន ទាំងអស់ កំពុង ដាក់ អាទិភាព អនុវត្ត ផែនការ សកម្មភាព ឆ្នាំ ២០២២ - ២០២៣ លើ ស្ថានភាព ទេសចរណ៍ ដោយ ផ្តោត សំខាន់ លើ ការជំរុញ បន្ថែម នូវ ការ ស្តារ សេដ្ឋកិច្ច ឡើងវិញ រួម ជាមួយនឹង ការគិតគូរ ពី បរិស្ថាន និង ការប្រែប្រួល អាកាសធាតុ ការធ្វើ ឌីជីថ លូបណី យកម្ម និង ការគិតគូរ ពី ការរៀបចំ សហគមន៍ ទេសចរណ៍ អេកូ ទេសចរណ៍ ជា ផលិតផល ទាក់ទាញ ទេសចរណ៍ ។
បន្ថែម ពី នេះ ទៀត លោក ថោង រដ្ឋសក្ដិ បាន ពិនិត្យ លើ លទ្ធផល ការងារ ដែល សម្រេចបានជា រួម កន្លងមក និង បាន វាយតម្លៃ ថា អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ បាន បំពេញ ការងារ ស្រប តាម ផែនទី ចង្អុល ផ្លូវ ដោយ សម្រេចបាន ៨០ % បើ គិត ត្រឹម ឆមាស ទី១ ឆ្នាំ ២០២២ នេះ ។ យ៉ាងណាមិញ លេខាធិការដ្ឋាន រង់ចាំ របាយការណ៍ បន្ថែម ពី ផ្នែក ឯកជន ក្នុង វិស័យ ទេសចរណ៍ ដើម្បី ដាក់បញ្ចូល និង បំពេញ បន្ថែម ក្នុង របាយការណ៍ សមិទ្ធផល របស់ ក្រុមការងារ ។
លោក អគ្គ នាយក បាន ស្នើ ប្រធាន លេខាធិការដ្ឋាន នៃ អនុក្រុមការងារ ទាំង ៣ត្រូវ ដើរ តួនាទី បន្ថែម លើ កិច្ចការ សម្របសម្រួល ជាមួយ គ្រប់ នាយកដ្ឋាន និង អង្គភាព ដែល ពាក់ព័ន្ធ សម្រាប់ អនុក្រុមការងារ រៀង ៗ ខ្លួន ដើម្បី ពន្យល់ និង ជំរុញ ដល់ នាយកដ្ឋាន និង អង្គភាព ពាក់ព័ន្ធ ទាំងនោះ បំពេញ សកម្មភាព របស់ ខ្លួន ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក ក៏ បាន ស្នើ ប្រធាន លេខាធិការដ្ឋាន នៃ អនុក្រុមការងារ ទាំង៣ រៀបចំ ជារបប របាយការណ៍ និង របប ប្រជុំ ជាប្រចាំ សម្រាប់ អនុក្រុមការងារ រៀង ៗ ខ្លួន ដើម្បី ប្រមូល លទ្ធផល ពី នាយកដ្ឋាន និង អង្គភាព ពាក់ព័ន្ធ ជាប្រចាំ ខែ ឬ យ៉ាងហោច ប្រចាំ ត្រីមាស និង ធ្វើ ការបូកសរុប រួម នឹង ការវាយតម្លៃ ជាមុន មុននឹង បញ្ចូល មក លេខាធិការដ្ឋាន នៃ ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ឯកជន ធ្វើ បូកសរុប ។
ប្រធាន អង្គភាព និង នាយកដ្ឋាន ពាក់ព័ន្ធ ត្រូវ តាមដាន សកម្មភាព អនុវត្ត ប្រចាំ ថ្ងៃ របស់ ខ្លួន ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ និង ស្នើសុំ ការបញ្ជាក់ ពី លេខាធិការដ្ឋាន ភ្លាម ៗ ក្នុង ករណី មាន ចម្ងល់ ឬ យល់ ថា ជាន់ ភារកិច្ច នៅក្នុង ចំណុច សកម្មភាព អនុវត្ត ណាមួយ ដើម្បី ជំរុញ ការងារ ទៅ មុខ ។
សម្រាប់ លទ្ធផល ការងារ ដែល សម្រច បាន ទាំងនេះ នឹង ដាក់ ផ្សព្វផ្សាយ រួម សម្រាប់ សមិទ្ធផល ការងារ របស់ ក្រសួង ទេសចរណ៍ ក្នុង អង្គ សន្និបាត បូកសរុប ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១២ ដល់ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២២ នា ពេល ខាងមុខ នេះ ៕
អ្នកនាំពាក្យ៖ ៦ខែ នេះ រន្ទះ បាញ់ សម្លាប់ មនុស្ស ៣២ នាក់
របាយការណ៍ ដែល ផ្តល់ ដោយ លោក សុទ្ធ គឹម កុល មុនី អ្នកនាំពាក្យ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ៦ខែ ឆ្នាំ ២០២២ គ្រោះថ្នាក់ រន្ទះ កើតឡើង ចំនួន ៦១ លើក ធ្វើឲ្យ ខូចខាត ផ្ទះ ១១ខ្នង ធ្វើឲ្យ មនុស្ស ស្លាប់ ៣២ នាក់ ធ្វើឲ្យ មនុស្ស របួស ២៦ នាក់ និង ធ្វើឲ្យ គោ ក្របី ងាប់ ៦៩ ក្បាល » ។
របាយការណ៍ បាន បន្ត ថា ៦ខែ ឆ្នាំ ២០២២ នេះ ដែរ ខ្យល់ កន្ត្រាក់ កើតឡើង ១០៨ លើក ធ្វើឲ្យ ផ្ទះ រលំ ៦៨៥ ខ្នង ធ្វើឲ្យ ផ្ទះ រ បើក ដំបូល ២៣៧៤ ខ្នង ធ្វើឲ្យ ខូចខាត សាលារៀន ១៩ ខ្នង ធ្វើឲ្យ ខូចខាត តូប / ផ្សារ ១៣កន្លែង ធ្វើឲ្យ ខូចខាត អគា រដ្ឋបាល ៦កន្លែង ធ្វើឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង ធ្វើឲ្យ មនុស្ស របួស ២៨ នាក់ ។
របាយការណ៍ ដដែល បាន បន្ថែម ទៀត ថា ៦ខែ ឆ្នាំ ២០២២ នេះ អគ្គិភ័យ កើតឡើង ២៥១ លើក ធ្វើឲ្យ ខូចខាត ផ្ទះ ៤៤៥ ខ្នង ធ្វើឲ្យ ខូចខាត តូប / ផ្សារ ៤៦កន្លែង ធ្វើឲ្យ ខូចខាត ឃ្លាំង ទំនិញ ១៣កន្លែង ធ្វើឲ្យ ខូចខាត សាលារៀន ២ខ្នង ធ្វើឲ្យ ខូចខាត រោងចក្រ / សិប្បកម្ម ៦កន្លែង ធ្វើឲ្យ ខូចខាត អគារ រដ្ឋបាល ២កន្លែង ធ្វើឲ្យ ខូចខាត ចម្ការ / ព្រៃ ១កន្លែង ធ្វើឲ្យ មនុស្ស ស្លាប់ ១១នាក់ និង ធ្វើឲ្យ មនុស្ស របួស ៣២ នាក់ ៕ របួស ៦នាក់ ក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ រវាង រថយន្ត និង ម៉ូតូ សណ្តោង រ៉ឺម៉ក ដឹក សិស្ស
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពត បាន ឲ្យដឹង ថា យ៉ាងហោចណាស់ មាន មនុស្ស របួស ធ្ងន់ និង ស្រាល ៦នាក់ ក្នុង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ រវាង រថយន្ត និង ម៉ូតូ សណ្តោង រ៉ឺម៉ក ដឹក សិស្ស ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ថ្ងៃទី ០៨ ខែកក្កដា ឆ្នាំ ២០២២ វេលា ម៉ោង ១២៖ ១៥ នាទី ថ្ងៃត្រង់ នៅ ចំណុច ខាងកើត ប្រឡាយ ចម្ងាយ ៥០ម៉ែត្រ ចន្លោះ បង្គោល គីឡូម៉ែត្រ លេខ ១៣៣ - ១៣៤ ស្ថិត ក្នុង ភូមិ ព្រៃ ខ្នង ឃុំ ព្រៃ ខ្នង ស្រុក ទឹក ឈូ ខេត្ត កំពត លើ ផ្លូវ ជាតិ លេខ ៣។ គ្រោះថ្នាក់ ចរាចរណ៍ រវាង រថយន្ត និង ម៉ូតូ សណ្តោង រ៉ឺម៉ក ដឹក សិស្ស គឺ មាន ទិសដៅ ស្រប គ្នា ពី កើត ទៅ លិច ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ បន្ទាប់ពី លោក ចន សុន ប្រកាស លា លែង ពី តំណែង លោក បៃ ដិន បាន គូសបញ្ជាក់ ថា « សហរដ្ឋ អាមេរិក និង ចក្រភព អង់គ្លេស គឺជា សម្ព័ន្ធមិត្ត ដ៏ ជិតស្និទ្ធ បំផុត ហើយ ជាពិសេស នោះ គឺ ទំនាក់ទំនង រវាង ប្រជាជន របស់ យើង នៅតែ រឹងមាំ និង យូរអង្វែង » ។ លោក បៃ ដិន បាន បន្ថែម ថា « ខ្ញុំ ទន្ទឹងរង់ចាំ បន្ត កិច្ចសហប្រតិបត្តិការ របស់ យើង ជាមួយ រដ្ឋាភិបាល អង់គ្លេស ក៏ ដូចជា សម្ព័ន្ធមិត្ត និង ដៃគូ ដ៏ទៃ ទៀត នៅ ជុំវិញ ពិភពលោក លើ ទិសដៅ អាទិភាព សំខាន់ ៗ ជាច្រើន » ។
រដ្ឋបាល ក្រុង ព្រះសីហនុ ប្រារព្ធ ទិវា បរិស្ថាន ជាតិ និង បរិស្ថាន ពិភពលោក ០៥ មិថុនា
( ព្រះសីហនុ) ៖ រដ្ឋបាល ក្រុង ព្រះសីហនុ និង មន្ទីរ បរិស្ថាន ខេត្ត ព្រះសីហនុ នៅ រសៀល ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០២២ នេះ បាន ប្រារព្ធ ទិវា បរិស្ថាន ជាតិ និង បរិស្ថាន ពិភពលោក នៅ ឆ្នេរ ព្រែក ត្រែង ក្រុង ព្រះសីហនុ ក្រោម អធិបតីភាព លោក អ៊ី សុខ ឡេង អភិបាល ក្រុង ព្រះសីហនុ និង មាន ដោយ ការចូលរួម ពី មន្ទីរ អង្គភាព កងកម្លាំងប្រដាប់អាវុធ មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ប្រជាពលរដ្ឋ និង សិស្សានុសិស្ស យ៉ាង ច្រើន កោះ ករ ។
លោក សា មុត សុធារិទ្ធ បាន បន្ថែម ទៀត ថា ដើម្បី ធ្វើឲ្យ បរិស្ថាន ទីក្រុង និង កន្លែង ទេសចរណ៍ ក្នុង ក្រុង ព្រះសីហនុ គ្មាន សំរាម គ្មាន សំណល់ ត្រូវ ផ្តើម ចេញ ពី ខ្លួន យើង គឺ ត្រូវ គ្រប់គ្រង សំរាម កាកសំណល់ រឹង វិចខ្ចប់ អោយ បាន ត្រឹមត្រូវ ដាក់ ក្នុង ធុង សំរាម និង មិន ត្រូវ បោះចោល សំរាម តាម សាធារណៈ ។
ថ្លែង នា ឱកាស នោះ ដែរ លោក អ៊ី សុខ ឡេង បាន ថ្លែង ថា យោង តាម របាយការណ៍ របស់ ( យូ អិន ឌី) ក្នុង ឆ្នាំ ២០១៨ ប្រទេស កម្ពុជា បង្កើត កាកសំណល់ រឹង ប្រហែល ៣លាន តោន និង សំណល់ វ រឹង ឧស្សាហកម្ម និង ពាណិជ្ជកម្ម ប្រហែល ១៦លាន តោន ។ បរិមាណ សំណល់ មាន ការកើនឡើង យ៉ាង ឆាប់រហ័ស នាំឱ្យ យើង មាន វិធានការ ដោះស្រាយ ជាបន្ទាន់ សំដៅ បង្កើន ការយល់ដឹង ដល់ សាធារណ ជន អំពី បញ្ហា បរិស្ថាន លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ និង សហគមន៍ ឱ្យ ក្លាយជា ភ្នាក់ងារ សកម្ម ប្រកបដោយ ចីរភាព និង អភិវឌ្ឍន៍ មេត្រី បរិស្ថាន ។
ប្រភេទ ទំនិញ ដែល កម្ពុជា បាន លក់ ទៅឲ្យ ប្រទេស ថៃ រួម មាន ផលិតផល កសិកម្ម វត្ថុធាតុ ដើម ត្បូង ថ្ម មាន តម្លៃ និង វាយន ភណ្ឌ ខណៈ ថៃ លក់ មក ឱ្យ វិញ នូវ ផលិតផល សម្រេច ដូចជា ត្រី សាច់ ម្ហូប អាហារ និង ភេសជ្ជៈ ជី សរីរាង្គ ស៊ីម៉ង់ គ្រឿង សំអាង គ្រឿង តុបតែង ផ្ទះ ឧបករណ៍ អេឡិចត្រូនិក រថយន្ត និង គ្រឿង បន្លាស់ សម្ភារៈ ការិយាល័យ និង បរិក្ខា សំណង់ ជាដើម ។
ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត កំពង់ឆ្នាំង ណែនាំ អ្នកសារព័ត៌មាន ក្នុង ខេត្ត អនុវត្ត បាន តាម វិជ្ជាជីវៈ និង ក្រមសីលធម៌ សារព័ត៌មាន
( កំពង់ឆ្នាំង ) ៖ លោក ម៉ម ឈឿម ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត កំពង់ឆ្នាំង បាន ថ្លែង ណែនាំ ដល់ អ្នកសារព័ត៌មាន ក្នុង ខេត្ត នេះ អនុវត្ត បាន តាម វិជ្ជាជីវៈ និង ក្រមសីលធម៌ សារព័ត៌មាន ក្នុង ក្របខ័ណ្ឌ ច្បាប់ របប សារព័ត៌មាន នៃ កម្ពុជា ។
លោក ថ្លែង បែប នេះ ក្នុង សិក្ខាសាលា ស្តីពី ការអនុវត្ត វិជ្ជាជីវៈ និង សេរីភាព សារព័ត៌មាន ក្នុង ក្របខណ្ឌ ច្បាប់ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ត្រូវបាន រៀបចំឡើង ដោយ មន្ទីរព័ត៌មាន ខេត្ត កំពង់ឆ្នាំង សហការ ជាមួយ អង្គការ ក្រុមការងារ ដោះស្រាយ ទំនាស់ (ACT) នៅ សាល ប្រជុំ មន្ទីរព័ត៌មាន ខេត្ត កំពង់ឆ្នាំង នា ព្រឹក ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២២ ។
តាមរយៈ របាយការណ៍ និង តាម ការសង្កេត ជា រួម ក្រោយពី មន្ទីរព័ត៌មាន សហការ ជាមួយ អង្គការ ដៃគូ មួយចំនួន ធ្វើ ការផ្សព្វផ្សាយ ច្បាប់ ស្តីពី របប សារព័ត៌មាន និង បើក វគ្គ បណ្តុះបណ្តាល ការសរសេរ ព័ត៌មាន បែប សន្តិភាព ជា បន្តបន្ទាប់ ឃើញ ថា អ្នកសារព័ត៌មាន ក្នុង ខេត្ត បាន ចូលរួម អនុវត្ត តាម វិជ្ជាជីវៈ និង ក្រមសីលធម៌ សារព័ត៌មាន បាន ល្អ ប្រសើរ ។
លោក ម៉ម ឈឿម បន្ត ទៀត ថា សិក្ខាសាលា ដ៏ មាន សារសំខាន់ នេះ នឹង ឆ្លើយតប យ៉ាង មាន ប្រសិទ្ធភាព ខ្ពស់ នូវ កំណែទម្រង់ ស៉ី ជម្រៅ ដែល រដ្ឋាភិបាល បាន ដាក់ចេញ នៅក្នុង កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ ។
ថ្លែង នៅក្នុង ឱកាស នោះ លោក រស់ ចាន់ ណា វុឌ្ឍ ប្រធាន ការិយាល័យ កម្មវិធី ប្រយុទ្ធ នឹង ជំងឺ គ្រុនចាញ់ និង គ្រុន ឈាម ខេត្ត ព្រៃវែង បាន លើកឡើង ថា មកដល់ ត្រឹម ពេលនេះ ក្នុង ឆ្នាំ ២០២២ នេះ គឺ មាន អ្នក កើត នៅ ជំងឺ គ្រុន ឈាម មាន តែ ៥ករណី តែ ប៉ុណ្ណោះ ហើយក៏ បាន ព្យាបាល ជាសះស្បើយ ផងដែរ ។
សូម បញ្ជាក់ ថា យុទ្ធនាការ ចុះអប់រំ ផ្សព្វផ្សាយ នេះ គឺ ធ្វើ គ្រប់ ភូមិ ទាំងអស់ ក្នុង ក្រុង ព្រៃវែង ទាំង៤ សង្កាត់ ស្មើ និង ២៣ ភូមិ តែម្តង តាម ថ្ងៃ បន្តបន្ទាប់ ៕
ACU បញ្ជាក់ អំពី ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល សម្រាប់ សមាជិក ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ បញ្ជាក់ អំពី ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល សម្រាប់ សមាជិក ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥
បើ យោង តាម ចម្លើយ របស់ អង្គភាព ប្រឆាំង អំពើពុករលួយ បាន ឱ្យដឹង ថា៖
១៖ ( មាត្រា ១៨ ) របប ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល នៃ ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ ) រយៈពេល ៣០ ថ្ងៃ យ៉ាង យូរ ក្រោយពី ពេល ចូលកាន់ តំណែង គឺ ត្រូវ រាប់ ចាប់ពី ថ្ងៃ ពិធី ប្រកាស សុពលភាព ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ គឺជា ថ្ងៃទី១ នៃ រយៈពេល ៣០ ថ្ងៃ យ៉ាង យូរ ក្រោយពេល ចូលកាន់ តំណែង ។
ទី ២៖ សមាជិក ថ្មី នៃ ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ដែល ពីមុន មក មិន ធ្លាប់ ទទួល មុខងារ នេះ ហើយ មិន ធ្លាប់ មាន មុខងារ អ្វី ផ្សេង ទៀត ដែល ជាប់ កាតព្វកិច្ច ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ត្រូវ អនុវត្ត ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ក្នុង រយៈពេល ៣០ ថ្ងៃ យ៉ាង យូរ ក្រោយពី ចូលកាន់ មុខតំណែង ។
ទី ៣៖ សមាជិក ចាស់ ដែល ត្រូវបាន ជាប់ ឆ្នោត ជាថ្មី ក្នុង អាណត្តិ នេះ មិន ចាំបាច់ ធ្វើ ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ក្នុង រយៈពេល ៣០ ថ្ងៃ ក្រោយ ការចូលកាន់ មុខតំណែង នា ពេលនេះ ទេ ហើយ ត្រូវ ធ្វើ ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល តាមរបប ០២ ឆ្នាំ គឺ នៅ ខែមករា ឆ្នាំ ២០២៣ សម្រាប់ អ្នក ដែល បាន ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល នៅ ក្នុង ឆ្នាំ ២០២១ និង នៅ ខែមករា ឆ្នាំ ២០២៤ សម្រាប់ អ្នក ដែល បាន ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល នៅក្នុង ឆ្នាំ ២០២២ ។
ទី ៤៖ សមាជិក ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ចាស់ ( ទី៤ ) ដែល មិន ឈរឈ្មោះ ជា បេក្ខជន ជាថ្មី ដែល មិន ជាប់ ដែល លា ឈប់ ហើយ មិន មាន នៅសល់ មុខងារ និង បំណុល ត្រូវ ធ្វើ ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ជា លើក ចុងក្រោយ ក្នុង អំឡុង ពេល ៣០ ថ្ងៃ យ៉ាង យូរ ក្រោយ ពិធី ប្រកាស សុពលភាព ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ៕
ខាងក្រោម នេះ ជា លិខិត របស់ អង្គភាព ប្រឆាំង អំពើពុករលួយ ៖ ប្រកាស ទទួលស្គាល់ សមាសភាព ប្រធាន ក្រុមប្រឹក្សា ចៅសង្កាត់ ចៅសង្កាត់ រង និង សមាជិក ក្រុមប្រឹក្សា នៃ សង្កាត់ ទឹក ថ្លា ថ្មី ក្រុង សិរី សោភ័ណ
( បន្ទាយមានជ័យ )៖ ក្នុង សាលា សង្កាត់ ទឹក ថ្លា ស្ថិត ភូមិ ទឹក ថ្លា សង្កាត់ ទឹក ថ្លា ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង មហាផ្ទៃ បាន ចេញ ប្រកាស ទទួលស្គាល់ សមាសភាព ប្រធាន ក្រុមប្រឹក្សា ចៅសង្កាត់ ចៅសង្កាត់ រង និង សមាជិក ក្រុមប្រឹក្សា នៃ សង្កាត់ ទឹក ថ្លា ថ្មី អាណត្តិ ទី៥ ក្រោយ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ។
ពិធី ប្រកាស ជា ផ្លូវការ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ដោយ មាន ការចូលរួម ពី លោកស្រី ស៊្រាង គឹម ស៊ាង អភិបាល រង ក្រុង សិរី សោភ័ណ លោក អ៊ុង ស៉ី ផាន ឧត្តម អត្ថានុរក្ស ថ្នាក់ លេខ ២ និង ជា ប្រធាន ពន្ធនាគារ ខេត្ត បន្ទយ មានជ័យ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ ទឹក ថ្លា មន្ត្រី និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ។
យោង លទ្ធផល នៃ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ នៅ សង្កាត់ ទឹក ថ្លា នៃ ខេត្ត បន្ទាយមានជ័យ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ចុះ ថ្ងៃទី ២៦ ខែមិថុនា ឆ្នាំ ២០២២ ទទួលស្គាល់ ១៖ លោក ខាំ សរ ជា ចៅសង្កាត់ ២៖ លោក សឿន ចាន់ ស ជា ចៅសង្កាត់ រង ទី១ និង ៣៖ លោក ព្រឿង ប៊ុន ធឿន ជា ចៅសង្កាត់ រង ទី២។ ចំណែក ៦រូប ទៀត ជា សមាជិក ក្រុមប្រឹក្សា សង្កាត់ គឺ ១៖ ឈ្មោះ លោក ឌីហៀង ២៖ លោកស្រី ហោ សុផាន់ ៣៖ លោក ខាំ មួន ៤៖ លោក ឌុចរ៉ា ៥៖ លោក កុយ ច័ន្ទ វាសនា និង ៦៖ លោក ភិន សារ៉េត ។
លោក ខាំ ស បាន ថ្លែង ថា ដោយសារតែ ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ ទឹក ថ្លា ស្រឡាញ់ ពេញចិត្ត លោក ៤អាណត្តិ កន្លងមក ហើយ នោះ ទើប អាណត្តិ ទី ៥នេះ ប្រជាពលរដ្ឋ នៅតែ មាន ការគាំទ្រ យ៉ាង ខ្លាំង លើ រូបលោក តាមរយៈ ការបោះឆ្នោត កាលពី ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ ឲ្យ ធ្វើជា ចៅសង្កាត់ អាណត្តិ ទី៥ បន្ត ទៀត ។ ក្នុង នោះ លោក បាន ប្តេជ្ញា ថា នឹង យកចិត្តទុកដាក់ ផ្ដល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ និង បន្ត ខិតខំ ថែរក្សា នូវ សុខ សុវត្ថិភាព សណ្ដាប់ធ្នាប់ សាធារណៈ ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង មូលដ្ឋាន របស់ ខ្លួន ។
លោកស្រី ស៊្រាង គឹម ស៊ាង បាន ធ្វើ ការ ផ្តាំផ្ញើ ដល់ ចៅសង្កាត់ ចៅសង្កាត់ រង សមាជិក ក្រុមប្រឹក្សា សង្កាត់ ទឹក ថ្លា អនុវត្ត ឱ្យ សម្រេចបាន ជោគជ័យ អាណត្តិ ទី៥ នូវ៖
( ភ្នំពេញ ) ៖ សិក្ខាសាលា ស្តីពី រដ្ឋាភិបាល ឌីជីថល ជួយ រួមចំណែក សម្រាប់ ក្របខណ្ឌ គោល នយោបាយ រដ្ឋាភិបាល ឌីជីថល កម្ពុជា ឆ្នាំ ២០២២ - ២០៣៥ ។ នេះ បើ តាម ការថ្លែង របស់ លោក យក់ ប៊ុន ណា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង មុខងារ សាធារណៈ និង ជា នាយក សាលា ភូមិន្ទ រដ្ឋបាល នៅ ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២២ ។
ក្នុង ឱកាស តំណាង លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ អញ្ជើញ ជា អធិបតី បិទ សិក្ខាសាលា ស្តីពី រដ្ឋាភិបាល ឌីជីថល នៅ សាលា ភូមិន្ទ រដ្ឋបាល លោក យក់ ប៊ុន ណា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « សិក្ខាសាលា មួយ នេះ ក៏ ជា ការចូលរួម ចំណែក មួយ សម្រាប់ ក្របខណ្ឌ គោល នយោបាយ រដ្ឋាភិបាល ឌីជីថល កម្ពុជា ឆ្នាំ ២០២២ - ២០៣៥ ដែល បាន ដាក់ចេញ កាលពី ខែមករា ឆ្នាំ ២០២២ នេះ ផងដែរ » ។
លោក បន្ត ថា ក្របខណ្ឌ គោល នយោបាយ រដ្ឋាភិបាល ឌីជីថល គឺ ផ្តោត សំខាន់ លើ ការពង្រឹង សេវា សាធារណៈ ដោយ ប្រើប្រាស់ បច្ចេកវិទ្យា ធ្វើជា ឃ្នាស់ ។ បន្ថែម លើ នេះ ក្របខណ្ឌ គោល នយោបាយ រដ្ឋាភិបាល ឌីជីថល កម្ពុជា ឆ្នាំ ២០២២ - ២០៣៥ មាន ចក្ខុវិស័យ ក សាង រដ្ឋាភិបាល ឌីជីថល ដើម្បី លើកកម្ពស់ គុណភាព ជីវិត និង ទំនុកចិត្ត ប្រជាពលរដ្ឋ តាមរយៈ ការបម្រើ សេវា សាធារណៈ ឲ្យ កាន់តែ ល្អ ប្រសើរ ។
រដ្ឋលេខាធិការ ប្រចាំ ការ បាន បន្ត ថា ដើម្បី សម្រេចបាន នូវ ចក្ខុវិស័យ នេះ ឯកសារ គោល នយោបាយ បាន ដាក់ នូវ យុទ្ធសាស្ត្រ ចំនួន ១០ ដែល រួម មាន៖
ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ប្រព័ន្ធ បច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន នៅ កម្ពុជា មាន ការរីកចម្រើន យ៉ាង ឆាប់រហ័ស ។ ប៉ុន្តែ ការត្រៀមខ្លួន របស់ កម្ពុជា ក្នុង ការចាប់ យក វិស័យ ឌីជីថល នៅ ប្រឈម ច្រើន រួម មាន ភាព មាន កម្រិត នៃ ហេដ្ឋារចនាសម្ព័ន្ធ មូលដ្ឋាន គាំទ្រ ដល់ វិស័យ ឌីជីថល ភាពជឿ ទុកចិត្ត ចំណេះដឹង ជំនាញ ភាព ជា អ្នកដឹកនាំ ឌីជីថល និង អក្ខរកម្ម ឌីជីថល ។
នៅក្នុង ឱកាស នេះ ដែរ លោក យក់ ប៊ុន ណា សង្ឃឹម យ៉ាង ម៉ុត មាំ ថា តាមរយៈ សិក្ខាសាលា នេះ សិក្ខាកាម ទាំងអស់ ដែល ទទួលបាន ពុទ្ធិ ថ្មី ៗ បន្ថែម ពីសំណាក់ វា គ្មិន នានា មកពី ប្រទេស សិង្ហបុរី នឹង អាច យក ទៅ ប្រើ ឬ ចែករំលែក បន្ត នៅ តាម ក្រសួង ស្ថាប័ន និង អង្គភាព រៀង ៗ ខ្លួន ដើម្បី ជំរុញ ប្រសិទ្ធភាព ការងារ ។
ក្នុង នាម លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខ សាធារណៈ លោក បាន សម្តែង នូវ អំណរគុណ ដ៏ ជ្រាលជ្រៅ ចំពោះ មូលនិធិ Temasek អន្តរជាតិ ស្ថានទូត សិង្ហបុរី ប្រចាំ នៅ កម្ពុជា សាលា មុខងារ សាធារណៈ សិង្ហបុរី ដែល បាន និង បន្ត ផ្តល់ ការគាំទ្រ និង កិច្ចសហការ ចំពោះ ការរៀបចំ និង អនុវត្ត គម្រោង កាង សមត្ថភាព មន្ត្រី កម្ពុជា ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្រ្តី សាលា ភូមិន្ទ រដ្ឋបាល ដែល បាន ប្រឹងប្រែង រួមគ្នា ជាមួយ គ្រប់ តួអង្គ ពាក់ព័ន្ធ រៀបចំ ឲ្យ មាន សិក្ខាសាលា នេះ ។
គួរ បញ្ជាក់ ថា លោក អាបេ ត្រូវបាន ខ្មាន់ កាំភ្លើង ម្នាក់ បាញ់ ឱ្យ របួស ធ្ងន់ កំលុង ថ្លែង សុន្ទរកថា នៅឯ យុទ្ធនាការ ឃោសនា បោះឆ្នោត មួយ មុននឹង ការបោះឆ្នោត សភា ជាន់ ខ្ពស់ ប្រព្រឹត្តទៅ នៅ ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ នេះ ៕
អាវុធហត្ថ ខេត្ត រតនគិរី បញ្ជូន ជនសង្ស័យ ២នាក់ ករណី ប្រើប្រាស់ ឯកសារ សារធារណៈ ក្លែង ទៅ តុលាការ ក្រោយ ចាប់ខ្លួន
( រតនគិរី ) ៖ មន្ត្រី ជំនាញ កងរាជអាវុធហត្ថ ខេត្ត រនគិរី នៅ ព្រឹក ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន បញ្ជូន ខ្លួន ជនសង្ស័យ ២នាក់ ករណី ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង ទៅ សាលាដំបូង ខេត្ត រតនគិរី ។
