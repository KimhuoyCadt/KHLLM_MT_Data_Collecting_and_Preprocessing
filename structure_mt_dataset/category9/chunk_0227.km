( ព្រះវិហារ ) ៖ រដ្ឋបាល ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការផ្អាក ការធ្វើដំណើរ ឆ្លងកាត់ ចំពោះ មធ្យបាយ យានយន្ត គ្រប់ ប្រភេទ ចាប់ពី ដង ទង់ជាតិ គោ បុរះ ទី៥ រហូតដល់ ពយ តាឌី នៃ ប្រាសាទ ព្រះវិហារ ។
តាមរយៈ សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ស្រុក ជាំ ក្សាន្ត ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ល្ងាច ថ្ងៃ នេះ បាន បញ្ជាក់ ថា៖ « ដោយ សង្កេតឃើញ ថា នៅ រដូវ វស្សា ភ្លៀង ធ្លាក់ ជាប្រចាំ ធ្វើឱ្យ ស្ថានភាព ផ្លូវ លើ ប្រាសាទ ព្រះវិហារ មាន ការខូចខាត ខ្លាំង ជាពិសេស ចាប់ពី ចំណុច ដង ទង់ជាតិ ជិត គោ បុរះ ទី៥ រហូតដល់ ពយ តាឌី មាន ការហូរច្រោះ ដី ធ្វើឱ្យ មាន ជង្ហុក ជ្រៅ និង មាន សភាព រអិល ដែល អាច បង្កឱ្យ មាន គ្រោះថ្នាក់ ជា យថាហេតុ នៅពេល ធ្វើចរាចរណ៍ ឆ្លងកាត់ » ។
ដើម្បី ថែរក្សា សុវត្ថិភាព ជូន សាធារណជន និង ចូលរួមចំណែក ក្នុង ការលើកស្ទួយ កិច្ចការ អភិរក្ស ហេដ្ឋារចនាសម្ព័ន្ធ បុរាណ ដែល ជា សម្បត្តិ បេតិកភ័ណ ពិភពលោក រដ្ឋបាល ស្រុក ជាំ ក្សាន្ត សូម ជូនដំណឹង ផ្អាក ការធ្វើដំណើរ ឆ្លងកាត់ ចំពោះ មធ្យោបាយ យានយន្ត គ្រប់ ប្រភេទ ចាប់ពី ចំណុច ដង ទង់ជាតិ គោ បុរះ ទី៥ រហូតដល់ ពយ តាឌី នៃ ប្រាសាទ ព្រះវិហារ ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ តទៅ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ស្រុក ជាំ ក្សា ន្ត៖ មេបញ្ជាការវរសេនា ធំ ប្រឆាំង ភេរវកម្ម បញ្ជាការដ្ឋាន ប្រតិបត្តិការ ពិសេស កងទ័ព ហ្វីលីពីន បំពេញ ទស្សនកិច្ច នៅ កងពល តូច លេខ ៧០
ក្នុង ឱកាស នោះ ដែរ លោក មេបញ្ជាការ កងពល បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការអញ្ជេីញ របស់ លោក ឧត្តមសេនីយ៍ ត្រី ម៉ូនីកូ អេស្តូតា អាបាង ដែល បាន មក បំពេញ ទស្សនកិច្ច នៅ កងពល តូច លេខ ៧០ ។
លោក ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន តែង បាន ប្រកាន់ខ្ជាប់ នូវ សន្តិភាព មិត្តភាព សហប្រតិបត្តិការ និង ការអភិវឌ្ឍ ហើយ តទៅ អនាគត នឹង បន្ត ពង្រឹង ពង្រីក ប្រតិបត្តិការ ដែល មាន ស្រាប់ ឲ្យ កាន់តែ ជិតស្និទ្ធ និង រឹងមាំ យូរអង្វែង ដើម្បី ភាពសុខដុម ប្រទេស ទាំង ពីរ ។
ជា ការឆ្លេី យត ប លោក ឧត្តមសេនីយ៍ ត្រី ម៉ូនីកូ អេស្តូតា អាបាង បាន ថ្លែងអំណរគុណ ចំពោះ លោក មេបញ្ជាការ កងពល ដែល បាន ទទួល លោក និង សហការី យ៉ាកក់ក្តៅ ព្រមទាំង បាន លើក បង្ហាញ ពី ចំណង ទាក់ទង មិត្តភាព រវាង ប្រទេស ទាំង ពីរ កាន់តែ រឹងមាំ ទ្វេ ដង ៕
អ្នក ឧកញ៉ា លី សុខ ថៃ បរិច្ចាគ ថវិកា ៣០ម៉ឺន ដុល្លារ ជូន រាជ រដ្ឋាភិបាល ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . អ្នក ឧកញ៉ា លី សុខ ថៃ នាយក ក្រុមហ៊ុន ដែល ខុម បាន ចូលរួម បរិច្ចាគ ថវិកា ៣០ម៉ឺន ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
មេ គយ ដាក់ បញ្ជា ឲ្យ ពង្រឹង ប្រសិទ្ធភាព ប្រមូល ពន្ធ លើ រថយន្ត អត់ ពន្ធ ដែល នៅ សេសសល់ និង ត្រៀម បង្ក្រាប យ៉ាង ម៉ឹង ម៉ាត់ ក្រោយ ផុត ឱសានវាទ ត្រឹម ថ្ងៃ ៣១ ខែកក្កដា
( ភ្នំពេញ ) ៖ លោក គុណ ញឹម រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា នា ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ចេញ លិខិត ជម្រាប ជូន ប្រធាន នាយកដ្ឋាន សាខា និង ការិយាល័យ គយ និង រដ្ឋាករ អំពី ការពង្រឹង ប្រសិទ្ធភាព នៃ ការប្រមូល ពន្ធ និង អាករ លើ រថយន្ត គ្មាន ពន្ធ មាន ស្រាប់ ក្នុង ប្រទេស ដែល នៅ សេសសល់ ពិសេស គឺ ការត្រៀម យុទ្ធនាការបង្ក្រាប រថយន្ត គ្មាន ពន្ធ នា ពេល ខាងមុខ នេះ ។
ដើម្បី បង្កើន ប្រសិទ្ធភាព នៃ ការប្រមូល ពន្ធ និង អាករ លើ រថយន្ត គ្មាន ពន្ធ មាន ស្រាប់ ក្នុង ប្រទេស ដែល នៅ សេសសល់ ជាពិសេស នៅ ពេល ដែល ឱសានវាទ នៃ ការអនុញ្ញាតឱ្យ ម្ចាស់ រថយន្ត ចង្កូត ស្ដាំ គ្មាន ពន្ធ ចូលមក បង់ ពន្ធ ឬ ចុះបញ្ជី កាន់តែ ខិត ជិត មកដល់ លោក គុណ ញឹម បាន ណែនាំ ទៅកាន់ ប្រធាន នាយកដ្ឋាន សាខា និង ការិយាល័យ គយ និង រដ្ឋាករ យ៉ាង ដូច្នេះ ថា៖
១. ត្រូវ ផ្សព្វផ្សាយ ដល់ សាធារណជន តាម ភូមិសាស្ត្រ ទទួលខុសត្រូវ រៀង ៗ ខ្លួន ឱ្យ បាន ទូលំទូលាយ នូវ សេចក្ដីជូនដំណឹង របស់ អគរ ចុះ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២២ ។
២. ត្រូវ បន្ត ផ្ដល់ សេវា ទទួល បង់ ពន្ធ និង អាករ ជាពិសេស ការចុះបញ្ជី រថយន្ត ចង្កូត ស្ដាំ គ្មា ពន្ធ មាន ស្រាប់ ក្នុង ប្រទេស ឱ្យ បាន កាន់តែ សកម្ម និង ល្អប្រសើរ ។ ក្នុង ករណី ចាំបាច់ ត្រូវ បន្ថែម ម៉ោង រដ្ឋបាល រហូតដល់ ម៉ោង ៨៖០០ យប់ រួមទាំង ថ្ងៃសៅរ៍ ថ្ងៃអាទិត្យ ហើយ នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២ ដែល ជា ថ្ងៃ ចុងក្រោយ នៃ ការអនុញ្ញាតឱ្យ ម្ចាស់ រថយន្ត ចង្កូត ស្ដាំ គ្មាន ពណ្ធ នៅ សេសសល់ មក បំពេញ កាតព្វកិច្ច ពន្ធ អាករ ឬ ចុះបញ្ជី ត្រូវ ពន្យារ ការបិទ បញ្ចប់ ម៉ោង រដ្ឋបាល ត្រឹម ម៉ោង ១០៖០០ យប់ ។
៣. ចាប់ពី ថ្ងៃទី១ ខែសីហា ឆ្នាំ ២០២២ត ទៅ គ្រប់ អង្គភាព គយ និង រដ្ឋាករ ត្រូវ ប្រមូលផ្ដុំ និង ប្រើប្រាស់ កម្លាំង សមស្រប ដើម្បី អនុវត្ត យុទ្ធនាការ បង្ក្រាប ឱ្យ បាន សកម្ម និង ម៉ឹង ម៉ាត់ លើ រថយន្ត គ្មាន ពន្ធ គ្រប់ ប្រភេទ នៅ គ្រប់ មុខ សញ្ញា ដូចជា ទី សាធារណៈ ការដ្ឋាន និង មូលដ្ឋាន អាជីវកម្ម ជាដើម ។
គួរ ជម្រាប ថា អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន អនុញ្ញាតឱ្យ ម្ចាស់ រថយន្ត ចង្កូត ស្ដាំ គ្មាន ពន្ធ និង រថយន្ត គ្មាន ពន្ធ មាន ស្រាប់ ក្នុង ប្រទេស ដែល នៅ សេសសល់ ចូលមក បង់ ពន្ធ ឬ ចុះបញ្ជី ឱ្យ បាន គ្រប់ គ្នា ដោយ បាន ដាក់ ឱសានវាទ ទុក ពេល ត្រឹម ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០២២ ខាងមុខ ៕
ខាងក្រោម នេះ ជា លិខិត របស់ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា៖ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម៖ ក្នុង នាម ជា ប្រធាន អាស៊ាន កម្ពុជា ដាក់ ចេញ គំនិត ផ្ដួច ផ្ដើម មួយ ចំនួន ដើម្បី លើកកម្ពស់ ការធ្វើ សមាហរណកម្ម ឌីជីថល អាស៊ាន
( ភ្នំពេញ ) ៖ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន គូសបញ្ជាក់ ថា ក្នុង នាម ជា ប្រធាន អាស៊ាន នា ឆ្នាំ ២០២២ នេះ កម្ពុជា បាន ដាក់ចេញ នូវ គំនិត ផ្តួចផ្តើម មួយ ចំនួន ដើម្បី លើកកម្ពស់ ការធ្វើ សមាហរណកម្ម ឌីជីថល អាស៊ាន ។
« ក្នុង ឋានៈ ជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២២ កម្ពុជា បាន បង្កើត នូវ គំនិត ផ្ដួច ផ្ដើម មួយ ចំនួន ដើម្បី លើកកម្ពស់ ការធ្វើ សមាហរណកម្ម ឌីជីថល អាស៊ាន ដូចជា ការសិក្សា លទ្ធភាព ម៉ូដែល បញ្ជូន បច្ចេកវិទ្យា សម្រាប់ គម្រោង ពាក់ព័ន្ធ នឹង SDGs ក្នុង ដោះស្រាយ បញ្ហា ប្រឈម ពាក់ព័ន្ធ នឹង និរន្តរភាព និង ក្របខណ្ឌ សម្រាប់ ជំរុញ កំណើន នៃ Ecosystems សម្រាប់ អាជីវកម្ម ឌីជីថល ថ្មី ក្នុង តំបន់ អាស៊ាន » ។ នេះ ជា ការបញ្ជាក់ របស់ លោក ប៉ាន សូរស័ក្តិ ។
លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន បង្ហាញ ការជឿជាក់ ដែរ ថា សិក្ខាសាលា នេះ នឹង ផ្តល់ នូវ ឱកាស ដ៏ ល្អ មួយ ដល់ វា គ្មិន និង អ្នកចូលរួម មកពី ស្ថាប័ន រដ្ឋាភិបាល និង ឯកជន ពិភាក្សា ផ្លាស់ប្ដូរ យោបល់ គ្នា ទៅ វិញ ទៅ មក ដើម្បី ចូលរួមចំណែក ធ្វើឱ្យ សមាហរណកម្ម សេដ្ឋកិច្ច ឌីជីថល ក្នុង តំបន់ អាស៊ាន កាន់តែ ទូលំទូលាយ និង ប្រកបដោយ បរិយា បន្ន ៕ ទស្សនៈ មិត្ត អ្នកអាន៖ « តើ សហជីព បង្កើតឡើង ដើម្បី ការពារ បក្សពួក ឬ ការពារ ប្រយោជន៍ រួម ? »
( ភ្នំពេញ ) ៖ វា មិន មែន ជា រឿង ថ្មី ថ្មោង នោះ ទេ ដែល ក្រុម សហជីព ឬ សមាគម និង អង្គការ ក្រៅ រដ្ឋាភិបាល មួយចំនួន តែងតែ ធ្វើ សកម្មភាព ដើម្បី ការពារ ផលប្រយោជន៍ ក្រុម មនុស្ស ដែល ស្ថិត ក្នុង ក្របខណ្ឌ គ្របដណ្តប់ របស់ ខ្លួន ឬ ការពារ បុគ្គល និង ក្រុម មនុស្ស ដែល ជា ឧបករណ៍ បង្កើតឡើង ដោយ ក្រុម ប្រឆាំង ជាពិសេស បង្កើតឡើង ដោយ ពួក បរទេស ដើម្បី ប្រើប្រាស់ សំរាប់ ជា ប្រយោជន៍ យុទ្ធសាស្ត្រ នយោបាយ និង ភូមិសាស្ត្រ នយោបាយ ។
ហេតុ អ្វី បានជា គេ អាច និយាយ បាន យ៉ាង ដូច្នេះ ? ពីព្រោះ ក្រុមហ៊ុន ណាហ្គាវើល ដ៏ បាន សម្រេច បញ្ចប់ កិច្ចសន្យា ការងារ របស់ និយោជិត ជាង ៣០០ នាក់ ដោយ មូលហេតុ វិបត្តិ កូវីដ - ១៩ ។ វិបត្តិ សកល មួយ នេះ បាន ធ្វើឲ្យ មនុស្ស រាប់ សិប លាន នាក់ នៅលើ ពិភពលោក បាត់បង់ ការងារ ធ្វើ ។ « តើ អ្នកណា អាចតវ៉ា មិន ឲ្យ ក្រុមហ៊ុន កាត់បន្ថយ បុគ្គលិក បាន ? គឺ ប្រាកដជា គ្មាន ឡើយ » ។
វិធី តវ៉ា ស្រប ច្បាប់ មាន តែ មួយ គត់ ទោះជា នៅក្នុង ប្រទេស បិតា ប្រជាធិបតេយ្យ ណា ក៏ដោយ គឺ សុំឲ្យ ក្រុមហ៊ុន អនុវត្ត តាម គោលការណ៍ ច្បាប់ ស្តីពី ការបញ្ឈប់ កិច្ចសន្យា តាមរយៈ ការបង់ប្រាក់ អត្ថប្រយោជន៍ ផ្សេង ៗ ដល់ បុគ្គលិក ដែល ត្រូវ បញ្ឈប់ ពី ការងារ ។ ប្រសិនបើ ក្រុមហ៊ុន យល់ព្រម ផ្តល់ សំណង និង អត្ថប្រយោជន៍ នានា តាម ច្បាប់ ហើយ នោះ សហជីព គ្មាន ហេតុផល អ្វី ត្រូវ តវ៉ា ទៀត ឡើយ ។
កាលពី ចុង សប្តាហ៍ កន្លងទៅ បក្សពួក របស់ ឈឹម ស៊ី ថរ ឈ្មោះ យ៉ាង សោភ័ណ និង វន់ ពៅ បាន ចូលរួម ធ្វើ បាតុកម្ម ជាមួយ អតីត បុគ្គលិក ណាហ្គាវើល ដ៏ មួយ ក្តាប់ តូច ហើយ បាន ញុះញង់ ឲ្យ បាតុករ ទាំងនោះ បុក ទំលាយ របាំង សមត្ថកិច្ច ដោយ កំរោល រួចហើយ ពួកគេ នាំគ្នា ថត បង្ហោះ ចោទប្រកាន់ សមត្ថកិច្ច ថា បាន ប្រើ ហិង្សា លើ បាតុករ ។ ល្បិច អស់ នេះ ត្រូវបាន ប្រើ រាប់ សិប ឆ្នាំ មកហើយ និង ត្រូវបាន គេ ស្គាល់ អស់ ទៅ ហើយ ។
ក្នុង ស្ថានភាព បែប នេះ តើ អាជ្ញាធរ គួរ បណ្តោយ ឲ្យ ក្រុម នេះ បន្ត ធ្វើ ព្យុះភ្លៀង តទៅទៀត ដែរ ឬ យ៉ាងណា ? ប្រាកដជា មិន អាច ឡើយ ពីព្រោះ អាជ្ញាធរ មាន កាតព្វកិច្ច ត្រូវការពារ ប្រយោជន៍ សាធារណៈ មិន មែន ការពារ ប្រយោជន៍ បុគ្គល ឡើយ ជាពិសេស បុគ្គល និង ក្រុម មនុស្ស ដែល ប្រព្រឹត្ត សកម្មភាព បំពាន ច្បាប់ ។
ផ្ទុយទៅវិញ បើ អាជ្ញាធរ នៅតែ បន្ត អត់ធ្មត់ និង បណ្តែត បណ្តោយ ឲ្យ សកម្មភាព អនាធិបតេយ្យ បែប នេះ កើតមាន បន្ត ទៀត នោះ សង្គម ខ្មែរ និង មិន បាន ស្គាល់ សេចក្តីសុខសាន នោះ ឡើយ ៕
មន្ត្រី៖ ក្រុមហ៊ុន កែច្នៃ ចាប់ផ្ដើម បញ្ជាទិញ ត្រី ប្រាជា បន្ដ បន្ទាប់ ត្រៀម នាំចេញ ទៅ ប្រទេស ចិន លើក ដំបូង ៤០តោន នៅពេល ឆាប់ ៗ នេះ
