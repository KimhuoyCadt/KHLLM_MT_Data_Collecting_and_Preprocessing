( កំពង់ស្ពឺ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ ខេត្ត កំពង់ស្ពឺ បាន ចាប់ផ្តើម បើក ពិព័រណ៍ ពាណិជ្ជកម្ម លើក ទី១០ ក្នុង បំណង បំផុស ការគាំទ្រ និង លើកស្ទួយ ផលិតផល នៅក្នុង ខេត្ត ក៏ ដូចជា ផលិតផល របស់ ខ្មែរ ។
ពិព័រណ៍ នេះ ធ្វើឡើង ចាប់ពី ថ្ងៃទី ២២ ដល់ ថ្ងៃទី ២៤ ខែកក្កដា នៅ បរិវេណ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត កំពង់ស្ពឹ ។ ផលិតផល ខ្មែរ ជា អាហារ កែច្នៃ របស់ ប្រើប្រាស់ ផ្សេង ៗ ដែល ផលិត នៅក្នុង ខេត្ត កំពង់ស្ពឺ និង មកពី បណ្តា ខេត្ត មួយចំនួន ទៀត ត្រូវបាន ដាក់ បង្ហាញ នៅក្នុង ពិព័រណ៍ នេះ ។
លោក ប៉ាន សូរស័ក្តិ បាន លើកឡើង ថា ក្រសួង ពាណិជ្ជកម្ម តែងតែ យកចិត្តទុកដាក់ ក្នុង ការជំរុញ វិស័យ ពាណិជ្ជកម្ម ឱ្យ កាន់តែ រីកចម្រើន ដោយ បាន ធ្វើ កំណែទម្រង់ ស៊ីជម្រៅ ជាច្រើន ដូច ជា៖ ការកាត់បន្ថយ ចំណាយ រដ្ឋបាល ពង្រឹង ភាពប្រកួត ប្រជែង នៅលើ ទីផ្សារ បង្កើត បរិយាកាស ធុរកិច្ច ឱ្យ កាន់តែ ល្អ ប្រសើរ និង ខិតខំ ផ្តល់ សេវា សាធារណៈ និង បង្ខិត សេវា ឱ្យ មក កៀក នឹង ដៃ ប្រជាពលរដ្ឋ ដើម្បី សម្រួល ដល់ វិស័យ ឯកជន ដែល ត្រូវការបំពេញ ប្រតិបត្តិការ អាជីវកម្ម ។
មេបញ្ជាការ រង យោធភូមិភាគ ទី៥ ចុះ ពិនិត្យ លំហាត់ យុទ្ធ ដំណើរ ទ័ព វគ្គ ហ្វឹកហ្វឺន បំប៉ន ពង្រឹង វរសេនា តូច ថ្មើរជើង លេខ ៥១៣
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ឧត្តមសេនីយ៍ ទោ សេង ធារិន មេបញ្ជាការ រង នាយ សេនាធិការ យោធ ភូមិភាគ ទី៥ អម ដំណើរ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី សឹង្ហ ទុំ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ អញ្ជើញ ចុះ ពិនិត្យ លំហាត់ យុទ្ធ ដំណើរ ទ័ព នៃ វគ្គ ហ្វឹកហ្វឺន បំប៉ន ពង្រឹង វរសេនា តូច ថ្មើរជើង លេខ ៥១៣ ចំណុះ ឱ្យ កងពល តូច ថ្មើរជើង លេខ ៥១ ។
វគ្គ ហ្វឹកហ្វឺន នេះ បាន ចាប់ផ្តើម កាលពី ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២២ មាន រយៈពេល ៦១ ថ្ងៃ ។ លំហាត់ យុទ្ធ ដំណើរ ទ័ព នេះ មាន ចម្ងាយ ៧១ គីឡូម៉ែត្រ ។ ក្នុង នោះ ធ្វើដំណើរ ចល័ត ដោយ រថយន្ត ចម្ងាយ ៥១ គីឡូម៉ែត្រ និង ចល័ត ដោយ ថ្មើរជើង ចម្ងាយ ២១ គីឡូម៉ែត្រ និង ធ្វើ លំហាត់ ចល័ត វាយលុក ក្នុង ភូមិសាស្រ្ត ទីលាន បាញ់ គ្រាប់ ពិត កងពល តូច ថ្មើរជើង លេខ ៥១ ភ្នំ ផ្គាំ ស្រុក ស្វាយ ចេក ខេត្ត បន្ទាយមានជ័យ ។
លោក ឧត្តមសេនីយ៍ ទោ សេង ធារិន បាន លើកឡើង ថា ស្ថិត នៅក្នុង កាលៈទេសៈ ប្រទេស មាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ គឺជា ឱកាស មាស សម្រាប់ កងទ័ព ធ្វើ ការហ្វឹកហ្វឺន ពង្រឹង សមត្ថភាព ជំនាញ យុទ្ធ វិធី កងទ័ព ឱ្យ បាន ស្ទាត់ជំនាញ ធានា បាន ទាំង បរិមាណ គុណភាព ធានា បាន នូវ តួនាទី ភារកិច្ច ការពារ ជាតិ មាតុភូមិ និង ប្រជាជន ។
ក្នុង ឱកាស នោះ លោក មេបញ្ជការ រង នាយ សេនាធិការ បាន គូសបញ្ជាក់ ថា ក្រុមការងារ ហ្វឹកហ្វឺន ត្រូវ ត្រួតពិនិត្យ វាយតម្លៃ ឱ្យ បាន ច្បាស់លាស់ ចំពោះ សិក្ខាកាម ដែល ទទួលបាន និទ្ទេស ល្អ ត្រូវ ផ្តល់ ប័ណ្ណ សរសើរ លិខិត សរសើរ ប្រកបដោយ តម្លាភាព ដើម្បី កសាង ពង្រឹង គុណភាព នាយ ទាហាន បន្ត វេន ។
ទេសរដ្ឋមន្រ្តី បាន បន្ត ថា ធនធាន មាន ស្រាប់ របស់ អង្គការ HALO Trust សម្រាប់ ការបោសសម្អាត មីន នៅ ខេត្ត សៀមរាប បាន មក ពី ការចូលរួម គាំទ្រ ពី រដ្ឋាភិបាល និង ប្រជាជន នៃ សហរដ្ឋ អាមេរិក ចក្រភព អង់ អាល្លឺម៉ង់ ស្វីស និង អៀរឡង់ ។
ជាមួយគ្នា នេះ ដែរ ទេសរដ្ឋមន្រ្តី បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា កំពុង ខិតខំ ចលនា កៀរគរ ធនធាន ពី វិស័យ ឯកជន និង សប្បុរសជន សម្រាប់ បោសសម្អាត ផ្ទៃដី ដែល មាន មីន នៅ ទូទាំង ប្រទេស ដើម្បី អាច បំពេញ បាន នូវ គោលបំណង ដូច មាន ចែង ក្នុង ផែនការ យុទ្ធសាស្រ្ត ជាតិ សកម្មភាព មីន ២០១៨ - ២០២៥ និង ដើម្បី សម្រួល ដល់ ការរៀបចំ ផែនការ បែងចែក តំបន់ ប្រតិបត្តិការ និង ទំហំ ថវិកា សម្រាប់ បោសសម្អាត ។
( ភ្នំពេញ ) ៖ ដោយសារ នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ស្ថានភាព នៅលើ កំណាត់ ផ្លូវ លេខ ១១០ ត្រង់ ចំណុច ស្ពាន ព្រែក អ្នកតា វាំង ស្ថិត ក្នុង ភូមិ ព្រែក ថ្មី សង្កាត់ ព្រែក ថ្មី មាន ការបាក់ ស្រុត ដី នៅ គល់ ស្ពាន ផ្នែក ខាងជើង ឆៀង ខាងកើត ដូច្នេះ រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ ក៏ ជូនដំណឹង ពី ការបញ្ចៀស ចរាចរ រថយន្ត ដឹក ទំនិញ រថយន្ត ធុន ធ្ងន់ និង រថយន្ត ដឹក ដី ក្រួស ថ្ម ខ្សាច់ គ្រប់ ប្រភេទ ជា បណ្ដោះអាសន្ន សិន ។
សេចក្ដីជូនដំណឹង បាន បន្ត ថា ស្ថានភាព បាក់ ស្រុត ដី នៅ គល់ ស្ពាន ព្រែក អ្នកតា វាំង បែប នេះ អាច បង្កឲ្យ មាន គ្រោះថ្នាក់ ជា យថាហេតុ ចំពោះ រថយន្ត ដឹក ទំនិញ រថយន្ត ធុន ធ្ងន់ និង រថយន្ត ដឹក ដី ក្រួស ថ្ម ខ្សាច់ គ្រប់ ប្រភេទ ដែល ឆ្លងកាត់ ទីតាំង នេះ ។ បច្ចុប្បន្ន រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ បាន សហការ ជាមួយ ក្រុមការងារ បច្ចេកទេស ជំនាញ ដើម្បី ជួសជុល កែលម្អ ទីតាំង ដែល មាន ការបាក់ ស្រុត ខាងលើ ។
រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ ក៏ បាន ស្នើសុំ ឲ្យ ម្ចាស់ ក្រុមហ៊ុន ដឹកជញ្ជូន និង អ្នកបើកបរ រថយន្ត ដឹក ទំនិញ រថយន្ត ធុន ធ្ងន់ និង រថយន្ត ដឹក ដី ក្រួស ថ្ម ខ្សាច់ គ្រប់ ប្រភេទ បញ្ចៀស ការធ្វើចរាចរ ជា បណ្តោះអាសន្ន នៅលើ កំណាត់ ផ្លូវ លេខ ១១០ ត្រង់ ចំណុច ស្ពាន ព្រែក អ្នកតា វាំង ស្ថិត នៅក្នុង ភូមិ ព្រែក ថ្មី សង្កាត់ ព្រែក ថ្មី ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ តទៅ រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី ៕ ឥទ្ធិពល នៃ គុណ តម្លៃ វប្បធម៌ ចិន ទៅ លើ គោល នយោបាយ ការបរទេស បែប សន្តិភាព និយម របស់ ប្រទេស ចិន
( ភ្នំពេញ ) ៖ ការយល់ដឹង ត្រឹមត្រូវ និង ស៊ីជម្រៅ អំពី ឥរិយាបថ របស់ ប្រជាជាតិ មួយ ឬ ប្រទេស មួយ ទាមទារ នូវ ការយល់ដឹង ស៊ីជម្រៅ អំពី គុណ តម្លៃ វប្បធម៌ និង ប្រពៃណី ដែល មាន ឥទ្ធិពល ទៅ លើ ផ្នត់គំនិត និង ឥរិយាបថ របស់ ប្រជាជាតិ នោះ ឬ ប្រទេស នោះ បើ មិន ដូច្នោះ ទេ វិនិច្ឆ័យ របស់ យើង អាចនឹង មាន កំហុស ធ្ងន់ធ្ងរ ។ ដូចគ្នា នេះ ដែរ ដើម្បី ស្វែងយល់ ឲ្យបាន ត្រឹមត្រូវ និង ស៊ីជម្រៅ អំពី ឥរិយាបថ របស់ ចិន នៅក្នុង ទំនាក់ទំនង អន្តរជាតិ យើង ចាំបាច់ ត្រូវ ស្វែងយល់ អំពី គុណ តម្លៃ វប្បធម៌ ជា ប្រពៃណី របស់ ជនជាតិ ចិន ។
នៅក្នុង ចំណោម គុណ តម្លៃ ចម្បង ៗ ទាំងនេះ សុខដុម អាច ត្រូវ គេ ចាត់ទុក ថា ជា គុណ តម្លៃ ដែល មាន ឥទ្ធិពល ខ្លាំង ជាង គេ បំផុត ទៅ លើ គោល នយោបាយ ការបរទេស របស់ ចិន ។ ចំពោះ ជនជាតិ ចិន សុខដុម គឺជា ការធ្វើ ឯកភាពវូបនីយកម្ម នៃ ភាពខុសប្លែក គ្នា ជា ការបង្ក លទ្ធភាព ឲ្យ ភាពខុសប្លែក គ្នា អាច រួមរស់ នៅ ជាមួយគ្នា បាន ប្រកបដោយ សន្តិភាព ។ និយាយ ម្យ៉ាងទៀត សុខដុម សំដៅ ទៅ លើ ការរួមរស់ ជាមួយគ្នា និង រីកចម្រើន រុងរឿង ជាមួយគ្នា បើ ទោះបីជា ប្រជាជាតិ ឬ ប្រទេស ទាំងអស់ មាន វប្បធម៌ ប្រពៃណី ខុសប្លែក គ្នា ក៏ដោយ ។
នៅក្នុង ទំនាក់ទំនង អន្តរជាតិ អ្វី ដែល រដ្ឋាភិបាល ចិន ប្រាថ្នា ចង់បាន ខ្លាំង បំផុត គឺ ពិភពលោក មួយ ដែល មាន សុខដុម សន្តិភាព ស្ថិតស្ថេរ និង វិបុលភាព រួម រដ្ឋាភិបាល ចិន មិន ប្រាថា្ន ចង់បាន ពិភពលោក មួយ ដែល មាន ភាព ដូចគ្នា ទាំងស្រុង ដូច ដែល ប្រទេស បស្ចិម លោក ប្រាថ្នា ចង់បាន នោះ ឡើយ ។ និយាយ ម្យ៉ាងទៀត រដ្ឋាភិបាល ចិន ទទួលស្គាល់ និង ផ្ដល់ តម្លៃ ទៅ លើ ភាពខុសប្លែក គ្នា និង យល់ឃើញ ថា ប្រទេស ដែល មាន អរិយធម៌ ខុសប្លែក គ្នា អាច រួមរស់ នៅក្នុង សហគមន៍ សកលលោក នេះ ជាមួយគ្នា ដោយ សន្តិភាព ។
ដោយ ផ្អែក លើ គុណ តម្លៃ នេះ ប្រទេស ចិន តែងតែ គាំទ្រ និង លើកកម្ពស់ យន្តការ ពហុ ភាគី និយម នៅក្នុង ទំនាក់ទំនង អន្តរជាតិ ព្រមទាំង ប្រឆាំង គោល នយោបាយ ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ដ៏ ទៃ និង បង្ខិតបង្ខំ ប្រទេស ដទៃ ឲ្យ ធ្វើ ដូច ខ្លួន ។ គោល នយោបាយ សន្តិសហវិជ្ជមាន និង មិន ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ដទៃ ដែល ប្រទេស ចិន តែងតែ ប្រកាន់ខ្ជាប់ និង អនុវត្ត ជារៀងរហូតមក គឺជា អត្តសញ្ញាណ ដ៏ លេចធ្លោ មួយ របស់ ប្រទេស ចិន ដែល ត្រូវ គេ ស្គាល់ យ៉ាង ច្បាស់ នៅ ទូទាំង ពិភពលោក ។
អត្ថបទ ដោយ លោក សាស្រ្តាចារ្យ បណ្ឌិត នាក់ ចិន្ដារិទ្ធិ នាយក មជ្ឈមណ្ឌល កម្ពុជា សម្រាប់ ស្រាវជ្រាវ ផ្លូវ សូត្រ សមុទ្រ សតវត្សរ៍ ទី ២១ នៃ សកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ ឧត្តមសេនីយ៍ ឯក និង ឧត្តមសេនីយ៍ ត្រី ជូន នាយ ទាហាន ចំនួន ៨រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ ឧត្តមសេនីយ៍ ឯក និង ឧត្តមសេនីយ៍ ត្រី ជូន នាយ ទាហាន ចំនួន ៨រូប នៃ កងយោធពល ខេមរភូមិន្ទ ។
ក្នុង ព្រះរាជ ក្រឹត្យ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ឲ្យដឹង ថា នាយ ទាហាន ដែល ត្រូវបាន តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ ឧត្តមសេនីយ៍ ឯក ចំនួន ៧រូប និង ថ្នាក់ ឧត្តមសេនីយ៍ ត្រី ចំនួន ១រូប ៕
ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២២ ខែកក្កដា៖ បង្ក្រាប ១៨ករណី ឃាត់ខ្លួន ៥១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ជួញដូរ ៩ករណី . ចាត់ចែង សម្រួល ១ករណី . ដាំដុះ ១ករណី និង ដឹកជញ្ជូន រក្សាទុក ២ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥១ នាក់ ។
លោក សុខ ចិន្តា សោភា៖ អ្នក វិនិយោគ ចាប់អារម្មណ៍ សក្ដានុពល កម្ពុជា ខណៈ ឆមាស ទី១ គម្រោង ចំនួន ៩៨ ត្រូវបាន អនុម័ត ទុន វិនិយោគ ៣ពាន់ លាន ដុល្លារ
( ភ្នំពេញ ) ៖ លោក សុខ ចិន្តា សោភា រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ( ក. អ. ក) បាន គូសបញ្ជាក់ ថា អ្នក វិនិយោគ មាន ការចាប់អារម្មណ៍ ចំពោះ សក្ដានុពល វិនិយោគ នៅ កម្ពុជា ខណៈ រយៈពេល ៦ខែ ឆ្នាំ ២០២២ នេះ ការវិនិយោគ មាន ការកើនឡើង បើ ធៀប នឹង រយៈពេល ដូចគ្នា ឆ្នាំ ២០២១ ។
ឆមាស ទី១ ឆ្នាំ ២០២២ នេះ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន អនុម័ត គម្រោង ថ្មី និង គម្រោង ពង្រីក ផលិតកម្ម ចំនួន ៩៨ គម្រោង ដែល មាន ទុន វិនិយោគ សរុប ជាង ២ ៩៩៨ លាន ដុល្លារ បង្កើត ការងារ បាន ចំនួន ៧២ ៣២៩ កន្លែង ។ បើ ធៀប នឹង រយៈពេល ដូចគ្នា ឆ្នាំ ២០២១ ចំនួន គម្រោង វិនិយោគ កើនឡើង ចំនួន ១១គម្រោង ខណៈ ទុន វិនិយោគ កើនឡើង ចំនួន ២៩ លាន ដុល្លារ ។
លោក បញ្ជាក់ ថា ការចាប់អារម្មណ៍ មក វិនិយោគ នៅ កម្ពុជា ដោយសារ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន មាន វិធានការចាក់ វ៉ាក់សាំង ជូន បងប្អូន ប្រជាពលរដ្ឋ បាន ដល់ អត្រា ខ្ពស់ បំផុត ដែល ធ្វើឲ្យ មាន ភាពសុំា សហគមន៍ ។
លោក សុខ ចិន្តា សោភា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « អ្នក វិនិយោគ មាន ការចាប់អារម្មណ៍ ចំពោះ សក្ដានុពល កម្ពុជា ខ្ញុំ បាន ធ្វើការសរុប តួលេខ សម្រាប់ ឆមាស ទី១ នៃ ឆ្នាំ ២០២២ បាន ឲ្យ ឃើញ ថា បើ ប្រៀបធៀប នឹង ឆមាស ទី១ ឆ្នាំ ២០២១ មាន ភាពល្អ ប្រសើរ និង មាន ការកើនឡើង » ។
លោក បាន គូសបញ្ជាក់ ថា ការកើនឡើង នៃ ការវិនិយោគ គឺ ដោយសារតែ មាន វិធានការចាក់ វ៉ាក់សាំង របស់ រាជ រដ្ឋាភិបាល ជូន ប្រជាពលរដ្ឋ ប៉ុន្ដែ ការកើនឡើង នេះ បើ ប្រៀបធៀប នឹង ឆ្នាំ ដែល មិន ទាន់ មាន កូវីដ - ១៩ គឺ វា នៅ ទាប នៅឡើយ ។
ទោះជា ការវិនិយោគ មាន ការកើនឡើង ក្តី ប៉ុន្តែ លោក រដ្ឋមន្ត្រី បាន កត់សម្គាល់ ថា « ការវិនិយោគ ចាប់ផ្ដើម ងើប ហើយ ប៉ុន្តែ ទម្រាំ ទៅដល់ តួលេខ ដូច ពេល អត់ កូវីដ១៩ ត្រូវ រង់ចាំ រយ ពេល បនិ្ដច ប៉ុន្ដែ មាន ក្ដីសង្ឃឹម និង មាន សញ្ញា ល្អ ច្រើន » ។
លោក បាន បញ្ជាក់ ថា ចំពោះ វិបត្ដិ សង្គ្រាម រុស្ស៉ី - អ៊ុយក្រែន មិន មែន តែ កម្ពុជា នោះ ទេ គ្រប់ ប្រទេស ទាំងអស់ គឺ សុទ្ធតែ មាន ក្ដីកង្វល់ ហើយ ក្ដីកង្វល់ នោះ គឺ ការឡើង ថ្លៃ ប្រេង ធ្វើឲ្យ ឡើង ថ្លៃ ថាមពល . ឡើង ថ្លៃ ដឹកជញ្ជូន និង ឡើង ថ្លៃ ស្បៀង ជាដើ ម ។ អ្នក វិនិយោគ លើ ពិភពលោក តែងតែ មិន មាន សកម្មភាព នោះ ទេ នៅ ពេល ដែល មាន វិបត្ដិ សង្គ្រាម ព្រោះថា វា មិន អាច ប៉ាន់ប្រមាណ និង អត់ មាន អ្នកណា ហ៊ាន និយាយ ចំពោះ រយៈពេលវេលា ណាមួយ លើ សេដ្ឋកិច្ច យ៉ាង ម្ដេច នោះ ទេ ហើយ នេះ ជា អ្វី ដែល អ្នកវិនិយោគ ខ្លាច បំផុត ។
លោក សង្ឃឹម ថា វិបត្តិ នេះ នឹង មាន ការដោះស្រាយ ហើយ បើ ប្រសិនជា មាន ការធូរ ស្រាល ពី វិបត្តិ ពី ផល ប៉ះពាល់ ទៅ លើ សេដ្ឋកិច្ច ពិភពលោក នេះ កម្ពុជា បាន ត្រៀម ខ្លួន រួចហើយ សម្រាប់ ទទួល អ្នកវិនិយោគ ។
លោក រដ្ឋមន្ត្រី ប្រតិភូ បាន បញ្ជាក់ ទៀត ថា ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា នឹង បន្ត ខិតខំ ជំរុញ និង ទាក់ទាញ ការវិនិយោគ តាមរយៈ បន្ត ពង្រឹង យន្តការថែទាំ វិនិយោគ និង ការបន្ត ចូលរួម អនុវត្ត នូវ វិធានការ កែទម្រង់ នានា របស់ រាជ រដ្ឋាភិបាល ពិសេស វិធានការ ទាំងឡាយ ដែល សម្រួល ដល់ ការវិនិយោគ សម្រាប់ វិនិយោគិន ក្នុង និង ក្រៅ ប្រទេស ៕
លោក គួច ចំរើ ន៖ បេសកកម្ម ដោះ មីន នៅ ខេត្ត ព្រះសីហនុ រំដោះ ផ្ទៃដី ស្រែ ចំការ ពី ការគំរាមកំហែង ជា ឧបសគ្គ ដល់ ប្រជាពលរដ្ឋ និង អ្នកទេសចរណ៍
( ព្រះសីហនុ) ៖ នៅ ព្រឹក ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ អញ្ជើញ សំណេះសំណាល ជាមួយ មន្ត្រី បោសសម្អាត មីន ( ស៊ីម៉ាក ) ភាគ ខាងត្បូង នៅ ស្រុក កំពង់សីលា ដោយ មាន ការចូលរួម ពី អាជ្ញាធរ ស្រុក មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ ។
តាម របាយការណ៍ របស់ អង្គភាព បោសសម្អាត មីន ភាគ ខាងត្បូង បាន ឲ្យដឹង ថា ដំណើរការបាស សម្អាត មីន ប្រកបដោយ ជោគជ័យ ដោយសារ មាន ការគាំទ្រ គម្រោង ថវិកា ពី រដ្ឋាភិបាល ចិន ។ ក្រុមការងារ បោសសម្អាត មីន ដែល ប្រតិបត្តិការ ក្នុង ខេត្ត ព្រះសីហនុ មាន ចំនួន ៥ក្រុម មាន បុគ្គលិក សរុប ៣៦ នាក់ ក្នុង នោះ ស្រី ៤នាក់ ដែល បាន ចាប់ផ្ដើម ប្រតិបត្តិការ បោសសម្អាត មីន ចាប់ពី ថ្ងៃទី១ ខែមីនា ឆ្នាំ ២០២២ នឹង បញ្ចប់ ការបោះ សម្អាត មីន ទាំងស្រុង នៅ ត្រឹម ដំណាច់ ខែកក្កដា ឆ្នាំ ២០២២ ខាងមុខ ។
អង្គភាព បោសសម្អាត មីន ភាគ ខាងត្បូង សម្រេចបាន ការបោសសម្អាត គ្រាប់ មីន យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ លើ ផ្ទៃដី ចំនួន ១.៧៣៧ .០១៣ ម៉ែត្រ ការ៉េ ស្មើនឹង ១៧៣ ហិកតា រកឃើញ និង កម្ទេចចោល គ្រាប់ មីន បាន ចំនួន ៣៤ គ្រាប់ និង យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ ៩៣ គ្រាប់ ។ ទន្ទឹម នោះ ក្នុង ការបោសសម្អាត មីន ក្រុមការងារ បាន ជួប ឧបសគ្គ អាកាសធាតុ ភ្លៀង ខ្យល់ ស្ទើរតែ រាល់ ថ្ងៃ ចំការ មីន ភាគ ច្រើន ជា តំបន់ ភ្នំ ហើយ នៅ ឆ្ងាយ ពី ផ្លូវ មិន អាច ចូល ទៅដល់ ចំការ មីន ខ្លះ ធ្វើដំណើរ ដោយ ថ្មើរជើង ជាច្រើន គីឡូម៉ែត្រ ទៀតផង ។
ថ្លែង ក្នុង ឱកាស នោះ លោក គួច ចំរើន បាន នាំ នូវ ការសាកសួរ សុខទុក្ខ និង សេចក្តីនឹក រឭក ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ចំពោះ បុគ្គលិក ស៊ីម៉ាក ទាំង ៥ក្រុម ដែល បាន ដឹកនាំ បំពេញ ការងារ ក្នុង ភូមិសាស្រ្ត ខេត្ត ព្រះសីហនុ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ទៀត ថា ផ្ទៃដី ដែល បាន បោសសម្អាត មីន និង យុទ្ធភ័ណ្ឌ រួច នេះ ជួយ បង្កើន សេដ្ឋកិច្ច សង្គម ហើយ អ្នកទេសចរ លែង មាន ភាពភ័យខ្លាច ពី គ្រាប់ មីន ទៀត ។ ហើយ ប្រជាពលរដ្ឋ និង អ្នកទេសចរ អាច ដើរ ចូល ព្រៃ ឡើង ភ្នំ ក៏ ដូចជា ការទាក់ទាញ អ្នក វិនិយោគ នៅលើ ទឹកដី សុវណ្ណ ភូមិ របស់ យើង អាច បង្កើន ការងារ សម្រាប់ យុវជន របស់ យើង នា ពេល ខាងមុខ ។
បេសកកម្ម បោសសម្អាត មីន និង យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ គឺជា ការចូលរួមចំណែក លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ និង សេដ្ឋកិច្ច សង្គម ថែម ទៀត ។ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន យកចិត្តទុកដាក់ ដោះស្រាយ វិស័យ មីន លុបបំបាត់ គ្រាប់ មីន និង យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ ដែល បាន បង្ក គ្រោះថ្នាក់ ដល់ ប្រជាពលរដ្ឋ និង ដំណើរការ សេដ្ឋកិច្ច សង្គម ។
ការស្ទង់ ប្រជាមតិ ដែល មាន អ្នកចូលរួម ផ្តល់ ប្រជាមតិ សរុប ២៣ ពាន់ នាក់ បាន គ្របដណ្តប់ ប្រទេស ចំនួន ៩ ដូចជា ម៉ារ៉ុក ទុយនីស៊ី អ៊ីរ៉ាក់ ស៊ូ ដង់ លីប៊ី ហ៊្សក ដានី លី បង់ ម៉ូរី តានី និង ប៉ាឡេ ស្ទីន ជាដើម ។ អនុលោម តាម ការស្ទប់ ប្រជាមតិ លើក នេះ នៅ ដើម ខែកក្កដា អង្គការ Arab barometer បាន ចេញផ្សាយ របាយការណ៍ ពីរ ច្បាប់ លើ វេបសាយ របស់ ខ្លួន គឺ « ប្រជាធិបតេយ្យ នៃ មជ្ឈិមបូព៌ា និង អាហ្វ្រិក ខាងជើង » និង « មតិ របស់ សាធារណជន ចំពោះ ការប្រកួតប្រជែង រវាង ចិន និង អាមេរិក នៅ តំបន់ មជ្ឈិមបូព៌ា និង អាហ្វ្រិក ខាងជើង » ។
ទីបំផុត របាយការណ៍ បាន បូកសរុប ថា ដោយ មកពី ប្រទេស ចិន មិន មែន ជា ប្រទេស អាណានិគម នោះ ទេ ហើយក៏ មិន ដែល ជ្រៀត ជ្រែក ដោយ ផ្ទាល់ នូវ កិច្ចការ របស់ តំបន់ មជ្ឈិមបូព៌ា និង អាហ្វ្រិក ខាងជើង នោះ ដែរ ដូច្នេះ នៅពេល អនាគត មិន ជា យូរ ប៉ុន្មាន ប្រទេស ចិន ប្រហែល នឹង កាន់តែ មាន ប្រជាប្រិយភាព ជាង អាមេរិក ៕
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ បាន សម្តែង នូវ ការកោតសរសើរ និង អំណរ អរគុណ ចំពោះ អនុគណៈកម្មការ ក្រុមការងារ និង ស្ថាប័ន ជំនាញ ពាក់ព័ន្ធ ពិសេស នាយកដ្ឋាន អាស៊ាន ដែល បាន ខិតខំ ពុះពារ ក្នុង ការរៀបចំ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន (ADMM) លើក ទី ១៦ ឆ្នាំ ២០២២ ។
ការលើកឡើង របស់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ធ្វើឡើង នា ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០២២ ក្នុង ឱកាស ដែល សម្តេច បាន បើក កិច្ចប្រជុំ ដក បទពិសោធន៍ លើ ការរៀបចំ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន (ADMM) លើក ទី ១៦ កាលពី ខែមិថុនា ឆ្នាំ ២០២២ កន្លងទៅ នេះ ដោយ មាន អញ្ជើញ ចូលរួម ផងដែរ ពីសំណាក់ រដ្ឋលេខាធិការ អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ ( ខ. ភ. ម) និង អគ្គ នាយក អគ្គ នាយកដ្ឋាន រួមទាំង មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត នៅ ទីស្តីការ ក្រសួង ការពារ ជាតិ ។
នៅក្នុង ឱកាស នោះ អង្គប្រជុំ បាន តាមដាន ស្តាប់ នូវ របាយការណ៍ បូកសរុប របស់ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ អគ្គ នាយក អគ្គ នាយកដ្ឋាន នយោបាយ កិច្ចការ បរទេស និង ជា ប្រធាន អនុគណៈកម្មការរៀបចំ ខ្លឹមសារ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន (ADMM) លើក ទី ១៦ ។
បន្ទាប់ពី បាន ស្តាប់ នូវ របាយការណ៍ បូកសរុប របស់ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ រួច មក សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន លើកឡើង ថា ៦ខែ កន្លងមក នេះ ក្រសួង ការពារ ជាតិ និង ខ. ភ. ម មាន ការងារ ជាច្រើន ដែល ត្រូវ បំពេញ និង ទទួលបាន ជោគជ័យ គួរ ជា ទី មោទនៈ ក្រោយពី មាន ការថមថយ នូវ បញ្ហា ការរាត ត្បាត ជំងឺ កូវីដ១៩ កម្ពុជា បាន រៀបចំ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១៦ ឆ្នាំ ២០២២ ដោយ ផ្ទាល់ ដែល កន្លងមក នេះ នៅ បណ្តា ប្រទេស នានា ការរៀបចំ កិច្ចប្រជុំ ធ្វើឡើង ត្រឹមតែ តាម ប្រព័ន្ធ អនឡាញ ប៉ុណ្ណោះ ។
សម្តេច ពិជ័យ សេនា បាន បន្ត ថា ថ្ងៃ នេះ មាន រយៈពេល ១ខែ ហើយ ដែល កម្ពុជា រៀបចំ ធ្វើជា ម្ចាស់ ផ្ទះ ប្រធាន ប្តូរ វេន នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន (ADMM) លើក ទី ១៦ ឆ្នាំ ២០២២ កាលពី ខែមិថុនា កន្លងមក ចំ ពេល ដែល ស្ថានភាពសលក លោក និង តំបន់ មាន បញ្ហា ស្មុគស្មាញ បំផុត ជាក់ស្តែង បញ្ហា នៅ ប្រទេស មីយ៉ាន់ម៉ា និង បញ្ហា សង្គ្រាម រុស្ស៉ី - អ៊ុយក្រែន ជាដើម ៕
លោក Xi Jinping បាន សង្កត់ធ្ងន់ ថា យុវជន នៃ ប្រទេស នានា គួរ ផ្សព្វផ្សាយ គុណ តម្លៃ រួម របស់ មនុស្សជាតិ ស្តីពី សន្តិភាព អភិវឌ្ឍន៍ សមភាព យុត្តិធម៌ ប្រជាធិបតេយ្យ និង សេរីភាព ជំរុញ គំនិត ផ្តួចផ្តើម អភិវឌ្ឍន៍ សកល តាមរយៈ សកម្មភាព ជាក់ស្តែង ដើម្បី រួមចំណែក ដល់ ការអនុវត្ត របៀបវារៈ អភិវឌ្ឍន៍ ជា និរន្តរភាព ឆ្នាំ ២០៣០ នៃ អង្គការ សហ ប្រជាជាតិ រួមគ្នា ចារ ទំព័រ យុគសម័យ ថ្មី នៃ សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ នៃ យុវជន ពិភពលោក ៕
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ប្រគេន ទៀន វស្សា ដល់ វត្ត ចំនួន ៥ ក្នុង ឃុំ កោះ សូទិន ស្រុក កោះ សូទិន ខេត្ត កំពង់ចាម
( ភ្នំពេញ ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ស្រុក កោះ សូទិន ខេត្ត កំពង់ចាម និង លោកស្រី ទេព រង្ស៉ី ក៏ ដូចជា ថ្នាក់ដឹកនាំ ក្រសួង ព័ត៌មាន បាន នាំយក នូវ ទៀន ចំណាំ ព្រះវស្សា ព្រមទាំង ទេយ្យ ទាន និង បច្ច័យ យក ទៅ ប្រគេន ដល់ បណ្តា វត្ត ចំនួន ៥ ក្នុង ឃុំ កោះ សូទិន ខេត្ត កំពង់ចាម ។
ពិធី ប្រគេន ទៀន វស្សា នេះ ធ្វើឡើង នៅ ព្រឹក ថ្ងៃសុក្រ ទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នៅ វត្ត សិរី មង្គល ក្បាល កោះ ស្ថិត ក្នុង ភូមិ ទី ៣ ឃុំ កោះ សូទិន ខេត្ត កំពង់ចាម ដើម្បី ត្រៀម បម្រុង ចង្ហាន់ ទៀន ឬ ប្រេង វស្សា សម្រាប់ ព្រះសង្ឃ ដូន ជី ប្រតិបត្តិធម៌ និង សមាទាន សីល៍ តាម ទំនៀមទម្លាប់ ព្រះពុទ្ធ សាសនា ។
គួរ បញ្ចាក់ ដែរ ថា សម្រាប់ ពិធី បុណ្យ ចូល ព្រះវស្សា នា ឱកាស ឆ្នាំ នេះ លោក ខៀវ កាញារីទ្ធ ជាមួយ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក កោះ សូទិន ក៏ ដូចជា ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ ទាំង៨ ទូទាំង ស្រុក បាន នាំយក នូវ ទៀន វស្សា ទេយ្យ ទាន ទេយ្យ វត្ថុ និង បច្ច័យ ប្រគេន ដល់ គ្រប់ វត្ត ទាំង ២៧ ក្នុង ស្រុក កោះ សូទិន ខេត្ត កំពង់ចាម ក្នុង រដូវកាល ចូល ព្រះវស្សា រយៈពេល ៣ខែ ដើម្បី រួមចំណែក ទ្រទ្រង់ ដល់ ព្រះសង្ឃ ដែល គង់ នៅតែ ក្នុង វត្ត រៀនសូត្រ ធម៌ វិន័យ ផ្សេង ៗ ក្នុង រយៈពេល ៣ ខែ នៃ ការចូលកាន់ ព្រះវស្សា នេះ ។
ពិធី បុណ្យ ចូល ព្រះវស្សា គឺជា ពិធី បុណ្យ មួយ ដែល មាន សារៈសំខាន់ ក្នុង ព្រះពុទ្ធ សាសនា ជា ពេលវេលា ដ៏ សំខាន់ សម្រាប់ ភិក្ខុ សង្ឃ និង សាមណេ បាន រៀនធម៌ និង វិន័យ យ៉ាង ខ្ជាប់ ខ្លួន តាម ពុទ្ធ ឱវាទ ។ អ្នក មាន ជំនឿ ទៅ លើ ព្រះពុទ្ធ សាសនា តែងតែ នាំគ្នា ប្រារព្ធ ពិធី បុណ្យ ដោយ នាំយក ជាសាដក អង្ករ ភេសជ្ជៈ និង របស់ ប្រើប្រាស់ ផ្សេង ៗ ទៅ ប្រគេន ព្រះសង្ឃ តាម លទ្ធភាព ។
សម្រាប់ វត្ត អារាម នីមួយ ៗ ក្នុង រយៈពេល ៣ខែ ក្នុង រដូវ ធ្លាក់ ភ្លៀង មិន អនុញ្ញាតឲ្យ និមន្ត ទៅ ទី ឆ្ងាយ ដោយ ដាច់ រាត្រី ឆ្លង ថ្ងៃ នោះ ឡើយ លើកលែងតែ មាន ភារកិច្ច សំខាន់ ចាំបាច់ ដូចជា ឪពុក ម្តាយ ឈឺ ធ្ងន់ ឬ និមន្ត ទៅ សម្ដែង ធម៌ ជាដើម ដោយ តាំងចិត្ត ត្រលប់ មកវិញ ក្នុង រយៈពេល ៧ ថ្ងៃ ។ បុណ្យ ចូល ព្រះវស្សា ប្រារព្ធ ធ្វើឡើង ជារៀង រាល់ ឆ្នាំ ចាប់ពី ថ្ងៃ១ រោច ខែ អាសាធ ដល់ ថ្ងៃ ១៥ កើត ខែ អស្សុជ ។
នៅក្នុង ឱកាស នេះ ដែរ លោក ខៀវ កាញារីទ្ធ បាន នាំយក នូវ បាល់ទាត់ ប្រគល់ ជូន ដល់ ក្រុម កីឡា បាល់ទាត់ យុវជន ឃុំ កោះ សូទិន ចំនួន ២ក្រុម ទុក សម្រាប់ ហាត់ លេង បង្កើន សមត្ថភាព និង រិត ចំណង មិត្តភាព កិច្ចសហការ គ្នា ឲ្យបាន កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ។
ដោយឡែក នៅ ព្រឹក ថ្ងៃ ដដែល លោក ខៀវ កាញារីទ្ធ បាន អញ្ជើញ ទៅ សួរសុខទុក្ខ និង ជូន ថវិកា ដល់ លោក ម៉ៅ ណែត សមាជិក ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម ដែល មាន ជំងឺ ប្រចាំ កាយ កំពុង សម្រាក ព្យាបាល នៅ គេហដ្ឋាន ស្ថិត នៅក្នុង សង្កាត់ កំពង់ចាម ក្រុង កំពង់ចាម ៕
ក្រសួង ទេសចរណ៍ រៀបចំ កម្មវិធី ផ្សព្វផ្សាយ បង្ហាញ ផ្លូវ ទេសចរណ៍ កម្ពុជា នៅ ទីក្រុង កាន់ ធើ ប្រទេស វៀតណាម
សូម បញ្ជាក់ ថា កម្មវិធី ផ្សព្វផ្សាយ នេះ ទទួលបាន ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ពី រដ្ឋបាល ខេត្ត កាន់ ធើ និង ក្រុមហ៊ុន ទីភ្នាក់ងារ ទេសចរណ៍ នៃ ប្រទេស វៀតណាម ហើយ ភ្នាក់ងារ ទេសចរណ៍ ឥណ្ឌូនេស៊ី នឹង ជំរុញ កិច្ចសហប្រតិបត្តិការ រួមគ្នា ជាមួយ ក្រុមហ៊ុន Cambodia Angkor Air ក្នុង ការជំរុញ ការតភ្ជាប់ ជើងហោះហើរ ត្រង់ ពី ទីក្រុង កាន់ ធើ ទៅកាន់ កម្ពុជា ។
តាមរយៈ កម្មវិធី នេះ ក្រសួង ទេសចរណ៍ មាន ការរំពឹង ថា កម្ពុជា នឹង អាច ទាក់ទាញ ភ្ញៀវ ទេសចរ និង វិនិយោគិន វៀតណាម ឱ្យ មក ទស្សនា ប្រទេស កម្ពុជា « កម្ពុជា - ព្រះរាជាណាចក្រ អច្ឆរិយៈ សុវត្ថិភាព និង ភាពកក់ក្តៅ » កាន់តែ ច្រើន ឡើង នៅ ឆ្នាំ ២០២២ - ២០២៣ ដែល ជា ដំណាក់កាល ស្តារ ឡើងវិញ នៃ វិស័យ ទេសចរណ៍ ផងដែរ ៕ កម្លាំង នគរបាល ខេត្ត កណ្តាល និង រាជធានី ភ្នំពេញ រួមគ្នា បង្ក្រាប ចោរប្លន់ ប្រដាប់អាវុធ ១៣នាក់
( កណ្ដាល ) ៖ មុខ សញ្ញា ចោរប្លន់ ប្រដាប់អាវុធ ចំនួន ១៣នាក់ ក្នុង ចំណោម ១៥នាក់ ត្រូវបាន កម្លាំង នគរបាល ស្រុក កៀនស្វាយ សហការ ជាមួយ នគរបាល ក្រុង តាខ្មៅ រួម ជាមួយ នគរបាល ខណ្ឌ ច្បារអំពៅ តាម ប្រដេញ បង្ក្រាប ផ្អើល ពេញ ផ្លូវ និង ក្នុង ភូមិ ដែល មុខ សញ្ញា ក្រុម ចោរប្លន់ នេះ មិន ត្រឹមតែ ប្លន់ នោះ ទេ ក៏ប៉ុន្តែ ពួកគេ រកស៊ី ជួញដូរ ថ្នាំ ញៀន ផងដែរ ។
យោង តាម របាយការណ៍ របស់ នគរបាល ខេត្ត កណ្ដាល បាន រៀបរាប់ ថា ដោយ ទទួលបាន ការចង្អុលបង្ហាញ ពី ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត ស្នងការ នគរបាល ខេត្ត កណ្ដាល ព្រមទាំង ចុះ អនុវត្តន៍ ផ្ទាល់ ដោយ លោក វរសេនីយ៍ ឯក ឡាក់ ម៉េង ធី ស្នងការ រង បាន ធ្វើ ការស្រាវជ្រាវ តាម ប្រមាញ់ មុខ សញ្ញា ខាងលើ នេះ ក្រោយ បាន ប្លន់ នា ពេល កន្លងមក ហើយ ពួកគេ បាន មក ជាប់ អន្ទាក់ នគរបាល ស្រុក កៀនស្វាយ នៅលើ ដង ផ្លូវ ជាតិ លេខ ១ ហើយ ពួកគេ ដឹងខ្លួន ក៏ នាំគ្នា រត់ ប្រសាច គេច ខ្លួន ដល់ ខណ្ឌ ច្បារអំពៅ និង ក្រុង តាខ្មៅ ។
បើ តាម លោក វរសេនីយ៍ ឯក ឡាក់ ម៉េង ធី បាន ឱ្យដឹង ថា ហេតុការណ៍ ចាប់ខ្លួន នេះ បាន កើតឡើង នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ ដោយ ក្រោយ ទទួលបាន ដំណឹង ពី មុខ សញ្ញា ភ្លាម លោក បាន រាយការណ៍ បន្ទាន់ ទៅ ថ្នាក់ លើ ហើយ បាន ចុះ ដៃ ធ្វើការ តាម ប្រមាញ់ បក្ខពួក ចោរប្លន់ នេះ នៅ ស្រុក កៀនស្វាយ នៅ ពេល ដែល ក្រុម ចោរ បាន ជិះ តាម ផ្លូវ ជាតិ លេខ ១ ហើយ ពើបប្រទះ សមត្ថកិច្ច ក៏ រត់គេចខ្លួន តែ ត្រូវបាន នគរបាល ដេញ ប្រមាញ់ និង សហការ គ្នា ល្អ តាម ក្របួច យក បាន ចំនួន ១៣នាក់ និង រត់គេចខ្លួន ចំនួន ២នាក់ ។
ជនសង្ស័យ ទាំង នេះ រួម មាន៖
បន្ទាប់ពី សាកសួរ នាំ រួច ជនសង្ស័យ រួមទាំង វត្ថុតាង ត្រូវបាន បញ្ជូន ខ្លួន ទៅ តុលាការ ខេត្ត កណ្ដាល ល្ងាច នេះ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
នាយ ឧត្តមសេនីយ៍ សាស្រ្តាចារ្យ ជា តារា បញ្ជូន សិក្ខាកាម យោធា ជំនាន់ ទី ១៦ ជិត ១០០ នាក់ នៃ សាកលវិទ្យាល័យ ការពារ ជាតិ ចុះ សិក្សា លើ ទីលាន ជាក់ស្តែង នៅ ភូមិសាស្រ្ត ព្រៃ ភ្នំ ខេត្ត កំពត លើ មេរៀន កងពល ធំ ថ្មើរជើង វាយលុក ខ្មាំង
( កំពត) ៖ នៅ ថ្ងៃទី ២២ ខែ កក្កដា ឆ្នាំ ២០២២ នេះ និស្សិត វគ្គ បណ្តុះបណ្តាល ការពារ ជាតិ ជំនាន់ ទី ១៦ ចំនួន ៩៨ នាក់ នៃ សាកលវិទ្យាល័យ ការពារ ជាតិ បាន ចុះសិក្សា លើ ទីលាន ជាក់ស្តែង នៅ ភូមិសាស្រ្ត ព្រៃ ភ្នំ ខេត្ត កំពត លើ មេរៀន កងពល ធំ ថ្មើរជើង វាយលុក ខ្មាំង ។
ពិធី នេះ បាន ប្រព្រឹត្ត ធ្វើឡើង ក្រោម ការដឹកនាំ របស់ ឧត្តមសេនីយ៍ ទោ យិន ឆៃលី សាកលវិទ្យាធិការ រង សាកលវិទ្យាល័យ ការពារ ជាតិ និង ជា នាយក មហាវិទ្យាល័យ ការពារ ជាតិ និង ឧត្តមសេនីយ៍ ទោ រស់ សុគន្ធ យោធាចារ្យ ថ្មើរជើង ព្រមទាំង បុគ្គលិក នៃ មហាវិទ្យាល័យ ការពារ ជាតិ ។
ជា ការកត់សម្គាល់ សម្រាប់ សកលវិទ្យាល័យ ការពារ ជាតិ ដែល មាន នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ ជា តារា ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ទទួលបន្ទុក ជា សាកលវិទ្យាធិការ សាកលវិទ្យាល័យ ការពារ ជាតិ តែងតែ ចាត់ បញ្ជូន សិក្ខ កាម យោធា របស់ សកលវិទ្យាល័យ ចុះ ទៅ សិក្សា ជាក់ស្តែង នៅលើ ទីលាន ដើម្បី រៀន បន្ថែម ទៀត ក្រៅពី ទ្រឹស្តី នៅក្នុង សាលា ទាំង នេះ ជា ការពង្រឹង សមត្ថភាព របស់ សិក្ខាកាម កាន់តែ ប្រសើរឡើង ។
( ភ្នំពេញ ) ៖ លោក អ៉ិត សំហេង សមាជិក គណៈកម្មាធិការ កណ្តាល នៃ គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ឱ្យដឹង ថា តួនាទី របស់ យុវជន បាន ក្លាយជា កម្លាំង មួយ ក្នុង ការចូលរួម របស់ គណបក្ស ប្រជាជន កម្ពុជា នៅ គ្រប់ ទីកន្លែង ក៏ ដូចជា សន្ទុះ នៃ ការគាំទ្រ របស់ កម្មករ និយោជិត ក៏ រឹតតែ ធ្វើឲ្យ គណបក្ស នេះ មាន ប្រជាប្រិយភាព កាន់តែ ខ្លាំង ។
ការលើកឡើង បែប នេះ របស់ លោក អ៉ិត សំហេង ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ ស្តីពី លទ្ធផល នៃ សន្និបាត គណៈកម្មាធិការ កណ្តាល វិសាមញ្ញ របស់ គណបក្ស ប្រជាជន កម្ពុជា នា ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០២២ ។
លោក ប្រធាន ក៏ បាន គូសបញ្ជាក់ ពី សភាពការណ៍ ទូទៅ ដំណើរការ នៃ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ ដែល គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន ជ័យជម្នះ ភ្លូក ទឹក ភ្លូក ដី ដែល ជា ការឆ្លុះបញ្ចាំង ឲ្យ ឃើញ នូវ ការ ប្រើប្រាស់ សិទ្ធិ សេរីភាព ក្នុង ការជ្រើសរើស ថ្នាក់ដឹកនាំ របស់ ប្រជាពលរដ្ឋ ។
លោក បាន ថ្លែង ថា « ជាមួយនឹង តួនាទី របស់ យុវជន បាន ក្លាយជា កម្លាំង មួយ ក្នុង ការចូលរួម របស់ គណបក្ស នៅ គ្រប់ ទីកន្លែង ក៏ ដូចជា សន្ទុះ នៃ ការគាំទ្រ របស់ កម្មករ និយោជិត ក៏ រឹតតែ ធ្វើឲ្យ គណបក្ស មាន ប្រជាប្រិយភាពទទួលបាន ការគាំទ្រ កាន់តែ ខ្លាំង » ។
លោក ក៏ បាន កោតសរសើរ ដល់ មន្ត្រី គ្រប់ លំដាប់ថ្នាក់ របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដែល បាន បំពេញ តួនាទី កាតព្វកិច្ច ដោយ ការទទួលខុសត្រូវ បំផុត លើ ការចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ រហូតដល់ មាន មន្ត្រី ខ្លះ របស់ បក្ស ក៏ បាន ឆ្លង នូវ ជំងឺ នេះ ថែម ទៀត ទាំងនេះ សបញ្ជាក់ ពី កាយវិការ លះបង់ ប្រកបដោយ ការគោរព ស្រលាញ់ បំផុត របស់ មន្ត្រី របស់ បក្ស ហើយក៏ សូម មន្ត្រី ប្រជាជន បន្ត ចូលរួម អនុវត្ត និង ផ្សព្វផ្សាយ បន្ត ទៀត ចំពោះ អនុសាសន៍ ទាំង១០ ចំណុច របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ។
លោក អ៉ិត សំហេង ណែនាំ ដល់ សមាជិក គណៈកម្មាធិការ គណបក្ស ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ចូលរួម បន្ត ផ្សព្វផ្សាយ យុទ្ធនាការ ៩០ ថ្ងៃ របប ប្រាក់ សោធន សម្រាប់ កម្មករ និយោជិត នៃ វិស័យ ឯកជន ដែល ជា ការទន្ទឹងរង់ចាំ របស់ កម្មករ និយោជិត និង និយោជក នៃ បណ្តា រោងចក្រ សហគ្រាស គ្រឹះស្ថាន ដែល ស្ថិត នៅក្រោម បទប្បញ្ញត្តិ នៃ ច្បាប់ ស្តីពី ការងារ ហើយក៏ ជា ការឆ្លើយតប ទៅនឹង អ្វី ដែល រាជ រដ្ឋាភិបាល បាន សន្យា ខាង នយោបាយ ឲ្យបាន កាន់តែ ទូលំទូលាយ បន្ថែម ទៀត ៕
ប្រកាស ចូលកាន់ តំណែង អភិបាល រង ស្រុក ឆែប ខេត្ត ព្រះវិហារ . លោក ភីវ ឌៀន ជំនួស លោក ចាន់ លី ដែល ត្រូវ ផ្ទេភារកិច្ច ទៅកាន់ តំណែង ជា អភិបាល រង ស្រុក ជាំ ក្សាន្ត វិញ
( ព្រះវិហារ ) ៖ ប្រកាស ឱ្យ ចូលកាន់ តំណែង លោក ភីវ ឌៀន អតីត អភិបាល រង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ត្រូវបាន ប្រកាស ផ្ទេភារកិច្ច ឱ្យ ចូលកាន់ មុខតំណែង ជា អភិបាល រង ស្រុក ឆែប ខណៈ លោក ចាន់ លី អភិបាល រង ស្រុក ឆែប ឱ្យ ទៅ បម្រើ ជា អភិបាល រង ស្រុក ជាំ ក្សាន្ត ។
ពិធី នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ក្រោម វត្តមាន លោក យុង គឹម ហ៊ាន អភិបាល រង ខេត្ត ព្រះវិហារ តំណាង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ដោយ មាន ការចូលរួម ពី លោក ប្រធាន ក្រុមប្រឹក្សា ស្រុក លោក អភិបាល ស្រុក ឆែប ស្រុក ជាំ ក្សាន្ត ព្រមទាំង មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ និង អង្គភាព ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ។
ក្នុង នាម ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត ព្រះវិហារ លោក យុង គឹម ហាន បាន ស្នើសុំ ក្រុមប្រឹក្សា ស្រុក គណៈ អភិបាល ស្រុក ឆែប ពិសេស លោក អភិបាល រង ស្រុក ដែល ទើប ប្រកាស ចូលកាន់ តំណែង ថ្មី ព្រមទាំង មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ត្រូវ រក្សា ឱ្យ បាន សាមគ្គីភាព ផ្ទៃក្នុង សហការ ល្អ ក្នុង ការអនុវត្ត ការងារ សំខាន់ ៗ ដូច ខាងក្រោម៖
* ត្រូវ ចូលរួម អនុវត្ត តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា វិធានការ ការពារ របស់ ក្រសួង សុខាភិបាល ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ១៩ ជាពិសេស ជំងឺ បំលែង ថ្មី អូរ មីក្រុង ដោយ យកចិត្តទុកដាក់ លើ ការពង្រឹង ខឿន ការពារ សុខភាព ជូន ប្រជាពលរដ្ឋ អប់រំ ផ្សព្វផ្សាយ ពន្យល់ ប្រជាពលរដ្ឋ គ្រប់ រូបភាព ឱ្យ បាន ទូលំទូលាយ អំពី វិធានការ ទាំងឡាយ របស់ ក្រសួង សុខាភិបាល ពង្រឹង ជំនឿ ទុកចិត្ត របស់ ប្រជាជន ឱ្យ ចូល និង ជឿជាក់ លើ ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជាពិសេស គឺ ការមក ចាក់ ដូស ជំរុញ ។
* ត្រូវ បន្ត រួមគ្នា ថែរក្សា ការពារ សន្តិភាព ស្ថិរភាព នយោបាយ ស្ថិរភាព សង្គម ឱ្យ បាន ល្អ ប្រសើរ ដោយ លើកកម្ពស់ ការរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ នៅ ទូទាំង ស្រុក ។
* អំពី សកម្មភាព នានា ពាក់ព័ន្ធ និង សណ្តាប់ធ្នាប់ សាធារណៈ ត្រូវ បន្ត យកចិត្តទុកដាក់ រៀបចំ សោភ័ណ្ឌភាព សណ្តាប់ធ្នាប់ អនាម័យ ដូចជា ការប្រើប្រាស់ ផ្លូវ ចិញ្ចើមផ្លូវ សាធារណៈ ការគ្រប់គ្រង ការសាងសង់ ។
* បន្ត ជំរុញ ការអនុវត្ត កម្មវិធី កំណែទម្រង់ នានា របស់ រាជ រដ្ឋាភិបាល ឱ្យ មាន វឌ្ឍនភាព តាម ផែនការ កំណត់ ។ ពិសេស សូម ជួយ ផ្សព្វផ្សាយ ជំរុញ ណែនាំ និង បង្ករ លក្ខណះ ឱ្យ ប្រជាពលរដ្ឋ ក៏ ដូចជា គណបក្ស នយោបាយ នានា បាន ធ្វើ សកម្មភាព ស្រប ច្បាប់ ។
* ដើម្បី សម្រេចបាន នូវ អនុសាសន៍ ខាងលើ គណៈ អភិបាល ស្រុក ត្រូវ លើកកម្ពស់ ជាប្រចាំ នូវ របៀប របប បំពេញ ការងារ និង ការបែងចែក ភារកិច្ច គណៈ អភិបាល ដែល បាន កំណត់ ព្រមទាំង ពង្រឹង សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ឱ្យ បាន ល្អ ៕ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ចុះ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដូស ជំរុញ ជូន ដល់ សិស្សានុសិស្ស វិទ្យាល័យ សិរី សោភ័ណ
( បន្ទាយមានជ័យ )៖ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុជន កម្ពុជា នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ដូស ជំរុញ ជូន ដល់ សិស្សានុសិស្ស នៃ វិទ្យាល័យ សិរី សោភ័ណ ក្នុង ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ។
ពិធី នេះ មាន ការចូលរួមេ ពី លោក យឿន យឿត ទីប្រឹក្សា រាជ រដ្ឋាភិបាល កម្ពុជា ផងដែរ ។
លោក ហ្គូណា វ៉ា ដេណា ដែល ជា សមាជិក សភា មកពី គណបក្ស SLPP បាន ធ្វើ សច្ចា ប្រណិធាន ចូលកាន់ តំណែង របស់ លោក នៅក្នុង រដ្ឋធានី កូឡុំ បូ ក្រោម វត្តមាន លោក វីគ្រី មេ ស៉ីង ហ្កេ និង បណ្តា សមាជិក សភា ជាន់ ខ្ពស់ ដទៃ ៗ ទៀត ។ មន្រ្តី ជាន់ ខ្ពស់ មួយ រូប នៃ ការិយាល័យ ប្រធានាធិបតី ស្រីលង្កា បាន ប្រាប់ ថា គណៈ រដ្ឋមន្រ្តី ក៏ នឹង ត្រូវ ស្បថ ចូលកាន់ តំណែង នា ថ្ងៃសុក្រ នេះ ដូចគ្នា ផងដែរ ។
មន្ដ្រី ជាន់ ខ្ពស់ ធនាគារ ជាតិ៖ ជំនឿ ទុកចិត្ត ពី សាធារណជន លើ ប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ជា កត្តា ចម្បង ក្នុង ការរក្សា ចីរភាព គ្រឹះស្ថាន ហិរញ្ញវត្ថុ
( ភ្នំពេញ ) ៖ លោក គិត សុវណ្ណ រិទ្ធិ អគ្គ នាយក រង ត្រួតពិនិត្យ ទី១ នៃ ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើកឡើង ថា នឿ ទុកចិត្ត ពី សាធារណជន លើ ប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ជា កត្តា ចម្បង ក្នុង ការរក្សា ចីរភាព គ្រឹះស្ថាន ការបន្ត លើកកម្ពស់ បរិយា បន្ន ហិរញ្ញវត្ថុ នៅ កម្ពុជា ។
កិច្ចសហការ គ្នា នេះ ធ្វើឡើង ក្នុង គោលបំណង ពង្រឹង ការអនុវត្ត អាជីវកម្ម ប្រកបដោយ បរិយា បន្ន និង ការទទួលខុសត្រូវ ដោយ មើល ពី ជ្រុង នៃ ការគ្រប់គ្រង ហានិភ័យ ដើម្បី ជំរុញ នូវ កំណើន ប្រកបដោយ ការទទួលខុសត្រូវការ លើកកម្ពស់ ស្ថេរភាព វិស័យ ហិរញ្ញវត្ថុ និង បង្កើន ការ ការពារ អតិថិជន ។
លោក គិត សុវណ្ណ រិទ្ធិ បាន ថ្លែង ឲ្យដឹង ថា « ជំនឿ ទុកចិត្ត ពី សាធារណជន ក្នុង ការប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ផ្លូវការ ជា កត្តា ចម្បង ក្នុង ការរក្សា ចីរភាព គ្រឹះស្ថាន ការបន្ត លើកកម្ពស់ បរិយា បន្ន ហិរញ្ញវត្ថុ នៅ កម្ពុជា និង រក្សា ស្ថិរភាព ប្រព័ន្ធ ធនាគារ ទាំងមូល ហើយ កិច្ចការពារ អតិថិជន ក៏ ត្រូវបាន ចាត់ទុក ជា ការងារ អាទិភាព ដែល គ្រប់ ភាគី ពាក់ព័ន្ធ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ » ។
លោកស្រី Laura_Foose នាយក ប្រតិបត្តិ អង្គការ SPTF បាន ថ្លែង ថា « ចាប់តាំងពី អង្គការ SPTF បាន បង្កើតឡើង ក្នុង ឆ្នាំ ២០០៥ បាន ឃើញ ឥទ្ធិពល នៃ ការធ្វើ ការរួមគ្នា ដើម្បី លើកកម្ពស់ កិច្ចការ ស្វ័យ បញ្ញត្តិ ប្រកបដោយ ប្រសិទ្ធភាព ។ តាម ប្រទេស ដែល មាន ភូមិសាស្ត្រ និង វប្បធម៌ ខុស ៗ គ្នា ទីផ្សារ ហិរញ្ញវត្ថុ នឹង មាន សុខ មាលភាព ល្អ លុះត្រា អតិថិជន ទទួលបាន ការពារ នៅ ពេល ដែល អ្នក ផ្តល់ សេវា រួមគ្នា អនុវត្ត ក្រមសីលធម៌ និង ស្តង់ ប្រតិបត្តិការ ដូចគ្នា ព្រមទាំង ទទួលខុសត្រូវ ចំពោះ មុខ គ្នា ទៅ វិញទៅ មក » ។
លោកស្រី បាន បន្ដ ថា កិច្ច ខិតខំ ប្រឹងប្រែង នេះ ច ម្រេច ទៅ បាន លុះណាតែ មាន ការដឹកនាំ ដ៏ រឹងមាំ ព្រមទាំង ទទួលបាន ការគាំទ្រ ពី រាជ រដ្ឋាភិបាល ដូច្នេះ អង្គការ SPTF សូម ថ្លែងអំណរគុណ ចំពោះ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា និង ធនាគារ ជាតិ នៃ កម្ពុជា ចំពោះ ការប្តេជ្ញាចិត្ត សម្រេច ចំពោះ ចក្ខុវិស័យ រួម មួយ នេះ ។
លោក Nitin Madan បាន ថ្លែង ថា ភាពជាដៃគូ ថ្មី ដែល មាន តែ មួយ និង ដំបូង គេ បង្អស់ នេះ នឹង បង្កើត ជា ផែនទី ចង្អុល ផ្លូវ នាំ ដល់ ការរីកចម្រើន វិស័យ ហិរញ្ញវត្ថុ ប្រកបដោយ ទំនួល ខុសត្រូវ ស្ថិរភាព ហិរញ្ញវត្ថុ និង កិច្ច គាំពារ អតិថិជន ក្នុង វិស័យ មីក្រូ ហិរញ្ញវត្ថុ ក៏ ដូច វិស័យ ធនាគារ និង ហិរញ្ញវត្ថុ ទាំងមូល ផងដែរ ។
សមាគម និង សមាជិក របស់ ខ្លួន អាច ដាក់ពាក្យ ស្នើសុំ សហ ហិរញ្ញប្បទាន សម្រាប់ អនុវត្ត និង ពង្រឹង សមត្ថភាព លើ ការអនុវត្ត បរិយា បន្ន ហិរញ្ញវត្ថុ ប្រកបដោយ ការទទួលខុសត្រូវ ក្នុង ចំណោម ស្ថាប័ន ផ្តល់ សេវា ហិរញ្ញវត្ថុ ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ ។
លោក សុខ វឿន ប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា បាន ថ្លែង ថា « កិច្ចសហប្រតិបត្តិការ រវាង ស្ថាប័ន ទាំង ពីរ មាន គោលបំណង ពង្រឹង ការអនុវត្ត អាជីវកម្ម ប្រកបដោយ បរិយា បន្ន និង ការទទួលខុសត្រូវ ដោយ មើល ពី ជ្រុង នៃ ការគ្រប់គ្រង ហានិភ័យ ដើម្បី ជំរុញ នូវ កំណើន ប្រកបដោយ ការទទួលខុសត្រូវ ការលើកកម្ពស់ ស្ថេរភាព វិស័យ ហិរញ្ញវត្ថុ និង បង្កើន ការ ការពារ អតិថិជន » ។
( រតនគិរី ) ៖ លោក ម៉ុម សារឿន អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត រតនគិរី និង លោកស្រី គង់ សំអាត អម ដោយ លោក សេក ហៃ អភិបាល ស្រុក កូនមុំ និង ភរិយា ព្រមទាំង ពុទ្ធ បរិស័ទ មួយ ចំនួន នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន មូលមតិ គ្នា ប្រារព្ធ ពិធី បុណ្យ ដង្ហែ ទៀន ចំណាំ ព្រះវស្សា និង ទេយ្យ ទាន ផ្សេង ៗ វេរ ប្រគេន ព្រះសង្ឃ ចំនួន ១០វត្ត ក្នុង ស្រុក កូនមុំ ។
ព្រះតេជគុណ សេង ប៊ុន ធឿន ព្រះចៅ អធិការ វត្ត គិរី រតនា រាម ហៅ វត្ត ត្រពាំងក្រហម ស្ថិត នៅ ភូមិ ១ ឃុំ ត្រពាំងក្រហម ស្រុក កូនមុំ ខេត្ត រតនគិរី បាន មាន សង្ឃ ដីកា ថ្លែងអំណរគុណ ចំពោះ សមាណ សទ្ធា ជ្រះថ្លា មុតមាំ របស់ គណៈអធិបតី ស មីម្ចាស់ ទាន ដែល ជានិច្ចកាល តែង ជួយ ជ្រោមជ្រែង ព្រះពុទ្ធ សាសនា ដែល សាសនា របស់ រដ្ឋ ក្នុង ស្រុក កូនមុំ ក៏ ដូចជា វត្ត អារាម នានា ។
ព្រះតេជគុណ សូម បួងសួង ដល់ គុណ ព្រះរតនៈត្រ័យ ទេវរាជ ព្រហ្ម រាជ វត្ថុ ស័ក្កសិទ្ធឹ ក្នុង លោក ជួយ តាម បីបាច់ ថែរក្សា លោក លោកស្រី ស មីម្ចាស់ ទាន ប្រកប នូវ ពុទ្ធិ សិរី សួស្តី សុភមង្គល ត្រជាក់ ត្រជុំ គ្រប់ ក្រុមគ្រួសារ ឈ្នះ អស់ មារ រោគា ទាំងឡាយ អាយុ វណ្ណៈ សុខ ពល និង បដិភាណៈ កុំបី ឃ្លាង ឃ្លាត ឡើយ ៕ រដ្ឋបាល ក្រុង បាន លុង និង គណៈកម្មការ ផ្សារ ចុះ កាត់ សំយាប និង ទីតាំង លក់ដូរ ដែល រំលោភ ចូល តំបន់ ៤ ជុំវិញ ផ្សារ បាន លុង
ក្រុមការងារ ដែល ចុះ ប្រតិបត្តិការ ប្រាប់ ឲ្យដឹង ថា រយៈពេល ១ សប្តាហ៍ កន្លងមក នេះ រដ្ឋបាល ក្រុង បាន លុង បាន ជូន ដំណឹង ដល់ បងប្អូន ប្រជាពលរដ្ឋ អាជីវករ ដែល បាន និង កំពុង ប្រើប្រាស់ អាស្រ័យ ផល លើ តំបន់ លេខ ៤ ជុំវិញ ផ្សារ បាន លុង ធ្វើ ការរុះរើ ដោយ ស្ម័គ្រចិត្ត តែ ពួកគាត់ មិន យល់ព្រម ទើប ក្រុមការងារ មក អនុវត្ត ថ្ងៃ នេះ តែម្តង ។
ក្រុមការងារ ខាងលើ បន្ត ថា ការកាត់ សំយាប ផ្ទះ និង រើ ទីតាំង លក់ដូរ តំបន់ លេខ ៤ជុំវិញ ផ្សារ បាន លុង គឺ មាន ប្រវែង២.៥ម៉ែត្រ ពី ជញ្ជាំង ផ្ទះ ដោយ មាន កិច្ចសហការ គ្នា ល្អ រវាង ក្រុមការងារ និង ប្រជាពលរដ្ឋ អាជីវករ បាន យល់ព្រម ផ្តិត មេដៃ ធ្វើ កិច្ចសន្យា ដោយ ក្តីយោគយល់ គ្នា ។
ដោយឡែក លោក ជួន សុផល តំណាង ក្រុមហ៊ុន អន ចាន់ ណា វិនិយោគ តំបន់ លេខ ៤ជុំវិញ ផ្សារ បាន លុង ប្រាប់ ឲ្យដឹង ថា ក្រុមហ៊ុន បាន រៀបចំ តូប ឲ្យ ក្រុម អាជីវករ ចូល លក់ដូរ រួចរាល់ហើយ ដូច្នេះ ពួកគាត់ ត្រូវតែ ចូល លក់ ដើម្បី រក្សា បាន នូវ សណ្តាប់ធ្នាប់ . អនាម័យ . បរិស្ថាន . សោភ័ណ្ឌភាព នៅ ជុំវិញ ផ្សារ បាន លុង ឲ្យ មាន ផ្លូវ ចេញ ចូល ធំ ទូលាយ ពេល មាន ហានិភ័យ កើតឡើង ជាយថា ហេតុ អាច ឲ្យ រថយន្ត ពន្លត់ អគ្គិភ័យ ចូល ជួយ អន្តរាគមន៍ ទាន់ ពេល វេលា ។
គួរ បញ្ជាក់ ថា បន្ទាប់ពី លោក ញ៉ែ ម សំអឿន ទទួល តំណែង ជា អភិបាល ខេត្ត រតនគិរី បាន ចុះ ជួប សំណេះសំណាល និង សួរសុខទុក្ខ អាជីវករ ក្នុង ផ្សារ បាន លុង ព្រមទាំង បាន សន្យា ដោះស្រាយ បញ្ហា ប្រឈម នានា ដែល ជួបប្រទះ កន្លងមក ៕ គម្រោង ជួសជុល គ្រឹះ ក្រោម និង អ៊ុត កៅស៊ូ លើ ផ្លូវ កម្ពុជា ក្រោម ចាប់ពី ស្ពាន អាកាស ពេទ្យ លោកសង្ឃ ដល់ ផ្សារ ធំ ថ្មី នឹង បញ្ចប់ នៅ ថ្ងៃ ២៣ ខែកក្កដា នេះ
( ភ្នំពេញ ) ៖ គម្រោង ជួសជុល គ្រឹះ ក្រោម ជង្ហុក សំបុក មាន់ និង អ៊ុត កៅស៊ូ លើ ផ្លូវ កម្ពុជា ក្រោម ចាប់ពី ស្ពាន អាកាស ពេទ្យ លោកសង្ឃ ដល់ ផ្សារ ធំ ថ្មី គ្រោង បញ្ចប់ នៅ ថ្ងៃ ២៣ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ហើយ ដើម្បី សម្រួល ចរាចរ ជូន ប្រជាពលរដ្ឋ និង ដើម្បី ជា ការលើក សោភណ្ឌភាព រាជធានី ភ្នំពេញ យ កាន់តែ ស្រស់បំព្រង ។
មន្ត្រី នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ បាន ឲ្យដឹង នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២២ ថា អនុវត្ត តាម ការណែនាំ ពី លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ មន្ទីរ សាធារណការ រាជធានី ភ្នំពេញ បាន ជួសជុល គ្រឹះ ខាងក្រោម ឲ្យ រឹងមាំ ទើប អ៊ុត កៅស៊ូ ពីលើ កំណាត់ ផ្លូវ កម្ពុជា ក្រោម ទាំងស្រុង តែ ម្តង ដោយ ចាប់ពី ស្ពាន អាកាស ៧ មករា ( ស្ពាន អាកាស ពេទ្យ លោកសង្ឃ ) ដល់ ផ្សារ ធំ ថ្មី ដែល មាន ប្រវែង ជាង ៣គីឡូម៉ែត្រ ។
មន្ត្រី បាន បញ្ជាក់ ថា កំណាត់ ផ្លូវ កម្ពុជា ក្រោម នេះ ត្រូវ អ៊ុត កៅស៊ូ ទាំងស្រុង មាន ទទឹង ១៨ កន្លះ ទៅ១៩ ម៉ែត្រ ទៅ តាម ស្ថានភាព ផ្លូវ ជាក់ស្តែង ជាមួយ ការដាក់ បណ្តាញ លូ នៅ សងខាង ផ្លូវ ផងដែរ ដោយ បាន ចាប់ផ្តើម បើក ការដ្ឋាន ជួសជុល កាលពី ថ្ងៃទី ២៥ ខែឧសភា ឆ្នាំ ២០២២ កន្លងមក នេះ ហើយ គ្រោង បញ្ចប់ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ស្អែក នេះ ហើយ ៕ ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ រៀបចំ ផែនការ មេសំខាន់ ២ ពាក់ព័ន្ធ នឹង ការដឹកជញ្ជូន
ថ្លែង នា ឱកាស នោះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ក៏ បាន ជំរុញ លើកទឹកចិត្ត ឱ្យ អង្គប្រជុំ ផ្តល់ មតិ យោបល់ និង ធាតុ ចូល បន្ថែម ដើម្បី ធ្វើឱ្យ ប្រសើរឡើង ដល់ ផែនការ មេ ទាំង ពីរ ខាងលើ កាន់តែ មាន លក្ខណៈ គ្រប់ ជ្រុងជ្រោយ ផ្តល់ អត្ថប្រយោជន៍ ដល់ ប្រទេសជាតិ មាតុភូមិ និង អាច ទទួលយក បាន ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ។
លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន ណែនាំ ឱ្យ អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ ផ្តល់ ធាតុ ចូល ឱ្យ បាន ឆាប់ ទៅ លើ សេចក្តីព្រាង ផែនការ មេគ្រប់ ជ្រុងជ្រោយ ស្ដីពី ប្រព័ន្ធ ដឹកជញ្ជូន អន្តរ មធ្យោបាយ កម្ពុជា ឆ្នាំ ២០២២ - ២០៣០ ដែល រៀបចំឡើង ដោយ ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង បន្ថែម នូវ ចំណុច ដែល ខ្វះខាត នានា ដោយ ផ្អែក លើ ផែនការ មេ អន្តរកាល ដែល បាន អនុម័ត ជា ផ្លូវការ ដោយ ក្រុមប្រឹក្សា ជាតិ ភ័ស្តុភាកម្ម កាលពី ខែមករា ២០២០ ។
ការវាយប្រហារ លើ ទីក្រុង ខា កៀវ ដែល ធ្លាប់ រង នូវ ការ បាញ់ ផ្លោង ជាច្រើន សប្តាហ៍ របស់ រុស្ស៊ី បាន កើតមាន ជាថ្មី ទៀត រយៈពេល ១០ ថ្ងៃ បន្ទាប់ពី រុស្ស៉ី បាន បញ្ចប់ ការងារ ដំណើរការ នៃ បំពង់ បង្ហូរ ឧស្ម័ន Nord Stream-1 ។ បើ តាម អាជ្ញាធរ អ៊ុយក្រែន មនុស្ស ៣នាក់ ត្រូវបាន សម្លាប់ និង ២៣ នាក់ ទៀត បាន រងរបួស នៅ ទីក្រុង ខា កៀវ ជា កន្លែង ដែល ជន ស៉ី វិល មួយចំនួន បាន វិលត្រឡប់ ទៅ រក ជីវភាព រស់ នៅ ជាធម្មតា ឡើងវិញ បន្ទាប់ពី កងកម្លាំង អ៊ុយក្រែន បាន រុញ ច្រាន ទាហាន រុស្ស៊ី ឲ្យ ចេញ ពី ព្រំដែន របស់ ទីក្រុង នេះ ។
សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ប៉ៃលិន ក្រើន រំឮ ក ពលរដ្ឋ ឱ្យ សំអាត បរិស្ថាន ដើម្បី លុបបំបាត់ ជម្រក មូស ខ្លា គេច ផុត ពី ការចម្លង ជំងឺ គ្រុន ឈាម ទាំងអស់ គ្នា
លោកស្រី ពៅ សុខ ក៏ បាន ប្រាប់ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ប្រឹងប្រែង ធ្វើ អនាម័យ សំអាត ក្នុង បរិវេណ លំនៅដ្ឋាន របស់ ខ្លួន ពិសេស លុបបំបាត់ ឱ្យ អស់ នូវ សម្ភារ នានា ដែល ជា ប្រភព នៃ ជម្រក មូស ខ្លា ។
ជាមួយគ្នា នេះ លោកស្រី បាន បន្ត ថា មូស ខ្លា គឺជា ភ្នាក់ងារ ចម្លង ដ៏ មាន ប្រសិទ្ធិភាព នៃ ជំងឺ គ្រុន ឈាម វា អាច សម្លាប់ កុមារ តូច ៗ ក្នុង រយៈពេល ដ៏ ខ្លី ប្រសិនជា មាតាបិតា របស់ កុមារ មាន ការធ្វេសប្រហែស ឬ មិន បាន យកចិត្តទុកដាក់ នាំ ទៅ ឱ្យ ក្រុម គ្រូពេទ្យ ព្យាបាល ទាន់ ពេលវេលា ហើយ បច្ចុប្បន្ន ជំងឺ នេះ ក៏ បាន ចម្លង ទៅកាន់ មនុស្ស ចាស់ ផងដែរ ។
