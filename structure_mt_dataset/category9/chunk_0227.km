( ប៊ែរឡាំង ) ៖ ទីក្រុង ប៊ែរឡាំង បាន ចាប់ផ្តើម បិទ ភ្លើង ស្តុប បំភ្លឺ វិមាន ប្រវត្តិសាស្ត្រ របស់ ខ្លួន ដែល ជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ជាតិ ដើម្បី សន្សំ ថាមពល ប្រឈមមុខ នឹង ការខ្វះខាត ឧស្ម័ន របស់ រុស្ស៊ី ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន AFP នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៨ ខែកក្ដ ដា ឆ្នាំ ២០២២ ។
ការិយាល័យ របស់ លោក Jarasch បាន និយាយ ថា គោល នយោបាយ នេះ ដំបូង ឡើយ បាន ប៉ះពាល់ ដល់ វិមាន ប្រវត្តិសាស្ត្រ ចំនួន ៦កន្លែង ចាប់ពី យប់ ថ្ងៃពុធ ហើយ នៅ ទីបំផុត នឹង រួមបញ្ចូល អគារ ចំនួន ២០០ កន្លែង និង កន្លែង បំភ្លឺ ចំនួន ១. ៤០០កន្លែង ទៀត ក្នុង រយៈពេល បួន សប្តាហ៍ ខាងមុខ ៕
ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ ផែនការ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន AMM លើក ទី ៥៥
លើកឡើង នា ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន ណែនាំ ដល់ នាយ នាយ រង អាវុធហត្ថ ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ ឲ្យបាន ខ្ពស់ បំផុត ក្នុង កិច្ចការពារ សុវត្ថិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ ឲ្យបាន ល្អ ប្រសើរ ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ជូន ដល់ គណៈប្រតិភូ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន ដែល អញ្ជើញ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន (AMM) លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ដែល នឹង ប្រព្រឹត្តិ ទៅ នៅ រាជធានី ភ្នំពេញ ចាប់ពី ថ្ងៃទី ២៩ ខែកក្កដា ដល់ ថ្ងៃទី ៦ ខែសីហា ឆ្នាំ ២០២២ នា ពេល ខាងមុខ នេះ ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន ក្រើន រំលឹក ជាថ្មី ទៀត ដល់ សមាជិក ក្រោម ឱវាទ ទាំងអស់ បន្ត ចូលរួម បង្កា ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ប្រភេទ អូមី ក្រុង បំប្លែង ថ្មី ដែល កំពុង កើត មាន ឡើង គឺ ឆ្លង លឿន ឆ្លង រហ័ស និង ទាមទារ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ដោយ បន្ត អនុវត្ត នូវ វិធានការ « ៣កុំ ៣ការពារ » របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ការណែនាំ របស់ ក្រសួង សុខាភិបាល គ្រប់ ពេលវេលា និង គ្រប់ ទីកន្លែង ផងដែរ ៕
លោក ពុត ហេម៉ុណ្ណា គោរព អបអរសាទរ និង ជូនពរ ឯកឧត្តម ឈួន ដារ៉ា ក្នុង ឱកាស ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី
( ភ្នំពេញ ) ៖ លោក ពុត ហេម៉ុណ្ណា អគ្គ នាយក រង សេវា ពាណិជ្ជកម្ម សូម សម្តែង នូវ ក្តីអំណរ សាទរ ជា ពន់ពេក ជូន ចំពោះ ឯកឧត្តម ឈួន ដារ៉ា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម ក្នុង ឱកាស ឯកឧត្តម ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បន្ថែម លើ មុខងារ បច្ចុប្បន្ន ។
ក្នុង ឱកាស ដ៏ មហាន ក្ខត្ត ឫក្ស នេះ លោក ពុត ហេម៉ុណ្ណា សូម គោរព ជូនពរ ឯកឧត្តម ឈួន ដារ៉ា ទទួលបាន នូវ សុខភាព ល្អ បរិបូរណ៍ កម្លាំង ខ្លាំងក្លា ប្រាជ្ញា ឈ្លាសវៃ អាយុ យឺន យូរ និង សម្រេច ជោគជ័យ ថ្មី ៗ បន្ថែម ទៀត ដើម្បី រួមចំណែក ជួយ ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី សម្រេច នូវ ឧត្តម ប្រយោជន៍ សម្រាប់ ជាតិ និង ប្រជាជន ។
លោក ពុត ហេម៉ុណ្ណា គោរព បួងសួង សូម ឯកឧត្តម ឈួន ដារ៉ា និង ភរិយា ព្រមទាំង បុត្រា បុត្រី ជា ទីស្រឡាញ់ ជួប តែ សេចក្តីសុខ មង្គល ប្រកបដោយ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ឯកឧត្តម សំ សឿន និង ឯកឧត្តម សំ វីសូ គោរព អបអរសាទរ និង ជូនពរ ឯកឧត្តម ឈួន ដារ៉ា ក្នុង ឱកាស ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី
( ភ្នំពេញ ) ៖ ឯកឧត្តម សំ សឿន និង ឯកឧត្តម សំ វីសូ ទីប្រឹក្សា ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ សូម សម្តែង នូវ ក្តីអំណរ សាទរ ជា ពន់ពេក ជូន ចំពោះ ឯកឧត្តម ឈួន ដារ៉ា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម ក្នុង ឱកាស ឯកឧត្តម ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី បន្ថែម លើ មុខងារ បច្ចុប្បន្ន ។
ក្នុង ឱកាស ដ៏ មហាន ក្ខត្ត ឫក្ស នេះ ឯកឧត្តម សំ សឿន និង ឯកឧត្តម សំ វីសូ សូម គោរព ជូនពរ ឯកឧត្តម ឈួន ដារ៉ា ទទួលបាន នូវ សុខភាព ល្អ បរិបូរណ៍ កម្លាំង ខ្លាំងក្លា ប្រាជ្ញា ឈ្លាសវៃ អាយុ យឺន យូរ និង សម្រេច ជោគជ័យ ថ្មី ៗ បន្ថែម ទៀត ដើម្បី រួមចំណែក ជួយ ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី សម្រេច នូវ ឧត្តម ប្រយោជន៍ សម្រាប់ ជាតិ និង ប្រជាជន ។
ឯកឧត្តម សំ សឿន និង ឯកឧត្តម សំ វីសូ គោរព បួងសួង សូម ឯកឧត្តម ឈួន ដារ៉ា និង ភរិយា ព្រមទាំង បុត្រា បុត្រី ជា ទីស្រឡាញ់ ជួប តែ សេចក្តីសុខ មង្គល ប្រកបដោយ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
តាមរយៈ សេចក្តីថ្លែងការណ៍ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន គណបក្ស ខ្មែស្រឡាញ់ ជាតិ បាន លើកឡើង ថា មូលហេតុ នៃ ការរំលាយ គណបក្ស ខ្មែស្រឡាញ់ ជាតិ គឺ ដោយសារ ខ្លួន មើលឃើញ ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រទេស កម្ពុជា មាន សន្តិភាព ការអភិវឌ្ឍ និង អនាគត រុងរឿង ជាពិសេស កាលពី ថ្ងៃ ២៨ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណា ចក្រ កម្ពុជា គឺ បង្ហាញ យ៉ាង ច្បាស់ អំពី ការគិតគូរ ផលប្រយោជន៍ របស់ ជាតិ ជា ធំ ។
« ដូច្នេះ ពុំ មាន ហេតុផល ណាមួយ ដែល យើងខ្ញុំ នៅ បន្ត ប្រឆាំង នឹង ការដឹកនាំ របស់ សម្ដេច តេជោ និង គណបក្ស ប្រជាជន តទៅទៀត ទេ » ។ នេះ ជា ការបញ្ជាក់ របស់ គណបក្ស ខ្មែរ ស្រឡាញ់ ជាតិ ។
គួរ បញ្ជាក់ ថា កាលពី លោក បៃ ដិន នៅ មាន ឋានៈ ជា អនុប្រធានាធិបតី លោក បាន ចំណាយ ពេល ជាច្រើន ក្នុង ការពិភាក្សា ជាមួយ លោក ស៉ី នៅឯ សហរដ្ឋ អាមេរិក ក៏ ដូចជា នៅ ប្រទេស ចិន ។ ទោះបីជា យ៉ាងណា ក៏ដោយ អ្នក ទាំង២ មិន បាន ជួបគ្នា ដោយ ផ្ទាល់ ទេ ចាប់តាំងពី លោក បៃ ដិន បាន ក្លាយជា ប្រធានាធិបតី អាមេរិក កាលពី ឆ្នាំ ២០២១មក ។
ចំណែកឯ លោក ស៉ី ជិន ពីង វិញ បាន បាន ចាកចេញ ពី ចិន ដី គោក តែម្តង គត់ ដើម្បី ទៅកាន់ ទីក្រុង ហុងកុង ចាប់តាំងពី ជំងឺ រាតត្បាត COVID-19 បាន ចាប់ផ្តើម ។ ថ្មី ៗ នេះ ប្រធានាធិបតី ចិន រូប នេះ ក៏ បាន ទទួល ការអញ្ជើញ ជា ផ្លូវការធ្វើ ទស្សនកិច្ច ទៅកាន់ ឥណ្ឌូណេស៊ី ក្នុង ខែវិច្ឆិកា ខាងមុខ ដើម្បី ចូលរួម កិច្ចប្រជុំ កំពូល G20 ៕
សម្តេច តេជោ ហ៊ុន សែន អនុញ្ញាតឱ្យ មន្ត្រី ជាន់ ខ្ពស់ បក្ស កុម្មុយនិស្ត វៀតណា ចូល ជួប សម្តែង ការគួរសម
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសុក្រ ទី ២៩ ខែកក្កដា ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា អនុញ្ញាតឱ្យ លោក ដុ វ៉ាន់ ចៀន គណៈ លេខា មជ្ឈឹម បក្ស កុម្មុយនិស្ត វៀតណាម និង ជា ប្រធាន គណៈកម្មាធិការ មជ្ឈឹម រណសិរ្ស មាតុភូមិ វៀតណាម ដឹកនាំ គណៈប្រតិភូ ចូល ជួប សម្តែង ការគួរសម ។
លោកស្រី ហ្សាខារ៉ូវ៉ា បញ្ជាក់ ថា រដ្ឋមន្ត្រី ការបរទេស រុស្ស៊ី ក្នុង ពេល បច្ចុប្បន្ន « មាន កាលវិភាគ មមាញឹក ជាមួយ ទំនាក់ទំនង អន្តរជាតិ » រួមទាំង កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី របស់ អង្គការ សហប្រតិបត្តិការ សៀង ហៃ និង កិច្ចប្រជុំ ទ្វេ ភាគី មួយចំនួន ទៀត ។
គួរ បញ្ជាក់ អ្នកនាំពាក្យ ក្រសួង ការបរទេស អាមេរិក លោក ណេត ប្រាយ (Ned Price) បាន ឱ្យដឹង នៅក្នុង សន្និសីទ សារព័ត៌មាន មួយ ថា សហរដ្ឋ អាមេរិក កំពុង ស្វែងរក កិច្ចសន្ទនា រវាង រដ្ឋមន្ត្រី ការបរទេស នៃ ប្រទេស ទាំង២ ។ សហរដ្ឋ អាមេរិក នឹង យក កិច្ចសន្ទនា នេះ មក ពិភាក្សា លើ សំណើ ដ៏ ច្រើន របស់ ខ្លួន ស្តីពី ការដោះលែង ជនជាតិ អាមេរិក ដែល កំពុង ជាប់ ឃុំ ក្នុង ពន្ធនាគារ រុស្ស៉ី ៕
យ៉ាងណា ក៏ដោយ នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ សេតវិមាន បាន បញ្ជាក់ ថា លោក ចូ បៃ ដិន បាន ប្រាប់ ប្រធានាធិបតី ចិន ដែរ ថា គោល នយោបាយ អាមេរិក មិន បាន ផ្លាស់ប្ដូរ ឡើយ ហើយ ទីក្រុង វ៉ាស៊ីនតោន ប្រឆាំង ជាដាច់ខាត ទៅនឹង រាល់ ការព្យាយាម កែប្រែ ស្ថានភាព ដើម ដោយ ឯកតោ ភាគី ឬ បំផ្លាញ ដល់ សន្តិភាព និង ស្ថិរភាព នៅ ទូទាំង តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ ។
ព្រឹក នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ ព័ត៌មាន បង្ហាញ ពី សមិទ្ធផល សម្រេចបាន រយៈពេល ៥ ឆ្នាំ របស់ ក្រសួង ផែនការ
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២២ នេះ មាន រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « សមិទ្ធផល សម្រេចបាន រយៈពេល ៥ឆ្នាំ កន្លងមក របស់ ក្រសួង ផែនការ » នៅ វេលា ម៉ោង ៩៖៣០ នាទី ព្រឹក នាទី ស្តីការ គណៈ រដ្ឋមន្ត្រី សាល សេរីភាព ជាន់ ផ្ទាល់ ដី ។
វា គ្មិន កិត្តិយស ដែល នឹង អញ្ជើញ ចូលរួម៖ តំណាង ពី កស ក្រសួង ផែនការ ៕ កំណើន ភ្ញៀវ ទេសចរ បរទេស ជំរុញ សេដ្ឋកិច្ច របស់ ប្រទេស ថៃ នៅ ឆមាស ទី២ ឆ្នាំ នេះ
( បាងកក )៖ មន្ត្រី ជាន់ ខ្ពស់ របស់ ធនាគារ កណ្តាល ថៃ បាន ឱ្យដឹង ថា សេដ្ឋកិច្ច ថៃ នឹង បន្ត ងើប ឡើងវិញ នៅ ឆមាស ទី ពីរ ឆ្នាំ នេះ ដែល គាំទ្រ ដោយ សូចនាករ ផ្សេង ៗ ដូចជា ការប្រើប្រាស់ ឯកជន និង ការមកដល់ របស់ ភ្ញៀវ ទេសចរ បរទេស ជាដើម ។ នេះ បើ យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ។
ដោយសារ ការកើនឡើង ចំនួន អ្នកធ្វើដំណើរ បរទេស ក្នុង ខែមិថុនា មាន ចំនួន ៧៦៥ ៥០០ នាក់ ពោលគឺ កើនឡើង ពី ៥២០ ០០០ នាក់ កាលពី ខែឧសភា ចំនួន ភ្ញៀវ ទេសចរ សម្រាប់ រយៈពេល ពេញ មួយ ឆ្នាំ អាច ខ្ពស់ ជាង ការព្យាករ នា ពេល បច្ចុប្បន្ន របស់ ធនាគារ កណ្តាល ដែល ថា មាន ចំនួន ៦លាន នាក់ ។
ទោះជា យ៉ាងណា លោកស្រី បន្ថែម ថា ធនាគារ កណ្តាល ថៃ ក៏ នឹង កំពុង តាមដាន យ៉ាង ដិតដល់ ផងដែរ ទៅ លើ ស្ថានភាព សេដ្ឋកិច្ច សកល និង ក្នុង ស្រុក ក្នុង គ្រា ដែល មាន ភាព មិន ប្រាកដប្រជាមួយចំនួន ។
ការិយាល័យ គោល នយោបាយ សារពើពន្ធ (FPO) របស់ ក្រសួង ហិរញ្ញវត្ថុ ថៃ បាន ឱ្យដឹង កាលពី ថ្ងៃអង្គារ ថា ខ្លួន បាន រក្សា ការព្យាក កំណើន សេដ្ឋកិច្ច នៅ ឆ្នាំ នេះ ក្នុង អត្រា ជា មធ្យម ៣.៥% ដដែល ដែល ត្រូវបាន គាំទ្រ ដោយ ការស្ទុះ ងើប ឡើងវិញ ទាំង ក្នុង វិស័យ ទេសចរណ៍ និង ការប្រើប្រាស់ ក្នុង ស្រុក ។
ប្រទេស ដែល មាន ប្រទេស ជន ចំនួន ២២លាន នាក់ នេះ បច្ចុប្បន្ន កំពុង គ្របដណ្តប់ ដោយ វិបត្តិ សេដ្ឋកិច្ច និង នយោបាយ ធ្ងន់ធ្ងរ បំផុត របស់ ខ្លួន នៅក្នុង ប្រវត្តិសាស្ត្រ ថ្មី ៗ ។
ប្រទេស នេះ ជំពាក់ បំណុល របស់ ទីក្រុង ប៉េកាំង ប្រមាណ ៦.៥ប៊ីលាន ដុល្លារ រួមទាំង កម្ចី ធនាគារ អភិវឌ្ឍន៍ នានា និង ការដោះដូរ រូបិយប័ណ្ណ របស់ ធនាគារ កណ្តាល ផងដែរ ។ នេះ បើ យោង តាម ទិន្នន័យ ពី វិទ្យាស្ថាន ហិរញ្ញវត្ថុ អន្តរជាតិ (IFF) ។
ប្រទេស ដែល មាន សេដ្ឋកិច្ច ធំ ទី ពីរ ក្នុង ពិភពលោក មួយ នេះ បាន វិនិយោគ លើ គម្រោង នានា ដូចជា ផ្លូវ ហាយវេ កំពង់ផែ ព្រលានយន្តហោះ និង រោងចក្រ ថាមពល ធ្យូងថ្ម ។ ប្រទេស ជប៉ុន និង ឥណ្ឌា ក៏ ជា ម្ចាស់ បំណុល ទ្វេ ភាគី របស់ ស្រីលង្កា ផងដែរ ។
