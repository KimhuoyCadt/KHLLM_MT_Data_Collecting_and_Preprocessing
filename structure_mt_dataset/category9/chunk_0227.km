ព្រឹក នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ ព័ត៌មាន បង្ហាញ ពី សមិទ្ធផល សម្រេចបាន រយៈពេល ៥ ឆ្នាំ របស់ ក្រសួង ពាណិជ្ជកម្ម
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០២២ នេះ មាន រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « សមិទ្ធផល សម្រេចបាន រយៈពេល ៥ឆ្នាំ កន្លងមក របស់ ក្រសួង ពាណិជ្ជកម្ម » នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី សាល សេរីភាព ជាន់ ផ្ទាល់ ដី ។
សន្និសីទ សារព័ត៌មាន នេះ ប្រព្រឹត្ត ឡើង ក្នុង គោលបំណង ដើម្បី ផ្សព្វផ្សាយ ជូន សាធារណជន អំពី ការប្រឹងប្រែង របស់ ក្រសួង ពាណិជ្ជកម្ម ដែល សម្រេចបាន សមិទ្ធផល ជា វិជ្ជមាន និង ផលប្រយោជន៍ សំខាន់ ៗ ជាច្រើន គួរ កត់សម្គាល់ ដែល ប្រជាពលរដ្ឋ ទទួលបាន ក្រោម ការដឹកនាំ ដ៏ ប៉ិនប្រសប់ ប្រកបដោយ ថាមពល របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
វា គ្មិន កិត្តិយស ដែល នឹង អញ្ជើញ ចូលរួម៖ តំណាង ពី កស ក្រសួង ពាណិជ្ជកម្ម ៕ ទស្សនា បណ្តុំ រូបភាព សំខាន់ ៗ ស្តីពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ !
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ មាន ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន ។ ១៖ សហរដ្ឋ អាមេរិក អះអាង ថា រុស្ស៉ី ចាប់ផ្ដើម កាត់ យក ទឹកដី អ៊ុយក្រែន បញ្ចូល ក្នុង ឧបសម្ព័ន្ធ របស់ ខ្លួន
២៖ ភ្លើង ឆេះ ព្រៃ ឆេះ រាលដាល ក្រោយ សីតុណ្ហភាព នៅ ចក្រភព អង់គ្លេស ហក់ ឡើង ខ្ពស់ ជាង ៤០ អង្សា សេ ជា លើក ដំបូង
៣៖ ម៉ាឡេស៊ី នឹង មិន ក្ស័យ ធន ដូចជា ស្រីលង្កា ឡើយ . នេះ បើ តាម រដ្ឋមន្ត្រី ហិរញ្ញវត្ថុ ម៉ាឡេស៊ី
៤៖ សភា ស្រីលង្កា ចាប់ផ្តើម បោះឆ្នោត ដើម្បី ជ្រើសរើស ប្រធានាធិបតី ថ្មី
៦៖ បេក្ខជន ប្រកួតប្រជែង ដើម្បី ក្លាយ នាយក រដ្ឋមន្រ្តី អង់គ្លេស ថ្មី ជម្រុះ មក នៅ ត្រឹម ៣នាក់ ស្ត្រី ជនជាតិ វៀតណាម ម្នាក់ ធ្លាក់ ពីលើ អាគារ ជាន់ ទី២៥ ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុ ក្នុង ក្រុង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ ព័ត៌មាន បឋម នៅ វេលា ម៉ោង ៥: ៣០ នាទី ល្ងាច ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ មាន ករណី មួយ បាន កើតឡើង និង បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល ដោយ ស្ត្រី ជនជាតិ វៀតណាម ម្នាក់ ធ្លាក់ ពីលើ អាគារ ជាន់ ទី២៥ បណ្តាលឲ្យ ស្លាប់ បាត់បង់ជីវិត ភ្លាម ៗ នៅ និង កន្លែង កើត ហេតុ ។
ករណី នេះ កើតឡើង ស្ថិត អាគារ ស្នាក់នៅ របស់ បុគ្គលិក កាស៊ីណូ ប៉ឡាយ នៅក្បែរ ស្ពាន ស្តេច មឹក ស្ថិត ក្នុង ភូមិ ០៤ សង្កាត់ ០៤ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
សមត្ថកិច្ច បាន បាន រាយការណ៍ មក ថា សព ខាងលើ គឺជា ស្ត្រី ជនជាតិ វៀតណាម ហើយ បាន ធ្លាក់ ពីលើ អាគារ ជាន់ ទី២៥ មកដល់ ដី បណ្តាលឲ្យ ស្ត្រី ខាងលើ ដាច់ខ្យល់ស្លាប់ ភ្លាម ៗ ។
ភ្លាម ៗ នេះ សមត្ថកិច្ច នៅ ពុំ ទាន់ អាច បញ្ជាក់ ថា ស្ត្រី ជនជាតិ វៀតណាម ខាងលើ ធ្លាក់ ដោយសារ មូលហេតុ អ្វី នៅឡើយ ទេ ដោយ បច្ចុប្បន្ន រងចាំ សមត្ថកិច្ច ជំនាញ មក ពិនិត្យ កោសល្យវិច្ច័យ សាកសព រួចរាល់ និង ផ្តល ព័ត៌មាន លម្អិត តាម ក្រោយ ៕
ការតវ៉ា បាន ផ្ទុះឡើង នៅ ទីក្រុង កូឡុំ បូក្នុង ខែមីនា ហើយ បាន រីករាលដាល ពាសពេញ ប្រទេស ចាប់តាំងពី ប្រជាជន បាន ជួប បញ្ហា ជាមួយនឹង ការដាច់ចរន្ត អគ្គិសនី ប្រចាំ ថ្ងៃ និង ការខ្វះខាត ទំនិញ ជា មូលដ្ឋាន ដូចជា ប្រេងឥន្ធនៈ អាហារ និង ថ្នាំ ពេទ្យ ដោយសារ ទុន បម្រុង រូបិយប័ណ្ណ បរទេស របស់ ប្រទេស នេះ បាន អស់ ដែល ធ្វើឱ្យ ប្រទេស នេះ មិន អាច ទូទាត់ បាន សម្រាប់ ការនាំចូល ។
លោក បាន បន្ដ ថា បញ្ហា ទាំងនេះ បាន និង កំពុង បង្ក ការប៉ះទង្គិច ដល់ ខ្សែ ច្រវាក់ ផលិតកម្ម សកល ដាក់ សម្ពាធ មក លើ អត្រា អតិផរណា ពិភពលោក និង បង្កើន លំហូរ ចេញ នៃ មូលធន ពី ប្រទេស កំពុង លូតលាស់ និង កំពុង អភិវឌ្ឍន៍ ដែល នឹង ដាក់ សម្ពាធ បន្ថែម លើ តម្លៃ រូបិយប័ណ្ណ និង ទុន បម្រុង អន្តរជាតិ នៅក្នុង ប្រទេស ទាំងនោះ ។
លោក បញ្ជាក់ ថា « ទោះ យ៉ាងណា សកម្មភាព សេដ្ឋកិច្ច កម្ពុជា ត្រូវបាន រំពឹង ដោយ សុទិដ្ឋិនិយម ថា បន្ត ងើបឡើង ប្រមាណ ៥.៣% ខ្ពស់ ជា ឆ្នាំ ២០២១ ដែល មាន កម្រិត ៣% ដែល គាំទ្រ ជា ចម្បង ដោយ កំណើន ការនាំចេញ នៃ វិស័យ កម្មន្ត សាល កំណើន វិស័យ សំណង់ និង អចលន ទ្រព្យ និង កសិកម្ម ជាមួយនឹង ការងើបឡើង សន្សឹម ៗ នៃ វិស័យ ទេសចរណ៍ » ។
លោក ជា ចាន់តូ បាន បន្ដ ទៀត ថា ស្ថានភាពអត្រា អតិផរណា មាន ភាព មិន ប្រាកដប្រជា ខ្ពស់ ដោយ អាស្រ័យ ជា ចម្បង លើ ឥទ្ធិពល នៃ ការអូស បន្លាយ សង្រ្គាម រុស្ស៊ី - អ៊ុយក្រែន ទៅ លើ ថ្លៃ ប្រេង និង ការអនុវត្ត វិធាន បិទ ខ្ទប់ តំបន់ ផលិតកម្ម នៅ ប្រទេស ចិន ដើម្បី ទប់ស្កាត់ ការរាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។ ជាមួយនឹង ការរំពឹងទុក ថា ថ្លៃ ប្រេង នឹង ថយចុះ អតិផរណា ក៏ ត្រូវបាន ព្យាករ ថា ថយចុះ ផងដែរ នៅ ឆមាស ទី២នេះ ។
លោក ជា ចាន់តូ បាន បញ្ជាក់ ថា ក្នុង ស្ថានភាព ប្រកបដោយ បញ្ហា ប្រឈម ខាងលើ នេះ សូម លើកឡើង នូវ មតិ ផ្តាំផ្ញើ មួយចំនួន សម្រាប់ ជា ទិសដៅ ការងារ ដែល នឹង ត្រូវ អនុវត្ត ដូចត ទៅ៖
១៖ ការបន្ត រក្សា ស្ថិរភាព អត្រា ប្តូរ ប្រាក់៖ ដោយសារ ប្រាក់ ដុល្លារ អាមេរិក មាន និន្នាការ ឡើង ថ្លៃ នៅលើ ទីផ្សារ អន្តរជាតិ ប្រាក់ រៀល នឹង បន្ត ប្រឈម នឹង សម្ពាធ ធ្លាក់ ថ្លៃ ដូច្នេះ ធនាគារ ជាតិ នៃ កម្ពុជា នឹង បន្ត ប្រើប្រាស់ ឧបករណ៍ នយោបាយ រូបិយវត្ថុ ចាំបាច់ នានា ក្នុង ការរក្សា តម្លៃ ប្រាក់ រៀល ឱ្យ មាន ស្ថិរភាព ដើម្បី ការពារ អំណាច ទិញ របស់ រូបិយវត្ថុ ជាតិ ក៏ ដូចជា ប្រាក់ ចំណូល របស់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ។
ក្នុង ទិសដៅ នេះ ការបន្ត ជំរុញ ការប្រើប្រាស់ ប្រាក់ រៀល ពី គ្រប់ មជ្ឈដ្ឋាន ទាំងអស់ ទាំង វិស័យ សាធារណៈ វិស័យ ឯកជន និង ប្រជាពលរដ្ឋ ទូទៅ ពិតជា មាន សារៈសំខាន់ ណាស់ ក្នុង ការលើកកម្ពស់ តម្លៃ ប្រាក់ រៀល ដោយ ផ្ទាល់ និង ពង្រឹង ប្រសិទ្ធភាព ឧបករណ៍ នយោបាយ រូបិយវត្ថុ ជា រួម ។
ទន្ទឹម នេះ ធនាគារ ជាតិ នៃ កម្ពុជា នឹង នៅ បន្ត អនុវត្ត នយោបាយ រូបិយវត្ថុ ដែល សម្រួល ដល់ គ្រប់គ្រង សន្ទនីយភាព ក្នុង ប្រព័ន្ធ ធនាគារ ។ គួរ រំលេច ថា ភាពជោគជ័យ នៃ ការពង្រឹង ការប្រើប្រាស់ ប្រាក់ រៀល នឹង នាំឱ្យ ធនាគារ ជាតិ នៃ កម្ពុជា មាន ឥទ្ធិពល លើ ការគ្រប់គ្រង អត្រា ការប្រាក់ សំដៅ គាំទ្រ សកម្មភាព សេដ្ឋកិច្ច ជាតិ ឱ្យ បាន កាន់តែ ប្រសើរ ។
៣៖ ការត្រួតពិនិត្យ និង ការរក្សា ស្ថិរភាព ហិរញ្ញវត្ថុ៖ ស្ថានភាព សេដ្ឋកិច្ច ពិភពលោក ប្រឈម នឹង ភាព មិន ប្រាកដប្រជា ខ្ពស់ ហើយ ស្ថានភាព ទីផ្សារ ហិរញ្ញវត្ថុ អន្តរជាតិ ក៏ ប្រឈម នឹង ការរឹតត្បិត ផងដែរ ។ ការតាមដាន ជាប្រចាំ លើ សុខុមាលភាព របស់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ជាមួយនឹង ការដាក់ចេញ វិធានការម៉ាក្រូ និង មីក្រូ ប្រុងប្រយ័ត្ន ប្រកបដោយ លក្ខណៈ បុរេសកម្ម ជា ការងារ ចាំបាច់ ដើម្បី ពង្រឹង ភាពធន់ នៃ វិស័យ ធនាគារ និង រក្សា ស្ថិរភាព ហិរញ្ញវត្ថុ ។
ក្នុង ន័យ នេះ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ត្រូវ បន្ត ការគ្រប់គ្រង ហានិភ័យ នានា ដែល អាច កើតឡើង ជា យថាហេតុ ជាពិសេស កត្តា ខាងក្រៅ និង អនុវត្ត តាម បទប្បញ្ញត្តិ ប្រុងប្រយ័ត្ន ឱ្យ បាន ខ្ជាប់ខ្ជួន ជាមួយនឹង បន្ត រួមចំណែក គាំទ្រ ការងើបឡើង នៃ សេដ្ឋកិច្ច ។ ធនាគារ ជាតិ នៃ កម្ពុជា នឹង បន្ត អនុវត្ត យុទ្ធសាស្រ្ត ចាកចេញ ពី វិបត្តិ ជា ដំណាក់កាល ប្រកបដោយ ភាពប្រុងប្រយ័ត្ន ស្រប តាម ការវិវត្ត នៃ ស្ថានភាព សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដើម្បី ពង្រឹង ភាពធន់ និង ចីរភាព នៃ ការអភិវឌ្ឍ ប្រព័ន្ធ ធនាគារ កម្ពុជា ។
ហេតុ ដូច្នេះ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ត្រូវ បន្ត ចូលរួម សហការ អភិវឌ្ឍ ប្រព័ន្ធ ទូទាត់ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ និង រួមចំណែក ការពារ ឧក្រិដ្ឋកម្ម សាយប័រ សូម គាំទ្រ ផែនការអភិវឌ្ឍ ប្រព័ន្ធ បាគង ដូច ដែល បាន លើកឡើង ដោយ លោក គីម ទី កោមលី ដើម្បីឱ្យ ប្រព័ន្ធ បាគង អាច បំពេញ មុខងារ ភារកិច្ចកាន់តែ សម្បូរបែប និង ពង្រឹង ការស្គាល់ អត្តសញ្ញាណ អតិថិជន ឌីជីថល (e-KYC) និង ពង្រឹង សុវត្ថិភាព ប្រព័ន្ធ ទូទាត់ សំដៅ រួមចំណែក គាំទ្រ ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ឌីជីថល របស់ រាជ រដ្ឋាភិបាល ។
សូម អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ និង ភាគី ពាក់ព័ន្ធ ទាំងអស់ បង្កើន ការប្រើប្រាស់ ប្រាក់ រៀល ឱ្យ កាន់តែ ទូលំទូលាយ ។ ប្រាក់ រៀល ជា រូបិយវត្ថុ ជាតិ តែ មួយ គត់ របស់ កម្ពុជា ដែល តំណាង ឱ្យ អត្តសញ្ញាណ ជាតិ និង ផ្តល់ នូវ អត្ថប្រយោជន៍ ទាំង ផ្នែក សេដ្ឋកិច្ច និង សង្គម ។
៦៖ ការងារ សាខា ធនាគារ ជាតិ នៃ កម្ពុជា រាជធានី - ខេត្ត៖ សាខា ធនាគារ ជាតិ នៃ កម្ពុជា នៅ តាម បណ្តា រាជធានី - ខេត្ត គឺជា តំណាង ធនាគារ ជាតិ នៃ កម្ពុជា ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច នៅ តាម មូលដ្ឋាន ។ តាមរយៈ ទស្សនកិច្ច កន្លងមក បាន សង្កេតឃើញ ពី ការងើបឡើង នៃ សកម្មភាព សេដ្ឋកិច្ច នៅ តាម បណ្តា ខេត្ត ក្រោយពី ស្ថានភាព កូវីដ - ១៩ មាន ភាពធូរស្រាល ជាពិសេស ការនិយម ការប្រើប្រាស់ ប្រាក់ រៀល កាន់តែ ច្រើន និង កំណើន ប្រជាជន ប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ។
ជាមួយគ្នា នេះ ស្នើ ឱ្យ បន្ត ពង្រឹង ផែនការ និរន្តរភាព ធុរកិច្ច (BCP) ដើម្បី ធានា ការ បំពេញ តួនាទី របស់ ធនាគារ កណ្តាល ដោយ ពិលាស ជាពិសេស ការផ្តល់ សេវា ជូន គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ និង អង្គភាព រាជ រដ្ឋាភិបាល ក្នុង ស្ថានភាព ដែល ជំងឺ កូវីដ១៩ នៅ មិន ទាន់ ចប់ និង ការប្រឈម នឹង ភាព មិន ច្បាស់លាស់ នានា ជា យថាហេតុ ។
៨៖ ការគោរព វិន័យ៖ វិន័យ ក្នុង ការងារ ជា ផ្នែក មួយ សំខាន់ ក្នុង ការពង្រឹង អភិបាលកិច្ច និង បង្កើន ប្រសិទ្ធភាព ការងារ ។ ក្នុង អំឡុង វិបត្តិ ជំងឺ កូវីដ - ១៩ មន្ត្រី បុគ្គលិក បាន បន្ត អនុវត្ត ការងារ ប្រកបដោយ ភាពទទួលខុសត្រូវ ខ្ពស់ និង មាន ភាពបត់បែន តាម ស្ថានភាព ជាក់ស្តែង ។
៩៖ ការគ្រប់គ្រង ធនធាន មនុស្ស៖ ដើម្បី ពង្រឹង ប្រសិទ្ធភាព នៃ ការបំពេញ មុខងារ - ភារកិច្ច របស់ ធនាគារ កណ្តាល ក្នុង សម័យ សេដ្ឋកិច្ច ឌីជីថល ការអភិវឌ្ឍ ធនធាន មនុស្ស គឺជា ការងារ អាទិភាព ដ៏ សំខាន់ ដែល ត្រូវ អនុវត្ត ជាប្រចាំ ។ សូម កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ មន្រ្តី - បុគ្គលិក ដែល បាន អភិវឌ្ឍ ចំណេះដឹង ជាលំដាប់ ទាំង ជំនាញ ឯកទេស និង ជំនាញ ផ្សេង ៗ ទៀត ដើម្បី ពង្រឹង គុណភាព និង ប្រសិទ្ធភាព ការងារ ។
ស្រប តាម ការរីកចម្រើន នៃ វិស័យ ធនាគារ និង និម្មាប នកម្ម ហិរញ្ញវត្ថុ ពិភពលោក សូម ស្នើ ទេសាភិបាល រង បន្ត លើកទឹកចិត្ត មន្រ្តី បុគ្គលិក ឱ្យ ព្យាយាម ស្វ័យ សិក្សា បន្ថែម តាមរយៈ ប្រព័ន្ធ អនឡាញ និង ស្នើ ឱ្យ ចាប់ផ្តើម រៀបចំ វគ្គ បណ្តុះបណ្តាល នានា ដូចជា វគ្គ សុក្រឹត្យ ការ ភាព ជា អ្នកដឹកនាំ និង ការត្រួតពិនិត្យ ធនាគារ ជាដើម ទៅ តាម ស្ថានភាព ជាក់ស្តែង ក្នុង ពេល ដែល បញ្ហា កូវីដ - ១៩ មាន ភាពធូរស្រាល ៕
អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ អនុញ្ញាតឲ្យ អនុព័ន្ធ យោធា ប៉ាគីស្ថាន ចូល ជួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ
វរសេនីយ៍ ឯក Muhammad Tayyab បញ្ជាក់ ថា ដោយ កងទ័ព ប៉ាគីស្ថាន ជា កងទ័ព មួយ ដ៏ សកម្ម នៅក្នុង កិច្ចសហប្រតិបត្តិការ ថែរក្សា សន្តិភាព របស់ អង្គការ សហ ប្រជាជាតិ ប៉ាគីស្ថាន ចង់ ចែករំលែក បទពិសោធន៍ មួយចំនួន ដល់ កងយោធពល ខេមរភូមិន្ទ ក្នុង នោះ មាន ទាំង មុខជំនាញ ប្រឆាំង ភេរវកម្ម ចារកម្ម និង មុខជំនាញ នៃ បណ្ដា ប្រភេទ ទ័ព ផងដែរ ។
លោក វរសេនីយ៍ ឯក អនុព័ន្ធ យោធា ប៉ាគីស្ថាន បាន អះអាង ថា ប៉ាគីស្ថាន មាន ជំហរ ច្បាស់លាស់ នៅក្នុង កិច្ចសហការ ទ្វេ ភាគី ជាមួយ ប្រទេស កម្ពុជា ដោយ កម្ពុជា គឺជា ប្រទេស ដ៏ សំខាន់ មួយ នៅក្នុង តំបន់ អាស៊ាន សម្រាប់ កិច្ចសហការ ថែរក្សា សន្តិភាព ស្ថេរភាព ក្នុង តំបន់ ដែល ជា កត្តា សំខាន់ សម្រាប់ ពិភពលោក ។
វរសេនីយ៍ ឯក Muhammad Tayyab ក៏ បាន សុំ អញ្ជើញ នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ ទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស ប៉ាគីស្ថាន ក៏ ដូចជា ស្នើសុំ ឱ្យ មាន ការិយាល័យ អនុព័ន្ធ យោធា កម្ពុជា នៅក្នុង ប្រទេស ប៉ាគីស្ថាន ដើម្បី បង្កើន ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ល្អ ថែម ទៀត ។
ក្នុង កិច្ច ឆ្លើយតប នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន ថ្លែងអំណរគុណ ដល់ ប្រទេស ប៉ាគីស្ថាន ដែល កន្លងមក បាន ជួយ កម្ពុជា នៅក្នុង ការបណ្ដុះបណ្ដាល ធនធាន មនុស្ស ក៏ ដូចជា ការជួយជ្រោមជ្រែង ឧបត្ថម្ភ ជាច្រើន ទៀត ដែល ផ្ដល់ សារៈសំខាន់ សម្រាប់ ផលប្រយោជន៍ ប្រទេស ទាំង ពីរ ។
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ក៏ បាន លើកឡើង ពី ស្ថានភាព នៅ កម្ពុជា ដែល មកដល់ បច្ចុប្បន្ន កម្ពុជា គ្រប់គ្រង បាន ល្អ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ និង ការដាក់ចេញ យុទ្ធសាស្ត្រ ច្បាស់លាស់ របស់ សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ បាន ធ្វើការកត់សម្គាល់ ដោយ ពេញចិត្ត ចំពោះ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ព្រមទាំង បន្ត ខិតខំ លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ នេះ ឱ្យ មាន កម្រិត ឈានឡើង ស្រប នឹង ខួប ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង កម្ពុជា - ប៉ាគីស្ថាន ។
ក្នុង ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ប្រទេស ទាំង ពីរ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន ស្នើសុំ ឲ្យ ប៉ាគីស្ថាន បន្ត ជួយ ការបណ្ដុះបណ្ដាល ធនធាន មនុស្ស ក្នុង កងយោធពល ខេមរភូមិន្ទ ទាំង ផ្នែក កងទ័ព ជើងគោក ជើងទឹក ជើង អាកាស កម្លាំង ទ័ព ពិសេស និង ការផ្លាស់ប្ដូរ នូវ លំហាត់ ពី គ្នា ទៅ វិញ ទៅមក ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០២២ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៦. ៥៣២ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៣. ៣៥២ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន៖ ប្រទេស ជប៉ុន នៅតែ ជា មិត្តភ័ក្តិ ដ៏ ប្រពៃ និង ជា ដៃគូ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ដ៏ សំខាន់ មួយ សម្រាប់ កម្ពុជា
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន លើកឡើង ថា ប្រទេស ជប៉ុន នៅតែ ជា មិត្តភ័ក្តិ ដ៏ ប្រពៃ និង ជា ដៃគូ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ដ៏ សំខាន់ មួយ សម្រាប់ ប្រទេស កម្ពុជា ។
ការលើកឡើង របស់ មន្ត្រី ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល បែប នេះ តាមរយៈ សកម្មភាព ជំនួយ ទាំងឡាយ របស់ ជប៉ុន ក្នុង ការជួយ ដល់ ការអភិវឌ្ឍន៍ កម្ពុជា រួម មាន កំពង់ផែ សមុទ្រ អន្ត ជាតិ . ផ្លូវថ្នល់ - ស្ពាន . អគ្គិសនី . ប្រព័ន្ធ ធារាសាស្រ្ត . មន្ទីរពេទ្យ . សាលារៀន និង រោងចក្រ ផលិត ទឹក ស្អាត ជាដើម ។
លោក HATAEDA Mikio សូម ថ្លែងអំណរគុណ ចំពោះ ការចូលរួម រំលែក ទុក្ខ របស់ អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី រាជ រដ្ឋាភិបាល កម្ពុជា និង ប្រជាជន កម្ពុជា និង សម្តែង នូវ គារវកិច្ច ដ៏ ខ្ពង់ខ្ពស់ ចំពោះ អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី ដែល បាន ចំណាយ ពេលវេលា ដ៏ មាន តម្លៃ និង មមាញឹក អនុញ្ញាតឲ្យ ក្រុមការងារ JICA ទទួល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ។
លោក HATAEDA Mikio បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ចំពោះ ចំណាត់ការ និង វិធានការ នានា ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ ក្នុង ការប្រយុទ្ធ ប្រឆាំង ទៅនឹង នៃ ជំងឺ កូវីដ - ១៩ ។
លោក HATAEDA Mikio សន្យា បង្កើន ឥណទាន សម្បទាន ទ្វេ ដង សម្រាប់ មួយ ឆ្នាំ ៗ ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការអភិវឌ្ឍន៍ របស់ ប្រទេស កម្ពុជា និង ហិរញ្ញប្បទាន សហប្រតិបត្តិការ នានា បន្ថែម ទៀត ដើម្បី ជួយ គាំទ្រ ដល់ សកម្មភាព អភិវឌ្ឍន៍ សេដ្ឋកិច្ច - សង្គម នៅ កម្ពុជា ។
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ សែនសុខ នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ ក្រុមការងារ ចុះ មក ផ្តល់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូស ជំរុញ និង ពិនិត្យ ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ដែល ធ្វើឡើង នៅក្នុង វត្ត ព្រះបារមី វង្កដ្ឋ បូរី នៅ សង្កាត់ ទឹក ថ្លា រាជធានី ភ្នំពេញ ។
រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន ថ្លែង បន្ដ ថា កិច្ចការងារ នេះ ទាំងនេះ គឺជា ការបំពេញ ភារកិច្ច ដែល រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា បាន ប្រគល់ ជូន ផង និង យើង មាន ភារកិច្ច បម្រើ ប្រជាជន យើង ផង ក្នុង ការលើកកម្ពស់ សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ កាន់តែ ប្រសើរ ។
ក្នុង ឱកាស នោះ លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង គូសបញ្ជាក់ ថា « បច្ចុប្បន្ន នេះ ដោយសារ មេរោគ កូវី ដ១៩ ប្រភេទ ថ្មី មាន ករណី ឆ្លង ច្រើន តែ មិន មាន ករណី សា្លប់ ទេ ដោយសារ ប្រជាពលរដ្ឋ យើង បាន ចាក់ វ៉ាក់សាំង រួចរាល់ ដូច្នេះ ដើម្បី បង្កើន ភាពសុំា ឱ្យ អង្គការ ពារ រាងកាយ កុំ ឱ្យ ថយចុះ ហេតុ ដូចនេះ ហើយ បានជា តម្រូវ ឱ្យ ពលរដ្ឋ យើង ចាក់ វ៉ាក់សាំង ដូស ជំរុញ បន្ថែម ឱ្យ បាន គ្រប់ ៗ គ្នា ទៅ តាម ចំនួន ដែល ជា ការអំពាវនាវ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី » ។
លោកស្រី បាន ថ្លែងអំណរគុណ ដល់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា « ដែល បាន ផ្ដល់ វ៉ាក់សាំង ដែល ដូចជា ឱសថ ទិព្វ មកដល់ ពួក ខ្ញុំ ជា ប្រជាពលរដ្ឋ បាន ចាក់ ការពារ ជីវិត ហើយ បាន ធ្វើឱ្យ ខ្ញុំ មាន សុខភាព ល្អ ជាង មុន ទៀត ពីមុន ខ្ញុំ ពិបាកចិត្ដ ណាស់ មិន ដឹង ថា ត្រូវ ទៅ ព្យាបាល ជំងឺ រោគ អី ខ្លះ ទេ តែ ដោយសារ សម្ដេច យក វ៉ាក់សាំង មក ចាក់ ទៅ ខ្ញុំ ជា ខ្ញុំ អាច ទៅ វត្ដ ឆ្ងាយ ៗ ធ្វើ បុណ្យ ធ្វើ ទាន សប្បាយ ចិត្ដ ណាស់ » ។
ទន្ទឹម នឹង នោះ លោកស្រី បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ មក ចាក់ វ៉ាក់សាំង ឱ្យ បាន គ្រប់ ៗ គ្នា ពិសេស ចាស់ ៗ សុខភាព មិន ល្អ ចាក់ ហើយ នឹង បាន សុខភាព ល្អ រឹងមាំ វិញ និង បាន ការពារ ជំងឺ កូវីដ១៩ ផង ។
សូម ជម្រាប ថា ក្នុង ឱកាស នោះ ដែរ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល និង ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ សែនសុខ បាន នាំយក ទៀន ព្រះវស្សា ទេយ្យ វត្ថុ និង បច្ច័យ ប្រគេន ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៅ វត្ដ វង្គដ្ដ បូរី ផងដែរ ៕ ឯកឧត្ដម សន្តិ បណ្ឌិត ម៉ៅ ប៊ុន ណារិន បរិច្ចាគ ថវិកា ១០០០ ដុល្លារ ជូន រាជ រដ្ឋាភិបាល ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ តប តាម ការអំពាវនាវ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . ឯកឧត្ដម សន្តិ បណ្ឌិត ម៉ៅ ប៊ុន ណារិន រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង លោកជំទាវ បាន ចូលរួម បរិច្ចាគ ថវិកា ១០០០ ដុល្លារ ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា មីន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ២៣នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ២. ៣១៨នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ជំនួប ពិភាក្សា តាម ទូរស័ព្ទ រវាង មេដឹកនាំ ទាំង ពីរ ដែល មិន បាន រៀបចំ ក្នុង រយៈពេល ៤ខែ មក ហើយ នេះ អាចនឹង កើតឡើង ចំពេលវេលា ដ៏ សំខាន់ មួយ លើ ភាពតានតឹង នៃ កោះ តៃវ៉ាន់ ខណៈ រដ្ឋបាល លោក បៃ ដិន ក៏ កំពុង ថ្លឹងថ្លែង អំពី ការកាត់បន្ថយ ពន្ធ នាំចូល លើ ទំនិញ ពី ប្រទេស ចិន ដើម្បី ជួយ កាត់បន្ថយ សម្ពាធ អតិផរណា សម្រាប់ ពលរដ្ឋ អាមេរិក ផងដែរ ៕
នៅក្នុង បទសម្ភាសន៍ ជាមួយ ទីភ្នាក់ងារ សារព័ត៌មាន រុស្ស៉ី អ អាយ អេ ណូវ៉ូស្ទី (RIA Novosti) កាលពី ថ្ងៃពុធ សប្ដាហ៍ នេះ លោក ឡារ៉ូវ បាន សង្កត់ធ្ងន់ ដូច្នេះ ថា « នៅ ពេល ដែល រុស្ស៉ី និង អ៊ុយក្រែន បាន ពិភាក្សា គ្នា ពី លទ្ធភាព ស្វែងរក កិច្ចព្រមព្រៀង សន្តិភាព បញ្ចប់ អរិភាព ពួកយើង បាន ត្រៀមលក្ខណៈ ដើម្បី ទទួលយក សំណើ របស់ អ៊ុយក្រែន ដោយ ផ្អែក លើ លក្ខណៈ ភូមិសាស្ត្រ នៅ ត្រឹម ខែមីនា ឆ្នាំ ២០២២ » ។
គួរ បញ្ជាក់ ថា ការលើកឡើង ខាងលើ របស់ លោក ឡារ៉ូវ កើត មាន ឡើង បន្ទាប់ពី សហរដ្ឋ អាមេរិក បាន និយាយ ថា រុស្ស៉ី កំពុង ចាប់ផ្ដើម កាត់ យក ទឹកដី អ៊ុយក្រែន បញ្ចូល ទៅក្នុង ឧបសម្ព័ន្ធ របស់ ខ្លួន ដែល មូស្គូ បាន ក្រសោប យក តំបន់ គ្រី មៀ ពី អ៊ុយក្រែន កាលពី ឆ្នាំ ២០១៤ ៕
គួរ បញ្ជាក់ ថា រុស្ស៉ី មិន បាន បង្ហើប ពី ចំនួន កងទ័ព របស់ ខ្លួន ដែល បាន ស្លាប់ ឬ រងរបួស នោះ ទេ ចាប់តាំងពី ថ្ងៃទី ២៥ ខែមីនា មក ជា ទី ដែល ទីក្រុង មូស្គូ បាន អះអាង ថា កងទ័ព របស់ ខ្លួន ១. ៣៥១ នាក់ ត្រូវបាន សម្លាប់ ហើយ រដ្ឋាភិបាល អ៊ុយក្រែន ក៏ បញ្ជាក់ កាលពី ខែមិថុនា ដែរ ថា កងទ័ព របស់ ខ្លួន ប្រហែល ចន្លោះ ពី ១០០ ទៅ ២០០ នាក់ បាន ពលី ជីវិត ក្នុង ពេល មួយ ថ្ងៃ ៕
ក្រៅពី នេះ កម្លាំង អាវុធហត្ថ ក្រោម ការដឹកនាំ របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ក៏ បាន ចូលរួម ការងារ បង្ក្រាប បទល្មើស ជាច្រើន នៅក្នុង សង្គម និង ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ គ្រប់ រូបភាព ដែល កើត មាន ឡើង ។ សម្រាប់ កងកម្លាំង អាវុធហត្ថ ទាំងអស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា មាន ទិស ស្លោក ជា ត្រី វិស័យ បង្ហាញ ផ្លូវ សម្រាប់ របៀប ធ្វើ ការរួម មាន៖
ក្រោយពី ទទួលបាន សារ របស់ កូន ចៅ ក្រោម ឱវាទ តាម ប្រព័ន្ធ ទំនាក់ទំនង នានា នាយ ឧត្តមសេនីយ៍ បាន ឆ្លើយតប ដូច ខាងក្រោម៖
ខ្ញុំ អស់ ឪពុក ម្តាយ បងប្អូន តែ ខ្ញុំ មាន បងប្អូន ទាំងអស់ គ្នា រាប់អាន ស្រឡាញ់ គាំទ្រ ចែករំលែក យក អាសា ខ្ញុំ ខ្ញុំ ពិតជា សំណាង ។ សូម បងប្អូន គ្រប់ រូប មេត្តា ទទួល នូវ ក្តី គោរព ស្រឡាញ់ ដឹង គុណ ពី ខ្ញុំ ចំពោះ បងប្អូន ជានិច្ច ។
សូម បញ្ជាក់ ថា ស្ថាប័ន កងរាជអាវុធហត្ថ ត្រូវបាន បង្កើតឡើង កាលពី ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ១៩៩៣ ពោល បន្ទាប់ពី ការបោះឆ្នោត លើក ដំបូង ដែល រៀបចំ ដោយ អាជ្ញាធរ បណ្តោះអាសន្ន នៃ អង្គការ សហ ប្រជាជាតិ ប្រចាំ នៅ កម្ពុជា ហៅ កាត់ « អ៊ុន តាក់ » ។ តាម ក្រឹត្យ ចុះ ថ្ងៃទី ១៤ កក្កដា ១៩៩៣ ការបង្កើត អគ្គ សេនាធិការដ្ឋាន នៃ កងទ័ព ជាតិ កម្ពុជា នៅក្នុង រចនាសម្ព័ន្ធ ចាត់តាំង អគ្គ សេនាធិការដ្ឋាន ក៏ មាន កង អាវុធហត្ថ ផងដែរ ។
បន្ទាប់មក នៅ ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ១៩៩៤ រាជ រដ្ឋាភិបាល បាន ចេញ នូវ អនុក្រឹត្យ លេខ ៧៧ ស្តីពី តួនាទី ភារកិច្ច និង រចនាសម្ព័ន្ធ ទូទៅ កងរាជអាវុធហត្ថ និង ក្រម នីតិវិធី ព្រហ្មទណ្ឌ ដែល រដ្ឋ សភា បាន អនុម័ត កាលពី ថ្ងៃទី ៧ ខែមិថុនា ឆ្នាំ ២០០៧ បាន ចែង ច្បាស់ កំណត់ សមត្ថកិច្ច របស់ កងរាជអាវុធហត្ថ ក្នុង គម្ពីទី ២ មាតិកាទី៤ ជំពូក ទី៤ ។
នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន លើកឡើង ថា យោង ទៅ តាម ឯកសារ គតិយុត្ត ខាងលើ ២៩ ឆ្នាំ កន្លងផុត ទៅ កងរាជអាវុធហត្ថ បាន កសាង ហេដ្ឋារចនាសម្ពន្ធ ទាំង រឹង ទាំង ទន់ ផង និង ប្រតិបត្តិ នូវ តួនាទី ភារកិច្ច ដែល មាន ចែង ក្នុង លិខិត បទដ្ឋាន គតិយុត្ត ក្នុង ការរួមចំណែក ការពារ សន្តិសុខ រក្សា សណ្តាប់ធ្នាប់ បង្ក្រាប បទល្មើស ពង្រឹង ការអនុវត្ត កសាង ព្រះរាជាណាចក្រ កម្ពុជា ជា ប្រទេស នីតិរដ្ឋ ។
តាមរយៈ ស្នាដៃ និង សមិទ្ធផល ទាំងនេះ កងរាជអាវុធហត្ថ ទទួលបាន នូវ ការ ទុកចិត្ត ពី រាជ រដ្ឋាភិបាល ពី សាធារណជន និង បាន ប្រគល់ បន្ថែម នូវ ភារកិច្ច ឲ្យ ធ្វើ ការសហការ ជាមួយ ក្រសួង ស្ថាប័ន នានា យ៉ាង មាន ប្រសិទ្ធភាព ។
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០២២ ដល់ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២២ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តី ជូនដំណឹង លម្អិត ខាងក្រោម ។
សូម អាន សេចក្តីជូនដំណឹង របស់ អគ្គិសនី កម្ពុជា ដូច ខាងក្រោម៖ ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ម្នាក់ និង របួស ២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ម្នាក់ និង របួស ធ្ងន់ ស្រាល ២នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន និង មិន គោរព សិទិ្ធ ៕
ផ្អែក លើ ហេតុផល ជាច្រើន បច្ចុប្បន្ន សហរដ្ឋ អាមេរិក នៅតែ ជា កំពូល មហា អំណាច លេខ១ នៅលើ ពិភពលោក ដោយ មាន ប្រភព ធនធាន ធម្មជាតិ ដ៏ មហាសាល . មាន សេដ្ឋកិច្ច ដ៏ រស់រវើក ប្រព័ន្ធ ហិរញ្ញវត្ថុ ដ៏ រឹងមាំ បច្ចេកវិទ្យា ស្ដង់ដារ ពិភពលោក ព្រមទាំង មាន យោធា ខ្លាំងក្លា ដែល ជះឥទ្ធិពល ទៅកាន់ គ្រប់ តំបន់ ទាំងអស់ នៅលើ ពិភពលោក ។ ក៏ប៉ុន្តែ ប្រជាធិបតេយ្យ របស់ សហរដ្ឋ អាមេរិក បែរជា កំពុង ផុយ ស្រួល និង រង ការគំរាមកំហែង ហើយ សម្ព័ន្ធមិត្ត អាមេរិក បាន ត្រឹមតែ បង្ហាញ ការខកចិត្ត តែ ប៉ុណ្ណោះ ។
ម្លោះ ហើយ ថា តើ ប្រជាជន អាមេរិកាំង អាច រំពឹង បាន ទេ ថា ប្រជាជន ដទៃ នៅ ជុំវិញ ពិភពលោក នឹង នៅតែ មាន ជំនឿ លើ ប្រជាធិបតេយ្យ អាមេរិក នៅ ពេល ដែល ៧០ ភាគរយ នៃ អ្នកគាំទ្រ គណបក្ស សាធារណរដ្ឋ មិន ទទួលស្គាល់ លោក ចូ បៃ ដិន ជា ប្រធានាធិបតី ស្រប ច្បាប់ ហើយ ភាគ ច្រើន ក្នុង ចំណោម ពួកគេ ថែមទាំង និយាយ ថា ត្រៀមខ្លួន ជាស្រេច ដើម្បី បោះឆ្នោត គាំទ្រ មនុស្ស ម្នាក់ ដូចជា លោក ត្រាំ ដែល ញុះញង់ ឱ្យ មាន កុបកម្ម និង អំពើហិង្សា នៅ តាម កញ្ចក់ ទូរទស្សន៍ ទៅ វិញ ?
ដោយឡែក ប្រសិនបើ លោក ត្រាំ ឬ បេក្ខជន គាំទ្រ ដោយ លោក ត្រាំ ទទួលបាន ជ័យជម្នះ វិញ នោះ ក្រុម មនុស្ស ដែល ស្អប់ លោក ត្រាំ អាចនឹង នាំគ្នា តវ៉ា ប្រឆាំង នឹង លទ្ធផល បោះឆ្នោត ដោយ ចោទ ថា ការបោះឆ្នោត ត្រូវបាន លួច បន្លំ ។ ក្នុង ន័យ នេះ ទោះជា លោក ត្រាំ ឬ លោក បៃ ដិន មិន មែន ជា បេក្ខជន ប្រធានាធិបតី ក៏ដោយ ក៏ អាមេរិក នឹង នៅតែ ប្រឈមមុខ នឹង បញ្ហា ភាពស្រប ច្បាប់ នៃ ការបោះឆ្នោត ដដែល ។
តួយ៉ាង កាលពី ខែមិថុនា កន្លងទៅ បុរស ម្នាក់ រស់ នៅក្នុង រដ្ឋ កាលីហ្វ័រញ៉ា ត្រូវបាន ចោទប្រកាន់ ពី បទ ព្យាយាម សម្លាប់ ចៅក្រម តុលាការ កំពូល អាមេរិក លោក ប្រេត កាវ៉ាន់ ណាស់ (Brett Kavanaugh) ។ ក្រុម រដ្ឋអាជ្ញា បាន ឱ្យដឹង ថា បុរស រូប នេះ មាន ការខឹងសម្បារ យ៉ាង ខ្លាំង ចំពោះ ការសម្រេចចិត្ត លុបចោល សិទ្ធិ រំលូត កូន របស់ ស្ត្រី អាមេរិក ហើយ រូប គេ បារម្ភ ខ្លាច ថា លោក កាវ៉ាន់ ណាស់ អាចនឹង បន្ធូ បន្ថយ ច្បាប់ គ្រប់គ្រង កាំភ្លើង ។
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ខាងលើ នេះ មាន ករណី នាំចូល ចំនួន ៣៩៧ ករណី ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង សហគមន៍ ទាំងអស់ ។
ដំណឹង មរណភាព ! ភរិយា លោក សែម សុខា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច ទទួលមរណភាព នៅ ថ្ងៃ២០ កក្កដា ក្នុង ជន្មាយុ ៧៥ ឆ្នាំ
( ភ្នំពេញ ) ៖ លោកស្រី អ៊ុន ម៉ាលី ( ហុជ្ជះ ហាលី ម៉ះ ពិន ទី សាំមី អ៊ូន ) ដែល ត្រូវ ជា ភរិយា របស់ លោក សែម សុខា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ៣៖៤៥ នាទី រសៀល ថ្ងៃពុធ ទី២០ ខែកក្កដា ឆ្នាំ ២០២២ ក្នុង ជន្មាយុ ៧៥ ឆ្នាំ ដោយ ជរា ពាធ ។
អង្គការ សហ ប្រជាជាតិ បាន និយាយ នៅក្នុង របាយការណ៍ របស់ ខ្លួន ថា មាន មនុស្ស រាប់ រយ នាក់ ត្រូវបាន សម្លាប់ នៅក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ចាប់តាំងពី ក្រុម តាលី បង់ បាន វាយលុក ប្រទេស នេះ កាលពី ជិត មួយ ឆ្នាំ កន្លងមក នេះ បើ ទោះបីជា សន្តិសុខ ទាំងមូល បាន ប្រសើរឡើង ចាប់តាំងពី ពេល នោះ មក ក៏ដោយ ។
ពួក តាលី បង់ តែងតែ បដិសេធ ការចោទប្រកាន់ អំពី ការរំលោភ សិទ្ធិ ចាប់តាំងពី ការផ្តួលរំលំ រដ្ឋាភិបាល ដែល គាំទ្រ ដោយ លោក ខាងលិច មុន ប៉ុន្តែ របាយការណ៍ របស់ UNAMA ដែល បាន ចេញផ្សាយ នៅ ថ្ងៃពុធ នេះ បាន រាយ បញ្ជី គណនី ជាច្រើន ។
របាយការណ៍ បាន និយាយ ថា មនុស្ស រហូតដល់ ៧០០ នាក់ ត្រូវបាន សម្លាប់ និង ១.៤០០ នាក់ បាន រងរបួស ចាប់តាំងពី ពាក់កណ្តាល ខែសីហា ឆ្នាំ ២០២១ ក្រោយ ពួក តាលី បង់ បាន កាន់កាប់ រដ្ឋធានី កាប៊ុល របស់ អាហ្វហ្គានីស្ថាន នៅ ពេល ដែល សហរដ្ឋ អាមេរិក និង អង្គការ ណា តូ ស្ថិត នៅក្នុង សប្តាហ៍ ចុងក្រោយ នៃ ការដក ខ្លួន ចេញ ពី ប្រទេស អាហ្វហ្គានីស្ថាន ៕
ស្អែក នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នឹង រៀបចំ សន្និសីទ ព័ត៌មាន បង្ហាញ ពី សមិទ្ធផល សម្រេចបាន រយៈពេល ៥ ឆ្នាំ របស់ ក្រសួង ពាណិជ្ជកម្ម
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នឹង រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « សមិទ្ធផល សម្រេចបាន រយៈពេល ៥ឆ្នាំ កន្លងមក របស់ ក្រសួង ពាណិជ្ជកម្ម » នៅ វេលា ម៉ោង ៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០២២ ស្អែក នេះ នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី សាល សេរីភាព ជាន់ ផ្ទាល់ ដី ។
វា គ្មិន កិត្តិយស ដែល នឹង អញ្ជើញ ចូលរួម៖ តំណាង ពី កស ក្រសួង ពាណិជ្ជកម្ម ៕
ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ដាក់ ឱ្យ អនុវត្ត « ប្រកាស ស្តីពី គុណភាព សេវា ទូរគមនាគមន៍ » ទុក ផ្តល់ ពេល ១០ខែ ឲ្យ ក្រុមហ៊ុន ទូរគមនាគមន៍ កែលំអ និង ពង្រឹង គុណភាព សេវា
ក្រសួង បាន ឲ្យដឹង ថា ខ្លួន បាន ចាត់ទុក ការពង្រឹង គុណភាព សេវា ទូរគមនាគមន៍ គឺជា កិច្ចការ អាទិភាព បំផុត និង បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ក្នុង ការស្វែងរក មធ្យោបាយ និង ដំណោះស្រាយ នានា សំដៅ បង្កើន គុណភាព សេវា ទូរសព្ទ ចល័ត និង អ៊ីនធឺណិត និង លើកកម្ពស់ ការការពារ សិទ្ធិ របស់ អ្នកប្រើប្រាស់ ដោយសារតែ គុណភាព សេវា ទូរគមនាគមន៍ បច្ចុប្បន្ន នៅ មាន កម្រិត នៅឡើយ ។
ក្រោយពី « ប្រកាស ស្តីពី គុណភាព សេវា ទូរគមនាគមន៍ » ត្រូវបាន ចុះហត្ថលេខា ប្រតិបត្តិករ ទូរគមនាគមន៍ មាន រយៈពេល ១០ ( ដប់ ) ខែ ដើម្បី កែលំអ និង ពង្រឹង គុណភាព សេវា ទូរគមនាគមន៍ របស់ ខ្លួន ដោយ អនុលោម តាម សូចនាករគុណ ផល គន្លឹះ ដូច មាន ចែង ក្នុង ប្រកាស នេះ ។ ក្នុង ករណី ប្រតិបត្តិករ ទូរគមនាគមន៍ ណា មិន អនុវត្ត តាម ស្តង់ដារ អប្បបរមា ដែល បាន កំណត់ ក្នុង ប្រកាស នេះ ទេ ប្រតិបត្តិករ ទូរគមនាគមន៍ នោះ នឹង ត្រូវ ទទួល រង ពិន័យ ៕
( ភ្នំពេញ ) ៖ មានប្រសាសន៍ អំឡុង កិច្ចសន្ទនា អនឡាញ ស្ដីពី កសិកម្ម កម្ពុជា - ចិន ក្រោម ក្របខណ្ឌ « ខ្សែក្រវាត់ និង ផ្លូវ » នា រសៀល ថ្ងៃទី ២០ កក្កដា ២០២២ ឯកឧត្តម វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៃ ប្រទេស កម្ពុជា បាន មានប្រសាសន៍ វាយតម្លៃ ខ្ពស់ ចំពោះ គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » ថា ពិតជា បាន ផ្តល់ នូវ ផលប្រយោជន៍ ជាច្រើន សម្រាប់ ការអភិវឌ្ឍ វិស័យ កសិកម្ម នៅ ប្រទេស កម្ពុជា ។
ឯកឧត្តម វេង សាខុន៖ « ជា លទ្ធផល ការនាំចេញ ផលិតផល កសិកម្ម កម្ពុជា ទៅកាន់ ទីផ្សារ ប្រទេស ចិន ក្នុង រយៈពេល ៣ ឆ្នាំ ៦ខែ គិត ចាប់ពី ឆ្នាំ ២០១៩ រហូតដល់ ៦ខែ ដើម ឆ្នាំ ២០២២ កន្លងមក នេះ សម្រេចបាន ទំហំ ជាង ២.៤ លាន តោន ដែល ក្នុង នោះ មាន ផ្លែ ចេក ស្រស់ អង្ករ ចំណិត ដំឡូង មី ក្រៀម ម្សៅ ដំឡូង មី ដំណាប់ ស្វាយ ជ័រ កៅស៊ូ កាកសំណល់ ដំឡូង មី ផ្លែ ស្វាយ ស្រស់ គ្រាប់ ស្វាយចន្ទី កែច្នៃ ម្សៅ កាកាវ និង ផលិតផល កសិកម្ម ចំនួន ២៤មុខ ផ្សេង ទៀត ដែល មាន តម្លៃ ១៩៤២ លាន ដុល្លារ អាមេរិក » ។
( ដោយ៖ វិទ្យុ មិត្តភាព កម្ពុជា - ចិន ) ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បង្ហាញ មុខងារ ម៉ាស៊ីន ទំនើប ០៤ គ្រឿង ទៀត មាន សមត្ថភាព ខ្ពស់ ជួយ ត្រួតពិនិត្យ គុណភាព ផ្លូវ (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក្រោម ការដឹកនាំ របស់ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ជា រដ្ឋមន្ត្រី ជួសជុល កែលម្អ និង លើកកម្ពស់ គុណភាព លើ ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ គឺ មាន ភាពល្អ ប្រសើរឡើង ស្ទើ តែ ទូទាំង ប្រទេស គិត មកដល់ ពេល បច្ចុប្បន្ន នេះ ។
ជាមួយនឹង កែលម្អ ផ្លូវ ជាច្រើន ខ្សែ ឱ្យ មាន ភាពល្អ ប្រសើរឡើង នេះ គេ សង្កេតឃើញ វត្តមាន របស់ លោក រដ្ឋ មន្ត្រី ស៊ុន ចាន់ថុល តែងតែ បាន ចុះ ពិនិត្យ លើ គុណភាព នៃ ការសាងសង់ តាំងពី ការចាប់ផ្តើម រហូតដល់ ការងារ សង់ រួចរាល់ ក្នុង គោលបំណង ពិនិត្យ វឌ្ឍនភាព ការងារ សាងសង់ ក៏ ដូចជា ដើម្បី ផ្ទៀងផ្ទាត់ គុណភាព ក្រោយ បញ្ចប់ ការសាងសង់ ជា ស្ថាពរ ថា តើ ក្រុមហ៊ុន បាន អនុវត្ត ត្រឹមត្រូវ តាម កិច្ចសន្យា និង ស្តង់ដារ បច្ចេកទេស របស់ ក្រសួង ដែល បាន ព្រមព្រៀង ដែរ ឬ យ៉ាងណា ។
ជាក់ស្តែង នា ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ លោក រដ្ឋមន្ត្រី ក៏ បាន ដឹក ក្រុមការងារ បច្ចេកទេស ពាក់ព័ន្ធ របស់ ក្រសួង តំណាង ក្រុមហ៊ុន សាងសង់ និង ទីប្រឹក្សា បច្ចេកទេស ចុះ ពិនិត្យ គម្រោង ធ្វើឱ្យ ប្រសើរឡើង កំណាត់ ផ្លូវ លេខ ១៤៦បេ ( វិថី សម្ដេច សង្ឃរាជ ទេព វង្ស ) និង ផ្លូវ លេខ ១៤៨ ដោយ នាំយក ទៅ ជាមួយ នូវ ឧបករណ៍ ទំនើប ស៊េរី ថ្មី ៤គ្រឿង បន្ថែម ទៀត ដើម្បី ធ្វើ ការត្រួតពិនិត្យ លើ គុណភាព ផ្លូវ ដែល មាន លក្ខណៈ ទំនើប និង សុក្រឹតភាព ខ្ពស់ ក្នុង ការត្រួតពិនិត្យ លើ គុណភាព ផ្លូវ ។
លោក រដ្ឋមន្ត្រី បាន បន្ថែម ថា ឧបករណ៍ ទំនើប ទាំង ០៤ ប្រភេទ នេះ គឺជា ប្រភេទ ឧបករណ៍ ដែល ធ្វើតេស្ត ដោយ មិន ខូច រចនាសម្ព័ន្ធ ផ្លូវ ( មិន តម្រូវ ឱ្យ មាន ការ ជីក កាយ ) ផ្តល់ ព័ត៌មាន លឿន និង សុក្រឹត ៕
អបអរសាទរ អ្នក ដាំ ពោត ក្រហម ! ក្រុមហ៊ុន ស៊ី ភី ចុះ កិច្ចព្រមព្រៀង ទិញ ពោត ក្រហម ពី ម្ចាស់ សៃឡូ នៃ ប៉ៃលិន
( ប៉ៃលិន ) ៖ ជា ដំណឹង ដ៏ សែន រីករាយ សម្រាប់ អ្នក ប្រកបរបរ ដាំ ពោត ក្រហម នៅ ពេល នេះ ក្រុមហ៊ុន ស៊ី ភី ខេមបូឌា ចំកាត់ បាន ចុះ កិច្ចព្រមព្រៀង ទិញ ពោត ពី ម្ចាស់ សៃ ឡូចំនួន ១២ នៅ ខេត្ត ប៉ៃលិន ដែល មាន សមត្ថភាព ប្រមូល ទិញ បាន រហូតដល់ទៅ ១១៥.០០០ តោន ក្នុង មួយ ឆ្នាំ ។
ពិធី ចុះ កិច្ចព្រមព្រៀង ទិញ ពោត ក្រហម រវាង ក្រុមហ៊ុន ស៊ី ភី និង ម្ចាស់ សៃ ឡូក្នុង ខេត្ត ប៉ៃលិន នេះ បាន ធ្វើឡើង កាលពី ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ ។ ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ។
លោក រដ្ឋមន្ត្រី បាន លើកឡើង ថា ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា នេះ គឺជា កិច្ច ចាប់ផ្តើម នៅក្នុង ការចូលរួមចំណែក ពង្រើក សកម្មភាព ទិញ លក់ ផលិតផល ពោត ក្រហម ការជំរុញ ការវិនិយោគ បន្ថែម ទៀត ទៅ លើ ការកែច្នៃ កសិផល ពោត នៅក្នុង ស្រុក ក៏ ដូចជា ការបង្កើន តម្លៃ និង ការពង្រឹង ខ្សែ ច្រវាក់ តម្លៃ ពោត ក្រហម ស្រប ពេល ដែល កម្ពុជា កំពុងតែ ជួបប្រទះ បញ្ហា ការកើនឡើង ថ្លៃ នៃ ថាមពល និង ស្រប ពេល ដែល ដល់ រដូវកាល ប្រមូល ផល ពោត ក្រហម របស់ កសិករ នៅ ប្រទេស ជិតខាង ផងដែរ ។
លោក រដ្ឋមន្ត្រី បាន បង្ហាញ ក្ដីសង្ឃឹម យ៉ាង មុតមាំ ថា ក្រោយ ពិធី ចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា គ្រប់ ភាគី ទាំងអស់ នឹង សហការ គ្នា ឱ្យ កាន់តែ មាន ភាពជិតស្និត នៅក្នុង ការជួយ ជំរុញ ដំណើរការ សេដ្ឋកិច្ច ជាតិ កាន់តែ មាន ភាពរីកចម្រើន និង ជួយ ផលិតកម្ម ដែល មាន គោលដៅ ចុងក្រោយ គឺ បង្កើន ប្រាក់ ចំណូល ជូន កសិករ ដាំ ពោត ក្រហម នៅក្នុង ខេត្ត ប៉ៃលិន ក៏ ដូចជា កសិករ ទូទាំង ប្រទេស ។
យោង តាម របាយការណ៍ របស់ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ប៉ៃលិន បាន ឱ្យដឹង ថា បច្ចុប្បន្ន ម្ចាស់ សៃឡូ ទាំង ១២ទីតាំង ក្នុង ខេត្ត ប៉ៃលិន កំពុង ដំណើរការបញ្ជាទិញ ពោត ក្រហម ក្នុង តម្លៃ ប្រមាណ ៦៣៦. ៦៤ រៀល ក្នុង មួយ គីឡូក្រាម សម្រាប់ ពោត ស្នូល សំណើម៣០ ភាគរយ ហើយ តម្លៃ ៦៤៧. ៨១ រៀល ក្នុង មួយ គីឡូក្រាម សម្រាប់ ពោត ស្នូល សំណើម ២៩ ភាគរយ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៧ករណី . ដឹកជញ្ជូន រក្សាទុក ៣ករណី និង ជួញដូរ ៨ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤១ នាក់ ។
អភិបាល ខេត្ត ព្រះសីហនុ អញ្ជើញ ចុះ ពិនិត្យ ប្រព័ន្ធ អូរ ប្រឡាយ មួយចំនួន ក្នុង សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ នៅ ព្រឹក ថ្ងៃពុធ ទី២០ ខែកក្កដា ឆ្នាំ ២០២២ លោក គួច ចំរើន អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ និង លោក អ៊ី សុខ ឡេង អភិបាល ក្រុង ព្រះសីហនុ បាន ដឹកនាំ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ចុះ ពិនិត្យ ការកែលម្អ ស្ពាន មួយ កន្លែង ដែល ស្ថិត នៅ ផ្លូវ ៨១៨៨ ក្នុង គម្រោង ឆ្នាំ ២០២៣ ស្ថិត ក្នុង ភូមិ ៤ សង្កាត់ លេខ ៤ និង អូរ ប្រឡាយ ក្នុង ភូមិសាស្ត្រ សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ ។
ក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត ក៏ បាន កោតសរសើរ អាជ្ញាធរ ក្រុង និង មន្ទីរ ពាក់ព័ន្ធ ដែល បាន យកចិត្តទុកដាក់ កន្លងមក ក្នុង ការបំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន បាន ល្អ ទោះបី នៅ មាន ការចន្លោះប្រហោង ក៏ ពិត មាន តែ យើង ត្រូវ រួមគ្នា បន្ត ទៀត ដើម្បី ដោះស្រាយ នូវ ជំនន់ ទឹកភ្លៀង ឱ្យ បាន ទាន់ ពេលវេលា ឱ្យ ក្រុង ព្រះសីហនុ របស់ យើង មាន សោភ័ណភាព អនាម័យ កាន់តែ ល្អ ប្រសើរ និង ជា ទីក្រុង ទេសចរណ៍ នៅ ភាគ និរតី បម្រើ ឲ្យ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ និង អ្នក វិនិយោគ នា ពេល ខាងមុខ ៕
ប្រធានាធិបតី អ៊ុយក្រែន លោក វ៉ូឡូឌីមៀ ហ្សេលេន ស្គី (Volodymyr Zelenskyy) បាន បង្ហាញ ក្តី រំពឹង ថា នឹង ទទួលបាន លទ្ធផល គួរឱ្យ កត់សម្គាល់ ពី ដំណើរទស្សនកិច្ច របស់ ភរិយា លោក នៅឯ រដ្ឋធានី វ៉ាស៉ីនតោន ។ បើ តាម លោក ហ្សេលេន ស្គី កិច្ចការ របស់ លោកស្រី ហ្សេលេន ស្កា រួម មាន ដូចជា បង្កើន ការគាំទ្រ របស់ អាមេរិក សម្រាប់ អ៊ុយក្រែន . ស្វែងរក ការជួយជ្រោមជ្រែង បន្ថែម ដើម្បី ការពារ ប្រជាជន អ៊ុយក្រែន ពី រុស្ស៉ី និង ជំរុញ ជំនួយ មនុស្សធម៌ ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃពុធ នេះ ( ពេលវេលា នៅ ទីក្រុង វ៉ាស៉ីន តោន ) លោកស្រី ហ្សេលេន ស្កា ក៏ នឹង ត្រូវ ថ្លែង សុន្ទរកថា នៅ ចំពោះមុខ សភា សហរដ្ឋ អាមេរិក ផងដែរ ។ ដំណើរទស្សនកិច្ច របស់ ភរិយា លោក ហ្សេលេន ស្គី មកកាន់ ទីក្រុង វ៉ាស៉ីនតោន គឺ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ ភរិយា លោក បៃ ដិន ដែល បាន ទៅ បំពេញ ទស្សនកិច្ច ដល់ អ៊ុយក្រែន កាលពី ឧសភា ៕
អគ្គ នាយកដ្ឋាន ពន្ធនាគារ និង អង្គការ ស៊ី ប៉ា ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ គម្រោង « ការអប់រំ ក្នុង ពន្ធនាគារ » សម្រាប់ អប់រំ ជន ជាប់ ឃុំ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ និង បណ្ឌិត្យ សភា នគរបាល កម្ពុជា ព្រមទាំង អង្គការ ស៊ី ប៉ា នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ នូវ គម្រោង « ការអប់រំ ក្នុង ពន្ធនាគារ » សម្រាប់ ការអប់រំ របស់ ជនជាប់ ឃុំ នៅក្នុង ប្រទេស កម្ពុជា បន្ទាប់ពី បាន បិទ បញ្ចប់ គម្រោង « បណ្ណាល័យ ក្នុង ពន្ធនាគារ » ជា ស្ថាពរ ។
ពិធី នេះ ការចូលរួម ពី លោក ឧត្តម អគ្គានុរក្ស ថ្នាក់ លេខ ១ស ឆែម សាវុធ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ លោក Jaques Pellet ឯក អគ្គ រដ្ឋទូត ប្រទេស បារាំង លោក ព្រុំ ចាន់ នី ប្រធាន នាយកដ្ឋាន អប់រំ កែប្រែ និង ស្ដានីតិសម្បទា ស្ដីពី កិច្ចសហការ និង លទ្ធផល សម្រេចបាន រវាង នាយកដ្ឋាន និង អង្គការ ស៊ី ប៉ា រួមទាំង អ្នកចូលរួម ជាច្រើន រូប ទៀត ។
លោក បាន បន្ដ ថា សម្រាប់ គម្រោង ៣ដំណាក់កាល រយៈពេល ១០ឆ្នាំ នេះ បាន ធ្វើឲ្យ ពន្ធនាគារ នីមួយ ៗ នៅ កម្ពុជា មាន បណ្ណាល័យ បម្រើ ដល់ ការអាន ការស្រាវជ្រាវ ការរៀនសូត្រ និង ការកំសាន្ត បន្ធូរ អារម្មណ៍ របស់ ជនជាប់ ឃុំ ។ គម្រោង នេះ ឆ្លើយតប នឹង តម្រូវការ និង យុទ្ធសាស្ត្រ របស់ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ។
លោក ឧត្តម អគ្គានុរក្ស ថ្នាក់ លេខ ១ ឆែម សាវុធ បាន សម្ដែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត និង វាយតម្លៃ ខ្ពស់ ចំពោះ អង្គការ ស៊ីប៉ា ដែល តែងតែ ផ្តល់ នូវ កិច្ចសហការ យ៉ាង ជិតស្និទ្ធ និង ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ជា បន្តបន្ទាប់ រយៈពេល កន្លងមក ។
លោក ថា កិច្ចសហការ ឧបត្ថម្ភ គាំទ្រ ពី អង្គការ ស៊ីប៉ា ជា ផ្នែក មួយ យ៉ាង សំខាន់ ក្នុង ការជួយ ជំរុញ ឲ្យ ការអនុវត្ត កម្មវិធី កំណែទម្រង់ ពន្ធនាគារ ទទួលបាន ជោគជ័យ និង ជួយ លើកស្ទួយ ដល់ កម្មវិធី អប់រំ កែប្រែ ស្តារ នីតិសម្បទា និង ត្រៀម ធ្វើ សមាហរណកម្ម ទៅក្នុង សង្គម វិញ ប្រកបដោយ ជំនាញ វិជ្ជាជីវៈ និង ជួយ ទប់ស្កាត់ ការប្រព្រឹត្ត បទល្មើស សារជាថ្មី ។
លោក បន្ដ ទៀត ថា ចាប់តាំងពី ឆ្នាំ ២០១៨ រហូតដល់ បច្ចុប្បន្ន អគ្គ នាយកដ្ឋាន ពន្ធនាគារ បាន ចុះ កិច្ចព្រមព្រៀង ជាមួយ អង្គការ ដៃគូរ ជាច្រើន ក្នុង ចំណោម អង្គការ ទាំងអស់ ដែល បាន ចុះ អនុស្សរណៈ យោគយល់ កន្លងមក ក៏ មាន អង្គការ ស៊ីប៉ា ផងដែរ ហើយ អង្គការ នេះ បាន ធ្វើ សកម្មភាព យ៉ាង មមាញឹក នា ពេល កន្លងមក ជាក់ស្ដែង ចាប់តាំងពី ឆ្នាំ ២០១២ រហូតដល់ បច្ចុប្បន្ន អង្គការ ស៊ី ប៉ា បាន សាងសង់ បណ្ណាល័យ សរុប ចំនួន ២៣ មាន បណ្ណាល័យ ខ្នាត ធំ មធ្យម និង តូច ។
លោក ឧត្តម អគ្គានុរក្ស ថ្នាក់ លេខ ១ ឆែម សាវុធ បាន បញ្ជាក់ ថា ការអាន សៀវភៅ នេះ មាន សារៈសំខាន់ យ៉ាង ច្រើន ដូច ជា៖
នា ឱកស នោះ លោក អ៊ុន ចាន់ ដា និង ក្នុង នាម ក្រុមប្រឹក្សា គណៈ អភិបាល ខេត្ត និង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ទូទាំង ខេត្ត បាន ដាក់ កម្រង ផ្កា និង អុច ធូប សំដែង នូវ សមាណ ទុក្ខ យ៉ាង ក្រៀមក្រំ បំប ផុត ចំពោះ ការបាត់បង់ លោក អ៊ុក រ៉ុង គឺជា ការបាត់បង់ នូវ ធនធាន មនុស្ស មួយ រូប ដែល បាន ចូលរួមចំណែក កសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា និង ជា ការបាត់បង់ លោកឪពុក ជីតា ជា ទីស្រឡាញ់ បំផុត នៃ គ្រួសារ សព ។
ក្នុង ឱកាស ដ៏ ក្រៀមក្រំ នោះ ថ្នាក់ដឹកនាំ ខេត្ត បាន ឧទ្ទិស បួងសួង សូម ឱ្យ វិញ្ញាណក្ខ័ន្ធ សព លោក អ៊ុក រ៉ុង បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
នា ឱកាស នោះ ដែរ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង អភិបាល ខេត្ត កំពង់ចាម ព្រមទាំង មន្ត្រី ក្រោម ឱវាទ ក៏ បាន អញ្ជើញ ចូលរួម ជា បច្ច័យ បុណ្យ សព ទៅ តាម កម្លាំង សទ្ធា ជ្រះថ្លា ផងដែរ ៕
អំណោយ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវ យក ចែកជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយសារ ជំនន់ ទឹកភ្លៀង ជាង ១០០ គ្រួសារ នៅ ស្រុក បន្ទាយមាស
នា ឱកាស សំណេះសំណាល នោះ លោក បណ្ឌិត ម៉ៅ ធ និន បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច ទាំង ទ្វេ គឺ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល ជានិច្ច ជាកាល សម្តេច តែងតែ គិតគូរ និង យកចិត្តទុកដាក់ ជានិច្ច ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយសារ គ្រោះមហន្តរាយ ផ្សេង ៗ ដោយ មិន ទុកឲ្យ ប្រជាពលរដ្ខ ណា ម្នាក់ ស្លាប់ ដោយ អត់ អាហារ នោះ ឡើយ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត ក៏ បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ដែល ទទួលរង ផល ប៉ពាល់ ដោយសារ ជំនន់ ទឹកភ្លៀង ទាំងអស់ ត្រូវ បន្ត បង្កបង្កើន ផល ស្រូវ ឡើងវិញ ក្រោយពេល ទឹក ស្រកចុះ វិញ ។
បន្ទាប់ ប្រគល់ អំណោយ រួច មក លោក បណ្ឌិត អភិបាល ខេត្ត និង លោក ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពត បាន ដឹកនាំ មន្ត្រីរាជការ អាជ្ញាធរ ពាក់ព័ន្ធ បន្ត ចុះ ទៅ ពិនិត្យ ផ្ទាល់ នូវ ស្ថានភាព ជាក់ស្តែង អំពី ផល ប៉ះពាល់ នៃ ជំនន់ ទឹកភ្លៀង ដែល ធ្វើឲ្យ ខូចខាត ដំណាំ ស្រូវ របស់ បងប្អូន ប្រជាពលរដ្ឋ យើង ។
របាយការណ៍ ប្រចាំ ឆ្នាំ ២០២២ ដែល ក្រសួង ការបរទេស អាមេរិក បាន ប្រគល់ នោះ និង គួបផ្សំ ជាមួយ « សេចកី្តព្រាង ច្បាប់ ស្តីពី ការបង្ការ កុំ ឱ្យ មាន ការបង្ខិតបង្ខំឱ្យ ជនជាតិ វៃ វូអឺ ធ្វើ ពលកម្ម » របស់ អាមេរិក ដែល ចូល ជាធរ មាន នៅ ថ្ងៃទី ២១ ខែមិថុនា សុទ្ធតែ ចាត់ទុក សិទ្ធិ មនុស្សជា អាវុធ ប៉ុនប៉ង ច្រានចោល តំបន់ ស៊ីន ជាំង កាត់ផ្ដាច់ ពី ខ្សែ សង្វាក់ ឧស្សាហកម្ម សកល និង បង្កបង្កើត កត្តា អស្ថិរភាព នៅ តំបន់ ស៊ីន ជាំង ដោយ ចេតនា ដើម្បី សម្រេចបាន នូវ គោលដៅ ដែល ចង់ ទប់ស្កាត់ ការអភិវឌ្ឍ របស់ ប្រទេស ចិន ។
តាមពិត ទៅ មិន ថា អាមេរិក ចេញផ្សាយ របាយការណ៍ យ៉ាងណា ដាក់ ចេញ យុទ្ធសាស្ត្រ យ៉ាងណា ឬ ប្រកាស សេចកី្តព្រាង ច្បាប់ យ៉ាងណា ក៏ សុទ្ធតែ មិន អាច មួល បង្កាច់ ដល់ តំបន់ ស៊ីន ជាំង របស់ ចិន នោះ ទេ ។ ដោយសារ សហគមន៍ អន្តរជាតិ បាន សម្គាល់ ឃើញ ថា តំបន់ ស៊ីន ជាំង ជា តំបន់ មួយ ដែល ទទួលបាន ការអភិវឌ្ឍ ប្រកបដោយ សុវត្ថិភាព មាន ភាពធូរធារ ស្តុកស្តម្ភ និង បើក ទូលាយ គ្មាន ទំនាក់ទំនង ជាមួយនឹង បទឧក្រិដ្ឋ « ប្រល័យ ពូជសាសន៍ » និង « បង្ខំឱ្យ ធ្វើ ពលកម្ម » ជាដើម ទាល់តែសោះ ។
តួលេខ បាន បង្ហាញ ថា ពី ឆ្នាំ ២០១៦ ដល់ ឆ្នាំ ២០២១ បរិមាណ សរុប នៃ ការនាំចេញ នាំចូល របស់ តំបន់ ស៊ីន ជាំង បាន កើន ពី ១៣៩៨០០ លាន ប្រាក់ យាន់ ចិន ឡើង ដល់ ១៥៦៩០០ លាន ប្រាក់ យាន់ ចិន ដៃគូ ពាណិជ្ជកម្ម ពាសពេញ នៅ ប្រទេស និង តំបន់ ចំនួន ជាង ១៧០ នៅលើ ពិភពលោក ។ ៥ខែ ដំបូង ឆ្នាំ នេះ បរិមាណ សរុប នៃ ការនាំចេញ នាំចូល របស់ តំបន់ ស៊ីន ជាំង គឺ ៦៧៤១០ លាន ប្រាក់ យាន់ ចិន កើន ជាង ៣០. ៩ភាគរយ ក្រុម មិត្តភកិ្ត នៃ កិច្ចសហប្រតិបតិ្តការ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម បាន ពង្រីក ធំ ឥត ឈប់ឈរ ។
ការអភិវឌ្ឍ សេដ្ឋកិច្ច អាច ជំរុញ ការប្រកប ការងារ ដោយ ផ្ទាល់ ។ ៥ខែ ដំបូង ឆ្នាំ នេះ ឱកាស ការងារ ថ្មី នៅ តាម ទីក្រុង និង ជនបទ នៃ តំបន់ ស៊ីន ជាំង មាន ២៦៣០០០ នាក់ ។ ក្នុង បរិបទ ដែល បច្ចុប្បន្ន នេះ សេដ្ឋកិច្ច ពិភពលោក មាន សភាព ធ្លាក់ចុះ លទ្ធផល នេះ បាន បង្ហាញ ឱ្យ ឃើញ នូវ ភាពធន់ នៃ សេដ្ឋកិច្ច ស៊ីន ជាំង ហើយក៏ ទទួលបាន ការទទួលស្គាល់ ពី សហគមន៍ អន្តរជាតិ ផងដែរ ។
សិស្សសាលា ម្នាក់ ចុះ លាង ដៃ នៅ មាត់ ស្ទឹង សែន រ អិល ជើង ធ្លាក់ ទឹក ស្លាប់
( កំពង់ធំ )៖ សព ក្មេងស្រី ត្រូវបាន គេ ប្រទះឃើញ អណ្តែត ក្នុង ទឹក ស្ទឹង សែន នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ ត្រង់ ចំណុច របាំង ទឹក មួយ កន្លែង មុខ មន្ទីរ សាធារណៈ ការ និង ដឹង ជញ្ជូន ខេត្ត កំពង់ធំ ក្នុង ភូមិ ទី៧ សង្កាត់ កំពង់ធំ ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ ។
យោង តាម ប្រភព ពី កន្លែង កើត ហេតុ បាន ឱ្យដឹង ថា មុនដំបូង គេ ឃើញ ក្មេងស្រី ២នាក់ ជា សិស្សសាលា បឋមសិក្សា កំពង់ធំ ក្រុង បាន នាំគ្នា ចុះ លាង ដៃ នៅ មាត់ ទឹក ស្ទឹង សែន ហើយក៏ រអឹល ជើង ធ្លាក់ ចូល ទៅក្នុង ទឹក ស្ទឹង សែន ដោយសារ នៅ ចំណុច នោះ មាន ទឹក ហូរ ខ្លាំង បណ្ដាលឲ្យ ក្មេង ទាំង ស្រី ទាំង ២នាក់ នោះ បាន លង់ទឹក ស្ទឹង សែន តែ សំណាង ល្អ ត្រូវបាន ជួយសង្គ្រោះ បាន ម្នាក់ ហើយ ម្នាក់ ទៀត ត្រូវបាន លិច បាត់ ទៅក្នុង ទឹក ។
លោក គឹម សុខ មករា អធិការ ក្រុង ស្ទឹង សែន បាន ឱ្យដឹង ថា ក្មេងស្រី រងគ្រោះ ទាំង ២នាក់ នោះ រួម មាន៖
ជាមួយគ្នា នេះ លោក អធិការ ក្រុង ស្ទឹង សែន ក៏ សូម អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល នៅ តាម ដង ស្ទឹង សែន សូមឲ្យ បងប្អូន មាន ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ ចំពោះ សុវត្ថិភាព កូន ៗ របស់ អស់ លោក ពី ព្រោះ ទឹក ស្ទឹង សែន កំពុងតែ ហក់ ឡើង ខ្លាំង នៅ ពេល នេះ ។ បន្ទាប់ពី បាន ស្រង់ សព រួច មក ក៏ ត្រូវបាន ប្រគល់ ជូន ក្រុមគ្រួសារ សាច់ញាតិ យក ទៅ ចាត់ចែង ធ្វើ បុណ្យ តាម ប្រពៃណី ។
លោក បន្ត ថា ក្រសួង ពាណិជ្ជកម្ម បន្ត ជ្រើសរើស យក ផលិតផល « អង្ករ បាត់ដំបង » « បង្គារ ក្រៀម កំពង់សោម » « បង្គារ ក្រៀម កោះ កុង » និង « ប្រហុក សៀមរាប » សម្រាប់ កសាង ជា ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ នៅ កម្ពុជា គឺ ដើម្បី ទប់ស្កាត់ ការក្លែងបន្លំ ទំនិញ សម្គាល់ ភូមិសាស្រ្ត ផលិតផល ទាំង ៤នេះ នៅលើ ទីផ្សារ ជាតិ និង អន្តរជាតិ ។
បន្ថែម ពី នេះ ក្រសួង មាន បំណង ចូលរួម អភិរក្ស ចំណេះដឹង - ចំណេះ ធ្វើ របស់ ផលិត ករ និង អាជីវករ តាម បណ្តា ខេត្ត នានា បង្កើន ច្រវ៉ាក់ តម្លៃ និង លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង តំបន់ ព្រមទាំង ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ដើម្បី មក ធ្វើ ទស្សនកិច្ច ក្នុង តំបន់ ផលិតកម្ម ។ ជាមួយគ្នា ក៏ ដើម្បីឱ្យ ផលិតផល ទាំងនេះ អាច ចូលរួម ប្រកួតប្រជែង ពិព័រណ៌ ចំណីអាហារ ថ្នាក់ ជាតិ និង អន្តរជាតិ ពិសេស ប្រទេស ថៃ វៀតណាម និង ចិន ជាដើម ។
ក្រោយ ការចុះបញ្ជី ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ ឬ ម៉ាក សមូហភាព តំបន់ ផលិតកម្ម ក្នុង ខេត្ត នីមួយ ៗ នឹង ទទួលបាន នូវ អត្ថប្រយោជន៍ ដូចជា ការប្រើប្រាស់ រូប សញ្ញា ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ « អង្ករ បាត់ដំបង » « បង្គារ ក្រៀម កំពង់សោម » « បង្គារ ក្រៀម កោះ កុង » និង « ប្រហុក សៀមរាប » រួមគ្នា តាមរយៈ ការដាក់ពាក្យ ស្នើសុំ ចូល ជា សមាជិក និង ចុះ កិច្ចសន្យា ថា នឹង អនុវត្ត អនុលោម តាម សៀវភៅ បន្ទុក ។
សូម ជម្រាប ថា ផលិតផល ៤នេះ ត្រូវបាន ក្រសួង ពាណិជ្ជកម្ម ដៃគូ អភិវឌ្ឍន៍ ថ្នាក់ ជាតិ និង អន្តរជាតិ បាន កំណត់ ក្នុង ការសិក្សា ចាប់តាំងពី ឆ្នាំ ២០១៩ ក្នុង ចំណោម ផលិតផល ចំនួន ២២ សម្រាប់ រៀបចំ ចុះបញ្ជី ជា ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ ៕
រដ្ឋបាល ខេត្ត សៀមរាប បើក វគ្គ បណ្ដុះបណ្ដាល ជំនាញ សារព័ត៌មាន ដល់ មន្រ្តី
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប នា ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ បាន បើក វគ្គ បណ្ដុះបណ្ដាល ជំនា ផលិត ព័ត៌មាន ការរាយ សរសេរ ព័ត៌មាន បឋម ដល់ មន្រ្តី តាម អង្គភាព ដែល ទទួលបន្ទុក ព័ត៌មាន តាម បណ្ដា មន្ទីរ អង្គភាព និង រដ្ឋបាល ក្រុង ស្រុក ក្នុង ខេត្ត សៀមរាប ។
ចំណែក ចំណុច អវិជ្ជមាន ដែល កើត ពី ការផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ធ្វើឱ្យ មាន ការបំពុល សង្គម តាមរយៈ ការកេងចំណេញ ខាង នយោបាយ បក្សពួក ឬ ក្រុម និង ផលប្រយោជន៍ សារព័ត៌មាន ដែល ធ្វើឲ្យ ប្រជាពលរដ្ឋ មាន ការយល់ ច្រឡំ មក លើ រាជ រដ្ឋាភិបាល អាជ្ញាធរ មាន សមត្ថកិច្ច និង ប៉ះពាល់ ដល់ សិទ្ធិ បុគ្គល ជាដើម ។ ព័ត៌មាន មិន ពិត ឬ ព័ត៌មាន ក្លែងក្លាយ បង្កឲ្យ មាន ភាពចលាចល ដល់ សង្គម ការថ្នាំង ថ្នាក់ រវាង ប្រជាពលរដ្ឋ ជាមួយ រាជ រដ្ឋាភិបាល និង អាជ្ញាធរ មាន សមត្ថកិច្ច ។ល ។
ក្នុង នោះ ដែរ លោក លី សំរិទ្ធ ក៏ បាន ជំរុញ ឲ្យ មន្ត្រី ដែល ទទួលបាន ការបណ្តុះបណ្តាល ក្នុង វិស័យ ព័ត៌មាន សូម សរសេរ ព័ត៌មាន ឲ្យ មាន លក្ខណៈ ត្រឹមត្រូវ ពិតប្រាកដ តម្លាភាព និង គោរព វិជ្ជាជីវៈ និង អនុវត្ត ឲ្យបាន ត្រឹមត្រូវ តាម ច្បាប់ ស្តីពី របប សារព័ត៌មាន ស្រប តាម ប្រសាសន៍ លោក នាយក រដ្ឋមន្ត្រី ថា « អ្នកសារព័ត៌មាន កុំ បំពាន សិទ្ធិ អ្នកដទៃ កុំ បំភ្លៃ ការពិត ហើយ ត្រូវ គោរព សិទ្ធិ អ្នកដទៃ មិន មែន ចេះតែ ផ្សាយ តាម ចិត្ត នោះ ទេ »៕
យោង តាម លទ្ធផល នៃ ការបោះឆ្នោត ប៉ុន្មាន ជុំ មក នេះ វា ច្បាស់ ណាស់ ថា លោក ស៊ូណាក់ នឹង ឆ្លង ផុត ដល់ ដំណាក់កាល ២នាក់ ចុងក្រោយ ។ ដោយឡែក អ្វី ដែល មិន ប្រាកដ នោះ គឺ ពុំ ដឹង ថា តើ លោកស្រី ម័រ ដាន់ ឬ ក៏ លោកស្រី ត្រាស់ ដែល នឹង ក្លាយជា គូ ប្រជែង ចុងក្រោយ របស់ លោក ខណៈ អ្នក ទាំង ពីរ ទទួលបាន សំឡេង គាំទ្រ កាន់តែ ប្រកៀកប្រកិត គ្នា ខ្លាំង ។
ចាប់ពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ សភា អង់គ្លេស នឹង ឈានដល់ ពេល វិស្សមកាល ហើយ អំលុង ពេល នោះ បេក្ខជន ទាំង ២រូប នឹង ត្រូវ ឆ្លងកាត់ បោះឆ្នោត ជុំ ចុងក្រោយ ដែល ធ្វើឡើង ក្នុង ចំណោម សមាជិក ប្រមាណ ជា ២០០.០០០ នាក់ របស់ គណបក្ស អភិរក្ស និយម វិញ ម្តង មិន មែន ក្នុង ចំណោម សមាជិក សភា របស់ បក្ស ទៀត ឡើយ ។
គួរ បញ្ជាក់ ថា អ្នកទទួល ជ័យជម្នះ នឹង ត្រូវ ប្រកាស នៅ ថ្ងៃទី ៥ ខែកញ្ញា ដើម្បី ក្លាយជា ប្រធានបក្ស និង ជា នាយក រដ្ឋមន្រ្តី ជំនួស លោក ចន សុន ដែល កំពុង កាន់អំណាច បណ្តោះអាសន្ន ។ ការបោះឆ្នោត ជុំ ចុងក្រោយ នោះ ទៀតសោត នឹង មាន ន័យ ថា អង់គ្លេស អាចនឹង ទទួលបាន នាយក រដ្ឋមន្រ្តី ដំបូង បំផុត ដែល មាន ដើមកំណើត អាស៉ី ឬមួយ ក៏ នាយក រដ្ឋមន្រ្តី ជា ស្រ្តី ជា លើក ទី៣ នៅក្នុង ប្រវត្តិសាស្រ្ត របស់ ខ្លួន ៕
ខាងក្រោម នេះ ជា វីដេអូ ដែល បាន ផ្សព្វផ្សាយ ដោយ ក្រសួង ទេសចរណ៍ ស្តីពី សារសំខាន់ នៃ នីតិវិធី ប្រតិបត្ដិ ស្តង់ដា អប្បរមា (SOP ) តាម គន្លង ប្រក្រតី ភាព ថ្មី សម្រាប់ ផ្សារ ទំនើប ខ្នាត តូច៖
រដ្ឋមន្រ្តី ពាណិជ្ជកម្ម ដឹកនាំ ប្រតិភូ ក្រសួង ពាណិជ្ជកម្ម ចុះ ពិនិត្យ លំហូរ នៃ ការនាំចេញ កសិផល ពោត ក្រហម និង មៀន ប៉ៃលិន ដើម្បី សិក្សា ពី លទ្ធភាព នៃ ការធ្វើ ពិពិធកម្ម ទីផ្សារ ការជំរុញ នាំចេញ និង ការបង្កើន តម្លៃ បន្ថែម ក្នុង ខ្សែ ច្រវាក់ តម្លៃ សម្រាប់ កសិផល នៅ តាម បណ្តា ខេត្ត ជាប់ ព្រំដែន ថៃ
( ប៉ៃលិន) ៖ នា រសៀល ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម បាន ដឹកនាំ ប្រតិភូ ក្រសួង ពាណិជ្ជកម្ម ចុះ ពិនិត្យ រំហូរ នៃ ការនាំចេញ កសិផល ពោត ក្រហម និង មៀន ប៉ៃលិន ដើម្បី សិក្សា ពី លទ្ធភាព នៃ ការ ធ្វើ ពិពិធកម្ម ទីផ្សារ និង បន្ថែម តម្លៃ កែច្នៃ ទៅក្នុង ខ្សែ ច្រវាក់ តម្លៃ ផ្គត់ផ្គង់ ក សិផល នៅ តាម បណ្តា ខេត្ត ជាប់ ព្រំដែន ថៃ រួម មាន៖ ខេត្ត ប៉ៃលិន បាត់ដំបង បន្ទាយមានជ័យ និង ពោធិ៍សាត់ ។
ក្នុង ដំណើរ ចុះ ពិនិត្យ នេះ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង ពាណិជ្ជកម្ម ប្រធាន មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ប៉ៃលិន ខេត្ត បាត់ដំបង និង បន្ទាយមានជ័យ ដោយ មាន ការចូលរួម ផងដែរ ពី តំណាង មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ប៉ៃលិន តំណាង ម្ចាស់ សៃឡូ មកពី ខេត្ត ប៉ៃលិន បាត់ដំបង និង បន្ទាយមានជ័យ ព្រមទាំង មន្រ្តី រាជការ នៃ ក្រសួង - មន្ទីរ ពាណិជ្ជកម្ម ជាច្រើន រូប ទៀត ។
នៅក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី និង ប្រតិភូ ក្រសួង បាន ចុះ ទៅ ពិនិត្យ ផ្ទាល់ នូវ ស្ថានភាព នៃ ការនាំចេញ កសិផល នៅ តាម ច្រក ព្រំដែន កម្ពុជា - ថៃ និង ពិនិត្យ ផ្ទាល់ នៅ តាម ទីតាំង សៃ ឡូ មួយចំនួន នៅក្នុង ខេត្ត ប៉ៃលិន បាត់ដំបង និង បន្ទាយមានជ័យ ព្រមទាំង បាន ជួប សំណេះសំណាល និង ស្តាប់ សំណូមពរ របស់ តំណាង សៃ ឡូ ដើម្បី សិក្សា ស្វែងយល់ បន្ថែម ពី បញ្ហា ប្រឈម នានា ជុំវិញ ការអភិវឌ្ឍ ខ្សែ ច្រវាក់ តម្លៃ និង ការនាំចេញ ផលិតផល ពោត ក្រហម និង មៀន ប៉ៃលិន ទៅកាន់ ទីផ្សារ ក្រៅ ប្រទេស ។
ជា ការឆ្លើយតប លោក រដ្ឋមន្ត្រី បាន ជម្រាប ថា៖ - ការពិត ណាស់ ដែល វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ និង សង្គ្រាម នៅ ប្រទេស អ៊ុយក្រែន បាន បង្កឱ្យ ទំនិញ មួយចំនួន ឡើង ថ្លៃ តែ ទោះជា យ៉ាង នេះ ក៏ដោយ ក្រសួង ពាណិជ្ជកម្ម នៅតែ បន្ត ឃ្លាំមើល សទ្ទស្សន៍ ថ្លៃ ទំនិញ ដោយ មិន បណ្តោយ ឱ្យ មាន អតិផរណា កើតឡើង ពី ការឆ្លៀត ឱកាស ដំឡើង ថ្លៃ ទំនិញ ពី ជន ឬ ឈ្មួញ ខិល ខូច នោះ ឡើយ ។
- ចំពោះ ការយល់ដឹង ពី អត្ថប្រយោជន៍ នៃ ការចុះបញ្ជី ចម្ការ លោក រដ្ឋមន្ត្រី បាន ជម្រាប ថា ក្រោយ កម្ពុជា ចុះហត្ថលេខា លើ ពិធីសារ ជាមួយ ភាគី ចិន រួច មន្ត្រី ជំនាញ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ចុះ ផ្សព្វផ្សាយ ដល់ កសិករ អំពី អត្ថប្រយោជន៍ នៃ ការ ចុះបញ្ជី ចម្ការ សម្រាប់ ផលិតផល មៀន ប៉ៃលិន ហើយ បាន ចុះបញ្ជី ចម្ការ បាន មួយចំនួន ធំ ហើយ
- សម្រាប់ ផលិតផល ពោត ក្រហម ការយល់ដឹង អំពី ការអនុវត្ត កសិកម្ម ល្អ (GAP) នីតិវិធី សម្រាប់ ការស្នើសុំ ភូត គាម អនាម័យ ( SPS) និង ការបំពេញ បែបបទ សម្រាប់ ការនាំចេញ គឺ មាន ការតម្រូវ ឱ្យ អនុវត្ត តាម គោលការណ៍ ច្បាប់ និង កិច្ចព្រមព្រៀង តំបន់ និង អន្តរជាតិ ដែល ក្រសួង ពាណិជ្ជកម្ម នឹង បញ្ជូន សំណូមពរ នេះ ទៅ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ដើម្បី ពិនិត្យ និង ធ្វើ ការឆ្លើយតប តាម ការប្រញាប់ ដែល អាច ធ្វើ ទៅ បាន ផងដែរ ។
- ចំពោះ ការកំណត់ ស្តង់ដារ ទម្ងន់ រថយន្ត ផ្ទុក ខុសគ្នា រវាង កម្ពុជា និង ថៃ ក្រសួង ពាណិជ្ជកម្ម នឹង ពាំនាំយក សំណូមពរ នេះ ជូន ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ដើម្បី ពិនិត្យ និង ឆ្លើយតប លើ លទ្ធភាព នៃ ការធ្វើ សុខដុមនីយកម្ម លើ រថយន្ត ដឹក ទំនិញ របស់ ឈ្មួញ ថៃ ដែល មក ទិញ ពោត ក្រហម ដោយ ធ្វើ យ៉ាងណា ឱ្យ ស្រប ទៅតាម ស្តង់ដារ កំណត់ ។
តំណាង រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ចូលរួម កិច្ចប្រជុំ មហាសន្និបាត លើក ទី ៦៣ នៃ ប្រទេស ជា សមាជិក របស់ អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក នៅ ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស
( ហ្សឺណែវ . ស្វីស ) ៖ លោក អ៊ុក ប្រជា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម តំណាង លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន ដឹកនាំ គណៈប្រតិភូ ក្រសួង ពាណិជ្ជកម្ម ចូលរួម កិច្ចប្រជុំ មហាសន្និបាត លើក ទី ៦៣ នៃ ប្រទេស ជា សមាជិក របស់ អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក ចាប់ពី ថ្ងៃទី ១៤ - ២២ ខែកក្កដា ឆ្នាំ ២០២២ ដោយ មាន ប្រទេស ជា សមាជិក ចូលរួម ចំនួន ១៨៦ ប្រទេស ។
ក្នុង កិច្ចប្រជុំ នេះ ក្នុង នាម ប្រធាន គណៈប្រតិភូ កម្ពុជា បាន ថ្លែង ក្នុង មហាសន្និបាត នេះ ដោយ បាន សម្ដែង នូវ ការអបអរសារទរ ចំពោះ លោក Daren Tang ដែល ត្រូវបាន បោះឆ្នោត ជ្រើសរើស អគ្គ នាយក អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក និង បាន លើកឡើង អំពី វឌ្ឍនភាព វិស័យ កម្មសិទ្ធិ បញ្ញា នៅ កម្ពុជា និង កោតសរសើរ ពី កិច្ចសហប្រតិបត្តិការ ប្រកបដោយ ផ្លែផ្កា និង អត្ថន័យ ជាមួយ អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក (WIPO) កន្លងមក ចាប់តាំងពី កម្ពុជា បាន ចូល ជា សមាជិក អង្គការ នេះ កាលពី ឆ្នាំ ១៩៩៥ ។
បន្ទាប់មក លោក រដ្ឋលេខាធិការ បាន បង្ហាញ ពី ការប្តេជ្ញា របស់ កម្ពុជា ក្នុង ការបន្ត ចូលរួម យ៉ាង សកម្ម ជាមួយនឹង អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក ក្នុង នាម ជា សមាជិក និង បន្ត លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ឱ្យ កាន់តែ ជិតស្និទ្ធ បន្ថែម ទៀត ។
លោក ប្រធាន គណៈប្រតិភូ បាន បន្ថែម ទៀត ថា លោក មាន សុទិដ្ឋិនិយម ជឿជាក់ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការដឹកនាំ របស់ លោក Daren Tang ដែល នឹង ជួយ លើកកម្ពស់ ប្រព័ន្ធ កម្មសិទ្ធិ បញ្ញា ជា សកល ពិសេស គាំទ្រ ប្រទេស អភិវឌ្ឍន៍ តិចតួច ក្នុង ការកង សាង ហេដ្ឋារចនាសម្ព័ន្ធ កម្មសិទ្ធិ បញ្ញា និង ពង្រឹង ការអនុវត្ត ច្បាប់ កម្មសិទ្ធិ បញ្ញា ។
ក្នុង ឱកាស នេះ លោក រដ្ឋលេខាធិការ ប្រធាន គណៈប្រតិភូ បាន ស្នើសុំ លោក អគ្គ នាយក អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក បន្ត គាំទ្រ និង ផ្តល់ ជំនួយ បច្ចេកទេស បណ្តុះបណ្តាល ធុរៈ កិច្ច ថ្មី ក្នុង វិស័យ កម្មសិទ្ធិ បញ្ញា ការអនុវត្ត ផែនការ សកម្មភាព របស់ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង កម្មសិទ្ធិ បញ្ញា កម្ពុជា ឆ្នាំ ២០២១ - ២០២៣ ដូចជា ការចុះបញ្ជី ទំនិញ សម្គាល់ ភូមិសាស្រ្ត ។
ជា ចុងបញ្ចប់ លោក អគ្គ នាយក អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក សន្យា នឹង បន្ត ជួយ គាំទ្រ គម្រោង នានា របស់ កម្ពុជា បន្ថែម ទៀត ដើម្បី ជួយ លើកកម្ពស់ វិស័យ កម្មសិទ្ធិ បញ្ញា នៅ កម្ពុជា ៕ កម្មវិធី ផ្សាយ ផ្ទាល់ « កិច្ចសន្ទនា អនឡាញ ស្ដីពី កសិកម្ម កម្ពុជា ចិន » រៀបចំឡើង ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន បាន ប្រព្រឹត្តទៅ ដោយ ជោគជ័យ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ កម្មវិធី ផ្សាយ ផ្ទាល់ « កិច្ចសន្ទនា អនឡាញ ស្ដីពី កសិកម្ម កម្ពុជា ចិន » ដែល រៀបចំឡើង ដោយ វិទ្យុ មិត្តភាព កម្ពុជា ចិន នៃ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ ចិន បាន ប្រព្រឹត្តទៅ ដោយ ជោគជ័យ ។
ឯកឧត្ដម វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ព្រមទាំង ភ្ញៀវ កិត្តិយស ផ្នែក វិស័យ កសិកម្ម កម្ពុជា បាន ពិភាក្សា គ្នា យ៉ាង ស៊ីជម្រៅ លើ ប្រធានបទ មួយ ចំនួន រួម មាន ការពង្រីក កិច្ចសហប្រតិបត្តិការ កសិកម្ម កម្ពុជា ចិន នៅក្រោម ក្របខណ្ឌ « ខ្សែក្រវាត់ និង ផ្លូវ » កំណើត ផលិតផល កសិកម្ម កម្ពុជា និង ភូត គាម អនាម័យ នាំចេញ ទៅ ប្រទេស ចិន ។
ឯកឧត្ដម វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ គំនិត ផ្ដួច ផ្ដើម « ខ្សែក្រវាត់ និង ផ្លូវ » ដែល បាន ផ្ដល់ នូវ ផលប្រយោជន៍ ជាច្រើន សម្រាប់ កម្ពុជា ។
ស្រប ពេល គ្នា នោះ ឯកឧត្ដម ក៏ បាន ថ្លែងអំណរគុណ កម្មវិធី លើក នេះ ដែល បាន យកចិត្តទុកដាក់ លើ វឌ្ឍនភាព កសិកម្ម កម្ពុជា និង រួមចំណែក ក្នុង ការជំរុញ កិច្ចសហប្រតិបត្តិការ កសិកម្ម កម្ពុជា ចិន ។ ឯកឧត្ដម យល់ឃើញ ថា តាមរយៈ កិច្ចពិភាក្សា នេះ ភាគី ទាំង ពីរ យល់ កាន់តែ ច្បាស់ ពី តួនាទី និង ភារកិច្ច របស់ ខ្លួន នៅក្នុង ទំនាក់ទំនង ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ដែល នេះ នឹង ជំរុញ ដំណើរ បង្កើត សហគមន៍ វាសនា រួម កម្ពុជា ចិន មួយ កម្រិត បន្ថែម ទៀត ។
លោក លន់ យ៉េង អគ្គ លេខាធិការ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន លើកឡើង ថា ថ្នាក់ដឹកនាំ នៃ ប្រទេស ទាំង ពីរ កម្ពុជា ចិន បាន យកចិត្តទុកដាក់ ខ្ពស់ លើ ការនាំចេញ អង្ករ ពី កម្ពុជា ទៅ ប្រទេស ចិន ។ គិត ត្រឹម ខែមិថុនា ឆ្នាំ ២០២២ នៅក្រោម ក្របខណ្ឌ អនុសារណៈ យោគយល់ លើក ទី៦ អង្ករ កម្ពុជា នាំចេញ ទៅ ប្រទេស ចិន សម្រេចបាន ៤៥ ភាគរយ ។ ជឿជាក់ ថា នៅក្រោម ការខិតខំ ប្រឹងប្រែង របស់ ភាគី ទាំង ពីរ បរិមាណ ការផលិត កែច្នៃ និង នាំចេញ អង្ករ កម្ពុជា ទៅ ទីផ្សារ ប្រទេស ចិន នឹង បំបែក កំណត់ ត្រា កាន់តែ ខ្ពស់ ថែម ទៀត ។
លោក កាន់ គន្ធី នាយក ប្រតិបត្តិ ក្រុមហ៊ុន សាជីវកម្ម កសិកម្ម កម្ពុជា បាន មានប្រសាសន៍ ថា សង្ឃឹម ថា សហគ្រាស ចិន អាច វិនិយោគ ដោយ ផ្ទាល់ ឬ សហការ វិនិយោគ ជាមួយ សហគ្រាស កម្ពុជា លើ ផលិតផល កសិកម្ម កែច្នៃ រួច នាំចេញ ផលិតផល សម្រេច ទៅ ប្រទេស ចិន ។
ក្រៅពី នេះ កិច្ចសន្ទនា នោះ ក៏ បាន គោរព អញ្ជើញ ឯកឧត្ដម ឃឹម វុទ្ធី អគ្គ នាយក ទូរទស្សន៍ ជាតិ កម្ពុជា និង លោក លឹម ជា វុត្ថា ស្ថាបនិក និង អគ្គ នាយក សារព័ត៌មាន Fresh News ដែល ល្បី ឈ្មោះ ជាង គេ នៅ កម្ពុជា ព្រមទាំង លោកស្រី អរុណ អគ្គ នាយិកា វិទ្យុ មិត្តភាព កម្ពុជា ចិន ចូលរួម ពិភាក្សា ពី ការពង្រីក កិច្ចសហប្រតិបត្តិការ ផ្សព្វផ្សាយ ព័ត៌មាន កសិកម្ម របស់ ប្រទេស ទាំង ពីរ នា ពេល បច្ចុប្បន្ន ក៏ ដូចជា នា ពេល អនាគត ផងដែរ ៕
រដ្ឋបាល ខេត្ត ឧត្ដរ មានជ័យ ប្រារព្ធ ពិធី បុណ្យ រុក្ខ ទិវា និង ទិវា មច្ឆា ជាតិ នៅ បរិវេណ ស្ថានីយ កសិកម្ម កូន ក្រៀល
( ឧត្ដរ មានជ័យ ) ៖ នា ព្រឹក ថ្ងៃពុធ ទី២០ ខែកក្កដា ឆ្នាំ ២០២២ លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្ដរ មានជ័យ និង លោក ស៊ី ប្រា សិទ្ធ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី អបអរសាទរ ពិធី បុណ្យ រុក្ខ ទិវា និង ទិវា មច្ឆា ជាតិ ដែល ប្រព្រឹត្តទៅ នៅក្នុង បរិវេណ ស្ថានីយ កសិកម្ម កូន ក្រៀល ស្ថិត នៅក្នុង ក្រុង សំរោង ខេត្ត ឧត្ដរ មានជ័យ ។
លោក បន្ត ថា បច្ចុប្បន្ន « រុក្ខ ទិវា » ត្រូវបាន ទទួលស្គាល់ ជា ផ្លូវការ ដោយ មាន ចែង ក្នុង ច្បាប់ ស្ដីពី ព្រៃឈើ នា ឆ្នាំ ២០០២ ជំពូក ទី ១២ មាត្រា ទី៦០ បាន ចែង ថា៖ ដើម្បី ជំរុញ ការអប់រំ ប្រជាពលរដ្ឋ ឱ្យ យល់ដឹង ពី សារសំខាន់ និង ផលប្រយោជន៍ ព្រៃឈើ ទិវា ពលកម្ម ដាំ កូន ឈើ ជា ប្រពៃណី ជាតិ ហៅ ថា « រុក្ខ ទិវា » ត្រូវបាន ប្រារព្ធ ធ្វើឡើង នៅ ថ្ងៃទី ៩ ខែកក្កដា ជារៀងរាល់ ឆ្នាំ ប៉ុន្តែ សម្រាប់ ខេត្ត ឧត្តរមានជ័យ ឆ្នាំ នេះ ខេត្ត ឧត្ដរ មានជ័យ ត្រូវបាន លើក ពេល មក ប្រារព្ធ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ ។
លោក អភិបាល ខេត្ត ក៏ បាន ណែនាំ ឱ្យ អង្គភាព បំរើ សេវា សាធារណៈ ត្រូវតែ រៀបចំ កែលម្អ អង្គភាព របស់ ខ្លួន ឲ្យបាន ស្អាត ដោយ រៀបចំ សួនច្បារ ដាំ កូន ឈើ និង មាន អំពូលភ្លើង បំភ្លឺ ក្នុង បរិវេណ មន្ទីរ - អង្គភាព របស់ ខ្លួន ដើម្បីឲ្យ ពុក ម៉ែ បងប្អូន ប្រជាពលរដ្ឋ មក រក សេវា មាន ទំនុកចិត្ត ។ ទន្ទឹម នឹង នោះ ដែរ ឯកឧត្តម អភិបាល ខេត្ត បាន ដាក់ បទបញ្ជា ឲ្យ លោក ស្នងការ នគរបាល ខេត្ត គ្រប់ រថយន្ត ធន់ ធំ ទាំងអស់ មិន ត្រូវ ធ្វើចរាចរណ៍ នៅលើ ផ្លូវ ក្នុង ក្រុង សំរោង ឡើយ ដោយ តម្រូវឲ្យ ប្រើប្រាស់ ផ្លូវ វាង ក្រុង ជំនួស វិញ ។
បើ តាម របាយការណ៍ របស់ លោក សូត្រ ស៊ីសុខ ឃាង ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រម៉ាញ់ និង នេសាទ ខេត្ត ឧត្តរមានជ័យ បាន ថ្លែង ថា ពិធី ដាំ កូន ឈើ ថ្ងៃ នេះ មាន ចំនួន ប្រមាណ ៣០០០ ដើម នៅលើ ផ្ទៃដី ០៣ ហិកតា និង ប្រលែង ត្រី ចំនួន ២០០០០ កូន ដើម្បី អបអរសាទរ ពិធី បុណ្យ រុក្ខ ទិវា និង ទិវា មច្ឆា ជាតិ ៕ គ.ជ. ប ចេញ សេចក្ដីណែនាំ ស្ដីពី ការដាក់ ឲ្យ ដំណើរការ កម្មវិធី ផ្លាស់ប្តូរ ឯកសារ ចុះឈ្មោះ បោះឆ្នោត អស់ សុពលភាព តាម ប្រព័ន្ធ អ៊ីនធឺណិត
ខាងក្រោម នេះ ជា សេចក្ដីណែនាំ របស់ គ.ជ. ប ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖
អភិបាល ស្រុក បារាយណ៍ អំពាវនាវ ឲ្យ គ្រប់ ឃុំ ធ្វើ ផែនការ ថវិកា ដើម្បី គាំទ្រ ដល់ សហគមន៍
( កំពង់ធំ )៖ លោក អ៊ួង សារឿន អភិបាល ស្រុក បារាយណ៍ បាន អំពាវនាវ ឲ្យ គ្រប់ ឃុំ ធ្វើ ផែនការ ថវិកា ដើម្បី គាំទ្រ ដល់ សហគមន៍ ។ លោក អ៊ួង សារឿន បាន ថ្លែង យ៉ាង ដូច្នេះ នៅក្នុង កិច្ចប្រជុំ ជុំ ទី២ ជាមួយ សហគមន៍ ក្នុង ស្រុក សន្ទុក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នៅ សាលា ស្រុក បារាយណ៍ ដើម្បី រក បញ្ហា ប្រឈម យកមក ធ្វើ ការដោះស្រាយ ។
កម្មវិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពី អាជ្ញាធរ មូលដ្ឋាន តំណាង សហគមន៍ ក្នុង ស្រុក បារាយណ៍ ដែល រៀបចំ អង្គការ វិទ្យាស្ថាន តស៊ូ មតិ និង គោល នយោបាយ (API) ។
ជាមួយគ្នា នេះ ប្រធាន សហគមន៍ ស្រះ ជម្រក ត្រី បាន លើកឡើង ពី បញ្ហា ប្រឈម ក្នុង សហគមន៍ របស់ ពួកគាត់ ផងដែរ នៅពេល ទឹក រីងស្ងួត នៅ រដូវ ប្រាំង ពិបាក ការពារ ត្រី ដោយសារ ប្រជាជន មួយចំនួន បាន យក សំណាញ់ លួច បង់ ត្រី និង ខ្វះខាត ថវិកា សម្រាប់ ស្តារ កំប៉ោក ចក និង ថវិកា ឧបត្ថម្ភ ដល់ គណៈកម្មការ ចុះ ដើរល្បាត ដល់ សហគមន៍ ពួកគាត់ ។
លោក អ៊ួង សារឿន បាន ថ្លែងអំណរគុណ អង្គការ វិទ្យាស្ថាន តស៊ូ មតិ និង គោល នយោបាយ (API) និង អង្គការ ដៃគូរ ដែល បាន ជួយ គាំទ្រ ដល់ ដំណើរការ របស់ សហគមន៍ ក្នុង ស្រុក ដើម្បីឲ្យ មាន ការកែប្រែ និង អភិវឌ្ឍន៍ និង ជំរុញ អាជ្ញាធ មូលដ្ឋាន ត្រូវ រៀបចំ ផែនការ ថវិកា ដើម្បី ជួយ គាំទ្រ កម្មវិធី ដល់ សហគមន៍ ហើយ អាជ្ញាធរ ទាំងអស់ ត្រូវ ផ្សព្វផ្សាយ អំពី ថវិកា ឲ្យបាន ទៅដល់ បងប្អូន ប្រជាពលរដ្ឋ នៅ តាម ខ្នង ផ្ទះ ។
លោក បន្ត ថា រាល់ ពេល ចូលរួម ប្រជុំ ជាមួយ ឃុំ សូមឲ្យ សហគមន៍ លើក ផែនការ របស់ សហគមន៍ បញ្ជូល ជាមួយ ផែនការឃុំ ហើយ សហគមន៍ គួរតែ បង្កើត កន្លែង ទេសចរ ខ្លួន ឯង ដើម្បី រក ចំណូល ចូល សហគមន៍ ដើម្បី ទុក ទ្រទ្រង់ សហគមន៍ ដោយ ខ្លួន ឯង វា ជា ជាង សុំ ថវិកា ពី ខាងក្រៅ និង បន្ត ស្វែងរក អង្គការ ដៃគូ អភិវឌ្ឍន៍ ដើម្បី ជួយ គាំទ្រ បន្ថែម ។
ទន្ទឹមនឹង នេះ លោក ឲ្យ ឃុំ និង សហគមន៍ បន្ត ការផ្សព្វផ្សាយ អំពី តំបន់ ការពារ នឹង អភិរក្ស ឲ្យ ប្រជាពលរដ្ឋ បាន យល់ នឹង ឲ្យបាន ដឹង ពី អត្ថប្រយោជន៍ នៃ តំបន់ អភិរក្ស ទាំងនោះ ។ យើង ទាំងអស់ ចូលរួម ជាមួយគ្នា ទាំង សហគមន៍ ឃុំ អង្គការ និង រដ្ឋបាល ស្រុក រិះរក ដំណោះស្រាយ លើ បញ្ហា ប្រឈម ពី ធំ ទៅ តូច នឹង ពី តូច ទៅជា គ្នា បញ្ហា ហើយ មាន តែ យើង ទាំងអស់ គ្នា ទេ ដែល អាច ធ្វើ បាន ៕ កម្លាំង អាវុធហត្ថ ខេត្ត ព្រះសីហនុ បង្ក្រាប ជនសង្ស័យ ២៧ នាក់ ពាក់ព័ន្ធ បទល្មើស គ្រឿងញៀន
( ព្រះសីហនុ) ៖ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ព្រះសីហនុ បាន បង្ក្រាប និង ចាប់ខ្លួន ជនសង្ស័យ ២៧ នាក់ ពាក់ព័ន្ធ នឹង បទល្មើស គ្រឿងញៀន រួច បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ព្រះសីហនុ ជា បន្តបន្ទាប់ ដើម្បី ផ្តន្ទាទោស តាម ច្បាប់ ។
បើ តាម លោក ឡុង គឹម ហួរ ជនសង្ស័យ ទាំងនេះ ត្រូវបាន បញ្ជូន ខ្លួន ទៅ សាលាដំបូង ខេត្ត ព្រះសីហនុ ដើម្បី ផ្តន្ទាទោស តាម ផ្លួវ ច្បាប់ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ៕
កាលពី ថ្ងៃទី ១៩ កក្កដា ក្រុមហ៊ុន ឆាយ ណា ជិន វ័រ យាន អ៊ឹម ផត អិច ថត បាន ប្រកាស តម្លៃ បញ្ជាទិញ មៀន ក្នុង តម្លៃ ជាក់លាក់ ពី ចាប់ពី ៣.៣០០ រៀល ទៅ៤. ៥០០ រៀល ក្នុង មួយ គីឡូក្រាម និង បាន ចុះ កិច្ចសន្យា ទិញ មៀន ប៉ៃលិន ជាមួយ សហគមន៍ មៀន ប៉ៃលិន ទាំង ៤រួម មាន ខេត្ត ប៉ៃលិន បាត់ដំបង បន្ទាយមានជ័យ និង ពោធិ៍សាត់ ចាប់ពី ខែកញ្ញា ឆ្នាំ ២០២២ រហូតដល់ ខែមិថុនា ឆ្នាំ ២០២៣ ។ ក្នុង ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម ។
លោក ប៉ាន សូរស័ក្តិ បាន ចាត់ទុក ការចុះ កិច្ចព្រមព្រៀង ទិញ ផ្លែ មៀន ប៉ៃលិន រវាង ក្រុមហ៊ុន របស់ ចិន និង សហគមន៍ មៀន ប៉ៃលិន ក្នុង ខេត្ត បៃលិន បាត់ដំបង បន្ទាយមានជ័យ និង ឧត្តរមានជ័យ ជា ជំហាន ជោគជ័យ មួយ ទៀត សម្រាប់ អ្នក ប្រកបរបរ ដាំ មៀន ប៉ៃលិន ។ ជាពិសេស ធ្វើឱ្យ ផ្លែ មៀន ប៉ៃលិន ធានា បាន តម្លៃ មួយ ច្បាស់លាស់ ។
លោក រដ្ឋមន្ត្រី បាន បង្ហាញ នូវ ក្ដីសង្ឃឹម យ៉ាង មុតមាំ ថា ក្រោយ ពិធី ចុះ កិច្ចព្រមព្រៀង នេះ គ្រប់ ភាគី ទាំងអស់ នឹង សហការ គ្នា ឱ្យ កាន់តែ មាន ភាពជិតស្និទ្ធ នៅក្នុង ការជួយ ជំរុញ ដំណើរការ សេដ្ឋកិច្ច ជាតិ កាន់តែ មាន ភាពរីកចម្រើន និង ជួយ ផលិតកម្ម ដែល មាន គោលដៅ ចុងក្រោយ គឺ បង្កើន ប្រាក់ ចំណូល ជូន កសិករ ជា អ្នក ដាំ មៀន ។
លោក បន្ត ថា ក្រុមហ៊ុន គ្រោង បញ្ជាទិញ សម្រាប់ នាំចេញ ទៅ ប្រទេស ចិន ដោយ ផ្ទាល់ ក្នុង បរិមាណ មិន កំណត់ នោះ ទេ សម្រាប់ ខេត្ត ទាំង៤ ។
បច្ចុប្បន្ន នេះ ផ្ទៃដី ដាំ មៀន ប៉ៃលិន នៅ កម្ពុជា មាន ចំនួន ប្រមាណ ជាង ៨ ពាន់ ហិកតា ។ មៀន ប៉ៃលិន ភាគ ច្រើន ដាំដុះ នៅ ខេត្ត ចំនួន រួម មាន ប៉ៃលិន បន្ទាយមានជ័យ បាត់ដំបង និង ពោធិ៍សាត់ ៕
អភិបាល រាជធានី ភ្នំពេញ៖ ការកែលម្អ ស្ថានីយ៍ បូម ទឹក និង ប្រព័ន្ធ ប្រឡាយ បឹងត្របែក ត្រូវបាន រាំងស្ទះ ដោយសារ ជំងឺ កូវីដ
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ថ្លែង ថា ការងារ ស្តារ អាង ស្តុក ទឹក ការស្ថាបនា ជញ្ជាំង បេតុង ទប់ ដី ព័ទ្ធ ជុំវិញ អាង ស្តុក ទឹក និង ស្ដារ ភក់ ចេញ ពី អាង ស្តុក ទឹក ប្រឡាយ បឹងត្របែក ក៏ ដូចជា ការកែលម្អ ដាក់ ម៉ូទ័រ បូម ថ្មី ដែល មាន សមត្ថភាព បូម ខ្លាំង គឺ គ្រោង ធ្វើ តាំងពី ២ឆ្នាំ មុន មក ម្ល៉េះ ដោយ បាន បញ្ជាទិញ ម៉ូទ័រ បូម ពី ប្រទេស អាល្លឺម៉ង់ ។ ប៉ុន្តែ គម្រោង នេះ ត្រូវបាន អាក់ខាន ដោយសារ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ ។
កាលពី សប្តាហ៍ មុន លោក អភិបាល រួម ជាមួយ មន្ត្រី ជំនាញ និង អាជ្ញាធរដែនដី បាន ចុះ ទៅ ពិនិត្យ ជាក់ស្តែង តាម ស្ថានីយ៍ បូម ទឹក និង ប្រឡាយ បង្ហូរ ទឹក មាន ស្ថានីយ៍ បឹងត្របែក ស្ថានីយ៍ បឹង ទំពន់ ប្រឡាយ ស្ទឹងមានជ័យ ជាដើម ដើម្បី រិះរក វិធានការរំដោះ ទឹក លិច ដោយ ជំនន់ ទឹកភ្លៀង ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។
បញ្ហា នេះ លោក អភិបាល រាជធានី ភ្នំពេញ បាន ណែនាំឲ្យ មន្ទីរ សាធារណការ លើក ស្លាក បង្ហាញ ពី គម្រោង ស្តារ អាង ស្តុក ទឹក នេះ ដោយ ដាក់ ឲ្យបាន ច្រើន កន្លែង ដើម្បីឲ្យ ប្រជាពលរដ្ឋ បាន ជ្រួតជ្រាប ពី ច្បាប់ ចំណែក អាជ្ញាធរដែនដី ពាក់ ពន្ធ័ ត្រូវ ចុះ ពិនិត្យ បង្គោល កំណត់ ព្រំ ផ្ទៃ បឹង ដែល បាន បោះ រួចហើយ ។
លោក ឃួង ស្រេង ក៏ បាន ជំរុញ ឲ្យ បង្កើត ក្រុមការងារ ចំនួន ២ គឺ៖
* ទី១៖ ក្រុមការងារ បច្ចេកទេស * ទី២៖ ក្រុមការងារ ដោះស្រាយ ផល ប៉ះពាល់ ឲ្យបាន រួចរាល់ មុននឹង ចុះ អនុវត្ត គំរោង ឲ្យបាន ឆាប់ បំផុត ៕ រយៈពេល ២ ថ្ងៃ ក្រុមការងារ បាន ចុះបញ្ជី ដី មាន លក្ខណៈ ជា ប្រព័ន្ធ ជូន ពលរដ្ឋ ៥០ ក្បាល ដី នៅ ក្រុង បាន លុង ខេត្ត រតនគិរី
( រតនគិរី ) ៖ រយៈពេល ២ ថ្ងៃ គឺ ថ្ងៃទី ១៩ - ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ក្រុមការងារ ចុះ ប្រមូល ទិន ន្ន័យ និង វិនិច្ឆ័យ ក្បាល ដី ចុះបញ្ជី មាន លក្ខណៈ ជា ប្រព័ន្ធ ដឹកនាំ ដោយ លោក ប៊ី ជីវន្ត ដារ៉ា ប្រធាន ការិយាល័យ ភូមិបាល ក្រុង បាន លុង បាន ចុះ តាម ខ្នង ផ្ទះ ប្រជាពលរដ្ឋ នៅក្នុង ភូមិសិល្ប៍ សង្កាត់ យក្ស ឡោម ក្រុង បាន លុង បាន ចំនួន ៥០ ក្បាល ដី ។
លោក ប៊ី ជីវន្ត ដារ៉ា បាន ឱ្យដឹង ថា ទោះបី រដូវ វស្សា មាន ភ្លៀង ធ្លាក់ ជោគជាំ ស្ទើរ រាល់ ថ្ងៃ រូប លោក និង មន្ត្រី ក្រោម ឱវាទ ចុះ មកដល់ តាម ខ្នង ផ្ទះ ពួកគាត់ ឱ្យ ចូលរួម សហការ វាស់វែង ក្បាល ដី ជា លក្ខណៈ ប្រព័ន្ធ ដោយ មិន ខ្លាច ការនឿយហត់ ភ្លៀង ខ្យល់ ហើយ មិន គិត កម្រៃ នោះ ទេ ។
លោក បន្ត ថា ក្រោយពី ប្រជាពលរដ្ឋ ទទួលបាន ឯកសារ ចុះបញ្ជី ដីធ្លី ជា លក្ខណៈ ប្រព័ន្ធ រួចហើយ នោះ វា មាន សារៈសំខាន់ ណាស់ សម្រាប់ យក ទៅ ប្រើប្រាស់ តាម តម្រូវការ ផ្សេង ៗ ។ ដូច្នេះ គួរតែ ពួក គាត់ ចូលរួម ទាំងអស់ គ្នា ដោយ មន្ត្រី លោក រងចាំ បម្រើ គ្រប់ ពេលវេលា ដោយ មិន ឱ្យ បងប្អូន ឡើង មក ការិយាល័យ អស់ សោហ៊ុយ នោះ ទេ ។
ជាង នេះ ទៅ ទៀត ក្រុមការងារ វាស់វែង ក្បាល ដី ចុះបញ្ជី ជា លក្ខណៈ ប្រព័ន្ធ សូម ឱ្យ ប្រជាពលរដ្ឋ ដែល រស់ នៅ ទីតាំង ខាងលើ ដែល ធ្វើដំណើរ ទៅ ទី ឆ្ងាយ សូម ត្រឡប់មក ផ្ទះ វិញ ដើម្បី ចូលរួម ជាមួយ ក្រុមការងារ ដោយ ភ្ជាប់ មក ជាមួយ ដូចជា អត្តសញ្ញាណប័ណ្ណ . សៀវភៅ គ្រួសារ . លិខិត កំណើត និង សំបុត្រ អាពាហ៍ពិពាហ៍ ជាដើម ៕
ជូនដំណឹង ! អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង ជូន ព័ត៌មាន ដល់ ភ្ញៀវ ទេសចរណ៍ ឲ្យ ផ្អាក ការមក លេង កម្សាន្ត នៅ តំបន់ ទេសចរណ៍ ថ្ម ក្រាល ជា បណ្ដោះអាសន្ន ដោយសារ ទឹក ជន់ បាក់ ទំនប់ កាត់ផ្តាច់ ផ្លូវ
( កំពង់ឆ្នាំង ) ៖ ទំនប់ ចាក់ ទឹម ស្ថិត នៅក្នុង ភូមិ កោះ ខ្ទុម ឃុំ ជៀប ស្រុក ទឹក ផុស ត្រូវបាន ជំនន់ ទឹកភ្លៀង ជន់ បាក់ អស់ ប្រវែង ៥០ម៉ែត្រ កាលពី យប់ ម៉ោង ២៖០០ នាទី រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ ដែល ករណី បាក់ ទំនប់ នះ បាន កាត់ផ្ដាច់ ផ្លូវ ធ្វើដំណើរ ទៅ លេង តំបន់ ទេសចរណ៍ ទឹក ធ្លាក់ ថ្ម ក្រាល ផងដែរ ។
លោក ខែ ម វិបុល អធិការ នគរបាល ស្រុក ទឹក ផុស នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា នេះ បាន ឲ្យដឹង ថា ដោយសារ កាលពី ថ្ងៃទី ១៩ ម្សិលមិញ នេះ ភ្លៀង បាន ធ្លាក់ ពេញ មួយ ថ្ងៃ មួយ យប់ បង្កឲ្យ ទំនប់ ចាក់ ទឹម ត្រូវ ជន់ បាក់ អស់ ប្រវែង ប្រមាណ ៥០ ម៉ែត្រ នៅ វេលា ម៉ោង ២រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ២០ ខែកក្កដា នេះ ។ ករណី បាក់ ទំនប់ នេះ បាន ធ្វើឱ្យ បាត់បង់ ទ្រព្យសម្បត្តិ ប្រជាពលរដ្ឋ មួយ ខ្នង ផ្ទះ នៅ ខាងក្រោម ទំនប់ ផងដែរ ប៉ុន្តែ មិន បណ្ដាលឱ្យ មាន គ្រោះថ្នាក់ ដល់ ជីវិត មនុស្ស ឡើយ ។
ទាក់ទង នឹង ករណី នេះ លោក ដោក ប៊ុន ថុន ប្រធាន មន្ទីរ ធនធាន ទឹក ខេត្ត កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា នេះ បាន បញ្ជាក់ ថា ទំនប់ ចាក់ ទឹម ពិតជា ត្រូវ ជំនន់ ទឹកភ្លៀង ជន់ បាក់ ប្រវែង ៥០ម៉ែត្រ ពិត មែន កាល យប់ មិញ នេះ ដោយសារតែ ធ្លាក់ ភ្លៀង ពេញ មួយ ថ្ងៃ មួយ យប់ ។
( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ដាស់តឿន ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ប្រឹងប្រែង ធ្វើ អនាម័យ សំអាត ក្នុង បរិវេណ លំនៅដ្ឋាន របស់ ខ្លួន ពិសេស លុបបំបាត់ ឲ្យ អស់ នូវ សំភារៈ នានា ដែល ជា ប្រភព នៃ ជម្រក មូស ខ្លា ខណៈ មាន កុមារ ២នាក់ បាន ស្លាប់ ដោយ ជំងឺ គ្រុន ឈាម ។
ការដាស់តឿន យ៉ាង ដូច្នោះ ស្រប ពេល ដែល លោក វ៉ី សំណាង បាន អញ្ជើញ ជា អធិបតី ក្នុង យុទ្ធនាការ អប់រំ ផ្សព្វផ្សាយ ស្ដីពី ការបង្ការ និង ទប់ស្កាត់ ជំងឺ គ្រុន ឈាម នៅ ភូមិ ព្រៃ កន្ទាច សង្កាត់ សុព័រ ទេព ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ ។
ក្នុង ឱកាស នោះ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាន លើកឡើង ថា មូស ខ្លា គឺជា ភ្នាក់ងារ ចម្លង ដ៏ មាន ប្រសិទ្ធិភាព នៃ ជំងឺ គ្រុន ឈាម វា អាច ធ្វើ អាច សម្លាប់ កុមារ តូច ៗ ក្នុង រយៈពេល ដ៏ ខ្លី ប្រសិនជា មាតាបិតា របស់ កុមារ មាន ការធ្វេសប្រហែស ឬ មិន បាន យកចិត្តទុកដាក់ នាំ ទៅឲ្យ ក្រុម គ្រូពេទ្យ ព្យាបាល ទាន់ ពេលវេលា ហើយ បច្ចុប្បន្ន ជំងឺ នេះ ក៏ បាន ចម្លង ទៅកាន់ មនុស្ស ចាស់ ផងដែរ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា សុខាភិបាល ជា វិស័យ អាទិភាព មួយ ក្នុង ចំណោម វិស័យ អាទិភាព ជាច្រើន របស់ រាជ រដ្ឋាភិបាល ដែល ដាក់ ចេញ ជា គោលដៅ អភិវឌ្ឍន៍ ជាតិ ក្នុង ការកាត់បន្ថយ មរណភាព របស់ កុមារ អាយុ ក្រោម ៥ ឆ្នាំ ការលើកកម្ពស់ សុខភាព មាតា និង ការប្រយុទ្ធ នឹង ជំងឺ អេដស៍ របង គ្រុនចាញ់ គ្រុន ឈាម ជំងឺ ឆ្លង ដ៏ ទៀត បញ្ហា សុខភាព សាធារណៈ និង គ្រោះមហន្តរាយ ។
លើស ពី នេះ លោក បាន លើកឡើង ថា សម្រាប់ កុមារ ដែល បាន ស្លាប់ ដោយ ជំងឺ គ្រុន ឈាម ចំនួន ២នា ក់៖
លោក វីគ្រី មេ ស៉ីង ហ្កេ គឺជា មនុស្ស ម្នាក់ ដែល ត្រូវបាន គេ ស្គាល់ ថា មាន ទេពកោសល្យ ខាង សេដ្ឋកិច្ច និង ជា អ្នក កំណែង ទម្រង់ តាម បែប លោក ខាងលិច ជាពិសេស នៅ បន្ទាប់ពី លោក បាន នាំ ប្រទេស ស្រីលង្កា ចេញ ពី វិបត្តិ សេដ្ឋកិច្ច ក្នុង ឆ្នាំ ២០០១ ។
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន ធ្វើ បទបង្ហាញ ស្ដីពី ការរៀបចំ ពិធី ការ ជូន គណៈប្រតិភូ នាំមុខ នៃ បណ្ដា ប្រទេស ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ដើម្បី ជម្រាប ជូន ព័ត៌មាន មួយចំនួន ដែល ផ្ដល់ ភាពងាយស្រួល ដល់ អ្នកចូលរួម កម្មវិធី ប្រជុំ ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ៣១ ខែកក្កដា ដល់ ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០២២ ។
បន្ទាប់ពី លោក លុយ ដាវីត ប្រធាន លេខាធិការដ្ឋាន នៃ គណៈកម្មការ ជាតិ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ឆ្នាំ ២០២២ ធ្វើជា អធិបតី ថ្លែង បើក កម្មវិធី រួច . តំណាង ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន ជម្រាប ជូន អង្គ ទូត និង គណៈប្រតិភូ ទាំងឡាយ ពី របៀបវារៈ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន ។
តំណាង ក្រសួង សុខាភិបាល ធ្វើ បទបង្ហាញ ស្ដីពី វិធានការ ការពារ កូវីដ - ១៩ ដើម្បី សុវត្ថិភាព អ្នកចូលរួម ប្រជុំ ។ ចំណែកឯ តំណាង អគ្គ ស្នងការ នគរបាល ជាតិ បង្ហាញ ពី ការការពារ សន្តិសុខ សុវត្ថិភាព ទូទៅ ជាពិសេស ការការពារ សុវត្ថិភាព ជូន រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន និង រដ្ឋមន្ត្រី នៃ ប្រទេស ដែល ចូលរួម កិច្ចប្រជុំ ។
បទបង្ហាញ ក៏ មាន សំណួរ ចម្លើយ យ៉ាង ផុសផុល ពី អង្គ ទូត និង តំណាង អង្គ ទូត ។ បន្ទាប់មក នៅ រសៀល ថ្ងៃ ដដែល លោក លុយ ដាវីត បាន ដឹកនាំ គណៈប្រតិភូ ទៅ ធ្វើ ទស្សនកិច្ច នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ដែល ជា កន្លែង រៀបចំ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ។
សូម បញ្ជាក់ ថា គណៈប្រតិភូ ដែល ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ រាជធានី ភ្នំពេញ តាម ទម្រង់ ដោយ ផ្ទាល់ មាន ៣៨ ប្រទេស បូករួម ទាំង កម្ពុជា ផង ត្រូវ ជា ៣៩ ប្រទេស ហើយក៏ មាន ការចូលរួម ពី អគ្គ លេខាធិការ អាស៊ាន ១ គណៈប្រតិភូ ផងដែរ ៕
ប្រកាស ចូលកាន់ តំណែង ប្រធាន មន្ទីរ ការងារ ថ្មី ខេត្ត បន្ទាយមានជ័យ ! រដ្ឋមន្ត្រី អ៉ិត សំហេង ជំរុញ ឲ្យ បន្ត យកចិត្តទុកដាក់ ផ្តល់ សេវា ឱ្យ បាន ទាន់ ពេលវេលា
( បន្ទាយមានជ័យ )៖ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ប្រកាស ការចូលកាន់ មុខ តំណែង របស់ លោក នួន ស៊ីណា ជា ប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ខេត្ត បន្ទាយមានជ័យ ជំនួស លោក រស់ សារុំ ដែល បាន ចូលនិវត្តន៍ និង តែងតាំង លោក ខេង តារា ជា អនុប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ រដ្ឋបាល សាលា ខេត្ត បន្ទាយមានជ័យ នា ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ ។
នា ឱកាស នោះ លោក អ៉ិត សំហេង បាន ស្នើ លោក ប្រធាន មន្ទីរ ការងារ ខេត្ត បន្ទាយមានជ័យ ថ្មី ត្រូវ បន្ត យកចិត្តទុកដាក់ ឱ្យ បាន ម៉ឺងម៉ាត់ ក្នុង ការបំពេញ ការងារ តាម តួនាទី ភារកិច្ច រៀង ៗ ខ្លួន ឱ្យ បាន ល្អ ។
គួរ បញ្ជាក់ ជូន ថា បើ យោង តាម សកម្មភាព ចុះ ធ្វើ អធិការ កិច្ចការងារ ឆ្នាំ ២០២១ នៅ តាម បណ្តា សហគ្រាស គ្រឹះស្ថាន ធុន តូច និង មធ្យម លើ វិស័យ ការងារ ស្ថិត ក្រោម ច្បាប់ ស្តីពី ការងារ នៅក្នុង ខេត្ត បន្ទាយមានជ័យ៖ ១ - មាន សហគ្រាស គ្រឹះស្ថាន ក្រុមហ៊ុន សរុប ចំនួន ២៩០ ។ ២- មាន កម្មករ និយោជិត សរុប ចំនួន ២៥. ៥៣២ នាក់ ស្រី ១៤. ៤៨៧ នាក់ ដែល ក្នុង នោះ មាន កម្មករ និយោជិត ខ្មែរ ចំនួន ២៣. ៦១៩ នាក់ ស្រី ១៣. ៧៦៦ នាក់ កម្មករ និយោជិត បរទេស ចំនួន ១. ៩១៣ នាក់ ស្រី ៧២១ នាក់ ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ គ្រោង ជួសជុល កំណាត់ មហាវិថី ឈ្នះ ឈ្នះ ដែល មាន ប្រវែង ជិត ៨គីឡូម៉ែត្រ ឡើងវិញ ដើម្បី សម្រួល ចរាចរណ៍ និង លើក សោភណ្ឌភាព រាជធានី ភ្នំពេញ ឲ្យ កាន់តែ មាន ភាពស្រស់ស្អាត ខណៈ ដែល កម្ពុជា ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ ការប្រកួត កីឡា ស៉ី ហ្គេម នៅ ចុង ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក ឃួង ស្រេង បាន ជំរុញ ក្រុមការងារ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ត្រូវ ជួសជុល ផ្លូវ នេះ ប្រកបដោយ សោភណ្ឌភាព និង ត្រឹមត្រូវ តាម ស្តង់ដា បច្ចេកទេស ជាមួយនឹង ការដាក់ លូ ដែល អាច ឲ្យ ទឹក ហូរ មិន មាន ដក់ លើ ផ្លូវ ។
គួរ បញ្ជាក់ ថា ប្រទេស កម្ពុជា បាន កំពុង ធ្វើដំណើរ ឆ្ពោះទៅ ធ្វើជា ម្ចាស់ ផ្ទះ ព្រឹត្តិការណ៍ ស៉ី ហ្គេម ខណៈ ពហុកីឡដ្ឋាន ថ្មី សន្លាង មួយ ឈ្មោះ ពហុកីឡដ្ឋាន ជាតិ មរតក តេជោ បាន និង កំពុង បង្អួត រាង យ៉ាង ថ្មី សន្លាង ។ ស៉ី ហ្គេម ឆ្នាំ ២០២៣ នៅ កម្ពុជា មិន ត្រឹម ជា មុខមាត់ ខ្មែរ ប៉ុណ្ណោះ ទេ តែ វា ជា ឱកាស ដែល កម្ពុជា ស្តារ វិស័យ ទេសចរណ៍ ខ្លួន ផង និង អាស៊ាន ផង ៕
ក្រុមហ៊ុន ភេសជ្ជៈ ប៉ូវ កម្លាំង M-150 បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ជូន រាជ រដ្ឋាភិបាល ក្នុង ការដោះស្រាយ បញ្ហា គ្រាប់ មីន នៅ កម្ពុជា
មន្រ្តី បសុពេទ្យ ជំរុញ ឱ្យ ពលរដ្ឋ នាំ សត្វ ពាហណៈ ទៅ ចាក់ វ៉ាក់ បង្ការ ជំងឺ ក្នុង រដូវ វស្សា
( សៀមរាប ) ៖ ប្រធាន ការិយាល័យ ផលិតកម្ម និង បសុព្យាបាល នៃ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត សៀមរាប បាន ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ នាំ សត្វ ពាហណៈ របស់ ខ្លួន ទៅ ចាក់ វ៉ាក់ បង្ការ ជំងឺ ក្នុង រដូវ វស្សា នេះ ដែល យុទ្ធនាការ នេះ ធ្វើឡើង ដោយ ឥត គិត ថ្លៃ ។
លោក ព្រំ វិច ប្រធាន ការិយាល័យ ផលិតកម្ម និង បសុព្យាបាល នៃ មន្ទីរ កសិកម្ម ខេត្ត បាន លើកឡើង ថា ក្នុង មួយ ឆ្នាំ យុទ្ធនាការ ចាក់ វ៉ាក់ សាំង ការពារ ជំងឺ សត្វ គោ ក្របី ត្រូវបាន ធ្វើឡើង ចំនួន ២លើក ដើម្បី បង្ការ ការឆ្លង ជំងឺ មួយចំនួន ដល់ សត្វ ពាហណៈ របស់ ប្រជាពលរដ្ឋ ដូចជា ជំងឺ សារ ទឹក អុត ក្តាម និង បូស ខ្យល់ ជាដើម ដោយ មិន តម្រូវ ឱ្យ ប្រជាពលរដ្ឋ ចំណាយ ថវិកា ឡើយ ។ សម្រាប់ ខេត្ត សៀមរាប បាន ចាប់ផ្តើម ដំណើរការ នូវ យុទ្ធនាការ នេះ គ្រប់ ស្រុក ទាំងអស់ ទូទាំង ខេត្ត ឱ្យ បាន មុន រដូវ ភ្លៀង ធ្លាក់ ជោគជាំ ចូល មកដល់ ។
គួរ រំលឹក ផងដែរ ជំងឺ អុត ក្តាម បូស ខ្យល់ និង ជំងឺ សារ ទឹក ដែល កើតឡើង លើ សត្វ គោ ក្របី ជា ជំងឺ ឆ្លង និង ធ្វើឱ្យ សត្វ ទាំងនោះ ងាប់ លឿន ប្រសិនបើ មិន ទទួលបាន វ៉ាក់សាំង ទាន់ ពេលវេលា ទេ នោះ ដែល ជំងឺ នេះ តែង កើត ជារឿយ ៗ ពិសេស ក្នុង រដូវ វស្សា ៕
សិស្សានុសិស្ស ជាង ១.០០០ នាក់ ទទួលបាន វគ្គ បណ្តុះបណ្តាល លើ វិស័យ សហគ្រិន ភាព តាមរយៈ កម្មវិធី សហគ្រិន ជំនាន់ ថ្មី របស់ សហគ្រិន ខ្មែរ
កម្មវិធី បណ្តុះបណ្តាល សហគ្រិន ជំនាន់ ថ្មី ដំណើរការ ទៅ តាម ផែនការ និង បញ្ចប់ ទៅ ដោយ លទ្ធផល ផ្លែ ផ្កា យ៉ាង ជោគជ័យ ដោយ ទទួលបាន ការគាំទ្រ និង ការចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ពីសំណាក់ សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ ដែល បាន ចូលរួម នៅ តាម វិទ្យាល័យ នីមួយ ៗ ហើយ ជាពិសេស កម្មវិធី នេះ ទទួលបាន ការចូលរួម ពី សិស្សានុសិស្ស លើស ពី ផែនការរំពឹងទុក ជា សរុប ទាំង ៥ វិទ្យាល័យ ទទួលបាន លើស ពី ១០០០ នាក់ ។
នៅក្នុង ការបណ្តុះបណ្តាល នៅ វិទ្យាល័យ ទាំង៥ វា គ្មិន កិត្តិយស ដែល ជា សហគ្រិន ដ៏ ជោគជ័យ ម្នាក់ ក៏ បាន ធ្វើ បទបង្ហាញ យ៉ាង សកម្ម ជាមួយនឹង ការចែករំលែក បទពិសោធន៍ ផ្ទាល់ខ្លួន របស់ លោក ផ្តើម ចេញ ពី ជំហាន ដំបូង រហូត ឈានដល់ ក្លាយជា សហគ្រិន មួយ រូប ដែល ជា ម្ចាស់ គ្រប់គ្រង អាជីវកម្ម ជាច្រើន ក្នុង ពេល បច្ចុប្បន្ន នេះ ដោយ លោក ចែករំលែក យ៉ាង ក្បោះក្បាយ និង បង្ហាញ នូវ គន្លឹះ សំខាន់ ៗ សម្រាប់ ជា ប្រយោជន៍ ក្នុង ការបណ្តុះ គំនិត ក្នុង ការប្រែក្លាយ ខ្លួន ជា សហគ្រិន ដល់ សិស្សានុសិស្ស ដែល ចូលរួម ទាំងអស់ គ្នា ។
លោកគ្រូ អ្នកគ្រូ ដែល បាន ចូលរួម សហការ នៅក្នុង កម្មវិធី ការបណ្តុះបណ្តាល បាន បង្ហាញ ពី ការចាប់អារម្មណ៍ ខ្លាំង ចំពោះ ប្រធានបទ របស់ កម្មវិធី បណ្តុះបណ្តាល នេះ ដែល ផ្តោត លើ ការបណ្តុះ គំនិត សហគ្រិន ភាព ដល់ សិស្សានុសិស្ស ឲ្យ យល់ដឹង អំពី អ្វី ទៅ ជា សហគ្រិន អ្វី ជា ម្ចាស់ អាជីវកម្ម ហើយ បណ្តុះ ការគិត របស់ សិស្សានុសិស្ស ឲ្យ ចេះ ប្រែក្លាយ ខ្លួន ជា សហគ្រិន វ័យ ក្មេង ទៅ តាម ជំនាញ របស់ ពួកគេ រៀង ៗ ខ្លួន ។
សិស្សានុសិស្ស ជាច្រើន ក៏ បាន បង្ហាញ ពី ការពេញចិត្ត ជាខ្លាំង ដែល មាន ឱកាស ចូលរួម ក្នុង ការបណ្តុះបណ្តាល នេះ ដែល ប្អូន ៗ បាន យល់ដឹង ច្រើន ពី សហគ្រិន ភាព ដែល ពីមុន មិន យល់ ច្បាស់ អ្វី ទៅ ជា សហគ្រិន នោះ ទេ ហើយ ការបណ្តុះបណ្តាល នេះ ពិតជា មាន សារសំខាន់ ណាស់ សម្រាប់ ពួកគេ ដែល ជា យុវជន ត្រូវ ស្វែងយល់ និង ត្រៀមខ្លួន ឲ្យបាន ល្អ ក្នុង ការរៀបចំ អនាគត និង ហ៊ាន ជម្នះ សាកល្បង ធ្វើ ទៅ តាម ជំនាញ របស់ ខ្លួន ។
សហគ្រិន ខ្មែរ ជា ស្ថាប័ន មួយ ដែល ត្រូវបាន បង្កើតឡើង ដោយ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ក្នុង គោលបំណង ធ្វើ ការ ដោយ ផ្ទាល់ ជាមួយ ស្ថាប័ន ដៃគូ អ្នក ពាក់ព័ន្ធ ក្នុង ការលើកកម្ពស់ ប្រព័ន្ធ អេកូឡូស៊ី សហគ្រិន ភាព នៅ កម្ពុជា ។ ចក្ខុវិស័យ របស់ សហគ្រិន ខ្មែរ គឺ ក្លាយជា ថ្នាល ជាតិ សម្រាប់ ការលើកកម្ពស់ វិស័យ សហគ្រិន ភាព នៅក្នុង ស្រុក ក្នុង គោលបំណង បង្កើត ចំនួន ធុរកិច្ច ថ្មី និង សហគ្រាស ធុន តូច និង មធ្យម ដែល មាន សក្ដានុពល នៅក្នុង វិស័យ អាទិភាព របស់ រាជ រដ្ឋាភិបាល ។
តាមរយៈ ចក្ខុវិស័យ ខាងលើ សហគ្រិន ខ្មែរ បាន ជ្រើសរើស យក កម្មវិធី ធំ ៗ គោល ចំនួន ៤ជា យន្តការ ក្នុង ការអនុវត្ត សកម្មភាព កន្លងមក ដែល រួម មាន៖ កម្មវិធី បណ្តុះ វប្បធម៌ សហគ្រិន ភាព កម្មវិធី អភិវឌ្ឍ សមត្ថភាព កម្មវិធី កសាង បណ្តាញ និង កម្មវិធី មូលធន គាំទ្រ ៕
ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ ណែនាំ អ្នក ប្រកប សេវា សុខាភិបាល ឯកជន ត្រូវ យកចិត្តទុកដាក់ បង្ការ ពី ការចម្លង រោគ នៅ កន្លែង ពិនិត្យ ព្យាបាល របស់ ខ្លួឲ្យបាន ល្អ
( ព្រះវិហារ ) ៖ លោក វេជ្ជបណ្ឌិត គួង ឡូ ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទី សុខាភិបាល ខេត្ត ព្រះវិហារ បាន ថ្លែង ណែនាំ អ្នក ប្រកប វិជ្ជាជីវៈ សុខាភិបាល ឯកជន ត្រូវ យកចិត្តទុកដាក់ បង្ការ ពី ការចម្លង មេរោគ ផ្សេង ៗ នៅ កន្លែង ពិនិត្យ ព្យាបាល របស់ ខ្លួន ឱ្យ បាន ល្អ ដើម្បី សុវត្ថិភាព ពេទ្យ ក្រុមគ្រួសារ ពេទ្យ ក៏ ដូចជា អ្នកជំងឺ ដែល ទៅ ទទួល ការពិនិត្យ ព្យាបាល នៅ កន្លែង របស់ ខ្លួន ។
ការថ្លែង បែប នេះ របស់ លោក វេជ្ជបណ្ឌិត គួង ឡូ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី « ការបង្ការ ការចម្លង រោគ ដល់ អ្នក ប្រកប វិជ្ជាជីវៈ សេវា សុខាភិបាល ឯកជន » នៅក្នុង ក្រុង ព្រះវិហារ និង ស្រុក ត្បែងមានជ័យ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ នេះ នៅ មន្ទីរ សុខាភិបាល ខេត្ត ។
លោក គួង ឡូ បាន លើកឡើង ថា វគ្គ បណ្តុះបណ្តាល នេះ មាន សារៈសំខាន់ ដល់ អ្នក ប្រកប សេវា សុខាភិបាល ឯកជន ដោយ លោក សង្កត់ធ្ងន់ ថា បើសិនជា ម្ចាស់ ទីតាំង បម្រើ សេវា សុខាភិបាល ឯកជន មិន យល់ ពី ការបង្ការ ការ ចម្ងង រោគ នៅក្នុង កន្លែង ព្យាបាល ទេ គឺ វា អាច ឱ្យ អ្នកជំងឺ ដែល មក ទទួល ការព្យាបាល ឆ្លង ជំងឹអី ផ្សេង ហើយ ពេទ្យ អាច ឆ្លង មេរោគ ពី អ្នកជំងឺ ឫ មួយ ពី អ្នកជំងឺ ទៅ ក្រុមគ្រួសារ របស់ ពេទ្យ ដោយសារតែ កន្លែង ព្យាបាល ឯកជន ភាគ ច្រើន គឺ យក ផ្ទះ ធ្វើជា កន្លែង ព្យាបាល ។
ជាង នេះ ទៅ ទៀត លោក គួង ឡូ បាន បន្ដ ថា គោលបំណង នៃ ការបណ្តុះបណ្តាល នេះ ក៍ ចង់ឲ្យ សេវា សុខាភិបាល ឯកជន ទាំងអស់ ចេះ គ្រប់គ្រង សំណល់ វិជ្ជសាស្ត្រ តើ ត្រូវ គ្រប់គ្រង យ៉ាងម៉េច ? ទុកដាក់ យ៉ាងម៉េច ? មិន មែន យក សំណល់ វេជ្ជសាស្ត្រ ដែល ប្រើ រួចទៅ ដាក់ កន្លែង ចោល សម្រាម សាធារណៈ ឫ ដាក់ តាម រថយន្ត ដឹក សម្រាម យក ទៅ ចោល នៅ ទី ចាក់ សម្រាម នោះ ទេ ដែល នេះ ជា ហេតុ ធ្វើឲ្យ ប៉ះពាល់ ខ្លាំង ដល់ បរិស្ថាន និង ការចម្លង មេរោគ ផ្សេង ៗ ដល់ ប្រជាពលរដ្ឋ ផងដែ ។
រាជ រដ្ឋាភិបាល យក របាំ « ឆៃ យ៉ាំ » សម្តែង ទទួល ភ្ញៀវ ទាំង ៣៨ ប្រទេស ដែល មក ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ
លោក គឹម ពី នន់ ដែល ជា អនុប្រធាន ក្រុមការងារ សហគមន៍ សង្គម វប្បធម៌ នៃ ក្រុមការងារ អនុគណៈកម្មការ ទី៦ ដើម្បី រៀបចំ « កិច្ចប្រជុំ និង ព្រឹត្តិការណ៍ អម (Side-Events)» ឆ្នាំ ២០២២ បាន ឲ្យដឹង ថា ក្នុង នាម ជា ផ្នែក ទទួល បដិសណ្ឋារកិច្ច ឲ្យបាន ល្អ ដល់ គណៈប្រតិភូ អន្តរជាតិ ដែល មក ចូលរួម កិច្ចប្រជុំ នេះ នឹង មាន ការរៀបចំ ការសម្តែង ដោយ សិល្បករ ជាច្រើន រូប ។
លោក Li Keqiang បាន លើកឡើង ទៀត ថា មិន ថា ស្ថានការណ៍ អន្តរជាតិ ប្រែប្រួល យ៉ាងណា នោះ ទេ ប្រទេស ចិន នឹង ប្រកាន់ខ្ជាប់ ដោយ មិន ងាក រេ នូវ គោល នយោបាយ ជាតិ ជា មូលដ្ឋាន ស្តីពី ការបើកចំហ ចំពោះ បរទេស ហើយ មាន ឆន្ទៈ ពង្រឹង ការសន្ទនា និង ការប្រាស្រ័យទាក់ទង ជាមួយ ភាគី នានា ដើម្បី បង្ក លក្ខណៈ សម្បត្តិ ល្អ ប្រសើរ សម្រាប់ កិច្ចសហប្រតិបត្តិការ ដែល ផ្តល់ ផលប្រយោជន៍ ទៅ វិញ ទៅមក និង ឈ្នះ ឈ្នះ ។
លើកឡើង នា ឱកាស នោះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បញ្ជាក់ ថា គម្រោង សាងសង់ ផ្លូវ ជាតិ លេខ ១៤៦B នេះ បាន សម្រេច ការសាងសង់ ជាង ៩៩% ហើយ ក្នុង នោះ ក្រសួង ក៏ ចុះ ធ្វើតេស្ត គុណភាព ចំនួន ៤១៤ កន្លែង រកឃើញ ធ្លាក់ តែ ២កន្លែង ប៉ុណ្ណោះ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បញ្ជាក់ ទៀត ថា ការធ្វើ ផ្លូវ នេះ ដើម្បី ជា ការជួយ សម្រួល ដល់ រថយន្ត ដឹក ទំនិញ ធន់ ធ្ងន់ ដែល អាច វាង ចូល ដល់ កំពង់ផែ តែម្តង ជៀង វាង ចូល ទៅក្នុង ក្រុង ព្រះសីហនុ ដែល អាច បង្ករ ឱ្យ មាន ការកកស្ទះ ។ ជាមួយ នោះ ក្រសួង ក៏ កំពុង ពិនិត្យ លទ្ធភាព រៀបចំ ឱ្យ រថយន្ត ដឹក ទំនិញ ចេញ ពី កំពុង ផែ ក្រុង ព្រះសីហនុ វាង តាម ផ្លូវ ១៤៦ B ឡើង លើ ផ្លូវ ល្បឿន លឿន តែម្តង ។
ការឡើង ថ្លៃ ប្រាក់ ដុល្លារ សិង្ហបុរី នាំឱ្យ មាន ឥទ្ធិពល អវិជ្ជមាន លើ លទ្ធផល ប្តូរ ប្រាក់ បរទេស ដោយ ខាតបង់ ចំនួន ៨.៧ប៊ីលាន ដុល្លារ សិង្ហបុរី ។ ការចំណាយ សរុប បាន កើនឡើង ដល់ ២.៨ប៊ីលាន ដុល្លារ សិង្ហបុរី ដែល ជា ចម្បង ដោយសារ ការចំណាយ លើ ការប្រាក់ ខ្ពស់ លើ ប្រតិបត្តិការ ទីផ្សារ សាច់ប្រាក់ (money market) ក្នុង ស្រុក ។
កត្តា ទាំងនេះ បាន នាំឱ្យ ធនាគារ កណ្តាល សិង្ហបុរី ខាតបង់ ចំនួន ៧.៤ប៊ីលាន ដុល្លារ សិង្ហបុរី ដែល ជា ការខាតបង់ លើក ដំបូង របស់ ខ្លួន គិត ចាប់តាំងពី ឆ្នាំ ហិរញ្ញវត្ថុ ដែល បញ្ចប់ នៅ ខែមីនា ឆ្នាំ ២០១៣ ។ ដោយសារតែ ការខាតបង់ នេះ MAS នឹង មិន រួមចំណែក ដល់ មូលនិធិ រួម របស់ រដ្ឋាភិបាល សិង្ហបុរី ហើយក៏ មិន ផ្តល់ ប្រាក់ ចំណេញ ទៅ ឱ្យ រដ្ឋាភិបាល សិង្ហបុរី ក្នុង ឆ្នាំ នេះ ផងដែរ ។
ជាមួយនឹង ការកើនឡើង អតិផរណា MAS បាន រឹតបន្តឹង គោល នយោបាយ រូបិយវត្ថុ ៤ដង ក្នុង រយៈពេល ៩ខែ ចុងក្រោយ រួមទាំង ការចាត់ វិធានការលើស ពី ធម្មតា ចំនួន ពីរ លើក គឺ នៅក្នុង ខែមករា និង ខែកក្កដា ។
គួរ បញ្ជាក់ ថា ការលើកឡើង ខាងលើ របស់ រដ្ឋមន្ត្រី ហិរញ្ញវត្ថុ ម៉ាឡេស៊ី លោក តេង គូ ហ្សាហ្វ្រុល កើត មាន ឡើង នៅ ចំពេល មាន ការព្រួយបារម្ភ ជាច្រើន ថា ប្រទេស មួយ ចំនួន នៅក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ តួយ៉ាង ដូចជា ប្រទេស ឡាវ កំពុង ប្រឈមមុខ នឹង វិបត្តិ សេដ្ឋកិច្ច ដែល អាចនឹង ធ្វើឱ្យ ពួកគេ ស្ថិត នៅក្នុង ស្ថានភាព ដូច ស្រីលង្កា ៕
កង នាវា ទី៧ របស់ សហរដ្ឋ អាមេរិក បាន ឱ្យដឹង ថា នាវា ពិឃាដ យូ អេស អេស បេន ហ្វូល (USS Benfold) បាន ដឹកនាំ ប្រតិបត្តិការ ជា ទម្លាប់ ធម្មតា នៅឯ តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ ដោយ ធ្វើដំណើរ ឆ្លងកាត់ តំបន់ ដែន ទឹក អន្តរជាតិ ស្រប ទៅតាម ច្បាប់ អន្តរជាតិ ។ យ៉ាងណា ក៏ដោយ នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន ទី បញ្ជាការ យោធា ប្រចាំ ភូមិភាគ ខាងកើត នៃ កងទ័ព រំដោះ ប្រជាជន ចិន បាន ចាត់ទុក ថា នេះ ជា ទង្វើ បង្ក រឿង ហើយ ថា កងកម្លាំង របស់ ខ្លួន បាន តាមដាន និង ព្រមាន នាវា ចម្បាំង អាមេរិក ។
សេចក្ដីថ្លែងការណ៍ ដដែល បាន បញ្ជាក់ ដូច្នេះ ថា « ការបង្ក រឿង ជាញឹកញាប់ បាន បង្ហាញ ថា សហរដ្ឋ អាមេរិក គឺជា អ្នក បំផ្លាញ សន្តិភាព និង ស្ថិរភាព នៅក្នុង តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ និង ជា អ្នកបង្ក ហានិភ័យ សន្តិសុខ ក្នុង តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ ។ ទី បញ្ជាការ យោធា ភូមិភាគ ខាងកើត នឹង បន្ត ស្ថិត នៅក្នុង លក្ខណៈ ប្រុង ជើង ការខ្ពស់ គ្រប់ ពេលវេលា ហើយ នឹង ការពារ ជាដាច់ខាត នូវ អធិបតេយ្យ និង បូរណភាព ទឹកដី » ។
គួរ បញ្ជាក់ ថា នាវា ពិឃាដ អាមេរិក USS Benfold ក៏ ធ្លាប់ បាន ធ្វើដំណើរ និង ធ្វើ ប្រតិបត្តិការ នៅក្នុង តំបន់ ដែន ទឹក មាន វិវាទ នៅឯ តំបន់ សមុទ្រ ចិន ខាងត្បូង ផងដែរ កាលពី សប្ដាហ៍ មុន ។ ជារឿយ ៗ វត្តមាន នាវា ចម្បាំង អាមេរិក នៅក្បែរ តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ តែងតែ ធ្វើឱ្យ ចិន ខឹងសម្បារ ដោយ ហៅ វា ថា ជា សញ្ញា បង្ហាញ ការគាំទ្រ ដល់ តៃវ៉ាន់ ដែល ប៉េកាំង ចាត់ទុក ជា ខេត្ត មួយ របស់ ខ្លួន ៕
រដ្ឋមន្ត្រី ការបរទេស រុស្ស៉ី នឹង មក ចូលរួម ប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ លោក Sergei Lavrov រដ្ឋមន្ត្រី ការបរទេស រុស្ស៉ី នឹង មក ចូលរួម ប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ រាជធានី ភ្នំពេញ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ។ នេះ បើ តាម លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា ក្នុង បទសម្ភាស ផ្ដាច់ មុខ ជាមួយ ទីភ្នាក់ងារ សារព័ត៌មាន កម្ពុជា (AKP) នៅ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ ។
ឧប នាយក រដ្ឋមន្រ្ដី ប្រាក់ សុខុន បាន បញ្ជាក់ ថា រុស្ស៉ី គឺជា ដៃគូ សន្ទនា មួយ របស់ អាស៊ាន ក្នុង នោះ ក៏ មាន កម្មវិធី ប្រជុំ រវាង អាស៊ាន និង រុស្ស៉ី ផងដែរ ។ លោក ឧប នាយក រដ្ឋមន្រ្ដី បាន បន្ដ ថា បញ្ហា សំខាន់ ជាង នេះ ទៀត កម្ពុជា គឺជា ប្រទេស សម្របសម្រួល រវាង អាស៊ាន និង រុស្ស៉ី ហើយ រដ្ឋមន្រ្ដី ការបរទេស រុស្ស៉ី ដែល នឹង អញ្ជើញ មក ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋមន្រ្ដី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នានា នឹង ក្លាយទៅជា សហ ប្រធាន នៃ កិច្ចប្រជុំ រវាង អាស៊ាន និង រុស្ស៉ី ។
ជាមួយគ្នា នេះ ដែរ លោក ឧប នាយក រដ្ឋមន្រ្ដី ក៏ បាន បញ្ជាក់ បន្ថែម ថា ប្រទេស អ៊ុយក្រែន ក៏ បាន សំណូមពរ ចង់ ចូលរួម ជា ភាគី ជាមួយ អាស៊ាន ដែរ តែ ដោយសារ ការដាក់ពាក្យ ហាក់ដូចជា យឺត ជាង គេ ហើយ ក្នុង ដំណើរការវិនិច្ឆ័យ និង វាយតម្លៃ នៃ ការចូលរួម របស់ អ៊ុយក្រែន អាច រៀបចំ ឬ ធ្វើ មិន ទាន់ នោះ ទេ ។ បើ តាម លោក ប្រាក់ សុខុន តាមរយៈ ការពិភាក្សា ជាមួយ អគ្គ លេខាធិការ អាស៊ាន កាលពី ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បង្ហាញ ថា ប្រទេស អ៊ុយក្រែន អាច ចូលរួម ជា ភាគី ជាមួយ អាស៊ាន បាន នៅ ឆ្នាំ ក្រោយ ។
ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News លោក លុយ ដាវីត រដ្ឋលេខាធិការ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន ឲ្យដឹង ថា កម្ពុជា បាន ត្រៀម ខ្លួន រួចហើយ ដើម្បី រៀបចំ កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន លើក ទី ៥៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ គឺ រង់ចាំ តែ ស្វាគមន៍ គណៈប្រតិភូ ទាំង ៣៨ ប្រទេស និង អគ្គ លេខាធិការដ្ឋាន អាស៊ាន ប៉ុណ្ណោះ ។
លោក លុយ ដាវីត បាន បន្ថែម ថា យោង តាម កម្មវិធី នៅ ថ្ងៃទី៣០ និង ៣១ ខែកក្កដា មាន ការប្រជុំ ថ្នាក់ អគ្គ នាយក ដើម្បី ចរចា ទៅ លើ ការរៀបចំ អត្ថបទ ទាំងអស់ សម្រាប់ កិច្ចប្រជុំ ហើយ នៅ ថ្ងៃទី១ ខែសីហា ចាប់ផ្តើម កិច្ចប្រជុំ ថ្នាក់ ឧត្តម មន្ត្រី អាស៊ាន ។ រីឯ កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្ត្រី កាបរទេស ចាប់ផ្តើម នៅ ថ្ងៃទី២ ខែសីហា ។
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ១៩ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ២. ០២៩នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
( ភ្នំពេញ ) ៖ ដើម្បី ផ្តល់ ភាពងាយស្រួល ដល់ អ្នក ជាប់ ពន្ធ ក្នុង ការស្នើសុំ ចុះបញ្ជី សហគ្រាស ធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន ពិនិត្យមើល ប្រវត្តិ នៃ ការបង់ ពន្ធ រួមទាំង អាច ទាញយក លិខិត ជូន ដំណឹង សារពើពន្ធ ផ្សេង ៗ នោះ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន រៀបចំ នូវ ប្រព័ន្ធ គ្រប់គ្រង ទិន្នន័យ អាជីវកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក ។
ជាពិសេស ដើម្បីឲ្យ អ្នក ជាប់ ពន្ធ ងាយស្រួល យល់ អំពី ប្រព័ន្ធ ថ្មី នេះ អគ្គ នាយកដ្ឋាន ពន្ធដារ ក៏ បាន រៀបចំ ជា វីដេអូ ដេ ណែនាំ ពី របៀប ប្រើប្រាស់ ប្រព័ន្ធ គ្រប់គ្រង ទិន្នន័យ អាជីវកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក ផងដែរ ៕
មេដឹកនាំ កំពូល អ៉ីរ៉ង់ រូប នេះ ក៏ បាន រិះគន់ ដែរ ថា លោក ខាងលិច បាន ប្រឆាំង នឹង ភាពខ្លាំងក្លា និង ឯករាជ្យភាព របស់ រុស្ស៉ី ។ « បក្ស សម្ព័ន្ធ ណា តូ មិន ចេះ ស្កប់ស្កល់ នោះ ទេ ប្រសិនបើ ឱកាស នៅតែ មាន ហើយ ទោះជា សង្រ្គាម មិន កើតឡើង នៅ អ៊ុយក្រែន ក៏ ពួកគេ អាចនឹង ចាប់ផ្ដើម សង្រ្គាម ដោយ ប្រើ តំបន់ គ្រី មៀ ជា លេស » ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ខាមេនី ។
ដោយឡែក លោក ពូទីន ក៏ ត្រូវបាន គេ ដកស្រង់ សម្ដី ដែរ ថា លោក បាន និយាយ ថា ការបាត់បង់ ដល់ អាយុជីវិត ជន ស៊ីវិល គឺជា សោកនាដកម្ម មួយ ដ៏ ធំ ប៉ុន្តែ ជា ដដែល លោក នៅតែ ទម្លាក់ កំហុស លើ លោក ខាងលិច ថា ជា អ្នកបង្ខំឱ្យ រុស្ស៉ី ធ្វើ សង្រ្គាម ។
គួរ បញ្ជាក់ ថា ដំណើរទស្សនកិច្ច របស់ លោក ពូទីន ទៅកាន់ ប្រទេស អ៉ីរ៉ង់ ជា ទី ដែល លោក ត្រូវ ជួប ពិភាក្សា ជាមួយ មេដឹកនាំ អ៉ីរ៉ង់ និង ប្រធានាធិបតី តួកគី លោក អឺ ដូហ្កាន់ កើត មាន ឡើង តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិនបញ្ចប់ ទស្សនកិច្ច នៅ អ៉ី ស្រាអែល និង អារ៉ាប៊ី សាអូឌីត ហើយ ដែល នេះ អាច ជា សារ មួយ ដែល លោក ពូទីន ចង់ បញ្ជូន ទៅកាន់ លោក ខាងលិច ថា ទីក្រុង មូស្គូ នឹង ពង្រឹង ទំនាក់ទំនង ជា យុទ្ធសាស្ត្រ ជាមួយ អ៉ី រ៉ង់ ឥណ្ឌា និង ចិន ដើម្បី ទប់ទល់ ជាមួយ លោក ខាងលិច ៕
លោក ម៉េដ វេដេវ ធ្វើការកត់សម្គាល់ ខាងលើ នៅក្នុង សារ មួយ បង្ហោះ លើ បណ្ដាញ ទំនាក់ទំនង តេឡេក្រាម (Telegram) នៅ ថ្ងៃអង្គារ សប្ដាហ៍ នេះ ។ ក្នុង សារ ដដែល នេះ អតីត ប្រធានាធិបតី រុស្ស៉ី រូប នេះ បាន គូសបញ្ជាក់ យ៉ាង ខ្លី ដូច្នេះ ថា « រុស្ស៉ី នឹង សម្រេចបាន គោលដៅ ទាំងអស់ របស់ ខ្លួន ហើយ សន្តិភាព នឹង ធ្វើឡើង តាម លក្ខខណ្ឌ របស់ រុស្ស៉ី » ។
គួរ បញ្ជាក់ ថា លោក ម៉េដ វេដេវ ដែល បច្ចុប្បន្ន ជា អនុប្រធាន ក្រុមប្រឹក្សា សន្តិសុខ ជាតិ រុស្ស៉ី និង ដែល ធ្លាប់ ជា ដៃគូ របស់ លោក ខាងលិច បាន បង្កើន ការរិះគន់ និង គំរាម ត្រង់ ទៅកាន់ លោក ខាងលិច ចាប់តាំងពី រុស្ស៉ី បញ្ជូន កងទ័ព លុកលុយ ចូល អ៊ុយក្រែន កាលពី ថ្ងៃទី ២៤ ខែកុម្ភៈ មក ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៦៥ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៩ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៦៥ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ២០ ខែកក្កដា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៦៥ នាក់ នោះ មាន ២៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៦ ករណី និង ជនសង្ស័យ ៣៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៧ ករណី ។
( ព្រះវិហារ ) ៖ ឈើ អា ប្រភេទ ឈើ ផ្ចឹក ប្រមាណ ៤០ ម៉ែត្រ គូប ដែល ឈ្មួញ ប្រើ រូបភាព លាក់ ទុក តាម ផ្ទះ ប្រជាពលរដ្ឋ សម្រាប់ នាំចេញ ទៅ លក់ តាម ខេត្ត នានា ត្រូវបាន លោក វុធ សាវី ព្រះរាជអាជ្ញា រង និង ជា អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង ខេត្ត ព្រះវិហារ បាន ដឹកនាំ កម្លាំង សមត្ថកិច្ច ចម្រុះ ធ្វើ ការបង្ក្រាប រយៈពេល ២ ថ្ងៃ ជាប់ ៗ គ្នា ។
លោក វុធ សាវី បាន ថ្លែង ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ថា រយៈពេល ២ ថ្ងៃ ជាប់ ៗ គ្នា លោក បាន ដឹកនាំ កម្លាំង ចម្រុះ ចុះ ប្រតិបត្តិការ សម្របសម្រួល កម្លាំង ចម្រុះ ចុះបង្ក្រាប ទីតាំង ស្តុក ឈើ ដែល ឈ្មួញ បាន ប្រើ រូបភាពយក ឈើ ទៅ ផ្ញើរ តាម ផ្ទះ ប្រជាពលរដ្ឋ ជាច្រើន នៅ ភូមិ ណារ៉ុង ឃុំ ឆែប ពីរ ស្រុក ឆែប ដើម្បី បន្លំ ភ្នែក សមត្ថកិច្ច រួច ឈ្មួញ យក គោយន្ត ដើរ ប្រមូល ឈើ នោះ តាម ផ្ទះ ប្រជាពលរដ្ឋ ដើម្បី ដឹក យក ទៅ លក់ នៅ ខេត្ត ស្ទឹងត្រែង ។
បន្ថែម ពី នេះ លោក វុធ សាវី បាន បញ្ជាក់ ថា នៅក្នុង ប្រតិបត្តិការ នេះ បាន រឹបអូស ឈើ ផ្ចិក ប្រមាណ ៤០ ម៉ែត្រ គូប ។ បច្ចុប្បន្ន វត្ថុតាង ត្រូវបាន ប្រគល់ ជូន មន្ត្រី ជំនាញ ដើម្បី ចាត់ការ តាម នីតិវិធី នៃ ច្បាប់ ៕
អភិបាល ខេត្ត ព្រះសីហនុ និង មេបញ្ជាការ កងទ័ព ជើងទឹក មូលដ្ឋាន សមុទ្រ រាម ចុះ ពិនិត្យ និង កែលម្អ សោភ័ណភាព ក្នុង បរិវេណ សាលា បឋមសិក្សា និង អនុវិទ្យាល័យ បិត ត្រាំង មិត្តភាព ព្រះសីហនុ - ជាំង ស៊ូ
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ និង លោក ឧត្តម នាវីឯក អ៊ុក សីហា មេបញ្ជាការ កងទ័ព ជើងទឹក មូលដ្ឋាន សមុទ្រ រាម នា រសៀល ថ្ងៃអង្គារ ទី១៩ ខែកក្កដា ឆ្នាំ ២០២២ បាន អញ្ជើញ ចុះ ត្រួតពិនិត្យ និង ការកែលម្អ សោភ័ណភាព សណ្តាប់ធ្នាប់ ក្នុង សាលា បឋមសិក្សា . អនុវិទ្យាល័យ បិត ត្រាំង មិត្តភាព ព្រះសីហនុ - ជាំង ស៊ូ ស្ថិត ក្នុង ឃុំ បិត ត្រាំង ស្រុក ព្រៃនប់ ។
តាម កិច្ចព្រមព្រៀង ស្ដីពី កិច្ចសហប្រតិបត្តិការ គម្រោង ជំនួយ វិស្វកម្ម កសាង សួន កុមារ និង បន្ទប់ទឹក អនាម័យ ក្នុង សាលា បឋមសិក្សា និង អនុវិទ្យាល័យ បិត ត្រាំង មិត្តភាព ព្រះសីហនុ - ជាំង ស៊ូ ចុះ ថ្ងៃទី ៣ ខែមិថុនា ឆ្នាំ ២០២២ ស្តីពី ការ សាងសង់ អគារ បន្ទប់ទឹក បង្គន់ និង កែលម្អ សោភ័ណភាព ក្នុង សាលា បឋម . អនុវិទ្យាល័យ បិត ត្រាំង មិត្តភាព ព្រះសីហនុ - ជាំង ស៊ូ ក្រោម ជំនួយ ថវិកា ពី សាខា កាកបាទ ក្រហម ជាំង ស៊ូ - វូស៊ី នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន តាមរយ តំបន់ សេដ្ឋកិច្ច ពិសេស ក្រុង ព្រះសីហនុ ។
ក្នុង ឱកាស ជំនួប ជាមួយ សម្ដេច តេជោ . លោក សាស្ត្រាចារ្យ បាន គោរព ជម្រាប ជូន សម្ដេច តេជោ ថា លោក បាន មកកាន់ កម្ពុជា នៅ ពេល នេះ គឺ មាន គោលបំណង ៣ រួម មាន៖
ទី១៖ គឺ គោរព រាយការណ៍ ជូន សម្ដេច តេជោ អំពី វឌ្ឍនភាព នៃ មជ្ឈមណ្ឌល ត្រៀម បង្ការ គ្រោះមហន្តរាយ ដែល មជ្ឈមណ្ឌល នេះ មកដល់ ពេលនេះ បាន ក្លាយ ខ្លួន ទៅជា មជ្ឈមណ្ឌល អន្តរជាតិ ។
ទី ២៖ គោរព ជូន អាហារូបករណ៍ ឈ្មោះ សម្ដេច តេជោ ចំនួន ៤០ ដែល អាហារូបករណ៍ នោះ មានបញ្ចូល ទាំង ថ្លៃ សាលា ថ្លៃ ស្នាក់ នៅ អាហារ ៣ពេល និង ប្រាក់ ឧបត្ថម្ភ សម្រាប់ សិស្ស ទៅ សិក្សា នៅ ប្រទេស ថៃ
និង ទី ៣៖ គោរព សុំ ការអនុញ្ញាត ជួប សម្ដេច តេជោ សារជាថ្មី នា ឆ្នាំ ក្រោយ ។
ជា ការឆ្លើយតប សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី បាន សម្ដែង នូវ ការអបអរសាទរ និង រីករាយ ដែល មជ្ឈមណ្ឌល ត្រៀម បង្ការ គ្រោះមហន្តរាយ អាស៊ី ត្រូវបាន ក្លាយជា មជ្ឈមណ្ឌល អន្តរជាតិ ។ សម្តេច តេជោ បាន ផ្ដល់ ជា អនុសាសន៍ ថា គប្បី ធ្វើ យ៉ាងណា ជំរុញ ឲ្យ អង្គការ នេះ មាន សកម្មភាព ដោះស្រាយ ទប់ស្កាត់ គ្រោះមហន្តរាយ ជាក់លាក់ ។
សម្តេច បាន ថ្លែងអំណរគុណ ជូន ចំពោះ ឯកឧត្តម ដែល បាន ផ្ដល់ អាហារូបករណ៍ ដាក់ ឈ្មោះ សម្ដេច តេជោ សម្រាប់ សិស្ស កម្ពុជា ទៅ សិក្សា នៅ ប្រទេស ថៃ ។ សម្ដេចក៏ បាន សុំឲ្យ ឯកឧត្ដម បន្ត ពិភាក្សា ជាមួយ ឯកឧត្តម ហង់ ជួនណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា ដើម្បី ជ្រើសរើស សិស្ស កម្ពុជា ទៅ សិក្សា នៅ ប្រទេស ថៃ ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ដោយ ដកស្រង់ ទិន្នន័យ របស់ ក្រសួង រតនាគារ អាមេរិក ថា ការកាន់កាប់ ប័ណ្ណ បំណុល អាមេរិក របស់ ប្រទេស ជប៉ុន បាន ធ្លាក់ចុះ មក នៅ ត្រឹម ១.២១២ ទ្រី លាន ដុល្លារ អាមេរិក ដែល ជា កម្រិត ទាប បំផុត គិត ចាប់តាំងពី ខែមករា ឆ្នាំ ២០២០ មក នៅ ពេល ដែល កម្រិត កាន់កាប់ របស់ ជប៉ុន មាន ចំនួន ១.២១១ ទ្រី លាន ដុល្លារ ។ នៅក្នុង ខែមេសា ឆ្នាំ នេះ ការកាន់កាប់ ប័ណ្ណ បំណុល អាមេរិក ដោយ ប្រទេស ជប៉ុន មាន ចំនួន ១.២១៨ ទ្រី លាន ដុល្លារ ។
ទិន្នន័យ របស់ ក្រសួង រតនាគារ អាមេរិក បាន បង្ហាញ ទៀត ថា ការកាន់កាប់ បំណុល រដ្ឋាភិបាល អាមេរិក ដោយ ប្រទេស ចិន ក៏ បាន ធ្លាក់ចុះ ផងដែរ មក នៅ ត្រឹម ៩៨០. ៨ប៊ីលាន ដុល្លារ នៅក្នុង ខែឧសភា ឆ្នាំ នេះ ដែល ជា កម្រិត ទាប បំផុត គិត ចាប់តាំងពី ខែឧសភា ឆ្នាំ ២០១០ មក នៅ ពេល ដែល ការកាន់កាប់ បំណុល អាមេរិក ដោយ ប្រទេស ចិន មាន ចំនួន ៨៤៣. ៧ប៊ីលាន ដុល្លារ ។ នៅក្នុង ខែមេសា ឆ្នាំ នេះ ប្រទេស ចិន កាន់កាប់ បំណុល អាមេរិក ចំនួន ១.០០៣ ទ្រី លាន ដុល្លារ ។
ប្រទេស ចិន ដែល ជា ប្រទេស មហា អំណាច សេដ្ឋកិច្ច ទី២ បាន កាត់បន្ថយ ការកាន់កាប់ ប័ណ្ណ រតនាគារ រយៈពេល ប្រាំមួយ ខែ ជាប់ គ្នា ។
ទោះបីជា ចិន និង ជប៉ុន បាន លក់ ប័ណ្ណ រតនាគារ អាមេរិក ក្នុង ខែឧសភា ក៏ដោយ ក៏ ទិន្នផល រតនាគារ អាមេរិក បាន ធ្លាក់ចុះ ដែរ ។ ទិន្នផល សម្រាប់ ប័ណ្ណ រតនាគារ ដែល មាន រយៈពេល កំណត់ ១០ ឆ្នាំ ដែល បាន ចាប់ផ្តើម នៅ ខែឧសភា ឆ្នាំ នេះ មាន អត្រា ២. ៩៩៦ភាគរយ ធ្លាក់ចុះ ប្រហែល ១៥ពិន្ទុ មូលដ្ឋាន ( ០.១៥ ភាគរយ ) មក ២. ៨៤៤ភាគរយ នៅ ចុង ខែឧសភា ។
ជា រួម ការកាន់កាប់ ប័ណ្ណ រតនាគារ ដោយ ប្រទេស បរទេស បាន ធ្លាក់ចុះ មក នៅ ត្រឹម ចំនួន ៧.៤២១ ទ្រី លាន ដុល្លារ ក្នុង ខែឧសភា ដែល ជា កម្រិត ទាប បំផុត ចាប់តាំងពី ខែឧសភា ឆ្នាំ ២០២១ មកពី ចំនួន ៧.៤៥៥ ទ្រី លាន ដុល្លារ ក្នុង ខែមេសា ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ៕
ប្រទេស ថៃ បាន ទទួល ភ្ញៀវ បរទេស ប្រហែល ២លាន នាក់ ក្នុង រយៈពេល ៦ខែ ដំបូង នៃ ឆ្នាំ នេះ ដែល កើនឡើង ជាលំដាប់ បន្ទាប់ពី ឧស្សាហកម្ម ទេសចរណ៍ របស់ ខ្លួន ស្ទើរតែ ដួលរលំ ដោយសារ ជំងឺ រាតត្បាត និង ដោយសារ លក្ខខណ្ឌ តម្រូវ ធ្វើដំណើរ ចូលក្នុង ដ៏ ស្មុគស្មាញ និង ចំណាយ ច្រើន អស់ រយៈពេល ជាង ១៨ ខែ មក នេះ ។
កាលពី ដើម ឆ្នាំ នេះ ប្រទេស ថៃ បាន ចាប់ផ្តើម កម្មវិធី ទិដ្ឋាការ រយៈពេល វែង សម្រាប់ ជន បរទេស ដែល មាន ទ្រព្យ ច្រើន និង កម្មករ ជំនាញ ដោយ ប្រកាន់ខ្ជាប់ នូវ ផែនការ របស់ ខ្លួន ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ ដែល មាន ការ ចំណាយ ខ្ពស់ ខណៈពេល ដែល ប្រទេស នេះ បាន បាត់បង់ ការងារ ជាច្រើន ហើយ និង អាជីវកម្ម ក្នុង វិស័យ ទេសចរណ៍ រក ខាតបង់ ច្រើន ក្នុង អំឡុង ពេល រាតត្បាត រាតត្បាត ៕
លោក ជា ចាន់តូ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា ក្នុង ឱកាស បើក សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆមាស ទី១ និង ទិសដៅ ការងារ ឆមាស ទី២ ឆ្នាំ ២០២២ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ បាន ថ្លែង ថា « ឥទ្ធិពល នៃ ការកើនឡើង ថ្លៃ ប្រេង និង ម្ហូប អាហារ ពិភពលោក អតិផរណា នៅ កម្ពុជា ក៏ បាន កើនឡើង ជា បន្តបន្ទាប់ ដល់ ៧.២% នៅ ខែឧសភា ដែល ជា កម្រិត ខ្ពស់ បំផុត ក្នុង រយៈពេល ជាង ១ ទសវត្សរ៍ ចុងក្រោយ » ។
ការអូស បន្លាយ នៃ សង្រ្គាម និង ការដាក់ទណ្ឌកម្ម នានា លើ ប្រទេស រុស្ស៊ី បាន ធ្វើឱ្យ ថ្លៃ ប្រេងឥន្ធនៈ និង ម្ហូប អាហារ ពិភពលោក កើនឡើង ជាលំដាប់ ដោយសារ រុស្ស៊ី និង អ៊ុយក្រែន សុទ្ធតែ ជា ប្រទេស ឈាន មុខ គេ ក្នុង ការនាំចេញ វត្ថុធាតុ ដើម ដូចជា ប្រេងឥន្ធនៈ ឧស្ម័ន ជី និង ផលិតផល កសិកម្ម ជាដើម ។
ជាក់ស្តែង នៅ ខែមិថុនា ឆ្នាំ ២០២២ នេះ អត្រា អតិផរណា សហរដ្ឋ អាមេរិក បាន កើនឡើង ដល់ ៩.១% ដែល ជា កម្រិត ខ្ពស់ បំផុត ក្នុង រយៈពេល ៤០ ឆ្នាំ ចុងក្រោយ នេះ ស្រប ពេល ដែល អតិផរណា នៅ តំបន់ ចាយ ប្រាក់ អឺរ៉ូ បាន កើន ដល់ ៨.៦% ដែល ជា អត្រា ខ្ពស់ បំផុត ចាប់តាំងពី ការបង្កើត ប្រាក់ អឺរ៉ូមក ។
លោក បាន បន្ដ ទៀត ថា ក្នុង ស្ថានភាព នេះ ធនាគារ ជាតិ នៃ កម្ពុជា បាន ថ្លឹងថ្លែង ការអនុវត្ត នយោបាយ រូបិយវត្ថុ ដើម្បី គ្រប់គ្រង សម្ពាធ អតិផរណា ផង និង គាំទ្រ ការស្តារ កំណើន សេដ្ឋកិច្ច ផង ដើម្បី រួមចំណែក គ្រប់គ្រង សម្ពាធ អតិផរណា អត្រា ប្តូរ ប្រាក់ ត្រូវ បាន បន្ត រក្សា ឱ្យ មាន ស្ថិរភាព សំដៅ ការពារ អំណាច ទិញ របស់ ប្រាក់ រៀល ក៏ដូចជា ប្រាក់ ចំណូល របស់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ។
សូម បញ្ជាក់ ថា ដោយសារ បញ្ហា ដុល្លារូបនីយកម្ម ការប្រែប្រួល អត្រា ប្តូរ ប្រាក់ មាន ឥទ្ធិពល ដោយ ផ្ទាល់ និង ឆាប់រហ័ស មក លើ អតិផរណា នៅ កម្ពុជា ។
៣៖ ការគ្រប់គ្រង សន្ទនីយភាព ក្នុង កម្រិត សមស្រប ដោយ ការបញ្ចេញ សន្ទនីយភាព ជារៀល តាមរយៈ ប្រតិបត្តិការ ផ្តល់ សន្ទនីយភាព ដោយ មាន ការធានា (LPCO) និង ការស្រូបយក សន្ទនីយភាព លើស ក្នុង ប្រព័ន្ធ ធនាគារ ដោយ មូលបត្រ អាច ជួញដូរ បាន (NCD) ។
លោក បាន បញ្ជាក់ ថា ក្នុង ការគាំទ្រ និង ជំរុញ កំណើន សេដ្ឋកិច្ច នយោបាយ រូបិយវត្ថុ វិត្ថារកម្ម ត្រូវបាន បន្ត អនុវត្ត តាមរយៈ ការរក្សា អត្រា ប្រាក់ បម្រុង កាតព្វកិច្ច ក្នុង កម្រិត ៧% ទាំង ជា ប្រាក់ រៀល និង រូបិយប័ណ្ណ ដែល បាន ផ្តល់ លទ្ធភាព ដល់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ឱ្យ មាន សាច់ប្រាក់ ក្នុង ដៃ បន្ថែម ។
កត្តា នេះ គួបផ្សំ នឹង ការបន្ត អនុវត្ត វិធានការម៉ាក្រូ ប្រុងប្រយត្ន ដោយ អនុគ្រោះ បាន ធ្វើឱ្យ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មាន លទ្ធភាព ពេញលេញ ក្នុង ការបែងចែក ឥណទាន ដល់ វិស័យ អាទិភាព ជាមួយ អត្រា ការប្រាក់ ឥណទាន សមរម្យ មាន ស្ថិរភាព ហើយ ថែមទាំង បន្ត ឆ្លើយតប បាន ក្នុង ការរៀបចំ ឥណទាន ឡើងវិញ សម្រាប់ អតិថិជន ដែល រង ផល ប៉ះពាល់ ពី វិបត្តិ ។
គួរ បញ្ជាក់ ថា ក្រៅតែ ពី ចក្រភព អង់គ្លេស បណ្ដា ប្រទេស ក្នុង តំបន់ អឺរ៉ុប ខាងលិច ដូចជា បារាំង ព័រទុយហ្កាល់ ក្រិក និង អេស្ប៉ាញ ជាដើម ក៏ កំពុង ប្រឈមមុខ នឹង រលក កម្ដៅ និង ភ្លើង ឆេះ ព្រៃ ផងដែរ ដែល អ្នកជំនាញ ភាគ ច្រើន យល់ ថា បង្កឡើង ដោយ ការប្រែប្រួល អាកាសធាតុ ៕ ពលរដ្ឋ ក្រីក្រ ជាង ១៤៥ គ្រួសារ នៅ ខណ្ឌ បឹងកេងកង ទទួលបាន អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ទីទ័ល ក្រ ចាស់ជរា ស្ត្រី មេម៉ាយ ជន ពិការភាព ចំនួន ១៤៥ គ្រួសារ នៅក្នុង សង្កាត់ ទាំង៧ នៃ ខណ្ឌ បឹងកេងកង ទទួលបាន អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ។
ពិធី ប្រគល់ អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ធឹម សំអាន ប្រធាន គណៈកម្មាធិការ អនុសាខា ខណ្ឌ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០២២ នេះ ។
ជាមួយគ្នា នេះ លោក ក៏ សូម ឱ្យ គ្រួសារ ទាំងអស់ យកចិត្តទុកដាក់ ថែរក្សា សុខភាព ដោយ ប្រកាន់ភ្ជាប់ នូវ អនាម័យ រស់ នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត និង សូម កុំ ធ្វេសប្រហែស ពី ជំងឺ កូវីដ១៩ ដោយ បន្ត អនុវត្ត វិធានការ ការពារ ខ្លួន ជានិច្ច គឺ « ៣ការពារ និង ៣កុំ » ។
លោក ធឹម សំអាន បាន បន្ត ទៀត ថា ចំពោះ អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ ចែកជូន ដល់ ដៃ ប្រជាពលរដ្ឋ ក្រីក្រ នៅ ពេល នេះ ពិតជា មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ដោះស្រាយ ជីវភាព ប្រចាំ ថ្ងៃ ហើយ នេះ ជា ទឹកចិត្ត អាណិតអាសូរ របស់ អាជ្ញាធរ ខណ្ឌ និង សង្កាត់ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ហើយ អំណោយ នេះ នឹង បាន ជួយ ចែករំលែក រាល់ ការលំបាក របស់ ប្រជាពលរដ្ឋ ក្រីក្រ បាន មួយ គ្រា ។ ប៉ុន្តែ សូម ប្រជាពលរដ្ឋ ត្រូវ ប្រឹងប្រែង ធ្វើការ រក ទទួលទាន តាម លទ្ធភាព ដែល បងប្អូន មាន ផងដែរ ។
ជាមួយគ្នា នោះ លោក ធឹម សំអាន បាន រំឮក ទៅដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង មូលដ្ឋាន ខណ្ឌ បឹងកេងកង សូម ថែទាំ សុខភាព និង អនុវត្តន៍ នូវ វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ « ៣ការពារ និង ៣កុំ » ឱ្យ បាន ខ្ជាប់ខ្ជួន ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី សុវត្ថិភាព របស់ យើង ទាំងអស់ គ្នា ។
គួរ បញ្ជាក់ ថា បើ តាម លោក ចន ឃឺប៊ី រុស្ស៉ី កំពុង ប្រើ យុទ្ធសាស្ត្រ ដូចគ្នា ទៅនឹង ការក្រសោប យក តំបន់ គ្រី មៀ ពី អ៊ុយក្រែន កាលពី ឆ្នាំ ២០១៤ ដើម្បី កាត់ យក ទឹកដី អ៊ុយក្រែន នៅ តាម តំបន់ ដែល កងទ័ព រុស្ស៉ី កំពុង គ្រប់គ្រង ៕
ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២៦ ខែកក្កដា . នឹង មាន ភ្លៀង ធ្លាក់ ពី តិច ទៅ ច្រើន លាយឡំ ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២៦ ខែកក្កដា ឆ្នាំ ២០២២ ។
ក្រសួង បញ្ជាក់ ថា ព្រះរាជាណាចក្រ កម្ពុជា នឹង ទទួល ឥទ្ធិពល ពី ជ្រលង នៃ ប្រព័ន្ធ សម្ពាធ ទាប អូសបន្លាយ ពី ភាគ ខាងជើង ប្រទេស ថៃ កាត់ លើ ភាគ ខាងត្បូង ប្រទេស ឡាវ និង ភាគ កណ្តាល ប្រទេស វៀតណាម ជាមួយ ខ្យល់ មូសុង និរតី បក់ ក្នុង ល្បឿន ពី មធ្យម ទៅ បង្គួរ ។ ស្ថានភាព បែប នេះ នឹង ធ្វើឲ្យ ៖
មិន ត្រូវ បើកបរ លើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ៣នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៩ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៦លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន បញ្ជាក់ ថា ក្រុមការងារ នេះ ដឹកនាំ ដោយ នាយ ឧត្តមសេនីយ៍ ជា សុគន្ធា អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា នាយក រង ខុទ្ធ កាល័យ សម្តេច ក្រឡាហោម ស ខេង ជា ប្រធាន រួម នឹង អនុប្រធាន និង សមាជិក ចំនួន ២៥ រូប ទៀត ផងដែរ ៕ រដ្ឋមន្ត្រី កើត រិទ្ធ ជួប ពិភាក្សា ការងារ ជាមួយ អនុ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ជប៉ុន ពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ច្បាប់ និង យុត្តិធម៌ ប្រទេស ទាំង ពីរ
ខ្លឹមសារ សំខាន់ ៗ នៃ ជំនួប នេះ រួម មាន៖
ទី ១៖ អំពី ការរៀបចំ កិច្ចប្រជុំ ពិសេស ថ្នាក់ រដ្ឋមន្ត្រី ច្បាប់ និង យុត្តិធម៌ ជប៉ុន - អាស៊ាន ឆ្នាំ ២០២៣៖ តាម សំណើ របស់ អនុ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ជប៉ុន . ឯកឧត្តម រដ្ឋមន្ត្រី បាន សំដែង នូវ ការគាំទ្រ ចំពោះ ការរៀបចំ កិច្ចប្រជុំ ពិសេស ថ្នាក់ រដ្ឋមន្ត្រី ច្បាប់ និង យុត្តិធម៌ ជប៉ុន - អាស៊ាន ដែល គ្រោង នឹង រៀបចំ នៅ ខែកក្កដា ឆ្នាំ ២០២៣ នៅ ទីក្រុង តូក្យូ ប្រទេស ជប៉ុន ក្នុង គោលដៅ ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ជប៉ុន និង បណ្តា ប្រទេស សមាជិក អាស៊ាន លើ វិស័យ ច្បាប់ និង យុត្តិធម៌ ។
កិច្ចប្រជុំ ពិសេស នេះ ត្រូវបាន រៀបចំឡើង ស្រប ពេល នៃ ការប្រារព្ធ ខួប លើក ទី៧០ នៃ ទំនាក់ទំនង រវាង ជប៉ុន - កម្ពុជា និង ខួប លើក ទី ៥០ នៃ ទំនាក់ទំនង រវាង ជប៉ុន និង អាស៊ាន ។
និង ទី ២៖ អំពី កិច្ចសហប្រតិបត្តិការ តាមរយៈ អង្គការ UNAFEI ៖ លោក រដ្ឋមន្ត្រី បាន សំដែង នូវ អំណរគុណ ចំពោះ អង្គការ UNAFEI ដែល បាន ផ្តល់ ការគាំទ្រ ផ្នែក បច្ចេកទេស ដល់ កម្ពុជា តាមរយៈ ការរៀបចំ វគ្គ បណ្តុះបណ្តាល ពាក់ព័ន្ធ នឹង វិស័យ ព្រហ្មទណ្ឌ ដល់ មន្ត្រី អនុវត្ត ច្បាប់ កម្ពុជា ។
តាម សំណើ របស់ កម្ពុជា . អង្គការ UNAFEI នឹង រៀបចំ ឱ្យ មាន ដំណើរទស្សនកិច្ច សិក្សា ទៅកាន់ ប្រទេស ជប៉ុន ដល់ មន្ត្រីរាជការ ក្រសួង យុត្តិធម៌ ដើម្បី ដកស្រង់ បទពិសោធន៍ របស់ ប្រទេស ជប៉ុន ពាក់ព័ន្ធ នឹង ការអនុវត្ត ទោស សហគមន៍ ។
WHO បាន និយាយ នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន មួយ ថា កាលពី សប្តាហ៍ មុន ករណី ឆ្លង កូវីដ១៩ ថ្មី ជិត ០៣ លាន ករណី ត្រូវបាន រាយការណ៍ នៅក្នុង តំបន់ អឺរ៉ុប ដែល ស្មើនឹង ជិត ពាក់កណ្តាល នៃ ករណី ថ្មី ទាំងអស់ នៅ ទូទាំង ពិភពលោក ។
លោក បាន បន្ថែម ថា នៅ ទ្វីប អឺរ៉ុប មាន មនុស្ស ប្រមាណ ជិត ៣.០០០ នាក់ បាន ស្លាប់ រៀងរាល់ សប្តាហ៍ ដោយសារ កូវីដ១៩ ខណៈ ការឆ្លង កំពុង កើនឡើង លឿន បំផុត ក្នុង ចំណោម ក្រុម អាយុ ចាស់ ដែល ងាយ រងគ្រោះ បំផុត ៕
ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ដាក់ ចេញ អនុសាសន៍ សំខាន់ ១៦ ចំណុច ជំរុញ ឲ្យ ការប្រមូល ចំណូល ពន្ធ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ កាន់តែ មាន ប្រសិទ្ធិភាព ខ្ពស់
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ប្រមូល ចំណូល ពន្ធ ប្រចាំ ខែមិថុនា និង ប្រចាំ ឆមាស ទី១ ឆ្នាំ ២០២២ ព្រមទាំង ទិសដៅ សម្រាប់ អនុវត្ត បន្ត ឆ្នាំ ២០២២ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ។
ក្នុង ឱកាស នោះ អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី បាន ដាក់ចេញ នូវ អនុសាសន៍ មួយចំនួន ដើម្បីឲ្យ អគ្គ នាយកដ្ឋាន ពន្ធដារ បន្ដ អនុវត្ត ឲ្យ កាន់តែ មាន ប្រសិទ្ធិភាព ខ្ពស់ ក្នុង ការពង្រឹង ការប្រមូល ចំណូល ពន្ធ ។
អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី បាន គាំទ្រ លើ វិធានការ ដែល បាន ដាក់ចេញ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង បាន ផ្តល់ អនុសាសន៍ សំខាន់ ៗ ជា សម្រាប់ អនុវត្ត បន្ត ដូច ខាងក្រោម៖
១៖ បន្ត ចូលរួម ជាមួយ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ក្នុង ការពិនិត្យ និង ពិគ្រោះយោបល់ កម្រិត អន្តរ ក្រសួង ស្ថាប័ន ដើម្បីឱ្យ ការរៀបចំ សេចក្ដីព្រាង ច្បាប់ ស្ដីពី សារពើពន្ធ ថ្មី មាន ភាព គ្រប់ ជ្រុងជ្រោយ និង ប្រទាក់ ក្រឡា ព្រមទាំង ឆ្លើយតប នឹង ការរីកចម្រើន នៃ សេដ្ឋកិច្ច ជាតិ ធានា ភាពច្បាស់លាស់ ប្រសិទ្ធភាព ស័ក្ដិសិទ្ធិភាព នីត្យានុកូលភាព និង សង្គតិភាព នៃ ការគ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ ។
២៖ បន្ត ពង្រឹង ការអនុវត្ត កាតព្វកិច្ច ដំឡើង ឧបករណ៍ វាស់ ចំណុះ ស្រាបៀរ និង ភេសជ្ជៈ គ្មាន ជាតិ អាល់កុល របស់ សហគ្រាស ផលិត ក្នុង ស្រុក (Flowmeter) អនុលោម តាម ប្រកាស លេខ ០១០ សហវ . ប្រក ចុះ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដើម្បី ពង្រឹង ប្រសិទ្ធភាព នៃ ការប្រមូល ចំណូល និង ធានា បាន នូវ ការប្រកួតប្រជែង ដោយ ស្មើភាព ។
៣៖ សិក្សា លើ លទ្ធភាព នៃ ការរៀបចំ កែសម្រួល ប្រាក់ ពន្ធ លើ មធ្យោបាយ ដឹកជញ្ជូន និង យានជំនិះ គ្រប់ ប្រភេទ សម្រាប់ ឆ្នាំ ក្រោយ ៗ ។
៤៖ បន្ត ពង្រឹង ការចុះបញ្ជី ពន្ធដារ និង ការធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន សហគ្រាស ព្រមទាំង បន្ត តាមដាន ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ រាល់ សហគ្រាស កំពុង មាន សកម្មភាព និង សហគ្រាស ដែល ទើប បាន ចុះបញ្ជី ពន្ធដារ ថ្មី ក្នុង គោលដៅ ពង្រឹង ការគ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ និង ក្នុង គោលដៅ កាត់បន្ថយ ហានិភ័យ ពាក់ព័ន្ធ នានា ។
៧៖ បន្ត ផ្សព្វផ្សាយ និង ពង្រឹង ការអនុវត្ត វិធាន វិក្កយបត្រ ក្នុង ចំណោម អ្នក ជាប់ ពន្ធ ដើម្បី ធានា បាន នូវ ប្រសិទ្ធភាព និង តម្លាភាព ក្នុង ការគ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ អាករ នានា ។
៨៖ បន្ត ផ្សព្វផ្សាយ និង ពង្រឹង ការអនុវត្ត នូវ កម្មវិធី វិក្កយបត្រ នាំ សំណាង ក្នុង គោលដៅ ពង្រឹង ការអនុវត្ត វិធាន វិក្កយបត្រ ក្នុង ចំណោម អ្នក ជាប់ ពន្ធ តាមរយៈ ការចូលរួម របស់ សាធារណជន ទូទៅ ។
៩៖ សិក្សា រៀបចំ វិធានការបំពាក់ GPS និង RFID លើ រថយន្ត ដឹកជញ្ជូន ក្នុង គោលដៅ គ្រប់គ្រង ទិន្នន័យ ក្នុង ការប្រកាស ពន្ធ និង ពង្រឹង ក៏ ដូចជា សម្រួល ការផ្តល់ សេវា ជូន អ្នក ជាប់ ពន្ធ ។
១១៖ បន្ត ពង្រឹង ការផ្តល់ សេវា ពន្ធ អចលន ទ្រព្យ ជូន សាធារណជន ដោយ បង្ក ភាពងាយស្រួល តាមរយៈ ការរៀបចំ វិក្កយបត្រ ពន្ធ អចលន ទ្រព្យ សម្រាប់ អចលន ទ្រព្យ នីមួយ ៗ ជូន ដល់ ទីតាំង អាសយដ្ឋាន ម្ចាស់ អចលន ទ្រព្យ ។
១២៖ ពង្រឹង ការកត់ត្រា បំណុល ពន្ធ អនុវត្ត ការប្រមូល បំណុល ពន្ធ និង វិធានការ តឹង ទារ បំណុល ពន្ធ ជាពិសេស បំណុល ពន្ធ ធំ ៗ ដែល មាន សក្តានុពល ដោយ កំណត់ ជា បំណុល អាទិភាព ។
១៣៖ បន្ត ពង្រឹង ការគ្រប់គ្រង សហគ្រាស ស្នើសុំ ផ្អាក បណ្តោះអាសន្ន ឬ បិទ ជា ស្ថាពរ ហើយ ស្នើសុំ បើក ដំណើរការ ឡើងវិញ ដោយ មាន វិធានការចុះ ពិនិត្យ ដល់ ទីតាំង សហគ្រាស ផ្ទាល់ តាមដាន លើ ការដាក់ លិខិត ប្រកាស និង ពង្រឹង ការធ្វើ សវនកម្ម លើ លិខិតស្នាម ។
១៤៖ បន្ត ការងារ កែទម្រង់ និង បណ្តុះបណ្តាល ធនធាន មនុស្ស ព្រមទាំង បន្ត ពង្រឹង ការអនុវត្ត ច្បាប់ វិន័យ ការងារ និង ត្រូវ មាន ភាពទន់ភ្លន់ តែ ម៉ឺងម៉ាត់ ដោយ ផ្អែក លើ ទិដ្ឋភាព ច្បាប់ ក្នុង ការផ្តល់ សេវា ជូន អ្នក ជាប់ ពន្ធ និង ការគ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ ។
១៦៖ បន្ត អនុវត្ត វិធានការ ចាំបាច់ នានា ដូច មាន កំណត់ ក្នុង សារាចរ ណែនាំ ស្តីពី ការអនុវត្ត ច្បាប់ ស្ដីពី ហិរញ្ញវត្ថុ ឆ្នាំ ២០២២ និង បន្ត អនុវត្ត ដោយ ការយកចិត្តទុកដាក់ នូវ យុទ្ធសាស្រ្ត កៀរ គរ ចំណូល ឆ្នាំ ២០១៩ - ២០២៣ ។
កសិករ ក្នុង ខេត្ត ព្រះវិហារ ពង្រីក ផ្ទៃដី ដាំ ដំឡូង មី ជិត ៣ម៉ឺន ហិកតា ខណៈ ឆ្នាំ នេះ តម្លៃ ដំឡូង មី ល្អ ប្រសើរ
