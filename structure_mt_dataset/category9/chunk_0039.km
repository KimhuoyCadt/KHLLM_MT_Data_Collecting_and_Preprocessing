ប៉ុន្តែ ទោះបីជា យ៉ាងណា ក៏ដោយ កិច្ចព្រមព្រៀង នេះ ត្រូវការការអនុម័ត ពី សភា ប្រេស៊ីល ។
ខ្ញុំ ឯណេះ វិញ ការពារ ជិត ឈឹង អញ្ជើញ គ្រូ មក ក៏ មិន ខ្លាច ដែរ
នេះ ប៉ុន្តែ ពុំ កាន់ តួនាទី សំខាន់ ក្នុង ការចរចា ពាណិជ្ជកម្ម ជាមួយ សហរដ្ឋ អាមេរិក ឡើយ ។
ខ្ញុំ ប្រមាណ មើល ទៅ ថា បុរស នេះ ដូចជា ពុំ សូវ ត្រូវ និស្ស័យ គ្នា នឹង ខ្ញុំ ។
ឈ្មោះ តែម្តង ទៅ ។
វា ស្មុគស្មាញ បើ ក្រុមហ៊ុន វាយក ជួយ ដោះស្រាយ ឱ្យ ពូផង ។
ន័យ ត្រង់ កូន តែ មួយ ដែល ព្រះបាន បង្កើត ដោយ ផ្ទាល់
ជា ការពិត ណាស សម្រាប់ និស្សិត មហាវិទ្យាល័យ នីមួយ ៗ
មាន រយៈពេល យូរ ឬ ច្រើន ជាង ពីរ សប្តាហ៍ ឬ កើតឡើង ដោយ គ្មាន ហេតុផល
ស្ថាប័ន ជំនាញ អន្តរជាតិ ធំ ៗ
កុមារ មួយចំនួន ទៀត កំពុង ជាប់ ពន្ធនាគារ ។
សម្លេង នាង ក៏ ផ្លាស់ប្តូរ ដែរ ។
ឆ្នាំ អ្នក យក អាសារ កាម្សាញ់ ៕
ក្រៅពី ទាត់ ពូកែ នោះ វិឆ័យ ហាក់ដូចជា មិន មាន អ្វី ជាពិសេស ទៀត នោះ ទេ ។
សូម រង់ចាំ អាន ព័ត៌មាន ពិស្តារ …
២៤ អ្នកណា ស្តាប់ ពាក្យ ខ្ញុំ នេះ ហើយ ប្រព្រឹត្ត តាម អ្នក នោះ ប្រៀប បាន ទៅនឹង មនុស្ស ឈ្លាសវៃ ម្នាក់ ដែល បាន សង់ ផ្ទះ របស់ ខ្លួន នៅលើ ផ្ទាំង ថ្ម ។
រីឯ លោក ស្ទេ ផាន វិញ លោក បាន ពោរពេញ ដោយ ព្រះវិញ្ញាណ ដ៏ វិសុទ្ធ ហើយ គាត់ បាន អធិប្បាយ អំពី ព្រះគ្រីស្ទ និង ការរិះគន់ សាសនា យួដា និង ទំនៀមទម្លាប់ គេ ។
មនុស្ស ប្រុស បែប ណា ដែល ស្រី ៗ
ប៉ុន្តែ ក្នុង ចំណោម លោក ទាំងនោះ គ្មាន នរណា ម្នាក់ ប្រសើរ ជាង អ្នក ដែល គោរព កោតខ្លាច ព្រះអម្ចាស់ ទ្ប យើ ។
ដោយសារ តម្រុយ បែប នេះ នាំឱ្យ ប៉ូលីស សន្និដ្ឋាន បាន ដោយ ងាយ !
ពេលវេលា នឹង ត្រូវបាន បង្ហាញ ។
នៅក្នុង ការបង្រៀន ឱ្យ អធិស្ឋាន សាវ័ក ប៉ុល បាន លើកទឹកចិត្ត យើង ឱ្យ អរសប្បាយ ជានិច្ច ខ. ១៦ ហើយ អរ ព្រះគុណ ព្រះគ្រប់ កាលៈទេសៈ ខ. ១៨ ។
ខួប ទី២៧ នៃ ទិវា ប្រកាស រដ្ឋធម្មនុញ្ញ !
រីឯ អ្នកបើកបរ រថយន្ត ក្រោយពី កើត ហេតុ បាន រត់គេចខ្លួន បាត់ ។
អ្វី ដែល ខ្ញុំ ចង់ និយាយ នៅក្នុង អង្គប្រជុំ សភា ថ្ងៃ នេះ និង ការសម្រេចចិត្ត ដ៏ សំខាន់ មួយ ទាក់ទង ជាមួយ ផ្លូវ ជាតិ លេខ ៤តែម្តង ។
ខ្ញុំ ត្រូវតែ ធ្វើ អ្វី ដែល ខ្ញុំ ត្រូវ ធ្វើ ។
ដែល បាន ឃើញ សកម្មភាព អន្តរាគមន៍ នេះ មាន អារម្មណ៍ តក់ស្លុត យ៉ាង ខ្លាំង ។
នាង ភ័យរិត តែ ខ្លាំង ឡើង ។
នៅលើ ភ្នំ ស៊ីយ៉ូន ។
៤បើ អ្នក មិន ព្រម បើក អោយ ប្រជារាស្ត្រ របស់ យើង ចេញ ទៅ ទេ ថ្ងៃស្អែក យើង នឹង ប្រើ ហ្វូង កណ្តូប អោយ ចូលមក រាតត្បាត ដែនដី របស់ អ្នក ។
ដូច្នេះ នាង លីលី អាច មាន សមត្ថភាព ធ្វើ ការងារ នេះ បាន ។
រាល់ ការបង់ប្រាក់ ទាំងឡាយ គឺជា អំពើ ខុស ច្បាប់ ។
បញ្ចូល ពី ចំនួន យានយន្ត តម្កល់ លក់ នៅក្នុង ឃ្លាំង នីមួយ ៗ
ធានា ស្អាត កង់ ថ្មី ទាំងអស់ ទិញ ទៅ ប្រើ តែ ម្តង តំលៃ ចរចារ
ខ្ញុំ គាំទ្រ ទង្វើ នាង ដែល ធ្វើ ដើម្បី សង្គម និង ប្រទេសជាតិ កុំ ធ្វើ ដូច អា ថោក ក រុណា ពេជ្រ អោយ សោះ ។
គ្រប់គ្រង ល្បឿន អ៊ីនធើណែត កូន ចៅ ក្នុង ផ្ទះ របស់ …
លោកស្រី ថា ធ្វើ ដូចនេះ ដើម្បី រម្លឹក ខួប ទំនាក់ទំនង ការទូត ៧០ ឆ្នាំ ជាមួយ អ៊ីស្រអ៊ែាល ។
ឪពុក របស់ ខ្ញុំ ត្រូវបាន សម្លាប់ ក្នុង របប ប៉ុល ពត ក្នុង ឆ្នាំ ១៩៧៥ ។
ការងារ ដែល លំបាក បំផុត សម្រាប់ ខ្ញុំ គឺ បិទ មាត់ឡ ដោយ ប្រើ ដី សើម ។
នៅ តាម ដងទន្លេ នៅលើ ដីខ្សាច់ និង អ្វី ដែល លោក មាន និង រកឃើញ ។
ព្រះឥន្ទ្រ សួរ ថា កាល ដែល ព្រះកេតុ មាលា ទ្រង់ ព្រះសម្ភព តើ មាន អាភេទ ដូចម្តេច ?
របស់ ក្រុមហ៊ុន គ្រប់ ទិសទី ទូទាំង ពិភពលោក ជាពិសេស ក្រុមហ៊ុន ល្បី ៗ
និង ពួក អ្នក ប្រទេស ក្រៅ ដែល នៅជាមួយនឹង គេ ដែរ ។
ជំហាន ទី៣តម្កល់ ប្រាក់
ទន្លេ អុំ ស្ថិត នៅ ខាងកើត ឆៀង ខាងជើង បន្តិច ។
ខណៈ មនុស្ស ធម្មតា មាន តែ ៥ប៉ុណ្ណោះ ។
លោក ថា មាន តែ អ្នកនយោបាយ ប៉ុណ្ណោះ ដែល អាច សម្រេច កិច្ចការ នេះ បាន ។
លោក ព្រីង សំរាំង ជាមួយ សិក្ខាកាម កាលពី ថ្ងៃទី ៣ ខែកញ្ញា ឆ្នាំ ២០២០ រូបភាព ដោយ ៖
ពួកគាត់ ភាគ ច្រើន មិន ធ្លាប់ ជួបគ្នា ទេ ។
ជាមួយគ្នា នេះ ផងដែរ សិល្បករ កំប្លែង ល្បីល្បាញ ម្នកា់ គឺ នាយ កុយ ក៏ បាន ឱ្យដឹង ដែរ ថា ៖
ព្រះជា ម្ចាស់ នៅ ឆ្ងាយ
សម្ភាស អ្នកស្រី មូរ សុខ ហួរ អំពី ផែនការផ្លាស់ប្តូរ ទីតាំង ទីលាន ប្រជាធិបតេយ្យ
កាលពី យប់ មិញ នេះ សភា តំណាងរាស្ត្រ បាន អនុម័ត ច្បាប់ តូច ៗ
បញ្ចូល អាមេរិក ខាងត្បូង និង អុក ហើយ អ្នក នឹង ទទួលបាន ពាក្យ ដូចជា ឆេកឌ័រ ។
្របក់ ចេំណញ ពិតេគ
ខ្ញុំ ភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង តែ ខ្ញុំ មិន បាន និយាយ អ្វី ច្រើន ឡើយ ។
ប្រាក់ ចំណូល មួយ ផ្នែក របស់ គ្រួសារ ត្រូវ ទុក សង បំណុល ម្ចាស់ឡ ឥដ្ឋ ។
ក្នុង ក្រុង បាងកក ទាំងមូល នឹង ត្រូវ ជន លិច ក្នុង រយៈពេល ពី ១៥
ប៉ុន្តែ លោក ថា នៅ ប្រទេស ផ្សេង ៗ
ហេតុ ដូច្នេះហើយ បានជា ទីភ្នាក់ងារ USCIS នឹង ពន្លឿន ដំណើរការត្រួតពិនិត្យ ពាក្យ ស្នើសុំ នេះ ឱ្យ ស្រប តាម ប្រតិបត្តិការ ជាក់ស្តែង នា ពេល បច្ចុប្បន្ន ។
ចូរ ប្រាប់ ពួកគេ អោយ ដឹង នូវ អំពើ គួរ ស្អប់ខ្ពើម ដែល ដូនតា របស់ ពួកគេ បាន ប្រព្រឹត្ត ។
កូនប្រុស គាត់ កាល នៅរស់ ជា អ្នកបើក រថយន្ត តាក់ស៊ី ។
មាន ភូមិគ្រឹះ មិន ចាញ់ អ្នក រស់ នៅ តាម ទីប្រជុំជន ឡើយ ។
ទៀត ក៏ ទទួលរង ផល ប៉ះពាល់ និង ខាតបង់ ប្រាក់ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ផងដែរ មាន ដូច ខាងក្រោម ៖
ហ៊ុន សែន មិន ជិះ ទេ យន្តហោះ ប្រភេទ នេះ នោះ ព្រោះ ខ្លាច ធ្លាក់ងាប់ ។
ទន្ទឹម តម្លៃ ស្រូវ ល្អ បង្គួរ នេះ រូប លោក និង គ្រួសារ កសិករ ផ្សេង ៗ
ខ្ញុំ ពិតជា ចង់ មក ទីក្រុង ប៉ារីស ហើយ ពាក់ អាវ របស់ ពួកគេ ។
តម្លៃ ដីធ្លី នៅ ភ្នំពេញ
ប្រើប្រាស់ សេព ឬ ជក់ ថ្នាំ ញៀន មួយចំនួន តែ មិន បាន រឹបអូស ថ្នាំ ញៀន ពី ពួកគេ ទេ ។
ទ្រង់ នឹង យាង ត្រឡប់ មកកាន់ ប្រទេស កម្ពុជា វិញ ក្នុង រយៈពេល ២ឬ ៣សប្តាហ៍ ខាងមុខ ៕
លោក ឱម យិន ទៀង នៅ កម្ពុជា អត់ មាន ច្បាប់ ដាក់ គុក មន្ត្រីរាជការ ដែល សំញ៉ែង ទ្រព្យសម្បត្តិ ទេ !
នៅក្នុង ឃាតកម្ម ដ៏ ព្រៃផ្សៃ នេះ មាន តែ បុរស ជួប សម្លាប់ ប្រកបដោយ មន្ទិល តែ ម្នាក់ គត់ ដែល ត្រូវបាន ចាប់ខ្លួន និង ផ្តន្ទាទោស ។
កម្ពុជា ជា ផ្ទះ ជា ទ្រនុំ របស់ យើង ។
ដូចគ្នា នឹង នាយ តាក់ស៊ី ឪពុក ស៊ិន ឧត្តម ផល្លា បាន ចេញ ពី ផ្ទះ ទៅ ថ្វាយ ខ្លួន ព្រះធម៌ បាត់ ហើយ
មាន មនុស្ស មិន តិច ទេ ដែល ចូលចិត្ត ប្រៀបធៀប ខ្លួន ឯង ជាមួយ អ្នកដទៃ ។
ក្នុង ករណី ដែល យុទ្ធនាការ នេះ បរាជ័យ ។
នេះ ជា សំនួរ ដំបូង ដែល ខ្ញុំ សួរ ទៅ គូស្នេហ៍ ទាំង ពីរ ។
ដែល គេ មាន លើស ពី សេចក្តីត្រូវការមក ផ្គត់ផ្គង់ បងប្អូន វិញ ។
គាត់ បាន ឃើញ ដំបូល ផ្ទះ របស់ គាត់ ពី ចំងាយ គាត់ ពិតជា ត្រេកអរ ខ្លាំង ណាស់ ។
តំបន់ ធ្វើ ការ គឺជា លក្ខណ ពិសេស មួយ ដែល ខ្ញុំ មិន ធ្លាប់ ប្រើ ។
របស់ ពួកវា គឺជា កិច្ចការ ដ៏ លំបាក មួយ ។
សង្គម ថេយ ក្វាន សកម្មភាព ថែទាំ ផ្ទាល់ខ្លួន
ប្រសិនបើ អ្នក ចង់អោយ កូន របស់ អ្នកលេង …
បង ត្រូវការ អូន សម្រាប់ ជីវិត របស់ បង ទោះបីជា អូន ចង់បាន អ្វី ក៏ បង ហ៊ាន ធ្វើ ដែរ ។
ជាង អ្នកប្រើប្រាស់ សកម្ម ២នាក់ .
លោក ព្យាករ ថា តម្លៃ ប្រេង នឹង បន្ត កើនឡើង ក្នុង រយៈពេល ប៉ុន្មាន ខែ មុខ នេះ ។
ស្លាប់ ទាំង ៣នាក់ សុទ្ធតែ មាន ត្រកូល អ៊ឹម ទាំងអស់ ។
ជាមួយនឹង កម្លាំង ខ្លាំង បែប នេះ វា អាចនឹង មាន ឥទ្ធិពល ខ្ពស់ នៅក្នុង ការធ្វើ ទំនាក់ទំនង ជាមួយ យុវជន ។
ព្រោះ គាត់ បាន រកឃើញ មនុស្ស ស្រី ថ្មី ក្នុង ចិត្ត គាត់ រួចហើយ ។
ប្រសិនបើ គាត់ ដាក់ ដីកា ហៅ ខ្ញុំ ទៅ នោះ ខ្ញុំ ទៅ ព្រោះ លោកគ្រូ ខ្ញុំ ជាមួយនឹង ខ្ញុំ អត់ មាន ត្រូវ ខុស អ្វី នោះ ទេ ។
បទបង រង់ចាំ ស្រី ច្រៀង ដោយ លោក ឈួយ សុភាព នៅ ខាង ស្រុក អាមេរិក
ព្រលានយន្តហោះ អន្តរជាតិ ទី៤ ចាប់ផ្តើម សាងសង់ ដំណាក់កាល ដំបូង បាន បញ្ចប់ ទាន់ ពេលវេលា និង ការ…
ពី ប្រទេស នេះ កាលពី ពីរ សប្តាហ៍ កន្លងទៅ ។
នោះ ឯង គឺ លោក ប្រធានាធិបតី ពូទីន សព្វ ថ្ងៃ ។
សូម លោក រស់ និង ស្លាប់ បង្ហាញ ឈ្មោះ មន្ត្រី នោះ មក ។
យើង មិន ត្រូវការ យោបល់ ពី មជ្ឈដ្ឋាន ខាងក្រៅ នោះ ទេ ។
ខ្ញុំ មានអារម្មណ៍ ថា ខ្លួន មាន សំណាង ខ្លាំង ណាស់ ហើយ ខ្ញុំ សង្ឃឹម ថា ថ្ងៃ ណាមួយ ខ្ញុំ នឹង បាន ត្រឡប់ ទៅ ទី បេត៍ មាតុភូមិ របស់ ខ្ញុំ វិញ ជា មិន ខាន ។
ពួក ភិក្ខុ ជា សត្រូវ នាំយក អមនុស្ស ស្រី ។
បងប្អូន កូរ៉េ ទាំង ពីរ ពិតជា មិន អាច វិល មក រួមរស់ ជាមួយគ្នា បាន មែន ?
មើល ឯកសារ ហ្នឹង បាន ត្រូវ ធ្វើ អង្កេត បន្ថែម ឬ មិន ធ្វើ ។
មនុស្ស ប្រហែល១ ពាន់ នាក់ រស់ នៅ លើ កោះ នោះ រួចហើយ ។
និង វា មាន មុខងារ សន្តិសុខ ចាំបាច់ ទាំងអស់ ។
លោក ថា បើ ធ្វើ ដូចនេះ បាន នោះ ការតវ៉ា រឿង ជន អន្តោប្រវេសន៍ និង រឿង ព្រំដែន នឹង មាន ប្រសិទ្ធភាព ៕
លោក ឃឹម ប៊ុន សុង បន្ត កាន់ តំណែង ជា អភិបាល ខេត្ត សៀមរាប មួយ អាណត្តិ ទៀត
ប៉ុន្តែ ខ្ញុំ គិត ថា វា ធម្មតា ទៅ ហើយ គ្រប់ យ៉ាង គឺ ថ្មី សម្រាប់ ខ្ញុំ ។
ហើយ នឹង ឈាន ទៅដល់ ការឱប ថើប បបោស អង្អែល និង ចុងក្រោយ គឺ ការរួម មេត្រី ស្រី នឹង ស្រី ដូចគ្នា ។
តើ អ្នកណា ខ្លះ ដែល ធ្លាប់ ទទួលបាន ឯកសារ អ្វី មួយ ពី អាជ្ញាធរ ដោយ មិន បង់ប្រាក់ ថ្លៃ សេវា ក្រៅ ផ្លូវការ ?
ប៉ុន្តែ សម្រាប់ អ្នកវិភាគ បាន គិត ថា …
ខ្ញុំ បាន វិលត្រឡប់ ទៅ រោងចក្រ វិញ ហើយ ប្រធាន រដ្ឋបាល បាន ប្រគល់ លិខិត ឱ្យ ខ្ញុំ ស៊ីញ៉េ លា លែង ពី សហជីព ។
វា មិន ល្អ ហើយក៏ មិន អាក្រក់ ជាង មុនពេក ដែរ តែ វា នឹង មាន ភាពខុសប្លែក គ្នា ។
ដូច្នេះ ការរស់ នៅ ទីនោះ គឺជា រឿង ល្អ បំផុត បើ ធៀប នឹង ការជម្លៀស ។
ចំពោះ ការចាញ់ ឈ្នះ ចាំ អ៊ុត ថ្ងៃ នោះ តែម្តង ។
ការសន្យា នេះ លោក ធ្វើឡើង កាលពី ខែមករា ឆ្នាំ ២០២០ ។
តម្លៃ ខាងលើ នេះ ស៊ីសង លើ ការតថ្លៃ គ្នា ទៀត ។
ដូច យើង ត្រូវការអនុម័ត នូវ ការ ចំណាយ របស់ រដ្ឋាភិបាល ឆ្នាំ មុន ៗ
ដោយសារតែ កំហុស ដែល អ្នក មិន ចូលចិត្ត ៕
ហេតុ អ្វី បានជា តួអង្គក បិល មហា ព្រហ្ម ដែល ជា បិតា នៃ ទេពធីតា ទាំង ១២ត្រូវកាត់ ព្រះសិរសាក្បាល របស់ ទ្រង់ ?
ដោយសារ បញ្ហា អស់ រដូវ ដូចជា ជំងឺ ពុក ឆ្អឹង ជំងឺ បេះដូង ។
ចុច ប៊ូតុង បម្លែង នៅ ខាងក្រោម ។
សូម រំលឹក ថា បើ តាម សាវតារ នៃ រាជាណាចក្រ ថៃ គឺ ព្រះមហាក្សត្រ ថៃ មិន ត្រឹម គ្រងរាជ្យសម្បត្តិ ប៉ុណ្ណោះ ទេ តែ ព្រះអង្គ មាន ឥទ្ធិ ជាខ្លាំង លើ អ្នកនយោបាយ ។
បណ្ណាល័យ រូបភាព សំរាប់ ទាំងអស់ គ្នា
ការវាយប្រហារ របស់ ប្រទេស បារាំង ដូច ទៅនឹង ការវាយប្រហារ របស់ សហរដ្ឋ អាមេរិក កាលពី ១៤ ឆ្នាំ មុន
ជាក់ ជា មិន ខាន ប៉ុន្តែ មហាសេដ្ឋី ជីវិត ពិត បែរជា មិន ធ្វើ ដូច្នោះ ឡើយ ។
១៥លោក យ៉ាកុប ក៏ ចុះ ទៅ ស្រុក អេស៊ីប ហើយ លោក ទទួលមរណភាព ទៅ ពួក បុព្វបុរស ក៏ ទទួលមរណភាព នៅ ស្រុក នោះ ដែរ ។
របៀប ដែល យើង ធ្វើ ការកំពុងតែ ផ្លាស់ប្តូរ ហើយ ។
អ្នកស្រី បាន ប្រាប់ ពី ជីវិត រស់ នៅ ប្រចាំ ថ្ងៃ ថា ៖
ម៉ោង នេះ យើង មិន ទាន់ ដឹង យ៉ាងម៉េច ទេ ពី នីតិវិធី នៃ ការបោះឆ្នោត តែ ប្រហែលជា អត់ ខុសពី ឆ្នាំ មុន ទេ ។
១១ខ្ញុំ និយាយ ដូច្នេះ ដូចជា មនុស្ស លេលា ហើយ គឺ មកពី បងប្អូន បង្ខំ ខ្ញុំ ដ្បិត បងប្អូន ហ្នឹង ហើយ ដែល ត្រូវ គាំទ្រ ខ្ញុំ ទោះបី ខ្ញុំ ជា មនុស្ស ឥត បាន ការ ក្តី ក៏ ខ្ញុំ មិន អន់ ជាង មហាសាវ័ក ទាំងនោះ ដែរ ។
ពេល ខ្លះ ទៀត វា បន្សល់ នូវ ភាព ស្តាយក្រោយ ។
ដំណាក់កាល ទី4ការរក ប្រាក់ និង ការធានារ៉ាប់រង ។
ចង់បាន កូនប្រុស ឬ កូនស្រី គួរ ទទួល ទាំន អាហារ ប្រភេទ ណា ?
បាន រកឃើញ ជម្រក ថ្មី ហើយ ។
ប្រទេស ទាំង ពី បាន ចូលកាន់កាប់ ផ្នែក ផ្សេង ៗ
ឥឡូវនេះ ទូលបង្គំ សុខចិត្ត ស្លាប់ ហើយ !
តើ អ្នក នឹង ធ្វើ ដូចម្តេច ខ្លះ ដើម្បីឱ្យ បាន សម្រេច គោលដៅ នោះ ?
នៅ ជ្រុង ដំបូល សុទ្ធតែ មាន រូប សត្វ នាគ ។
មុខ នេះ អ្វី ដែល ចាំបាច់ គឺជា លទ្ធផល នៃ ការបោះឆ្នោត ប្រកបដោយ
មុខ នេះ អ្វី ដែល ចាំបាច់ គឺជា លទ្ធផល នៃ ការបោះឆ្នោត ប្រកបដោយ
ទៀត នឹង លែង មាន លេស ប្រើ បញ្ហា នេះ សម្រាប់ ការចំណេញ នយោបាយ ទៀត ហើយ ។
ដូច្នេះហើយ បានជា ច្បាប់ ហាម ក្មេង មិន អោយ ផឹក គ្រឿងស្រវឹង ។
នៅ ពាក់កណ្តាល ឆ្នាំ ១៩៩០ លោក ក្រាក់ ជី មាន ចំណាប់អារម្មណ៍ ធ្វើអង្កួច ។
ឯកឧត្តម ស្នងការបាន ថ្លែង ថា នេះ គឺជា លើក ទី១ ហើយ ដែល បាន ចុះ សួរសុក្ខ ទុក្ខ និង សំណេះសំណាល ជាមួយ ប្អូន ៗ
បុរស អនាថា ម្នាក់ ត្រូវ រថយន្ត បុក ស្លាប់
ពិធី មង្គលការ នេះ នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២២មិថុនា ។
នឹង ជួបប្រជុំគ្នា នៅ ថ្ងៃសៅរ៍ ដើម្បី ពិភាក្សា អំពី ស្ថានភាព នេះ ។
តាម ធម្មតា ពេល លេង បាល់ ជាមួយគ្នា ឃើញ តែ វា រក រឿង អ្នកដទៃ រហូត ។
គ្រាន់តែ ប៉ុន ហ្នឹង សោះ វា ប្រតិកម្ម ដល់ អាច្រម៉ង់ ភ្លាម !
នេះ មាន ន័យ ថា ដំណើរការចាស់ បាន ចាប់ផ្តើម ហើយ ។
មាន រឿង អ្វី កើតឡើង ពេល អ្នកម៉ាស្សា នៅ ត្
ក្នុង យល់សប្តិ គេ ឃើញ ឡាន ដឹក សំរាម បុក កូនក្មេង ខណៈ កំពុង លេង នៅលើ ចិញ្ចើម ថ្នល់ ។
ប្រធានាធិបតី ប្រទេស វេណេហ្ស៊ុយអេឡា …
បន្ទាប់មក ចាំ ទៅតាម ដាន លទ្ធផល ទាំងអស់ គ្នា ។
បើ គ្មាន ប្រទេស ចិន និង លោក ប្រធានាធិបតី គីម អ៊ីល ស៊ុង នៃ សាធារណរដ្ឋ ប្រជាមានិត ប្រជាធិបតេយ្យ កូរ៉េ ទេ តើ ខ្ញុំ នឹង ក្លាយទៅជា យ៉ាងណា ទៅ ?
ឥឡូវនេះ អ្នក នឹង មើល ទៅកាន់ ទ្រង់ តែ មួយ គត់ ។
នឹង មិន មាន បញ្ហា ទេ តែ បើ ដឹកនាំ បែប ផ្តាច់ការការផ្លាស់ប្តូរ នោះ អាច បង្ក ជា បញ្ហា ។
ទាំងអស់ នឹង ត្រូវ ហាមឃាត់ រហូតដល់ មាន ការជូនដំណឹង បន្ថែម ទៀត ។
ចុះឈ្មោះ ទុក កន្លែង អោយ អ្នក ផ្សេង រៀន ។
ដែល ខ្ញុំ ចូលចិត្ត ស្តាប់ ។
ហើយក៏ អាចនឹង ដោះស្រាយ ហានិភ័យ នៃ ការរំលាយ គណបក្ស បាន មួយ រយៈ ផងដែរ ។
អ្នក ថតរូប ល្អ ម្នាក់ នៅ កម្ពុជា ។
មាន ការលំបាក យឺតយ៉ាវ ។
លោក បញ្ជាក់ ថា មកទល់ ពេលនេះ ក៏ មិន មាន អ្នកណា ម្នាក់ ធ្វើឱ្យ ចលាចល ឬ ធ្វើ បដិវត្តន៍ ពណ៌ អ្វី ដែរ ៖
ដែរ ខណៈ សំណុំរឿង នេះ ផ្ទុះ ខ្លាំង ឡើង ៗ
ម៉ារី ស្លាប់ ហើយ
រង់ចាំ មនុស្ស ប្រុស ត្រឡប់
គាត់ គឺជា មន្ត្រី ដែល ធ្វើការ ឱ្យ របប នេះ ។
ខ្ញុំ គិត ថា ការសម្តែង របស់ ពួកយើង ហាក់ដូចជា ធម្មជាតិ ពិត ៗ
នាង បាន រស់ នៅក្នុង ស្ថានភាព របៀប នេះ តាំងពី នាង មាន អាយុ ១៤ឆ្នាំ មក ម្ល៉េះ ។
ការបណ្តុះ ផ្សិត មិន ចាំបាច់ ចំណាយ ដើមទុន ធំ ប៉ុន្មាន ទេ សារព័ត៌មាន នគរ វត្ត
១ ព្រះអម្ចាស់ នឹង បំផ្លាញ ផែនដី អោយ
តាម ច្បាប់ បាន ចែង ហើយ កំណត់ ពី អំពើ ណា ជា បទល្មើស ហើយ អំពើ ណា ប្រព្រឹត្ត បទល្មើស និង ទោស យ៉ាងណា នោះ ។
ជួបគ្នា ម្តង ទៀត អរគុណ
នគរបាល ជាតិ បញ្ជាក់ ថា នាង សន្យា មិន ឱ្យ កំហុស បែប នេះ កើតឡើង ជា លើក ទី២ ជាដាច់ខាត ៕
អ្នក ប៉ះពាល់ ខ្លាំង ជាង គេ គឺ កម្មករ ។
រងរបួស ធ្ងន់ ស្រាល 2នាក់ ដោយសារ ម៉ូតូ ពីក្រោយ បុក
ប៉ុន្តែ ក្នុង នោះ រថយន្ត ថ្មី ៗ
ចំណែក ស្ត្រី កម្ម ការិនី មិន បាន ស្គាល់ ឈ្មោះ នោះ ទេ ។
ការភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង និង ស្មាន ថា លោក ជា ខ្មោច ។
កម្មាភិបាល យើង ទាំងអស់ កងទ័ព យើង ទាំងអស់ ក៏ ដូច្នោះ ។
សម្រាប់ ជំនាញ ព័ត៌មានវិទ្យា អាច មាន ជម្រើស ច្រើន ។
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក កម្ពុជ សុរិយា ៖
គណបក្ស នេះ បាន ឈ្នះ អាសនៈ មួយ ក្នុង ចំណោម អាសនៈ សភា ថ្នាក់ រដ្ឋ ចំនួន ៧ ។
មេក្រឡុក ខ្លាឃ្លោកស៊ី សង គេចខ្លួន អស់ ។
គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បាន ឆក់ យក ជីវិត អ្នក ម្នាង អ៊ុក ផល្លា ចំណែក សម្តេច ក្រុម ព្រះវិញ បាន រងរបួស ធ្ងន់ធ្ងរ ។
បើសិនជា អ្នកប្រើ កន្ទប់ ក្រណាត់ ដែរ នោះ ចូរ បោកវា ដាច់ដោយឡែក ពី សម្លៀកបំពាក់ ដែរ ៕
លោក ពេត្រុស ឆ្លើយ ថា ៖
ការផ្លាស់ប្តូរ នេះ ត្រូវបាន នាង បញ្ជាក់ ថា ដើម្បី ជា ការផ្លាស់ប្តូរ មុខ ម្ហូប ដើម្បី ការចាប់អារម្មណ៍ ។
បើ ហ៊ុន សែន ងាប់
យើងខ្ញុំ តែងតែ មាន មន្ទិល សង្ស័យ លើ សមត្ថភាព របស់ ព្រះជាម្ចាស់ ក្នុង ការផ្លាស់ប្តូរ កាលៈទេសៈ របស់ យើងខ្ញុំ ដដែល ។
ស្បែក នៅ ជុំវិញ ភ្នែក របស់ អ្នក គឺជា ផ្នែក ដ៏ រសើប បំផុត នៃ ផ្ទៃ មុខ របស់ អ្នក និង ជា តំបន់ មួយ ក្នុង ចំណោម តំបន់ ដំបូង ដែល បង្ហាញ សញ្ញា នៃ ភាពចាស់ ។
ប៉ុន្តែ យ៉ាងហោចណាស់ អត្ថបទ នេះ គឺជា ការចាប់ផ្តើម ដ៏ ល្អ មួយ ។
៣ ព្រះអង្គ ជា ទី ជំរក របស់ ទូល បង្គំ
ប៉ុន្ត ឥឡែូវ កំពុង ស្ថិត ក្នុង កិច្ចពិភាក្សា នៅឡើយ ។
បិតា របស់ លោក ស៊ីន ច័ន្ទ ឆាយា ៕
ល្ខោន ម៉ូត អ៊ីស្រាអែល
ធម្មតា អ្នកអង្គុយ តុ ធំ ជាង អ្នក បំរើ តុ ។
លោក មាន លទ្ធផល តេស្ត អវិជ្ជមាន ដូច្នេះ យើង ត្រូវ យល់ រឿង នេះ ក៏ប៉ុន្តែ លោក បាន ជួប ផ្ទាល់ ជាមួយ មនុស្ស ច្រើន ។
