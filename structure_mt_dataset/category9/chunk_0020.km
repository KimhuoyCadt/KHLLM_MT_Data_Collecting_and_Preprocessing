( ភ្នំពេញ ) ៖ ស្រាបៀរ កម្ពុជា បាន ធ្វើ ពិធី ប្រគល់ រង្វាន់ កម្មវិធី អាពាហ៍ពិពាហ៍ របស់ ខ្លួន ទៅ ឱ្យ គូរ ស្វាមី ភរិយា ថ្មី ចំនួន ៤៤០ គូ ពី បណ្តាល រាជធានី ខេត្ត ក្រុង ទូរ ទាំង ប្រទេស កម្ពុជា ដែល 440 គូ មកពី ក្រចេះ 14 គូ ពី ខេត្ត កំពង ចាម ៧គូ ពី ព្រៃវែង ១៣គូ ពី សៀមរាប ៣១ គូ កំពង់ឆ្នាំង ៨១ គូ កំពង់ធំ ៤៧គូ កំពង់ស្ពឺ ១០គូ ត្បូងឃ្មុំ ១៦គូ បន្ទាយមានជ័យ ៤គូ ពោធិ៍សាត់ ៦៣គូ ស្វាយរៀង ៤២ គូ និង ខេត្ត ផ្សេង ៗ ទៀត កាលពី ព្រឹក ថ្ងៃទី ១៥ ខែ កក្កដា នេះ ។
សូម បញ្ជាក់ កម្មវិធី ចាប់ រង្វាន់ អាពាហ៍ពិពាហ៍ នេះ នឹង ធ្វើឡើង ម្តង ទៀត ជា លើក ចុងក្រោយ សម្រាប់ រដូវកាល ឆ្នាំ ២០១៩ នៅ ខែសីហា ទី ១៥ ខាងមុខ នេះ ហើយ ចំនួន រង្វាន់ នីមួយ ៗ គឺ ដូច ទៅនឹង ចំនួន រង្វាន់ ខាង លើ នេះ ដែរ ។
គួរ បញ្ជាក់ ថា ភាពតានតឹង រវាង សហរដ្ឋ អាមេរិក និង អ៊ីរ៉ង់ កាន់តែ ឡើង កម្តៅ ខ្លាំង ឡើង នៅក្រោយពី លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ សម្រេចចិត្ត ដក អាមេរិក ចេញ ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ អ៊ីរ៉ង់ ជា ឯកតោ ភាគី កាលពី ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ។
ជា ការឆ្លើយតប ភាគី អ៊ីរ៉ង់ បាន ប្រកាស កាលពី ដើម ខែកក្កដា នេះ ថា ខ្លួន បាន បង្កើន ការចម្រាញ់ សារធាតុ អ៊ុយរ៉ាញ៉ូម លើស ពី អ្វី ដែល បាន កំណត់ ក្នុង កិច្ចព្រមព្រៀង ។ ប៉ុន្តែ ប្រទេស នេះ នៅតែ អះអាង ថា ខ្លួន គឺ គ្មាន បំណង បង្កើត អាវុធ នុយក្លេអ៊ែរ នោះ ទេ ព្រោះ បើ ចង់ មាន អាវុធ នេះ មែន គឺ អ៊ីរ៉ង់ អាច មាន យូរ ណាស់ ហើយ ៕ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ស្ទឹងត្រែង បង្ហាញ ផលិតផល ក្នុង ស្រុក ដែល មាន សក្កានុពល ជាង គេ នៅក្នុង ខេត្ត
( ស្ទឹងត្រែង ) ៖ នៅ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ស្ទឹងត្រែង នា ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០១៩ មាន ការដាក់ តាំង ពិពណ៌ ផលិតផល ក្នុង ស្រុក ចំនួន ១០មុខ ដែល បាន មកពី បណ្តា សហគមន៍ ក្នុង ខេត្ត ស្ទឹងត្រែង ក្រោម អធិបតីភាព លោក យង់ សុវឌ្ឍនា អភិបាល រង ខេត្ត . លោក អួង សុខ ន អគ្គ នាយក រង អគ្គ នាយកដ្ឋាន ជុំ រុញ ពាណិជ្ជកម្ម រួម និង មន្រ្តី រាជការ តាម បណ្តា មន្ទីរ ក្នុង ខេត្ត ចូលរួម ។
ក្នុង ពិធី នោះ លោក អួង សុខ ន អគ្គ នាយក រង អគ្គ នាយកដ្ឋាន ជំរុញ ពាណិជ្ជកម្ម បាន ថ្លែង ថា ដើម្បី ប្រកួតប្រជែង នៅលើ ទីផ្សារ នូវ ផលិតផល ក្នុង ស្រុក របស់ សហគមន៍ នេះ សូម ខាង មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត រៀបចំ ចុះបញ្ជី ការ ឲ្យបាន ត្រឹមត្រូវ ដើម្បី ងាយស្រួល យក ផលិត ទៅ ប្រកួតប្រជែង នៅលើ ទីផ្សារ នានា ។
លោក អួង សុខ ន បាន បន្ត ថា នៅ ខេត្ត ស្ទឹងត្រែង លោក សង្កេតឃើញ មាន ផលិតផល ចំនួន ពីរ ដែល មាន សក្តានុពល ជាង គេ គឺ ទឹកត្រី ប៉ា សេអ៊ី នៅ សហគមន៍ កោះ ព្រះ និង ម្នាស់ ទឹកឃ្មុំ នៅ ឃុំ អូរ ឬស្សី កណ្តាល ស្ថិត នៅក្នុង ស្រុក សៀម បូក ។
( ត្បូងឃ្មុំ ) ៖ អភិបាល ខេត្ត ត្បូងឃ្មុំ លោក ជា ម ច័ន្ទ សោភ័ណ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ អញ្ជើញ ប្រកាស ឲ្យ ចូលកាន់ តំណែង អភិបាល ស្រុក មេមត់ ថ្មី ដោយ មាន ការចូលរួម ពី អភិបាល រង ខេត្ត មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ ជាង ៣០០ នាក់ ។
សូម បញ្ជាក់ ថា អភិបាល ស្រុក មេមត់ ដែល ត្រូវ ប្រកាស តែងតាំង ឲ្យ ចូលកាន់ តំណែង នៅ ថ្ងៃ នេះ គឺ លោក ស្រេង លី អតីត អភិបាល ស្រុក ក្រូចឆ្មារ ជំនួស លោក ចេង ប៊ុណ្ណារ៉ា ត្រូវ បាន ឡើង តំណែង ជា អភិបាល រង ខេត្ត ត្បូងឃ្មុំ ។
លោក ជា ម ច័ន្ទ សោភ័ណ បាន លើកឡើង ថា ការប្រកាស តែងតាំង ចូលកាន់ មុខតំណែង នេះ វា ជា បែបបទ នីតិវិធី បាន កំណត់ ក្នុង ច្បាប់ ហើយ ត្រូវបាន យកមក អនុវត្ត ក្នុង ប្រព័ន្ធ រដ្ឋបាល សំដៅ ធ្វើ យ៉ាងណា ឲ្យ ការគ្រប់គ្រង ដឹកនាំ រដ្ឋបាល កាន់តែ មាន ប្រសិទ្ធភាព ក្នុង ការឆ្លើយតប នឹង តម្រូវការ នៅ មូលដ្ឋាន ។
លោក អភិបាល ខេត្ត ស្នើឲ្យ លោក អភិបាល ស្រុក មេមត់ ថ្មី បង្កើន កិច្ចសហការ ផ្ទៃក្នុង និង គ្រប់ មជ្ឈដ្ឋាន ឲ្យន បាន ល្អ ប្រសើរ និង ត្រូវ បែងចែក ការងារ ឲ្យ ច្បាស់លាស់ សំដៅ ធ្វើ យ៉ាងណា រដ្ឋបាល ស្រុក ការងារ កាន់តែ មាន ប្រសិទ្ធភាព ។
ពិសេស សុខ ទុក្ខ មន្ត្រីរាជការ ដែល មាន ការលំបាក កន្លងមក ត្រូវ ជួយ សម្រួល និង ដោះស្រាយ ជូន ពួកគាត់ ដែល កន្លងមក ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ និង ការតម្រង់ ទិស ពីសំណាក់ សម្តេច ក្រឡាហោម ស ខេង ក៏ ដូចជា លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា តែងតែ យកចិត្តទុកដាក់ បំផុត ចំពោះ មន្ត្រីរាជការ យើង ។
លោក ក៏ បាន ក្រើន រំលឹក អាជ្ញាធរ មូលដ្ឋាន អភិបាល ស្រុក មេឃុំ មេភូមិ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ការចុះ ឲ្យ ដល់ មូលដ្ឋាន ប្រមូល ព័ត៌មាន យល់ ឲ្យ ច្បាស់ ពី សុខ ទុក្ខ និង ចុះ ឲ្យ កៀក ជាប់ ជាមួយ ពលរដ្ឋ ដើម្បី ដោះស្រាយ បញ្ហា និង តម្រូវ ការចាំបាច់ ជូន ពួកគាត់ ក៏ ដូចជា ប្រមូល សន្លឹក ឆ្នោត ពី ពួកគាត់ ជូន គណបក្ស ប្រជាជន ដូចគ្នា វិញ ផងដែរ ។
ជាមួយគ្នា នេះ ផងដែរ លោក ជា ម ច័ន្ទ សោភ័ណ ក៏ បាន ធ្វើ ការណែនាំឲ្យ លោក អភិបាល ស្រុក ថ្មី ត្រូវ សហការ គ្នា សាមគ្គី គ្នា ដើម្បី ដឹកនាំ ការងារ ក្នុង ស្រុក ឲ្យ ទទួលបាន ជោគជយ័ ជាពិសេស ត្រូវ យកចិត្តទុកដាក់ អនុវត្តន៍ គោល នយោបាយ ភូមិ - ឃុំ សុវត្ថិភាព បញ្ឈប់ ឲ្យបាន នូវ បញ្ហា ល្បែងស៊ីសង និង បទល្មើស គ្រប់ ប្រភេទ ឲ្យ មាន ប្រសិទ្ធិភាព និង យកចិត្តទុកដាក់ ទប់ស្កាត់ ការរំលោភ យក ដី រដ្ឋ និង ដី ចំណី ផ្លូវ សាធារណៈ ផងដែរ ។
ព្រមទាំង យកចិត្តទុកដាក់ ចំពោះ បញ្ហា គ្រោះថ្នាក់ ចរាចរណ៍ ក៏ ដូចជា បំផុស ឲ្យ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ ឲ្យ ចេះ ស្រលាញ់ បរិស្ថាន សម្អាត អនាម័យ ជុំវិញ ស្រុក មេមត់ និង បំពេញ ឲ្យបាន នូវ តម្រូវ ការចាំបាច់ របស់ ពលរដ្ឋ ក្នុង នាម ជា អាណាព្យាបាល របស់ បងប្អូន ៕ ថ្ងៃស្អែក នេះ ក្រុមហ៊ុន Opennet នឹង មាន ឱកាស ការងារ ៦៥ កន្លែង រង់ចាំ សិស្ស - និស្សិត ដែល កំពុង ស្វែងរក ការងារ
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន Opennet ដែល ជា ក្រុមហ៊ុន ផ្គត់ផ្គង់ និង ផ្តល់ សេវា អ៊ីនធឺណិត នៅ ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០១៩ ស្អែក នេះ នឹង មាន ឱកាស ការងារ ចំនួន ៦៥ កន្លែង សម្រាប់ សិស្ស - និស្សិត ដែល កំពុង ស្វែងរក ការងារ និង ចង់ ផ្លាស់ប្តូរ ការងារ ថ្មី ដើរ ចូល សម្ភាសន៍ ផ្ទាល់ ចាប់ពី ម៉ោង ០៨៖០០ ព្រឹក ដល់ ម៉ោង ០៥៖០០ ល្ងាច នៅ មជ្ឈមណ្ឌល ការងារ រាជធានី ភ្នំពេញ ស្ថិត នៅក្នុង ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
ទេសរដ្ឋមន្ត្រី គន់ គីម ប្រាប់ មន្ត្រី ក្នុង ខេត្ត ត្បូងឃ្មុំ ឱ្យ ត្រៀមលក្ខណៈ សម្បត្តិ ជួយ ពលរដ្ឋ រងគ្រោះ ដោយ គ្រោះ ធម្មជាតិ
( ត្បូងឃ្មុំ ) ៖ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ នៅ ថ្ងៃពុធ ទី១៧ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ របស់ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ត្បូងឃ្មុំ និង ដាក់ចេញ នូវ វិធានការ មួយចំនួន ដើម្បី ត្រៀម បង្ការ ដោះស្រាយ បញ្ហា ផ្សេង ៗ កើត ចេញ ពី គ្រោះ ធម្មជាតិ នៅក្នុង ខេត្ត ។
ក្នុង កិច្ចប្រជុំ នោះ លោក គន់ គីម ក្រើន រំលឹក ថា ខេត្ត ត្បូងឃ្មុំ ក៏ ជា ខេត្ត មួយ ដែល ជាប់ នឹង ដង ទន្លេ មេគង្គ ហើយ រដូវ វស្សា នេះ ក៏ ជា ពេល ដែល ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ដោយសារ គ្រោះ ទឹក ជំនន់ ។ លោក ទេសរដ្ឋមន្ត្រី បាន ក្រើន រំលឹក ទៅដល់ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង ជា ប្រធាន គណៈកម្មការគ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ក៏ ដូចជា មន្ត្រី ពាក់ព័ន្ធ ក្នុង ខេត្ត កងកម្លាំង សមត្ថកិច្ច ឱ្យ ត្រៀមលក្ខណៈ សម្បត្តិ ក្នុង ការជួយសង្គ្រោះ ជួយ ជម្លៀស ប្រជាពលរដ្ឋ ពេល ជួប នូវ គ្រោះ ទឹក ជំនន់ ។
លោក គន់ គីម បាន បញ្ជាក់ ដូច្នេះ « ដេីម្បី ត្រៀម បង្ការ និង ឆ្លេីយ តប បាន ទាន់ ពេលវេលា ខេត្ត ត្រូវ ធ្វេី ផែន ការត្រៀម ឱ្យ បាន លំអិត ជាក់ស្តែង រួមទាំង ការបម្រុង ទី ទួល សុវត្ថិភាព មធ្យោបាយ សម្ភារៈ ការត្រៀម បម្រុង កម្លាំង សម្រាប់ ជួយ អន្តរាគមន៍ ដោយ មាន រៀបចំ ហ្វឹកហាត់ ជាមុន និង ត្រូវ យកចិត្តទុកដាក់ បណ្តុះបណ្តាល ធនធាន មនុស្ស សម្រាប់ ជួយសង្គ្រោះ ជនរងគ្រោះ ជាដើម » ។
បើ ទោះបីជា យ៉ាងណា លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន កោតសសេីរ ចំពោះ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ដែល ក្តាប់ ជាប់ និង មាន ផែនការ ក្នុង ការត្រៀម បង្ការ និង ឆ្លេីយ តប ពេល មាន គ្រោះមហន្តរាយ ។
តាម របាយការណ៍ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន គូសបញ្ជាក់ ថា រយៈពេល ៦ខែ ឆ្នាំ ២០១៩ កន្លង ខ្យល់ កន្ត្រាក់ រន្ទះ បាញ់ អគ្គីភ័យ លង់ទឹក និង ជំងឺ រាតត្បាត ផ្សេង ៗ បាន ធ្វើឲ្យ ប៉ះពាល់ លើ ទ្រព្យសម្បត្តិ និង បង់ ជីវិត ប្រជាពលរដ្ឋ ក្នុ ខេត្ត សរុប ចំនួន ០៧ នាក់ . ផ្ទុះ ជំងឺ ងឺ ឆ្លង ប៉េស ជ្រូក អាហ្វ្រិក ងាប់ ជ្រូក ៤៧ ក្បាល និង ជំងឺ គ្រុន ឈាម កើនឡើង ១. ៩៨៣ ករណី ។
ជាមួយគ្នា នោះ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ខេត្ត ដោយ មាន ការគាំទ្រ ពី គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ សប្បុរសជន នានា ព្រម ទំាង មាន កិច្ចសហការ ជាមួយ សាខា កាកបាទ ក្រហម ខេត្ត និង កាកបាទ ក្រហម កម្ពុជា បាន ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ដល់ គ្រួសារ រងគ្រោះ ដោយសារ ខ្យល់ កន្ត្រាក់ រលំ ផ្ទះ អគ្គីភ័យ គ្រួសារ ក្រីក្រ ស្ត្រី មេម៉ាយ ចាស់ជរា ជន ពិការ បាន ទាន់ ពេល វា លា ផងដែរ ៕
លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា មន្ត្រី នាំ ពាក្យ ក្រសួង បរិស្ថាន បាន ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា កាកសំណល់ ខុស ច្បាប់ ទាំងនេះ មាន ប្រភព នាំចូល ពី សហរដ្ឋ អាមេរិក និង ប្រទេស កាណាដា ដែល មាន ទម្ងន់ រហូតដល់ ១៦០០តោន និង ត្រៀម ឲ្យ បញ្ជូន ទៅកាន់ ប្រទេស ដើម វិញ ។
អ្នកនាំពាក្យ រូប នោះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « តាម ទិន្នន័យ បឋម ដែល ទទួលបាន ពី សមត្ថកិច្ចស៊ើបអង្កេត សំណល់ ប្លាស្ទិក ទាំង ៨៣ កុង ទឺន័រ ដែល ជា ទំនិញ ហាមឃាត់ ត្រូវបាន សមត្ថកិច្ច បង្ក្រាប បាន នៅ កំពង់ផែ ស្វយ័ត ព្រះសីហនុ មាន ប្រភព មកពី សហរដ្ឋ អាមេរិក និង ប្រទេស កាណាដា មាន ទម្ងន់ ប្រមាណ ១៦០០តោន ។ សមត្ថកិច្ច កិច្ច បាន និង កំពុង រៀបចំ ដំណើរការ នីតិវិធី ដើម្បី បញ្ជូន ទៅ ប្រភព ដើម វិញ និង ធ្វើការ ផាកពិន័យ លើ ក្រុមហ៊ុន ដែល នាំចូល មក នោះ តាម ច្បាប់ ជាធរមាន » ។
« កម្លាំង សមត្ថកិច្ច ជំនាញ បាន និង កំពុង បន្ត ការស៊ើបអង្កេត ស៊ីជម្រៅ បន្ថែម ទៀត ដើម្បី ស្វែងរក មូលហេតុ ពិតប្រាកដ ដែល នាំឱ្យ មាន ការនាំចូល សំណល់ ប្លាស្ទិក នេះ ដែល ជា ទំនិញ ត្រូវ ហាមឃាត់ នេះ មកកាន់ ប្រទេស កម្ពុជា ។ សមត្ថកិច្ច ក៏ បាន និង កំពុង ស៊ើបអង្កេត ស្វែងរក ក្រុមហ៊ុន ដែល លួច នាំ ចូល នូវ សំណល់ ប្លាស្ទិក បេះ ដើម្បី ចាត់ វិធានការ តាម ច្បាប់ ជាធរមាន » នេះ បើ តាម ការបញ្ជាក់ បន្ថែម ពី លោក ភក្រ្តា អ្នកនាំពាក្យ សកម្ម មួយ រូប របស់ ក្រសួង បរិស្ថាន ។
ការបង្ក្រាប លើ ការនាំចូល សំណល់ ប្លាស្ទិក ពី បរទេស មក ចូល ប្រទេស កម្ពុជា នៅ ពេល នេះ បាន បញ្ជាក់ ពី ការអនុវត្ត ច្បាប់ យ៉ាង ម៉ឺងម៉ាត់ ចំពោះ មុខ ទំនិញ ដែល ហាមឃាត់ និង ប្រភេទ សំណល់ ប្រកបដោយ គ្រោះថ្នាក់ ។ ការបង្ក្រាប បាន ទាន់ ពេលវេលា នូវ ទំនិញ ហាមឃាត់ សំណល់ ប្លាស្ទិក នេះ ក៏ បាន បង្ហាញ ពី កិច្ចសហការ យ៉ាង ស្អិត រមួត រវាង ក្រសួង បរិស្ថាន និង ស្ថាប័ន ពាក់ព័ន្ធ រួម មាន អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ និង កំពង់ផែ ស្វយ័ត ក្នុង ការទប់ស្កាត់ ទំនិញ ហាមឃាត់ មិន ឱ្យ ចូលមក កម្ពុជា បាន ។
រាជ រដ្ឋាភិបាល កម្ពុជា នឹង បន្ត អនុវត្ត វិធានការ ច្បាប់ តឹងរឹង ប្រឆាំង នឹង ការលួច នាំចូល ទំនិញ ហាមឃាត់ គ្រប់ ប្រភេទ ។ រាជ រដ្ឋាភិបាល កម្ពុជា មិន អនុញ្ញាត ឲ្យ មាន ជាដាច់ខាត ចំពោះ ការនាំចូល សំណល់ ប្លាស្ទិក មក កែច្នៃ នៅ កម្ពុជា ទេ ។ កម្ពុជា មិន មែន ជា ធុង សំរាម សម្រាប់ ការបោះចោល បច្ចេក វិទ្យា ហួស សម័យ នោះ ទេ ហើយ កម្ពុជា តែងតែ ជំទាស់ ជានិច្ច នឹង ការនាំចូល សំណល់ ប្លាស្ទិក និង ប្រេង ម៉ាស៊ីន មក កែច្នៃ នៅ កម្ពុជា ។
សូម ជំរាប ថា នៅ រសៀល ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ក្រសួង បរិស្ថាន និង អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ស្ថាប័ន ពាក់ព័ន្ធ បាន សម្រេច គាស់ ទូរ កុងទឺន័រ ទាំងអស់ នោះ ដើម្បី ពិនិត្យ ជាក់ស្ដែង នៅក្នុង កំពង់ផែ ខេត្ត ព្រះសីហនុ ក្រោយពី មាន ការសង្ស័យ លើ ទំនិញ ដែល មាន នៅក្នុង ទូរកុងទឺន័រ នោះ ៕
ក្រសួង ការងារ ចាប់ផ្តើម ពិភាក្សា អំពី ការដំឡើង ប្រាក់ ឈ្នួល ដល់ កម្មករ កាត់ដេរ សម្រាប់ ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ ការពិភាក្សា អំពី ដំឡើង ប្រាក់ ឈ្នួល អប្បរមា ដល់ កម្មករ នយោជិត ផ្នែក វាយន ភណ្ឌ កាត់ដេរ និង ផលិត ស្បែកជើង នៅ កម្ពុជា សម្រាប់ ឆ្នាំ ២០២០ បាន ចាប់ផ្តើម នៅក្នុង ខែកក្កដា នេះ ដោយ នឹង ធ្វើ បន្តបន្ទាប់ រហូតដល់ ខែតុលា ។ នេះ បើ តាម សេចក្តីជូនដំណឹង របស់ ក្រសួង ការងារ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
តាម សេចក្តីជូនដំណឹង បាន ឱ្យដឹង ថា ការពិភាក្សា ប្រាក់ ឈ្នួល អប្បរមា សម្រាប់ ឆ្នាំ ២០២០ ត្រូវ អនុវត្ត តាម ដូច ខាងក្រោម៖
* កំណត់ យក ខែកក្កដា ឆ្នាំ ២០១៩ ជា ការចាប់ផ្តើម ពិភាក្សា ប្រាក់ ឈ្នួល អប្បរមា ជា លក្ខណៈ ផ្ទៃក្នុង របស់ ភាគី នីមួយ ៗ ។ * កំណត់ យក ខែសីហា ឆ្នាំ ២០១៩ ជា ការចាប់ផ្តើម ពិភាក្សា ប្រាក់ ឈ្នួល អប្បរមា ជា លក្ខណៈ ត្រី ភាគី * កំណត់ យក ខែតុលា ឆ្នាំ ២០១៩ បើក កិច្ចប្រជុំ ក្រុមប្រឹក្សា ជាតិ ប្រាក់ ឈ្នួល អប្បរមា ដើម្បី សម្រេច ប្រាក់ ឈ្នួល អប្បរមា ផ្នែក វាយន ភណ្ឌ កាត់ដេរ និង ផលិត ស្បែកជើង សម្រាប់ ឆ្នាំ ២០២០ * កំណត់ យក ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២០ ជា កាលបរិច្ឆេទ ចូល ជាធរមាន ប្រាក់ ឈ្នួល អប្បរមា ។
បើ តាម សេចក្តីជូនដំណឹង របស់ ក្រសួង ការងារ . គ្រប់ ភាគី ទាំងអស់ ត្រូវ ប្រើ លក្ខណ វិនិច្ឆ័យ បែប សង្គម ( ស្ថានភាព គ្រួសារ អត្រា អតិផរណា និង ការចំណាយ ក្នុង ការរស់នៅ ) និង លក្ខណ វិនិច្ឆ័យ បែប សេដ្ឋកិច្ច ( ផលិតភាព ភាព ប្រកួតប្រជែង របស់ ប្រទេស ស្ថានភាព ទីផ្សារ ការងារ និង កម្រិត ចំណេញ របស់ វិស័យ ) ក៏ ដូចជា បន្ទាត់ ភាពក្រីក្រ សម្រាប់ ធ្វើជា មូលដ្ឋាន ក្នុង ការពិភាក្សា ប្រាក់ ឈ្នួល អប្បរមា នៅ កម្ពុជា ។
គ្រប់ ភាគី ទាំងអស់ សូម ផ្តោត លើ ទិន្នន័យ និង ការស្រាវជ្រាវ បែប វិទ្យាសាស្ត្រ ដោយ យោង លើ លក្ខណ វិនិច្ឆ័យ ទាំង៧ ដូច បាន កំណត់ ក្នុង មាត្រា៥ នៃ ច្បាប់ ស្តីពី ប្រាក់ ឈ្នួល អប្បរមា ដើម្បី ធ្វើជា មូលដ្ឋាន ក្នុង ការសម្របសម្រួល ផ្ទៃក្នុង និង ប្រកាន់ គោលជំហរ រួម មួយ ។
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា គួច ម៉េង លី អគ្គ នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ម៉េង លី ជេ. គួច អេខ្យូ ខេ សិន បាន អំពាវនាវ ឲ្យ យុវជន - យុវនារី ដែល បាន ទៅ សិក្សា ឬ ធ្វើការ នៅ បរទេស សូម វិលត្រឡប់មក ប្រទេស កម្ពុជា នៅពេល បញ្ចប់ ការសិក្សា ឬ បញ្ចប់ ការងារ ដើម្បី មក ចូលរួម ជួយ អភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ។
លោក បន្ដ ថា ពេល ដែល ទៅ ធ្វើការ នៅ ស្រុក គេ ត្រូវ បែក ប្រពន្ធ កូន . ម្ដាយ ឪពុក ជាច្រើន ឆ្នាំ ដូច្នេះ ទៅ ហើយ រក្សា ខ្លួន ឲ្យបាន ល្អ កសាង ខ្លួន ឲ្យបាន ល្អ . អភិវឌ្ឍ ខ្លួន ឲ្យបាន ល្អ . សន្សំ លុយ ឲ្យបាន ច្រើន ត្រលប់មក ស្រុក ខ្មែរ វិញ ចូលរួម អភិវឌ្ឍន៍ កសាង ខ្លួន រកស៊ី ដើម្បី ទៅ ថ្ងៃ ក្រោយ មាន បាន នឹង គេ ។
( ពោធិ៍សាត់ ) ៖ បុរស ជា ព្រូឡាន ម្នាក់ បាន ស្លាប់ ភ្លាម ៗ នៅ ហ្នឹង កន្លែង ខណៈ ជនរងគ្រោះ កំពុង ឈរងចាំ ជាង មក ជួសជុល រថយន្ត ស្រាប់តែ មាន រថយន្ត មួយ គ្រឿង ទៀត បុក បណ្តាលឱ្យ ស្លាប់ តែម្តង ។
ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ១១៖ ៤៥ នាទី យប់ ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០១៩ ម្សិលមិញ នៅលើ កំណាត់ ផ្លូវ ជាតិ លេខ ៥ ត្រង់ ចំណុច គីឡូម៉ែត្រ លេខ ១៩៩ និង ២០០ ស្ថិត ក្នុង ភូមិ ក្តី ឈ្នួល ឃុំ ត្រពាំង ជង ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ ។
ក្រោយពេល កើត ហេតុ អ្នកបើកបរ រត់គេចខ្លួន បាត់ ដោយ បន្សល់ទុក រថយន្ត និង សាកសព បុរស រងគ្រោះ នៅ ហ្នឹង កន្លែង ធ្វើឱ្យ មាន ការភ្ញាក់ផ្អើល ដល់ សមត្ថកិច្ច ចុះ ដល់ កន្លែង កើត ហេតុតែម្តង ។
សមត្ថកិច្ច មូលដ្ឋាន បាន ឱ្យដឹង ថា ជនរងគ្រោះ ត្រូវបាន គេ ស្គាល់ អត្តសញ្ញាណ ឈ្មោះ ថម ផល ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ រស់ នៅ ភូមិ ឃុំ កើត ហេតុ ចំពោះ អ្នកបើកបរ រថយន្ត គ្មាន អ្នកណា ម្នាក់ បាន ស្គាល់ អំពី អត្តសញ្ញាណ របស់ គេ នោះ ឡើយ រីឯ រថយន្ត ទាំង២ គ្រឿង សមត្ថកិច្ច យកមក រក្សាទុក នៅ ការិយាល័យ នគរបាល ចរាចរណ៍ ខេត្ត ពោធិ៍សាត់ ដើម្បី ចាត់ការ តាម នីតិវិធី ៕
អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល៖ ករណី ក្តៅ ខ្លួន ២ ថ្ងៃ ដាក់ ថ្នាំ មិន បាត់ សូម ទៅ ពិគ្រោះ ជាមួយ ពេទ្យ ជំនាញ ជាបន្ទាន់ កុំ សាកល្បង ផ្សំ ថ្នាំ លេប ដោយ ខ្លួន ឯង
( ភ្នំពេញ ) ៖ លោក វេជ្ជបណ្ឌិត លី សុវណ្ណ អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល និង ជា ប្រធាន នាយកដ្ឋាន ប្រយុទ្ធ នឹង ជំងឺ ឆ្លង បាន ថ្លែង ថា ដោយសារតែ បច្ចុប្បន្ន នេះ ជំងឺ គ្រុន ឈាន កំពុងតែ មាន ការផ្ទុះឡើង គួរឱ្យ បារម្ភ ដូចនេះ ហើយ នៅ ពេល ដែល មាន អាការៈ គ្រុន ក្តៅ ចំនួន ២ ថ្ងៃ ដាក់ ថ្នាំ មិន បាត់ ហើយ សង្ស័យ ខ្លួន ឯង ថា មាន ជំងឺ គ្រុន ឈាម ត្រូវ ប្រញាប់ ទៅ ពិគ្រោះ ជាមួយ គ្រូពេទ្យ ជំនាញ ជាបន្ទាន់ ដោយ មិន ត្រូវ សាកល្បង ផ្សំ ថ្នាំ លេប ដោយ ខ្លួន ឯង នោះ ទេ ។
ជាក់ស្តែង ក្រសួង សុខាភិបាល ក៏ បាន ណែនាំ ផងដែរ ចំពោះ កន្លែង លក់ ថ្នាំ ទាំងអស់ ដោយ មិន ត្រូវ លក់ ថ្នាំ ដោយ គ្មាន វេជ្ជបញ្ជា ពី គ្រូពេទ្យ នោះ ទេ ដោយ អាច ត្រឹម ថ្នាំ បញ្ចុះ កម្តៅ ធម្មតា និង វីតាមីន តែ ប៉ុណ្ណោះ ដូចនេះ ហើយ ក្នុង ករណី មាន ការសង្ស័យ ត្រូវតែ ទៅ រក កាពិគ្រោះ ជាមួយ គ្រូពេទ្យ ជំនាញ ដើម្បី ធានា បាន សុវត្ថិភាព ខ្ពស់ ។
លោក ក៏ ស្នើសុំ ឱ្យ កាដ្ឋាន សំណង់ ទាំងអស់ ទាំង នៅក្នុង រាជធានី ភ្នំពេញ និង នៅ តាម បណ្តា ខេត្ត ត្រូវ ចូលរួម ទប់ស្កាត់ នូវ ជំងឺ គ្រុម ឈាន នេះ ទាំងអស់ គ្នា ដោយ ចូលរួម ធ្វើ ការសំអាត នូវ សំភារៈ សំណង់ របស់ ខ្លួន ដោយ ធ្វើ ការរៀបចំ ទុក ឱ្យ បាន ល្អ កុំ ឱ្យ មាន ការ ដក់ ទឹក ដែល ជា ជម្រក របស់ សត្វ មូស ។
លោក វេជ្ជបណ្ឌិត លាង វិទ្ធា បាន បន្ថែម ថា ដើម្បី បង្ការ ខ្លួន ពី ជំងឺ គ្រុន ឈាម ជានិច្ច ជាកាល ត្រូវ ដេក ក្នុង មុង ឬ មុង ជ្រលក់ ថ្នាំ ពិសេស ពេល ដេក នៅពេល ថ្ងៃ . ផ្ទះ ត្រូវ បើក ទ្វារ បង្អួច ឲ្យ មាន ពន្លឺ ថ្ងៃ ចេញ ចូល និង ខោអាវ ត្រូវ បត់ទុកដាក់ ឲ្យបាន ត្រឹមត្រូវ . កាប់ ឆ្ការ ព្រៃ ស៊ុប ទ្រប នៅ ជុំវិញ ផ្ទះ ឲ្យ អស់ . ត្រូវ ស្លៀកពាក់ ខោអាវ ឲ្យបាន ជិត ល្អ ហើយ ឲ្យ កុមារ លេង នៅ កន្លែងណា ដែល មាន ពន្លឺ ថ្ងៃ ចេញ ចូល ជានិច្ច កុំ ឲ្យ កុមារ លេង កន្លែងងង និង ដេក ក្នុង មុង នៅ ពេល ថ្ងៃ ។
ចំណែកឯ មនុស្ស ជាច្រើន នាក់ ផ្សេង ទៀត ត្រូវបាន គេ ព្រួយបារម្ភ ថា នៅតែ កំពុង ជាប់ ខ្លួន នៅ ខាងក្រោម គំនរ អគារ ដដែល ស្រប ពេល ដែល ម៉ាស៊ីន និង ឧបករណ៍ ជួយសង្គ្រោះ ធំ ៗ មិន ទាន់ អាច យក ទៅដល់ កន្លែង កើត ហេតុ បាន នៅឡើយ ទេ ដោយសារ តែ ផ្លូវ ទៅកាន់ ទីនោះ មាន លក្ខណៈ តូច ចង្អៀត ពេក ។ ហេតុ នេះ ហើយ ចំនួន អ្នកស្លាប់ ទំនងជា នឹង កើនឡើង បន្ថែម ទៀត ។
គួរ ជម្រាប ថា មាន កងកម្លាំង ជួយ សង្រ្គោះ ចំនួន បី ក្រុម ដែល មកពី ទីភ្នាក់ងារ ឆ្លើយតប គ្រោះមហន្តរាយ ជាតិ ឥណ្ឌា បាន ចូលរួម ក្នុង ប្រតិបត្តិការ ជួយ សង្រ្គោះ នេះ ។ ដើម្បី ធានា សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ អាជ្ញាធរ ប្រចាំ តំបន់ កើត ហេតុ ក៏ បាន បង្គាប់ ឲ្យ អ្នក ដែល រស់ នៅ ក្បែរ អគារ ដែល ដួលរលំ នោះ ជម្លៀស ខ្លួន ចេញ មួយ រយៈពេល សិន ផងដែរ ។
រដ្ឋបាល ខណ្ឌ សែនសុខ សម្រុក ស្តារ លូប្រឡាយ ដើម្បី បញ្ជៀស ទឹក ដក់ ឬ លិច នៅក្នុង មូលដ្ឋាន នា រដូវ ភ្លៀង
( ភ្នំពេញ ) ៖ លោក ម៉ូវ ម៉ានិត អភិបាល ខណ្ឌ សែនសុខ នៅ ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ ក្រុមការងារ យក គ្រឿងចក្រ ចុះ ស្តារ ភក់ ល្បាប់ សំរាម កាកសំណល់ រឹង ចេញ ពី ក្នុង ប្រឡាយ ដើម្បី បង្ហូរ ទឹក លូស ម្អុយ ចេញ ឱ្យ បាន លឿន ជាពិសេស ពេល មាន ភ្លៀង ធ្លាក់ មក ម្តង ៗ ។
សូម បញ្ជាក់ ថា ការនាំយក គ្រឿងចក្រ ចុះ កាយ ស្តារ ប្រព័ន្ធ ប្រឡាយ លូមេ នេះ ស្ថិត នៅក្នុង វិទ្យាស្ថាន បណ្តុះបណ្តាល បច្ចេកទេស NTTI ។ ក្នុង គោលបំណង ដើម្បី ជួយ រំដោះ ទឹក ចេញ ពី ក្នុង ភូមិ ដែល ជា កន្លងកកកស្ទះ នាំឱ្យ មាន ការលិចលង់ នៅ ពេល មា នៅពេល មាន ភ្លៀង មក ម្តង ៗ ។ ជាពិសេស នៅក្នុង ភូមិសាស្ត្រ ភូមិ ចុង ថ្នល់ ខាងលិច សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ដើម្បី រំដោះ នាំ ទឹក ចឹញ ពី តំបន់ នោះ ទៅ ស្ថានីយ៍ បូម ទឹក បុរី ១០០ ខ្នង ។
លោក ម៉ូវ ម៉ានិត បាន បញ្ជាក់ ថា ការងារ ស្តារ ប្រឡាយ លូ នេះ នឹង ត្រូវ ធ្វើឡើង ជាប្រចាំ ដោយ មិន កំណត់ ថ្ងៃ នោះ ទេ ៕ សម្តេច ក្រឡាហោម ស ខេង ដាក់ បទបញ្ជា ឱ្យ យកចិត្តទុកដាក់ ប្រយុទ្ធ ប្រឆាំង សកម្មភាព លាង លុយ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ដាក់ បទបញ្ជា ឲ្យ សមត្ថកិច្ច យកចិត្តទុកដាក់ ប្រយុទ្ធ ប្រឆាំង នឹង សកម្មភាព លាង លុយ និង ការសម្អាត ប្រាក់ តាម ច្រក ទ្វារ អន្តរជាតិ ចេញ ចូល ទូទាំង ប្រទេស ។
ការដាក់ បទបញ្ជា របស់ សម្តេច ក្រឡាហោម ស ខេង បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ លទ្ធផល ការងារ ដកហូត ឯកសារ រដ្ឋបាល កម្ពុជា មិន ប្រក្រតី ដែល ជន បរទេស កាន់កាប់ ប្រើប្រាស់ និង ការទទួល ពាក្យ សុំ ប្រកាស ទទួលស្គាល់ ជា ជន បរទេស អន្តោប្រវេសន្ត និង ប័ណ្ណ ស្នាក់ នៅ អចិន្ត្រៃយ៍ នៅ ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
សម្តេច ក្រឡាហោម បាន សង្កត់ធ្ងន់ ថា « អ៊ីចឹង ហើយ យើង ត្រូវ យល់ បញ្ហា នេះ ឱ្យ បាន ស៊ីជម្រៅ ទាំងអស់ គ្នា ហើយ យកចិត្តទុកដាក់ អនុវត្តន៍ ឱ្យ បាន ។ មិន ត្រូវ ស៊ុគ្រលុំ វា បាន ផលប្រយោជន៍ ទៅ បុគ្គល បុគ្គល នេះ បុគ្គល នោះ អ៊ីចឹង មែន ប៉ុន្តែ យើង ត្រូវ គិត ដល់ ផលប្រយោជន៍ ជាតិ ជា ធំ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ជា ធំ ។ អ៊ីចឹង ហើយ ត្រូវ ប្តេជ្ញា ធ្វើ បញ្ហា នេះ ឱ្យ បាន » ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ សម្តេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ ថា គិត រហូតដល់ ពេលនេះ លុយ ខុស ច្បាប់ នាំចូល មក ប្រទេស កម្ពុជា ដែល សមត្ថកិច្ច ឃាត់ បាន នៅ តាម ច្រក អន្តរជាតិ មាន ចំនួន ៧.៤លាន ដុល្លារ អាមេរិក ហើយ ។ លុយ ខុស ច្បាប់ ទាំងនោះ ត្រូវបាន តម្កល់ នៅ ធនាគារ ជាតិ ដើម្បី ស្រាវជ្រាវ រក ប្រភព ដើម ចំណែកឯ ជន ដែល នាំ លុយ ខុស ច្បាប់ នេះ ចូលមក ក៏ ត្រូវបាន ឃុំ ខ្លួន ផងដែរ ។
សម្តេច ក្រឡាហោម ស ខេង បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « មកដល់ ពេលនេះ វា មាន ទាំងអស់ ៧.៤លាន ដុល្លារ ប៉ុន្តែ លុយ ទាំងអស់ នេះ គឺ យើង ឃាត់ទុក ជា បណ្តោះអាសន្ន ដើម្បី ស្រាវជ្រាវ តើ លុយ នោះ មាន ប្រភព ត្រឹមត្រូវ ឬ មិន ត្រឹមត្រូវ » ។
លុយ ដុល្លារ ដែល មិន មាន ប្រភព ច្បាស់លាស់ ត្រូវបាន សមត្ថកិច្ច កម្ពុជា រឹបអូស បានជា បន្តបន្ទាប់ នៅ រយៈពេល ប៉ុន្មាន ខែ ចុងក្រោយ នេះ ។ ភាគ ច្រើន នៃ លុយ គ្មាន ប្រភព ច្បាស់លាស់ ដែល ត្រូវ ចាប់ បាន នេះ នាំចូល ដោយ ជនជាតិ ចិន មកពី ហុងកុង ៕
ការបញ្ជា យ៉ាង ដូច្នេះ របស់ សម្តេច ក្រឡាហោម ស ខេង ធ្វើឡើង ក្នុង ឱកាស សម្តេច អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ លទ្ធផល ការងារ ដកហូត ឯកសារ រដ្ឋបាល កម្ពុជា មិន ប្រក្រតី ដែល ជន បរទេស កាន់កាប់ ប្រើប្រាស់ និង ការទទួល ពាក្យ សុំ ប្រកាស ទទួលស្គាល់ ជា ជន បរទេស អន្តោប្រវេសន្ត និង ប័ណ្ណ ស្នាក់ នៅ អចិន្ត្រៃយ៍ នៅ ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
សម្តេច ក្រឡាហោម បាន ថ្លែង ផងដែរ ថា តាមរយៈ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ដែល បាន អនុវត្តន៍ រយៈពេល ជិត ២ឆ្នាំ នេះ ទទួលបាន លទ្ធផល ល្អ ហើយ ទទួលបាន ការសាទរ និង សប្បាយរីករាយ ពី ប្រជាពលរដ្ឋ ដូច្នេះ សមត្ថកិច្ច មិន ត្រូវ បន្ធូរ ដៃ នោះ ទេ ។
តាម ការបញ្ជាក់ របស់ អង្គការ មូលនិធិ សកល សម្រាប់ អភិរក្ស ធនធាន ធម្មជាតិ (WWF) ដែល ជា អង្គការ ជួយ លើ គម្រោង អភិរក្ស ផ្សោត ទន្លេ មេគង្គ បាន ឲ្យដឹង ថា រយៈពេល ថ្មី ៗ នេះ មាន កូន ផ្សោត មួយ ក្បាល ទើបនឹង កើត ត្រូវបាន ក្រុមការងារ ស្រាវជ្រាវ របស់ អង្គការ WWF- កម្ពុជា ប្រទះឃើញ នៅ អន្លង់ ផ្សោត កាំ ពី ស្ថិត ក្នុង ភូមិ កាំ ពី ឃុំ សំបុក ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
លោក ប្រធាន រូប នោះ បាន ឲ្យដឹង បន្ត ទៀត ថា កូន ផ្សោត ដែល បាន ប្រទះឃើញ ថ្មី នេះ គឺជា កូន ផ្សោត លើក ទី៦ ហើយ ដែល ត្រូវបាន កត់ត្រា ថា បាន កើត នៅក្នុង ឆ្នាំ ២០១៩ ។
លោក បាន បញ្ជាក់ បន្ថែម ទៀត ថា សត្វ ផ្សោត ធំ មាន តែ ជាង ៧០ ក្បាល ទេ ក្នុង ឆ្នាំ ២០១៧ តែ រហូតដល់ ឆ្នាំ ២០១៩ នេះ សត្វ ផ្សោត មាន ដល់ ជាង ៩០ ក្បាល ហើយ កូន ដែល មាន អាយុ ក្រោម ៥ ឆ្នាំ មាន ចំនួន ជាង ៣០ ក្បាល ដែល ខាង មន្ត្រី ជំនាញ អង្គការ WWF មិន រាប់ បញ្ជូល ក្នុង សត្វ ផ្សោត ធំ ជាក់ស្ដែង ថ្មី ៗ នេះ កូន ផ្សោត ទើបនឹង កើត ជា លទ្ធផល ថ្មី មួយ ទៀត ក្នុង ឆ្នាំ ២០១៩ នេះ បញ្ជាក់ អំពី កិច្ច ខិតខំប្រឹង ប្រែង រួមគ្នា ក្នុង ការអភិរក្ស សត្វ ផ្សោត ទន្លេ មេគង្គ ក្នុង ប្រទេស កម្ពុជា ។
លទ្ធផល នេះ ជា ការឆ្លុះបញ្ចាំង ពី កិច្ច សហការ ដ៏ ល្អ ប្រសើរ ក្នុង ការងារ អភិរក្ស រវាង អង្គការ WWF- កម្ពុជា និង ដៃគូ អភិរក្ស នានា ដូចជា អាជ្ញាធរ មូលដ្ឋាន ម្ចាស់ មូលនិធិ អង្គការ ដៃគូ ប្រជា សហគមន៍ សាធារណជន ទូទៅ និង ជាពិសេស រដ្ឋបាល ជលផល នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ក្រសួង បរិស្ថាន ក្រសួង ទេសចរណ៍ និង អាជ្ញាធរ ថ្នាក់ ខេត្ត ក្រចេះ ៕
សម្តេច ក្រឡាហោម ស ខេង៖ អ្នក ជ្រៀត ចូល ខុស ច្បាប់ នៅ តាម ព្រំដែន ត្រូវតែ បណ្តេញ ចេញ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន ក្រើន រំលឹក ដល់ កម្លាំង នគរបាល យកចិត្តទុកដាក់ គ្រប់គ្រង ជន បរទេស ឱ្យ បាន ម៉ត់ចត់ និង ទទួលខុសត្រូវ ខ្ពស់ ។ សម្តេច ក្រឡាហោម បាន សង្កត់ធ្ងន់ ថា ត្រូវ មាន វិធានការចាប់ បណ្តេញ ចេញ ពី កម្ពុជា ជាបន្ទាន់ ចំពោះ ជន បរទេស ជ្រៀត ចូលមក កម្ពុជា ដោយ ខុស ច្បាប់ ។
