( ភ្នំពេញ ) ៖ ដោយសារ ខ្លាច សំណង់ អគារ បាក់ ស្រុត ដូច ករណី បាក់ ស្រុត អគារ នៅ ខេត្ត ព្រះសីហនុ អាជ្ញាធរ ខណ្ឌ បឹងកេងកង នៅ ថ្ងៃទី ២៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បាន ចុះ ពិនិត្យ ការដ្ឋាន សាងសង់ អគារ មួយ កន្លែង នៅ សង្កាត់ ទួល ស្វាយ ព្រៃទី១ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ ព្រោះ សង្ស័យ ថា អគារ មួយ នេះ សាង់ គ្មាន ច្បាប់ ទម្លាប់ ។
មន្ត្រី សាលា ខណ្ឌ បឹងកេងកង បាន ឲ្យដឹង ថា ការចុះ ពិនិត្យ អគារ ខុស ប្រក្រតី មួយ នេះ បាន ធ្វើឡើង ក្រោម ការបញ្ជា ពី លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ។ បទបញ្ជា នេះ ក៏ ស្រប នឹង ការ ប្រកាស បញ្ជា ឲ្យ អភិបាល ខណ្ឌ ទាំង ១៤ ត្រូវ ត្រួតពិនិត្យមើល រាល់ អគារ ដែល សាងសង់ ឡើង នៅក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ។
អភិបាល រាជធានី ភ្នំពេញ បាន ព្រមាន ថា អភិបាល ខណ្ឌ រូប ណា ដែល បណ្តាលឲ្យ មាន អគារ ខុស លក្ខណៈ បច្ចេកទេស សាងសង់ ឡើង ក្នុង ដែន សមត្ថកិច្ច ខ្លួន នឹង ត្រូវ ទទួលរង វិន័យ រដ្ឋបាល និង ទទួលខុស្រូវ ចំពោះ មុខ ច្បាប់ ។
មន្ត្រី សាលា ខណ្ឌ បាន ឲ្យដឹង ទៀត ថា អាជ្ញាធរ ចង់ឲ្យ វិស្វករ នៃ ការសាងសង់ អគារ នៅ សង្កាត់ ទួល ស្វាយ ព្រៃ១ នៅ ខណ្ឌ បឹងកេងកង នេះ ត្រូវ បង្ហាញ ឲ្យ លម្អិត ថា អគារ ធ្វើ ពី ដែក នេះ មាន ទម្រ បាន ត្រឹមត្រូវ ដែល អាច ផ្ទុក អ្នក ចូល ទស្សនា ឬ ភ្ញៀវ ចូល អគារ នេះ បាន ដែរ ទេ ? មន្ត្រី បាន ឲ្យ ធ្វើ កោសល្យវិច្ច័យ ថា តើ សំណង់ នេះ អាច ដាក់ បាន ចំនួន កម្រិត ណា ចេញ ដោយ វិស្វករ ណា ឬ ចេញ ដោយ វិស្វករ ឯករាជ្យ មួយ ណា ដែល ឲ្យ អាជ្ញាធរ ទទួលស្គាល់ បាន ។
លោក បញ្ជាក់ ថា « សំណង់ នេះ វា ដូចគ្នា នឹង សំណង់ នៅ កំពង់សោម ដែរ ដែល ធ្វើ អំពី ដែក ។ ក្នុង នាម ខ្ញុំ ជា អាជ្ញាធរ ខ្ញុំ សុំឲ្យ មាន ធ្វើ គម្រោង ឡើង ឲ្យបាន ច្បាស់លាស់ មាន ច្បាប់ បង្ហាញ មក ។ ឥឡូវនេះ ខ្ញុំ ឃាត់ សិន ហើយ » ។ ជា លទ្ធផល មន្រ្តី អាជ្ញាធរ បាន សម្រេច ផ្អាក មិន ឲ្យ ដំណើរការ សាងសង់ ទៀត នោះ ឡើយ ដោយ រង់ចាំ ការពិនិត្យមើល គ្រប់ លក្ខណៈ សិន ។
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ឫស្សីកែវ បាន ប្រកាស សូម ការអធ្យាស្រ័យ ពី សាធារណៈ មតិ ពិសេស សូម ការអភ័យទោស ពី ថ្នាក់ដឹកនាំ គ្រប់ ជាន់ ថ្នាក់ ចំពោះ កាយវិការ មិន សមរម្យ ក្នុង អង្គ ពិធី កាលពី ម្សិលមិញ ដោយ អចេតនា ដែល បណ្ដាល មកពី បញ្ហា សុខភាព ផ្ទាល់ខ្លួន របស់ លោក ។
ការចេញមក សូម អភ័យទោស របស់ លោក ជា ពិសី ខា លើ នេះ បាន ធ្វើឡើង បន្ទាប់ពី មាន ការថត បង្ហោះ សរសេរ សារ និង ភ្ជាប់ ជាមួយ នូវ រូបភាព របស់ លោក ត ៗ គ្នា នៅលើ បណ្ដាញ សង្គម Facebook ថា បាន សម្រាន្ត លក់ ស្រួល អាច ប្រហែល ហត់ ខ្លាំង លើ ការងារ តាម មូលដ្ឋាន នៅក្នុង ពិធី ទិវា អន្តរជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿង នា ព្រឹក ថ្ងៃទី ២៦ ខែមិថុនា ឆ្នាំ ២០១៩ នៅ សាល មហោស្រព កោះ ពេជ្រ ក្រោម អធិបតីភាព សម្ដេច ក្រឡាហោម ស ខេង ។
ឆ្លើយតប នឹង ករណី ដោយ អចេតនា នេះ លោក ជា ពិសី អភិបាល ខណ្ឌ ឫស្សីកែវ និង ជា សមាជិក ក្រុម លេខា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ២៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ បាន សូម ការអធ្យាស្រ័យ ដែល មាន ខ្លឹមសារ ទាំងស្រុង យ៉ាង ដូច្នេះ ថា៖
ខ្ញុំបាទ សូម ឆ្លើយតប និង បកស្រាយ ជូន សាធារណៈ មតិ មេត្តា ជ្រាប ថា ប៉ុន្មាន ថ្ងៃ មក នេះ ម្ដាយ ជរា របស់ ខ្ញុំ អាយុ ៨០ ឆ្នាំ កំពុង មាន ជម្ងឺ ជា ទម្ងន់ និង កំពុង សម្រាក ព្យាបាល នៅឯ មន្ទីរពេទ្យ ។ កាតព្វកិច្ច ដ៏ ធំ បំផុត របស់ ខ្ញុំ ក្នុង នាម ជា កូន កត្តញ្ញូ មួយ រូប ខ្ញុំ តែងតែ ទៅ មើល ថែរ ទាំ ម្ដាយ របស់ ខ្ញុំ ស្ទើរតែ រៀងរាល់ យប់ ក្រោយ បាន សម្រាក ពី ការដឹកនាំ ការងារ រដ្ឋបាល រួច មក ។
គាប់ ជួន នៅ យប់ ថ្ងៃទី ២៥ ខែមិថុនា កន្លងមក នេះ ខ្ញុំបាទ បាន ទៅ មើល ថែ ម្ដាយ ចាស ជរា ឈឺ ធ្ងន់ រហូតដល់ ម៉ោង ជាង ២យប់ រំលោង អាធ្រាត្រ ថ្ងៃទី ២៦ ខែមិថុនា ទើបនឹង បាន សម្រាក ប៉ុន្មាន ម៉ោង ប៉ុណ្ណោះ នៅក្នុង ថ្ងៃ ដដែល នោះ វេលា ម៉ោង ៥ព្រឹក ខ្ញុំបាទ ត្រូវ ក្រោក ពី ព្រឹក ព្រលឹម ដើម្បី ទៅ ដឹកនាំ កម្លាំង មហាជន ចូលរួម កម្មវិធី នៅឯ កោះ ពេជ្រ ទៀត ។
ខ្ញុំបាទ សូម ការអធ្យាស្រ័យ ពី សាធារណមតិ ទូទាំង ប្រទេស ពិសេស ខ្ញុំបាទ សូម ការអភ័យទោស ដ៏ ខ្ពង់ខ្ពស់ ពី ថ្នាក់ដឹកនាំ គ្រប់ ជាន់ ថ្នាក់ ចំពោះ កាយវិការ មិន សមរម្យ ក្នុង អង្គ ពិធី កាលពី ម្សិលមិញ ដោយ អចេតនា នេះ ដោយសារតែ បញ្ហា សុខភាព ផ្ទាល់ខ្លួន របស់ ខ្ញុំបាទ ។ សូម អរគុណ សម្រាប់ ការដាស់តឿន ក្នុង ន័យ ស្ថាបនា ៕
គួរ បញ្ជាក់ ថា ប្រជាពលរដ្ឋ បាន ប្រទេះ ឃើញ សាកសព ឆេះ ក្នុង ភ្នក់ភ្លើង ជាមួយ ម៉ូត ១ គ្រឿង ឆេះ គ្មាន សល់ ក្នុង ចំការ កៅស៊ូ មួយ កន្លែង ស្ថិត នៅ ភូមិ ដូន ប៉ុក ឃុំ ស្រែ ចារ ស្រុក ស្នួល ខេត្ត ក្រចេះ កាលពី ថ្ងៃទី ២៦ ខែមិថុនា ឆ្នាំ ២០១៩ ។
នគរបាល ជំនាញ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ក្រចេះ បាន បញ្ជាក់ នៅ ថ្ងៃទី ២៧ ខែមិថុនា នេះ ថា សាកសព ដែល នៅក្នុង ភ្នក់ភ្លើង នោះ ត្រូវបាន គេ ស្គាល់ អត្តសញ្ញាណ ថា ឈ្មោះ ខុម សិទ្ធ ភេទ ប្រុស អាយុ ២៣ ឆ្នាំ រស់ នៅ ភូមិ ឃុំ កើត ហេតុ ខាង លើ ។ សាកសព ឈ្មោះ ឃុំ សិទ្ធ នេះ កាល នៅរស់ ជា មនុស្ស ប្រើប្រាស់ គ្រឿងញៀន ។
លុះ ដល់ ម៉ោង ១២កម្មករ ចៀរ ជ័រ បាន ប្រទះឃើញ សាកសព មិន ស្គាល់ អត្តសញ្ញាណ បាន ឆេះ ស្លាប់ ក្បែម៉ូតូ១ គ្រឿង ( ឆេះ ខ្លោច មើល មិន ស្គាល់ ) រួច ក៏ បាន រាយការណ៍ ជូន សមត្ថកិច្ច ភ្លាម ៗ បន្ទាប់ពី ទទួល ដំណឹង សមត្ថកិច្ច បាន ចុះ ទៅ កន្លែង កើត ហេតុ រួច ហ៊ុមព័ទ្ធ កន្លែង កើត ហេតុ ដើម្បី ស្រាវជ្រាវ រក សញ្ជាតិ និង អត្តសញ្ញាណ សាកសព ។ ក្រោយមក ទើប សមត្ថកិច្ច បាន ដឹង ថា សាកសព ឆេះ ស្លាប់ នោះ ឈ្មោះ ខុម សិទ្ធ ភេទ ប្រុស អាយុ ២៣ ឆ្នាំ រស់ នៅ ភូមិ ឃុំ កើត ហេតុ ខាង លើ ។
នគរបាល ជំនាញ បញ្ជាក់ ទៀត ថា តាម ការពិនិត្យ នៅ កន្លែង កើត ហេតុ នៅ បន្សល់ទុក ចំនួន ៣កំប៉ុង ប្រអប់ ស្នោ ចំនួន ១ ក្រៅពី នេះ គ្មាន អ្វី កត់សម្គាល់ ទេ ហើយ ក្រោយពី សមត្ថកិច្ច ជំនាញ ពិនិត្យ សាកសព រួច បាន ឲ្យដឹង ថា ករណី នេះ ជា ករណី ឃាតកម្ម គិត ទុក ជាមុន ។ ខណៈពេលនេះ សមត្ថកិច្ច កំពុងតែ ដុត ដៃ ដុត ជើង បើក ការស៊ើបអង្កេត លើ ករណី ខាងលើ នេះ ៕ Heli Lounge Bar កន្លែង ញ៉ាំ អាហារ បណ្តើរ មើល ព្រះអាទិត្យ រៀបអស្តង្គត បណ្តើរ នៅ ទីក្រុង គួឡាឡាំពួរ ប្រទេស ម៉ាឡេស៉ី
លោក បាន បន្ត ថា ជា ការពិត ណាស់ រាជ រដ្ឋាភិបាល បាន ធ្វើ ការ វិនិយោគ លើ វិស័យ ពិការ ភាពជាច្រើន ឆ្នាំ មកហើយ ។ បច្ចុប្បន្ន ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន កំពុង ស្តារ និង អភិវឌ្ឍ មាតុ ប្រទេស ពិសេស រក្សា បាន សុខ សន្តិភាព ស្ថេរភាព នយោបាយ និង តំបន់ សេដ្ឋកិច្ច ដែល ជា ឱកាស សម្រាប់ លើក កម្ពស់ ជន មាន ពិការភាព នៅ កម្ពុជា ការផ្តល់ នូវ ដី សម្បទា ន សេដ្ឋកិច្ច និង ការស្តារ លទ្ធភាព ពលកម្ម សម្បទា ជូន ជន មាន ពិការភាព ។
លោក បាន បន្ត ថា យុទ្ធនាការ នេះ ក៏ ធ្វើឡើង ក្នុង គោលដៅ ជំរុញ ឲ្យ ជន ពិការ បាន ចូលរួម យ៉ាង ពេញលេញ នៅក្នុង សកម្មភាព គ្រួសារ និង សង្គម ។ ព្រមទាំង ជម្រុញឲ្យ សហគមន៍ មើលឃើញ ពី សមត្ថភាព ជន មាន ពិការភាព ជាង ភាពពិការ របស់ ពួកគេ ។
លោក ទុំ ឈៀត បាន បន្ថែម ថា បើ ទោះជា មាន ការខិតខំ ប្រឹងប្រែង ពី អង្គការ សង្គម ស៊ីវិល និង រាជ រដ្ឋាភិបាល ក៏ដោយ ក៏ នៅតែ មាន ការរំលោភបំពាន សិទ្ធិ ការរើសអើង នៅ តំបន់ មួយចំនួន ។ នេះ បើ យោង តាម បទពិសោធន៍ និង ការសិក្សា របស់ អង្គការ ករុណា បាត់ដំបង នៅក្នង ការធ្វើការ ជាមួយ កុមារ ពិការ ខ្សោយ សតិ បញ្ញា អស់ រយៈពេល ជាង ១០ កន្លងមក នេះ ៕ អភិបាល ខេត្ត កំពង់ធំ ជំរុញ ឲ្យ មន្រ្តី និង សមត្ថកិច្ច លុបបំបាត់ ទាំងស្រុង នូវ បទល្មើស គ្រឿងញៀន នៅ តាម ក្លឹប កំសាន្ត ទូទាំង ខេត្ត
( កំពង ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន ជំរុញ ឱ្យ គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន ខេត្ត ត្រូវ យកចិត្តទុកដាក់ លុបបំបាត់ ឱ្យ បាន ទាំងស្រុង រាល់ បទល្មើស ជួញដូរ និង ការប្រើប្រាស់ គ្រឿងញៀន នៅ តាម ក្លឹប កំសាន្ត និង ទី សប្បាយដ្ឋាន នានា ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ។
ការលើកឡើង បែប នេះ របស់ លោក អភិបាល ខេត្ត កំពង់ធំ បាន ធ្វើឡើង នៅ ថ្ងៃទី ២៧ ខែមិថុនា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ចូលរួម ជា អធិបតីភាព ក្នុង ទិវា អន្ដរជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ក្រោម ប្រធានបទ « សុខភាព ដើម្បី យុត្ដិធម៌ យុត្ដិធម៌ ដើម្បី សុខភាព » នៅក្នុង វិទ្យាល័យ កំពង់ធំ ដោយ មាន អ្នកចូលរួម ប្រមាណ ជិត ៤០០០ នាក់ ។
បន្ថែម ពី នេះ លោក អភិបាល ខេត្ត បាន លើកឡើង ថា មន្ត្រី សមត្ថកិច្ច គ្រប់ ប្រភេទ និង គ្រប់ លំដាប់ថ្នាក់ ត្រូវ តែ ចៀសវាង ឱ្យ បាន ជាដាច់ខាត នូវ កុំ ៤ គឺ កុំ ពាក់ព័ន្ធ កុំ នៅ ពីក្រោយ ធ្វើជា បង្អែក កុំ បន្ធូរបន្ថយ និង កុំ អន្តរាគមន៍ ក្នុង ករណី បទល្មើស គ្រឿងញៀន ។
លោក បាន បន្ថែម ថា សម្រាប់ ខេត្ត ជាប់ ព្រំដែន បណ្តា បញ្ជាការដ្ឋាន កងកម្លាំង នគរបាល កងទ័ព និង សមត្ថកិច្ច ពាក់ព័ន្ធ ដែល កំពុង ឈរ ជើង នៅ តាម តំបន់ ព្រំដែន ទាំងអស់ ត្រូវ រៀបចំបញ្ចូល ជា សមាជិក នៃ គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន តាម ឋានុក្រម ក្នុង មូលដ្ឋាន ដើម្បី ទប់ស្កាត់ ការ ចរាចរ គ្រឿងញៀន ចូលមក ក្នុង ប្រទេស និង ចូលរួម អនុវត្ត ការរៀបចំ ភូមិ ឃុំ / សង្កាត់ ស គ្មាន គ្រឿងញៀន នៅ តាម គោលដៅ ឈរ ជើង របស់ ខ្លួន ដោយ សហការ ជាមួយ ខេត្ត ជាប់ ព្រំដែន ជិតខាង ឱ្យ មាន ប្រសិទ្ធភាព ។
លោក សុខ លូ ក៏ បាន អំពាវនាវ ដល់ វិស័យ ឯកជន អ្នក វិនិយោគ ឬ អាជីវករ ដែល មាន មុខរបរ ពាក់ព័ន្ធ និង ទីកន្លែង ដែល ងាយ នឹង ទទួលរង នូវ ការ ពាក់ព័ន្ធ នឹង បទល្មើស គ្រឿងញៀន ដាច់ខាត មិន ត្រូវ ពាក់ព័ន្ធ និង គ្រឿងញៀន មិន ត្រូវ យក អាជីវកម្ម ស្រប ច្បាប់ ឆ្លៀត ឱកាស រក ចំណេញ ពី ការប្រព្រឹត្ត បទល្មើស គ្រឿងញៀន ត្រូវតែ គោរព ច្បាប់ អាជីវកម្ម និង ច្បាប់ វិនិយោគ ហើយ ចូលរួម ទប់ស្កាត់ បទល្មើស គ្រឿងញៀន ដោយ ត្រូវ រាយការណ៍ ឬ សុំ កិច្ចអន្តនាគមន៍ ពី សមត្ថកិច្ច ពេល សង្ស័យ ថា មាន បទល្មើស មិន លាក់បាំង ។
លោក អភិបាល ខេត្ត បាន ស្នើ ឱ្យ អាជ្ញាធរ ពាក់ព័ន្ធ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ អនុវត្ត ច្បាប់ ឱ្យ បាន តឹងរឹង ជាពិសេស កុំ ឱ្យ អ្នក ដែល ជួញដូរ គ្រឿងញៀន ក្លាយទៅជា អ្នកប្រើប្រាស់ ប្រាស់ គ្រឿង ទៅ វិញ ។
