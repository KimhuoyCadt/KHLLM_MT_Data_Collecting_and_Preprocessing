( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល អន្ដោប្រវេសន៍ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ទទួល ជនជាតិ អូស្ត្រ លី ចំនួន ០៣ នាក់ ពី កម្លាំង នគរបាល រដ្ឋបាល ប៉ុស្តិ៍ ទន្លេ បាសាក់ ខណ្ឌ ចំការមន ក្រោយ ពួកគេ ត្រូវបាន ចាប់ខ្លួន ពី បទ ផឹក ស្រា ស្រវឹង ដោះ អាវ ធ្វើឲ្យ បាត់ សណ្ដាប់ធ្នាប់ កាលពី ល្ងាច ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ ។
សមត្ថកិច្ច បាន បន្ថែម ថា មុន ពួកគេ ចូលមក ប្រទេស កម្ពុជា ពួកគេ បាន ស្នាក់ នៅ ខេត្ត ភូកេត ប្រទេស ថៃ រយៈពេល ១ ខែ ហើយ មូលហេតុ ដែល រូប គេ ដោះ អាវ ដោយសារ ផឹក ស្រា ស្រវឹង ពុំ បាន ដឹង ថា ខុស ច្បាប់ នៅ ប្រទេស កម្ពុជា ។ បន្ទាប់ពី បញ្ចប់ ការសួរនាំ ពួកគេ បាន ធ្វើ កិច្ចសន្យា សុំទោស នៅមុខ សមត្ថកិច្ច មិន ធ្វើ ទង្វើ ដូចនេះ ទៀត ទេ និង គោរព ច្បាប់ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
ភេសជ្ជ ប៉ូវ កម្លាំង វើក លើកទឹកចិត្ត យុវជន យុវតី កម្ពុជា ចូលរួម ទិវា រត់ ប្រណាំង ម៉ារ៉ាតុង អន្តរជាតិ ចក្រភព ខ្មែរ លើក ទី៦ នៅ ខេត្ត សៀមរាប
( ភ្នំពេញ ) ៖ ភេសជ្ជ ប៉ូវ កម្លាំង វើក WURKZ ក្រៅពី ជួយ ឧបត្ថម ទាំង ថវិកា ដ៏ ច្រើន លើសលប់ ទាំង សម្ភារ និង ភេសជ្ជដល់ ទិវា រត់ ប្រណាំង ម៉ារ៉ាតុង អន្តរជាតិ ចក្រភព ខ្មែរ លើក ទី៦ ដើម្បីឲ្យ កម្មវិធី នេះ ដំណើរការ ទៅ បាន ក្រុមហ៊ុន ក៏ បាន លើកទឹកចិត្ត ដល់ ប្រជាជន កម្ពុជា ជាពិសេស យុវជន យុវតី និង អ្នក ចូលចិត្ត លេង កីឡា ដើម្បី សុខភាព និង រួមចំណែក កិច្ចការ សប្បុរសធម៌ ឲ្យ ចុះឈ្មោះ ចូលរួម រត់ ក្នុង ព្រឹត្តិការណ៍ ដ៏ ធំ និង មាន សារប្រយោជន៍ ដល់ សុខភាព នេះ ផងដែរ ។
លោកស្រី គង់ កុសល នាយិការ ទីផ្សារ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរិជិស បាន លើកឡើង ថា « ក្នុង នាម ជា អ្នកឧបត្ថម ធំ ដល់ ព្រឹត្តិការណ៍ ម៉ារ៉ាតុង នេះ យើង សូម គោរព អញ្ជើញ លោក លោកស្រី ទាំងអស់ គ្នា ចូលរួម រត់ ជាមួយ យើង ទាំងអស់ គ្នា ដើម្បី ជា ប្រយោជន៍ ដល់ ប្រជាជន កម្ពុជា និង កុមារ ក្រីក្រ ដែល កំពុង ស្រែក រក ជំនួយ ទាំង សម្ភារ និង ថវិកា ដើម្បី ទទួលបាន សេវា ព្យាបាល ពី មន្ទីពេទ្យ គោលដៅ និង ការអប់រំ មូលដ្ឋាន របស់ ពួកគេ » ។
អតីត ប្រធានាធិបតី អ៊ីរ៉ង់៖ « តាមពិត លោក ដូណាល់ ត្រាំ ចង់ ចរចា ជាមួយ អ៊ីរ៉ង់ ណាស់ » ប៉ុន្តែ អាមេរិក កំពុង ប្រើ វិធីសាស្ត្រ ខុស ...
គួរ បញ្ជាក់ ថា លោក អតីត ប្រធានាធិបតី អ៊ីរ៉ង់ រូប នេះ ក៏ បាន លើកឡើង ជា យោបល់ ផងដែរ ថា ទីក្រុង វ៉ាស៊ីនតោន គួរតែ ដក ទណ្ឌកម្ម ដែល ខ្លួន បាន ដាក់ មក លើ ទីក្រុង តេហេរ៉ង់ ក្រោយ ការដក ខ្លួន ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ វិញ ដើម្បីឲ្យ កិច្ចចរចា អាច កើតមាន ទៅ រួច ៕ កាន់តែ រំភើប កាន់តែ រីករាយ ទៀត ហើយ ជាមួយ កម្មវិធី ប្រូម៉ូសិន ពិសេស មហាសំណាង ម ហារង្វាន់ ពី ទូរទស្សន៍ សាម សុង ក្នុង សប្តាហ៍ ទី 4 នេះ !
ពិតជា កក្រើក និង គួរឱ្យ ភ្ញាក់ផ្អើល ខ្លាំង ណាស់ ក្នុង រយៈពេល ៣ សប្តាហ៍ កន្លងមក នេះ ! គិត មកទល់ ពេលនេះ គឺជា សប្តាហ៍ ទី 4 ហើយ ដែល កម្មវិធី ប្រូម៉ូសិន ពិសេស “ មហាសំណាង ម ហារង្វាន់ ” ពី ទូរទស្សន៍ សាម សុង បាន រកឃើញ អតិថិជន ដែល មាន សំណាង ឈ្នះ រង្វាន់ ធំ អស្ចារ្យ ពី ការជាវ ទូរទស្សន៍ សាម សុង គ្រប់ ម៉ូឌែល !
អ្វី ដែល គួរឱ្យ ភ្ញាក់ផ្អើល បំផុត នោះ ចំនួន អតិថិជន ដែល បាន ជាវ ទូរទស្សន៍ សាម សុង គ្រប់ ម៉ូឌែល ទាំងអស់ មាន ការកើនឡើង គួរឱ្យ កត់សម្គាល់ ចាប់ពី មួយ សប្តាហ៍ ទៅ មួយ សប្តាហ៍ !
សម្រាប់ សប្តាហ៍ ទី៤ នៃ ការចាប់ ដ៏ រំជួល ចិត្ត នេះ ក៏ បាន រកឃើញ អ្នក ឈ្នះ ចំនួន ១២រូប បន្ថែម ទៀត ផងដែរ ។
ខាងក្រោម នេះ គឺជា តារាង ឈ្មោះ អតិថិជន ទាំងអស់ ដែល បាន ឈ្នះ នូវ ម ហារង្វាន់ អស្ចារ្យ ក្នុង កម្មវិធី ប្រូម៉ូសិន ពិសេស ប្រចាំ ឆ្នាំ ពី ការជាវ ទូរទស្សន៍ សាម សុង ៖
ដូច្នេះ អតិថិជន ដែល បាន ជាវ ទូរទស្សន៍ សាម សុង ទាំងអស់ កុំ ភ្លេច សួរ រក ប័ណ្ណ ធានា ពី ហាង ដែល បាន ទិញ ដើម្បី មាន ឱកាស ឈ្នះ រង្វាន់ ដ៏ អស្ចារ្យ ពី ក្រុមហ៊ុន សាម សុង !
សម្រាប់ អតិថិជន ដែល ពុំ ទាន់ បាន ឈ្នះ នៅឡើយ សូម រង់ចាំ តាមដាន ការចាប់ រង្វាន់ នៅ សប្តាហ៍ បន្ត ទៀត ព្រោះ រង្វាន់ ធំ ៗ អស្ចារ្យ ជាច្រើន ទៀត កំពុង រង់ចាំ អតិថិជន ទាំងអស់ គ្នា !
ផ្ទៃដី ស្រូវ វស្សា ដើម រដូវ ជាង ជាង ៤ម៉ឺន ហិកតា នៅ ខេត្ត ពោធិ៍សាត់ និង បាត់ដំបង កំពុង ប្រឈម បញ្ហា ខ្វះ ទឹក . រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម ចុះ ពិនិត្យ ស្ថានភាព ជាក់ស្តែង នៃ គ្រោះ រាំងស្ងួត
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ចុះ ពិនិត្យមើល ស្ថានភាព គ្រោះ រាំងស្ងួត នៅ ឃុំ តា លោក ស្រុក តា លោ សែន ជ័យ និង ឃុំ រំលេច ស្រុក បាកាន ។
បន្ទាប់ពី បាន ចុះ ពិនិត្យ ស្ថានភាព ជាក់ស្តែង នៃ គ្រោះ រាំងស្ងួត នៅ ភូមិ បូរ ច្រេស ឃុំ តា លោក ស្រុក តា លោ សែន ជ័យ លោក រដ្ឋមន្ត្រី វេង សាខុន មាន ក្តីសង្ឃឹម ថា រាជ រដ្ឋាភិបាល នឹង មាន ផែនការ ធ្វើ ការពង្រីក ការស្រោចស្រព មកកាន់ តំបន់ នេះ ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ខាងមុខ នេះ ។
លោក រដ្ឋមន្ត្រី បាន ជួយ ដោះស្រាយ បញ្ហា ចំពោះ មុខ បន្ទាន់ ដោយ លោក បាន ជួយ ឧបត្ថម្ភ ប្រេង ចំនួន ៤០០លីត្រ សម្រាប់ ធ្វើ ការបូម បាច ទឹក តាម លទ្ធភាព ជួយសង្គ្រោះ សន្ទូង ។
លោក រដ្ឋមន្ត្រី បាន ណែនាំឲ្យ អគ្គ នាយកដ្ឋាន កសិកម្ម សហការ ជាមួយ មន្ទីរ ចុះ តាមដាន ស្ថានភាព ជាប់ ជាប្រចាំ ហើយក៏ គួរ សិក្សា ពី លទ្ធភាព ប្តូរ មុខ ដំណាំ ខ្លះ ដែល ប្រើប្រាស់ ទឹក តិច ហើយ កសិករ ក៏ គួរ ត្រៀម ពូជ ទុក សាប ព្រួស ឡើងវិញ បន្ទាប់ពី មាន ទឹក គ្រប់គ្រាន់ ដើម្បី ធានា សន្តិសុខ ស្បៀង នៅ ឆ្នាំ ខាងមុខ ។
បន្ទាប់មក នៅ ថ្ងៃ ដដែល នោះ លោក រដ្ឋមន្ត្រី វេង សាខុន និង សហការី បាន បន្ត ដំណើរ មក ខេត្ត បាត់ដំបង ដើម្បី ចុះ ពិនិត្យ មើល ស្ថានភាព គ្រោះ រាំងស្ងួត នៅ ភូមិ ទួល ព្រំ ឃុំ ក កោះ ស្រុក មោង ឫស្សី ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី បាន ចេញ ផ្សព្វផ្សាយ នូវ វិដេអូ ដ៏ សំខាន់ មួយ ក្រោម ចំណងជើង « ជនជាតិ វៀតណាម ដេហ្កា ដែល សម រង្ស៊ី ចុះហត្ថលេខា សន្យា កាត់ ទឹកដី ៤ ខេត្ត នៃ ភាគ ឥសាន្ត ប្រទេស កម្ពុជា ឱ្យ នោះ ក៏ បាន ចូលរួម ធ្វើ បាតុកម្ម នៅលើ ទឹកដី អាមេរិក ដែរ » ។ វិដេអូ នេះ មាន រយៈពេល ៩នាទី និង ១៣វិនាទី ។
សូម ទស្សនា វិដេអូ ទាំងស្រុង ដូចត ទៅ៖
( កោះកុង ) ៖ លោក ឈឹម ចិន អភិបាល ស្តី ទីក្រុង ខេមរភូមិន្ទ ខេត្ត កោះកុង និង លោក នាម យ៉ុង ចៅសង្កាត់ ស្មាច់ មាន ជ័យ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ បាន ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ សហការ ជាមួយ ក្រុមហ៊ុន ដឹក សំរាម បន្ត ចុះ ពិនិត្យ នៅ ស្ថានភាព ដែល មាន ភ្លៀង ធ្លាក់ រយៈ ប៉ុន្មាន ថ្ងៃ ដោយសារ ទទួលរង នៅ ឥទ្ធិពល សម្ពាធ ទាប ធ្វើឲ្យ លិច លំនៅដ្ឋាន ប្រជាពលរដ្ឋ និង នៅ តាម ដងផ្លូវ សាធារណៈ ក្នុង ភូមិសាស្រ្ត ក្រុង ខេមរភូមិន្ទ ដើម្បី បញ្ជៀស ទឹក ទាំងនេះ ឲ្យ ហូរ ចូល សមុទ្រ វិញ ក្រោយ លិច ផ្ទះសម្បែង របស់ ប្រជាពលរដ្ឋ ។
លោក ឈឹម ចិន បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ថា « រយៈពេល ប៉ន្មាន ថ្ងៃ នេះ ឃើញ ថា សម្រាប់ ខេត្ត កោះកុង មាន ភ្លៀង ធ្លាក់ ជាច្រើន ក្រោម ឥទ្ធិពល នៃ អាកាសធាតុ មាន សម្ពាធ ទាប ហើយ នាំ ទាំង ភ្លៀង ធ្លាក់ ខ្លាំង ធ្វើឲ្យ មាន ការលិច ចូលក្នុង លំនៅដ្ឋាន ប្រជាពលរដ្ឋ និង លិច តាម ដងផ្លូវ សាធារណៈ ក្នុង ក្រុង ខេមរភូមិន្ទ ស្ទើ គ្រប់ តាម ដងផ្លូវ » ។
ជន ឆបោក ដ៏ ធំ មួយ នេះ ឈ្មោះ ឌឹម សួន ណាត អាយុ ៣៦ ឆ្នាំ រស់ នៅ ផ្ទះ លេខ ៣៤ ផ្លូវ លេខ ១០០៧ ភូមិ ឧកញ៉ា វាំង សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ ត្រូវបាន កម្លាំង នគរបាល នាយកដ្ឋាន ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ ចាប់ខ្លួន កាលពី ប៉ុន្មាន ថ្ងៃ មុន ដោយ មាន បញ្ជា ពី ព្រះរាជអាជ្ញា និង មាន បណ្ដឹង របស់ ជនរងគ្រោះ ជាច្រើន នាក់ ដែល បាន អស់ លុយ អស់ កាក់ រាប់ ពាន់ រាប់ ម៉ឺន ដុល្លារ ទៅ លើ ជន មួយ នេះ ព្រមទាំង បក្ខពួក របស់ ខ្លួន ។
ក្រោយ ចាប់ខ្លួន និង ធ្វើ ការសួរចម្លើយ មួយ រយៈពេល មក ជនសង្ស័យ រូប នេះ ត្រូវបាន បញ្ជូន ទៅកាន់ នាយកដ្ឋាន កណ្ដាល នគរបាល សន្ដិសុខ ដើម្បី បន្ដ ការសួរនាំ និង ធ្វើ ការស្រាវជ្រាវ នៃ ទំហំ រឿង ទាំងមូល ដើម្បី ទប់ស្កាត់ កុំ ឲ្យ មាន បញ្ហា មួយ នេះ កើតឡើង បន្ដ ទៀត មក លើ ពលរដ្ឋ ខ្មែរ ។
មន្ដ្រី នគរបាល ជាន់ ខ្ពស់ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា ជនសង្ស័យ ឌឹម សួន ណាត ត្រូវបាន បញ្ជូន ទៅកាន់ តុលាការ ខេត្ត សៀមរាប ដើម្បី ធ្វើ ការសួរនាំ និង ចាត់ការ តាម នីតិវិធី ច្បាប់ ព្រោះ រឿង ដែល បាន កើតឡើង ដំបូង នៅលើ ទឹកដី ខេត្ត សៀមរាប ។
ស្នងការ នគរបាល ខេត្ត ត្បូងឃ្មុំ លោក ឧត្តមសេនីយ៍ ទោ បែន រ័ត្ន បាន ថ្លែង បញ្ជាក់ ថា លោក បាន បញ្ជា ឲ្យ នគរបាល មូលដ្ឋាន និង សមត្ថកិច្ច ចុះ ស្រង់ ឈ្មោះ ជនរងគ្រោះ ដែល បាញ់បោក ប៉ុន្ដែ មិន ទាន់ ទទួលបាន ទាំងអស់ នៅឡើយ ទេ ដោយ មាន ជនរងគ្រោះ ខ្លះ នៅតែ បន្ដ លាក់បាំង និង មិន ហ៊ាន មក ដាក់ ពាក្យបណ្ដឹង ។
ដោយឡែក មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ ម្នាក់ ទៀត ក៏ បាន លួច បង្ហើប ថា ជនសង្ស័យ រូប នេះ ក៏ មាន អ្នក នៅ ពីក្រោយ ខ្នង ជា មន្ដ្រី ជាន់ ខ្ពស់ នៅ ក្រសួង ស្ថាប័ន រដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ ទៀតផង ៕
កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង ប្រមូល បាន ទឹកប្រាក់ ជិត ២លាន ដុល្លារ ពី សប្បុរសជន
( បាត់ដំបង ) ៖ ពិធី អបអរ ខួប លើក ទី ១៥៦ ទិវា ពិភពលោក កាកបាទ ក្រហម អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០១៩ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ កាកបាទ ក្រហម កម្ពុជា » នៅ ខេត្ត បាត់ដំបង ដែល ទើប ប្រារព្ធ ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២០ ខែកក្កា ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ ។
លោក បណ្ឌិត ប៊ុន គឹម ស៊ាន បាន បន្ត ថា អំពី សមិទ្ធផល ជាក់ស្តែង សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង រួមា ន៖
លោក បាន បន្ត ទៀត ថា កត្តា ប្រឈម ដែល សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បាត់ដំបង ជួបប្រទះ រួម មាន៖
* ទី១៖ បញ្ហា ប្រឈម ជា សកល មាន ដូចជា បម្រែបម្រួល អាកាសធាតុ ការកើនឡើង កម្តៅ នៃ ភព ផែនដី ភាពរាំងស្ងួត បាតុភូត ខ្យល់ព្យុះ ខ្យល់ កន្ត្រាក់ ការកើនឡើង សត្វ ចង្រៃ ស៊ី ដំណាំ និង ជម្ញឺ ឆ្លង ថ្មី ៗ * ទី ២៖ បញ្ហា ប្រឈម អសកល មាន ដូច ជា៖ គ្រោះថ្នាក់ ចរារចរណ៍ គ្រឿងញៀន គ្រឿងស្រវឹង អំពី ហិង្សា ក្នុង គ្រួសារ ចំណាកស្រុក ខុស ច្បាប់ គ្រោះថ្នាក់ ដោយសារ មីន និង គ្រាប់ យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ ៕ កម្លាំង នគរបាល ខណ្ឌ សែនសុខ ឃាត់ខ្លួន ជនសង្ស័យ ០២ នាក់ ពាក់ព័ន្ធ ករណី ឆក់ ទូរស័ព្ទ ដៃ នៅ សង្កាត់ ក្រាំង ធ្នង់
( ភ្នំពេញ ) ៖ កម្លាំង ប៉ុស្តិ៍ រដ្ឋបាល ក្រាំង ធ្នង់ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ សែនសុខ បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ០២ នាក់ ករណី លួច ឆក់ ទូរស័ព្ទ ដៃ នៅ ចំណុច មុខ សាលា មុំ ផ្លូវ ១៩៦២ ភូមិ ក្រាំង អង្ក្រង សង្កាត់ ក្រាំង ធ្នង់ ខណ្ឌ សែនសុខ ដោយ ប្រើប្រាស់ មធ្យោបាយ ម៉ូតូ ០១ គ្រឿង នៅ ល្ងាច ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ ។
សមត្ថកិច្ច មូលដ្ឋាន បាន ឲ្យដឹង ថា ជនសង្ស័យ ០២ នាក់ នេះ ទី ១៖ ឈ្មោះ ចែម វិសុទ្ធ អាយុ ១៨ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ស្នាក់ នៅ បន្ទប់ ជួល ផ្លូវ បេតុង ភូមិ ថ្ម គោល សង្កាត់ ចោម ចៅ១ ខណ្ឌ ពោធិ៍សែនជ័យ ( គ្មាន សារធាតុ ញៀន ) និង ទី២៖ ឈ្មោះ ហែម ចាន់ នឿន អាយុ ២០ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ស្នាក់ នៅ បន្ទប់ ជួល ផ្លូវ បេតុង ភូមិ ឬ ស្សី សង្កាត់ ស្តឹង មានជ័យ៣ ខណ្ឌ មានជ័យ ( គ្មាន សារធាតុ ញៀន ) ។
បច្ចុប្បន្ន ជនសង្ស័យ កំពុង ឃាត់ខ្លួន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ សែនសុខ ដើម្បី អនុវត្ត តាម និតិវិធី ៕
សមត្ថកិច្ច បន្ត ចាប់ រថយន្ត ឡង់ គ្រីស័រ ដឹក ឈើ ១ គ្រឿង ទៀត រួច ដុត បំផ្លញ ចោល រីឯ ឈើ ប្រគល់ ឱ្យ មន្រ្តី បរិស្ថាន ចាត់ចែង តាម ច្បាប់ នៅ ខេត្ត រតនគីរី
លោក វរសេនីយ៍ ត្រី សុខ មីន មេបញ្ជាការ អាវុធហត្ថ មូលដ្ឋាន ស្រុក អូរយ៉ាដាវ បាន ប្រាប់ ភ្នាក់ងារ Fresh News នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ថា ក្រោយពី ចាប់ រថយន្ត ដឹក បទល្មើស នោះ កម្លាំង បាន ធ្វើ ការត្រួតពិនិត្យ ឃើញ ឈើ ប្រភេទ លេខ ( ផ្ចឹក ) ចំនួន ៦ដុំ ស្មើ នឹង ១.១២៥ ម៉ែត្រ គូប នាំយក ទៅ រក្សាទុក នៅ ទីស្នាក់ការចម្រុះ ចំណុច ពាម អូរ លាវ ដើម្បីឱ្យ ជំនាញ បរិស្ថាន កសាង សំណុំរឿង ចាត់ការ តាម ច្បាប់ ។
លោក វរសេនីយ៍ ត្រី សុខ មីន ប្រាប់ បន្ត ថា ដោយ មាន បទបញ្ជា ពី លោក ឧត្តមសេនីយ៍ ត្រី ថា វ យ៉េន មេបញ្ជាការ អាវុធហត្ថ ខេត្ត និង មាន ការសម្របសម្រួល ពីសំណាក់ លោក រ៉ា បូរ៉ាន់ឌី ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត រតនគិរី មធ្យោបាយ ដឹកជញ្ជូន បទល្មើស ឈើ ត្រូវ ដុត បំផ្លាញ ចោល នៅ ទីតាំង ខាងលើ ។
ក្នុង ពិធី ដ៏ មហោឡារឹក អធិកអធម នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី មន្ត្រី ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា . ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា . ប្រធាន កាយ រឹទ្ធិជាតិ កម្ពុជា . ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ កាកបាទ ក្រហម កម្ពុជា . ប្រធាន បេសកកម្ម គណៈកម្មាធិការ អន្តរជាតិ កាកបាទ ក្រហម ប្រចាំ កម្ពុជា . អ្នកសម្របសម្រួល កម្មវិធី របស់ សហព័ន្ធ ប្រចាំ កម្ពុជា ព្រមទាំង ថ្នាក់ដឹកនាំ កាកបាទ ក្រហ កម្ពុជា មកពី តាម សាខា នានា ភ្ញៀវ កិត្តិយស និង យុវជន កាកបាទ ក្រហម ជាច្រើន រូប ផ្សេង ទៀត ។
យុវជន កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ បាន បង្កើតឡើង នៅ ឆ្នាំ ២០០៤ ដែល មាន យុវជន កាកបាទ ក្រហម ប្រមាណ ៨៦០ នាក់ ( នារី ៣៩៩ នាក់ ) ។ នៅ ឆ្នាំ ២០១៩ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ បាន ពង្រីក សមាជិក យុវជន ថ្មី ចំនួន ៣.០០០ នាក់ មកពី ២៧វិទ្យាល័យ គោលដៅ ដែល ជា រួម បច្ចុប្បន្ន សាខា មាន យុវជន កាកបាទ ក្រហម កម្ពុជា មាន ចំនួន ប្រមាណ ៤.០៤២ នាក់ ( នារី ២. ០៥០នាក់ ) ។ យុវជន កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង បុព្វហេតុ មនុស្សធម៌ ។
អភិបាល រាជធានី ភ្នំពេញ បាន ឱ្យដឹង ថា ក្នុង ឆ្នាំ កន្លងទៅ នេះ យុវជន កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ នៃ គ្រឹះស្ថាន សិក្សា ទាំង ២៧ បាន ធ្វើ យុទ្ធនាការ អប់រំ ផ្សព្វផ្សាយ ស្តីពី សុវត្ថិភាព ចរាចរណ៍ . ចូលរួម ផ្តល់ ការបណ្តុះបណ្តាល ជំនាញ សង្គ្រោះ បឋម . ជួយសង្គ្រោះ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ និង ចូលរួម ធ្វើ យុទ្ធនាការ បំផុស ឱ្យ មាន ការបរិច្ចាគ ឈាម ជាដើម ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក៏ បាន គូសបញ្ជាក់ ផងដែរ ថា ការរៀបចំ ឱ្យ មាន ការបំពាក់ កន្សែង យុវជន កាកបាទ ក្រហម កម្ពុជា នា ឱកាស នេះ គឺជា សក្ខីកម្ម មួយ ទៀត នៃ ការខិតខំ ប្រឹងប្រែង ពង្រឹង - ពង្រីក កម្លាំង យុវជន និង ជា ឱកាស ដ៏ ប្រសើរ បំផុត ក្នុង ការ ប្រកាស បំពេញ សិទ្ធិ ជូន ក្មួយ ៗ យុវជន កាកបាទ ក្រហម កម្ពុជា ឱ្យ សក្តិសម ជា ធនធាន មនុស្ស ប្រកបដោយ គុណភាព និង សមត្ថភាព របស់ កាកបាទ ក្រហម កម្ពុជា និង ចលនា អន្តរជាតិ កាកបាទ ក្រហម - អឌ្ឍ ចន្ទ ក្រហម នា ពេល បច្ចុប្បន្ន និង ទៅ អនាគត ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក៏ បាន សម្តែង នូវ មោទនភាព ផងដែរ ចំពោះ លទ្ធផល ការងារ និង ទិសដៅ អនុវត្ត បន្ត របស់ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ ជាមួយនឹង ក្តីសង្ឃឹម ជឿជាក់ ថា សាខា នឹង បន្ត យកចិត្តទុកដាក់ ជំរុញ បន្ថែម ទៀត នូវ ការងារ យុវជន កាកបាទ ក្រហម ឱ្យ កាន់តែ រឹងមាំ ខ្លាំងក្លា ដើម្បីឱ្យ យុវជន ក្លាយជា កម្លាំង បច្ចុប្បន្ន និង អនាគត របស់ កាកបាទ ក្រហម កម្ពុជា និង ប្រទេសជាតិ ។
នៅក្នុង បរិការណ៍ កាកបាទ ក្រហម កម្ពុជា យុវជន គឺជា « ភ្នាក់ងារ នៃ ការផ្លាស់ប្តូរ ឥរិយាបថ ជា វិជ្ជមាន នៅក្នុង សហគមន៍ » សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រធាន កាកបាទ ក្រហម កម្ពុជា ក៏ បាន ចែករំលែក នូវ អនុសាសន៍ ចំនួន ៧ ផងដែរ ដើម្បីឱ្យ យុវជន កាកបាទ ក្រហម កម្ពុជា បាន ចូលរួម កាន់តែ ទូលំទូលាយ និង ធ្វើ សកម្មភាព កាន់តែ ប្រសើរឡើង ប្រកបដោយ ប្រសិទ្ធភាព ក្នុង ការផ្តល់ សេវាកម្ម មនុស្សធម៌ ជួយ ដល់ ជនរងគ្រោះ និង ងាយ រងគ្រោះ ឱ្យ បាន ទាន់ ពេលវេលា នៅ គ្រប់ មជ្ឈដ្ឋាន ទូទាំង ប្រទេស ។ អនុសាសន៍ ទាំង៧ នោះ រួម មាន៖
ទី១៖ ត្រូវ រួមគ្នា បន្ត ពង្រឹង និង ពង្រីក កម្លាំង យុវជន កាកបាទ ក្រហម កម្ពុជា តាម លទ្ធភាព ជាក់ស្តែង របស់ សាខា នីមួយ ៗ តាមរយៈ ការពង្រឹង សមត្ថភាព យុវជន ការផ្តល់ ឱកាស ស្វ័យភាព ការគ្រប់គ្រង សកម្មភាព ការងារ បណ្តុះបណ្តាល មុខជំនាញ ដើម្បី ចូលរួម សកម្មភាព ត្រៀម បង្ការ ទៅនឹង គ្រោះមហន្តរាយ ការផ្សព្វផ្សាយ ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ការបរិច្ចាគ ឈាម ការសម្អាត បរិស្ថាន និង ការដាំ ដើមឈើ ឱ្យ បាន ច្រើន ដើម្បី បង្កើត បរិស្ថាន ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ សម្រាប់ សង្គមជាតិ ។
ទី២៖ ត្រូវ រួមគ្នា បន្ត ពង្រឹង សកម្មភាព មិត្ត អប់រំ មិត្ត មិត្ត ជួយ មិត្ត នៅ គ្រប់ ក្លិប យុវជន កាកបាទ ក្រហម កម្ពុជា តាមរយៈ ការជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ សិស្ស - និស្សិត ដែល មាន ជីវភាព លំបាក ក្នុង ការសិក្សា និង ការរស់នៅ ប្រចាំ ថ្ងៃ នៅ តាម សាលា និង សាកលវិទ្យាល័យ ប្រកបដោយ ប្រសិទ្ធភាព ត្រូវ រួមចំណែក ផ្តល់ ចំណេះដឹង ស្តីពី វិជ្ជា សង្គ្រោះ បឋម ការថែទាំ អនាម័យ និង សុខភាព ការការពារ ជំងឺ ឆ្លង ជំងឺ មិន ឆ្លង ក្នុង សហគមន៍ ត្រូវ ជួយ ផ្សព្វផ្សាយ អប់រំ សុខភាព ក្នុង គ្រា អាសន្ន នៅ តាម សាខា ទាំង ២៥ រាជធានី - ខេត្ត ។
ទី៣៖ ត្រូវ រួមគ្នា បន្ត ពង្រឹង យន្តការគ្រប់គ្រង យុវជន កាកបាទ ក្រហម កម្ពុជា ដែល មាន ស្រាប់ តាមរយៈ ការផ្តល់ បណ្ណ សម្គាល់ ខ្លួន ដល់ យុវជន និង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ថ្នាក់ ជាតិ និង អន្តរជាតិ តាមរយៈ ការធ្វើ ទស្សនកិច្ច សិក្សា ផ្លាស់ប្តូរ បទពិសោធន៍ សិក្ខាសាលា វេទិកា យុវជន និង វគ្គ បណ្តុះបណ្តាល នានា ដើម្បី ធានា សុខដុមនីយកម្ម និង រឹត ចំណង មិត្តភាព សាមគ្គីភាព ក្នុង ចំណោម យុវជន ទាំង ក្នុង ក្របខណ្ឌ ជាតិ តំបន់ និង អន្តរជាតិ ។
ទី៤៖ ត្រូវ បន្ត ឱ្យ មាន វគ្គ បណ្តុះបណ្តាល ជា បន្តបន្ទាប់ ដល់ យុវជន រួមទាំង ការបន្ត ផ្សព្វផ្សាយ នូវ សេចក្តីណែនាំ នានា របស់ កាកបាទ ក្រហម កម្ពុជា ឱ្យ បាន ប្រកបដោយ ប្រសិទ្ធភាព និង ទូលំទូលាយ ដើម្បី ងាយស្រួល ក្នុង ការបំពេញ សកម្មភាព មនុស្សធម៌ នៅ គ្រប់ មជ្ឈដ្ឋាន ទូទាំង ប្រទេស ។
ទី៥៖ ត្រូវ បន្ត បង្កើន ការយកចិត្តទុកដាក់ ខ្ពស់ ថែម ទៀត ជាពិសេស ការលើកទឹកចិត្ត យុវជន ឱ្យ ចូលរួម ជា កម្លាំង ស្ម័គ្រចិត្ត ដើម្បី ធានា បាន នូវ វឌ្ឍនភាព និង ចីរភាព នៃ កម្លាំង មនុស្សធម៌ វ័យ ក្មេង សម្រាប់ បន្ត វេន ក្នុង សកម្មភាព ជួយ សហគមន៍ នៅ គ្រប់ រាជធានី - ខេត្ត ។
ទី៦៖ ត្រូវ បន្ត ពង្រឹង សាមគ្គីភាព មិត្តភាព និង ការចេះ ជួយ គ្នា ទៅ វិញ ទៅ មក ជាមួយ អង្គការ យុវជន នានា និង បណ្តាញ យុវជន នៅ គ្រប់ ជំនាន់ ដោយ មិន ត្រូវ មើល ស្រាល អ្នកដទៃ និង ការបែងចែក ប្រកាន់ បក្សពួក ដែល អាច ធ្វើឱ្យ បែកបាក់ សាមគ្គីភាព នៅក្នុង ចំណោម យុវជន កាកបាទ ក្រហម កម្ពុជា ។
ទី ៧៖ យុវជន កាកបាទ ក្រហម កម្ពុជា ទាំងអស់ ត្រូវ មាន ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ នៅពេល បំពេញ ភារកិច្ច របស់ ខ្លួន ក្មួយ ៗ ត្រូវ ផ្សារភ្ជាប់ ចំណេះវិជ្ជា របស់ ក្មួយ ៗ ដែល មាន ស្រាប់ ទៅនឹង ការអនុវត្ត និង ការសិក្សា ជំនាញ ថ្មី ៗ ដែល ទើប ទទួលបាន ដើម្បី ក្មួយ ៗ អាច ជួយ ដល់ ជនរងគ្រោះ និង ជន ងាយ រងគ្រោះ នៅក្នុង សហគមន៍ បាន ទាន់ ពេលវេលា និង ប្រកបដោយ ប្រសិទ្ធភាព ៕
សេចក្តីព្រាង ច្បាប់ ខាងលើ ដែល ត្រូវបាន ស្នើ ឡើង នៅ សភា ជាន់ ទាប រុស្ស៊ី នា ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ នេះ នឹង អនុញ្ញាតឲ្យ អាជ្ញាធរ រុស្ស៊ី បង្កើត នូវ បញ្ជី ឈ្មោះ នៃ កម្មវិធី software នានា ដែល ផលិត ក្នុង ប្រទេស រុស្ស៊ី ដែល ចាំបាច់ ត្រូវ ដំឡើង លើ ឧបករណ៍ បច្ចេកវិទ្យា ទាំងនោះ ។
ប្រសិនបើ ទទួលបាន ការអនុម័ត គាំទ្រ ទាំង ពី សភា ជាន់ ទាប សភា ជាន់ ខ្ពស់ ហើយនិង ប្រធានាធិបតី រុស្ស៊ី លោក វ៉្លាឌីមៀ ពូទីន សេចក្តីព្រាង ច្បាប់ នេះ នឹង ចូល ជាធរមាន ពេញលេញ នៅ ខែកក្កដា ឆ្នាំ ២០២០ ។ មិន តែ ប៉ុណ្ណោះ ក្នុង ច្បាប់ ដដែល នោះ ក៏ មាន ចែង នូវ ការដាក់ ពិន័យ ជា ប្រាក់ ចន្លោះ ពី ៧៩០ - ៣. ១៧០ ដុល្លារ ផងដែរ ចំពោះ ក្រុមហ៊ុន ដែល លក់ ឧបករណ៍ បច្ចេកវិទ្យា ទាំង ប៉ុន្មាន ខាង លើ ដោយ គ្មាន កម្មវិធី software រុស្ស៊ី ដំឡើង រួច មក ស្រាប់ ។
លោក គុណ ញឹម បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ សូម បញ្ជាក់ ថា ក្រុមហ៊ុន នាំចូល កុងតឺន័រ នោះ យើង រកឃើញ ថា ជា ក្រុមហ៊ុន ខ្មែរ តែ មាន ជនជាតិ ចិន ធ្វើការ នៅ ទីនោះ . នៅ ពាក់កណ្តាល សប្តាហ៍ ក្រោយ យើង នឹង ហៅ ខាង ក្រុមហ៊ុន សួរនាំ អំពី បញ្ហា នេះ ទាំង ជនជាតិ ខ្មែរ និង ជនជាតិ ចិន ប្រសិនបើ រកឃើញ ថា ជនជាតិ ចិន មាន ភាគហ៊ុន ដែរ នោះ យើង នឹង បង្ហាញ លទ្ធផល ច្បាស់ ការ» ។
លោក បាន បន្ត ថា « កុងតឺន័រ ទាំង ៨៣ នេះ បាន នាំចូល បន្តិច ម្តង ៗ តាំងពី ឆ្នាំ ២០១៨មក ម្ល៉េះ ដូច្នេះ យើង ត្រូវការ ពេលវេលា ស្រាវជ្រាវ លើ រឿង នេះ ឲ្យបាន លម្អិត » ។
ម្ចាស់ សណ្ឋាគារ នេះ បាន ប្រកាន់ នូវ គោលការណ៍ ជ្រើសរើស យុវជន គ. ថ្លង់ ពី ២៥ - ៣០% នៃ ចំនួន បុគ្គលិក សរុប ដែល បម្រើ ការងារ ក្នុង សណ្ឋាគារ របស់ ខ្លួន ។
លោក យឹង សារ៉ាត់ នាយក ក្រុមហ៊ុន សណ្ឋាគារ ជី អេនហ្ស៊ី បាន ឲ្យដឹង ថា មាន ហេតុផល ដ៏ ត្រឹមត្រូវ មួយចំនួន ដែល ក្រុមហ៊ុន របស់ លោក ទទួល បុគ្គលិក គ. ថ្លង់ ឲ្យ មក ធ្វើ ការ ហើយ ពួកគាត់ ត្រូវបាន ទទួល ប្រាក់ខែ ពី ១៥០ ដុល្លារ ដល់ ៣៥០ ដុល្លារ តាម ជំនាញ និង ទំហំ ការងារ របស់ ខ្លួន ។
លោក បញ្ជាក់ ដែរ ថា គ្រប់ រូប នៃ បុគ្គលិក គ. ថ្លង់ ទាំងអស់ គឺ មាន ភាគហ៊ុន ៨% ដោយ ស្វ័យប្រវត្តិ ក្រោយពេល បាន ចូល បម្រើ ការងារ ជាមួយ ក្រុមហ៊ុន ហើយ ក្រុមហ៊ុន ក៏ ត្រូវបាន បរិច្ចាគ ទឹកប្រាក់ ចំនួន ២% បន្ថែម ទៀត សម្រាប់ ការងារ សង្គម ដែល ទាក់ទង ទៅ នឹង ការជួយ ដល់ ជន ពិការ គរ . ថ្លង់ ផងដែរ ។
លោក ថា មាន មនុស្ស ច្រើន ណាស់ ដែល មាន ចម្ងល់ ថា តើ ក្រុមហ៊ុន ធ្វើការ ជាមួយ ជនគរ . ថ្លង់ យ៉ាងដូចម្តេច ? តាមពិត បុគ្គលិក គ. ថ្លង់ ក៏ ដូចជា មនុស្ស ធម្មតា ដែរ គ្រាន់តែ ពួកគេ ខ្វះ កាយសម្បទា មិន អាច និយាយ បាន ឬ ស្ដាប់ឮ តែ ប៉ុណ្ណោះ តែ ពួកគាត់ អាច សរសេរ បាន ហើយ ពួកគាត់ ក៏ មាន សមត្ថភាព ពិសេស បំពេញការខ្វះចន្លោះ នោះ ផងដែរ ដូចជា មាន ភាពស្មោះត្រង់ ឈ្លាសវៃ រហ័ស រហួន និង ព្យាយាម អំណត់ ។
លោក បន្ត ទៀត ថា សម្រាប់ ពេល ខាងមុខ គឺ ក្រុមហ៊ុន មាន គោលការណ៍ ជ្រើសរើសយក យុវជន គ. ថ្លង់ បម្រើ ការងារ ក្នុង ក្រុមហ៊ុន ប្រមាណ ជា ១៥០ នាក់ ផងដែរ ។
កញ្ញា ជន់ ចំរើន ដែល ជា យុវតី គ. ថ្លង់ មាន តួនាទី ជា អ្នកគ្រប់គ្រង ភោជនីយដ្ឋាន របស់ ក្រុមហ៊ុន សណ្ឋាគារ ជី អេនហ្ស៊ី បាន បង្ហាញ អារម្មណ៍ រីករាយ និង មាន ភាព កក់ក្តៅ ដែល ក្រុមហ៊ុន បាន ទទួល យុវជន / យុវតី គ. ថ្លង់ ឲ្យ ចូល បម្រើ ការងារ ។
កញ្ញា បាន បន្ថែម ឲ្យដឹង ថា ពួកគាត់ បាន រៀនសូត្រ ទាំង ចំណេះ ទូទៅ និង អ្នក ខ្លះ ទៀត ក៏ បាន រៀនសូត្រ នូវ ជំនាញ និង ភាសា បរទេស ផងដែរ ហើយ អ្នក ខ្លះ អាច ចេះ អាន ចេះ សរសេរ និង ប្រើ ភាសា សញ្ញា បាន រហូតដល់ ពីរ - បី ភាសា ពិសេស ភាសា អង់គ្លេស ។ ហើយ ការផ្ដល់ ឱកាស ការងារ ដល់ អ្នក គ. ថ្លង់ ពិតជា បាន ចូលរួមចំណែក យ៉ាង ធំធេង ក្នុង ការលើកស្ទួយ សិទ្ធិ ជន ពិការ និង បាន ធ្វើឲ្យ ជីវិភាព ពួកគាត់ គ្រួសារ និង សេដ្ឋកិច្ច សង្គមជាតិ មាន ការរីកចម្រើន មួយ ផ្នែក ផងដែរ ៕
ក្រុមហ៊ុន NSZ World ជា ក្រុមហ៊ុន ស្រប ច្បាប់ មួយ ដែល មាន ការនាំចូល និង ចែកចាយ ផលិតផល ថែទាំ សុខភាព និង សម្ផស ជា ប្រភេទ គ្រីម លាប និង ជា ក្រុមហ៊ុន មួយ ដែល ជួយ បណ្ដុះបណ្ដាល យុវជន ឲ្យ ចេះ ធ្វើ អាជីវកម្ម ទីផ្សារ បណ្តាញ ដើម្បីឲ្យ យុវជន មាន ការងារ និង មុខរបរ ។
លោក ឡី សុភាព បាន ពាំនាំ នូវ ការគាំទ្រ ពី ថ្នាក់ដឹកនាំ សមាគម សហព័ន្ធ វេជ្ជសាស្ត្រ ឱសថសាស្ត្រ និង ទន្តសាស្ត្រ កម្ពុជា និង សមាគម អ្នក ទីផ្សារ បណ្តាញ កម្ពុជា បង្ហាញ ប្រាប់ ក្រុមហ៊ុន NSZ World និង អំពាវនាវ ឱ្យ ក្រុមហ៊ុន នេះ ប្រឹងប្រែង បន្ត ការចូលរួម បណ្ដុះបណ្ដាល យុវជន បន្ថែម ទៀត ។
ការប្រកាស ភាពអាសន្ន ពី ការផ្ទុះឡើង ជាថ្មី នូវ វីរុស Ebola ក្នុង សាធារណ ប្រជាធិបតេយ្យ កុងហ្គោ ពីសំណាក់ WHO ធ្វើឡើង បន្ទាប់ពី អាចារ្យ គ្រឹស្ដ ម្នាក់ បាន ជិះ រថយន្ដក្រុង មួយ គ្រឿង នា ពេល ថ្មី ៗ នេះ ឆ្ពោះ ទៅកាន់ ទីក្រុង Goma មាន មនុស្ស ជាង ២លាន នាក់ រស់ នៅ និង ជា ទីក្រុង ដែល ភ្ជាប់ ព្រំដែន រវាង សាធារណរដ្ឋ ប្រជាធិបតេយ្យ កុងហ្គោ និង ប្រទេស រ៉ាដ្វាន់ ដា ។
* សាធារណរដ្ឋ ប្រជាធិបតេយ្យ កុងហ្គោ និយាយ អ្វី ខ្លះ ?
* វិបត្តិ ស្មុគស្មាញ
បើ តាម ការអះអាង របស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ប្រទេស ជប៉ុន ដដែល បុរស ជា ជនសង្ស័យ បាន ស្រោច សាំង ទៅ លើ អគារ ក្រុមហ៊ុន ហើយ ស្រែក ថា « ស្លាប់ ទៅ » ស្រប ពេល ដែល ខ្លួន ដុត បញ្ឆេះ អគារ នោះ ឡើង ។ ជា លទ្ធផល វា បាន បង្ក ជា សោកនាដកម្ម ស្លាប់ មនុស្ស យ៉ាង រង្គាល បំផុត មិន ធ្លាប់ មាន ឡើយ ក្នុង ប្រវត្តិសាស្រ្ត ជប៉ុន អំឡុង ពេល ប្រមាណ ពីរ ទសវត្សរ៍ មក នេះ ។ ក្រៅពី មនុស្ស បាត់បង់ជីវិត មនុស្ស ជាង ៣០ នាក់ ក៏ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ដើម្បី ព្យាបាល របួស ផងដែរ ។
គួរ ជម្រាប ថា គំនូរ ជីវ ចល បែប Anime បាន ក្លាយជា អត្តសញ្ញាណ យ៉ាង សំខាន់ មួយ នៅក្នុង វប្បធម៌ ជប៉ុន សម័យ ទំនើប ដែល គំនូរ ជីវ ចល ប្រភេទ នេះ ទទួលបាន ការគាំទ្រ យ៉ាង ធំ សម្បើម មិន ថា ទាំង នៅក្នុង ប្រទេស ជប៉ុន ផ្ទាល់ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ មាន ភាពល្បី សុះ សាយ នៅ ជុំវិញ ពិភពលោក តែម្តង ៕
១៖ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ប្រកាស ដាក់ ជីវិត លើ ប្រតិបត្តិការ បង្ក្រាប បទល្មើស ព្រៃឈើ និង ដក មន្រ្តី អាវុធហត្ថ ដែល នៅ បន្ដ ឃុបឃិត ជាមួយ ឈ្មួញ គ្រវាត់ចោល ( ចុច អាន )
៤៖ វៀតណាម គាំទ្រ កម្ពុជា ប្រឆាំង ការអនុម័ត ច្បាប់ ស្តីពី លទ្ធិ ប្រជាធិបតេយ្យ កម្ពុជា របស់ សភា ជាន់ ទាប អាមេរិក ( ចុច អាន )
៧៖ មន្រ្តី កសិកម្ម ចេញ ការណែនាំ វិធានការ ទប់ស្កាត់ ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក នៅ កន្លែង សត្តឃាតដ្ឋាន និង តាំង លក់ ផលិតផល សត្វ ក្នុង ខេត្ត ព្រៃវែង ( ចុច អាន )
៨៖ លោក ហ៊ុន សុខា ប្រធាន ក្លឹប កាសែត ឯករាជ្យ និង ចាងហ្វាង កាសែត TN រួម ជាមួយ មនុស្ស ៥នាក់ ទៀត ត្រូវ អាវុធហត្ថ ឃាត់ខ្លួន ពាក់ព័ន្ធ បញ្ហា ដីធ្លី នៅ ខេត្ត ព្រះសីហនុ ( ចុច អាន )
២៖ ស្ថានការណ៍ នឹង កាន់តែ អាក្រក់ ក្រោយ អាមេរិក បាញ់ ដ្រូន អ៊ីរ៉ង់ មួយ គ្រឿង ធ្លាក់ វិញ ជា ការសងសឹក ( ចុច អាន )
១០៖ បុរស ជនជាតិ អាមេរិក ត្រូវ ជាប់ គុក គ្មាន ថ្ងៃ ចេញ ដោយសារ ការសម្លាប់ យ៉ាង ព្រៃផ្សៃ លើ នារី ជា បញ្ញា វន្ត ចិន ម្នាក់ ( ចុច អាន )
១១៖ ជប៉ុន កោះហៅ អគ្គ រដ្ឋទូត កូរ៉េ ខាងត្បូង មក សម្តែង ការតវ៉ា ខណៈ ជម្លោះ រវាង ប្រទេស ទាំង ពីរ កាន់តែ តានតឹង ( ចុច អាន )
១៣៖ អាល្លឺម៉ង់ លើកឡើង ពី កត្តា ចាំបាច់ ជា ច្រើន ដែល អាល្លឺម៉ង់ - រុស្ស៊ី ត្រូវតែ រក្សា ទំនាក់ទំនង ល្អ ជាមួយគ្នា ( ចុច អាន )
១៦៖ ឥណ្ឌា សម្រេច ថា នឹង ព្យាយាម ចេញ បេសកកម្ម ទៅ ឋាន ព្រះច័ន្ទ ជាថ្មី ម្តង ទៀត នៅ ដើម សប្តាហ៍ ក្រោយ បន្ទាប់ពី ត្រូវ ផ្អាក ភ្លាម ៗ ប៉ុន្មាន ថ្ងៃ មុន ( ចុច អាន )
លោក គួច ចំរើន ដាក់ ផែនការ តឹងរឹង ធានា សន្តិសុខ របៀបរៀបរយ និង សុវត្ថិភាព ក្នុង ខេត្ត ព្រះសីហនុ
( ភ្នំពេញ ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន ដាក់ ផែនការ តឹងរឹង ធ្វើ យ៉ាងណា ដើម្បី ធានា ឱ្យ បាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ របៀបរៀបរយ សុខ សុវត្ថិភាព សង្គម ក្នុង ខេត្ត ព្រះសីហនុ ទាំងមូល ។ នេះ បើ យោង តាម ការឲ្យដឹង នៅក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព ខេត្ត នា រសៀល ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ ។
ក្នុង នាម គណៈ បញ្ជាការ ឯកភាព ខេត្ត លោក គួច ចំរើន បាន ដាក់ចេញ នូវ វិធានការ សំខាន់ ៗ មួយចំនួន ដូច ជា៖
១៖ ដាក់ចេញ នូវ ផែន ការល្បាត ពេល យប់ ទៅ តាម ភូមិសាស្រ្ត ស្មុគស្មាញ ដេីម្បី ធានា រក្សា បាន នូវ សន្តិសុខ សណ្តាប់ធ្នាប់ របៀបរៀបរយ សុវត្ថិភាព សង្គម ក្នុង ខេត្ត ព្រះសីហនុ ទាំងមូល ។
២៖ សហការ ជាមួយ អង្គភាព ជំនាញ ពាក់ព័ន្ធ ក្នុង ការក្តាប់ សភាពការណ៍ និង ប្រមូល ព័ត៌មាន ដែល ពាក់ព័ន្ធ ។
៣៖ យកចិត្ត ទុក្ខ ដាក់ ទប់ស្កាត់ រាល់ ឧបាយកល ណាមួយ ធ្វេី ឱ្យ ប៉ះពាល់ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ជាតិ និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ( ពិសេស អំពេី ភារវកម្ម ឧក្រិដ្ឋកម្ម និង សកម្មភាព ល្មេីស ផ្សេង ៗ ) ដេីម្បី មាន វិធានការបង្កា ទប់ស្កាត់ និង បង្រ្កាប ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក ជំរុញ ឱ្យ យកចិត្តទុកដាក់ សម្រួល ដល់ ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ដោយ រួម សហការ ជាមួយ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ដេីម្បី ធ្វេី យ៉ាងណា ឱ្យ ដំណេីរ ការ ប្រឡង ប្រព្រឹត្តទៅ ដោយ រលូន ត្រឹមត្រូវ និង ប្រសិទិ្ធ ភាព . បន្ត គ្រប់គ្រង សំណុំរឿង វិវាទ ដីធ្លី ទាំង ៨១ ករណី និង សំណុំរឿង ថ្មី ៗ រួមទាំង ឯកសារ ពាក់ព័ន្ធ . ស្នេី ឱ្យ មាន ការដក ខ្លួន ចេញ ជាបន្ទាន់ ចំពោះ មន្រ្តី ណា ដែល មាន ការពាក់ព័ន្ធ ក្នុង រឿង វិវាទ ដីធ្លី . បញ្ហា លាង លុយ ខ្មៅ . ការជួញដូរ មនុស្សជាដើម ៕
លោក អះអាង បន្ត ថា ដំបូង ក្រុមហ៊ុន នោះ ជា អ្នកម៉ៅការ ទាំង សម្ភារៈ សំណង់ និង ទាំង កម្លាំង ពលកម្ម កម្មករ តែ ក្រោយមក ក្រុមហ៊ុន របស់ លោក ជា អ្នកផ្គត់ផ្គង់ សម្ភារៈ សំណង់ ចំណែកឯ ក្រុមហ៊ុន ម្ខាង ទៀត នោះ ជា ក្រុមហ៊ុន ម៉ៅការ ដែល មាន តែ កម្លាំង កម្មករ សុទ្ធ ។
លោក បាន បន្ត ថា ក្រុមហ៊ុន បាន ចុះ កុងត្រា សាងសង់ រយៈពេល ត្រឹម ២៤០ ថ្ងៃ ដោយ ចាប់ គិត ពី ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០១៧ តែ ប៉ុណ្ណោះ ។ លោក តំណាង ក្រុមហ៊ុន សំណូមពរ ឲ្យ ក្រុមហ៊ុន នោះ យក វិបត្តិ ណា ដែល ថា ក្រុមហ៊ុន លោកជំពាក់ នោះ មក ពិនិត្យ ផ្ទៀងផ្ទាត់ ទូទាត់ សំណង ដោយ មាន អាជ្ញាធរ ចូលរួម ជា សាក្សី ប្រសិនបើ ក្រុមហ៊ុន នោះ មាន វិក័យបត្រ ជំពាក់ ដូច ការលើកឡើង នោះ មែន ក្រុមហ៊ុន ទទួល សង ទាំងអស់ ។ លោក តំណាង បញ្ជាក់ ថា លោក តែង ទូទាត់ គ្រប់ ជំហាន ការងារ ដោយ មិន ដែល ខកខាន ម្តង ណា ឡើយ ។
ចំពោះ កម្មករ ឈរ នៅមុខ ក្រុមហ៊ុន តវ៉ា កាលពី ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០១៩ កន្លងទៅ នេះ ដោយ ទាំង មាន កាន់ រូបភាព សម្ដេច ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត នោះ ពុំ មែន ជា កម្មករ ដែល កំពុង ធ្វើការ នៅក្នុង ក្រុមហ៊ុន របស់ គាត់ ឡើយ ។ លោក បញ្ជាក់ ថា ថ្ងៃ នេះ ក្រុមហ៊ុន របស់ លោក ទទួល និង បើក ប្រាក់ ឈ្នួល ដល់ កម្មករ ដែល រត់ ចេញ ពី ក្រុមហ៊ុន ម៉ៅការ ហើយក៏ បាន បន្ត អនុញ្ញាតឲ្យ ពួកគាត់ ចំនួន ៦នាក់ បាន ធ្វើ ការងារ ក្នុង ក្រុមហ៊ុន CHING ching II ផងដែរ ។
លោក រដ្ឋមន្ត្រី ក៏ បាន ជម្រាប ជូន អង្គ ពិធី អំពី គោលបំណង នៃ ពិព័រណ៍ ពាណិជ្ជកម្ម ដែល ផ្តោត លើ ការអបអរសាទរ ខួប អនុស្សាវរិយ៍ លើក ទី៦០ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត រវាង កម្ពុជា - ឥណ្ឌូនេស៊ី ។ ពិព័រណ៍ ពាណិជ្ជកម្ម នេះ នឹង ដំណើរការអម ជាមួយ ការសម្តែង សិល្បៈ ផ្សេង ៗ ក្នុង រយៈពេល ០៣ ថ្ងៃ ( ថ្ងៃទី ១៩ ដល់ ទី ២១ ខែកក្កដា ) ក្នុង គោលបំណង រឹតបន្តឹង ចំណង មិត្តភាព និង ផ្លាស់ប្តូរ បទពិសោធន៍ ព្រមទាំង វប្បធម៌ ប្រពៃណី និង ទំនៀមទំលាប់ គ្នា ទៅ វិញ ទៅមក ។
សូម ត្រៀម ទឹក ទុក ! រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ នឹង ផ្អាក ផ្គត់ផ្គង់ ទឹក រយៈពេល ខ្លី នៅ តំបន់ មួយចំនួន ក្នុង ខណ្ឌ ចំការមន និង ខណ្ឌ ពោធិ៍សែនជ័យ នៅ យប់ ថ្ងៃទី ២៣ និង ថ្ងៃទី៣០ ខែកក្កដា
( ភ្នំពេញ ) ៖ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ នឹង ផ្អាក ផ្គត់ផ្គង់ ទឹក ស្អាត រយៈពេល ខ្លី នៅ តំបន់ មួយចំនួន ក្នុង ខណ្ឌ ចំការមន និង ខណ្ឌ ពោធិ៍សែនជ័យ ក្នុង រាជធានី ភ្នំពេញ នៅ យប់ ថ្ងៃទី ២៣ និង ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០១៩ ដោយសារតែ អ្នកជំនាញ នឹង កាត់ ភ្ជាប់ បំពង់ ចែកចាយ ទឹក ថ្មី ។
ធនាគារ ជាតិ នៃ កម្ពុជា ដាក់ ឲ្យ ដំណើរការ សាកល្បង « ប្រព័ន្ធ បាគង » ដែល ជា ប្រព័ន្ធ ទូទាត់ បែប ឌីជីថល ជាមួយ ធនាគារ ជា ដៃគូ ចំនួន ៤
ការដាក់ ឲ្យ ដំណើរការ សាកល្បង « ប្រព័ន្ធ បាគង » ជា ដំណើរវឌ្ឍន៍ ភាព ក្នុង យុគសម័យ ថ្មី របស់ វិស័យ ហិរញ្ញវត្ថុ នៅ កម្ពុជា ។ ធនាគារ ជាតិ នៃ កម្ពុជា ពិត ជា មាន មោទនភាព ណាស់ ដែល ក្លាយជា ប្រទេស ដំបូង គេ ក្នុង ការដាក់ ឲ្យ ដំណើរការ ប្រព័ន្ធ បច្ចេកវិទ្យា Blockchain ដ៏ ទំនើប ចុងក្រោយ ក្នុង វិស័យ ហិរញ្ញវត្ថុ ដើម្បី ផ្តល់ លទ្ធភាព ក្នុង ការធ្វើ និង ជំរុញ បរិយាប័ន្ន ហិរញ្ញវត្ថុ សំដៅ ការផ្តល់ សេវា ហិរញ្ញវត្ថុ សម្រាប់ ប្រជាជន កម្ពុជា គ្រប់ រូប ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៧ លោកស្រី ជា សិរី អគ្គ នាយក បច្ចេកទេស ធនាគារ ជាតិ នៃ កម្ពុជា បាន ប្រជុំ ជាមួយ គណៈកម្មការ ទូទាត់ នៃ សមាគម ធនាគារ នៅ កម្ពុជា និង តំណាង គ្រឹះស្ថាន ផ្តល់ សេវា ទូទាត់ ដើម្បី ពិភាក្សា អំពី គម្រោង បាគង ដែល ជា គំនិត ផ្តួចផ្តើម ថ្មី របស់ ធនាគារ ជាតិ នៃ កម្ពុជា ពាក់ព័ន្ធ នឹង ករណី សិក្សា ពី លទ្ធភាព នៃ ការដាក់ ឱ្យ ប្រើប្រាស់ រូបិយវត្ថ អេឡិចត្រូនិក សម្រាប់ ប្រតិបត្តិការ ទូទាត់ អន្តរធនាគារ ៕
លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង នាំយក ទេយ្យ ទាន និង ទៀន ព្រះវស្សា ប្រគេន ដល់ ព្រះសង្ឃ ចំនួន ៥វត្ត ក្នុង ខណ្ឌ សែនសុខ
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល និង ជា ប្រធាន ក្រុម កាងារ ចុះ ជួយ ខណ្ឌ សែនសុខ នៅ រសៀល ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ មន្ត្រី ក្រសួង សុខាភិបាល នាំយក ទេយ្យ ទាន និង ទៀន ព្រះវស្សា ប្រគេន ដល់ ព្រះសង្ឃ ចំនួន ៥វត្ត ស្ថិត នៅក្នុង ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ដែល មាន ទីតាំង ប្រគេន រួម ស្ថិត នៅក្នុង វត្ត សំរោង អណ្តែត ។
ក្នុង ឱកាស នោះ ដែរ អភិបាល ខណ្ឌ សែនសុខ ក៏ បាន នាំយក ទេយ្យ ទាន ប្រគេន ជូន វត្ត ទាំង៥ ផងដែរ រួម មាន៖ អង្ករ ១០០ គីឡូក្រាម មី ៥កេស ទឹកក្រូច ៥កេស ទឹក បរិសុទ្ធ ១០កេស បច្ច័យ ៥០ ម៉ឺន រៀល ផងដែរ ។
ភាព ញៀន គ្រឿងញៀន មិន មែន ជា បទឧក្រិដ្ឋ តែ ជា ជំងឺ ខួរក្បាល អាច ព្យាបាល បាន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៩ ខែកក្កដា៖ បង្ក្រាប ២៨ ករណី ឃាត់ខ្លួន ៦១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ២៨ ករណី ក្នុង នោះ មាន ករណី ប្រើប្រាស់ ១១ករណី និង ជួញដូរ ១៧ករណី ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៦១ នាក់ ។
មន្រ្តី កាំ កុងត្រូល ព្រះវិហារ បន្ត ចុះ អង្កេត ទំនិញ នៅ ផ្សារ ចំបក់ សែន ជ័យ ស្រុក គូលេន ខេត្ត ព្រះវិហារ . រកឃើញ ផលិតផល មួយចំនួន ហួស កាលបរិច្ឆេទ និង បាន ដកហូត ដុត កម្ទេចចោល
( ព្រះវិហារ ) ៖ មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង អាជ្ញាធរដែនដី បាន ចុះ ត្រួតពិនិត្យ គុណភាព ទំនិញ វេចខ្ចប់ ស្រេច តាម ផ្ទះ លក់ ទំនិញ នៅ ផ្សារ ចំបក់ សែន ជ័យ ស្ថិត ក្នុង ភូមិ ស្រយង់ ជើង - ត្បូង ឃុំ ស្រយង់ ស្រុក គូលេន ខេត្ត ព្រះវិហារ ជា លទ្ធផល បាន រកឃើញ ផលិតផល ៥មុខ ហួស កាលបរិច្ឆេទ ព្រមទាំង ដកហូត ដុត កម្ទេចចោល ។
មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន ឲ្យដឹង ថា នៅក្នុង ប្រតិបត្តិការ ចុះ អង្កេត ទំនិញ ដែល កំពុង ដាក់ តាំង លក់ នៅ នៅ ផ្សារ ចំបក់ សែន ជ័យ ស្ថិត ក្នង ភូមិ ចំបក់ សែន ជ័យ ឃុំ ស្រអែម ខាងលើ រួច មក ក្រុមការងារ បាន រកឃើញ ទំនិញ ហួស កាលបរិច្ឆេទ និង ខូច គុណ ចំនួន ៦មុខ រួម មាន៖
មន្រ្តី កាំ កុងត្រូល ខេត្ត ព្រះវិហារ ក៏ បាន អំពាវនាវ ដល់ អាជីវករ អ្នកលក់ដូរ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន និង យកចិត្តទុកដាក់ ឱ្យ បាន ហ្មត់ចត់ មុននឹង ធ្វើចរាចរ ចែកចាយ លក់ដូរ និង ទិញ ទំនិញ ម្ហូប អាហារ ទទួលទាន ដោយ សុវត្ថិភាព មិន ប៉ះពាល់ សុខភាព អ្នកប្រើប្រាស់ ៕ នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ ចាត់ទុក មរណភាព របស់ ឧត្តមសេនីយ៍ ឯក អ៊ុល ណាវី ជា ការបាត់បង់ វីរ ជន ឆ្នើម ដែល បាន បូជា គ្រប់ យ៉ាង ដើម្បី ជាតិ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល នៅ រសៀល ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ផ្ញើ សារលិខិត ចូលរួម រំលែក ទុក្ខ ជូន ចំពោះ លោកស្រី រឿង សុផាន្នី ព្រមទាំង ក្រុមគ្រួសារ នៃ សព ឧត្តមសេនីយ៍ ឯក អ៊ុល ណាវី នាយ រង សេនាធិការ ចម្រុះ មេបញ្ជាការ បញ្ជាការដ្ឋាន ការពារ អាកាស អគ្គ បញ្ជាការ បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០១៩ ដោយ ជំងឺ គាំង បេះដូង ។
នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ បាន បង្ហាញ ក្តី សោក សង្រែង ថា មរណភាព របស់ ឧត្តមសេនីយ៍ ឯក អ៊ុល ណាវី មេបញ្ជាការ បញ្ជាការដ្ឋាន ការពារ អាកាស គឺជា ការបាត់បង់ ឥស្សរជន របស់ ជាតិ ដ៏ ឆ្នើម មួយ រូប ដែល បាន បូជា អស់ កម្លាំង កាយ ចិត្ត បញ្ញា និង ស្មារតី ស្ទើរ ពេញ មួយ ជីវិត ដើម្បី បម្រើ ជាតិ មាតុភូមិ ដោយ ឥត នឿយហត់ និង បាន ចូលរួម យ៉ាង សកម្ម បំផុត ក្នុង ការរំដោះ កម្ពុជា ពី របប ប្រល័យ ពូជសាសន៍ ដណ្តើម បាន មកវិញ នូវ សុខ សន្តិភាព ការពារ សន្តិភាព ការពារ បូរណភាព ទឹកដី ជូន ប្រជាពលរដ្ឋ កម្ពុជា គ្រប់ វិនាទី ។
នាយ ឧត្តមសេនីយ៍ រួម ជាមួយ ក្រុមគ្រួសារ ក៏ បាន សូម សម្តែង នូវ សមាន ចិត្ត ដ៏ ក្រៀមក្រំ ចូលរួម រំលែក ទុក្ខ ដោយ ក្តី សោកស្តាយ អាឡោះអាល័យ បំផុត ជាមួយ ឧត្តមសេនីយ៍ ឯក អ៊ុល ណាវី ព្រមទាំង ក្រុមគ្រួសារ និង សូម បួងសួង ដល់ វត្ថុ ស័ក្តិសិទ្ធិ ក្នុង លោក និង តេជៈ បារមី នៃ ព្រះពុទ្ធ ព្រះធម៌ ព្រះសង្ឃ សូម តាម ជួយ បីបាច់ ថែរក្សា ដល់ ដួង វិញ្ញាណក្ខន្ធ របស់ ឧត្តមសេនីយ៍ ឯក អ៊ុល ណាវី ទៅកាន់ សុគតិភព ជានិច្ច និរន្តរ៍ ត រៀង ទៅ ។
( ក្រចេះ ) ៖ ក្រឡាន និង ណែម គឺជា ចំណី អាហារ មួយ ប្រភេទ ដែល ប្រជាជន ខ្មែរ រស់ នៅក្នុង ភូមិ ថ្ម គ្រែ ឃុំ ថ្ម គ្រែ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ និយម ធ្វើជា លក្ខណៈ គ្រួសារ សម្រាប់ បរិភោគ និង លក់ដូរ ដើម្បី ដោះស្រាយ ផ្នែក ជីវភាព ។
ក្រឡាន និង ណែម ខេត្ត ក្រចេះ ត្រូវបាន គេ ទទួលស្គាល់ ថា គឺជា អាហារ ដែល ពេញនិយម និង មាន រស់ជាតិ ឈ្ងុយ ឆ្ងាញ់ ជា ផលិតផល ពិត ពី ធម្មជាតិ ពិត គ្មាន សារធាតុ ជាតិ គីមី និង ក្លាយជា ទី ពេញនិយម សម្រាប់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ផងដែរ ។ សូម បញ្ជាក់ ថា ក្រឡាន ត្រូវបាន អ្នកភូមិ ថ្ម គ្រែ ដាក់ ឈ្មោះ ឲ្យ ថា ក្រឡាន ថ្ម គ្រែ ដែល ផលិត ដោយ អ្នកភូមិ ថ្ម គ្រែ ឃុំ ថ្ម គ្រែង ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ ។
អ្នកស្រី ណៃ ផេង បាន បញ្ជាក់ ឲ្យដឹង នា ព្រឹក ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ថា រូប គាត់ បាន ប្រកបរបរ ជា អ្នកផលិត ក្រឡាន និង ប្រកបរបរ លក់ ក្រឡាន ចែកចាយ ក្រឡាន និង ណែម ចែកចាយ បន្ត ទៅ រាជធានី ភ្នំពេញ នឹង ចែក បន្ត ដល់ បណ្តា ស្រុក ផ្សេង ៗ អស់ រយៈពេល ជាង ១០ឆ្នាំ មកហើយ ក្រៅពី មុខរបរ ធ្វើ ស្រែ ចំការ ។
ស្ត្រី រូប នោះ បាន បន្ត ទៀត ថា ដើម្បី ធ្វើឲ្យ ក្រឡាន មាន រស់ជាតិ ឈ្ងុយ ឆ្ងាញ់ គឺ គេ ត្រូវ ធ្វើ វា តាម ដំណាក់កាល នីមួយ ៗ និង ត្រូវ ចំណាយ ពេល ពេលវេលា ជិត ៥ ម៉ោង ទើប យកមក បរិភោគ បាន ។
គ្រឿងផ្សំ ក្រឡាន មាន ជាច្រើន មុខមាន ដូច ជា៖ បំពង់ ឬ ស្សី អង្ករ ដំណើប ល្អ សុទ្ធ សណ្ដែក ស្ងោ រួច ខ្ទិះ ដូង និង ស្កសរ ជាដើម ។
ស្ត្រី រូប នោះ បាន បន្ត ទៀត ថា របៀប ដុត ក្រឡាន ឲ្យបាន ឆ្អិន ល្អ មាន រស់ជាតិ ឈ្ងុយ ឆ្ងាញ់ គឺ ប្រើ រយៈពេល ដុត ចាប់ពី ២ ម៉ោង ទៅ២ ម៉ោង កន្លះ ។
អ្នកស្រី ណៃ ផេង ក៏ ជា អ្នកលក់ ក្រឡាន នៅ ចំណោត រថយន្តក្រុង ក្រចេះ ស្ថិត ក្នុង សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ខេត្ត ក្រចេះ បាន បន្ថែម ទៀត ថា គាត់ ប្រកប មុខរបរ លក់ ក្រឡាន ជាង ១០ ឆ្នាំ កន្លងមក ហើយ គាត់ លក់ ១ ថ្ងៃ អស់ ក្រឡាន ជាង ១.០០០ គីឡូក្រាម ដោយ ចែកចាយ បន្ត ទៅ ភ្នំពេញ ជិត ៤០០ គីឡូក្រាម និង ចែកចាយ បន្ត ទៅ តាម បណ្តា ស្រុក ផ្សេង ។
អ្នកស្រី បាន បញ្ជាក់ ថា តាមរយៈ ការប្រកប លក់ ក្រឡាន នឹង បាន ជួយ ឲ គាត់ មាន ជីវភាព កាន់តែ ធូរធារ ប្រសើរឡើង មួយ កំរិត ថែម ទៀត ។
ដោយឡែក ស្រ្តី ម្នាក់ ផ្សេង ទៀត ជា អ្នកលក់ ក្រឡាន មាន ទីតាំង នៅក្បែរ គ្នា បាន បញ្ជាក់ បន្ថែម ថា អ្នក ប្រកប មុខរបរ លក់ ក្រឡាន នៅ ក្រុង ក្រចេះ គឺ មាន ចំនួន ជាង ៤០ តូប ហើយ គាត់ បាន លើកឡើង ថា ក្រោយពី គាត់ ប្រកប មុខរបរ នេះ ជីវភាព គ្រួសារ ក៏ ប្រសើរ ជាង មុន ជាពិសេស ជួយ កាត់បន្ថយ ភាពក្រីក្រ ផង ៕
បញ្ហា ប្រឈម ទាំង ៥នោះ រួម មាន៖ ១៖ បញ្ហា ភាពយឺតយ៉ាវ ដោយសារ កង្វះ មន្រ្តី ធ្វើ ការ . ២. បញ្ហា ស្នើសុំ ច្រក ចេញ ចូល តែ មួយ . ៣. បញ្ហា បាត់បង់ កន្លែង រំដោះ ប្រព័ន្ធ ទឹក និង ប្រព័ន្ធ អគ្គីសនី តាម បណ្តា ដង ផ្លូវ ជាតិ មួយចំនួន . ៤. បញ្ហា ការស្នើសុំ ច្បាប់ សាងសង់ ៥. បញ្ហា ការសុំ អាជ្ងាប័ណ្ណ លក់ និង បញ្ហា ផ្សេង ៗ មួយចំនួន ៕ បុរស ជនជាតិ ចិន លោត ពីលើ អគារ កម្ពស់ ៣ជាន់ សម្លាប់ ខ្លួន ដោយសារ ជំពាក់ បំណុល គេ ច្រើន ពេក នៅ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ មាន ករណី គួរឱ្យ ភ្ញាក់ផ្អើល មួយ ដោយ បុរស ជនជាតិ ម្នាក់ សម្រេចចិត្ត លោត ធ្វើ អត្តឃាត ពីលើ អគារ ជាន់ ទី៣ បណ្តាលឱ្យ ស្លាប់ ភ្លាម ៗ នៅ វេលា ម៉ោង ៥៖៤៥ នាទី ព្រឹក ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ នៅ ចំណុច អាគារ លេខ ៨ ស្ថិត ក្នុង ភូមិ សង្គម ថ្មី ឃុំ ថ្ម ដា ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ ដោយ សង្ស័យ ជំពាក់ បំណុល គេ ច្រើន ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល ជំរុញ ឱ្យ គណៈ គ្រូពេទ្យ ខេត្ត ព្រះវិហារ ត្រូវ សហការ ជាមួយ មន្ទីរ សុខាភិបាល ខេត្ត លុបបំបាត់ ឱ្យ អស់ អ្នក ព្យាបាល ជំងឺ មិន មែន ជា គ្រូពេទ្យ
( ព្រះវិហារ ) ៖ លោក សាស្ត្រាចារ្យ ធា គ្រុយ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ជាតិ បាន ជំរុញ ឱ្យ គណៈ គ្រូពេទ្យ ខេត្ត ព្រះវិហារ ត្រូវ សហការ ជាមួយ មន្ទីរ សុខាភិបាល ខេត្ត ដើម្បី លុបបំបាត់ ឱ្យ អស់ អ្នក ដែល ព្យាបាល ជំងឺ ដែល មិន មែន ជា គ្រូពេទ្យ ។
ការជំរុញ បែប នេះ របស់ លោក ធា គ្រុយ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស ដែល លោក សាស្ត្រចារ្យ បាន អញ្ជើញ ចូលរួម ក្នុង ទិវា អភិវឌ្ឍន៍ វិជ្ជាជីវៈ វេជ្ជសាស្ត្រ បន្ត លើក ទី២ នៅ ខេត្ត ព្រះវិហារ ដោយ មាន ការចូលរួម ពីសំណាក់ លោក វេជ្ជបណ្ឌិត លោក គួង ឡូ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត លោក ប្រធាន គណៈ គ្រូពេទ្យ ខេត្ត ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ទីរ សុខាភិបាល ថ្នាក់ដឹកនាំ មន្ទីរពេទ្យ បង្អែក ១៦ មករា និង គ្រូពេទ្យ ជាច្រើន រូប ទៀត ផងដែរ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក សាស្ត្រាចារ្យ ធា គ្រុយ បាន ថ្លែង ថា គណៈ គ្រូពេទ្យ មាន តួនាទី ច្បាស់លាស់ គឺ គ្រប់គ្រង អ្នក ប្រកប វិជ្ជាជីវៈ ហើយនិង ការប្រកប វិជ្ជាជីវៈ របស់ គ្រូពេទ្យ ដោយ ធានា ថា អ្នក ដែល កំពុង មើល ជំងឺ ជា ការងារ ព្យាបាល គឺ សុទ្ធតែ ជា គ្រូពេទ្យ ។ ទន្ទឹម និង នោះ ត្រូវ លុបបំបាត់ ឱ្យ អស់ អ្នក ដែល ព្យាបាល ជំងឺ មិន មែន ជា គ្រូពេទ្យ ។
ជាមួយគ្នា នោះ រដ្ឋលេខាធិការ បាន បន្ត ថា អ្នក ប្រកប វិជ្ជាជីវៈ ជា គ្រូពេទ្យ ឬ អ្នក ព្យាបាល ជំងឺ ដែល អត់ ចុះបញ្ជីការ ជាមួយ គណៈ គ្រូពេទ្យ និង ទាំង អត់ មានអាជ្ញាបណ្ណ ពី គណៈ គ្រូពេទ្យ អាច ជា បុគ្គល គ្មាន សញ្ញាបត្រ ឬ ជំនាញ ពេទ្យ បង្ក គ្រោះថ្នាក់ ដល់ ជីវិត អតិថិជន . អាច ជា ពេទ្យ មាន សញ្ញាបត្រ ត្រឹមត្រូវ តែ មិន មាន សមត្ថភាព និង កាយសម្បទា មាំ ទាំ ។
លោក សាស្ត្រាចារ្យ ធា គ្រុយ បាន បន្ថែម ទៀត ថា គ្រូពេទ្យ មាន សញ្ញាបត្រ ត្រឹមត្រូវ មាន កាយសម្បទា ត្រឹមត្រូវ តែ ខ្ជីខ្ជា មិន បាន ចុះបញ្ជី ការ មាន អាជ្ញាបណ្ណ ត្រឹមត្រូវ ផ្តល់ ដោយ គណៈ គ្រូពេទ្យ សួរ ថា អាច ប្រកប វិជ្ជាជីវៈ បាន ដែរ ឬ ទេ លោក សង្កត់ធ្ងន់ ថា ទោះ ក្នុង ប្រភេទ ណាមួយ ក៏ដោយ អ្នក ព្យាបាល ជំងឺ ទាំងឡាយ ដែល មិន មានអាជ្ញាបណ្ណ ប្រកប វិជ្ជាជីវៈ ផ្តល់ ដោយ គណៈ គ្រូពេទ្យ អាច ប្រឈម និង ទោសទណ្ឌ ជា ទោស ព្រហ្មទណ្ឌ ។
លោក ក៏ បាន ណែនាំ ឱ្យ គណៈ គ្រូពេទ្យ ខេត្ត ព្រះវិហារ ត្រូវ កាត់បន្ថយ អាត្រា ហួស សុពលភាពអាជ្ញា បណ្ណ នៅក្នុង ខេត្ត ឱ្យ នៅ ចំនួន តិច បំផុត និង ជំរុញ ឱ្យ គណៈ គ្រូពេទ្យ ខេត្ត ត្រូវ ធ្វើ ទិវា អភិវឌ្ឍន៍ វិជ្ជាជីវៈ វេជ្ជសាស្ត្រ យ៉ាងហោចណាស់ ឱ្យ បាន មួយ ឆ្នាំ ២ដង ៕ កងទ័ព ជើងទឹក មូលដ្ឋាន សមុទ្រ មាន ក្តី សោក សង្វេង និង ស្រណោះ អាឡោះអាល័យ ជា ទីបំផុត ចំពោះ មរណភាព របស់ ឧត្តមសេនីយ៍ ឯក អ៊ុល ណា វី
( ព្រះសីហនុ) ៖ កងទ័ព ជើងទឹក មូលដ្ឋាន សមុទ្រ មាន ក្តី សោក សង្វេង សោកស្តាយ ស្រណោះ អាឡោះអាល័យ ជា ទីបំផុត ក្រោយ ទទួលបាន ព័ត៌មាន នៃ មរណភាព របស់ លោក ឧត្តមសេនីយ៍ ឯក អ៊ុល ណាវី នាយ រង សេនាធិការ ចម្រុះ មេបញ្ជាការ បញ្ជាការដ្ឋាន ការពារ អាកាស អគ្គ បញ្ជាការដ្ឋាន នៅ រសៀល ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០១៩ ក្នុង ជន្មាយុ ៦៣ ឆ្នាំ ដោយ រោគា ពាធ ។
កងទ័ព ជើងទឹក មូលដ្ឋាន សមុទ្រ បាន ចាត់ទុក ការបាត់បង់ លោក ឧត្តមសេនីយ៍ ឯក អ៊ុល ណាវី គឺជា ការបាត់បង់ នូវ ធនធាន មនុស្ស មួយ រូប ដ៏ ឆ្នើម ក្នុង ជួរ កងយោធពល ខេមរភូមិន្ទ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត បញ្ញា ស្មារតី ហ៊ាន បូជា សាច់ ស្រស់ ឈាម ស្រស់ ក្នុង បុព្វហេតុ បម្រើ ជាតិ មាតុភូមិ និង ប្រជាជន នៅ គ្រប់ ដំណាក់កាល នៃ ប្រវត្តិសាស្ត្រ និង ជា ការបាត់បង់ ស្វាមី ឪពុក ពូ បង ប្រុស ជីតា ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ។
ក្នុង ពេលវេលា ដ៏ សែន សោកសៅ នេះ កងទ័ព ជើងទឹក មូលដ្ឋាន សមុទ្រ សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ សែន ក្រៀមក្រំ ជា ទីបំផុត ជាមួយ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទូទាំង បញ្ជាការដ្ឋាន ការពារ អាកាស អគ្គ បញ្ជាការដ្ឋាន និង ក្រុមគ្រួសារ លោកស្រី រឿង សុផាន្នី និង សូម បួងសួង ឲ្យ ដួង វិញ្ញាណក្ខន្ធ លោក អ៊ុល ណាវី បាន ទៅកាន់ ឋាន សុគតិភព កុំបី ឃ្លៀងឃ្លាត ៕
ខាងក្រោម នេះ ជាសារ រំលែក ទុក្ខ របស់ កងទ័ព ជើងទឹក មូលដ្ឋាន សមុទ្រ៖
ម្ចាស់ ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ៤២ រូប ទទួល ការបណ្តុះបណ្តាល ពី ការអនុវត្ត អនាម័យ ល្អ និង សុវត្ថិភាព ចំណីអាហារ
( ភ្នំពេញ ) ៖ នាយកដ្ឋាន ឱស ថ ចំណីអាហារ បរិក្ខារ ពេទ្យ និង គ្រឿង សំអាង នៃ ក្រសួង សុខាភិបាល បាន សហការ ជាមួយ វិទ្យាស្ថាន មេគង្គ ដែល ឧបត្ថម្ភ ថវិកា ដោយ ប្រទេស នូវែលសេឡង់ បាន រៀបចំ វគ្គ បណ្តុះបណ្តាល មួយ ស្តីពី ការអនុវត្ត អនាម័យ ល្អ និង សុវត្ថិភាព ចំណីអាហារ ដល់ ម្ចាស់ និង អ្នកគ្រប់គ្រង ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ចំនួន ៤២ រូប ដែល អញ្ជើញ មកពី ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ចំនួន ៣៩ កន្លែង ក្នុង រាជធានី ភ្នំពេញ ។
វគ្គ បណ្តុះបណ្តាល នេះ បាន ធ្វើឡើង នៅ សប្តាហ៍ នេះ ក្រោម អធិបតី លោក ឱសថ បណ្ឌិត ហេង ប៊ុន គន គៀត ប្រធាន នាយកដ្ឋាន ឱស ថ ចំណីអាហារ បរិក្ខារ ពេទ្យ និង គ្រឿង សំអាង នៃ ក្រសួង សុខាភិបាល និង មាន ការចូលរួម ពី លោក ឱសថការី អាំង ហុក ស្រ៊ុន ប្រធាន ការិយាល័យ សុវត្ថិភាព ចំណីអាហារ នៃ ក្រួសួង សុខាភិបាល នៅ សណ្ឋាគារ ភ្នំពេញ ។
ថ្លែង ក្នុង វគ្គ បណ្តុះបណ្តាល នោះ លោក ឱសថការី អាំង ហុក ស្រ៊ុន បាន បង្ហាញ ជូន ដល់ វគ្គ បណ្តុះបណ្តាល អំពី ការផ្ទុះឡើង នៃ ការពុល ចំណីអាហារ ដែល កើតមាន ក្នុង ប្រទេស ដោយ គិត ចាប់តាំងពី ឆ្នាំ ២០១៥ មកដល់ ឆ្នាំ ២០១៩ ដែល ការផ្ទុះឡើង នៃ ការពុល ចំណីអាហារ នេះ បាន បណ្តាលឱ្យ មាន ការខាតបង់ ថវិកា គ្រួសារ និង ថវិកា ជាតិ ជាច្រើន ថែមទាំង ប៉ះពាល់ ដល់ មុខរបរ របស់ បងប្អូន ទៀតផង ។
លោក បាន បន្ថែម ទៀត ថា ដូចនេះ វត្ថុ បំណង នៃ វគ្គ បណ្តុះបណ្តាល ថ្ងៃ នេះ គឺ នឹង បង្ហាញ ជូន ដល់ លោក លោកស្រី ដែល បាន និង កំពុង ប្រកប អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន បាន យល់ដឹង ឱ្យ បាន ស៊ីជម្រៅ នូវ ចំនុច សំខាន់ មួយចំនួន ដើម្បី ចូលរួម ទប់ស្កាត់ និង កាត់បន្ថយ ការពុល ចំណីអាហារ ក៏ ដូចជា ការពង្រីក និង បង្កើន ភ្ញៀវ ទេសចរណ៍ ក្នុង អាជីវកម្ម របស់ ខ្លួន ផងដែរ ។
ថ្លែង ក្នុង ឱកាស នោះ ដែរ លោក ឱសថ បណ្ឌិត ហេង ប៊ុន គៀត បាន ផ្តល់ ជា អនុសាសន៍ ដល់ វគ្គ បណ្តុះបណ្តាល លើ ចំនុច សំខាន់ ៗ មួយចំនួន ដូច ជា៖
ទី១៖ ការជ្រើស ទិញ វត្ថុធាតុ ដើម ដូចជា បន្លែ ត្រី សាច់ គ្រឿង សមុទ្រ គ្រឿងទេស សម្រាប់ រៀបចំ អាហារ ត្រូវ មាន អនាម័យ គុណភាព និង សុវត្ថិភាព និង មាន ប្រភព កន្លែង ផលិត លក់ ច្បាស់លាស់
ទី២៖ ការប្រើប្រាស់ ទឹក ស្អាត សម្រាប់ លាងសំអាត បន្លែ ត្រី សាច់ ចាន ឆ្នាំង សម ស្លាបព្រា ជាដើម ។ បន្ថែម ពី នេះ ទឹក ក៏ ជា វត្ថុធាតុ ដើម មួយ ដ៏ សំខាន់ ក្នុង ការងារ ដាំ ស្ល និង ផលិតកម្ម ផ្សេង ៗ
ទី៣៖ ការថែរក្សាទុកដាក់ វត្ថុធាតុ ដើម និង ផលិតផល ចំណីអាហារ ឱ្យ នៅក្នុង ឃ្លាំង ឬ ក្នុង បន្ទប់ ប្រកបដោយ អនាម័យ មាន បិត ស្លាកសញ្ញា សំគាល់ និង ស្ថិត ក្នុង សីតុណ្ហភាព សុវត្ថិភាព ។
ទី ៥៖ អនាម័យ ទីកន្លែង ចំអិន កន្លែង ភ្ញៀវ បរិភោគ កន្លែង លាងសំអាត ដៃ ជូត សំអាត បន្ទប់ អនាម័យ និង មាន សាប៊ូ លាង ដៃ ក្រដាស ស្អាត ជូត ដៃ ឱ្យ បាន គ្រប់គ្រាន់ និង ចៀសវាង កុំ ឱ្យ សត្វ ចិញ្ចឹម ចូលក្នុង បរិវេណ លក់ដូរ ចំណីអាហារ ។
ទី៦៖ គ្រប់ បុគ្គលិក ពាក់ព័ន្ធ ក្នុង ការងារ រៀបចំ ចំណីអាហារ ចំអិន ចំណីអាហារ បម្រើ ភ្ញៀវ ត្រូវ យល់ដឹង ពី អនាម័យ និង មាន វិន័យ ការងារ ឱ្យ បាន ល្អ ត្រឹមត្រូវ
ទី៧៖ ការទុកដាក់ ចំណីអាហារ បម្រុង ក្នុង ទូទឹកកក ក្នុង កម្រិត សីតុណ្ហភាព សុវត្ថិភាព និង ចំអិន អាហារ ឱ្យ បាន ឆ្អិន ល្អ ។
គួរ បញ្ជាក់ ផងដែរ ថា នៅពេល បញ្ចប់ វគ្គ បណ្តុះបណ្តាល នេះ សិកា្ខ កាម ចំនួន ៤២ រូប បាន ទទួល វិញ្ញាបនបត្រ បញ្ជាក់ ចូលរួម វគ្គ ។ ក្នុង ឱកាស នោះ ដែរ ម្ចាស់ និង តំណាង ភោជនីយដ្ឋាន ចំនួន ១០ផ្សេង ទៀត បាន មក ទទួល វិញ្ញាបនបត្រ បញ្ជាក់ គោលការណ៍ អនុវត្ត អនាម័យ ល្អ ពី ក្រសួង សុខាភិបាល ផងដែរ ៕
រួមគ្នា ទប់ស្កាត់ ជំងឺ គ្រុន ឈាម . មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ បន្ត បើក យុទ្ធនាការ លុបបំបាត់ ជំរក មូស ខ្លា ជា លើក ទី៤ នៅ ស្រុក ក្រូចឆ្មារ
លោក កែវ វណ្ណៈ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ លើកឡើង ថា បន្ទាប់ពី មាន ការចូលរួម យ៉ាង សកម្ម ពី គ្រប់ មជ្ឈដ្ឋាន ទាំងអស់ ក្នុង ការលុបបំបាត់ ប្រភព មូស ខ្លា ជា ភ្នាក់ងារ នៃ ជំងឺ គ្រុន ឈាម ពិសេស ក្រោម ការយកចិត្តទុកដាក់ ពី លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន ធ្វើឱ្យ អត្រា អ្នក កើត ជំងឺ គ្រុន ឈាម បាន ថយចុះ មកវិញ ។
លោក កែវ វណ្ណៈ បាន បញ្ជាក់ ថា ទោះបីជា យ៉ាង នេះ ក្តី មន្ទីរ សុខាភិបាល ខេត្ត រួម ជាមួយ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ នៅតែ បន្ត ចុះ ធ្វើ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ គ្រុន ឈាម អោយ បាន ផុសផុល គ្រប់ ទីប្រជុំជន ទូទាំង ខេត្ត ។
ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ក៏ បាន សំណូមពរ ដល់ អាជ្ញាធរ មូលដ្ឋាន ភូមិ - ឃុំ ឱ្យ ជួយសហការ អប់រំ ទៅដល់ អ្នក ធ្វើ អាជីវកម្ម ដែល ពាក ព័ន្ធ ជុំវិញ ការផ្ទុក សំបក កង់ រថយន្ត កង់ ម៉ូតូ ដែល ជា ប្រភព ចម្លង យ៉ាង ចម្បង បំផុត ជា ភ្នាក់ងារ ចម្លង ធំ ដែល បង្កើត ជម្រក មូស ខ្លា ហើយ បង្កើត ជា បញ្ហា នៃ ជំងឺ គ្រុន ឈាម ជាពិសេស ដើម្បី រួមគ្នា ការពារ សុខភាព បង្ការ ការឈឺ និង ស្លាប់ ដោយសារ ជំងឺ គ្រុន ឈាម ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ៕
ចូលរួម ជួយ សង្រ្គោះ កុមារ កម្ពុជា ! ពលរដ្ឋ ខ្មែរ រស់ នៅ ប្រទេស កាណាដា បន្ដ រៃ អង្គាស ថវិកា បាន ជាង ៣ម៉ឺន ដុល្លារ កាណាដា ដើម្បី ឧបត្ថម្ភ ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា
( ភ្នំពេញ ) ៖ ពលរដ្ឋ ខ្មែរ រស់ នៅ ប្រទេស កាណាដា បាន បន្ដ ឧបត្ថម្ភ ថវិកា ផ្ទាល់ខ្លួន ចំនួន ៣៤. ៦៧០ ដុល្លារ កាណាដា ដើម្បី បន្ដ ជួយ ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ។ ដោយ មាន ការណែនាំ ពី លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ប្រធាន ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន ក្រៅ ប្រទេស ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា ប្រចាំ ប្រទេស កាណាដា បាន នាំយក ថវិកា ដែល បាន មកពី ការរៃ អង្គាស ប្រគល់ ជូន មូលនិធិ គន្ធ បុប្ផា នៅ រសៀល ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
ថវិកា ទាំង នេះ ត្រូវបាន នាំយក ទៅ ប្រគល់ ជូន មូលនិធិ គន្ធ បុប្ផា ដោយ លោក រិន វីរៈ និង ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា ប្រចាំ ប្រទេស កាណាដា និង តំណាង បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ រស់ នៅ ប្រទេស កាណាដា ផ្ទាល់ បាន ប្រគល់ ជូន លោក តំណាង មូលនិធិ គន្ធ បុប្ផា និង លោក វេជ្ជបណ្ឌិត Denis Laurence ប្រធាន មន្ទីរពេទ្យ គន្ធ បុប្ផា ។
ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ៣៖១០នាទី យប់ ចូល ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ ដែល មាន ទីតាំង ស្ថិត នៅ តាម បណ្ដោយ ផ្លូវ ព្រះនរោត្តម សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ។
ក្រោយពេល កើត ហេតុ សមត្ថកិច្ច មូលដ្ឋាន បាន ចុះ មកដល់ ទីតាំង កើត ហេតុ រួច ទាក់ទង ទៅ សមត្ថកិច្ច ជំនាញ ចរាចរណ៍ ដើម្បី ចុះ មក ធ្វើ ការវាស់វែង និង ស្ទូច យក រថយន្ត ខាងលើ ទៅ រក្សាទុក នៅ ការិយាល័យ ចរាចរណ៍ ផ្លូវគោក រាជធានី ភ្នំពេញ ដើម្បី រង់ចាំ ម្ចាស់ រថយន្ត ខាងលើ ទៅ ដោះស្រាយ ទៅ តាម ផ្លូវ ច្បាប់ ៕ ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កំពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ២០ ខែកក្កដា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
កុំ ប្រើប្រាស់ ទូរស័ព្ទ ដៃ នៅពេល បើកបរ ! ស្លាប់ ៣នាក់ និង របួស ២១ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៩ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ . របួស ស្រាល ៩នាក់ និង របួស ធ្ងន់ ១២នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១១លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១១គ្រឿង . រថយន្ត តូច២ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . បត់ ឆ្វេង ស្ដាំ . និង កត្ដាយាន ។
ព្រឹក ស្អែក សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បូកសរុប លទ្ធផល ការងារ កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ និង បំពាក់ កន្សែង យុវជន កាកបាទ ក្រហម
( ភ្នំពេញ ) នៅ ព្រឹក ថ្ងៃសៅរ៍ ៤រោច ខែ អាសាឍ ឆ្នាំ កុរ ឯកស័ក ព .ស២៥៦៣ ត្រូវនឹង ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៩ស្អែក នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នឹង អញ្ជើញ ជា អធិបតី ដ៏ ខ្ពង់ខ្ពស់ ក្នុង ពិធី បូកសរុប លទ្ធផល ការងារ យុវជន កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ ឆ្នាំ ២០១៨ - ២០១៩ និង លើក ទិសដៅ អនុវត្ត បន្ត ។ ក្នុង ពិធី នៅ ថ្ងៃស្អែក នេះ ក៏ មាន ការបំពាក់ កន្សែង យុវជន កាកបាទ ក្រហម កម្ពុជា ផងដែរ ។
សូម បញ្ជាក់ ថា យុវជន កាកបាទ ក្រហម កម្ពុជា សាខា រាជធានី ភ្នំពេញ បាន បង្កើតឡើង នៅ ឆ្នាំ ២០០៤ ដែល មាន យុវជន ប្រមាណ ៨៦០ នាក់ ( នារី ៣៩៩ នាក់ ) នៅ វិទ្យាល័យ ចំនួន ០៤ គឺ៖ វិទ្យាល័យ បាក់ទូក . វិទ្យាល័យ ឥន្ទ្រ ទេវី. វិទ្យាល័យ ជា ស៊ីម សន្ធរ ម៉ុក និង វិទ្យាល័យ វត្ត កោះ ។ នៅក្នុង ឆ្នាំ ២០១៩ នេះ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ បាន ពង្រីក សមាជិក យុវជន ថ្មី ចំនួន ៣.០០០ នាក់ មកពី ២៧វិទ្យាល័យ គោលដៅ ដែល ជា រួម បច្ចុប្បន្ន មាន យុវជន សរុប ប្រមាណ ៤.០៤២ នាក់ ( នារី ២. ០៥០នាក់ ) ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ ស្ថានការណ៍ ទូទាំង សកលលោក និង រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ផ្សេង ៗ ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ បុរស ជនជាតិ អាមេរិក ត្រូវ ជាប់ គុក គ្មាន ថ្ងៃ ចេញ ដោយសារ ការសម្លាប់ យ៉ាង ព្រៃផ្សៃ លើ នារី ជា បញ្ញា វន្ត ចិន ម្នាក់ ។
៣៖ ទឹក ជំនន់ វាយលុក បួន ប្រទេស នៅ អាស៊ី ខាងត្បូង . មនុស្ស ស្លាប់ កើន ដល់ ជាង ២៣០ នាក់ ខណៈ រាប់ លាន នាក់ កំពុង រង ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ។
៤៖ អាជ្ញាធរ ជប៉ុន បញ្ជាក់ អត្តសញ្ញាណ ជនសង្ស័យ ដែល ដុត អគារ សម្លាប់ មនុស្ស ៣៣ នាក់ ។
តាម ការស្ទាបស្ទង់ ក្នុង ជំហាន ដំបូង កម្រិត រញ្ជួយ ដី នេះ មាន កម្រិត ៥. ១រិច ទ័រ ។
វិធានការ នេះ នឹង អនុវត្ត នៅ ទូទាំង ប្រទេស ចាប់ពី ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ ដោយ ធ្វើ ការឃាត់ តម្រូវ ឲ្យ រក មួក សុវត្ថិភាព មក ពាក់ រួច ទើប អនុញ្ញាតឲ្យ បន្ត ដំណើរ ដោយ មិន ពិន័យ រយៈ ពេល ១ ខែ គិត ពី ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ ។
វិធានការ នេះ ជា ការឆ្លើយតប ទៅនឹង កំណើន ជនរងគ្រោះថ្នាក់ ចរាចរណ៍ ដែល ភាគ ច្រើន មាន ដល់ ទៅ ៧៦ % ជា អ្នក ជិះ ម៉ូតូ ក្នុង នោះ មាន ចំនួន ៧៩ % មិន ពាក់ មួក សុវត្ថិភាព ពេល មាន គ្រោះថ្នាក់ ហើយ ដែល ត្រូវ រង ការ ប៉ះទង្គិច ក្បាល ។
ជាមួយគ្នា នេះ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត អគ្គ ស្នងការ នគរបាល ជាតិ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ តាម ដងផ្លូវ ពិសេស អ្នកបើកបរ ម៉ូតូ និង អ្នក រួម ដំណើរ សូម គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ពាក់ មួក សុវត្ថិភាព គ្រប់ ពេល និង គ្រប់ ទីកន្លែង ដើម្បី ការពារ ភាព ប៉ះទង្គិច ក្បាល ឬ ការពារ ជីវិត អ្នក ពី គ្រោះថ្នាក់ ចរា ចរណ៍ ៕ អ្នកតំណាងរាស្ត្រ សួស យ៉ារ៉ា នាំ អំណោយ ចែកជូន ពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ ១៣ គ្រួសារ នៅ ស្រុក ត្បែងមានជ័យ
( ព្រះវិហារ ) ៖ លោក សួស យ៉ារ៉ា អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រះវិហារ នៅ រសៀល ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ ក្រុមការងារ រួម ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ មក ចែកជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ រលំ ផ្ទះ រ បើក ដំបូល ចំនួន ១៣គ្រួសារ នៅ ភូមិ ពោធិ៍ ឃុំ ពោធិ៍ ស្រុក ត្បែងមានជ័យ ខេត្ត ព្រះវិហារ ។
នៅក្នុង ឱកាស នោះ អ្នកតំណាងរាស្ត្រ សួស យ៉ារ៉ា បាន សម្តែង នូវ ការចូលរួម សោកស្តាយ ចំពោះ ហេតុការណ៍ គ្រោះ ធម្មជាតិ ខ្យល់ កន្ត្រាក់ ដែល បណ្តាលឱ្យ ផ្ទះ បងប្អូន ប្រជាពលរដ្ឋ រង ការខូចខាត ។
ជាមួយគ្នា នោះ លោក ក៏ បាន លើកទឹកចិត្ត ដល់ បងប្អូន ប្រជាពលរដ្ឋ រងគ្រោះ ទាំងអស់ គ្នា កុំ មាន ការអស់ សង្ឃឹម ឱ្យ សោះ ព្រោះ អាជ្ញាធរដែនដី និង សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា មិន ទុក ឱ្យ បងប្អូន ណា ម្នាក់ រស់ ក្នុង ភាពឯកោរ គ្មាន ទីពឹង នោះ ទេ ។
អំណោយ ដែល ត្រូវ ចែកជូន នៅ ពេល នេះ រួម មាន ប្រជាពលរដ្ឋ រងគ្រោះ រលំ ផ្ទះ ទាំងស្រុង ចំនួន ៤គ្រួសារ បាន ទទួល អំណោយ ពី សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នូវ ថវិកា ២០ ម៉ឺន រៀល មី ២កេស អង្ករ ៥០ គីឡូក្រាម ធុង ទឹក ៥០លីត្រ ចំនួន ១ ។
អភិបាល ខេត្ត សៀមរាប៖ ការសិក្សា ពេញ មួយ ជីវិត ជា ប្រធានបទ មួយ ដ៏ សំខាន់ សម្រាប់ ការអប់រំ
( សៀមរាប ) ៖ លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប លើកឡើង ថា ក្នុង សទវត្ស ទី ២១ នេះ ការសិក្សា ពេញ មួយ ជីវិត ជា ប្រធានបទ ដ៏ សំខាន់ សម្រាប់ ការអប់រំ ឆ្លើយតប ទៅនឹង បម្រែបម្រួល នៃ តម្រូវការ ទីផ្សារ ការងារ ។
ការលើកឡើង បែប នេះ របស់ លោក ទៀ សីហា បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បិទ វគ្គ បណ្ដុះបណ្ដាល គ្រូ បឋមសិក្សា « ១២+ ២» ជំនាន់ ទី ៣៦ ចំនួន ១៩៩ នាក់ ដែល មកពី ខេត្ត សៀមរាប ចំនួន ១៥៤ នាក់ និង ខេត្ត ឧត្ដរ មានជ័យ ៤៥ នាក់ នៃ សាលា គរុកោសល្យ និង វិក្រឹត ការ ខេត្ត សៀមរាប ។
អភិបាល ខេត្ត សៀមរាប បាន ថ្លែង ថា ដោយ ហេតុផល នេះ ទើប រាជ រដ្ឋាភិបាល អាណត្តិ ទី៦ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី បាន ជំរុញ ឱ្យ បោះជំហាន ទៅ រក ដំណាក់កាល ថ្មី មួយ ទៀត នៃ ការអភិវឌ្ឍ តាមរយៈ ក្រសួង អប់រំ យុវជន និង កីឡា បាន អនុវត្ត កំណែទម្រង់ តាម គ្រប់ រូបភាព និង ដាក់ចេញ នូវ គោល នយោបាយ អប់រំ ផ្ដោត លើ សមាសភាព ចំនួន ៥ គឺ គុណធម៌ សមធម៌ បរិយាប័ន្ន អប់រំ ពេញ មួយ ជីវិត និង ការអប់រំ សម្រាប់ ទាំងអស់ គ្នា ។
ដើម្បី ឆ្លើយតប ទៅនឹង គោល នយោបាយ អាទិភាព និង ការអភិវឌ្ឍ ប្រទេស ជាតិ របស់ រាជ រដ្ឋាភិបាល និង ផែនការ យុទ្ធសាស្ត្រ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា លោក ក្នុង នាម ក្រុមប្រឹក្សា គណៈ អភិបាល ខេត្ត គឺ បាន គាំទ្រ យ៉ាង ពេញ ទំហឹង នូវ រាល់ សកម្មភាព ការងារ របស់ មន្ទីរ អប់រំ យុវជន និង កីឡា ជាពិសេស សាលា គរុកោសល្យ និង វិក្រឹត ការ ខេត្ត គ្រឹះស្ថាន សិក្សា ដ៏ សំខាន់ ក្នុង ការបណ្ដុះបណ្ដាល គ្រូ បឋមសិក្សា ។
បន្ថែម ពី នេះ លោក ទៀ សីហា បាន បង្ហាញ ការជឿជាក់ ថា បុគ្គលិក អប់រំ ទាំងអស់ លោកគ្រូ អ្នកគ្រូ ពិសេស ប្អូន ៗ ក្មួយ ៗ គរុសិស្ស ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ អភិវឌ្ឍ បន្ត លើ ចំណេះដឹង វិជ្ជាជីវៈ ការប្រតិបត្តិ វិជ្ជាជីវៈ ការសិក្សា វិជ្ជាជីវៈ និង សីលធម៌ វិជ្ជាជីវៈ ដើម្បីឱ្យ មាន គុណ វុឌ្ឍិ និង បុគ្គលិក អប់រំ នៃ ប្រទេស ក្នុង តំបន់ និង ដើម្បី ប្រយោជន៍ របស់ កុមារ ។
លោក បាន បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា មគ្គុទេសក៍ ដ៏ ឆ្នើម បាន កំណត់ នូវ ផែនការ យុទ្ធសាស្ត្រ ការអភិវឌ្ឍ ប្រទេសជាតិ ឆ្នាំ ២០១៩ - ២០២៣ ក្នុង អាណត្តិ ទី៦ ដែល បាន បន្ត ពី សមិទ្ធផល ផែនការ យុទ្ធសាស្ត្រ ២០១៣ - ២០១៨ ។ ដើម្បី សម្រេច កិច្ចការ សំខាន់ ៗ រួម មាន៖
ទី ១៖ វាយតម្លៃ អំពី លទ្ធផល រួម និង បញ្ហា ប្រឈម ចម្បង ៗ ដែល កើត មាន ឡើង នៅក្នុង ការអនុវត្ត ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ជាតិ ២០១៣ - ២០១៨ ក្នុង អាណត្តិ ទី៥ ។
ទី ២៖ កំណត់ នូវ បណ្ដា វិធានការ គោល នយោបាយ របស់ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ ក្នុង គោលដៅ អនុវត្ត គោល នយោបាយ អាទិភាព របស់ រាជ រដ្ឋាភិបាល និង គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ កម្ពុជា ដើម្បី ស្ថិរភាព កំណើន សេដ្ឋកិច្ច កាត់បន្ថយ ភាពក្រីក្រ និង លើកកម្ពស់ កម្រិត ជីវភាព រស់ នៅ របស់ ប្រជាជន និង ឆ្ពោះទៅ សម្រេចបាន នូវ ស្ថានភាព នៃ ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ ក្នុង ឆ្នាំ ២០៣០ និង ជា ប្រទេស អភិវឌ្ឍន៍ នៅ ឆ្នាំ ២០៥០ ខាងមុខ នេះ ។
( វ៉ាស៊ីនតោន ) ៖ គេហទំព័រ អន្តរជាតិ Military បាន រាយការណ៍ ថា ប្រព័ន្ធ អាវុធ ថ្មី មួយ សម្រាប់ ធ្វើ សង្រ្គាម អេឡិចត្រូនិច ប្រឆាំង នឹង យន្ដហោះ ដ្រូន របស់ កង នាវា អាមេរិក អាច ត្រូវបាន គេ ប្រើប្រាស់ ក្នុង ការបាញ់ ទម្លាក់ យន្ដហោះ ដ្រូន អ៊ីរ៉ង់ កាលពី ថ្ងៃព្រហស្បតិ៍ ទុក ជា ការធ្វើតេស្ដ ។ នេះ បើ តាម ការដកស្រង់ ចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នៅ ល្ងាច ថ្ងៃសុក្រ ទី១៩ ខែកក្កដា ឆ្នាំ ២០១៩ ។
ប៉ុន្តែ ទីក្រុង តេហេរ៉ង់ ទាត់ចោល ការអះអាង នេះ ដោយ និយាយ ថា USS Boxer អាច ច្រឡំ បាញ់ ទម្លាក់ យន្ដហោះ ដ្រូន របស់ ខ្លួន ឯង ដ្បិត យន្ដហោះ ដ្រូន អ៊ីរ៉ង់ ទាំងអស់ ស្ថិត នៅក្នុង បន្ទាយ យ៉ាង មាន សុវត្ថិភាព ៕ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ប្រកាស ប្រឡង ជ្រើសរើស សិស្ស និស្សិត និង មន្ត្រីរាជការ ស៊ីវិល ឲ្យ ចូល បម្រើការ ក្នុង ក្របខណ្ឌ ចំនួន ៤២ កន្លែង សម្រាប់ ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ប្រកាស ជ្រើសរើស សិស្ស និស្សិត និង មន្ត្រីរាជការ ឲ្យ ចូល បម្រើ ការ ក្នុង ក្របខណ្ឌ ក្រសួង ចំនួន ៤២ កន្លែង ដោយ ចែកចេញ ទៅ តាម មុខជំនាញ និង ឯកទេស ផ្សេង ៗ ដោយ ចាប់ ទទួល ពាក្យ ពី ថ្ងៃ នេះ តទៅ រហូតដល់ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០១៩ ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្ដីជូនដំណឹង របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ទាំង ស្រុង៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៩ ខែកក្កដា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ជិត ១.៦០០ គ្រឿង និង ផាក ពិន័យ ជាង ១ ពាន់ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៥.៤៤៨ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ១.៥៨០ គ្រឿង ( ម៉ូតូ ៧២ %) អប់រំ៤៤៩ គ្រឿង និង ផាក ពិន័យ ១. ១៣១ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ១៩ ខែកក្កដា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ៣. ៣៣៩ គ្រឿង . អប់រំ២៦២ គ្រឿង និង ផាក ពិន័យ ៨៦៥ គ្រឿង ។
សម្រាប់ លទ្ធផល នៃ ការត្រួតពិនិត្យ រយៈពេល ១៩ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ នគរបាល បាន ត្រួតពិនិត្យ យានយន្ត ចំនួន ៩៩.១២៣ គ្រឿង រកឃើញ យានយន្ត ល្មើស ២៤.៤៨៧ គ្រឿង ( ម៉ូតូ ៧២ %) ក្នុង នោះ អប់រំ៦.៧៤២ គ្រឿង និង ផាក ពិន័យ ១៧.៧៤៥ គ្រឿង ( ម៉ូតូ ៧៦%) ផងដែរ ៕ អគ្គ នាយកដ្ឋាន ពន្ធដារ ផ្សព្វផ្សាយ ពី ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ ចំពោះ សហគ្រាស ប្រកប អាជីវកម្ម ក្នុង វិស័យ កសិកម្ម
លោក វ៉ាន់ ពុទ្ធិពល បាន ជម្រាប អង្គ សិក្ខាសាលា ថា គោលបំណង នៃ សិក្ខាសាលា ថ្ងៃ នេះ គឺ ដើម្បី ផ្សព្វផ្សាយ នូវ បទប្បញ្ញត្តិ ដែល ពាក់ព័ន្ធ នឹង ការលើកទឹកចិត្ត ផ្នែក ពន្ធដារ ដល់ សហគ្រាស ប្រកប អាជីវកម្ម ក្នុង វិស័យ កសិកម្ម ដូច ជា៖
១៖ កាអនុគ្រោះ នូវ អាករ លើ តម្លៃ បន្ថែម ជា បន្ទុក របស់ រដ្ឋ
ចំពោះ ការនាំចូល និង ការផ្គត់ផ្គង់ ទំនិញ មួយចំនួន ដូចជា ជី គ្រប់ ប្រភេទ ពូជ ដំណាំ គ្រប់ ប្រភេទ ប សុឱ សថ ចំណី សត្វ និង ចំណី បន្ថែម ពូជ សត្វ គ្រប់ ប្រភេទ គ្រឿងយន្ត និង ឧបករណ៍ កសិកម្ម ប្រភេទ ។
២៖ ការលើកលែង អាករ លើ តម្លៃ បន្ថែម លើ ការផ្គត់ផ្គង់ ផលិតផល កសិកម្ម មិន ទាន់ កែច្នៃ
ផ្តល់ ការលើកលែង អាករ លើ តម្លៃ បន្ថែម លើ ការផ្គត់ផ្គង់ ផលិតផល កសិកម្ម មិន ទាន់ កែច្នៃ ដែល មាន ដូចជា ឫ ស មើម ដើម សំបក ផ្លែ ផ្កា ឬ គ្រាប់ នៃ រុក្ខជាតិ ដែល បាន មកពី ការធ្វើ កសិកម្ម ដាំដុះ ទោះ មិន ទាន់ កិន ឬ កិន បំបែក រួចហើយ ក្តី និង ដែល មិន ទាន់ ត្រូវបាន យក ទៅ កែច្នៃ ជា ផលិតផល ផ្សេង ។ ផលិតផល កសិកម្ម មិន ទាន់ កែច្នៃ ក៏ រួមបញ្ចូល នូវ គ្រាប់ ធញ្ញជាតិ នានា រួមទាំង ស្រូវ អង្ករ ផងដែរ ។
៣៖ ការលើកទឹកចិត្ត អាករ លើ តម្លៃ បន្ថែម ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណូល ពន្ធ អប្បបរមា ពន្ធ កាត់ទុក លើ សេវា
ក៖ អាករ លើ តម្លៃ បន្ថែម ជា បន្ទុក របស់ រដ្ឋ
សហគ្រាស ដែល ផ្គត់ផ្គង់ ទំនិញ ឬ សេវា ឱ្យ ដល់ សហគ្រាស ផលិត ផ្គង់ ផ្គត់ ក្នុង ស្រុក ឬ នាំចេញ ស្រូវ អង្ករ ពោត សណ្តែក ម្រេច ដំឡូង មី គ្រាប់ ស្វាយចន្ទី និង ជ័រ កៅស៊ូ អាករ លើ តម្លៃ បន្ថែម ជា បន្ទុក របស់ រដ្ឋ គិត ចាប់ពី ខែមីនា ឆ្នាំ ២០១៩ ដល់ ដំណាច់ ឆ្នាំ ២០២៣ និង ត្រូវបាន អនុញ្ញាត ឥណទាន អាករ លើ ធាតុ ចូល ដែល ទាក់ទិន នឹង ការផ្គត់ផ្គង់ នេះ ។
ខ៖ ការព្យួរ ទុក ជា បណ្តោះអាសន្ន នូវ ការបង់ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណូល
សហគ្រាស ផលិត ផ្គង់ ផ្គត់ ក្នុង ស្រុក ឬ នាំចេញ ស្រូវ អង្ករ ពោត សណ្តែក ម្រេច ដំឡូង មី គ្រាប់ ស្វាយចន្ទី និង ជ័រ កៅស៊ូ ត្រូវបាន ព្យួរ ទុក ជា បណ្តោះអាសន្ន នូវ ការបង់ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណូល ប្រចាំ ខែ សម្រាប់ រយៈពេល ០៥ ឆ្នាំ គិត ចាប់ពី ខែមករា ឆ្នាំ ២០១៩ រហូតដល់ ដំណាច់ ឆ្នាំ ២០២៣ ។
គ៖ ការលើកលែង ពន្ធ អប្បបរមាស ហគ្រាស ផលិត ផ្គង់ ផ្គត់ ក្នុង ស្រុក ឬ នាំចេញ ស្រូវ អង្ករ ពោត សណ្តែក ម្រេច ដំឡូង មី គ្រាប់ ស្វាយចន្ទី និង ជ័រ កៅស៊ូ ត្រូវបាន លើកលែង ពន្ធ អប្បបរមា គិត ចាប់ពី ឆ្នាំ ២០១៩ ដល់ ឆ្នាំ ២០២៣ ក្នុង ករណី ដែល បាន កាន់ បញ្ជី គណនេយ្យ ត្រឹមត្រូវ ស្រប តាម ច្បាប់ និង បទប្បញ្ញត្តិ ជាធរមាន ។
ឃ - ការរួច កាតព្វកិច្ចកាត់ ទុក ប្រាក់ ពន្ធ លើ ការទូទាត់ សេវា
សហគ្រាស ផលិត ផ្គង់ ផ្គត់ ក្នុង ស្រុក ឬ នាំចេញ ស្រូវ អង្ករ ពោត សណ្តែក ម្រេច ដំឡូង មី គ្រាប់ ស្វាយចន្ទី និង ជ័រ កៅស៊ូ ត្រូវបាន អនុគ្រោះ ឱ្យ រួច ពី កាតព្វកិច្ចកាត់ ទុក ប្រាក់ ពន្ធ លើ ការទូទាត់ ចំពោះ ការផ្គត់ផ្គង់ សេវា ដោយ បុគ្គល មិន ស្ថិត ក្នុង របប ស្វ័យប្រកាស គិត ចាប់ពី ខែមីនា ឆ្នាំ ២០១៩ ដល់ ដំណាច់ ឆ្នាំ ២០២៣ ។
* ស្នើសុំ វិញ្ញាបនបត្រ អាករ លើ តម្លៃ បន្ថែម ជា បន្ទុក របស់ រដ្ឋ ពី អគ្គ នាយកដ្ឋាន ពន្ធដារ ដែល មាន សុពលភាព ០១ ឆ្នាំ ម្តង * ត្រូវ ភ្ជាប់ ជាមួយ លិខិត ប្រកាស អាករ លើ តម្លៃ បន្ថែម ប្រចាំ ខែ នូវ បញ្ជី ឈ្មោះ សហគ្រាស ដែល ផ្គត់ផ្គង់ ទំនិញ ឬ សេវា ជាបន្ទុក របស់ រដ្ឋ * ត្រូវ កាន់ បញ្ជី គណនេយ្យ ស្រប តាម ច្បាប់ និង បទប្បញ្ញត្តិ ជាធរមាន និង ប្រកាស បង់ ពន្ធ អាករ ដទៃ ទៀត ជាធរមាន ទៅ តាម កាល កំណត់ ។
៤៖ ការលើកលែង ពន្ធ លើ ប្រាក់ ចំណូល សម្រាប់ សហគ្រាស ធុន តូច និង មធ្យម ក្នុង វិស័យ អាទិភាព ( ផ្នែក កសិកម្ម )
សហគ្រាស ធុន តូច និង មធ្យម ក្នុង វិស័យ អាទិភាព ចំពោះ ផលិតផល កសិកម្ម ឬ កសិ- ឧស្សាហកម្ម ត្រូវ ទទួលបាន ការលើកទឹកចិត្ត ពន្ធ លើ ប្រាក់ ចំណូល ដូច ខាងក្រោម៖
* ៣ ឆ្នាំ ចាប់ពី ថ្ងៃ ចុះបញ្ជី ឬ ធ្វើ បច្ចុប្បន្នភាព រួចរាល់ គិត ពី ខែតុលា ឆ្នាំ ២០១៨ ត ទៅ * ៥ ឆ្នាំ ចាប់ពី ថ្ងៃ ចុះបញ្ជី ឬ ធ្វើ បច្ចុប្បន្នភាព រួចរាល់ គិត ពី ខែតុលា ឆ្នាំ ២០១៨ត ទៅ ដែល បំពេញ លក្ខខណ្ឌ ណា មួយ ដូច ខាងក្រោម៖ - ប្រើ វត្ថុធាតុ ដើម ក្នុង ស្រុក ចាប់ពី ៦០ ថ្ងៃ ឡើង ទៅ ឬ - បង្កើន ចំនួន និយោជិត បន្ថែម យ៉ាងតិច ២០% ឬ - មាន ទីតាំង ក្នុង តំបន់ ប្រមូលផ្តុំ សហគ្រាស ធុន តូច និង មធ្យម ៕
