( កំពង់ឆ្នាំង ) ៖ ជា រើយ ៗ មាន ក្រុម ឈ្មួញ ដី ខិល ខូច មួយចំនួន តូច តែងតែ បង្ក ព្យុះភ្លៀង ខិតខំ រិះរក គ្រប់ មធ្យោបាយ លួច រំលោភ ដី របស់ រដ្ឋ ទុក លក់ បន្ត ។ ប្រជាពលរដ្ឋ មូលដ្ឋាន បាន អំពាវនាវ ដោយ ស្នើសុំ លោក ឈួរ ច័ន្ទ ឌឿន អភិបាល ខេត្ត កំពង់ឆ្នាំង ជួយ ត្រួតពិនិត្យ និង ទប់ស្កាត់ ទាន់ ពេលវេលា ផង ។
សេចក្ដីរាយការណ៍ ពី ប្រជាពលរដ្ឋ មូលដ្ឋាន បាន ឲ្យ ភ្នាក់ងារ ព័ត៌មាន Fresh News ដឹង ថា មួយ រយៈ ចុងក្រោយ នេះ ការរំលោភបំពាន ដីធ្លី របស់ រដ្ឋ ធ្វើជា កម្មសិទ្ធិ កំពុង ក៏ ក្រើក យ៉ាង ខ្លាំង ។ ដើម្បី បញ្ជៀស នូវ ការិះគន់ និង កន្ទេល ធំ បន្លំ ដេក អភិបាល ខេត្ត កំពង់ឆ្នាំង និង ប្រធាន មន្ទីរ កសិកម្ម ខេត្ត គួរតែ ស៊ើបអង្កេត ស្រាវជ្រាវ និង វែក រក មុខ ជនល្មើស មក ដាក់ ទោស តាម ច្បាប់ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ក្រោយ ទទួលបាន ព័ត៌មាន រួច មក លោក បាន ចាត់ ឲ្យ មន្រ្តី និង សមត្ថកិច្ច ចុះ ទៅ ទប់ស្កាត់ និង បាន បញ្ឈប់ ការឈូសឆាយ ដី ទាំងនោះ ហើយ ។ បើ តាម លោក អភិបាល ខេត្ត កំពង់ឆ្នាំង ករណី នេះ ផ្តើម ចេញ ពី អាជ្ញាធរ មូលដ្ឋាន បាន ឲ្យ ក្រុម ឈ្មួញ ឈូសឆាយ ធ្វើ ផ្លូវ ប៉ុន្តែ ថ្នាក់ ខេត្ត មិន បាន ដឹង នោះ ឡើយ ។
ជាក់ស្តែង កាលពី ព្រឹក ថ្ងៃទី ៧ ខែកក្កដា ឆ្នាំ ២០១៩ ក្រុម អ្នកសារព័ត៌មាន បាន ប្រទះឃើញ គ្រឿងចក្រ កំពុង ធ្វើ សកម្មភាព ឈូសឆាយ និង រំលោភបំពាន យក ដី ព្រៃ សហគមន៍ ស្ថិត ក្នុង ឃុំ ប្រស្នឹប ស្រុក រលាប្អៀរ ។ បើ យោង សេចក្ដីរាយការណ៍ ពី ប្រជាពលរដ្ឋ ក្រុម ឈ្មួញ ដី ឈួស ឆាយ នេះ គឺជា ដី ព្រៃ បម្រុងទុក អចិន្ត្រៃយ៍ របស់ រដ្ឋ ជាង ១០០០ ហិកតា ដោយ ក្រុម ឈ្មួញ ដី ប្រើ រូបភាព និង លេស ថា ធ្វើ ផ្លូវ ។
ចំពោះ វិធានការ បន្ត តាម ផ្លូវ ច្បាប់ នោះ លោក ឈួរ ច័ន្ទ ឌឿន មិន ទាន់ បាន ប្រាកដ នៅឡើយ ទេ ដោយ រង់ចាំ ពិភាក្សា ជាមួយ មន្រ្តី ជំនាញ និង សមត្ថកិច្ច ពាក់ព័ន្ធ សិន តើ ត្រូវ បញ្ជូន សំណុំរឿង ទៅ តុលាការ ឬ យ៉ាងណា ខណៈ ក្រុម ឈ្មួញ ទាំងនោះ ត្រូវបាន អាជ្ញាធរ ដឹង អស់ ហើយ ។
សេចក្ដីរាយការណ៍ បញ្ជាក់ ថា ដី ព្រៃ សហគមន៍ នៅ ចំណុច នោះ មាន ប្រមាណ ជាង ១០០០ ហិកតា ស្ថិត នៅក្នុង ៣ភូមិ ភូមិ ត្រពាំង ពិល . ភូមិ ប្រស្និប . ភូមិ ស្អំ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ហើយក៏ ជា ដី ដែល ជា ចំណី អារម្មណ៍ យ៉ាង ខ្លាំង របស់ ក្រុម ជន ខិលខូច មួយ ក្ដាប់ តូច ៕
( កណ្ដាល - ស្វាយរៀង ) ៖ ករណី ឃាតកម្ម សម្លាប់ ប្លន់ យក រថយន្ដ ពី អ្នកបើក រថយន្ដ តាក់ស៊ី ហើយ យក សព ទៅ ផ្លុង ចោល នៅ តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៨ ( ស្ពាន ព្រែក រូង ) ស្ថិត នៅ ភូមិ អន្លង់ ឃុំ ព្រែក តា មាក់ ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្តាល ត្រូវ កម្លាំង កងរាជអាវុធហត្ថ បើក ប្រតិបត្តិការ ស្រាវជ្រាវ និង ឈានដល់ ការបង្ក្រាប បាន ជន ដៃ ដល់ ៣នាក់ ក្នុង ចំណោម បក្ខពួក ៤នាក់ រហូតដល់ ខេត្ត ស្វាយរៀង ។
របាយការណ៍ អាវុធហត្ថ ខេត្ត កណ្ដាល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ០៨ ខែកក្កដា ឆ្នាំ ២០១០៩ នេះ បាន ឲ្យដឹង ថា ប្រតិបត្តិការ នេះ ធ្វើឡើង ដោយ កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល សហការ ជាមួយ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស កងរាជអាវុធហត្ថ ខេត្ត ព្រៃវែង កងរាជអាវុធហត្ថ ខេត្ត ស្វាយរៀង ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ។
ដោយឡែក នៅ កន្លែង កើត ហេតុ សមត្ថកិច្ច ជំនាញ និង អាជ្ញាធរ ភូមិ ឃុំ បាន ធ្វើ ការត្រួតពិនិត្យ វត្ថុតាង ជុំវិញ កន្លែង កើត ហេតុ និង បាន ធ្វើ កោសល្យវិច័យ លើ សាកសព គឺ៖ មាន ខ្សែភ្លើង ពណ៌ លឿង ប្រវែង ២. ៦៤ម៉ែត្រ ចង ក ដៃ ទាំង សងខាង ចំនួន ៣ជុំ និង មាន ខ្សែក្រវ៉ាត់ ប្រវែង១.០៩ ម៉ែត្រ ។ តាម ការសន្និដ្ឋាន គឺជា ករណី ឃាតកម្ម សាកសព សមត្ថកិច្ច ជំនាញ អាជ្ញាធរ មូលដ្ឋាន ប្រគល់ ជូន ក្រុមគ្រួសារ យក ធ្វើ បុណ្យ តាម ប្រពៃណី ។
ក្រោយពី កម្លាំង ជំនាញ កំណត់ អត្តសញ្ញាណ ជនរងគ្រោះ បាន ហើយ ទើប ឈាន កំណត់ បាន មុខ សញ្ញា ជនសង្ស័យ ហើយ បាន ធ្វើ ការពន្លាត ដែនដី សមត្ថកិច្ច សហការ ជាមួយ កម្លាំង ជំនាញ ស្នងការដ្ឋាន ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ព្រៃវែង និង ខេត្ត ស្វាយរៀង ក្រោម ការសម្របសម្រួល ពី លោក ព្រះរាជអាជ្ញា ស្តី ទី អម សាលាដំបូង ខេត្ត កណ្តាល និង លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ស្វាយរៀង ។
រហូត បង្រ្កាប ជាក់ស្តែង កម្លាំង បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ០៣ នាក់ ជា បន្តបន្ទាប់ ក្នុង ចំណោម បក្ខពួក ០៤ នាក់ នៅ យប់ ថ្ងៃទី ០៣ ខែកក្កដា ឆ្នាំ ២០១៩ នៅ ចំណុច ភូមិ បាវិត កណ្តាល សង្កាត់ បាវិត ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។
បន្ទាប់ពី បញ្ចប់ ការសួរនាំ ជនសង្ស័យ ដៃ ដល់ ទាំង ៣នាក់ នេះ ត្រូវបាន អាវុធហត្ថ ខេត្ត កណ្ដាល ដែល ជា ម្ចាស់ ករណី បាន បញ្ជូន ទៅកាន់ សាលាដំបូង ខេត្ត ដើម្បី បន្ដ នីតិវិធី ហើយ នៅ ល្ងាច ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០១៩ តុលាការ បាន សម្រេច ចេញ ដីកា បង្គាប់ ឲ្យ ឃុំ ខ្លួន ដាក់ ពន្ធនាគារ ៕ អាជ្ញាធរ ចាប់ផ្តើម ចេញ វិធានការក្តៅ និង បាន ស្ទួច រថយន្ដ ចំនួន ១៥ គ្រឿង ដែល ចត លើ ផ្លូវ គ្មាន សណ្តាប់ធ្នាប់ នៅ ក្រុង ព្រះសីហនុ . រថយន្ត យកមក រក្សាទុក ដើម្បី ផាក ពិន័យ និង ព្រមាន ឲ្យ រាងចាល
( ព្រះសីហនុ) ៖ រថយន្ដ ចំនួន ១៥ គ្រឿង ដែល ចត លើ ផ្លូវ គ្មាន សណ្តាប់ធ្នាប់ ត្រូវបាន អាជ្ញាធរ និង កម្លាំង សមត្ថកិច្ច ក្រុង ព្រះសីហនុ យកមក រក្សាទុក នៅ សាលាក្រុង ដើម្បី ផាក ពិន័យ និង ព្រមាន ឲ្យ រាងចាល ។ នេះ បើ តាម ការបញ្ជាក់ របស់ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ ប្រាប់ មក អង្គភាព ព័ត៌មាន Fresh News នា ព្រឹក ថ្ងៃទី ០៨ ខែកក្កដា ឆ្នាំ ២០១៩ នេះ ។
