បញ្ជាក់ ពី អ្វី ដែល អាច ធ្វើបាន នៅក្នុង លក្ខខណ្ឌ នៃ
នេះ អាច នាំឱ្យ មាន បញ្ហា សម្រាប់ ក្រុមហ៊ុន របស់ អ្នក ។
អ្នក បាន ដឹង ថា អ្នក មិន អាច ការពារ អ្នកគ្រប់ គ្នា ដោយ គ្រាន់តែ អង្គុយ នៅ ទីនេះ ទៀត ទេ ។
មិន បាន កត់សម្គាល់ ពី មុន ទេ៖
« បើខ្ញុំត្រូវគេ បណ្ដេញចេញ រដ្ឋាភិបាលនឹងឲ្យលុយខ្ញុំ ... »
ប៉ុន្តែពួកគេទទួលបាននៅពេលពួកគេឮវាច្រើន។
ជំពូកទី ២ នៃសៀវភៅ៖ « តើគម្ពីរអាចបង្រៀនយើងយ៉ាង ណា ?
អំបូរ នីមួយ ៗ គឺជា វប្បធម៌ មួយ នៅក្នុង ខ្លួន វា គឺជា វប្បធម៌ រង នៃ វប្បធម៌
ដូច្នេះ គេមិនខ្មាសគេទេ ។
ប្រាប់អ្នកពីអ្វី បើអ្នកចងដៃ ខ្ញុំនឹងជួយគ្នាទៅវិញទៅមក ។
ពួកគេ បន្ត និយាយ ថា " ការស្វែងរក ការពន្យល់ នឹង ត្រូវបាន ជំនួស ដោយ ការស្វែងរក ភាពស៊ីសង្វាក់ គ្នា ។
ដើម្បី សម្រេច នូវ អ្វី ដែល អ្នក ចង់បាន វា នឹង ហាក់បីដូចជា ក
អនុលោម តាម ព្រះរាជ បញ្ជា ឆ្នាំ ១៧៨៣
“ ខ្ញុំ ពិតជា មានអារម្មណ៍ ថា យើង ជា ក្រុម មួយ ដែល ត្រូវ រាប់បញ្ចូល ។
មកមិត្តភ័ក្ដិយើងមានកូនជាងទៅមើល » ។
គាត់ និយាយ ដូចជា ព្យាយាម ពន្យល់ ខ្លួន ឯង ។
ព្រះនាមទ្រង់នឹងជាសាឡូម៉ូន ហើយយើងនឹងផ្តល់សន្តិភាព និងភាពស្ងប់ស្ងាត់ដល់អ៊ីស្រាអែលក្នុង រជ្ជកាលរបស់ទ្រង់ ។
ខ្ញុំសុំអ្នកនៅយប់នេះឲ្យទុក ចិត្តលើព្រះយេស៊ូវ « កូន ចៀមនៃព្រះ ដែលដកអំពើ បាបរបស់លោកិយចេញ » ( យ៉ូហាន ១:២៩ ) ។
គួររំលឹកផងដែរថា ទិដ្ឋភាពនេះកើតឡើងនៅពេលយប់ ( ដកស្រង់ ) ។
ខ្លះនៅតាមផ្លូវ ហើយថែមទៀតនៅខាងមុខ » ។
ទេ មិន មែន ជា កំហុស ទេ ។ បាទ ខ្ញុំដឹងពី ភាពខុសច្បាប់របស់វា ។
ប៉ុន្តែការពិតគឺថាស្ថានភាពនៅស៊ីន ជាំងមានស្ថិរភាព ។
ខ្ញុំ មានអារម្មណ៍ ថា ទីបំផុត ខ្ញុំ បាន រកឃើញ អ្វី មួយ ដែល ធ្វើឱ្យ ខ្ញុំ លេចធ្លោ ។
វា មាន ទីតាំង នៅក្នុង កម្មវិធី គ្រប់គ្រង ភារកិច្ច ។
សុបិន របស់ ប៉ូល គឺ ចង់ ទៅ ទីក្រុង រ៉ូម ។
យើង នឹង បន្ត តាមដាន ពួកគេ ។
ធម្មជាតិ ដែល លើស ពី អត្ថន័យ ត្រូវបាន រំសាយ ចេញ ត្រូវបាន ផ្សំ ឡើង
" សន្យានឹងខ្ញុំថាអ្នកនឹងមានសុភមង្គល។
ឱ ព្រះអម្ចាស់ អើយ សូម អោយ ទូលបង្គំ ទៅ ប្រទេស ហុង គ្រី ហើយ ទទួល ការអបអរសាទរ ជា ស្តេច ។
មាន ភាគហ៊ុន ច្រើន ណាស់ ក្នុង ការទទួលបាន វា ត្រឹមត្រូវ ។
កៀហ្ស៊ីស៊ី ស្ថាន យើង ត្រូវ ចំណាយ ពេល ច្រើន ជាមួយ ក្រុម ។
មាន តែអ្នកដែលអាចចងខ្លួនទៅលើកំពូលភ្នំខ្ពស់បំផុតប៉ុណ្ណោះដែលបានរួចជីវិត ។
ការ ទម្លាក់គ្រាប់បែកក្នុងទីក្រុងមិនបានឈប់ទេ ។
មុននឹងចេញទៅ យើងគួរញ៉ាំផ្លែឈើខ្លះ ។
មនុស្សស្រីមានពែងបឺតនៅខាងក្រោមដៃ ហើយបុរសមិនមានពែងបឺតនៅជិតចុង ដៃឡើយ ។
ទោះ យ៉ាងណា ក៏ដោយ ប្រយ័ត្ន ការប្រើ ពាក្យ របស់ អ្នក ។
សូម ឱ្យ ឪពុក របស់ អ្នក បាន ជាសះស្បើយ ពេញលេញ និង ច្រើន ឆ្នាំ ទៀត ជាមួយ អ្នក ដែល គាត់ ស្រឡាញ់ ។
សិល្បៈ នេះ ត្រូវបាន ធ្វើ ដោយ សន្តិភាព ។
ពាក្យនេះបន្ទាប់មកត្រូវបានគេអនុវត្តចំពោះសាសនារបស់សាវក ។
តើនរណាជាអ្នកសំខាន់បំផុតក្នុងការ បំផ្លិចបំផ្លាញរបស់ វីអ៊ីអ៊ី ហើយតើគាត់បានធ្វើអ្វី ?
សម្រាប់ កូនប្រុស របស់ អ្នក នាង គឺជា ព្រះនាង ។
នៅឆ្នាំក្រោយ ខ្ញុំនឹងត្រឡប់មក រកអ្នក វិញ ហើយសារ៉ានឹងមានកូនប្រុសម្នាក់ » ។
សង្ឃ សួរ ថា បពិត្រ ព្រះគោតម ។
មានកន្លែងជាច្រើនដែលអាចមើលឃើញ ប៉ុន្តែក្នុង រយៈ ពេល ៣ ថ្ងៃនេះ យើងមិនមានពេលធ្វើអ្វីដែលយើងចង់បាន !
ក្រុមការងារ ថ្នាក់ ជាតិ កំពុង ធ្វើ ការ លើ បញ្ហា នេះ នៅ ពេល នេះ ។
សូម្បីតែយើងដឹងថាយើងដឹងពីអ្វីដែលពួកគេចង់បានឬរបៀបដែលពួកគេនឹងឆ្លើយ តប ។
នាងបាននិយាយថា៖ « វាជាការ រីករាយដែលបានធ្វើរឿងផ្សេងៗ ជាច្រើន។
ការថត ដែល អ្នក បាន ដាក់ គឺ សំខាន់ ណាស់ ។
ភាព ទន់ខ្សោយ នេះ អាច ប្រែ ទៅជា ការវាយប្រហារ ទ្រង់ទ្រាយ ធំ តាម វិធី ដូច ខាងក្រោមៈ (1)
ទោះបីជាឃើញថាជានរណាក៏ស្ងប់ ចិត្ត ។
ពេញចិត្ត សិល្បៈ ណាស់ !
នៅ ព្រឹក បន្ទាប់ គ្រូពេទ្យ បាន ប្រាប់ គាត់
ជាមួយនឹង កម្លាំង របស់ មនុស្ស ប្រហែលជា ល្អ ។
៨ ប៉ុន្តែ បើយើងមានអាហារ និងសម្លៀក បំពាក់ នោះយើងនឹងស្កប់ ចិត្ត ។
ពេលវេលាកន្លង ផុតទៅ អ្នកនឹងអាចធ្វើ កិច្ចការនេះបានច្រើនទៀត ។
ខ្ញុំមិនបានស្គាល់អ្នកទេ ប៉ុន្តែខ្ញុំបាន ឮយ៉ាងច្រើនអំពីអ្នកពីមិត្ត ភក្តិនៃគ្រួសាររបស់អ្នក ។
អ្វី ៗ ប្រែ ប្រួលទៅវិញទៅមក នៅពេលជំនួសឱ្យក្មេងស្រី ម្ដាយរបស់នាងបានអានសំបុត្រ ។
នេះជាហេតុផលដែលធ្វើឱ្យមនុស្សភាគ ច្រើនមានអារម្មណ៍ស្ងប់ស្ងាត់ និង រីករាយ បន្ទាប់ពីធ្វើ ការ ។
តើលោកគ្រូ បង្វឹកថ្មីរូបនេះបានជួយដល់ចំណុច ណាខ្លះ ?
បន្ទាប់ពី សង្កាត់ មួយ ដែល វា ពេញនិយម ។
ដូច្នេះបានលះបង់ចំពោះព្រះហឫទ័យនៃព្រះ ដែលពួកគេស្រឡាញ់ទ្រង់
អ្នកដែលមិនបានត្រូវថ្កោល ទោស ហើយត្រូវគេ បណ្តេញចេញ ។
ខ្ញុំត្រៀមខ្លួនជា ស្រេចសម្រាប់ឆ្នាំនេះដល់ចប់ ។
គ្រាន់តែ បុរស ចំណាស់ ម្នាក់ មក រក គាត់ ។
« សូមអរគុណចំពោះគេហទំព័រគេហទំព័រ !
ព្រមទាំងឃើញប្រពន្ធខ្ញុំមកយល់រឿងនេះ ។
ខ្ញុំ សូម ជូនពរ ឱ្យ មាន មនុស្ស ដូច អ្នក នៅ ជុំវិញ ដើម្បី លើកទឹកចិត្ត គូ ស្វាមី ភរិយា ថ្មី ថ្មោង ។
សិស្សនោះបានផ្លាស់ទៅរៀននៅវិទ្យាល័យទៀតហើយ ។
ថ្ងៃ នេះ គឺជា ក្មេងប្រុស ម្នាក់ ក្នុង ចំណោម ក្មេងប្រុស បាន យល់ព្រម លោត ។
យើងបានស៊ូទ្រាំនឹងការ លំបាក ជាច្រើនជាមួយគ្នា ។
យើង បាន រកឃើញ នៅលើ ហ្វេសប៊ុក ។
មាន ការប្រឈមមុខ ដាក់ គ្នា បន្តិច បន្ថែម ទៀត នៅ ពេល ដែល វា មកដល់
ហើយ បាន ផ្តល់ឱ្យ ខ្ញុំ នូវ ទិដ្ឋភាព មួយ ផ្សេង ទៀត នៃ ព្រះគុណ របស់ ព្រះ។
ហើយ ចាប់តាំងពី ប្រព័ន្ធ ផ្សព្វផ្សាយ ភាគ ច្រើន នៅ ទីនោះ សម្រាប់ សុន្ទរកថា របស់ នាង ពួកគេ ភាគ ច្រើន បាន ធ្វើ តាម ។
បរាជ័យគឺគ្រាន់ តែជាផ្លូវនៃការ រៀន សូត្រ » ។
