« អ្នក ណាដែលស្អប់បងប្អូន អ្នក នោះជាឃាត ក ហើយអ្នក រាល់គ្នាដឹងថា គ្មានឃាតកណាមានជីវិតអស់ កល្ប ជា និច្ចក្នុងខ្លួននោះទេ » ។
ខ្ញុំក៏គិតថា បុរសនោះមានសិទ្ធិឆ្លើយ តប ។
នៅ ទីបំផុត កូនរបស់បងស្រីទាំងពីរបានក្លាយជា ស ត្រូវ ។
នាង ធ្លាប់ ធ្វើការ ជា មេធាវី ក្រុង ។
គាត់នឹងបានរួចពី សុគតឡើង វិញ » ។
« ឯងមិនដឹងថាអញមានអំណាចដោះលែងឯងឬឆ្កាងឯងទេ ? »
ការពឹងផ្អែក លើ ខ្លួន ឯង ពិតជា ល្អ ណាស់ !
ហេតុនេះហើយបានជាស្ត្រីត្រូវបានរកឃើញថាមានសុក
យើង នឹង ធ្វើការ ជាមួយ ម្តាយ ដែល រំពឹងទុក
យើង ជា ជនជាតិ អ៊ុយក្រែន គឺជា ប្រជាជន ដែល ចង់បាន សន្តិភាព និង សេចក្តីស្រឡាញ់ ។
ត្រូវបាន ធ្វើឱ្យ ប្រសើរ សម្រាប់ លេខ កូដ C ។
10 ដូច្នេះ លោកយ៉ូស្វេបានបង្គាប់ទៅពួក មន្ត្រីរបស់ប្រជាជន ។
អំពើ ទុច្ចរិត ទាំងអស់ គឺជា អំពើ បាប ។ ហើយ មាន អំពើ បាប ដែល មិន មែន ជា សេចក្តីស្លាប់ ។
ខ្ញុំត្រូវ សង់ការ ព្យួរឡើងវិញ ។
យ៉ាងណា ក៏ដោយ អំពើ អាក្រក់ នៅតែ បន្ត ដូច ពីមុន
សូមមកទីនេះ ហើយជួយ សង្គ្រោះខ្ញុំផង !» ។
ច្រក ទាំងនេះ ត្រូវបាន ប្រើ សម្រាប់ ការបញ្ជូន ទិន្នន័យ ។
ក្រុមហ៊ុន ស្រាវជ្រាវ នៅ បូស្តុន ។
១១ ហើយត្រៀមខ្លួនជា ស្រេចសម្រាប់ថ្ងៃទី បី ។ នៅថ្ងៃទីបី ព្រះ‌ អម្ចាស់នឹងយាងចុះ មកលើភ្នំ ស៊ីណាយ នៅចំពោះមុខប្រជាជនទាំង អស់ » ។
ខ្ញុំបាន បញ្ចប់ការ ធុញទ្រាន់នៅទីនេះ !
តោះ ចាប់ផ្តើម ដំបូង៖ តើ ការបន្លំ ជា អ្វី ?
សកម្មភាព ភាគ ច្រើន គឺ នៅ សហរដ្ឋ អាមេរិក ។
កើនឡើង និង ធ្លាក់ចុះ ជាញឹកញាប់ ក្នុង អំឡុង ពេល ដែល នៅសល់ នៃ ថ្ងៃ ។
ស្ត្រី ជនជាតិ លីទុយ អានីមួយចំនួន ធំ មើល ទៅ ដូចជា គំរូ ពិត ។
ម៉ោងមុននឹង រកឃើញខ្ញុំ » ។
គាត់គំរាមប្ដឹងប្រសិនបើមានការ បង្កាច់បង្ខូច
ខ្ញុំដឹងច្បាប់នៅទីនេះ ... អរគុណច្រើនសម្រាប់ការ ជួយរបស់អ្នក ... » ។
អ្នក ទីមួយបានរៀបការ រួចក៏ស្លាប់ដោយគ្មានកូន ។
ផ្លូវ របស់ សាមូរ៉ៃ គឺ ការស្លាប់ ។
ហើយ បន្ទាប់មក 47 វិនាទី ចុងក្រោយ បាន កើតឡើង ។
ភ្នាក់ងារ រដ្ឋាភិបាល ដែល ជា ផ្នែក មួយ នៃ វិស័យ សាធារណៈ របស់ ពួកគេ ត្រូវការ សេវា បកប្រែ ហេតុ អ្វី ?
លោកក៏បដិសេធដែរថា ប៉ូលិសពីរនាក់មិនត្រូវបានសម្លាប់នៅកន្លែងរបស់លោកទេ ។
ស្ត្រី ជាច្រើន ឆ្ងល់ ថា តើ អ្វី ជា កម្រិត នៃ ការធ្វើ លំហាត់ប្រាណ សមស្រប ។
រីករាយ ថ្ងៃ បុណ្យ ណូអែល ប៊ីល ម៉ារី និង ក្រុមគ្រួសារ ។
ពីរនាក់ក្នុងចំណោមពួកគេក៏ត្រូវបានគេរៀបចំក្នុងអំឡុងពេលប៉ុន្មានឆ្នាំនេះ ។
ពេលម្ចាស់ត្រឡប់មកវិញ គាត់បានរកឃើញនូវអ្វីដែលអ្នកទាំងបីបានធ្វើជាមួយនឹងប្រាក់ ។
វ៉ាយ ហ្វាយ ឥត គិត ថ្លៃ ហាក់ដូចជា ទំនង ជាង ។
ចេញពីហ្វេសប៊ុក ។
ខ្ញុំភ្ញាក់ផ្អើលចំពោះការ ផ្លាស់ប្តូររបស់កូនប្រុសខ្ញុំ » ។
ពួកគេ បាន យល់ ពី គ្រោះថ្នាក់ ប៉ុន្តែ ស្វាគមន៍ ការសប្បាយ ។
ហើយ ប្រគល់ ទៅ ឱ្យ មនុស្ស ជា ទីស្រឡាញ់ នា ពេល អនាគត ។
ប៉ុន្តែ ស្តេច ក្នុង ស្រុក មិន ចង់ឱ្យ ពួកគេ ចូល ទេ ។
មាន អាហារ ដ៏ អស្ចារ្យ ។
ឥឡូវ អ្នក នឹង ឃើញ ពាក្យបញ្ជា អំពី៖ ទទេ
នេះ ពិតជា ករណី ដូច ដែល ខ្ញុំ បាន ឆ្លងកាត់ នោះ ។
អ្វីដែល សមបំផុត និងល្អបំផុតសម្រាប់ទាំងអស់គ្នា » ។
អ្នក ចង់ បង្កើត ការទៅ ត្រឹមត្រូវ ។
ហើយប្អូនប្រុសរបស់គាត់គ្រាន់ តែនិយាយថា៖
ហើយ ត្រូវបាន ដាក់ នៅក្នុង អ្នក ។
ភ្លក្ស រសជាតិ បន្ទាប់មក ចម្អិន វា នៅ ពេលព្រឹក ដោយ មិន លាង ជម្រះ ។
ដោយនិយាយទៅកាន់បិតារបស់គាត់ក្នុងនាមជាកូនប្រុសនឹងនិយាយទៅកាន់ឪពុកម្តាយ គាត់បានអធិស្ឋានថា ៖
ប៉ុន្តែ មាន ធាតុ មួយចំនួន នៅលើ វិក្កយបត្រ នេះ ដែល ខ្ញុំ មិន ទទួលស្គា ល់៖
កុំ ប្រើ ពាក្យ ប្រមាថ នៅក្នុង ពួកគេ ។
យើង ធ្វើការ យ៉ាង លំបាក ដូច្នេះ អ្នក មិន ចាំបាច់ លះបង់ ការលួងលោម ទេ - ថ្ងៃ ឬ យប់ ។
អ្នកសួរថាតើគាត់នឹក កត់ ត្រាដែរឬទេ បើបទ ចម្រៀងនឹងឈប់ ...
« ខ្ញុំបារម្ភអំពី ការ បង្កើនការ សម្លាប់សាសនា ។
នាងបានឮថាកូនស្រីរបស់នាងបានជា សះស្បើយ ។
នាងនៅក្នុងទឹកពេញមួយថ្ងៃ ហាត់ ប្រាណពេលព្រឹក ( ក្នុងទឹក ) និងមុជទឹកពីរ ...
ទៅ កាន់អភិបូជា ហើយគេឆ្លើយថាមែន ។
ហើយស្ត្រីមានផ្ទៃពោះដែលញ៉ាំភេសជ្ជៈពីមួយទៅពីរក្នុងមួយថ្ងៃ ទំនងជាអ្នកមិនផឹកពីរ ដងក្នុងការ មានកូនទម្ងន់ទាប ។
ដូច នៅក្នុង ករណី នៃ ការគ្រប់គ្រង ព្រៃឈើ ការគ្រប់គ្រង ធនធាន សហគមន៍ នឹង ត្រូវបាន សង្កត់ធ្ងន់ កាន់តែ ខ្លាំង ឡើង ។
ប៉ុន្តែសម្រាប់ថ្ងៃនេះ និងថ្ងៃស្អែក និងថ្ងៃ បន្ទាប់ ខ្ញុំត្រូវតែបន្តទៅមុខ ព្រោះជាការ មិនត្រឹមត្រូវដែលហោរាត្រូវស្លាប់នៅក្រៅក្រុងយេរូសាឡឹម ។
ខ្ញុំសូមអង្វរអ្នកថា មុននឹងខ្ញុំលះបង់ព្រលឹង
អ្នកនឹងឃើញ បង្អួចស្រដៀងនឹងផ្ទាំងដែលបង្ហាញក្នុងរូបថតអេក្រង់បន្ទាប់ ។
« នៅដំណាក់កាលនេះ ក្រុមប្រឹក្សាមិនមានតួនាទីទេ ។
#៩ ពិនិត្យមើល ការពិត ដោយ ខ្លួន ឯង
ហើយ ពិត ណាស់ ទោះបីជា មាន ការអធិស្ឋាន ជាច្រើន ក៏ដោយ នាង បាន ចាកចេញ បន្ទាប់ពី ពីរ សប្តាហ៍ ។
ប៉ុន្តែ តើ ផ្ទះ មួយ ណា ប្រៀបធៀប នឹង ទីក្រុង ?
ប៉ុន្តែ នៅ ពេល ដែល អ្នក ដែល ចាប់អារម្មណ៍
សម្រាប់ ការចាប់ផ្តើម វា មាន អថេរ មាន ន័យ ថា អ្នក អាច អនុវត្ត តិចតួច ឬ ច្រើន ។
ក្នុង ករណី នេះ បង្ហាញ មនុស្ស
ឬមួយជីវិតដែលខ្ញុំបានបាត់ បង់គឺពោរពេញដោយ ភាព មមាញឹក ?
វត្ថុទាំងអស់នោះបានអភិវឌ្ឍក្នុង រយៈពេល ១០ ទៅ ២០ ឆ្នាំចុងក្រោយនេះ » ។
តើពួកគេមិនមានឱកាសវាយឈ្នះអ្នកទាំងបួននោះទេ ?
តើវាមានតម្លៃប៉ុន្មាន ហើយមានអាយុជាក់លាក់ដែលអ្នកត្រូវមាន ?
