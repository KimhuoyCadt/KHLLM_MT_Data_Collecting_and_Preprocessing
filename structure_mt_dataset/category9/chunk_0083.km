អ្នកដែលត្រូវបានគ្រប់គ្រងដោយនិស្ស័យ បាបរបស់ពួកគេ មិនអាចធ្វើឲ្យព្រះ ពេញ ចិត្តបានឡើយ ។
យើងមិនអាចទទួលបានវាក្នុងរយៈពេលច្រើនម៉ោងនៅកន្លែងហាត់ប្រាណទេ ។
រួម ជាមួយនឹង ការវិនិច្ឆ័យ ចុងក្រោយ និង ការផ្តន្ទាទោស មនុស្ស មាន បាប ។
* ខ្ញុំ កំពុង រង់ចាំ ការបញ្ជាក់ ថា នេះ ជា មូលហេតុ ដែល រឿងរ៉ាវ បាន កន្លងផុត ទៅ ។
ប្រសិនបើអ្នកបានស្គាល់ខ្ញុំ អ្នកនឹងបានស្គាល់ព្រះបិតារបស់ខ្ញុំដែរ » ។
វា ដូចជា ពួកវា លេចឡើង ម្តង ទៀត ដូចជា វេទមន្ត ចំពោះ ពួកគេ ។
ខណៈពេល ដែល ខ្ញុំ ជា មនុស្ស ធំ ខ្ញុំ ក៏ ស្លូតបូត ណាស់ ។
ហើយ ឥឡូវនេះ អ្នក ក៏ កំពុងតែ បង្ហាញ ភាព អផ្សុក ផងដែរ ។
ដើរ ចេញ ពី បល្ល័ង្ក ហើយ ពិនិត្យមើល ប្រព័ន្ធ ទាំងមូល ដោយ វត្ថុ បំណង ។
ផ្លាស់ទី មាត់ និង មុខ របស់ អ្នក ។
តើយើងទទួលបានឫ ទ្ធានុភាពនៃព្រះ ដោយរបៀបណា ?
កាលពី ឆ្នាំ មុន អ្នកប្រើប្រាស់ ទូរស័ព្ទ ទាំងអស់ ក្នុង ប្រទេស មាន រហូតដល់ ថ្ងៃទី 31 ខែកក្កដា ឆ្នាំ 2015 ដើម្បី ចុះឈ្មោះ ជាមួយ អ្នក ផ្តល់ សេវា បណ្តាញ ព័ត៌មាន លំអិត ផ្ទាល់ខ្លួន របស់ ពួកគេ ដូចជា ឈ្មោះ ពេញ លេខ សម្គាល់ លេខ ទូរស័ព្ទ ។ល ។
កូនក្រមុំ មាន អាយុ សាមសិប ប្រាំបី ។
« កុំថ្វាយបង្គំផ្កាយឡើយ ចូរថ្វាយបង្គំអ្នកដែលបានបង្កើតផ្កាយ » ។
២៧ លោកចាត់អង្គរក្សម្នាក់ចេញភ្លាម ដោយ បញ្ជាឲ្យនាំក្បាលលោក យ៉ូហាន មក ។
តើអ្នកត្រៀមខ្លួនហើយឬនៅក្នុងការ សិក្សានៅសកលវិទ្យាល័យ Harvard ?
ប្រសិនបើ អ្នក មិន ពេញចិត្ត នឹង ផលិតផល របស់ យើង យើង អាច ផ្តល់ឱ្យ អ្នក នូវ ដំណោះស្រាយ ដែល ពេញចិត្ត
អូហូ ការិយាល័យ ប្រៃសណីយ៍ ។
ពួកគេបានស្វែង រកម្ចាស់ ជាយូរមកហើយព្រោះគាត់ជំពាក់ប្រាក់លើសេវា ។
ពួកគេ នឹង មាន ការស្លាប់ ។
ស្ត្រីម្នាក់នេះធ្វើបានល្អនៅផ្ទះខ្ញុំ ។
១៖ សំណួរ៖ ហេតុ អ្វី បានជា អ្នក ចង់ ក្លាយជា ផ្នែក មួយ នៃ ក្លឹប ភាពយន្ត ?
ហើយខ្ញុំមិនដឹងថាគាត់នៅកន្លែង ណា ឬកំពុងធ្វើអ្វីទេ » ។
កំពុង ដំណើរការ ជា កម្មវិធី ឯករាជ្យ
គ្មាន នរណា ម្នាក់ ស្វែងរក គាត់ ទេ ។
« ហេតុនេះហើយបានជាប្រាជ្ញារបស់ព្រះ ក៏មាន បន្ទូលថា ‹ អញនឹងចាត់ហោរា និងសាវកឲ្យទៅ ហើយពួកគេខ្លះនឹងសម្លាប់ ហើយខ្លះទៀតនឹងបៀតបៀន ›» ។
អីវ៉ាន់ របស់ ខ្ញុំ ត្រូវបាន ពន្យារ ពេល ដោយ អេ
ការអាន នៅក្នុង ការទទួលស្គាល់ ការនិយាយ ។
អ្នក ត្រូវបាន ប្រើប្រាស់ ជាមួយនឹង បេសកកម្ម ។
ព្រះក្លែងក្លាយ ទាំងអស់ នឹង ត្រូវ ដក ចេញ ពីមុខ ផែនដី ។
ប្រសិនបើឧក្រិដ្ឋកម្មរបស់យើងបង្ហាញខ្លួន វានឹងមានពេលខ្លះក្នុង រយៈពេលបួនម៉ោង បន្ទាប់ » ។
ដូច្នេះ ពួកគេ អាច ត្រូវបាន ស្អិត ជាប់ ។
ពេលនោះគាត់ដឹងថាគាត់នៅ តែមានគ្រឿងសម្អាងដែលគេលាបឱ្យគាត់ ។ < អ្ហា៎ !
ខ្ញុំគិតថាទទួលនាងជាប្រពន្ធតាមទំនៀម ទម្លាប់បុរាណ
« ថ្ងៃនេះសេចក្ដីសង្គ្រោះបានមកដល់ផ្ទះនេះហើយ ព្រោះបុរសនេះក៏ជាកូនរបស់ អ័ ប្រាហាំដែរ !» ។
ខ្ញុំ បាន គិត ថា " វា ចម្លែក បន្តិច " ហើយ បន្ទាប់មក ម្នាក់ ក្នុង ចំណោម ពួកគេ បាន និយាយ ថា ពួកគេ បាន ឃើញ រូបភាព ហើយ ខ្ញុំ ពិតជា ភ្ញាក់ផ្អើល ខ្លាំង ណាស់ ដែល រឿង បន្ទាប់ ដែល ខ្ញុំ ដឹង ថា ខ្ញុំ មាន ស្ថានីយ៍ ទូរទស្សន៍ មក ខ្ញុំ ។
ប៉ុន្តែខ្ញុំគិតថា អត់ទេ ខ្ញុំនឹងទៅធ្វើទាហាន ។
គាត់ត្រូវបានបញ្ជូនត្រឡប់ទៅប្រទេសចិនវិញ ។
នេះគឺដោយ សារ តែយើងមានផ្លូវមួយចំនួនដែលមិនមានឧបសគ្គ ។
នៅ ពេល ដែល មាន អ្វី មួយ អាក្រក់ ឬ មិន ត្រឹមត្រូវបាន កើតឡើង ។
៤០ អ្នកក៏ត្រៀមខ្លួនដែរ ព្រោះកូនមនុស្សនឹង មកដល់ម៉ោងដែលអ្នក រាល់គ្នានឹកស្មានមិនដល់ » ។
៦ ដោយសារ តែយើងជាព្រះ យេហូវ៉ាមិនបាន ប្រែ ប្រួល ដូច្នេះហើយអ្នក រាល់គ្នាជាកូនរបស់យ៉ាកុបមិនត្រូវបានបំផ្លាញចោលទាំង ស្រុងឡើយ ។
នៅថ្ងៃទីប្រាំបី ពួកគេ មកកាត់ស្បែកកូន ដូចព្រះ បានបង្គាប់គ្រប់ផ្លូវនៅជំនាន់លោកអប្រាហាំ ។
ពេលទៅដល់ជិតចម្ការ អ្នកជិះសេះបានបង្កើតជាខ្សែពីរ ។
ឥឡូវនេះ វា បាន ត្រឡប់ មកវិញ យ៉ាង អាថ៌កំបាំង ។
ទឹកដី សន្យា និង សង្រ្គាម ជាច្រើន ។
ពេលនោះ បុរសទុច្ចរិតនឹងលេចមក ប៉ុន្តែព្រះ‌ អម្ចាស់យេស៊ូវនឹងសម្លាប់គាត់ដោយដង្ហើមព្រះ‌ឱស្ឋរបស់ទ្រង់ ហើយបំផ្លាញគាត់ដោយ ភាព អស្ចារ្យនៃការ យាងមករបស់ទ្រង់ ។
ពួកគេ មាន ការខកចិត្ត យ៉ាង ខ្លាំង ។
15 ផ្ទុយទៅវិញ ការ និយាយសេចក្ដី ពិតដោយសេចក្ដី ស្រឡាញ់ នោះយើងនឹងធំ ឡើងក្នុងគ្រប់ការ ទាំងអស់ក្នុងទ្រង់ដែលជាព្រះ ប្រមុខ នោះគឺជាព្រះគ្រីស្ទ ។
ហើយ បន្ទាប់មក មាន តារា សម្តែង ដែល ត្រូវបាន ព្យាបាល :
នាងគិតថាគ្មានដី ណាលើសពីនេះទេ ។
ដូច្នេះជីវិតមានការ ឡើងចុះ ។
« ដោយ សារគេនិយាយថា « គាត់មានវិញ្ញាណអាក្រក់ » ។
និង សិទ្ធិ អត្ថប្រយោជន៍ របស់ អ្នក ដើម្បី មើល អ្នក , ប៉ុន្តែ អ្វី ដែល ពួកគេ មាន ។
គាត់ បាន ទៅ សាលារូបវិទ្យា និង គណិតវិទ្យា ។
ខ្ញុំ នឹង ជួយ ក្នុង ពិធី ជប់លៀង របស់ អ៊ីសាក !
ពួកវា សាមញ្ញ ក្នុង ការថែទាំ ហើយ មិន ត្រូវការ ស្រោច ទឹក ញឹកញាប់ ទេ ។
នេះ គឺជា ការសន្សំ ដ៏ ធំ សម្រាប់ អ្នក ។
ប៉ុន្តែ ព្រះ បានប្រោសគាត់ឲ្យ រស់ឡើងវិញ ដោយប្រោសគាត់ឲ្យរួចពីទុក្ខ សោកនៃសេចក្ដី ស្លាប់ ពីព្រោះសេចក្ដី ស្លាប់មិនអាចទប់គាត់បាន » ។
ស្គាល់ប្រភេទឈាមរបស់ស្ត្រីម្នាក់នេះហើយឬនៅ ?
ដ្បិតទ្រង់បានប្រទានឲ្យអ្នក នូវសេចក្ដី សុចរិតរបស់ទ្រង់ ។
យ៉ូហាន បាទី ស្ទ បានជាប់គុក ពេលគាត់បានឮអ្វីដែលលោកយេស៊ូកំពុងធ្វើ ។
ពួកគេ នឹង ខុស ពិត ណាស់ វា គួរតែ ស្រលាញ់ ។
