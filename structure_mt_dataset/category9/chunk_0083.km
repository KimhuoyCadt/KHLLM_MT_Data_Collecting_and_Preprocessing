ខ្ញុំចង់និយាយថា នោះជាហេតុផលសម្រាប់ការបណ្ដេញបុគ្គលិក បង្វឹកទាំងមូលនៅថ្ងៃនេះ ។
បុរសម្នាក់និងស្ត្រីម្នាក់កំពុងបើក បរស្របពេលឃើញរថយន្តមួយ
ការពិត៖ ទោះបីជា មនុស្ស ជាច្រើន បាន ចាក់ វ៉ាក់សាំង នា ពេល អនាគត ក៏ដោយ ។
ទីបំផុតនាងបានចាកចេញដោយរបៀប ណា ហើយបានទូរស័ព្ទទៅឪពុកម្ដាយរបស់នាង ។
មើល មុខ ដ៏ ផ្អែមល្ហែម របស់ នាង ហើយ អ្វី ៗ ត្រូវបាន លើកលែង ទោស ។
ថា វា ជា ព្រះបន្ទូល របស់ ព្រះជាក់លាក់ ។
ប៉ុន្តែមុននឹងជ្រើស រើសម៉ូនីទ័ររាំទាំងអស់ សូមបន្តអាន ។
ធ្វើ ដូច ដែល ខ្ញុំ បាន ចេញ វេជ្ជបញ្ជា ពួកគេ និយាយ ( ឬ ស្រែក ) ហើយ បន្ទាប់មក ថែរក្សា ខ្លួនអ្នក ។
ឪពុកសម្លឹងមើលកូនប្រុសដែលខ្លួនបានចិញ្ចឹម ។
ខ្ញុំគិតថាគេអាចលុបបំបាត់ ភាពចម្លែកបានច្រើនហើយ !
បាទ / ចាស ប៉ុន្តែ វា អាស្រ័យ លើ ការសំរេចចិត្ត ។
អ្នក នឹង មាន សង្ឃឹម ជារៀងរហូត ។
ព្រះត្រូវតែ ទទួលបាន សិរី រុងរឿង របស់ ទ្រង់ ត្រឡប់ មកវិញ នៅលើ ផែនដី ។
ការសរសេរ សារ ពត៌មាន និង ទម្លាប់ ផ្សេង ទៀត នៃ អ្នក ជោគជ័យ ខ្លាំង
លោកបន្ត ថា៖ « វាពិបាកណាស់ក្នុងការ ស្វែង រកទ្រព្យ សម្បត្តិនៅពេលអ្នក មកពីក្រៅក្រុង ។
គ្រប់ ព្រលឹង ត្រូវតែ ពិសោធ នូវ រសជាតិ នៃ ថ្ងៃ ជំនុំ ជំរះ ។
ខ្ញុំ កំពុង រង់ចាំ ទិន្នន័យ របស់ គាត់ ។
វា ត្រូវតែ និយាយ សម្រាប់ អ្នក ដែល មិន អាច និយាយ បាន ។
នោះ គឺជា លទ្ធភាព មួយ ដែល ត្រូវបាន ស្រាវជ្រាវ ដោយ អ្នកនិពន្ធ សិក្សា ។
« ដ្បិតកូនមនុស្សបានមកដើម្បីស្វែង រក និង សង្គ្រោះអ្វីដែលបានបាត់ បង់ » ។
ការដំឡើង ងាយស្រួល ជាមួយ អ្នកជំនួយការជំហាន ដោយ ជំហាន សាមញ្ញ ។
ផ្តល់ឱ្យ ពួកគេ នូវ ការគំរាមកំហែង ជាច្រើន ដើម្បី ព្រួយបារម្ភ " ។
12 កូនស្រីអើយ ចូរចេញទៅវិញ ។
កុំចូលតាមផ្លូវខ្ញុំ បើមិនដូច្នេះទេ អ្នកនឹងជួបជោគ វាសនាគាត់ » ។
ខ្ញុំបែរមកសួរអ្នកយាម ។
វា ប្លន់ អំណាច ទិញ នៃ ការសន្សំ របស់ ប្រជាជន ។
ដើម្បី ការពារ ប្រឆាំង នឹង ការចូល ប្រើ គណនី របស់ អ្នក ដោយ គ្មាន ការអនុញ្ញាត ។
៧ ដូច្នេះ កុំធ្វើជាដៃ គូនឹងពួកគេឡើយ ។
៧ ដូច្នេះ កុំធ្វើជាដៃ គូនឹងពួកគេឡើយ ។
ហើយ តាម របៀប ដែល មិន ត្រូវការខ្សាច់ !
តើយើងបានឈានដល់ដំណាក់ កាលមួយក្នុងជីវិតដែលយើងស្ថិតក្នុងស្ថានភាព នៃសង្រ្គាមជាមួយជន ជាតិរបស់យើងឬទេ ?
នៅក្នុងឈុតមួយ នាងចូលរួមការបញ្ចប់ការ សិក្សារបស់គាត់ បើទោះជាគាត់មិននៅ ទីនោះក៏ដោយ ។
វា ត្រូវបាន សរសេរ យ៉ាង ល្អ ហើយ ខ្ញុំ ឃើញ ពែង ។
អ្វីដែលពិសេសជាងនេះទៅទៀត វាមានសារៈសំខាន់ខ្លាំងណាស់សម្រាប់សមាជិកសហគមន៍ដែលមាន ភាព ស្និទ្ធស្នាលនឹងគ្នា ។
លទ្ធិ ប្រជាធិបតេយ្យ នៃ បច្ចេកវិទ្យា ” ។
“ ឪពុកខ្ញុំជាឪពុកដ៏ល្អម្នាក់ ។
ស្ត្រីរូបនេះបាននិយាយថា នាងបាន រត់ចេញពីក្រុមគ្រួសារពេលធ្វើដំណើរក្នុងប្រទេសគុយ វ៉ែត ដោយ សារពួកគេធ្វើ បាបនាងទាំងផ្លូវ កាយ និងផ្លូវចិត្ត ។
ពួកគេចង់ធ្វើឱ្យប្រាកដថាវាផ្លាស់ប្តូរ » ។
3 ព្រះអម្ចាស់នឹងយាងមកពីកន្លែងរបស់ព្រះអង្គ ។
គាត់ឈោងទៅរកឃើញឈាមច្រមុះ ។
ហេ ខ្ញុំ ជាវិស្វករ !
សូមឲ្យអ្នក មកជួយពួកគេ ហើយផ្តល់ កម្លាំងនិង ភាពក្លាហានដល់ពួកគេក្នុងម៉ោងដ៏ងងឹតបំផុតរបស់ពួកគេ ។
បួន លើក មុន តំណែង របស់ ទីក្រុង ម៉ូស្គូ ត្រូវបាន គាំទ្រ ដោយ ប្រទេស ចិន ប៉ុន្តែ ចិន បាន បដិសេធ ការបោះឆ្នោត ។
គេមិនដឹងថាខ្ញុំ ជាអ្នកក្បត់ទេ ។
យើង ស្អប់ ប៉ុន្តែ ស្រលាញ់ ។
ហេតុអ្វីបានជាអ្នកគិតថាដាក់ខ្លួនឯងប្រឆាំងនឹងជំនឿ
សក់ ស្បែក ក្បាល រហូតដល់ វា ស្ងួត ។
ប៉ុន្តែខ្ញុំមិនដឹងថាយើងកំពុងធ្វើដំណើរអ្វីទេ ។
ទំហំ បំពង់ គឺ គ្រប់គ្រាន់ ។
តើពាក្យអ្វីដែលមិនល្អ ?
ព្រឹកឡើង ហើយគ្មានអ្នក ណាបានជួយទេ ។
គ្មាន អ្វី ល្អ ទេ ប្រសិនបើ អ្នក យល់ ខុស តាំងពី ដំបូង ។
« គោរពគេខ្លាំងណាស់ស្រលាញ់គ្នាដោយ សារ តែការងារ » ។
" អូ អ្នក និយមរបស់អ្នកបានចូលទៅក្នុងវាលស្មៅនេះ .. . គាត់ស្លាប់ហើយ " ។
សម្រាប់ មនុស្ស គឺជា ម្ចាស់ នៃ វត្ថុ ។
យើងនឹងដាំវានៅក្នុងទឹកដីរបស់គេ ហើយនឹងមិនត្រូវដកពួកគេចេញពីស្រុកដែលយើងបានប្រគល់ឲ្យពួកគេទៀតឡើយ ។
ចូរ យើង កុំ អនុញ្ញាតឱ្យ គាត់ ក្លាយជា ការលោត ផ្លោះ ដ៏ អស្ចារ្យ ចុងក្រោយ សម្រាប់ មនុស្សជាតិ ។
កូនប្រុស បាន នាំ វា ឱ្យ ល្បីល្បាញ ។
កុំ ខឹង នឹង មនុស្ស
សម្រាប់ ខ្ញុំ រហូតដល់ ពួកគេ ពិតជា អស្ចារ្យ ណាស់ ។
ក្នុង ករណី ជាច្រើន ត្រី ឬ សាច់ ដែល ពួកគេ ត្រូវបាន ផ្តល់ឱ្យ នៅ សាលា គឺជា ប្រូតេអ៊ីន សត្វ តែ មួយ គត់ ដែល ពួកគេ ទទួលបាន ពេញ មួយ ថ្ងៃ ។
កុមារ ភាគ ច្រើន មាន បបូរមាត់ ពេញ និង ច្បាស់លាស់ ។
ព័ត៌មានជាច្រើនអំពី ការ ជួញដូរទាសករ » ។
គាត់ធ្លាប់មានការ មិនទុក ចិត្តរួចទៅហើយ ហើយក៏មិនប្រាកដពីខ្លួនគាត់ដែរ ។
វា មិន ឆ្ងាយ ប៉ុន្មាន ពី អ្នកទេ ។
អ្វី ក៏ដោយ ដែល អ្នក សម្រេចចិត្ត ថា អ្នក មាន ចំនួន ដ៏ ច្រើន នៃ អ្នក ជូនពរ ហើយ សេចក្ដីស្រឡាញ់ និង ការអធិស្ឋាន ច្រើន នឹង មកដល់ ផ្លូវ របស់ អ្នក ។
ហើយ ទ្រង់ នឹង សោយរាជ្យ ។
ចំណែកអ្នកនៅ សល់បញ្ហាប្រឈម បន្ទាប់នឹងលើកពេលក្រោយ ។
អេ ថាន កំពុង ទន្ទឹងរង់ចាំ ពួកគេ ហើយ បាន ជួប ពួកគេ នៅ ខាងមុខ ដោយ បើកចំហ ។
វា ជា ការលក់ ដ៏ រំភើប សម្រាប់ ខ្ញុំ ។
ពួក កុម្មុយនិស្ត បាន គ្រប់គ្រង ជីវិត របស់ យើង ។
មាន គន្លឹះ ជាច្រើន នៅពេល ធ្វើ ការផ្លាស់ប្តូ រ៖
មនុស្ស ជាច្រើន បាន ស្លាប់ នៅលើ ទង់ របស់ យើង ។
ហើយ និយាយ ទៅកាន់ កូន ៗ របស់ ខ្ញុំ ។
ខ្ញុំ ចង់ គូរ គូរ រូប ផ្ទាល់ ។
រំឭក ខ្ញុំ អំពី សាសនា ចក្រ នៃ ព្រះ។
18 ខ្ញុំនឹងក្រោកឡើងទៅ ឯឪពុក ហើយនិយាយថា ឱ ព្រះ‌វរ ‌ បិតាអើយ ខ្ញុំបានប្រព្រឹត្តអំពើ បាបទាស់នឹងព្រះ និងទាស់នឹងព្រះ‌ អង្គ ។
យ៉ាង ណាមិញ ម៉ារៀ បានរក្សាទុកនូវរឿងទាំងអស់នេះ ហើយបាន ស ញ្ជឹងគិតក្នុង ចិត្តនាង ។
ការ នៅពីមុខកាមេរ៉ាតែងតែដោះស្រាយ ភាព ស្រេកឃ្លានរបស់គាត់ ។
ពេលដែលម៉ូសេ ព្រមទទួលនៅ ទីបំផុត គាត់សួរថា៖ « តើខ្ញុំប្រាប់អ្នក ណាថាបានចាត់ខ្ញុំមក ?
ខ្ញុំចាប់ផ្ដើមជិះជាមួយឪពុកខ្ញុំនៅអាយុ ១០ ឆ្នាំ ។
ប្រសិនបើ អ្នក ធ្វើ បែប នេះ អ្នក នឹង សម្រេចបាន នូវ អត្ថប្រយោជន៍ ទាំងអស់ ពី ការតម អាហារ ដែល បាន រាយ ខាងលើ ។
៣១ ព្រះ និងជាព្រះវរ បិតានៃព្រះយេស៊ូវ គ្រីស្ទ ជាព្រះអម្ចាស់នៃយើង ដែលបានប្រទាន ពរអស់ កល្ប ជានិច្ច ទ្រង់ជ្រាបថាខ្ញុំមិនកុហកទេ ។
កុំ យល់ច្រឡំ ជាមួយនឹង ការទទួលបាន " ការអនុម័ត ជាមុន " ព្រោះ វា ជា រឿង ពីរ ផ្សេង គ្នា ។
ខ្ញុំចង់ឲ្យអ្នក រាល់គ្នាដឹងថាខ្ញុំដឹងយ៉ាងច្បាស់អំពី អវត្តមានរបស់ខ្ញុំពីការ សរសេរប្លុក ។
កាលណាអ្នកបានសម្រេចនូវបច្ច័យនៃសេចក្តី អត់ ធន់ នោះអ្នកនឹងបានត្រាស់ ដឹងនូវមាគ៌ា និង ផល និង សម្មាធិ ។
ស្រូប យកវា ហើយធ្វើឱ្យពួកគេគ្មានអំណាចដើម្បីធ្វើឱ្យមានគ្រោះថ្នាក់ ។
៤ ដូច្នេះ លោកពី ឡាតមាន ប្រសាសន៍ទៅពួកនាយកបូជាចារ្យ និងបណ្ដាជន ថា៖ « ខ្ញុំ រកឃើញថាបុរសនេះគ្មានកំហុសអ្វីសោះ » ។
ខ្ញុំ មាន ន័យ ថា គាត់ ធ្វើការ ជាមួយ ពួកគេ ។
នាងបាននិយាយថា « នៅពេលដែលព្រះ ព្យាបាលអ្នក នោះអ្នកមិនអាចរក្សា សញ្ញាពិការរបស់អ្នកបានទេ » ។
នោះ ហើយ ជា ភាពស្រស់ស្អាត នៃ ការរៀន
អ្នក អាច ហៅ វិធីសាស្ត្រ វត្ថុ ។
ដប់ មួយនាក់នៃកូនប្រុសរបស់គាត់។
« អ្នកធ្លាប់ប្រកប របរចិញ្ចឹមជីវិតពីការ វិនិច្ឆ័យប្រជាជនក្នុងព្រះរាជាណាចក្រនេះជា សាធារណៈ ហើយអ្នកមាន ចិត្តអាក្រក់ចំពោះពួកបិសាចជាពិសេស ។
៨ ដូចជាការ ទាំងអស់ដែលគេបានធ្វើ ចាប់តាំងពីថ្ងៃដែលយើងបាននាំគេចេញពីស្រុកអេស៊ីបរហូតដល់ថ្ងៃនេះ គេបានបោះ បង់ចោលខ្ញុំ ហើយដើរតាមព្រះដទៃទៀត ។
ខណៈដែលពួកគេកំពុងលាក់ ខ្លួនក្នុងពេលដ៏ត្រជាក់នៃថ្ងៃនោះ ពួកគេបានយល់ថាពួកគេត្រូវបានគេបោកប្រាស់ ។
អ្នក បានបន្តច្រៀង
ប៉ុន្តែ ក្នុងនាមយើងជាអ្នក បម្រើរបស់ព្រះ យើងបានសរសើរខ្លួនយើងក្នុងគ្រប់មធ្យោបាយ ដោយមានការស៊ូ ទ្រាំយ៉ាងខ្លាំង ក្នុងការ បៀតបៀន ក្នុងការ លំបាក ក្នុងការ លំបាក ។
អ្នកអាចមើលឃើញគំរូតូចមួយនៃអ្វីដែលវាដូចជា។
អ៊ីសាក បាន ពន្យល់ ។
រដ្ឋាភិបាលយើងមានស្ថិរភាព » ។
ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ស្រុក មួយចំនួន មាន របៀបវារៈ មួយ ផ្សេង ទៀត ។
រឿងនេះបានបន្តរយៈពេលប្រាំមួយឆ្នាំ មកហើយ ដែលនាងនិយាយថានាងត្រូវបានគេវាយធ្វើ បាបជារៀងរាល់ថ្ងៃ ។
« តើយើងនឹងទៅទិញនំប៉័ងនៅឯណាសម្រាប់មនុស្សទាំងនេះបរិភោគ? »
តាម មធ្យោបាយ ណាមួយ សូម ធ្វើ វា នឹង ជួយ បាន ច្រើន ។
អាហារ ថ្ងៃ ហ្គេម មិន ចាំបាច់ ទុក ឱ្យ អ្នក មានអារម្មណ៍ ថា ត្រូវបាន បណ្តេញ ចេញ នោះ ទេ ។
រាត្រី សួស្តី នៃ ថ្ងៃ នៃ ឆ្នាំ ។
ទ្រង់ បាន ធ្វើ ដូច្នេះ ដើម្បី បង្រៀន អ្នក ថា មនុស្សជាតិ មិន អាច រស់ នៅ ដោយ អាហារ តែ មួយ មុខ នោះ ទេ ប៉ុន្តែ ក៏ ដោយសារ អ្វី ៗ ទាំងអស់ ដែល ចេញ ពី ព្រះឱស្ឋ របស់ ព្រះអម្ចាស់ ផងដែរ ។
នៅក្នុង វិស័យ ភាគ ច្រើន ព្រះវិហារ បាន រីកចម្រើន បន្តិច ម្តង ៗ ។
យើង មិន បាន សង្រ្គោះ ទេ ។
ហេតុ អ្វី បានជា អ្នក មិន ធ្លាក់ចុះ ថ្ងៃ នេះ ?
60 ចំណាប់អារម្មណ៍ ដើម្បី ធ្វើ ដូច្នេះ ។
ដូចជា ប្រសិនបើ ខ្ញុំ មាន របៀបវារៈ ។
អ្នក ជឿដែលមិនអនុវត្តព្រះបន្ទូលរបស់ព្រះ នឹងមិនទទួលបានសេចក្ដី ពិតឡើយ ។
តើយើងអាចធានាខ្លួនយើងយ៉ាងដូចម្ដេចថាពេលក្រោយយើងនឹងអាចក្រោកឈរប្រឆាំងនឹងអំណាចនៃការ ល្បួងរបស់ពស់ ?
ហើយ អ្នក មិន អាច រង់ចាំ ច្រើន សប្តាហ៍ ដើម្បី ចូល វគ្គ ពេញ បាន ទេ ។
វិវរណៈ 5:3 - ហើយគ្មាននរណាម្នាក់អាចនៅស្ថានសួគ៌ ឬនៅលើផែនដី ឬនៅក្រោមផែនដីដើម្បីបើកសៀវភៅឬមើលវាបាន។
នោះ ហើយ ជា មូលហេតុ ដែល ខ្ញុំ អាច ទាត់ តាមរយៈ វត្ថុ នេះ ។
ខ្ញុំ នៅតែ ត្រឡប់ កំហុស ក្នុង មូលដ្ឋាន ប៉ុន្តែ ខ្ញុំ នឹង សាកល្បង វា ផ្ទាល់ នៅ ពេល ដែល ខ្ញុំ ដឹង បន្តិច ។
យប់ នេះ ខ្ញុំ មិន មក យកឈ្នះ អ្នកទេ
អ្នក ទំនងជា នឹង ស្គាល់ ពួកគេ តាម វិធី ដែល ពួកគេ មាន អារម្មណ៍ - ជាមួយនឹង សម្ពាធ គ្រប់គ្រាន់ ពួកគេ ពិតជា អាច ឈឺចាប់ ។
នេះ ជា អ្វី ដែល នឹង កើតឡើង ប្រសិនបើ អ្នក មិន ធ្វើ៖
ខ្ញុំ មកនេះខួរក្បាលខ្ញុំ ។ ខ្ញុំ
ក្នុងសុបិនខ្ញុំបានច្រៀងជាច្រើន ។
វា ត្រូវបាន រាយ ក្នុង សៀវភៅ មួយចំនួន ។
វា ជា បញ្ហា អាប់ ដេត គេហទំព័រ ក៏ ដូចជា
គ្រាន់តែ ត្រូវ ចូល ទៅក្នុង បន្ទប់ កុមារ ដើម្បី ដំឡើង ពួកគេ ។
កន្លែង ទាំងនេះ នៅលើ ផែនដី គួរឱ្យ ខ្លាច ណាស់ ។
យើង ខាតបង់ តិច ជាង មួយ ឆ្នាំ ។
ប៉ុន្តែ នៅ ពេល ដែល អ្នក បន្ថែម ក្រែម ធ្ងន់ ស៊ីរ៉ូរសជាតិ ។
ខ្ញុំ ខ្លាំង ជាង ព្រះ។
« ព្រោះខ្ញុំបានធ្វើការប ន្សុទ្ធ » ។
ទោះបីជាយ៉ាង ណាក៏ដោយ គាត់បាត់ខ្លួនអស់ រយៈពេលរាប់ខែ ហើយក៏លេចមុខម្ដងទៀត ។
វា ជា សោកនាដកម្ម ដ៏ ធំ បំផុត ក្នុង ជីវិត របស់ ពួកគេ ។
កាលពី ខែ មុន យើង បាន ទទួលស្គាល់ ស្ត្រី សំខាន់ ៗ នៅក្នុង ជីវិត របស់ យើង ដោយ ផ្តោត លើ ម្តាយ របស់ យើង ។
ទំនោរ តិចតួច ដើម្បី រក្សាទុក វិគី ភីឌា
ឪពុក ម្តាយ ត្រូវបាន រក្សាទុក នៅ ប្រវែង ដៃ ។
បន្ទាប់មកមាសបានវាយ បក ។
ចាប់ពីថ្ងៃនោះមក គេឧទ្ទិសព្រលឹងដល់លោក ហ៊ុន សែន ។
នេះ នឹង ត្រូវ ធ្វើ តាមរយៈ សមាគម លំនៅដ្ឋាន ។
ព្រោះគេនឹងស្លៀកសម្លៀក បំពាក់
