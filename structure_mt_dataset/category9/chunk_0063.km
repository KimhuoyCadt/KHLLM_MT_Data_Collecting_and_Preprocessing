« មើល អញទាស់នឹងឯង ព្រះចៅផារ៉ោន ជាស្តេចស្រុកអេស៊ីប ជានាគ ដ៏ធំ ដែលគង់នៅកណ្តាលទន្លេ ដែលពោលថា ទន្លេរបស់អញជាទន្លេ ហើយអញបង្កើតវាឡើង ។
ពេលគាត់មើលលោកយេស៊ូដើរកាត់ គាត់មាន ប្រសាសន៍ ថា៖ « មើលចុះ កូនចៀមរបស់ព្រះ!» ។
ដូច្នេះ ចាប់ពីពេលនេះទៅ មានអ្នក កាន់តាមលោកជាច្រើនបានត្រឡប់ទៅវិញ ហើយលែងដើរតាមលោកទៀតហើយ ។
« យើងគួរតែ តវ៉ានឹងវិក័យប័ត្រ » ។
មិត្ត ដែល មិន ចង់ឱ្យ អ្នកស្លាប់ ដើម្បី គាត់ ប៉ុន្តែ អ្នក នឹង ចង់ ស្លាប់ សម្រាប់ គាត់ សម្រាប់ អាកប្បកិរិយា ស្រឡាញ់ និង យកចិត្តទុកដាក់ របស់ គាត់ ។
3 នៅថ្ងៃ ស ប្ប័ទ អ្នកមិនត្រូវដុតភ្លើងក្នុងផ្ទះរបស់អ្នកឡើយ » ។
ហើយ មនុស្ស ចង់ ផ្លាស់ប្តូរ ។
ខ្ញុំគ្រាន់ តែអង្គុយនៅទីនេះរង់ចាំសាលក្រម ។
វា នឹង ត្រូវ បញ្ចប់ នៅ ប៉ុន្មាន ថ្ងៃ ខាងមុខ ។
“ មិនឆ្ងល់ទេថាហេតុអ្វីបានជាអ្នក រាល់គ្នាដើរព្រៃយប់មិញ ?
ស្ត្រីម្នាក់, តាមដានជាមួយនឹងរបស់អ្នក។
វាជាទីក្រុងតូចបំផុតក្នុងចំណោមទីក្រុងទាំង ១០ ។
ឥឡូវនេះ វា អាក្រក់ ហើយ វា អាក្រក់ គ្រប់គ្រាន់ ហើយ ។
មាន ការងឿងឆ្ងល់ ជាច្រើន ដែល បាន ក្លាយជា មនុស្ស រឹងរូស នៅក្នុង ជីវិត របស់ ពួកគេ ពី អំពើ បាប - ទោះបីជា វា ជា រឿង ដ៏ គួរឱ្យ តក់ស្លុត ដែល វា គួរតែ ដូច្នេះ ក៏ដោយ - ដោយ ការពិត ដែល ថា ពួកគេ ជឿ ថា ព្រះត្រៀមខ្លួន រួច ជាស្រេច ដើម្បី អត់ទោស បន្លា ។
ការ ស្ម័គ្រ ចិត្តរបស់ អ័ ប្រាហាំក្នុងការ គោរពតាម បញ្ជានេះមិនមែនជាឧទាហរណ៍នៃជំនឿខ្វាក់ឡើយ ។
បន្ទាប់មក គាត់បាននិយាយពីការសន្ទនាដែលគាត់បានមានជាមួយឪពុកគាត់ជាមុន ហើយដំបូន្មានក៏បានចែកជូនគាត់ ។
ព្រះបាន ប្រទាន ដល់ ខ្ញុំ ។
តើអ្វីអាចល្អជាងការ សម្ដែងរបស់តារាទាំងអស់ដែល រស់នៅក្នុងសម័យមួយដែលពោរពេញទៅដោយ ភាព ច្របូកច្របល់ ?
រកមើល នៅលើ ពិដាន នៅ ទីនេះ ។
ហើយបើអ្នក ណាប្រព្រឹត្តអំពើ បាប យើងមានអ្នក តស៊ូ មតិជាមួយនឹងព្រះវរ បិតា គឺព្រះ យេស៊ូវគ្រីស្ទ ។
ខ្ញុំ អាច ធ្វើ បាន ប៉ុន្តែ យើង នឹង បាត់បង់ ទាហាន និង ប៉ូលីស របស់ យើង ទាំងអស់ នៅ ថ្ងៃស្អែក ហើយ យើង គឺជា ប្រទេស ដែល ត្រូវបាន បំផ្លាញ ” ។
ពេល សាងសង់ រួចរាល់ វា នឹង ក្លាយជា ផ្ទះ ក្នុង ក្តីស្រមៃ របស់ ពួកគេ ។
7 ការពិចារណា ថា តើ អ្នក ត្រៀមខ្លួន ជាស្រេច ដើម្បី ក្លាយជា អ្នកដឹកនាំ ដំបូង
ហើយពេលដែលឪពុកម្តាយរបស់គាត់បានឃើញទ្រង់ ពួកគេភ្ញាក់ផ្អើល ។
ចូរប្រាប់ពួកកូនចៅអ៊ីស្រា ‌ អែលថា ពេលអ្នក រាល់គ្នាចូលទៅក្នុងស្រុកដែលយើងប្រគល់ឲ្យអ្នក រាល់គ្នា ហើយនឹងច្រូតកាត់ហើយ នោះអ្នក រាល់គ្នាត្រូវយកកួរ ផលដំបូងនៃការ ច្រូត មកថ្វាយបូជា ‌ចារ្យ ។ .
ថ្ងៃសុក្រ របស់ យុវជន
វីដេអូនេះក៏ត្រូវបានចាក់ក្នុងអំឡុងពេលនៃអយ្យការ
« ហើយកំពែងក្រុងមាន គ្រឹះដប់ ពីរ ហើយក្នុងនោះមានឈ្មោះសាវកនៃកូនចៀមទាំងដប់ ពីរនាក់ » ។
« ហើយកំពែងក្រុងមាន គ្រឹះដប់ ពីរ ហើយក្នុងនោះមានឈ្មោះសាវ័កទាំងដប់ ពីរនាក់របស់កូនចៀម » ។
ហើយបានហៅឈ្មោះមនុស្សជាទី ស្រឡាញ់ដែលបានចាកចេញជាច្រើន រួចនិយាយថា៖
នាំ គាត់ ទៅ កាលីឡេ ។
