ភាពស្រស់ស្អាត ភាព ទាក់ទាញ គឺជា ក្តីសុបិន្ត ដែល នារី គ្រប់ រូប តែងតែ ស្រម៉ៃ ចង់បាន ឱ្យ ក្លាយជាពិត ។
ប៉ុន្តែ ទោះជា យើង ទ្រាំ យ៉ាងណា ការបែកបាក់ វា មាន ស្រេច ទៅ ហើយ ។
សិស្សសាលា ចំនួន ១០នាក់ ទៀត ផង ។
ចុះ ហេតុ អ្វី បានជា មាន ការចោទប្រកាន់ លើ ព្រះអង្គ ?
ដល់ ចុងក្រោយមក ខ្ញុំ ធ្វើ ពាក្យ ប្តឹង លោក សង្ឃ ហ្នឹង ដាក់ ទៅ តុលាការ ខេត្ត ព្រៃវែង ។
ប៉ុន្តែ វា មិន គ្រប់គ្រាន់ សម្រាប់ ម្ចាស់ ឡើយ ។
ទិវា មនុស្ស ចាស់ កម្ពុជា និង ទិវា មនុស្ស ចាស់ អន្តរជាតិ ១តុលា២០១៩ - វិមាន ៧មករា
លោក វែកន័រ បាន និយាយ ថា ខ្ញុំ សប្បាយ ចិត្ត ដែល ម៉ាក ក្លាយជា ផ្នែក មួយ នៃ ក្រុមការងារ បង្វឹក របស់ ខ្ញុំ ។
ចន្ទា ទេវី រាហុល មាតា ព្រះនាង ចន្ទា ទេវី បាន មក ជា រាហុល មាតា ។
ការកាត់ អប្បហារ នៅ រតនាគារ ជាតិ ក៏ មាន ។
៦ពេល ខ្ញុំ ចូលទៅ គាល់ ព្រះអម្ចាស់
ទៀត របស់ ចិន នៅតែ ស្ថិត ក្នុង ជម្រើស ដដែល ៕
លោក បន្ត ថា សមយុទ្ធ យោធា មាន សារៈសំខាន់ ខ្លាំង ណាស់ ។
ការកសាង សកម្មជន វ័យ ក្មេង ដែល ប្រើប្រាស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម នៅ កម្ពុជា
សមាសភាព នៃ អ្នកលេង ល្បែង នេះ មាន ៤
ភ្ជាប់គ្នា របស់ អ្នកកាស ទៅ អ្នកចែក ផ្លូវ ៥ផ្លូវ របស់ អ្នក ។
ក្រោយពី ការបំភ្លឺ រយៈពេល ជាង ៣ ម៉ោង កញ្ញា ស្រី មុំ បាន លើកឡើង ថា នាង ត្រូវបាន សួរ ឱ្យ បញ្ជាក់ ថា តើ សំឡេង ដែល ត្រូវបាន គេ ទម្លាយ តាម ហ្វេសប៊ុក នោះ ជា សំឡេង របស់ នាង ឬ យ៉ាងណា ។
គាត់ គួរ ទទួល តុរង្វាន់ ផ្សេង ក្រៅពី ម៉ូតូ នេះ បើ ពិនិត្យ ពី អាយុ របស់ គាត់ ។
គាត់ គឺជា អ្នកមើល ការខុសត្រូវ ពីលើ យាយ យុត ។
ដើម្បី ទិញ ផលិតផល ប្រចាំ ក្រុម របស់ ពួកគេ ។
វ័យ ជាង ៨០ ឆ្នាំ ព្រឹទ្ធាចារ្យ ស្វាយ សរ មិន បោះបង់ អាជីព
ហេតុ នេះ ហើយ ទើប បានជា តារាចម្រៀង ដែល ល្បី ខ្លាំង ពិបាក នឹង រក អ្នក មក ស្នង តំណែង បន្ត សម្លេង ខ្លាំង ណាស់ ។
ពេត្រុស ប្រកាស ថា ព្រះយេស៊ូ ជា ព្រះគ្រិស្ត
សាលាដំបូង រាជធានី ភ្នំពេញ ចេញ ដីកា ជា …
ភាព វិជ្ជមាន គឺជា ជម្រើស មួយ សុភមង្គល ក្នុង ជីវិត របស់ អ្នក អាស្រ័យ លើ គុណភាព នៃ គំនិត របស់ អ្នក ។
ឯកឧត្តម ងីច ន្ទ្រផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ គឺជា ប្រធាន សម្របសម្រួល គម្រោង ។
ក្រុម អ្នកទោស បាន បំផ្ទុះ អាវុធ និង ចាប់ សន្តិសុខ ធ្វើជា ចំណាប់ខ្មាំង ហើយ អំពើហិង្សា នេះ បាន បណ្តាលឱ្យ មនុស្ស ចំនួន ៧នាក់ ស្លាប់ ។
នេះ ជា ការគំរាមកំហែង មួយ ជាជាង ទង្វើ ឆ្ពោះ ទៅរក ការបន្ធូរ ភាពតានតឹង ។
នេះ បើ តាម រដ្ឋមន្ត្រី ការបរទេស វ៉េណេស៊ុយអេឡា ។
គួរ បញ្ជាក់ ដែរ ថា ករណី នេះ ក៏ មាន ការ ដឹង លឺ ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី ផងដែរ ។
ដែល ស្ថិត នៅ ឃុំ ក្សេមក្សាន្ត ស្រុក ឧដ្តុង្គ ខេត្ត កំពង់ស្ពឺ ។
សម្រាប់ អ្នក ញៀន គឿង ញៀន មក ទទួល សេវា ពិនិត្យ ព្យាបាល ដោយ រដ្ឋ ជា អ្នកបង់ ថ្លៃ ជំនួស
លើកកម្ពស់ ការយល់ដឹង ជាសាធារណៈ អំពី សារៈប្រយោជន៍ នៃ សន្តិសុខ សង្គម ។
ទន្ទឹមនឹង នេះ លោក ប្រធានាធិបតី ត្រូវបាន កង សន្តិសុខ នាំ ចាកចេញ ពី ទីកន្លែង នោះ ផងដែរ ។
ទិញ របស់ ញ៉ាំ ខាងក្រៅ ដែល អាច ប៉ះពាល់ ដល់ សុខភាព បាន ។
ស្តាប់ ទៅ ហាក់ដូចជា រឿង ភូតភរ ប៉ុន្តែ វា ជា ការពិត ។
ហើយ នៅ ឆ្នាំ ១៩០៨ ការិយាល័យ និង រោងចក្រ ថ្មី ៗ
រដ្ឋមន្ត្រី កសិកម្ម ពន្យល់ រឿង មិន បិទ ការនាំចូល ជ្រូក
លោកស្រី មានប្រសាសន៍ ថា បេក្ខភាព មេឃុំ អាយុ ក្មេង មិន មែន ជា បញ្ហា នោះ ទេ ។
នៃ ទំនាក់ទំនង អន្តរជាតិ …
ផះ រុសុវាទ ការជេរប្រទេច ប្រមាទ តិះដៀល ដៀម ដាម … ។
យើង បាន លេង ដើម្បី ឈ្នះ ពេល ជួប ក្រុម មីយ៉ាន់ម៉ា ដែល មាន បទពិសោធ ច្រើន ជាង ។
ស៊ូ ថេប បាន និយាយ ថា អ្នក អាច ធានា ថា នេះ ជា ជ័យជម្នះ មួយ តែ គ្រាន់តែ ជាមួយចំណែក … ពីព្រោះ រដ្ឋាភិបាល ផ្តាច់ការ ថាក់ស៊ីន នៅតែ មាន ។
សន្សំ ប្រាក់ អ្នក ក្នុង រយៈពេល វែង …
ក្រោយពី កាន់អំណាច អស់ រយៈពេល ១៦ ឆ្នាំ ។
រកមើល មូលហេតុ ដែល មិន ធាត់ ខ្លាច កើត ជម្ងឺ ស្រាល
ម្យ៉ាងទៀត សម្រៀកបំពាក់ នេះ ត្រូវបាន បង្ហាញ ម៉ូត ដោយ តារា ល្បី ៗ
ព្រ មាន ឡើង ថា ក្រុម លោក នឹង រឹបអូស ទ្រព្យសម្បត្តិ របស់ ក្រុមគ្រួសារ ត្រកូល ហ៊ុន វិញ …
តែ គ្រាន់តែ ថា ចំពោះ ខ្ញុំ ទេ ខ្ញុំ យល់ ថា ការប្រឈម របៀប នេះ វា ល្អ ជាង ការប្រឈម របៀប កាន់ អាវុធយុទ្ធភ័ណ្ឌ សម្លាប់ គ្នា ទៅ វិញ ទៅមក ។
លោក ហ៊ុន សែន ព្រមាន បោះឆ្នោត ទម្លាក់ លោក កឹម សុខា ពី អនុប្រធាន ទី១ នៃ រដ្ឋសភា
លោក ហ៊ុន សែន ព្រមាន បោះឆ្នោត ទម្លាក់ លោក កឹម សុខា ពី អនុប្រធាន ទី១ នៃ រដ្ឋសភា
សាលា មួយ ខ្នង ទើបនឹង កសាង បាន ប្រមាណ ៣ខែ គឺ នៅ មាន ការខ្វះខាត សម្ភារៈ សព្វ បែប យ៉ាង ។
អ្នក គួរ សាកល្បង យក តុក្កតាមក លេង ជាមួយ កូន យ៉ាង សប្បាយរីករាយ ឬ និទាន រឿងរ៉ាវ កំប្លែង ៗ
កំណាព្យ ដី មួយ ចំណិត
ក្នុង ចន្លោះ វ័យ ពី ១៨ ឆ្នាំ ទៅ ២៥ ឆ្នាំ ជា ពេលវេលា នៃ ការប្រែប្រួល ដ៏ សំខាន់ មួយ ចំពោះ យុវជន ទាំងឡាយ ប្រៀប ដូច សត្វ បក្សី ដែល កំពុង ដុះ ស្លាប ត្រូវ ចាកចេញ ពី សំបុក ស្វែងរក ចំណីអាហារ ដោយ ខ្លួន ឯង ដូច្នេះ ដែរ ។
ក្នុង ក្រុង នេះ និង បាន បន្ធូរបន្ថយ ឱ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ឆ្លង ដែន បាន ងាយស្រួល ជាង កាលពី ចុង សប្តាហ៍ កន្លងទៅ ។
ប្រាប់ ទៅ អាខា បី ម៉ាត់ ទៀត ចុះ ថា ឥឡូវ គេ មាន កម្មវិធី សន្ទនា ជាមួយ រដ្ឋាភិបាល ។
ប៉ុន្តែ នៅ ពេល នេះ សម្លឹងមើល រូបថត ដែល នាង ថត រូប នៅក្នុង បន្ទប់ នោះ នាង ភ័យ ដល់ ថ្នាក់ លោះ ព្រលឹង ។
ខ្ញុំ ចាត់ទុក ពួកគេ ថា ជា រូប យន្ត ខ្មោច ។
អ៊ីចឹង បាន ជា កម្មករ ឈប់ ។
គណបក្ស ប្រឆាំង បាន អះអាង ថា មាន ភាព មិន ប្រក្រតី ជាច្រើន កើត មាន ឡើង នៅក្នុង ការបោះឆ្នោត ថ្ងៃទី ២៨កក្កដា ។
អ្នក ជា មនុស្ស ដែល ធ្វើ អ្វី ៗ
មួយ ជួនកាល អាច ជឿ លើ រឿង ដូចគ្នា ឬ មិន ដូចគ្នា គឺ អាស្រ័យ ទៅ លើ ការយល់ឃើញ របស់ ពួកគេ ដែល អ្នក ខ្លះ គេ ជឿ ទៅ លើ កម្លាំង អាទិទេព កម្លាំង ធម្មជាតិ ជឿ លើកម្លាំង កាយ កម្លាំង ប្រាជ្ញា ឬ មុខមាត់ រាងកាយ មនុស្ស ធៀប នឹង អត្តចរិត ល្អ ឬ អាក្រក់ ។
ក្រៅពី នេះ ក៏ មាន ការ បញ្ឈប់ ថ្នាក់ដឹកនាំ សហជីព និង កម្មករ ពី ការងារ ជាង ១ ពាន់ នាក់ ។
៥ធ្វើ ដូច្នេះ ដើម្បី ឃាត់ ជនជាតិ អ៊ីស្រាអែល មិន អោយ សម្លាប់ សត្វ ធ្វើយញ្ញ បូជា នៅ តាម ទី វាល ។
ច្បាស់ ណាស់ ពួកគេ បាន បង្កើន សន្ទុះ នៃ ការធ្វើ សមយុទ្ធ យោធា នៅក្នុង តំបន់ ៕
ពាក់ព័ន្ធ នឹង បញ្ហា នេះ លោក មូន នៅ មិន ទាន់ តប តាម ការអញ្ជើញ ភ្លាម ៗ
នាម និង គោត្ត នាម ជា ច័ន្ទ បរិបូណ៍
ពីមុន មក គឺ លោក ជា សុវណ្ណា រិទ្ធ បាន បង្ហោះ សារ រៀបរាប់ ថា
លោក បន្ត ថា ការដកហូត និង ការត្រួតពិនិត្យ គឺ ត្រូវ យក ច្បាប់ ជា គោលការណ៍ ។
តែ គេ ថា មាន អ្នក ចេះ ចង់ ធ្វើបាប មាន វីដេអូ ខ្មែរ ស្ថាបនា
បុរស ម្នាក់ ត្រូវ អណ្តើក ខាំ ប្រដាប់ ភេទ ជាប់ មិន លែង មាន វីដេអូ
បើ សង្សារ មិន សួរនាំ អ្វី ទេ មិន បាច់ប្រាប់ គេ ថា ខ្លួន ធ្លាប់ មាន សង្សារ ពីមុន មក ទេ ។
ប្រភព ពី មន្ត្រី នគរបាល ចរាចរ បាន ប្រាប់ ថា កញ្ញា សាសា ត្រូវបាន ជម្លៀស ចេញ ភ្លាម ៗ
មេធាវី នួន ជា ស្នើ ឱ្យ មាន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង មន្ត្រី ជាន់ ខ្ពស់ ដទៃ ទៀត ចូល បំភ្លឺ
ទិវា សេរីភាព សារព័ត៌មាន ពិភពលោក នឹង ចូល មកដល់ នៅ ថ្ងៃទី ២៥មេសា នេះ ហើយ ។
កុំព្យូទ័រ ដ៏ ចាស់ បំផុត នៅលើ ពិភពលោក ត្រូវបាន គេ ធ្វើអោយ មាន ដំណើរការវិញ
ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង គណបក្ស កាន់អំណាច ទាំង ពីរ ។
ក្នុង ស្រុក ប្រឈម បិទ ទ្វារ ឆាប់ ៗ
ពាក់ព័ន្ធ នឹង ករណី នេះ លោក សុខ ឥសាន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា ៖
ប៉ុន្តែ បុគ្គល ទាំងនេះ គឺជា មនុស្ស ដែល មាន ចិត្ត ទូលាយ ៕
ខណៈ ដែល មាន មនុស្ស មួយចំនួន គិត ថា ពេលព្រឹក ជា ពេល ដែល ពួកគេ អាច សម្រេចបាន កិច្ចការ តិច ជាង គេ …
ការរំជួល ចិត្ត អាណិត មាតា ខ្ញុំ ក៏ ចាប់ផ្តើម ឡើង យ៉ាង ឆាបឆេះ … ខ្ញុំ ចង់ ស្រក់ ទឹកភ្នែក នៅក្រោម ផ្ទះ គេ ។
ស្នេហា ភេទ ដូចគ្នា ឪពុក ម្តាយ ខាង តួរ ស្រី ចាប់ យក កូន ត្រឡប់ ទៅ ផ្ទះ វិញ រស្មី កម្ពុជា
នាង បាន ត្រឹមតែ បង្ហើរ ចម្លើយ សើ ៗ
ព័ត មាន លំអិត សូម ទាក់ទង ផ្ទាល់
រដ្ឋធម្មនុញ្ញ កម្ពុជា គឺជា ច្បាប់ កំពូល របស់ ព្រះរាជាណាចក្រ កម្ពុជា ដោយ ដាក់បញ្ចូល នូវ តម្លៃ ដូចជា នីតិរដ្ឋ សិទ្ធិ មនុស្ស លទ្ធិ ប្រជាធិបតេយ្យ និង ការបែងចែក អំណាច យ៉ាង ជ្រៅ នៅក្នុង ប្រព័ន្ធ ច្បាប់ និង នយោបាយ របស់ កម្ពុជា ។
គ្រុន ផ្តាសាយ ជំងឺ ដែល ងាយ កើត ជា ទីបំផុត ជាពិសេស ទៅ លើ មនុស្ស ចាស់ អ្នក ដែល មាន ប្រព័ន្ធ ភាពស៊ាំ ខ្សោយ និង កុមារ ។
រមណីយដ្ឋាន បន្ទាយស្រី ខំ ប្រឹង បញ្ចេញ សម្រស់ តែ …
សម្រាប់ យើង យើង ធ្វើ ការជួយ មិន ត្រឹមតែ ប្រជាពលរដ្ឋ ទេ យើង ធ្វើ ការជួយ ដល់ រដ្ឋាភិបាល ។
បទដ្ឋាន ទាំង ប្រាំពីរ ខាងលើ សុទ្ធតែ បាន អនុវត្ត បិទ តាម ខ្សែ សង្វាក់ ស្វ័យប្រវត្តិ ។
ផលិតផល ពិត ការដឹកជញ្ជូន លឿន តម្លៃ ល្អ បំផុត ៖
នៅក្នុង រយៈពេល ជាង ៤០ ឆ្នាំ នេះ សង្គ្រាម ត្រជាក់ ត្រូវបាន គេ បែងចែក ជាច្រើន ដំណាក់កាល ។
អ៊ីចឹង ត្រូវការចរចា បន្ថែម ។
អាការ នេះ ជា បញ្ហា ភាគ ច្រើន របស់ ស្ត្រី ដោយសារ ការធ្វើ ការងារ ផ្ទះ ឬ ថែ សួន ។
ចំណែកឯ ការប្រកបរបរ រក ទទួលទាន ផ្សេង ៗ
ទន្ទឹមនឹង នេះ អ្នកនយោបាយ នោះ បាន ពន្យល់ គេ ថា អ្នក ដែល ខ្លួន ជេរ បញ្ចោរ គឺ សក្តិសម នឹង ខ្លួន ជេរ បញ្ចោរ ហើយ ។
ដោយ រក នឹក មួយ សន្ទុះ គឹម លីហ្សា បាន និយាយ ដោយ បដិសេធ ស្រាល ៗ
ប៉ុន្តែ របៀបរបប នៃ ការពន្យារ កំណើត អចិន្ត្រៃយ៍ បែប នេះ មិន ស្រប តាម ជំនឿ សាសនា នោះ ទេ ។
ការធ្វើ សន្និសីត កាសែត នា ព្រឹក នេះ ហាក់ដូច ប្លែក ខុស រាល់ ដង , ធ្វើឱ្យ ក្រុម អ្នកសារព័ត៌មាន ដែល កំពុង នៅ ទីនោះ មាន ភាព ងឿងឆ្ងល់ ថា , តើ លទ្ធផល កិច្ចប្រជុំ នោះ នឹង វិវឌ្ឍ ទៅជា យ៉ាងណា ?
នៅក្នុង គម្រោង ទាំងនោះ ប្រហែលជា មាន ខ្លះ ដែល អ្នក ទាំងអស់ គ្នា ធ្លាប់ បាន លឺ និង ដឹង រួចទៅហើយ ។
កំណើន ប្រាក់ ចំណូល របស់ ប្រជាជន ថ្នាក់ កណ្តាល នៅតែ ពុំ អាច តាម ទាន់ កំណើន តម្លៃ អចលន ទ្រព្យ
រឿង ចៅ ខ្សែក្រវ៉ាត់ ទិព្វ ភាគ ទី១ ពិតជា កម្សត់ មែន មាន វីដេអូ
ឯកឧត្តម ជា សុផារ៉ា ចេញ លិខិត ចំនួន ពីរ គាត់ ក៏ អត់ ធ្វើ តាម ។
គ្មាន បញ្ហា កើតមាន ក្នុង មង្គលការ កូនស្រី ថៅកែ ក្រុមហ៊ុន ជីប ម៉ុង ទេ
ទាំង មុន និង ក្រោយពេល បោះឆ្នោត រហូត
ដែល បាន ហូប ចំណីអាហារ នានា ត្រូវ វេចខ្ចប់ និង ទុកដាក់ ឱ្យ បាន ត្រឹមត្រូវ ដើម្បី ជៀសវាង បោះចោល គ្មាន សណ្តាប់ធ្នាប់ នាំឱ្យ ប៉ះពាល់ ដល់ បរិស្ថាន ឆ្នេរ ។
ទៀត ដែល ប៉ះពាល់ ដល់ ផ្ទៃ មុខ ។
ចេញ អោយ ស្អាត ដាក់ ក្នុង ភាជនៈ ដែល អាច ធន់ នឹង កម្ពៅ បាន
ការដើរ ទៀងទាត់ នឹង ពង្រឹង ដល់ កម្រិត ជាតិ ស្ករ ក្នុង ឈាម ជាង ការរត់ កីឡាទៅ ទៀត ។
តាម ផ្ទះ ស្តាប់ បណ្តើរ និង អង្គុយ ផឹក ស៊ី បណ្តើរ នៅក្នុង ឱកាស នេះ ។
មិន សូវ មាន ទំនុកចិត្ត ខាង ផ្លូវភេទ
ទឹម រដ្ឋា ថា មាន បុរស សុំ ស្នេហ៍ ច្រើន តែ នាង មិន ទាន់ សំរេចចិត្ត
ដំណោះស្រាយ តាម មាត់ ស៊ីរ៉ូ
