តើ សកម្មភាព ទាំងនេះ មិន មែន ជា អំពើពុករលួយ ឬ យ៉ាងណា ?
ឧស្សាហកម្ម កុំព្យូទ័រ ប្រសិន បើ វា គឺ ជា ការ នៅ តែ ពាក់ព័ន្ធ ។
បន្លប់ ខ្លួន ឯង ថា គ្មាន ការឈឺចាប់ ៖
ត្រូវបាន តុលាការ ដោះស្រាយ នៅ ទូទាំង ប្រទេស ស្រប ពេល ដែល រយៈពេល នេះ ក៏ មាន សំណុំរឿង ថ្មី ៗ
ទៀត នៅ ក្នុង ខណ្ឌ ទាំងមូល ។
ដូច្នេះ ចេញ ពី ផលិតផល ដែល គេ ខំ ផលិត សម្រាប់ ទុក បរិភោគ នេះ ឯង ដែល ទាំងនេះ ជាប្រភព ឬ ជាហតុ នាំឲ្យ កើតមាន កម្មសិទ្ធិ ។
២០៣០ កម្ពុជា នឹង ក្លាយជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់
សូម អោយ អស់ អ្នក ដែល ចង់ ធ្វើ អោយ ទូលបង្គំ
ទិដ្ឋភាព ប្រឡង បាក់ ឌុប ក្នុង ខេត្ត កំពត ព្រឹក នេះ មាន លក្ខណៈ ល្អ ប្រសើរ
និង បុត្រធីតា ព្រមទាំង ចៅ មាន ទុក្ខ ជា ទម្ងន់ ដោយ
ខ្ញុំ ពិត ជា សុំទោស ដោយ ស្មោះ ទៅ ដល់ បុគ្គលិក ទាំង អស់ ដែល បាន បន្ត ធ្វើ ការងារ របស់ ខ្លួន យ៉ាង ស្ងៀមស្ងាត់ ទោះ បី មាន ព្យុះ រិះគន់ ខ្លាំង ។
ហើយ កំពង់ផែ ជា កន្លែង ដ៏ ល្អ សម្រាប់ ការ ត្រូត ពិនិត្យ ។
ទើប ភិក្ខុ ទាំងនោះ មាន សេចក្តី សង្ស័យ ថា យើង ទាំងឡាយ ត្រូវ អាបត្តិ បារាជិក ទេ ដឹង ។
លោក បាន បន្ថែម ថា ដោយ សន្មត ថា ទីភ្នាក់ងារ ម្ហូប អាហារ និង ឱសថ របស់ សហរដ្ឋ អាមេរិក ផ្តល់ ការ អនុញ្ញាត ចំពោះ វ៉ាក់សាំង ទាំង នេះ បន្ទាប់ពី ការ ត្រួត ពិនិត្យ របស់ ពួកគេ មក " នៅ ពេល ដែល សាធារណជន អាមេរិកាំង ឮ អំពី ដំណឹង នេះ ពួកគេ ត្រូវតែ ជឿជាក់ " ថា វ៉ាក់សាំង ទាំង នេះ មាន សុវត្ថិភាព " ៕
សម្រាប់ ជីវិត រស់ នៅ របស់ ប្រជាពលរដ្ឋ អោយ បាន សមរម្យ ។
ទីនេះ មាន ច្រើន តែ រុក្ខជាតិ ក្រិន ។
រដ្ឋាភិបាល ក្រុង តូក្យូ ទទូច ថា ការសម្រេច ចិត្ត របស់ ខ្លួន ត្រូវ បាន ជំរុញ ដោយ ការ ព្រួយ បារម្ភ អំពី សន្តិសុខ ជាតិ ។
នៅពេល ដែល ដំបៅ នៅក្នុង ក្រពះ កាន់ តែ រីក ធំ បន្ដិច ម្ដង ៗ
ឲយ ដឹង ថា ក្នុង រយៈពល ១៧ឆាំ រដា
