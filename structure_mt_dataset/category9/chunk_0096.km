លោក ថា មិន មាន អ្នក បាត់បង់ ជីវិត ក្នុង ហេតុការណ៍ នោះ ឡើយ ។
តែងតែ ធ្វើ សង្គ្រាម ជាមួយ ប្រទេស ជិត ខាង របស់ ខ្លួន ។
និស្សិត ថៃ រាប់ រយ នាក់ នាំគ្នា ត វ៉ា ទាមទារ ឲ្យ លោក ប្រា យុទ្ធ ចាន់ អ៊ូ ចា ចុះចេញ ពី តំណែង
អ្នកនាង កែវ ស្រី នាង និង អ្នកនាង ឈួន សុវណ្ណ ឆៃ
ក៏ដោយ ចុះ វា មន
មិន ត្រឹមតែ ភាសា អក្សរសាស្រ្ដ
ទោះបីជា មាន រឿងរ៉ាវ បែប នេះ ក្តី តែ ទំនាក់ទំនង ខ្ញុំ ជាមួយ ម៉ែ បុប្ផា គឺ នៅ ដដែល ហើយ ខ្ញុំ នឹង ថត រឿង ក្រោយ ៗ
អញ្ចឹង ឲ្យ ក្មួយ ៗ
មហារីក សុដន់ មហារីក ប្រូស្តាត មហារីក សួត មហារីក ពោះ វៀន ធំ ជា ដើម ។
គឺ មាន ទាំង មនុស្ស ខ្វាក់ មនុស្ស ខ្វិន
ស្ថានភាព ប្រហាក់ ប្រហែល គ្នា នេះ ដែរ កំពុង តែ កើតឡើង ក្នុង សង្គម យើង ។
ប៉ុន្តែ មូលហេតុ មួយ ផ្នែក ក៏ ផ្តើម ចេញ ពី អ្នក ដែរ ។
មិន មែន ស្ត្រី ទាំងអស់ សុទ្ធតែ ចាញ់ កូន នោះ ទេ ។
យក ទៅ ដាក់ទោស តាម ច្បាប់ ទើប អាច កាត់បន្ថយ បទល្មើស ជួញដូរ ចែកចាយ ប្រើប្រាស់ គ្រឿងញៀន ប្រកបដោយ ប្រសិទ្ធភាព ពិតប្រាកដ ។
ឥឡូវ ដល់ ពេល ដែល ត្រូវ ចាប់ផ្តើម ជីវិត ស្ងប់ស្ងាត់ មួយ និង ចាប់ផ្តើម គ្រួសារ ផ្ទាល់ខ្លួន របស់ ខ្ញុំ ហើយ " ៕
ការ ចូល ជ្រៅ ទៅ ក្នុង ការ ស្រាវជ្រាវ ពិសោធន៍ គឺ ខ្ញុំ កំពុង ធ្វើ ការ ស្រាវជ្រាវ វិទ្យាសាស្ត្រ សម្រាប់ ពេល បច្ចុប្បន្ន ។
ប្តី ប្រពន្ធ នេះ អស្ចារ្យ មែន ហើយ !
ព្រះអម្ចាស់ ត្រាស់ ហៅ ខ្ញុំ
ខ្ញុំ ខ្លាច គេ ធ្វើ បាប ខ្ញុំ យប់ ព្រលប់ ។
ព្រះចន្ទ ក៏ បាន ជួយ ឲ្យ ចលនា វិល ជុំវិញ ខ្លួន ឯង របស់ ផែនដី ត្រូវ បន្ថយ ល្បឿន ផងដែរ ដែល ជា ហេតុ ធ្វើ ឲ្យ ថ្ងៃ នៅលើ ភព ផែនដី មាន រយៈពេល កាន់តែ វែង ពោលគឺ មួយ ថ្ងៃ ដែល ពីមុន មាន ត្រឹមតែ ៦ ម៉ោង ត្រូវ អូសបន្លាយ ពេល បន្តិច ម្តង ៗ
ខ្ញុំ សុំ បញ្ជាក់ ប្រាប់ អ្នក រាល់ គ្នា ថា មនុស្ស ជំនាន់ នេះ នឹង ត្រូវ ទទួល ទោស ព្រោះ តែ ឃាតកម្ម ទាំង នោះ ជា មិន ខាន ។
៣០ ព្រះយេស៊ូ មាន ព្រះបន្ទូល ដូច្នេះ ព្រោះ គេ និយាយ ថា ព្រះអង្គ មាន វិញ្ញាណ អាក្រក់ នៅ ក្នុង ខ្លួន ។
ព្រះជាម្ចាស់ បាន ដាក់ ពាក្យ របស់ ទ្រង់ នៅ ក្នុង មាត់ ពួកគេ ដូចជា ហោរា យេរេមា និង អេសាយ ជា ដើម ។
ហើយ មិន ធ្វើឲ្យ មាន ផ្ទៃពោះ នោះ សូម គិត សាឡើង វិញ ម្តង ទៀត ។
ដូច ជា ទូលបង្គំ បាន ឃើញ នៅ ក្នុង ទី បរិសុទ្ធ ដែរ
ការ បិទ ប្រទេស នេះ កុំ ថា ឡើយ តែ សត្វ សូម្បីតែ មនុស្ស ក៏ រក ទិញ អាហារ បរិភោគ មិន បាន ផង ដោយសារ ការរាតត្បាត នៃ កូវីដ១៩ ។
គឺ ពួក មេ ដឹក នាំ កុលសម្ព័ន្ធ ទាំង នោះ ហើយ
ដោយ បាន ឆ្លើយតប ទៅនឹង ការរិះគន់ នាង បាន និយាយ ថា នាង មាន សុខភាព ល្អ ។
លោក សារី បាន ត្រូវ កោះហៅ ត្រឡប់ ចូល ភ្នំពេញ វិញ ។
ស្វាមីៈ នាង អត់ ធ្វើការ អី ទេ នាង ជា មេផ្ទះ
ឈប់ ចំណាយ ពេល រអ៊ូ ទៀត ទៅ ហើយ ប្រើ វិធី ទាំង ៥ នេះ ដើម្បី ផ្លាស់ប្ដូរ
អ្នក គួរ ការពារ បបូរមាត់ អ្នក នៅពេល យប់ ព្រោះ វា អាច ស្ងួត ដោយសារ អាកាសធាតុ ត្រជាក់ ខ្លាំង ។
ពួកគេ ជាធម្មតា ទីក្រុង ធំ ៗ
ខ្ញុំ បាន សរសេរ សេចក្ដី ខ្លះ ជូន ក្រុម ជំនុំ ប៉ុន្ដែ លោក ឌី អូត្រេព ដែល ចូលចិត្ដ ធ្វើ ជា អ្នក ធំ ក្នុង ចំណោម ពួកគេ គាត់ មិន ទទួល យើង ទេ
ដូច្នេះ ទស្សនិកជន នៅ ទូទាំង ប្រទេស អាច ធ្វើជា សាក្សី ក្នុង ការ ចាប់ ឆ្នោត របស់ ពួកយើង ។
យើង មិន ចង់ ឃើញ អាមេរិក ព្យួករ សាដាម ហ៊ូសេន ម្ដង ទៀត ទេ
ថា គ្រប់ យ៉ាង គឺ ល្អ ដូច ដែល សាកលវិទ្យាល័យ បាន លាតត្រដាង ។
ព្រះអង្គ បាន ទទួល តង្វាយ ផ្សេង ៗ
