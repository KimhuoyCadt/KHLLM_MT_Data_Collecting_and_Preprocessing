ទ្រង់ មាន សិរី ល្អ ហើយ នឹង ព្រះចេស្តា
" ចូរ រៀបចំ ផ្លូវ របស់ ព្រះអម្ចាស់ ; ចូរ តម្រង់ ផ្លូវ ថ្វាយ ព្រះអង្គ ។
ដូចនេះ សូម ជួយ ពួកគេ ទៅ តាម លទ្ធភាព ផង ។
ប្រកួត នេះ បាន ប្រាប់ អ្នក យក
វត្ថុ ១០ យ៉ាង ដែល គ្មាន កាល ១០ ឆ្នាំ មុន តែ បច្ចុប្បន្ន ស្ទើរ តែ មិន អាច ខ្វះ បាន
ពួកគេ ត្រូវ ការ កន្លែង សម្រាប់ ស្នាក់ នៅ ។
នេះ គឺ ជា រឿង មួយ ដែល យើង បាន ជជែក គ្នា ជាមួយ រដ្ឋាភិបាល កម្ពុជា ។
នៅ នឹង កន្លែង កើត ហេតុ យ៉ាង រន្ធត់ ។
រូបភាព អ្នកនាង ឈិន ច័ន្ទ សុធារី
យើង នឹង ស្រឡាញ់ គ្នា ។
គណះបក្ស ប្រជាជន ខ្ញុំ មិន ជឿ ថា គេ
ប្រសិន បើ ខ្ញុំ ខុស មែន ខ្ញុំ សុខ ចិត្ត នៅ ស្ងៀម
ហើយ លោក នឹង សម្រាន្ដ យ៉ាង សុខ ស្រួល ។
១ ព្រះយេស៊ូ ចាប់ ផ្ដើម បង្រៀន បណ្ដា ជន នៅ តាម ឆ្នេរ សមុទ្រ ម្ដង ទៀត ។
ចំណែក ឯ អាជ្ញាធរ រូបិយវត្ថុ នៅ ក្នុង ប្រទេស ឥណ្ឌា និង ប្រទេស ហ្វីលីពីន វិញ បាន ដំឡើង អត្រា ការ ប្រាក់ នៅ ក្នុង ឆ្នាំ នេះ ផង ដែរ ។
ព្រះបាទ សូល ងាក មក លោក ដាវីឌ អោន មុខ ចុះ ក្រាប ដល់ ដី ថ្វាយបង្គំ ស្ដេច ។
អ្នក អាច ធ្វើ ការទាញយក វា និង ពត៌មាន ផ្សេង ៗ
ប្រសិនបើ អ្នក ចង់ បាន ក្តីសុខ និង សេរីភាព ច្រើន ជាង ការ ចង់ បាន កូន អ្នក ត្រូវ អនុវត្ត កុំ ឲ្យ មាន កូន ។
នាង ជា ម្តាយ អស្ចារ្យ ហើយ ពុំ សម្រាប់ តែ កូន ខ្លួន ប៉ុណ្ណោះ ទេ ។
ព្រះ និង មនុស្ស លោក សប្បាយ ចិត្ត គ្រប់ ៗ
ទ្រង់ ប្រារព្ធ នឹង ភិក្ខុ ទាំងឡាយ នៅ នា ឆ្នេរ ស្ទឹង វគ្គុ មុទា ។
ពួកភិក្ខុ ក្រាប ទូល សេចក្តី នុ៎ះ ចំពោះ ព្រះ ដ៏ មាន ព្រះភាគ ។
- ជួយ អូសទាញ មិត្តភក្តិ និង ប្រជាពលរដ្ឋ ក្នុង សហ គមន៍ ដែល ភ្លើតភ្លើន នឹង វប្បធម៌ បរទេស
លទ្ធផល ស្វែងរក ពាក្យ គន្លឹះ ( បង់ក្លាដែស )
ខ្ញុំ ចូលចិត្ត ដើរ ទិញ ឥវ៉ាន់ នៅ ផ្សារ ថ្មី ។
រថយន្ដ បែន ដឹក ដី បុក កុងតឺន័រ អស់ ប្រេង ចត កណ្ដាល ផ្លូវ ពី ក្រោយ តៃ កុង រងរបួស ធ្ងន់
ខ្ញុំ ឱ្យ ឯកឧត្តម ឧប នាយក រដ្ឋមន្ត្រី ហោ ណាំ ហុង ទៅ ។
