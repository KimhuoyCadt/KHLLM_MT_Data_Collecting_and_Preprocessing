មិន មាន តំកល់ ព្រះពុទ្ធ បដិមា នៅ ក្នុង ព្រះវិហារ ទៀត ទេ
មិន នឹកស្មាន ថា តារា ម៉ូដែល ស្រី ដ៏ ស្រស់ស្អាត ម្នាក់ នេះ តាមពិតជា មនុស្ស ប្រុស សោះ
ផ្ទុយ ទៅ វិញ គឺ ការ ស្រេក ឃ្លាន ចង់ ស្ដាប់
និង ប្រមាថ ព្រះអម្ចាស់ ។
ពួក គាត់ ជួយ ខ្ញុំ គ្រប់ ពេល វេលា ។
ស្ដេច ប្ដឹង ទេវតា ព្រះឥន្ទ្រ ឬ ឆ្កែ ឆ្មា មាន់ ទា ។
លោក បាន មានប្រសាសន៍ ថា " ខ្ញុំ កំពុង ធ្វើ រឿង នេះ ដើម្បី បង្ហាញ ថា ប្រជាជន គួរតែ ត្រៀមលក្ខណៈ នៅពេល ទទួល វ៉ាក់សាំង " ។
តើ អ្នក ដឹង ទេ ថា មនុស្ស ប៉ុន្មាន នាក់ សម្លាប់ ខ្លួន ក្នុង មួយ ឆ្នាំ ៗ
អ្នក ចូលចិត្ត អង្គុយ មិន ងើប យូរ ៗ
តើ ខ្ញុំ ប្រដូច ព្រះរាជ្យ ព្រះជាម្ចាស់ ទៅ នឹង អ្វី ?
អ្នក ទៅ រក ពឹង ផ្អែក ប្រជាជាតិ នោះ ទេ
អ្នក អាច ទំនាក់ទំនង អ្នកអភិបាល គ្រប់ ពេលវេលា ។
ដូច្នេះ ជា លទ្ធផល សំរេច ចេញ បណ្ណ កម្ម
គ្រោះថ្នាក់ ដែល កើត ចេញ ពី កត្តា ផ្ទាល់ ខ្លួន នេះ គេ ចាត់ទុក ថា ជា គ្រោះថ្នាក់ ដែល អាច ដឹង ជា មុន បាន ។
ដូច ច្នេះ កុំ យល់ ច្រឡំ អី ព្រោះ នាង ខ្ញុំ ជា មនុស្ស ស្រី ម្នាក់ ដែល ប្រយ័ត្ន ខ្លួន ណាស់ ។
ប្រទេស ជិតខាង រីករាយ នឹង ស្ថានភាព ដែល កំពុង មាន នេះ ។
កុំព្យូទ័រ ប៉ុន បាត ដៃ មាន ទំហំ ធំ ជាង ទូរស័ព្ទ ដៃ ធម្មតា បន្តិច ។
ចៅក្រម ស៊ើបសួរ នេះ សម្រេច តាម ដីកា ដែល ត្រូវ ជូន ដំណឹង ជា បន្ទាន់ ដល់ ដើម បណ្តឹង រដ្ឋប្បវេណី ។
បញ្ហា នេះ គេ គួរ តែ ពិនិត្យ ទៅ លើ ខ្លឹមសារ ញ ត្តិ វិញ ទើប ជា ការ ត្រឹមត្រូវ៖
២. អ្នក នឹង មិន មាន សេរីភាព រហូត ទាល់តែ អ្នក ដោះលែង ខ្លួនអ្នក ពី ការគិត អវិជ្ជមាន ។
ទ្រង់ ក៏ តាំង ឲ្យ មាន កិត្តិយស ហើយ នឹង អានុភាព ដែរ
ហេតុ អ្វី ត្រូវ ប៉ាន់ប្រមាណ ២ សប្តាហ៍ ប្រសិនបើ គេ សប្បាយ ចិត្ត នឹង ២ ខែ ?
ចូរ ដឹង ថា ព្រះរាជ្យ ព្រះជាម្ចាស់ ស្ថិត នៅ កណ្ដាល ចំណោម អ្នក រាល់ គ្នា ហើយ " ។
របស់ ខ្លួន ជាច្រើន អោយ មហាជន ភ្ញាក់ផ្អើល ផងដែរ ។
ព្រះអង្គ លែង រវីរវល់ នឹង ពួក គេ ។
នោះ ខ្ញុំ នឹង រៀបចំ ថ្មី មួយ ទៀត នៅ ថ្ងៃស្អែក ។
ព្រម ទាំង រឹប អូស យក ទ្រព្យ សម្បត្តិ
មនុស្ស រាប់ លាន នាក់ នៅ ជុំវិញ ពិភពលោក មិន មាន ទឹក ស្អាត សម្រាប់ ទទួល ទាន ទេ ។
ួ និង ស្រដៀង គ្នា ហើយ អ្នកចូលរួម ត្រវូ បាន លើកទឹកចិត ឱ
" ហើយ គេ ត្រូវការ ឱ្យ មនុស្ស ទាំងឡាយ ទ្រទ្រង់ ការពារ និង អនុវត្ត លទ្ធិ ប្រជាធិបតេយ្យ " ។
ការហាមឃាត់ នេះ អនុវត្ត តែ ចំពោះ ជន បរទេស ប៉ុណ្ណោះ ។
ហេតុ នោះ ទើប ព្រះពុទ្ធ សាសនា បាន ទូន្មាន ជា រឿយ ៗ
បន្ទាប់ពី សម្រាល បុត្រ រួច ឡោម ល ក្ខិណា វិលត្រឡប់ ចូល វិស័យ សិល្បៈ វិញ
៣០ ប៉ុន្តែ ម្ដាយ របស់ ក្មេង នោះ ពោល ថា៖
ថ្ងៃអង្គារ : ពស់ រត់ ចេញ ពី ភ្លើង ព្រៃ អភ័ព្វ តែងតែ ទទួល សេចក្ដី លំបាក ជារឿយ ៗ
ទោះបីជា យ៉ាងណា ក៏ដោយ ក្មេង ដែល ច្រើន តែ កេះ អាច ម៌ ច្រមុះ
ក្រែង លោ ឃើញ មាន នរណា ម្នាក់ ស្មោះ ត្រង់
គ្មាន នរណា អាច ទាត់ ខ្ញុំ ចេញ ពី ក្រុម ឡើយ
នឹង មាន អ្វី កើតឡើង បើ លោក ត្រាំ មិន អាច បន្ដ កាន់ តំណែង ប្រធានាធិបតី បាន ?
និង តាម លំដាប់លំដោយ ជា ប្រព័ន្ធ ។
ក្នុង ប្រអប គ្រោះថ្នាក់ គឺ គាត់ នឹង បង្កើត ឱកាស សម្រាប់ ពួក យើង ហើយ " ។
វា នឹង មាន សារៈប្រយោជន៍ ចំពោះ អ្នក ដោយសារ តែ រាល់ អ្វី ៗ
បច្ចុប្បន្ន ខ្ញុំ កំពុង រស់ នៅ ជាមួយ ម្ដាយ និង ប្អូន ស្រី របស់ ខ្ញុំ ។
សូម ធានា ប្រាប់ គាត់ ថា គាត់ មាន សុវត្ថិភាព
សម្រាប់ ខ្ញុំ ដើមឈើ គឺជា ដង្ហើម នៃ ជីវិត ។
" ការ ផ្លាស់ប្ដូរ កើត ឡើង ដោយ ការ ស្ដាប់ បន្ទាប់មក ចាប់ផ្ដើម ការ សន្ទនា ជាមួយ មនុស្ស ដែល កំពុង ធ្វើ អ្វី ដែល អ្នក មិន ជឿ ថា ត្រឹមត្រូវ ។
ជីវិត ខ្ញុំ គ្មាន តម្លៃ បើ គ្មាន ព្រះគ្រីស្ទ !
ពួកគាត់ ដែល រស់ នៅ ទីនោះ ទទួល រង ធូលី ដី មិន ដឹង ប៉ុន្មាន លាន គ្រាប់ ដកដង្ហើម ចូល ទៅក្នុង ពោះ នោះ ឡើយ ដោយសារតែ ការ ជួសជុល ផ្លូវ នេះ បាន ធ្វើអស់ រយៈពេល ជាច្រើន ថ្ងៃ មក នោះ មិន ទាន់ បាន បញ្ចប់ នៅឡើយ ។
ប៉ុន្តែ នៅ ពេលវេលា កន្លង ផុត ទៅ អ្វី ៗ
សូម អនុញ្ញាត្ត ឲ្យ ព្រះ ធ្វើ ជា អ្នក ដឹក នាំ ជីវិត របស់ អ្នក ។
ប៉ុន្តែ រហូត ដល់ ពាក់កណ្តាល ឆ្នាំ ១៩៧១ ក៏ បំណង របស់ ពួកគេ នៅតែ មិន អាច ទៅ រួច ។
ខណៈ កម្មវិធី នោះ លោក
៦ ឥឡូវ នេះ ព្រះគ្រិស្ដ បាន ទទួល មុខងារ ប្រសើរ ជាង បូជាចារ្យ ទាំង នោះ ទៅ ទៀត ព្រោះ ព្រះអង្គ ជា ស្ពាន នៃ សម្ពន្ធ មេត្រី * មួយ ប្រសើរ ជាង ជា សម្ពន្ធ មេត្រី ដែល ចង ឡើង ដោយសារ ព្រះបន្ទូល សន្យា ដ៏ ប្រសើរ ជាង ។
៧ ចំណែក ឯ អ្នក វិញ កូន មនុស្ស អើយ យើង បាន តែងតាំង អ្នក អោយ ធ្វើ ជា អ្នក យាម ល្បាត សំរាប់ ពូជ ពង្ស អ៊ីស្រាអែល ។
សូម ព្យាយាម តាមដាន សភាព ជម្ងឺ របស់ កូន ដើម្បី ឱ្យដឹង អំពី កម្រិត ពិតប្រាកដ ។
២០ សេចក្ដី ដែល ខ្ញុំ សរសេរ មក ជូន បង ប្អូន នេះ ឥត កុហក ទេ មាន ព្រះជាម្ចាស់ ជា សាក្សី ស្រាប់ ។
អោយ រួច ពី កណ្ដាប់ ដៃ របស់ ខ្មាំង សត្រូវ និង
ថា លោក មាន ភស្តុតាង គ្រប់ គ្រាន់ ដែល អាច បញ្ជាក់ ពី ករណី ស្នេហា លួច លាក់ នោះ ។
អំណាច វា ជា សេចក្ដីស្រេកឃ្លាន របស់ អ្នក ដែល មាន គុណធម៌ ទាប ។
៣ កាល នៅ ពី ក្មេង នាង ទាំង ពីរ រស់ នៅ ក្នុង ស្រុក អេស៊ីប ហើយ បាន ខូច ខ្លួន ដោយ ប្រព្រឹត្ត អំពើ ពេស្យាចារ ។
លោក បញ្ជាក់ ថា ការ ធ្វើ ដូច្នេះ គឺ ដើម្បី ការពារ សវនាការ ។
ព្រះអង្គ នឹង ត្រូវ បាន ស្វាគមន៍ ជានិច្ច នៅ ក្នុង ប្រទេស របស់ យើង ។
