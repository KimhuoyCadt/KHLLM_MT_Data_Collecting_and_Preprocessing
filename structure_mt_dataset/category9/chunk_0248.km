( កំពង់ឆ្នាំង ) ៖ បើ ទោះជា បច្ចុប្បន្ន នេះ ស្ថិត ក្នុង សម័យ បច្ចេកវិទ្យា ដ៏ ទំនើប ទៅ ហើយ យ៉ាង នេះ ក្តី ក៏ ប្រជាពលរដ្ឋ ខ្មែរ នៅតែ បាន ប្រកាន់ខ្ជាប់ នូវ ទំនៀមទំលាប់ និង ជឿ ទៅ លើ ជំនឿ អរូបី ដែល ទំនៀមទម្លាប់ បែប នេះ ពុំ ទាន់ ត្រូវបាន បោះបង់ ចោល ពី ផ្នត់គំនិត របស់ ពលរដ្ឋ ខ្មែរ បាន នៅឡើយ នោះ ទេ ព្រោះ វា គឺជា កេរ្តិ៍ដំណែល បន្សល់ទុក ពី ដូន តាម ក មិន អាចនឹង សាបសូន្យ បាន ដោយ ងាយ ៗ នោះ ឡើយ ពិសេស គឺ ការជឿ ទៅ លើ ខ្មោច ព្រាយ បិសាច បញ្ចូល រូប បញ្ជាន់ អារក្ស ឬ មន្តអាគម អូម អាម ជាដើម - ល - ។
ភាគ ច្រើន គឺ អ្នកធ្វើដំណើរ តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ៥ ឆ្លងកាត់ មុខ ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ នេះ ព្រោះតែ ពួកគេ មាន ជំនឿ ទៅ លើ បារ ម៉ី ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ ដែល នាំឲ្យ រកស៊ី មាន បាន និង សុខ សប្បាយ ក្នុង ការធ្វើដំណើរ ទៅកាន់ ទី ជិត ឆ្ងាយ រីឯ ដង្វាយ ដែល គេ និយម យកមក ថ្វាយ ភាគ ច្រើន គឺ គេ ថ្វាយ ប្រភេទ រាន ទេវតា ដែល ត្រូវបាន គេ ដឹក យកមក ដាក់ តាំង រាប់ រយ គ្រឿង នៅ ពាសពេញ បរិវេណ ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ នេះ ទៅ តាម ការបន់ស្រន់ របស់ ពួកគេ រៀង ៗ ខ្លួន ។
រឿង ហេតុ ដ៏ ចម្លែក ខាងលើ នេះ បាន កើតឡើង កាលពី អំឡុង ឆ្នាំ ១៩៨៩ នៅក្នុង ភូមិ ថ្មី ឃុំ ផ្សារ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ដែល ម្ចាស់ ផ្ទះ ដើម នោះ ជា កសិករ មាន ឈ្មោះ សំរិទ្ធ ល ន ភេទ ស្រី ដំបូង ឡើយ គាត់ បាន ទិញ ផ្ទះ មួយ ខ្នង នេះ ពី ស្រុក លើ មក សង់ នៅលើ ដី របស់ គាត់ ។
បង ស្រី បន្ត ថា ដី ភូមិ នេះ កាលពី មុន មាន អ៊ុប្រុស ម្នាក់ រស់ នៅ ឯ ប៉ោយប៉ែត គាត់ បាន រកស៊ី ខាត ដើម ខាត ចុង ហើយ យប់ មួយ បារមី ដែល នៅ ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ បាន ទៅ ពន្យល់សប្តិ គាត់ ថា ឲ្យ គាត់ មក អុជ ធូប បន់ស្រន់ នៅ ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ នេះ អ្វី ៗ និង ជោគជ័យ មិន ខាន ឡើយ ។ លុះ ស្អែក ឡើង គាត់ ក៏ មក បន់ស្រន់ នៅ ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ តាម ការពន្យល់សប្តិ នោះ តាំងពី ពេល នោះ មក មុខរបរ របស់ គាត់ ក៏ ទទួលបាន ជោគជ័យ ដូច បំណង តាម ការបន់ស្រន់ របស់ គាត់ ពិត មែន ។
លោក ប៊ិន សុផាន មេឃុំ ផ្សារ បាន ឲ្យដឹង ដែរ ថា នៅនឹង ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ នេះ ផងដែរ មាន ប្រជាពលរដ្ឋ ជាច្រើន ដែល ជឿ ទៅ លើ បរមី ផ្ទះ ខ្មោច ដោយ ចេញ ចូល ទីនេះ មិន សូវ លស់ ពេល នោះ ទេ ពិសេស គឺ នៅ ថ្ងៃសៅរ៍ និង ថ្ងៃ អាទិត្យ ឬ ថ្ងៃ ឧបោសថ សីល ។
ដោយ មើលឃើញ ប្រជាពលរដ្ឋ ចេញ ចូល ទីនេះ មាន ច្រើន ជា ហូរហែ នោះ លោក ក៏ បាន ពង្រឹង ផ្នែក សន្តិសុខ យាម កាម បន្ថែម ទាំង យប់ ទាំង ថ្ងៃ មិន ដែល ហ៊ាន ធ្វេស ប្រហែស នោះ ឡើយ ដូច្នេះ ក្នុង នាម លោក ជា អាជ្ញាធរ ឃុំ គ្រប់គ្រង ទីនេះ លោក ក៏ សុំ ធ្វើ ការអំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន ជំនឿ ទៅ លើ ផ្ទះ ខ្មោច ស័ក្ត សិទ្ធិ ស្ថិត នៅក្នុង ភូមិ ថ្មី ឃុំ ផ្សារ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង នេះ សូម បងប្អូន អញ្ជើញ មក ទីនេះ ដោយ មិន ចាំបាច់ មាន ការព្រួយបារម្ភ អំពី សន្តិសុខ នោះ ឡើយ ៕
កម្ពុជា ដាក់ ឱ្យ ប្រើប្រាស់ ប្រព័ន្ធ ផ្តល់ ព័ត៌មាន ពី គ្រោះមហន្តរាយ PRISM
PRISM ជា ប្រព័ន្ធ ប្រមូល ព័ត៌មាន ស្តីពី គ្រោះមហន្តរាយ នានា តាមរយៈ ទូរស័ព្ឌ / ថេប ប្លែត ។ ប្រព័ន្ធ នេះ ជា វេទិកា ផ្តល់ ព័ត៌មាន ទាន់ ពេលវេលា ដើម្បី ជា ជំនួយ ដល់ ការតាមដាន ត្រួតពិនិត្យ វាយតម្លៃ ធ្វើ បច្ចុប្បន្នភាព ព័ត៌មាន ទាន់ ហេតុការណ៍ ងាយស្រួល សម្រាប់ អ្នកប្រើប្រាស់ និង ជាពិសេស សម្រាប់ អ្នកធ្វើ សេចក្តីសម្រេចចិត្ត ។ លើស ពី នេះ វេទិកា នេះ ជា កន្លែង រួមបញ្ចូល លំហូរ ព័ត៌មាន របស់ រាជ រដ្ឋាភិបាល ពី ក្រសួង ពាក់ព័ន្ធ នានា ឲ្យ មាន ទំនាក់ទំនង គ្នា ទៅ វិញ ទៅមក ។
លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ថ្លែង ឱ្យដឹង ថា ប្រព័ន្ធ ព័ត៌មាន ទាន់ ហេតុការណ៍ និង តាមដាន សភាពការណ៍ PRISM ត្រូវបាន បង្កើតឡើង ក្រោម កិច្ចព្រមព្រៀង រវាង គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ និង អង្គការ កម្មវិធី ស្បៀងអាហារ ពិភពលោក ស្តីពី ការអនុវត្ត សកម្មភាព រួមគ្នា ដើម្បី គ្រប់គ្រង វិបត្តិ និង កាត់បន្ថយ ហានិភ័យ គ្រោះមហន្តរាយ ក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន ចុះហត្ថលេខា នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ដែល គ្របដណ្តប់ នៅលើ អនុស្សាណៈ យោគយល់ ឆ្នាំ ២០១៧ ។
លោក ទេសរដ្ឋមន្ត្រី បន្ត ថា កិច្ចព្រមព្រៀង នេះ បង្កើត ក្របខ័ណ្ឌ ការងារ កិច្ចសហប្រតិបត្តិការ ក្នុង ការត្រៀមខ្លួន ជាស្រេច ដើម្បី ឆ្លើយតប ទៅនឹង ហានិភ័យ គ្រោះមហន្តរាយ កើតឡើង ដោយ អភិវឌ្ឍន៍ សមត្ថភាព ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ឱ្យដឹង ថា បន្ទាប់ពី ការប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ប្រព័ន្ធ PRISM នេះ ទៅ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ នឹង ធ្វើ ការបណ្តុះបណ្តាល ជូន មន្ត្រី គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ដែល មាន ថ្នាក់ ខេត្ត និង ថ្នាក់ ស្រុក ដើម្បី បាន ទទួល នូវ បទពិសោធន៍ ពី ការអនុវត្ត ផ្ទាល់ ក្នុង ការប្រើប្រាស់ ឧបករណ៍ ថេប ប្លែត ក្នុង ការបញ្ចូល ទិន្នន័យ ការប៉ះពាល់ ការខូចខាត ការបាត់បង់ ដោយ គ្រោះ មហន្តរាយ ។
ជាមួយ នេះ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ក៏ នឹង រៀបចំ គោលការណ៍ ណែនាំ នីតិវិធី សម្រាប់ ធ្វើ ផែន ការត្រៀម បម្រុង ឆ្លើយតប សង្រ្គោះ បន្ទាន់ គ្រោះមហន្តរាយ ដែល ទាមទារ ឱ្យ មាន ការចូលរួម ផ្តល់ នូវ ធាតុ ចូល ពី គ្រប់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដៃគូ អភិវឌ្ឍ អង្គការ ជាតិ និង អន្តរជាតិ ។
លោកស្រី នាយិកា បាន ថ្លែង ថា ការទទួលបាន ព័ត៌មាន បាន លឿន រហ័ស និង ទាន់ ហេតុការណ៍ វា ចាំបាច់ ណាស់ សម្រាប់ ផ្តល់ នូវ ការជួយ សង្គ្រោះ ក្នុង គ្រោះមហន្តរាយ នានា ឱ្យ បាន ទាន់ ពេល វេលា ។
លោកស្រី រំពឹង ថា ការដាក់ ឱ្យ ដំណើរការ ប្រព័ន្ធ នេះ នឹង ចូលរួមចំណែក កាត់បន្ថយ ផល ប៉ះពាល់ នៃ គ្រោះមហន្តរាយ ហើយក៏ ជា វិភាគទាន ចូលរួម ដល់ ការសម្រេច នូវ គោលដៅ យុទ្ធសាស្ត្រ អភិវឌ្ឍ ឆ្នាំ ២០៣០ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ផងដែរ ៕
បណ្ឌិត សុខ ទូច៖ រាជ បណ្ឌិត្យ សភា កម្ពុជា បើក បេះដូង ទូលាយ ទទួលយក អ្នក មាន សមត្ថភាព មក ពី គ្រប់ ទិសទី
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សភាចារ្យ សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា និង ជា អនុប្រធាន ប្រចាំ ការ នៃ ក្រុមប្រឹក្សា បណ្ឌិត សភាចារ្យ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន ថ្លែង ថា រាជ បណ្ឌិត្យ សភា កម្ពុជា បើក បេះដូង ទូលាយ ចំពោះ អ្នក មាន សមត្ថភាព មក ពី គ្រប់ ទិសទី ដើម្បី ចូលរួម ជាមួយគ្នា ស្រាវជ្រាវ រក អ្វី ដែល ថ្មី ៗ ដើម្បី ចូលរួម ជួយ អភិវឌ្ឍន៍ ប្រទេសជាតិ ឱ្យ កាន់តែ រីកចំរើន ។
លោក បណ្ឌិត សភាចារ្យ សុខ ទូច បាន ថ្លែង ដូចនេះ ក្នុង ពិធី ចុះ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា រវាង រាជ បណ្ឌិត្យ សភា កម្ពុជា សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង និង វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប ដែល បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ នៅ សាល មរតក សិល្បៈ ខ្មែរ អគារ ឥន្ទ្រ ទេវី នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ។
លោក បណ្ឌិត សភា សភាចារ្យ សុខ ទូច បាន គូសបញ្ជាក់ បន្ថែម ថា អ្នកប្រាជ្ញ របស់ កម្ពុជា ត្រូវតែ រួមគ្នា គិត និង ស្រាវជ្រាវ ដើម្បី ស្វែងរក ធាតុ ចូល ជូន ដល់ រាជ រដ្ឋាភិបាល អ្នកសិក្សា ស្រាវជ្រាវ ក្នុង ការកំណត់ ចក្ខុវិស័យ និង រៀបចំ ផែនទី សម្រាប់ ការអភិវឌ្ឍ ប្រទេសជាតិ ប្រកបដោយ និរន្តរភាព ។
លោក សុខ ទូច បាន បន្ត ថា ការចុះអនុស្សរណៈ នា ថ្ងៃ នេះ គឺ ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ រវាង ស្ថាប័ន ទាំង បី ក្នុង ការចងក្រង ឯកសារ លើ គ្រប់ វិស័យ ពិសេស បាន ឆ្លុះបញ្ចាំង អំពី ទស្សនៈ « ទ្រឹស្ដី ផ្សារភ្ជាប់ នឹង ការអនុវត្ត ចង ភ្ជាប់ ដោយ ក្រមសីលធម៌ » ។ ការចុះអនុស្សរណៈ នៃ ការយោគយល់ គ្នា នេះ ដែរ បាន ធ្វើការ ទៅ លើ ៤ចំណុច ដែល មាន ដូចជា ការធ្វើ ការសិក្សា ស្រាវជ្រាវ រួមគ្នា . ធ្វើការ ទៅ លើ ការងារ បរិស្ថាន រួមគ្នា . ការបណ្តុះបណ្តាល រួមគ្នា . ការពុម្ភ រួមគ្នា ។
លោក បណ្ឌិត សភាចារ្យ សុខ ទូច បាន បន្លែម ថា រាជ បណ្ឌិត្យ សភា កម្ពុជា គឺ មាន កិច្ចសហប្រតិបត្តិការ ច្រើន ជាមួយនឹង ស្ថាប័ន នៅ ក្រៅ ប្រទេស ដែល មាន ដូចជា ស្ថាប័ន ក្នុង ប្រទេស ជប៉ុន កូរ៉េ ថៃ សិង្ហបុរី និង ស្ថាប័ន ផ្សេង ទៀត ដើម្បី ដក បទពិសោធន៍ ពី គ្នា ទៅ វិញ ទៅ មក ។
លោក បាន ឱ្យដឹង ទៀត ថា ដោយឡែក សម្រាប់ ស្ថាប័ នៅក្នុង ប្រទេស ការចុះ កិច្ចសហប្រតិបត្តិការ នេះ ជា លើក ដំបូង ហើយ ជាមួយ គ្រឹះស្ថាន ឧត្តម សិក្សា ទាំង ពីរ នេះ ដើម្បី លើកកម្ពស់ ការស្រាវជ្រាវ រួម ជាមួយ សាស្ត្រាចារ្យ និស្សិត និង អ្នកស្រាវជ្រាវ វិទ្យាសាស្ត្រ សង្គម និង បរិស្ថាន ផ្តល់ បទបង្ហាញ រួមទាំង ការបោះពុម្ព ផ្សាយ ព្រឹត្តិបត្រ ស្រាវជ្រាវ លើ ប្រធានបទ ផ្សេង ៗ ដើម្បី ជា ប្រយោជន៍ ដល់ សង្គមជាតិ ទាំងមូល ។
គួរ បញ្ជាក់ ថា រាជ បណ្ឌិត្យ សភា កម្ពុជា មាន បេសកកម្ម ចម្បង ក្នុង ការសិក្សា ស្រាវជ្រាវ ទាំង វិទ្យាសាស្ត្រ សង្គម និង វិទ្យាសាស្ត្រ ពិត ដើម្បី រក ធាតុ ចូល ជូន រាជ រដ្ឋាភិបាល និង ដើរ តួ ក្នុង ការបណ្ដុះបណ្ដាល និង ស្រាវជ្រាវ ពី ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ ដល់ ថ្នាក់ បណ្ឌិត ៕
កូន ឈើ ប្រណិត ជាង ២ម៉ឺន ដើម បាន យក ទៅ ដាំ ឡើងវិញ នៅ តំបន់ សហគមន៍ ព្រៃឈើ ស្រែ ក្រសាំង ក្នុង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ
លោក សុខ លូ បាន លើកឡើង ថា ប្រពៃណី ដាំ កូន ឈើ ជា ស្នា ព្រះហស្ត ដែល បាន បន្សល់ទុក ដោយ សម្តេច ព្រះបរម រតន កោដ្ឋ ព្រះបាទ នរោត្តម សីហនុ ដែល ឲ្យ ឈ្មោះ ថា រុក្ខ ទិវា ហើយ ពិធី នេះ ត្រូវបាន ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ កំណត់ យ៉ាង ជាក់លាក់ ដើម្បី ប្រារព្ធ ពិធី ដាំ កូន ឈើ នេះ ជារៀងរាល់ ឆ្នាំ ទូទាំង ប្រទេស ។
ដោយឡែក គោលបំណង សំខាន់ នៃ ការដាំដុះ នេះ គឺ ដើម្បី ស្តារ ព្រៃឈើ ដែល បាន បាត់បង់ ឡើងវិញ សម្រាប់ ជា ប្រភព ទឹក សាប ប្រើប្រាស់ ព្រោះ ព្រៃឈើ មាន សារៈសំខាន់ និង ផលប្រយោជន៍ ខ្លាំង ណាស់ ចំពោះ មនុស្ស សត្វ បរិស្ថាន ។
លោក បាន លើកឡើង ថា ព្រៃឈើ មិន ត្រឹមតែ ជួយ ដល់ មនុស្ស សត្វ និង បរិស្ថាន ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ព្រៃឈើ ជា របាំង ខ្យល់ ទប់ស្កាត់ ការ សឹក រេចរឹល ព្រៃឈើ ការពារ នូវ ការហូរច្រោះ ទប់ស្កាត់ ការបាក់ ស្រុត ផ្សេង ៗ ការពារ គ្រោះ ធម្មជាតិ ខ្យល់ព្យុះ គ្រោះ រាំងស្ងួត ជាដើម និង ផ្តល់ នូវ សោភ័ណភាព ទាក់ទាញ នូវ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ឲ្យ ចូលមក ទស្សនា កាន់តែ ច្រើន ៗ ឡើង ដែល ជា ប្រភព ចំណូល ដ៏ សំខាន់ ដល់ ប្រជា សហគមន៍ និង ជាតិ ទាំងមូល ។
លោក ថា ការដាំ កូន ឈើ ពិត ជា មាន អត្ថន័យ ដ៏ ជ្រាលជ្រៅ សម្រាប់ ចលនា បំផុស ស្មារតី ប្រជាពលរដ្ឋ ឲ្យ ចេះ ស្រឡាញ់ ព្រៃឈើ ចូលរួម ក្នុង ការដាំដុះ និង ការពារ ព្រៃឈើ ក៏ ដូចជា ការជួយ ផ្ដល់ ផលប្រយោជន៍ ឲ្យ ប្រជាពលរដ្ឋ ក្នុង ការរស់នៅ ប្រចាំ ថ្ងៃ ដើម្បី បង្កបង្កើន ផល កសិកម្ម បង្កើន សុខុមាលភាព គ្រួសារ ព្រមទាំង ជួយ លើកស្ទួយ បរិស្ថាន សង្គម ផងដែរ ។
ម្យ៉ាងទៀត ការដាំ ដើមឈើ បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជួយ ថែរក្សា ដំណើរការ ប្រព័ន្ធ អេកូឡូស៊ី តាមរយៈ ការជួយ ធ្វើ និយ័តកម្ម អាកាសធាតុ ជួយ កាត់បន្ថយ ឥទ្ធិពល អវិជ្ជមាន នៃ ការប្រែប្រួល អាកាសធាតុ ដូចជា ទឹក ជំនន់ ខ្យល់ព្យុះ និង ការស្រូបយក ឧស្ម័ន កាបូនិច ពី បរិយាកាស ។
ក្នុង ឱកាស នោះ លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាកសិករ ទាំងអស់ ត្រូវ ចូលរួម ថែរក្សា ការពារ ព្រៃឈើ និង បរិស្ថាន ធម្មជាតិ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី ជា ប្រយោជន៍ ដល់ ការរស់នៅ របស់ ខ្លួន ផង សហគមន៍ ផង និង ជីវិត សត្វ ព្រៃ គ្រប់ ប្រភេទ ព្រមទាំង ប្រព័ន្ធ ជីវៈ ចម្រុះ ផងដែរ ជាពិសេស កាត់បន្ថយ នូវ គ្រោះ ធម្មជាតិ ដូចជា ខ្យល់ព្យុះ ទឹក ជំនន់ គ្រោះ រាំងស្ងួត ជាដើម ។
តាម របាយការណ៍ របស់ លោក ប៉ែន វណ្ណ រិទ្ធ ប្រធាន មន្ទីរ សហគមន៍ ព្រៃឈើ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត កំពង់ធំ បាន ឲ្យដឹង ថា សហគមន៍ ព្រៃឈើ ក្នុង ខេត្ត មាន ៨៣ សហគមន៍ ហើយ កូន ឈើ ទាំងអស់ នេះ យក ទៅ ដាំ ក្នុង ផ្ទៃដី ៤០ ហិកតា លើ ផ្ទៃដី ទាំងមូល ១២. ៦១៥ ហិកតា ៕
( ភ្នំពេញ ) ៖ ក្រសួង ការពារ ជាតិ កំពុង ត្រៀម រៀបចំ តំបន់ ប្រវត្តិសាស្រ្ត យោធា នៅ តាម ទីតាំង មួយចំនួន ទៀត ។ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន បញ្ជាក់ ថា ការរៀបចំ តំបន់ ប្រវត្តិសាស្ត្រ យោធា នេះ គឺ ដើម្បី ការពារ និង រក្សា ឱ្យ បាន នូវ តឹក តាង ប្រវត្តិសាស្ត្រ ទាំងឡាយ ឱ្យ បាន ឋិតថេរ សម្រាប់ ទុក ឱ្យ មនុស្ស ជំនាន់ ក្រោយ បាន ដឹង ឮ ។
ការលើកឡើង បែប នេះ របស់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតី ពិធី បើក កិច្ចប្រជុំ ស្តីពី « ការរៀបចំ តំបន់ ប្រវត្តិសាស្ត្រ យោធា » នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ កងយោធពល ខេមរភូមិន្ទ យ៉ាង ច្រើន ផងដែរ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « សិក្ខាសិលា នេះ គឺជា ការរៀបចំឡើង ឱ្យ មាន ខ្សែ សង្វាក់ រៀបចំ ឱ្យ ទៅជា រឿង មួយ ដែល ពាក់ព័ន្ធ សំខាន់ បំផុត គឺ វិស័យ ការពារ ជាតិ ផង ការពារ បូរណភាព ដែនដី ផង លើស ពី នេះ គឺ ការពារ តឹក តាង ទាំងឡាយ ដែល ប្រវត្តិសាស្ត្រ បាន បន្សល់ទុក គឺ ឱ្យ បាន ឋិតថេរ » ។
បន្ថែម ពី នេះ រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន ឱ្យដឹង ថា សិក្ខាសិលា នេះ ធ្វើឡើង ក្នុង គោលបំណង ពិភាក្សា ស្វែងរក ទីតាំង ភូមិសាស្ត្រ ដែល មាន ប្រតិបត្តិការ ទាក់ទង នឹង សមរភូមិ នៅ គ្រប់ ដំណាក់កាល ដែល អាច កំណត់ បាន ថា ជា ទីតាំង ប្រវត្តិសាស្ត្រ យោធា ជាពិសេស ឯកសារ រូបថត និង សម្ភារ នានា ដើម្បី ចង ក្រង រក្សាទុក ជា តឹក តាំង ប្រវត្តិសាស្ត្រ សម្រាប់ យោធិន ជំនាន់ ក្រោយ សិក្សា រៀនសូត្រ ។
សម្តេច បន្ត ថា ដូច្នេះ ដើម្បី គិតគូរ លើ រឿង នេះ ក្រសួង ការពារ ជាតិ បាន ធ្វើ សិក្ខាសាលា ស្តីពី « ការរៀបចំ តំបន់ ប្រវត្តិសាស្ត្រ យោធា » នេះ ឡើង ដើម្បី ធ្វើ យ៉ាង ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ បាន ជ្រួតជ្រាប ថា តឹក តាង ទាំងអស់ នេះ គឺ មាន សារសំខាន់ យ៉ាង ខ្លាំង សម្រាប់ ប្រវត្តិសាស្ត្រ ។ កត្តា ទាំងនេះ ហើយ តឹក តាង ប្រវត្តិសាស្ត្រ យោធា គឺ អាច ឈាន មុខ គេ ដើម្បី ទុក ជា ឯកសារ ជាដើម ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន បន្ថែម ថា ទាក់ទិន ជាមួយ ការងារ រៀបចំ តំបន់ ប្រវត្តិសាស្ត្រ យោធា នេះ គឺ ក្រុមការងារ ត្រូវ ស្រាវជ្រាវ ពី ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្ត្រ ធំ ៗ ជាច្រើន ដែល មាន កើតឡើង ដោយ កំណត់ ទីតាំង ដែល បាន បន្សល់ទុក ស្វែងរក សាក្សី មក បញ្ជាក់ ប្រវត្តិ និង ព័ត៌មាន ទាក់ទង ទៅ នឹង ទីតាំង នីមួយ ៗ ។
