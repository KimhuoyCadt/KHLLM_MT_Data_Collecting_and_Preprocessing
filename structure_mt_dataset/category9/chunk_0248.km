( ភ្នំពេញ ) ៖ លោក ថោ គឿន អនុ រដ្ឋលេខាធិការ ក្រសួង ធម្មការ និង សាសនា នៅ ព្រឹក ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ ប្រតិភូ ពុទ្ធសាសន បណ្ឌិត្យ បំពេញ ទស្សនកិច្ច មជ្ឈមណ្ឌល វប្បធម៌ ចិន នៅក្នុង រាជធានី ភ្នំពេញ ។ ដំណើរ បំពេញ ទស្សនកិច្ច នេះ ធ្វើឡើង ដើម្បី ផ្លាស់ប្តូរ បទពិសោធន៍ ការងារ និង ពិភាក្សា ការងារ មួយចំនួន ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ពុទ្ធសាសន បណ្ឌិត្យ និង មជ្ឈមណ្ឌល វប្បធម៌ ចិន នៅ រាជធានី ភ្នំពេញ ។
លោក ថោ គឿន និង ប្រតិភូ ត្រូវបាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ ពីសំណាក់ លោក ឈាន យាន កាង ប្រធាន មជ្ឈមណ្ឌល វប្បធម៌ ចិន នៅ រាជធានី ភ្នំពេញ ។ លោក ថោ គឿន ក៏ បាន ថ្លែងអំណរគុណ លោក បណ្ឌិត ជា មុនី ឫទ្ធិ ទីប្រឹក្សា មជ្ឈមណ្ឌល វប្បធម៌ ចិន នៅ ភ្នំពេញ និង ជា ប្រធាន សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន ដែល បាន ជួយ សម្របសម្រួល ដំណើរទស្សនកិច្ច នេះ ។
លោក ថោ គឿន និង ប្រតិភូ ត្រូវបាន លោក ឈាន យាន កាង អញ្ជើញ ទស្សនកិច្ច នៅក្នុង មជ្ឈមណ្ឌល វប្បធម៌ ចិន និង បាន បង្ហាញ សមិទ្ធផល ការងារ មួយចំនួន ដែល មជ្ឈមណ្ឌល សម្រេច ដើម្បី ជា ការរួមចំណែក ពង្រឹង នូវ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា និង ចិន ។
ក្នុង ដំណើរ បំពេញ ទស្សនកិច្ច នេះ លោក ថោ គឿន បាន រំលឹក ពី ប្រវត្តិ នៃ ទំនាក់ទំនង រវាង កម្ពុជា និង ចិន ដែល បាន ផ្តួចផ្តើម ឡើង ដោយ ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ និង លោក នាយក រដ្ឋមន្ត្រី ចិន ជូ អេង ឡាយ នៅ ឆ្នាំ ១៩៥៨ ។ លោក ក៏ បាន លើក បង្ហាញ ពី ការវិវឌ្ឍន៍ យ៉ាង ល្អ ប្រសើរ នូវ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ នា ពេល បច្ចុប្បន្ន ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ថ្នាក់ដឹកនាំ របស់ ចិន ។
លោក អនុ រដ្ឋលេខាធិការ រូប នេះ បាន លើកឡើង ថា តាមរយៈ ការថែទាំ និង ពូន ជ្រុំ ដោយ មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ នា ពេល បច្ចុប្បន្ន នេះ ធ្វើឱ្យ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ បាន ក្លាយជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ និង សម្រេច លទ្ធផល ជា ផ្លែ ផ្កា ជាច្រើន ទាំង ផ្នែក នយោបាយ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វប្បធម៌ មនុស្សជាតិ ព្រមទាំង កិច្ចការ ក្នុង តំបន់ និង អន្តរជាតិ ។
ក្រៅពី ការគូស រំលេច និង រំលឹក នូវ ប្រវត្តិសាវតារ នៃ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ ក៏ ដូចជា សមិទ្ធផល ដែល សម្រេចបាន ហើយ នោះ លោក ថោ គឿន បាន បង្ហាញ នូវ បំណង ចង់ ឃើញ ពុទ្ធសាសន បណ្ឌិត្យ និង មជ្ឈមណ្ឌល វប្បធម៌ ចិន ក្នុង រាជធានី ភ្នំពេញ បង្កើន កិច្ចសហប្រតិបត្តិការ នឹង គ្នា ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ផងដែរ ។
ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ នេះ លោក ថោង គឿន បាន ផ្តល់ នូវ ទស្សនទាន ចំនួន ៤រួម មាន៖
១៖ ពុទ្ធសាសន បណ្ឌិត្យ និង មជ្ឈមណ្ឌល វប្បធម៌ ចិន គួរ ចុះអនុស្សរណៈ យោគយល់ គ្នា រវាង ស្ថាប័ន ទាំង ពីរ ក្រោយពេល ដែល ពុទ្ធសាសន បណ្ឌិត្យ ព្រាង នូវ ខ្លឹមសារ រួម ដោយ ជជែក ជាមួយនឹង មជ្ឈមណ្ឌល វប្បធម៌ ចិន ប្រចាំ កម្ពុជា ដើម្បី ឆ្លង មក ខ្ញុំ ដើម្បី ដាក់ ជូន ឯកឧត្តម រដ្ឋមន្ត្រី ស្នើសុំ ការសម្រេច ។
២៖ គួរ រៀបចំ សិក្ខាសាលា រួមគ្នា ដើម្បី ផ្សព្វផ្សាយ ពី ទំនាក់ទំនង ជា ប្រពៃណី រវាង ប្រជាជន និង ប្រជាជន នៃ ប្រទេស យើង ទាំង ពីរ ជាពិសេស ទំនាក់ទំនង ព្រះពុទ្ធ សាសនា ។
៣៖ គួរ ផ្ដល់ ឱកាស ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ក្រសួង ធម្មការ និង សាសនា និយាយ រួម ពុទ្ធសាសន បណ្ឌិត្យ និយាយ ដោយឡែក បាន ទៅ បំពេញ ទស្សនកិច្ច ឈ្វេងយល់ កាន់តែ ស៊ីជម្រៅ បន្ថែម ទៀត ពី វប្បធម៌ ចិន និង ពី ការងារ បណ្ណាល័យ ហើយ បើ មាន ឱកាស ក៏ អាច ទស្សនកិច្ច បន្ថែម ទៀត នៅ បណ្ណាគារ ស៊ីង ជឺ ។
៤៖ គួរ មាន ការរៀបចំ បើក វគ្គ បណ្ដុះបណ្ដាល ភាសា ចិន - ខ្មែរ ថ្នាក់ ដំបូង នៅក្នុង ពុទ្ធសាស បណ្ឌិត្យ ដើម្បី ងាយស្រួល ក្នុង ទំនាក់ទំនង គ្នា ទៅ វិញ ទៅ មក លើ វិស័យ រវាង វប្បធម៌ នៃ ប្រទេស ទាំង ពីរ ឱ្យ ទទួលបាន ជោគជ័យ បន្ថែម ទៀត ហើយ ទៅ ថ្ងៃ អនាគត គួរ ពង្រីក ការស្រាវជ្រាវ រួមគ្នា និង បោះពុម្ព ផ្សាយ ឱ្យ បាន ទូលំទូលាយ ។
លោក ថោ គឿន បាន ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News ថា ទស្សនទាន ក៏ ដូចជា សំណើ ទាំង៤ ដែល បាន លើកឡើង នេះ ត្រូវបាន លោក ឈាន យាន កាង ប្រធាន មជ្ឈមណ្ឌល វប្បធម៌ ចិន នៅ រាជធានី ភ្នំពេញ យល់ព្រម យក ទៅ ពិចារណា ហើយ នឹង ឆ្លើយតប វិញ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ៕ មន្ទីរ បរិស្ថាន ខេត្ត បន្ទាយមានជ័យ បើក កិច្ចប្រជុំ សរុប ការងារ ឆមាស ទី១ និង លើក ទិសដៅ ការងារ បន្ត ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការងារ បរិស្ថាន
( បន្ទាយមានជ័យ )៖ មន្ទីរ បរិស្ថាន ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បើក កិច្ចប្រជុំ បូកសរុប ការងារ បរិស្ថាន ឆមាស ទី១ និង លើក ទិសដៅ ការងារ បន្ត ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការងារ បរិស្ថាន ក្នុង ខេត្ត ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្រោម វត្ដមាន លោកស្រី ម៉ុម ថា នី រដ្ឋលេខាធិកា ក្រសួង បរិស្ថាន លោក អោម ចន្ថា អភិបាល រង ខេត្ត បន្ទាយមានជ័យ . លោក យឹម លី ប្រធាន មន្ទីរ បរិស្ថាន ខេត្ត បន្ទាយមានជ័យ មន្ត្រីរាជការ និង រដ្ឋបាល ក្រុង ស្រុក ទាំង ៩ ។
ក្នុង ឱកាស នោះ លោក យឹម លី បាន ថ្លែង ថា យើង ទាំងអស់ គ្នា ត្រូវ នាំគ្នា ចូលរួម ធ្វើ អនាម័យ និង សំអាត បរិស្ថាន នៅក្នុង ទីផ្សារ ទី សាធារណៈ ទីកន្លែង កំសាន្ត សាលារៀន នៅ ជុំវិញ ផ្ទះ ដោយ ដាក់ សំរាម ឬ វេចខ្ចប់ ទុកដាក់ ក្នុង ធុង សំរាម ឲ្យបាន ត្រឹមត្រូវ ។
លោក បាន បញ្ជាក់ ថា មិន ត្រូវ ដុត សំរាម ដើម្បី បំបាត់ វា ចោល ទេ ព្រោះ វា បណ្តាលឲ្យ មាន ការបំពុល ខ្យល់ និង អាច ប៉ះពាល់ ដល់ សុខភាព មនុស្ស សត្វ ព្រមទាំង ថែរក្សា ការពារ ទ្រព្យសម្បត្ដិ សាធារណៈ ដែល ទាក់ទង ទៅ និង សំណល់ រឹង រាវ ជាដើម ។
លោក យឹម លី បាន បន្ត ទៀត ថា មន្ទីរ បរិស្ថាន ខេត្ត ចំណុះ ឲ្យ ក្រសួង បរិស្ថាន ទទួលខុសត្រូវ ក្នុង កិច្ចការពារ បរិស្ថាន និង ការគ្រប់គ្រង ធនធាន ធម្មជាតិ នៃ តំបន់ ធម្មជាតិ ព្រមទាំង ធ្វើ ការ ទប់ស្កាត់ កាត់បន្ថយ ការបំពុល បរិស្ថាន ។
លោក ថា មន្ត្រី បរិស្ថាន មាន ភារកិច្ច អប់រំ ផ្សាយ និង ពិភាគ្សា ផ្តល់ យោបល់ ព័ត៌មាន អំពី បរិស្ថាន ឲ្យបាន ទូលំទូលាយ ដល់ ប្រជាពលរដ្ឋ និង ជំរុញ ឲ្យ មាន ការចូលរួម គាំទ្រ ពី មជ្ឈដ្ឋាន ព្រមទាំង អនុវត្ត រាល់ គោល នយោបាយ ផែនការ បរិស្ថាន ជាតិ ប្រព័ន្ធ ច្បាប់ លិខិត បទដ្ឋាន គតិយុទ្ធ ។
លោក អោម ចន្ថា បាន ថ្លែង ថា សព្វ ថ្ងៃ នេះ គេ ឃើញ មាន សំរាម នៅ រាយប៉ាយ ពេញ នៅក្នុង ទីប្រជុំជន ដូច្នេះ ក្រុម ម៉ៅការ អនាម័យ ភាស្សី ផ្សារ ត្រូវ ទទួលខុស ត្រូវការបោសសំអាត ជាប្រចាំ និង ត្រូវ មាន វិធានការលាងសំអាត ផ្សារ ឲ្យបាន ស្អាត ល្អ ជារៀងរាល់ ថ្ងៃ ។
លោក ថា ក្រុម ម៉ៅការ ដឹកជញ្ជូន សំរាម តាម ស្រុក ក្រុង ត្រូវ មាន ផែនការប្រមូល ដឹកជញ្ជូន សំណល់ រឹង សំរាម ឲ្យបាន ទាន់ ពេលវេលា ដើម្បី យក ទៅ ចាក់ ឲ្យ ដល់ ទីលាន ចាក់ សំរាម ដាច់ខាត មិន ត្រូវ បន្សល់ទុក គំនរ សំរាម នៅ តាម ដងផ្លូវ និង ទី សាធារណៈ កុំ ឲ្យ មាន សេសសល់ ឡើយ ។
លោក អោម ចន្ថា បាន បញ្ជាក់ ទៀត ថា គ្រប់ មន្ទីរ អង្គភាព គ្រប់ រដ្ឋបាល ក្រុង ស្រុក ឃុំ សង្កាត់ និង ភូមិ ត្រូវ នាំគ្នា ចូលរួម លុបបំបាត់ ភក់ ជ្រាំ ដែល ជា ជម្រក សត្វ មូស និង សំអាត សំណល់ រឹង រាវ កាប់ ល្បាស់ ព្រៃ ជិត ផ្ទះ នៅ តាម ដងផ្លូវ លំ ផ្លូវ ជាតិ ដែល បាំង ផ្លូវការធ្វើចរាចរណ៍ ទៅ មក ជាដើម ៕ អាជ្ញាធរ រាជធានី ភ្នំពេញ គ្រោង អ៊ុត កៅស៊ូ បេទី មីណឺ ពីរ ខ្សែ នៅក្នុង មូលដ្ឋាន ខណ្ឌ ទួលគោក ដើម្បី សម្រួល ចរាចរណ៍ ជូន ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ ដើម្បី សម្រួល ចរាចរណ៍ ឲ្យ ប្រជាពលរដ្ឋ បាន ធ្វើដំណើរ មាន ភាពងាយស្រួល និង ជា ការលើក សោភ័ណភាព រាជធានី ភ្នំពេញ ឲ្យ កាន់តែ ល្អ ប្រសើរ រដ្ឋបាល រាជធានី ភ្នំពេញ គ្រោង អ៊ុត កៅស៊ូ បេទី មីណឺ ចំនួន ពីរ ខ្សែ នៅក្នុង មូលដ្ឋាន ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ និង អនុវត្ត ដោយ ក្រុមហ៊ុន L. N. S. K ខន ស្ត្រាក់ សិន ។
លោក ឃួង ស្រេង ខណៈ ចុះ ពិនិត្យមើល ស្ថានភាព ផ្លូវ ទាំង ២ខ្សែ នេះ បាន បញ្ជាក់ ថា រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង ធ្វើ ការអ៊ុត កៅស៊ូ លើ បណ្ដោយ ផ្លូវ ២ខ្សែ ក្នុង នោះ មាន ផ្លូវ លេខ ១៨៦ និង ផ្លូវ លេខ ២៤៧ ដោយ អ៊ុត ជា ប្រភេទ កៅស៊ូ បេទី មីណឺ ក្នុង នោះ សម្រាប់ ផ្លូវ ២៤៧ គឺ ចាប់ផ្ដើម ពី ផ្លូវ លេខ ១៨៦ ដល់ មុខ សាលា បឋមសិក្សា ទឹក ល្អក់ ។ ចំណែក ផ្លូវ លេខ ១៨៦ វិញ និង អ៊ុត ចាប់ពី ផ្លូវ លេខ ២៤៧ ដល់ ២៦១ ។
ការអ៊ុត កៅស៊ូ ផ្លូវ ទាំង ពីរ ខាងលើ នេះ គឺ ដើម្បី កាត់បន្ថយ នូវ ការកកស្ទះ ចរាចរណ៍ ការសម្រួល ចរាចរណ៍ ជូន ប្រជាពលរដ្ឋ អោយ មាន ភាពងាយស្រួល ហើយក៏ ជា ការលើក សុភ័ណភាព រាជធានី ភ្នំពេញ ឲ្យ មាន ភាពស្រស់ស្អាត ផងដែរ ៕ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ទទួល ថវិកា ជាង ៣ម៉ឺន ដុល្លារ និង ឧបករណ៍ វាស់ កំដៅ ៥០ គ្រឿង ពី គ្រឹះស្ថាន ធានារ៉ាប់រង ចំនួន ២៤ នៅ កម្ពុជា
គួរ រំលឹក ថា « ទិវា ធានារ៉ាប់រង » បាន ប្រារព្ធ ធ្វើឡើង ជា លើក ទី១ កាលពី ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៩ ក្នុង គោលបំណង ជួយ ជំរុញ ទីផ្សារ ធានារ៉ាប់រង កម្ពុជា ឲ្យ កាន់តែ រីកចម្រើន និង ជួយ លើកកម្ពស់ ការយល់ដឹង របស់ សាធារណជន ឲ្យ កាន់តែ ទូលំទូលាយ ក៏ ដូចជា លើកទឹកចិត្ត ដល់ គ្រឹះស្ថាន ធានារ៉ាប់រង ដែល បាន ប្រតិបត្តិការ អាជីវកម្ម របស់ ខ្លួន ប្រកបដោយ អភិបាលកិច្ច ល្អ ផងដែរ ។
បច្ចុប្បន្ន វិស័យ ធានារ៉ាប់រង កំពុង បោះជំហាន ទៅ មុខ ដោយ ភាពរឹងមាំ ដែល វឌ្ឍនភាព នេះ កើត ចេញពី កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា ប្រកបដោយ ថាមពល នៃ គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ។ ជាក់ស្តែង គិត មក ត្រឹម ពេលនេះ កម្ពុជា មាន ក្រុមហ៊ុន ធានារ៉ាប់រង ទូទៅ ចំនួន ១៦ ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត ចំនួន ១៣ និង ក្រុមហ៊ុន ធានារ៉ាប់រង ខ្នាត តូច ចំនួន ៥ បាន ចូលរួម ប្រកប អាជីវកម្ម នៅក្នុង ប្រទេស កម្ពុជា ។
នេះ គឺជា សក្ខីកម្ម មួយ បង្ហាញ យ៉ាង ច្បាស់ នូវ ទំនុកចិត្ត របស់ អ្នក វិនិយោគ ទាំង ក្នុង ប្រទេស និង ក្រៅ ប្រទេស ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា កំណើន នៃ ការយល់ដឹង របស់ ប្រជាជន ចំពោះ សារៈសំខាន់ នៃ ការធានារ៉ាប់រង ។ ក្នុង ឆ្នាំ ២០១៩ កន្លងទៅ បុព្វលាភ ធានារ៉ាប់រង សរុប នៃ ទីផ្សារ ធានារ៉ាប់រង សម្រេចបាន ប្រមាណ ២៥១.៦លាន ដុល្លារ អាមេរិក កើនឡើង ប្រមាណ ២៩ % ធៀប នឹង ឆ្នាំ ២០១៨ និង បាន ទូទាត់ សំណង ជូន អតិថិជន ប្រមាណ ៣៥.៤៧ លាន ដុល្លារ អាមេរិក កើនឡើង ប្រមាណ ៤៦ % ធៀប នឹង ឆ្នាំ ២០១៨ ។
ការធានារ៉ាប់រង គឺជា ផ្នែក មួយ នៃ ប្រព័ន្ធ ហិរញ្ញវត្ថុ ដែល បាន ដើរ តួយ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ជាតិ និង រួមចំណែក ផ្តល់ នូវ យន្តការ ការពារ ហានិភ័យ សម្រាប់ រូប វន្ត បុគ្គល និង នីតិបុគ្គល ។ ការរីកចំរើន របស់ វិស័យ ធានារ៉ាប់រង ជា កត្តា មួយ ជំរុញ ឲ្យ មាន ការរីកចំរើន លើ វិស័យ ជាច្រើន ទៀត តាមរយៈ ការវិនិយោគ លើ មូលនិធិ លើស របស់ ក្រុមហ៊ុន ធានារ៉ាប់រង ដូចជា វិស័យ អចលន ទ្រព្យ សញ្ញា បណ្ណ របស់ ប្រទេស កម្ពុជា ទីផ្សារ មូលបត្រ កម្ពុជា បរធន បាលកិច្ច និង វិស័យ ធនាគារ ។
ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន យកចិត្តទុកដាក់ ក្នុង ការធ្វើ ទំនើបកម្ម ប្រព័ន្ធ ទូទាត់ ការពង្រឹង ក្របខណ្ឌ ច្បាប់ និង បទប្បញ្ញត្តិ អភិបាលកិច្ច និង តម្លាភាព និង បណ្តាញ សុវត្ថិភាព នៃ ការធ្វើ បដិវត្តន៍ ឧស្សាហកម្ម ទី៤ និង សេដ្ឋកិច្ច ឌីជីថល ដែល បាន គាំទ្រ មួយ ចំណែក ធំ ក្នុង ការធ្វើឲ្យ ប្រព័ន្ធ ហិរញ្ញវត្ថុ ដំណើរការ ប្រកប ដោយ ប្រសិទ្ធភាព និង សុវត្ថិភាព និង បាន ចូលរួម យ៉ាង សំខាន់ ក្នុង ការជួយ ដល់ ការរីកចំរើន របស់ វិស័យ ធានារ៉ាប់រង នៅ កម្ពុជា ផងដែរ ។
( កំពង់ឆ្នាំង ) ៖ រថយន្តក្រុង ដឹក អ្នកដំណើរ១ គ្រឿង ដោយសារ បើកបរ ក្នុង ល្បឿន លឿន នៅ កណ្តាល ក្រុង ពេល ដល់ ផ្លូវ ខ្វែង ជា៤ ក៏ បាន បុក រថយន្ត រថយន្ត ធុន ធំ ភ្លៅ៥ ចំពាក់កណ្តាល ពេញ ទំហឹង ខ្ទេច មុខ ខ្លួន ឯង ទាំងស្រុង ទៅ មុខ លែង រួច សំណាង មិន មាន អ្នកធ្វើដំណើរ ណា ម្នាក់ រងរបួស នោះ ទេ ។
ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ខាង លើ នេះ បាន កើតឡើង នៅ វេលា ម៉ោង ៥៖៤៥ នាទី ព្រឹក ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ចំណុច ផ្លូវ ខ្វែង ជា៤ មុខ បេន ឡានក្រុង កំពង់ឆ្នាំង ចន្លោះ បង្គោល គីឡូម៉ែត្រ លេខ ៩០ និង ៩១ ស្ថិត នៅក្នុង សង្កាត់ កំពង់ឆ្នាំង ក្រុង កំពង់ឆ្នាំង ។
នៅក្នុង ករណី នេះ នគរបាល ក្រុង កំពង់ឆ្នាំង បាន ឃាត់ខ្លួនអ្នកបើកបរ រថយន្តក្រុង ឈ្មោះ មុំ លី ឆុង អាយុ ២១ ឆ្នាំ មាន ស្រុក កំណើត ភូមិ ច្រក ជី ឃុំ កំពែង ស្រុក គីរីវង្ស ខេត្ត តាកែវ នាំយក ទៅ ធ្វើ ការពិនិត្យ ទឹកនោម ក្រែង មាន សារធាតុ ញៀន ឬ ជាតិ អាកុល ។ ដោយឡែក អ្នកធ្វើដំណើរ តាម រថយន្តក្រុង ក្រោយពី កើត ហេតុ ត្រូវបាន រថយន្ត ១គ្រឿង ផ្សេង ទៀត មក សាង យក ចេញ ពី កន្លែង កើត ហេតុ ទាំង ព្រឹក ព្រលឹម ផងដែរ ។
ប្រភព ដដែល បាន ឱ្យដឹង ថា ករណី នេះ មិន បង្កឱ្យ មាន អ្នក រងរបួស នោះ ឡើយ ក្រោយពេល កើត ហេតុ សមត្ថកិច្ច ក៏ បាន អូស យក រថយន្ត ទាំង២ គ្រឿង យក ទៅ ការិយាល័យ ចរាចរណ៍ ផ្លូវគោក ខេត្ត ដើម្បី កសាង សំណុំរឿង ដោះស្រាយ តាម នីតិវិធី ៕ បើក វគ្គ ហ្វឹកហាត់ ជំនាញ បច្ចេកទេស អគ្គិភ័យ និង សង្គ្រោះ ដល់ កម្លាំង ជំនាញ និង ក្រុម ប្រជាការពារ ស្ម័គ្រចិត្ត នៅ ក្រុង ស្វាយរៀង
( ស្វាយរៀង ) ៖ វគ្គ ហ្វឹកហាត់ ជំនាញ បច្ចេកទេស អគ្គិភ័យ និង សង្គ្រោះ ដល់ កម្លាំង ជំនាញ និង ក្រុម ប្រជាការពារ ស្ម័គ្រចិត្ត ត្រូវបាន ធ្វើឡើង នៅ ទីធ្លា តារាង បាល់បោះ នៃ វិទ្យាល័យ ស្វាយរៀង ក្រោម អធិបតីភាព លោក ណុប ចំរើន អភិបាល ក្រុង ស្វាយរៀង និង លោក វរៈ សេនីយ៍ ឯក ប្រាក់ ជុត ស្នងការ រង នគរបាល ខេត្ត ។
ពិធី នោះ ក៏ មាន ការចូលរួម ពី លោក សួស សារិន នាយ ការិយាល័យ បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ និង លោក អធិការ នគរបាល ក្រុង លោក មេបញ្ជាការ កងរាជអាវុធហត្ថ ក្រុង ក្រុម គ្រូបង្គោល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត និង ប្រជាការពារ ស្ម័គ្រចិត្ត សរុប វត្តមាន ចំនួន ២៤៦ នាក់ ស្រី ១នាក់ ក្នុង នោះ កម្លាំង ប្រជាការពារ ២១៥ នាក់ ។
លោក សួស សារិន បាន ឲ្យដឹង ថា ការបើក វគ្គ ហ្វឹកហាត់ ជំនាញ បច្ចេកទេស អគ្គិភ័យ និង សង្គ្រោះ ដល់ កម្លាំង ជំនាញ និង ក្រុម ប្រជាការពារ ស្ម័គ្រចិត្ត គឺ រួមគ្នា បង្ការ ទប់ស្កាត់ កុំ ឲ្យ មាន កម្ទេច ភ្លើង ក្លាយជា អគ្គិភ័យ ដែល នាំឲ្យ មហន្តរាយ ដល់ អាយុជីវិត ទ្រព្យសម្បត្តិ និង បរិស្ថាន ។
( រតនគិរី ) ៖ រដ្ឋមន្រ្តី ក្រសួង មុខងារ សារណៈ លោក ព្រុំ សុខា បាន សម្តែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការរីកចម្រើន លើ គ្រប់ វិស័យ ក្នុង ទឹកដី នៃ ខេត្ត រតនគិរី ក្រោម ការសាមគ្គី គ្នា របស់ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ បាន ធ្វើឲ្យ ខេត្ត ក្នុង ភូមិភាគ ឥសាន្ត មួយ នេះ ប្រែ មុខមាត់ ថ្មី មិន ចាញ់ បណ្តា ខេត្ត នានា នោះ ឡើយ ។
ការកោតសរសើរ នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ក្នុង ពិធី សំណេះសំណាល ជាមួយ មន្រ្តី រាជការ និង បិទ បញ្ជប់ របាយការណ៍ សវនកម្ម ផ្ទៃក្នុង មន្ទីរ មុខងារ សាធារណៈ ខេត្ត រតនគិរី នា ព្រឹក ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ នៅ អគារមន្ទីរ មុខងារ សាធារណៈ ខេត្ត រតនគិរី ។
លោក រដ្ឋមន្ត្រី ព្រុំ សុខា បាន លើកឡើង ថា អ្វី ៗ ជា សមិទ្ធិផល ដែល ខេត្ត រតនគិរី សម្រេចបាន នេះ គឺ មិន អាច កាត់ផ្តាច់ បាន ពី គុណូបការៈ ដ៏ ថ្លៃថ្លា របស់ ព្រឹទ្ធាចារ្យ ប៊ូ ថង ដែល ជា ស្ថាបនិក ទីក្រុង បាន លុង បាន ឡើយ ។ លោក បន្ត ថា ព្រឹទ្ធាចារ្យ ប៊ូ ថង បាន រួមចំណែក ច្រើន ណាស់ ក្នុង ការកសាង និង អភិវឌ្ឍន៍ មាតុភូមិ កម្ពុជា ជាពិសេស ខេត្ត រតនគិរី តែម្តង ។
លោក ព្រុំ សុខា ក៏ បាន លើកឡើង ផងដែរ ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ការកសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ជាពិសេស ក្នុង ស្ថានភាព នៃ ការរីករាលដាល ជា សកល ពី ជំងឺ កូវីដ - ១៩ ។ បើ ទោះជា សេដ្ឋកិច្ច ជាតិ រង ផល ប៉ះពាល់ ពី ជំងឺ ដ៏ កាច សាហាវ នេះ ក៏ ពិត មែន តែ មន្រ្តី រាជការ ស៊ីវិល គ្រូបង្រៀន និង កងកម្លាំង នៅតែ បន្ត និរន្តភាព បើក ប្រាក់ បៀវត្ស យ៉ាង ទៀងទាត់ ។
ជាង នេះ ទៅ ទៀត ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយ ជំងឺ កូវីដ - ១៩ ក៏ ត្រូវបាន រាជ រដ្ឋាភិបាល គិតគូរ យកចិត្តទុកដាក់ តាមរយៈ ការបញ្ចេញ ថវិកា រាប់ រយ លាន ដុល្លារ ឧបត្ថម្ភ ដល់ ពួកគាត់ ក្នុង កាលៈទេសៈ នៃ វិបត្តិ កូវីដ - ១៩ នេះ ។
បន្ថែម លើ នេះ លោក រដ្ឋមន្ត្រី ព្រុំ សុខា ក៏ បាន ស្នើឲ្យ អាជ្ញាធរ ខេត្ត រតនគិរី សូម បន្ត រួមគ្នា ប្រយុទ្ធ ប្រឆាំង និង ជំងឺ កូវីដ - ១៩ ដើម្បី កុំ ឲ្យ ជំងឺ នេះ មាន ការឆ្លង ដល់ សហគមន៍ និង ត្រូវ បន្ត ការងារ ផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ប្រសើរ បន្ថែម ទៀត ។
ដោយឡែក មន្រ្តី រាជការ មន្ទីរ មុខងារ សាធារណៈ សូម បន្ត សាមគ្គីភាព ផ្ទៃក្នុង និង ត្រូវ ធ្វើជា សេនាធិការ ឲ្យ ថ្នាក់ដឹកនាំ ខេត្ត លើ ផ្នែក មុខងារ សាធារណៈ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ៕
លោក ជឿជាក់ ថា អតិថិជន ប្រើប្រាស់ កម្មវិធី KESS នឹង ទទួលបាន មធ្យោបាយ ងាយស្រួល ក្នុង ការទូទាត់ ថ្លៃ ផលិតផល និង សេវាកម្ម នានា ដោយ គាំទ្រ សហគ្រិន និង ផលិត ករ ក្នុង ស្រុក និង ក្នុង ពេល ជាមួយគ្នា ជំរុញ កម្ពុជា ឲ្យ ក្លាយជា សង្គម ដែល មាន ការទូទាត់ បែប ឌីជីថល ។
លោក បាន បន្ដ ទៀត ថា ប្រព័ន្ធ ទូទាត់ រួម តែ មួយ ដូចជា អ្នកលក់ ច្រើន ការគ្រប់គ្រង សារពើ ភណ្ឌ សេវា ដឹកជញ្ជូន ទូទាត់ វិក្កយបត្រ ទឹក / ភ្លើង ឆាត ជាមួយ មិត្តភក្តិ / អ្នកលក់ ។ ប្រព័ន្ធ ទូទាត់ ពាណិជ្ជកម្ម អេឡិកត្រូនិក KESS និង កម្មវិធី ទូរស័ព្ទ នឹង ដាក់ ដំណើរការ នៅ ខែកញ្ញា ឆ្នាំ ២០២០ ខាងមុខ នេះ ។
សហ ស្ថាបនិក បេ្តជ្ញាចិត្ត បង្កើត ប្រព័ន្ធ ទូទាត់ មួយ ដែល មាន សមត្ថភាព ក្នុង ការឆ្លើយតប នឹង តម្រូវការ ដែល វិវត្ត យ៉ាង រហ័ស របស់ អាជីវកម្ម សកល ដែល រីកចម្រើន យ៉ាង លឿន ។ ប្រព័ន្ធ ទូទាត់ KESS អនុញ្ញាតឲ្យ សាជីវកម្ម / ពាណិជ្ជករ ធ្វើ ការផ្ទេរ / ទទួល ការទូទាត់ ក្នុង ប្រព័ន្ធ តែ មួយ បាន ។ ផលិតផល របស់ KESS មាន៖
អ្នកនាំពាក្យ ខាង លើ នេះ បាន បន្ថែម ទៀត ថា នៅក្នុង ឧទ្ធម្ភាគចក្រ នោះ មាន ទាហាន ០៥ នាក់ ដោយ ០២ នាក់ ជា អាកាសយានិក និង ០៣ នាក់ ទៀត ជា សមាជិក ។ ក្នុង ចំណោម ពួកគេ មាន តែ ម្នាក់ ប៉ុណ្ណោះ ដែល អាច រួច រស់ ជីវិត ចំណែកឯ ០៤ នាក់ ទៀត ស្លាប់ ៕ អភិបាល ខេត្ត មណ្ឌលគិរី អំពាវនាវ ពលរដ្ឋ រួមគ្នា ថែរក្សា ការពារ ធនធាន ធម្មជាតិ និង មជ្ឈមណ្ឌល វប្បធម៌ ជនជាតិ ដើម ភាគ តិច ភ្នំ ដោះ ក្រមុំ និង មជ្ឈមណ្ឌល វប្បធម៌ ផ្សេង ៗ ឱ្យ បាន គង់វង្ស
( មណ្ឌលគិរី ) ៖ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី នៅក្នុង ពិធី អបអរសាទរ រុក្ខ ទិវា ៩ កក្កដា ឆ្នាំ ២០២០ នេះ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ រួមគ្នា ថែរក្សា ការពារ ធនធាន ធម្មជាតិ ក៏ ដូចជា មជ្ឈមណ្ឌល វប្បធម៌ ជនជាតិ ដើម ភាគ តិច ភ្នំ ដោះ ក្រមុំ និង មជ្ឈមណ្ឌល វប្បធម៌ ផ្សេង ៗ ឱ្យ បាន គង់វង្ស ដើម្បី ធ្វើ ការអភិវឌ្ឍន៍ តំបន់ ទាំងនោះ ឱ្យ ក្លាយជា តំបន់ មួយ ដែល អាច ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ឱ្យ មក ទស្សនា កំសាន្ត នៅ ខេត្ត មណ្ឌលគិរី មាន ការកើនឡើង ជារៀងរាល់ ឆ្នាំ ។
ពិធី នេះ ធ្វើឡើង នៅ បរិវេណ ភ្នំ ដោះ ក្រមុំ ភូមិ ដោះ ក្រមុំ សង្កាត់ សុខដុម ក្រុង សែនមនោរម្យ នា ព្រឹក ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ ។
