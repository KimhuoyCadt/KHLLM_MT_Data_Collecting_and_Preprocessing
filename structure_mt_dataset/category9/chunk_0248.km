( បន្ទាយមានជ័យ ) ៖ បុរស ម្នាក់ ដោយសារតែ ថ្នាំ ញៀន ចូលខ្លួន គ្រាន់តែ ឪពុក ស្តី ឲ្យ ឈប់ ជក់ ថ្នាំ ញៀន និង ឡើង លើ ផ្ទះ សោះ ស្រាប់តែ ផ្ទុះ កំហឹង យក ដែក កេះ ដុត ផ្ទះ ចោល ឆេះ អស់ ១ ខ្នង នៅ ល្ងាច ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ភូមិ ភ្នំ ធំ ថ្មី ឃុំ អូរ ប្រាសាទ ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ ។
លោក វរសេនីយ៍ ឯក ប៊ុន ផេង ស្នងការ រង ទទួល ផែនការងារ គ្រប់គ្រង អាវុធ ជាតិ ផ្ទុះ និង អគ្គីភ័យ បាន ឲ្យដឹង ថា ផ្ទះ ដែល កូន ដុក កំទេចចោល នោះ ធ្វើ អំពី ឈើ ប្រក់ ស័ង្កសី ថ្ម ក្រោម មាន ទំហំ ៧ X ៨ម៉ែត្រ ម្ចាស់ មាន ឈ្មោះ ស្រឹម វុទ្ធី ភេទ ប្រុស អាយុ ៤៦ ឆ្នាំ នៅ ភូមិ ភ្នំ ធំ ថ្មី ឃុំ អូរ ប្រាសាទ ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ មាន សមាជិក ក្នុង គ្រួសារ ៦នាក់ ស្រី ២នាក់ ។
លោក ស្នងការ រង បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា តាម ការឲ្យដឹង ពី ម្ចាស់ ផ្ទះ ទំហំ នៃ ការខូចខាត ទាំង ផ្ទះ និង សម្ភារៈ ប្រើប្រាស់ ក្នុង ផ្ទះ សរុប ជា ទឹកប្រាក់ ចំនួន ១៦.០០០ ដុល្លារ ជនសង្ស័យ ពេល ដុត ហើយ រត់គេចខ្លួន បាត់ កម្លាំង នគរបាល ស្រុក មង្គល បូរី កំពុង ស្រាវជ្រាវ តាម រក ចាប់ខ្លួន យកមក ផ្តន្ទាទោស តាម ច្បាប់ ៕ រដ្ឋបាល ស្រុក អូរ រាំង ឱ្យ ពលរដ្ឋ មាន វិវាទ ដីធ្លី ទៅ ដាក់ ពាក្យ បណ្តឹង ដើម្បី អាជ្ញាធរ ចុះ ដោះស្រាយ ជូន
( មណ្ឌលគិរី ) ៖ រដ្ឋបាល ស្រុក អូរ រាំង ខេត្ត មណ្ឌលគិរី បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ កំពុង មាន វិវាទ ដីធ្លី ឱ្យ ទៅ ដាក់ ពាក្យ បណ្តឹង ឬ តាមដាន បណ្តឹង របស់ ខ្លួន នៅ ការិយាល័យ នីតិកម្ម និង ដោះស្រាយ វិវាទ នៃ រដ្ឋបាល ស្រុក អូរ រាំង ដើម្បីឱ្យ មន្ត្រី រដ្ឋបាល ស្រុក និង ក្រុមការងារ ថ្នាក់ ជាតិ ធ្វើ ការសម្របសម្រួល និង ដោះស្រាយ បញ្ចប់ ជូន ។
យោង តាម សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ស្រុក បាន គូសបញ្ជាក់ ថា ប្រជាពលរដ្ឋ ដែល កំពុង កាន់កាប់ ដី រដ្ឋ ហើយ បាន អាស្រ័យ ផល ជាក់ស្តែង ដោយ ធ្វើ ការដាំដុះ ដំណាំ ពិតប្រាកដជាច្រើន ឆ្នាំ ហើយ នោះ ក៏ អាច ទៅ ដាក់ ពាក្យ បណ្តឹង នៅ រដ្ឋបាល ស្រុក ផងដែរ ដើម្បី កំណត់ ឱ្យ មាន ភាពច្បាស់លាស់ នូវ សិទ្ធិ កាន់កាប់ និង អាស្រ័យ ផល ជាក់ស្តែង ។
ក្នុង សេចក្តីជូនដំណឹង បាន គូសបញ្ជាក់ ថា ការដាក់ ពាក្យ បណ្តឹង ឬ ទៅតាម ដាន បណ្តឹង របស់ ខ្លួន នៅ ការិយាល័យ នីតិកម្ម និង ដោះស្រាយ វិវាទ នៃ រដ្ឋបាល ស្រុក អូរ រាំង រាល់ ម៉ោង ធ្វើការចាប់ពី ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ ដល់ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២០ ។
សូម បញ្ជាក់ ថា អាជ្ញាធរ ថ្នាក់ ជាតិ ដែល មាន កិច្ចសហការ គ្នា ដោយ ក្រសួង ចំនួន ៣ រួម មាន៖ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ . ក្រសួង បរិស្ថាន និង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន និង កំពុង ចុះ រៀបចំ ចាត់ចែង បែងចែក ដី ដែល ជា ដី គម្រប ព្រៃឈើ ដី អភិរក្ស របស់ រដ្ឋ ជូន ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត មណ្ឌលគិរី ។
ការងារ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បញ្ជា ឱ្យ កាត់ ឆ្កៀល ដី គម្រប ព្រៃឈើ ឬ ដី អភិរក្ស នោះ ជូន ទៅ ប្រជាពលរដ្ឋ តាម ការកាន់កាប់ ឬ អាស្រ័យ ផល ជាក់ស្តែង ៕
មុខ សញ្ញា ជួញដូរ គ្រឿងញៀន នៅ សង្កាត់ ត្រពាំង ក្រសាំង ខណ្ឌ ពោធិ៍សែនជ័យ ត្រូវ សមត្ថកិច្ច បង្ក្រាប ដកហូត គ្រឿងញៀន មួយចំនួន
( ភ្នំពេញ ) ៖ មុខ សញ្ញា ជួញដូរ គ្រឿង ម្នាក់ ត្រូវ កម្លាំង នគរបាល ប៉ុស្តិ៍ ត្រពាំង ក្រសាំង ធ្វើ ការឃាត់ខ្លួន ខណៈពេល ល្បាត ទប់ស្កាត់ បទល្មើស និង ធ្វើ ការស្រាវជ្រាវ រយៈពេល ២ខែ កន្លងមក ហើយ រហូត ពេលនេះ ទើប ទទួលបាន ព័ត៌មាន ច្បាស់ ពី ប្រជាពលរដ្ឋ ហើយ កម្លាំង ក៏ បាន ចុះ ទៅ ធ្វើ ការចាប់ខ្លួន មុខ សញ្ញា មួយ នេះ បាន តែម្ដង ។
ការ បង្រ្កាប និង ចាប់ខ្លួន ជន នោះ ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នៅក្នុង ភូមិ សាមគ្គី ទី៤ សង្កាត់ ត្រពាំង ក្រសាំង ខណ្ឌ ពោធិ៍សែនជ័យ ។ ជនសង្ស័យ ខាងលើ ឈ្មោះ សាន់ រ៉ៃយ៉ា ហៅ យ៉ា អាយុ ២៨ ឆ្នាំ មុខរបរ កម្មករ ស្នាក់ នៅក្នុង ភូមិ កើត ហេតុ ខាង លើ ក្នុង នោះ សមត្ថកិច្ច ដកហូត ថ្នាំ ញៀន ចំនួន ៨កញ្ចប់ តូច ។
លោក អនុ សេនីយ៍ ឯក នាង ឧត្តម នាយ នគរបាល ប៉ុស្តិ៍ ត្រពាំង ក្រសាំង បាន ឲ្យដឹង ថា ជនសង្ស័យ រូប នេះ ជា មុខសញ្ញា ជួញដូរ គ្រឿងញៀន មួយ ដ៏ សកម្ម បំផុត នៅ តំបន់ ខាងលើ និង ប្រកប មុខរបរ ល្មើស ច្បាប់ នេះ យូរ មកហើយ ។ ចំណែក កម្លាំង របស់ លោក មាន ការសង្ស័យ ក៏ យូរ មកហើយ ដែរ និង បាន តាមឃ្លាំមើល រហូត ប៉ុន្តែ ពុំ មាន ឱកាស បង្រ្កាប ទាល់តែសោះ ដោយ គ្រាន់តែ តាម រយៈពេល ២ខែ កន្លងមក ។
លោក នាយ នគរបាល ប៉ុស្តិ៍ បាន បន្ត ថា រហូតដល់ ថ្ងៃទី៣០ ខែកក្កដា នេះ កម្លាំង នគរបាល ប៉ុស្តិ៍ របស់ លោក បាន ចេញ ល្បាត ពួន ស្ទាក់ បទល្មើស ផង និង ធ្វើ ការស្រាវជ្រាវ ផង ហើយ បាន ទទួល ដំណឹង ថា ជនសង្ស័យ ចេញ ធ្វើ សកម្មភាព ជួញដូរ គ្រឿងញៀន ។ ទើប ចុះ ទៅ បង្រ្កាប និង ឃាត់ខ្លួន បាន ភ្លាម ៗ ព្រមទាំង ដកហូត បាន ចំនួន ៨កញ្ចប់ តូច ដែល សល់ ពី ជន នោះ លក់ បន្ទាប់មក បាន នាំ ទៅ សាកសួរ នៅ ប៉ុស្តិ៍ រង់ចាំ ការកសាង សំណុំរឿង ចាត់ការ តាម ច្បាប់ ៕ បង្ក្រាប ទីតាំង បើក ល្បែង ជល់ មាន់ មួយ កន្លែង នៅ ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ ទីតាំង លួច បើក ល្បែង ជន់ មាន់ ភ្នាល់ ដាក់ លុយ មួយ កន្លែង នៅ ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម ត្រូវ កម្លាំង ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម ចុះបង្ក្រាប ។ ប្រតិបត្តិការ នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ ក្រោយ មាន បញ្ជា ពី លោក ឧត្ដមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម ។
របាយការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត បាន ឲ្យដឹង ថា ក្រោយ ទទួលបាន ព័ត៌មាន ពី ប្រជាពលរដ្ឋ លោក ឧត្តមសេនីយ៍ ស្នងការ បាន បញ្ជា កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក ចំការលើ ចុះបង្ក្រាប ទីតាំង លួច លាក់ លេង ល្បែងស៊ីសង ខុស ច្បាប់ ( ជល់ មាន់ ភ្នាល់ ដាក់ លុយ ) នៅ ចំណុច ក្នុង ចំការស្វាយចន្ទី ព្រុំ ប្រទល់ ខេត្ត កំពង់ចាម ជាមួយនឹង ខេត្ត កំពង់ធំ ស្ថិត ក្នុង ភូមិ ពព្រេង ឃុំ ស្ពឺ ស្រុក ចំការលើ ។
ជា លទ្ធផល ក្នុង ពេល បង្ក្រាប ក្រុម មុខ សញ្ញា អ្នកលេង ល្បែង បាន នាំគ្នា រត់គេចខ្លួន អស់ បន្សល់ទុក វត្ថុតាង មួយចំនួន រួម មាន ម៉ូតូ ចំនួន ០៥ គ្រឿង . អង្រុត ក្រុង ជល់ មាន់ ចំនួន ០២. ក ន្រ្តក់ ដាក់ មាន់ ចំនួន ០១ និង ស្កុត រុំ ជើង មាន់ មួយចំនួន ។ បច្ចុប្បន្ន វត្ថុតាង ខាងលើ ត្រូវបាន យកមក រក្សាទុក នៅ អធិការដ្ឋាន នគរបាល ស្រុក ចំការលើ ដើម្បី កសាង សំណុំរឿង តាម នីតិវិធី ៕
ផ្ទះ លំហែ កាយ ក្នុង គម្រោង ទីក្រុង វិស្សមកាល ឆ្នេរ តារាចន្ទ តម្លៃ ក្រោម ៦ម៉ឺន ដុល្លារ !
( កោះកុង) ៖ ខេត្ត កោះកុង គឺជា តំបន់ ភ្នំ ជាប់ ឆ្នេរសមុទ្រ ស្ថិត នៅ ប៉ែក និរតី នៃ ប្រទេស ហើយ ជា ខេត្ត មួយ ក្នុង ចំណោម ខេត្ត ជាប់ សមុទ្រ ទាំង៤ របស់ ប្រទេស កម្ពុជា ។
ទឹកដី ដ៏ ស្រស់ ត្រកាល នេះ ប្រជុំ ទៅ ដោយ ធនធាន ធម្មជាតិ ជីវៈ ចម្រុះ យ៉ាង សម្បូរបែប និង ឆ្នេរសមុទ្រ យ៉ាង វែង អន្លាយ ប្រវែង ២១៥ គីឡូម៉ែត្រ ហើយ ជា ជម្រក ព្រៃ កោងកាង ធំ បំផុត លំដាប់ ទី២ នៅក្នុង ពិភពលោក ។
ខេត្ត កោះកុង ក៏ មាន ទីតាំង ភូមិសាស្រ្ត យ៉ាង អំណោយផល ផងដែរ ពោល គឺ មាន ព្រំប្រទល់ ជាប់ ឈូង សមុទ្រ ថៃ ព្រំដែន ប្រទេស ថៃ និង បណ្ដា ខេត្ត នៅ ប៉ែក និរតី ពិសេស ខេត្ត ព្រះសីហនុ ដែល ជា តំបន់ ពាណិជ្ជកម្ម ធំ បំផុត បន្ទាប់ពី រាជធានី ភ្នំពេញ ។
លក្ខណៈ ពិសេស ទាំងអស់ នេះ បាន ធ្វើឲ្យ ខេត្ត កោះកុង ក្លាយទៅជា ទិសដៅ អភិវឌ្ឍន៍ ដ៏ ទាក់ទាញ បំផុត មួយ សម្រាប់ វិនិយោគិន ក្នុង ស្រុក និង ក្រៅ ប្រទេស ។
ក្នុង ចំណោម គម្រោង ថ្មី ៗ ជាច្រើន ដែល គ្រោង នឹង ផុស រូបរាង នា ប៉ុន្មាន ឆ្នាំ ខាងមុខ នេះ គម្រោង ដែល មាន ភាពលេចធ្លោ បំផុត គឺ គម្រោង ឆ្នេរ តារាចន្ទ ។
ឆ្នេរ តារាចន្ទ គឺជា ឋានសួគ៍ លំហែ កាយ បែប វប្បធម៍ និង អេកូឡូស៊ី តាម បណ្ដោយ ឆ្នេរសមុទ្រ ដែល មាន ទីតាំង ស្ថិត នៅក្នុង ស្រុក បុទុម សាគរ ខេត្ត កោះកុង ។
ឆ្នេរ តារាចន្ទ គឺជា ផ្នែក មួយ នៃ គម្រោង អភិវឌ្ឍន៍ ទីក្រុង លម្ហែ កាយ ខ្នាត យក្ស តារា សាគរ ដែល លាតសន្ធឹង លើ ផ្ទៃដី ទំហំ ៣៦០ គីឡូម៉ែត្រ ការ៉េ និង ឆ្នេរសមុទ្រ ដ៏ ស្រស់ស្អាត ប្រវែង ៩០ គីឡូម៉ែត្រ ។
គម្រោង ឆ្នេរ តារាចន្ទ ជា គម្រោង អភិវឌ្ឍន៍ ចម្រុះ ជាមួយនឹង ទំហំ អភិវឌ្ឍន៍ សរុប ប្រមាណ ៤.៥ លាន ម៉ែត្រ ការ៉េ គ្របដណ្ដប់ លើ ផ្ទៃដី ២០ គីឡូម៉ែត្រ ការ៉េ ។ គម្រោង ទីក្រុង វិស្សមកាល នេះ រួមបញ្ចូល នូវ លំនៅឋាន លក្ខណៈ ឯកជន សណ្ឋាគារ លំដាប់ ផ្កាយ ប្រាំ និង រមណីយដ្ឋាន អេកូឡូស៊ី ជាប់ ឆ្នេរសមុទ្រ ដែល នាំមក នូវ បទពិសោធ ថ្មី និង ប្លែក នៃ ការរុករក ក្នុង ពិភព បាត សមុទ្រ និង ឧទ្យាន អេកូឡូស៊ី ដ៏ ស្រស់ស្អាត ដាច់ គេ ។
ជាមួយគ្នា នេះ គម្រោង ឆ្នេរ តារាចន្ទ រួមបញ្ចូល នូវ អគារ ពាណិជ្ជកម្ម ស្តង់ដារ អន្តរជាតិ ដែល មាន ផ្សារទំនើប មជ្ឈមណ្ឌល កម្សាន្ត ហាង លក់ ទំនិញ ភោជនីយដ្ឋាន ហាង កាហ្វេ បារ រោង ភាពយន្ត សាល រៀបចំ កម្មវិធី មណ្ឌល សុខភាព និង មជ្ឈមណ្ឌល អប់រំ ជាដើម ។
បន្ថែម ពីលើ នេះ ទៀត គម្រោង នេះ ស្ថិត នៅក្បែរ អាកាសយាន្ត ដ្ឋាន ស្តង់ដារ អន្តរជាតិ តារា សាគរ និង ទីលាន វាយ កូន ហោ្គល ប្រប ឆ្នេរសមុទ្រ តារា សាគរ ថែម ទៀត ផង ។
គម្រោង ឆ្នេរ តារាចន្ទ បាន ចាប់ផ្ដើម ជា ផ្លូវការ នូវ គម្រោង អភិវឌ្ឍន៍ ដំណាក់កាល ទី១ ហើយ រំពឹង ថា នឹង បញ្ចប់ ជាសាងសង់ ជា ស្ថាពរ ត្រឹម ឆ្នាំ ២០២១ ។
ក្នុង ដំណាក់កាល ដំបូង នេះ ក្រុមហ៊ុន អភិវឌ្ឍន៍ ផ្តោត សំខាន់ លើ ការសាងសង់ លំនៅឋាន ឯកជន ដែល គ្របដណ្ដប់ លើ ផ្ទៃដី ១៧០.០០០ ម៉ែត្រ ការ៉េ ។
គម្រោង នេះ ផ្ដល់ជូន ជម្រើស ផ្ទះ វីឡា និង ផ្ទះ បឹង ហ្គាឡូ ចំនួន ៦ប្រភេទ ចាប់ពី យូនីត បន្ទប់ គេង១ ដល់ បន្ទប់ គេង ៣ និង ទំហំ ចាប់ពី ៣៥ម៉ែត្រ ការ៉េ ដល់ ៣០២ម៉ែត្រ ការ៉េ ។
ចំពោះ ការរចនា ខាងក្នុង វិញ ស្ថាបត្យករ បាន រួមបញ្ចូល គ្នា រវាង រចនាបថ ប្រពៃណី ខ្មែរ និង ស្ថាបត្យកម្ម បែប រមណីយដ្ឋាន វិស្សមកាល ដែល មិន ត្រឹមតែ នាំមក នូវ ភាពស្រស់ស្រាយ និង ធូរស្បើយ ក្នុង អារម្មណ៍ ថែមទាំង បង្កើត នូវ បរិយាកាស ប្រកបដោយ ភាពស្និទ្ធស្នាល ផ្អែមល្ហែម និង រ៉ូមេន ទិក ។
ផ្ទះ នីមួួយ ៗ មាន បន្ទប់ គេង យ៉ាង ស្រស់ស្អាត បន្ទប់ ទទួល ភ្ញៀវ និង រាន ហាល នៅ ខាងមុខ ផ្ទះ ដែល អាច ឲ្យ អ្នក រស់ នៅ សម្រាក ស្រូបយក ខ្យល់អាកាស បរិសុទ្ធ ពី ឆ្នេរសមុទ្រ ក៏ ដូចជា អង្គុយ គយគន់ ទិដ្ឋភាព ថ្ងៃ លិច លើ មហាសាគរ ដ៏ ស្រស់បំព្រង ជាមួយ គូស្នេហ៍ ក្រោម បរិយាកាស ដ៏ រ៉ូមេន ទិក ។
លំនៅឋាន ក្នុង គម្រោង ឆ្នេរ តារាចន្ទ មាន តម្លៃ ចាប់ផ្ដើម ត្រឹមតែ ៥៦. ៣២០ ដុលា្លរ ប៉ុណ្ណោះ ។ សម្រាប់ លោក អ្នក ដែល ទិញ ផ្ទះ នៅ ថ្ងៃ នេះ នឹង ទទួលបាន អត្ថប្រយោជន៍ ជាច្រើន ដូច ជា៖
១៖ ក្លាយជា សមាជិក អចិន្រៃ្តយ៍ នៃ រមណីយដ្ឋាន វិស្សមកាល តារា សាគរ
២៖ ជម្រើស ក្នុង ការជួល ត្រលប់ ទៅកាន់ ម្ចាស់ គម្រោង
៣៖ ជម្រើស ក្នុង លក់ ត្រលប់ ទៅកាន់ ម្ចាស់ គម្រោង វិញ ក្នុង តម្លៃ ដើម ( ៥ ឆ្នាំ ក្រោយ ការប្រគល់ លំនៅឋាន ជា ផ្លូវការ )៕
សាខា កាកបាទ ក្រហម ខេត្ត ពោធិ៍សាត់ នាំយក អំណោយ មនុស្សធម៌ ផ្តល់ ជូន ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ១១៥ គ្រួសារ នៅ ស្រុក បាកាន
ពិធី នេះ ប្រារព្ធ ធ្វើ នៅ បរិវេណ វត្ត ចំបក់ មាស ស្ថិត ក្នុង ភូមិ ចំបក់ មាស ឃុំ ស្នាម ព្រះ ស្រុក បាកាន ដោយ បាន ការចូលរួម ពី លោក ខូយ រីដា អភិបាល រង ខេត្ត និង ជា អនុប្រធាន អចិន្ត្រៃយ៍ ព្រមទាំង គណៈ កិត្តិយស លេខាធិការ គណៈកម្មាធិការ សមាជិក សមាជិកា សាខា កាកបាទ ក្រហម ខេត្ត និង អនុសាខា កាកបាទ ក្រហម ស្រុក ជាច្រើន នាក់ ទៀត ។
លោក ម៉ៅ ធ និន បាន ផ្ដាំផ្ញើ ការសួរសុខទុក្ខ ពី ចម្ងាយ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា តែងតែ យកចិត្តទុកដាក់ គិតគូរ អំពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ដោយ មិន ទុក ឱ្យ ប្រជាពលរដ្ឋ របស់ យើង ណា ម្នាក់ អត់ ស្បៀងអាហារ ស្លាប់ នោះ ទេ ត្រូវ ធ្វើ យ៉ាងណា ជួយ ប្រជាពល រដ្ឋ ឱ្យ ទាន់ ពេលវេលា « ពោលគឺ ទីណា មាន ការលំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា » ។
លោក បាន បន្ថែម ថា អំណោយ ទាំងអស់ នេះ អាច ជួយ សម្រួល ការខ្វះខាត របស់ បងប្អូន បាន រយៈពេល ខ្លី ប្រសិនបើ មាន ការខ្វះខាត ឬ បញ្ហា ផ្សេង ៗ ត្រូវ ផ្តល់ ដំណឹង មក មេភូមិ មេឃុំ ឬ អាជ្ញាធរ ស្រុក ជាពិសេស លេខ ទូរស័ព្ទ ទាំង២ ប្រព័ន្ធ របស់ លោក ដើម្បី មាន វិធានការឆ្លើយតប បាន ទាន់ ពេលវេលា ដោយ មិន ទុក ឱ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ អត់ អាហារ នោះ ទេ ។
ម្យ៉ាង វិញ ទៀត ការនាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ នា ពេលនេះ ដោយ មិន ប្រកាន់ វណ្ណៈ ជាតិ សាសន៍ ពណ៌ សម្បុរ ឬ និន្នាការ នយោបាយ អ្វី នោះ ឡើយ គឺ យើង ជួយ ពួកគាត់ ក្នុង នាម មនុស្សធម៌ និង ជា វប្បធម៌ នៃ ការចែករំលែក ។
ក្នុង នាម រដ្ឋបាល ខេត្ត លោក ក៏ បាន ស្នើ ឱ្យ លោក មេឃុំ មេភូមិ មន្ត្រី នគរបាល រដ្ឋបាល និង ប្រជាការពារ ខិតខំ បម្រើ សេវា សាធារណៈ រក្សា ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ លុបបំបាត់ ភាព អសកម្ម នានា សំដៅ ធ្វើ យ៉ាងណា ផ្តល់ នូវ ភាព កក់ក្តៅ ជូន ប្រជាជន នៅ មូលដ្ឋាន ឱ្យ កាន់តែ ប្រសើរឡើង ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន បាន បន្ត ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ លោកគ្រូ អ្នកគ្រូ និង ក្មួយ ៗ ក្រុមប្រឹក្សា យុវជន ក្នុង សាលា បឋមសិក្សា ចំបក់ មាស ព្រមទាំង ពិនិត្យ ហេដ្ឋារចនាសម្ព័ន្ធ នានា ដែល មាន នៅក្នុង សាលា ផងដែរ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ករណី នគរបាល ខេត្ត ព្រៃវែង ៧នាក់ មិន បញ្ចប់ ត្រឹម ផ្អាក ការងារ នោះ ទេ (Video inside)
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន អគ្គ ស្នងការ រង និង ជា អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា ករណី នគរបាល ខេត្ត ព្រៃវែង ៧នាក់ ដែល ដោះលែង អ្នកប្រើប្រាស់ គ្រឿងញៀន ជា ថ្នូរ នឹង លុយ នោះ មិន ទាន់ បញ្ចប់ ត្រឹម ការផ្អាក ការងារ បណ្ដោះអាសន្ន ពួកគេ នោះ ទេ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ កំពុង បន្ត នីតិវិធី ដោយ បើក ការស្រាវជ្រាវ ថែម ទៀត ។
ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០២០ ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន ឲ្យដឹង ថា ការផ្អាក ការងារ បណ្តោះអាសន្ន របស់ ស្នងការ រង និង មន្ត្រី នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រៃវែង ទាំង ៧រូប នោះ គ្រាន់តែ ជា ជំហាន ទី ១ប៉ុណ្ណោះ ។ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បាន បញ្ជា ឲ្យ នាយកដ្ឋាន បុគ្គលិក ធ្វើការស្រាវជ្រាវ និង ស៉ើប អង្កេត បន្ត ទៀត ដើម្បី ឈាន ទៅដល់ ការដាក់ វិន័យ តាម ទម្ងន់ ទោស ឬ ក៏ ការអនុវត្ត ច្បាប់ ។
បើ តាម អ្នកនាំពាក្យ . បញ្ហា នេះ លោក អគ្គ ស្នងការ បាន ដាក់ចេញ វិធានការ ៣ភ្លាម ៗ ជាបន្ទាន់ ដែរ រួម មាន៖
១៖ លោក បាន បញ្ជា ឲ្យ ស្នងការ ខេត្ត ព្រៃវែង ចុះ ទៅ ជួប ជាមួយនឹង អាជ្ញាធរ ឃុំ ស្រុក ដើម្បី ជួប គ្រួសារ ដែល ត្រូវ រង ការគៀប សង្កត់ យក លុយ យក កាក់ នោះ ដើម្បី ធ្វើ ការសុំទោស ចំពោះ ការខុសឆ្គង ដែល មន្ត្រី ខ្លួន បាន ប្រព្រឹត្ត ។
២៖ ប្រមូល ប្រាក់ យក ទៅ សង ប្រជាពលរដ្ឋ វិញ ។
៣៖ បន្ត ចាត់ វិធានការស៉ើប អង្កេត បន្ថែម ទៀត លើ មន្ត្រី ទាំងនោះ ។
ជន ពិការ ក្រីក្រ ម្នាក់ រស់ នៅ ខេត្ត ប៉ៃលិន ទទួលបាន អំណោយ ជា ផ្ទះ ១ខ្នង ពី មូលនិធិ ជន ពិការ
យុវតី ងេន ស្រី ម៉ាញ់ អាយុ ១៤ ឆ្នាំ ពិការ ស្វិត ជើង ទាំង ពីរ តាំងពី កំណើត សព្វ ថ្ងៃ រស់ នៅ ជាមួយ ម្តាយ មេម៉ាយ និង បង ស្រី សតិ មិន គ្រប់គ្រាន់ រស់ នៅក្នុង ផ្ទះ ចាស់ ទ្រុឌទ្រោម ដែល មាន ទីលំនៅ ភូមិ ភ្នំ កុយ ឃុំ សាលា ក្រៅ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន ទើប បាន ទទួល ផ្ទះ ថ្មី នេះ ។
កម្មវិធី នេះ រៀបចំឡើង នៅ ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ពី លោក សៅ ឡែន ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ មូលនិធិ ជន ពិការ . លោក ចេង ញ៉ាន់ អភិបាល រង ខេត្ត ប៉ៃលិន . លោក ជួរ រតនៈ នាយក មូលនិធិ ជន ពិការ ថ្នាក់ដឹកនាំ មូលនិធិ ជន ពិការ ថ្នាក់ កណ្តាល លោក អ៊ិត ពេន ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត លោក សំ សាវ៉េត អភិបាល ស្រុក សាលា ក្រៅ ក្រុមប្រឹក្សា ឃុំ សាលា ក្រៅ និង ប្រជាពលរដ្ឋ ចូលរួម ប្រមាណ ចំនួន ២០ នាក់ ។
លោក សៅ ឡែន ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ មូលនិធិ ជន ពិការ បាន លើកឡើង ថា ជួស មុខ ឱ្យ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា លោក ពិតជា មាន សេចក្តី សោមនស្ស រីករាយ ដែល ក្រសួង តាមរយៈ មូលនិធិ ជន ពិការ បាន រៀបចំ កម្មវិធី សាងសង់ ផ្ទះ នេះ ឡើង ដែល គិត មកដល់ ពេលនេះ គឺ មាន ផ្ទះ ចំនួន ៨ហើយ ដែល បាន ប្រគល់ជូន ជន ពិការ ក្រីក្រ នៅ ខេត្ត បាត់ដំបង សៀមរាប តាកែវ កំពង់ឆ្នាំង ស្វាយរៀង ត្បូងឃ្មុំ ពោធិ៍សាត់ និង ប៉ៃលិន នា ថ្ងៃ នេះ ។
លោក ចេង ញ៉ាន់ អភិបាល រង ខេត្ត ប៉ៃលិន បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន គិតគូរ ខ្ពស់ ដល់ ជន ពិការ ដោយ មិន ឱ្យ ជន ពិការ នៅឯ កោ នោះ ឡើយ គឺ រាជ រដ្ឋាភិបាល ក៏ដូច ថ្នាក់ដឹកនាំ ខេត្ត បាន សម្របសម្រួល ឱ្យ ជន ពិការ ទទួលបាន ការគាំទ្រ នានា ។
លោក ក៏ បាន ថ្លែងអំណរគុណ ដល់ មូលនិធិ ជន ពិការ ដែល បាន រៀបចំ កម្មវិធី សប្បុរសធម៌ នេះ ឡើង សំដៅ ដល់ ការលើកកម្ពស់ ជីវភាព របស់ ជន ពិការ ក្រីក្រ ។
ក្នុង ពិធី នេះ ដែរ ក្រៅពី ផ្ទះ ថ្មី ១ខ្នង នេះ មូលនិធិ ជន ពិការ ក៏ បាន ផ្តល់ ជូន នូវ អំណោយ សប្បុរសធម៌ របស់ មូលនិធិ ជន ពិការ សម្រាប់ ផ្តល់ ជូន ដល់ គ្រួសារ ដែល ទទួលបាន ផ្ទះ ថ្មី ពី មូលនិធិ ជន ពិការ នូវ ថវិកា ១០ម៉ឺន រៀល អង្ករ ២៥ គីឡូ ក្រោម ត្រីខ២យួរ ទឹក ស៊ីវ អ៊ីវ១យួរ ទឹកត្រី ១យួរ អំបិល ២កញ្ចប់ មី១ កេស និង សម្លៀកបំពាក់ ១កញ្ចប់ ។
( ស្ទឹងត្រែង ) ៖ លោក ម៉ុម សារឿន អភិបាល ខេត្ត ស្ទឹងត្រែង នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ បាន អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ របស់ រដ្ឋបាល ខេត្ត ប្រចាំ ខែកក្កដា ឆ្នាំ ២០២០ និង លើក ទិសដៅ ការងារ បន្ត ក្នុង គោលបំណង ត្រួតពិនិត្យ វឌ្ឍនភាព ការងារ និង ពង្រឹង ប្រសិទ្ធភាព ក្នុង ការអនុវត្ត ការងារ របស់ រដ្ឋ បាល ខេត្ត និង មន្ទីរ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ថែម ទៀត ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពីសំណាក់ អភិបាល រង ខេត្ត ថ្នាក់ដឹកនាំ កម្លាំងប្រដាប់អាវុធ ទាំង បី ប្រភេទ អភិបាល អភិបាល រង ក្រុង ស្រុក ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត នាយក នាយក រង រដ្ឋបាល និង នាយក នាយក រង ទី ចាត់ការ អង្គភាព ចំណុះ សាលា ខេត្ត នៅ សាល ប្រជុំ តូច សាលា ខេត្ត ស្ទឹងត្រែង ។
នៅក្នុង ឱកាស នោះ លោក ម៉ុម សារឿន ក៏ បាន ដាក់ចេញ នូវ ទិសដៅ ភារកិច្ច សំខាន់ ៗ បន្ថែម ចំនួន ៧ចំណុច ដើម្បី បន្ត អនុវត្ត ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព រួម មាន៖
* ទី ១៖ ត្រូវ បន្ត ពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ សំដៅ ធានា នូវ ការអភិវឌ្ឍ ។
* ទី ២៖ ត្រូវ បន្ត យកចិត្តទុកដាក់ ក្នុង ការផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ ដើម្បី ផ្តល់ ជំនឿ ទុកចិត្ត និង ភាពជឿជាក់ ជូន ប្រជាពលរដ្ឋ ដែល មក ទទួល យក សេវា ។
* ទី ៣៖ ពង្រឹង ការអនុវត្ត ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត នានា សម្រាប់ មន្ត្រីរាជការ ។
* ទី៤៖ មន្ទីរ សុខាភិបាល ត្រូវ សហការ ជាមួយ រដ្ឋបាល ក្រុង ស្រុក ឃុំ សង្កាត់ បន្ត យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ជម្ងឺ កូវីដ - ១៩ ។
* ទី ៥៖ ជំរុញ ទប់ស្កាត់ និង បង្ក្រាប បទ លើ្ម ស គ្រប់ ប្រភេទ ជាពិសេស បទល្មើស ព្រៃឈើ និង ធនធាន ធម្មជាតិ ដើម្បី រក្សា បាន នូវ ស្ថេរភាព សង្គម ។
* ទី ៦៖ ជំរុញ ការផ្តល់ អត្តសញ្ញាណប័ណ្ណ សៀវភៅ គ្រួសារ សៀវភៅ ស្នាក់ នៅ និង សំបុត្រ កំណើត ជូន ដល់ ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេល វេលា ។
* ទី៧៖ មន្ទីរ ផែនការ ត្រូវ សហការ ជាមួយ ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ជំរុញ ការធ្វើ បណ្ណ ក្រីក្រ ជូន ប្រជាពលរដ្ឋ ( ក្រីក្រ១ និង ក្រីក្រ២) ជូន ដល់ គ្រួសារ ប្រជាពលរដ្ឋ ដែល ក្រីក្រ ពិតប្រាកដ ដើម្បី ឧបត្ថម្ភ សាច់ប្រាក់ ប្រកបដោយ តម្លាភាព និង សមធម៌ ។
លោក ម៉ុម សារឿន ក៏ បាន វាយតម្លៃ ខ្ពស់ ដល់ ថ្នាក់ដឹកនាំ ខេត្ត ក៏ ដូច ថ្នាក់ដឹកនាំ តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត រួមទាំង មន្ត្រី ថ្នាក់ មូលដ្ឋាន ពិតជា បាន ខិតខំ បំពេញ ការងារ របស់ ខ្លួន បាន ល្អ ប្រសើរ រហូត បាន ធ្វើឱ្យ ខេត្ត ស្ទឹងត្រែង មាន ភាពរីកចំរើន គួ ជា ទីមោទៈ ពិសេស លើ ហេដ្ឋារចនាសម្ព័ន្ធ និង ការម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ជាដើម ៕ ថ្នាក់ដឹកនាំ និង បុគ្គលិក ជី ប ម៉ុង ប្រមាណ ជាង ១០០ នាក់ ផ្តល់ ឈាម សង្គ្រោះ ជីវិត
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង បុគ្គលិក ជី ប ម៉ុង ប្រមាណ ជាង ១០០ នាក់ បាន ចូលរួម បរិច្ចាគ ឈាម ដោយ ស្ម័គ្រចិត្ត ដែល រៀបចំ នៅ ការិយាល័យ កណ្តាល របស់ ក្រុមហ៊ុន ជី ប ម៉ុង នៅ ថ្ងៃទី ៣១ កក្កដា ២០២០ នេះ ។
នេះ ជា លើក ទី៥ ហើយ ដែល ក្រុមហ៊ុន ជី ប ម៉ុង បាន រៀបចំ កម្មវិធី បរិច្ចាគ ឈាម ដោយ ស្ម័គ្រចិត្ត ដែល សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ មជ្ឈមណ្ឌល ជាតិ ផ្តល់ ឈាម ដើម្បី បំពេញ តម្រូវការ ឈាម ដែល ចាំបាច់ សម្រាប់ ការសង្គ្រោះ បន្ទាន់ ទាំង ក្នុង រាជធានី ភ្នំពេញ និង ទូទាំង ប្រទេស ។
ក្រុមហ៊ុន ជី ប ម៉ុង តែងតែ ចូលរួម យ៉ាង សកម្ម ក្នុង ការបរិច្ចាគ ត្រឡប់ ទៅ សង្គម វិញ លើ វិស័យ អប់រំ បរិស្ថាន សុខាភិបាល មនុស្សធម៌ និង វិស័យ ជាច្រើន ទៀត ៕
គណៈកម្មាធិការ ចម្រុះ កិច្ចការ ព្រំដែន បាន ចាត់ទុក ថា សេចក្ដីថ្លែងការណ៍ របស់ លោក រ៉ុង ឈុន ជា ការផ្សាយ ព័ត៌មាន មិន ពិត និង បំផ្លើស ។
គណៈកម្មាធិការ ចម្រុះ កិច្ចការ ព្រំដែន បាន សេចក្តីថ្លែងការណ៍ នេះ បាន ប្រឌិត រឿង និង ផ្សព្វផ្សាយ នូវ ព័ត៌មាន ក្លែងក្លាយ ដោយ ចេតនា ទុច្ចរិត ក្នុង គោលបំណង បំភ័ន្តសាធារណៈ មតិ ជាតិ និង អន្តរជាតិ ដោយ ធ្វើ ការចោទប្រកាន់ ដោយ គ្មាន មូលដ្ឋាន មក លើ ការងារ ព្រំដែន របស់ រាជ រដ្ឋាភិបាល អំពី ការធ្វើឱ្យ បាត់បង់ ទឹកដី ក៏ ដូចជា ការបណ្ដោយ ឱ្យ មាន ការរំលោភបំពាន ទឹកដី ពី ប្រទេស ជិតខាង ធ្វើឱ្យ ប្រជា ពលរដ្ឋ បាត់បង់ ដី ស្រែ ចម្ការ នៅ ភូមិ ត្រពាំង ផ្លុង ឃុំ ត្រពាំង ផ្លុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ។
១៖ ការខណ្ឌ សីមា និង បោះ បង្គោល ព្រំដែន គោក រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សាធារណរដ្ឋ សង្គម និយម វៀតណាម ពុំ បាន ធ្វើឱ្យ កម្ពុជា បាត់បង់ ទឹកដី នោះ ទេ និង ពុំ មាន អាជ្ញាធរ វៀតណាម ចូលមក រុញ ច្រាន ពលរដ្ឋ ខ្មែរ មិន ឱ្យ ដាំដុះ ក្នុង ដី ខ្មែរ ប្រមាណ ២០០ ម៉ែត្រ នោះ ទេ ។ ពាក់ព័ន្ធ នឹង ករណី នេះ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ក៏ បាន បញ្ជាក់ យ៉ាង ច្បាស់ ផងដែរ ក្នុង សេចក្ដីប្រកាស ព័ត៌មាន ចុះ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ គណៈកម្មាធិការ ចម្រុះ កិច្ចការ ព្រំដែន៖ វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប ចុះ MoU ជាមួយ អ្នក វិនិយោគទុន ក្នុង ស្រុក ដើម្បី អភិវឌ្ឍន៍ ហេរដ្ឋារចនាសម្ព័ន្ធ វិទ្យាស្ថាន
ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២០ ដើម្បី គាំទ្រ វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប លើ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ តាមរយៈ ការកសាង ភាពជាដៃគូ និង ផែនការ យុទ្ធសាស្រ្ត អភិវឌ្ឍន៍ ប្រទេសជាតិ ជាពិសេស ធនធាន មនុស្ស ផ្នែក កសិកម្ម និង ទីផ្សារ ។
ជាមួយគ្នា នេះ ដែរ ភាគី ទាំង ពីរ បេ្តជ្ញា នឹង ខិតខំ បន្ត កិច្ចសហប្រតិបត្តិការ ដើម្បី បន្ត នូវ គោលដៅ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គមជាតិ ប្រកបដោយ ចីរភាព ផងដែរ ៕
រដ្ឋបាល ខេត្ត ស្វាយរៀង ពង្រឹង វិធានការ ទប់ស្កាត់ ពលករ ឆ្លង ដែន ទៅ វៀតណាម ដោយ ខុស ច្បាប់
( ស្វាយរៀង ) ៖ លោកស្រី ឯក សុវណ្ណ ភារៈ អភិបាល រង ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០២០ បាន អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ ពិភាក្សា ពង្រឹង វិធានការ ទប់ស្កាត់ និង គ្រប់គ្រង ពលករ ឆ្លង ដែន ទៅ ប្រទេស វៀតណាម ដោយ ខុស ច្បាប់ នៅ ទីស្នាក់ការច្រកទ្វារ ព្រំដែន ទ្វេ ភាគី សំរោង ស្រក ចន្ទ្រា ខេត្ត ស្វាយរៀង ។
លោក រស់ សា ដែន ប្រធាន ទីស្នាក់ការច្រកទ្វា ទ្វេ ភាគី សំរោង បាន ឱ្យដឹង ថា កម្មវិធី នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ពង្រឹង វិធានការ បន្ថែម លេខ ១៣៩៦ របស់ ក្រសួង មហាផ្ទៃ ស្តីពី ការទប់ស្កាត់ វិធានការ ទប់ស្កាត់ ប្រជាពលរដ្ឋ ឆ្លង ដែន ដោយ ខុស ច្បាប់ ទៅ ប្រទេស វៀតណាម ដើម្បី ពង្រឹង វិធានការ ទប់ស្កាត់ និង គ្រប់គ្រង ពលករ ឆ្លង ដែន ដោយ ខុស ច្បាប់ ទៅ ប្រទេស វៀតណាម និង ប្រទេស ផ្សេង ៗ ទៀត ។
លោក បាន បន្ត ថា ករណី នេះ យើង សង្កេតឃើញ ថា ប្រជាពលរករ នៅតែ បន្ត វិល ត្រលប់ មកវិញ ជា រាង រាល់ ថ្ងៃ ដូចនេះ យើង ត្រូវ យកចិត្តទុកដាក់ ផ្សព្វផ្សាយ ដល់ ពួកគាត់ បាន យល់ដឹង ពី វិធានការ សំខាន់ ៗ មាន ជា អាទិ៍៖
* ទី ២៖ អប់រំ ផ្លាស់ប្តូរ ផ្នត់គំនិត « បំណាច់ ធ្វើ ខ្ញុំ គេ សុខចិត្ត ធ្វើ ខ្ញុំ បរទេស » ឱ្យ ទទួលស្គាល់ តម្លៃ របស់ ខ្លួន ក្នុង នាម ជា ពលរដ្ឋ ខ្មែរ លើកទឹកចិត្ត និង ផ្តល់ ការគាំទ្រ ដល់ ការខិតខំ ផលិត ការប្រើប្រាស់ ផលិតផល ក្នុង ស្រុក និង ប្រើប្រាស់ សក្តានុពល ដែល មាន ដើម្បី បង្កើត មុខរបរ ក្នុង ស្រុក ជាជាង ការផ្សងព្រេង ដោយ គ្មាន គោលដៅ ច្បាស់លាស់ នៅ ក្រៅ ប្រទេស ដែល ប្រកបដោយ គ្រោះថ្នាក់ ខាត ពេលវេលា និង មិន មាន ផលប្រយោជន៍ ។
* ទី ៣៖ ត្រូវ ស្រាវជ្រាវ កំណត់ មុខ សញ្ញា បង្ក្រាប និង ការចាប់ខ្លួន មេ ខ្យល់ ដែល មាន ចលនា អូសទាញ ប្រជាពលរដ្ឋ ឆ្លង ដែន ដោយ ខុស ច្បាប់ ទៅ ប្រទេស ជិតខាង តាម ច្រក របៀង ។
* ទី៤៖ គួរ មាន វិធានការ ម៉ឺងម៉ាត់ ក្នុង ការគ្រប់គ្រង ពលករ ឆ្លង ដែន ព្រឹក ល្ងាច តាម រដូវកាល ទៅ ប្រទេស វៀតណាម ។
* ទី ៥៖ ត្រូវ បន្ត ការ យកចិត្តទុកដាក់ អនុវត្ត នូវ វិធានការ និង គោលការណ៍ ណែនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្រសួង សុខាភិបាល ក្នុង ការបង្ការ ទប់ស្កាត់ ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ ៕
ពលរដ្ឋ ក្រីក្រ ៩៩ គ្រួសារ ដែល ជួប ការលំបាក ដោយសារ កូវី ដ១៩ នៅ ចំការមន ទទួលបាន អំណោយ របស់ រាជ រដ្ឋាភិបាល
( ភ្នំពេញ ) ៖ លោក អាំង សិរី ពិសិដ្ឋ អភិបាល រង ខណ្ឌ ចំការមន នៅ ព្រឹក ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល និង នាំ អំណោយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ចែកជូន ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៩៩ គ្រួសារ ក្នុង មូលដ្ឋាន សង្កាត់ ទន្លេបាសាក់ ដែល ជួប ការលំបាក ក្នុង អំឡុង វិបត្តិ ជំងឺ កូវីដ១៩ ។
លោក អាំង សិរី ពិសិដ្ឋ បាន លើកឡើង ថា សម្តេច តេជោ ហ៊ុន សែន តែងតែ យកចិត្តទុកដាក់ គិត គូរ ចំពោះ ប្រជាពលរដ្ឋ ទាំង ការលះបង់ នាំយក នូវ សន្តិភាព មក ជូន ប្រជាពលរដ្ឋ បាន រស់ នៅក្នុង ភាពសុខសាន្ត និង តែងតែ គិតគូរ សុខទុក្ខ ការខ្វះខាត ចំពោះ ប្រជាពលរដ្ឋ ទូទៅ ជាពិសេស ប្រជាពលរដ្ឋ ដែល មាន ការខ្វះខាត ក្នុង សម័យកាល កូវីដ១៩ ដែល កំពុង ឆ្លង រាតត្បាត ទូទាំង សកលលោក ។
លោក ថា សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី តែង មាន ទឹកចិត្ត គុណធម៌ មនុស្សធម៌ ប្រកប ដោយ ការទទួលខុសត្រូវ ក្នុង នាម ជា អ្នកដឹកនាំ មិន ថា ចំពោះ ប្រជាពលរដ្ឋ កម្ពុជា និង ប្រជាពលរដ្ឋ បរទេស ជាក់ស្តែង កន្លងទៅ ដែល សម្តេច បាន អនុញ្ញាតឲ្យ ក ប៉ាល ទេសចរណ៍ អន្តរជាតិ មួយ បាន ចូល ចត នៅក្នុង ប្រទេស កម្ពុជា គ្រា ដែល មិន មាន ប្រទេស ណា ទទួល ឲ្យ ចូល ចត ព្រោះ ព្រួយបារម្ភ ពី ការឆ្លង នៃ ជំងឺ កូវីដ១៩ នេះ ជាដើម ។
ក្នុង វិធានការ នោះ ដែរ រាជ រដ្ឋាភិបាល បាន សម្រេច បន្ត ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ដល់ កម្មករ - និយោជិត ដែល បម្រើ ការងារ នៅ តាម រោងចក្រ . សហគ្រាស និង អាជីវកម្ម នៃ សេដ្ឋកិច្ច ក្នុង ប្រព័ន្ធ ក្នុង វិស័យ កាត់ដេរ និង ទេសចរណ៍ សម្រាប់ រយៈពេល ២ខែ ទៅ មុខ ទៀត រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ។
ជាមួយគ្នា នេះ ចំពោះ ការផ្តល់ ប្រាក់ ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ដោយសារ ជំងឺ កូវីដ១៩ ក៏ នៅតែ បន្ត រយៈពេល ២ខែ ទៀត ផងដែរ ។
បន្ទាប់ពី រោងចក្រ - សហគ្រាស និង អាជីវកម្ម ក្នុង វិស័យ ទាំង ពីរ ខាងលើ ត្រូវ ទទួលបាន លិខិត អនុញ្ញាតឱ្យ ព្យួរ កិច្ចសន្យា ការងារ និង / ឬ លិខិត អនុញ្ញាតឱ្យ ពន្យារ ការព្យួរ កិច្ចសន្យា ការងារ ពី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្រោយពី បាន បំពេញ តាម លក្ខណៈ វិនិច្ឆ័យ (Criteria) និង លក្ខខណ្ឌ នៃ ការព្យួរ កិច្ចសន្យា ការងារ ព្រមទាំង ប្រតិបត្តិ តាម លក្ខខណ្ឌ ដែល បាន អនុវត្ត ក្នុង ជុំ កន្លងមក រាជ រដ្ឋាភិបាល កម្ពុជា នឹង៖
* ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ ៤០ ដុល្លារ អាមេរិក ក្នុង មួយ ខែ ជូន កម្មករ - និយោជិត ០១ នាក់ ដែល ធ្វើ ការងារ ក្នុង វិស័យ ទេសចរណ៍ ដូច ជា៖ សណ្ឋាគារ . ផ្ទះសំណាក់ . ភោជនីយដ្ឋាន និង ភ្នាក់ងារ ទេសចរណ៍ សម្រាប់ រយៈពេល ០២ ខែ បន្ត ទៀត រហូតដល់ ដំណាច់ ខែ កញ្ញា ឆ្នាំ ២០២០ ។ សហគ្រាស និង អាជីវកម្ម ក្នុង វិស័យ ទេសចរណ៍ ត្រូវ រួមចំណែក តាម គោលការណ៍ ស្ម័គ្រចិត្ត និង តាម លទ្ធភាព ជាក់ស្តែង បន្ថែម លើ អ្វី ដែល រាជ រដ្ឋាភិបាល បាន ផ្តល់ ជូន ។
សេចក្តីប្រកាស ព័ត៌មាន បាន បញ្ជាក់ ទៀត ថា រាជ រដ្ឋាភិបាល នៅ បន្ត អនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង អំឡុង ពេល ជំងឺ កូវីដ - ១៩ សម្រាប់ រយៈពេល ០២ ខែ ទៀត គឺ ខែ សីហា និង ខែ កញ្ញា ឆ្នាំ ២០២០ ។
ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល បាន ណែនាំឲ្យ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ អនុវត្ត នូវ សេចក្ដីណែនាំ នេះ ទៅ តាម សមត្ថកិច្ច របស់ ខ្លួន ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ បំផុត ។
សូម អាន សេចក្តីប្រកាស ព័ត៌មាន របស់ រាជ រដ្ឋាភិបាល ទាំង ស្រុង៖ ចាប់ខ្លួន មនុស្ស ១០នាក់ ពាក់ព័ន្ធ ករណី ប្រើប្រាស់ និង ចែកចាយ គ្រឿងញៀន នៅ ស្រុក ជើង ព្រៃ និង ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ យ៉ាងហោចណាស់ មនុស្ស ១០នាក់ ត្រូវបាន កម្លាំង នគរបាល ខេត្ត កំពង់ចាម ចាប់ខ្លួន ជា បន្ដ បន្ទាប់ ពាក់ព័ន្ធ ករណី ប្រើប្រាស់ និង ចែកចាយ គ្រឿងញៀន នៅ ស្រុក ជើង ព្រៃ និង ស្រុក ព្រៃឈរ នៅ យប់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ ។
ស្នងការ នគរបាល ខេត្ត កំពង់ចាម លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ឲ្យដឹង ថា បន្ទាប់ពី ទទួលបាន ព័ត៌មាន ពី ប្រជាពលរដ្ឋ ភ្លាម បាន ចាត់ បញ្ជា កម្លាំង ជំនាញ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន ខេត្ត ជាមួយ ជំនាញ ស្រុក ព្រៃឈរ និង ជំនាញ ស្រុក ជើង ព្រៃ បើក កិច្ច ប្រតិបត្តិការ ចុះបង្ក្រាប ករណី ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន បាន ០១ ករណី ដោយ ប្រើ វិធាន ញុះ ញុង ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ១០នាក់ ។
អភិបាល ខេត្ត ប៉ៃលិន អំពាវនាវ ដល់ ម្ចាស់ ស្ថានីយ ប្រេង និង ឧស្ម័ន ឥន្ធនៈ ដែល មិន ទាន់ មាន ច្បាប់ អនុញ្ញាត ពី សុវត្ថិភាព បច្ចេកទេស សូម ប្រញាប់ មក ដាក់ ពាក្យ ស្នើសុំ
មន្ត្រី សុខាភិបាល បាន ឲ្យដឹង ថា គិត ចាប់តាំងពី ការផ្ទុះ ឡើងវិញ កាលពី ថ្ងៃសៅរ៍ សប្តាហ៍ មុន ករណី ឆ្លង ថ្មី បាន កើនឡើង ដល់ ៩៣ ករណី ហើយ បច្ចុប្បន្ន នេះ ប្រទេស វៀតណាម មាន ករណី ឆ្លង COVID-19 សរុប ចំនួន ៥០៩ ករណី ។ ទោះជា បែប នេះ ក្តី មិន ទាន់ មាន មនុស្ស ណា ម្នាក់ ស្លាប់ ដោយសារ វីរុស កូរ៉ូណា ថ្មី នេះ ទេ នៅក្នុង ប្រទេស អាស៊ាន មួយ នេះ ។
លោកស្រី ជូ ហ្វឹង លៀន (Zhu Fenglian) អ្នកនាំពាក្យ ការិយាល័យ ទទួលបន្ទុក កិច្ចការ កោះ តៃវ៉ាន់ ចំណុះ ឲ្យ ក្រុមប្រឹក្សា រដ្ឋ ចិន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « និន្នាការ ប្រវត្តិសាស្រ្ត នៃ ការបង្រួបបង្រួម និង ការកសាង ជាតិ ឡើងវិញ របស់ ចិន មិន អាច ត្រូវបាន បញ្ឈប់ ដោយ នរណា ម្នាក់ ឬ ក៏ កម្លាំង ណាមួយ ឡើយ » ។ ចិន ធ្លាប់ បាន ព្រមាន ជាច្រើន លើក រួច មកហើយ ថា ការប្រកាស ឯករាជ្យ នៃ កោះ តៃវ៉ាន់ ក៏ មិន ខុស អ្វី ទៅនឹង ការប្រកាស សង្គ្រាម នោះ ដែរ ។
បើ គិត អំពី តួលេខ មនុស្ស ស្លាប់ ខាងលើ នេះ គឺ ស្ថិត នៅក្នុង អត្រា ទាប សម្រាប់ ប្រទេស អ៉ី ស្រាអែល បើ ធៀប នឹង ប្រទេស ជាច្រើន ទៀត ដែល មាន ករណី ឆ្លង ជំងឺ COVID-19 ប្រហាក់ប្រហែល នឹង អ៉ី ស្រាអែល នោះ ខណៈ អត្រា ជាសះស្បើយ ឡើងវិញ គឺ មាន កម្រិត ខ្ពស់ ដោយ កាលពី ថ្ងៃព្រហស្បតិ៍ ម្សិលមិញ នេះ មាន អ្នកជំងឺ រហូតដល់ទៅ ជាង ១០.០០០ នាក់ ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ។
គួរ បញ្ជាក់ ថា អ៉ី ស្រាអែល ជា ប្រទេស ដែល មាន ផ្ទៃដី តូច នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា និង មាន ប្រជាជន រស់ នៅ ជាង ៨.៦លាន នាក់ ។ ការរងគ្រោះ ដោយ COVID-19 ដែល បាន បណ្តាលឲ្យ មាន មនុស្ស ស្លាប់ រាប់ រយ នាក់ នោះ គឺជា បញ្ហា ធ្ងន់ធ្ងរ មួយ ស្រាប់ ទៅ ហើយ ប៉ុន្តែ អ្វី ដែល កាន់តែ អាក្រក់ បន្ថែម ទៀត នោះ គឺ ផល អវិជ្ជមាន ដ៏ ធ្ងន់ធ្ងរ ដល់ សេដ្ឋកិច្ច ព្រោះ ចំនួន ពលរដ្ឋ បាត់បង់ ការងារ ធ្វើ គិត ត្រឹម ខែកក្កដា នេះ បាន ឈានដល់ ជាង ១លាន នាក់ និង កំពុង ក្លាយជា បន្ទុក ដ៏ំ ធំ ធេង របស់ រដ្ឋាភិបាល ៕
ព្រះចៅ សាល ម៉ាន់ បាន យាង ចូល មន្ទីរពេទ្យ ទីក្រុង រីយ៉ាដ និង ទទួល ការវះកាត់ កាលពី ថ្ងៃទី ២៣ ខែកក្កដា ហើយ បន្ទាប់មក ទៀត ទ្រង់ ក៏ ស្ថិត នៅ មន្ទីរពេទ្យ ដើម្បីឲ្យ ព្រះរោគ បាន ធូរស្រាល ឡើងវិញ ដោយ ពី មាន ការ តាមដាន យ៉ាង ដិតដល់ បំផុត ពី សំណាក់ ក្រុម គ្រូពេទ្យ ជំនាញ ក្នុង មន្ទីរពេទ្យ King Faisal ។
គួរ បញ្ជាក់ ថា ព្រះចៅ សាល ម៉ាន់ មាន ព្រះជន្មាយុ ៨៤ វស្សា បាន ទទួល រង ជំងឺ រលាក ថង់ ទឹក ប្រម៉ាត់ និង ត្រូវបាន ក្រុម មន្ត្រី ព្រះរាជ វាំង យាង ទ្រង់ ទៅ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ កាលពី ថ្ងៃទី ២០ ខែកក្កដា ហើយ ក្រោយពី ទទួល ការពិនិត្យ យ៉ាង ដិតដល់ រួច មក ទើប ទ្រង់ បាន ទទួល ការវះកាត់ នៅ រយៈពេល បី ថ្ងៃ បន្ទាប់ ៕
គយ កម្ពុជា និង ដៃគូ អភិវឌ្ឍន៍ ផ្សព្វផ្សាយ ពី លទ្ធផល នៃ ការសិក្សា រយៈពេល បំពេញ បែបបទ បញ្ចេញ ទំនិញ
នៅក្នុង អង្គ សិក្ខាសាលា អ្នកជំនាញ ការធនាគារ អភិវឌ្ឍន៍ អាស៊ី និង អ្នកជំនាញ ការ របស់ អង្គការ គយ ពិភពលោក បាន ធ្វើ បទបង្ហាញ ផ្សព្វផ្សាយ ពី និន្នាការ ថ្មី ៗ នៃ ការសិក្សា រយៈពេល បំពេញ បែបបទ បញ្ចេញ ទំនិញ . សកម្មភាព ការងារ របស់ អង្គការ គយ ពិភពលោក នៅក្នុង តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក និង ជំនួយ គាំទ្រ របស់ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ក្នុង កិច្ច សម្រួល ពាណិជ្ជកម្ម នៅក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ សម្រាប់ ឆ្នាំ បន្តបន្ទាប់ ។
ទោះជា បែប នេះ ក៏ដោយ លទ្ធផល នៃ ការសិក្សា ក្នុង ឆ្នាំ ២០១៩ ក៏ បាន រកឃើញ ចំណុច កកស្ទះ (Bottleneck) ធ្វើឱ្យ ការបំពេញ បែបបទ នៅ តាម ដំណាក់កាល ខ្លះ ត្រូវ ចំណាយ ពេលវេលា យូរ ដោយ មូលហេតុ កំណើន ខ្ពស់ នៃ ចរាចរ ទំនិញ នាំចេញ - នាំចូល . នីតិវិធី ការងារ មួយចំនួន នៅ មាន ច្រើន ដំណាក់កាល . ការប្រើប្រាស់ ប្រព័ន្ធ បច្ចេកវិទ្យា ពុំ ទាន់ ពេញលេញ និង ភាពអសកម្ម ខ្លះ របស់ តួអង្គ ពាក់ព័ន្ធ ដែល ជា មូលដ្ឋាន សម្រាប់ ពិនិត្យ និង កែសម្រួល ដោះស្រាយ ការប្រឈម តាម សមត្ថកិច្ច រៀង ៗ ខ្លួន ។
អាជ្ញាធរ ខេត្ត ព្រះសីហនុ ចុះ ផ្សព្វផ្សាយ ពី ការទប់ស្កាត់ និង បង្ក្រាប ការ ឈូសឆាយ កាប់ រាន ដុត ព្រៃឈើ តំបន់ ការពារ ធម្មជាតិ
( ព្រះសីហនុ) ៖ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ដឹកនាំ ដោយ លោក ម៉ាង ស៉ីណេត អភិបាល រង ខេត្ត ព្រះសីហនុ បាន ចុះ ធ្វើ ការផ្សព្វផ្សាយ ពី ការចាត់ វិធានការ ទប់ស្កាត់ និង បង្ក្រាប ការ ឈូសឆាយ កាប់ រាន ដើមឈើ ដុត ព្រៃឈើ ទន្ទ្រាន ហ៊ុមព័ទ្ធ កាន់កាប់ លក់ - ទិញ និង ការបញ្ជាក់ លើ ការលក់ - ទិញ ដី ព្រៃឈើ ដី ព្រៃ លិច ទឹក ដី ព្រៃ កោងកាង និង ដី ក្នុង តំបន់ ការពារ ធម្មជាតិ ឬ តំបន់ គំរប ព្រៃឈើ ដែល ស្ថិត តំបន់ អូរ ថ្ម ព្រំប្រទល់ ស្រុក ព្រៃនប់ និង ស្រុក ស្ទឹង ហាវ ។
ការចុះ ផ្សព្វផ្សាយ នេះ ធ្វើឡើង នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ពី លោក អភិបាល ស្រុក ស្ទឹង ហាវ និង តំណាង រដ្ឋបាល ព្រៃឈើ ។
ដោយ អនុវត្ត តាម អនុសាសន៍ ណែនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាន ចេញ សេចក្តីណែនាំឲ្យ អភិបាល ក្រុង - ស្រុក ទាំង៥ នៃ ខេត្ត ព្រះសីហនុ ធ្វើ ការទប់ស្កាត់ ជាបន្ទាន់ នូវ រាល់ សកម្មភាព កាប់ ទន្ទ្រាន ព្រៃ ដុត ព្រៃ ហ៊ុមព័ទ្ធ ដី ព្រៃ ឬ ទិញ លក់ ដោយ ខុស ច្បាប់ ។
១៖ ទប់ស្កាត់ និង បង្ក្រាប ជាបន្ទាន់ នូវ រាល់ សកម្មភាព ឈូសឆាយ កាប់ រាន គ្រៀវ ដើមឈើ ដុត ក្នុង តំបន់ ការពារ ធម្មជាតិ ព្រៃឈើ ទន្ទ្រាន ហ៊ុព័ទ្ធ កាន់កាប់ ដី ព្រៃឈើ ដី ព្រៃ លិច ទឹក ដី ព្រៃ កោងកាង ទិញ និង ការបញ្ជាក់ លើ ឯកសារ លក់ - ទិញ ដី របស់ រដ្ឋ
២៖ ណែនាំ ដល់ មន្ត្រី មូលដ្ឋាន ជាពិសេស ភូមិ និង ឃុំ សង្កាត់ ឱ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ រាល់ ការលក់ - ទិញ និង ការបញ្ជាក់ លក់ - ទិញ ដី រដ្ឋ ៣៖ ក្នុង ករណី រកឃើញ មាន បុគ្គល ដែល ពាក់ព័ទ្ធ នឹង សកម្មភាព ខុស ច្បាប់ ដូច រៀបរាប់ ខាងលើ មន្រ្តី ជំនាញ នឹង កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ដោះស្រាយ តាម និតិវិធី ច្បាប់ ។
គួរ បញ្ជាក់ ផងដែរ ថា យោង តាម ច្បាប់ ស្ដីពី ព្រៃ ឈើ មាត្រា ៩៧ ត្រូវ ផ្តន្ទាទោស ជាប់ ពន្ធនាគារ ពី ប្រាំ ( ៥) ឆ្នាំ ទៅ ដប់ ( ១០) ឆ្នាំ និង រឹបអូស វត្ថុតាង ទាំងអស់ ជា សម្បត្តិ រដ្ឋ ចំពោះ ជន ណា ដែល បាន កាប់ រាន ព្រៃ ឈូសឆាយ ដី ព្រៃ ហ៊ុមព័ទ្ធ កាន់កាប់ ដី ព្រៃ គ្រៀវ បំពុល កាប់បំផ្លាញ ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេ ស៖ ពលរដ្ឋ ខ្មែរ ចំនួន ៧៩ នាក់ នឹង ត្រឡប់ ពី ប្រទេស ហ៊្សក ដានី ឥណ្ឌា និង ប៉ាគីស្ថាន មកដល់ កម្ពុជា វិញ នៅ ព្រឹក នេះ
អ្នកនាំពាក្យ រូប នេះ បន្ត ទៀត ថា នៅ ព្រឹក ថ្ងៃ នេះ ផងដែរ ពលរដ្ឋ កម្ពុជា ចំនួន ៥០ នាក់ ( ជា អ្នកដំណើរ ទូទៅ អ្នក មកពី ពិនិត្យ ជំងឺ និង និស្សិត ) មកពី ប្រទេស ឥណ្ឌា និង ប្រទេស ប៉ាគីស្ថាន ក៏ នឹង ធ្វើដំណើរ ត្រឡប់មក កម្ពុជា ឆ្លងកាត់ ប្រទេស ម៉ាឡេស៊ី តាម ជើង យន្តហោះ ពាណិជ្ជកម្ម របស់ ក្រុមហ៊ុន អាកាសចរណ៍ ម៉ាឡេស៊ី លេខ MH754 ដែល នឹង ចេញដំណើរ ពី ទីក្រុង គូឡាឡាំពួ នៅ វេលា ម៉ោង ៩៖០០ នាទី ព្រឹក ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០២០ ហើយ នឹង ទៅដល់ ទីក្រុង ភ្នំពេញ នៅ វេលា ម៉ោង ១០៖០០ នាទី ព្រឹក នេះ ៕
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ត្រឡប់មក ផ្ទះ វិញ ដោយ សុវត្ថិភាព ! ស្លាប់ ២នាក់ និង របួស ១១នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី៣០ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ . របួស ស្រាល ៣នាក់ និង របួស ធ្ងន់ ៨នាក់ ។
( បរទេស ) ៖ ខាងក្រោម គឺជា រូបភាព មួយចំនួន នៃ ស្ថានការណ៍ អន្តរជាតិ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃព្រហស្បតិ៍ ទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៖ មេ ៗ ក្រុមហ៊ុន បច្ចេកវិទ្យា យក្ស អាមេរិក ចូល ខ្លួន ផ្តល់ សក្ខីកម្ម ចំពោះមុខ សភា អាមេរិក ។
៥៖ និស្សិត ហុងកុង ៤នាក់ ត្រូវ ចាប់ខ្លួន ក្រោម ច្បាប់ សន្តិសុខ ថ្មី របស់ ចិន ។
៧៖ អ៉ីរ៉ង់ ធ្វើតេស្ត បាញ់ មីស៊ីល ដ៏ កក្រើក ដើម្បី ត្រៀមខ្លួន ទប់ទល់ ការឈ្លាន ពាន ពី សហរដ្ឋ អាមេរិក ។ NASA បាញ់ បញ្ជូន យាន ឆ្ពោះ ទៅកាន់ ភព អង្គារ បន្ទាប់ពី អេមីរ៉ាត់ អារ៉ាប់ រួម និង ចិន ទើបតែ បាន ធ្វើ ដូចគ្នា
សំណើ របស់ លោក រដ្ឋមន្ត្រី បាន ធ្វើឡើង បន្ទាប់ពី គេហទំព័រ នេះ បាន ចុះផ្សាយ តួលេខ អ្នក ឆ្លង ថ្មី នៅក្នុង ប្រទេស កម្ពុជា សម្រាប់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ មាន រហូតដល់ទៅ ៨នាក់ ខណៈ ដែល កម្ពុជា មាន តែ ១នាក់ ប៉ុណ្ណោះ ។
លោក រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង ក៏ បាន សំណូមពរ ដល់ គេហទំព័រ នេះ ឱ្យ ស្រង់ យក តួលេខ បច្ចុប្បន្នភាព នៃ ជំងឺ កូវីដ១៩ ក្នុង ប្រទេស កម្ពុជា តាម តួលេខ ដែល ក្រសួង សុខាភិបាល បាន ចេញផ្សាយ ស្ទើរ រៀងរាល់ ថ្ងៃ ។
ដោយឡែក អ្នក សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ រដ្ឋ មាន ចំនួន សរុប ៧០ នាក់ និង អ្នក សម្រាក ព្យាបាល នៅ បន្ទប់ ដោយឡែក ក្នុង ស្ថានទូត អាមេរិក ប្រចាំ កម្ពុជា ២នាក់ ៕ សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា សហការ ជាមួយ រដ្ឋបាល ស្រុក សំរោងទង ចុះ អប់រំ ផ្សព្វផ្សាយ និង បាញ់ ថ្នាំ បំភាយ សម្លាប់ មេរោគ COVID-19 នៅ ៤ទីតាំង ធំ ៗ
លោក សោម អូន បាន បង្ហាញ នូវ ក្តីកង្វល់ អំពី ការធ្វេសប្រហែស របស់ បងប្អូន ប្រជាពលរដ្ឋ មួយចំនួន ដែល ហាក់ដូច មាន សន្តិភាព និយម ជ្រុល ជាមួយ ជំងឺ COVID-19 និង ភ្លេច អនុវត្ត នូវ វិធានការណ៍ ការពារ ដូចជា ការលាង ដៃ ស្អាត ជាប្រចាំ ការពាក់ ម៉ាស់ នៅ ទីប្រជុំជន និង ការប្រើ គម្លាត សុវត្ថិភាព ដើម ។
លោក សោម អូន បាន បន្ថែម ថា នៅលើ ពិភពលោក និង នៅ កម្ពុជា ជំងឺ COVID-19 នៅតែ ជា បញ្ហា គំរាមគំហែង និង មាន ហានិភ័យ ខ្ពស់ ហើយ វា ងាយ នឹង ឆ្លង ជា សហគមន៏ បើសិនជា យើង ម្នាក់ ៗ មិន បាន យកចិត្តទុកដាក់ អំពី វិធានការ ការពារ ។ ដូចនេះ យើង ត្រូវ ចូលរួម ប្រយុទ្ឋ ប្រឆាំង ជម្ងឺ នេះ ទាំងអស់ គ្នា និង ត្រូវ ចូលរួម អនុវត្ត វិធានការ ការពារ របស់ រាជ រដ្ឋាភិបាល ឲ្យបាន ខ្ជាប់ខ្ជួន បំផុត ៕
ក្រសួង ទេសចរណ៍ ចាប់ផ្តើម បើក ដំណើរការ កញ្ចប់ ទស្សនកិច្ច កម្សាន្ត ក្នុង តម្លៃ ពិសេស ទៅកាន់ ខេត្ត សៀមរាប និង តំបន់ ទេសចរណ៍ ផ្សេង ៗ
លោក ឈុន មករា បាន បន្ថែម ថា នៅក្នុង ដំណើរការ កញ្ចប់ ទស្សនកិច្ច កម្សាន្ត ក្នុង តម្លៃ ពិសេស នេះ គឺជា ដំណើរកញ្ចប់ ទស្សនកិច្ច លំដាប់ ផ្កាយ៥ ដោយ អ្នកទេសចរ ទាំងអស់ អាច សម្រាក នៅក្នុង សណ្ឋាគារ លំដាប់ ផ្កាយ៥ នៅក្នុង តម្លៃ យ៉ាង ពិសេស បំផុត ដែល មិន ធ្លាប់ មាន ពីមុន មក ដែល គោលដៅ នៃ ដំណើរកម្សាន្ត នេះ គឺ ផ្តោត សំខាន់ ទៅ លើ ខេត្ត សៀមរាប ដែល ជា តំបន់ ទេសចរណ៍ វប្បធម៌ ប្រវត្តិសាស្ត្រ ដ៏ អស្ចារ្យ សម្រាប់ ប្រទេស កម្ពុជា ។
លោក ឈុន មករា បាន បន្ថែម ទៀត ថា កញ្ចប់ ទស្សនកិច្ច កម្សាន្ត ពិសេស នេះ ជា ទស្សនកិច្ច ដែល បាន រៀបចំ ទុក ជាមុន និង ជា ទី ទំនុកចិត្ត សម្រាប់ អ្នកទេសចរ ក្នុង ការធ្វើដំណើរ ប្រកបដោយ សុវត្ថិភាព ដែល មាន ទាំង កញ្ចប់ ទស្សនកិច្ច រយៈពេល ២ ថ្ងៃ និង រយៈពេល ៣ ថ្ងៃ ហើយ កញ្ចប់ ទស្សនកិច្ច នេះ ក៏ ធ្វើ សម្រាប់ អ្នក ដែល មាន ចំណូល តិច និង ចំណូល មធ្យម ក៏ អាច ចូលរួម បាន ផងដែរ ។
( ភ្នំពេញ ) ៖ ព្រលឹម ថ្ងៃ ទើបនឹង រះ ជា សញ្ញា ដាស់ មនុស្សម្នា ឲ្យ ក្រោក ឡើង ត្រៀម ខ្លួន បំពេញ ការងារ សម្រាប់ ថ្ងៃ ថ្មី ដូច្នេះ កម្មករ ទាំង ស្រី ទាំង ប្រុស ៗ ដែល ធ្វើចម្កា ចេក មួយ កន្លែង នៅឯ ស្រុក ឈូក ខេត្ត កំពត ក៏ រួសរាន់ ត្រៀម រៀបចំ ខ្លួនប្រាណ ទៅ បំពេញ ការងារ ជា ប្រចាំ រៀង ខ្លួន ដូច សព្វ ដង ។
រីឯ លោកស្រី ស៊ុន ស្រី មុំ ជា ម្តាយ កូន ខ្ចី ៨ខែ រូប នេះ ខុសពី អ្នកជិតខាង ដែល ស្នាក់ នៅក្នុង រោង ជាមួយគ្នា ព្រោះ គាត់ ជា មេផ្ទះ ដូច្នេះ ដើម្បី ធ្វើការ បាន ពេញ ១ ថ្ងៃ លោកស្រី រួសរាន់ គាស់ វើក WURKZ ១កំប៉ុង មុន គេ បង្អស់ ដើម្បី ពិសា ប៉ូវ កម្លាំង ទាំង មិន នឹកស្មាន ថា នឹង ឈ្នះ រង្វាន់ ៥០ លាន រៀល ទាំង ព្រឹក ព្រលឹម ។
ស្រី មុំ បាន ឲ្យដឹង ថា៖ « ទឹកប្រាក់ នេះ ខ្ញុំ មិន យក ម្នាក់ឯង ទេ ខ្ញុំ ឲ្យ ម៉ែជា អ្នក ចាត់ចែង ព្រោះ ម៉ែ អ្នក ទៅ ទិញ អ៊ីចឹង ហើយ ម៉ែ ក៏ បែងចែក ទិញ មាស ឲ្យ ខ្ញុំ ២ជី កន្លះ ម៉ូតូ១ និង គ្រឿង ផ្លាក ទីន ខ្លះ ទុក គ្រាន់ ពាក់ ក្នុង កម្មវិធី នានា ហើយ សល់ ប៉ុន្មាន គាត់ ទិញ មាស និង ម៉ូតូ ឲ្យ បងប្អូន បង្កើត ខ្ញុំ ផងដែរ ព្រះសុទ្ធតែ អ្នក ខ្វះខាត ដូចគ្នា » ៕
( ពោធិ៍សាត់ ) ៖ អភិបាល ខេត្ត ពោធិ៍សាត់ លោក ម៉ៅ ធ និន នា ថ្ងៃទី ៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ចុះ ដោះស្រាយ និង សម្របសម្រួល បញ្ហា ប្រឈម ក៏ ដូចជា ទំនាស់ ផ្សេង ៗ គ្នា ចំនួន ២៥ ករណី ដល់ មូលដ្ឋាន ផ្ទាល់ ដើម្បី ជម្រះ នូវ សតិអារម្មណ៍ ឱ្យ បាន ជ្រះស្រឡះ ទាំងអស់ គ្នា និង ដើម្បី កាត់បន្ថយ កុំ ឱ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ទៅ ឆ្ងាយ ដល់ សាលា ខេត្ត ទៅ លើ រឿងក្តី ក្តាំ បន្តិចបន្តួច រហូត ទៅដល់ បាត់បង់ ពេលវេលា បាត់បង់ ឱកាស និង បាត់បង់ ថវិកា ក្នុង ក្រុមគ្រួសារ ។
កិច្ច ដំណោះស្រាយ ត្រូវបាន ធ្វើឡើង នៅលើ សាលា ឆាន់ វត្ត បាកាន ស្ថិត ក្នុង ភូមិ បាកាន ឃុំ ត្រពាំង ជង ស្រុក បាកាន ដោយ បាន ការនិមន្ត និង អញ្ជើញ ចូលរួម ពី ព្រះតេជគុណ ឡាយ ក ន ព្រះគ្រូ ចៅអធិការ វត្ត បាកាន . លោក លោកស្រី សមាជិក ក្រុមប្រឹក្សា ខេត្ត . អភិបាល រង ខេត្ត . ថ្នាក់ដឹកនាំ មន្ទីរ ពាក់ព័ន្ធ . អាជ្ញាធរ ស្រុក ឃុំ ភូមិ និង ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
លោក ប្រធាន ការិយាល័យ ប្រជាពលរដ្ឋ បាន បន្ត ថា សម្រាប់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ចាប់តាំងពី ម៉ោង ៨៖៣០ នាទី ព្រឹក រហូតដល់ ម៉ោង ០២៖៣០ នាទី រសៀល លោក ម៉ៅ ធ និន បាន ប្រើប្រាស់ និង បំពេញ តួនាទី ជា អ្នកបម្រើ ប្រជាពលរដ្ឋ ដោយ ខិតខំ សម្របសម្រួល និង ដោះស្រាយ នូវ រាល់ បញ្ហា ប្រឈម ដោយ ផ្ទាល់ ដល់ មូលដ្ឋាន បាន ចំនួន ២៥ ករណី និង ទទួលទាន មី កញ្ចប់ ទឹកក្រូច និង ទឹក បរិសុទ្ធ ជា អាហារ សម្រន់ ជួបជុំគ្នា បញ្ចប់ រឿង ផងដែរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន ក៏ បាន ផ្តល់ ជូន ប័ណ្ណ សរសើរ និង អំណោយ មួយចំនួន ជូន ដល់ លោក មី សុផាត និង ក្រុមគ្រួសារ រស់ នៅ ស្រុក បាកាន ដែល បាន ប្រគល់ វត្ថុ បូរាណ រូប ព្រះគណេស មួយ អង្គ ជូន សារ មន្ទីរ ខេត្ត ដើម្បី រក្សាទុក កាលពី ថ្ងៃទី ០៧ ខែសីហា ឆ្នាំ ២០១៩ កន្លងទៅ ៕
អភិបាល ខេត្ត ក្រចេះ សាទរ ចំពោះ សិស្ស ពូកែ ឆ្នាំ ២០២០ និង ជំរុញ លើកទឹកចិត្ត ឲ្យ ខំ រៀន បន្ថែម ទៀត
( ក្រចេះ ) ៖ លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ បាន អញ្ជើញ ប្រគល់ វិញ្ញាបនបត្រ ដល់ បេក្ខជន ទទួល ជ័យលាភី សិស្ស ពូកែ ទូទាំង ខេត្ត ក្នុង ឆ្នាំ ២០២០ លើ មុខវិជ្ជា ផ្នែក អក្សរ សីល្ប៍ ខ្មែរ . គណិតវិទ្យា និង រូបវិទ្យា ថ្នាក់ ទី៩ និង ទី ១២ នៅ សម័យ ប្រឡង ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២០ សរុប ៣០ រូប ។
លោក ឡាយ ប៉ូរ៉ា ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត បាន បញ្ជាក់ នៅ ព្រឹក ថ្ងៃទី៣០ ខែកក្ត ដា នេះ ថា ការប្រឡង ជ្រើសរើស សិស្ស ពូកែ ប្រចាំ រាជធានី - ខេត្ត និង ទូទាំង ប្រទេស ត្រូវបាន បង្កើត ឡើង ក្រោម គំនិត ផ្ដួច ផ្ដើម ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន តាំងពី ឆ្នាំ សិក្សា ១៩៩៦ មក ម្ល៉េះ ដោយ កាល នោះ ការប្រឡង នេះ មាន ឈ្មោះ ថា ការប្រឡង ជ្រើសរើស សិស្ស ពូកែ ទូទាំង ប្រទេស ផ្នែក អក្សរសាស្ត្រ និង គណិតវិទ្យា ដើម្បី ទទួល ពានរង្វាន់ សម្ដេច តេជោ ហ៊ុន សែន និង លោកជំទាវ ។
មកទល់ ពេលនេះ សម្រាប់ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ នេះ ខេត្ត ក្រចេះ មាន សិស្ស ពូកែ ថ្នាក់ ទី ៩ និង ថ្នាក់ ទី១២ ផ្នែក អក្សរ សីល្ប៍ ខ្មែរ - គណិតវិទ្យា និង រូបវិទ្យា នៃ គ្រឹះស្ថាន មធ្យមសិក្សា ចំណេះ ទូទៅ ។ ជា លទ្ធផល ទទួលបាន ចំនួន ៣០ រូប ដោយ ក្នុង នោះ រួម មាន៖
លោក អភិបាល ខេត្ត បាន កោតសរសើរ និង ថ្លែងអំណរគុណ ដល់ លោក គ្រួ- អ្នកគ្រួ អាណាព្យាបាល ព្រមទាំង ក្មួយ ៗ សិស្សានុសិស្ស ដែល បាន ខិតខំ យកចិត្តទុកដាក់ ក្នុង ការសិក្សា រៀនសូត្រ រហូត ទទួលបាន លទ្ធផល នា ថ្ងៃ នេះ ជាពិសេស ក្មួយ ៗ ដែល បាន ប្រឡង ជាប់ ចំណាត់ថ្នាក់ និង ទទួលបាន ជ័យលាភី នេះ គឺជា កិត្តិយស ណាស់ សម្រាប់ ខេត្ត ក្រចេះ និង ជា កិត្តិយស សម្រាប់ ក្រុមគ្រួសារ ក្មួយ ៗ ផងដែរ ។
កត្តា សំខាន់ នោះ គឺ រៀន ជាប់ ជានិច្ច ទាំង អ្នក ជាប់ និង អ្នក មិន ជាប់ ជ័យលាភី មិន ត្រូវ បោះបង់ ការសិក្សា ឡើយ គឺ ត្រូវ បន្ត ខិតខំ កសាង ខ្លួន ឲ្យ ក្លាយជា យុវជន ជឿនលឿន ជា សរស ស្តម្ភ ដ៏ រឹងមាំ របស់ ប្រទេសជាតិ និង ស្វែងរក កិត្តិយស ថ្មី ៗ ទៀត ជូន ជាតិ មាតុភូមិ ៕
ក្រសួង ផែនការ ព្រមាន ចាត់ការ តាម ច្បាប់ ចំពោះ បុគ្គល ម្នាក់ បន្លំ ជា មន្ដ្រី ថ្នាក់ ជាតិ ទៅ ជំរិត ទារ ប្រាក់ ពី មន្ដ្រី មូលដ្ឋាន (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង ផែនការ នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ចេញមក ច្រានចោល ទាំងស្រុង ចំពោះ ករណី ថា មន្ដ្រី ថ្នាក់ ជាតិ ទូរស័ព្ទ ទៅ ជំរិត ទារ ប្រាក់ ពី មន្ដ្រី មូលដ្ឋាន ជា ថ្នូរ នឹង ការ មិន ចុះ ធ្វើ អធិការកិច្ច និង ពាក់ព័ន្ធ ការកំណត់ អត្តសញ្ញាណកម្ម គ្រួសារ ក្រីក្រ អំឡុង ពេល ជំងឺ កូវីដ១៩ ។
អ្នកនាំពាក្យ ក្រសួង ផែនការ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ឈ្មោះ សោម វ៉ាន់ ទូរស័ព្ទ លេខ 092 440 062 ជា អ្នកសារព័ត៌មាន អង្គរ ឯករាជ្យ ( តាម ការឆ្លើយ បញ្ជាក់ ពី សាមីខ្លួន ដែល យើង បាន ទាក់ទង ទៅ សួរនាំ ) ។ ខ្ញុំ សូម បញ្ជាក់ យើង នឹង មាន វិធានការណ៍ តាម ផ្លូវ ច្បាប់ ប្រសិនបើ ឈ្មោះ សោម វ៉ាន់ នេះ នៅតែ បន្ត ប្រើប្រាស់ ឈ្មោះ ជា មន្ត្រី ក្រសួង ផែនការ ឬ ធ្វើ ការជំរិត ទារ ប្រាក់ ពី ថ្នាក់ មូលដ្ឋាន ជាពិសេស ពាក់ព័ន្ធ នឹង ការកំណត់ អត្តសញ្ញាណកម្ម គ្រួសារ ក្រីក្រ តាម ការស្នើសុំ ក្នុង អំឡុង ពេល ជំងឺ កូវីដ ១៩ នេះ » ។
ក្រសួង ផែនការ សូម លើកទឹកចិត្ត ឲ្យ មាន ការផ្តល់ ព័ត៌មាន អំពី ភាព មិន ប្រក្រតី ដែល មាន ប្រភព ច្បាស់លាស់ នៃ ការកំណត់ អត្តសញ្ញាណកម្ម គ្រួសារ ក្រីក្រ នេះ មក ក្រសួង ពិនិត្យ និង ដោះស្រាយ ជាពិសេស ផ្តល់ ព័ត៌មាន អំពី គ្រួសារ ក្រីក្រ ពិតប្រាកដ ដែល មិន ទាន់ បាន ដាក់ពាក្យ ស្នើសុំ ឬ មិន ទាន់ មាន បណ្ណ សមធម៌ ដើម្បី ក្រសួង ជួយ ពួកគាត់ ឲ្យបាន ទាន់ ពេល វេលា ។
មូលនិធិ ជន ពិការ បាន ប្រគល់ ផ្ទះ ថ្មី មួយ ខ្នង ជូន ជន មាន ពិការ ភាព ភ្នែក ខាងស្តាំ មួយ ចំហៀង រស់ នៅ ខេត្ត ពោធិ៍សាត់
លោក បាន បន្ត ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដាក់ចេញ នូវ កម្មវិធី ផ្តល់ ជា ថវិកា ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង អំឡុង ជំងឺ កូវីដ១៩ ដោយ សម្រាប់ ខែមិថុនា កន្លងមក នេះ បាន ផ្តល់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ចំនួន ជាង ៥៣០. ៨៣៨ គ្រួសារ ស្មើនឹង ២. ១៥៣. ១១៤ នាក់ ដោយ អស់ ថវិកា ជាតិ ចំនួន ៩៤. ៥៥១. ៨៧៦.០០០ រៀល ។
តាម សេចក្តីរាយការណ៍ របស់ លោក ហ៊ុត ពន្លឺ ប្រធាន គណៈកម្មការត្រួតពិនិត្យ វាយតម្លៃ និង សាងសង់ ផ្ទះ ជូន ជន ពិការ ក្រីក្រ តាម សហគមន៍ របស់ មូលនិធិ ជន ពិការ គឺ ក្រុមការងារ បាន ចុះ វាយតម្លៃ ស្ថានភាព និង លក្ខណៈ វិនិច្ឆ័យ របស់ ជន ពិការ ខាងលើ ដោយ មាន ការស្នើសុំ ពី សាខា មូលនិធិ ជន ពិការ ខេត្ត ការបញ្ជាក់ ពី អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ ជិតខាង គឺ ពិតជា ជនពិការ ក្រីក្រ មាន ផ្ទះ ខ្ទម ចាស់ ទ្រុត ទ្រោម និង ដោយ រស់ នៅ ពឹងផ្អែក ទៅ លើ ចំណូល តិចតួច ពិតប្រាកដ មែន ។
លោក បន្ត ថា កន្លងមក មូលនិធិ ជន ពិការ តាមរយៈ សាខា ខេត្ត ពោធិ៍សាត់ បាន ផ្តល់ អំណោយ ជូន ជន ពិការ ក្រីក្រ បាន ចំនួន ៦១ នាក់ រួច មកហើយ ក្នុង ថ្ងៃ នេះ ដែរ មូលនិធិ ជពិការ នឹង ផ្តល់ ជូន ជន ពិការ ចំនួន ១៨ នាក់ ទៀត ដោយ ក្នុង ម្នាក់ ៗ ទទួលបាន នូវ ថវិកា ១០ម៉ឺន រៀល អង្ករ ២៥ គីឡូ ក្រោម ត្រីខ២យួរ ទឹក ស៊ីវ អ៊ីវ១យួរ ទឹកត្រី ១យួរ អំបិល ២កញ្ចប់ មី ១កេស ។
បន្ថែម ពីលើ នេះ លោក សៅ ឡែន បាន ឲ្យដឹង ថា ទោះជា ស្ថានភាព នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ មិន ទាន់ បាន បញ្ចប់ ក្តី ក៏ មូលនិធិ ជន ពិការ នៅតែ បន្ត សកម្មភាព របស់ ខ្លួន លើ ការផ្តល់ សេវា ស្តារ លទ្ធភាព ពលកម្ម ដោយ បាន ខិតខំ ប្រឹងប្រែង អនុវត្ត នូវ វិធានការណ៍ ជាច្រើន នៅ តាម មជ្ឈមណ្ឌល ស្តារ លទ្ធភាព ពលកម្ម ដូចជា វិធានការណ៍ រក្សា គំលាត ការថែរក្សា អនាម័យ ការប្រើប្រាស់ ឧបករណ៍ ការពារ សុវត្ថិភាព និង ផ្ទាំង អប់រំ នានា សំដៅ ឱ្យ ជន ពិការ ទទួលបាន នូវ សេវា ស្តារ លទ្ធភាព ពលកម្ម ប្រកបដោយ គុណភាព និង សុវត្ថិភាព ។
ក្នុង ពិធី នេះ ដែរ មូលនិធិ ជន ពិការ ក៏ បាន នាំយក អំណោយ សប្បុរសធម៌ សម្រាប់ ផ្តល់ ជូន ដល់ គ្រួសារ លោក ប៉ាវ វ៉ាន់ ដែល ជា ជនពិការ ទទួលបាន ផ្ទះ ថ្មី ពី មូលនិធិ ជន ពិការ ផងដែរ ដែល អំណោយ ទាំងអស់ រួម មាន៖ ថវិកា ១០ម៉ឺន រៀល អង្ករ ២៥ គីឡូ ក្រោម ត្រីខ២យួរ ទឹក ស៊ីវ អ៊ីវ១យួរ ទឹកត្រី ១យួរ អំបិល ២កញ្ចប់ មី១ កេស និង សម្លៀកបំពាក់ ១កញ្ចប់ ។ ជាមួយគ្នា នោះ លោក សៅ ឡែន ក៏ បាន ផ្តល់ ជូន នូវ ថវិកា មួយ ចំនួន ដល់ ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម ពិធី នេះ ចំនួន ១៨ នាក់ ។
គូសបញ្ជាក់ ថា ដើម្បី បន្ត អនុវត្ត កិច្ចការពារ និង បង្ការ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នៅក្នុង កម្មវិធី នេះ ក៏ បាន រៀបចំ ជា ម៉ាស ទឹក អាកុល ម៉ាស៊ីន ស្ទង់ កំដៅ សម្រាប់ ប្រើប្រាស់ និង រក្សា នូវ គម្លាត សុវត្ថិភាព ផងដែរ ៕ ការរៀបចំ សណ្ដាប់ធ្នាប់ ប្រជុំជន ផ្សារ ផ្អាវ . អាជ្ញាធរ ប្រាប់ ឲ្យ អាជីវករ ទាំងអស់ រុះរើ ចូល ត្រឹម គំនូស ក្រហម
( កំពង់ចាម ) ៖ នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ ក្នុង ការបំពេញ បេសកកម្ម របស់ អាជ្ញាធរ ខេត្ត កំពង់ចាម ដឹកនាំ ដោយ អភិបាល រង ខេត្ត កំពង់ចាម លោក អ៊ុ ភឿន គុណ វុឌ្ឍ និង លោក សំ ពិសិដ្ឋ នាយក រង រដ្ឋបាល ខេត្ត និង លោក ផេន សុផល អភិបាល ស្រុក បាធាយ បាន ចុះ រៀបចំ សណ្ដាប់ធ្នាប់ នៅ ទីប្រជុំជន ផ្សារ ផ្អាវ ក្នុង ស្រុក បាធាយ ខេត្ត កំពង់ចាម ដែល ក្នុង ដំណាក់កាល នេះ អាជ្ញាធរ តម្រូវឲ្យ ក្រុម អាជីវករ រើ អីវ៉ាន់ ដាក់ លក់ ត្រឹម គំនូស ក្រហម ដែល អាជ្ញាធរ បាន កំណត់ ថ្មី ៗ កន្លងទៅ នេះ ។
នៅក្នុង ប្រតិបត្តិការ ថ្ងៃ ដដែល នេះ ផងដែរ ពេលព្រឹក ក្រុម អាជ្ញាធរ មាន សមត្ថកិច្ច បាន ប្រើ គ្រឿង បំពង សំលេង ដើម្បី ផ្សព្វផ្សាយ ឲ្យ ប្រជាពលរដ្ឋ រៀបចំ សណ្ដាប់ធ្នាប់ ដោយ រួសរើ និង ៗ ប្រមូល សម្ភារ លក់ដូរ ចូល ត្រឹម គំនូស ក្រហម ដែល អាជ្ញាធរ បាន កំណត់ ។ លុះ ដល់ ពេល រសៀល ក្រុម អាជ្ញាធរ មាន សមត្ថកិច្ច ចុះ ពិនិត្យ ម្ដង ទៀត ហើយ ប្រសិនបើ មាន អាជីវករ ណា មិន អនុវត្ត តាម សមត្ថកិច្ច នឹង ធ្វើ ការរៀបចំ ដោយ ផ្ទាល់ តែម្ដង ។
គួរ រំលឹក ថា អភិបាល ស្រុក បាធាយ ធ្លាប់ បាន ឲ្យដឹង ថា នៅក្នុង ផ្សារ ផ្អាវ មាន ជាង ២០០ តូប ដោយឡែក នៅ ផ្នែក ខាងក្រៅ ផ្សារ ជាប់ នឹង ដង ផ្លូវ លេខ ៦ នឹង ផ្លូវ សម្ដេច តេជោ មាន ជាង ៥០ គ្រែ លក់ មុខ ផ្សារ និង ក្រោយ ១០ផ្ទះ និង កន្លែង លក់ ត្រី មាន ១៥០ កន្លែង ។
កន្លែង លក់ ដែល បង្ក ភាពអណាធិបតេយ្យ គឺ មាន ជាង ១០០ កន្លែង អម សងខាង ផ្លូវ សម្តេច តេជោ ខាងកើត និង ខាងលិច ។ ចំណែក ជាប់ ផ្លូវ លេខ ៦ មាន ជាង ៨០កន្លែង ដែល ក្នុង នោះ មាន ការធ្វើ សំយ៉ាបខិត មក ថ្នល់ ដែល បង្កឲ្យ មាន ការបាត់ សោភ័ណភាព នៅ ទីប្រជុំជន ផ្សារ នេះ ផងដែរ ។
ករណី នេះ បន្ទាប់ពី មាន ការឯកភាព នៅក្នុង អង្គប្រជុំ អភិបាល ខេត្ត កំពង់ចាម បាន ចាត់ ឲ្យ អភិបាល រង ខេត្ត លោក អ៊ុភឿន គុណ វុឌ្ឍ ដឹកនាំ ក្រុមការងារ ចុះ ប្រតិបត្តិការ ដើម្បី រៀបចំ សណ្ដាប់ធ្នាប់ ទីប្រជុំជន ផ្សារ ផ្អាវ នេះ ឡើងវិញ ។
ទន្ទឹមនឹង នេះ ទាំង ប្រជាពលរដ្ឋ ក៏ ដូចជា អាជីវករ ជាច្រើន មាន ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ចំណាត់ការ របស់ អាជ្ញាធរ ខេត្ត ក្នុង ប្រតិបត្តិការ រៀបចំ សណ្ដាប់ធ្នាប់ សាធារណៈ ទីប្រជុំជន ផ្សារ ផ្អាវ នេះ ផងដែរ ។
