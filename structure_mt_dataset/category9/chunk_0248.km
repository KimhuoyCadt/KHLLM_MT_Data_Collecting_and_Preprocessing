( បាត់ដំបង ) ៖ លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង បាន ជំរុញឱ្យ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ នានា បន្ត ទប់ស្កាត់ ការកាប់ ទន្ទ្រាន យក ដី រដ្ឋ ដោយ ខុស ច្បាប់ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ។
ការជំរុញ បែប នេះ របស់ លោក ងួន រតនៈ បាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ រដ្ឋបាល ឯកភាព ខេត្ត ប្រចាំ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ ដោយ មាន ការចូលរួម ពី ថ្នាក់ អភិបាល រង ខេត្ត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង បី ប្រភេទ អភិបាល ក្រុង ស្រុក មន្ទីរ ជំនាញ នានា ជុំវិញ ខេត្ត ចូលរួម ផងដែរ ។
ក្នុង កិច្ចប្រជុំ នេះ ប្រធាន មន្ទីរ ជំនាញ រដ្ឋបាល ក្រុង ស្រុក បាន ឡើង រាយការណ៍ ពី លទ្ធផល ការងារ និង មាន បញ្ហា ប្រឈម នានា ខ្លះ ជូន ថ្នាក់ដឹកនាំ ផ្តល់ ការណែនាំ និង ជួយ ធ្វើ ការដោះស្រាយ ពាក់ព័ន្ធ កន្លងទៅ ជូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ។
ក្នុង នោះ លោក ឱសថ បណ្ឌិត វឿង ប៊ុន រ៉េត ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត បាន លើកឡើង និង ផ្សព្វផ្សាយ អំពី វិធី ការពារ ជំងឺ គ្រុន ឈីក ដែល ស្រដៀង ជំងឺ គ្រុន ឈាម ដែរ ។ ខណៈ អាការៈ រោគ ច្រើន កើត ទៅ លើ មនុស្ស ចាស់ ដោយ មាន ការឈឺ ឆ្អឹង សន្លាក់ ដៃ ជើង តែ មិន មាន ការ គ្រោះថ្នាក់ អ្វី ធំដុំ នោះ ទេ តែ វិធានការ ការពារ កុំ ឱ្យ ឆ្លង គឺ ការពារ កុំ ឱ្យ មូស ខាំ ដូច ជំងឺ គ្រុន ឈាម ដែរ ។
ក្នុង កិច្ចប្រជុំ ដដែល រដ្ឋបាល ខេត្ត បាន ផ្សព្វផ្សាយ លិខិត របស់ ក្រសួង មហាផ្ទៃ ចំនួន ពីរ រួម មាន៖
* ទី១៖ ស្តីពី ការទប់ស្កាត់ ការ ទន្ទ្រាន យក ដី នៅ ក្នុង តំបន់ ការពារ ធម្មជាតិ របស់ រដ្ឋ និង ដី រដ្ឋ ហាមឃាត់ ផ្សេង ទៀត ដោយ ខុស ច្បាប់ * ទី ២៖ ស្តីពី ការទប់ស្កាត់ ការផ្តល់ បណ្ណ ក្រីក្រ ជូន ប្រជាពលរដ្ឋ និង បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ ឱ្យ មាន ល្អ តម្លាភាព មិន ត្រូវ យក លុយ ពី ពលរដ្ឋ ក្រីក្រ នោះ ឡើយ ។
ឆ្លៀត នៅក្នុង ឱកាស នោះ លោក ងួន រតនៈ បាន កោតស សើរ មន្រ្តី ជំនាញ នៅ តាម ស្ថាប័ន នានា ដែល បាន ខិតខំ ធ្វើ ការងារ នេះ បាន ល្អ ប្រសើរ សម្រេច ជោគជ័យ និង សូម ឱ្យ មន្ត្រី បន្ត ធ្វើ ការងារ បម្រើ ប្រជាពលរដ្ឋ ជាពិសេស ជន ក្រីក្រ ជន ងាយ រងគ្រោះ និង ប្រជាពលរដ្ឋ ឆ្លង ដែន ដោយ ខុស ច្បាប់ ព្រមទាំង ជំរុញ ការយកចិត្តទុកដាក់ អនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព នៅ តាម មូលដ្ឋាន ។
( ក្រចេះ ) ៖ ខេត្ត ក្រចេះ កំពុង រង់ចាំ ស្វាគមន៍ វត្តមាន ភ្ញៀវ ទេសចរ គ្រប់ ពេលវេលា ខណៈ លោក ចាន់ សុគន្ធី ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ក្រចេះ បាន ផ្តល់ បទបង្ហាញ ជូន សារធារណជន ក៏ ដូចជា ភ្ញៀវ ទេសចរ អំពី ទីតាំង រមណីយដ្ឋាន ទេសចរណ៍ និង តំបន់ ទេសចរណ៍ នានា នៅក្នុង ខេត្ត ដែល ភ្ញៀវ ទេសចរ អាច ទៅ មក ទស្សនា កម្សាន្ត បាន គ្រប់ ពេលវេលា ពិសេស គឺ ក្នុង ថ្ងៃ ឈប់សម្រាក ខាងមុខ ។
ជាមួយ កិច្ចការងារ នេះ ដែរ លោក ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត ក្រចេះ ក៏ បាន ស្នើឲ្យ ម្ចាស់ មូលដ្ឋាន អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ ពិសេស ម្ចាស់ អាជីវកម្ម សេវាកម្ម ស្នាក់ នៅ និង សេវាកម្ម ម្ហូប អាហារ ឱ្យ អនុវត្ត នូវ វិធាន សុវត្ថិភាព ទសចរណ៍ ឲ្យបាន ម៉ឺងម៉ាត់ ដើម្បី បង្ការ - ការពារ ការឆ្លង រាលដាល ជំងឺ កូវី - ១៩ ចូល ទៅក្នុង សហគមន៍ ។
លោក ប្រធាន មន្ទីរ ទេសចរណ៍ ក៏ បាន អំពាវនាវ ទុក មុន ដល់ ភ្ញៀវ ទេសចរ ផងដែរ ឱ្យ បន្ត យកចិត្តទុកដាក់ ចំពោះ សុខ សុវត្ថិភាព ផ្ទាល់ខ្លួន ដោយ យក ជាប់ ខ្លួន នូវ សម្ភារៈ ប្រើប្រាស់ តាម ដែល អាច ធ្វើ ទៅ បាន ដូចជា ម៉ាស់ ឬ ក្រមា អាល់កុល ឬ អាល់កុល ជែល តាម ខ្លួន ជានិច្ច ។
( ស្វាយរៀង ) ៖ លោក អ៊ែម៊ែ នែហ្សីល ឌូ គូប ប៉ា ឡូ បេស ឯក អគ្គ រដ្ឋទូត វិសាមញ្ញ និង ពេញ សមត្ថភាព នៃ សាធារណៈ រដ្ឋ ប្រជាធិបតេយ្យ ទីម័រ ខាងកើត ប្រចាំ កម្ពុជា នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន ជួប ពិភាក្សា ការងារ ជាមួយ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង ដើម្បី ជួប សម្តែង ការគួស ម ពិភាក្សា ការងារ ក្នុង គោលបំណង សិក្សា ស្វែងយល់ ពី សមិទ្ធផល និង ការអភិវឌ្ឍ ខេត្ត ស្វាយរៀង ក៏ ដូចជា ការដកស្រង់ បទពិសោធន៍ ល្អ ៗ ពី រដ្ឋបាល ខេត្ត យក ទៅ អភិវឌ្ឍ នៅ តំបន់ ព្រំដែន នៃ ប្រទេស ទីម័រ ។
ថ្លែង ទៅកាន់ លោក អ៊ែម៊ែ នែហ្សីល ឌូ គូប ប៉ា ឡូបេស លោក ម៉ែន វិបុល បាន បញ្ជាក់ ជូន អំពី ស្ថានភាព ភូមិសាស្ត្រ និង តំបន់ សក្កានុពល សំខាន់ ៗ ដែល រដ្ឋបាល ខេត្ត សម្រេចបាន រួម មាន៖ វិស័យ សេដ្ឋកិច្ច ឧស្សាហកម្ម ពាណិជ្ជកម្ម និង កសិកម្ម ជាដើម ជាពិសេស ការផ្តល់ ការងារ ធ្វើ ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត និង មកពី តាម បណ្តា ខេត្ត ជាង ៨ម៉ឺន នាក់ ។
ទន្ទឹម នោះ លោក អភិបាល ខេត្ត បាន ជម្រាប ជូន អំពី ស្ថានភាព បច្ចុប្បន្ន និង វិធីសាស្ត្រ ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ របស់ រាជ រដ្ឋាភិបាល ក្នុង នោះ រដ្ឋបាល ខេត្ត ស្វាយរៀង ក៏ បាន អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ តាម សេចក្តីណែនាំ របស់ ក្រសួង សុខាភិបាល កម្ពុជា ផងដែរ ។
លោក ពូទីន បាន ប្រកាស ជោគជ័យ ខាងលើ នេះ ក្រោយពី ក្រុម ជំនាញ វេជ្ជសាស្ត្រ រុស្ស៊ី បាន ធ្វើតេស្ត វ៉ាក់សាំង COVID-19 ទៅ លើ មនុស្ស ជា លើក ដំបូង កាលពី ពីរ ខែ មុន ។ ការបោះជំហាន ដ៏ អស្ចារ្យ នេះ ពិតជា ការត្រួសត្រាយ ផ្លូវ ដ៏ សំខាន់ សម្រាប់ ការចាក់ ថ្នាំ បង្ការ មេរោគ ទ្រង់ទ្រាយ ធំ បើ ទោះបីជា ការអនុវត្ត ដំណាក់កាល ចុងក្រោយ នៃ ការសាកល្បង របស់ រុស្ស៊ី ដើម្បី សាកល្បង សុវត្ថិភាព និង ប្រសិទ្ធភាព នៅតែ បន្ត ក៏ដោយ ។
( ស្វាយរៀង ) ៖ ស្ត្រី ចំណាស់ ម្នាក់ បាន ស្លាប់ និង មនុស្ស ៣នាក់ ទៀត រងរបួស ធ្ងន់ ត្រូវ ក្រុមគ្រួសារ ដឹក យក ទៅ សង្គ្រោះ នៅ មន្ទីរពេទ្យ បន្ទាប់ពី ក្មេងស្រី ២នាក់ បាន យក រ៉ូឡូ ភ្លើង មក សាក ថ្ម ទូរស័ព្ទ ហើយ ខ្សែភ្លើង នោះ មាន ដាច់ លៀន ចេញ សរសៃ ស្រាត បណ្ដាលឲ្យ ឆ្លង ចរន្ត ភ្លើង ឆក់ បន្តបន្ទាប់ គ្នា បង្ក ការភ្ញាក់ផ្អើល ដល់ អ្នកជិតខាង នៅ ល្ងាច ថ្ងៃទី ១០ ខែសីហា ឆ្នាំ ២០២០ ស្ថិត ក្នុង ភូមិ មេលោង សង្កាត់ ចេក ក្រុង ស្វាយរៀង ខេត្ត ស្វាយរៀង ។
នគរបាល ក្រុង ស្វាយរៀង បាន ឲ្យដឹង ថា ស្ត្រី ចំណាស់ ដែល ឆក់ ស្លាប់ នោះ មាន ឈ្មោះ យស់ ទូច អាយុ ៦៥ ឆ្នាំ មុខរបរ កសិករ រស់ ក្នុង ភូមិ សង្កាត់ ខាងលើ ចំណែក ស្ត្រី ចំណាស់ ដែល រងរបួស ត្រូវ ជា ម្ចាស់ ផ្ទះ មាន ឈ្មោះ ចាន់ សេរី អាយុ ៦៦ ឆ្នាំ មុខរបរ កសិករ ចំណែក ក្មេងស្រី ដែល រង របួស ២នាក់ មាន ឈ្មោះ អ៊ាម សុម៉ាឡែន អាយុ ១៥ ឆ្នាំ មុខរបរ សិស្ស និង ទី៖ ឈ្មោះ ទ្រី សុវណ្ណ បុប្ផា រ អាយុ ៩ ឆ្នាំ មុខរបរ សិស្ស រស់ ក្នុង ភូមិ សង្កាត់ ខាងលើ ជាមួយគ្នា ។
ក្រោយ កើត ហេតុ សមត្ថកិច្ច នគរបាល ក្រុង សហការ ជាមួយ ប៉ុស្តិ៍ រដ្ឋបាល និង គ្រូពេទ្យ មណ្ឌល សុខភាព ចេក បាន មកដល់ និង ពិនិត្យ កន្លែង កើត ហេតុ ឃើញ ថា សព ពិត ជា ស្លាប់ ដោយសារ ឆក់ ខ្សែភ្លើង ពិតប្រាកដ មែន និង ប្រគល់ឲ្យ ក្រុមគ្រួសារ យកមក ធ្វើ បុណ្យ តាម ប្រពៃណី ៕
តំណាង លោក ហេង រតនា ផ្ដល់ អំណោយ វីរ នារី ដោះ មីន គង់ សារឿន នៅ ខេត្ត ស្វាយរៀង ដែល កំពុង មាន ជំងឺ
( ស្វាយរៀង ) ៖ គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា ចំនួន ២លាន រៀល ត្រូវបាន លោក កែវ សារ៉ាត់ ប្រធាន កង ឯកភាព កម្ចាត់ មីន ទី៥ តំណាង លោក ហេង រតនា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក អគ្គ នាយក ស៉ី ម៉ាក់ និង ក្រុមការងារ ប្រគល់ ជូន អ្នកស្រី គង់ សារឿន វីរ នារី អង្គភាព ដោះ មីន ខេត្ត ស្វាយរៀង ដែល កំពុង មាន ជំងឺ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក ស្វាយទាប ជាមួយ ស្វាមី ។
ថ្លែង ក្នុង ឱកាស ផ្តល់ អំណោយ នា ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ ស្ថិត ក្នុង ឃុំ ក ណ្ដៀង រាយ ស្រុក ស្វាយទាប លោក កែវ សារ៉ាត់ បាន ផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ នឹករលឹក ពីសំណាក់ លោក ហេង រតនា ដល់ អ្នកស្រី គង់ សារឿន ។
លោក ក៏ បាន កោតសរសើរ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ អ្នកស្រី ដែល មាន ស្នាដៃ និង បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការបោសសម្អាត មីន នា ពេល កន្លងមក ដោយ លោក ហេង រតនា មិន ដែល ភ្លេច ពី វីរភាព របស់ ប្រតិបត្តិករ ដោះ មីន ណា ម្នាក់ ចោល ឡើយ ទោះ ក្នុង កាលៈទេសៈ ណា ក៏ដោយ ។
លោក បន្ថែម ថា ការចុះ មក ពេលនេះ មាន គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន សម្ភារ ប្រើប្រាស់ ចាំបាច់ និង ថវិកា មួយ ចំនួន ជូន អ្នកស្រី ដើម្បី ដោះស្រាយ ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ បាន មួយ រយៈពេល ផងដែរ ។
ក្នុង ឪកាស នោះ អ្នកស្រី គង់ សារឿន បាន លើក ដៃ ប្រណម ថ្លែងអំណរគុណ ដល់ លោក ហេង រតនា និង ក្រុមការងារ ដែល បាន ចុះ សួរសុខទុក្ខ និង ផ្តល់ អំណោយ ដល់ អ្នកស្រី និង ក្រុមគ្រួសារ ដែល កំពុង មាន ជំងឺ សម្រាក ព្យ បាល នៅ មន្ទីរពេទ្យ នា ពេលនេះ ។
ទន្ទឹមនឹង នេះ មនុស្ស ចំនួន ០២ នាក់ ទៀត ត្រូវបាន រកឃើញ ជាប់ នៅក្រោម ផ្ទះ ដែល បាន បាក់ រលំ ខណៈ កិច្ចប្រឹងប្រែង ជួយសង្គ្រោះ ត្រូវបាន ធ្វើឡើង ។ ទឹក ជំនន់ នោះ បាន បង្ក ការបំផ្លិចបំផ្លាញ ដល់ ផ្លូវថ្នល់ លំនៅដ្ឋាន ទំនប់ ទឹក និង ស្ថានីយ ផ្គង់ ផ្គង់ ថាមពល អគ្គីសនី នៅក្នុង ទីក្រុង ដែល នាំឲ្យ ការខាតបង់ យ៉ាង ច្រើន ។
ប្រភព ព័ត៌មាន ពី កន្លែង កើត ហេតុ បាន ប្រាប់ ឱ្យដឹង ថា មុនពេល កើត ហេតុ នៅ វេលា ម៉ោង ៥៖៣០ នាទី ព្រឹក ថ្ងៃទី ១១ ខែសីហា នេះ គេ បាន ឃើញ ស្ត្រី ជនជាតិ ខាងលើ រួម ជាមួយនឹង បុរស ជនជាតិ ចិន ២នាក់ ទៀត នាំ ស្ត្រី ជនជាតិ ចិន ចូលក្នុង សណ្ឋាគារ ខាងលើ ដោយ មាន ការទាញ ប្រតាយ ប្រតប់ គ្នា ជាមួយ ស្ត្រី ជនរងគ្រោះ ខាងលើ ហើយ បាន នាំចូល មក ក្នុង សណ្ឋាគារ តែម្តង ។
ក្រោយពេល កើត ហេតុ កម្លាំង សមត្ថកិច្ច ប៉ុស្តិ៍ ផ្សារ ថ្មី ទី៣ បាន ចុះ មកដល់ កន្លែង ទីតាំង កើត ហេតុ និង បាន ធ្វើ ការឃាត់ខ្លួន ជនជាតិ ចិន ចំនួន ៤នាក់ យកមក ប៉ុស្តិ៍ នគរបាល ផ្សារ ថ្មី ទី៣ ដើម្បី ធ្វើ ការសួរនាំ ។
ជាក់ស្តែង នៅក្នុង ហេតុការណ៍ នេះ យើង សង្កេតឃើញ មាន វត្តមាន របស់ លោក សុខ ពេញវុធ អភិបាល នៃ គណៈអភិបាល ខណ្ឌ ដូនពេញ បាន ចុះ មកដល់ ទីតាំង កើត ហេតុ និង បាន បញ្ជា ឱ្យ សមត្ថកិច្ច មូលដ្ឋាន និង អធិការ ខណ្ឌ បិទ ច្រក ចេញ - ចូល ក្នុង សណ្ឋាគារ ទាំងអស់ ដើម្បី ធ្វើ ការស្រាវជ្រាវ រក មូលហេតុ នៃ ការធ្លាក់ពី សណ្ឋាគារ នេះ ៕ គណៈកម្មការ ទី១០ ព្រឹទ្ធសភា សិក្សា ឈ្វេងយល់ អំពី ការអភិវឌ្ឍ ថ្មី ៗ របស់ ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ បាន អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ គណៈកម្មការ ទី១០ ព្រឹទ្ធសភា ដើម្បី សិក្សា ឈ្វេងយល់ អំពី ការ អភិវឌ្ឍ ថ្មី ៗ របស់ ខេត្ត វឌ្ឍនភាព និង បញ្ហា ប្រឈម នៃ ការអនុវត្ត ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ ការអនុវត្ត កំណែទម្រង់ វិមជ្ឈការ និង វិសហមជ្ឈការ ការអភិវឌ្ឍ មូលដ្ឋាន ដឹកនាំ ដោយ លោក ម៉ម ប៊ុន នាង ប្រធាន គណៈកម្មការ ទី១០ និង ជា អ្នកនាំពាក្យ ព្រឹទ្ធសភា ។
អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ នេះ រួម មាន៖ ប្រតិភូ គណៈកម្មការ ទី១០ព្រឹទ្ធសភា អភិបាល រង ខេត្ត លោក នាយក រដ្ឋបាល សាលា ខេត្ត លោក ស្នងការ នគរបាល ខេត្ត លោក មេបញ្ជាការ កង រាជអាវុធហត្ថ ខេត្ត លោក មេបញ្ជា រង ប្រតិបត្តិការ សឹក រង ខេត្ត ប្រធាន មន្ទីរ ពាក់ព័ន្ធ នានា ជុំវិញ ខេត្ត និង លោក លោកស្រី នាយក ទី ចាត់ការ / អង្គភាព ចំណុះ សាលា ខេត្ត ។
លោក ម៉ែន វិបុល បាន អរគុណ ចំពោះ ការឆ្លៀត ពេល ដ៏ មមាញឹក អញ្ជើញ ចុះ មក ឈ្វេងយល់ អំពី ប្រសិទ្ធភាព ប្រសិទ្ធផល និង បញ្ហា ប្រឈម នានា ជុំវិញ ការអភិវឌ្ឍ មូលដ្ឋាន ពិសេស ការអនុវត្ត ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ និង ការងារ វិមជ្ឈការ វិសហមជ្ឈការ នា ពេលនេះ ។
ក្នុង នោះ លោក អភិបាល ខេត្ត បាន ជម្រាប ជូន គណៈប្រតិភូ អំពី ស្ថានភាព ភូមិសាស្រ្ត ប្រជាសាស្ត្រ ការអភិឌ្ឍ វឌ្ឍនភាព នៃ ការអនុវត្ត ច្បាប់ ការផ្តល់ សេវា រដ្ឋបាល និង ការបង្ការ ទប់ ស្តាប់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ជាដើម ។
លោក ម៉ម ប៊ុន នាង បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការអភិវឌ្ឍ រីកចម្រើន គួរឱ្យ កត់សម្គាល់ ក្នុង អាណត្តិ ដឹកនាំ របស់ លោក អភិបាល ខេត្ត ដែល ឆ្លុះបញ្ចាំង ឱ្យ ឃើញ ថា មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍ រីកចម្រើន ភាពរីកចម្រើន នេះ ហើយ គឺ អាស្រ័យ ដោយ មាន ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង ដោយ មាន ការចូលរួម អនុវត្ត ប្រកបដោយ ការយកចិត្តទុកដាក់ ពីសំណាក់ លោក អភិបាល ខេត្ត ក៏ ដូចជា រដ្ឋបាល ខេត្ត ស្វាយរៀង ទាំងមូល ។
នា ឱកាស នោះ លោក ឌី រ័ត្ន ខេមរុណ អភិបាល រង ខណ្ឌ មានជ័យ បាន ផ្សព្វផ្សាយ អប់រំ ឲ្យ បងប្អូន កម្មករ - កម្ម ការិនី រៀបចំ ទុកដាក់ វេចខ្ចប់ សំភារៈ ឲ្យបាន ត្រឹមត្រូវ មុន និង ក្រុមការងារ ធ្វើការ បាញ់ ថ្នាំ បំភាយ ទប់ស្កាត់ និង បង្ការ ជំងឺ កូវីដ - ១៩ និង អំពាវនាវ ដល់ បងប្អូន កម្មករ - កម្ម ការិនីតាម បន្ទប់ ជួល ចូលរួម គោរព តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង សម្ថត កិច្វ អាជ្ញាធរ ដើម្បី ទប់ ស្កាត់ ការឆ្លង ជំងឺ កូវីដ - ១៩ រួមទាំង បាន ចែក ជា សាប៊ូ ក្រមា មួយចំនួន ជូន ពួកគាត់ ផងដែរ ។
និយាយ ដោយឡែក ក្នុង ខណ្ឌ មានជ័យ ក្នុង ថ្ងៃ ក៏ ជា លើក ទី២ ហើយ ដែល ក្រុមការងារ បាន ចុះ ធ្វើ យុទ្ឋ នាការ នៅ បាញ់ ថ្នាំ បំភាយ ទប់ស្កាត់ កូន វិដ នៅ ខណ្ឌ មានជ័យ ។ លោក សោម អូន បាន ពន្យល់ បន្ថែម ពី ភាព ប៉ះពាល់ នៃ ការបាញ់ ថ្នាំ បំភាយ និង សូមឲ្យ បងប្អូន កុំ ធ្វេសប្រហែស ជាមួយ ជំងឺ COVID-19 និង មិន ត្រូវ ភ្លេច អនុវត្ត នូវ វិធានការណ៍ ការពារ ដូចជា ការលាង ដៃ ស្អាត ជាប្រចាំ ការពាក់ ម៉ាស់ នៅ ទីប្រជុំជន និង ការប្រើ គម្លាត សុវត្ថិភាព ជាដើម ។
សម្រាប់ លោក នួន ផារ័ត្ន អភិបាល រង រាជធានី ភ្នំពេញ ក៏ បាន ថ្លែងអំណរគុណ ដល់ ក្រុមការងារ សភា សម្ព័ន្ឋ សហជីព ជាតិ កម្ពុជា ដែល បាន សហការ ជា មូលដ្ឋាន ខណ្ឌ មានជ័យ ចុះ មក បាញ់ ថ្នាំ សម្លាប់ មេរោគ នៅ ទឹក ដី ខណ្ឌ មានជ័យ នា ពេលនេះ ដើម្បី ធានា បាន នូវ សុខ មាលភាព ប្រជាពលរដ្ឋ ស្រប តាម ក្រសួង សុខាភិបាល និង គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល ។
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ថ្លែង ថា ការសិក្សា គួរ ធ្វើឡើង ពេញ មួយ ជីវិត ដើម្បី អាច ដើរ តាម ទាន់ របត់ នៃ បដិវត្ត ឧស្សាហកម្ម ៤.០ ដោយ ហេតុ ថា ព័ត៌មានវិទ្យា ដើរ តួយ៉ាង សំខាន់ ក្នុង ការផ្លាស់ប្ដូរ របៀប ធ្វើ ការ និង ការរស់នៅ ជាពិសេស លើកកម្ពស់ វប្បធម៌ អរិយធម៌ របស់ ជាតិ សាសន៍ មួយ ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន លើកឡើង យ៉ាង ដូចនេះ នា ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ នៅ ទីស្ដីការ ក្រសួង ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី ការងារ រដ្ឋបាល និង ចែ រំលែក បទពិសោធន៍ ជោគជ័យ ក្នុង ការងារ ដល់ ថ្នាក់ដឹកនាំ អង្គភាព និង មន្ត្រី ក្រោម ឱវាទ ក្រសួង ប្រមាណ ១០០ នាក់ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បន្ថែម ទៀត ថា តាមរយៈ ការបណ្ដុះបណ្ដាល សិក្ខាកាម នឹង ទទួលបាន បទពិសោធន៍ ពិត ៗ ពី វា គ្មិន ដែល ធ្វើ បទបង្ហាញ ចែករំលែក បទពិសោធន៍ ជោគជ័យ ផ្ទាល់ខ្លួន និង ផ្តល់ ទស្សនទាន នៃ ភាព ជា អ្នកដឹកនាំ លើ ប្រធានបទ សំខាន់ ៗ ដូចជា ការអភិវឌ្ឍ ខ្លួន ការរៀបចំ ផ្នត់គំនិត ការត្រៀមខ្លួន សម្រាប់ ការផ្លាស់ប្តូរ និង ការអភិវឌ្ឍ វិជ្ជាជីវៈ និង ស្ថាប័ន ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី បាន បន្ថែម ថា ក្រសួង មាន ផែនការបណ្ដុះបណ្ដាល ប្រចាំ ឆ្នាំ ច្បាស់លាស់ ទាំង ការបណ្ដុះបណ្ដាល ក្នុង ប្រទេស និង បញ្ជូន មន្ត្រី ទៅ សិក្សា នៅ ក្រៅ ប្រទេស តាមរយៈ កម្មវិធី បណ្ដុះបណ្ដាល រយៈពេល ខ្លី ឬ អញ្ជើញ វា គ្មិន ពី ក្រៅ ប្រទេស ដូចជា សាលា Harward មក បណ្ដុះបណ្ដាល ផ្ទាល់ ដល់ មន្ត្រី ក្រសួង ដើម្បី ពង្រឹង សមត្ថភាព និង ចំណេះដឹង ឱ្យ កាន់តែ ទូលំទូលាយ សំដៅ បង្កើន ផលិតភាព ការងារ ឱ្យ ប្រសើរ ជាង មុន ។
លោក ស៊ុន ចាន់ថុល ក៏ បាន ជំរុញ លើកទឹកចិត្ត ឱ្យ មាន ការរៀបចំ កម្មវិធី ធ្វើ បទបង្ហាញ ឬ ការបណ្តុះបណ្តាល ទាក់ទង នឹង វិស័យ ព័ត៌មានវិទ្យា ដល់ មន្ត្រី ក្រោម ឱវាទ ក្រសួង ដើម្បី ពង្រឹង សមត្ថភាព ពួកគាត់ ឱ្យ កាន់តែ ទូលំទូលាយ និង រិះរក នីតិវិធី ផ្លាស់ប្ដូរ របៀបរបប ធ្វើ ការងារ សំដៅ លើកកម្ពស់ ផលិតភាព ការងារ ប្រចាំ ថ្ងៃ ឱ្យ កាន់តែ ប្រសើរឡើង ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ក៏ បាន ផ្ដាំផ្ញើ ឱ្យ សិក្ខាកាម ទាំងអស់ ចូលរួម សួរ ដេញដោល ឱ្យ បាន ផុល ផុស បំផុត ដើម្បី ក្រេប យក ចំណេះដឹង ឱ្យ ច្រើន ហើយ យក ចំណេះដឹង ទាំងនោះ ទៅ បម្រើ ជាតិ មាតុភូមិ ដើម្បី អភិវឌ្ឍ សេដ្ឋកិច្ច ឱ្យ ឈានឡើង មួយ កម្រិត ថែម ទៀត ៕
អាជ្ញាធរ រាជធានី ភ្នំពេញ សោកស្តាយ ចំពោះ សេចក្តីថ្លែងការណ៍ បំភ្លៃ ការពិត ពី គណបក្ស ខ្មែរ ឈ្នះ ពាក់ព័ន្ធ បាតុកម្ម ទាមទារ ឲ្យ ដោះលែង រ៉ុង ឈុន
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១១ ខៃ សីហា ឆ្នាំ ២០២០ នេះ បាន សម្តែង ការសោកស្តាយ យ៉ាង ខ្លាំង ចំពោះ សេចក្តីថ្លែងការណ៍ បំភ្លៃ ការពិត របស់ គណបក្ស ខ្មែរ ឈ្នះ ដែល របាយការណ៍ នេះ ពាក់ព័ន្ធ នឹង ការធ្វើ បាតុកម្ម ទាមទារ ឲ្យ ដោះលែង លោក រ៉ុង ឈុន ។ នេះ បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
( កណ្តាល )៖ គណៈកម្មការ សម្រាប់ ដោះស្រាយ បញ្ហា កូដកម្ម បាតុកម្ម នៅ តាម គ្រប់ មុខ សញ្ញា ( គ.ក .ប ) ពិតជា បាន រួមចំណែក ដ៏ សំខាន់ ក្នុង ការចូលរួម ថែរក្សា ការពារ នូវ សុខ សន្តិភាព សណ្តាប់ធ្នាប់ សង្គម និង ការពង្រឹង នីតិរដ្ឋ ដើម្បី ជីវភាព សុខសាន្ត របស់ ប្រជាពលរដ្ឋ ការពារ ធានា បាន នូវ អត្ថប្រយោជន៍ នានា ជូន ដល់ កម្មករ និយោជិត បាន ទប់ស្កាត់ ។
នេះ ជា ការលើកឡើង របស់ លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង ជា ប្រធាន គ .ក. ប នា ឱកាស បើក កិច្ចប្រជុំ ស្តីពី ការផ្សព្វផ្សាយ បទបញ្ជា លេខ ០១ បប របស់ រាជ រដ្ឋាភិបាល កម្ពុជា វិធានការ ទប់ស្កាត់ និង កាត់បន្ថយ ការធ្វើ កូដកម្ម បាតុកម្ម ខុស ច្បាប់ នា ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នៅ សាល ប្រជុំ សាលា ខេត្ត កណ្តាល ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ទៀត ថា មិន តែ ប៉ុណ្ណោះ គ .ក. ប ក៏ បាន ដោះស្រាយ ដោយ ជោគជ័យ នូវ សកម្មភាព បាតុកម្ម នយោបាយ របស់ ក្រុម ជ្រុលនិយម ដែល មាន ការគាំទ្រ និង លើកទឹកចិត្ត ពី បណ្តា មជ្ឈដ្ឋាន ខាងក្រៅ ដែល ប៉ុនប៉ង បំផ្លាញ លទ្ធផល នៃ ការបោះឆ្នោត ផ្តួលរលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ជាពិសេស ធានា បាន នូវ សុខដុមរមនា នៃ ទំនាក់ទំនង វិជ្ជាជីវៈ ក៏ ដូចជា ការពារ ផលប្រយោជន៍ ជូន កម្មករ និយោជិត នា ពេល កន្លងមក ។
ក្នុង ករណី ដែល បងប្អូន ប្រជាពលរដ្ឋ ម្ចាស់ អាជីវកម្ម សេវាកម្ម និង ស្ថាប័ន ឯកជន ទាំងអស់ ជួបប្រទះ នូវ បញ្ហា ការឆបោក ដូច បាន រៀបរាប់ ជូន៍ ខាងលើ សូម កុំ ធ្វើ តាម ការឆបោក នោះ ហើយ សូម រាយការណ៍ តាមរយៈ ប្រព័ន្ធ ទូរស័ព្ទ លេខ ០៨៧ ២៥៨ ៨៣៥ ឬ រាយការណ៍ ជូន ទៅ អាជ្ញាធរ មាន សមត្ថកិច្ច ដែល ស្ថិត នៅក្នុង មូលដ្ឋាន របស់ បងប្អូន ដោយ ផ្ទាល់ ដើម្បី ធ្វើ ការចាប់ខ្លួន ក្រុម ជន ខិលខូច ទាំងនោះ មក ផ្តន្ទាទោស តាម ច្បាប់ ។
ឆ្លៀត ក្នុង ឱកាស នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ សូម ថ្លែងអំណរគុណ ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ ម្ចាស់ អាជីវកម្ម សេវាកម្ម នឹង ស្ថាប័ន ឯកជន ទាំងអស់ ដែល បាន បំពេញ កាតព្វកិច្ច ក្នុង ការបង់ ថ្លៃ សេវា ប្រមូល សំរាម និង សំណល់ រឹង បាន យ៉ាង ល្អ ប្រសើរ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ៖ លោក នេត្រ ភក្ត្រា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន ចេញមក ទាត់ចោល ការផ្សាយ មួល បង្កាច់ ពាក្យសំដី របស់ លោក ពី ក្រុម ប្រឆាំង ថា កម្ពុជា បាត់បង់ ព្រៃឈើ មកពី ភ្លើង ឆេះ
មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន រូប បាន ចាត់ទុក ថា ការបង្ហោះ ព័ត៌មាន ក្លែងក្លាយ និង មិន ពិត យ៉ាង ដូច្នេះ ពីសំណាក់ ក្រុម ប្រឆាំង គឺ ដើម្បី បំពុល សង្គម ហើយ លោក សូម ប្រកាស ថា ខ្លឹមសារ បែប នេះ លោក មិន ដែល និយាយ ឬ ប្រាប់ សារព័ត៌មាន នោះ ទេ ។
លោក នេត្រ ភក្ត្រា បាន បន្ត ទៀត ថា ការបង្កើត រូបភាព នេះ ជា ការមួល បង្កាច់ ទាំងស្រុង ពី ក្រុម ប្រឆាំង ដើម្បី បង្ខូច កេរ្តិ៍ឈ្មោះ និង បំភ្លៃ ការពិត ។
គួរ បញ្ជាក់ ថា ប្រទេស រុស្ស៊ី បាន ប្រកាស តាំងតែពី ខែ មុន មក ម្ល៉េះ ថា ខ្លួន នឹង ប្រកាស ជោគជ័យ ក្នុង ការអភិវឌ្ឍ វ៉ាក់សាំង COVID-19 នៅ កំលុង ថ្ងៃទី ១០ ដល់ ទី ១២ ខែសីហា ហើយ វា ពិតជា បាន កើតឡើង មែន នៅ ថ្ងៃទី ១១ ខែសីហា នេះ តែម្តង ។ ការបោះជំហាន ដ៏ អស្ចារ្យ នេះ ពិតជា ការត្រួសត្រាយ ផ្លូវ ដ៏ សំខាន់ សម្រាប់ ការចាក់ ថ្នាំ បង្ការ មេរោគ ទ្រង់ទ្រាយ ធំ បើ ទោះបីជា ការអនុវត្ត ដំណាក់កាល ចុងក្រោយ នៃ ការសាកល្បង របស់ រុស្ស៊ី ដើម្បី សាកល្បង សុវត្ថិភាព និង ប្រសិទ្ធភាព នៅតែ បន្ត ក៏ដោយ ។
ការបង្កើន ល្បឿន អភិវឌ្ឍ វ៉ាក់សាំង របស់ រុស្ស៊ី ត្រូវបាន អន្តរជាតិ មើលឃើញ ថា ជា ការព្យាយាម យកឈ្នះ ការប្រណាំង ប្រជែង ជា លក្ខណៈ សកល ចំពោះ ការអភិវឌ្ឍ វ៉ាក់សាំង ដែល គ្រប់ ប្រទេស ត្រូវការ ជា ទីបំផុត ប៉ុន្តែ សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត អឺរ៉ុប ក៏ បាន បង្ហាញ ការព្រួយបារម្ភ ចំពោះ ប្រសិទ្ធភាព វ៉ាក់សាំង រុស្ស៊ី និង ធ្លាប់ ចោទ រុស្ស៊ី ដែរ ថា បាន ព្យាយាម លួច ទិន្នន័យ ផលិត វ៉ាក់សាំង របស់ ពួកគេ ផងដែរ ទាំង ដែល មហា អំណាច ទាំងនោះ មិន ទាន់ អាច ផលិត បាន ជោគជ័យ ផង នោះ ៕
អភិបាល ខណ្ឌ ឫស្សីកែវ បន្ត ដាក់ វិធានការ ឲ្យ មន្ត្រី បង្ក្រាប គ្រឿងញៀន និង បង្ក្រាប រាល់ ល្បែងស៊ីសង ដើម្បី ធានា សន្តិសុខ ជូន ពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ឫស្សីកែវ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ បាន បន្ត ដាក់ចេញ នូវ វិធានការ ក្ដៅ ជាថ្មី ម្ដង ទៀត លើ បញ្ហា បង្ក្រាប លុបបំបាត់ គ្រឿងញៀន និង បង្ក្រាប រាល់ ល្បែងស៊ីសង ខុស ច្បាប់ គ្រប់ ប្រភេទ ដើម្បី ធានា សន្តិសុខ ជូន ប្រជាពលរដ្ឋ ក្នុង ការបន្ត អនុវត្ត ឲ្យ មាន ប្រសិទ្ធភាព នៃ គោល នយោបាយ ភូមិ - សង្កាត់ មាន សុវត្ថិភាព របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ប្រជាពលរដ្ឋ ១២៤៨ ក្បាល ដី នៅ ខណ្ឌ ឫស្សីកែវ ទទួល ប័ណ្ណ កម្មសិទ្ធិ ស្រប តាម គោល នយោបាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ១២៤៨ ក្បាល ដី រស់ នៅ ភូមិ ទួល សំពៅ សង្កាត់ ទួល សង្កែទី១ ខណ្ឌ ឫស្សីកែវ បាន ទទួល វិញ្ញាបនប័ត្រ សម្គាល់ ម្ចាស់ អចលន វត្ថុ ( ប័ណ្ណ កម្មសិទ្ធិ ) ពី ក្រុមការងារ ការិយាល័យ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង ភូមិបាល ខណ្ឌ តំណាង លោក ជា ពិសី អភិបាល ខណ្ឌ តាម គោល នយោបាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ប្រជាពលរដ្ឋ ទាំងអស់ ពិតជា សប្បាយ ចិត្ត យ៉ាង ខ្លំាំង ក្រោយ ទទួលបាន ប័ណ្ណ កម្មសិទ្ធិ នៅ ពេល នេះ ដែល ពួកគាត់ អាច យក ទៅ ប្រើប្រាស់ បាន ជា ផ្លូវការ ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ ស មិន មាន បញ្ហា នោះ ទេ ៕
អភិបាល រង ខេត្ត កណ្ដាល ជំរុញ ឱ្យ កងកម្លាំង ថ្នាក់ មូលដ្ឋាន ខិតខំ បម្រើ សេវា ជូន ពលរដ្ឋ ក្នុង មូលដ្ឋាន ឱ្យ បាន ល្អ ប្រសើរ
លោក អភិបាល រង ខេត្ត កណ្តាល បាន ថ្លែង បន្ត ថា ការគិតគូរ ពី សុខ ទុក្ខ និង កន្លែង ធ្វើការសមរម្យ របស់ កងកម្លាំង គឺ បាន ផ្តល់ កម្លាំងចិត្ត ក្នុង ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ កាន់តែ មាន ប្រសិទ្ធភាព ជូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ។
លោក គីម រី ទ្ធី ក៏ បាន កោតសរសើរ ដល់ ការខិតខំ ប្រឹងប្រែង របស់ កម្លាំង នគរបាល ដែល បាន អនុវត្ត ការងារ បាន ល្អ ប្រសើរ នា ពេល កន្លងមក ហើយ កងកម្លាំង នគរបាល គ្រប់ ជាន់ ថ្នាក់ ពិសេស ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ត្រូវ ចូលរួម ការពារ សុខ សន្តិភាព ត្រូវ មាន ឥរិយាបថ ទន់ភ្លន់ ជាមួយ ប្រជាពលរដ្ឋ ផ្តល់ សេវា ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ទាន់ ពេលវេលា និង ត្រូវ បន្ត ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព នៅក្នុង មូលដ្ឋាន ៕
រដ្ឋមន្ត្រី ក្រសួង ការងារ ជំរុញ ឱ្យ អាជ្ញាធរ ខេត្ត កណ្ដាល ត្រូវ ដោះស្រាយ រាល់ បញ្ហា របស់ កម្មករ តាម ច្បាប់ ឱ្យ មាន ប្រសិទ្ធភាព និង ទាន់ ពេលវេលា
( កណ្ដាល ) ៖ លោក បណ្ឌិត អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ បណ្ដុះបណ្ដាល និង វិជ្ជាជីវៈ បាន ជំរុញ ឱ្យ រដ្ឋបាល ខេត្ត កណ្តាល ត្រូវ ដោះស្រាយ រាល់ បញ្ហា របស់ កម្មករ និយោជិក ឱ្យ ស្រប តាម ច្បាប់ បទ បញ្ញាតិ នានា ឱ្យ មាន ប្រសិទ្ធភាព និង ទាន់ ពេល វេលា ។
ការជំរុញ បែប នេះ របស់ លោក បណ្ឌិត អ៉ិត សំហេង បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ បទបញ្ជា លេខ ០១ បប របស់ រាជ រដ្ឋាភិបាល ស្ដីពី ការអនុវត្ត ផែនការ ដោះស្រាយ បញ្ហា កូដកម្ម បាតុកម្ម នៅ តាម មុខ សញ្ញា ឆ្នាំ ២០២០ - ២០២៤ នៅ សាលា ខេត្ត កណ្ដាល នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ ដោយ មាន ការ ដោយ មាន ការចូលរួម ពីសំណាក់ លោក ម៉ៅ ភិរុណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កណ្តាល . លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត ព្រមទាំង មន្ត្រី ពាក់ព័ន្ធ ជាង ៤០០ នាក់ ។
លោក បណ្ឌិត អ៉ិត សំហេង បាន ជំរុញ យ៉ាង ដូច្នេះ ថា៖ « ស្នើ ឱ្យ គណៈកម្មការ សម្រាប់ ដោះស្រាយ បញ្ហា កូដកម្ម បាតុកម្ម នៅ តាម គ្រប់ មុខ សញ្ញា ថ្នាក់ ខេត្ត ត្រូវ បន្ត ខិតខំ ប្រឹងប្រែង ឱ្យ អស់ ពី លទ្ធភាព ក្នុង ការដោះស្រាយ នូវ សំណូមពរ ការទាមទារ ដែល អាច ទទួលយក បាន ស្រប តាម ច្បាប់ និង បទបញ្ញតិ ជូន ប្អូន កម្មករ និយោជិត ឱ្យ បាន កាន់ ប្រសើរ » ។
ស្ថិត នៅក្នុង ឱកាស នោះ ដែរ រដ្ឋមន្ត្រី ក្រសួង ការងារ ក៏ បាន ស្នើរ ដល់ គណៈ បញ្ជាការ ឯកភាព និង គណៈកម្មការ ដោះស្រាយ បញ្ហា កូដកម្ម បាតុកម្ម ថ្នាក់ ខេត្ត ក្រុង ស្រុក - ខណ្ឌ ឃុំ - សង្កាត់ ក្នុង ខេត្ត កណ្តាល ត្រូវ មាន ផែនការអនុវត្ត ក្នុង ភូមិសាស្រ្ត របស់ ខ្លួន ឱ្យ បាន ច្បាស់លាស់ ។
បើ តាម លោក គង់ សោភ័ណ្ឌ បាន ឱ្យដឹង ថា អនុវត្ត តាម បទបញ្ជា លេខ ០១ បប ចុះ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២០ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ស្ដីពី ការអនុវត្ត ផែនការ ការដោះស្រាយ បញ្ហា កូដកម្ម បាតុកម្ម នៅ តាម គ្រប់ មុខ សញ្ញា ឆ្នាំ ២០២០ - ២០២៤ រដ្ឋបាល ខេត្ត បាន ចុះ សម្របសម្រួល និង ដោះស្រាយ បញ្ហា កូដកម្ម បាតុកម្ម ខុស ច្បាប់ នៅ តាម រោងចក្រ សហគ្រាស ជា បន្តបន្ទាប់ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ថ្មី ៗ នេះ គណៈ សម្រាប់ ដោះស្រាយ បញ្ហា កូដកម្ម បាតុកម្ម នៅ តាម គ្រប់ មុខ សញ្ញា ក្នុង ខេត្ត បាន ចុះ ទៅ សម្របសម្រួល និង ដោះស្រាយ បញ្ចប់ ករណី វិវាទ រវាង កម្មករ ចំនួន ៧២៤ នាក់ ជាមួយ រោងចក្រ « ថៃ យ៉ា ហ្គាមេន អ៊ិន ដាស ស្រ្ទី ខូអិលធីឌី » ដែល បាន បិទ ទ្វារ លែង ដំណើរ ដោយ បាន ទូទាត់ ថវិកា ជូន កម្មករ ស្រប តាម គោលការណ៍ ណែនាំ របស់ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ ។
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ នៅ ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន រៀបចំ ពិធី ផ្សព្វផ្សាយ អនុសាសន៍ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង គោលការណ៍ ណែនាំ ផ្សេង ៗ ឆ្លើយតប នឹង បរិបទ កូវីដ - ១៩ ក្នុង វិស័យ ទេសចរណ៍ អម ជាមួយ វគ្គ បណ្តុះបណ្តាល ស្តីពី « ការពង្រឹង សីលធម៌ សង្គម តម្លៃ ស្ត្រី និង គ្រួសារ ខ្មែរ » ។
ពិធី ផ្សព្វផ្សាយ នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោកស្រី ហ៊ុន ដានី រដ្ឋលេខាធិការ តំណាង ឲ្យ លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ និង មាន ការចូលរួម ពី សមាសភាព ពាក់ព័ន្ធ នៅ តាម នាយកដ្ឋាន អង្គភាព ចំណុះ ក្រសួង ទេសចរណ៍ និង មន្ទីរ ទេសចរណ៍ រាជធានី - ខេត្ត ជាច្រើន រូប ។
គោលបំណង នៃ កម្មវិធី គឺ ដើម្បីឲ្យ មន្ត្រី ក្រោម ឱវាទ ក្រសួង មាន ការយល់ដឹង បន្ថែម លើ បច្ចុប្បន្នភាព ការងារ និង យក ទៅ អនុវត្ត ឲ្យបាន ត្រឹមត្រូវ ប្រកបដោយ សង្គតិភាព និង ប្រសិទ្ធភាព ឆ្លើយតប នឹង បរិបទ កូវីដ - ១៩ ជាពិសេស បាន ស្វែងយល់ ស៉ី ជម្រៅ ពី ការយកចិត្តទុកដាក់ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ចំពោះ ស្ត្រី នៅ គ្រប់ វិស័យ ទាំងអស់ តាមរយៈ អនុសាសន៍ របស់ សម្តេច តេជោ ដែល បាន ដាក់ចេញ ជារៀងរាល់ ឆ្នាំ សម្រាប់ ក្រសួង - ស្ថាប័ន យក ទៅ អនុវត្តន៍ និង ត្រួតពិនិត្យ បន្ថែម ។
អម ជាមួយ ពិធី ផ្សព្វផ្សាយ នេះ ក្រសួង ក៏ បាន ធ្វើ ការរៀបចំ នូវ វគ្គ បណ្តុះបណ្តាល ខ្លី លើ ប្រធានបទ « ការពង្រឹង សីលធម៌ សង្គម តម្លៃ ស្ត្រី និង គ្រួសារ ខ្មែរ » ផងដែរ ដែល ផ្តោត លើ ទិដ្ឋភាព បួន សំខាន់ ៗ គឺ៖ ការគោរព ឲ្យ តម្លៃ គ្មាន ការរើសអើង គ្មាន អំពើហិង្សា និង ការជំរុញ សង្គម មួយ ដែល ទទួលស្គាល់ តម្លៃ ជា សេចក្តីថ្លៃថ្នូរ របស់ ស្ត្រី ទាំង នៅក្នុង គ្រួសារ និង ក្នុង សង្គមជាតិ ។
គួរ បញ្ជាក់ ថា « ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី ស្ត្រី » មាន ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ជា ព្រះប្រធាន កិត្តិយស និង មាន សម្តេច តេជោ ហ៊ុន សែន ជា អនុប្រធាន កិត្តិយស ។ ដោយឡែក លោកស្រី ហ៊ុន ដានី ក៏ ជា សមាជិកា នៃ ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី ស្ត្រី ដែល តំណាង ឲ្យ ក្រសួង ទេសចរណ៍ ផងដែរ ។
ចាប់តាំងពី ឆ្នាំ ២០០៦ មក ថ្នាក់ដឹកនាំ នៃ « ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី ស្រ្តី តែងតែ បើក កិច្ចប្រជុំ ជា ទៀងទាត់ រៀងរាល់ មួយ ឆ្នាំ ម្តង ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន ។
ក្នុង ឱកាស នោះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី តែងតែ ដាក់ចេញ នូវ ខ្លឹមសារ អនុសាសន៍ ជាច្រើន ដើម្បីឲ្យ គ្រប់ ក្រសួង ស្ថាប័ន យក ទៅ ពិនិត្យ និង អនុវត្ត ឲ្យបាន គ្រប់ ជ្រុងជ្រោយ ដោយ មិន មើល រំលង ពី ការចូលរួម របស់ ស្ត្រី និង បញ្ហា របស់ ស្ត្រី ឡើយ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ថ្ងៃទី ១១ ខែសីហា នេះ មាន យានយន្ត ១.៣២០ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ. រយៈពេល ១០៣ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៤៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១៣៦ .៤០៩ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១០១ .១៨៩ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៣៥. ២២០ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ១០៣ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៩ លើក ក្នុង នោះ ស្លាប់ ០២ នាក់ របួស ១០នាក់ ( របួស ធ្ងន់ ០៩ នាក់ )៕
អភិបាល រង ខេត្ត បាត់ដំបង បើក កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ នៅ ច្រក ព្រំដែន អន្តរជាតិ ដូង
( បាត់ដំបង ) ៖ លោក ណុប ដារ៉ា អភិបាល រង ខេត្ត បាត់ដំបង បាន ដឹកនាំ កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ នៅ ច្រក ព្រំដែន អន្តរជាតិ ដូង ស្រុក កំរៀង ដែល មាន ការចូលរួម ពី លោក អភិបាល រង នៃ គណៈអភិបាល ស្រុក លោក ប្រធាន និង តំណាង អង្គភាព ខ្សែ បណ្តោយ ព្រំដែន អន្តរជាតិ ដូង ស្រុក កំរៀង ។
បន្ទាប់ពី កិច្ចប្រជុំ ត្រូវបាន បញ្ចប់ លោក ណុប ដារ៉ា បាន ចុះ សួរសុខទុក្ខ បងប្អូន កងកម្លាំងប្រដាប់អាវុធ ទាំង ៣ប្រភេទ និង បាន ចុះ ពិនិត្យមើល ទីស្នាក់ការត្រួតពិនិត្យ ច្រក ស្នាក់ការ គយ និង ស្នាក់ការអន្តោប្រវេសន៍ ផងដែរ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ៖ ឧកញ៉ា យិន សុវណ្ណ នី និង លោក ជា ម៉ុង បដិសេធ ចំពោះ ព្រះសង្ឃ មួយ អង្គ នៅ ប្រទេស អូស្ត្រាលី យក ឈ្មោះ និង រូបថត ទៅ ប្រើប្រាស់ ដោយ គ្មាន ការអនុញ្ញាត
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា យិន សុវណ្ណ នី និង លោក ជា ម៉ុង ទីប្រឹក្សា សម្ដេច ក្រឡាហោម ស ខេង បាន ចេញមុខ ធ្វើ ការបដិសេធ ទៅនឹង ទង្វើ របស់ ព្រះសង្ឃ មួយ អង្គ ដែល គង់ នៅ ប្រទេស អូស្តាលី យក ឈ្មោះ និង រូបថត របស់ លោក ទៅ ប្រើប្រាស់ ដោយ គ្មាន ការអនុញ្ញាត ហើយ សូម អោយ ព្រះសង្ឃ ខាងលើ បញ្ឈប់ ការ យក ឈ្មោះ និង រូបថត របស់ លោក ទាំង ពីរ ទៅ ប្រើប្រាស់ តទៅទៀត ។
លោក ឧកញ៉ា បាន បន្ត ថា ការយក ឈ្មោះ និង រូបថត របស់ លោក ទាំង ពីរ នាក់ ទៅ ប្រើប្រាស់ ដោយ ព្រះសង្ឃ នាម ម៉ិល វ៉េង លីម ដែល គង់ នៅ ប្រទេស អូស្ត្រាលី នេះ គឺ ពួក លោក ដឹង ដោយ សារ មាន បងប្អូន ស្គាល់ គ្នា នៅ ប្រទេស អូស្ត្រាលី គេ ឃើញ ឆ្ងល់ ហើយ សួរ មក ទើប លោក មាន ការភ្ញាក់ផ្អើល ព្រោះតែ សកម្មភាព យក ឈ្មោះ និង រូបថត របស់ លោក ទៅ ប្រើប្រាស់ នេះ គឺ គ្មាន ការអនុញ្ញាត ហើយ ក្នុង រូបភាព និង សកម្មភាព មិន ត្រឹមត្រូវ ទៀតផង ។
ចុងក្រោយ លោក ឧកញ៉ា យិន សុវណ្ណ នី និង លោក ជា ម៉ុង សូម អោយ ព្រះសង្ឃ ម៉ិល វ៉េង លីម ដែល គេ ដឹង ថា កំពុង គង់ នៅ ប្រទេស អូស្ត្រាលី បញ្ឃប់ ការយក ឈ្មោះ និង រូបថត របស់ លោក ទាំង ពីរ នាក់ ទៅ ប្រើប្រាស់ ដោយ គ្មាន ការអនុញ្ញាត តទៅទៀត បើ មិន បញ្ឈប់ សកម្មភាព ទេ នឹង មាន វិធានការ តាម ផ្លូវ ច្បាប់ ។
( ភ្នំពេញ ) ៖ ការប្រែប្រួល អាកាសធាតុ គឺជា កត្តា ចម្បង ដែល នាំឲ្យ ទឹក ទន្លេ មេគង្គ ស្ថានភាព រាក់ ជាង មុន មិន មែន ដោយសារតែ ការទប់ទឹក ដើម្បី ធ្វើ វារី អគ្គិសនី របស់ ប្រទេស ចិន ឬ ប្រទេស ឡាវ ដែល នៅលើ កម្ពុជា តែ មួយ មុខ នោះ ទេ ។ នេះ បើ តាម ការលើកឡើង ពី លោក តែ ណា វុធ អនុប្រធាន អចិន្ដ្រៃយ៍ នៃ គណៈកម្មាធិការ ជាតិ ទន្លេ មេគង្គ ។
ក្នុង សន្និសីទ សារព័ត៌មាន របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ ក្រោម ប្រធានបទ « ស្ថានភាព របប ជលសាស្ដ្រ ក្នុង អាងទឹក ទន្លេ មេគង្គ និង ទន្លេ សាប នា ពេល បច្ចុប្បន្ន » លោក តែ ណា វុធ ក៏ ទទួលស្គាល់ ដែរ ថា ការទប់ទឹក ដើម្បី ធ្វើ វារី អគ្គិសនី ក៏ ជា កត្តា រួមផ្សំ ផងដែរ ប៉ុន្ដែ កត្តា ដែល ជះឥទ្ធិពល ខ្លាំង បំផុត នោះ គឺ ការប្រែប្រួល អាកាសធាតុ តែម្ដង ។
មន្ដ្រី ជំនាញ រូប នេះ បាន ពន្យល់ ថា ទំនប់ វារី អគ្គិសនី មិន បាន ប្រើប្រាស់ ទឹក ទេ ពោល គ្រាន់តែ ទប់ទឹក ឬ ស្ទាក់ ទុក ដើម្បី ផលិត ថាមពល អគ្គិសនី តែ ប៉ុណ្ណោះ ដូច្នេះ នៅ រដូវ វស្សា ទំនប់ វារី អគ្គិសនី ត្រូវ បញ្ចេញ ទឹក ខ្លះ ដែល លើស ចំណុះ ហើយ នៅ រដូវ ប្រាំង ត្រូវ បន្ថែម ទឹក វិញ ដើម្បី គ្រប់ ទៅ តាម តម្រូវការ ក្នុង ការផលិត ជា ថាមពល អគ្គិសនី ។
លោក បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ទឹក ទន្លេ មេគង្គ តិច ក៏ មាន កត្តា ចូលរួម ពី ការទប់ទឹក ធ្វើ វារី អគ្គិសនី ប៉ុន្ដែ កត្តា ប្រែប្រួល អាកាសធាតុ កត្តា អ៊ែល លីណូ ជា កត្តា ចម្បង » ។
កម្ពុជា ក្នុង នាម ជា ប្រទេស សមាជិក ទន្លេ មេគង្គ នឹង ខិតខំ បន្ដ សហការ ជាមួយ ប្រទេស ជា សមាជិក ផ្សេង ទៀត ក្នុង ការផ្លាស់ប្ដូរ ទិន្នន័យ ព័ត៌មាន គ្នា ទៅ វិញ ទៅ មក ព្រោះថា បើ គ្មាន ទិន្នន័យ គ្មាន ព័ត៌មាន មិន អាច វិភាគ ឬ វិនិច្ឆ័យ បាន នោះ ទេ ដើម្បី ធានា ដល់ ការប្រើប្រាស់ ទឹក ទន្លេ មេគង្គ រួមគ្នា ។ នេះ បើ តាម ការឲ្យដឹង ពី លោក តែ ណា វុធ ។
គួរ ជម្រាប ថា ទន្លេ មេគង្គ មាន ប្រវែង ប្រហែល៥.០០០ គីឡូម៉ែត្រ ដែល ឆ្លងកាត់ ប្រទេស ចំនួន ៦គឺ ប្រទេស ចិន ភូមា ថៃ ឡាវ កម្ពុជា វៀតណាម និង ហូរ ចាក់ ចូល ក្នុង សមុទ្រ ចិន ខាងត្បូង ។ ទន្លេ មេគង្គ ជា សរសៃ ឈាម របស់ ប្រទេស កម្ពុជា ទន្លេ នេះ ហូរ កាត់ ខេត្ត ដូចជា ខេត្ត ស្ទឹងត្រែង ក្រចេះ កំពង់ចាម រាជធានី ភ្នំពេញ និង ព្រៃវែង ហើយ បាន បញ្ចប់ នៅ ព្រំប្រទល់ វៀតណាម ។
លោក ចាន់ យុត្ថា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ឲ្យដឹង ថា ទន្លេ មេគង្គ គឺ មាន សារសំខាន់ ខ្លាំង ណាស់ សម្រាប់ ប្រទេស កម្ពុជា ពិសេស ទឹក សម្រាប់ បម្រើ ឲ្យ វិស័យ កសិកម្ម ។
លោក ថា ប្រព័ន្ធ ធារា សាស្ដ្រ វ៉ៃ កូ ដែល លាតសន្ធឹង ពី ខេត្ត ត្បូងឃ្មុំ កំពង់ចាម ព្រៃវែង និង ស្វាយរៀង ជា គម្រោង មួយ ដ៏ ធំ របស់ កម្ពុជា ដែល គ្របដណ្ដប់ លើ ផ្ទៃដី ប្រមាណ ៣០ម៉ឺន ហិចតា ដូច្នេះ ដើម្បីឲ្យ គម្រោង នេះ មាន សក្ដានុពល ទាំង រដូវ ប្រាំង និង រដូវ វស្សា គឺ ត្រូវ ទាញ ទឹក ពី ទន្លេ មេគង្គ តាមរយៈ ទន្លេ តូច រួច បន្ដ ចែកចាយ ទៅ តាម ប្រឡាយ ។
បើ តាម អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក នៅពេល រដូវ វស្សា មកដល់ ប្រសិនបើ ទឹក នៅ ស្ថានីយ៍ កំពង់ចាម ឡើង ប្រហែល១០ម៉ែត្រ ទឹក ហូរ ចូលទៅ ព្រែក វ៉ៃ កូ ដោយ ស្វ័យប្រវត្តិ ប៉ុន្ដែ នៅ រដូវ ប្រាំង គឺ ត្រូវ ប្រើ ស្ថានីយ៍ បូម ទឹក ។ នេះ ជា អ្វី ដែល កម្ពុជា នឹង ទាញយក អត្ថប្រយោជន៍ ពី ទន្លេ មេគង្គ នា ពេល ខាងមុខ ។
លោក ចាន់ យុត្ថា ក៏ បាន មិន ភ្លេច ប្រាប់ ដែរ ថា អ្វី ដែល កម្ពុជា ទទួលបាន ពី ទន្លេ មេគង្គ នា ពេល កន្លងមក គឺ នៅពេល មាន ទឹក ជំនន់ ទន្លេ មេគង្គ ឡើង ខ្លាំង នឹង ចាក់ ចូល បំពេញ បន្ថែម ទៅ ទន្លេ សាប ប្រមាណ ៤០ ភាគរយ ។ ពេល នោះ ហើយ ធ្វើឲ្យ បឹង ទន្លេ សាប រីក ធំ ហើយ ពេល បឹង ទន្លេ សាប រីក ធំ នឹង នាំឲ្យ លិច ព្រៃ លិច ទឹក នៅ ជុំវិញ នោះ ធ្វើឲ្យ វារី រុក្ខជាតិ មួយចំនួន ក្លាយជា ចំណី របស់ ត្រី ។
មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង ធនធាន ទឹក ក៏ បាន បន្ថែម ទៀត ថា ជំនន់ ទឹក ទន្លេ មេគង្គ នេះ ទៀតសោត ក៏ បាន នាំមក នូវ ដី ល្បាប់ ដែល ជា ដី មាន ជីជាតិ សម្រាប់ ការបង្កបង្កើន ផល របស់ ប្រជាកសិករ ផងដែរ ។ ក្រៅពី នេះ ជំនន់ ទន្លេ មេគង្គ ក៏ សម្លាប់ បាន នូវ សត្វ ល្អិត ចង្រៃ ជាច្រើន ផ្សេង ទៀត ផងដែរ ដែល រំខាន ដល់ កសិករ ។
អត្ថប្រយោជន៍ មួយ ទៀត ដែល កម្ពុជា បាន ទាញយក ពី ទឹក ទន្លេ មេគង្គ គឺ ការស្ទាក់ ទឹក ដើម្បី បំពេញ ទៅ តាម ស្ទឹង បឹង សម្រាប់ បម្រើ ឲ្យ ការបង្កបង្កើន ផល របស់ ប្រជាកសិករ នៅពេល រដូវ សម្រក ៕ ខ្មែរ ប៊ែ វើរី ជីស ផ្តល់ ធុង សំរាម ១០០ ធុង ដល់ សាលារៀន ចំនួន ១១ ក្នុង ខណ្ឌ ដង្កោ
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន បន្ដ ឧបត្ថម្ភ ធុង សំរាម ចំនួន ១០០ ធុង បន្ថែម ដល់ សាលា បឋមសិក្សា ចំនួន ១១ផ្សេង ទៀត ក្នុង ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ កាលពី ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ ដើម្បី លើកកម្ពស់ អនាម័យ បរិស្ថាន សាលារៀន ។
នាយក ទំនាក់ទំនង សាធារណៈ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស លោក បណ្ឌិត អ៊ឹម សុធារិទ្ធ មានប្រសាសន៍ ថា ការបន្ថែម ចំនួន ធុង សំរាម ដើម្បី ផ្ដល់ ទៅ សាលា បឋមសិក្សា ១១ផ្សេង ទៀត នេះ គឺជា ការខិតខំ ប្រឹងប្រែង ចូលរួម របស់ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ជាមួយ សាលា ខណ្ឌ ដង្កោ សហគមន៍ និង សាលារៀន ក្នុង ការបណ្ដុះ ទម្លាប់ អនាម័យ ស្អាត របស់ សិស្សានុសិស្ស តាម សាលា បឋមសិក្សា ដើម្បី ឆ្ពោះទៅ សម្រេច នូវ ទស្សនវិស័យ បរិស្ថាន សហគមន៍ ស្អាត ។
កាល ថ្ងៃទី ៦សីហា ឆ្នាំ ២០២០ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ទើប បាន ប្រគល់ ធុង សំរាម ចំនួន ១៣០ ធុង ដល់ សាលា បឋមសិក្សា ចំនួន ១២ ក្នុង ខណ្ឌ ដង្កោ ដើម្បី ទុកដាក់ សំរាម ឲ្យ មាន របៀបរៀបរយ ។
ធុង សំរាម ចំនួន ១០០ ធុង ត្រូវបាន ដាក់ពង្រាយ នៅក្នុង សាលា បឋមសិក្សា ឫស្សី សាញ់ សាលា បឋមសិក្សា ព្រៃសរ សាលា បឋមសិក្សា ទួលរកាកុះ សាលា បឋមសិក្សា ត្រពាំង សាលា សាលា បឋមសិក្សា សម្តេច ហ៊ុន សែន ព្រៃវែង សាលា បឋមសិក្សា ទួល សំបូរ សាលា បឋមសិក្សា កំពង់ក្តុល សាលា បឋមសិក្សា ហ៊ុន សែន សាក់ សំពៅ សាលា បឋមសិក្សា ក្រាំង ពង្រ សាលា បឋមសិក្សា ពង ទឹក និង សាលា បឋមសិក្សា ស្រែញរ៍ ៕ អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក៖ ទឹក ជំនន់ បី តំបន់ ដែល គំរាមកំហែង រាជធានី ភ្នំពេញ (Video inside)
( ភ្នំពេញ ) ៖ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម លោក ចាន់ យុត្ថា បាន ឲ្យដឹង ថា ទឹក ជំនន់ មកពី ៣ តំបន់ ដែល តែង គំរាមកំហែង រាជធានី ភ្នំពេញ ។ ទឹក មកពី ៣ តំបន់ នោះ គឺ ជំនន់ ទន្លេ មេគង្គ . ជំនន់ ស្ទឹង ព្រែក ត្នោត និង ជំនន់ ទឹកភ្លៀង ដែល ធ្លាក់ យ៉ាង គំហុក ចំផ្ទៃ រង ទឹកភ្លៀង របស់ រាជធានី ភ្នំពេញ ។
ក្នុង សន្និសីទ សារព័ត៌មាន របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ស្ដីពី « ស្ថានភាព របប ជលសាស្ដ្រ ក្នុង អាងទឹក ទន្លេ មេគង្គ និង ទន្លេ សាប នា ពេល បច្ចុប្បន្ន » នៅ ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ លោក ចាន់ យុត្ថា បាន អះអាង ថា រហូតមកដល់ ពេលនេះ ជំនន់ ទឹក ទន្លេ មេគង្គ លែង បង្ក ជា ហានិភ័យ ទៀត ហើយ ដោយសារតែ បាន របាំង ការពារ យ៉ាង រឹងមាំ គឺ ទំនប់ កប់ ស្រូវ ។
លោក ចាន់ យុត្ថា បាន បន្ថែម ទៀត ថា ជំនន់ ស្ទឹង ព្រែក ត្នោត ក៏ ប្រឈម ដូចគ្នា ផងដែរ ដោយសារតែ ការគោក រាក់ និង មាត់ ស្ទឹង នៅ ខាងក្រោម រួម តូច ។ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម កំពុង សិក្សា ដើម្បី ដោះស្រាយ បញ្ហា នេះ តាមរយៈ ការស្ដារ ឡើងវិញ ដោយ មាន ការវិនិយោគ របស់ ក្រុមហ៊ុន ចិន ត្រៀម នឹង ចាប់ផ្ដើម អនុវត្ដ នៅ ដើម ឆ្នាំ ក្រោយ ។
សម្រាប់ ឥទ្ធិពល ទឹកភ្លៀង វិញ ទាមទារ ឲ្យ មាន ការសិក្សា មួយ ច្បាស់លាស់ ធ្វើ យ៉ាងណា ពង្រីក ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ រំដោះ ទឹក ឲ្យបាន ល្អ ជៀសវាង ការកកស្ទះ ។ លោក បន្ដ ថា ប្រព័ន្ធ រំដោះ ទឹក នេះ ធ្វើ យ៉ាងណា ពេល មាន ភ្លៀង ត្រូវ ស្រូបយក ទឹក ឲ្យបាន លឿន ។ នេះ ជា ការឲ្យដឹង ពី លោក ចាន់ យុត្ថា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ធនធាន ទឹក ។
លោក ចាន់ យុត្ថា បាន ពន្យល់ ថា សម្រាប់ ប្រព័ន្ធ រំដោះ ទឹក នៅ រាជធានី ភ្នំពេញ នេះ ទៀតសោត មិន អាច សាងសង់ ស្ថានីយ៍ បូម ទឹក នៅ មាត់ ប្រឡាយ បាន នោះ ទេ ពោល ត្រូវ សាងសង់ អាង ស្ដុក ទឹក មួយ ដូច នៅ ស្ថានីយ៍ បឹងត្របែក ជាដើម ដើម្បី អាច ឲ្យ ទឹក ហូរ លឿន រំដោះ ពី ការជន់ លិច ដោយ ជំនន់ ទឹកភ្លៀង ដែល ធ្លាក់ យ៉ាង គំហុក ជាច្រើន ម៉ោង ។
ជា រួម អ្នកនាំពាក្យ ចាន់ យុត្ថា បាន អះអាង ថា ការគំរាមកំហែង ២ តំបន់ ត្រូវបាន ដោះស្រាយ ហើយ ឈាន ទៅនឹង បញ្ចប់ នា ពេល ឆាប់ ៗ ខាងមុខ ខណៈ ការគំរាមកំហែង ដោយ ជំនន់ ទឹកភ្លៀង ស្ថាប័ន ពាក់ព័ន្ធ និង រដ្ឋបាល រាជធានី ភ្នំពេញ កំពុង រួមគ្នា ដើម្បី ដោះស្រាយ ជា បន្ដ បន្ទាប់ ផងដែរ ។
ជា ការកត់សម្គាល់ នៅពេល មាន ភ្លៀង ខ្លាំង ម្ដង ៗ តំបន់ មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ ពិសេស តំបន់ ផ្សារ ដើម គរ គឺ តែងតែ ជន់ លិច យ៉ាង ខ្លាំង ប៉ុន្ដែ រយៈពេល ប៉ុន្មាន ម៉ោង ក្រោយ ក៏ ហូរ អស់ ទៅ វិញ ដោយសារ បច្ចុប្បន្ន រដ្ឋបាល រាជធានី ភ្នំពេញ បាន រៀបចំ និង ស្ដារ ឡើងវិញ នូវ ប្រព័ន្ធ រំដោះ ទឹក តាមរយៈ ការរៀបចំ ផ្លាស់ប្ដូរ លូ ដែល មាន មុខកាត់ ធំ ជាង មុន ជាដើម ៕
ធនាគារ ហ្វីលីព ប្រកាស ដាក់ ឲ្យ ប្រើប្រាស់ ម៉ាស្ទ័ កាត ជា ផ្លូវការ ជូន ដល់ អតិថិជន
លោក ចាន់ ម៉ាច អគ្គ នាយក ធនាគារ ហ្វីលីព បាន ថ្លែង ថា « ថ្ងៃ នេះ យើង មាន សេចក្តី សោមនស្ស រីករាយ ក្នុង ការដាក់ ឲ្យ ប្រើប្រាស់ កាត និម្មិត ឥណ ពន្ធ ម៉ាស្ទ័ កាត របស់ ធនាគារ ហ្វីលីព ដោយ យើង សង្ឃឹម ថា អាច ជម្រុញ និង ពង្រឹង ប្រព័ន្ធ ពាណិជ្ជកម្ម អេឡិចត្រូនិក នៅ កម្ពុជា ។ ទំហំ អាជីវកម្ម ដែល បាន កំពុង ធ្វើ ប្រតិបត្តិការ តាមរយៈ ប្រព័ន្ធ ពាណិជ្ជកម្ម អេឡិចត្រូនិក បាន កំពុងតែ រីកលូតលាស់ យ៉ាង ឆាប់រហ័ស ហើយ យើង មាន បំណង ចូលរួមចំណែក បន្ថែម ទៀត ក្នុង ដំណើរ លូតលាស់ នេះ » ។
លោក បន្ដ ថា « យើង មើលឃើញ ថា ពាណិជ្ជកម្ម អេឡិចត្រូនិច គឺជា គោលដៅ ថ្មី សម្រាប់ ការធ្វើ អាជីវកម្ម ហើយ យើង ចង់ ក្លាយជា ផ្នែក មួយ នៃ វិស័យ នេះ តាំងពី ដំបូង ដៃ ។ យើង សូម ថ្លែងអំណរគុណ ចំពោះ ក្រុមហ៊ុន ម៉ាស្ទ័រ កាត ដែល បាន ធ្វើជា ដៃគូ ក្នុង គម្រោង នេះ ហើយ យើង មាន ជំនឿចិត្ត ថា តាមរយៈ កិច្ចសហការ នេះ យើង អាច នាំយក ជម្រើស ដ៏ សំបូរ បែប ដើម្បី ជីវភាពទាន់សម័យ ជូន ដល់ អតិថិជន យើង » ។
លោកស្រី Wong បាន ឱ្យដឹង ថា « ប្រជាពលរដ្ឋ និង អាជីវកម្ម នៅ កម្ពុជា កំពុងតែ មាន ទំនោរ ផ្តោត ខ្លាំង ទៅ រក ផលិតផល ឌីជីថល ថ្មី ៗ ចុងក្រោយ ដូចជា កាត និម្មិត ឥណ ពន្ធ ម៉ាស្ទ័រ កាត ជាដើម ។ កាត និម្មិត ឥណ ពន្ធ ម៉ាស្ទ័រ កាត របស់ ធនាគារ ហ្វីលីព គឺជា ការចាប់ផ្តើម ជំហាន ដំបូង របស់ ធនាគារ ទៅ ក្នុង វិស័យ ទូទាត់ តាម កាត អេឡិចត្រូនិច ហើយ ក៏ ជា កិច្ចការ ដំបូង ក្នុង ភាពជាដៃគូ របស់ ម៉ាស្ទ័រ កាត ជាមួយនឹង ធនាគារ ហ្វីលីព ផងដែរ » ។
ពូជ ឫស្សី ទំពាំង ផ្អែម និង សម្ភារ គាំទ្រ ដល់ ផលិតកម្ម ឫស្សី ទំពាំង ផ្អែម ត្រូវបាន ប្រគល់ ជូន ប្រជា សហគមន៍ ព្រៃឈើ នៅ ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ ក្នុង ទិសដៅ លើកកម្ពស់ ជីវភាព ប្រជា សហគមន៍ ព្រៃឈើ ក្នុង ខេត្ត ព្រះវិហារ ឱ្យ កាន់តែ ប្រសើរឡើង ថែម ទៀត មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ បាន នាំ ពូជ ឫស្សី ទំពាំង ផ្អែម និង សម្ភារ គាំទ្រ ដល់ ផលិតកម្ម ឫស្សី ទំពាំង ផ្អែម ប្រគល់ ជូន សហគមន៍ ព្រៃឈើ ចំនួន ៣ នៅក្នុង ខេត្ត រួម មាន សហគមន៍ ព្រៃឈើ ក្រសាំង . សហគមន៍ ព្រៃឈើ ឆែប លិច និង សហគមន៍ ព្រៃឈើ សាមគ្គី ត្រពាំង ទន្ទឹម ។
ពិធី ប្រគល់ ទទួល នេះ ធ្វើឡើង នៅ ថ្ងៃទី ១០ ខែសីហា ឆ្នាំ ២០២០ ក្រោម វត្តមាន លោក ពឹង ទ្រី ដា ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ ដោយ មាន ការ ចូលរួម ពី មន្ត្រី ខណ្ឌ រដ្ឋបាល ព្រៃឈើ ទីប្រឹក្សា កម្មវិធី ASPIRE សហការ ជាមួយ មន្ត្រី ការិយាល យ័កសិកម្ម ធនធាន ធម្មជាតិ និង បរិស្ថាន ស្រុក ឆែប ក៏ ដូចជា ប្រជា សហគមន៍ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក ពឹង ទ្រី ដា បាន ថ្លែង ថា ក្នុង ឆ្នាំ ២០២០ នេះ កម្មវិធី ផ្សព្វផ្សាយ បច្ចេកទេស ថ្មី ដែល មាន ភាពធន នឹង ការប្រែប្រួល អាកាសធាតុ (ASPIRE) នៃ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ បាន ផ្តល់ ពូជ ឫស្សី ទំពាំង ផ្អែម និង សម្ភារ គាំទ្រ ដល់ ការផលិត ដល់ សហគមន៍ ព្រៃឈើ ដើម្បី ដាំដុះ ដំណាំ ឫស្សី ទំពាំង ផ្អែម ដោយ សហគមន៍ នីមួយ ៗ ទទួលបាន ស្រះ ទឹក មួយ កូន ឫស្សី ទំពាំង ផ្អែម ៧០០ កូន រទេះ រុញ១ ម៉ាស៊ីម បូម ទឹក១ និង ជញ្ជីង ថ្លឹង មួយ ។
