ក្រុមប្រឹក្សា ជាតិ ភាសា ខ្មែរ ស្វែងរក ការឯកភាព ក្នុង ការសរសេរ អក្សរ ឡាតាំង ឈ្មោះ ខេត្ត និង ទីតាំង នានា
( ភ្នំពេញ ) ៖ ក្រុមប្រឹក្សា ជាតិ ភាសា ខ្មែរ បាន រៀបចំ កិច្ចពិភាក្សា តុ មូល ស្តីពី « បទពិសោធន៍ និង បញ្ហា គោលការណ៍ ក្នុង ការប្រើប្រាស់ អក្សរ ឡាតាំង សម្រាប់ កត់ សូរ ភាសា ខ្មែរ ករណី អសាធារ នាម » ក្នុង បំណង ស្វែងរក ការឯកភាព គ្នា ក្នុង ការសរសេរ អក្សរ ឡាតាំង លើ ឈ្មោះ ខេត្ត និង ទីតាំង សាធារណៈ នានា ។
កិច្ចពិភាក្សា តុ មូល នេះ បាន ធ្វើឡើង ក្រោម អធិបតិភាព លោក បណ្ឌិត ហ៊ាន សុខុម ប្រធាន ក្រុមប្រឹក្សា ជាតិ ភាសា ខ្មែរ នា ព្រឹក ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២០ នេះ នៅ រាជ បណ្ឌិត្យ សភា កម្ពុជា ដោយ មាន ការចូលរួម ពី វា គ្មិន មក ពី ក្រសួង ពាក់ព័ន្ធ ក្រសួង អប់រំ . ក្រសួង ផែនការ និង ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ រួមទាំង មន្រ្តី ស្រាវជ្រាវ និង និស្សិត យ៉ាង ច្រើន ផងដែរ ។
លោក បណ្ឌិត ហ៊ាន សុខុម បាន ថ្លែ ថា ក្នុង សម័យ សកល ភាវូបនីយកម្ម ការប្រើប្រាស់ អក្សរ ឡាតាំង សម្រាប់ សរសេរ អសាធារណនាម ខ្មែរ មាន ភាពចាំបាច់ ។ ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ ការប្រើប្រាស់ ឈ្មោះ ជា អក្សរ ឡាតាំង ក៏ ចាំបាច់ ណាស់ ដែរ ក្នុង ការធ្វើ លិខិត អត្រានុកូលដ្ឋាន លិខិត ឆ្លង ដែន ជាដើម ។ ម្យ៉ាងទៀត តម្រូវការ សរសេរ ឈ្មោះ ខេត្ត ស្រុក ឃុំ ភូមិ ផ្លូវ ទីកន្លែង ប្រាសាទ ឧទ្យាន ជា អក្សរ ឡាតាំង ក៏ មាន ភាពចាំបាច់ ដូចគ្នា ។
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន ចេញ លិខិត មួយ ជម្រាប ជូន ដល់ អភិបាល រាជធានី - ខេត្ត ទាំងអស់ ឱ្យ ណែនាំ ដល់ មន្ទីរ សុខាភិបាល នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ឱ្យ យកចិត្តទុកដាក់ បន្ថែម ទៀត ក្នុង ការជួយសង្គ្រោះ ពិនិត្យ ថែទាំ ព្យាបាល ជំងឺ កូវីដ - ១៩ គ្រោះថ្នាក់ ចរាចរណ៍ និង ហានិភ័យ ផ្សេង ៗ ។
ក្នុង លិខិត របស់ លោក ម៉ម ប៊ុន ហេង បាន បញ្ជាក់ ថា សេចក្ដី ដូច មាន ចែង ក្នុង កម្មវត្ថុ ខាងលើ ក្រសួង សុខាភិបាល សូម ជម្រាប ជូន អភិបាល នៃ គណៈអភិបាល រាជធានី - ខេត្ត ជ្រាប ថា ក្រសួង សុខាភិបាល សូម កោតសរសើរ ដោយ ស្មោះ ដល់ ក្រុម គ្រូពេទ្យ នៅ ទូទាំង ប្រទេស ដែល បាន ខិតខំ យកចិត្តទុកដាក់ ក្នុង ការជួយសង្គ្រោះ ពិនិត្យ ថែទាំ និង ព្យាបាល ជំងឺ នៅ តាម មូលដ្ឋា សុខាភិបាល សាធារណៈ ជាពិសេស ចាប់តាំងពី ដើម ឆ្នាំ ២០២០ នៃ ការរាតត្បាត វីរុស កូវីដ - ១៩ នៅក្នុង ប្រទេស ក្នុង តំបន់ និង នៅលើ សកលលោក ។
លោក រដ្ឋមន្រ្តី បាន បន្ថែម ថា ក្នុង អំឡុង ពេល ឈប់ សម្រាក ចំនួន ០៥ ថ្ងៃ ដើម្បី សង ថ្ងៃ ឈប់សម្រាក ការងារ បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ជាតិ ក្រសួង សុខាភិបាល សូម ឯកឧត្តម លោកជំទាវ អភិបាល នៃ គណៈអភិបាល រាជធានី - ខេត្ត ណែនាំ ដល់ មន្ទីរ សុខាភិ បាល រាជធានី - ខេត្ត ធ្វើការ យកចិត្តទុកដាក់ បន្ថែម ទៀត ក្នុង ការជួយសង្គ្រោះ ពិនិត្យ ថែទាំ ព្យាបាល ជំងឺ កូវីដ - ១៩ គ្រោះថ្នាក់ ចរាចរណ៍ និង ហានិភ័យ ផ្សេង ៗ ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នា ថ្មី ៗ នេះ បាន អនុញ្ញាតឱ្យ មន្រ្តី រាជការ កម្មករ និយោជិត ឈប់ សម្រាក រយៈពេល ៥ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៧ ដល់ ២១ ខែសីហា ខាងមុខ នេះ ដើម្បី ជា ការប៉ះ ប៉ូវ ចំពោះ ការ មិន អនុញ្ញាតឱ្យ ឈប់ សម្រាក កាលពី អំឡុង ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ កន្លងទៅ ដែល ពេល នោះ ជា ការចាត់ វិធានការ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ៕
ខាងក្រោម នេះ ជា លិខិត របស់ លោក រដ្ឋមន្រ្តី ម៉ម ប៊ុន ហេង៖
ទេសរដ្ឋមន្ត្រី លី ធុជ ជំរុញ ភាគី ពាក់ព័ន្ធ វិស័យ មីន ត្រូវ រៀបចំ ការវាយតម្លៃ ផែនការ សកម្មភាព មីន ៣ ឆ្នាំ នៃ ការអនុវត្ត ផែនការ យុទ្ធសាស្ត្រ ជាតិ សកម្មភាព មីន ២០១៨ - ២០២៥
លោក ទេសរដ្ឋមន្រ្តី បាន លើកឡើង ថា បច្ចុប្បន្ន នេះ វិស័យ សកម្មភាព មីន នៅ កម្ពុជា បាន នាំមក នូវ បដិវត្តន៍ និង ស្វ័យប្រតិកម្ម មួយ យ៉ាង សំខាន់ តាមរយៈ ការប្រើប្រាស់ បច្ចេកវិទ្យា ព័ត៌មាន ទំនើប ។
លោក ទេសរដ្ឋមន្ត្រី បាន បន្ត ទៀត ថា តាមរយៈ ការប្រើប្រាស់ ប្រព័ន្ធ ថ្មី នេះ នឹង ផ្តល់ ភាពងាយស្រួល ក្នុង ការតាមដាន ការអនុវត្ត ផែនការបោសសម្អាត របស់ ម៉ាពូ រាជធានី - ខេត្ត តាមរយៈ អនឡាញ ហើយក៏ អាច អនុញ្ញាតអោយ ម៉ាពូ ផ្ទុក ទិន្នន័យ និង ឆែកមើល ទិន្នន័យ ក្នុង ខេត្ត របស់ ខ្លួន បាន យ៉ាង ងាយស្រួល ។
ដើម្បី ជួយ ជំរុញ អោយ ស្ថាប័ន អាច ដើរ ទាន់ ការវិវត្ត បច្ចេកវិទ្យា ទំនើប ដូច ប្រទេស ក្នុង តំបន់ លោក ទេសរដ្ឋមន្រ្តី បាន ផ្តល់ ការណែនាំ ដល់ វគ្គ បណ្ដុះបណ្ដាល ទាំងមូល ដូច ខាងក្រោម៖
* ទី១៖ ម៉ាពូ ត្រូវ បន្ត សិក្សា ស្វែងយល់ ពី បច្ចេកវិទ្យា ថ្មី ៗ ដែល អាច ជំរុញ ប្រសិទ្ធភាព ការងារ បាន ល្អ ប្រសើរ ជាង មុន *ទី ២៖ ម៉ាពូ ត្រូវ ប្រើប្រាស់ ប្រព័ន្ធ នេះ ដើម្បី សាកល្បង ការគ្រប់គ្រង ទិន្នន័យ នៃ ការរៀបចំ ផែនការ ក្នុង ខេត្ត រៀង ខ្លួន *ទី ៣៖ ម៉ាពូ ត្រូវ ចុះ អង្កេត ចម្ការ មីន អោយ ដល់ ទីតាំង ចម្ការ មីន និង បំពេញ ទម្រង់ ក្នុង Tablet* ទី ៤៖ អាជ្ញាធរ មីន ត្រូវ បន្ត ចុះ គាំទ្រ បច្ចេកទេស បន្ថែម និង រៀបចំ ឲ្យ មាន វគ្គ បណ្តុះបណ្តាល រំលឹក ដើម្បី ពង្រឹង ដល់ ការប្រើប្រាស់ សម្រាប់ មន្ត្រី ម៉ាពូ ។
លោក ទេសរដ្ឋមន្ត្រី បាន បញ្ជាក់ បន្ថែម ថា រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដាក់ ចេញ ចក្ខុវិស័យ និង ផែនការ យុទ្ធសាស្ត្រ ច្បាស់លាស់ ក្នុង ការបញ្ចប់ ការគំរាមកំហែង ដោយសារ មីន ឲ្យ អស់ ត្រឹម ឆ្នាំ ២០២៥ ។
