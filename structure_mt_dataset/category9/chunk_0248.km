( ព្រៃវែង ) ៖ ក្រុមការងារ ចុះ ជួយ ឃុំ គោក គង់ លិច ដឹកនាំ ដោយ លោក ជុំ សាវុឌ្ឍ ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ គោក គង់ លិច និង លោក ឧកញ៉ា សំ ប៊ន តំណាង លោក យឹម លាង អគ្គ ស្នងការ រង នគរបាល ជាតិ ព្រមទាំង ក្រុមការងារ ចុះ ជួយ ភូមិ បាន ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ នៅ ឃុំ គោ គ គង់ លិច ស្រុក កញ្ជ្រៀច ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
វិធី នេះ មាន ការចូលរួម ពី គណៈកម្មាធិការ បក្ស ឃុំ សាខា បក្ស ភូមិ ក្នុង កិច្ចប្រជុំ ពង្រឹង ការងារ បក្ស មូលដ្ឋាន ចំនួន ២០០ នាក់ ។
លោក ជុំ សាវុឌ្ឍ បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី លោក នេត សាវឿន ប្រធាន ក្រុមការងារ ស្រុក ស្វាយអន្ទរ និង ស្រុក កញ្រ្ជៀច ជូន ចំពោះ សមាជិក សមាជិការបក្ស ដែល បាន ចូលរួម ទាំងអស់ និង បាន ណែនាំ សមាជិក បក្ស ទាំងអស់ ឲ្យ ខិតខំ បន្ថែម ទៀត នូវ ការអនុវត្ត គោលការណ៍ សំខាន់ ៗ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដោយ បំរើ ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ពិសេស ត្រូវ ចូលរួម ជួយ ផ្សព្វផ្សាយ នូវ ច្បាប់ ចរាចរ ណ៏ ផ្លូវគោក និង រួមគ្នា បង្កា ទប់ស្កាត់ ជម្ងឺ កូវីដ១៩ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
លោក ប្រធាន ក្រុមការងារ ដែល តំណាង លោក យឹម លាង បាន នាំយក នូវ ថវិកា គ្រឿង ឧបភោគ បរិភោគ ថ្នាំ ពេទ្រ សាប៊ូ និង ជែល ផ្តល់ ជូន សមាជិក ដែល បាន ចូលរួម និង គ្រួសារ ក្រីក្រ រួម មាន សមាជិក ចូលរួមចំនួន ១២៥ នាក់ ម្នាក់ ៗ ជូន រួម មាន៖
មុខរបរ ចិញ្ចឹម មាន់ ស្រែ កំពុង ត្រូវ ប៉ាន់ នៅ ស្រុក ខ្សាច់ កណ្ដាល ខេត្ត កណ្ដាល . មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង កសិកម្ម និង អភិបាល ខេត្ត ជំរុញ ឱ្យ កសិករ បង្កើន ការចិញ្ចឹម មាន់ ស្រែ ឱ្យ កាន់តែ ច្រើន ឡើង
( កណ្ដាល ) ៖ បណ្ដុំ អាជីវកម្ម កសិកម្ម ត្រូវបាន បង្កើតឡើង មាន ចំនួន ៤ប្រភេទ ក្នុង ចំណោម ៨ឃុំ មាន ២៤ប ណ្ដុំ កសិករ ចូលរួម សរុប ៧៦១ គ្រួសារ ក្នុង នោះ មុខរបរ កសិកម្ម ជាច្រើន ត្រូវបាន មើលឃើញ ថា កសិករ កំពុង មមាញឹក ក្នុង ការដាំដុះ និង ចិញ្ចឹម សត្វ ជាដើម ខណៈ មុខរបរ ដែល លេចធ្លោ ជាង គេ ប្រចាំ ស្រុក ខ្សាច់ កណ្ដាល គឺ មុខរបរ « ចិញ្ចឹម មាន់ ស្រែ » ។
មុខរបរ មួយ នេះ ត្រូវបាន មន្ត្រី ជំនាញ កសិកម្ម ស្រុក លើកឡើង ថា កសិករ ស្រុក នេះ មាន ចំណាប់ ជាង គេ ក្នុង ចំណោម មុខរបរ ផ្សេង ទៀត ដ្បិត ការចិញ្ចឹម មាន់ ស្រែ កំពុង វាយលុក ទីផ្សារ ខណៈ តម្រូវការ មាន ការកើនឡើង ។
មន្ត្រី ជំនាញ កសិកម្ម ស្រុក ខ្សាច់ កណ្ដាល ថ្លែង បែប នេះ នៅ ចំពោះ មុខ រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រម៉ាញ់ និង នេសាទ លោក ហួត ប៊ុន ណារី និង ចំពោះ មុខ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល ព្រមទាំង មន្ត្រី អ្នកមុខអ្នក ការ ជាច្រើន នាក់ ផ្សេង ទៀត ក្នុង ដំណើរ ធ្វើ ទស្សនកិច្ច ជំរុញ ផលិតកម្ម កសិកម្ម នៅ ឃុំ សន្លុង និង ឃុំ ជ័យ ធំ ស្រុក ខ្សាច់ កណ្តាល នា ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
លោក ហួត ប៊ុន ណារី បាន ថ្លែង កោតសរសើរ ដល់ កសិករ ទាំងឡាយ ដែល បាន និង កំពុង ខិតខំ កសាង បណ្ដុំ អាជីវកម្ម កសិកម្ម នេះ ឡើង ដើម្បី ជា ប្រយោជន៍ ដល់ កសិករ ទាំងអស់ ក្នុង ការផ្លាស់ប្ដូរ បទពិធន៍ និង ជួយ គ្នា ក្នុង ការបង្កើន ផលិតកម្ម កសិកផល ឲ្យបាន ច្រើន តាម ដែក ធ្វើ ទៅ បាន ។
ទន្ទឹមនឹង សារ នេះ លោក គង់ សោភ័ណ្ឌ បាន គាំទ្រ លើកទឹកចិត្ត ជំរុញ បន្ថែម ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដើម្បី យកចិត្តទុកដាក់ លើ វិស័យ កសិកម្ម ឲ្យ មាន ការ រូក ចំរើន ឡើង និង ជួយ គាំទ្រ បន្ថែម លើ ជំនាញ ចិញ្ចឹម មាន់ ស្រែ ពនរោះ មុខរបរ នេះ បាន និង កំពុង មាន សន្ទុះ កើនឡើង និង មាន តម្រូវការ ទៅ ផ្សារ ផងដែរ ។
រដ្ឋមន្ត្រី ស៊ុយ សែម ទទូច ឲ្យ មន្រ្តី បន្ត ផ្សព្វផ្សាយ ជា ប្រចាំ ពី វិធានការ បង្ការ និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩
( ពោធិ៍សាត់ )៖ លោក ស៊ុយ សែម រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២០ បាន អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ និង បញ្ហា ប្រឈម សម្រាប់ ឆមាស ទី១ ឆ្នាំ ២០២០ និង ទិសដៅ ការងារ ឆមាស ទី២ ឆ្នាំ ២០២០ របស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ ។
កិច្ចប្រជុំ ត្រូវបាន ធ្វើឡើង នៅ ស្នាក់ការ គណបក្ស ខេត្ត ស្ថិត ក្នុង ភូមិ សាលា គំរូ សង្កាត់ ព្រៃ ញី ក្រុង ពោធិ៍សាត់ ខេត្ក ពោធិ៍សាត់ ដោយ បាន ការចូលរួម ពី សមាជិក សមាជិកា រដ្ឋសភា ព្រឹទ្ធសភា គណៈ អចិន្ត្រៃយ៍ គណបក្ស ខេត្ត គណៈកម្មាធិការ បក្ស ខេត្ត ក្រុមការងារ ថ្នាក់ កណ្តាល គណៈកម្មាធិការ គណបក្ស ក្រុង ស្រុក ឃុំ សង្កាត់ យុវជន និង សមាគម នារី សរុប ១២០០ នាក់ ។
ក្នុង កិច្ចប្រជុំ នោះ លោក ស៊ុយ សែម រដ្ឋមន្ត្រី ក្រសួង រ៉ែ និង ថាមពល និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ ក៏ បាន ក្រើន រំលឹក និង បាន ផ្តល់ អនុសាន៍ ចំនួន ១០ ចំណុច ជូន ដល់ សមាជិក សមាជិក បក្ស ដើម្បី រួមគ្នា អនុវត្តន៍ ឱ្យ មាន ប្រសិទ្ធភាព រួម មាន៖
ដោយឡែក អ្នកជំងឺ ១៥នាក់ ជា និស្សិត និង សិក្ខាកាម យោធា ដែល បាន ហោះ ចូល មកពី ប្រទេស រុស្ស៉ី និង អេហ្ស៉ី ប ដែល ហោះ មកដល់ ប្រទេស កម្ពុជា កាលពី ថ្ងៃទី ១៩ ខែកក្កដា កន្លងទៅ នេះ ។
ដោយឡែក អ្នក ដែល ព្យាបាល ជាសះស្បើយ ០១នាក់ ជា បុរស ជនជាតិ ខ្មែរ អាយុ ២៦ ឆ្នាំ មាន អាស័យដ្ឋាន នៅ ភូមិ ជុំ ទិច ឃុំ ជុំ ទិច ស្រុក ក្រូចឆ្មារ ខេត្ត ត្បូងឃ្មុំ ដែល ជា អ្នកធ្វើ ដំណើរ មកពី ប្រទេស ឥណ្ឌូណេស៊ី ។ បុរស ជនជាតិ ខ្មែរ រូប នេះ បាន ព្យាបាល ជាសះស្បើយ និង ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូរី ដ១៩ ចំនួន ០២ ដង និង ត្រូវបាន អនុញ្ញាតឱ្យ ចេញ ពី មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
( សៀមរាប ) ៖ លោក វេង សាខុន រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ រួម ដំណើរ ដោយ លោក ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា ប្រធាន រដ្ឋបាល ជលផល និង សហការី នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ចុះ ពិនិត្យ ទីតាំង ចិញ្ចឹម កង្កែប ដើម្បី ភ្ញាស់ យក កូន លក់ របស់ លោក គង់ គឹម ឆាយ ស្ថិត នៅ ភូមិ អង្រ្កង ឃុំ ក ន្រ្ទាំង ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប ។
បញ្ញវន្ត រូប នេះ បាន ចាប់ផ្តើម ចិញ្ចឹម តាំងពី ឆ្នាំ ២០១៧ ក្រោយពី បាន បញ្ចប់ ការសិក្សា ថ្នាក់ បរិញ្ញាបត្រ វិទ្យាសាស្រ្ត ជល ផល នៅ ចុង ឆ្នាំ ២០១៦ ដោយ បាន ចាប់ផ្តើម ពី ការចិញ្ចឹម មេ ពូជ ចំនួន ៣០គូ ហើយ បច្ចុប្បន្ន លោក មាន មេ ពូជ កើន ដល់ ២០០០ ក្បាល និង មេ ពូជ បម្រុង ចំនួន ៥០០០ ក្បាល នៅលើ ផ្ទៃដី ប្រមាណ ២៥០០ ម៉ែត្រ ក្រឡា ។ ជា មធ្យម ក្នុង មេ ពូជ ២០០០ ក្បាល លោក អាច មាន លទ្ធភាព បង្កាត់ ភ្ញាស់ លក់ កូន បាន ចំណូល ប្រចាំ ខែ ប្រមាណ ២.០០០ ដុល្លារ អាមេរិក ។
លោក គង់ គឹម ឆាយ បាន បញ្ជាក់ ជូន លោក រដ្ឋមន្រ្តី វេង សាខុន ថា បញ្ហា ក្នុង ការចិញ្ចឹម កង្កែប គឺ បញ្ហា តម្លៃ ចំណី ព្រោះ យើង ប្រើ ចំណី ដែល បាន នាំចូល ពី ក្រៅ ។
ជា ការឆ្លើយតប លោក រដ្ឋមន្រ្តី វេង សា ខុន បាន ធ្វើ ការកោតសរសើរ ដល់ លោក ដែល បាន ខិតខំ ប្រឹងប្រែង ក្នុង ការចិញ្ចឹម នេះ ទទួលបាន ជោគជ័យ ហើយ លោក រដ្ឋមន្រ្តី ក៏ បាន ចាត់ ឲ្យ រដ្ឋបាល ជលផល បញ្ជូន មន្រ្តី បច្ចេកទេស មក បង្រៀន កសិករ ពី របៀប លាយ ចំណី ដោយ ខ្លួន ឯង តាម បច្ចេកទេស ដើម្បី កាត់បន្ថយ ចំណាយ ថ្លៃ ដើម និង មាន ផលចំណេញ ខ្ពស់ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ ឧត្តមសេនីយ៍ ឯក ( ផ្កាយ ៣) ជូន នាយ នគរបាល ចំនួន ៣រូប
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះមរបនា ថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ ឧត្តមសេនីយ៍ ឯក ( ផ្កាយ ៣) ជូន នាយ នគរបាល ថ្នាក់ ឧត្តមសេនីយ៍ ក្របខ័ណ្ឌ មន្ដ្រី នគរបាល ជាតិ កម្ពុជា នៃ ក្រសួង មហាផ្ទៃ ចំនួន ៣រូប ។
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ៖ មណ្ឌល សុខភាព តាំង ក្រសាំង ស្ថិត ក្នុង ខេត្ត កំពង់ធំ ទទួលបាន អាគារ ថ្មី ជា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន
( កំពង់ធំ ) ៖ អគារ ថ្មី កម្ពស់ ២ជាន់ ត្រូវបាន ផ្ដល់ជូន ដល់ មណ្ឌល សុខភាព តាំង ក្រសាំង ក្នុង ស្រុក សន្ទុក ដែល ជា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា ដើម្បី ជួយ សម្រួល ដល់ ប្រជាពលរដ្ឋ ក្នុង ស្រុក នេះ ។
អំណោយ អាគារ ថ្មី ២ជាន់ នេះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន ផ្ដល់ជូន មណ្ឌល សុខភាព តាំង ក្រសាំង តាមរយៈ លោក ជា ចាន់តូ សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក សន្ទុក នៅ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ ។
លោក ជា ចាន់តូ បាន ឲ្យដឹង ថា អគារ ថ្មី នេះ ជា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ដល់ជូន ដល់ មណ្ឌល សុខភាព តាំង ក្រសាំង ការផ្ដល់ជូន នេះ ធ្វើឡើង បន្ទាប់ ពី មើលឃើញ ពី តម្រូវ ការចាំបាច់ ក្នុង ការថែរក្សា ការពារ និង ការលើក សុខភាព ជូន ប្រជាពលរដ្ឋ ក្នុង តំបន់ នេះ និង ដើម្បី មណ្ឌល សុខភាព មាន សមត្ថភាព ក្នុង ការពិនិត្យ ព្យាបាល ជំងឺ ផ្សេង ៗ ។
លោក បន្ដ ថា អគារ ថ្មី នឹង ត្រូវ សាងសង់ ជូន នៅពេខាងមុខ នេះ ដោយ មាន បណ្ដោយ ៤៥ ម៉ែត្រ ទទឹង ១៦ម៉ែត្រ . កម្ពស់ ២ជាន់ និង ២៨ បន្ទប់ ។ ក្នុង នោះ លោក បាន សំនូមពរ ដល់ ក្រុម គ្រូពេទ្យ សូម បង្កើន ការយកចិត្តទុកដាក់ និង ត្រូវ មាន ការទទួលខុសត្រូវ ខ្ពស់ ក្នុង ការពិនិត្យ ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ ។
លោក បាន បន្ថែម ថា ជាមួយគ្នា នេះ ត្រូវ បន្ត អប់រំ ប្រជាពលរដ្ឋ អំពី វិធី ការពារ ការឆ្លង រាលដាល ជំងឺ កូវី១៩ ជាប្រចាំ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
លោក ម៉ែន ស៊ីណាត ប្រធាន មណ្ឌល សុខភាព តាំង ក្រសាំង ឲ្យដឹង ថា បច្ចុប្បន្ន មណ្ឌល សុខភាព មាន តម្រូវការ ច្រើន សម្រាប់ ការពិនិត្យ និង ព្យាលបាល ជំងឺ ជូន ពលរដ្ឋ ពិសេស បញ្ហា បន្ទប់ សម្រាប់ ការស្នាក់ នៅ ព្យាបាល របស់ អ្នកជំងឺ ព្រោះ អគារ របស់ មណ្ឌល សុខភាព សុទ្ធតែ ចាស់ ទ្រុឌទ្រោម សល់ ពី សម័យ មុន ៗ និង មាន បន្ទប់ តិច ដែល ជា ហេតុ ធ្វើឲ្យ ខ្វះខាត បន្ទប់ ដើម្បី ទទួល ឲ្យ អ្នកជំងឺ សំរាក ព្យាបាល ។
លោក ម៉ែន ស៊ីណាត ព្រមទាំង ក្រុម គ្រូពេទ្យ ទាំងអស់ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រោល ជ្រៅ ចំពោះ ទឹកចិត្ត ប្រកបដោយ ព្រហ្មវិហារ ធម៌ របស់ សម្ដេច តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល តែងតែ គិតគូរ ចំពោះ សុខភាព ប្រជាពលរដ្ឋ ។ ជាក់ស្ដែង តាមរយៈ ការផ្ដល់ អគារ ថ្មី ដល់ មណ្ឌល សុខភាព តាំង ក្រសាំង បញ្ជាក់ ថា ទីណា មាន ការលំបាក ទីនោះ មាន មុខ សម្ដេច ទាំង ទ្វេ ជានិច្ច ។
ក្នុង ការអញ្ជើញ ចុះ ពិនិត្យ នេះ លោក ជា ចាន់តូ ក៏ ផ្ដល់ ថវិកា សម្ដេច តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ជូន ដល់ អ្នក ជម្ងឺ និង គ្រូពេទ្យ ផងដែរ ៕ នគរបាល ខេត្ត បន្ទាយមានជ័យ បន្ដ ល្បាត តាម បន្ទាត់ ព្រំដែន ដើម្បី ទប់ស្កាត់ ការលួច ឆ្លង ដែន ចូល ដី ថៃ ខុស ច្បាប់ ខណៈ កំពុង ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩
( បន្ទាយមានជ័យ )៖ កម្លាំង នគរបាល វរ ព្រំដែន គោល ៨១៥ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ បន្ដ ល្បាត តាម បន្ទាត់ ព្រំដែន និង ទប់ស្កាត់ ការលួច ឆ្លង ដែន ដោយ ខុស ច្បាប់ ក្នុង ភូមិសាស្ដ្រ ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ ។
លោក សួង សៅ បាន គូសបញ្ជាក់ ថា ការចុះល្បាត ជាប្រចាំ របស់ កម្លាំង នគរបាល គឺ ក្នុង គោលបំណង ទប់ស្កាត់ បទល្មើស ផ្សេង ៗ ដែល កើត មាន ឡើង តាម បណ្តោយ ព្រំដែន កម្ពុជា - ថៃ ជាពិសេស ទប់ស្កាត់ ពលករ ខ្មែរ មិន អនុញ្ញាតឲ្យ ឆ្លង ដែន ចូល ទៅក្នុង ទឹកដី ថៃ ខុស ច្បាប់ ខណៈ នៅ ប្រទេស ថៃ ក៏ កំពុង ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ នេះ ដូចគ្នា ផងដែរ ។
ជាមួយគ្នា នេះ លោក សួង សៅ ក៏ បាន ផ្តាំផ្ញើ ដល់ ពលករ ខ្មែរ កុំ ចាញ់បោក មេខ្យល់ បន្ត ទៅ ទៀត ខណៈ បច្ចុប្បន្ន ការឆ្លង ដែន ចូល ទៅក្នុង ទៅ ដី ថៃ គឺ មិន អនុញ្ញាត ឡើយ ។ បន្ថែម ពី នេះ រថយន្ត តាក់ស៊ី នៅ ប្រទេស ថៃ ក៏ មិន ហ៊ាន ដឹក ពលករ ខ្មែរ នោះ ឡើយ ព្រោះ បើ រថយន្ត តាក់ស៊ីណា ហ៊ាន ដឹក មនុស្ស ដោយ គ្មាន ការពិនិត្យ សុខភាព ត្រឹមត្រូវ នឹង រង នូវ ការ ផាកពិន័យ ។
លោក មេបញ្ជាការ ក៏ មិន ភ្លេច ផ្តាំផ្ញើ ដល់ កងកម្លាំង ត្រូវ ខិតខំ យកចិត្តទុកដាក់ អនុវត្ត បទបញ្ជា របស់ ថ្នាក់ លើ ដែល បាន ណែនាំ និង អប់រំ បន្ដ ដល់ ប្រជាពលរដ្ឋ ត្រូវ ចាំ ការពារ សុខភាព រក្សា អនាម័យ បាន ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដើម្បី ចៀស ផុត ពី ជំងឺ កូវីដ - ១៩ ៕
បញ្ជាការដ្ឋាន អង្គរក្ស រៀបចំ ពិធី បិទ វគ្គ ហ្វឹកហ្វឺន និង ប្រគល់ វិញ្ញាបនបត្រ ក្បាច់គុន យុទ្ធ ក្រម ខេមរភូមិន្ទ ជូន កង អន្ដរាគមន៍ ៥៩៤
( កណ្ដាល ) ៖ បញ្ជាការដ្ឋាន អង្គរក្ស បាន រៀបចំ ពិធី បិទ វគ្គ ហ្វឹកហ្វឺន និង ប្រគល់ វិញ្ញាបនបត្រ ក្បាច់គុន យុទ្ធ ក្រម ខេមរភូមិន្ទ ជូន នាយ ទាហាន នាយ ទាហាន រង នៃ កង អន្ដរាគមន៍ ៥៩៤ ដែល ជា ការដ្ឋាន អង្គរក្ស ការពារ គោលដៅ រាជធានី ភ្នំពេញ ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតី លោក ឧត្តមសេនីយ៍ ឯក ដួង ហេង ទីប្រឹក្សា ផ្ទាល់ សម្ដេច តេជោ ហ៊ុន សែន និង ជា មេបញ្ជាការ រង បញ្ជាការដ្ឋាន អង្គរក្ស ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក យិន ចាន់ ធួន មេបញ្ជាការ កង អន្តរាគមន៍ ៥៩៤ បាន គូសបញ្ជាក់ ថា នេះ ជា លើក ទី មួយ ហើយ ដែល កង អន្តរាគមន៍ ៥៩៤ បាន ដាក់បញ្ចូល កម្មវិធី យុទ្ធ ក្បាច់គុន យុទ្ធ ក្រម ខម ក្នុង កម្មវិធី ហ្វឹកហ្វឺន សំដៅ លើ កម្ពស់ សមត្ថភាព សម្បទា រឹងមាំ របស់ យោធិន ក្នុង តួនាទី ភារកិច្ច ពិសេស ចូលរួមចំណែក រក្សា កេរ្ដិ៍ ដំណែល សម្បត្តិ វប្បធម៌ ជាតិ ក្បាច់គុន បុរាណ ខ្មែរ ដែល ជា មរតក អមតៈ មិន អាច ខ្វះ បាន ស្នាដៃ បុព្វបុរស ខ្មែរ ។
លោក ឧត្តមសេនីយ៍ ឯក បញ្ជាក់ បន្ថែម ថា ក្រៅពី យុទ្ធ គុន ថ្មី នេះ គ្រូបង្វឹក បាន ហ្វឹកហ្វឺន លើ មុខជំនាញ ដទៃ ទៀត សំដៅ ពង្រឹង ពង្រីក លើកកម្ពស់ សមត្ថភាព ឲ្យ កាន់តែ មាន គុណភាព ក្នុង កិច្ចការ ចូលរួម កិច្ចសហការ ជាមួយ សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ក្នុង ការប្រឆាំង ទប់ស្កាត់ ការបម្រែបម្រួល សន្តិសុខ ប្រទេស ។
ការពារ សន្តិភាព ប្រឆាំង ដាច់ខាត ចំពោះ បដិវត្ត ពណ៌ រូបភាព ពង្រឹង ប្រៀបការពារ ជាតិ សន្តិសុខ ការពារ បូរណភាព ទឹកដី កម្ពុជា ឲ្យ កាន់តែ រឹងមាំ ថែម ទៀត ជាពិសេស ទៅ ទៀត នោះ ក្នុង កិច្ចការពារ សន្តិសុខ សុវត្ថិភាព ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ព្រមទាំង ក្រុមគ្រួសារ ឲ្យ សម្រេចបាន ១០០ ភាគរយ ។
ជាមួយគ្នា នេះ លោក ឧត្តមសេនីយ៍ ឯក បណ្ឌិត ដួង ហេង និង លោក យូ ស៊ីណាត បាន វាយតម្លៃ ខ្ពស់ និង កោតសរសើរ ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្នុង កង អន្តរាគមន៍ ៥៩៤ នៃ បញ្ជាការដ្ឋាន អង្គរក្ស សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល បាន ខិតខំ ប្រឹងប្រែង អស់ ពី សមត្ថភាព ពិសេស រក គ្រប់ វិធីសាស្រ្ត នានា ក្នុង ការបណ្ដុះបណ្ដាល ក៏ ដូចជា បំប៉ន នូវ សតិអារម្មណ៍ ជូន ដល់ កងកម្លាំង មាន សមត្ថកិច្ច ។
លោក ឧត្តមសេនីយ៍ ឯក ដួង ហេង បាន បន្ត ថា ក្បាច់ យុទ្ធ គុន ថ្មី នេះ មិន មែន បម្រើ ឲ្យ ការវាយប្រយុទ្ធ គ្នា រវាង ជាតិ សាសន៍ យើង ទេ តែ ដើម្បី ជា ថាមពល និង បញ្ញា ញាណ សម្រាប់ ប្រជាជាតិ ទាំងអស់ ក្នុង ការរក្សា សុខភាព ក្នុង ការរក្សា សុខភាព និង ថាមពល ដល់ កងកម្លាំង យើង ។ បន្ទាប់មក គណៈអធិបតី បាន អញ្ជើញ ចែក វិញ្ញាបនបត្រ ជូន ដល់ សិក្ខាកាម និង ជូន នូវ ថវិកា មួយ ចំនួន ផងដែរ ៕
ឃាតកម្ម ! យុវជន ម្នាក់ ត្រូវ ឃាតក សម្លាប់ ក្នុង ចំការចេក ក្រុមហ៊ុន ហ័ង អាញ់ ស្រុក កូនមុំ ខេត្ត រតនគិរី សង្ស័យ រឿង ប្រចណ្ឌ
( រតនគិរី ) ៖ យុវជន ម្នាក់ ត្រូវបាន គេ ប្រទះឃើញ ស្លាប់ ក្នុង ចំការចេក របស់ ក្រុមហ៊ុន ហ័ង អាញ់ ភូមិ ស្រែ ពក ធំ ឃុំ សេរី មង្គល ស្រុក កូនមុំ ខេត្ត រតនគិរី កាលពី ថ្ងៃត្រង់ ទី២៤ ខែកក្កដា ឆ្នាំ ២០២០ ។
របាយការណ៍ របស់ អធិការដ្ឋាន នគរបាល ស្រុក កូនមុំ ដែល ភ្នាក់ងារ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ឲ្យដឹង ថា ក្រោយពី ទទួលបាន ព័ត៌មាន ភ្លាម កម្លាំង នគរបាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ រដ្ឋបាល សេរី មង្គល ចុះ ដល់ កន្លែង កើត ហេតុ ដើម្បី ត្រួតពិនិត្យ សាកសព ។ ជា លទ្ធផល ឃើញ ថា ជា ករណី ឃាតកម្ម ( ចាក់ នឹង កាំបិត និង វាយដំ បង ) មាន ស្លាកស្នាម អារ - ក និង វះ មុខ ជាច្រើន កាំបិត ។
តាម ស្រាវជ្រាវ សាកសួរ បំភ្លឺ ជុំវិញ រឿង ហេតុ បាន បញ្ជាក់ ថា កាលពី វេលា ម៉ោង ២០៖១០នាទី ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២០ កន្លងទៅ ជនរងគ្រោះ ឈ្មោះ គឹម សារឿន ហៅ តុង អាយុ ២៦ ឆ្នាំ មាន ស្រុក កំណើត នៅ ភូមិ ទ្រន់ ឃុំ បឹងណាយ ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម បាន ផឹក ស៊ី ជាមួយ ជនសង្ស័យ ឈ្មោះ បាក់ ណាន អាយុ ២៤ ឆ្នាំ មាន ស្រុក កំណើត ភូមិ បឹង កំពត ឃុំ បន្ទាយ ចក្រី ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ។
ក្រោយពី ផឹក ស៊ី រួច នៅ ម៉ោង ប្រមាណ ៨យប់ ថ្ងៃ កើត ហេតុ ក៏ បាន បបួលគ្នា ទៅ ឆ្លុះ កង្កែប ហើយក៏ បាន បាត់ តាំងពី ពេល នោះ មក ។ រហូតដល់ ម៉ោង ១៥ និង ០០ នាទី ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ ក៏ ត្រូវបាន ប្រទះឃើញ សាកសព ជនរងគ្រោះ តែម្តង ។
បើ តាម បញ្ជាក់ របស់ សមត្ថកិច្ច ជំនាញ ការសម្លាប់ ជនរងគ្រោះ ខាងលើ សង្ស័យ ប្រចណ្ឌ ទើប ឈានដល់ ការសម្លាប់ តែម្តង ។ សមត្ថកិច្ច បាន ឲ្យដឹង ថា ជនសង្ស័យ បាន មក ធ្វើ កម្មករ នៅ ចំការចេក ក្រុមហ៊ុន ហ័ង អាញ់ បាន រយៈពេល ៦ខែ មក ហើយ ក្រោយពី ធ្វើ សកម្មភាព រួច រត់គេចខ្លួន បាត់ ។ ក្រោយពី មន្ត្រី ជំនាញ បាន ធ្វើ កោសល្យវិច័យ រួច សព ត្រូវបាន ប្រគល់ឲ្យ ក្រុមគ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ។
ទាក់ទិន ទៅនឹង ករណី ខាងលើ នេះ ដែរ លោក ឧត្តមសេនីយ៍ ត្រី ផែន ឌីណា ស្នងការ រង ទទួល ផែន ព្រហ្មទណ្ឌ ខេត្ត រតនគិរី បាន ប្រាប់ ភ្នាក់ងារ Fresh News ប្រចាំ ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២០ យ៉ាង ខ្លី ថា សមត្ថកិច្ច កំណត់ មុខ សញ្ញា បាន ហើយ និង កំពុង មាន វិធានការ តាម ច្បាប់ ៕ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ផ្ដល់ គោរមងារ កិត្តិយស « កិត្តិនីតិកោសល បណ្ឌិត » ជូន លោក ងួន ញ៉ិល
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ ផ្ដល់ គោរមងារ កិត្តិយស នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា « កិត្តិនីតិកោសល បណ្ឌិត » ជូន លោក ងួន ញ៉ិល អនុប្រធាន ទី១ នៃ រដ្ឋសភា ។
ស្ថានទូត ចិន៖ ចំការចេក របស់ កម្ពុជា កើន ដល់ ១៥ ក្រុមហ៊ុន មាន ផ្ទៃដី ដាំដុះ ជាង ៨០០០ ហិកតា ទទួលបាន ការអនុញ្ញាតឲ្យ នាំចេញ ផ្លែ ចេក ស្រស់ ទៅ ចិន (Video inside) ( ភ្នំពេញ ) ៖ ស្ថានទូត ចិន ប្រចាំ នៅ កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បញ្ជាក់ ឲ្យដឹង ថា រហូតមកដល់ បច្ចុប្បន្ន នេះ ចំការចេក ក្នុង ប្រទេស កម្ពុជា រហូតដល់ ១៥ ក្រុមហ៊ុន ដែល មាន ការដាំដុះ ដំណាំ ចេក មាន ចំនួន ជាង ៨០០០ ហិកតា និង មាន រោងចក្រ វេចខ្ចប់ ចំនួន ២១កន្លែង ត្រូវបាន រដ្ឋាភិបាល ចិន អនុញ្ញាតឲ្យ នាំចេញ ទៅ ប្រទេស ចិន ។
ស្ថានទូត ចិន បញ្ជាក់ ថា នា ពេល ថ្មី ៗ នេះ រដ្ឋបាល គយ ប្រទេស ចិន ទើប អនុញ្ញាតឲ្យ ក្រុមហ៊ុន ចំនួន ៥ទៀត អាច វេចខ្ចប់ នាំចេញ ផ្លែ ចេក របស់ ប្រទេស កម្ពុជា ទៅកាន់ ប្រទេស ចិន លើក ទី៤ ទើប ធ្វើឲ្យ ចំនួន ក្រុមហ៊ុន កើនឡើង ដល់ ១៥ ក្រុមហ៊ុន ។
សូម ជម្រាប ថា នៅ ឆមាស ទី១ ឆ្នាំ ២០២០ នេះ ការនាំចេញ ចេក មាន ចំនួន ជាង ១៤ម៉ឺន តោន គិត ជា ទឹកប្រាក់ មាន ចំនួន ជាង ៦៨ លាន ដុល្លារ អាមេរិក ។ នេះ បើ តាម តួលេខ ដែល កត់ត្រា ដោយ ក្រសួង ពាណិជ្ជកម្ម ៕
( សៀមរាប ) ៖ ទីបំផុត បុរស ដែល បាន លើក កាំបិត គំរាម សម្លាប់ ម្តាយ មីង និង វាយ បំផ្លាញ ទ្រព្យសម្បត្តិ ដោយ បាន លី កាំបិត ខ្វែវ ដើរ កាប់ គេ ឯង តាម ផ្លូវ និង កាប់ ម៉ូតូ រួម នឹង លួច បើកបរ រថយន្ត របស់ ពលរដ្ឋ មួយ គ្រឿង បង្ក ការភ្ញាក់ផ្អើល និង ភ័យខ្លាច នៅ ក្រុង សៀមរាប គឺ ត្រូវ សមត្ថកិច្ច តាម ចាប់ខ្លួន បាន ពី កំពូល ភ្នំ ត្បែងមានជ័យ ខេត្ត ព្រះវិហារ ។
លោក ឧត្តមសេនីយ៍ ត្រី ហួត សុធី ស្នងការ រង ទទួល ផែនការងារ សន្តិសុខ ដែល ជា អ្នក បាន ដឹកនាំ ប្រតិបត្តិការ នេះ បាន ឲ្យដឹង ថា ដោយ មាន ការចង្អុលបង្ហាញ និង យកចិត្តទុកដាក់ ពី គណៈ បញ្ជាការ ឯកភាព ខេត្ត គឺ បុរស ដែល បាន បង្ក ការភ័យខ្លាច រូប នេះ គឺ ចាប់ខ្លួន បាន ហើយ នៅ រសៀល ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ ស្ថិត នៅលើ កំពូល ភ្នំ ត្បែងមានជ័យ ក្នុង ភូមិ ក្រាំង ដូង ស្រុក ត្បែងមានជ័យ ខេត្ត ព្រះវិហារ ។
លោក បាន បន្ថែម ថា កម្លាំង នគរបាល ខេត្ត សៀមរាប ជា អ្នកដឹកនាំ និង មាន ការចូលរួម អនុវត្ត ផ្ទាល់ ពី កំលាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល សង្កាត់ ស្វាយ ដង្គុំ ក្រុង សៀមរាប សហការ ជាមួយ ផែនការងារ សន្តិសុខ អធិការដ្ឋាន នគរបាល ស្រុក ត្បែងមានជ័យ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះវិហារ ទើប ចាប់ ឃាត់ខ្លួន ជនសង្ស័យ ដែល មាន ឈ្មោះ អែម បញ្ញា អាយុ ២៧ ឆ្នាំ រស់ នៅ ភូមិ វិហារ ចិន សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ។
សូម រំលឹក ថា កាលពី ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០២០ ស្ថិត នៅ ជិត សាលា បៀល ប្រាយ ក្នុង ភូមិ វិហារ ចិន សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ជន ដែល មាន ឈ្មោះ ខាងលើ បាន លី កាំបិត ខ្វែវ ដើរ កាប់ គេ ឯង តាម ផ្លូវ និង កាប់ ម៉ូតូ រួម និង បាន បើកបរ រថយន្ត របស់ ពលរដ្ឋ មួយ គ្រឿង គេច ទៅ ទុកចោល នៅ ស្រុក ប្រាសាទ បាគង ។
បើ តាម សមត្ថកិច្ច ថា ដោយ ករណី បែប នេះ កើតឡើង សមត្ថកិច្ច ខេត្ត សៀមរាប បាន តាម ប្រមាញ់ ជា បន្តបន្ទាប់ ព្រោះ ជន នេះ បាន ធ្វើឲ្យ ពលរដ្ឋ មួយចំនួន មាន ការព្រួយបារម្ភ ផងដែរ ។ ជនសង្ស័យ ខាងលើ បាន ទៅ សំងំ លាក់ ខ្លួន នៅលើ ភ្នំ ពូល ភ្នំ ត្បែងមានជ័យ ដើម្បី ស្នាក់ នៅ បណ្ដោះអាសន្ន ។
បច្ចុប្បន្ន នេះ សមត្ថកិច្ច បាន នាំ ជនសង្ស័យ មកកាន់ ខេត្ត សៀមរាប ដើម្បី កសាង សំណុំរឿង ចាត់ការ តាម ផ្លូវ ច្បាប់ ៕
ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស៊្រាង អញ្ជើញ សម្ពោធ ដាក់ ដំណើរការប្រើប្រាស់ អាគារ មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ៧មករា ជា ផ្លូវការ បន្ទាប់ពី សាងសង់ រួចរាល់ អស់ មួយ រយៈ !
រុស្ស៉ី បាន ធ្វើ ការច្រានចោល ការរិះគន់ បន្ទាប់ពី ប្រទេស ទាំង ពីរ ខាងលើ បាន បង្ហាញ ក្តីបារម្ភ រៀង ៗ ខ្លួន ជុំវិញ ការធ្វើតេស្ត ផ្កាយ រណប មួយ របស់ រុស្ស៉ី ដែល បាន ប្រព្រឹត្តទៅ កាលពី ថ្ងៃទី ១៥ ខែកក្កដា និង បាន អំពាវនាវ ឲ្យ រុស្ស៉ី ប្រកាន់ នូវ ឥរិយាបថ ប្រកបដោយ ការទទួលខុសត្រូវ នៅក្នុង ទី អវកាស ។
ជា ការឆ្លើយតប ក្រសួង ការបរទេស រុស្ស៉ី បាន ចេញ សេចក្តីថ្លែងការណ៍ ដូច្នេះ ថា « ការធ្វើតេស្ត ដែល ធ្វើឡើង ដោយ ក្រសួង ការពារ ជាតិ នៃ ប្រទេស រុស្ស៉ី កាលពី ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ មិន បាន បង្ក ការគំរាមកំហែង ណាមួយ ឡើយ ហើយ ជាពិសេស នោះ គឺ វា មិន បាន រំលោភបំពាន លើ បទដ្ឋាន ក៏ ដូចជា គោលការណ៍ នៃ ច្បាប់ អន្តរជាតិ ណាមួយ នោះ ទេ » ។
គួរ ជម្រាប ថា ជា ចុងក្រោយ ក្រសួង ការបរទេស រុស្ស៉ី បាន ចាត់ទុក ការរិះគន់ របស់ សហរដ្ឋ អាមេរិក និង ចក្រភព អង់គ្លេស ជា ការព្យាយាម បង្អាប់ បង្ខូច មុខមាត់ នៃ ការធ្វើ សកម្មភាព ដោយ ត្រឹមត្រូវ របស់ រុស្ស៉ី នៅក្នុង ទី អវកាស ៕
លោក សុខ សាគុន ប្រធាន ល .ខ. ប ស្វាយរៀង បាន រាយការណ៍ ជូន គណៈប្រតិភូ ជាន់ ខ្ពស់ គ.ជ. ប ពី វឌ្ឍនភាព របស់ ល .ខ. ប ក្នុង ការទំនាក់ទំនង ល្អ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ ក៏ ដូចជា ភាគី ពាក់ព័ន្ធ ទាំងអស់ ផងដែរ ។
លោក ស៊ិក ប៊ុន ហុក ក៏ បាន គូសបញ្ជាក់ អំពី គោលការណ៍ ជា សកល មួយចំនួន ពាក់ព័ន្ធ នឹង ការបោះឆ្នោត ដូចជា ប្រទេស ដែល ប្រកាន់ លទ្ធិ ប្រជាធិបតេយ្យ គេ ឯកភាព គ្នា ទូទាំង សកលលោក ទទួលស្គាល់ ការពិត ចំនួន ៣ ពាក់ព័ន្ធ នឹង ជោគជ័យ នៃ ការបោះឆ្នោត៖ * ត្រូវ ផ្តល់ ព័ត៌មាន យ៉ាង មាន ប្រសិទ្ធភាព រវាង តួអង្គ សំខាន់ ៗ ពាក់ព័ន្ធ ទៅនឹង ការបោះឆ្នោត * ត្រូវ ប្រកបដោយ ចរិត វិជ្ជាជីវភាព យ៉ាង ខ្លាំងក្លា * ត្រូវ ប្រកបដោយ តម្លាភាព យ៉ាង ធំធេង បំផុត ក្នុង ការបំពេញ ភារកិច្ច របស់ ខ្លួន ។
ចំពោះ លធ . ខប នៅ ខេត្ត ដទៃ ទៀត លោក ប្រធាន នឹង បន្ត សំណេះសំណាល ក្នុង ពេលវេលា សមស្រប ដើម្បី ជួប ផ្ទាល់ ជាមួយនឹង មន្ត្រី បោះឆ្នោត នៅ ទូទាំង ប្រទេស ៕ ចំណេះដឹង ទូទៅ៖ អ្វី ទៅជា បុណ្យ ហាជ្ជី របស់ អ្នក កាន់ សាសនា ឥស្លាម ដែល នឹង ចាប់ផ្តើម ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ៣១ ខែកក្កដា នេះ ?
ការបំពេញ កាតព្វកិច្ច ហាជ ឬ ហាជ្ជី ជា ការអនុវត្ត តាម កម្ពី កូរ អាន និង ស៊ុនណះ ឬ សកម្មភាព ដែល អ្នកសារ របស់ អល់ ឡោះ ជា ម្ចាស់ គឺ មហាំ ម៉ាត់ បាន ធ្វើ កាលពី ជាង ១. ៣៧៧ ឆ្នាំ មុន ។
គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា បាន កំណត់ យក ថ្ងៃពុធ ទី ២២ ខែកក្កដា ឆ្នាំ ២០២០ ជា ថ្ងៃ១ កើត ខែ ហ្សុល ហិជ្ជះ ដូច្នេះ ពិធី បុណ្យ រ៉ាយ៉ា ហាជ្ជី នឹង ចាប់ផ្តើម នៅ ថ្ងៃសុក្រ ទី ៣១ ខែកក្កដា ឆ្នាំ ២០២០ ត្រូវ នឹង ថ្ងៃសុក្រ ទី១០ ខែ ហ្សុល ហិជ្ជះ រហូតដល់ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ ។ ដោយឡែក អ្នក ខ្លះ ដែល មិន បាន ទៅ ធ្វើ ធម្មយាត្រា សាសនា ក្នុង ទីក្រុង ម៉ិចកា និង ម៉ាឌី ណាស់ ពួកគេ អាច បរិច្ចាគ ថវិកា ទិញ សត្វ គោ ក្របី ពពែ ចៀម ឬ សត្វ អូដ សំឡេះ យក សាច់ ចែកជូន អ្នកជិតខាង និង អ្នកក្រីក្រ បរិភោគ ។
ប៉ុន្តែ នៅ ពេល នោះ ដែរ សាតាន់ ( បិសាច ) បាន ព្យាយាម បញ្ចុះបញ្ចូល អ៊ីព្រហ៊ីម កុំ ឱ្យ គោរព តាម បទបញ្ជា នេះ តែ អ៊ីព្រហ៊ីម បាន ឆ្លើយតប ទៅ វិញ ដោយ ការគប់ ដុំ គ្រួស ទៅ លើ សាតាន់ ។ អ៊ីព្រហ៊ីម បាន ធ្វើ តាម បញ្ជា ប៉ុន្តែ ទន្ទឹម គ្នា នោះ អល់ ឡោះ បាន ទទួលយក ជំនឿ របស់ គាត់ និង កូន ដោយ ឱ្យ គាត់ សម្លាប់ សត្វ ពាហៈ ជំនួស កូន របស់ គាត់ វិញ ។ ដូច្នេះ ហើយ ទើប នៅក្នុង ពិធី បុណ្យ ហាជ នេះ តម្រូវ ឱ្យ ជន ម៉ូស្លីម សម្លាប់ សត្វ ពាហនៈ ដូចជា គោ ចៀម ឬ អូដ្ឋ ជាដើម យក ទៅ ចែកជូន បងប្អូន អ្នកជិតខាង បរិភោគ ។
( បរទេស ) ៖ ខាងក្រោម គឺជា រូបភាព មួយចំនួន នៃ ស្ថានការណ៍ អន្តរជាតិ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃសុក្រ ទី២៤ ខែកក្កដា ឆ្នាំ ២០២០ ។
១៖ មីយ៉ាន់ម៉ា កំពុង ត្រៀម បាញ់ បង្ហោះ ផ្កាយ រណប ដំបូង ឡើង ទៅកាន់ ទី អវកាស ។
៣៖ ធ្លាក់ ឧទ្ធម្ភាគចក្រ យោធា ហ្វីលីពីន នៅ ភាគ ខាងជើង ប្រទេស បណ្តាលឲ្យ ទាហាន ៤នាក់ ស្លាប់ និង ម្នាក់ របួស ។
៤៖ ប្រមុខ អង្គការ WHO ថ្កោល ទោស ការលើកឡើង របស់ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក ដែល ថា លោក គ្មាន ឯករាជ្យភាព ។
៦៖ ឥណ្ឌូណេស៊ី ប្រើ ធម៌ ក្តៅ រឹបអូស ទូក នេសាទ វៀតណាម ពីរ គ្រឿង ក្រោយ ការចូល នេសាទ ខុស ច្បាប់ និង ត ដៃ ជាមួយ អាជ្ញាធរ ទៀត ។
រដ្ឋមន្ត្រី យុត្តិធម៌ ណែនាំ ៥ ចំណុច ដល់ តុលាការ និង ព្រះរាជអាជ្ញា ទាំងអស់ ដើម្បី លើកកម្ពស់ គុណភាព ការកាត់ក្តី ឱ្យ បាន ត្រឹមត្រូវ និង យុតិ្តធម៌ (Video inside) ( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០២០ នេះ នៅ ទីស្តីការ ក្រសួង យុត្តិធម៌ មាន រៀបចំ ពិធី ប្រកាស ផ្ទេរ និង ចូលកាន់ មុខតំណែង ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ . សមាជិក នៃ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម . ថ្នាក់ដឹកនាំ នៃ ក្រសួង យុត្តិធម៌ . លោក យូ ប៊ុន ទ្បេង ប្រធាន សាលាឧទ្ធរណ៍ ភ្នំពេញ . លោក អ៊ុក សាវុធ អគ្គ ព្រះរាជអាជ្ញា នៃ មហា អយ្យការ អម សាលាឧទ្ធរណ៍ ភ្នំពេញ រួមទាំង ចៅក្រម ព្រះរាជអាជ្ញា មន្រ្តី តុលាការ និង មន្ត្រីរាជការ មួយចំនួន ទៀត ។
ឆ្លៀត ក្នុង ឱកាស ដែរ នេះ ដើម្បី លើកកម្ពស់ គុណភាព នៃ ការកាត់ក្តី ឱ្យ បាន ត្រឹមត្រូវ និង យុតិ្តធម៌ ក៏ ដូចជា លើកកម្ពស់ ការផ្តល់ សេវា យុត្តិធម៌ ឱ្យ មាន ភាពងាយស្រួល ឆាប់រហ័ស និង ស្អាតស្អំ លោក រដ្ឋមន្ត្រី បាន ធ្វើ ការណែនាំ ដល់ ចៅក្រម ព្រះរាជអាជ្ញា មន្ត្រី តុលាការ និង មន្រ្តី រាជការ ទាំងអស់ នៃ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ក៏ ដូចជា នៅ តាម សាលា ជម្រះ ក្តី ផ្សេង ទៀត នៅ ទូទាំង ប្រទេស ដូច ខាងក្រោម៖
* ទី ២៖ ចៅក្រម ព្រះរាជអាជ្ញា ក៏ ដូចជា មន្ត្រី តុលាការ ទាំងអស់ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ភាព ម៉ឺងម៉ាត់ របស់ ខ្លួន ក្នុង ការអនុវត្ត ច្បាប់ ឱ្យ បាន ត្រឹមត្រូវ ដើម្បី ផ្តល់ ការកាត់ក្តី មួយ ប្រកបដោយ អនាគតិ ក្នុង ការធានា ឱ្យ បាន នូវ ភាពយុតិ្តធម៌ ត្រឹមត្រូវ ជូន ប្រជាពលរដ្ឋ ជាពិសេស គឺ ការវៀរចាក នូវ អគិត ធម៌ ទាំង ៤គឺ ឆន្ទា គតិ ទោសាគតិ ភយាគតិ និង មោហោ គតិ ដូច ដែល ចៅក្រម ព្រះរាជអាជ្ញា ទាំងអស់ បាន ធ្វើ សច្ចា ប្រណិធាន នៅ មុនពេល ខ្លួន ចូលកាន់ តំណែង ។
* ទី ៥៖ ចៅក្រម ព្រះរាជអាជ្ញា ក៏ ដូចជា មន្ត្រី តុលាការ និង មន្ត្រីរាជការ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការបំពេញ ការងារ ដោយ ត្រូវ ពង្រឹង សាមគ្គីភាព ផ្ទៃក្នុង និង ពង្រឹង កិច្ចសហប្រតិបតិ្តការ ល្អ ជាមួយ អាជ្ញាធរ និង ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បី ធានា នូវ ដំណើរការ ល្អ នៃ ស្ថាប័ន តុលាការ ក៏ ដូចជា ប្រសិទ្ធភាព នៃ ការបម្រើ សេវា យុតិ្តធម៌ ឱ្យ បាន ត្រឹមត្រូវ ជូន ប្រជាពលរដ្ឋ ។
សូម បញ្ជាក់ ថា លោក ច្រឹង ខ្មៅ អតីត ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ចាម ត្រូវបាន ផ្ទេរ មក ជា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ជំនួស លោក កែវ សុធា ដែល ត្រូវបាន ផ្ទេរ ឱ្យ មក បម្រើ ការងារ នៅ ក្រសួង យុតិ្តធម៌ តាមរយៈ ព្រះរាជ ក្រឹត្យ ចុះ ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០២០ ។
ថ្លែង ក្នុង ពិធី នេះ លោក រដ្ឋមន្រ្តី បាន សម្តែង ការកោតសរសើរ និង ថ្លែងអំណរគុណ ជូន ចំពោះ លោក ឃួង ស្រេង ក៏ ដូចជា អាជ្ញាធរដែនដី និង អង្គភាព ពាក់ព័ន្ធ គ្រប់ លំដាប់ថ្នាក់ ទាំងអស់ ដែល កន្លងមក បាន ជួយ គាំទ្រ និង ផ្តល់ កិច្ចសហការ ល្អ ចំពោះ លោក កែវ សុធា ឲ្យ អនុវត្ត នូវ តួនាទី ខ្លួន ដោយ ប្រសិទ្ធភាព ។
