( ភ្នំពេញ ) ៖ ក្រសួង យុត្ដិធម៌ បាន ចេញ សេចក្ដីសម្រេច តែងតាំង មន្ដ្រី ខុទ្ទកាល័យ រដ្ឋមន្ដ្រី ក្រសួង យុត្ដិធម៌ ចំនួន ៨រូប ។ នេះ បើ តាម សេចក្ដីសម្រេច របស់ លោក កើត រិទ្ធ រដ្ឋមន្ដ្រី ក្រសួង យុត្ដិធម៌ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ នេះ ។
ខាងក្រោម នេះ ជា សេចក្ដីសម្រេច របស់ ក្រសួង យុត្ដិធ ម៌៖
ដាច់ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន នៅ ខេត្ត ស្វាយរៀង ដោយសារ រថយន្ត ដឹក ដី លើក បែន ប៉ះ បាក់ បង្គោល ភ្លើង
( ស្វាយរៀង ) ៖ អគ្គិសនី កម្ពុជា បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ វេលា ម៉ោង ១៤៖ ០៣នាទី រសៀល មាន ករណី ដាច់ចរន្ត អគ្គិសនី ពី អនុស្ថានីយ កំពង់សឹង្ហ ទ្វារ ចរន្ត ទី៤ មូលហេតុ ដោយសារ មាន រថយន្ត ដឹក ដី លើក បែន ទាក់ ខ្សែ បណ្ដាញ តង់ស្យុង ទាប (LV) បណ្ដាលឲ្យ បាក់ បង្គោល ខ្សែ បណ្ដាញ តង់ ស្យុង មធ្យម (MV) ចំនួន ១ដើម ដែល បណ្តាលឲ្យ ដាច់ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន នៅ ខេត្ត ស្វាយរៀង ។
អគ្គិសនី កម្ពុជា បាន បញ្ជាក់ ថា ក្រុមការងារ បច្ចេកទេស កំពុង ធ្វើ ការជួសជុល និង ដាំ បង្គោល ខ្សែ បណ្ដាញ តង់ ស្យុង មធ្យម (MV) ដើម្បី ភ្ជាប់ ចរន្ត ជូន អតិថិជន ឲ្យ មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ មុន វេលា ម៉ោង ១៨៖០០ នាទី ល្ងាច នេះ ។
អគ្គិសនី កម្ពុជា សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ នៅពេល បំពេញ ការងារ នៅជិត គន្លង ខ្សែ បណ្ដាញ អគ្គិសនី ពីព្រោះ អាច បណ្ដាល ឲ្យ មាន ការរអាក់រអួល ក្នុង ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី និង គ្រោះថ្នាក់ ជា យថាហេតុ ៕
សហព័ន្ធ ស្រូវ អង្គរ កម្ពុជា បាន គូសបញ្ជាក់ ថា « សម្រាប់ រយៈពេល ៧ខែ នៃ ឆ្នាំ ២០២០ នេះ ចំណូល ដុល ពី ការនាំចេញ អង្ករ បាន ចំនួន ២៨៥. ៨០ លាន ដុល្លា សហរដ្ឋ អាមេរិក » ។
ចំពោះ ការនាំចេញ អង្ករ ប្រចាំ ខែកក្កដា ដែល ជាទូទៅ គឺជា ខែ ដែល ការនាំចេញ បាន ចំនួន តិច ជាង គេ នៃ ចំនួន ខែ ទាំងអស់ ប្រចាំ ឆ្នាំ គិត ជា មធ្យម ក្នុង ខែកក្កដា នេះ មាន ប្រហែលជា ២៦.០០០ តោន ក្នុង មួយ ខែ ដោយសារ ខែកក្កដា ជា ខែ ចុង រដូវ នៃ ស្តុក ស្រូវ ស្រាល ដូចជា សែន ក្រអូប សុមាលី និង ពពួក ស្រូវ ប្រកាន់ រដូវ ដូចជា ផ្កា រំដួល ផងដែរ ។
ប្រភេទ អង្ករ នាំចេញ៖ ចាប់តាំងពី ឆ្នាំ ២០១៦ ឃើញ ថា កំណើន នៃ ការនាំចេញ អង្ករ ក្រអូប មាន កំណើន ជាលំដាប់ រីឯ អង្ករ ស និង អង្ករ ចំហុយ មាន ទំនោរ ធ្លាក់ចុះ ជា គំហុក ចាប់ពី ឆ្នាំ ២០១៨មក តែ មាន កំណើន វិញ ខ្លះ នៅ ឆ្នាំ ២០២០ ក្នុង ដំណាក់កាល នៃ ជំងឺ កូវីដ១៩ រីឯ អង្ករ សរីរាង្គ នៅ មាន ទំនោរ កំណើន ជា បណ្តើរ ៗ ។
អភិបាល ខេត្ត កំពង់ធំ ចែក អំណោយ ជូន ដល់ ប្រជាពលរដ្ឋ មាន ជីវភាព ខ្វះខាត ជាង ៣០០ គ្រួសារ នៅ ក្រុង ស្ទឹង សែន
( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ សំណេះសំណាល សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ គម្រោង ចលនា ភូមិ ថ្មី របស់ ប្រទេស កូរ៉េ ផ្តល់ ជូន បងប្អូន ប្រជាពលរដ្ឋ មាន ជីវភាព ខ្វះខាត ចំនួន ៣២០ គ្រួសារ មកពី ៨សង្កាត់ ក្នុង ក្រុង ស្ទឹង សែន នា ព្រឹក ថ្ងៃទី ៣ ខែសីហា ឆ្នាំ ២០២០ ។
ជាមួយគ្នា នោះ ដែរ លោក សុខ លូ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម ផ្លាស់ប្តូរ ទម្លាប់ នៃ ការរស់ នៅ ដោយ រក្សា អនាម័យ ជាប់ ជានិច្ច ហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត ទុកដាក់ សំរាម និង កាកសំណល់ ផ្សេង ៗ ឲ្យបាន ត្រឹមត្រូវ ជាពិសេស ត្រូវ ឧស្សាហ៍ លាង ដៃ នឹង សាប៊ូ ឲ្យ បាន ញឹកញាប់ ឬ ទឹក អាល់កុល ឬ ជែល ដាក់ ជាប់ តាម ខ្លួន ជាប្រចាំ នៅពេល ធ្វើដំណើរ នៅ គ្រប់ ទីកន្លែង ជាពិសេស មិន ត្រូវ មាន ការជួបជុំ ឬ ចាក់ ធុង បាស រាំ កម្សាន្ត នោះ ទេ ដើម្បី រួមគ្នា ទប់ស្កាត់ នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
លោក បន្ថែម ទៀត ថា ស្រប ពេល ដែល ប្រទេស កម្ពុជា កំពុងតែ ទទួលរង នូវ ផល ប៉ះពាល់ ជំងឺ កូវីដ - ១៩ នេះ ប្រមុខ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ « កម្មវិធី ផ្តល់ សាច់ប្រាក់ ជូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ក្រីក្រ និង ងាយ រងគ្រោះ ដោយសារ ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ - ១៩ » ដើម្បី កាត់បន្ថយ ការលំបាក ជូន បងប្អូន ជា ប្រជាពលរដ្ឋ ក្រីក្រ ពិតប្រាកដ ។
ចុងបញ្ចប់ លោក សុខ លូ បាន សំណូមពរ ដល់ ពុក ម៉ែ បងប្អូន ទាំងអស់ ជួយ អប់រំ កូន ចៅ ឲ្យ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ រាល់ ការបើកបរ ម៉ូតូ ត្រូវ ពាក់ មួយ សុវត្ថិភាព ទាំង អ្នកបើកបរ និង អ្នក រួម ដំណើរ និង ជៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន ព្រមទាំង ចែក អំណោយ ដល់ ប្រជាពលរដ្ឋ ជា និមិត រូប ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ មី ម៉ាស ក្រណាត់ ក្រម៉ា សាប៊ូ លាង ដៃ អាកុល ដប តូច និង អាកុល ដប ធំ ៕ នៅ ថ្ងៃស្អែក រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌ នឹង ដឹកនាំ ដុត បំផ្លាញ គ្រឿងញៀន នៅ ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោក ប៉ុក ម៉ាន់ នី អនុ រដ្ឋលេខាធិការ ក្រសួង យុត្តិធម៌ នៅ ព្រឹក ថ្ងៃទី ៣ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ចូលរួម បើក កញ្ចប់ វត្ថុតាង គ្រឿងញៀន នៅ សាលាដំបូង ខេត្ត ស្វាយរៀង ដើម្បី ត្រៀម ដុត បំផ្លាញ ចោល នៅ ថ្ងៃទី ៤ ខែសីហា ស្អែក នេះ ក្រោម អធិបតី រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ លោក កើត រិទ្ធ ។
ពិធី នេះ មាន ការចូលរួម ពី លោក តូច ប៉ូលីវ៉ា អភិបាល រង ខេត្ត ស្វាយរៀង និង លោក ខាំ សុផារី ព្រះរាជអាជ្ញា ខេត្ត ស្វាយរៀង . អភិបាល រង ខេត្ត ព្រះរាជអាជ្ញា រង ទាំង៤ ខេត្ត ព្រមទាំង សមត្ថកិច្ច ជំនាញ គ្រឿងញៀន ជាច្រើន រូប ផងដែរ ។
លោក ប៉ុក ម៉ាន់ នី បាន ថ្លែង ថា រយៈកាល កន្លងមក ប្រជាពលរដ្ឋ មួយចំនួន តែងតែ មាន ការងឿងឆ្ងល់ និង សួរ ថា សមត្ថកិច្ច ក្រោយ ប្រតិបត្តិការ បង្រ្កាប បទល្មើស គ្រឿងញៀន រួច តើ វត្ថុតាង បញ្ជូន ទៅ ណា ? យក ទៅ ណា ? តើ ពេលណា គេ ដុត កម្ទេចចោល ? ជាក់ស្ដែង សម្រាប់ ខេត្ត ស្វាយរៀង នេះ ជា លើក ទី២ ហើយ ដែល អាជ្ញាធរ ពាក់ព័ន្ធ ដុត កម្ទេចចោល គ្រឿងញៀន ទាំងអស់ នេះ ។
លោក បាន បន្ត ថា កម្មវិធី ដុត បំផ្លាញ គ្រឿង នេះ ជា គោលដៅ របស់ រាជ រដ្ឋាភិបាល ដែល ដាក់ ឲ្យ អនុវត្ត ដល់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ដើម្បីឲ្យ មាន ទិវា ថ្ងៃ ២៦ ខែមិថុនា គឺជា ទិវា ប្រារព្ធ ឡើង ដើម្បី ដុត បំផ្លាញ គ្រឿងញៀន តែងតែ ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ ។
ជាមួយគ្នា នេះ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង យុត្តិធម៌ រូប នេះ ក៏ បាន លើកឡើង ពី សំណុំរឿង ស្ត្រី ខ្មែរ ដែល ត្រូវ តុលាការ វៀតណាម កាត់ទោស ប្រហារជីវិត ពី បទ ជួញដូរ គ្រឿងញៀន ឆ្លង ដែន ផងដែរ ។ លោក ថា សំណុំរឿង នេះ មិន ទាន់ បញ្ចប់ ត្រឹម នេះ នៅឡើយ ទេ ពោលគឺ នៅសល់ ដំណាក់កាល ជម្រះ ក្ដី នៅ ថ្នាក់ឧទ្ធរណ៍ បន្ត ទៀត ។ ដំណាក់កាល ឧទ្ទរណ៍ គឺ មាន ជំនួយ ផ្នែក ច្បាប់ ពី ក្រសួង យុត្តិធម៌ កម្ពុជា ដើម្បី ប្ដឹង ជំទាស់ សេចក្ដីសម្រេច របស់ តុលាការ ថ្នាក់ ដំបូង របស់ វៀតណាម ។
សូម បញ្ជាក់ ថា គ្រឿងញៀន និង វត្ថុតាង ដែល ត្រូវ ដុត បំផ្លាញ ចោល មាន ៤ ខេត្ត រួម មាន៖ ខេត្ត ស្វាយរៀង ព្រៃវែង ត្បូងឃ្មុំ កំពង់ចាម ស្មើរ និង ៥២២ សំណុំរឿង ក្នុង នោះ គ្រឿងញៀន ជាង ៣៦ គីឡូក្រាម . សារធាតុ គីមី ២២៦៨. ៨៩g និង កញ្ឆា ៨. ៩៦g ៕ អភិបាល រាជធានី ភ្នំពេញ ណែនាំ ឲ្យ អាជ្ញាធរ សម្អាត មហាវិថី ឈ្នះ ឈ្នះ ឲ្យបាន ស្អាត ជាប្រចាំ និង ពិនិត្យមើល ដើមឈើ បង្ការ ការបាក់ មែក
( ភ្នំពេញ ) ៖ ដើម្បី បរិស្ថាន ល្អ ប្រសើរ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ចុះ ពិនិត្យ និង ធ្វើ ការណែនាំ ដល់ អាជ្ញាធរ និង មន្ទីរ ពាក់ព័ន្ធ នាំគ្នា ធ្វើ ការ សម្អាត មហាវិថី ឈ្នះ ឈ្នះ ឲ្យបាន ស្អាត ជាប្រចាំ និង វេចខ្ចប់ ទុកដាក់ សំរាម ឲ្យបាន ល្អ ហើយ ពិនិត្យមើល ដើមឈើ នៅ អម សងខាង តាម មហាវិថី នេះ ក៏ ត្រូវតែ កាត់លះ មែក ឲ្យបាន ស្អាត ដើម្បី បង្ការ ការបាក់ មែក ដោយ ប្រការ ណាមួយ ។
ការណែនាំ បែប នេះ របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ នេះ ខណៈ ដែរ លោក បាន ដឹកនាំ អាជ្ញាធរ និង មន្ទីរ ពាក់ព័ន្ធ មួយ ចំនួន ចុះ ត្រួតពិនិត្យមើល វិមាន ឈ្នះ ឈ្នះ និង តាម បណ្ដោយ វិថី មហាវិថី ឈ្នះ ឈ្នះ នេះ ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ តាម បណ្ដោយ មហាវិថី នេះ មាន បរិស្ថាន ល្អ និង មាន សណ្ដាប់ធ្នាប់ ល្អ ប្រសើរ ។
លោក ឃួង ស្រេង បាន លើកឡើង ថា នៅ តាម បណ្ដោយ មហាវិថី ឈ្នះ ឈ្នះ ស្ថិត ក្នុង ខណ្ឌ ជ្រោយ ចង្វារ ឃើញ ថា មាន ដី និង ដក់ ទឹក នៅ តាម ចិញ្ចើមផ្លូវ ។
ជាមួយគ្នា នេះ លោក អភិបាល រាជធានី ស្នើ ដល់ អាជ្ញាធរ ធ្វើ យ៉ាងណា ចុះ ណែនាំ បងប្អូន ប្រជាពលរដ្ឋ ដែល លក់ដូរ នៅ តាម ចិញ្ចើម មហាវិថី នេះ ត្រូវ សម្អាត ទីតាំង លក់ដូរ របស់ ខ្លួន ឲ្យបាន ល្អ ដោយ ត្រូវ វេចខ្ចប់ ទុកដាក់ សំរាម ឲ្យបាន ត្រឹមត្រូវ ធ្វើ យ៉ាងណា ឲ្យ តំបន់ នេះ មាន អនាម័យ បរិស្ថាន ល្អ ដើម្បី ចូលរួម បង្ការ ទប់ស្កាត់ នូវ ជំងឺ កូវីដ១៩ ទាំងអស់ គ្នា ខណៈ ដែល ជំងឺ នេះ បាន និង កំពុង រីករាលដាល នៅ ទូទាំង ពិភពលោក ហើយ កម្ពុជា ក៏ ជា ប្រទេស កំពុងតែ ប្រឈម ដែរ នោះ ។
ក្រៅពី បញ្ហា នេះ លោក អភិបាល រាជធានី ភ្នំពេញ ក៏ បាន ណែនាំ ដល់ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ធ្វើ ការសំអាត ធូលី ដី ភក់ នៅលើ បណ្ដោយ ផ្លូវ នេះ ឲ្យបាន ស្អាត ជាមួយនឹង ការប្រើ គ្រឿងចក្រ កៀ ទឹក ដក់ នៅ តាម បណ្តោយ ផ្លូវ នេះ ឲ្យបាន ស្អាត ។
លោក ឃួង ស្រេង បន្ត ថា ចំពោះ មន្ទីរ បរិស្ថាន និង អង្គភាព សួនច្បារ និង រុក្ខជាតិ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ត្រូវ ទទួលខុសត្រូវ មើល ថែ ដើមឈើ ជាប្រចាំ ពោលគឺ បើ ដើមឈើ ដែល ត្រូវ លះ មែក គឺ ត្រូវ លះ មែក ចេញ ឲ្យបាន ស្អាត តែ បើ ដើមឈើ ដែល ងាប់ ក៏ ត្រូវ គាស់ ចេញ និង ដាក់ ដាំ ថ្មី ផងដែរ ៕
សួន វិស័យ រក្សា សន្តិភាព និង សកម្មភាព មីន នឹង លេច រូបរាង ក្នុង បរិវេណ វិមាន ឈ្នះ ឈ្នះ នា ពេល ឆាប់ ៗ នេះ
( ភ្នំពេញ ) ៖ សួន វិស័យ រក្សា សន្តិភាព និង សម្មភាព មីន ត្រូវបាន បញ្ចុះ បឋមសិលា សាងសង់ ក្នុង បរិវេណ វិមាន ឈ្នះ ឈ្នះ នៅ ព្រឹក ថ្ងៃទី ៣ ខែសីហា ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ មជ្ឈមណ្ឌល ជាតិ រក្សា សន្តិភាព និង មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា ។ សួន នេះ បាន បង្ហាញ ពី សមទ្ធិផល និង ស្នាដៃ សំខាន់ ៗ ក្នុង វិស័យ រក្សា សន្តិភាព ក្នុង បេសកកម្ម របស់ អង្គការ សហ ប្រជាជាតិ របស់ កម្ពុជា ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ គ្រប់គ្រង កងកម្លាំង រក្សា សន្តិភាព បោសសម្អាត មីន និង កាកសំណល់ សង្គ្រាម បាន បញ្ជាក់ ថា នៅក្នុង សួន ដែល សាងសង់ នេះ មាន កសាង ស្តូប សួន វិស័យ រក្សា សន្តិភាព និង សកម្មភាព មីន មាន រាង បញ្ចកោណ ដោយ ជ្រុង ទី ១៖ បង្ហាញ រូប សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ទីស្នាក់ការ អង្គការ សហ ប្រជាជាតិ ជ្រុង ទី២ និង ទី៣ បង្ហាញ ពី កងកម្លាំង ជំនាញ អាវុធហត្ថ និង ជំនាញ វិស្វកម្ម ជ្រុង ទី៤ និង ទី៥ បង្ហាញ ពី កងកម្លាំង ជំនាញ ពេទ្យ និង បោសសម្អាត មីន ។
នាយ ឧត្តមសេនីយ៍ បាន បន្ថែម ថា ក្រុមការងារ នឹង ពន្លឿន ការងារ សាងសង់ សួន នេះ ឱ្យ បាន រួចរាល់ នៅក្នុង អំឡុង ខែវិច្ឆិកា ឆ្នាំ ២០២០ ខាងមុខ នេះ ។
ក្លិប វាយ កូនហ្គោល សន្តិភាព បំផុស សមាជិក ខ្លួន ស្រឡាញ់ សន្តិភាព ថែរក្សា សន្តិភាព និង ការរីកចម្រើន ក្នុង សម័យ តេជោ
សមាជិក ដដែល បាន ថ្លែង ពី សារៈប្រយោជន៍ យ៉ាង សំខាន់ នៃ សន្តិភាព ដ្បិត ក្នុង ពិភពលោក នេះ ប្រទេស ណា ក៏ ដូច ប្រទេស ណា ដែរ តែងតែ ចង់បាន បំផុស មុន គេ គឺ « សន្តិភាព » បើ មាន សន្តិភាព ទើប ប្រទេសជាតិ មាន ឱកាស កសាង អភិវឌ្ឍន៍ ឡើង តួយ៉ាង ដូច កម្ពុជា គឺ អ្វី ដែល ចាំបាច់ បំផុត ប្រជាជាតិ ត្រូវការ បំផុត នោះ គឺ « សន្តិភាព » ។
ក្រុម របស់ លោក ពិតជា ឲ្យ តម្លៃ ខ្ពស់ បំផុត ចំពោះ សន្តិភាព ទើប ក្រុម លោក ដាក់ ឈ្មោះ ក្រុម ខ្លួន ថា « ក្រុម កីឡា វាយ កូនហ្គោល សន្តិភាព » នេះ ឡើង ឲ្យ ស្រប តាម ប្រទេសជាតិ មាន សុខ សន្តិភាព ដូច បច្ចុប្បន្ន ។
ពួកគាត់ បញ្ជាក់ ទៀត ថា ក្រុម កីឡា របស់ ពួក លោក នឹង នៅតែ បន្ត បំផុស បំផុល ដល់ សមាជិក ខ្លួន និង ពលរដ្ឋ ទូទៅ ឲ្យ យល់ ច្បាស់ ពី តម្លៃ នៃ សន្តិភាព ស្រឡាញ់ សន្តិភាព និង ចូលរួម ថែរក្សា សន្តិភាព និង បន្ត បំផុស ឲ្យ ពលរដ្ឋ ចូលរួម ទប់ស្កាត់ ការឆ្លង វីរុស កូវីដ១៩ ផងដែរ ដ្បិត កម្ពុជា មាន សមត្ថភាព ខ្ពស់ លើ ការងារ នេះ ប៉ុន្តែ ការចូលរួម ទាំងអស់ គ្នា ក៏ ជា កត្តា សំខាន់ ទៀតផង ។
នាយ ឧត្តមសេនីយ៍ សៅ សុខា ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ដែល ទើបតែងតាំង ថ្មី
( ភ្នំពេញ ) ៖ នា រសៀល ថ្ងៃទី ៣ ខែសីហា ឆ្នាំ ២០២០ នៅ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស បាន ទទួល ជួប សំណេះសំណាល លោក ច្រឹង ខ្មៅ ដែល ទើប ត្រូវបាន តែងតាំង ជា ព្រះរាជអាជ្ញា ថ្មី នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ព្រមទាំង សហការី ។
ការអំពាវនាវ របស់ ក្រសួង យុត្តិធម៌ បាន ធ្វើឡើង បន្ទាប់ពី មាន មនុស្ស មួយ ក្រុម បាន និង កំពុង ធ្វើ សកម្មភាព ប្រមូល និង ដើរ ក្បួន តាម ដង វិថី ជាដើម ទាមទារ ឱ្យ មាន ការដោះលែង លោក រ៉ុង ឈុន ។
ក្នុង សេចក្តីប្រកាស ព័ត៌មាន ចេញផ្សាយ នៅ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ នេះ ក្រសួង យុត្តិធម៌ បាន គូសបញ្ជាក់ ថា សកម្មភាព ក្នុង ការប្រមូលផ្តុំ មនុស្ស នៅ ខាងមុខ សាលាដំបូង រាជធានី ភ្នំពេញ ដែល ទាមទារ ឱ្យ ស្ថាប័ន តុលាការ ដោះលែង ជន ត្រូវ ចោទ ឈ្មោះ រ៉ុង ឈុន ពុំ មែន ជា ទង្វើ ត្រឹមត្រូវ តាម ច្បាប់ នោះ ទេ ។ ផ្ទុយទៅវិញ ទង្វើ នេះ ជា ការដាក់ សម្ពាធ លើ ស្ថាប័ន តុលាការ ដែល អាច ប្រឈមមុខ នឹង ការចោទប្រកាន់ អំពី បទល្មើស ព្រហ្មទណ្ឌ តាម មាត្រា ៥២២ នៃ ក្រម ព្រហ្មទណ្ឌ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ពាក់ព័ន្ធ នឹង ការធ្វើ សកម្មភាព តវ៉ា របស់ មនុស្ស មួយ ក្រុម នេះ សាលា រាជធានី ភ្នំពេញ នៅ ថ្ងៃ នេះ ក៏ បាន អំពាវនាវ ដល់ អាជ្ញាធរ តាម បណ្តា ខណ្ឌ ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ ត្រូវ ចាត់ វិធានការ ទៅ លើ ពួកគេ ផងដែរ ៕ អនុវត្ត រៀបចំ សណ្ដាប់ធ្នាប់ ទីប្រជុំជន ផ្សារ ផ្អាវ ដំណាក់កាល ទី៣. អាជ្ញាធរ ប្រើ គ្រឿងចក្រ ដើម្បី ឈូសឆាយ សម្អាត ចិញ្ចើមផ្លូវ និង មាត់ លូ
( កំពង់ចាម ) ៖ អាជ្ញាធរ ខេត្ត កំពង់ចាម រួម សហការ ជាមួយ អាជ្ញាធរ ស្រុក បាធាយ ដឹកនាំ ដោយ លោក អ៊ុភឿន គុណ វុឌ្ឍ អភិបាល រង ខេត្ត កំពង់ចាម លោក សំ ពិសិដ្ឋ នាយក រង រដ្ឋបាល ខេត្ត និង អភិបាល ស្រុក បាធាយ លោក ផេន សុផល នៅ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន អនុវត្ត ទៅ លើ ការរៀបចំ សណ្ដាប់ធ្នាប់ សាធារណៈ ទីប្រជុំជន ផ្សារ ផ្អាវ ស្រុក បាធាយ ឈានចូល ដល់ ដំណាក់កាល ទី៣ ដែល អាជ្ញាធរ ត្រូវ ប្រើ គ្រឿងចក្រ ដើម្បី ឈូសឆាយ ដី ចិញ្ចើមផ្លូវ និង មាត់ លូ ។
ក្នុង ប្រតិបត្តិការ តំណាក់កាល ទី៣នេះ ស្នងការ រង នគរបាល ខេត្ត កំពង់ចាម លោក សោម រស់ បាន ឲ្យដឹង ថា ថ្ងៃ នេះ កម្លាំង សមត្ថកិច្ច ចុះ រៀបចំ សណ្ដាប់ធ្នាប់ លើ ចិញ្ចឹម ផ្លូវ និង មាត់ លូ តាម ខ្នង ផ្ទះ ប្រជាពលរដ្ឋ តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៦A ដោយ ក្នុង នោះ កម្លាំង អាជ្ញាធរ និង សមត្ថកិច្ច ប្រើប្រាស់ គ្រឿងចក្រ ចំនួន ៣គ្រឿង ដើម្បី អនុវត្ត ការងារ រៀបចំ សម្អាត ចិញ្ចើមផ្លូវ ។
លោក ស្នងការ រង បាន បញ្ជាក់ ថា ក្នុង ប្រតិបត្តិការ នេះ ដែរ បន្ទាប់ពី កម្លាំង អាជ្ញាធរ បាន ចុះ ធ្វើ ការផ្សព្វផ្សាយ ជូន ដល់ ប្រជាពលរដ្ឋ ក៏ ដូចជា អាជីវករ ដែល បាន សាងសង់ សំយ៉ា ប ឬ ក៏ ទីកន្លែង លក់ដូរ ប៉ះពាល់ មកដល់ ចំណី ផ្លូវ ឲ្យ ធ្វើ ការរុះរើ ចេញ មុនពេល អាជ្ញាធរ ចុះ ធ្វើ ការរៀបចំ មាត់ លូ និង ចិញ្ចើមផ្លូវ ឃើញ ថា ខាង ប្រជាពលរដ្ឋ ក៏ ដូចជា អាជីវករ បាន សហការ ជាមួយ អាជ្ញាធរ បាន យ៉ាង ល្អ នឹង ធ្វើ ការរុះរើ ថយ ចូលក្នុង គ្រប់ ៗ គ្នា ដោយ មិន មាន បញ្ហា ចម្រូងចម្រាស អ្វី ឡើយ ។
លោក ស្នងការ រង បាន ឲ្យដឹង ទៀត ថា នៅក្នុង តំណាក់ ខាងមុខ អាជ្ញាធរ នឹង រៀបចំ ចិញ្ចើមផ្លូវ ឲ្យបាន ស្អាត និង ប្រព័ន្ធ លូ នឹង សាងសង់ ឃឿន តាម បណ្ដោយ ផ្លូវ ៦A នៃ ទីប្រជុំជន ផ្សារ ផ្អាវ នេះ តែម្តង ដើម្បី ធ្វើឲ្យ មាន សោភ័ណភាព បន្ទាប់ពី ទីប្រជុំជន នេះ មាន សណ្ដាប់ធ្នាប់ ល្អ ហើយ នោះ ៕ ព្រះរាជអាជ្ញា ដឹកនាំ កម្លាំង ចុះ ត្រួតពិនិត្យ និង រឹបអូស ម្សៅ ទឹកដោះគោ ក្មេង ចំនួន ៦០ កំប៉ុង នៅ ក្រុង បាន លុង
( រតនគិរី ) ៖ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត រតនគិរី នៅ ថ្ងៃទី២ ខែសីហា ឆ្នាំ ២០២០ បាន ដឹកនាំ កម្លាំង នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច មន្ត្រី មន្ទីរ សុខាភិបាល និង មន្ត្រី កាំ កុងត្រូល បាន ចុះ ត្រួតពិនិត្យ និង ដកហូត ម្សៅ ទឹកដោះគោ ក្មេង ក្នុង ដេប៉ូលក់ដូរ មួយ កន្លែង ជាប់ សាខា ធន គារ កាណាឌីយ៉ា ក្នុង ភូមិ ជ័យ ជំនះ សង្កាត់ ឡា បាន សៀក ក្រុង បាន លុង ខេត្ត រនគិរី ។
លោក ឧត្តមសេនីយ៍ ស្នងការ រង រូប នេះ បន្ត ថា បន្ទាប់ពី ទទួល ព័ត៌មាន រួច គាត់ រាយការណ៍ ជូន លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន ស្នងការ នគរបាល ខេត្ត និង មាន ការឯកភាព ពី លោក ព្រះរាជអាជ្ញា កម្លាំង ជំនាញ ក៏ ចុះ ត្រួតពិនិត្យ ជាក់ស្តែង តែម្តង ។
លោក ឧត្តមសេនីយ៍ ត្រី នូវ ដារ៉ា បញ្ជាក់ ឲ្យដឹង ទៀត ថា បន្ទាប់ពី ធ្វើ ការត្រួតពិនិត្យ ដេប៉ូលក់ដូរ ខាងលើ កម្លាំង សមត្ថកិច្ច សង្កេតឃើញ ថា កាលបរិច្ឆេទ កំប៉ុង ទឹក គោ អាច លុប បាន និង មួយចំនួន ទៀត លុប មិន បាន រួច បាន ដកហូត ចំនួន ៦០ កំប៉ុង មក រក្សាទុក និង បាន យក ទឹកដោះ ក្មេង ចំនួន ៣កំប៉ុង ទៅ ធ្វើ ការពិសោធន៍ នៅ រាជធានី ភ្នំពេញ ព្រមទាំង ធ្វើ ការឃាត់ខ្លួនអ្នកលក់ ទឹកដោះគោ ក្មេង ម្នាក់ ឈ្មោះ គឹម អ៊ូយ ភេទ ស្រី អាយុ ៥១ ឆ្នាំ ជនជាតិ ខ្មែរ ម្ចាស់ ដេប៉ូលក់ដូរ ទីតាំង ខាងលើ ផងដែរ ៕
ដង ព្រែក កំពង់បាយ ក្រុង កំពត និង ព្រែក ទឹក ឈូ ប្រឈម ការជន់ លិច ខ្លាំង បើ ភ្លៀង នៅ បន្ត ធ្លាក់ . ថ្ងៃ នេះ អភិបាល ខេត្ត និង មន្រ្តី ជំនាញ ចុះ ពិនិត្យ ស្ថានភាព ទឹក ត្រៀម ជួយ អន្តរាគមន៍
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ដឹកនាំ មន្រ្តី ជំនាញ និង អាជ្ញាធរ ពាក់ព័ន្ធ ចុះ ពិនិត្យ ស្ថានភាព ទឹក នៅ តាម ដង ព្រែក កំពង់បាយ ក្រុង កំពត រហូតដល់ ព្រែក ទឹក ឈូ ឆ្លងកាត់ ក្នុង ឃុំ ម៉ាក់ ប្រាង និង ឃុំ កំពង់គ្រែង ក្នុង ស្រុក ទឹក ឈូ ខេត្ត កំពត នា ថ្ងៃទី ៣ ខែសីហា ឆ្នាំ ២០២០ នេះ ។
ខេត្ត កំពត ស្ថិត ក្នុង ស្ថានភាពធាតុអាកាស អាប់ អួរ ហើយ ភ្លៀង នៅតែ បន្ត ធ្លាក់ ជាប់ គ្នា រយៈពេល ៣ ទៅ៤ ថ្ងៃ កន្លងមក ហើយ គឺ ចាប់ពី ថ្ងៃទី ៣១ ខែកក្កដា រហូតដល់ ថ្ងៃ នេះ ។
ជាពិសេស ត្រូវ ត្រៀមលក្ខណៈ គ្រប់ មធ្យោបាយ ដើម្បី ជួយ អន្តរាគមន៍ ឬ ជម្លៀស ប្រជាពលរដ្ឋ ទៅកាន់ ទី ទួល សុវត្ថិភាព ក្នុង ករណី មាន ហេតុការណ៍ ទឹក ជំននន់ កើតឡើង ។ ទន្ទឹម នឹង នោះ លោក អភិបាល ខេត្ត ក៏ សំណូមពរ ឲ្យ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ រាយការណ៍ មក រដ្ឋបាល ខេត្ត ជាបន្ទាន់ ដោយ មិន ត្រូវ ទុកឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង នោះ ឡើយ ដោយ គ្មាន ការអន្តរាគមន៍ ពី អាជ្ញាធរ និង កងកម្លាំង សមត្ថកិច្ច យើង បាន ឡើយ ។
លោក អភិបាល ខេត្ត ក៏ បាន ស្នើ ដល់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម បណ្តោយ ព្រែក ទាំងអស់ រួមទាំង ម្ចាស់ បឹង ហ្គាឡូ រមណីយដ្ឋាន នានា ស្ថិត នៅ ជាប់ ទីតាំង ដង ព្រែក ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ដូច ប្រព័ន្ធ ភ្លើង អគ្គីសនី ប្រើប្រាស់ និង របស់របរ សំខាន់ ៗ ជាដើម ត្រូវ ត្រៀមលក្ខណៈ បង្ការ មុនពេល មាន ទឹក ជំនន់ មកដល់ ។
ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ឲ្យដឹង ថា កម្ពុជា រង ឥទ្ធិពល ព្យុះ ស៉ីន ឡាគូ មកពី សមុទ្រ ចិន ខាងត្បូង ដែល វិវត្ត ទៅជា វិសម្ពាធ ទាប នាំឲ្យ មាន ភ្លៀង ធ្លាក់ និង ខ្យល់ កន្ដ្រាក់ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០២០ នៅ តំបន់ មួយចំនួន ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន ចេញ ណែនាំ មួយ ដល់ រដ្ឋបាល ខណ្ឌ ទាំង ១៤ ចំណុះ ឱ្យ រាជធានី ភ្នំពេញ ឱ្យ ចាត់ វិធានការ តាម ច្បាប់ ចំពោះ សកម្មភាព ជួបជុំ ប្រមូលផ្ដុំ ដែល ធ្វើឡើង គ្មាន ការជូនដំណឹង ជា លាយលក្ខណ៍ អក្សរ មកកាន់ រដ្ឋបាល រាជធានី ភ្នំពេញ ។ នេះ បើ តាម សេចក្តីណែនាំ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
សេចក្តីណែនាំ នេះ បាន ធ្វើឡើង បន្ទាប់ពី រដ្ឋបាល រាជធានី ភ្នំពេញ បាន សង្កេតឃើញ ថា ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ មាន សកម្មភាព ជួបជុំ ប្រមូលផ្ដុំ តវ៉ា ទាមទារ ឱ្យ មាន ការដោះលែង លោក រ៉ុង ឈុន ពាក់ព័ន្ធ នឹង សំណុំរឿង ព្រហ្មទណ្ឌ នៅ ខាងមុខ សាលាដំបូង រាជធានី ភ្នំពេញ ដោយ មិន បាន ជូន ដំណឹង មក អាជ្ញាធរ មាន សមត្ថកិច្ច ។
ក្នុង ន័យ នេះ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ធ្វើ ការណែនាំ ដូចត ទៅ៖
* រាល់ ការជួបជុំ ប្រមូលផ្ដុំ តវ៉ា ទាំងអស់ ត្រូវ ជូនដំណឹង ជា លាយលក្ខណ៍ អក្សរ មក រដ្ឋបាល រាជធានី ភ្នំពេញ ដោយ អនុវត្ត ឱ្យ បាន ត្រឹមត្រូវ តាម ច្បាប់ ស្ដីពី ការធ្វើ បាតុកម្ម ដោយ សន្តិវិធី និង ស្រប តាម វិធានការណែនាំ នានា ស្ដីពី ការបង្ការ - ទប់ស្កាត់ ការរីករាលដាល ការចម្លង វីរុស កូវីដ - ១៩ ។
* រាល់ សកម្មភាព ជួបជុំ ប្រមូលផ្ដុំ ដែល គ្មាន ការជូនដំណឹង ជា លាយលក្ខណ៍ អក្សរ មក រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ ចាត់ទុក ថា ជា ទង្វើ ខុស ច្បាប់ ដែល អាជ្ញាធរ មាន សមត្ថកិច្ច ត្រូវ ចាត់ វិធានការ តាម ច្បាប់ ជាធរមាន ។
* ទទួលបាន សេចក្ដីណែនាំ នេះ នាយក រដ្ឋបាល សាលា រាជធានី ភ្នំពេញ អភិបាល នៃ គណៈ អភិបាល ខណ្ឌ ទាំង ១៤ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ និង អ្នក ពាក់ព័ន្ធ ទាំងឡាយ ត្រូវ អនុវត្ត ដោយ ស្មារតី ទទួលខុសត្រូវ និង មាន ប្រសិទ្ធភាព ខ្ពស់ ៕
រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង ចុះ ពិនិត្យ ការរៀបចំ ទីតាំង សុវត្ថិភាព សម្រាប់ ការពិនិត្យ ធ្វើតេស្ដ សំណាក រក មេរោគ កូវីដ១៩ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប
( សៀមរាប ) ៖ នៅ ព្រឹក ថ្ងៃទី ៣ ខែសីហា ឆ្នាំ ២០២០ នេះ លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល អម ដោយ ប្រតិភូ រួម ដំណើរ បាន ចុះ ពិនិត្យ អគារ ពិសោធន៍ នៅក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ដែល បាន និង កំពុង រៀបចំ បន្ទប់ និង តម្លើង សម្ភារ បរិក្ខា វេជ្ជសាស្ត្រ សម្រាប់ ពិនិត្យ ធ្វើតេស្ដ សំណាក រក មេរោគ កូវីដ១៩ ។
មន្ត្រី នៃ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប បាន គូសបញ្ជាក់ ឲ្យដឹង ថា សម្រាប់ ការរៀបចំ ទាំង បន្ទប់ និង តម្លើង សម្ភារ បរិក្ខា ពេទ្យ និង វេជ្ជសាស្ត្រ ទាំងនេះ គឺជា ការគិតគូរ និង យកចិត្តទុកដាក់ ខ្ពស់ របស់ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជម្ងឺ ឆ្លង នៃ មេរោគ ប្រភេទ ថ្មី ប្រកបដោយ សុវត្ថុ ភាព ខ្ពស់ ផងដែរ ។
SCG ពង្រឹង យុទ្ធសាស្ត្រ អាជីវកម្ម ដើម្បី យកឈ្នះ លើ សមរភូមិ ប្រយុទ្ធ ប្រឆាំង នឹង កូវីដ - ១៩
( ថៃ )៖ ក្រុមហ៊ុន អេសស៊ី ជី (SCG) បាន ពង្រឹង យុទ្ធសាស្ត្រ អាជីវកម្ម ដើម្បី យកឈ្នះ លើ សមរភូមិ ប្រយុទ្ធ ប្រឆាំង នឹង កូវីដ - ១៩ ដោយ ផ្ដោត លើ ភាពបត់បែន លឿន ទាន់ សភាពការណ៍ និង ការគ្រប់គ្រង និរន្តរភាព អាជីវកម្ម រឹងមាំ ទៅ លើ វិស័យ ធុរកិច្ច គីមី ដែល នាំឲ្យ សម្រេចបាន នូវ កំណើន ប្រាក់ ចំណេញ នៅក្នុង លទ្ធផល ប្រតិបត្តិការ អាជីវកម្ម របស់ អេសស៊ី ជី សម្រាប់ ត្រីមាស ទី២ ឆ្នាំ ២០២០ ។
អេសស៊ី ជី នឹង បន្ត ផ្ដោត លើ ការរក្សា ស្ថិរភាព អាជីវកម្ម រយៈពេល វែង រួម ជាមួយនឹង ការបង្កើត នូវ ដំណោះស្រាយ សរុប និង ន វានុវត្តន៍ ដើម្បី បំពេញ តម្រូវការ នៃ សម័យកាល « ប្រក្រតី ភាព ថ្មី » ដោយ ប្រើប្រាស់ យន្តការឌីជីថល ដើម្បី ជំរុញ ការទិញ តាម អនឡាញ និង ជំរុញ អាជីវកម្ម វេចខ្ចប់ ឲ្យ កាន់តែ រីកចម្រើន ខ្លាំង ថែម ទៀត នៅក្នុង ទីផ្សារ អាស៊ាន ។
លទ្ធផល ប្រតិបត្តិការ អាជីវកម្ម ដែល មិន ទាន់ ធ្វើ សវនកម្ម របស់ ក្រុមហ៊ុន សម្រាប់ ត្រីមាស ទី២ ឆ្នាំ ២០២០ បាន កត់ត្រា ចំណូល ពី ការលក់ មាន ចំនួន សរុប ១២.២៨៥ ប៊ីលាន រៀល ( ៣. ០០៦ លាន ដុល្លារ អាមេរិក ) ធ្លាក់ចុះ ១២% បើ ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ មុន ដោយសារតែ ការធ្លាក់ចុះ នៃ តម្លៃ ផលិតផល គីមី ជា ចម្បង ហើយ ចំណូល នៅក្នុង ត្រី មាស នេះ ទៀតសោត គឺ ធ្លាក់ចុះ ៩% បើ ធៀប ទៅនឹង ត្រី មាស មុន ដោយសារ មូលហេតុ នៃ ការថមថយចុះ នៅក្នុង ធុរកិច្ច ស្នូល គ្រប់ មុខ ទាំងអស់ ។
ប្រាក់ ចំណេញ សម្រាប់ ត្រីមាស ទី២ ឆ្នាំ ២០២០ នេះ សម្រេចបាន ១.២០១ ប៊ីលាន រៀល ( ២៩៤ លាន ដុល្លារ អាមេរិក ) កើនឡើង ៣៣ % បើ ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ មុន ហើយ ការកើនឡើង នេះ គឺ ដោយសារ ភាព ល្អ ប្រសើរ ជាង មុន នៅក្នុង អង្គភាព ធុរកិច្ច សំខាន់ ៗ ទាំង បី របស់ អេសស៊ី ជី ដែល ជំរុញ ដោយ ការធ្វើ ប្រសិទ្ធភាព កម្ម ចំណាយ ថ្លៃ ដើម និង និរន្តរភាព អាជីវកម្ម ។
បើ ធៀប នឹង ត្រី មាស មុន ប្រាក់ ចំណេញ នៅក្នុង ត្រីមាស ទី២ ឆ្នាំ ២០២០ នេះ កើនឡើង ៣៥% ដោយសារតែ លទ្ធផល ល្អ ជាង មុន នៅក្នុង អាជីវកម្ម ផ្នែក គីមី របស់ ក្រុមហ៊ុន ។ ចំណូល ពី ការលក់ របស់ អេសស៊ី ជី សម្រាប់ ឆមាស ទី១ នៃ ឆ្នាំ ២០២០ បាន ធ្លាក់ចុះ ៩% បើ ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ ទៅ មិញ ដោយ សម្រេចបាន តែ ២៦.០១២ ប៊ីលាន រៀល ( ៦. ៣៨១ លាន ដុល្លារ អាមេរិក ) ដោយសារតែ ការធ្លាក់ចុះ នៃ តម្លៃ ផលិតផល គីមី ។
ប្រាក់ ចំណេញ សម្រាប់ ឆមាស ទី១ ឆ្នាំ ២០២០ នេះ ធ្លាក់ចុះ ១៣% បើ ធៀប នឹង ឆមាស ទី មួយ ដូចគ្នា នៃ ឆ្នាំ មុន ដោយ សម្រេចបាន ត្រឹមតែ ២. ១០៩ប៊ីលាន រៀល ( ៥១៧ លាន ដុល្លារ អាមេរិក ) ដែល មូលហេតុ នៃ ការធ្លាក់ចុះ ប្រាក់ ចំណេញ នេះ គឺ បណ្ដាល មកពី ការថយចុះ នៃ ប្រាក់ ចំណេញ ពី អាជីវកម្ម ផលិតផល គីមី កាលពី អំឡុង ត្រីមាស ទី១ ឆ្នាំ ២០២០ ។
ខាងក្រោម នេះ ជា សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រុមហ៊ុន អេសស៊ី ជី ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖
« យើង ទាញ គាត់ មក ប្តូរ យុទ្ធសាស្ត្រ ភាព ជា អ្នកដឹកនាំ ប្រើ យុទ្ធសាស្ត្រ គ្រប់គ្រង បុគ្គលិក និង គ្រប់គ្រង អតិថិជន ។ គាត់ បាន រៀន ហើយ គាត់ នឹង ភ្លឺ » ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ឧកញ៉ា បណ្ឌិត យូ សាម៉េត ។
លោក បន្ត ថា សុភាសិត ខ្មែរ ដ៏ មាន អត្ថន័យ មួយ នេះ ស្ថិត នៅក្នុង ចំណែក ជួយ ឲ្យ មាន ភាព ជា អ្នកដឹកនាំ កំពូល ក្នុង ចំណោម ធាតុ ៩ សំខាន់ ៗ ផ្សេង ទៀត ។
អ្នកជំនាញ រូប នេះ បាន ពន្យល់ ថា ដើម្បី ក្លាយជា អ្នកដឹកនាំ កំពូល ត្រូវ ផ្តោត ទៅ លើ ៩ ចំណុច រួម មាន៖
* ១៖ ការកសាង ទំនុកចិត្ត៖ មេដឹកនាំ ចាំបាច់ ឲ្យ បុគ្គលិក ថ្នាក់ ក្រោម ទុកចិត្ត លើ ខ្លួន ១០០ ភាគរយ តែម្តង ។ បើ អ្នក ដឹកនាំ ក្រុមហ៊ុន អ្វី មួយ ត្រូវតែ ឲ្យ គេ ទុកចិត្ត លើ អ្នក ។ បើ មាន តែ បុគ្គលិក មួយ ដែល អត់ ទុកចិត្ត លើ អ្នក ក៏ អាច ធ្វើឲ្យ អាជីវកម្ម ប៉ះពាល់ បាន ដែរ ។
* ៣៖ ពូកែ ចាត់តាំ ង៖ មេដឹកនាំ គឺជា មនុស្ស ម្នាក់ ដែល ពូកែ ចាត់តាំង ឲ្យ បុគ្គលិក ធ្វើការ ។ ឧទាហរណ៍ បុគ្គលិក ដែល ពូកែ ទំនាក់ទំនង ឬ ពូកែ និយាយ ឲ្យ ទៅ ជួប ផ្ទាល់ ជាមួយ អតិថិជន ។ នរណា ពូកែ គ្រប់គ្រង ហិរញ្ញវត្ថុ ត្រូវ ដាក់ អ្នក នោះ ឲ្យ គ្រប់គ្រង ទេពកោសល្យ របស់ បុគ្គលិក ។
* ៦៖ មាន ការប្រកួតប្រជែង និង បង្កើត ការប្រកួតប្រជែង៖ បុគ្គលិក មិន អាច រីកចម្រើន បាន ទេ បើសិនជា គាត់ ធ្វើការ ដោយ គ្មាន ការប្រកួតប្រជែង ។ មាន ន័យ ថា ធ្វើ ល្អ ក៏ មិន បាន អី ហើយ ធ្វើ ល្មម ៗ ក៏ មិន បាន អី ។ អញ្ចឹង នរណា ធ្វើ ល្អ អ្នក ត្រូវ មាន អំណោយ មាន ពាន ឬ មាន អ្វី ឲ្យ ទៅ បុគ្គលិក ។
សូម បញ្ជាក់ ថា សមាសភាព វា គ្មិន ក្នុង វគ្គ សិក្សា ភាព ជា អ្នកដឹកនាំ កំពូល មាន ៦រូប រួម មាន៖
តម្លៃ ប្រេងឥន្ធនៈ លក់ រាយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៥ ខែសីហា៖ តម្លៃ សាំង ធម្មតា ៣.០០០ រៀល និង ម៉ាស៊ូត តម្លៃ ២. ៨០០រៀល ក្នុង ១លីត្រ
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ សេចក្តីជូនដំណឹង ថ្មី មួយ ស្តីពី ការកំណត់ ថ្លៃ ប្រេងឥន្ធនៈ ត្រូវ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០២០ ដោយ សាំង ធម្មតា ត្រូវ លក់ តម្លៃ ៣.០០០ រៀល ក្នុង មួយ លីត្រ និង ម៉ាស៊ូត លក់ ក្នុង តម្លៃ ២. ៨០០រៀល ក្នុង ១លីត្រ៕
ក្រៅពី នាយ អគ្គ សេនាធិការ សេតវិមាន រូប នេះ ប្រធាន ក្រុម យុទ្ធនាការ ឃោសនា បោះឆ្នោត របស់ លោក ត្រាំ គឺ លោក ចេសុន មីល្លឺ (Jason Miller) ក៏ បាន បញ្ជាក់ ឡើងវិញ ផងដែរ ថា ការបោះឆ្នោត ប្រធានាធិបតី អាមេរិក នៅ ត្រូវ ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ០៣ ខែវិចិ្ឆកា ឆ្នាំ ២០២០ តាម ការគ្រោងទុក ហើយ ថា លោក ត្រាំ ក៏ ចង់ឱ្យ ការបោះឆ្នោត ត្រូវ រៀបចំឡើង តាម ការគ្រោងទុក នេះ ដែរ ។
គួរ ជម្រាប ថា ក្រោយ ទទួលរង ការរិះគន់ ពីសំណាក់ គណបក្ស ប្រជាធិបតេយ្យ និង គណបក្ស សាធារណរដ្ឋ ខ្លួន ឯង លោក ដូណាល់ ត្រាំ បាន ដក គំនិត ចង់ ពន្យារ ពេល បោះឆ្នោត ទៅ វិញ ដោយ អះអាង ថា លោក ចង់ឱ្យ ការបោះឆ្នោត ដំណើរការ ទៅ តាម ការគ្រោងទុក ។ ពាក់ព័ន្ធ នឹង កាលបរិច្ឆេទ បោះឆ្នោត ប្រធានាធិបតី អាមេរិក មិន មាន សិទ្ធិ លើក ពេល នោះ ទេ ខណៈ រដ្ឋធម្មនុញ្ញ អាមេរិក បាន ផ្តល់ អំណាច ឲ្យ សភា ដើម្បី ជា អ្នក កំណត់ ថ្ងៃ បោះឆ្នោត ៕
អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន ប្រគល់ ជូន ពលរដ្ឋ ជាង ៣០០ គ្រួសារ នៅ ឃុំ ទង ត្រឡាច ស្រុក ស្រីសន្ធ រ
( កំពង់ចាម ) ៖ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ត្រូវបាន លោក ឧកញ៉ា ឡូវ ហ៉ឹង ទីប្រឹក្សា សម្ដេច តេជោ ហ៊ុន សែន ប្រគល់ ជូន ប្រជាពលរដ្ឋ ជាង ៣០០ គ្រួសារ រស់ នៅក្នុង ភូមិ ជន្លាត់ ដៃ ឃុំ ទង ត្រឡាច ស្រុក ស្រីសន្ធ រ ខេត្ត កំពង់ចាម ។
លោក ចាស់ ជឿន មេឃុំ ទង ត្រឡាច បាន ឲ្យដឹង ថា ប្រជាពលរដ្ឋ ទូទាំង ឃុំ ទង ត្រឡាច បាន ចង់ ចាំ ទុក ជា ប្រវត្តិសាស្រ្ត ចំពោះ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្តល់ អំណោយ ដោយ ជួយ ឧបត្ថម្ភ ការកសាង ផ្លូវ បេតុង ១ខ្សែ ប្រវែង ៧.៥០០ ម៉ែត្រ និង ទទឹង ៧ម៉ែត្រ តភ្ជាប់ ឆ្ពោះទៅ ផ្លូវ ជាតិ លេខ ៨ នៅក្នុង ឃុំ ទង ត្រឡាច ។
លើស ពី នេះ ឧកញ៉ា អែល សារ៉ុម និង លោក ប៊ុន វុត្ថា បាន ជំរាប ជូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ថា ផ្លូវ បេតុង នេះ នឹង ស្ថាបនា រួចរាល់ នា ពេល ខាងមុខ នេះ ថែមទាំង ភ្លើង នៅ តាម អម សងខាង ផ្លូវ ដោយ បំពាក់ ប្រព័ន្ធ ស៊ុលឡា ដើម្បី ជួយ សម្រួល ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ និង អាច ឲ្យ លោក តា លោកយាយ ព្រះសង្ឃ ងាយស្រួល ក្នុង ការធ្វើដំណើរ ផង រួមទាំង ធ្វើឲ្យ ដី និង លំនៅដ្ឋាន របស់ ប្រជាពលរដ្ឋ តំបន់ នេះ មាន តម្លៃ ។
លោក ឧកញ៉ា ឡូវ ហ៉ឹង បាន បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ទាំងអស់ សូម អរគុណ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន បង្កើត សន្ថិភាព ជូន ប្រជាពលរដ្ឋ ដោយ បាន រំដោះ ប្រជាពលរដ្ឋ ឲ្យ រួចផុត ពី សេចក្តីស្លាប់ ក្នុង របប ដ៏ ឃោរឃៅ ខ្មៅង ងឹង ត រហូតមកដល់ ពេលនេះ ធ្វើឲ្យ ប្រទេសជាតិ បាន កែប្រែ មុខមាត់ ថ្មី ជា បន្តបន្ទាប់ ។
បច្ចុប្បន្ន ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ស្ថិរភាព សង្គម សន្តិសុខ ស្បៀង និង កំណើន សេដ្ឋកិច្ច ជា មធ្យម ៧ភាគរយ ក្នុង មួយ ឆ្នាំ ៗ ដែល ធ្វើឲ្យ ការវិវឌ្ឍន៍ រីកចម្រើន ប្រែ មុខមាត់ ថ្មី ជា បណ្តើរ សាកសម ជា ប្រទេស មាន ឯករាជ្យភាព អធិបតេយ្យភាព សាមគ្គីភាព បង្រួបបង្រួម ជាតិ និង បូរណភាព ទឹកដី ទាំង នៅក្នុង តំបន់ និង លើ ឆាក អន្ត ជាតិ ។
ឧកញ៉ា ឡូវ ហ៊ឹង បាន បន្ថែម ថា តាមរយៈ ការចារិក ទុក នូវ ពាក្យស្លោក ដែល នឹង ដក់ ជាប់ ជាមួយ ប្រជាពលរដ្ឋ និង អ្នកដឹកនាំ កម្ពុជា គ្រប់ ជំនាន់ គឺ « អរគុណ សន្តិភាព » ម៉្យាង វិញ ទៀត ការនាំគ្នា ចងចាំ និង គិត ដល់ សន្តិភាព គ្រប់ នាទី គឺ ធ្វើឲ្យ ប្រទេស កម្ពុជា កាន់តែ មាន សុវត្ថិភាព ស្ថិរភាព និង សន្តិភាព យូរអង្វែង ដែល ជា បំណងប្រាថ្នា របស់ ពលរដ្ឋ ខ្មែរ គ្រប់ ៗ រូប ហើយ មាន សន្តិភាព ទើប មាន អ្វី ៗ គ្រប់ យ៉ាង មក ទល់ សព្វ ថ្ងៃ ។
ពិធី ប្រគល់ និង ទទួល ផែនទី ខាងលើ នេះ បាន ធ្វើឡើង នៅ ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ម៉ុក បាយ ខេត្ត តៃ និញ វៀតណាម ដែល គណៈប្រតិភូ កម្ពុជា ដឹកនាំ ដោយ លោក វ៉ា គឹម ហុង ទេសរដ្ឋមន្រ្តី ទទួលបន្ទុក កិច្ចការ ព្រំដែន និង ជា ប្រធាន គណៈកម្មការ ចម្រុះ ខណ្ឌ សីមា និង បោះ បង្គោល ព្រំដែន គោក កម្ពុជា និង គណៈប្រតិភូវៀតណាម ដឹកនាំ ដោយ លោក ឡេ ហួយ ទ្រុង អនុ រដ្ឋមន្រ្តី នៃ ក្រសួង ការបរទេស និង ជា ប្រធាន គណៈកម្មការ ចម្រុះ ខណ្ឌ សីមា និង បោះ បង្គោល ព្រំដែន គោក វៀតណាម ។
លោកស្រី កុយ ពិសី អនុប្រធាន លេខាធិការដ្ឋាន អចិន្រ្តៃយ៍ នៃ អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន បាន បញ្ជាក់ ឲ្យដឹង ថា ផែនទី ឋាន លេខា ព្រំដែន កម្ពុជា - វៀតណាម មាត្រដ្ឋាន ១/ ២៥ ០០០ នេះ បាន បង្ហាញ ពេញលេញ លទ្ធផល ខណ្ឌ សីមា និង បោះ បង្គោល ព្រំដែន ប្រមាណ ជា ៨៤ % ដែល ប្រទេស ទាំង ពី សម្រេចបាន ។
លោកស្រី បញ្ជាក់ ទៀត ថា ផែនទី នេះ ជា ផែនទី ទំនើប សម័យ ឌីជីថល ៤.០ ដែល បង្ហាញ យ៉ាង ច្បាស់លាស់ ខ្សែ ព្រំដែន បង្គោល ព្រំដែន រួម និង ស្ថានភាព ភូមិសាស្រ្ត នៅលើ ដី ជាក់ស្តែង បាន យ៉ាង ជាក់លាក់ ងាយស្រួល ក្នុង ការ ប្រើប្រាស់ មិន ដូច ផែនទី បោន ខ្នាត ១/ ១០០០០០ ដែល មាន តែ ខ្សែ ព្រំដែន ហើយ មិន មាន អ្វី បង្ហាញ ជាក់លាក់ ច្រើន ជាង នេះ ។
សូម បញ្ជាក់ ថា កម្ពុជា - វៀតណាម មាន ព្រំដែន គោក ជាមួយគ្នា ប្រវែង ១.២៧០ គីឡូម៉ែត្រ ។
សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោក ង្វៀន សួន ហ្វ៊ុក នាយក រដ្ឋមន្ត្រី វៀតណាម កាលពី ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០១៩ បាន ចុះហត្ថលេខា ទទួលស្គាល់ បង្គោល ព្រំដែន ប្រទេស ទាំង ពីរ ដែល សម្រេចបាន ចំនួន ៨៤ ភាគរយ ។ ការចុះហត្ថលេខា ទទួលស្គាល់ បង្គោល ព្រំដែន នៃ ប្រទេស ទាំង ពីរ គឺជា ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ថ្មី មួយ ទៀត សម្រាប់ កម្ពុជា និង វៀតណាម ។
ដូច្នេះ ចង់ ដឹង មូលហេតុ កាន់តែ ច្បាស់ ថា មាន រឿងរ៉ាវ អ្វី បង្កប់ ក្នុង បេះដូង លោកស្រី គង់ ណាក់ នីន បានជា លោកស្រី សុខចិត្ត ចំណាយ លុយ រាប់ ពាន់ ដុល្លារ ជួយ ទៅដល់ ជន បរទេស ជនជាតិ អ៊ុយក្រែន សូម ទស្សនា វីដេអូ ខាងក្រោម៖
បើ តាម ក្រសួង សុខាភិបាល អ្នកជំងឺ ម្នាក់ ដែល ជាសះស្បើយ នេះ ជា ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ៣៨ ឆ្នាំ មាន អាស័យដ្ឋាន នៅ សង្កាត់ បឹងកេងកង៣ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ជា អ្នកធ្វើដំណើរ មកពី ប្រទេស ឥណ្ឌូណេស៊ី តាម ជើងហោះហើរ មក កម្ពុជា ត្រូវបាន ព្យាបាល ជាសះស្បើយ ដោយ ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ ចំនួន ០២ ដង ត្រូវបាន អនុញ្ញាតឱ្យ ចេញ ពី មណ្ឌល សុខភាព ចាក់អង្រែ រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ០៧៖០០ ព្រឹក ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ ស្ថានភាព ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា បាន រកឃើញ អ្នកជំងឺ សរុប ២៤០ នាក់ ( ស្ត្រី ៤៦នាក់ និង បុរស ១៩៤ នាក់ ) ក្នុង នោះ ចំនួន អ្នក ព្យាបាល ជាសះស្បើយ សរុប ទូទាំង ប្រទេស មាន ចំនួន ១៩៧ នាក់ ( ស្រី ៤៣ នាក់ និង បុរស ១៥៤ នាក់ ) និង អ្នក សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ រដ្ឋ មាន ចំនួន សរុប ៤១ នាក់ និង អ្នក សម្រាក ព្យាបាល នៅ បន្ទប់ ដោយឡែក ក្នុង ស្ថានទូត អាមេរិក ប្រចាំ កម្ពុជា ២នាក់ ៕
បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ១នាក់ និង របួស ៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០២ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១នាក់ និង របួស ធ្ងន់ ៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន ប្រកាន់ ស្តាំ បត់ គ្រោះថ្នាក់ និង មិន គោរព សិទ្ធិ ៕
លោក ហ៊ុន ម៉ាណែត បើក កិច្ចប្រជុំ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ផ្សព្វផ្សាយ សេចក្តីណែនាំ ស្តីពី ការកែសម្រួល និង បំពេញ គោលការណ៍ អំពី រចនាសម្ព័ន្ធ នៃ យុវជន គណបក្ស
( ភ្នំពេញ ) ៖ នា រសៀល ថ្ងៃសៅរ៍ ១២កើត ខែ ស្រា ពណ៍ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៤ ត្រូវនឹង ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០២០ លោក ហ៊ុន ម៉ាណែត សមាជិក គណៈ អចិន្រ្តៃយ៍ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល បាន អញ្ជើញ ជា អធិបតីភាព ដ៏ ខ្ពស់ ខ្ពស់ ក្នុង កិច្ចប្រជុំ ពេញ អង្គ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ដែល មាន វត្តមាន ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ( យ . គ. ក) ។
កិច្ចប្រជុំ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល នា ពេល ម្សិលមិញ នេះ បាន ប្រារព្វឡើង នៅក្នុង វិមាន ៧មករា ទីស្នាក់ការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា ។
កិច្ចប្រជុំ បាន ធ្វើ ការផ្សព្វផ្សាយ សេចក្តីណែនាំ ស្តីពី ការកែសម្រួល និង បំពេញ គោលការណ៍ អំពី រចនាសម្ព័ន្ធ នៃ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល និង សេចក្តីសម្រេច ស្តីពី ការកែសម្រួល តួនាទី ភាកិច្ច នៃ រចនាសម្ព័ន្ធ និង របៀបរបប ធ្វើ ការងារ របស់ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ក្នុង ន័យ ជំរុញ ការយល់ដឹង និង ពង្រឹង ប្រសិទ្ធភាព នៃ ការអនុវត្ត ការងារ ព្រមទាំង បាន លើក ទិសដៅ ការងារ បន្ត របស់ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ថ្នាក់ កណ្តាល ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ . ឧត្តមសេនីយ៍ ឯក អ៉ិន បូរ៉ា អគ្គ ស្នងការ រង ទទួល ផែន និង ចង្អុលបង្ហាញ យ៉ាង យកចិត្តទុកដាក់ ពី លោក ឧត្តមសេនីយ៍ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ឲ្យ កម្លាំង ជំនាញ បើក ការស្រាវជ្រាវ បន្ទាន់ ក្រោយ កើត ហេតុ ។
បច្ចុប្បន្ន ជន ដៃ ដល់ កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន ប្រគល់ឲ្យ អធិការដ្ឋាន នគរបាល ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ដើម្បី ប្រគល់ បន្ដ ឲ្យ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ដែល ជា ម្ចាស់ ករណី ដើម្បី កសាង សំណុំរឿង ចាត់ការបន្ដ តាម នីតិវិធី ៕ តុលាការ សម្រេច ឃុំ ខ្លួន ជនជាតិ ចិន ២នាក់ ពាក់ព័ន្ធ នឹង ករណី ចាប់ ជំរិត នៅ ខណ្ឌ សែនសុខ
លោក គុជ គឹម ឡុង បាន បញ្ជាក់ ថា លោកស្រី យិច ឈាណា វី ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច ឃុំ ខ្លួន ជនជាតិ ចិន ទាំង ពីរ នាក់ នេះ ដោយ ចប់ ប្រកាន់ ពី បទ ជំរិត ទារ ប្រាក់ ។
សូម បញ្ជាក់ ថា កម្លាំង នគរបាល ខណ្ឌ សែនសុខ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក ហួរ ម៉េង វ៉ាង អធិការ នរគ បាល ខណ្ឌ សែន សុខ កាលពី ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ បាន ចុះ ប្រតិបត្ត ការរំដោះ ជនរងគ្រោះ ដែល ត្រូវបាន ជនជាតិ ចិន ដូចគ្នា ធ្វេី ការ ចាប់ ជំរិត ។
ក្រោយ កេីត ហេតុ សមត្ថកិច្ច បាន ធ្វេី ការកសាង សំណុំរឿង បញ្ជូន ជនសង្ស័យ ទៅកាន់ តុលាការ ដេីម្បី ចាក់ ការ តាម នីតិវិធី ៕ កុំ ឲ្យ គ្រឿងញៀន មក បំផ្លាញ យើង និង សង្គម ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០២ ខែសីហា៖ បង្ក្រាប ២៧ករណី ឃាត់ខ្លួន ៤៩ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១០ករណី និង ជួញដូរ ១៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤៩ នាក់ ។
លោក ជា ម ច័ន្ទ សោភ័ណ បាន សម្តែង នូវ ការសោកស្តាយ ក៏ ដូចជា ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើរ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ចំពោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ទាំងអស់ និង ជន ងាយ រងគ្រោះ ដោយ ក្តី នឹករលឹក និង អាណិតអាសូរ បំផុត ។
លោក ជា ម ច័ន្ទ សោភ័ណ បាន បន្ត ថា ក្រោម ការយកចិត្តទុកដាក់ បំផុត ពី សំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត គឺ តែងតែ គិតគូរ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ដោយ មិន ឱ្យ នរណា ម្នាក់ អត់ អាហារ នៅ រងារ កំព្រា ម្នាក់ឯង នោះ ឡើយ គឺ ទីណា មាន ទុក្ខលំបាក មាន កាកបាទ ក្រហម កម្ពុជា គ្រប់ ទីកន្លែង គ្រប់ ពេលវេលា ដោយ មិន រើសអើង ពូជសាសន៍ ពណ៍ សម្បុរ ឬ និន្នាការ នយោបាយ អ្វី នោះ ឡើយ ។
សូម ជម្រាប ថា ចំពោះ អំណោយ ដែល ចែកជូន នា ពេល នោះ សម្រាប់ គ្រួសារ រង ការខូចខាត ដោយ ខ្យល់ កន្ត្រាក់ ១៦ គ្រួសារ ទទួលបាន គ្រឿង ឧបភោគ បរិភោគ និង ( ថវិកា ១០ម៉ឺន រៀល ជូន ០២ គ្រួសារ ខូចខាត ផ្ទះ ធ្ងន់ធ្ងរ និង ថវិកា ០៥ ម៉ឺន រៀល និង ជូន ១៤គ្រួសារ ដែល ខូចខាត ផ្ទះ តិចតួច ) ចំណែក ប្រជាពលរដ្ឋ ៣៦ គ្រួសារ ជន ងាយ រងគ្រោះ មាន ជីវភាព ក្រីក្រ លំបាក ក្នុង ១គ្រួសារ ៗ ទទួលបាន គ្រឿង ឧបភោគ បរិភោគ ដូចគ្នា ព្រមទាំង ថវិកា ចំនួន ០២ ម៉ឺន រៀល ៕
តំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ ជំរុញឱ្យ មន្ត្រី នៅ តាម មូលដ្ឋាន ត្រូវ ផ្តល់ សេវា សាធារណ ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ គុណភាព
( កំពង់ធំ )៖ លោក ជា អឿង អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ប្រាសាទ បល្ល័ង្ក បាន ថ្លែង ជំរុញ ឱ្យ ដល់ មន្ត្រី នៅ តាម មូលដ្ឋាន ត្រូវ ផ្តល់ សេវា សាធារណ ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ គុណភាព តម្លាភាព ប្រសិទ្ធភាព ងាយស្រួល រក្សា សុវត្ថិភាព ឲ្យបាន ល្អ រឹងមាំ និង បង្កើន នូវ សមត្ថភាព របស់ ខ្លួន ឲ្យ ស្រប ទៅ តាម បច្ចេកទេស ទំនើប នា ពេល បច្ចុប្បន្ន ស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល និង សកលលោក ។
លោក ជា អឿង បាន លើកឡើង ជំរុញ បែប នេះ នា ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០២០ ក្នុង ឱកាស ដែល លោក ជា អធិបតី ប្រកាស ទទួលស្គាល់ ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ឃុំ សាលា វិស័យ ក្នុង ស្រុក ប្រាសាទ បល្ល័ង្ក ខេត្ត កំពង់ធំ ។
លោក ជា អឿង បាន បញ្ជាក់ ថា មន្ត្រី មាន តួនាទី សំខាន់ ក្នុង ការបម្រើ ប្រជាពលរដ្ឋ ដូចនេះ ត្រូវ ខិតខំ ប្រឹងប្រែង ធ្វើ អំពើ ល្អ ហើយ ត្រូវ មាន ការសម្រេចចិត្ត ឱ្យ បាន ត្រឹមត្រូវ មុននឹង ជឿ លើ អ្វី មួយ ពោល មិន ត្រូវ ជឿ លើ ការឃោសនា ឬ ការសន្យា ខ្យល់ របស់ ជន ខិលខូច នោះ ឡើយ ជាពិសេស នោះ ត្រូវ រួមគ្នា ថែរក្សា សន្តិភាព ឱ្យ បាន ស្ថិតស្ថេរ គង់វង្ស ដើម្បី រក្សា សេចក្ដីសុខសាន្ត របស់ ប្រជាពលរដ្ឋ បន្ត ការកសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ។
លោក ជា អឿង ក៏ បាន ប្រាប់ ឱ្យ ថ្នាក់ដឹកនាំ ភូមិ - ឃុំ ត្រូវតែ រៀបចំ ទំាង កាយវិការ អត្តចរិក ទាំង ឯកសណ្ឋាន ឱ្យ មាន លក្ខណៈ ជា មន្ត្រី ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ មាន ទំនុក ចិត្ត និង មាន លទ្ធភាព ដោះស្រាយ គ្រប់ បញ្ហា ត្រូវ មាន ភាពទទួលខុសត្រូវ បែងចែក តួនាទី ការងារ ឱ្យ បាន ច្បាស់លាស់ ដើម្បី ជា ដើមទុន សម្រាប់ ការទទួល ជោគជ័យ ក្នុង ការងារ របស់ ខ្លួន ៕
លោក កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង ប្រកាស សេចក្ដីសម្រេច ស្ដីពី ការតែងតាំង មន្រ្តី គណៈកម្មាធិការ គណបក្ស ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន
( ភ្នំពេញ ) ៖ លោក កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង នាយក រង ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន បាន អញ្ចើញ ប្រកាស សេចក្ដីសម្រេច ស្ដីពី ការតែងតាំង មន្រ្តី គណៈកម្មាធិការ គណបក្ស ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន បន្ថែម និង គណៈកម្មាធិការ សាខា គណបក្ស ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន មាន « ខ៨ » ដើម្បី ពង្រឹង ការងារ ចុះ ជួយ មូលដ្ឋាន ឱ្យ កាន់តែ ប្រសើរឡើង ថែម ទៀត កាលពី រសៀល ថ្ងៃទី ២ ខែសីហា ។
កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង បាន ថ្លែង ថា ការតែងតាំង មន្រ្តី គណៈកម្មាធិការ គណបក្ស ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន គឺ ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការងារ ក្នុង ការចុះ ជួយ ដោះស្រាយ ទុក្ខលំបាក បញ្ហា ប្រឈម នានា នៅ តាម មូលដ្ឋាន ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ទាន់ ពេលវេលា ជាពិសេស នៅពេល ជួប គ្រោះមហន្តរាយ ផ្សេង ៗ ។
កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង បាន នែនាំ ដល់ ក្រុមការងារ គណបក្ស ខុទ្ទកាល័យ សម្ដេច តេជោ ហ៊ុន សែន បន្ត ចុះ ជួយ តាម មូលដ្ឋាន ជាប្រចាំ ដើម្បី ស្វែងយល់ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ និង ស្ដាប់ សំណូមពរ បញ្ហា ប្រឈម នានា ដូចជា សេវា សាធារណៈ សេវា សំណូមពរ សេវា តម្រូវការ របស់ ប្រជាពលរដ្ឋ ដោះស្រាយ ឱ្យ បាន ទាន់ ពេលវេលា ដើម្បី បង្កើន ជំនឿ ទុកចិត្ត មក លើ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក បាន ណែនាំ ត្រូវ បន្ត ការងារ របស់ ខ្លួន ឱ្យ បាន សកម្ម ក្នុង ស្មារតី សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ខ្ពស់ ឆន្ទៈ មុត ស្រួច ធ្វើជា ស្នូល នៃ ចលនា របស់ ប្រជាជន ដើម្បី សម្រេចបាន សមិទ្ធផល ធំ ៗ ថ្មី ៗ ទៀត ជូន ជាតិ និង ប្រជាជន ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ និង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី ៧ ឆ្នាំ ២០២៣ ។
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ០៤ ខែសីហា ឆ្នាំ ២០២០ ស្អែក នេះ នឹង រៀបចំ វេទិកា ពិភាក្សា វាយតម្លៃ សកម្មភាព ស្ដីពី សន្និសីទ សារព័ត៌មាន ស្ដីពី វឌ្ឍនភាព ការងារ ឆ្នាំ ២០១៩ និង ទិសដៅ ការងារ បន្ដ ឆ្នាំ ២០២០ របស់ ក្រសួង ស្ថាប័ន និង រដ្ឋបាល រាជធានី - ខេត្ត ។
យោង តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ថា វេទិការ នេះ នឹង ធ្វើឡើង ក្រោម អធិបតីភាព លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ដ្រី ក្រសួង ព័ត៌មាន និង លោក ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
ជា ការកត់សម្គាល់ តាមរយៈ សន្និសីទ សារព័ត៌មាន របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ដែល បាន រៀបចំ ធ្វើឡើង យ៉ាង ទៀត ទាត់ កន្លងមក បាន បង្ក នូវ បរិយាកាស យ៉ាង ងាយស្រួល ដល់ អ្នកសារព័ត៌មាន ជាតិ និង អន្ដរជាតិ ព្រោះថា សន្និសីទ សារព័ត៌មាន នេះ បាន ប្រមូលផ្ដុំ នូវ ព័ត៌មាន មួយ កន្លែង ក្នុង ពេល តែ មួយ ៕ តុលាការ ខេត្ត កណ្ដាល សម្រេច ឃុំ ខ្លួន ម្ចាស់ ទីតាំង បញ្ចាំ ម៉ូតូ ខុស ច្បាប់ មួយ កន្លែង ពី បទ ទទួល ផល ចោរកម្ម
( កណ្ដាល ) ៖ លោក ថោង ផល្លី រង្ស៊ី ចៅក្រម ស៊ើបសួរ សាលាដំបូង ខេត្ត កណ្ដាល នៅសៀល ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០២០ បាន សម្រេច ឃុំ ខ្លួន បុរស ម្នាក់ ឈ្មោះ គឹម ឡេង សល់ ជា ម្ចាស់ ទីតាំង បញ្ចាំ ម៉ូតូ ខុស ច្បាប់ ជា បណ្ដោះអាសន្ន ពី បទ ទទួល ផល ចោរកម្ម ខណៈ ស្ត្រី ជា ប្រពន្ធ ពុំ ត្រូវបាន នាំ ខ្លួន មក សាកសួរ នោះ ឡើយ ខណៈ សេចក្ដី រាយការណ៍ ឲ្យដឹង ថា ប្ដី - ប្រពន្ធ រូប នេះ មិន ត្រឹមតែ បើក ទទួលបញ្ចាំ ម៉ូតូ ខុស ច្បាប់ ប៉ុណ្ណោះ ទេ ថែមទាំង ជា មេ អាប៉ោង ធំ ប្រចាំ ឃុំ វិហារ សួគ៍ ស្រុក ខ្សាច់ កណ្ដាល ថែម ទៀត ផង ។
គួរ ជម្រាប ថា ទីតាំង ហាង បញ្ចាំ ខុស ច្បាប់ មួយ កន្លែង ដែល មាន ម្ចាស់ ឈ្មោះ គឹម ឡេងសល់ ភេទ ប្រុស មុខរបរ ទទួលបញ្ចាំ ម៉ូតូ និង ប្រពន្ធ ឈ្មោះ វ៉ា ថា រី ភេទ ស្រី អាយុ ៣៣ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ លក់ដូរ មាន ទីលំនៅ ភូមិ ស្វាយ មាស ឃុំ វិហារ សួគ៌ ស្រុក ខ្សាច់ កណ្ដាល ខេត្ត កណ្ដាល ត្រូវបាន សមត្ថកិច្ច ចុះ បិទ ទីតាំង នា ថ្ងៃទី ០១ ខែ សីហា ឆ្នាំ ២០២០ ។
បើ តាម សមត្ថកិច្ច ម៉ូតូ មួយចំនួន ដែល ម្ចាស់ ទីតាំង ទទួលបញ្ចាំ នេះ គឺជា ម៉ូតូ ដែល ជន ទុច្ចរិក កាច់ ក និង លួច គេ យកមក បញ្ចាំ ព្រោះថា គ្រាប់ សោរ ម៉ូតូ មាន សភាព បែក ខ្ទេច និង មាន សភាព មិន ប្រក្រតី ច្រើន ។
គួរ បញ្ជាក់ ថា នាវា ចម្បាំង ទាំង ពីរ គ្រឿង ខាងលើ នេះ គឺជា នាវា ដែល ត្រូវបាន ដាក់ ឲ្យ ដំណើរ នៅក្នុង ជួរ កងទ័ព ជើងទឹកចិន ។ ចិន ក៏ គ្រោង ផលិត នាវា ប្រភេទ នេះ បន្ថែម ទៀត ផងដែរ រួម ជាមួយ នាវា ផ្ទុក ឧទ្ធម្ភាគចក្រ ៕
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ០៣ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ផលិត វីដេអូ ថ្មី មួយ ស្តីពី ការណែនាំ ការប្រើប្រាស់ ប្រព័ន្ធ គ្រប់គ្រង ការស្នើសុំ លើកទឹកចិត្ត ផ្នែក ពន្ធដារ សម្រាប់ សហគ្រាស ធុន តូច និង មធ្យម ក្នុង វិស័យ អាទិភាព ដើម្បី ផ្តល់ ភាពងាយស្រួល ដល់ អ្នក ស្នើសុំ ៕
សូម ទស្សនា វីដេអូ ណែនាំ ដូច ខាងក្រោម៖
បច្ចុប្បន្ន នេះ អាជ្ញាធរ វៀតណាម បាន នឹង កំពុង ត្រៀម ធ្វើតេស្ត ទៅ លើ ប្រជាជន ទាំង១.១លាន នាក់ នៃ ទីក្រុង ដាណាង (Danang) ដែល ជា កន្លែង ចំណុច កណ្តាល ថ្មី នៃ ការផ្ទុះ រាលដាល ជំងឺ កូវីដ១៩ របស់ ប្រទេស វៀតណាម ។ សមត្ថភាព នៃ ការធ្វើតេស្ត ត្រូវបាន អាជ្ញាធរ អះអាង ថា នឹង បង្កើន ឲ្យ ទៅដល់ ចន្លោះ ៨ ពាន់ - ១ម៉ឺន ក្នុង មួយ ថ្ងៃ ដោយ ពួកគេ គ្រោង ធ្វើតេស្ត ប្រជាជន ទាំងអស់ ដែល រស់ នៅក្នុង ទីក្រុង នេះ គឺ ១.១លាន នាក់ ។
រថយន្ត ល្បាត ចំនួន ០២ គ្រឿង ត្រូវបាន ប្រគល់ ជូន កងរាជអាវុធហត្ថ ខណ្ឌ ព្រែក ព្នៅ និង កងរាជអាវុធហត្ថ ខណ្ឌ សែនសុខ
ពិធី ប្រគល់ រថយន្ត ត្រូវបាន រៀបចំឡើង នៅ មូលដ្ឋាន កងរាជអាវុធហត្ថ ព្រែក ព្នៅ ក្រោម វត្តមាន លោក វរសេនីយ៍ ឯក ភួង សុភី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខណ្ឌ ព្រែក ព្នៅ និង លោក វរសេនីយ៍ ឯក ព្រុំ សក្តា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខណ្ឌ សែន សុខ ព្រមទាំង លោក ឧកញា ឫទ្ធី រស្មី អគ្គ នាយក ក្រុមហ៊ុន K. 99Group និង លោក ឧកញា រស់ ឌីណែត និង មន្ត្រី កង កំលាំង ជាច្រើន រូប ទៀត ដែរ ។
