( ភ្នំពេញ ) ៖ ក្រុម ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ អគ្គ ស្នងការ នគរបាល ជាតិ ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ចេញ បំភ្លឺ ជូន សាធារណជន អ្នកសារព័ត៌មាន ពិសេស អ្នក និយម ប្រើប្រាស់ បណ្ដាញ ទំនាក់ទំនង សង្គម ឲ្យបាន ជ្រាប ពាក់ព័ន្ធ នឹង ករណី ជ្រុះ បាត់ ចិញ្ចៀន ពេជ្រ មួយ វង់ និង ត្រូវ អ្នកជិតខាង រើស បាន ទាមទារ ប្រាក់ ចំនួន ៦០០ ដុល្លារ ជា ថ្នូរ នឹង ការប្រគល់ ចិញ្ចៀន ពេជ្រ នោះ មក ម្ចាស់ ដើម វិញ ។
នៅលើ បណ្តាញ សង្គម នៅ ថ្ងៃ នេះ មាន ការបញ្ចេញមតិ ផ្សេង ៗ ចំពោះ ករណី ជ្រុះ បាត់ ចិញ្ចៀន ពេជ្រ មួយ វង់ ហើយ ត្រូវបាន ស្រ្តី ម្នាក់ រើស បាន បែរជា ត្រូវ ម្ចាស់ ប្តឹង ទៅកាន់ នាយកដ្ឋាន ព្រហ្មទណ្ឌ រហូត មាន លិខិត កោះហៅ ស្រ្តី ដែល រើស បាន នោះ ចូលទៅ បំភ្លឺ ទៀតផង ហើយ ត្រូវបាន អ្នកលេង ហ្វេសបុក ខ្លះ ចាត់ទុក ថា ជា រឿង អយុត្តិធម៌ ។
ឈ្មោះ យឹម វុទ្ធី បាន ទៅ ជួប ឈ្មោះ ជើង សៀម ឆេង សាកសួរ អំពី ចិញ្ចៀន តែ ត្រូវ គាត់ បាន ប្រាប់ ថា គាត់ ពិតជា រើស បាន ចិញ្ចៀន នោះ ប្រាកដ មែន តែ គាត់ បាន ប្រគល់ឲ្យ ទៅ កូនប្រុស របស់ គាត់ ឈ្មោះ សេង កុសែន បាត់ ទៅ ហើយ ។ ក្រោយមក លោក បាន ជួប ជាមួយ ប្រពន្ធ សេង កុសែន ឈ្មោះ លី ស្រី អូន សុំ លេខ ទូរស័ព្ទ ទំនាក់ទំនង ដើម្បី សុំ ចិញ្ចៀន វិញ តែ គាត់ ពុំ ព្រម ឲ្យ លេខ ទូរស័ព្ទ ប្ដី គាត់ ឡើយ ។
លុះ ដល់ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ឈ្មោះ យឹម វុទ្ធី បាន សម្រេច ដាក់ពាក្យបណ្ដឹង នៅ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ដើម្បី ធ្វើ ការស្រាវជ្រាវ និង អនុវត្ត នីតិវិធី ។ បន្ទាប់ពី ទទួលបាន ពាក្យបណ្ដឹង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន រៀបចំ កសាង សំណុំរឿង នីតិវិធី តាម ផ្លូវ ច្បាប់ និង បាន ស្នើសុំ ការអង្កេត បឋម ពី តំណាង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ សង្ឃឹម ថា សាធារណជន អ្នកសារព័ត៌មាន និង អ្នក និយម ប្រើប្រាស់ បណ្ដាញ ទំនាក់ទំនង សង្គម មេត្តា ទទួល ជ្រាប ជា ព័ត៌មាន និង សូម មេត្តា កុំ ធ្វើ ការសន្និដ្ឋាន វាយតម្លៃ រឿង ហេតុ ដោយ ពុំ មូលដ្ឋាន ភស្តុតាង និង ការស៊ើប បញ្ជាក់ ឲ្យបាន ច្បាស់លាស់ ៕
មន្ត្រី ជាន់ ខ្ពស់ កិច្ចការ ព្រំដែន ប្រកាស ចែក សៀវភៅ ស្តីពី រឿងរ៉ាវ ព្រំដែន កម្ពុជា - វៀតណាម ដោយ ឥត គិត ថ្លៃ ដើម្បី ជា មូលដ្ឋាន ដល់ អ្នកសិក្សា
ភ្នំពេញ ) ៖ លោកស្រី កុយ ពិសី អនុប្រធាន អចិន្រ្តៃយ៍ លេខាធិការ រដ្ឋាន អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន ប្រកាស ចែក សៀវភៅ ៤ក្បាល ពាក់ព័ន្ធ នឹង សាវតា និង ការចរចារ រក ដំណោះស្រាយ ព្រំដែន កម្ពុជា ជាមួយនឹង វៀតណាម » ដោយ ឥត គិត ថ្លៃ ជូន សិស្ស និស្សិត និង ពលរដ្ឋ ខ្មែរ ដែល មាន បំណង ចង់ សិក្សា ស្វែងយល់ ។
ការផ្ដល់ សៀវភៅ នេះ នឹង ធ្វើឡើង នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ជាន់ ទី៥ អគារ មិត្តភាព ចាប់ពី ថ្ងៃ ប្រកាស រៀងរាល់ ម៉ោង ធ្វើការ ។
តាមរយៈ ទំព័រ Facebook នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ លោកស្រី កុយ ពិសី បាន ឱ្យដឹង យ៉ាង ដូច្នេះ ថា៖ « សូម បងប្អូន កូនក្មួយ ដែល ចង់ ជ្រាប ច្បាស់ បន្ថែម ស្តីពី « រឿង រាវ សាវតា និង ការចរចារក ដំណោះស្រាយ ព្រំដែន កម្ពុជា ជាមួយនឹង វៀតណាម សូមអញ្ជើញ មក យក សៀវភៅ ដែល ខ្ញុំ បង្ហាញ ជូន ទៅ នេះ ដោយ ឥត គិត ថ្លៃ នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ជាន់ ទី៥ អគារ មិត្តភាព រាល់ ម៉ោង ធ្វើការ ។ មាន តែ ចំណេះដឹង ពិតប្រាកដ ទេ ដែល អាច ជួយ ឱ្យ បងប្អូន កូនក្មួយ ចេញ ផុត ពី ការបោកប្រាស់ ភូត កុហក ពី ជន អគតិ បាន » ។
ឯកសារ ពាក់ព័ន្ធ ទៅនឹង ដំណោះស្រាយ ព្រំដែន ដែល ប្រកាស ផ្ដល់ជូន ដោយ អនុប្រធាន អចិន្រ្តៃយ៍ លេខាធិការ រដ្ឋាន អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន នា ពេលនេះ រួម មាន៖
១៖ បទ អន្តរាគមន៍ និង សេចក្តី អត្ថាធិប្បាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ស្ដីពី ការងារ បោះ បង្គោល ខណ្ឌ សីមា ព្រំដែន គោក និង ការកំណត់ ព្រំដែន សមុទ្រ រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
២៖ សេចក្តីថ្លែងការណ៍ និង ការអត្ថាធិប្បាយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដើម្បី ផ្ដល់ នូវ ការបំភ្លឺ ជូន ដល់ ជន រួម ជាតិ កម្ពុជា ស្ដីពី ផែនទី ព្រំដែន រដ្ឋ រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
៣៖ អត្ថបទ គោល របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សម្រាប់ អធិប្បាយ ផ្តល់ ការបំភ្លឺ ស្តីពី « ការងារ បោះ បង្គោល ខណ្ខ សីមា ព្រំដែន គោក និង ការកំណត់ ព្រំដែន សមុទ្រ រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សាធារណរដ្ឋ សង្គម និយម វៀតណាម
៤៖ សៀវភៅ បទ អន្តរាគមន៍ របស់ សម្ដេច សុខ អាន ស្តីពី « បញ្ហា សន្ធិសញ្ញា បំពេញ បន្ថែម ទៅ លើ សន្ធិសញ្ញា កំណត់ ព្រំដែន រដ្ឋ ឆ្នាំ ១៩៨៥ និង ជុំវិញ បញ្ហា ព្រំដែន ទឹក រវាង កម្ពុជា - វៀតណាម » ។
សូម បញ្ជាក់ ថា លោកស្រី បណ្ឌិត កុយ ពិសី គឺជា ស្ត្រី ខ្មែរ ១រូប ដែល បាន ចំណាយ ពេលវេលា ស្ទើរ ពាក់កណ្តាល ជីវិត លើ កិច្ចការ ព្រំដែន កម្ពុជា ។ បេសកកម្ម លោកស្រី បាន ចាប់ផ្តើម តាំងពី ដើម ឆ្នាំ ១៩៩៦ ពោល គិត មកដល់ ពេលនេះ មាន ប្រមាណ ជាង ២០ ឆ្នាំ ហើយ ដែល ខិតខំ បំពេញ កិច្ចការ បម្រើ ជាតិ មាតុភូមិ ។ បច្ចុប្បន្ន លោកស្រី កុយ ពិសី មាន តួនាទី ជា អនុប្រធាន លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ នៃ អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន និង ជា រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ ៕
សម្តេច ចៅហ្វា វាំង ពិនិត្យ ការភ្ជួរ រាស់ របស់ ក្រុម សម្តេច ឪ នៅ ខេត្ត កំពង់ស្ពឺ
ក្រុម សម្តេច ឪ បាន ចាប់ផ្តើម ធ្វើ ការភ្ជួរ រាស់ ដី ស្រែ ជូន ប្រជាកសិករ នៅក្នុង មូលដ្ឋាន នេះ បាន ដំណើរការ ពី ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០២០ រហូតមកដល់ ថ្ងៃទី៣០ ខែកក្កដា នេះ សម្រេច ទទួលបាន លទ្ធផល ចំនួន ៤៦ ហិកតា បន្ទាប់ពី ក្រុម សម្តេច ឪ បាន ជួយ ភ្ជួរ រាស់ ចប់ រួចរាល់ ជូន ប្រជាកសិករ ក្នុង ឃុំ ស្នាយ អញ្ជិត ស្រុក ជុំ គីរី ខេត្ត កំពត . ឃុំ ត្រពាំងក្រញូង ឃុំ ជាង ទង ស្រុក ត្រាំ កក់ ខេត្ត តាកែវ និង ឃុំ ក្បាល ទឹក ស្រុក ទឹក ផុស ខេត្ត កំពង់ឆ្នាំង សម្រេចបាន លទ្ធផល សរុប ចំនួន ៤៩០ ហិកតា រួច មកហើយ ។
ប្រជារាស្ត្រ ជា ម្ចាស់ ស្រែ ជា កូន ចៅ ចៅ ទួត រស់ នៅ ឃុំ ទ័ព មាន ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ សូម ថ្លែងអំណរ ព្រះរាជ គុណ ដ៏ ជ្រាលជ្រៅ បំផុត ចំពោះ ព្រះរាជ ទាន ដ៏ ឧត្តុងឧត្តម នេះ និង សូម ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះមហាក្សត្រ និង សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ បាន ប្រកប នូវ ព្រះពុទ្ធ ពរ ទាំង ៤ប្រការ កុំបី ឃ្លៀងឃ្លាត ដើម្បី កូន ចៅ ចៅ ទួត បាន ជ្រកកោន នៅក្រោម ម្លប់ ព្រះតេជៈ បារមី ដ៏ ត្រជាក់ ត្រជុំ នៃ ព្រះអង្គ ជា រៀង រហូតត ទៅ ។
ព្រម ជាមួយ នេះ ប្រជារាស្ត្រ ជា កូន ចៅ ចៅ ទួត សូម ឧទ្ទិស ថ្វាយ មហា ព្រះរាជ កុសល ដ៏ ថ្លៃថ្លា ក្នុង ពេលនេះ ថ្វាយ ចំពោះ ដួង ព្រះវិញ្ញាណ ក័ន្ធ សម្តេច ឪ សម្តេច តា សម្តេច តា ទួត ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត សូម ព្រះអង្គ បាន យាង គង់ ប្រថាប់ សោយ សុខ ក្នុង ព្រះបរម សុគតិភព ប្រកបដោយ ព្រះបរម សុខ ក្នុង សម្បត្តិ សួគ៌ និង ព្រះនិព្វាន្ត កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ៣១ ខែកក្កដា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
ក្នុង កិច្ចប្រជុំ តាមរយៈ Video Conference នេះ លោកស្រី ជា សិរី បាន ជម្រាប ជូន ក្រុម បេសកកម្ម ពី វឌ្ឍនភាព នៃ សេដ្ឋកិច្ច និង ធនាគារ នៅ កម្ពុជា ក្នុង ឆ្នាំ ២០២០ ស្រប ពេល ដែល ជំងឺ កូវីដ១៩ កំពុង រីករាលដាល ក្នុង តំបន់ និង ពិភពលោក និង បាន បង្ហាញ ពី វិធានការ នានា របស់ រាជ រដ្ឋាភិបាល និង ធនាគារ ជាតិ នៃ កម្ពុជា ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ១៩ និង ការស្តារ កំណើន សេដ្ឋកិច្ច ។
ប្រតិកម្ម របស់ លោក ជិន ម៉ាលី ន បាន ធ្វើឡើង បន្ទាប់ពី អង្គការ សិទ្ធិ មនុស្ស នៅ កម្ពុជា ចំនួន ៣រួម មាន៖ មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា សមាគម ការពារ សិទ្ធិ មនុស្ស និង អភិវឌ្ឍន៍ នៅ កម្ពុជា និង មជ្ឈមណ្ឌល សាមគ្គីភាព កាលពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២០ កន្លងទៅ បាន ចេញ របាយការណ៍ រួមគ្នា មួយ ដោយ បាន លើកឡើង ថា លំហ សម្រាប់ ការអនុវត្តន៍ សេរីភាព មូលដ្ឋាន នៅ កម្ពុជា នៅតែ បន្ត រឹតត្បិត ។
នៅក្នុង របាយការណ៍ អង្គការ ទាំង ៣នេះ បាន ធ្វើការកត់សម្គាល់ ពី ការបង្ក្រាប លើ អ្នក មាន ទស្សនៈ នយោបាយ ផ្ទុយ . ការបំបិទ នូវ ការ បញ្ចេញមតិ ដែល ធ្វើឱ្យ មាន ការកើនឡើង នូវ ការចាប់ ពិរុទ្ធិ និង ការថយចុះ ការយល់ដឹង របស់ សាធារណជន ចំពោះ សេរីភាព មូលដ្ឋាន ជាដើម ។
លោក ជិន ម៉ាលី ន បាន លើកឡើង លើ ទំព័រ ហ្វេសប៊ុក របស់ លោក នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ថា របាយការណ៍ របស់ អង្គការ ទាំង៣ នេះ គ្រាន់តែ ធ្វើ ការប្រមូល បូកសរុប នូវ ព្រឹត្តិការណ៍ និង ធ្វើ ការសន្និដ្ឋាន តែ លើ រូបភាព ខាងក្រៅ តែ ប៉ុណ្ណោះ ពោលគឺ មិន បាន សិក្សា លើ មូលហេតុ និង មូលដ្ឋាន លំអិត ដែល នាំឱ្យ កើតមាន ព្រឹត្តិការណ៍ នីមួយ ៗ ទិដ្ឋភាព និង នីតិវិធី ច្បាប់ អង្គហេតុ នៃ បទល្មើស និង អំពើ ដែល ជា ធាតុ ផ្សំ នៃ បទល្មើស ដែល នាំឱ្យ មាន ការទទួលខុសត្រូវ តាម ផ្លូវ ច្បាប់ នោះ ទេ ។
អ្នកនាំពាក្យ រូប នេះ បាន ផ្តល់ ដំបូន្មាន ទៅ អង្គការ ទាំង នេះ ថា របាយការណ៍ របស់ ពួកគេ គួរតែ ធ្វើ ការអប់រំ និង ណែនាំ ក្រុម ដែល បំពាន ច្បាប់ ទាំងនោះ ឱ្យ គោរព ច្បាប់ ឱ្យ បាន ភ្ជាប់ ភ្ជួន ប្រើប្រាស់ សិទ្ធិ របស់ ខ្លួន ឱ្យ បាន ត្រឹមត្រូវ តាម ផ្លូវ ច្បាប់ មិន បំពាន សិទ្ធិ សេរីភាព អ្នកដទៃ និង ប៉ះពាល់ ដល់ សន្តិសុខ សង្គម និង សណ្តាប់ ឆ្នាប់ សាធារណៈ ដែល អាច នាំឱ្យ ពួកគេ ប្រឈម និង ទទួលខុសត្រូវ តាម ផ្លូវ ច្បាប់ ជា យថាហេតុ ណាមួយ ។
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០
១៖ ក្រសួង សុខាភិបាល រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ថ្មី លើ មន្ត្រី ជាន់ ខ្ពស់ ទូត អាមេរិក ម្នាក់ ខណៈ អ្នក ជាសះស្បើយ ចំនួន ៨នាក់
៣៖ ស្រ្តី ខ្មែរ មាន សញ្ជាតិ អាមេរិក លួច រត់ ចេញ ពី កន្លែង ចត្តាឡី ស័ក មិន មាន មេរោគ ជំងឹកូវីដ១៩ ទេ . អនុញ្ញាតឱ្យ ចេញ ទៅ ផ្ទះ ថ្ងៃ នេះ ហើយ
៥៖ សម្តេច ក្រឡាហោម ស ខេង៖ រយៈពេល ៤ខែ នៃ ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ ពលករ ជាង ១០ម៉ឺន នាក់ ត្រូវបាន ជួយសង្គ្រោះ
៧៖ សម្ដេច ក្រឡាហោម ស ខេង៖ កិច្ចការពារ ពលករ ធ្វើ ទេសន្តរប្រវេសន៍ ជា ភារកិច្ច ចាំបាច់ របស់ រាជ រដ្ឋាភិបាល
៩៖ អភិបាល រាជធានី ភ្នំពេញ ព្រមាន វាយ កម្ទេចចោល សំណង់ ខុស ប្លង់ អនុញ្ញាត ដែល អាច បង្ក គ្រោះថ្នាក់
១០៖ អនុព័ន្ធ យោធា ស្ថានទូត ចិន៖ ប្តេជ្ញាចិត្ត ការពារ សន្តិភាព ផ្តួចផ្តើម សហការ គ្នា ប្រឆាំង នឹង អំណាច គាបសង្កត់
១២៖ ឥណទាន ពិសេស ៣០ លាន ដុល្លារ របស់ រាជ រដ្ឋាភិបាល បាន ដល់ ដៃ សហគ្រាស ធុន តូច - មធ្យម និង កសិកម្ម
១៤៖ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សេដ្ឋកិច្ច៖ ឥណទាន ៦៥០ លាន ដុល្លារ នឹង ជួយ ឲ្យ SME បន្ត រស់រាន មាន ជីវិត សម្រាប់ ស្តារ សេដ្ឋកិច្ច ឲ្យ ងើប ឡើងវិញ
១៥៖ ចិន ប្រឹងប្រែង ទិញ ផលិតផល កសិកម្ម ពី អាមេរិក ប៉ុន្តែ នៅតែ មិន អាច គ្រប់ ចំនួន ទៅ តាម កិច្ចព្រមព្រៀង
១៧៖ អ៉ីរ៉ង់ ធ្វើតេស្ត បាញ់ មីស៊ីល ដ៏ កក្រើក ដើម្បី ត្រៀមខ្លួន ទប់ទល់ ការឈ្លាន ពាន ពី សហរដ្ឋ អាមេរិក
១៨៖ លោក កៅ ថាច់ ពន្យល់ លក្ខខណ្ឌ ដើម្បី ទទួលបាន ប្រាក់ កម្ចី ពី រដ្ឋ ទៅ អភិវឌ្ឍ របរ កសិកម្ម
២០៖ មាតា មនុស្សធម៌ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចាត់ តំណាង នាំយក អំណោយ ជូន ពលរដ្ឋ ចំនួន ៣២៦ គ្រួសារ ក្នុង ស្រុក ចំនួន ពីរ នៃ ខេត្ត កំពង់ឆ្នាំង
២២៖ ថៃ កំពុង បង្វឹក កងកម្លាំង ប៉ូលិស ដើម្បី បង្ក្រាប ការជួញដូរ មនុស្ស ទូទាំង ប្រទេស !
២៤៖ និស្សិត ហុងកុង ៤នាក់ ត្រូវ ចាប់ខ្លួន ក្រោម ច្បាប់ សន្តិសុខ ថ្មី របស់ ចិន
២៥៖ ចិន ប្រាប់ ឱ្យ សហភាព អឺរ៉ុប បញ្ឈប់ ការលូកលាន់ កិច្ចការ ផ្ទៃក្នុង ទីក្រុង ហុងកុង
៦៖ ចំណេះដឹង ទូទៅ៖ តើ ធ្លាប់ មាន មនុស្ស បាត់បង់ជីវិត នៅក្នុង លំហ អវកាស ដែរ ឬ ទេ ?
៩៖ គ្រូបង្វឹក ត្បូងឃ្មុំ បញ្ជាក់ មូលហេតុលា លែង ពី តំណែង ក្រោយ ដឹកនាំ បរាជ័យ ក្នុង ពាន សម្ដេច តេជោ - ថ្នាក់ ខេត្ត
១១៖ ស្វែងយល់ ពី ទម្លាប់ ប្រចាំ ថ្ងៃ របស់ ប្រធានាធិបតី ដូណាល់ ត្រាំ
សល់ មិន ដល់ ១០០ ថ្ងៃ ទៀត ដល់ ពេល បោះឆ្នោត លោក ដូណាល់ ត្រាំ ចង់ឲ្យ ពន្យារ ពេល ក្រោម លេស ថា នឹង មាន ការក្លែងបន្លំ សន្លឹក ឆ្នោត
( វ៉ាស៉ីន តោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នា ថ្ងៃព្រហស្បតិ៍ នេះ បាន លើកឡើង នូវ លទ្ធភាព នៃ ការពន្យារ ពេល បោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី ដែល បើ តាម រដ្ឋធម្មនុញ្ញ របស់ សហរដ្ឋ អាមេរិក គឺ ត្រូវតែ ប្រព្រឹត្តទៅ នៅ ថ្ងៃអង្គារ ទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃព្រហស្បតិ៍ ទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ ។
គួរ ជម្រាប ថា មកទល់ ពេលនេះ នៅសល់ មិន ដល់ ១០០ ថ្ងៃ ទៀត ឡើយ គឺ ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី អាមេរិក នឹង ត្រូវ រៀបចំឡើង ។ ពាក់ព័ន្ធ នឹង កាលបរិច្ឆេទ បោះឆ្នោត ប្រធានាធិបតី អាមេរិក មិន មាន សិទ្ធិ លើក ពេល នោះ ទេ ខណៈ រដ្ឋធម្មនុញ្ញ អាមេរិក បាន ផ្តល់ អំណាច ឲ្យ សភា ដើម្បី ជា អ្នក កំណត់ ថ្ងៃ បោះឆ្នោត ៕
វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ អាណត្តិ ទី៣ ប្រចាំ ឆ្នាំ ២០២០ របស់ ក្រុមប្រឹក្សា ក្រុង សៀមរាប
នៅក្នុង វេទិកា ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា ក្រុង សៀមរាប នា ឱកាស នេះ បងប្អូន ប្រជាពលរដ្ឋ បាន លើកឡើង ជា សំណូមពរ ផ្ទាល់ មាត់ ចំនួន ១៣ សំណួរ សរសេរ ជា អក្ស ចំនួន ០២ ក្នុង នោះ អង្គ វេទិកា បាន ដោះស្រាយ បំភ្លឺ ជូន បាន ចំនួន ១៣ សំណូមពរ នៅសល់ ចំនួន ០២ សំនួរ នឹង ត្រូវ រងចាំ ធ្វើ ការឆ្លើយ បំភ្លឺ ជា លិខិត លាយ ល័ក្ខ អក្សរ ជូន ម្ចាស់ សាមី ដើម្បី ជ្រាប នៅ ពេល ក្រោយ ទៀត ។
ក្នុង នាម រដ្ឋបាល ក្រុង សៀមរាប សូម ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ តំណាង អង្គភាព និង ក្រុមការងារ ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន អញ្ជើញ ចូលរួម និង សហការណ៍ ធ្វើអោយ វេទិការ នេះ អាច ដោះស្រាយ កង្វល់ ជូន បងប្អូន ប្រជាពលរដ្ឋ បញ្ចប់ ទៅ ប្រកបដោយ បរិយាកាស ល្អ ប្រសើរ ផងដែរ ៕
ចំណេះដឹង ទូទៅ៖ ព្រះចៅ អាឡិច សង់ ធ្វើ សង្គ្រាម ឈ្នះ សឹង គ្រប់ សមរភូមិ ទាស់ តែ អាយុ ខ្លី
នៅពេល ព្រះរាជ កុមារ អាឡិច សង់់ មាន ព្រះជន្ម ១៣ ព្រះវស្សា ព្រះអង្គ មាន ឫ ទ្ធានុភាព អាច បង្ក្រាប សេះ ខ្មៅ កម្លាំង មហិមា មួយ ក្បាល ដែល មិន ធ្លាប់ មាន អ្នកណា អាច បង្ក្រាប វា បាន ឡើយ សូម្បីតែ ម្ចាស់ របស់ វា ។ សេះ ជើងឯក ខ្លាំង មួយ នេះ ក៏ បាន ក្លាយ សេះ ចម្បាំង ហ្លួង តែ មួយ គត់ របស់ ព្រះអង្គម្ចាស់ អាឡិច សង់ ដោយ ព្រះអង្គ បាន ប្រទាន នាម សម្រាប់ វា ថា « ប៊ូ សេហ្វា លុស » ។
ព្រះចៅ ហ្វីលីព ទី២ បាន អញ្ជើញ អ្នកប្រាជ្ញ ទស្សនវិជ្ជា ដ៏ ល្បីល្បាញ ម្នាក់ របស់ ក្រិក គឺ លោក អារី ស្តូត មក ធ្វើជា ព្រះរាជ គ្រូបង្ហាត់ បង្រៀន ដល់ ព្រះអង្គម្ចាស់ អាឡិច សង់ ហើយ អារី ស្តូត ក៏ បាន យល់ព្រម ជាមួយ ព្រះរាជ សំណើ នេះ ។ អារីស្តូត បាន បណ្ដុះបណ្ដាល ចំណេះ វិជ្ជា ជាច្រើន ដល់ ព្រះអង្គម្ចាស់ រីឯ ព្រះអង្គម្ចាស់ ក៏ ព្យាយ ម ស្វែងយល់ និង ទទួលបាន ចំណេះ ជំនាញ ជាច្រើន ពី ព្រះរាជ គ្រូ ដ៏ ឆ្នើម រូប នេះ ។
បន្ទាប់ពី ព្រះបិតា សោយទិវង្គត ដោយសារ ការលួច ធ្វើឃាត ពីសំណាក់ ពួក បច្ចា មិត្ត រួច មក ព្រះរាជ ទាយាទ អាឡិច សង់ ក៏ បាន ឡើងគ្រងរាជ្យ បល្ល័ង្ក នៅ រាជធានី ផេល ឡា នា ឆ្នាំ ៣៣៦ មុន គ្រិស្ត សករាជ ហើយ បាន ក្លាយជា « ព្រះចៅ អធិរាជ នៃ នគរ ម៉ាសេដូន » ក្នុង ព្រះជន្មាយុ ២០ ព្រះវស្សា ។
ព្រះបិតា និង ព្រះមាតា ធ្លាប់ មាន រាជ បន្ទូល ទៅកាន់ អាឡិច សង់ ថា « នៅ ភាគ ខាងកើតមាន រតនសម្បត្តិ និង ភោគ ទ្រព្យ ល្អ ៗ ដ៏ ច្រើន មហាសាល ហើយ អាណាចក្រ ម៉ាសេដូន របស់ យើង ហាក់ តូច ចង្អៀត ពេក ហើយ សម្រាប់ អំណាច គ្រប់គ្រង របស់ បុត្រ ពីព្រោះ បុត្រ ជា ទេវបុត្រ របស់ ព្រះអាទិទេព សង្គ្រាម » ។ ព្រះរាជ ឱង្កា របស់ ព្រះ ដ៏ មាន គុណ នេះ ហើយ បាន ដាស់ ស្មារតី របស់ អាឡិច សង់ « ត្រូវតែ មាន មហិច្ចតា ពង្រីក អំណាច និង ទឹកដី របស់ ម៉ាសេដូន ទៅកាន់ ភាគ ខាងកើត គឺ សំដៅ ចំចក្រភព ពែក្យ » ។
* សមរភូមិ ពែក្យ ខាងលិច
នៅ ចុង ឆ្នាំ ៣៣២ មុន គ្រិស្ត សករាជ ព្រះចៅ អាឡិច សង់ បាន បន្ត ដឹកនាំ កងទ័ព ឆ្ពោះទៅ នគរ អេហ្ស៉ីប ដ៏ ល្បីល្បាញ ដោយ បាន វាយ បណ្ដេញ កងទ័ព របស់ ពែក្យ ដែល គ្រប់គ្រង អេហ្ស៉ី ប រាប់ រយ ឆ្នាំ មកហើយ នោះ ឱ្យ ថយ ចេញ ភ្លាម ៗ យ៉ាង ទាន់ហន់ ។
នៅ អេហ្ស៉ីប នេះ ប្រជាជន ម្ចាស់ ស្រុក មាន ការទទួលស្វាគមន៍ វត្តមាន កងទ័ព សម្ពន្ធមិត្ត ជាខ្លាំង ពីព្រោះ ពួកគេ មិន ចង់ ស្ថិត ក្រោម ការគ្រប់គ្រង ដ៏ ឃោរឃៅ របស់ ពែក្យ នោះ ឡើយ ដោយ ពួកគេ បាន យាង ព្រះចៅ អាឡិច សង់ ឱ្យ ឡើង ធ្វើជា ព្រះមហាក្សត្រ សោយរាជ្យ នៅ រាជធានី ស៉ីវ៉ា (Siwah) និង បាន ថ្វាយ ព្រះគោរមងារ ដល់ ព្រះអង្គ ជា « ផារ៉ា អុង » ថែម ទៀត ផង ។
ព្រះមហា រាជអាឡិច សង់ ដែល ជា ផារ៉ា អុង ថ្មី នៃ អេហ្ស៉ីប នេះ បាន សព្វ ព្រះទ័យ បង្កើត ទីក្រុង ថ្មី មួយ ដោយ បាន ប្រសិទ្ធ នាម ថា « ទីក្រុង អាឡិច សង់ ទ្រី » គឺ យក តាម ព្រះនាម របស់ ព្រះអង្គ ហើយ ព្រះអង្គ បាន រៀបចំ អភិវឌ្ឍ ទីក្រុង ថ្មី នេះ ឱ្យ មាន ការរីកចម្រើន រហូត ក្លាយជា ទីក្រុង កំពង់ផែ អន្តរជាតិ ដ៏ សំខាន់ មួយ មកដល់ ពេល បច្ចុប្បន្ន ។
* សមរភូមិ បាប៊ីឡូន និង ការតាម សម្លាប់ អធិរាជ ពែក្យ ដារី ឧសទី ៣
ក្រោយ ទទួល ជ័យជម្នះ លើ ពួក ស្ប៉ាតា ព្រះចៅ អធិរាជ អាឡិច សង់ បាន បន្ត លើក ទ័ព ឡើង ច្រាំង ខាងកើត សមុទ្រ មេឌីទែរ៉ាណេ ឆ្លងកាត់ នគរ ហ្វីនី សៀ និង នគរ ស៉ីរី តម្រង់ ទៅកាន់ ទីក្រុង បាប៊ីឡូន ដែល ជា រាជធានី ធំ របស់ ចក្រភព ពែក្យ ។ ប៉ុន្តែ កងទ័ព ពែ ក្យ ក៏ បាន ចេញមក ស្ទាក់ មុន នៅ ត្រង់ ភាគ ខាងជើង ប្រទេស អ៉ីរ៉ាក់ បច្ចុប្បន្ន ។ ពេល នោះ ហើយ ដែល សមរភូមិ ហ្គូហ្គា មេឡា (Gaugamela) បាន ផ្ទុះឡើង នៅ ឆ្នាំ ៣៣០ មុន គ្រិស្ត សករាជ ជា ហេតុ ធ្វើឱ្យ កងទ័ព ពែក្យ ទទួល នូវ បរាជ័យ យ៉ាង ដំណំ ។
ក្រោយ ការទទួលបរាជ័យ នៅ សមរភូមិ ហ្គូហ្គា មេឡា នា ឆ្នាំ ៣៣០ មុន គ្រិស្ត សករាជ នោះ មក ចក្រភព ពែក្យ ខាងលិច និង រាជធានី បាប៊ីឡូន ក៏ បាន ធ្លាក់ ក្នុង កណ្ដាប់ដៃ របស់ ព្រះចៅ អធិរាជ អាឡិច សង់ទី៣ ។
* សមរភូមិ ពែក្យ ខាងកើត និង អវសាន របស់ អធិរាជ ពែក្យ
សរម ភូមិ ហ៉ី ដាស្ពេស នៅតែ បន្ត រហូតដល់ ឆ្នាំ ៣២៥ មុន គ្រិស្ត សករាជ ហើយ លើក នេះ កងទ័ព ឥន្ទ្រិយ៍ ទេព របស់ ព្រះស្ដែង អាឡិច សង់ ក៏ បាន ស្គាល់ នូវ ការបរាជ័យ យ៉ាង ដំណំ វិញ ម្ដង ក្រោម មហិទ្ធានុភាព ដ៏ ខ្លាំង មហិមា នៃ កងទ័ព គជសារបស់ ព្រះមហា រាជ ផូរឺ ស ឥណ្ឌា ។
ព្រះចៅ អាឡិច សង់ នៅតែ បៀម ព្រះទ័យ ចង់ ទន្ទ្រាន យក ទឹកដី ចក្រភព ឥណ្ឌា បន្ត ទៀត ខណៈ ដែល កងទ័ព របស់ ព្រះអង្គ កំពុង កើត ក្ដីនឿយណាយ នឹង សង្គ្រាម ។ រយៈពេល ១៥ ឆ្នាំ មក នេះ ពួកគេ មិន បាន ត្រលប់ ទៅ ស្រុក កំណើត ម្ដង ណា ឡើយ ហើយ ពិតជា នឹក រឭក ដល់ កំណើត នៅឯ ម៉ាសេដូន និង ក្រិក ជា អនេក ពួកគេ បាន បាត់បង់ បងប្អូន និង មិត្តភក្ត្រ រួម សង្គ្រាម ជាច្រើន នាក់ រសាយ អស់ ឫ ទ្ធានុភាព ស្មារតី ក្លាហាន ដែល ធ្លាប់ មាន ។
នៅក្នុង សមរភូមិ ហ៉ី ដាស្ពេ ស អង្គ ព្រះអាឡិច សង់ បាន ត្រូវ របួស នឹង លំពែង របស់ កងទ័ព សត្រូវ ហើយ បាន បាត់បង់ ព្រះញាតិវង្ស និង មេទ័ព ជំនិត ជាច្រើន នាក់ ។ ដោយ កើតទុក្ខ នឹង រឿង នេះ ផង រីឯ កងទ័ព ក៏ ធ្លាក់ អានុភាព ទៀតផង នោះ ធ្វើឱ្យ ព្រះចៅ អាឡិច សង់ ធ្លាក់ ព្រះកាយ ប្រឈួន ជា ទម្ងន់ ។
ឯកសារ ខ្លះ បាន សរសេរ ថា នៅ តាម ផ្លូវ ដក ទ័ព ពី ឥណ្ឌា ទៅកាន់ ទីក្រុង បាប៊ីឡូន វិញ នោះ ព្រះមហា រាជអាឡិច សង់ បាន ឆ្លង ជំងឺ គ្រុនចាញ់ ប្រឈួន ជា ទម្ងន់ ខណៈ ព្រះកាយ ទ្រង់ ក៏ ត្រូវ របួស ធ្ងន់ ហើយ ថែមទាំង ច្បាំង មិន ឈ្នះ ឥណ្ឌា ទៀត នោះ ធ្វើឱ្យ ព្រះអង្គ ឈឺចិត្ត យ៉ាង ខ្លាំង ។
នៅពេល សម្រាក ព្រះកាយ នៅ ទីក្រុង បាប៊ីឡូន ព្រះចៅ អាឡិច សង់ ដែល ធ្លាក់ តែ ខ្លាំងក្លា គ្មាន គូ ប្រៀប បែរជា វក់ វីនឹង ការសោយសុរា លែង គិតគូរ អំពី រាជ្យ កិច្ច និង មិន ព្រម ព្យាបាល ព្រះរោគ នោះ ឡើយ រហូត បណ្ដាលឱ្យ បាត់បង់ ព្រះជន្មសុគត នា ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ៣២៣ មុន គ្រិស្ដ សករាជ ក្នុង ជន្មាយុ ៣៣ ព្រះវស្សា ។
ស្នា ព្រះហស្ត មួយ របស់ ព្រះជ័យ វរ្ម័ន ទី២ នៅលើ ភ្នំ គូលែន បន្ត ទទួលបាន ការយកចិត្តទុកដាក់ ពី អាជ្ញាធរ
ប្រាសាទ ដំរី ក្រាប រង ការខូចខាត ខ្លាំង ដោយ កត្តា ទឹកភ្លៀង និង រុក្ខជាតិ ដែល ធ្វើឱ្យ គ្រឹះ ស្រុត ផ្នែក ខាងលិច បណ្តាលឱ្យ មាន ស្នាម ប្រេះ តូច ធំ ជាច្រើន កន្លែង និង ផ្នែក ខ្លះ មាន ឫស ឈើ ចាក់ ចូល ជញ្ជាំង បណ្តាលឱ្យ ស្នាម ប្រេះ កាន់តែ រីក ធំ ឡើង ។ បញ្ហា សំណើម ក៏ ធ្វើឱ្យ ផ្នែក ខឿន ប្រាសាទ ពុក ផុយ ខ្លាំង និង ផ្នែក កណ្តាល មធ្យម ។ រួមទាំង កត្តា មនុស្ស ដែល បាន លួច បំផ្លិចបំផ្លាញ ក្បាច់ ក្រឡោត ខ្ពស់ នៅលើ ជញ្ចាំង ហោ ជាង ផ្តែរ និង ជីក កកាយគ្រឹះ ខាងក្នុង ប្រាសាទ ធ្វើឱ្យ លំនឹង ប្រាសាទ មាន ការប្រែប្រួល ។
ដើម្បី លើកកម្ពស់ តម្លៃ ប្រាសាទ ឱ្យ ផុត ពី គ្រោះថ្នាក់ អាជ្ញាធរ ជាតិ អប្សរា សម្រេច ពង្រឹង ខឿន ដែល ពុក ផុយ នៅ ជុំវិញ តួ ប៉ម ជួសជុល ខ្លោងទ្វារ ខាងកើត រៀប ផ្ចិត ពង្រឹង ស្នាម ប្រេះ តូច ធំ នៅលើ ជញ្ជាំង ដំបូល និង ជួសជុល ដំបូល ដែល ពុក ផុយ ។
ភាគី ទាំងអស់ បាន យល់ព្រម ផ្តិត មេដៃ បញ្ចប់ វិវាទ ដោយ មាន មេធ អាវី ៣ រូប និង ពលរដ្ឋ ជា ម្ចាស់ ដី ទំនាស់ ទាំងអស់ ចំនួន ១៩ នាក់ ផងដែរ ។ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សប្បាយរីករាយ ក្រៃលែង ដែល បាន បញ្ចប់ រឿងក្តី ក្តាំ ដ៏ រាំ រ៉ៃ ដែល មាន រយៈពេល ជាង ២០ ឆ្នាំ មក នេះ បាន ឆាប់ បំផុត ក្រោម ការសម្របសម្រួល ផ្សះផ្សា ឈរ លើ គោលការណ៍ ឈ្នះ ឈ្នះ សម្តេច តេជោ ហ៊ុន សែន ។ ពួកគាត់ ទាំងអស់ គ្នា វេទនា ខ្លាំង ណាស់ ពី រឿង វិវាទ ដីធ្លី ដែល មាន រយៈពេល ដ៏ យូរ នេះ ។
បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ គឺ សុទ្ធសឹងតែ ជា អ្នកបោះឆ្នោត អោយ គណបក្ស ប្រជាជន កន្លងមក ។ បងប្អូន ប្រជាពលរដ្ឋ បាន គោរព ថ្លែងអំណរគុណ ដល់ សម្តេច តេជោ ហ៊ុន សែន យ៉ាង ជ្រាលជ្រៅ បំផុត ដែល សម្តេច បាន ជួយ ដោះស្រាយ ផ្តល់ យុត្តិធម៍ ជូន ពួកគាត់ ទាំងអស់ គ្នា នៅ ថ្ងៃ នេះ ។ បងប្អូន បន្ត បោះឆ្នោត គាំទ្រ សម្តេច ដើម្បី បន្ត ដឹកនាំ ប្រទេស កម្ពុជា កាន់តែ រីកចម្រើន ទៅ មុខ ។
លោក ដួង តារា បាន គោរព ថ្លែងអំណរគុណ ដល់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី យ៉ាង ជ្រាលជ្រៅ បំផុត ដែល សម្តេច តែងតែ ស្រឡាញ់ នឹង មាន ព្រហ្មវិហារ ធម៌ ចំពោះ ប្រជាពលរដ្ឋ គ្រប់ ស្រទាប់ វណ្ណៈ ព្រោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ គឺជា សុខ ទុក្ខ ផ្ទាល់ របស់ សម្តេច ។ លោក ដួង តារា បាន គោរព ជូនពរ សម្តេច តេជោ មាន សុខភាព ល្អ រឹងមាំ ដើម្បី ជា ម្លប់ ដ៏ កក់ក ក្តៅ បំផុត សម្រាប់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ. រយៈពេល ៩១ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១២៤ .៥១៦ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៩២.២៨៧ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៣២. ២២៩ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ៩១ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បទល្មើស ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ ស្លាប់ ០២ នាក់ របួស ១១នាក់ ( របួស ធ្ងន់ ០៨ នាក់ )៕
( ភ្នំពេញ ) ៖ ស្រ្តី ម្នាក់ ត្រូវបាន ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ហៅ មក សួរ នាំ និង ឲ្យ ចេញ វីដេអូ សុំទោស ជាសាធារណៈ ក្រោយ ស្រ្តី រូប នេះ បាន ប្រមាថ មើលងាយ មក លើ សមត្ថកិច្ច តាម បណ្តាញ សង្គម ករណី អនុវត្ត ការរឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ។
លោក វរសេនីយ៍ ឯក សាន សុខ សីហា ជំនួយការ និង ជា អ្នកនាំពាក្យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ រសៀល ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ថា ម្ចាស់ គណនី ហ្វេសប៊ុក ឈ្មោះ ចែ ទូច លក់ ស្វាយ បាន ប្រមាថ មើលងាយ មក លើ សមត្ថកិច្ច ទាក់ទង ទៅ នឹង ការអនុវត្ត ការរឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ។
ដោយ ទទួលស្គាល់ ព័ត៌មាន វីដេអូ ដែល ខ្លួន បាន បង្ហោះ នោះ ជា ព័ត៌មាន មិន ពិត បុគ្គល រូប នេះ បាន យល់ព្រម ទទួល កំហុស ហើយ ចូល ខ្លួន មក សារភាព កំហុស តាម ការកោះហៅ របស់ សមត្ថកិច្ច ដោយ បាន ធ្វើ កិច្ចសន្យា និង ថត ជា វីដេអូ សុំទោស ជា សារធារណៈ ដើម្បី សុំទោស សមត្ថកិច្ច ក៏ ដូចជា ប្រជាពលរដ្ឋ ទាំងអស់ ចំពោះ ទង្វើ ដែល សង្គម ស្អប់ខ្ពើម នេះ ផងដែរ ។
( បន្ទាយមានជ័យ )៖ ដើម្បី បង្ខិត ការផ្តល់ សាធារណៈ ផ្សេង ៗ ជូន ពលរដ្ឋ នៅ មូលដ្ឋាន ឲ្យបាន លឿន និង រហ័ស រាជ រដ្ឋាភិបាល កម្ពុជា បាន បង្កើត ឲ្យ មាន ការិយាល័យ ច្រក ចេញ ចូល តែ មួយ នៅ តាម បណ្តា រាជធានី - ខេត្ត ក្រុង - ស្រុក ដើម្បី ផ្តល់ ភាពងាយស្រួល ជូន ពលរដ្ឋ ។
ជាក់ស្តែង នៅ ព្រឹក ថ្ងៃទី៣០ ខែកក្កដា នេះ អគារ ច្រក ចេញ ចូល តែ មួយ នៅ ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ត្រូវបាន ដាក់ ឲ្យ ប្រើប្រាស់ ។
កម្មវិធី នេះ ត្រូវបាន សម្ពោធ ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ ក្រោម អធិបតី លោកស្រី ហេម ចិន្តា មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាង អម ដំណើរ ដោយ លោក ខេង ស៊ុម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ និង លោកស្រី ព្រមទាំង មាន ការចូលរួម ពីសំណាក់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត ក្រុង - ស្រុក មន្ត្រីរាជការ មន្ទីរ ស្ថាប័ន ពាក់ព័ន្ធ ជុំវិញ ខេត្ត ។
លោក អភិបាល ខេត្ត បាន ជំរុញ ដល់ មន្ត្រី ពិសេស ការិយាល័យ ច្រក ចេញ ចូល តែ មួយ ត្រូវ ផ្តល់ សេវា ជូន ពលរដ្ឋ ឲ្យបាន ល្អ ប្រសរើ លឿន រហ័ស តាម ដែល អាច ធ្វើ ទៅ បាន ដើម្បី ការផ្តល់ សេវា ជូន ពួកគាត់ ប្រកបដោយ ទំនុកចិត្ត និង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
ទីភ្នាក់ងារ សារព័ត៌មាន កូរ៉េ ខាងត្បូង យ៉ុន ហាប់ (Yonhap) ដោយ ស្រង់ សម្តី យោធា កូរ៉េ ខាងត្បូង ជាន់ ខ្ពស់ បាន ឱ្យដឹង ទៀត ថា មីស៊ីល ប្រឆាំង នាវា ចម្បាំង មួយ គ្រាប់ ត្រូវបាន បាញ់ ចេញ ពី នាវា ចម្បាំង កូរ៉េ ខាងជើង នៅឯ តំបន់ សមុទ្រ ជប៉ុន កាលពី ថ្ងៃទី ០៦ ខែកក្កដា កន្លងទៅ នេះ ហើយ មីស៊ីល នោះ បាន ហោះ រយៈចំងាយ ជាង ១០០ គីឡូម៉ែត ។ ទោះជា យ៉ាងណា ប្រភេទ ពិតប្រាកដ នៃ គ្រាប់ មីស៊ីល នេះ មិន ទាន់ ត្រូវបាន គេ ដឹង នៅឡើយ ទេ ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃពុធ ម្សិលមិញ មនុស្ស ជាង ២៦ ម៉ឺន នាក់ ត្រូវ ដាក់ ឱ្យ ស្ថិត ក្រោម ការឃ្លាំមើល ពីសំណាក់ មន្ត្រី សុខាភិបាល យ៉ាង តឹងរ៉ឹង បំផុត ។ រហូតមកទល់ ពេលនេះ ប្រទេស រុស្សី បាន ធ្វើតេស្ត រក COVID-19 លើ មនុស្ស ច្រើន ជាង ២៧. ៨លាន នាក់ នៅ ទូទាំង ប្រទេស ៕
កុំ ចង់ សាកល្បង គ្រឿងញៀន សូម្បី កន្លះ ដង ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែកក្កដា៖ បង្ក្រាប ២៤ ករណី ឃាត់ខ្លួន ៤៣ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៤ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៨ករណី និង ជួញដូរ ១៦ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤៣ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៦. ១៤៧ ករណី ឃាត់ មនុស្ស ១២. ២៣៦ នាក់ ( ស្រី ៧៦០ នាក់ )៕ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ថ្លែងអំណរ ព្រះរាជ គុណ សម្តេច ម៉ែ ដែល ព្រះអង្គ បាន ព្រះរាជ ទាន ព្រះរាជ ទ្រព្យ ដ៏ ឧត្តុង្គឧត្តម ចំនួន ៦ពាន់ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ឆមាស ទី២ ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ១០កើត ខែ ស្រា ពណ៍ ឆ្នាំ ជូត ទោស័ក ព .ស .២៥៦៤ ត្រូវនឹង ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ទូល ថ្វាយ សារ លិខិត ថ្លែងអំណរ ព្រះរាជ គុណ សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ដែល ព្រះអង្គ សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជូបត្ថម្ភ នូវ ព្រះរាជ ទ្រព្យ ចំនួន ៦ពាន់ ដុល្លារ ចំពោះ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ឆមាស ទី២ ឆ្នាំ ២០២០ ។
តាង នាម ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា មន្ត្រី បុគ្គលិក ទាំងអស់ នៃ កាកបាទ ក្រហម កម្ពុជា « ខ្ញុំ ម្ចាស់ សូម ព្រះបរម រាជានុញ្ញាត ថ្វាយអំណរ ព្រះរាជ គុណ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ថ្វាយ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ តែងតែ សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជូបត្ថម្ភ សម្រាប់ ទ្រទ្រង់ សកម្មភាព មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា » ។
ក្នុង សារលិខិត នោះ មាន ខ្លឹមសារ បន្ដ ទៀត ថា « ខ្ញុំ ម្ចាស់ និង សហការី ទាំងអស់ នឹង ប្រើប្រាស់ ព្រះរាជ ទ្រព្យ ដ៏ ឧត្តុង្គឧត្តម នេះ ទៅ តាម ព្រះរាជ តម្រិះ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត សម្រាប់ ជួយសង្គ្រោះ ដល់ ប្រជារាស្ត្រ ក្រីក្រ និង ប្រជារាស្ត្រ ដែល ទទួល រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ផ្សេង ៗ នៅ ទូទាំង កម្ពុជា » ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង នៃ សារលិខិត របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ទូល ថ្លែងអំណរ ព្រះរាជ គុណ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ៖ ក្រសួង ប្រៃសណីយ៍ និង ក្រសួង សុខាភិបាល ប្រកាស ដាក់ ដំណើរការ ប្រព័ន្ធ គ្រប់គ្រង សារ និង ទីតាំង ទទួល ព័ត៌មាន និង ទិន្នន័យ ពលរដ្ឋ អំពី ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ជា វ៉ាន់ ដេត រដ្ឋមន្រ្តី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ និង លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ណឌីន រដ្ឋលេខាធិការ តំណាង លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២២០ នេះ បាន ប្រកាស ដាក់ ឲ្យ ដំណើរការ « ប្រព័ន្ធ គ្រប់គ្រង សារ និង ទីតាំង សម្រាប់ ទទួល ព័ត៌មាន និង ទិន្នន័យ នៃ ប្រជាពលរដ្ឋ អំពី ជំងឺ កូវីដ - ១៩ » ។
លោក ជា វ៉ាន់ ដេត បាន ឲ្យដឹង ថា ប្រព័ន្ធ គ្រប់គ្រង សារ និង ទីតាំង សម្រាប់ ទទួល ព័ត៌មាន និង ទិន្នន័យ នៃ ប្រជាពលរដ្ឋ អំពី ជំងឺ កូវីដ១៩ នេះ ពិតជា មាន សារៈសំខាន់ សម្រាប់ ប្រជាពលរដ្ឋ ទូទៅ ដោយ ប្រព័ន្ធ នេះ នឹង ផ្ញើ សារជា សំឡេង ដោយ ស្វ័យប្រវត្តិ ទៅកាន់ ពួកគាត់ ដែល សង្ស័យ ថា ខ្លួន មាន ផ្ទុក ជំងឺ កូវីដ ១៩ ដើម្បី តាមដាន សុខភាព របស់ ពួកគាត់ ដោយ ខ្លួន ឯង ។
លោក ជា វ៉ាន់ ដេត បាន បន្ដ ទៀត ថា បន្ថែម លើ នេះ តាមរយៈ ការប្រើប្រាស់ ប្រព័ន្ធ នេះ អាជ្ញាធរ មាន សមត្ថកិច្ច អាច កំណត់ អត្តសញ្ញាណ ប្រជាពលរដ្ឋ ដែល សង្ស័យ ថា មាន ផ្ទុក ជំងឺ កូវីដ ១៩ និង ទទួលបាន ព័ត៌មាន និង ទិន្នន័យ ចំបាច់ មួយ ចំនួន ដើម្បី ឈាន ទៅ កំណត់ អត្តសញ្ញាណ នៃ ក្រុម បុគ្គល ដែល អាច មាន ហានិភ័យ ខ្ពស់ ក្នុង ការឆ្លង ជំងឺ កូវីដ ១៩ ។
ជាង នេះ ទៅ ទៀត រដ្ឋមន្រ្តី ក្រសួង ប្រៃសណីយ៍ បាន គូសបញ្ជាក់ ថា ប្រព័ន្ធ នេះ នឹង ជួយ បញ្ចៀស ការកកស្ទះ ដល់ ប្រព័ន្ធ ១១៥ ដែល មាន ស្រាប់ របស់ ក្រសួង សុខាភិបាល ។ ដើម្បី អនុញ្ញាតឲ្យ យើង អាច ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ខ្លាំង ឡើង ថែម ទៀត ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្ដ្រី ជា វ៉ាន់ ដេត ក៏ បាន ស្នើឲ្យ ក្រុមការងារ ក្រសួង ទាំង ពីរ បន្ត សហការកែលម្អ និង អភិវឌ្ឍ ប្រព័ន្ធ នេះ ឲ្យបាន កាន់តែ ល្អ ប្រសើរ និង ពង្រីក វិសាលភាព ឲ្យបាន កាន់តែ ទូលំទូលាយ ជាង នេះ បន្ថែម ទៀត ។ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគន៍ ដែល មាន មូលនិធិ កាតព្វកិច្ច សេវា សកល ទូរគមនាគមន៍ ជា សេនាធិការ នឹង បន្ត គាំទ្រ យ៉ាង ពេញ ទំហឹង លើ ការអភិវឌ្ឍ សេវា គ្រា អាសន្ន ឱ្យ បាន ទូលំទូលាយ និង គ្រប់ វិស័យ ។
បន្ថែម ពី នោះ ទៀត លោក ជា វ៉ាន់ ដេត បាន លើកឡើង ថា ប្រព័ន្ធ នេះ ត្រូវបាន ស្ថាបនា បញ្ចប់ នៅពេលវេលា មួយ ដែល ពិភពលោក កំពុងតែ ប្រឈមមុខ នឹង រលក ទី ពីរ នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ ១៩ ហើយ លោក សង្ឃឹម យ៉ាង មុតមាំ ថា ប្រព័ន្ធ នេះ នឹង អាច ជួយ លើ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ មន្ត្រី ក្រសួង សុខាភិបាល ដែល ជា សេនាធិការ ជួរ មុខ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ រលក ទី ពីរ នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នេះ បាន ដោយ មាន ប្រសិទ្ធិភាព ៕
ក្នុង ន័យ នេះ បាន សេចក្តី ថា ក្រដាស ប្រាក់ ដុល្លារ ប្រភេទ ១ ដុល្លារ ៥ដុល្លារ ១០ដុល្លារ គឺ ផ្សារ ទំនើប AEON នៅតែ ទទួល ពី អតិថិជន របស់ ខ្លួន ដដែល ប៉ុន្តែ បើ អាប់ លុយ ជូន អតិថិជន វិញ នូវ ក្រដាស ប្រាក់ ១ដុល្លារ ៥ដុល្លារ និង ១០ដុល្លារ គឺ ផ្សារ ទំនើប AEON មិន អាប់ ជូន ជាដាច់ខាត គឺ ត្រូវ អាប់ ជា ប្រាក់ រៀល ប៉ុណ្ណោះ ។
