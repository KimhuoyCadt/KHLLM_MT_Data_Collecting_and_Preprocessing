( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៣ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី . ជួញដូរ ៨ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ២៧ នាក់ ។
កម្មវីធី ជិះ កង់ លើក ទី១ នៅ ខេត្ត សៀមរាប មាន អ្នកចូលរួម ២០០ នាក់
( សៀមរាប ) ៖ នា ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២០ នេះ មាន ការជួបជុំគ្នា របស់ ក្រុម អ្នកជិះ កង់ ប្រមាណ ២០០ នាក់ នៅ ទីធ្លា ចំណត រថយន្ត មុខ គ្រឹះស្ថាន អង្គរ នៃ ក្រុង សៀមរាប ក្នុង នោះ មាន ក្រុម អ្នក ចុះឈ្មោះ ជិះ កង់ ចម្ងាយ ៣១ គីឡូម៉ែត្រ ២១គីឡូម៉ែត្រ និង ក្រុម អ្នក ជិះ កង់ កម្សាន្ត ធម្មតា ផងដែរ ។
លោក បាន បញ្ជាក់ ថា ដំណើរ ជិះ កង់ លើក ទី១ នេះ ត្រូវបាន ជិះ ចេញ ពី ក្រុង សៀមរាប ចូល ទៅក្នុង តំបន់ ឧទ្យាន អង្គរ ទស្សនា ប្រាសាទ តា ព្រហ្ម បន្ត ជិះ កំសាន្ត ក្នុង ព្រៃ ធម្មជាតិ អង្គរ ឆ្ពោះទៅ ប្រាសាទ ព្រះខ័ន្ធ និង បញ្ចប់ នៅ ព្រះលាន ជល់ ដំរី ។ កម្មវិធី នេះ ត្រូវបាន យកចិត្តទុកដាក់ ដល់ ការការពារ សុវត្តិភាព អ្នកចូលរួម និង អនុវត្ត វិធាន សុវត្ថិភាព ទេសចរណ៍ ប្រឆាំង ជំងឺ កូវីដ១៩ រួមទាំង បាន ដាក់ចេញ ផងដែរ នូវ ក្រមសីលធម៌ ការពារ បរិស្ថាន សណ្តាប់ធ្នាប់ សេចក្តីថ្លៃថ្នូរ ក្នុង ឱកាស ទស្សនា ប្រាសាទ បូរាណ ។
គួរ ជម្រាប ថា ជាមួយគ្នា នេះ ក្រុម អ្នកវិទ្យាសាស្រ្ត ឥណ្ឌា កំពុងតែ ខ្នះ ខ្នែង អភិវឌ្ឍន៍ វ៉ាក់សាំង COVID-19 ជាខ្លាំង ។ កាលពី ថ្ងៃសៅរ៍ ម្សិលមិញ នាយក រដ្ឋមន្រ្តី ឥណ្ឌា លោក ណារិន ដ្រា ម៉ូឌី បាន ប្រកាស ថា វ៉ាក់សាំង ចំនួន ៣ប្រភេទ កំពុង ស្ថិត ក្នុង ការធ្វើតេស្ត នៅ ដំណាក់កាល ខុស ៗ គ្នា ហើយ បាន ប្តេជ្ញា យ៉ាង មុតមាំ ថា ប្រទេស លោក នឹង យកឈ្នះ វីរុស ដ៏ កាច សាហាវ នេះ ឲ្យបាន ៕
លោកស្រី កិត្តិបណ្ឌិត អ៊ុក ម៉ាលី និង ពលរដ្ឋ ប្រមាណ ៣០០ នាក់ ដាំ កូន ឈើ នៅ មជ្ឈមណ្ឌល វប្បធម៌ ព្រះពុទ្ធ សាសនា កម្ពុជា ស្ថិត ក្នុង ឧទ្យាន ជាតិ គិរីរម្យ
( កំពង់ស្ពឺ ) ៖ លោកស្រី កិត្តិបណ្ឌិត អ៊ុក ម៉ាលី អគ្គ ទេសាភិបាល រង ធនាគារ ជាតិ នៃ កម្ពុជា ដោយ មាន ការចូលរួម ពី ប្រជាពុទ្ធ បរិស័ទ ជា ញាតិ ព្រះធម៌ មកពី ខេត្ត សៀមរាប នៅ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន ដាំ កូន ឈើ ជិត ៣០០ ដើម នៅក្នុង មជ្ឈមណ្ឌល វប្បធម៌ ព្រះពុទ្ធ សាសនា កម្ពុជា ស្ថិត ក្នុង ឧទ្យាន ជាតិ គិរីរម្យ ខេត្ត កំពង់ស្ពឺ ។
មហា ឧបាសិកា ធម្ម បណ្ឌិត ញ៉ឹក ប៊ុន ថា បាន ថ្លែង បន្ដ ថា « ដើមឈើ មាន សារៈសំខាន់ ណាស់ ជា ជម្រក យ៉ាង ត្រជាក់ ត្រជុំ សម្រាប់ មនុស្ស និង សត្វ ដូច ជាដើមឈើ នៅ តាម ព្រៃ ភ្នំ ជា ជម្រក របស់ សត្វ ព្រៃ ទាំងឡាយ ជ្រក អាស្រ័យ ជាពិសេស ដើមឈើ ជួយ សម្អាត ខ្យល់ និង ផ្តល់ អុកហ្សី សែន ផងដែរ » ។
ក្នុង ឱកាស នោះ មហា ឧបាសិកា ធម្ម បណ្ឌិត ញ៉ឹក ប៊ុន ថា ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោកស្រី កត្តិ បណ្ឌិត អ៊ុក ម៉ាលី និង ក្រុមគ្រួសារ រួមទាំង ថ្នាក់ដឹកនាំ ជាតិ ព្រះទាំង ព្រះសង្ឃ និង ញាតិ ព្រះធម៌ មកពី ខេត្ត សៀមរាប ទាំងអស់ ដែល បាន និមន្ត និង អញ្ជើញ ចូលរួម ក្នុង ពិធី ដាំ កូន ឈើ ក្នុង បរិវេណ នៃ មជ្ឈមណ្ឌល វប្បធម៌ ព្រះពុទ្ធ សាសនា កម្ពុជា ដើម្បី បង្កើន គម្រប បៃតង នៅក្នុង ឧទ្យាន ជាតិ គិរីរម្យ បន្ថែម ទៀត ។
មហា ឧបាសិកា បាន បញ្ជាក់ ថា មជ្ឈមណ្ឌល វប្បធម៌ ព្រះពុទ្ធ សាសនា កម្ពុជា នេះ បាន ចាប់ផ្ដើម បង្កើត និង សាងសង់ នូវ ប្រាសាទ ដំបូង គេ មួយ នៅ ឆ្នាំ ២០១៥ ដែល សាងសង់ ប្រាសាទ ទី១ នេះ បាន ជាង ៩០% ហើយ ចំណាយ ថវិកា ប្រមាណ ជាង ៣លាន ដុល្លារ ដែល ជា ថវិកា ចូលរួម ពី ពុទ្ធ បរិស័ទ ។ បច្ចុប្បន្នេះ ក្រៅពី ប្រាសាទ នេះ ក៏ មាន គម្រោង សាងសង់ ជាច្រើន ផ្សេង ទៀត បាន នឹង កំពុង កសាង ជា បន្ដ បន្ទាប់ ដើម្បី កសាង សមិទ្ធផល បម្រើ លើ វិស័យ ព្រះពុទ្ធ សាសនា ។
បច្ចុប្បន្ន នេះ វិស័យ កសិកម្ម យើង ក៏ ទទួលរង នូវ ការគំរាមគំហែង យ៉ាង ធ្ងន់ធ្ងរ ពី បម្រែបម្រួល អាកាសធាតុ ការកើនឡើង នៃ កម្តៅ ភព ផែនដី ដែល បង្ករ ឱ្យ មាន ជារៀងរាល់ ឆ្នាំ នូវ គ្រោះ រាំងស្ងួត ទឹក ជំនន់ ភាព រេចរិល ដី កសិកម្ម និង ការរីករាលដាល នៃ ជំងឺ ឆ្លង សត្វ ល្អិត ចង្រៃ លើ ដំណាំ ជាដើម ។ យ៉ាងណាមិញ យើង ក៏ ទទួលស្គាល់ ថា ព្រៃឈើ មាន ទំនាក់ទំនង ជាសាវ័ន្ត ជាមួយ ជីវិត លើ ភព ផែនដី ។
នេះ ជា កត្តា សត្យានុម័ត និង អត្តនោម័ត ព្រៃឈើ បាន ផ្តល់ នូវ ពហុ ប្រយោជន៍ មិន អាច ប៉ាន់ប្រមាណ បាន ដល់ មនុស្សជាតិ ហើយ ព្រៃឈើ មិន ត្រឹមតែ មាន តម្លៃ ខាង សេដ្ឋកិច្ច និង សង្គមជាតិ ប៉ុណ្ណោះ ទេ ថែមទាំង បាន ជួយ ថែរក្សា លំនឹង បរិស្ថាន ធម្មជាតិ ធ្វើឱ្យ ធាតុអាកាស មាន ភាព កាន់តែ ប្រសើរឡើង រក្សា និយ័ត ភាព ប្រភព ទឹក ការពារ ទី ជម្រាល និង ការពារ ជីវ ចម្រុះ ពោលគឺ ព្រៃឈើ មាន ទំនាក់ទំនង គ្នា យ៉ាង ជិតស្និត ជាមួយ កសិកម្ម ។
ការដាំ ដើមឈើ និង ការដាំ រុក្ខជាតិ គ្រប់ ប្រភេទ នឹង ផ្តល់ នូវ បុណ្យ កុសល ដល់ មនុស្សជាតិ ផងដែរ ដូចនេះ ត្រូវ ចូលរួមចំណែក ការពារ ថែរក្សា បរិស្ថាន ធម្មជាតិ បរិស្ថាន សង្គម និង បរិស្ថាន វប្បធម៌ របស់ ប្រជាជាតិ កម្ពុជា យើង ទាំងអស់ គ្នា ។
ទន្ទឹមនឹង ការដាំ ដើមឈើ ឡើងវិញ ក៏ ត្រូវ រួម កម្លាំង គ្នា ការពារ ថែរក្សា ព្រៃឈើ ព្រៃ លិច ទឹក ដែល មាន ស្រាប់ ឱ្យ បាន គង់វង្ស ដើម្បី រក្សា បាន លំនឹង បរិស្ថាន មាន បរិយាកាស ល្អ ជា ទីស្ថាន ដ៏ សែនមនោរម្យ ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ ផងដែរ ៕
ចំណេះដឹង ទូទៅ៖ ពពួក ត្រី មួយ នេះ គឺជា សត្វ ធំ បំផុត ដែល កំពុង រស់ នៅ លើ ផែនដី
កូន ត្រី បាឡែន ខៀវ ពេល កើត មក អាច មាន ទម្ងន់ រហូតដល់ ៣តោន និង មាន ប្រវែង ៨ម៉ែត្រ ។ បាឡែន ខៀវ ដែល ទើបនឹង កើត តែង ត្រូវ មេ របស់ វា ជួយ នាំ ឡើង ទៅ លើ ផ្ទៃ ទឹក ដើម្បី ដកដង្ហើម ជា លើក ដំបូង ។ កូន ត្រី បាឡែន ខៀវ ផឹក ទឹកដោះ ច្រើន ៦០០លីត្រ ក្នុង មួយ ថ្ងៃ ហើយ កើន ទម្ងន់ ខ្ទង់ ៩០ គីឡូក្រាម ជារៀងរាល់ ថ្ងៃ សម្រាប់ មួយ ឆ្នាំ ដំបូង របស់ វា ។
តាមរយៈ លទ្ធផល នេះ ក៏ បង្ហាញ ផងដែរ ថា ពលរដ្ឋ ខ្មែរ បាន រួមគ្នា ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ការពារ ថែរក្សា ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម និង សុវត្ថិភាព ដែល ជា អាទិភាព របស់ ប្រទេស និង ជា គ្រឹះ នៃ ការការពារ និង ការថែរក្សា សន្តិភាព របស់ ប្រទេសជាតិ ។
ម្យ៉ាងទៀត លទ្ធផល នៃ ការស្ទង់ មតិ របស់ អង្គការ ខុម ហ្វ្រែល នេះ បង្ហាញ កាន់តែ ច្បាស់ ទៀត ថា ពលរដ្ឋ ខ្មែរ មិន គាំទ្រ ទង្វើ ស្មោគ គ្រោក បំផ្លិចបំផ្លាញ ជាតិ របស់ ក្រុម ជ្រុលនិយម ឡើយ ប៉ុន្តែ ប្តេជ្ញា ពួត ដៃ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា និង គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ការពារ ដាច់ខាត សុខ សន្តិភាព ស្ថិរភាព នយោបាយ ដែល កម្ពុជា រក បាន ដោយ ពិបាក នេះ និង ចូលរួម ថែរក្សា ការពារ សន្តិភាព មាន អាយុកាល ២១ ឆ្នាំ មកហើយ នេះ ឱ្យ បាន យូរអង្វែង រាប់ ជំនាន់ ទៅ មុខ ទៀត ។
ប្រជាពលរដ្ឋ កម្ពុជា សង្ឃឹម និង ជឿជាក់ ថា អង្គការ ខុមហ្វ្រែល នឹង ផ្តល់ ភាពយុត្តិធម៌ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង វិធានការ ការពារ សន្តិភាព ស្ថិរភាព នយោបាយ និង សណ្តាប់ធ្នាប់ សង្គម នេះ តាមរយៈ ការហ៊ាន ទទួលស្គាល់ ការពិត និង ហ៊ាន ប្រកាស ជាសាធារណៈ លើ លទ្ធផល នៃ ការស្ទង់ មតិ របស់ ខ្លួន ដើម្បីឱ្យ ប្រជាពលរដ្ឋ បាន ដឹង បាន ឮ គ្រប់ ៗ គ្នា ប្រសិនបើ អង្គការ នេះ មាន ឯករាជ្យ អព្យាក្រឹត្យ មិន រក កម្រៃ និង មិន ទទួល ឥទ្ធិពល ពី គណបក្ស នយោបាយ ឬ ពី បរទេស ណាមួយ ពិតប្រាកដ មែន នោះ ។
សម្តេច ថ្លែង បែប នេះ នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ១៦ ខែសីហា ឆ្នាំ ២០២០ ក្នុង ឱកាស អញ្ជើញ ទស្សនកិច្ច និង បើក សម្ពោធ សួន ទឹក « ហ្គាឌិន ស៊ីធី » របស់ ឧកញ៉ា លី យ៉ុង ផាត់ ស្ថិត នៅ សង្កាត់ ព្រែក តា សេក ខណ្ឌ ជ្រោយ ចង្វា រាជធានី ភ្នំពេញ ។
សម្តេច បាន រំលឹក ថា ការរៀបចំ ព្រំដែន នេះ គឺ កម្ពុជា យក តាម ផែនទី ដែល ត្រូវបាន តម្កល់ នៅ អង្គការ សហ ប្រជាជាតិ ហើយ បារាំង ជា អ្នក គូស កាលពី អតីតកាល ។ ក្នុង ចំណុច នេះ ដែរ សម្តេច បាន គូស រំលេច ពី ការដោះដូរ ដី មួយ កន្លែង ដែល ស្ថិត នៅក្នុង ភូមិ សម្តេច ហេង សំរិន ព្រោះ កាល មិន ទាន់ រៀបចំ ព្រំដែន ថ្មី ភូមិ មួយ នេះ ស្ថិត នៅលើ ដី វៀតណាម មាន ចំនួន ៥០០ ហិកតា ធ្វើឲ្យ កម្ពុជា ត្រូវ រក ដី ដូរ ជាមួយ វៀតណាម ៥០០ ហិកតា វិញ ដែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ពន្យល់ ថា ភូមិ ខ្មែរ មួយចំនួន ដែល ចូលទៅ ភាគី វៀតណាម ដោយសារតែ ខ្សែ បន្ទាត់ ព្រំដែន របស់ បារាំង បាន គូស បែប នោះ ។ ហេតុ នេះ ហើយ ទើប កម្ពុជា និង វៀតណាម បាន ព្រមព្រៀង គ្នា ក្នុង ការដោះដូរ ដី ភូមិ រៀង ៗ ខ្លួន ។
សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក ម្តង ហើយ ម្តង ទៀត ថា ផែនទី ប្រើ សម្រាប់ កំណត់ ព្រំដែន ជាមួយ ប្រទេស វៀតណាម គឺ បន្សល់ ដោយ បារាំង មិន មែន ជា ផែនទី កំណត់ ដោយ ខ្មែរ នោះ ទេ ហើយ សម្តេច ថ្លែង បន្ថែម ថា រឿង ព្រំដែន មិន មែន ជា រឿង លេងសើច ទេ និង ប្រាប់ ក្រុម ប្រឆាំង កុំ ញុះញង់ ឱ្យ មាន សង្គ្រាម ជាមួយ ប្រទេស ជិតខាង ។ សម្តេច តេជោ បាន ចោទសួរ ថា ស្នេហាជាតិ អី តែ ក្រុម ប្រឆាំង ណុង ? បើសិនជា ដី ខ្មែរ បាត់ រាល់ ថ្ងៃ ដូច ការចោទ របស់ គេ នោះ ខ្មែរ អស់ ដី ហើយ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ជាថ្មី ថា ការរៀបចំ ព្រំដែន រវាង កម្ពុជា និង វៀតណាម បាន ធ្វើ តាម ផែនទី បោន ១/១០០ ០០០ និង ផែនទី UTM ១/ ៥០ ០០០ ។ សម្រាប់ ផែនទី ១/២៥ ០០០ គឺ ធ្វើឡើង ដើម្បី ងាយស្រួល ក្នុង ការមើល និយាម ការលើ ព្រំដែន ជាក់ស្តែង ហើយ ថ្ងៃទី ២៧ ប្រគល់ ដល់ ខេត្ត ជាប់ ព្រំដែន វៀតណាម ។ សម្តេច តេជោ បាន ថ្លែង ថា ព្រំដែន រវាង កម្ពុជា និង ប្រទេស ជិតខាង មិន ស្ថិត នៅលើ មាត់ របស់ ក្រុម ប្រឆាំង ទេ គឺ ស្ថិត នៅលើ ច្បាប់ អន្តរជាតិ ។
សូម ជម្រាប ថា កម្ពុជា និង វៀតណាម មាន ព្រំដែន គោក ជាមួយគ្នា ប្រវែង ប្រមាណ ១.២៧០ គីឡូម៉ែត្រ ដោយ យោង ទៅតាម ការកំណត់ ក្នុង ផែនទី បោន ខ្នាត១ លើ ១០០០០០ ដែល បន្សល់ទុក ពី សម័យ អាណានិគម និង បាន តម្កល់ ទុក នៅ អង្គការ សហ ប្រជាជាតិ ។ ការបោះ បង្គោល ព្រំដែន នៃ ប្រទេស ទាំង ពីរ បាន ចាប់ផ្តើម ធ្វើឡើង តាំងពី ឆ្នាំ ២០០៥ មក ដែល រហូតមកដល់ ពេល បច្ចុប្បន្ន ការបោះ បង្គោល ព្រំដែន នេះ សម្រេចបាន ប្រមាណ ៨៤ ភាគរយ ផងដែរ ៕
ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ដំណើរការ សាកល្បង សួន ទឹក « ហ្គាឌិន ស៊ីធី » របស់ ឧកញ៉ា លី យ៉ុង ផាត់ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២០ នេះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា សង្ឃឹម ថា អង្គការ ខុមហ្វ្រែល និង បណ្តាញ ព័ត៌មាន បរទេស នានា យក លទ្ធផល ស្ទង់ មតិ របស់ អង្គការ ខុម ហ្វ្រែល ជុំវិញ ការចាប់ខ្លួន លោក រ៉ុង ឈុន ។ ការស្ទង់ មតិ នេះ មាន ៧៩ ភាគរយ គាំទ្រ ចំណាត់ការ រាជ រដ្ឋាភិបាល និង មាន ២១ ភាគរយ ប៉ុណ្ណោះ មិន គាំទ្រ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ ថា សម្ដេច កំពុង រង់ចាំ មើល ថា តើ អង្គការ ខុម ហ្វ្រែល ក្រុម វិទ្យុ បរទេស ផ្សាយ ជា ខេមរភាសា និង អង្គការ សិទ្ធិ មនុស្ស នានា ផ្សាយ លទ្ធផល ស្ទង់ មតិ លើ ការចាប់ខ្លួន លោក រ៉ុង ឈុន ដែរ ឬ យ៉ាងណា ?
ជាមួយគ្នា នេះ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន សង្កត់ធ្ងន់ ថា បើ អង្គការ ខុម ហ្វ្រែល វិទ្យុ បរទេស ផ្សាយ ខេមរភាសា និង អង្គការ សិទ្ធិ មនុស្ស ព្រមទាំង ក្រុម ប្រឆាំង ផង មិន ផ្សាយ លទ្ធផល ស្ទង់ មតិ នេះ គឺជា ក្រុម តិ រិច្ឆាន ហើយ ដែល ហ៊ាន ផ្សាយ តែ រឿង អាក្រក់ របស់ រាជ រដ្ឋាភិបាល តែ មិន ហ៊ាន ផ្សាយ រឿង ដែល ប្រជាពលរដ្ឋ គាំទ្រ រាជ រដ្ឋាភិបាល ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « សង្ឃឹម ថា ខុម ហ្វ្រែល សង្ឃឹម ថា វិទ្យុ ផ្សាយ សំឡេង និយាយ ភាសា ខ្មែរ និង សារព័ត៌មាន បរទេស នានា យក ទៅ ផ្សាយ ការស្ទង់ មតិ នេះ ផង នេះ មិន មែន ជា ផេក របស់ រដ្ឋាភិបាល ឬ របស់ អ្នកគាំទ្រ រដ្ឋាភិបាល គឺជា ផេក នៃ អង្គការ ក្រៅ រដ្ឋាភិបាល មួយ ដែល ជានិច្ចជា កាល ប្រឆាំង ជាមួយ រាជ រដ្ឋាភិបាល » ។
ប្រមុខ នៃ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ថា រឿង ព្រំដែន នេះ គឺ ធ្វើឡើង ច្បាស់លាស់ ក្នុង ផ្លូវ ច្បាប់ កិច្ចព្រមព្រៀង រវាង រដ្ឋាភិបាល និង រដ្ឋាភិបាល . មាន ការសច្ចាប័ត ពី សភាព និង ព្រះមហាក្សត្រ ឡាយព្រះហស្ថលេខា ទៅ លើ ការងារ ព្រំដែន ដ៏ ជាក់លាក់ មួយ នេះ ហេតុ អ្វី បានជា ក្រុម មួយ ក្ដាប់ តូច នោះ ហ៊ាន ប្រើ ថា ការដោះដូរ ដីធ្លី គឺជា អំពើ ក្បត់ ជាតិ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ពន្យល់ ថា ភូមិ ខ្មែរ មួយចំនួន ដែល ចូលទៅ ភាគី វៀតណាម ដោយសារតែ ខ្សែ បន្ទាត់ ព្រំដែន របស់ បារាំង បាន គូស បែប នោះ ។ ហេតុ នេះ ហើយ ទើប កម្ពុជា និង វៀតណាម បាន ព្រមព្រៀង គ្នា ក្នុង ការដោះដូរ ដី ភូមិ រៀង ៗ ខ្លួន ។ តាមរយៈ ខ្សែ ផែនទី នេះ កម្ពុជា ទទួលបាន ដី ពី វៀតណាម ប្រមាណ ២ពាន់ ហិកតា ហើយ ដី នេះ ត្រូវ យក ទុក ជា ដី សម្បទាន សង្គមកិច្ច ។
សម្តេច តេជោ បាន សង្កត់ធ្ងន់ ទៀត ថា រឿង ព្រំដែន មិន មែន ជា រឿង លេងសើច ទេ កុំ ញុះញង់ ឱ្យ មាន សង្គ្រាម ជាមួយ ប្រទេស ជិតខាង ហើយ សម្ដេច បាន ចោទសួរ ថា ស្នេហាជាតិ អី តែ ក្រុម ប្រឆាំង ណុង ? បើសិនជា ដី ខ្មែរ បាត់ រាល់ ថ្ងៃ ដូច ការចោទ របស់ គេ នោះ ខ្មែរ អស់ ដី ហើយ ។
បើ តាម ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការរៀបចំ ព្រំដែន រវាង កម្ពុជា និង វៀតណាម បាន ធ្វើ តាម ផែនទី បោន ១/១០០ ០០០ និង ផែនទី UTM ១/ ៥០ ០០០ ។ សម្រាប់ ផែនទី ១/២៥ ០០០ គឺ ធ្វើឡើង ដើម្បី ងាយស្រួល ក្នុង ការមើល និយាម ការលើ ព្រំដែន ជាក់ស្តែង ហើយ ថ្ងៃទី ២៧ ប្រគល់ ដល់ ខេត្ត ជាប់ ព្រំដែន វៀតណាម ។
សូម ជម្រាប ថា រយៈពេល ៧ ថ្ងៃ នេះ អ្នក ដែល បាន ចូលរួម បោះឆ្នោត សម្តែង មតិ មាន ចំនួន ១៣. ៦០០ នាក់ ។ ក្នុង នោះ អ្នកបោះឆ្នោត គាំទ្រ ថា « ការចាប់ លោក រ៉ុង ឈុន ជា រឿង ត្រឹមត្រូវ មិន រំលោភ ច្បាប់ និង សិទ្ធិ មនុស្ស » មាន រហូតដល់ទៅ ជាង ១ម៉ឺន នាក់ ស្មើនឹង ៧៩ ភាគរយ ខណៈ អ្នកបោះឆ្នោត គាំទ្រ ថា « ការចាប់ លោក រ៉ុង ឈុន ជា រឿង រំលោភ ច្បាប់ និង សិទ្ធិ » មាន ត្រឹមតែ ជិត ៣ពាន់ នាក់ ស្មើនឹង ប្រមាណ ២១ ភាគរយ ប៉ុណ្ណោះ ។
ប្រកាស បញ្ចូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត ជាង ៣០០ នាក់ . លោក បណ្ឌិត ប៉ែន ស៊ីម៉ន ប្រាប់ មន្ត្រី បក្ស ឲ្យ ប្រឹងប្រែង បម្រើ ប្រជាពលរដ្ឋ
( កំពត ) ៖ លោក បណ្ឌិត ប៉ែន ស៊ីម៉ន សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពត បាន ផ្តាំផ្ញើ ឲ្យ សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត ចំនួន ៣២៩ នាក់ ទើប បញ្ចូល ថ្មី ត្រូវ ខិតខំ ប្រឹងប្រែង បម្រើ គណបក្ស ជាពិសេស ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន ឲ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ដើម្បី ចូលរួម កសាង ប្រទេស ឲ្យ កាន់តែ រីកចម្រើន បន្ថែម ទៀត ។
ការផ្ដាំផ្ញើ បែប នេះ ខណៈ លោក បណ្ឌិត ប៉ែន ស៊ីម៉ន ចូលរួម ជា គណៈអធិបតី ក្នុង ពិធី ប្រកាស បញ្ចូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត ថ្មី ប្រមាណ ៣២៩ នាក់ នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០២០ នៅ សាល ប្រជុំ ធំ សាលា ខេត្ត កំពត ចាស់ ។
ពិធី នេះ មាន ការចូលរួម ពីសំណាក់ លោក ជា វ តាយ ប្រធាន គណៈកម្មាធិការ គណបក្ស ខេត្ត និង ជា សមាជិក ថ្នាក់ កណ្តាល នៃ គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា និង លោក ជឹង ផល្លា អនុប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត និង ជា ប្រធាន គណៈប្រចាំ ការ គណបក្ស ខេត្ត ព្រមទាំងអស់ លោក លោកស្រី សមាជិក អចិន្រ្តៃយ៍ គណបក្ស ខេត្ត សមាជិក បក្ស មូលដ្ឋាន សរុប ជិត ៥០០ នាក់ ។
ក្នុង ឱកាស បញ្ចូល សមាជិក គណបក្ស ប្រជាជន ថ្មី ខាងលើ នោះ លោក បណ្ឌិត ប៉ែន ស៊ីម៉ន បាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ សមាជិក ថ្មី ទាំង ៣២៩ នាក់ ដែល ចូលរួម ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ពិតជា ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ ។ ពីព្រោះ គណក្ស ប្រជាជន កម្ពុជា បាន រំដោះ ប្រជាជន រួច ផុត ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
លោក បណ្ឌិត បន្ដ ថា គណបក្ស ប្រជាជន កម្ពុជា ជា គណបក្ស នយោបាយ ចាស់ទុំ ជាង គេ មាន ធនធាន មនុស្ស គ្រប់គ្រាន់ មាន រចនាសម្ព័ន្ធ រឹងមាំ គ្រប់ លំដាប់ថ្នាក់ ជាពិសេស មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន គណបក្ស និង ជា នាយក រដ្ឋមន្ត្រី ដែល មាន គតិបណ្ឌិត ដ៏ ឈ្លាសវៃ ប្រកបដោយ ភាពជឿជាក់ បាន ធ្វើឲ្យ ប្រទេសជាតិ មាន សន្តិភាព ពេញ ផ្ទៃ ប្រទេស និង បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា មាន ការរីកចម្រើន និង ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ពី ទីក្រុង រហូតដល់ ទី ជនបទ ។
ក្នុង ឱកាស នោះ ដែរ លោក បណ្ឌិត ប៉ែន ស៊ី ម៉ន ក៏ បាន ឧបត្ថម្ភ ថវិកា ដល់ សមាជិក ថ្មី ក្នុង ម្នាក់ ថវិកា ៥ម៉ឺន រៀល និង លោក ជា វ តាយ ប្រធាន គណៈកម្មការ គណបក្ស ខេត្ត កំពត បាន ឧបត្ថម្ភ បន្ថែម នូវ ទឹកប្រាក់ ចំនួន ម្នាក់ ២ម៉ឺន រៀល សរុប សមាជិក ថ្មី ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា ៧ម៉ឺន រៀល ។
គួរ បញ្ជាក់ ថា សមាជិក គណបក្ស ប្រជាជន ទើប បញ្ចូល ថ្មី គឺជា សិស្ស និស្សិត មកពី វិទ្យាស្ថាន បច្ចេកវិទ្យា ភូមិភាគ តេជោ សែន កំពត និង មកពី សាលា គរុកោសល្យ ខេត្ត កំពត ៕ យល់ដឹង ផ្នែក ច្បាប់៖ សញ្ចារកម្ម
( ភ្នំពេញ ) ៖ អំពើ ជួញដូរ មនុស្ស និង ធ្វើ អាជីវកម្ម ផ្លូវភេទ ជាពិសេស ទៅ លើ ស្រ្តី និង កុមារ ត្រូវបាន ប្រទេស មួយចំនួន នៅលើ សកលលោក យកចិត្តទុកដាក់ ប្រឆាំង យ៉ាង មុតមាំ ហើយ ត្រូវបាន គាំពារ ដោយ អនុសញ្ញា និង ពិធីសារ អង្គការ សហ ប្រជាជាតិ ស្តីពី ការទប់ស្កាត់ ការបង្រ្កាប និង ការផ្តន្ទាទោស ការជួញដូរ មនុស្ស ជាពិសេស ស្រ្តី និង កុមារ ដែល ព្រះរាជាណាចក្រ កម្ពុជា បាន ឱ្យ សច្ចាប័ន ។
រដ្ឋធម្មនុញ្ញ ឆ្នាំ ១៩៩៣ ក៏ បាន ហាមឃាត់ អំពើ លក់ដូរ មនុស្ស អំពើ ធ្វើ អាជីវកម្ម ផ្នែក ពេស្យាកម្ម និង អំពើ អាសអាភាស ដែល ប៉ះពាល់ ដល់ សេចក្តីថ្លៃថ្នូរ របស់ នារី ផងដែរ ។ ទោះបីជា អំពើ ទាំងនោះ ត្រូវបាន ច្បាប់ ប្រឆាំង ដាច់ខាត ក៏ដោយ ក៏ នៅ មាន បុគ្គល មួយចំនួន តូច បាន ធ្វើ សកម្មភាព បង្ខិតបង្ខំ និង អូសទាញ ជនរងគ្រោះ ឱ្យ ធ្វើ ពេស្យាចារ ដើម្បី ផលប្រយោជន៍ របស់ ខ្លួន ដែល សកម្មភាព នេះ ជា អំពើ សញ្ចារកម្ម ។
សញ្ចារកម្ម ជា អំពើ មួយ ដែល ចូលរួមចំណែក និង ជំរុញ ឱ្យ មាន ការកើត ទ្បើង នូវ អំពើ ពេស្យាចារ និង បទល្មើស ផងដែរ ។ ដើម្បី យល់ កាន់តែ ច្បាស់ ថា អ្វី ជា សញ្ចារកម្ម ហើយ អំពើ នេះ ត្រូវ ផ្តន្ទាទោស កម្រិត ណា ?
ដូច្នេះ សម្រាប់ សប្តាហ៍ នេះ កម្មវិធី យល់ដឹង ផ្នែក ច្បាប់ របស់ អង្គភាព សារព័ត៌មាន Fresh News សហការ ជាមួយ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ សូម លើក យក ប្រធានបទ ស្ដីពី « សញ្ចារកម្ម » មក ធ្វើ ការបង្ហាញ ជូន បងប្អូន ប្រជាពលរដ្ឋ សិស្ស និស្សិត ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ នា ឱកាស ឈប់ សម្រាក សង ថ្ងៃ ចូល ឆ្នាំ ខ្មែរ នេះ ក្រសួង ទេសចរណ៍ បាន ក្រើន រំលឹក សា ជា ថ្មី ដល់ ម្ចាស់ ឬ អ្នកគ្រប់គ្រង អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ទាំងអស់ នៅក្នុង រាជធានី ភ្នំពេញ និង បណ្ដា ខេត្ត ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត និង ត្រូវ រៀបចំ តាម វិធាន សុវត្ថិភាព ទេសចរណ៍ ឱ្យ បាន ខ្ជាប់ខ្ជួន និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ។
ដើម្បី ជ្រាប កាន់តែ ច្បាស់ សូម ទស្សនា បទ យក ការណ៍ ភោជនីយដ្ឋាន វ័ន ម៉រ ស្ថិត នៅ រាជធានី ភ្នំពេញ ដែល បាន អនុវត្ត ស្រប តាម វិធាន សុវត្ថិភាព ទេសចរណ៍ សម្រាប់ អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរ ណ៍៖
លោក ត្រាំ បាន ទៅ សួរសុខទុក្ខ លោក រ៉ូបឺត ត្រាំ នៅឯ មន្ទីរពេទ្យ មួយ កន្លែង ក្នុង ទីក្រុង ញូយ៉ក កាលពី ថ្ងៃសុក្រ ក្រោយ ទទួលបាន ដំណឹង ពី ក្រុម មន្រ្តី នៅ សេតវិមាន ថា លោក រ៉ូបឺត ត្រូវបាន បញ្ជូន ទៅកាន់ ទីនោះ បន្ទាប់ពី ធ្លាក់ខ្លួន ឈឺ ធ្ងន់ ។ ជុំវិញ ការបាត់បង់ ប្អូន ប្រុស បង្កើត របស់ ខ្លួន លោក ដូណាល់ ត្រាំ បាន សម្តែង ការសោកស្តាយ ជា ពន់ពេក ។
ស្នងការ ខេត្ត ព្រះសីហនុ ត្រៀម កម្លាំង រួច ជាស្រេច ការពារ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ក្នុង ឱកាស ឈប់ សម្រាក
លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នឡរបាល ខេត្ត បាន មានប្រសាសន៍ ថា គោលបំណង នៃ កិច្ចប្រជុំ នេះ គឺ ដើម្បី ផ្សព្វផ្សាយ ឲ្យ កង កំលាំង សមត្ថកិច្ច ទាំងអស់ យកចិត្តទុកដាក់ ការពារ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សង្គម ក្នុង ឱកាស ឈប់ សម្រាក រយះពេល ៩ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០២០ ដើម្បី ធានា រក្សា បាន នូវ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សង្គម ជូន ភ្ញៀវ ទេសចរណ៍ ជាតិ - អន្តរជាតិ ប្រជាពលរដ្ឋ ក្នុង ឱកាស ឈប់ សម្រាក រយះពេល ៩ ថ្ងៃ ខាងមុខ នេះ ។
ផ្សព្វផ្សាយ បន្ថែម ឲ្យ កងកម្លាំង យកចិត្តទុកដាក់ រៀបចំ សណ្តាប់ធ្នាប់ ចរាចរណ៍ បង្ការ ភាព កកស្ទះ និង បង្កើន ការរឹតបន្តឹង ការអនុវត្តន៍ ច្បាប់ ចរាចរណ៍ ផ្លូវគោក សំដៅ កាត់ន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ និង បង្ក លក្ខណះ អោយ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ទៅ កំសាន្ត តាម តំបន់ រមនីដ្ឋាន នានា ប្រព្រឹត្តទៅ ដោយ សេចក្តីសប្បាយរីករាយ និង សុវត្ថិភាព ។
លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន ជំរុញ បង្កើន វិធានការ ការពារ យ៉ាង មុឺន ម៉ាត់ ក្នុង ស្មារតី ទទួលខុសត្រូវ គ្រប់ បណ្តា គោលដៅ និង ធានា រក្សា បាន នូវ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សង្គម ដល់ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ ប្រតិភូ ភ្ញៀវ ជាតិ - អន្តរជាតិ ក្នុង ឱកាស ឈប់ សម្រាក រយះពេល ៩ ថ្ងៃ តាមរមនីដ្ឋាន នានា ។
ក្រោយពី បញ្ចប់ អង្គ ពិធី នេះ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត បាន ធ្វើ ពិធី ប្រគល់ ជូន នៅ កង់ បី ឥណ្ឌា ថ្មី ចំនួន ( ០៣) ជូន ទៅដល់ ការិយាល័យ នគរបាល ទេសចរណ៍ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា រ របស់ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ទុក សំរាប់ ប្រើប្រាស់ នៅក្នុង កិច្ចការងារ ប្រចាំ ថ្ងៃ ៕ នាយ ឧត្តមសេនីយ៍ ឈន សារ៉ាណេ ជូន ថវិកា មួយ ចំនួន ដល់ អ្នកគ្រូ ដែល ធ្លាប់ បង្ហាត់ បង្រៀន លោក
( ភ្នំពេញ ) ៖ លោក សូ សុមេធា ជា ជំនួយការ នាយ ឧត្តមសេនីយ៍ ឈន សារ៉ាណេ នា ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០២០ បាន ពាំនាំយក នូវ ថវិកា ចំនួន ៣០០ ដុល្លារ ជូន ដល់ អ្នកគ្រូ ញ៉ែ ម ទីហែ ម៉ារិន ដែល ជា អ្នកគ្រូ ធ្លាប់ បង្ហាត់ បង្រៀន នាយ ឧត្តមសេនីយ៍ ឈន សារ៉ាណេ តាំងពី ឆ្នាំ ១៩៨២ ហើយ ខណៈ ដែល បច្ចុប្បន្ន កំពុង ត្រូវការ ថវិកា សម្រាប់ ព្យាបាល ជំងឺ មហារីក ពោះវៀន ។
នា ឱកាស នោះ ដែរ អ្នកគ្រូ និង ក្រុមគ្រួសារ បាន ថ្លែងអំណរគុណ និង មាន ការសប្បាយរីករាយ ក្រៃលែង ដែល បាន បង្ហាត់ បង្រៀន សិស្ស ឱ្យ ទទួលបាន នូវ អនាគត ភ្លឺស្វាង ដូចជា នាយ ឧត្តមសេនីយ៍ ឈន សារ៉ាណេ ដែល ចេះដឹង គុណ អ្នកគ្រូ លោកគ្រូ ដោយ មិន បាន មើល រំលង ឡើយ ។
លោក សូ សុមេធា ដែល ជា ជំនួយ ការ លោក នាយ ឧត្តមសេនីយ៍ ក៏ បាន ឆ្លើយតប វិញ ដែរ ថា គាត់ នឹង ឧបត្ថម្ភ ជូន អ្នកគ្រូ ក្នុង មួយ ខែ ២៤០ ដុល្លារ សម្រាប់ ព្យាបាល ជំងឺ ដែល ពេលនេះ អ្នកគ្រូ ត្រូវការ ថវិកា នេះ សម្រាប់ ទិញ ថ្នាំ ព្យាបាល ។
សូម រំលឹក ផងដែរ ថា លោក នាយ ឧត្តមសេនីយ៍ ឈន សារ៉ា ណេ បាន លះបង់ ថវិកា បៀវត្ស មន្ត្រីរាជការ ក្នុង ១ខែ ៤លាន រៀល ដើម្បី ឧបភ្ថម្ភ ដល់ លោកគ្រូ អ្នកគ្រូ ដែល បាន ជួយ បង្ហាត់ បង្រៀង គាត់ តាំងពី ឆ្នាំ ១៩៨៥ - ១៩៩១ ចំនួន ៣៥ នាក់ ដែល ក្នុង ម្នាក់ ៗ ទទួលបាន ១២ម៉ឺន រៀល ជា រាងរាល់ ខែ រហូតដល់ លោក នាយ ឧត្តមសេនីយ៍ អស់ អាជីព ។
មិន តែ ប៉ុណ្ណោះ ទៀត លោក នាយ ឧត្តមសេនីយ៍ និង ភរិយា ក៏ បាន លះបង់ ធនធាន ជាច្រើន ដើម្បី ជួយ ឧបត្ថម្ភ ដល់ ក្រុម កីឡា បាល់ទាត់ តាំងពី ឆ្នាំ ២០១៥ រហូតដល់ បច្ចុប្បន្ន និង ទៅ ខាងមុខ ទៀត ផងដែរ មាន ដូចជា សម្លៀកបំពាក់ កីឡា និង ថ្លៃ ឈ្នួល តារាង ជាដើម ។
ទង្វើ នេះ ឆ្លុះបញ្ចាំង ដល់ ការតបស្នង សង គុណ ចំពោះ អ្នកគ្រូ លោកគ្រូ ដែល បាន ជួយ បង្ហាត់ បង្រៀន ចំណេះ វិជ្ជា ដល់ រូប គាត់ ហើយក៏ ជា ទង្វើ មួយ ដ៏ ល្អ សម្រាប់ សង្គមជាតិ ក៏ ដូចជា សិស្ស ប្អូន ៗ ជំនាន់ ក្រោយ ដែល ជា ទំពាំង ស្នង ឫស្សី ៕
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ១៦ ខែសីហា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ១៦ ខែសីហា ឆ្នាំ ២០២០ នេះ អញ្ជើញ ទស្សនកិច្ច និង បើក សម្ពោធ សួន ទឹក « ហ្គាឌិន ស៊ីធី » របស់ ឧកញ៉ា លី យ៉ុង ផាត់ ស្ថិត នៅ សង្កាត់ ព្រែក តា សេក ខណ្ឌ ជ្រោយ ចង្វា រាជធានី ភ្នំពេញ ។
សួន ទឹក « ហ្គាឌិន ស៊ីធី » គឺជា កន្លែង លេង ទឹកកម្សាន្ត ដ៏ ធំ និង ដំបូង គេ នៅក្នុង ប្រទេស កម្ពុជា ត្រូវបាន សាងសង់ ឡើង នៅ តំបន់ អភិវឌ្ឍន៍ របស់ លោក ឧកញ៉ា លី យ៉ុង ផាត់ ដែល ជា តំបន់ អភិវឌ្ឍន៍ រណប មួយ ភាគ ខាងជើង ឈាង ខាងកើត រាជធានី ភ្នំពេញ ។ របាយការណ៍ ក្រុមហ៊ុន បាន ឱ្យដឹង ថា សួន ទឹក « ហ្គាឌិន ស៊ីធី » ត្រូវបាន បោះ ទុន វិនិយោគ សរុប ជាង ៤៤ លាន ដុល្លារ អាមេរិក ។
សួន ទឹក នេះ ត្រូវបាន សាងសង់ ឡើង លើ ផ្ទៃដី ជាង ៨ហិកតា ដោយ ចាប់ផ្តើម ដំណើរការ សាងសង់ នៅ ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០១៨ ហើយ បញ្ចប់ ការសាងសង់ ទាំងស្រុង នៅ ខែកក្កដា ឆ្នាំ ២០២០ ។
សួន ទឹក ហ្គាឌិន ស៊ីធី មាន ឧបករណ៍ សម្រាប់ លេង កម្សាន្ត ទាំងអស់ ចំនួន ៣៨ ដែល ទាន់សម័យ និង មាន គុណភាព ល្អ ដោយ បាន នាំចូល ពី សហរដ្ឋ អាមេរិក និង សហគមន៍ អឺរ៉ុប ។ ឧបករណ៍ លេង កម្សាន្ត ទាំងនេះ ត្រូវបាន រចនា ឡើង សម្រាប់ មនុស្ស គ្រប់ វ័យ ទាំង វ័យ កុមារ ជំទង់ យុវវ័យ និង វ័យ ចំណាស់ ផងដែរ ។
ក្រៅពី មាន កន្លែង លេង ទឹក ហើយ នោះ នៅក្នុង សួន នេះ ក៏ មាន ភោជនីយដ្ឋាន បម្រើ អាហារដ្ឋាន មាន ទាំង អាហារ ខ្មែរ បារាំង និង កញ្ចុស សម្រាប់ អង្គុយ លេង កម្សាន្ត ផងដែរ ។
រាជធានី ភ្នំពេញ ក្រោយ រំដោះ ពី របប ប្រល័យ ពូជសាសន៍ នា ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ១៩៧៩ ត្រូវបាន គេ ប្រសិទ្ធ នាម ជា ទីក្រុង ខ្មោច ។ ក្រោយ ថ្ងៃ រំដោះ រាជធានី ដែល សល់ ពី គំនរ ផេះ ផង់ នៃ ភ្លើង សង្គ្រាម នេះ មាន ប្រជាពលរដ្ឋ ចូលមក រស់ នៅ តិចតួច បំផុត ។
តែ បច្ចុប្បន្ន រាជធានី ភ្នំពេញ រយៈពេល ជាង ៤០ ឆ្នាំ ក្រោយ ការរំដោះ បាន ក្លាយទៅជា មជ្ឈមណ្ឌល សេដ្ឋកិច្ច វប្បធម៌ ទេសចរណ៍ និង ការរស់នៅ ដ៏ រស់រវើក ។ រាជធានី ភ្នំពេញ ដែល ធ្លាប់ តែ ស្ថិត ក្រោម ស្បៃ អន្ធការ ដ៏ ខ្មៅ ងងឹត បាន ប្រែក្លាយទៅជា ស្រស់បំព្រង រំលេច ដោយ សំណង់ អគារ លំនៅឋាន ពាណិជ្ជកម្ម ខ្ពស់ ទាប និង តំបន់ លេង កម្សាន្ត ជាច្រើន ទៀត ។
ក្រោម ម្លប់ សុខ សន្តិភាព រាជធានី ភ្នំពេញ ទទួលបាន ការអភិវឌ្ឍ រីកចម្រើន លូតលាស់ យ៉ាង ខ្លាំងក្លា ហើយក៏ ទទួលបាន ចំណាត់ថ្នាក់ ជា រាជធានី ទំនើប មួយ នៅក្នុង តំបន់ ។ បច្ចុប្បន្ន ផ្ទៃដី រាជធានី ភ្នំពេញ ត្រូវបាន ពង្រីក ពី ជាង ៣០០ គីឡូម៉ែត្រ ក្រឡា ពី អតីតកាល រហូតដល់ទៅ ជិត ៧០០ គីឡូម៉ែត្រ នា ពេល បច្ចុប្បន្ន ។
វត្តមាន សួន ទឹក « ហ្គាឌិន ស៊ីធី » ជា សមិទ្ធផល នៃ ការអភិវឌ្ឍ ថ្មី មួយ ទៀត សម្រាប់ រាជធានី ភ្នំពេញ ក្រោម ម្លប់ នៃ សុខ សន្តិភាព ។ វត្តមាន សួន ទឹក « ហ្គាឌិន ស៊ីធី » បង្កើត បានជា កន្លែង លេង កម្សាន្ត នាំមក នូវ ភាពរីករាយ សម្រាប់ ពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ និយាយ ដោយឡែក ហើយក៏ សម្រាប់ ពលរដ្ឋ មក ពី គ្រប់ ទិសទី និយាយ ជា រួម ។
បន្ថែម ពីលើ នោះ វត្តមាន សួន ទឹក « ហ្គាឌិន ស៊ីធី » ក៏ ជា ការរួមចំណែក ទាក់ទាញ អ្នកទេសចរ ដែល ចូលមក លេង កម្សាន្ត នៅក្នុង ប្រទេស កម្ពុជា ផងដែរ ។
សូម បញ្ជាក់ ថា នៅ តំបន់ អភិវឌ្ឍន៍ របស់ លោក ឧកញ៉ា លី យ៉ុង ផាត់ ដែល ជា ដែនដី ព្រៃ ត្រែង ពី អតីតកាល នោះ បច្ចុប្បន្ន បាន ក្លាយជា ទីក្រុង រណប របស់ រាជធានី ភ្នំពេញ ។ តំបន់ នេះ ក្រៅតែ ពី វត្តមាន សួន ទឹក ដែល ជា សមិទ្ធផល ថ្មី ក៏ មាន កន្លែង ទស្សនា សត្វ ដ៏ ធំ ហៅ ថា សួន សត្វ សាហ្វារី . សណ្ឋាគារ . កន្លែង វាយ កូនហ្គោល ព្រមទាំង ពហុកីឡដ្ឋាន ជាតិ ដ៏ ធំ កំពុង ដំណើរការ សាងសង់ ផងដែរ ៕
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន បង្ហោះ នូវ វីដេអូ នៃ ការច្រៀង និង លេង ភ្លេង របស់ ចៅ ប្រុស ស្រី សម្តេច បទ « ចម្ប៉ា បាត់ដំបង » ក្នុង ឱកាស រៀបចំ កម្មវិធី ជួបជុំ ជា លក្ខណៈ គ្រួសារ កាលពី ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០២០ កន្លងទៅ នេះ ។
ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ នៅតែ បន្ត ជូនពរ បងប្អូន ជន រួម ជាតិ សូម ជួប តែ សេចក្តីសុខ ចម្រើន ក្នុង ឱកាស ថ្ងៃ ឈប់សម្រាក ហើយ ចេះ ការពារ ខ្លួន កុំ ឲ្យ ឆ្លង ជំងឺ កូវីដ១៩ និង ចៀស ឲ្យ ផុត ពី គ្រោះថ្នាក់ ចរាចរណ៍ ។
ការលើកឡើង យ៉ាង ដូច្នេះ របស់ សម្តេច ក៏ ព្រោះតែ នៅ ថ្ងៃទី ១៦ ខែសីហា ឆ្នាំ ២០២០ ស្អែក នេះ សម្តេច នឹង អញ្ជើញ សម្ពោធ បើក ឲ្យ ដំណើរការ នូវ សួន ទឹក កំសាន្ត ដ៏ ធំ មួយ នៅ ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ដែល វិនិយោគ ដោយ ក្រុមហ៊ុន ឯកជន នូវ ទឹកប្រាក់ ជាង ៤០ លាន ដុល្លារ ។
ជាមួយគ្នា នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន អរគុណ ដល់ ក្រុមហ៊ុន ឯកជន ទាំងអស់ ដែល បាន រួមចំណែក ជួយ ដល់ ការអភិវឌ្ឍន៍ កម្ពុជា ឲ្យ កាន់តែ រីកចម្រើន ទៅ មុខ ។
បើ ទោះបី កម្ពុជា កំពុង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ក្តី ក៏ប៉ុន្តែ មិន បាន បង្អាក់ ដល់ ដំណើរការអភិវឌ្ឍន៍ និង កិច្ចការ វិនិយោគ របស់ ក្រុមហ៊ុន ឯកជន ឡើយ ។
សូម អរគុណ ដល់ បណ្តា ក្រុមហ៊ុន ជាតិ និង អន្តរជាតិ ទាំងអស់ ដែល បាន ចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ឲ្យ កាន់តែ រីកចម្រើន ទៅ មុខ ។ ទោះ ទៅ កំសាន្ត នៅ ទីណា ក៏ដោយ សូម បងប្អូន ប្រជាពលរដ្ឋ មាន ការប្រុងប្រយ័ត្ន កុំ ឲ្យ ឆ្លង ជំងឺ កូវីដ-19 ឲ្យ សោះ ។ អរគុណ សន្តិភាព »៕
អ៉ីរ៉ង់ ថា អេមីរ៉ាត អារ៉ាប់ រួម « ប្រព្រឹត្ត ទង្វើ ក្បត់ » តាមរយៈ ការសម្រេចចិត្ត ចង ស្ពាន មេត្រីភាព ជាមួយ អ៉ី ស្រាអែល
( តេហេរ៉ង់ ) ៖ ប្រធានាធិបតី អ៉ីរ៉ង់ លោក ហាស្សាន់ រូហានី នៅ ថ្ងៃសៅរ៍ នេះ បាន និយាយ ថា អេមីរ៉ាត អារ៉ាប់ រួម បាន ប្រព្រឹត្ត ទង្វើ ក្បត់ និង កំហុស មួយ ដ៏ ធំ តាមរយៈ ការឈាន ដល់ កិច្ចព្រមព្រៀង ចង ស្ពាន មេត្រីភាព ជាមួយ អ៉ី ស្រាអែល ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃសៅរ៍ ទី ១៥ ខែសីហា ឆ្នាំ ២០២០ ។
ប៉ុន្តែ ទន្ទឹម គ្នា ប៉ាឡេស្ទីន និង តួកគី បាន ចាត់ទុក ថា នេះ គឺជា « ទង្វើ ក្បត់ » ហើយ សូម្បីតែ អ៉ីរ៉ង់ ក៏ បាន ចេញមុខ ថ្កោល ទោស ការសម្រេចចិត្ត នេះ ផងដែរ បើ ទោះជា អេមីរ៉ាត អារ៉ាប់ រួម អះអាង ថា វា ជា ការបោះជំហាន មួយ ឆ្ពោះ ទៅរក សន្តិភាព ក៏ដោយ ។ ថ្លែង នៅលើ គេហទំព័រ ផ្ទាល់ខ្លួន ប្រធានាធិបតី អ៉ីរ៉ង់ បាន គូសបញ្ជាក់ ដូច្នេះ ថា៖ « ពួកគេ ( អេមីរ៉ាត អារ៉ាប់ រួម ) កំពុង ប្រព្រឹត្ត កំហុស មួយ ដ៏ ធំ និង ជា ទង្វើ ក្បត់ ... តែ យើង សង្ឃឹម ថា ពួកគេ នឹង ដឹងខ្លួន ហើយ បោះបង់ ចោល ផ្លូវ ខុស មួយ នេះ » ។
ប្រជាពលរដ្ឋ ខ្មែរ ជារៀងរាល់ ឆ្នាំ តែង មាន ឱកាស បាន ឈប់ សម្រាក ជួបជុំ ក្រុមគ្រួសារ និង ធ្វើដំណើរកម្សាន្ត សម្បាយ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ។ តែ ដោយសារ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ រាជ រដ្ឋាភិបាល បាន សម្រេច មិន ឱ្យ មាន ការឈប់ សម្រាក នោះ ឡើយ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ នា ឆ្នាំ ២០២០ នេះ ។
មន្ត្រីរាជការ បុគ្គលិក បម្រើ ការងារ តាម ក្រុមហ៊ុន និង គ្រឹះស្ថាន ការងារ នានា ហាក់ មាន ក្តីរីករាយ ណាស់ ចំពោះ ការទទួលបាន នូវ ថ្ងៃ ឈប់សម្រាក នេះ ។ នៅ ថ្ងៃសៅរ៍ នេះ នៅលើ បណ្តាញ សង្គម ដែល ជា វេទិកា ចែករំលែក សកម្មភាព ជីវិត របស់ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ស្រទាប់ វណ្ណៈ នោះ គេ បាន ឃើញ រូបភាព នៃ ការធ្វើដំណើរកម្សាន្ត និង ការរៀបចំ គម្រោង ដំណើរកម្សាន្ត ក៏ ដូចជា ការ ទៅកាន់ ស្រុក កំណើត ត្រូវបាន រំលេច យ៉ាង ព្រោងព្រាត ទាំងម្តង ។
ស្នាមញញឹម រំលេច ឱ្យ ឃើញ ភាពរីករាយ និង ស្រស់ស្រាយ ត្រូវបាន ផុស ឡើង យ៉ាង ត្រដែត នៅលើ ផ្ទៃ មុខ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល មាន ដំណើរកម្សាន្ត នោះ ។ អ្នក ដែល គម្រោង ក៏ បាន ធ្វើដំណើរកម្សាន្ត ហើយ សម្រាប់ ពលរដ្ឋ ខ្មែរ ដែល គ្មាន គម្រោង ដំណើរកម្សាន្ត ក៏ មាន ឱកាស បាន នៅ ជួបជុំ ក្រុមគ្រួសារ ផងដែរ ក្នុង ឱកាស ឈប់ សម្រាក ពី ការងារ នេះ ។
ក្រឡេក ទៅ អាជ្ញាធរ នៅ គ្រប់ បណ្តា ខេត្ត របស់ កម្ពុជា ក៏ មាន ភាពសស្រាក់សស្រាំ ផងដែរ ជាមួយ ការរៀបចំ តុបតែង លំអរ ខេត្ត និង រៀបចំ តំបន់ ទេសចរណ៍ ដើម្បី ស្វាគមន៍ ភ្ញៀវ ទេសចរ ក្នុង ស្រុក ។ កូវីដ១៩ បាន ធ្វើឱ្យ វិស័យ ទេសចរ បាន ជួប បញ្ហា យ៉ាង ខ្លាំង ឱកាស ឈប់ សម្រាក នេះ ត្រូវបាន រំពឹង ថា ជា ឱកាស មួយ ជួយ ដល់ វិស័យ ទេសចរណ៍ ដោយ ធ្វើឱ្យ មាន លំហូរ ថវិកា ពី ប្រជាពលរដ្ឋ ធ្វើដំណើរកម្សាន្ត ទៅកាន់ បងប្អូន ប្រជាពលរដ្ឋ នៅ តាម តំបន់ គោលដៅ ទេសចរណ៍ ។
ផ្ទះសំណាក់ និង កន្លែង ស្នាក់ នៅ តាម ខេត្ត ជា គោលដៅ ទេសចរណ៍ ត្រូវបាន រាយការណ៍ ថា មាន ការកក់ សម្រាប់ ស្នាក់ នៅ បាន ច្រើន ណាស់ ដែរ ពី អ្នកទេសចរណ៍ ក្នុង ស្រុក ។
ប្រទេស កម្ពុជា ក៏ ដូចជា ប្រទេស នៅលើ ពិភពលោក ដែរ សុទ្ធតែ កំពុង ជួប នូវ ការលំបាក ផ្នែក សេដ្ឋកិច្ច ព្រោះតែ ការយាយី នៃ ជំងឺ កូវីដ១៩ ។ បើ ទោះបីជា យ៉ាងណា ទាំង កម្ពុជា និង បណ្តា ប្រទេស ទាំងអស់ លើ ពិភពលោក ទន្ទឹមនឹង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ក៏ បាន ប្រឹងប្រែង ក្នុង រក្សា លំនឹង សេដ្ឋកិច្ច ផងដែរ ។
ការដួលរលំ ផ្នែក សេដ្ឋកិច្ច ព្រោះតែ ជំងឺ កូវីដ១៨ ជា ក្តីបារម្ភ ខ្លាំងក្លា មួយ របស់ មេដឹកនាំ នៃ បណ្តា ប្រទេស លើ ពិភពលោក នា ពេល បច្ចុប្បន្ន ហើយ បាន ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ នានា ជាច្រើន ដើម្បី រក្សា ដំណើរការ សេដ្ឋកិច្ច នៅក្នុង ប្រទេស ។ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច បញ្ចេញ កញ្ចប់ ថវិកា និង ដាក់ចេញ នូវ ការអន្តរាគមន៍ ជាច្រើន ធ្វើ យ៉ាងណា ធានា ឱ្យ បាន នូវ ដំណើរ សេដ្ឋកិច្ច នៅក្នុង ប្រទេស ។
ច្បាស់ ណាស់ ថា វិបត្តិ កូវីដ១៩ បាន បង្ក ការខាតបង់ ខ្លះ សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ តែ តាមរយៈ ការដាក់ចេញ នូវ កិច្ចអន្តរាគមន៍ ទាន់ ពេលវេលា និង មាន ប្រសិទ្ធភាព ក៏ បាន ជួយ រួមចំណែក ទប់ស្កាត់ ការខាត់បង់ នេះ បាន មួយ ផ្នែក ផងដែរ ។
តាមរយៈ ទិដ្ឋភាព នៃ ដំណើរកម្សាន្ត របស់ ប្រជាពលរដ្ឋ កម្ពុជា នា ពេលនេះ បាន ស្តែង ឱ្យ ឃើញ ថា ស្ថានភាព សេដ្ឋកិច្ច និង ជីវភាព របស់ គ្រួសារ ខ្មែរ ស្ថិត ក្នុង ស្ថានភាព ដែល អាច គ្រប់គ្រង បាន នៅឡើយ បើ ទោះបី កម្ពុជា កំពុង រង វិបត្តិ សេដ្ឋកិច្ច ពី ជំងឺ កូវីដ១៩ នេះ ក៏ដោយ ។ ច្បាស់ ណាស់ បើ ស្ថានភាព សេដ្ឋកិច្ច គ្រួសារ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ជួប ការ យ៉ាប់យ៉ឺន ខ្លាំង នឹង មិន មាន សកម្មភាព ដំណើរកម្សាន្ត នៅ ថ្ងៃ ឈប់សម្រាក នេះ ឡើយ ។
ក្រុម ប្រឆាំង នៅ ក្រៅ ប្រទេស គេ តែងតែ ទស្ស ទាយ និង វាយតម្លៃ ផ្សេង ៗ លើ រាជ រដ្ឋាភិបាល ដោយ លើកឡើង ថា កម្ពុជា នឹង ត្រូវ ជួប វិបត្តិ ធ្ងន់ធ្ងរ ជាក់ ជា មិន ខាន នោះ ឡើយ នៅ ចំពោះ មុខ នាការ យាយី ដោយសារ ជំងឺ កូវីដ១៩ នេះ ។
តាមរយៈ សកម្មភាព របស់ ប្រជាពលរដ្ឋ ទាំងនេះ ជា ការបង្ហាញ ឱ្យ ឃើញ យ៉ាង ច្បាស់ ទៅកាន់ មនុស្ស ដែល តែងតែ បន់ស្រន់ ចង់ ឃើញ រាជ រដ្ឋាភិបាល កម្ពុជា ដួលរលំ ព្រោះតែ ជំងឺ កូវីដ១៩ ពី ភាពខ្លាំង ពូកែ និង ការចាត់ចែង ដឹកនាំ ដ៏ ច្បាស់លាស់ របស់ រាជ រដ្ឋាភិបាល នា ពេល បច្ចុប្បន្ន ។
បើ ទោះបីជា យ៉ាងណា ក៏ដោយ ចុះ នៅក្នុង ដំណើរកម្សាន្ត រយៈពេល ប៉ុន្មាន ថ្ងៃ នេះ ក៏ គួរ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ សុខ សុវត្ថិភាព ក្នុង ការធ្វើដំណើរ ដោយ ត្រូវ បើកបរ ដោយ ការគោរព ច្បាប់ ចរាចរណ៍ យោគយល់ អធ្យាស្រ័យ ប្រកាន់ខ្ជាប់ នូវ ស្មារតី ប្រុងប្រយ័ត្ន ។ ជាពិសេស កុំ បើកបរ ពេល មាន ជាតិ ស្រវឹង ដើម្បី ធានា ថា ការសប្បាយ របស់ ពួកយើង នា កំលុង ពេលនេះ មិន ក្លាយទៅជា ទុក្ខ នោះ ទេ ។
មួយវិញទៀត ទោះ ថា ជំងឺ កូវីដ១៩ ស្ថិត ក្នុង ស្ថានភាព អាច គ្រប់គ្រង បាន យ៉ាងណា ក៏ដោយ ចុះ តែ ក៏ មិន ត្រូវ ភ្លេច ចំពោះ វា ផងដែរ ។ សូម រួមគ្នា អនុវត្តន៍ ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម វិធាន ទាំងឡាយ របស់ ក្រសួង សុខាភិបាល ដើម្បី ធានា ថា ជំងឺ នេះ មិន ឆ្លង មក ខ្លួន យើង ក្រុមគ្រួសារ អ្នកជិតខាង និង សហគមន៍ របស់ យើង ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសៅរ៍ ទី ១៥ ខែសីហា ឆ្នាំ ២០២០ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
លោក ស្តើង សុខុម៖ ទង្វើ ល្អ របស់ មន្ត្រី ជា « វ៉ាក់សាំង » ដ៏ មាន ប្រសិទ្ធភាព បង្កា និង បន្សាប គំនិត អវិជ្ជមាន មក លើ រាជ រដ្ឋាភិបាល
( ព្រៃវែង ) ៖ លោក ស្តើង សុខុម សមាជិក គណៈកម្មាធិការ កណ្តាល នៃ គណបក្ស ប្រជាជន កម្ពុជា . អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ខេត្ត ព្រៃវែង និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក កំចាយ មារ បាន ណែនាំ ដល់ មន្ត្រី គណបក្ស ទាំងអស់ ត្រូវ ធ្វើ អំពើ ល្អ ឱ្យ បាន ច្រើន ជាមួយ ប្រជាពលរដ្ឋ ព្រោះ ទង្វើ ល្អ របស់ មន្ត្រី គឺជា « វ៉ាក់សាំង » ដ៏ មាន ប្រសិទ្ធភាព បង្កា និង បន្សាប គំនិត អវិជ្ជមាន មក លើ រាជ រដ្ឋាភិបាល ។
ការណែនាំ បែប នេះ ត្រូវបាន ធ្វើឡើង នៅក្នុង ពិធី ប្រកាស ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ ដូន កឹង ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ១៥ ខែសីហា ២០២០ ។ កម្មវិធី នេះ ត្រូវបាន ប្រារព្ធ ឡើង ក្រោម អធិបតីភាព របស់ លោក ស្បោង សារ៉ាត់ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន ខេត្ត ព្រៃវែង និង លោក ស្តើង សុខុម ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក កំចាយ មារ នៅ ឃុំ ដូន កឹង ។
លោក ស្តើង សុខុម បាន ណែនាំ ដល់ មន្ត្រី គណបក្ស ដែល ចូលរួម ប្រមាណ ២០០ នាក់ នៅក្នុង ឃុំ ដូន កឹង ថា « ទង្វើ ល្អ របស់ មន្ត្រី វា ស្តែង តាមរយៈ ការងារ របស់ ខ្លួន យើង ម្នាក់ ៗ ។ បញ្ហា សំខាន់ របស់ មន្ត្រី បក្ស គឺ ត្រូវ បន្ត ចុះ ជាប់ មូលដ្ឋាន និង ជួប សមាជិក បក្ស នៅ តាម ខ្នង ផ្ទះ . ធ្វើ ទង្វើ ល្អ ជាមួយ ប្រជាពលរដ្ឋ . ត្រូវ ជៀស ឆ្ងាយ ពី អំពើ អសកម្ម ទាំងឡាយ . ខិតខំ បម្រើ ប្រជាពលរដ្ឋ ដោយ ស្មោះត្រង់ និង ដោះស្រាយ បញ្ហា របស់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ដោយ យុត្តិ ធ៌ម តម្លាភាព និង មាន ប្រសិទ្ធភាព » ។
លោក ស្តើង សុខុម បាន លើកឡើង ផងដែរ ថា គណបក្ស ប្រជាជន កម្ពុជា បាន ឈរជើង យ៉ាង រឹងមាំ អស់ រយៈពេល ជាង ២០ ឆ្នាំ មកហើយ ដែល គ្មាន គណបក្ស ណាមួយ ប្រៀប ជាមួយ បាន ឡើយ ។ នេះ ក៏ ដោយសារតែ គណបក្ស បាន យក ប្រយោជន៍ ប្រជាជនជា ធំ នៅ ជាមួយ ប្រជាជន ធ្វើ អ្វី ៗ ដើម្បី បុព្ធ ហេតុ ប្រជាជន ។ ចំណុច ខ្លាំង ដែរ ជា គ្រឹះ ដ៏ រឹងមាំ របស់ គណបក្ស ប្រជាជន ផងដែរ នោះ គឺ មាន ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង ឈ្លាសវៃ ប្រកបដោយ ចក្ខុវិស័យ ច្បាស់លាស់ និង វែងឆ្ងាយ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ។
លោក បន្ត ថា ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា សមិទ្ធផល សំខាន់ ៗ របស់ ជាតិ ត្រូវបាន កសាងឡើង ជា បន្តបន្ទាប់ ដូចជា ផ្លូវ ស្ពាន ប្រឡាយ ទឹក អគ្គិសនី សាលារៀន ជាដើម ព្រមទាំង ការកែលំអរ និង ការបង្ខិត សេវា សាធារណៈ ឲ្យ ដល់ ជិត ប្រជាពលរដ្ឋ ដែល ជា អ្នកប្រើប្រាស់ រួមទាំង ការ មិន យក កម្រៃ ពី សេវា សាធារណៈ ចាំបាច់ មួយ ក្នុង គោលដៅ បង្ក ការងាយស្រួល ដល់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ឲ្យ កាន់តែ រីក ច្រើន ។
