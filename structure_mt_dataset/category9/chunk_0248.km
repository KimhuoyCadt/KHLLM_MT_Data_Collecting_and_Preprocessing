( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា បាន ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ឯកឧត្តម សេង ទៀង ដែល ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋលេខាធិការ នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ។
ក្នុង លិខិត របស់ អ្នក ឧកញ៉ា គិត ម៉េង បាន សរសេរ យ៉ាង ដូច្នេះ ថា « ខ្ញុំបាទ និង ភរិយា ព្រមទាំង ថ្នាក់ដឹកនាំ សមាជិក - សមាជិកា នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា សូម ចូលរួម សម្ដែង សេចក្ដីអបអរសាទរ យ៉ាង ក្លៀវក្លា និង ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ ឯកឧត្តម ក្នុង ឱកាស ដ៏ ប្រសើរ ថ្លៃថ្លា ដែល ឯកឧត្តម ត្រូវបាន ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទ្រង់ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋលេខាធិការ នៃ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី ។
មក ទល់នឹង ពេល នេះ មាន វ៉ាក់សាំង ចំនួន ០៥ ក្នុង នោះ លោក ខាងលិច ចំនួន ០៣ និង ចិន ចំនួន ០២ កំពុង ស្ថិត នៅក្នុង តំណាក់កាល ទី ៣ នៃ ការធ្វើតេស្ដ ដោយ មាន មនុស្ស ចូលរួម រាប់ ពាន់ នាក់ ហើយ ក្នុង នោះ ទៀតសោត វ៉ាក់សាំង របស់ ក្រុមហ៊ុន នៃ ប្រទេស លោក ខាងលិច ត្រូវបាន សហរដ្ឋ អាមេរិក បញ្ជាទិញ យ៉ាង ច្រើន រួច មកហើយ ។
ទោះជា យ៉ាងណា កាលពី ថ្ងៃអង្គារ ម្សិលមិញ ភាពភ្ញាក់ផ្អើល មួយ បាន កើតឡើង បន្ទាប់ពី លោក ប្រធានាធិបតី រុស្ស៊ី វ្ល៉ាឌីមៀ ពូទីន បាន ប្រកាស ពី ភាពជោគជ័យ នៃ ការផលិត បាន សម្រេច នូវ វ៉ាក់សាំង ឈ្មោះ «Sputnik V» ដែល ត្រូវបាន ចុះបញ្ជី ដំបូង គេ បំផុត នៅលើ ពិភពលោក ខណៈ ប្រទេស លោក ខាងលិច ជាពិសេស គឺ សហរដ្ឋ អាមេរិក នៅតែ មាន មន្ទិល សង្ស័យ ហើយ ថែមទាំង បាន ព្រមាន ផងដែរ ចំពោះ វ៉ាក់សាំង រុស្ស៊ី ជុំវិញ ប្រសិទ្ធភាព និង សុវត្ថិភាព ។
អ្នកនាំពាក្យ WHO ខាងលើ នេះ បាន សង្កត់ធ្ងន់ ថា ការកំណត់ លក្ខណៈ សម្បត្តិ នៃ វ៉ាក់សាំង នានា គឺ តម្រូវឲ្យ មាន ការពិនិត្យ និង វាយតម្លៃ យ៉ាង ហ្មត់ចត់ ទៅ លើ ទិន្នន័យ ពាក់ព័ន្ធ គ្រប់ បែបយ៉ាង ទើប យើង អាច ដឹង ថា វា ពិតជា មាន សុវត្ថិភាព និង ប្រសិទ្ធ មែន ឬ អត់ ។ អ្នកនាំពាក្យ WHO អះអាង ទៀត ថា « ប្រទេស នានា មាន ស្ថាប័ន ជាតិ របស់ ពួកគេ ដែល អាច អនុម័ត ឲ្យ ប្រើប្រាស់ វ៉ាក់សាំង ឬ ថ្នាំ ព្យាបាល នៅក្នុង ដែនដី របស់ ពួកគេ បាន » ។
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ១២ ខែសីហា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង សុខាភិបាល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន បាន ឱ្យដឹង ថា បុរស ជនជាតិ ចិន មាន អាយុ ២២ ឆ្នាំ ដែល ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក នៅ សណ្ឋាគារ មួយ ក្នុង រាជធានី ភ្នំពេញ ។ បុរស ជនជាតិ ចិន នេះ ជា អ្នក ដែល បាន ធ្វើដំណើរ មកពី ប្រទេស ហ្វីលីពីន តាម ជើងហោះហើរ ហើយ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០២០ ។ បច្ចុប្បន្ន បុរស រូប នេះ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មណ្ឌល សុខភាព ចាក់អង្រែ ។
ដោយឡែក ស្រ្តី ជនជាតិ អាម៉េរិកកាំង មាន អាយុ ២៥ ឆ្នាំ ស្នាក់ នៅ រាជធានី ភ្នំពេញ ជា អ្នកដំណើរ មកពី សហរដ្ឋ អាម៉េរិក ហើយ បន្ត ជើងហោះហើរ នៅ ប្រទេស កូរ៉េ ខាងត្បូង មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១០ ខែសីហា ឆ្នាំ ២០២០ ។ ស្រ្តី រូប នេះ ធ្វើតេស្ត ពេល មកដល់ ទទួលបាន លទ្ធផល វិជ្ជមាន វីរុស កូវីដ - ១៩ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
ក្រសួង បាន ឱ្យដឹង ថា ក្នុង ជើងហោះហើរ នេះ មាន អ្នកដំណើរ សរុប ២៥ នាក់ ( ស្រី ០៧ នាក់ បុរស ០៩ នាក់ និង កុមារ ០៩ នាក់ ) ។ ក្នុង នោះ មាន ជនជាតិ ខ្មែរ ១៤នាក់ ជនជាតិ អាម៉េរិកកាំង ០៥ នាក់ ជនជាតិ កូរ៉េ ខាងត្បូង ០១នាក់ ជនជាតិ វៀតណាម ០១នាក់ ជនជាតិ ថៃ ០១នាក់ ជនជាតិ ទូក គឺ ០១នាក់ និង ជនជាតិ អង់គ្លេស ០២ នាក់ ។
អ្នកដំណើរ ដែល មាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ ចំនួន ២១ នាក់ ត្រូវបាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ចំនួន ១៤ ថ្ងៃ នៅ សណ្ឋាគារ មួយ ក្នុង រាជធានី ភ្នំពេញ និង មន្ត្រី ស្ថានទូត អាម៉េរិក ចំនួន ០៣ នាក់ ស្នាក់ នៅក្នុង ស្ថានទូត អាមេរិក ប្រចាំ កម្ពុជា ដែល គ្រប់គ្រង ដោយ ស្ថានទូត អាម៉េរិក ប្រចាំ កម្ពុជា ។
ដោយឡែក អ្នក កំពុង សម្រាក ព្យាបាល មាន ចំនួន ៤៨ នាក់ ។ សម្រាក នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ចំនួន ០៣ នាក់ ( ស្ត្រី ជនជាតិ កាណាដា ០១នាក់ ស្ត្រី ជា កងទ័ព មួក ខៀវ ០១នាក់ និង ស្ត្រី ជនជាតិ អាម៉េរិកកាំង ០១ នាក់ ) . នៅ មណ្ឌល សុខភាព ចាក់អង្រែ ចំនួន ៤០ នាក់ ( ស្ត្រី ០៣ នាក់ និង បុរស ៣៧នាក់ ) . នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ស្ពឺ មាន ចំនួន ០១នាក់ ជា បុរស . នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ត្បូងឃ្មុំ មាន ចំនួន ០៣ នាក់ ជា បុរស និង នៅ មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ភ្នំពេញ ១នាក់ ជា ស្ត្រី ជនជាតិ កាហ្សាក់ ស្តង់ ៕
ចាប់ពី ថ្ងៃទី ១២ - ១៣ ខែសីហា បណ្តា ខេត្ត នានា នឹង អាច មាន ភ្លៀង ពី ខ្សោយ ទៅ មធ្យម ។ បន្ទាប់ពី នោះ ភ្លៀង នឹង កើនឡើង ទាំង បរិមាណ ទាំង ភាពសាយភាយ ក្នុង កម្រិត ពី មធ្យម ទៅ បង្គួរ ។ បណ្តា ខេត្ត នៅ វាល ទំនាប កណ្តាល ភាគ ពាយ័ព្យ និង បណ្តា ខេត្ត ដែល មាន ព្រំប្រទល់ ជាប់ និង វៀតណាម អាចនឹង មាន ភ្លៀង ច្រើន ។
ក្រសួង ក៏ សូម អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល អាច នៅ បន្ត កើតមាន ជាពិសេស នៅ តំបន់ វាល ទំនាប កណ្តាល ៕
គ្រោះថ្នាក់ ចរាចរ ណ៍៖ រថយន្ត មួយ ដាច់ ហ្រ្វាំង ជ្រុល បុក រថយន្ត ៣គ្រឿង ខណៈ រថយន្ត កុងតឺន័រ ជ្រុល ចង្កូត បុក រះ ម៉ូតូ ៤គ្រឿង នៅលើ ផ្លូវ ជាតិ លេខ ៤ ស្លាប់ ម្នាក់ និង របួស ២៩ នាក់
( ព្រះសីហនុ) ៖ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ វេលា ម៉ោង ១៨៖៣០ នាទី ស្ថិត នៅ ចន្លោះ គីឡូម៉ែត្រ ២១១ - ២១២ ស្ថិត នៅ ភូមិ ចំណោទ រាម ឃុំ បិត ត្រាង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ មួយ កើតឡើង ដោយ រថយន្ត FUSO មួយ ដាច់ ហ្រ្វាំង ជ្រុល បុក រថយន្ត ៣គ្រឿង ខណៈ រថយន្ត កុងតឺន័រ ជ្រុល ចង្កូត បុក រះ ម៉ូតូ ៤គ្រឿង នៅលើ បណ្តោយ ផ្លូវ ជាតិ លេខ ៤។
តាម របាយការណ៍ សមត្ថកិច្ច បាន រៀបរាប់ ឲ្យដឹង ថា គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បង្ក ដោយ រថយន្ត ០១ គ្រឿង ម៉ាក FUSO ពណ៌ ត្រួយ ចេក ពាក់ ផ្លាក លេខ ព្រះសីហនុ 3A-7073 ក្រុមហ៊ុន SP មុំ សម្ផស្ស អ្នកបើកបរ ឈ្មោះ កែវ សៅ ភី ភេទ ប្រុស អាយុ ៣៣ ឆ្នាំ មុខរបរ អ្នកបើកបរ រថយន្ត មាន ទីលំនៅ ភូមិ សាលា ឃុំ ជាំ សង្កែ ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ មាន ទិសដៅ ពី ខេត្ត ព្រះសីហនុ ឆ្ពោះទៅ ភ្នំពេញ លុះ ដល់ ចំណុច ខាងលើ ស្ថានភាព ផ្លូវ ចុះ ចំណោទ ដាច់ ហ្រ្វាំង ជ្រុល រថយន្ត ចំនួន ០៣ គ្រឿង មាន ទិសដៅ ស្រប គ្នា៖
គួរ រំលឹក ថា ការផ្ទុះ ដ៏ ខ្លាំងក្លា មួយ បាន កើតឡើង នៅ ទីក្រុង Beirut កាលពី ថ្ងៃអង្គារ សប្តាហ៍ មុន បន្ទាប់ពី ឃ្លាំង ទុកចោល យ៉ាង ធ្វេសប្រហែស ដែល មាន អាម៉ូញ៉ូម នីត្រាត ចំនួន ២. ៧៥០តោន នៅក្នុង នោះ ។ ការផ្ទុះ នេះ បាន បណ្តាលឲ្យ មាន ការខូចខាត យ៉ាង ធំ នៅក្នុង ទីក្រុង មួយ នេះ ដែល បាន បណ្តាលឲ្យ មនុស្ស រាប់ រយ នាក់ គ្មាន ផ្ទះសម្បែង រស់ នៅ ។ វា បាន កើតឡើង ស្រប ពេល ដែល លី បង់ កំពុង ដោះស្រាយ វិបត្តិ ហិរញ្ញវត្ថុ យ៉ាង ធ្ងន់ធ្ងរ និង វិបត្តិ ជំងឺ ឆ្លង COVID-19 ផងដែរ ។
ក្រសួង កសិកម្ម៖ គិត ត្រឹម ថ្ងៃទី ១០ ខែសីហា ក្រសួង បាន ចែក កូន ត្រី និង កង្កែប សរុប ជិត ២០ម៉ឺន ក្បាល ជូន កសិករ ក្នុង ខេត្ត ចំនួន ៦
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ១០ ខែសីហា ឆ្នាំ ២០២០ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ចែក កូន ត្រី អណ្តែង និង កង្កែប សរុប ជិត ២០ម៉ឺន ក្បាល ជូន ដល់ ប្រជាកសិករ ដែល រស់ នៅក្នុង ខេត្ត ចំនួន ៦ សរុប ៣៣៦ គ្រួសារ ។
អនុវត្ត តាម ការណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ស្តីពី ការជំរុញ និង លើកទឹកចិត្ត ឲ្យ ប្រជាពលរដ្ឋ ចិញ្ចឹម ត្រី និង កង្កែប ដើម្បី ធានា សន្តិសុខ ស្បៀង ក្នុង គ្រួសារ ក្នុង ខណៈ ដែល ប្រទេសជាតិ កំពុង ជួប វិបត្តិ ជំងឺ ឆ្លង កូវីដ - ១៩ ។
ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ដែល មាន រដ្ឋបាល ជលផល ជា សេនាធិការ បាន ខិតខំ ពុះពារ យកចិត្តទុកដាក់ ឈរ លើ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ អនុវត្ត អនុសាសន៍ ខាង លើ នេះ សម្រេច ទទួលបាន លទ្ធផល ដូច ខាងក្រោម៖
១៖ គិត ត្រឹម ថ្ងៃទី ១០ ខែសីហា នេះ រដ្ឋបាល ជលផល បាន នាំយក កូន ត្រី អណ្តែង កូន កង្កែប តង់ ចិញ្ចឹម និង ចំណី ទៅ ចែកជូន ប្រជាពលរដ្ឋ នៅ តាម ខេត្ត គោលដៅ ចំនួន ៦ ( ឧត្តរមានជ័យ ព្រះវិហារ មណ្ឌលគីរី រតនគីរី កំពង់ស្ពឺ និង កំពត ) រួចហើយ ក្នុង ចំណោម ខេត្ត គោលដៅ ចំនួន ១១ ( ឧត្តរមានជ័យ ព្រះវិហារ មណ្ឌលគីរី រតនគីរី កំពង់ស្ពឺ កណ្តាល កំពត ស្វាយរៀង ប៉ៃលិន ត្បូងឃ្មុំ និង ខេត្ត ព្រះសីហនុ) ។
២៖ ខេត្ត ទាំង៦ មាន ប្រជាពលរដ្ឋ សរុប ចំនួន ៣៣៦ គ្រួសារ បាន ទទួល ជំនួយ ក្នុង នោះ មាន៖
( ព្រះសីហនុ) ៖ ករណី ជនជាតិ ចិន ដាក់ ថ្នាំ សណ្ដំ ដើម្បី បន្លំ បោក លុយ ជនជាតិ ចិន ដូចគ្នា ជាង ៦ម៉ឺន ដុល្លារ ត្រូវ កម្លាំង នគរបាល ខេត្ត ព្រះសីហនុ បំបែកបាន ដោយ ជោគជ័យ និង ឈានដល់ ការចាប់ខ្លួន បាន ជនសង្ស័យ ៤នាក់ រំដោះ ជនរងគ្រោះ ម្នាក់ ផងដែរ នៅ ចំណុច ហាង បាយ ជប៉ុន សណ្ឋាគារ ឃ្វីន កូ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ឲ្យដឹង នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ ថា ហេតុការណ៍ នេះ កើតឡើង នៅ ថ្ងៃទី ០២ ខែសីហា ក្រោយ ទទួល ពាក្យបណ្ដឹង ភ្លាម កម្លាំង ជំនាញ បាន បើក ការស្រាវជ្រាវ និង ឈានដល់ ការចាប់ខ្លួន ជនសង្ស័យ ចំនួន ៤នាក់ នៅ យប់ ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០២០ ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ជនសង្ស័យ ទាំង ៤នាក់ ដែល កម្លាំង ជំនាញ របស់ អធិការដ្ឋាន នគរបាល ក្រុង ព្រះសីហនុ ចាប់ខ្លួនេះ បាន ធ្វើ សកម្មភាព ដាក់ ថ្នាំ សណ្តំ ក្នុង ស្រាបៀរ ឲ្យ ជនរងគ្រោះ ផឹក រួច បំភ័ន្តឲ្យ ជនរងគ្រោះ វេលុយ តាម វីឆាត ទៅ គណនី ជនសង្ស័យ អស់ ទឹកប្រាក់ ចំនួន ៦៤. ៨៩០ ដុល្លារ ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង៤នាក់ ខាងលើ កំពុង ឃាត់ខ្លួន បណ្តោះ អាសន្ន នៅ អធិការដ្ឋាន នគរបាល ក្រុង ព្រះសីហនុ បន្ត តាម នីតិវិធី ៕
ព្រឹក ស្អែក អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « ការប្រែប្រួល អាកាសធាតុ និង ផល ប៉ះពាល់ មក លើ ប្រទេស កម្ពុជា »
ក្នុង សេចក្ដីជូនដំណឹង បាន ឲ្យដឹង ថា សន្និសីទ សារព័ត៌មាន នេះ មាន ការសម្របសម្រួល ពី លោក ផៃ ស៉ី ផាន រដ្ឋមន្ដ្រី ប្រតិភូ អម នាយក រដ្ឋមន្ដ្រី និង ជា ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល និង មាន ការអញ្ជើញ ចូលរួម ជា វាគ្មិន ពី លោក នេត្រ ភត្ដ្រា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន ៕
( បរទេស ) ៖ ខាងក្រោម គឺជា រូបភាព មួយចំនួន នៃ ស្ថានការណ៍ អន្តរជាតិ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃអង្គារ ទី ១១ ខែសីហា ឆ្នាំ ២០២០ ។
សិក្ខាកាម វគ្គ បណ្តុះបណ្តាល ទាក់ទង នឹង គ្រឿងញៀន ត្រៀម បម្រើ ការងារ នៅ មជ្ឈមណ្ឌល ជាតិ នៅ ខេត្ត ព្រះសីហនុ ទទួលបាន ការទស្សនកិច្ច សិក្សា នៅ មណ្ឌល ឱកាស ខ្ញុំ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ ក្រុម សិក្ខាកាម ទទួល ការបណ្តុះបណ្តាល ស្តីពី ការងារ ព្យាបាល និង ស្តារ នីតិសម្បទា អ្នក ញៀន គ្រឿងញៀន ដែល ត្រៀម ទៅ បម្រើ ការងារ នៅ មជ្ឈមណ្ឌល ជាតិ ផ្តល់ សេវា ព្យាបាល ដោយ ស្ម័គ្រចិត្ត និង ផ្អែក លើ សហគមន៍ នៅ ខេត្ត ព្រះសីហនុ ទទួលបាន ការអនុញ្ញាត ឱ្យ ធ្វើ ទស្សនកិច្ច សិក្សា ស្វែងយល់ នៅ មជ្ឈមណ្ឌល ឱកាស ខ្ញុំ ។
ការទស្សនកិច្ច ធ្វើឡើង ក្រោម វត្តមាន សម្របសម្រួល ដោយ ឧត្តមសេនីយ៍ ទោ លឹម តុង ហួត ប្រធាន នាយកដ្ឋាន នីតិកម្ម អប់រំ និង ស្តារ នីតិសម្បទា និង លោកស្រី មុំ ចាន់ ដានី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា ប្រធាន មជ្ឈមណ្ឌល ឱកាស ខ្ញុំ ។
លោក ស្រី មុំ ចាន់ ដានី បាន ធ្វើ ការចែករំលែក បទពិសោធន៍ អនុវត្តន៍ ជាក់ស្តែង លើ ការងារ គ្រប់គ្រង ការងារ ព្យាបាល ស្តារ នីតិសម្បទា បណ្តុះបណ្តាល វិជ្ជាជីវ : និង ការងារ សមាហរណកម្ម អ្នក ញៀន គ្រឿងញៀន ទៅ រស់ នៅក្នុង គ្រួសារ និង សហគមន៍ វិញ ។
ក្នុង ឱកាស នោះ ឧត្តមសេនីយ៍ ទោ លឹម តុង ហួត បាន ថ្លែងអំណរគុណ ដល់ គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន រាជធានី ភ្នំពេញ ដែល បាន ផ្តល់ ការអនុញ្ញាត និង ថ្លែង ការកោតសរសើរ ដល់ គណ: គ្រប់គ្រង និង បុគ្គលិក មជ្ឈមណ្ឌល ឱកាស ខ្ញុំ ដែល បាន រួមគ្នា ប្រកបដោយ ការទទួលខុសត្រូវ តាម ជំនាញ ធ្វើឱ្យ ការផ្តល់ សេវា ដល់ ជនរងគ្រោះ មាន ប្រសិទ្ធភាព និង បាន ចែករំលែក បទពិសោធន៍ ការអនុវត្តន៍ ដើម្បី ផ្សារ ភ្ជាប់ នឹង ការសិក្សា ផ្នែក ទ្រឹស្តី ។
ឧត្តមសេនីយ៍ ទោ លឹម តុង ហួត ក៏ បាន ថ្លែង បន្ថែម ថា គ្រួសារ និង សហគមន៍ គឺ ធាតុ សំខាន់ ដែល ជួយ ឱ្យ អ្នក ញៀន គ្រឿងញៀន ទទួលបាន សេវា ប្រកបដោយ ប្រសិទ្ធភាព ទទួលបាន ចំណេះ ជំនាញ សម្រាប់ ប្រកបរបរ ចិញ្ចឹម ជីវិត កាត់បន្ថយ បាន នូវ ការលាប់ ធានា បាន នូវ សុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សង្គម និង សូម ចូលរួម ទាំងអស់ គ្នា ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ៕
ស្នងការ នគរបាល ខេត្ត កំពង់ឆ្នាំង នាំ ថវិកា សមាគម មិត្ត នគរបាល ជាតិ ជូន គ្រួសារ សព មន្រ្តី នគរបាល
( កំពង់ឆ្នាំង ) ៖ នៅ ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ គណៈកម្មាធិការ មូលដ្ឋាន នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ឆ្នាំង ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ទោ ខូវ លី ស្នងការ និង ជា ប្រធាន គណ:កម្មាធិការ មូលដ្ឋាន តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ជា ប្រធាន សមាគម មិត្ត នគរបាល ជាតិ កម្ពុជា មាន កិត្តិយស បាន ដឹកនាំ គណៈ កម្មាធិការ មូលដ្ឋាន នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ប្រគល់ ថវិកា ឧបត្ថម្ភ របស់ សមាគម ជូន ដល់ គ្រួសារ សព មន្រ្តី នគរបាល ។
គ្រួសារ សព មន្រ្តី នគរបាល រួម មាន៖
អភិបាល ខេត្ត ឧត្តរមានជ័យ អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រស់ នៅ តាម មាត់ បឹងតា ម៉ុក មាន ការប្រុងប្រយ័ត្ន ពិសេស ក្មេង ៗ ស្រប ពេល ទឹក កំពុង ហក់ ឡើង ខ្លាំង
( ឧត្តរមានជ័យ )៖ ស្រប ពេល ដែល ទឹកភ្លៀង បាន ធ្លាក់ ប៉ុន្មាន ថ្ងៃ ជាប់ ៗ គ្នា បាន ធ្វើឲ្យ ទឹក នៅ ស្ពាន តាម៉ុក ឫស្ពាន អូរ ជីក ស្ថិត ក្នុង ភូមិ អូរ ជញ្ជៀន ឃុំ អន្លង់ វែង ស្រុក អន្លង់ វែង មាន ការហក់ ឡើង ខ្លាំង ដល់ កម្រិត ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ។
នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២០ នេះ លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត និង លោក ស៊ី ប្រា សិទ្ធ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត អម ដំណើរ ដោយ លោក ញឺន កួន ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត ព្រមទាំង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត បាន ចុះ ពិនិត្យ ស្ថានភាព ជាក់ស្តែង ទឹក នៅ បឹង តាម៉ុក និង បាន ចុះ សួរសុខទុក្ខ សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ប្រកបរបរ លក់ ត្រី ផងដែរ ។
នៅក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ណែនាំឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម មាត់ បឹងតា ម៉ុក ត្រូវ មាន ការប្រុងប្រយ័ត្ន ជានិច្ច អំពី ទ្រព្យសម្បត្តិ ផ្សេង ៗ ហើយ អ្វី ដែល កាន់តែ ប្រុងប្រយ័ត្ន ថែម ទៀត នោះ គឺ ត្រូវ អប់រំ ណែនាំ កូន ចៅ តូច ៗ កុំ ឲ្យ ចុះ លេង ទឹក ផ្តេសផ្តាស ព្រោះ ទឹក នៅ ពេល នេះ គឺ កំពុង ហូរ ខ្លាំង ប្រយ័ត្ន មាន គ្រោះថ្នាក់ ណាមួយ កើតឡើង ជា យថាហេតុ ។
សូម បញ្ជាក់ ថា កម្ពស់ ទឹក បឹង តាម៉ុក នៅ ថ្ងៃ នេះ គឺ មាន កម្ពស់ ៣.៨១ ម៉ែត្រ បើ ធៀប និង ថ្ងៃ ម្សិលមិញ គឺ កម្ពស់ ៣.៩០ ម៉ែត្រ បាន ន័យ ថា ទឹក ស្រក អស់ ០.៩ម៉ែត្រ ចំណែក កម្រិត ត្រូវ ប្រកាស អាសន្ន គឺ កម្ពស់ ៤. ២០ម៉ែត្រ ប៉ុន្តែ ទោះជា យ៉ាងណា យើង ត្រូវ មាន លក្ខណះ ប្រុងប្រយ័ត្ន ជានិច្ច ទើប ជា ការប្រសើរ ៕
ក្រសួង បរិស្ថាន ផ្តល់ ឈើ ចំនួន ១០ម៉ែត្រ គូប ដល់ ជនជាតិ ជប៉ុន ដែល រងគ្រោះ ដោយសារ បាក់ រលំអគារ ៧ជាន់ នៅ ខេត្ត ព្រះសីហនុ
បច្ចុប្បន្ន ភោជនីយដ្ឋាន KO-KAI បាន នឹង កំពុង រៀបចំ សាងសង់ ឡើងវិញ នៅ ទីតាំង កន្លែង កើត ហេតុ ស្ថិត នៅ ភូមិ ៣ សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ហើយ មាន ការខ្វះខាត នូវ ឈើ អារ ចំនួន ១០ម៉ែត្រ គូប សម្រាប់ ធ្វើជា មេ ជញ្ជាំង ក្តារ និង សសរ ដូច ភ្ជាប់ មក ជាមួយ បញ្ជី ខ្នាត ឈើ ។
យោង តាម កម្មវិធី បុណ្យ នៅ វេលា ម៉ោង ២៖៣០ នាទី រសៀល ថ្ងៃ នេះ នឹង ជួបជុំ ញាតិមិត្ត បងប្អូន និង ក្រុមគ្រួសារ ។ លុះ ម៉ោង ៣រសៀល ថ្វាយ គ្រឿង សក្ការៈបូជា ព្រះពុទ្ធរូប ន មស្សការ ព្រះរតនត្រ័យ សមាទាន សីល និមន្ត សម្តេច ព្រះរាជ គណៈ ចំនួន ១២អង្គ ចម្រើន ព្រះបរិត្ត និង និមន្ត សម្តេច ព្រះវន រ័ត ណយ ច្រឹក សម្តេច ព្រះសង្ឃ នាយក រង ទី២ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រទាន ព្រះសទ្ធម្មវិសេស ទេសនា ។
លុះ ថ្ងៃ បន្ទាប់ គឺ ថ្ងៃពុធ ៨រោច ខែ ស្រា ពណ៍ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៤ ត្រូវនឹង ថ្ងៃទី ១២ ខែសីហា វេលា ម៉ោង ៨ព្រឹក ជួបជុំ ញាតិមិត្ត បងប្អូន និង ក្រុមគ្រួសារ ។ លុះ ម៉ោង ៨៖៣០ នាទី ព្រឹក ថ្វាយ គ្រឿង សក្ការៈបូជា ព្រះពុទ្ធរូប ន មស្សការ ព្រះរតនត្រ័យ សមាទាន សីល បន្ទាប់មក សម្តេច ព្រះរាជា គណៈ ចំនួន ១២អង្គ ស្វា ធ្យាយ ព្រះសត្ត ប្បករណា ភិធម្ម និង ប្រគេន សម្តេច ព្រះរាជា គណៈ មន្ត្រី សង្ឃ ចំនួន ៩៦ អង្គ ពហូ ទេ វា ឆ្លង បត្តិ ទាន គាថា ។
បន្ទាប់ពី នោះ នឹង មាន ការយាង និង និមន្ត សម្តេច ព្រះរាជា គណៈ មន្ត្រី សង្ឃ ចំនួន ៩៦ អង្គ បិណ្ឌបាត្រ ជា កិច្ច បង្ហើយ បុណ្យ ។
មរណភាព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ជា ការបាត់បង់ ដ៏ ធំធេង នូវ ពុទ្ធ សាសនិក មួយ រូប ពោរពេញ ដោយ សេចក្ដីបរិសុទ្ធ ក្នុង ព្រះធម្ម ដែល បាន បរិច្ចាគ នូវ ទ្រព្យ និង កម្លាំង កាយ ចិត្ត ប្រកបដោយ សទ្ធា ជ្រះថ្លា ដ៏ ជ្រាលជ្រៅ បំផុត ក្នុង ការងារ មនុស្សធម៌ និង លើកស្ទួយ វិស័យ ព្រះពុទ្ធ សាសនា ។
ការ ចូល ជាធរមាន នេះ មាន រយៈពេល ៦ខែ បន្ទាប់ EU ចេញ សេចក្តីសម្រេច របស់ ខ្លួន កាត់ ផ្នែក ខ្លះ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA កាលពី ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។ តាម ការវាយតម្លៃ របស់ រាជ រដ្ឋាភិបាល ការកាត់ ចេញ ផ្នែក ខ្លះ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA នេះ មាន ទឹកប្រាក់ ប្រមាណ ១០០ លាន ដុល្លារ ។
ឆ្លើយតប នឹង ការសម្រេច កាត់ ចេញ ផ្នែក ខ្លះ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA របស់ អឺរ៉ុប នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ជា សេនាធិការ នោះ បាន រៀបចំ គោល នយោបាយ យុទ្ធសាស្ត្រ សម្រាប់ ទប់ទល់ ដោយ ត្រៀម ថវិកា រាប់ រយ លាន ដុល្លារ ចាប់តាំងពី ដើម ឆ្នាំ ២០១៩ ពេល មិន ទាន់ កើន មាន ជំងឺ កូវីដ១៩ មក ម្ល៉េះ ។ ហើយ បើ គិត ទាំង EBA និង កូវីដ១៩ រាជ រដ្ឋាភិបាល ត្រៀម កញ្ចប់ ថវិកា រហូតដល់ ជាង ១ ពាន់ លាន ដុល្លារ ដើម្បី ទប់ទល់ ចំពោះ វិបត្តិ ដែល អាច កើត មាន ឡើង ។
លោក មាស សុខ សេន សាន បាន បញ្ជាក់ ថា ការដក ចេញ ផ្នែក ខ្លះ នៃ ប្រព័ន្ធ អនុគ្រោះ EBA នេះ មិន មែន ជា ការបាត់បង់ ទីផ្សារ នៅ អឺរ៉ុប នោះ ទេ ។ អឺរ៉ុប នៅតែ ជា ទីផ្សា របស់ កម្ពុជា គ្រាន់តែ មុខ ទំនិញ មួយចំនួន ដែល ពីមុន ធ្លាប់ តែ អនុគ្រោះ ពន្ធ មក ជា បង់ ពន្ធ វិញ ប៉ុណ្ណោះ ។
លោក ថា ការដក ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA នេះ គ្រាន់តែ ជា ការដំឡើង ពន្ធ ក្នុង រង្វង់ ប្រហែល២០ ភាគរយ នៃ ផលិតផល ដែល កម្ពុជា នាំចេញ ទៅ អឺរ៉ុប ដែល ការដំឡើង ពន្ធ នេះ មាន បច្ច័យ ដល់ រោងចក្រ ខ្លះ បង្វែរ សង្វាក់ ផលិតកម្ម ទៅ កន្លែង ដែល មិន ជាប់ ពន្ធ និង រោងចក្រ ខ្លះ ទៀត នៅតែ អាច ដំណើរការនាំចេញ បាន ។
កាលពី ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២០ គណៈកម្មការ អឺរ៉ុប (EU) បាន ចេញ សេចក្តីសម្រេច កាត់ ផ្នែក ខ្លះ នៃ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA ក្រោម ហេតុផល កម្ពុជា ធ្វើឱ្យ ធ្លាក់ នូវ ការគោរព សិទ្ធិ មនុស្ស សិទ្ធិ នយោបាយ និង លទ្ធិ ប្រជាធិបតេយ្យ និង ទាមទារ ឱ្យ កម្ពុជា កែលំអរ នូវ ចំណុច ទាំងអស់ នេះ ។ តាម ការវាយតម្លៃ ការកាត់ ផ្នែក ខ្លះ នៃ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ នេះ មាន ទឹកប្រាក់ ប្រមាណ ជាង ១០០ លាន ដុល្លារ អាមេរិក លើក ផលិតផល ៤0 មុខ របស់ កម្ពុជា ៕
លោក ប្រាយុទ្ធ បង្ហាញ ក្ដីបារម្ភ កាន់តែ ខ្លាំង ខណៈ ក្រុម បាតុករ ទាមទារ ឱ្យ មាន កំណែទម្រង់ « របប រាជានិយម ថៃ សព្វ ថ្ងៃ »
គួរ ជម្រាប ថា ប្រទេស ថៃ មាន ច្បាប់ យ៉ាង តឹងរឹង ប្រឆាំង នឹង ការប្រមាថ ព្រះមហាក្សត្រ ដោយ ផ្ដន្ទាទោស ដាក់ ពន្ធធនាគារ រហូតដល់ ១៥ឆ្នាំ ។ លោក ប្រាយុទ្ធ ធ្លាប់ បាន ព្រមាន កុំ ឱ្យ ក្រុម អ្នកតវ៉ា យក របប រាជានិយម ចូលមក ពាក់ព័ន្ធ ។ តែ ទន្ទឹម គ្នា លោក បា្រ យុទ្ធ បាន អះអាង ថា ព្រះមហាក្សត្រ ថៃ Maha Vajiralongkorn ដែល បាន គ្រងរាជ្យ បន្ទាប់ពី ការសោយទិវង្គត របស់ ព្រះបិតា របស់ ទ្រង់ កាលពី ឆ្នាំ ២០១៦ បាន ស្នើសុំ លោក មិន ឲ្យ មាន ការចាប់ខ្លួន នរណា ម្នាក់ នៅក្រោម ច្បាប់ « ប្រមាថ ព្រះមហាក្សត្រ » នោះ ទេ ៕
