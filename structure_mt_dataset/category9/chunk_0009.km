( ពោធិ៍សាត់ )៖ យុវជន ប្រុស ស្រី ២នាក់ ត្រូវបាន ទឹក ហូរ គួច យក ទៅ បាត់ យុវជន ម្នាក់ ត្រូវបាន រកឃើញ និង នារី ម្នាក់ ទៀត ត្រូវបាត់បង់ជីវិត ដែល ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ០២៖៣០ នាទី ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ ម្សិលមិញ ខណៈ ដែល មក លេង កម្សាន្ត នៅ រមណីយដ្ឋាន ទឹក ធ្លាក់ ថ្ម ដា តូច ស្ថិត ក្នុង ភូមិ ឯកភាព ឃុំ ថ្ម ដា ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ ។
នៅក្នុង រយៈពេល ដូចគ្នា នេះ អ្នក ឆ្លង ថ្មី ៗ ចំនួន ២៧. ១១៤ នាក់ ក៏ ត្រូវបាន រាយការណ៍ ផងដែរ ដែល នាំឲ្យ ករណី ឆ្លង សរុប នៅ ទូទាំង ប្រទេស បាន កើន ដល់ ៨២០. ៩១៦ ករណី ដោយ ក្នុង នោះ ៥១៥. ៣៨៦ នាក់ បាន ជាសះស្បើយ ឡើងវិញ ។ ប្រការ នេះ វា បាន ធ្វើឲ្យ តួលេខ នៃ អ្នកជំងឺ សកម្ម ឬ អ្នកជំងឺ ដែល កំពុងតែ សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ នា ពេល បច្ចុប្បន្ន មាន ចំនួន ២៨៣. ៤០៧ នាក់ ។
នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃសៅរ៍ ទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ ។
( កោះកុង ) ៖ លោក ប៊ុន លើ ត រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ បាន ប្រកាស កែសម្រួល និង តែងតាំង សមាសភាព បន្ថែម ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ក្រុង ខេមរភូមិន្ទ ខេត្ត កោះកុង ។
លោក ប៊ុន កើត បាន ថ្លែង បន្ត ទៀត ថា អាជ្ញាធរ គ្រប់ មូលដ្ឋាន គ្រប់ បណ្តា ស្រុក ត្រូវ តាមដាន ចុះ មូលដ្ឋាន ដើម្បី តាមដាន ជាមួយ ប្រជាពលរដ្ឋ ក្នុង គ្រួសារ ណា ម្នាក់ មាន ជីវភាព ក្រក្រី យើង ត្រូវ ជួយ គាត់ ក្នុង ជីវភាព គ្រួសារ ដើម្បីឲ្យ ស្រប ទៅតាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក បាន បញ្ជាក់ ថា ប្រទេស មាន សន្តិភាព មាន សេរីភាព ដោយសារ គណបក្ស ប្រជាជន កម្ពុជា ខិតខំ តាំងពី ចំណុច សូន្យ បាត់ ដៃ ទទេ រហូតដល់ មាន ការរីកចម្រើន គ្រប់ វិស័យ ដែល ធ្វើឲ្យ មាន ភាព ល្បាយ ល្បី នៅលើ ឆាក អន្តរជាតិ ផងដែរ ។
ក្នុង ឱកាស នោះ លោក បាន សម្តែង ថ្លែងអំណរគុណ ដល់ សមាជិក សមាជិកា បក្ស ទាំង សមាជិក ចាស់ ថ្មី ដែល បាន ចូលរួមទាំង ស្មារតី ទាំង កម្លាំង កាយ កម្លាំងចិត្ត ក្នុង ចូលរួម បង្កើន ការស្ថាបនា បង្កើន សន្តិភាព ការការអភិវឌ្ឍ និង បង្កើន ធនធាន មនុស្ស ជូន ប្រជាពលរដ្ឋ និង ប្រទេសជាតិ ៕
បង្ក្រាប ឧក្រិដ្ឋ ជន ជួញដូរ គ្រឿងញៀន ជា ជនជាតិ វៀតណាម និង ដកហូត ថ្នាំ ញៀន ១១គីឡូក្រាម នៅ ក្រុង បាវិត ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ ជនសង្ស័យ ជា មុខសញ្ញា ជួញដូរ គ្រឿងញៀន ឆ្លង ដែន ម្នាក់ ជា ជនជាតិ វៀតណាម រួម ជាមួយ វត្ថុតាង ថ្នាំ ញៀន ប្រភេទ មេតំហ្វេតាមីន ទម្ងន់ ១១គីឡូក្រាម ត្រូវបាន កម្លាំង ជំនាញ ផែនការងារ ប្រឆាំង គ្រឿងញៀន នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ស្វាយរៀង ។ ជនសង្ស័យ ត្រូវបាន បញ្ជូន ទៅកាន់ អយ្យការ អម សាលាដំបូង ខេត្ត ដើម្បី ចាត់ការ បន្ត តាម ច្បាប់ ។
សមត្ថកិច្ច នគរបាល ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង ថា ដោយ អនុវត្ត តាម បទបញ្ជា ដ៏ ខ្ពង់ខ្ពស់ របស់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត អគ្គ ស្នងការ នគរបាល ជាតិ និង ការដឹកនាំ ចង្អុលបង្ហាញ ពី នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការរង ទទូល ផែន ប្រឆាំង បទល្មើស គ្រឿងញៀន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ក្រសួង មហាផ្ទៃ និង ក្រោម ការដឹកនាំ បញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ទោ កឹង ឃ ន ស្នងការ នគរបាល ខេត្ត ស្វាយរៀង ។
ប្រតិតបត្តិការ នេះ ស្តិត ក្រោម ការដឹកនាំ សម្របសម្រូល នីតិវិធី ពី លោក ខាំ សុផារី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ។
សមត្ថិកិច្ច បាន បន្ត ថា កាលពី ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ចំណុច ចន្លោះ បង្គោល ព្រំដែន លេខ ១៦៩ - ១៧០ ស្តិត ក្នុង ភូមិ បាវិត កណ្តាល សង្កាត់ បាវិត ក្រុង បាវិត ខេត្ត ស្វាយរៀង កម្លាំង អធិការដ្ឋាន នគរបាល ក្រុង បាវិត សហការ ជាមួយ កម្លាំង ជំនាញ ការិយាល យ័ ប្រឆាំង គ្រឿងញៀន ខេត្ត បាន បើក ប្រតិបត្តិការ ស្រាវជ្រាវ និង បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន ឆ្លង ដែន ដោយ បាន ចាប់ ជនសង្ស័យ តែម្តង ។
ជនសង្ស័យ ឈ្មោះ ង្វៀង ហុង ផុក ជនជាតិ វៀតណាម និង រឹបអូស វត្ថុតាង ថ្នាំ ញៀន ចំនួន ១១ដុំ ធំ ទម្ងន់ ១១គីឡូក្រាម ( គិត ទាំង សំបក វេចខ្ចប់ ) ម៉ូតូ១ គ្រឿង ខណៈ ដែល ជនសង្ស័យ កំពុង ធ្វើ សកម្មភាព នាំ គ្រឿងញៀន ឆ្លង ដែន ទៅកាន់ ប្រទេស វៀតណាម ៕
ក្រសួង ការងារ និង រដ្ឋបាល ខេត្ត ស្វាយរៀង អំពាវនាវ ឲ្យ កម្មករ - កម្ម ការិនី ចូលរួម បង្ការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩
( ស្វាយរៀង ) ៖ លោក ប្រាក់ ចាន់ ធឿន រដ្ឋលេខាធិការ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង លោក រស់ ផារិទ្ធ អភិបាល រង ខេត្ត ស្វាយរៀង អំពាវនាវ កម្មករ - កម្ម ការិនី រួមគ្នា បង្ការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល និង វិធានការ របស់ ក្រសួង សុខាភិបាល និង ការចូលរួម អនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ឲ្យបាន ត្រឹមត្រូវ និង មាន ប្រសិទ្ធភាព ដើម្បី លើកកម្ពស់ សុខុមាលភាព និង សុវត្ថិភាព ។
ជាពិសេស ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន បាន ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ និង ផ្តល់ ការណែនាំ ដល់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន នៅ តាម បណ្តា ក្រង ស្រុក ទាំង៨ ឲ្យ មាន ការខិតខំ យកចិត្ត ទុក ជំរុញ តាមដាន ត្រួតពិនិត្យ និង គាំទ្រ ដល់ ការអនុវត្ត នូវ កម្មវិធី គាំពារ សង្គម ទាំងអស់ របស់ រាជ រដ្ឋាភិបាល ក្នុង គោលបំណង ធានា លំនឹង ប្រាក់ ចំណូល និង ជីវភាព របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា កម្មករ និយោជិត ដែល រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ - ១៩ ។
អភិបាល រង ខេត្ត រូប នេះ បាន បញ្ជាក់ ថា កម្មករ និយោជិត និង ប្រជាពលរដ្ឋ ខេត្ត ស្វាយរៀង បាន សម្តែង នូវ ការសប្បាយរីករាយ អបអរសាទរ គាំទ្រ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ រាជ រដ្ឋាភិបាល ពិសេស សម្តេច តេជោ ហ៊ុន សែន ដែល ជានិច្ចកាល តែងតែ បាន យកចិត្តទុកដាក់ គិតគូរ អំពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ៕ អំណោយ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន ឧបត្ថម្ភ ជូន អតីត យុទ្ធជន ១០គ្រួសារ និង មន្ត្រី ជាប់ កិច្ចសន្យា នៅ ខណ្ឌ ឫស្សីកែវ
( ភ្នំពេញ ) ៖ គ្រួសារ អតីត យុទ្ធជន ចំនួន ១០គ្រួសារ រស់ នៅ សង្កាត់ ទួល សង្កែទី១ ខណ្ឌ ឫស្សីកែវ នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ បាន ទទួល ការជួប សួរ សុខទុក្ខ និង ទទួល អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន តាមរយៈ ក្រុមការងារ សមាគម អតីត យុទ្ធជន កម្ពុជា ខណ្ឌ ប្ញស្សីកែវ ដឹកនាំ ដោយ លោក ជា ពិសី អភិបាល ខណ្ឌ ។
ដោយឡែក នៅ ថ្ងៃ ដដែល នេះ សម្រាប់ លោកស្រី ប៉ាវ គឹម ហៀក ដែល ជា មន្ត្រី ជាប់ កិច្ចសន្យា នៃ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ កំពុង សម្រាក ព្យាបាល ជម្ងឺ នៅ គេហដ្ឋាន ទាំង ខ្វះខាត ក៏ ទទួលបាន ការជួប សួរ សុខទុក្ខ និង ទទួល ថវិកា ឧបត្ថម្ភ មួយចំនួន របស់ លោក ជា ពិសី ផងដែរ តាមរយៈ ក្រុមការងារ អនុសាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ខណ្ឌ ដឹកនាំ ដោយ លោកស្រី ប្រធាន សមាគម អាន ផល្លា ។
ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ស្ទឹងត្រែង ដឹកនាំ មន្ត្រីរាជការ នាំយក ទៀន ព្រះវស្សា និង ទេយ្យ ទាន គ្រឿង ឧបភោគ បរិភោគ ប្រគេន ដល់ ព្រះសង្ឃ ចំនួន ១៣វត្ត ក្នុង សៀម បូក
( ស្ទឹងត្រែង ) ៖ លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ស្ទឹងត្រែង បាន ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ នាំយក ទៀន ព្រះវស្សា និង ទេយ្យ ទាន គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ធំ ទៅ វេរ ប្រគេន ដល់ ព្រះភិក្ខុ សង្ឃ ក្នុង ស្រុក សៀម បូក ចំនួន ១៣វត្ត សម្រាប់ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ របស់ ព្រះសង្ឃ ក្នុង រយៈពេល គង់ ចាំ ព្រះវស្សា អស់ ត្រី មាស នៅ តាម ទី វត្តអារាម នានា ។
ក្នុង ឱកាស នាំយក ទៀន ព្រះវស្សា និង ទេយ្យ ទាន គ្រឿង ឧបភោគ បរិភោគ ប្រគេន ដល់ ព្រះសង្ឍ កាលពី ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ ក្រោម អធិបតីភាព លោក ឈាង ឡាក់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង មាន ការចូលរួម ពីសំណាក់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត ព្រមទាំង លោក លោកស្រី ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព មន្ត្រីរាជការ ជុំវិញ ខេត្ត ព្រមទាំង ពុទ្ធ សាសនិក ជន ជាច្រើន នាក់ ។
លោក ឈាង ឡាក់ ក៏ បាន បញ្ជាក់ ថា ទៀន ព្រះវស្សា និង ទេយ្យ វត្ថុ ដែល នាំមក ប្រគេន ព្រះសង្ឃ នា ពេលនេះ គឺ សម្រាប់ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ របស់ ព្រះសង្ឃ ក្នុង រយៈពេល គង់ ចាំ ព្រះវស្សា អស់ ត្រី មាស នៅ តាម ទី វត្តអារាម នានា ដែល ព្រះសង្ឃ មិន អាច និមន្ត ចេញ ទៅ បិណ្ឌ បាត្រ បាន ដោយ រដូវ វស្សា មាន ភ្លៀង ធ្លាក់ ជោគជាំ ហើយក៏ ដើម្បី ឧទ្ទិស កុសល ដល់ វិញ្ញាណក្ខន្ធ អ្នក ដែល បាន ចែក ឋាន ទៅកាន់ បរលោក ខាងមុខ នោះ ផងដែរ ។
លោក បាន បន្ថែម ថា « យើង ទាំងអស់ គ្នា តែងតែ គោរព ប្រពៃណី សាសនា ព្រះពុទ្ធ គឺ ព្រះសង្ឃ ក៏ ត្រូវ ចូលកាន់ ព្រះវស្សា ក្នុង រយៈពេល អស់ មួយ ត្រី មាស ដែល ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នៅក្នុង ទី វត្តអារាម នោះ ទើប ថ្ងៃ នេះ ត្រូវបាន គណៈអភិបាល ខេត្ត សប្បុរសជន ក្នុង ខេត្ត បាន នាំយក នូវ ទេយ្យ វត្ថុ ដើម្បី វេរ ប្រគេន ដល់ ព្រះសង្ឃ សម្រាប់ យក ទៅ ដុត បំភ្លឺ បូជា ថ្វាយ ព្រះ និង សិក្សា រៀនសូត្រ នូវ គម្ពីធម៌ វិន័យ ព្រះសម្មាសាម្ពុទ្ធ ព្រះបរម គ្រូ នៃ យើង » ។
តាមរយៈ បទសម្ភាសន៍ ជាមួយ ទូរទស្សន៍ ក្នុង ស្រុក មួយ នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ លោក ដូណាល់ ត្រាំ បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « ខ្ញុំ នឹង ដាក់ចេញ នូវ បទបញ្ជា ប្រតិបត្តិ ដ៏ ធំ មួយ ។ ក្នុង នាម ជា ប្រធានាធិបតី ខ្ញុំ មាន អំណាច ធ្វើ វា ។ ខ្ញុំ នឹង ធ្វើឲ្យ កម្មវិធី ការពារ ជន អន្តោប្រវេសន៍ (DACA) ក្លាយជា ផ្នែក មួយ នៃ បទបញ្ជា ប្រតិបត្តិ មួយ នេះ » ។
អាជ្ញាធរ រាជធានី ភ្នំពេញ នឹង កែសម្រួល ប្រព័ន្ធ ចរាចរណ៍ នៅ ស្តុប ច្រមុះ ជ្រូក ក្បាលថ្នល់ និង ស្តុប វត្ត នាគវ័ន្ត
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង រៀបចំ កែសម្រួល ប្រព័ន្ធ ចរាចរណ៍ នៅ ស្តុប ចំនួន ពីរ គឺ ស្តុប ច្រមុះ ជ្រូក ក្បាលថ្នល់ និង ស្តុប វត្ត នាគវ័ន្ត ដើម្បីឲ្យ ចរាចរណ៍ មាន ភាពល្អ ប្រសើរ ជាង មុន ខណៈ ដែល ស្តុប ទាំង ២នេះ តែងតែ កកស្ទះ ចរាចរណ៍ រាល់ ថ្ងៃ នោះ ។
ការបញ្ជាក់ ពី ការប្ដូរ ប្រព័ន្ធ ចរាចរណ៍ នៅ ស្តុប ទាំង ពីរ នេះ បាន ធ្វើឡើង នា ល្ងាច ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ ក្នុង កិច្ចប្រជុំ មួយ ជាមួយ មន្ត្រី ជំនាញ និង នគរបាល ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ក្រោម វត្តមាន លោក ឃួង ស្រេង អភិបាល នៃ គណៈអភិបាល រាជធានី ភ្នំពេញ ។
លោក សាំ ពិសិដ្ឋ ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ប្រព័ន្ធ ចរាចរណ៍ នៅ ច្រមុះ ជ្រូក ក្បាលថ្នល់ មាន ការកកស្ទះ ចរាចរណ៍ រាល់ ថ្ងៃ ។ ដោយ មើលឃើញ ពី បញ្ហា ខាងលើ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ក្រោម ការដឹកនាំ របស់ លោក ឃួង ស្រេង បាន សុំ គោលការណ៍ ទៅ រាជ រដ្ឋាភិបាល ដើម្បី សូម យក ស្ថានីយ ប្រេង សូគី មិច ចេញ ពី ច្រមុះ ជ្រូក ក្បាលថ្នល់ ដោយ ប្តូរ ទៅកាន់ ទីតាំង ផ្សេង ដើម្បី សម្រួល ប្រព័ន្ធ ចរាចរណ៍ នៅ តំបន់ នេះ ឱ្យ កាន់តែ ប្រសើរឡើង ជាង មុន ។
លោក សាំ ពិសិដ្ឋ បាន បញ្ជាក់ ទៀត ថា ពាក់ព័ន្ធ នឹង ការកែ ប្រពន្ធ លំហូរ ចរាចរណ៍ នៅ ស្តុប ច្រមុះ ជ្រូក ក្បាលថ្នល់ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ គ្រោង នឹង ពង្រីក ផ្លូវ ព្រះមន្នី វង្ស ឲ្យបាន បី គន្លង និង ផ្លូវ លេខ ២៧១ បី គន្លង ជាមួយនឹង ការយក ការ៉ាស់ សាំង សូគី មិច នៅ ច្រមុះ ជ្រូក នេះ ចេញ ផងដែរ ។
ដោយឡែក នៅ ស្តុប វត្ត នាគវ័ន្ត វិញ ក៏ មាន ការកែ សំរួល ប្រព័ន្ធ ចរាចរណ៍ ផងដែរ ដោយ នឹង ធ្វើ ការបើក ផ្លូវ ២២១ ក្នុង សង្កាត់ ផ្សារ ដេប៉ូទី៣ ខណ្ឌ ទួលគោក ដែល បច្ចុប្បន្ន នេះ បិទ មិន ឲ្យ ធ្វើចរាចរណ៍ ឡើង មក លើ ផ្លូវ សហព័ន្ធ រុស្ស៊ី និង កាត់ ផ្លូវ ហព័ន្ធ រុស្ស៊ី ចូលទៅ វត្ត នាគវ័ន្ត ឲ្យ ដំណើរការ ចរាចរណ៍ តែ មិន អនុញ្ញាតិ ឲ្យ បត់ ឆ្វេង បត់ ស្ដាំ ចុះ ពី ផ្លូវ សហព័ន្ធ រុស្ស៊ី ទៅ លើ កំណាត់ ផ្លូវ លេខ ២២១ នេះ ឡើយ ។
អភិបាល នៃ គណៈអភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង ក្នុង កិច្ចប្រជុំ នោះ បាន ឯកភាព ទៅនឹង ការកែសម្រួល ប្រព័ន្ធ ចរាចរណ៍ នៅ ស្តុប ទាំង ពីរ ខាងលើ ។ ប៉ុន្តែ ទោះបីជា យ៉ាងណា ក្តី លោក បាន ធ្វើ ការណែនាំឲ្យ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ពិសេស លោក សាំ ពិសិដ្ឋ មុន នៃ ការបើកឲ្យ ធ្វើចរាចរណ៍ នៅ ស្តុប ទាំង ២នេះ ត្រូវតែ ធ្វើ បទបង្ហាញ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ ឲ្យ ទូលំទូលាយ ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ប្រជាពលរដ្ឋ បាន យល់ដឹង អំពី ការកែសម្រួល ប្រព័ន្ធ ចរាចរណ៍ នៃ ស្តុប ទាំង ពីរ ខាងលើ នេះ ។
ដោយឡែក ការបើក ការដ្ឋាន ស្ថាបនា ប្រឡាយ លូ ដូចជា បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ ក្នុង នាម មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ គួរ ត្រូវតែ ធ្វើ បទបង្ហាញ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ ដើម្បីឲ្យ ប្រជាពលរដ្ឋ បាន យល់ដឹង ផងដែរ ៕
លោក បាន រំលឹក ដែរ ថា អំឡុង ពេល វិបត្តិ កូវីដ១៩ នេះ សហរដ្ឋ អាមេរិក បាន បរិច្ចាគ វិភាគទាន ១១លាន ដុល្លារ មក កម្ពុជា ដើម្បី ដោះស្រាយ បញ្ហា ជំងឺ កូវីដ១៩ ។
លោក រំពឹង ថា ថវិកា នេះ មិន ត្រឹមតែ ជួយ ដល់ វិស័យ សុខាភិបាល ទេ ប៉ុន្តែ ក៏ ចូលរួមចំណែក ទប់ស្កាត់ នូវ ការរីករាលដាល ជំងឺ កូវីដ នៅ កម្ពុជា ផងដែរ ហើយ ថវិកា នេះ ដែរ ក៏ បាន ជួយ ដល់ ប្រទេស កម្ពុជា គេច ផុត ពី បញ្ហា សេដ្ឋកិច្ច នៅពេល អនាគត ទៀតផង ។
លោក បន្ថែម ថា « ទាក់ទង នឹង ផ្លូវ ច្បាប់ យើង សង្ឃឹម ថា ប្រទេស កម្ពុជា នឹង មាន សំឡេង លើ ឆាក អន្តរជាតិ ។ ទាក់ទង នឹង កិច្ចសហប្រតិបត្តិការ វាង អាមេរិក និង កម្ពុជា គឺជា ចំណង ទំនាក់ទំនង មនុស្ស និង មនុស្ស ហើយ យើង មាន គោលដៅ រួមគ្នា ជាក់ស្តែង ពេលនេះ យើង មាន ការបង្ហាញ ពី កិច្ចសហប្រតិបត្តិការ បែប វិទ្យាសាស្ត្រ ដូច ដែល យើង បាន រួមគ្នា ក្នុង ការពិភាក្សា ផ្នែក នេះ » ។
( កណ្ដាល ) ៖ រដ្ឋបាល ខេត្ត កណ្តាល បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការអនុញ្ញាតឱ្យ អាជីវកម្ម ក្លឹប កម្សាន្ត និង ខារ៉ាអូខេ (KTV) ទាំងអស់ នៅ ខេត្ត កណ្ដាល បើក ដំណើរការ ឡើងវិញ ដើម្បី ចូលរួម សកម្មភាព សេដ្ឋកិច្ច និង ផ្តល់ ការងារ ឡើងវិញ ដោយ ប្រែក្លាយ ខារ៉ាអូខេ និង ក្លឹប កម្សាន្ត ទាំងអស់ ទៅជា លក្ខណៈ ភោជនីយដ្ឋាន ប៉ុន្តែ ស្ថិត នៅក្រោម លក្ខណ ចំនួន ២ចំណុច ។
* ទី១៖ ស្នើរ សុំ លិខិត អនុញ្ញាត អាជីវកម្ម តាម យន្តការច្រក ចេញ ចូល តែ មួយ ខេត្ត កណ្ដាល * ទី ២៖ អនុវត្តន៍ ឱ្យ បាន ម៉ឺងម៉ាត់ នូវ សេចក្ដីណែនាំ របស់ ក្រសួង សុខាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជម្ងឺ កូវីដ១៩ និង វិធាន សុវត្ថិភាព របស់ ក្រសួង ទេសចរណ៍ ។
ក្នុង ពិធី ចុះ កិច្ចព្រមព្រៀង នៅ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ លោក ឈឹម វជ្ជរ៉ា ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន លើកឡើង ថា ការចុះ កិច្ចព្រមព្រៀង ទិញ - លក់ ស្រូវ ក្រអូប នេះ មាន ដូចជា ស្រូវ ផ្កា រំដួល និង ស្រូវ សែន ក្រអូប ដោយ ក្នុង ឆ្នាំ ២០២០ នេះ ការចុះ កិច្ចព្រមព្រៀង ក្នុង ទំហំ ស្រូវ ចំនួន ១៥.០០០ តោន សម្រាប់ តម្លៃ វិញ គឺ មាន តម្លៃ មួយ សមរម្យ ជាក់លាក់ ។
លោក ឈឹម វ ជិរ៉ា បាន បញ្ជាក់ ថា « ការចុះ កិច្ចព្រមព្រៀង លើ ការលក់ និង ទិញ ស្រូវ របស់ ក្រុមហ៊ុន នាំចេញ អង្ករ និង សហគមន៍ ផលិត ស្រូវ នៅក្នុង ខេត្ត បាត់ដំបង រហូតមកដល់ ពេលនេះ សរុប ទាំងអស់ មាន ចំនួន ៦២ កិច្ចសន្យា ហើយ ដោយ រាប់ ទាំង សហគមន៍ ចំនួន ៨នេះ ផងដែរ » ។
នា ឱកាស អញ្ជើញ ធ្វើជា សាក្សី ក្នុង ការចុះ កិច្ចព្រមព្រៀង លោក គង់ ភាជ ប្រធាន នាយកដ្ឋាន ឧស្សាហកម្ម នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន លើកឡើង ថា ការចុះ កិច្ចព្រមព្រៀង រវាង ភាគី កសិករ និង អ្នកទិញ ស្រូវ នា ពេលនេះ បាន បង្ហាញ ពី ការរីកចម្រើន នៃ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ការរក ទីផ្សារ ជូន កសិករ ហើយ វា ក៏ បាន ផ្ដល់ ឱកាស សម្រាប់ កសិករ នៅ តាម តំបន់ ផ្សេង ៗ ទៀត ផងដែរ ។
លោក បាន ជំរុញ ដល់ ភាគី សហគមន៍ ផលិត ស្រូវ ទាំង៨ ត្រូវ ខិតខំ ផលិត ស្រូវ ឲ្យ ស្រប តាម ការកម្មង់ របស់ ក្រុមហ៊ុន ទាំង បរិមាណ គុណភាព ហើយ ជំរុញ ដល់ ភាគី ក្រុមហ៊ុន AMRU Rice បន្ត ជួយ ទិញ ស្រូវ របស់ កសិករ នៅ កន្លែង ផ្សេង ទៀត ក្នុង តម្លៃ សមរម្យ ។ លោក គឹម ហួត ប្រធាន មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត បាត់ដំបង បាន លើកឡើង ថា នៅក្នុង ខេត្ត បាត់ដំបង ក្នុង មួយ ឆ្នាំ ៗ ការបង្កបង្កើន ផល ស្រូវ ទទួលបាន ទិន្នផល ច្រើន រហូត ក្នុង មួយ ឆ្នាំ អាច ផលិត អង្ករ បាន ជាង ១លាន តោន ។
លោក បាន បន្ត ថា ការផលិត ស្រូវ ក្រអូប និង ការរក ទីផ្សារ ជូន កសិករ លក់ ស្រូវ ក្រអូប នេះ ក៏ ស្ថិត ក្នុង គម្រោង អេម របស់ រាជ រដ្ឋាភិបាល ខណៈ ដែល ខេត្ត បាត់ដំបង មាន កសិករ ជាច្រើន បាន ខ្ចី ថវិកា ពី ធនាគារ អភិវឌ្ឍន៍ ជនបទ និង កសិកម្ម តាមរយៈ ការសម្របសម្រួល ពី គម្រោង អេម ដើម្បី ផលិត នូវ ស្រូវ ក្រអូប នេះ ផងដែរ ៕
គួរ បញ្ជាក់ ថា នៅ ចំពោះ ស្ថានការណ៍ នេះ អាជ្ញាធរ ទីក្រុង មែល ប៊ន នៃ រដ្ឋ វិចតូរៀ បាន សម្រេច អនុវត្ត ឡើងវិញ នូវ វិធានការបិទ ខ្ទប់ ប្រទេស ឬ ហៅ ថា lockdown នៅក្នុង សប្តាហ៍ នេះ តែម្តង សម្រាប់ រយៈពេល ០៦ សប្តាហ៍ ខណៈពេល ដែល ក្តីបារម្ភ ជុំវិញ មាន ការផ្ទុះ ករណី ឆ្លង រលក ទី ២ នៅក្នុង កម្រិត សហគមន៍ ៕ TOP NEWS: ទីបំផុត ពាក្យបណ្តឹង របស់ សម្តេច តេជោ ហ៊ុន សែន ប្តឹង ទណ្ឌិត សម រង្ស៉ី ត្រូវបាន ព្រះរាជអាជ្ញា ទីក្រុង ប៉ារីស សម្រេច ឯកភាព ចោទប្រកាន់ តាម ចៅក្រម ស៊ើបសួរ និង ត្រៀម កំណត់ ថ្ងៃ បើក សវនាការ ឆាប់ ៗ
( ភ្នំពេញ ) ៖ នៅ ទីបំផុត ពាក្យបណ្ដឹង របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល ប្តឹង លោក សម រង្ស៉ី នៅ ប្រទេស បារាំង ត្រូវបាន ព្រះរាជអាជ្ញា ទីក្រុង ប៉ារីស សម្រេច ឯកភាព ចំពោះ ការដាក់ នៅក្រោម ការត្រួតពិនិត្យ ចោទប្រកាន់ ពី បទ « បរិហារ កេរ្តិ៍ ជាសាធារណៈ លើ បុគ្គល » របស់ ចៅក្រម ស៊ើបសួរ នៃ តុលាការ ព្រហ្មទណ្ឌ ទីក្រុង ប៉ារីស និង សម្រេច បញ្ជូន សំណុំរឿង ទៅ ជំនុំជម្រះ នា ពេល ឆាប់ ៗ ខាងមុខ ។
លោក គី តិច ប្រធាន ក្រុម មេធាវី រាជ រដ្ឋាភិបាល ថ្លែង ប្រាប់ នាយក ប្រតិបត្តិ អង្គភាព ព័ត៌មាន Fresh News នា ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ យ៉ាង ដូច្នេះ ថា « ពាក្យ បណ្តឹង របស់ សម្តេច តេជោ ប្តឹង ទណ្ឌិត សម រង្ស៉ី ត្រូវបាន ព្រះរាជអាជ្ញា ឯកភាព ជាមួយនឹង ការចោទប្រកាន់ ពី បទ បរិហារ កេរ្តិ៍ ជាសាធារណៈ លើ បុគ្គល របស់ ចៅក្រម ស៊ើបសួរ រួចហើយ ។ ជាមួយគ្នា នេះ ព្រះរាជអាជ្ញា ក៏ បាន ស្នើសុំ បញ្ជូន រឿង ទៅ ជំនុំជម្រះ និង កំណត់ ថ្ងៃ សវនាការ នា ពេល ឆាប់ ៗ ខាងមុខ » ។
លោក គី តិច បាន បញ្ជាក់ បន្ថែម ថា នៅ ពេល នេះ លោក សម រង្ស៉ី បាន ស្វះស្វែងរក មេធាវី ២រូប ការពារ ខ្លួន ក្នុង រឿងក្តី នេះ បើ តាម នីតិវិធី មេធាវី របស់ សម រង្សី មាន រយ : ពេល ៣ខែ សម្រាប់ ដាក់ សារណា ការពារ ដោយ គិត ចាប់ពី ថ្ងៃទី ៩ ខែមិថុនា ឆ្នាំ ២០២០ ពោលគឺ គិត ពី ថ្ងៃ ចៅក្រម ស៊ើបសួរ ធ្វើ ការចោទប្រកាន់ លើ សម រង្ស៊ី ។
សូម ជំរាប ថា កាលពី ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០២០ តុលាការ ព្រហ្មទណ្ឌ នៃ ទីក្រុង ប៉ារីស បាន សម្រេច ដាក់ទណ្ឌិត សម រង្ស៉ី មេដឹកនាំ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល បាន សំងំ លាក់ ខ្លួន នៅក្នុង ប្រទេស បារាំង ពី បទ « បរិហារ កេរ្តិ៍ ជាសាធារណៈ លើ បុគ្គល » តាម បណ្តឹង របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ប្រទេស កម្ពុជា ។
ការចោទប្រកាន់ នេះ ត្រូវបាន ធ្វើ ចំពោះ គ្រប់ ពាក្យ សម្ដី ចោទប្រកាន់ ទាំងអស់ ដែល បាន លើកឡើង នៅក្នុង ពាក្យបណ្ដឹង របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ប្រទេស កម្ពុជា ចុះ ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០១៩ ។
ចៅក្រម ស៊ើបសួរ បារាំង បាន កត់សម្គាល់ ថា មាន តម្រុយ និង ភស្តុតាង គ្រប់គ្រាន់ និង ស៊ីសង្វាក់ ដែល អាច បញ្ជាក់ ថា បុគ្គល សម រង្ស៉ី បាន ប្រព្រឹត្ត បទល្មើស ដូច ដែល បាន ចោទប្រកាន់ ខាងលើ ។ សូម បញ្ជាក់ ផងដែរ ថា បុគ្គល សម រង្ស៉ី ពុំ មាន មូលដ្ឋាន ផ្លូវ ច្បាប់ ដែល អាច ប្រកែក ដោះបន្ទុក ឬ ធ្វើ ការជំទាស់ ទៅនឹង ពាក្យសម្ដី របស់ ខ្លួន ដែល ត្រូវបាន ចោទប្រកាន់ នោះ ទេ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០១៩ សម្តេច តេជោ ហ៊ុន សែន តាមរយៈ មេធាវី រាជ រដ្ឋាភិបាល កម្ពុជា និង មេធាវី បារាំង បាន សម្រេច ដាក់ ពាក្យ បណ្តឹង ជា ផ្លូវការ ប្តឹង ទណ្ឌិត សម រង្ស៉ី ពី បទ « បរិហារ កេរ្តិ៍ ជាសាធារណៈ លើ បុគ្គល » ទៅកាន់ តុលាការ ទីក្រុង ប៉ារីស នៃ ប្រទេស បារាំង ។
នេះ ជា ការបញ្ជាក់ របស់ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា មន្ត្រី អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន បញ្ជាក់ ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន នា ឱកាស ដែល លោក បាន ដឹក ក្រុម អ្នកសារព័ត៌មាន ជិត ២០ ស្ថាប័ន ចុះ បំពេញ បេសកកម្ម នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ភ្នំ ក្រវាញ ខាងត្បូង ស្ថិត នៅក្នុង ស្រុក ថ្ម បាំង ខេត្ត កោះកុង រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ៩ ដល់ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ ។
លោក បាន បន្ត ថា រហូតមកដល់ ពេលនេះ មាន តែ ប្រទេស កម្ពុជា និង ប្រទេស ឥណ្ឌូនេស៊ី តែ ប៉ុណ្ណោះ នៅក្នុង ចំណោម ប្រទេស អាស៊ាន ដែល បាន លក់ ឥណទាន កាបូន ក្នុង ទីផ្សារ កាបូន ស្ម័គ្រចិត្ត នេះ ។ លោក បន្ថែម ថា មុននឹង ទិញ ឥណទាន កាបូន នេះ គឺ មាន ការវាយតម្លៃ ច្បាស់លាស់ ពី អ្នកជំនាញ លើ សមត្ថភាព នៃ ការផលិត កាបូន និង យន្តការ ផ្សេង ៗ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា អនុវត្ត ដើម្បី ធានា ការពារ និង គ្រប់គ្រង ប្រកបដោយ ប្រសិទ្ធភាព លើ តំបន់ ការពារ ធម្មជាតិ ដែល សំបូរ ដោយ ព្រៃឈើ សត្វ ព្រៃ និង ជីវៈ ចម្រុះ ផ្សេង ៗ ទៀត ។
ជាមួយគ្នា នេះ ដែរ លោក នេត្រ ភក្ត្រា បាន បន្ថែម ទៀត ថា ក្រុម មន្ត្រី ជំនាញ កំពុង សិក្សា បន្ថែម ដើម្បី លក់ កាបូន ក្នុង ដែន ជម្រក សត្វ ព្រៃ ព្រៃឡង់ ក្នុង ភូមិសាស្ត្រ ខេត្ត ស្ទឹងត្រែង ផងដែរ ។ ប្រទេស កម្ពុជា ត្រូវបាន គេ ទទួលស្គាល់ ថា មាន ធនធាន ធម្មជាតិ និង ជីវៈ ចម្រុះ ដ៏ សំបូរ បែប ។ ព្រៃឈើ គ្របដណ្តប់ ប្រមាណ ៥០ ភាគរយ នៃ ផ្ទៃ ប្រទេស ដែល ជា អត្រា ខ្ពស់ បំផុត នៅក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ ។
ការលើកឡើង បែប នេះ របស់ លោក បណ្ឌិត សុខ ទូច បាន ធ្វើឡើង ក្នុង ពិធី បើក វេទិកា វិទ្យាសាស្ត្រ ស្តីពី « ទំនាក់ទំនង កម្ពុជា - សហរដ្ឋ អាមេរិក៖ ការពិនិត្យមើល អតីតកាល រយៈពេល ៧០ ឆ្នាំ កន្លងមក ក្ដីរំពឹងទុក សម្រាប់ ៧០ ឆ្នាំ បន្ទាប់ និង លើស ពី នេះ » ដែល រៀបចំឡើង ដោយ រាជ បណ្ឌិត្យ សភា កម្ពុជា សហការ ជាមួយ ស្ថានទូត អាមេរិក នៅ អគារ រាជ បណ្ឌិត្យ សភា នា ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
លោក បាន លើកឡើង ដែរ ថា៖ ឆ្នាំ នេះ ទំនាក់ទំនង រវាង ប្រទេស យើង ទាំង ពីរ កម្ពុជា - សហរដ្ឋ អាមេរិក បាន ឈានដល់ របត់ ថ្មី មួយ ក្នុង ប្រវត្តិសាស្ត្រ ។ ចំណុច របត់ នេះ ត្រូវបាន ឆ្លុះបញ្ចាំង តាមរយៈ សារលិខិត របស់ លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ ផ្ញើ ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល សរបញ្ជាក់ ឱ្យ ឃើញ ថា ថ្នាក់ដឹកនាំ នៃ ប្រទេស ទាំង ពីរ មាន ឆន្ទៈ ក្នុង ការធ្វើឱ្យ កិច្ចសហប្រតិបត្តិការ ឱ្យ កាន់តែ មាន ភាពល្អ ប្រសើរឡើង ឈាន ទៅ រក ចំណុច រួម ។
លោក យល់ឃើញ ថា វេទិកា បែប នេះ គួរ ត្រូវបាន រៀបចំឡើង ឱ្យ បាន ញឹកញាប់ និង មាន ការចូលរួម ឱ្យ បាន ទូលំទូលាយ ជាង នេះ ដើម្បី រួមចំណែក លើកកម្ពស់ ការយោគយល់ គ្នា តាមរយៈ ការយល់ឃើញ ដ៏ ត្រឹមត្រូវ ពី គ្នា ទៅ វិញ ទៅ មក ពង្រឹង និង ពង្រីក ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ដ៏ យូរអង្វែង រវាង កម្ពុជា និង សហរដ្ឋ អាមេរិក នាំមក នូវ ទំនាក់ទំនង មិត្តភាព កាន់តែ ជិតស្និទ្ធ និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង ប្រជាជន និង ប្រទេស ទាំង ពីរ ។
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ១១ ខែកក្កដា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
ពលរដ្ឋ ខ្មែរ ១៣២ នាក់ នឹង ចេញពី ម៉ាឡេស៊ី ត្រឡប់ មកដល់ កម្ពុជា នៅ ព្រឹក នេះ
( ភ្នំពេញ ) ៖ ពលរដ្ឋ ខ្មែរ ១៣២ នាក់ ទៀត នឹង ធ្វើដំណើរ ត្រឡប់មក កម្ពុជា វិញ តាម ជើង យន្តហោះ ពិសេស MH754 ចេញ ពី ទីក្រុង គូឡាឡាំពួ មកដល់ កម្ពុជា នៅ វេលា ម៉ោង ១០៖០០ ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។ នេះ បើ តាម លោក កុយ គួង អ្នកនាំពាក្យ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ។
គួរ រំលឹក ថា គិត ចាប់ពី ផ្ទុះ ជំងឺ កូវីដ១៩ រហូតមកដល់ ពេលនេះ មាន ជើងហោះហើរ ពី ម៉ាឡេស៉ី មក កម្ពុជា ចំនួន ៤លើក ក្នុង នោះ រួម មាន៖
គួរ ជម្រាប ថា បើ ក្រឡេក ទៅ លើ ការបោះឆ្នោត សកល នៅ សិង្ហបុរី កាលពី ឆ្នាំ ២០១៥ វិញ គណបក្ស លោក លី ទទួលបាន អាសនៈ ចំនួន ៨៣ ក្នុង ចំណោម ៨៩ អាសនៈ ហើយ បើ គិត ពី សំឡេង ឆ្នោត របស់ ប្រជាជន គឺ គណបក្ស PAP ទទួលបាន ការគាំទ្រ សរុប ៦៩.៦ភាគរយ ។ ប្រទេស សិង្ហបុរី បាន បន្ត ស្ថិត ក្រោម ការដឹកនាំ របស់ គណបក្ស PAP តាំងពី តែ ពី ពេល ទទួលបាន ឯករាជ្យ នៅ ឆ្នាំ ១៩៦៥ រហូតមក ៕ ជនជាតិ អូស្រ្តាលី មួយ រូប ទៀត ហើយ ទទួលបាន យុត្តិធម៌ ពី សម្តេច តេជោ ហ៊ុន សែន
នៅ ចុង ឆ្នាំ ២០១៩ ដោយ រស់ នៅ មិន ចុះសម្រុង នឹង គ្នា អ្នក ទាំង ពីរ ក៏ ចាប់ផ្តើម ប្តឹង ផ្តល់ គ្នា រហូត ទៅដល់ បួន ករណី ទៅកាន់ សាលាដំបូង ខេត្ត កំពត តែ ពុំ ទាន់ បាន ទទួល ដំណោះស្រាយ ជា ស្ថាពរ នៅឡើយ ។ ដោយ មាន ក្តីបារម្ភ យ៉ាង ខ្លាំង ទៅ លើ ទ្រព្យសម្បត្តិ របស់ លោក ដែល កំពុង ស្ថិត នៅក្រោម ឈ្មោះ ត្រា ចាន់ ស្រី លីន លោក Peter ក៏ បាន ដាក់ពាក្យ សុំ អន្តាគមន៍ មកកាន់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី កម្ពុជា ដើម្បី សុំ ជួយ រក យុត្តិធម៌ ។
