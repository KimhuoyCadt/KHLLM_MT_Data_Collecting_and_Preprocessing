( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ធំ និង លោកស្រី ព្រមទាំង សហការី នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន នាំយក អំណោយ មនុស្សធម៌ ចុះ ចែកជូន ប្រជាពលរដ្ឋ មាន ជីវភាព ខ្វះខាត ចំនួន ៣៧១ គ្រួសារ នៅ ទីតាំង បួន ផ្សេង គ្នា មាន ក្រុង ស្ទឹង សែន ឃុំ បឹងល្វា ឃុំ ក្រយា និង ឃុំ ក កោះ ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
លោក សុខ លូ បាន នាំ នូវ ការសាកសួរ សុខទុក្ខ ក្តីនឹករលឹក ការស្រឡាញ់ យ៉ាង ជ្រាលជ្រៅ ពី សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ដល់ ប្រជាពលរដ្ឋ គ្រប់ រូប ដោយ មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុរ ជំនឿ សាសនា ឬ និន្នាការ នយោបាយ ណាមួយ ឡើយ ។
លោក បាន បន្ត ទៀត ថា ប្រមុខ រដ្ឋាភិបាល នៃ កម្ពុជា ដឹកនាំ ដោយ សម្តេច ហ៊ុន សែន បាន ដាក់ចេញ នូវ កម្មវិធី ផ្តល់ សាច់ប្រាក់ ជូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ក្រីក្រ និង ងាយ រងគ្រោះ ដោយសារ ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ - ១៩ ដើម្បី កាត់បន្ថយ ការលំបាក ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ពិតប្រាកដ ។
លោក សុខ លូ បាន សង្កត់ធ្ងន់ ថា សម្រាប់ ការងារ ផ្តល់ ប័ណ្ណ សមធម៌ នេះ សូម ភូមិ ឃុំ / សង្កាត់ ធ្វើ ឲ្យបាន សុក្រិត ត្រឹមត្រូវ យុត្តិធម៌ ច្បាស់លាស់ ក្នុង នោះ ក្រុង ស្រុក ត្រូវ យកចិត្តទុកដាក់ តាមដាន ត្រួតពិនិត្យ ឲ្យបាន ហ្មត់ចត់ ចុះ ជាប់ ជាមួយ ភូមិ ឃុំ / សង្កាត់ ចៀសវាង ដាច់ខាត ករណី ឃុបឃិត គ្នា ដាក់បញ្ចូល សាច់ញាតិ បងប្អូន កូនក្មួយ ខ្លួន ឯង ដែល មិន មែន ជា ជន ក្រីក្រ និង ងាយ រងគ្រោះ ពិតប្រាកដ ដើម្បី ទទួលបាន នូវ ប្រាក់ ឧបត្ថម្ភ នេះ ពិតប្រាកដ ។
លោក សុខ លូ បាន ក្រើន រំលឹក ប្រជាពលរដ្ឋ ទាំងអស់ បង្កើន នូវ ការយកចិត្តទុកដាក់ នៃ ការរីករាលដាល ជំងឺ COVID-១៩ នេះ ដោយ រក្សា អនាម័យ ត្រូវ ពាក់ ម៉ាស ការពារ ឬ ប្រើ កន្សែង ទប់ មាត់ នៅពេល ក្អក ឬ កណ្តាស់ ឧស្សាហ៍ លាង ដៃ នឹង សាប៊ូ ឲ្យ បាន ញឹកញាប់ ឬ ទឹក អាល់កុល ឬ ជែល ដាក់ ជាប់ តាម ខ្លួន ជាប្រចាំ នៅពេល ធ្វើដំណើរ នៅ គ្រប់ ទីកន្លែង ជាពិសេស មិន ត្រូវ មាន ការជួបជុំ ឬ ចាក់ ធុង បាស រាំ កម្សាន្ត នោះ ទេ ។
លោក សុខ លូ បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ជួយ អប់រំ កូន ចៅ ឲ្យ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ រាល់ ការបើកបរ ម៉ូតូ ត្រូវ ពាក់ មួយ សុវត្ថិភាព ទាំង អ្នកបើកបរ និង អ្នក រួម ដំណើរ និង ចៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន ។
អំណោយ ដែល បាន ចែកជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២៥ គីឡូ ទឹកស៊ីអ៊ីវ ១យួរ ទឹកត្រី ១យួរ ត្រីខ កំប៉ុង ១ឡូត៍ មី ១កេស ច្រាស ដុះ ខោអាវ១ សាប៊ូ ១ដុំ ៕
លោក គង់ គីម នី ចូលកាន់ តំណែង ជា អភិបាល រង ខេត្ត ក្រចេះ ជំនួស លោក ខ័ណ្ឌ ចំណាន
( ក្រចេះ ) ៖ លោក គង់ គីម នី បាន ចូលកាន់ តំណែង ជា អភិបាល រង ខេត្ត ក្រចេះ ជា ផ្លូវការ នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ដោយ ជំនួស លោក ខ័ណ្ឌ ចំណាន ដែល ត្រូវ ផ្ទេរ ភារកិច្ច ទៅ បម្រើ ការងារ នៅ ទីស្ដីការ ក្រសួង មហាផ្ទៃ ។
ពិធី ប្រកាស នេះ បាន ធ្វើឡើង រដ្ឋបាល ខេត្ត ក្រចេះ ក្រោម អធិបតីភាព លោក ប៊ុន ហុន រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ តំណាង សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ដោយ មាន ការចូលរួម ពី លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ ផងដែរ ។
នៅក្នុង ពិធី ចូលកាន់ តំណែង នោះ លោក អភិបាល ខេត្ត ក្រចេះ បាន លើកឡើង អំពី ស្ថានភាព ភូមិសាស្ត្រ ការគ្រប់គ្រង ថែរក្សា ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ ក្នុង ខេត្ត ឱ្យ មាន លក្ខណៈ ល្អ ប្រសើរ និង សមិទ្ធផល នានា ។
លោក ប៊ុន ហុន បាន កោតសរសើរ គណៈ បញ្ជាការ ឯកភាព ខេត្ត ក្រុង ស្រុក ដែល បាន ខិតខំ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ និង សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ និង ការគ្រប់គ្រង សភាពការណ៍ ក្នុង ខេត្ត ទាំងមូល បាន ល្អ ប្រសើរ បាន រួមចំណែក ក្នុង ការពង្រឹង សន្តិភាព ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម ។
លោក ក៏ បាន បាន ជំរុញ ដល់ គណៈ បញ្ជាការ ឯកភាព គ្រប់ ថ្នាក់ ត្រូវ ខិត បន្ត ទៀត ពង្រឹង ការងារ ភូមិ - ឃុំ មាន សុវត្ថិភាព ដើម្បី បង្ក្រាប រាល់ គ្រប់ មុខ សញ្ញា ដែល បង្ក អសន្តិសុខ ក្នុង មូលដ្ឋាន ។ លោក បាន ជំរុញ ឱ្យ លើកកម្ពស់ ការទទួលខុសត្រូវ របស់ កងកម្លាំង សមត្ថកិច្ច ជំរុញ ការផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ចៀសវាង ឱ្យ ឆ្ងាយ ពី គ្រឿងញៀន និង ត្រូវ ចូលរួម អនុវត្ត តាម វិធានការ ការពារ ទប់ស្កាត់ ការ រាត្បាត នៃ ជំងឺ កូវីដ - ១៩ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
លោក ប៊ុន ហុន បាន បញ្ជាក់ ថា ការផ្លាស់ប្តូរ តួនាទី ភារកិច្ច និង ផ្តល់ តំណែង ក្នុង ការដឹកនាំ នេះ គឺ ដោយសារ លោក ខ័ណ្ឌ ចំណាន បាន ដល់ អាណត្តិ បំពេញ ការងារ រយៈពេល ០៨ ឆ្នាំ ក្នុង តួនាទី ជា អភិបាល រង ខេត្ត ស្រប តាម ច្បាប់ កំណត់ ។ គោលការណ៍ នេះ គឺ ដើម្បី ធានា ឱ្យ មន្ត្រី ដឹកនាំ នៅ មូលដ្ឋាន ទាំងអស់ ខិតខំ បំពេញ ការងារ ប្រកបដោយ ប្រសិទ្ធភាព តម្លាភាព និង រៀនសូត្រ ដក បទពិសោធន៍ ក្នុង ជួរ មន្រ្តី ដឹកនាំ នៅ ថ្នាក់ ក្រោម ជាតិ ពី មូលដ្ឋាន មួយ ទៅ មូលដ្ឋាន មួយ ទៀត ។
ជាមួយគ្នា នោះ ដែរ លោក ប៊ុន ហុន ក៏ បាន ផ្តាំផ្ញើ ដល់ លោក គង់ គីម នី ដែល ទើប ទទួលបាន ការតែងតាំង មុខ តំណែង ថ្មី នេះ ត្រូវ ខិតខំ ប្រឹងប្រែង អនុវត្ត តួនាទី ភារកិច្ច របស់ ខ្លួន តាមរយៈ បទពិសោធន៍ ដែល មាន ពីមុន មក ដើម្បី បន្ត ចូលរួម ក្នុង ការងារ ដឹកនាំ គ្រប់គ្រង និង អភិវឌ្ឍន៍ នៅ រដ្ឋបាល ខេត្ត ក្រចេះ ឱ្យ កាន់តែ រីកចម្រើន និង ទទួលបាន សមិទ្ធផល ថ្មី ៗ បន្ថែម ទៀត ។
ជាមួយគ្នា នេះ លោក គង់ គីម នី ដែល ទើបតែងតាំង ថ្មី បាន ប្ដេជ្ញាចិត្ត ខិតខំ បំពេញ ភារកិច្ច បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ប្រកបដោយ គុណភាព តម្លាភាព និង ប្រសិទ្ធភាព រក្សា សាមគ្គីភាព ផ្ទៃក្នុង ឆ្លើយតប នឹង រាជ រដ្ឋាភិបាល ដែល បាន ផ្ដល់ ទំនុកចិត្ត តែងតាំង លោក ជា អភិបាល រង ខេត្ត ក្រចេះ នា ពេលនេះ ផងដែរ ៕ គណៈ សង្ឃ នាយក ស្នើ ចាត់ វិធានការ ច្បាប់ លើ ម្ចាស់ គណនី ហ្វេសប៊ុក «Troll យឹម តន » រឿង ធ្វើ សកម្មភាព ជាន់ ឈ្លី តម្លៃ ព្រះពុទ្ធ សាសនា និង ព្រះសង្ឃ
( ភ្នំពេញ )៖ គណៈ សង្ឃ នាយក នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ស្នើ ឱ្យ ក្រសួង ធម្មការ និង សាសនា ក៏ ដូចជា អាជ្ញាធរ ពាក់ព័ន្ធ ឱ្យ ចាត់ វិធានការ ទៅ តាម ផ្លូវ ច្បាប់ ចំពោះ ម្ចាស់ គណនី ហ្វេសប៊ុក «Troll យឹម តន » ក្រោម ហេតុផល ថា ម្ចាស់ គណនី ហ្វេសប៊ុក នេះ បាន ធ្វើ សកម្មភាព ជាន់ ឈ្លី តម្លៃ ព្រះពុទ្ធ សាសនា និង ព្រះសង្ឃ ខ្មែរ ។
ក្នុង សេចក្តីថ្លែងការណ៍ នៅ ថ្ងៃពុធ ទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ គណៈ សង្ឃ នាយក បាន គូសបញ្ជាក់ ថា គណនី ហ្វេសប៊ុក ឈ្មោះ «Troll យឹម តន បាន » បាន បង្ហោះ ឃ្លីប វីដេអូ ផ្សព្វផ្សាយ តាម បណ្ដាញ សង្គម ជា បទចម្រៀង លាយឡំ ដោយ ការកាត់ត រូបភាព បព្វជិត សង្ឃ ពុទ្ធសាសនា ក្នុង លក្ខណៈ អាសអាភាស ជាមួយ ស្ត្រី ភេទ ដោយ ប្រើ ពាក្យពេចន៍ ក្នុង ខ្លឹមសារ វាយប្រហារ ប្រកបដោយ ចេតនា បំផ្លិចបំផ្លាញ កិត្តិយស សេចក្ដីថ្លៃថ្នូរ ក៏ ដូចជា តម្លៃ ពុទ្ធសាសនា ដែល ជា សាសនា របស់ រដ្ឋ ។
គណៈ សង្ឃ នាយក បាន ចាត់ទុក សកម្មភាព នេះ ជា ការប្រមាថ ចំពោះ ព្រះសង្ឃ ថេរ វា ទ នៅ កម្ពុជា យ៉ាង ធ្ងន់ធ្ងរ បំផុត ក៏ ដូចជា ពុទ្ធ បរិស័ទ ផងដែរ មាន ភាព ទោមនស្ស កើតទុក្ខ មិន សុខចិត្ត យ៉ាង ក្រៃលែង ចំពោះ ទង្វើ ដ៏ អកុសល និង ថោក ទាប នេះ ។
គណៈ សង្ឃ នាយក បាន គូសបញ្ជាក់ ក្នុង សេចក្តីថ្លែងការណ៍ នេះ ថា រូបភាព បុគ្គល ដែល គណនី ហ្វេសប៊ុក ខាងលើ យកមក កាត់ តភ្ជាប់ ជាមួយ ស្ត្រី ភេទ គឺជា រូបភាព ដែល គណៈ សង្ឃ គ្រប់ ជាន់ ថ្នាក់ បាន ដោះស្រាយ ប្រកបដោយ ច្បាប់ វិន័យ រួចហើយ រូបភាព ខ្លះ ជា រូបភាព សង្ឃ បរទេស និង រូបភាព ខ្លះ ទៀត ជា រូបភាព បព្វជិត សង្ឃ ពុំ មាន កំហុស អ្វី ឡើយ ក៏ ត្រូវបាន យកមក ដាក់ ភ្ជាប់ ដើម្បី ត្មះ តិះដៀល បន្ទាប បន្ថោក ក្នុង បទចម្រៀង យ៉ាង គ្រោត គ្រាត និង អយុត្តិធម៌ ។
គណៈ សង្ឃ នាយក បាន កត់សម្គាល់ ថា គណនី ហ្វេសប៊ុក «Troll យឹម តន » បាន ប្រព្រឹត្ត អំពើ រឿង អកុសល ដដែល នេះ ជាច្រើន ឆ្នាំ កន្លងមក ហើយ ដោយ បាន យក អធិករណ៍ នៃ បព្វជិត សង្ឃ ធ្វើជា អាជីព មាន ចេតនា យ៉ាង ពេញ ទំហឹង ក្នុង ការបំផ្លិចបំផ្លាញ កិត្តិយស សេចក្ដីថ្លៃថ្នូរ របស់ ព្រះសង្ឃ ក៏ ដូចជា តម្លៃ ពុទ្ធសាសនា ថេរ វាទ កម្ពុជា ដែល គណៈ សង្ឃ នាយក កម្ពុជា ពុំ អាច ទទួលយក បាន ជាដាច់ខាត ។
គណៈ សង្ឃ នាយក បាន បដិសេធ យ៉ាង ដាច់អហង្ការ និង ថ្កោល ទោស ចំពោះ ទង្វើ ដ៏ ស្មោក គ្រោក អសីលធម៌ ទុច្ចរិត និង ភាពជា អមនុស្ស ហើយ ស្នើ ក្រសួង ធម្មការ និង សាសនា ព្រមទាំង អាជ្ញាធរ មាន សមត្ថកិច្ច ពាក់ព័ន្ធ ចាត់ វិធានការលើ អ្នកគ្រប់គ្រង គណនី ហ្វេសប៊ុក ខាងលើ តាម នីតិវិធី ច្បាប់ ជាធរមាន ។
ទន្ទឹមនឹង សំណើ របស់ គណៈ សង្ឃ នាយក នេះ នៅ ថ្ងៃ ដដែល នេះ ក្រសួង ធម្មការ និង សាសនា បាន ដាក់ សំណើ ទៅកាន់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង លោក ខៀវ កញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ដើម្បី ចាត់ វិធានការលើ ម្ចាស់ គណនី ហ្វេសប៊ុក នេះ ផងដែរ ។
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ថ្ងៃទី ១៥ ខែកក្កដា នេះ មាន យានយន្ត ១.៥៦៦ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ. រយៈពេល ៧៦ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១០៤.៩០៤ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៧៧.១៧៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២៧. ៧៣១ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ៧៦ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បទល្មើស ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ៩លើក ផងដែរ ក្នុង នោះ ស្លាប់ ៥នាក់ របួស ១០នាក់ ( របួស ធ្ងន់ ៦នាក់ )៕ ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ិន ស៊ី ស៊ី មេន សម្ពោធ ប្រឡាយ ថ្មី ប្រវែង៣ ពាន់ ម៉ែត្រ និង ដើមឈើ សងខាង ផ្លូវ នៅ ស្រុក បន្ទាយមាស ខេត្ត កំពត
ក្នុង ឱកាស នោះ ក្រុមហ៊ុន ជី ប ម៉ុង អ៊ិន ស៊ីស៊ី មេន បាន ឱ្យដឹង ថា ការ ដែល ក្រុមហ៊ុន ជួយ ស្ដារ ប្រឡាយ និង ដំា ដើមឈើ នេះ ចំណាយ អស់ ថវិកា សរុប ចំនួន ៤៥.០០០ ដុល្លារ ។ ក្នុង គោលបំណង ឲ្យ ប្រឡាយ ថ្មី នេះ មាន សមត្ថភាព ផ្ទុក ទឹក ច្រើន ជាង មុន សម្រាប់ ជា ប្រយោជន៍ ដល់ អ្នកភូមិ ។
ជាង នេះ ទៅ ទៀត ដើម្បី បន្ដ ការអភិវឌ្ឍ ភូមិ ឃុំ ឱ្យ កាន់តែ ស្រស់ស្អាត ក៏ ដូចជា ចូលរួម ការពារ និង លើកកម្ពស់ សោភណ្ឌភាព បរិស្ថាន រួមទាំង បំផុស នូវ ការស្រលាញ់ ធម្មជាតិ ដល់ ពលរដ្ឋ ផងដែរ ៕
កុំ ចង់ ប្រើ ថ្នាំ ញៀន សូម្បី កន្លះ ដឹង ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៥ ខែកក្កដា៖ បង្ក្រាប ១៧ករណី ឃាត់ខ្លួន ២៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៧ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២៦ នាក់ ។
ល្វែង ម៉ោង គឺ ប្រព្រឹត្តទៅ តាម បណ្ដោយ ខ្សែ ស្រប របស់ ផែនដី ហើយ ខ្សែ ស្រប របស់ ផែនដី មាន ចំនួន ១៨០ ខ្សែ ។ រៀងរាល់១ ម៉ោង គឺ ត្រូវ ឆ្លងកាត់ ចន្លោះ ខ្សែ ស្រប ចំនួន ១៥ខ្សែ មាន ន័យ ថា ក្នុង ចំណោម ខ្សែ ស្រប ទាំង ១៨០ ខ្សែ ត្រូវ ចែក ជាមួយ ១៥ ទើប ចេញ បាន ផល ចែក ចំនួន ២៤ ម៉ោង ។
តាមរយៈ សេចក្តីថ្លែងការណ៍ របស់ ខ្លួន ដែល បាន ធ្វើឡើង នៅ ថ្ងៃពុធ នេះ ក្រសួង ការបរទេស មីយ៉ាន់ម៉ា បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « យើង គ្រោង នឹង ធ្វើដំណើរ ទៅ នាំយក ប្រជាជន មីយ៉ាន់ម៉ា ចំនួន ១. ៨០០ នាក់ តាមរយៈ យន្តហោះ សង្គ្រោះ បន្ទាន់ ចំនួន ១៣ជើង ក្នុង រយៈពេល ០៣ សប្តាហ៍ ដោយ នឹង ចាប់ផ្តើម ពី ថ្ងៃអង្គារ សប្តាហ៍ ក្រោយ » ។
កិត្តិ សេដ្ឋា បណ្ឌិត បាន បន្ត ថា ដើម្បី ធានា បាន ក្នុង ការប្រើប្រាស់ មាន សុវត្ថិភាព ខ្ញុំ សូម ធ្វើ ការបែងចែក ថា ប្លេត ដែល ចែកជូន ទៅ ឃុំ សង្កាត់ ជា ពីរ ដាច់ដោយឡែក ពី គ្នា៖
( ភ្នំពេញ ) ៖ ឧកញ៉ា ម៉ុង ឫទ្ធី ប្រធាន គណៈកម្មការ ទី៣ព្រឹទ្ធសភា និង ត្រូវបាន គេ ស្គាល់ ថា ជា សេដ្ឋី ក្នុង វិស័យ កសិកម្ម ក សិ- ឧស្សាហកម្ម របស់ កម្ពុជា នៅ ថ្ងៃទី ១១ ខែកក្កដា កន្លងទៅ ថ្មី ៗ នេះ ទើប បាន រៀបចំ កម្មវិធី ខួបកំណើត គម្រប់ ៦៧ ឆ្នាំ របស់ លោក នៅ លំនៅដ្ឋាន លំហែ កាយ ម៉ុង ឫទ្ធី សែន ជ័យ ក្នុង ខេត្ត កំពង់ស្ពឺ ។
ក្នុង វីដេអូ មួយ ស្តីពី ការរៀបចំ ពិធី ខួបកំណើត គម្រប់ វ័យ ៦៧ ឆ្នាំ របស់ លោក ឧកញ៉ា ម៉ុង ឫទ្ធី ដែល រៀបចំ ដោយ ចុង ភៅ សេង ហុក ហេង សេដ្ឋី កសិកម្ម រូប នេះ បាន បញ្ជាក់ ថា ពី វត្ថុ បំណង ដែល លោក សម្រេចចិត្ត រៀបចំ ខួបកំណើត របស់ លោក នៅ លំនៅដ្ឋាន លំហែ កាយ ម៉ុង ឫទ្ធី សែន ជ័យ ។
ការវិនិយោគ ក្នុង វិស័យ កសិកម្ម ក សិ- ឧស្សាហកម្ម របស់ លោក ឧកញ៉ា ម៉ុង ឫទ្ធី ក្រៅតែ ពី ជួយ លើកស្ទួយ វិស័យ កសិកម្ម ក សិ- ឧស្សាហកម្ម ហើយ នោះ ក៏ បាន ផ្តល់ នូវ ការងារ ជាច្រើន សម្រាប់ ប្រជាជន កម្ពុជា ដោយ ពួកគាត់ មិន បាច់ ធ្វើ ចំណាក់ ស្រុក ទៅ ធ្វើការ នៅ ប្រទេស ជិតខាង ឡើយ ។
លោក ឧកញ៉ា បាន និយាយ ទៀត ថា « អាជីវកម្ម របស់ ខ្ញុំ ក៏ បាន រួមចំណែក ធ្វើឲ្យ ជីវភាព ពលរដ្ឋ ខ្មែរ មួយចំនួន កាន់តែ ប្រសើរ ជាង មុន តាមរយៈ បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ ដើម្បី ពួកគាត់ អាច រក ប្រាក់ ចំណូល ចិញ្ចឹម ជីវិត ដោយ មិន បាច់ ធ្វើ ចំណាក់ ស្រុក ក៏ ដូចជា ជួយ អភិវឌ្ឍន ភូមិ ឃុំ ពួកគាត់ នេះ ហើយ គឺជា ផលប្រយោជន៍ ដែល ខ្ញុំ ចង់បាន ពី ប្រជាជន ក្រីក្រ » ។
លោក ឧកញ៉ា ក៏ បាន លោក ឡើង ថា ការធ្វើ អាជីវកម្ម របស់ លោក ឧកញ៉ា បាន រួមចំណែក បម្រើ ផលប្រយោជន៍ ជាតិ និង ប្រជាជន តាម អនុសាសន៍ សម្ដេច តេជោ ហ៊ុន សែន ដែល សម្ដេច តែងតែ មានប្រសាសន៍ ថា « កាលណា យើង មាន ផ្លូវ យើង នឹង មាន ក្ដីសង្ឃឹម »៕
លោកស្រី អាន សុធីតា ថ្លែង ឲ្យដឹង ថា « ជា ការពិត ការផ្ទុះឡើង នៃ ជំងឺ កូវីដ១៩ ធ្វើឲ្យ វិស័យ ខុនដូទទួលរង ផល ប៉ះពាល់ ជាខ្លាំង ប៉ះពាល់ ចន្លោះ ពី ៣០ - ៥០ ភាគរយ ប៉ុន្ដែ ផល ប៉ះពាល់ នេះ មិន យូរ នោះ ឡើយ ខ្ញុំ គិត ថា ប្រហែលជា ត្រីមាស ទី១ ឬ ទី២ ទីផ្សារ ខុនដូរ នឹង ដំណើរការ ល្អ ប្រសើរ ឡើងវិញ » ។
លោកស្រី បញ្ជាក់ ថា « ជំងឺ កូវីដ១៩ បាន បង្ក ផល ប៉ះពាល់ មួយចំនួន ចំពោះ វិស័យ ខុនដូ តែ នៅ មាន កម្រិត ទាប នោះ ទេ បៀបធៀប នឹង វិស័យ ផ្សេង ៗ ទៀត ។ បញ្ហា ប្រឈម គឺ ការធ្លាក់ចុះ នៃ ចំនួន អ្នកទិញ ខុនដូចន្លោះ ពី ៣០ - ៥០ ភាគរយ ចំពោះ គម្រោង ដែល បញ្ចប់ រួចរាល់ និង គម្រោង ដែល កំពុង ដាក់ លក់ ខុសគ្នា ដោយសារតែ គម្រោង ដែល បញ្ចប់ នៅតែ មាន ការទទួល គាំទ្រ ពី អតិថិជន ក្នុង ស្រុក ប៉ុន្ដែ គម្រោង ដែល កំពុង ដាក់ លក់ កំពុង ប្រឈម នឹង ការពិបាក លក់ ធ្វើឲ្យ ការលក់ មាន ការថយចុះ » ។
លោកស្រី អាន សុធីតា បាន បន្ថែម ថា ចំពោះ អតិថិជន បរទេស វិញ មាន ការធ្លាក់ចុះ ខ្លាំង ជាធម្មតា ដូច អ្នក ទាំងអស់ គ្នា បាន ដឹង ហើយ គម្រោង ខុនដូចជា គម្រោង ពិសេស បំផុត សម្រាប់ ជន បរទេស ។
លោកស្រី បញ្ជាក់ ថា ថ្មី ៗ នេះ ការដាក់ ជួល ខុនដូ មាន ការធ្លាក់ចុះ ដោយសារតែ មិន មាន អតិថិជន បរទេស ដោយសារតែ ភាគ ច្រើន ពួកគាត់ ត្រឡប់ ទៅកាន់ ប្រទេស កំណើត ចំណែកឯ ជន បរទេស ផ្សេង ទៀត មិន អាច ត្រឡប់ ពី ប្រទេស ខ្លួន ចូល កម្ពុជា ដោយសារតែ ជំងឺ កូវីដ១៩ នេះ ។ ទាំង នេះ ធ្វើឲ្យ អត្រា ទំនេរ នៃ ខុនដូ កើនឡើង ខ្ពស់ បើ ធៀប នឹង ពីមុខ អត្រា ទំនេរ នេះ មាន ចន្លោះ តែ ១៥ - ២០ ភាគរយ ប៉ុណ្ណោះ ប៉ុន្ដែ ពេលនេះ ធ្លាក់ចុះ ចន្លោះ ពី ៣០ - ៥០ ភាគរយ ឯណ្ណោះ ។
ដោយឡែក សម្រាប់ វិស័យ សណ្ឋាគារ វិញ លោកស្រី បាន ឲ្យដឹង ថា បច្ចុប្បន្ន នេះ វិស័យ សណ្ឋាគារ បាន ធ្លាក់ចុះ ប្រមាណ ៩០ ភាគរយ ព្រោះ វិស័យ សណ្ឋាគារ ត្រូវបាន គាំទ្រ ដោយ អ្នក នៅក្នុង ស្រុក ដោយសារតែ ខណៈពេលនេះ យើង មិន មាន អ្នក ក្រៅ ស្រុក មក កម្ពុជា ឡើយ ។
លោកស្រី បន្ថែម ថា បើ និយាយ ពី តម្លៃ ខុនដូវិញ ពីមុន ជួល បាន ក្នុង តម្លៃ ១ការ៉េ ខ្ទង ១៤ - ១៥ ដុល្លារ ប៉ុន្ដែ ពេលនេះ ធ្លាក់ចុះ សល់ តែ ១១ - ១២ដុល្លារ ប៉ុណ្ណោះ ការធ្លាក់សល់ ចុះ នេះ ដោយសារតែ ម្ចាស់ ខុនដូ ទាំងនេះ ត្រូវ ទម្លាក់ តម្លៃ ខ្លះ ដើម្បី ទាក់ទាញ អតិថិជន មក ស្នាក់ នៅ ។ ទីផ្សារ ពេលនេះ ជា ទីផ្សារ ជា ទីផ្សារ ប្រកួតប្រជែង ខណៈ ពីមុន មាន ភ្ញៀវ ១០០ នាក់ ប៉ុន្ដែ ពេលនេះ មាន ភ្ញៀវ តែ ៥០ នាក់ ប៉ុណ្ណោះ ដូច្នេះ ពេល នេះ ជា ពេល ដែល ត្រូវ ប្រឹងប្រែង ទាំងអស់ គ្នា ៕
ប្រជាពលរដ្ឋ ស្រុក មុខ កំពូល ជាច្រើន គ្រួសារ រង ការរំលោភ យក ដីធ្លី និង បាន ចុះ ហាមឃាត់ គ្រឿងចក្រ ដែល កំពុង ហ៊ុព័ទ្ធ ដី
( កណ្តាល ) ៖ ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ អន្លង់ ស្លែង ឃុំ សំបួរ មាស ស្រុក មុខ កំពូល ខេត្ត កណ្តាល កំពុង រង ទុក្ខ ដោយសារ ឈ្មួញ ទន្ទ្រាន រំលោភ យក ដីធ្លី របស់ ពួកគាត់ ។ ករណី នេះ បាន កើតឡើង ជាច្រើន ឆ្នាំ មកហើយ ខណៈ អាជ្ញាធរ ឃុំ ស្រុក ហាក់ មិន មាន ឆន្ទៈ ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ ដោយ តម្លាភាព ។ នេះ បើ យោង តាម ការរៀបរាប់ របស់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិ ឃុំ ខាងលើ នេះ ។
ប្រជាពលរដ្ឋ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ថា ករណី ឈ្មួញ ប្រើ គ្រឿងចក្រ ឈូសឆាយ ជីក កាយ លើក ទំនប់ ទន្រ្ទាន រំលោភ យក ដីធ្លី ពួកគាត់ មិន មែន កើតឡើង ក្នុង ឆ្នាំ នេះ ទេ ហើយក៏ មិន មែន មាន តែ ចំពោះ ពួកគាត់ ប៉ុន្មាន គ្រួសារ នេះ ទេ គឺ នៅ មាន គ្រួសារ ជា ច្រើន ទៀត ដែល កំពុង រង ទុក្ខ ដូចគ្នា ដោយសារ ការរំលោភបំពាន យក ដីធ្លី របស់ ពួកគាត់ ពីសំណាក់ ឈ្មួញ ។
ការលើកឡើង នេះ ប្រជាពលរដ្ឋ បាន ធ្វើឡើង កាលពី ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ កន្លងទៅ ខណៈ ដែល ពួកគាត់ បាន លើក គ្នា ទៅ ហាមឃាត់ គ្រឿងចក្រ របស់ ឈ្មួញ កំពុង ធ្វើ សកម្មភាព ជីក កាយ លើក ទំនប់ ហ៊ុព័ទ្ធ រំលោភ យក ដីធ្លី របស់ ពួកគាត់ នៅ ចំណុច ( ទួល លោក យួន ) ក្បែរ បឹង កន្លែង ស្មៅ ក្នុង ភូមិ អន្លង់ ស្លែង ឃុំ សំបួរ មាស ស្រុក មុខ កំពូល ខេត្ត កណ្តាល ។
ប៉ុន្តែ រហូតមកដល់ ពេលនេះ គ្រឿងចក្រ របស់ ឈ្មួញ នៅតែ បន្ត ធ្វើ សកម្មភាព ជីក កាយ លើក ទំនប់ ដដែល បើ ទោះបី មាន ការហាមឃាត់ របស់ អាជ្ញាធរ កាលពី ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ យ៉ាងណា ក៏ដោយ ។
ប្រជាពលរដ្ឋ បាន បន្ត ទៀត ថា នៅ ពេល ដែល ពួកគាត់ មាន រឿង ទំនាស់ ដីធ្លី ដោយសារ ឈ្មួញ រំលោភ យក បែរជា ឲ្យ ពួកគាត់ យក ឯកសារ ពាក់ព័ន្ធ ដីធ្លី ទៅ បង្ហាញ អាជ្ញាធរ ដើម្បី ដោះស្រាយ ។ ប្រជាពលរដ្ឋ ថា ពួកគាត់ មាន ឯកសារ ដីធ្លី ឯណា បើ អាជ្ញាធរ មិន ធ្វើឲ្យ ផង បើ ទោះបី ពួកគាត់ ស្នើសុំ ធ្វើ លិខិត កាន់កាប់ ក៏ អាជ្ញាធរ ពន្យា ពេល រហូត ទៅដល់ ១០ឆ្នាំ ឯណោះ ។
ប្រជាពលរដ្ឋ ថា ការសន្យា រយៈពេល ១០ឆ្នាំ នេះ អាជ្ញាធរ និយាយ ឲ្យ រួច តែ ពី មាត់ ពីព្រោះ ដីធ្លី របស់ ពួកគាត់ បាន អាស្រ័យ ផល តាំងពី ឆ្នាំ ១៩៩៣ រហូតមកដល់ បច្ចុប្បន្ន គឺ មាន រយៈ ២៣ឆ្នាំ ហើយ តែ អាជ្ញាធរ នៅតែ មិន ព្រម ធ្វើ លិខិត កាន់កាប់ ដីធ្លី ជូន ពួកគាត់ ដដែល ។
លោក បាន បញ្ជាក់ ទៀត ថា លោក បាន ឃាត់ គ្រឿងចក្រ យក ចេញ អស់ ហើយ មិន អនុញ្ញាតឲ្យ គ្រឿងចក្រ ធ្វើ បន្ត ទៀត ទេ យើង ដោះស្រាយ រួចហើយ បើ ថា ម្ចាស់ ណា ត្រឹមត្រូវ ចាំ យើង ចាត់ចែង បន្ត ទៀត ។ បើ ទោះបី អភិបាល ស្រុក មុខ កំពូល និយាយ បែប នេះ ក្តី រហូតមកដល់ ពេលនេះ គ្រឿងចក្រ របស់ ឈ្មួញ នៅតែ បន្ត ធ្វើ សកម្មភាព ជីក កាយ លើក ទំនប់ ដដែល ៕ ចំណេះដឹង ទូទៅ៖ តើ នៅ ត្រង់ កន្លែងណា នៃ ផែនដី ដែល គេ កំណត់ ពេល ចាប់ផ្តើម ថ្ងៃ ថ្មី ?
ព្រះចៅ អធិការ វត្ត ក្ដី ដូង ផ្តល់ អំណោយ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ១២៩ គ្រួសារ មកពី ៥ឃុំ ក្នុង ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ
( កំពង់ធំ )៖ ព្រះភិក្ខុ ធម្មបាលោ ជ សុចាយ ព្រះគ្រូ ចៅអធិការ វត្ត ឌួង សុរិយា ហៅ ក្ដី ដូង និង ជា ព្រះធម្មធរ មន្ត្រី សង្ឃ ស្រុក កំពង់ស្វាយ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ចែក អំណោយ ដល់ ប្រជាពលរដ្ឋ ចំនួន ១២៩ គ្រួសារ ដែល មកពី ៥ឃុំ មាន ៨ភូមិ ក្នុង ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ។
នៅក្នុង ពិធី ចែក អំណោយ ដែល បាន ធ្វើឡើង នៅ វត្ត ឌួង សូរិយា ស្ថិត ក្នុង ភូមិ ក្តី ដូង ឃុំ ក្តី ដូង ស្រុក កំពង់ស្វាយ នេះ ព្រះភិក្ខុ ធម្មបាលោ ជ សុចាយ មាន សង្ឃ ដីការថ្លែង នូវ ការ កោតសរសើរ នឹង ដឹង គុណ ចំពោះ សម្ដេច ជា ស៊ីម សម្ដេច ហេង សំរិន និង សម្ដេច ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន រំដោះ ប្រទេសជាតិ ឱ្យ រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ រហូតមកដល់ ពេល បច្ចុប្បន្ន នេះ ធ្វើឲ្យ ប្រទេសជាតិ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ទាំង ផ្នែក ពុទ្ធ ចក្រ និង អាណាចក្រ ។
ព្រះភិក្ខុ ធម្មបាលោ ជ សុចាយ បាន បន្ត ថា ដោយ មើលឃើញ ពី ការខ្វះខាត និង ដើម្បី រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការលើកស្ទួយ ជីវភាព ប្រជាពលរដ្ឋ ដែល ងាយ រងគ្រោះ និង រងគ្រោះ ដោយ ហេតុ ផ្សេង ៗ ក៏ ដូចជា បងប្អូន ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយសារ ជម្ងឺ កូវីដ១៩ ដែល កំពុង រីករាលដាល នៅលើ ពិភពលោក ក៏ ដូចជា ប្រទេស កម្ពុជា ទើប ព្រះអង្គ បាន រៀបចំ ជា អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ដែល ខ្វះខាត នេះ ។
ព្រះអង្គ មាន សង្ឃ ដីកា បន្ត ទៀត ថា អំណោយ ដែល បាន ចែកជូន ដល់ ញោម ញាតិ នា ពេលនេះ ជា អំណោយ ដែល បាន មកពី សប្បុរសជន នៅ ក្រៅ ស្រុក ផង ក្នុង ស្រុក ផង និង មួយចំនួន ទៀត បាន មកពី ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ក្តី ដូង ផង ថ្វីបើ អំណោយ នេះ មាន ចំនួន តិចតួច ស្តួចស្តើង ក៏ ពិត មែន តែ វា អាច ជួយ សម្រាល ដល់ ភាពខ្វះខាត របស់ ញោម ញាតិ ជា ពុទ្ធ បរិស័ទ ហើយក៏ ដើម្បី រួមចំណែក ជួយ រំលែក ទុក្ខលំបាក របស់ រាជ រដ្ឋាភិបាល ផងដែរ ។
សូម បញ្ជាក់ ថា អំណោយ ដែល បាន ផ្តល់ ជូន ក្នុង មួយ គ្រួសារ នា ពេលនេះ មាន អង្ករ មី ទឹកត្រី ទឹកស៊ីអ៊ីវ និង ថវិកា ១ម៉ឺន រៀល ៕
លោក ជា ចាន់តូ និង ភរិយា ប្រគេន កុំ ព្យួទ័រ ដល់ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហុន រាជ សាខា ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ លោក ជា ចាន់តូ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា និង លោកស្រី ខៀវ ស៊ីណា បាន ប្រគេន កុំព្យូទ័រ លើ តុ និង យូរ ដៃ ព្រមទាំង ព្រីនធ័រ ដល់ ពុទ្ធិក សាកលវិទ្យាល័យ សីហនុ រាជ សាខា ខេត្ត បាត់ដំបង ដើម្បី បម្រើ ដល់ ការសិក្សា រៀនសូត្រ និង ស្រាវជ្រាវ របស់ សមណ និស្សិត និង សិស្ស និស្សិត ក្រីក្រ កំពុង សិក្សា ពុទ្ធិក ក្នុង សាកលវិទ្យាល័យ ។
សម្ភារ កុំព្យូរ ទ័រ និង សម្ភារ បច្ចេកវិទ្យា ទាំងនេះ ត្រូវបាន ប្រគេន ដល់ មន្ត្រី សង្ឃ ជា ថ្នាក់ដឹកនាំ ពុទ្ធិ សាកលវិទ្យាល័សីហនុ រាជ សាខា ខេត្ត បាត់ដំបង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
លោក ជា ចាន់តូ បាន ឲ្យដឹង ថា ការប្រគេន កុំព្យូទ័រ នា ពេលនេះ ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវ ការចាំបាច់ របស់ ពុទ្ធិកៈ ដែល មាន ការខ្វះខាត សម្ភារ ផ្នែក បច្ចេកវិទ្យា នេះ សម្រាប់ បង្ហាត់ បង្រៀន និង ការសិក្សា សិស្ស និង សាមណ និស្សិត ក្នុង ការស្រាវជ្រាវ ។
លោក បាន បន្ត ថា ការប្រគន់ កុំព្យូទ័រ នេះ ដែរ ក៏ ដើម្បី ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល លើ វិស័យ អប់រំ ខណៈ ប្រទេស កម្ពុជា កំពុង ត្រូវការ ជា ចាំបាច់ នូវ ធនធាន មនុស្ស ឲ្យ មាន សមត្ថភាព ផ្នែក បច្ចេកវិទ្យា និង ជំនាញ ផ្សេង ៗ ក្នុង ការចូលរួម អភិវឌ្ឍន៍ ប្រទេស ឲ្យ មាន ការរីកចម្រើន របស់ ប្រទេសជាតិ និង ពិភពលោក ។
លោក ទេសាភិបាល ក៏ បាន ស្នើ ដល់ ព្រះសង្ឃ និង គ្រហស្ថ ជា ថ្នាក់ដឹកនាំ នៅក្នុង ពុទ្ធិក សាកលវិទ្យាល័យ សីហនុ រាជ សាខា ខេត្ត បាត់ដំបង សូម បន្ត ការខិតខំ ប្រឹងប្រែង ក្នុង ការងារ អប់រំ នេះ ឲ្យ កាន់តែ ល្អ ប្រសើរ និង ជំរុញ ឲ្យ ការសិក្សា រៀនសូត្រ របស់ សមណ និស្សិត និង សិស្ស និស្សិត ទទួលបាន ជោគជ័យ ។
ព្រះអង្គ វី សុវិជ្ជា ព្រះប្រធាន សាខា ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហនុ រាជ ខេត្ត បាត ដំបង បាន មាន សង្ឃ ដីការ ថា សម្ភារ បច្ចេកវិទ្យា ដែល លោក ជា ចាន់តូ និង ភរិយា ផ្ដល់ ពេលនេះ ពិតជា មាន តម្លៃ ណាស់ សម្រាប់ ជួយ ឧបតម្ថ គាំទ្រ ការសិក្សា របស់ សមណ និស្សិត សិស្ស និស្សិត ក្រីក្រ កំពុង សិក្សា នៅក្នុង ទីនេះ ហើយ កាន់តែ ធ្វើឲ្យ ព្រះសង្ឃ និង សិស្ស និស្សិត មាន ទឹកចិត្ត ខិតខំ រៀនសូត្រ ខ្លាំង ថែម ឡើង ព្រោះ មាន ការយកចិត្តទុកដាក់ ពី ពុទ្ធ បរិស័ទ គ្រប់ ទិសទី ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ នៅ ថ្ងៃពុធ នេះ កង នាវា ឥណ្ឌូណេស៊ី បាន ឱ្យដឹង ទៀត ថា នាវា ខាងលើ លិច ដោយសារ ការធ្លុះធ្លាយ ជាច្រើន កន្លែង មុននឹង វា លិច ចូល សមុទ្រ ជម្រៅ ៩០ម៉ែត្រ ។ កង នាវា ឥណ្ឌូណេស៊ី បាន បញ្ជាក់ បន្ថែម ដូច្នេះ ថា « រលក សមុទ្រ នៅ តំបន់ ដែល នាវា ខាងលើ នេះ លិច មាន កម្ពស់ ចន្លោះ ពី ២.៥ម៉ែត្រ ដល់ ៤ម៉ែត្រ ឯណោះ » ។
ប៉ុន្តែ ជា សំណាង ល្អ មិន មាន មនុស្ស បាត់បង់ជីវិត នោះ ទេ ដោយ នាវិក នៅលើ នោះ ទាំងអស់ ៥៥នាក់ ត្រូវបាន ជួយ សង្រ្គោះ ទាន់ ពេលវេលា ដោយ នាវា ស៊ីវិល ពីរ គ្រឿង ៕ អគារ ថ្មី មន្ទីរពេទ្យ ខេត្ត ឧត្តរមានជ័យ តម្លៃ ជិត ២លាន ដុល្លារ ត្រូវ រៀបចំ ពិធី បញ្ចុះ បឋមសិលា សាងសង់
( ឧត្តរមានជ័យ ) ៖ អគារ ថ្មី នៃ មន្ទីរពេទ្យ ខេត្ត ឧត្តរមានជ័យ ដែល ចំណាយ ថវិកា សាងសង់ អស់ ចំនួន ១. ៧៤៩. ២៩៦ ដុល្លារ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ត្រូវបាន រៀបចំ ពិធី បញ្ចុះ បឋមសិលា សាងសង់ ដែល ចំណាយ ពេល សាងសង់ រយៈពេល ១៦ ខែ ។
ពិធី បញ្ចុះ បឋមសិលា សាងសង់ នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ស៉ី ប្រា សិទ្ធ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ និង មាន ការចូលរួម ពីសំណាក់ លោក ឃ្លោក ហួត ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ នៅ តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ជាច្រើន រូប ទៀត ។
ក្នុង ឱកាស នោះ លោក ប៉ែន កុសល្យ បាន លើកឡើង ថា ការសាងសង់ អគារ មន្ទីរពេទ្យ ខេត្ត នេះ គឺជា សមិទ្ធផល ថ្មី មួយ បន្ថែម ទៀត ដែល រាជ រដ្ឋាភិបាល ក្រសួង សុខាភិបាល និង ដៃ គួរ អភិវឌ្ឍន៍ ខិតខំ រួមគ្នា ដើម្បី ពង្រីក សេវា សុខាភិបាល សាធារណៈ ឱ្យ ខិត ជិត ប្រជាជន ងាយស្រួល ក្នុង ការទទួល សេវា ព្យាបាល ។
លោក អភិបាល ខេត្ត ក៏ បាន ផ្ដាំផ្ញើរ ឱ្យ បុគ្គលិក ពេទ្យ ទាំងអស់ ត្រូវ គោរព នូវ ក្រមសីលធម៌ វិជ្ជាជីវៈ របស់ ខ្លួន ដោយ ប្រកាន់ខ្ជាប់ នូវ សេចក្ដីថ្លៃថ្នូរ ស្មោះត្រង់ សុច្ចរិត យុត្តិធម៌ ក្នុង នាម ជា អ្នកបម្រើ ឱ្យ ជន ដែល រងគ្រោះ ដោយសារ ជំងឺ ឬ ហានិភ័យ សុខភាព ផ្សេង ៗ ទៀត ជាពិសេស ត្រូវ ព្យាបាល អ្នកជំងឺ ប្រកប ទៅ ដោយ យកចិត្តទុកដាក់ មិន ត្រូវ មាន ការធ្វេសប្រហែស ឡើយ ។
ដោយឡែក លោក ឃ្លោក ហួត ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ឧត្តរមានជ័យ បាន ថ្លែង ដឹង ថា ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ នានា មន្ទីរ សុខាភិបាល ខេត្ត បាន ពង្រឹង ពង្រីក មូលដ្ឋាន ផ្តល់ សេវា របស់ ខ្លួន ដែល ក្នុង នោះ មាន ទី ចាត់ការ អង្គភាព សុខាភិបាល មួយ កន្លែង ដែល មាន ការិយាល័យ ជា សេនាធិការ ចំនួន ៤ គ្របដណ្តប់ មន្ទីរពេទ្យ បង្អែក ខេត្ត មួយ ស្រុក ប្រតិបត្តិ ចំនួន ២ មន្ទីរពេទ្យ បង្អែក ស្រុក មួយ ម ណ្ឌុល សុខភាព ៣៧កន្លែង និង កំពុង សាងសង់ អគារ មណ្ឌល សុខភាព មួយ កន្លែង ទៀត នៅ ស្រុក ត្រពាំងប្រាសាទ ។
( ភ្នំពេញ ) ៖ អគ្គិភ័យ ឆេះ ផ្ទះ លក់ គ្រឿងសង្ហារឹម ធំ មួយ កន្លែង យីហោ « រ៉ូយ៉ាល់ កាសា គ្រឿង សង្ហារឹម » មាន ទីតាំង នៅ តាម បណ្ដោយ មហាវិថី ព្រះមុន្នី វង្ស ស្ថិត ក្នុង ក្រុម ទី២ ភូមិ១ សង្កាត់ បឹងកេងកង១ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ សមត្ថកិច្ច បាន គ្រប់គ្រង ទាំងស្រុង ហើយ នៅ វេលា ម៉ោង ជិត ១ ថ្ងៃត្រង់ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ត នាយ ការិយាល័យ បង្ការ និង ពន្លត់ អគ្គិភ័យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ប្រាប់ ភ្នាក់ងារ Fresh News ឲ្យដឹង ថា ក្នុង ប្រតិបត្តិការ សង្គ្រោះ ករណី អគ្គិភ័យ នេះ កម្លាំង សមត្ថកិច្ច ជំនាញ ប្រើប្រាស់ ទឹក អស់ ប្រមាណ ជាង ១២០ ឡាន ទើប អាច គ្រប់គ្រង ពន្លត់ បាន ទាំងស្រុង មិន ឲ្យ រីករាលដាល ឡើយ ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ត បាន បញ្ជាក់ ថា រថយន្ដ ដែល ប្រើប្រាស់ ដើម្បី សង្គ្រោះ នេះ រួម មាន៖
បើ តាម នាយ ការិយាល័យ ពន្លត់ អគ្គិភ័យ រូប នេះ ក្នុង ហេតុការណ៍ អគ្គិភ័យ នេះ ក៏ បាន បណ្ដាលឲ្យ ជនជាតិ ចិន ២នាក់ រងគ្រោះថ្នាក់ ផងដែរ ប៉ុន្ដែ មិន ធ្ងន់ធ្ងរ នោះ ទេ ខណៈ ទំហំ នៃ ការខូចខាត និង មូលហេតុ លោក មិន ទាន់ អាច បញ្ជាក់ ឲ្យដឹង នៅឡើយ ទេ ពោល កំពុង ស្រាវជ្រាវ បន្ដ ទៀត ៕ ក្រសួង សុខាភិបាល ទទួលបាន ម៉ាស៊ីន ទំនើប១ គ្រឿង និង ឧបករណ៍ ជាង ៦ ពាន់ ឈុត សម្រាប់ តេស្ត រក មេរោគ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ទទួលបាន ម៉ាស៊ីន ទំនើប និង ឧបករណ៍ ធ្វើតេស្ត រក មេរោគ កូវីដ - ១៩ ពី ណាហ្គាវើលដ៍ បេះដូង សប្បុរស ដែល ជា ផ្នែក ទំនួល ខុសត្រូវការងារ សង្គម របស់ ក្រុមហ៊ុន ណាហ្គាវើល ។ បរិក្ខារ ទាំងនោះ រួម មាន៖ ម៉ាស៊ីន ធ្វើតេស្ត រក មេរោគ កូវីដ - ១៩ ចំនួន១ គ្រឿង និង ឧបករណ៍ ធ្វើតេស្ត រក មេរោគ កូវីដ - ១៩ ចំនួន ៦. ៤០០ ឈុត ។
លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ឲ្យដឹង ថា « ក្នុង កំលុង ពេល នៃ ការឧបត្ថម្ភ លើក ទី១ ដែល មាន ឧបករណ៍ បង្ការ មេរោគ កូវីដ - ១៩ និង កុំព្យូទ័រ យួរ ដៃ របស់ ណាហ្គាវើលដ៍ បេះដូង សប្បុរស យើង មាន សេចក្តី សោមនស្ស រីករាយ យ៉ាង ខ្លាំង ដោយ បាន លឺ ថា ណាហ្គាវើលដ៍ សន្យា ផ្តល់ ម៉ាស៊ីន ធ្វើតេស្ត រក មេរោគ កូវីដ - ១៩ ថ្មី ១ គ្រឿង និង ឧបករណ៍ ធ្វើតេស្ត រក មេរោគ រាប់ ពាន់ ឈុត មកដល់ ក្រសួង » ។
លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្តិ បាន បន្ថែម ទៀត ថា ការធ្វើតេស្ត រក មេរោគ កូវីដ - ១៩ នៅតែ ជា ការងារ ដ៏ មាន សារសំខាន់ បំផុត របស់ យើង ក្នុង ការទប់ស្កាត់ រោគ រាតត្បាត ហើយ ម៉ាស៊ីន ទំនើប ថ្មី និង ឧបករណ៍ ធ្វើតេស្ត ទាំង នេះ នឹង ជួយ ដល់ ការងារ ប្រចាំ ថ្ងៃ របស់ យើង បន្ថែម ទៀត ។ តាង នាម ឲ្យ ប្រជាជន កម្ពុជា ខ្ញុំ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ ទឹកចិត្ត សប្បុរស នេះ ។
អាជ្ញាធរ សុខាភិបាល បាន និយាយ ថា ក្នុង រយៈពេល ២៤ ម៉ោង យើង បាន រកឃើញ ករណី ឆ្លង ថ្មី ៗ ចំនួន ២៩. ៤២៩ នាក់ ដែល ជា អត្រា ឆ្លង ថ្មី ៗ ខ្ពស់ បំផុត មិន ធ្លាប់ មាន និង មនុស្ស ៥៨២ នាក់ បន្ថែម បាន ស្លាប់ ។ ដោយឡែក មនុស្ស ជាង ៥៩២.០០០ នាក់ បាន ជាសះស្បើយ ឡើងវិញ ដែល ក្នុង ន័យ នេះ តួលេខ នៃ អ្នកជំងឺ សកម្ម ឬ អ្នកជំងឺ ដែល កំពុងតែ សម្រាក ព្យាបាល នៅ តាម មន្ទីរពេទ្យ នា ពេល បច្ចុប្បន្ន មាន ចំនួន ជិត ៣២០.០០០ នាក់ ។
( ភ្នំពេញ ) ៖ មេខ្ទីង មួយ ក្បាល បាន បង្កើត កូន ខ្ទីង ឈ្មោល ចំនួន ១ ក្បាល បាន ដោយ ជោគជ័យ នៅ ឧទ្យាន សួន សត្វ និង មជ្ឈមណ្ឌល សង្គ្រោះ សត្វ ព្រៃ ភ្នំ តាម៉ៅ នា ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២០ ។ នេះ បើ តាម រដ្ឋបាល ព្រៃឈើ ចុះផ្សាយ នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
មេខ្ទីង ខាងលើ នេះ ត្រូវបាន សង្គ្រោះ មកពី ខេត្ត មណ្ឌលគិរី ក្នុង ឆ្នាំ ២០០៦ ដោយ កាល នោះ វា ទើបតែ មាន អាយុ ប្រហែល ៣ខែ ប៉ុណ្ណោះ ។ ក្រោយពី ទទួលបាន ការចិញ្ចឹម ថែរក្សា យ៉ាង យកចិត្តទុកដាក់ ក្នុង ឧទ្យាន សួន សត្វ និង មជ្ឈមណ្ឌល សង្គ្រោះ សត្វ ព្រៃ ភ្នំ តាម៉ៅ វា កាន់តែ រីក ធំធាត់ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ និង មាន សុខភាពល្អ ។
ទាំងនេះ ជា សញ្ញា ជោគជ័យ មួយ ទៀត របស់ ឧទ្យាន សួន សត្វ និង មជ្ឈមណ្ឌល សង្គ្រោះ សត្វ ព្រៃ ភ្នំ តាម៉ៅ ក្នុង កម្មវិធី បង្កាត់ ពូជ សត្វ ព្រៃ និង ចូលរួមចំណែក ក្នុង ការអភិរក្ស សត្វ ខ្ទីង នៅ កម្ពុជា ។
កូន ខ្ទីង ឈ្មោល ដែល ទើបនឹង កើត នេះ កំពុង ស្ថិត ក្រោម ការតាមដាន យ៉ាង យកចិត្តទុកដាក់ ពី បសុពេទ្យ និង អ្នក ថែរក្សា សត្វ ព្រៃ ក្នុង ឧទ្យាន សួន សត្វ និង មជ្ឈមណ្ឌល សង្គ្រោះ សត្វ ព្រៃ ភ្នំ តាម៉ៅ ។
បច្ចុប្បន្ន សត្វ ខ្ទីង ស្ថិត ក្នុង ក្រុម ប្រភេទ សត្វ មាន ដោយ កម្រ និង មាន ដង់ស៊ីតេ រស់ នៅ កម្រិត ទាប ។ គេ កម្រ ឃើញ វា រស់ នៅ តាម វាល ទំនាប ណាស់ ព្រោះ សត្វ នេះ មិន ចូលចិត្ត កម្តៅ ថ្ងៃ យូរ ពេក ទេ ។
សត្វ ខ្ទីង កំពុង ប្រឈមមុខ នឹង ការរងគ្រោះថ្នាក់ ដោយសារ ការ បាត់បង់ ទីជម្រក ការបរបាញ់ ដើម្បី យក សាច់ ស្នែង ឆ្អឹង និង ការជួញដូរ ។ សត្វ ខ្ទីង ត្រូវបាន ចុះ ក្នុង បញ្ជី ក្រហម IUCN (VU) ថា ជា ប្រភេទ ងាយ រងគ្រោះថ្នាក់ ជា សាកល ក្នុង ឧបសម្ព័ន្ធទី១ នៃ អនុសញ្ញា សាយ តេស ៕
ក្រសួង កសិកម្ម និង ក្រុមហ៊ុន ជប៉ុន រួមគ្នា លើកកម្ពស់ វិស័យ ផលិតកម្ម បន្លែ កម្ពុជា ជាមួយ បច្ចេកវិទ្យា ទំនើប
គោលបំណង សំខាន់ ៗ នៃ ឯកសារ អនុស្សរណ នេះ រួម មាន៖
លោក រដ្ឋមន្ត្រី វេង សា ខុន បាន ជម្រាប ជូន ឯក អគ្គ រាជ ទូត ជ្រាប ថា ព្រឹត្តិការណ៍ នៃ ការចុះហត្ថលេខា នេះ បាន ឆ្លុះបញ្ចាំង ឲ្យ ឃើញ យ៉ាង ច្បាស់ ពី ឆន្ទ : របស់ រាជ រដ្ឋាភិបាល ជប៉ុន ក្នុង ការគាំទ្រ និង ជួយ ឧបត្ថម្ភ ទាំង ធនធាន ថវិកា និង បច្ចេកទេស ដើម្បី ចូលរួម អភិវឌ្ឍ ផលិតកម្ម បន្លែ កម្ពុជា ឲ្យ មាន ការរីកចម្រើន សមស្រប តាម សេចក្តីត្រូវការ ទីផ្សារ បន្លែ ការចាប់ យក កាលានុវត្តភាព ជាពិសេស តាម អនុសាសន៍ ណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
លោក រដ្ឋមន្ត្រី បន្ត ថា ជាក់ស្តែង គោលបំណង សំខាន់ ៗ ទាំង៤ ខាងលើ បាន បង្ហាញ ឲ្យ ឃើញ នូវ ការចូលរួម យ៉ាង សកម្ម ក្នុង ការអនុវត្ត កម្មវិធី កំណែទម្រង់ វិស័យ ផលិតកម្ម បន្លែ កម្ពុជា ក្នុង ទិសដៅ ធ្វើ ទំនើប ភាវូបនីយកម្ម បន្លែ គ្រប់ ខ្សែ ច្រវាក់ ផលិតកម្ម ប្រែក្លាយ ផលិតកម្ម បែប លក្ខណ : គ្រួសារ ទៅជា ផលិតកម្ម បែប ក សិ- ឧស្សាហកម្ម ដើម្បី ធានា បរិមាណ ផ្គត់ផ្គង់ គុណភាព និង សុវត្ថិភាព តាម តម្រូវការ ក្នុង ស្រុក និង នាំចេញ ។
លោក បន្ដ ថា ក្នុង បរិបទ កំណើន សេដ្ឋកិច្ច និង ជាពិសេស ក្នុង កាលៈទេសៈ ដែល ពិភពលោក កំពុង ជួប នូវ វិបត្តិ ជំងឺ ឆ្លង កូវីដ - ១៩ បាន ផ្តល់ ឱកាស មាស ដល់ ប្រជា កសិករ ធ្វើ ការកែប្រែ ទម្លាប់ ពី ការផលិត សម្រាប់ បម្រើ សេចក្ដីត្រូវការ ក្នុង គ្រួសារ មក ផលិត សម្រាប់ ធ្វើ ពាណិជ្ជកម្ម និង បំពេញ តម្រូវការ នៃ ទីផ្សារ ពោល គឺ ពី កសិករ ទៅជា កសិ- ពាណិជ្ជករ វិញ ។
លោក បញ្ជាក់ ថា ឯកសារ MoU ដែល បាន ចុះហត្ថលេខា នា ថ្ងៃ នេះ មាន លក្ខណ : គ្រប់គ្រាន់ ក្នុង ការបំពេញ តម្រូវការ ឲ្យ គ្នា ទៅ វិញ ទៅ មក យ៉ាង ប្រទាក់ ក្រឡា ក្នុង ខ្សែ ច្រវាក់ ផលិតកម្ម បន្លែ ដោយ ចាប់ផ្តើម ពី ការដាំ ការថែរក្សា ( ទឹក ជី ថ្នាំ ជំងឺ និង សត្វ ល្អិត ) ការប្រមូល ផល ការវេច ខ្ចប់ ការរក្សាទុក ក្នុង ទូត្រជាក់ និង ការដឹកជញ្ជូន ទៅកាន់ ទីផ្សារ ការផ្គត់ផ្គង់ ធាតុ ចូល ការស្រាវជ្រាវ និង ការផ្សព្វផ្សាយ បច្ចេកទេស ។ល ។
លោក រដ្ឋមន្ត្រី បាន ស្នើសុំ ឲ្យ ភាគី ពាក់ព័ន្ធ ទាំងអស់ មេត្តា ចូលរួម ផ្តល់ កិច្ចសហការ ដើម្បីឲ្យ គម្រោង នេះ សម្រេច ទទួលបាន ជោគជ័យ តាម ការគ្រោងទុក ។
ខេត្ត ទាំងនោះ រួម មាន ខេត្ត ព្រះវិហារ ខេត្ត ស្ទឹងត្រែង ខេត្ត រតនគិរី ខេត្ត មណ្ឌលគិរី ខេត្ត ក្រចេះ ខេត្ត ត្បួង ឃ្មុំ ខេត្ត កំពង់ចាម ខេត្ត ព្រៃវែង និង ខេត្ត ស្វាយរៀង ។ ខេត្ត ដំបូង នៃ យុទ្ធនាការចុះ តាម បណ្តាល ខេត្ត ជា លើក ទី២ របស់ លោក ប្រធាន គ.ជ. ប នៅ ពេល នេះ គឺ ផ្តើម ចេញ ពី ខេត្ត ព្រះវិហារ ។
សូម ជម្រាប ថា ខេត្ត ព្រះវិហារ មាន ប្រជាពលរដ្ឋ សរុប ចំនួន ២៤៨.៣៤០ នាក់ ក្នុង នោះ ប្រជាពលរដ្ឋ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ឆ្នាំ ២០១៩ ចំនួន ១២៨. ៣១៧ នាក់ ។ សម្រាប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២០ ដែល នឹង ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ១ដល់ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០២០ លេខ ធិការដ្ឋាន រៀបចំ ការបោះឆ្នោត ខេត្ត ព្រះវិហារ គ្រោង ចុះឈ្មោះ បោះឆ្នោត ថ្មី ចំនួន ៦៨៤១ នាក់ ។
ការចុះ មក ដោយ ផ្ទាល់ នេះ គឺ លោក ស៊ិក ប៊ុន ហុក ត្រូវការស្តាប់ ការលំបាក ដែល ថ្នាក់ ក្រោម បាន ជួបប្រទះ នា ពេល កន្លងមក និង ស្តាប់ សំណូមពរ របស់ លេខាធិការដ្ឋាន រៀបចំ ការបោះឆ្នោត ខេត្ត ដើម្បី មាន វិធានការណ៍ ដោះស្រាយ នៅ ថ្នាក់ដឹកនាំ គ.ជ. ប ព្រោះ នេះ គឺជា ការពង្រឹង កោសិកា នៃ ការបោះឆ្នោត នៅ ថ្នាក់ មូលដ្ឋាន ៕
( សៀមរាប ) ៖ លោក គី តិច ប្រធាន ក្រុម មេធាវី រាជ រដ្ឋាភិបាល និង ជា ប្រធាន ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន ដោយ មាន ការសហការណ៍ រៀបចំ ជាមួយ ក្រុម មេធាវី ជួយ ការងារ ច្បាប់ អាជ្ញាធរ ជាតិ អប្បរា មេធាវី ប្រចាំ សាលា ខេត្ត អាជ្ញាធរ ជាតិ អប្សរា រដ្ឋបាល ខេត្ត សៀមរាប បាន រៀបចំ កម្មវិធី ដាំ កូន ឈើ ក្រោម ប្រធានបទ « សន្តិភាព យុត្តិធម៍ សាសនា និង បេតិកភណ្ឌ បរិស្ថាន » នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នៅក្នុង បរិវេន វត្ត ឥន្ទ្រ បត្ត បុរី អង្គ តូច ផ្នែក ខាងត្បូង នៃ ខេត្ត សៀមរាប ។
កម្មវិធី នេះ មាន ការចូលរួម ពីសំណាក់ ព្រះសង្ឃ ៤៧ អង្គ អគ្គ នាយក អាជ្ញាធរ ជាតិ អប្សរា អភិបាល រង ខេត្ត សៀមរាប លោក ប្រធាន សាលាដំបូង និង លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត សៀមរាប លោក ប្រធាន សាលាដំបូង និង លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ និង បងប្អូន ប្រជាពលរដ្ឋ មាន មាន ចំនួន សរុប ប្រហែល ៦០០ នាក់ ។
គោលបំណង នៃ ការរៀបចំ ពិធី នេះ គឺ ឆ្លុះបញ្ចាំង អំពី ការចូលរួម ការពារ គាំពារ អភិរក្ស ស្តារ និង លើកកម្ពស់ បរិស្ថាន ក្រោម ម្លប់ សន្តិភាព និង ការអភិវឌ្ឍន៍ ស្រប តាម មាគា៍ ដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី កុមារ ប្រជុំ ក្រុមការងារ បច្ចេកទេស អន្ដរ ក្រសួង ពិនិត្យ សេចក្ដីព្រាង ផែនការ សកម្មភាព ឆ្លើយតប អំពើ កេងប្រវ័ញ្ច ផ្លូវភេទ លើ កុមារ តាម ប្រព័ន្ធ Internet
កិច្ចប្រជុំ នេះ ត្រូវ ធ្វើឡើង រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៥ - ១៦ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ខេត្ត កោះកុង ក្រោម អធិបតីភាព លោកស្រី ញ៉េ ប សុភាព អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ កម្ពុជា ដើម្បី កុមារ និង ដោយ មាន ការអញ្ជើញ ចូល រូម ពី លោក លោកស្រី ដែល ជា សមាជិក សមាជិកា ក្រុមការងារ បច្ចេកទេស អន្តរ ក្រសួង OCSE៕ គួរឱ្យ សរសើរ ! យុវជន កម្ពុជា មួយ ក្រុម បើក សាលា បង្រៀន បច្ចេកទេស ហាង កាហ្វេ និង ហាង លក់ គ្រឿង អេឡិកត្រូនិក នៅ ប្រទេស កូរ៉េ
( កូរ៉េ) ៖ ពី ប្រទេស កូរ៉េ ខាងត្បូង ទីក្រុង ស៊ូវ៉ុន មាន យុវជន កម្ពុជា មួយ ក្រុម មាន ដើមកំណើត ពី ខេត្ត បាត់ដំបង បាន សហការ គ្នា រៀបចំ សាលា បង្រៀន បច្ចេកទេស ហាង កាហ្វេ និង ហាង លក់ គ្រឿង អេឡិកត្រូនិក រហូត ទទួលបាន ការគាំទ្រ ពី ប្រជាពលរដ្ឋ ខ្មែរ ពលករ បរទេស និង ប្រជាពលរដ្ឋ កូរ៉េ ជា វិជ្ជមាន គួរឱ្យ កត់សម្គាល់ ហើយ គ្រោង នឹង សម្ពោធ ក្នុង ថ្ងៃ តែ មួយ គឺ នៅ ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០២០ ខាងមុខ នេះ ។
តាម ការគ្រោងទុក ពិធី សម្ពោធ នេះ នឹង មាន ការអញ្ជើញ ឯក អគ្គ រាជ ទូត ខ្មែរ ប្រចាំ ប្រទេស កូរ៉េ លោក ឡុង ឌីម៉ង់ រួម នឹង មន្រ្តី សំខាន់ របស់ សាលា ក្រុង ស៊ូវ៉ុន ហើយ កាន់តែ ពិសេស គឺ មាន វត្តមាន សិល្បករ និង កីឡាការិនី ល្បី ៗ របស់ កម្ពុជា នៅ ប្រទេស កូរ៉េ ក៏ នឹង ចូលរួម ក្នុង ថ្ងៃ សម្ពោធ ផងដែរ ។
គួរ បញ្ជាក់ ផងដែរ ថា បច្ចុប្បន្ន នេះ សហគមន៍ ខ្មែរ ដែល កំពុង រស់ នៅ ធ្វើ ការ និង សិក្សា នៅ ប្រទេស កូរ៉េ មាន ប្រមាណ ជាង ៦ម៉ឺន នាក់ ដែល ជា មធ្យម មនុស្ស ម្នាក់ អាច រក ប្រាក់ខែ ពី ១០០០ ទៅ២០០០ ដុល្លារ អាមេរិក ក្នុង មួយ ខែ និង បាន ផ្ញើ ថវិកា ជូន ក្រុមគ្រួសារ មក ក្នុង ប្រទេស ប្រមាណ ជា ៣០០ លាន ដុល្លារ អាមេរិក ក្នុង មួយ ឆ្នាំ ៕
ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ចេញ អនុក្រឹត្យ ផ្លូវការអនុញ្ញាតឲ្យ មន្ត្រីរាជការ កម្មករ និយោជិត ឈប់ សម្រាក ការងារ ចាប់ពី ថ្ងៃទី ១៧ - ២១ ខែសីហា សង ថ្ងៃ បុណ្យ ចូល ឆ្នាំ ថ្មី (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ចេញ អនុក្រឹត្យ ផ្លូវការ ស្តីពី ការអនុញ្ញាតឲ្យ មន្ត្រីរាជការ កម្មករ និយោជិត ឈប់ សម្រាក ការងារ ចាប់ពី ថ្ងៃទី ១៧ - ២១ ខែសីហា ឆ្នាំ ២០២០ សង ថ្ងៃ បុណ្យ ចូល ឆ្នាំ ថ្មី ។
កាលពី ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២០ សម្តេច តេជោ ហ៊ុន សែន បាន ចេញ អនុក្រឹត្យ សម្រេច លើក ពេល ដោយ មិន កំណត់ សម្រាប់ ការឈប់ សម្រាក រយៈពេល ៤ ថ្ងៃ នៅក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ដោយ អំឡុង ពេល នោះ មន្រ្តី រាជការ កម្មករ និយោជិត ត្រូវ បំពេញ ការងារ ជាធម្មតា ដើម្បី ចូលរួម បង្ការ ទប់ស្កាត់ និង ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស កម្ពុជា ។
រាជ រដ្ឋាភិបាល មាន ការព្រួយបារម្ភ ថា អំឡុង ពេល ចូល ឆ្នាំ ថ្មី នោះ បើសិនជា មាន ការអនុញ្ញាតឱ្យ ឈប់ សម្រាក ពលរដ្ឋ ខ្មែរ នឹង មាន ឱកាស ជួបជុំគ្នា ទទួលទាន ផ្សេង ៗ ដែល ងាយ នឹង ចម្លង ជំងឺ កូវីដ១៩ ដែល កំពុង រាតត្បាត យ៉ាង សាហាវ នៅលើ ពិភពលោក ខណៈ អំឡុង ពេល នោះ កម្ពុជា ទើប បាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ១១៧ ករណី ដែល ភាគ ច្រើន ជា ករណី នាំចូល ប៉ុន្តែ មិន ទាន់ ឆ្លង ដល់ សហគមន៍ នៅឡើយ ។
ទោះជា យ៉ាង នេះ ក្តី សម្តេច តេជោ ហ៊ុន សែន ក្នុង សន្និសីទ ព័ត៌មាន ពាក់ព័ន្ធ នឹង បច្ចុប្បន្នភាព នៃ ជំងឺ កូវីដ១៩ នៅ វិមាន សន្តិភាព នា ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២០ ក៏ បាន ប្រកាស ដែរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ប៉ះ ប៉ូវ នូវ ថ្ងៃ ឈប់សម្រាក ជូន មន្រ្តី រាជការ កម្មករ និយោជិត ឡើងវិញ នៅ ពេលវេលា មួយ សមស្រប ហើយ ពេលនេះ រាជ រដ្ឋាភិបាល សម្រេច ឲ្យ ឈប់ រយៈពេល ៥ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៧ - ២១ ខែសីហា ឆ្នាំ ២០២០ ខាងមុខ នេះ ៕
រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ច្រានចោល ការផ្សាយ ព័ត៌មាន មិន ពិត របស់ វិទ្យុ អាស៊ី សេរី ដែល ថា ទាហាន វៀតណាម ប្រដាប់អាវុធ ចូល ឈ្លានពាន នៅ ស្រុក ពញា ក្រែក
( ត្បូងឃ្មុំ ) ៖ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ នៅ រសៀល ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បន្ទាន់ មួយ ដោយ ច្រានចោល ទាំងស្រុង នូវ ព័ត៌មាន របស់ គេហទំព័រ វិទ្យុ អាស៊ី សេរី ដែល ចុះផ្សាយ ថា « មាន យោធា វៀតណាម ប្រដាប់ ដោយ អាវុធ និង ដំបង ឆក់ ប្រមាណ ៣០ នាក់ ចូលមក ឈ្លានពាន និង ធ្វើ ទុក បុក ម្នេញ លើ ពលរដ្ឋ ខ្មែរ ជាច្រើន គ្រួសារ ដែល រស់ នៅក្នុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ មិន ឱ្យ ធ្វើ ស្រែ លើ ដី របស់ ខ្លួន តាម បណ្ដោយ ព្រំដែន » ។
រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ បាន បញ្ជាក់ ថា « ពុំ មាន វត្តមាន ទាហាន វៀតណាម ប្រដាប់ ដោយ អាវុធ ចូលមក ឈ្លានពាន និង ធ្វើ ទុក បុក ម្នេញ លើ ពលរដ្ឋ ខ្មែរ ដែល រស់ នៅ ស្រុក ពញ ក្រែក នោះ ទេ ។ សូម ធ្វើ ការបដិសេធ និង ច្រានចោល ទាំងស្រុង នូវ ព័ត៌មាន របស់ គេហទំព័រ វិទ្យុ អាស៊ី សេរី បាន ចុះផ្សាយ » ។
រដ្ឋបាល ខេត្ត បាន ដាក់ចេញ វិធានការរឹតបន្ដឹង និង ពង្រឹង គ្រប់គ្រង ការចេញ - ចូល ឆ្លងកាត់ ព្រំដែន ទាំង មនុស្ស និង ទំនិញ យ៉ាង ម៉ឺងម៉ាត់ ទប់ស្កាត់ និង បង្ក្រាប បាន ទាន់ ពេលវេលា រាល់ បទល្មើស ឆ្លង ដែន ក៏ ដូចជា ដើម្បី រាំង ខ្ទប់ ការរីករាល ដាល នៃ ជំងឺ កូវីដ - ១៩ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ យល់ ថា « ការចុះផ្សាយ របស់ វិទ្យុ អាស៊ី សេរី ខាងលើ គឺជា ព័ត៌មាន អុជ អាល បំភ្លៃ ការពិត មិន ឆ្លុះបញ្ចាំង អំពី ទិដ្ឋភាព ជាក់ស្តែង គ្មាន មូលដ្ឋាន ច្បាស់លាស់ ប្រឌិត ឡើង ដើម្បី បម្រើ ផល ប្រយោជន៍ នយោបាយ បក្សពួក របស់ ខ្លួន ដែល បង្ក ការភ័ន្តច្រឡំ ក្នុង ចំណោម សាធារណមតិ និង បង្កើត ភាព ល្អក់កករ ក្នុង កិច្ចសហប្រតិបត្តិការ រវាំង ប្រទេស ទាំង ពីរ ( កម្ពុជា - វៀតណាម )» ៕
ក្រសួង អប់រំ ចេញ សេចក្តីណែនាំ ស្តីពី ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ( បាក់ឌុប ) ឆ្នាំ សិក្សា ២០១៩ - ២០២០ នៅ តាម គ្រឹះស្ថាន សិក្សា ឯកជន
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា ចេញ សេចក្តីណែនាំ ស្តីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ នៅ តាម គ្រឹះស្ថាន សិក្សា ឯកជន សម្រាប់ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ ដោយ ក្រសួង បាន កំណត់ យក ថ្ងៃទី ១៧ - ១៨ ខែសីហា ឆ្នាំ ២០២០ ក្រោយ មាន ការយឺតយ៉ាវ ដោយសារ ការរីករាលដាល ពី ជំងឺ កូវីដ១៩ ។
យ៉ាងណា ចំពោះ ករណី ថ្ងៃ ប្រឡង បាក់ឌុប ចំ ថ្ងៃ ឈប់សម្រាក រាជ រដ្ឋាភិបាល បាន កំណត់ សម្រាប់ ប៉ះ ប៉ូវ ថ្ងៃ សម្រាក ចូល ឆ្នាំ ថ្មី ត្រូវបាន លោក រស់ សុវាចា អ្នកនាំពាក្យ ក្រសួង អប់រំ បាន បញ្ជាក់ ថា ក្រសួង រក្សា សិទ្ធិ ក្នុង ការកែប្រែ សម័យ ប្រឡង បាក់ឌុប នៅ តាម គ្រឹះស្ថាន សិក្សា ឯកជន នេះ ទៅ តាម គោលការណ៍ ថ្មី ៗ របស់ រាជ រដ្ឋាភិបាល ។
សេចក្ដីណែនាំ បាន បន្ត ទៀត ថា សម្រាប់ គ្រឹះស្ថាន សិក្សា ឯកជន ត្រូវ ដាក់ពាក្យ ស្នើសុំ រៀបចំ ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ដោយ ភ្ជាប់ បញ្ជី រាយ នាម បេក្ខជន ត្រូវ ប្រឡង មក ក្រសួង តាមរយៈ មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី - ខេត្ត ឲ្យបាន មុន ដំណាច់ ខែកក្កដា ឆ្នាំ ២០២០ ជា កំហិត ដើម្បី ពិនិត្យ និង ទទួលស្គាល់ ពី ក្រសួង ៕
បើ រាប់ ចាប់តាំងពី ថ្ងៃទី ០២ ខែកក្កដា រហូតមកទល់ ពេលនេះ ដោយ ដក ចេញ តែ ថ្ងៃទី ០៨ មួយ ប៉ុណ្ណោះ ទីក្រុង តូក្យូ ត្រូវបាន គេ រាយការណ៍ ថា មាន ករណី ឆ្លង ថ្មី ៗ ច្រើន ជាង ១០០ ករណី ជា មធ្យម ក្នុង មួយ ថ្ងៃ ដែល អត្រា នេះ ពិតជា ខ្ពស់ ហើយ សម្រាប់ ជប៉ុន ។ ចំណែក នៅ រយៈពេល បួន ថ្ងៃ ចុងក្រោយ នេះ វិញ ទីក្រុង មួយ នេះ បាន រកឃើញ ករណី ឆ្លង ថ្មី ៗ ច្រើន ជាង ២០០ ករណី ក ក្នុង មួយ ថ្ងៃ ឯណោះ ។
អាជ្ញាធរ ក្រុង ដូន កែវ ចុះ អន្តរាគមន៍ រំដោះ ទឹក លិច ដែល លិច ផ្ទះ ពលរដ្ឋ ក្នុង ក្រុង
( តាកែវ )៖ បន្ទាប់ពី ផ្ទះ របស់ ប្រជាពលរដ្ឋ មួយចំនួន ត្រូវ រង ការលិចលង់ ដោយសារ ភ្លៀង មួយ មេ ធំ កាលពី យប់ មិញ នេះ នៅ ព្រឹក ថ្ងៃពុធ ទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ លោក ម ប៉ាន់ ភារៈ អភិបាល ក្រុង ដូន កែវ ស្ដី ទី បាន ដឹកនាំ មន្ត្រី ជំនាញ រួម នឹង គ្រឿងចក្រ ចុះ ធ្វើការកាយ ប្រឡាយ ដើម្បី រំដោះ ទឹក កុំ ឲ្យ លិច លង់ ផ្ទះ របស់ ប្រជាពលរដ្ឋ តទៅទៀត ។
លោក ប៉ាន់ ភារៈ បាន ថ្លែង ឲ្យដឹង ថា អាជ្ញាធរ មូលដ្ឋាន មិន បាន ព្រងើយ កន្តើយ ឬ មិន យកចិត្តទុកដាក់ ពី ការលិចលង់ ផ្ទះ របស់ ប្រជាពលរដ្ឋ និង ផ្លូវ សាធារណៈ មួយចំនួន ដោយសារ ភ្លៀង មួយ មេ ធំ កាលពី យប់ មិញ នោះ ទេ ពោល បន្ទាប់ពី លិច ផ្ទះ និង ផ្លូវ សាធារណៈ អាជ្ញាធរ ក្រុង ដូន កែវ បាន ចុះ ទៅ អន្តរាគមន៍ ភ្លាម ៗ ដើម្បី ធ្វើ យ៉ាងណា ជួយ រំដោះ ទឹក ចេញ ពី ផ្ទះ ប្រជាពលរដ្ឋ ឱ្យ បាន ឆាប់ ។
លោក អភិបាល ក្រុង ដូន កែវ ស្តីទី ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម ចូលរួម ជាមួយ អាជ្ញាធរ តាមរយៈ ការដាក់ សំរាម នៅក្នុង ធុង ឲ្យបាន ត្រឹមត្រូវ កុំ បោះចោល ពាស វាលពាសកាលកាល ដែល នាំឲ្យ ស្ទះ លូ ជាពិសេស ត្រូវ ស្តាប់ តាម ការណែនាំ របស់ អាជ្ញាធរ ក្រុង ក្នុង ការដាក់ លូ តាម មុខ ផ្ទះ ឲ្យ ត្រឹមត្រូវ តាម បច្ចេកទេស ជៀសវាង ដាក់ លូ ដោយ ខ្លួន ឯង ដែល នាំឱ្យ មាន ផលវិបាក ពេល ភ្លៀង ខ្លាំង ម្ដង ៗ ៕
ភាគី ពាក់ព័ន្ធ មិន ទាន់ បង្ហាញ ពេលវេលា និង ទីតាំង ជាក់លាក់ នៅឡើយ ទេ ដោយ គ្រាន់តែ ប្រុងប្រៀប រៀបចំ តែ ប៉ុណ្ណោះ ។
ឆ្លើយតប នឹង សេចក្តីជូនដំណឹង របស់ ក្រសួង ការពារ ប្រទេស ឡាវ . នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន គណកម្មការ សង្គ្រោះ គ្រោះមហន្តរាយ ក . ព. ជ នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បើក កិច្ចប្រជុំ ពិភាក្សា ដើម្បី ត្រៀមលក្ខណៈ កម្លាំង ជំនាញ ទាំង បី ប្រភេទ ទ័ព ព្រមទាំង ឧបករណ៍ សម្ភារៈ និង មធ្យោបាយ ផ្សេង ៗ ទៀត ក្នុង ការធ្វេី សមយុទ្ធ សង្រោះ គ្រោះមហន្តរាយ រួមគ្នា រវាង កងទ័ព កម្ពុជា . កងទ័ព ឡាវ និង កងទ័ព វៀតណាម ដែល គ្រោង ធ្វេី នា ពេល ខាងមុខ នេះ ។
នៅក្នុង កិច្ចប្រជុំ នោះ ដែរ នាយ ឧត្តមសេនីយ៍ មុឹង សំផន ក៏ បាន ភ្ជាប់ ការងារ របស់ គណៈកម្មការ សង្គ្រោះ គ្រោះមហន្តរាយ ក្រសួង ការពារ ជាតិ ដែល ស្រប ពេល រដូវ វស្សា ឈានចូល មកដល់ ផង នោះ តាម បណ្តាល អង្គភាព ជំនាញ ត្រូវ ត្រៀម គ្រប់ លក្ខណ : ដេីម្បី ចុះ ជួយ ប្រជាពលរដ្ឋ ឱ្យ ទាន់ ពេលវេលា នៅពេល មាន គ្រោះមហន្តរាយ កើតឡើង ជា យថាហេតុ នៅក្នុង រដូវ វស្សា ឆ្នាំ ២០២០ នេះ ។
កិច្ចប្រជុំ នោះ ក៏ មាន ការអញ្ជេីញ ចូលរួម ពី បណ្តា អង្គភាព ជំនាញ កងទ័ព ជើងគោក កងទ័ព ជើងទឹក កងទ័ព ជើងអាកាស អង្គភាព ការងារ ធានា ភស្តុភា ហិរញ្ញវត្ថុ និង បណ្តា អង្គភាព ជំនាញ បន្ថែម ទៀត រួម មាន៖ កងពល តូច ថ្មើរជើង លេខ ៧០. កងពល តូច ទ័ព ពិសេស ឆត្រ័ យោង ៩១១. កងរាជអាវុធហត្ថ និង កងពល ដឹកជញ្ជូន លេខ ៩៩ ដែល ជា អង្គភាព ជំនាញ ធ្លាប់ បាន ចូលរួម សង្គ្រោះ គ្រោះមហន្តរាយ ជួយ ដល់ ប្រជាពលរដ្ឋ នា ពេល កន្លងមក ៕ កងទ័ព អាមេរិក ត្រូវបាន ដក ចេញ ពី មូលដ្ឋាន ទ័ព ចំនួន ៥ នៅ អាហ្វហ្គានីស្ថាន តប តាម កិច្ចព្រមព្រៀង ជាមួយ តាលី បង់
( វ៉ាស៊ីនតោន ) ៖ ក្រសួង ការពារ ជាតិ អាមេរិក នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ ( ម៉ោង នៅ វ៉ាស៊ីនតោន ) បាន ប្រកាស ឲ្យដឹង ថា សហរដ្ឋ អាមេរិក បាន សម្រេច ដក កងទ័ព របស់ ខ្លួន ចេញ ពី មូលដ្ឋាន យោធា ចំនួន ០៥ នៅក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ជា ផ្នែក មួយ នៃ កិច្ចព្រមព្រៀង ដែល ខ្លួន បាន ចុះហត្ថលេខា ជាមួយ ក្រុម សកម្ម ប្រយុទ្ធ តាលី បង់ កាលពី ចុង ខែកម្ភៈ កន្លងទៅ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួរ នា រសៀល ថ្ងៃពុធ ទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
ជាមួយ សំណាង ទឹកប្រាក់ ៥លាន រៀល នេះ លោក សង្ឃឹម ថា នឹង ជួយ ពង្រីក មុខរបរ លក់ សម្លៀកបំពាក់ របស់ លោក អោយ កាន់តែ ចំណេញ ច្រើន ជាង មុន មួយ កម្រិត ទៀត ។
ទឹកក្រូច អាយស៍ IZE ដប និង កំប៉ុង ផ្តល់ សំណាង ជាច្រើន ក្នុង គម្រប និង ក្រវិល កំប៉ុង ដែល រួម មាន ទឹកប្រាក់ សុទ្ធ ៥លាន រៀល ទូរស័ព្ទដៃ ស្មាតហ្វូន ទឹកប្រាក់ ១ម៉ឺន រៀល ៥ ពាន់ រៀល និង ទឹកក្រូច អាយស៍ IZE ជាច្រើន រយ រង្វាន់ ផងដែរ ៕ ថៃ បញ្ជូន ពលរដ្ឋ ខ្មែរ ៣នាក់ ត្រឡប់មក កម្ពុជា វិញ ក្រោយ ជាប់ ទោស ជិត ២ឆ្នាំ ពី បទ ឆ្លង ដែន ខុស ច្បាប់
( ឧត្តរមានជ័យ )៖ អាជ្ញាធរ ថៃ បាន បញ្ជូន ពលរដ្ឋ ខ្មែរ ចំនួន ៣នាក់ ទៀត ហើយ ឱ្យ មក អាជ្ញាធរ កម្ពុជា វិញ តាម ច្រក អន្តរជាតិ ជាំ ស្ថិត ក្នុង ភូមិ ជើង ភ្នំ ឃុំ ត្រពាំង ប្រីយ៍ ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បន្ទាប់ពី ពួកគេ ត្រូវ សមត្ថកិច្ច ថៃ ចាប់ ឃុំ ខ្លួន ជិត ២ ឆ្នាំ នៅ ខេត្ត ឧប៊ុន ប្រទេស ថៃ ពី បទ ឆ្លង ដែន ខុស ច្បាប់ ។
តាមរបាការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ឧត្តរមានជ័យ បាន បញ្ជាក់ ឱ្យដឹង ថា នៅ រសៀល ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ អាជ្ញាធរ ថៃ បាន បញ្ជូន ប្រជាពលរដ្ឋ ខ្មែរ ចំនួន ៣នាក់ តាម ច្រក អន្តរជាតិ ជាំ ដែល ត្រូវ ទាហាន ថៃ ចាប់ខ្លួន កាលពី ថ្ងៃទី ០៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ពី បទ ឆ្លង ដែន ចូល កាប់ ឈើ គ្រញូង ចូល តាម ច្រក អាន សេះ និង បាន យក ទៅ ឃុំ ខ្លួន នៅ ខេត្ត ឧប៊ុន ប្រទេស ថៃ ។
ពលរដ្ឋ ខ្មែរ ទាំង ៣នាក់ រស់ នៅ ស្រុក ត្រពាំងប្រាសាទ ខេត្ត ឧត្តរ មាន ជយ័ និង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
ក្រោយពី បាន ស្គែន កំដៅ ស្វែងរក ជំងឺ កូវីដ១៩ និង សម្អាត ខ្លួនប្រាណ ដោយ ទឹក អាល់កុល រួច មក សមត្ថកិច្ច បាន ធ្វើ ការអប់រំ ណែនាំ ឱ្យ បញ្ឈប់ ការឆ្លង ដែន ដោយ ខុស ច្បាប់ ទៀត និង បាន ឱ្យ វិលត្រឡប់ ទៅ លំនៅដ្ឋាន វិញ រៀង ៗ ខ្លួន ៕
ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ អ្នកដំណើរ ពី ក្រៅ ប្រទេស ចំនួន ១១ជើងហោះហើរ ចូលមក កម្ពុជា . សរុប អ្នកដំណើរ តាំងពី បើក ឲ្យ មាន ជើងហោះហើរ ឡើងវិញ មាន ជាង ២ម៉ឺន នាក់
( ភ្នំពេញ ) ៖ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល លោកស្រី យក់ សម្បត្ដិ បាន ថ្លែង ថា អ្នកដំណើរ ពី ក្រៅ ប្រទេស ចំនួន ជាង ២ម៉ឺន នាក់ ហើយ ដែល បាន ត្រឡប់ ចូលមក កម្ពុជា គិត ចាប់ពី កម្ពុជា អនុញ្ញាតឱ្យ ជន បរទេស មកពី ប្រទេស ចំនួន ៦ ដែល ហាម ចូល កន្លងមក អាច ចូលមកកាន់ ប្រទេស កម្ពុជា ធម្មតា វិញ ចាប់ពី ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២០ ។
ការថ្លែង បែប នេះ របស់ លោកស្រី ក្នុង ឱកាស អញ្ជើញ ចូលរួម ក្នុង ជំនួប សម្ដែង ការគួរសម រវាង ឯក អគ្គ រាជ ទូត ថៃ ប្រចាំ កម្ពុជា ជាមួយ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០នេះ នាទី ស្ដីការ ក្រសួង សុខាភិបាល ។
លោកស្រី យក់ សម្បត្ដិ បាន ថ្លែង បន្ដ ថា « គិត ត្រឹម ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ អ្នកដំណើរ ពី ក្រៅ ប្រទេស គ្រប់ ជាតិ សាសន៍ ទាំងអស់ សរុប ចំនួន ជាង ២ម៉ឺន នាក់ ហើយ បើ គិត ទាំង ១១ជើងហោះហើរ ក្នុង ថ្ងៃ នេះ ( ៩ជើង នៅ ទីក្រុង ភ្នំពេញ និង ២ជើង ចុះ ទៅ ព្រះសីហនុ) ភាគ ច្រើន ជនជាតិ ចិន ដែល ត្រូវ ត្រលប់មក ធ្វើការ អ្វី និង និស្សិត មួយចំនួន សរុប ជិត ១ ពាន់ នាក់ » ។
លោកស្រី ថ្លែង បន្ដ ថា « ទោះបីជា មាន អ្នកដំណើរ ពី ក្រៅ ប្រទេស ចូលមក កម្ពុជា កើនឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ក៏ដោយ និង មាន ជើងហោះហើរ ពេលយប់ ក្ដី ក្រុម មន្ដ្រី សុខាភិបាល របស់ យើង នៅតែ បន្ដ ធ្វើ ការងារ ធ្វើតេស្ដ នេះ ពេញ ២៤ ម៉ោង ដោយ មិន រួញរា ឡើយ មិន ថា ថ្ងៃ ឬ យប់ កណ្ដាល អាធាត្រ នោះ ទេ គឺ ត្រូវ ធ្វើឱ្យ ហើយ និង យកចិត្ដទុកដាក់ ខ្ពស់ ដើម្បី ការពារ ទប់ស្កាត់ រីករាលដាល កូវីដ១៩ » ។
រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ទៀត ថា « ខណៈ ដែល មាន ជើងហោះហើរ មក កម្ពុជា កាន់តែ ច្រើន សាលា រាជធានី ភ្នំពេញ និង ក្រសួង សុខាភិបាល បាន រក ទីតាំង ចត្ដាឡី ស័ក បន្ថែម ទៀត នៅ សាលារៀន ពោធិ៍ ចិន តុង ដែល អាច ទទួលបាន ៣០០ នាក់ និង វិទ្យាល័យ ១០០ ខ្នង ដែល ក្រុមការងារ នឹង ចុះ ពិនិត្យ នៅ រសៀល នេះ » ។
លោកស្រី ថ្លែង បន្ដ ថា សង្ឃឹម ថា ជំងឺ កូវីដ១៩ មិន មាន ការឆ្លង ចូលមក កម្ពុជា មាន ចំនួន ច្រើន នោះ ទេ និង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ រួមទាំង អ្នកដំណើរ ចូលមក កម្ពុជា សូម កុំ ភ្លេច មេរោគ កូវីដ១៩ វា នៅតែ ជា ករណី ផុយ ស្រួយ នៅឡើយ បើ យើង មិន អនុវត្ដ នូវ វិធានការ ទាំងឡាយ របស់ ក្រសួង សុខាភិបាល ដែល បាន ដាក់ចេញ ដូចជា រក្សា គម្លាត បុគ្គល និង សង្គម . ការអនាម័យ ដៃ និង ខ្លួនប្រាណ ស្អាត . ការពាក់ ម៉ាស និង ការអនុវត្ដ វិធានការ ផ្សេង ទៀត ៗ ដូចជា ចត្ដាឡី ស័ក ជាដើម ។
ជាពិសេស អំឡុង ចត្ដាឡី ស័ក សូម កុំ ដើរ ចេញ ទៅ ក្រៅ ផ្ទះ ឬ ជួបជុំ បងប្អូន និង អ្នកជិតខាង រហូតដល់ ១៤ ថ្ងៃ ហើយ ថ្ងៃទី ១៣ នៃ ចត្ដាឡី ស័ក សូម ទៅ ពិនិត្យ រក មេរោគ កូវីដ១៩ ម្ដង ទៀត ដើម្បី ប្រាកដប្រជា ថា គ្មាន មេរោគ កូវីដ » ។
សូម ជម្រាប ថា គិត ត្រឹម ថ្ងៃ នេះ កម្ពុជា រកឃើញ មាន អ្នក មាន ជំងឺ កូវីដ១៩ សរុប ចំនួន ១៦៥ នាក់ ( ស្ត្រី ៤០ នាក់ និង បុរស ១២៥ នាក់ ) ក្នុង នោះ អ្នក ព្យាបាល ជាសះស្បើយ សរុប ទូទាំង ប្រទេស មាន ចំនួន ១៣៣ នាក់ ( ស្រី ៣៩ នាក់ និង បុរស ៩៤ នាក់ ) និង អ្នក សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ រដ្ឋ មាន ចំនួន ៣២ នាក់ ៕ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី៖ កងទ័ព មួក ខៀវ កម្ពុជា ទទួលបាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ពី សម្តេច តេជោ ហ៊ុន សែន
( កំពង់ស្ពឺ ) ៖ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ គ្រប់គ្រង កងកម្លាំង រក្សា សន្តិភាព បោសសម្អាត មីន និង កាកសំណល់ សង្គ្រាម បាន លើកឡើង ថា កងទ័ព មួក ខៀវ កម្ពុជា ដែល បាន បំពេញ បេសកកម្ម មនុស្សធម៌ ក្រោម ឆត្រ អង្គការ សហ ប្រជាជាតិ នៅក្នុង ប្រទេស ដែល ហួង ហែង ដោយសារតែ ភ្លើង សង្គ្រាម ទទួលបាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង UN ក្នុង ដំណាក់កាល រាតត្បាត ជំងឺ កូវីដ - ១៩ ។
ការបញ្ជាក់ បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក្រោយ យ បញ្ចប់ ពិធី គោរព វិញ្ញាណក្ខន្ធ ផ្លូវការ សព ឧត្តមសេនីយ៍ ទោ ស សាវី ដែល បាន បាត់បង់ជីវិត ដោយសារ ជំងឺ កូវីដ - ១៩ នៅក្នុង តំបន់ បំពេញ បេសកកម្ម ក្នុង ប្រទេស ម៉ាលី កាលពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០២០ កន្លងទៅ ។
គួរ កត់សម្គាល់ ថា កងកម្លាំង មួក ខៀវ កម្ពុជា ចំនួន ០៩ នាក់ បាន ឆ្លង ជំងឺ កូវីដ - ១៩ នៅក្នុង តំបន់ បេសកកម្ម នៅ សាធារណរដ្ឋ ម៉ាលី បាន ជាសះស្បើយ ១០០ ភាគរយ នឹង វិលត្រឡប់ ទៅ បំពេញ ភារកិច្ច ជាធម្មតា ។ រីឯ កងកម្លាំង មួក ខៀវ ចំនួន ៨០ នាក់ ដែល វិលត្រឡប់ មកដល់ កម្ពុជា កាលពី ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ ថ្មី ៗ នេះ តែ ត្រូវ អនុវត្ត តាម វិធាន សុខាភិបាល ចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ។
លោក Abbas បាន ប្រកាស កាលពី ០២ ខែ មុន ពី ការលុបចោល រាល់ កិច្ចព្រមព្រៀង និង ការយោគយល់ គ្នា រួមទាំង កិច្ចចរចា សន្តិភាព ជាមួយ ប្រទេស អ៉ី ស្រាអែល និង សហរដ្ឋ អាមេរិក ដើម្បី ឆ្លើយតប នឹង ផែនការឈ្លានពានរប់់ អ៉ី ស្រាអែល ។
គួរ បញ្ជាក់ ថា កិច្ចចរចា សន្តិភាព រវាង អ៉ី ស្រាអែល និង ប៉ាឡេ ស្ទីន បានជាប់គាំង ចាប់តាំងពី ឆ្នាំ ២០១៤ មក ម្ល៉េះ បន្ទាប់ពី សហរដ្ឋ អាមេរិក កាលពី ជំនាន់ រដ្ឋបាល លោក អូប៉ា ម៉ា បាន ផ្តួចផ្តើម ឡើង អស់ រយៈពេល ៩ខែ ប៉ុន្តែ មិន បាន ទទួល វឌ្ឍនភាព នោះ ទេ ដោយសារតែ ការខ្វែងគំនិត គ្នា រវាង អ៉ី ស្រាអែល និង ប៉ាឡេ ស្ទីន លើ បញ្ហា ធំ ៗ ដូចជា ផ្នែក សន្តិសុខ និង ព្រំដែន ៕
បង្ក្រាប ក្រុម ឆបោក ជនជាតិ នីហ្សេរីយ៉ា និង ស្រ្តី ខ្មែរ តាម ទូរស័ព្ទ យ៉ាង សកម្ម ៣នាក់ ពាក់ព័ន្ធ ករណី ឆបោក លុយ ជាង ១ម៉ឺន ដុល្លារ និង ដកហូត បាន ស៊ីម ជាច្រើន នៅ ខណ្ឌ ដង្កោ
ហើយ ឱ្យ ជនរងគ្រោះ អ្នក ទទូល លុយ នោះ នៅ ក្រុមហ៊ុន អាកាសចរណ៍ ប៉ុន្តែ ឱ្យ ជនរងគ្រោះ ផ្ញើ អាសយដ្ឋាន របស់ ជនរងគ្រោះ ទៅ រូប គេ សិន រួច ជនរងគ្រោះ ក៏ បាន ផ្ញើ អាសយដ្ឋាន ទៅ ឱ្យ គេ ហើយ គណនី ហ្វេសប៊ុក ខាងលើ បាន ផ្ញើ កញ្ចប់ អីវ៉ាន់ និង វិក្កយបត្រ ផ្ញើ អីវ៉ាន់ តាម ក្រុមហ៊ុន ដឹក ជញ្ជូន មក ឱ្យ ជនរងគ្រោះ បាន ឃើញ ជាមុន សិន ។
ក្រោយមក លេខ ទូរស័ព្ទ ខាងលើ បាន និយាយ ហេតុផល ផ្សេង ៗ ធ្វើឱ្យ ជនរងគ្រោះ ផ្ញើ លុយ ឱ្យ រូប គេ តាម ភ្នាក់ងារ វីង នៅក្នុង រាជធានី ភ្នំពេញ ជា បន្តបន្ទាប់ អស់ លុយ សរុប ចំនួន ១០៧៥០ ដុល្លារ ហើយ ជនរងគ្រោះ ពុំ បាន ទទួល អីវ៉ាន់ អ្វី សោះ ។ លុះ ដល់ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២០ វេលា ម៉ោង ០៩ និង ០០នាទី លេខ ទូរស័ព្ទ ខាងលើ គឺ មាន មនុស្ស ស្រី មិន ស្គាល់ ឈ្មោះ បាន ទូរស័ព្ទ ចូលមក លេខ របស់ ជនរងគ្រោះ តម្រូវឱ្យ ជនរងគ្រោះ ផ្ញើ លុយ ទៅ ឱ្យ រូប គេ ចំនួន ១០០០០ ដុល្លារ ថែម ទៀត ។
ទើប ជនរងគ្រោះ បាន មករាយការណ៍ ប្រាប់ សមត្ថកិច្ច និង ដាក់ ពាក្យ បណ្តឹង នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ង្កោ ដើម្បីឱ្យ សមត្ថកិច្ច ឃាត់ខ្លួន ក្រុម ជនសង្ស័យ ខាងលើ យកមក ធ្វើ ការសាកសួរ តាម នីតិវីធី ច្បាប់ ។
សមត្ថកិច្ច នគរបាល ខណ្ឌ ដង្កោ បាន សហការ ជាមួយ សមត្ថកិច្ច នគរបាល នាយកដ្ឋាន ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ និង នាយកដ្ឋាន ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា ក្រោម ការសម្របសម្រួល ពី លោក សឿង មុនីរ័ត្ន ព្រះរាជអាជ្ញា រង រាជធានី ភ្នំពេញ ធ្វើ ការស្រាវជ្រាវ ឃាត់ខ្លួន ជនសង្ស័យ បាន ចំនួន ០៣ នាក់ ត្រង់ ចំណុច បុរី លឹម ឈាង ហាក់ ភូមិ ម័ល សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ យកមក ធ្វើ ការសាកសួរ តាម នីតិវិធី ច្បាប់ នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដង្កោ ។
ចិន ប្រកាស សងសឹក សហរដ្ឋ អាមេរិក ពាក់ព័ន្ធ ការលូកលាន់ កិច្ចការ ផ្ទៃក្នុង ចិន (Video inside) ( ប៉េកាំង ) ៖ នៅ ថ្ងៃពុធ នេះ រដ្ឋាភិបាល ទីក្រុង ប៉េកាំង បាន ព្រមាន ថា ខ្លួន នឹង ចាត់ វិធានការសងសឹក លើ សហរដ្ឋ អាមេរិក វិញ ជា ចាំបាច់ បន្ទាប់ពី ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន ចុះហត្ថលេខា លើ ច្បាប់ មួយ ដែល អនុញ្ញាតឲ្យ មាន ការ ដាក់ទណ្ឌកម្ម លើ ធនាគារ របស់ ចិន ជុំវិញ ការអនុម័ត ច្បាប់ សន្តិសុខ ថ្មី សម្រាប់ ហុងកុង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នា រសៀល ថ្ងៃពុធ ទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
តាមរយៈ សេចក្តីថ្លែងការណ៍ របស់ ខ្លួន ក្រសួង ការបរទេស ចិន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « ប្រទេស ចិន នឹង ធ្វើ ការឆ្លើយតប ជា ចាំបាច់ ដើម្បី ការពារ ផលប្រយោជន៍ ស្រប ច្បាប់ របស់ ខ្លួន និង ដាក់ទណ្ឌកម្ម លើ បុគ្គលិក ក៏ ដូចជា អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ របស់ សហរដ្ឋ អាមេរិក » ។
មិន តែ ប៉ុណ្ណោះ ក្រសួង ការបរទេស ចិន ថែមទាំង បាន សង្កត់ធ្ងន់ ថា ទីក្រុង ប៉េកាំង ជំទាស់ យ៉ាង ដាច់ខាត ចំពោះ សកម្មភាព ចុងក្រោយ របស់ សហរដ្ឋ អាមេរិក និង បាន ជំរុញ ឲ្យ ទីក្រុង វ៉ាស៊ីនតោន បញ្ឈប់ ការជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង របស់ ខ្លួន ជាបន្ទាន់ ។ « កិច្ចការ ហុងកុង គឺជា កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ចិន សុទ្ធសាធ ហើយ គ្មាន បរទេស ណាមួយ មាន សិទ្ធិ ជ្រៀត ជ្រែក បាន ឡើយ » ។ នេះ ជា ការលើកឡើង របស់ ក្រសួង ការបរទេស ចិន ។
គួរ បញ្ជាក់ ថា ការព្រមាន នេះ ត្រូវបាន ធ្វើឡើង បន្ទាប់ពី ប្រធានាធិបតី អាមេរិក ដូណាល់ ត្រាំ បាន ចុះហត្ថលេខា លើ ច្បាប់ ដែល អនុញ្ញាតឲ្យ មាន ការ ដាក់ទណ្ឌកម្ម លើ ធនាគារ ទាំងឡាយ ណា ដែល ធ្វើ ជំនួញ ជាមួយ មន្ត្រី ចិន និង មាន ជាប់ពាក់ព័ន្ធ ក្នុង ការអនុម័ត ច្បាប់ សន្តិសុខ ជាតិ ថ្មី សម្រាប់ ដែនដី ហុងកុង កាលពី ពេល ថ្មី ៗ នេះ ៕
ទោះជា យ៉ាង នេះ ក្តី ក្រសួង បញ្ជាក់ ដែរ ថា ករណី ជំងឺ គ្រុន ឈាម បាន ថយចុះ នៅ ទូទាំង ប្រទេស នា ដើម ឆ្នាំ ២០២០ តែ ករណី មាន រាយប៉ាយ ដុំ ៗ តាម ភូមិសាស្ត្រ ប្រជុំជន មួយចំនួន ពិសេស នៅ រាជធានី ភ្នំពេញ ខេត្ត ព្រះសីហនុ ប៉ៃលិន សៀមរាប កណ្ដាល កំពង់ធំ តាកែវ មណ្ឌលគិរី រតនគិរី និង ខេត្ត ព្រះវិហារ ។
ជា សន្និដ្ឋាន ក្នុង ខណៈពេលនេះ គឺ ស្ថានភាព ជំងឺ គ្រុន ឈាម ក្នុង ប្រទេស កម្ពុជា កំពុង ស្ថិត នៅក្នុង ស្ថាន ភាពធម្មតា ក្រោម ការគ្រប់គ្រង យ៉ាង ល្អ របស់ កម្មវិធី ប្រយុទ្ធ នឹង ជំងឺ គ្រុន ឈាម ទូទាំង ប្រទេស ដែល មាន ការចូល រួម អន្តរាគមន៍ និង សហការ ពេញលេញ របស់ គ្រប់ ដៃគូ ពាក់ព័ន្ធ និង ប្រជាជន ក្នុង សហគមន៍ ។
ក្រសួង សុខាភិបាល ក៏ បាន អំពាវនាវ និង លើកទឹកចិត្ត ដល់ ប្រជាជន គ្រប់ រូប ត្រូវ បន្ត ចូលរួម អនុវត្ត តាម វិធាន ការបង្ការ ជំងឺ គ្រុន ឈាម តាម យុទ្ធសាស្ត្រ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ គ្រុន ឈាម ដែល ក្រសួង សុខាភិបាល តែង បាន ផ្សព្វផ្សាយ ជា បន្តបន្ទាប់ នោះ ។
រដ្ឋមន្ដ្រី កិច្ចការ នារី ស្នើ ដល់ ក្រសួង - ស្ថាប័ន និង ដៃគូ ពាក់ព័ន្ធ រួមគ្នា គាំទ្រ ឲ្យ ស្ត្រី កាន់តែ មាន ភាពងាយស្រួល ក្នុង ការចាប់ យក កាលានុវត្តភាព និង សក្ដានុពល ថ្មី ៗ
( ភ្នំពេញ ) ៖ លោកស្រី អ៉ឹង កន្ថា ផាវី រដ្ឋមន្ដ្រី ក្រសួង កិច្ចការ នារី បាន ស្នើ ក្រសួង - ស្ថាប័ន និង ដៃគូ ពាក់ព័ន្ធ ជាពិសេស វិស័យ ឯកជន រួមគ្នា ពង្រីង និង ពង្រីក បរិយាកាស អំណោយផល រួមទាំង ក្នុង ក្របខណ្ឌ គោល នយោបាយ តាម វិស័យ គាំទ្រ ឲ្យ ស្ត្រី កាន់តែ មាន ភាពងាយស្រួល ក្នុង ការចាប់ យក កាលានុវត្តភាព និង សក្ដានុពល ថ្មី ៗ ។
លើស ពី នោះ ទៀត ការលើកកម្ពស់ បរិយាប័ន្ន ហិរញ្ញវត្ថុ ការអភិវឌ្ឍ សហគ្រិន ភាព ការបង្កើន ការយល់ដឹង ផ្នែក ឌីជីថល ជាពិសេស ការគិតគូរ នៅក្នុង ក្របខណ្ឌ នៃ ផែនការស្តារ សេដ្ឋកិច្ច ឡើងវិញ បន្ទាប់ពី វិបត្តិ កូវីដ - ១៩ ។
ការស្នើ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោកស្រី អ៉ឹង កន្ថា ផាវី អញ្ជើញ ចូលរួម ក្នុង សិក្ខាសាលា ស្តីពី ការបង្កើន ភាពអង់អាច ផ្នែក សេដ្ឋកិច្ច ដល់ ស្ត្រី និង ការអភិវឌ្ឍ សហគ្រាស ខ្នាត មីក្រូ តូច និង មធ្យម ក្នុង កំលុង និង ក្រោយពេល ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ នា ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
បន្ថែម ពី នោះ ទៀត លោកស្រី អ៉ឹង កន្ថា ផាវី បាន ឲ្យដឹង ថា ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ បាន បណ្តាលឲ្យ ប៉ះពាល់ វិស័យ សេដ្ឋកិច្ច និង សង្គមជាតិ ប៉ុន្តែ កូវីដ - ១៩ ក៏ អាច ជា ច្រក នៃ ឱកាស សម្រាប់ យើង ទាំងអស់ គ្នា រួមទាំង អាជីវករ ជា ស្ត្រី ។
រដ្ឋមន្ដ្រី ក្រសួង កិច្ចការ នារី បាន គូសបញ្ជាក់ ថា យើង ទាំងអស់ គ្នា ត្រូវ ប្រែ វិបត្តិ នេះ ទៅជា កាលានុវត្តភាព ក្នុង ការអភិវឌ្ឍ បង្ហាញ ពី សក្តានុពល និង ភាពខ្លាំង របស់ យើង ជាពិសេស ពង្រឹង សមត្ថភាព លើ ភាពធន់ និង ឆ្លើយតប នឹង វិបត្តិ ផ្សេង ៗ ។
ជាមួយគ្នា នេះ លោកស្រី អ៉ឹង កន្ថា ផាវី បាន លើកឡើង ថា បច្ចេកវិទ្យា ឌីជីថល កំពុង ផ្លាស់ប្តូរ របៀប ធ្វើ អាជីវកម្ម ហើយក៏ ជា កាលានុវត្តភាព ថ្មី សម្រាប់ សហគ្រិន ស្ត្រី និង សម្រាប់ ការរស់នៅ ប្រចាំ ថ្ងៃ តាម របត់ និង ទម្លាប់ ថ្មី ស្រប តាម បរិបទ សេដ្ឋកិច្ច ឌីជីថល និង បដិវត្តន៍ ឧស្សាហកម្ម ទី៤ នា ពេលនេះ ។
លោកស្រី អ៉ឹង កន្ថា ផាវី បន្ដ ទៀត ថា នៅក្នុង នោះ ការធ្វើ ធុរកិច្ច តាម ប្រព័ន្ធ អេឡិចត្រូនិច (E-commerce) ជា ឧបករណ៍ មួយ ត្រូវ យកមក ពិចារណា សម្រាប់ ការអភិវឌ្ឍ សហគ្រិន ស្ត្រី នៅ គ្រប់ កម្រិត ៕ មន្រ្តី ជំនាញ ខេត្ត ស្វាយរៀង រកឃើញ សារធាតុ គីមី ដាក់ ក្នុង ងៀត បបែល និង ពពុះ សណ្តែក ៦៥ គីឡូក្រាម នៅ ផ្សារ វាល យន្ត ក្រុង ស្វាយរៀង
( ស្វាយរៀង ) ៖ មន្ត្រី សាខា ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន រកឃើញ សារ ធាតុ គីមី (borax) ដាក់ ក្នុង ងៀត បបែល និង ពពុះ សណ្តែក ចំនួន ៦៥ គីឡូក្រាម នៅ ផ្សាយ វាល យន្ត ក្រុង ស្វាយរៀង ខេត្ត ស្វាយរៀង ។
ការរកឃើញ នេះ បន្ទាប់ពី លោក ផឹង និល ប្រធាន សាខា ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ ខេត្ត ស្វាយរៀង បាន ដឹកនាំ ក្រុមការងារ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត ស្វាយរៀង ចុះ ពិនិត្យ មុខ ទំនិញ នៅ ផ្សារ វាល យន្ត ក្រុង ស្វាយរៀង ក្នុង គោលបំណង ស្វែងរក សារធាតុ គីមី ដែល តាំង លក់ នៅលើ បន្លែ ត្រី សាច់ គ្រឿង ឧបភោគ បរិភោគ និង ទំនិញ ខូច គុណភាព និង ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ ។
លោក ផឹង និល បាន បន្ត ថា ក្រោយពី ចុះ ពិនិត្យ មុខ ទំនិញ នៅ ផ្សារ វាល យន្ត រួច មក មន្ត្រី ជំនាញ បាន នាំ បន្លែ សាច់ ជា ច្រើន មុខ បន្ថែម ទៀត មក ធ្វើតេស្ត នៅ មន្ទីរពិសោធន៍ ខ្នាត តូច សាខា ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ ដើម្បី ស្វែងរក សារធាតុ គីមី ហាមឃាត់ ។
លោក ង៉ោ ម៉េង ជ្រូន បាន បញ្ជាក់ ថា អ្នកបើកបរ រថយន្ត និង អ្នក រួម ដំណើរ សូម អនុវត្ត តាម ច្បាប់ ឆ្លង ដែន ពោល ត្រូវ បង្ហាញ ឯកសារ ចេញ និង ចូល ប្រទេស រហូត ទាល់តែ បាន ធ្វើ លិខិត បញ្ជាក់ ពី ទំនិញ និង បញ្ជាក់ ពី កន្លែង ចំណត និង ទីតាំង បញ្ជូន ទំនិញ ឲ្យបាន ជាក់លាក់ ។
លោក បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា ចំពោះ អ្នកធ្វើដំណើរ ចូលមក ដឹក ទំនិញ ត្រូវ មាន អ្នកបើក ម្នាក់ និង អ្នក រួម ដំណើរ ម្នាក់ ហើយ ត្រូវ អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល រួម មាន៖ ត្រូវ ពាក់ ម៉ាស ឲ្យបាន ជា ច្រចាំ . វាស់ កំដៅ សិន ទើប អនុញ្ញាតឲ្យ ធ្វើដំណើរ ឆ្លងកាត់ . រាយ នាម អ្នក បើក យានយន្ត លិខិត បញ្ជាក់ ពី ការបញ្ជូន ទំនិញ ឯកសារ ឆ្លង ដែន មាន លិខិត ឆ្លង ដែន បណ្ណ ព្រំដែន និង បណ្ណ ឆ្លង ដែន បណ្ណោះ អាសន្ន ។
លោក បាន បញ្ជាក់ ថា រថយន្ត ទាំង ៥០ គ្រឿង នោះ ត្រូវ គោរព តាម ពេលវេលា ដែល ត្រូវ ឆ្លងកាត់ ចាប់ពី ម៉ោង ៨ព្រឹក ហើយ ធ្វើដំណើរ ត្រឡប់ មកវិញ នៅ វេលា ម៉ោង ១ ថ្ងៃត្រង់ ក្នុង មួយ ថ្ងៃ ជា កំហិត យាន្ត យន្ត ចេញ ចូល មិន លើស ពី ៥០ គ្រឿង ជាដាច់ខាត ។
បើ តាម លោក ង៉ោ ម៉េង ជ្រួន ចំពោះ ប្រជាជន កម្ពុជា ដែល ចូលមក ដឹក ទំនិញ ក្នុង មួយ ថ្ងៃ ៗ សូម ចូល តាម ផ្លូវ ដែល បាន កំណត់ ជូន និង អនុញ្ញាតឲ្យ ស្ថិត ក្នុង បរិវារ វេន របស់ ខ្លួន ប៉ុណ្ណោះ ព្រមទាំង មាន ការកំណត់ ពេលវេលា ជាក់លាក់ សម្រាប់ ដឹកជញ្ជូន ទំនិញ ឲ្យ ទាន់ តាម ពេលវេលា កំណត់ ។
ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន ដឹក កិច្ចប្រជុំ គណៈកម្មាធិការ សកម្មភាព គោល នយោបាយ លើកស្ទួយ សហគ្រាស ធុន តូច និង មធ្យម លើក ទី១
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន គណៈកម្មាធិការ សកម្មភាព គោល នយោបាយ លើកស្ទួយ សហគ្រាស ធុន តូច និង មធ្យម ( គ.ស.ស. ) បាន ដឹកនាំ « កិច្ចប្រជុំ គណៈកម្មាធិការ សកម្មភាព គោល នយោបាយ លើកស្ទួយ សហគ្រាស ធុន តូច និង មធ្យម លើក ទី១ » ។
លោក ផាន់ ផល្លា រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន គណៈកម្មាធិការ គោល នយោបាយ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ( គ.ស. ហ) បាន រាយការណ៍ ជូន អង្គប្រជុំ អំពី លទ្ធផល ស្រាវជ្រាវ ដោយ គូស រំលេច បញ្ហា ប្រឈម ដែល មាន លក្ខណៈ ជា រចនាសម្ព័ន្ធ និង ជា ប្រព័ន្ធ អេកូឡូស៊ី ពិសេស ពាក់ព័ន្ធ នឹង៖
១៖ បន្ទុក អនុលោម ភាព . ការអនុវត្ដ បទប្បញ្ញត្ដិ ដែល នៅ មិន ទាន់ ស៊ី ចង្វាក់ រវាង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ និង ភាព នៅ មាន កម្រិត ក្នុង ការផ្ដល់ សេវា គាំទ្រ ធុរកិច្ច . ២៖ សមត្ថភាព SMEs ក្នុង ការគ្រប់គ្រង បច្ចេកទេស ផលិតកម្ម . ធុរកិច្ច និង ហិរញ្ញវត្ថុ នៅ មាន កម្រិត ទាប និង ៣៖ ការទទួលបាន ហិរញ្ញវត្ថុ នៅ មាន គម្លាត ធំ ។
បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី ក៏ បាន ថ្លែងអំណរគុណ លោក លោកស្រី រដ្ឋមន្រ្តី និង ថ្នាក់ដឹកនាំ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ព្រមទាំង បាន វាយតម្លៃ ខ្ពស់ ដល់ ក្រុមការងារ ដែល បាន ខិតខំ បំពេញ ការងារ ផ្ដល់ ធាតុ ចូល បន្ថែម និង មាន ឆន្ទៈ មុតមាំ ក្នុង ការចូលរួម ដោះស្រាយ បញ្ហា ប្រឈម សម្រាប់ លើកស្ទួយ SMEs នៅ កម្ពុជា ៕ គ្រួសារ ឧត្តមសេនីយ៍ ទោ ស សាវី ដែល ស្លាប់ ដោយ ជំងឺ កូវីដ - ១៩ នៅ ម៉ាលី ទទួលបាន ថវិកា ៥៥០០០ ដុល្លារ ពី សម្តេច តេជោ ហ៊ុន សែន
( កំពង់ស្ពឺ ) ៖ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ គណ: ប្រតិភូ ចូលរួម គោរព វិញ្ញាណក្ខន្ធ សព ឧត្តមសេនីយ៍ ទោ ស សាវី ព្រមទាំង បាន នាំ ថវិកា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ចំនួន ៥ម៉ឺន ៥ពាន់ ដុល្លារ ប្រគល់ ជូន គ្រួសារ សព លោក ឧត្តមសេនីយ៍ ។
ពិធី គោរព វិញ្ញាណក្ខន្ធ របស់ ឧត្តមសេនីយ៍ ទោ ស សាវី ដែល បាន បាត់បង់ជីវិត ក្នុង ពេល បំពេញ បេសកកម្ម មនុស្សធម៌ តាមរយៈ អង្គការ សហ ប្រជាជាតិ នៅ ប្រទេស ម៉ាលី ត្រូវបាន ប្រារព្ធ ជា ផ្លូវការ នៅ វិទ្យាស្ថាន ហ្វឹកហ្វឺន បណ្តុះបណ្តាល កងកម្លាំង រក្សា សន្តិភាព បោស សំអាត មីន និង កាកសំណល់ សង្រ្គាម ក្នុង ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ ។
ក្នុង ពិធី គោរព វិញ្ញាណក្ខន្ធ នា ព្រឹក នេះ ឃេីញ ថា មាន វត្តមាន ប្រតិភូ តំណាង ស្ថាប័ន កំពូល ៗ របស់ ជាតិ តំណាង ស្ថានទូត សេនានុព័ន្ធ និង អនុព័ន្ធ យោធា ដែល កំពុង មាន វត្តមាន នៅក្នុង ប្រទេស កម្ពុជា បាន មក ចូលរួម គោរព វិញ្ញាណក្ខ័ន្ធ និង រំលែក ទុក្ខ ជាមួយ គ្រួសារ សព ផងដែរ ។
សូម បញ្ជាក់ ថា ឧត្តមសេនីយ៍ ទោ ស សាវី អាយុ ៦៣ ឆ្នាំ បាន បាត់បង់ជីវិត កាលពី ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០២០ បន្ទាប់ពី ឆ្លង ជំងឺ កូវីដ - ១៩ នៅ ប្រទេស ម៉ាលី ។ លោក ឧត្តមសេនីយ៍ ទោ មាន ទីលំនៅ ភូមិ ចុង បឹង ឃុំ ម្កាក់ ស្រុក អង្គស្នួល ខេត្ត កណ្តាល ។
រហូតដល់ ពេលនេះ កម្ពុជា មាន កងកម្លាំង ៥កង សរុប ចំនួន ៧៨៧ នាក់ កំពុង បំពេញ បេសកកម្ម រក្សា សន្តិភាព ក្រោម ឆ័ត្រ របស់ អង្គការ សហ ប្រជាជាតិ ក្នុង នោះ មាន លី បង់ . ស៊ូ ដង់ . ស៊ូ ដង់ ខាងត្បូង . ម៉ាលី និង អាហ្វ្រិក កណ្តាល ៕
( ភ្នំពេញ ) ៖ នៅ វេលា ម៉ោង ជិត ១១ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ មាន ករណី អគ្គិភ័យ មួយ កំពុង ឆេះ ផ្ទះ លក់ គ្រឿងសង្ហារឹម មួយ កន្លែង តាម បណ្ដោយ ផ្លូវ ព្រះមុនីវង្ស ស្ថិត នៅ សង្កាត់ បឹងកេងកង ទី១ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ ។
( កំពង់ឆ្នាំង ) ៖ អាង ស្តុក ទឹក ស្អាត មួយ កន្លែង ជា អំណោយ របស់ មិត្ត ចិន តាមរយៈ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ដែល ជា ចំណង ដៃ ដ៏ វិសេសវិសាល របស់ រាជ រដ្ឋាភិបាល ត្រូវបាន ប្រគល់ ឱ្យ ប្រជាពលរដ្ឋ រស់ នៅ ក្នុង ឃុំ ព្រៃ មូល ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង សម្រាប់ ប្រើប្រាស់ ដែល កន្លងមក ក្នុង មូលដ្ឋាន របស់ ពួកគាត់ ពុំ ធ្លាប់ មាន ទឹក ស្អាត ប្រើប្រាស់ នោះ ឡើយ ។
មិន តែ ប៉ុណ្ណោះ ដំណាល គ្នា នេះ ផងដែរ នៅក្នុង ឃុំ ព្រៃ មូល របស់ លោក ក៏ ទទួលបាន ផ្លូវ ក្រាល កៅស៊ូ មួយ ខ្សែ ពី រាជ រដ្ឋាភិបាល ដែល មាន ចម្ងាយ ០៩ គីឡូម៉ែត្រ ឆ្លងកាត់ មូលដ្ឋាន របស់ លោក មក ឡើង ផ្លូវ ជាតិ លេខ ៥៣ ដែល បង្ក ការងាយស្រួល ដល់ ប្រជាពលរដ្ឋ នៅក្នុង ស្រុក រលាប្អៀរ ទាំងមូល ធ្វើដំណើរ ឆ្លងកាត់ ទីនេះ និង ដឹក កសិផល ផ្សេង ៗ តាម ផ្លូវ ជាតិ លេខ ៥៣ ទៅកាន់ រ៉ារ មាស ដើម្បី ដឹក កសិផល នានា តាម រថភ្លើង ទៅកាន់ ខេត្ត ពោធិ៍សាត់ បាត់ដំបង បន្ទាយមានជ័យ ឬ ក្រុង ប៉ោយប៉ែត បាន យ៉ាង ងាយស្រួល និង រហ័ស ទៀតផង ។
ក្នុង នាម លោក ជា អាជ្ញាធរ ឃុំ លោក ក៏ បាន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការអប់រំ ដល់ ប្រជាពលរដ្ឋ នៅ ក្នុង មូលដ្ឋាន ឲ្យ យកចិត្តទុកដាក់ ការពារ កូវីដ - ១៩ និង បាន អប់រំ ដល់ ពួកគាត់ អោយ ត្រូវ ចេះ ថែរក្សា អនាម័យ ដល់ គ្រួសារ នីមួយ ៗ ដោយ អនុវត្ត ទៅ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ត្រូវ ពាក់ ម៉ាស លាង ដៃ នឹង អាកុល ឬ សាប៊ូ ជាប្រចាំ នឹង រក្សា កម្លៀត ពី គ្នា យ៉ាងតិច ឱ្យ បាន ពីរ ម៉ែត្រ ពិសេស ពេល ចូល ទៅក្នុង ទីប្រជុំ ជន ផ្សេង ៗ ត្រូវ ពាក់ ម៉ាស់ ជា ចាំបាច់ ផងដែរ ៕
រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន អនុញ្ញាតឱ្យ សមាគម ឧស្សាហកម្ម ស៊ីម៉ងត៍ កម្ពុជា ចូល សម្តែង ការគួរសម និង សំណេះសំណាល
( ភ្នំពេញ ) ៖ សមាគម ឧស្សាហកម្ម ស៊ីម៉ងតិ៍ កម្ពុជា (CCMA) ដឹកនាំ ដោយ លោក ឧកញ៉ា លាង ម៉េង ប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម នេះ បាន ចូល ជួប សម្តែង ការគួរសម ជាមួយ លោក សាយ សំអាល់ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន នៅ ក្រសួង បរិស្ថាន នា ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
លោក ពុត ចន្តារិទ្ធ អគ្គ លេខាធិការ នៃ សមាគម ឧស្សាហកម្ម ស៊ីម៉ងត៍ កម្ពុជា (CCMA) បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង ថា លោក ឧកញ៉ា លាង ម៉េង បាន ជម្រាប ជូន លោក រដ្ឋមន្រ្តី ថា សមាគម ឧស្សាហកម្ម ស៊ីម៉ងត៍ កម្ពុជា (CCMA) បាន ខិតខំ ស្វែងរក វិធីសាស្រ្ត រក្សា ការងារ ជូន កម្មករ និយោជិក ទោះបី ស្ថិត ក្នុង វិបត្តិ កូវីដ១៩ ក៏ដោយ ហើយ សមាគម បាន ពិនិត្យមើល ស្ថានភាព ទីផ្សារ ដើម្បី បន្ដ រ និរន្តភាព ឧស្សាហកម្ម ស៊ីម៉ងត៍ នៅក្នុង ប្រទេស ផងដែរ ។
លោក រដ្ឋមន្រ្តី បាន ណែនាំ អម ពី សក្កានុពល និង វិសាលភាព នៃ ការអភិវឌ្ឍ លើ វិស័យ ផ្សេង ទៀត ដែល ជា កត្តា នាំឱ្យ មាន ការអភិវឌ្ឍ នៅក្នុង ប្រទេស កម្ពុជា យើង ។ លោក រដ្ឋមន្រ្តី បាន មានប្រសាសន៍ ថា៖ លោក គាំទ្រ សមាគម ឧស្សាហកម្ម ស៊ីម៉ងតិ៍ កម្ពុជា CCMA យ៉ាង ពេញ ទំហឹង ៕
លោក ដូណាល់ ត្រាំ បាន ចុះហត្ថលេខា លើ សេចក្ដីព្រាង ច្បាប់ មួយ ត្រូវបាន អនុម័ត ដោយ សភា អាមេរិក ដើម្បី ដាក់ទណ្ឌកម្ម លើ ធនាគារ ទាំងឡាយ ណា មាន ទំនាក់ទំនង ជាមួយ ក្រុម មន្ត្រី ចិន ដែល បាន ចូលរួម ឬ មាន ជាប់ពាក់ព័ន្ធ នឹង ការដាក់ ឱ្យ អនុវត្ត ច្បាប់ សន្តិសុខ ជាតិ ថ្មី របស់ ទីក្រុង ប៉េកាំង លើ ទីក្រុង ហុងកុង ។ នៅ ចំពោះមុខ អ្នកសារព័ត៌មាន លោក ត្រាំ ក៏ បាន គូសបញ្ជាក់ ឱ្យដឹង ផងដែរ ថា លោក ចុះហត្ថលេខា លើ បទបញ្ជា ប្រតិបត្តិ មួយ ផ្សេង ទៀត សំដៅ ដាក់ទណ្ឌកម្ម ចិន នៅពេល អនាគត ។
ប្រធានាធិបតី អាមេរិក រូប នេះ បាន គូសបញ្ជាក់ ដូច្នេះ ថា « បទបញ្ជា ប្រតិបត្តិ នេះ នឹង បញ្ចប់ ការអនុគ្រោះ ពាណិជ្ជកម្ម ពិសេស សម្រាប់ ទីក្រុង ហុងកុង . គ្មាន ឡើយ សម្បទាន ពិសេស . គ្មាន ទេ ការអនុគ្រោះ សេដ្ឋកិច្ច ពិសេស ហើយក៏ គ្មាន ដែរ ការនាំចេញ បច្ចេកវិទ្យា សំខាន់ ៗ ដែរ ។ ពោលគឺ ចាប់ពី ពេល ឥឡូវត ទៅ ទីក្រុង ហុងកុង នឹង ត្រូវបាន ចាត់ទុក ដូច ទៅនឹង ចិន ដី គោក » ។
ប្រភព ពី មន្ត្រី កងទ័ព ជើងទឹក អាមេរិក បាន ឲ្យដឹង ទៀត ថា មនុស្ស សរុប ៦១ នាក់ បាន ទទួលរង របួស ក្នុង នោះ ៣៨ នាក់ នាក់ ជា នាវិក កងទ័ព ជើងទឹក និង ២៣នាក់ ទៀត ជា ជន ស៊ីវិល ដោយ ភាគ ច្រើន បាន ទទួលរង របួស ដោយសារ ការទទួលរង កម្តៅ និង ផ្សែង ពុល ។ យ៉ាងណា ក៏ដោយ ក្រុម ជំនាញ បាន អះអាង ថា នាវា ដឹក យន្តហោះ ចម្បាំង ខាងលើ នេះ មិន បាន រង ការខូចខាត ធ្ងន់ធ្ងរ ខ្លាំង ឡើយ ព្រោះតែ អគ្គីភ័យ មិន បាន រាល ទៅដល់ កន្លែង ស្តុក ឥន្ធនៈ ។
ក្រសួង បាន ឲ្យដឹង ថា តាមរយៈ នៃ ការប្រែប្រួល ជា បន្តបន្ទាប់ នៃ ស្ថានភាព អាកាសធាតុ សង្កេតឃើញ ថា នៅ ថ្ងៃទី ១៥ - ១៧ ខែកក្កដា ខ្យល់ មូសុង និរតី នឹង បក់ ក្នុង ល្បឿន បង្គួរ មក លើ កម្ពុជា បន្ទាប់មក នៅ ថ្ងៃទី ១៨ - ២១ ខែកក្កដា ខ្យល់ មូសុង និរតី នឹង ចុះខ្សោយ ។ ស្ថានភាព បែប នេះ ធ្វើ ឱ្យ៖
ជាមួយគ្នា នេះ ក្រសួង ធនធាន ទឹក បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ បង្កើន ការប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល នឹង អាច កើតមាន ជា យថាហេតុ ៕
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២០ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន អនុញ្ញាតឱ្យ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា ធ្វើ បទ កិច្ចសម្ភាស ជាមួយ បណ្តាញ សារព័ត៌មាន ស្តីពី « វឌ្ឍនភាព របស់ កាកបាទ ក្រហម កម្ពុជា ឆ្នាំ ២០១៩ - ២០២០ និង ទិសដៅ ការងារ បន្ត » ។
បទសម្ភាស ដែល ប្រព្រឹត្តទៅ នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា បាន ផ្ដោត សំខាន់ លើ ចំណុច មួយចំនួន ដូច ជា៖១៖ សមិទ្ធផល សំខាន់ ៗ របស់ កាកបាទ ក្រហម កម្ពុជា ឆ្នាំ ២០១៩ - ២០២០ ។ ២៖ កាកបាទ ក្រហម កម្ពុជា ក្នុង ការចូលរួម ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ។ ៣៖ ការកៀរគរ រក មូលនិធិ របស់ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ។ ៤៖ ទិសដៅ ការងារ បន្ត ៕
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បន្ត រៀបចំ វេទិកា សាធារណៈ ជាមួយ ប្រជាពលរដ្ឋ ចំនួន ០៤ សង្កាត់ បន្ថែម ទៀត នៅ ខណ្ឌ ដង្កោ
ក្នុង វេទិកា ប្រជាពលរដ្ឋ បាន លើក សំណើ សំណូមពរ ផ្ទាល់ មាត់ និង ជា លាយលក្ខណ៍ អក្សរ សរុប ចំនួន ១៥៖១. វិស័យ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង ភូមិបាល ចំនួន ០២ សំណើ ។២. វិស័យ ទឹក ស្អាត ចំនួន ០២ សំណើ ។៣. វិស័យ សាធារណការ ដឹកជញ្ជូន អនាម័យ បរិស្ថាន ចំនួន ០៦ សំណើ ។៤. វិស័យ អប រំ ចំនួន ០១សំណើ ។ ៥. វិស័យ អគ្គិសនី ចំនួន ០២ សំណើ ។៦. សេវា សាធារណៈ ០១សំណើ ។ ៧. វិស័យ បរិស្ថាន ចំនួន ០១សំណើ
ក្នុង ឱកាស បើក វេទិកា នោះ ផងដែរ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស៊្រាង បាន នាំយក នូវ អាហារ សម្រន់ មាន នំប៉ាវ ទឹកក្រូច ទឹក សុទ្ធ ចែកជូន ដល់ សមាជិក ចូលរួម ទាំងអស់ បរិភោគ រួមគ្នា ក្រោម បរិយាកាស រីករាយ និង ស្និទ្ធស្នាល និង បាន ធ្វើ ការឆ្លើយ បំភ្លឺ បកស្រាយ ពី លទ្ធភាព ដំណោះស្រាយ ជាក់ស្តែង តាម សំណើ និមួយ ៗ របស់ ប្រជាពលរដ្ឋ ដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ។
បន្ទាប់ពី បញ្ចប់ វេទិកា សាធារណៈ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង និង ក្រុមការងារ ក៏ បាន នាំយក ទេយ្យ វត្ថុ រួម មាន ថវិកា ចំនួន ០១ លាន រៀល ទៀន ធំ ០១គូ ទឹក សុទ្ធ និង ទឹកក្រូច ( មូតាន់ ) ២០កេស អង្ករ ០៦ ការ៉ុង និង មី ០៦ កេស ប្រគេន ដល់ ព្រះចៅ អធិការ វត្ត សាក់ សំពៅ ព្រមទាំង បាន ឧបត្ថម្ភ ថវិកា ដល់ កម្លាំង ការពារ សណ្តាប់ធ្នាប់ និង ក្រុមការងារ យុវជន ដែល បាន ចូលរួម នៅ ពេល នោះ ផងដែរ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី ១៤ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
( បរទេស ) ៖ មីស៉ីល គឺជា ប្រភេទ សព្វាវុធ មួយ ដែល គេ ប្រើប្រាស់ សម្រាប់ ការវាយប្រហារ ពី ចម្ងាយ ដោយ វា អាច ហោះ បាន ដោយ ខ្លួន ឯង ។ សព្វ ថ្ងៃ នេះ វា មាន ទម្រង់ ជាច្រើន ប្រភេទ រួម មាន ចាប់តាំងពី មី ស៉ីល ធម្មតា ៗ រហូតដល់ មីស៉ីល ផ្លោង ដែល អាច បំពាក់ ក្បាល គ្រាប់ នុយក្លេអ៊ែរ និង ហោះ ឆ្លង ទ្វីប ។
មីស៉ីល ដំបូង ៗ បំផុត ដែល ត្រូវបាន ប្រើប្រាស់ ក្នុង ប្រតិបត្តិការ គឺ ពពួក មី ស៉ីល ដែល អភិវឌ្ឍ ឡើង ដោយ យោធា អាល្លឺម៉ង់ កាលពី សង្រ្គាម លោក លើក ទី ពីរ ។ ក្នុង ចំណោម នោះ មី ស៉ីល ដែល គេ ស្គាល់ ច្រើន គឺ មីស៉ីល V-1 និង V-2 ។ យ៉ាងណាមិញ មី ស៉ីល ជំនាន់ ដំបូង ៗ ដែល ត្រូវបាន ប្រើប្រាស់ នៅក្នុង សម័យ នោះ គឺ ត្រូវបាន ផលិត ឡើង ក្នុង ចំនួន តិចតួច តែ ប៉ុណ្ណោះ ហើយ មិន សូវ មាន ប្រសិទ្ធភាព ខ្ពស់ ប៉ុន្មាន ទេ ។
បច្ចុប្បន្ន មី ស៉ីល មាន សមាសធាតុ ផ្សំ សំខាន់ ៗ ដូចជា ប្រព័ន្ធ នាំផ្លូវ ប្រព័ន្ធ ហោះហើរ ម៉ាស៉ីន និង ក្បាល គ្រាប់ ។ ប្រព័ន្ធ នាំផ្លូវ គឺ មាន សារសំខាន់ ជាខ្លាំង សម្រាប់ មីស៉ីល ។ មីស៉ីល ខ្លះ អាច បំពាក់ នូវ ឧបករណ៍ ស្ទាបស្ទង់ ប្រភេទ អ៉ីន វ៉្រា រេដ (Infrared) ដើម្បី ដេញ តាម ចំហាយ កម្តៅ ដែល ភាយ ចេញ ពី ម៉ាស៉ីន យន្តហោះ ចំណែក មីស៉ីល ខ្លះ ទៀត ត្រូវបាន នាំផ្លូវ ទៅកាន់ គោលដៅ វាយប្រហារ របស់ វា តាមរយៈ ការចង្អុល ឡាស៊ែរ ពីសំណាក់ កងទ័ព ថ្មើរជើង នៅក្បែរ គោលដៅ ផ្ទាល់ ជាដើម ។
មន្ត្រី ជំនាញ ខេត្ត ត្បូងឃ្មុំ សហការ គ្នា ពិនិត្យ គុណភាព ទំនិញ តាម ច្រក ទ្វារ ព្រំដែន រកឃើញ និង ដកហូត បន្លែ ០៦ មុខ នាំចូល ពី ប្រទេស វៀតណាម ផ្ទុក សារធាតុ គីមី
( ត្បូងឃ្មុំ ) ៖ គំរូ បន្លែ ចំនួន ០៦មុខ មាន ខ្ទឹម បារាំង ខ្ទឹម ក្រហម ខ្ទឹម ស ស្ពៃ បូក គោ ក្រូចឆ្មារ និង ការ៉ុត ត្រូវបាន មន្ត្រី ក . ប. ប ខេត្ត ត្បូងឃ្មុំ រួមទាំង រថយន្ត ពិសោធន៍ ចល័ត សហការ ជាមួយ មន្ត្រី គយ ខេត្ត និង មន្ត្រី នៅ ច្រកទ្វារ ព្រំដែន ខេត្ត ត្បូងឃ្មុំ រកឃើញ មាន ផ្ទុក សារធាតុ គីមី និង ចាត់ វិធានការ ភ្លាម ៗ ។
លោក មាស មោរ៉ា បញ្ជាក់ ថា ជា វិធានការ មន្ត្រី ជំនាញ នៃ សាខា ក .ប. ប ខេត្ត បាន ផ្តល់ វិធានការ អោយ ការិយាល័យ គយ និង រដ្ឋាករ ព្រំដែន បញ្ជូន បន្លែ ដែល មាន ផ្ទុក សំណល់ ថ្នាំ ពុល កសិកម្ម ត្រឡប់ ទៅ ប្រទេស ដើម វិញ ហើយ ក្នុង ករណី មាន ការនាំចូល ប្រភេទ បន្លែ ០៦ មុខ ខាងលើ លើក ក្រោយ ទាមទារ អោយ អាជីវករ នាំចូល បង្ហាញ វិញ្ញាបនបត្រ បញ្ជាក់ ថា គ្មាន សំណល់ ថ្នាំ ពុល កសិកម្ម ពី មន្ត្រី មាន សមត្ថកិច្ច របស់ ប្រទេស នាំចេញ បើ មិន មាន ទេ ដាច់ខាត មិន អោយ នាំចូល នោះ ឡើយ ។
ជាមួយគ្នា នេះ មន្ត្រី ជំនាញ បាន អំពាវនាវ ដល់ អាជីវករ នាំចូល បន្លែ ផ្លែ ឈើ និង ម្ហូប អាហារ តាម ច្រក ទ្វារ ព្រំដែន ពី ប្រទេស ជិតខាង ចូល កម្ពុជា ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន និង យកចិត្តទុកដាក់ ខ្ពស់ ពោលគឺ ត្រូវ នាំចូល ចែកចាយ និង លក់ តែ ទំនិញ ជា ផលិតផល ម្ហូប អាហារ ណា ដែល មាន គុណភាព ល្អ ជាពិសេស ហាម ដាច់ខាត មាន ផ្ទុក នូវ សារធាតុ គីមី ហាមឃាត់ និង ហួស កាលបរិច្ឆេត ដែល បណ្តាលឲ្យ ប៉ះពាល់ ដល់ សុខុមាលភាព អ្នកប្រើប្រាស់ និង ត្រូវ ទទួលទោស តាម ផ្លូវ ច្បាប់ ៕
( ភ្នំពេញ ) ៖ ជា ម្តង ហើយ ម្តង ទៀត សម្តេច នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន បង្ហាញ ពី សមត្ថភាព ពិសេស ៗ របស់ ខ្លួន ក្នុង ការគ្រប់គ្រង ចាត់ចែង និង ដឹកនាំ ប្រទេស ក្នុង កាលៈទេសៈ ដ៏ លំបាក ណាមួយ ដែល បាន កើតឡើង ។ ជាក់ស្តែង ក្នុង ដំណាក់កាល កូវីដ - ១៩ នេះ មេដឹកនាំ របស់ កម្ពុជា ដ៏ មាន បទពិសោធន៍ រូប នេះ បាន បញ្ចេញ ទេពកោសល្យ ដ៏ ប៉ិនប្រសប់ ជា បន្តបន្ទាប់ ។
ក្រៅពី បញ្ចៀស ការឆ្លង រីករាលដាល នៃ កូវីដ - ១៩ ក្នុង សហគមន៍ និង បញ្ចៀស មិន ឲ្យ មាន ណា ម្នាក់ ស្លាប់ ដោយសារ កូវីដ - ១៩ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បង្ហាញ ទេពកោសល្យ ពិសេស របស់ ខ្លួន ក្នុង ការដោះស្រាយ បញ្ហា សេដ្ឋកិច្ច ជាតិ និង ប្រជាជន ដើម្បី កុំ ឲ្យ រង ផល ប៉ះពាល់ ខ្លាំង ពី វិបត្តិ សាកល មួយ នេះ ថែម ទៀត ។
ក្រោយពី ការបង្ហាញ ផ្លូវ ចង្អុល ទិស ពីសំណាក់ មេ កម្ពុជា ដឹកនាំ ប្រជាពលរដ្ឋ ខ្មែរ ជាច្រើន ក៏ បាន ងាក ទៅ រក វិស័យ ចិញ្ចឹម សត្វ វារី វប្បកម្ម និង ដំណាំ បន្លែ គ្រប់ ប្រភេទ ។ ដោយ យល់ឃើញ ថា ពលរដ្ឋ កំពុង មាន ការចាប់អារម្មណ៍ ខ្លាំង ឡើង ៗ សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ បាន ចុះ ជំរុញ វិស័យ កសិកម្ម ដោយ ផ្ទាល់ ជាមួយ កសិករ ដោយ ផ្តើម ពី ការជំរុញ វិស័យ វារី វប្បកម្ម ក្នុង ខេត្ត ព្រៃវែង កាលពី ព្រឹក ថ្ងៃទី ១៤ កក្កដា នេះ ។
ដើម្បី ជំរុញ វិស័យ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ចុះ ទៅ ជួប ជាមួយ កសិករ អ្នក ចិញ្ចឹម ត្រី និង ចិញ្ចឹម កង្កែប ដោយ ផ្ទាល់ ដើម្បី ស្វែងយល់ ពី បញ្ហា របស់ ពួកគេ មុននឹង ដាក់ ចេញ ជា ដំណោះ ស្រាយ ឲ្យ ចំ គោលដៅ ។ នេះ គឺជា ភាពឆ្លាតវៃ របស់ មេដឹកនាំ ដែល មិន រង់ចាំ ស្តាប់ តែ របាយការណ៍ ឡើយ ប៉ុន្តែ ត្រូវ ចុះ ជួប ផ្ទាល់ ជាមួយ ពលរដ្ឋ ដើម្បី យល់ ឲ្យបាន ច្បាស់ ពី បញ្ហា របស់ ពួកគេ ទើប ការ ដាក់ចេញដំណោះស្រាយ មាន ប្រសិទ្ធភាព ដូច ដែល សម្តេច ធ្លាប់ បាន ធ្វើជា យូរ មកហើយ ។
ថ្ងៃទី ២១ កក្កដា ខាងមុខ នេះ សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ គ្រោង នឹង ចុះ ទៅ ស្រុក ព្រៃ កប្បាស នៃ ខេត្ត តាកែវ ដើម្បី ច្រូត ស្រូវ ស្រាល ផង និង ជាពិសេស បន្ត ជំរុញ ការដាំដុះ ស្រូវ និង ដំណាំ កសិកម្ម ផ្សេង ទៀត ។ វត្តមាន របស់ មេដឹកនាំ កំពូល ជាមួយ កសិករ នា ពេលនេះ ពិតជា បាន បង្ហាញ ថា យុទ្ធនាការ ជំរុញ វិស័យ កសិកម្ម ក្នុង បរិបទ កូវីដ១៩ បាន ចាប់ផ្តើម ហើយ ។ យុទ្ធនាការ នេះ នឹង ក្លាយជា ចលករ ដ៏ មាន ថាមពល ក្នុង ការដោះស្រាយ បញ្ហា ចំពោះ មុខ ផង និង បញ្ហា យូរអង្វែង ផង សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងមូល ។
អ្វី ជា ការកត់សម្គាល់ មុន ឈានដល់ យុទ្ធនាការ នេះ សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ បាន ចង្អុល ទិស ប្រាប់ មុន រួច ជាស្រេច ដើម្បីឲ្យ ពលរដ្ឋ ចាប់អារម្មណ៍ លើ វិស័យ កសិកម្ម ក៏ ដូចជា ការផ្ញើ សារ ដល់ មន្ត្រី ថ្នាក់ ក្រោម ឲ្យ ត្រៀម លក្ខណៈ ជាស្រេច ដើម្បី ដោះស្រាយ បញ្ហា ចំពោះ មុខ ដោយ ផ្តោត លើ វិស័យ កសិកម្ម ។ ការដឹកនាំ ដែល តែងតែ គ្រោង ទុក ជាមុន និង មាន ផែនការ យុទ្ធសាស្ត្រ ត្រឹមត្រូវ ចំ ទិសដៅ និង ទាន់ សភាពការណ៍ នេះ ហើយ គឺជា ចំណុច ខ្លាំង របស់ សម្តេច តេជោ ហ៊ុន សែន ជាពិសេស គឺ ការ ប្រែក្លាយ បញ្ហា ឲ្យ ទៅជា ឱកាស ។
ជា ការពិត ចាប់តាំងពី វិបត្តិ កូវីដ១៩ ផ្ទុះឡើង ភ្លាម សម្តេច នាយក រដ្ឋមន្ត្រី រូប នេះ ហាក់ ក្តាប់ បាន សភាពការណ៍ យ៉ាង ណែន ក្នុង ដៃ ហើយ ដោះស្រាយ តាម ដំណាក់កាល នីមួយ ៗ ដោយ មិន តក់ស្លុត មិន តក់ ក្រហល់ ស្រប តាម ការវិវត្តន៍ របស់ កូវីដ ១៩ ដោយ រលូន ។ ភាពឈ្លាសវៃ នេះ ហើយ ដែល រហូតមកដល់ ពេលនេះ កម្ពុជា អាច បញ្ចៀស បាន ទាំង ការឆ្លង រាលដាល ទាំង ការស្លាប់ បាត់បង់ជីវិត មនុស្ស និង ទាំង ការរងគ្រោះ ធ្ងន់ធ្ងរ ផ្នែក សេដ្ឋកិច្ច ។
តើ មាន មេដឹកនាំ ពិភពលោក ប៉ុន្មាន នាក់ ដែល អាច ទប់ទល់ បាន បែប នេះ ? ចម្លើយតប នឹង សំណួរ នេះ គឺជា ទឡ្ហីករណ៍ ដែល បញ្ជាក់ បាន ពី « ទេពកោសល្យ និង សមត្ថភាព ពិសេស របស់ សម្តេច តេជោ ហ៊ុន សែន »៕
ក្រោយ ទទួលបាន កញ្ចប់ ថវិកា ឧបត្ថម្ភ នេះ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ជាន់ ខ្ពស់ រវាង ស្ថាប័ន ពាក់ព័ន្ធ នៃ រាជ រដ្ឋាភិបាល និង អង្គការ សហ ប្រជាជាតិ ប្រចាំ នៅ កម្ពុជា ស្ដីពី កម្មវិធី រួមគ្នា ដើម្បី គាំទ្រ ជន ទេសន្តរប្រវេសន៍ ដែល វិលត្រឡប់ ក្នុង ស្ថានភាព នៃ ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ និង ផល ប៉ះពាល់ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន គូសបញ្ជាក់ ថា កិច្ចប្រជុំ នេះ គឺ ផ្ដោត សំខាន់ លើ ការបែងចែក ធ្វើ យ៉ាងណា ប្រើប្រាស់ ថវិកា នេះ ឲ្យបាន ត្រឹមត្រូវ និង តម្លាភាព បាន ដល់ មុខ សញ្ញា ដែល ជា ពលករ ចំណាកស្រុក ក្រោយ ត្រឡប់មក កំណើត វិញ ហើយ បាន ជួប បញ្ហា ជីវភាព អំឡុង ពេល ការផ្ទុះ រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ជា សកល នេះ ។
បើ តាម លើកឡើង របស់ សម្ដេច ក្រឡហោម ស ខេង . ខេត្ត តែ៣ ប៉ុណ្ណោះ ដែល ជា អាទិភាព ក្នុង ការប្រើប្រាស់ នូវ កញ្ចប់ ថវិកា នេះ ដើម្បី ឧបត្ថម្ភ ដល់ ពលករ ទេសន្ដរប្រវេសន៍ រួម មាន ខេត្ត បន្ទាយមានជ័យ . បាត់ដំបង និង ខេត្ត សៀមរាប ។ ក្នុង ខេត្ត ទាំង៣ នេះ ទៀតសោត រាជ រដ្ឋាភិបាល នឹង ជ្រើសរើស ស្រុក គោលដៅ មួយចំនួន ទៀត តាម លទ្ធភាព ជាក់ស្ដែង ។
សម្ដេច ក្រឡាហោម ស ខេង បាន បង្ហាញ នូវ ជំនឿ ជឿជាក់ ថា ប្រសិនបើ អនុវត្ត កម្មវិធី នេះ បាន ល្អ ក្នុង រយៈពេល សាកល្បង ៦ខែ កម្ពុជា នឹង ទទួលបាន នូវ កញ្ចប់ ថវិកា ឧបត្ថម្ភ បន្ថែម ទៀត ពី អង្គការ សហ ប្រជាជាតិ ។ ប៉ុន្ដែ ក្នុង កិច្ចប្រជុំ សម្ដេច បាន សង្កត់ធ្ងន់ ឲ្យ ក្រុមការងារ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត ការងារ នេះ ពោល ត្រូវ យក ទៅ ប្រើប្រាស់ ឲ្យ ចំ គោលដៅ និង មាន តម្លាភាព ។
បន្ថែម ពី នេះ សម្ដេច ក្រឡាហោម ស ខេង បាន ថ្លែងអំណរគុណ ដល់ អង្គការ សហ ប្រជាជាតិ ដែល បាន អនុម័ត សំណើ គម្រោង ដ៏ មាន សារៈសំខាន់ នេះ ជាមួយនឹង កញ្ចប់ ថវិកា ១លាន ដុល្លារ សហរដ្ឋ អាមេរិក ដើម្បី អនុវត្ត កម្មវិធី រួមគ្នា មួយ ដែល នឹង សហការ អនុវត្ត ដោយ ក្រុម ទីភ្នាក់ងារ នៃ អង្គការ សហ ប្រជាជាតិ និង រាជ រដ្ឋាភិបាល ក្នុង គោលបំណង ការពារ ពលករ ទេសន្ដរប្រវេសន៍ ដែល ធ្វើ មាតុភូមិ និវត្តន៍ និង សហគមន៍ ។
ដើម្បី អនុវត្ត គម្រោង នេះ ឲ្យ មាន ប្រសិទ្ធភាព សម្ដេច ក្រឡាហោម ស ខេង បាន ដាក់ចេញ នូវ អនុសាសន៍ មួយចំនួន រួម មាន៖
* រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ត្រូវ គ្រប់គ្រង ឲ្យបាន ល្អ នូវ សន្ដិសុខ សណ្ដាប់ធ្នាប់ ចលនា របស់ ជន ទេសន្ដរប្រវេសន៍ និង ផ្ដល់ សេវា សាធារណៈ នានា ឲ្យ មាន ភាព ឆ្លើយតប និង បាន ទាន់ ពេលវេលា ក៏ ដូចជា សម្របសម្រួល ការចូលរួម របស់ ដៃគូ ក្នុង ការផ្សព្វផ្សាយ និង លើកកម្ពស់ ជីវភាព របស់ ប្រជាពលរដ្ឋ
* ស្នើ ទីភ្នាក់ងារ អង្គការ សហ ប្រជាជាតិ ប្រចាំ កម្ពុជា សម្របសម្រួល ជាមួយ ទីភ្នាក់ងារ អង្គការ សហ ប្រជាជាតិ ជាមួយ ប្រទេស ប្រចាំ នានា ក្នុង តំបន់ ដើម្បី រក ដំណោះស្រាយ ក្នុង ការគ្រប់គ្រង លំហូ ឆ្លងកាត់ ព្រំដែន នូវ ពលករ ទេសន្ដរប្រវេសន៍ រវាង ប្រទេស បញ្ជូន និង ប្រទេស ទទួល
* ក្រសួង ផែនការ និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ គប្បី ខិតខំ ធ្វើ បច្ចុប្បន្នភាព ជន ក្រីក្រ ពិតប្រាកដ ពិសេស ជន ទេសន្ដរប្រវេសន៍ ដែល បាន ត្រឡប់ ពី ប្រទេស ជិតខាង ដើម្បី ទទួល ផល ពី កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ដល់ គ្រួសារ ក្រីក្រ និង កិច្ច គាំពារ ផ្នែក សេដ្ឋកិច្ច ផ្សេង ៗ ទៀត របស់ រាជ រដ្ឋាភិបាល
* ក្រសួង ស្ថាប័ន និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ពាក់ព័ន្ធ ត្រូវ យកចិត្ដទុកដាក់ លើសន្ដិសុខ ស្បៀង អាហារូបត្ថម្ភ របស់ ប្រជាពលរដ្ឋ
* ទីភ្នាក់ងារ នៃ អង្គការ សហ ប្រជាជាតិ ប្រចាំ កម្ពុជា និង ក្រុមការងារ បច្ចេកទេស សម្រាប់ សហការ ជាមួយ ដៃគូ អភិវឌ្ឍន៍ និង អង្គការ សង្គម ស៉ី វិល ដើម្បី សម្របសម្រួល និង គៀង គរ ធនធាន សម្រាប់ ដោះស្រាយ ផល ប៉ះពាល់ ដោយសារ កូវីដ - ១៩ ។
( ស្វាយរៀង ) ៖ លោក សរ សុដានី អភិបាល រង ក្រុង ស្វាយរៀង បាន ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ថា ចំពោះ ការរៀបចំ សណ្តាប់ធ្នាប់ នៅ ផ្សារ វាល យន្ត ក្រុង ស្វាយរៀង អាជ្ញាធរ បាន ធ្វើជាញឹកញាប់ ណាស់ មកហើយ ប៉ុន្តែ ក្រុម អាជីវករ មិន សូវ សហការ ជាមួយ អាជ្ញាធរ សោះ ដូច្នេះ ក្នុង នាម អាជ្ញាធរ នឹង ចាប់ផ្តើម ប្រើ ធម៌ ក្តៅ ចំពោះ អាជីវករ ទាំងឡាយ ណា នៅតែ បំពាន យក ផ្លូវ សាធារណៈ ធ្វើជា កន្លែង លក់ដូរ ។
លោក សរ សុដានី បាន បញ្ជាក់ យ៉ាង ដូចនេះ បន្ទាប់ពី ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ មក ផ្សារ វាយន្ត ខេត្ត ស្វាយរៀង ដើម្បី ទិញ ម្ហូប អាហារ មាន ការរអ៊ូរទាំ ចំពោះ ក្រុម អាជីវករ មួយចំនួន ដែល យក ចិញ្ចើមផ្លូវ ធ្វើជា កន្លែង លក់ដូរ គ្មាន សណ្ដាប់ធ្នាប់ នាំឲ្យ កកស្ទះ ចរាចរណ៍ នៅ ចំណុច ផ្លូវ ខាងលិច ផ្សារ ។
លោក សរ សុដានី បាន បន្ត ថា រដ្ឋបាល ក្រុង ស្វាយរៀង ក៏ បាន អំពាវនាវ ដល់ បងប្អូន អាជីវករ ទាំងអស់ សូម ចូលរួម អនុវត្ត តាម សេចក្ដីណែនាំ របស់ រដ្ឋបាល សាលាក្រុង ដើម្បីឱ្យ មាន របៀបរៀបរយ និង សោភ័ណ្ឌភាព ផ្សារ និង ក្រុង ស្វាយរៀង ទាំងអស់ គ្នា ផងដែរ ។
លោក បាន បន្ថែម ថា ក្នុង ករណី ដែល បងប្អូន ប្រជាពលរដ្ឋ និង អាជីវក មិន ចូលរួម អនុវត្ត តាម ខ្លឹមសារ ណែនាំ នេះ សមត្ថកិច្ច ព្រមទាំង អាជ្ញាធរ ពាក់ព័ន្ធ នឹង ចាត់ វិធានការរុះរើ យក សម្ភារៈ និង ទំនិញ ផ្សេង ៗ ចេញ ពី ទីតាំង ដែល បាន កំណត់ និង មិន ទទួលខុសត្រូវ រាល់ ការខូចខាត និង ការបាត់បង់ អ្វី ឡើយ ៕
ថៃ កោតសរសើរ កម្ពុជា ក្នុង ការទប់ស្កាត់ និង ដាក់ ចេញ វិធានការ ការពារ ជំងឺ កូវីដ១៩ បាន ទាន់ ពេលវេលា
ការថ្លែង បែប នេះ របស់ ឯក អគ្គ រាជ ទូត ថៃ ប្រចាំ កម្ពុជា ក្នុង ឱកាស ចូល ជួប សម្ដែង ការគួរសម និង ស្វែងយល់ នីតិវិធី និង វិធានការកាពារ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ជាមួយ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង នៅ ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០នេះ នាទី ស្ដីការ ក្រសួង សុខាភិបាល ។
ក្នុង ឱកាស នោះ ឯក អគ្គ រាជ ទូត ថៃ ប្រចាំ កម្ពុជា បាន មក ស្វែងយល់ ពី នីតិវិធី សម្រាប់ អ្នកដំណើរ ពី ក្រៅ ប្រទេស ចូលមក កម្ពុជា ក្នុង ស្ថានភាព ជំងឺ កូវីដ១៩ ដើម្បី មាន ភាពងាយស្រួល សម្រាប់ ក្រុម វិនិយោគ របស់ ប្រទេស ខ្លួន ប្រមាណ ជិត ៦០ នាក់ ដែល ត្រូវ ត្រលប់មក កម្ពុជា ដើម្បី រៀបចំ អាជីវកម្ម របស់ ខ្លួន ឡើងវិញ ។
ជា ការឆ្លើយតប រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន ឱ្យដឹង ថា « កម្ពុជា នៅតែ ប្រកាន់ យក ស្ដង់ដារ អនុវត្ដ ដែល បាន ដាក់ ចេញ ជា គោល ដើម្បី ធានា ថា មិន មាន ករណី វិជ្ជមាន ជំងឺ កូវីដ១៩ មួយ ណា មិន បាន ឆ្លងកាត់ ការធ្វើតេស្ដ របស់ យើង នោះ ទេ ។ ប៉ុន្ដែ យើង នឹង ជួយ សម្រួល និង ពន្លឿន ការងារ ធ្វើតេស្ដ និង លទ្ធផល តេស្ដ ជូន ជាពិសេស ដល់ អ្នក វិនិយោគ ចូល កម្ពុជា » ។
រដ្ឋមន្ដ្រី ថ្លែង បន្ដ ថា ជំងឺ កូវីដ១៩ អាច ឆ្លង ទៅ លើ មនុស្ស គ្រប់ គ្នា ដោយ មិន ប្រកាន់ ទៅ លើ អ្នកណា ម្នាក់ នោះ ទេ ឱ្យ តែ ធ្វេសប្រហែស គឺ នឹង មាន ករណី ឆ្លង ពី មនុស្ស ម្នាក់ ទៅ ម្នាក់ ដូច្នេះ យើង ត្រូវតែ អនុវត្ដ ឱ្យ បាន នូវ វិធានការ ការពារ ទប់ស្កាត់ និង ប្រុងប្រយ័ត្ន បំផុត ចាំបាច់ ត្រូវតែ អនុវត្ដ វិធានការ នេះ មិន អាច ខាត បាន ។
លើស ពី នោះ លោក ឯក អគ្គ រាជ ទូត ថៃ រូប នេះ បាន ថ្លែង ទៅកាន់ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល ថា សម្រាប់ កម្ពុជា ៣ខែ ទៅ មុខ ទៀត វាយតម្លៃ និង ធ្វើ ការរំពឹងទុក បែប ណា ចំពោះ ស្ថានភាព ជំងឺ កូវីដ នេះ ។
ជា ការឆ្លើយតប រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា លុះត្រាតែ រកឃើញ វ៉ាក់សាំង ឬ ថ្នាំ ដែល មាន ប្រសិទ្ធិភាព ក្នុង ការព្យាបាល ជំងឺ កូវីដ១៩ ជាពិសេស ទាល់តែ ប្រទេស នៅលើ សកលលោក អាច ព្យាបាល ជា ឬ ធូរស្បើយ ពី ជំងឺ នេះ ទើប នៅ កម្ពុជា នឹង បាន ធូរស្រាល ដែរ ដោយ កន្លងមក ករណី ជំងឺ កូវីដ១៩ នៅ កម្ពុជា សុទ្ធតែ ជា ករណី នាំចូល ។
ដូច្នេះ បើ នៅ តាម បណ្ដាល ប្រទេស នៅតែ បន្ដ រាតត្បាត យ៉ាង សាហាវ នៃ ជំងឺ នេះ កម្ពុជា ក៏ មិន ទាន់ អាច សន្និដ្ឋាន ថា បាន ដែរ ព្រោះ ជំងឺ កូវីដ នេះ មិន អាច ស្មាន ទុក ជាមុន បាន នោះ ឡើយ តែ យើង ទាំងអស់ គ្នា នៅតែ បន្ដ ខិតខំ ប្រឹងប្រែង អស់ ពី លទ្ធភាព ក្នុង ការការពារ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ នេះ ដោយ មិន រុញ រាន ឡើយ ។សង្ឃឹម ថា បងប្អូន ប្រជាពលរដ្ឋ យើង នឹង សហការ គ្នា ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ នេះ ៕
សាលាឧទ្ធរណ៍ សម្រេច ឲ្យ ជនជាប់ចោទ ឧកញ៉ា ហូរ ចំរើន ជាប់ ពន្ធនាគារ បន្ត ទៅ ទៀត
( ភ្នំពេញ ) ៖ ឧកញ៉ា ហូរ ចំរើន មាន សំណុំរឿង គេ ប្ដឹង ជាច្រើន នៅ សាលាដំបូង រាជធានី ភ្នំពេញ នោះ ត្រូវ សភា ស៊ើបសួរ នៃ សាលាឧទ្ធរណ៍ បដិសេធ បណ្ដឹង សុំ នៅ ក្រៅ ឃុំ ពោលគឺ សម្រេច ឲ្យ បន្ត ជាប់ ពន្ធនាគារ ដដែល ដូច ដែល សាលាដំបូង រាជធានី ភ្នំពេញ សម្រេច យ៉ាង ដូច្នេះ ។
ការសម្រេច មិន អនុញ្ញាតឲ្យ ជនជាប់ចោទ រូប នេះ នៅ ក្រៅ ឃុំ ជា បណ្ដោះអាសន្ន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ ដោយ មាន លោក លាង សំណាត់ ជា ប្រធាន ក្រុមប្រឹក្សា ជំនុំជម្រះ និង មាន លោក ង៉ែត សារ៉ាត់ ជា តំណាង មហា អយ្យការ ។
សូម ជម្រាប ជូន ថា ជន ជាប់ចោទ ហូរ ចំរើន តែងតែ ត្រូវ មន្ត្រី ពន្ធនាគារ នាំ ខ្លួន ទៅ តុលាការ ដោយ ប្រើ រថយន្ដ ទំនើប ផ្ទាល់ខ្លួន ក្នុង សម្លៀកបំពាក់ ដាក់ ក្នុង ខោ ( ទ្រនុយ ) ដោយ មាន អាវធំ ពាក់ ពី ខាងលើ ស្បែកជើង ប៊ូរ លើបរលោង យ៉ាង សង្ហា ។
មន្ត្រី ពន្ធនាគារ ព្រៃស បាន បង្ហើប ថា ជន ជាប់ចោទ ហូរ ចំរើន បាន សុំ ប្តូរ ពី ពន្ធនាការ ព្រៃ ស ទៅ ពន្ធនាគារ រាជធានី ភ្នំពេញ (PJ) វិញ ប៉ុន្ដែ ជាក់ស្ដែង ជនជាប់ចោទ បច្ចុប្បន្ន កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ រុស្ស៊ី ។
សូម ជម្រាប ថា ឧកញ៉ា ហូរ ចំរើន កំពុង ជាប់ បណ្តឹង ឆបោក ប្រាក់ ចំនួន ៣ករណី ក្នុង ទំហំ ទឹកប្រាក់ ប្រមាណ ជា ២០០ លាន ដុល្លារ ដែល ពាក់ព័ន្ធ គម្រោង វិនិយោគ កសាង មន្ទីរពេទ្យ សាលារៀន នៅក្នុង ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល របស់ ក្រុមហ៊ុន ចិន ដែល មាន បុរស ជនជាតិ ចិន ឈ្មោះ ហាន់ គឿក ជាដើម បណ្ដឹង ។ ឧកញ៉ា ហូរ ចំរើន ធ្លាប់ ត្រូវបាន តុលាការ ផ្តន្ទាទោស ដាក់ គុក ១៨ ខែ ព្រោះ រឿង បាញ់ គំរាម សម្លាប់ ប្រពន្ធ ។
អតីត មន្រ្តី យោធា រូប នេះ ត្រូវបាន នគរបាល ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ នាយកដ្ឋាន ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ ឃាត់ខ្លួន កាលពី រសៀល ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០១៨ ពាក់ព័ន្ធ ករណី បាញ់ បោះ ជិត ១០គ្រាប់ គំរាម លោក ផ្កាយ២ យិន គា ដែល ជា ប៉ា ក្មេក ផ្អើល សមត្ថកិច្ច មូលដ្ឋាន កាលពី ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០១៨ នៅ ចំណុច ផ្ទះ វីឡា មួយ កន្លែង ស្ថិត នៅ ភូមិ ព្រៃ ស សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ៕
ទីតាំង ខារ៉ាអូខេ នៅ ខណ្ឌ ឬស្សីកែវ ត្រូវ អាជ្ញាធរ ណែនាំឲ្យ ប្រែក្លាយជា ភោជនីយដ្ឋាន តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល ដើម្បី ចូលរួម ទប់ស្កាត់ COVID-19
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ឫស្សីកែវ បញ្ជា ឲ្យ ក្រុមការងារ ចុះ ត្រួតពិនិត្យ ជាក់ស្ដែង លើ ទីតាំង ខារ៉ាអូខេ (KTV) ជា បន្តបន្ទាប់ ចំនួន ៤ទីតាំង ផ្សេង ៗ គ្នា ដែល ត្រូវ ប្រែក្លាយទៅ ជា ភោជនីយដ្ឋាន តាម ការណែនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រសួង សុខាភិបាល និង រដ្ឋបាល រាជធាន ភ្នំពេញ ដើម្បី ចូលរួម ទប់ស្កាត់ COVID-19 ។
សកម្មភាព ចុះ ត្រួតពិនិត្យ ជាក់ស្ដែង លើ ទីតាំង ខារ៉ាអូខេ (KTV) ដែល ត្រូវ ប្រែក្លាយទៅជា ភោជនីយដ្ឋាន ចំនួន ៤ទីតាំង ផ្សេង ៗ គ្នា របស់ ក្រុមការងារ នៃ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ នេះ ដឹកនាំ ផ្ទាល់ ដោយ លោកស្រី សួស សូលីដា អភិបាល រង ខណ្ឌ និង បាន ធ្វើឡើង នៅ សង្កាត់ ស្វាយប៉ាក ខណ្ឌ ឫស្សីកែវ ចាប់ពី ម៉ោង ០៧៖៣០ នាទី នា រាត្រី ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២០ ។
ក្រៅពី ក្រុមការងារ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ ចុះ ពិនិត្យ ជា លទ្ធផល ជាក់ស្ដែង រកឃើញ ថា ក្នុង ចំណោម ទីតាំង ខារ៉ាអូខេ (KTV) ចំនួន ៤កន្លែង នៅ សង្កាត់ ស្វាយប៉ាក ដែល មាន ៣កន្លែង បើក ដំណើរការ ជាធម្មតា ហើយ ១កន្លែង ផ្សេង ទៀត ពិតជា មិន បាន បើក ដំណើរការឡើយ ដោយ មាន លក្ខណៈ ជា ភោជនីយដ្ឋាន តាម ការណែនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ទន្ទឹម នេះ ក្រុមការងារ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ ក៏ បាន ណែនាំ បន្ថែម ទៀត ដល់ ម្ចាស់ ទីតាំង អាជីវកម្ម ខារ៉ាអូខេ (KTV) ទាំង ៣កន្លែង ដែល កំពុង បើក ដំណើរការ ឲ្យ ចូលរួម អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី រួមចំណែក ក្នុង ការទប់ស្កាត់ ការបង្ការ និង ការការពារ ជម្ងឺ កូវ ដ១៩ ឲ្យបាន ល្អ ប្រសើរ ៕ រដ្ឋបាល ខេត្ត កោះកុង ជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ ឲ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ ការលក់ - ទិញ ដីធ្លី ក្នុង តំបន់ ការពារ ធម្មជាតិ និង គម្រប ព្រៃឈើ
រដ្ឋបាល ខេត្ត កោះកុង បាន ឲ្យដឹង ថា ថ្មី ៗ នេះ នៅ តាម បណ្ដា ភូមិ ឃុំ មួយចំនួន ជាពិសេស នៅក្នុង ស្រុក បូទុម សាគរ ស្រុក កោះ កុង ស្រុក គិរី សាគរ ស្រុក ថ្ម បាំង និង នៅ តាម តំបន់ មួយចំនួន ទៀត មាន ការទិញ - លក់ ដី ស្ថិត ក្នុង តំបន់ ការពារ ធម្មជាតិ តំបន់ សហគមន៍ និង ក្នុង គម្រប ព្រៃឈើ យ៉ាង អណាធិបតេយ្យ ។
ការទិញ - លក់ ដីធ្លី ដោយ មិន មាន ការចូលរួម ចុះ ពិនិត្យ និង វាស់វែង ត្រឹមត្រូវ របស់ មន្ត្រី ពាក់ព័ន្ធ នឹង មន្ត្រី ភូមិបាល នៃ រដ្ឋបាល ក្រុង ស្រុក ដោយ គ្រាន់តែ ផ្តិត មេដៃ រវាង អ្នកលក់ និង អ្នកទិញ យ៉ាង នេះ គឺជា ទង្វើ ខុស ច្បាប់ ។
រដ្ឋបាល ខេត្ត កោះកុង រដ្ឋបាល ក្រុង ស្រុក និង រដ្ឋបាល ឃុំ សង្កាត់ នឹង ចាត់ទុក ជា មោឃៈ និង បដិសេធ ចោល នូវ រាល់ ការលក់ - ទិញ ដីធ្លី ទាំងអស់ ដែល ពុំ មាន លក្ខណៈ ត្រឹម ត្រូវ តាម ផ្លូវ ច្បាប់ និង ត្រូវ ប្រឈម ការផ្តន្ទាទោស ទៅ តុលាការ តាម ផ្លូវ ច្បាប់ ។
ដើម្បី ចៀសវាង នូវ ទង្វើ ខុស ច្បាប់ និង ការខាតបង់ ប្រយោជន៍ ពី ការលក់ - ទិញ ដីធ្លី នេះ សូម សាធារណជន និង ប្រជាពលរដ្ឋ ទាំងអស់ បញ្ឈប់ ជាបន្ទាន់ នូវ ការលក់ - ទិញ ដីធ្លី មិន ស្រប តាម ផ្លូវ ច្បាប់ បែប នេះ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត កោះកុង៖ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវបាន ឧបត្ថម្ភ ជូន អតីត យុទ្ធជន
( ភ្នំពេញ ) ៖ លោក ជា ពិសី ប្រធាន កិត្តិយស សមាគម អតីត យុទ្ធជន កម្ពុជា ខណ្ឌ ឫស្សីកែវ និង ជា អភិបាល ខណ្ឌ គិត មកដល់ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២០ នៅតែ បន្ត ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង យក អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត មក ឧបត្ថម្ភ ជូន អតីត យុទ្ធជន ចំនួន ១១គ្រួសារ ទៀត នៅ សង្កាត់ ឫស្សីកែវ ក្រោយពី លោក ដឹកនាំ ក្រុមការងារ ដដែល នេះ នាំយក អំណោយ មក ឧបត្ថម្ភ ជូន អតីត យុទ្ធជន ចំនួន ៩គ្រួសារ ផ្សេង ទៀត ស្ថិត នៅ សង្កាត់ ទួល សង្កែ ទី២ ។
សកម្មភាព នេះ ក្រៅពី ប្រធាន កិត្តិយស សមាគម អតីត យុទ្ធជន កម្ពុជា ខណ្ឌ ឫស្សីកែវ ក៏ មាន ការចូលរួម ពី លោក វរៈ សេនីយ៍ ឯក ហ៊ាង ថា រ៉េត អធិការ នគរបាល ខណ្ឌ និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខណ្ឌ . លោក - លោកស្រី អធិការ រង នគរបាល ខណ្ឌ . តំណាង យោធភូមិភាគ ពិសេស ប្រចាំ ខណ្ឌ . រួមទាំង មន្ត្រីរាជការ . នគរបាល ប៉ុស្តិ៍ និង អាជ្ញាធរ សង្កាត់ ផងដែរ ។
ក្នុង សកម្មភាព នេះ ដែរ ប្រធាន កិត្តិយស សមាគម អតីត យុទ្ធជន កម្ពុជា ខណ្ឌ លោក ជា ពិសី បាន លើកឡើង ថា សម្រាប់ បង - ប្អូន អតីត យុទ្ធជន ពិតជា បាន រួមចំណែក យ៉ាង សកម្ម ក្នុង បុព្វហតុ ពាលី សាច់ ស្រស់ ឈាម ស្រស់ ដើម្បី សុខ សន្តិភាព របស់ ជាតិ មាតុភូមិ ដែល ជានិច្ច ជាកាល សម្តេច តេជោ ហ៊ុន សែន តែងតែ បាន ជំរុញ ដល់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ និង នៅ គ្រប់ បណ្តា រាជធានី - ខេត្ត ទាំងអស់ ត្រូវ ចុះ តាមដាន ត្រួតពិនិត្យមើល រាល់ ការខ្វះខាត ដើម្បី ជួយ សម្រួល ដល់ ជីវភាព រស់ នៅ របស់ បង - ប្អូន អតីត យុទ្ធជន របស់ យើង ។
អភិបាល ខេត្ត កំពត បន្ត ជំរុញ ឲ្យ ក្រុមហ៊ុន សាងសង់ ពន្លឿន ការ ចាក់ បេតុង ផ្លូវ ក្នុង ក្រុង ឲ្យបាន ឆាប់រហ័ស បំផុត ចៀសវាង ការកកស្ទះ ចរាចរណ៍
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ថ្លែង ជំរុញ ឲ្យ ក្រុមហ៊ុន CRBC បន្ថែម នូវ ក្រុម ម៉ៅការ ពន្លឿន ការ ចាក់ បេតុង ថ្នល់ ជាតិ លេខ ៣ ក្នុង ក្រុង ឲ្យបាន ឆាប់ រហ័ស បំផុត គឺ កំណត់ ក្នុង ១ ថ្ងៃ ១០០ ម៉ែត្រ ដោយ មើលឃើញ ថា ការសាងសង់ ផ្លូវ ជាតិ លេខ ៣ ចាប់ ចំណុច ពី ផ្លូវ រថភ្លើង ក្រុង កំពត មកដល់ ភ្លើង ស្តុប ផ្សារ សាមគ្គី ទី រួម ខេត្ត កំពត មាន ការយឺតយ៉ាវ បង្កឲ្យ មាន ការកកស្ទះ ពិបាក ធ្វើដំណើរ និង ប៉ះពាល់ ដល់ ការប្រកប មុខ របស់ រកស៊ី ទទួលទាន របស់ ប្រជាពលរដ្ឋ ដែល រស់ នៅ ជាប់ ដង ផ្លូវ ។
លោក ជា វ តាយ បាន ថ្លែង ជំរុញ បែប នេះ នៅ ព្រឹក ថ្ងៃទី ១៥ ខែកក្ត ដា ឆ្នាំ ២០២០ នេះ ក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ មន្ទីរ ស្ថាប័ន ជំនាញ ចុះ ជំរុញ ជា លើក ទី២ លើ ការ សាងសង់ ផ្លូវ បេតុង ប្រវែង ១.១០០ ម៉ែត្រ ក្នុង ក្រុង កំពត កំណាត់ ផ្លូវ ជាតិ លេខ ៣ ចាប់ពី ចំណុច ផ្លូវ រថភ្លើង ក្នុង ក្រុង កំពត មកដល់ ចំណុច ស្តុប ផ្សារ សាមគ្គី ទី រួម ខេត្ត កំពត ។ ដោយ មាន ការចូលរួម ពី តំណាង ក្រុមហ៊ុន សាងសង់ និង ក្រុមហ៊ុន ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស ផងដែរ ។
លោក អភិបាល ខេត្ត ក៏ បាន បញ្ជាក់ ដែរ ថា ការចុះ ជំរុញ នេះ ធ្វើឡើង ដើម្បី ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស តាមដាន វឌ្ឍនភាព ការងារ សាងសង់ ដើម្បី ធានា គុណភាព រឹងមាំ ប្រើប្រាស់ ជាប់ បាន យូរអង្វែង ។ ជាពិសេស ជំរុញ ឱ្យ ក្រុមហ៊ុន សាងសង់ ផ្លូវ បេតុង នេះ ឲ្យ លឿន ដោះស្រាយ បញ្ហា ការធ្វើដំណើរកកស្ទះ និង ប៉ះពាល់ ការរស់នៅ របស់ ប្រជា ពលរដ្ឋ នៅ សងខាង ផ្លូវ ប្រចាំ ថ្ងៃ ។
ដោយឡែក ចំពោះ ក្រុមហ៊ុន ពាក់ព័ន្ធ សាងសង់ ខាងលើ នា ពេលនេះ ក៏ បាន សន្យា ថា នឹង បន្ថែម ក្រុម ម៉ៅការសាងសង់ ១ទៀត នា ពេល ឆាប់ ៗ នេះ ដើម្បី មក ស្ថាបនា ផ្លូវ បេតុង ប្រវែង ១.១០០ ម៉ែត្រ ឲ្យបាន លឿន ដោយ កែសម្រួល លក្ខណៈ បច្ចេកទេស សម្ភារៈ និង គ្រឿងចក្រ បម្រើ ឲ្យ ការងារ ស្ថាបនា បេតុង កាន់តែ ងាយស្រួល ថែម ទៀត ។
លោក បញ្ជាក់ ថា ការធ្វើ អត្តសញ្ញាណកម្ម កំណត់ គ្រួសារ ក្រីក្រ ដែល ពិតប្រាកដ កំពុង ត្រូវបាន សម្តេច តេជោ យកចិត្តទុកដាក់ បំផុត ហើយ ដើម្បី ធានា ការ អនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ពលរដ្ឋ ក្រីក្រ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ។ លោក អភិបាល ខេត្ត បាន ក្រើន រំលឹក មេភូមិ មេឃុំ ស្មៀន ឃុំ និង អ្នក ពាក ព័ន្ធ ចុះ អនុវត្តន៍ ផ្ទាល់ ទាំងអស់ សូម អនុវត្តន៍ កិច្ចការ នេះ ទៅ តាម នីតិវិធី ដែល បាន កំណត់ ប្រកបដោយ សុក្រឹតភាព និង តម្លាភាព ។
លោក ជា ម ច័ន្ទ សោភ័ណ លើកឡើង បែប នេះ ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ភូមិ ឃុំ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ដើម្បី ពិនិត្យ ការអនុវត្ត ផ្ទាល់ ការងារ អត្តសញ្ញាណកម្ម គ្រួសារ ក្រីក្រ នៅ ឃុំ ចំនួន ០៤ រួម មាន៖ ឃុំ ដំរិល ឃុំ ចក ឃុំ ទួល សូភី និង ឃុំ គង ជ័យ ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ នា ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២០ ។
