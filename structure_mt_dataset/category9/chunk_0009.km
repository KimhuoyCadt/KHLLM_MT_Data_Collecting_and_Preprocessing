( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០២០ នេះ រៀបចំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆមាស ទី១ និង លើក ទិសដៅ បន្ដ ឆមាស ទី២។ ពិធី នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក សុខ ផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ។
យោង តាម របាយការណ៍ បាន បង្ហាញ ថា ដោយ ស្ថានភាពប្រឈម ជាទូទៅ នៅលើ ពិភពលោក ចំពោះ ការរាតត្បាត នៃ ជំងឺ រីកូរីដ - ១៩ បាន ធ្វើឲ្យ អាជ្ញាធរ គ្រប់ ប្រទេស ផ្អាក ជា បណ្ដោះអាសន្ន ការចរាចរ ឆ្លង ដែន ទាំង ផ្លូវ អាកាស ផ្លូវគោក និង ផ្លូវ ទឹក ចាប់ពី ខែមីនា មក បណ្ដាលឲ្យ ភ្ញៀវ បរទេស ចូល កម្ពុជា មាន ការថយចុះ យ៉ាង គំហុក ។
( ភ្នំពេញ ) ៖ ទស្សនា វិដេអូ ស្ថានភាព ក្មេងស្រី អាយុ ៥ ឆ្នាំ ដែល ត្រូវ ស្ត្រី ម្នាក់ យក កាំបិត អាមុខ បណ្តាលឲ្យ រងរបួស ធ្ងន់ធ្ងរ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ កុមារ ជាតិ នា យប់ ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០២០ ។
លោក អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ និង លោក អធិការ ព្រមទាំង មន្រ្តី ខណ្ឌ បាន អញ្ជើញ ចុះ ពិនិត្យមើល ស្ថានភាព ក្មេងស្រី ដែល កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ កុមារ ជាតិ ។
ស្រ្តី ដៃ ដល់ ខាងលើ ឈ្មោះ លីវ ប៊ុន ធឿន អាយុ ៤៣ ឆ្នាំ មាន ទីលំនៅ ផ្ទះ លេខ ៦ ផ្លូវ លេខ ២៦ បុរី ភព ថ្មី ឈូក វ៉ា២ ក្នុង ភូមិ តិក្ខ ប្បញ្ញោ សង្កាត់ សំរោង ក្រោម ។ ក្រោយពេល ចាប់ខ្លួន ស្រ្តី នោះ បាន និយាយ ថា គាត់ ខឹង ខ្លាំង ណាស់ ដេក អត់ លក់ ២យប់ ហើយ ដោយសារតែ ក្មេងស្រី ខាងលើ ធ្វើឲ្យ កូន គាត់ ចេញ ឈាម ហើយ ត្រូវ ដឹង ថា កូន គាត់ ធំ ឡើង ជា តារា ផង ដូច្នេះ គាត់ សុំ ត្រឹមតែ ឲ្យ ក្មេងស្រី នេះ ចេញ ឈាម វិញ ដូចជា កូន គាត់ វិញ ប៉ុណ្ណោះ ។
ជាមួយ ការបង្ហាញ រូបភាព លើ ទីលាន វាយ កូនហ្គោល វាល ស្មៅ ដ៏ ខៀវ ស្រងាត់ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា សម្តេច បាន ឆ្លៀត ហាត់ប្រាណ វាយ កូនគោល នៅ ទីលាន វាយ កូនគោល ក្បែរ ផ្ទះ ព្រោះ ក្នុង រយៈពេល នៃ ការកាន់ ទុក្ខ ម្តាយ ក្មេក រហូត គម្រប់ ១០០ ថ្ងៃ មិន ហ៊ាន ចេញ ទៅ លេង ខាងក្រៅ ទេ ។
ជាមួយ រូបភាព ដែល បាន បង្ហាញ បាន ស្តែង ឱ្យ ឃើញ ថា មេដឹកនាំ ដែល ប្រឡូក លើ សមរភូមិ សង្គ្រាម ទាំង សង្គ្រាម ប្រដាប់អាវុធ និង សង្គ្រាម នយោបាយ ជាង ៤០ ឆ្នាំ រូប នេះ នៅតែ មាន កម្លាំង ពលំ និង ស្មារតី មាំ មួន ទោះ មកដល់ ពេលនេះ វ័យ ជិត ឈានចូល ៧០ ឆ្នាំ ទៅ ហើយក៏ ដោយ នោះ ។
សម្តេច តេជោ ហ៊ុន សែន តែងតែ បាន បញ្ជាក់ ថា កម្លាំង ពលំ និង សុខភាព របស់ សម្តេច នៅតែ ល្អ ជាធម្មតា ហើយ ថ្ងៃ ខ្លះ សម្តេច ហាត់ប្រាណ ចន្លោះ ពី ៣ ទៅ ៤ ម៉ោង ឯណោះ ។ តាមរយៈ សុខភាព និង កម្លាំង ពលំ ប្រាជ្ញា ស្មារតី ដ៏ ល្អ ប្រសើរ នេះ សម្តេច តេជោ បាន ប្រកាស បន្ត ឈរឈ្មោះ ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី រយៈពេល ២អាណត្តិ ទៅ មុខ បន្ត ទៀត ៕ ទេសរដ្ឋមន្ត្រី គន់ គីម ប្តេជ្ញា បម្រើ អតីត យុទ្ធជន ឱ្យ អស់ ពី បេះដូង ស្រប តាម បំណង សម្តេច តេជោ ហ៊ុន សែន
( កណ្តាល ) ៖ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា សម្រេច ជ្រើសតាំង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន នៅក្នុង អាណត្តិ ថ្មី បន្ត ទៀត ដើម្បី ធ្វើជា សេនាធិការ របស់ សម្តេច ក្នុង ការបម្រើ ប្រយោជន៍ ជូន អតីត យុទ្ធជន កម្ពុជា ។
ពិធី ប្រកាស តែងតាំង សមាសភាព ថ្នាក់ដឹកនាំ សមាគម អតីត យុទ្ធជន ក្នុង អាណត្តិ ថ្មី ត្រូវបាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៦ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក្រោម អធិបតីភាព សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ជា តំណាង ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
ក្នុង ពិធី ប្រកាស តែងតាំង សមាសភាព ថ្នាក់ដឹកនាំ សមាគម អតីត យុទ្ធជន កម្ពុជា ក្នុង អាណត្តិ ថ្មី នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធផល ការងារ ក៏ ដូចជា ការប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ សមាគម អតីត យុទ្ធជន កម្ពុជា ដែល សម្រេចបាន ក្នុង អាណត្តិ ចាស់ រយៈពេល ៥ឆ្នាំ កន្លងទៅ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ បាន ជំរុញ ថ្នាក់ដឹកនាំ ដែល ត្រូវបាន ជ្រើសតាំង កាន់កាប់ ការងារ សមាគម ក្នុង អាណត្តិ ថ្មី ឱ្យ ប្រឹងប្រែង បំពេញ ការងារ ឱ្យ សកម្ម និង មាន ប្រសិទ្ធភាព ថែម ទៀត ដើម្បី បម្រើ ជា ប្រយោជន៍ និង លើកកម្ពស់ ជីវភាព របស់ អតីត យុទ្ធជន កម្ពុជា ដែល សុទ្ធសឹង ជា អ្នកមាន គុណ បំណាច់ យ៉ាង ធំធេង សម្រាប់ ជាតិ មាតុភូមិ ។
លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ក្នុង តួនាទី ជា អនុប្រធាន សមាគម និង ជា អគ្គ លេខាធិការ របស់ សមាគម ដែល ជា អ្នក ប្រតិបត្តិការងារ ផ្ទាល់ នោះ ត្រូវបាន គេ មើលឃើញ ថា បាន ធ្វើ សកម្មភាព យ៉ាង សកម្ម ក្នុង ការដោះស្រាយ បញ្ហា ក៏ ដូចជា ការប្រឹងប្រែង ជួយ លើកកម្ពស់ ជីវភាព របស់ អតីត យុទ្ធជន ឱ្យ បាន កាន់តែ ល្អ ប្រសើរ ។
ជាមួយនឹង ការទទួលបាន សេចក្តីទុកចិត្ត ពី សម្តេច តេជោ ហ៊ុន សែន ឱ្យ ធ្វើជា សេនាធិការ បម្រើ ការងារ អតីត យុទ្ធជន ក្នុង អាណត្តិ ថ្មី នោះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន បង្ហាញ ការប្តេជ្ញាចិត្ត និង សន្យា ប្រឹងប្រែង ឱ្យ អស់ កម្លាំង កាយ ចិត្ត ដើម្បី ជួយ ក្រុមគ្រួសារ អតីត យុទ្ធជន ។
« នេះ ជា មហា កិត្តិយស ដ៏ ធំធេង សម្រាប់ ខ្ញុំ ដែល ទទួលបាន សេចក្តីទុកចិត្ត និង ផ្តល់ ឱកាស ដ៏ ធំធេង ពី សម្តេច តេជោ ហ៊ុន សែន ដើម្បី បម្រើ បងប្អូន អតីត យុទ្ធជន ។ ខ្ញុំ សូម ប្រកាស ប្តេជ្ញា ថា នឹង ប្រឹងប្រែង ឱ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ដោយ មិន ខ្លាច នឿយហត់ នោះ ឡើយ ដើម្បី ដោះស្រាយ បញ្ហា ទាំងឡាយ របស់ បងប្អូន អតីត យុទ្ធជន ក៏ ដូចជា ជួយ ឱ្យ ការរស់នៅ របស់ បងប្អូន អតីត យុទ្ធជន បាន កាន់តែ ល្អ ប្រសើរ »។ នេះ ជា ការប្រកាស ប្តេជ្ញាចិត្ត របស់ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ។
លោក ទេសរដ្ឋមន្ត្រី បន្ថែម ថា « បំណងប្រាថ្នា របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត គឺ ចង់ ឃើញ បងប្អូន រស់ នៅ មាន សេចក្តីសុខ មាន ជីវភាព មួយ ល្អ ប្រសើរ ដូច្នេះ ខ្ញុំ ត្រូវតែ ប្រឹងប្រែង មិន ធ្វើឱ្យ សម្តេច ទាំង ពីរ ខក បំណង នោះ ឡើយ » ។
លោក គន់ គីម បាន ឱ្យដឹង ថា រយៈពេល ៥ឆ្នាំ កន្លងទៅ ពោល ចាប់ពី ឆ្នាំ ២០១៥ ដល់ ឆ្នាំ ២០២០ នេះ ដើម្បី ឆ្លើយតប ទៅនឹង គុណ បំណាច់ ដ៏ ធំធេង របស់ អតីត យុទ្ធជន កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន គិតគូរ សាងសង់ ផ្ទះ ជូន អតីត យុទ្ធជន ចំនួន ២. ៤៦០ខ្នង ។ បើ តាម លោក ទេសរដ្ឋមន្ត្រី នៅ មាន គ្រួសារ អតីត យុទ្ធជន ប្រមាណ ៣. ៦៥៤ គ្រួសារ ទៀត ដែល ត្រូវ បន្ត សាងសង់ និង ដោះស្រាយ ដី សម្បទាន សង្គមកិច្ច ជូន បន្ត ទៀត ។
លោក ទេសរដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា គិត ត្រឹម ខែឧសភា ឆ្នាំ ២០២០ សមាគម អតីត យុទ្ធជន កម្ពុជា មាន សមាជិក ៧៦. ៩២៣ នាក់ ដែល មាន នៅក្នុង បន្ទុក ប្រមាណ ១០៨. ៨៧១ នាក់ កំពុង ទទួលរបប ឧបត្ថម្ភ គោល នយោបាយ ពី រដ្ឋ ជារៀងរាល់ ខែ ក្នុង នោះ៖ មាន និវត្ត ជន ចំនួន ២៦. ៨៩២ នាក់ . ជន បាត់បង់ សមត្ថភាព ការងារ ចំនួន ១. ៤៤៤ នាក់ និង ជន ពិការ ចំនួន ២៦. ៤៤៩ នាក់ ៕
លោក ទេសរដ្ឋមន្ត្រី បាន អំពាវនាវ ដល់ ក្រសួង ស្ថាប័ន មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ជួយ ទិញ ទឹក ដើម្បី ជួយ គាំទ្រ ដល់ អតីត យុទ្ធជន ក៏ ដូចជា ការចូលរួមចំណែក អភិវឌ្ឍ អតីត យុទ្ធជន កម្ពុជា ផងដែរ ។ បន្ថែម ពី នេះ លោក ទេសរដ្ឋមន្ត្រី បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង បង្កើត បានជា សមិទ្ធផល ស្នាដៃ និង វឌ្ឍភាព ការងារ របស់ សមាគម អតីត យុទ្ធជន កម្ពុជា សម្រេចបាន ក្នុង រយៈកាល ៥ឆ្នាំ កន្លងមក ៕
( បរទេស ) ៖ ខាងក្រោម គឺជា រូបភាព មួយចំនួន នៃ ស្ថានការណ៍ អន្តរជាតិ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃព្រហស្បតិ៍ ទី១៦ ខែកក្កដា ឆ្នាំ ២០២០ ។
១៖ តៃវ៉ាន់ ធ្វើ សមយុទ្ធ យោធា បាញ់ គ្រាប់ ពិត នៅ ចំ កណ្តាល កោះ តែម្តង ។
២៖ ទីបំផុត រដ្ឋអាជ្ញា កូរ៉េ ខាងត្បូង បើក ការស៊ើបអង្កេត លើ ប្អូន ស្រី លោក គីម ជុង អ៊ុន ។
៧៖ នាវា ដឹក យន្តហោះ ចម្បាំង អាមេរិក ឆាបឆេះ ឈានចូល ថ្ងៃទី ៤ហើយ ។ ព្រះមហាក្សត្រ យាង បើក សម័យ ប្រជុំ លើក ទី ៣៣ របស់ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម
( ភ្នំពេញ ) ៖ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ព្រះប្រធាន ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ស្តេច សព្វ ព្រះរាជ ហឫទ័យ បាន យាង ជា ព្រះរាជា ធិបតី ដ៏ ខ្ពង់ខ្ពស់ បំផុត ក្នុង ពិធី បើក សម័យ ប្រជុំ លើក ទី ៣៣ របស់ ឧត្តម ក្រុមប្រឹក្ស នៃ អង្គចៅក្រម នា ព្រះមហា ប្រាសាទ ខេមរិន្ទ ព្រះបរម រាជ វាំង ដែល បាន ប្រព្រឹត្តទៅ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០២០ ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម បាន ឲ្យដឹង ថា សម័យ ប្រជុំ លើក ទី ៣៣ មាន របៀបវារៈ ចំនួន ៧ ដូច ជា៖
ទី១៖ ពិនិត្យ និង សម្រេច អំពី ការតែងតាំង ប្រធាន សាលាឧទ្ធរណ៍ តំបន់ ការផ្ទេរ និង តែងតាំង ប្រធាន អនុប្រធាន ចៅក្រម សាលាដំបូង រាជធានី ខេត្ត មួយចំនួន
ទី២៖ ពិគ្រោះយោបល់ លើ សំណើ តែងតាំង អគ្គ ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាឧទ្ធរណ៍ តំបន់ ការផ្ទេរ និង តែងតាំង ព្រះរាជអាជ្ញា ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត មួយចំនួន តាម សំណើ របស់ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌
ទី៣៖ ពិនិត្យ និង សម្រេច លើ សំណើ សុំ អនុញ្ញាត ច្បាប់ ទៅ បន្ត ការសិក្សា របស់ ចៅក្រម មួយ រូប នៃ សាលាដំបូង ខេត្ត កណ្តាល
ទី៤៖ ពិនិត្យ និង សម្រេច លើ សំណើ តែងតាំង ស៊ុប ក្នុង ក្របខណ្ឌ ចៅក្រម ចំពោះ ចៅក្រម កម្មសិក្សា ៣៩ រូប
ទី៥៖ ពិគ្រោះយោបល់ លើ សំណើ តែងតាំង ស៊ុប ក្នុង ក្របខណ្ឌ ព្រះរាជអាជ្ញា ចំពោះ ព្រះរាជអាជ្ញា រង កម្មសិក្សា ១៥រូប តាម សំណើ របស់ រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌
ទី៦៖ ពិនិត្យ និង សម្រេច អំពី ការកំណត់ងារ សម្រាប់ ចៅក្រម និង ព្រះរាជអាជ្ញា តាម មុខតំណែង
ការព្រមាន របស់ លោកស្រី ឱ វណ្ណឌីន បាន ធ្វើឡើង បន្ទាប់ពី ជំងឺ កូវីដ១៩ ត្រូវបាន រកឃើញ នៅលើ ទឹកដី កម្ពុជា ជា បន្តបន្ទាប់ នៅក្នុង រយៈពេល ប៉ុន្មាន សប្តាហ៍ ចុងក្រោយ នេះ ។ របាយការណ៍ របស់ ក្រសួង សុខាភិបាល បាន បង្ហាញ ថា មកដល់ ពេលនេះ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ រហូតដល់ទៅ ១៧១ នាក់ ក្នុង នោះ ៣៦ នាក់ កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ តាម មន្ទីរពេទ្យ នៅឡើយ ។
លោកស្រី ឱ វណ្ណឌីន បាន លើកឡើង ថា បើ ទោះបី ករណី ចុងក្រោយ នេះ សុទ្ធតែ ជា ការនាំចូល ពី ក្រៅ ប្រទេស តែ អាចនឹង បង្ក ការរីករាលដាល ក្នុង ប្រទេស គ្រប់ ពេលវេលា បើ ខ្វះ ការប្រុងប្រយ័ត្ន នោះ ។
ដោយសារតែ បារម្ភ ពី ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ ក្រសួង សុខាភិបាល នៅ ថ្ងៃ នេះ ក៏ បាន ចេញ សេចក្តី អំពាវនាវ ទៅកាន់ ប្រជាពលរដ្ឋ កម្ពុជា ឱ្យ មាន ការប្រុងប្រយ័ត្ន និង បង្ការ ខ្លួន ឱ្យ បាន ខ្ពស់ ក្នុង ពេល ធ្វើដំណើរកម្សាន្ត ក៏ ដូចជា ឈប់ សម្រាក នៅ ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ២១ ខែសីហា ខាងមុខ នេះ ដែរ ។
ក្រសួង សុខាភិបាល បាន អំពាវនាវ ដល់ សាធារណជន ចូលរួម អនុវត្ត តាម ការណែនាំ នេះ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ដើម្បី ចូលរួមចំណែក កាត់ផ្តាច់ការចម្លង មេរោគ កូវីដ១៩ ពី បុគ្គល ម្នាក់ ទៅ បុគ្គល ម្នាក់ និង កុំ ឱ្យ មាន ការចម្លង ទៅ សហគមន៍ ។
ក្រសួង សុខាភិបាល ធ្លាប់ បាន ណែនាំ ថា ដើម្បី ការពារ កុំ ឱ្យ ឆ្លង ជំងឺ កូវីដ១៩ ប្រជាពលរដ្ឋ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ វិធាន អនាម័យ រស់ នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត និង ឧស្សាហ៍ លាង ដៃ ជាមួយ សាប៊ូ អាល់កុល ឬ ជែល សម្លាប់ មេរោគ ។ ជាពិសេស ត្រូវ រក្សា គម្លាត សុវត្ថិភាព និង ប្រើ ម៉ាស់ ឱ្យ បាន ជាប់ ជាប្រចាំ ពេល ទៅ កន្លែង ប្រមូលផ្តុំ ឬ កន្លែង មាន ការសង្ស័យ មាន ជំងឺ កូវីដ១៩ នោះ ៕
សម្ពោធ ស្នាក់ការ ភូមិ អូរ អណ្តូង សង្កាត់ ព្រែក ប្រា ដើម្បី បំរើ សេវា ជូន ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ សមិទ្ធិផល ថ្មី មួយ ទៀត គឺ ទីស្នាក់ការ ភូមិ អូរ អណ្តូង ត្រូវបាន សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ដើម្បី បំរើ សេវា ជូន ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ អរ អណ្តូង សង្កាត់ ព្រែក ប្រា ខណ្ឌ ច្បារអំពៅ ។
ពិធី សម្ពោធ ទីស្នាក់ការ ភូមិ នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០២០ ក្រោម វត្តមាន លោកស្រី ឡោក ខេង ប្រធាន ក្រុមការងារ ចុះ ជួយ ខណ្ឌ ច្បារអំពៅ លោក អ៊ំ ម៉ារ៉េត ប្រធាន ក្រុមប្រឹក្សា ខណ្ឌ . លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ . លោក - លោកស្រី ជា អភិបាល រង . លោក មេបញ្ជាការ កងរាជអាវុធហត្ថ ខណ្ឌ . លោក អធិការ នគរបាល ខណ្ឌ និង មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ ជិត ៣០០ នាក់ ។
លោក ចេង មុនីរ៉ា បាន ថ្លែង នៅក្នុង អង្គ ពិធី ដូច្នេះ ថា អាគារ ថ្មី ទីស្នាក់ការ ភូមិ អូរ អណ្តូង នេះ ចាប់ផ្តើម សាងសង់ នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០១៩ ហើយ បញ្ចប់ ការសាង សង់ នៅ ថ្ងៃទី ២១ ខែវិច្ឆិកា ឆ្នាំ ២០២០ មាន ទំហ៊ំ ទទឹង ៥ម៉ែត្រ គុណ បណ្តោយ ៦ម៉ែត្រ កំពស់ ២ជាន់ ចំណាយ ទឹកប្រាក់ អស់ ជាង ១១២ លាន រៀល ស្មើនឹង ជាង ២៧.០០០ ដុល្លារ ។
លោក បន្ដ ថា ប្រភព ថវិកា នៃ ការសាងសង់ អាគារ ថ្មី នេះ បាន មកពី សប្បុរសជន ចូលរួមចំណែក ជាមួយ គណៈ អភិបាល ខណ្ឌ និង សង្កាត់ ទើប សម្រេចបាន នូវ សមិទ្ធិផល មួយ បន្ថែម ទៀត សម្រាប់ បំរើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ។
លោក អភិបាល បាន បន្ត ថា ក្នុង អាណត្តិ បច្ចុប្បន្ន នេះ គណៈ អភិបាល ខណ្ឌ កងកម្លាំងប្រដាប់អាវុធ មន្ត្រីរាជការ ទូទាំង ខណ្ឌ - សង្កាត់ - ភូមិ បាន រួមគ្នា ខិតខំ បំពេញ ការងារ បំរើ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង នោះ ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ ត្រូវបាន ខិតខំ ពង្រឹង រួម នឹង ការអភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ ជា បន្តបន្ទាប់ ដូចជា ការស្ថាបនា ផ្លូវ បេតុង ជួសជុល ផ្លូវ ដាក់ លូ ដាក់ ភ្លើង បំភ្លឺ ផ្លូវ សាធារណៈ ។
លោក ថា ជាពិសេស ការផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ តាមរយៈ ការិយាល័យ ច្រក ចេញ - ចូល តែ មួយ ខណ្ឌ - សង្កាត់ ត្រូវបាន យកចិត្តទុកដាក់ ធ្វើ យ៉ាងណា ឲ្យ ការផ្តល់ សេវា កាន់តែ មាន ប្រសិទ្ធភាព តម្លាភាព និង ពេលវេលា ទទួល សេវា កាន់តែ សមស្រប ឆាប់ រហ័ស ជូន ដល់ ប្រជាពលរដ្ឋ ។ ក្រៅពី នេះ ការសម្របសម្រួល ដោះស្រាយ បញ្ហា ប្រឈម នានា នៅក្នុង មូលដ្ឋាន ក៏ ត្រូវបាន យកចិត្តទុកដាក់ ដោះស្រាយ ជូន ជា បន្តបន្ទាប់ ។
លោក បន្ដ ថា អ្វី ដែល សំខាន់ ជាង នេះ ទៀត ក្រោយពេល សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ អាគារ ថ្មី ទីស្នាក់ការ ភូមិ នេះ ហើយ គណៈ ភូមិ ត្រូវ មាន ក្រុមការងារ ប្រចាំ ការ នៅ ទីស្នាក់ការ ជានិច្ច ដើម្បី ចាំ ទទួល ប្រជាពលរដ្ឋ មក ប្រាស្រ័យទាក់ទង ពី បញ្ហា ផ្សេង ៗ ដែល កើតមាន នៅក្នុង ភូមិ ។
នៅក្នុង ពិធី នេះ ដែរ លោកស្រី ឡោក ខេង ប្រធាន ក្រុមការងារ ចុះ ជួយ ខណ្ឌ ច្បារអំពៅ បាន ថ្លែង កោតសរសើរ ដល់ លោក ចេង មុនីរ៉ា. ក្រុមប្រឹក្សា ខណ្ឌ - សង្កាត់ ដែល បាន ខិតខំ រួមគ្នា ក្នុង ការគៀង គរ រក សប្បុរស ជន ជួយ ឧបត្ថម្ភ ជា សម្ភារ និង ថវិកា ក្នុង ការសាងសង់ អាគារ ថ្មី ទីស្នាក់ ភូមិ អូរ អណ្តូង ដើម្បី បំរើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ សមិទ្ធិផល នេះ សបញ្ជាក់ ជាជា វឌ្ឍនៈ ភាព ថ្មី មួយ ទៀត របស់ រដ្ឋបាល ខណ្ឌ ច្បារអំពៅ ៕
ជាក់ស្តែង នៅ ថ្ងៃទី ១៧ ខែកក្កដា នេះ ដើម្បី ធានា ដល់ គុណភាព សំណង់ និង ធ្វើ យ៉ាងណា ឱ្យ រួចរាល់ តាម ផែនការ នៅ ចុង ឆ្នាំ ២០២០ ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ដែល ជា គ្រប់គ្រង គម្រោង ដោយ ផ្ទាល់ . លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ជា អនុប្រធាន អចិន្ត្រៃយ៍ . លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន ជា អនុប្រធាន និង លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ និង ជា សមាជិក និង មន្ត្រី ពាក់ព័ន្ធ បាន ចុះ ពិនិត្យ វឌ្ឍនភាព នៃ គម្រោង ស្ថាបនា ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ ក្រុង ទាំង ៣៤ខ្សែ នេះ ផង ។
តាមរយៈ សេចក្តីប្រកាស ព័ត៌មាន ដដែល បាន ឱ្យដឹង ថា ការអនុវត្ត ការងារ ដាក់ លូ សម្រេចបាន ចំនួន ១០០ ភាគរយ រៀប ខឿន ថ្ម ក្រានីត បាន ៥៩. ៩៩ ភាគរយ រៀប ក្រាល ថ្ម ក្រានីត បាន ៤. ៤៨ ភាគរយ ដាំ បង្គោល បំភ្លឺ ផ្លូវ សាធារណៈ បាន ២៣.៨៩ ភាគរយ និង បំពាក់ អំពូលភ្លើង ដែល ប្រើ បច្ចេកវិទ្យា វៃ ឆ្លាត បាន ១០.៤៥ ភាគរយ នៃ បង្គោល ភ្លើងង ដែល បាន ដាំ រួច ។
