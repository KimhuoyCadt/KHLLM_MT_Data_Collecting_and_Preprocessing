( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ការិយាល័យ ប្រឆាំង ការជួញដូរ មនុស្ស និង ការពារ អនីតិជន នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ សហការ ជាមួយ នគរបាល ខណ្ឌ សែនសុខ បាន ចុះ ប្រតិបត្តិការ បង្ក្រាប ទីតាំង ម៉ាស្សាយីហោ ក ល្យាណ ម៉ាស្សា មាន បង្កប់ សេវា ផ្លូវភេទ ឃាត់ខ្លួន មនុស្ស ចំនួន ៤នាក់ ក្នុង នោះ ម្នាក់ ជា ម្ចាស់ ទីតាំង និង ៣នាក់ ទៀត ជា ជនរងគ្រោះ ( អនីតិជន ម្នាក់ ) ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ស្ថិត នៅ ផ្ទះ លេខ ៨៣Eo សង្កាត់ គោ គឃ្លាង ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ធ្វើឡើង ក្រោម ការចង្អុលបង្ហាញ ពី ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ក្រោម ការសម្របសម្រួល ពី លោក សេង គីម ឡាក់ ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ និង ដឹកនាំ ប្រតិបត្តិការ ដោយ លោក ឧត្តមសេនីយ៍ ទោ ចាន់ កិត្តិខុម ស្នងការ រង ទទួល ដឹកនាំ ការងារ ការិយាល័យ ប្រឆាំង ការជួញដូរ មនុស្ស និង ការពារ អនីតិជន ។
ក្នុង នោះ កម្លាំង នគរបាល បាន ឃាត់ខ្លួន មនុស្ស ចំនួន ៤នាក់ ស្រ្តី ម្ចាស់ ទីតាំង ម្នាក់ ក្នុង នោះ នារី រងគ្រោះ ចំនួន ៣នាក់ ( អនីតិជន ម្នាក់ ) និង ដកហូត វត្ថុតាង រួម មាន ស្រោម អនាម័យ ប្រើ រួច និង មិន ទាន់ ប្រើប្រាស់ មួយចំនួន ផងដែរ បាន នាំយក មក ការិយាល័យ ប្រឆាំង ការជួញដូរ មនុស្ស និង ការពារ អនីតិជន ដើម្បី បន្ត ការសាកសួរ និង ចាត់ការ តាម នីតិវិធី ៕
ស្នងការ នគរបាល ខេត្ត កណ្ដាល ដង្ហែ ទៀន ព្រះវស្សា និង នាំយក ទេយ្យ ទាន ប្រគេន ដល់ ព្រះសង្ឃ នៅ វត្ត បុទុម សាគរ ក្រុង តាខ្មៅ
( កណ្តាល ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត ស្នងការ នគរបាល ខេត្ត កណ្តាល នា ព្រឹក ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ លោក - លោកស្រី ស្នងការ រង នាយ - នាយ រង និង មន្ត្រី នគរបាល ខេត្ត ដង្ហែ ទៀន ព្រះវស្សា ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត បុទុម សាគរ ( ហៅ វត្ត ក្របៅ ) ស្ថិត ក្នុង សង្កាត់ ដើម មៀន ក្រុង តាខ្មៅ ដើម្បី ទុក សម្រាប់ ប្រើប្រាស់ ក្នុង ពេល ចូល ព្រះវស្សា រយៈពេល ៣ខែ ខាងមុខ នេះ ។
សូម បញ្ជាក់ ថា ពិធី បុណ្យ ចូល ព្រះវស្សា គឺជា ពិធី បុណ្យ មួយ ដែល មាន សារៈសំខាន់ ក្នុង ព្រះពុទ្ធ សាសនា ជា ពេលវេលា ដ៏ សំខាន់ សម្រាប់ ភិក្ខុ សង្ឃ និង សាមណេ បាន រៀនធម៌ និង វិន័យ យ៉ាង ខ្ជាប់ខ្ជួន តាម ពុទ្ធ ឱវាទ ។ ពិធី បុណ្យ នេះ ប្រារព្ធ ធ្វើឡើង ជារៀងរាល់ ឆ្នាំ រយៈពេល ៣ខែ ចាប់ពី ថ្ងៃ ១រោច ខែ អាសាធ ដល់ ថ្ងៃ ១៥ កើត ខែ អស្សុជ ។ បងប្អូន ដែល ជា អ្នក មាន ជំនឿ ទៅ លើ ព្រះពុទ្ធ សាសនា តែងតែ នាំគ្នា ប្រារព្ធ ពិធី បុណ្យ ដោយ នាំយក ជាសាដក អង្ករ ភេសជ្ជៈ និង របស់ ប្រើប្រាស់ ផ្សេង ៗ ទៅ ប្រគេន ព្រះសង្ឃ តាម លទ្ធភាព ។
ក្រៅពី របស់ ប្រើប្រាស់ និង ម្ហូប អាហារ បងប្អូន ខ្មែរ ក៏ បានជា វ ទាន វស្សា ទៅ ប្រគេន ព្រះសង្ឈ ផងដែរ ព្រោះ យើង មាន ជំនឿ ថា ពន្លឺ ទៀន គឺ ជួយ បំភ្លឺ អនាគត ជាតិ ឱ្យ ភ្លឺ ស្រស់បំព្រង និង មាន សេចក្តីសុខ ចម្រើន ដោយ អំពើ ល្អ សេចក្តី ល្អ ហើយ គេ ត្រូវ រក្សា ភ្លើង ទៀន ឱ្យ ឆេះ ជាប់ រហូត គ្រប់ រយៈពេល បី ខែ ។ មួយ វិញទៀត នេះ ជា ការជួយ ដល់ វត្ត អារាម ក្នុង ការមាន ទៀន ប្រើប្រាស់ ដើម្បី ដុត បំភ្លឺ នៅ ពេល យប់ ផងដែរ ៕
ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ឧបត្ថម្ភ រថយន្ត សង្រ្គោះ មួយ គ្រឿង ដល់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កណ្តាល
( កណ្តាល ) ៖ រថយន្ត សង្រ្គោះ បន្ទាន់ ថ្មី ស្រឡាង មួយ គ្រឿង ដែល មាន បំពាក់ ឧបករណ៍ សង្រ្គោះ បឋម មួយ កំផ្លេ ជា អំណោយ របស់ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង លោកស្រី ត្រូវបាន ប្រគល់ ជូន ដល់ លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត ស្នងការ នគរបាល ខេត្ត កណ្តាល ទុក សម្រាប់ ប្រើប្រាស់ នៅក្នុង អង្គភាព ស្នងការដ្ឋាន ។
ពិធី ប្រគល់ - ទទួល នេះ ធ្វើឡើង ស្នងការដ្ឋាន នគរបាល ខេត្ត កណ្តាល នា ព្រឹក ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី សំ អុន តំណាង បញ្ជាការដ្ឋាន ជាតិ កម្លាំង ពិសេស ប្រឆាំង ភេរវកម្ម ជា អ្នកប្រគល់ ហើយ លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត ជា អ្នកទទួល ។
លោក ឧត្តមសេនីយ៍ ត្រី សំ អុន បាន ឱ្យដឹង ថា រថយន្ត សង្រ្គោះ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង លោកស្រី នា ពេលនេះ ជា ប្រភេទ រថយន្ត ម៉ាក ស្តារិច ពណ៌ ស ស៊េរី ឆ្នាំ ២០០៨ ក្នុង រថយន្ត នេះ មាន បំពាក់ ឧបករណ៍ សម្រាប់ សង្រ្គោះ បឋម រួច ជាស្រេច ។
លោក ឧត្តមសេនីយ៍ ត្រី ឈឿន សុចិត្ត បាន ថ្លែងអំណរគុណ ដល់ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត និង លោកស្រី ដែល បាន ឧបត្ថម្ភ រថយន្ត សង្រ្គោះ ដល់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កណ្តាល ។ រថយន្ត ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា នេះ លោក នឹង ប្រគល់ ទៅ ឱ្យ ការិយាល័យ សុខាភិបាល ជា អ្នកគ្រប់គ្រង ប្រើប្រាស់ ទុក សម្រាប់ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ដែល ជួប គ្រោះអាសន្ន ឬ ឧបទវ ហេតុ គ្រោះថ្នាក់ ជា យថាហេតុ ណាមួយ ។
លោក ស្នងការ ក៏ បាន ផ្តាំផ្ញើរ ដល់ លោក នាយ ការិយាល័យ សុខាភិបាល ពិសេស អ្នកប្រើប្រាស់ ផ្ទាល់ ត្រូវ ខិតខំ ថែរក្សា រថយន្ត សង្រ្គោះ មួយ គ្រឿង នេះ ឱ្យ បាន ល្អ ប្រសើ ធានា ដល់ គុណភាព ប្រើប្រាស់ បាន យូរអង្វែង ៕
( ត្បូងឃ្មុំ ) ៖ នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ប្រធាន នាយកដ្ឋាន បុគ្គលិក បាន លើកឡើង ថា មន្ត្រី នគរបាល ជាតិ ត្រូវ ទទួលខុសត្រូវ លើ កាតព្វកិច្ច ខ្លួន ឲ្យបាន ល្អ ពិសេស គោល នយោបាយ ទាំង ៩ ចំណុច របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង នាម ជា អាជ្ញាធរ និង ជា អាណាព្យាបាល របស់ ពលរដ្ឋ ក្នុង មូលដ្ឋាន ។
ការលើកឡើង បែប នេះ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក្នុង ឱកាស នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល តំណាង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស ផ្ទេរ ភារកិច្ច តែងតាំង មុខ តំណែង និង បំពាក់ ឋានន្តរស័ក្តិ ជូន មន្ត្រី នគរបាល ជាតិ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ត្បូងឃ្មុំ ។
ជាមួយគ្នា នេះ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន ថ្លែង នូវ ការកោតសរសើរ ចំពោះ បងប្អូន កងកម្លាំង នគរបាល ទាំងអស់ ដែល បាន ខិតខំ បំពេញ ភារកិច្ច បាន យ៉ាង ល្អ ប្រសើរ ដោយ បាន ផ្តល់ សេវា ឆាប់រហ័ស និង ការពារ សុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ តាម បណ្តា មូលដ្ឋាន បាន យ៉ាង ល្អ ប្រសើរ នា ពេល កន្លងមក ព្រមទាំង ជំរុញ ឲ្យ បន្ត លើ កិច្ចការងារ នេះ ឲ្យ កាន់តែ ល្អ ទ្វេរ ឡើង បន្ថែម ទៀត ។
ជាមួយគ្នា នោះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ បែន រ័ត្ន ស្នងការ នគរបាល ខេត្ត ត្បូងឃ្មុំ បាន បញ្ជាក់ ផងដែរ ថា ចំពោះ មន្ត្រី នគរបាល ជាតិ នៅ ខេត្ត ត្បូងឃ្មុំ ដែល ទើប ប្រកាស់ តែងតាំង និង ដំឡើង ឋានន្ត ស័ក្ដិ ត្រូវ មាន សាមគ្គីភាព ផ្ទៃក្នុង ឲ្យបាន ល្អ អនុវត្តន៍ នូវ កាតព្វកិច្ច ភារកិច្ចការងារ របស់ ខ្លួន ឲ្យបាន ល្អ ឥត ខ្ចោះ ពិសេស អនុវត្ត គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ឲ្យបាន ម៉ឺងម៉ាត់ និង មាន ប្រសិទ្ធភាព ខ្ពស់ ត្រូវតែ ធ្វើ ការបង្ក្រាប ឲ្យបាន ជាដាច់ខាត នូវ រាល់ ទង្វើ បង្ក ចាល ចល និង អំពើ អបាយ មុខ ផ្សេង ៗ ។
( ពោធិ៍សាត់ ) ៖ សត្វ គោ ក្របី ចំនួន ៣៨៧ ក្បាល ( ក្របី ១៤ ក្បាល ) របស់ ប្រជាពលរដ្ឋ នៅ ភូមិ បត់ រំដួល ឃុំ ផ្ទះ រុង ស្រុក តា លោ សែន ជ័យ ខេត្ត ពោធិ៍សាត់ ត្រូវបាន ដឹក មក ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ សារ ទឹក ដោយ ឥត គិត ថ្លៃ ដែល រៀបចំឡើង ដោយ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ក្នុង គោលបំណង បង្ការ ជំងឺ រាតត្បាត ផ្សេង ៗ នា រដូវ វស្សា នេះ ពីព្រោះ សត្វ ពាហនៈ គឺជា កម្លាំង អូសទាញ ដ៏ មាន សារសំខាន់ របស់ បងប្អូន ប្រជាកសិករ ។
ជាក់ស្តែង ថ្ងៃ នេះ ក្រុមការងារ បាន ចុះ ផ្សព្វផ្សាយ និង កំណត់ យក ទីតាំង ភូមិ បត់ រំដួល ឃុំ ផ្ទះ រុង ធ្វើ ការបើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង សារ ទឹក ដោយ ឥត គិត ថ្លៃ ជូន ប្រជាពលរដ្ឋ ១០៥ គ្រួសារ ដែល មាន សត្វ គោ ក្របី សរុប ចំនួន ៣៨៧ ក្បាល ( ក្របី ១៤ ក្បាល ) ហើយ ត្រូវបាន លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ដឹកនាំ ចុះ ចាក់ ផ្ទាល់ ។
លោក ប្រធាន ការិយាល័យ ផលិតកម្ម និង បសុព្យាបាល បាន ធ្វើ ការក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ ឱ្យ ចេះ ថែរក្សា ការពារ សត្វ គោ ក្របី របស់ ខ្លួន ដោយ រាយការណ៍ ជាបន្ទាន់ ដល់ ភ្នាក់ងារ ពេទ្យ សត្វ ភូមិ ប្រសិនបើ មាន ជំងឺ ផ្សេង ៗ កើតមាន ចៀសវាង បង្កឱ្យ មាន ជំងឺ ឆ្លង រីករាលដាល កាន់តែ ធ្ងន់ធ្ងរ ។ លោក បាន ណែនាំ ដល់ បងប្អូន ប្រជាកសិករ គួរតែ កែប្រែ ពី ការចិញ្ចឹម គោ ជាជា លក្ខណៈ គ្រួសារ មក ជា ការចិញ្ចឹម គោ ពាក់កណ្តាល ឧស្សហកម្ម វិញ ដើម្បី លើកកម្ពស់ ជីវភាព គ្រួសារ ធានា បាន ទាំង គុណភាព សុវត្ថិភាព និង អនាម័យ ។
លោក ផាត់ សារុន ក៏ បាន ពន្យល់ ពី គុណ ប្រយោជន៍ នៃ ការបង្កាត់ ពូជ សិប្បនិម្មិត ដែល ក្នុង នោះ មាន ទាំង ចំណេញ ពេល និង កម្លាំង ពលកម្ម . អត្រា នៃ ការបង្កកំណើត ខ្ពស់ និង កាត់បន្ថយ ជំងឺ ឆ្លង ។
ក្រៅពី ការងារ ចិញ្ចឹម សត្វ លោក ប្រធាន ការិយាល័យ បាន ជំរុញ ការធ្វើឡ ជីវ ឧស្មន័តាម គ្រួសារ ដែល វា អាច សន្សំ ប្រាក់ សន្សំ ពលកម្ម សន្សំ ពេលវេលា សម្រាល ការងារ ផ្ទះ មាន សុខភាព ល្អ កាត់បន្ថយ ការបំផ្លាញ ព្រៃឈើ ផ្ទះសម្បែង ស្អាត ការពារ បរិស្ថាន កាត់បន្ថយ ឧស្មន័ផ្ទះ កញ្ចក់ បាន កាកសំណល់ ចុងក្រោយ គឺ ជី ដាក់ ស្រែ ។
ជាមួយគ្នា នោះ ដែរ ប្រជាពលរដ្ឋ ដែល ជា ម្ចាស់ គោ ក្របី ទាំង ៣៨៧ ក្បាល បាន សម្តែង នូវ សេចក្តីត្រេកអរ ជាខ្លាំង ខណៈពេល ដែល មាន ការយកចិត្តទុកដាក់ ពី ថ្នាក់ ខេត្ត និង មន្ទីរ បាន ចុះ ចាក់ វ៉ាក់សាំង សារ ទឹក ការពារ ជំងឺ ឆ្លង ដល់ សត្វ គោ ក្របី របស់ ពួកគាត់ ៕
រដ្ឋបាល ខេត្ត បាត់ដំបង ផ្តល់ បណ្ណ សរសើរ និង លិខិត សរសើរ ជូន ដល់ រដ្ឋបាល ឃុំ - សង្កាត់ ដែល មាន ស្នាដៃ ល្អ
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត ខេត្ត បាត់ដំបង បាន បើក កិច្ចប្រជុំ បូកសរុប របាយការណ៍ ប្រចាំ ឆ្នាំ ២០១៩ និង ប្រចាំ ឆមាស ទី១ ឆ្នាំ ២០២០ ស្តីពី ការអនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព និង
ពិធី ផ្តល់ បណ្ណ សរសើរ និង លិខិត សរសើរ ជូន ដល់ រដ្ឋបាល ឃុំ - សង្កាត់ ក្នុង ខេត្ត បាត់ដំបង នា ព្រឹក ថ្ងៃទី១ ខែកក្កដា ឆ្នាំ ២០២០ ក្រោម វត្តមាន លោក អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង ។
អភិបាល ខេត្ត បាត់ដំបង បាន ផ្តាំផ្ញើ ដល់ ឣភិបាល ក្រុង ស្រុក មេឃុំ ចៅសង្កាត់ ឱ្យ យកចិត្តទុកដាក់ ចូលរួម « កម្មវិធី ផ្តល់ សាច់ប្រាក់ ជូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ក្រីក្រ និង ងាយ រងគ្រោះ ដោយសារ ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ១៩ » ។
ក្នុង ឱកាស នោះ គណៈអធិបតី ក៏ បាន អញ្ជើញ ប្រគល់ បណ្ណ សរសើរ និង លិខិត សរសើរ ជូន ដល់ រដ្ឋបាល ឃុំ - សង្កាត់ ក្នុង ខេត្ត ដែល មាន ស្នាដៃ ល្អ ក្នុង ការបំពេញ ការងារ បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ បាន ល្អ ប្រសើរ ផងដែរ ៕ អាវុធហត្ថ ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ឃាត់ខ្លួន បាន ជនសង្ស័យ ម្នាក់ ពាក់ព័ន្ធ ករណី លួច និង ចែកចាយ គ្រឿងញៀន
( ក្រចេះ ) ៖ កម្លាំង អាវុធហត្ថ ស្រុក ឆ្លូង ក្រោម ការបញ្ជា ពី លោក ឧត្ដមសេនីយ៍ ត្រី សាន្ដ ប៊ុន ថា ន មេបញ្ជាការ អាវុធហត្ថ ខេត្ត ក្រចេះ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ត្រី ផាត សុភក្រ័ វាសនា មេបញ្ជាការ អាវុធហត្ថ ស្រុក ឆ្លូង ក្រោម ការសម្របសម្រួល ពី លោក កែវ សុជាតិ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ក្រចេះ នៅ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២០ បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ជា មុខសញ្ញា ចោ លួច សកម្ម និង ចែកចាយ គ្រឿងញៀន នៅ ចំនុច អូរ ឈើ ទាល ភូមិ វាល កន្លែង ឃុំ កំពង់ដំរី ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
លោក ផាត សុភក្រ័ វាសនា បាន ឲ្យដឹង នៅ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ថា ប្រតិបត្ត ការបង្រ្កាប មុខ សញ្ញា លួច មាន ស្ថាន ទម្ងន់ ទោស និង ជួញដូរ ប្រើប្រាស់ នូវ សាធាតុ ញៀន នេះ ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ឈ្មោះ សាន សៃ ភេទ ប្រុស អាយុ ៥០ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបបរ មិន ពិតប្រាកដ រស់ នៅ ភូមិ វាល កន្លែង ឃុំ កំពង ដំរី ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
លោក ផាត សុភក្រ័ វាសនា បាន បន្ថែម ថា ប្រតិបត្ត ការបង្រ្កាប នេះ ដកហូត បាន វត្ថុតាង រួម មាន៖ ម្សៅ ក្រាម ពណ៌ ស ( ម៉ា ទឹកកក ) សង្ស័យ ជា សាធាតុ ញៀន ចំនួន ៦កញ្ចប់ ទូរសព្វ័ ចំនួន ១ គ្រឿង . កន្រ្តៃ១ កាំបិទ ផ្គាក១ . ម៉ូតូ ចំនួន ២គ្រឿង និង សម្ភារ ប្រើប្រាស់ គ្រឿង មួយចំនួន ។
ច្បាប់ សន្តិសុខ ជាតិ ថ្មី ដែល មាន ៦ជំពូក និង ៦៦ មាត្រា បាន ចែង ពី ទោស ឧក្រិដ្ឋ បួន ប្រភេទ ក្នុង នោះ រួម មាន៖ « សកម្មភាព បំបែក រដ្ឋ . វិទ្ធង្ស នា ប្រឆាំង រដ្ឋអំណាច . ភេរវកម្ម និង ការ គប់ គិត ជាមួយ បរទេស ក៏ ដូចជា កម្លាំង នៅ ខាងក្នុង ស្រុក បំផ្លាញ ដល់ សន្តិសុខ ជាតិ ។ នៅក្រោម ច្បាប់ ថ្មី នេះ មេ គំនិត និង អ្នកប្រព្រឹត្ត លើ្មស ធ្ងន់ធ្ងរ អាចនឹង ប្រឈមមុខ ជាប់ ពន្ធនាគារ អស់ មួយ ជីវិត ឬ ជាប់ ពន្ធនាគារ រយៈពេល យូរ បំផុត ១០ ឆ្នាំ ឬ ក៏ អាច ច្រើន ជាង នេះ សម្រាប់ ការប្រព្រឹត្ត បទឧក្រិដ្ឋ ទំាង បួន ប្រភេទ ខាងលើ ។
តែ ទោះ ជា យ៉ាង នេះ ក្ដី ចិន និង រដ្ឋាភិបាល ទីក្រុង ហុងកុង នៅតែ បញ្ជាក់ ជំហរ ដដែល ថា ច្បាប់ នេះ មាន គោលដៅ តែ លើ ឧក្រិដ្ឋ ជន ប៉ុណ្ណោះ ហើយ វា នឹង មិន ធ្វើឱ្យ ប៉ះពាល់ អ្វី ទាំងអស់ ដល់ សេរីភាព របស់ ប្រជាជន ទីក្រុង ហុងកុង ។ ផ្ទុយទៅវិញ ច្បាប់ នេះ នឹង ជួយ ពង្រឹង សន្តិសុខ សណ្ដាប់ធ្នាប់ របស់ ទីក្រុង ហុងកុង ក៏ ដូចជា គោល នយោបាយ « ប្រទេស មួយ ប្រព័ន្ធ ពីរ » ។
ម្យ៉ាង វិញ ទៀត ទោះបីជា ទីក្រុង វ៉ាស៊ីនតោន បាន ចាត់ វិធានការ មួយចំនួន ដូចជា ការរឹតត្បិត ទិដ្ឋាការ លើ មន្ត្រី ចិន និង ដក ឋានៈ ពិសេស របស់ ហុងកុង ក្នុង នាម ជា មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ អាស៊ី ស្រប តាម ច្បាប់ របស់ អាមេរិក រួចទៅហើយ ក្តី ក៏ ប្រទេស ចិន នៅតែ អនុម័ត ច្បាប់ នេះ ដដែល ។ តើ ហេតុ អ្វី បានជា ចិន ជម្នះ ដាក់ ច្បាប់ សន្តិសុខ ជាតិ លើ ទីក្រុង ហុងកុង ទាំង ដែល ដឹង ថា សហរដ្ឋ អាមេរិក និង បណ្ដា ប្រទេស លោក ខាងលិច នឹង ចាត់ វិធានការឆ្លើយ ?
អ្នកនយោបាយ ហុងកុង គាំទ្រ ទីក្រុង ប៉េកាំង និង ទីប្រឹក្សា គោល នយោបាយ ចិន មួយចំនួន បាន ស្នើ ឱ្យ បង្កើត ច្បាប់ សន្តិសុខ ជាតិ ថ្មី នេះ ដើម្បី ពង្រឹង ច្បាប់ និង រក្សា សណ្ដាប់ធ្នាប់ ក៏ ដូចជា ទប់ស្កាត់ កុំ ឱ្យ បាតុកម្ម តវ៉ា ដូច កាលពី ឆ្នាំ ២០១៩ ផ្ទុះឡើង ជាថ្មី ម្ដង ទៀត ។ ក៏ប៉ុន្តែ អ្នកជំនាញ មួយចំនួន យល់ ថា វត្ថុ បំណង របស់ ចិន អាច មាន ច្រើន ជាង នេះ នោះ គឺ ចិន ចង់ឱ្យ ទីក្រុង ហុងកុង ដូច ទីក្រុង ម៉ាកាវ ។
បន្ថែម ពីលើ នេះ បើ តាម អតីត មន្ត្រី ជាន់ ខ្ពស់ ទីក្រុង ហុងកុង លោក Lau Siu-kai ការអនុម័ត ច្បាប់ សន្តិសុខ ជាតិ ថ្មី របស់ ចិន សម្រាប់ ទីក្រុង ហុងកុង ក៏ មាន ជាប់ពាក់ព័ន្ធ នឹង សកម្មភាព របស់ សហរដ្ឋ អាមេរិក ផងដែរ ។ ដ្បិត ជម្លោះ និង ភាពតានតឹង កាន់ ជ្រៅ រវាង សហរដ្ឋ អាមេរិក និង ចិន នា ពេល បច្ចុប្បន្ន បាន ធ្វើឱ្យ ថ្នាក់ដឹកនាំ គណបក្ស កុម្មុយនិស្ដ ចិន មាន ការព្រួយបារម្ភ រឹតតែ ខ្លាំង ពី ឥទ្ធិពល លោក ខាងលិច លើ ទីក្រុង ហុងកុង ។
គួរ បញ្ជាក់ ថា នៅក្រោម កិច្ចព្រមព្រៀង ប្រគល់ ទីក្រុង ហុងកុង មក ឱ្យ ចិន គ្រប់គ្រង វិញ នៅ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ១៩៩៧ រវាង ទីក្រុង ប៉េកាំង និង អង់គ្លេស ចិន មិន ទាន់ មាន អំណាច ពេញលេញ លើ ទីក្រុង ហុងកុង ឡើយ ដោយ ត្រូវ រង់ចាំ រហូត ទាល់តែ « គោល នយោបាយ ប្រទេស មួយ ប្រព័ន្ធ ពីរ » ត្រូវ អស់ សុពលភាព នៅ ឆ្នាំ ២០៤៧ ទើប ចិន មាន អំណាច គ្រប់គ្រង ទីក្រុង ហុងកុង ទាំងស្រុង ៕
( កំពង់ស្ពឺ ) ៖ លោក កៅ ថា ច អគ្គ នាយក ធនាគារ អភិវឌ្ឍន៍ ជនបទ និង កសិកម្ម នៅ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ជំរុញ និង លើកទឹកចិត្ដ ឲ្យ ប្រជាពលរដ្ឋ ចេះ ចាប់ យក ឱកាស មាស នៃ ការចិញ្ចឹម ជ្រូក ដោយសារតែ ប្រទេស វៀតណាម កំពុង ខ្វះខាត ជ្រូក យ៉ាង ធ្ងន់ធ្ងរ ។
បច្ចុប្បន្ន ប្រទេស វៀតណាម កំពុងតែ ជួប វិបត្ដិ ខ្វះខាត ជ្រូក សម្រាប់ ផ្គត់ផ្គង់ ក្នុង ស្រុក ដោយសារតែ ជួប ជំងឺ ប៉េស ជ្រូក អាហ្វ្រិក ដែល ធ្វើឲ្យ ជ្រូក របស់ វៀតណាម រាប់ លាន ក្បាល ត្រូវបាន សម្លាប់ ចោល ។
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង កម្មវិធី ផ្សព្វផ្សាយ ស្ដី អំពី លទ្ធភាព ឥណទាន ដល់ កសិករ ចិញ្ចឹម សត្វ វារី វប្បកម្ម ដាំ បន្លែ ផ្លែ ឈើ និង សហគ្រាស កែច្នៃ ផលិតផល កសិកម្ម ក្រោម អធិបតីភាព លោក វី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នា ព្រឹក ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
លោក កៅ ថា ច បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « បងប្អូន ឃើញ ជ្រូក ឡើង ថ្លៃ អត់ អា ហ្នឹង ដោយសារ កូវី ដ១៩ ព្រោះ យើង ផ្គត់ផ្គង់ ក្នុង ស្រុក អត់ គ្រប់ វា អាចនឹង ខ្វះ ។ ម្នាក់ ៗ កំពុងតែ ចិញ្ចឹម ជ្រូក ដោយសារតែ ទីផ្សារ ធំ មាន ច្រើន ចិន ត្រូវការ ជ្រូក ច្រើន វៀតណាម ត្រូវការ ជ្រូក ច្រើន » ។
លោក បន្ដ ទៀត ថា « ប្រទេស វៀតណាម កំពុងតែ ជួប ការខ្វះខាត ជ្រូក សម្រាប់ ផ្គត់ផ្គង់ ក្នុង ស្រុក ដោយសារតែ ជំងឺ ប៉េស ជ្រូក អាហ្វ្រិក ងាប់ រាប់ លាន ក្បាល ដូច្នេះ ធ្វើឲ្យ ចិញ្ចឹម អត់ ទាន់ ។ ខ្ញុំ គិត ថា នេះ ហើយ ជា ឱកាស មួយ ធំ ឱកាស កសាង មូលដ្ឋានគ្រឹះ សម្រាប់ វិស័យ កសិកម្ម ប្រកបដោយ សុវត្ថិភាព ដែល មិន មែន កសិកម្ម ប្រើ ដោយ គីមី » ។
ជាមួយគ្នា នោះ លោក កៅ ថា ច ក៏ បាន ស្នើ ដល់ បងប្អូន ប្រជាកសិករ ទាំងអស់ ត្រូវតែ យកចិត្ដទុកដាក់ ទៅ លើ សុខភាព ដែល មិន ត្រូវ ប្រើប្រាស់ សារធាតុ គីមី ហួស កម្រិត នោះ ទេ ខណៈ ប្រទេស ជិតខាង បាន ប្រើប្រាស់ គីមី ហួសហេតុ ដែល ប៉ះពាល់ សុខភាព ដល់ ប្រជាពលរដ្ឋ ។
លោក វេង សាខុន រដ្ឋមន្ដ្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ធ្លាប់ បាន បញ្ជាក់ ឲ្យដឹង ថា ក្នុង មួយ ថ្ងៃ ៗ កម្ពុជា មាន តម្រូវការ សត្វ ជ្រូក ប្រមាណ ១ម៉ឺន ក្បាល ។
ក្នុង នោះ ការចិញ្ចឹម ក្នុង ស្រុក គឺ មាន លទ្ធផល ផ្គត់ផ្គង់ រហូតដល់ ៥. ៨០០ ក្បាល ក្នុង ១ ថ្ងៃ ដោយ អនុញ្ញាតឲ្យ មាន ការនាំចូល ពី ៦ពាន់ - ៧ ពាន់ ក្បាល ដល់ ក្រុមហ៊ុន ចំនួន ៧ ដោយ ប្រើប្រាស់ វិធានការឃ្លាំមើល ប្រសិនបើ មាន ក្រុមហ៊ុន ណា ប្រព្រឹត្ត បទល្មើស នឹង កាត់បន្ថយ ការនាំចូល ។
រយៈពេល ៥ខែ ដើម ឆ្នាំ ២០២០ នេះ អគ្គ នាយកដ្ឋាន សុខភាព សត្វ និង ផលិតកម្ម សត្វ ទទួលបាន ការស្នើសុំ បង្កើត កសិដ្ឋាន ២៣កន្លែង ( ខ្នាត ធំ ៧កន្លែង ខ្នាត មធ្យម ២កន្លែង និង ខ្នាត តូច ១៤កន្លែង ) បើ ធៀប នឹង ឆ្នាំ ២០១៩ ពេញ មួយ ឆ្នាំ ទទួលបាន ការស្នើសុំ បង្កើត កសិដ្ឋាន ចំនួន ១០កន្លែង ។
លទ្ធភាព ផ្គត់ផ្គង់ ទីផ្សារ ក្នុង ស្រុក តាមរយៈ ការចិញ្ចឹម តាម កសិដ្ឋាន និង តាម គ្រួសារ ក្នុង ឆ្នាំ ២០២០ មាន ចំនួន ៥៨០០ ក្បាល ក្នុង ថ្ងៃ និង មាន ការនាំចូល បំពេញ បន្ថែម ចន្លោះ ពី ចំនួន ២. ៣៥០ក្បាល ទៅ ៤.៤០០ ក្បាល ក្នុង មួយ ថ្ងៃ ទៅ តាម តម្រូវការ តិច ឬ ច្រើន ៕
ពលរដ្ឋ នៅ ឃុំ ព្រៃ ព្នៅ ខេត្ត ព្រៃវែង ងាក មក ចិញ្ចឹម សត្វ ទា ព្រោះ តម្រូវការ ពង ទា កូន និង ពង ទា សាប កំពុង កើនឡើង ខ្ពស់
( ព្រៃវែង ) ៖ មន្ត្រី ការិយាល័យ ផលិតកម្ម និង បសុព្យាបាល នៃ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រៃវែង បាន ចុះ ចែក ថ្នាំ រម្ងាប់ មេរោគ ជូន កសិករ ចិញ្ចឹម ទាយក ស៊ុត និង ចុះ ពិនិត្យមើល ច្រវ៉ាក់ ផលិតកម្ម សត្វ ទា ចាប់ពី ភ្ញាស់ រហូត ពង លក់ លើ ទីផ្សារ នៅ ឃុំ ព្រៃ ព្នៅ ស្រុក ពារាំង ខេត្ត ព្រៃវែង ។
ការចុះ ចែក ថ្នាំ រម្ងាប់ មេរោគ ទាំងនេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២០ ដើម្បី លើកស្ទួយ ការចិញ្ចឹម សត្វ ទា របស់ ប្រជាពលរដ្ឋ ខណៈ តម្រូវការ ពង ទា កូន និង ពង ទា សាប នៅ ឃុំ នេះ កំពុង កើនឡើង ខ្ពស់ អំឡុង ពេល មាន វិបត្តិ កូវីដ១៩ ។
មន្ត្រី ផលិតកម្ម និង បសុព្យាបាល ខេត្ត ព្រៃវែង បាន ឲ្យដឹង ថា ដោយសារ តម្រូវការ ពង ទា កូន ពង ទា សាប លក់ លើ ទីផ្សារ ខ្ពស់ . កសិករ ដែល ប្រកបរបរ ភ្ញាស់ កូន ទា ក៏ កំពុង បង្កើន នូវ ការភ្ញាស់ កូន ទា ឲ្យ កសិករ ដទៃ ទៀត យក ទៅ ចិញ្ចឹម ឲ្យ ទាន់ តម្រូវការ ទីផ្សារ ពិសេស សម័យ កូវីដ១៩ នេះ ។ ជាក់ស្តែង ពង ទា មួយ គ្រាប់ តម្លៃ ៤២០ ៛ ទៅ ៤៣០ ៛ ម្លោះ ហើយ ទើប កសិករ ប្រឹង ដើរ រក ទិញ កូន ទា បន្ថែម ទៀត ដើម្បី ចិញ្ចឹម ឲ្យ ឆាប់ ធំធាត់ ឆាប់ ពង និង ឆាប់ បាន លក់ នៅលើ ទីផ្សារ ។
លោក បន្ថែម ថា បច្ចុប្បន្ន នេះ កសិករ មាន ចិត្ត សប្បាយរីករាយ ណាស់ លើ ការចិញ្ចឹម សត្វ នេះ ព្រោះ វា មាន តម្រូវការ ខ្ពស់ លើ ទីផ្សារ ក្នុង ពេល ពិភពលោក ជួប វិបត្តិ កូវីដ១៩ ហើយ អ្នកស្រុក កាត់បន្ថយ ទៅ ធ្វើ ចំណាកស្រុក ផង នោះ ពួកគាត់ ក៏ ងាក មក ចិញ្ចឹម ទា កាន់តែ ច្រើន ដើម្បី ផ្គត់ផ្គង់ ជីវភាព បាន មួយ កម្រិត ផងដែរ ៕
កោះ តៃវ៉ាន់ បើក ការិយាល័យ ថ្មី មួយ ដើម្បី ស្វាគមន៍ ប្រជាជន មកពី ហុងកុង
( តៃ ប៉ិ) ៖ កោះ តៃវ៉ាន់ នៅ ថ្ងៃពុធ ទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បើក សម្ពោធ ការិយាល័យ ថ្មី មួយ សម្រាប់ ដោះស្រាយ បញ្ហា របស់ ប្រជាជន ហុងកុង ដែល ចង់ ផ្តាស់ ទីលំនៅ មកកាន់ ដែន កោះ មួយ នេះ បន្ទាប់ពី ទីក្រុង ប៉េកាំង ទើបតែ បាន អនុម័ត ច្បាប់ សន្តិសុខ ថ្មី សម្រាប់ ហុងកុង កាលពី ថ្ងៃអង្គារ ម្សិលមិញ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA ។
ទន្ទឹម គ្នា នោះ មន្ត្រី ជាន់ ខ្ពស់ របស់ តៃវ៉ាន់ រូប នេះ ថែមទាំង បាន សង្កត់ធ្ងន់ ទៀត ថា « វា គឺជា សញ្ញា សម្គាល់ មួយ ដ៏ សំខាន់ ដើម្បី បញ្ជាក់ ឲ្យ កាន់តែ ច្បាស់ ថា តៃវ៉ាន់ នៅ គាំទ្រ លិទ្ធិ ប្រជាធិបតេយ្យ និង សេរីភាព របស់ ហុងកុង »។ បន្ថែម ពី នេះ ទៀត រដ្ឋាភិបាល កោះ តៃវ៉ាន់ បាន សង្កត់ធ្ងន់ ថា ខ្លួន នឹង ទទួល រ៉ាប់ រ៉ង លើ ការចំណាយ ចាយវាយ ដែល ចាំបាច់ ទាំងអស់ សម្រាប់ អ្នក ដែល គេចខ្លួន មក រស់ នៅ ដែនដី កោះ មួយ នេះ ក្រោម ហេតុផល នយោបាយ ត្បិត ថា សេរីភាព និង សុវត្ថិភាព របស់ ពួកគេ ស្ថិត ក្រោម ការគំរាមកំហែង ។
ប្រជាជន ហុងកុង ប្រមាណ ៥.០០០ នាក់ បាន ធ្វើ ការផ្លាស់ ទីលំនៅ ទៅ រស់ នៅ កោះ តៃវ៉ាន់ ខណៈពេល ដែល ទីក្រុង ហុងកុង មាន ការរង្គោះរង្គើ ជាខ្លាំង ដោយ មហា បាតុកម្ម ប្រឆាំង នឹង រដ្ឋាភិបាល កាលពី ឆ្នាំ មុន ។
គួរ បញ្ជាក់ ថា កាលពី ព្រឹក ថ្ងៃពុធ នេះ អភិបាល ក្រុង ហុងកុង លោកស្រី ខារី ឡាំ បាន លើកឡើង ក្នុង ពិធី រំលឹក ខួប ឆ្នាំ ទី ២៣ នៃ ការប្រគល់ ហុងកុង ឲ្យ ចិន វិញ ថា ច្បាប់ សន្តិសុខ ថ្មី ដែល សភា ចិន ទើប បាន អនុម័ត កាលពី ថ្ងៃ ម្សិលមិញ នេះ គឺជា របត់ មួយ ដើម្បី នាំ ហុងកុង ចេញ ពី ភាពជាប់គាំង នា ពេល បច្ចុប្បន្ន និង ដើម្បី ស្តារ ស្ថិរភាព និង សណ្តាប់ធ្នាប់ ក្នុង ទីក្រុង នេះ ឡើងវិញ ។
( ភ្នំពេញ ) ៖ ប្រធាន អាណត្ដិ ថ្មី ក្លឹប រ៉ូត ថា រី ភ្នំពេញ សេន ត្រល លោក គង់ និមល បាន ថ្លែង ប្ដេជ្ញាចិត្ដ យ៉ាង មុតមាំ ក្នុង ការពង្រឹង និង ពង្រីក សកម្មភាព សប្បុរសធម៌ ជួយ ដល់ សង្គមជាតិ ជាពិសេស ជួយ រាជ រដ្ឋាភិបាល ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រី នៅ កម្ពុជា ។
លោក បាន ថ្លែង បន្ដ ថា សម្រាប់ រ៉ូត ថា រី ក្លឹប ភ្នំពេញ ចតុមុខ . រ៉ូត ថា រី ក្លឹប ភ្នំពេញ ខេពី ថល និង រ៉ូត ថា រី ក្លឹប ភ្នំពេញ សេន ត្រល ជា សាខា នៅ កម្ពុជា ក៏ បាន និង កំពុង ធ្វើ សកម្មភាព មនុស្សធម៌ យ៉ាង សកម្ម ផងដែរ ដើម្បី រួមចំណែក ជួយ ដល់ សង្គម ។
ក្នុង ឱកាស លោក ត្រូវបាន ទទួល តំណែង ជា ប្រធាន អាណាត្ដិ ថ្មី ( ២០២០ - ២០២១ ) របស់ រ៉ូត ថា រី ក្លឹម ភ្នំពេញ សេន ត្រល ដែល បាន ប្រារព្ធ ពិធី ផ្ទេរ តំណែង កាលពី ចុង ខែមិថុនា ឆ្នាំ ២០២០ នេះ បាន ថ្លែង ប្ដេជ្ញាចិត្ដ និង ក្ដីរំភើប យ៉ាង ក្រៃលែង ដែល បាន ទទួលយក នូវ ភារកិច្ច ដ៏ ពិសេស និង សំខាន់ មួយ នេះ ក្នុង ការបន្ដ ជួយ ប្រជាពលរដ្ឋ ខ្វះខាត ។
លោក បាន ថ្លែង បន្ដ ថា រ៉ូត ថា រី ជា ក្លឹប ដែល មាន សមាជិក ជា ម្ចាស់ អាជីវកម្ម និង ពហុ ជំនាញ ជាច្រើន ដែល គោលបំណង ធ្វើ ការងារ សប្បុរសធម៌ ជួយ ដល់ ប្រជាជាតិ នៅក្នុង សហគមន៍ ហើយក៏ បាន ផ្សារភ្ជាប់ រវាង សមាជិក ទាំងអស់ ដូចជា គ្រួសារ តែ មួយ ផងដែរ ។
លោក គង់ និមល បាន បញ្ជាក់ ទៀត ថា « ក្នុង នាម ខ្ញុំ ជា ប្រធាន អាណត្តិ ទី២នេះ សូម កោតសរសើរ នូវ ទឹកចិត្ត របស់ ប្រធានបង្កើត ក្លឹប CP Yuan ដែល លោក ចំណាយ ពេលវេលា ទ្រព្យសម្បត្តិ ខិតខំ បង្កើត ក្លឹប នេះ ឡើង ដើម្បី ជា ប្រយោជន៍ ជួយ ទៅដល់ ប្រទេសជាតិ យើង មិន ថា ថ្ងៃ នេះ ឬ ទៅ ថ្ងៃ អនាគត ហើយ នេះ គឺជា ការបន្សល់ទុក នូវ ដើមទុន មួយ យ៉ាង សំខាន់ សម្រាប់ ពួកយើង ដែល ជា សមាជិក រ៉ូត ថា រី ក្លឹប ភ្នំពេញ សេន ត្រល ក្នុង ការធ្វើ ការងារ សង្គម របស់ យើង ទាំងអស់ គ្នា ផងដែរ » ។
( ភ្នំពេញ ) ៖ គេ ប្រហែលជា នៅ ចាំ មិន ទាន់ ភ្លេច នៅឡើយ នោះ ទេ ពី ការប្រកាស ក្តែង របស់ ទណ្ឌិត សម រង្ស៉ី ដោយ យក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ដើម្បី វិល ចូល កម្ពុជា វិញ ទោះ ត្រូវ ប្រឈមមុខ នឹង ទោសទណ្ឌ ឬ វិធានការ ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល ក៏ដោយ នោះ ។
តែ ទីបំផុត នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា នោះ គេ មិន បាន ឃើញ មុខ ទណ្ឌិត ដែល មាន រហស្សនាម ជា ជន កំសាក រូប នេះ ចូល មកកាន់ ប្រទេស កម្ពុជា តាម ការប្រកាស របស់ ខ្លួន នោះ ឡើយ ។ កុំ ថា ឡើយ វិល ចូល ស្រុក សូម្បីតែ សំបុត្រ យន្តហោះ ក៏ ទណ្ឌិត រត់ ចោល ស្រុក រូប នេះ មិន បាន ទិញ ផង ។
ដើម្បី លុប លាង នូវ ភាពអាម៉ាស់ និង ភាពកំសាក របស់ ខ្លួន ចំពោះ មុខ របស់ អ្នកគាំទ្រ នោះ ទណ្ឌិត សម រង្ស៉ី បាន ព្យាយាម ពន្យល់ អ្នកគាំទ្រ ថា ការ មិន វិល ចូល ស្រុក នេះ ព្រោះតែ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ នូវ វិធានការរាំងខ្ទប់ ដំណើរ របស់ លោក ។ ការព្យាយាម រក ហេតុផល មក លាង ភាពកំសាក របស់ ខ្លួន នេះ ក៏ ធ្វើឱ្យ អ្នកគាំទ្រ មួយចំនួន បន្ត លុង ជឿជាថ្មី លើ ទណ្ឌិត សម្បូរសម្តី បោក នេះ បើ ទោះបី រង ការចាញ់បោក រឿង ប្រកាស ចូល ស្រុក នេះ ច្រើន សារ ក៏ដោយ នោះ ។
តែ ពេល ល្បិច ខិល ខូច និង កំសាក របស់ លោក សម រង្ស៉ី ត្រូវបាន លាតត្រដាង ខ្ទេចខ្ទី គ្មាន សល់ ។ លោក ហ៉ីង សុខ សាន អតីត ប្រធាន យុវជន អតីត គណបក្ស សង្គ្រោះ ជាតិ ក្នុង វេទិកា របស់ ឌឹ ខេម បូឌែ ដេលី កាលពី រាត្រី ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០២០ បាន ចេញមក អះអាង ថា ការរៀបចំ គម្រោង ឱ្យ ទណ្ឌិត សម រង្ស៉ី វិល ចូល ស្រុក វិញ នេះ មិន មែន ទើប មាន នៅ ឆ្នាំ ២០១៩ នោះ ទេ គឺ គេ បាន រៀបចំ ឱ្យ វិល ចូល ស្រុក នៅ ឆ្នាំ ២០១៨ មុនពេល បោះឆ្នោត ជាតិ ទៅ ទៀត តែ ទណ្ឌិត រូប នេះ មិន ចូល នោះ ឡើយ ។
លោក ហ៉ីង សុខ សាន បាន ចាត់ទុក ភាព កំសាក របស់ ទណ្ឌិត សម រង្ស៉ី មិន ចូល ស្រុក មួយ ដង ជា ពីរ ដង គឺជា កំហុស នយោបាយ ដ៏ ធ្ងន់ធ្ង របស់ ទណ្ឌិត សម រង្ស៉ី ៕ លោក ឯ ម ច័ន្ទ មករា ស្នើ ឱ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច ជួយ យោគយល់ ដល់ ជន មាន ពិការ ភាព ក្នុង ពេល ពង្រឹង ការអនុវត្តន៍ ច្បាប់ ចរាចរណ៍ ផ្លូវគោក
លោក ឯ ម ច័ន្ទ មករា បាន ថ្លែង ស្នើ យ៉ាង ដូចនេះ នា ព្រឹក ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតី ក្នុង កម្មវិធី សិក្ខាសាលា ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ប្រកាស អន្តរ ក្រសួង ស្តីពី « លក្ខខណ្ឌ នៃ ការចេញ បណ្ណ បើកបរ សម្រាប់ ជន មាន ពិការភាព » ដែល បាន រៀបចំឡើង នៅ ភោជនីយដ្ឋាន ដឹ ដ្រាម និង ដោយ មាន ការចូលរួម ពី តំណាង ក្រសួង សាធារណការ និង ដឹកជញ្ជូន តំណាង ក្រសួង សុខាភិបាល រួមទាំង មាន បងប្អូន មាន ពិការ ភាព ជាច្រើន នាក់ ទៀត ផងដែរ ។
លោក ឯ ម ច័ន្ទ មករា បាន បញ្ជាក់ ទៀត ថា នៅ ពេល នេះ ដែរ មន្ត្រី អន្តរ ក្រសួង កំពុងតែ ខិតខំ ធ្វើ យ៉ាងណា ឱ្យ បងប្អូន ដែល មាន ពិការ ភាព ឆាប់ បាន ប័ណ្ណ បើកបរបន្ថែម ទៀត ដើម្បី ផ្តល់ ភាពកាន់តែ ងាយស្រួល ក្នុង ការបំលាស់ ទី របស់ បងប្អូន ជន មាន ពិការភាព ក្នុង ការប្រកប ការងារ ដើម្បី រក ប្រាក់ ចំណូល បន្ថែម ដើម្បី ផ្គត់ផ្គង់ ក្នុង គ្រួសារ ។
លោក ថា ការរៀបចំ ឱ្យ ជន មាន ពិការភាព អាច ធ្វើ ប័ណ្ណ បើកបរ បាន នេះ គឺ ត្រូវ ចាប់ផ្តើម បាន ធ្វើ បាន តាំងតែពី មាន ច្បាប់ ស្តីពី ការការពារ និង លើកកម្ពស់ ជន មាន ពិការភាព មក ម្ល៉េះ តែ ដោយសារ ស្ថានភាព មិន អំណោយផល ដែល ត្រូវ អនុវត្តន៍ នូវ ការងារ សំខាន់ ៗ ផ្សេង ៗ ទើប បាន ពន្យារ រហូតមកដល់ ពេលនេះ ។
លោក វង សូត បាន លើកឡើង ថា សម្ភារ ដែល ទទួលបាន នា ពេលនេះ ក្រសួង សង្គមកិច្ច នឹង ធ្វើ ការចែកជូន បន្ត ដល់ កុមារ ដែល កំពុង ស្នាក់ នៅ កន្លែង ថែទាំ និង កុមារ ដែល បាន ធ្វើ សមាហរណកម្ម ទៅកាន់ គ្រួសារ សហគមន៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ។
ក្នុង នោះ ក្រសួង សង្គមកិច្ច នឹង ចាត់ចែង ផ្ដល់ជូន សាប៊ូ លាង ដៃ សម្រាប់ កុមារ ស្នាក់ នៅក្នុង មណ្ឌល ថែទាំ ក្នុង មួយ នាក់ ចំនួន ៥ដុំ រីឯ កុមារ សមាហរណកម្ម ទៅ គ្រួសារ ឬ សហគមន៍ ក្នុង រាជធានី ខេត្ត ទាំង ៥ទទួលបាន ៥ដុំ ក្នុង មួយ នាក់ និង សម្រាប់ កុមារ សមាហរណកម្ម ក្នុង ទីតាំង ខេត្ត ២០ ផ្សេង ទៀត ទទួលបាន ៧ដុំ ក្នុង មួយ នាក់ ។
សម្រាប់ ជេល លាង ដៃ វិញ នឹង បែងចែកជូន ដល់ មន្ទីរ និង បុគ្គលិក សង្គមកិច្ច រីឯ ម៉ាស ការពារ នឹង បែងចែក ដល់ កុមារ កំពុង ស្នាក់ នៅក្នុង កន្លែង ថែទាំ នៅ រាជធានី ភ្នំពេញ បាត់ដំបង ចំនួន ២២កេស ក្នុង មួយ ខេត្ត ហើយ ខេត្ត ដទៃ ផ្សេង ទៀត ទទួលបាន ចំនួន ២១កេស ក្នុង ១ ខេត្ត ។
Ryanair ត្រូវបាន គេ ស្គាល់ ថា ជា អាកាសចរណ៍ សន្សំ សំចៃ ធំ បំផុត របស់ អឺរ៉ុប ទើបតែ បាន ប្រកាស កាលពី ពេល ថ្មី ៗ នេះ ប៉ុណ្ណោះ ខ្លួន បាន កាត់បន្ថយ បុគ្គលិក សរុប ២៥០ នាក់ រួចទៅហើយ ពី ការិយាល័យ ប្រតិបត្តិ នានា នៅ ទូទាំង តំបន់ អឺរ៉ុប ហើយ ក្រុមហ៊ុន នេះ ក៏ គ្រោង កាត់បន្ថយ បុគ្គលិក ជាង ៣.០០០ នាក់ ទៀត ផងដែរ ស្ថិត នៅក្នុង ជួរ អាកាសយានិក និង អ្នកបម្រើ ការងារ លើ យន្តហោះ ។
តាមរយៈ សេចក្តីថ្លែងការណ៍ របស់ ខ្លួន ប្រតិភូ សហភាព អឺរ៉ុប ប្រចាំ នៅ ប្រទេស លីប៊ី បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « យើង សូម អំពាវនាវ ដល់ តួអង្គ ទាំងអស់ នៅក្នុង ប្រទេស លីប៊ី ចូលរួម ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង លុបចោល សកម្មភាព ហ៊ុមព័ទ្ធ អណ្តូង ប្រេង ។ យើង សូម ថ្កោល ទោស ពេញ ទំហឹង ចំពោះ វត្តមាន របស់ ទាហាន បរទេស ស៊ីឈ្នួល នៅក្នុង ប្រទេស មួយ នេះ រួមទាំង តំបន់ ប្រេង សាហារ៉ា (Sharara) ព្រមទាំង ហេដ្ឋារចនាសម្ព័ន្ធ ប្រេង ផ្សេង ៗ ទៀត ផងដែរ » ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ ដដែល នេះ បាន សង្កត់ធ្ងន់ ទៀត ថា « វត្តមាន របស់ ទាហាន បរទេស ស៊ីឈ្នួល បាន បង្ក គ្រោះថ្នាក់ ដល់ ភាពត្រឹមត្រូវ នៃ ការដំឡើង គ្រឿង បរិក្ខា ក៏ ដូចជា ទីតាំង សម្រាប់ ការផលិតកម្ម ប្រេង របស់ លីប៊ី ក្នុង រយៈពេល យូរអង្វែង » ។
