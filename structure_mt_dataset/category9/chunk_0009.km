( ភ្នំពេញ ) ៖ ក្រុមការងារ របស់ រាជ រដ្ឋាភិបាល បាន ទទួលយក សំណើ ពី អង្គការ សង្គម ស៉ីវិល ដែល សុំ ធ្វើ វិសោធនកម្ម ចំនួន ១៧មាត្រា ក្នុង ច្បាប់ ស្តីពី សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ដែល សំណើ នេះ ត្រូវបាន ទទួលយក នៅ ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក្នុង កិច្ចប្រជុំ ពិភាក្សា ពិគ្រោះយោបល់ លើ សំណើ សុំ ធ្វើ វិសោធនកម្ម ច្បាប់ ស្ដីពី សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល នៅ ទីស្តីការ ក្រសួង មហាផ្ទៃ ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន រួម ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
សេចក្តីប្រកាស ព័ត៌មាន រួមរវាង ក្រុមការងារ រាជ រដ្ឋាភិបាល និង អង្គការ សង្គម ស៉ីវិល បាន ឲ្យដឹង ថា ផ្អែក លើ លទ្ធផល នៃ វេទិកា ស្ដីពី ភាពជាដៃគូរ វាង រាជ រដ្ឋាភិបាល និង សង្គម ស៉ីវិល លើក ទី៣ កាលពី ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០១៩ កន្លងមក តំណាង អង្គការ សង្គម ស៉ីវិល ប្រមាណ ៥០០ បាន ស្នើសុំ ឲ្យ រាជ រដ្ឋាភិបាល ធ្វើ ការពិនិត្យ និង ពិចារណា លើ សំណើ សុំ ធ្វើ វិសោធនកម្ម ច្បាប់ ស្ដីពី សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ។
ផ្អែក លើ មូលដ្ឋាន នេះ ក្រុមការងារ របស់ រាជ រដ្ឋាភិបាល ដើម្បី សម្របសម្រួល ដោះស្រាយ សំណើ និង សំណូមពរ របស់ អង្គការ សង្គម ស៉ីវិល បាន រៀបចំ កិច្ចប្រជុំ ពិភាក្សា និង ពិគ្រោះយោបល់ ជាមួយ តំណាង អង្គការ សង្គម ស៉ី វិល ដើម្បី ស្វែងយល់ ពី គោលបំណង និង ហេតុផល ក្នុង ការលើក សំណើរ ធ្វើ វិសោធនកម្ម ច្បាប់ នេះ ដោយ បាន ចាប់ផ្ដើម ក្នុង អំឡុង ខែវិច្ឆិកា ឆ្នាំ ២០១៩ រហូតដល់ ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ដែល ជា កិច្ចប្រជុំ លើក ទី៦ និង ជា លើក ចុងក្រោយ ផងដែរ ។
ក្រុមការងារ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូច ក្រសួង មហាផ្ទៃ ក៏ បាន ប្ដេជ្ញា ថា នឹង រៀបចំ នូវ កិច្ចប្រជុំ ពិគ្រោះយោបល់ បន្ដ ទៀត ជាមួយ តំណាង អង្គការ សង្គម ស៉ី វិល ក្នុង គោលបំណង ពង្រឹង ភាពជាដៃគូ រវាង រាជ រដ្ឋាភិបាល និង អង្គការ សង្គម ស៉ី វិល ដើម្បី ពង្រឹង ពង្រីក ដំណើរការលទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ៕
សមត្ថកិច្ច ឃាត់ បុរស ម្នាក់ មាន ឧបករណ៍ សម្រាប់ កាច់ ក ម៉ូតូ . ពេល សួរនាំ ទើប ដឹង ថា ជំនាញ ខាង លួច ម៉ូតូ
( ភ្នំពេញ ) ៖ ជនសង្ស័យ ម្នាក់ ត្រូវ ឃាត់ខ្លួន ពេល កម្លាំង នគរបាល ល្បាត ពួន ស្ទាក់ មាន ការសង្ស័យ . ពេល សួរនាំ ធ្លាយ រឿង ករណី លួច ម៉ូតូ២ គ្រឿង ក្នុង មូលដ្ឋាន ។
ជនសង្ស័យ ឈ្មោះ រុន ទី យ៉ា ភេទ ប្រុស អាយុ ៣២ ឆ្នាំ មុខរបរ កម្មករ សំណង់ ស្នាក់ នៅ បន្ទប់ ជួល ភូមិ ៥ សង្កាត់ ផ្សា ដើម ថ្កូវ ខណ្ឌ ចំការមន ធ្លាប់ ប្រើ គ្រឿងញៀន រយៈពេល ២ឆ្នាំ ជាង និង បាន សារភាព ខ្លួន ធ្លាប់ លួច ម៉ូតូ ចំនួន ២គ្រឿង ក្នុង ដើម ខែកក្ដ ដា ឆ្នាំ ២០២០ ។
លោក ផន អូន អធិការ រង ខណ្ឌ បាន ប្រាប់ ឲ្យដឹង ថា មុន កើត ហេតុ នគរបាល ប៉ុស្តិ៍ សហការ ជាមួយ ព្រហ្មទណ្ឌ ល្បាត ក្នុង ភូមិសាស្រ្ត ដើម្បី បង្ការ បទល្មើស ផ្សេង ៗ ក្នុង មូលដ្ឋាន ក៏ បាន ជួបប្រទះ បុរស ជនសង្ស័យ ខាងលើ ឆែក ត្រួតពិនិត្យ រកឃើញ ដែក ទី ប និង ដែក ចុង ស្រួច ( ជា ឧបករណ៍ សំរាប់ កាច់ ក ម៉ូតូ ) រួច នាំយក មក ប៉ុស្តិ៍ សាកសួរ នាំ ។
នគរបាល ក៏ បាន ឲ្យ ម៉ូតូ ដែល ប្រជាពលរដ្ឋ ប្រទះឃើញ ដកហូត ទុកចោល នៅ ដីឡូតិ៍ ហើយ ជនសង្ស័យ ឆ្លើយ ថា ពិតជា ម៉ូតូ ខ្លួន ធ្លាប់ លួច កន្លែង មក មែន ។
លោក អធិការ បន្ត ថា ម៉ូតូ ២ គ្រឿង ម៉ាក ស្គុប ពី ពណ៌ ស ពាក់ ស្លាកលេខ ភ្នំពេញ ១HY ០៧៩២ និង ម៉ូតូ អាគុប មូល ពណ៌ ទឹក ប៊ិច គ្មាន ស្លាកលេខ នេះ នគរបាល ប៉ុស្តិ៍ ផ្សារ ដើម ថ្កូវ បាន ល្បាត ឃើញ ប្លុង ចោល នៅ ដីឡូតិ៍ ទុកចោល កាលពី ថ្ងៃទី ០៣ និង ថ្ងៃទី ០៤ ក្នុង ខែកក្កដា ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម ផ្លូវ ច្បាប់ ចំណែក ម៉ូតូ២ គ្រឿង និង ស្រាវជ្រាវ រក ម្ចាស់ ដើម្បី បន្ថែម បន្ទុក លើ ជនសង្ស័យ ឲ្យ ធ្ងន់ បន្ថែម ទៀត ៕
( ឧត្តរមានជ័យ )៖ លោក គន់ គីម សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល នៃ គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈ ពង្រឹង ការងារ ខេត្ត ឧត្តរមានជ័យ នៅ ថ្ងៃអាទិត្យ ទី០៥ ខែកក្កដា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ បាន ដឹកនាំ ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិក បក្ស ប្រជាជន កម្ពុជា ខេត្ត ឧត្តរមានជ័យ ប្រជុំ បូកសរុប លទ្ធផល ការងារ បក្ស ប្រចាំ ឆមាស ទី១ និង លើក ទិសដៅ សម្រាប់ ឆមាស ទី២ ក្នុង ឆ្នាំ ២០២០ ។
ក្នុង កិច្ចប្រជុំ នេះ គណៈកម្មការបក្ស ខេត្ត ឧត្តរមានជ័យ បាន បង្ហាញ របាយការណ៍ មួយចំនួន ដែល សមាជិក សមាជិកា បក្ស សម្រេចបាន នៅក្នុង ឆមាស ទី១។ ជាពិសេស កម្មភាព ចុះ ជួយ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ក្នុង ជីវភាព ដោយសារ ការរាត ត្បាត ជំងឺ កូវីដ១៩ និង ការចុះ ផ្សព្វផ្សាយ អប់រំ ជូន ប្រជាពលរដ្ឋ ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ជម្នះ នូវ ឧបសគ្គ ទាំងឡាយ របស់ ជាតិ ។
ក្នុង របាយការណ៍ បាន បង្ហាញ ថា រយៈពេល ៦ខែ ឆ្នាំ ២០២០ អនុវត្ត តាម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ក្រុមការងារ រួម ជាមួយ គណបក្ស គ្រប់ ថ្នាក់ បាន ចុះ ធ្វេី សកម្មភាព ឆ្ពោះទៅ មូលដ្ឋាន ចុះ ជួប ពលរដ្ឋ តាម ខ្នង ផ្ទះ និង ជួយ ឧបត្ថម្ភ ពលរដ្ឋ ជួប លំបាក ដោយ ផល ប៉ះពាល់ ពី ជំងឺ Covid-19 និង រងគ្រោះ ដោយ គ្រោះ ធម្មជាតិ ដោយ ចំណាយ អស់ ថវិកា ប្រមាណ ១ពាន់ ១០៥ លាន រៀល អង្ករ ២០០ តោន ក្រម៉ា២ម៉ឺន ក្រម៉ា និង សម្ភារៈ ជា ច្រេីន ទៀត ។
ក្នុង កិច្ចប្រជុំ នេះ លោក គន់ គីម បាន កើត សរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចប្រឹងប្រែង និង ការធ្វើ សកម្មភាព យ៉ាង សកម្ម របស់ សមាជិក សមាជិកា បក្ស ទាំងអស់ ក្នុង ការដោះស្រាយ ការលំបាក ទាំងឡាយ របស់ ប្រជាពលរដ្ឋ ស្រប តាម ទិសដៅ និង គោលបំណង របស់ បក្ស ជាពិសេស ការចង់បាន របស់ សម្តេច តេជោ ហ៊ុន សែន ។
បើ ទោះបីជា យ៉ាងណា លោក គន់ គីម បាន ក្រើន រំលឹក សមាជិក សមាជិកា បេសកកម្ម របស់ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ជាតិ និង ប្រជាជន គ្មាន ទីបញ្ចប់ នោះ ឡើយ ។ លោក គន់ គីម បាន ជំរុញ សមាជិក សមាជិកា ទាំងអស់ រួមគ្នា យកចិត្តទុកដាក់ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម បន្ត អនុវត្ត ឱ្យ កាន់តែ ប្រសេីរ ថែម ទៀត អំពី គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ។
ដេីម្បី ឆ្លេីយ តប បាន ទៅនឹង ការកែទម្រង់ វិមជ្ឈការ និង សហវិមជ្ឈការ មន្ត្រី លោក គន់ គីម បាន ប្រាប់ ទៅ មន្ត្រី បក្ស ដែល ភាគ ច្រើន សុទ្ធតែ ជា ថ្នាក់ដឹកនាំ ខេត្ត នោះ ថា ចាប់ពី ថ្នាក់ ខេត្ត ដល់ មូលដ្ឋាន ត្រូវ ខិតខំ ពង្រីក សមត្ថភាព និង បង្កេីន ស្មារតី ទទួលខុសត្រូវ ក្នុង ការបំពេញ ភារកិច្ច ត្រូវ គិត ការងារ រួម ជា ធំ ។
លោក គន់ គីម ក៏ រំលឹក សមាជិក បក្ស ឱ្យ ពង្រឹង ការសាមគ្គី ឯកភាព ផ្ទៃក្នុង បក្ស ដោយ ត្រូវ ចាំ ថា ការសាមគ្គី ឯកភាព គឺជា ចំណុច ខ្លាំង ដែល ធ្វេី ឱ្យ បក្ស ទទួលបាន ជោគជយ រហូតមកដល់ ពេលនេះ ។
សមាជិក គណៈ អចិន្ត្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា រូប នេះ ក៏ ក្រើន រំលឹក មន្ត្រី ឱ្យ លប់ បំបាត់ រាល់ ភាពអសកម្ម ទាំងឡាយ ដែល ជា សត្រូវ នឹង បំណងប្រាថ្នា របស់ ប្រជាជន ដែល ជា ម្ចាស់ ឆ្នោត ។ លោក បាន លើកឡើង ថា ត្រូវ ចងចាំ នូវ អភិក្រមទាំង ៥ « ឆ្លុះ កញ្ចក់ . ងូតទឹក . ដុះ ក្អែល . ព្យាបាល និង វះកាត់ » របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ជា ការរំលឹក និង ដាស់ សតិ ឱ្យ ការអនុវត្តន៍ ការងារ បម្រើ ជាតិ និង ប្រជាជន ទទួលបាន ប្រសិទ្ធភាព និង លទ្ធផល ល្អ ប្រសើរ ។
ក្នុង កិច្ចប្រជុំ នោះ លោក គន់ គីម ក៏ បាន ជំរុញ ការកសាង ឯកសារ នីតិវិធី ស្នេី សុំ កាត់ ដី ដែល មាន ពាក់ព័ន្ធ និង ដី សហគមន៍ ដី គម្រប ព្រៃ ឈេី ដី តំបន់ អភិរក្ស ។ល។ ដេីម្បី ស្នេី សុំ រាជ រដ្ឋាភិបាល កាត់ ឆ្វៀល ជូន ប្រជាពលរដ្ឋ ពាក់ព័ន្ធ ។
ជា ចុងក្រោយ លោក គន់ គីម ជំរុញ ឱ្យ ក្រុមការងារ គណបក្ស ត្រូវ បន្ត ចុះ ជួបប្រជាពលរដ្ឋ ជំរុញ ការបេីក វេទិការ សាធារណៈ ដេីម្បី ដោះស្រាយ បញ្ហា ប្រឈម ជូន ពួកគាត់ និង បន្ត រក អ្នកក្រីក្រ ងាយ រងគ្រោះ ដោយ ជំងឺ កូវីដ១៩ ក្នុង ជំហ៊ាន ទី២៕ ចិន ចេញ ការប្រកាស អាសន្ន កម្រិត ពណ៌ លឿង ពាក់ព័ន្ធ នឹង ព្យុះភ្លៀង នៅ តាម ខេត្ត ជាច្រើន
( ប៉េកាំង ) ៖ នៅ ថ្ងៃចន្ទ នេះ អាជ្ញាធរ ឧតុនិយម ចិន បាន ធ្វើ ការប្រកាស អាសន្ន « កម្រិត ពណ៌ លឿង » ចំពោះ ព្យុះភ្លៀង ខណៈ ដែល គ្រោះ ធម្មជាតិ ប្រភេទ នេះ កំពុង បន្ត បង្ក ការបំផ្លេច បំផ្លាញ តំបន់ នានា ស្ទើរ ទូទាំង ប្រទេស ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួរ នា រសៀល ថ្ងៃចន្ទ ទី០៦ ខែកក្កដា ឆ្នាំ ២០២០ ។
ក្នុង សេចក្តីប្រកាស ជូនដំណឹង ដដែល នេះ មជ្ឈមណ្ឌល ឧតុនិយម ជាតិ ចិន បាន សង្កត់ធ្ងន់ ទៀត ថា តំបន់ ខាងលើ នេះ នឹង មាន បរិមាណ ទឹកភ្លៀង លើស ពី ៨០មីលីម៉ែត្រ ក្នុង មួយ ម៉ោង អម ដោយ ផ្គរ រន្ទះ និង ខ្យល់ បក់ ខ្លាំង ផងដែរ ។ នៅ ចំពោះ ស្ថានការណ៍ បែប នេះ អាជ្ញាធរ ក្នុង តំបន់ បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ របស់ ខ្លួន ឲ្យ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ គ្រោះ ទឹក ជំនន់ និង គ្រោះ រអិល បាក់ ដី ដែល អាច បង្កឡើង ដោយ ព្យុះ ទឹកភ្លៀង ក្នុង កម្រិត ខ្ពស់ មួយ នេះ ។
( ព្រះសីហនុ) ៖ កម្លាំង ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ បាន បើក ប្រតិបត្តិការ បង្ក្រាប មុខ សញ្ញា លួច រថយន្ដ និង ក្រុម ជួញដូរ គ្រឿងញៀន ៣ករណី ផ្សេង គ្នា ដោយ ឃាត់ខ្លួន បាន ជនសង្ស័យ ចំនួន ៤នាក់ នៅ ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០២០ ។
ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ឲ្យដឹង ថា ករណទី១ បង្ក្រាប ករណី លួច រថយន្ត និង កាន់កាប់ ប្រើប្រាស់ អាវុធ ខុស ច្បាប់ នៅ ភូមិ ២ សង្កាត់ ៤ ក្រុង ព្រះសីហនុ ។ កម្លាំង ជំនាញ បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ២នាក់ ទី ១៖ ឈ្មោះ ណែម ភារុណ អាយុ៣០ ឆ្នាំ និង ទី២៖ ឈ្មោះ លី ង៉ែត អាយុ ២១ ឆ្នាំ ដកហូត បាន វត្ថុតាង អាវុធ ខ្លី១ ដើម បង់១ និង គ្រាប់ ៤គ្រាប់ ។ បច្ចុប្បន្ន កម្លាំង ជំនាញ កំពុង សាកសួរ រក រថយន្ត ដែល ជា ផល នៃ អំពើ លួច ។
ក្រោយ បិទ ទីតាំង ស្តុក ទុក មេឡេ និង ផលិតផល ៦៧ មុខ ខុស ច្បាប់ នៅ ក្រុង តាខ្មៅ . មន្ត្រី ជំនាញ ឲ្យ ម្ចាស់ អាជីវកម្ម ទៅ សុំ ច្បាប់ ខណៈ សំណាក ដែល ខូច ត្រូវ ដុត កម្ទេចចោល
( កណ្ដាល ) ៖ ក្រោយ បិទ ទីតាំង ច្រក វេចខ្ចប់ មេឡេ គីឡូ គ្រឿង ក្រអូប ជេល លាង ដៃ និង អាល់កុល ចំនួន ៦៧មុខ ដែល មាន ម្ចាស់ នៅ សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ បើក ដំណើរការ ព្រោះ គ្មាន ច្បាប់ អនុញ្ញាត តាំងពី ខែមេសា ឆ្នាំ ២០២០ មក . នៅ ពេល នេះ មន្រ្តី ជំនាញ ទុក ពេល ឱ្យ ម្ចាស់ ទីតាំង ទៅ សុំ ច្បាប់ ឱ្យ បាន ត្រឹមត្រូវ ហើយ សំណាក ដែល រកឃើញ មិន ប្រក្រតី នឹង ត្រូវ ដុត កម្ទេចចោល ។
លោក ឧត្តមសេនីយ៍ ទោ ក៏ បាន ជំរុញ និង អំពាវនាវ ដល់ រាល់ ម្ចាស់ អាជីវកម្ម សហគ្រិន ទាំងអស់ សូម រួសរាន់ ទៅ សុំ ច្បាប់ អនុញ្ញាត បើក អាជីវកម្ម ឱ្យ បាន ត្រឹមត្រូវ មុននឹង បើក អាជីវកម្ម ណាមួយ ដើម្បី ធានា បាន នូវ សុវត្ថិភាព អ្នកប្រើប្រាស់ និង ចូលរួម គោរព ច្បាប់ ទាំងអស់ គ្នា ។
សេចក្ដីរាយការណ៍ ឱ្យដឹង ថា ម្ចាស់ ទីតាំង នេះ មាន ឈ្មោះ គីម ភេទ ស្រី អាយុ ៤០ ឆ្នាំ សង្ស័យ មាន អ្នក នៅ ពីក្រោយ ទើប ហ៊ាន លួច បើក អាជីវកម្ម ខុស ច្បាប់ ទាំងនេះ ៕ ពលរដ្ឋ ក្រីក្រ និង ងាយ រងគ្រោះ ដោយសារ ជំងឺ កូវីដ - ១៩ នៅ ឃុំ សាលា វិស័យ ខេត្ត កំពង់ធំ ប្រមាណ ៨០០ គ្រួសារ ទទួលបាន សាច់ប្រាក់ ពី រាជ រដ្ឋាភិបាល
( កំពង់ធំ )៖ ប្រជាពលរដ្ឋ ក្រីក្រ និង ងាយ រងគ្រោះ ដោយសារ ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ - ១៩ នៅ ឃុំ សាលា វិស័យ ស្រុក ប្រាសាទ បល្ល័ង្ក ខេត្ត កំពង់ធំ ជាង ៨០០ គ្រួសារ បាន ទទួល សាច់ប្រាក់ ឧបត្ថម្ភ ពី រាជ រដ្ឋាភិបាល គិត ត្រឹម ថ្ងៃទី ០៥ ខែកក្ត ដា ឆ្នាំ ២០២០២ ។
លោក ជិន ហ៊ីន ប្រធាន ក្រុមប្រឹក្សា ឃុំ សាលា វិស័យ បាន ឱ្យដឹង ថា រដ្ឋបាល ឃុំ សាលា វិស័យ បាន អនុវត្ត បើក សាច់ប្រាក់ ជូន ប្រជាពលរដ្ឋ ចំនួន ៨ ថ្ងៃ ហើយ គឺ ចាប់ពី ថ្ងៃទី ២៦ ខែមិថុនា ឆ្នាំ រហូតមកដល់ ថ្ងៃទី ៥ ខែកក្កដា ។
ឃុំ សាលា វិស័យ មាន ភូមិ ចំនួន ១៩ ភូមិ ប្រជាពលរដ្ឋ ចំនួន ៣. ១២០ គ្រួសារ ដែល មាន ប្រជាជន សរុប ១៦. ៦៦០ នាក់ ស្រី ៧. ៨៨៨ នាក់ ក្នុង នោះ បាន ធ្វើ សម្ភាសន៍ ទទួលបាន បណ្ណ សមធម៌ ពី រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង ផែនការមាន ចំនួន ៩៤៥ គ្រួសារ ប្រភេទ ក្រ១ ចំនួន ៤២៥ គ្រួសារ និង ប្រភេទ ក្រ២ចំនួន ៥២០ គ្រួសារ ក្នុង នោះ សរុប ក្រ១ និង ក្រ២ មាន សមាជិក សរុប ៤៤៤០ នាក់ ស្រី ២២២០ នាក់ រហូតមកដល់ ពេលនេះ ការចែក ប័ណ្ណ សមធម៌ និង បើក សាច់ប្រាក់ ជូន គាត់ បាន ចំនួន ៨០០ គ្រួសារ ។
លោក បាន បន្ត ថា ការបើកប្រាក់ និង ធ្វើឱ្យ អស់ តែ ដោយ ជួប បញ្ហា ខ្លះ ដោយ មាន ការ ចំណាកស្រុក ការបើកប្រាក់ មាន ភាពយឺតយ៉ាវ ។
លោក បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម ទុកដាក់ ឯកសារ ការបើក សាច់ប្រាក់ នេះ ឱ្យ បាន ត្រឹមត្រូវ ហើយ ប្រសិនជា មាន ការបាត់ ដោយ ប្រការ ណាមួយ សូម រាយការណ៍ ជូន ដល់ អាជ្ញាធរ ឃុំ ជា បន្ទាន់ ដើម្បី ធ្វើ ការស្នើសុំ នូវ បណ្ណ ថ្មី សម្រាប់ ប្រើប្រាស់ នៅ ពេល ក្រោយ ។
ក្នុង នោះ ប្រធាន ក្រុមប្រឹក្សា បាន រំលឹក ដល់ ប្រជាពលរដ្ឋ គ្រប់ រូប ត្រូវ គោរព និង អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ នានា តាម ការកំណត់ របស់ ក្រសួង សុខាភិបាល និង តរូវ បន្ត រក្សា ការប្រុងប្រយ័ត្ន ខ្ពស់ ក្នុង ការបង្ការ និង ការពារ នូវ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ខណៈពេល ដែល ពិភពលោក កំពុង ប្រឈមមុខ នឹង ការរាត្បាត យ៉ាង ខ្លាំង ដោយសារ ជំងឺ មួយ នេះ ។
ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង ឃុំ សាលា វិស័យ ទាំងមូល សូម ថ្លែងអំណរ អរគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន យកចិត្តទុកដាក់ ទៅ លើ ពួកគាត់ នឹង ជួយ ជ្រោមជ្រែង គ្រប់ កាលៈទេសៈ ដែល ពួកគាត់ កំពុងតែ ជួប បញ្ហា ខ្វះខាត ជា បន្តបន្ទាប់ ក្នុង ដំណាក់កាល ដែល ប្រទេស កំពុងតែ ឆ្លង ជំងឺ កូវីត - ១៩ ជាពិសេស អរគុណ ដល់ ប្រមុខ ថ្នាក់ដឹកនាំ ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា ប្រមុខ រាជ រដ្ឋាភិបាល នៃ កម្ពុជា ៕
រសៀល នេះ ក្រសួង ផែនការ នឹង បើក កិច្ចប្រជុំ ដើម្បី ឆ្លុះបញ្ចាំង ពី ការអនុវត្ត នីតិវិធី កំណត់ អត្តសញ្ញាណ គ្រួសារ ក្រីក្រ តាម ការស្នើសុំ អំឡុង ពេល វិបត្តិ កូវីដ១៩
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ៦ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក្រសួង ផែនការ នឹង បើក កិច្ចប្រជុំ ដើម្បី ឆ្លុះបញ្ចាំង ពី ការអនុវត្ត នីតិវិធី កំណត់ អត្តសញ្ញាណ គ្រួសារ ក្រីក្រ តាម ការស្នើសុំ ក្នុង អំឡុង ពេល ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្រោម អធិបតីភាព លោក កិត្តិ សេដ្ឋា បណ្ឌិត ឆាយ ថន ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ផែនការ ។ ក្រោយ កិច្ចប្រជុំ ទេសរដ្ឋមន្ដ្រី ឆាយ ថន នឹង ផ្ដល់ បទសម្ភាសន៍ ជូន អ្នកសារព័ត៌មាន ផងដែរ ។
អ្នកនាំពាក្យ ក្រសួង ផែនការ បាន ឲ្យដឹង ថា កិច្ចប្រជុំ នេះ ក៏ នឹង ពិនិត្យមើល ភាព មិន ប្រក្រតី នៃ ការផ្តល់ បណ្ណ សមធម៌ ជូន គ្រួសារ ក្រីក្រ ការដាក់ចេញ នូវ វិធានការណ៍ មួយចំនួន ដូច ជា៖
* ផ្តល់ បណ្ណ សមធម៌ ជូន ដល់ គ្រួសារ ក្រីក្រ ពិតប្រាកដ តែ ប៉ុណ្ណោះ ដោយ មិន រើសអើង ស្រប តាម នីតិវិធី កំណត់ អត្តសញ្ញាណកម្ម គ្រួសារ ក្រីក្រ និង ធ្វើ ការដក បណ្ណ សមធម៌ ពី គ្រួសារ ដែល មាន ជីវភាព ប្រសើរ
* ករណី ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ជួប នូវ បញ្ហា មិន ប្រក្រតី ណាមួយ ដែល មិន អាច ដោះស្រាយ បាន ត្រូវ ទំនាក់ទំនង សហការ ជាមួយ មន្ទីរ ផែនការ រាជធានី ខេត្ត ដើម្បី ដោះស្រាយ លើ បញ្ហា នេះ ។ ជាមួយគ្នា នេះ ដែរ ក្រសួង ផែនការ នឹង ចូលរួម ពិនិត្យ ដោះស្រាយ ទៅ លើ ភាព មិន ប្រក្រតី ទាំងនោះ ហើយ អាច ធ្វើ ការបង្ខាំង បណ្ណ សមធម៌ របស់ គ្រួសារ ដែល មាន ជីវភាព ប្រសើរ ក្នុង ប្រព័ន្ធ មូលដ្ឋាន ទិន្នន័យ គ្រួសារ ក្រីក្រ មិន ឲ្យ ប្រើ បាន ។
ក្រសួង ផែនការ សង្ឃឹម ថា អាជ្ញាធរ មូលដ្ឋាន ពិសេស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ចូលរួម សហការ ជាមួយគ្នា បន្ថែម ទៀត ឲ្យ ទទួលបាន លទ្ធផល កាន់តែ គាប់ ប្រសើរ ស្រប តាម ការផ្តល់ សេចក្តីទុកចិត្ត ពី ប្រមុខ រាជ រដ្ឋាភិបាល ចំពោះ យើង ទាំងអស់ គ្នា ដើម្បីឲ្យ កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ របស់ រាជ រដ្ឋាភិបាល ជូន គ្រួសារ ក្រីក្រ ក្នុង អំឡុង ពេល ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ បាន សម្រេច ជោគជ័យ ៕
លោក ស៊ូ អារ៉ាហ្វាត់ ត្រូវបាន អង្គភាព ប្រឆាំង អំពើពុករលួយ នាំ មកកាន់ ស្នាក់ការ របស់ ខ្លួន នៅ រាជធានី ភ្នំពេញ នៅ ព្រលប់ ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ ពាក់ព័ន្ធ នឹង អំពើពុករលួយ រឿង ដីធ្លី នៅ ស្រុក គាស់ ក្រឡ ខេត្ត បាត់ដំបង ។ នេះ បើ តាម លោក ទេសរដ្ឋមន្រ្តី ឱម យ៉ិនទៀង ប្រធាន អង្គភាព ប្រឆាំង អំពើពុករលួយ បាន ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ២៧ ខែមិថុនា ឆ្នាំ ២០២០ អង្គភាព ប្រឆាំង អំពើពុករលួយ ក៏ បាន នាំ ខ្លួន លោក ឧកញ៉ា សង ថ ន មក សាកសួរ ពាក់ព័ន្ធ នឹង ករណី ពុករលួយ រឿង ដីធ្លី ធំ នៅ ស្រុក គាស់ ក្រឡ ខេត្ត បាត់ដំបង នេះ ដែរ ។
អាជ្ញាធរ ក្នុង តំបន់ បាន ចេញ សេចក្តីណែនាំ ថ្មី មួយ កាលពី ល្ងាច ថ្ងៃអាទិត្យ ដោយ បញ្ជា ឲ្យ ពន្យារ ពេល បន្ថែម ទៀត ចំពោះ ការដាក់ វិធានការរឹតត្បិត លើ វិមាន និង ប្រាសាទ នានា នៅក្នុង តំបន់ ជុំវិញ ទីក្រុង អាក្រា (Agra) ដ្បិត ថា ស្ថានការណ៍ COVID-19 នៅ មិន ទាន់ ធូរស្រាល នៅឡើយ ទេ ។ ទោះជា យ៉ាងណា បទបញ្ជា នេះ មិន បាន បញ្ជាក់ ពី រយៈពេល ពិតប្រាកដ នៃ ការពន្យារ ពេល បន្ថែម នេះ ទេ ។
( ភ្នំពេញ ) ៖ វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប ចាប់ដៃគូ ជាមួយ អ្នក វិនិយោគ កូរ៉េ ដើម្បី ពង្រឹង ការបណ្ដុះបណ្ដាល វិស័យ កសិកម្ម នៅ កម្ពុជា ។ ការចាប់ដៃគូរ វាង វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប នេះ គឺ មាន ការសម្របសម្រួល ពី ក្រុមហ៊ុន ហង្ស សុធី ។
ជាក់ស្ដែង នា ពេល ថ្មី ៗ នេះ លោក បណ្ឌិត ធន់ វឌ្ឍនា នាយក វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប បាន ជួប ជាមួយ អ្នក វិនិយោគទុន កូរ៉េ ដើម្បី ពិភាក្សា និង ធ្វើ កិច្ចសហការ អភិវឌ្ឍន៍ ក្នុង វិស័យ នេះ ។
គោលបំណង នៃ ជំនួប នេះ គឺ ដើម្បី ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា កូរ៉េ និង ពង្រឹង សមត្ថភាព បច្ចេកទេស កសិកម្ម ដល់ មន្ត្រីរាជការ និង និស្សិត កម្ពុជា ជាពិសេស រួមគ្នា បង្កើត ឱកាស វិនិយោគ លើ ផ្នែក កសិកម្ម ការដាំដុះ ដំណាំ ការចិញ្ចឹម សត្វ និង កែច្នៃ ជា ផលិតផល ពាក់កណ្តាល ស្រេច និង ផលិតផល សម្រេច សម្រាប់ បំពេញ តម្រូវការ ក្នុង ស្រុក និង ការនាំចេញ ព្រមទាំង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ កសិកម្ម និង លើ វិស័យ អាទិភាព ផ្សេង ទៀត នៅ កម្ពុជា ។
ភាគី កម្ពុជា មាន ក្តី សោមនស្ស រីករាយ យ៉ាង ក្រៃលែង ចំពោះ ការវិនិយោគទុន លើ វិស័យ កសិកម្ម នៅ កម្ពុជា ហើយ កំណត់ យក កម្ពុជា ជា តំបន់ គោលដៅ វិនិយោគ លើ គ្រប់ វិស័យ នឹង ផ្តល់ អាទិភាព ជា ចំបង ក្នុង វិស័យ កសិកម្ម នៅ កម្ពុជា ។ ចំណែក ភាគី កូរ៉េ មាន ក្តីរំភើប និង បង្ហាញ ចេញ នូវ សមាន ចិត្ត គោរព ចង់បាន ភាព ជាដៃគូ វិនិយោគ យូរអង្វែង ដ៏ ស្មោះត្រង់ ជាមួយ សមាភាគី វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប ។
ក្នុង ជំនួប នោះ លោក ហង្ស សុធី នាយក ក្រុមហ៊ុន ហង្ស សុធី បាន ប្រកាស ពី ការត្រៀម ដី ចំនួន ៥០០ ហិកតា សម្រាប់ ការអភិវឌ្ឍ ក្នុង វិស័យ កសិកម្ម នៅ កម្ពុជា ជាមួយ គម្រោង នេះ ផងដែរ ។
ភាគី ទាំង ពីរ បាន ព្រមព្រៀង គ្នា ក្នុង ការផ្តល់ អាហារូបករណ៍ ជូន ដល់ មន្ត្រីរាជការ និង និស្សិត កសិកម្ម កម្ពុជា ជាពិសេស វិទ្យាស្ថាន ជាតិ កសិកម្ម ព្រែក លៀប ផ្តល់ ឱកាស ឲ្យ បន្ត ការសិក្សា ជំនាញ បច្ចេកទេស កសិកម្ម ការកែច្នៃ ផលិតផល កសិកម្ម ការវេច ខ្ចប់ និង ការគ្រប់គ្រង ការអភិវឌ្ឍន៍ កសិកម្ម ក៏ ដូចជា ការធ្វើ ទស្សនកិច្ច សិក្សា ផ្លាស់ប្តូរ បទ បទពិសោធន៍ គ្នា ទៅ វិញ ទៅ មក រវាង សមភាគី កម្ពុជា និង កូរ៉េ ៕
