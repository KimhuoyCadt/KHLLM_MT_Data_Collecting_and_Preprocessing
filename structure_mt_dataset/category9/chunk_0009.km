( ភ្នំពេញ ) ៖ លោក ជិន ម៉ាលីន អនុប្រធាន និង ជា អ្នកនាំពាក្យ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន លើកឡើង ថា បញ្ហា សិទ្ធិ មនុស្ស គ្មាន ប្រទេស ណាមួយ ធ្វើ ចប់ ហើយ ធ្វើ បាន ល្អ ឥត ខ្ចោះ នោះ ទេ ខណៈ បច្ចុប្បន្ន កម្ពុជា មាន យន្តការ ច្បាប់ ជាច្រើន ពាក់ព័ន្ធ នឹង សិទ្ធិ មនុស្ស និង ការរើសអើង ពូជសាសន៍ ជាដើម ។ល ។
ការលើកឡើង បែប នេះ របស់ លោក ជិន ម៉ាលី ន បាន ធ្វើឡើង ក្រោយ បញ្ចប់ កិច្ចពិភាក្សា ការងារ រវាង លោក កែវ រ៉េមី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ជាមួយ លោក Pradeep Wage តំណាង ការិយាល័យ ឧត្តម ស្នងការទទួលបន្ទុក សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា ពាក់ព័ន្ធ នឹង ការតាមដាន ការអនុវត្ត អនុសាសន៍ UPR និង ការបង្កើត ស្ថាប័ន សិទ្ធិ មនុស្សជាតិ នៅ រសៀល ថ្ងៃទី១ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ទីស្នាក់ការ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ។
ឆ្លើយតប នឹង សំណួរ អ្នកសារព័ត៌មាន លោក ជិន ម៉ាលី ន បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « ពីព្រោះ រឿង សិទ្ធិ មនុស្ស នេះ គ្មាន ប្រទេស ណាមួយ ដែល ធ្វើចប់ ហើយ ល្អ ឥត ខ្ចោះ នោះ ទេ គឺ តែងតែ មាន ចំណុច ខ្វះខាត ហើយ សិទ្ធិ មនុស្ស នេះ គឺ ធ្វើ យ៉ាងម៉េច ឱ្យ ម នុស្ស រស់ នៅ បាន ល្អ ប្រសើរឡើង ហើយ ទៅ តាម សេចក្តីត្រូវការ របស់ មនុស្ស ដែល ទាមទារ តម្រូវការ ឥត ឈប់ឈរ » ។
លោក ជិន ម៉ាលី ន បាន បន្ត ថា ជាក់ស្តែង ថ្មី ៗ នេះ កម្ពុជា បាន បញ្ជូន គណៈប្រតិភូ មួយ ក្រុម ទៅ ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស ដើម្បី ការពារ របាយការណ៍ សិទ្ធិ មនុស្ស របស់ កម្ពុជា ពាក់ ព៏ន្ធ ការរើសអើង ពូជសាសន៍ ដែល បាន ដាក់ ជូន អង្គការ សហ ប្រជាជាតិ ទាន់ ពេល វេលា ។ បន្ថែម ពី នេះ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ក៏ បាន បញ្ជូន ប្រតិភូ ទៅ ការពារ របាយការណ៍ ផ្សេង ៗ ទៀត ផងដែរ ព្រមទាំង ទទួលយក អនុសាសន៍ មួយចំនួន របស់ អង្គការ សហ ប្រជាជាតិ ដើម្បី យកមក អនុវត្តន៍ បន្ត ទៀត ។
លោក បាន បញ្ជាក់ ថា៖ « ជាទូទៅ កម្ពុជា យើង បាន សម្រេច ការងារ ជាច្រើន ពាក់ព័ន្ធ នឹង ការរើសអើង ពូជសាសន៍ នេះ រួមទាំង យន្តការ ច្បាប់ យើង មាន យន្តការ ច្បាប់ ជាតិ របស់ យើង ក្របខណ្ឌ ច្បាប់ ក្របខណ្ឌ គោល នយោបាយ និង យន្តការ នៃ ការអនុវត្តន៍ មែនទែន ពាក់ព័ន្ធ នឹង ការរើសអើង ពូជសាសន៍ ដូចជា មិន មាន អី ធំដុំ អី ប៉ុន្មាន ទេ នៅ កម្ពុជា គ្រប់ ជាតិ សាសន៍ បាន រស់ នៅ ជាមួយគ្នា ប្រកបដោយ សុខុដុមរមនា » ។
ក្នុង នាម គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ដែល ដឹកនាំ ដោយ លោក កែវ រ៉េមី និង ក្នុង នាម រដ្ឋាភិបាល កម្ពុជា . លោក ជិន ម៉ាលី ន បាន បន្ថែម ថា កិច្ចការងារ សិទ្ធិ មនុស្ស នេះ គឺ កម្ពុជា ធ្វើការ មិន ឈប់ឈរ ជាដាច់ខាត ទោះបី បច្ចុប្បន្ន នេះ សិទ្ធិ មនុស្ស នៅ កម្ពុជា មាន ភាពល្អ ប្រសើរឡើង ក៏ដោយ ក៏ប៉ុន្តែ ត្រូវតែ ខិតខំ ធ្វើ វា ឱ្យ កាន់តែ ល្អ ប្រសើរឡើង បន្ថែម ទៀត ដូច្នេះ រាល់ អនុសាសន៍ ល្អ នានា ដែល ទទួលបាន គឺ កម្ពុជា ត្រូវតែ ខិតខំ អនុវត្ត ឱ្យ បាន ៕
ក្រសួង យុត្តិធម៌ សម្រេច បង្កើត ក្រុមការងារ បច្ចេកទេស រៀបចំ គោល នយោបាយ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ
( ភ្នំពេញ ) ៖ លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ បាន ចេញ សេចក្តីសម្រេច ស្តីពី ការបង្កើត ក្រុមការងារ បច្ចេកទេស រៀបចំ គោល នយោបាយ ដោះស្រាយ វិវាទ ក្រៅ ប្រព័ន្ធ តុលាការ ។
លទ្ធផល បាន បង្ហាញ ថា ប្រហែលជា ២ ភាគ ៣ នៃ អ្នកចូលរួម សរុប នៅ ប្រទេស ដាណឺម៉ាក ព័រទុយហ្គាល់ បារាំង អាល្លឺម៉ង់ និង អេស្ប៉ាញ បាន និយាយ ថា រូបភាព របស់ សហរដ្ឋ អាមេរិក នៅក្នុង ការគិត របស់ ពួក បាន ផ្លាស់ប្តូរ ទាំងស្រុង ខណៈ ដែល មាន តែ ២ ភាគរយ ប៉ុណ្ណោះ បាន និយាយ ថា សហរដ្ឋ អាមេរិក បាន ចូលរួមចំណែក ក្នុង កិច្ចខិតខំ ប្រយុទ្ធ ប្រឆាំង និង COVID-19 ។
គួរ បញ្ជាក់ ថា ការស្ទង់ មតិ នេះ ក៏ បាន បង្ហាញ ដែរ ថា ៤៦ ភាគរយ នៃ អ្នកចូលរួម ជនជាតិ បារាំង បាន និយាយ ថា ទស្សនៈ របស់ ពួកគេ ចំពោះ សហរដ្ឋ អាមេរិក កាន់តែ អាក្រក់ ឡើង ស្រប ពេល ដែល ៤២ ភាគរយ នៃ អ្នកចូលរួម ជនជាតិ អាឡឺម៉ង់ បាន និយាយ ថា កេរ្តិ៍ឈ្មោះ របស់ សហរដ្ឋ អាមេរិក កាន់តែ យ៉ាប់យ៉ឺន នៅ ពេល នេះ ។ ការធ្លាក់ចុះ នៃ កេរ្តិ៍ឈ្មោះ អាមេរិក គឺ កើត មាន ឡើង ដោយសារតែ ការដក ខ្លួន ចេញ ពី អង្គការ សុខភាព ពិភពលោក (WHO) នៅពេល អន្តរជាតិ កំពុង ចលាចល ដោយ COVID-19 ខណៈ ការរើសអើង ជាតិ សាសន៍ ក៏ ជា ដើម ចម ធំ មួយ ទៀត ផងដែរ ៕
ក្រសួង កសិកម្ម៖ គិត ត្រឹម ថ្ងៃទី១ ខែកក្កដា ការបង្កបង្កើន ផល ស្រូវ រដូវ វស្សា សម្រេចបាន ជិត ១. ៨លាន ហិកតា ខណៈ ការនាំចេញ កសិផល មាន ជាង ៤លាន តោន
( ភ្នំពេញ ) ៖ រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ លោក វេង សា ខុន បាន បញ្ជាក់ ឲ្យដឹង ថា គិត ត្រឹម ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២០ ការងារ បង្កបង្កើន ផល ស្រូវ រដូវ វស្សា នៅ ទូទាំង ប្រទេស សម្រេច ជិត ១. ៨លាន ហិកតា ស្មើនឹង ៦៩. ២៤ % នៃ ផែនការ ជាង ២. ៥លាន ហិកតា ខណការនាំចេញ កសិផល វិញ សម្រេច ចំនួន ជាង ៤លាន តោន ដែល មាន ការកើនឡើង ល្អ ប្រសើរ ។
លោក រដ្ឋមន្ត្រី វេង សា ខុន បាន បង្ហាញ នូវ របាយការណ៍ ល្បឿន ការងារ បង្កបង្កើន ផល រដូវ វស្សា និង ការនាំចេញ ផលិផល កសិកម្ម យ៉ាង ដូច្នេះ ថា៖
២៖ ល្បឿន ការងារ បង្កបង្កើន ផល ដំណាំ សាក វប្បកម្ម និង ដំណាំ ឧស្សាហកម្ម រដូវ វស្សា ឆ្នាំ ២០២០
៣៖ ការនាំចេញ ផលិតផល កសិកម្ម ឆ្លងកាត់ ច្រក ចេញ ចូល តែ មួយ និង មិន បាន ឆ្លងកាត់
ចំពោះ ការនាំចេញ ផលិតផល កសិកម្ម ក្នុង រយៈពេល ៦ខែ ក្រសួង បាន ពិនិត្យ ឃើញ ថា មាន ការកើនឡើង ល្អ ប្រសើរ ។ ដោយឡែក ចំពោះ បរិមាណ នៃ ការនាំចេញ ផលិតផល កសិកម្ម សរុប ចំនួន ជាង ៤លាន តោន ដែល ក្នុង នេះ មាន ផលិតផល សំខាន់ ៗ មួយចំនួន ដូច ខាងក្រោម៖
ទីផ្សារ សហគមន៍ អឺរ៉ុប រួមទាំង ប្រទេស អង់គ្លេស នៅតែ ដើរ តួយ៉ាង សំខាន់ បន្ទាប់ពី ប្រទេស ចិន ដែល កាន់កាប់ ចំណែក ទីផ្សារ រហូតដល់ ៣៤% ដែល ស្មើនឹង ១៣៥ ៥៧៦តោន ក្នុង នោះ ប្រទេស បារាំង ជា ប្រទេស ដែល នាំចូល ធំ ជាង គេ បង្អស់ គឺ មាន បរិមាណ ៥១ ១៧៥តោន ។
