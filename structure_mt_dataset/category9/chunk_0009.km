សូម អាន សេចក្តីថ្លែងការណ៍ របស់ សមាគម មីក្រូ ហិរញ្ញវត្ថុ កម្ពុជា៖
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ចាប់ខ្លួន មន្ត្រី យោធា ម្នាក់ ក្រោយ បាន ដក កាំភ្លើង ខ្លី បាញ់ បោះ សេរី បង្ក ការភ័យខ្លាច ដល់ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ។
ហេតុការណ៍ ខាង លើ នេះ បាន កើតឡើង នៅ យប់ វេលា ម៉ោង ៨ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ ស្ថិត នៅ បន្ទប់ ជួល លេខ C05 ភូមិ ត្រពាំង រំចេក សង្កាត់ ចោម ចៅ១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
បើ តាម សមត្ថកិច្ច នៅ មុនពេល កើត ហេតុ ជន បង្ក បាន មក ផឹក ស៊ី ជាមួយ មិត្តភក្តិ នៅ បន្ទប់ ខាងលើ ចំនួន ៤នាក់ ។ ពេល កំពុង ផឹក នោះ ជន បង្ក បាន និយាយ ថា ពិបាកចិត្ត ណាស់ ប៉ុន្តែ មិន ដឹង ថា ពិបាកចិត្ត រឿង អ្វី ទេ លុះ មួយ សន្ទុះ ក្រោយមក ជន បង្ក បាន ដក កាំភ្លើង បាញ់ ចំនួន ៣គ្រាប់ ( មួយ គ្រាប់ បាញ់ ក្នុង បន្ទប់ទឹក មួយ គ្រាប់ បាញ់ ទ្វារ បន្ទប់ និង មួយ គ្រាប់ ទៀត ប បាញ់ ឡើង ល តែម្តង ) បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល រហូត មាន ការអន្តរាគមន៍ ពី កម្លាំង នគរបាល ។
រហូតមកដល់ ពេលនេះ ជនសង្ស័យ រូប នេះ ស្ថិត ក្រោម ការសួរនាំ និង ចាត់ ពី សមត្ថកិច្ច ៕ បង្ក្រាប ទីតាំង ស្តុក គ្រឿង ក្នុង ជ្រូក ជិត១តោន ផ្ទុក សាធាតុ គីមី និង ឃាត់ខ្លួន ម្ចាស់ ស្តង់ ម្នាក់ នៅ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ កម្លាំង ផែ្នក ព្រហ្មទណ្ឌ នគរបាល ក្រុង ប៉ោយប៉ែត បាន សហការ ជាមួយ កម្លាំង ការិយាល័យ នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច ខេត្ត បន្ទាយមានជ័យ បាន ចុះ ឆែកឆេរ រោង ស្តុក ទុក គ្រឿង ក្នុង ជ្រូក ២០ កោះ ស្មើរ នឹង ១តោន ដែល មាន ផ្ទុក សារធាតុ គីមី ព្រមទាំង ឃាត់ខ្លួន ម្ចាស់ ស្តង់ ម្នាក់ កាលពី ល្ងាច ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នៅក្នុង រោង បាំង ស័ង្កសី ជិត ក្នុង ភូមិ មិត្តភាព សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
លោក ឧត្តមសេនីយ៍ ត្រី ចាប សុផា ឬទ្ធិ បាន បញ្ជាក់ ថា គ្រឿង ក្នុង ជ្រូក ស្តុក ក្នុង ទីតាំង របស់ ឈ្មោះ អ៊ុល ក្លឹង នោះ សមត្ថកិច្ច បាន ឆែកឆេរកឃើញ អណ្តាត ត្រចៀក ពោះ បេះដូង ក្រចក ជើង សរុប មាន ចំនួន ២០កេះ ស្មើរ១តោន សុទ្ធសឹង ជា របស់ មាន ជាតិ គីមី ទាំងអស់ ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការរង សម្ភារ និង វត្ថុតាង ខាងលើ ក្រោយពី ធ្វើ កំណត់ហេតុ រួច ខាង ការិយាល័យ ជំនាញ ដឹក យក ទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ច្បាប់ ៕
រយៈពេល ៥៤ ថ្ងៃ យុទ្ធនាការ ការពារ ត្រី មេ ពូជ ក្នុង រដូវ បិទ នេសាទ នៅ ដែន ទឹក ខេត្ត ស្ទឹងត្រែង កាន់តែ មាន ប្រសិទ្ធភាព ខ្លាំង ឡើង ៗ
លោក ទុំ នីរ៉ូ បាន ឱ្យដឹង ថា បើ តាម ការប៉ាន់ស្មាន បឋម ត្រី មេ ពូជ គ្រប់ ប្រភេទ មិន តិច ជាង ៨០ % បាន រួច ពី ការនេសាទ ដោយ ឧបករណ៍ មង បណ្តែង ហើយ មាន ឱកាស បាន ធ្វើចរាចរណ៍ ទៅកាន់ ជម្រក នានា តាម ដងទន្លេ ទាំង បួន ។
នាយ ខណ្ឌ បាន បន្ត អំពាវនាវ ដោយ ទទូច ចំពោះ ថ្នាក់ដឹកនាំ គ្រប់ រូប ប្រជាពលរដ្ឋ គ្រប់ ស្រទាប់ វណ្ណៈ ជាពិសេស បងប្អូន ប្រជានេសាទ ផ្ទាល់ សូម រួមគ្នា ថែរក្សា ការពារ និង ប្រើប្រាស់ នូវ ធនធាន ជល ផល ដ៏ កម្រ ៗ ឱ្យ បន្ត បាន នូវ ចីរភាព សម្រាប់ កូន ចៅ យើង ជំនាន់ ក្រោយ ៗ ទៀត ។
សូម បញ្ជាក់ ថា រដូវ បិទ នេសាទ នៅ ភូមិសាស្រ្ត ខេត្ត ស្ទឹងត្រែង គឺ ចាប់ អនុវត្ត ពី ថ្ងៃទី ០១ ខែឧសភា រហូតដល់ ថ្ងៃទី៣០ ខែកញ្ញា រៀងរាល់ ឆ្នាំ ដែល ខេត្ត នេះ គឺជា ខេត្ត មួយ សំបូរ ទៅ ដោយ ត្រី ធម្មជាតិ ធំ ៗ និង កម្រ ៗ ដូចជា ត្រី រាជ ត្រី គល់ រាំង ត្រី ត្រសក ត្រី ប៉ាស៊ី អី បបែលយក្យ និង សត្វ ផ្សោត ទឹក សាប ។ល ។
គួរ ជម្រាប ថា ត្រី នៅ ខេត្ត ស្ទឹងត្រែង កំពុងតែ រង នូវ ការ គម្រាមគំហែង ខ្លាំង ឡើង ៗ ហើយ ជាពិសេស ត្រី ទាំងនេះ បាន មកដល់ ចំណុច ភ្លើង លឿង ហើយ បើ គ្មាន ការចូលរួម ជួយ ទាំងអស់ គ្នា ទេ នោះ ច្បាស់ជា មិន អាច ធានា បាន នូវ និរន្តរភាព នោះ ទេ ៕ ជូនដំណឹង ! បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្ត្រីរាជការ ស៊ីវិល នឹង បើក ប្រាក់ ប្រចាំ ខែកក្កដា សម្រាប់ ២សប្តាហ៍ លើក ទី១ ចាប់ពី ថ្ងៃ ១៥ ខែកក្កដា ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក ប្រាក់ របប សន្តិសុខ សង្គម ប្រចាំ ខែកក្កដា ឆ្នាំ ២០២០ និង ប្រាក់ គោល នយោបាយ សោធន៍ សម្រាប់ ខែកក្កដា ឆ្នាំ ២០២០ សម្រាប់ ២សប្តាហ៍ លើក ទី១ ជូន និវត្ត ជន និង អតីត មន្រ្តី រាជការ ស៊ីវិល ចាប់ពី ថ្ងៃទី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ត ទៅ តាម ប្រព័ន្ធ ធនាគារ កាណាឌីយ៉ា និង ធនាគារ អេស៊ីលីដា នៅ ២៥ រាជធានី - ខេត្ត ទូទាំង ប្រទេស ។
យោង តាម សេចក្តីជូនដំណឹង របស់ បេឡា ជាតិ សន្តិសុខ សង្គម សម្រាប់ មន្រ្តី រាជការ ស៊ីវិល ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បញ្ជាក់ ថា « ប្រាក់ គោល នយោបាយ របប សន្តិសុខ សង្គម និង ការបន្ថែម របប សន្តិសុខ សង្គម សម្រាប់ និវត្ត ជន និង ជន បាត់បង់ សម្បទា វិជ្ជាជីវៈ សម្រាប់ ខែកក្កដា ឆ្នាំ ២០២០ សម្រាប់ ២សប្តាហ៍ លើក ទី១ នឹង ត្រូវ បើក ចាប់ពី ១៥ ខែកក្កដា ឆ្នាំ ២០២០ត ទៅ » ។
ព្រឹក ថ្ងៃ នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « វឌ្ឍនភាព ទិសដៅ ការងារ បន្ដ របស់ រដ្ឋបាល ខេត្ត រតនគិរី »
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « វឌ្ឍនភាព និង ទិសដៅ ការងារ បន្ដ របស់ រដ្ឋបាល ខេត្ត រតនគិរី » នៅ វេលា ម៉ោង ០៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០២០ នេះ នៅ ជាន់ ផ្ទាល់ ដី សាល សេរីភាព នៃ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ។
សន្និសីទ នេះ មាន គោលបំណង បង្ហាញ ជូន សាធារណៈ ឲ្យបាន យល់ ច្បាស់ ពី សកម្មភាព សមិទ្ធផល និង ទិសដៅ ការងារ បន្ដ របស់ រដ្ឋបាល ខេត្ត រតនគិរី ក្នុង ទិសដៅ ស្នួល ជំរុញ គោល នយោបាយ អភិបាលកិច្ច ល្អ ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព ឆ្លើយតប ទៅ នឹង យុទ្ធសាស្ដ្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល ។
ក្នុង សេចក្ដីជូនដំណឹង បាន ឲ្យដឹង ថា សន្និសីទ សារព័ត៌មាន នេះ មាន ការសម្របសម្រួល ពី លោក ផៃ ស៉ី ផាន រដ្ឋមន្ដ្រី ប្រតិភូ អម នាយក រដ្ឋមន្ដ្រី និង ជា ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល និង មាន ការអញ្ជើញ ចូលរួម ជា វាគ្មិន ពី លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី ៕ សម្ដេច ព្រះមហាសង្ឃរាជ ទេព វង្ស បន្ត ប្រទាន អំណោយ ដល់ ពលរដ្ឋ ២០០ គ្រួសារ ក្នុង ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ សម្ដេច អគ្គ មហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា អម ដំណើរ ដោយ មន្រ្តី សង្ឃ ទាំងវ អភិបាល ខេត្ត ព្រៃវែង និង លោកស្រី ញ៉ែ ម សាខ ន បាន ប្រទាន ព្រះរាជ អំណោយ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ២០០ គ្រួសារ ដែល រស់ នៅក្នុង ភូមិ កន្លែង ជ្រៅ ឃុំ ក្រ បៅ ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង ។
ការប្រទាន អំណោយ នា ពេលនេះ ចាត់ទុក ជា ការចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការជួយ សម្រួល ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ ក្នុង កាល ទេសៈ ប្រទេសជាតិ កំពុង ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
ការប្រទាន ព្រះរាជ អំណោយ នេះ រៀបចំឡើង នា ព្រឹក ថ្ងៃទី ១២កក្កដា ឆ្នាំ ២០២០ នៅក្នុង ទីតាំង ភូមិ គ្រឹះ របស់ សម្ដេច ជា ស៊ីម ដោយ ផ្ទាល់ ។
ក្នុង ឱកាស ប្រទាន ព្រះរាជ អំណោយ នេះ បាន ផ្តល់ ព្រះរាជ ឪ វាទ ប្រាប់ ដល់ ព្រះសង្ឃ ប្រជាពលរដ្ឋ និង អាជ្ញាធរ ក្នុង មូលដ្ឋាន ដែល មាន វត្តមាន ទាំងអស់ ត្រូវតែ បន្ត ការប្រុងប្រយ័ត្ន ខ្ពស់ ស្ដាប់ និង គោរព តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ការណែនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី រួមគ្នា ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
សម្ដេច ព្រះមហាសង្ឃរាជ ក៏ មាន សង្ឃ ដីការ រម្លឹក ដល់ គុណ បំណាច់ របស់ សម្ដេច ជា ស៊ីម ដែល បាន បំពេញ កិច្ចការ ជាច្រើន ក្នុង ការចាប់ផ្ដើម វិស័យ ព្រះពុទ្ធ សាសនា ជាថ្មី ក្រោយពី របប ប្រល័យ ពូជសាន៍ ខ្មែរ ក្រហម ដោយ កាលពី ឆ្នាំ ១៩៧៩ មាន ព្រះសង្ឃ ត្រឹមតែ ៧អង្គ ប៉ុណ្ណោះ ហើយ សព្វ ថ្ងៃ ចំនួន ព្រះសង្ឃ បាន កើនឡើង ដល់ ជាង ៧ម៉ឺន អង្គ ទូទាំង ប្រទេស ។
ក្នុង ឱកាស ប្រទាន ព្រះរាជ អំណោយ នេះ ឯកឧត្តម ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង បាន លើកឡើង ថា នេះ ជា កិត្តិយស ដ៏ ថ្លៃថ្លា បំផុត ដែល មាន វត្តមាន របស់ សម្ដេច ព្រះមហាសង្ឃរាជ យាង មក ប្រទាន ព្រះរាជ អំណោយ ដោយ ផ្ទាល់ ដល់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ព្រៃវែង ។ ឯកឧត្តម អភិបាល ខេត្ត មើលឃើញ ថា នេះ ជា ព្រះរាជ សកម្មភាព ដ៏ ប្រពៃ ក្នុង វិស័យ ពុទ្ធ ចក្រ ចូលរួម ក្នុង កិច្ចការ វិស័យ អាណាចក្រ ដោយ រួមចំណែក យ៉ាង សំខាន់ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការជួយសម្រួល ជីវភាព ប្រជាពលរដ្ឋ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៩ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ០២ ករណី . ជួញដូរ ១៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២៩ នាក់ ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន ផលិត វីដេអូ ក្រឿន រំឮក ដល់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ឱ្យ ប្រុងប្រយ័ត្ន និង កុំ ធ្វេសប្រហែស ចំពោះ លទ្ធភាព នៃ ការចម្លង ជំងឺ កូវីដ - ១៩ ខណៈ ជំងឺ នេះ មិន ទាន់ រលាយ ផុត ពី ភព ផែនដី ។
ក្នុង វីដេអូ មាន រយៈពេល ជិត ២នាទី ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បញ្ជាក់ ពី លទ្ធភាព នៃ ការចម្លង ជំងឺ កូវីដ - ១៩ នេះ បាន បញ្ជាក់ ថា ប្រទេស កម្ពុជា បច្ចុប្បន្ន នេះ មិន ទាន់ មាន សុវត្ថិភាព នោះ ទេ ព្រោះ ជំងឺ នេះ កំពុងតែ រីករាតត្បាត នៅក្នុង តំបន់ ក៏ ដូចជាប នៅលើ ពិភពលោក ដូច្នេះ សូម ប្រុងប្រយ័ត្ន ជានិច្ច ៕
ព័ត៌មាន បន្ថែម សូម ទាក់ទង ទៅ ទូរស័ព្ទ លេខ ១១៥ ដោយ ឥត គិត ថ្លៃ ៕ សូម ទស្សនា វីដេអូ ខាងក្រោម៖
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ បាបង្ហាញ ជំហរ ថា អាជ្ញាធរ និង មន្រ្តី សុខាភិបាល នៅក្នុង ខេត្ត មិន ថមថយ ឡើយ ក្នុង យុទ្ធនាការ ប្រឆាំង ជំងឺ កូវីដ - ១៩ ។
លោក ថា « មិន អនុញ្ញាតឲ្យ អ្នកណា នាំ មេរោគ កូរ៉ូណា មក ចំលង ប្រជាពលរដ្ឋ ខ្ញុំ ឡើយ ។ ជន បរទេស ដែល ចូលមក ខេត្ត ព្រះសីហនុ ត្រូវតែ ដាក់ ឲ្យ ធ្វើចត្តាឡី ស័ក និង យក សំណាក ទៅ វិភាគ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។ ប្រសិនបើ រកឃើញ យើង អាច ជួយ ព្យាបាល ជំងឺ នេះ បាន » ។
ការបញ្ជាក់ នេះ បាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ បន្ទាប់ពី ក្រសួង សុខាភិបាល បាន រកឃើញ មាន ការឆ្លង ថ្មី លើ អ្នក ត្រឡប់ មកពី បរទេស ចូល ស្រុក ខ្មែរ ។
លោក បាន បញ្ជាក់ ទៅ មន្រ្តី ថា « ចំពោះ មុខ នេះ ក្រុមការងារ ចត្តាឡី ស័ក និង អង្គភាព ពាក់ព័ន្ធ ត្រូវ ខិតខំ បង្កើន សមត្ថភាព លើ ការងារ របស់ ខ្លួន ឲ្យបាន ខ្លាំងក្លា ។ រីឯ ការយក សំណាក ជន បរទេស ចូលមក ខេត្ត ព្រះសីហនុ មកវិភាគរក មេរោគ កូវីដ - ១៩ ត្រូវ ធ្វើឲ្យ ច្បាស់លាស់ » ។
សូម បញ្ជាក់ ថា រហូតដល់ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ កម្ពុជា រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ សរុប ១៥៦ នាក់ ។ ក្នុង នោះ ១៣៣ នាក់ បាន ព្យាបាល ជាសះស្បើយ ហើយ ២៣នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត និង មជ្ឈមណ្ឌល ចាក់អង្រែ ។ តួលេខ ចំនួន ១៥៦ នាក់ បាន កើនឡើង ក្រោយ ក្រសួង បាន រកឃើញ ១៥ នាក់ ទៀត បាន ឆ្លង កូវីដ១៩ ដែល ធ្វើដំណើរ មកពី ប្រទេស អារ៉ាប់ ឌីសាវអូឌី ៕
សមត្ថកិច្ច ចុះបង្ក្រាប ទីតាំង ស្តុក ឈើ ដែល ក្រុម ឈ្មួញ ដឹក ចេញ ទៅ វៀតណាម
( រតនគិរី ) ៖ សមត្ថកិច្ច ចម្រុះ រួម មាន មន្ត្រី បរិស្ថាន . កម្លាំង នគរបាល ស្រុក អូរយ៉ាដាវ . កម្លាំង វរ ការពារ ព្រំដែន គោក លេខ ៦២៣ និង កម្លាំ អាវុធហត្ថ មូលដ្ឋាន ស្រុក អូរយ៉ាដាវ នា ថ្ងៃទី ១១ ខែកក្កដា បាន ចុះ ចាប់ ឈើ ក្រហម ចម្រុះ ចំនួន ៣៣ ដុំ នៅ ត្រង់ ចំណុច កំពង់ចម្លង ទន្លេ សេសាន្ត មាន ចំងាយ ពី ប៉ុស្តិ៍ ច្រក របៀង ភូមិ ភិក្រោម ប្រមាណ ៣០០ ម៉ែត្រ ស្ថិត ក្នុង ភូមិ បាដល ឃុំ សេសាន្ត ស្រុក អូរយ៉ាដាវ ខេត្ត រតនគិរី ដែល ក្រុម ឈ្មួញ បម្រុង ដឹក ចេញ ទៅ វៀតណាម ។
លោក វរសេនីយ៍ ត្រី សុខ មីន មេបញ្ជាការ អាវុធហត្ថ មូលដ្ឋាន ស្រុក អូរយ៉ាដាវ បាន ប្រាប់ ភ្នាក់ងារ Fresh News នៅ រសៀល ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ថា ប្រតិបត្តិការ ខាងលើ នេះ មាន ការចង្អុលបង្ហាញ ពី លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី និង មាន ការសម្របសម្រួល ពី លោក ងិន ពេជ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត រតនគិរី ។
លោក វរសេនីយ៍ ត្រី សុខ មីន បាន បន្ត ថា មុននឹង ឈានដល់ ការបង្ក្រាប គឺ កងកម្លាំង បាន ប្រើប្រាស់ មធ្យោបាយ កាណូត ចុះល្បាត រុករក ស្រាវជ្រាវ ក្នុង ទន្លេ សេសាន្ត ក្នុង ភូមិសាស្ត្រ ស្រុក អូរយ៉ាដាវ ក៏ ប្រទះឃើញ ឈើ ដែល ក្រុម ឈ្មួញ គរ លក់ ទុក ក្នុង ទន្លេ ធ្វើ ការរឹបអូស ជាក់ស្តែង តែម្តង ។ ចំនួន ឈើ ក្រហម ចម្រុះ ចំនួន ៣៣ នេះ មិន ទាន់ វាស់វែង ដឹង ចំនួន ម៉ែត្រ គូប នៅឡើយ ទេ ។
លោក វរសេនីយ៍ ត្រី សុខ មីន បាន បញ្ជាក់ ថា ដោយសារ ទីតាំង ភូមិសាស្ត្រ ខាងលើ អំណោយផល សម្រាប់ ឈ្មួ ឈើ ខ្មែរ និង វៀតណាម ជារឿយ ៗ តែងតែ លួច ដឹក ឈើ ចេញ ទៅ វៀតណាម នោះ លោក ម៉ា វិចិត្រ ប្រធាន គណបញ្ជាការ ឯកភាព ស្រុក អូរយ៉ាដាវ បាន យក កម្លាំង មួយ ទៅ ដាក់ ប្រចាំ ការ២៤ លើ ២៤ ម៉ោង ដើម្បី មាន បទល្មើស បន្ត ទៀត ។
មន្រ្តី សមត្ថកិច្ច លួច បង្ហើប ថា ជំនួញ ឈើ នេះ ប្រព្រឹត្តទៅ ដោយ រលូន ដោយសារតែ ឈ្មួញ វៀតណាម ផ្តល់ លុយ ឱ្យ សមត្ថកិច្ច ខិល ខូច មួយចំនួន ដែល ប្រចាំ ការ នៅ តាម ប៉ុស្តិ៍ ច្រក របៀង ហើយ មាន មេ ប៉ុស្តិ៍ ច្រក របៀង ខ្លះ ឱ្យ វៀតណាម ចូលមក ស្នាក់ នៅ រង់ចាំ ទិញ ឈើ ទៀតផង ។
បច្ចុប្បន្ន វត្ថុតាង ខាងលើ ត្រូវបាន ប្រគល់ មន្ត្រី បរិស្ថាន បាន យកមក ទៅ រក្សាទុក ដើម្បី ចាត់ចែង តាម នីតិវិធី ច្បាប់ ៕ តំណាងរាស្ដ្រ កំពង់ចាម ប្រកាស បន្ថែម សមាសភាព ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ឃុំ ត្រពាំង គរ ស្រុក ជើង ព្រៃ
( កំពង់ចាម ) ៖ លោក បណ្ឌិត ម៉ា ឈឿន តំណាងរាស្ដ្រ មណ្ឌល កំពង់ចាម និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ត កំពង់ចាម និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក ជើង ព្រៃ បាន ជំរុញ លើកទឹកចិត្ដ ដល់ សមាជិក បក្ស ទាំងអស់ ត្រូវ បន្ដ សាមគ្គីភាព គ្នា និង បំពេញ ការងារ ប្រកបដោយ ប្រសិទ្ធិភាព ខ្ពស់ ក្នុង ការផ្ដល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ។
តំណាងរាស្ដ្រ ម៉ា ឈឿន បាន ថ្លែង ថា « ដើម្បី បន្ដ ការកសាង គ្រប់គ្រង តាម ឃុំ ភូមិ ស្រុក ជើង ព្រៃ យើង ឱ្យ កាន់តែ មាន ការអភិវឌ្ឍ ប្រជាជន បន្ដ ទទួលបាន នូវ ភាព សុខសាន្ដ សុំ ស្នើ ដល់ មន្ដ្រី ក្រុមការងារ ទាំងអស់ សហការ គ្នា កុំ បង្កើត ទំនាស់ ផ្ទៃក្នុង ជាពិសេស សភាព ក្រុមការងារ ថ្មី ត្រូវ បញ្ចេញ ស្នាដៃ ឱ្យ អស់ ពី លទ្ធភាព បំពេញ ការងារ ដោយ ជោគជ័យ » ។
លើស ពី នោះ មន្ដ្រី ក្រុមការងារ ទាំង ១០ឃុំ ដែល តែងតែ ខិតខំ ប្រឹងប្រែង កន្លងមក នេះ សូម បន្ដ ការងារ ឱ្យ កាន់តែ សកម្ម បន្ថែម ទៀត ហើយ សូម កុំ សន្ដិភាព និយម កុំ ស្កប់ស្កល់ និយម ហើយក៏ កុំ មោទនភាព នឹង ជ័យជម្នះ ត្រូវ បន្ដ យកចិត្ដទុកដាក់ ទប់ស្កាត់ ទាន់ ពេលវេលា ដោះស្រាយ រាល់ ពេល មាន បញ្ហា ដែល អាច កើត មាន ឡើង លើស ពី នោះ គឺ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ត្រូវ ជួយ ដោះស្រាយ សម្រាល ការលំបាក ជាពិសេស ក្នុង អំឡុង ពេល ជួប វិបត្ដិ ជំងឺ កូវីដ១៩ នេះ ។
សូម បញ្ជាក់ ថា រហូតដល់ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ កម្ពុជា រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ សរុប ១៥៦ នាក់ ។ ក្នុង នោះ ១៣៣ នាក់ បាន ព្យាបាល ជាសះស្បើយ ហើយ ២៣នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត និង មជ្ឈមណ្ឌល ចាក់អង្រែ ៕
លោក វង្សី វិស្សុត៖ អភិក្រម និង យុទ្ធសាស្រ្ត ក្នុង ការដោះស្រាយ បញ្ហា សង្គម - សេដ្ឋកិច្ច កម្ពុជា ក្នុង បរិការណ៍ កូវីដ - ១៩
លោក បាន គូសបញ្ជាក់ ថា ការខិតខំ ដើម្បី រស់ សិន ខាង សេដ្ឋកិច្ច ខាង លើ នេះ មិន មែន ជា ការរស់ សម្រាប់ តែ រង់ចាំ ថ្ងៃ ស្លាប់ នោះ ទេ ហើយ ជំងឺ នេះ ក៏ មិន អាច ធ្វើឱ្យ កម្ពុជា យើង ដួលរលំ នោះ ដែរ ពោលគឺ យើង ខិតខំ រស់ សម្រាប់ រង់ចាំ ពេល ដើម្បី ងើប ឡើងវិញ ដោយ ជំហាន ដំបូង គឺ ក្រោក ឡើង ដើរ ដើម្បី កែតម្រូវ និង តៀម លក្ខណៈ ក្នុង រយៈពេល ពី ១ ឆ្នាំ ទៅ២ ឆ្នាំ ហើយ បន្ទាប់មក ចាប់ផ្តើម រត់ ទៅ មុខ ទៀត ក្នុង ការអភិវឌ្ឍ និង ដើម្បី ធ្វើឱ្យ សេដ្ឋកិច្ច កម្ពុជា អាច ងើប ឡើងវិញ បាន កាន់តែ ខ្លាំ ជាង មុន ។
លោក វង្សី វិស្សុត បាន លើកឡើង ថា នៅក្នុង ក្របខណ្ឌ យុទ្ធសាស្រ្ត ដើម្បី រស់ ខាងលើ នេះ គឺ យើង ត្រូវ៖
* ទី២៖ ជំរុញ សកម្មភាព សេដ្ឋកិច្ច ក្នុង ស្រុក ផ្សេង ទៀត ឱ្យ ដើរ កាន់តែ ខ្លាំង ទាំង ការផលិត និង ទាំង ការប្រើប្រាស់ ក្នុង ស្រុក សំដៅ ធ្វើ យ៉ាងណា ដើម្បី ជំរុញ តម្រូវការ ក្នុង ស្រុក និង ឱ្យ លុយ វិល កាន់តែ ច្រើន ក្នុង សេដ្ឋកិច្ច ដើម្បី បង្កើន តម្លៃ បន្ថែម ។ ពិត ណាស់ ថា សកម្មភាព សេដ្ឋកិច្ច ក្នុង ស្រុក របស់ កម្ពុជា បច្ចុប្បន្ន មិន អាច ធានា ជួយ ឱ្យ យើង សម្រេចបាន កំណើន ៧% ក្នុង មួយ ឆ្នាំ នោះ ទេ ប៉ុន្តែ តែ អាច ជួយ សេដ្ឋកិច្ច កម្ពុជា ឱ្យ អាច រស់ បាន ។
* ទី៣៖ ជំរុញ ការនាំចេញ ផលិតផល ផ្សេង ទៀត ដែល នៅ មាន ទីផ្សារ ទៅ ខាងក្រៅ នៅឡើយ ដូចជា កង់ ជាដើម និង ផលិតផល ផ្សេង ៗ ដែល អាច នាំចេញ បាន ឱ្យ អស់ សក្តានុពេល តាមរយៈ ការកែលំអរ បន្ថែម ទៀត នូវ កិច្ច សម្រួល ពាណិជ្ជកម្ម និង ការគាំទ្រ ចាំបាច់ នានា បន្ថែម ទៀត ។
* ទី៥៖ គួរ បន្ត ជំរុញ ការប្រើប្រាស់ បច្ចេកវិទ្យា ឌីជីថល នៅក្នុង គ្រប់ វិស័យ ទាំងអស់ ដោយ ផ្អែក លើ ផែនការ និង យុទ្ធសាស្រ្ត ជាក់លាក់ ។
( កំពត ) ៖ លោក ជឹង ផល្លា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពត និង លោក ជា វ តាយ អភិបាល ខេត្ត ព្រមទាំង មន្ត្រី ជំនាញ នៅ ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ បាន ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ ពី ជីវភាព រស់ នៅ និង ស្វែងយល់ ការងារ បង្កបង្កើន ផល របស់ ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ព្រៃ ចេក ឃុំ ទូក មាស ខាងលិច ស្រុក បន្ទាយមាស ខេត្ត កំពត ក្នុង រដូវ វស្សា នេះ ។
ជាមួយ ឱកាស នោះ ដែរ លោក ជា វ តាយ ក៏ បាន លើកទឹកចិត្ត និង ស្នើ ឱ្យ ប្រជាពលរដ្ឋ នៅពេល មាន ទឹក គ្រប់គ្រាន់ ត្រូវ បង្កើន ការសាប ព្រួស ដក ស្ទូង ស្រូវ និង ដាំដុះ ដំណាំ រួមផ្សំ ឱ្យ អស់ លទ្ធភាព ផ្ទៃដី ដែល មាន ។ ហើយ បើ មាន បញ្ហា កង្វល់ បញ្ហា ប្រឈម ឬ តម្រូវការ ផ្សេង ៗ ក៏ សូម ឱ្យ ប្រញាប់ រាយការណ៍ មក អាជ្ញាធរ មាន សមត្ថកិច្ច មូលដ្ឋាន និង ជំនាញ ពាក់ព័ន្ធ ដើម្បី សហការ គ្នា ចូលរួម ជួយ ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ឆាប់ រហ័ស ជាបន្ទាន់ ផងដែរ ។
សូម បញ្ជាក់ ថា ក្នុង ឆ្នាំ ២០២០ នេះ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម មាន គម្រោង សាងសង់ ទ្វារ ទឹក ចំនួន ៤កន្លែង ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពត រួម មាន ទី១៖ ប្រឡាយ មេ ដើម ពោធិ៍ ក្នុង ស្រុក អង្គរ ជ័យ . ទី ២៖ សំណង់ ទំនប់ បង្ហៀរ ទឹក កូន សត្វ ក្នុង ស្រុក ទឹក ឈូ. ទី ៣៖ ប្រឡាយ មេ អូរ កាចែត ក្នុង ស្រុក កំពង់ត្រា ច និង ទី៤៖ សំណង់ ទ្វារ ទឹក កាត់ ស្ទឹង ទូក មាស ក្នុង ស្រុក បន្ទាយមាស ៕
បុរស រោគ ចិត្ត ម្នាក់ លួច អាវ ក្នុង និង ខោលី អូ របស់ នារី ត្រូវ នគរបាល ចាប់ ខ្លូន នៅ ខណ្ឌ ចំការមន
( ភ្នំពេញ ) ៖ ជនសង្ស័យ ម្នាក់ សង្ស័យ មាន ជំងឺ រោគ ចិត្ត តែងតែ ធ្វើ សកម្មភាព លួច សម្លៀកបំពាក់ នារី ៗ ជាពិសេស នោះ អាវ ក្នុង និង ខោលី អូតែម្តង ។ ប៉ុន្តែ សកម្មភាព របស់ គេ ចុងក្រោយ ត្រូវបាន កម្លាំង នគរបាល តាម ចាប់ខ្លួន បាន កាលវេលា ម៉ោង ១១៖ ៤០ នាទី យប់ ថ្ងៃទី ១១ ខែកក្ដ ដា ឆ្នាំ ២០២០ នៅ ចំណុច ផ្ទះ លេខ ១៩៨A ផ្លូវ ព្រះនរោត្តម សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ។
លោក សាល សណ្ដុះ នាយ ប៉ុស្តិ៍ រដ្ឋបាល ទន្លេ បាសាក់ បាន ឲ្យដឹង ថា ជនសង្ស័យ ឈ្មោះ ព្រីង សំរស់ អាយុ ៣៤ ឆ្នាំ មុខរបរ គ្មាន ស្នាក់ នៅ ផ្ទះ នៅ ភូមិ ១០ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ។
មុនពេល កើត ហេតុ ជនសង្ស័យ បាន ដើរ ទៅ ទី ស្ងាត់ និង លួច យក ជណ្ដើរ របស់ ប្រជាពលរដ្ឋ ជិតខាង យកមក ដាក់ ផ្អែក ជញ្ជាំ ដើម្បី ឡើង លើ ផ្ទះ ជនរងគ្រោះ គោលបំណង លួច សម្ភារ មាន តម្លៃ និង សម្លៀកបំពាក់ របស់ ជនរងគ្រោះ ។ តែ ពេល នោះ ត្រូវបាន ជនរងគ្រោះ ឃើញ ទាន់ ក៏ ស្រេក ឆោឡោ ហើយ ត្រូវបាន ប្រជាពលរដ្ឋ ជិតខាង នាំគ្នា ចេញមក ឃាត់ បាន និង ស្វាគមន៍ ម្នាក់ ១ដៃ មួយ ជើង ដោយ ខឹង តែ បាត់ សម្ភារ ញឹកញាប់ ពេក ។
ពេល សួរនាំ ជនសង្ស័យ បាន ឆ្លើយ សារភាព ថា ខ្លួន មាន ជន មិន ស្គាល់ មុខ ធ្វើ មន្តអាគមន៍ ដាក់ ហើយ តម្រូវឲ្យ លួច សំលៀកបំពាក់ ស្រី ៗ ជាពិសេស អាវ ក្នុង និង ខោលី អូ របស់ នារី តែម្ដង ទើប អំពើ នោះ បាន និង ធ្វើ មិន ចូល ។
តែ យ៉ាងណា ក៏ដោយ នេះ អាច ជា ពាក្យ ដោះសារ ដើម្បី ស្រាយ ទោស កំហុស នោះ ទេ ។ ក្រោយ ការសួរនាំ ជនសង្ស័យ ត្រូវបាន បញ្ជូន ទៅកាន់ តុល ការចាត់ការ បន្ត ទៀត ៕
អភិបាល ស្រុក និង អធិការ ស្រុក បាទី ខេត្ត តាកែវ នាំយក អំណោយ របស់ ស្នងការ ខេត្ត តាកែវ ប្រគល់ ជូន មន្ត្រី នគរបាល ដែល មាន ជំងឺ ប្រចាំ កាយ
( តាកែវ )៖ លោក ភួន ឈីម អភិបាល ស្រុក បាទី និង លោក វរសេនីយ៍ ទោ ឆាយ កែវ មុន្នី អធិការ នគរបាល ស្រុក បាទី នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ សហការី នាំយក អំណោយ របស់ លោក សេនីយ៍ ទោ សុខ សំណាង ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ ប្រគល់ ជូន ដល់ លោក អនុ សេនីយ៍ ទោ សែម សម្បត្តិ ដែល មាន ជំងឺ ប្រចាំ កាយ មិន អាច បម្រើ ការងារ បាន និង រស់ នៅ ភូមិ តានប់ ឃុំ ចំបក់ ស្រុក បាទី ខេត្ត តាកែវ ។
អំណោយ ដែល នាំយក មក ប្រគល់ ដល់ មន្ត្រី នរគ បាល ដែល មាន ជំងឺ នា ពេលនេះ រួម មាន៖ អង្ករ មី ទឹកត្រី ទឹកស៊ីអ៊ីវ ទឹក សុទ្ធ និង ថវិការ ចំនួន ៤៥០.០០០ រៀល ។
ក្នុង ឱកាស នោះ ដែរ លោក វរសេនីយ៍ ទោ ឆាយ កែវ មុន្នី ក៏ បាន លើកទឹកចិត្ត ដល់ មន្ត្រី នគរបាល ដែល មាន ជំងឺ ប្រចាំ កាយ រូប នេះ សូម ថែរក្សា សុខភាព ឱ្យ បាន ល្អ ដើម្បី ឆាប់ ជាសះស្បើយ និង អាច ចូល បម្រើ ការងារ ជូន អង្គភាព វិញ បាន ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ៕ ក្រុមការងារ ចុះ ជួយ ស្រុក រំដួល អំពាវនាវ ពលរដ្ឋ ចេះ ថែរក្សា ការពារ សន្តិភាព ឲ្យបាន គង់វង្ស និង រួមគ្នា ប្រយុទ្ធ ជំងឺ កូវីដ១៩
( ស្វាយរៀង ) ៖ លោក សៅ សុវណ្ណី អនុប្រធាន ការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក រំដួល ខេត្ត ស្វាយរៀង បាន ថ្លែង អំពាវនាវ ពលរដ្ឋ ឲ្យ ចេះ ថែរក្សា ការពារ សន្តិភាព ឲ្យបាន គង់វង្ស ព្រមទាំង ត្រូវ រួមគ្នា បង្ការ ទប់ស្កាត់ និង ប្រុងប្រយត្ន័ នៅ ការរីករាលដាល រលក ទី២ នៃ ជំងឺ កូវីដ១៩ ផងដែរ ។
ការអំពាវនាវ បែប នេះ ខណៈ លោក សៅ សុវណ្ណី ដង្ហែរ ទៀន ព្រះវស្សា និង ទេយ្យ ទាន និង បច្ច័យ មួយចំនួន ប្រគេន ដល់ ព្រះសង្ឃ គង់ ចាំ ព្រះចំនួន ១០វត្ត នៅ ឃុំ បុសមន និង ឃុំ ថ្នា ធ្នង់ ស្រុក រំដួល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ១២ ខែកក្ត ដា ឆ្នាំ ២០២០ ដែល ពិធី នេះ បាន ប្រព្រឹត្តិ ទៅ នៅ វត្ត បុស ផ្លាំង ឃុំ បុសមន ។
លោក បញ្ជាក់ ថា ការប្រារព្ធ ធ្វើ ពិធី នេះ បាន គឺ ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព ជាពិសេស បង្ហាញ ពី ទឹកចិត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត គោរព ស្រលាញ់ ប្រតិបត្តិ ព្រះពុទ្ធ សាសនា ដែល ជា សាសនា របស់ រដ្ឋ ដើម្បី ថែរក្សា ការពារ វិស័យ ព្រះពុទ្ធ សាសនា នេះ ឲ្យ កាន់តែ មាន ភាពរុងរឿង ថ្កុំថ្កើន ឈាន ទៅ គម្រប់ ៥ ពាន់ ព្រះវស្សា តាម ពុទ្ធិ បញ្ញាត្តិ ។
លោក បាន ផ្តាំផ្ញើ ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ត្រូវ បង្កើន ការផលិត ផ្នែក កសិកម្ម តាមរយៈ ការដាំដុះ ការចិញ្ចឹម សត្វ ជាដើម ចំណែកឯ អាជ្ញាធរ ត្រូវតែ ពង្រឹង ឲ្យ មាន ប្រសិទ្ធិភាព នូវ ភូមិ - ឃុំ មាន សុវត្ថិភាព និង ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ។
សូម បញ្ជាក់ ថា ទៀន ព្រះវស្សា និង ទេយ្យ ទាន ប្រគេន ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា ចំនួន ១០វត្ត ក្នុង មួយ វត្ត ទទួលបាន ទៀន ព្រះវស្សា ១គូរ និង ទ័យ ទាន ជា គ្រឿង ឧបភោគ បរិភោគ ព្រមទាំង បច្ច័យ ចំនួន ២០ ម៉ឺន រៀល ក្នុង នោះ លោក សៅ សុវណ្ណី ក៏ បាន ប្រគល់ ថវិកា ចំនួន ២០០ ដុល្លារ ដើម្បី ចាក់ ដី នៅ សាលា ឃុំ បុស មន ដែល សរុប ថវិការ ទាំងអស់ ប្រមាណ ៣ពាន់ ដុល្លារ នៅក្នុង ពិធី នេះ បន្ទាប់ លោក ក៏ បាន ចុះ ពិនិត្យមើល អគារ សិក្សា នៅ សាលា អនុវិទ្យាល័យ សៅ យ៉ាត ដែល កសាងឡើង ដោយ លោកឪពុក របស់ លោក ផងដែរ ៕
ថវិកា ជិត ៦០០ លាន រៀល ត្រូវបាន រាជ រដ្ឋាភិបាល ផ្ដល់ជូន គ្រួសារ ក្រីក្រ ជាង ៣ពាន់ គ្រួសារ នៅ ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ
( កំពង់ធំ )៖ ប្រជាពលរដ្ឋ ក្រីក្រ ដែល កំពុង ជួប បញ្ហា លំបាក ពិតប្រាកដ ទទួលបាន នូវ ជំនួយ ឧបត្ថម្ភ ពី រាជ រដ្ឋាភិបាល ក្នុង អំឡុង ពេល ប្រយុទ្ធ ជំងឺ កូវីដ - ១៩ ក្នុង នោះ ប្រជាពលរដ្ឋ ក្រីក្រ ជាង ៣ពាន់ គ្រួសារ នៅ ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ កំពុងតែ ទទួលបាន សាច់ប្រាក់ ពី រដ្ឋាភិបាល កម្ពុជា គិត ត្រឹម ថ្ងៃទី ១១ ខែកក្ត ដា ឆ្នាំ ២០២០ ក្នុង រង្វង់ ទឹកប្រាក់ ប្រមាណ ជិត ៦០០ លាន រៀល ។
លោក អួង សារឿន អភិបាល ស្រុក បាន លើកឡើង ថា ស្រុក បារាយណ៍ មាន គ្រួសារ ប្រមាណ ២៦. ០០០ គ្រួសារ ហើយ មាន ប្រជាពលរដ្ឋ ជាង ១២ម៉ឺន នាក់ មាន ឃុំ ចំនួន ១០ ភូមិ ចំនួន ៩៧ ភូមិ ។
លោក បាន បន្ត ទៀត ថា នៅសល់ ជាង ៥០០ គ្រួសារ ទៀត ដែល កំពុងតែ ដំណើរការ បច្ចុប្បន្ន ទាំង ថ្ងៃសៅរ៍ - អាទិត្យ ដើម្បី ធ្វើ ការបើក សាច់ប្រាក់ ជូន ពួកគាត់ ផងដែរ » ។
ជា ចុងក្រោយ លោក បាន ថ្លែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល តែងតែ គិតគូរ អំពី សុខ ទុក្ខ និង គិតគូ អំពី ផលលំបាក ដល់ ប្រជាពលរដ្ឋ នៅ គ្រប់ កន្លែង ក្នុង ប្រទេស កម្ពុជា ។
យល់ដឹង ផ្នែក ច្បាប់៖ បទ ស្ដាប់ ឬ ថត ពាក្យសំដី ឯកជន
( ភ្នំពេញ ) ៖ ក្នុង ការរស់នៅ ប្រចាំ ថ្ងៃ បុគ្គល ម្នាក់ ៗ រមែង មាន ការប្រាស្រ័យទាក់ទង គ្នា ទៅ វិញ ទៅ មក តាមរយៈ ការជួប ជជែក ដោយ ផ្ទាល់ ការឆ្លើយឆ្លង តាម ទូរស័ព្ទ ដៃ ការសន្ទនា តាម បណ្ដាញ សង្គម ឬ តាម មធ្យោបាយ ផ្សេង ៗ ទៀត ។ ក្នុង នោះ ផងដែរ ការសន្ទនា មួយចំនួន អាច ពាក់ព័ន្ធ នឹង បញ្ហា ផ្ទាល់ខ្លួន បញ្ហា គ្រួសារ ឬ ការសម្ងាត់ ជំនួញ ដែល សាមីខ្លួន មិន អាច ឬ មិន ចង់ឱ្យ ជន ទី បី ដឹង ឮ ។
ជីវិត រស់ នៅ ឯកជន របស់ បុគ្គល នឹង ត្រូវបាន រំលោភបំពាន ប្រសិនបើ ការសន្ទនា ទាំងនោះ ត្រូវបាន គេ លួច ស្ដាប់ ឬ ថតចម្លង ដោយ មិន មាន ការអនុញ្ញាត ជាមុន លើកលែងតែ ករណី ដែល ច្បាប់ អនុញ្ញាត ។ ដូច្នេះ ដើម្បីឲ្យ ជ្រាប កាន់តែ ច្បាស់ ថា តើ សកម្មភាព បែប ណា ដែល ត្រូវបាន ចាត់ទុក ថា ជា ការស្ដាប់ ឬ ថត ពាក្យសម្ដី ឯកជន ? ហើយ ជន ដែល ប្រព្រឹត្ត អំពើ នេះ ត្រូវ ទទួលទោស តាម ច្បាប់ កម្រិត ណា ?
យោង តាម បទបញ្ញត្តិ ខាងលើ បើ គ្មាន ការអនុញ្ញាត ពី បុគ្គល ពាក់ព័ន្ធ ឬ ច្បាប់ ទេ នោះ គ្មាន ជន ណា ម្នាក់ អាច ស្តាប់ ឬ ថត ពាក្យសម្ដី ឯកជន ឬ ការសម្ងាត់ ទាំងនោះ បាន ឡើយ ។ ការលួច ថត នេះ ទៀតសោត អាច ធ្វើឡើង តាមរយៈ ការលួច បង្កប់ ម៉ាស៊ីន ថត សម្លេង នៅពេល សន្ទនា ដោយ ផ្ទាល់ ឬ លួច ថត សម្លេង នៅពេល សន្ទនា តាមរយៈ ទូរស័ព្ទ ជាដើម ។
យ៉ាងណាមិញ មាត្រា ខាងលើ ក៏ បាន បញ្ជាក់ ផងដែរ ថា ទោះបីជា ភាគី ដែល ពាក់ព័ន្ធ មិន បាន បញ្ជាក់ អំពី ការអនុញ្ញាតឱ្យ ស្តាប់ ឬ ថត សម្ដី ឯកជន ក៏ដោយ ក៏ប៉ុន្ដែ បើ ភាគី បាន ដឹង ថា មាន ជន ទី បី កំពុង ស្ដាប់ ឬ ថត សម្លេង ដោយ មិន បាន ជំទាស់ ឬ ហាមឃាត់ ណាមួយ នោះ ទេ សកម្មភាព នេះ ត្រូវបាន ចាត់ទុក ថា ជា ការព្រមព្រៀង ឱ្យ ស្ដាប់ ឬ ថត សម្លេង នូវ ការសន្ទនា នោះ ។
ឧទាហរណ៍៖ បុគ្គល ម្នាក់ ត្រូវបាន ជួប សម្ភាសន៍ ជាមួយ អ្នកសារព័ត៌មាន ហើយ គាត់ បាន ឃើញ ម៉ាស៊ីន ថត សម្លេង នៅលើ តុសម្ភាសន៍ រួចហើយ ហេតុ ដូចនេះ ប្រសិនបើ បុគ្គល នោះ មិន បាន ធ្វើ ការជំទាស់ ទេ សកម្មភាព ថត សម្លេង របស់ អ្នកសារព័ត៌មាន មិន ត្រូវបាន ចាត់ទុក ថា ជា បទ លើ្មស នោះ ទេ ។
សរុប រួម មក ជន ទាំងឡាយ ណា ដែល បាន ស្ដាប់ និង ថត ពាក្យសម្ដី ឯកជន ឬ ការសម្ងាត់ ដោយ គ្មាន ការអនុញ្ញាត ត្រូវ ទទួល ការផ្តន្ទាទោស តាម ច្បាប់ កំណត់ ដូច បាន រៀបរាប់ ខាងលើ ។ ទន្ទឹមនឹង នេះ ដើម្បី ចៀសវាង នូវ ការរំលោភបំពាន សិទ្ធិ ឯកជន របស់ ខ្លូន ប្រជាពលរដ្ឋ គ្រប់ រូប គួរតែ មាន ការប្រុងប្រយ័ត្ន មុនពេល ជជែក ពិភាក្សា អំពី ការសម្ងាត់ ផ្សេង ៗ និង ត្រូវ បង្ហាញ ការជំទាស់ ភ្លាម ៗ ប្រសិនបើ ខ្លួន មិន ចង់ឱ្យ មាន ការលួច ស្តាប់ ឬ ថត ពាក្យសម្ដី ឯកជន ណាមួយ នោះ ទេ ។
ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត កំពត៖ ការចុះ MoU រវាង ក្រុមហ៊ុន ទេសចរណ៍ និង សហគមន៍ ទេសចរ ក្នុង ខេត្ត នឹង ជួយ ទាក់ទាញ ភ្ញៀវ ទេសចរ បន្ថែម ទៀត
ការ ចុះអនុស្សារណៈ យោគយល់ គ្នា នេះ បាន ធ្វើឡើង ខណៈ ខេត្ត កំពត កំពុង វិវត្តន៍ ខ្លួន ជា គោលដៅ ទេសចរណ៍ កាន់តែ ទាក់ទាញ ជាពិសេស ទេសចរណ៍ ដែល ផ្សាភ្ជាប់ នឹង សម្រស់ ឆ្នេរ និង ធម្មជាតិ ស្រប ពេល ក្រុមហ៊ុន ទេសចរណ៍ ១ បាន ចុះ កិច្ចសហការ ជាមួយ សហគមន៍ អេកូ ទេសចរណ៍ សំខាន់ ៗ ៣ ដើម្បី នាំយក ភ្ញៀវ ទេសចរ ទៅ តំបន់ នោះ កាន់តែ ច្រើន ។
លោក សយ ស៊ីណុល បាន ឱ្យដឹង ថា ខេត្ត កំពត ទទួលបាន ភ្ញៀវ ទេសចរ សរុប ជាង ១លាន ៦សែន នាក់ កាលពី ឆ្នាំ ២០១៩ ដែល ក្នុង នោះ ភ្ញៀវ ទេសចរ អន្តរជាតិ មាន ជាង ១៧ម៉ឺន នាក់ ។
លោក សយ សុី ណុល បញ្ជាក់ ថា ភ្ញៀវ ទេសចរ ក្នុង ស្រុក ម្នាក់ បាន ចំណាយ ជា មធ្យម ៥០ ដុល្លារ ក្នុង ដំណើរកម្សាន្ត មួយ លើក ស្រប ពេល ភ្ញៀវ ទេសចរ បរទេស ចំណាយ ជា មធ្យម ១០០ ដុល្លារ ដែល បាន ធ្វើឱ្យ ចំណូល ពី វិស័យ ទេសចរ នៅ ខេត្ត កំពត កាលពី ឆ្នាំ មុន មាន ប្រហែល ១០០ លាន ដុល្លារ ។
លោក ឱម ផារិន អគ្គ នាយក ក្រុមហ៊ុន ទេសចរណ៍ ឆាម មីង ខេមបូឌា ធួរ បាន លើកឡើង ដោយ ក្តី រំពឹង ថា កិច្ចសហការ នៅ ថ្ងៃ នេះ នឹង រួមចំណែក ដល់ ការអភិវឌ្ឍន៍ សហគមទាំង ៣ ហើយ នឹង ជួយ បង្កើន ចំណូល និង ជីវភាព បងប្អូន នៅ តំបន់ នោះ ឱ្យ កាន់តែ ល្អ ប្រសើរ ។
ទីបំផុត លោក ដូណាល់ ត្រាំ ពាក់ ម៉ាស ជា លើក ដំបូង ពេល ចុះ ទស្សនកិច្ច នៅ មន្ទីរពេទ្យ មួយ កន្លែង
មេធាវី តំណាង អោយ ក្រុមហ៊ុន សូម ធ្វើ ការបដិសេធ ចោល ទាំងស្រុង នូវ ព័ត៌មាន ចោទប្រកាន់ ខាងលើ ព្រោះ ក្រុមហ៊ុន ធ្វើ សកម្មភាព តែ នៅលើ ទីតាំង ដី ក្រុមហ៊ុន ក្នុង ការឈូស សំអាត ដី ប្រមូល ផល អនុផល ព្រៃឈើ បង់ សួយ សារ ផល លាភ ចូល រដ្ឋ ដើម្បី ធ្វើ ការដាំ កូន ឈើ ទៅ តាម ផែនការតែ ប៉ុណ្ណោះ ។
ខាងក្រោម នេះ ជា លិខិត បំភ្លឺ របស់ មេធាវី តំណាង អោយ ក្រុមហ៊ុន សៀ ម៉ុន៖
សម្តេច តេជោ ហ៊ុន សែន បាន ជំរុញ ដល់ ប្រជាពលរដ្ឋ កុំ ធ្វេសប្រហែស ឱ្យ សោះ ហើយ ត្រូវ ឧស្សាហ៍ ដុស លាង សម្អាត ដៃ ជាមួយ សាប៊ូ ចឹល ឬ ទឹក អាល់កុល ជាប្រចាំ ហើយ ត្រូវ ពាក់ ម៉ាស ការពារ ឱ្យ បាន ត្រឹមត្រូវ ។
« ទីកន្លែង ដែល មាន មនុស្ស ច្រើន ដូចជា ទីផ្សារ និង ផ្សារ ទំនើប តូប លក់ដូរ ទូទៅ ភោជនីយដ្ឋាន ផ្ទះសំណាក់ សណ្ឋាគារ កាស៊ីណូ ដែល ទទួលបាន ការអនុញ្ញាត្ត ឱ្យ បើក ដំណើរការ ជាពិសេស មន្ទីពេទ្យ ឯកជន និង មន្ទីរពេទ្យ រដ្ឋ ត្រូវតែ មាន ទឹក អាល់កុល ចឹល សម្លាប់ មេរោគ និង ម៉ាស សម្រាប់ អតិថិជន រួមទាំង អ្នកជំងឺ នឹង បងប្អូន មក សួរ សុខទុក្ខ ពាក់ ការពារ ចៀសវាង ការឆ្លង រោគ ពី ម្នាក់ ទៅ ម្នាក់ ។ សូម បងប្អូន ប្រជាពលរដ្ឋ បន្ត ធ្វើ តាម ការណែនាំ របស់ ក្រសួង សខាភិបាល ឱ្យ បាន ខ្ជាប់ខ្ជួន » ។
សម្តេច បាន ជូនពរ បងប្អូន ធ្វើដំណើរ មាន សុខ សុវត្ថិភាព នឹង ចៀស ផុត ពី ជំងឺ ឆ្លង កូវីដ - ១៩ ទាំងអស់ គ្នា ។
រហូតដល់ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ កម្ពុជា រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ សរុប ១៥៦ នាក់ ។ ក្នុង នោះ ១៣៣ នាក់ បាន ព្យាបាល ជាសះស្បើយ ហើយ ២៣នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត និង មជ្ឈមណ្ឌល ចាក់អង្រែ ៕
ក្រសួង បន្ថែម ថា បុរស ទាំង ១៥នាក់ ខាងលើ នេះ ជា អ្នកធ្វើដំណើរ មកពី ប្រទេស អារ៉ាប់ប៊ី សាអូឌី បន្ត ជើងហោះហើរ ពី ប្រទេស ម៉ាឡេស៊ី មកដល់ កម្ពុជា កាលពី ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ វេលា ម៉ោង ១៧: ២៥ នាទី ល្ងាច ។ ការវិភាគ វត្ថុ សំណាក ដោយ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន បង្ហាញ លទ្ធផល វិជ្ជមាន វីរុស កូវីដ - ១៩ និង បច្ចុប្បន្ន នេះ អ្នកជំងឺ ទាំង ១៥នាក់ ខាងលើ នេះ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មណ្ឌល សុខភាព ចាក់ អង្រែ រាជធានី ភ្នំពេញ ។
រីឯ អ្នកដំណើរ ចំនួន ៧៩ នាក់ ដែល មាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ ត្រូវបាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ចំនួន ១៤ ថ្ងៃ នៅ មណ្ឌល ចត្តាឡី ស័ក ជំពូរ វ័ន្ត មួយ ក្នុង រាជធានី ភ្នំពេញ ។
ក្រសួង បាន ឱ្យដឹង ថា ជើងហោះហើរ នេះ មាន អ្នកដំណើរ សរុប ទាំងអស់ ចំនួន ៩៤ នាក់ ( ស្រី ៣នាក់ និង មាន បុរស ជនជាតិ ម៉ាឡេស៊ី ០១នាក់ ) ហើយ ក្នុង ចំនួន ៩៤ នាក់ នេះ មាន ៨០ នាក់ ជា អ្នក ដែល បាន ធ្វើដំណើរ មកពី ប្រទេស អារ៉ាប់ប៊ី សាអូឌី ។
« បញ្ហា ប្រឈម របស់ វិស័យ ខុនដូ នៅ កម្ពុជា ដោយសារ ជំងឺ កូវីដេ១៩ » ជា ប្រធានបទ កិច្ចសម្ភាស កម្មវិធី « ភ្ញៀវ ពិសេស ប្រចាំ សប្តាហ៍ » ផ្សាយ នៅ ថ្ងៃចន្ទ ស្អែក នេះ
* អង់គ្លេស ចូល ឈ្លានពាន វែលស៍ បាន សម្រេច ប៉ុន្តែ បរាជ័យ ជាមួយ ស្កុត លែន
* អង់គ្លេស និង ស្កុត លែន ចង សម្ព័ន្ធ មេត្រីភាព ជាមួយគ្នា ដើម្បី ក្លាយជា « ចក្រភព អង់គ្លេស »
ទោះបី ពេល នោះ ស្កុត លែន និង អង់គ្លេស មាន ស្តេច តែ មួយ ក៏ដោយ ប្រទេស ទាំង ពីរ នៅតែ ជា អាណាចក្រ ពីរ មាន នយោបាយ និង សភា ដាច់ ដោយឡែក ពី គ្នា ។ អស់ រយៈពេល ប្រមាណ ជាមួយ សតវត្សរ៍ មាន ការព្យាយាម មួយ ចំនួន ដើម្បី រួមបញ្ចូល អាណាចក្រ ទាំង ពីរ ឲ្យ ក្លាយទៅជា ប្រជាជាតិ តែ មួយ ប៉ុន្តែ មិន ទទួល ជោគជ័យ ។ រហូតមកដល់ ឆ្នាំ ១៧០៧ អង់គ្លេស និង ស្កុត លែន ក៏ បាន ចង សម្ព័ន្ធ មេត្រីភាព ក្លាយជា ចក្រភព អង់គ្លេស នៅក្រោម មហាក្សត្រីយ៍ អាន (Anne) ។
* ចក្រភព អង់គ្លេស ចង សម្ព័ន្ធ មេត្រីភាព ជាមួយ អៀរឡង់ ប៉ុន្តែ អៀរឡង់ ខាងត្បូង បាន ផ្តាច់ ខ្លួន ចេញ
បើ តាម លោក សាស្រ្តាចារ្យ Whatley អង់គ្លេស ប្រើ ការ ចង សម្ព័ន្ធ មេត្រីភាព ឆ្នាំ ១៧០៧ ជាមួយ ស្កុត លែន ធ្វើជា គំរូ សម្រាប់ ការចង សម្ព័ន្ធ មេត្រី ភាព ឆ្នាំ ១៨០១ ជាមួយ អៀរឡង់ ។ ក៏ប៉ុន្តែ ការចង សម្ព័ន្ធ មេត្រីភាព មិន បាន នៅ ឋិតថេរ យូរអង្វែង នោះ ឡើយ ។ នៅ ចន្លោះ ឆ្នាំ ១៩១៩ - ១៩២១ កងទ័ព សាធារណរដ្ឋ អៀរឡង់ បាន ងើប ឡើង ប្រយុទ្ធតស៊ូ ដើម្បី ទាមទារ ឯករាជ្យ ពី ចក្រភព អង់គ្លេស ។ សង្រ្គាម នេះ បាន បញ្ចប់ ទៅ វិញ ដោយ អៀរឡង់ ត្រូវ បែក ខ្ញែក ជា ពីរ គឺ តំបន់ ខាងជើង និង តំបន់ ខាងត្បូង នៅ ឆ្នាំ ១៩២២ ។
តំបន់ អៀរឡង់ ខាងជើង នៅតែ បន្ត ជា ផ្នែក នៃ ចក្រភព អង់គ្លេស ដដែល ខណៈ អៀរឡង់ ខាងត្បូង បាន ក្លាយជា រដ្ឋ សេរី មួយ ដាច់ដោយឡែក ។ នៅ ឆ្នាំ ១៩៣៧ អៀរឡង់ ខាងត្បូង ក៏ បាន ក្លាយជា ប្រទេស អៀរឡង់ ឬ សាធារណរដ្ឋ អៀរឡង់ ដែល មាន អធិបតេយ្យភាព ពេញលេញ ហើយ នៅ ឆ្នាំ ១៩៧៣ បាន ចូល ជា សមាជិក សហភាព អឺរ៉ុប ហើយ បន្ត រហូតមក ទល់ បច្ចុប្បន្ន ។ ចំណែក ចក្រភព អង់គ្លេស វិញ ទើបតែ បាន ចាកចេញ ពី សហភាព អឺរ៉ុប ។
* ឈ្មោះ របស់ ចក្រភព អង់គ្លេស
( ភ្នំពេញ ) ៖ លោក ម៉េត មាស ភក្តី អ្នកនាំពាក្យ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ប្រជាពលរដ្ឋ រស់ នៅ លើ សំណង់ មិន រៀបរយ លើ ផ្លូវ សាធារណៈ តំបន់ តំបន់ អតីត បន្ទាយ ស្លឹក ចំនួន ៨៧ ខ្នង ផ្ទះ ស្ម័គ្រចិត្ត រុះរើ ចេញ និង ទទួលយក ដី កម្មសិទ្ធិ ស្រប ច្បាប់ នៅ តំបន់ អភិវឌ្ឍន៍ ថ្មី នៅ វិហារ សួគ៌ ។
លោក ម៉េត មាស ភក្តី បាន បញ្ជាក់ បន្ត ថា ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ និង អនុវត្ត តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ក្នុង ការផ្តល់ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ពិតប្រាកដ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ដឹកនាំ រៀបចំ ចាត់ចែង ការអនុវត្ត ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ តាំងពី ដំណាក់កាល ចាប់ផ្តើម រៀបចំ នីតិវិធី រហូត ឈានដល់ ការរុះរើ ដោយ ស្ម័គ្រចិត្ត ដែល ប្រជាពលរដ្ឋ ពេញចិត្ត ទទួលយក ។
សូម បញ្ជាក់ ថា អនុវត្ត តាម ការណែនាំ របស់ លោក អភិបាល រាជធានី ភ្នំពេញ . លោក ម៉េត មាស ភក្តី ក៏ បាន ដឹកនាំ សម្របសម្រួល ដោះស្រាយ ដោយ ផ្ទាល់ ជាមួយ ប្រជាពលរដ្ឋ រស់ នៅ លើ ផ្លូវ សាធារណៈ តំបន់ បឹងកេងកង នេះ រហូត ឈានដល់ ការសម្រេចចិត្ត ចាកចេញ ៕
ឃាត់ខ្លួន មេក្លោង ជួញដូរ គ្រឿងញៀន ជនជាតិ ឡាវ ២នាក់ រួម ជាមួយ ថ្នាំញៀន ជិត ៦គីឡូក្រាម នៅ ខេត្ត ស្ទឹងត្រែង
( ស្ទឹងត្រែង ) ៖ កម្លាំង សមត្ថកិច្ច បាន ឃាត់ខ្លួន មេក្លោង ជួញដូរ គ្រឿងញៀន ឆ្លង ដែន ជនជាតិ ឡាវ ចំនួន ២នាក់ រួម ជាមួយ ថ្នាំញៀន ជិត ៦គីឡូក្រាម នៅ ចំណុច ផ្លូវ លំ ភូមិ អូរ ស្វាយ ឃុំ អូរ ស្វាយ ស្រុក បុរី អូរ ស្វាយ សែន ជ័យ ខេត្ត ស្ទឹងត្រែង នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
ប្រតិបត្តិការ ចុះបង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន ខុស ច្បាប់ ខាងលើ នេះ អនុវត្តន៍ តាម វិធាន ញុះញង់ ដែល មាន កម្លាំង ជំនាញ « ក៩ » នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ដឹកនាំ បញ្ជា ដោយ ឧត្ដមសេនីយ៍ យិន បញ្ញា រិទ្ធ នាយក រង មន្ទីរ ប្រឆាំង គ្រឿងញៀន សហការ ជាមួយ កម្លាំង នគរបាល ខេត្ត ស្ទឹងត្រែង ។
មេក្លោង ជួញដូរ គ្រឿងញៀន ជនជាតិ ឡាវ ២នាក់ នេះ ឈ្មោះ ស៊ូ បាន់ ភេទ ប្រុស អាយុ ៣២ ឆ្នាំ ជនជាតិ ឡាវ មាន ទីលំនៅ បច្ចុប្បន្ន ភូមិ ណា ស៊ែង ខាំ ស្រុក សៃ ខេត្ត ឧត្ដម សៃ ប្រទេស ឡាវ និង ឈ្មោះ ចាន់ ឌី ភេទ ប្រុស ជនជាតិ ឡាវ អាយុ ៣១ ឆ្នាំ ទីលំនៅ ភូមិភាងញ៉ា ស្រុក ហ៊ុន ខេត្ត ឧត្ដម សៃ ប្រទេស ឡាវ ។
ក្នុង ប្រតិបត្ដិ នោះ កម្លាំង សមត្ថកិច្ច បាន ចាប់ យក វត្ថុតាង ថ្នាំ ញៀន ប្រភេទ ម៉េតំហ្វេតាមីន ៦កញ្ចប់ ទម្ងន់ សុទ្ធ ៥៩៨៦. ២៩ក្រាម ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ថ្ងៃទី ១១ ខែកក្កដា នេះ មាន យានយន្ត ១៤៧០ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ. រយៈពេល ៧២ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៩៩៤៣២ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៧៣០៨១ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២៦៣៥១ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ៧២ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បទល្មើស ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១១លើក ផងដែរ ក្នុង នោះ ស្លាប់ ៤នាក់ របួស ២៩ នាក់ ( របួស ធ្ងន់ ១៤នាក់ )៕ អគ្គ រាជ ទូត កម្ពុជា លោក ឡុង ឌីម៉ង់ ចូល គោរព វិញ្ញាណក្ខន្ធ អភិបាល ក្រុង សេអ៊ូល
រាជ បណ្ឌិត្យ សភា កម្ពុជា នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក៏ បាន រៀបចំ វេទិកា ពិភាក្សា និង ពិនិត្យ ទៅ លើ លទ្ធផល នៃ ទំនាក់ទំនង រវាង កម្ពុជា - អាមេរិក ក្នុង រយៈពេល ៧០ ឆ្នាំ នេះ ផងដែរ ។ ទំនាក់ទំនង កម្ពុជា - អាមេរិក បន្ទាប់ ភ្ជាប់ ជា ផ្លូវការ នៅក្នុង ឆ្នាំ ១៩៥០ ក៏ ត្រូវបាន កាត់ផ្តាច់ ទៅ វិញ នៅ ឆ្នាំ ១៩៦៣ ហើយក៏ បាន ភ្ជាប់ ជាថ្មី នៅ ឆ្នាំ ១៩៦៩ ហើយក៏ ត្រូវ កាត់ផ្តាច់ ជាថ្មី ម្តង ទៀត នៅ ឆ្នាំ ១៩៧៥ ។ រហូតដល់ ឆ្នាំ ១៩៩១ ទើប ទំនាក់ទំនង នេះ ត្រូវបាន តភ្ជាប់ ជាថ្មី រហូតមកដល់ ពេល បច្ចុប្បន្ន ។
រយៈពេល ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង រវាង កម្ពុជា និង អាមេរិក ត្រូវបាន មើលឃើញ ថា មាន ភាព ល្វីង ជូរ ចត់ ច្រើន ជាង ភាពល្ហែម និង លិច អណ្តែត មិន ទៀងទាត់ នោះ ឡើយ ។ ក្នុង រយៈពេល ប្រមាណ ៣០ ឆ្នាំ ចុងក្រោយ នេះ បើ ទោះបី ថា កម្ពុជា និង អាមេរិក ត្រូវបាន វាយតម្លៃ ថា ល្អ ប្រសើរ ជាង ៤០ ឆ្នាំ មុន ក្តី តែ ក៏ នៅ មាន ការប៉ះទង្គិច និង មាន ពាក្យ សម្តី ធ្ងន់ ស្រាល ដាក់ គ្នា ម្តងម្កាល ផងដែរ ។
ក្នុង វេទិកា វិទ្យាសាស្ត្រ ជជែក និង ពិភាក្សា លើ ទំនាក់ទំនង រវាង កម្ពុជា និង អាមេរិក នា ព្រឹក មិញ នេះ វា គ្មិន ជំនាញ រួម មាន មន្ត្រី ការទូត ផង នោះ បាន ជជែកគ្នា ច្រើន ពី សកម្មភាព ទំនាក់ទំនង និង មូលហេតុ មួយចំនួន ដែល នាំឱ្យ កម្ពុជា និង អាមេរិក មាន ទំនាក់ទំនង មិន សូវ ជា ល្អ នឹង គ្នា ។
លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន មើលឃើញ ថា ទំនាក់ទំនង មិន ល្អ ប្រសើរ រវាង កម្ពុជា និង អាមេរិក នេះ បណ្តាល មកពី បញ្ហា ចម្បង ចំនួន ៥រួម មាន៖ គោល នយោបាយ ខុសគ្នា . ស្រមោល របស់ ចិន . នយោបាយ ផ្ទៃក្នុង . ទស្សនៈ ខុសគ្នា លើ បញ្ហា លទ្ធិ ប្រជាធិបតេយ្យ សេរីភាព បញ្ចេញមតិ និង សិទ្ធិ មនុស្ស ជាដើម និង ឥរិយាបថ របស់ អ្នក ការទូត ផងដែរ ។
បើ ទោះបី ថា ក្នុង ទំនាក់ទំនង រយៈពេល ៧០ ឆ្នាំ កន្លងមក នេះ ទំនាក់ទំនង រវាង កម្ពុជា និង អាមេរិក មិន សូវ ជា ល្អ ប្រសើរ តែ ក៏ មាន កត់សម្គាល់ ឃើញ ពី ការដើរ តួនាទី ដ៏ សំខាន់ មួយ របស់ សហរដ្ឋ សម្រាប់ ការអភិវឌ្ឍ នៅ កម្ពុជា ក្នុង រយៈពេល ប្រមាណ ៣ទសវត្សរ៍ ចុងក្រោយ នេះ ផងដែរ ។ ការដើរ តួនាទី នោះ មាន តាមរយៈ ការធ្វើ ពាណិជ្ជកម្ម ដែល ទំហំ ពាណិជ្ជកម្ម ប្រទេស ទាំង ពីរ មាន ដល់ ជាង ៣ពាន់ លាន ដុល្លារ ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ និង ជំនួយ អភិវឌ្ឍន៍ ប្រមាណ ៣ ពាន់ លាន ដុល្លារ ក្នុង រយៈពេល ៣ទសវត្សរ៍ ឆ្នាំ ក្រោយ ។
លោក ហ៉ីង ថូរ៉ាក់ស៊ី រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន កត់សម្គាល់ ថា សហរដ្ឋ អាមេរិក គឺជា ដៃគូ ដ៏ សំខាន់ មួយ របស់ កម្ពុជា ក្នុង ការអភិវឌ្ឍ ប្រទេស ទាំង ក្នុង ជំនួយ អភិវឌ្ឍ ក៏ ដូចជា ក្នុង នាមជា ដៃគូ ពាណិជ្ជកម្ម ដែល សហរដ្ឋ អាម៉េរិក គឺជា ទីផ្សារ នាំចេញ ដ៏ ធំ មួយ របស់ កម្ពុជា ។
លោក បន្ថែម ថា រយៈពេល ៧០ ឆ្នាំ មក មក នេះ កម្ពុជា និង អាមេរិក បាន ធ្វើ កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ជាច្រើន ដូចជា ពាណិជ្ជកម្ម កសិកម្ម បរិស្ថាន ការប្រឆាំង ភេរវកម្ម កិច្ចសហប្រតិបត្តិការ យោធា ការអប់រំ និង សុខាភិបាល ជាដើម ។
ក្នុង វេទិកា បែប វិទ្យាសាស្ត្រ នា ព្រឹក មិញ ទាំង មន្ត្រី ជាន់ ខ្ពស់ របស់ កម្ពុជា ក៏ ដូចជា ឯក អគ្គ រដ្ឋទូត អាមេរិក សុទ្ធតែ បង្ហាញ ឱ្យ ឃើញ នូវ បំណង កសាង នូវ ទំនាក់ទំនង មួយ កាន់តែ ល្អ ប្រសើរ រវាង កម្ពុជា និង អាមេរិក ក្នុង ឆ្នាំ បន្តបន្ទាប់ ។
លោក ហ៉ីង ថូរ៉ាក់ស៊ី បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ស្វាគមន៍ ប្រកបដោយ ភាពកក់ក្ដៅ ចំពោះ កិច្ចសហប្រតិបត្តិការ ល្អ និង ជិតស្និទ្ធ រវាង កម្ពុជា និង សហរដ្ឋ អាមេរិក ក្នុង ភាពស្មើ មុខ ស្មើ មាត់ គ្នា ជា ដៃគូ ទាំង ក្នុង ឆាក តំបន់ និង អន្តរជាតិ ឆ្ពោះ ទៅកាន់ ការការ រីកចម្រើន ជាលំដាប់ នូវ ការ កសាង ទំនុកចិត្ត ចំពោះ គ្នា ទៅ វិញ ទៅមក ទាំង រវាង ប្រជាជន និង ប្រជាជន ក៏ ដូចជា រដ្ឋាភិបាល នៃ ប្រទេស ទាំង ពីរ ។
ការបង្ហាញ បំណង ចង់ កសាង ទំនាក់ទំនង ល្អ នឹង គ្នា ជា រឿង ល្អ មួយ តែ ការធ្វើឱ្យ សម្រេច នូវ បំណង នេះ ទើប ជា រឿង លំបាក ។ តើ មាន ការងារ អ្វី ខ្លះ ដែល ត្រូវ ធ្វើ ហើយ បញ្ហា អ្វី ដែល ត្រូវ ដោះស្រាយ ដើម្បី សម្រេច បំណង សាង នូវ ទំនាក់ទំនង មួយ ល្អ ?
គោលការណ៍ លទ្ធិ ប្រជាធិបតេយ្យ ការគោរព សិទ្ធិ មនុស្ស គឺជា មូលហេតុ មួយ ដែល នាំឱ្យ គេ មើលឃើញ ថា ធ្វើឱ្យ កម្ពុជា និង អាមេរិក ល្អក់កករ ជាមួយគ្នា ។ ត្រង់ ចំណុច នេះ លោក បណ្ឌិត សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា ចង់ឱ្យ សហរដ្ឋ អាមេរិក មាន ការយោគយល់ ចំពោះ កម្ពុជា ដោយ មិន ត្រូវ ចាប់បង្ខំ កម្ពុជា ឱ្យ អនុវត្តន៍ តាម ខ្លួន នោះ ឡើយ ព្រោះថា វិថី ប្រជាធិបតេយ្យ នៅ ក្មេងខ្ចី នៅឡើយ សម្រាប់ កម្ពុជា ។
ក្រៅពី ការសម្របសម្រួល លើ ដំណើរការ ប្រជាធិបតេយ្យ នោះ ការបង្កើន ការវិនិយោគ របស់ អាមេរិក នៅ កម្ពុជា ក៏ ជា ច្រក ដ៏ សំខាន់ មួយ ដែល នាំឱ្យ ទំនាក់ទំនង របស់ កម្ពុជា និង អាមេរិក មាន ភាពល្អ ប្រសើរ ផងដែរ ។ លោក សុខ ទូច បាន គូសបញ្ជាក់ ថា គ្មាន ការងារ ទូត ណាមួយ មិន រក ផលប្រយោជន៍ នោះ ទេ ។ លោក បាន អះអាង ទៀត ថា នយោបាយ ការបរទេស អត់ មាន ផលប្រយោជន៍ គេ មិន ធ្វើ នោះ ឡើយ ។
លោក គិន ភា បន្ត ថា « ការបើក បេះដូង ក្នុង ការវិនិយោគ របស់ អាមេរិក មកកាន់ កម្ពុជា ដូច អាមេរិក ធ្វើ ចំពោះ ប្រទេស ដទៃ ក៏ នឹង នាំឱ្យ អាមេរិក មាន ឥទ្ធិពល ខ្លាំង មក លើ កម្ពុជា ផងដែរ » ។
( ភ្នំពេញ ) ៖ លោក ឧត្ត សេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ក្នុង ឱកាស ចុះ សួរសុខទុក្ខ មន្ដ្រី នគរបាល ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន អះអាង ថា លោក មិន ទុកឲ្យ មន្ដ្រី ណា ម្នាក់ នៅឯ កោ ពេល មាន ជំងឺ គ្រោះថ្នាក់ ចរាចរណ៍ ឬ ជួប បញ្ហា ផ្សេង ៗ ឡើយ ។
លោក ឧត្តមសេនីយ៍ ឯក ស ថេត ក្នុង នាម ជា ថ្នាក់ដឹកនាំ ម្នាក់ ដែល តែងតែ យកចិត្តទុកដាក់ និង បារម្មណ៍ អំពី សុខ ទុក្ខ របស់ មន្ត្រី ក្រោម ឱវាទ ហើយ លោក តែងតែ ឆ្លៀត ពេល ជាប្រចាំ ទោះជា ថ្ងៃសៅរ៍ អាទិត្យ ឬ ថ្ងៃ ឈប់សម្រាក ក្តី ក៏ ឆ្លៀត ពេល ដើម្បី ចុះ មើល និង សួរសុខទុក្ខ ដោយ ផ្ទាល់ ដើម្បីឲ្យ បាន ឃើញ ច្បាស់ អំពី ស្ថានភាព ជាក់ស្តែង ។
ជាពិសេស ការចុះ សួរសុខទុក្ខ ដោយ ផ្ទាល់ នេះ គឺជា ឱសថ ដ៏ ស័ក្ត សិទ្ធ ដែល បាន លើកទឹកចិត្ត ដ៏ ខ្លាំងក្លា ដល់ មន្ត្រី ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ ផងដែរ ម្យ៉ាង វិញ ទៀត តាម ការសង្កេត របស់ ក្រុមការងារ បាន ឃើញ ថា មន្ត្រី ទាំងឡាយ ដែល បាន លោក ស្នងការចុះ សួរសុខទុក្ខ ដោយ ផ្ទាល់ គាត់ បាន បង្ហាញ អារម្មណ៍ ក្តុកក្តួល រំភើប ស្ទើរតែ ទប់ទឹកភ្នែក មិន បាន ព្រោះតែ ក្តីរីករាយ ខ្លាំង ដោយ បាន ឃើញ ថ្នាក់ដឹកនាំ ចំណាយ ពេល ចុះ សួរសុខទុក្ខ មន្ត្រី របស់ ខ្លួន ដល់ មន្ទីរពេទ្យ និង គេហដ្ឋាន ដោយ ផ្ទាល់ បែប នេះ ។
ក្នុង ការចុះ សួរសុខទុក្ខ នេះ លោក ឧត្តមសេនីយ៍ ឯក ស ថេត បាន នាំយក ជា សម្ភារ និង ថវិកា មួយ ចំនួន ដើម្បី ផ្តល់ ជូន មន្ត្រី កំពុង សម្រាក ព្យាបាល ជំងឺ ហើយក៏ អាច ជួយ សម្រាល មួយ ផ្នែក សម្រាប់ ការព្យាបាល ផងដែរ ។ ជាមួយ នោះ ដែរ លោក ស្នងការបាន ណែនាំឲ្យ មន្ត្រី ទាំងអស់ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការថែទាំ សុខភាព ហើយ ជូនពរ ឲ្យ ឆាប់ ជាសះស្បើយ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន ផ្តាំផ្ញើ មន្ត្រី ក្រោម ឱវាទ ទាំងអស់ ត្រូវ ឆ្លៀត ពេល ទៅ សួរសុខទុក្ខ មិត្ត រួម ការងារ ដើម្បី ជា លើកទឹកចិត្ត កុំ ឲ្យ មាន ពាក្យ និយាយ ថា ពេល មន្ត្រី នៅ មាន កម្លាំង ប្រើ គាត់ ដើម្បី បម្រើ ប្រជាពលរដ្ឋ និង អង្គភាព ពេល គាត់ ឈឺ បែរជា គ្មាន នរណា ម្នាក់ យកចិត្ត ទុក្ខ ដាក់ ឬ មក សួរ សុខទុក្ខ គាត់ ឡើយ ៕ សមត្ថកិច្ច ដោះលែង មន្ត្រី កងរាជអាវុធហត្ថ ដែល ដក កាំភ្លើង វាយ ក្បាល មន្ត្រី យោធា បែក ក្បាល ក្រោម ការសម្របសម្រួល គ្នា បញ្ចប់ រឿង
( កណ្ដាល ) ៖ ករណី ទំនាស់ គ្នា រឿង ជិះ ម៉ូតូ ចាំង ភ្លើង គ្នា បន្តិច ធ្វើឲ្យ មន្ត្រី កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ម្នាក់ ឈ្លោះប្រតាយ ប្រតប់ គ្នា ហើយ ដក កាំភ្លើង ខ្លី វាយ ក្បាល មន្ត្រី យោធា ម្នាក់ បណ្ដាលឲ្យ បែក ក្បាល ហូរ ឈាម ស្រោច ខ្លួន នោះ ត្រូវបាន សម្របសម្រួល គ្នា ដោយ ថ្នាក់ដឹកនាំ ភាគី ទាំង សងខាង សម្រុះសម្រួល គ្នា ក្រៅ ប្រព័ន្ធ តុលាការ ដើម្បី បញ្ចប់ រឿង ។
មន្ត្រី កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ជា ជនដៃ ដល់ ឈ្មោះ ជា សង្ហា អាយុ ៣១ ឆ្នាំ មាន ទីលំនៅ ភូមិ ស្នា ពីមុខ ឃុំ ព្រែក ខ្ពប ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន រួម ជាមួយ វត្ថុតាង ចាប់ យក បាន មាន អាវុធ ខ្លី ម៉ាក K54 ចំនួន ០១ ដើម . បង់១. គ្រាប់ ចំនួន ៨គ្រាប់ ។ រីឯ ជនរងគ្រោះ ឈ្មោះ លាង សុធី អាយុ ២៦ ឆ្នាំ មុខរបរ យោធា កង កិត្តិយស ត្រែទ័ព មាន ទីលំនៅ ភូមិ ស្វាយ ជ្រំ ឃុំ ស្វាយ ជ្រំ ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្ដាល ។
បើ តាម សមត្ថកិច្ច រៀបរាប់ ដំណើរ រឿង ថា ហេតុការណ៍ ប៉ះ គ្នា នេះ បាន កើតឡើង កាលពី យប់ ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ចំណុច ភូមិ ស្វាយ ជ្រំ ឃុំ ស្វាយ ជ្រំ ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្ដាល ដោយ ជនសង្ស័យ បាន ជិះ ម៉ូតូ ឌុប ប្រពន្ធ និង ប្អូន ស្រី ខ្លួន ចេញ ពី កម្មវិធី ឡើង គេហដ្ឋាន គេ នៅ បុរី ចតុមុខ ភូមិ ស្វាយ ជ្រំ ឃុំ ស្វាយ ជ្រំ ។
ប៉ុន្តែ បើ តាម ការឲ្យដឹង នគរបាល សុំ មិន បញ្ចេញ ឈ្មោះ ករណី ហិង្សា នេះ ត្រូវបាន សម្របសម្រួល គ្នា ដោយ មេ ធំ ទាំង សងខាង ដោយ យល់ព្រម បញ្ចប់ រឿង ត្រឹម នេះ មិន រក រឿង គ្នា បន្ត ទៀត នោះ ទេ ខណៈ គេ ពុំ បាន ដឹង ថា ការសម្របសម្រួល គ្នា នេះ ខាង ជនរងគ្រោះ ទទួល ទទួលបាន សំណង ឬ យ៉ាងណា នោះ ទេ ៕ អ៉ីរ៉ង់ មិន ព្រម ចុះចាញ់ ទណ្ឌកម្ម អាមេរិក ខណៈ ការនាំចេញ ប្រេង ធ្លាក់ចុះ រាប់ លាន បារ៉ែល
គួរ បញ្ជាក់ ថា សហរដ្ឋ អាមេរិក បាន ដាក់ទណ្ឌកម្ម សេដ្ឋកិច្ច ទៅ លើ ប្រទេស អ៉ីរ៉ង់ ឡើងវិញ បន្ទាប់ពី ទីក្រុង វ៉ាស៊ីនតោន បាន ដក ខ្លួន ចេញ ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ អ៉ីរ៉ង់ កាលពី ឆ្នាំ ២០១៨ ។ បើ តាម ការប៉ាន់ស្មាន់ អ៉ីរ៉ង់ បាន នាំចេញ ប្រេង ប្រមាណ ត្រឹមតែ ១០០.០០០ ទៅ ២០០.០០០ បារ៉ែល ក្នុង មួយ ថ្ងៃ ប៉ុណ្ណោះ ពោល គឺ មាន ធ្លាក់ចុះ ជាង ២. ៥លាន បារ៉ែល បើ ធៀប ទៅនឹង ការនាំចេញ កាលពី ខែមេសា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ៕
ចិន រកឃើញ វីរុស កូរ៉ូណា ក្នុង កេស ផ្ទុក បង្គា ស្រស់ នាំចូល ពី ប្រទេស មួយ
យោង តាម ស្ថិតិ ពី សម្ព័ន្ធ កែច្នៃ ជល ផល និង ទីផ្សារ របស់ ចិន បាន ឱ្យដឹង ថា បង្គា ជិត ៣ម៉ឺន តោន ត្រូវបាន នាំចេញ ពី ប្រទេស អេក្វាឌ័រ មកកាន់ ប្រទេស ចិន គិត ត្រឹម អំឡុង ខែមីនា ឆ្នាំ នេះ ។ ដោយឡែក ដើម្បី បង្ការ ហានិភ័យ នៃ ការឆ្លង រាលដាល ជំងឺ COVID-19 តាមរយៈ ការនាំចូល ចំណីអាហារ មក ក្នុង ប្រទេស មន្ត្រី គយ ចិន បាន និង កំពុង ធ្វើ ការត្រួតពិនិត្យ យ៉ាង ដិតដល់ទៅ លើ ចំណីអាហារ ក្លាសេ ទាំងអស់ ។
គួរ បញ្ជាក់ ថា រហូតមកដល់ ពេលនេះ GAC បាន ផ្អាក ការនាំចូល សាច់ ពី ប្រទេស ចំនួន ២៣ ខណៈ ដែល ប្រទេស និង ក្រុមហ៊ុន ជាច្រើន កំពុង សហការ យ៉ាង សកម្ម ជាមួយ ប្រទេស ចិន ។ លើស ពី នេះ អាជ្ញាធរ គយ ចិន បាន និយាយ ថា ក្រុមហ៊ុន ចំនួន ១០ផ្សេង ទៀត បាន ផ្អាក ការនាំចេញ របស់ ពួកគេ មកកាន់ ប្រទេស ចិន តប តាម សុំ ស្នើ អាជ្ញាធរ ចិន ៕
កម្លាំង អាវុធហត្ថ បង្ក្រាប បទល្មើស ជួញដូរ គ្រឿងញៀន នៅ ខេត្ត កំពង់ឆ្នាំង និង រឹបអូ បាន ថ្នាំ ញៀន មួយចំនួន ធំ
( កំពង់ឆ្នាំង ) ៖ ក្រោម បទបញ្ជា ពី លោក ឧត្តមសេនីយ៍ ត្រី សាក់ សារ៉ាង មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ឆ្នាំង . កម្លាំង ជំនាញ បាន ចុះបង្ក្រាប បទល្មើស ជួញដូរ គ្រឿងញៀន រហូត តាម ចាប់ បក្ខពួក ដល់ ខេត្ត ពោធិ៍សាត់ ទៀតផង ។
ក្រោយ សួរនាំ ជនសង្ស័យ កម្លាំង ជំនាញ បាន ធ្វើ ការសុំ ពន្លាត ដែន សមត្ថកិច្ច ដោយ សហការ ជាមួយ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ពោធិ៍សាត់ ក្រោម ការសម្របសម្រួល ពី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ទាំង ពីរ នៅ ថ្ងៃ ដដែល កម្លាំង ក៏ បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ទៀត នៅ ភូមិ ផ្សារ ឃុំ អន្លង់ ត្នោត ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ។ ជនសង្ស័យ មាន ឈ្មោះ ចាប វុទ្ធី អាយុ ៣៦ ឆ្នាំ មាន ទី លំ នៅ ភូមិ - ឃុំ កើត ហេតុ ខាង លើ ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង២នាក់ ខាងលើ និង វត្ថុតាង ត្រូវបាន កម្លាំង ការិយាល័យ ជំនាញ កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង ដើម្បី អនុវត្ត បន្ត តាម នីតិវិធី ៕
មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត រតនគិរី សម្ពោធ ពិព័រណ៍ ពាណិជ្ជកម្ម ២ ថ្ងៃ ដើម្បី ផ្សព្វផ្សាយ គម្រោង ជំរុញ ទីផ្សារ កសិកម្ម ខ្នាត តូច (AIMS) និង លើកតម្កើង ផលិតផល កសិកម្ម ខ្មែរ
( រតនគិរី ) ៖ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត រតនគិរី បាន រៀបចំ ពិធី សម្ពោធ ពិព័រណ៍ ពាណិជ្ជកម្ម ចុង សប្តាហ៍ មាន ចំនួន ២០ស្តង់ រយៈពេល ២ ថ្ងៃ ចាប់ ថ្ងៃទី ១១ - ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ នៅក្នុង បរិវេណ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត រតនគិរី នៅ ភូមិ ពាណិជ្ជកម្ម សង្កាត់ បឹង កន្សែង ក្រុង បាន លុង ខេត្ត រតនគិរី ។
ពិធី សម្ពោធ បាន រៀបចំឡើង ក្រោម វត្តមាន លោក ប៉ាវ ហេង តារា រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម និង លោក យឹម ផែន អភិបាល រង ខេត្ត រតនគិរី ព្រមទាំង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ប្រតិភូ អម ដំណើរ តំណាង មន្ទីរ ពាណិជ្ជកម្ម រាជធានី - ខេត្ត និង តំណាង មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង តំណាង អង្គការ សង្គម ស៊ីវិល ជាច្រើន រូប ទៀត ។
លោក ក៏ បាន បញ្ជាក់ ឲ្យដឹង ផងដែរ ថា នៅក្នុង អំឡុង ពេល ២ ថ្ងៃ នេះ គេ អាច ទិញ សាច់ មាន់ ស្រែ . បន្លែ ស្រស់ . អង្ករ គ្មាន គីមី និង ផលិតផល ផ្សេង ទៀត ដែល ផលិត ផ្ទាល់ ដោយ ពី ក្រុម កសិករ ផលិត សហគមន៍ កសិកម្ម និង បណ្តា ក្រុមហ៊ុន ពាក់ព័ន្ឋ មួយចំនួន ទៀត នៅក្នុង ខេត្ត រតនគិរី ក្នុង តម្លៃ សមរម្យ ផងដែរ ។
ប្រធាន មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត រតនគិរី លោក ខៀវ ថា បាន ប្រាប់ អោយ ដឹង ថា ការតាំងពិព័រណ៌ ពាណិជ្ជកម្ម នេះ ប្រព្រឹត្តទៅ រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១១ - ១២ ខែកក្កដា ឆ្នាំ ២០២០ ដោយ មាន អាជីវករ ចូលរួម សរុប ប្រមាណ ២០ស្តង់ ត្រូវបាន ដាក់ តាំង បង្ហាញ នូវ ផលិតផល ជាច្រើន ប្រភេទ ដែល ប្រកប ទៅ ដោយ គុណភាព និង សុវត្ថិភាព ដែល អាច ឆ្លើយតប ទៅនឹង តម្រូវការ ទីផ្សារ តម្រូវការ អ្នកប្រើប្រាស់ ទាំង ក្នុង និង ក្រៅ ខេត្ត ។
លោក ប្រធាន មន្ទីរ ពាណិជ្ជកម្ម រូប នេះ បញ្ជាក់ ឲ្យដឹង ទៀត ថា ផ្សារ ចុង សប្តាហ៍ នេះ គឺ អនុញាត្តិ ឲ្យ ក្រុម អាជីវករ លក់ដូរ ២ ថ្ងៃ គឺ ថ្ងៃសៅរ៍ និង ថ្ងៃអាទិត្យ ដោយ មិន គិត កម្រៃ ហើយ មាន ការលើកទឹកចិត្ត ឲ្យ ពួកគាត់ ម្ចាស់ តូប លក់ ទាំងអស់ ខាងលើ ក្នុង ១ ថ្ងៃ ម្ចាស់ តូប ទទួល ថវិកា ពី មន្ទីរ ចំនួន ២ម៉ឺន រៀល ថែម ទៀត ផងដែរ ៕ អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន៖ « សមុទ្រ ឈើ » ជា ទី ទាក់ទាញ ទេសចរណ៍ ធម្មជាតិ ដែល ជា មេដែក ដ៏ សំខាន់ ក្នុង ការទាក់ទាញ ភ្ញៀវ ទេសចរ
( កោះកុង) ៖ ជាប់ ឈ្មោះ ល្បី ជា ឋាន កិន្នរ ខេត្ត ពណ៌ បៃតង នៃ ភាគ និរតី របស់ កម្ពុជា ជា ទឹកដី ស្តុកស្តម្ភ ជាង គេ ដោយ សម្បត្តិ ធម្មជាតិ គ្រប់ ប្រភេទ នៅ ម្ខាង មាន ភ្នំ នៅ ម្ខាង ទៀត មាន សមុទ្រ បូក បន្ថែម ទៅ លើ សក្តានុពល អភិវឌ្ឍន៍ ជាច្រើន ទាំង សម្រាប់ វិស័យ សេដ្ឋកិច្ច ថាមពល រ៉ែ ទាំង ក្រោម ដី ក្រោម សមុទ្រ អនាគត កំពង់ផែ ទឹក ជ្រៅ និង ព្រលានយន្តហោះ ខ្នាត អន្តរជាតិ នោះ ជា ខេត្ត កោះកុង ។
មួយវិញទៀត ខេត្ត ដទៃ ទៀត មិន មាន នោះ គឺ សមុទ្រ ឈើ ខេត្ត កោះកុង ដែល មាន តំបន់ ការពារ ធម្មជាតិ ចំនួន ១០កន្លែង គ្របដណ្តប់ លើ ផ្ទៃដី សរុប ជាង ១លាន ហិកតា គឺជា មេដែក ដ៏ សំខាន់ ក្នុង ការ ស្រូបយក ភ្ញៀវ ទេសចរ ឱ្យ មក ទស្សនា ។
តំបន់ ការពារ ធម្មជាតិ ទាំងនោះ បាន ផ្តល់ នូវ សារៈប្រយោជន៍ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ សម្រាប់ ការចិញ្ចឹម ជីវិត របស់ សហគមន៍ មូលដ្ឋាន ជា ជម្រក សម្រាប់ សត្វ និង មនុស្ស ការទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ជាពិសេស ធនធាន ធម្មជាតិ ទាំងនេះ បាន និង កំពុង ដើរ តួយ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ តាមរយៈ សេវាកម្ម ទេសចរណ៍ ធម្មជាតិ និង កំពុង រក្សា លំនឹង បរិស្ថាន ធម្មជាតិ ក្នុង តំបន់ ជាពិសេស ព្រៃ កោងកាង និង ព្រៃ រង ទឹកភ្លៀង តាម ជួរ ភ្នំ ក្រវាញ ភាគ ខាងត្បូង ។
ការការពារ ព្រៃឈើ បាន ក្លាយជា មាន សារៈសំខាន់ ជា អាយុជីវិត សម្រាប់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ នៅ ជី ផាត ដោយសារតែ ភ្ញៀវ ទេសចរ អន្ដរជាតិ ពី គ្រប់ ទិសទី នៅ ជុំវិញ ពិភពលោក បាន មក ទស្សនា សត្វ ព្រៃ ដែល ជា ប្រភេទ កំពុង រងគ្រោះ ស្ថិត ក្នុង បញ្ជី ក្រហម របស់ អង្គការ IUCN ចំនួន ៥៥ ប្រភេទ ដោយ ចំនួន ភ្ញៀវ មាន រហូតដល់ ៣.០០០ នាក់ គឺ គិត តែ ក្នុង ឆ្នាំ ២០១៩ ។
លោក ទូច សុផាន់ នី ប្រធាន គម្រោង សហគមន៍ អេកូ ទេសចរណ៍ នៃ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន បញ្ជាក់ ថា បន្ទាប់ពី បង្កើត ជា សហគមន៍ អេកូ ទេសចរណ៍ ជី ផាត ចាប់តាំងពី ឆ្នាំ ២០០៧ មក បាន ប្រែ មុខមាត់ តំបន់ ដាច់ស្រយាល នេះ យ៉ាង ខ្លាំង គឺ បាន កាត់បន្ថយ ការធ្វើ ចំណាកស្រុក របស់ ប្រជាពលរដ្ឋ ស្ទើរតែ ១០០ ភាគរយ ក៏ប៉ុន្តែ ក្នុង ដំណាក់កាល រាតត្បាត ជំងឺ កូវីដ - ១៩ តំបន់ អេកូ ទេសចរណ៍ ជី ផាត នៅតែ ជា មុខ ព្រួញ សម្រាប់ ភ្ញៀវ ទេសចរ ជាតិ បើ ទោះបី ភ្ញៀវ បរទេស ធ្លាក់ចុះ បន្តិច ក៏ដោយ ។
លោក ទូច សុផាន់ នី បាន ឱ្យដឹង ថា ក្រោយ បង្កើត ជា សហគន៍ មក ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ ជី ផាត ស្រុក ថ្ម បាំង ខេត្ត កោះកុង បាន ងាក មក ប្រកបរបរ ដាំ ដំណាំ នាំ ភ្ញៀវ ទេសចរ ដើរកម្សាន្ត និង ប្រកបរបរ ផ្សេង ៗ ទៀត ដើម្បី បំពេញ តម្រូវការ ភ្ញៀវ ទេសចរ ។
ពាក់ព័ន្ធ ក្នុង រឿង នេះ ដែរ លោក អន សុវណ្ណ ប្រធាន សហគមន៍ អេកូ ទេសចរណ៍ នៃ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន ឱ្យដឹង ថា តាមរយៈ ការបង្កើត តំបន់ ជី ផាត់ ឱ្យ ក្លាយជា កន្លែង អេកូ ទេសចណ៍ នេះ ធ្វើឱ្យ ជីវភាព ប្រជាជន សហគមន៍ បច្ចុប្បន្ន ផ្លាស់ប្តូរ ថ្មី ហើយ ប្រជាពលរដ្ឋ ដែល ធ្លាប់ ពឹង អាស្រ័យ តែ ទៅ លើ ការកាប់ ព្រៃឈើ បរបាញ់ សត្វ ក៏ បាន ផ្លាស់ប្តូរ មក ប្រកបរបរ បែប ទេសចរណ៍ វិញ ។
លោក លោក អន សុវណ្ណ បាន បន្ត ថា ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ បាន នាំគ្នា ចេះ ថែរ រក្សា បរិស្ថាន និង អនុវត្ត អនាម័យ ល្អ សំដៅ ធ្វើ យ៉ាង ឱ្យ តំបន់ ទីនេះ ក្លាយជា កន្លែង ទេសចរណ៍ យ៉ាង សំខាន់ ទាំង ពេល បច្ចុប្បន្ន និង ថ្ងៃ អនាគត ។
គួរ រម្លឹក ថា កាលពី ខែមេសា កន្លងទៅ នេះ ក្រសួង បរិស្ថាន ទើបនឹង ចុះបញ្ជី ដី រដ្ឋ នៅ តំបន់ អភិរក្ស នៃ ដែន ជម្រក សត្វ ព្រៃ ពាម ក្រសោប ខេត្ត កោះកុង ដែល គ្រប់ ដណ្តប់ លើ ផ្ទៃដី សរុប ៤.៦៧២. ៦១ ហិកតា ។ បច្ចុប្បន្ន ក្រសួង កំពុង សិក្សា លទ្ធភាព ចុះបញ្ជី ផ្ទៃដី កោះ នៃ កោះ កុង ក្រៅ ដែល ជា កោះ ធំ ជាង គេ នៅ កម្ពុជា បញ្ចូល ជា តំបន់ “« ឧទ្យាន ជាតិ សមុទ្រ » ឱ្យ បាន ត្រឹម ឆ្នាំ ២០២១ ៕
លោក នេត្រ ភក្ត្រា៖ ក្នុង មួយ ឆ្នាំ កម្ពុជា បង្កើត សំរាម ប្រមាណ ជិត ៤លាន តោន . ខណៈ ភ្នំពេញ ក្នុង មួយ ថ្ងៃ បង្កើត សំរាម ចន្លោះ ពី ២៧០០ ទៅ ៣០០០ តោន
( ភ្នំពេញ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន អះអាង ថា នៅក្នុង មួយ ឆ្នាំ កម្ពុជា បាន បង្កើត សំរាម ប្រមាណ ជិត ៤លាន តោន ពោលគឺ នៅ ទូទាំង ប្រទេស មាន សំរាម ជាង ១ម៉ឺននតោន ក្នុង មួយ ថ្ងៃ ។ ដោយឡែក នៅ រាជធានី ភ្នំពេញ សំរាម ដែល បង្កើតឡើង មាន ចន្លោះ ពី ២៧០០ ទៅ ៣០០០ តោន ក្នុង មួយ ថ្ងៃ ។
ការអះអាង បែប នេះ របស់ លោក នេត្រ ភក្ត្រា បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ ម្សិលមិញ នៅ ចំពោះមុខ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ពិធី សំណេះសំណាល និង ប្រគល់ ធុង សំរាម ជូន ប្រជាពលរដ្ឋ រស់ នៅក្នុង គម្រោង ទី១ បុរី ប៉េង ហួត នៅក្នុង បរិវេណ សួនច្បារ ក្នុង បុរី ប៉េង ហួត បឹង ស្នោរ ។
លោក នេត្រ ភក្ត្រា បាន បន្ថែម យ៉ាង ដូច្នេះ ថា៖ « ក្រសួង បរិស្ថាន សូម អរគុណ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន ចូលរួម ប្រតិបត្តិ មេត្រីភាព ក្នុង ការរស់នៅ ប្រចាំ ថ្ងៃ ជាពិសេស ចូលរួម ញែក សំរាម តាម បច្ចេកទេស ដោយ ទុកដាក់ វេចខ្ចប់ សំរាម តាម ប្រភេទ គឺ សំណល់ សរីរាង្គ សំណល់ ដែល អាច កែច្នៃ និង ប្រើប្រាស់ ឡើងវិញ បាន និង សំណល់ ដែល គ្រោះថ្នាក់ » ។
ការអនុវត្ត គោលការណ៍ ញែក សំរាម តាម ប្រភេទ នេះ ត្រូវបាន អនុវត្ត ដោយ ក្រុមការងារ « ផ្តើម ពី យើង » ដឹកនាំ ដោយ លោក គួច វែង ស្រ៊ុន និង យុវជន ស្ម័គ្រចិត្ត និង ចូលរួម អនុវត្ត ដោយ ក្រុមហ៊ុន បុរី ប៉េង ហួត ហើយ គម្រោង នេះ ទទួលបាន ការគាំទ្រ ដោយ ក្រសួង បរិស្ថាន ក្នុង គោលបំណង បណ្តុះ ស្មារតី ស្រឡាញ់ បរិស្ថាន និង បង្កើន ការចូលរួម របស់ ប្រជាពលរដ្ឋ ញែក សំរាម តាម បច្ចេកទេស និង វេចខ្ចប់ ទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ ដើម្បី បរិស្ថាន ស្អាត និង មាន ផាសុកភាពល្អ ។
រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន រូប នេះ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រុមការងារ « ផ្តើម ពី យើង » ក្រុមហ៊ុន បុរី ប៉េង ហួត ដែល បាន សហការ គ្នា រៀបចំ អនុវត្ត គម្រោង នេះ រហូត បាន ទទួល ជោគជ័យ និង មាន ការចូលរួម គាំទ្រ អនុវត្ត ពីសំណាក់ ប្រជាពលរដ្ឋ ។
ក្នុង ឱកាស នោះ ដែរ លោក នេត្រ ភក្ត្រា បាន ឱ្យដឹង ថា លោក រដ្ឋមន្ត្រី សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន តែងតែ គិតគូរ ជានិច្ច ពី ការថែរក្សា ការពារ និង លើកកម្ពស់ បរិស្ថាន នៅ កម្ពុជា និង បាន ជំរុញ ឱ្យ មាន ប្រតិបត្តិ មេត្រី បរិស្ថាន ។ ជាមួយ នេះ លោក ក៏ បាន លើកឡើង ពី ផលប្រយោជន៍ នៃ ការរៀបចំ ទុកដាក់ និង បែងចែក សំរាម ឱ្យ បាន ត្រឹមត្រូវ និង ផល ប៉ះពាល់ ដែល កើត ចេញពី ការបោះ សំរាម ចោល ផ្តេសផ្តាស ។
សូម បញ្ជាក់ ថា គម្រោង ផ្ដើម ពី យើង បាន ប្រគល់ ធុង សំរាម ចំនួន ២០០ ឈុត ជូន ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង បុរី នេះ ដែល ពលរដ្ឋ អាច ទុកដាក់ សំរាម តាម ប្រភេទ ហើយ នៅលើ ធុង សំរាម នោះ មាន ការរចនា ជា កន្លែង សម្រាប់ ដាំ ដំណាំ រួមផ្សំ ផ្សេង ទៀត ឬ ផ្កា លម្អ ជាដើម ៕ ជប៉ុន ប្រកាស ពី គម្រោង ផលិត យន្តហោះ ចម្បាំង បំបាំង កាយ ជំនាន់ ថ្មី
( តូក្យូ ) ៖ ក្នុង សប្តាហ៍ នេះ ជប៉ុន ទើបតែ បាន ប្រកាស ពី ផែនការ ផលិត យន្តហោះ ចម្បាំង បំបាង កាយ ជំនាន់ ថ្មី ដើម្បី ជំនួស យន្តហោះ ចម្បាំង F-2 ដែល ត្រូវបាន ប្រើប្រាស់ ជាច្រើន ឆ្នាំ មកហើយ នោះ នៅ ទសវត្សរ៍ ខាងមុខ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន CNN នៅ ថ្ងៃអាទិត្យ ទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៖ ទីបំផុត ពាក្យបណ្តឹង របស់ សម្តេច តេជោ ហ៊ុន សែន ប្តឹង ទណ្ឌិត សម រង្ស៉ី ត្រូវបាន ព្រះរាជអាជ្ញា ទីក្រុង ប៉ារីស សម្រេច ឯកភាព ចោទប្រកាន់ តាម ចៅក្រម ស៊ើបសួរ និង ត្រៀម កំណត់ ថ្ងៃ បើក សវនាការ ឆាប់ ៗ ( ចុច អាន )
៣៖ អាមេរិក សរសើរ ថា កម្ពុជា គឺជា ប្រទេស ដែល បាន រួមចំណែក និង ទប់ស្កាត់ បញ្ហា កូវីដ១៩ បាន ល្អ បំផុត ( ចុច អាន )
៤៖ ស្ថាន បេសកកម្ម អចិន្ត្រៃយ៍ កម្ពុជា នៅ ហ្សឺណែវ៖ « វិធានការប្រឆាំង នឹង ការក្លែង ព័ត៌មាន ពុំ មែន ជា ការរិត ត្បិត សេរីភាព ទេ» ( ចុច អាន )
៥៖ សម្តេច ក្រឡាហោម ស ខេង ណែនាំ ៣ ចំណុច ដល់ អភិបាល រាជធានី - ខេត្ត ដើម្បី ធានា តម្លាភាព និង សុចរិត ភាព ក្នុង ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ( ចុច អាន )
៦៖ ប្រធាន រដ្ឋ វៀតណាម ប្រាប់ សម្ដេច តេជោ ថា និស្សិត កម្ពុជា ជាង ៥០០ នាក់ នឹង ទៅ សិក្សា នៅ វៀតណាម វិញ ចាប់ពី ពាក់កណ្ដាល ខែកក្កដា នេះ ( ចុច អាន )
៧៖ ក្រសួង អប់រំ នឹង ស្នើសុំ ការអនុញ្ញាត ពី សម្តេច តេជោ ហ៊ុន សែន បើក សាលារៀន សាកល្បង ដំណាក់កាល ទី១ នៅ ខែសីហា ក្រោយ ( ចុច អាន )
៩៖ ធនាគារ ជាតិ នៃ កម្ពុជា៖ សន្ទុះ នៃ ការប្រើប្រាស់ ប្រាក់ រៀល កើនឡើង គួរឲ្យ កត់សំគាល់ ( ចុច អាន )
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ១២ ខែកក្កដា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ១២ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
ក្រុមការងារ ជន បង្កោល យុវជន ក្រុម៨ ចុះ ចែក អំណោយ ជូន ពលរដ្ឋ ក្រីក្រ ចំនួន ៥០ គ្រួសារ និង បន្ដ ចុះ ពិនិត្យ ផែនការ ការងារ អភិវឌ្ឍន៍ ស្រុក ជើង ព្រៃ
( កំពង់ចាម ) ៖ ក្រុមការងារ ជន បង្កោល យុវជន ក្រុម៨ ដឹកនាំ ដោយ លោក បណ្ឌិត ម៉ឹង មករា បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត និង លោកស្រី ចែកជូន ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៥០ គ្រួសារ នៅក្នុង ឃុំ ទាំង១០ ស្រុក ជើង ព្រៃ នា ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នំា ២០២០ នេះ ។
យុវជន ក្រុម៨ ជា ក្រុមការងារ យុវជន មួយ ដ៏ សំខាន់ ក្នុង ការចូលរួម ចុះ ជួយ ប្រជាពលរដ្ឋ ក្នុង ឃុំ ទាំង១០ នៃ ស្រុក ជើង ព្រៃ បាន បន្ដ បំពេញ កាតព្វកិច្ចការងារ បម្រើ ប្រជាជន ជាពិសេស បង្កើត ឱកាស ការងារ លើកកម្ពស់ ជីវភាព គ្រួសារ នីមួយ ៗ ឱ្យ កាន់តែ មាន ភាពល្អ ប្រសើរឡើង ។
បន្ត មក លោក បណ្ឌិត ម៉ឹង មករា និង ក្រុមការងារ បាន ប្រគេន បច្ច័យ សម្រាប់ វត្ត ស្រម៉ចំនួន ២លាន រៀល និង បាន ទៅ ប្រគេន ទៀន វស្សា និង បច្ច័យ ២លាន រៀល នៅ វត្ត ផ្តៅ ជុំ នឹង ចុះ ពិនិត្យ សមិទ្ធិផល ការងារ នានា ដែល បាន ធ្វើ កន្លងមក ព្រមទាំង ការកសាង ផ្លូវ ថ្មី ជូន ប្រជាពលរដ្ឋ សម្រាប់ ធ្វើដំណើរ និង ដឹក កសិផល ផ្សេង ៗ រួមទាំង ចុះ ស្វែងយល់ ពី ផលលំបាក និង តម្រូវការ របស់ ពលរដ្ឋ បន្ថែម ទៀត ក្នុង អំឡុង ជួប វិបត្ដិ ដោយ ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា ដើម្បី បន្ដ ការអភិវឌ្ឍ ភូមិ ឃុំ ឱ្យ កាន់តែ ស្រស់ស្អាត ក៏ ដូចជា ការផ្ដល់ នូវ ភាពងាយស្រួល ជូន ប្រជាពលរដ្ឋ កន្លងមក យុវជន ក្រុម៨ បាន ចូលរួម ជួសជុល ផ្លូវ លំ ក្រាល គ្រួស ក្រហម បាន ចំនួន ១៥ ផ្លូវ ក្នុង ស្រុក ជើង ព្រៃ ព្រមទាំង បាន ដាំ ដើម ក្ងោក អម តាម សងខាង ផ្លូវ ដើម្បី ចូលរួម ការពារ និង លើកកម្ពស់ សោភណ្ឌភាព បរិស្ថាន រួមទាំង បំផុស នូវ ការស្រលាញ់ ធម្មជាតិ ដល់ ពលរដ្ឋ ផងដែរ ។
លើស ពី នេះ យុវជន ក្រុម៨ ដែល ដឹកនាំ ដោយ លោក បណ្ឌិត ម៉ឹង មករា តំណាង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត គឺ បាន បំពេញ តាម តម្រូវ ការចាំបាច់ របស់ ប្រជាពលរដ្ឋ ជា បន្ដ បន្ទាប់ មិន ថា ផ្លូវថ្នល់ ជីក ស្តារ ប្រឡាយ ដើម្បី ផ្គត់ផ្គង់ ទឹក ដល់ ដំណាំ ស្រូវ និង បង្កើត កម្មវិធី សិក្ខាសាលា ស្តីពី វិធី ធ្វើ ថ្នាំ ការពារ ដំណាំ បង្រៀន ពី របៀប ធ្វើ វ៉ាក់សាំង សត្វ ជូន ដល់ ប្រជាពលរដ្ឋ និង ជួយ សម្រាល ការលំបាក របស់ ពលរដ្ឋ ពេល ជួប នូវ គ្រោះមហន្ដរាយ នានា ដូចជា ការរងគ្រោះ ដោយ អគ្គីភ័យ និង ខ្យល់ កន្ដ្រាក់ នានា ។
សូម បើកបរ ដោយ ការយោគយល់ ! ស្លាប់ ៤នាក់ និង ២៩ នាក់ របួស ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១១ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មាន មនុស្ស ស្លាប់ ៤នាក់ និង អ្នករបួស ធ្ងន់ ស្រាល ២៩ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន មិន ប្រកាន់ ស្តាំ ស្រវឹង កត្តា យានយន្ត ប្រជែង និង មិន គោរព សិទ្ធិ ៕
តំណាងរាស្ត្រ មណ្ឌល កំពង់ស្ពឺ ទាំង៦ រូប អញ្ជើញ ប្រគេន ទៀន វស្សា ព្រះសង្ឃ ដែល គង់ នៅ វត្ត ចំនួន ៦ នៅ ស្រុក បរសេដ្ឋ
ក្នុង ពិធី នេះ ធ្វើឡើង នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ក៏ មាន ការចូលរួម ពី តំណាងរាស្រ្ត មណ្ឌល កំពង់ស្ពឺ ទាំងអស់ ដែល មាន លោក សំ រិទ្ធី . លោក អ៊ូ សំអួន . លោក សុខ ប៊ន . លោក សត្យា វុធ និង លោក តុង សេង ព្រម ជាមួយ សហការី អាជ្ញាធរដែនដី និង ប្រជាពលរដ្ឋ ជាច្រើន ទៀត ផងដែរ ។
( កំពង់ស្ពឺ ) ៖ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក បាន ថ្លែង ថា
ប្រទេសជាតិ រឹងមាំ ផ្អែក ទៅ លើ វិស័យ ការពារ ជាតិ ខ្លាំង ហើយ វិស័យ ការពារ ជាតិ ខ្លាំង ដោយសារ កងទ័ព ខ្លាំង ។
លោក ថ្លែង បែប នេះ ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ សិក្ខាកាម វគ្គ បណ្តុះបណ្តាល យោធាចារ្យ ជំនាន់ ទី២ បំពេញ ក្របខ័ណ្ឌ ឲ្យ សាលា ពល ទាហាន ចំណុះ យោធ ភូមិភាគ ឆ្នាំ ២០២០ មូលដ្ឋាន កងយោធពល ខេមរភូមិន្ទ តេជោ សែន ភ្នំ ធំ ម្រះ ព្រៅ ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ ។
លោក ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ប្រទេសជាតិ រឹងមាំ គឺ ផ្អែក ទៅ លើ វិស័យ ការពារ ជាតិ ខ្លាំង ហើយ វិស័យ ការពារ ជាតិ ខ្លាំង គឺ ដោយសារ កងទ័ព យើង ខ្លាំង ។ នាយ ទាហាន ជំនាន់ មុន បាន បន្សល់ទុក នូវ ស្នាដៃ ការពារ ជាតិ ដើម្បី បុព្វហេតុ ជាតិ មកដល់ យើង សព្វ ថ្ងៃ នេះ ដូច្នេះ យើង ត្រូវ បន្ត ថែរក្សា នូវ កេរមរតក នេះ ទៅ មុខ ទៀត ដោយ ឈរ លើ មូលដ្ឋា នៃ ស្មារតី ឆន្ទៈ បទពិសោធន៍ ហើយ បូក ផ្សំ ជាមួយនឹង សមត្ថភាព ជាក់ស្តែង » ។
លោក បន្ថែម ថា ការហ្វឹកហ្វឺន ពល ទាហាន ឱ្យ មាន មូលដ្ឋានគ្រឹះ ច្បាស់លាស់ គឺជា កត្តា សំខាន់ បំផុត ដែល ធ្វើឱ្យ កងទ័ព របស់ យើង ខ្លាំង ហើយ អាច ការពារ ជាតិ មាតុភូមិ របស់ យើង បាន យូរអង្វែង ទៅ មុខ ទៀត ។ ការហ្វឹកហ្វឺន ត្រូវ ផ្អែក លើ កត្តា ពីរ ទី មួយ គឺ ស្មារតី ស្នេហាជាតិ សាសនា ព្រះមហាក្សត្រ និង ទី ពីរ គឺ កត្តា សមត្ថភាព ដោយ មាន ភាពម្ចាស់ការលើ ខ្លួន ឯង ។ នេះ ហើយ ជា ស្មារតី ជាតិនិយម ដើម្បី បង្កើន នូវ ភាព ជឿ ទុកចិត្ត លើ ខ្លួន ឯង នៅក្នុង ការធានា ម្ចាស់ ការលើ អនាគត របស់ យើង ។
លោក ហ៊ុន ម៉ាណែត បាន បន្ត ថា យោធាចារ្យ មាន តួនាទី សំខាន់ ណាស់ ហើយ អាជីព ជា យោធាចារ្យ មាន លក្ខណៈ ពិសេស ពីរ រួម មាន៖
១៖ គឺ យើង បាន ចូលរួម ដោយ ផ្ទាល់ ក្នុង ការបម្រើ ជាតិ តាមរយៈ ការបង្រៀន ពល ទាហាន របស់ យើង ឱ្យ មាន មូលដ្ឋាន ក្នុង ការការពារ ខ្លួន ក៏ ដូចជា ការពារ អង្គភាព ធានា បាន នូវ ជោគជ័យ ក្នុង ការបំពេញ ភារកិច្ច ដែល ជា មោទភាព ក្នុង ការចូលរួមចំណែក ការពារ ជាតិ តាមរយៈ ការបណ្តុះបណ្តាល នូវ វីរ ជន ឆ្នើម ៗ ។
២៖ គឺ យោធាចារ្យ ទទួលបាន នូវ កិត្តិយស មហាសាល ដែល ដក់ ជាប់ ក្នុង ក្រអៅបេះដូង របស់ សិស្ស គ្រប់ រូប ក្នុង នាម ជា អ្នកមាន គុណ ដែល បាន ផ្តល់ នូវ ចំណេះដឹង ដល់ ពួកគេ ។
ក្នុង ឱកាស នោះ លោក ក៏ បាន អរគុណ ថ្នាក់ដឹកនាំ កងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ . អង្គភាព - ស្ថាប័ន ពាក់ព័ន្ធ . គណៈ គ្រប់គ្រង វគ្គ . យោធាចារ្យ ក៏ ដូចជា នាយ ទាហាន . នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ កងពល តូច លេខ ៧០ ដែល បាន ដែល បាន សហការ ជួយ រៀបចំ និង បង្ក លក្ខណៈ ឱ្យ ការហ្វឹកហ្វឺន នេះ ដំណើរការបាន ល្អ ប្រសើរ និង អរគុណ ដល់ បេក្ខជន យោធាចារ្យ ទាំងអស់ ដែល បាន ស្ម័គ្រចិត្ត និង សកម្ម យកចិត្តទុកដាក់ ចូលរួម នៅក្នុង ការហ្វឹកហ្វឺន នេះ ផងដែរ ៕
ខាងក្រោម គឺជា រូបភាព មួយចំនួន នៃ ស្ថានការណ៍ អន្តរជាតិ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃសៅរ៍ ទី ១១ ខែកក្កដា ឆ្នាំ ២០២០៖
៤៖ ចិន រកឃើញ វីរុស កូរ៉ូណា ក្នុង កេស ផ្ទុក បង្គា ស្រស់ នាំចូល ពី ប្រទេស មួយ
៥៖ អ៉ីរ៉ង់ មិន ព្រម ចុះចាញ់ ទណ្ឌកម្ម អាមេរិក ខណៈ ការនាំចេញ ប្រេង ធ្លាក់ចុះ រាប់ លាន បារ៉ែល
៧៖ តើ វីរុស កូរ៉ូណា ពិតជា ឆ្លង តាម ខ្យល់អាកាស ឬ ? អ្នកជំនាញ អាមេរិក អះអាង ថា « វា ស្ថិត ក្នុង កម្រិត ខ្លះ ប៉ុណ្ណោះ » ឧប នាយក រដ្ឋមន្រ្តី យឹម ឆៃលី ចូល គោរព វិញ្ញាណក្ខន្ធ លោក ហារី សំអាត
( ភ្នំពេញ ) ៖ លោក ឧប នាយក រដ្ឋមន្រ្តី យឹម ឆៃលី ប្រធាន ក្រុមប្រឹក្សា ស្តារ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ចូលរួម គោរព វិញ្ញាណក្ខន្ធ លោក ហារី សំអាត រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី ទទួលបន្ទុក ជា អនុប្រធាន ក្រុមប្រឹក្សា ស្តារ អភិវឌ្ឍ វិស័យ កសិកម្ម និង ជនបទ ។
( បន្ទាយមានជ័យ )៖ ប្រជាពលរដ្ឋ មួយ ក្រុម មាន គ្នា បួន នាក់ បាន ចេញ ពី ស្រុក កំណើត នៅ ខេត្ត ពោធិ៍សាត់ បំណង ឆ្លង ដែន ទៅ ធ្វើការ នៅ ប្រទេស ថៃ ប៉ុន្តែ នៅ ពេល ទៅដល់ ព្រំដែន បែរជា ត្រូវ ជន មិន ស្គាល់ មុខ បោក យក លុយ អស់ ៨.០០០ បាត ហើយ រត់គេចខ្លួន សំណាង ហើយ បាន សមត្ថកិច្ច ប្រចាំ នៅ ព្រំដែន ជួយ យក អាសាឧបត្ថម្ភ បាយ ទឹក និង ថវិកា គ្រាន់ ធ្វើដំណើរ ត្រលប់មក ផ្ទះ វិញ ។
មន្ត្រី ប៉ុស្តិ៍ នគរបាល ប៉ោយប៉ែត បាន ឱ្យដឹង ថា រឿង ហេតុ នេះ បាន កើតឡើង នា ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ចំណុច ក្រោម ស្ពាន មិត្តភាព កម្ពុជា - ថៃ ស្ថិត នៅ ភូមិ ក្បាល ស្ពាន ១ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
តាម ការបំភ្លឺ របស់ ជនរងគ្រោះ មុនពេល ជួប រឿង មិន គប្បី នេះ ពួកគាត់ បាន ធ្វើដំណើរ ពី ខេត្ត ពោធិ៍សាត់ ក្នុង គោលបំណង ចេញ ទៅ រក ការងារ ធ្វើ នៅ ប្រទេស ថៃ ។ លុះ មកដល់ ចំណុច រង្វង់ មូល ប៉ោយប៉ែត ក៏ បាន ជួប នឹង ជន មិន ស្គាល់ អត្តសញ្ញាណ ម្នាក់ ភេទ ប្រុស អាយុ ប្រហែល៣០ ឆ្នាំ ដោយ បាន បបួល ពួកគាត់ ឆ្លង ដែន តាម ផ្លូវកាត់ ដោយ គិត សេវា ក្នុង ម្នាក់ ៣.០០០ បាត ពួកគាត់ ក៏ យល់ព្រម ទៅ ជាមួយ ។ នៅពេល ឆ្លង ទៅដល់ មាត់ អូរ ខាង ទឹកដី ថៃ ជន នោះ ក៏ ទុក ពួកគាត់ ចោល ហើយ យក ប្រាក់ អស់ ចំនួន ៨.០០០ បាត រត់គេចខ្លួន បាត់ ។
ក្រោយ កើត ហេតុ កម្លាំង ផ្នែក ត្រួតពិនិត្យ ចល័ត បាន ចុះ អន្តរាគមន៍ និង នាំ ជនរងគ្រោះ មក អង្គភាព ដើម្បី អប់រំ ណែនាំ និង ផ្ដល់ អាហារ ជូន ពួកគេ បរិភោគ ព្រមទាំង បាន ឧបត្ថម្ភ ប្រាក់ ចំនួន ១.០០០ បាត ដល់ ពួកគាត់ ដើម្បី ធ្វើជា សោហុយ ត្រលប់មក លំនៅដ្ឋានឯ ខេត្ត ពោធិ៍សាត់ វិញ ។
ចំណែក ជនសង្ស័យ ដែល រត់គេចខ្លួន នោះ កម្លាំង នគរបាល ប៉ុស្តិ៍ កំពុង តាមដាន រក មុខ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
ចូរ ប្រាប់ មនុស្ស ជា ទី ស្រលាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែកក្កដា៖ បង្ក្រាប ៣១ ករណី ឃាត់ខ្លួន ៧០ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៣១ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១២ករណី . ជួញដូរ ១៩ ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៧០ នាក់ ។
គំនិត ដែល ថា មហា កំពែង ប្រទេស ចិន ជា សមិទ្ធផល តែ មួយ គត់ ដែល អាច មើលឃើញ ពី ព្រះច័ន្ទ ត្រូវបាន ផ្សព្វផ្សាយ យ៉ាង ទូលំទូលាយ និង បាន បង្កឱ្យ មាន ភាពច្របូកច្របល់ ពី រឿង ឋាន ព្រះច័ន្ទ និង អវកាស ជាច្រើន ។
ការពិត អវកាស នៅ មិន ឆ្ងាយ ប៉ុន្មាន នោះ ទេ ពី ផែនដី គឺ មាន ចម្ងាយ តែ ៩៧ គីឡូម៉ែត្រ ប៉ុណ្ណោះ ដែល ចាប់ពី ចំណុច នោះ មក យើង អាច មើលឃើញ សមិទ្ធផល ជាច្រើន ដូចជា ផ្លូវថ្នល់ ទូក នៅលើ ទន្លេ ផ្លូវ រទេះភ្លើង វាល ស្រែ សូម្បីតែ អគារ មួយចំនួន ក៏ អាច មើលឃើញ ដែរ មាន ន័យ ថា ត្រឹម ចំណុច នេះ យើង នៅ អាច មើលឃើញ មហា កំពែង ប្រទេស ចិន បាន ប៉ុន្តែ ប្រសិនបើ អ្នក ចេញ ផុត ពី ចំណុច នេះ ទៅ អ្នក នឹង មិន អាច មើលឃើញ អ្វី ៗ នៅលើ ផែនដី ទៀត នោះ ឡើយ ។
អភិបាល ខេត្ត កំពត ប្រាប់ មេឃុំ ត្រូវ បម្រើ ប្រជាពលរដ្ឋ ឲ្យ មាន គុណភាព និង ត្រូវ អនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ និង រងគ្រោះ ពិតប្រាកដ
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត ប្រាប់ លោក លោកស្រី ជា មេឃុំ ត្រូវ បម្រើ ប្រជាពលរដ្ឋ ឲ្យ មាន គុណភាព និង ត្រូវ អនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ និង រងគ្រោះ ពិតប្រាកដ ។ ការលើកឡើង របស់ លោក ជា វ តាយ ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ មន្ត្រី បង្គោល គណបក្ស ប្រជាជន កម្ពុជា នៅ ស្រុក បន្ទាយមាស នា ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ ។
ជំនួប សំណេះសំណាល នា ពេលនេះ ក្នុង គោលបំណង ចង់បាន ស្វែងយល់ ពី សភាពការណ៍ មួយចំនួន សំណូមពរ និង បញ្ហា ប្រឈម ដែល កើត មាន ឡើង នៅ ស្រុក បន្ទាយមាស សំដៅ អនុវត្ត ឲ្យបាន ជោគជ័យ នូវ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។
លោក ជា វ តាយ បាន ជម្រាប ប្រាប់ លោក លោកស្រី ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន ឃុំ ចូលរួម មតិ យោបល់ អំពី សំណូមពរ និង បញ្ហា ប្រឈម ដែល កើត មាន ឡើង នៅ តាម មូលដ្ឋាន ឃុំ រៀង ៗ ខ្លួន ។ លោក ក៏ បាន ប្រាប់ ពី សភាពការណ៍ ថ្មី ៗ ពិសេស ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ - ១៩ ផងដែរ ។
ក្នុង ឱកាស នោះ មាន ការអញ្ជើញ ចូលរួម ទទួលស្វាគមន៍ ចំពោះ វត្តមាន សម្តេច ចៅហ្វា វាំង និង ការចូលរួម អបអរសាទរ ចំពោះ សកម្មភាព ដ៏ វិសេសវិសាល របស់ ក្រុម សម្តេច ឪ ពីសំណាក់ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ លោកគ្រូ អ្នកគ្រូ និង ប្រជារាស្ត្រ ជាច្រើន រូប ។
វត្តមាន សម្តេច ចៅហ្វា វាំង ព្រះរាជ តំណាង ក្នុង ឱកាស ពិនិត្យ ព្រះរាជ សមិទ្ធផល នា ពេលនេះ មាន លក្ខណៈ ដ៏ វិសេសវិសាល ស្រប ទៅតាម ជោគជ័យ នៃ ការងារ អន្តរាគមន៍ របស់ មន្ត្រី បុគ្គលិក ក្រុម សម្តេច ឪ ក្នុង ការកសាង អគារ សិក្សា ជា ព្រះរាជ អំណោយ ដ៏ ថ្លៃថ្លា នេះ ស្ថិត នៅក្នុង សាលា បឋមសិក្សា ឧបសម្ពន្ធ ព្រះខែ ព្រមទាំង ការកសាង សមិទ្ធផល ដទៃ ទៀត ក្នុង នោះ មាន ការកសាង បង្គន់ អនាម័យ ១ខ្នង ស្មើនឹង ៣ បន្ទប់ ឱ្យ មាន កិច្ច ដំណើរការ យ៉ាង ល្អ ប្រសើរ ផងដែរ ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន លើកឡើង ថា សហរដ្ឋ អាមេរិក មិន គួរ មាន ការរង្កៀស ចិត្ត នោះ ឡើយ ពេល ឃើញ កម្ពុជា ស្និទ្ធ ជាមួយ ប្រទេស ចិន ហើយ ងៀក មក ជួយ គាំទ្រ ការអភិវឌ្ឍ កម្ពុជា ដើម្បី មាន ឥទ្ធិពល លើ ទំនាក់ទំនង ជាមួយ កម្ពុជា ។
លោក គិន ភា បាន ថ្លែង បែប នេះ ក្នុង វេទិកា វិទ្យាសាស្ត្រ ស្តីពី « ទំនាក់ទំនង កម្ពុជា - អាមេរិក » ក្នុង រយៈពេល ៧០ ឆ្នាំ នា ព្រឹក ថ្ងៃសៅរ៍ ទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។ លោក បណ្ឌិត គិន ភា បាន លើកឡើង ថា ទំនាក់ទំនង កម្ពុជា និង អាមេរិក ហាក់បីដូចជា មាន ការចង ភ្ជាប់ ជាមួយ ទំនាក់ទំនង ចិន ។ លោក បាន លើកឡើង ថា នៅ ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ១៩៥៨ ពេល កម្ពុជា ចាប់ផ្តើម ទទួលស្គាល់ សាធារណរដ្ឋ ប្រជាមានិត ចិន ពេល នោះ គេ ឃើញ ហេតុការណ៍ កើតឡើង ហាក់ដូចជា រង្កៀស ចិត្ត គ្នា រវាង កម្ពុជា និង អាមេរិក ។
ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ រូប នេះ បន្ថែម ថា ក្រោយ ៗ មក ទៀត ជាពិសេស ដំណាក់កាល នៃ ទំនាក់ទំនង កម្ពុជា ជាមួយ ចិន នា សហសម័យ នេះ គេ មើលឃើញ ទៀត ថា ពេល ដែល កម្ពុជា កាន់តែ មាន ទំនាក់ទំនង ជិតស្និទ្ធ ជាមួយ ចិន កម្ពុជា ហាក់ដូចជា មាន បញ្ហា ខ្លះ មិន យល់ គ្នា ជាមួយ អាមេរិក ។
លោក រំលេច ថា « ជា ជំហរ នយោបាយ ការបរទេស របស់ កម្ពុជា គឺ មិន ដែល ចាត់ទុក ប្រទេស ណាមួយ ជា សត្រូវ ទេ ក៏ប៉ុន្តែ គ្រប់ បរទេស មិន អាច រុញ កម្ពុជា ឲ្យ ទល់ ជញ្ជាំង ដែរ ពីព្រោះថា កម្ពុជា នៅក្នុង រដ្ឋធម្មនុញ្ញ របស់ ខ្លួន ប្រកាន់ យក គោល នយោបាយ អព្យាក្រឹត្យ និង មិន ចូល បក្ស សម្ព័ន្ធ » ។
លោក គិន ភា បាន បញ្ជាក់ ថា កម្ពុជា មាន ភាពចាំបាច់ សម្រាប់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម របស់ ខ្លួន តាមរយៈ កិច្ចសហប្រតិបត្តិការ ជាមួយ បណ្ត ប្រទេស ទាំងអស់ ក្នុង លោក ។ ដូច្នេះ បរទេស ទាំងឡាយ មិន គួរ មាន ការរង្កៀស ចិត្ត ដោយ គ្រាន់តែ កម្ពុជា មាន ទំនាក់ទំនង ល្អ ជា ប្រទេស ណាមួយ នោះ ទេ ។
លោក បណ្ឌិត គិន ភា ប្រាប់ បរទេស ទៀត ថា ប្រសិនបើ ពួកគេ យល់ ថា ភាពចាំបាច់ នៃ ទំនាក់ទំនង កើត ចេញពី ការវិនិយោគ និង ការអភិវឌ្ឍ ពួកគេ គួរតែ សម្លឹង មក កម្ពុជា ថា ជួយ អ្វី បាន ខ្លះ ព្រោះ កម្ពុជា កំពុង ត្រូវការ ការ ជួយ ពី សហគមន៍ អន្តរជាតិ លើ គ្រប់ វិស័យ ៕
( ភ្នំពេញ ) ៖ លោក គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន មើលឃើញ ថា មាន មូលហេតុ ចំនួន ៥ ដែល នាំឱ្យ ទំនាក់ទំនង របស់ កម្ពុជា និង សហរដ្ឋ អាមេរិក មាន ភាពល្អក់កករ និង មិន សូវ ជា ល្អ ប្រសើរ ក្នុង ទំនាក់ទំនង រយៈពេល ៧០ ឆ្នាំ កន្លងមក នេះ ។
ទំនាក់ទំនង កម្ពុជា - អាមេរិក បន្ទាប់ ភ្ជាប់ ជា ផ្លូវការ នៅក្នុង ឆ្នាំ ១៩៥០ ក៏ ត្រូវបាន កាត់ផ្តាច់ ទៅ វិញ នៅ ឆ្នាំ ១៩៦៣ ហើយក៏ បាន ភ្ជាប់ ជាថ្មី នៅ ឆ្នាំ ១៩៦៩ ហើយក៏ ត្រូវ កាត់ផ្តាច់ ជាថ្មី ម្តង ទៀត នៅ ឆ្នាំ ១៩៧៥ ។ រហូតដល់ ឆ្នាំ ១៩៩១ ទើប ទំនាក់ទំនង នេះ ត្រូវបាន តភ្ជាប់ ជាថ្មី រហូតមកដល់ ពេល បច្ចុប្បន្ន ។
រយៈពេល ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង រវាង កម្ពុជា និង អាមេរិក ត្រូវបាន មើលឃើញ ថា មាន ល្វីង ជូរ ចត់ ច្រើន ជាង ភាពល្ហែម និង មាន លិច អណ្តែត មិន ទៀងទាត់ នោះ ឡើយ ។ ក្នុង រយៈពេល ប្រមាណ ៣០ ឆ្នាំ ចុងក្រោយ នេះ បើ ទោះបី ថា កម្ពុជា និង អាមេរិក បើ ទោះបី វាយតម្លៃ ថា ល្អ ប្រសើរ ជាង ៤០ ឆ្នាំ មុន ក្តី តែ ក៏ មាន ពេល ខ្លះ ប៉ះទង្គិច និង សម្តី ធ្ងន់ ស្រាល ដាក់ គ្នា ផងដែរ ។
វេទិកា ពិភាក្សា និង ពិនិត្យ ទៅ លើ លទ្ធផល នៃ ទំនាក់ទំនង រវាង កម្ពុជា - អាមេរិក ក្នុង រយៈពេល ៧០ ឆ្នាំ មក នេះ លោក បណ្ឌិត គិន ភា បាន លើកឡើង ថា ទំនាក់ទំនង មិន ល្អ ប្រសើរ រវាង កម្ពុជា និង អាមេរិក នេះ បណ្តាល មកពី គោល នយោបាយ ខុសគ្នា រវាង ប្រទេស ទាំង ពីរ . ស្រមោល របស់ ចិន . នយោបាយ ផ្ទៃក្នុង . ទស្សនៈ ខុសគ្នា លើ បញ្ហា លទ្ធិ ប្រជាធិបតេយ្យ សេរីភាព បញ្ចេញមតិ និង សិទ្ធិ មនុស្ស ជាដើម និង ឥរិយាបថ របស់ អ្នក ការទូត ។
លោក គិន ភា បាន ពន្យល់ លើ បញ្ហា ទាំងអស់ ៥នេះ យ៉ាង ដូច្នេះ ថា៖
១៖ « គោល នយោបាយ បរទេស ខុសគ្នា » ៖ លោក គិន ភា បាន ពន្យល់ ថា នៅក្នុង អំឡុង សង្គ្រាម ត្រជាក់ សហរដ្ឋ អាមេរិក បាន ដាក់ចេញ គោល នយោបាយ គឺ ទប់ ការរីករាលដាល នៃ លទ្ធិ កុម្មុយនិស្ត នៅក្នុង តំបន់ ។ ដោយឡែក កម្ពុជា ដូច មាន បញ្ជាក់ ក្នុង រដ្ឋធម្មនុញ្ញ គឺ រក្សា គោល នយោបាយ អព្យា ក្រិត្យ អចិន្ត្រៃយ៍ មិន ចូល បក្ស សម្ព័ន្ធ ។ គោល នយោបាយ កម្ពុជា ធ្វើ យ៉ាងណា ដើម្បី រស់ រស់ ដោយ សុខ សន្តិភាព រស់ ដោយ សុខដុម តាម គ្រប់ មធ្យោបាយ ដែល អាច ធ្វើ បាន ។
២៖ « ស្រមោល ចិន » ៖ លោក គិន ភា បាន ពន្យល់ ថា ទំនាក់ទំនង កម្ពុជា និង អាមេរិក ហាក់ ផ្សារភ្ជាប់ រវាង ទំនាក់ទំនង កម្ពុជា ជាមួយ ប្រទេស ចិន ។ ក្នុង នោះ នៅ ឆ្នាំ ១៩៥៨ នៅពេល សម្តេច នរោត្តម សីហនុ ទទួលស្គាល់ របប សាធារណរដ្ឋ ប្រជាមានិត ចិន ក៏ នាំឱ្យ ទំនាក់ទំនង ការទូត កម្ពុជា និង អាមេរិក ប្រែល្អក់កករ រហូតដល់ ការកោះហៅទូត អាមេរិក ទៅ វ៉ាស៊ីនតោន វិញ ។
ជា បន្តបន្ទាប់ ទំនាក់ទំនង រវាង កម្ពុជា និង ចិន គឺ មាន ការរីកចម្រើន ក្លាយទៅជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ។ ភាគី ទាំង ពីរ បាន ចុះ កិច្ចព្រមព្រៀង កសាង សហគមន៍ ដែល មាន ជោគវាសនា រួមគ្នា ជាពិសេស គេ មើល មក កម្ពុជា ថា ជា សម្ព័ន្ធមិត្ត ដ៏ ជិតស្និទ្ធ ជាង គេ នៅ អាស៊ី របស់ ចិន ។
៣៖ « នយោបាយ ផ្ទៃក្នុង » ៖ លោក គិន ភា បាន ពន្យល់ ថា ក្រោម រដ្ឋធម្មនុញ្ញ នៃ អង្គការ សហ ប្រជាជាតិ គោលការណ៍ មិន ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ផង គ្នា ទៅ វិញ ទៅ មក គឺជា គោលការគ្រឹះ ក្នុង ការធានា និរន្តរភាព ស្ថិរភាព នៃ ទំនាក់ទំនង អន្តរ រដ្ឋ ។ ក៏ប៉ុន្តែ ជា រួម អ្នក ធ្វើ គោល នយោបាយ ខ្មែរ ឬ ក៏ អ្នកនយោបាយ ខ្មែរ ជួនកាល អាច មើលឃើញ សហរដ្ឋ អាមេរិក ក្នុង រូបភាព មួយ ជា ការពាក់ព័ន្ធ នយោបាយ ផ្ទៃក្នុង ។
៤៖ « ទស្សនៈ ខុសគ្នា លើ លទ្ធិ ប្រជាធិបតេយ្យ នីតិរដ្ឋ សិទ្ធិ មនុស្ស » ៖ លោក គិន ភា បាន ពន្យល់ ថា ប្រទេស នៅ តំបន់ អាស៊ី និយាយ ជា រួម និង កម្ពុជា និយាយ ដោយឡែក កម្ពុជា មាន បរិបទ ប្រវត្តិសាស្ត្របស់ ខ្លួន ដោយឡែក វប្បធម៌ ដោយឡែក ហើយ ជាពិសេស ផ្នត់គំនិត របស់ មនុស្ស ខ្មែរ ។ ដូច្នេះ ការ ដែល មាន ទស្សនៈ ខុសគ្នា លើ បញ្ហា តែ មួយ ជា ប្រភព នាំឱ្យ មាន ការ មិន យល់ គ្នា ។
៥៖ « ឥរិយាបថ អ្នកការទូត » ៖ លោក គិន ភា បាន ពន្យល់ ថា ឥរិយាបថ របស់ អ្នក ការទូត ក៏ ដើរ តួនាទី សំខាន់ ណាស់ ដែរ ដែល ត្រូវការ អ្នកការទូត ដែល មាន វិជ្ជាជីវៈ ខ្ពស់ ។
លោក គិន ភា ក៏ បាន លើកឡើង នូវ ទស្សនៈ និង ការមើលឃើញ របស់ ខ្លួន ដែរ ថា ដើម្បី ស្រោចស្រង់ ឬ ធ្វើឱ្យ ទំនាក់ទំនង រវាង កម្ពុជា និង អាមេរិក មាន ភាពល្អ ប្រសើរ នោះ កម្ពុជា និង អាមេរិក ត្រូវ ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ ធម្មនុញ្ញ របស់ សហ ប្រជាជាតិ ការ មិន ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង គ្នា ទៅ វិញ ទៅមក ដោយ ការគោរព គ្នា គោរព ផលប្រយោជន៍ ផង គ្នា គោរព អធិបតេយ្យ និង បូរណភាព ទឹកដី គ្នា ទៅ វិញ ទៅមក ។
លោក គិន ភា បាន មើលឃើញ ថា ការបើក បេះដូង ក្នុង ការវិនិយោគ របស់ អាមេរិក មកកាន់ កម្ពុជា ដូច អាមេរិក ធ្វើ ចំពោះ ប្រទេស ដទៃ ក៏ នឹង នាំឱ្យ អាមេរិក មាន ឥទ្ធិពល ខ្លាំង មក លើ កម្ពុជា ផងដែរ ។
លោក គិន ភា បាន បញ្ជាក់ ដូច្នេះ « ជា ការពិត ការអភិវឌ្ឍ របស់ ប្រទេស កម្ពុជា ត្រូវការ ការរួមចំណែក ដោយ មិន អាច ខ្វះ បាន ពីសំណាក់ ប្រទេស ជា មិត្តភក្តិ ទាំងអស់ ។ ខ្ញុំ ជឿជាក់ ថា ការយល់ គ្នា ការមាន អារម្មណ៍ ល្អ នឹង គ្នា គឺ នឹង ធ្វើឱ្យ ទំនាក់ទំនង របស់ យើង មាន ភាពរឹងមាំ រីកចម្រើន និង គ្រប់ ជ្រុងជ្រោយ »៕
អភិបាល ខេត្ត សៀមរាប ដាក់ ចេញ វិធានការសំខាន់ ចំនួន ៣ ក្នុង ការទប់ស្កាត់ ការទន្រ្ទាន ដី រដ្ឋ ការងារ សន្តិសុខ និង បើក ប្រាក់ ឧបត្ថម្ភ ជូន គ្រួសារ ក្រីក្រ
( សៀមរាប ) ៖ លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប នា ថ្ងៃ រសៀល ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ ម្សិលមិញ បាន ដាក់ចេញ នូវ វិធានការ ចំនួន ៣សំខាន់ ៗ ក្នុង ការទប់ស្កាត់ ការទន្រ្ទាន ដី រដ្ឋ ការងារ សន្តិសុខ និង បើក ប្រាក់ ឧបត្ថម្ភ ជូន គ្រួសារ ក្រីក្រ ។
ដែល វិធានការ ទាំង ៣នោះ រួម មាន ទី១៖ វិធានការ ទប់ស្កាត់ ការរុករាន ទន្រ្ទាន ដី រដ្ឋ គ្រប់ ប្រភេទ ដើម្បី វាត យក ដី ធ្វើជា កម្មសិទ្ធិ នៅក្នុង ភូមិសាស្រ្ត ខេត្ត សៀមរាប . ទី ២៖ ការបង្ការ ទប់ស្កាត់ បញ្ហា កូដកម្ម និង បាតុកម្ម នៅ តាម បណ្ដា ក្រុង ស្រុក និង ទី៣៖ ដំណើរការ និង នីតិវិធី នៃ ការបើកប្រាក់ ឧបត្ថម្ភ ជូន គ្រួសារ ក្រីក្រ ។
ក្រោយ ការរាយការណ៍ និង ពិភាក្សា រួច មក លោក អភិបាល ខេត្ត បាន ដាក់ចេញ នូវ វិធានការ នេះ សម្រាប់ មន្ទីរ អង្គភាព ក្រុង ស្រុក ឃុំ សង្កាត់ យក ទៅ អនុវត្ត ដូច ខាងក្រោម៖
លោក អភិបាល ក៏ បាន សង្កត់ធ្ងន់ ថា មេឃុំ ចៅសង្កាត់ ត្រូវ ហាម ដាច់ខាត ចំពោះ ការចុះហត្ថលេខា ទិញ លក់ ដី របស់ រដ្ឋ និង ត្រូវ ពិនិត្យ ផ្តល់ ការបើកប្រាក់ ឧបត្ថម្ភ គ្រួសារ ក្រីក្រ ជូន ប្រពរដ្ឋ ដែល ក្រពិតប្រាកដ ៕
អភិបាល រាជធានី ភ្នំពេញ ណែនាំ ឲ្យ មន្ត្រី ថ្នាក់ មូលដ្ឋាន ពិនិត្យ ពិចារណា ឲ្យបាន ច្បាស់លាស់ មុននឹង ចាត់ទុក ថា ពួក គាត់ ជា ពលរដ្ឋ ក្រីក្រ
( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ណែនាំ ដល់ មន្ត្រី ថ្នាក់ មូលដ្ឋាន ទាំងអស់ ត្រូវតែ ពិនិត្យ ពិចារណា ឲ្យបាន ច្បាស់ មុននឹង ផ្ដល់ អំណោយ ជូន ទៅ ប្រជាពលរដ្ឋ ដែល ក្រីក្រ ដោយសារ ថា ការផ្ដល់ អំណោយ មិន ចំ គោលដៅ មិន ទៅ ដល់ ដៃ ប្រជាពលរដ្ឋ ក្រីក្រ ពិតប្រាកដ វា នឹង ខាតបង់ បង្កើត ឲ្យ មាន ការឈ្នានីស ។
លោក បញ្ជាក់ ថា អ្នក ដែល វិនិច្ឆ័យ ចំពោះ ប្រជាពលរដ្ឋ ក្រីក្រ ឬ មិន ក្រីក្រ វា ជា ការសម្រេច ចចិត្ត របស់ អស់ លោក ជា ប្រធាន ភូមិ លោក ចៅសង្កាត់ និង ក្រុមការងារ នៅ ថ្នាក់ មូលដ្ឋាន នេះ ហើយ ។ ដូច្នេះ ត្រូវ ពិនិត្យមើល បញ្ហា នេះ ឲ្យបាន ច្បាស់លាស់ ចៀសវាង ការដាក់ សាច់ ឈាម សាច់ញាតិ ខ្លួន ឯង ជា ប្រជាជា ពលរដ្ឋ ក្រីក្រ ខណៈ ដែល ពួកគាត់ មាន ជីវភាព សមរម្យ ហើយ នោះ ។
លោក ឃួង ស្រេង ថា វា មិន ចំណេញ ប៉ុន្មាន ទេ បាន លុយ ៥០០ ទៅ ៦០០ ដុល្លារ នា រដូវ កូវីដ - ១៩ នេះ តែ វា បាន បំផ្លាញ កេរ្តិ៍ឈ្មោះ ខ្លួន ឯង និង ថ្នាក់ លើ ថែម ទៀត ហើយ ពិសេស ថែម ទៀត នោះ គឺ បាត់ ទំនុកចិត្ត ពី ថ្នាក់ដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា តែម្តង ។
ការបញ្ជាក់ និង ណែនាំ របស់ លោក ឃួង ស្រេង ខាងលើ នេះ បាន ធ្វើឡើង កាលពី ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ ក្នុង កិច្ចប្រជុំ ក្រុមការងារ ចុះ ជួយ ខណ្ឌ ព្រែក ព្នៅ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ព្រែក ព្នៅ ។
ក្នុង ឱកាស នោះ ដែរ លោក ឃួង ស្រេង ក៏ បាន ជំរុញ ឲ្យ មន្ត្រី របស់ គណបក្ស ប្រជាជន កម្ពុជា បន្ត ការផ្សព្វផ្សាយ ជុំវិញ វិធានការ ទប់ស្កាត់ កូវីដ - ១៩ ទៅ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
លោក សុខ សម្បត្តិ អភិបាល ខណ្ឌ ព្រែក ព្នៅ បាន លើកឡើង ថា ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ ព្រៃ ព្នៅ បាន ធ្វើ សកម្មភាព យ៉ាង ច្រើន នៅក្នុង ខែមីនា ឆ្នាំ ២០២០ កន្លងមក នេះ ដោយ បាន ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ ជាពិសេស សកម្មភាព ក្នុង ការការពារ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ការចុះ ជួយ ដល់ គ្រួសារ ក្រីក្រ គ្រួសារ ងាយ រងគ្រោះ ដែល រង ផល ប៉ះពាល់ ដោយ វិបត្តិ កូវីដ - ១៩ ។
( ត្បូងឃ្មុំ ) ៖ លោក ជា សុផារ៉ា បាន លើកឡើង ថា ក្រុម យុវជន និង យុវជន សមាជិក បក្ស ប្រជាជន ទាំងអស់ ទោះបី ស្រលាញ់ យ៉ាងណា គាំទ្រ គណបក្ស យ៉ាងណា សំខាន់ ត្រូវតែ មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត មាន សិទ្ធិ បោះឆ្នោត ទើប អាច បោះឆ្នោត ឲ្យ គណបក្ស ដែល ជា លក្ខខណ្ឌ ពេញលេញ ជា សមាជិក គណបក្ស ។
ដោយឡែក យុវជន ដែល មិន ទាន់ មាន ឈ្មោះ បោះឆ្នោត ភាគ ច្រើន ដោយសារ ការ ចំណាកស្រុក នោះ លោក ជា សុផារ៉ា បាន ណែនាំឲ្យ ក្រុមការងារ គណបក្ស ខេត្ត គណបក្ស ឃុំ មេភូមិ ត្រូវ ពិនិត្យមើល ជំរុញ បង្ក លក្ខណៈ គ្រប់ បែបយ៉ាង ឲ្យ យុវជន ទាំងអស់ បាន ចុះឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ព្រោះថា នៅពេល ខ្លី ខាងមុខ នេះ ឈានដល់ ពេលវេលា ដ៏ សំខាន់ ពោលគឺ ឆ្នាំ ២០២២ ការបោះឆ្នោត ឃុំ សង្កាត់ និង ២០២៣ ការបោះឆ្នោត ថ្នាក់ ជាតិ ។
លោក ជា សុផារ៉ា បាន បញ្ជាក់ បន្ថែម ថា ជាមួយ ការយកចិត្តទុកដាក់ ទៅ លើ យុវជន ក្តី តែ យើង នៅតែ បន្ត មើល ថែរក្សា យកចិត្តទុកដាក់ គ្រប់ សមាជិក បក្ស ទាំងអស់ មិន ថា ថ្មី ឫ ចាស់ ក្តី ពោលគឺ ( កសាង ថ្មី រក្សា ចាស់ ) ដើម្បី រួមគ្នា ស្រលាញ់ គាំទ្រ ប្តេជ្ញា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន ឈ្នះ ឆ្នោត ដ៍ ច្រើន លើសលប់ នា ពេល ខាងមុខ ។
លោក ជា សុផារ៉ា អនុប្រធាន ទី១ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ បាន ជំរុញ ណែនាំ លើកឡើង បែប នេះ ក្នុង ឱកាស តំណាង សម្តេច មហា ពញា ចក្រី ហេង សំរិន ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ អញ្ជើញ ជា អធិបតី ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ គណបក្ស ប្រចាំ ឆមាស ទី១ និង ទិសដៅ ភារកិច្ច ឆមាស ទី២ ឆ្នាំ ២០២០ របស់ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ត្បូងឃ្មុំ នៅ ស្នាក់ការ គណបក្ស ប្រជាជន ស្រុក ត្បូងឃ្មុំ ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ ។
ជាមួយគ្នា នោះ លោក ជា សុផារ៉ា បាន កោតសរសើរ ចំពោះ លទ្ធផល ការងារ ដែល ថ្នាក់ដឹកនាំ និង សមាជិក បក្ស ទូទាំង ខេត្ត ត្បូងឃ្មុំ សម្រេចបាន ទាំង ការដោះស្រាយ បញ្ហា បំពេញ តម្រូវការ និង ការអភិវឌ្ឍន៍ ក្នុង មូលដ្ឋាន រៀង ៗ ខ្លួន ដែល ជា ការរួមចំណែក យ៉ាង ធំធេង ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ពិសេស ដើម្បី ប្រមូល យក សមាណ ចិត្ត ប្រជាពលរដ្ឋ បោះឆ្នោត ដោយ ក្តីស្រលាញ់ ពេញចិត្ត ពេញ ថ្លើម ជូន គណបក្ស ប្រជាជន ។
បន្ទាប់ពី កិច្ចប្រជុំ នោះ លោក ជា សុផារ៉ា បាន ដឹកនាំ សមាជិក គណបក្ស ចុះ ធ្វើ ការដាំ កូន ឈើ ប្រណិត ចំនួន ១៧០០ ដើម នៅលើ ទី ទួល សុវត្ថិភាព ទំហំ ១៤ហិចតា ក្នុង ឃុំ ជីរោទ៍ ស្រុក ត្បូងឃ្មុំ ទុក ជា ប្រយោជន៍ សម្រាប់ ពលរដ្ឋ ដែល មក ស្នាក់ នៅ បណ្តោះអាសន្ន នៅ ទីនេះ ក្នុង គ្រា ដែល ទឹក ជំនន់ ជន់ លិច ភូមិដ្ឋាន ៕
( កំពង់ឆ្នាំង ) ៖ លោក ស៉ឹម ធី អគ្គ នាយក រង ប្រៃសណីយ៍ កម្ពុជា និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក កំពង់លែង តំណាង លោក អោក បូរ៉ា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួល បន្ទុក អគ្គ នាយក ប្រៃសណីយ៍ កម្ពុជា នៅ ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ ក្រុមការងារ នាំ ទេយ្យ វត្ថុ និង ទៀន ចំណាំ ព្រះវស្សា ប្រគេន ព្រះសង្ឃ ចំនួន ៤វត្ត ។
នា ឱកាស នោះ លោក ស៊ឹម ធី បាន ថ្លែង ថា ក្រោម ពន្លឺ សន្តិភាព ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន នាំមក នូវ ពន្លឺ សន្តិភាព និង ការអភិវឌ្ឍន៍ ការគោរព ច្បាប់ ចរាចរណ៍ ដើម្បី ធានា នូវ សុខ សុវត្ថិភាព ចរាចរណ៍ តាម ដងផ្លូវ ទើប ស្ថាបនា ហើយ ។ លោក ក៏ បាន ក្រើនរំឭក ដល់ ប្រជាពលរដ្ឋ ចូលរួម ការពារ ការបង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ ជាពិសេស ត្រូវ រក្សា អនាម័យ ឱ្យ បាន ជាប់ ជាប្រចាំ ។
សូម បញ្ជាក់ ផងដែរ ថា ទំនៀមបូជា ទៀន វស្សា គឺជា ផ្នែក មួយ នៃ ការគោរព របស់ ពុទ្ធ បរិស័ទ រំលឹក នឹក ទៅដល់ គុណូបការៈ នៃ ព្រះសម្មាសម្ពុទ្ធ សមណ គោតម ដោយ ធ្វើ ការបូជា គ្រឿង សក្ការៈ ផ្គត់ផ្គង់ ចង្ហាន់ បិណ្ឌ បាត និង គ្រឿង បរិក្ខារ ផ្សេង ៗ ដល់ ព្រះសង្ឃ គង់ ចាំ វស្សា ។ ជាពិសេស នេះ ជា ទំនៀម មួយ ដែល បង្ហាញ ពី ការរួម សាមគ្គី គ្នា របស់ ពុទ្ធ បរិស័ទ ខ្មែរ ក្នុង ការហែ ទេយ្យ ទាន ទៅ ប្រគេន ព្រះសង្ឃ នៅ តាម ទី អារាម នានា និង រួបរួម គ្នា បរិច្ចាគ ធនធាន ទៅ តាម សទ្ធា ជ្រះថ្លា ក្នុង ជំនឿ ចាប់ យក នូវ មគ្គផល កុសល ផល បុណ្យ ៕
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ លោក សុខ ពេញវុធ អភិបាល ខណ្ឌ ដូនពេញ និង ភរិយា និង លោក នួន សំណាវុធ អភិបាល រដ្ឋ ករ ស័្វយត គ្រប់គ្រង សំរាម និង កាកសំណល់ រឹង រាជធានី ភំ្ន ពេញ បាន ដឹកនាំ មន្ត្រី ក្រោម ឱវាទ ចូលរួម យុទ្ធនាការ បោសសម្អាត និង ធ្វើ អនាម័យ តាម ច្រាំង ទន្លេ ក្រោម ស្ពាន ជ្រោយ ចង្វារ និង តាម សួនច្បារ សាធារណៈ ។
យុទ្ធនាកា នេះ មាន ការអញ្ជើញ ចូលរួម ពី គណៈ អភិបាល ខណ្ឌ ដូនពេញ គណៈ នាយក រដ្ឋបាល មន្ត្រី ការិយាល័យ ជំនាញ ពាក់ព័ន្ធ ជុំវិញ ខណ្ឌ លោក - លោកស្រី ចៅសង្កាត់ និង ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ ទាំង ១១ ទី រួម ផ្សារ ទាំង៣ កម្លាំង ប្រជាការពារ ខណ្ឌ ភ្នាក់ងារ អនាម័យ សង្កាត់ ទាំង ១១ និង បងប្អូន កម្មករ ក្រុមហ៊ុន ស៊ីន ទ្រី ដោយ បែងចែក ជា ៣ក្រុម រួម មាន៖
* ក្រុម ទី១ ដឹកនាំ ដោយ លោក សុខ ពេញវុធ ធ្វើ ការចុះ ប្រមូល សំរាម តាម ច្រាំង ទន្លេ ក្រោម ស្ពាន ជ្រោយ ចង្វារ * ក្រុម ទី២ ដឹកនាំ ដោយ លោក យ ស យុទ្ធី អភិបាល រង ខណ្ឌ ធ្វើ ការចុះ សំអាត សំរាម តាម សួនច្បារ រង្វង់ មូល គួច កាណុង * ក្រុម ទី៣ ដឹកនាំ ដោយ លោកស្រី នូ ថា វរី អភិបាល រង ខណ្ឌ ធ្វើ ការចុះ ប្រមូល សំរាម តាម សួនច្បារ ចាប់ពី ផ្សារ រាត្រី រហូតដល់ មុខ ព្រះបរម រាជ វាំង ។
លោក អភិបាល ខណ្ឌ បាន ចាត់ ឲ្យ រដ្ឋបាល សង្កាត់ ស្រះចក ចុះ អប់រំ ណែនាំ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ ក្បែរ ស្ពាន ជ្រោយ ចង្វារ ឲ្យ រក្សាទុកដាក់ សំរាម ឲ្យបាន ត្រឹមត្រូវ និង មិន អនុញ្ញាតឲ្យ យក សំរាម យកមក ចោល តាម ច្រាំង ទន្លេ បន្ត ទៀត នោះ ទេ ។
គោលបំណង នៃ កាបោសសម្អាត និង ធ្វើ អនាម័យ តាម ដងទន្លេ ក្រោម ស្ពាន ជ្រោយ ចង្វារ នេះ គឺ ចង់ បង្ហាញ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ចេះ ស្រលាញ់ បរិស្ថាន និង ទុកដាក់ សម្រាម ឲ្យបាន ត្រឹមត្រូវ នៅ តាម ទី សាធារណៈ ផ្សេង ៗ ដ៏ ដូចជា តាម ច្រាំង ទន្លេ ដើម្បី ចូលរួម លើកកម្ពស់ សោភ័ណភាព អនាម័យ បរិស្ថាន តាម ច្រាំង ទន្លេ និង សួនច្បារ សាធារណៈ ឲ្យ កាន់តែ ល្អ ប្រសើរ ៕ សាខា កាកបាទ ក្រហម ខេត្ត ក្រចេះ ផ្តល់ អំណោយ មនុស្សធម៌ ដល់ អ្នក ខ្សត់ខ្សោយ ចំនួន ៨ឃុំ ក្នុង ស្រុក សំបូរ
( ក្រចេះ ) ៖ លោក ហ៊ឹង ណារី វ៉ាថន ភរិយា អភិបាល ខេត្ត ក្រចេះ និង ជា អនុប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ក្រចេះ នៅ ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ សមាជិក គណៈកម្មាធិការ សាខា និង សហការី បាន នាំយក អំណោយ មនុស្សធម៌ កាកបាទ ក្រហម កម្ពុជា តាមរយៈ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ជូន ដល់ គ្រួសារ ងាយ រងគ្រោះ ចាស់ ជា រា ជន ពិការ អ្នក រស់ នៅ ជាមួយ មេរោគ អេដស៍ ស្ត្រី មេម៉ាយ និង គ្រួសារ មាន ជីវភាព ខ្វះខាត សរុប ចំនួន ៦១ គ្រួសារ មកពី ឃុំ ចំនួន ៨ នៃ ស្រុក សំបូរ ។
លោកស្រី ហ៊ឹង ណារី បាន ផ្តាំផ្ញើ របស់ ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល ជានិច្ចកាល សម្តេច តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខុមាលភាព ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ គ្រប់ រូប ដោយ មិន ប្រកាន់ វណ្ណៈ ពណ៌ សម្បុល ជំនឿ សាសនា ឫ និន្នាការ នយោបាយ ណាមួយ ឡើយ ។ ហើយ កាកបាទ ក្រហម កម្ពុជា មាន គ្រប់ ទីកន្លែង សម្រាប់ គ្រប់ ៗ គ្នា មិន ទុកន ណា ម្នាក់ ចោល គឺ ទីណា មាន ទុក្ខលំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា ។
លោកស្រី បាន គូសបញ្ជាក់ ថា ការរាតត្បាត ជា សកល នៃ ជំងឺ កូវីដ១៩ នៅតែ ជា ក្តី ព្រួយបារម្ភ របស់ ពិភពលោក ទាំងមូល ប៉ុន្តែ ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល បាន សម្រេច នូវ ជោគជ័យ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ នេះ ដោយ មិន ឲ្យ មាន អ្នកស្លាប់ និង គ្រប់គ្រង មិន ឲ្យ មាន ការឆ្លង ក្នុង សហគមន៍ តាមរយៈ ការដាក់ចេញ នូវ វិធានការ ច្បាស់លាស់ និង ទប់ស្កាត់ បាន ទាន់ ពេល វេលា ។
លោកស្រី ក៏ បាន ផ្តាំផ្ញើ បន្ថែម ដល់ ប្រជាពលរដ្ឋ ឲ្យ យកចិត្តទុកដាក់ គិតគូរ ពី បញ្ហា សុខភាព ជា ចម្បង ត្រូវ មាន អនាម័យ ស្អាត ជានិច្ច ជាពិសេស បន្ត ចូលរួម អនុវត្ត តាម ការអំពាវនាវ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ រលក ទី២ នៃ ការចម្លង វីរុស កូវីដ - ១៩ នៅ កម្ពុជា ។ លោកស្រី ក៏ ជំរុញ ប្រជាពលរដ្ឋ ទាំងអស់ បន្ត ខិតខំ ប្រឹងប្រែង ប្រកបរបរ បង្កបង្កើន ផល ដើម្បី ជីវភាព គ្រួសារ និង ណែនាំ កូន ចៅ ឲ្យ ចេះ គោរព ច្បាប់ ចរាចរណ៍ និង ជៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន ៕
ពលរដ្ឋ ធ្លាប់ រស់ នៅក្នុង ព្រៃ នៃ ខេត្ត កោះកុង ប្រែ មុខមាត់ ដោយ ផ្លាស់ប្តូរ មក ទីតាំង ថ្មី ក្រោម ការគាំទ្រ ពី អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ និង មន្រ្តី ពាក់ព័ន្ធ
លោក នេត្រ ភក្ត្រា បាន បន្ត ថា ក្នុង ការមក រស់ នៅ តំបន់ ថ្មី នេះ គឺ បាន ធ្វើ ការរៀបចំ គម្រោង បែប ថ្មី ដោយ ធ្វើ ការចែក ដី ម្នាក់ មួយ គ្រួសារ ដែល មាន ក្បាល ដី ទំហំ ដី ២៥ម៉ែត្រ និង បណ្តោយ ៦០០ ម៉ែត្រ ក្នុង នេះ គេ ធ្វើការបែងចែក ដី ភូមិ ដី ចំការ សម្រាប់ ដាំ ដំណាំ ហូប ផ្លែ ផ្សេង ៗ ដែល អាច ផ្គត់ផ្គង់ គ្រួសារ និង ផ្គត់ផ្គង់ ទីផ្សារ ក្នុង តំបន់ និង ខេត្ត ដទៃ ទៀត ជាដើម ។
តាមរយៈ ការផ្លាស់ប្តូរ ទីតាំង រស់ នៅ នេះ ត្រូវបាន លោក នេត្រ ភក្ត្រា បញ្ជាក់ ថា ជា ការផ្លាស់ប្តូរ ដល់ មុខរបរ របស់ ពួកគាត់ បែប ថ្មី ដោយ បញ្ឈប់ ការធ្លាប់ តែ កាប់ ព្រៃឈើ បរបាញ់ សត្វ ជំនួស មកវិញ ការដាំ ដំណាំ កសិកម្ម បែប ថ្មី ទំនើប ដែល អាច ទ្រទ្រង់ ជីវភាពល្អ ប្រសើរ ជាង មុន ។ គម្រោង បាន ផ្ដោត ជា សំខាន់ ទៅការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ចំនួន ២២០ គ្រួសារ ដែល ពីមុន មក ធ្លាប់ បាន បំផ្លិចបំផ្លាញ ព្រៃឈើ ដោយ ការកាប់ ព្រៃ ធ្វើ ចំការពនេចរ និង បរបាញ់ សត្វ ព្រៃ ។
ទាក់ទិន ទៅនឹង ការមក រស់ នៅ តំបន់ កន្លែង ថ្មី របស់ ប្រជាពលរដ្ឋ នេះ ដែរ អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន រូប នេះ បាន ឱ្យដឹង ថា បាន ធ្វើឱ្យ តំបន់ កន្លែង ចាស់ គាត់ ធ្លាប់ រស់ នៅ ប្រែក្លាយជា កន្លែង សត្វ រស់ នៅ តំបន់ អភិរក្ស ធនធាន ធម្មជាតិ ដែល ធ្វើឱ្យ ក្លាយជា តំបន់ អេកូរ ទេសចរណ៍ ទាក់ទាញ ឱ្យ ភ្ញៀវ ទេសចរ ចូលទៅ កម្សាន្តត រៀងរាល់ ថ្ងៃ រហូតមកដល់ ពេល បច្ចុប្បន្ន ។
ដោយ មាន ជំនួយ បច្ចេកទេស ពី អង្គការ សម្ព័ន្ធមិត្ដ សត្វ ព្រៃ ប្រជាពលរដ្ឋ ក្នុង ភូមិ នេះ បាន ទទួល ចំណេះ ផ្នែក គ្រប់គ្រង ប្រាក់កាក់ ជំនាញ កសិកម្ម បែប ទំនើប ក៏ ដូចជា បាន បង្កើត និង គ្រប់គ្រង សមាម គមន៍ កសិកម្ម សហគមន៍ និង ឃ្លាំង លក់ សម្ភារ កសិកម្ម ដែល គ្រប់គ្រង មើល ពីលើ ផលិតកម្ម កសិកម្ម ផ្សព្វផ្សាយ លក់ ផលិតផល នៅ ទីផ្សារ ការថែទាំ សុខភាព ការអប់រំ ការអភិរក្ស ធនធាន ធម្មជាតិ និង ប្រព័ន្ធ ឥណទាន ខ្នាត តូច ។
លោក បាន បន្ត ថា ពួកគាត់ មក រស់ នៅ កន្លែង ថ្មី នេះ មាន ហេដ្ឋារចនា សម្ព័ន្ធ គ្រប់គ្រាន់ ក្នុង នេះ ដូចជា មាន សាលារៀន មន្ទីរពេទ្យ និង ទីផ្សារ នៅក្បែរ ខ្លួន ។ ក្រៅពី នេះ កូន ៗ របស់ ពួកគាត់ ខ្លះ អាច រៀន ដល់ សាកលវិទ្យាល័យ និង អាច មាន ការងារ ធ្វើ មិន ចាញ់ កូន ៗ អ្នក រស់ នៅ ទីប្រជុំជន ឡើយ ។
លោកយាយ បាន ឱ្យដឹង ថា ក្រោយមក រស់ នៅក្នុង ភូមិ សុវណ្ណា បៃតង នេះ ក្រុមគ្រួសារ គាត់ ទទួលបាន ដី ដែល ជា កម្មសិទ្ធិ ស្រប ច្បាប់ ព្រមទាំង ធ្វើឱ្យ ជីវភាព របស់ ពួកគាត់ មាន ការកែប្រែ ជាថ្មី រស់ នៅ ដោយ ភាពកក់ក្តៅ ។
លោក គង់ ប៊ុន ឈាន ដែល មាន វ័យ ៦២ ឆ្នាំ ជា អ្នក ចំណាកស្រុក ដែល ធ្លាប់ រស់ នៅ តំបន់ ធនធាន ធម្មជាតិ មួយ រូប បាន លើកឡើង ថា ក្រុមគ្រួសារ គាត់ ពិតជា ទទួលបាន មុខរបរ ថ្មី ដែល កាលពី មុន ធ្លាប់ តែ កាប់ ឈើ បរបាញ់ សត្វ ជំនួស ម មក ធ្វើដំណាំ កសិកម្ម វិញ ពេលនេះ គាត់ មិន ចាំបាច់ ប្រថុយប្រថាន ចូល ព្រៃ កាប់ ឈើ ចាប់ សត្វ ព្រៃ ដែល ជា ប្រការ មួយ ប្រឈម ជាមួយ ផ្លូវ ច្បាប់ ទៀត ឡើយ ។
លោក បាន បញ្ជាក់ ថា « ពេលនេះ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ និង មន្រ្តី ពាក់ព័ន្ធ បាន ណែនាំ ឱ្យ ស្ម័គ្រចិត្ត មក រស់ នៅ តំបន់ អភិវឌ្ឍន៍ ភូមិ សុវណ្ណា បៃតង នេះ ឃើញ ថា ល្អ ប្រសើរ ណាស់ ។ គ្រួសារ ខ្ញុំ ដាំ ដំណាំ កសិកម្ម គ្រប់ មុខ ធ្វើឱ្យ អាច រក ចំណូល បាន យ៉ាង ធូរ និង កូន ចៅ អាច ចូលរៀន គ្រប់ គ្នា ផង » ។
គួរ បញ្ជាក់ ថា បើ តាម លោក អេដាដ លេហ្ទឺរ មន្ត្រី គ្រប់គ្រង ផ្នែក ច្បាប់ នៃ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន បង្ហាញ ជំហរ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ពិសេស ក្រសួង បរិស្ថាន ក្នុង កិច្ច គាំពារ ធនធាន ធម្មជាតិ ក្នុង ប្រទេស កម្ពុជា កុំ ឱ្យ មាន ការបាត់បង់ បន្ត ទៀត ។
( ស្ទឹងត្រែង ) ៖ ជនសង្ស័យ ម្នាក់ បាន ប៉ុនប៉ង ចាប់រំលោភ កូន បង្កើត ខ្លួន ឯង ត្រូវបាន កម្លាំង ប៉ុស្តិ៍ រដ្ឋបាល សង្កាត់ សាមគ្គី ចាប់ខ្លួន និង បញ្ជូន មក អធិការដ្ឋាន ក្រុង ស្ទឹងត្រែង ។
ជនសង្ស័យ ជា ឪពុក ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន កាលពី ព្រឹក ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ នៅ ចំណុច ភូមិ ថ្មី សង្កាត់ សាមគ្គី ក្រុង ស្ទឹងត្រែង ។
ម៉ាស់ គឺជា រង្វាស់ បរិមាណ នៃ រូប ធាតុ ដែល វត្ថុ មួយ ផ្ទុក ហើយ មាន លក្ខណៈ ថេរ ។ រីឯ ទម្ងន់ គឺជា កម្លាំង ទំនាញ នៅលើ វត្ថុ មួយ ។ ទម្ងន់ របស់ វត្ថុ គឺ អាស្រ័យ លើ ម៉ាស់ និង សន្ទុះ នៃ ទំនាញ ។
គួរ កត់សម្គាល់ ដែរ ថា អ្នកវិទ្យាសាស្ត្រ បាន គណនា រក ទម្ងន់ ផែនដី ដោយ ប្រើ ច្បាប់ ស្តីពី កម្លាំង ទំនាញ ។ ត្រូវ ចងចាំ មួយ ទៀត ថា ម៉ាស់ និង ទម្ងន់ មាន ភាពខុសគ្នា ហើយ វា មាន សារៈសំខាន់ ណាស់ នៅ ពេល ដែល យើង ចង់ និយាយ អំពី ការវាស់វែង នៅក្នុង លំហរ ៕ មេបញ្ជាការ អាវុធហត្ថ ខេត្ត កណ្ដាល កោតសរសើរ និង ដឹងគុណ ជានិច្ច ចំពោះ នាយ នាយ រង អាវុធហត្ថ និវត្តន៍ ជន ទាំងអស់ ដែល បាន ខិតខំ បម្រើ ប្រជាជន និង ជាតិ មាតុភូមិ
( កណ្ដាល ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី សំ តុលា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កណ្ដាល បាន កោតសរសើរ ដឹង គុណ ជានិច្ច ចំពោះ នាយ នាយ រង អាវុធហត្ថ និវត្តន៍ ជន ទាំងអស់ ដែល កន្លងមក បាន ខិតខំ ប្រឹងប្រែង យក អស់ ស្មារតី ក្នុង ការបំពេញ ការងារ បម្រើ ប្រជាជន និង ជាតិ មាតុភូមិ ។
លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ បាន ថ្លែង យ៉ាង ដូច្នេះ ក្នុង ពិធី សំណេះសំណាល សួរសុខទុក្ខ ដល់ នាយ នាយ រង អាវុហត្ថ ចូលនិវត្ត ដើម្បី អបអរសាទរ ខួប លើក ទី ២៧ ទិវា កងរាជអាវុធហត្ថ ( ១៤ កក្កដា ១៩៩៣ - ១៤ កក្កដា ២០២០ ) នៅ បញ្ជការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល នា ថ្ងៃទី ១០ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ បាន លើកឡើង ថា អនុវត្ត តាម អនុសាសន៍ ដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស . នាយ ឧត្តមសេនីយ៍ គន់ គីម ទេសរដ្ឋមន្រ្តី និង ជា អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន ដែល ជានិច្ចកាល នាយ ឧត្តមសេនីយ៍ តែងតែ យកចិត្តទុកដាក់ គិតគូរ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ កងកម្លាំង គ្រប់ រូប ផងដែរ ។
លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ បាន ពាំនាំ មក នូវ ការសាកសួរ សុខទុក្ខ និង ការជូនពរ ជ័យ ពីសំណាក់ នាយ ឧត្ត សេនីយ៍ សៅ សុខា ជូន ចំពោះ នាយ នាយ រង អាវុធហត្ថ និវត្តន៍ ជន និង ក្រុមគ្រួសារ ទាំងអស់ សូមឲ្យ ឲ្យ ជួប តែ សេចក្តីសុខ ចំរើន ចៀស ផុត ជំងឺ ដង្កាត់ ទាំងឡាយ ។
ទី បញ្ចប់ លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ បាន ជូន ពរ ដល់ នាយ នាយ រង អាវុធហត្ថ និង និវត្តន៍ ជន ទាំងអស់ សូម អោយ មាន សុខភាព ល្អ កម្លាំង ខ្លាំងក្លា ប្រាជ្ញា វៀង វៃ សូមឲ្យ អ្នក ដែល មាន ជំងឺ ឆាប់ ជាសះស្បើយ និង សូមឲ្យ ជួប តែ ពុទ្ធ ពរ ទាំង បួន ប្រការ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។ ថវិកា ដែល ប្រគល់ ជូន ដល់ នាយ នាយ រង អាវុធហត្ថ និង និវត្តន៍ ជន ទាំងអស់ សរុប ជាង ១០លាន រៀល និង សម្ភារ មួយចំនួន ទៀត រួម មាន៖ អង្ករ ទឹក សុទ្ធ មី ទឹក ស៊ីវ អ៊ីវ ទឹកត្រី ក្រម៉ា និង ទឹក ផ្លែឈើ ៕
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត សភាចារ្យ ហ៉ីង ថូរ៉ាក់ស៊ី រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី បាន លើកឡើង ថា កម្ពុជា បាន តាំងចិត្ត របស់ ខ្លួន ប្រកៀក ស្មា នឹង សហរដ្ឋ អាមេរិក ដោយ ផ្ដោត លើ គោលការណ៍ គោរព និង យោគយល់ គ្នា ទៅ វិញ ទៅ មក ហើយ កម្ពុជា ឈរ ជើង ត្រៀមលក្ខណៈ រួច ជាស្រេច ក្នុង ការធ្វើឱ្យ រស់រវើក ឡើងវិញ ។
ការលើកឡើង បែប នេះ របស់ លោក បណ្ឌិត សភាចារ្យ ហ៉ីង ថូរ៉ាក់ស៊ី បាន ធ្វើឡើង ក្នុង ពិធី បើក វេទិកា វិទ្យាសាស្ត្រ ស្តីពី « ទំនាក់ទំនង កម្ពុជា - សហរដ្ឋ អាមេរិក៖ ការពិនិត្យមើល អតីតកាល រយៈពេល ៧០ ឆ្នាំ កន្លងមក ក្ដីរំពឹងទុក សម្រាប់ ៧០ ឆ្នាំ បន្ទាប់ និង លើស ពី នេះ » ដែល រៀបចំឡើង ដោយ រាជ បណ្ឌិត្យ សភា កម្ពុជា សហការ ជាមួយ ស្ថានទូត អាមេរិក នៅ អគារ រាជ បណ្ឌិត្យ សភា នា ព្រឹក ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ ។
លោក គូសបញ្ជាក់ ថា៖ « ជាង នេះ ទៅ ទៀត . កម្ពុជា បាន តាំងចិត្ត របស់ ខ្លួន ក្នុង ការធ្វើ ការប្រកៀក ស្មា នឹង សហរដ្ឋ អាមេរិក ផ្ដោត លើ គោលការណ៍ គោរព និង យោគយល់ គ្នា ទៅ វិញ ទៅ មក ហើយ យើង ឈរជើង ត្រៀមលក្ខណៈ រួច ជាស្រេច ក្នុង ការធ្វើឱ្យ រស់រវើក ឡើងវិញ » ។
រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី រូប នេះ បាន ឱ្យដឹង ថា ទំនាក់ទំនង នេះ គឺ មាន ភាព ស្រដៀង គ្នា ទៅនឹង ទំនាក់ទំនង ប្រភេទ ផ្សេង ដែរ ដែល សូម គូសបញ្ជាក់ មិន ថា តែ រវាង មិត្តភ័ក្ដិ រវាង ក្រុមគ្រួសារ សាច់ញាតិ និង រវាង គូស្នេហ៍ នោះ ទេ វា តែងតែ មាន លាយឡំ គ្នា នូវ ការឡើង និង ការធ្លាក់ចុះ ។ វា មិន អាច ចៀស បាន នោះ ទេ ។
ទោះ វិបត្តិ រាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ តែ តំបន់ អេកូ ទេសចរណ៍ ជី ផាត នៅតែ ជា មុខ ព្រួញ សម្រាប់ ភ្ញៀវ ទេសចរ ក្នុង ស្រុក
( កោះកុង ) ៖ លោក ទូច សុផាន់ នី ប្រធាន គម្រោង សហគមន៍ អេកូ ទេសចរណ៍ នៃ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន បញ្ជាក់ ថា បន្ទាប់ពី បង្កើត ជា សហគមន៍ អេកូ ទេសចរណ៍ ជី ផាត ចាប់តាំងពី ឆ្នាំ ២០០៧ មក បាន ប្រែ មុខមាត់ តំបន់ ដាច់ស្រយាល នេះ យ៉ាង ខ្លាំង គឺ បាន កាត់បន្ថយ ការធ្វើ ចំណាកស្រុក របស់ ប្រជាពលរដ្ឋ ស្ទើរតែ ១០០ ភាគរយ ក៏ប៉ុន្តែ ក្នុង ដំណាក់កាល រាតត្បាត ជំងឺ កូវីដ - ១៩ តំបន់ អេកូ ទេសចរណ៍ ជី ផាត នៅតែ ជា មុខ ព្រួញ សម្រាប់ ភ្ញៀវ ទេសចរ ជាតិ បើ ទោះបី ភ្ញៀវ បរទេស ធ្លាក់ចុះ បន្តិច ក៏ដោយ ។
រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន រូប នេះ បាន បញ្ជាក់ ថា គោលបំណង របស់ រាជ រដ្ឋ ភិបាល កម្ពុជា គឺ ធ្វើ យ៉ាងណា ប្រែក្លាយ តំបន់ ការពារ ធនធាន ធម្មជាតិ ដែល មាន សក្តានុពល ទេសចរណ៍ ឱ្យ ក្លាយជា កន្លែង ទេសចរណ៍ ធម្មជាតិ ។
លោក នេត្រ ភក្ត្រា ក៏ បាន ពន្យល់ ជុំវិញ បញ្ហា នេះ យ៉ាង ដូច្នេះ ថា៖ « ការការពារ បាន នូវ តំបន់ ធនធាន ធម្មជាតិ គឺ មាន ន័យ ថា យើង មាន សុវត្ថិភាព មួយ ក្នុង ការបង្កើត ប្រភព ចំណូល ជូន ប្រជាពលរដ្ឋ ។ អីចឹង ហើយ ការកែប្រែ ពី តំបន់ ការពារ ធម្មជាតិ ដែល មាន សក្តានុពល ទៅជា កន្លែង ទេសចរណ៍ ទី១៖ គឺ ការបង្កើន ចំណូល និង ទី២៖ គឺ ការចូលរួម អភិរក្ស ហើយ ចំណុច នេះ ការគិត អំពី និរន្តភាព នៃ ការការពារ បរិស្ថាន និង ធនធាន ធម្មជាតិ របស់ យើង » ។
ជាមួយគ្នា នេះ លោក បាន ឱ្យដឹង ថា ការចូលរួម របស់ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ គឺជា ការរួម វិភាគទាន មួយ ដ៏ មាន តម្លៃ ជាមួយនឹង រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការទប់ស្កាត់ បទល្មើស ធនធាន ធម្មជាតិ ការថែរក្សា ការពារ ការអភិរក្ស ធនធាន ធម្មជាតិ និង ជីវៈ ចម្រុះ នៅ កម្ពុជា ។
ទន្ទឹមនឹង នេះ ដដែរ លោក ក៏ បាន បង្ហាញ ការកោតសរសើរ ចំពោះ កិច្ចសហប្រតិបត្តិការ និង ការអនុវត្ត ច្បាប់ កន្លងមក របស់ អាជ្ញាធរដែនដី និង ភាគី ដែល ពាក់ព័ន្ធ នៅក្នុង តំបន់ ការ ធម្មជាតិ របស់ កម្ពុជា ជាពិសេស ក្នុង ខេត្ត កោះកុង ពោធិ៍សាត់ និង កំពង់ស្ពឺ ដោយ ក្នុង នោះ ក្រុមការងារ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ បាន ផ្តោត លើក ការពារ ពារ សក្តានុពល បរិស្ថាន និង ធនធាន ធម្មជាតិ ក្នុង តំបន់ ឧទ្យាន ជាតិ ក្រវាញ ខាងត្បូង តា តៃ និង ក្រវាញ កណ្តាល ។
លោក បាន ចាត់ទុក ថា កិច្ចសហការ ល្អ និង ការអនុវត្ត ច្បាប់ ប្រកបដោយ ប្រសិទ្ធភាព ក្នុង តំបន់ ការពារ ធម្មជាតិ ពិតជា មាន សារៈសំខាន់ ណាស់ ក្នុង កិច្ច គាំពារ បរិស្ថាន ការការពារ ធនធាន ធម្មជាតិ ការអភិវឌ្ឍន៍ ជីវៈ ចម្រុះ សំដៅ ការរស់នៅ ដោយ ចីរភាព ។ ជាមួយគ្នា ក្រសួង បរិស្ថាន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ ដែល កន្លងមក បាន សម្របសម្រួល និង សហប្រតិបត្តិការ យ៉ាង ល្អ ជាមួយ ក្រសួង បរិស្ថាន ។
លោក រដ្ឋលេខាធិការ បាន លើកឡើង ថា « បច្ចុប្បន្ន នេះ យើង មាន តំបន់ ការពារ ធម្មជាតិ ចំនួន ៦៩កន្លែង លើ ទំហំ ផ្ទៃដី ចំនួន ៧.៣លាន ហិកតា ដែល ទំហំ ដ៏ ធំ នេះ ជា កាតព្វកិច្ច ដែល ក្រសួង បរិស្ថាន ត្រូវការ កិច្ចសហការ យ៉ាង ល្អ ពី គ្រប់ ភាគី ដែល ពាក់ព័ន្ធ នានា ក្នុង ការធានា បាន នូវ និរន្តភាព ការពារ ក្តានុពល បរិស្ថាន និង អភិរក្ស ធនធាន ធម្មជាតិ របស់ យើង សម្រាប់ តំកល់ ជូន ឧត្តម ប្រយោជន៍ ដល់ ជំនាន់ ក្រោយ » ។
ដោយឡែក លោក ម៉ៅ ស្រស់ ជា ប្រជា សហគមន៍ បាន លើកឡើង ថា កាលពី មុន ប្រជាពលរដ្ឋ រស់ នៅ ទីនេះ បាន ពឹង អាស្រ័យ សំខាន់ ក្នុង ការប្រកបរបរ ចិញ្ចឹម ជីវិត គឺ អនុផល ព្រៃឈើ ប៉ុន្តែ បច្ចុប្បន្ន នេះ ពួកគាត់ បាន ផ្លាស់ប្តូរ ច្រើន បន្ទាប់ពី ចូល ជា សហគមន៍ ក្នុង នេះ ពួកគាត់ កែប្រែ ពី ការកាប់ ព្រៃឈើ មក បង្កើត មុខរបរ លើ វិស័យ ទេសចរណ៍ វិញ ដូច ជា៖ សេវ៉ា ទូក សេវ៉ា ម៉ូតូ ឌុប សេវ៉ា លក់ ម្ហូប អាហារ លក់ របស់របរ ធ្វើ ផ្ទះសំណាក់ ដល់ ភ្ញៀវ ទេសចរ ជាដើម ។
អ្នកស្រី ឡុង ចាន់ ជា ប្រជា សហគមន៍ មួយ រូប ទៀត បាន បង្ហាញ មោទកភាព ពី តំបន់ នេះ បច្ចុប្បន្ន ដែល ជា តំបន់ ទេសចរណ៍ មួយ ។ ទីនេះ មិន ត្រឹមតែ ជួយ រក ចំណូល ដល់ ជីវភាព អ្នកស្រី តាមរយៈ ភ្ញៀវ ទេសចរ ទេ ប៉ុន្តែ ក៏ ជា ទឹកដី ស្រស់ស្អាត បែប ធម្មជាតិ គួរ ជា ទី រស់ នៅ ថែម ទៀត ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ សភា អឺរ៉ុប (EP) បាន ឱ្យដឹង ថា ច្បាប់ ថ្មី នេះ នឹង លើកលែង ជា បណ្តោះអាសន្ន លើ វិធីសាស្ត្រ មួយចំនួន លើ ការសាកល្បង វ៉ាក់សាំង ដោយ ទទួលបាន សំឡេង គាំទ្រ ៥០៥ សំឡេង . ប្រឆាំង ៦៧ សំឡេង និង អនុប្បវាទ ១០៩ សំឡេង បន្ទាប់ពី ការជជែក ដេញដោល ជាបន្ទាន់ មួយ ត្រូវបាន ធ្វើឡើង កាលពី សប្តាហ៍ មុន ។
គណៈកម្មការ អឺរ៉ុប កាលពី ខែមិថុនា កន្លងទៅ នេះ បាន លើកឡើង នូវ យុទ្ធសាស្ត្រ ថ្មី នៅក្នុង ការផលិត វ៉ាក់សាំង ដោយ ស្នើសុំ ឲ្យ មាន ការផ្អាក អនុវត្ត ច្បាប់ ហាមឃាត់ មួយចំនួន ទៅ លើ ការធ្វើតេស្ត វ៉ាក់សាំង តាម គ្លីនិក ឬ ក៏ ព្យាបាល អ្នកជំងឺ COVID-19 តាមរយៈ ការកែប្រែ ហ្សែន លើ សារ ពាង្គ ដោយ បច្ចេកទេស វិស្វកម្ម (GMOs) ។
គួរ បញ្ជាក់ ថា ដោយសារតែ រដ្ឋ ជា សមាជិក នីមួយ ៗ នៅ សហភាព អឺរ៉ុប តែងតែ តម្រូវ ឱ្យ មាន ការវាយតម្លៃ ពី ហានិភ័យ នៃ ការព្យាបាល សាកល្បង លើ ឱសថ និង ការតេស្ត វ៉ាក់សាំង តាម វិធី GMOs ជា ហេតុ ធ្វើឱ្យ មាន ការពន្យារ ពេល លើក ការធ្វើតេស្ត វ៉ាក់សាំង កន្លងមក នេះ ។ ដូច្នេះ ច្បាប់ ថ្មី របស់ អឺរ៉ុប នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ជួយ សម្រួល ក៏ដូចជា ការកាត់ ពេលវេលា ក្នុង ការអភិវឌ្ឍ វ៉ាក់សាំង ដើម្បី សង្គ្រោះ ជិវិត មនុស្ស ឱ្យ ទាន់ ពេលវេលា ៕
បណ្ឌិត ហេង សុខ គង់ ប្រគេន ទៀន ព្រះវស្សា និង ទេយ្យ វត្ថុ ដល់ ព្រះសង្ឃ គង់ ចាំ ព្រះវស្សា នាវត្ត ផុង ភក្តីវរ៉ារាម
( កំពង ស្ពឺ) ៖ នា ព្រឹក ថ្ងៃសៅរ៍ ៦រោច ខែ អាសាឍ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៤ ត្រូវនឹង ថ្ងៃទី ១១ ខែកក្កដា ឆ្នាំ ២០២០ នេះ បណ្ឌិត ហេង សុខ គង់ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង លោកស្រី ហង្ស ម៉ារីណា រួម ដំណើរ ដោយ លោក លី ចាន់ សុភក្តី ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ឃុំ ភក្តី និង សហការី បាន អញ្ជើញ ប្រគេន ទៀន ព្រះវស្សា និង ទេយ្យ វត្ថុ ដល់ ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា អស់ កាល១ ត្រីមាស នាវត្ត ផុង ភក្តីវរ៉ារាម ស្ថិត នៅ ឃុំ ភក្តី ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ ។
បន្ទាប់ពី ពាំនាំ នូវ មតិ ផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ លោក ហ៊ុន ម៉ានី អ្នកតំណាងរាស្រ្ត មណ្ឌល កំពង់ស្ពឺ រួច មក លោក បណ្ឌិត ហេង សុខ គង់ បាន សំណេះសំណាល និង សួរសុខទុក្ខ ដល់ លោកតា លោកយាយ ពុក ម៉ែ បងប្អូន នៅ មូលដ្ឋាន ឃុំ ភក្តី ទាំងមូល ហើយក៏ បាន លើកទឹកចិត្ត ឲ្យ បងប្អូន បន្ត ចូលរួម ជាមួយ វិធានការ របស់ ក្រសួង សុខាភិបាល ក៏ ដូចជា រាជ រដ្ឋាភិបាល ក្នុង កំឡុង ពេល រីករាលដាល នូវ ជំងឺ ផ្លូវ ដង្ហើម កូវីដ១៩ នេះ ។
