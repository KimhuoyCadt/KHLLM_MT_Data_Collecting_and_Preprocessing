( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្រ្តី អូស្មាន ហាស្សាន់ បាន ដឹកនាំ ប្រតិភូ នៃ គណៈដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា អម ដំណើរ ដោយ លោក ឧកញ៉ា សុះ កំរ៉ី ចាងហ្វាង គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា និង សមាជិក សមាជិកា រដ្ឋសភា រាជ រដ្ឋាភិបាល សិស្សានុសិស្ស សរុប ជាង ៤០០ នាក់ អញ្ជើញ ទស្សនកិច្ច សិក្សា វិមាន ឈ្នះ ឈ្នះ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ដែល ត្រូវបាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ ពី នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ អនុប្រធាន គណៈកម្មការ សាងសង់ និង សហការី ។
បន្ទាប់ពី កិច្ច ស្វាគមន៍ នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ បាន លើកឡើង ថា វិមាន ឈ្នះ ឈ្នះ គឺជា ការផ្តួចផ្តើម គំនិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល លោក មាន ទស្សនវិជ្ជា ធំធេង បំផុត ក្នុង នយោបាយ ឈ្នះ ឈ្នះ នេះ ហើយក៏ ផ្អែក ទៅ តាម ឯកសារ នយោបាយ ឈ្នះ ឈ្នះ ។
នាយ ឧត្តមសេនីយ៍ បាន បន្ត ថា អ្វី ដែល មាន លក្ខណៈ កាន់តែ ពិសេស នៅ ទីនេះ ដែល សប្បាយរីករាយ បំផុត ក្នុង ទស្សនៈ គោល នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន គឺ បាន បង្កប់ នូវ ព្រលឹង មួយ ដ៏ ធំធេង បំផុត គឺជា ព្រលឹង នៃ ការធានា បាន នូវ ការ ធ្វើឲ្យ មាន សុខដុម បនីយកម្ម សាសនា និង សង្គមជាតិ ទាំងមូល ។
ជាក់ស្តែង ក្លោងទ្វា របស់ វិមាន ឈ្នះ ឈ្នះ គឺជា ក្លោងទ្វា ជ័យ របស់ យើង ទាំងអស់ គ្នា ដែល មាន ចម្លាក់ មិន ធ្លាប់ មាន ទេ ក្នុង ប្រវត្តិសាស្រ្ត គឺជា ចម្លាក់ រូប សញ្ញា នៃ សុខដុម បនីយកម្ម សាសនា ដែល មាន ចម្លាក់ សញ្ញា នៃ សាសនា ព្រះពុទ្ធ នៅ កណ្តាល ជា សាសនា របស់ រដ្ឋ អម សងខាង ដោយសាសនា ឥស្លាម និង សាសនា គ្រឹស្ត ដែល ត្រូវបាន សិក្សា យ៉ាង ម៉ត់ចត់ ល្អិតល្អន់ បំផុត ពី បុព្វជិក សាសនា នីមួយ ៗ រហូត ទទួលបាន នូវ ការចម្លាក់ នូវ សញ្ញា សាសនា ទាំង បី ក្រោម ម្លប់ សុខដុមនីយកម្ម តំនាង នៅ វិមាន ឈ្នះ ឈ្នះ នេះ ។
កីឡាករ ជម្រើសជាតិ ទោចក្រយាន កម្ពុជា លើក មុខមាត់ វិស័យ កីឡា ប្រណាំង កង់ លើ ឆាក អន្តរជាតិ តាមរយៈ ឈ្នះ ជ័យលាភី ពី ការប្រកួត នៅ ប្រទេស មីយ៉ាន់ម៉ា
ក្រោយពី បញ្ចប់ ការប្រកួត ដ៏ ស្វិតស្វាញ ទាំង បច្ចេកទេស និង ល្បឿន ជាមួយ កីឡាករ ជម្រើសជាតិ មកពី បណ្តាល ប្រទេស ខាងលើ លទ្ធផល របស់ កីឡាករ ជម្រើសជាតិ កម្ពុជា ដែល ទៅ ចូលរួម ប្រកួត នោះ រួម មាន៖ កីឡាករ យឿន ភីយុត ទទួលបាន ចំណាត់ថ្នាក់ លេខ ២ សម្រាប់ ការប្រណាំង អាយុ ក្រោម ២៣ ឆ្នាំ ផ្នែក បុរស រីឯ ការប្រណាំង សម្រាប់ វ័យ ជំទង់ វិញ កីឡាករ កម្ពុជា លោក គឹម ចន្ធូ ទទួល ចំណាត់ថ្នាក់ លេខ ១ ពាន ជើងឯក ដោយឡែក កីឡាករ វុន សាវីន ទទួលបាន ចំណាត់ លេខ ៣ និង ប៊ុន សេង ប៉ាវ បាន លេខ ៤។
លោក ក៏ បាន បន្ថែម ថា « ចំណែក កីឡាករ ប្រណាំង ផ្នែក បុរស វ័យ ក្រោម ២៣ ឆ្នាំ យឿន ភីយុត បិះតែ នឹង ទទួលបាន ចំណាត់ថ្នាក់ លេខ ១ទៅ ហើយ តែ ដោយសារ ទេពកោសល្យ និង ជំនាញ ក្នុង ការគ្រប់គ្រង ល្បឿន របស់ កីឡាករ របស់ មកពី ប្រទេស ចិន ធ្វើឲ្យ គាត់ របូត នូវ ឱកាស ដ៏ ល្អ មួយ នេះ » ។ ទោះបីជា ដូច្នេះ ក្តី សាម៉ីខ្លួន បាន សម្តែង នូវ ការតាំងចិត្ត ថា រូប គេ នឹង មិន ឲ្យ បាត់បង់ ឱកាស ម្តង ទៀត នោះ ទេ គេ នឹង ព្យាយាម ហ្វឹកហាត់ ដើម្បី នាំយក នូវ កិត្តិយស ជូន ជាតិ ក្នុង ព្រឹត្តិការណ៍ ខាងមុខ ។
លោក លាង ពៅ ( ភី ធើរ ) អគ្គ នាយក នៃ ក្រុមហ៊ុន ផលិត ភេសជ្ជៈ កម្លាំង វើក ហើយក៏ ជា អ្នកស្នេហា វិស័យ ជិះ កង់ ដ៏ សម្បើម ម្នាក់ ផងដែរ នោះ ក្រោយពេល បាន ជ្រាប ពី លទ្ធផល នេះ លោក បាន រៀបរាប់ ទាំង មុខ រីករាយ ដែរ ថា « យើង ពិតជា មាន មោទនភាព និង រីករាយ បំផុត ជាមួយ លទ្ធផល ដែល កីឡាករ ជម្រើសជាតិ ទោចក្រយាន កម្ពុជា បាន នាំមក ជូន ប្រជាពលរដ្ឋ កម្ពុជា ជាតិ មាតុភូមិ និង លើក មុខមាត់ វិស័យ កីឡារ ប្រណាំង កង់ នេះ នៅលើ ឆាក អន្តរជាតិ » ។
លោក បន្ថែម ទៀត ថា « ក្នុង នាម ជា ម្ចាស់ ឧបត្ថម សហព័ន្ធ កីឡា ទោចក្រយាន យើង សូម កោតសរសើរ ដល់ ការខិតខំ ប្រឹងប្រែង របស់ កីឡាករ កម្ពុជា គ្រូបង្វឹក និង ថ្នាក់ដឹកនាំ សហព័ន្ធ រហូត ទៅដល់ ការនាំយក ជ័យ ជំនះ មកដល់ មាតុ ប្រទេស វិញ និង លើកទឹកចិត្ត ឲ្យ ក្រុម កីឡាករ និង គ្រូបង្វឹក ខិតខំ បន្ត ទៀត ដើម្បី យក ជ័យ ជំនះ ផ្សេង ទៀត ពី អន្តរជាតិ នៅពេល ខាងមុខ » ។
( ស្វាយរៀង ) ៖ សាខា កាំ កុងត្រូល ខេត្ត ស្វាយរៀង វេលា ម៉ោង ៤ ទៀប ភ្លឺ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ចុះ ពិនិត្យ ទំនិញ នាំចូល តាម ច្រក កំពង់ស្ពាន ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។ សកម្មភាព ការងារ នេះ បាន ពិនិត្យ និង ស្វែងរក សារធាតុ Borax និង សារធាតុ គីមី ហាមឃាត់ ចំពោះ មុខ ទំនិញ ដែល អាជីវករ នាំចូល ពី ប្រទេស វៀតណាម ។
លោក ផឹង និល ប្រធាន សាខា កាំត្រូល ខេត្ត ស្វាយរៀង បាន ថ្លែង ប្រាប់ ភ្នាក់ងារ Fresh News ឱ្យដឹង ថា នៅ ព្រឹក នេះ សាខា កាំ កុងត្រូល ខេត្ត ស្វាយរៀង បាន សហការ ជាមួយ យោធា ព្រំដែន ចំណុះ កង វរសេនា តូច លេខ២ ឈរ ជើង នៅ ច្រក កំពង់ស្ពាន ស្ថិត ក្នុង សង្កាត់ បាវិត ដើម្បី ចុះ ត្រួតពិនិត្យ បន្លែ ផ្លែ ឈើ ត្រី សាច់ គ្រប់ ប្រភេទ ដែល នាំចូល ពី ប្រទេស វៀតណាម រក សារធាតុ គីមី ហាមឃាត់ ដាក់ លើ បន្លែ ផ្លែ ឈើ និង ម្ហូប អាហារ ដែល ក្រុម អាជីវករ ដឹក មក លក់ តាម ផ្សារ នានា ក្នុង ភូមិសាស្ត្រ ទឹកដី ខេត្ត ស្វាយរៀង ។
លោក ផឹង និល បាន បន្ត ថា ការចុះ ពិនិត្យ មុខ ទំនិញ នៅ ថ្ងៃ នេះ ក្នុង បំណង ធានា បាន « សុវត្ថិភាព ម្ហូប អាហារ » ព្រោះ វា មាន សារសំខាន់ ចាំបាច់ ណាស់ ក្នុង សង្គម និង ជីវភាព ប្រចាំ ថ្ងៃ ការ ទទួលខុសត្រូវ លើ សុវត្ថិភាព ម្ហូប អាហារ គឺជា ការទទួលខុសត្រូវ រួមគ្នា ទាំង ស្ថាប័ន ជំនាញ ទាំង អ្នកនាំចូល អ្នកផលិត អ្នកចែកចាយ និង យើង ទាំងអស់ គ្នា ជា អ្នកប្រើប្រាស់ ផងដែរ ព្រោះ សុខភាព គឺជា កត្តា ចំបង នៃ ភាព រស់រាន នៃ ជីវិត ។
លោក ផឹង និល បាន បញ្ជាក់ ថា ជា លទ្ធផល ក្រោយ ការចុះអនុវត្ត ការងារ និង បាន ដក យក គំរូ ចំនួន ៣៩ មុខ ទំនិញ ក្នុង នោះ មន្ត្រី យេីង បាន ដកហូត មី ដុំ ក្រៀម គ្មាន ម៉ាក យីហោរ ពិតប្រាកដ ចំនួន ២០ គីឡូ នំ បាញ់ ត្រាំង ខូច គុណភាព ចំនួន ០៥ គីឡូក្រាម ងៀត ត្រីប បែល ចំនួន ០១ គីឡូក្រាម រួមទាំង នំ ចាក ច័ន្ទ ចំនួន ០១ គីឡូក្រាម បាន រក ឃេីញ មាន ផ្ទុក សារធាតុ Borax ដែល ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ ។
បើ តាម លោក ឌិត ទីណា នៅ កម្ពុជា បច្ចុប្បន្ន មិន ទាន់ មាន រោងចក្រ ផលិត ឧស្ម័ន ហ្គាស នៅឡើយ ទេ ពោល ឧស្ម័ន ហ្គាស ដែល ប្រជាពលរដ្ឋ ប្រើប្រាស់ នា ពេល បច្ចុប្បន្ន គឺ សុទ្ធ ជា ហ្គាស នាំចូល ទាំងអស់ ប៉ុន្តែ នៅ ពេល អណ្ដូង ប្រេង របស់ កម្ពុជា ដែល នឹង ដំណើរការ ចាប់ពី ត្រីមាស ទី៣ នៃ ឆ្នាំ ២០១៩ ខាងមុខ តទៅ គេ ក៏ អាច ទាញយក ឧស្ម័ន ហ្គាស នេះ យកមក ប្រើប្រាស់ បាន ដូចគ្នា ផងដែរ ។
ទោះជា យ៉ាងណា មន្ត្រី ជាន់ ខ្ពស់ នៃ ក្រសួង រ៉ែ រូប នេះ ក៏ បាន បញ្ជាក់ យ៉ាង ច្បាស់លាស់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នៅតែ ស្វាគមន៍ និង គាំទ្រ ចំពោះ ការវិនិយោគ លើ វិស័យ ឧស្ម័ន LPG នៅ ប្រទេស កម្ពុជា ហើយ ព្រឹត្តិការណ៍ តាំងពិព័រណ៍ រយៈពេល ៣ ថ្ងៃ នេះ ក៏ ជា ឱកាស ដ៏ ពិសេស សម្រាប់ អ្នក វិនិយោគ ដែល ចង់ វិនិយោគ លើ វិស័យ ឧស្ម័ន LPG នៅ កម្ពុជា ផងដែរ ។
ពាក់ព័ន្ធ នឹង ស្ថានីយ៍ LPG ដែល លក់ ឧស្ម័ន ហ្គាស សម្រាប់ បញ្ឆេះ យានយន្ត ទៀតសោត លោក រដ្ឋលេខាធិការ បាន បន្ថែម ថា មាន ស្ថានីយ មួយចំនួន រៀបចំ មិន សមរម្យ និង មិន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស នៅឡើយ ដែល អាច បង្ក ជា គ្រោះថ្នាក់ ដោយ ប្រការ ផ្សេង ៗ ។ លោក បាន ទទូច ដល់ ប្រជាពលរដ្ឋ ថា ប្រសិនបើ ឃើញ ស្ថានីយ ហ្គាស ណាមួយ រៀបចំ កន្លែង និង ចាក់ ហ្គាស មិន ត្រឹមត្រូវ សូម កុំ ចូល ចាក់ ហ្គាស នៅ កន្លែង នោះ ឱ្យ សោះ ដើម្បី ការពារ សុវត្ថិភាព ផ្ទាល់ ក៏ ដូចជា យានយន្ត របស់ ខ្លួន ផងដែរ ។
ចំពោះ អត្ថប្រយោជន៍ នៃ ការប្រើប្រាស់ ឧស្ម័ន LPG លោក ឌិត ទីណា បាន ឱ្យដឹង ថា ការប្រើប្រាស់ ហ្គាស មាន សុវត្ថិភាព ជាង ការប្រើប្រាស់ ឥន្ធនៈ ដទៃ មាន ប្រសិទ្ធភាព ជាង កាត់បន្ថយ ការចំណាយ បាន ច្រើន ជាង កាត់បន្ថយ ផល ប៉ះពាល់ ដល់ បរិស្ថាន សន្សំ សំចៃ កាបូន ( ការប្រើប្រាស់ កាបូន ច្រើន នាំឱ្យ ហិនហោច ដល់ ព្រៃឈើ ) និង អត្ថប្រយោជន៍ ជាច្រើន ទៀត ៕
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ មន្រ្តី កាំ កុងត្រូល ផែ ស្ងួត ចុង ទី ភ្នំពេញ សាខា កាំ កុងត្រូល រាជធានី ភ្នំពេញ បាន សហការ ជាមួយ មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម ភ្នំពេញ និង គណៈកម្មការ ផ្សារ ដើម គរ ខណ្ឌ ទួលគោក បន្ត ចុះ ត្រួតពិនិត្យ ទំនិញ ផ្សារ ដើម គរ និង តាម តូប លក់ ទំនិញ មួយចំនួន ដើម្បី ស្រាវជ្រាវ ទប់ស្កាត់ នូវ ទំនិញ ខូច គុណភាព ។
លោក គង់ វុទ្ធី បាន បន្ត ថា ចំពោះ ការចុះ ពិនិត្យ ទំនិញ នេះ គឺ អនុវត្តន៍ ជាបន្ទាប់បន្ត ដោយ ស្ថិត ក្រោម ការណែនាំ របស់ ប្រធាន ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក អគ្គ នាយកដ្ឋាន កាំកុងត្រូល នឹង លោក ប្រធាន កាំ កុងត្រូល រាជធានី ភ្នំពេញ ។
រដ្ឋសភា នឹង បើក ប្រជុំ ពិភាក្សា និង អនុម័ត សេចក្តីព្រាង ច្បាប់ ថវិកា ឆ្នាំ ២០១៩ នៅ ថ្ងៃ ១៥ វិច្ឆិកា
( ភ្នំពេញ ) ៖ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា បាន បញ្ជាក់ ថា នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ រដ្ឋសភា នឹង បន្ដ សម័យ ប្រជុំ លើក ទី១ នីតិកាល ទី៦ ក្រោម អធិបតីភាព សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ។
បើ តាម សេចក្ដីជូនដំណឹង នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ កិច្ចប្រជុំ មាន របៀបវារៈសំខាន់ ៗ មួយចំនួន រួម មាន៖
ទី១៖ ការពិភាក្សា និង អនុម័ត សេចក្ដីព្រាង ច្បាប់ ស្ដីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០១៩ ។
ទី២៖ ការពិភាក្សា និង អនុម័ត សេចក្ដីព្រាង ច្បាប់ ស្ដីពី ការទូទាត់ ថវិកា ទូទៅ របស់ រដ្ឋ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០១៧ ។
ទី៣៖ ការពិភាក្សា និង អនុម័ត សេចក្ដីព្រាង ច្បាប់ ស្ដីពី ការអនុម័ត យល់ព្រម លើ
* កិច្ចព្រមព្រៀង រវាង រាជ រដ្ឋាភិបាល នៃ កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ស្ដីពី ការចៀសវាង ការយក ពន្ធ ត្រួត គ្នា និង ការបង្ការ ការកិបកេងបន្លំ ពន្ធ ពាក់ព័ន្ធ នឹង ពន្ធ លើ ប្រាក់ ចំណូល * កិច្ចព្រមព្រៀង រវាង រាជ រដ្ឋាភិបាល នៃ កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី ស្ដីពី ការចៀសវាង ការយក ពន្ធ ត្រួត គ្នា និង ការបង្ការ ការកិបកេងបន្លំ ពន្ធ ពាក់ព័ន្ធ នឹង ពន្ធ លើ ប្រាក់ ចំណូល ។
ទី ៤៖ ការពិភាក្សា និង អនុម័ត លើ សេចក្ដីព្រាង ច្បាប់ ស្ដីពី ការអនុម័ត យល់ព្រម លើ សន្ធិសញ្ញា ស្ដីពី បត្យាប័ន រវាង កម្ពុជា និង សហព័ន្ធ រុស្ស៊ី ៕
សម្ដេច ស ខេង ចេញ ប្រកាស កំណត់ ចំនួន មុខតំណែង អគ្គ ស្នងការ រង អគ្គ នាយក រង អនុប្រធាន នាយកដ្ឋាន កណ្ដាល អនុប្រធាន នាយកដ្ឋាន នាយ រង ការិយាល័យ ក្របខ័ណ្ឌ មន្រ្ដី នគរបាល ជាតិ និង ពន្ធនាគារ
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ ចេញ ប្រកាស កំណត់ ចំនួន មុខតំណែង អគ្គ ស្នងការ រង អគ្គ នាយក រង អនុប្រធាន នាយកដ្ឋាន កណ្ដាល អនុប្រធាន នាយកដ្ឋាន នាយ រង ការិយាល័យ និង ថ្នាក់ ប្រហាក់ប្រហែល ក្នុង ក្របខ័ណ្ឌ មន្ដ្រី នគរបាល ជាតិ កម្ពុជា និង ក្របខ័ណ្ឌ មន្ដ្រី ពន្ធនាគារ ក្រសួង មហាផ្ទៃ ។
បើ តាម ប្រកាស របស់ សម្ដេច ក្រឡាហោម ស ខេង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ប្រការ៣ បាន បញ្ជាក់ ថា ចំនួន អតិបរមា នៃ មុខតំណែង អគ្គ ស្នងការ រង អគ្គ នាយក រង និង ថ្នាក់ ប្រហាក់ប្រហែល ក្នុង ក្របខ័ណ្ឌ មន្ដ្រី នគរបាល ជាតិ កម្ពុជា និង ក្របខ័ណ្ឌ មន្ដ្រី ពន្ធនាគារ ក្រសួង មហាផ្ទៃ ត្រូវបាន កំណត់ ដូច ខាងក្រោម៖
សូម អាន ខ្លឹមសារ លម្អិត នៃ សេចក្ដីសម្រេច ដែល មាន នៅ ខាងក្រោម នេះ៖
( បាត់ដំបង ) ៖ លោក សួង ម៉េង ឡុង រដ្ឋលេខាធិការ តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន លើកឡើង ថា បច្ចុប្បន្ន នេះ ក្រសួង សង្គមកិច្ច លើកទឹកចិត្ត ឲ្យ ភាគី ពាក់ព័ន្ធ ផ្តោត លើ ការថែទាំ កុមារ តាម គ្រួសារ និង សហគមន៍ ប្រសើរ ជាង ការប្រមូលផ្តុំ កុមារ ទៅ រស់ នៅក្នុង មណ្ឌល ។
លោក សួង ម៉េង ឡុង លើកឡើង បែប នេះ ខណៈ លោក ចូលរួម នៅក្នុង ពិធី បើក សិក្ខាសាលា ស្តីពី « ការបញ្រ្ជាប គោល នយោបាយ ថែទាំ ជំនួស ចំពោះ កុមារ និង ផ្សព្វផ្សាយ លិខិត បទដ្ឋាន នីតិវិធី ស្មុំ កូន អន្តរ ប្រទេស » នា ថ្ងៃអង្គារ ទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ សាលា ខេត្ត បាត់ដំបង ។
លោក សួង ម៉េង ឡុង បាន ឲ្យដឹង ថា ការរៀបចំ សិក្ខាសាលា នេះ ឡើង គឺ ក្នុង គោលបំណង ផ្សព្វផ្សាយ ផ្តល់ បច្ចេកទេស បង្កើន ចំណេះដឹង ពង្រឹង សមត្ថភាព បន្ថែម ដល់ មន្រ្តី ការិយាល័យ ស. អ. យ ក្នុង ស្រុក មន្រ្តី គ.ក .ស ស្រុក / ក្រុង មន្រ្តី គ.ក .ន ឃុំ / សង្កាត់ និង មន្រ្តី ពាក់ព័ន្ធ លើ ការងារ ថែទាំ ជំនួស ចំពោះ កុមារ នីតិវិធី ស្មុំ កូន អន្តរ ប្រទេស និង លិខិត បទដ្ឋាន ពាក់ព័ន្ធ ផ្សេង ៗ ទៀត ។
ការដាក់ចេញ យុទ្ធសាស្រ្ត ភ្នាល់ របស់ លោក សម រង្ស៉ី បាន ធ្វើឱ្យ មាន ប្រតិកម្ម ប្រឆាំង យ៉ាង ខ្លាំង ពី អ្នកគាំទ្រ របស់ លោក កឹម សុខា ដែល ក្នុង នោះ មាន ទាំង ក្រុមគ្រួសារ របស់ លោក និង មេធាវី របស់ លោក ថែម ទៀត ផង ។
បើ តាម អ្នកច្បាប់ ស្ថិត ក្នុង ដំណាក់កាល នេះ នាយក រដ្ឋមន្រ្តី ពុំ មាន សិទ្ធិ សម្រេច ស្នើ លើកលែង ទោស ដល់ លោក កឹម សុខា នោះ ទេ ដោយសារតែ លោក កឹម សុខា ស្ថិត នៅក្នុង ដំណាក់កាល ស៊ើបអង្កេត មិន ទាន់ ក្លាយទៅជា ទណ្ឌិត ដែល មាន សាលក្រម ស្ថាពរ នៅឡើយ ៕
សម្ដេច តេជោ ហ៊ុន សែន ផ្តល់ អគារ សិក្សា ដល់ អនុវិទ្យាល័យ ក្រយា ក្នុង ខេត្ត កំពង់ធំ
( កំពង់ធំ )៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ប្រកាស កសាង អគារ សិក្សា ១ខ្នង មាន កម្ពស់ ២ជាន់ និង ១២ បន្ទប់ ជូន ដល់ អនុវិទ្យាល័យ ក្រយា ស្ថិត ក្នុង ឃុំ ក្រយា ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
អំណោយ អគារ នេះ ត្រូវបាន ប្រគល់ ជូន តាមរយៈ លោក ជា ចាន់តូ សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក សន្ទុក ។
អគារ សិក្សា ថ្មី នេះ ត្រូវបាន ធ្វើ ពិធី បញ្ចុះ បឋមសិលា កសាង ផ្លូវការ នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ក្រោម ការចូលរួម ពី លោក ជា ចាន់តូ។ បន្ថែម ពី នេះ លោក ជា ចាន់តូ ក៏ បាន ប្រកាស ជួយ ជួសជុល អគារ សិក្សា ចាស់ ៗ និង កសាង របង សាលា ផងដែរ ។
លោក ជា ចាន់តូ បាន ឲ្យដឹង ថា ការប្រគល់ ជូន អគារ សិក្សា ដល់ អនុវិទ្យាល័យ ក្រយា នេះ ធ្វើឡើង បន្ទាប់ពី មើលឃើញ តម្រូវ ការចាំបាច់ របស់ លោកគ្រូ - អ្នកគ្រូ និង សិស្សានុសិស្ស ដែល កំពុង ខ្វះខាត មិន មាន អាគារ សិក្សា ត្រឹមត្រូវ ។ លើស ពី នេះ ដើម្បីឲ្យ កូន ចៅ ប្រជាពលរដ្ឋ ក្នុង តំបន់ ដាច់ស្រយាល មួយ នេះ មាន លទ្ធភាព ក្នុង ការសិក្សា រៀនសូត្រ ពិសេស គឺ ឆ្លើយតប នឹង កំណើន សិស្ស ក្នុង ឆ្នាំ សិក្សា ថ្មី ។
លោក ជា ចាន់ តូ បញ្ជាក់ ថា សមិទ្ធផល ក្នុង វិស័យ អប់រំ ដែល សម្រេច ជា បន្តបន្ទាប់ នៅ ទូទាំង ប្រទេស ជា ការខិតខំ របស់ រាជ រដ្ឋាភិបាល ពិសេស សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី កម្ពុជា ក្នុង បំណង បង្ខិត សាលារៀន ឲ្យ នៅ កាន់តែ ជិត និង ប្រជាពលរដ្ឋ និង សិស្សានុសិស្ស ដើម្បីឲ្យ ពួកគេ កាន់តែ ងាយស្រួល និង មាន ឱកាស រៀនសូត្រ ដូច សិស្ស ទាំង ផ្សេង ៗ ទៀត តាម បំណងប្រាថ្នា ។
ក្នុង ឱកាស នោះ លោក ជា ចាន់តូ បាន ស្នើឲ្យ ប្រជាពលរដ្ឋ រួម សាមគ្គី គ្នា បន្ត ថែរក្សា ការពារ សុខ សន្តិភាព ឲ្យបាន គង់វង្ស ព្រោះ សុខ សន្តិភាព ជា មូលដ្ឋាន គ្រឹះ ដ៏ រឹងមាំ សម្រាប់ អភិវឌ្ឍ ប្រទេស ។ សូម ចាំ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ទេ ដែល រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ និង បន្ត គាំទ្រ ចំពោះ គោល នយោបាយ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន បន្ត ទៀត ដើម្បី ការរីកចម្រើន របស់ សង្គមជាតិ និង ការរស់នៅ ប្រកបដោយ សេចក្ដីសុខសាន្ត ។
លោក អភិបាល រង ស្រុក សន្ទុក ឲ្យដឹង ថា គិត ត្រឹម ឆ្នាំ ២០១៨ នេះ នៅ ទូទាំង ស្រុក សន្ទុក មាន អគារ សិក្សា ដែល ជា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិចំនួន ២៥ ខ្នង ក្នុង នោះ អគារ សង់ ពី ថ្ម មាន ២២ ខ្នង និង អគារ សង់ ពី ឈើ មាន ៣ខ្នង ។ ក្រៅពី នោះ នៅ បាន ជួយ កសាង សមិទ្ធផល មួយចំនួន ទៀត ដែល បម្រើ ដល់ ការសិក្សា របស់ សិស្សានុសិស្ស ថែម ទៀត ផង ៕
សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ ថវិកា ជាង ១០ម៉ឺន ដុល្លារ តាមរយៈ សាលា រាជធានី ភ្នំពេញ បើក ការដ្ឋាន ជួសជុល ផ្លូវ បេតុង មួយ ខ្សែ នៅ សង្កាត ចោម ចៅ៣ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ លោក ហែម ដារិទ្ធិ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន បើក ការដ្ឋាន ជួសជុល ផ្លូវ បេតុង ឆ្អឹង ដែក មួយ ខ្សែ មាន ប្រវែង ២៥០ ម៉ែត្រ ទទឹង ១០ម៉ែត្រ ស្ថិត នៅ ភូមិ ព្រៃ ទា១ សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដែល ថវិកា ត្រូវ ចំណាយ លើ ការជួសជុល នោះ មាន ជាង ១០ម៉ឺន ដុល្លារ ដែល ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ផ្តល់ ជូន តាមរយៈ សាលា រាជធានី ភ្នំពេញ ។
ពិធី បើក ការដ្ឋាន ខាងលើ នេះ ក៏ មាន ការចូលរួម ពី អភិបាល រង ខណ្ឌ . អធិការ រង នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ . មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខណ្ឌ ពោធិ៍សែនជ័យ ព្រមទាំង លោក លោកស្រី ជា មន្ត្រី សាលា ខណ្ឌ សង្កាត់ ភូមិ និង ប្រជាពលរដ្ឋ ជាច្រើន ផងដែរ ។
ក្នុង ឱកាស នោះ លោក ហែម ដារិទ្ធិ បាន លើកឡើង ថា ផ្លូវ ដែល បើក ការដ្ឋាន ជួសជុល នេះ គឺ ចាក់ បេតុង ឆ្អឹង ដែក មាន ប្រវែង ២៥០ ម៉ែត្រ ទទឹង ១០ម៉ែត ដែល ជា ថវិកា របស់ សម្តេច តេជោ ហ៊ុន សែន តាមរយៈ សាលា រាជធានី ភ្នំពេញ ។ លោក បន្ថែម ថា ការស្ថាបនា ផ្លូវ ខាងលើ ដើម្បីឲ្យ បងប្អូន ប្រជាពលរដ្ឋ កាន់តែ ងាយស្រួល ធ្វើដំណើរ ឆ្ពោះ ពី តំបន់ មួយ ទៅ តំបន់ មួយ ជាពិសេស ដើម្បី ស្រប តាម អនុសាសន៍ ថ្នាក់ដឹកនាំ ប្រមុខ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន ។
លោក អភិបាល ខណ្ឌ ក៏ សុំឲ្យ ប្រជាពលរដ្ឋ ត្រូវ រួមគ្នា ចូលរួម ថែរក្សា ផ្លូវ នេះ បាន គ្រប់ ៗ គ្នា និង សុំ ការយោគយល់ នៅពេល មាន ការជួសជុល ឡើងវិញ នោះ ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ លោក ហែម ដារិទ្ធិ ក៏ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សូម មេត្តា វិចខ្ចប់ សំរាម ដាក់ ឲ្យបាន ត្រឹមត្រូវ ចៀសវាង ការបោះចោល ពាស វាលពាសកាល ដែល នាំឲ្យ ប៉ះពាល់ ដល់ បរិស្ថាន ជាពិសេស នោះ គឺ ប៉ះពាល់ ដល់ សុខភាព បងប្អូន ផ្ទាល់ តែម្តង ៕ Manulife ពង្រីក វិសាលភាព អាជីវកម្ម របស់ ខ្លួន ដល់ ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ ក្រុមហ៊ុន មេនូឡាយ ហ្វ៍ ខេមបូឌា ដែល ជា ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត អន្តរជាតិ ដំបូង គេ នៅក្នុង ប្រទេស កម្ពុជា បាន បើក ការិយាល័យ សាខា ថ្មី នៅ ខេត្ត ព្រះសីហនុ ដែល ជា ខេត្ត មួយ ពោរពេញ ដោយ សក្ដានុពល សេដ្ឋកិច្ច ខ្លាំង និង ជា ខេត្ត ដែល មាន កំពង់ផែ អន្តរជាតិ ធំ បំផុត ក្នុង ប្រទេស ផងដែរ ។
ខេត្ត ឆ្នេរសមុទ្រ មួយ នេះ កំពុង ក្លាយជា គោលដៅ ទេសចរណ៍ ដ៏ មាន ប្រជាប្រិយភាព ដែល ត្រូវបាន សារព័ត៌មាន ញ៉ូវយ៉ក ថា ម (New York Times) ឲ្យ ចំណាត់ថ្នាក់ ទី១៣ ក្នុង ចំណោម ៥២ គោលដៅ ទេសចរណ៍ ប្រចាំ ឆ្នាំ ២០១៨ ។ ការពង្រីក វិសាលភាព អាជីវកម្ម នេះ នឹង ជួយ បំពេញ តម្រូវការ ធានារ៉ាប់រង អាយុជីវិត និង ដំណោះស្រាយ ហិរញ្ញវត្ថុ ដែល មាន គុណភាព ខ្ពស់ និង សម្បូរបែប ជូន ដល់ ប្រជាជន នៅក្នុង ខេត្ត ដ៏ ពិសេស មួយ នេះ ។
Manulife បាន ពង្រីក អាជីវកម្ម របស់ ខ្លួន យ៉ាង ឆាប់រហ័ស ដោយ នេះ ជា ការបើក សម្ពោធ ការិយាល័យ ថ្មី ទី៦ហើយ របស់ ក្រុមហ៊ុន បន្ទាប់ពី ការធ្វើ អាជីវកម្ម រយៈពេល ៦ឆ្នាំ របស់ ក្រុមហ៊ុន នៅ កម្ពុជា ។ ការិយាល័យ ដំបូង របស់ ក្រុមហ៊ុន ត្រូវបាន បើក ដំណើរការ កាលពី ឆ្នាំ ២០១២ នៅ រាជធានី ភ្នំពេញ បន្ទាប់មក នៅ ខេត្ត សៀមរាប ក្នុង ឆ្នាំ ២០១៤. ខេត្ត បាត់ដំបង ក្នុង ឆ្នាំ ២០១៥. ខេត្ត កំពង់ចាម ក្នុង ឆ្នាំ ២០១៦ និង ខេត្ត បន្ទាយមានជ័យ កាលពី ដើម ឆ្នាំ ២០១៨ នេះ ។
ការពង្រីក វិសាលភាព អាជីវកម្ម គឺជា យុទ្ធសាស្ត្រ របស់ ក្រុមហ៊ុន ដើម្បី ផ្តល់ ជូន ការ ការពារ ហិរញ្ញវត្ថុ និង បរិយាប័ន ហិរញ្ញវត្ថុ ដល់ គ្រួសារ កម្ពុជា ដែល រស់ នៅ ក្រៅ រាជធានី ភ្នំពេញ ហើយ នេះ ក៏ ស្រប គ្នា ទៅនឹង យុទ្ធសាស្ត្រ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ធនាគារ ជាតិ នៃ កម្ពុជា ផងដែរ ។
( ភ្នំពេញ ) ៖ ដើម្បី ជំរុញ ឲ្យ មាន ការប្រើប្រាស់ បង្គន់ អនាម័យ ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ តាម ទី ជនបទ នោះ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ AMK បាន ផលិត វីដេអូ អប់រំ មួយ ចំណងជើង ថា « ស្រួល បោះ គេ » សំដៅ ពន្យល់ ប្រជាពលរដ្ឋ ចេះ ស្វែងរក ឥណទាន សង់ បង្គន់ អនាម័យ ប្រើប្រាស់ កុំ បន្ទោបង់ ពាល វាល ពាក កាល តទៅទៀត ។
សូម ទស្សនា វីដេអូ អប់ រំ៖ អ្នក ជិះ បញ្ច្រាស រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត មាន . ក្នុង យប់ មិញ សមត្ថកិច្ច ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង ថែម ទៀត
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន ញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ។
របាយការណ៍ ខាងលើ ត្រូវបាន ចេញផ្សាយ នៅ ថ្ងៃចន្ទ សប្ដាហ៍ នេះ ដោយ មជ្ឈមណ្ឌ សម្រាប់ ការសិក្សា អន្តរជាតិ និង យុទ្ធសាស្ត្រ (CSIS) មាន មូលដ្ឋាន នៅ សហរដ្ឋ អាមេរិក ។ CSIS ផ្អែក លើ ការវិភាគ លើ រូបភាព ពី ផ្កាយ រណប បាន បញ្ជាក់ ទៀត ថា ទីតាំង ផលិត មីស៉ី ល និង អាវុធ នុយក្លេអ៊ែរ ចំនួន ១៣ទីតាំង ក្នុង ចំណោម ២០ ទីតាំង នៅ ទូទាំង ប្រទេស នៅតែ បន្ត ធ្វើ សកម្មភាព ជា សំងាត់ និង ត្រូវបាន កូរ៉េ ខាងជើង លាក់បាំង នៅ តាម តំបន់ ភ្នំ ដាច់ស្រយ៉ាល ។
ប៉ុន្តែ យ៉ាងណា ក៏ដោយ របាយការណ៍ ថ្មី នេះ មិន ត្រូវបាន អាជ្ញាធរ អាមេរិក ទទួលស្គាល់ នៅឡើយ ទេ ខណៈ របាយការណ៍ ដដែល ក៏ បាន បង្ហាញ ពី ការសង្ស័យ ផងដែរ ចំពោះ ការអះអាង របស់ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ដែល ថា កូរ៉េ ខាងជើង កំពុង រំសោយ អាវុធ នុយក្លេអ៊ែរ តាម ការសន្យា ក្រោយ ជំនួប កំពូល ជាមួយ លោក គីម ជុង អ៊ុន នៅក្នុង ប្រទេស សិង្ហបុរី កាលពី ខែមិថុនា កន្លងទៅ ។
គួរ បញ្ជាក់ ថា ការចេញផ្សាយ របាយការណ៍ របស់ CSIS កើត មាន ឡើង តែ មួយ សប្ដាហ៍ ប៉ុណ្ណោះ បន្ទាប់ពី ទីក្រុង ព្យុងយ៉ាង បាន ព្រមាន ថា នឹង ដំណើរការ គោល នយោបាយ ផលិត អាវុធ នុយក្លេអ៊ែរ ឡើងវិញ បើសិនជា ទីក្រុង វ៉ាស៉ីនតោន មិន ព្រម ដក ទណ្ឌកម្ម សេដ្ឋកិច្ច ទេ នោះ ៕
( សៀមរាប ) ៖ អភិបាល ខេត្ត សៀមរាប លោក ឃឹម ប៊ុន សុង នៅ រសៀល ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ទទួល ជួប សំណេះសំណាល និង ពិភាក្សា ការងារ ជាមួយ គណៈប្រតិភូ ខេត្ត ហឺណាន នៃ សាធារណៈ រដ្ឋ ប្រជាមានិត ចិន នៅ សាល ប្រជុំ រដ្ឋបាល ខេត្ត សៀមរាប ។
កិច្ចពិភាក្សា នេះ ក្នុង គោលបំណង ការពង្រឹង ពង្រីក នៃ កិច្ច ទំនាក់ទំនង សហប្រតិបត្តិការ គ្នា នឹង គ្នា ឲ្យ កាន់តែ មាន ភាពរឹងមាំ សំខាន់ ឈាន ទៅរក ការចុះអនុស្សរណៈ កិច្ចសហប្រតិបត្តិការ នឹង គ្នា រវាង ខេត្ត សៀមរាប ព្រះរាជាណាចក្រ កម្ពុជា និង ខេត្ត ហឺណាន នៃ សាធារណៈ រដ្ឋ ប្រជាមានិត ចិន ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឃឹម ប៊ុន សុង បាន បញ្ជាក់ ថា បើ ទោះបី មិន មាន លក្ខណៈ ផ្លូវការ ក៏ដោយ ពោល អភិបាល ខេត្ត ហឺណាន មក កម្សាន្ដ សប្បាយ នៅ ខេត្ត សៀមរាប នោះ លោក បាន សម្ដែង នូវ ការស្វាគមន៍ និង ថ្លែងអំណរគុណ ដល់ គណៈប្រតិភូ ដែល បាន ជ្រើសរើស ខេត្ត ទេសចរណ៍ មួយ នេះ ជា កន្លែង សម្រាប់ កម្សាន្ដ ។
បន្ថែម ពី នេះ អភិបាល ខេត្ត សៀមរាប ក៏ បាន ធ្វើ ការប្ដេជ្ញាចិត្ដ និង សន្យា បន្ដ កិច្ចសហប្រតិបត្តិការ ពង្រឹង ទំនាក់ទំនង រវាង ខេត្ត ទាំង ពីរ សៀមរាប - ហឺ ណាន ឲ្យ កាន់តែ ល្អ បន្ថែម ទៀត ពិសេស លើ វិស័យ ទេសចរណ៍ នេះ តែម្ដង ៕
សាកលវិទ្យាធិការ CUS ប្រាប់ ទៅកាន់ និស្សិត ទាំងអស់ ថា ចំណេះវិជ្ជា គឺជា ប្រទីប សម្រាប់ បំភ្លឺ ជីវិត ទៅ ថ្ងៃ អនាគត
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ ឯកទេស នៃ កម្ពុជា CUS ជារៀងរាល់ ឆ្នាំ បាន រៀបចំ សន្និសីទ ប្រចាំ ឆ្នាំ ដែល ជា ផ្នែក មួយ នៃ យន្តការលើកកម្ពស់ គុណភាព បណ្តុះបណ្តាល និង ដើម្បី ពង្រីក ពង្រឹង ចំណេះដឹង ទូទៅ ព្រមទាំង សមត្ថភាព របស់ និស្សិត ។
ជាក់ស្តែង កាលពី ថ្ងៃទី១០ - ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ សាកលវិទ្យាល័យ បាន រៀបចំ សន្និសីទ ស្តីពី « សិក្សា នៅ ឧត្តម សិក្សា ដើម្បី អនាគត រុងរឿង និង ជោគជ័យ » នៅ សាខា សាកលវិទ្យាល័យ ឯកទេស នៃ កម្ពុជា ខេត្ត បាត់ដំបង បន្ទាយមានជ័យ និង សៀមរាប ក្នុង គោលបំណង បង្ហាញ នូវ វិធីសាស្រ្ត សិក្សា ឲ្យ ទទួលបាន ជោគជ័យ ការសិក្សា លើ ជំនាញ ទន់ ការរៀបចំ អត្តចរិត និង ការពង្រឹង សមត្ថភាព ដើម្បី ទទួលបាន នូវ ការងារ ល្អ ក្រោយពេល បញ្ចប់ ការសិក្សា ដែល មាន សិស្ស - និស្សិត និង សាស្រ្តាចារ្យ ប្រមាណ ជាង ៥០០ នាក់ បាន ចូលរួម ។
អង្គ ពិធី ទទួលបាន ការចូលរួម ជា កិត្តិយស ពី វា គ្មិន ដែល មាន បទពិសោធន៍ ព្រមទាំង ទ្រឹស្តី ក្នុង ជំនាញ ជាក់លាក់ មក ពី អង្គការ និង ស្ថាប័ន រួម នឹង ថ្នាក់ដឹកនាំ របស់ សាកលវិទ្យាល័យ ទីតាំង គោល និង សាខា ។
ការសិក្សា ក្នុង ថ្នាក់ ត្រូវតែ ផ្តោត ខ្លាំង ទៅ លើ ជំនាញ តាមរយៈ ការងារ ជា អាទិភាព គឺ ការស្រាវជ្រាវ ការអាន កាកត់ត្រា សង្ខេប ជាប្រចាំ បំពេញ បន្ថែម ដោយ ការចូលរួម សិក្ខាសាលា សន្និសីទ វេទិកា ផ្សេង ៗ ព្រមទាំង ការចុះ កម្មសិក្សា ឬ ហាត់ ការពាក់ព័ន្ធ ជំនាញ ដែល និស្សិត ជ្រើសរើស ។ ទាំងអស់ នេះ គឺជា ទិសដៅ ការងារ ពាក់ព័ន្ធ តូច ៗ ធ្វើឡើង តាម ដំណាក់ និង លំដាប់លំដោយ ឈានទៅ សម្រេច គោលដៅ ធំ យូរអង្វែង ហើយ ការសិក្សា បាន ជោគជ័យ ក៏ ទាមទារ ឲ្យ មាន នូវ ការរៀបចំ ផែនការ សកម្មភាព និង គោលដៅ ជាក់លាក់ ផងដែរ ។
វា គ្មិន ទាំងអស់ បាន ឯកភាព បន្ថែម ទៀត ថា សិស្ស - និស្សិត ត្រូវ ពង្រឹង ជំនាញ ទន់ បន្ថែម ទៀត ដូចជា ជំនាញ ទំនាក់ទំនង ជំនាញ កំព្យូទ័រ ការផ្តល់ សេវាកម្ម ភាព ជា អ្នកដឹកនាំ ព្រមទាំង ភាសា ។ ភាសា អាច ជា ភាសា ណាមួយ ដែល មាន តម្រូវការ ក្នុង ទីផ្សារ ការងារ ដើម្បី ជា យាន្ត ក្នុង ការទំនាក់ទំនង ពង្រីក និង ពង្រឹង សមត្ថភាព ឲ្យ កាន់តែ ពូកែ ។
វា គ្មិន កត្តិយស បាន បង្ហាញ ជូន អំពី ស្ថាប័ន របស់ ខ្លួន លក្ខណសម្បត្តិ នៃ បុគ្គលិក ដែល ត្រូវ មាន ដើម្បីឲ្យ អ្នកចូលរួម បាន ដឹង ត្រៀមលក្ខណៈ ឲ្យបាន សមស្រប ជាស្រេច ក្នុង ការទទួលបាន ការងារ ក្នុង អំឡុង ពេល សិក្សា ឬ ក្រោយពេល បញ្ចប់ ការសិក្សា ។
ក្នុង នោះ ដែរ វា គ្មិន ដែល ជា តំណាង ស្ថាប័ន បាន ប្តេជ្ញា សហការ តាមរយៈ ការចុះអនុស្សរណៈ ដើម្បី ផ្តល់ ឱកាស ឲ្យ និស្សិត បាន ចុះ ធ្វើ កម្មសិក្សា ហាត់ ការ ឬ ស្រា វ ជ្រាវ ក្នុង គោលបំណង ជួយ ពង្រឹង ធនធាន បញ្ញា ឲ្យ កាន់តែ ប្រសើរ ដើម្បី ទទួលបាន ជោគជ័យ ក្នុង ការសិក្សា ការងារ និង សម្រាប់ ចូលរួម អភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង សង្គម ។
ក្នុង ពិធី បើក និង បិទ តំណាង សាកលវិទ្យាល័យ ទីតាំង គោល និង សាខា រួម មាន លោក សាស្រ្តាចារ្យ បណ្ទិត មាស បូរ៉ា សាកលវិទ្យាធិការ . លោក សាស្រ្តាចារ្យ បណ្ឌិត សឿ យ៉ាន សាកលវិទ្យាធិការ រង . លោក ណន ធី នាយក សាខា ខេត្ត បាត់ដំបង . លោក វ័ន វឿ នាយក សាខា ខេត្ត បន្ទាយមានជ័យ និង លោក ឃី វណ្ណេត នាយក សាខា ខេត្ត សៀមរាប បាន ឲ្យដឹង ថា ក្នុង ឆ្នាំ សិក្សា ថ្មី នេះ CUS ទទួលបាន កំណើន និស្សិត ថ្មី ច្រើន គួរឲ្យ កត់សម្គាល់ ។
បច្ចុប្បន្ន និស្សិត មាន ប្រមាណ ជិត ២០.០០០ នាក់ កំពុង សិក្សា នៅក្នុង ទីតាំង គោល និង សាខា ទាំង៨ ដែល មាន ២ទីតាំង នៅ រាជធានី ភ្នំពេញ និង សាខា ខេត្ត ចំនួន ៦ រួម មាន ខេត្ត កំពង់ចាម កំពង់ធំ សៀមរាប បន្ទាយមានជ័យ បាត់ដំបង និង ខេត្ត កំពត ព្រមទាំង បាន និង កំពុង មាន ការនិយម ខ្ពស់ ពីសំណាក់ អ្នកសិក្សា ខណៈ និស្សិត ដែល បាន បញ្ចប់ ការសិក្សា មាន ជាង ៣០.០០០ នាក់ ។
ចំពោះ ដំណឹង ថ្មី នេះ លោក ជៀប សួរ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ប្រេងកាត នៃ ក្រសួង រ៉ែ និង ថាមពល ដែល ជា សេនាធិការ របស់ រាជ រដ្ឋាភិបាល បាន បង្ហាញ នូវ ការសាទរ ចំពោះ ការរកបាន ដៃគូ នេះ ដោយ លោក ចាត់ទុក ថា ជា ការសម្រេចបាន មួយ ជំហ៊ាន ថ្មី ទៀត ក្នុង ចំណោម ជំហ៊ាន បន្តបន្ទាប់ ទៀត ។
លោក ពន្យល់ ថា ការបូម បាន ៣ម៉ឺន បារ៉ែល ក្នុង មួយ ថ្ងៃ គឺជា សមត្ថភាព របស់ នាវា ផលិតកម្ម បាន សេចក្តី ថា ពេល ខ្លះ ការបូម ប្រេង ពេល ខ្លះ បាន ច្រើន និង ពេល ខ្លះ បាន តិច ដែល ពេល ខ្លះ អាច បូម បានជាង ២ពាន់ បារ៉ែល ក្នុង ១ ថ្ងៃ ហើយ ថ្ងៃ ខ្លះ វា អាច បាន ជិត ៣ម៉ឺន បារ៉ែល ក្នុង ១ ថ្ងៃ ប៉ុន្តែ ជា មធ្យម ភាគ ប្រចាំ ឆ្នាំ ខ្ទង់ ក្នុង រង្វង់ ៧ ពាន់ បារ៉ែល ក្នុង ១ ថ្ងៃ ។
តំបន់ ប្លុក A របស់ កម្ពុជា គ្របដណ្តប់ លើ ផ្ទៃដី ទំហំ ៣.០៨៣ គីឡូម៉ែត្រ ការេ នៃ អាង សមុទ្រ ខ្មែរ ដែល ស្ថិត ក្នុង ឈូត សមុទ្រ ថៃ ជា តំបន់ មាន ជម្រៅ ចន្លោះ ពី ៥០ ទៅ ៨០ ម៉ែត្រ ៕
គួរ បញ្ជាក់ ថា នេះ គឺជា ការបាត់បង់ ពានរង្វាន់ កិត្តិយស ផ្នែក សិទ្ធិ មនុស្ស ចុងក្រោយ បំផុត មួយ ជ័យលាភី ពានរង្វាន់ ណូប៊ែល សន្តិភាព វ័យ ៧៣ ឆ្នាំ លោកស្រី អោង សាន ស៊ូជី បន្ទាប់ពី សភា កាណាដា សម្រេចចិត្ត ដក សញ្ជាតិ កិត្ត យស ពី លោកស្រី កាលពី ខែតុលា កន្លងទៅ ៕ អ្នកធ្វើដំណើរ តាម ដងផ្លូវ គួរ ប្រុងប្រយ័ត្ន រឿង ចោរ ឆក់ កាបូប !
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ព្រលឹម ស្រាង ៗ ថ្ងែ ទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ សមត្ថកិច្ច ខណ្ឌ ៧មករា បាន បញ្ចេញ កំលាំង របស់ ខ្លួន ប្រដេញ តាម ចាប់ មុខ សញ្ញា ចោរ ឆក់ តាម ផ្លូវ ក្នុង ភូមិសាស្ត្រ ទឹកដី ខណ្ឌ ដើម្បី បង្ការ ទប់ស្កាត់ បទល្មើស ឆក់ ដែល កើត ស្ទើរ រាល់ ថ្ងៃ ហើយ នាំឱ្យ ពលរដ្ឋ មាន ការព្រួយបារម្ភ ។
នៅ ព្រឹក ថ្ងៃ នេះ ផងដែរ សមត្ថកិច្ច បាន ឃាត់ខ្លួន បុរស ម្នាក់ មក ធ្វើ ការសាកសួរ ដោយ មាន ការសង្ស័យ ជា មុខសញ្ញា ដែល ទើប ចេញ ពី គុក ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ៦៖០៥ នាទី ព្រឹក ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ មាន ស្ត្រី ម្នាក់ ជិះ ម៉ូតូ ឌុប ក្នុង គោលបំណង ទៅ ជិះ រថយន្តក្រុង ទៅ ខេត្ត ក្រចេះ ស្រាប់តែ មកដល់ មុខ វិមាន សន្តិភាព ក៏ មាន ជនសង្ស័យ ម្នាក់ ជិះ ម៉ូតូ មក ពីក្រោយ ធ្វើ សកម្មភាព ឆក់ កាបូប បាន សម្រេច គេច ខ្លួន បាត់ ទាំង ព្រលឹម ។
ក្រោយ កើត ហេតុ ស្ត្រី រងគ្រោះ ត្រូវបាន លោក នាយ ប៉ុស្តិ៍ សង្កាត់ មិត្តភាព ឌុប ទៅ ប៉ុស្តិ៍ នគរបាល មិត្តភាព ដាក់ពាក្យបណ្ដឹង ដើម្បីឲ្យ សមត្ថកិច្ច ធ្វើ ការស្រាវជ្រាវ និង វែក មុខ រក ជនសង្ស័យ យកមក ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ ៕ អ្នកវិភាគ ចៅ ចាក់ ស្មុក៖ សេណារី យោរ សម្ងាត់ របស់ សម រង្ស៊ី សម្លាប់ ជីវិត នយោបាយ កឹម សុខា
( ភ្នំពេញ ) ៖ ការបែកធ្លាយ ផែនការ របស់ ហូរ វ៉ាន់ អតីត តំណាងរាស្ត្រ ខ្មោច បក្ស សង្គ្រោះ ជាតិ ដែល កំពុង រត់គេចខ្លួន នៅ ក្រៅ ប្រទេស អំពាវនាវ ឱ្យ អ្នកគាំទ្រ របស់ ខ្លួន ទៅ ប្រមូលផ្តុំ នៅមុខ ផ្ទះ របស់ កឹម សុខា ជារៀងរាល់ ថ្ងៃ ចាប់ពី ម៉ោង ៥ ដល់ ម៉ោង ៧ល្ងាច ត្រូវបាន គេ មើលឃើញ ថា ជា ការរៀបចំ ផែនការជា ប្រព័ន្ធ ដើម្បី សម្លាប់ នយោបាយ កឹម សុខា បន្ថែម ពីលើ ទម្ងន់ នៃ បទល្មើស ក្បត់ ជាតិ ដែល ជនជាប់ចោទ រូប នេះ កំពុង ប្រឈម ផ្លូវ ច្បាប់ ចំពោះ មុខ តុលាការ ។
ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចូលរួម ប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នៅ សិង្ហបុរី រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៣ - ១៥ វិច្ឆិកា
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ទៅ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ដែល នឹង ប្រព្រឹត្តទៅ ក្រោម មូល បទ « ភាពរឹងមាំ និង ន វានុវត្តន៍ របស់ អាស៊ាន » ។ កិច្ចប្រជុំ នេះ នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃទី ១៣ ដល់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ ប្រទេស សិង្ហបុរី ។
នៅក្នុង ប្រទេស សិង្ហបុរី នេះ ក្រៅពី ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ចូលរួម កិច្ចប្រជុំ ពាក់ព័ន្ធ ជាច្រើន ផ្សេង ទៀត ដូច ជា៖
* កិច្ចប្រជុំ កំពូល ក្រៅ ផ្លូវការ អាស៊ាន - អូស្រ្តាលី អម ដោយ អាហារ ពេលព្រឹក ។
* កិច្ចប្រជុំ កំពូល ក្រៅ ផ្លូវការ អាស៊ាន - ឥណ្ឌា អម ដោយ អាហារ ពេលព្រឹក ។
* កិច្ចប្រជុំ ថ្នាក់ដឹកនាំ នៃ ភាពជាដៃគូ សេដ្ឋកិច្ច ទូលំទូលាយ ក្នុង តំបន់ លើក ទី២ ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដដែល គណៈប្រតិភូ ដែល អញ្ជើញ អម ដំណើរ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី រួម មាន៖ លោក ប្រាក់ សុខុន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ . លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ពាណិជ្ជកម្ម . លោក ហង់ ជួន ណារ៉ុន រដ្ឋមន្រ្តី អប់រំ យុវជន និង កីឡា ព្រមទាំង ឥស្សរជន ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល និង ថ្នាក់ដឹកនាំ ធុរកិច្ច នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា ផងដែរ ។
ស្រប ពេល អញ្ជើញ ចូលរួម កិច្ចប្រជុំ កំពូល នេះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី នឹង អញ្ជើញ ចូលរួម ក្នុង ប្រជុំ និង កម្មវិធី មួយចំនួន ដូច ខាងក្រោម៖
* កិច្ចប្រជុំ ជាមួយ ក្រុមប្រឹក្សា ពិគ្រោះយោបល់ ធុរកិច្ច អាស៊ាន ។
* កម្មវិធី អាហារ ការងារ ថ្ងៃត្រង់ រៀបចំ ដោយ លោក លី សៀន ឡុង សម្រាប់ ថ្នាក់ដឹកនាំ អាស៊ាន ។
ក្នុង អំឡុង ពេល ស្នាក់ នៅ ប្រទេស សិង្ហបុរី សម្តេច តេជោ ហ៊ុន សែន ក៏ នឹង មាន ជំនួប ទ្វេ ភាគី ជាមួយ ប្រមុខ គណៈប្រតិភូ នៃ ប្រទេស មួយចំនួន ផងដែរ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ គ្រោះ ភ្លើង ឆេះ ព្រៃ ធំ ៗ កំពុង បន្ត វាយលុក រដ្ឋ កាលីហ្វរញ៉ា ផ្តាច់ ជីវិត មនុស្ស កើន ដល់ ៣១ នាក់ ។
៥៖ ទីបំផុត កូរ៉េ ទាំង ពីរ ចាប់ផ្តើម រំលាយ ចោល ប៉ុស្តិ៍ យាម ល្បាត តាម ព្រំដែន ដើម្បី បង្ហាញ ថា ទំនាក់ទំនង រវាង គ្នា កាន់តែ ល្អ ប្រសើរ ។
៧៖ ប៉ូឡូញ ប្រារព្ធ បុណ្យ ឯករាជ្យ ជាតិ លើក ទី១០០ ។ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង រដ្ឋលេខាធិការ និង អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង ពាណិជ្ជកម្ម ចំនួន ១៣រូប បន្ថែម ទៀត
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ឥស្សរជន ១៣រូប ជា រដ្ឋលេខាធិការ និង អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង ពាណិជ្ជកម្ម ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទើប ទទួលបាន នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា នេះ ៕
រដ្ឋមន្ត្រី ទេសចរណ៍ ប្រកាស ក្រុម ជំនាញ ទាំង៥ ដើម្បី ជួយ ដល់ ការគ្រប់គ្រង និង អភិវឌ្ឍន៍ ទេសចរណ៍ ក្រុង ព្រះសីហនុ កោះ រ៉ុង និង កោះ រ៉ុង សន្លឹម
( ព្រះសីហនុ) ៖ ដើម្បី ពង្រឹង ការគ្រប់គ្រង និង អភិវឌ្ឍន៍ ឧស្សាហកម្ម ទេសចរណ៍ ក្រុង ព្រះសីហនុ កោះ រ៉ុង និង កោះ រ៉ុង សន្លឹម នៅ ខេត្ត ព្រះសីហនុ លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន ប្រកាស សមាសភាព ក្រុមការងារ ទាំង ៥ក្រុម ក្នុង ពិធី ផ្សព្វផ្សាយ ប្រកាស ស្ដីពី « ការបង្កើត ក្រុមការងារ ជំនាញ ដើម្បី ជួយ ពង្រឹង ការគ្រប់គ្រង និង អភិវឌ្ឍន៍ ខេត្ត ព្រះសីហនុ» ដែល ធ្វើឡើង នៅ សណ្ឋាគារ ឆ្នេរ ឯករាជ្យ ខេត្ត ព្រះសីហនុ នា ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
លោក រដ្ឋមន្ត្រី បាន ប្ដេជ្ញា ថា រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង ទេសចរណ៍ នឹង ខិតខំ ធ្វើឱ្យ គោលដៅ ទេសចរណ៍ ដ៏ សំខាន់ មួយ នេះ មួយ នេះ មាន សេវាកម្ម ប្រកបដោយ គុណភាព អនាម័យ និង ភាពទាក់ទាញ ពោលគឺ ក្រសួង នៅតែ ខិតខំ សហការ គ្នា ជាមួយ ផ្នែក ពាក់ព័ន្ធ និង ផ្នែក ឯកជនជា ដៃគូរ ដើម្បី កែលម្អ ការខ្វះខាត និង ខិតខំ ប្រឹង អភិវឌ្ឍន៍ បន្ត ទៅ មុខ ទៀត ប៉ុន្តែ ត្រូវ មាន ការចូលរួម ពីសំណាក់ រដ្ឋបាល ខេត្ត ស្ថាប័ន ពាក់ព័ន្ធ ផ្នែក ឯកជន និង ប្រជាពលរដ្ឋ ជា ចាំបាច់ ផងដែរ ។
លោក រដ្ឋមន្ត្រី បាន ណែនាំ ឱ្យ រដ្ឋបាល ខេត្ត ព្រះសីហនុ ត្រូវ បង្កើត សាខា សមាគម សណ្ឋាគារ សាខា សមាគម ភោជនីយដ្ឋាន សាខា សមាគម ឧស្សាហកម្ម ទេសចរណ៍ នានា ដើម្បី ងាយស្រួល ក្នុង ការគ្រប់គ្រង ការណែនាំ នូវ ការងារ ពាក់ព័ន្ធ នានា ពិសេស ការងារ ពង្រឹង គុណភាព សេវាកម្ម ព្រមទាំង ការអុវត្ត ច្បាប់ នានា ឱ្យ មាន ប្រសិទ្ធភាព ។
អភិបាល ខេត្ត ព្រះសីហនុ លោក យន្ត មីន បាន បញ្ជាក់ នូវ ការ ឯកភាព ទទួលយក អនុសាសន៍ និង ការចង្អុលបង្ហាញ របស់ លោក រដ្ឋមន្ត្រី ថោង ខុន ទៅ អនុវត្ត ឱ្យ បាន ល្អ ប្រសើរ ដើម្បី បម្រើ ដល់ ការងារ អភិវឌ្ឍ ន័ វិស័យ ទេសចរណ៍ នៅក្នុង ខេត្ត ព្រះសីហនុ និង ទទូច ឱ្យ មន្ទីរ - អង្គភាព ជុំវិញ ខេត្ត ត្រូវ រួម សហការ គ្នា ដោះស្រាយ បញ្ហា ពាក់ព័ន្ធ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
លោក អភិបាល ខេត្ត បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ និង ម្ចាស់ មូលដ្ឋាន អាជីវកម្ម នានា សូម ចូលរួម សហការ អនុវត្ត នីតិវិធី លិខិត បទដ្ឋាន គតិយុត្ត ក៏ ដូចជា បទបញ្ជា នានា ក្នុង ការប្រកប អាជីវកម្ម របស់ ខ្លួន ដើម្បី រួមគ្នា អភិវឌ្ឍ ខេត្ត ព្រះសីហនុ ឱ្យ កាន់តែ មាន ភាពទាក់ទាញ ៕ ទឹកប្រាក់ ៧០ លាន រៀល ត្រូវបាន ប្រគល់ ជូន កម្ម ការិនី រោងចក្រ ដែល ឈ្នះ រង្វាន់ ពី ភេសជ្ជៈ ប៉ូវ កម្លាំង ខារ៉ា បាវ
( ភ្នំពេញ ) ៖ ទឹកប្រាក់ ៧០ លាន រៀល ត្រូវបាន ប្រគល់ ជូន កម្ម ការិនី រោងចក្រ ម្នាក់ ឈ្មោះ នួន សុភី អាយុ ៣៦ ឆ្នាំ មាន ស្រុក កំណើត ស្ថិត ក្នុង ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ ដែល បច្ចុប្បន្ន បម្រើ ការងារ នៅ រោងចក្រ កាត់ដេរ ស្ថិត ក្នុង សង្កាត់ ចោម ចៅ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ថ្លែង ប្រាប់ ក្រុមការងារ ដែល ចុះ ប្រគល់ រង្វាន់ ដល់ លំនៅឋាន កញ្ញា នួន សុភី ឱ្យដឹង ថា នៅ យប់ ថ្ងៃទី 0៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ កន្លងទៅ ខណៈពេល ដែល បម្រើ ការងារ វេន យប់ កញ្ញា បាន ទិញ ភេសជ្ជៈ ប៉ូវ កម្លាំង ខារ៉ា បាវ មួយ កំប៉ុង មក ទទួលទាន ដើម្បី កុំ ឲ្យ ងងុយ គេង លុះ ស្រាប់តែ ពេល គាស់ ក្រវិល កំប៉ុង ក៏ ឃើញ រង្វាន់ ៧០ លាន រៀល នៅនឹង ក្រវិល កំប៉ុង តែម្ដង ។
កញ្ញា បន្ដ ទៀត ថា « ខ្ញុំ ពិតជា រំភើប រីករាយ ជាខ្លាំង បន្ទាប់ពី ឃើញ ក្រវិល កំប៉ុង ឈ្នះ រង្វាន់ ៧០ លាន រៀល នេះ ។ បន្ទាប់ពី ឃើញ បែប នេះ ខ្ញុំ ក៏ យក ក្រវិល កំប៉ុង នេះ ទៅ បង្ហាញ អ្នកលក់ ដែល នៅជិត គ្នា ហើយ អ្នកលក់ ក៏ ទូរស័ព្ទ ប្រាប់ ដំណឹង នេះ ដល់ ក្រុមហ៊ុន តាមរយៈ លេខ ទូរស័ព្ទ នៅ ក្រវិល កំប៉ុង » ។
កញ្ញា បញ្ជាក់ ថា រង្វាន់ ៧០ លាន រៀល នេះ កញ្ញា នឹង យក មួយចំនួន ទៅ បង្កើត មុខរបរ នៅ ផ្ទះ ដើម្បី ផ្គត់ផ្គង់ ជីវភាព គ្រួសារ នៅ ថ្ងៃ អនាគត ។
អង្គការ មូលនិធិ បង្ការ របួស អាស៊ី ចែក មួក សុវត្ថិភាព ជាង ១០០០ មួក សម្រាប់ ក្រុមគ្រួសារ ជួយ ការពារ កុមារ នៅ ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ)៖ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ដោយ មាន ការគាំទ្រ របស់ ក្រុមហ៊ុន មេនូឡាយ ហ្វ៍ (Manulife) នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ចែកជូន ជាមួក សុវត្ថិភាព ចំនួន ជាង ១.០០០ មួក ដល់ សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ មាតាបិតា អាណាព្យាបាល សិស្ស នៃ សាលា បឋមសិក្សា ហ៊ុន សែន ក្រុង ដែល មាន ទីតាំង ស្ថិត នៅក្នុង ក្រុង ព្រះសីហនុ ។
ជាមួយគ្នា នេះ មាតា បិតា អាណាព្យាបាល សិស្ស ជាង ១០០ នាក់ នឹង ចូលរួម ក្នុង សិក្ខាសាលា បណ្តុះបណ្តាល ជា បន្តបន្ទាប់ ដើម្បី លើកកម្ពស់ ការពាក់ មួក សុវត្ថិភាព ដែល កម្មវិធី មួក សុវត្ថិភាព សម្រាប់ ក្រុមគ្រួសារ បាន ផ្តោត លើ ការចូលរួមចំណែក របស់ មាតាបិតា អាណាព្យាបាល សិស្ស ជាពិសេស អ្នកម្តាយ ដែល ជា បុគ្គល គំរូ ដល់ កូន ៗ ជា កុមារ ក្នុង ការពាក់ មួក សុវត្ថិភាព ។
កម្មវិធី នេះ មាន ការចូលរួម ពី លោកស្រី មឹន មាណ វី រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ជា អគ្គ លេខាធិការ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក . អភិបាល រង ខេត្ត ព្រះសីហនុ និង អ្នក ពាក់ព័ន្ធ ផ្នែក សុវត្ថិភាព ចរាចរណ៍ ដៃគូ អភិវឌ្ឍន៍ វិស័យ ឯកជន មាតាបិតា អាណាព្យាបាល សិស្ស សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ បុគ្គលិក និង ក្រុមការងារ រដ្ឋបាល នៃ សាលា បឋមសិក្សា ហ៊ុន សែន ក្រុង បុគ្គលិក នៃ ក្រុមហ៊ុន មេនូឡាយ ហ្វ៍ ខេមបូឌា និង បុគ្គលិក នៃ មូលនិធិ បង្ការ របួស អាស៊ី ។
លោកស្រី មឹន មាណ វី រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ជា អគ្គ លេខាធិការ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក បាន បញ្ជាក់ ថា ដោយ មាន ការផ្សារ ភ្ជាប់គ្នា ជា វិជ្ជមាន រវាង ចំណេះដឹង របស់ មាតា បិតា អំពី ការពាក់ មួក សុវត្ថិភាព ឲ្យបាន ត្រឹមត្រូវ និង ចំណេះដឹង របស់ កុមារ អំពី ការពាក់ មួក សុវត្ថិភាព ឲ្យបាន ត្រឹមត្រូវ ។
លោកស្រី មឹន ម៉ាណវី បាន បន្ថែម ថា រាជ រដ្ឋាភិបាល ពិតជា មាន ការគាំទ្រ រាល់ កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី លើកកម្ពស់ ការយល់ដឹង អំពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ជាពិសេស ការពាក់ មួក សុវត្ថិភាព ក្នុង ចំណោម សិស្សានុសិស្ស សំដៅ កាត់បន្ថយ និង បង្កា ការស្លាប់ និង ការរង របួស ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ ។
ស្រដៀង គ្នា នេះ លោក គឹម បញ្ញា នាយក អង្គការ មូលនិធិ បង្ការ របួស អាស៊ី ប្រចាំ កម្ពុជា បាន បញ្ជាក់ ថា សាលា បឋមសិក្សា ហ៊ុន សែន ក្រុង ព្រះសីហនុ ត្រូវបាន ជ្រើសរើស មក អនុវត្ត កម្មវិធី ដោយសារតែ ទីតាំង ជា តំបន់ ដែល មាន ការប្រឈម នឹង គ្រោះថ្នាក់ ចរាចរណ៍ ខ្ពស់ ហើយ សិស្សានុសិស្ស ត្រូវ ធ្វើដំណើរ ទៅ មក សាលារៀន តាម ផ្លូវ ដែល មាន ចរាចរណ៍ មមាញឹក នៅក្នុង ខេត្ដ ខណៈ សិស្សានុសិស្ស របស់ សាលារៀន នេះ ប្រមាណ ៩០ ភាគរយ ធ្វើដំណើរ ទៅ មក ដោយ ជិះ កង់ ឬ តាម ម៉ូតូ ជាមួយ អាណាព្យាបាល ។
លោក បាន បញ្ជាក់ ទៀត ថា កាលពី ឆ្នាំ កន្លងមក នេះ មាន សិស្ស ម្នាក់ បាន ស្លាប់ បាត់បង់ជីវិត ហើយ យ៉ាងហោចណាស់ មាន សិស្សានុសិស្ស និង លោកគ្រូ អ្នកគ្រូ ចំនួន ប្រាំពីរ នាក់ ទទួល រងគ្រោះ ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ ហើយ កម្មវិធី មួក សុវត្ថិភាព សម្រាប់ គ្រួសារ នឹង ផ្តល់ នូវ មួក សុវត្ថិភាព ដែល មាន គុណភាព និង ការបណ្តុះបណ្តាល សុវត្ថិភាព ចរាចរណ៍ ដល់ សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ និង មាតាបិតា អាណាព្យាសិស្ស ដែល រស់ នៅក្នុង សហគមន៍ ដែល ងាយ រងគ្រោះ ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ ។
សូម ជម្រាប ថា កម្មវិធី មួក សុវត្ថិភាព សម្រាប់ គ្រួសារ នឹង ត្រូវបាន អនុវត្ត នៅ ខេត្ត ព្រះសីហនុ ពេញ មួយ ឆ្នាំ សិក្សា ២០១៨ ដល់ ឆ្នាំ ២០១៩ ៕
អភិបាល ខណ្ឌ ឫស្សីកែវ ដាស់តឿន មន្ត្រី ឲ្យ ត្រៀម ការពារ សន្តិសុខ ជូន ពលរដ្ឋ ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ខាងមុខ
សម្ដេច តេជោ ហ៊ុន សែន អញ្ជើញ ដល់ ប្រទេស សិង្ហបុរី ហើយ
( សិង្ហបុរី ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដឹកនាំ គណៈប្រតិភូ អញ្ជើញ ដល់ ប្រទេស សិង្ហបុរី ហើយ នៅ ម៉ោង ១០៖ ៥៥នាទី ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ប្រកបដោយ សុខ សុវត្ថិភាព ។
សូម បញ្ជាក់ ថា សម្ដេច តេជោ ហ៊ុន សែន បាន អញ្ជើញ ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ កម្ពុជា អញ្ជើញ ទៅ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ មួយ ចំនួន ទៀត នៅ ម៉ោង ប្រមាណ ៨ព្រឹក មិញ នេះ ។
កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ដទៃ ទៀត នឹង ប្រព្រឹត្តទៅ ក្រោម មូល បទ « ភាពរឹងមាំ និង ន វានុវត្តន៍ របស់ អាស៊ាន » ។
គណៈប្រតិភូ ដែល អញ្ជើញ អម ដំណើរ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី រួម មាន៖ លោក ប្រាក់ សុខុន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ . លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ពាណិជ្ជកម្ម . លោក ហង់ ជួន ណារ៉ុន រដ្ឋមន្រ្តី អប់រំ យុវជន និង កីឡា ព្រមទាំង ឥស្សរជន ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល និង ថ្នាក់ដឹកនាំ ធុរកិច្ច នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា ផងដែរ ។
ក្នុង អំឡុង ពេល ស្នាក់ នៅ ប្រទេស សិង្ហបុរី សម្តេច តេជោ ហ៊ុន សែន ក៏ នឹង មាន ជំនួប ទ្វេ ភាគី ជាមួយ ប្រមុខ គណៈប្រតិភូ នៃ ប្រទេស មួយចំនួន ផងដែរ ៕ ស្រូវ របស់ កសិករ នៅ ខេត្ត កំពង់ចាម ដែល ជួប គ្រោះ រាំងស្ងួត៦ ពាន់ ហិកតា ត្រូវបាន សង្គ្រោះ . នៅសល់ ជាង ១ម៉ឺន ហិកតា ទៀត កំពុង បន្ត អន្តរាគមន៍
( កំពង់ចាម ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត កំពង់ចាម បាន បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ អាជ្ញាធរ ខេត្ត បាន ជួយសង្គ្រោះ ស្រូវ របស់ ប្រជាកសិករ ដែល ជួប បញ្ហា គ្រោះ រាំងស្ងួត បាន ចំនួន ៦.០០០ ហិកតា គិត មកដល់ ថ្ងៃ នេះ និង នៅសល់ ចំនួន ១២.០០០ ហិកតា ទៀត អាជ្ញាធរ ខេត្ត កំពុង ខ្នះ ខ្នែង ជួយសង្គ្រោះ បន្ត ទៀត ។
ការបញ្ជាក់ របស់ លោក គួច ចំរើន បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅក្នុង ឱកាស ដែល លោក ចុះ ជួប សំណេះសំណាល ជាមួយ តំណាង គណៈកម្មការ ទូក «ង » ចំនួន ៤០ ទូក មកពី ៦ស្រុក - ក្រុង ក្នុង ខេត្ត កំពង់ចាម ។
លោក អភិបាល ខេត្ត បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « ដំណាំ ស្រូវ របស់ ប្រជាកសិករ ក្នុង ខេត្ត កំពង់ចាម ដែល កំពុង ទទួល នូវ ការ គម្រាមគំហែង ដោយ គ្រោះ រាំងស្ងួត មាន ចំនួន ១៨.០០០ ហិកតា បើ គិត មក ត្រឹម ល្ងាច ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ប៉ុន្តែ ក្នុង នោះ អាជ្ញាធរ ខេត្ត បាន ធ្វើ ការជួយ បូម ទឹក សង្គ្រោះ បាន ចំនួន ៦.០០០ ហិកតា ហើយ ដោយឡែក នៅសល់ ១២.០០០ ហិកតា ទៀត ដែល អាជ្ញាធរ ខេត្ត រួម ជាមួយ មន្ត្រី ជំនាញ កំពុងតែ ធ្វើ ការជួយ បន្ត ទៀត » ។
ជាមួយគ្នា នេះ ដែរ លោក អភិបាល ខេត្ត បាន បន្ត ថា ជា ការពិត ណាស់ ថា បងប្អូន ដែល រស់ នៅ ជាប់ ដង ទន្លេ នោះ មិន សូវ មាន បញ្ហា ជួប គ្រោះ រាំងស្ងួត នោះ ទេ ។ ប៉ុន្តែ ប្រជាកសិករ ដែល រស់ នៅ ឆ្ងាយ ពី ដង ទន្លេ កំពុងតែ ជួប បញ្ហា ខ្វះ ទឹក បូម ដាក់ ស្រែ ស្ទើ តែ ប្រែក្លាយជា សង្គ្រាម ដណ្តើម ទឹក ទៅ ហើយ ដោយសារតែ ការផ្តល់ ទឹក មិន ទាន់ គ្រប់គ្រាន់ ទៅ តាម សេចក្តីត្រូវការ របស់ ពួកគាត់ ។
លោក គួច ចំរើន ក៏ បាន ជំរុញ ឱ្យ អាជ្ញាធរ ខេត្ត ខិតខំ ប្រឹងប្រែង ក្នុង ការផ្តល់ ទឹក ជូន ប្រជាកសិករ ឱ្យ បាន គ្រប់គ្រាន់ ដោយ ហេតុ ថា នៅ តំបន់ ខ្លះ គ្មាន ប្រភព ទឹក គ្រប់គ្រាន់ និង តំបន់ ខ្លះ ប្រភព ទឹក នៅ ឆ្ងាយ និង ប្រឡាយ ខ្លះ ជា ប្រឡាយ ចាស់ ដែល ប្រការ ទាំង នេះ ធ្វើឱ្យ មាន ការលំបាក ក្នុង ការផ្តល់ ទឹក ឱ្យ គ្រប់គ្រាន់ ទៅ តាម សេចក្តីត្រូវការ របស់ ប្រជាកសិករ យើង ។
ប៉ុន្តែ បើ ទោះ ជា យ៉ាង នេះ ក្តី អាជ្ញាធរ ខេត្ត នៅតែ ខិតខំ ប្រឹងប្រែង ឱ្យ អស់ ពី សមត្ថភាព ក្នុង ការជួយ រក ទឹក បូមបញ្ចូល ស្រែ របស់ ប្រជាកសិករ យើង បើ ទោះជា ជួប នូវ ការលំបាក យ៉ាងណា ក៏ដោយ ព្រោះ យ៉ាងហោចណាស់ ក៏ អាច ឱ្យ ប្រជាកសិករ យើង ទទួល ផល បាន ខ្លះ ជាពិសេស មិន អាច បណ្តោយ ទុក ឱ្យ ស្រូវ របស់ ពួកគាត់ ខូចខាត ទាំងស្រុង នោះ ទេ ៕
( ភ្នំពេញ ) ៖ កម្ម ការិនី រោងចក្រ ហ្គ្រីន មីដូវ ឌីវេឡុប មេន បាន បន្ដ ដួល សន្លប់ សារជាថ្មី ចំនួន ៣០ នាក់ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ហើយ ភ្លាម ៗ ក្រុម អង្គភាព ៧១១ កងពល តូច ថ្មើរជើង លេខ ៧០ បាន ចេញ អន្ដរាគមន៍ ដើម្បី ជួយសង្គ្រោះ ។ ទីតាំង រោងចក្រ នេះ ស្ថិត ក្នុង ភូមិ ត្រា ដោក សង្កាត់ ពង ទឹក ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ១២ ខែវិច្ឆិកា ម្សិលមិញ កម្មករ - កម្ម ការិនី រោងចក្រ កាត់ដេរ មួយ នេះ ជិត ៥០ នាក់ បាន ដួល សន្លប់ ជា បន្តបន្ទាប់ និង ត្រូវបាន រថយន្ត សង្រ្គោះ របស់ អង្គភាព ៧១១ កងពល តូច លេខ ៧០ ព្រមទាំង រថយន្ត មណ្ឌល សុខភាព ដឹក យក ទៅ សង្គ្រោះ តាម មន្ទីរពេទ្យ នា ៗ ដើម្បី ជួយសង្គ្រោះ ផងដែរ ។
មូលហេតុ ដែល ផ្តើម ឱ្យ កម្មករ ដួល សន្លប់ ជា បន្តបន្ទាប់ នេះ គឺ ដោយសារ បុរស ជា ជនជាតិ ខ្មែរ ហើយ ត្រូវ ជា អ្នកបកប្រែ ឲ្យ ថៅ កែ រោងចក្រ បាន ប្រើ សម្តី ខ្លាំង ៗ ស្រែក ដាក់ ទៅ ក្រុម កម្មករ - កម្ម ការិនី ជា ហេតុ ធ្វើឲ្យ កម្មការ នីម្នាក់ ដួក សន្លប់ ភ្លាម ៗ ។ បន្ទាប់មក បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល ឆោឡោ ពេញ រោងចក្រ បណ្តាល កម្មករ - កម្មការ នី ជាច្រើន នាក់ ទៀត មាន អាការៈ ទន់ ដៃ ជើង សន្លប់ បន្ត បន្ទាប់ រហូត ដល់ ទៅ ជិត ៥០ នាក់ ក្នុង ចំណោម កម្មករ សរុប ១. ២២៨ នាក់ ៕
សូម បញ្ជាក់ ថា គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន បើក កិច្ចប្រជុំ ពិភាក្សា លើ របៀបវារៈសំខាន់ ៗ មួយចំនួន មុននឹង ដាក់បញ្ចូល ក្នុង សម័យ ប្រជុំ ពេញ អង្គ រដ្ឋសភា នៅពេល ខាងមុខ នេះ ។ កិច្ចប្រជុំ បាន លើក យក របៀបវារៈ មួយចំនួន ដូច ជា៖
ទី៣៖ ការពិភាក្សា និង អនុម័ត សេចក្ដីព្រាង ច្បាប់ ស្ដីពី ការអនុម័ត យល់ព្រម លើ * កិច្ចព្រមព្រៀង រវាង រាជ រដ្ឋាភិបាល នៃ កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ស្ដីពី ការចៀសវាង ការយក ពន្ធ ត្រួត គ្នា និង ការបង្ការ ការកិបកេងបន្លំ ពន្ធ ពាក់ព័ន្ធ នឹង ពន្ធ លើ ប្រាក់ ចំណូល * កិច្ចព្រមព្រៀង រវាង រាជ រដ្ឋាភិបាល នៃ កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី ស្ដីពី ការចៀសវាង ការយក ពន្ធ ត្រួត គ្នា និង ការបង្ការ ការកិបកេងបន្លំ ពន្ធ ពាក់ព័ន្ធ នឹង ពន្ធ លើ ប្រាក់ ចំណូល ។
ទី៤៖ ការពិភាក្សា និង អនុម័ត លើ សេចក្ដីព្រាង ច្បាប់ ស្ដីពី ការអនុម័ត យល់ព្រម លើ សន្ធិសញ្ញា ស្ដីពី បត្យាប័ន រវាង កម្ពុជា និង សហព័ន្ធ រុស្ស៊ី ៕
សិស្ស ពូកែ សាលា បឋមសិក្សា ព្រះសីហនុ នៅ ក្រុង ស្វាយរៀង ទទួលបាន រង្វាន់ លើកទឹកចិត្ត ពី គណៈ គ្រប់គ្រង សាលា
( ស្វាយរៀង ) ៖ ដើម្បី ជា ការលើកទឹកចិត្ត ដល់ ប្អូន ៗ ក្មួយ ៗ សិស្សានុសិស្ស ដែល រៀន ពូកែ ទទួលបាន ចំណាត់ថ្នាក់ ល្អ ( ពី លេខ ១ដល់ លេខ ៣ ) សំរាប់ ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ នេះ ដើម្បីឱ្យ មាន ការខិតខំ ប្រឹងប្រែង បន្ត ទៀត នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ លោកស្រី ទុំ ទីណា នាយិកា សាលា បឋមសិក្សា ព្រះសីហនុ បាន រៀបចំ ពិធី ប្រគល់ រង្វាន់ ដល់ សិស្ស ពូកែ ចំនួន ៦០ នាក់ ក្នុង នោះ មាន ស្រី ចំនួន ៣១ នាក់ ។
ពិធី នេះ ដែរ ក៏ មាន ការចូលរួម ពីសំណាក់ លោកគ្រូ អ្នកគ្រូ រួមទាំង សិស្សានុសិស្ស ជាច្រើន ផងដែរ នៅក្នុង សាលា បឋមសិក្សា ព្រះសីហនុ ស្ថិត នៅក្នុង ភូមិ មេភ្លើង សង្កាត់ ស្វាយរៀង ក្រុង ស្វាយរៀង ខេត្ត ស្វាយរៀង ។
លោកស្រី ទុំ ទីណា បាន ថ្លែង ថា សំរាប់ ឆ្នាំ សិក្សា ២០១៨ - ២០១៩នេះ សាលា បឋមសិក្សា ព្រះសីហនុ មាន សិស្ស សរុប ចំនួន ៨៤៥ នាក់ ក្នុង នោះ សិស្ស ស្រី ចំនួន ៤១០ នាក់ ចាប់ពី ថ្នាក់ ទី១ដល់ ថ្នាក់ ទី៦ ដោយ មិន ទាន់ រាប់បញ្ចូល សិស្ស មត្តេយ្យ សិក្សា នៅឡើយ ហើយ មាន បុគ្គលិក សិក្សា ចំនួន ៤២ នាក់ ស្រី ចំនួន ២៨ នាក់ ។
ក៏ប៉ុន្តែ ទន្ទឹម គ្នា ក្រុម មន្ត្រី ទាំង នេះ ក៏ បាន សង្កត់ធ្ងន់ ថា ការសម្រេចចិត្ត ដាក់ ឬ លើកលែង ទណ្ឌកម្ម លើ ទីក្រុង ញូដេលី ពីសំណាក់ សហរដ្ឋ អាមេរិក អាចនឹង ត្រូវ ធ្វើឡើង នៅ ពេល ដែល ឥណ្ឌា ចាប់ផ្ដើម បង់លុយ ទិញ S-400 ឱ្យ ទីក្រុង ម៉ូស្គូ ។
ពី ដំបូង ឡើយ រដ្ឋ កាលីហ្វរញ៉ា បាន ព្យាយាម ស្នើសុំ ជំនួយ ពី តំបន់ ដែល នៅក្បែរខាង ខ្លួន ប៉ុន្តែ ស្ថានភាព កាន់តែ អាក្រក់ ខ្លាំង នៃ ភ្លើង ឆេះ ព្រៃ ដ៏ មហា ប្រល័យ នេះ បាន បង្ខំ ឲ្យ អាជ្ញាធរ កាលីហ្វរញ៉ា ស្វែងរក ជំនួយ ពី ទីភ្នាក់ងារ ពន្លត់ អគ្គិភ័យ នៅ រដ្ឋ ឆ្ងាយ ៗ ថែម ទៀត រួម មាន អាឡាស្កា ជាដើម ។ មិន តែ ប៉ុណ្ណោះ ក្នុង ចំណោម ភ្នាក់ងារ អគ្គិភ័យ រាប់ ពាន់ នាក់ ដែល បាន ចូលរួម ប្រឹងប្រែង ពន្លត់ ភ្លើង ឆេះ ព្រៃ នេះ ក៏ មាន មួយចំនួន បាន ទទួលរង របួស ផងដែរ ។
តួលេខ មនុស្ស ស្លាប់ ខាងលើ នេះ បាន កើនឡើង ពី ២៩ នាក់ កាលពី ថ្ងៃចន្ទ ម្សិលមិញ នៅ ពេល ដែល អាជ្ញាធរ អាមេរិក បញ្ជាក់ ថា មាន មនុស្ស ចំនួន ២២៨ នាក់ បាន បាត់ខ្លួន គិត ចាប់តាំងតែពី ភ្លើង ឆេះ ព្រៃ Camp Fire បាន លេច រូបរាង ឡើង កាលពី ថ្ងៃព្រហស្បតិ៍ សប្តាហ៍ មុន ។ សម្រាប់ មនុស្ស ស្លាប់ ទាំង ៤២ នាក់ នេះ គឺជា ចំនួន ច្រើន បំផុត មិន ធ្លាប់ មាន នោះ ឡើយ ក្នុង ប្រវត្តិសាស្ត្រ នៃ គ្រោះមហន្តរាយ ភ្លើង ឆេះ ព្រៃ ក្នុង រដ្ឋ ដែល មាន សេដ្ឋកិច្ច លំដាប់ ទី ៥ នៅលើ ពិភពលោក មួយ នេះ ។
សាកលវិទ្យាល័យ អារីហ្សូណា បើក វេទិការ « ស្វែងយល់ ពី ការសិក្សា ការរើស មុខវិជ្ជា និង សញ្ញាបត្រ មកពី អាមេរិក »
សិស្ស និស្សិត និង អាណាព្យាបាល ដែល មាន បំណង ចូលរួម ស្តាប់ និង មាន ចម្ងល់ នានា ជុំវិញ ការសិក្សា ទាំង នៅ អាមេរិក និង នៅ កម្ពុជា អាច ចូលរួម ដោយ សេរី ។ សម្រាប់ ព័ត៌មាន បន្ថែម សូម ទាក់ទង មកកាន់ ទូរសព្ទ លេខ៖ ០២៣ ៩៩០ ០២៣ / ០១២ ២៦៦ ៦៣១ ៕ ព្រះរាជអាជ្ញា ខេត្ត កំពង់ចាម បញ្ជា កម្លាំង សមត្ថកិច្ច បន្ដ ចុះបង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ នៅ ស្រុក កង មាស
( កំពង់ចាម ) ៖ ក្រោយពី ទទួលបាន ព័ត៌មាន អំពី បទល្មើស នេសាទ ខុស ច្បាប់ និង មាន ការឯកភាព ពី លោក ហួត វុទ្ធី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត បាន ចាត់ កម្លាំង ចុះ សហការបង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ នៅ ស្រុក កង មាស ។
របាយការណ៍ បាន បញ្ជាក់ ថា ប្រតិបត្តិការ នេះ បាន ធ្វើឡើង ដោយ កម្លាំង នៃ អធិការដ្ឋាន នគរបាល ស្រុក កង មាស សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ស្តៅ និង កម្លាំង ជំនាញ ខណ្ឌ រដ្ឋបាល ជលផល ខេត្ត កំពង់ចាម ដឹកនាំ ដោយ លោក ខេង ម៉េង ឈុន អភិបាល រង ស្រុក កង មាស ដោយ មាន ការចង្អុលបង្ហាញ ពី លោក មឿន ផា អភិបាល ស្រុក កង មាស បាន ចុះបង្រ្កាប បទល្មើស នេសាទ ខុស ច្បាប់ នៅ ចំណុច បឹង ទាម លៀង ឃុំ កង តាណឹង និង បឹង B៦ ឃុំ ស្តៅ ស្រុក កង មាស ។
ជា លទ្ធផល កម្លាំង សមត្ថកិច្ច ដកហូត បាន លូស្បៃ មុង ចំនួន ៧៧ មាត់ . របាំង ស្បៃ មុង ប្រវែង២. ២២៥ម៉ែត្រ . បង្គោល ចម្រុះ ចំនួន ៨៣៥ ដើម និង ចាក់ លែង កូន ត្រី ចម្រុះ ចូល បឹង ធម្មជាតិ ចំនួន ៦៩៧ គីឡូក្រាម ។ ចំពោះ សម្ភារ វត្ថុតាង បាន សហការ ដុត និង កាប់បំផ្លាញ ចោល នៅនឹង កន្លែង ដោយ មាន ការឯកភាព ពី លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ចាម ៕ រដ្ឋសភា បើក កិច្ចប្រជុំ គណៈកម្មាធិការ អចិន្រ្តៃយ៍ ពិនិត្យមើល សេចក្តីព្រាង ច្បាប់ ថវិកា ជាតិ ឆ្នាំ ២០១៩ និង របៀបវារៈសំខាន់ ៗ មួយចំនួន
( ភ្នំពេញ )៖ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន បើក កិច្ចប្រជុំ ពិភាក្សា លើ របៀបវារៈសំខាន់ ៗ មួយចំនួន មុននឹង ដាក់បញ្ចូល ក្នុង សម័យ ប្រជុំ ពេញ អង្គ រដ្ឋសភា នៅពេល ខាងមុខ នេះ ។ កិច្ចប្រជុំ បាន ធ្វើឡើង នៅ វិមាន រដ្ឋសភា ក្រោម អធិបតីភាព សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា ដោយ មាន ការចូលរួម ពី សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា នានា ។
កិច្ចប្រជុំ បាន លើក យក របៀបវារៈ មួយចំនួន ដូច ជា៖
ទី ១៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០១៩ ។
ទី ២៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការទូទាត់ ថវិកា ទូទៅ របស់ រដ្ឋ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០១៧ ។ សេចក្តីព្រាង ច្បាប់ ស្តីពី កាត អនុម័ត យល់ព្រម ៖
* កិច្ចព្រមព្រៀង រវាង រដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ស្តីពី ការចៀសវាង ការយក ពន្ធ ត្រួត គ្នា និង ការបង ហការ កាកិបកេងបន្លំ ពន្ធ ពាក់ព័ន្ធ នឹង ពន្ធ លើ ប្រាក់ ចំណូល ។
* កិច្ចព្រមព្រៀង រវាង រាជ រដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ឥណ្ឌូនេស៊ី ស្តីពី ការចៀសវាង កាយក ពន្ធ ត្រួត គ្នា នឹង ការបង្កា ការកិបកេងបន្លំ ពន្ធ ពាក់ ពន្ធ នឹង ពន្ធ លើ ប្រាក់ ចំណូល ។
ទី ៣៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ សន្ធិសញ្ញា ស្តីបត្យាប័ន រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សហព័ន្ធ រុស្ស៊ី ៕
ចោរ ឆក់ ដែល ធាក់ ម៉ូតូ ផ្ដូល បណ្ដាលឲ្យ ជនរងគ្រោះ ម្នាក់ ស្លាប់ ចោល ប្រពន្ធ និង កូន ប្រឈម នឹង ការ ជាប់ គុក ពី ១៥ - ៣០ ឆ្នាំ
( ភ្នំពេញ ) ៖ ក្រុម ចោរ ឆក់ ២នាក់ ដែល បាន ធ្វើ សកម្មភាព ឆក់ និង ធាក់ ម៉ូតូ ជនរងគ្រោះ ឲ្យ ដួល បណ្ដាលឲ្យ ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុ ចោល ប្រពន្ធ និង កូន ២នាក់ ប្រឈម នឹង ការជាប់ ពន្ធនាគារ ពី ១៥ ទៅ៣០ ឆ្នាំ តាម បញ្ញត្ដិ មាត្រា ៣៦០ នៃ ក្រម ព្រហ្មទណ្ឌ ។
លោក កី ម៉ានេរ៉ា ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ចេញ ដីការបង្គាប់ឱ្យ ឃុំ ខ្លូន ក្រុម ចោរ ឆក់ ២នាក់ នៅ ពន្ធនាគារ រង់ចាំ កាត់ទោស នៅ ពេល ក្រោយ ។
ការសម្រេច របស់ លោក ចៅក្រម គឺ ធ្វើឡើង បន្ទាប់ពី តំណាង អយ្យការ លោក ស៊ិន វីរៈ បាន សម្រេច ចោទប្រកាន់ លើ ជន ត្រូវ ចោទ ទាំង ២នាក់ ពី បទ លួច មាន ស្ថាន ទម្ងន់ ទោស ដោយសារ មរណភាព ជនរងគ្រោះ តាម មាត្រា ៣៦០ នៃ ក្រម ព្រហ្មទណ្ឌ ។
មាត្រា ៣៦០ ស្ថាន ទម្ងន់ ទោស ដោយសារ មរណភាព នៃ ជនរងគ្រោះ បាន បញ្ជាក់ ថា « អំពើ លួច ត្រូវ ផ្ដន្ទាទោស ដាក់ ពន្ធនាគារ ពី ១៥ ( ដប់ ប្រាំ ) ឆ្នាំ ទៅ៣០ ( សាមសិប ) ឆ្នាំ ប្រសិនបើ អំពើ នេះ ប្រព្រឹត្ត មុនពេល ក្នុង ពេល ឬ ក្រោយពេល ប្រើ ហិង្សា ដែល បណ្ដាលឱ្យ ជនរងគ្រោះ ស្លាប់ ដោយសារ គ្មាន ចេតនា សម្លាប់ » ។
