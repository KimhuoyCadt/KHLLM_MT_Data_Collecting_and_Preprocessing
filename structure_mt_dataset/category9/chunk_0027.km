( ពោធិ៍សាត់ ) ៖ អភិបាល ខេត្ត ពោធិ៍សាត់ លោក ម៉ៅ ធ និន កាលពី រសៀល ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ ម្សិលមិញ បាន ថ្លែង ថា « លោកគ្រូ អ្នកគ្រូ គឺជា គ្រួសារ គំរូ ជា ឪពុក ម្តាយ ទី២ ជា ពុម្ព និង ជា ថ្នាល បណ្តុះបណ្តាល នូវ ធនធាន មនុស្ស ប្រកបដោយ គុណភាព និង ប្រសិទ្ធភាព សម្រាប់ ការស្តារ និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ដូច្នេះ គប្បី យកចិត្តទុកដាក់ មាន ឆន្ទះ ក្នុង ការបំពេញ ការងារ មាន សាមគ្គីភាព ផ្ទៃក្នុង ល្អ ធ្វើ យ៉ាងណា កុំ ឲ្យ ពុក ម៉ែ បងប្អូន នៅក្នុង មូលដ្ឋាន មាន ការខកចិត្ត មក លើ យើង » ។
លោក អភិបាល ខេត្ត បាន ថ្លែង បែប នេះ ក្នុង ឱកាស ចុះ សំណេះសំណាល និង ដោះស្រាយ កង្វះខាត់ សិក្សា ជូន លោកគ្រូ អ្នកគ្រូ និង សិស្សានុសិស្ស អនុវិទ្យាល័យ និង បឋមសិក្សា បាកាន ដោយ បាន ការនិមន្ត និង អញ្ជើញ ចូលរួម ពី ព្រះតេជគុណ ឡាយ ក ន ចៅអធិការ វត្ត បាកាន លោក ប្រធាន មន្ទីរ អប់រំ ខេត្ត ប្រធាន មន្ទីរ ធម្មការ ប្រធាន ការិយាល័យ អប់រំ ស្រុក លោកគ្រូ អ្នកគ្រូ និង ប្រជាពលរដ្ឋ ជិត ១០០ នាក់ ។
លោក ម៉ៅ ធ និន បាន ថ្លែង ឲ្យដឹង ថា ការចុះ ជួប សំណេះសំណាល នា ពេលនេះ ដោយសារតែ ប្រជាពលរដ្ឋ មាន ការសរសើរ មិន ដាច់ ពី មាត់ ពី គម្រូ ដឹកនាំ របស់ លោកគ្រូ អ្នកគ្រូ នៃ សាលា នេះ ក្នុង ការយកចិត្តទុកដាក់ បណ្តុះបណ្តាល កូនក្មួយ ៗ សិស្សានុសិស្ស ជាពិសេស មាន ព្រះតេជគុណ ជា ចៅអធិការ វត្ត បាកាន ដែល ជា ឳពុក ជា ម្តាយ នៅ ជាប់ ទីនេះ ស្រាប់ ។
នា ឱកាស នោះ លោក ម៉ៅ ធ និន បាន ទទួល ដោះស្រាយ សំណូមពរ របស់ លោកគ្រូ អ្នកគ្រូ ដោយ ជួយ ទិញ ដី ពង្រីក បរិវេណ សាលា ចាក់ ដី ក្នុង សាលា ២០ ឡាន ផ្តល់ តុគ្រូ សិស្ស បន្ថែម ផ្តល់ កង្ហារ ១២ គ្រឿង ផ្តល់ បន្ទប់ទឹក៤ បន្ទប់ ព្រមទាំង ពិសា អាហារ សម្រន់ ប្រកបដោយ ភាពស្និទស្នាល ក្រៃលែង ៕
( ពោធិ៍សាត់ )៖ ជា ការឆ្លើយតប ទៅនឹង សំណូមពរ របស់ មេភូមិ និង មេឃុំ ក៏ ដូចជា ប្រជាពលរដ្ឋ . លោក ម៉ៅ ធ និន អភិបាល នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ បាន អញ្ជើញ ចុះ ពិនិត្យ ស្ថានភាព ទឹក និង ការងារ បង្កបង្កើន ផល នៅ តាម ប្រព័ន្ធ ធារាស្ត្រ ត្រង់ ចំណុច ទំនប់ បង្ហៀរ អន្លង់ ស្វាយ ក្នុង ឃុំ រំលេច និង ចំណុច បឹង កន្សែង ក្នុង ឃុំ អូរតាប៉ោង ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ ។
ក្នុង ឱកាស ចុះ ពិនិត្យ ស្ថានភាព ទឹក និង ការងារ បង្កបង្កើន ផល នា ពេល នោះ ប្រជាពលរដ្ឋ ក៏ បាន សំណូមពរ ទៅដល់ លោក អភិបាល ខេត្ត ក្នុង នាម ជា អាជ្ញាធរដែនដី សូម ជួយ លើក ផ្លូវ បន្ថែម ស្ថាបនា ស្ពាន ទ្វា ទឹក ស្តារ ប្រឡាយ ... ដើម្បី ធ្វើឲ្យ ប្រសើរឡើង ដោយសារ រដូវ នេះ ជា រដូវ វស្សា មាន ការហូរច្រោះ ផ្លូវ រហូត លេច លង់ ដំណាំ ស្រូវ របស់ ប្រជាកសិករ ដល់ ទៅជាង ៤០០ ហិកតា ។
ទាក់ទង ទៅ នឹង សំណូមពរ របស់ បងប្អូន ប្រជាពលរដ្ឋ នៅ តាម ទីតាំង នីមួយ ៗ លោក ម៉ៅ ធ និន បាន យល់ព្រម ទទួលយក ហើយ បាន ដាក់ ផែនការ ឲ្យ មន្ទីរ ជំនាញ ចុះ សិក្សា ឲ្យបាន ឆាប់ រហ័ស នៅ រដូវ ប្រាំង ខាងមុខ ក្រោយ សិក្សា ចប់ នឹង ចាប់ ដំណើរការ អនុវត្ត ជូន ។
លោក ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ចូលរួម បដិភាគ ទាំង កម្លាំង កាយ មធ្យោបាយ និង ថវិកា ទើប ដំណើរការ ទៅ ដោយ រលូន និង ថែរក្សា បាន ប្រើប្រាស់ យូរអង្វែង ។ ស្រប ពេល នោះ ប្រជាពលរដ្ឋ បាន សម្តែង នូវ ការគោរព ដឹងគុណ ចំពោះ លោក ម៉ៅ ធ និន ដែល មាន ទេព្យកោសល ខ្ពស់ ក្នុង ការសម្របសម្រួល និង ធ្វើ ការដោះស្រាយ ប្រកបដោយ ប្រសិទ្ធិភាព ព្រមទាំង បាន សន្យា ថា នឹង គាំទ្រ យន្តការ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាំមក នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ជារៀងរហូត ។
អ្នកគ្រប់គ្រង រូប នោះ បន្ដ ទៀត ថា ក្រុមហ៊ុន ZTO កំពុង មាន ដំណើរការ នៅលើ ប្រទេស ជាច្រើន លើ ពិភពលោក រួម មាន៖ ប្រទេស កម្ពុជា . ប្រទេស សហរដ្ឋ អាមេរិក . តៃវ៉ាន់ និង ប្រទេស ជាច្រើន ទៀត ។
លោក នីកូ បាន ថ្លែង ឲ្យដឹង ថា « ខ្ញុំ មានអារម្មណ៍ សប្បាយរីករាយ ពេល ទទួលបាន ការងារ ថ្មី ពី ក្រុមហ៊ុន ZTO នេះ ។ ZTO មិន ត្រឹមតែ ផ្ដល់ ភាពងាយស្រួល រាល់ ការដឹកជញ្ជូន ទំនិញ សម្រាប់ បងប្អូន ប៉ុណ្ណោះ ទេ តែ ក្រុមហ៊ុន បាន បង្កើត កម្មវិធី សប្បុរសធម៌ ជាច្រើន ទៀត ជួយ ដល់ បងប្អូន កម្ពុជា ថែម ទៀត ផង » ។
លោក បន្ថែម ថា កាន់តែ ងាយស្រួល បន្ថែម ទៀត សម្រាប់ អ្នក ចង់ បង្កើត មុខរបរ យក ឥវ៉ាន់ ពី ប្រទេស ចិន ឬ ប្រទេស ផ្សេង ទៀត មក កម្ពុជា សូម មក ទាក ទង ក្រុមហ៊ុន ZTO នោះ ក្រុមហ៊ុន នឹង រៀបចំ ដឹកជញ្ជូន ឥវ៉ាន របស់ លោក អ្នក ពី បណ្ដា ប្រទេស ទាំងអស់ មក កម្ពុជា ដោយ សុវត្ថិភាព តម្លៃ សមរម្យ និង ភាពងាយស្រួល ៕
ដំណឹង ល្អ សម្រាប់ សិស្ស ទើប ប្រឡង បាក់ឌុប ! វិទ្យាស្ថាន ជាតិ ពាណិជ្ជសាស្រ្ត ផ្តល់ អាហារូបករណ៍ សិក្សា ដោយ ឥត គិត ថ្លៃ ចំនួន ៦៨៥ កន្លែង
បច្ចុប្បន្ន វិទ្យាស្ថាន មាន កិច្ចសហប្រតិបត្តិការ ជាមួយ សាកលវិទ្យាល័យ ជាតិ និង អន្តរជាតិ ជាច្រើន ក្នុង ការបញ្ជូន និស្សិត ទៅ សិក្សា ក៏ ដូចជា សិក្សា បន្ត មាន ដូចជា ប្រទេស ចិន ប្រទេស ថៃ ប្រទេស ឥណ្ឌូនេស៊ី ប្រទេស ម៉ាឡេស៊ី និង ប្រទេស សឹង្ហ បូរី ។
ក្នុង ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ នេះ វិទ្យាស្ថាន មាន ផ្តល់ អាហារូបករណ៍ រដ្ឋ ចំនួន ៦៨៥ កន្លែង ហើយ សម្រាប់ ថ្នាក់ សិក្សា បង់ ថ្លៃ ៥០០ នាក់ ដំបូង វិទ្យាស្ថាន បញ្ចុះ តម្លៃ ពិសេស ជូន ទៅ តាម និទ្ទេស ចំពោះ សិស្ស ធ្លាក់ សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ អាច ចូលរៀន ថ្នាក់ បរិញ្ញាបត្រ រង រួច បន្ត ថ្នាក់ បរិញ្ញាបត្រ ឆ្នាំ ទី៣ តែម្តង ។ ជាមួយគ្នា នេះ វិទ្យាស្ថាន មាន ការិយាល័យ ទំនាក់ទំនង រោងចក្រ សហគ្រាស សម្រាប់ ស្វែងរក ការងារ ជូន និស្សិត ធ្វើ ។
សម្រាប់ កម្រិត សិក្សា មាន៖ ថ្នាក់ អនុបណ្ឌិត ថ្នាក់ បរិញ្ញាបត្រ ថ្នាក់ បរិញ្ញាបត្រ រង ថ្នាក់ សញ្ញបត្រ បច្ចេកទេស និង វិជ្ជាជីវ១ ។ ទន្ទឹម នឹង នោះ វិទ្យាស្ថាន ក៏ មាន បើក ជំនាញ វគ្គ ខ្លី ៗ លើ ជំនាញ ទៅ តាម តម្រូវការ អ្នកសិក្សា ផងដែរ ។
លោកស្រី នាយក រដ្ឋមន្ដ្រី បាន គូសបញ្ជាក់ ថា លោកស្រី មាន ទំនុកចិត្ត និង ជឿជាក់ ថា នៅ រយៈពេល ខាងមុខ នេះ នឹង មើលឃើញ ពី ការវិវឌ្ឍ ថែម ទៀត នូវ ទំនាក់ទំនង ទូទៅ និង កិច្ចសហប្រតិបត្តិការ រវាង សាធារណរដ្ឋ ស៊ែប៊ី និង កម្ពុជា ដើម្បី បម្រើ ផលប្រយោជន៍ ទៅ វិញ ទៅមក និង ក្នុង ស្មារី លើកម្ពស់ យុត្តិធម៌ សន្ដិភាព និង ស្ថិរភាព នៅលើ ពិភពលោក ។
នាយក រដ្ឋមន្ដ្រី ស៊ែប៊ី ក៏ បាន ថ្លែងអំណរគុណ សម្ដេច តេជោ ហ៊ុន សែន ជាពិសេស ចំពោះ គោលជំហរ ដែល ប្រកាន់ យក គោលការណ៍ និង សង្គតិភាព របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការគោរព បូរណ៌ ភាព ដែនដី និង អធិបតេយ្យភាព របស់ សាធារណរដ្ឋ ស៊ែប៊ី ៕ តារា សម្ដែង ដ៏ ល្បី របស់ ថៃ នាង ចេន្នី មាន វាសនា ខ្ពស់ គ្រង ឈុត គ្រឿង ពេជ្រ មាន តម្លៃ ជិត កន្លះ លាន ដុល្លារ ពេល មកដល់ កម្ពុជា !
( ភ្នំពេញ ) ៖ បន្ទាប់ពី មាន ការសហការ គ្នា រវាង មន្ទីរពេទ្យ ព្រះអង្គ ឌួង និង ក្រុម គ្រូពេទ្យ ជំនាញ ពី ប្រទេស កូរ៉េ បាន ធ្វើ ការវះកាត់ អ្នកជំងឺ គ - ថ្លង់ ចំនួន ៤នាក់ ដែល ប្រើប្រាស់ ជាមួយ ម៉ាស៊ីន ទំនើប របស់ ប្រទេស អូទ្រី ស ទទួលបាន ជោគជ័យ ១០០% នៅ ថ្ងៃទី ១៦ - ១៧ ខែតុលា ឆ្នាំ ២០១៨ ។
លោក សាស្ត្រាចារ្យ លូ លី ឃាង នាយក មន្ទីរពេទ្យ ព្រះអង្គ ឌួង បាន ថ្លែង ក្នុង ឱកាស បើក វះកាត់ ជំងឺ គ - ថ្លង់ ជា ផ្លូវការ ថា ការវះកាត់ អ្នកជំងឺ គ - ថ្លង់ នេះ ទើបតែ មាន ជា លើក ដំបូង តែ ប៉ុណ្ណោះ នៅ កម្ពុជា សម្រាប់ ប្រសិទ្ធិភាព វិញ ធានា ថា អាច ស្ដាប់ និង និយាយ បាន ដូច មនុស្ស ធម្មតា រីឯ តម្លៃ គឺ ថោក ជាង នៅ ក្រៅ ប្រទេស រហូតដល់ តែ បី ដង ដូចនេះ បងប្អូន ប្រជាពលរដ្ឋ យើង ដែល មាន សមាជិក គ - ថ្លង់ នឹង ទទួលបាន ឱកាស ល្អ សម្រាប់ ពួកគាត់ ហើយ ។
នាយក មន្ទីរពេទ្យ ព្រះអង្គ ឌួង បាន ថ្លែង បន្ដ ថា « ជាក់ស្ដែង នៅ ថ្ងៃទី ១៦ - ១៧ ខែតុលា ម្សិលមិញ នេះ មន្ទីរពេទ្យ យើង សហការ ជាមួយ ក្រុម គ្រូពេទ្យ កូរ៉េ ធ្វើ ការវះកាត់ ដល់ កុមារ គ - ថ្លង់ ចំនួន ៤នាក់ ដោយ ឥត គិត ថ្លៃ ផងដែរ សម្រាប់ ប្រសិទ្ធិភាព ក្រោយពេល វះកាត់ វិញ គឺ បាន ធ្វើឲ្យ ឪពុក ម្ដាយ និង គ្រួសារ របស់ កុមារ ទាំង ៤នាក់ នោះ ត្រេកអរ យ៉ាង ខ្លាំង ពេល ឃើញ កូន គាត់ អាច ស្ដាប់ បាន នឹង អាច ឈាន និយាយ បាន ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ » ។
លោក សាស្ដ្រា បន្ដ ថា បន្ទាប់ពី ធ្វើ ការវះកាត់ ហើយ គាត់ អាច ស្ដាប់ តែ ចំពោះ ការនិយាយ មិន ទាន់ បាន នោះ ទេ ព្រោះ គាត់ មិន ធ្លាប់ និយាយ ចឹង គាត់ ក្រលាស់ អណ្ដាត មិន ទាន់ បាន ដូចនេះ បន្ទាប់ពី វះកាត់ ហើយ យើង នឹង បញ្ជូន គាត់ ទៅ ដាក់ សាលារៀន គ - ថ្លង់ ដើម្បីឲ្យ គ្រូ ជួយ បង្រៀន ក្រលាស់ អណ្ដាត បន្ដិច ម្ដង រហូតដល់ និយាយ បាន ដូច មនុស្ស ទូទៅ ដោយ ប្រើប្រាស់ ពេល ក្រលាស់ និយាយ យ៉ាង យូរ បំផុត ៦ខែ ទៅ តាម ការហាត់ រៀន ។
ទន្ទឹម នឹង នោះ លោក សាស្ត្រាចារ្យ ក៏ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន សាច់ញាតិ មាន ជំងឺ គ - ថ្លង់ ត្រូវ មកកាន់ មន្ទីរពេទ្យ ព្រះអង្គ ឌួង ដើម្បី ធ្វើ ការវះកាត់ ឲ្យ ស្ដាប់ និង និយាយ បាន ដូច មនុស្ស ទូទៅ ក្នុង រយៈពេល ខ្លី និង ទទួល ជោគជ័យ ១០០% ។ នេះ ជា ឱកាស នៃ ក្ដីសង្ឃឹម របស់ គ្រួសារ និង អ្នកជំងឺ ផ្ទាល់ ហើយ នេះ ក៏ ជា សេចក្ដីសប្បាយរីករាយ ដែល ក្រុម គ្រូពេទ្យ កម្ពុជា បាន ខិតខំ និង ទទួលបាន ជោគជ័យ ក្នុង ការជួយ ព្យាបាល ប្រជាពលរដ្ឋ យើង បាន ស្គាល់ រសជាតិ ជីវិត ថ្មី មួយ ផងដែរ ៕
សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ដឹកនាំ គណៈប្រតិភូ ទៅ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១២ និង ប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥ នៅ ប្រទេស សិង្ហបុរី
( ភ្នំពេញ ) ៖ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ការពារ ជាតិ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១២ និង កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥ នៅ សាធារណរដ្ឋ សិង្ហបុរី ដែល នឹង ប្រព្រឹត្តិ ទៅ ចាប់ពី ថ្ងៃទី ១៨ ដល់ ថ្ងៃទី ២០ ខែតុលា ។
ជាមួយគ្នា នេះ ដែរ នៅក្នុង កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥ នោះ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ នឹង ចូលរួម ធ្វើ បទ អន្ដរាគមន៍ ស្ដីពី ការប្រឆាំង ការគំរាមកំហែង ដោយ អំពើ ភេរវកម្ម និង វិធានការកសាង ទំនុកចិត្ត ជាក់ស្ដែង ។
បន្ថែម ពី នេះ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ នឹង អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន +១ ចំនួន ០៣ ក្នុង អំឡុង ពេល នៃ កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១២ និង កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥នេះ ផងដែរ ៕
