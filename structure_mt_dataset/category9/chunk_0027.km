( យូ អិន ) ៖ ប្រទេស គុយ បា បាន ចេញមុខ រិះគន់ លើ សហរដ្ឋ អាមេរិក ជុំវិញ ការ មិន ទាន់ បង់ ថ្លៃ មូលនិធិ មក ឲ្យ អង្គការ សហ ប្រជាជាតិ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៉ីន ហួរ នៅ ល្ងាច ថ្ងៃពុធ ទី២៤ ខែតុលា ឆ្នាំ ២០១៨ ។
នា ឱកាស នោះ ដែរ លោកស្រី Camejo បាន និយាយ ថា ប្រទេស របស់ លោកស្រី មិន មាន មោទនភាព ជាខ្លាំង ដែល ស្ថិត ក្នុង ចំណោម បណ្តា ប្រទេស ដែល បាន បំពេញ កាតព្វកិច្ច ផ្នែក ហិរញ្ញវត្ថុ ចំពោះ អង្គការ សហ ប្រជាជាតិ ទោះបីជា ស្ថិត ក្រោម ការរាំងខ្ទប់ សេដ្ឋកិច្ច ពាណិជកម្ម និង ហិរញ្ញវត្ថុ ពីសំណាក់ សហរដ្ឋ អាមេរិក អស់ រយៈពេល ៥៦ ឆ្នាំ មកហើយ ក្តី ។
គួរ ជម្រាប ថា បើ តាម អង្គការ សហ ប្រជាជាតិ មកទល់ ពេលនេះ រដ្ឋ ជា សមាជិក ប្រមាណ ១៤៥ ប្រទេស បាន បង់ ថ្លៃ មូលនិធិ ពេញលេញ សម្រាប់ កញ្ចប់ ថវិកា ទូទៅ របស់ UN ខណៈ ៥៥ ប្រទេស បាន បង់ មូលនិធិ ត្រឹម សម្រាប់ កញ្ចប់ ថវិកា ថែរក្សា សន្តិភាព ៕ ក្រសួង រៀបចំ ដែន ដី៖ ពលរដ្ឋ ទទួលស្គាល់ ថា បាន ចូល ទន្ទ្រាន កាន់កាប់ ដី រដ្ឋ ដែល ផ្ដល់ សិទ្ធិ សម្បទាន សេដ្ឋកិច្ច ជូន ក្រុមហ៊ុន ចំការ កៅស៊ូ មេមត់ ពិត មែន ដោយសារ ខ្វះ ដី បង្កបង្កើន ផល
( ភ្នំពេញ ) ៖ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ទទួលស្គាល់ ថា បាន ចូល ទន្ទ្រាន កាន់កាប់ ដី រដ្ឋ ដែល បាន ផ្ដល់ សិទ្ធិ សម្បទាន សេដ្ឋកិច្ច ជូន ក្រុមហ៊ុន ចំការ កៅស៊ូ មេមត់ ស្ថិត នៅ ឃុំ ២ធ្នូ ស្រុក ស្នួល ខេត្ត ក្រចេះ ពិតប្រាកដ មែន ដោយសារ ខ្វះ ដី បង្កបង្កើន ផល ។
ការចេញ សេចក្ដីប្រកាស ព័ត៌មាន នេះ បាន ធ្វើឡើង បន្ទាប់ពី ឧប នាយក រដ្ឋមន្ដ្រី ជា សុផារ៉ា រដ្ឋមន្ដ្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង ជាមួយ តំណាង ក្រសួង មហាផ្ទៃ . តំណាង រដ្ឋបាល ខេត្ត ក្រចេះ និង តំណាង រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ទទួល ជួប តំណាង ពលរដ្ឋ ដែល មក តវ៉ា ករណី វិវាទ ពាក់ព័ន្ធ នឹង ដី សម្បទាន សេដ្ឋកិច្ច ដែល រាជ រដ្ឋាភិបាល បាន ប្រគល់ ជូន ក្រុមហ៊ុន ចំការ កៅស៊ូ មេមត់ ។
ក្រសួង អះអាង ថា រាជ រដ្ឋាភភិបាល កម្ពុជា យកចិត្តទុកដាក់ ដោះស្រាយ ជូន ប្រជាពលរដ្ឋ ដែល មាន ឈ្មោះ ក្នុង បញ្ជី អ្នកតវ៉ា ដែល ខ្វះ ដី លំនៅឋាន និង ដី បង្កបង្កើន ផល ពិតប្រាកដ មែន ដោយ ត្រូវ ដាក់ សំណើ តាមរយៈ អាជ្ញាធរដែនដី សាមី ស្រប តាម នីតិវិធី សម្បទាន ដី សង្គមកិច្ច ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ សន្យា សហការ ជាមួយ អាជ្ញាធរដែនដី ក្នុង ការទប់ស្កាត់ ការ ចូល ទន្ទ្រាន ដី រដ្ឋ ការញុះញង់ និង ការក្លែងបន្លំ ផ្ដល់ ព័ត៌មាន មិន ពិត ដែល បង្កឲ្យ យឺតយ៉ាវ ដល់ ដំណើរការដោះស្រាយ ។ ក្នុង ករណី មាន ការបន្ដ ចូល ទន្ទ្រាន ដី រដ្ឋ ញុះញង់ និង ក្លែងបន្លំ ផ្ដល់ ព័ត៌មាន មិន ពិត ត្រូវ ប្រឈម ចំពោះ មុខ ច្បាប់ ជាធរមាន ៕ សម្ដេច ក្រឡាហោម ស ខេង ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ គ្រួសារ សព លោក ឧត្តមសេនីយ៍ ឯក ជា ម៉ន ក្រោយ ទទួលមរណភាព ដោយ រោគា ពាធ
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ភរិយា ព្រមទាំង មន្ដ្រីរាជការ ស៊ីវិល និង នគរបាល ជាតិ នៃ ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ផ្ញើ សារ រំលែក ទុក្ខ ជូន លោកស្រី មាស សន ចំពោះ មរណភាព លោក ឧត្តមសេនីយ៍ ឯក ជា ម៉ន មេបញ្ជាការ រង កងទ័ព ជើងគោក និង ជា មេបញ្ជាការ យោធ ភូមិភាគ ទី៤ ដែល ត្រូវ ជា ស្វាមី លោកស្រី បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០១៨ ក្នុង ជន្មាយុ ៦៦ ឆ្នាំ ដោយ រោគា ពាធ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន ចាត់ទុក ថា មរណភាព របស់ លោក ឧត្តមសេនីយ៍ ឯក ជា ម៉ន គឺជា ការបាត់បង់ ស្វាមី ឪពុក និង ជីតា ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជា ការបាត់បង់ នូវ កុលបុត្រ វីរយុទ្ធជន ដ៏ ឆ្នើម មួយ រូប ដែល បាន លះបង់ គ្រប់ យ៉ាង ក្នុង ការបម្រើ ជាតិ មាតុភូមិ គ្រប់ កាលៈទេសៈ នា ពេល កន្លងមក ។
សម្ដេច ក្រឡាហោម ស ខេង និង ភរិយា ព្រមទាំង មន្ដ្រីរាជការ ស៊ីវិល និង នគរបាល ជាតិ នៃ ក្រសួង មហាផ្ទៃ សូម ចូលរួម រំលែក ទុក្ខ នូវ មរណទុក្ខ ដោយ ក្ដីស្រណោះ និង ការអាឡោះអាល័យ ជាមួយ លោកស្រី និង បុត្រា បុត្រី ព្រមទាំង បងប្អូន កូនក្មួយ ទាំងអស់ នៃ សព ដោយ សេចក្ដីសង្វេគ ជា ទីបំផុត ៕ ពិតជា កំពូល មហាសំណាង មែន ! ទីបំផុត ទឹកប្រាក់ ១.៦ ពាន់ លាន ដុល្លារ អាមេរិក រកឃើញ ម្ចាស់ ហើយ !
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៣.៨៧៧ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៦៧៤ គ្រឿង ( ម៉ូតូ ៨៣ %) អប់រំ១៩១ គ្រឿង និង ផាក ពិន័យ ៤៨៣ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៤ ខែតុលា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ២. ៤៥៨ គ្រឿង . អប់រំ១១៧ គ្រឿង និង ផាក ពិន័យ ២. ៤៥៨ គ្រឿង ។
គ្រឿង ឧបភោគ បរិភោគ ដែល ហួស កាលបរិច្ឆេទ ជាច្រើន មុខ នៅក្នុង ផ្សារ ចំនួន ២ ត្រូវបាន កាំ កុងត្រូល ខេត្ត ឧត្តរមានជ័យ ធ្វើ ការដកហូត យក ទៅ ដុត កម្ទេចចោល
