( កំពង់ចាម ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ២១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ គណៈ ស្នងការ លោក នាយ ការិយាល័យ ជំនាញ រួមទាំង អធិការ អធិការ រង និង មន្ត្រី នៃ អធិការដ្ឋាន នគរបាល ស្រុក ចំការលើ បាន ចូលរួម គោរព វិញ្ញាណក្ខន្ធ និង បំពាក់ ឋានន្តរសក្តិ ជា កិច្ច បច្ឆា មរណជូន សព លោក វរសេនីយ៍ ត្រី ជី ម៉ាច អត្ដ លេខ ១៩៣៧៤ ឋានៈ នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល តា ប្រុក ដែល បាន ទទួលមរណភាព នៅ ពេល ដែល កំពុង បំពេញ ការងារ កាលពី ថ្ងៃទី ២០ ខែវិច្ឆិកា ។
បច្ចុប្បន្ន សព ត្រូវបាន ក្រុមគ្រួសារ រៀបចំ ធ្វើ បុណ្យ តាម ប្រពៃណី នៅ គេហដ្ឋាន នៅ ភូមិ ថ្នល់ បែក លិច ឃុំ ស្វាយ ទាប ស្រុក ចំការ លើ ខេត្ត កំពង់ចាម តាម គន្លង ប្រពៃណី ព្រះពុទ្ធ សាសនា ។
ជាមួយនឹង ការអញ្ជើញ គោរព វិញ្ញាណក្ខន្ធ សព លោក វរសេនីយ៍ ត្រី ជី ម៉ាច . លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល និង សហការី បាន អុជ ធូប បួងសួង ឧទ្ទិស ទៅដល់ វិញ្ញាណក្ខន្ធ ទាំង អារម្មណ៍ ក្រៀមក្រំ និង សោកស្តាយ យ៉ាង ខ្លាំង ក្នុង ការបាត់បង់ នូវ មន្ត្រី ដ៏ សកម្ម ម្នាក់ ដែល ធ្លាប់ បាន បម្រើ ជាតិ មាតុភូមិ អស់ រយៈពេល ច្រើន ឆ្នាំ កន្លងមក ។
ស្ថិត ក្នុង ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ ស្នងការ និង ជា ប្រធាន អតីត យុទ្ធជន ខេត្ត បាន នាំយក នូវ ថវិកា របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម សរុប ចំនួន ៦.០៣៥.០០០ រៀល . អង្ករ ០១បេ. ទឹកក្រូច ០៤ កេស . ទឹក សុទ្ធ ០៦ កេស . មី ០៦ កេស ដែល ថវិកា ទាំងនេះ បាន ប្រគល់ ជូន គ្រួសារ នៃ សព ដើម្បី ចាត់ចែង ធ្វើ បុណ្យ តាម គន្លង ប្រពៃណី ព្រះពុទ្ធ សាសនា ។
ក្នុង ឱកាស នោះ ផងដែរ ក្រុមគ្រួសារ សព បាន ថ្លែងអំណរគុណ ដល់ លោក ឧត្តមសេនីយ៍ ស្នងការ និង សហការី ព្រមទាំង សប្បុរ ជន ដែល តែងតែ យកចិត្តទុកដាក់ ដល់ មន្ត្រី ក្រោម ឱវាទ ៕
ព្រះរាជអាជ្ញា ខេត្ត កំពង់ចាម បញ្ជា កម្លាំង សមត្ថកិច្ច បង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ នៅ ឃុំ រាយប៉ាយ ស្រុក កង មាស
( កំពង់ចាម ) ៖ ក្រោយ ទទួលបាន ព័ត៌មាន ពី មូលដ្ឋាន និង មាន ការឯកភាព ពី លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ចាម កម្លាំង សមត្ថកិច្ច បាន បន្ដ ចុះបង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ នៅ ថ្ងៃទី ២១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅ ស្ថិត ក្នុង ភូមិ ព្រែក ប្រណា ក និង ភូមិ គក ក្របី ឃុំ រាយប៉ាយ ស្រុក កង មាស ។
របាយការណ៍ ដដែល បញ្ជាក់ ថា ជា លទ្ធផល លូស្បៃ មុង ចំនួន ១៥មាត់ . របាំង ស្បៃ មុង ប្រវែង ២៨០ ម៉ែត្រ និង ចាក់ លែង កូន ត្រី ចម្រុះ ចូល បឹង ធម្មជាតិ ចំនួន ២០ គីឡូក្រាម ។ ចំពោះ សម្ភារ វត្ថុតាង បាន សហការ ដុត បំផ្លាញ ចោល នៅនឹង កន្លែង ដោយ មាន ការឯកភាព ពី លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ចាម ៕
ឡាវ នឹង កាត់បន្ថយ អ្នកបម្រើ ការងារ រដ្ឋ ដើម្បី កាត់បន្ថយ ការចំណាយ ថវិកា ជាតិ
រដ្ឋាភិបាល ឡាវ ក៏ បាន សម្រេច ផ្អាក គម្រោង តំឡើង សន្ទស្សន៍ ប្រាក់ខែ មន្ត្រីរាជការ ផងដែរ ខណៈ ដែល ប្រទេស កំពុង ប្រឈម នឹង ឧបសគ្គ ថវិកា ។
ឆក់ ហើយ ចូល គុក មិន រៀង ចាល ចេញ មកវិញ ឆក់ ទៀត តែ ឆ្លៀត ប្លន់ បន្ថែម ត្រូវ ជាប់ ខ្នោះ អាវុធហត្ថ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បញ្ជូន ជនសង្ស័យ ០៥ នាក់ ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ ការផ្តន្ទាទោស ពាក់ព័ន្ធ ករណី វាយ ប្លន់ យក ម៉ូតូ និង មាន ប្រវត្តិ ឆក់ រាប់ ភ្លេច ក្នុង រាជធានី ភ្នំពេញ ។
គួរ រំលឹក ដែរ ថា កាលពី ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ មាន ករណី ក្រុម ស្ទាវ ០៥ នាក់ បាន តាម វាយ និង ធាក់ ម៉ូតូ ជនរងគ្រោះ ម្នាក់ ឲ្យ ដួល ក្នុង បំណង ប្លន់ យក ម៉ូតូ តែ ត្រូវ កម្លាំង ល្បាត របស់ អាវុធហត្ថ មូលដ្ឋាន ខណ្ឌ សែនសុខ ទៅ ទាន់ ឃាត់ខ្លួន បាន ០២ នាក់ ភ្លាម ៗ នៅនឹង កន្លែង នៅ ចំណុច ផ្លូវ ១០១១ ភូមិ ភ្នំពេញ ថ្មី សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ និង បញ្ជូន មកកាន់ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដើម្បី ស៊ើបអង្កេត បន្ថែម ។
ក្រោម វិធានការ ជំនាញ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ស្រាវ ឃាត់ខ្លួន បក្ខពួក ០៣ នាក់ ផ្សេង ទៀត ជា បន្តបន្ទាប់ ក្នុង ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។ ជនសង្ស័យ ទាំង ០៥ នាក់ ដែល អាវុធហត្ថ ឃាត់ខ្លួន បាន រួម មាន ទី១៖ ឈ្មោះ យ៉ាន់ ច័ន្ទ ឆ័យ យ៉ា អាយុ ១៧ឆ្នាំ . ទី ២៖ ឈ្មោះ គង់ សុវណ្ណ រិទ្ធ អាយុ ១៦ឆ្នាំ . ទី ៣៖ ឈ្មោះ សុខ ចំរើន ហៅ បាលី អាយុ ១៥ឆ្នាំ . ទី ៤៖ ឈ្មោះ ពី សេង ហេង អាយុ ១៨ ឆ្នាំ និង ទី៥៖ ឈ្មោះ ម៉ង់ ជាតិ សុភ័ក្រ អាយុ ១៥ ឆ្នាំ ។
តាម ការស៊ើបអង្កេត របស់ សមត្ថកិច្ច អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន រកឃើញ ជនសង្ស័យ ទាំង ០៥ នាក់ គឺ មាន សមាសភាព ធ្លាប់ ធ្វើ សកម្មភាព ឆក់ រាប់ ភ្លេច ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ធ្លាប់ ជាប់ គុក ធ្លាប់ ជាប់ ក្នុង មណ្ឌល ផ្តាច់ គ្រឿងញៀន ធ្លាប់ រត់ ចោល ស្រុក ផងដែរ ដូច ជា៖
ឈ្មោះ សុខ ចំរើន ហៅ បាលី ធ្លាប់ ត្រូវបាន ជាប់ ពន្ធនាគារ ព្រៃស ក្នុង អំឡុង ខែមេសា ឆ្នាំ ២០១៧ រយៈពេល ១ ឆ្នាំ ជាប់ពាក់ព័ន្ធ ករណី ឆក់ ហើយ ចេញ មកវិញ ក៏ បន្ត មុខរបរ ឆក់ ដដែល ជាច្រើន លើក រហូត រាប់ ភ្លេច និង ឈាន ទៅ មួយ កំរិត ទៀត គឺ ប្លន់ ។
ឈ្មោះ ពី សេង ហេង ធ្លាប់ ជាប់ ក្នុង មណ្ឌល កែប្រែ ផ្តាច់ សារធាតុ ញៀន ឱកាស ខ្ញុំ ក្នុង អំឡុង ខែមីនា ឆ្នាំ ២០១៧ រយៈពេល ១ ឆ្នាំ ពាក់ព័ន្ធ ករណី ញៀន ថ្នាំ ហើយ ចេញ មកវិញ ក្នុង អំឡុង ខែកញ្ញា ឆ្នាំ ២០១៨ ក៏ ចូលរួម ធ្វើ សកម្មភាព ឆក់ ប្លន់ ជាមួយ បក្ខពួក ជាច្រើន លើក រហូត រាប់ ភ្លេច ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។
ឈ្មោះ ម៉ង់ ជាតិ សុភ័ក្ត្រ ធ្លាប់ រត់ ចោល ស្រុក ០៣ ខែ ពី ភ្នំពេញ ទៅ សម្ងំ លាក់ ខ្លួន ក្នុង ខេត្ត កំពត ក្នុង ឆ្នាំ ២០១៧ បន្ទាប់ពី រូប គេ បាន ធ្វើ សកម្មភាព ឆក់ យ៉ាង សកម្ម ក្នុង រាជធានី ភ្នំពេញ ហើយ បាន ឃើញ ព័ត៌មាន ថា បក្ខពួក ខ្លួន ម្នាក់ ឈ្មោះ ថា ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន បញ្ជូន ទៅ ពន្ធនាគារ ព្រៃស ។ បន្ទាប់ពី រត់ ចោល ស្រុក មួយ រយៈ ក៏ ត្រលប់ ចូល ភ្នំពេញ វិញ ដើម្បី ធ្វើ សកម្មភាព ឆក់ ប្លន់ បន្ត ។
អ្វី ដែល គួរឲ្យ ភ្ញាក់ផ្អើល បំផុត គឺ នៅ ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ មុនពេល ធ្វើ សកម្មភាព វាយ ប្លន់ យក ម៉ូតូ គឺ ក្រុម ចោរ វ័យ ក្មេង ទាំងនេះ បាន ធ្វើ សកម្មភាព ឆក់ ទូរស័ព្ទ ០៣ ដង ផ្ទួន ៗ គ្នា ជាមុន យ៉ាង ព្រហើន បំផុត គឺ៖ នៅ យប់ ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ពួកគេ បាន ឆក់ ទូរស័ព្ទ ដៃ ០១ គ្រឿង ពី ជនរងគ្រោះ ប្រុស ម្នាក់ ជិះ កង បី នៅ ចំណុច ស្ពាន អាកាស ៥មករា ។
លុះ ដល់ វេលា ម៉ោង ប្រមាណ ០២ យប់ ឈានចូល ថ្ងៃទី ១៧ ពួកគេ បាន ចេញ ឆក់ ទូរស័ព្ទ បាន ០១ គ្រឿង ទៀត ពី ជនរងគ្រោះ ភេទ ប្រុស កំពុង ជិះ ម៉ូតូ នៅ ចំណុច មុខ ស្ថានីយ៍ ទូរទស្សន៍ អាស៊ី អាគ្នេយ៍ ។ លុះ ដល់ ល្ងាច ម៉ោង ប្រហែល ០៥ ថ្ងៃទី ១៧ ពួកគេ បាន ឆក់ ទូរស័ព្ទ ០១ គ្រឿង ទៀត ពី ស្ត្រី ម្នាក់ កំពុង ឈរ ថត រូប នៅក្បែរ ផ្សារ អ៊ីអន២ ខណ្ឌ សែនសុខ ។
បន្ទាប់មក នៅ វេលា ម៉ោង ១១យប់ ថ្ងៃទី ១៧ ខែវិច្ឆិកា ក្រុម ចោរ ទាំង នេះ ក៏ បាន ចេញ ប្លន់ ម៉ូតូ តែម្តង នៅ ចំណុច ផ្លូវ ១០១១ ភូមិ ភ្នំពេញ ថ្មី សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ ដោយ ប្រើ រូបភាព ដេញ វាយ ជនរងគ្រោះ ដូច គេ ឈ្លោះគ្នា ហើយក៏ ធាក់ ម៉ូតូ ជនរងគ្រោះ ឲ្យ ដួល ហើយ ដេញ ជនរងគ្រោះ ឲ្យ រត់ ចោល ម៉ូតូ រួច ពួកគេ ចុះ ទៅ លើក ម៉ូតូ ជនរងគ្រោះ ដើម្បី ជិះ គេចខ្លួន តែ សំណាង អាក្រក់ ក៏ ត្រូវបាន អាវុធហត្ថ បង្ក្រាប បាន ជា បន្តបន្ទាប់ តែម្តង ៕
រដ្ឋមន្ដ្រី សុខាភិបាល ចុះ ត្រួតពិនិត្យ ការរៀបចំ ដំឡើង តង់ និង សម្ភារ បរិក្ខារ ពេទ្យ ដើម្បី ផ្ដល់ សេវា សុខភាព ជូន ពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
( ភ្នំពេញ ) ៖ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង នៅ ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ចុះ ត្រួតពិនិត្យ ការរៀបចំ ដំឡើង តង់ និង សម្ភារ បរិក្ខារ ពេទ្យ ទាំង ១២កន្លែង នៅ តាម ទីតាំង ផ្សេង ៗ គ្នា ដើម្បី រៀបចំ សម្រាប់ ត្រៀម សង្គ្រោះ ប្រជាពលរដ្ឋ ឲ្យ ទាន់ ពេលវេលា ពេល ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល ចាប់ផ្តើម នៅ ថ្ងៃស្អែក នេះ ។
រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង ក៏ បាន ត្រៀម រួច ជាស្រេច នូវ មន្ដ្រី សុខាភិបាល ១. ០៣៧ នាក់ . រថយន្ដ សង្គ្រោះ ៦៨ គ្រឿង ដោយ ១១ គ្រឿង ប្រចាំ នៅ តាម តង់ សុខភាព ទាំង ១២កន្លែង . ១៤ គ្រឿង ដាក់ នៅ តាម ដងផ្លូវ សាធារណៈ នៅ តាម ទីតាំង ច្បាស់លាស់ . ២៤ គ្រឿង ប្រចាំ ការ នៅ ក្រសួង សុខាភិបាល . ១៣ គ្រឿង ទៀត ប្រចាំ ការ នៅ តាម ទូកង នីមួយ ៗ ដែល កីឡាករ អញ្ជើញ មក ពី បណ្ដា រាជធានី ខេត្ដ ហើយ ក្រសួង ក៏ បាន ត្រៀម បន្ថែម ទៀត នូវ រថយន្ដ សង្គ្រោះ នៅ តាម មន្ទីរពេទ្យ ចំនួន ៦ទៀត ផងដែរ ។
ប្រសិនបើ លោកអ្នក មាន បញ្ហា ស្វែងរក សេវា សុខភាព នៅ តាម ទីតាំង ដូច ខាងលើ និង ទំនាក់ទំ នង តាម រយៈ ទូរស័ព្ទ លេខ៖ ១១៩ ។
១៖ សម្តេច តេជោ និង ឯក អគ្គ រដ្ឋទូត អាមេរិក បង្ហាញ ជំហរ ប្រឹងប្រែង ធ្វើឲ្យ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ កាន់តែ ប្រសើរ ( ចុច អាន )
២៖ សម្តេច តេជោ ប្រាប់ ទូត អាមេរិក កុំ ឲ្យបារម្ភ កម្ពុជា មិន អនុញ្ញាតឲ្យ មាន មូលដ្ឋាន ទ័ព បរទេស នៅ កម្ពុជា ឡើយ ( ចុច អាន )
៣៖ អគ្គ រដ្ឋទូត អាមេរិក ទទួលស្គាល់ ប្រសាសន៍ សម្តេច តេជោ ហ៊ុន សែន ដែល បដិសេធ ព័ត៌មាន ថា កម្ពុជា អនុញ្ញាតឱ្យ មាន មូលដ្ឋាន យោធា បរទេស នៅ កម្ពុជា ( ចុច អាន )
៥៖ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ សម័យ ប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី នា ថ្ងៃ ម្សិលមិញ ( ចុច អាន )
៦៖ ប្រមុខ ការទូត កម្ពុជា បន្ត អះអាង ប្រាប់ អាមេរិក ថា រដ្ឋធម្មនុញ្ញ កម្ពុជា មិន អនុញ្ញាតឲ្យ មាន វត្តមាន ទ័ព បរទេស នៅលើ ដី កម្ពុជា នោះ ឡើយ ( ចុច អាន )
៧៖ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ចុះ ចែក មួក សុវត្ថិភាព ១០ម៉ឺន មួក តាម គោលដៅ ក្នុង ឱកាស បុណ្យ អុំ ទូក ( ចុច អាន )
១៖ ទីបំផុត សេតវិមាន ព្រម ឲ្យ អ្នកកាសែត CNN ចូល យក ព័ត៌មានវិញ តែ បទបញ្ជា ផ្ទៃក្នុង មួយចំនួន ត្រូវបាន ដាក់ចេញ ដើម្បី រក្សា សណ្តាប់ធ្នាប់ ចំពោះ មុខ ប្រធានាធិបតី ( ចុច អាន )
២៖ សារព័ត៌មាន រុស្ស៊ី៖ តើ លទ្ធិ ប្រជាធិបតេយ្យ ដែល អាមេរិក ចង់បាន គឺជា អ្វី ឲ្យ ប្រាកដ ? ដាក់ទណ្ឌកម្ម ប្រទេស ស្ទើរ ប្រជាធិបតេយ្យ តែ ទៅ គាំទ្រ របប ផ្តាច់ការ ? ( ចុច អាន )
៧៖ អារ៉ាប៊ី សាអូឌីត ចង់ឲ្យ ពិភពលោក បិទ បញ្ចប់ កម្មវិធី មីស៊ីល - នុយក្លេអ៊ែរ អ៊ីរ៉ង់ ឲ្យបាន ទាំងស្រុង តែ ម្តង ! ( ចុច អាន )
តាមរយៈ ជ័យជម្នះ លើក ដំបូង ក្នុង ចំណោម ៣ប្រកួត វគ្គ សន្សំ ពិន្ទុ ក្នុង ពូល A នេះ ដែរ ក្រុម មន្រ្តី គ្រូបង្វឹក និង កីឡាករ គ្រប់ រូប ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ចំនួន ១០០០ ដុល្លារ ដែល សហព័ន្ធ កីឡា បាល់ទាត់ កម្ពុជា FFC បាន ប្រកាស នា ពេល កន្លងមក រាល់ ទទួលបាន ជ័យជម្នះ ក្នុង ព្រឹត្តិការណ៍ នេះ និង ទទួលបាន ម្នាក់ ២០០០ ដុល្លារ ក្នុង ម្នាក់ ផងដែរ ប្រសិនបើ កម្ពុជា ឆ្លង ចូល វគ្គ ពាក់កណ្តាល ផ្តាច់ព្រ័ត្រ ទៀត នោះ ។
កីឡាករ ខ្សែ ប្រយុទ្ធ ពាក់ លេខ ១១ ចាន់ វឌ្ឍនាកា បាន តែត បញ្ចូល ទី គ្រាប់ នាំមុខ នៅ នាទី ទី១៨ មុនពេល មិត្ត រួម ក្រុម ពាក់ លេខ ៧ ប្រាក់ មុនី ឧត្តម រក បាន គ្រាប់ ទី ទី៣៦ ដោយ ការទាត់ បាល់ ពិន័យ ១១ម៉ែត្រ ក្រោយពេល កីឡាករ ខ្សែ ការពារ ឡាវ បាន ធ្វើឲ្យ កីឡាករ កម្ពុជា កែវ សុខ ផេង ដួល ក្នុង ប្រអប់ គ្នា ។
យ៉ាងណាមិញ ក្រុម ភ្ញៀវ ឡាវ បាន រង់ចាំ ដល់ នាទី ទី ៧៦ ទម្រាំ រក គ្រាប់បែក ពង មាន់ ខណៈ អ្នកចាំទី កីឡាករ លេខ ២០ ឡាវ ប្រជែង ១ទល់ នឹង ១ ជាមួយ អ្នកចាំទី អ៊ុ វិចិត្រ របស់ កម្ពុជា មុនពេល កែវ សុខ ផេង ពាក់ លេខ ៩ រក បាន គ្រាប់ ទី៣ នៅ នាទី ទី៧៧ ។
កម្ពុជា នៅសល់ ១ប្រកួត ចុងក្រោយ នៅ ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ដោយ ត្រូវ ជួប ម្ចាស់ ផ្ទះ វៀតណាម បង្រ្គប់ កិច្ច ក្នុង ពូល A ខណៈ មីយ៉ាន់ម៉ា និង វៀតណាម រក បាន ត្រឹម ១ពិន្ទុ ក្រោយ ប្រកួត ស្មើគ្នា ០ - ០ នា ថ្ងៃអង្គារ ទី២០ ខែវិច្ឆិកា នេះ ដូចគ្នា ដោយ ពួកគេ ឈរ នៅ កំពូល មាន ៧ពិន្ទុ ស្មើគ្នា ផងដែរ ៕ រដ្ឋសភា កម្ពុជា នឹង ទៅ ចូលរួម មហាសន្និបាត សភា តំបន់ អាស៊ី នៅ តួកគី នា ថ្ងៃ ២៧ វិច្ឆិកា - ៤ ធ្នូ
( ភ្នំពេញ ) ៖ លោក ងួន ញ៉ិល អនុប្រធាន ទី១ នៃ រដ្ឋសភា នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ សភា ចេញ ទៅ ចូលរួម មហាសន្និបាត សភា តំបន់ អាស៊ី លើក ទី ១១ នៅ ទីក្រុង អ៉ីស្ដង់ ប៊ុល សាធារណរដ្ឋ តួកគី ចាប់ពី ថ្ងៃទី ២៧ ខែវិច្ឆិកា ដល់ ថ្ងៃទី ០៤ ខែធ្នូ ឆ្នាំ ២០១៨ ។ នេះ បើ តាម សេចក្ដីជូនដំណឹង របស់ រដ្ឋសភា ដែល ចេញផ្សាយ នា ថ្ងៃទី ២០ ខែវិច្ឆិកា នេះ ។
សេចក្ដីជូនដំណឹង បាន បញ្ជាក់ ថា មហាសន្និបាត ខាង នេះ ធ្វើឡើង ក្រោម ប្រធានបទ ស្ដីពី « ការជំរុញ ឱ្យ មាន ការរីកចម្រើន សេដ្ឋកិច្ច នៅក្នុង តំបន់ អាស៊ី » ដែល មាន ថ្នាក់ដឹកនាំ រដ្ឋសភា ព្រឹទ្ធសភា នៃ បណ្ដា ប្រទេស ដែល ជា សមាជិក សភា តំបន់ អាស៊ី ទាំង ៤២ ប្រទេស គណៈប្រតិភូ បណ្ដា ប្រទេស ជា អ្នកសង្កេតការណ៍ ចំនួន ១៦ ប្រទេស និង អង្គការ ដៃគូ សភា តំបន់ អាស៊ី ចំនួន ១០ស្ថាប័ន ផងដែរ ៕
តំណាងរាស្ដ្រ មណ្ឌល ព្រៃវែ ង៖ សាមគ្គីភាព នាំមក នូវ សន្តិភាព និង ថែរក្សា វប្បធម៌ ប្រពៃណី
( ភ្នំពេញ ) ៖ លោក ជា ម ប៉េអា តំណាងរាស្ត្រ មណ្ឌល ព្រៃវែង និង ជា សមាជិក គណៈកម្មការ កិច្ចការ បរទេស សហប្រតិបត្តិការ អន្តរជាតិ ឃោសនា ការ និង ព័ត៌មាន នៃ រដ្ឋសភា បាន ជួប សំណេះសំណាល ជាមួយ តំណាង កីឡាករ ចំណុះ ទូក «ង » ចំនួន ៤ សរុប ២០០ នាក់ ដែល មកពី ស្រុក ស៊ីធរ កណ្តាល ខេត្ត ព្រៃវែង ដើម្បី ចូលរួម ប្រកួត អុំ ទូក ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ដែល ជា ពិធី បុណ្យ ជាតិ ធំ មួយ ក្នុង ចំណោម ពិធី បុណ្យ ជាតិ ធំ ៗ តាម បែប ប្រពៃណី ទំនៀមទម្លាប់ ។
ក្នុង ឱកាស អញ្ជើញ សំណេះសំណាល នៅ រសៀល ថ្ងៃទី ២០ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ លោក ជា ម ប៉េអា បាន លើកឡើង ថា ការរក្សា សាមគ្គីភាព ជា កម្លាំង សន្តិភាព ការអភិវឌ្ឍ និង ការលើកកម្ពស់ កិត្យានុភាព វប្បធម៌ ប្រពៃណី ជាតិ ។
នៅក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយ កីឡាករ ចំណុះ ទូក «ង » ដែល កំពុង ស្នាក់ នៅ តំបន់ ជ្រោយ ចង្វា លោក ជា ម ប៉េអា បាន ឧបត្ថម្ភ ថវិកា ចំនួន ៤លាន រៀល ដល់ កីឡាករ ចំណុះ ទូក ទាំងអស់ និង ផ្តាំផ្ញើ កីឡាករ ទាំងអស់ ត្រូវ ថែរក្សា សុខភាព ។
( ភ្នំពេញ ) ៖ ក្នុង ពេល ស្នាក់ នៅ រាជធានី ភ្នំពេញ ក្រុម កីឡាករ អុំ ទូក មិន សូវ រវល់ ធ្វើ កិច្ចការ ផ្សេង ៗ ឬ ដើរកម្សាន្ត យូរ ពេក នោះ ឡើយ ផ្ទុយទៅវិញ ពួកគាត់ ខំប្រឹង សម្រាក យក កម្លាំង រៀង ខ្លួន ដើម្បី ប្រឹងប្រែង ដណ្ដើម ជោគជ័យ ក្នុង ការប្រណាំង ទូក ង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃស្អែក នេះ តទៅ ។
ជាមួយគ្នា នោះ គេ ក៏ ឃើញ ចុង ភៅ ខិតខំ ធ្វើ ម្ហូប ទំនុកបម្រុង សម្រាប់ ក្រុម កីឡាករ អុំ ទូក យ៉ាង មមាញឹក ផងដែរ ។ ពួកគាត់ បាន បង្ហាញ អារម្មណ៍ សប្បាយរីករាយ ដែល បាន ចូលរួម ប្រណាំង ទូក ង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក នេះ ។
ក្នុង ឱកាស ដឹកនាំ ក្រុម កីឡាករ អុំ ទូក មក ចូលរួម ប្រណាំង នេះ លោក ហាក់ ម៉ុង ហួត អភិបាល ស្រុក បារាយណ៍ ខេត្ត កំពង់ធំ បាន បង្ហាញ ចំណាប់អារម្មណ៍ ថា ការ ដែល ប្រជាពលរដ្ឋ មាន ឱកាស ចូលរួម ក្នុង ពិធី បុណ្យ កម្សាន្ត នេះ គឺ ដោយសារ ប្រទេស មាន សុខ សន្តិភាព មាន ការអភិវឌ្ឍ ប្រជាពលរដ្ឋ មាន ភាព សម្បូរសប្បាយ ។
ប្រជាពលរដ្ឋ ខ្មែរ មាន ការគាំទ្រ ជាខ្លាំង លើ ការប្រណាំង ទូក នេះ ។ ជារៀងរាល់ ឆ្នាំ នៅ តាម ជ្រាំង ទន្លេ មុខ ព្រះបរម រាជ វាំង មាន ប្រជាពលរដ្ឋ ខ្មែរ យ៉ាង ច្រើន បាន នាំគ្នា ទៅ អង្គុយ ទស្សនា ដោយ មាន ពលរដ្ឋ ខ្លះ បាន នាំ កូន ចៅ ទៅ ទស្សនា ផងដែរ ។
បើ ទោះបី ប្រជាពលរដ្ឋ ខ្មែរ ចូលចិត្ត ទស្សនា ការប្រណាំង ទូក យ៉ាងណា ក្តី តែ មាន ប្រជាពលរដ្ឋ ខ្មែរ ខ្លះ ក៏ មិន ទាន់ បាន យល់ ពី នីតិវិធី នៃ ការផ្គូផ្គង ការប្រណាំង និង ការផ្តល់ ពិន្ទុ ដល់ ទូក ផងដែរ ។
សម្តេច នាយក រដ្ឋមន្ត្រី បន្ថែម ថា បើ ទាក់ទង នឹង អធិបតេយ្យភាព បូរណភាព ទឹកដី កម្ពុជា និង សុខ សន្តិភាព របស់ ប្រជាជន ខ្មែរ កុំ ថា ឡើយ រុញ ទូក បណ្ដោយ ទឹក ទោះ ត្រូវ អូសរថ ក្រោះ ឡើង ភ្នំ ក៏ ត្រូវតែ ធ្វើ ។
