( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន Solidus ដែល ជា ក្រុមហ៊ុន ឈាន មុខ គេ ក្នុង វិស័យ អភិវឌ្ឍន៍ ម៉ាក យីហោ ទីផ្សារ ការផ្សព្វផ្សាយ ពាណិជ្ជកម្ម សេវា ផ្តល់ ប្រឹក្សា អាជីវកម្ម ឥឡូវនេះ បាន ត្រៀម រួចរាល់ ដើម្បី ណែនាំ នូវ សេវាកម្ម ថ្មី មួយ ទៀត មកកាន់ ទីផ្សារ ប្រទេស កម្ពុជា ។
ដូច ដែល ទស្សនវិទូ ក្រិច លោក ប្លាតូ បាន និយាយ ថា « អ្នក អាច រៀន ពី មនុស្ស ម្នាក់ បាន តាមរយៈ ការលេង ក្នុង រយៈពេល មួយ ម៉ោង ជាជាង រៀន ពី មនុស្ស ម្នាក់ រយៈពេល មួយ ជីវិត តាម ការសន្ទនា ជាមួយគ្នា ។
វិធីសាស្ត្រ សម្របសម្រួល ដោយ ប្រើ LEGO® ដើម្បី ជួយ បុគ្គលិក ហ៊ាន និយាយ ពី គំនិត របស់ ពួកគេ ដែល ពួកគេ គិត ថា នឹង មិន អាច ទៅ រួច ។ ការតភ្ជាប់ រវាង ដៃ និង ចិត្ត ដូច ដែល គេ បាន ហៅ ថា ការតភ្ជាប់ ប្រព័ន្ធ ប្រសាទ ទៅនឹង ដៃ បាន បើក ផ្លូវ មួយ ថ្មី ដើម្បី ទទួលបាន ចំណេះដឹង របស់ អ្នក ។ វា បាន ផ្តល់ នូវ ទំនុកចិត្ត ដល់ ក្រុមការងារ ម្នាក់ ៗ ដើម្បី ចូលរួម ចែករំលែក ពី គំនិត របស់ ពួកគេ មិន ថា អ្នក បង្ហាញ ពី ចំណាប់អារម្មណ៍ ឬ អត់ ទេ អ្នក នឹង ត្រូវ និយាយ និង រកឃើញ ពី ពិភពលោក ថ្មី មួយ ដែល ឋិត ក្នុង ខួរក្បាល របស់ អ្នក ។
សិក្ខារ សិលា បណ្តុះបណ្តាល នេះ នៅ ពេល ដែល ត្រូវបាន អនុវត្ត ម្តង ហើយ ម្តង ទៀត នឹង ត្រូវ ដាក់ ឱ្យ ដំណើរការដល់ អតិថិជន នៅឯ រាជធានី ភ្នំពេញ ។ ហើយ នា ពេល ឆាប់ ៗ នេះ នឹង ពង្រីក ទៅដល់ សាលារៀន សាកលវិទ្យាល័យ អង្គការ ក្រៅ រដ្ឋាភិបាល នានា នៅ កម្ពុជា និង រាជ រដ្ឋាភិបាល ផងដែរ ។
បានជា វិធីសាស្រ្ត នេះ ជោគជ័យ គឺ ដោយសារ៖
* ការតភ្ជាប់ រវាង ដៃ និង ចិត្ត ដោយ ប្រើ ដៃ ទាំង ពីរ បើក ខួរក្បាល ទាំង សងខាង * ការលេង ដែល អនុញ្ញាត្តិ ឱ្យ អ្នក ទាំងអស់ គ្នា មាន អារម្មណ៍ ថា គំនិត របស់ ពួកគេ ត្រូវបាន ឮ * មាន លក្ខណៈ សប្បាយ បែប កម្សាន្ត និង បង្កើត សកម្មភាព មិត្តភាព
ក្រុម មុខ សញ្ញា ធ្វើ សកម្មភាព ឆក់ ប្លន់ លើ ដង វិថី នេះ ត្រូវបាន កម្លាំង សមត្ថកិច្ច ទាំង នគរបាល និង កងរាជអាវុធហត្ថ បាន ចាប់ខ្លួន និង បង្ក្រាប ជា បន្តបន្ទាប់ ច្រើន ករណី ផងដែរ ។ បើ ទោះបី សកម្មភាព បង្ក្រាប លើ ក្រុម បង្ក អសន្តិសុខ សង្គម ទាំង នេះ ត្រូវបាន ធ្វើឡើង ជាញឹកញាប់ យ៉ាងណា ក្តី តែ សកម្មភាព ចោរកម្ម លើ ដង វិថី នៅតែ បន្ត កើតមាន ។ បើ តាម របាយការណ៍ របស់ សមត្ថកិច្ច ក្រុម ចោរ ឆក់ លើ ដង វិថី នេះ មាន ខ្លះ ជា មុខសញ្ញា ចាស់ ដែល ធ្លាប់ បាន បង្ក្រាប ជាច្រើន លើក មក ហើយ ផងដែរ ។
ការឆក់ លើ ដង វិថី ករណី ខ្លះ បាន បង្ក ទៅជា ការសោគស ង្រេង និង ឈឺចាប់ ខ្លាំង ណាស់ ផងដែរ សម្រាប់ ក្រុមគ្រួសារ របស់ ជនរងគ្រោះ ព្រោះ សកម្មភាព ឆក់ ទាំងនេះ ករណី ខ្លះ មិន ត្រឹមតែ ធ្វើឲ្យ ជនរងគ្រោះ ត្រឹមតែ បាត់បង់ ទ្រព្យសម្បត្តិ ឬ រងរបួស រូបរាងកាយ នោះ ទេ វា ថែមទាំង ធ្វើឲ្យ ជនរងគ្រោះ បាន គ្រោះថ្នាក់ ដល់ បាត់បង់ អាយុជីវិត ថែម ទៀត ផង ។
ក្រោយ ការកើត ហេតុការណ៍ រយៈពេល ប្រមាណ ជាមួយ សប្តាហ៍ ពោលគឺ នៅ ថ្ងៃសុក្រ ទី ០៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ក្រុម ជនសង្ស័យ ពីរ នាក់ ក្នុង ចំណោម ៤នាក់ ត្រូវបាន កម្លាំង នគរបាល តាម វែក មុខ និង ចាប់ខ្លួន ជា បន្តបន្ទាប់ នៅក្នុង ខេត្ត ត្បូងឃ្មុំ និង នៅ កោះ ពេជ្រ ។ ខណៈ ជនសង្ស័យ ពីរ នាក់ ទៀត កំពុង គេចខ្លួន នៅ ឡើយ ។
ជនសង្ស័យ ដែល ចាប់ខ្លួន បាន នេះ មាន ឈ្មោះ ម៉ឹង ប៊ុន វាសនា ហៅ អាបូ អាយុ ២១ ឆ្នាំ ស្នាក់ នៅ ភូមិ មិត្តភាព សង្កាត់ ឫស្សីកែវ ខណ្ឌ ឫស្សីកែវ និង ម្នាក់ ទៀត ឈ្មោះ ខៀវ ផល្លា ហៅ ខ្លា អាយុ ២១ ឆ្នាំ រស់ នៅ ផ្ទះ ជួល ក្នុង ភូមិ ដើម ចាន់ សង្កាត់ ច្បារអំពៅ២ ខណ្ឌ ច្បារអំពៅ ។
ទន្ទឹមនឹង ការចាប់ បាន ប្រជាពលរដ្ឋ បាន សម្តែង ការភ្ញាក់ផ្អើល ខ្លាំង ដោយសារតែ ក្រុម ចោរ ឆក់ នេះ ពួកគេ ទើបតែ ចេញ ពី ពន្ធនាគារ បាន ប៉ុន្មាន ខែ ប៉ុណ្ណោះ ។ របាយការណ៍ សមត្ថកិច្ច បាន ឲ្យដឹង ថា ជនសង្ស័យ ម៉ឹង ប៊ុន វាសនា ទើបតែ ចេញ ពី ពន្ធនាគារ កាលពី ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០១៨ ខណៈ ជនសង្ស័យ ខៀវ ផល្លា ទើប ចេញ ពី ពន្ធនាគារ កាលពី ថ្ងៃទី ៧ ខែសីហា ឆ្នាំ ២០១៨ ផងដែរ ។ ការជាប់ ពន្ធនាគារ លើក មុន នេះ ដោយសារតែ ការធ្វើ សកម្មភាព ឆក់ ផងដែរ ។
ក្រៅពី ករណី ខាងលើ នេះ នៅ មាន ជនសង្ស័យ ក្នុង ករណី ឆក់ ប្លន់ ផ្សេង ៗ ទៀត ក៏ ត្រូវបាន សមត្ថកិច្ច អះអាង ថា ជា មុខសញ្ញា ចាស់ ហើយ ធ្លាប់ ជាប់ ពន្ធនាគារ ផងដែរ ។ កម្លាំង សមត្ថកិច្ច មួយចំនួន បាន បង្ហើប ថា ក្រុម ចោរ ឆក់ ទាំងនេះ ភាគ ច្រើន ជា មុខសញ្ញា ចាស់ ដែល ធ្លាប់ បាន បង្ក្រាប ជាច្រើន ដង មក ហើយ ។ លើស ពី នោះ ទៀត រាល់ សកម្មភាព ឆក់ ទាំងអស់ ឲ្យ តែ មាន កាមេរ៉ា សុវត្ថិភាព ចាប់ មុខ បាន គឺ សមត្ថកិច្ច មិន លំបាក ស្វែងរក នោះ ឡើយ ព្រោះ ពួកគេ ជា មុខសញ្ញា ចាស់ ដែល ងាយស្រួល ក្នុង ការតាម វែក មុខ ។
សកម្មភាព ឆក់ លើ ដង វិថី ដែល ករណី ខ្លះ ឈានដល់ បង្ក គ្រោះថ្នាក់ ដល់ អាយុជីវិត របស់ ជនរងគ្រោះ ហើយ ក្រុម ជនបង្ក ភាគ ច្រើន ជា មុខសញ្ញា ដដែល នេះ កំពុង ក្លាយទៅជា ប្រធានបទ មួយ ត្រូវបាន លើក មក ជជែក ដេញដោល គ្នា ជាខ្លាំង ពី មហាជន ។ មាន អ្នក ខ្លះ បាន លើកឡើង ថា មូលហេតុ ដែល នាំឲ្យ ក្រុម ជនល្មើស ក្នុង រឿង ឆក់ ប្លន់ នេះ គ្មាន ការខ្លាច រអា និង មិន រាងចាល ដោយសារតែ ការដាក់ទោសទណ្ឌ ទៅ លើ ក្រុម ជនល្មើស នេះ មិន បាន ធ្ងន់ធ្ងរ ការជាប់ ពន្ធនាគារ នោះ មាន រយៈពេល ខ្លី ជាដើម ។
អ្នក ខ្លះ ទៀត បាន លើកឡើង ថា ការ ដែល ពួកគេ មិន រាងចាល នេះ ដោយសារ មាន ករណី ខ្លះ មាន ការបន្ធូរបន្ថយ ពី សមត្ថកិច្ច ឬ តុលាការ ជាដើម ឬ អាច មាន ករណី ខ្លះ ទៀត អាច មាន ការត្រូវរ៉ូវ គ្នា រវាង សមត្ថកិច្ច និង តុលាការ ហើយ លួច ដោះលែង ក្រុម ជនសង្ស័យ ស្ងាត់ ក្រោម កិច្ច សម្របសម្រួល ក្រៅ ប្រព័ន្ធ ច្បាប់ ។ អ្នក ខ្លះ ទៀត លើកឡើង ថា ដោយសារ ការ អនុវត្តន៍ វិន័យ ចំពោះ អ្នកទោស នៅក្នុង ពន្ធនាគារ មាន សភាព ធូរស្រាល ទើប ធ្វើឲ្យ ពួកគេ មិន ខ្លាច រអា ចំពោះ ពន្ធនាគារ ។
មហាជន មើលឃើញ ថា កិច្ចសហការ ដ៏ ស្អិត ល្មួត រវាង កងកម្លាំង នគរបាល មន្ត្រី តុលាការ និង មន្ត្រី ពន្ធនាគារ អនុវត្តន៍ ច្បាប់ ឲ្យបាន តឹងរឹង និង ធ្ងន់ធ្ងរ ដោយ គ្មាន ការយោគយល់ និង មិន ទទួល ការអន្តរាគមន៍ នានា ទើប អាច លុបបំបាត់ ក្រុម បង្ក អសន្តិសុខ លើ ដង វិថី មាន ប្រសិទ្ធភាព ។
មហាជន បាន លើកឡើង ទៀត ថា កម្លាំង សមត្ថកិច្ច តុលាការ និង មន្ត្រី ពន្ធនាគារ មិន គួរ បន្ត បណ្តែត បណ្តោយ ឲ្យ សេចក្តីសុខ របស់ ប្រជាពលរដ្ឋ កម្ពុជា ដែល សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ប្រឹង ស្រោចស្រង់ ចេញ ពី ភ្លើង សង្គ្រាម និង ប្រឹង លើកស្ទួយ ជីវភាព ឲ្យ កាន់តែ ប្រសើរ ត្រូវបាន បំផ្លាញ ដោយ ក្រុម ចោរ ឆក់ ប្លន់ ដែល ជា មុខសញ្ញា ដដែល ៗ នេះ ឡើយ ៕
