( ត្បូងឃ្មុំ ) ៖ លោក អង្គ វង្ស វឌ្ឍនា រដ្ឋមន្ដ្រី ក្រសួង យុត្តិធម៌ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតី ប្រកាស ឱ្យ ចូលកាន់ តំណែង ជា ផ្លូវការ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ត្បូងឃ្មុំ ដោយ លោក ឡុង ហុក ម៉េង ត្រូវបាន តែងតាំង ជំនួស លោក ហៀង សុភក្ត្រ ដែល ត្រូវ ផ្ទេរ ទៅ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត មណ្ឌលគិរី ។
ពិធី ប្រកាស ផ្ទេរ និង ចូលកាន់ មុខតំណែង ជា ផ្លូវការ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ជា ម ច័ន្ទ សោភ័ណ្ឌ អភិបាល ខេត្ត ត្បូងឃ្មុំ . លោក ជុំ ស ប្រធាសាលាដំបូង ខេត្ត . ស្នងការ នគរបាល ខេត្ត . មេបញ្ជាការ អាវុធហត្ថ ខេត្ត . បញ្ជាការ តំបន់ ប្រតិបត្តិការ រង ខេត្ត ព្រមទាំង មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ ក្រសួង ថ្នាក់ដឹកនាំ ខេត្ត ថ្នាក់ដឹកនាំ សាលាដំបូង ព្រះរាជអាជ្ញា រង មន្ដ្រីរាជការ និង កងកម្លាំង នៅក្នុង ខេត្ត ជាច្រើន រូប ទៀត ផងដែរ ។
ជាមួយគ្នា នេះ ដែរ លោក ឡុង ហុក ម៉េង ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ត្បូងឃ្មុំ បាន ឡើង ធ្វើ ការប្តេជ្ញាចិត្ត ពង្រឹង វិន័យ ការងារ រក្សា នូវ សាមគ្គីភាព ផ្ទៃក្នុង រវាង ស្ថាប័ន អយ្យការ និង តុលាការ ដើម្បី ពង្រឹង សមត្ថភាព បច្ចេកទេស ការងារ និង សហការធ្វើ ការងារ ល្អ ជាមួយ អាជ្ញាធរ រដ្ឋបាល គ្រប់ ថ្នាក់ ក្នុង ខេត្ត មន្ត្រី នគរបាល យុត្តិធម៌ គ្រប់ លំដាប់ថ្នាក់ ក៏ ដូចជា មន្ត្រី សាធារណៈ ដទៃ ទៀត ដែល ច្បាប់ ប្រគល់ សិទ្ធិ ឱ្យ ក្នុង ការបង្ក្រាប បទល្មើស ព្រហ្មទណ្ឌ ។
លោក ជា ម ច័ន្ទ សោភ័ណ្ឌ អភិបាល ខេត្ត ត្បូងឃ្មុំ ក៏ បាន ស្នើឲ្យ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ត្បូងឃ្មុំ ត្រូវ បន្ត ពង្រឹង កិច្ចសហការ ជាមួយ មន្ទីរ ជំនាញ ពាក់ព័ន្ធ ជុំវិញ ខេត្ត ក៏ ដូចជា អាជ្ញាធរ ខេត្ត គ្រប់ ជាន់ ថ្នាក់ ដើម្បី ដោះស្រាយ រាល់ បញ្ហា បណ្តឹង ផ្សេង ៗ ឬ សំណុំរឿង ដែល នៅ សេសសល់ មិន ទាន់ បាន ដោះស្រាយ ដោយ ឈរ លើ តម្លាភាព ភាពយុត្តិធម៌ ៕
ប្រតិកម្ម នេះ បាន ធ្វើឡើង បន្ទាប់ពី លោក ហ៊ាង រិទ្ធី បាន ចេញមុខ ទទួលស្គាល់ តាមរយៈ វិទ្យុ អាស៊ី សេរី ថា លោក មិន មែន ជា មេធាវី ដែល មាន ឈ្មោះ ត្រឹមត្រូវ នៅក្នុង បញ្ជី គណៈ មេធាវី នោះ ទេ ។ ជាមួយគ្នា នេះ លោក អះអាង ថា លោក មាន តួនាទី ធំ ៗ ជាច្រើន ដោយ មិន ចង់បាន តួនាទី ឬ ងារ ជា មេធាវី នោះ ទេ ។
លោក សួន វិសាល បាន បដិសេធ មិន ទទួលយក ការបកស្រាយ របស់ លោក ហ៊ាង រិទ្ធី ដោយសារតែ កន្លងមក លោក បាន ប្រើប្រាស់ ការបន្លំ តួនាទី ជា មេធាវី នៅ តាម បណ្តាញ ព័ត៌មាន ជាពិសេស នៅលើ វិទ្យុ អាស៊ី សេរី តែម្តង ។ មិន តែ ប៉ុណ្ណោះ លោក អះអាង ថា លោក ហ៊ាង រិទ្ធី ជា មនុស្ស មិន ចេះ គោរព សម្តី ដោយ ពេល មុន លោក បកស្រាយ ថា មេធាវី ជា អ្នកប្រាជ្ញ តែ ពេលនេះ លោក បែរជា បកស្រាយ ផ្សេង ទៅ វិញ ។
លោក សួន វិសាល បាន ពន្យល់ ថា មេធាវី មាន តួនាទី សំខាន់ ណាស់ ក្នុង ការបម្រើ ឱ្យ វិស័យ យុត្តិធម៌ និង ជួយ រក ជូន ពលរដ្ឋ ក្នុង ប្រព័ន្ធ តុលាការ ។ វា ជា តួនាទី ដ៏ មាន សារសំខាន់ នៅក្នុង សង្គម មិន អាច ខ្វះ បាន ហើយ មិន អាច និយាយ ថា ជា តួនាទី តូចតាច នោះ ទេ ។
សូម បញ្ជាក់ ថា ក្នុង សេចក្តីប្រកាស នៅ ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ម្សិលមិញ នេះ គណៈ មេធាវី ក៏ បាន ប្រកាស ចាត់ វិធានការ ផ្លូវ ច្បាប់ ចំពោះ លោក ហ៊ាង រិទ្ធី ដែល បាន ប្រើប្រាស់ តួនាទី មេធាវី កន្លងមក នៅលើ ប្រព័ន្ធ ផ្សព្វផ្សាយ ផងដែរ ៕
សេចក្តីប្រកាស ខាងលើ បាន ឲ្យដឹង ថា នា ថ្ងៃទី ១៩ដល់ ទី២៥ ខែវិច្ឆិកា ប្រព័ន្ធ មីស៊ីល ការពារ អាកាស សម្រាប់ តំបន់ អាក់ទិច Tor-M2DT មួយ ក្រុម ដំបូង នឹង ត្រូវ ដាក់ ឲ្យ ធ្វើ ប្រតិបត្តិការ ជា ផ្លូវការ នៅក្នុង ជួរ កម្លាំង យោធា ភាគ ខាងជើង ។
សូម ជម្រាប ថា ការផ្សព្វផ្សាយ ព័ត៌មាន និង កម្មវិធី កម្សាន្ត នានា របស់ Fresh News គឺ ផ្សាយ ចេញ ព្រម ៗ គ្នា គ្រប់ ប្រព័ន្ធ តែម្ដង ៕ កូរ៉េ ខាងជើង ធ្វើតេស្ដ អាវុធ មាន បច្ចេកវិទ្យា ខ្ពស់ ថ្មី មួយ ចំពេល កំពុង តានតឹង ជាមួយ សហរដ្ឋ អាមេរិក
( សេអ៊ូល ) ៖ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន បាន ចូលរួម ទស្សនា និង បញ្ជា ដោយ ផ្ទាល់ ការធ្វើតេស្ដ អាវុធ ថ្មី មួយ បំពាក់ ដោយ បច្ចេកវិទ្យា ខ្ពស់ ខណៈ កំពុង មាន ភាពតានតឹង ជាមួយ សហរដ្ឋ អាមេរិក និង មាន ការសង្ស័យ ជាច្រើន ថា របប ដឹកនាំ ទីក្រុង ព្យុងយ៉ាង នៅតែ បន្ត លួចលាក់ អភិវឌ្ឍ អាវុធ នុយក្លេអ៊ែរ ។ នេះ បើ តាម KCNA ដកស្រង់ ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ថ្ងៃសុក្រ ទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
គួរ បញ្ជាក់ ថា បើ តាម KCNA ការធ្វើតេស្ដ អាវុធ ថ្មី ខាងលើ គឺ ធ្វើឡើង ប្រកបដោយ ជោគជ័យ ។ ក៏ប៉ុន្តែ សារព័ត៌មាន រដ្ឋ កូរ៉េ ខាងជើង មួយ នេះ មិន បាន បញ្ជាក់ ថា ជា ប្រភេទ អាវុធ អ្វី នោះ ទេ ដោយ គ្រាន់តែ អះអាង ថា វា មិន មែន ជា មីស៊ីល រយៈចំងាយ ឆ្ងាយ ហើយក៏ មិន មែន ជា ប្រភេទ អាវុធ នុយក្លេអ៊ែរ ដែរ ៕ សម្តេច តេជោ ហ៊ុន សែន៖ គ្មាន ទេ ការហត់ នឿយ . ពេញចិត្ត បម្រើ ប្រទេសជាតិ និង ប្រជាជន
( ភ្នំពេញ ) ៖ ជាមួយ ការបង្ហាញ ដំណឹង ក្នុង ការដឹកនាំ គណៈប្រតិភូ ត្រឡប់ ពី កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ រយៈពេល ៣ ថ្ងៃ នៅ ប្រទេស សិង្ហបុរី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន លើកឡើង ថា គ្មាន ទេ ពាក្យ ថា នឿយហត់ ឬ លំបាក សម្រាប់ សម្តេច ហើយ សម្តេច ពេញចិត្ត ដែល បាន បម្រើ ប្រទេសជាតិ និង ប្រជាជន ឲ្យ រស់ នៅ ដោយ សុខ សប្បាយ ក្នុង សុខ សន្តិភាព ។
សម្តេច តេជោ បាន បង្ហាញ បញ្ជាក់ ផងដែរ ពី លទ្ធផល ទទួលបាន ពី កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ។ សម្តេច នាយក រដ្ឋមន្ត្រី បាន លើកឡើង ថា « ភាពរឹងមាំ និង នាវានុវត្តន៍ របស់ អាស៊ាន » គឺជា ប្រធានបទ នៃ កិច្ចប្រជុំ កំពូល លើក ទី ៣៣ ដែល បាន ទទួល លទ្ធផល វិជ្ជមាន ល្អ ទាំង សម្រាប់ កម្ពុជា និង ប្រទេស សមាជិក អាស៊ាន ទាំងមូល » ។
សម្តេច ប្រមុខ រាជ រដ្ឋាភិបាល បន្ថែម ថា ពិត ណាស់ ប្រទេស មួយ មិន អាច សម្រេច កិច្ចការ ធំ ៗ ដោយ ប្រសិទ្ឋភាព បាន ទាំងស្រុង ឡើយ គឺ ត្រូវ សហការ រួមគ្នា ដោះស្រាយ បញ្ហា ប្រឈម នានា រួមទាំង បង្កើន ទំនាក់ទំនង ពាណិជ្ជកម្ម វិនិយោគ សេដ្ឋកិច្ច ដើរ ឲ្យ ទាន់ តាម បច្ចេកវិទ្យា ជំរុញ ការបណ្តុះបណ្តាល ធនធាន មនុស្ស ព្រមទាំង រួមគ្នា ការពារ ធនធាន សម្បត្តិ ធម្មជាតិ បរិស្ថាន និង ទប់ស្កាត់ អំពើ ភេរកម្ម ដើម្បី ពង្រឹង សន្តិភាព ដែល នាំមក នូវ ផលប្រយោជន៍ និង វិបុលភាព សម្រាប់ ប្រជាជាតិ ទាំងមូល ។
សម្តេច តេជោ បាន បញ្ជាក់ ថែម ទៀត ថា តាម ការគ្រោងទុក សម្តេច នឹង អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា នៅ ម៉ោង ១១៖០០ ព្រឹក ថ្ងៃ ដដែល នេះ ៕
សូម កុំ បើកបរ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៥នាក់ និង របួស ១៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៥ ខែវិច្ឆិកា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ស្រាល ៤នាក់ និង របួស ធ្ងន់ ១១នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង១០លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១៣ គ្រឿង . រថយន្ដ ធំ ៤គ្រឿង . រថយន្ដ តូច៤ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . ប្រជែង . មិន ប្រកាន់ ស្ដាំ និង បត់ គ្រោះថ្នាក់ ។
បញ្ហា សំខាន់ ៗ ចំនួន ៦ ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន លើកឡើង ក្នុង កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា លើក ទី ១៣
( សិង្ហបុរី ) ៖ កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា លើក ទី ១៣ ត្រូវបាន ធ្វើឡើង នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ដោយ មាន ការពិភាក្សា លើ បញ្ហា សំខាន់ ៗ ជាច្រើន ដែល កំពុង ប្រឈម នៅក្នុង តំបន់ និង លើ ពិភពលោក ។
ទី៥. ចំពោះ បញ្ហា សមុទ្រ ចិន ខាងត្បូង កម្ពុជា សូម គាំទ្រ ការអនុវត្ត ឲ្យបាន ពេញលេញ និង ប្រកបដោយ ប្រសិទ្ធភាព នូវ សេចក្តីថ្លែងការណ៍ ស្តីពី ការប្រតិបត្តិ របស់ បណ្តា ភាគី នៅ សមុទ្រ ចិន ខាងត្បូង (DOC) និង ដំណើរការ តាក់តែង (COC) ដែល ជា ដំណើរការ វែងឆ្ងាយ មួយ ។
ក្នុង កិច្ចប្រជុំ កំពូល ដ៏ មាន សារសំខាន់ នោះ មេដឹកនាំ នៃ ប្រទេស អាស៊ី បូព៌ា បាន ឯកភាព គ្នា ក្នុង ការឈាន ទៅ ចេញ សេចក្តីប្រកាស របស់ ប្រទេស កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា លើក ទី១៣ ។ សេចក្តីប្រកាស របស់ ថ្នាក់ដឹកនាំ កិច្ចប្រជុំ កំពូល អាស៊ី បូព៌ា ស្តីពី ការប្រយុទ្ធ ប្រឆាំង នឹង កាកសំណល់ ប្លាស្ទីក នៅក្នុង លំហ សមុទ្រ ។
សេចក្តីប្រកាស របស់ ថ្នាក់ ដឹកនាំ អាស៊ី បូព៌ា ស្តីពី ទីក្រុង ឆ្លាត អាស៊ាន ។ សេចក្តីប្រកាស របស់ ថ្នាក់ដឹកនាំ អាស៊ី បូព៌ា ស្តីពី ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ខាង សន្តិសុខ ផ្នែក បច្ចេកវិទ្យា ព័ត៌មាន និង ទំនាក់ទំនង និង សេដ្ឋកិច្ច ឌីជីថល ។ សេចក្តីប្រកាស របស់ ថ្នាក់ដឹកនាំ អាស៊ី បូព៌ា ស្តីពី សន្តិសុខ នុយក្លែ អ៊ែរ ។ សេចក្តីប្រកាស របស់ ថ្នាក់ដឹកនាំ អាស៊ី បូព៌ា ស្តីពី ការប្រយុទ្ធ ប្រឆាំង នឹង ការគម្រាមកំហែង របស់ ភេរវករ បរទេស និង ជន និវត្តន៍ ពាក់ព័ន្ធ ៕
អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ បញ្ចប់ គម្រោង អ៊ុត ផ្លូវ រត់ យន្តហោះ ថ្មី ប្រវែង ជាង ៣ពាន់ ម៉្រែត ដើម្បី ពង្រឹង សុវត្ថិភាព ផ្លូវ អាកាស
( ភ្នំពេញ ) ៖ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ បាន នឹង កំពុង ពង្រឹង សុវត្ថិភាព ផ្លូវ អាកាស ដោយ បញ្ចប់ គម្រោង ការអភិវឌ្ឍ ហេដ្ឋ រចនាសម្ព័ន្ធ អ៊ុត ផ្លូវ រត់ យន្តហោះ ថ្មី ប្រវែង ជាង ៣ពាន់ ម៉្រែត ដែល ចំណាយ ថវិការ ជាង ១២លាន ដុល្លារ ដើម្បី ឆ្លើយតប ទៅនឹង កំណើន ភ្ញៀវ ទេសចរ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ចូលមកកាន់ កម្ពុជា ក៏ ដូចជា ដើម្បី ធានា ដល់ សុវត្ថិភាព ក្នុង ការចុះចត យន្តហោះ ប្រភេទ ធំ ៗ ហើយ មួយ វិញទៀត គឺ ដើម្បី ត្រៀមលក្ខណៈ សម្បត្តិ សម្រាប់ នា ពេល ខាងមុខ ផងដែរ ។
លោក នាយក បាន បញ្ជាក់ ទៀត ថា « សម្រាប់ ព្រលានយន្ត អន្តរជាតិ ភ្នំពេញ ចាប់ពី ខែមករា រហូតដល់ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ការហោះហើរ មាន ការកើនឡើង រហូតដល់ទៅ ២០ % បើ ធៀប នឹង ឆ្នាំ មុន ដែល មាន យន្តហោះ ចុះចត ត្រឹមតែ ៥ម៉ឺន ទៅ ៥ម៉ឺន ៥ពាន់ គ្រឿង តែ ប៉ុណ្ណោះ ដូចនេះ ហើយ គោលបំណង សំខាន់ នៃ ការជួសជុល និង ការកែលំអរ ថ្មី នេះ គឺ ដើម្បី ធានា ឲ្យ ការចុះចត យន្តហោះ គ្រប់ ប្រភេទ ប្រកបដោយ សុវត្ថិភាព ទាំង ក្នុង ពេល បច្ចុប្បន្ន និង សម្រាប់ រយៈពេល ១៥ ឆ្នាំ ខាងមុខ ទៀត » ។
លោក បាន បន្ត ថា នៅ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ នឹង មាន គម្រោង អភិវឌ្ឍ ជា បន្តបន្ទាប់ ទៀត ពោល គឺ មាន ចក្ខុវិស័យ សម្រាប់ ពង្រីក ចំណត យន្តហោះ ឲ្យបាន ១០កន្លែង ថែម ទៀត ក៏ ដូចជា ពង្រីក អគារ សម្រាប់ ទទួល ភ្ញៀវ អគារ សម្រាប់ លក់ដូរ ចំណីអាហារ ឲ្យ សម្បូរបែប ហើយ ក្នុង ពេល បច្ចុប្បន្ន នេះ ក៏ បាន កំពុង កសាង អគារ ថ្មី មួយ សម្រាប់ ទុកដាក់ រថយន្ត ដឹក សម្ភារៈ . ដឹក ភ្ញៀវ ទេសចរ . និង រថយន្ត ពន្លត់ អគ្គិភ័យ ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក សយ សុខាន់ អនុ រដ្ឋលេខាធិការ នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល បាន ថ្លែង ឲ្យដឹង ថា « ការចាក់ ពង្រឹង ផ្លូវ រត់ យន្តហោះ ថ្មី នេះ គឺជា ការស្ថាបនា ផ្លូវ រត់ ថ្មី មួយ ឲ្យ មាន ស្តង់ដារ ទំនើប ដោយ ធានា បាន នូវ សុវត្តិភាព ខ្ពស់ និង ការទាក់ទាញ ភ្ញៀវ ទេសចរ ផងដែរ » ។
ជាមួយគ្នា នោះ លោក បាន ឲ្យដឹង ទៀត ថា រាជ រដ្ឋាភិបាល តាមរយៈ អាកាសចរណ៍ ស៊ីវិល បាន និង កំពុង ពិនិត្យ លទ្ធភាព លើ គម្រោង ក្នុង ការអភិវឌ្ឍ អាកាសយានដ្ឋាន ក្នុង ស្រុក បន្ថែម មួយ ចំនួន ទៀត ដូចជា នៅ ខេត្ត ស្ទឹងត្រែង . ប៉ោយប៉ែត . រតនគិរី . និង មណ្ឌលគិរី ជាដើម ។ ដោយឡែក រាជ រដ្ឋាភិបាល ក៏ បាន សម្រេច ឲ្យ មាន ការសាងសង់ ព្រលានយន្តហោះ ថ្មី មួយ ទៀត លំដាប់ថ្នាក់ For E នៅ ខេត្ត សៀមរាប ដែល អាច ចុះចត យន្តហោះ បាន គ្រប់ ប្រភេទ ។
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ កម្ពុជា មាន ក្រុមហ៊ុន ហោះហើរ អន្តរជាតិ ចំនួន ៣៨ និង ក្រុមហ៊ុន ក្នុង ស្រុក ចំនួន ៨ កំពុង ហោះហើរ ប្រត្តិការ ចេញ ពី ក្នុង ស្រុក ទៅ ក្រៅ ប្រទេស ។ ជាមួយគ្នា នេះ ក៏ មាន សមត្ថភាព ទទួល ទេសចរណ៍ ដែល នៅ ឆ្នាំ ២០១៧ ទទួលបាន ៨លាន នាក់ និង ឆ្នាំ ២០១៨ នេះ ទទួលបាន ១០លាន នាក់ ហើយ រំពឹង ថា នៅ ឆ្នាំ ២០១៩ ខាងមុខ នេះ មាន ភ្ញៀវ ទេសចរ ចេញ ចូល តាម ច្រក អន្តរជាតិ នេះ មាន ការកើនឡើង រហូតដល់ទៅ ១២លាន នាក់ ផងដែរ ៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នាំយក ទេយ្យ វត្ថុ និង បច្ច័យ ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ដ ចំនួន ២ នៅ ខេត្ដ មណ្ឌលគិរី (Video inside) ( មណ្ឌលគិរី ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង គណៈប្រតិភូ អម ដំណើរ នៅ រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ បូជា ទៀន ធូប ផ្កា ភ្ញី ថ្វាយ ព្រះសម្មាសម្ពុទ្ធ និង នាំយក ទេយ្យ វត្ថុ រួមទាំង បច្ច័យ ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ត សែនមនោរម្យ និង វត្ត ព្រះពុទ្ធ មណ្ឌលគិរី នៅ ខេត្ដ មណ្ឌលគិរី ។
ទន្ទឹម នឹង នោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត មាន សទ្ធា ជ្រះថ្លា និង ព្រះពុទ្ធ សាសនា បាន ប្រគេន បច្ច័យ ផ្ទាល់ខ្លួន ផងដែរ និង ជូន នូវ អំណោយ ដល់ យាយ ជី តា អាចារ្យ វត្ត និង សិស្សានុសិស្ស សរុប ចំនួន ៧៥ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា ៥ម៉ឺន រៀល និង ក្រណាត់ ស១ដុំ ថវិកា ១ម៉ឺន រៀល ទៀត ។
សូម ជម្រាប ថា សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ពុទ្ធសាសនូបត្ថម្ភ ដ៏ ជ្រះថ្លា មួយ ក្នុង ព្រះពុទ្ធ សាសនា តែងតែ ដឹកនាំ មន្ដ្រី គ្រប់ លំដាប់ថ្នាក់ នៃ កាកបាទ ក្រហម កម្ពុជា និង មន្ដ្រី ជាច្រើន ផ្នែក ទៀត បូជា ទៀន ធូប ផ្កា ភ្ញី ថ្វាយ ព្រះសម្មាសម្ពុទ្ធ និង នាំយក ទេយ្យ វត្ថុ ជាច្រើន រួមទាំង បច្ច័យ ប្រគេន ព្រះសង្ឃ គង់ នៅ តាម វត្ដ អារាម ដើម្បី ទ្រទ្រង់ និង ជ្រោង ទង់ ព្រះពុទ្ធ សាសនា ដែល ជា សាសនា របស់ រដ្ឋ ឲ្យ កាន់តែ រីកចម្រើន ។
កាយវិការ ដ៏ ថ្លៃថ្លា របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក្នុង ពុទ្ធសាសនា នេះ ទទួលបាន ការវាយតម្លៃ និង កោតសរសើរ ខ្ពស់ ពី ព្រះសង្ឃ យាយ ជី អាចារ្យ វត្ដ និង ប្រជាពុទ្ធ បរិស័ទ ទូទៅ ។
សូម ជម្រាប ថា ក្រៅពី កាយវិការ ដ៏ ថ្លៃថ្លា ក្នុង ព្រះពុទ្ធ សាសនា ដោយ នាំយក ទេយ្យ វត្ថុ និង បច្ច័យ ប្រគេន ព្រះសង្ឃ គង់ នៅ វត្ដ ចំនួន ២ នៅ ខេត្ដ មណ្ឌលគិរី នៅ ថ្ងៃ នេះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក្នុង រយៈពេល ២ ថ្ងៃ មក នេះ នៅ ថ្ងៃទី ១៤ - ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ក៏ បាន ដឹកនាំ គណៈប្រតិភូ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ មនុស្សធម៌ កាកបាទ ក្រហម កម្ពុជា ជូន ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ជិត ៤ពាន់ គ្រួសារ ផងដែរ នៅ ខេត្ដ មណ្ឌលគិរី ផងដែរ ៕
CNBC បាន គូសបញ្ជាក់ នៅក្នុង សេចក្ដីរាយការណ៍ របស់ ខ្លួន ចេញផ្សាយ ក្នុង សប្ដាហ៍ នេះ ដូច្នេះ ថា៖ « ប្រទេស ចំនួន ១៣ កំពុង ចាប់អារម្មណ៍ និង ពិចារណា ចង់ ទិញ S-400 បើ ទោះជា ពួកគេ ដឹង ថា ការទិញ អាវុធ ពី រុស្ស៉ី អាចនឹង ត្រូវ ប្រឈមមុខ នឹង ការដាក់ទណ្ឌកម្ម ពី សហរដ្ឋ អាមេរិក ក៏ដោយ » ។ ស្ថានីយ ទូរទស្សន៍ អាមេរិក មួយ នេះ ផ្អែក លើ ប្រភព ដែល ខ្លួន ទទួលបាន បាន ឱ្យ ដឹង ទៀត ថា ក្នុង ចំណោម ប្រទេស ទាំង ១៣ ដែល ចាប់អារម្មណ៍ នឹង S-400 មាន ដូចជា អារ៉ាប៊ី សាអូឌីត កាតា អាល់ហ្សេរី ម៉ារ៉ុក អេហ្ស៊ីប វៀតណាម និង អ៉ីរ៉ាក់ ជាដើម ។
សូម ជម្រាប ថា សហរដ្ឋ អាមេរិក បាន បង្កើត ច្បាប់ ថ្មី មួយ ឬ គេ ស្គាល់ ថា CAATSA ដែល គោលដៅ ដាក់ទណ្ឌកម្ម លើ ប្រទេស ទាំង ឡាយ ណា ដែល ទិញ អាវុធ ពី រុស្ស៊ី ខណៈ ប្រទេស ចិន ឥណ្ឌា និង តួកគី ក៏ កំពុង ស្ថិត នៅក្រោម ការព្រមាន ដាក់ទណ្ឌកម្ម ពី ទីក្រុង វ៉ាស៊ីនតោន អនុឡោម តាម ច្បាប់ ថ្មី នេះ ដែរ ៕ កាកបាទ ក្រហម ខេត្ត សៀមរាប ប្រគល់ រង្វាន់ ជ័យលាភី ជូន បេក្ខជន ប្រឡង គំនូរ សិស្ស មធ្យមសិក្សា ក្រោម ប្រធានបទ « សិទ្ធិ ជន ពិការ ក្នុង សុវត្ថិភាព ចរាចរណ៍ និង សង្គម »
ពិធី នេះ បាន ប្រារព្ធ ធ្វើ នៅ សាល ប្រជុំវិទ្យាល័យ ហ៊ុន សែន ស្វាយ ធំ ឃុំ កណ្ដែក ស្រុក ប្រាសាទ បាគង ដែល មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក លោកស្រី សមាជិក សមាជិកា គណៈ កិត្តិយស គណៈកម្មាធិការ សាខា អនុសាខា លោកគ្រូ អ្នកគ្រូ ទីប្រឹក្សា យុវជន កាកបាទ ក្រហម កម្ពុជា និង សិស្សានុសិស្ស បេក្ខជន គូរ គំនូរ មកពី ៨វិទ្យាល័យ ក្នុង ខេត្ត សៀមរាប សរុប ចំនួន ១៥០ នាក់ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក គួយ ណាលីន បាន បញ្ជាក់ ថា មិន ត្រឹមតែ មាន ការយកចិត្ត ទុក្ខ ដាក់ ខ្ពស់ ពីសំណាក់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ចំពោះ ប្រជាពលរដ្ឋ រងគ្រោះហន្តរាយ ប៉ុណ្ណោះ ទេ សម្ដេច ថែមទាំង បាន យកចិត្តទុកដាក់ បំផុត ចំពោះ បងប្អូន ជន ពិការ គ្រោះ ប្រភេទ ដែល ជា ជនរងរងគ្រោះ ។
លោកស្រី បន្ថែម ថា តាមរយៈ ស្នាដៃគូរ គំនូរ ដែល បាល សម្តឹត សម្រាំង ពី គណៈកម្មការ ពិនិត្យ វាយតម្លៃ ឃើញ ថា ពិជា គំនូរ ផុស ចេញ ពី គោល គំនិត ប្អូន ៗ បាន បង្ហាញ ឲ្យ ឃើញ ថា សកម្មភាព ដែល សហគមន៍ ជួយ ដល់ ជន ពិការ ក្នុង ការធ្វើដំណើរ ការរៀបចំ ទី ជម្រាល តាម សាលារៀន ការចូលរួម ក្នុង សកម្មភាព សង្គម ជាដើម ដែល ទាំងអស់ នេះ ពិតជា មាន អត្ថន័យ ល្អ ទាក់នង នឹង ពិការភាព ។
សូម បញ្ជាក់ ថា យុវជន ញ៉ុន សំណាង សិស្ស ថ្នាក់ ទី១០ នៃ វិទ្យាល័យ ហ៊ុន សែន ប្រាសាទ បាគង ទទួលបាន ជ័យលាភី លេខ១. យុវតី ឡាំង សហ្សវត្តី សិស្ស ថ្នាក់ ទី១០ នៃ វិទ្យាល័យ សម្ដេច ឪ ទទួលបាន ជ័យលាភី លេខ ២ និង យុវជន លាន សុខ លាភ សិស្ស ថ្នាក់ ទី ១២ នៃ វិទ្យាល័យ អង្គរ ទទួលបាន ជ័យលាភី លេខ ៣៕
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ ឧត្តមសេនីយ៍ ទោ ( ផ្កាយ ២) ដល់ លោក ឧត្តមសេនីយ៍ ត្រី ប៉ឹង បូរ៉ា ក្របខ័ណ្ឌ មន្ដ្រី នគរបាល ជាតិ កម្ពុជា
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តម្លើង ឋានន្ដរស័ក្ដិ ថ្នាក់ ឧត្តមសេនីយ៍ ទោ ( ផ្កាយ ២) ដល់ នាយ នគរបាល ជាន់ ខ្ពស់ ក្របខ័ណ្ឌ មន្ដ្រី នគរបាល ជាតិ កម្ពុជា នៃ ក្រសួង មហាផ្ទៃ គឺ លោក ឧត្តមសេនីយ៍ ត្រី ប៉ឹង បូរ៉ា ។ នេះ បើ តាម ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
លោក ឧត្តមសេនីយ៍ ត្រី ប៉ឹង បូរ៉ា អត្តលេខ ០៩៩៩ ក៏ ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ចេញ អនុក្រឹត្យ តែងតាំង ជា អនុប្រធាន នាយកដ្ឋាន បុគ្គលិក ដែល មាន ឋានៈ និង បុព្វសិទ្ធិ ស្មើ ប្រធាន នាយកដ្ឋាន ផងដែរ ។
សូម អាន ខ្លឹមសារ លម្អិត នៃ ព្រះរាជ ក្រឹត្យ ដែល មាន នៅ ខាងក្រោម នេះ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៥ ខែវិច្ឆិកា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ១.៣១៦ គ្រឿង និង ផាក ពិន័យ ៨៨៩ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៧.២៩០ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ១.៣១៦ គ្រឿង ( ម៉ូតូ ៨១ %) អប់រំ៤២៧ គ្រឿង និង ផាក ពិន័យ ៨៨៩ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា នេះ ត្រួតពិនិត្យ បាន ចំនួន ៣. ៨៥៥ គ្រឿង . អប់រំ៦០៣ គ្រឿង និង ផាក ពិន័យ ៣៨៤ គ្រឿង ។
សម្រាប់ លទ្ធផល នៃ ការត្រួតពិនិត្យ រយៈពេល ១៥ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា នេះ នគរបាល បាន ត្រួតពិនិត្យ យានយន្ត ចំនួន ៣៧.៩៥៣ គ្រឿង រកឃើញ យានយន្ត ល្មើស ១៤.៤៥៩ គ្រឿង ( ម៉ូតូ ៨២ %) ក្នុង នោះ អប់រំ៣.០១១ គ្រឿង និង ផាក ពិន័យ ១១. ៨៤៨ គ្រឿង ៕ សួន ដាំ បន្លែ ធម្មជាតិ កម្ពុជា - ជប៉ុន នៅ ស្រុក កោះ ធំ ខេត្ត កណ្តាល បាន សម្ពោធ ដាក់ ឲ្យ ដំណើរការ !
សួន បន្លែ ធម្មជាតិ កម្ពុជា - ជប៉ុន នេះ ត្រូវបាន បង្កើតឡើង ដោយ មាន កិច្ចសហការ ពី អ្នកជំនាញ ការមកពី ប្រទេស ជប៉ុន ដើម្បី ដាំដុះ បន្លែ សេរី រាង្គ ប្រកបដោយ គុណភាព មិន មាន ជាតិ គីមី ដោយ ឈរ លើ គោលការណ៍ ផាសុខភាព ប្រជាពលរដ្ឋ ជា ធំ ។
កន្លងមក ដោយ មើលឃើញ ថា បងប្អូន ប្រជាកសិករ មួយចំនួន បាន ដាំដុះ បន្លែ ដោយ ដាក់ សារធាតុ គីមី ហួស ប្រមាណ ដែល ទង្វើ នេះ បាន បង្កឲ្យ មាន ផល ប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ យ៉ាង ខ្លាំង ។ ដូចនេះ ដើម្បី ផ្លាស់ប្តូរ ទម្លាប់ នៃ ការដាំដុះ បន្លៃ របស់ កសិករ ដោយ ប្រើប្រាស់ សារធាតុ គីមី និង ងាក មក ដាំដុះ បន្លែ ដោយ ប្រើ បច្ចេកទេស ធម្មជាតិ វិញ ។
ក្នុង ឱកាស នោះ ផងដែរ អគ្គ នាយក ធនាគារ អភិវឌ្ឍន៍ ជនបទ បាន ស្នើឲ្យ រៀបចំ បង្កើត សួន បន្លែ ធម្មជាតិ ដាំដុះ សាកល្បង នៅក្នុង ភូមិសាស្ត្រ ស្រុក កោះ ធំ ខេត្ត កណ្ដាល ដោយ មាន កិច្ចសហការបច្ចេកទេស ពី ក្រុមការងារ មកពី ប្រទេស ជប៉ុន ដោយ ផ្ទាល់ ។
ក្នុង ករណី សួន បន្លែ ធម្មជាតិ នេះ ដាំដុះ ទទួលបាន ជោគជ័យ លោក កៅ ថា ច នឹង ស្នើសុំ បន្ត ធ្វើ ការពង្រីក ការដាំដុះ ទៅ គ្រប់ បណ្តា ទីតាំង តាម ឃុំ ស្រុក ខេត្ត និង តាម បណ្តា តំបន់ អ្នកផលិត បន្លែ ដោយ ចង ក្រង ប្រជាកសិករ អ្នក ដាំ បន្លែ ជា សហគមន៍ ហើយ ក្នុង នោះ មាន ការផ្តល់ នូវ បច្ចេកទេស ជី ពូជ និង ជួយ រក ទីផ្សារ ជូន ដល់ បងប្អូន សហគមន៍ ផងដែរ ។
លោក កៅ ថា ច សង្ឃឹម យ៉ាង មុតមាំ ថា តាមរយៈ វត្តមាន សួន បន្លែ ធម្មជាតិ កម្ពុជា - ជប៉ុន នៅក្នុង ភូមិសាស្ត្រ នេះ នឹង ធ្វើជា គំរូ ដល់ កសិករ ក្នុង ការផ្លាស់ប្តូរ ជា វិជ្ជមាន ចំពោះ ទម្លាប់ នៃ ការដាំដុះ ដោយ ប្រើ សារធាតុ គីមី ដោយ ជំនួស ការដាំដុះ ដោយ ធម្មជាតិ វិញ ហើយ យើង អាច កាត់បន្ថយ បាន នូវ ការ នាំចូល បន្លែ ដែល មាន សារធាតុ គីមី ពី បរទេស ផងដែរ ៕ សម្តេច តេជោ ហ៊ុន សែន ចេញ អនុក្រឹត្យ តែងតាំង មន្រ្តី នគរបាល ជាតិ ២រូប ជា អនុប្រធាន នាយកដ្ឋាន បុគ្គលិក មាន ឋានៈ និង បុព្វសិទ្ធិ ស្មើ ប្រធាន នាយកដ្ឋាន
នៅក្នុង អនុក្រឹត្យ ខាងលើ នេះ មន្រ្តី នគរបាល ជាតិ ទាំង២រូប ដែល ត្រូវបាន តែងតាំង រួម មាន៖
* ទី១៖ លោក ឧត្តមសេនីយ៍ ឯក សុខ ម នោរម្យ អត្តលេខ ៧៧៧៧៦ ជា អនុប្រធាន នាយកដ្ឋាន បុគ្គលិក ដែល មាន ឋានៈ និង បុព្វសិទ្ធិ ស្មើ ប្រធាន នាយកដ្ឋាន *ទី ២៖ លោក ឧត្តមសេនីយ៍ ត្រី ប៉ឹង បូរ៉ា អត្តលេខ ០៩៩៩ ជា អនុប្រធាន នាយកដ្ឋាន បុគ្គលិក ដែល មាន ឋានៈ និង បុព្វសិទ្ធិ ស្មើ ប្រធាន នាយកដ្ឋាន ។
សូម អាន ខ្លឹមសារ លំអិត នៅក្នុង អនុក្រឹត្យ របស់ សម្តេច តេជោ ហ៊ុន សែន ខាងក្រោម នេះ៖ តំណាង លោកស្រី បណ្ឌិត ម៉ែន សំអន អញ្ជើញ ផ្តល់ ភ្លើង បូជា សព លោក ខឹម ជា សោភ័ណ អនុ រដ្ឋលេខាធិការ ក្រសួង ទំនាក់ទំនង រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច
( ភ្នំពេញ ) ៖ លោក កង ណែម រដ្ឋលេខាធិការ តំណាង លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បូជា សព លោក ខឹម ជា សោភ័ណ អនុ រដ្ឋលេខាធិការ ក្រសួង ដែល បាន ទទួលមរណភាព កាលពី វេលា ម៉ោង ១២៖៤៥ នាទី រំលង អាធ្រាត្រ ថ្ងៃអង្គារ៍ ៦កើត ខែកត្តិក ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស .២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ក្នុង ជន្មាយុ ៦៧ ឆ្នាំ ដោយ រោគា ពាធ ។
ពិធី ត្រូវបាន ប្រារព្ធ ធ្វើឡើង វត្ត ទួល សន្តិវ័ន ( ហៅ វត្ត ទួល អស់ លោក ) ស្ថិត សង្កាត់ ឫស្សីកែវ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ព្រឹក ថ្ងៃព្រហស្បត្តិ៍ ៨ កើត ខែកត្តិក ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស .២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក លោកស្រី មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ជាច្រើន នាក់ ផងដែរ ។
ជា ចុងក្រោយ ក៏ មាន ការប្រទាន ភ្លើង បូជា សព ពីសំណាក់ ព្រះភិក្ខុ កុសល រក្ខិតោ ខេន សុខ នៅ ព្រះចៅ អធិការ វត្ត ទួល សន្តិវ័ន ( ហៅ វត្ត ទួល អស់ លោក ) ជា កិច្ច បង្ហើយ បុណ្យ ផងដែរ ។
សម្រាប់ កម្មវិធី បុណ្យ គម្រប់ ខួប ៧ ថ្ងៃ ក៏ ត្រូវបាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃអាទិត្យ ១១កើត ខែកក្តិក ឆ្នាំ ច សំរិទ្ធិ ស័ក ព .ស .២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ម៉ោង ៣៖០០ រសៀល ជួបជុំ ពុទ្ធិ បរិស័ទ្ធ ញាតិមិត្ត ជិត ឆ្ងាយ ដើម្បី ប្រារព្ធ កិច្ចន មស្សការ ព្រះរតនៈត្រ័យ សមាទាន សីល និមន្ត ព្រះសង្ឃ ចម្រើន ព្រះបរិត្ត និង សំដែង ធម្មទេសនា ។ លុះ ព្រឹកឡើង ថ្ងៃច័ន្ទ ខែ ឆ្នាំ ដដែល ត្រូវនឹង ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ប្រគេន យាគូ ព្រះសង្ឃ និង រាប់ បាត្រជា កិច្ច បង្ហើយ បុណ្យ ៕
កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ត្រូវបាន បិទ បញ្ចប់ . ថៃ បន្ត វេន ជា ប្រធាន អាស៊ាន នៅ ឆ្នាំ ក្រោយ
( សិង្ហបុរី ) ៖ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ជាច្រើន ដែល បាន ធ្វើឡើង ចាប់តាំងពី ថ្ងៃទី ១៣ ដល់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន បិទ បញ្ចប់ ហើយ ជាមួយ ការវាយតម្លៃ ខ្ពស់ ពី លោក លី ស៊ាន ឡុង នាយក រដ្ឋមន្ត្រី សិង្ហបុរី និង ជា ប្រធាន អាស៊ាន ។
ថ្លែង ក្នុង ពិធី បិទ បញ្ចប់ កិច្ចប្រជុំ នេះ លោក លី ស៊ាន ឡុង បាន វាយតម្លៃ ខ្ពស់ ចំពោះ បណ្តា មេដឹកនាំ អាស៊ាន ទាំងអស់ ដែល រយៈពេល ពេញ មួយ ឆ្នាំ កន្លងមក បាន ធ្វើ កិច្ចការ ជាច្រើន ក្នុង ការបម្រើ ផលប្រយោជន៍ សម្រាប់ ប្រជាជាតិ ក្នុង តំបន់ ពិសេស រួមគ្នា នោះ ស្រាយ នូវ រាល់ បញ្ហា ប្រឈម នានា ក្នុង ជំរុញ លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ផ្ទៃក្នុង ជាមួយ បណ្តា ប្រទេស ក្រៅ តំបន់ ប្រកបដោយ លទ្ធផល ដ៏ ត្រចះត្រចង់ បំផុត ។
បន្ទាប់ពី ទទួលបាន ញញួរ ឈើ ជា និម្មិត រូប ជា ប្រធាន អាស៊ាន ក្នុង ឆ្នាំ ២០១៩ ពី ប្រធាន ចាស់ រួច មក ឧត្តមសេនីយ៍ ប្រាយុទ្ធ ចាន់ អូចា នាយក រដ្ឋមន្រ្តី ថៃ និង ជា ប្រធាន កិច្ចប្រជុំ អាស៊ាន ឆ្នាំ ២០១៩ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ក្នុង ការទទួល ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ - ៣៥ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នានា ក្នុង ឆ្នាំ ២០១៩ ឲ្យ ទទួលបាន ជោគជ័យ ដ៏ ត្រចះត្រចង់ បំផុត ។
លោក ឧត្តមសេនីយ៍ ក៏ បាន គោរព យាង និង អញ្ជើញ បណ្តា មេដឹកនាំ អាស៊ាន ទាំងអស់ ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី៣៤ - ៣៥ និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ នានា នៅ ព្រះរាជាណាចក្រ ថៃ ក្នុង ឆ្នាំ ២០១៩ ខាងមុខ ដើម្បី រិះរក គ្រប់ មធ្យោបាយ ទាំងអស់ ដើម្បី ផលប្រយោជន៍ និង ភាពរីកចម្រើន សម្រាប់ តំបន់ របស់ យើង ទាំងអស់ គ្នា ៕
ការប្រណាំ ទូក «ង » នៅ ខេត្ត បន្ទាយមានជ័យ មាន អ្នកចូលរួម ជាង ១ម៉ឺន នាក់ . នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ឧបត្ថម្ភ រង្វាន់ ជា សម្ភារ និង ថវិកា ជាង ៨២ លាន រៀល
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃព្រហស្បតិ៍ ៨កើត ខែកក្តឹក ឆ្នាំ ចសំរឹទ្ធិ ស័ក ព .ស ២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន អ្នកតំណាងរាស្រ្ត ឧប នាយក រដ្ឋមន្រ្តី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង លោកស្រី អម ដំណើរ ដោយ ថ្នាក់ដឹកនាំ - មន្ត្រីរាជការ បាន ចូល ជា អធិបតី ក្នុង ពិធី ប្រណាំង ទូក ង នៅ សង្កាត់ ទឹក ថ្លា ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ជាមួយ ប្រជាពលរដ្ឋ ជាង ១ម៉ឺន នាក់ ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន មាន មតិ សំណេះសំណាល និង ពាំនាំ ការផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី . សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ។
ក្នុង ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន បន្ថែម ថា យុទ្ធសាស្រ្ត ឈ្នះ ឈ្នះ និង ពលិកម្ម គ្រប់ បែបយ៉ាង របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ដឹកនាំ ប្រទេសជាតិ ទទួលបាន នូវ សុខ សន្តិភាព ប្រជាពលរដ្ឋ មាន ការងារ ធ្វើ គ្រួសារ រស់នៅ ក្នុង ជីវភាព ធូរធា សម្បូរសប្បាយ មាន ឱកាស បាន ចូលរួម ប្រារព្វ ពិធី បុណ្យ ផ្សេង ៗ យ៉ាង សប្បាយរីករាយ ដោយ គ្មាន ការព្រួយបារម្ភ ភិតភ័យ គេច គ្រាប់ ផ្លោង ដូច ពី អតីតកាល ឡើយ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន ថ្លែងអំណរគុណ និង ដឹងគុណ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ នៃ គ្រូសារ អ្នក បន្ទាយមានជ័យ ដែល បាន ចូលរួម ថែរក្សា គាំទ្រ សន្តិភាព ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី បន្ត ភាព សម្បូរសប្បាយ រុងរឿង បន្ថែម ទៀត ។
ជាមួយនឹង ភាពសប្បាយរីករាយ ក្នុង ឱកាស នេះ ដែរ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន នាំយក អំណោយ ជា សម្ភារ ថវិកា សម្រាប់ ប្រគល់ជូន រួម មាន៖
( ត្បូងឃ្មុំ ) ៖ អស់ រយៈពេល ២ ថ្ងៃ មក ហើយ ដែល រថយន្ត មន្ទីរពិសោធន៍ ចល័ត របស់ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល ចុះ ត្រួតពិនិត្យ សារធាតុ គីមី នៅលើ បន្លែ ផ្លែ ឈើ និង ម្ហូប អារ ហារ នៅ តាម ផ្សារ និង ច្រកទ្វារ ព្រំដែន ក្នុង ខេត្ត ត្បូងឃ្មុំ ។
ដោយឡែក នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ មន្ត្រី កាំ កុងត្រូល ខេត្ត នាំយក រថយន្ត មន្ទីរពិសោធន៍ ចល័ត កាំ កុងត្រូល ដោយ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត និង លោក អភិបាល រង ស្រុក មេមត់ ព្រមទាំង សមត្ថកិច្ច បាន ចុះ ត្រួតពិនិត្យ បន្លែ ផ្លែ ឈើ ម្ហូប អារ ហារ ចំនួន ៣២ គំរូ ដើម្បី វិភាគរក សារធាតុ គីមី ហាមឃាត់ ដែល បណ្តាលឲ្យ ប៉ះពាល់ ដល់ សុខភាព អ្នកទទួលទាន នៅ ផ្សារ មេមត់ ក្នុង ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ។
លោក បន្ត ថា ក្រោយ ការពិនិត្យ និង វិភាគ ដោយ រថយន្ត មន្ទីរពិសោធន៍ ចល័ត របស់ កាំ កុងត្រូល លើ បន្លែ ផ្លែ ឈើ និង ម្ហូប អាហារ ទាំងអស់ ខាងលើ នោះ ក្នង ចំណោម ៣២ គំរូ គឺ មាន វត្តមាន សារធាតុ គីមី បូរ៉ាក់ ២ គំរូ នៅក្នុង ផលិតផល បង្អែមលត ស្វិត សរុប បរិមាណ ១៥ គីឡូក្រាម ត្រូវបាន ដកហូត ភ្លាម ៗ ពី អ្នកលក់ ២នាក់ ។
មន្ត្រី កាំ កុងត្រូល ក៏ បាន ធ្វើ ការណែនាំ អប់រំ និង ធ្វើ កិច្ចសន្យា បពា្ឈប់ ការប្រើប្រាស់ សារធាតុ បូរ៉ាក់ ( ទឹក អន្សារ ) ដាក់ ក្នុង ផលិផល បង្អែមលត ស្វិត ប្ញ បង្អែម ផ្សេង ទៀត ចាប់ពី ពេលនេះ តទៅ ព្រោះ វា បណ្តាលឱ្យ ប៉ះពាល់ ដល់ សុខភាព អ្នកទទួលទាន ។
រថយន្ត សម្អាត ផ្លូវ ខ្មែរ ប៊ែ វើរី ជីស ចាប់ផ្តើម សម្អាត ទីក្រុង ភ្នំពេញ សម្រាប់ បុណ្យ អុំ ទូក ឆ្នាំ ២០១៨
( ភ្នំពេញ ) ៖ រថយន្ត សម្អាត ផ្លូវ ខ្មែរ ប៊ែ វើរី ជីស បាន ចាប់ផ្តើម សម្អាត ផ្លូវ នានា ក្នុង ទីក្រុង ភ្នំពេញ ដើម្បី ត្រៀម ស្វារគមន៍ ភ្ញៀវ ទេសចរណ៍ ជាតិ និង អន្តរជាតិ មក លេង កម្សាន្ត នៅ ទីក្រុង ភ្នំពេញ ក្នុង ឱកាស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទីព និង សំពះ ព្រះខែ អក អំបុក ខាងមុខ នេះ ។
ការសំអាត ផ្លូវ នេះ ក្រុមហ៊ុន បាន ប្រើប្រាស់ រថយន្ត ចំនួន ៤គ្រឿង កំពុង ធ្វើ ការសម្អាត ក្នុង ទីក្រុង ភ្នំពេញ ដោយ ផ្តើម ពី ថ្ងៃទី ១៥ រហូតដល់ ចុង ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
លោក ហុង អាន ប្រធាន ក្រុម អ្នកបើកបរ រថយន្ត សម្អាត ផ្លូវ របស់ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន ឱ្យដឹង ថា « រៀងរាល់ ថ្ងៃ ពួកយើង ចេញ ធ្វើ ប្រត្តិបត្តិការ សម្អាត ផ្លូវ ក្នុង ទីក្រុង ដើម្បី ធ្វើឱ្យ បរិស្ថាន ក្នុង រាជធានី ភ្នំពេញ បាន ប្រសើរ ជាង មុន ។ ពួកយើង ត្រូវ ធ្វើចរាចរណ៍ និង សម្អាត ផ្លូវ ក្រោម កម្តៅ ថ្ងៃ ស្ទើរ រៀងរាល់ ថ្ងៃ ។ ទោះបីជា ការងារ នេះ មាន ភាពនឿយហត់ យ៉ាងណា ពួកយើង សប្បាយ ចិត្ត ដែល បាន ចូលរួមចំណែក ធ្វើឱ្យ បរិស្ថាន ស្អាត » ។
សមាជិក ក្រុម អ្នកបើកបរ រថយន្ត សម្អាត ផ្លួវ កំពុង មមាញឹក ក្នុង ការសម្អាត ផ្លូវ ក្នុង ទីក្រុង ភ្នំពេញ ដើម្បី អបអរ បុណ្យ ប្រពៃណី ដែល នឹង ឈានចូល មកដល់ ខាងមុខ នេះ ។
លោក បាន បន្ត ថា ពួកយើង ពេញចិត្ត នឹង បំពេញ ការងារ នេះ ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ ប្រជាពលរដ្ឋ សប្បាយ ចិត្ត និង រីករាយ អំឡុង ពេល បុណ្យ អុំ ទូក ក្នុង ទីក្រុង ដែល មាន បរិស្ថាន ស្អាត ។
( សេអ៊ូល ) ៖ អ្នកនេសាទ ចំនួន ១៣នាក់ ត្រូវបាន ជួយ សង្រ្គោះ ទាន់ ពេលវេលា ក្រោយពី ទូក នេសាទ កូរ៉េ ខាងត្បូង របស់ ពួកគេ បាន លិច ចូល សមុទ្រ ដោយសារតែ ការប៉ះទង្គិច គ្នា ជាមួយ ទូក នេសាទ មួយ គ្រឿង ទៀត របស់ ជប៉ុន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
ហេតុការណ៍ ខាងលើ បាន កើតឡើង នៅលើ ផ្ទៃ សមុទ្រ នា ចម្ងាយ ប្រហែលជា ៣៣០ គីឡូម៉ែត្រ ភាគ ឦសានប្រជុំ កោះ ជម្លោះ ដែល ជប៉ុន ដាក់ឈ្មោះ ថា Takeshima រីឯ កូរ៉េ ខាងត្បូង ហៅ ថា Dokdo ។ ក្រោយ ការប៉ះទង្គិច ជាមួយ ទូក នេសាទ ជប៉ុន ដែល មាន ទម្ងន់ ១០០តោន ទូក នេសាទ កូរ៉េ ខាងត្បូង ទម្ងន់ ត្រឹម ៤៨តោន ក៏ បាន លិច ។ អ្នកនេសាទ ទាំង ១៣នាក់ របស់ ទូក កូរ៉េ ខាងត្បូង ត្រូវបាន ជួយ សង្រ្គោះ ដោយ ទូក នេសាទ មួយ ចំនួន របស់ ក្រុមហ៊ុន ឯកជន ដែល មាន វត្តមាន នៅក្បែរ នោះ ។
គួរ ជម្រាប ថា ចំណែក ទូក នេសាទ ជប៉ុន មិន ត្រឹមតែ មិន បាន លិច នោះ ទេ សូម្បីតែ អ្នករងរបួស ក៏ ពុំ ត្រូវបាន ឃើញ មាន គេ រាយការណ៍ នោះ ដែរ ។ ដោយឡែក កង នាវា ល្បាត កូរ៉េ ខាងត្បូង កំពុង ស្រាវជ្រាវ ថា តើ គ្រោះថ្នាក់ នេះ បង្កឡើង ដោយសារ មូលហេតុ អ្វី ឲ្យ ប្រាកដ ៕
ក្រុមហ៊ុន រថយន្តក្រុង ដឹក អ្នកដំណើរ « កាពីតូល » ឧបត្ថម្ភ ថវិកា ២លាន រៀល ជូន នគរបាល ខេត្ត កំពង់ឆ្នាំង ដែល បាន បង្ក្រាប ជន ដៃ ដល់ ៨នាក់ គប់ កញ្ចក់ រថយន្ត តាម ផ្លូវ នៅ ពេល យប់ ខូចខាត ប្រមាណ ៣០ គ្រឿង
( កំពង់ឆ្នាំង ) ៖ ក្រោយ ទទួលបាន ព័ត៌មាន ថា កម្លាំង នគរបាល ខេត្ត កំពង់ឆ្នាំង បាន ធ្វើ ការបង្ក្រាប និង ចាប់ខ្លួន ជន ដៃ ដល់ ចំនួន ៨នាក់ ដែល គប់ សកម្មភាព កញ្ចក់ រថយន្ត របស់ ប្រជាពលរដ្ឋ នៅ តាម ដងផ្លូវ នៅ ពេល យប់ ស្ថិត នៅក្នុង ភូមិសាស្រ្ត ស្រុក រលាប្អៀរ និង ស្រុក បរិបូណ៍ នោះ ក្រុមហ៊ុន រថយន្ត ដឹក អ្នកដំណើរ « កាពីតូល » បាន ឧបត្ថម្ភ ថវិកា ចំនួន ២លាន រៀល ជូន ដល់ នគរបាល ជា ការជួយ លើកទឹកចិត្ត សម្រាប់ ទប់ស្កាត់ អំពើ មួយ នេះ បាន ដោយ ជោគជ័យ ។
យ៉ាងណា ក៏ដោយ តំណាង ក្រុមហ៊ុន រួប នេះ ក៏ បាន អំពាវនាវ ដល់ សមត្ថកិច្ច ខេត្ត កំពង់ឆ្នាំង ជួយ ទប់ស្កាត់ ឲ្យ មាន ប្រសិទ្ធភាព តទៅទៀត ជាពិសេស នៅ តាម ផ្លូវ ជាតិ លេខ ៥ ជិត ម្តុំ សាលា លេខ ៥. ហើយក៏ សូម អំពាវនាវ ដល់ សមត្ថកិច្ច រាជធានី ភ្នំពេញ - ខេត្ត កណ្តាល ជួយ ទប់ស្កាត់ នៅ តាម ផ្លូវ ជាតិ លេខ១ ម្តុំ ក្បាល កោះ និង ផ្លូវ ជាតិ លេខ ៦ ម្តុំ ត្រំ ពាំង ឈូក និង ក្នុង ស្រុក សន្ទុក ។
សូម បញ្ជាក់ ថា ជន ដៃ ដល់ ចំនួន ៨នាក់ ក្នុង ចំណោម ១១នាក់ ដែល តែងតែ គប់ កញ្ចក់ រថយន្ត របស់ ប្រជាពលរដ្ឋ នៅ តាម ផ្លូវ ជាតិ នា ពេល យប់ ក្នុង ភូមិសាស្រ្ត រលាប្អៀរ និង ស្រុក បរី បូណ៍ ខេត្ត កំពង់ឆ្នាំង នោះ ត្រូវបាន កម្លាំង នគរបាល បើក ការស្រាវជ្រាវ រហូត តាម ចាប់ខ្លួន បាន និង កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ តុលាការ ។
ស្នងការ នគរបាល ខេត្ត កំពង់ឆ្នាំង លោក ឧត្តមសេនីយ៍ ទោ ឡុច វណ្ណារ៉ា នៅ រសៀល ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ថា កម្លាំង នគរបាល របស់ លោក បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៨នាក់ ក្នុង ករណី គប់ កញ្ចក់ រថយន្ត កាលពី យប់ ថ្ងៃទី ១២ - ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ ចន្លោះ គីឡូម៉ែត្រ លេខ ៩៤ ទៅ ១១៧ ភូមិសាស្រ្ត ស្រុក រលាប្អៀរ និង ស្រុក បរិបូណ៍ យើង ចាប់ ឃាត់ខ្លួន បាន ហើយ ក្នុង ចំណោម ១១នាក់ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន ដាក់ បទបញ្ជា ឲ្យ កម្លាំង នគរបាល ទាំងអស់ នៅ តាម ស្រុក ជាពិសេស ស្រុក ដែល មាន ផ្លូវ ជាតិ និង ផ្លូវ សំខាន់ ៗ ឆ្លងកាត់ នោះ ត្រូវ ឃ្លាំមើល និង ប្រចាំ ការទប់ស្កាត់ អំពើ ល្មើស នេះ កើតឡើង ទៀត នាំឲ្យ មាន គ្រោះថ្នាក់ ដល់ ប្រជាពលរដ្ឋ ជា អ្នកដំណើរ ។
បើ តាម លោក ស្នងការ ក្រុម ជនសង្ស័យ បាន ធ្វើ សកម្មភាព ទាំងនេះ គឺ ពួកគេ មាន មេក្លោង ដែល ជា ជន ញៀន ថ្នាំ និង ខាង ចែកចាយ ថ្នាំញៀន ហើយ ចំពោះ ជនល្មើស ទាំង ៨នាក់ នេះ សុទ្ធតែ មនុស្ស ញៀន ថ្នាំ ដូច្នេះហើយ មេក្លោង របស់ ពួកគេ បាន ប្រើ ឲ្យ ធ្វើ សកម្មភាព បែប នេះ ជា ថ្នូរ ឲ្យ ថ្នាំ ញៀន ជក់ ។ លោក ថា ក្រុម ជនល្មើស ទាំងនេះ បាន ជិះ ម៉ូតូ បញ្ច្រាស រថយន្ត រួច អ្នក អង្គុយ ក្រោយ ដែល ដៃ កាន់ ដុំ ថ្ម នោះ បាន គប់ ទៅ លើ រថយន្ត ដែល ភាគ ច្រើន ជា រថយន្ត ដឹក ទំនិញ និង រថយន្ត ធំ ៗ ។
ចំពោះ ករណី នេះ បាន បណ្តាលឲ្យ ព្រូរថយន្ត ម្នាក់ រងរបួស ធ្ងន់ ដោយសារ ត្រូវ នឹង ដុំ ថ្ម ។ សកម្មភាព របស់ ពួកគេ បាន ធ្វើឡើង ខ្លាំង នៅ យប់ ថ្ងៃទី ១២ - ១៣ ខែវិច្ឆិកា ហើយ នៅ យប់ មិញ ប្រុង ធ្វើ សកម្មភាព បន្ត ទៀត តែ ត្រូវបាន កម្លាំង នគរបាល របស់ លោក ទប់ស្កាត់ ទាន់ ពេល វេលា ។ នេះ បើ តាម លោក ស្នងការ បាន បញ្ជាក់ បន្ថែម ។
សម្រាប់ ជនសង្ស័យ ទាំង ៨នាក់ កំពុង ស្ថិត ក្រោម ការសួរនាំ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ដើម្បីឲ្យ ជំនាញ នគរបាល ខាង គ្រឿងញៀន ធ្វើតេស្ត និង បន្ថែម បទល្មើស ទៀត ខណៈ ជនសង្ស័យ ៣នាក់ ទៀត កំពុង រត់គេចខ្លួន ។ ជនសង្ស័យ ទាំងនេះ មាន ស្រុក កំណើត និង រស់ នៅ ឃុំ ផ្សារ ស្រុក បរិបូណ៍ ក្រោយ ការចាប់ខ្លួន ជនសង្ស័យ កម្លាំង នគរបាល ក៏ បាន ដកហូត វត្ថុតាង មួយចំនួន ផងដែរ ដូចជា ដុំ ថ្ម និង ម៉ូតូ ដែល ជិះ ធ្វើ សកម្មភាព ៕
ថ្លែង នៅក្នុង កិច្ច សម្ចាស ជាមួយ លោក លឹម ជា វុត្ថា នាយក ប្រតិបត្តិ អង្គភាព ព័ត៌មាន Fresh News. លោក រដ្ឋ ធី បាន រៀបរាប់ ថា « កាល នៅ យប់ ថ្ងៃទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ក្នុង កម្មវិធី ផ្សាយ សម្លេង វិទ្យុ អាស៊ី សេរី ជា ខេមរភាសា បាន ចាក់ផ្សាយ សេចក្តីរាយការណ៍ មួយ ដោយ ដកស្រង់ យក សម្តី បុគ្គល មួយចំនួន ដែល ធ្វើ ការបកស្រាយ ចំពោះ ការឆ្លើយតប របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ទៅនឹង ការបបួល ភ្នាល់ គ្នា ពីសំណាក់ លោក សម រង្ស៊ី អំពី ការដោះលែង ឬ មិន ដោះលែង លោក កឹម សុខា » ។
នៅក្នុង សេចក្តីរាយការណ៍ ខាងលើ វិទ្យុ អាស៊ី សេរី បាន ធ្វើ ការអះអាង ថា បុគ្គល ដែល ជា អ្នកបកស្រាយ នោះ គឺ ជា ក្រុម អ្នកច្បាប់ និង ក្រុម មេធាវី ថែមទាំង បាន ហៅ បុគ្គល ដែល ធ្លាប់ រៀន ច្បាប់ ដល់ ថ្នាក់ បណ្ឌិត ម្នាក់ ថា « លោក មេធាវី បណ្ឌិត » ថែម ទៀត ផង បើ ទោះបីជា ការពិត ទៅ បុគ្គល នោះ មិន មែន ជា មេធាវី និង មិន មាន ឈ្មោះ ក្នុង បញ្ជី គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ដោយ ។
ការប្រើប្រាស់ ឈ្មោះ ក្រុម អ្នកច្បាប់ ឬ អ្នក ច្បាប់ មិន មែន សំដៅ ដល់ អ្នក ដែល រៀន ច្បាប់ ឬ ធ្លាប់ បាន រៀន ច្បាប់ នោះ ទេ ប៉ុន្តែ គឺ សំដៅ ដល់ អ្នក ដែល មាន សម្បទា ខាង វិជ្ជាជីវៈ ច្បាប់ រួម មាន៖ ចៅក្រម ព្រះរាជអាជ្ញា ក្រឡាបញ្ជី មេធាវី សហការី ... ឬ មន្រ្តី ឬ បុគ្គលិក ដែល បំពេញ ការងារ ក្នុង វិស័យ ច្បាប់ ក្នុង ស្ថាប័ន រដ្ឋ ឬ អាច ជា សាស្រ្តាចារ្យ ដែល មាន បទពិសោធន៍ និង ជំនាញ ជាច្រើន ឆ្នាំ ។
នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ គណៈ មេធាវី កម្ពុជា បាន ចេញ សេចក្តីប្រកាស មួយ បញ្ជាក់ ថា លោក ហ៊ាង រិទ្ធី ដែល ជា អតីត អនុប្រធាន គណបក្ស សំបុក ឃ្មុំ សង្គម ប្រជាធិបតេយ្យ នោះ មិន មែន ជា មេធាវី ដែល ចុះឈ្មោះ ដោយ គណៈ មេធាវី នោះ ទេ ។
គណៈ មេធាវី បាន ចាត់ទុក ថា ការហៅ ការប្រើប្រាស់ មុខងារ តួនាទី និង ឋានៈ ជា មេធាវី ខុសពី ការពិត នេះ បាន ធ្វើឱ្យ សាធារណជន មាន ការភាន់ច្រឡំ ហើយ បណ្តាលឱ្យ ប៉ះពាល់ ដល់ កិត្តិយស និង សេចក្តីថ្លៃថ្នូរ របស់ មេធាវី និង ស្ថាប័ន គណៈ មេធាវី ។ គណៈ មេធាវី កម្ពុជា ក៏ ប្រកាស ចាត់ វិធានការ គ្រប់ មធ្យោបាយ តាម នីតិវិធី ច្បាប់ ផងដែរ ៕
ការថ្លែង របស់ លោក ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត ធ្វើឡើង នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ក្នុង ឱកាស អញ្ជើញ បើក វគ្គ ហ្វឹកហ្វឺន បណ្តុះបណ្តាល ជំនាញ ឆត្រ យោង ជំនាន់ ទី២៥ . បិទ វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ អាវុធ B40-B41 អាវុធ ការពារ អាកាស ជំនាន់ ទី២ និង សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ សំណង់ បច្ចេកទេស ហ្វឹកហ្វឺន ជំនាញ ឆ័ត្រ យោង ។
បន្ថែម ពី នេះ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត ក៏ បាន ក្រើន រំលឹក ឲ្យ កងទ័ព ទាំងអស់ ត្រូវតែ បង្កើន ការយកចិត្តទុកដាក់ បន្ថែម ទៀត លើ ការងារ ហ្វឹកហ្វឺន យុទ្ធ វិធី បច្ចេកទេស ការអប់រំ ចិត្តសាស្រ្ត ពង្រឹង វិន័យ អត្តចរិត សីលធម៌ និង គោរព ច្បាប់ រដ្ឋ ដើម្បីឲ្យ មាន សមត្ថភាព ជំនាញ គ្រប់គ្រាន់ ក្នុង ការឆ្លើយតប ឲ្យបាន ទាន់ ពេលវេលា ចំពោះ បញ្ហា និង ស្ថានភាព នានា ដែល កើត មាន ឡើង ក៏ ដូចជា ការកសាង សំណង់ បច្ចេកទេស នានា ដែល បម្រើ ឲ្យ ការហ្វឹកហ្វឺន ។
បើ តាម លោក ហ៊ុន ម៉ាណែត ការហ្វឹកហ្វឺន និង ការកសាង ធនធាន មនុស្ស ក្នុង ជួរ កងយោធពល ខេមរភូមិន្ទ ពិតជា ឆ្លើយតប យ៉ាង ត្រឹមត្រូវ និង ទាន់ ពេលវេលា ទៅនឹង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការកែទម្រង់ កងយោធពល ខេមរភូមិន្ទ សំដៅ កសាង និង ពង្រឹង ភាពរឹងមាំ លើ វិស័យ ការពារ ជាតិ និង ការធ្វើ សមាហរណកម្មកងទ័ព ចូលក្នុង សហគមន៍ អន្តរជាតិ តាមរយៈ ការកសាង កងទ័ព កម្ពុជា ឲ្យ ក្លាយជា កងទ័ព មាន សមត្ថភាព ក្នុង វិជ្ជាជីវៈ ដើម្បី ចូលរួម បំពេញ បេសកកម្ម ក្នុង តំបន់ ពិភពលោក ការពារ បូរណភាព ទឹកដី និង ការអភិវឌ្ឍ ប្រទេសជាតិ ។
លោក សង្កត់ធ្ងន់ ថា ការយកចិត្តទុកដាក់ ការហ្វឹកហ្វឺន គឺ សំខាន់ ណាស់ ក្នុង ការធានា នូវ និរន្តរភាព និង ប្រសិទ្ធិភាព នៃ កងកម្លាំង គ្រប់ ជំនាន់ ក្នុង ការបំពេញ ភារកិច្ច ការពារ ជាតិ ការពារ បូរណភាព ទឹកដី និង សន្តិសុខ ។ ក្នុង ដំណាក់កាល នេះ ត្រៀមលក្ខណៈ នឹង យក ឱកាស មាស នេះ ហ្វឹកហ្វឺន ដើម្បី បន្ត វេន គ្រប់ ជំនាន់ ហើយ ទ័ព ពិសេស នៅក្នុង សម័យកាល នេះ ត្រូវតែ ពង្រីក កសាង លក្ខណៈ ពិសេស និង ប្រវត្តិ រាប់ រយ ឆ្នាំ ទៅ មុខ ទៀត ។
ក្នុង ឱកាស នេះ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត សូម កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ស្នាដៃ ដែល កងពល តូច ទ័ព ពិសេស ឆ័ត្រ យោង ៩១១ ដែល បាន បំពេញ ក្នុង រយៈ កន្លងមក ជាពិសេស លើ ការហ្វឹកហ្វឺន ជំនាញ ឆត្រ យោង ដែល បម្រើ ឲ្យ កង ឯកភាព ផ្សេង ទៀត នៃ កងយោធពល ខេមរភូមិន្ទ ដែល មកទល់ ពេលនេះ ។
សូម បញ្ជាក់ ថា កងពល តូច ឆ័ត្រ យោង ៩១១ បាន បើក វគ្គ ចំនួន ២៤ វគ្គ រួច មកហើយ ដោយ មាន ១៧ អង្គភាព ចូលរួម និង មាន ចំនួន សិក្ខាកាម សរុប រហូតដល់ ៣. ៦៨០ នាក់ ។ ក្នុង នោះ កងពល តូច ៩១១ ក៏ បាន ចូលរួម បំពេញ ភារកិច្ច ផ្សេង ៗ ជាច្រើន ផងដែរ រួម មាន ការការពារ បូរណភាព ទឹកដី ការពារ សន្តិសុខ ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ៕
ក្រុមហ៊ុន ឆ្នោត សំណាង អាស៊ី បើក សម្ពោធ សាខា ទី១ ជា ផ្លូវការ នៅ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ
ពិធី បើក សម្ពោធ សាខា ទី១ របស់ ក្រុមហ៊ុន ឆ្នោត សំណាង អាស៊ី នេះ ធ្វើឡើង ក្រោម អធិបតី លោក ហេង ភក្តី នាយក គ្រប់គ្រង នៃ ក្រុមហ៊ុន ឆ្នោត សំណាង អាស៊ី លោក ឈិន ឡាក់ គី ប្រធាន ផ្នែក ទីផ្សារ របស់ ក្រុមហ៊ុន ឆ្នោត សំណាង អាស៊ី រួមទាំង អាជ្ញាធរ ពាក់ព័ន្ធ និង ភ្ញៀវ កិត្តិយស ជាច្រើន ទៀត ផងដែរ ។
លោក បាន បញ្ជាក់ ទៀត ថា ការបង្កើត ឆ្នោត នេះ មិន មែន ត្រឹមតែ យក ចំណូល ដែល រក បាន មក ផ្គត់ផ្គង់ ក្រុមហ៊ុន មួយ មុខ នោះ ទេ ដោយ ក្រុមហ៊ុន គឺ មាន គោលការណ៍ មួយ គឺ ដើម្បី ជួយ ទៅដល់ អ្នកក្រីក្រ កុមារ កំព្រា និង សាលា ផ្សេង ៗ ដែល ខ្វះខាត ផងដែរ ។ លោក បន្ថែម ថា ក្រុមហ៊ុន ឆ្នោត សំណាង អាស៊ី ក្រៅពី សាខា នៅ ទួល ពង្រ នេះ ក្រុមហ៊ុន មាន គោលបំណង ពង្រីក ២០ សាខា ទៀត នៅក្នុង រាជធានី ភ្នំពេញ ហើយ នឹង ពង្រីក ឱ្យ គ្រប់ ទូទាំង ២៥ ខេត្ត - ក្រុង ផងដែរ ។
សូម បញ្ជាក់ ដែរ ថា នៅក្នុង ឱកាស នៃ ការបើក សម្ពោធ សាខា ថ្មី ក្រុមហ៊ុន ឆ្នោត សំណាង អាស៊ី ក៏ មាន រៀបចំ ការសំដែង មុង សាយ ការរាំ ច្រៀង កំសាន្ត ការដើរ ម៉ូដ បង្ហាញ ផលិតផល ការលេង ល្បែង កំសាន្ត ការទទួលបាន ឆ្នោត ដោយ ឥត គិត ថ្លៃ និង រង្វាន់ ជាច្រើន ទៀត មាន ដូចជា ទូរទឹកកក ម៉ាស៊ីន ត្រជាក់ ម៉ាស៊ីន ដុត microwave ចង្ក្រាន្ត អគ្គិសនី និង ម៉ាស៊ីន ទឹក ក្តៅ ជាដើម ហើយ ក្រុមហ៊ុន នឹង នៅតែ បន្ត បង្កើត កម្មវិធី កំសាន្ត សប្បាយ និង ចាប់ រង្វាន់ រយ: ពេល ៣ ថ្ងៃ ជាប់ ៗ គ្នា ផងដែរ ។
ក្រសួង អប់រំ កម្ពុជា និង ក្រសួង អប់រំ ម៉ាឡេស៊ី សហការរៀបចំ ការតាំងពិព័រណ៍ ការអប់រំ ឆ្នាំ ២០១៨ ដើម្បី បង្ហាញ ឱកាស សិក្សា និង ការងារ នៅ ម៉ាទ្បេ ស៊ី
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ ម៉ាឡេស៊ី និង ក្រសួង អប់រំ យុវជន និង កីឡា កម្ពុជា បាន សហការរៀបចំ ការតាំងពិព័រណ៍ ការអប់រំ ឆ្នាំ ២០១៨ ស្តីពី « ការសិក្សា នៅ ប្រទេស ម៉ាទ្បេ ស៊ី និង ឱកាស ការងារ » នៅ ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នា ២០១៨ ចាប់ពី ម៉ោង ១០ព្រឹក ដល់ ម៉ោង ៥ល្ងាច នៅ សណ្ឋាគារ កាំបូឌីយ៉ាណា រាជធានី ភ្នំពេញ ។ ព្រឹត្តិការណ៍ នេះ មាន ការតាំងពិព័រណ៍ អប់រំ និង ការធ្វើ បទបង្ហាញ ដោយ ក្រុមហ៊ុន ឯកជន ម៉ាឡេស៊ី នៅ កម្ពុជា ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ កម្លាំង សមត្ថកិច្ច ចម្រុះ មួយ ដើម្បី រៀបចំ ផែនការ ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ ជូន ថ្នាក់ដឹកនាំ និង ប្រជាពលរដ្ឋ សម្រាប់ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ ។
កិច្ចប្រជុំ ដ៏ មាន សារសំខាន់ នេះ ក៏ មាន ការចូលរួម ពី តំណាង ក្រសួង ស្ថាប័ន និង អង្គភាព នានា ដែល ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ដែល បាន ប្រារព្ធ ធ្វើ នៅ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
សូម ជម្រាប ថា ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ នឹង ត្រូវ ប្រព្រឹត្ដិ ទៅ ចាប់ពី ថ្ងៃទី ២១ - ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ខាងមុខ នេះ នៅ ទន្លេ បួន មុខ មុខ ព្រះបរម រាជ វាំង ។
លោក មាន ចាន់ យ៉ាដា អភិបាល រង រាជធានី ភ្នំពេញ នៅក្នុង កិច្ចប្រជុំ កាលពី ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ កន្លងទៅ របស់ សាលា រាជធានី ភ្នំពេញ ធ្លាប់ បាន បញ្ជាក់ ថា កម្លាំង មាន សមត្ថកិច្ច រហូតដល់ ជាង ១ម៉ឺន នាក់ នឹង ត្រូវ ដាក់ពង្រាយ នៅ តាម តំបន់ A B និង C ក្នុង នោះ កម្លាំង របស់ គណៈ បញ្ជាការ ឯកភាព រាជធានី ភ្នំពេញ មាន រហូតដល់ ជាង ៨ ពាន់ នាក់ ដើម្បី ការពារ ព្រះរាជ ពិធី មួយ នេះ ។
ជាមួយគ្នា នេះ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង ក៏ បាន អំពាវនាវ ផងដែរ ដល់ ម្ចាស់ អាជីវករ ដឹក ទំនិញ ដែល ប្រើប្រាស់ រថយន្ដ ធំ ៗ ក្នុង ធ្វើដំណើរ ចូល រាជធានី ភ្នំពេញ នៅ ថ្ងៃ ដែល រៀបចំ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ ហើយ សម្រាប់ អ្នក ដែល មក កម្សាន្ដ ក៏ កុំ ជិះ រថយន្ដ ចូលទៅ បរិវេណ ទីតាំង ប្រារព្ធ ពិធី ផងដែរ ព្រោះ ចៀសវាង ការកកស្ទះ ចរាចរណ៍ ៕
អង្គ ជំនុំជម្រះ ក៏ បាន បើក សវនាការ ដេញដោល ពិនិត្យ ភ័ស្តុតាង លើ ការចោទប្រកាន់ អំពី លក្ខណៈ នៃ ជម្លោះ ប្រដាប់អាវុធ រវាង កម្ពុជា ប្រជាធិបតេយ្ យ និង សាធារណរដ្ឋ សង្គម និយម វៀតណាម តួនាទី របស់ ជនជាប់ចោទ នៅក្នុង រដ្ឋាភិបាល រួមទាំង ភ័ស្តុតាង ស្តីពី រចនាសម្ព័ន្ធ រដ្ឋបាល និង ប្រព័ន្ធ ទំនាក់ទំនង នៅក្នុង របប កម្ពុជា ប្រជាធិបតេយ្យ ៕
ព្រឹក នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ត្រឡប់មក កម្ពុជា វិញ ហើយ ក្រោយ បញ្ចប់ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ សិង្ហបុរី
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បិទ បញ្ចប់ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៣៣ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ ជាច្រើន ពោរពេញ ដោយ ភាពមមាញឹក រយៈពេល ៣ ថ្ងៃ កន្លងទៅ នោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ដឹកនាំ គណៈប្រតិភូ អញ្ជើញ ត្រឡប់មក កម្ពុជា វិញ ហើយ ។
បើ ទោះបី សហគមន៍ អាស៊ាន ត្រូវបាន វាយតម្លៃ មាន សាមគ្គីភាព ល្អ និង មាន ការគោរព តម្លៃ និង ផលប្រយោជន៍ របស់ ប្រទេស ជា សមាជិក យ៉ាងណា ក្តី តែ បញ្ហា ប្រឈម មួយ ចំនួន ចំពោះ សាមគ្គីភាព របស់ អាស៊ាន ក៏ ត្រូវបាន លើកឡើង ក្នុង កិច្ចប្រជុំ នេះ ផងដែរ ។ ក្នុង សុន្ទរកថា បើក កិច្ចប្រជុំ កំពូល អាស៊ាន លោក លី ស៊ាន ឡុង នាយ រដ្ឋមន្ត្រី សិង្ហបុរី និង ជា ប្រធាន អាស៊ាន បាន គូស រំលេច នូវ បញ្ហា គួរឲ្យ កត់សម្គាល់ ជាច្រើន ។
- នាយក រដ្ឋមន្ត្រី សិង្ហបុរី៖ ការប្រកួតប្រជែង របស់ មហា អំណាច បាន រុញ ច្រាន ឲ្យ សមាជិក អាស៊ាន មាន គោលដៅ ខុសគ្នា (Video inside) អ្នកនាំពាក្យ សាលា ក្តី ខ្មែរ ក្រហម លោក នេត្រ ភក្រ្តា រំឭក វិញ្ញាណក្ខន្ធ សម្តេច វិបុល បញ្ញា សុខ អាន ខណៈ ការប្រកាស សាលក្រម ប្រឆាំង នឹង ជនជាប់ចោទ នួន ជា និង ខៀវ សំផន នឹង ធ្វើឡើង នៅ ថ្ងៃទី ១៦ ខែវិច្ឆិកា
សាលា ក្តី ខ្មែរ ក្រហម ដែល នឹង ទទួលបាន សមិទ្ធិផល ជា ប្រវត្តិសាស្ត្រ ថ្មី មួយ ទៀត គឺ សាលក្រម សំណុំរឿង ០០២ / ០២ ដែល បាន ចោទប្រកាន់ នួន ជា និង ខៀវ សំផន ពី ឧក្រិដ្ឋកម្ម ប្រឆាំង នឹង មនុស្សជាតិ ការរំលោភបំពារបំពាន យ៉ាង ធ្ងន់ធ្ងរ លើ អនុសញ្ញា ទីក្រុង ហ្សឺណែវ ឆ្នាំ ១៩៤៩ ( ឧក្រិដ្ឋកម្ម សង្គ្រាម ) និង ឧក្រិដ្ឋកម្ម ប្រល័យ ពូជសាសន៍ លើ ជនជាតិ ចាម និង ជនជាតិ វៀតណាម ។
ខាងក្រោម នេះ គឺជា សំណេរ របស់ លោក នេត្រ ភក្ត្រា៖
ក្រោម ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច សុខ អាន បាន ធ្វើឱ្យ តុលាការ ខ្មែរ ក្រហម កើត ចេញ ជា រូបរាង ឡើង និង បាន នាំយក អតីត មេដឹកនាំ ជាន់ ខ្ពស់ និង អ្នកទទួលខុសត្រូវ ខ្ពស់ បំផុត ក្នុង ឧក្រិដ្ឋកម្ម ធ្ងន់ធ្ងរ យកមក ជំនុំជម្រះ ក្តី ដើម្បី៖
ធូប ដែល បាន អុជ បូជា ការវន្ទា គោរព វិញ្ញាណក្ខន្ធ សម្តេច វិបុល បញ្ញា សុខ អាន ដែល ខ្ញុំ បាន ធ្វើ គឺ ដើម្បី រំឭក គុណ មិន អាច កាត់ថ្លៃ បាន ដែល សម្តេច បាន បង្ហាត់ បង្រៀន ណែនាំ ពង្រឹង វិជ្ជាជីវៈ និង ការទទួលខុសត្រូវ គោរព គុណធម៌ សីលធម៌ ដល់ យើងខ្ញុំ និង បង្រៀន មនុស្ស ឱ្យ គោរព តម្លៃ មនុស្ស និង បម្រើ ប្រជាជន ។ សូម វិញ្ញាណក្ខន្ធ សម្តេច សុខ អាន បាន សោយសុខ ក្នុង សុគតិភព !
ប្រធានាធិបតី អ៊ូហ្គង់ ដា បញ្ជា ឱ្យ យោធា ការពារ ក្រុមហ៊ុន ចិន ក្រោយ អំពើ ប្លន់ កើនឡើង ជា បន្តបន្ទាប់
សូម ជម្រាប ថា ចិន កំពុង ធ្វើ ការ វិនិយោគ ជាច្រើន នៅក្នុង ប្រទេស អ៊ូហ្គង់ ដា ។ តែ មួយ រយៈពេល ចុងក្រោយ ក្រុមហ៊ុន ចិន មួយចំនួន បាន បង់ប្រាក់ និង ទ្រព្យសម្បត្តិ យ៉ាង សន្ធឹកសន្ធាប់ ដោយសារ អំពើ ប្លន់ នៅក្នុង ប្រទេស អាហ្រ្វិក ខាងកើត មួយ នេះ ហើយ ដើម្បី ដោះស្រាយ បញ្ហា លោក Museveni ក៏ បាន បង្គាប់ ឱ្យ អាជ្ញាធរ អ៊ូហ្គង់ ដា បង្កើន ការដើរល្បាត និង បំពាក់ កាមេរ៉ា សុវត្ថភាព នៅ តាម តំបន់ សួន ឧស្សហកម្ម ផងដែរ ៕
ក្រុម អាជីវករ សត្តឃាត ជាច្រើន នាក់ បាន ធ្វើ ការតវ៉ា និង សុំ ជួប ចរចា ជាមួយ ក្រុមហ៊ុន CP ក្នុង រយៈពេល ប្រមាណ ១ ឆ្នាំ មកហើយ ចាប់តាំងពី ក្រុមហ៊ុន ចាប់ផ្តើម កាប់ ជ្រូក មក ចែកចាយ នៅ តាម ទីផ្សារ ប៉ុន្តែ ការ ស្វែងរក ដំណោះស្រាយ មិន បាន ជោគជ័យ នោះ ទេ រហូត មាន ការជួបប្រជុំ ដេញដោល គ្នា មួយ បាន ធ្វើឡើង នៅ សណ្ឋាគារ កុង ទីណង់ តាល់ នា រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ។
នៅក្នុង កិច្ចប្រជុំ ខាងលើ នេះ ក្រុម អាជីវករ ដែល កំពុង ជួប ផលលំបាក បាន ស្នើសុំ ៣ចំណុច ធំ ៗ ដាក់ ជូន ក្រុមហ៊ុ គឺ ឲ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ ការកាប់ ជ្រូក ដោយ ខ្លួន ឯង ដែល ធ្វើឲ្យ ខាតបង់ ដល់ អាជីវករ រក មិន ចំណេញ ហើយ បើកាប់ ដោយ ខ្លួន ឯង នោះ គឺ ត្រូវ ដាក់ តម្លៃ ដូច ទៅនឹង តម្លៃ ដែល ពួកគាត់ ចែកចាយ នៅ តាម ទីផ្សារ ។
លោកស្រី ហាវ ឈួយ វង ម្ចាស់ អាជីវកម្ម មួយ រូប បាន លើកឡើង ថា ក្រុមហ៊ុន CP ត្រូវ បញ្ឈប់ ជាបន្ទាន់ គឺ ឈប់ កាប់ ជ្រូក យក សាច់ . ការបោះ ប៉ាយ ឲ្យ មាន ភាព សមស្រប ព្រមទាំង សំណូមពរ ឲ្យ មាន ការ ថ្លឹង ជ្រូក ឲ្យបាន ត្រឹមត្រូវ ពីព្រោះ កន្លងមក បាត់ គីឡូ ច្រើន ណាស់ ។
លោកស្រី បាន បញ្ជាក់ ថែម ទៀត ក្រុមហ៊ុន មាន លុយ ច្រើន ដូច្នេះ ជា ការកៀប សង្កត់ ទៅ លើ ក្រុម អាជីវករ ។ ក្រុម អាជីវករ បាន កោតសរសើរ ចំពោះ ក្រុមហ៊ុន ម៉ុង រិទ្ធី ថា បាន ដំណើរការ ល្អ ណាស់ ពោល ក្រុមហ៊ុន លោក ឧកញ៉ា ម៉ុង រិទ្ធី មិន បាន កាប់ ជ្រូក យក សាច់ ដោយ ខ្លួន ឯង ទេ គឺ ក្រុមហ៊ុន គេ គោរព តាម គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល ឬ ក្រសួង ដែល បាន កំណត់ ដាក់ ជូន ។
អាជីវករ ជាច្រើន នាក់ បាន ទទូច ដល់ ក្រុមហ៊ុន CP ឲ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ ករណី ខាងលើ នេះ បើ មិន ដូច្នេះ ទេ ពួកគាត់ នឹង ស្វែងរក យុត្តិធម៌ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ជួយ ដោះស្រាយ ។
ដោយឡែក តំណាង ក្រុមហ៊ុន ស៉ី ភី កម្ពុជា លោក សុផាត ចាន់ វង្ស មិន ព្រម បកស្រាយ ធ្វើ ការជួប សំភាសន៍ ជាមួយ ក្រុម អ្នកសារព័ត៌មាន នោះ ឡើយ ខណៈ ដែល តំណាង មន្រ្តី បសុព្យាបាល វិញ ក៏ មិន បាន ផ្តល់ កិច្ច សំភាសន៍ នោះ ដែរ ។
បើ តាម ក្រុម អាជីវករ ឆ្លង តាម ការសួរ ដេញដោល និង ពិភាក្សា គ្នា រួច មក ខាង មន្រ្តី បសុព្យាបាល បាន លើកឡើង ថា នឹង ដាក់ ជូន ថ្នាក់ លើ ដើម្បី ធ្វើ ការដោះស្រាយ បន្ត ទៀត ៕ ស្នងការ ខេត្ត កំពង់ចាម និង ACU ផ្សព្វផ្សាយ ច្បាប់ ប្រឆាំង អំពើពុករលួយ និង ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ ដល់ មន្ដ្រី នគរបាល
( កំពង់ចាម ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម លោក កែវ ធី វុធ ឧបការី នៃ អង្គភាព ប្រឆាំង អំពើពុករលួយ (ACU) នៅ រសៀល ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន ផ្សព្វផ្សាយ ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ និង ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ ដល់ មន្ដ្រី នគរបាល ខេត្ត កំពង់ចាម ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន មាន មតិ សំណេះសំណាល បើក កម្មវិធី និង ផ្តាំផ្ញើ ដល់ មន្ត្រី ក្រោម ឱវាទ ឲឥ្យ យកចិត្តទុកដាក់ និង អនុវត្ត ឲ្យបាន ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ និង ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ ហើយ ដាច់ខាត ត្រូវ ចៀស ឲ្យ ឆ្ងាយ ពី ទង្វើ ទាំង នេះ ។
បន្ថែម ពី នេះ លោក កែវ ធី វុធ ឧបការី នៃ អង្គភាព ប្រឆាំង អំពើ រលួយ បាន ធ្វើ ការផ្សព្វផ្សាយ ពី បំណិន នៃ អំពើពុករលួយ បទល្មើស ស៊ី សំណូក និយោជិក បទល្មើស អ្នក សូក និង បទល្មើស អ្នកទទួល សំណូក បទល្មើស ដេញថ្លៃ មិន ត្រឹមត្រូវ បទល្មើស វិតិ ក្រម បទល្មើស កេងយក ផលប្រយោជន៍ ដោយ ខុស ច្បាប់ បទល្មើស រំលោភ អំណាច បទល្មើស មិន ប្រកាស ទ្រព្យ និង បំណុល បទល្មើស រារាំង និង ជ្រៀត ជ្រៀត ដល់ ការងា អង្គភាព ប្រឆាំ អំពើពុករលួយ និង បទល្មើស ផ្សេង ជាច្រើន ទៀត ។
ក្នុង កិច្ចប្រជុំ នេះ ដែរ លោក កែវ ធី វុធ បាន ផ្សព្វផ្សាយ ដល់ មន្ត្រី ក្រោម ឱវាទ ត្រូវ យកចិត្តទុកដាក់ ទៅ លើ ការបង្ការ ទប់ ស្កាត់ អនុវត្ត ច្បាប់ និង វិធី ដាក់ពាក្យ ប្តឹង ទៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ ។
សូម ជម្រាប ថា កិច្ចប្រជុំ ខាងលើ នេះ ក៏ មាន ចូលរួម ពី លោក ស្នងការ រង លោក អនុផែន លោក នាយ ការិយាល័យ លោក នាយ រង ការិយាល័យ លោក អធិការ នគរបាល ស្រុក - ក្រុង ទាំង១០ លោក អធិការ រង លោក នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ១០៩ សរុប រួម ៣២៣ រូប ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ អ្នកនេសាទ ចំនួន ១៣នាក់ ត្រូវបាន ជួយ សង្រ្គោះ ទាន់ ពេលវេលា ក្រោយពី ទូក នេសាទ កូរ៉េ ខាងត្បូង របស់ ពួកគេ បាន លិច ចូល សមុទ្រ ដោយសារតែ ការប៉ះទង្គិច គ្នា ជាមួយ ទូក នេសាទ មួយ គ្រឿង ទៀត របស់ ជប៉ុន ៕
៣៖ ចំនួន សាកសព ជនរងគ្រោះ ដែល ត្រូវបាន រកឃើញ គឺ កើនឡើង ដល់ ៥៦ នាក់ ហើយ ដោយសារតែ ភ្លើង ឆេះ ព្រៃ នៅ ភាគ ខាងជើង រដ្ឋ កាលីហ្វរញ៉ា ៕
៤៖ ជន សកម្ម ប្រយុទ្ធ សរុប ២០ នាក់ បាន ស្លាប់ និង ០៤ នាក់ ផ្សេង ទៀត បាន រងរបួស បន្ទាប់ពី កង យន្តហោះ ចម្បាំង របស់ យោធា អាហ្វហ្គានីស្ថាន បាន បើក ការវាយប្រហារ ទម្លាក់ គ្រាប់បែក ទៅ លើ ទីតាំង លាក់ ខ្លួន របស់ ពួក តាលី បង់ នៅ ខេត្ត Ghazi ភាគ ខាងកើត ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ៕
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
រដ្ឋមន្ដ្រី កសិកម្ម ចុះ ពិនិត្យ សហគ្រាស កែច្នៃ ផលិតផល ស្វាយ មួយ កន្លែង នៅ ខេត្ត ត្បូងឃ្មុំ ដែល ចំណាយ ទុន វិនិយោគ ប្រមាណ ជាង ២លាន ដុល្លារ
តាម អ្នកចាត់ការ ទូទៅ របស់ ក្រុមហ៊ុន នេះ បាន ជម្រាប ជូន លោក រដ្ឋមន្រ្តី វេង សាខុន ឲ្យដឹង ថា ក្រុមហ៊ុន នេះ បាន ចាប់ ដំណើរការ កាលពី ខែឧសភា ឆ្នាំ ២០១៨ ដាក់ ទុន វិនិយោគ ប្រមាណ ជាង ២លាន ដុល្លារ មាន សមត្ថភាព កែច្នៃ ផ្លែ ស្វាយ ជា ផលិតផល ស្វាយ ស្ងួត បាន ចំនួន ៣០០តោន ក្នុង មួយ ខែ ។
អ្នកចាត់ការ ដដែល បាន បន្ថែម ទៀត ថា ជា មធ្យម ក្នុង ១ ថ្ងៃ ក្រុមហ៊ុន ប្រមូល ទិញ ផ្លែ ស្វាយ កែវ រមៀត ពី កសិករ ស្ថិត ក្នុង ខេត្ត កំពង់ចាម និង ត្បូងឃ្មុំ ប្រមាណ ពី ៦០ - ១០០តោន ក្នុង ១ ថ្ងៃ ហើយ ១គីឡូក្រាម ក្នុង តម្លៃ ១២០០ - ១៦០០ រៀល ។ ផលិតផល សម្រេច ភាគ ច្រើន ទាំងនោះ ត្រូវបាន នាំចេញ ទៅកាន់ ទីផ្សារ ចិន ក្នុង តម្លៃ ៥.៣ដុល្លារ ក្នុង ១គីឡូក្រាម ។
បន្ទាប់ពី បាន អញ្ជើញ ពិនិត្យ ខ្សែ សង្វាក់ ផលិតកម្ម រួច មក លោក វេង សា ខុន បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ ក្រុមហ៊ុន ក្នុង ការចូលរួមចំណែក រក ទីផ្សារ ស្វាយ ជូន ប្រជាកសិករ តាមរយៈ ការវិនិយោគ កែច្នៃ ផលិតផល ស្វាយ ដើម្បី នាំចេញ ។
លោក រដ្ឋមន្ដ្រី បាន បញ្ជាក់ ថា សកម្មភាព នេះ គឺ ពិតជា បាន រួមចំណែក ដោះស្រាយ បញ្ហា ទីផ្សារ ស្វាយ បង្កើន ប្រាក់ ចំណូល បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ផ្ទាល់ កាត់បន្ថយ ការធ្វើ ចំណាកស្រុក និង ភាពក្រីក្រ ។
យោង លើ របាយការណ៍ របស់ មន្ទីរ កសិកម្ម ខេត្ត ត្បូងឃ្មុំ បាន ឲ្យដឹង ថា ក្នុង ១ហិកតា ស្វាយ កែវ រមៀត អាច ផ្តល់ ទិន្នផល ជា មធ្យម១០តោន ទៅ២០ តោន លក់ បាន តម្លៃ ១០ ទៅ ២០ លាន រៀល ក្នុង ការប្រមូល ផល ម្តង ហើយ ក្នុង ១ ឆ្នាំ អាច ប្រមូល ផល បាន ២ដង ដូច្នេះ ១ ឆ្នាំ អាច ទទួលបាន ចំណូល យ៉ាងតិច ២០ លាន រៀល ។
ស្ថានភាព នៃ កម្រិត ចំណូល នេះ ដោយ ក្នុង ករណី ប្រជាកសិករ មាន ដី ដាំ ស្វាយ មួយ ហិកតា អាច សន្និដ្ឋាន បាន ថា អាច ឆ្លើយតប ទៅនឹង ចក្ខុវិស័យ របស់ រាជ រដ្ឋាភិបាល ដែល ចង់ ប្រែក្លាយ កម្ពុជា ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នា ឆ្នាំ ២០៣០ ។
លោក រដ្ឋមន្រ្តី វេង សា ខុន បាន បញ្ជាក់ ផងដែរ ថា ទស្សនកិច្ច នា ពេលនេះ គឺ ចង់ បង្ហាញ ពី ឱកាស ដល់ កសិករ ក្នុង ការដាំ ស្វាយ កែវ រមៀត សម្រាប់ វិនិយោគិន ធ្វើ ការកែច្នៃ ដើម្បី នាំចេញ ផលិតផល សម្រេច ដោយ ត្រូវ អនុវត្ត កសិកម្ម តាម កិច្ចសន្យា និង ជាពិសេស គឺ លើកទឹកចិត្ត និង គាំទ្រ ដល់ វិស័យ ឯកជន ដែល ត្រូវ រួមគ្នា ជាមួយ រដ្ឋ ( រដ្ឋ - វិស័យ ឯកជន ) ក្នុង ការជំរុញ និង នាំយក ផលិតផល កសិកម្ម ទៅកាន់ ទីផ្សារ អន្តរជាតិ ។
សូម បញ្ជាក់ បន្ថែម ថា បច្ចុប្បន្ន ក្រុមហ៊ុន បាន និង កំពុង ធ្វើ ការចរចា ជាមួយ ក្រុមហ៊ុន អូស្រ្តាលី ដើម្បី ការកែឆ្នៃ ស្វាយ ចន្ទិរ ហើយ នាំចេញ នា ពេល ខាងមុខ ។ លោក រដ្ឋមន្រ្តី បាន សារទ ចំពោះ ព័ត៌មាន នេះ និង បាន សំណូមពរ និង លើកទឹកចិត្ត ឲ្យ គិតគូ ធ្វើ ការកែច្នៃ ផលិត កសិកម្ម ផ្សេង បន្ថែម ទៀត ដើម្បី នាំចេញ ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ទស្សនា ការ ផ្សាយ ផ្ទាល់ ២៤ ម៉ោង របស់ ទូរទស្សន៍ Fresh News តាមរយៈ Smart TV . កុំព្យូទ័រ និង លើ ទូរស័ព្ទ
១៖ មេដឹកនាំ អាស៊ាន៖ សង្រ្គាម ពាណិជ្ជកម្ម កំពុង ដាក់ សម្ពាធ និង គំរាមកំហែង ដល់ ស្ថិរភាព កំណើន សេដ្ឋកិច្ច ប្រទេស កំពុង អភិវឌ្ឍន៍ ( ចុច អាន )
២៖ សម្តេច តេជោ ហ៊ុន សែន គាំទ្រ សំណើ រុស្ស៉ី ក្នុង ការដំឡើង ទំនាក់ទំនង ដៃគូ សន្ទនា អាស៊ាន - រុស្ស៉ី ទៅជា ដៃគូ សន្ទនា ( ចុច អាន )
៣៖ សម្តេច តេជោ ហ៊ុន សែន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ជប៉ុន ក្នុង ការជួយ កសាង សហគមន៍ អាស៊ាន ( ចុច អាន )
៤៖ សម្តេច តេជោ ហ៊ុន សែន វាយតម្លៃ ខ្ពស់ ចំពោះ ការប្តេជ្ញាចិត្ត របស់ ឥណ្ឌា ក្នុង ការពង្រឹង ចំណង មិត្តភាព ជាមួយ អាស៊ាន ( ចុច អាន )
៥៖ សម្តេច តេជោ ហ៊ុន សែន៖ កិច្ចព្រមព្រៀង នៃ ប្រទេស សេដ្ឋកិច្ច ទូលំទូលាយ ត្រូវតែ ជា កិច្ចព្រមព្រៀង ផ្តល់ ផលប្រយោជន៍ ឲ្យ គ្រប់ សមាជិក ទាំងអស់ ( ចុច អាន )
៧៖ អ្នកនាំពាក្យ គឹម សន្តិភាព៖ ហ៊ាង រិទ្ធី បន្លំ ខ្លួន ជា មេធាវី បង្កើត ការភាន់ច្រឡំ លើ ទិដ្ឋភាព ច្បាប់ ស្រប ពេល សម្តេច តេជោ ហ៊ុន សែន ហៅ ក្រុម អ្នកច្បាប់ និង មេធាវី ដែល គាំទ្រ ក្រុម ប្រឆាំង ថា ជា បុគ្គល គ្មាន កាយសម្បទា គ្រប់គ្រាន់ ក្នុង ការស្តាប់ យល់ នូវ ភាសា របស់ សម្តេច ( ចុច អាន )
៨៖ ការិយាល័យ មេធាវី៖ កុំ យក វិជ្ជាជីវៈ ច្បាប់ មក ជាន់ ឈ្លី ដើម្បី ទទួលបាន ភាពល្បីល្បាញ ខុស ទំនង ( ចុច អាន )
១១៖ ក្រុមហ៊ុន ដ៏ ធំ មួយ របស់ ចិន បង្ហាញ មហិច្ឆតា ប្រែក្លាយ ស្ទឹង ហាវ ទៅជា កន្លែង អភិវឌ្ឍន៍ ជឿនលឿន ដូច ទីក្រុង ហ្ស៊ិន ជិន ( ចុច អាន )
១២៖ ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ៖ សម្តេច តេជោ ហ៊ុន សែន ជា វីរវិស្វករ នាំមក នូវ សុខ សន្តិភាព ស្ថិរភាព នយោបាយ ជូន មាតុភូមិ កម្ពុជា ( ចុច អាន )
១៤៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ បញ្ចប់ មុខតំណែង លោក ឡុង វិសាលោ ពី ឯក អគ្គ រាជ ទូត នៅ ថៃ ជំនួស ដោយ លោក អ៊ូក សោភ័ណ . លោក វិសាលោ ត្រូវតែងតាំង ជា រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី ទទួលបន្ទុក ព្រំដែន ( ចុច អាន )
១៥៖ ព្រឹក ថ្ងៃ នេះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បន្ដ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ជូន ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ជិត ២ពាន់ គ្រួសារ ទៀត នៅ ខេត្ដ មណ្ឌលគិរី អាជ្ញាធរ រាជធានី ភ្នំពេញ ( ចុច អាន )
១៦៖ សមត្ថកិច្ច ជាង ១ម៉ឺន នាក់ នឹង ត្រូវ ដាក់ពង្រាយ សម្រាប់ ការពារ សន្តិសុខ និង សណ្តាប់ធ្នាប់ នៅ ថ្ងៃ បុណ្យ អុំ ទូក ( ចុច អាន )
បើ តាម រដ្ឋអាជ្ញា ខាងលើ មនុស្ស ចំនួន ១១នាក់ ត្រូវបាន ចោទប្រកាន់ ក្នុង សំណុំរឿង ឃាតកម្ម លោក Khashoggi ក្នុង ចំណោម មនុស្ស ទាំង ២១ នាក់ ដែល ត្រូវបាន ឃាត់ខ្លួន ហើយ ក្នុង ចំណោម ១១នាក់ នោះ ទៀតសោត ០៥ នាក់ អាចនឹង ត្រូវ ប្រឈម ទោស ប្រហារជីវិត ។
កិច្ចសហប្រតិបត្តិការ រុករក អដ្ឋិធាតុ ទាហាន អាមេរិក នៅ កម្ពុជា ត្រូវបាន ប្រកាស ផ្អាក ជា បណ្តោះអាសន្ន ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ចាប់តាំងពី ខែកញ្ញា ឆ្នាំ ២០១៧មក បន្ទាប់ពី សហរដ្ឋ អាមេរិក បាន ផ្អាក ការផ្តល់ ទិដ្ឋាការ (Visa) ប្រភេទ B1 និង B2 ( ប្រភេទ ទេសចរណ៍ និង ជំនួញ ) ដល់ មន្រ្តី ក្រសួង ការបរទេស កម្ពុជា ចាប់តាំងពី ថ្នាក់ អគ្គ នាយក រហូតដល់ ថ្នាក់ កំពូល ។
គិត រហូតមកដល់ ពេលនេះ កិច្ចសហប្រតិបត្តិការ រុករក អដ្ឋិធាតុ ទាហាន អាមេរិក នៅ កម្ពុជា ត្រូវបាន ប្រកាស ផ្អាក ជា បណ្តោះអាសន្ន រយៈពេល ជាង ១ ឆ្នាំ មកហើយ ខណៈ ដែល អដ្ឋិធាតុ របស់ ទាហាន អាមេរិក ដែល បាត់បង់ជីវិត នៅលើ ដី កម្ពុជា ទាំងអស់ មាន ប្រមាណ ៨០ នាក់ ហើយ បច្ចុប្បន្ន រកឃើញ ៤០ នាក់ ប៉ុណ្ណោះ ។
គួរ ជម្រាប ថា កាលពី ដើម ខែតុលា រុស្ស៉ី បាន ប្រកាស ពី ការប្រគល់ ប្រព័ន្ធ S-300 ចំនួន ប៉ុន្មាន គ្រឿង ទៅកាន់ ស៊ីរី ដើម្បី ជា ការឆ្លើយតប ចំពោះ ករណី បាញ់ ទម្លាក់ យន្តហោះ យោធា រុស្ស៊ី Il-20 ដែល បាន បណ្តាលឲ្យ នាយ ទាហាន ១៥ នាក់ ស្លាប់ នៅក្បែរ ទីក្រុង Latakia ប្រទេស ស៊ីរី ។ ទីក្រុង ម៉ូស្គូ បាន ចោទ កង យន្តហោះ ចម្បាំង អ៊ីស្រាអែល ថា បាន ប្រើ យន្តហោះ រុស្ស៊ី ធ្វើជា ខែល ក្នុង ប្រតិបត្តិការ វាយប្រហារ របស់ ពួកគេ នៅ ស៊ីរី ដែល ទីបំផុត ធ្វើឲ្យ យន្តហោះ នោះ ត្រូវ ប្រព័ន្ធ ការពារ អាកាស ស៊ីរី ច្រឡំ បាញ់ ទម្លាក់ ៕
បញ្ហា សំខាន់ ៗ នៅក្នុង តំបន់ និង ពិភពលោក មួយចំនួន ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន លើកឡើង នៅ កិច្ចប្រជុំ កំពូល អាស៊ាន ជាមួយ ចិន ជប៉ុន និង សាធារណរដ្ឋ កូរ៉េ លើក ទី ២១
មេដឹកនាំ ទាំងអស់ បាន ចាត់ទុក ថា ក្នុង ពេល ពីរ ទសវត្សរ៍ កន្លងមក កិច្ចសហប្រតិបត្តិការ របស់ យើង មាន សន្ទុះ កាន់តែ ខ្លាំង មាន លក្ខណៈ កាន់តែ ទូលំទូលាយ ជាង មុន និង បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការលើកកម្ពស់ សន្ដិភាព សន្តិសុខ ស្ថិរភាព និង វិបុលភាព ក្នុង តំបន់ អាស៊ី បូព៌ា ។
ក្នុង ឱកាស នោះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន បង្ហាញ ពី ចំណាប់ និង ទស្សនទាន មួយចំនួន ឆ្លើយតប ទៅនឹង បញ្ហា របស់ តំបន់ និង ពិភពលោក ដែល ទាមទារ ឲ្យ អាស៊ាន និង ប្រទេស ដៃ គូ ទាំង ៣ចូលរួម ដោះស្រាយ ។ បញ្ហា ដែល សម្តេច តេជោ បាន លើកឡើង រួម មាន៖
ទី២. ពិភពលោក និង តំបន់ បាន និង កំពុង ទទួល រក គ្រោះមហន្តរាយ កាន់តែ ញឹកញាប់ និង កាន់តែ ធ្ងន់ធ្ងរ ឡើង ។ ហេតុ នេះ កម្ពុជា សូម ជំរុញ លើកទឹកចិត្ត ដល់ ប្រទេស សមាជិក អាស៊ាន និង ប្រទេស បូក បី ទាំងអស់ បន្ត ផ្ដោត ការយកចិត្តទុកដាក់ ឱ្យ បាន ច្រើន ជាង មុន ថែម ទៀត លើ ការការពារ បិស្ថាន និង ធនធាន ធម្មជាតិ ក្នុង គោលដៅ កសាង សហគមន៍ មួយ នេះ ឱ្យ បាន រឹងមាំ . មាន ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង ស្រប តាម គោលដៅ ការអភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ អង្គការ សហ ប្រជាជាតិ នៅ ឆ្នាំ ២០៣០ ។
ទី៣. សម្តេច សូម វាយតម្លៃ ខ្ពស់ ចំពោះ ការបន្ត ពង្រឹង យន្ដ ការ ដែល បាន ដាក់ ឱ្យ ដំណើរការ បណ្ដាញ ក្នុង អ្នកវិភាគ អាស៊ី បូព៌ា និង ក្រុម ធុរកិច្ច អាស៊ី បូព៌ា និង បាន កត់សម្គាល់ នូវ រាល់ អនុសាសន៍ ទាំងឡាយ ដែល យន្ត ការ ទាំង នេះ បាន ដាក់ចេញ ក្នុង គោលដៅ ជំរុញ កិច្ចសហប្រតិបត្តិការ អាស៊ាន បូក បី ឱ្យ កាន់តែ ប្រសើរឡើង ។
ទី៤. ខ្ញុំ ពិតជា មាន សេចក្ដីរីករាយ ដោយ បាន ឃើញ កិច្ចសហប្រតិបត្តិការ របស់ យើង ក្នុង វិស័យ សុខាភិបាល មាន ការរី ចម្រើន គួរឱ្យ កត់សម្គាល់ ជាពិសេស ការដាក់ចេញ នូវ សេចក្ដី ប្រកាស របស់ ថ្នាក់ដឹកនាំ អាស៊ាន បូក បី ស្តីពី កិច្ចសហប្រតិបត្តិការ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ភាពស៊ាំង ទៅនឹង ឱសង អង់ទីប៊ីយោទិក ។
នៅក្នុង វិស័យ សិខាភិបាល នេះ ដែរ ខ្ញុំ សូម អនុញ្ញាត ទាញ អារម្មណ៍ ថ្នាក់ដឹកនាំ នៃ ប្រទេស អាស៊ាន បូក បី អំពី បញ្ហា ឱសថ ក្លែងក្លាយ និង អន់ គុណភាព ដែល កំពុងតែ បង្ក បញ្ហា ធ្ងន់ធ្ងរ ដល់ សុខភាព និង សុខ មាលភាព របស់ ប្រជាជន ។ ឱសថ ក្លែងក្លាយ និង អន់ គុណភាព ជា ឃាតក លាក់ មុខ បំផុត សម្រាប់ ប្រជាជន ក្រីក្រ ហើយក៏ បង្ក ការរាំងស្ទះ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ផងដែរ ។
ការប្រយុទ្ធ ប្រឆាំង នឹង ឱសថ ក្លែងក្លាយ និង អន់ គុណភាព តម្រូវឱ្យ មាន កិច្ចសហការ ល្អ ប្រសើរ រវាង ប្រទេស ទាំងអស់ ក្នុង តំបន់ ។ ក្នុង ន័យ នេះ កម្ពុជា ស្នើសុំ ដាក់ ការប្រយុទ្ធ ប្រឆាំង ឱសថ ក្លែងក្លាយ និង អន់ គុណភាព ទៅជា របៀបវារៈ ដ៏ សំខាន់ មួយ នៃ កិច្ចសហប្រតិបត្តិការ អាស៊ាន បូក បី នៃ ហើយ ។
ទី៥. ជាមួយនឹង និន្នាការ គាំពានិយម ក៏ ដូចជា សង្គ្រាម ពាណិជ្ជកម្ម ដែល កំពុង ធ្វើឱ្យ ប្រព័ន្ធ ពាណិជ្ជកម្ម សេរី ចុះ អន់ខ្សោយ ។ តាម រយះ នេះ សម្តេច សូម ស្នើ ឱ្យ ប្រទេស បូក បី ជួយ ជំរុញ និង បញ្ចប់ ការចរចា ភាព ជាដៃគូរ សេដ្ឋកិច្ច ទូលំទូលាយ នៅក្នុង តំប់ន (RCEP) នៅ ឆ្នាំ ២០១៩ ។
ទន្ទឹម នេះ សម្តេច តេជោ ក៏ បាន ប្រកាស ស្វាគមន៍ នូវ គម្រោង ស្រាវជ្រាវ រួមគ្នា ស្ដីពី កិច្ចសហប្រតិបត្តិការ ១០+ ៣ សម្រាប់ ការធ្វើឱ្យ ប្រសើរ ជាង មុន នៃ ការតភ្ជាប់ ខ្សែ ច្រវាក់ ផ្គត់ផ្គង់ ដែល នឹង ជំរុញ ពាណិជ្ជកម្ម និង ការវិនិយោគ និង ជួយ ដល់ ការតភ្ជាប់ និង ផែនការ សមាហរណកម្ម សេដ្ឋកិច្ច ក្នុង តំបន់ ។
នៅក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន បូក បី លើក ទី ២១ នោះ ដែរ បណ្តា មេដឹកនាំ អាស៊ាន និង ប្រទេស បូក បី បាន ឯកភាព គ្នា ក្នុង ការឈាន ទៅ ចេញ សេចក្តីប្រកាស របស់ ប្រធាន កិច្ចប្រជុំ កំពូល អាស៊ាន បូក បី លើក ទី ២១ ។
សេចក្តីប្រកាស របស់ ថ្នាក់ដឹកនាំ អាស៊ាន បូក បី ស្តីពី កិច្ចសហប្រតិបត្តិការ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ភាពស៊ាំ ទៅ និង ឱសថ អង់ទីប៊ីយោទិក ។ របាយការណ៍ វឌ្ឍនភាព ស្តីពី ការអនុវត្ត ផែនការការងារ កិច្ចសហប្រតិបត្តិការ អាស៊ាន បូក បី ឆ្នាំ ២០១៨ - ២០២២ ។ សំណើរ គម្រោង សម្រាប់ ការ សិក្សា រួម ស្តីពី កិច្វសហប្រតិបត្តិការ 10+3 សម្រាប់ ការធ្វើឲ្យ ប្រសើរឡើង នូវ ការតភ្ជាប់ ចង្វាក់ ផលិតកម្ម ។
កម្មវិធី ការងារ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច អាស៊ាន បូក បី ឆ្នាំ ២០១៩ - ២០២០ ។ អនុស្សារណៈ លេខ ១៥ នៃ បណ្តាញ ក្រុម អ្នកវិភាគ អាស៊ី បូព៌ា ។ គោល នយោបាយ សម្រាប់ កិច្ចប្រជុំ ថ្នាក់ដឹកនាំ អាស៊ាន បូក បី អាស៊ាន បូក បី និង ហានិភ័យ ខាងក្រៅ « ការទ្រទ្រង់ ការអភិវឌ្ឍ តាមរយៈ កិច្ចសហប្រតិបត្តិការ » និង របាយ កត់សំគាល់ នៃ កិច្ចប្រជុំ វេទិកា អាស៊ី បូព៌ា លើក ទី ១៦ ៕
រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល អំពាវនាវ ឲ្យ អាណាព្យាបាល ទាំងអស់ នាំ កូន ទៅ ចាក់ វ៉ាក់សាំង ការពារ ជម្ងឺ ថ្លើម ប្រភេទ B នៅ តាម មន្ទីរពេទ្យ នានា ដែល នៅជិត ផ្ទះ
( ឧត្តរមានជ័យ )៖ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ដែល ជា ឪពុក ម្តាយ ឬ អាណាព្យាបាល ទាំងអស់ នៅក្នុង ខេត្ត ឧត្ដរ មានជ័យ សូម មេត្តា យក កូន មក ចាក់ វ៉ាក់សាំង នៅ តាម បណ្ដា មន្ទីរពេទ្យ នានា នៅក្នុង ខេត្ត ដែល នៅជិត ផ្ទះ របស់ លោក អ្នក ដើម្បី ការពារ កុមារ និង កុំ ឲ្យ មាន ជំងឺ ថ្លើម ប្រភេទ B ។
ការថ្លែង អំពាវនាវ របស់ សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង នៅក្នុង ឱកាស ដែល លោក អញ្ជើញ ចុះ ពិនិត្យ សាកសួសុខ ទុក្ខ បងប្អូន ប្រជាពលរដ្ឋ ដែល មក ទទួល សេវា ព្យាបាល ពិនិត្យ សុខភាព និង កំពុង សំរាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ឧត្តរមានជ័យ នៅ ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ។
ក្នុង ការអញ្ជើញ ចុះ សួរសុខទុក្ខ នោះ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង បាន លើកឡើង ថា ដើម្បី ធ្វើឱ្យ ប្រជាពលរដ្ឋ កាន់តែ មាន ជំនឿ ជឿជាក់ លើ វិស័យ សុខាភិបាល ក្រុម គ្រូពេទ្យ ទាំងអស់ ត្រូវ ពង្រឹង នូវ សមត្ថភាព បច្ចេកទេស សីលធម៌ វិជ្ជាជីវៈ ឲ្យបាន កាន់តែ ខ្ពស់ បន្ថែម ទៀត ដើម្បី ពង្រីក នូវ ទំនុក ទុកចិត្ត ពី ប្រជាពលរដ្ឋ ក្នុង ការពិនិត្យ ព្យាបាល ដល់ អ្នកជំងឺ ។
លោក ក៏ បាន ផ្ដាំផ្ញើរ ទៅ ដល់ ប្រជាពលរដ្ឋ ដែល មក សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេ ទ្ប ង្អែក នៅក្នុង ខេត្ត ខេត្ត ឧត្ដរ មានជ័យ ទាំងអស់ ត្រូវតែ បរិភោគ ថ្នាំ ឲ្យបាន ទៀត ទាត់ ទៅ តាម កាលវិភាគ របស់ លោកគ្រូពេទ្យ ដើម្បីឲ្យ ឆាប់ ស្បើយ ពី ជំងឺ ជាពិសេស នោះ នៅ ពេល ដែល ត្រឡប់ ទៅ ផ្ទះ វិញ ត្រូវតែ ថែរក្សា សុខភាព ដោយ រស់ នៅ ស្អាត បរិភោគ ស្អាត និង ត្រូវ គេង នៅក្នុង មុង ច្រលក់ ថ្នាំ ដើម្បី ទប់ស្កាត់ កុំ ឲ្យ មាន ជំងឺ កើតឡើង ។
យ៉ាងណា ម៊ិញ នៅ រសៀល នោះ ដែរ លោក ម៉ម ប៊ុន ហេង ក៏ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ មន្ទីរ សុខាភិបាល និង មន្រ្តី សុខាភិបាល ខេត្ត ឧត្ដមាន ជ័យ ដោយ បាន ផ្ដាំផ្ញើ ទៅដល់ មន្រ្តី សុខាភិបាល ខេត្ត ទាំងអស់ ត្រូវតែ ផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ ដល់ ប្រជាពលរដ្ឋ អំពី ការរីកចម្រើន និង ការផ្តល់ សេវា នានា លើ វិស័យ សុខាភិបាល ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ ប្រជាពលរដ្ឋ ដែល មាន បញ្ហា សុខភាព ចូលរួម ពិគ្រោះ ពិនិត្យ និង ព្យាបាល នៅ មន្ទីរពេទ្យ រដ្ឋ កាន់តែ ច្រើន ឡើង ថែម ទៀត ៕
ការថ្លែង របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ កំពូល អាស៊ាន - សហរដ្ឋ អាមេរិក លើក ទី៦ ក្រោម ប្រធានបទ « ការពនិត្យ ឡើងវិញ នូវ កិច្ចសហប្រតិបត្តិការ អាស៊ាន អាមេរិក និង ទិសដៅ អនាគត » ។ កិច្ចប្រជុំ នេះ ក៏ មាន ការយាង និង អញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ កំពូល របស់ ប្រទេស សមាជិក អាស៊ាន ដទៃ ទៀត រួម នឹង លោក ម៉ៃ ឃើល ភែនស៍ ផងដែរ ។
ក្រៅពី ការចង់ ឃើញ អាមេរិក បង្កើន ទំហំ ពាណិជ្ជកម្ម ជាមួយ អាស៊ាន ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន លើកឡើង ផងដែរ កិច្ចសហប្រតិបត្តិការ រវាង អាមេរិក និង អាស៊ាន នៅ មាន សក្ដានុពល ជាច្រើន ទៀត ដូចជា កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ន វានុវត្តន៍ សេដ្ឋកិច្ច ឌីជីថល ពាណិជ្ជកម្ម វិស័យ ទេសចរណ៍ និង បច្ចេកវិទ្យា ព័ត៌មាន ជាដើម ដែល អនុញ្ញាតិ ឱ្យ អាស៊ាន និង អាមេរិក ចាប់ យក ដើម្បី ឈានទៅ សម្រេចបាន ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
សម្តេច នាយក រដ្ឋមន្ត្រី បាន បន្ថែម ថា ការកសាង ធនធាន មនុស្ស ជាពិសេស យុវជន គឺជា កត្តា ចាំបាច់ ក្នុង ការគាំទ្រ របស់ សហរដ្ឋ អាមេរិក ក្នុង ការកសាង ធនធាន មនុស្ស និង វិស័យ អប់រំ ដោយ ផ្ដល់ ឱកាស អាហារូបករណ៍ បន្ថែម ទៀត ដល់ យុវជន អាស៊ាន ជាពិសេស យុវជន ពី ប្រទេស កម្ពុជា ដើម្បី ទៅ បន្ត ការសិក្សា ថ្នាក់ ឧត្តម សិក្សា និង ក្រោយ ឧត្តម សិក្សា បន្ថែម ទៀត ។
ការថ្លែង វាយតម្លៃ និង កោតសរសើរ ចំពោះ ឆន្ទៈ របស់ ឥណ្ឌា ក្នុង ការពង្រឹង ចំណង មិត្តភាព ជាមួយ អាស៊ាន នេះ បាន ធ្វើឡើង ក្នុង ពេល ដែល សម្តេច តេជោ ហ៊ុន សែន រួម និង មេដឹកនាំ អាស៊ាន ដទៃ ទៀត បាន បើក កិច្ចប្រជុំ កំពូល ក្រៅ ផ្លូវការ អាស៊ាន - ឥណ្ទា ជាមួយ លោក ណារិន ដ្រា មូឌី នាយក រដ្ឋមន្រ្តី នៃ សាធារណរដ្ឋ ឥណ្ឌា នៅ ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ នៅក្នុង ប្រទេស សិង្ហបុរី ។
មេដឹកនាំ អាស៊ាន និង ឥណ្ឌា បាន សំដែង នូវ ការ មិន ពេញចិត្ត លើ វិស័យ សេដ្ឋកិច្ច នៃ តំបន់ ទាំង ពីរ អាស៊ាន - ឥណ្ទា ដែល ទើប សម្រេចបាន នូវ ទំហំ ពាណិជ្ជកម្ម ត្រឹម តែ ៧៣. ៥ប៊ីលាន ដុល្លា អាមេរិក ក្នុង ឆ្នាំ ២០១៧ ពោលគឺ តិច ជាង ពាក់កណ្តាល នៃ គោលដៅ ពាណិជ្ជកម្ម ដែល អាស៊ាន និង ឥណ្ឌា បាន កំណត់ ថា នឹង សម្រេច ឲ្យបាន ចំនួន ២០០ប៊ីលាន លាន ដុល្លា អាមេរិក នៅ ត្រឹម ឆ្នាំ ២០២០ ។
មេដឹកនាំ អាស៊ាន - ឥណ្ឌា បាន សន្យា រួមគ្នា ថា យើង ត្រូវ ខិតខំ រួមគ្នា បន្ថែម ទៀត ក្នុង ការជំរុញ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច ឲ្យ កាន់តែ ច្រើន និង ទូលំទូលាយ តាម រយះ ការពង្រឹង និង ពង្រីក សកម្មភាព ធុរកិច្ច ការវិនិយោគ និង ពាណិជ្ជកម្ម ក្នុង វិស័យ ដែល មាន សក្តានុពល ដូចជា ក សិ- ឧស្សាហកម្ម ទេសចរណ៍ ផលិតផល ឱសថ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា ជាដើម ។
នៅក្នុង ពិធី ពិសារ ពេលព្រឹក ការងារ នៃ កិច្ចប្រជុំ កំពូល ក្រៅ ផ្លូវការ អាស៊ាន - ឥណ្ទា ក្រោម ប្រធានបទ ការពិនិត្យ ឡើងវិញ នូវ កិច្ចសហប្រតិបត្តិការ អាស៊ាន - ឥណ្ទា និង ទិសដៅ អនាគត នោះ មេដឹកនាំ អាស៊ាន - ឥណ្ទា បាន ឯកភាព គ្នា ក្នុង ការឈាន ទៅ ចេញ សេចក្តីប្រកាស របស់ ប្រធាន កិច្ចប្រជុំ ក្រៅ ផ្លូវការ អាហារ ពេលព្រឹក អាស៊ាន - ឥណ្ទា ក្នុង បរិយាកាស ស្និទ្ធស្នាល រ៉ាក់ទាក់ បំផុត ៕ ភ្ញៀវ ទេសចរ ជិត ៨. ៥លាន នាក់ ធ្វើដំណើរ តាម អាកាសយានដ្ឋាន អន្ដរជាតិ ទាំង៣ របស់ កម្ពុជា នៅ១០ ខែ ឆ្នាំ ២០១៨
( ភ្នំពេញ ) ៖ លោក ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ឋលេខាធិការ នៃ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល កម្ពុជា បាន ឲ្យដឹង ថា រយៈពេល ១០ខែ ឆ្នាំ ២០១៨ នេះ គិត ពី ខែមករា - តុលា កម្ពុជា មាន ភ្ញៀវ ទេសចរ ឆ្លងកាត់ តាម អាកាសយានដ្ឋាន អន្ដរជាតិ ទាំង៣ ជិត ៨. ៥លាន នាក់ កើនឡើង ចំនួន ២១. ៧% បើ ធៀប នឹង រយៈ ដូចគ្នា ឆ្នាំ ២០១៧ ដែល មាន ត្រឹមតែ ៧លាន នាក់ ប៉ុណ្ណោះ ។
ការលើកឡើង បែប នេះ របស់ លោក រដ្ឋមន្ត្រី ធ្វើឡើង នា ឱកាស ដែល លោក អញ្ជើញ ចូលរួម សិក្ខាសាលា ស្ដីពី « ការតភ្ជាប់ ការហោះហើរ កាលានុវត្តភាព និង ការប្រឈម » ដែល មាន ការចូលរួម ពី មន្រ្ដី នៃ ប្រទេស កម្ពុជា . ឡាវ . ភូមា និង ចិន នា ព្រឹក ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
ជាមួយនឹង ការរីកចម្រើន នៃ អាកាសយានដ្ឋាន របស់ កម្ពុជា នេះ ទើប អាកាសចរ ស៊ីវិល បាន ប្រមូលផ្ដុំ មន្រ្ដី របស់ កម្ពុជា . ឡាវ . ភូមា និង ចិន ចូលរួម សិក្ខាសាលា ស្ដី អំពី « ការតភ្ជាប់ ការហោះហើរ កាលានុវត្តភាព និង ការប្រឈម » ដោយ សិក្ខាសាលា នេះ ធ្វើឡើង ដើម្បី សិក្សា ពី គម្រោង លើកកម្ពស់ ការតភ្ជាប់ រយៈពេល ១ឆ្នាំ កន្លះ ក្រោម ជំនួយ ឧបត្តម គាំទ្រ របស់ ប្រទេស ចិន ។
គម្រោង លើកកម្ពស់ ការតភ្ជាប់ ផ្លូវ អាកាស រវាង ប្រទេស កម្ពុជា . ឡាវ . ភូមា និង ចិន នេះ ធ្វើឡើង ក្នុង គោលបំណង ជួយ ដល់ ប្រទេស ទាំង៣ ក្នុង ការតភា្ជប់ ផ្លូវ អាកាស ឆ្ពោះទៅ ឬ ត្រឡប់ មកពី ប្រទេស ចិន ។
( កាប៊ុល) ៖ ជន សកម្ម ប្រយុទ្ធ សរុប ២០ នាក់ បាន ស្លាប់ និង ០៤ នាក់ ផ្សេង ទៀត បាន រងរបួស បន្ទាប់ពី កង យន្តហោះ ចម្បាំង របស់ យោធា អាហ្វហ្គានីស្ថាន បាន បើក ការវាយប្រហារ ទម្លាក់ គ្រាប់បែក ទៅ លើ ទីតាំង លាក់ ខ្លួន របស់ ពួក តាលី បង់ នៅ ខេត្ត Ghazi ភាគ ខាងកើត ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
អភិបាល ក្រុង ប៉ោយប៉ែត ប្រកាស រក ក្រុមហ៊ុន ប្រមូល សំរាម ថ្មី . បន្ទាប់ពី ក្រុមហ៊ុន ប្រមូល សំរាម ចាស់ មិន បាន បំពេញ កាតព្វកិច្ច
