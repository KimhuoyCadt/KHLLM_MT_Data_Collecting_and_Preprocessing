( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ រស់ នៅក្នុង សហគមន៍ វិមាន ទ្រង់ ហៅ សហគមន៍ ( នគរ ថ្មី ) ក្នុង សង្កាត់ ក្រាំង ធ្នង់ ខណ្ឌ សែនសុខ ចំនួន ៨៣៧ គ្រួសារ ស្មើនឹង ៨៣៧ ក្បាល ដី បាន ទទួល បណ្ណ កម្មសិទ្ធិ អចលន វត្ថុ ស្រប ច្បាប់ ពី រដ្ឋបាល រាជធានី ភ្នំពេញ ហើយ ក្រោយពី មន្ត្រី ជំនាញ បាន រៀបចំ រួចរាល់ តាម នីតិវិធី ដែល ជា ដំណាក់កាល ចុងក្រោយ នៃ ដំណើរការចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ កម្មវិធី អនុវិស័យ រដ្ឋបាល ដីធ្លី ដែល កំពុង អនុវត្ត ក្នុង រាជធានី - ខេត្ត ទាំង ២៥ នៃ កម្ពុជា ។
ពីធី ប្រគល់ និង ទទូល បណ្ណ កម្មសិទ្ធិ អចលន វត្ថុ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៨ នេះ ក្រោម អធិបតីភាព លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដែល រៀបចំ ធ្វើឡើង នៅក្នុង សហគមន៍ វិមាន ទ្រង់ តែម្តង ដោយ មាន ប្រជាពលរដ្ឋ ចូលរួម ជាច្រើន រយ នាក់ ។
លោក ឃួង ស្រេង បាន លើកឡើង ថា ទំរាំ បាន ឈាន មកដល់ ដំណាក់កាល ផ្តល់ បណ្ណ កម្មសិទ្ធិ ស្រប ច្បាប់ នេះ គឺ យើង បាន ខិតខំ ប្រឹងប្រែង ជាច្រើន ដើម្បី ភាពសុខដុមនីយ៍កម្ម របស់ ប្រជាពលរដ្ឋ ហើយ សុំឲ្យ បងប្អូន រក្សា បណ្ណ នេះ ឲ្យបាន ល្អ និង ប្រើប្រាស់ ឲ្យ មាន ប្រសិទ្ធិភាព ។ លោក ថា ការចុះបញ្ជី ដីធ្លី បាន ផ្តល់ នូវ សារប្រយោជន៍ ២យ៉ាង ដល់ រដ្ឋ យើង ផង និង ដល់ ប្រជាពលរដ្ឋ ផង ។
លោក ឃួង ស្រេង បាន បញ្ជាក់ ថា ចំពោះ ប្រជាពលរដ្ឋ គឺ ធានា បាន នូវ ភាព កក់ក្តៅ សុវត្ថិភាព ដីធ្លី និង សិទ្ធិ កាន់កាប់ ដីធ្លី ពេញលេញ ជូន ប្រជាពលរដ្ឋ ហើយ វិញ្ញាបនបត្រ សំគាល់ អចលន វត្ថុ គឺ មាន សារសំខាន់ សំរាប់ ជា ភស្តុតាង នូវ ការកាន់កាប់ ដីធ្លី របស់ ខ្លួន និង ជៀសវាង ការរំលោភបំពាន លើ ដីធ្លី ។
បណ្ណ នេះ ក៏ អាច ផ្តល់ លទ្ធភាព ដល់ បងប្អូន ប្រជាពលរដ្ឋ យើង ដើម្បី យក ទៅ ដាក់ ធនាគារ ក្នុង ការខ្ចី លុយ យកមក ប្រកបរបរ អាជីវកម្ម ផ្សេង ៗ ។ ចំពោះ រដ្ឋ វិញ ការចុះបញ្ជី ដីធ្លី នេះ ផ្តល់ លទ្ធភាព យ៉ាង ធំធេង ក្នុង ការគ្រប់គ្រង ដីធ្លី និង រៀបចំ សណ្តាប់ធ្នាប់ ល្អ ប្រសើរ និង សំរួល ដល់ ការធ្វើ ផែនការប្រើប្រាស់ ដីធ្លី បាន សមស្រប កាត់បន្ថយ ទំនាស់ ដីធ្លី ។
( កំពង់ស្ពឺ ) ៖ គ្រឿងចក្រ ជាច្រើន គ្រឿង បាន ពង្រាយ នៅមុខ ផ្សា កំពង់ស្ពឺ នា រសៀល ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៨ ដែល មាន ប្រធាន មន្ទី សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កំពង់ស្ពឺ រួម ជាមួយ អភិបាល ក្រុង ច្បារមន ។ ការឈូសឆាយ រំដោះ ដី ចំណី ផ្លូវ នេះ គេ បាន ឃើញ ក្រុម មន្ត្រី នៃ មន្ទីរ សាធារណការ ជិះ កង់ ដើម្បី ត្រួតពិនិត្យ ជង្ហុក សំបុក មាន់ ដែល មាន នៅលើ ផ្លូវ ជាតិ លេខ ៤ ដើម្បី ធ្វើ ការជួសជុល ផងដែរ ។
លោក ប្រធាន មន្ទីរ បាន ឲ្យដឹង ទៀត ថា ក្រោយពី មន្ទីរ រំដោះ ដី ចំណី ផ្លូវ នេះ និង ជួសជុល បាន ស្អាត ឡើងវិញ មន្ទីរ និង ប្រគល់ ជូន លោក ហុក ម៉ារ៉ាឌី អភិបាល ក្រុង ច្បារមន ដើម្បីឲ្យ ជួយ ថែរក្សា និង អប់រំ ប្រជាពលរដ្ឋ ឲ្យ ឈប់ ការរំលោភ យក ដី ចំណី ផ្លូវ ធ្វើឲ្យ បាត់បង់ សណ្តាប់ បន្ត ទៅ ទៀត ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ អគ្គ លេខាធិការដ្ឋាន ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ដែល បណ្តាញ សារព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២២ ខែតុលា នេះ បាន ឲ្យដឹង បន្ថែម ថា របៀបវារៈសំខាន់ ៗ ទាំង៧ ដែល នឹង ដាក់ ក្នុង សម័យ ប្រជុំ លើក ទី៣០ នោះ រួម មាន៖
១៖ របាយការណ៍ ស្តីពី សកម្មភាព របស់ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ចន្លោះ សម័យ ប្រជុំ លើក ទី ២៩ និង លើក ទី៣០ ។
២៖ ពិនិត្យ និង សម្រេច លើក សេចក្តីសម្រេច របស់ ក្រុមប្រឹក្សា វិន័យ នៃ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ។
៣៖ ពិនិត្យ និង សម្រេច អំពី ការផ្លាស់ប្តូរ ប្រធាន អនុប្រធាន និង ចៅក្រម ។
៤៖ ពិគ្រោះយោបល់ លើ សំណើ តែងតាំង ផ្លាស់ប្តូរ ព្រះរាជអាជ្ញា និង ព្រះរាជអាជ្ញា រង មួយចំនួន តាម សំណើ របស់ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ។
៥៖ ពិនិត្យ និង សម្រេច អំពី ការបន្ត ការងារ របស់ ចៅក្រម នៃ តុលាការ កំពូល ១ រូប ដែល មាន អាយុ ៦៥ ឆ្នាំ ។
៦៖ ពិនិត្យ និង សម្រេច លើ សំណើ សុំ ចូលទៅ បម្រើ ការងារ វិញ របស់ ចៅក្រម ១ រូប នៃ សាលាដំបូង ខេត្ត កណ្តាល និង សំណើ សុំ អនុញ្ញាត ច្បាប់ ទៅ បន្ត ការសិក្សា រយៈពេល ២ ឆ្នាំ របស់ ចៅក្រម ១ រូប នៃ សាលាដំបូង ខេត្ត កំពត ។
កីឡាករ វាយ សី វ៉ាត វណ្ណ ធុន ទទួលបាន រង្វាន់ ពី ប្រធាន សហព័ន្ធ ក្រោយ មកដល់ មាតុភូមិ
លោកស្រី ឃួន សុដារី នឹង ដឹកនាំ គណៈប្រតិភូ គណបក្ស ប្រជាជន កម្ពុជា ចេញ ទៅ ចូលរួល រួម ក្នុង មហាសន្និបាត អាយ កាប់ លើក ទី១០ នៅ ប្រទេស រុស្ស៊ី រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៤ ដល់ ២៧ ខែតុលា
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ប្រធានបទ នៃ មហាសន្និបាត នោះ ផ្តោត សំខាន់ ចំនួន ២៖
១៖ តួនាទី គណបក្ស នយោបាយ នៅក្នុង ការកាត់បន្ថយ ភាពតានតឹង អន្តរជាតិ និង ការប្រយុទ្ធ ប្រឆាំង នឹង ភាព ជ្រុលនិយម ។ ២៖ សារៈសំខាន់ នៃ កិច្ចហស ប្រតិបត្តិការ រវាង បណ្តា គណបក្ស នយោបាយ នៅ អាស៊ី ក្នុង ការបង្កើត និង អភិវឌ្ឍន៍ ចំណង នយោបាយ សេដ្ឋកិច្ច និង សង្គម រវាង រដ្ឋ និង រដ្ឋ ។
រុស្ស៊ី៖ ប្រទេស ណា ហ៊ាន វាយប្រហារ បេឡារុស គឺ មិន ខុសពី វាយប្រហារ រុស្ស៊ី ឡើយ !
គួរ រំលឹក ថា ក្រោយ ជំនួប ជាមួយ ប្រធានាធិបតី ប៉ូឡូញ លោក អាន ហ្សេច ឌូដា (Andrzej Duda) កាលពី ខែកញ្ញា កន្លងទៅ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន អះអាង ថា ទីក្រុង វាស៊ីន តោន នឹង ពិចារណា លើ ការសាងសង់ មូលដ្ឋាន យោធា អចិន្រ្តៃយ៍ មួយ នៅក្នុង ប្រទេស ប៉ូឡូញ ។ ក៏ប៉ុន្តែ ទីក្រុង ម៉ូស្គូ ចាត់ទុក ថា គំរោង នេះ គឺជា ទង្វើ រំលោភ លើ កិច្ចព្រមព្រៀង រវាង ណា តូ និង រុស្ស៊ី ។
អង្គការ ណា តូ បាន បង្កើន ការពង្រីក វត្តមាន យោធា របស់ ខ្លួន តាំងតែពី ឆ្នាំ ២០១៤មក ម្ល៉េះ នៅ តាម បណ្ដា ប្រទេស អឺរ៉ុប ខាងកើត ដែល មាន ព្រំដែន ជាប់ រុស្ស៊ី ក្រោយ ទីក្រុង ម៉ូស្គូ បាន ក្រសោប យក តំបន់ គ្រី មៀ ពី អ៊ុយក្រែន និង បន្ត ពង្រីក ឥទ្ធិពល នៅឯ តំបន់ ភាគ ខាងកើត នៃ ប្រទេស អ៊ុយក្រែន តាមរយៈ ការគាំទ្រ ចលនា ឧទ្ទាម បំបែក រដ្ឋ ៕
៦ចំនុច នេះ ! ធ្វើឲ្យ ទូរទឹកកក សាម សុង លក់ ដាច់ ខ្លាំង
ដោយ ផ្នែក លើ ៦ចំនុច ពិសេស ៗ ដូច ខាងក្រោម៖
រីឯ ទ្វារ ទី ពីរ គឺ បំពាក់ នៅ ផ្នែក ខាងក្រៅ និង មាន ទំហំ តូច ជាង ទ្វារ ទី មួយ ដើម្បី ផ្តល់ ភាពងាយស្រួល ក្នុង ការដក ឬ ដាក់ ម្ហូប អាហារ ឬ របស់របរ ដែល យើង ត្រូវការប្រើ ញឹកញាប់ ។ ពេល ដែល យើង បើក ទ្វាទី ពីរ ប្រើ ភាពត្រជាក់ មិន សូវ ជះ មក ខាងក្រៅ ទេ ជា ហេតុ ធ្វើ ដែល ថា វា មាន សមត្ថភាព ក្នុង សន្សំ សំចៃ អគ្គ សនី ខ្ពស់ ។
អភិបាល ខេត្ត ពោធិ៍សាត់ តែងតាំង មេធាវី ប្រាំមួយ រូប ជា មេធាវី ប្រចាំ សាលា ខេត្ត
ចំនួន ជនភៀសខ្លួន សម្រុក ទៅ តំបន់ ព្រំដែន អាមេរិក - ម៉ិចស៊ីកូ កើនឡើង ដល់ ខ្ទង់ ៥.០០០ នាក់ !
( ហ្គាតេម៉ាឡា) ៖ ទីភ្នាក់ងារ ជនភៀសខ្លួន ហ្គាតេម៉ាឡា បាន ទទួលស្គាល់ ថា ជនភៀសខ្លួន បន្ថែម ជាង ១.០០០ នាក់ បាន ឆ្លង ព្រំដែន ពី ប្រទេស ហុង ដូរ៉ាស់ កាលពី ថ្ងៃអាទិត្យ ហើយ ដែល នេះ បាន ធ្វើឱ្យ ចំនួន ជនភៀសខ្លួន អាមេរិក កណ្ដាល ធ្វើដំណើរ ទៅកាន់ ព្រំដែន អាមេរិក និង ម៉ិច សីកូ កើន ដល់ ៥.០០០ នាក់ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នៅ រសៀល ថ្ងៃចន្ទ ទី ២២ ខែតុលា ឆ្នាំ ២០១៨ ។
ជាមួយគ្នា នោះ ដែរ បើ តាម អាជ្ញាធ មិចស៊ីកូ បច្ចុប្បន្ន ចំនួន ជនភៀសខ្លួន នៅឯ តំបន់ ព្រំដែន រវាង ម៉ិចស៊ីកូ និង ហ្គាតេ ម៉ាឡា មាន កើនឡើង ដល់ ២.០០០ នាក់ បើ ទោះជា អាជ្ញាធរ មិន ទាន់ អាច កំណត់ ថា ពួកគេ ធ្វើដំណើរ មកពី ប្រទេស ណាមួយ នៅក្នុង តំបន់ ក៏ដោយ ។ ដោយឡែក ជា វិធានការឆ្លើយតប រដ្ឋាភិបាល មិចស៊ីកូ បាន បញ្ជា ឱ្យ ប៉ូលិស បិទ ទ្វារ ព្រំដែន សម្រាប់ ជនភៀសខ្លួន ដែល មិន មាន លិខិត ស្នាម គ្រប់គ្រាន់ ។
លើស ពី នេះ ទៅ ទៀត ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ក៏ បាន បញ្ជាក់ ដែរ ថា ជនភៀសខ្លួន ទាំងអស់ ត្រូវ ស្វែងរក សិទ្ធិ ជ្រកកោន នៅក្នុង ប្រទេស មិចស៊ីកូជាមុន សិន បើ ពុំ ដូច្នោះ ទេ សហរដ្ឋ អាមេរិក នឹង បណ្ដេញ ពួកគេ ឱ្យ ចេញ ឆ្ងាយ ពី តំបន់ ព្រំដែន អាមេរិក ។
គួរ ជម្រាប ថា កាលពី សប្ដាហ៍ មុន លោក ដូណាល់ ត្រាំ បាន ព្រមាន ម្ដង រួច មកហើយ ថា នឹង បញ្ជូន យោធា ទៅកាន់ តំបន់ ព្រំដែន ជាប់ ជាមួយ មិច ស៊ីកូ ដើម្បី ទប់ស្កាត់ លំហូរ ជនភៀសខ្លួន មកកាន់ តំបន់ ព្រំដែន អាមេរិក ៕
មួយ ថ្ងៃ ៗ បន្លែ និង ផ្លែ ឈើ ជាង ១០តោន នាំចូល ពី វៀតណាម ចូល តាម ចក្រ អន្តរជាតិ ភ្នំ ដិន . មន្រ្តី កាំ កុងត្រូល ត្រួតពិនិត្យ ជាប្រចាំ ដើម្បី ធានា ផ្គត់ផ្គង់ លើ ទីផ្សារ ប្រទេស កម្ពុជា គ្មាន សារធាតុ គីមី
( តាកែវ )៖ នៅក្នុង ការធ្វើតេស្ត បឋម ទៅ លើ បន្លែ និង ផ្លែ ឈើ ជាច្រើន មុខ ដែល នាំចូល ពី ប្រទេស វៀតណាម តាម ច្រក ទ្វា អន្តរជាតិ ភ្នំ ដិន ខេត្ត តាកែវ មន្រ្តី ជំនាញ កាំ កុងត្រូល បាន អះអាង ថា រក មិន ឃើញ មាន សារធាតុ គីមី លើ បន្លែ ផ្លែ ឈើ ទាំងអស់ នោះ ទេ ។
លោក ប៉ោ លាង គង់ ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត តាកែវ បាន ថ្លែង ថា មន្រ្តី ជំនាញ កាំ កុងត្រូល ច្រកទ្វារ ព្រំដែន អន្តរជាតិ ភ្នំ ដិន បាន សហការ ជាមួយ ស្ថាប័ន ពាក់ព័ន្ធ ប្រចាំ ការ នៅ ច្រកទ្វារ បាន ធ្វើ ការត្រួតពិនិត្យ ទំនិញ នាំចូល ពី ប្រទេស វៀតណាម រួម មាន៖ ស្លឹក កាឆាយ ខាត់ ណា ស្ពៃក្ដោប ផ្លៃឈើ និង ប្រេង ឆា ដោយ បាន ធ្វើតេស បឋម រក សារធាតុ គីមី ក៏ប៉ុន្តែ ជា លទ្ធផល មន្រ្តី ជំនាញ រក មិន ឃើញ មាន សារធាតុ គីមី លើ បន្លែ ផ្លែ ឈើ ទាំងនោះ ទេ ។
លោក ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត តាកែវ បាន បន្ត ថា ក្នុង មួយ ថ្ងៃ ៗ មាន បន្លែ និង ផ្លែ ឈើ ប្រមាណ ៨ទៅ ១២តោន បាន នាំ ពី ប្រទេស វៀតណាម ចូលមក ប្រទេស កម្ពុជា តាម ច្រក ទ្វា អន្តរជាតិ ភ្នំ ដិន ហើយ កន្លងមក មន្រ្តី ជំនាញ កាំ កុងត្រូល បាន ធ្វើតេសត្ត រកឃើញ សារធាតុ គីមី ថ្នាំ បាញ់ សំលាប់ សត្វ ល្អិត នៅលើ ស្លឹក ខ្ទឹម ស្លឹក កាឆាយ ម្ទេស និង ស្ពៃក្ដោប ហើយ មន្រ្តី ជំនាញ ក៏ បាន ធ្វើ ការហាមឃាត់ មិន ឲ្យ នាំចូល បន្លែ ទាំងអស់ នោះ តទៅទៀត ដែរ ។
ក៏ប៉ុន្តែ បច្ចុប្បន្ន នេះ បន្លែ ខាងលើ ត្រូវបាន អនុញ្ញាតឲ្យ ចូល ជាធម្មតា វិញ បន្ទាប់ពី មន្រ្តី ជំនាញ បាន យក បន្លែ ខាងលើ ផ្ញើ ទៅ អគ្គ នាយកដ្ឋាន កុងត្រូល ដើម្បី ពិនិត្យ រក សារធាតុ គីមី ក៏ប៉ុន្តែ បន្លែ ទាំងអស់ នេះ មិន មាន ផ្ទុក សាធាតុ គីមី នោះ ទេ ។
បើ តាម លោក ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត តាកែវ ប៉ោ លាង គង់ បើ ទោះបីជា មន្រ្តី ជំនាញ ពិនិត្យ រក មិន ឃើញ មាន សាធាតុក គីមី នោះ លើ បន្លែ ផ្លែ ឈើ នាំចូល ពី ប្រទេស វៀតណាម យ៉ាងណា ក៏ដោយ ក៏ មន្រ្តី ជំនាញ កាំ កុងត្រូល នៅ ច្រកទ្វា អន្តរជាតិ ភ្នំ ដិន ដែល នៅ ប្រចាំ ការនឹង អនុវត្ត ជាប់ ជាប្រចាំ ក្នុង ការត្រួតពិនិត្យ បន្លែ ផ្លែ ឈើ ទាំងអស់ ដែល នាំចូល ដើម្បី ធានា ធ្វើ យ៉ាងណា ឲ្យ បន្លែ ផ្លែ ឈើ នាំចូល មក ផ្គត់ផ្គង់ លើ ទីផ្សារ ប្រទេស កម្ពុជា មាន សារធាតុ គីមី ដែល ប៉ះពាល់ ដល់ អ្នកប្រើប្រាស់ ៕
ទីប្រឹក្សា រាជ រដ្ឋាភិបាល៖ គោល នយោបាយ ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ ធ្វើឲ្យ វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា បន្ត ឆ្ពោះទៅ មុខ
( ភ្នំពេញ ) ៖ គោល នយោបាយ ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ បាន ធ្វើឲ្យ វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា បន្ត ឆ្ពោះទៅ មុខ ខណៈ បច្ចុប្បន្ន ក្រុមហ៊ុន វិនិយោគ ចិន ជាច្រើន បាន នឹង កំពុង បោះ ទុន វិនិយោគ យ៉ាង ច្រើន ក្នុង ឧស្សហកម្ម សំណង់ នៅ កម្ពុជា ។
លោក ឈីវ គួរ ស៊ីញ ប្រធាន ប្រតិបត្តិ ក្រុមប្រឹក្សាភិបាល ក្រុមហ៊ុន អចលន ទ្រព្យ ចិន ព្រីនស៍ រៀល អ៊ីស្ទេត គ្រុប បាន លើកឡើង ថា ជា ការពិត ណាស់ វត្តមាន របស់ ក្រុមហ៊ុន ព្រីនស៍ រៀល អ៊ីស្ទេត នៅក្នុង ទីផ្សារ អចលន ទ្រព្យ នៅ កម្ពុជា នា ពេលនេះ គឺ កើត ចេញ ពី គោល នយោបាយ ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ របស់ ចិន ដែល បាន បើក ឱកាស និង លើកទឹកចិត្ត ឲ្យ មាន ការវិនិយោគ ជាច្រើន ពី វិនិយោគិន ចិន មកកាន់ ប្រទេស កម្ពុជា ។
លោក បញ្ជាក់ ថា ការរសម្រេច បោះ ទុន វិនិយោគ លើ គម្រោង អចលន ទ្រព្យ ក្នុង ប្រទេស កម្ពុជា នេះ គឺ ដោយសារ ក្រុមហ៊ុន បាន មើលឃើញ ពី ការរីកចម្រើន យ៉ាង លឿន នៃ កំណើន សេដ្ឋកិច្ច របស់ កម្ពុជា ធៀប នឹង ប្រទេស ក្នុង តំបន់ ដោយ ក្នុង នោះ វិស័យ សំណង់ បាន នឹង កំពុង ដើរតួរ នាទី យ៉ាង សំខាន់ ក្នុង ការជំរុញ ដល់ កំណើន សេដ្ឋកិច្ច ជាតិ ហើយ វិស័យ នេះ ក៏ កំពុង ទាមទារ ឲ្យ មាន ការបំពេញ បន្ថែម ឲ្យបាន ច្រើន ផងដែរ ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ ។
លោក បន្ត ថា រយៈពេល បី ឆ្នាំ នៃ វត្តមាន របស់ ក្រុមហ៊ុន ព្រីនស៍ រៀល អ៊ីស្ទេត គ្រុប នៅក្នុង ប្រទេស កម្ពុជា ក្រុមហ៊ុន បាន បោះ ទុន វិនិយោគ សរុប ជាង ១២០០ លាន ដុល្លារ ទៅ លើ គម្រោង អគារ ខុនដូ ធំ ៗ និង មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម ដោយ ក្នុង នោះ គម្រោង ធំ ៗ ចំនួន បី បាន នឹង កំពុង លេច ជា រូបរាង បណ្ដើរ ៗ ហើយ ក្នុង រាជធានី ភ្នំពេញ និង ៣គម្រោង ធំ ៗ ទៀត ក៏ បាន នឹង កំពុង វិនិយោគ នៅ ខេត្ត ព្រះសីហនុ ផង ដែរ ។
លោក បញ្ជាក់ ថា ជា ចក្ខុវិស័យ របស់ ក្រុមហ៊ុន ក្នុង រយៈពេល ១០ឆ្នាំ បន្ទាប់ ក្រុមហ៊ុន នឹង បង្កើន ទុន វិនិយោគ ឲ្យបាន ៦ពាន់ លាន ដុល្លារ បន្ថែម ទៀត ក្នុង ឧស្សាហកម្ម សំណង់ នៅ កម្ពុជា ខណៈ បច្ចុប្បន្ន ក្រុមហ៊ុន បាន ប្រមូល ទិញ ដី ទុក សម្រាប់ ធ្វើ ការ វិនិយោគ ទាំង នៅ រាជធានី ភ្នំពេញ ខេត្ត ព្រះសីហនុ និង សៀមរាប ជាច្រើន ទីតាំង ផងដែរ ។
បន្ថែម ពីលើក នេះ លោក បញ្ជាក់ ថា ក្រៅពី វិនិយោគ នៅ កម្ពុជា ក្រុមហ៊ុន ព្រីនស៍ រៀល អ៊ីស្ទេត ក៏ បាន បង្កើត ជា មូលនិធិ សប្បុរសធម៌ ដើម្បី ជួយ ដល់ ប្រជាពលរដ្ឋ ជួប ការលំបាក នៅ កម្ពុជា ផងដែរ ដោយ អំណោយ នោះ បាន មកពី ចំណែក លក់ ខុនដូ នៅ កម្ពុជា ។
លោក សុខ ស៊ី ផាណា ជា ទីប្រឹក្សា រដ្ឋាភិបាល និង ជា អ្នកជំនាញ ផ្នែក ច្បាប់ បាន ថ្លែង ថា « គោល នយោបាយ មួយ នេះ ពិតជា បាន ជម្រុញឲ្យ វិនិយោគិន ចិន បាន បោះ ទុន ដោយ ផ្ទាល់ មកកាន់ ប្រទេស កម្ពុជា ។ តួយ៉ាង មាន ការអភិវឌ្ឍន៍ យ៉ាង សម្បើម ទៅ លើ គម្រោង ហេដ្ឋារចនាសម្ព័ន្ធ និង ថាមពល » ។
គួរ បញ្ជាក់ ថា ជា លទ្ធផល គោល នយោបាយ ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ នេះ បាន នាំឲ្យ មាន គម្រោង ផ្លូវ ល្បឿន លឿន ចំងាយ ប្រមាណ ១៩០ គីឡូម៉ែត្រ ដែល តភ្ជាប់ ពី ខេត្ត ព្រះសីហនុ មកកាន់ ក្រុង ភ្នំពេញ ខណៈ ការវិនិយោគ នៅ ក្នុង វិស័យ អចលន ទ្រព្យ នៅ ក្នុង ខេត្ត ព្រះសីហនុ កាន់តែ មាន កំណើន ច្រើន ឡើង ៗ ៕
