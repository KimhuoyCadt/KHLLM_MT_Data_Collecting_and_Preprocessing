( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ ក្រុមប្រឹក្សា ខេត្ត ចំនួន ៣ គឺ ខេត្ត ព្រៃវែង ខេត្ត មណ្ឌលគិរី និង ខេត្ត កោះកុង បាន បើក វគ្គ បណ្តុះបណ្តាល ចំនួន ២ ថ្ងៃ សម្រាប់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត របស់ ខ្លួន អំពី មេរៀន ចំនួន ពីរ គឺ៖ ១ - គោលការណ៍ ជា សាកល នៃ អភិបាលកិច្ច ល្អ និង ២ - ការតម្រង់ ទិស ដល់ ក្រុមប្រឹក្សា ទើប កាន់ តំណែង ថ្មី ។
ការបណ្តុះបណ្តាល លើ មេរៀន ទាំង ពីរ ធ្វើឡើង ក្នុង គោលបំណង លើកកម្ពស់ ការយល់ដឹង របស់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត និង មន្រ្តី ពាក់ព័ន្ធ អំពី ទ្រឹស្តី និង ឆ្លុះបញ្ចាំង ពី ការអនុវត្ត ការងារ ជាក់ស្តែង ។
វគ្គ បណ្តុះបណ្តាល នៅ ខេត្ត ព្រៃវែង រៀបចំឡើង ក្រោម អធិបតីភាព លោក ស្បោង សារ៉ាត់ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ហើយ សម្របសម្រួល ដោយ គ្រូ ឧទ្ទេស ពី សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី ខេត្ត គឺ លោក ច យ សុបិន សមាជិក ក្រុមប្រឹក្សា កណ្តាល ។
វគ្គ បណ្តុះបណ្តាល នៅ ខេត្ត មណ្ឌលគិរី រៀបចំឡើង ក្រោម អធិបតីភាព លោក ម៉ែន ងុយ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ហើយ សម្របសម្រួល ដោយ គ្រូ ឧទ្ទេស ពី សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី ខេត្ត គឺ លោក ឯ ម ដេត សមាជិក ក្រុមប្រឹក្សា ត្បូងឃ្មុំ និង លោកស្រី ប្រាក់ ពុទ្ធី សមាជិក ក្រុមប្រឹក្សា ខេត្ត ស្វាយរៀង ។
វគ្គ បណ្តុះបណ្តាល នៅ ខេត្ត កោះកុង រៀបចំឡើង ក្រោម អធិបតីភាព លោក កាយ សំរួម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក យឹម សុខុម អនុប្រធាន អចិន្រ្តៃយ៍ សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី - ខេត្ត ។ គ្រូ ឧទ្ទេស គឺ លោក សុខ យ៉ាត សមាជិក ក្រុមប្រឹក្សា ខេត្ត កំពង់ស្ពឺ និង លោក ហេង ស៊ឺ សមាជិក ក្រុមប្រឹក្សា ខេត្ត ព្រះសីហនុ ៕
រដ្ឋមន្ដ្រី កសិកម្ម៖ កសិករ កម្ពុជា កំពុង ប្រែក្លាយ ខ្លួន ចេញ ពី « កសិករ » ទៅជា « កសិ- ពាណិជ្ជករ » ដើម្បី ទទួលបាន តម្លៃ បន្ថែម ក្នុង ជីវភាព រស់ នៅ
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក វេង សាខុន អញ្ជើញ អធិបតីភាព ក្នុង ពិធី ផ្សព្វផ្សាយ និង ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ « សេវា ព័ត៌មាន ទីផ្សារ កសិកម្ម » និង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង កសិកម្ម ដៃគូ អភិវឌ្ឍន៍ និង វិស័យ ឯកជន ជាច្រើន រូប ដែល រៀបចំ ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង កសិកម្ម នា ព្រឹក ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ ។
ពិធី ខាងលើ នេះ រៀបចំ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ចែក ពី រំលែក បទពិសោធន៍ បញ្ហា ប្រឈម ដែល វិស័យ សាធារណឯកជន និង សហគមន៍ កសិករ ជួបប្រទះ ដើម្បី កំណត់ នូវ អាទិភាព នៃ បញ្ហា ប្រឈម នានា និង រិះរក វិធានការ អន្តរាគមន៍ ដោះស្រាយ ប្រកបដោយ ប្រសិទ្ធភាព និង ទាន់ ពេលវេលា សម្រាប់ ជា ប្រយោជន៍ ដល់ ប្រជាកសិករ ដែល មាន ជីវភាព រស់ នៅ ដោយ ពឹង អាស្រ័យ លើ មុខរបរ កសិកម្ម ជា ចម្បង ។
លោក វេង សា ខុន បាន បន្ថែម ទៀត ថា ក្នុង បរិបទ នេះ យើង ក៏ សង្កេតឃើញ ថា មាន ស្ថាប័ន ជាច្រើន ទាំង រដ្ឋ វិស័យ ឯកជន និង អង្គការ ក្រៅ រដ្ឋាភិបាល បាន និង កំពុង ផ្តល់ សេវាកម្ម ដើម្បី បង្កើន ចំណេះដឹង និង ចំណេះ ធ្វើ ដល់ កសិករ នៅ មូលដ្ឋាន យ៉ាង សស្រាក់សស្រាំ ។
រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម បាន បន្ដ ថា មាន កសិករ ជាច្រើន បាន ក្រេប ជញ្ជក់ យក បទពិសោធន៍ និង ទេពកោសល្យ ទាំងអស់ នោះ យក ទៅ អនុវត្ត ប្រកបដោយ ភាពឧស្សាហ៍ ព្យាយាម និង ច្នៃប្រឌិត ដោយ ទទួលបាន លទ្ធផល ជា ផ្លែ ផ្កា យ៉ាង ត្រចះត្រចង់ នៅក្នុង តំបន់ ជាច្រើន ទៅ តាម អនុវិស័យ នីមួយ ៗ ៕
( ភ្នំពេញ ) ៖ ជំងឺ លើស សម្ពាធ ឈាម ត្រូវបាន គេ ទទួលស្គាល់ ថា គឹជា ជំងឺ មួយ ប្រភេទ ឧហ្សាហ៍ កើតឡើង ទៅ លើ មនុស្ស មាន វ័យ ចំណាស់ ដែល មាន អាយុ ចន្លោះ ពី ៥៥ ឆ្នាំ ទៅ ៦០ ឆ្នាំ ដោយ មិន ប្រកាន់ ភេទ នោះ ទេ និង ម្យ៉ាង វិញ ទៀត ជំងឺ ប្រភេទ នេះ គឺ ពិតជា កាច សាហាវ បំផុត អាច ធ្វើឲ្យ អ្នកជំងឺ ពិការភាព និង អាច ឈាន ទៅដល់ ការបាត់បង់ អាយុជីវិត បាន ក្នុង ពេល មួយ ប៉ព្រិច ភ្នែក បើ យើង មិន អនុវត្តន៍ ទៅ តាម ការណែនាំ ឬ វេជ្ជបញ្ជា របស់ គ្រូពេទ្យ ឲ្យបាន ត្រឹមត្រូវ នោះ ។
ការអះអាង បែប របស់ លោកស្រី វេជ្ជបណ្ឌិត ឡេ ធិធូធ្វី ធ្វើឡើង នៅក្នុង កម្មវិធី ពិនិត្យ និង ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ជូន អ្នកជំងឺ លើស សម្ពាធ ឈាម ចំនួន ៥០ នាក់ នៅ មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ ដែល មាន ការសហការ ជាមួយ ក្រុមហ៊ុន ឱស ថ DHG Pharma ជាង នេះ ទៅ ទៀត នោះ គឺ កិច្ចសហការ រវាង ស្ថាប័ន ទាំង២ នេះ នឹង ធ្វើឡើង សម្រាប់ អ្នកជំងឺ ដល់ ទៅ១ ពាន់ នាក់ ។
បន្ទាប់ពី កម្មវិធី ពិនិត្យ និង ព្យាបាល ជំងឺ ឥត គិត ថ្លៃ ប្រចាំ ខែ វគ្គ មុន សម្រាប់ វគ្គ នេះ មន្ទីរពេទ្យ ជោរៃ ភ្នំពេញ សហការ ជាមួយ ក្រុមហ៊ុន ឱស ថ DHG Pharma រៀបចំ កម្មវិធី ពិនិត្យ និង ព្យាបាល ជំងឺ ពុក ឆ្អឹង ឥត គិត ថ្លៃ សម្រាប់ អ្នកជំងឺ ថ្មី ៥០ នាក់ ដំបូង ក្នុង រយៈពេល ១ ថ្ងៃ ហើយ សម្រាប់ កិច្ចសហការ នេះ នឹង ធ្វើឡើង សម្រាប់ អ្នកជំងឺ រហូតដល់ទៅ ១ ពាន់ នាក់ ដោយ វេជ្ជបណ្ឌិត ឯកទេស វៀតណាម មាន បទពិសោធន៍ ខ្ពស់ មកពី មន្ទីរពេទ្យ ជោរៃ ទីក្រុង ហូជីមិញ ប្រទេស វៀតណាម ។
វេជ្ជបណ្ឌិត ឡេ ធិធូធ្វី បាន ពន្យល់ ថា មនុស្ស ធម្មតា មិន មាន កើត ជំងឺ លើស សម្ពាធ ឈាម គឺ មាន សម្ពាធ ឈាម នៅក្រោម ១២០ / ៨០ ចាប់ពី ១២០ / ៨០ ទៅ ១៣០ / ៨០ ងាយ នឹង លើស សម្ពាធ ឈាម ប្រសិនបើ លើស ពី ១៣០ / ៨០ ឈានចូល ដល់ ជំងឺ លើស ឈាម ដំណាក់កាល ទី១តម្រូវឲ្យ អ្នកជំងឺ ត្រូវ ធ្វើ ពិនិត្យ របប អាហារ ឲ្យ ត្រឹមត្រូវ និង ហាត់ប្រាណ ឲ្យបាន ទៀត ទាត់ បើសិនជា ឡើង ដល់ ១៤០ / ៨០ ឡើង ទៅ តម្រូវឲ្យ ធ្វើ ការព្យាបាល ដោយ ការ ពិសារ ថ្នាំ ពេទ្យ ដើម្បី ទម្លាក់ សម្ពាធ ឈាម ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ឱ្យដឹង ថា នៅ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ ជា ថ្ងៃ ចុងក្រោយ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ បោះឆ្នោត និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨ ដូច្នេះ សូម ប្រជាពលរដ្ឋ ខ្មែរ ដែល មិន ទាន់ មាន ឈ្មោះ និង ពលរដ្ឋ ដែល គ្រប់ អាយុ បោះឆ្នោត សូមអញ្ជើញ ទៅ ចុះឈ្មោះ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ ខ្លួន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ គ.ជ. ប បាន ឱ្យដឹង ថា ចំពោះ លទ្ធផល បណ្តោះអាសន្ន កាលពី ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ ត្រូវនឹង ថ្ងៃទី ១៧ នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨ វិញ នៅ ក្របខ័ណ្ឌ ទូទាំង ប្រទេស ប្រជាពលរដ្ឋ ដែល បាន អញ្ជើញ មក ចុះឈ្មោះ បោះឆ្នោត ថ្មី មាន ចំនួន ៧. ៧៣១ នាក់ ។
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្តីប្រកាស ព័ត៌មាន របស់ គ.ជ. ប ដូច ខាងក្រោម៖
សណ្ឋាគារ កាំបូឌីយ៉ាណា ជា កន្លែង ល្អ បំផុត នៅក្នុង ទីក្រុង សម្រាប់ រៀបចំ ព្រឹត្តិការណ៍ ពិសេស នេះ ។ ទីធ្លា ខាងក្រៅ ដែល បាន កែលម្អ ជាថ្មី មាន ឆាក ទំហំ 22 ម៉ែត្រ និង ជា ទីកន្លែង សម្រាប់ រៀបចំ កម្មវិធី ផ្សេង ៗ យ៉ាង មាន សុវត្ថិភាព ហើយ អាច ទទួល ភ្ញៀវ បាន រាប់ ពាន់ នាក់ ។
សណ្ឋាគារ នេះ ក៏ មាន កន្លែង ដើរកម្សាន្ត ដ៏ ធំ មួយ ដែល មាន ទី វាល ដ៏ ធំ ដែល អាច រៀបចំ ព្រឹត្តិការណ៍ ធំ ៗ ដូចជា កម្មវិធី ប្រគំ តន្ត្រី កម្មវិធី តាំង ពិព័រណ៍ ពិធី អាពាហ៍ពិពាហ៍ និង កម្មវិធី ពិសេស ផ្សេង ទៀត ដែល លោក អ្នក ចង់ រៀបចំ ។
( ភ្នំពេញ ) ៖ នាយ នគរបាល ថ្នាក់ ឧត្តមសេនីយ៍ ក្របខ័ណ្ឌ មន្ដ្រី នគរបាល ជាតិ កម្ពុជា នៃ ក្រសួង មហាផ្ទៃ ចំនួន ២២ នាក់ ត្រូវបាន ដាក់ ឲ្យ ចូលនិវត្តន៍ ក្នុង នោះ មាន ស្នងការ ខេត្ត ចំនួន ៣នាក់ គឺ ស្នងការ ខេត្ត ព្រៃវែង . ខេត្ត ប៉ៃលិន និង ខេត្ត កំពង់ឆ្នាំង ។
ក្នុង ចំណោម នាយ នគរបាល ទាំង ២២ នាក់ ដែល មាន ស្នងការ ខេត្ត ចំនួន ៣នោះ រួម មាន៖ លោក ឧត្តមសេនីយ៍ ទោ ស្រេង ជា ស្នងការ នគរបាល ខេត្ត ព្រៃវែង . លោក ឧត្តមសេនីយ៍ ទោ ឡុច វណ្ណារ៉ា ស្នងការ នគរបាល ខេត្ត កំពង់ឆ្នាំង និង លោក ឧត្តមសេនីយ៍ ទោ ជា ចាន់ ឌិន ស្នងការ នគរបាល ខេត្ត ប៉ៃលិន ។
យ៉ាងណាមិញ សម្រាប់ លោក ឧត្តមសេនីយ៍ ទោ ជា ចាន់ ឌិន បើ យើង មើល តាម ប្រវត្តិ រូប សង្ខេប នោះ លោក កើត នៅ ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ១៩៦០ ពោល លោក មាន អាយុ ៥៨ ឆ្នាំ ប៉ុន្ដែ ត្រូវបាន ដាក់ ឲ្យ ចូលនិវត្តន៍ ទៅ ហើយ ខណៈ ដែល អាយុ ត្រូវ ដាក់ ឲ្យ ចូលនិវត្តន៍ គឺ ៦០ ឆ្នាំ សម្រាប់ ឋានន្ដរស័ក្ដិ ថ្នាក់ វរសេនីយ៍ ឯក ឡើង ទៅ ។
( ភ្នំពេញ ) ៖ នា ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០១៨ ខាងមុខ នេះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នឹង បើក កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្ដីពី ការបញ្ចប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត នៅ តាម ឃុំ - សង្កាត់ និង ការរៀបចំ បញ្ជី បោះឆ្នោត ដំបូង ការត្រៀម បិទ ផ្សាយ បញ្ជី បោះឆ្នោត ដំបូង និង បញ្ជី ឈ្មោះ ដែល នឹង ត្រូវ លុប ចេញ ពី បញ្ជី បោះឆ្នោត ព្រមទាំង ការអញ្ជើញ ប្រជាពលរដ្ឋ ទៅ ពិនិត្យមើល បញ្ជី ឈ្មោះ ។
កិច្ចប្រជុំ ខាងលើ នេះ នឹង រៀបចំឡើង នៅ សាល សន្និសីទ សារព័ត៌មាន ជាន់ ទី១ នៃ ទីស្ដីការ គ.ជ. ប អគារ ថ្មី ស្ថិត នៅ តាម វិថី រដ្ឋសភា សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការ មន ៕
សូម ជម្រាប ថា ដំណើរការចុះឈ្មោះ បោះឆ្នោត ថ្មី សម្រាប់ ឆ្នាំ ២០១៨ ក៏ ដូចជា ការពិនិត្យ ផ្ទៀងផ្ទាត់ ទិន្នន័យ របស់ អ្នកបោះឆ្នោត នៅក្នុង បញ្ជី បោះឆ្នោត ជាដើម នោះ នឹង ត្រូវ បិទ បញ្ចប់ នៅ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ ហើយ ។
គ.ជ. ប បាន ឱ្យដឹង ថា ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨ គិត ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១៦ ខែតុលា មាន ប្រជាពលរដ្ឋ មក ចុះឈ្មោះ ថ្មី ចំនួន ១៨០. ៩៤៤ នាក់ ហើយ ប្រជាពលរដ្ឋ ដែល បាន លុបចេញ ពី បញ្ជី មាន ចំនួន ៤១. ៤៥៩ នាក់ ចំណែកឯ ប្រជាពលរដ្ឋ ដែល បាន កែតម្រូវ ទិន្នន័យ មាន ចំនួន ១. ៣៨១ នាក់ ៕
ទេសរដ្ឋមន្ដ្រី គន់ គីម៖ សម្ដេច តេជោ ហ៊ុន សែន នៅតែ បន្ដ យកចិត្តទុកដាក់ ផ្ដល់ អត្ថប្រយោជន៍ និង លើកកម្ពស់ សុខុមាលភាព របស់ អតីត យុទ្ធជន
( ភ្នំពេញ ) ៖ ចំពោះមុខ អតីត យុទ្ធជន ដែល ត្រូវ ទទួលបាន ប័ណ្ណ សមាជិក បេឡា ជាតិ សន្ដិសុខ សង្គម ចំនួន ៧៧៥ នាក់ នៅ សាលា ខេត្ត ត្បូងឃ្មុំ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ថ្លែង ដោយ មោទនភាព ថា រាជ រដ្ឋាភិបាល កម្ពុជា អាណត្តិ ទី៦ ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នៅតែ បន្ត យកចិត្តទុកដាក់ ផ្តល់ នូវ អត្ថប្រយោជន៍ និង លើក កំពស់ សុខុមាលភាព ជូន ជន រួម ជាតិ ដែល ក្នុង នោះ រាប់ ទាំង អតីត យុទ្ធជន ផងដែរ ។
ការផ្តល់ ប័ណ្ណ សមាជិក បេឡា ជាតិ សន្ដិសុខ សង្គម សម្រាប់ ថែទាំ សុខភាព ឥត បង់ ថ្លៃ នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ គឺជា ការឆ្លើយតប យ៉ាង សក្តិសម និង ទាន់ ពេលវេលា នូវ អ្វី ដែល សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ជា ឱឡារិក ក្នុង ឱកាស ឃោសនា រក សំឡេង ឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ កាលពី ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ ជា ផ្នែក មួយ នៃ ការអនុវត្តន៍ គោល នយោបាយ គាំពារ សង្គម របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល កំណត់ ច្បាស់ ក្នុង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤នេះ ។
ទេសរដ្ឋមន្ដ្រី គន់ គីម អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន បាន ក្រើន រំលឹក ដល់ ថ្នាក់ដឹកនាំ សមាគម គ្រប់ ថ្នាក់ ទាំងអស់ ត្រូវ បន្ត ចុះ ជួប ស្វែងយល់ ពី ស្ថានភាព ជីវភាព សុខភាព សមាជិក សមាគម យើង តាម គ្រួសារ ហើយ ត្រូវ សហការផ្តល់ អាទិភាព ជួយ ដល់ បងប្អូន ឲ្យ ទទួលបាន នូវ សេវា សាធារណៈ នានា ដូចជា ការទទួលបាន នូវ ជំនួយ សង្រ្គោះ បន្ទាន់ ការផ្តល់ ដី សម្បទាន សង្គមកិច្ច ការផ្តល់ ជម្រក ស្នាក់ នៅ សមរម្យ ការបណ្តុះបណ្តាល មុខជំនាញ វិជ្ជាជីវៈ និង ការចូលរួម សកម្មភាព សង្គម ផ្សេង ៗ ជាដើម ។
ជាមួយគ្នា នេះ លោក លី ឡេង អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន សន្យា ថា នឹង បន្ត ជួយ ឧបត្ថម្ភ គាំទ្រ លើកទឹកចិត្ត និង ខិតខំ ចលនា កៀង គរ សប្បុរសជន ដើម្បី ដោះស្រាយ កង្វល់ និង លើក កំពស់ ជីវភាព ជូន បងប្អូន សមាជិក អតីត យុទ្ធជន ។
ក្នុង ឱកាស នោះ តាម សំណើ របស់ សមាគម អតីត យុទ្ធជន ខេត្ត ត្បូងឃ្មុំ ទេសរដ្ឋមន្ត្រី គន់ គីម បាន គោរព ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន និង ត្រូវបាន សម្តេច អនុញ្ញាតឲ្យ សាងសង់ ផ្ទះ ជូន អតីត យុទ្ធជន ទ័ល លំបាក ចំនួន ២៥ គ្រួសារ លើ ដី កម្មសិទ្ធិ ដែល មាន ស្រាប់ ៕
គួរ ជម្រាប ថា នេះ គឺជា លើក ទី៣ហើយ នៃ ការផ្ទុះ ការរាតត្បាត វីរ៉ុស Zika នៅក្នុង ប្រទេស ឥណ្ឌា ចាប់តាំងពី ឆ្នាំ ២០១៧៕ សូម កុំ បើកបរ ល្មើស ល្បឿន កំណត់ ដាច់ខាត ! ស្លាប់ ៨នាក់ និង របួស ២៦ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៧ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៨នាក់ និង របួស ធ្ងន់ ស្រាល ២៦ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១២លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១៤ គ្រឿង . រថយន្ត តូច ៧គ្រឿង . រថយន្ដ ធុន ធំ២ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្មើស ល្បឿន . ប្រជែង និង មិន គោរព សិទ្ធិ ។
រដ្ឋមន្ត្រី ទេសចរណ៍ កម្ពុជា - ថៃ ឯកភាព គ្នា ដាក់ ចេញ ផែនការ ជាច្រើន ចំណុច ដើម្បី បន្ត កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ទេសចរណ៍ (Video inside) ( កំពត ) ៖ ក្រោយ បញ្ចប់ កិច្ចប្រជុំ ទ្វេ ភាគី កម្ពុជា - ថៃ លើក ទី២ ស្ដីពី កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ទេសចរណ៍ រួច មក រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ កម្ពុជា លោក ថោង ខុន រួម ជាមួយ រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ថៃ លោក វីរ៉ាស័ក្តិ កូវ ស៊ូរ៉ាត់ បាន ឯកភាព គ្នា ដាក់ ចេញ ផែនការ ធំ ៗ មួយចំនួន ដើម្បី បន្ត កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ទេសចរណ៍ ជាមួយគ្នា ។
កិច្ចប្រជុំ ដ៏ សំខាន់ នេះ ត្រូវបាន រៀបចំឡើង នា ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នៅ សណ្ឋាគារ ឡឺ បូក គោ ផា លេស ( ឧទ្យាន ជាតិ ព្រះមុនីវង្ស បូក គោ ) ខេត្ត កំពត ។
ភាគី កម្ពុជា - ថៃ បាន ឯកភាព គ្នា ដូច ខាងក្រោម៖
២៖ ការសិក្សា ទីផ្សារ និង ការផ្សព្វផ្សាយ ទេសចរ ណ៍៖ ភាគី ទាំង ពីរ បាន ឯកភាព គ្នា បន្ត ជំរុញ សកម្មភាព ផ្សព្វផ្សាយ រួមគ្នា « ព្រះរាជាណាចក្រ ពីរ គេាល ដៅ ទេសចរណ៍ មួយ » ចូលរួមគ្នា ផលិត ឯកសារ ផ្សព្វផ្សាយ video និង ការចូលរួម ការតាំងពិពរណ៍ ទេសចរណ៍ ។
៣៖ ពាក់ព័ន្ធ នឹង វិស័យ ទេសចណ៍ នៅ ច្រក របៀង ទេសចរណ៍ ភាគ ខាងត្បូង ភាគី ទាំង ពីរ បាន ឯកភាព គ្នា ជំរុញ ខ្សែ ទស្សនកិច្ច ដែល ក្រុម ជំនាញ បាន រៀបចំ ដោយ ត្រូវ រៀបចំ អោយ មាន កិច្ចប្រជុំ ត្រី ភាគី តំបន់ ត្រីកោណ សមុទ្រ កម្ពុជា ថៃ វៀតណាម និង ត្រូវ ជំរុញ ទេសចរណ៍ សមុទ្រ ទេសចរណ៍ តាម នាវា ។ ភាគី ទាំង ពីរក៍ បាន ស្រប យេាបល់ គ្នា ក្នុង ការជំរុញ ការតភ្ជាប់ ការហោះហើរ ត្រង់ ទៅ វិញ ទៅ មក រវាង ប្រទេស ថៃ ពិសេស ភាគ ខាងត្បូង ថៃ និង ខេត្ត ព្រះសីហនុ ផងដែរ ។
៤៖ ភាគី កម្ពុជា ស្នើសុំ ភាគី ថៃ ពិចារណា ជួយ ផ្ដល់ ការបណ្ដុះបណ្ដាល ផ្នែក ជំនាញ ទេសចរណ៍ ការគ្រប់គ្រង គោលដៅ ទេសចរណ៍ រម និយដ្ឋាន ទេសចរណ៍ និង បដិសណ្ឋារកិច្ច ពិសេស ដល់ មន្ទីរ ទេសចរណ៍ នៃ ខេត្ត ជាប់ ព្រំដែន ។ ភាគី ថៃ បាន ឆ្លើយតប ការ ជួយ ជំរុញ ការងារ នេះ ខណៈ ថៃ កំពុង ជួយ បណ្ដុះបណ្ដាល ( តាមរយៈ ការចុះអនុស្សរណៈ ជាមួយ ក្រសួង ទេសចរណ៍ និង សាកលវិទ្យាល័យ រាចា ម៉ាន់ ហ្កាឡា ថាន់ យ៉ាបុរី ) ។
៥៖ ភាគី ទាំង ពីរ បាន គាំទ្រ គ្នា ក្នុង ការជំរុញ ការវិនិយេា គ លេី វិសយ័ទេសចរណ៍ ។ កម្ពុជា បាន អញ្ជើញ វិនិយោគិន ថៃ ក៏ ដូចជា អ្នក ពាក់ព័ន្ធ ខាង ភាគី ថៃ មកវិនិយេាគ នៅ កម្ពុជា និង ចូលរួម ផ្សព្វផ្សាយ គោលដៅ ទេសចរណ៍ ក្នុង ព្រឹត្តិការ បុណ្យ ទន្លេ និង បុណ្យ សមុទ្រ ដែល រៀបចំឡើង ជារៀងរាល់ ឆ្នាំ ។
ក្រុមការងារ ចម្រុះ នេះ មាន នាយ ឧត្ថម សេនីយ៍ ហ៉ីង ប៊ុន ហៀង ជា ប្រធាន និង មាន អនុប្រធាន ៣នាក់ ព្រមទាំង សមាជិក ១៨ នាក់ ៕
សូម អាន សេចក្តីសម្រេច ទាំង ស្រុង៖ មុខ សញ្ញា ចាស់ រត់គេចខ្លួន ម្នាក់ និង បក្ខពួក ម្នាក់ ទៀត ត្រូវ ជាប់ ខ្នោះ នគរបាល ខណ្ឌ ឫស្សីកែវ ក្រោយពី ជិះ កង់ ទៅ ប្ដូរ យក ម៉ូតូ មន្ត្រី យោធា មិន សម្រេច
បើ តាម លោក អធិការ នគរបាល ខណ្ឌ ឫស្សីកែវ បាន ឲ្យដឹង ផងដែរ ថា ក្រោយពី បង្ក្រាប បាន ជនសង្ស័យ ជា មុខសញ្ញា ចាស់ ម្នាក់ និង ម្នាក់ ទៀត ជា បក្ខពួក កំពុង រត់គេចខ្លួន រួម ជាមួយ វត្ថុតាង ដែល ដកហូត ក្នុង សកម្មភាព លួច កាច់ ក សោរ ម៉ូតូ ត្រូវបាន បញ្ជូន មក ឃុំ ខ្លួន សាកសួ ប ណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដើម្បី បន្ត ការស៉ើប អង្កេត ក្នុង ការកសាង សំណុំរឿង ចាត់ការ តាម និតិវិធី ៕
ក្រសួង ទេសចរណ៍ នាំ ក្រុមហ៊ុន ទេសចរណ៍ ជាច្រើន របស់ កម្ពុជា ទៅ ចូលរួម ក្នុង ព្រឹត្តិការណ៍ ពិព័រណ៍ ទេសចរណ៍ អន្តរជាតិ នៅ សឹង្ហបុរី
( សឹង្ហបុរី ) ៖ លោក សូ ម៉ារ៉ា រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ តំណាង លោក បណ្ឌិត ថោង ខុន រដ្ឋមន្រ្តី ក្រសួង ទេសចរណ៍ នា ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ ប្រតិភូ ក្រសួង ទេសចរណ៍ និង សេវាករ ជាច្រើន ក្រុមហ៊ុន ចូលរួម ក្នុង ព្រឹត្តិការណ៍ ពិព័រណ៍ ទេសចរណ៍ អន្តរជាតិ ITB ASIA 2018 នៅ ប្រទេស សឹង្ហបុរី ដែល ព្រឹត្តិការណ៍ អន្តរជាតិ នេះ បាន រៀបចំ ចាប់ពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០១៨ ។
លោក សូ ម៉ារ៉ា ជា ប្រធាន ប្រតិភូ ក៏ បាន ជួប សំណេះសំណាល ជាមួយ ភ្ញៀវ ទេសចរ អន្តរជាតិ ព្រមទាំង ប្រតិបត្តិករ ទេសចរណ៍ នានា ដើម្បី បង្ហាញ ពី ការអភិវឌ្ឍ សុខ សន្តិភាព និង រមណីយដ្ឋាន ប្រវត្តិសាស្ត្រ ក៏ ដូចជា ឆ្នេរសមុទ្រ ដ៏ ស្រស់ស្អាត របស់ កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង ឆ្លាតវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
គួរ បញ្ជាក់ ថា ខ្មាន់ កាំភ្លើង ត្រូវបាន គេ រាយការណ៍ ថា មាន គ្នា ច្រើន នាក់ តែ មាន បុរស ម្នាក់ គឺជា ជនសង្ស័យ សំខាន់ ជាង គេ និង ជា សិស្សសាលា រៀន ខាងលើ ។ តែ ក្រោយមក រូប គេ បាន សម្លាប់ ខ្លួន ឯង រីឯ មនុស្ស ជាច្រើន នាក់ ទៀត ក៏ ត្រូវបាន គេ ជឿជាក់ ថា បាន រងរបួស ផងដែរ ៕
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨
១៖ សម្តេច តេជោ ហ៊ុន សែន និង គណៈប្រតិភូ បាន អញ្ជើញ ដល់ ទីក្រុង ប្រ៊ុច ហ្សែល ហើយ ជាមួយ ការទទួលស្វាគមន៍ យ៉ាង ច្រើន កុះករ ពី ប្រជាពលរដ្ឋ ខ្មែរ ( ចុច អាន )
២៖ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល សាទ រ និង ឯកភាព ទាំងស្រុង ចំពោះ ស្មារតី នៃ លិខិត របស់ សភា ពាណិជ្ជកម្ម អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា ផ្ញើ ទៅកាន់ ស្នងការទទួលបន្ទុក ពាណិជ្ជកម្ម គណៈកម្មការ អឺរ៉ុប ( ចុច អាន )
៥៖ កម្ពុជា ត្រូវបាន UN ឱ្យ ចំណាត់ថ្នាក់ លេខ ២៩ នារី លេខ ១៧ ក្នុង ចំណោម ១២២ ប្រទេស ដែល បញ្ជូន កងកម្លាំង ចូលរួម បេសកកម្ម រក្សា សន្តិភាព ពិភពលោក ឆ្នាំ ២០១៨ ( ចុច អាន )
៦៖ ពលរដ្ឋ និង និស្សិត ខ្មែរ នៅ អង់គ្លេស ត្រៀមខ្លួន ជាស្រេច ទៅ ជួប សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ចង់ ស្តាប់ អនុសាសន៍ ផ្ទាល់ អំពី បទពិសោធន៍ ដឹកនាំ កម្ពុជា ( ចុច អាន )
៧៖ សម្តេច តេជោ ហ៊ុន សែន ចេញ សេចក្តីសម្រេច តែងតាំង លោក ព្រុំ សុខា ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង មុខងារ សាធារណៈ ( ចុច អាន )
៨៖ ស្ថានទូត កូរ៉េ នៅ កម្ពុជា អញ្ជើញ ថ្នាក់ដឹកនាំ ស្ថាប័ន ព័ត៌មាន ធំ ៗ ចូលរួម ភ្លក្ស ម្ហូប យ៉ាង ពិសេស ចំនួន ៦មុខ ដែល ចំអិន ដោយ ចុងភៅ មកពី ប្រទេស កូរ៉េ ( ចុច អាន )
៣៖ ទីបំផុត អារ៉ាប៊ី សាអូឌីត ផ្តល់ ជំនួយ ឲ្យ អាមេរិក ១០០ លាន ដុល្លារ ចំពេល ទីក្រុង វ៉ាស៊ីនតោន កំពុង ស៊ើប រឿង បាត់ខ្លួនអ្នកកាសែត ! ( ចុច អាន )
៨៖ បច្ចេកវិទ្យា បន្ត ពូជ ដែល មាន ជំនួយ អនុវត្ត រយៈពេល ៣០ ឆ្នាំ ក្នុង ប្រទេស ចិន ទទួលបាន លទ្ធផល ល្អ ( ចុច អាន )
៩៖ ឧស្សាហកម្ម កម្សាន្ត របស់ ប្រទេស ចិន មាន ការលូតលាស់ ខ្លាំង ( ចុច អាន )
ថ្ងៃ នេះ អ្នក ព័ត៌មាន កម្ពុជា បាន ទទួលទាន អាហារ របស់ ស្តេច កូរ៉េ ហើយ ទាក់ចិត្ត គ្រប់ ៗ គ្នា
( ភ្នំពេញ ) ៖ អាហារ ល្បី ៗ ៦មុខ ដែល ធ្លាប់ តែ ស្តេច កូរ៉េ ទេ ទើប បាន សោយ នោះ នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ ត្រូវបាន រៀបចំ ចំអិន ដោយ ចុងភៅ ដ៏ ល្បី របស់ កូរ៉េ ខាងត្បូង ចែកជូន ថ្នាក់ដឹកនាំ ស្ថាប័ន ព័ត៌មាន នៅ កម្ពុជា ។ ពិធី ផ្តល់ រសជាតិ អាហារ ល្បី ៗ របស់ កូរ៉េ ខាងត្បូង នេះ ត្រូវបាន រៀបចំឡើង នៅក្នុង និវេសនដ្ឋាន ឯក អគ្គ រដ្ឋទូត កូរ៉េ ប្រចាំ នៅ កម្ពុជា ។
ម្ហូប ទាំង៦មុខ នោះ រួម មាន៖
ទី៥៖ « ខាល់ប៊ី ជីម ខ ឆ្អឹងជំនី » វា ជា អាហារ ដែល ត្រូវបាន គេ ចម្អិន ដោយ ខរម្ងាស់ ឆ្អឹងជំនី ជាមួយ បន្លែ ជាច្រើន មុខ និង ទឹក ស៊ីអ៊ីវ
បន្ទាប់ បាន ភ្លក្ស អាហារ យ៉ាង ពិសេស ទាំង៦មុខ លោក លឹម ជា វុត្ថា អគ្គ នាយក អង្គភាព ព័ត៌មាន Fresh News ព្រមទាំង ថ្នាក់ដឹកនាំ ស្ថាប័ន ព័ត៌មាន ផ្សេង ទៀត សុទ្ធតែ បាន បញ្ជាក់ ដូច ៗ គ្នា អាហារ ទាំងអស់ នោះ គឺ ពិតជា មាន ឱជារស ឈ្ងុយ ឆ្ងាញ់ ព្រោះថា អាហារ ទាំងអស់ នោះ ពិតជា មាន តម្លៃ ណាស់ ដោយ សុទ្ធសឹងតែ ជា អាហារ នៅក្នុង រាជ វាំង ៕
( ភ្នំពេញ ) ៖ នៅ អគ្គ បញ្ជាការដ្ឋាន នា ល្ងាច ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ បាន ទទួល ជួប សំណេះសំណាល ជាមួយ វរសេនីយ៍ ឯក ភីម ម៉ាក់ ចាន់ វង្ស បញ្ញា នាយ ការិយាល័យ អនុព័ន្ធ យោធា ឡាវ ប្រចាំ នៅ ទីក្រុង ភ្នំពេញ ដើម្បី ណែនាំ ខ្លួន ក្នុង ខណៈ ដែល រូបលោក ត្រូវ បាន រាជ រដ្ឋាភិបាល ក្រសួង ការពារ ជាតិ ឡាវ ជ្រើសតាំង ឱ្យ មក បំពេញ ការងារ នៅ កម្ពុជា រយៈពេល ៣ ឆ្នាំ បន្ត ពី លោក អនុព័ន្ធ ចាស់ ដែល បាន ចប់ អាណត្តិ ទៅ ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ និង ស្វាគមន៍ ចំពោះ លោក វរសេនីយ៍ ឯក ភីម ម៉ាក់ ចាន់ វង្ស បញ្ញា ដែល ត្រូវបាន តែងតាំង ជា នាយ ការិយាល័យ អនុព័ន្ធ យោធា ឡាវ ថ្មី នា ឱកាស នេះ ។
លោក បាន បន្ត ថា ក្នុង នាម ថ្នាក់ដឹកនាំ អគ្គ បញ្ជាការ និង លោក ផ្ទាល់ បាន ត្រៀម ខ្លួន ជានិច្ច ដើម្បី ធ្វើ កិច្ចសហការ ដ៏ ជិតស្និទ្ធ រួមចំណែក បន្ត ពង្រឹង ពង្រីក កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ ប្រពៃ ជា ផ្លែ ផ្កា នេះ ទៅ មុខ ទៀត ។ លោក អគ្គ មេបញ្ជាការ បាន ចូលរួម សោកស្តាយ នូវ ការ បាត់បង់ជីវិត ហេ ថា រចនាសម្ព័ន្ធ ដោយ ដោយ គ្រោះ ទឹក ជំនន់ នៅ តំបន់ មួយចំនួន នៃ ប្រទេស ឡាវ ។
លោក បាន បន្ត ថា៖ « យើង ត្រូវ ខិតខំ បន្ត កិច្ចសហប្រតិបត្តិការ បន្ត ទៀត លើ ការងារ បង្រាប បទល្មើស ផ្សេង ៗ ដូចជា បទ ល្មើស កាប់ ឈើ ជួញដូរ គ្រឿងញៀន ។ល ។ » ។
លោក វរសេនីយ៍ ឯក ភីម ម៉ាក់ ចាន់ វង្ស បញ្ញា បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ ចំពោះ ការទទួល បដិសណ្ឋារកិច្ច យ៉ាង កក់ក្តៅ បំផុត និង បាន លើកឡើង អំពី ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង ប្រទេស យើង ទំាង ពីរ ឡាវ - កម្ពុជា ដែល មាន ប្រវត្តិ ជា យូលង់ ណាស់ មកហើយ ។
លោក សេនានុព័ន្ធ យោធា ឡាវ បាន ប្តេជ្ញា ខិតខំ ឱ្យ អស់ ពី លទ្ធភាព ធ្វើ យ៉ាង ណា ជួយ ជ្រោមជ្រែង ឱ្យ កិច្ចសហប្រតិបត្តិការ នេះ កាន់តែ ល្អ ប្រសើរ ជាង មុន ។ ចំពោះ បញ្ហា ព្រំដែន កងទ័ព ប្រជាជន ឡាវ បាន ឯកភាព និង គាំទ្រ ទាំងស្រុង តាម កិច្ចព្រមព្រៀង រវាង រវាង នាយក រដ្ឋមន្ត្រី ឡាវ និង កម្ពុជា ហើយ មាន ជំនឿ ជឿជាក់ ថា និង ដោះស្រាយ បាន ចប់ នា ពេល ខាងមុខ នេះ ៕ ក្រសួង ពាណិជ្ជកម្ម រៀបចំ កិច្ចប្រជុំ ពិនិត្យ លើ ឯកសារ ទស្សនទាន ដើម្បី ធ្វើ បច្ចុប្បន្នភាពយុទ្ធសាស្ត្រ សមាហរកម្ម ពាណិជ្ជកម្ម ២០១៩ - ២០២៣
ថ្លែង នៅក្នុង សុន្ទរកថា បើក អង្គប្រជុំ លោក រដ្ឋមន្ត្រី បាន ជម្រាប ថា យុទ្ធសាស្ត្រ សមាហរណកម្ម ពាណិជ្ជកម្ម គឺជា ឯកសារ យុទ្ធសាស្ត្រ របស់ ក្រសួង ពាណិជ្ជកម្ម ក្នុង គោលបំណង ជំរុញ ការធ្វើ សមាហរណកម្ម ពាណិជ្ជកម្ម ពិពិធកម្ម ទីផ្សារ និង ផលិតផល សម្រាប់ នាំចេញ ។
ឯកសារ យុទ្ធសាស្ត្រ នេះ ត្រូវបាន រៀបចំ ជា លើក ដំបូង នៅក្នុង ឆ្នាំ ២០០១ ដោយ ផ្ដោត ជា ចំបង លើ ការធ្វើ សមាហរណកម្ម របស់ កម្ពុជា ចូលក្នុង ទីផ្សារ ពិភពលោក និង ជំរុញ ការចូល របស់ កម្ពុជា នៅក្នុង អង្គការ ពាណិជ្ជកម្ម ពិភពលោក ក្នុង ឆ្នាំ ២០០៣ ហើយ បាន ធ្វើ បច្ចុប្បន្នភាព លើក ទី១ នៅក្នុង ឆ្នាំ ២០០៧ ដែល បាន បង្កើត ជា សរសរស្ដម្ភ ចំនួន បី នៅក្នុង យន្តការជំរុញ ការអភិវឌ្ឍ ពាណិជ្ជកម្ម មួយ ដែល ហៅ ថា អភិក្រម គ្របដណ្ដប់ លើ វិស័យ ពាណិជ្ជកម្ម (Trade SWAp) ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៦.២៥៣ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ១១៣៤ គ្រឿង ( ម៉ូតូ ៨២ %) អប់រំ១៦១ គ្រឿង និង ផាក ពិន័យ ៩៧៣ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
