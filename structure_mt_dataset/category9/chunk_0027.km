ភ្លាម ៗ នោះ ក្រុម មន្ត្រី តា ជី គីស្ថាន ជាច្រើន ក៏ បាន ទទួលស្គាល់ ថា អំពើហិង្សា បាន កើតឡើង ផងដែរ តែ មិន ទាន់ បាន ផ្ដល់ ព័ត៌មាន អ្វី លម្អិត បន្ថែម នោះ ឡើយ ៕ចក្រភព អង់គ្លេស ចាប់អារម្មណ៍ អភិវឌ្ឍន៍ លើ វិស័យ សំខាន់ ៗ ចំនួន បី ដើម្បី ចូលរួម ជំរុញ កំណើន សេដ្ឋកិច្ច កម្ពុជា
( ភ្នំពេញ ) ៖ មន្ត្រី ជាន់ ខ្ពស់ ទទួលបន្ទុក កិច្ចការ ពាណិជ្ជកម្ម នៃ ចក្រភព អង់គ្លេស ប្រចាំ តំបន់ អាស៊ី អាគ្នេយ៍ លោក គ្រីស ផូក (Chris Pook) បាន បង្ហាញ ចំណាប់អារម្មណ៍ ចង់ ចូលរួម អភិវឌ្ឍន៍ វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ អប់រំ សុខភាព និង បច្ចេកវិទ្យា ដើម្បី ជំរុញ កំណើន សេដ្ឋកិច្ច កម្ពុជា និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង អង់គ្លេស និង កម្ពុជា ។
នៅក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម នៅ ទីស្តីការ ក្រសួង កាលពី រសៀល ថ្ងៃពុធ ទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ លោក គ្រីស ផូក បាន គូសបញ្ជាក់ ថា ចក្រភព អង់គ្លេស មាន បំណង ផ្តល់ នូវ ជំនួយ ហិរញ្ញប្បទាន ដើម្បី គាំទ្រ ការអនុវត្ត គម្រោង សំខាន់ ៗ នៅក្នុង ប្រទេស កម្ពុជា ដូចជា ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ការបណ្តុះបណ្តាល ធនធាន មនុស្ស ការលើកកម្ពស់ សុខ មាលភាព សាធារណៈ និង ការធ្វើ ទំនើបកម្ម បច្ចេកវិទ្យា ។
មន្ត្រី ជាន់ ខ្ពស់ ចក្រភព អង់គ្លេស រូប នេះ បាន បន្ថែម ទៀត ថា ក្រៅពី វិស័យ អទិភាព ខាងលើ អង់គ្លេស ក៏ មាន បំណង ចូលរួម អភិវឌ្ឍន៍ ទីក្រុង វ័យ ឆ្លាត (Smart City) នៅក្នុង ប្រទេស កម្ពុជា និង នៅ តាម រដ្ឋ ជា សមាជិក អាស៊ាន ផងដែរ ហើយ បច្ចុប្បន្ន មាន វិនិយោគិន អង់គ្លេស ជាច្រើន កំពុង ស្វែងរក ឱកាស ពង្រីក ធុរកិច្ច និង វិនិយោគ មកកាន់ កម្ពុជា និង តំបន់ អាស៊ាន ប៉ុន្តែ ត្រូវការ ហេដ្ឋារចនាសម្ព័ន្ធ និង ធនធាន មនុស្ស ដើម្បី គាំទ្រ ការ ធ្វើ ប្រតិបត្តិការ ។
ជា ការឆ្លើយតប លោក ប៉ាន សូរស័ក្តិ បាន ស្វាគមន៍ ចំពោះ ចេតនា របស់ ចក្រភព អង់គ្លេស និង បាន ពន្យល់ ដល់ លោក គ្រីស ផូក អំពី ចក្ខុវិស័យ របស់ រាជ រដ្ឋាភិបាល យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ គោល នយោបាយ អភិវឌ្ឍន៍ ឧស្សហកម្ម និង គោល នយោបាយ គាំពារ វិនិយោគ កម្ពុជា ដែល ផ្តោត សំខាន់ លើ ការទាក់ទាញ វិនិយោគិន ដើម្បី ធ្វើ ពិពិធកម្ម ឱកាស ការងារ និង បែក ចែក កំណើន ប្រកបដោយ សមធម៌ ។
លោក រដ្ឋមន្ត្រី បាន ស្នើ ចក្រភព អង់គ្លេស ពិចារណា ចូលរួម ជាមួយ គម្រោង ផ្លូវ និង ខ្សែក្រវ៉ាត់ (Belt & Road) របស់ ប្រទេស ចិន និង ធ្វើ ការចុះ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ទេ្វ ភាគី (FTA) ជាមួយ កម្ពុជា ដើម្បី ធានា បាន នូវ កិច្ចសហប្រតិបត្តិការ ស៊ីជម្រៅ លើ វិស័យ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ ។
បន្ថែម លើ នេះ តាមរយៈ លោក គ្រីស ផូក លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន អំពាវនាវ ដល់ វិនិយោគិន អង់គ្លេស ធ្វើ ការបណ្តាក់ទុន លើ ផ្នែក ហេដ្ឋារចនាសម័្ពន្ធ រូប វន្ត ធនធាន មនុស្ស ឧស្សហកម្ម កែច្នៃ វិទ្យាសាស្រ្ត កសិកម្ម និង កិច្ច សម្រួល ពាណិជ្ជកម្ម ពីព្រោះ វិស័យ ទាំងអស់ នេះ គឺជា កត្តា អទិភាព ដើម្បី ទ្រទ្រង់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា ។
សូម ជម្រាប ថា ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី រវាង កម្ពុជា និង ចក្រភព អង់គ្លេស មាន វឌ្ឍនភាព គួរឱ្យ កត់សម្គាល់ នៅក្នុង នោះ ការនាំចេញ ទំនិញ របស់ កម្ពុជា បាន កើនឡើង ពី ទឹកប្រាក់ ៧៥២ លាន ដុល្លារ នៅក្នុង ឆ្នាំ ២០១៤ ដល់ ទឹកប្រាក់ ១.០១៤ លាន ដុល្លារ នៅក្នុង ឆ្នាំ ២០១៧ ។ ទន្ទឹម គ្នា នេះ ទឹកប្រាក់ វិនិយោគ ពី បរទេស (FDI) របស់ អង់គ្លេស មក កម្ពុជា កាលពី ឆ្នាំ ២០១៧ មាន ចំនួន ៥៥លាន ដុល្លារ ដែល ធ្វើឱ្យ អង់គ្លេស ស្ថិត នៅតែ ជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស ចំនួន ១០ ដែល បាន វិនិយោគ ច្រើន ជាង គេ នៅ កម្ពុជា ៕
រុស្ស៊ី៖ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន អាចនឹង មក ទស្សនកិច្ច ទីក្រុង ម៉ូស្គូ នៅ ឆ្នាំ ក្រោយ នេះ
( ម៉ូស្គូ) ៖ ជំនួយការ ម្នាក់ របស់ លោក ប្រធានាធិបតី រុស្ស៊ី លោក វ្ល៉ាឌីមៀ ពូទីន គឺ លោក Yury Ushakov បាន ឱ្យដឹង ថា មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន ទំនងជា អាចនឹង បំពេញ ដំណើរទស្សនកិច្ច មកកាន់ ប្រទេស រុស្ស៊ី នៅ ឆ្នាំ ក្រោយ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន យ៉ុន ហាប់ នៅ ថ្ងៃព្រហស្បតិ៍ ទី ០៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង លោក ប៊ុន ចន្ធឺ ជា អនុ រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង លោក ប៊ុន ចន្ធឺ ជា អនុ រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម ។ នេះ បើ យោង តាម ព្រះរាជ ក្រឹត្យ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ០៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ៕
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្ស ត្រ៖ ប្រទេស ក្រិក តាំង បង្ហាញ អាចម៍ផ្កាយ មួយ ដុំ ដែល ធ្លាក់ មក លើ ប្រទេស នេះ កាលពី ២០០ ឆ្នាំ មុន
បំណែក អាចម៍ផ្កាយ Serres ត្រូវបាន នាំយក មកពី សារមន្ទីរ ប្រវត្តិសាស្រ្ត ធម្មជាតិ NHM នៅ ទីក្រុង វីយែន នៃ ប្រទេស អូទ្រី ស ក្រោយពី ធ្លាក់ នៅ ក្រិក កាលពី ២០០ ឆ្នាំ មុន ។ សម្រាប់ ការផ្ទេរ មក ដាក់ តាំង បង្ហាញ សម្រាប់ រយៈពេល ប៉ុន្មាន ថ្ងៃ នៅ ទីក្រុង អាតែ ន គឺ ដើម្បី អបអរ ឱកាស ខួប ២០០ ឆ្នាំ នេះ ផងដែរ ។
ទិន្នន័យ ជាក់លាក់ អំពី ការធ្លាក់ របស់ វា ពុំ មាន អ្នក ដឹង ច្បាស់ ជាង នេះ ឡើយ ហើយ នៅ ឆ្នាំ ១៨៤៤ បំណែក អាចម៍ផ្កាយ នេះ ក៏ បាន លេច រូបរាង ឡើង ក្នុង សារមន្ទីរ NHM នៅ វីយែន តែ ម្តង ជា ទី ដែល វា ត្រូវបាន រក្សាទុក រហូតមក ជាមួយ បំណែក អាចម៍ផ្កាយ ជាច្រើន ផ្សេង ទៀត ៕
( ដាម៉ាស់ ) ៖ មេបញ្ជាការ យោធា មួយ រូប នៃ ប្រទេស ស៉ីរី បាន លើកឡើង ថា ការប្រគល់ ប្រព័ន្ធ មីស៉ីល ការពារ អាកាស រុស្ស៉ី S-300 មកកាន់ ស៉ីរី ពុំ បាន លុបបំបាត់ ចោល ទាំងស្រុង នូវ ហានិភ័យ នៃ ការវាយប្រហារ ថ្មី ជា បន្តបន្ទាប់ ដោយ អ៉ី ស្រាអែល នោះ ឡើយ ប៉ុន្តែ វា បាន កាត់បន្ថយ លទ្ធភាព ជោគជ័យ នៃ សកម្មភាព ទាំងនោះ ឲ្យ នៅ តិចតួច បំផុត ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន រុស្ស៉ី Sputnik នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី ០៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
លោក បាន បញ្ជាក់ ទៀត ថា « ចំពោះ រឿង EBA និង រឿង ផ្តល់ ជំនួយ ពី សហភាព អឺរ៉ុប ដល់ ប្រទេស កម្ពុជា គឺ វា ជា រឿង ២ដាច់ដោយឡែក ពី គ្នា ហើយ នៅក្នុង ដំណើរទស្សនកិច្ច នេះ គឺ ផ្តោត ទោះ លើ គម្រោង ដែល ទទួលបាន ថវិកា ជា ផ្នែក មួយ នៃ កម្មវិធី កិច្ចសហប្រតិបត្តិការ ជាមួយ រដ្ឋាភិបាល កម្ពុជា ដូចនេះ កម្មវិធី ទាំងអស់ នេះ គឺ អាស្រ័យ ទៅ លើ កិច្ចព្រមព្រៀម ដែល យើង មាន ជាមួយ រដ្ឋាភិបាល ហើយ យើង ជឿ ថា តាមរយៈ កម្មវិធី ទាំងអស់ នេះ និង ជួយ គាំទ្រ ដល់ ប្រទេស កម្ពុជា រយៈពេល វែង ដែល ជា អ្វី ដែល គ្រប់ គ្នា ចង់ ឃើញ ផងដែរ »៕
រថយន្ត ដឹក ដី ដឹក ខ្សាច់ កំពុងតែ បំផ្លាញ ផ្លូវ និង បង្ក គ្រោះ ចរាចរណ៍ ជាញឹកញាប់
( ភ្នំពេញ ) ៖ រថយន្ត ដឹក ដី ដឹក ខ្សាច់ របស់ ឈ្មោះ វែង ដែល គេ ស្គាល់ ថា « តា វែង ៗ » នោះ បច្ចុប្បន្ន កំពុងតែ បំផ្លាញ ផ្លូវ លំ និង ផ្លូវ បេតុង ក្នុង ខណ្ឌ ឫស្សីកែវ និង ខណ្ឌ ជ្រោយ ចង្វារ ខូចខាត ខ្ទេចខ្ទី អស់ ជាពិសេស រថយន្ត របស់ ក្រុម តា វែង នេះ តែងតែ បង្ក គ្រោះថ្នាក់ ចរាចរណ៍ បង្កឲ្យ មាន មនុស្ស ស្លាប់ របួស និង ខូចខាត ទ្រព្យសម្បត្តិ ជាញឹកញាប់ ។
ប្រជាពលរដ្ឋ ឲ្យដឹង ថា រថយន្តក្រុម តា វែង នេះ បាន ដឹក ដី ដឹក ខ្សាច់ បំផ្លាញ ផ្លូវ ខូចខាត ស្ទើ គ្រប់ កន្លែង តាំងពី ខណ្ឌ ជ្រោយ ចង្វារ រហូតដល់ ខណ្ឌ ឫស្សីកែវ ហើយ ការដឹកដី ដឹក ខ្សាច់ មិន ដែល គ្រប តាម ការណែនាំ របស់ អាជ្ញាធរ ទេ ដោយ កំពុប ដី ឬ ខ្សាច់ ជ្រុះ ពេញ ផ្លូវ ពេល ខែ ភ្លៀង បែក ភក់ វ៉ល់ ពេល មេឃ ក្តៅ ហុយ ទ្រលោម ពេញ ផ្ទះ ប្រជាពលរដ្ឋ ពិបាក រស់ នៅ ណាស់ ។ ជាង នេះ ទៀត រថយន្ត របស់ តា វែង នេះ យក តៃ កុង ក្មេង ៗ បើក លឿន ៗ បង្ក គ្រោះថ្នាក់ ចរាចរណ៍ ដល់ មនុស្ស ស្លាប់ និង របួស ជាញឹកញាប់ ។
ជាក់ស្តែង រថយន្ត ដឹក ដី មួយ គ្រឿង ដែល គេ ស្គាល់ ថា ជា របស់ តា វែង បាន បើក បុក រះ រថយន្ត រ៉ឺម៉ក់ និង ម៉ូតូ រ៉ឺម៉ក់ កង់ បី ជា បន្តបន្ទាប់ ចំនួន ៥គ្រឿង ជ្រុល ទៅ មុខ បុក គ្រែ លក់ បាយ សម្ល និង កញ្ច្រែង ផ្លែ ឈើ ២ទៅ ៣កន្លែង ទៀត កំពុប បែកបាក់ ខ្ទេចខ្ទី អស់ តែ សំណាង ល្អ ក្នុង ហេតុការណ៍ នោះ មិន បណ្តាលឲ្យ មនុស្ស ណា ម្នាក់ រងរបួស ឡើយ ហើយ តៃ កុង វ័យ ក្មេង បាន ដាក់ មេ ប្រូច តែ គេ ចាប់ បាន វិញ ។
ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ៤៖០០ នាទី រសៀល ថ្ងៃទី ០៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ តាម បណ្តោយ ផ្លូវ បេតុង វាយ កូនហ្គោល ភូមិ បឹង សាឡាង សង្កាត់ ឬស្សីកែវ ខណ្ឌ ឬ ស្ស កែវ រាជធានី ភ្នំពេញ ។
ក្រោយ កើត ហេតុ សមត្ថកិច្ច មូលដ្ឋាន បាន មកដល់ កន្លែង កើត ហេតុ ចំណែក ដំណាង ភាគី រថយន្ត បង្ករ បាន សម្របសម្រួល ដោះស្រា គ្នា ដោយ ភាគី រថយន្ត ហ៊ីយ៉ាន់ដាយ ជួយ ចេញថ្លៃ ការខូចខាត បញ្ចប់ រឿង ។
មហាជន និយាយ ថា គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បង្កឡើង ដោយ រថយន្ត ដឹក ដី របស់ តា វែង ដែល តៃ កុង ក្មេង បើក គ្មាន ការប្រុងប្រយ័ត្ន ហើយ គ្រោះថ្នាក់ ចរាចរណ៍ នេះ មុន កម្មករ រោងចក្រ ចេញ ពី ធ្វើ ការ តែ ប៉ុន្មាន នាទី ប៉ុណ្ណោះ បើ ចំ ម៉ោង កម្មករ ចេញពី ធ្វើ ការវិញ មិន ដឹង មាន អ្នកស្លាប់ និង របួស ប៉ុន្មាន នាក់ ឡើយ ។ ដូច្នេះ សូម អាជ្ញារធរ ពាក់ពន្ធ័ មេត្តា ជួយ មាន វិធានការលើ រថយន្ត ដែល មាន ម្ចាស់ ឈ្មោះ តា វែង នេះ ផង ៕
ជាមួយគ្នា នោះ ដែរ បើ តាម ព័ត៌មាន បឋម ប៉ូលិស ម្នាក់ ត្រូវបាន បាញ់ ឱ្យ របួស ខណៈ មនុស្ស ពី ១១នាក់ ទៅ ២០ នាក់ ក៏ បាន រងរបួស នៅក្នុង បាញ់ប្រហារ នេះ ដែរ ។ ចំណែកឯ រថយន្ដ សង្រ្គោះ បន្ទាន់ ០៤ គ្រឿង ត្រូវ បញ្ជូន ទៅ កន្លែង កើត ហេតុ ហើយ ប៉ុន្តែ មិន ទាន់ មាន សេចក្ដីរាយការណ៍ លម្អិត អំពី ខ្មាន់ កាំភ្លើង នៅឡើយ ទេ ដោយ គ្រាន់តែ គេ ដឹង ថា មាន ការបាញ់ តបត ជាមួយ ប៉ូលិស ប្រហែលជា ៣០គ្រាប់ ៕
រដ្ឋបាល ក្រុង ប៉ោយប៉ែត ត្រៀម ប្រារព្វ ពិធី បុណ្យ អុំ ទូក សំពះ ព្រះខែ អក អំបុក រយៈពេល ៣ ថ្ងៃ . មាន ទូក ង ចំនួន ១០ចូលរួម
( បន្ទាយមានជ័យ ) ៖ រដ្ឋបាល ក្រុង ប៉ោយប៉ែត នឹង រៀបចំ ប្រារព្វ ពិធី បុណ្យ អុំ ទុក រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៩ ដល់ ថ្ងៃទី ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ដោយ មាន ការដឹកនាំ ពី លោក សាន ស៊ាន ហូ អភិបាល ក្រុង ប៉ោយប៉ែត រួម និង មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ។
លោក សាន ស៊ាន ហូ បាន បញ្ជាក់ ថា ការប្រារព្ធ ពិធី ប្រកបដោយ អត្ថន័យ មួយ នេះ ស្តែង ឡើង ពី ស្មារតី ជួយ ឧបត្ថម្ភ គាំទ្រ របស់ បណ្ដា អង្គភាព រដ្ឋ វិស័យ ឯកជន សប្បុរសជន នានា និង មាន ការចូលរួម ដោយ ផ្ទាល់ របស់ កីឡាករ ប្រណាំង ទូក ដែល បាន សម្ដែង ចេញ ពី មនសិកា ស្នេហា កីឡា ប្រណាំង ទូក ដែល ជា ប្រពៃណី វប្បធម៌ ជាតិ តាំងពី អតីតកាល ។
មួយវិញទៀត ក្នុង ការជួយ ឧបត្ថម្ភ គាំទ្រ គ្នា ទៅ វិញ ទៅ មក ដែល ជា ប្រពៃណី និង វប្បធម៌ ចែករំលែក របស់ បុព្វបុរស យើង តាំងពី សម័យ បុរាណ និង ជា ការរំលឹក ឡើងវិញ នូវ គំរូវីរភាព ដ៏ អង់អាច ក្លាហាន របស់ វីរកងទ័ព ជើងទឹក នៃ កុលបុត្រ ខ្មែរ ក្នុង ការការពារ អធិបតេយ្យភាព បូរណភាព ទឹកដី នា សម័យ មហានគរ ដ៏ រុងរឿង ដោយ បាន បូជា នូវ កម្លាំង កាយ ចិត្ត និង អាយុជីវិត ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ ជា ទី ស្នេហា នៃ យើង » ។
សួម បញ្ជាក់ ថា ពិធី ការប្រណាំង ទូក ង នេះ គឺ ដើម្បី អបអរសាទរ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ដែល ក្រុង ប៉ោយប៉ែត នឹង ប្រារព្ធ ឡើង រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៩ - ១១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ មាន ទូក ធំ វែង ចំនួន ២ទូក ទូក តូច ចំនួន ៨ទូក ផងដែរ ៕ ករណី មន្ត្រី យោធា ប៉ុង ប៉ង បាញ់ សម្លាប់ បុរស ម្នាក់ នៅ ខណ្ឌ សែនសុខ. តុលាការ លើក ពេល ប្រកាស សាលក្រម នៅ ពេល ក្រោយ តែ មិន ទាន់ កំណត់ ពេល
( ភ្នំពេញ ) ៖ មិន ដូចជា ការគ្រោងទុក នោះ ទេ នៅ ថ្ងៃទី ៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ តុលាការ បាន លើក ប្រកាស សាលក្រម លើ សំណុំរឿង ប៉ុនប៉ង ឃាតកម្ម លើ ជនរងគ្រោះ ឈ្មោះ គង់ រ៉ាវិន ភេទ ប្រុស អាយុ៣០ ឆ្នាំ និង ឈ្មោះ សឺង វិន ហៅ ស្រី លក្ខណ៍ ទៅ ពេល ក្រោយ ដែល ជន ប្រព្រឹត្ត ក្នុង សំណុំរឿង នេះ គឺជា មន្ត្រី យោធា ម្នាក់ ។
គួរ រំលឹក ថា កាលពី ព្រឹក ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០១៨ កន្លងទៅ លោក រស់ ពិសិដ្ឋ ប្រធាន ក្រុមប្រឹក្សា រ ជំនុំជម្រះ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ បាន បើក សវនាការ កាត់ទោស មន្ត្រី យោធា ម្នាក់ ពាក់ព័ន្ធ ករណី បាញ់ សម្លាប់ មនុស្ស តែ មិន ស្លាប់ ប៉ុន្តែ ជនរងគ្រោះ មិន ស្លាប់ ដូច បំណង ។
សវនការ ក្នុង សំណុំរឿង នេះ ដែរ មាន លោក សេង ហៀង ជា តំណាង អយ្យការ បាន ប្តឹង ចោទប្រកាន់ ជន ជាប់ចោទ ឈ្មោះ ប៊ុន តេង ហៅ អាហ្គោ ភេទ ប្រុស អាយុ ៣២ ឆ្នាំ មុខរបរ មន្ត្រី យោធា ភូមិភាគ ៥ មាន ឋានន្តរស័ក្តិ វរសេនីយ៍ ពី បទ ប៉ុនប៉ង ឃាតកម្ម លើ ជនរងគ្រោះ ឈ្មោះ គង់ រ៉ាវិន ភេទ ប្រុស អាយុ៣០ ឆ្នាំ មុខរបរ លក់ដូរ ស្នាក់ នៅ ផ្ទះ លេខ ៣៣កា ផ្លូវ លំ ភូមិ ទួល ថ្ងាន់ សង្កាត់ ទួល សង្កែ និង ឈ្មោះ សឺង វិន ហៅ ស្រី លក្ខណ៍ ភេទ ស្រី អាយុ ២៥ ឆ្នាំ ។
នៅក្នុង សវនាការ ជន ជាប់ ចោទ បាន អះអាង ថា កាំភ្លើង ដែល ខ្លួន យក ទៅ ប្រព្រឹត្ត បទល្មើស នោះ ជា កេរ្តិ៍មរតក របស់ ឪពុក ខ្លួន ដែល ជា មន្ត្រី យោធា ម្នាក់ បន្សល់ទុក ឱ្យ ខ្លួន ដាក់ តាម ខ្លួន និង ការពារ ខ្លួន ពេល ផឹក ស៊ី តែ មិន មាន ច្បាប់ អនុញ្ញាតឱ្យ ប្រើប្រាស់ ទេ ។ ជន ជាប់ចោទ បន្ថែម ថា ខ្លួន អត់ បាន បាញ់ ជនរងគ្រោះ នោះ ទេ គឺ រាល កៃ ចំនួន ៥គ្រាប់ ចំជនរងគ្រោះ ទាំង ២នាក់ ។
ជនជាប់ចោទ បាន ស្នើសុំ ឱ្យ តុលាការ លើកលែង ចោទប្រកាន់ ព្រោះ ខ្លួន អត់ បាន បាញ់ ទេ គឺ ខុស មកពី កាំភ្លើង វា រាល កៃ ខណៈ ម្រាម ដៃ របស់ គេ ជា អ្នក កេះ កៃ កាំភ្លើង ។ ប៉ុន្តែ តុលាការ បាន បញ្ជាក់ នៅក្នុង សវនាការ ថា រាល កៃ មិន អាច ចំ គោលដៅ និង ផ្ទុះ រហូត ៥គ្រាប់ បាន ទេ មាន ន័យ ថា ការអះអាង របស់ ជនជាប់ចោទ ហាក់ មិន ស៊ីសង្វាក់ នឹង អង្គហេតុ សោះ ។
ក្រោយពេល កើត ហេតុ បាន ២ ថ្ងៃ ជន ជាប់ ចោទ បាន ចូលខ្លួន សារភាព កំហុស នៅ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ និង ត្រូវបាន សមត្ថកិច្ច ជំនាញ ឃាត់ខ្លួន កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ឱ្យ សម្រេច ដាតាម ច្បាប់ ៕ លោកស្រី រ៉ូណា ស្មីត កំពុង ធ្វើ សន្និសីទ នៅ ការិយាល័យ សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា ក្រោយ បញ្ចប់ ទស្សនកិច្ច រយៈពេល ១១ ថ្ងៃ
( ភ្នំពេញ ) ៖ អ្នក រាយការណ៍ ពិសេស អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស នៅ កម្ពុជា លោកស្រី រ៉ូណា ស្មីត (Rhona Smith) នៅ រសៀល ថ្ងៃទី ០៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន រៀបចំ សន្និសីទ សារព័ត៌មាន មួយ នៅ ការិយាល័យ សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា ដើម្បី បង្ហាញ អំពី របាយការណ៍ គំហើញ បឋម នៃ ដំណើរទស្សនកិច្ច រយៈពេល ១១ ថ្ងៃ របស់ លោកស្រី នៅ កម្ពុជា ។
លោកស្រី រ៉ូណា ស្មីត បាន មកដល់ ប្រទេស កម្ពុជា នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ ដើម្បី បំពេញ ទស្សនកិច្ច ១១ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៩ ខែតុលា ដល់ ថ្ងៃទី ០៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។ ទស្សនកិច្ច នេះ ធ្វើឡើង តាម ការអញ្ជើញ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។ ក្នុង អំឡុង ពេល ទស្សនកិច្ច រយៈពេល ១១ ថ្ងៃ នេះ អ្នកជំនាញ រូប នេះ បាន ជួប ជាមួយ មន្រ្តី ជាន់ ខ្ពស់ របស់ រដ្ឋាភិបាល តំណាង សង្គម ស៊ីវិល និង សមាជិក សហគមន៍ ការទូត មួយចំនួន ផងដែរ ។
ទស្សនកិច្ចតប តាម ការអញ្ជើញ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នេះ ក៏ ធ្វើឡើង បន្ទាប់ពី រាជ រដ្ឋាភិបាល កម្ពុជា និង ការិយាល័យ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស ដើម្បី អនុវត្ត កម្មវិធី កិច្ចសហប្រតិបត្តិការ បច្ចេកទេស ស្តីពី បញ្ហា សិទ្ធិ មនុស្ស នៅ កម្ពុជា ផងដែរ ។
