( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០១៨ នេះ ក្លឹប អ្នកកាសែត កម្ពុជា បាន សហការ ជាមួយ អង្គការ ខាណា រៀបចំ សិក្ខាសាលា ស្តីពី « ការពិភាក្សា ពី ក្រម ប្រតិបត្តិ សម្រាប់ អ្នកសារព័ត៌មាន ក្នុង ការរាយការណ៍ ទាក់ទិន នឹង អ្នកទទួលរង ផល ប៉ះពាល់ ដោយសារ គ្រោះ ញៀន » ។
កម្មិវិធី នេះ បាន ប្រព្រឹត្ត ធ្វើឡើង នៅ ភោជនីយដ្ឋាន ទន្លេ បាសាក់២ រាជធានី ភ្នំពេញ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក លោក ប៉ែន បូណា ប្រធាន ក្លឹប អ្នកកាសែត កម្ពុជា . លោក ឆាយ សុផល នាយក ប្រតិបត្តិ ក្លឹប អ្នកកាសែត កម្ពុជា . លោក ជួប សុខ ចំរើន នាយក ប្រតិបត្តិ អង្គការ ខាណា រួមទាំង អ្នកសារព័ត៌មាន មក ពី អង្គភាព និង ស្ថាប័ន នានា យ៉ាង ច្រើន កុះករ ផងដែរ ។
គួរ ជម្រាប ថា លោក Vichai មិន ដែល អាក់ខាន ធ្វើដំណើរ ទៅ ចូលរួម រាល់ ការប្រកួត នៅពេល ក្លឹប របស់ លោក ត្រូវ ធ្វើជា ម្ចាស់ ផ្ទះ ឡើយ តាមរយៈ ឧទ្ធម្ភាគចក្រ ខាងលើ ហើយ ជារឿយ ៗ មហាសេដ្ឋី វ័យ ៦១ ឆ្នាំ រូប នេះ តែង ឡើង ឧទ្ធម្ភាគចក្រ ចេញ ពី កណ្តាល ទីលាន បាល់ទាត់ ក្រោយ ចប់ ការប្រកួត ដើម្បី ត្រឡប់ ទៅវិញ ។
ព្រះរាជ ជីវប្រវត្តិ និង រូបថត ឯកសារ នៃ ព្រះរាជ ពិធី ឡើង គ្រងរាជសម្បត្តិ នៃ ព្រះករុណា ជា អម្ចាស់ ជីវិត តម្កល់ លើ ត្បូង ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា
( មណ្ឌលគិរី ) ៖ ក្មេងប្រុស អាយុ ១១ឆ្នាំ ម្នាក់ ត្រូវ ឃាតក មិន ស្គាល់ មុខ កាប់ សម្លាប់ យ៉ាង ព្រៃផ្សៃ បំផុត នៅ វាល ស្រែ នៅ ល្ងាច ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នៅ វាល ស្រែ នៅក្នុង ភូមិ ស្រែ ហ៊ុយ ឃុំ ស្រែ ហ៊ុយ ស្រុក កោះ ញែក ខេត្ត មណ្ឌលគិរី ។
លោក ខ្លូត សុឃា អធិការ នគ បាល ស្រុក កោះ ញែក បាន ឲ្យដឹង ថា ជនរងគ្រោះ ឈ្មោះ ចូច លៀន ភេទ ប្រុស អាយុ ១១ ឆ្នាំ រស់ នៅ ភូមិ ស្រែ ហ៊ុយ ឃុំ ស្រែ ហ៊ុយ ស្រុក កោះ ញែក ឪពុក ឈ្មោះ ចេល ចូច អាយុ ៣៤ ជនជាតិ ព្នង មុខរបរ កសិករ និង ម្ដាយ ឈ្នោះ ម៉ៅ ស្រៀក មុខរបរ កសិករ ។
ករណី ខាងលើ នេះ មិន ទាន់ ដឹង មូលហេតុ នៅឡើយ ទេ សមត្តកិច្ច កំពុង ធ្វើ ការស្រាវជ្រាវ ៕
នៅ ព្រឹក នេះ ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល នាំ ប្រជាពលរដ្ឋ កោះ ធំ ជិត ៦០០ នាក់ ជិះ រថភ្លើង ដើរកំសាន្ត ពី ភ្នំពេញ ទៅ ខេត្ដ កំពង់ឆ្នាំង ( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅ ព្រឹក ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០១៨ នេះ ដឹកនាំ ប្រជាពលរដ្ឋ ស្រុក កោះ ធំ ខេត្ត កណ្តាល ជិត ៦០០ នាក់ មក ជិះ រថភ្លើង កំសាន្ត ពី ភ្នំពេញ ទៅកាន់ ខេត្ត កំពង់ឆ្នាំង ។
ការរៀបចំ ឲ្យ ប្រជាពលរដ្ឋ កោះ ធំ ធ្វើដំណើរ តាម រថភ្លើង នេះ ជា លើក ទី៣ហើយ ដើម្បី ជំរុញ ឲ្យ មាន ការគាំទ្រ ការធ្វើដំណើរ តាម រថភ្លើង ភាគ ខាងជើង រាជធានី ភ្នំពេញ ( ភ្នំពេញ - ប៉ោយប៉ែត ) ដែល រាជ រដ្ឋាភិបាល កម្ពុជា បាន តភ្ជាប់ ឡើងវិញ ទាំងស្រុង កាលពី ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ ក្រោយពី ខកខាន ដំណើរការអស់ ជាច្រើន ឆ្នាំ មក នេះ ។
កំណាត់ ផ្លូវ ដែក ចាប់ពី ប៉ោយប៉ែត រហូតដល់ រាជធានី ភ្នំពេញ ត្រូវបាន ស្តារ និង ដាក់ ឲ្យ ដំណើរការ ឡើងវិញ ទាំងស្រុង កាលពី ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ។ ការស្តារ ឡើងវិញ កំណាត់ ផ្លូវ ដែក ពី ភ្នំពេញ រហូតដល់ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ នេះ បាន ចំណាយ ថវិកា ប្រមាណ ៩៦.៦លាន ដុល្លារ អាមេរិក ។ ក្នុង នោះ ទឹកប្រាក់ ប្រមាណ ១៣លាន ដុល្លារ ជា របស់ ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ADB ហើយ ក្រៅពី នោះ ទឹកប្រាក់ ៨៣. ៦លាន ដុល្លារ ជា ថវិកា របស់ រាជ រដ្ឋាភិបាល ៕
នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន តំណាង សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ផ្ដល់ ភ្លើង បូជា សព ឧត្តមសេនីយ៍ ឯក ជា ម៉ន
( សៀមរាប ) ៖ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ឧប នាយក រដ្ឋមន្រ្តី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ផ្ដល់ ភ្លើង បូជា សព ឧត្តមសេនីយ៍ ឯក ជា ម៉ន មេបញ្ជាការ រង កងទ័ព ជើងគោក និង ជា មេបញ្ជាការ យោធ ភូមិភាគ ទី៤ ដែល បាន ទទួលមរណភាព កាល ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០១៨ ដោយ រោគា ពាធ ។
នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន តំណាង សម្តេច តេជោ ហ៊ុន សែន បាន បួងសួង សូមឲ្យ ដួង វិញ្ញាណក្ខន្ធ ឧត្តមសេនីយ៍ ឯក ជា ម៉ន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន នាំយក ថវិកា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី ចំនួន ២០ លាន រៀល ចូល រូម រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ សព ផងដែរ ៕ ប្រទេស ទាំង១០ ដែល មាន អ្នកសារព័ត៌មាន ស្លាប់ ច្រើន បំផុត . រយៈពេល ១០ឆ្នាំ មាន អ្នកស្លាប់ រហូតដល់ ៩៦០ នាក់
( ពិភពលោក ) ៖ ដើម្បី ផ្ដល់ ព័ត៌មាន ពិត សេរី និង យុត្តិធម៌ មិន មែន ជា រឿង ងាយ នោះ ឡើយ សម្រាប់ អ្នកសារព័ត៌មាន ។ អ្នក ប្រកប អាជីព បែប នេះ ប្រឈមមុខ នឹង គ្រោះថ្នាក់ ច្រើន រហូតដល់ ជីវិត ។ ជាក់ស្តែង អ្នកសារព័ត៌មាន រហូតដល់ ចំនួន ប្រមាណ ៩៦០ នាក់ ត្រូវបាន គេ សម្លាប់ ក្នុង រយៈពេល ១០ ឆ្នាំ ចុងក្រោយ នេះ ។ ខាងក្រោម នេះ ជា ប្រទេស ទាំង១០ ដែល មាន អ្នកសារព័ត៌មាន ស្លាប់ ច្រើន បំផុត រាប់ ចាប់ពី ឆ្នាំ ១៩៩២ម ក៖
តាម ការឆ្លើយ សារភាព ពី មា្ចស់ បាន ឲ្យដឹង ថា កាំភ្លើង ទាំងនេះ ខ្លួន បាន សាង ពី រថយន្ត មួយ គ្រឿង ផ្សេង ទៀត នៅ ផ្សារ អូរ ឡាំពិក រាជធានី ភ្នំពេញ លាយឡំ ជាមួយ ទំនិញ ចំម្រុះ ដោយ មិន បាន ដឹង ថា ជា អាវុធ ទេ ។ ម្ចាស់ បាន បន្ថែម ថា ខ្លួន ដឹក ចេញ ទៅ ប្រទេស វៀតណាម តាម ច្រក ទន្លេ ចាម បាន ចំនួន ៤ជើង ហើយ ក៏ ត្រូវ សមត្ថកិច្ច គយ ចាប់ ឃាត់ តែម្តង ។
តាម បទបញ្ជា របស់ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទស និង មាន ការសម្របសម្រួល ពី លោក ហៀង សុភក្រ្ត ព្រះរាជអាជ្ញា ខេត្ត ត្បូងឃ្មុំ ម្ចាស់ ទំនិញ និង អ្នកបើកបរ ព្រមទាំង អាវុធ ខុស ច្បាប់ ទាំងនេះ បាន ប្រគល់ ជូន បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ត្បូងឃ្មុំ ដើម្បី ចាត់ការ ទៅតាម នីតិវិធី ច្បាប់ ៕ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែតុលា នេះ លទ្ធផល៖ បង្ក្រាប ២០ករណី ឃាត់ខ្លួន ៣៤ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
* លទ្ធផល បង្ក្រាប រួម មាន៖ ២០ករណី ឃាត់ខ្លួន ៣៤ នាក់
១៖ ករណី ជួញដូរ គ្រឿងញៀន ១៦ករណី ឃាត់ខ្លួន ២១ នាក់ ។ ២៖ ករណី ប្រើប្រាស់ គ្រឿងញៀន ៤ករណី ឃាត់ខ្លួន ១៣នាក់ ស្រី ម្នាក់ ៕ គតិបណ្ឌិត ថ្មី ក្នុង សប្ដាហ៍ នេះ មាន បង្កប់ ចំណេះដឹង ពិសេស ដែល លោក អ្នក នឹកស្មាន មិន ដល់
សូម អាន គតិបណ្ឌិត ទាំង១០ នេះ ឱ្យ បាន ចប់ ដើម្បី ទទួលបាន ចំណេះដឹង ថ្មី ៗ បន្ថែម ទៀត៖
២៖ មនុស្ស ភាគ ច្រើន តែងតែ ស្រលាញ់ និង ប្រើ អំណាច ទាល់តែ ហួស ព្រំដែន ព្រោះ អំណាច ជា អាហារ ដ៏ ឆ្ងាញ់ របស់ ពួកគេ ។ លោក ចច វ៉ានស៊ីន តោន ប្រធានាធិបតី ទី១ នៃ សហរដ្ឋ អាមេរិក ។
៥៖ ការឱន លំទោន មាន សុជីវធម៌ អាច ធ្វើឱ្យ មនុស្ស ឃោរឃៅ ព្រម ចុះ ញ៉ម . ការប្រកាន់ សុចរិត ទៀង ត្រង់ អាច ធ្វើឱ្យ មនុស្ស ចូលចិត្ត យកឈ្នះ ព្រម ញ៉ម ។ ខុង ជឺ
៨៖ មេដឹកនាំ ភ្លឺស្វាង មិន ដែល ខ្លាច ប្រជាជន មិន ស្គាល់ ខ្លួន នោះ ឡើយ ខ្លាចតែ ខ្លួន មិន ស្គាល់ ប្រជាជន ទៅ វិញ ទេ ។ ខុង មិញ ជូ កឺ លៀង
១០៖ បើ អ្នក ចង់ ទៅដល់ គោលដៅ ឬ សម្រេច សុបិន របស់ អ្នក អ្នក មិន អាច ធ្វើ វា ដោយ គ្មាន វិន័យ បាន ឡើយ ។ លី ក្វាន យូ នាយក រដ្ឋមន្ត្រី នៃ ប្រទេស សិង្ហបុរី ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ ការិយាល័យ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស នៅ កម្ពុជា៖
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ ក្នុង ឱកាស ខួប ១៤ ឆ្នាំ នៃ ការយាង គ្រងរាជសម្បត្តិ
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា បាន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ឱកាស ខួប លើក ទី ១៤ នៃ ការយាង គ្រងរាជសម្បត្តិ របស់ ព្រះអង្គ ។
ព្រះអង្គ ត្រូវបាន ក្រុមប្រឹក្សា រាជសម្បត្តិ ជ្រើសតាំង ជា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បន្ត ពី ព្រះបិតា ក្រោយពេល ដែល ព្រះអង្គ បាន ដាក់ រាជ្យ កាលពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០០៤ ៕
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ថ្វាយ ព្រះពរ ព្រះមហាក្ស ត្រ៖
គម្រោង ទី៥ បុរី ទេសចរណ៍ ខេត្ត សៀមរាប ចាប់ បើក លក់ កើ នៅ ដើម ខែវិច្ឆិកា នេះ ហើយ
( សៀមរាប ) ៖ បុរី ទេសចរណ៍ ខេត្ត សៀមរាប អភិវឌ្ឍន៍ ដោយ សម្ព័ន្ធ សហគ្រាស កាណាឌីយ៉ា ដែល ទទួល ហិរញ្ញប្បទាន ផ្ទាល់ ពី ធនាគារ កាណាឌីយ៉ា ក . អ អភិវឌ្ឍន៍ លើ ផ្ទៃដី ប្រមាណ ៦៦ ហិចតា ស្ថិត ក្នុង តំបន់ សក្តានុពល សេដ្ឋកិច្ច ខ្លាំង និង ជាប់ ផ្សារ Makro ខេត្ត សៀមរាប ។
ក្រោយ សំទុះ នៃ ការលក់ ទទួលបាន ជោគជ័យ លើស ពី ការរំពឹងទុក សម្រាប់ គម្រោង ផ្ទះល្វែង វគ្គ ១ និង វគ្គ ២ និង ផ្ទះ វីឡា ទោល វីឡា ភ្លោះ វគ្គ ទី៣ និង វគ្គ ទី៤ រួច មក ក្រុមហ៊ុន បាន ត្រៀម ខ្លួន ក្នុង ការបើក លក់ ផ្ទះល្វែង វគ្គ ទី៥ ដែល មាន ចំនួន សរុប ១៣៣ ល្វែង បក្នុង ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
ផ្ទះល្វែង វគ្គ ទី៥ នេះ នឹង មាន ៥ ជម្រើស ប្រភេទ ផ្ទះ ដែល មាន តម្លៃ ចាប់ពី ៦ម៉ឺន ដុល្លារ អាមេរិក ឡើង ទៅ ។
ទន្ទឹមនឹង ការបើក លក់ ផ្ទះល្វែង វគ្គ ទី៥ នឹង ដើម្បី អបអរ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ខាងមុខ នេះ ក្រុមហ៊ុន នឹង ផ្ដល់ជូន ម៉ាស៊ីន ត្រជាក់ ចំនួន១ គ្រឿង នូវ រាល់ ការកក់ សម្រាប់ ផ្ទះល្វែង ណាមួយ ក៏ដោយ ការបង់ប្រាក់ រយ: ពេល១ ឆ្នាំ ពេញ ដោយ គ្មាន ការប្រាក់ កម្ចី ដោយ គ្មាន ទ្រព្យ បញ្ចាំ រយ: ពេល វែង រហូតដល់ ២៥ ឆ្នាំ ក្រោម ទំហំ នៃ កម្ចី ឥណទាន រហូតដល់ ៩០ % នៃ តម្លៃ ផ្ទះ រួម នឹង ការបញ្ចុះ តម្លៃ រហូតដល់ ៥% សម្រាប់ អតិថិជន ដែល ធ្វើ ការកក់ ក្នុង រយ: ពេល១ សប្តាហ៍ ដំបូង នៃ ការបើក លក់ ។
នេះ ជា លើក ទី៣ហើយ ក្នុង ឆ្នាំ ២០១៨ នេះ ដែល ក្រុម ភេសជ្ជៈ ប៉ូវ កម្លាំង គោ ជល់ ចែក មហា រង្វាន់ ជូន ដល់ កំពូល អ្នក មហាសំណាង ជា អតិថិជន ដែល តែងតែ គាំទ្រ ភេសជ្ជៈ គោ ជល់ មិន ថា អ្នកលក់ ដុំ លក់ រាយ ឬ អ្នក ដែល ចូលចិត្ត ពិសា ភេសជ្ជៈ គោ ជល់ នោះ ទេ ។
នៅ ថ្ងៃ នេះ ក្រុមហ៊ុន ភេសជ្ជៈ ប៉ូវ កម្លាំង គោ ជល់ នាំយក មហា រង្វាន់ ធំ នេះ ចែកជូន ផ្ទាល់ ដល់ លោក យ៉ាន ហៀង នៅ ស្ថានីយ៍ ទូរទស្សន៍ ស៊ី អិន ស៊ី ហើយ នឹង បន្ត នាំយក មហា រង្វាន់ ទៅ ជូន ដល់ ផ្ទះ របស់ លោក នៅ ខេត្ត កំពង់ឆ្នាំង តែម្ដង ។
មិន តែ ប៉ុន ណ្ណោះ នៅ យប់ មិញ នេះ ដែរ អ្នកលក់ ភេសជ្ជៈ គោ ជល់ ដែល អ្នកទិញ បាន ត្រូវ រង្វាន់ រថយន្ត Mazda ក៏ ទទួលបាន រង្វាន់ លើកទឹកចិត្ត ចំនួន ១០លាន រៀល ផងដែរ ។ ដូច ពាក្យស្លោក របស់ យើង ថា អ្នកលក់ បាន លុយ អ្នក ពិសារ បាន ឡាន ។ ហើយ នៅ ថ្ងៃ នេះ ផងដែរ ក៏ មាន អ្នក ដែល មាន សំណាង ត្រូវ រង្វាន់ ធំបន្ទាប់ គឺ រង្វាន់ ម៉ូតូ ហុងដាឌ្រីម ក៏ បាន មក ទទួលរង្វាន់ និង អបអរ សម្រាប់ អ្នក ឈ្នះ រង្វាន់ ធំ ផងដែរ ។
ISIS បើក ការវាយប្រហារ ទ្រង់ទ្រាយ ធំ ផ្តាច់ ជីវិត ក្រុម ឧទ្ទាម ស៉ីរី ដែល អាមេរិក គាំទ្រ ៧០ នាក់ និង បង្កឲ្យ របួស ១០០ នាក់
( ដាម៉ាស់ ) ៖ សមាជិក យ៉ាងតិច ៧០ នាក់ នៃ ក្រុម សកម្ម ប្រយុទ្ធ ប្រជាធិបតេយ្យ ស៉ីរី (SDF) ដែល មាន អាមេរិក ជា អ្នកគាំទ្រ បាន ស្លាប់ និង ១០០ នាក់ បាន រងរបួស ដោយសារ ការវាយប្រហារ ទ្រង់ទ្រាយ ធំ ពីសំណាក់ ក្រុម ជ្រុលនិយម ISIS នៅ ភាគ ខាងកើត ស៉ីរី ។ នេះ បើ តាម ការអះអាង របស់ អង្គការ ឃ្លាំមើល ស្ថានការណ៍ សិទ្ធិ មនុស្ស ស៉ីរី ដកស្រង់ ខ្លឹមសារ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៉ីន ហួរ នៅ រសៀល ថ្ងៃអាទិត្យ ទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ ។
គណបក្ស នយោបាយ អន្តរជាតិ ចំនួន ៧០ ចេញ សេចក្តីថ្លែងការណ៍ ទីក្រុង ម៉ូស្គូ ស្វាគមន៍ CPP ដែល ត្រៀម ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ ពិធី សម្ពោធ ជា ផ្លួវ ការ នៃ ក្រុមប្រឹក្សា វប្បធម៌ អាស៉ី ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ លោកស្រី ឃួន សុដារី សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ នៃ គណបក្ស ប្រជាជន កម្ពុជា បាន ថ្លែង ថា គណបក្ស នយោបាយ ចំនួន ៧០ មកពី ៣៦ ប្រទេស បាន ចេញ សេចក្តីថ្លែងការណ៍ ទីក្រុង ម៉ូស្គូ នៅ ប្រទេស រុស្ស៉ី ស្វាគមន៍ ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ដែល ត្រៀម ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ ពិធី សម្ពោធ ជា ផ្លូវការ នូវ ក្រុមប្រឹក្សា វប្បធម៌ អាស៉ី (ACC) នៅ ទីក្រុង ភ្នំពេញ ក្នុង ឆ្នាំ ២០១៩ ខាងមុខ នេះ ។
លោកស្រី ឃួន សុដារី បាន ថ្លែង បែប នេះ ក្នុង សន្និសីទ សារព័ត៌មាន ពិសេស មួយ នៅ អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ បន្ទាប់ពី បញ្ចប់ បេសកម្ម ដឹកនាំ គណៈប្រតិភូ គណបក្ស ប្រជាជន កម្ពុជា ចូលរួម មហាសន្និបាត លើក ទី១០ របស់ សន្និសីទ អន្តរជាតិ នៃ គណប្រជាជន នយោបាយ អាស៉ី (ICAPP) នៅ ទីក្រុង ម៉ូស្គូ សហព័ន្ទ រុស្ស៉ី ចាប់ពី ថ្ងៃទី ២៤ ដល់ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៨ ។
លោកស្រី ឃួន សុដារី បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « មហាសន្និបាត នេះ បាន អនុម័ត ជា ឯកច្ឆន្ទ នូវ សេចក្តីថ្លែងការណ៍ រួម មួយ របស់ ទីក្រុង ម៉ូស្គូ ដែល បាន ស្វាគមន៍ ចំពោះ ការសម្រេចចិត្ត របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល ត្រៀម ទទួល រៀបចំ ពិធី សម្ពោធ ជា ផ្លូវការ នូវ ក្រុមប្រឹក្សា វប្បធម៌ អាស៉ី (ACC) នៅ ទីក្រុង ភ្នំពេញ នៅ ថ្ងៃទី ១១ ដល់ ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០១៩ ក្រោម អធិបតី ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា » ។
លោកស្រី បាន បន្ត ថា សេចក្តីថ្លែងការណ៍ រួម នេះ ក៏ បាន បញ្ជាក់ ថា អធិបតេយ្យភាព បូរណភាព ទឹកដី ឯករាជ្យ នយោបាយ សមភាព របស់ រដ្ឋ ទាំងអស់ ការដោះស្រាយ ដោយ សន្តិវិធី នូវ ជម្លោះ អន្តរជាតិ ការ មិន ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង និង ឯកភាព គ្នា គឺជា មូលដ្ឋានគ្រឹះ នៃ គោលការណ៍ រួម របស់ ICAPP ។
លើស ពី នេះ សេចក្តីថ្លែងការណ៍ រួម បាន ឆ្លុះបញ្ចាំង ថា ការកើនឡើង នៃ ភាពជ្រុលនិយម និង អំពើហិង្សា បាន បន្ត គំរាមកំហែង យ៉ាង ខ្លាំង ដល់ សន្តិភាព និង សន្តិសុខ អន្តរជាតិ ។ ប្រទេស ទាំងអស់ អាច បំបាត់ នូវ និន្នាការអវិជ្ជមាន នេះ តាមរយៈ កិច្ចសហប្រតិបត្តិការ ប្រកបដោយ ចីរភាព និង ទូលំទូលាយ ក្នុង ចំណោម គណបក្ស នយោបាយ និង រដ្ឋាភិបាល ។
ជាមួយគ្នា នេះ ក្នុង កិច្ចប្រជុំ លើក ទី ៣១ នៃ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ ICAPP អង្គ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ បាន ត្រួតពិនិត្យ នូវ របាយការណ៍ សកម្មភាព ICAPP រយៈពេល ពីរ ឆ្នាំ តាំងពី មាន ការធ្វើ មហាសន្និបាត លើក ទី៩ នៅ ទីក្រុង គូឡាឡាំពួរ ។ ពិសេស គណៈកម្មាធិការ អចិន្ត្រៃយ៍ បាន អបអរសាទរ កម្ពុជា ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង ដើម្បី សម្រេចបាន នូវ កិច្ចព្រមព្រៀង ភាពជាដៃគូរ រវាង ក្រុមប្រឹក្សា វប្បធម៌ (ACC) និង អង្គការ យូណេស្កូ ។
បើ តាម លោកស្រី ឃួន សុដារី កិច្ចព្រមព្រៀង នេះ បាន ធ្វើឲ្យ ICAPP ក្លាយទៅជា ដៃគូ មួយ របស់ អង្គការ យូណេស្កូ ហើយ នេះ ជា ការរីកចម្រើន ដ៏ ធំធេង មួយ ក្នុង ការបង្កើត គុណ តម្លៃ និង តួនាទី របស់ ICAPP លើ ឆាក អន្តរជាតិ ។ សម្តេច តេជោ ហ៊ុន សែន ដែល ជា ប្រធាន ស្ថាបនិក កិត្តិយស របស់ ACC ត្រូវបាន អបអរសាទរ ចំពោះ សមិទ្ធផល ដ៏ ថ្លៃថ្លា នេះ ផងដែរ ៕ អ្នកនាំពាក្យ នេត្រ ភក្រ្តា៖ អាណត្តិ ថ្មី នេះ ក្រសួង បរិស្ថាន ផ្តោត លើ រដ្ឋបាល ទំនើប ដើម្បី ឆ្លើយតប នឹង បំណង ដ៏ ពិសិដ្ឋ របស់ ប្រជាជន កម្ពុជា
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រុមការងារ នៃ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ ព្រមទាំង ក្រុមការងារ សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង ដែគូរ ភាគី ពាក់ព័ន្ធ ទំាង អស់ ចែករំលែក ចំណេះដឹង បទពិសោធន៍ ដែល ធ្វើអោយ ដំណើរការ នៃ ពិព័រណ នេះ មាន ការចូលរួម ទស្សនា និង អ្នក ស្វែងរក ការងារ យ៉ាង ច្រើន កុះករ ជា ទី មោទនៈ ក្នុង រយៈពេល ២ ថ្ងៃ នេះ ។
លោក សុខ សប្បាយ ណា អនុ រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ការហាត់ប្រាណ ដើម្បី សុខភាព និង ការសម្អាត បរិស្ថាន ក៏ ដូចជា ការផ្លាស់ប្តូរ ឥរិយាបថ របស់ សាធារណជន ចំពោះ ការគ្រប់គ្រង សំរាម ដែល ខ្លួន បាន បង្កើតឡើង ។ លោក បាន កោតសរសើរ ចំពោះ សិស្សានុសិស្ស សុឆន្ទៈ សាលា ACE និង គណៈកម្មការ កិច្ចការ សង្គម IDP-ACE ដែល បាន ផ្តួចផ្តើម បង្កើត កម្មវិធី រត់ ដើម្បី បរិស្ថាន នេះ ឡើង ។
អ្នកចូលរួម ប្រកបដោយ ទឹកមុខ សប្បាយរីករាយ និង ប្រកបដោយ មោទនភាព ។ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន ថ្លែង ថា ការចូលរួម របស់ យុវជន និង សាធារណជនជាតិ និង អន្តរជាតិ ក្នុង កម្មវិធី រត់ ដើម្បី បរិស្ថាន នៅ ពេល នេះ គឺជា ការប្តេជ្ញាចិត្ត ក្នុង ការលើកកម្ពស់ នៃ ការរស់នៅ ប្រកបដោយ ផាសុកភាព តាមរយៈ ការហាត់ប្រាណ ហើយ តាមរយៈ សកម្មភាព ទាំងនេះ នឹង ចូលរួមចំណែក ក្នុង ការរៃ អង្គាស ក្នុង យុទ្ធនាការ អនាម័យ និង បរិស្ថាន ស្អាត ។
ស្វែងយល់ ផ្នែក ច្បាប់៖ បទល្មើស ចរាចរណ៍ ផ្លូវគោក
ដើម្បី បកស្រាយ សំណួរ ខាងលើ នេះ កម្មវិធី យល់ដឹង ផ្នែក ច្បាប់ របស់ អង្គភាព ព័ត៌មាន FRESH NEWS សហការ ជាមួយ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ សម្រាប់ សប្តាហ៍ នេះ សូម លើក យក ប្រធានបទ ស្តីពី « បទល្មើស ចរាចរណ៍ ផ្លូវគោក » មក ធ្វើ ការបកស្រាយ ដូចត ទៅ៖
ក្រៅពី ទទួលខុសត្រូវ ចំពោះ សំណង រដ្ឋប្បវេណី ដល់ ជនរងគ្រោះ ឬ គ្រួសារ ជនរងគ្រោះ អ្នក បង្ក គ្រោះថ្នាក់ ចរាចរណ៍ នឹង ត្រូវ ប្រឈមមុខ នឹង ការផ្តន្ទាទោស តាម បញ្ញត្តិ នៃ បទល្មើស ចរាចរណ៍ ដែល មាន ចែង ក្នុង ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ថ្មី ឆ្នាំ ២០១៥ ។ បទល្មើស ចរាចរណ៍ អាច ជា បទល្មើស លហុ ដោយ ត្រូវ ពិន័យ ជា ប្រាក់ ឬ ជាប់ ពន្ធ ធនាគារ មិន លើស ពី ០៦ ( ប្រាំមួយ ) ថ្ងៃ ឬ អាច ជា បទល្មើស មជ្ឈឹម អាស្រ័យ ទៅ លើ រូបភាព នៃ បទល្មើស ចរចារណ៍ ដែល កើតមាន និង ព្យ សនកម្ម ដែល កើតមាន ពី បទល្មើស នោះ ។
រីឯ បទល្មើស ចរាចរណ៍ ផ្លូវគោក ដែល ត្រូវ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ឬ / និង ពិន័យ ជា ប្រាក់ ដូច មាន ចែង ក្នុង មាត្រា ៦៩ ដល់ មាត្រា ៩០ នៃ ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ឆ្នាំ ២០១៥ ប្រសិនបើ ស្ថិត នៅក្រោម លក្ខខណ្ឌ ដូច ខាងក្រោម នេះ៖
* ករណី ជន ដែល រារាំង ការឃាត់ យានយន្ត ឬ មិន ព្រម បញ្ឈប់ យានយន្ត ឬ ប្រកែក មិន ព្រម ដាក់ ខ្លួន ឲ្យ ធ្វើតេស្ដ ពិនិត្យ ជាតិ អាល់កុល ឬ គ្រឿងញៀន ជន នោះ ត្រូវ ផ្តន្ទាទោស ពន្ធនាគារ ដូច ករណី បើកបរ ដោយ គ្មាន ប័ណ្ណ បើកបរ ខាងលើ ដែរ ។
* ករណី បង្កឲ្យ អ្នកដទៃ មាន របួស បណ្ដាលឲ្យ ពិការ ជា អចិន្ត្រៃយ៍ ត្រូវ ផ្ដន្ទាទោស ពន្ធនាគារ ពី ១ ឆ្នាំ ទៅ ៣ ឆ្នាំ ឬ / និង ពិន័យ ជា សាច់ប្រាក់ ពី ២.០០០.០០០ រៀល ទៅ ៦.០០០.០០០ រៀល និង ត្រូវ ផ្ដទ្ទា ទោស ដល់ កម្រិត អតិបរមា ករណី អ្នកបើកបរ យានយន្ត ដោយ គ្មាន ប័ណ្ណ . ស្ថិត ក្នុង ស្ថានភាព ស្រវឹង . បណ្ដាលឲ្យ មាន របួស ដល់ មនុស្ស ច្រើន និង រត់គេចខ្លួន ពី កន្លែង កើត ហេតុ ក្នុង គោលបំណង គេចវេស ពី ការទទួលខុសត្រូវ ។
* ករណី អាណាព្យាបាល ដែល បណ្ដោយ ឲ្យ ក្មេង ដើរ រហេត រហូត លើ ផ្លូវថ្នល់ បណ្ដាលឲ្យ មាន គ្រោះថ្នាក់ នឹង ត្រូវ ទទួលខុសត្រូវ ផ្នែក រដ្ឋប្បវេណី និង ដូចគ្នា ដែរ ចំពោះ ម្ចាស់ សត្វ ដែល បណ្ដាលឲ្យ សត្វ ចិញ្ចឹម របស់ ខ្លួន ដើរ ពេញ ផ្លូវ ។
សូម បញ្ជាក់ ថា បទល្មើស ចរាចរណ៍ ជា បទល្មើស ព្រហ្មទណ្ឌ ហេតុ ដូច្នេះ ការសង សំណង រដ្ឋប្បវេណី ដល់ ជនរងគ្រោះ ឬ សាច់ញាតិ ជនរងគ្រោះ មិន មែន ជា មូលហេតុ នៃ ការរំលត់ បណ្តឹង អាជ្ញា ទេ ហើយ សំណុំរឿង បទល្មើស ចរាចរណ៍ នឹង ត្រូវ ដំណើរការ តាម នីតិវីធី ព្រហ្មទណ្ឌ ជាធរមាន ។
ចំណែក លោក ផូង វណ្ណ អនុប្រធាន សាលាដំបូង ខេត្ត កណ្ដាល ទៅជា អនុប្រធាន សាលាដំបូង ខេត្ត កំពង់ធំ ៕
នគរបាល ខណ្ឌ ឫស្សីកែវ បន្ដ បង្ក្រាប ក្រុម ប្រើប្រាស់ រក្សាទុក ជួញដូរ ថ្នាំ ញៀន និង ប៉ុនប៉ង លួច ទ្រព្យសម្បត្តិ ចំនួន ៦នាក់
( ភ្នំពេញ ) ៖ ក្រុម ជនសង្ស័យ ប្រើប្រាស់ រក្សាទុក ជួញដូរ ថ្នាំ ញៀន និង ប៉ុនប៉ង លួច ទ្រព្យសម្បត្តិ ពលរដ្ឋ សរុប ចំនួន ៦នាក់ ត្រូវបាន កម្លាំង នគរបាល ខណ្ឌ ឫស្សីកែវ ដែល ស្ថិត ក្រោម ការដឹកនាំ បញ្ជា ផ្ទាល់ ពី លោក វរសេនីយ៍ ឯក គល់ យី អធិការ ខណ្ឌ បាន ដេញ តាម ស្រាវជ្រាវ បង្ក្រាប បាន ជាក់ស្ដែង ជា បន្តបន្ទាប់ ក្នុង ៣ គោលដៅ និង ៣ករណី ផ្សេង គ្នា ដកហូត បាន វត្ថុតាង ពាក់ព័ន្ធ សកម្មភាព មួយចំនួន ។
ទោះបី យ៉ាងណា បើ តាម លោក អធិការ ដដែល រូប នេះ ក្រោយពី បង្ក្រាប ជនសង្ស័យ ទាំង ៦នាក់ ក្នុង ៣ គោលដៅ និង ៣ករណី ផ្សេង គ្នា រួម ជាមួយ វត្ថុតាង ពាក់ព័ន្ធ បាន និង កំពុង ស្ថិត ក្រោម ការឃុំ ខ្លួន សាកសួរ និង កសាង សំណុំរឿង នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ ដើម្បី បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម និតិវិធី ៕ ព័ត៌មាន សំខាន់ ៗ ចំនួន ១០ប្រចាំ សប្តាហ៍ សម្រាប់ ថ្ងៃអាទិត្យ ទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ
៣៖ រាជ រដ្ឋាភិបាល កម្ពុជា គ្រោង ចំណាយ ថវិកា ប្រហាក់ប្រហែល៦. ៧ពាន់ លាន ដុល្លារ សម្រាប់ វិស័យ រដ្ឋទូទៅ ក្នុង ឆ្នាំ ២០១៩ កើនឡើង ១១. ៤% ( ចុច អាន )
៦៖ ព័ត៌មាន លម្អិត ជុំវិញ បេសកកម្ម របស់ សម្តេច តេជោ ហ៊ុន សែន នៅ ប្រទេស ស្វីស ដើម្បី ចូលរួម « សន្និសីទ អង្គការ សហ ប្រជាជាតិ ស្តីពី ពាណិជ្ជកម្ម និង ការអភិវឌ្ឍ នៃ វេទិកា វិនិយោគ ពិភពលោក ឆ្នាំ ២០១៨ » ( ចុច អាន )
១០៖ ព័ត៌មាន លម្អិត អំពី ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ ហ៊ុន សែន រយៈពេល ៣ ថ្ងៃ នៅ ប្រទេស តួកគី ( ចុច អាន )
បើ តាម ការបញ្ជាក់ ពី អាជ្ញាធរ អាមេរិក នា ពេល នោះ ជន ដៃ ដល់ មាន កាំភ្លើង រះ មួយ ដើម និង ការភ្លើង ខ្លី យ៉ាងតិច ០៣ ដើម ។ ប៉ុន្មាន ម៉ោង ក្រោយពេល កើត ហេតុ តាមរយៈ ការបង្រ្កាប ពី កម្លាំង ប៉ូលិស ខ្មាន់ កាំភ្លើង រូប នោះ ក៏ ត្រូវ ឃាត់ខ្លួន បាន ។ មូលហេតុ នៅ ពីក្រោយ សកម្មភាព បាញ់ប្រហារ នេះ គឺជា ដោយសារ ការស្អប់ខ្ពើម ប្រកាន់ ពូជសាសន៍ លើ ជនជាតិ ជ្វីប ។ ចំណែក ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ក៏ បាន ចេញមុខ ថ្កោល ទោស ធ្ងន់ ៗ ចំពោះ ទង្វើ ខ្មៅ ងងឹត នេះ ផងដែរ ៕
លោក ស្តើង សុខុម និង ឧកញ៉ា ហេង ឡុង ដង្ហែ បច្ច័យ អង្គក ឋិន ទាន របស់ សម្តេច ក្រឡាហោម ស ខេង ទៅកាន់ វត្ត ចំនួន ២ ក្នុង ស្រុក កំចាយ មារ
( ព្រៃវែង ) ៖ លោក ស្តើង សុខុម ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក កំជាយ មារ និង លោក ឧកញ៉ា ហេង ឡុង ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ស្មោង ត្បូង ស្រុក កំជាយ មារ បាន អញ្ជើញ ដង្ហែ បច្ច័យ អង្គក ឋិន ទាន សម្តេច ក្រឡាហោម ស ខេង និង លោកស្រី ទៅ ប្រគេន ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា អស់ ត្រី មាស ក្នុង វត្ត ចំនួន ២ នៅ ឃុំ ស្មោង ត្បូង ដែល មាន វត្ត ឧត្តម ព្រៃ ធំ និង វត្ត ស្មោង នៅ ព្រឹក ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៨ ។
លោក ស្តើង សុខុម ក្នុង នាម ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក កំចាយ មារ បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច ក្រឡាហោម ស ខេង និង ក្រុមគ្រួសារ ដែល មាន ទឹកចិត្ត ជ្រះថ្លា ខាង ព្រះពុទ្ធ សាសនា ដោយ បាន ផ្តួចផ្តើម រៀបចំ អង្គក ឋិន ទាន ដង្ហែ មក ប្រគេន ព្រះសង្ឃ នៅក្នុង ឃុំ ស្មោង ត្បូង ដើម្បី បន្ត កសាង នូវ សមិទ្ធផល ខាង វិស័យ ពុទ្ធ ចក្រ ឲ្យ មាន លក្ខណៈ សមរម្យ សម្រាប់ ពុទ្ធ សាសនិក គោរព ប្រតិបត្តិ ទៅ តាម ព្រះពុទ្ធ សាសនា ។
ចំណុច នេះ បងប្អូន ធ្លាប់ បាន ឃើញ រួច មកហើយ នៅក្នុង អតីតកាល ពេល ដែល ប្រទេសជាតិ កើត សង្គ្រាម នៅ ពេល នោះ សាសនា ក៏ ត្រូវបាន បំផ្លាញ ទៅ ជាមួយគ្នា តាមរយៈ ការទម្លាក់ គ្រាប់បែក គ្រាប់ ប្លោង ។ នៅក្នុង របប ប៉ុល ពត សាសនា ទាំងអស់ ត្រូវបាន បំផ្លាញ វត្ត អារាម ត្រូវបាន គេ យក ធ្វើជា គុក ឬ កន្លែង សម្លាប់ មនុស្ស ដូច្នេះ ការរីកចម្រើន នៃ វិស័យ ពុទ្ធ ចក្រវា ទាក់ទង ជាមួយ តួនាទី នៃ ការដឹកនាំ រដ្ឋ អំពី ការកំណត់ គោល នយោបាយ ទាក់ទង ជាមួយ វិស័យ សាសនា ផងដែរ ។
លោក បន្ត ថា ប្រសិនបើ គណបក្ស ប្រជាជន មិន បាន យកចិត្តទុកដាក់ ថែទាំ និង លើកស្ទួយ វិស័យ ព្រះពុទ្ធ សាសនា នេះ ទេ សួរ ថា តើ ព្រះពុទ្ធ សាសនា របស់ យើង អាច រីកចម្រើន រហូត ទៅដល់ កម្រិត នេះ ទេ ? ។ ក្របខណ្ឌ ទំនាក់ទំនង រវាង ពុទ្ធ ចក្រ និង អាណាចក្រ អាច និយាយ បាន ថា ខាង វិស័យ ពុទ្ធ ចក្រ គឺ ការគ្រប់គ្រង រដ្ឋ ក៏ បាន ទទួល មកវិញ នូវ ផ្លែ ផ្កា អំពី បញ្ហា ការចូលរួមចំណែក របស់ ព្រះពុទ្ធ សាសនា ដែល បាន ចូលរួមចំណែក ដើម្បី គ្រប់គ្រង ទៅដល់ សង្គម តាម ការប្រៀន ប្រដៅ ធ្វើឲ្យ មនុស្ស ប្រព្រឹត្ត អំពើ ល្អ ជាដើម ។
លោក ស្តើង សុខុម និង លោក ឧកញ៉ា ហេង ឡុង បាន ប្តេជ្ញា ថា នឹង បន្ត ការខិតខំ ជួយ អភិវឌ្ឍ ឃុំ ស្មោង ត្បូង បន្ត ទៀត ទាំង វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ ដើម្បី ជា ការតបស្នង ចំពោះ ប្រជាជន ដែល បាន ផ្តល់ ការទុកចិត្ត មក លើ គណបក្ស ប្រជាជន កម្ពុជា និង បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា នា ពេល កន្លងមក ហើយ ការផ្តល់ ការគាំទ្រ នេះ បាន លើកទឹកចិត្ត ដល់ មន្រ្តី គណបក្ស ប្រជាជន កម្ពុជា កាន់តែ មាន ទឹកចិត្ត ជួយ ដល់ បងប្អូន បន្ត ទៀត ។
នៅក្នុង ពិធី នោះ លោក ស្តើង សុខុម និង លោក ហេង ឡុង ក៏ បាន ចែកជូន នូវ អំណោយ និង ថវិកា របស់ សម្តេច ក្រឡាហោម ស ខេង ជូន ដល់ លោកតា លោកយាយ និង គ្រួសារ ទី ទាល់ ក្រមួយចំនួន នៅក្នុង ឃុំ ស្មោង ត្បូង ផងដែរ ។
សូម បើកបរ ដោយ ការទទួលខុសត្រូវ ! ស្លាប់ ម្នាក់ និង របួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៧ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ម្នាក់ . របួស ស្រាល ៤នាក់ និង របួស ធ្ងន់ ៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៥លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៤គ្រឿង . រថយន្ត តូច ៤គ្រឿង . រថយន្ដ ធំ១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ស្រវឹង . បត់ គ្រោះថ្នាក់ . ប្រជែង . មិន គោរព សិទ្ធិ និង ងងុយដេក ។
សូម បញ្ជាក់ ថា រយៈពេល ២៧ ថ្ងៃ ចាប់ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ២៧៦ លើក បណ្ដា ឲ្យ មនុស្ស ស្លាប់ ចំនួន ១៥២ នាក់ . របួស ធ្ងន់ ៣០០ នាក់ និង របួស ស្រាល ១៣៦ នាក់ ៕ ស្ថានីយ ចម្រោះ ទឹក កខ្វក់ នៅ ខេត្ត ព្រះសីហនុ នឹង បញ្ចប់ ការស្ដារ ឡើងវិញ នៅ ចុង ឆ្នាំ នេះ ហើយ មាន សមត្ថភាព ចម្រោះ រហូត២ម៉ឺន ម៉ែត្រ គូប ក្នុង មួយ ថ្ងៃ
( ព្រះសីហនុ) ៖ លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ដ្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ គណៈប្រតិភូ ចុះ ពិនិត្យ ការដ្ឋាន ស្តារ ភក់ ក្នុង អាង ប្រព្រឹត្តកម្ម នៅ ស្ថានីយ ចម្រោះ ទឹក កខ្វក់ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ដែល អនុវត្ត ដោយ ក្រុមហ៊ុន BUGC ហើយ គ្រោង នឹង បញ្ចប់ នៅ ចុង ឆ្នាំ ២០១៨ នេះ ។
ស្ថានីយ អាង ចម្រោះ ទឹក កខ្វក់ នេះ ត្រូវបាន សាងសង់ លើ ផ្ទៃដី ទំហំ ១៦.២ហិតា មាន សមត្ថភាព សំអាត ប្រមាណ ៦.៩០០ ម៉ែត្រ គូប ក្នុង មួយ ថ្ងៃ ប៉ុន្ដែ ដោយសារ ការប្រើប្រាស់ ចាប់ពី ឆ្នាំ ២០០៦ មកដល់ បច្ចុប្បន្ន បាន ធ្វើឲ្យ ស្ថាន នីយ ចម្រោះ មួយ នេះ មាន កំណក ភក់ នៅ បាត អាង បណ្តាលឲ្យ សមត្ថភាព សំអាត ទឹក កខ្វក់ របស់ ស្ថានីយ៍ មួយ នេះ ត្រូវបាន ថយចុះ ជា បន្តបន្ទាប់ ។
ដោយ មើលឃើញ ពី សារសំខាន់ នៃ ស្ថានីយ នេះ លោក ទេស មន្ត្រី ស៊ុន ចាន់ថុល បាន កំពុង ធ្វើការ យកចិត្តទុកដាក់ ខ្ពស់ ដើម្បី ជំរុញ ឲ្យ ការស្តារ អាង មួយ នេះ បាន ចប់ រួចរាល់ នៅ ចុង ឆ្នាំ ២០១៨ ដោយ បន្ថែម ឧបករណ៍ បច្ចេកទេស បន្ថែម និង អនុវត្ត ឲ្យបាន តាម បទដ្ឋាន បច្ចេកទេស កំណត់ ដែល នឹង ធ្វើឲ្យ មាន សមត្ថភាព សំអាត ដូច ដើម ឡើងវិញ ។
ប៉ុន្ដែ អ្វី ដែល កាន់តែ ប្រសើរ ជាង នេះ ក្រោម ការដឹកនាំ របស់ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល . ក្រុមហ៊ុន BUCG បាន និង កំពុង សិក្សា ប្លង់ មេ បឋម ពង្រីក សមត្ថភាព អាង ចម្រោះ ទឹក កខ្វក់ ក្នុង ខេត្ត ទេសចរណ៍ មួយ នេះ ។
កាន់តែ អស្ចារ្យ ! ខាន់ ចេសា ដណ្ដើម បាន មេដាយ មាស កម្រិត ពិភពលោក ២គ្រឿង នៅ អាមេរិក
លោក Peter Khan ឪពុក កញ្ញា ខាន់ ចេសា បាន រៀបរាប់ប្រាប់ មន្ដ្រី គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា ពី សហរដ្ឋ អាមេរិក ថា កូនស្រី របស់ ខ្លួន បាន ចូលរួម ប្រកួត ក្នុង ព្រឹត្តិការណ៍ កម្រិត ពិភពលោក ខាងលើ កាលពី ចុង សប្ដាហ៍ កន្លងទៅ លើ វិញ្ញាសា ប្រយុទ្ធ ទម្ងន់ ៤៩ គីឡូក្រាម ខណៈ មាន ជើង ខ្លាំង មកពី ជុំវិញ ពិភពលោក ចូលរួម ។ ក្នុង ការប្រកួត ចេសា ធ្វើ បាន យ៉ាង ល្អ ដោយ យកឈ្នះ លើ គូ ប្រជែង ជា បន្ដ បន្ទាប់ រហូតដណ្ដើម បាន មេដាយ មាស ២គ្រឿង តែម្ដង ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ . របួស ស្រាល ៣នាក់ និង របួស ធ្ងន់ ១៤នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង១០លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១០គ្រឿង . រថយន្ត តូច ២គ្រឿង . រថយន្ដ ធំ ៧គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្បឿន . មិន ប្រកាន់ ស្ដាំ និង មិន គោរព សិទ្ធ ។
សូម បញ្ជាក់ ថា រយៈពេល ២៨ ថ្ងៃ ចាប់ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ២៨៦ លើក បណ្ដា ឲ្យ មនុស្ស ស្លាប់ ចំនួន ១៥៥ នាក់ . របួស ធ្ងន់ ៣១៤ នាក់ និង របួស ស្រាល ១៣៩ នាក់ ៕ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ ក្នុង ឱកាស ខួប ១៤ ឆ្នាំ នៃ ការយាង គ្រងរាជសម្បត្តិ
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ការពារ ជាតិ បាន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ឱកាស ខួប លើក ទី ១៤ នៃ ការយាង គ្រងរាជសម្បត្តិ របស់ ព្រះអង្គ ។
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ថ្វាយ ព្រះពរ ព្រះមហាក្ស ត្រ៖
អ្នកជំនាញ អារ្យធម៌ ខ្មែរ៖ តើ ជនជាតិ ចិន ដែល មក រកស៊ី ស្រុក ខ្មែរ ជា ការឈ្លាន មែន ទេ ?
ដោយ លោក រត្ន័ សណ្ដាប់ បាន ថ្លែង ទាត់ ចោល យ៉ាង ដូច្នេះ ថា « បើ និយាយ ពី ការឈ្លានពាន គឺ ទាល់តែ កងទ័ព បរទេស មួយ បញ្ជួន ចូលមក លុកលុយ ប្រទេស មួយ ទើប ជា ការឈ្លានពាន » ។ ពីព្រោះថា បើ និយាយ ពី អ្នកទេសចរណ៍ ឬ អ្នកវិនិយោគ ឬ អ្នករកស៊ី ក្ដី គឺ ពុំ មែន ជា អ្នក ឈ្លានពាន នោះ ទេ ។
ថ្លែង នៅក្នុង កិច្ចសម្ភាសន៍ ដដែល នោះ លោក រត្ន័ សណ្ដាប់ បាន ថ្លែង បន្ដ ថា ស្ថិត ក្នុង បរិការ នេះ ផងដែរ បើ យើង រំឭក អំពី សាវតារ ជនជាតិ ចិន ដែល ចេញ ទៅ វិនិយោគ ឬ រកស៊ី នៅ តាម បណ្ដា ប្រទេស នានា ពាសពេញ ពិភពលោក ពិសេស នៅ សហរដ្ឋ អាមេរិក ឬ អ៊ឺរ៉ុប កាលពី ទសវត្សរិ៍ មុន នេះ ក៏ យើង ឃើញ ជនជាតិ ពួក ស្បែក ស នៅ តាម បណ្ដា ប្រទេស ទំាង នេះ ក៏ មាន ទស្សនជាតិ និយម មិន ខុសពី កម្ពុជា យើង បច្ចុប្បន្ន នេះ ដែរ ។ ដោយ ក្នុង នោះ៖
ទី មួយ៖ គេ យល់ ថា ចំពោះ ជនជាតិ ចិន ដែល មក វិនិយោគ ឬ រកស៊ី ក្នុង ប្រទេស គេ យ៉ាង ច្រើន នេះ គឺជា ការឈ្លាន ឬ ដណ្ដើម ការងារ ធ្វើឲ្យ បាត់បង់ ដល់ ផលប្រយោជន៍ ឬ ប៉ះពាល់ ប្រពៃណី មុខរបររកស៊ី របស់ ពួកគេ ។
មុននឹង បញ្ចប់ កិច្ចសម្ភាសន៍ លោក រ័ត្ន សណ្តាប់ ថ្លែង ជាមួយ សម្តី ធ្ងន់ ៗ ថា ចំពោះ ទង្វើ នៃ សកម្មភាព ខុស ច្បាប់ ទាំងឡាយ របស់ ជនជាតិ ចិន ឬ ជន បរទេស ដែល ប្រព្រឹត្តិ នៅ ទឹកដី កម្ពុជា ដូចជា ជួញដូរ ខុស ច្បាប់ . វាយតប់ គ្នា អាណាធិបតេយ្យ បង តូច បង ធំ ផឹក ស្រវឹង បើកបរបង្ក គ្រោះថ្នាក់ នៅ តាម ទី សាធារណៈ និង ប៉ះពាល់ ដល់ អ្នកដទៃ .. . និង សកម្មភាព ខុស ច្បាប់ ផ្សេង ៗ ត្រូវតែ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ របស់ កម្ពុជា ជាធរមាន ៕
សហគ្រាស ផលិត ឱសថ ជា ចំណាន ជា សហគ្រាស តែ មួយ គត់ របស់ កម្ពុជា ដែល ទទួលបាន ពានរង្វាន់ មាស អឺរ៉ុប សម្រាប់ គុណភាព
ការទទួលបាន ពានរង្វាន់ មាស នេះ ដោយសារ សហគ្រាស ផលិត ឱសថ ជា ចំណាន ផលិត ឱសថមាន គុណភាព ខ្ពស់ និង អនាម័យ ល្អ ក្នុង កម្រិត ស្តង់ដារ បច្ចេកទេស GMP ទទួលស្គាល់ ដោយ ក្រសួង សុខាភិបាល ថែមទាំង មាន សេវា ចែកចាយ ល្អ ទូទាំង ប្រទេស កម្ពុជា ។
ដើម្បី ទទួលបាន នូវ វិញ្ញាបនប័ត្រ និង ពានរង្វាន់ មាស អឺរ៉ុប សម្រាប់ គុណភាព នេះ ក្រុមហ៊ុន និង សហគ្រាស ផលិត ឱសថ ត្រូវ មាន លក្ខណៈ សម្បត្តិ គ្រប់គ្រាន់ ដោយ ឆ្លងកាត់ ការពិនិត្យ និង វាយតំលៃ ប្រកបដោយ ភាពត្រឹមត្រូវ និង តម្លាភាព ពី គណៈកម្មការ អន្តរជាតិ នៅ ទីក្រុង ប៉ារីស ប្រទេស បារាំង ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៦.៨១២ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៩៨៨ គ្រឿង ( ម៉ូតូ ៨០ %) អប់រំ១៣៣ គ្រឿង និង ផាក ពិន័យ ៨៥៥ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៨ ខែតុលា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ៣. ៨១២ គ្រឿង . អប់រំ១៤២ គ្រឿង និង ផាក ពិន័យ ១. ១៩៨ គ្រឿង ។
សម្រាប់ លទ្ធផល នៃ ការត្រួតពិនិត្យ រយៈពេល ២៨ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ២៨ ខែតុលា នេះ នគរបាល បាន ត្រួតពិនិត្យ យានយន្ត ចំនួន ១២៥ .២៨៧ គ្រឿង រកឃើញ យានយន្ត ល្មើស ២៤.១៥៣ គ្រឿង ( ម៉ូតូ ៨១ %) ក្នុង នោះ អប់រំ ៥.៩៦៥ គ្រឿង និង ផាក ពិន័យ ១៨. ៣៨៦ គ្រឿង ៕ គណៈប្រតិភូ កាកបាទ ក្រហម កម្ពុជា ចូលរួម គោរព វិញ្ញាណក្ខន្ធ សព មហា ឧបាសក សាយ គឹម ស៊ាន បង ប្រុស បង្កើត របស់ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ
ពិធី បុណ្យ សព បាន ប្រព្រឹត្តទៅ នៅ វត្ត បទុមវត្តី ដែល ស្ថិត នៅក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ។
ស្ថិត ក្នុង សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សហការី កាកបាទ ក្រហម កម្ពុជា សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជាមួយ ក្រុមគ្រួសារ សព និង សូម ឧទ្ទិស បួងសួង សូម ឱ្យ ដួង វិញ្ញាណក្ខន្ធ សព មហា ឧបាសក សាយ គឹម ស៊ាន បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ជាមួយគ្នា នេះ កាកបាទ ក្រហម កម្ពុជា បាន នាំយក បច្ច័យ ចំនួន ១០លាន រៀល ទៅ ចូល បុណ្យ សព ផងដែរ ៕
សម្រាប់ មូលហេតុ នៅ ពីក្រោយ ការបដិសេធ ខាងលើ គឺ ត្រូវបាន រដ្ឋបាល លោក ត្រាំ អះអាង ថា ដោយសារតែ រូប លោក មាន បញ្ហា បន្ទាន់ ដទៃ ទៀត ដែល អាក់ខាន មិន បាន ចំ ថ្ងៃ តែ មួយ ដោយ លោក ប្រធានាធិបតី អាមេរិក នឹង ត្រូវ ធ្វើការ ថ្លែង សុន្ទរកថា ប្រចាំ ឆ្នាំ នៅ ចំពោះមុខ សភា អាមេរិក ។
គួរ ជម្រាប ថា កាលពី អំឡុង ទស្សនកិច្ច របស់ ប្រធានាធិបតី រុស្ស៉ី លោក វ៉្លាឌីមៀ ពូទីន ក្នុង ខែតុលា នេះ ឥណ្ឌា បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ទិញ យក ប្រព័ន្ធ មីស៉ីល S-400 ចំនួន ០៥ គ្រឿង ទោះបីជា បាន រង ការព្រមាន ពី សហរដ្ឋ អាមេរិក ក៏ដោយ ។ ក្រៅពី នេះ ទោះបីជា រដ្ឋបាល លោក ដូណាល់ ត្រាំ កន្លងមក បាន គំរាម ដាក់ទណ្ឌកម្ម ឥណ្ឌា យ៉ាងណា ក្តី ទីក្រុង ញូដេលី នៅតែ បន្ត នាំចូល ប្រេង ពី អ៉ីរ៉ង់ ៕
លោក រដ្ឋមន្ត្រី បាន បង្ហាញ ការជឿជាក់ ថា មជ្ឈមណ្ឌល អប់រំ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ឡាន ឆាង - មេគង្គ នេះ និង រោង ជាង កម្ពុជា លូន បាន នឹង ដើរ តួនាទី ជា សសរ ស្តម្ភ មួយ ក្នុង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ មិត្តភាព និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម ក្នុង តំបន់ ទាំងមូល ស្រប តាម ពាក្យស្លោក សហគមន៍ ដែល មាន ជោគវាសនា រួម ។
លោក បាន បញ្ជាក់ ថា បើ យើង សាកល្បង សម្លឹងមើល អំពី សាវតា នៃ ការអភិវឌ្ឍ គម្រោង សាងសង់ មជ្ឈមណ្ឌល នេះ គឺ មាន កិច្ចប្រឹងប្រែង និង ចូលរួម ពី តួអង្គ ពាក់ព័ន្ធ ជាច្រើន ដែល ធ្វើឱ្យ គម្រោង អាច ដាក់ ឱ្យ ដំណើរការបាន ជា ផ្លូវការ នា ពេលនេះ រួមទាំង ការកសាង និង បំពាក់ សម្ភារៈ បរិក្ខារ ក្នុង អគារ មជ្ឈមណ្ឌល ដ៏ ស្រស់ ត្រកាល មួយ នេះ ផងដែរ ។
លើ កម្រិត នយោបាយ គម្រោង នេះ បាន ផុស ឡើង តាមរយៈ ការផ្គួប គ្នា រវាង សេចក្តីផ្តើម គំនិត វិថី មួយ ខ្សែក្រវ៉ាត់ មួយ របស់ សាធារណរដ្ឋ ប្រជាមានិត ចិន ជាមួយនឹង កិច្ចប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច កម្ពុជា ប្រកបដោយ ចីរភាព ។
កាលពី ឆ្នាំ ២០១៣ កន្លងមក ប្រធានាធិបតី ចិន លោក ស៊ី ជិន ពីង បាន លើកឡើង អំពី គំនិត ជោគវាសនា រួម និង អនាគត ថ្មី សម្រាប់ សហគមន៍ អាស៊ី នៅក្នុង ទស្សនកិច្ច ផ្លូវ រដ្ឋ និង សន្និសីទ ថ្នាក់ កំពូល ជាច្រើន ។
នៅក្នុង កិច្ចប្រជុំ លើក ទី មួយ ថ្នាក់ដឹកនាំ ប្រទេស នៃ កិច្ចសហប្រតិបត្តិការ ឡាន ឆាង - មេគង្គ នៅ ខែមីនា ឆ្នាំ ២០១៦ នាយក រដ្ឋមន្ត្រី ចិន លោក លី ខឺ ឈាង បាន លើកឡើង អំពី គំនិត នៃ ការកសាង មជ្ឈមណ្ឌល អប់រំ បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ប្រទេស ឡាន ឆាង - មេគង្គ ។
មជ្ឈមណ្ឌល នេះ នឹង ដើរ តួនាទី ដ៏ សំខាន់ ក្នុង វិស័យ អប់រំ បណ្តុះបណ្តាល - បច្ចេកទេស និង វិជ្ជាជីវៈ និង ការផ្ទេរ នូវ បច្ចេកវិទ្យា ទំនើប ឈាន មុខ គេ ដល់ យុវជន កម្ពុជា ដែល នឹង ចូលរួម បង្កើន នូវ ផលិតភាព ការងារ និង សមត្ថភាព រក ប្រាក់ ចំណូល របស់ ពួកគេ ព្រមទាំង ចូលរួម ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម កម្ពុជា ផងដែរ ។
តាម ផែនការ ដែល បាន គ្រោង ទុក បន្ទាប់ពី ការដាក់ ឱ្យ ដំណើរការ ជា ផ្លូវការ មជ្ឈមណ្ឌល គ្រោង នឹង ជ្រើសរើស សិស្ស - និស្សិត ពី បណ្តា ប្រទេស អនុ តំបន់ ទន្លេ មេគង្គ មក សិក្សា នៅ ទីនេះ ផងដែរ ៕
សាកលវិទ្យាល័យ ន័រតុន ប្រគល់ មេដាយ ជូន ដល់ និស្សិត ផ្នែក ស្ថាបត្យកម្ម ជាង ៤០ រូប ដែល ទទួល ជយលាភី នៃ ការប្រកួត ស្នាដៃ និស្សិត
ពិធី ប្រគល់ មេដាយ ជូន ដល់ និស្សិត ៤១ នាក់ សរុប មាន ១៤ គម្រោង នេះ ធ្វើឡើង នា ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៨ និង រៀបចំ ដោយ សាកលវិល័ទ្យាល័យ « ន័រតុន » ដែល មាន ការចូលរួម ពី លោក ម៉ម សូផាណា អនុ រដ្ឋលេខាធិការ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ . លោកស្រី សូរ សុគន្ធារី ប្រធាន កិត្តិយស ផ្នែក ស្ថាបត្យកម្ម និង នគរូបនីយវិទ្យា នៃ សាកលវិល័ទ្យាល័យ ន័រតុន . លោក បណ្ឌិត លឹម សុខ តៃ ព្រឹទ្ធ បុរស មហាវិទ្យាល័យ វិទ្យាសាស្ដ្រ រួម និង លោកគ្រូ - អ្នកគ្រូ ព្រមទាំង និស្សិត ជាច្រើន នាក់ ផងដែរ ។
នា ឱកាសន នោះ លោក ម៉ម សូផាណា បាន លើកឡើង ថា « ថ្ងៃ នេះ ខ្ញុំ មាន កត្តិយស យ៉ាង ខ្លាំង ណាស់ ដែល បាន ធ្វើជា អធិបតីភាព នៅក្នុង កម្មវិធី ប្រគល់ មេដាយ និង លិខិត សើរ ដល់ និស្សិត ទទួល ជយលាភី នេះ ហើយ ខ្ញុំ ក៏ ដែល សង្ឃឹម ថា នឹង មាន និស្សិត នៅ ស្រុក ខ្មែរ យើង នឹង ទទួលបាន មេដាយ នេះ ជា បន្ដ បន្ទាប់ ទៀត ផងដែរ » ។
លោក បន្ថែម ទៀត ថា « នៅក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ មក នេះ វិស័យ ស្ថាបត្យកម្ម និង សំណង់ នៅ កម្ពុជា មាន ការរីកចម្រើន យ៉ាង ខ្លាំង ដោយ សង្កេតឃើញ ថា មាន អគារ ខ្ពស់ ៗ ជាច្រើន ដែល បាន រីកដុះដាល ឡើង រួម ជាមួយ ការរចនា ម៉ូត យ៉ាង ល្អ ប្រណីត ទាន់សម័យ ក្នុង នោះ វិស័យ សម្ភារ សំណង់ ក៏ ត្រូវ ដើរតួរ យ៉ាង សំខាន់ ផងដែរ ព្រោះ អគារ រឹងមាំ គឺ អាស្រ័យ ទៅ លើ សម្ភារ សំណង់ ទាំងនោះ ជា សម្ភារ សំណង់ ដែល មាន គុណភាព និង ផ្តល់ សុវត្ថិភាព ពិត ប្រាកដ » ។
សាកលវិទ្យាល័យ « ន័រតុន » ត្រូវបាន មហាជន ទទួលស្គាល់ ថា ជា សាក វិទ្យាល័យ មួយ ដែល សម្ថភាព គ្រប់គ្រាន់ ក្នុង ការតម្រង់ ទិសដៅ ចំណេះ ជំនាញ ជូន ដល់ និស្សិត នៅ កម្ពុជា ហើយ ទាំងអស់ នេះ ជា ការលើកស្ទួយ មួយ សម្រាប់ វិស័យ អប់រំ នៅ កម្ពុជា ផងដែរ ៕
( ភ្នំពេញ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន ផ្លូវការ មួយ បង្ហាញ អំពី លទ្ធផល នៃ ការអញ្ជើញ ចូលរួម របស់ គណៈប្រតិភូ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង មហាសន្និបាត លើក ទី១០ នៃ សន្និសីទ អន្ដរជាតិ គណបក្ស នយោបាយ អាស៊ី ICAPP ដែល បាន ប្រព្រឹត្តិ ទៅ នៅ ទីក្រុង ម៉ូស្កូ ប្រទេស រុស្ស៊ី ចាប់ពី ថ្ងៃទី ២៤ - ២៧ ខែតុលា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ។
មហាសន្និបាត នេះ បាន ផ្ដោត ទៅ លើ ប្រធានបទ ធំ ៗ ចំនួន ២ រួម មាន ទី១៖ តួនាទី របស់ គណបក្ស នយោបាយ ក្នុង ការកាត់បន្ថយ ភាពតានតឹង អន្ដរជាតិ និង ការប្រយុទ្ធ ប្រឆាំង នឹង ភាពជ្រុលនិយម និង ទី ២៖សារសំខាន់ នៃ កិច្ចសហប្រតិបត្តិការ រវាង គណបក្ស នយោបាយ អាស៊ី ក្នុង ការបង្កើត និង អភិវឌ្ឍន៍ ចំណង នយោបាយ សេដ្ឋកិច្ច និង សង្គម រវាង រដ្ឋ និង រដ្ឋ ។
សូម ជម្រាប ថា លោកស្រី ឃួន សុដារី អនុប្រធាន គណៈកម្មាធិការ អចិន្ដ្រៃយ៍ ICAPP សហ ប្រធាន វេទិកា នយោបាយ អាស៊ី អឺរ៉ុប AEPF អនុប្រធាន ទី២ រដ្ឋសភា និង ជា សមាជិក គណៈកម្មាធិការ អចិន្ដ្រៃយ៍ នៃ គណបក្ស ប្រជាជន កម្ពុជា ត្រូវបាន ចាត់ ជា តំណាង CPP ដើម្បី ដឹកនាំ គណៈប្រតិភូ គណបក្ស ប្រជាជន កម្ពុជា ចូលរួម មហាសន្និបាត លើក ទី១០ របស់ ICAPP នា ពេលនេះ ៕
ខាងក្រោម នេះ ជា សេចក្ដីប្រកាស ព័ត៌មាន របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល ខ្លឹមសារ ទាំងស្រុង ដូចត ទៅ៖
អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច ចាត់ទុក ថា ការរិះគន់ របស់ មន្រ្តី សង្គម ស៊ីវិល ចំពោះ ការចាត់ចែង មន្រ្តី តុលាការ គឺជា ការប្រមាថ ព្រះចេស្តារ ព្រះមហាក្សត្រ យ៉ាង ជាក់ស្តែង (Video inside) ( ភ្នំពេញ ) ៖ លោក សុខ ឥសាន អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ប្រតិកម្ម ចំពោះ ការរិះគន់ របស់ មន្ត្រី ជាន់ ខ្ពស់ ផ្នែក ស៊ើបអង្កេត នៃ សមាគម អាដហុក (ADHOC) លោក សឺន សែន ករុណា ដែល បាន រិះគន់ ទៅ លើ ចំណាត់ការផ្ទេរ និង តែងតាំង មន្រ្តី ក្នុង ស្ថាប័ន តុលាការ ។
អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច រូប នេះ បាន ចាត់ទុក ថា ការរិះគន់ ចំពោះ ការចាត់ចែង តែងតាំង និង ផ្លាស់ប្ដូរ ព្រះរាជអាជ្ញា និង ព្រះរាជអាជ្ញា របស់ ស្ថាប័ន ឧត្តម ក្រុមប្រឹក្សា អង្គចៅក្រម របស់ មន្រ្តី សង្គម ស៊ីវិល រូប នេះ គឺជា ការប្រមាថ ព្រះចេស្តារ ព្រះមហាក្សត្រ យ៉ាង ជាក់ស្តែង ។
លោក សុខ ឥសាន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា៖ « នៅ ពេល ថ្មី ៗ នេះ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម បាន សម្រេច ដាក់ ឲ្យ ចូលនិវត្តន៍ និង តែងតាំង មន្ត្រី តុលាការ មួយចំនួន ។ ផ្អែក លើ ការសម្រេច នេះ មាន ជន នៅក្នុង អង្គការ សង្គម សុី វិល មួយចំនួន និយាយ ថា ការសម្រេច ដាក់ ឲ្យ ចូលនិវត្តន៍ និង តែងតាំង មន្ត្រី តុលាការ ទាំងនោះ មិន មាន តម្លាភាព ឡើយ ដោយសារ ពួកគេ មិន បាន ដឹង ដែល នាំឲ្យ មាន ការសង្ស័យ មួយចំនួន » ។
លោក បាន បន្ត ថា « ការសម្រេច របស់ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គវវ ចៅក្រម បាន ប្រព្រឹត្តទៅ ក្នុង អង្គប្រជុំ ក្រោម ព្រះរាជា ធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ អង្គ ព្រះមហាក្សត្រ ព្រះប្រធាន នៃ ឧត្តម ក្រុមប្រឹក្សា នៃ អង្គចៅក្រម ហេតុ អ្វី បានជា ថា គ្មាន តម្លាភាព ? ការនិយាយ បែប នេះ គឺជា ការប្រមាថ ព្រះចេស្តារ ព្រះមហាក្សត្រ យ៉ាង ជាក់ស្តែង » ។
ប្រតិកម្ម របស់ អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច បាន ធ្វើឡើង បន្ទាប់ពី លោក សឺន សែន ករុណា មន្ត្រី ជាន់ ខ្ពស់ ផ្នែក ស៊ើបអង្កេត នៃ សមាគម អាដហុក (ADHOC) បាន សម្តែង ការព្រួយបារម្ភ អំពី ប្រសិទ្ធភាព នៃ ការអនុវត្ត ច្បាប់ ព្រមទាំង សម្តែង មន្ទិល ក្នុង ការផ្ទេរ និង ដំឡើង តំណែង មន្ត្រី តុលាការ នា ថ្មី ៗ នេះ ។
លោក ស៊ឹង សែន ករុណា សង្កេតឃើញ ថា កន្លងមក អំណាច អយ្យការ នេះ មិន សូវ បាន ជួយ ដល់ អ្នកតស៊ូ មតិ ជាពិសេស សកម្មជន សិទ្ធិ មនុស្ស សកម្មជន បរិស្ថាន និង សកម្មជន ដីធ្លី នោះ ទេ ។ លោក ចង់ ឃើញ ព្រះរាជអាជ្ញា ដើរ តួនាទី សកម្ម ក្នុង ការការពារ ជន ដែល មាន មនសិការ ឈឺឆ្អាល កិច្ចការ សង្គម ទាំងនោះ ។ នេះ បើ តាម ការផ្សព្វផ្សាយ របស់ វិទ្យុ អាស៊ី សេរី ។
អាវុធហត្ថ រាជធានី ភ្នំពេញ ឃាត់ខ្លួន ជនសង្ស័យ ១៥នាក់ ពាក់ព័ន្ធ ករណី គ្រឿងញៀន
( ភ្នំពេញ ) ៖ កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ឃាត់ខ្លួន ជនសង្ស័យ ប្រុស ស្រី ១៥ នាក់ ពាក់ព័ន្ធ ករណី គ្រឿងញៀន និង ដកហូត បាន ក្រាម ពណ៌ ស ថ្លា ៣៣ កញ្ចប់ ( ប្រភេទ ម៉ា ទឹកកក ) នៅ ចំណុច ទីតាំង ៣ខណ្ឌ ផ្សេង គ្នា ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៨ ។
របាយការណ៍ របស់ មន្ដ្រីរាជអាវុធហត្ថ បាន ឲ្យដឹង ថា ជនសង្ស័យ ទី១៖ ឈ្មោះ សល់ ណារ៉ូ ហៅ កណ្តុរ អាយុ ១៧ឆ្នាំ . ទី ២៖ ឈ្មោះ យ៉េន តារ៉ា ហៅ យ៉ុម អាយុ ២៧ ឆ្នាំ ត្រូវ កម្លាំង ល្បាត មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ព្រែក ព្នៅ ឃាត់ខ្លួន បាន នៅ វេលា ម៉ោង ០៣៖០០ នាទី នៅ ចំណុច ផ្លូវ បេតុង ជាប់ បន្ទាយ ឡុង ឈិន ភូមិ ផ្សារ លិច សង្កាត់ ព្រែក ព្នៅ ខណ្ឌ ព្រែក ព្នៅ ។
ទី ១៤៖ ឈ្មោះ ធី ម ថា អាយុ ២៧ ឆ្នាំ និង ទី១៥៖ ឈ្មោះ គុយ កុល ត្រូវបាន កម្លាំង ល្បាត មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ជ្រោយ ចង្វារ ឃាត់ខ្លួន បាន នៅ ម៉ោង ១០៖០០ នាទី យប់ នៅ ចំណុច ភូមិ ព្រែក តា រ័ត្ន សង្កាត់ ព្រែក តា សេក ខណ្ឌ ជ្រោយ ចង្វារ ។
បច្ចុប្បន្ន ជនសង្ស័យ ប្រុស ស្រី ទាំង ១៥ នាក់ ខាងលើ ត្រូវបាន សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស គ្រឿងញៀន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ កំពុង ធ្វើ ការសួរចម្លើយ និង កសាង សុំ ណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម ច្បាប់ ៕
ពិធី ប្រណាំង ទូក នៅ ខេត្ត ស្វាយរៀង ចាប់ផ្តើម ហើយ នៅ ព្រឹក នេះ . មាន ៤៥ ទូក និង កីឡាករ ១. ១៣៥ នាក់ ចូលរួម ប្រកួតប្រជែង
( ស្វាយរៀង ) ៖ ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន រដ្ឋមន្ដ្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច នៅ ព្រឹក ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រណាំង ទូក ប្រពៃណី ខ្នាត អន្តរជាតិ និង ទូក ក្តារ បី សន្លឹក ឆ្នាំ ២០១៨ នៅ ទន្លេ វៃ គោ ក្រុង ស្វាយរៀង ។
ការប្រណាំង ទូក នេះ មាន ទូក ចូលរួម ប្រណាំង មកពី គ្រប់ រាជធានី ខេត្ត ចំនួន ៤៥ ទូក និង មាន កីឡាករ ចំនួន ១. ១៣៥ នាក់ ដើម្បី អបអរសាទរ ព្រះរាជ ពិជី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ដែល នឹង ចូល មកដល់ ថ្ងៃទី ២១ - ២២ - ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ ទន្លេ ចតុមុខ ខាងមុខ ព្រះបរម រាជ វាំង រាជធានី ភ្នំពេញ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ដ្រី ម៉ែន សំអន ក៏ បាន ផ្ដាំផ្ញើ ដល់ កីឡាករ កីឡាការិនី ទូក ទាំងអស់ ត្រូវ ចេះ រក្សា មិត្តភាព សាមគ្គីភាព សុខភាព ខិតខំ ប្រឹងប្រែង ឲ្យ អស់ ពី សមត្ថភាព ដើម្បី ទទួលបាន ជ័យជម្នះ ពី ការប្រកួត សម្រាប់ ជា កិត្តិយស ជូន ភូមិ ស្រុក ហើយ សូម គោរព ឲ្យបាន នូវ បទបញ្ជា និង លក្ខន្ដិកៈ នៃ ការប្រកួត ដែល កំណត់ ដោយ គណៈកម្មការរៀបចំ ពិធី ៕
កាំ កុងត្រូល ខេត្ត ស្វាយរៀង ចុះ ពិនិត្យ ទំនិញ នៅ ថ្ងៃ ប្រណាំង ទូក ក្នុង ខេត្ត ស្វាយរៀង ដើម្បី សុវត្ថិភាព ម្ហូប អាហារ
( ស្វាយរៀង ) ៖ ដើម្បី បង្ក លក្ខណៈ សប្បាយរីករាយ ដល់ ប្រជាពលរដ្ឋ ក្នុង ពិធី ប្រណាំង ទូក ក្នុង ខេត្ត ស្វាយរៀង និង ធានា បាន នូវ សុវត្តិភាព ម្ហូប អាហារ នោះ មន្ត្រី កាំ កុងត្រូល ខេត្ត ស្វាយរៀង ដឹកនាំ ដោយ លោក ផឹង និល ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត និង អាជ្ញាធរដែនដី ចុះ ពិនិត្យ ទំនិញ និង ម្ហូប អាហារ ភេជ្ជៈ ជា គ្រឿង កំប៉ុង ដែល ដាក់ លក់ តាម ស្តង់ អាហារដ្ឋាន នានា នៅ ក្រុង ស្វាយរៀង ។
ប្រធាន សាខា កាំ កុងត្រូល រូប នេះ បាន បញ្ជាក់ ថា បើ ប្រជាពលរដ្ឋ ណា មាន ការសង្ស័យ ថា ម្ហូប អាហារ ដែល ដាក់តាំង លក់ នៅក្នុង ឱកាស ពិធី ប្រណាំង ទូក មាន ផ្ទុក សារធាតុ គីមី ត្រូវ រាយការណ៍ មក មន្ត្រី របស់ លោក លោក ចាត់ មន្ត្រី ចុះ ពិនិត្យ ភ្លាម ៗ គឺ ធ្វើ យ៉ាងណា ដើម្បី សុខ មាលភាព របស់ ប្រជាពលរដ្ឋ និង បង្ក លក្ខណៈ សប្បាយរីករាយ ក្នុង ពិធី ប្រណាំង ទូក នៅក្នុង ខេត្ត ស្វាយរៀង ៕ សម្តេច ក្រឡាហោម ស ខេង ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះមហាក្សត្រ ក្នុង ឱកាស ខួប ១៤ ឆ្នាំ នៃ ការយាង គ្រងរាជសម្បត្តិ
( ភ្នំពេញ ) ៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បាន ផ្ញើ សារលិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ឱកាស ខួប លើក ទី ១៤ នៃ ការយាង គ្រងរាជសម្បត្តិ របស់ ព្រះអង្គ ។
