( កំពង់ចាម ) ៖ លោក បណ្ឌិត មាស បូរ៉ា សមាជិក ក្រុមប្រឹក្សា អ្នក ច្បាប់ និង ជា សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ឯកទេស នៃ កម្ពុជា CUS ក្នុង សន្និសីទ ស៊ី យូ អេស ២០១៨ ស្តីពី សិក្សា នៅ ឧត្តម សិក្សា ដើម្បី ឧត្តមភាព ការងារ ដែល បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នៅ សាកលវិទ្យាល័យ CUS ខេត្ត កំពង់ចាម បាន លើកឡើង ថា មាន ចំណេះដឹង ជាដើម ចម នាំឲ្យ យើង ទទួលបាន ជោគជ័យ ។
ជាមួយគ្នា នេះ លោក បណ្ឌិត សឿ យ៉ាន សាកលវិទ្យាធិការ រង នៃ សាកលវិទ្យាល័យ CUS ក៏ បាន ធ្វើ បទបង្ហាញ ជាច្រើន ទៅដល់ ក្រុម និស្សិត ទាក់ទង ទៅ និង ប្រធានបទ ស្តីពី សិក្សា នៅ ឧត្តម សិក្សា ដើម្បី អនាគត រុងរឿង និង ជោគជ័យ នេះ ។
បន្ថែម ពី នេះ លោក បណ្ឌិត មាស បូរ៉ា បាន ថ្លែង ថា ក្នុង ពិភពលោក មាន អ្នក ជោគជ័យ ជាច្រើន មាន ប្រភព ចេញមក ពី អ្នកក្រ ហើយ ផ្តើម ចេញ ពី ចំណេះដឹង ដែល បាន មកពី ការខិតខំ តស៊ូ សិក្សា និង ស្រាវជ្រាវ ទើប ពួកគេ បាន ទទួល ជោគជ័យ ។ បើ ទោះជា យ៉ាង នោះ ក្តី ពួកគេ មិន បាន បោះបង់ ការសិក្សា ទេ ពោលគឺ គេ នៅតែ បន្ត ការសិក្សា ស្រាវជ្រាវ ដើម្បី ក្រេប ជញ្ជក់ យក ចំណេះដឹង មក ធ្វើ ការអភិវឌ្ឍន ខ្លួន របស់ គេ ដើម្បី ដើរ ឲ្យ ទាន់ សម័យកាល ជាពិសេស សម័យ ទំនើប ដូច ពេល បច្ច ប្បន្ន នេះ ។
លោក ត្រាំ បាន ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ថា « យើង កំពុង សិក្សា ករណី នេះ ល្អិតល្អន់ បំផុត ដោយ វា ជា រឿង អាក្រក់ មួយ ដែល បាន កើតឡើង គឺ ការសម្លាប់ អ្នកសារព័ត៌មាន ម្នាក់ ។ យើង នឹង មាន របាយការណ៍ ពេញលេញ គ្រប់ ជ្រុងជ្រោយ មួយ ក្នុង ពេល ពីរ ថ្ងៃ ទៀត គឺ ប្រហែលជា នឹង ទទួលបាន នៅ ថ្ងៃចន្ទ និង អង្គារ ខាងមុខ នេះ ហើយ » ។
( ភ្នំពេញ ) ៖ ជនជាតិ ខ្មែរ និង ពលរដ្ឋ ជប៉ុន ប្រមាណ ៨០០ នាក់ បាន ចូលរួម ក្នុង កម្មវិធី « ភ្នំពេញ ទីក្រុង ស្អាត ជាមួយ ប្រទេស ជប៉ុន » ដើរ រើស សំរាម បោសសម្អាត ទីធ្លា នានា ក្នុង រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ។
ពិធី នេះ ក៏ មាន ការចូលរួម លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន . លោក ហូរី ណូអ៊ុឈិ ហ៊ីដេហ៊ីសា ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា និង លោក ហួត ហៃ អភិបាល រង រាជធានី ភ្នំពេញ ដែល គម្រោង « ភ្នំពេញ ទីក្រុង ស្អាត ជាមួយ ប្រទេស ជប៉ុន » ត្រូវបាន សហការរៀបចំ ដោយ គណៈកម្មាធិការ គម្រោង ភ្នំពេញ ទីក្រុង ស្អាត ជាមួយ ប្រទេស ជប៉ុន និង ក្រសួង បរិស្ថាន ។
ឯក អគ្គ រាជ ទូត ជប៉ុន ហូរី ណូអ៊ុឈិ ហ៊ីដេហ៊ីសា បាន ថ្លែង ថា កម្មវីធី នេះ ពិតជា មាន អត្ថន័យ ជ្រៀល ជ្រៅ ដោយ បងប្អូន ជនជាតិ ជប៉ុន នៅ រាជធានី ភ្នំពេញ ផ្តួចផ្តើម គំនិត ឡើង ដោយ សហការ រៀបចំ ជាមួយ ក្រសួង បរិស្ថាន និង សាលា រាជធានី ភ្នំពេញ ហើយ ប្រជាជន ជប៉ុន និង កម្ពុជា រួម សាមគ្គី គ្នា សម្អាត ទីក្រុង ។ លោក ឯក អគ្គ រាជ ទូត បាន បញ្ជាក់ ថា បញ្ហា សំរាម នៅក្នុង ទីក្រុង មិន ត្រឹម មាន តែ នៅក្នុង ប្រទេស កម្ពុជា សូម្បីតែ នៅ ប្រទេស ជប៉ុន ក៏ មាន បញ្ហា ប្រឈម ដែរ ។
ចំណែក លោក ហួត ហៃ បាន លើកឡើង ថា វា ជា ភាពចាំបាច់ ដែល ទាំងអស់ គ្នា ចាំបាច់ ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការធ្វើឱ្យ ទីក្រុង របស់ យើង ជា កន្លែង ដែល គួរ រស់នៅ និង ប្រកបដោយ អនាម័យ បរិស្ថាន ល្អ ។
យោង តាម របាយការណ៍ របស់ ក្រសួង បរិស្ថាន បច្ចុប្បន្ន នេះ នៅក្នុង មួយ ថ្ងៃ សំណល់ រឹង សំរាម នៅក្នុង រាជធានី ភ្នំពេញ បាន កើន រហូតដល់ ៣.០០០ តោន ក្នុង នោះ ៦៥ % ជា សំរាម សើម ២០% ជា ថង់ ប្លាស្ទិក និង ជាង ១០% ជា សំណល់ រឹង ។ ចំណែក ការការច្នៃ សំរាម មាន ត្រឹមតែ ២០% ប៉ុណ្ណោះ ដែល ធ្វើឱ្យ អាត្រា សំរាម ដែល ត្រូវ បោះចោល នៅ ទីលាន សំរាម មាន ពី ៧០ ទៅ ៨០ % និង សំរាម មួយ ចំនួន ទៀត ត្រូវបាន បោះចោល អនាធិបតេយ្យ នៅ តាម ផ្លូវ សាធារណៈ នានា ។
សំណល់ ដែល ត្រូវបាន អ្នកចូលរួម ប្រមូល បាន គឺ ភាគ ច្រើន ជា សំណល់ សំរាម ថង់ ប្លាស្ទិក ដែល ត្រូវបាន បោះ រាយប៉ាយ នៅ តាម ធី ធ្លាសាធារណៈ នានា ក្រោយពី ការដើរកម្សាន្ត របស់ បងប្អូន ប្រជាពលរដ្ឋ មួយចំនួន ដែល មិន បាន ទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ ។
លោក រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន គូសបញ្ជាក់ ថា នៅក្នុង រាជ រដ្ឋាភិបាល អាណត្តិ ទី៦នេះ ក្រសួង បរិស្ថាន បាន កំណត់ ចក្ខុវិស័យ របស់ ខ្លួន ដោយ លើកឡើង ថា គុណភាព និរន្តរភាព បរិស្ថាន ត្រូវបាន ធានា ៕
ការមានប្រសាសន៍ បែប នេះ របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស សម្ដេច និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា អញ្ជើញ សួរសុខទុក្ខ ព្រមទាំង រៀបចំ អាហារ ជូន កុមារ ពិការ គ- ថ្លង់ និង កុមារ កំព្រា សរុប ៨៧៨ នាក់ មកពី សាលា គ្រួសារ ថ្មី និង មណ្ឌលកុមារ កំព្រា នានា ក្នុង រាជធានី ភ្នំពេញ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ស្ថាប័ន នានា សូមឲ្យ បង្កើន ការយកចិត្តទុកដាក់ រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ពិធី ដ៏ ធំ ដែល ប្រជាជន នៅ តាម ទី ជនបទ រាប់ លាន នាក់ ចូលមកកាន់ ទីក្រុង ភ្នំពេញ របស់ យើង ដើម្បី កម្សាន្ដ » ។
គួរ ជម្រាប ថា ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប អក អំបុក និង សំពះ ព្រះខែ នឹង ត្រូវ ប្រារព្ធ ធ្វើឡើង ចាប់ពី ថ្ងៃទី ២១ - ២២ - ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ខណៈ កម្លាំង សមត្ថកិច្ច ចំនួន ១៣. ០៤៧ នាក់ ត្រៀម ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ ជូន ថ្នាក់ដឹកនាំ និង ប្រជាពលរដ្ឋ ។
នាយ ឧត្តមសេនីយ៍ ទូច ណារ៉ុថ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ប្រធាន នាយកដ្ឋាន អង្គរក្ស បាន លើកឡើង ថា ដើម្បី ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា ថ្នាក់ដឹកនាំ ក្រសួង មក លេង កម្សាន្ដ នៅក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ក្រសួង មហាផ្ទៃ បាន ត្រៀម កម្លាំង ជាច្រើន នាក់ ទាំង ចំហរ និង សំងាត់ ក្នុង បុណ្យ ជាតិ នេះ ខណៈ ព្រឹត្តិការណ៍ នេះ នឹង ប្រព្រឹត្តទៅ ធំ ជាង ឆ្នាំ មុន ។
នាយ ឧត្តមសេនីយ៍ ទូច ណារ៉ុថ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មក លេង កម្សាន្ដ ឲ្យ មាន ការប្រុងប្រយ័ត្ន និង ធ្វើ ការសហការ ជាមួយ សមត្ថកិច្ច ដើម្បីឲ្យ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ប្រព្រឹត្តិ ទៅ ប្រកបដោយ សប្បាយរីករាយ និង សណ្តាប់ធ្នាប់ ល្អ គ្មាន បញ្ហា អ្វី កើតឡើង ៕ រដ្ឋបាល ខេត្ត ព្រះវិហារ រៀបចំ ពិធី ក្រុង ពាលី ទូក បញ្ជូន មកកាន់ រាជធានី ភ្នំពេញ ដើម្បី ចូលរួម ប្រណាំង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន រៀបចំ ពិធី ក្រុង ពាលី ទូក ដើម្បី បញ្ជូន មកកាន់ រាជធានី ភ្នំពេញ ដើម្បី ចូលរួម ប្រណាំង ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្ដែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ដែល នឹង ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ២១ ដល់ ថ្ងៃទី ២៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ខាងមុខ នេះ នៅមុខ ព្រះបរម រាជ វាំង ។
ការរៀបចំ ពិធី ក្រុង ពាលី នេះ ដឹកនាំ ដោយ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ និង សហការី ព្រមទាំង ចំណុះ ទូក សរុប ជិត ២០០ នាក់ ផងដែរ ។
សូម ជម្រាប ថា ទូក «ង » មកពី ខេត្ត ព្រះវិហារ ដើម្បី ចូលរួម ប្រណាំង នេះ មាន ចំនួន ២គ្រឿង ទី ១៖ ឈ្មោះ ព្រះវិហារ សែន ជ័យ ប្រវែង ៣៤.២០ ម៉ែត្រ ផ្ទុក កីឡាករ ចំនួន ៧៧ នាក់ និង ទី២៖ ឈ្មោះ កោះ កែសែន ជ័យ បារមី ព្រះអង្គ ខ្មៅ ប្រវែង ៣៤.២០ ម៉ែត្រ ផ្ទុក កីឡាករ ចំនួន ៧៧ នាក់ ដែល ឧបត្ថម្ភ គាំទ្រ ដោយ នាយ ឧត្តមសេនីយ៍ ហ៊ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ បញ្ជាការដ្ឋាន អង្គរក្ស និង លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ ។
ទូក «ង » ទាំង ពីរ នេះ ស្ថិត នៅក្នុង វត្ត ប្រាសាទ ជ័យ ព្រឹក្ស ភូមិ គោក បេង សង្កាត់ កំពង់ប្រណាក ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ ៕
តំណាង សម្ដេច ក្រឡាហោម ស ខេង ផ្ដួច ផ្ដើម អង្គក ឋិន ទាន នាំ បច្ច័យ ជិត ១០០ លាន រៀល ប្រគេន ព្រះសង្ឃ នៅ វត្ត ចំនួន ២ ក្នុង ស្រុក សង្កែ
( បាត់ដំបង ) ៖ តំណាង សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ លោក ឡោក ហ៊ួរ ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក សង្កែ នាំ បច្ច័យ ចំនួន ៨៨ លាន រៀល ចូលរួម ធ្វើ បុណ្យ ក ឋិន ទាន ២វត្ត ក្នុង ចំណោម វត្ត ទាំង ១៥ នៅ ខេត្ត បាត់ដំបង ។
ក្នុង នោះ នៅ ស្រុក សង្កែ គឺ នៅ វត្ត ទួល ពន្លៃ ស្ថិត ក្នុង ភូមិ អូរ ស្រឡៅ ឃុំ វត្ត តា មិម ស្រុក សង្កែ និង វត្ត ដំណាក់ រទេះ ដែល មាន ពុទ្ធ បរិស័ទ្ធ មកពី ស្រុក នានា រួមគ្នា និង វត្ត ទួល ពន្លៃ ក្នុង ឃុំ វត្ត តាមិម និង នៅ វត្ត ដំណាក់ រទេះ ស្ថិត ក្នុង ភូមិ កាច់ រទេះ ឃុំ កំពង់ព្រៀង ស្រុក សង្កែ ។
លោក ឡោក ហ៊ួរ បាន ថ្លែង សំណេះសំណាល ទៅ កាន់ ពុទ្ធ បរិស័ទ្ធ ទាំងអស់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឲ្យ វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ បាន ផ្សារភ្ជាប់គ្នា តាំងពី បុរាណកាល មក ទល់ បច្ចុប្បន្ន គឺ មិន អាច ផ្តាច់ ចេញ ពី គ្នា បាន ឡើយ ព្រោះ រាជ រដ្ឋាភិបាល បាន កំណត់ ថា ព្រះពុទ្ធ សាសនា ជា សាសនា របស់ រដ្ឋ ដោយ បាន នាំគ្នា ធ្វើ អំពើ ល្អ មាន សាមគ្គីភាព គ្នា ចេះ ស្រលាញ់ គ្នា តាម ព្រះឱវាទ របស់ ព្រះពុទ្ធត រៀងមក ។
លោក បាន បន្ត ថា សូម ប្រជាពលរដ្ឋ ពុទ្ធ បរិស័ទ្ធ ទាំងអស់ កុំ ចាញ់បោក គេ ដូច សម័យ មុន ៗ ដែល មាន មេដឹកនាំ មិន ល្អ កន្លងមក បាន ដឹកនាំឲ្យ ប្រទេសជាតិ ធ្លាក់ ក្នុង ភ្លើង សង្រ្គាម និរាស្រ្ត ព្រាត់ប្រាស់ ពិសេស ធ្វើឲ្យ ប្រទេសជាតិ បាន ធ្លាក់ របប ប្រល័យ ពូជសាសន៍ គ្មាន សិទ្ធ សេរីភាព ស្គាល់ តែ ការតែ កាប់ សម្លាប់ ជាតិ សាសន៍ ឯង ពួក មេដឹកនាំ បិទ មិន ឲ្យ មាន សាសនា សាលារៀន ផ្សារ លក់ដូរ អ្វី ឡើយ ។
( កំពង់ស្ពឺ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ខេត្ត កំពង់ស្ពឺ រៀបចំ ការប្រឡង ជ្រើសរើស មន្ដ្រី បម្រើ ការងារ ក្របខ័ណ្ឌ មន្ដ្រី ពន្ធនាគារ នៃ ក្រសួង មហាផ្ទៃ ដែល មាន បេក្ខជន ចំនួន ១២៥ នាក់ ក្នុង នោះ ស្រី ៤៤ នាក់ ចូលរួម ប្រឡង ប្រជែង ដោយ បែងចែក ជា៥ បន្ទប់ ។
សម្រាប់ ការប្រឡង នេះ លោក សរ សុពុត្រា អភិបាល រង ខេត្ត តំណាង លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ អញ្ជើញ ហែក កញ្ចប់ វិញ្ញាសារ ប្រឡង ដោយ បាន គូសបញ្ជាក់ ថា ការប្រឡង នេះ ធ្វើឡើង ដោយ ភាពត្រឹមត្រូវ បំផុត ដូច្នេះ ទាមទា ឲ្យ អ្នក ដាក់ ពាក្យ ប្រឡង ត្រូវ មាន ចំណេះ ឲ្យ ពិតប្រាកដ និង តាមដាន គ្រប់ វិញ្ញាសារ ប្រឡង ដែល អាន ជូន ដោយ គណៈ មេ ប្រយោគ ។
លោក អភិបាល រង ខេត្ត បាន បន្ត ថា បេក្ខជន ប្រឡង ទាំងអស់ ត្រូវតែ ខិតខំ ប្រឹងប្រែង យក អស់ កម្លាំង កាយ ចិត្ត ប្រើប្រាស់ នូវ បញ្ញា ញាណ ចំណេះដឹង របស់ ខ្លួន ដើម្បី ប្រឡង ឲ្យ ទទួលបាន នូវ ជោគជ័យ ហើយ ការខិតខំ ប្រឹងប្រែង គឺ ដើម្បី អនាគត និង កិត្តិយស សម្រាប់ ខ្លួន ឯង ផង សម្រាប់ ក្រុមគ្រួសារ ផង និង សម្រាប់ សង្គមជាតិ ផង ។
បន្ថែម ពី នេះ លោក សរ សុពុត្រា ក៏ បាន ផ្តាំផ្ញើ ដល់ បេក្ខជន បេក្ខ នារី ទាំងអស់ ដែល ត្រូវ ប្រឡង ត្រូវ អនុវត្ត តាម ទៅ បទបញ្ជា ផ្ទៃក្នុង ឲ្យបាន ល្អ មិន ត្រូវ លួច ចម្លង គ្នា មើល គ្នា ពិភាក្សា គ្នា មិន ត្រូវ គូស សញ្ញា សម្គាល់ លើ ក្រដាស វិញ្ញាសា និង ឧបករណ៍ អេឡិចត្រូនិច មិន ត្រូវ យក ចូល ក្នុង បន្ទប់ ប្រឡង បាន ឡើយ ៕
រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម៖ យុវជន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ លើ វិស័យ កសិកម្ម នា ពេល បច្ចុប្បន្ន នេះ
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ថ្លែង ថា នា ពេល បច្ចុប្បន្ន នេះ យុវជន គឺ មាន សារៈសំខាន់ ណាស់ ក្នុង ការអភិវឌ្ឍ លើ វិស័យ កសិកម្ម ព្រោះ កម្លាំង យុវជន ដែល នៅ សិក្សា ដូចជា សិស្ស និស្សិត គឺ ពួកគេ នៅតែ ស្រូបយក ចំណេះដឹង ថ្មី ៗ បច្ចេកទេស ថ្មី ៗ ដើម្បី ជួយ ដល់ ការអភិវឌ្ឍ លើ វិស័យ កសិកម្ម នៅ តាម ជនបទ ផងដែរ ។
រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម បាន ថ្លែង យ៉ាង ដូចនេះ នា ព្រឹក ថ្ងៃទី ១៧ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក សន្និសីទ ជាតិ លើក ទី៥ ស្តីពី ការអភិវឌ្ឍ កសិកម្ម និង ជនបទ ក្រោម ប្រធានបទ « និរន្តរភាព សេដ្ឋកិច្ច ជនបទ តាមរយៈ កសិកម្ម វៃ ឆ្លាត ខាង អាកាសធាតុ ការកែច្នៃ និង ពាណិជ្ជកម្ម កសិកម្ម » នៅ សាលា ជាតិ កសិកម្ម ព្រែក លៀប ។
លោក បាន បន្ត ទៀត ថា ប្រសិនបើ យើង ធ្វើ កសិកម្ម នៅ នឹង ដដែល គឺ មិន បាន នោះ ទេ ដែល ទាមទារ នូវ បច្ចេកវិទ្យា ថ្មី បទពិសោធន៍ ថ្មី និង ចំណោះ ដឹង ថ្មី ដើម្បី ផ្ទេរ ទៅ កសិករ ឱ្យ ពួកគាត់ បាន យក ចំណេះដឹង នេះ ទៅ ធ្វើ ការកែប្រែ ជីវភាព ដោយ ទទួលបាន ចំណូល ស្រប ទៅ តាម កំណើន សេដ្ឋកិច្ច ពីព្រោះតែ ដំណើរការវិវឌ្ឍ នៃ កំណើន សេដ្ឋកិច្ច ក្នុង ប្រទេស នីមួយ ៗ តែងតែ មាន ការប្រែប្រួល ដោយសារ តែ គំនាប នៃ ដី របស់ គាត់ មាន តូច ហើយ គ្មាន ជីវជាតិ ជាដើម ទើប ធ្វើឱ្យ ពួកគាត់ បាន ធ្វើ ចំណាកស្រុក ដើម្បី ស្វែងរក ចំណូល ។
លោក រដ្ឋមន្ដ្រី បញ្ជាក់ ថា កាលពី ឆ្នាំ ១៩៩៣ ប្រជាជន ដែល ប្រើ កម្លាំង ពលកម្ម នៅក្នុង វិស័យ កសិកម្ម មាន ៨០ % ហើយ ឥលូវនេះ នៅសល់ ប្រហែល ៤០ % ហើយ រំពឹង ថា នៅ ឆ្នាំ ២០៥០ និង អាច ធ្លាក់ នៅសល់ ២២ទៅ ២៣% ប៉ុណ្ណោះ ដូច្នេះ អ្វី ដែល ត្រូវតែ ខិតខំ នោះ គឺ ត្រូវតែ ស្វែងរក បច្ចេកវិទ្យា ការធ្វើ កសិកម្ម តាម បែប ទំនើប និង ត្រូវ ជ្រើសរើស គ្រឿងចក្រ ប្រភេទ ណា ដើម្បី រុញទៅ ជន បទ ឱ្យ បាន ឆ្លើយតប នឹង សេចក្តីត្រូវការ របស់ ប្រជាជន ដែល ត្រូវការ ប្រើប្រាស់ នូវ ពលកម្មតិច ឫ ការផ្តល់ សេវា អ្វី មួយ ជូន ដល់ ប្រជាពលរដ្ឋ ។
( វ៉ាស៊ីនតោន ) ៖ សាកសព ជនរងគ្រោះ ០៥ នាក់ ទៀត ត្រូវបាន រកឃើញ ដែល ធ្វើឲ្យ ចំនួន មនុស្ស ស្លាប់ សរុប ដោយសារ មហន្តរាយ ភ្លើង ឆេះ ព្រៃ នៅ ភាគ ខាងជើង រដ្ឋ កាលីហ្វរញ៉ា នៃ សហរដ្ឋ អាមេរិក បន្ត កើន ដល់ ៧៦ នាក់ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន រុស្ស៉ី Sputnik នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
