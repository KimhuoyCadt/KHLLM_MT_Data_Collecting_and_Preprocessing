( ភ្នំពេញ ) ៖ លោក អង្គ វង្ស វឌ្ឍនា រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌ នៅ រសៀល ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស ផ្ទេរ និង ចូលកាន់ មុខតំណែង ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ សាលាដំបូង រាជធានី ភ្នំពេញ ដោយ មាន ការចូលរួម ពីរ អ្នក ពាក់ព័ន្ធ ជាច្រើន ទៀត ផងដែរ ។
សូម បញ្ជាក់ ថា លោក យ៉េត ចរិយា ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ត្រាស បង្គាប់ ផ្ទេរ តំណែង ពី ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ទៅជា អគ្គ ព្រះរាជអាជ្ញា រង អម តុលាការ កំពូល ។ ចំណែក លោក កែវ សុធា ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស បង្គាប់ ផ្ទេរ តំណែង ពី ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ស្ពឺ ទៅជា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ជំនួស លោក យ៉េត ចរិយា ៕
របាយការណ៍ ថ្មី៖ តំបន់ ធម្មជាតិ នៅ ទូទាំង សកលលោក កំពុង បាត់បង់ យ៉ាង ឆាប់រហ័ស ដោយសារតែ សកម្មភាព មនុស្ស
( ឡុងដ៍ ) ៖ ទស្សនាវដ្ដី The Nature បាន អំពាវនាវ ឱ្យ សហគមន៍ អន្តរជាតិ ទាំងមូល ធ្វើ សកម្មភាព ជាបន្ទាន់ ក្នុង ការការពារ តំបន់ ធម្មជាតិ ខណៈ តំបន់ ធម្មជាតិ កម្រ ៗ ជាច្រើន កំពុង បាត់បង់ យ៉ាង ឆាប់រហ័ស ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
ការសិក្សា ស្រាវ ជា្រវ មួយ ចេញផ្សាយ នៅលើ ទស្សនាវដ្ដី The Nature នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « កាលពី មួយ សតវត្សរ៍ មុន តំបន់ ធម្មជាតិ ១៥ភាគរយ តែ ប៉ុណ្ណោះ ត្រូវបាន ប្រើប្រាស់ សម្រាប់ ការចិញ្ចឹម សត្វ និង ដំា ដំណាំ .. . ក៏ប៉ុន្តែ ក្នុង ពេល បច្ចុប្បន្ន តំបន់ ធម្មជាតិ រហូតដល់ ៧០ ភាគរយ ក្នុង នោះ រួមទាំង ទ្វីប អង់តាក់ ទិច បាន និង កំពុង ប្រែប្រួល ដោយសារ សកម្មភាព របស់ មនុស្ស » ។
ងាក ទៅ មើល ផ្ទៃ សមុទ្រ វិញ បើ តាម រូបភាព អង្កេត តាម ប្រព័ន្ធ ផ្កាយ រណប ទៅ លើ ផ្ទៃ មហាសមុទ្រ ទាំង ០៤ ផ្ទៃ សមុទ្រ ទាំងអស់ សរុប ៨៧ ភាគរយ កំពុង ត្រូវបាន គ្រប់គ្រង ដោយ សកម្មភាព មនុស្ស មាន ដូចជា ការធ្វើ នេសាទ ជីក យក រ៉ែ ការបំពុល និង ការដឹកជញ្ជូន ដែល ស្ទើរតែ លាតសន្ធឹង ទៅដល់ តំបន់ ប៉ូល ទាំង ពីរ នៃ ផែនដី នេះ តែម្តង ។
សម្រាប់ តំបន់ ដែល អាច ទទួលរង ការការពារ វិញ គឺ លុះត្រា ណា តែ វា ស្ថិត នៅក្នុង យន្តការ នៃ ការការពារ ដោយ ច្បាប់ អន្តរជាតិ ឬ វា ជា តំបន់ ចាំបាច់ សម្រាប់ ប្រទេស ទាំងអស់ នោះ ផ្ទាល់ ទើប អាជ្ញាធរ ពួកគេ ប្រឹងប្រែង នៅក្នុង ការថែរក្សា ។ ហេតុ ដូច្នេះ ទើប បណ្តា អ្នក អភិរក្ស និង គាំពារ បរិស្ថាន ទាំងអស់ អំពាវនាវ ឲ្យ មាន ការឡើង អំពី បញ្ហា នេះ នៅក្នុង កិច្ចប្រជុំ អង្គការ សហ ប្រជាជាតិ ដែល នឹង ឈាន មកដល់ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ ។
គួរ ជម្រាប ថា នៅ ចន្លោះ ឆ្នាំ ១៩៩៣ និង ឆ្នាំ ២០០៩ តំបន់ ធម្មជាតិ មួយ មាន ទំហំ ធំ ជាង ប្រទេស ឥណ្ឌា ដែល មាន ផ្ទៃ ៣.៣លាន គីឡូម៉ែត្រ ក្រឡា បាន បាត់បង់ ដោយសារ សកម្មភាព របស់ មនុស្ស ដូចជា ការសាងសង់ ទីជម្រក ការធ្វើ កសិកម្ម ការជីក រ៉ែ និង សម្ពាធ ដទៃ ជាច្រើន ទៀត ។ សកម្មភាព ទាំងអស់ នេះ ក៏ កំពុងតែ ធ្វើឲ្យ ជម្រក ទាំង សត្វ លើ ដី និង ក្នុង ទឹក កាន់តែ រួញ ទៅ ៗ ផងដែរ ៕
( មណ្ឌលគិរី ) ៖ ករណី ឃាតកម្ម យ៉ាង សាហាវ ព្រៃផ្សៃ ទៅ លើ ក្មេងប្រុស អាយុ ១១ឆ្នាំ ម្នាក់ នៅ ស្រុក កោះ ញែក ខេត្ត មណ្ឌលគិរី ដោយ ឃាតក កាប់ ចិញ្រ្ចាំ សុះ សាច់ និង វះ ពោះ ផង នោះ រហូតដល់ ថ្ងៃទី ០១ ខែវិច្ឆិកា នេះ ស្ថិត នៅក្នុង ភាពអាថ៌កំបាំង ដដែល ។ សមត្ថកិច្ច នគរបាល ជំនាញ ខេត្ត មណ្ឌលគិរី បាន សហការ ជាមួយ នគរបាល មូលដ្ឋាន កំពុង បន្ត នីតិវិធី ក្នុង ការស្រាវជ្រាវ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០១៨ នៅ ចំណុច វាល ស្រែ ប្រឡាយ ទី៣ ជិត អូប្រង់ ស្ថិត នៅក្នុង ភូមិ ស្រែ ហ៊ុយ ឃុំ ស្រែ ហ៊ុយ ស្រុក កោះ ញែក ខេត្ត មណ្ឌលគិរី ។
លោក អធិការ នគរបាល ស្រុក កោះ ញែក បាន ឱ្យដឹង ថា ករណី នេះ ត្រូវ គេ ប្រទះឃើញ សព នៅ វេលា ម៉ោង ប្រមាណ ៦៖០០ ព្រលប់ ថ្ងៃទី ២៨ ខែតុលា ដោយ ជនរងគ្រោះ ត្រូវ គេ កាប់ ចិញ្ច្រាំ ធ្លាយ ពោះ និង កាប់ លើ ក្បាល មុខមាត់ ស្ទើរតែ មើល មិន ស្គាល់ ។
លោក អធិការ នគរបាល ស្រុក បញ្ជាក់ ទៀ ថា ករណី នេះ សង្ស័យ ជា អំពើ ឃាតកម្ម ។ បច្ចុប្បន្ន សមត្ថកិច្ច កំពុង ស្រាវជ្រាវ តាម រក ចាប់ខ្លួន ជន ដៃ ដល់ មក ផ្តន្ទាទោស តាម ច្បាប់ ។
ក្នុង ហេតុការណ៍ នេះ មាន ព័ត៌មាន ពី អ្នកភូមិ នៅ ទីនោះ បាន នាំគ្នា ខ្សឹបខ្សៀវ ថា ម៉ែ ឪ ក្មេង រងគ្រោះ គឺជា គ្រួសារ ជាប់ តំណ អំពើរ អាបធ្មប់ ។
លោក មេភូមិ ស្រែ ហ៊ុយ ឈ្មោះ ក្រាក់ តូយ បាន ប្រាប់ ផងដែរ ថា គ្រួសារ ក្មេង រងគ្រោះ ខាងលើ នេះ មាន ការអះអាង ពី អ្នកភូមិ នៅ ទីនេះ ពិតជា មាន ជាប់ តំណ រឿង អំពើ អាបធ្មប់ តែ ដោយឡែក នៅពេល មាន ហេតុការណ៍ ឃាតកម្ម នេះ កើតឡើង លោក មេភូមិ រូប នេះ ក៏ មិន អាច ធ្វើ ការសន្និដ្ឋាន ថា បណ្តាល មកពី រឿង អ្វី នោះ ឡើយ ។ លោក បាន ឲ្យដឹង ថា ក្មេងប្រុស សព គឺជា ក្មេង កំពុង រៀន ថ្នាក់ ទី៤ ក្រៅពី រៀនសូត្រ ជា ក្មេង ឃ្វាល ក្របី គោ និង ទាក់ល លក យក ទៅ លក់ ។
លោក ឡោ សុខា ស្នងការ ខេត្ត មណ្ឌលគិរី បាន បញ្ជាក់ ប្រាប់ ភ្នាក់ងារ Fresh News ប្រចាំ ខេត្ត មណ្ឌលគិរី នៅ រសៀល ថ្ងៃទី ០១ ខែវិច្ឆិកា នេះ ថា ទោះបី ករណី ឃាតកម្ម នេះ ជាប់ពាក់ព័ន្ធ ទៅនឹង រឿងរ៉ាវ អ្វី ក៏ដោយ លោក កំពុង ដាក់ បទបញ្ជា ឲ្យ កងកម្លាំង នគរបាល ជំនាញ ខេត្ត សហការ ជាមួយ នគរបាល មូលដ្ឋាន ស្រាវជ្រាវ វែក មុខ រក ជន ដៃ ដល់ ជា ឃាតក យកមក ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ ឲ្យ ខាងតែ បាន នៅពេល ខាងមុខ ដ៏ ខ្លី នេះ ៕
កិច្ចប្រជុំ តុ មូល ព្រះពុទ្ធ សាសនា នៅ ប្រទេស ចិន សង្ឃឹម ថា អ្នកកាន់ ព្រះពុទ្ធ សាសនា នឹង រួមគ្នា រក្សា សន្តិភាព នៅ តាម តំបន់ សមុទ្រ ចិន ខាងត្បូង
( សិន ជិន - ចិន ) ៖ លោក ហ៉ឹម ឆែម ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសង ធម្មការ និង សាសនា នៅ ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ បាន អញ្ជើញ ចូលរួម ជា កិត្តិយស ក្នុង កិច្ចប្រជុំ តុ មូល ស្តីពី ព្រះពុទ្ធ សាសនា សមុទ្រ ចិន ខាងត្បូង លើក ទី៣ ឆ្នាំ ២០១៨ ដែល ប្រារព្ធ នៅ សាល ប្រជុំ ណាន់ ណៃ ទីក្រុង សិន ជិន នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
កម្មវិធី នេះ ក៏ មាន ការយាង ចូលរួម ពីសំណាក់ សម្តេច សង្ឃ ជាន់ ខ្ពស់ ទាំង ពីរ និកាយ នៃ ព្រះរាជាណាចក្រ កម្ពុជា រួមទាំង តំណាង សហគម ព្រះពុទ្ធ សាសនា និង មន្ត្រី រដ្ឋាភិបាល ជាន់ ខ្ពស់ មកពី ប្រទេស ជាច្រើន រួម មាន៖ ប្រទេស ចិន . ស្រីលង្កា . ឡាវ . កម្ពុជា . នេប៉ាល់ . មីយ៉ាន់ម៉ា . ម៉ុងហ្គោលី . និង សហរដ្ឋ អាមេរិក ផងដែរ ។
ប្រទេស នៅ តាម សមុទ្រ ចិន ខាងត្បូង នឹង ចូលរួម ជួយ ដោះស្រាយ ជម្លោះ និង រក្សា សន្តិភាព តាមរយៈ ការចូលរួម ជាមួយគ្នា ដើម្បី លើកកម្ពស់ ចំណង ទាក់ទង រវាង ប្រជាជន និង ប្រជាជន ជាមួយ បណ្តា ប្រទេស នៃ សមុទ្រ ចិន ខាងត្បូង ដែល ត្រូវបាន គេ ចាត់ទុក ថា ជា តំបន់ ស្នូល នៃ ព្រះពុទ្ធ សាសនា លើ ការរីកចម្រើន ដល់ ទីតាំង ភូមិសាស្ត្រ និង វប្បធម៌ ។ ប្រជាជន នៃ ប្រទេស ផ្សេង ៗ ក៏ មាន ការចែករំលែក គោលដៅ រួមគ្នា ដើម្បី លើកកម្ពស់ ខាង ជំនឿ ខាង វិញ្ញាណ ក្នុង ការស្វែងរក ជីវិត ដ៏ ប្រសើរ ។
ព្រះពុទ្ធ មាន សេចក្តីអាណិតអាសូរ ហើយ ស្វែងរក ការប្រោស ដល់ មនុស្ស ទាំងអស់ ឲ្យ ចាក ផុត សេចក្តីទុក្ខ និង ស្វែងរក សេចក្តីសុខ ចំរុង ចម្រើន ដល់ មនុស្ស ទាំងអស់ និង ស្វែងរក ភាព សុខដុមរមនា និង ការអភិវឌ្ឍ ភាព ស្និតស្នាល និង ទូទំទូលាយ ជាមួយ អ្នកដទៃ នៅក្នុង សហគមន៍ ព្រះពុទ្ធ សាសនា តាម តំបន់ សមុទ្រ ចិន ខាងត្បូង រវាង ប្រជាជន និង ប្រជាជន ។
កិច្ចប្រជុំ ព្រះពុទ្ធ សាសនា សមុទ្រ ចិន ខាងត្បូង ត្រូវបាន ប្តេជ្ញាចិត្ត ប្រមូលផ្តុំ ការមូល មតិ គ្នា ក្នុង ចំណោម ប្រជាជន នៃ ប្រទេស អ្នកកាន់ ព្រះពុទ្ធ សាសនា បង្កើត វេទិកា មួយ សម្រាប់ ការផ្លាស់ប្តូរ និង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ តាមរយៈ សិក្ខាសាលា និង កិច្ចសហប្រតិបត្តិការ ជាក់ស្តែង ។ កិច្ចប្រជុំ តុ មូល នៅ ឆ្នាំ នេះ ក៏ នឹង មាន ការ មូល មតិ គ្នា ដែល បញ្ជាក់ ពី តម្លៃ ស្នូល នៃ ការគោរព គ្នា ទៅ វិញ ទៅ មក ផ្តល់ ភាពយុត្តិធម៌ និង កិច្ចសហប្រតិបត្តិការ ឈ្នះ ឈ្នះ តាម ការព្រមព្រៀង គ្រប់ ភាគី ទាំងអស់ ។
កិច្ចប្រជុំ តុ មូល ព្រះពុទ្ធ សាសនា សមុទ្រ ចិន ខាងត្បូង សង្ឃឹម ថា អ្នកកាន់ និង គោរព ព្រះពុទ្ធ សាសនា ទាំងអស់ នឹង ស្វែងរក ឱកាស រួមគ្នា ក្នុង ការរក្សា សន្តិភាព ការពារ សមុទ្យ ចិន ខាងត្បូង និង ចែករំលែក ភាព លំបាក សុភមង្គល សម្រាប់ សន្តិភាព ស្ថិរភាព និង ភាពរុងរឿង នៅ តាម តំបន់ សមុទ្រ ចិន ខាងត្បូង ៕
រដ្ឋមន្រ្តី ក្រសួង ធម្មការ៖ សកម្មភាព សាសនា លូតលាស់ ខ្លាំង បាន ធ្វើឲ្យ ចិន ក្លាយជា មជ្ឈមណ្ឌល ព្រះពុទ្ធ សាសនា របស់ ពិភពលោក
លោក បាន បន្ត ថា ពិធី បុណ្យ វប្បធម៌ ព្រះពុទ្ធ សាសនា សេន ហ្សេន លើក ទី១០ និង សន្និសីទ តុ មូល សេន ហ្សេន ព្រះពុទ្ធ សាស នា សមុទ្រ ចិន ខាងត្បូង បាន ធ្វើឡើង ដើម្បី ធ្វើឲ្យ ចំណង សាមគ្គីភាព មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង អ្នកកាន់ ពុទ្ធសាសនា នៃ កម្ពុជា និង សាធារណរដ្ឋ ប្រជាមានិត ពិសេស នោះ គឺ រឹត ចំណង សាមគ្គីភាព មិត្តភាព ក្នុង តំបន់ និង ក្នុង ពិភពលោក ។
បើ តាម លោក ទេសរដ្ឋមន្រ្តី រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ខិតខំ ខ្នះ ខ្នែង អភិវឌ្ឍន៍ វិស័យ សាសនា រួម មាន កសាង ព្រះវិហារ មណ្ឌលសំណាក់ ធម៌ សាលារៀន កុដិ មជ្ឈមណ្ឌល សុខភាព ព្រះសង្ឃ បណ្ណាល័យ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះពុទ្ធ សាសនា នៅ ទូទាំង ប្រទេស ដើម្បី ជា ឧត្តម ប្រយោជន៍ សំដៅ ពង្រឹង នូវ សាមគ្គីភាព លើកកម្ពស់ វប្បធម៌ ខន្តីធម៌ ការអត់ឱន អធ្យាស្រ័យ គ្នា ក្នុង បណ្តា អ្នក ប្រតិបត្តិ សាសនា ក្នុង សង្គមជាតិ ខ្មែរ ទាំងមូល ។
( ភ្នំពេញ ) ៖ ដោយ មាន ការយកចិត្តទុកដាក់ ទៅ លើ សុខភាព និង សុខុមាលភាព បងប្អូន ប្រជាពលរដ្ឋ ថ្នាក់ដឹកនាំ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល បាន រៀបចំ ដាក់ កម្លាំង មន្រ្តី ជំនាញ ឲ្យ យាម ប្រចាំ ការតាម ផ្សារ ជាប្រចាំ ដើម្បី ឆ្លើយតប តាម តម្រូវការ របស់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន កង្វល់ ពី សុវត្ថិភាព ចំណីអាហារ ។
ជាក់ស្តែង នៅ ថ្ងៃទី ១ ខែវិច្ចិកា ឆ្នាំ ២០១៨ មន្រ្តី កាំ កុងត្រូល ផែ ស្ងួត ចុង ទី ភ្នំពេញ ចុះ ប្រចាំ ការ ទាំង ៦ផ្សារ រួម មាន៖ ផ្សារ អូរ ឡាំពិក ផ្សារ អូ ឬ ស្សី ផ្សារ ដើម គរ ផ្សារ ស្ទឹងមានជ័យ ផ្សារ ធំ ថ្មី និង ផ្សារ ទួល ទំពូង ដោយ បាន សហការ ជាមួយ មន្រ្តី ពិសោធន៍ និង គណៈកម្មការ ផ្សារ បាន ចុះ អង្កេត និង ស្រាវជ្រាវ ទប់ស្កាត់ នូវ ទំនិញ ខូច គុណភាព មួយចំនួន ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព អ្នកប្រើប្រាស់ ។
* រំលោភ លើ ច្បាប់ អន្តរជាតិ
អំពើ ឃាតកម្ម លើ លោក Khashoggi បាន ធ្វើឱ្យ ទំនាក់ទំនង រវាង អារ៉ាប៊ី សាអូឌីត និង បណ្ដា ប្រទេស លោក ខាងលិច ជាច្រើន ប្រែ ជាល្អក់កករ ហើយ សូម្បីតែ សហរដ្ឋ អាមេរិក ក៏ មាន អារម្មណ៍ ទើស ទាល់ មិន ដឹង ថា ត្រូវ ដោះស្រាយ យ៉ាងណា ទើប កុំ ឱ្យ ប៉ះពាល់ ដល់ ទំនាក់ទំនង យុទ្ធសាស្ត្រ ជាមួយ ទីក្រុង រីយ៉ាដ ដែល ជា ម៉ូយ ដុំ ទិញ អាវុធ ដ៏ ធំ របស់ សហរដ្ឋ អាមេរិក ។
ជាក់ស្ដែង បើ ទោះជា បាន អះអាង ថា ការសម្លាប់ លោក Khashoggi គឺជា ទង្វើ រំលោភ លើ បទដ្ឋាន និង ច្បាប់ អន្តរជាតិ ក៏ដោយ ក៏ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក លោក ម៉ៃក៍ ប៉ុម ប៉េអូ មិន បាន និយាយ ចំ ឈ្មោះ អារ៉ាប៊ី សាអូឌីត ឡើយ តែ បែរជា យក សំណុំរឿង សង្រ្គាម យ៉េមែន មក ធ្វើជា ប្រធានបទ មួយ ដើម្បី ដាក់ សម្ពាធ ឱ្យ ទីក្រុង រីយ៉ាដ បញ្ឈប់ ការវាយប្រហារ ទម្លាក់ គ្រាប់បែក លើ ទីប្រជុំជន ក្នុង ប្រទេស យ៉េមែន ទៅ វិញ ។
គួរ បញ្ជាក់ ថា មក ទល់នឹង ពេល នេះ គេ មិន ទាន់ ឃើញ បណ្ដា ប្រទេស លោក ខាងលិច ចាត់ វិធានការ ណាមួយ ប្រឆាំង នឹង អារ៉ាប៊ី សាអូឌីត នោះ ទេ ខណៈ បារាំង អាល្លឺម៉ង់ អង់គ្លេស រួមទាំង សហរដ្ឋ អាមេរិក សុទ្ធតែ ព្រមាន ដូចគ្នា ថា នឹង ដាក់ទណ្ឌកម្ម លើ មហាសេដ្ឋី ប្រេង និង ម៉ូយ ទិញ អាវុធ របស់ ពួកគេ មួយ នេះ បើសិនជា អារ៉ាប៊ី សាអូឌីត មាន ជាប់ពាក់ព័ន្ធ នឹង ការសម្លាប់ លោក Khashoggi មែន នោះ ។
ចំណែកឯ ព្រះអង្គម្ចាស់ រាជ ទាយាទ មហាំ ម៉ាត់ ប៊ិន សាល់ម៉ាន ដែល ត្រូវបាន សមាជិក សភា អាមេរិក ខ្លះ ចោទ ថា ជា សម្លាប់ លោក Khashoggi ដែល ជា អ្នករិះគន់ ឥត សម្ចៃ មាត់ លើ ការដឹកនាំ របស់ ព្រះអង្គ បាន ច្រានចោល រាល់ ការចោទប្រកាន់ ស្រប ពេល មន្ត្រី អារ៉ាប៊ី សាអូឌីត ព្រមាន ថា នឹង ចាត់ វិធានការសងសឹក នឹង ការដាក់ទណ្ឌកម្ម ទាំងឡាយ ៕
ប្រភព៖ AFP ( ថ្ងៃព្រហស្បតិ៍ ទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ) រដ្ឋមន្ត្រី កសិកម្ម និង ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ កម្ពុជា ប្តេជ្ញា រួមគ្នា បន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ជល ផល
ជា កិច្ច ស្វាគមន៍ ក្នុង នាម ឲ្យ រាជ រដ្ឋាភិបាល កម្ពុជា និង លោក រដ្ឋមន្ត្រី ផ្ទាល់ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ រាជ រដ្ឋាភិបាល ជប៉ុន ដែល បាន ដើរ តួនាទី ជា តួអង្គ យ៉ាង សំខាន់ ក្នុង ការស្តារ និង អភិវឌ្ឍន៍ ប្រទេស កម្ពុជា លើ គ្រប់ វិស័យ ជាពិសេស វិស័យ កសិកម្ម ។ លោក រដ្ឋមន្ត្រី ជឿជាក់ ថា កិច្ចសហប្រតិបត្តិការ យ៉ាង ស៊ីជម្រៅ រវាង ប្រទេស ទាំង ពីរ នឹង បន្ត ប្រកបដោយ ចីរភាព ។
នា ក្នុង ឱកាស នេះ លោក ឯក អគ្គ រាជ ទូត សូម ធ្វើ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការអភិវឌ្ឍន៍ នៃ ប្រទេស កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ រាជ រដ្ឋាភិបាល ។ ចំពោះ ជំនួប នា ថ្ងៃ នេះ លោក ឯក អគ្គ រាជ ទូត បាន ជម្រាប ថា គឺ ដើម្បី ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ លើ វិស័យ ជល ផល រួម ជាមួយ ការអញ្ជើញ លោក រដ្ឋមន្ត្រី ទៅ ធ្វើ ទស្សនកិច្ច ផ្លូវការ និង ជូល រួម កិច្ចប្រជុំ នៅ ប្រទេស ជប៉ុន ក្នុង ខែមេសា ឆ្នាំ ២០១៩ ខាងមុខ ។
ប្រតិកម្ម របស់ អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច បាន ធ្វើឡើង បន្ទាប់ពី នាយក ទទួលបន្ទុក ផ្នែក ទំនាក់ទំនង នៃ សហភាព អន្តរសភា IPU លើកឡើង នា ថ្មី ៗ នេះ ថា ចំណាត់ការ របស់ IPU ចំពោះ ការចេញ សេចក្តីសម្រេច សម្រាប់ ប្រទេស កម្ពុជា កន្លងមក មិន គួរ ត្រូវបាន បកស្រាយ ថា ជា ការ « ជ្រៀត ជ្រែក » កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា ទេ ខណៈ ដែល ខ្លួន គ្រាន់តែ តាមដាន ការ « រំលោភបំពាន » សិទ្ធិ របស់ សមាជិក សភា និង ទាមទារ ឲ្យ មាន ការ « លើកកម្ពស់ សិទ្ធិ » របស់ កម្ពុជា តែ ប៉ុណ្ណោះ ។
លោក សុខ ឥសាន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ៖ « វា គ្រាន់តែ ជា អង្គការ ចាត់តាំង មួយ បម្រើន យោបាយ និង មនោគមន៍វិជ្ជា អន្តរជាតិ ណាមួយ ប៉ុណ្ណោះ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា ស្រប ច្បាប់ កើត ចេញពី ការបោះឆ្នោត និង មាន ឯករាជ្យ និង មាន អធិបតេយ្យភាព ពេញលេញ មិន ខ្ចី យក ត្រចៀក ស្តាប់ និង មើល ឡើយ » ។
អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច បាន បន្ត ថា តែ ផ្ទុយទៅវិញ បើ រាល់ ការបង្គាប់បញ្ជា និង តម្រូវ របស់ ខ្លួន នោះ មិន ត្រូវបាន អនុវត្ត តាម ទេ និង គ្មាន ប្រសិទ្ធភាព ទេ នោះ បាន សេចក្តី ថា គណៈកម្មាធិការ សិទ្ធិ មនុស្ស IPU នេះ មិន ខ្មេះ ទេ អត់ បាន ការ ទាល់តែសោះ ។ បើ ពិតជា ចៅហ្វាយ នាយ កម្ពុជា ជា ម្ចាស់ អាណានិគមន៍ លើ កម្ពុជា និង បើ ជា ថៅកែ លើ កូន ឈ្នួល កម្ពុជា មែន នោះ រាល់ ការបង្គាប់បញ្ជា និង ការតម្រូវ ទាំង បី ចំណុច ខាងលើ នេះ ប្រាកដជា មាន ប្រសិទ្ធភាព យ៉ាង ជាក់ស្តែង តាម ការចង់បាន របស់ ខ្លួន ។
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល បាល ព្រហ្មទណ្ឌ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែន ជ័យ បាន ឃាត់ខ្លួន ស្រ្តី ម្នាក់ ដែល ជា មេតុង ទីន ដែល បាន បោក គ្រាប់បែក រត់ ចោល កូន តុង ទីន ដែល ក្រុម អាជីវករ ផ្សារ ឯករាជ្យ១ និង អាជីវករ ផ្សារ កាណាឌីយ៉ា ជិត ៥០០ នាក់ សរុប ជា ទឹកប្រាក់ ជាង ៣០ម៉ឺន ដុល្លារ បាន វិច បង្វិច រត់ គេច អស់ រយៈពេល ជាង ៥ខែ
ការឃាត់ខ្លួន នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ចំណុច ផ្សារ កាណាស៉ី ធី ស្ថិត នៅក្នុង សង្កាត់ ចោម ចៅ២ ខណ្ឌ ពោធិ៍សែនជ័យ ក្រោយ មាន ពាក្យបណ្តឹង ពី ជនរងគ្រោះ ដែល ជា កូនតុង ទីន ។
រដ្ឋបាល ខេត្ត កំពង់ធំ រៀបចំ សិក្ខាសាលា ផ្សព្វផ្សាយ ផែនការ មេជាតិ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា ឆ្នាំ ២០១៤ - ២០២០
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៨ បាន រៀបចំ បើក សិក្ខាសាលា ប្រជុំ ផ្សព្វផ្សាយ ផែនការ មេជាតិ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា ឆ្នាំ ២០១៤ - ២០២០ នូវ ការអនុវត្ត បទដ្ឋាន គតិយុត្ត និង ទិសដៅ ការងារ ជំរុញ សម្របសម្រួល ការអភិវឌ្ឍ វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ។
សិក្ខាសាលា នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ទួន ថា វរៈ រដ្ឋលេខាធិការ ក្រសួង ផែនការ និង ជា អនុប្រធាន នៃ ក្រុមប្រឹក្សា ជាតិ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា . លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ និង មាន ការអញ្ជើញ ចូលរួម ពី ប្រធាន អង្គភាព មន្ទីរ ជុំវិញ ខេត្ត អាជ្ញាធរ ក្រុង - ស្រុក ជាង ១៦០ នាក់ ។
លោក បាន បន្ត ថា ការស្រាវជ្រាវ និង អភិវឌ្ឍន៍ ក៏ ត្រូវបាន ចាត់ទុក ជា គ្រឹះ នៃ ការអភិវឌ្ឍ ក្នុង គ្រប់ វិស័យ និង ជា ឆ្អឹង ខ្នង នៃ ការប្រកួតប្រជែង សេដ្ឋកិច្ច ប្រកបដោយ មោទនភាពជាតិ នៅ ទូទាំង ពិភពលោក ផងដែរ ដើម្បី ធានា បាន សមត្ថភាព ការស្រាវជ្រាវ និង អភិវឌ្ឍ យើង ចាំបាច់ ត្រូវ យល់ដឹង អំពី ស្ថានភាព នៃ កិច្ចការ លាភ ពេល បច្ចុប្បន្ន ដើម្បី ជា មូលដ្ឋាន ក្នុង ការតម្រង់ ទិស និង ការរៀបចំ ការវិនិយោគ លើ ការស្រាវជ្រាវ និង អភិវឌ្ឍ ក៏ ដូចជា ផែនការអភិវឌ្ឍ វិទ្យាសាស្រ្ត និង បច្ចេកវិទ្យា នា ពេល អនាគត ។
ជា ចុងក្រោយ លោក បាន ជំរុញ ដល់ សិក្ខាកាម ទាំងអស់ ដែល បាន ចូលរួម សូម យកចិត្តទុកដាក់ ទាំងអស់ គ្នា សូម ចូលរួម ឲ្យបាន ផុសផុល ទាំង សកម្មភាព ប្រកបដោយ ស្មារតី យកចិត្តទុកដាក់ ទាំង លើ ផ្នែក ទ្រឹស្ដី ទាំង លើ ផ្នែក អនុវត្ត ៕ រដ្ឋមន្ត្រី ត្រាំ អ៊ីវតឹក អញ្ជើញ បើក សិក្ខាសាលា ស្ដីពី « ការពង្រឹង សន្តិសុខ បច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន »
សិក្ខាសាលា នេះ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ និង មន្ត្រី ទទួលបន្ទុក ការងារ បច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន មកពី បណ្ដា ក្រសួង - ស្ថាប័ន ក្រុមហ៊ុន ដែល ទើប បង្កើត ថ្មី (start-up) និង ក្រុមហ៊ុន ដែល ពាក់ព័ន្ធ ក្នុង វិស័យ ឧស្សាហកម្ម បច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន ប្រមាណ ១២០ នាក់ ។
យោង តាម Facebook ផ្លូវការ របស់ លោក រដ្ឋមន្ត្រី បាន ចុះផ្សាយ ថា គោលបំណង នៃ សិក្ខាសាលា គឺ ដើម្បី ស្វែងយល់ ពី តួនាទី សន្តិសុខ នៅក្នុង បដិវត្តន៍ ឧស្សាហកម្ម ជំនាន់ ទី៤ ទស្សនៈ ជា សកល អំពី បញ្ហា ប្រឈម នៃ ការស្ថាបនា ប្រព័ន្ធ សន្តិសុខ និង និន្នាការ ថ្មី ៗ នៃ ការវាយប្រហារ តាម ប្រព័ន្ធ អ៊ីនធឺណិត លើ ស្ថាប័ន រដ្ឋ និង ឯកជន ។
