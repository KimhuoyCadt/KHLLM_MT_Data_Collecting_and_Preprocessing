( ភ្នំពេញ ) ៖ លោក ហែម ដារិទ្ធិ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ អម ដំណើរ ដោយ មន្ដ្រីរាជការ និង អ្នក ពាក់ព័ន្ធ ជាច្រើន នាក់ នៅ ព្រឹក ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ២០១៨ - ២០១៩ និង ផ្តល់ ជូន នូវ ម៉ូតូ ជូន សិស្ស ពូកែ ចំនួន ៦នាក់ ប្រលង ជាប់ ទិន្ទេស A ម្នាក់១ គ្រឿង តាម ការសន្យា ។
លោក ហែម ដារិទ្ធិ ក៏ បាន សម្ដែង នូវ មោទនៈ ភាព ជាមួយ លទ្ធផល គួរឲ្យ សរសើរ របស់ វិទ្យាល័យ ហ៊ុន សែន ជម្ពូវ័ន្ត ដែល បាន រួមចំណែក ក្នុង វិស័យ អប់រំ នៅ កម្ពុជា ស្រប ទៅតាម ប្រសាសន៍ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល តែងតែ លើកឡើង ជារឿយ ៗ ថា ការអភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ រីកចម្រើន ទៅ បាន ចាំបាច់ ត្រូវ មាន ការចូលរួម ពី វិស័យ ឯកជន ។
លោក អភិបាល ខណ្ឌ រូប នេះ ក៏ បាន បញ្ជាក់ ដែរ ថា ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ យើង ឃើញ ថា គុណភាព អប់រំ គ្រប់ កម្រិត មាន ការកើនឡើង និង ការប្រកួតប្រជែង យ៉ាង ខ្លាំង ហើយ រាជ រដ្ឋាភិបាល តែងតែ លើកទឹកចិត្ត ដល់ សិស្ស ពូកែ និង មាន ការប្រឡង ដោយ យុត្តិធម៌ ពោល អ្នក ចេះ គឺជាប់ ។
លោក ហែម ដារិទ្ធិ បាន ផ្ដាំផ្ញើ ឲ្យ សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង រៀនសូត្រ ជៀសវាង ការប្រព្រឹត្ត នូវ ទង្វើ ខុស ច្បាប់ និង អ្វី មិន ល្អ ដល់ សង្គមជាតិ និង ខ្លួន ឯង ដើម្បី សម្រេច ទិសដៅ អនាគត និង ដើម្បី ក្លាយជា ធនធាន ដ៏ មាន តម្លៃ សម្រាប់ គ្រួសារ សង្គម និង ប្រទេសជាតិ នា ពេល អនាគត ៕
ថ្លែង ក្នុង ពិធី ធ្វើ បទបង្ហាញ ប្រព័ន្ធ បច្ចេកវិទ្យា ថ្មី ៗ ក្នុង វិស័យ ការពារ ជាតិ នៅឯ រដ្ឋធានី អង់ការ៉ា លោក អឺ ដូហ្គាន់ បាន ឲ្យដឹង យ៉ាង ដូច្នេះ ថា « ពួកយើង ត្រូវការ ប្រព័ន្ធ ការពារ ដែន អាកាស រយៈ ចម្ងាយ ឆ្ងាយ ដែល ជា របស់ យើង ផ្ទាល់ ហើយ នា ពេលនេះ យើង កំពុង បោះជំហាន ដំបូង ដើម្បី ឆ្ពោះទៅ សម្រេច គោលដៅ នេះ ។ ប្រទេស យើង បាន ចាប់ផ្តើម អភិវឌ្ឍន៍ ប្រព័ន្ធ ជា ស្នាដៃ ផ្ទាល់ខ្លួន ដែល នឹង ត្រូវ ហៅ ថា Siper ។ ការធ្វើតេស្ត លើក ដំបូង ត្រូវបាន គ្រោង នឹង ប្រព្រឹត្តទៅ នា ចុង ឆ្នាំ ២០២១ » ។
( ភ្នំពេញ ) ៖ អភិបាល ខេត្ត កំពង់ស្ពឺ លោក វ៉ី សំណាង បាន ចេញ ដីកា ស្តីពី ការបដិសេធ និង ដកហូត ដី ព្រៃឈើ ចំនួន ជាង ១៥១ ហិកតា ស្ថិត នៅក្នុង ដែន ជម្រក សត្វ ព្រៃ ភ្នំ ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ត្រូវបាន គេ កាប់ រាន ដុត ឈូសឆាយ និង ហ៊ុមព័ន្ធ កាន់កាប់ ដើម្បី វាត យក ដី ធ្វើជា កម្មសិទ្ធិ ។
ព័ត៌មាន លម្អិត សូម អាន ដីកា របស់ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ទាំង ស្រុង៖ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ អំពាវនាវ សិស្សានុសិស្ស ជៀស ឆ្ងាយ ពី គ្រឿងញៀន និង ចូលរួម ទប់ស្កាត់ បញ្ហា នេះ ឲ្យបាន ទាំងអស់ គ្នា
( ភ្នំពេញ ) ៖ នាយ ឧត្ដមសេនីយ៍ ជួន សុវណ្ណ អនុប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន អំពាវនាវ សិស្សានុសិស្ស ចូលរួម និង គាំទ្រ ទាំងអស់ គ្នា ក្នុង ការបង្ការ និង ទប់ស្កាត់ បញ្ហា ដែល មាន ការពាក់ព័ន្ធ គ្រឿងញៀន ព្រោះ ការប្រើប្រាស់ ឬ ការពាក់ព័ន្ធ នឹង គ្រឿងញៀន មិន ត្រឹមតែ ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ សុខភាព ជីវភាព និង សុវត្ថិភាព របស់ បុគ្គល ប៉ុណ្ណោះ ទេ តែ វា នឹង ប៉ះពាល់ ដល់ គ្រួសារ សហគមន៍ និង សង្គមជាតិ ទាំងមូល ផងដែរ ។
ការថ្លែង បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ត្រូវបាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា តំណាង ឧប នាយក រដ្ឋមន្ដ្រី កែ គឹម យ៉ាន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នៅ ព្រឹក ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ អញ្ជើញ ជា អធិបតី បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី នៅ វិទ្យាល័យ ឥន្រ្ទ ទេវី ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក លោកស្រី មាតាបិតា សិស្ស លោកគ្រូ អ្នកគ្រូ គណគ្រប់គ្រង សាលា សិស្សនុសិស្ស សរុប ៥០០ នាក់ ។
ក្នុង ឱកាស នោះ លោក នាក់ សុទ្ធា នាយក តំណាង គណគ្រប់គ្រង សាលា បាន ថ្លែង ស្វាគមន៍ អរគុណ ដល់ គណអធិបតី ភ្ញៀវ កិត្តិយស និង របាយការណ៍ ពី វឌ្ឍនភាព ការរីកចម្រើន របស់ សាលា ទាំង ផ្នែក ហេដ្ឋារចនាសម្ព័ន្ធ កីឡា និង បរិស្ថាន ស្អាត សំដៅ បម្រើ ដល់ ការរីកចម្រើន ផ្នែក បញ្ញា សុខភាព ដល់ សិស្សានុសិស្ស ។
ក្នុង នាម ឧប នាយក រដ្ឋមន្ដ្រី កែ គឹម យ៉ាន . នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ បាន ថ្លែង ការកោតស សើរ ដល់ ការរីកចម្រើន របស់ សាលា សំដៅ ប្រសិទ្ធភាព គុណភាព សិក្សា របស់ សិស្ស និង បាន សំដែង នូវ មនោសញ្ចេតនា សប្បាយរីករាយ ក្រៃលែង ជាមួយ លោក លោកស្រី លោកគ្រូ អ្នកគ្រូ និង ក្មួយ ៗ ជា សិស្សានុសិស្ស ទាំងអស់ ក្នុង ពិធី បើក បវេសនកាល ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃពុធ កន្លងទៅ អាជ្ញាធរ អាមេរិក បាន ចោទប្រកាន់ ជា ផ្លូវការ លើ មន្ត្រី ស៊ើបការណ៍ ចិន ម្នាក់ ពី បទ ប្រមូល ព័ត៌មាន និង លួច កម្មសិទ្ធិ បញ្ញា ពី បណ្ដា ក្រុមហ៊ុន ផលិត យន្ដហោះ អាមេរិក ។ ការលួច កម្មសិទ្ធិ បញ្ញា គឺជា មូលហេតុ មួយ ដែល ធ្វើ សង្រ្គាម ពាណិជ្ជកម្ម រវាង ទីក្រុប៉េកាំង និង ទីក្រុង វ៉ាស៊ីនតោន ផ្ទុះឡើង ក្នុង ពេល បច្ចុប្បន្ន ៕ ទេសរដ្ឋមន្ដ្រី ហ៊ឹម ឆែម ចូលរួម ពិធី បុណ្យ វប្បធម៌ ព្រះពុទ្ធ សាសនា សិន ជិក លើក ទី១០ នៅ វត្ត ហុងហ្វា សិន ជិន ប្រទេស ចិន (Video inside)
( សិន ជិន - ចិន ) ៖ លោក ទេសរដ្ឋមន្ដ្រី ហ៊ឹម ឆែម រដ្ឋមន្ត្រី ក្រសួង ធម្មការ និង សាសនា នៅ ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៨ អញ្ជើញ ចូលរួម ក្នុង ពិធី បុណ្យ វប្បធម៌ ព្រះពុទ្ធ សាសនា សិន ជិក លើក ទី១០ និង ពិធី ប្រកាស បង្កើត អគ្គ លេខាធិការដ្ឋាន សន្និសីទ តុ មូល ព្រះពុទ្ធ សាសនា សិន ជិន ស្តីពី កិច្ចប្រជុំ តុ មូល សិន ជិន ព្រះពុទ្ធ សាសនា សមុទ្រ ចិន ខាងត្បូង លើក ទី៣ ដែល បាន ប្រារព្ធ ធ្វើ នៅ វត្ត ហុង ហ្វា ក្រុង សិន ជិន នៃ សាធារណៈ ប្រជាមានិត ចិន ។
ព្រះគ្រូ យិន ស៊ុន បាន ស្នើ នូវ គំនិត ផ្តួចផ្តើត ដូចជា ការអភិវឌ្ឍ នៃ ( ទិន្នន័យ ពុទ្ឋ សាសនា សមុទ្រ ខាងត្បូង ) ការបង្កើត មូលនិធិ ផ្លូវ សូត្រ សមុទ្រ ចិត ខាងត្បូង និង ( វិទ្យាស្ថាន ស្រាវជ្រាវ វប្បធម៌ សមុទ្រ ខាងត្បូង ) និង កិច្ចប្រជុំ ប្រចាំ ឆ្នាំ តុ មូល ព្រះពុទ្ធ សាសនា សមុទ្រ ចិន ខាងត្បូង ។
សហគមន៍ ពុទ្ធសាសនា នៅ តំបន់ សមុទ្រ ចិន ខាងត្បូង គួរតែ សម្រេចបាន នូវ ភាពចម្រុង ចម្រើន រួមគ្នា ក្នុង ការការពារ សុខុមាលភាព របស់ ប្រជាជន នៅក្នុង តំបន់ ។ ការរៀបចំ កិច្ចប្រជុំ តុ មូល របស់ អ្នកកាន់ ព្រះសាសនា នៅ សមុទ្រ ចិន ខាងត្បូង ធ្វើឡើង ឲ្យបាន ទៀងទាត់ ៕
បុគ្គលិក អាជ្ញ ជាធ អប្សរា ទើប ចូល បម្រើ ការងារ ថ្មី ១០០ នាក់ ទទួលបាន ការបណ្ដុះបណ្តាល លើ កិច្ចការពារ និង គ្រប់គ្រង រមណីដ្ឋាន អង្គរ
លោក អ៊ឹម សុខ រិទ្ធី អនុប្រធាន មជ្ឈមណ្ឌល អន្តរជាតិ ស្រាវជ្រាវ និង តម្កល់ ឯកសារ អង្គរ តំណាង ឱ្យ លោក ស៊ុ ម៉ាប់ អគ្គ នាយក អជ្ញាធរ ជាតិ អប្សរា បាន ឱ្យដឹង ថា កម្មវិធី បណ្តុះបណ្តាល នេះ មាន សារសំខាន់ ណាស់ ដែល អាច ផ្តល់ ចំណេះដឹង ជា មូលដ្ឋាន ដល់ បុគ្គលិក ដែល បម្រើ ការងារ នៅ តាម ប្រាសាទ ដែល ស្ថិត នៅ ជួរ មុខ ប្រៀប បានជា ខ្សែ ត្រៀម ស្ថិត នៅជាប់ ជាមួយ ប្រាសាទ ប្រតិបត្តិការណ៍ ផ្ទាល់ ជាពិសេស ជាមួយ ភ្ញៀវ ទេសចរ ។
លោក បាន បន្ត ថា យើង មាន គោលការណ៍ សិក្សា រៀនសូត្រ បន្តិច ម្តង ៗ ជា បន្តបន្ទាប់ និង មាន ភាព សាមគ្គី គ្នា ផ្តល់ ព័ត៌មាន ឱ្យ គ្នា ទៅ វិញ ទៅ មក ហើយ អាច យក ចំណេះដឹង ផ្ទាល់ខ្លួន នេះ ទៅ អប់រំ ផ្សព្វផ្សាយ បន្ត ដល់ សហគមន៍ ជៀសវាង ការទទួលយក ព័ត៌មាន មិន ពិត ។
លោក ស្វាយ ពិសិដ្ឋ តំណាង ឱ្យ នាយកដ្ឋាន អភិវឌ្ឍន៍ ទេសចរណ៍ អង្គរ បាន លើកឡើង ក្នុង ឱកាស នោះ ដែរ ថា សិក្ខាកាម ដែល មាន វត្តមាន នៅ ទីនេះ ពិតជា បាន ខិតខំ ប្រឹងប្រែង តស៊ូ អត់ធ្មត់ ដោយ ឆ្លងកាត់ ការធ្វើតេស្ត សមត្ថភាព ដោយ សរសេរ និង ផ្ទាល់ មាត់ បាន យ៉ាង ជោគជ័យ ។ លោក បាន បន្ត ទៀត ថា ក្នុង នាមជា អ្នកធ្វើ ការបម្រើ បេតិកភណ្ឌ ត្រូវ ស្វែងយល់ ពី បេតិកភណ្ឌ និង ចូលរួម ថែរក្សា ទាំងអស់ គ្នា ។
គួរ បញ្ជាក់ ថា វគ្គ បណ្តុះបណ្តាល នេះ ផ្តោត សំខាន់ ទៅ លើ ប្រវត្តិសាស្រ្ត អារ្យធម៌ និង បេតិកភណ្ឌ ។ លើស ពី នេះ គឺ គោលការណ៍ អភិរក្ស តំបន់ រមណីយដ្ឋាន អង្គរ បេតិកភណ្ឌ ពិភពលោក ការគ្រប់គ្រង បេតិកភណ្ឌ វប្បធម៌ និង អនុសញ្ញា បេតិកភណ្ឌ ពិភពលោក បង្ហាញ ដល់ សិក្ខាកាម ផងដែរ មុននឹង លើកឡើង អំពី អាជ្ញាធរ ជាតិ អប្សរា និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ ទាក់ទង អំពី ការគ្រប់គ្រង មន្ត្រី - បុគ្គលិក ។
សម្តេច តេជោ បាន មានប្រសាសន៍ ថា បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ២០១៨ - ២០១៩ នេះ ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច សូម សម្តែង នូវ ក្តី សោមនស្ស រីករាយ យ៉ាង ក្រៃលែង និង សូម ចូលរួម ប្រកបដោយ ភាពស្និទ្ធស្នាល ជាមួយ ជន រួម ជាតិ ស្រប ពេល ដែល ឆ្នាំ ២០១៨ ជា ខួប លើក ទី២០ នៃ ការបង្រួបបង្រួម ជាតិ ការរក្សា បាន សន្តិភាព ពេញលេញ ជូន ប្រទេសជាតិ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
សម្តេច បាន មានប្រសាសន៍ បន្ត ថា ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ជា ថ្ងៃ ដ៏ មាន អត្ថន័យ យ៉ាង ជ្រាលជ្រៅ បំផុត របស់ ក្មួយ ៗ ជា សិស្សានុសិស្ស ចំណេះ ទូទៅ ទាំងអស់ ដែល ជា កុលបុត្រ កុល ធីតា ជាទី ស្រលាញ់ របស់ យើង គ្រប់ ៗ គ្នា មាន ឱកាស ទទួលបាន នូវ ការអប់រំ ឱកាស ក្នុង ការបន្ត ការសិក្សា រៀនសូត្រ និង ជា ថ្ងៃ ចាប់ផ្តើម ជីវិត សិក្សា ដំបូង របស់ កុមារ តូច ៗ ដែល ទើបនឹង ដល់ អាយុ ចូល សាលារៀន ។
ខាងក្រោម នេះ ជាសារលិខិត ទាំងស្រុង របស់ សម្តេច តេជោ ហ៊ុន សែ ន៖
សូម កុំ បើកបរ លើស ល្បឿន កំណត់ ! ស្លាប់ ៥នាក់ និង របួស ៨នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៣១ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ធ្ងន់ ៨នាក់ និង របួស ស្រាល ២នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង១០លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៨ គ្រឿង . រថយន្ត តូច ៦គ្រឿង . រថយន្ដ ធំ ៤គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ មិន ប្រកាន់ ស្ដាំ . មិន គោរព សិទ្ធិ . ប្រជែង . បត់ គ្រោះថ្នាក់ . និង ល្បឿន ។
