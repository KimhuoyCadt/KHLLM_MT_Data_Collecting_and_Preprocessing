( ព្រះវិហារ ) ៖ ទំនិញ ជាច្រើន មុខ ត្រូវបាន មន្ត្រី កាំ កុងត្រូល ខេត្ត ព្រះវិហារ ដុត កម្ទេចចោល ក្រោយ ត្រួតពិនិត្យ រកឃើញ នៅ តាម ផ្ទះ លក់ ទំនិញ នានា របស់ អាជីវករ ក្នុង ភូមិ ស្រយ៉ង់ ឃុំ ស្រយ៉ង់ ស្រុក គូលែន ខេត្ត ព្រះវិហារ កាលពី ល្ងាច ថ្ងៃទី ០៥ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ។
លោក ដួង មុនី ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ០៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ថា មន្ត្រី កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត អាជ្ញាធរដែនដី បាន ចុះ ត្រួតពិនិត្យមើល ទំនិញ វេចខ្ចប់ ស្រាប់ ដែល តាំង លក់ដូរ នៅ តាម ផ្ទះ នៅ ភូមិ ស្រយ៉ង់ ស្រុក គូលែន ខេត្ត ព្រះវិហារ ។
លោក ថា ក្រុមការងារ បាន ដកហូត ទំនិញ ជាច្រើន មុខ ដែល ខូច គុណភាព ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ រួម មាន៖ ទឹកក្រូច ចំរុះ ចំណុះ ១៣០. ១៥លីត្រ . ទឹក ផ្លែឈើ ចំណុះ ២៩លីត្រ . ទឹក ភេសជ្ជៈ Samurai ចំណុះ ១៤.៤លីត្រ និង ទឹក ភេសជ្ជៈ ប៉ូវ កម្លាំង ចំនុះ២. ៧៥លីត្រ ។ លោក បន្ត ទៀត ថា ទំនិញ ទាំងនោះ ក្រោយ ដកហូត ត្រូវបាន ក្រុមការងារ ប្រមូល យក ទៅ ដុត កម្ទេចចោល ផងដែរ ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បានុស្វាគមន៍ និង បាន លើក យក ពី ការគាំទ្រ យ៉ាង ពេញលេញ ពី ភាគី ដល់ ការស្វែងរក សន្តិភាព របស់ កម្ពុជា និង ក្រោយ កម្ពុជា ទទួលបាន នូវ សន្តិភាព នៃ កិច្ចព្រមព្រៀង សន្តិភាព ទីក្រុង ប៉ារីស តែ កម្ពុជា នៅតែ មិន អាច ខ្វះ បាន នូវ កិច្ចសហការ ពី ភាគី មិត្ត ក្នុង នាម ជា ប្រទេស ជិតខាង ជា បងប្អូន ដែល មាន ទំនាក់ទំនង ជាមួយគ្នា លើ គ្រប់ វិស័យ ជាយូរ លង់ ណាស់ មកហើយ ។
ក្នុង ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ក៏ បាន មាន ជម្រាប ជូន ភ្ញៀវ ផងដែរ ពី លទ្ធផល កិច្ចសហប្រតិបត្តិការ ត្រួតពិនិត្យ គ្រឿងញៀន កម្ពុជា - ថៃ នា ពេល កន្លងមក ដូចជា មាន ជា អាទិ៍៖
ទន្ទឹមនឹង នេះ សំដៅ ធានា ប្រសិទ្ធភាព លើ ការងារ ត្រួតពិនិត្យ គ្រឿងញៀន នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន ស្នើសុំ ការជួយ ពី ភាគី ថៃ ដូច ខាងក្រោម៖
ជា ការកិច្ច ឆ្លើយតប លោក ផាន់ យ៉ារ៉ាក់ ភូល ថាប់ អគ្គ រាជ ទូត ថៃ បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការរីកម្រើន របស់ កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្រោយ ទទួលបាន នូវ កិច្ចព្រមព្រៀង សន្តិភាព ទីក្រុង ប៉ារីស ។
ទន្ទឹមនឹង នេះ ភាគី ថៃ បាន ឯកភាព ទាំងស្រុង លើសភាព គ្រឿងញៀន ដែល បាន លើកឡើង ដោយ ឧបនាយ រដ្ឋមន្រ្តី កែ គឹម យ៉ាន និង ទទួលយក នូវ រាល់ សំណូមពរ សំដៅ ពង្រឹង កិច្ចសហប្រតិបត្តិការ ត្រួតពិនិត្យ គ្រឿងញៀន ៕ បណ្ឌិត សុខ ទូច៖ អក្សរ ខ្មែរ លើ សិលាចារឹក លែង ជា អាថ៌កំបាំង សម្រាប់ យុវជន កម្ពុជា នា សម័យ ទំនើប នេះ ហើយ
បណ្ឌិត សភាចារ្យ សុខ ទូច បាន បញ្ជាក់ ថា ដើម្បី ពង្រីក និង ពង្រឹង ភាសា អក្សរ ខ្មែរ ទាំង បុរាណ និង សម័យ ក្នុង វិស័យ វិទ្យាសាស្រ្ត ជាពិសេស វិស័យ បច្ចេកវិទ្យា ព័ត៌មាន និង ក៏ ដូចជា ដើម្បី រួមចំណែក បំពេញ តម្រូវ ការចាំបាច់ បច្ចុប្បន្ន របស់ អ្នកប្រើប្រាស់ កុំព្យូទ័រ ក្នុង និង ក្រៅ ប្រទេស កម្ពុជា តាមរយៈ ការបង្កើត ពុម្ភ អក្សរ ខ្មែរ បុរាណ និង ការបង្កើត កម្មវិធី អូស៊ី អខ្មែរ សម្រាប់ ស្គែន ពុម្ភ អក្សរ ខ្មែរ លើ សិលាចារឹក មក ជា ពុម្ភ អក្សរ ខ្មែរ នា សម័យ ទំនើប ។
ចាប់រំលោភ ក្មេងស្រី អាយុ ១៤ ឆ្នាំ បាន សម្រេច ត្រូវ នគបាល ចាប់ វាយ ខ្នោះ នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ប៉ុស្តិ៍ ចោម ចៅ ទី១ នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ បាន ចាប់ វាយ ខ្នោះ ជន យុវជន ម្នាក់ ភ្លាម ៗ បន្ទាប់ពី យុវជន រូប នោះ បាន ចាប់ អូស ដៃ ក្មេងស្រី វ័យ ១៤ឆ្នាំ ម្នាក់ ចាប់រំលោភ នាង បាន សម្រេច តែ ត្រូវ មីង ជនរងគ្រោះ មក ទាន់ ប្តឹង ឲ្យ នគរបាល ជួយ អន្តរាគមន៍ ទាន់ ពេល ។
ហេតុការណ៍ ខាង លើ នេះ បាន កើតឡើង នៅ យប់ ថ្ងៃទី ០៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ស្ថិត នៅ បន្ទប់ ជួល កំពង់ សាងសង់ ជាន់ ទី១ ស្ថិត នៅក្នុង ភូមិ ត្រពាំង ថ្លឹង២ សង្កាត់ ចោម ចៅ១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
មន្ត្រី នគរបាល មូលដ្ឋាន បាន ឲ្យដឹង ថា ជនសង្ស័យ មាន ឈ្មោះ សាន ចន្នី អាយុ ២២ ឆ្នាំ មាន ទីលំនៅ ភូមិ អង្គ ជ័យ ឃុំ ស្រលប់ ស្រុក ត្បូង ឃ្ញុំ ខេត្ត ត្បូងឃ្មុំ មុខរបរ ជាង ដែក នៅ ម្តុំ ព្រែក លៀប បច្ចុប្បន្ន ស្នាក់ នៅ សង្កាត់ ព្រែក លៀប ខណ្ឌ ជ្រោយ ចង្វារ ។ ចំណែក ជនរងគ្រោះ ឈ្មោះ គ.ស.ឡ អាយុ ១៤ ឆ្នាំ ស្នាក់ នៅ បន្ទប់ លេខ ២២៨B ជាន់ ទី១ ភូមិ ត្រពាំង ថ្លឹង២ សង្កាត់ ចោម ចៅ១ ខណ្ឌ ពោធិ៍សែនជ័យ ។
មន្ត្រី នគរបាល បាន បន្ត ទៀត ថា បន្ទាប់ពី ជនសង្ស័យ បាន សុំ លេខ ទូរស័ព្ទ នាង នោះ ដោយ ភ្លើង តណ្ហា បាន ពុះកញ្ជោល ឡើង ខ្លាំង នោះ ជនសង្ស័យ ក៏ បាន ចាប់ អោប ថើប ប៊ឺតមាត់ និង បាន យក ដៃ ប បោស អង្អែល រាវ ស្ទាប ច្របាច់ សព្វប្រាណ របស់ នាង ខណៈ នោះ ជនរងគ្រោះ មិន ស្រែក នោះ ឡើយ គ្រាន់ នាង និយាយ ថា មិន ចូលចិត្ត អ្នក ធ្វើ ចឹង ទេ ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន នគរបាល ប៉ុស្តិ៍ ចោម ចៅ១ នាំ ខ្លួន មក សួរ នាំ និង កសាង សំណុំរឿង បញ្ចូន ទៅ កាន់ ផ្នែក ជំនាញ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដើម្បី បន្ត តិនិវិធី ច្បាប់ ៕ ទេសរដ្ឋមន្រ្តី លី ធុជ ស្នើឲ្យ អង្គការ សហ ប្រជាជាតិ គោរព អធិបតេយ្យភាព និង មិន ជ្រែត ជ្រែក កិច្ចការ ផ្ទៃក្នុង ប្រទេស ដទៃ ដោយ អនុលោម តាម ធម្មនុញ្ញ របស់ ខ្លួន
( ភ្នំពេញ ) ៖ ទេសរដ្ឋមន្ត្រី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន បាន ស្នើសុំ ឲ្យ អង្គការ សហ ប្រជាជាតិ (UN) បន្ត ការពារ អធិបតេយ្យភាព ឯករាជ្យភាព និង មិន ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស នីមួយ ៗ ដោយ អនុលោម ទៅតាម ធម្មនុញ្ញ របស់ អង្គ សហ ប្រជាជាតិ ។
