( ភ្នំពេញ ) ៖ លោក នុត ពុធ ដារ៉ា ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា អភិបាល ខណ្ឌ ដង្កោ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ អញ្ជើញ បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ បេតុង ចំនួន ០១ ខ្សែ ប្រវែង ២៧៤ ម៉ែត្រ និង ដាក់ លូ មូល រំដោះ ទឹក ០២ ខ្សែ ប្រវែង សរុប ១. ០៥៨ម៉ែត្រ ជា គម្រោង មូលនិធិ អភិវឌ្ឍ សង្កាត់ ឆ្នាំ ២០១៨ ក្នុង សង្កាត់ ដង្កោ និង សង្កាត់ ជើងឯក ។
ពិធី បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ និង លូ រួម មាន ស្ថាបនា ផ្លូវ បេតុង ០១ ខ្សែ ប្រវែង ២៧៤ ម៉ែត្រ ទទឹង ០៥ម៉ែត្រ ក្នុង ភូមិ ខ្វា សង្កាត់ ដង្កោ ដាក់ បំពង់ លូមូល រំដោះ ទឹក ០១ ខ្សែ ប្រវែង ៤៥៧ ម៉ែត្រ មុខ កាត់ ០.៦ម៉ែត្រ ស្ថិត ក្នុង ភូមិ ថ្មី សង្កាត់ ដង្កោ និង ដាក់ បំពង់ លូមូល រំដោះ ទឹក ០១ ខ្សែ ប្រវែង ៦០១ ម៉ែត្រ មុខ កាត់ ០.៦ម៉ែត្រ ក្នុង ភូមិ ជើងឯក សង្កាត់ ជើងឯក ។
លោក អភិបាល ខណ្ឌ បាន ធ្វើ ការលើកឡើង អំពី ការអភិវឌ្ឍ រីកចម្រើន របស់ ប្រទេសជាតិ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង បាន ធ្វើ ការ ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល ជានិច្ចកាល សម្តេច ទាំង ទ្វេរ តែង បាន គិតគូរ អំពី ការលំបាក របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ។
ផ្លូវ បេតុង ថ្មី ០១ ខ្សែ និង លូ២ ខ្សែ ក្នុង សង្កាត់ ទាំង២ នេះ នឹង ជួយ សម្រួល ដល់ ការធ្វើដំណើរ ប្រកបរបរ ចិញ្ចឹម ជីវិត របស់ បងប្អូន ប្រជាពលរដ្ឋ បញ្ជៀស ការលិចលង់ ព្រមទាំង ផ្តល់ សោភណ្ឌភាព នៃ ការរស់នៅ ផងដែរ ។
លោក នុត ពុធ ដារ៉ា បាន ធ្វើការ ថ្លែងអំណរគុណ ចំពោះ ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ ដង្កោ និង សង្កាត់ ជើងឯក ដែល បាន បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ឲ្យ ទទួលបាន ជ័យជម្នះ យ៉ាង ភ្លូក ទឹក ភ្លូក ដី ដើម្បី សម្តេច តេជោ ហ៊ុន សែន បន្ត ធ្វើជា នាយក រដ្ឋមន្ត្រី ដឹកនាំ ប្រទេស ឆ្ពោះ ទៅរក វឌ្ឍនភាព ការអភិវឌ្ឍ និង សុខ សន្តិភាព ។
លិខិត រួម របស់ ស្ថាប័ន ធុរកិច្ច អន្តរជាតិ តំណាង ក្រុមហ៊ុន ចំនួន ៣៣៥ ដែល មាន និយោជិត ជាង ៥ម៉ឺន នាក់ បាន សម្តែង នូវ ក្តីកង្វល់ យ៉ាង ធ្ងន់ធ្ងរ អំពី ដំណើរការ ឆ្ពោះ ទៅរក ការដកហូត ភាពអនុគ្រោះ ពន្ធ ផ្នែក ពាណិជ្ជកម្ម នៅក្រោម របប « អ្វី ៗ ទាំងអស់ លើកលែងតែ គ្រឿង សព្វាវុធ » (EBAs) ចេញ ពី ប្រទេស កម្ពុជា និង បារម្ភ ពី ផលវិបាក ដែល ការដកហូត នេះ អាច បង្កឱ្យ មាន ផល ប៉ះពាល់ ដល់ ប្រយោជន៍ ផ្នែក ពាណិជ្ជកម្ម យូរអង្វែង របស់ សហភាព អឺរ៉ុប នៅក្នុង ប្រទេស កម្ពុជា ។
លិខិត រួម នោះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « យើង ទទួលស្គាល់ ថា ពេលនេះ មិន ទាន់ មាន ការសម្រេច ណាមួយ ត្រូវបាន ធ្វើឡើង ដើម្បី ព្យួរ ឬ ដកហូត ឋានៈ អនុគ្រោះ EBA ពី ប្រទេស កម្ពុជា នៅក្នុង ឡើយ ទេ ហើយ យើង នៅតែ សង្ឃឹម ថា នឹង មាន ការចរចា បន្ត ទៅ ទៀត ដើម្បី ស្វែងរក ឱ្យ ឃើញ នូវ វិធី កាន់តែ ប្រសើរ សម្រាប់ ឆ្លើយតប ទៅនឹង ក្តីកង្វល់ នានា របស់ សហភាព អឺរ៉ុប » ។
សភា ពាណិជ្ជកម្ម អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា សូម ឆ្លៀត ឱកាស សុំ ជួប ជាមួយ លោកស្រី នៅក្នុង ឱកាស សម័យ ប្រជុំ កំពូល រវាង អាស៊ី - អឺរ៉ុប នៅ ទីក្រុង ប្រ៊ុច សែល តាម ពេលវេលា ដែល លោកស្រី អាច អនុញ្ញាតឲ្យ ជួប បាន ដើម្បី ធ្វើ ការពិភាក្សា អំពី ស្ថានភាព នៅក្នុង ប្រទេស កម្ពុជា និង ក្ដីកង្វល់ នានា របស់ ផ្នែក ឯកជន អឺរ៉ុប ៕
ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ បញ្ជា ឲ្យ អធិការ ក្រុង - ស្រុក ទូទាំង ខេត្ត ត្រូវ បង្រ្កាប គ្រឿងញៀន ក្នុង មូលដ្ឋាន របស់ ខ្លួន ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព
( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ បាន បញ្ជា ឲ្យ អធិការ ក្រុង - ស្រុក ទូទាំង ខេត្ត ព្រះវិហារ ត្រូវ យកចិត្តទុកដាក់ ខិតខំ បង្ក្រាប ករណី គ្រឿងញៀន នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ឲ្យ កាន់តែ មាន ប្រសិទ្ធិភាព ថែម ទៀត ។
លោក ឧត្តមសេនីយ៍ ស្នងការបាន ថ្លែង បែប នេះ នារ រសៀល ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ២០១៨ ក្នុង ឱកាស ដែល លោក ដឹកនាំ កិច្ចប្រជុំ គណៈ ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ។
នៅក្នុង កិច្ចប្រជុំ នេះ ឧត្តមសេនីយ៍ ទោ យិន ចំណាន បាន កោតសរសើរ ដល់ អធិការ ក្រុង - ស្រុក ទាំង ៨ របស់ ខេត្ត ព្រះវិហារ ដែល មួយ រយៈ កាល កន្លងមក នេះ បាន ធ្វើ កិច្ចការ ធំ ៗ ជាច្រើន ទទួលបាន ជោគជ័យ ពិសេស គឺ ការពារ បាន នូវ បញ្ហា សន្តិសុខ សណ្តាប់ធ្នាប់ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន បាន យ៉ាង ល្អ ប្រសើរ ។
លោក ថា កន្លងមក ការបង្ក្រាប ករណី គ្រឿងញៀន នៅ តាម បណ្តា អធិការ ក្រុង - ស្រុក នីមួយ ៗ មាន ការចូលរួម សហការ ជាមួយ កម្លាំង ស្នងការ នគរបាល ខេត្ត ជានិច្ច ប៉ុន្តែ ចាប់ពី ពេលនេះ តទៅ អធិការ ក្រុង ស្រុក ទាំងអស់ ត្រូវ ឈរ លើ ម្ចាស់ ការបង្ក្រាប គ្រឿងញៀន ដោយ ខ្លួន ឯង ប្រសិនបើ ក្រុង - ស្រុក ណា មាន បទល្មើស គ្រឿងញៀន កើតឡើង គឺ អធិការ ក្រុង - ស្រុក នោះ ជា អ្នកទទួលខុសត្រូវ ។
អភិបាល ខេត្ត សៀមរាប ចែក អំណោយ ជូន ពលរដ្ឋ ៤០០ គ្រួសារ នៅ ស្រុក បាសាទ បាគង និង បញ្ចុះ បឋមសិលា សាងសង់ អគារ សិក្សា សាលា បឋមសិក្សា ស្រី វិបុល កេរ្ដិ៍
( សៀមរាប ) ៖ លោក ឃឹម ប៊ុន សុង អភិបាល ខេត្ត សៀមរាប និង លោកស្រី នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ចូលរួម ពិធី បញ្ចុះ បឋមសិលា សាងសង់ អាគារ សិក្សា សាលា បឋមសិក្សា ស្រី វិបុល កេរ្តិ៍ ១ខ្នង មាន ៥បន្ទប់ ដែល ជា អំណោយ សប្បុរសធម៌ របស់ ក្រុមហ៊ុន វី ឆារី ថេបល ហ្វោន ដេសិន ក្នុង តម្លៃ ទឹកប្រាក់ សរុប ៦ម៉ឺន ដុល្លារ ស្ថិត ក្នុង ភូមិ ត្រា ច ឃុំ បល្ល័ង្ក ស្រុក ប្រាសាទ បាគង ។
បន្ទាប់មក ទៀត លោក ឃឹម ប៊ុន សុង ក៏ បាន បន្ដ ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ៤០០ គ្រួសារ ដែល ជា អំណោយ មនុស្សធម៌ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប ដល់ ពលរដ្ឋ មកពី ៣ឃុំ គឺ ( ឃុំ បល្ល័ង្ក ឃុំ អំពិល ឃុំ កន្ទ្រាំង ) ក្នុង ស្រុក ប្រាសាទ បាគង ។
តាម សេចក្តីរាយការណ៍ របស់ លោក នឹម សុវណ្ណ អភិបាល ស្ដី ទី ស្រុក ប្រាសាទ បាគង បាន ឲ្យដឹង ថា ប្រជាពលរដ្ឋ មកពី ២០ ភូមិ ក្នុង ឃុំ ទាំង៣ នៃ ស្រុក បាសាទ បាគង ដែល មាន មុខរបរ ជា កសិករ បាន ជួប នូវ កង្វះខាត នូវ ស្បៀងអាហារ ប្រចាំ ថ្ងៃ ដែល ជា គ្រួសារ ងាយ រងគ្រោះ ទៀតផង ។
តាម ការបញ្ជាក់ របស់ លោក ស៊ុ សំអន នាយក សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប បាន ឲ្យដឹង ពី ប្រភព អំណោយ ដែល បាន ផ្ដល់ជូន នា ពេលនេះ គឺ ទទួលបាន ការឧបត្ថម្ភ ពី សមាគម វី ឆារី ថេបល ហ្វោន ដេសិន ដែល ផ្តល់ តាមរយៈ គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប ។
លោក អភិបាល ខេត្ត ក៏ បាន សម្តែង នូវ ការអរគុណ ចំពោះ សប្បុរសជន នៃ សមាគម វី ឆាយ រី ថេបល ហ្វោន ដេសិន ដែល មាន សន្ដានចិត្ត មនុស្សធម៌ ក្នុង ការចូលរួម ជាមួយ សកម្មភាព មនុស្សធម៌ កាកបាទ ក្រហម កម្ពុជា ជាក់ស្តែង ក្នុង ការចុះ មក ផ្ទាល់ ដល់ មូលដ្ឋាន ទោះបី ការធ្វើដំណើរ ឆ្ងាយ មាន ការលំបាក យ៉ាងណា ក៏ដោយ ក្នុង ទឹកចិត្ត មនុស្សធម៌ ចំពោះ ប្រជាជន កម្ពុជា ។
ចំណែកឯ រុស្ស៊ី បាន សម្រេចចិត្ត ចាកចេញ ពី PACE នៅ ចុង ឆ្នាំ ២០១៥ ជាមួយ ការអះអាង ថា នឹង ចូល ជា សមាជិក វិញ លុះត្រាតែ រុស្ស៊ី ទទួលបាន សិទ្ធិ បោះឆ្នោត ឡើងវិញ ។ មិន តែ ប៉ុណ្ណោះ នៅ ឆ្នាំ ២០១៧ ទីក្រុង ម៉ូស្គូ បាន សម្រេចចិត្ត ផ្អាក ការផ្ដល់ វិភាគទាន ដល់ CoE បើ ទោះជា ខ្លួន នៅតែ បន្ត អនុវត្តន៍ តាម កាតព្វកិច្ច នានា ក្រោម អនុសញ្ញា CoE ក៏ដោយ ៕ សូម បងប្អូន ជួយ បោះឆ្នោត តាម របៀប ថ្មី ដើម្បីឲ្យ បេក្ខ នារី តំណាង កម្ពុជា ទទួលបាន « ពានរង្វាន់ ប្រជាប្រិយភាព » !
ដូច្នេះ សូម ជន រួម ជាតិ ខ្មែរ ទាំងអស់ គ្នា ចូលរួម បោះឆ្នោត ដល់ បេក្ខ នារី របស់ យើង ដើម្បី មាន ឱកាស ទទួលបាន ពានរង្វាន់ ប្រជាប្រិយភាព តំណាង ជាតិ ខ្មែរ យើង ចាប់ពី ថ្ងៃ នេះ រហូតដល់ ពេល ប្រកួត ផ្តាច់ព្រ័ត្រ ថ្ងៃទី ២៥ ខែតុលា ២០១៨ ។
បន្ទាប់ បាន ភ្លក្ស អាហារ យ៉ាង ពិសេស ទាំង៦មុខ លោក លឹម ជា វុត្ថា អគ្គ នាយក អង្គភាព ព័ត៌មាន Fresh News ព្រមទាំង ថ្នាក់ដឹកនាំ ស្ថាប័ន ព័ត៌មាន ផ្សេង ទៀត សុទ្ធតែ បាន បញ្ជាក់ ដូច ៗ គ្នា អាហារ ទាំងអស់ នោះ គឺ ពិតជា មាន ឱជារស ឈ្ងុយ ឆ្ងាញ់ ព្រោះថា អាហារ ទាំងអស់ នោះ ពិតជា មាន តម្លៃ ណាស់ ដោយ សុទ្ធសឹងតែ ជា អាហារ នៅក្នុង រាជ វាំង ៕ កាំភ្លើង កែច្នៃ ខុស ច្បាប់ ជាង ២០ ដើម ត្រូវបាន ប្រជាពលរដ្ឋ ភ្ញាក់ រឭក យក ទៅ ប្រគល់ជូន សមត្ថកិច្ច
( ព្រះវិហារ ) ៖ បន្ទាប់ពី បាន យល់ដឹង ពី ភាពខុស ច្បាប់ នៃ ការប្រើប្រាស់ កាំភ្លើង កែច្នៃ ផ្សេង ៗ ប្រជាពលរដ្ឋ ជាច្រើន នាក់ បាន ស្ម័គ្រចិត្ត យក កាំភ្លើង កែច្នៃ ផ្សេង ៗ មក ប្រគល់ជូន សមត្ថកិច្ច វិញ នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ ក្នុង វេទិកា ប្រជុំ ផ្សព្វផ្សាយ ពី គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព នៅ ឃុំ រមទម្យ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ។
មន្ត្រី នគរបាល ស្រុក រវៀង បាន ឲ្យដឹង ថា ប៉ុស្តិ នគរបាល ឃុំ រមទម្យ បាន សហការ នឹង ក្រុមប្រឹក្សា ឃុំ ដោយ មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ បើក វេទិកា ប្រជុំ ផ្សព្វផ្សាយ គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ដោយ ផ្តោត សំខាន់ លើ បញ្ហា ការប្រើប្រាស់ អាវុធ កែច្នៃ ដោយ ខុស ច្បាប់ ការប្រើប្រាស់ គ្រឿងញៀន ល្បែង ស៉ី សង ក៏ ដូចជា ក្រុម បង តូច - បង ធំ ផងដែរ ។
ជាមួយគ្នា នេះ សមត្ថកិច្ច បាន ផ្តោត សំខាន់ ដល់ ផល ប៉ះពាល់ នៃ ការប្រើប្រាស់ អាវុធ កែច្នៃ ដោយ ខុស ច្បាប់ និង អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ត្រូវ យក អាវុធ កែច្នៃ មក ប្រគល់ជូន សមត្ថកិច្ច ។
ក្រុម អ្នកសារព័ត៌មាន ដែល ជិះ នៅលើ យន្តហោះ នោះ ដែរ បាន ឲ្យដឹង ថា ពួកគេ ត្រូវបាន គេ ប្រាប់ ឲ្យដឹង ថា មាន បញ្ហា ម៉ាស៊ីន ដែល បណ្តាលឲ្យ មាន ការភ័យខ្លាច នេះ កើតឡើង ។ ប៉ុន្តែ ករណី នេះ មិន បាន ធ្វើឲ្យ អ្នកណា ម្នាក់ ទទួលរងរបួស នោះ ទេ គ្រាន់តែ អ្នកស្រី ទី១ មិន អាច ធ្វើដំណើរ បាន ដល់ គោលដៅ ប៉ុណ្ណោះ ។
ស្ត្រី ជនជាតិ ចិន ម្នាក់ សម្លាប់ ខ្លួន ឯង និង កូន ២នាក់ ក្រោយ ទទួលបាន ព័ត៌មាន មរណភាព ក្លែងក្លាយ របស់ ប្ដី
( ប៉េកាំង ) ៖ បុរស ជនជាតិ ចិន ម្នាក់ បាន ក្លែង បន្លំ ធ្វើពុត ជា ស្លាប់ ដើម្បី ទទួលបាន ប្រាក់ ធានារ៉ាប់រង ប៉ុន្តែ ជា អកុសល ប្រពន្ធ របស់ លោក បាន សម្រេចចិត្ត សម្លាប់ ខ្លួន ឯង និង កូន ២នាក់ ក្រោយ ទទួលបាន ដំណឹង មរណភាព ក្លែងក្លាយ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន BBC នៅ ថ្ងៃពុធ ទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ ។
គួរ បញ្ជាក់ ថា បើ តាម ប៉ូលិស ចិន កាលពី ដើម ខែកញ្ញា លោក ហេ បាន ទិញ ធានារ៉ាប់ មួយ មាន តម្លៃ ១៤៥.០០០ ដុល្លារ ដោយ ដាក់ ឈ្មោះ ប្រពន្ធ របស់ លោក តែ មិន ឱ្យ ប្រពន្ធ ដឹង ឡើយ ព្រមទាំង បាន រៀបចំ ផែនការ ធ្វើពុត ជា ស្លាប់ ដើម្បី ប្រើប្រាស់ ឈ្មោះ ប្រពន្ធ យក ប្រាក់ ធានារ៉ាប់រង ទាំងនេះ ៕
កម្លាំង សមត្ថកិច្ច ចម្រុះ ខេត្ត កំពង់ចាម បង្ក្រាប បទល្មើស នេសាទ ២ករណី នៅ ស្រុក កំពង់សៀម និង ស្រុក កោះ សូទិន
( កំពង់ចាម ) ៖ កម្លាំង សមត្ថកិច្ច ចម្រុះ ខេត្ត កំពង់ចាម ដោយ មាន ការឯកភាព ពី លោក ហួត វុទ្ធី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ដ នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន បង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ ២ករណី នៅ ស្រុក កំពង់សៀម និង ស្រុក កោះ សូទិន ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ប្រតិបត្តិការ ទី២ លោក បាន បញ្ជា អធិការ ស្រុក កោះ សូទិន សហការ ជាមួយ កម្លាំង អន្តរាគមន៍ ពិសេស អធិការដ្ឋាន និង កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ល្វេ និង ព្រែក តា នង់ ដឹកនាំ ដោយ លោក អ៊ឹម ឃឿន អធិការដ្ឋាន នគរបាល ស្រុក កោះ សូទិន ដោយ មាន ការចង្អុលបង្ហាញ ពី លោក ផេន សុផល អភិបាល ស្រុក កោះ សូទិន បាន ចុះ នៅ ចំណុច ព្រែក ព្នៅ ( ជ្រុំ ជ្រេស ) ស្ថិត ក្នុង ភូមិសាស្រ្ត ឃុំ ល្វេ ស្រុក កោះ សូទិន ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
៨៖ បច្ចេកវិទ្យា បន្ត ពូជ ដែល មាន ជំនួយ អនុវត្ត រយៈពេល ៣០ ឆ្នាំ ក្នុង ប្រទេស ចិន ទទួលបាន លទ្ធផល ល្អ ( ចុច អាន )
( ភ្នំពេញ ) ៖ ការវិនិយោគ លើ វិស័យ សំណង់ នៅ កម្ពុជា នៅតែ បន្ត មាន សន្ទុះ កើនឡើង បើ ធៀប រយៈពេល ៩ខែ ក្នុង ឆ្នាំ ២០១៨ ទៅនឹង ឆ្នាំ ២០១៧ ។ នេះ បើ យោង តាម របាយការណ៍ របស់ ក្រសួង រៀបចំ ដែនដី និង នគរូបនីយកម្ម ។
របាយការណ៍ ស្តីពី លទ្ធផល ការងារ របស់ ក្រសួង រៀបចំ ដែនដី និង នគរូបនីយកម្ម រយៈពេល ៩ខែ ឆ្នាំ ២០១៨ ដែល ចេញ ផ្សព្វផ្សាយ នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន បង្ហាញ ថា រយៈពេល ៩ខែ ឆ្នាំ ២០១៨ នេះ គម្រោង សាងសង់ មាន ចំនួន ២. ៥៤១ គម្រោង លើ ផ្ទៃដី ជិត ១១លាន ម៉ែត្រ ការ៉េ មាន តម្លៃ ទុន វិនិយោគ ប៉ាន់ស្មាន ជិត ៥ពាន់ លាន ដុល្លារ អាមេរិក ។
របាយការណ៍ ដដែល បាន បង្ហាញ ដែរ ថា ក្នុង ចំណោម គម្រោង សំណង់ ទាំងអស់ នេះ គ្រប់គ្រង ដោយ ក្រសួង រៀបចំ ដែនដី និង សំណង់ ចំនួន ២២៤ គម្រោង ហើយ គ្រប់គ្រង ដោយសាលា រាជធានី - ខេត្ត ២. ៣១៧គម្រោង ។
របាយការណ៍ ក៏ បាន គូសបង្ហាញ ដែរ ថា ក្នុង ចំណោម គម្រោង សំណង់ ទាំងនេះ មាន សំណង់ លំនៅឋាន ២. ១៥១ គម្រោង មាន ទុន វិនិយោគ ជិត ២ពាន់ លាន ដុល្លារ អាមេរិក ។ គិត ចាំ ពី ឆ្នាំ ២០០០ មកដល់ ៩ខែ ឆ្នាំ ២០១៨ នេះ សំណង់ លំនៅឋាន នៅ ទូទាំង ប្រទេស មាន ចំនួន ៤២. ៨១០ គម្រោង មាន តម្លៃ ទុន វិនិយោគ ជាង ៤ម៉ឺន លាន ដុល្លារ អាមេរិក ។
បើ តាម របាយការណ៍ តាមរយៈ វិស័យ សំណង់ នេះ ក៏ បាន រួមចំណែក ផ្តល់ ការងារ ជូន ប្រជាពលរដ្ឋ ខ្មែរ យ៉ាង ច្រើន ផងដែរ ។ ៩ខែ ឆ្នាំ ២០១៨ វិស័យ សំណង់ បាន ផ្តល់ ការងារ គិត ជា មធ្យម ពី ២០ម៉ឺន នាក់ ទៅ ២២ ម៉ឺន នាក់ ក្នុង មួយ ថ្ងៃ ។ ដោយឡែក នៅ ភ្នំពេញ មាន កម្មករ សំណង់ បំពេញ ការងារ ជា មធ្យម ចន្លោះ ៩ម៉ឺន ទៅ១០ម៉ឺន នាក់ ក្នុង មួយ ថ្ងៃ ។ បើ ធៀប នឹង រយៈពេល ដូចគ្នា នឹង ឆ្នាំ ២០១៧ ការងារ ក្នុង វិស័យ សំណង់ នេះ បាន ផ្តល់ ការងារ ជូន ពលរដ្ឋ ខ្មែរ កើនឡើង ដល់ ទៅ ១២០ ភាគរយ ។
របាយការណ៍ បាន គូសបញ្ជាក់ ថា កម្មករ គ្មាន ជំនាញ អាច ទទួល ប្រាក់ ឈ្នួល ពី ៣៥.០០០ ទៅ៤០ .០០០ រៀល ក្នុង មួយ ថ្ងៃ . កម្មករ មាន ជំនាញ និង មេ ជាង ទទួលបាន ប្រាក់ ឈ្នួល ៥០.០០០ រៀល ទៅ ៧៥.០០០ រៀល ក្នុង មួយ ថ្ងៃ ។ ចំពោះ វិស្វករ ស្ថាបត្យករ និង អ្នកជំនាញ ផ្សេង ទៀត អាច ទទួលបាន ប្រាក់ ឈ្នួល ចន្លោះ ពី ៤០០ ដុល្លារ ទៅ ២.៥០០ ដុល្លារ ៕ ជប៉ុន និង កម្ពុជា នឹង រៀបចំ កម្មវិធី ពិសេស ៗ ចំនួន ១៨រយៈពេល មួយ ខែ ដើម្បី អបអរ ខួប លើក ទី ៦៥ ឆ្នាំ នៃ ទំនាក់ទំនង
( ភ្នំពេញ ) ៖ ចាប់ពី ថ្ងៃទី ១៩ ខែតុលា រហូតដល់ ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ នេះ ជប៉ុន និង កម្ពុជា នឹង រួមគ្នា ធ្វើ កម្មវិធី ពិសេស ៗ ចំនួន ១៨ ដើម្បី អបអរសាទរ ខួប ៦៥ ឆ្នាំ នៃ ទំនាក់ទំនង ប្រទេស ទាំង ពីរ ក៏ ដូចជា លើកកម្ពស់ ទំនាក់ទំនង រវាង ប្រទេស និង ប្រទេស ក៏ ដូចជា ប្រជាជន និង ប្រជាជន ឲ្យ កាន់តែ ប្រសើរ ថែម ទៀត ។ កម្មវិធី អបអរសាទរ ខួប ទំនាក់ទំនង នេះ ត្រូវបាន គេ ឲ្យ ឈ្មោះ ថា « ខែមិត្តភាព កម្ពុជា - ជប៉ុន » ។
លោក បាន ឱ្យដឹង ទៀត ថា ចាប់តាំងពី បើក ដំណើរការ ជើងហោះហើរ ត្រង់ ភ្នំពេញ - តូក្យូ នៅ ឆ្នាំ ២០១៦ ចំនួន អ្នកធ្វើដំណើរ ពី កម្ពុជា ទៅ ជប៉ុន កើនឡើង ៣. ៦០០ នាក់ នៅ ឆ្នាំ ២០១២ ទៅ ១៧.០០០ នៅ ឆ្នាំ ២០១៧ ។ លោក ឯក អគ្គ រាជ ទូត ជឿជាក់ ថា ពិព័រណ៍ ទេសចរណ៍ ជប៉ុន នឹង ធ្វើឱ្យ ប្រជាជន កម្ពុជា កាន់តែ ច្រើន ចង់ ទៅ កម្សាន្ត នៅ ប្រទេស ជប៉ុន ហើយ លោក សង្ឃឹម ថា តាមរយៈ ការផ្សព្វផ្សាយ ព័ត៌មាន នេះ ប្រជាជន កម្ពុជា កាន់តែ ស្គាល់ ពី ព្រឹត្តិការណ៍ នៃ ខែមិត្តភាព កម្ពុជា - ជប៉ុន នេះ កាន់តែ ច្រើន ផងដែរ ។
សិក្ខាសាលា រយៈពេល ០២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៧ ដល់ ១៨ ខែតុលា ឆ្នាំ ២០១៨ ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ដើម្បី ពង្រឹង និង ពង្រីក ចំណេះដឹង ដល់ ថ្នាក់ដឹកនាំ របស់ ក្រុមហ៊ុន បោះផ្សាយ និង ក្រុមហ៊ុន បោះផ្សាយ សក្តានុពល ព្រមទាំង ក្រុមហ៊ុន និង ស្ថាប័ន សក្តានុពល ជាច្រើន ទៀត នៅក្នុង ព្រះរាជ ណាចក្រ កម្ពុជា ដោយ បាន ផ្តោត ទៅ លើ ផ្នែក សំខាន់ ៗ រួម មាន៖
១៖ ការបង្កើត ក្រុមប្រឹក្សាភិបាល ដែល មាន ប្រសិទ្ធភាព និង តួនាទី របស់ អភិបាល ឯករាជ្យ
២៖ ការអនុវត្ត ផ្នែក ច្បាប់ នៃ ភាពជា អភិបាល
៣៖ ភាព ជា អ្នកដឹកនាំ របស់ ក្រុមប្រឹក្សាភិបាល លើ របៀបវារៈ ហានិភ័យ ព្រមទាំង យុទ្ធសាស្រ្ត
៤៖ និន្នាការ ថ្មី នៃ អភិបាលកិច្ច សាជីវកម្ម និង របៀប បង្កើត ស្តង់ដារ អភិបាលកិច្ច សាជីវកម្ម ប្រកបដោយ ប្រសិទ្ធភាព ។
សិក្ខាសាលា ខាងលើ មាន ការចូលរួម ពី វា គ្មិន ដែល ជា អ្នកជំនាញ ជាន់ ខ្ពស់ មកពី Thai IOD ដែល មាន បទពិសោធន៍ យូរ ឆ្នាំ ក្នុង ការបណ្តុះបណ្តាល ព្រមទាំង ការអនុវត្ត ការងារ ជាក់ស្តែង ច្រើន ពាក់ព័ន្ធ នឹង ភាពជា អ្នក ដឹកនាំ ៕ សាលា អន្ដរជាតិ អាស៊ាន ប្រគល់ វិញ្ញាបនបត្រ បញ្ជាក់ ការសិក្សា និង អាហារូបករណ៍ ដល់ សិស្ស ឆ្នើម ថ្នាក់ ចំណេះ ទូទៅ ភាសា ខ្មែរ
( ភ្នំពេញ ) ៖ សាលា អន្ដរជាតិ អាស៊ាន នៅ រសៀល ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន រៀបចំ ពិធី ប្រគល់ វិញ្ញាបនបត្រ បញ្ជាក់ ការសិក្សា ប័ណ្ណ សរសើរ រង្វាន់ និង អាហារូបករណ៍ ដល់ សិស្ស ឆ្នើម ថ្នាក់ ចំណេះ ទូទៅ ភាសា ខ្មែរ ប្រចាំ ឆ្នាំ សិក្សា ២០១៧ - ២០១៨ ដែល រៀបចំ ធ្វើឡើង នៅ សាល អង្គរ - គីហ្សូណា នៃ មជ្ឈមណ្ឌល សហប្រតិបត្តិការ កម្ពុជា - ជប៉ុន (CJCC) ។
ក្នុង ពិធី នោះ លោកស្រី សូយ សុមានិត នាយិការង សាលា អន្ដរជាតិ អាស៊ាន បាន សម្ដែង នូវ ស្រលាញ់ ពេញចិត្ត ចំពោះ សិស្សានុសិស្ស ទាំងអស់ ដែល តែងតែ គោរព វិន័យ សាលា គោរព លោកគ្រូ អ្នកគ្រូ ស្ដាប់ ដំបូន្មាន លោកឪពុក អ្នកម្ដាយ យកចិត្ដទុកដាក់ ចំពោះ ការរៀនសូត្រ និង តែងតែ ចូលរួម គ្រប់ សកម្មភាព របស់ សាលារៀន ។
លោកស្រី សូយ សុមានិត បាន ផ្ដាំផ្ញើ ដល់ សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ចង់ចាំ ថា ចំណេះដឹង មិន ត្រឹមតែ អាច ផ្លាស់ប្ដូរ ជីវិត យើង ឬ អាច ផ្លាស់ប្ដូរ ជីវភាព ក្រុមគ្រួសារ និង សហគមន៍ ប៉ុណ្ណោះ ទេ ប៉ុន្ដែ ថែមទាំង អាច ចូលរួម ចំណែក ផ្លាស់ប្ដូរ មុខមាត់ នៃ ប្រទេសជាតិ នា អនាគត ទៀតផង ។
ដើម្បី ក្រើន រំលឹក សិស្សានុសិស្ស ទាំងអស់ ត្រូវ ធ្វើជា កូន ល្អ សិស្ស ល្អ មិត្ដ ល្អ និង ពលរដ្ឋ ល្អ នាយិការង សាលា អន្ដរជាតិ អាស៊ាន បាន បញ្ជាក់ ថា ក្មួយ ៗ ត្រូវ ស្រលាញ់ ការសិក្សា ស្រលាញ់ លោកឪពុក អ្នកម្ដាយ ស្រលាញ់ សាលារៀន និង ត្រូវ នៅ ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន ។
បន្ថែម ពី នោះ ទៀត លោកស្រី សូយ សុមានិត ក៏ សូមឲ្យ សិស្សានុសិស្ស ទាំងអស់ ប្រតិបត្តិ ច្បាប់ ចរាចរណ៍ ឲ្យបាន ខ្ជាប់ ខ្លួន ចូលរួម ផ្សព្វផ្សាយ ចរាចរណ៍ ចេះ យោគយល់ និង មាន អធ្យាស្រ័យ គ្នា ដើម្បី ធានា បាន នូវ សុវត្ថិភាព ផ្ទាល់ខ្លួន ផង និង អ្នកដទៃ ក៏ ដូចជា រក្សា បាន នូវ សេចក្ដីថ្លៃថ្នូ ដល់ សង្គមជាតិ ទាំងមូល ។
លោកស្រី សូយ សុមានិត បាន គូសបញ្ជាក់ ទៀត ថា ក្នុង នាម ជា ស្ថាប័ន អប់រំ សាលា អន្ដរជាតិ អាស៊ាន នឹង ប្រឹងប្រែង ឲ្យ អស់ ពី លទ្ធភាព ដើម្បី ចូលរួមចំណែក កសាង និង អភិវឌ្ឍ វិស័យ អប់រំ នៅ កម្ពុជា ឲ្យ មាន ដំណើរការ រីកចម្រើន គួរ ជា ទី មោទនៈ ក្នុង បុព្វហេតុ អប់រំ និង បណ្ដុះបណ្ដាល ធនធាន មនុស្ស ឲ្យ ប្រកបដោយ គុណភាព និង ប្រសិទ្ធភាព ខ្ពស់ ៕ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៧ ខែតុលា នេះ លទ្ធផល៖ បង្ក្រាប ២៥ ករណី ឃាត់ខ្លួន ៤៧ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
១៖ ករណី ជួញដូរ គ្រឿងញៀន ១៤ករណី ឃាត់ខ្លួន ២១ នាក់ ។ ២៖ ករណី ប្រើប្រាស់ គ្រឿងញៀន ១១ករណី ឃាត់ខ្លួន ២៦ នាក់ ៕ មិន ធម្មតា ! អ៊ីរ៉ង់ សងសឹក បាន សម្រេច ដោយ សម្លាប់ មេ ខ្លោង បង្ក អំពើ ភេរវកម្ម ទៅ លើ ក្បួន ព្យុហយាត្រា យោធា កាលពី ខែកញ្ញា !
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ សហការ ជាមួយ ទីភ្នាក់ងារ កិច្ចសហប្រតិបត្តិការ អាល្លឺម៉ង់ នៅ កម្ពុជា ក្នុង គម្រោង បទដ្ឋាន សង្គម និង ការងារ ក្នុង វិស័យ វាយន ភណ្ឌ និង កាត់ដេរ នៅ ទ្វីប អាស៊ី (GIZ-SLSG) បាន រៀបចំ សិក្ខាសាលា ថ្នាក់ តំបន់ ស្ដីពី « ប្រព័ន្ធ អធិការ កិច្ចការងារ និង របប ហានិភ័យ ការងារ » ដើម្បី ផ្លាស់ប្តូរ បទពិសោធន៍ ថ្មី ៗ ក្នុង ប្រព័ន្ធ អធិការ កិច្ចការងារ នីតិវិធី នៃ ការធ្វើ អធិការ កិច្ចការងារ ។
ការរៀបចំ សិក្ខាសាលា នេះ ប្រព្រឹត្ត ឡើង ក្រោម វត្តមាន លោក ម៉ម វណ្ណៈ រដ្ឋលេខាធិការ ក្រសួង ការងារ តំណាង លោក រដ្ឋមន្ត្រី អ៉ិត សំហេង នា ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នៅ សណ្ឋាគារ រ៉ាហ្វល ឡឺរ៉ូយ៉ាល់ ។
សិក្ខាសាលា នេះ ធ្វើឡើង ក្នុង គោលបំណង ចែករំលែក នូវ ព័ត៌មាន បទពិសោធន៍ ល្អ ៗ និង ការអនុវត្ត ថ្មី ៗ ក្នុង ប្រព័ន្ធ អធិការ កិច្ចការងារ នីតិវិធី នៃ ការធ្វើ អធិការ កិច្ចការងារ ក៏ ដូចជា របប ហានិភ័យ ការងារ រវាង ប្រទេស ស្ថិត ក្រោម គម្រោង GIZ-SLSG ដើម្បី ស្វែងរក ដំណោះស្រាយ និង អភិវឌ្ឍ ទៅ លើ ក្របខណ្ឌ នៃ វិស័យ ការងារ ដែល ប្រទេស ក្រោម គម្រោង កំពុង ជួបប្រទះ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការងារ រូប នេះ បាន បញ្ជាក់ ថា ដើម្បី ធានា និង លើកកម្ពស់ លក្ខខណ្ឌ ការងារ និង ជីវភាព រស់ នៅ របស់ កម្មករ និយោជិត ឱ្យ កាន់តែ ប្រសើរឡើង រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ឆ្នាំ ២០១៦ - ២០២៥ » ដែល មាន លក្ខណៈ ទូលំទូលាយ ដោយ ផ្តោត លើស សរ ស្តម្ភ ពីរ គឺ ប្រព័ន្ធ ជំនួយ សង្គម និង ប្រព័ន្ធ សន្តិសុខ សង្គម ។
( កំពង់ធំ )៖ ម្ចាស់ រថយន្ត ម៉ាក ហ៊ីយ៉ិន ដាយ ធន់ ធំ មួយ គ្រឿង បើកបរ ក្នុង ស្ថា ភាពងងុយដេក ក៏ បាន រេច ង្កួត ជ្រុល ទៅ បុក ម៉ូតូ មួយ គ្រឿង ពេញ ទំហឹង រួច បន្ត ទៅ បុក រទេះ ក្របី ក្នុង ទិសដៅ ស្រប ពី ជើង ទៅ ត្បូង បណ្តាលឱ្យ ស្លាប់ មនុស្ស ២នាក់ និង ២នាក់ របួស ធ្ងន់ ។ ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ព្រឹក ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នៅលើ កំណាត់ ផ្លូវ ជាតិ លេខ ៦ ភូមិ ស្ពាន គ្រង ឃុំ ចំណារ ក្រោម ស្រុក ស្ទោង ខេត្ត កំពង់ធំ ។
( ភ្នំពេញ ) ៖ ដោយ មើលឃើញ ពី ទុក្ខលំបាក របស់ អ្នកជំងឺ នៅ តាម មន្ទីរពេទ្យ នៅ ថ្ងៃពុធ ៨កើត ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស .២៥៦២ ត្រូវនឹង ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ កាកបាទ ក្រហម កម្ពុជា ( ហៅ កាត់ ថា ក ក្រក ) ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន បាន ចាត់ ឱ្យ គណៈប្រតិភូ ដឹកនាំ ដោយ លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ មនុស្សធម៌ ជូន អ្នកជំងឺ ចំនួន ៤៨៦ នាក់ ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ ព្រះកុសុមៈ ( ពេទ្យ លោកសង្ឃ ) ។
គួរ រំលឹក ផងដែរ ថា កាលពី ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ កាកបាទ ក្រហម កម្ពុជា បាន ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ជូន អ្នកជំងឺ បាន សរុប ចំនួន ១. ៥០៦ នាក់ រួច មកហើយ ដែល សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ព្រះកេតុ មាលា និង មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ៕ ទេសរដ្ឋមន្ត្រី ឆាយ ថន៖ ការធ្វើអង្កេត ពាក់កណ្ដាល ជំរឿន កសិកម្ម ឆ្នាំ ២០១៩ ចែក ជា៤ ដំណាក់កាល
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ឆាយ ថន រដ្ឋមន្រ្តី ក្រសួង ផែនការ នៅ ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ បើក សិក្ខាសាលា ស្តីពី អ្នកផលិត អ្នកប្រើប្រាស់ ទិន្នន័យ និង ពិធី ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង អនុវត្តន៍ គម្រោង អង្កេត ចន្លោះ ជំរឿន កសិកម្ម ឆ្នាំ ២០១៩ និង អង្កេត កសិកម្ម ប្រចាំ ឆ្នាំ ។
តាម ទម្លាប់ ការធ្វើ ជំរឿន កសិកម្ម ត្រូវ ធ្វើឡើង រយៈពេល ១០ ឆ្នាំ ម្តង ប៉ុន្តែ ដោយសារ ឆ្នាំ ២០១៨ នេះ ក្រសួង មិន មាន ថវិកា គ្រប់គ្រាន់ ទើប ត្រូវបាន ពន្យារ ពេល ធ្វើ នៅ ឆ្នាំ ២០១៩ តែម្តង ។
លោក ទេសរដ្ឋមន្ត្រី ឆាយ ថន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ដូច្នេះ ឆ្នាំ ២០១៨ គឺជា ឆ្នាំ ដែល វិទ្យាស្ថាន ជាតិ ស្ថិតិ ត្រូវ ធ្វើ អង្កេត ពាក់កណ្តាល ជំរឿន កសិកម្ម ដើម្បី ធ្វើ បច្ចុប្បន្នភាព ទិន្នន័យ កសិកម្ម និង ជល ផល ។ ហេតុ ដូចនេះ ហើយ ទើប យើង កំពុង ជួបជុំគ្នា នៅ ថ្ងៃ នេះ ដើម្បី គិតគូរ ពិភាក្សា គ្នា អំពី ផែនការ ដ៏ មាន សារៈសំខាន់ មួយ នេះ ។ គួរ រម្លឹក ផងដែរ ថា ដោយសារតែ ឆ្នាំ ២០១៨ យើង ពុំ ទទួលបាន ថវិកា គ្រប់គ្រាន់ សម្រាប់ ប្រតិបត្តិការ គម្រោង នេះ ទើប យើង ពន្យា ការងារ នេះ ទៅដល់ ឆ្នាំ ២០១៩» ។
លោក រដ្ឋមន្ត្រី បាន ថ្លែង បន្ត ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន ក្រសូង ផែនការ និង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ជា សេនាធិការ បាន នឹង កំពុង តាំងចិត្ត ខ្ពស់ ក្នុង ការធ្វើអង្កេត ពាក់កណ្ដាល ជំរឿន កសិកម្ម ឆ្នាំ ២០១៩ និង ការប្រមូល ទិន្នន័យ ប្រចាំ ឆ្នាំ នា ពេល ខាងមុខ នេះ ឲ្យ សម្រេច ខាងតែ បាន ជោគជ័យ និង ដោយ មិន ភ្លេច រួម សហការ ជាមួយ ដៃគូ អភិវឌ្ឍន៍ ដូចជា អង្គការ FAO និង នាយកដ្ឋាន កសិកម្ម សហរដ្ឋ អាមេរិក (USDA) ផងដែរ ។
លោក ថា ម្យ៉ាង វិញ ទៀត ការអនុវត្ត គម្រោង អង្កេត ចន្លោះ ជំរឿន កសិកម្ម ឆ្នាំ ២០១៩ នឹង ប្រើប្រាស់ យន្តការ ដែល មាន ស្រាប់ ដូចជា គណៈកម្មាការ បច្ចេកទេស ជំរឿន កសិកម្ម ឆ្នាំ ២០១៣ ដែល មាន សមាសភាព មកពី ក្រសួង ផែនការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ រួមទាំង ស្ថាប័ន រាជ រដ្ឋាភិបាល ដែល ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី ឆាយ ថន បាន គូសបញ្ជាក់ បន្ថែម ថា បើ យោង ទៅ លើ ផែនការ មេ ការធ្វើអង្កេត ពាក់កណ្ដាល ជំរឿន កសិកម្ម ឆ្នាំ ២០១៩ ចែក ជា ៤តំណាក់កាល ធំ ៗ គឺ៖
* ដំណាក់កាល ទី១៖ ជា ដំណាក់កាល ពង្រឹង សមត្ថភាព ដោយ ផ្តោត សំខាន់ ទៅ លើ ការពង្រឹង សមត្ថភាព មន្រ្តី ស្នូល នៅ ថ្នាក់ ជាតិ និង មន្រ្តី នៅ ថ្នាក់ ក្រោម ជាតិ នៃ ក្រសួង ផែនការ និង ក្រសួង កសិកម្ម តាមរយៈ ការបង្កើតឡើង វគ្គ បណ្តុះបណ្តាល ស្តីពី ការប្រមូល ចង ក្រង វិភាគ បង្ហាញ ផ្សព្វផ្សាយ និង ជាពិសេស ការបណ្តុះបណ្តាល ការប្រើប្រាស់ ម៉ាស៊ីន Tablet សម្រាប់ ស្រង់ ព័ត៌មាន ដែល វា ជា បច្ចេកវិទ្យា ថ្មី ចុងក្រោយ ដែល ពេញនិយម ក្នុង ការងារ ស្ថិតិ នា សម័យកាល ទំនើបកម្ម នេះ ។
* ដំណាក់កាល ទី២៖ ជា ដំណាក់កាល ចុះ ប្រមូល ទិន្នន័យ ជាក់ស្តែង នៅ តាម មូលដ្ឋាន ដែល ត្រូវបាន ជ្រើសរើស គំរូ ដោយ គ្រោង ប្រើប្រាស់ ម៉ាស៊ីន Tablet ជំនួស ឲ្យ ការប្រើប្រាស់ ក្រដាស ដែល ត្រូវ ចំណាយ ច្រើន ។
* ដំណាក់កាល ទី៣៖ ជា ដំណាក់កាល ដែល ផ្តោត ទៅ លើ ការ វិភាគ ទិន្នន័យ ស៉ី ជម្រៅ រួមទាំង ការផលិត ផែនទី ស្ថិតិ កសិកម្ម ជល ផល រហូត ទៅដល់ កម្រិត តូច បំផុត ។
* ដំណាក់កាល ទី៤៖ ជា ដំណាក់កាល ផ្តោត ទៅ លើ ការពង្រីក វិសាលភាព នៃ ការផ្សព្វផ្សាយ ទិន្នន័យ កសិកម្ម និង ជល ផល តាម គ្រប់ មធ្យា បាយ ទាំង តាមរយៈ ការបោះពុម្ព ផ្សាយ ការដាក់បញ្ចូល ទិន្នន័យ ទំាង អស់ នោះ ចូល ទៅក្នុង ប្រព័ន្ធ គេហទំព័រ (Website) ដែល អាច បង្ករឲ្យ មាន ភាពងាយស្រួល មួយ កម្រិត ធំ ទៀត សម្រាប់ អ្នកប្រើប្រាស់ ទិន្នន័យ ស្ថិតិ គ្រប់ ស្រទាប់ ដោយ ចាប់តាំងពី ថ្នាក់ ជាតិ រហូតដល់ ថ្នាក់ ក្រោម ជាតិ និង ពី ថ្នាក់ តំបន់ ទៅដល់ ថ្នាក់ អន្តរជាតិ ។
សូម បញ្ជាក់ ថា លោក ព្រុំ សុខា ជា អតីត រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ក្នុង អាណត្តិ ទី៥ ដែល ត្រូវបាន រាជ រដ្ឋាភិបាល តែងតាំង ជា រដ្ឋលេខាធិការ ក្រសួង មុខងារ សាធារណៈ នៅក្នុង អាណត្តិ ទី០៦ នេះ ៕
បើ យោង តាម របាយការណ៍ សមត្ថកិច្ច ខណ្ឌ ឬស្សីកែវ បញ្ជាក់ ថា ជនសង្ស័យ រូប នេះ មាន ឈ្មោះ ឡាយ អ៊ីង ឃីង អាយុ ២៧ ឆ្នាំ មុខរបរ ជា មន្ត្រី កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ស្នាក់ នៅ ភូមិ គង្គារ ផុស សង្កាត់ ទួល សង្កែ២ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។ ចំណែក ជនរងគ្រោះ មាន ឈ្មោះ លី រតនៈ អាយុ ៣៩ ឆ្នាំ មុខរបរ ជា ប្រជាការពារ ស្នាក់ នៅ ផ្ទះ គ្មាន លេខ ផ្លូវ លំ ភូមិ ក្រោល គោ សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ខណ្ឌ ឬស្សីកែវ រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ជូន ថា មាន ករណី បាញ់ប្រហារ ជាច្រើន គ្រាប់ កាលពី វេលា ម៉ោង ១២៖៣០ នាទី រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០១៨ នៅ ត្រង់ ចំណុច មុខ ផ្ទះល្វែង A4 តាម បណ្ដោយ ផ្លូវ បេតុង ស្ថិត ភូមិ គង្គារ ផុស សង្កាត់ ទួល សង្កែ២ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ បណ្តាលឲ្យ ជនរងគ្រោះ ខាងលើ ត្រូវ របួស ជើង ខាងស្តាំ ត្រូវ បញ ជូន ទៅ សង្គ្រោះ នៅ មន្ទីរ ទេព្យ ។
២៖ ការអាន សៀវភៅ ជាមួយ កូន ៗ ជាទី ស្រលាញ់ របស់ លោក អ្នក និង រីករាយ ជាមួយ ការញុំា កាហ្វេ ដោយ ឥត គិត ថ្លៃ
៣៖ ការធ្វើតេស្ដ សាកល្បង ស្វែងរក អាថ៌កំបាំង ទេពកោសល្យ ខួរក្បាល ពី កំណើត របស់ កូន ៗ អ្នក ជាមួយនឹង ការផ្ដល់ជូន ការបញ្ចុះ តម្លៃ ពិសេស រហូតដល់ ៥០ %
៤៖ ទស្សនា ការ សម្ដែង កម្មវិធី សិក្សា វិទ្យាសាស្ដ្រ ទំនើប ពី អាមេរិក
៦៖ ឱកាស ឈ្នះ រង្វាន់ ជាច្រើន ពី ការចាប់ឆ្នោត ផ្សង សំណាង និង ពី ការលេង ល្បែង កម្សាន្ត
ស្អែក នេះ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ នឹង ទៅ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១២ និង ប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥ នៅ ប្រទេស សឹង្ហបុរី
( ភ្នំពេញ ) ៖ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ការពារ ជាតិ នៅ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១២ និង កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥ នៅ សាធារណរដ្ឋ សឹង្ហបុរី ដែល នឹង ប្រព្រឹត្តិ ទៅ ចាប់ពី ថ្ងៃទី ១៨ ដល់ ថ្ងៃទី ២០ ខែតុលា ។
តាម សេចក្ដីជូនដំណឹង របស់ ក្រសួង ការពារ ជាតិ ដែល អង្គភាព Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ ក្នុង កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥ នោះ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ នឹង ចូលរួម ធ្វើ បទ អន្ដរាគមន៍ ស្ដីពី ការប្រឆាំង ការគំរាមកំហែង ដោយ អំពើ ភេរវកម្ម និង វិធានការកសាង ទំនុកចិត្ត ជាក់ស្ដែង ។
បន្ថែម ពី នេះ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ក៏ នឹង អញ្ជើញ ចូលរួម ក្នុង កិច្ចប្រជុំ ក្រៅ ផ្លូវការ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន +១ ចំនួន ០៣ ក្នុង អំឡុង ពេល នៃ កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន លើក ទី ១២ និង កិច្ចប្រជុំ រដ្ឋមន្ដ្រី ការពារ ជាតិ អាស៊ាន - បូក លើក ទី៥នេះ ផងដែរ ៕ ប្រហែស បាត់ ប្រយ័ត្ន គង់ ! អាវុធហត្ថ រាជធានី ភ្នំពេញ បញ្ជូន ចោរ លួច ម៉ូតូ ម្នាក់ ទៅ តុលាការ ដើម្បី ផ្ដន្ទាទោស តាម ច្បាប់
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០១៨ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ញ្ជូន ជនសង្ស័យ ម្នាក់ ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ផ្តន្ទាទោស តាម ច្បាប់ ដែល ជាប់ពាក់ព័ន្ធ ករណី លួច ម៉ូតូ ។
លុះ ប្រហែល ០៥ នាទី ក្រោយមក ស្រាប់តែ មាន ជនសង្ស័យ ខាងលើ បាន ឆ្លៀត ឱកាស ចូល លួច យក ម៉ូត របស់ ជនរងគ្រោះតែ សំណាង មិន ល្អ ត្រូវបាន ជនរងគ្រោះ ឃើញ បាន ស្ទុះ មក ប្រតាយ ប្រតប់ ជាមួយ ជនសង្ស័យ ហើយ ស្រែក ឆោរ ឡោ លឺ ដល់ សមត្ថកិច្ច អាវុធហត្ថ ខណ្ឌ ទួលគោក ដែល កំពុង ល្បាត ឃើញ បាន ចុះ មក ឃាត់ខ្លួន ភ្លាម ៗ តែម្តង ។ ករណី នេះ កើតឡើង កាលពី ថ្ងៃទី ១៥ ខែតុលា ឆ្នាំ ២០១៨ នៅ ចំណុច មុខ ផ្ទះ លេខ ៣១៤ សង្កាត់ ទឹកល្អក់៣ ខណ្ឌ ទួលគោក ។
