ពេលព្រឹកត្រូវយកផ្លែល្វាមកត្រាំជាមួយនឹងទឹក។
អ្នកដុតឈុតនេះ អ្នកមិនមែនជា Robin ទៀតទេ អញ្ចឹងឥឡូវម៉េចទៅ ?
សំឡេង សហរដ្ឋ អាមេរិក បន្ត បេសកកម្ម របស់ ខ្លួន នៅ ថ្ងៃ នេះ ក្នុង ជម្លោះ ពិភពលោក ដែល ពោរពេញ ដោយ ជម្លោះ និង មិន ស្ថិតស្ថេរ ក្នុង យុគសម័យ ក្រោយ សង្គ្រាម ត្រជាក់ ។
ឥឡូវនេះ ខ្ញុំ នៅក្នុង ថ្នាក់ សម្តែង ។
សាកសពក្មេងស្រីកំសត់នោះមិនត្រូវបានរកឃើញទេ ។
ទាក់ទង នឹង រឿង នេះ ពួកគេ មាន ការភ្ញាក់ផ្អើល នៅ ពេល ដែល អ្នក មិន ចូលរួម ជាមួយ ពួកគេ នៅក្នុង ទឹក ជំនន់ ដូចគ្នា ហើយ ពួកគេ ធ្វើបាប អ្នក ប៉ុន្តែពួកគេនឹងប្រាប់គាត់
17 ដើម្បីកុំឲ្យវារីក រាលដាលទៅមុខទៀត យើងត្រូវព្រមានគេកុំឲ្យនិយាយជាមួយអ្នក ណាក្នុងនាមនេះឡើយ » ។
ការអធិស្ឋាន ដើម្បី អធិស្ឋាន សម្រាប់ កូន របស់ អ្នក ។
១៦ « ហើយបើគាត់មិនបានលាងសម្អាត ឬងូតទឹកខ្លួនទេ នោះគាត់នឹងទ្រាំទ្រនឹង ភាព ច្របូកច្របល់របស់គាត់ » ។
ព្រះ នៃយើងគឺ ជាអ្នកដែល សង្គ្រោះយើង
ដូច្នេះ អ្នក ទាំងពីរក៏ចាកចេញទៅផ្ទះបុរសម្នាក់នៅភូមិបាហ៊ូរី ម
នៅ កន្លែង ដ៏ ត្រឹមត្រូវ របស់ ខ្លួន ជា កន្លែង ខ្ពស់ ។
ពួកសាវកបានអធិស្ឋាន ហើយដាក់ដៃលើពួកគេ ។
បើគេនិយាយមិនខុសទេ !
ឥឡូវ នេះ គឺជា ពេលវេលា របស់ អ្នក ដើម្បី រីករាយ ជាមួយ គាត់ ។
« ព្រះ បានប្រទានឲ្យពួកគេមាន ចិត្តស្រឡាំងកាំង » ។
ខ្ញុំពិតជាចូល ចិត្តបរិយាកាសនៅ សារ មន្ទីរ » ។
យ៉ូហាន 2:7 ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « ចាក់ទឹកពេញផើង ។
ឥឡូវនេះ អ្នក នឹង ឃើញ កម្មវិធី និពន្ធ ចុះបញ្ជី ។
គឺជា ជំហាន មួយ សម្រាប់ អ្នក
និង ភាពល្អ ដែល ពួកគេ ធ្លាប់ ស្គាល់ ។
ព្រះគុណ នៃ មុខ របស់ គាត់ ។
« វាកំពុង តែរីក ចម្រើនយ៉ាងខ្លាំង » ។
បើល្អយើងនឹងឃើញភ្លាម
នៅពេល អ្នក ប្រមូល អ្នក រៀន ច្រើន ។
ហើយ នឹង ត្រូវបាន ផ្តល់ អំណាច ដោយ វា ។
ទំនួល ខុសត្រូវ របស់ មនុស្ស គ្រប់ រូប មាន ភាពច្បាស់លាស់
ព្រះអម្ចាស់ មាន ព្រះបន្ទូល មកកាន់ អ្នក ។
មនុស្ស ទាំង នេះ គឺជា សមាជិក រង និង បម្រើ រយៈពេល មួយ ឆ្នាំ ។
ខ្ញុំ ចង់ ធ្វើ បន្ថែម ទៀត សម្រាប់ សហគមន៍ ហ្គេម ។
គំនូរ ជីវ ចល តាំងពី ឆ្នាំ ១៤៧០
រូបភាព អង្គ ចងចាំ ខ្ពស់ មិន គាំទ្រ ទេ ។
ចំណុច នោះ គឺ ថា គ្មាន ការលះបង់ ដែល អ្នក អាច ធ្វើ សម្រាប់ ព្រះយេស៊ូវ ដែល អ្នក នឹង បញ្ចប់ ការសោកស្តាយ នោះ ទេ ។
ខ្ញុំ ជាប្រធានាធិបតី ហើយខ្ញុំមិនអាចនិយាយថាទេ » ។
អនុញ្ញាតឱ្យ គ្រូពេទ្យ របស់ អ្នក ដឹង ពី អ្វី ដែល បាន កើតឡើង នៅក្នុង ជីវិត របស់ អ្នក ចាប់តាំងពី ការទៅ ជួប លើក ចុងក្រោយ របស់ អ្នក ។
ចុះឈ្មោះ នៅ ទីនេះ ដើម្បី ទទួលបាន បញ្ជី រង់ចាំ ។
“ ការទទួលបាន សេវា សង្គម នៅតែ ជា បញ្ហា ក្នុង ប្រទេស ស៊ូ ដង់ ខាងត្បូង ទាំងមូល ហើយ សម្រាប់ អ្នក ត្រលប់ មកវិញ វា មិន ខុសគ្នា ទេ ។
ខ្ញុំ មាន ប្រភេទ នីមួយ ៗ រស់ នៅក្នុង ផ្ទះ របស់ ខ្ញុំ ។
ត្រឹមត្រូវ ហើយ ខ្ញុំ ប្រាប់ ខ្លួន ឯង ថា ចាប់ ដៃ ។
សេចក្តីពិត គឺ ត្រង់ , ធម្មតា , ច្បាស់លាស់ , និង ឈរ ចេញ ដោយ ក្លាហាន នៅក្នុង ការការពារ របស់ ខ្លួន ។ ប៉ុន្តែវាមិនដូច្នោះទេដោយមានកំហុស ។
ការអភិវឌ្ឍន៍ គឺ សំខាន់ ប៉ុន្តែ យើង ក៏ កំពុង ព្យាយាម បង្រៀន អ្នកលេង ពី របៀប ឈ្នះ ផងដែរ ” ។
ពួកគេបានបង្ហាញពីអ្វីដែលពួកគេមានយ៉ាងបរិបូរណ៍ » ។
គាត់ បាន បង្កើត ស្បែកជើង ប្រអប់ ( ស្បែកជើង កែង ជើង ដែក ) ដែល នាំឱ្យ គាត់ មាន ទ្រព្យសម្បត្តិ ច្រើន ។
ខ្វល់ខ្វាយ អំពី គុណភាព ទឹក ដែល អ្នក ផឹក អ្នក គួរតែ មាន
ខ្ញុំ ជា ម្ចាស់ សិទ្ធិ នៃ ដែន នេះ ។
តើអ្នកដឹងទេថានៅព្រឹកស្អែកនឹងមានលេខប៉ុន្មានទេ ?
នេះ គឺជា ថ្ងៃ នៃ ការគណនា សម្រាប់ អ្នក ។
ព្យាយាមលួង លោម ហេតុអ្វីបានជាអ្នកមិនអនុញ្ញាតឱ្យវាកន្លង ផុតទៅ ?
« ទៅមុខហើយខ្ញុំនឹងតាម » ។
រូបភាព ទី 8 គឺជា កន្លែង ដែល យើង កំពុង ស្តាប់ ព័ត៌មាន លម្អិត ទាំងអស់ ។
បទគម្ពីរប្រាប់យើងនៅក្នុង យ៉ូហាន ១៦: ៣៣ ថា « ក្នុងលោកនេះ អ្នកនឹងមានបញ្ហា » ។
និក្ខម នំ 12:33 ជន ជាតិអេស៊ីបទាំងអស់បានដាស់តឿនជន ជាតិអ៊ីស្រា ‌ អែលឲ្យចាកចេញពីស្រុកឲ្យបានលឿនតាមដែលអាចធ្វើទៅបាន ដ្បិតគេគិតថា យើងទាំងអស់គ្នានឹងស្លាប់ ។
ជា ការប្រសើរ ណាស់ , មនុស្ស ដែល អ្នកបោះឆ្នោត ឱ្យ កំពុង ធ្វើ ដូចគ្នា ។
អ្នក ត្រូវតែ ធ្វើ អ្វី ដែល ធ្វើឱ្យ អ្នកសប្បាយ ចិត្ត ។
បន្ទាប់ពី ការជំនុំ ជំរះ ស្ថាន សួគ៌ ឬ ឋាននរក ។
តាំងពីដើមដំបូងមក ហើយត្រូវបានគេប្រគល់មកពីជំនាន់មុន ។
៣ ឥឡូវនេះ ព្រះ យេហូវ៉ាបាននាំវាមក ហើយធ្វើតាមដែលទ្រង់មានព្រះបន្ទូលថា ដោយព្រោះអ្នក រាល់គ្នាបានប្រព្រឹត្តអំពើ បាបទាស់នឹងព្រះ យេហូវ៉ា ហើយមិនបានស្តាប់តាមព្រះសូរ សៀងរបស់ទ្រង់ ហេតុដូច្នេះហើយបានជារឿងនេះកើតឡើង
តើ អ្នក ប្រាកដ ទេ ថា អ្នក ចង់ បង្ហាញ មនុស្ស ទាំងអស់ នូវ អាថ៌កំបាំង របស់ អ្នក ?
យើងចង់ឲ្យរឿងក្តីរបស់តុលាការមាន ភាពយុត្តិធម៌ ។
« យើងរីករាយនឹងជំហានដែលរដ្ឋាភិបាលបានធ្វើក្នុងប៉ុន្មានថ្ងៃចុងក្រោយនេះ ។
ហើយ ផ្តល់ឱ្យ យើង នូវ ការសង្គ្រោះ របស់ អ្នក ។
ឧបករណ៍ បំប្លែង អាមេរិក ។
ចាប់តាំងពី យើង កំពុង និយាយ សម្រាប់ ជា ប្រយោជន៍ នៃ កំណត់ត្រា , អនុញ្ញាតឱ្យ
ពួកគេបានបែងចែកទ្រព្យ សម្បត្តិ ហើយរុះរើផ្ទះ ។
ផ្ទះនេះមិនមានមនុស្សទៀតទេ ។
ថ្ងៃនេះ ខ្ញុំសុំឲ្យអ្នកអធិស្ឋានសុំការ យល់ពីព្រះបន្ទូលរបស់ព្រះ។
22 លោកដាវីឌឆ្លើយ ថា៖ « នេះជាលំពែងរបស់ស្តេច សូមឲ្យយុវជនម្នាក់មកយក ។
ហើយ ឥឡូវនេះ នាង ស្វែងរក ការសងសឹក លើ ទឹកដី អូស្ត្រាលី ។
ដើម្បី ដោះស្រាយ បញ្ហា នេះ គ
វា មិន មែន ជា កាតព្វកិច្ច ដែល យើង ចូលចិត្ត នោះ ទេ ។
ដូច្នេះហើយ ខ្ញុំ ចាប់ផ្តើម ធ្វើ ជើង ទាំងនេះ ដោយ ខ្លួន ឯង ។
នាងថានាងមិនអាចបន្ទោសប្តីនាងបានទេ ។
នៅ ទីបំផុត វានិយាយថា៖ « ដូច្នេះ យើងនឹងនៅ ជាមួយនឹងព្រះ យេហូវ៉ាជា និច្ច ។
ប្តីតើធ្វើម៉េចដឹងថាអាច សង្គ្រោះប្រពន្ធបាន ?
រក្សា ភ្លើង ឆេះ ១
ពេលទៅដល់ដីខ្ពស់ ឬពេលចុះជម្រាល ។
