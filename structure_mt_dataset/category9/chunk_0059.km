កាលនោះវាជាផ្លែ ឈើ និងរុក្ខជាតិដែលប្រើដើម្បីកែប្រែស្ថានភាព នៃ ចិត្តរបស់មនុស្ស ។
បើយើងព្យាយាមឲ្យបានគ្រប់គ្រាន់ យើងអាចឃើញដូចនៅទី នោះ ។
ត្រូវ ពន្យារ ពេល ការងារ នៅ ពេល ក្រោយ ។
ខ្ញុំមិនបានធ្វើបែបនេះនៅវិទ្យាល័យ ឬពេល ណាមួយទេ » ។
សង្ខេប៖ អះអាង ថា មាន ទីក្រុង ធំ ជាង គេ
ពួកគេ ខ្វាក់ ភ្នែក និង ថ្លង់ ដោយសារ សាសនា ដែល ពួកគេ ជឿ ។
កូនអើយ ចូរស្ដាប់ពាក្យ ប្រៀន ប្រដៅរបស់ឪពុកចុះ
ដោយ សារ តែមានមនុស្សជាច្រើនដែល មកពីសហរដ្ឋអាមេរិកមកទស្សនាផ្នែកនេះនៃប្រទេស New Zealand ។
អា ហ្នឹងខ្ញុំទៅរស់ !
ប្រធានបទ៖ តើ សំឡេង នៅក្នុង នេះ មាន បញ្ហា អ្វី ?
ប៉ុន្តែ ការងារ សំខាន់ បំផុត គឺ របស់ អ្នក ។
ប្រហែល ជាមួយ អ៊ីញ ទៅ ពីរ ពី ជញ្ជាំង ។
និយាយថាចាស់ទៅសុភាព?
ទន្ទឹមនឹង នេះ យើង មិន គាំទ្រ អ្វី ដែល ចិន កំពុង ធ្វើ នៅ ហុងកុង ទេ ។
មួយ ខែ ក្រោយមក គាត់ បាន ទទួល បុណ្យ ជ្រមុជ ទឹក ជា អ្នក ដើរ តាម ព្រះយេស៊ូវ គ្រីស្ទ ។
ហាមមិនឱ្យពាក់មួកដែលធ្វើឱ្យមុខមើលឃើញ
ចង់ដឹងថាមានរឿងអ្វីកើតឡើងតាំងពីភាគ ៤ មក ។
វាត្រូវបានគេយកទៅកាសែតភ្នំពេញប៉ុស្តិ៍៖
កិច្ចការ 7:54 ពួកគេបានឮសេចក្ដី ទាំងនេះហើយក៏ក្ដៅ ក្រហាយក្នុង ចិត្ត ហើយសង្កៀតធ្មេញប្រឆាំងនឹងលោក ។
អ្វី ៗ ទាំងអស់ នេះ នឹង កន្លងផុត ទៅ នៅ ទីបញ្ចប់ ។
ជាក់ស្តែងបើយើងចូលទៅក្នុងទីក្រុង ព្រោះអត់មានម្ហូបអាហារនៅក្នុងទីក្រុង យើងនឹងស្លាប់ ។
វីរ នារីទាំងអស់នេះជាស្ត្រីដែលឧស្សាហ៍ព្យាយាម ។
ហើយពួកគេដឹងថាយើងដឹងថាពួកគេ ជាមនុស្សឆ្កួត » ។
@ អ្នក ផ្សេង ទៀត ទាំងអស់ នៅក្នុង សហគមន៍ នេះ ។
វានឹងបំបែក នគរទាំងអស់នេះជាបំណែក ៗ ហើយ នាំឱ្យពួកគេ បញ្ចប់ទៅ ហើយវានឹងស្ថិតនៅ ជារៀងរហូត » ។
វា ជា របៀប ដែល យើង ចាប់ផ្តើម ជារៀងរាល់ ថ្ងៃ ។ វា ក្លាយជា ទម្លាប់ ។
សន្មត ថា ព្រះយេស៊ូវ គឺជា វិវរណៈ ដោយ ផ្ទាល់ និង តែ មួយ គត់ ។
ហើយនេះជាអ្វីដែលកើតឡើង » ។
នេះជាទង្វើដែលខ្ញុំផ្ទាល់មិនប្រកាន់ទេ ។
ដូច្នេះ បុរសនោះក៏ធ្វើកាយវិការដោយដៃម្ខាងថា « យើងធ្វើដើម្បីចិញ្ចឹមកូនយើង » ។
ឥឡូវនេះ - ហើយ នៅក្នុង ពីរ ឆមាស ចុងក្រោយ នេះ វា គឺជា ការផ្តោត អារម្មណ៍ នៃ វគ្គ សិក្សា របស់ ខ្ញុំ ជា លើក ដំបូង ។
ដោយ សារ តែអ្នកត្រូវបានគេយកមកចិញ្ចឹមដោយព្រះ នោះទ្រង់គឺជាអ័បា ( បិតា ) ។
« ដ្បិតបើព្រះ មិនមានសេចក្ដី មេត្តា ក រុណាដល់មែកធម្មជាតិទេ នោះទ្រង់នឹងមិនអាណិតអាសូរអ្នកឡើយ » ។
ក្តៅណាស់វាធ្លាក់ចូលបេតុង ២» ។
ខ្ញុំសូមសរសើរគាត់ថា គាត់ខំធ្វើការ ដើម្បីអ្នក និងអ្នកនៅឡៅឌី សេ និងហេរ៉ា ប៉ូលីស ។
ខ្ញុំនៅ តែទុកចិត្តគាត់ឲ្យធ្វើរឿងត្រឹមត្រូវរហូតដល់គាត់ក្បត់ការ ទុក ចិត្តរបស់យើង ។
អូគាត់ មិន អាច គ្រប់គ្រង ខ្លួន ឯង បាន ទេ គាត់ ជា បុរស ។
សំរាម ប៉ុន្តែ ខ្ញុំ ស្រលាញ់ វា ។
“ នេះជារឿងថ្មី ។
នេះគឺជាការ ពិតកាន់ តែខ្លាំងនៅពេលដែលម្នាក់នោះ ...
ក្រៅពីនេះខ្ញុំមិនខ្វល់ពីសត្វ ទ ន្សោងទាំងនេះទេ ។
អ្នក ផ្សាយដំណឹងល្អ កាលលោកមាន ប្រសាសន៍ដូច្នេះហើយ លោកក៏ចេញទៅ ឯជន ជាតិយូដាម្ដងទៀត ហើយមាន ប្រសាសន៍ទៅពួកគេថា៖
នោះ ហើយ ជា រូបភាព កម្រង ព័ត៌មាន របស់ ខ្ញុំ ។
20 គាត់មាន ប្រសាសន៍ថា៖ « ចូរទៅឈរនៅ ទីលាននៃព្រះវិហារ ហើយប្រាប់ប្រជាជននូវ សារដ៏ពេញលេញនៃជីវិតថ្មីនេះចុះ » ។
កុំ បណ្តោយ ឱ្យ ជីវិត នេះ ឆ្លងកាត់ អ្នក ដោយ មិន បាន ឮ ពី នរណា ម្នាក់ ដែល អ្នក បាន បំផុស គំនិត ពួកគេ តាម មធ្យោបាយ ណាមួយ ឡើយ ។
បន្ទាប់មក គាត់ ដឹង ពី អ្វី មួយ ដែល សម្លឹង មក គាត់ ពី ខាងមុខ ។
ផ្លែ ប៉ោម ភ្លឺ នៅក្នុង តំបន់ នេះ ។
ខ្ញុំនិយាយសេចក្ដី ដែលខ្ញុំបានឃើញពីបិតារបស់ខ្ញុំ ហើយអ្នក រាល់គ្នាធ្វើការ ដែលអ្នក រាល់គ្នាបានឃើញពីបិតារបស់អ្នក » ។
ដូចនេះដែរ នគររបស់ខ្ញុំមិននៅ ទីនេះទេ » ។
ពួកគេ បាន ធ្វើ ទារុណកម្ម គាត់ ជាច្រើន ម៉ោង មុនពេល សម្លាប់ គាត់ ។
សេចក្ដី ស្រឡាញ់មិនមែនកើតចេញពីឈាម តែប៉ុណ្ណោះ ។
ត្រូវបាន ខ្ចាត់ខ្ចាយ ពី ទីនោះ ។
២៣ ពេលដែលការ បម្រើព្រះវិហារបានផុតកំណត់ គាត់ក៏ត្រឡប់ទៅផ្ទះវិញ ។
ផ្ទុយទៅវិញ ដូចជានៅក្នុងករណីនេះ ខ្ញុំត្រូវតែទទួល យកការ បាត់ បង់មិត្តភ័ក្ដិដូចជាខ្ញុំ ។
វាជារឿងមួយដែលខ្ញុំរង់ចាំអស់ រយៈពេល ៣៣ ឆ្នាំ មកហើយ ។
ទេ ខ្ញុំ កំពុង នាំ មិត្ត ស្រី របស់ ខ្ញុំ ។
អ្នកនឹងធ្វើការ ល្អក្នុងការ យក ចិត្តទុកដាក់ចំពោះរឿងនេះ ដូចជា ចង្កៀងដែលចាំងក្នុងទីងងឹត រហូតដល់ថ្ងៃ រះ និងផ្កាយព្រឹក រះឡើងក្នុង ចិត្ត ។
ការសុគត របស់ ព្រះគ្រីស្ទ មិន ត្រឹមតែ ជា ការបង្ហាញ នៃ សេចក្តីស្រឡាញ់ របស់ ព្រះប៉ុណ្ណោះ ទេ ( យ៉ូហាន 3:16) ប៉ុន្តែ ក៏ ជា ការបង្ហាញ ដ៏ ខ្ពង់ខ្ពស់ នៃ សេចក្តីស្រឡាញ់ របស់ ព្រះគ្រីស្ទ ចំពោះ មនុស្ស ទាំងអស់ ដែល ទទួល ទ្រង់ ជា ព្រះអង្គ សង្គ្រោះ ផ្ទាល់ខ្លួន របស់ ពួកគេ ។
នៅសល់ លើ ការធានា ។
នៅ ទីនោះ នៅ ពីមុខ អ្នក គឺជា បន្ទះ តក្កវិជ្ជា ។
សម្រាប់ រយៈពេលពីរថ្ងៃ ព្រលឹងត្រូវបានអនុញ្ញាតឲ្យដើរហើរទៅលើផែនដីតាម ចិត្ត ដោយមានទេវតាដែល មកជាមួយ ។
របៀប ស្លៀកពាក់ សម្រាប់ ពិធី ជប់លៀង ក្រឡុក ?
លេង ដោយ មនុស្ស ពីរ ទៅដប់ នាក់ ។
ខ្ញុំ ពិតជា មានអារម្មណ៍ ដូចជា ខ្ញុំ ជា ឪពុក របស់ ពួកគេ ។
ប្រសិនបើបញ្ហាណាមួយត្រូវបានបោសសម្អាតនៅក្រោមកម្រាល ព្រំ ឥឡូវនេះដល់ ពេលត្រូវដោះស្រាយហើយ។
ព្រះបន្ទូលរបស់ព្រះ បានបំភាន់ពួកម៉ាហ្គី ជាច្រើន ។
« អ្វីដែល នាំភ្ញៀវទេសចរចូលទីក្រុងត្រូវ តែល្អ
ឋាននរក គាត់ មិន បាន រំពឹងទុក រយៈពេល សន្ទនា នេះ ទេ ។
ដោយ ដាវ របស់ ទ្រង់
ពេល រសៀល ពួកសិស្សចូលមកគាល់ព្រះអង្គ ហើយពោលថា៖ « វាយឺតហើយ ។
គាត់បានស្បថនឹងខ្ញុំថា គាត់នឹងធ្វើបែបនេះ » ។
ខ្ញុំ បាន ទាញ ក្រុមគ្រួសារ នៅ តុ បន្ទាប់ ។
ការទស្សន៍ទាយអាប់ អួរគឺខុស !» ។
ខណៈពេលដែលអ្នកមិនអាចផ្លាស់ប្តូរកត្តាដូចជាអាយុ និង ព ន្ធុវិទ្យា របបអាហារគឺជាអ្វីដែលអ្នកអាចគ្រប់គ្រងបាន ។
សូម អញ្ជើញ ភ្ញៀវ កិត្តិយស ។
អ្នកយាម ដែល ត្រូវបាន តែងតាំង ដោយ ព្រះ ឬ កំណត់ ដោយ ព្រះ មាន ឥទ្ធិពល ខុសគ្នា ។
ហើយ ទីបំផុតហេតុអ្វីបានជាយើងត្រូវចិញ្ចឹមច្រើនម្ល៉េះ ?
គាត់ ស្នាក់ នៅ ទីនេះ ក្នុង ទីក្រុង ។
គ្មាន អ្វី ធ្លាក់ ពីលើ មេឃ ទេ ។
ទារកបាន ទទួល ការវះកាត់ ហើយ ឥឡូវនេះ គាត់ មាន សុខភាពល្អ ។
នាង បាន រៀបការ ជាមួយ គាត់ នៅពេល ពួកគេ ធំ ឡើង ។
