* បញ្ជាក់ ឈ្មោះ អ្នកនិពន្ធ នៃ ប្លក់ នីមួយ ៗ ។
អនុក្រឹត្យសម្រាប់ភាគី អវិជ្ជមានត្រូវបានធ្វើឡើង ។
ពោលគឺមិនត្រឹម តែខុសច្បាប់ទេ ។
លើកតម្កើង ព្រះនាម របស់ ព្រះជាម្ចាស់ ។
“ យើងធ្វើការ ច្រើនជាមួយក្រុមហ៊ុន ។
អូ រាប់ ពី ហុងកុង
អ្នក អាច ពឹងផ្អែក លើ ពួក វា សម្រាប់ ការសម ឥត ខ្ចោះ និង ការលួងលោម ពេញ មួយ ថ្ងៃ ។
36 កាលលោកដើរទៅ នោះគេយកអាវ មកពាក់តាមផ្លូវ ។
ជន ជាតិអ៊ីស្រាអែល រត់ចេញពីមុខ ជន ជាតិភីលី ស្ទីន ។
ក្រុមហា ម៉ាស់ បាន និយាយ ថា ខ្លួន នឹង មិន ចូលរួម ក្នុង ការបោះឆ្នោត នេះ ទេ ។
ចាប់គាត់ទៅ ហើយប្រសិនបើគេធ្វើដូច្នេះ គាត់ក៏នឹងត្រូវគេ ប្រហារជីវិតដែរ ។
វា ទាំងអស់ មកពី ទ្រង់ និង តាមរយៈ ទ្រង់ និង ចំពោះ ទ្រង់ ។
គ្រាន់តែ គ្មាន ការបញ្ចប់ ដ៏ រីករាយ ។
ប៉ុន្តែអ្វីដែលពួកគេមិនយល់នោះគឺថា វាគឺដោយព្រះគុណនៃព្រះ។
គាត់និយាយថា៖ « ខ្ញុំច្បាស់ជាបាន ពរពីព្រះ។
ពួកគេគ្រាន់ តែមិនទទួលបានការ គាំទ្រពីពួកគេ » ។
តាមពិត ប្រសិនបើ អ័ ប្រាហាំ ត្រូវបាន រាប់ ជា សុចរិត ដោយសារ ការប្រព្រឹត្ដ គាត់ មាន អ្វី ដែល ត្រូវ អួត ។
ហើយយើងនឹងមិនចូលទៅជិតនោះទេរហូតដល់យើងនៅទីក្រុងអូក្លាហូម៉ា ។
ពេលយើងចាប់ផ្ដើមចូលទៅជិតព្រះ ទ្រង់ចូលមកជិតយើង ។
ដោយការ លក់កិត្តិយស និងសេចក្តី ថ្លៃថ្នូរ ដោយហិង្សា
“ ភាពស្មោះត្រង់ គឺ ការធ្វើ អំពើ ល្អ នៅ ពេល ដែល គ្មាន នរណា ម្នាក់ មើល ។
43 ដូច្នេះហើយបានជាមានការ បែកបាក់គ្នាក្នុងចំណោមប្រជាជនដោយ សារគាត់ ។
ភ្លៀងម្តងទៀតពេលព្រឹកទើបខ្ញុំបង្ហោះ ...
ផ្ទះ ឬ ទ្រព្យសម្បត្តិ អ្នកណា ចង់បាន ហើយ អ្នកណា រីកចម្រើន ក្នុង នោះ ។
ទោះងងឹតក៏ដោយ ខ្ញុំអាចមើលឃើញច្បាស់ ។
ខ្ញុំក៏នឹងសួរអ្នករឿងមួយថា បើអ្នកប្រាប់ខ្ញុំ ខ្ញុំក៏នឹងប្រាប់អ្នកថាខ្ញុំធ្វើការ ទាំងនេះដោយអំណាចអ្វី ។
នោះជាអ្វីដែលបានចូលទៅក្នុង ចិត្តរបស់ខ្ញុំនៅថ្ងៃនេះ ដោយបានឮពីមាត់របស់នាង ។
ហើយ បាន ស្នាក់ នៅ យ៉ាង ល្អិតល្អន់ ។
យើង ទាំងអស់ គ្នា ជា កូន របស់ ព្រះ៖ ដែល ផ្សព្វផ្សាយ ការស្តីបន្ទោស ។
15ដ្បិតយើងខ្ញុំជាជនបរទេស និងជាជនបរទេសនៅចំពោះព្រះភក្ត្រព្រះអង្គ ដូចជាបុព្វបុរសរបស់យើងទាំងអស់គ្នា ។
រីករាយ ដូច យើង ដែរ ។
ក្រៅពីនេះ អ្នកអាចប្រើវាសម្រាប់អ្វីផ្សេងទៀត » ។
កាន់តែ ពិសេស ទិញ វា ឥឡូវនេះ
ជនជាតិ ដើម នៃ សញ្ញា នេះ ភ្ជាប់ តម្លៃ ខ្ពស់ ទៅនឹង ភាពស្រស់ស្អាត ; ពួកគេ ត្រូវបាន គេ ដឹង ថា មាន រសជាតិ ឆ្ងាញ់ លើ អ្វី ៗ ។
គាត់បានលើក ត ម្កើងមួយកម្រិត ដែលគួរឲ្យសរសើរ ។
43 គាត់យកវាមកបរិភោគនៅមុខគេ ។
ខ្ញុំចង់ឱ្យប្អូនស្រីរបស់ខ្ញុំស្ងប់ ស្ងាត់។
បុរស ចំណាស់ បាន ទៅ បើក ទ្វារ ។
រហូតមកដល់ ពេលនេះ ពួកគេ ជា កូន ដ៏ អស្ចារ្យ ។
ឥឡូវដូច កាលពីមុន មនុស្ស មកទីនេះដើម្បីសម្ដែង
ដោយផ្អែកលើឈ្មោះនៃការ ប្រយុទ្ធ, ព្រោះនៅក្នុងសេចក្ដី ស្រឡាញ់។
នឹង សម្លាប់ ការសន្យា ដែល មាន ផ្ទៃពោះ នៃ ភាពងងឹត ។
វាមិនចម្លែកទេដែលគាត់មិនបានទៅទី សក្ការៈច្រើន » ។
នេះ ជា របស់ ខ្ញុំ តាំងពី ពេល ខ្លះ ។
ពេលនោះ ឪពុកប្រាប់អ្នក បម្រើថា ចូរយកកូនគោដែលធាត់ មកពីរក្បាល ។
ពេល ខ្លះ ខ្ញុំ មានអារម្មណ៍ ថា ខ្ញុំ ចម្លែក ដូច ពន្លឺ ។
លោកមាន ប្រសាសន៍ ថា៖ « ព្រះរាជ្យរបស់ព្រះ ក៏ដូចជាមនុស្សបោះគ្រាប់ពូជមកលើផែនដីដែរ ។
មុនពេលគេសម្លាប់ខ្ញុំ » ។
នាឡិកា គឺ នៅលើ ដាច់ សរសៃ ឈាម ខួរក្បាល ប្រាំបួន -
“ ខ្ញុំមិនទៅទីនោះទេឆ្នាំនេះ។
ខ្ញុំគិតថាមួយនេះ កាន់ តែខ្លាំងជាងនេះ ។
បើគេចង់មានរយៈពេលខ្លី ។
ហើយនិយាយ ជាមួយ កុមារ អំពី ការថ្វាយបង្គំ របស់ ពួកគេ ។
និង របៀប ដែល នាង មក អភ័យទោស ដល់ អ្នក បាញ់ប្រហារ ។
តើប្រាំបួននាក់ទៀតនៅឯណា ។
ពួកគេ មិន ត្រូវការ ភស្តុតាង នៃ អាសយដ្ឋាន នៅ សហរដ្ឋ អាមេរិក ឬ អ្វី ទេ ?
ចូរទៅបង្ហាញខ្លួនដល់ សង្ឃចុះ » ។
បើ គ្មាន វត្តមាន របស់ ព្រះទេ មនុស្សជាតិ នឹង ត្រូវ វិនាស ។
ដើម្បី បញ្ឆោត អ្នកដទៃ ។
ខ្ញុំគិតថាទោសនោះជាជីវិត ។
បើគុណធម៌និងចំណេះដឹងត្រូវបានសាយភាយក្នុងចំណោមមនុស្ស នោះគេនឹងមិនក្លាយជាទាសករឡើយ ។
នោះមិនមែនជាអ្វីដែលយើងត្រូវការ ទៀតទេ » ។
ហើយខ្ញុំបានប្រាប់ពួកគេនូវអ្វីដែលអ្នក និយាយអំពីមួយ រយសែសិប
កុំបោះបង់ឡើយ ប៉ុន្តែបន្តព្រមានបងប្អូនរបស់អ្នក ដើម្បីឲ្យពួកគេត្រឡប់ទៅ កាន់មាគ៌ានៃដំណឹង ល្អវិញ ។
ប៉ុន្តែដោយសារយើងមិន មែន អ្នកអាចធ្វើវាជំនួសវិញ៖
គ្មានអ្នក ណាខ្វាក់ជាងអ្នកដែលមិនចង់ឃើញនោះទេ ។
៣០ មានហេតុការណ៍ដ៏អាក្រក់មួយកើតឡើងនៅក្នុងស្រុក៖
ហេតុនេះហើយបានជាខ្ញុំប៉ូលជាអ្នក ទោសនៃព្រះគ្រិស្ដយេស៊ូសម្រាប់ជាប្រយោជន៍ដល់អ្នកជា សាសន៍ ដទៃ -
ពេល រសៀល ហើយ ខ្ញុំ បាន ប្រាប់ គាត់ ថា ខ្ញុំ ត្រូវតែ ទៅ ផ្ទះ ។
« ខ្ញុំបានឃើញព្រះវិញ្ញាណចុះ មកពីស្ថាន សួគ៌ដូចជាសត្វព្រាប ហើយសណ្ឋិតលើគាត់ ។
ការ សម្លាប់ប្រពន្ធកម្រិតទីពីរ
« ខ្ញុំ មកដុតផែនដី ។
ចំពោះសេចក្ដី សុចរិតតាមច្បាប់ ខ្ញុំគ្មានកំហុសទេ ។
តើវាសមហេតុផលទេសម្រាប់ស្ត្រីដែលណាត់ជួបបុរសវ័យ ក្មេង?
ពី អស់ អ្នក ដែល បាន ទទួល ច្រើន នោះ នឹង ត្រូវ ទាមទារ យ៉ាង ច្រើន ហើយពីអ្នកដែលត្រូវបានគេទុក ចិត្តច្រើន នោះនឹងត្រូវសួរច្រើនទៀត » ។
លោកជឿថា សាធារណជននឹង រីករាយចំពោះការ ឆ្លើយ តបនេះ ។
3:11 ហើយឥឡូវនេះ , កូនស្រីរបស់ខ្ញុំ , កុំភ័យខ្លាច ; អ្វី ដែល អ្នក និយាយ ខ្ញុំ នឹង ធ្វើ សម្រាប់ អ្នក ។ អស់អ្នកដែលនៅមាត់ទ្វារប្រជាជនខ្ញុំដឹងថា អ្នក ជាស្ត្រីដែលសក្តិសម ។
មួយ គឺ ផ្អែក លើ សេចក្តីពិត សេចក្តីជំនឿ ឬ សិទ្ធិ អំណាច ដែល បាន បង្ហាញ ឱ្យ ឃើញ ។
ពេលនោះ ជន ជាតិសាម៉ារីចូលមកគាល់ព្រះអង្គ ទាំងសុំព្រះអង្គនៅ ជាមួយគេ ហើយព្រះអង្គគង់នៅ ទីនោះពីរថ្ងៃ ។
គាត់ ឈប់ និយាយ ទៅកាន់ បុរស ចំណាស់
ខ្ញុំនឹងមិនស្នាក់នៅ ទីនេះទៀតទេ ដោយសារបញ្ហាភាសា ។
តើអ្នក ឃើញថាខ្លួនឯងត្អូញត្អែរនឹងអ្នក ដទៃ ហើយមិនចំពោះអ្នកដែលអ្នកខឹងឬ ?
16 ប៉ុន្តែប្រសិនបើគាត់មិនលាងសម្អាត ឬងូតសាច់គាត់ទេ នោះគាត់នឹងទទួល រងនូវអំពើទុច្ចរិតរបស់គាត់ ។
នៅលើ ផ្លូវ របស់ ពួកគេ ពួកគេ បាន ដឹង ថា មាន សញ្ញា ជាច្រើន ។
ចូរ ក្រោក ឡើង ក្នុង ព្រះនាម នៃ ព្រះដែល បាន ចាក់ ប្រេង តាំង !
មានអ្នកដែលដឹកទារក និងអ្នកដែលផ្តល់មេជីវិតឈ្មោល។
ដូច្នេះ សូម ក្រឡេក មើល ច្រក របស់ ខ្ញុំ ។
បើតាមយើងដឹងថាពួកគេនៅ តែជួបគ្នា។
ចូរ ដាក់ ឈ្មោះ វា ថា អតិថិជន ។
ដូច្នេះ ព្រះអម្ចាស់មិនទទួលពួកគេទេ ។ ទ្រង់នឹងនឹក ចាំពីអំពើទុច្ចរិតរបស់គេឥឡូវនេះ ហើយដាក់ទោសអំពើ បាបរបស់គេ » ។
ខ្ញុំ បាន រក្សាទុក ការងារ របស់ ខ្ញុំ នៅ ទីនោះ ។
នាងបានបន្ថែមថា “ មើលមាត់ខ្ញុំ ។
ប៉ុន្តែ គាត់មាន ប្រសាសន៍មកខ្ញុំថា៖ « អ្នក រាល់គ្នាត្រូវប្រយ័ត្នកុំធ្វើដូច្នេះ ខ្ញុំគ្រាន់ តែជាខ្ញុំបម្រើរបស់អ្នក ជាបងប្អូនរបស់អ្នក ជាព្យាការី និង ជាអ្នកប្រតិបត្តិសេចក្ដី ពិតដែលមានក្នុងសៀវភៅនេះ ។
ឬ យ៉ាងហោចណាស់ អ្នក គិត ថា អ្នក មិន អាច គ្រប់គ្រង វា បាន ។
· រក្សា ទំនាក់ទំនង ល្អ ជាមួយ មន្ត្រីរាជការ ។
ម្យ៉ាងទៀត ទ្រង់មាន ចិត្តស្រឡាញ់ចំពោះអ្នក ។
វា ហាក់ដូចជា រូបភាព ដែល ពួកគេ ផ្ញើ មក ខ្ញុំ ។
ត្រូវក្រោកឡើងដើម្បី ដូរ បង់រុំពេលយប់ ។
ដ្បិតយើងនឹង នាំពួកគេត្រឡប់ទៅស្រុកវិញ ហើយនឹងមាន ចិត្តអាណិតអាសូរដល់ពួកគេ » ។
ខ្ញុំធ្វើបែបនេះ តែមិនមែនអ្នកជិតខាងទេ !
គាត់មាន ប្រសាសន៍ ថា៖ « ព្រះ នៃបុព្វបុរសរបស់យើងខ្ញុំបានជ្រើស រើសអ្នក ឲ្យស្គាល់ព្រះហឫទ័យរបស់ព្រះអង្គ ហើយចង់ឃើញព្រះ ដ៏សុចរិត ហើយបានឮសំឡេងចេញពីមាត់របស់ព្រះអង្គ ។ ដ្បិតអ្នកនឹងធ្វើជាសាក្សីសម្រាប់គាត់ដល់មនុស្សទាំងអស់អំពីអ្វីដែលអ្នកបានឃើញ និងបានឮ ។
ឬអ្វីមួយបាននាំ មកលើយើងដោយអំពើ បាបរបស់បុព្វបុរសរបស់យើង ។
ដោយសារតែ អ្នក នឹង មិន ត្រឡប់ មកវិញ ។
បើ មិន អញ្ចឹង ទេ កុំ ធ្វេសប្រហែស ។
ពេលមកហូបបាយជុំគ្នា ចាំមើលគ្នាទៅ
« ហើយឥឡូវគាត់ចង់ឲ្យគេចូលបក្សយើងទេ ?
« ពេត្រុសនិងសាវ័ក ឯទៀតបានឆ្លើយ ថា៖ ‹ យើងត្រូវតែស្តាប់បង្គាប់ព្រះ ជាជាងមនុស្ស !
ព្រះ យេហូវ៉ាគឺធំជាងព្រះ ទាំងអស់ ហើយថាអំណាចរបស់ទ្រង់គឺគ្មាន គូប្រៀប » ។
ដូច្នេះត្រូវដកវាចេញទាន់ពេល ដរាប ណាវាប្រែជាពណ៌មាសស្រាល ។
កុំ ចូលរួម ក្នុង ការស្អប់ខ្ពើម ។
នៅក្នុង សំបុត្រ ទី ពីរ របស់ ប៉ុល ទៅកាន់ ធី ម៉ូថេ ដែល ជា គ្រូ គង្វាល នៃ ក្រុម ជំនុំ នៅ ក្រុង អេភេសូរ គាត់ បាន ប្រាប់ ធី ម៉ូថេ ថា ព្រះគម្ពីរ នឹង « បំពាក់ គាត់ សម្រាប់ គ្រប់ កិច្ចការ ល្អ » ។
បង្ហាញ គាត់ ពី អ្វី ដែល វា និយាយ អំពី
សប្បាយ ចិត្តដូចពេលដែលគេគ្មានអ្វីត្រូវការពារ
គាត់ នៅក្នុង គណបក្ស សាធារណរដ្ឋ ។
យើងជាច្រើននាក់បានមានឱកាសជួបជាមួយប្រធាន
រីករាយ រាត្រី ជួបជុំ គ្រួសារ នៅ ផ្ទះ ។
តាមពិតទៅ បើគ្មានការ សប្បាយ ចិត្តពីគេទេ នោះនឹងគ្មានទាសភាពឡើយ ។
វា នឹង មិន លាតត្រដាង ការពិត ហើយក៏ មិន លាក់ វា ដែរ ។
ពររបស់អើរ៉ុនបានប្រទានដល់ម៉ូសេ ដោយព្រះ។
ដំណើរកម្សាន្ត ពេញ មួយ ឆ្នាំ ប្រសិនបើ អ្នក រមាស់ ដើម្បី ទទួលបាន
គាត់ បាន មក ដើម្បី នាំ មនុស្ស ទាំងអស់ ទៅ ព្រះ។
វាសរសេរថា៖ « ខ្ញុំខំចាប់ដៃដែលព្រះ គ្រីស្ទយេស៊ូវបានចាប់ខ្ញុំ » ។
ត្រូវបានគេមានអារម្មណ៍ថាជាមួយ និងពិសិដ្ឋ ។
“ ខ្ញុំបានឃើញពេលយប់ ហើយមើលឃើញបុរសម្នាក់អង្គុយលើសេះមួយ ហើយគាត់ឈរនៅកណ្តាលភ្នំដែលមានស្រមោល ។
ហើយ អ្នក បាន ឃើញ ភាពរុងរឿង របស់ យើង ។
អារក្សមិនស្តាប់បង្គាប់ ឬស្តាប់តាមព្រះបន្ទូលទេ ។
ឪពុក ម្តាយ របស់ អ្នក គឺជា អំណោយ ពី ព្រះដល់ អ្នក ដើម្បី ដឹកនាំ អ្នក ការពារ អ្នក និង មើល ថែ អ្នក ។
ដូច្នេះ ចូរយកវាយឺត ឬលឿន ប៉ុន្តែត្រូវដឹងថាអ្នកចង់បានអ្វី ហើយប្រយ័ត្ននូវអ្វីដែលគេនិយាយថាគេចង់បាន ។
ក្នុង ករណី នេះ ផ្លាស់ប្តូរ ការពិនិត្យ ឡើងវិញ នៃ ថ្នាក់ ។
ឬ ផ្តល់ ជូន ដើម្បី ចែករំលែក ជាមួយ អ្នក នូវ ឆ័ត្រ របស់ អ្នក ដោយ ប្រើ ស្ត្រី នៅពេល ភ្លៀង ធ្លាក់ ។
កំពុង ស្វែងរក កន្លែង ល្អ បំផុត ចុងក្រោយ ?
យើង ផ្តល់ សេវាកម្ម នៅ សហរដ្ឋ អាមេរិក ទាំងមូល
ហ្វូងគោដែលកើតឡើង បន្ទាប់ពីកាត់រួច ។
អ្វី ដែល បាន ក្លាយជា គ្រួសារ របស់ គាត់ ។
មកពី អ្នកទន្ទឹងរង់ចាំ រង្វាន់ មែន ទេ ?
ព្រះ យេស៊ូគង់នៅ ជាមួយនឹងកុមារគ្រប់ពេល ។ "
មិន មាន កន្លែង សម្រាប់ ខ្ញុំ នៅក្នុង ខ្លួន របស់ ខ្ញុំ ទេ ។
អ្នក នឹង ឃើញ ការបំផ្លិចបំផ្លាញ របស់ មនុស្ស អាក្រក់ ។
ហើយខ្ញុំដឹងថាអ្វីជាសារធាតុសម្ងាត់របស់ពួកគេ » ។
ក្នុង ចិត្តអ្នក សូត្រថា “ អ្នកជាទេវៈ ។
« យករបស់ទាំងអស់ដែល ជារបស់នាង និងប្រាក់ចំណូលពីស្រែមកវិញ ចាប់តាំងពីថ្ងៃដែលនាងចាកចេញពីស្រុករហូតដល់ឥឡូវ » ។
វាហាក់ដូចជារហូតមកដល់ពេលនេះត្រូវបានគេប្រើតិចណាស់។
ពិតជាមិនអាចកំពូលវានៅក្នុងឆ្នាំ បន្ទាប់។
« តើអ្នក និយាយពាក្យទៅអ្នក ណា ហើយវិញ្ញាណរបស់អ្នក ណាមកពីអ្នក ? » ។
សូម មើល ខ្ញុំ បាន ប្រាប់ អ្នក មុនពេល វេលា ។
