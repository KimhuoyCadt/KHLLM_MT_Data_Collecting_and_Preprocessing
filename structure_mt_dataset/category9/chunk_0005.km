តើ វា រួមបញ្ចូល ទាំង ការធានារ៉ាប់រង ដែរ ទេ ?
តើ ខ្ញុំ ត្រូវ ដំឡើង ពួកគេ នៅក្នុង ប្រទេស ជប៉ុន មែន ទេ ?
តើ វា ចំណាយ ពេល ប៉ុន្មាន ថ្ងៃ ក្នុង ការផ្ញើ វា ទៅកាន់ ប្រទេស ជប៉ុន ?
តើ ខ្ញុំ អាច កំណត់ កាលបរិច្ឆេទ ទទួលបាន បាន ទេ ?
តើ អ្នក ព្រម ទទួលយក ការបញ្ជាទិញ ពី ប្រទេស ជប៉ុន ដែរ ទេ ?
តើ អ្នក មាន កាតាឡុក សម្រាប់ ការបញ្ជាទិញ តាម សំបុត្រ ដែរ ទេ ?
តើ វា ចំណាយ ពេល ប៉ុន្មាន ថ្ងៃ ក្នុង ការផ្ញើ ពួកវា ទៅកាន់ ប្រទេស ជប៉ុន ?
វា នៅ ខាងឆ្វេង របស់ អ្នក នៅលើ ផ្នែក ម្ខាង ទៀត នៃ ផ្លូវ ។
វា នៅ ពីក្រោយ អ្នក ។
តើ អាសយដ្ឋាន នេះ នៅក្បែរ ទីនេះ ?
នៅលើ ផ្នែក ម្ខាង ទៀត ចុះ ពី ផ្លូវ បន្តិច នៃ ស្ថានីយ ប្រេងឥន្ធនៈ ។
បត់ ស្តាំ នៅឯ ស្ថានីយ ប្រេងឥន្ធនៈ ហើយ បន្ទាប់មក បត់ ឆ្វេង នៅ ចុង ផ្លូវ ។ វា ជា អគារ ទី បី ពី កាច់ជ្រុង ។
ខ្ញុំ មាន ការឈឺចាប់ បន្តិច ។
ខ្ញុំ មាន ការឈឺចាប់ ខ្ទោក ៗ ។
ខ្ញុំ មាន ការឈឺចាប់ ជា បន្តបន្ទាប់ ។
ដាក់ ដៃ របស់ អ្នក នៅលើ ក្បាល របស់ អ្នក ។
សំបុត្រ ផ្លូវ អាកាស របស់ ខ្ញុំ ត្រូវបាន គេ លួច ។
ឈឺ ក្បាល ដ៏ គួរឱ្យ ខ្លាច ។
ខ្ញុំ បាន រលាត់ កែង ដៃ របស់ ខ្ញុំ ។
ស្មា របស់ ខ្ញុំ រឹង ។
តើ ខ្ញុំ អាច មាន ថ្នាំ អាស្ពីរីន ណាមួយ ដោយ គ្មាន វេជ្ជបញ្ជា បាន ទេ ?
លេប ថ្នាំ នេះ ប្រាំមួយ ម៉ោង ម្តង រហូតដល់ បី ដង ក្នុង មួយ ថ្ងៃ ។
តើ អ្នក អាច ពិនិត្យ ឡើងវិញ នូវ វិក្កយបត្រ ដែល អ្នក បាន ផ្ញើ មក ឱ្យ ខ្ញុំ ដោយសារ វា ហាក់ដូចជា មិន ត្រឹមត្រូវ ។
ខ្ញុំ បាន រកឃើញ ថា ទំនិញ ដែល អ្នក បាន ផ្ញើ ឱ្យ ខ្ញុំ ត្រូវបាន រង ការខូចខាត ។ ខ្ញុំ នឹង ស្នើ ឱ្យ អ្នក ផ្ញើ ម៉ាក ថ្មី មួយ ឱ្យ ខ្ញុំ ។
ខ្ញុំ ចង់ ប្រគល់ ទំនិញ ត្រឡប់ វិញ ។ តើ អ្នក នឹង ប្រាប់ ខ្ញុំ ពី នីតិវិធី នៃ ការប្រគល់ ត្រឡប់ ទំនិញ វិញ និង ទទួលបាន ប្រាក់ សង វិញ បាន ទេ ។
ខ្ញុំ សូម មាន សំណួរ មួយ ។
សូម ជួយ ខ្ញុំ បន្តិច ។
ខ្ញុំ ត្រូវការ សេវាកម្ម របស់ អ្នក ។
ទូរស័ព្ទ ទៅ ប៉ូលីស ។
ទូរស័ព្ទ ទៅ អ្នកទទួលខុសត្រូវ ។
តើ ជើងហោះហើរ នេះ នឹង ចេញដំណើរ តាម កាលវិភាគ ដែរ ទេ ?
តើ ទំហំ អតិបរមា ប៉ុណ្ណា សម្រាប់ ការយួរ តាម ខ្លួន ?
មិន មាន អ្វី គ្រោះថ្នាក់ ឬ ងាយ បែក នៅក្នុង វា ទេ ។
ខ្ញុំ មាន កាបូប តែ មួយ ប៉ុណ្ណោះ ។
តើ ពន្ធ ព្រលានយន្តហោះ សម្រាប់ មនុស្ស ពីរ នាក់ មាន តំលៃ ប៉ុន្មាន ?
នេះ គឺជា សំបុត្រ យន្តហោះ និង លិខិត ឆ្លង ដែន របស់ ខ្ញុំ ។
បើ អាច ទៅ រួច ខ្ញុំ ចង់បាន កៅអី ដែល នៅជិត ច្រក ចេញ ដូច្នេះ ខ្ញុំ អាច សណ្តូក ជើង របស់ ខ្ញុំ បាន ។
សូម បន្ថែម ពិន្ទុ ទៅ លើ ប័ណ្ណ ចម្ងាយ របស់ ខ្ញុំ ។
ពួកយើង ចង់បាន កៅអី ដែល នៅជាប់ គ្នា ។
ខ្ញុំ សូម កៅអី ដែល នៅជាប់ បង្អួច ។
តើ ក្រុមហ៊ុន បាន បូករួម ទាំង ការចំណាយ លើ ការស្នាក់ នៅ សណ្ឋាគារ ដែរ ទេ ?
ខ្ញុំ មិន ទាន់ ទទួលបាន ផ្លាក សម្រាប់ បិទ ឥវ៉ាន់ របស់ ខ្ញុំ នៅឡើយ ទេ ។
ខ្ញុំ មាន វីសា ជំនួញ ។
តើ ខ្ញុំ ត្រូវការវីសា សម្រាប់ បើកបរ ទៅកាន់ ប្រទេស ម៉ិចស៊ិក ដែរ ទេ ?
ខ្ញុំ ស្នាក់ នៅ រយៈពេល ប្រាំមួយ ថ្ងៃ ។
តើ យើង អាច ឆ្លងកាត់ កន្លែង អន្តោប្រវេសន៍ ជាមួយគ្នា បាន ទេ ដោយសារ រៀបការ ហើយ ?
តើ ខ្ញុំ អាច ទុក អាសយដ្ឋាន កន្លែង ស្នាក់ នៅ ទំនេរ បាន ទេ ពីព្រោះ ខ្ញុំ មិន ទាន់ បាន កក់ សណ្ឋាគារ មួយ នៅឡើយ ទេ ?
រូបថត នេះ គឺ ពិតជា រូប របស់ ខ្ញុំ ។ វា គ្រាន់តែ ចាស់ ខ្លាំង ។
លិខិត ឆ្លង ដែន របស់ ខ្ញុំ នឹង ផុត កំណត់ ក្នុង រយៈពេល ពីរ អាទិត្យ ទៀត ។
ចាប់ពី ថ្លៃ ប៉ុន្មាន ដែល ខ្ញុំ ត្រូវតែ ប្រកាស អះអាង ?
តើ វា ថ្លៃ ប៉ុន្មាន ក្នុង ការប្រើ បញ្ជ ឥវ៉ាន់ ?
សូម ទូរស័ព្ទ មកកាន់ ទីនេះ ភ្លាម ៗ នៅ ពេល ដែល ឥវ៉ាន់ ត្រូវបាន រកឃើញ ។
ខ្ញុំ មិន បាន ដឹង របស់ នេះ ត្រូវបាន ហាមឃាត់ នោះ ទេ ។
កង់ វ៉ាលី របស់ ខ្ញុំ ត្រូវបាន ខូច ។
ខ្ញុំ ចង់ ប្ដូរ ប្រាក់ បី ម៉ឺន យ៉េន ទៅជា ដុល្លារ ។
តើ អត្រា ប្រាក់ យ៉េន ថ្ងៃ នេះ ប៉ុន្មាន ?
ខ្ញុំ ចង់ ប្រើប្រាស់ សែក អ្នកដំណើរ ។
តើ អ្នក ស្គាល់ កន្លែង ប្ដូរ ប្រាក់ ដែល នៅជិត នេះ ដែល ផ្តល់ អត្រា ប្រាក់ ខ្ពស់ ដែរ ទេ ?
តើ វា មាន ភាពខុសគ្នា ដូចម្តេច រវាង សែក អ្នកដំណើរ និង សាច់ប្រាក់ ?
ការបញ្ជាក់ នៃ គណនី នេះ គឺ ខុស ។
តើ ដើម្បី ជិះ ទៅកាន់ ទីក្រុង ដោយ តាក់ស៊ី អស់ តម្លៃ ប៉ុន្មាន ?
តើ ម៉ោង ប៉ុន្មាន ទើប រថភ្លើង ចេញ ទៅកាន់ កណ្តាល ក្រុង ?
តើ ខ្ញុំ អាច ទិញ សំបុត្រ ឡានក្រុង រហ័ស នៅ កន្លែងណា ?
តើ ខ្ញុំ ត្រូវ ធ្វើ ការកក់ សម្រាប់ ឡានក្រុង រហ័ស ដែរ ទេ ?
តើ រថភ្លើង ទៅកាន់ ទីក្រុង ចេញដំណើរ ពី កន្លែងណា ?
តើ វិធី ណា ដើម្បី ទៅកាន់ ទីក្រុង ក្នុង តម្លៃ ថោក បំផុត ?
ខ្ញុំ ចង់ ជួល ទូរស័ព្ទ ដៃ ជាមួយនិង ឡាន ។
ខ្ញុំ គិត ថា អ្នក គួរតែ ប្រើ ម៉ែត្រ វាស់ ។
ខ្ញុំ មិន ត្រូវការ អ្នកកាន់ ឥវ៉ាន់ ទេ ។ ខ្ញុំ អាច កាន់ វា ដោយ ខ្លួន ឯង ។
តើ សីតុណ្ហភាព នៅ កន្លែង ដែល ខ្ញុំ ត្រូវ ទៅ ប៉ុន្មាន ?
តើ ខ្ញុំ អាច បញ្ជា ម៉ាស៊ីន ត្រជាក់ នេះ បាន យ៉ាងដូចម្តេច ?
តើ ក្រដាស កាតុង បារី ចំនួន ប៉ុន្មាន ខ្ញុំ អាច ទិញ នៅ ប្រទេស អូស្ត្រាលី ?
តើ ខ្ញុំ ត្រូវ ដាក់ពាក្យ សុំ សមាជិកភាព ចម្ងាយ ដោយ របៀប ណា ?
អ្នក មិន ចាំបាច់ ដាស់ ខ្ញុំ សម្រាប់ អាហារ ឡើយ ។
ហេតុ អ្វី មាន ការពន្យា ពេល ការហោះហើរ ឡើង ?
ទូរស័ព្ទ នេះ ខូច ។
នរណា ម្នាក់ ផ្សេង កំពុង អង្គុយ កន្លែង ខ្ញុំ ។
អាវ ពោង សុវត្ថិភាព របស់ អ្នក ស្ថិត នៅក្រោម កន្លែង អង្គុយ របស់ អ្នក ។
ឡាវ៉ាបូ នេះ ត្រូវបាន ប្រើ រយៈពេល មួយចំនួន ។
ខ្ញុំ បាន បម្រើ អាហារ អ្នកបួស ។
ខ្ញុំ គិត ថា កន្លែង អង្គុយ នេះ ជា របស់ ខ្ញុំ ។
អត់ទោស សុំ ម្តង ទៀត ។
សុំ អភ័យទោស ខ្ញុំ កំពុង រំខាន អ្នក ។
តើ ខ្ញុំ អាច ប្រគល់ ឡាន ត្រឡប់ នៅ ព្រលានយន្តហោះ បាន ទេ ?
តើ លេខ មួយ ណា ខ្ញុំ អាច ទូរស័ព្ទ ទៅក្នុង ករណី បន្ទាន់ ?
ខ្ញុំ ចង់បាន ការលើកលែង ពន្ធ លើ ការខូចខាត បាត់បង់ ។
ខ្ញុំ មាន ការកក់ សម្រាប់ ឡាន ថ្ងៃ នេះ ។
ខ្ញុំ នឹង សូម យក ថ្នាក់ ស្តង់ដារ ។
តើ មាន ការគ្របដណ្តប់ លើ ធានារ៉ាប់រង នេះ ដែរ ទេ ?
មាន អ្នកបើកបរបន្ថែម ម្នាក់ ។
ខ្ញុំ ចង់បាន លេខ អូតូ ។
ខ្ញុំ បាន ដាក់ លុយ ចូល ប៉ុន្តែ នាឡិកា បាន ខូច ។
ខ្ញុំ មិន បាន ធ្វើឱ្យ មាន ស្នាម ក្វាច នោះ ទេ ។
ម៉ាស៊ីន របស់ ខ្ញុំ រលត់ ។
អត់ទោស ខ្ញុំ កំពុង ឆ្លងកាត់ ពី ក្រោយ អ្នក ។
ខ្ញុំ មិន មាន លុយ អាប់ គ្រប់គ្រាន់ ទេ ។
ខ្ញុំ គិត ថា ខ្ញុំ បាន ខកខាន ចំណត របស់ ខ្ញុំ ។
ខ្ញុំ បាន និង កំពុង រង់ចាំ ទីនេះ អស់ រយៈពេល មួយ ស្របក់ ។
សូម យក សំបុត្រ ធ្វើដំណើរ មួយ ជុំ ឱ្យ ខ្ញុំ ។
ខ្ញុំ ចង់ ជិះ រថភ្លើង លឿន ។
ខ្ញុំ ទាយ ថា ខ្ញុំ នៅលើ រថភ្លើង ខុស ហើយ ។
តើ អស់ ថ្លៃ ប៉ុន្មាន ទៅកាន់ ស្ថានីយ ផ្លូវ រថភ្លើង ?
តើ អាជីវកម្ម របស់ អ្នក ដូចម្តេច ដែរ ប៉ុន្មាន ថ្ងៃ នេះ ?
យើង ជាប់គាំង ក្នុង ការស្ទះ ចរាចរណ៍ ។
បត់ ឆ្វេង នៅ កាច់ជ្រុង បន្ទាប់ ។
ខ្ញុំ នឹង ប្រាប់ ផ្លូវ ដល់ អ្នក ។
សូម ទៅកាន់ ព្រលានយន្តហោះ បន្ទប់ រង់ចាំ ចេញដំណើរ ។
ខ្ញុំ ត្រូវតែ ទៅ ឱ្យ ទាន់ យន្តហោះ ។
ខ្ញុំ កំពុងតែ យឺត ទាល់តែ មែនទែន ហើយ សម្រាប់ ការណាត់ជួបគ្នា លើក ដំបូង របស់ ខ្ញុំ ជាមួយ នារី នេះ ។
បត់ ឆ្វេង នៅ ផ្លាក សញ្ញា ឈប់ បន្ទាប់ ។
តើ សណ្ឋាគារ នៅជិត ឆ្នេរសមុទ្រ ប៉ុណ្ណោះ ?
តើ មាន អត្រា តម្លៃ ពិសេស ដែរ ទេ សម្រាប់ ការស្នាក់ នៅ រយៈពេល យូរ ?
ខ្ញុំ គ្រាន់តែ ចង់ សម្រាក លំហែ នៅ ឆ្នេរសមុទ្រ ។
អាទិភាព ទី មួយ គឺ ការដើរ ទិញ ទំនិញ ។
ខ្ញុំ ចង់បាន បន្ទប់ មាន គ្រែ ពីរ នៅ ថ្ងៃទី មួយ ខែមេសា ។
ខ្ញុំ ចង់បាន បន្ទប់ មាន មហាសមុទ្រ នៅ ចំ ពីមុខ ។
ខ្ញុំ ចង់បាន បន្ទប់ តម្លៃ ទាប ជាង ពីរ រយ ដុល្លារ ក្នុង មួយ យប់ ។
ខ្ញុំ សូម យក បន្ទប់ គ្មាន ផ្សែង បារី ។
ខ្ញុំ បាន ធ្វើ ការកក់ នៅក្នុង ប្រទេស ជប៉ុន ?
ខ្ញុំ ចង់ ឃើញ បន្ទប់ ល្អ បំផុត នៅ ទំនេរ ក្នុង ជួរ តម្លៃ ដូចគ្នា ។
នេះ គឺជា លេខ បញ្ជាក់ របស់ ខ្ញុំ ។
តើ ខ្ញុំ ទទួលបាន ពិន្ទុ ចំពោះ ប័ណ្ណ រយៈ ចម្ងាយ របស់ ខ្ញុំ ដែរ ទេ ?
ខ្ញុំ ប្រាកដ ណាស់ ថា ការកក់ របស់ ខ្ញុំ គឺ សម្រាប់ ថ្ងៃ នេះ ។
ខ្ញុំ បាន ធ្វើ ការកក់ លុយ ហើយ ។
ខ្ញុំ បាន រីករាយ នឹង ការស្នាក់នៅ របស់ ខ្ញុំ សូម អរគុណ ។
តើ អ្នក អាច រក្សាទុក ឥវ៉ាន់ របស់ ខ្ញុំ រហូតដល់ ម៉ោង ប្រាំមួយ ល្ងាច បាន ទេ ?
តើ ខ្ញុំ អាច មាន វិក្កយបត្រ របស់ ខ្ញុំ នៅ យប់ នេះ ដោយសារតែ ខ្ញុំ នឹង ចាកចេញ នៅ ព្រឹក ព្រហាម ថ្ងៃស្អែក ?
ខ្ញុំ បាន បង់ ថ្លៃ សម្រាប់ វា រួចហើយ ។
ខ្ញុំ មិន ហាក់ដូចជា ទទួលស្គាល់ ការគិត ថ្លៃ នេះ ទេ ។
ថ្លៃ សរុប នេះ មិន ត្រឹមត្រូវ ទេ ។
ខ្ញុំ កំពុង រង់ចាំ ការហៅទូរស័ព្ទ ។ សូម ធ្វើ ការផ្ញើ សារ ។
ខ្ញុំ ចង់ ចេញដំណើរ មួយ ថ្ងៃ មុន ។
បន្ទប់ របស់ ខ្ញុំ ត្រូវបាន ចោរប្លន់ ខណៈពេល ខ្ញុំ នៅ ក្រៅ ។
ខ្ញុំ ខ្លាចតែ ខ្ញុំ វង្វេង បាត់ សោ បន្ទប់ ហើយ ។
តើ ក្លឹប មួយ ណា មាន ប្រជាប្រិយ សម្រាប់ អ្នក នៅក្នុង តំបន់ ?
តើ ភោជនីយដ្ឋាន មយយ អ្នក អាចនឹង ទៅ សម្រាប់ ការណាត់ជួប គូស្នេហ៍ ?
តើ ម៉ោង សម្រាប់ អាង ហែលទឹក គឺ ប៉ុន្មាន ?
ខ្ញុំ ត្រូវការវា ធ្វើឱ្យ រួច ត្រឹម ថ្ងៃស្អែក ។
ខ្ញុំ ចង់បាន អាហារ ពេលព្រឹក នៅ ម៉ោង ប្រាំបី ក្នុង បន្ទប់ របស់ ខ្ញុំ ។
ខ្ញុំ ចង់ ផ្ញើ អ៊ីម៉ែល មួយចំនួន ។
តើ មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម នៅ ឯណា ?
មាន បុរស ម្នាក់ នៅ ក្រៅ បន្ទប់ របស់ ខ្ញុំ កំពុង ធ្វើ សកម្មភាព ប្លែក ៗ ។
ខ្ញុំ ត្រូវបាន គេ ជួយ ហើយ អរគុណ ។
ខ្ញុំ ចង់បាន បង្កាន់ដៃ បង់ប្រាក់ ។
វា គឺជា ការតថ្លៃ ពិតប្រាកដ ។
ប្រសិនបើ អ្នក ត្រូវការ ជំនួយ ណាមួយ សូម សួរ ខ្ញុំ ។
តើ ខ្ញុំ អាច យក សំបុត្រ ចំណត របស់ ខ្ញុំ ផ្ទៀងផ្ទាត់ បាន ទេ ?
ខ្ញុំ ចង់ ទទួលបាន អ្វី មួយ ដែល ខ្ញុំ អាច គ្រាន់តែ ទិញ នៅ ទីនេះ បាន ហើយ ។
តើ ខ្ញុំ អាច ពិនិត្យមើល ខាងក្នុង ម្តង ទៀត បាន ទេ មុនពេល អ្នក ខ្ចប់ វា ?
ខ្ញុំ គិត ថា ខ្ញុំ ទទួលបាន ការបញ្ចុះ តម្លៃ ម្ភៃ ភាគរយ ពី ចំនួន ទឹកប្រាក់ នេះ ។
ខ្ញុំ ចង់ ប្រគល់ ត្រឡប់ វា និង យក ប្រាក់ ត្រឡប់ វិញ ។
តើ ខ្ញុំ ទទួលបាន ការបញ្ចុះ តម្លៃ សាមសិប ភាគរយៈ ពី ស្លាក នេះ ទេ ?
តម្លៃ នេះ បញ្ចុះ រួចហើយ ។
សូម លុបចោល ស្លាក គិត ថ្លៃ ។
ខ្ញុំ ទើបតែ ទិញ អាវ នេះ ប៉ុន្តែ ខ្ញុំ រកឃើញ ថា មាន ស្នាម ប្រឡាក់ នៅ ទីនេះ ។
ដៃ អាវ គឺ វែង បន្តិច សម្រាប់ ខ្ញុំ ។
ខ្ញុំ កំពុង ស្វែងរក កាបូប ដែល មាន ខ្សែ ស្ពាយ អាច សរ៉េ បាន ។
ខ្ញុំ កំពុង រកមើល កាបូប ក្រវ៉ាត់ ចង្កេះ ដើម្បី ប្រើ ខណៈពេល ខ្ញុំ នៅ ទីនេះ ។
ខ្ញុំ កំពុង ស្វែងរក កាបូប ស្ពាយ ដែល មាន ហោប៉ាវ សម្រាប់ ទូរស័ព្ទ ដៃ ។
ខ្ញុំ ចង់បាន កាបូប ដែល ធ្វើ ពី សរសៃ អំបោះ រឹង ។
ខ្សែ រ៉ូត ខូច ។
នេះ គឺ ចង្អៀត បន្តិច ហើយ សម្រាប់ ខ្ញុំ ។
ប្រអប់ ជើង របស់ ខ្ញុំ មាន ខ្នង ជើង ខ្ពស់ ។
តើ ម្ភៃ ប្រាំមួយ សង់ទីម៉ែត្រ ស្មើ ប៉ុន្មាន ជា អ៊ីញ ?
មួយ គូ នេះ គឺ ស្ទើរតែ ឥត ខ្ចោះ លើកលែងតែ កន្លាស់ នេះ ។
តើ ខ្ញុំ អាច ភ្លក់ សាឡាត់ អាល្លឺម៉ង់ បាន ទេ ?
ខ្ញុំ កំពុង ស្វែងរក ស្រា ត្រាំ ពេញ ដែល មាន តម្លៃ សមរម្យ ។
តើ ខ្ញុំ ត្រូវការ ឆ្នាំងសាក សម្រាប់ ការប្រើ ចង្កៀង នេះ នៅ ប្រទេស ជប៉ុន ដែរ ទេ ?
ខ្ញុំ កំពុង ស្វែងរក ទៀន ក្រអូប ។
តើ ខ្ញុំ អាច ផ្ញើ សំបុត្រ នូវ ការ បញ្ជាទិញ គ្រឿង សង្ហារឹម នេះ នៅ ប្រទេស ជប៉ុន បាន ផងដែរ ?
តើ អ្នក មាន ចាន សម្រាប់ ប្រើប្រាស់ ជាមួយ ម៉ាស៊ីន ដុត ដែរ ទេ ?
ខ្ញុំ មិន បាន សម្គាល់ នៅពេល ខ្ញុំ បាន ទិញ របស់ នេះ ប៉ុន្តែ វា មាន ស្នាម ប្រេះ នៅ ទីនេះ ។
ពណ៌ នេះ ប្រហែល ត្រូវ គ្នា ជាមួយ ពណ៌ ចម្រុះ នៃ បន្ទប់ របស់ ខ្ញុំ ។
ខ្ញុំ កំពុង ស្វែងរក នាឡិកា អ្នកបើកបរ ?
ខ្ញុំ កំពុង ស្វែងរក នាឡិកា ដែល ធន់ នឹង ការអគ្គិសនី ឆក់ ។
ខ្ញុំ កំពុង រកមើល ការវ៉ែន ការពារ ពន្លឺ ព្រះអាទិត្យ មួយ គូរ ដែល សម នឹង មុខ របស់ ខ្ញុំ ។
ខ្ញុំ ចង់បាន វ៉ែនតា ដែល គ្មាន ស៊ុម ។
តើ អ្នក អាច ប្ដូរ ក្រវិល ទាំងនេះ ជាមួយ អាកិប ?
មើល ទៅ សាកសម នឹង អ្នកណាស់ ។
វា មើល ទៅ ស្រស់ស្អាត ជាមួយនិង សំលៀកបំពាក់ របស់ អ្នក ។
តើ វីតាមីន ណា មួយ មាន ប្រសិទ្ឋភាព ព្យាបាល ភាព តប់ប្រមល់ ?
ខ្ញុំ កំពុង ស្វែងរក ទឹក ក្រឡុក មាន ជាតិ ប្រូតេអ៊ីន ។
ខ្ញុំ ត្រូវការ ថ្នាំ ងងុយ គេង ដែល មិន មាន ឥទ្ឋិពល ខ្លាំង ។
តើ របប អាហារ ប្រភេទ ណាល មាន ប្រសិទ្ធភាព បំផុត ?
ខ្ញុំ ចង់បាន ផលិតផល ដែល ជួយ បង្កើន ភាព រំលាយ អាហារ ក្នុង រាងកាយ ។
ខ្ញុំ ចង់បាន ប្រេង លាប ស្បែក សម្រាប់ ស្បែក រមាស់ ។
ស្បែក របស់ ខ្ញុំ គឺ ស្ងួត និង ស្តើង ។
ស្បែក របស់ ខ្ញុំ គឺ ងាយ រង ប្រតិកម្ម ណាស់ ។
ខ្ញុំ ចង់បាន ថ្នាំ ទ្រវែង មិន មែន គ្រាប់ តូច ទេ ។
ខ្ញុំ ចង់បាន ថ្នាំ ត្រជាក់ ដែល រលាយ ក្នុង ទឹក ។
សារជាតិ កាហ្វេអ៊ីន ធ្វើឱ្យ ខ្ញុំ ឈឺ តែ ខ្ញុំ នៅតែ ចង់ ផឹក កាហ្វេ ។
ខ្ញុំ ចង់បាន ថ្នាំ គ្រាប់ ។
ខ្ញុំ ត្រូវការ ប្រភេទ ដាក់ ក្នុង ទឹក ។
ខ្ញុំ ចង់បាន ខ្សែ សម្រាប់ សំអាត ធ្មេញ ដែល មាន ក្រមួន ។
ខ្ញុំ បាន ទិញ ថ្នាំ ប្រភេទ នេះ តែ វា អត់ មាន ប្រសិទ្ឋភាព សម្រាប់ ខ្ញុំ ។
តើ ផលិតផល របប អាហារ មួយ ណា ជួយ កាត់បន្ថយ ការឃ្លាន អាហារ ?
តើ វីតាមីន ប៉ុន្មាន ប្រភេទ មាន នៅក្នុង អាហារ បន្ថែម នេះ ?
ខ្ញុំ ប្រាកដ នេះ មកពី រដូវកាល មុន ។
ចុះ បើ កាត់បន្ថយ ថ្លៃ វា ត្រឹម មួយ ម្ភៃ ដុល្លារ យ៉ាងម៉េច ដែរ ?
យល់ព្រម ខ្ញុំ នឹង អោយ អ្នកម្ភៃ ប្រាំ ដុល្លារ ។
ខ្ញុំ បាន និយាយ ថា ម្ភៃ ដុល្លារ ។
