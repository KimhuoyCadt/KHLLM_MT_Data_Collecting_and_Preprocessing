( កំពង់ចាម ) ៖ លោក បណ្ឌិត ម៉ា ឈឿន តំណាងរាស្ដ្រ មណ្ឌល កំពង់ចាម សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក ជើង ព្រៃ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន គូសបញ្ជាក់ ថា គណបក្ស ប្រជាជន កម្ពុជា ចង់ កាន់អំណាច បន្ដ ទៅ ទៀត តាមរយៈ ការបោះឆ្នោត ពី ប្រជាពលរដ្ឋ ខុសគ្នា ស្រឡះ ពី គណបក្ស ប្រឆាំង ចង់ កាន់អំណាច តាមរយៈ បដិវត្ដន៍ ពណ៌ ។
ការគូសបញ្ជាក់ យ៉ាង ដូច្នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក បណ្ឌិត ម៉ា ឈឿន អញ្ជើញ ចូលរួម ក្នុង ពិធី ឃោសនា បោះឆ្នោត ជ្រើសរើស តំណាងរាស្ដ្រ នីតិកាល ទី៦ ស្រុក ជើង ព្រៃ ខេត្ដ កំពង់ចាម ដែល មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ មកពី ភូមិ ទ ទោល ឃុំ គោក រ វៀង ស្រុក ជើង ព្រៃ សរុប ជាង ៥០០ នាក់ នា ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
ថ្លែង នៅក្នុង ពិធី នោះ តំណាងរាស្ដ្រ មណ្ឌល កំពង់ចាម បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « គណបក្ស ប្រជាជន កម្ពុជា ចង់បាន កាន់អំណាច បន្ដ ទៅ ទៀត តាមរយៈ ការបោះឆ្នោត បើ ប្រជាជន ស្រលាញ ជាប់ ឆ្នោត កាន់អំណាច តទៅទៀត បើ ប្រជាជន មិន ស្រលាញ់ លែង បោះឆ្នោត ជូន គឺ ឈប់ កាន់អំណាច នេះ តាមរយៈ ការបោះឆ្នោត តាមរយៈ សម្លេង តាមរយៈ សេចក្ដីសម្រេច របស់ ប្រជាជន » ។
លោក បណ្ឌិត ម៉ា ឈឿន បាន បញ្ជាក់ ទៀត ថា វា ខុសគ្នា ស្រឡះ ដូច មេឃ និង ដី ជាមួយនឹង គណបក្ស ប្រឆាំង ដែល ចង់ កាន់អំណាច តាមរយៈ បដិវត្ដន៍ ពណ៌ ដែល មាន បរទេស នៅ ពីក្រោយ ខ្នង ។ លោក បន្ដ ថា គណបក្ស ប្រជាជន កម្ពុជា គឺ ដើរ លើ ផ្លូវ បោះឆ្នោត ដែល គេ ហៅ ថា ជា លទ្ធិ ប្រជាធិបតេយ្យ ការបោះឆ្នោត ទៀងទាត់ ក្នុង រយៈពេល ៥ឆ្នាំ ម្ដង ដើម្បី កាន់អំណាច បាន ត្រូវ ធ្វើ តាមរយៈ ការបោះឆ្នោត ពី ប្រជាពលរដ្ឋ ។
ជាមួយគ្នា នោះ លោក ក៏ បាន លើកឡើង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន រំដោះ ប្រទេសជាតិ ឲ្យ រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង បាន កសាង ស្នាដៃ ជូន ប្រទេស កម្ពុជា រួម មាន៖ នាំមក នូវ សន្ដិភាព ជូន ប្រជាជន និង ប្រទេសជាតិ ( ការបង្រួបបង្រួម ជាតិ ឯកភាព ជាតិ និង លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ) ។
លោក បណ្ឌិត ម៉ា ឈឿន បាន បន្ថែម ទៀត ថា នេះ ដោយសារតែ ការឆ្លៀស វៃ របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ គោល នយោបាយ ឈ្នះ ឈ្នះ ដែល ធ្វើឲ្យ ប៉ុល ពត រំលាយ ខ្លួន រំលាយ ទាំង អង្គការ ចាត់តាំង រំលាយ ទាំង កង យោធា និង អង្គការ នយោបាយ ព្រមទាំង ចូលរួម ជាមួយនឹង គណបក្ស ប្រជាជន កម្ពុជា ក្រោម គោល នយោបាយ ឈ្នះ ឈ្នះ នា ឆ្នាំ ១៩៩៨ ។
តំណាងរាស្ដ្រ មណ្ឌល កំពង់ចាម រូប នេះ បាន គូសបញ្ជាក់ ថា បើ គ្មាន គោល នយោបាយ ឈ្នះ ឈ្នះ របស់ គណបក្ស ប្រជាជន កម្ពុជា ជាពិសេស ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នោះ ទេ ក៏ គ្មាន សន្ដិភាព រហូតដល់ បច្ចុប្បន្ន ផងដែរ ។
ទន្ទឹម គ្នា នេះ តំណាងរាស្ដ្រ មណ្ឌល កំពង់ចាម ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ សូមអញ្ជើញ ចូលរួម ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ និង បោះឆ្នោត ឲ្យ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខ រៀង ទី២០ និង រូប សញ្ញា « ទេវតា បាច ផ្កា » ដើម្បីឲ្យ សម្ដេច តេជោ ហ៊ុន សែន បន្ដ ដឹកនាំ ប្រទេស កម្ពុជា ផងដែរ ៕ ប្រជាពលរដ្ឋ ឃុំ ពោធិ៍ ទី ខេត្ត ព្រៃវែង ប្ដេជ្ញា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ក្រោយ យល់ ជ្រាប ច្បាស់ ពី គោល នយោបាយ ដឹកនាំ ប្រទេស របស់ សម្ដេច តេជោ ហ៊ុន សែន
( ព្រៃវែង ) ៖ ប្រជាពលរដ្ឋ នៅ ទូទាំង ឃុំ ពោធិ៍ ទី ស្រុក ស៊ីធរ កណ្ដាល ខេត្ត ព្រៃវែង បាន ធ្វើ ការប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ថា ពួកគាត់ នឹង ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដើម្បី ផ្ដល់ ឱកាស ឲ្យ សម្ដេច បន្ដ ធ្វើជា នាយក រដ្ឋមន្ដ្រី ព្រោះ ពួកគាត់ ស្រលាញ់ សន្ដិភាព និង ការអភិវឌ្ឍ ។
ការប្ដេជ្ញាចិត្ត របស់ ប្រជាពលរដ្ឋ នៅ ភូមិ ចំនួន ៦ទូទាំង ឃុំ ពោធិ៍ ទី ស្រុក ស៊ីធរ កណ្ដាល ត្រូវបាន ធ្វើឡើង ក្នុង ឱកាស លោក ហួម តាំង ហឿត ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ពោធិ៍ ទី បន្ដ ចុះ ជួប សំណេះសំណាល និង បង្រៀន ពី របៀប គូស សន្លឹក ឆ្នោត ជា បន្ដ បន្ទាប់ រហូតដល់ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
លើស ពី នេះ លោក ប្រធាន ក្រុមការងារ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ និង សមាជិក - សមាជិកា នាំគ្នា ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ និង ជួយ ជំរុញ ចលនា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន រូប សញ្ញា ទេវតា បាច ផ្កា និង មាន លេខរៀង ទី២០ នៅលើ សន្លឹក ឆ្នោត ដើម្បី ទទួលបាន សម្តេច តេជោ ហ៊ុន សែន ធ្វើជា នាយក រដ្ឋមន្រ្តី សម្រាប់ នីតិកាល ទី៦ និង នីតិកាល បន្តបន្ទាប់ ទៀត ។
គួរ រំលឹក ដែរ ថា ការរក្សា បាន សន្តិភាព និង ស្ថិរភាព នយោបាយ រឹងមាំ គឺជា មូលដ្ឋានគ្រឹះ សម្រាប់ ជំរុញ កំណើន សេដ្ឋកិច្ច ដែល បាន ប្រែក្លាយ កម្ពុជា ពី ប្រទេស ក្រីក្រ មក ជា ប្រទេស មាន ចំណូល ធម្យ ម កម្រិត ទាប កាលពី ឆ្នាំ ២០១៦ ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ក្រសួង ព័ត៌មាន គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ហៅ កាត់ គ.ជ. ប និង ក្លឹប អ្នកការសែនត កម្ពុជា បាន រៀបចំ រៀបចំ កិច្ចពិភាក្សា លើ « តួនាទី អ្នកសារព័ត៌មាន និង ព័ត៌មាន ក្លែង បន្លំ ទាក់ទិន នឹង ដំណើរការបោះឆ្នោត ឆ្នាំ ២០១៨ » ។
ទទ្ទឹម នឹង នេះ លោក ប៉ែន បូណា បាន ថ្លែង ថា ក្នុង នាម ជា អ្នកសារព័ត៌មាន មិន ពិត Fake News មិន ឱ្យ កើតមាន នៅក្នុង សង្គម ខ្មែរ ជាពិសេស ជិត ដល់ ដំណាក់កាល បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី ០៦ ឆ្នាំ ២០១៨ ដែល នឹង ឈាន មកដល់ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ខាងមុខ នេះ អ្នកសារព័ត៌មាន ទាំងអស់ មាន តួនាទី សំខាន់ ចំនួន ៣គឺ៖
របាយការណ៍ បញ្ជាក់ ថា នៅ ឆមាស ទី១ ក្នុង ឆ្នាំ ២០១៨ ដែល គិត ចាប់ពី ខែមករា ដល់ ខែមិថុនា កម្ពុជា បាន ប្រមូល ផល នេសាទ ទឹក សាប ក្នុង រដូវ នេសាទ បាន ចំនួន ២៧. ៦៨០តោន និង ផល នេសាទ សមុទ្រ បាន ៥៩៤០តោន ។ ក្នុង នោះ បាន នាំចេញ ផល នេសាទ ស្រស់ ចំនួន ៥.៣៨០ តោន និង ផល នេសាទ កែច្នៃ បាន ចំនួន ៣.២២០ តោន ។
លទ្ធផល ផ្លូវការ គ.ជ. ប៖ ភ្នាក់ងារ គណបក្ស នយោបាយ ជិត ៨ម៉ឺន នាក់ ត្រូវបាន អនុញ្ញាតឱ្យ ចូលរួម សង្កេតការណ៍ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី០៦ (video) ( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន បង្ហាញ របាយការណ៍ ផ្លូវការ ថា រហូតដល់ ពេលនេះ មាន ភ្នាក់ងារ គណបក្ស នយោបាយ ៧៩៨៤៩ នាក់ ត្រូវបាន គ.ជ. ប អនុញ្ញាតឱ្យ ចូលរួម សង្កេតការណ៍ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី០៦ ។
គណបក្ស ប្រជាជន កម្ពុជា ជា គណបក្ស ដែល ដាក់ ភ្នាក់ងារ សង្កេតការណ៍ ច្រើន ជាង គេ រហូតដល់ ៤៥៩៤៨ នាក់ ចំណែក បន្ទាប់ពី នេះ គឺ គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច ដែល មាន ភ្នាក់ងារ សង្កេតការណ៍ ១៦៧៣៤ នាក់ ហើយ គណបក្ស សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ ដែល ដាក់ ភ្នាក់ងារ សង្កេតការណ៍ ចំនួន ១១៦៣៦ នាក់ ៕
ខាងក្រោម នេះ ជា របាយការណ៍ ផ្លូវការ របស់ គ.ជ. ប៖
លោក កែ គឹម យ៉ាន ប្រាប់ ប្រជាពលរដ្ឋ នៅ ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ឲ្យ ទៅ បោះឆ្នោត បំពេញ កាតព្វកិច្ច ជា ពលរដ្ឋ ល្អ ដើម្បី រក្សា សន្តិភាព និង ការអភិវឌ្ឍ
( បន្ទាយមានជ័យ )៖ លោក កែ គឹម យ៉ាន សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ត បន្ទាយមានជ័យ និង លោកស្រី ម៉ៅ ម៉ាល័យ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ អញ្ជើញ ជា អធិបតី ក្នុង ពី ធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ ផ្លូវ ខេត្ត លេខ ២៥៦៣ ប្រវែង ២២.៣គីឡូម៉ែត្រ ភ្ជាប់ ពី ថ្ម ពួក ផ្លូវ ជាតិ លេខ ៥៦ ទៅដល់ បឹង ត្រកួន ផ្លូវ ជាតិ លេខ ៥៨ ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ក្រោម ហិរញ្ញប្បទាន ពី ធនាគារ អភិវឌ្ឍ អាស៊ី (ADB) ។
ក្នុង ឱកាស នោះ លោក កែ គឹម យ៉ាន បាន បន្ត ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា ប្រជាពលរដ្ឋ ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ដែល មាន អ្នកចូលរួម ចំនួន ៤១០០ នាក់ និង នាំ ការផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ព្រមទាំង ថ្នាក់ដឹកនាំ ផ្សេង ៗ ទៀត ។
លោក កែ គឹម យ៉ាន បាន បន្ថែម ថា កម្ពុជា ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ប្រទេសជាតិ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ប្រែក្លាយ តំបន់ វាយ ប្រយុទ្ធ គ្នា ទៅជា តំបន់ អភិវឌ្ឍ រីកចម្រើន ប្រជាពលរដ្ឋ នៅ រស់ សុខសាន្ត សម្បូរសប្បាយ ជាមួយ សន្តិភាព សន្តិសុខ ពេញ ផ្ទៃ ប្រទេស មាន ផ្លូវ គមនាគមន៍ កាន់តែ សម្បូរ ខ្វាត់ ខ្វែង ពាសពេញ និង ជុំវិញ ប្រទេស ដែល ប្រជាពលរដ្ឋ អាច ធ្វើដំណើរ បាន យ៉ាង ស្រួល ចំណេញ ពេលវេលា ទាំង ការដឹកជញ្ជូន កសិផល និង ដំណើរកម្សាន្ដ ។
ជាមួយគ្នា នេះ លោក កែ គឹម យ៉ាន បាន ថ្លែងអំណរគុណ និង ដឹងគុណ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ នៃ គ្រូសារ អ្នកស្រុក ថ្ម ពួក ដែល បាន ចូលរួម ថែរក្សា គាំទ្រ សន្តិភាព ជាមួយ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ហើយ សូម ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម បំពេញ កាតព្វកិច្ច ជា ពលរដ្ឋ ល្អ អញ្ជើញ ទៅ បោះឆ្នោត ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ជ្រើស យក គណបក្ស ណា ដែល ពេញចិត្ត ដើម្បី ការរីកចម្រើន ក្នុង មូលដ្ឋាន ជាបន្ត ទៀត ៕ ខេមបូឌា អ៊ែរវ៉េ ផ្ដើម ការហោះហើរ អន្ដរជាតិ ជា លើក ដំបូង ពី រាជធានី ភ្នំពេញ ទៅ ទីក្រុង ម៉ាកាវ !
( ភ្នំពេញ ) ៖ ខេមបូឌា អ៊ែរវ៉េ បាន ចាប់ផ្ដើម បើក ជើងហោះហើរ អន្ដរជាតិ ដំបូង របស់ ខ្លួន ដោយ ឆ្ពោះ ត្រង់ ពី រាជធានី ភ្នំពេញ ទៅកាន់ ទីក្រុង ម៉ាកាវ នា ថ្ងៃអាទិត្យ ទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ ម្សិលមិញ នេះ ។
ដើម្បីឲ្យ ប្រតិបត្តិការ ហោះហើរ អន្ដរជាតិ នេះ ប្រព្រឹត្ដទៅ ដោយ មាន ភាពជោគជ័យ និង មាន ភាពងាយស្រួល ខេមបូឌា អ៊ែរវ៉េ បាន ចាប់ផ្ដើម សេវា ហោះហើរ របស់ ខ្លួន ទៅកាន់ ទីក្រុង ម៉ាកាវ ចំនួន ៤ដង ក្នុង មួយ សប្ដាហ៍ ពោលគឺ រៀងរាល់ ថ្ងៃអង្គារ ពុធ សុក្រ និង អាទិត្យ ។
ជើងហោះហើរ អន្ដរជាតិ ដំបូង របស់ ខេមបូឌា អ៊ែរវ៉េ KR511 បាន ធ្វើ ការហោះហើរ នៅ ម៉ោង ១០៖៤៥ នាទី ពី អាកាសយានដ្ឋាន អន្ដរជាតិ ភ្នំពេញ ហើយ ធ្វើ ការចុះចត នៅ ព្រលានយន្ដហោះ អន្ដរជាតិ នៅ ទីក្រុង ម៉ាកាវ វេលា ម៉ោង ១៤៖ ០៥ នាទី ។
ជើងហោះហើរ KR512 នេះ បាន ធ្វើ ការហោះហើរ ត្រលប់ មកពី ទីក្រុង ម៉ាកាវ វិញ នៅ វេលា ម៉ោង ២១៖ ៤០ នាទី យប់ ហើយ នឹង ចុះចត នៅ ព្រលានយន្ដហោះ អន្ដរជាតិ ភ្នំពេញ នៅ វេលា ម៉ោង ២៣៖ ២៥ នាទី យប់ ។ ខេមបូឌា អ៊ែរវ៉េ សម្រេច ធ្វើ ការហោះហើរ ទៅ ទីក្រុង ម៉ាកាវ ដោយសារ ខេមបូឌា អ៊ែរវ៉េ ក៏ មាន ទីផ្សារ គាំទ្រ ពី ភ្នាក់ងារ ទេសចរណ៍ ជា ដៃគូ រួម ជាមួយនឹង តម្រូវការ ជាច្រើន ពី ទីនោះ ផងដែរ ។
ភាគ ច្រើន ភ្ញៀវ ទេសចរ ជា ជនជាតិ ចិន ដែល មកពី តាម បណ្ដា ទីក្រុង និង ខេត្ត ផ្សេង ៗ នៃ ប្រទេស ចិន ឆ្លងកាត់ តាម ទីក្រុង ម៉ាកាវ មុននឹង ពួកគាត់ ធ្វើដំណើរ មកកាន់ ប្រទេស កម្ពុជា ។ ដោយ ហេតុ នេះ ហើយ ទើប ខេមបូឌា អ៊ែរវ៉េ សម្រេច ជ្រើសរើស យក ការហោះហើរ អន្ដរជាតិ ដំបូង ទៅកាន់ ទីក្រុង មួយ នេះ ។
ក្រៅពី ការបើក ឲ្យ មាន ដំណើរការហោះហើរ ទីក្រុង ម៉ាកាវនេះ ហើយ ខេមបូឌា អ៊ែរវ៉េ នឹង ចាប់ផ្ដើម បន្ដ បើក ការហោះហើរ ឆ្ពោះ ទៅកាន់ ទីក្រុង ហុងកុង តៃវ៉ាន់ កូរ៉េ ខាងត្បូង ជប៉ុន រួមទាំង ប្រទេស ចិន និង បណ្ដា ប្រទេស ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ ដែល មាន ដូចជា ប្រទេស ថៃ សឹង្ហបុរី ហ្វីលីពីន ផងដែរ ។ ចំពោះ គម្រោង បន្ទាប់ ក្រុមហ៊ុន នឹង ពង្រីក ជើងហោះហើរ ឲ្យ កាន់តែ ទូលំទូលាយ ទៅកាន់ ប្រទស ខាង បែប អឺរ៉ុប និង ប្រទេស អូស្ដ្រាលី ។
បន្ថែម ពីលើ ចំណុច នេះ ថ្នាក់ដឹកនាំ នៃ ប្រទេស កម្ពុជា និង ម៉ាកាវ ក៏ ធ្លាប់ បាន ជួប ពិភាក្សា គ្នា កាលពី ប៉ុន្មាន ខែ កន្លងទៅ អំពី ការពង្រីក សហប្រតិបត្តិការ ក្នុង វិស័យ ទេសចរណ៍ និង ពាណិជ្ជកម្ម រវាង ប្រទេស កម្ពុជា និង ទីក្រុង ម៉ាកាវ នៃ ប្រទេស ចិន ព្រមទាំង លើកទឹកចិត្ត ដល់ ការវិនិយោគ លើ វិស័យ អាកាសចរណ៍ ឲ្យ មាន ការហោះហើរ ត្រង់ រវាង ទីក្រុង ម៉ាកាវ និង ប្រទេស កម្ពុជា ។
ខេមបូឌា អ៊ែរវ៉េ សង្ឃឹម ថា ការហោះហើរ អន្ដរជាតិ លើក ដំបូង នេះ នឹង ជួយ ជំរុញ ដល់ ការអភិវឌ្ឍ ដល់ ការអភិវឌ្ឍ របស់ ប្រទេស កម្ពុជា មិន ថា បច្ចុប្បន្ន និង ទៅ ថ្ងៃ អនាគត ព្រោះថា កម្ពុជា គឺជា តំបន់ ទេសចរណ៍ ដែល មាន ភាពទាក់ទាញ ទាំង ចំពោះ ភ្ញៀវ ជាតិ និង អន្ដរជាតិ និង មាន ធនធាន ធម្មជាតិ ដ៏ សម្បូរបែប ក៏ ដូចជា វប្បធម៌ ជាតិ និង តំបន់ បុរេប្រវិត្តសាស្ដ្រ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន កន្លែង ផងដែរ ៕ អង្គការ NASA នឹង បាញ់ បង្ហោះ យាន មួយ ប៉ុន រថយន្ត ដើម្បី ទៅ សិក្សា ជិត ព្រះអាទិត្យ បំផុត មិន ធ្លាប់ មាន !
( វ៉ាស៊ីនតោន ) ៖ ទីភ្នាក់ងារ អវកាស អាមេរិក NASA កំពុង រៀបចំ បាញ់ បង្ហោះ យានអវកាស មួយ គ្រឿង នៅ ខែសីហា ខាងមុខ នេះ ដើម្បី ទៅ សិក្សា ស្រាវជ្រាវ ជិត ព្រះអាទិត្យ ក្នុង ចម្ងាយ ដ៏ កៀក ជាង ពេល ណា ៗ ទាំងអស់ ក្នុង គោលបំណង ស្រាយ បំភ្លឺ ពី អាថ៌កំបាំង យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ នៅ ពីក្រោយ ដុំ បាល់ ភ្លើង នេះ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃចន្ទ ទី២៣ ខែកក្កដា ឆ្នាំ ២០១៨ ។
( ភ្នំពេញ ) ៖ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជូន ខ្លួន បុរស ដែល យក កាំបិត កាប់ លើ ប្រពន្ធ ខ្លួន ឯង ព្រោះតែ ប្រចណ្ឌ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការបន្ដ តាម នីតិវិធី ច្បាប់ ។
បើ តាម សមត្ថកិច្ច បាន ឲ្យដឹង ថា ជនសង្ស័យ មាន ឈ្មោះ ហ៊ន រិទ្ធី អាយុ ២៨ ឆ្នាំ មាន មុខរបរ ជា កម្មករ សំណង់ និង មាន ស្រុក កំណើត នៅក្នុង ភូមិ ព្រៃ បឹង ឃុំ វាល ពន់ ស្រុក ង្ពង ខេត្ត កំពង់ស្ពឺ ។
ជនសង្ស័យ រូប នេះ បាន ប្រើ កាំបិត កាប់ ចំ ក្បាល ប្រពន្ធ ឈ្មោះ ត្រេន ពៅ អាយុ ៣៣ ឆ្នាំ ជា កម្មការិនី រោងចក្រ កាត់ HANSOM ដេរ ហែន សាំ បណ្តាលឲ្យ របួស ធ្ងន់ធ្ងរ ។ ក្នុង បន្ទប់ ជួល មួយ ស្ថិតៅ ភូមិ ព្រៃ ទា សង្កាត់ ចោម ចៅ៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
សូម បញ្ជាក់ ថា សមត្ថកិច្ច នគរបាល នាយកដ្ឋាន ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ សហការ ជាមួយ នគរបាល រាជធានី ភ្នំពេញ និង នគរបាល នៃ ស្នងការដ្ឋាន ខេត្ត បាត់ដំបង បាន ចាប់ខ្លួន ជន ស្ង័យ បាន កាលពី វេលា ម៉ោង ១១៖ ២០នាទី ព្រឹក ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៨ នៅ កន្លែង ដែល ជន នេះ លាក់ ខ្លួន ស្ថិត នៅក្នុង ភូមិ បួន ជួរ ឃុំ ឃុំ បឹង ប្រិយ៍ ស្រុក បាណន់ ខេត្ត បាត់ដំបង ហើយក៏ បញ្ជូន មកកាន់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ វិញ ។
គួរ រំលឹក ថា ហេតុការ ហិង្សា ប្តី យក កាំបិត កាប់ លើ ប្រពន្ធ ខ្លួន ឯង ព្រោះ រឿង ភ្លើង ប្រចណ្ឌ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ១២៖ ៥០នាទី រសៀល ថ្ងៃទី ៨ ខែកក្កដា ឆ្នាំ ២០១៨ នៅក្នុង បន្ទប់ ផ្ទះ ជួល នៅក្នុង ភូមិ ព្រៃ ទា សង្កាត់ ចោម ចៅ៣ ខណ្ឌ ពោធិ៍សែនជ័យ ។
ក្រោយពី ធ្វើ សកម្មភាព រួច មក ជនសង្ស័យ បាន រត់ ទៅ លាក់ ខ្លួន នៅ ខេត្ដ បាត់ដំបង អស់ រយៈពេល ១១ ថ្ងៃ ទើប នគរបាល ឃាត់ខ្លួន បាន តែម្តង ៕ អភិបាល ខេត្ត រតនគិរី ប្រគល់ ម៉ូតូ ៥០ គ្រឿង ជា អំណោយ របស់ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការ នគរបាល ជាតិ ជូន ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទូទាំង ខេត្ត
( រតនគិរី ) ៖ លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ប្រគល់ ម៉ូតូ ដែល ជា អំណោយ របស់ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការ នគរបាល ជាតិ ជូន ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ សង្កាត់ នីមួយ ៗ ទាំង ៥០ ក្នុង ខេត្ត នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ។
ក្នុង ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ ងួន គឿន បាន ផ្តាំផ្ញើ ដល់ អស់ លោក មេ ប៉ុស្តិ៍ ពេល ទទួលបាន ម៉ូតូ នេះ ត្រូវ ចេះ ថែរក្សា ឲ្យបាន ល្អ ចេញ ល្បាត ក្នុង ភូមិសាស្ត្រ របស់ ខ្លួន គ្រប់គ្រង សំដៅ រក្សា ឲ្យបាន នូវ ស្ថេរភាព សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ឲ្យបាន ល្អ ក្នុង មូលដ្ឋាន របស់ ខ្លួន គ្រប់គ្រង ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ថង សាវុន បាន ផ្តាំផ្ញើ ដល់ មន្ត្រី នគរបាល ប៉ុស្តិ៍ ទាំងអស់ ត្រូវ បំពេញ តួនាទី ថែរក្សា សណ្តាប់ធ្នាប់ សន្តិសុខ សាធារណៈ បំពេញ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ . ការពារ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ជាពិសេស ក្នុង ពេល បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ ឲ្យបាន រលួន និង មិន មាន អំពើហិង្សា កើតឡើង រហូតដល់ ក្រោយពេល បោះ ៣ខែ ពោលគឺ រដ្ឋាភិបាល ថ្មី កើតឡើង ។
បើ តាម រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៧ ខែកក្កដា ខាងមុខ គណបក្ស នយោបាយ ជាច្រើន នឹង ធ្វើ ការជួបជុំ និង ដង្ហែ ក្បួន បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត នៅ មជ្ឈមណ្ឌល សន្និបាត និង ពិព័រណ៌ កោះ ពេជ្រ មាន ការជួបជុំ សមាជិក រហូតដល់ ប្រមាណ ២៥០.០០០ នាក់ និង នៅ ទីលាន ប្រជាធិបតេយ្យ មាន ការជួបជុំ សមាជិក រហូតដល់ ប្រមាណ ២០.០០០ នាក់ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា បន្ទាប់ពី ការជួបជុំ បណ្ដា គណបក្ស នយោបាយ នឹង ធ្វើ ការដង្ហែ តាម មហាវិថី កម្ពុជា ក្រោម មហាវិថី សម្ដេច មុនីរ៉េត កំណាត់ វិថី សម្ដេច សុធារស កំណាត់ មហាវិថី ម៉ៅ សេ ទុង កំណាត់ មហាវិថី ព្រះមុនីវង្ស កំណាត់ មហាវិថី ព្រះសីហនុ គិរី វិថី ព្រះស៊ីសុវត្ថិ ផ្លូវ ជាតិ លេខ ៥ ផ្លូវ ជាតិ លេខ ៦ ផ្លូវ ជាតិ លេខ១ ផ្លូវ ជាតិ លេខ ២ ផ្លូវ មិត្តភាព ភ្នំពេញ - ហាណូយ ផ្លូវ ណត ប្រ៊ីត ផ្លូវ ចោម ចៅ ផ្លូវ លេខ ២៧១ ផ្លូវ លេខ ៧០ និង ផ្លូវ សំខាន់ ៗ មួយចំនួន ទៀត ក្នុង រាជធានី ភ្នំពេញ ។
សូម អាន ខ្លឹមសារ លម្អិត នៃ សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ខាងក្រោម នេះ៖
ក្នុង ពិធី ប្រគេន ទាន វស្សា នេះ លោក ប៉ែន ស៊ីម៉ន ក៏ បាន ឆ្លៀត ឱកាស អំពាវនាវ ប្រាប់ ប្រជាពលរដ្ឋ ត្រូវ ត្រៀមខ្លួន និង ឯកសារ ឱ្យ បាន គ្រប់គ្រាន់ ដើម្បី ចូលរួម បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ ហើយ សូម ទៅ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា ដើម្បី សន្តិភាព និង ប្រជាធិបតេយ្យ ។
លោក បាន លើកឡើង បន្ត ទៀត ថា បច្ចុប្បន្ន ព្រះរាជាណាចក្រ កម្ពុជា យើង ក្រោម ការដឹកនាំ លើ ផ្លូវ ត្រូវ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន វិស័យ ពុទ្ធ ចក្រ មាន ការរីកចម្រើន គួរឱ្យ កត់ សម្គាល់ ហើយ វិស័យ ពុទ្ធ ចក្រ នេះ រុងរឿង ទៅ បាន ដោយសារ វិស័យ អាណាចក្រ ហើយ អាណាចក្រ រុងរឿង ទៅ បាន ដោយសារ សន្តិភាព មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍ និង មាន ប្រជាធិបតេយ្យ ។
( កណ្ដាល ) ៖ លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ដ្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ចាត់ វិធានការ ភ្លាម ៗ ដោយ បញ្ជូន មន្ដ្រី ជំនាញ ចុះ ពិនិត្យ និង លុប ឆ្នូត រំញ័រ នៅ តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ១ មុខ សាលា បឋមសិក្សា ហ៊ុន សែន ស្លា កែត ស្ថិត ក្នុង ភូមិ ស្លា កែត ឃុំ គគីរ ស្រុក កៀនស្វាយ ខេត្ត កណ្ដាល ។
យោង តាម ទំព័រ Facebook ផ្លូវការ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជាក់ ថា ការលុប ឆ្នូត រំញ័រ នេះ បាន ធ្វើឡើង បន្ទាប់ពី ទទួលបាន សំណូមពរ ពី ប្រជាពលរដ្ឋ មូលដ្ឋាន ថា ឆ្នូត រំញ័រ នេះ បាន រំខាន ដល់ ពលរដ្ឋ និង សិស្សានុសិស្ស ។
ក្រសួង សាធារណការ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ក្រោយ ទទួលបាន ព័ត៌មាន ពី ប្រជាពលរដ្ឋ យើង ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ចាត់ វិធានការ ភ្លាម ៗ ដោយ បញ្ជូន មន្ត្រី ជំនាញ ចុះ ពិនិត្យ និង លុប ឆ្នូត រំញ័រ នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ០១ ត្រង់ ចំណុច មុខ សាលា បឋមសិក្សា ហ៊ុន សែន ស្លា កែត និង ទីតាំង មួយចំនួន ទៀត សំដៅ កាត់បន្ថយ សម្លេង រំខាន ដល់ សិស្សានុសិស្ស និង បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម បណ្តោយ ផ្លូវ នោះ » ។
ទន្ទឹមនឹង នេះ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន សូម អំពាវនាវ ដល់ អ្នក រស់ នៅ តាម បណ្តោយ ផ្លូវ សាធារណៈ មាន ការប្រុងប្រយ័ត្ន ក្នុង ការពេល ដើរ ឆ្លងកាត់ ទ្រូងផ្លូវ និង សូម អ្នកបើកបរ ត្រូវ បើកបរ ប្រកបដោយ ការប្រុងប្រយ័ត្ន និង ទំនួល ខុសត្រូវ ខ្ពស់ ។
យ៉ាងណាមិញ ពាក់ព័ន្ធ រឿង ឆ្នូត រំញ័រ នេះ ប្រជាពលរដ្ឋ នៅ ម្ដុំ ស្តុប កាក ប្រហម ខេត្ត កណ្តាល ( ផ្លូវ ១១៥ ឡើង ទៅ ស្ពាន ព្រែក សំរោង ) ស្ថិត ក្នុង ភូមិ ព្រែក សំរោង សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ក៏ ស្នើ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ពិនិត្យ គំនូស កាត់ ទទឹង ផ្លូវ ដែល មាន កម្រាស ក្រាស់ ៗ ហើយ ពេល មាន ឡាន ធំ បើក កាត់ ម្តង ៗ មាន សំឡេង រំខាង ខ្លាំង ណាស់ ជាពិសេស រំ ជួយ ផ្ទះ របស់ ពួកគាត់ ។
បើ តាម ប្រជាពលរដ្ឋ ពួកគាត់ ធ្លាប់ បាន ស្នើ ជាច្រើន ដង ហើយ ប៉ុន្ដែ មិន ទាន់ មាន ចំណាត់ ការ ណាមួយ សមស្រប នោះ ទេ ដូច្នេះ ក្រោយ ឃើញ ចំណាត់ការ របស់ លោក រដ្ឋមន្ដ្រី ដ៏ មាន ប្រសិទ្ធភាព នៅ ផ្លូវ ជាតិ លេខ ១ ពួកគាត់ ចង់បាន នូវ ចំណាត់ការ ដូចគ្នា នេះ ដែរ ព្រោះ បច្ចុប្បន្ន ពួកគាត់ ក៏ កំពុង ជួប ការរំខាន ដោយ សំឡេង ខ្លាំង ៗ ដូចគ្នា ។
ប៉ុន្ដែ ករណី នេះ ត្រូវបាន លោក ម៉ឹង យូរ ឡេង ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ប្រាប់ អ្នកកាសែត ថា គ្មាន ដំណោះស្រាយ នោះ ទេ ពោល កំហុស មកពី ប្រជាពលរដ្ឋ សាងសង់ ផ្ទះ នៅក្បែរ ផ្លូវ ហើយ ប្រសិន មិន ចង់ឲ្យ លឺ សំឡេង រំខាន ត្រូវ ធ្វើ ផ្ទះ ថយ ទៅ ក្រោយ ឬ ធ្វើ បង្អួច ដាក់ កញ្ចប់ ឲ្យ ក្រាស់ ៗ ទៅ លែង លឺ រំខាន ហើយ ។ មួយ វិញទៀត លោក ប្រធាន មន្ទីរ សាធារណការ បែរ ចោទ ជា សំណួរ មក អ្នកសារព័ត៌មាន ថា តើ គួរឲ្យ គាត់ ធ្វើ យ៉ាង មិញ លើ ករណី នេះ ? ។
ជាមួយគ្នា នេះ លោក ម៉ឹង យូរ ឡេង ក៏ បាន ឲ្យ ដំបូន្មាន ដល់ ប្រជាពលរដ្ឋ ថា ដើម្បី កុំ ឲ្យ លឺ សំឡេង រំខាន ខ្លាំង ត្រូវតែ បិទ បង្អួច ផ្ទះ ឲ្យ ជិត ៗ ឬ ត្រូវ ដូរ បង្អួច ស្ដង់ដា ដែល បិទ ឲ្យ ជិត ហើយ ប្រើ កញ្ចក់ ឲ្យ ក្រាស់ បន្ដិច ទៅ លែង លឺ រំខាន ហើយ ព្រោះថា យើង មិន អាច ទៅ រុះរើ ដើម្បី តម្រូវ ផ្ទះ ពលរដ្ឋ មួយ គ្រួសារ ឬ ពីរ គ្រួសារ បាន នោះ ទេ ៕
គួរ ជម្រាប ថា ការលើកឡើង របស់ លោក ម៉ៃក៍ ប៉ុម ប៉េអូ ធ្វើឡើង បន្ទាប់ពី ប្រធានាធិបតី អ៊ីរ៉ង់ លោក ហាសាន់ រូហានី បាន ព្រមាន ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ថា កុំ បង្ក ឬ បង្កើន ជម្លោះ ជាមួយ ប្រទេស របស់ លោក ជាដាច់ខាត ព្រោះថា ជម្លោះ ជា មួយ អ៊ីរ៉ង់ នឹង ក្លាយជា សង្រ្គាម មិន ធ្លាប់ មាន ពីមុន មក ៕
អ្នកនាំពាក្យ បក្ស កាន់អំណាច៖ កម្ពុជា ប្រៀប ដូចជា កូនក្រមុំ សម្រាប់ លោក ខាងកើត និង លោក ខាងលិច ប៉ុន្តែ បង្ហើប ថា ស្នេហ៍ មិន ជាង ស្និទ្ធ ទេ
( ភ្នំពេញ ) ៖ ជាសារ នយោបាយ ថ្មី មួយ នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក សុខ ឥសាន អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច បាន លើកឡើង ថា កម្ពុជា ប្រៀប បីដូចជា កូនក្រមុំ សម្រាប់ សេដ្ឋី ខាងកើត និង ខាងលិច ។ ជាមួយគ្នា នេះ លោក បាន បញ្ជាក់ ថា ជាទូទៅ ក្នុង ការចែ ចូវ កូនក្រមុំ កម្ពុជា នេះ ប្រៀប ដូចជា ពាក្យ ចាស់ បុរាណ ដែល ពោល ថា ស្នេហ៍ នឹង មិន ឈ្នះ ស្និទ្ធ នោះ ទេ ។
លោក សុខ ឥសាន បាន លើកឡើង ថា នៅ ក្រោយពី ប្រទេស កម្ពុជា បាន ឯករាជ្យ នា ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ១៩៥៣មក កម្ពុជា ត្រូវបាន គេ មេីល ឃេីញ ថា ជា ភូមិសាស្ត្រ នយោបាយ ល្អ សម្រាប់ ដណ្តេី ម ឧត្តមភាព រវាង មហាសេដ្ឋី ខាង កេីត និង មហាសេដ្ឋី ខាងលិច ធ្វើឲ្យ កម្ពុជា ក្លាយទៅជា កូនក្រមុំ ដ៏ ទាក់ទាញ ។ ក៏ប៉ុន្តែ មហាសេដ្ឋី ទាំង ពីរ មាន វិធី និង នយោបាយ ស្រឡាញ់ កូនក្រមុំ កម្ពុជា ខុសគ្នា ។
អភិបាល រាជធានី នាំ ទៀន វស្សា ប្រេងឥន្ធនៈ បច្ច័យ និង ទេយ្យ ប្រគេន ដល់ ព្រះសង្ឃ គង់ ក្នុង វត្ត ចំនួន ១៨ នៅ ខណ្ឌ ព្រែក ព្នៅ
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោកស្រី . លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ រួម ជាមួយ មន្ត្រី ក្រោម ឱវាទ និង អាជ្ញាធរដែនដី នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន នាំយក ទៀន វស្សា ប្រេងឥន្ធនៈ អង្ករ បច្ច័យ និង ទេយ្យ វត្ត មួយចំនួន ទៅ ប្រគេន ដល់ ព្រះសង្ឃ គង់ នៅក្នុង វត្ត ចំនួន ១៨ នៅក្នុង ខណ្ឌ ព្រែក ព្នៅ ។
សូម បញ្ជាក់ ថា ពិធី ចូលកាន់ ព្រះវស្សា មាន រយៈ៣ខែ ដោយ ចាប់ពី ថ្ងៃ ១រោច ខែ អាសាឍ ត្រូវនឹង ថ្ងៃទី ២៨ ខែកក្កដា រហូតដល់ ថ្ងៃ ១៥ កើត ខែ អស្សុជ ត្រូវនឹង ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០១៨ ៕
មន្រ្តី ជាន់ ខ្ពស់ គណបក្ស ប្រជាជន កម្ពុជា ចុះ មូលដ្ឋាន ស្រុក ស្រីសន្ធរ ស្នើឲ្យ សមាជិក បក្ស ពង្រឹង កម្លាំង នៅ តាម មូលដ្ឋាន ឲ្យ បាន រឹងមាំ ខណៈ ការបោះឆ្នោត ខិត ជិត ចូល មកដល់
( កំពង់ចាម ) ៖ អនុវត្ត តាម ច្បាប់ ស្តីពី ការបោះឆ្នោត និង គោលការណ៍ របស់ គណៈកម្មាធិកា ជាតិ រៀបចំ ការបោះឆ្នោត គ្រប់ គណបក្ស នយោបាយ ទាំងអស់ បាន ធ្វើ សកម្មភាព ស្វែងរក សំឡេង ឆ្នោត ទៅ តាម លទ្ធភាព រៀង ៗ ខ្លួន ពុះពារ សម្រេច ឲ្យបាន នូវ ការប្តេជ្ងា ចិត្ត យកឈ្នះ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៦ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
ជាក់ស្តែង និង សម្រាប់ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា វិញ នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ លោក ឡូវ ហ៊ឺង ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ទង ត្រឡាច និង លោក ឧកញ៉ា ជា លាង ហុង បាន អញ្ជើញ ជួបជុំ សំណេះសំណាល និង ទទួលទាន បបរ សាមគ្គី ក្រោម ទិស ស្លោក ប្រទេសជាតិ មាន ការរីកចម្រើន នៅក្នុង បរិវេណ វត្ត ខ្ទឹង ស្ថិត ក្នុង ភូមិ ខ្ទឹង ស្រុក ស្រីសន្ធ រ ខេត្ត កំពង់ចាម ។
លោក ឧកញ៉ា ជា លាង ហុង បាន ស្នើសុំ ឲ្យ សមាជិក សមាជិកា បក្ស ពង្រឹង កម្លាំង នៅ តាម មូលដ្ឋាន ឲ្យ បាន រឹងមាំ ប្រមូលផ្តុំ ជា ធ្លុង សាមគ្គី ឲ្យបាន ល្អ និង ត្រូវ ដាក់ចិត្ត មាន ជំនឿ ជឿជាក់ ទៅ លើ ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន គោលជំហរ យ៉ាង ពិតប្រាកដ ដើម្បី ប្រែក្លាយ កម្ពុជា ទៅជា ប្រទេស មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ និង ការឈាន ទៅ រក ប្រទេស មាន កំណើន សេដ្ឋកិច្ច ខ្ពស់ ។
លោក ឡូវ ហ៊ឺង បាន បញ្ជាក់ ថា « ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៦ នៃ រដ្ឋសភា នា ថ្ងៃអាទិត្យ ទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ គណបក្ស នយោបាយ ទាំងអស់ ត្រូវបាន អនុញ្ញាតឲ្យ ឃោសនា រយៈពេល ២១ ថ្ងៃ ចាប់ពី ថ្ងៃទី ៧ ដល់ ថ្ងៃទី ២៧ ខែកក្កដា ឆ្នាំ ២០១៨ ដែល រហូតមកដល់ ថ្ងៃ នេះ ជា រួម បរិយាកាស សន្តិសុខ សុវិត្ថភាព និង សណ្តាប់ធ្នាប់ សាធារណៈ ត្រូវបាន ធានា ហើយ ការឃោសនា បាន ប្រព្រឹត្តទៅ ដោយ រលូន គ្នាន អំពើហិង្សា នៅក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស ។ នេះ បើ យោង តាម ការបញ្ជាក់ របស់ គ.ជ. ប » ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ រសៀល ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ នៅ ភូមិ គូលែន ត្បូង ឃុំ គូលែន ត្បូង ស្រុក គូលែន ខេត្ត ព្រះវិហារ ។
មន្ត្រី នគរបាល ស្រុក គូលែន បាន បន្ត ទៀត ថា ជនរងគ្រោះ ជា ម្ចាស់ រថយន្ត មាន ឈ្មោះ ធួន សាវៀត អាយុ ៤៦ ឆ្នាំ មុខរបរ អនុប្រធាន ការិយាល័យ អប់រំ ស្រុក គូលែន ចំណែក អ្នក រួម ដំណើរ ជាមួយ មាន ឈ្មោះ ណៃ វណ្ណា ភេទ ប្រុស អាយុ៣០ ឆ្នាំ មុខរបរ មន្ត្រី បរិស្ថាន ប្រចាំ នៅ ស្នាក់ការតា កឹង ហើយ រថយន្ត បង្ក ម៉ាក តា កូម៉ាពណ៍ សំបក ឪឡឹក ពាក់ ស្លាកលេខ ភ្នំពេញ 2Q 9921 ខូចខាត ផ្នែក ខាងមុខ បច្ចុប្បន្ន រថយន្ត ត្រូវបាន សមត្ថកិច្ច យក ទៅ រក្សាទុក នៅ អធិការ ស្រុក ។
ទាក់ទង នឹង ហេតុការណ៍ ដែល មិន គួរ កើត នេះ សមត្ថកិច្ច ធ្វើ ការសន្និដ្ឋាន ថា អាច បណ្តាល មកពី អ្នក រួម ដំណើរ នៅក្នុង រថយន្ត គាត់ ក្តៅ ស្អុះ ពេល ពន្លត់ ម៉ាស៊ីន រថយន្ត ធ្វើឱ្យ គាត់ កាច់ សោរ បញ្ឆេះ វិញ ស្រប ពេល មិន ចេះ បើក ផងក៍ ប៉ះ ចង្កឹះ លេខ ថយ ក្រោយ ធ្លាក់ ភក់ តែម្តង ហើយក៍ ដាក់ ចង្កឹះ លេខ ទៅ មុខ វិញ បណ្តាលឱ្យ បុក មនុស្ស បុក ម៉ូតូ និង បុក សរសរ ផ្ទះ ដាច់ អស់ ២ដើម តែ ម្តង ទៅ ។ តែ ទោះជា យ៉ាងណា នេះ គ្រាន់តែ ជា ការសន្និដ្ឋាន ប៉ុណ្ណោះ រឿង ពិត យ៉ាងណា នោះ សមត្ថកិច្ច កំពុង ស្រាវជ្រាវ បន្ត ទៀត ។
បើ តាម ការឲ្យដឹង ពី លោក វរសេនីយ៍ ទោ ឡាញ់ លី ស៊ីវ ឡេង អធិការ នគរបាល ស្រុក គូលែន បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ថា បុរស ឈ្មោះ ណៃ វណ្ណា ជា មន្ត្រី បរិស្ថាន គូលែន ព្រហ្ម ទេព ប្រចាំ ស្នាក់ការតា កឹង ដែល បង្ករ បួស ដល់ ម្ចាស់ រថយន្ត នោះ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ហើយ ៕
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៧គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន ញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ៕ ស្វែងយ ល់៖ ហេតុ អ្វី បានជា ប្រទេស អាន់ ទីហ្គ័រ និង បាបូដា ក្លាយជា ទិសដៅ ចម្បង សម្រាប់ វិនិយោគិន ?
វា ក៏ ត្រូវបាន គេ ឲ្យ ឈ្មោះ ហៅ ក្រៅ ថា ជា « ទឹកដី នៃ ឆ្នេរសមុទ្រ ចំនួន ៣៦៥ » ដោយសារ មាន ឆ្នេរ ខ្សាច់ ជា ច្រើន នៅ ហុំ ព័ទ្ធ កោះ ទាំងនេះ ។ សម្រាប់ ការគ្រប់គ្រង ភាសា និង វប្បធម៌ របស់ ប្រទេស នេះ គឺ ទទួលបាន ឥទ្ធិពល ពី អាណាចក្រ អង់គ្លេស ដោយសារ ប្រទេស នេះ ធ្លាប់ ស្ថិត នៅក្រោម អាណានិគម អង់គ្លេស ហើយ ទើប ទទួលបាន អធិបតេយ្យភាព នៅ ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ១៩៨១ ។
សព្វ ថ្ងៃ នេះ វា នៅតែ ជា សមាជិក នៃ អាណាចក្រ ពលរដ្ឋ អង់គ្លេស ដោយ មាន ម្ចាស់ក្សត្រី យានី អេលីហ្សា បែត ទី២ ជា ប្រមុខរដ្ឋ ។ ប្រទេស អាន់ ទីហ្គ័រ នេះ គឺ មាន ភាព ធំ ជាង គេ ក្នុង ចំណោម កោះ ពីរ ហើយ មាន ភាពងាយស្រួល ខាង ផ្នែក ធ្វើដំណើរ តាមរយៈ ការហោះហើរ ត្រង់ ពី ចក្រភព អង់គ្លេស សហរដ្ឋ អាមេរិក និង កាណាដា ។
