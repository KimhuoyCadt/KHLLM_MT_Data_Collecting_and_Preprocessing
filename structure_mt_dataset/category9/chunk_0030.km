( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ សេចក្តីជូនដំណឹង ពី ការកំណត់ តម្លៃ សាំង ដែល ត្រូវ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ ដោយ សាំង ធម្មតា ត្រូវ លក់ ក្នុង តម្លៃ មិន លើស ពី ៣៩៥០ រៀល និង ម៉ាស៊ូត ត្រូវ លក់ ក្នុង តម្លៃ ៣៧៥០ រៀល ក្នុង មួយ លីត្រ ដែល តម្លៃ នេះ នៅ រក្សា ដដែល បើ ធៀប នឹង ខែ មុន ៕ សូម កុំ បើកបរ ស្ថិត ក្រោម ឥទ្ធិពល គ្រឿងញៀន ! គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០២ ខែសីហា គ្មាន អ្នកស្លាប់ ទេ មាន តែ អ្នករបួស ១៣នាក់
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស របួស ធ្ងន់ ចំនួន ៦នាក់ និង របួស ស្រាល ៧នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៤លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៤គ្រឿ . រថយន្ដ ធុន ធំ៣ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . បត់ គ្រោះថ្នាក់ . មិន គោរព សិទ្ធិ និង មិន ប្រកាន់ ស្ដាំ ។
សូម បញ្ជាក់ ថា រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ដល ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៨ នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចណ៍ កើតឡើង ចំនួន ១៤លើក បណ្ដាលឲ្យ មនុស្ស ស្រាប់ ចំនួន ៤នាក់ . របួស ស្រាល ១១នាក់ និង របួស ធ្ងន់ ១៤នាក់ ៕
លោក គីម ជុង អ៊ុន ផ្ញើ លិខិត មួយ ច្បាប់ ជូន លោក ដូណាល់ ត្រាំ ដោយ បាន បញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត លុបបំបាត់ អាវុធ នុយក្លេអ៊ែរ ...
( វ៉ាស៊ីនតោន ) ៖ សេតវិមាន ទីក្រុង វ៉ាស៊ីនតោន បាន ប្រកាស ថា ប្រមុខ ដឹកនាំ កំពូល ផុត លេខ របស់ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន បាន ផ្ញើ លិខិត មួយ ច្បាប់ មក ជូន ប្រធានាធិបតី សហរដ្ឋ អាមេរិក លោក ដូណាល់ ត្រាំ ពាក់ព័ន្ធ នឹង កិច្ចពិភាក្សា កំពូល រវាង មេដឹកនាំ ទាំង ពីរ ដែល ទើបតែ បាន បញ្ចប់ ទៅ កាលពី ប៉ុន្មាន ខែ មុន នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ Reuters នា យប់ ថ្ងៃព្រហស្បតិ៍ ទី០២ ខែសីហា ឆ្នាំ ២០១៨ ។
គួរ បញ្ជាក់ ថា ការផ្ញើ លិខិត មកកាន់ លោក ដូណាល់ ត្រាំ ពេលនេះ បាន កើត មាន ឡើង តែ ប៉ុន្មាន ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី ក្រុម ស៊ើបការណ៍ សម្ងាត់ តាមរយៈ ផ្កាយ រណប របស់ អាមេរិក បាន ទម្លាយ ព័ត៌មាន ថា សកម្មភាព មិន ប្រក្រតី មួយ បាន កើត មាន ឡើង ក្នុង ទឹកដី កូរ៉េ ខាងជើង ដែល អាច ជា សញ្ញា ថា កូរ៉េ ខាងជើង កំពុងតែ ផលិត គ្រាប់ មីស៊ីល ផ្លោង ICBM ឡើងវិញ ៕
៤៖ នៅ ខែតុលា សម្ដេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ចូលរួម ប្រជុំ អាស៊ី អឺរ៉ុប និង ប្រជុំ អាស៊ាន អឺរ៉ុប នៅ ប្រទេស ប៊ែល ហ្ស៊ិច . សម្ដេច ស្វាគមន៍ រាល់ ការធ្វើ បាតុកម្ម ប្រឆាំង សម្ដេច ជានិច្ច ( ចុច អាន )
៦៖ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ថា ការរំលាយ គណបក្ស សង្គ្រោះ ជាតិ គឺជា ការបញ្ចៀស សង្គ្រាម នៅ កម្ពុជា ( ចុច អាន )
៧៖ សម្តេច តេជោ ហ៊ុន សែន គ្រោង នឹង ដាក់ ឲ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ តាម រថភ្លើង ដោយ ឥត គិត ថ្លៃ រៀងរាល់ ឱកាស បុណ្យ ចូល ឆ្នាំ និង ភ្ជុំ បិណ្ឌ បន្ថែម លើ ការជិះ រថយន្តក្រុង ដោយ ឥត គិត ថ្លៃ ( ចុច អាន )
៩៖ សម្តេច តេជោ ហ៊ុន សែន បញ្ជា ឱ្យ មន្រ្តី ចុះបម្រើ ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន វិញ ក្រោយ ឈ្នះ ឆ្នោត ហើយ ធ្វើឱ្យ បាន ល្អ ជាង មុន និង យកចិត្តទុកដាក់ ជាង មុន ( ចុច អាន )
១០៖ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា៖ អំឡុង ពេល រៀបចំ ការបោះឆ្នោត វិស័យ ដីធ្លី មាន ការទិញ លក់ ច្រើន ធ្វើឲ្យ ចំណូល ពន្ធដារ មិន ធ្លាក់ចុះ ! ( ចុច អាន )
១១៖ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ការពារ តារាចម្រៀង ម៉េង កែវ ពេជ្ជតា ដែល ត្រូវ អ្នកគាំទ្រ អតីត បក្ស ប្រឆាំង កាត់ តវីដេអូ ថា « មើលងាយ ប្រជាពលរដ្ឋ ខ្មែរ » ( ចុច អាន )
១២៖ រដ្ឋមន្ត្រី ការបរទេស មហា យក្ស ចិន៖ បរទេស មិន គួរ លូកលាន់ កិច្ចការ ផ្ទៃក្នុង របស់ កម្ពុជា នោះ ទេ ( ចុច អាន )
១៣៖ រដ្ឋមន្ត្រី ការបរទេស ចិន និង កម្ពុជា ប្តេជ្ញា រួមគ្នា ប្រឆាំង គំនិត ឯកតោ ភាគី និង គាំពារ និយម ( ចុច អាន )
១៤៖ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្ដរាយ ខេត្ត ស្ទឹងត្រែង អំពាវនាវ រក ជំនួយ សប្បុរស ឧបត្ថម្ភ ដល់ ពលរដ្ឋ រង ផល ប៉ះពាល់ ដោយ គ្រោះ ទឹក ជំនន់ ( ចុច អាន )
១៥៖ អគ្គ លេខាធិការដ្ឋាន គ.ជ. ប៖ គេហទំព័រ ផ្សាយ លទ្ធផល សំឡេង ឆ្នោត នឹង ផ្អាក ការផ្សាយ ជា បណ្តោះអាសន្ន ( ចុច អាន )
១៦៖ រដ្ឋមន្រ្តី ការបរទេស ចិន អបអរសាទរ ចំពោះ ជោគជ័យ នៃ ការបោះឆ្នោត ជាតិ នៅក្នុង ប្រទេស កម្ពុជា ( ចុច អាន )
១៩៖ នគរបាល ពាក់ ស័ក្ដិ៤ កន្លះ ដែល បាញ់ សម្លាប់ ខ្លួន ក្នុង បន្ទប់ សណ្ឋាគារ « កូឡូសូ» ដោយសារ មាន វិបត្តិ ផ្ទាល់ខ្លួន . ក្រុមគ្រួសារ ថា ជនរងគ្រោះ ចេញពី ផ្ទះ ប៉ុន្មាន ថ្ងៃ ហើយ ! ( ចុច អាន )
២៖ គណបក្ស កាន់អំណាច ហ្ស៊ីមបាវ៉េ ទទួលបាន សម្លេង គាំទ្រ ភាគ ច្រើន នៅក្នុង ការបោះឆ្នោត ( ចុច អាន )
៣៖ អ៊ីរ៉ង់ ប្រមូលផ្ដុំ កងទ័ព ជើងទឹក នៅក្បែរ ឈូង សមុទ្រ ពែក ក្រោម ការឃ្លាំមើល របស់ អាមេរិក ( ចុច អាន )
៤៖ រដ្ឋាភិបាល តួកគី ប្រកាស ថា នឹង សងសឹក សហរដ្ឋ អាមេរិក ដែល បាន ដាក់ទណ្ឌកម្ម លើ រដ្ឋមន្ត្រី តួកគី ពីរ រូប ( ចុច អាន )
៨៖ បច្ចេកវិទ្យា អ៊ិនធើណេត ជួយ ពង្រឹង ដល់ វិស័យ សុខាភិបាល ទូទាំង ប្រទេស ចិន ( ចុច អាន )
( ម៉ូស្គូ) ៖ ក្រុម អ្នកវិទ្យាសាស្ត្រ រុស្ស៊ី បាន រកឃើញ រ៉ែ ប្រភេទ ថ្មី មួយ ដែល មាន ភាពរឹង មំា ដូចជា គ្រាប់ ពេជ្រ នៅឯ តំបន់ ស៊ី បេរី ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ យប់ ថ្ងៃព្រហស្បតិ៍ ទី០២ ខែសីហា ឆ្នាំ ២០១៨ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី០២ ខែសីហា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បាន ឱ្យដឹង ថា ខ្លួន បាន បញ្ជូន នាវា ចម្បាំង មួយ គ្រឿង ទៅកាន់ ប្រទេស លីប៊ី ដែល ជា ការបង្ហាញ ចេតនា ចង់ បង្ហាញ កម្លាំង សាច់ដុំ ដើម្បី ធានា ឱ្យ មាន ការដោះលែង ជនជាតិ កូរ៉េ ខាងត្បូង ម្នាក់ ដែល ត្រូវបាន គេ ចាប់ ពង្រត់ ជាមួយ ជនជាតិ ហ្វីលីពីន បី នាក់ ផ្សេង ទៀត នៅក្នុង ប្រទេស អាហ្វិ្រក ខាងជើង មួយ នេះ ៕
៣៖ មន្រ្តី រដ្ឋាភិបាល ក្រុង វ៉ាស៊ី តោន បាន ឲ្យដឹង ថា សហរដ្ឋ អាមេរិក អាចនឹង បង្កើន អត្រា យក ពន្ធ ចំពោះ ទំនិញ នាំចូល ពី ចិន បន្ថែម ទៀត ពីលើ គំរោង បន្ថែម ពន្ធ ស្រាប់ ក្នុង ទំហំ ប្រមាណ ២០០ ពាន់ លាន ដុល្លារ ដែល ខ្លួន បាន គ្រោង ទុក រួច ជាស្រេច ខណៈ សហរដ្ឋ អាមេរិក កំពុង បន្ត ការដាក់ សម្ពាធ ទីក្រុង ប៉េកាំង ឲ្យ ធ្វើ ការផ្លាស់ប្តូរ របៀប ធ្វើ ពាណិជ្ជកម្ម ៕
៥៖ អ្នកវិទ្យសាស្រ្ត បាន លើកឡើង មធ្យោបាយ ថ្មី មួយ ដើម្បី ស្វែងរក ជីវិត នៅ ក្រៅ ប្រព័ន្ធ ព្រះអាទិត្យ ខណៈ ដែល មធ្យោបាយ ជា ច្រើន ទៀត ជាពិសេស គឺ ការដំណើរការកែវ យឺត អវកាស កំពុងតែ អនុវត្តន៍ យ៉ាង ខ្លាំងក្លា បំផុត ៕
៦៖ សេតវិមាន បាន ចេញមុខ ទទួលស្គាល់ ថា រដ្ឋាភិបាល ឥណ្ឌា បាន អញ្ចើញ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ឲ្យ ទៅ បំពេញ ទស្សនកិច្ច នៅឯ ប្រជាជាតិ អាស៊ី ខាងត្បូង មួយ នេះ ប៉ុន្តែ ការសម្រេចចិត្ត ចុងក្រោយ ពុំ ទាន់ ត្រូវបាន ធ្វើឡើង នៅឡើយ ទេ ៕ EDC ផ្អាក ផ្គត់ផ្គង់ អគ្គិសនី នៅ តំបន់ ភ្លើង មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ សម្រាប់ ដំឡើង បរិក្ខា ថ្មី ចាប់ពី ថ្ងៃទី ០៣ ដល់ ថ្ងៃទី ០៥ ខែសីហា !
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា បាន ចេញ សេចក្ដីជូនដំណឹង មួយ ប្រកាស ផ្អាក ការផ្គត់ផ្គង់ អគ្គិសនី នៅ តំបន់ ភ្លើង មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៣ - ០៥ ខែសីហា ឆ្នាំ ២០១៨ សម្រាប់ ការងារ ជួសជុល ដំឡើង បរិក្ខារ ៕
( ត្បូងឃ្មុំ ) ៖ ទោះ ស្ថិត នៅក្នុង គ្រា លំបាក ដែល រងគ្រោះ ធម្មជាតិ ដោយ ទឹក ជំនន់ ក្ដី តែ ប្រជាពលរដ្ឋ ដែល រស់ នៅ ស្រុក ត្បូងឃ្មុំ ខេត្ដ ត្បូងឃ្មុំ ក៏ នៅតែ បង្ហាញ ស្នាមញញឹម ដោយ ក្ដីរំភើប ពេល ដែល ពួកគាត់ ទទួលបាន ការ នូវ យកចិត្ដ ដាក់ ខ្ពស់ ពីសំណាក់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ពិសេស សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៨ នេះ ដោយ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន អញ្ជើញ ចុះ មក សួរ សុខទុក្ខ និង ចែក អំណោយ ដោយ ផ្ទាល់ ដល់ ពួកគាត់ ។
សូម ជម្រាប ថា សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក្រៅពី ចុះ សួរសុខទុក្ខ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ក៏ បាន ថ្លែង ទៅកាន់ ប្រជាពលរដ្ឋ នៅ ទីនោះ ថា « គ្រប់ កាលៈទេសៈ យើងខ្ញុំ ទាំងអស់ នឹង រួម សុខ រួម ទុក្ខ ខិតខំ ប្រឹងប្រែង ឲ្យ អស់ ពី លទ្ធភាព ជួយសង្គ្រោះ ពុក ម៉ែ បងប្អូន យើង ទាំងអស់ ឲ្យ មាន ជីវភាព រស់ នៅ ឲ្យ កាន់តែ ប្រសើរ ដោយ មិន ទុក បងប្អូន យើង ម្នាក់ ណា ចោល នោះ ទេ ដូចនេះ បើ មាន ទុក លំបាក អាច ប្រាប់ ដល់ យើងខ្ញុំ ទាំងអស់ គ្នា » ។
ក្នុង ឱកាស នោះ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ក៏ បាន នាំមក នូវ អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា រួម មាន ស្បៀង និង សម្ភារ ដែល បាន មកពី សប្បុរស ជនជាតិ និង អន្តរជាតិ មក ប្រគល់ ជូន ដល់ គ្រួសារ នីមួយ ៗ ដែល ទទួលបាន៖ អង្ករ ៣០ គីឡូក្រាម មី១ កេស ត្រីខ១០ កំប៉ុង មុង១ ភួយ១ សារុង១ ក្រមា១ ។
ជាមួយគ្នា នេះ គ្រួសារ នីមួយ ៗ នៅ ទទួលបាន ក្រណាត់ ស ១ដុំ និង ថវិកា ១ម៉ឺន រៀល ទៀត ជា អំណោយ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ។ ក្រៅពី នោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក៏ បាន ផ្តល់ ជូន សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ត្បូងឃ្មុំ សម្រាប់ ធ្វើ សកម្មភាព ជា បន្តបន្ទាប់ ទៅ តាម តំបន់ គោលដៅ រងគ្រោះ សរុប ចំនួន ១. ០៥៨ គ្រួសារ នូវ ស្បៀង សម្ភារ ប្រើប្រាស់ រួម មាន អង្ករ មី ត្រីខ មុង ភួយ សារុង ក្រមា តង់ និង រទេះ ពិការ ផងដែរ ។
សូម ស្ដាប់ ការលើកឡើង ពី ទឹកចិត្ដ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ជិត ២ពាន់ គ្រួសារ នៅ ស្រុក ត្បូងឃ្មុំ ដូចតទៅ៖ រថយន្ដ ដឹក កម្មករ បើក លឿន ជ្រុល បុក ម៉ូតូ ពីក្រោយ បណ្ដាលឲ្យ ស្លាប់ ម្នាក់ និង របួស ២នាក់ នៅ ស្រុក ជើង ព្រៃ
របាយការណ៍ ដដែល បញ្ជាក់ ថា ករណី នេះ បណ្តាលឲ្យ ស្លាប់ មនុស្ស ម្នាក់ នៅ និង កន្លែង អ្នក រួម ដំណើរ របួស មនុស្ស ០២ នាក់ ខូច ម៉ូតូ និង រថយន្ត ២គ្រឿង មូលហេតុ រថយន្ត ប្រើប្រាស់ ល្បឿន លឿន បណ្តាលឲ្យ ទៅ បុក ម៉ូតូ ពីក្រោយ តែម្តង ហើយ អ្នកបើកបរ រថយន្ត បាន ឃាត់ខ្លួន រួម ជាមួយ វត្ថុតាង ត្រូវបាន យកមក រក្សាទុក នៅ អធិការដ្ឋាន នគរបាល ស្រុក ជើង ព្រៃ ៕ កម្ពុជា - ចិន ចុះហត្ថលេខា លើ ពិធីសារ ស្តីពី លក្ខខណ្ឌ តម្រូវ ភូត គាម អនាម័យ សម្រាប់ ការនាំចេក កម្ពុជា ទៅកាន់ ប្រទេស ចិន
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៨ នេះ កម្ពុជា និង ចិន បាន រៀបចំ ពិធី ចុះហត្ថលេខា លើ ពិធីសារ ស្តីពី លក្ខខណ្ឌ តម្រូវ ភូត គាម អនាម័យ សម្រាប់ ការនាំចេក កម្ពុជា ទៅកាន់ ប្រទេស ចិន ដែល រៀបចំ ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ។
ពិធី នេះ ចុះហត្ថលេខា លោក វេង សាខុន រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង លោក Xiong Bo ឯក អគ្គ រដ្ឋទូត ប្រជាមានិត ចិន ប្រចាំ នៅ កម្ពុជា ក្រោម អធីបតីភាព លោក ហោ ណាំ ហុង ឧប នាយក រដ្ឋមន្រ្តី និង ជា តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ការចុះ ពិធីសារ នេះ គឺជា ការឆ្លើយតប របស់ ភាគី ចិន តាម សំណើ របស់ ភាគី កម្ពុជា តាមរយៈ ក្រុមការងារ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ដែល បាន ចាប់ផ្តើម ចរចា ទីផ្សារ ជាមួយ ភាគី ចិន ឡើងវិញ តាមរយៈ ការ រៀបចំ ផែនការ ការងារ សម្រាប់ រៀបចំ ពិធីសារនាំចេញ ផ្លែ ចេក កម្ពុជា ទៅកាន់ ប្រទេស ចិន និង បាន ឯកភាព គ្នា លើ សេចក្តីព្រាង កាលពី ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៤ កន្លងទៅ នៅ សហភាព មីយ៉ាន់ម៉ា ។
គួរ រំលឹក ថា កាលពី នៅ ថ្ងៃទី ២៥ ដល់ ­ ២៦ ខែមីនា ឆ្នាំ ២០១៨ អតីត អគ្គ រដ្ឋបាល ត្រួតពិនិត្យ គុណភាព អធិការកិច្ច និង ចត្តាឡី ស័ក នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន អញ្ជើញ អ្នកជំនាញ ក្រសួង កសិកម្ម កម្ពុជា ទៅ ចូលរួម កិច្ចប្រជុំ ពិគ្រោះយោបល់ បច្ចេកទេស ដើម្បី បញ្ចប់ សេចក្តីព្រាង ពិធីសារ ស្តីពី តម្រូវការ ភូត គាម អនាម័យ សម្រាប់ ការនាំចេញ ផ្លែ ចេក ស្រស់ កម្ពុជា ទៅកាន់ ប្រទេស ចិន ជាមួយ អតីត អគ្គ រដ្ឋបាល ត្រួតពិនិត្យ គុណភាព អធិការកិច្ច និង ចត្តាឡី ស័ក នៅ ទីក្រុង ប៉េកាំង
ក្នុង កិច្ចប្រជុំ ពិគ្រោះយោបល់ បច្ចេកទេស នោះ ភាគី ទាំង២ បាន សន្យា គ្នា ថា ភាគី ទាំង ពីរ នឹង កំណត់ ពេលវេលា និង កន្លែង សម្រាប់ ចុះហត្ថលេខា ពិធីសារ ខាងលើ នេះ ឲ្យ បាន ឆាប់ រហ័ស តាម ដែល អាច ធ្វើ ទៅ បាន បន្ទាប់ពី ការ ច្របាច់ បញ្ចូល គ្នា រវាង អគ្គ រដ្ឋបាល ត្រួតពិនិត្យ គុណភាព អធិការកិច្ច និង ចត្តាឡី ស័ក ជាមួយ អគ្គ រដ្ឋបាល គយ ចិន និង មាន ថ្នាក់ដឹកនាំ អគ្គ រដ្ឋបាល គយ ថ្មី ។
ជា លទ្ធផល ពិធីសារ មួយចំនួន ត្រូវបាន ចុះហត្ថលេខា រួម មាន៖
១៖ ពិធីសារ ស្តីពី ការនាំ ផលិតផល ដំឡូង មី កម្ពុជា ទៅកាន់ ប្រទេស ចិន រវាង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង អគ្គ រដ្ឋបាល ត្រួតពិនិត្យ គុណភាព អធិការកិច្ច និង ចត្តាឡី ស័ក (AQSIQ) នៃ ប្រទេស ចិន ត្រូវបាន ចុះហត្ថលេខា នៅ ថ្ងៃទី ១៣ ខែធ្នូ ឆ្នាំ ២០១០ ។
២៖ ពិធីសារ ស្តីពី ការនាំ អង្ករ កម្ពុជា ទៅកាន់ ប្រទេស ចិន រវាង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង អគ្គ រដ្ឋបាល ត្រួតពិនិត្យ គុណភាព អធិការកិច្ច និង ចត្តាឡី ស័ក (AQSIQ) នៃ ប្រទេស ចិន ត្រូវបាន ចុះហត្ថលេខា នៅ ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១០ ។
៣៖ ពិធីសារ ស្តីពី ការនាំ អង្ករ ចេញ ទៅកាន់ ប្រទេស ចិន រវាង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង អគ្គ រដ្ឋបាល ត្រួតពិនិត្យ គុណភាព អធិការកិច្ច និង ចត្តាឡី ស័ក (AQSIQ) នៃ ប្រទេស ចិន ត្រូវបាន ចុះហត្ថលេខា នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៦ ។
ជាមួយនឹង លទ្ធផល ដែល ទទួលបាន បន្ថែម នា ថ្ងៃ នេះ ភាគី កម្ពុជា បាន និង កំពុង បន្ត ស្នើសុំ ទៅ ភាគី ចិន ឲ្យ ពិនិត្យ លទ្ធភាព និង ពន្លឿន ការងារ បន្ថែម ក្នុង ការនាំចូល នូវ ផលិតផល កសិកម្ម ចាំបាច់ មួយ ចំនួន ទៀត ទៅកាន់ ទីផ្សារ ចិន ដូច ជា៖ ផ្លែ ស្វាយ ផ្លែ មៀន ( តាង៉ែន ) ផ្លែ ស្រកានាគ ម្រេច ផ្លែ ផូង និង សំបុក ទឹកមាត់ ត្រចៀកកាំ សម្រាប់ ធ្វើការនាំចេញ ទៅ ប្រទេស ចិន ជា បន្ត ទៀត ។
ឃាត់ខ្លួន ជនជាតិ វៀតណាម ៧នាក់ និង រថយន្ត៣ គ្រឿង សង្ស័យ ឆ្លង ដែន ខុស ច្បាប់ នៅ ស្រុក កោះ ញែក ខេត្ត មណ្ឌលគិរី
( មណ្ឌលគិរី ) ៖ ជនជាតិ វៀតណាម ចំនួន ៧នាក់ សង្ស័យ ថា បាន ឆ្លង ដែន ខុស ច្បាប់ ត្រូវបាន ឃាត់ ខ្លូន កាលពី ល្ងាច ថ្ងៃទី១ ខែសីហា ឆ្នាំ ២០១៨ នៅ ស្រុក កោះ ញែក ខេត្ត មណ្ឌលគិរី និង ត្រូវបាន បញ្ជួន មកកាន់ ស្នងការ ខេត្ត ដើម្បី សួរនាំ ។
លោក ឡោ សុខា ស្នងការ នគរបាល ខេត្ត មណ្ឌលគិរី បាន បញ្ជាក់ ឲ្យដឹង ថា ក្រុម ជនជាតិ វៀតណាម ទាំង ៧នាក់ រួមទាំង រថយន្ត ៣គ្រឿង ផង នោះ ក្រោយពេល ជំនាញ ធ្វើ ការសាកសួរ និង ពិនិត្យ ឃើញ ថា ឆ្លង ដែន ចូលមក ក្នុង ទឹកដី កម្ពុជា គ្មាន ឯកសារ ត្រឹមត្រូវ ។ លោក ស្នងការបាន បន្ត ថា បន្ទាប់ពី ជំនាញ បន្ត នីតិវិធី ចប់ សព្វគ្រប់ ហើយ នោះ ជនសង្ស័យ នឹង ត្រូវ ធ្វើ ការឆ្លង យោបល់ ខាង អយ្យកាបន្ត ទៀត ។
លោក បន្ត ថា ជាក់ស្តែង ដូចជា ករណី ស្តីពី ជនជាតិ វៀតណាម ចំនួន ០៧ នាក់ រួមទាំង មធ្យោបាយ ផង នោះ ត្រូវបាន សមត្ថកិច្ច កម្ពុជា ធ្វើ ការឃាត់ខ្លួន ប៉ុន្តែ ជុំវិញ ករណី នេះ ក្រោយពេល តំណាង អយ្យកាបន្ត នីតិវិធី របស់ ខ្លួន បើ ពិនិត្យ ឃើញ ថា មាន កំហុស ធ្ងន់ធ្ងរ ច្បាប់ ត្រូវតែ អនុវត្តន៍ ជាធរមាន ។
បើ តាម ព្រះរាជអាជ្ញា រូប នេះ បើសិនជា ក្នុង ករណី ខុស តិចតួច គួរតែ មន្រ្តី ជំនាញ ខាង ច្បាប់ អន្តោប្រវេសន៍ ធ្វើ ការអប់រំ ណែនាំ តាម ផ្លូវ ច្បាប់ ឬ ធ្វើ ការបញ្ជូន ពួកគេ ទៅកាន់ ទៅ ប្រទេស កំណើត គេ វិញ ៕ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត រតនគិរី អរគុណ ចំពោះ សាខា បក្ស និង ប្រជាពលរដ្ឋ ដែល បាន បោះឆ្នោត ជូន បក្ស ប្រជាជន ដើម្បី បន្ត សន្តិភាព និង ការអភិវឌ្ឍ
លិខិត ថ្លែងអំណរគុណ ដែល អង្គភាព Fresh News ទទួលបាន នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៨ នេះ លោក ថង សាវុន បាន បញ្ជាក់ ថា លទ្ធផល ដែល ទទួលបាន មកពី ការខិតខំ ប្រឹងប្រែង ការរួបរួម សាមគ្គី ឯកភាព គ្នា ជា ធ្លុង មួយ រួម សហការទទួលខុសត្រូវ ស្មារតី ម្ចាស់ ការរៀង ខ្លួន គឺជា ប្រពៃណី វប្បធម៌ និង ជា ចំណុច ខ្លាំង របស់ កណបក្ស ប្រជាជន កម្ពុជា តាំងពី ដើម រៀង មក ។
ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត រតនគិរី បាន បន្ថែម ថា លទ្ធផល នៃ កម្លាំង សាមគ្គី ដ៏ ធំធេង នេះ បាន នាំមក នូវ ជ័យជម្នះ ដ៏ ច្រើន លើសលុប លើ គណបក្ស នយោបាយ ដែល បាន ចូលរួម ប្រកួតប្រជែង នៅក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ នេះ គួរ ជា ទី មោទនៈ ។
លោក ថង សាវុន ក៏ បាន គូសបញ្ជាក់ ថា ជ័យជម្នះ នេះ គឺ ពិតជា បាន មក ពី ការចូលរួម របស់ សមាជិក សមាជិកា គណបក្ស ខេត្ត ទាំងអស់ មិន អាច កាត់ផ្ដាច់ បាន និង បាន ឆ្លុះបញ្ចាំង កាន់តែ ច្បាស់ ពី ស្មារតី រួបរួម សាមគ្គី របស់ សមាជិក សមាជិកា សាខា គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ទាំងអស់ ហើយក៏ ជា ជ័យជម្នះ រួម របស់ សាម ជិក គនបក្ស ប្រជាជន កម្ពុជា និង ប្រជាជន កម្ពុជា ទាំងមូល ។
ជាមួយគ្នា នេះ លោក ថង សាវុន ក៏ បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ ដល់ លោក ទេសរដ្ឋមន្ដ្រី លី ធុជ អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ដ រតនគិរី ដែល កន្លងមក បាន យក អស់ កម្លាំង កាយ ចិត្ត ប្រាជ្ញា សា្មរតី នៅក្នុង បុព្វហេតុ គណបក្ស ប្រជាជន កម្ពុជា សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៦ ដែល បាន កន្លងផុត ទៅ ថ្មី ៗ នេះ ៕
អគ្គ នាយកដ្ឋាន ពន្ធ ចេញ សេចក្តី បំភ្លឺ ទាត់ ចោល ទាំងស្រុង ចំពោះ ការចុះផ្សាយ របស់ វិទ្យុ អាស៊ី សេរី ដែល ថា អគ្គ នាយកដ្ឋាន ពន្ធដារ ប្តឹង ទៅ ACU ករណី ប្រធាន សមាគម អាដហុក គេចវេះ បង់ ពន្ធ ថ្លៃ ឈ្នូល ផ្ទះ ជូន រដ្ឋ
នេះ បើ តាម សេចក្តី បំភ្លឺ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទើប ទទួលបាន នៅ រសៀល ថ្ងៃទី ០២ ខែកក្កដា នេះ បាន ចាត់ទុក ថា ការចុះផ្សាយ ព័ត៌មាន របស់ វិទ្យុ អាស៊ី សេរី នេះ ជា ការចុះផ្សាយ ព័ត៌មាន ចចាមអារាម គ្មាន មូលដ្ឋាន ច្បាស់លាស់ ក្នុង ន័យ ធ្វើឲ្យ សាធារណជន មាន ការភាន់ច្រឡំ និង ចោទប្រកាន់ ទម្លាក់ កំហុស មក លើ ស្ថាប័ន រដ្ឋ និង ថ្នាក់ដឹកនាំ ។
ព័ត៌មាន លម្អិត សូម អាន សេចក្តី បំភ្លឺ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ទាំង ស្រុង៖
ថ្លែង ក្នុង ឱកាស ចុះ ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី ជាង ១ម៉ឺន នាក់ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ទៀត ថា « មុន បោះឆ្នោត ដី នៅតែ ឡើង ថ្លៃ អ្នក ខ្លះ ជំរុញ ឲ្យ ទិញ ដី ឲ្យ ហើយ ព្រោះថា បើ មិន ទិញ ពេលនេះ ទេ បោះឆ្នោត រួច នៅ បន្ដ ឡើង ថ្លៃ ទៀត ហើយ ។ ចឹង ហើយ បានជា ប្រាក់ ចំណូល របស់ អគ្គ នាយកដ្ឋា ពន្ធដារ ក្នុង ពេល យុទ្ធនាការ បោះឆ្នោត អត់ មាន ការថយចុះ អី ទាំងអស់ » ។
ស្ថិរភាព នៃ តម្លៃ ដី នេះ សបញ្ជាក់ ពី ស្ថានភាពរឹងមាំ របស់ កម្ពុជា ដោយ មិន បាន បង្ករ ការភ័យខ្លាច ទៅ លើ អ្វី ទាំងអស់ ទោះបី ស្ថិត ក្នុង ពេល បោះឆ្នោត ក្ដី ។
សម្តេច តេជោ ហ៊ុន សែន បាន បន្ថែម ថា មិន ត្រឹមតែ ស្ថានភាព វិស័យ ដីធ្លី ប៉ុណ្ណោះ ទេ ដែល នៅតែ ដំណើរការ ល្អ សូម្បីតែ ការប្រកបរបរ រកស៊ី ប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ ក៏ មាន ស្ថានភាព ល្អ ផងដែរ មិន ដូច កាលពី បោះឆ្នោត អាណត្តិ មុន នោះ ឡើយ ដោយសារ បាត់ វត្តមាន របស់ អតីត គណបក្ស សង្គ្រោះ ជាតិ ។
សូម បញ្ជាក់ ថា នៅ មុនពេល បោះឆ្នោត ជាតី ទាំង សម្ដេច តេជោ ហ៊ុន សែន និង អ្នកជំនាញ វិស័យ អចលន ទ្រព្យ ធ្លាប់ បាន អះអាង ថា ឆ្នាំ នេះ ទោះ ស្ថិត ក្នុង ឆ្នាំ បោះឆ្នោត ក្ដី ក៏ វិស័យ ដីធ្លី មិន មាន ការប្រែប្រួល អ្វី ឡើយ មាន ន័យ ថា តម្លៃ ដីធ្លី នៅតែ បន្ត កើតឡើង ទៅ មុខ ជា បន្ដ បន្ទាប់ ដោយសារតែ ប្រជាពលរដ្ឋ ជឿជាក់ លើ ការដឹកនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា និង ជឿជាក់ ថា គណបក្ស ប្រជាជន កម្ពុជា នៅតែ ដឹកនាំ ប្រទេស ។
ជាមួយគ្នា នេះ បើ ក្រឡែក ទៅ មើល គម្រោង វិនិយោគ នៅ ឆ្នាំ បោះឆ្នោត វិញ គឺ នៅតែ មាន អ្នក វិនិយោគ ច្រើន មក បណ្តាក់ទុន វិនិយោគ នៅ កម្ពុជា ។ ជាក់ស្តែង នៅ ពាក់កណ្តាល ឆ្នាំ ២០១៨ នេះ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា (CDC) បាន អនុម័ត គម្រោង វិនិយោគ សរុប ចំនួន ១០៦ គម្រោង ដែល ក្នុង នោះ មាន គម្រោង ថ្មី ចំនួន ៩៧ និង គម្រោង ពង្រីក ផលិតកម្ម ចំនួន ០៩ ។
ទុន វិនិយោគ សរុប នៃ គម្រោង ដែល ត្រូវបាន អនុម័ត ទាំងនេះ មាន ចំនួន ប្រមាណ ៣.៥០០ លាន ដុល្លារ អាមេរិក ដែល បង្កើត ការងារ បាន ប្រមាណ ជិត ១០ម៉ឺន កន្លែង ។ តួលេខ វិនិយោគ នេះ បាន បង្ហាញ ឱ្យ ឃើញ នូវ និន្នាការ នៃ ការវិនិយោគ ដែល មាន ការកើនឡើង នៅក្នុង ឆមាស ទី១ ឆ្នាំ ២០១៨ នេះ ដោយ មិន មាន សញ្ញា នៃ ការរារែក ឬ ការបង្អែរបង្អង់ ក្នុង ការបណ្តាក់ទុន វិនិយោគ ឡើយ ៕
បើ ទោះបីជា ដឹង លទ្ធផល សំឡេង ឆ្នោត ក៏ដោយ ប៉ុន្តែ រហូតដល់ ពេលនេះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នៅ មិន ទាន់ បង្ហាញ អំពី ចំនួន បឋម ឬ ផ្លូវការ នៃ ចំនួន អាសនៈ ដែល គណបក្ស នីមួយ ៗ ទទួលបាន នៅឡើយ ទេ ដោយ ទុក ពេល ធ្វើ ការគណនា តាម រូបមន្ត ដែល កំណត់ ដោយ ច្បាប់ ហើយ សន្យា ប្រកាស លទ្ធផល បណ្តោះអាសន្ន នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៨ និង ប្រកាស ជា ផ្លូវការ នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០១៨ ប្រសិន ណា បើ ពុំ មាន ពាក្យបណ្តឹង តវ៉ា ចំពោះ ការបោះឆ្នោត ទេ នោះ ។
ឧទាហរណ៍ ដូចជា បើ នៅក្នុង មណ្ឌល រាជធានី ភ្នំពេញ មាន អាសនៈ សរុប ចំនួន ១២ ហើយ សន្លឹក បាន ការ ក្រោយ ការបោះឆ្នោត មាន ចំនួន ៥៨៩. ០២៧ នោះ តម្លៃ ឬ កូតា នៃ សន្លឹក ឆ្នោត ក្នុង ១ អាសនៈ សម្រាប់ រាជធានី ភ្នំពេញ គឺ ស្មើនឹង ៥៨៩. ០២៧ ចែក នឹង ១២ ដែល ស្មើនឹង មាន ចំនួន ៤៩. ០៨៥ ។ ដូច្នេះ តម្លៃ ឬ កូតា សន្លឹក ឆ្នោត ក្នុង ១ អាសនៈ សម្រាប់ មណ្ឌល រាជធានី ភ្នំពេញ នៅ ជុំ ទី១ គឺ ៤៩. ០៨៥ សំឡេង ។
* សម្រាប់ មណ្ឌល ផ្សេង ទៀត គឺ អនុវត្ត ជា បន្តបន្ទាប់ ដូចគ្នា ៕
ជូនដំណឹង ! អាជ្ញាធរ មីន ជូនដំណឹង ដល់ អ្នកប្រើប្រាស់ រថយន្ដ របស់ អង្គភាព ដោយ មិន មាន ការអនុញ្ញាត ត្រូវ ប្រគល់ រថយន្ដ និង ឯកសារ មកវិញ យ៉ាង យូរ តឹ្រម ថ្ងៃទី ១០ សីហា
អាជ្ញាធរ មីន បាន សង្កត់ធ្ងន់ ថា ផុត កាល កំណត់ នេះ អាជ្ញាធរ មីន នឹង ចាត់ វិធានការ តឹងរឹង ជា បន្ដ បន្ទាប់ ពុំ មាន ការលើកលែង ឡើយ ដោយ ប្រកាស ជាសាធារណៈ តាម សារព័ត៌មាន វិទ្យុ ឬ ទូរទស្សន៍ ដោយ បញ្ចេញ ឈ្មោះ និង តួនាទី បុគ្គល ដែល កំពុង ប្រើប្រាស់ រថយន្ដ និង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ដោយ ដាក់ បណ្ដឹង ទៅ គ្រប់ ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល ឲ្យ ឃាត់ រថយន្ដ ទុក និង ចុងក្រោយ រៀបចំ សំណុំរឿង ដាក់ បណ្ដឹង ទៅ តុលាការ និង អង្គភាព ប្រឆាំង អំពើពុករលួយ ៕
រដ្ឋមន្រ្តី ការបរទេស ចិន អបអរសាទរ ចំពោះ ជោគជ័យ នៃ ការបោះឆ្នោត ជាតិ នៅក្នុង ប្រទេស កម្ពុជា
( ភ្នំពេញ ) ៖ លោក វ៉ាង យី រដ្ឋមន្រ្តី ក្រសួង ការបរទេស ចិន បាន ចូលរួម អបអរសាទរ ចំពោះ ជោគជ័យ នៃ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី ០៦ នៅក្នុង ប្រទេស កម្ពុជា ។
ការអបអរសាទរ នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក រដ្ឋមន្រ្តី ក្រសួង ការបរទេស ចិន ជួប ពិភាក្សា ទ្វេ ភាគី ជាមួយ លោក ទេសរដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ក្រសួង ការបរទេស កម្ពុជា នៅ ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០១៨ ។
បន្ទាប់ពី បញ្ចប់ ជំនួប រវាង រដ្ឋមន្រ្តី ទាំង ពីរ នៅ ក្រៅ វេទិកា កិច្ចប្រជុំ អាស៊ាន ដែល ប្រព្រឹត្តទៅ ក្នុង ប្រទេស សិង្ហបុរី ក្រសួង ការបរទេស ចិន បាន ចេញ សេចក្តីថ្លែងការណ៍ ឲ្យដឹង ថា ប្រមុខ ការទូត និង ជា ទីប្រឹក្សា រដ្ឋ ចិន លោក វ៉ាង យី ក៏ បាន ផ្តល់ ការអបអរសាទរ ផងដែរ ចំពោះ ការបោះឆ្នោត នៅ កម្ពុជា ដែល បាន ដំណើរការ ទៅ យ៉ាង រលូន បំផុត ។
ជាមួយគ្នា នេះ លោក ក វ៉ាង យី បាន លើកឡើង ថា លទ្ធផល នៃ ការបោះឆ្នោត បាន សបញ្ជាក់ ឲ្យ ឃើញ យ៉ាង ច្បាស់ ពី ការគាំទ្រ ជឿ ទុកចិត្ត របស់ ប្រជាជន កម្ពុជា ចំពោះ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។ លោក វ៉ាង ក៏ បាន បន្ត ថា ចិន នឹង នៅតែ បន្ត ផ្តល់ ការជួយជ្រោមជ្រែង ថែម ទៀត ដល់ កម្ពុជា ដើម្បី ថែរក្សា ស្ថិរភាព និង អភិវឌ្ឍន៍ តទៅ មុខ ទៀត ។
លោក ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ លោក វ៉ាង យី ហើយ បាន លើកឡើង ថា ការបោះឆ្នោត កាលពី ថ្ងៃទី ២៩ ខែកក្កដា កន្លងទៅ នេះ បាន ប្រព្រឹត្តទៅ ដោយ មាន សណ្តាប់ធ្នាប់ និង ប្រកបដោយ តម្លាភាព ហើយ ប្រជាជន កម្ពុជា បាន បោះឆ្នោត ឲ្យ សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ជាតិ ៕
( ភ្នំពេញ ) ៖ ករណី មន្ដ្រី នគរបាល ពាក់ ស័ក្ដិ៤ កន្លះ បម្រើការ នៅ អគ្គ នាយកដ្ឋាន ភ័ស្ដុភារ និង ហិរញ្ញវត្ថុ ក្រសួង មហាផ្ទៃ ប្រើប្រាស់ កាំភ្លើង ខ្លី បាញ់ សម្លាប់ ខ្លួន ឯង ក្នុង បន្ទប់ លេខ ២០៩ នៃ សណ្ឋាគារ និង ខារ៉ាអូខេ « កូឡូ សូ» ក្នុង សង្កាត់ បឹងកេងកង ទី៣ ខណ្ឌ ចំការ មន ដែល បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល នៅ រសៀល ថ្ងៃទី ០១ ខែសីហា ឆ្នាំ ២០១៨ គឺ បណ្ដាល មកពី មាន វិបត្តិ ផ្ទាល់ខ្លួន ។
បើ តាម ក្រុមគ្រួសារ របស់ ជនរងគ្រោះ បាន ឲ្យដឹង នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០១៨ នេះ ថា ជនរងគ្រោះ ឈ្មោះ ម៉ុន រតនៈ ឧត្តម អាយុ ២៦ ឆ្នាំ ជា មន្ត្រី នគរបាល ពាក់ ស័ក្តិ៤ កន្លះ ស្នាក់ នៅ សង្កាត់ បឹង ទំពុន២ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ទីកន្លែង កំណើត នៅ ភូមិ គោក ស្វាយ ឃុំ ប្ញស្សី ក្រោក ស្រុក អង្គរ បុរី ខេត្ត បន្ទាយមានជ័យ បាន ចាកចេញ ពី ផ្ទះ ប្រហែល២ - ៣ ថ្ងៃ មក ហើយ រហូតដល់ កើត ករណី បាញ់ សម្លាប់ ខ្លួន ឯង នេះ តែម្ដង ។
ជាមួយគ្នា នេះ មន្ដ្រី នគរបាល មូលដ្ឋាន ដែល បាន ចុះ ទៅ ស្រាវជ្រាវ និង ស៊ើបអង្កេត យ៉ាង យកចិត្តទុកដាក់ បាន បញ្ជាក់ ថា ជនរងគ្រោះ ពិតជា បាន បាញ់ សម្លាប់ ខ្លួន ឯង ប្រាកដ មែន ដោយ ប្រើប្រាស់ កាំភ្លើង ខ្លី ម៉ាក កា៥៤ និង បាញ់ ចំសៀតផ្កា ខាងស្តាំ ធ្លាយ ចេញមក ក្រៅ បណ្ដាលឲ្យ ស្លាប់ នៅលើ គ្រែ ។
បើ មាន មន្ដ្រី នគរបាល ជនរងគ្រោះ បាន បើក បន្ទប់ ស្នាក់ នៅក្នុង សណ្ឋាគារ តាំងពី ថ្ងៃទី ៣១ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ ហើយ រូប គេ បាន ហៅ សង្សា មក ជួប ជា លើក ចុងក្រោយ លុះ រហូតដល់ រសៀល ថ្ងៃទី ០១ ខែសីហា ម្សិលមិញ ក៏ កើតមាន ករណី បាញ់ សម្លាប់ ខ្លួន ឯង តែម្ដង ដោយ ជំហ៊ាន ដំបូង និង មាន ការបំភ្លឺ ពី ក្រុមគ្រួសារ នោះ សមត្ថកិច្ច ជំនាញ អាច សន្និដ្ឋាន បាន ថា ជនរងគ្រោះ មាន វិបត្តិ ផ្ទាល់ខ្លួន ទើប សម្រេចចិត្ត ធ្វើ អត្តឃាត ខ្លួន ឯង បែប នេះ ។
យ៉ាងណាមិញ បើ តាម ការបំភ្លឺ ពី បុគ្គលិក ខារ៉ាអូខេ បន្ទាប់ បើក បន្ទប់ ចូល ស្នាក់ នៅ គេ មិន ឃើញ ជនរងគ្រោះ ចេញមក រក បាយ ទឹក នោះ ទេ ទើប បុគ្គលិក ក៏ បាន ឡើង ទៅ គោះ ទ្វារ បន្ទប់ យ៉ាង យូរ នៅតែ មិន បើក ទ្វារ ក៏ សម្រេចចិត្ត គាស់ គន្លឹះ ទ្វារ តែម្តង ភ្លាម ៗ នោះ ក៏ ប្រទះឃើញ ជនរងគ្រោះ បាន ដេក ស្លាប់ នៅក្នុង បន្ទប់ មិន ដឹង ស្លាប់ តាំងពី ពេលណា នោះ ទេ រួច ក៏ ប្តឹង សមត្ថកិច្ច ដើម្បី ចុះ មក ត្រួតពិនិត្យ នៅ កន្លែង កើត ហេតុ ភ្លាម ៗ តែម្តង ៕
មេបញ្ជាការ អាវុធហត្ថ ខេត្ត កំពង់ស្ពឹ អញ្ជើញ សួរសុខទុក្ខ និង នាំ ថវិកា មូលនិធិ មហា គ្រួសារ ជូន លោក វរសេនីយ៍ ត្រី ព្រឿង វ៉ៃ អនុប្រធាន មន្ទីរ បច្ចេកទេស សន្តិសុខ
( កំពង់ស្ពឺ ) ៖ ក្រុម ប្រតិភូ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ២ ខែសីហា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ទៅ សាកសួរ សុខទុក្ខ លោក វរសេនីយ៍ ត្រី ព្រឿង វ៉ៃ អនុប្រធាន មន្ទីរ បច្ចេកទេស សន្តិសុខ និង បាន នាំ ថវិការ របស់ មូលនិធិ មហា គ្រួសារ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ ចំនួន ៣.៣៧៩.០០០ រៀល ដែល កំពុង សម្រាក ព្យាបាល ជម្ងឺ នៅ ផ្ទះ ។
លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន បាន លើកឡើង ថា ទឹកប្រាក់ ជិត ៤លាន រៀល នេះ បាន មកពី កម្លាំង មនុស្សធម៌ នៃ មូលនិធិ មហា គ្រួសារ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ ទាំងអស់ គ្នា ហើយ ជានិច្ច ជាកាល បើ មាន អាវុធហត្ថ យើង ជួប ការលំបាក ឬ មាន ជម្ងឺ ត្រូវ ព្យាបាល និង សង្គ្រោះ បន្ទាន់ កម្លាំង អាវុធហត្ថ បាន សហការ គ្នា ដោយ ទឹកចិត្ត ជ្រះថ្លា បរិច្ចាគ ថវិកា ម្នាក់ បន្តិច រួមគ្នា ឧបត្ថម្ភ ដោយ គ្រួសារ ដើម្បី ដោះស្រាយ បន្ទាន់ ចំពោះ អ្នក ជម្ងឺ ។
លោក ឧត្តមសេនីយ៍ ត្រី មេបញ្ជាការ បាន បន្ត ថា ជាក់ស្តែង ថ្ងៃ នេះ ក៏ ដូចជា កន្លងមក ដោយ ទទួលបាន លោក វរសេនីយ៍ ត្រី ព្រឿង វ៉ៃ មាន ជម្ងឺ ប្រចាំ កាយ ទើប លោក បាន ដោះស្រាយ បន្ទាន់ ដល់ ក្រុមគ្រួសារ ហើយនិង បន្ត ដោះស្រាយ ជូន ក្នុង ករណី ដែល មិន ទាន់ បាន ជាសះស្បើយ ។
