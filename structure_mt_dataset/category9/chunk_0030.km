( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៨ ស្អែក នេះ ក្រុមហ៊ុន ធំ ៗ ទាំង១០ នឹង ប្រកាស ជ្រើសរើស បុគ្គលិក ជា បន្ទាន់ ចំនួន ១. ២៤៥ កន្លែង ដោយ សហការ ជាមួយ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
លោកស្រី សំអុល ចរិយា មន្ត្រី គ្រប់គ្រង ធនធាន មនុស្ស ជាន់ ខ្ពស់ របស់ ក្រុមហ៊ុន RMA បាន ចាត់ទុក សេវា ជួយ ស្វែងរក ការងារ ធ្វើ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ គឺ ពិតជា ល្អ ណាស់ ដោយ បាន ចូលរួម កាត់បន្ថយ អត្រា អត់ ការងារ ធ្វើ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ។
លោកស្រី បាន ឲ្យដឹង ថា សម្រាប់ ថ្ងៃទី ២៤ ខាងមុខ នេះ ក្រុមហ៊ុន ត្រូវការជ្រើសរសើស បុគ្គលិក ជាច្រើន រូប ហើយ ជាច្រើន មុខ ដំណែង ដូចនេះ លោកស្រី លើកទឹកចិត្ត ឲ្យ អ្នក ស្វែងរក ការងារ ធ្វើ ចូលរួម ក្នុង កិច្ចសម្ភាស ការងារ ប្រចាំ ខែ របស់ NEA ឲ្យបាន ច្រើន កុះករ ។ ជាមួយគ្នា នោះ លោក ស្រី បាន ថ្លែងអំណរគុណ ចំពោះ NEA ដែល បាន ផ្តល់ ភាពងាយស្រួល ដល់ ក្រុមហ៊ុន ក្នុង ការសម្រប់ សម្រួល និង ផ្តល់ ទីតាំង ដល់ ក្រុមហ៊ុន របស់ លោកស្រី ក៏ ដូចជា ក្រុមហ៊ុន ផ្សេង ៗ ទៀត ក្នុង ការរៀបចំ វេទិកា ការងារ ផ្សេង ៗ ។
សូម ជម្រាប ថា ក្នុង ដំណើរ ប្រតិបត្តិការ ជួយ ស្វែងរក ការងារ ធ្វើ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ក្នុង ឆមាស ទី១ ឆ្នាំ ២០១៨ NEA បាន ជួយ ស្វែងរក ការងារ ធ្វើ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ បាន ប្រមាណ ៣. ២៥១ នាក់ ចុះឈ្មោះ អ្នក ស្វែងរក ការងារ ធ្វើ បាន ប្រមាណ ៧. ៥៩០ នាក់ រៀបចំ វេទិកា ការងារ បាន ចំនួន ៤២ ដង ។
នេះ គឺជា ល្បិច ដ៏ ស្មោគ គ្រោក បំផុត របស់ សម រង្ស៊ី ! តាមពិត សម រង្ស៊ី មិន ហ៊ាន វិលត្រឡប់មក កម្ពុជា វិញ ឡើយ ព្រោះ សម រង្ស៊ី ជា មនុស្ស ខ្លាច គុក ច្រវ៉ាក់ ប៉ុន្តែ មិន រាងចាល នឹង ការប្រព្រឹត្ត នូវ ទង្វើ ល្មើស ច្បាប់ និង កាញុះញង់ ប្រជាពលរដ្ឋ ។ នៅ ពេល នេះ សម រង្ស៊ី គ្រាន់តែ ជា ទណ្ឌិត ម្នាក់ ដែល មាន ទោស រាប់ សិប ឆ្នាំ នៅ ជាប់ ខ្លួន ហើយ ខ្នោះ និង គុក បាន និង កំពុងតែ រង់ចាំ វត្តមាន របស់ សម រង្ស៊ី នៅ កម្ពុជា គ្រប់ ពេលវេលា ទាំងអស់ ។
ទណ្ឌិត សម រង្ស៊ី ជា មនុស្ស មហាកំសាក ហើយ កន្លងមក គឺ គ្មាន ម្តង ណា ឡើយ ដែល មាន ភាពក្លាហាន វិលត្រឡប់ ចូលមក ក្នុង ប្រទេស ដើម្បី មក ប្រឈមមុខ នឹង ច្បាប់ ឡើយ ខណៈ អ្នកនយោបាយ អង្ករ កំប៉ុង និង កំសាក ញី រូប នេះ កំពុង បន្ត សោយ សុខ ក្នុង ជីវិត ហ៊ឺហារ របស់ ខ្លួន នៅ ក្រៅ ប្រទេស ហើយ ខ្លាច បំផុត រឿង ជាប់ គុក ។ សូម្បី ប្រព័ន្ធ របស់ គាត់ ជូឡុង សូមួរ៉ា ដែល គេ ដឹង ថា ជា ខ្លាញី កំណាច និង ជា អ្នក មាន ឥទ្ធិពល ក្នុង ក្រុម អ្នកនយោបាយ រត់ ចោល ស្រុក ក៏ នឹង មិន អនុញ្ញាតឱ្យ ស្វាមី របស់ ខ្លួន វិល មក ស្រុក ចូល គុក ដែរ ។
( ព្រះសីហនុ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន បញ្ជាក់ ឲ្យដឹង ថា មកដល់ ម៉ោង ៧៖៣០ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ទឹក ជំនន់ ហូរ កាត់ ផ្លូវ ជាតិ លេខ ៤ ត្រង់ ចំណុច ស្ពាន អូរ គគី ( ចន្លោះ គីឡូម៉ែត្រ លេខ ១០៦ - ១០៧ ) ភូមិ ស្ទឹង ច្រាល ឃុំ អូរ បាក់ រទេះ ស្រុក កំពង់សីលា ខេត្ត ព្រះសីហនុ បាន ស្រកចុះ អស់ វិញ ហើយ ។ ការធ្វើចរាចរ ឆ្លងកាត់ ក៏ ត្រូវបាន អាជ្ញាធរ បើកឲ្យ ដំណើរការជា ប្រក្រតី ឡើងវិញ ដែរ ។
សូម ជម្រាប ថា នៅ ព្រឹក ព្រលឹម ថ្ងៃ នេះ អាជ្ញាធរ បាន សម្រេច ឲ្យ ផ្អាក ការធ្វើចរាចរ ឆ្លងកាត់ លើ ផ្លូវ ជាតិ លេខ ៤ ត្រង់ ចំណុច ស្ពាន អូរ គគីរ បន្ទាប់ពី មាន ទឹក ជំនន់ ហូរ កាត់ ផ្លូវ និង ស្ពាន ។ ប៉ុន្តែ រយៈពេល ប៉ុន្មាន ម៉ោង ក្រោយមក ទឹក ក៏ បាន ស្រកចុះ អាជ្ញាធរ ក៏ សម្រេច ឲ្យ ធ្វើចរាចរ ឡើងវិញ ៕
ប្រជាពលរដ្ឋ ភ្ញៀវ ជាតិ និង អន្តរជាតិ ដែល មាន បំណង ចង់ ធ្វើដំណើរ ទៅ ខេត្ត ព្រះសីហនុ សូម វាង តាម ផ្លូវ ជាតិ លេខ ៤១ និង ឆ្ពោះទៅ ផ្លូវ ជាតិ លេខ ៣ ដោយសារតែ កំណាត់ ផ្លូវ ជាតិ លេខ ៤ នៅ បន្ត បិទ ចរាចរណ៍ ជា បណ្តោះអាសន្ន នៅឡើយ ដោយសារតែ ទឹក នៅ បន្ត ជន់ លិច ៕
សូម កុំ បើកបរ ស្ថិត ក្រោម ស្ថានភាព ស្រវឹង ! ស្លាប់ ៣នាក់ និង រងរបួស ម្នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២២ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ចំនួន ៣នាក់ និង របួស ម្នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៥លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៣គ្រឿង រថយន្ត តូច៣ គ្រឿង និង រថយន្ដ ធុន ធំ ៤គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . ប្រជែង . កត្តា យានយន្ត និង ស្រវឹង ។
( កំពង់ធំ )៖ ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក បារាយណ៍ លោក ថោង ខុន នា ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ បាន ជួប ជាមួយ សមាជិក - សមាជិកា បក្ស នៅ ឃុំ ច្រនាង ១០០០ នាក់ និង បន្ត ជួប អាជីវករ នៅ ផ្សារ តាំង គោក ស្រុក បារាយណ៍ ។ លោក ថោង ខុន ក៏ បាន រំឭក ពី ស្នាដៃ កសាង សមិទ្ធផល ជាច្រើន របស់ សម្ដេច តេជោ ហ៊ុន សែន និង ថ្នាក់ដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដទៃ ទៀត បាន និង កំពុង បន្ត យកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ ឱ្យ ទទួលបាន សន្តិភាព ការអភិវឌ្ឍ និង ជួយ ទំនុកបម្រុង សេវា គាំពារ ជាច្រើន ទៀត ។
នគរបាល ប៉ុស្តិ៍ ផ្សារ ដើម គរ ម្នាក់ ត្រូវបាន ជនល្មើស កាប់ ឲ្យ រងរបួស យ៉ាង ទម្ងន់ ពេល ចុះ បំពេញ ភារកិច្ច . សាច់ញាតិ ជនរងគ្រោះ ស្នើឲ្យ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ជួយ សម្រួល ចេញ លិខិត ឆ្លង ដែន ដើម្បី យក ទៅ សង្គ្រោះ បន្ទាន់ នៅ ថៃ
( ភ្នំពេញ ) ៖ លោក ឃិន ទិត្យ មន្ត្រី នគរបាល ប៉ុស្តិ៍ រដ្ឋបាល ផ្សារ ដើម គរ ត្រូវ ជនល្មើស កាប់ ឲ្យ រងរបួស យ៉ាង ធ្ងន់ធ្ងរ ក្នុង ពេល បំពេញ ការងារ ចុះ ទៅ សាកសួរ ជន ប្រព្រឹត្ត បទល្មើស តាម ពាក្យបណ្តឹង របស់ អ្នក រត់ ម៉ូតូ កង់ បី ដែល កើត ជម្លោះ ជាមួយ ម្ចាស់ ស្តង់ លក់ ផ្លែ ឈើ នៅ ផ្សារ នាគ មាស ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
អ្នកនាំពាក្យ CPP ៖ ជន បរទេស គ្មាន សិទ្ធិ មក រំលោភ ឯករាជ្យ និង អធិបតេយ្យភាព កម្ពុជា ដាច់ខាត
( ភ្នំពេញ ) ៖ លោក សុខ ឥសាន អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃ ២២ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន លើកឡើង ថា ជន បរទេស គ្មាន សិទ្ធិ មក រំលោភ ឯករាជ្យ និង អធិបតេយ្យភាព កម្ពុជា ដាច់ខាត ហើយ ការិះគន់ ទាំងឡាយ មក លើ កម្ពុជា គ្រាន់តែ ជា ការបញ្ចេញមតិ តែ ប៉ុណ្ណោះ ។
ការលើកឡើង របស់ អ្នកនាំពាក្យ គណបក្ស កាន់អំណាច បាន ធ្វើឡើង បន្ទាប់ពី មាន ការប្រឌិត វាយប្រហារ ដោយ ជន បរទេស មួយចំនួន មក លើ រាជ រដ្ឋាភិបាល កម្ពុជា ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ជា បន្តបន្ទាប់ គ្រា ដែល កម្ពុជា កំពុង រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ អាណត្តិ ទី ០៦ ដើម្បី ជ្រើសរើស មេដឹកនាំ ។
លោក សុខ ឥសាន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « បណ្តា ជន បរទេស គ្មាន សិទ្ធិ អ្វី មក រំលោភ ឯករាជ្យ និង អធិបតេយ្យភាព កម្ពុជា ជាដាច់ខាត ។ ការនិយាយ ទាំងឡាយ គ្រាន់តែ អាច ចាត់ទុក ជា ការបញ្ចេញមតិ និង ទស្សនៈ ឯកជន ឬ ក្រុម តែ ប៉ុណ្ណោះ មិន មាន ប្រសិទ្ធភាព មក គ្របដណ្តប់ លើ ឯករាជ្យ និអធិបតេយ្យភាព កម្ពុជា បាន ឡើយ » ។
អ្នកជំនាញ អប់រំ របស់ អាមេរិក ២រូប នឹង មក ផ្សព្វផ្សាយ អូសទាញ និស្សិត កម្ពុជា ឲ្យ ទៅ សិក្សា នៅ សហរដ្ឋ អាមេរិក
( កំពង់ចាម ) ៖ អ្នកជំនាញ អប់រំ របស់ អាមេរិក ២រូប នឹង មក ប្រទេស កម្ពុជា លើក បង្ហាញ ពី សក្តានុពល សិក្សា នៅ សហរដ្ឋ អាមេរិក ក្នុង បំណង បញ្ចុះបញ្ចូល អូសទាញ និស្សិត កម្ពុជា ឲ្យ ទៅ សិក្សា នៅ សហរដ្ឋ អាមេរិក ។
បើ តាម ការបញ្ជាក់ ឲ្យដឹង ពី លោក មួន វាសនា ទីប្រឹក្សា សម្តេច ហេង សំរិន និង ជា ប្រធាន គណៈ គ្រប់គ្រង សាកលវិទ្យាល័យ UME នា រសៀល ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ បាន ឲ្យដឹង ទៀត ថា អ្នកជំនាញ អប់រំ ដ៏ ល្បី របស់ សហរដ្ឋ អាមេរិក ចំនួន ២រូប នេះ រួម មាន លោកស្រី បណ្ឌិត អែឡែន ហ្គែធ័រ និង លោក បណ្ឌិត ហ្គ្រេក ហ្គែធ័រ ។
លោក បាន គូសបញ្ជាក់ ថា ដោយ មាន អនុស្សារណៈ យោគយល់ គ្នា រវាង សាកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច UME សាខា ខេត្ត កំពង់ចាម និង សាកលវិទ្យាល័យ មហា ឬ សី នៃ ការគ្រប់គ្រង MUM មាន មូលដ្ឋាន នៅ រដ្ឋ អៃ អូវ៉ា សហរដ្ឋ អាមេរិក ទើប សាកលវិទ្យាល័យ គ្រប់គ្រង និង សេដ្ឋកិច្ច សាខា ខេត្ត កំពង់ចាម សហការ ជាមួយ CMAC និង RUPP រៀបចំ សិក្ខាសាលា នេះ ឡើង ។
ទីប្រឹក្សា សម្តេច ហេង សំរិន បាន លើកឡើង ថា នេះ ជា ជំហ៊ាន ថ្មី មួយ បន្ថែម ទៀត ក្រោយពី បាន សហការ រៀបចំ សន្និសីទ អន្តរជាតិ កាលពី ឆ្នាំ ២០១៧ ដែល នឹង អនុវត្ត ទៅ តាម គោលការណ៍ ដែល មាន ចែង ក្នុង អនុស្សារណៈ យោគយល់ គ្នា នេះ ។
លោក មួន វាសនា បាន បញ្ជាក់ ថា សាកលវិទ្យាល័យ មហា ឬ សី នៃ ការគ្រប់គ្រង MUM នេះ បាន កើតឡើង ប្រមាណ ជា ៥០ ឆ្នាំ បណ្តុះបណ្តាល ថ្នាក់ បរិញ្ញាបត្រ អនុបណ្ឌិត និង បណ្ឌិត គ្រប់ ជំនាញ និង គ្រប់ កម្រិត ផ្សេង ៗ ដែល បច្ចុប្បន្ន មាន និស្សិត កំពុង សិក្សា និង បញ្ចប់ ជាង ៣.០០០ នាក់ មកពី ជាង ១០០ ប្រទេស ជុំវិញ ពិភពលោក ។
( សៀមរាប ) ៖ អភិបាល ខេត្ត សៀមរាប លោក ឃឹម ប៊ុន សុង បាន ថ្លែង ថា ប្រទេស កម្ពុជា ពិតជា មាន លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស យ៉ាង ពិតប្រាកដ ហើយ រាជ រដ្ឋាភិបាល ប្ដេជ្ញា រក្សា ការពារ នូវ ឯករាជ្យភាព អធិបតេយ្យ បូរណភាព ទឹកដី និង រក្សា ការពារ នូវ ទំនៀមទម្លាប់ ប្រពៃណី ជំនឿ សាសនា ។
ការថ្លែង របស់ លោក ឃឹម ប៊ុន សុង ត្រូវបាន ធ្វើឡើង នៅ ថ្ងៃទី ២២ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ មន្ត្រី សង្ឃ អាចារ្យ គណៈកម្មការ វត្ត ព្រមទាំង ថ្នាក់ដឹកនាំ និង បរិស័ទ សាសនា ឥស្លាម សាសនា គ្រឹស្ន សាសនា បាហៃ និង សាសនា ផ្សេង ៗ មួយចំនួន ទៀត នៅ វត្ត ព្រះព្រហ្មរ័ត្ន នា សង្កាត់ ស្វាយ ដង្គំ ក្រុង សៀមរាប ។
អភិបាល ខេត្ត សៀមរាប បាន លើកឡើង ថា ក្រោម ដំបូល នៃ សុខ សន្ដិភាព ស្ថិរភាព នយោបាយ និង វឌ្ឍនភាព របស់ កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង ឥស្សរជន នៃ រាជ រដ្ឋាភិបាល កម្ពុជា និង គណបក្ស ប្រជាជន កម្ពុជា ប្រជាពលរដ្ឋ គ្រប់ រូប មាន សិទ្ធិ គោរព ប្រតិបត្តិ នូវ ជំនឿ សាសនា និង បក្ស នយោបាយ ដែល ខ្លួន ស្រលាញ់ ពេញចិត្ត ហើយ បើ យោង តាម បាវចនា នៃ ព្រះរាជាណាចក្រ កម្ពុជា គឺជាតិ សាសនា ព្រះមហាក្សត្រ ។
បើ តាម របាយការណ៍ របស់ លោក វណ្ណ ប៊ុន ណា ប្រធាន មន្ទីរ ធម្មការ និង សាសនា ខេត្ត សៀមរាប បាន ឲ្យដឹង ថា សម្រាប់ ខេត្ត សៀមរាប ក្នុង នោះ មាន ព្រះពុទ្ធ សាសនា មាន ២និកាយ គឺ គណៈ មហា និកាយ និង គណៈ ធម្មយុត្តិក និកាយ ហើយ មាន ២៤២វត្ត និង ២៣ អាស្រម . មាន ព្រះសង្ឃ សរុប ចំនួន ៤. ៧៨៨អង្គ ។ គណៈ មហា និកាយ មាន ២៤២វត្ត អាចារ្យ វត្តមាន ចំនួន ៦៥៨ នាក់ ក្នុង នោះ អាចារ្យ ៤១៨ រូប បាន ទទួល ការបណ្ដុះបណ្ដាល ក្នុង នោះ គណៈកម្មការ វត្តមាន ចំនួន ១. ៧០៥ នាក់ ។
ទិញ ក្បឿង ជី ប ម៉ុង ទទួលបាន ទាំង គុណភាព និង រង្វាន់
អតិថិជន ឈ្នះ រង្វាន់ ម៉ូតូ ហុង ដា ២០១៨ ថ្មី ស្រឡាង មាន ឈ្មោះ សេង វណ្ណា មកពី ខេត្ត ត្បូងឃ្មុំ និង លោក ហាន់ ចាន់ ហេង មកពី ខេត្ត កំពង់ធំ ឈ្នះ រង្វាន់ ខ្សែក មាស ២ជី ព្រមទាំង អតិថិជន ៥នាក់ ផ្សេង ទៀត ក៏ ទទួលបាន រង្វាន់ លួង ចិត្ត ផល ដែរ ។
ចំពោះ អ្នក ដែល មិន ទាន់ បាន ទទួល រង្វាន់ ពី ក្បឿង ជី ប ម៉ុង សូម កុំ ទាន់ អាក់អន់ ស្រពន់ចិត្ត សូម បន្ត ជាវ ក្បឿង ជី ប ម៉ុង ដើម្បី ទទួលបាន សន្លឹក ឆ្នោត ផ្សង សំណាង កាន់តែ ច្រើន ព្រោះ ការចាប់ រង្វាន់ នឹង ធ្វើឡើង ២ដង បន្ត ទៀត ហើយ ការចាប់ឆ្នោត លើក ចុងក្រោយ នឹង ប្រព្រឹត្តទៅ នៅ ចុង ឆ្នាំ ២០១៨ ។
ក្បឿង ជី ប ម៉ុង ផលិត ដោយ អ្នកជំនាញ ដោយ ប្រើប្រាស់ ម៉ាស៊ីន ដែល ជា បច្ចេកវិទ្យា ចុងក្រោយពី ប្រទេស អ៊ីតាលី និង វត្ថុធាតុ ដើម ល្អ បំផុត និង មាន ការត្រួតពិនិត្យ គុណភាព ក្នុង បន្ទប់ ពិសោធន៍ ត្រឹមត្រូវ ដែល ធ្វើឲ្យ ក្បឿង ជី ប ម៉ុង មាន ភាពរឹងមាំ ជាប់ ធន់ ការពារ កម្តៅ បាន យ៉ាង ល្អ មិន ហើរ ពណ៌ និង ស្រស់ស្អាត ៕
ការមកដល់ ថ្មី របស់ ស្ប៉ា និង ម៉ាស្សា ចំណាត់ថ្នាក់ លេខ ១ ក្នុង ខេត្ត សៀមរាប
មុទិតា ស្ប៉ា ថ្មី សាខា កោះ កេរិ៍ ដែល ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ តែងតែ ទន្ទឹងរង់ចាំ នោះ បាន បើក សម្ពោធ ហើយ កាលពី ថ្ងៃពុធ ទី១៨ កក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ ថ្មី ៗ នេះ ។ មុទិតា ស្ប៉ា ត្រូវបាន ទទួលស្គាល់ ថា ជា ស្ប៉ា ដែល ទទួលបាន ចំណាត់ថ្នាក់ លេខ១ រយៈពេល ៣ឆ្នាំ ចុងក្រោយ ជាប់ ៗ គ្នា នៅលើ គេហទំព័រ ទេសចរណ៍ ដ៏ ធំ របស់ ពិភពលោក TripAdvisor ក្នុង ចំណោម ស្ប៉ា និង ម៉ាស្សា ជាង ១០០ កន្លែង ផ្សេង ទៀត នៅក្នុង ខេត្ត សៀមរាប ។
តាមរយៈ ការបម្រើ សេវាកម្ម ស្ប៉ា និង ម៉ាស្សា រយៈពេល ជាច្រើន ឆ្នាំ មក នេះ មុទិតា ស្ប៉ា តែងតែ ទទួលបាន ការកោតសរសើរ ពី ភ្ញៀវ មិន ដាច់ ពី មាត់ អំពី គុណភាព សេវាកម្ម ជម្រើស បរិក្ខារ បរិយាកាស ជាពិសេស នោះ គឺ ភាព រួសរាយ រាក់ទាក់ និង ភាពស្ទាត់ជំនាញ របស់ បុគ្គលិក បម្រើ សេវាកម្ម នៅ ទីនោះ ។
អភិបាល ខេត្ត មណ្ឌលគិរី ប្រគល់ ម៉ូតូ ២១ គ្រឿង ជា អំណោយ របស់ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការ នគរបាល ជាតិ ជូន ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទូទាំង ខេត្ត
( មណ្ឌលគិរី ) ៖ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ប្រគល់ ម៉ូតូ ដែល ជា អំណោយ របស់ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការ នគរបាល ជាតិ ជូន ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ សង្កាត់ នីមួយ ៗ ទាំង ២១ ក្នុង ខេត្ត នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត មណ្ឌលគិរី ។
លោក ឧត្តមសេនីយ៍ ទោ ឡោ សុខា ស្នងការ នគរបាល ខេត្ត មណ្ឌលគិរី បាន ឲ្យដឹង ថា នេះ ជា លើក ទី៤ ហើយ ដែល ក្រសួង មហាផ្ទៃ បាន ប្រគល់ របប ម៉ូតូ បន្ថែម ពីលើ របប សាំង និង ថវិកា ប្រចាំ ត្រីមាស ដែល ក្រសួង បាន ផ្ដល់ជូន ដល់ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ - សង្កាត់ នៅ ទូទាំង ប្រទេស ក៏ ដូចជា ក្នុង ខេត្ត មណ្ឌលគិរី សម្រាប់ បម្រើ ឲ្យ កិច្ច ប្រតិបត្តិការ រក្សា សន្តិសុខ ជូន ប្រជាពលរដ្ឋ ។
ជាមួយគ្នា នេះ លោក ស្នងការ នគរបាល ខេត្ត បាន ជម្រុញឲ្យ កងកម្លាំង នគរបាល ទូទាំង ខេត្ត ត្រូវ យកចិត្តទុកដាក់ បង្រ្កាប បទល្មើស ផ្សេង ៗ ឲ្យ មាន ប្រសិទ្ធភាព ពិសេស ការអនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ទាំង ៩ចំនុច ។
លោក អភិបាល ខេត្ត សង្កត់ធ្ងន់ ថា ឆ្លើយតប ទៅនឹង ការគិតគូរ យកចិត្តទុកដាក់ នេះ នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទាំងអស់ ត្រូវ យក ម៉ូតូ ទៅ ប្រើប្រាស់ ឲ្យបាន ចំ ទិសដៅ បម្រើ ឲ្យ ផលប្រយោជន៍ រួម ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ទូទៅ និង សង្គម ចៀសវាង ឲ្យបាន នូវ ការយកមធ្យោបាយ នេះ ទៅ ប្រើប្រាស់ ខុស គោលដៅ បម្រើ ឲ្យ ផលប្រយោជន៍ បុគ្គល ព្រមទាំង ថែរក្សា ឲ្យបាន គង់វង្ស យូរអង្វែង ។
ជាមួយគ្នា នេះ ផងដែរ លោក អភិបាល ខេត្ត លោក ស្វាយ សំអ៊ាង បាន ឧបត្ថម្ភ ដល់ ស្នងការដ្ឋាន នគរបាល ខេត្ត មណ្ឌលគិរី នូវ ប្រេងសាំង មួយចំនួន សម្រាប់ ប៉ុស្តិ៍ ទាំង ២១ ដើម្បី ប្រើប្រាស់ តាម ត្រូវការ ៕ លោក ថៃ ផានី៖ ប្រជាពលរដ្ឋ ចង់ ទទួលបាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ សូម បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា នា ថ្ងៃទី ២៩ ខែកក្កដា
( តាកែវ )៖ លោក ថៃ ផានី ប្រធាន ក្រុមការងារ ចុះ ពង្រឹង គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត សៀមរាប និង ជា អនុ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង លោកស្រី ហ៊ុន ចាន់ថុល និង លោក វ៉ា សំអឿន តំណាងរាស្ត្រ គណបក្ស ប្រជាជន កម្ពុជា មណ្ឌល ខេត្ត កណ្តាល នៅ ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ បាន ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក គណប ក្យ ប្រជាជន កម្ពុជា ចំនួន ៤០០ គ្រួសារ នៅ ភូមិ ត្រពាំង លើ ក ឃុំ កណ្តឹង ស្រុក បាទី ខេត្ត តាកែវ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ថៃ ផានី បាន ជំរាប ជូន ពី ប្រសាសន៍ ផ្តាំផ្ញើ ចុះ សាកសួរ សុខទុក្ខ ពុក ម៉ែ បងប្អូន លោកយាយ លោក តា កូនក្មួយ ៗ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ។
លោក ថៃ ផានី បាន បញ្ជាក់ ថា ការសន្យា ធ្វើ ផ្លូវ មួយ ខ្សែ ជូន ប្រជាពលរដ្ឋ ដែល មាន ប្រវែង មួយ ពាន់ ប្រាំបី រយម៉ែត្រ ក្រាល គ្រួស ក្រហម ដើម្បី ងាយស្រួល ក្នុង ការធ្វើដំណើរ ទាំង ទៅ ទាំង មក សម្រាប់ ពុក ម៉ែ បងប្អូន នឹង រៀបចំ ធ្វើ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
គណបក្ស ប្រជាជន កម្ពុជា តែងតែ នៅ រួម សុខ រួម ទុក ជាមួយ លោកយាយ លោក តា ពុក ម៉ែ បងប្អូន ជាប់ ជានិច្ច គ្រប់ ពេលវេលា បើ ពុក ម៉ែ បងប្អូន គោរ ស្រឡាញ់ សម្តេច សូម មេត្តា ទៅ អញ្ជើញ ចូលរួម ទៅ បោះឆ្នោត ទាំងអស់ គ្នា បោះ ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ សូម គូស ទាំងអស់ គ្នា ដើម្បី នាំមក នូវ សេរី សួស្តី សុខ សន្តិភាព សប្បូរសប្បាយ និង មាន ការអភិឌ្ឈន៍ លើ គ្រប់ វិស័យ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃចន្ទ ទី២៣ ខែកក្កដា ឆ្នាំ ២០១៨ សហព័ន្ធ និស្សិត បញ្ញវ័ន្ត ប្រជាធិបតេយ្យ កម្ពុជា បាន បើក វគ្គ បណ្តុះបណ្តាល ដល់ អ្នកសង្កេតការណ៍ ជាតិ ដែល ជា និស្សិត នៅ តាម បណ្តា គ្រឹះស្ថាន ឧត្តម សិក្សា និង មធ្យមសិក្សា បច្ចេកទេស ទូទាំង ប្រទេស ក្រោម អធិបតីភាព របស់ លោក សាន វិសាល អគ្គ លេខាធិការ សហព័ន្ធ និស្សិត បញ្ញវ័ន្ត ប្រជាធិបតេយ្យ កម្ពុជា និង លោក សាត់ សុវណ្ណ អនុប្រធាន នាយកដ្ឋាន បណ្តុះបណ្តាល និង អប់រំ អ្នកបោះឆ្នោត គ.ជ. ប. ។
លោក សាន វិសាល អគ្គ លេខាធិការ សហព័ន្ធ និស្សិត បញ្ញវ័ន្ត ប្រជាធិបតេយ្យ កម្ពុជា បាន មានប្រសាសន៍ សំណេះសំណាល ដល់ ប្អូន ៗ ដែល ជា អ្នកសង្កេតការណ៍ ជាតិ សូម ឱ្យ យកចិត្តទុកដាក់ ក្នុង ការបណ្តុះបណ្តាល នា ពេល ថ្ងៃ នេះ ឱ្យ បាន ច្បាស់លាស់ ដើម្បី យក ទៅ អនុវត្ត នៅ ថ្ងៃ បោះឆ្នោត ប្រកបដោយ ប្រសិទ្ធភាព ៕
បេក្ខជន តំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ៖ គណបក្ស ប្រជាជន ជា បក្ស កាន់អំណាច ដុះ ស្លែ ហើយ ស្លែ នោះ អាច ធ្វើឲ្យ ត្រី រស់ នៅ បាន ស្រួល ត្រជាក់ ត្រជុំ ប្រកប ទៅ ដោយ វីតាមីន ឆាប់ ធំធាត់
( កំពង់ធំ )៖ លោក ឃឹង នុភាព បេក្ខជន តំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ បាន លើកឡើង ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា គណបក្ស កាន់អំណាច ដុះ ស្លែ ក្នុង នោះ លោក បាន បញ្ជាក់ ថា ស្លែ នោះ អាច ធ្វើឲ្យ ត្រី រស់ នៅ បាន ស្រួល ត្រជាក់ ត្រជុំ មាន ជីវជាតិ ប្រកប ទៅ ដោយ វីតាមីន អាច ធ្វើឲ្យ ត្រី ឆាប់ ធំធាត់ ថែម ទៀត ផង ។
លោក បាន ការថ្លែង ដូច្នេះ ក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយ បងប្អូន ជនជាតិ ដើម ភាគ តិច គួយ នៅ ភូមិ វាល វែង ឃុំ ឈូក ស្រុក ប្រាសាទ សំបូរ ខេត្ត កំពង់ធំ នា ថ្ងៃទី ២២ កក្កដា ឆ្នាំ ២០១៨ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក ឈុន ឈន់ ប្រធាន ក្រុមការចុះ ជួយ ស្រុក ប្រាសាទ សំបូរ ក្រុមការងារ និង ប្រជាពលរដ្ឋ ប្រមាណ ជិត ៤០០ នាក់ ។
លោក រូហានី ធ្វើ ការព្រមាន បែប នេះ នៅក្នុង សុន្ទរកថា មួយ តាម កញ្ចក់ ទូរទស្សន៍ រដ្ឋ កាលពី ថ្ងៃអាទិត្យ ។ ថ្លែង នា ឱកាស នោះ លោក រូហានី បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « កុំ លេង ជាមួយ កន្ទុយ តោ ពីព្រោះ អ្នក នឹង សោកស្ដាយ ។ សន្តិភាព ជាមួយ អ៊ីរ៉ង់ នឹង ក្លាយជា ម៉ែ នៃ សន្តិភាព ទាំងអស់ ហើយ សង្រ្គាម ជាមួយ អ៊ីរ៉ង់ នឹង ក្លាយជា មេ នៃ សង្រ្គាម ទាំងអស់ ... ដូច្នេះ សហរដ្ឋ អាមេរិក កុំ សង្ឃឹម ថា អាចនឹង រារាំង ការនាំចេញ ប្រេង របស់ អ៊ីរ៉ង់ ទៅកាន់ ទីផ្សារ អន្តរជាតិ » ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ រួម ជាមួយ លោក ស្នងការ រង លោក អធិការ លោក អធិការ រង នគរបាល ខណ្ឌ ទួលគោក បាន ចុះ សួរសុខទុក្ខ ដល់ លោក អនុ សេនីយ៍ ឯក ឃិន ទិត មន្រ្តី ប៉ុស្តិ៍ នគរបាល ផ្សារ ដើម គរ នៅ មន្ទីរពេទ្យ កាល់ម៉ែត ដែល បាន រងរបួស ធ្ងន់ នៅពេល កំពុង ប្រតិបត្តិការ ការពារ សន្តិសុខ នៅក្នុង មូលដ្ឋាន ។
លោក វរសេនីយ៍ ឯក ហ៊ុន សុធី ក៏ បាន ឲ្យដឹង ផងដែរ ថា នៅ ថ្ងៃ ម្សិលមិញ បន្ទាប់ ទទួល ដំណឹង អំពី ករណី គ្រោះថ្នាក់ របស់ លោក អនុ សេនីយ៍ ឯក យិន ទិត រូប លោក រួម ជាមួយ លោក អធិការ រង និង នាយ ប៉ុស្តិ៍ ទឹក ល្អក់៣ បាន ចុះ សួរសុខទុក្ខ ដល់ លោក អនុ សេនីយ៍ ឯក ឃិន ទិត នៅ មន្ទីរពេទ្យ កាល់ម៉ែត និង បាន នាំយក ថវិការ ចំនួន ១លាន រៀល និង លោក នាយ ប៉ុស្តិ៍ ចំនួន ១០ម៉ឺន រៀល ជូន ដល់ លោក អនុ សេនី យ៏ ឯក ឃិន ទិត ដែល កំពុង សំរាក ព្យាបាល នៅ មន្ទីរពេទ្យ ។
ក្រៅពី ថវិកា ខាងលើ នេះ ក៏ មាន សប្បុរស ជន ផ្សេង ទៀត ជួយ ឧបត្ថម្ភ ដល់ ជនរងគ្រោះ ផងដែរ អភិបាល ខណ្ឌ ទួលគោក ចំនួន ២០០ ដុល្លារ និង ថវិកា ប៉ុស្តិ៍ នគរបាល ផ្សារ ដើម គរ ១លាន រៀល ។
ជាមួយគ្នា នេះ ក្រុមគ្រួសារ ជនរងគ្រោះ សូម គោរព ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ នគរបាល នៃ ស្នងការដ្ឋាន រាជធានី ដែល បាន យកចិត្តទុកដាក់ ដល់ ថ្នាក់ ក្រោម និង មិត្ត នគរបាល ទាំងអស់ ដែល បាន ជួយ ជា កំលាំងចិត្ត និង ថវិកា សម្រាប់ ព្យាបាល សង្គ្រោះ ជីវិត ។
គួរ ជម្រាប ថា បើ តាម អាជ្ញាធរ អ៊ីរ៉ង់ នៅ ក្រោយ គ្រោះ រញ្ជួយ ដី កាលពី ម្សិលមិញ មនុស្ស សរុប ២៨៧ នាក់ បាន រងរបួស ខណៈ អគារ ចំនួន ១០១ ខ្នង ត្រូវបាន បំផ្លិចបំផ្លាញ ទាំងស្រុង ។ ចំណែកឯ កាលពី ខែឧសភា កន្លងទៅ ខេត្ត កោះ ហ្គីលូយ៉េហ៍ (Kohgiluyeh) ភាគ ខាងត្បូង ក៏ បាន រង ការវាយប្រហារ ពី គ្រោះ រញ្ជួយដី ដ៏ ខ្លាំងក្លា មួយ ផងដែរ ដែល បាន បណ្តាលឲ្យ មនុស្ស ១៣៣ នាក់ របួស ។
នា ពេល កន្លងមក នេះ អ៊ីរ៉ង់ បាន ប្រឈមមុខ នឹង គ្រោះ រញ្ជួយ ដី ធំ ៗ ។ តួយ៉ាង កាលពី ខែវិច្ឆិកា ឆ្នាំ ទៅ គ្រោះមហន្តរាយ រញ្ជួយ ដី កម្រិត ៧. ២រ៉ិច ទ័រ បាន វាយប្រហារ តំបន់ ព្រំដែន អ៊ីរ៉ង់ ជាមួយ អ៊ីរ៉ាក់ ដែល បាន ធ្វើឲ្យ មនុស្ស រាប់ រយ នាក់ ស្លាប់ និង រងរបួស ៕
( ភ្នំពេញ ) ៖ បណ្តាញ យុវជន ទេសចរណ៍ និង ទីក្រុង ស្អាត នា ព្រឹក ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន បង្ហាញ ពី ការប្តេជ្ញាចិត្ត និង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទៅ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ដើម្បី ជា ការអនុវត្ត សិទ្ធិ ជា ពលរដ្ឋ ដោយ បាន សង្កត់ធ្ងន់ ថា « មាន សន្តិភាព ទើប មាន ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ » ។
ក្នុង វីដេអូ ខ្លី មួយ បណ្តាញ យុវជន ទេសចរណ៍ និង ទីក្រុង ស្អាត ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ មាន សិទ្ធិ និង មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត សូម ទៅ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ឆាប់ ៗ ខាងមុខ ផងដែរ ខណៈ ដែល ពេលវេលា បោះឆ្នោត នៅសល់ រយៈពេល តែ៦ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ៕
