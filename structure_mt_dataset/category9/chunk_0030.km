( ព្រះវិហារ ) ៖ ស្រប ពេល ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ខិត ជិត ចូល មកដល់ នោះ បាន ធ្វើឲ្យ គណបក្ស នយោបាយ នានា ដែល បាន ចុះឈ្មោះ តាម ច្បាប់ នៅ គ.ជ. ប បាន ខិតខំ ប្រឹងប្រែង រៀង ៗ ខ្លួន ដើម្បី ស្វែងរក សម្លេង គាំទ្រ ពី ប្រជាពលរដ្ឋ ដែល ជា ម្ចាស់ ឆ្នោត តាម មធ្យោបាយ និង កម្មវិធី នយោបាយ របស់ បក្ស រៀង ៗ ខ្លួន ផងដែរ ។
នៅក្នុង ឱកាស នោះ លោក សួន ខាំឡ និង លោកស្រី ចឹង ហេង បាន ប្រាប់ បងប្អូន អាជីវករ អំពី ផលប្រយោជន៍ របស់ បងប្អូន នៅ ពេល ដែល គណបក្ស ប្រជាជន កម្ពុជា ឈ្នះ ឆ្នោត គឺ បងប្អូន លក់ដូរ តាម ផ្សារ លើ ទីតាំង ដី រដ្ឋ អាច ផ្ទេរ សិទ្ធិ កាន់កាប់ ប្រើប្រាស់ និង អាស្រ័យ ផល ទៅ កូន ចៅ ឬ អ្នក ដ៏ទៃ បាន ដោយ ពុំ មាន កំណត់ អាណត្តិ ។ អភិវឌ្ឍន៍ និង ពង្រឹង ប្រពន្ធ័ គាំពារ សង្គម ប្រកបដោយ ប្រសិទ្ធិភាព និង ចីរភាព ដែល ជួយ គាំពារ ប្រជាជន គ្រប់ រូប ពី ជា ជន ណា ម្នាក់ ស្ថិត នៅ ក្រៅ សង្គម គាំពារ សង្គម ឡើយ ។
ជាមួយគ្នា នោះ ផ្តល់ សេវា សាធារណៈ នូវ គ្រប់ ថ្នាក់ ជូន ប្រជាជន ប្រកបដោយ គុណភាព តម្លាភាព ប្រសិទ្ធិភាព និង ងាយស្រួល ។ ក្រុមការងារ បាន ប្រាប់ បងប្អូន អាជីវករ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ទេ ដែល តែង រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន គ្រប់ កាលះ ទេសះ នោះ ដូច្នេះ សូម បងប្អូន បន្ត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន តទៅទៀត ដោយ អញ្ជើញ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ គ្នា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ ដែល មាន រូប ទេវតា បាច ផ្កា ជា សំគាល់ ៕
( ឡុងដ៍ ) ៖ សំណល់ ហ្វូស៊ីល នៃ អម្បូរ សត្វ ដាយណូស័រ Sauropod ទើបតែ ត្រូវបាន គេ រុករកឃើញ នៅឯ ប្រទេស ចិន ដោយ ប្រការ នេះ ប្រហែលជា អាច ផ្លាស់ប្តូរ ការ ដែល អ្នកវិទ្យាសាស្រ្ត យល់ឃើញ ពី របៀប ដែល សត្វ យក្ស ទាំងនេះ បាន ធ្វើ ការវិវត្តន៍ និង របៀប ដែល ទ្វីប ទាំងអស់ នៅលើ ផែនដី នៅ ជាប់ គ្នា កាលពី ១៧៤ លាន ឆ្នាំ មុន ។ នេះ បើ តាម ការសិក្សា ថ្មី មួយ របស់ សារមន្ទីរ ជាតិ ប្រវត្តិសាស្រ្ត នៅ ទីក្រុង ឡុងដ៍ ដកស្រង់ ខ្លឹមសារ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃពុធ ទី២៥ ខែកក្កដា ឆ្នាំ ២០១៨ ។
គួរ ជម្រាប ថា យ៉ាងណាមិញ សំណល់ ហ្វូស៊ីល ដែល ទើប រកឃើញ ខាងលើ បាន បង្ហាញ ថា តំបន់ អាស៊ី ខាងកើត ប្រហែលជា ពុំ ទាន់ ត្រូវបាន កាត់ផ្តាច់ ដូច ដែល ធ្លាប់ បាន គិត នោះ ឡើយ ហើយ សត្វ ដាយណូស័រ ទាំង នេះ ប្រហែលជា បាន ធ្វើដំណើរ ទៅកាន់ តំបន់ នេះ តាំងតែពី យូរ មកហើយ មុនពេល មាន ការហែក ខ្ញែក ទ្វីប ណាមួយ បាន កើតឡើង ៕
ក្រុមហ៊ុន ផលិត រថយន្ត ធំ បំផុត ក្នុង ប្រទេស ចិន BYD បាន បង្កើត មូលដ្ឋាន ផលិតកម្ម ដ៏ ទំនើប បំផុត របស់ ខ្លួន នៅ ទីនេះ ។
រោងចក្រ នេះ មាន បំពាក់ ទៅ ដោយ ខ្សែ សង្វាក់ ផលិតកម្ម ស្វ័យប្រវត្តិ ទាំងស្រុង និង បច្ចេកវិទ្យា ទំនើប ចុងក្រោយ បង្អស់ ដើម្បី ធានា ថា ការផលិត មាន ប្រសិទ្ធភាព កាន់តែ ខ្ពស់ ។
អ្នកគ្រប់គ្រង ទូទៅ នៃ ក្រុមហ៊ុន នេះ ជឿជាក់ ថា មាន តែ ការច្នៃប្រឌិត ថ្មី ដែល ឯករាជ្យ តែ ប៉ុណ្ណោះ ដែល អាច ជំរុញ ឱ្យ ក្រុមហ៊ុន ឆ្ពោះទៅ មុខ បន្ត ទៀត បាន ។
ក្រុមហ៊ុន ផលិត រថយន្ត ដ៏ ធំ នេះ បាន បណ្តាក់ទុន ជាង ២ពាន់ ៥រយ លាន ដុល្លារ សហរដ្ឋ អាមេរិក ដើម្បី បើក អាជីកម្ម ផលិត រថយន្ត ព័ត៌មានវិទ្យា និង ផ្លូវ រថភ្លើង ។
ក្រុមហ៊ុន បច្ចេកវិទ្យាឡា ស៊ែរ ភ្លឺ ស៊ី អាន គឺជា ក្រុមហ៊ុន មួយ ក្នុង ចំណោម ក្រុមហ៊ុន ព្រីន 3D លើ ដែក ធំ បំផុត ក្នុង ពិភពលោក និង ជា អ្នក ត្រួសត្រាយ ផ្លូវ នៃ បច្ចេកវិទ្យា បោះពុម្ព 3D ផងដែរ ។ សម្រាប់ ក្រុមហ៊ុន នេះ ការបណ្តាក់ទុក ទៅ លើ ការច្នៃប្រឌិត ថ្មី គឺជា រឿង សំខាន់ ។
គេ រំពឹង ថា ក្រុមហ៊ុន ទាំងឡាយ ដែល បាន ចុះបញ្ជី នៅក្នុង តំបន់ នេះ នឹង បង្កើត ប្រាក់ ចំនូល បាន ៣៨០ ពាន់ លាន ដុល្លារ សហរដ្ឋ អាមេរិក ក្នុង ១ ឆ្នាំ នៅ ត្រឹម ឆ្នាំ ២០២០ ពោលគឺ ស្មើនឹង កំណើន ប្រាក់ ចំណូល ១៥ ភាគរយ នៅក្នុង មួយ ឆ្នាំ ។
លោក យ៉ាង រិន ហ័រ អ្នកគ្រប់គ្រង ទូទៅ នៃ គណៈកម្មាធិការ រដ្ឋបាល នៃ តំបន់ អភិវឌ្ឍ ឧស្សាហកម្ម បច្ចេកវិទ្យា ខ្ពស់ ស៊ី អាន បាន និយាយ ថា តំបន់ នេះ កំពុង ព្យាយាម ទាក់ទាញ ធនធាន មនុស្ស ដ៏ ប៉ិនប្រសប់ មកពី ទូទាំង ពិភពលោក ឱ្យ មក ធ្វើការ នៅ តំបន់ នេះ ។
អភិបាល ខេត្ត ស្ទឹងត្រែ ង៖ ទឹក ទន្លេ សេកុង បាន ហក់ ឡើង ដល់ កម្រិត ប្រកាស អាសន្ន បណ្ដាលឲ្យ ជន់ លិច ឃុំ ចំនួន ៤ ក្នុង ស្រុក សៀម ប៉ាង មាន ពលរដ្ឋ ជិត ៥.០០០ នាក់ រង ផល ប៉ះពាល់
អភិបាល ខេត្ត ស្ទឹងត្រែង បាន បញ្ជាក់ ថា ការឡើង កម្ពស់ ទឹក បាន បណ្ដាលឲ្យ ឃុំ ចំនួន ៤ ក្នុង ចំណោម ឃុំ ទាំង៥ របស់ ស្រុក សៀម ប៉ាង ជាប់ ព្រំដែន ខេត្ត អត្តពឺ ប្រទេស ឡាវ ត្រូវ ជន់ លិច ហើយ ប្រជាពលរដ្ឋ ជិត ៥.០០០ នាក់ ស្មើ ជាង ១ ពាន់ គ្រួសារ ដែល រស់ នៅក្នុង ឃុំ ទាំង ៤នេះ បាន និង កំពុង ទទួលរង ផល ប៉ះពាល់ ខណៈ ដែល អាជ្ញាធរ និង សមត្ថកិច្ច ជាច្រើន នាក់ កំពុង ជួយ ជម្លៀស ទៅកាន់ ទី ទួល មាន សុវត្ថិភាព ។
យ៉ាងណា ក៏ដោយ លោក ម៉ុម សារឿន មិន ទាន់ អាច បញ្ជាក់ តួលេខ ផ្លូវការ ស្ដីពី ការជម្លៀស ប្រជាពលរដ្ឋ ចេញ ពី ទឹក ជំនន់ នៅឡើយ ទេ ដោយ កំពុង បូកសរុប និង កំពុង ជួយ អន្ដរាគមន៍ ។
នៅ រសៀល ថ្ងៃ នេះ ដែរ ខាង ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ក៏ បាន បញ្ជាក់ ថា ទឹក ជំនន់ ដែល ហូរ ធ្លាក់ ពី ប្រទេស ឡាវ បាន បន្ត ជន់ លិច ចូល ភូមិឋាន ប្រជាពលរដ្ឋ យើង មួយចំនួន បន្ថែម ទៀត ដែល ស្ថិត នៅ តំបន់ ព្រំដែន កម្ពុជា - ឡាវ ក្នុង ស្រុក សៀម ប៉ាង ខេត្ត ស្ទឹងត្រែង ។
ក្រសួង ធនធាន ទឹក បាន ឲ្យដឹង ថា គិត ត្រឹម ម៉ោង ១២៖៣០ នាទី ថ្ងៃ នេះ ទឹក ជំនន់ បាន លិច ចូល ភូមិ សរុប ចំនួន ១៧ភូមិ ក្នុង ឃុំ ថ្ម កែវ ឃុំ សន្តិភាព ឃុំ សេកុង និង ឃុំ ស្រែ សំបូរ ។
គួរ ជម្រាប ថា ទំនប់ វារី អគ្គិសនី ខាងលើ ដែល កំពុង ស្ថិត ក្រោម ការដឹកនាំ សាងសង់ ឡើង ដោយ ក្រុមហ៊ុន កូរ៉េ ខាងត្បូង បាន បាក់ កាលពី ល្ងាច ថ្ងៃចន្ទ ដោយ បណ្តាលឲ្យ មនុស្ស ខ្ទង់ រយ នាក់ បាត់ខ្លួន និង រាប់ ពាន់ នាក់ ទៀត បាត់បង់ ទីជម្រក ខណៈ សាកសព មនុស្ស ប្រមាណ ១៩ នាក់ ត្រូវ គេ រាយការណ៍ ថា បាន រកឃើញ ។
ជាមួយគ្នា នេះ ដែរ ការវិវាទ បាន ផ្ទុះ កើតឡើង ជុំវិញ មូលហេតុ នៃ ហេតុការណ៍ ដ៏ អាក្រក់ នេះ ដោយ ខ្លះ បាន លើកឡើង ថា ទំនប់ ខាងលើ បាន បាក់ ដោយសារតែ ភ្លៀង ធ្លាក់ ខ្លាំង ខណៈ ខ្លះ ទៀត បាន និយាយ ថា ការបាក់ ទំនប់ នេះ តែម្តង ទើប បង្កឲ្យ មាន ទឹក ជំនន់ យ៉ាង ជន់ ជោរ ។
រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង នឹង បញ្ជូន ក្រុម សង្រ្គោះ ជំហាន ដំបូង ចំនួន ០៧ នាក់ ទៅកាន់ ប្រទេស ឡាវ នា ថ្ងៃព្រហស្បតិ៍ ស្អែក ហើយ នឹង បញ្ជូន ភ្នាក់ងារ ព្រមទាំង ក្រុម គ្រូពេទ្យ បន្ថែម ទៀត ក្រោយ បាន ធ្វើ ការពិគ្រោះយោបល់ ជាមួយ រដ្ឋាភិបាល ឡាវ ៕
ក្រៅពី ការងារ រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ សង្គម . ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ យក រទេះ ពិការ ចែកជូន ជន ពិការ នៅ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ ទោះជា មមាញឹក ក្នុង ភារកិច្ច ការពារ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង សង្គម យ៉ាងណា ក្តី នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ បាន ដឹកនាំ សហការី នាំយក រទេះ រុញ ជន ពិការ ចំនួន ៨ គ្រឿង អង្ករ និង មី មួយចំនួន ទៅ សួរសុខទុក្ខ ប្រជាពលរដ្ឋ និង ជួយ ឧបត្ថម្ភ ជន ពិការ ៨នាក់ នៅក្នុង មូលដ្ឋាន សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ។
អំណោយ ដែល លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ឧបត្ថម្ភ ជូន គាត់ ទាំង ៨នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន រទេះ រុញ សម្រាប់ ជន ពិការ១ គ្រឿង អង្ករ មួយ បាវ តូច និង មី ចំនួន ២កេះ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ២១ ខែកក្កដា កន្លងទៅ នេះ លោក ឧត្តមសេនីយ៍ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ បាន ជូន អំណោយ រទេះ រុញ អង្ករ និង មី ជូន ដល់ ជន ពិការ នៅ សង្កាត់ លេខ ៣ ចំនួន ៥នាក់ មួយ លើក រួច មកហើយ ដោយ សរុប ទាំង ពីរ លើក លោក ឧត្តមសេនីយ៍ ស្នងការ បាន ឧបត្ថម្ភ រទេះ រុញ ជូន ជន ពិការ នៅ សង្កាត់ លេខ ៣ បាន ចំនួន ១៣នាក់ ។
ក្នុង ឱកាស នោះ ដែរ ប្រជាពលរដ្ឋ ជា ជនពិការ និង ក្រុមគ្រួសារ របស់ ពួកគាត់ បាន សំដែង នូវ ការរំភើប រីករាយ ថ្លែងអំណរគុណ ដល់ លោក ឧត្តមសេនីយ៍ ស្នងការ និង ព្រមទាំង ដឹកនាំ នារី ពេទ្យ នគរបាល ២នាក់ ចុះ សួរសុខទុក្ខ ចែក ថ្នាំ ពេទ្យ ជូន ប្រជាពលរដ្ឋ ដែល មាន ជំងឺ ស្រាល ៗ ផងដែរ ៕
អភិបាល ខេត្ត ព្រះសីហនុ ដឹកនាំ មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ ចុះ ពិនិត្យមើល ស្ថានភាព ការងារ បង្កបង្កើន ផល របស់ ប្រជាពលរដ្ឋ ក្រោយ ជំនន់ ទឹកភ្លៀង
( ព្រះសីហនុ) ៖ លោក យន្ត មីន អភិបាល ខេត្ត ព្រះសីហនុ នា ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ដឹកនាំ មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ អញ្ជើញ ចុះ ពិនិត្យមើល ស្ថានភាព ការងារ បង្កបង្កើន ផល របស់ បងប្អូន ប្រជាពលរដ្ឋ ក្រោយ ជំនន់ ទឹកភ្លៀង ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក យន្ត មីន ក៏ បាន ជួយ ស្ទូង ស្រូវ ប្រជាកសិករ ផងដែរ ដែល ស្ថិត នៅក្នុង ភូមិ វាល និង ភូមិ ថ្មី ឃុំ កំពង់សិលា ស្រុក កំពង់សិលា ខេត្ត ព្រះសីហនុ ។ ជាមួយគ្នា នេះ លោក បាន ពិនិត្យ និង ជួយ ដោះស្រាយ ឧបត្ថម្ភ ជា ពូជ ស្រូវ ជូន ប្រជាពលរដ្ឋ នៅក្នុង តំបន់ នោះ ដែល ទទួលរង នូវ ការខូចខាត កន្លងមក ដោយសារ ទឹក លិច ៕
( ដាម៉ាស់ ) ៖ ការវាយប្រហារ បំផ្ទុះ គ្រាប់បែក អត្តឃាត ដ៏ អាក្រក់ មួយ បាន កើតឡើង នៅ ភាគ ខាងត្បូង ប្រទេស ស៊ីរី នៅ ថ្ងៃពុធ នេះ ដោយ ផ្ដាច់ ជីវិត មនុស្ស យ៉ាងហោចណាស់ ៣៨ នាក់ និង រងរបួស រាប់ សិប នាក់ ទៀត ។ នេះ បើ តាម អង្គការ ឃ្លាំមើល សិទ្ធិ មនុស្ស ស៊ីរី ដកស្រង់ ដោយសារព័ត៌មាន BBC នៅ រសៀល ថ្ងៃពុធ ទី២៥ ខែកក្កដា ឆ្នាំ ២០១៨ ។
យោង តាម អង្គការ ឃ្លាំមើល សិទ្ធិ មនុស្ស ស៊ីរី ការវាយប្រហារ នេះ បាន កើតឡើង ក្បែរ ផ្សារ ដ៏ មមាញឹក មួយ កន្លែង ក្នុង ទីក្រុង ស្វេដា (Sweida) ស្ថិត ក្រោម ការគ្រប់គ្រង ដោយ រដ្ឋាភិបាល ស៊ីរី នៃ ភាគ ខាងត្បូង ប្រទេស ។ អង្គការ មួយ នេះ ក៏ បាន អះអាង ដែរ ថា មនុស្ស ច្រើន ជាង ៣០នាក់ ផ្សេង ទៀត រងរបួស ។
TOP NEWS: អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ព្រមាន ចំពោះ អ្នក ប្រឌិត ព័ត៌មាន បោកប្រាស់ ដើម្បី បំផ្លាញ ការបោះឆ្នោត
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន លើកឡើង ថា អ្នក ប្រឌិត ព័ត៌មាន ទាំងឡាយ ក្នុង ចេតនា ធ្វើឱ្យ ប៉ះពាល់ ដល់ ការបោះឆ្នោត នឹង ត្រូវ ប្រឈម នឹង ទោស ព្រហ្មទណ្ឌ ។
លោក ខៀវ សុភ័គ បាន ពន្យល់ ថា ការប្រឌិត ព័ត៌មាន ក្លែងក្លាយ ទាំងឡាយ ដើម្បី ភូត កុហក ប្រជាពលរដ្ឋ រារាំង ដល់ ការបោះឆ្នោត ខាងមុខ នេះ ក្នុង នោះ មាន ទាំង ករណី ទឹក ខ្មៅ ជាដើម ត្រូវ មាន ទោស ព្រហ្មទណ្ឌ ដែល ទោស នេះ អាច ប្រឈម នឹង ការជាប់ ពន្ធនាគារ ផងដែរ ។
ឆ្លៀត ឱកាស នេះ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ ក៏ បាន ព្រមាន ផងដែរ ចំពោះ អ្នកធ្វើ យុទ្ធនាការ ម្រាម ដៃ ស្អាត ដោយ ថា នឹង ប្រឈម ចំពោះ ច្បាប់ បោះឆ្នោត ហើយ ផាក ពិន័យ ដោយ គ.ជ.ប ។ លោក បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ និង ភ្នាក់ងារ គណបក្ស នយោបាយ នានា ដាក់ពាក្យ ប្តឹង ចំពោះ ជន ណា ដែល ធ្វើ យុទ្ធនាការ ម្រាម ដៃ ស្អាត ក្នុង ចេតនា រារាំង ដល់ ការបោះឆ្នោត ។
លោក បាន បញ្ជាក់ ថា៖ « ឆ្លៀត ឱកាស នេះ ខ្ញុំ សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឬ ភ្នាក់ងារ គណបក្ស នយោបាយ សូម ដាក់ពាក្យ ប្តឹង ទៅ គ.ជ. ប កុំ ចាំ សមត្ថកិច្ច បក្ស ណា ក៏ដោយ ឱ្យ តែ ចូលរួម ប្រកួតប្រជែង ក្នុង ការបោះឆ្នោត មាន សិទ្ធិ ដាក់ពាក្យ ប្តឹង » ។
លោក ផៃ ស៉ី ផាន៖ ការអំពាវនាវ របស់ ស្ថានទូត អាមេរិក ឲ្យ ពលរដ្ឋ ខ្លួន ប្រុងប្រយ័ត្ន ក្នុង ថ្ងៃ បោះឆ្នោត គឺជា វិធានការធម្មតា របស់ អាមេរិក ដោយសារ សង្គម អាមេរិក តែងតែ ប្រឈម នឹង ការសម្លាប់ មនុស្ស
ការចេញមុខ បកស្រាយ របស់ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង បន្ទាប់ពី ស្ថានទូត អាមេរិក ប្រចាំ នៅ កម្ពុជា បាន ចេញ សេចក្ដីជូនដំណឹង មួយ ដល់ ពលរដ្ឋ អាមេរិក ដែល កំពុង រស់ នៅ និង ធ្វើដំណើរ ទេសចរ មក ប្រទេស កម្ពុជា ឱ្យ មាន ការប្រុងប្រយ័ត្ន ចំពោះ សុវត្ថិភាព និង សន្តិសុខ ផ្ទាល់ខ្លួន ក្នុង អំឡុង ពេល នៃ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត នៅ ថ្ងៃអាទិត្យ ទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
ស្ថានទូត អាមេរិក បាន បញ្ជាក់ ថា ការបោះឆ្នោត ជាតិ ជ្រើសរើស តំណាងរាស្ត្រ ខាងមុខ នេះ អាច មាន ការជួប ប្រមូលផ្តុំ ផ្នែក នយាយ បាយ ការប្រឆាំង តវ៉ា ឬ ការចល័ត កម្លាំង សន្តិសុខ ។ ទោះបី កន្លងមក ថ្មី ៗ នេះ ការប្រមូលផ្តុំ ផ្នែក នយោបាយ ភាគ ច្រើន ពុំ មាន អំពើហិង្សា យាង ណា ក្តី ប៉ុន្តែ ការធ្វើ បាតុកម្ម ឬ ការប្រមូលផ្តុំ ផ្សេង ៗ អាច មាន ការប្រឈម ដាក់ គ្នា ដោយ មិន មាន សញ្ញា ព្រមាន ទុក ជាមុន ឡើយ ។
បើ តាម អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា ការប្រកាស ព័ត៌មាន នៃ ការណែនាំឲ្យ ប្រុងប្រយ័ត្ន ខ្ពស់ របស់ សហរដ្ឋ អាមេរិក គ្រាន់តែ កិច្ចការពារ ជាមុន ប៉ុណ្ណោះ ពុំ មែន ឆ្លើយតប នឹង ភាព ជាក់ស្តែង នោះ ឡើយ ។ លោក បន្ត ថា ព័ត៌មាន បែប នេះ ក៏ អាមេរិក ធ្លាប់ ប្រកាស ដល់ ប្រជាពលរដ្ឋ ខ្លួន ឲ្យ មាន ការប្រុងប្រយ័ត្ន ក្នុង ពិធី ប្រកួត កីឡា អន្តរជាតិ អូឡាំពិក នៅ ប្រទេស រុស្ស៉ី ផងដែរ ។
លោក ផៃ ស៉ី ផាន បាន គូសបញ្ជាក់ ថា ការប្រកាស ព័ត៌មាន របស់ ស្ថានទូត អាមេរិក ប្រចាំ កម្ពុជា ពុំ មាន ឥទ្ធិពល ឬ ឧបសគ្គ ណាមួយ ប្រឆាំង ឬ បំផ្លាញ ដំណើរការបោះឆ្នោត សកល របស់ កម្ពុជា ដែល ធ្វើឡើង មួយ ថ្ងៃ គត់ គឺ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ហើយ ការបោះឆ្នោត សកល នេះ ជា ការសម្រេចចិត្ត ខ្ពស់ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ក្នុង កិច្ច ថែរក្សា ដំណើរការលទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង ការទទួលខុសត្រូវ ជោគវាសនា ដោយ ខ្លួន ឯង ដែល គ្មាន បរទេស ណា ជ្រៀត ជ្រែក បាន ឡើយ ។
លោក បាន បន្ថែម ថា ស្ថានភាព ដំណើរការ នៃ កិច្ច យុទ្ធនាការ ស្វែងរក សន្លឹក ឆ្នោត របស់ គណបក្ស ទាំ ២០ បាន ប្រព្រឹត្តទៅ ដោយ រលូន គ្មាន ឧបទ្ទវហេតុ ទម្ងន់ ណាមួយ គួរឲ្យ ចាប់អារម្មណ៍ ឡើយ ៕
លិខិត មិត្ត អ្នកអាន៖ បោះឆ្នោត ខែកក្កដា ឆ្នាំ ២០១៨៖ ពលរដ្ឋ ជាង ៧០ % ត្រូវបាន រំពឹង ថា នឹង អញ្ជើញ ទៅ បោះឆ្នោត បំពេញ កាតព្វកិច្ច ជា ប្រជាពលរដ្ឋ ខ្មែរ (video inside) ( ភ្នំពេញ ) ៖ នៅសល់ តែ ៤ ថ្ងៃ ទៀត ប៉ុណ្ណោះ កម្ពុជា នឹង រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ដោយ មាន ការចូលរួម ប្រកួតប្រជែង ពី គណបក្ស នយោបាយ ចំនួន ២០ ដើម្បី ដណ្តើម យក អាសនៈ នៅក្នុង រដ្ឋសភា ចំនួន ១២៥ ។
ចៅ ចាក់ ស្មុក សូម ធ្វើ ការវិភាគ លើ លទ្ធភាព រំពឹងទុក នៃ ការចូលរួម បោះឆ្នោត របស់ ប្រជាពលរដ្ឋ ខ្មែរ ដូច ខាងក្រោម ដោយ ឈរ នៅលើ មូលដ្ឋាន ទិន្នន័យ របស់ គ.ជ. ប និង ការបោះឆ្នោត នា ពេល កន្លងមក៖
ដូច្នេះ ពួកគាត់ ចាំបាច់ ត្រូវ បោះឆ្នោត ជូន គណបក្ស កាន់អំណាច បន្ត ដឹកនាំ ប្រទេស ដើម្បី ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍ ដែល ខ្លួន មាន សព្វ ថ្ងៃ ឱ្យ បាន គង់វង្ស ល្អ ។ នៅតែ អតីត សកម្មជន ឆ្អិនឆ្អៅ និង អ្នកងុប ខ្លាំង នៃ ខ្មោច បក្ស សង្គ្រោះ ជាតិ តែ ប៉ុណ្ណោះ ដែល នៅ ដេក ឱប ខ្មោច បក្ស នេះ ទៀត ។ ចំណែក រូបភាព ដែល ក្រុម ខ្មោច បក្ស សង្គ្រោះ ជាតិ យកមក ឃោសនា លើ កម្រាម ដៃ និង ញុះញង់ មិន ឱ្យ ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត គឺ ភាគ ច្រើន សុទ្ធតែ អ្នក ដែល រស់ នៅ ក្រៅ ប្រទេស និង ភាគ ច្រើន គ្មាន សិទ្ធិ បោះឆ្នោត ថែម ទៀត ។
ជាមួយគ្នា នេះ បើ យោង តាម ការស្ទង់ មតិ មួយ ដែល ធ្វើឡើង លើ បណ្តាញ ហ្វេសប៊ុក ពិភព ចែករំលែក និង កម្សាន្ត ក្នុង ចំណោម គណនី ហ្វេសប៊ុក ចូលរួម បោះឆ្នោត ឆ្លើយ នឹង សំណួរ ថា តើ បងប្អូន នឹង អញ្ជើញ ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ដែរ ឬ ទេ ? លទ្ធផល ដែល បាន ប្រកាស កាលពី រាត្រី ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ ចម្លើយ គឺ ៨៤ % ឆ្លើយ ថា នឹង ទៅ បោះឆ្នោត ហើយ ១៦% ឆ្លើយ ថា នឹង មិន ទៅ បោះឆ្នោត ទេ ។ នេះ គឺ គ្រាន់តែ ជា ការស្ទង់ មតិ លើ បណ្តាញ ទំនាក់ទំនង សង្គម ប៉ុណ្ណោះ ។
អ្វី ដែល គួរឱ្យ ទុកចិត្ត បំផុត នោះ យោង តាម ការវាយតម្លៃ បឋម ដោយ ឈរ នៅលើ ទិន្នន័យ ជាក់ស្តែង នៃ ឈ្មោះ អ្នក មាន សិទ្ធិ បោះឆ្នោត នៅក្នុង បញ្ជី បោះឆ្នោត និង ចំនួន នៃ សមាជិក គណបក្ស នីមួយ ៗ និង អាត្រា នៃ ការចូលរួម បោះឆ្នោត នា ពេល កន្លងទៅ ចំនួន ពលរដ្ឋ ខ្មែរ ដែល ត្រៀមខ្លួន ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ អាចនឹង មាន ចំនួន យ៉ាងហោចណាស់ ក៏ ជាង 70% ដែរ នៃ ចំនួន អ្នក មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ឆ្នាំ ២០១៨ នេះ ៕
( ឡាវ ) ៖ អាច និយាយ បាន ថា គ្មាន នរណា នឹកស្មាន ដល់ នោះ ឡើយ អំពី ហេតុការណ៍ បាក់ ទំនប់ នៅក្នុង ខេត្ត អាត់ តាពើ ភាគ ខាងត្បូង ប្រទេស ឡាវ ដែល ជាប់ នឹង ព្រំដែន នៃ បណ្តា ខេត្ត ភាគ ឦសាន ប្រទេស កម្ពុជា នោះ ប៉ុន្តែ សោកនាដកម្ម បាន កើតមាន រួចទៅហើយ ដោយ សាកសព ចំនួន ១៧នាក់ ទើប ត្រូវបាន ស្រង់ ចេញ ចេញ ពី ក្នុង ទឹក និង រកឃើញ ខណៈ រាប់ រយ នាក់ ទៀត ត្រូវបាន គេ ជឿជាក់ ថា កំពុង បាត់ខ្លួន នៅឡើយ គិត ត្រឹម រសៀល ថ្ងៃពុធ ទី២៥ ខែកក្កដា ឆ្នាំ ២០១៨ ។
នៅក្នុង ប្រតិបត្តិការ រុករក នោះ អ្វី ដែល គួរឲ្យ ខ្លោចផ្សា បំផុត គឺ ក្រុម សង្គ្រោះ ឡាវ បាន ឃើញ សាកសព មនុស្ស ក្មេង ចាស់ ប្រុស ស្រី ដែល កប់ នៅក្នុង គំនរ ភក់ ល្បាប់ និង ផ្ទះ បាក់បែក ខណៈ មួយចំនួន ទៀត បាន អណ្តែត លើ ទឹក បន្ទាប់ ទំនប់ វារី អគ្គិសនី សេពាន - សេណាំ ណយ ក្នុង ខេត្ត ភាគ ខាងត្បូង ឡាវ ខាងលើ នេះ បាន បាក់ កាលពី ថ្ងៃអង្គារ ម្សិលមិញ ។
ខាងក្រោម នេះ ជា កម្រង រូបភាព ដ៏ គួរឲ្យ សង្វេគ ជា ទីបំផុត នៃ ការបាត់បង់ជីវិត និង ការរងទុក្ខវេទនា គ្រប់ យ៉ាង របស់ ប្រជាជន ឡាវ ដោយសារតែ ជំនន់ ទឹក បាក់ ទំនប់ ភ្លាម ៗ និង មិន មាន ការប្រកាស អាសន្ន ឲ្យ ទាន់ ពេល៖
លោក លី ធុជ៖ រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ រាជ រដ្ឋាភិបាល សម្រេចបាន សម្មិទ្ធផល យ៉ាង ធំធេង ជូន ជាតិ និង ប្រជាពលរដ្ឋ . សូម បោះ បន្ត បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា
( រតនគិរី ) ៖ លោក លី ធុជ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខេត្ត រតនគិរី បាន ថ្លែង ថា រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ រាជ រដ្ឋាភិបាល សម្រេចបាន សម្មិទ្ធផល យ៉ាង ធំធេង ជូន ជាតិ និង ប្រជាពលរដ្ឋ ដែល បាន ប្រែក្លាយ ជីវភាព ប្រជាពលរដ្ឋ មាន ការប្រែប្រួល យ៉ាង លឿន ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ។
បើ តាម លោក ទេសរដ្ឋមន្រ្តី សម្តេច តេជោ ហ៊ុន សែន បាន យក អាយុជីវិត របស់ សម្តេច ទៅ ប្តូរ យក សន្តិភាព ជូន ជាតិ មាតុភូមិ ហើយ សម្តេច មិន ខ្លាច ការនឿយ ហត់ ទេ សំខាន់ ប្រទេស កម្ពុជា មាន ឯករាជ សន្តិភាព ប្រជាធិបតេយ្យ ការអភិវឌ្ឍ និង ប្រជាពលរដ្ឋ រស់ នៅ មាន សុខដុមរមនា ។
ការរីកចំរើន នេះ បាន រីក សុះភាយ ទូទាំង ប្រទេស និយាយ ជា រួម និយាយ ដោយឡែក សម្រាប់ ខេត្ត រតនគិរី វិញ ក៏ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ផងដែរ ។ ការរីកចម្រើន ទាំងអស់ នេះ ដោយសារ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
មន្ត្រី ជាន់ ខ្ពស់ គណបក្ស ប្រជាជន កម្ពុជា បាន ថ្លែង បែប នេះ ក្នុង ឱកាស ដែល គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត រតនគិរី រៀបចំ សន្និសីទ កាសែត ស្តីពី សមិទ្ធផល ធំ ៗ របស់ ខេត្ត ក៏ ដូចជា របស់ រាជ រដ្ឋាភិបាល សម្រេចបាន ក្នុង រយៈពេល ៥ ឆ្នាំ ( ២០១៣ - ២០១៨ ) នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
លោក លី ធុជ បាន សង្កត់ធ្ងន់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន កំណត់ ចាត់ បញ្ចូល តំបន់ ភូមិភាគ ឥសាន្ត ជា តំបន់ ប៉ូល សេដ្ឋកិច្ច ទី៤ នៃ គោលដៅ អភិវឌ្ឍន៍ ជាតិ រយៈពេល វែង ដូច្នេះ ខេត្ត នៅ តំបន់ ភូមិភាគ ឥសាន្ត ពិតប្រាកដ ណាស់ ថា នឹង មាន ការរីកចម្រើន យ៉ាង ឆាប់រហ័ស មិន ចាញ់ បណ្តា ខេត្ត ផ្សេង នោះ ទេ ។
ទន្ទឹម នោះ ដែរ លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម បន្ត គាំទ្រ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បន្ត ដឹកនាំ ប្រទេស ឲ្យ មាន សុខ សន្តិភាព ភាពរុងរឿង និង រីកចម្រើន តទៅ មុខ ទៀត ៕
( កំពង់ចាម ) ៖ កម្លាំង អន្ដរាគមន៍ ពិសេស នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ប្រមូលផ្ដុំ គ្នា ដើម្បី រំលឹក និង ពង្រឹង សមត្ថភាព ឡើងវិញ ដើម្បី ត្រៀម បង្ក្រាប រាល់ សកម្មភាព ទាំងឡាយ ណា ដែល មាន បំណង ចង់ បំផ្លិត បំផ្លាញ ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ ដែល នឹង ធ្វើឡើង នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
ជាក់ស្ដែង នៅ ព្រឹក មិញ នេះ កង អន្តរាគមន៍ ពិសេស ១២០ នាក់ និង កង អន្តរាគមន៍ ជំនួយ ១២០ នាក់ សរុប ២៤០ នាក់ បាន បន្ដ ការហ្វឹកហាត់ រំលឹក មេរៀន លើ ទីលាន ជាក់ស្ដែង ដោយ ប្រើប្រាស់ កម្លាំង ទាំងមូល រួម មាន បច្ចេកទេស ប្រើប្រាស់ អាវុធ Land ផ្សែង . របៀប គប់ គ្រាប់បែក ផ្សែង . រូបភាព ទប់ស្កាត់ ហ្វូង បាតុករ . ការប្រើប្រាស់ គ្រាប់ បំពង សម្លេង ចាប់ មុខ សញ្ញា និង ការប្រើប្រាស់ ឡាន ទឹក ក្នុង នោះ មាន ឡាន ទឹក២ គ្រឿង និង ឡានពេទ្យ សម្រាប់ អម១ គ្រឿង ផងដែរ ។
ស្នងការ នគរបាល ខេត្ត កំពង់ចាម លោក ឧត្តមសេនីយ ទោ ឯ ម កុសល បាន ឲ្យដឹង ថា ការរំលឹក មេរៀន ឡើងវិញ នេះ ពាក់ព័ន្ធ ការងារ ពង្រឹង សមត្ថភាព កងកម្លាំង ដែល បាន បំប៉ន ការងារ ជំនាញ នា ពេល កន្លងទៅ ដើម្បី ការពារ សន្ដិ សណ្ដាប់ធ្នាប់ សុវត្ថិភាព សង្គម និង បង្ក្រាប បទល្មើស គ្រប់ ប្រភេទ ក្នុង មូលដ្ឋាន តាម បទបញ្ជា របស់ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល . ក្រសួង មហាផ្ទៃ . អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ និង គណៈ បញ្ជាការ ឯកភាព ខេត្ត ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ កងកម្លាំង អន្ដរាគមន៍ ពិសេស នេះ បាន ខិតខំ យកចិត្ដទុកដាក់ បង្ការ បង្ក្រាប បទល្មើស គ្រប់ ប្រភេទ នៅក្នុង មូលដ្ឋាន ឲ្យ ទទួលបាន បរិយាកាស ល្អ ដើម្បី បម្រើ ឲ្យ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ បាន ប្រព្រឹត្តទៅ ដោយ រលូន គ្មាន ការរំខាន ។
លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន គូសបញ្ជាក់ ថា គ្រូ ដែល មក ហ្វឹកហ្វឺន នេះ គឺ មកពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ តាម ការស្នើសុំ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម ដូច្នេះ ទើប នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ លោក បាន ចាត់ បញ្ជូន មក តែម្ដង ។
ជាមួយគ្នា នេះ លោក ឧត្តមសេនីយ៍ ស្នងការ បាន ផ្តាំផ្ញើ ដល់ កងកម្លាំង ដែល ជា កម្លាំង របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ប្រជាពលរដ្ឋ គ្រប់ រូប ត្រូវ ត្រៀម ឯកសារ ពាក់ព័ន្ធ ការបោះឆ្នោត ត្រូវតែ ចូលរួម ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា និង ជំរុញ ផ្សព្វផ្សាយ ដល់ ក្រុមគ្រួសារ ឲ្យ ចូលរួម បោះឆ្នោត ព្រោះ ជា កាតព្វកិច្ច របស់ ពលរដ្ឋ ដើម្បី ជ្រើសរើស ថ្នាក់ដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន សន្តិភាព សុវត្ថិភាព ស្ថេរភាព តាម បែប លទ្ធិ ប្រជាធិបតេយ្យ ។
សូម ជម្រាប ថា ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម បាន ត្រៀម សម្រាប់ រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ដំណើរការបោះឆ្នោត នេះ មាន ចំនួន ៤. ០២៨ នាក់ ដោយ មាន ទាំង កម្លាំង ត្រៀម អន្ដរាគមន៍ ២៤ ម៉ោង លើ ២៤ ម៉ោង និង កម្លាំង ដែល រៀបចំ តាម ផែនការ ៕ ជូនដំណឹង ! រដ្ឋបាល ខេត្ត ព្រះវិហារ ដាក់ ឲ្យ ដំណើរការ អង្គភាព ច្រក ចេញ - ចូល តែ មួយ ដើម្បី សម្រួល ការផ្តល់ សេវា នានា ជូន ដល់ ប្រជាពលរដ្ឋ មាន ភាពងាយស្រួល
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ បាន បើក កិច្ចប្រជុំ ត្រួតពិនិត្យ ដាក់ ឲ្យ ដំណើរការ អង្គភាព ច្រក ចេញ ចូល តែ មួយ របស់ សាលា ខេត្ត នា រសៀល ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៨ ក្រោម វត្តមាន លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត និង មាន ការចូលរួម ពីរ ថ្នាក់ដឹកនាំ មន្រ្តី សាលា ខេត្ត មន្ទីរ ស្ថាប័ន នានា មន្រ្តី រាជការ អង្គភាព ច្រក ចេញ - ចូល មាន មន្រ្តី ជួរ មុខ និង មន្រ្តី ជួរ ក្រោយមកពី មន្ទីរ វិស័យ នានា ជាច្រើន រូប ទៀត ។
ក្រៅពី វិស័យ ទាំង ១២នេះ ក៏ មាន ការិយា័យ ប្រជាពលរដ្ឋ មួយ ចាំ ឃ្លាំមើល និង ជួយ ធ្វើ ការសម្របសម្រួល ក្នុង ដែន សមត្ថកិច្ច អង្គភាព ខ្លួន ដោយ មាន ផ្នែក ទទួល ពាក្យបណ្តឹង និង កិច្ចការ រដ្ឋបាល និង ផ្នែក ច្បាប់ និង ស៊ើបអង្កេត ចាំ បម្រើ ប្រជាពលរដ្ឋ ផងដែរ ។
លោក អ៊ុន ចាន់ ដា បាន បន្ថែម ថា ដើម្បីឲ្យ កិច្ចការ ដំណើរការ ទៅ ដោយ រលូន បាន គឺ មន្រ្តី អង្គភាព ច្រក ចេញ - ចូល តែ មួយ ទាំងអស់ ទាំង ជួរ មុខ និង ជួរ ក្រោយ ត្រូវ សហការ គ្នា ដោយ មាន ការសម្របសម្រួល ពី រដ្ឋបាល ខេត្ត ផង នោះ យើង នាំគ្នា បម្រើ សេវា រដ្ឋបាល ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ចាប់ពី ពេលនេះ តទៅ ។
ដូច្នេះ សូម ប្រញ៉ាប់ ឡើង ! ជ្រើសរើស ដែក ថែប អ៊ីតាលី ម៉ាក វី សម្រាប់ ការសាងសង់ របស់ លោក អ្នក ដើម្បី សំណង់ រឹងមាំ និង រង្វាន់ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ ។
អាជ្ញាធរ ឡាវ កំពុង បង្កើន កិច្ច ខិតខំ ប្រឹងប្រែង ស្វែងរក អ្នក នៅរស់រាន មាន ជីវិត ខណៈ មនុស្ស ច្រើន ជាង ១០០ នាក់ នៅតែ បន្ត បាត់ខ្លួន នៅឡើយ ហើយ រាប់ ពាន់ នាក់ ទៀត បាន បាត់បង់ ផ្ទះសម្បែង របស់ ពួកគេ ។ អាជ្ញាធរ ឡាវ កាលពី ថ្ងៃអង្គារ ម្សិលមិញ បាន រាយការណ៍ ថា ទំនប់ វារី អគ្គិសនី មួយ កន្លែង បាន ដួលរ លំ នៅ ខេត្ត Attapeu ( អាត់ តាពើ ) ភាគ អាគ្នេយ៍ ប្រទេស ឡាវ ជាប់ ព្រំដែន ខេត្ត ស្ទឹងត្រែង ព្រមទាំង ខេត្ត រតនៈគិរី ភាគ ឦសាន នៃ ប្រទេស កម្ពុជា ។
តាម ការព្យាករ របស់ គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា ចំនួន អ្នក ចុះឈ្មោះ អាចនឹង កើនឡើង ដល់ ទៅ ៤.០០០ នាក់ មុន ការប្រកួត មកដល់ នៅ ថ្ងៃទី ០៥ ខែសីហា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ហើយ កីឡាករ ដែល មក ចូលរួម ព្រឹត្តិការណ៍ នេះ មាន រហូត ទៅដល់ ជាង ៤០ ប្រទេស ឯណោះ ។
ដោយឡែក សម្រាប់ ការរៀបចំ សណ្តាប់ធ្នាប់ និង បច្ចេកទេស សម្រាប់ ការរត់ នេះ គណៈកម្មការ បាន រៀបចំ រួចរាល់ អស់ ហើយ ដែល រួម មាន ទាំង ការទំនុកបម្រុង ភេសជ្ជៈ ប៉ូវ កម្លាំង វើក (WURKZ) និង ទឹក សុទ្ធ កម្ពុជា ផងដែរ ពី ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស សម្រាប់ កីឡាករ ទាំងអស់ តែម្តង នៅ តាម ផ្លូវ រត់ នីមួយ ៗ ។
ដូច្នេះ ទាំង គណៈកម្មការរៀបចំ ការ រត់ ប្រណាំង ម៉ារ៉ាតុង និង ដៃគូរ ឧបត្ថម្ភ ធំ ភេសជ្ជៈ ប៉ូវ កម្លាំង វើក (WURKZ) បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បី ទទួលស្វាគមន៌ កីឡាករ ទាំងអស់ នៅ ខេត្ត សៀមរាប ។
ថ្លែង នៅក្នុង កិច្ចប្រជុំ ក្រុមប្រឹក្សា សន្តិសុខ UN ស្ដីពី តំបន់ មជ្ឈិមបូព៌ា នៅ ថ្ងៃអង្គារ សប្ដាហ៍ នេះ ( ម៉ោង នៅ អមេរិក ) លោកស្រី Nikki Haley បាន និយាយ ដោយ ត្រង់ ៗ តែម្ដង ថា ប្រទេស ដូចជា អេហ្ស៊ីប គុយ វ៉ែត អេមីរ៉ាត អារ៉ាប់ រួម អាល់ហ្សេរី ទុយនីស៊ី តួកគី ប៉ាគីស្ថាន អូម៉ង់ អ៊ីរ៉ង់ និង តួកគី ពោល គឺ ប្រទេស ជា សមាជិក អង្គការ កិច្ចសហប្រតិបត្តិការ អ៊ីស្លាម OIC មួយចំនួន ធំ មិន បាន ផ្ដល់ ជំនួយ គ្រប់គ្រាន់ ដល់ ប្រជាជន ប៉ាឡេស្ទីន នោះ ទេ ។
លោកស្រី Haley បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « ពាក្យសម្ដី និយាយ នៅ ទីនេះ ក្នុង ទីក្រុង ញូយ៉ក មិន អាច ចិញ្ចឹម ផ្ដល់ សម្លៀកបំពាក់ ឬ ការអប់រំ ដល់ កុមារ ប៉ាឡេស្ទីន សូម្បីតែ ម្នាក់ ... ចំណែកឯ យើង វិញ បាន ផ្ដល់ ជំនួយ ច្រើន ជាង ១២៥ លាន ដុល្លារ កាលពី ឆ្នាំ មុន ដែល នេះ ឱ្យ យើង ជឿជាក់ ថា យើង បាន ឆ្លើយតប គ្រប់គ្រាន់ ដល់ ប្រជាជន ប៉ាឡេស្ទីន ដែល ត្រូវការ ជំនួយ ជា ចាំបាច់ » ។
( កោះកុង ) ៖ ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ បាក់ អង្រុត ឃុំ ដង ពែង ខេត្ត កោះកុង រាប់ រយ គ្រួសារ បើ ទោះ នៅ ពេល នេះ បាន ទទួល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ក៏ដោយ ក៏ នៅតែ ប្រកាស ថា នឹង ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នឹង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ។
ពួកគាត់ បាន បន្ត ថា មិន ត្រឹមតែ ទឹក ជំនន់ ទេ ពួកគាត់ មាន ផ្លូវ ល្អ មាន សាលារៀន សម្រាប់ កូន ៗ រៀនសូត្រ មាន វត្ត អារាម ងាយស្រួល ណាស់ ឥឡូវ ក្នុង ការធ្វើដំណើរ ចេញ ចូលទៅ លំនៅដ្ឋាន ហេតុ ដូច្នេះ ពួកគាត់ សន្យា ថា នឹង ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា មាន លេខរៀង ទី២០ ដែល ប្រព្រឹត្ត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ខាងមុខ នេះ ( បោះឆ្នោត ជូន សម្តេច ហ៊ុន សែន ដើម្បី សុខ សន្តិភាព ស្ថិរភាព និង អភិវឌ្ឍន៍ ) ។
ពួកគាត់ មិន ឱ្យ របប វាល ពិឃាត អត់ឃ្លាន ឪពុក ម្តាយ មិន ស្គាល់ កូន កូន មិន ស្គាល់ ឪពុក ម្តាយ បង មិន ស្គាល់ ប្អូន ប្អូន មិន ស្គាល់ បង សម្លាប់ មនុស្ស មិន ញញើត ដៃ វិល មក វិញ ឡើយ ដាច់ខាត ។ នៅ ពេល នេះ ពួកគាត់ មាន សេរីភាព ពេញលេញ ក្នុង រស់ នៅ ដូច្នេះ ពួកគាត់ នឹង នាំគ្នា ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន ដោយ មិន ជឿ សម្តី ពួក ក្បត់ ជាតិ ឡើយ ៕ លោក ជា វ តាយ៖ មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល ធ្វើឲ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ និង សន្តិភាព
( កំពត ) ៖ លោក ជា វ តាយ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត បាន លើកឡើង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល ជា ក្តីសង្ឃឹម របស់ ពលរដ្ឋ និង ប្រទេសជាតិ ទាំងមូល ដែល ធ្វើឲ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ និង នាំមក នូវ សុខ សន្តិភាព ។
លោក លើកឡើង បែប នេះ ក្នុង ពិធី អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ប្រមាណ ៣.០០០ នាក់ ក្នុង បរិវេណ វត្ត រកា ស្ថិត នៅ ភូមិ គីឡូ ១២ ឃុំ កោះ តូច ស្រុក ទឹក ឈូ ខេត្ត កំពត នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
មន្ត្រី ជាន់ ខ្ពស់ គណបក្ស ប្រជាជន កម្ពុជា រូប នេះ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២១៨ នេះ ជូន គណបក្ស ប្រជាជន កម្ពុជា លេខរៀង ទី២០ មាន រូប សញ្ញា ទេវតា បាច ផ្កា ដើម្បី ផ្តល់ ឱកាស ដល់ សម្តេច តេជោ ហ៊ុន សែន បន្ត ដឹកនាំ ប្រទេស កម្ពុជា បន្ត ទៀត ដើម្បីឲ្យ សង្គមជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ កាន់តែ មាន រីកចម្រើន ៕
( ភ្នំពេញ ) ៖ អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា លោក ឡេង ប៉េង ឡុង បាន បញ្ជាក់ ទៅ គណបក្ស សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ (LDP) ថា អនុលោម តាម រដ្ឋធម្មនុញ្ញ រដ្ឋសភា មិន អាច បញ្ជា ឬ ចាត់ចែង លើ ការងារ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន នោះ ឡើយ ។ មួយ វិញទៀត ការគូស សញ្ញា គាំទ្រ គណបក្ស នយោបាយ មាន ច្រើន ប្រភេទ ត្រូវបាន អនុវត្ត តាំងពី ការបោះឆ្នោត អាណត្តិទី១ នា ឆ្នាំ ១៩៩៣ មក ម្ល៉េះ ។
ការបញ្ជាក់ បែប នេះ បន្ទាប់ពី ប្រមុខ គណបក្ស LDP លោក ខឹម វាសនា បាន ស្នើ ទៅកាន់ សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា ឲ្យ មាន ចំណាត់ការ ទៅ លើ ការងារ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ដោយ ចង់ឲ្យ មាន ការ គូស សញ្ញា ធីក តែ មួយ នៅលើ សន្លឹក ឆ្នោត ។
លិខិត ឆ្លើយតប ទៅ លោក ខឹម វាសនា ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក ឡេង ប៉េង ឡុង បាន បញ្ជាក់ ថា រដ្ឋសភា បាន បិទ បញ្ចប់ សម័យ ប្រជុំ របស់ ខ្លួន តាំងពី ថ្ងៃទី ០៩ ខែកក្កដា ឆ្នាំ ២០១៨មក ម្ល៉េះ ។ បច្ចុប្បន្ន រដ្ឋសភា មាន សិទ្ធិ ត្រឹមតែ អនុវត្ត ការងារ ប្រចាំ ថ្ងៃ ប៉ុណ្ណោះ ពុំ អាច ចាត់ចែង ការងារ ដទៃ បាន ឡើយ ជាពិសេស ការងារ ពាក់ព័ន្ធ នឹង ស្ថាប័ន ដទៃ ដូចជា គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ជាដើម ។
យោង តាម មាត្រា ទាំង ពីរ ខាងលើ នេះ លោក ឡេង ប៉េង ឡុង បាន បញ្ជាក់ ថា រដ្ឋសភា ពុំ មាន សមត្ថកិច្ច ជ្រៀត ជ្រែក ឬ បង្គាប់បញ្ជា កិច្ចការ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ដែល ជា ស្ថាប័ន ឯករាជ្យ បាន ឡើយ ។
ពិធី នេះ ប្រារព្ធ ធ្វើឡើង នៅ បញ្ជាការដ្ឋាន អាវុធហត្ថ ខេត្ត មណ្ឌលគិរី ដោយ មាន ការចូលរួម ពី លោក មេបញ្ជាការ រង លោក នាយ រង សេនាធិការ ប្រធាន អនុប្រធាន មន្ទីរ មេបញ្ជាការ មូលដ្ឋាន ក្រុង ស្រុក និង នាយ - នាយ រង កងរាជអាវុធហត្ថ ខេត្ត និង សមាជិក សមាជិកា ផងដែរ ។
ថ្លែង ក្នុង ពិធី នោះ លោក ហែម បូណារ៉ែ ល បាន ថ្លែង ថា ដោយ មាន ការដឹកនាំ ប្រកបដោយ ភាពប៉ិនប្រសព្វ ឈ្លាសវៃ និង ការយកចិត្តទុកដាក់ ខ្ពស់ របស់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ ស្តីទី នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ព្រមទាំង មាន ការប្រឹងប្រែង របស់ បងប្អូន កន្លងមក ក្នុង ការហ្វឹកហ្វឺន រៀនសូត្រ និង ការអនុវត្ត ការងារ ទទួលបាន ជោគជ័យ និង ស្នាដៃ ជាច្រើន ទើប ថ្នាក់ដឹកនាំ បាន សម្រេច ប្រគល់ ភារកិច្ច ថ្មី និង ដំឡើង ឋានន្តរសក្តិ ជូន ដល់ បងប្អូន ។
ជាពិសេស ត្រូវ លើក កំពស់ ស្មារតី ស្រឡាញ់ ជឿជាក់ ស្មោះត្រង់ ប្តេជ្ញា ការពារ នូវ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នៅ គ្រប់ កាលៈទេសៈ មិន ឱ្យ មាន បដិវត្ត ពណ៌ កើតឡើង ជាដាច់ខាត ។
ទទ្ទឹម នឹង នេះ លោក មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត បាន ធ្វើ ការស្តីបន្ទោស ខ្លាំង ៗ ចំពោះ ដល់ មន្រ្តី អាវុធហត្ថ មួយចំនួន ជា មេបញ្ជាការ រង អាវុធហត្ថ ខេត្ត ក៏ ដូចជា មន្រ្តី ស្ពឹក ស្រពន់ ផងដែរ ចូរ ធ្វើ ការកែប្រែ នូវ ទម្លាប់ មិន ល្អ ចោល ឲ្យ អស់ ជ្រើស យក គំរូល្អ ៗ មក អនុវត្ត បទបញ្ជា វិន័យ ក្នុង អង្គភាព ឲ្យបាន ល្អ ប្រសើរ ។
ជាង នេះ ទៅ ទៀត លោក បាន ក្រើន រំលឹក ដល់ នាយ ទាហាន នាយ ទាហាន រង នៃ កងរាជអាវុធហត្ថ ខេត្ត ទាំងអស់ រួម ជាមួយ បងប្អូន ក្រុមគ្រួសារ សាច់ញាតិ ដែល បាន ចុះឈ្មោះ បោះឆ្នោត រួចហើយ សូម បំពេញ កាតាព្វកិច្ច របស់ ខ្លួន ជា ប្រជាពលរដ្ឋ ទៅ ចូលរួម បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ឱ្យ បាន គ្រប់ ៗ គ្នា កុំបី ខាន ៕
លោក មាស សុភា ប្រាប់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ចូលរួម ថែរក្សា សុខ សន្តិភាព នេះ ឲ្យ នៅ គង់វង្ស ដើម្បីឲ្យ ប្រទេស យើង កាន់តែ ទទួលបាន ការអភិវឌ្ឍ តទៅទៀត
នៅក្នុង ឱកាស នោះ លោក មាស សុភា បាន ប្រាប់ សមាជិក បក្ស ក៏ ដូចជា ប្រជាពលរដ្ឋ អំពី ការរីកចំរើន គ្រប់ វិសយ័ របស់ ប្រទេស ជាង ៣០ ឆ្នាំ កន្លងមក នេះ ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ហើយ ការរីកចំរើន របស់ ប្រទេសជាតិ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ដោយសារតែ ប្រទេស យើង មាន សុខ សន្តិភាព មាន ស្ថេរភាព នយោបាយ គ្មាន តំបន់ អប្បគមន៍ ។ ដូច្នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ យើង ត្រូវ ចូលរួម ថែរក្សា សុខ សន្តិភាព នេះ ឱ្យ នៅ គង់វង្ស ដើម្បីឱ្យ ប្រទេស យើង កាន់តែ ទទួលបាន ការអភិវឌ្ឍ តទៅទៀត ។
ស្រប ពេល ដែល ថ្ងៃ បោះឆ្នោត ជិត ចូល មកដល់ លោក មាស សុភា បាន អំពាវនាវ ឱ្យ សមាជិក គណបក្ស ក៏ ដូចជា ប្រជាពលរដ្ឋ ទាំងអស់ សូមអញ្ជើញ ទៅ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ ដើម្បីឱ្យ គណបក្ស ប្រជាជន កម្ពុជា បាន ដឹកនាំ ប្រទេសជាតិ បន្ត ទៅ ទៀត ។
លោក មាស សុភា បាន ធ្វើ ការគូសបញ្ជាក់ ផងដែរ ថា មាន គណបក្ស ប្រជាជន កម្ពុជា មាន សម្តេច តេជោ ហ៊ុន សែន ទើប ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ ដូច្នេះ សូម បងប្អូន អញ្ជើញ ទៅ បោះឆ្នោត គ្រប់ គ្នា ។ លោក ក៏ បាន ថ្លែង នូវ ការអរគុណ ដល់ ក្រុមការងារ ថ្នាក់ កណ្តាល ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក គូលែនក៍ ដូចជា ប្រធាន អនុប្រធាន គណបក្ស មូលដ្ឋាន ដែល បាន ខិតខំ បំពេញ ការងារ ក្នុង បុព្វហេតុ គណបក្ស ប្រជាជន កម្ពុជា ។
ដោយឡែក លោក អ៊ុន ចាន់ ដា សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ បាន ឡើង អាន សារ នយោបាយ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ សមាជិក គណបក្ស និង ប្រជាពលរដ្ឋ បាន យល់ ជ្រួតជ្រាប ផងដែរ ។
ជាមួយគ្នា នេះ លោក អ៊ុន ចាន់ ដា បាន បង្ហាញ មុខ បេក្ខភាព តំណាងរាស្ត្រ ថ្មី ទាំង ៧រូប របស់ គណបក្ស ប្រជាជន កម្ពុជា មណ្ឌល ព្រះវិហារ អាណត្តិ ទី៦ នេះ រួម មាន ទី១៖ លោក មាស សុភា បេក្ខភាព តំណាងរាស្ត្រ ពេញ សិទ្ធិ ឈរ លំដាប់ លេខរៀង ទី១ ទី២៖ លោក សួស យ៉ារ៉ា ទី៣៖ លោក ឡុង សុវណ្ណ ទី ៤៖ លោក ណែម វ៉ា ទី៥៖ លោក ខូយ ឃុន ហ៊ ទី៦៖ លោក យ៉ុង គឹម ហ៊ាន និង ទី៧៖ លោកស្រី ខូយ ប៊ុន ថាន ៕
CSX: កំណើន នៃ បរិមាណ បញ្ជាទិញ នៅ ផ្សារ មូលបត្រ បង្ហាញ ថា តម្រូវការ ភាគហ៊ុន មាន ការកើនឡើង
បើ តាម អ្នករៀបចំ ព្រឹត្តិការណ៍ ខាងលើ ក្នុង ចំណោម អ្នកចូលរួម ទាំងអស់ ប្រទេស រុស្ស៊ី បាន បញ្ជូន ក្រុម ធំ ជាង គេ បង្អស់ ដែល មាន សមាជិក ចំនួន ដល់ ទៅ ១៣នាក់ ចំណែកឯ ពី ឡុត មកពី ប៉ូឡូញ អូទ្រី ស អាល្លឺម៉ង់ ចិន អ៊ុយក្រែន និង បេឡារុស ផ្ទាល់ ក៏ បាន មក ចូលរួម ប្រកួតប្រជែង ដើម្បី ដណ្តើម យក មេដាយ ផងដែរ ។
គួរ ជម្រាប ថា កម្មវិធី អាកាសចរណ៍ ប្រចាំ ឆ្នាំ ឈ្មោះ ថា ប្រូណេបូ (ProNebo) ក៏ នឹង ប្រារព្ធ ឡើង ជា ផ្នែក នៃ ព្រឹត្តិការណ៍ ប្រកួតប្រជែង នេះ ផងដែរ នា ថ្ងៃទី ២៨ និង ទី២៩ ខែកក្កដា ខណៈ អ្នកទស្សនា នឹង បាន មើលឃើញ យន្តហោះ ព្រមទាំង បាឡុង ជាង ៣០ គ្រឿង ហើយ ការប្រណាំង ឧទ្ធម្ភាច ក្រ ត្រូវ គេ រំពឹង ថា នឹង ជា ទស្សនីយភាព ដ៏ ពិសេស មួយ នៃ កម្មវីធី នោះ ៕ លោក ព្រុំ សុខា៖ ប្រជាធិបតេយ្យ ត្រូវ ផ្សារភ្ជាប់ នឹង នីតិរដ្ឋ ដូចជា សិទ្ធិ មិន អាច កាត់ផ្តាច់ បាន ពី ករណី យកិច្ច
( ព្រៃវែង ) ៖ ក្នុង កម្មវិធី ពីរ ដាច់ដោយឡែក ពី គ្នា គឺ នៅពេលព្រឹក ថ្ងៃទី ២៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក ព្រុំ សុខា ប្រធាន ក្រុមការងារ ស្រុក បាភ្នំ បាន ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ក្នុង ឃុំ រក្ស ជ័យ ទាំងមូល ប្រមាណ ចំនួន ១៦០០ នាក់ និង នៅ រសៀល ថ្ងៃ ដដែល លោក ប្រធាន ក្រុមការងារ ក៏ បាន ជួបប្រជុំ ការងារ ជាមួយ មន្ត្រី ក្រុមការងារ ទាំងអស់ និង មន្ត្រី មូលដ្ឋាន មកពី ឃុំ ទាំង៩ ភូមិ ទាំង ១០៨ ក្នុង ស្រុក ទាំងមូល សរុប ទាំងអស់ ប្រមាណ ចំនួន ៤៥០ នាក់ ។
យុទ្ធនាការ « ម្រាម ដៃ ស្អាត » របស់ ក្រុម ប្រឆាំង ខុស ច្បាប់ កំពុងតែ បាន បង្ហាញ ច្បាស់ នូវ សារជាតិ ក្រឡិច ក្រឡុច ប្រជា ភិថុត អាត្មា និយម និង ឱកាស និយម របស់ ពួកគេ ជាក់ស្តែង ក្នុង ការបោះឆ្នោត កន្លងទៅ ពួក នេះ តែងតែ មូល បង្កាច់ បំផ្លើស ការពិត ថ្កោល ទោស ថា មាន ការគំរាមកំហែង រារាំង ប្រជាពលរដ្ឋ មិន ឱ្យ ទៅ ចុះឈ្មោះ បោះឆ្នោត និង ទៅ ចូលរួម បោះឆ្នោត គួបផ្សំ ជាមួយនឹង ការប្រឌិត ដទៃ ទៀត ធ្វើ ការតវ៉ា ប្រឆាំង ជារៀងរាល់ លើក ចំពោះ លទ្ធផល នៃ ការបោះឆ្នោត ក្រោម លេស នៃ របស់ ដែល ហៅ ថា « បាតុភាព មិន ប្រក្រតី » ។
ហេតុ នេះ យើង ទាំងអស់ គ្នា ដែល ជា ប្រជាពលរដ្ឋ កម្ពុជា ត្រូវ អនុវត្ត សិទ្ធិ និង ករណី យកិច្ច របស់ ខ្លួន ដើម្បី ទៅ ចូលរួម ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ កុំបី ខាន ។
បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ឱ្យ ទទួលបាន ជ័យជំនះ ដើម្បី សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន បន្ត ដឹកនាំ ប្រទេសជាតិ ក្នុង ឯករាជ្យ សន្តិភាព សេរីភាព ប្រជាធិបតេយ្យ អព្យាក្រឹត្យ និង វឌ្ឍនភាពសង្គម ទៅ មុខ ទៀត ជារៀងរហូត ៕
ទេសរដ្ឋមន្រ្តី លោក ឆាយ ថន៖ មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល បាន នាំមក នូវ អ្វី ៗ គ្រប់ យ៉ាង ជូន ពលរដ្ឋ កម្ពុជា ជាពិសេស នាំមក នូវ សុខ សន្តិភាព ជូន ជាតិ
( កំពង់ស្ពឺ ) ៖ លោក ឆាន ថន សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ បាលើកឡើង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល បាន នាំមក នូវ អ្វី ៗ គ្រប់ យ៉ាង ជូន ប្រជាពលរដ្ឋ កម្ពុជា ជាពិសេស គឺ បាន នាំមក នូវ សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សណ្តាប់ធ្នាប់ សាធារណៈ និង ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ដូច បច្ចុប្បន្ន នេះ ។
លោក ឆាន ថន បាន ថ្លែង បែប នេះ នៅ ទី២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ នៅក្នុង ឱកាស លោក បាន ដឹកនាំ ក្រុមការងារ អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ចំនួន ៥០០ នាក់ មកពី ៥ភូមិ ក្នុង ឃុំ អម លាំង ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ ។
លោក ឆាន ថន បាន បន្ថែម ថា ទឹក ជំនន់ នៅ តាម តំបន់ មួយចំនួន នៃ ខេត្ត កំពង់ស្ពឺ ឬ ប្រទេស កម្ពុជា គឺ មាន តែ គណបក្ស ប្រជាជន តែ មួយ គត់ ជួយ បងប្អូន ប្រជាពលរដ្ឋ ដោយ គ្មាន ការរើសអើង ទោះបី មាន និន្នាការ នយោបាយ ខុសគ្នា ក៏ដោយ ។ គណបក្ស ប្រជាជន ឈ្នះ គឺ ប្រជាពលរដ្ឋ ឈ្នះ ទាំងអស់ គ្នា ។
ជាមួយគ្នា នេះ លោក ឆាន ថន ក៏ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ ពី ការសួរសុខទុក្ខ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល សម្តេច តែងតែ យកចិត្តទុកដាក់ គិតគូរ ខ្ពស់ ដល់ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ កម្ពុជា ទូទៅ ក៏ ដូចជា បងប្អូន កម្មករ កម្មការ នី យើង ដោយ បាន ដាក់ចេញ នូវ គោល នយោបាយ គាំពារ សង្គម ជាច្រើន ជា បន្តបន្ទាប់ សំដៅ ចូលរួម កាត់បន្ថយ ភាពក្រីក្រ លើកស្ទួយ កម្រិត ជីវភាព របស់ បងប្អូន ប្រជាពលរដ្ឋ បងប្អូន កម្មករ កម្មការ នី ឱ្យ កាន់តែ មាន ជីវភាព ធូរធាឡើង ។
លោក បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ សមាជិក សមាជិកា បក្ស សូម ចូលរួម រក្សា សន្តិភាព ទាំងអស់ គ្នា កុំ ចូលរួម ឬ ប្រព្រឹត្ត សកម្មភាព ខុស ច្បាប់ តាម ការឃោសនា ភូតភរ កុហក បោកប្រាស់ របស់ ក្រុម ជ្រុល និយម មួយ ចំនួន ហើយ សូម បងប្អូន ចូលរួម បំពេញ កាតព្វកិច្ច ជា ពលរដ្ឋ កម្ពុជា ស្រប ច្បាប់ តាមរយៈ ការចូលរួម បោះឆ្នោត ដើម្បី ជ្រើសរើស មេដឹកនាំ ដ៏ ល្អ សម្រាប់ ដឹកនាំ នាវា កម្ពុជា ឱ្យ រីកចម្រើន អភិវឌ្ឍន៍ លូតលាស់ បន្ត ទៅ មុខ ទៀត ។
ដូច្នេះ សូម បងប្អូន អញ្ជើញ ទៅ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បន្ត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ បន្ត ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ និង ដើម្បី ជីវភាព អនាគត របស់ កូន ចៅ យើង ជាបន្ត ទៀត ៕
អគ្គ មេបញ្ជាការទ័ព អ៊ីរ៉ង់ ប្រកាស ថា « កងទ័ព អ៊ីរ៉ង់ កំពុង ប្រុង ជើង ការរួច ជាស្រេច » ចំពោះមុខ ការគំរាមកំហែង ពី អាមេរិក និង អ៊ីស្រាអែល !
( តេហេរ៉ង់ ) ៖ កងទ័ព អ៊ីរ៉ង់ កំពុង ត្រៀមខ្លួន ក្នុង កំរិត ខ្ពស់ ដើម្បី ឆ្លើយតប ទៅនឹង ការគំរាមកំហែង ណាមួយ បន្ទាប់ពី មាន ការ ព្រមាន ពីសំណាក់ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ។ នេះ បើ តាម មេបញ្ជាការ កំពូល អ៊ីរ៉ង់ ម្នាក់ ដកស្រង់ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃពុធ ទី២៥ ខែកក្កដា ឆ្នាំ ២០១៨ ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ពេជ សោភ័ន សមាជិក គណៈកម្មាធិការ កណ្ដាល និង ជា អនុប្រធាន អចិន្ដ្រៃយ៍ គណៈកម្មាធិការ បក្ស នៃ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ប្រាប់ ឲ្យ មន្ដ្រីរាជការ លោកគ្រូ អ្នកគ្រូ នៃ អគ្គ នាយកដ្ឋាន អប់រំ បណ្ដុះ បណ្ដាញ បច្ចេកទេស និង វិជ្ជាជីវៈ ខិតខំ ប្រឹងប្រែង ធ្វើ យ៉ាងណា ជួយ ឲ្យ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន មាន វិជ្ជាជីវៈ ជំនាញ មួយ ច្បាស់លាស់ ។
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក បណ្ឌិត ពេជ សោភ័ន អញ្ជើញ ចូលរួម ជា អធិបតីភាព ក្នុង ពិធី សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ មន្ដ្រីរាជការ លោកគ្រូ អ្នកគ្រូ នៃ អគ្គ នាយកដ្ឋាន អប់រំ បណ្ដុះ បណ្ដាញ បច្ចេកទេស និង វិជ្ជាជីវៈ នា ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
ថ្លែង ក្នុង ពិធី នោះ លោក បណ្ឌិត ពេជ សោភ័ន បាន លើកឡើង ថា « អស់ លោក មន្ដ្រីរាជការ ទាំងអស់ ត្រូវ ប្រឹងប្រែង ធ្វើ យ៉ាង ម្ដេច ឲ្យ ពលរដ្ឋ ធ្វើ ស្រែ ចំការមាន ជំនាញ ច្បាស់លាស់ ដោយ មិន ចាំបាស់ ពួកគាត់ រៀន ដល់ បាក់ឌុប នោះ ទេ ព្រោះ ពួកគាត់ នៅ មូលដ្ឋាន គាត់ ចាស់ ត្រូវ ធ្វើ យ៉ាង ម្ដេច ឲ្យ ពួកគាត់ មាន ជំនាញ ... បើ ធ្វើ ស្រែ ឲ្យ ប្រាកដ ថា ធ្វើ ស្រែ ដោយ វិជ្ជាសាស្ដ្រ បើ កាលណា មាន វិជ្ជា មាន សមត្ថភាព ផលិតភាព នឹង កើតឡើង » ។
លោក បណ្ឌិត ពេជ សោភ័ន បាន គូសបញ្ជាក់ ថា គោល នយោបាយ អភិវឌ្ឍ ឧស្សាហកម្ម មាន សារៈសំខាន់ ណាស់ ដែល ធ្វើឲ្យ មនុស្ស ប្រើ កម្លាំង ប្រើ មនុស្ស ច្រើន ទៅជា មនុស្ស ដែល ប្រើ ជំនាញ ដូច្នេះ បាន រាជ រដ្ឋាភិបាល ដាក់ចេញ នូវ គោល នយោបាយ មួយ ស្ដីពី ការអភិវឌ្ឍ វិស័យ ឧស្សាហកម្ម ដែល ក្រសួង បាន ធ្វើ នៅ ឆ្នាំ ២០១៧ - ២០២៥ ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត បាន លើកឡើង ថា ការ ដែល ចែករំលែក ការ ដែល កសាង ធនធាន មនុស្ស គឺជា កត្ដា មិន អាច ខ្វះ បាន ដើម្បីឲ្យ កម្ពុជា អាច ឈានចូល ឆ្នាំ ២០៣០ ទៅជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ ដែល សម្ដេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ នូវ គោលដៅ មួយ ទៀត នៅ ឆ្នាំ ២០៥០ នឹង ខ្លាច ជា ប្រទេស ដែល មាន ចំណូល ខ្ពស់ ដែល គេ ហៅ ថា ជា ប្រទេស ដែល អភិវឌ្ឍ ។
លោក បណ្ឌិត ពេជ សោភ័ន បាន បន្ដ ទៀត ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា គណបក្ស ដែល មួយ គត់ និង ជា ជម្រើស តែ មួយ គត់ ល្អ ជាង គេ គ្មាន ជម្រើស ណា ល្អ ជា គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន នឹង កំពុង ធ្វើឲ្យ ប្រទេស កម្ពុជា រីកចម្រើន អភិវឌ្ឍ ដែល យើង ទាំងអស់ គ្នា អាច ផ្ញើ វាសនា ទៅ បាន ដែល នេះ ជា ការពិត ដែល មិន អាច ប្រែ ក្រឡះ ក្លែងបន្លំ ទាំង អតីតកាល បច្ចុប្បន្ន និង ទាំង អនាគត ។
ទន្ទឹម គា្ន នេះ ផងដែរ លោក បណ្ឌិត ក៏ បាន បញ្ជាក់ ឲ្យដឹង ផងដែរ ថា ការបោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ វា មិន គ្រាន់តែ ជា ការជ្រើសរើស គណបក្ស ប្រជាជន កម្ពុជា ឬក៏ អ្នកណា នោះ ទេ តែ ជា ការសម្រេចចិត្ដ មួយ រវាង ខ្មែរ និង ខ្មែរ ហើយក៏ ជា ការសម្ដែង ឲ្យ ឃើញ ថា ពលរដ្ឋ កម្ពុជា ទាំងអស់ ចង់បាន រោងចក្រ ចង់បាន ការងារ ធ្វើ ចង់ មាន សន្ដិភាព ចង់ឲ្យ ការអភិវឌ្ឍ ។
តោះ កុំ ឲ្យ ខាត ពេល ទស្សនា រូបថត តែម្តង បាន ឃើញ បាន ដឹង៖
លោក បាន ក្រើន រំលឹក បុគ្គលិក ទាំងអស់ ឲ្យ ត្រៀម ឯកសារ ពាក់ព័ន្ធ ការបោះឆ្នោត និង ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ គ្នា ជាពិសេស គឺ បោះឆ្នោត ជូន គណបក្ស ដែល មាន សមត្ថភាព ហ៊ាន ថា ហ៊ាន ធ្វើ ដើម្បី បុព្វហេតុ នៃ ការរក្សា សន្តិភាព និង ការអភិវឌ្ឍ ជាតិ ពិតប្រាកដ ។
( កណ្ដាល ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី សំ តុលា មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កណ្ដាល នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស តែងតាំង ផ្លាស់ប្តូរ មុខងារ និង បំពាក់ ឋាន្តរស័ក្តិ ជូន នាយ ទាហាន នាយ ទាហាន រង នៃ កងរាជអាវុធហត្ថ នៃ អង្គភាព ក្រុង - ស្រុក ចំនួន ២៧ រូប ។
ពិធី នេះ ប្រារព្ធ ធ្វើឡើង នៅ បញ្ជាការដ្ឋាន អាវុធហត្ថ ខេត្ត កណ្ដាល ដោយ មាន ការអញ្ជើញ ចូលរួម ពី លោក មេបញ្ជាការ រង លោក នាយ រង សេនាធិការ ប្រធាន អនុប្រធាន មន្ទីរ មេបញ្ជាការ មូលដ្ឋាន ក្រុង ស្រុក និង នាយ - នាយ រង កងរាជអាវុធហត្ថ ខេត្ត ប្រធាន ស្នាក់ការសន្តិសុខ ជាច្រើន រូប ផងដែរ ។
ជាមួយគ្នា នេះ លោក ឧត្តមសេនីយ៍ ត្រី សំ តុលា ក៏ បាន ផ្តាំផ្ញើរ ដល់ នាយ ទាហាន ទាំងអស់ ដែល ទើបតែ ត្រូវបាន ប្រកាស តែងតាំង និង បំពាក់ ឋានន្ដរស័ក្ដិ ក្នុង ថ្ងៃ នេះ ត្រូវ ខិតខំ បំពេញ តួនាទី និង ភារៈកិច្ច របស់ ខ្លួន ដែល អង្គភាព បាន ប្រគល់ ឱ្យ ដើម្បី ពង្រឹង បន្ថែម សមត្ថភាព មាន បទពិសោធ ការងារ ដើម្បី បន្ត ទទួលបាន កិត្តិយស និង មុខងារ ឱ្យ ខ្ពស់ ជាង នេះ ថែម ទៀត ក៏ ដូចជា បង្កើន នៅ សមត្ថភាព របស់ ខ្លួន ដើម្បី បម្រើ ប្រជាពលរដ្ឋ និង អង្គភាព ដែរ ។
ដើម្បី ឆ្លើយតប ទៅនឹង សកម្មភាព នៃ ភារកិច្ច ដែល មាន ស្នាដៃ គូបផ្សំ និង សមត្ថភាព សីលធម៌ ការគោរព វិន័យ ការងារ បទបញ្ជា អង្គភាព ក៏ ដូចជា បទពិសោធន៍ ក្នុង ការបំពេញ ភារកិច្ច របស់ នាយ ទាហាន នាយ ទាហាន រង ដែល ធ្វើ នៅ ថ្ងៃ នេះ អង្គភាព នីមួយ ៗ ក្នុង បញ្ជាការដ្ឋាន ត្រូវ ខិតខំ ប្រឹងប្រែង អនុវត្តន៍ នៅ បទបញ្ជា បង្កា បង្ក្រាប សង្គ្រោះ ស្រប តាម កំណែទម្រង់ របស់ កងយោធពល ខេមរភូមិន្ទ តាម កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោក ឧត្តមសេនីយ៍ ត្រី បាន សង្កត់ធ្ងន់ ថា អ្នក ទទួលបាន ការស សើរ ត្រូវ ខិតខំ បំពេញ ភារៈកិច្ច គោរព វិន័យ ពង្រឹង នូវ សាមគ្គីភាព ផ្ទៃក្នុង ឱ្យ បាន រឹងមាំ នៅ តាម បណ្តា អង្គភាព ចំណុះ បញ្ជាការដ្ឋាន ទាំងអស់ ៕
មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ព្រះវិហារ ចុះ ត្រួតពិនិត្យ ការហ្វឹកហ្វឺន និង ដាក់ ផែនការដល់ កងកម្លាំង ដើម្បី ត្រៀម អន្តរាគមន៍ ការពារ សន្តិសុខ ក្នុង ថ្ងៃ បោះឆ្នោត
( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី កង សៅ គុណ មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ធ្វើ ការត្រួតពិនិត្យ ការងារ ហ្វឹកហ្វឺន ព្រមទាំង បាន ដាក់ ផែនការដល់ កងកម្លាំង ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង ថ្ងៃ បោះឆ្នោត និង ក្រោយ ថ្ងៃ បោះឆ្នោត ធ្វើ យ៉ាងណា ត្រូវ ត្រៀម អន្តរាគមន៍ ឲ្យ ទាន់ ពេលវេលា នូវ រាល់ សភាព ណាមួយ កើតឡើង ជា យថាហេតុ ។
លោក ឧត្តមសេនីយ៍ ត្រី កង សៅ គុណ បាន លើកឡើង ថា គិត ត្រឹម ថ្ងៃ នេះ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ នៃ រដ្ឋសភា គឺ កាន់តែ ខិត ចូល មកដល់ ហើយ ពោលគឺ នៅសល់ តែ រយៈពេល ៤ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ។ ហេតុ នេះ ហើយ ទើប លោក បាន ប្រាប់ ឲ្យ កងកម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ទាំងអស់ ពិសេស កងកម្លាំង ដែល បាន ឆ្លងកាត់ ការហ្វឹកហ្វឺន កន្លងមក ត្រូវ យកចិត្តទុកដាក់ ក្នុង កិច្ចការ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ នៅក្នុង ថ្ងៃ បោះឆ្នោត ខាងមុខ នេះ ឲ្យបាន ល្អ ។
លោក បាន លើកឡើង ទៀត ថា « ការបោះឆ្នោត ប្រកបដោយ ភាពរលូន និង ភាពស្ងប់ស្ងាត់ ជួន ដល់ បណ្ដាល គណបក្ស នយោបាយ ដែល ចូលរួម ប្រកួតប្រជែង ឲ្យ ទទួលយក បាន ។ ភារកិច្ច របស់ យើង ក្នុង នាម ជា កងកម្លាំងប្រដាប់អាវុធ មិន មែន តែ ការពារ ការបោះឆ្នោត មួយ មុខ នោះ ទេ គឺ យើង ត្រូវការពារ កន្លែង រាប់ សន្លឹក ឆ្នោត ការពារ ការដឹកជញ្ជូន ហិប ឆ្នោត ជាដើម ដែល ចំណុច នេះ ទើប កងកម្លាំង ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយត្ន័ ជាប់ ជានិច្ច »៕
លោក ឃួង ស្រេង៖ បើ សម្ដេច តេជោ ហ៊ុន សែន មិន យក ជីវិត ទៅ ប្ដូរ យក សន្តិភាព ទេ ពលរដ្ឋ ក៏ គ្មាន ឱកាស រស់ នៅ ប្រកប អាជីវកម្ម សុខ ស្រួល ដូច បច្ចុប្បន្ន ឡើយ
( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង ដែល តែង ទទួលបាន ការកោតសរសើរ ពី ប្រជាពលរដ្ឋ គ្រប់ ច្រកល្ហក ក្នុង រាជធានី នោះ បាន ប្រកាស ថា បើ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា មិន យក ជីវិត ធ្វើ ដើមទុន ទៅ ប្ដូរ យក សុខ សន្តិភាព ជូន ប្រជាពលរដ្ឋ នោះ ទេ ប្រជាពលរដ្ឋ ក៏ គ្មាន ឱកាស បាន រស់ នៅ និង ប្រកប អាជីវកម្ម សុខ ស្រួល ដូច បច្ចុប្បន្ន នេះ ឡើយ ។
ការថ្លែង បែប នេះ របស់ លោក អភិបាល ឃួង ស្រេង ត្រូវបាន បន្លឺ ឡើង ក្នុង ពិធី ប្រគល់ វិញ្ញាបនបត្រ មូលដ្ឋាន សម្រាប់ អ្នក ឱសថ តាម ឱសថស្ថាន ក្នុង រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នៅ សាល មហោស្រព ចេនឡា ។
ក្នុង ឱកាស នោះ លោក ឃួង ស្រេង បាន រំឭក ពី ប្រវត្តិ តស៊ូ របស់ សម្តេច តេជោ ហ៊ុន សែន . សម្ដេច ហេង សំរិន . សម្ដេច ជា ស៊ីម និង ថ្នាក់ដឹកនាំ ដទៃ ទៀត របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការរំដោះ ប្រជាពលរដ្ឋ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង ភ្លើង សង្គ្រាម ហើយ បាន នាំ ប្រជាពលរដ្ឋ ឱ្យ ស្គាល់ នូវ អ្វី ដែល ជា សន្តិភាព រហូត អភិវឌ្ឍន៍ លើកស្ទួយ កម្ពុជា ឱ្យ មាន ភាពរីកចម្រើន ស្មើ មុខ ស្មើ មាត់ ជាមួយ អន្តរជាតិ ។
លោក បាន បញ្ជាក់ ថា ព្រឹត្តិការណ៍ ដែល កើតឡើង ក្នុង ពេល និង ក្រោយ ការដួលរលំ នៃ របប ខ្មែរ ក្រហម រហូតដល់ កម្ពុជា មាន ការរីកចម្រើន ដូច បច្ចុប្បន្ន នេះ គឺជា សច្ច ភាព ប្រវត្តិសាស្ត្រ របស់ កម្ពុជា ដែល គណបក្ស ប្រជាជន កម្ពុជា បាន លះបង់ តស៊ូ ដើម្បី ប្រជាពលរដ្ឋ និង កំពុងតែ បន្ត ខិតខំ ដឹកនាំ នាវា កម្ពុជា លយ ឆ្ពោះ ទៅរក ភាពរីកចម្រើន បន្ថែម ទៀត ក្នុង នោះ វិស័យ សុខាភិបាល ការប្រកបរបរ អាជីវកម្ម និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ក៏ ត្រូវបាន យកចិត្តទុកដាក់ ផងដែរ ។
គួរ បញ្ជាក់ ថា អ្នក ឱសថ តាម ឱសថស្ថាន ក្នុង រាជធានី ភ្នំពេញ ដែល ទទួលបាន វិញ្ញាបនបត្រ មូលដ្ឋាន នា ថ្ងៃ នេះ មាន ចំនួន ៧០៣ នាក់ ដែល សុទ្ធសឹងតែ ជា សមាជិក របស់ សមាគម អ្នកលក់ ឱសថ កម្ពុជា ។
ចំពោះ ការបើក អាជីវកម្ម លក់ ឱសថ នៅក្នុង រាជធានី ភ្នំពេញ លោក បាន សម្លឹង ឃើញ ថា មាន មួយ មូលដ្ឋាន អាជីវកម្ម ចំនួន គ្មាន ច្បាប់ តែ មួយ ចំនួន ក៏ មាន ច្បាប់ អនុញ្ញាត ត្រឹមត្រូវ ដែរ ដូច្នេះហើយ បាន ជា សមាគម អ្នកលក់ ឱសថ កម្ពុជា ប្រឹងប្រែង ជំរុញ និង បញ្ជ្រាប ការយល់ដឹង ក្នុង កម្មវិធី បណ្ដុះបណ្ដាល ថា តើ ពួកគាត់ គួរ ទៅ សុំ ច្បាប់ នៅ កន្លែងណា អនុវត្ត តាម ច្បាប់ ដោយ របៀប ណា ។
លោក ថា ក្នុង ពេល បច្ចុប្បន្ន នៅតែ មាន ឱសថ ក្លែងក្លាយ មួយចំនួន ដែរ ប៉ុន្តែ សមាគម ក៏ កំពុងតែ ទប់ស្កាត់ យ៉ាង ផុសផុល ដើម្បី លុបបំផុត ការលក់ដូរ និង ប្រើប្រាស់ ឱសថ ក្លែងក្លាយ ឬ ឱសថ ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ ។
លោក បាន អះអាង ថា ក្រោយពី ការបណ្ដុះបណ្ដាល ចប់ គិលានុបដ្ឋាក គូពេទ្យ ឱសថការី ទន្ត ពេទ្យ ពេទ្យ ឆ្មប ទាំងនោះ បាន ផ្លាស់ប្ដូរ នូវ ឥរិយាបថ របស់ ខ្លួន មួយចំនួន៖
ជាមួយគ្នា នេះ ផងដែរ សាលា អន្តរជាតិ អាយ ស៊ី អេស ក៏ មាន កម្មវិធី ផ្តល់ជូន ពិសេស ដែល នឹង ចាប់ផ្តើម ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ តទៅ ៕
សម្រាប់ ព័ត៌មាន បន្ថែម សូម ទាក់ទង តាម អាស័យដ្ឋាន ខាងក្រោម ៖
ការចេញមុខ បកស្រាយ របស់ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន ធ្វើឡើង បន្ទាប់ពី ស្ថានទូត អាមេរិក ប្រចាំ នៅ កម្ពុជា បាន ចេញ សេចក្ដីជូនដំណឹង មួយ ដល់ ពលរដ្ឋ អាមេរិក ដែល កំពុង រស់ នៅ និង ធ្វើដំណើរ ទេសចរ មក ប្រទេស កម្ពុជា ឱ្យ មាន ការប្រុងប្រយ័ត្ន ចំពោះ សុវត្ថិភាព និង សន្តិសុខ ផ្ទាល់ខ្លួន ក្នុង អំឡុង ពេល នៃ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត នៅ ថ្ងៃអាទិត្យ ទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
លោក ខៀវ សុភ័គ បាន បញ្ជាក់ ឆ្លើយតប វិញ យ៉ាង ដូច្នេះ ថា៖ « ដោយសារតែ យើង ដឹង ហើយ ថា អាមេរិក ធ្វើឱ្យ មនុស្ស មួយចំនួន មិន សូវ ស្រលាញ់ ដូច សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី មានប្រសាសន៍ អញ្ចឹង ។ ដូច្នេះ ការអំពាវនាវ ឱ្យ ពលរដ្ឋ គាត់ ប្រុងប្រយ័ត្ន វា ជា រឿង ធម្មតា ទេ សម្រាប់ ពលរដ្ឋ អាមេរិក ព្រោះ គាត់ បាន សាង អំពើ បាប ជាច្រើន នៅ បណ្តា ប្រទេស មួយចំនួន ដូចជា នៅ អឺរ៉ាក នៅ ស៊ីរី ជាដើម ប៉ុន្តែ ចំពោះ កម្ពុជា គ្មាន បញ្ហា អ្វី កើតឡើង ទេ សូម ឱ្យ គាត់ ទុកចិត្ត ចុះ ព្រោះ យើង មិន មាន សត្រូវ ជាមួយ នរណា ទេ » ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន ព្រមាន ថា ទោះជា យ៉ាង នេះ ក្តី ចំពោះ ការងារ សន្តិសុខ នៅ កម្ពុជា សមត្ថកិច្ច ទាំងអស់ មិន ប្រហែស នោះ ទេ ។ សមត្ថកិច្ច កម្ពុជា និង ប្រជាជន កម្ពុជា នៅតែ ការពារ ពលរដ្ឋ អាមេរិក ។ ប៉ុន្តែ អាមេរិក ដូចជា មាន ខ្លួន ពេក ហើយ ភ័យ ភ្នែកស ជាង គេ ផងដែរ ។
( កំពង់ស្ពឺ ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស តែងតាំង ផ្លាស់ប្តូរ មុខងារ បំពាក់ ឋាន្តរស័ក្តិ និង ប្រគល់ លិខិត សរសើរ ជូន នាយ ទាហាន នាយ ទាហាន រង នៃ កងរាជអាវុធហត្ថ នៃ អង្គភាព ក្រុង - ស្រុក ចំនួន ២១ រូប ។
លោក ឃួង ស្រេង និង នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ បញ្ជា កម្លាំង នគរបាល ត្រូវតែ បង្ក្រាប រាល់ សកម្មភាព ដែល ចង់ បំផ្លាញ ការបោះឆ្នោត នៅ ចុង សប្ដាហ៍ នេះ
( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព លោក ឃួង ស្រេង និង នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជា កម្លាំង នគរបាល របស់ រាជធានី ភ្នំពេញ ត្រូវតែ ទប់ស្កាត់ និង បង្ក្រាប រាល់ សកម្មភាព ទាំងអស់ ដែល ចង់ បំផ្លាញ ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៦ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
ការដាក់ បទបញ្ជា ជាថ្មី ម្ដង ទៀត នេះ ត្រូវបាន ធ្វើឡើង ក្នុង ឱកាស លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កងកម្លាំង នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ នៅ ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ។
ថ្លែង ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ បាន បញ្ជាក់ ថា កម្លាំង មាន សមត្ថកិច្ច របស់ រាជធានី ភ្នំពេញ ជិត៥.០០០ នាក់ នឹង ដាក់ពង្រាយ នៅ តាម គោលដៅ សំខាន់ ៗ មួយចំនួន ដើម្បី រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សម្រាប់ ការបោះឆ្នោត ហើយ កងកម្លាំង នគរបាល ត្រូវ ការពារ សកម្មភាព ឃោសនា បោះឆ្នោត របស់ គណបក្ស នយោបាយ ទាំង ២០ គណបក្ស ដែល បាន ឈរឈ្មោះ បោះឆ្នោត ក្នុង រាជធានី ភ្នំពេញ រយៈពេល ២១ ថ្ងៃ ។
នាយ ឧត្តមសេនីយ៍ បញ្ជាក់ ថា កម្លាំង ការពារ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ប្រើប្រាស់ កម្លាំង ចំនួន ១. ២៥៥ នាក់ ។ កម្លាំង ការពារ ការិយាល័យ បោះឆ្នោត និង រាប់ សន្លឹក ឆ្នោត ចំនួន ២. ១៣៨ ការិយាល័យ លើ ២៦៦ ទីតាំង ប្រើប្រាស់ កម្លាំង ចំនួន ៤. ៥០៥ នាក់ ។ កម្លាំង ត្រៀម អន្តរាគមន៍ ចល័ត ការពារ ភូមិសាស្រ្ត ខាងក្រៅ ប្រើប្រាស់ កម្លាំង ចំនួន ៤៨០ នាក់ ។ កម្លាំង ការិយាល័យ វិទ្យុ ទាក់ទង ចំនួន ២៦៤ នាក់ ( ស្នងការដ្ឋាន អធិការដ្ឋាន និង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទាំង ១០៥ ) ។
នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ សង្កត់ធ្ងន់ ថា កងកម្លាំង ទាំងអស់ ដែល បាន រៀបចំ នេះ មាន ភារកិច្ច បង្ការ ទប់ស្កាត់ និង បង្រ្កាប រាល់ ករណី ដែល បង្កឲ្យ មាន ការរាំងស្ទះ ដល់ ដំណើរការបោះឆ្នោត ជ្រើស តាំង តំណាងរាស្រ្ត នីតិកាល ទី៦ និង ក្លាយជា កងកម្លាំង រៀបរយ មាន កង ជួរ ដោយ ប្រសិទ្ធភាព សម្រាប់ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង ឱកាស មុន ក្នុង និង ក្រោយ ការប្រកាស លទ្ធផល បោះឆ្នោត ជា ផ្លូវការ ។
លោក អភិបាល រាជធានី បាន បន្ត ថា ក្នុង នាម ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ និយាយ ដោយឡែក និយាយ ជា រួម ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស កម្ពុជា សូម ថ្លែង ការដឹងគុណ ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី កម្ពុជា មាន ឧត្តម គតិ ស្នេហាជាតិ និង មាន ទស្សនវិស័យ ច្បាស់លាស់ ក្នុង ការការពារ អធិបតេយ្យភាព បូរណភាព ទឹកដី ជូន រក្សា បាន នូវ សុខ សន្តិភាព ជី ជូន ប្រជាពលរដ្ឋ មាតុភូមិ និង ធ្វើឲ្យ យើង ទាំងអស់ គ្នា និង ប្រកបរបរ ទទួលទាន ប្រកបដោយ ភាពសុខដុមរមនា ។
អភិបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃ នេះ គឺ នៅសល់ តែ ៤ ថ្ងៃ ទៀត ប៉ុណ្ណោះ នឹង ដល់ ថ្ងៃ បោះឆ្នោត ដែល ជា ថ្ងៃ ដែល ប្រជាជន យើង ទាំងអស់ គ្នា ជា ជនជាតិ ខ្មែរ បាន អនុវត្ត សិទ្ធិ របស់ ខ្លួន ជា សិទ្ធិ មិន អាច ខ្វះ បាន ក្នុង ប្រទេស មាន លទ្ធិ ប្រជាធិបតេយ្យ ដែល បង្ហាញ យ៉ាង ច្បាស់ ថា សិទ្ធិ បោះឆ្នោត បាន វិវឌ្ឍន៍ ពី ការតស៊ូ និង ពលីកម្ម សាច់ ស្រស់ ឈាម ស្រស់ ។
លោក បន្ថែម ថា ការ មិន ទៅ បោះឆ្នោត គឺជា ប្រមាថ ខ្លួន ឯង ប្រមាថ លើ តម្លៃ សកល នៃ សិទ្ធិ មនុស្ស និង លទ្ធិ ប្រជាធិបេត យ្យ ដូច្នេះ យើង ត្រូវតែ ទៅ បោះឆ្នោត ទាំងអស់ គ្នា និង បោះឆ្នោត ឲ្យ ចំ គោលដៅ ដើម្បី បន្ត និរន្តរភាព សុខ សន្តិភាព និង ការអភិវឌ្ឍ ឲ្យ កាន់តែ ជឿនលឿន ទៅ មុខ ថែម ទៀត ដើម្បី អនាគត កូន ចៅ ជំនាន់ ក្រោយ ៗ ទៀត ៕ កម្លាំង នគរបាល បើក ប្រតិបត្តិការ តាម បង្ក្រាប ក្រុម ចោរប្លន់ ប្រដាប់អាវុធ និង លួច ម៉ូតូ ចំនួន ១០នាក់ នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ កម្លាំង នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន បើក ប្រតិបត្តិការ តាម បង្ក្រាប ក្រុម ចោរប្លន់ ប្រដាប់អាវុធ និង លួច ម៉ូតូ ចំនួន ១០នាក់ នៅ ខណ្ឌ ពោធិ៍សែនជ័យ ។
ការបង្ក្រាប នេះ បាន ធ្វើឡើង ក្រោយពី ជនសង្ស័យ ទាំងនេះ បាន វាយ ប្លន់ យក ម៉ូតូ បាន សម្រេច នៅ យប់ ថ្ងៃ២៤ ខែកក្កដា ឆ្នាំ ២០១៨ នៅ ម្តុំ ក្លឹប spy der ក្នុង សង្កាត់ ចោម ចៅ ទី១ ។ កម្លាំង នគរបាល បាន តាម ចាប់ខ្លួន ជនសង្ស័យ ៥នាក់ រហូត តាម ចាប់ បាន ៥នាក់ ទៀត ក្នុង ពេល ប្រតិបត្តិការ តែ មួយ ព្រមទាំង បាន ដកហូត បាន ស្លាកលេខ ម៉ូតូ បាន ចំនួន ៩ស្លាកលេខ ផងដែរ ។
លោក យឹម សារ៉ាន់ អធិការ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ឲ្យដឹង ថា ជនសង្ស័យ ទាំង ១០នាក់ រួម មាន៖
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ១០នាក់ ត្រូវបាន នាំ ខ្លួន មក អ្នកជំនាញ ព្រហ្មទណ្ឌ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕
សាលា រាជធានី ភ្នំពេញ ជូនដំណឹង ស្ដីពី ការផ្អាក ដំណើរការដឹកជញ្ជូន សាធារណៈ រថយន្ដក្រុង នៅ ថ្ងៃ បោះឆ្នោត (video inside) ( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ចេញ សេចក្ដីជូនដំណឹង ដល់ បងប្អូន ប្រជាពលរដ្ឋ ស្ដីពី ការផ្អាក ដំណើរការ សេវា ដឹកជញ្ជូន សាធារណៈ រថយន្ដក្រុង ក្នុង ថ្ងៃ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៦ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។ នេះ បើ យោង តាម សេចក្ដីជូនដំណឹង របស់ អភិបាល រាជធានី ភ្នំពេញ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៥ ខែកក្កដា នេះ ។
នៅក្នុង សេចក្ដីជូនដំណឹង របស់ ខ្លួន លោក ឃួង ស្រេង បាន បញ្ជាក់ ថា ការផ្អាក ដំណើរការ នេះ ដោយសារតែ បុគ្គលិក បម្រើ ការងារ លើ ការដឹកជញ្ជូន សាធារណៈ រថយន្ដក្រុង ត្រូវបាន អនុញ្ញាតឲ្យ ឈប់ សម្រាក ដើម្បី ចូលរួម ការបោះឆ្នោត ប៉ុន្ដែ សាលា រាជធានី ភ្នំពេញ នឹង ដាក់ ឲ្យ ដំណើរការវិញ នៅ ថ្ងៃទី៣០ ខែកក្កដា ។
