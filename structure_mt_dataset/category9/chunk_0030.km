( កំពង់ចាម ) ៖ ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក ព្រៃឈរ និង ជា បេក្ខជន តំណាងរាស្ត្រ គណបក្ស ប្រជាជន កម្ពុជា សម្រាប់ មណ្ឌល ខេត្ត កំពង់ចាម លោក ប៉ាន សូរស័ក្តិ បាន ប្រកាស ប្រាប់ ប្រជាពលរដ្ឋ ស្រុក ព្រៃឈរ ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា គណបក្ស នយោបាយ ដំបូង និង ជា ចុងក្រោយ បំផុត នៃ ឆាក ជីវិត មន្ត្រីរាជការ ហើយ លោក នឹង នៅតែ បន្ត រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ជារៀងរហូត ។
ការប្រកាស របស់ បេក្ខភាព តំណាងរាស្ត្រ បាន ធ្វើឡើង នៅ ចំពោះមុខ ប្រជាពលរដ្ឋ និង សមាជិក - សមាជិកា នៃ គណបក្ស ប្រជាជន កម្ពុជា ប្រមាណ ជាង ១.០០០ នាក់ នា ឱកាស ចុះ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ នីតិកាល ទី៦ ដើម្បី ស្វែងរក សំឡេង ឆ្នោត នៅក្នុង ឃុំ គរ និង ឃុំ បឹងណាយ នៃ ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម នៅ ថ្ងៃសៅរ៍ ទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
នៅក្នុង ឱកាស នោះ លោក តំណាងរាស្ត្រ ប៉ាន សូរស័ក្តិ បាន ជម្រាប ជូន អង្គ ពិធី អំពី ជីវប្រវត្តិ សង្ខេប និង មូលហេតុ នៃ ការសម្រេចចិត្ត ចូល បម្រើ រាជការ ក៏ ដូចជា ការចូល ប្រឡូក ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដែល គណបក្ស តែ មួយ គត់ ដែល បាន តស៊ូ ទាមទារ ឯករាជ្យ ពី អាណានិគម និយម បារាំង និង ក្រោយមក បាន រំដោះ ប្រជាជន និង ប្រទេសជាតិ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ដ៏ សាហាវ យង់ ខ្នង ។
« ខ្ញុំ ចូលរួម ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដោយសារតែ ចង់ បម្រើ ប្រជាជន និង ប្រទេសជាតិ ឱ្យ បាន រីកចម្រើន ដូច អារ្យ ប្រទេស នានា ក្នុង ពិភពលោក ! មួយ វិញទៀត ខ្ញុំ មើលឃើញ ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា មាន ឧត្តម គតិ ស្នេហាជាតិ ខ្ពស់ ហ៊ាន ធ្វើ អ្វី ៗ គ្រប់ យ៉ាង ដើម្បី បុព្វហេតុ ជាតិ និង មាតុភូមិ ហើយ ជានិច្ច ជាកាល តែង រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាជន គ្រប់ កាលៈទេសៈ » ។ លោក តំណាងរាស្ត្រ បាន គូសបញ្ជាក់ ។
សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៃ យុទ្ធនាការ សៀមរាប ផ្ទះ ខ្ញុំ រៀបចំ ប្រកួត បាល់បោះ ក្រោម ប្រធានបទ « កីឡា ដើម្បី សុខភាព »
លោក សំកុល សុចិត្រា អនុប្រធាន ស.ស .យ . ក ខេត្ត សៀមរាប បាន ថ្លែង ថា គោលបំណង នៃ ការរៀបចំ ការប្រកួត បាល់បោះ ៣ទល់៣ នា ពេលនេះ គឺ ដើម្បីឲ្យ យុវជន មហាជន និង ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង ខេត្ត សៀមរាប ងាក មក ចាប់អារម្មណ៍ ចំពោះ ការលេង កីឡា ដើម្បី សុខភាព របស់ ខ្លួន ផង និង ដើម្បី បង្កើត មិត្តភាព សាមគ្គីភាព ទៅ វិញ ទៅ មក ផង សំដៅ ធ្វើ យ៉ាងណា ឲ្យ យុវជន ជៀស ឆ្ងាយ ពី បញ្ហា គ្រឿងញៀន និង បញ្ហា ប្រឈម មួយ ចំនួន ដែល អាច ជះឥទ្ធិពល មិន ល្អ ដល់ អនាគត របស់ ពួកគាត់ ។
លោក អភិបាល ខេត្ត រង សៀមរាប ក៏ បាន គូសបញ្ជាក់ ថា ក្នុង នាម អាជ្ញាធរ ខេត្ត លោក សូម អបអរសាទរ ចំពោះ ក្រុម កីឡាករ កីឡាការ នី បាល់បោះ របស់ ស.ស .យ . ក កម្ពុជា ខេត្ត ដែល ទើបនឹង ទទួលបាន ជយលាភី មេដៃ មាស ថ្នាក់ លេខ ១ ទាំង ផ្នែក បុរស និង នារី ក្នុង ព្រឹត្តិការណ៍ ប្រកួត កីឡា ជាតិ លើក ទី២ ឆ្នាំ ២០១៨ នា ពេល កន្លងមក នេះ នៅ ពហុកីឡាដ្ឋាន ជាតិ នៅ ភ្នំពេញ ។
ក្នុង នោះ លោក អភិបាល នឹង រក ពេលវេលា សមស្រប មួយ ក្នុង ពេល ឆាប់ ៗ នេះ ដើម្បី បាន ជួប សំណេះសំណាល ដោយ ផ្ទាល់ ជាមួយ ក្រុម កីឡាករ កីឡាការិនី និង ប្រាប់ រួមគ្នា ងាក មក លេង កីឡា ទាំងអស់ គ្នា ព្រោះ កីឡា មិន ត្រឹមតែ បាន នាំមក នូវ សុខភាព រឹងមាំ និង មិត្តភាព ប៉ុណ្ណោះ ទេ គឺ ថែមទាំង បាន នាំឲ្យ យុវជន ឲ្យ ជៀស ឆ្ងាយ ពី បញ្ហា គ្រឿងញៀន និង បញ្ហា ប្រឈម មួយ ចំនួន ផងដែរ ហើយ ការប្រកួត នេះ គឺជា ការហ្វឹកហាត់បន្ថែម ទៀត ក្នុង ការបង្កើន សមត្ថភាព សម្រាប់ ការចូលរួម ប្រកួត នៅ ថ្នាក់ ជាតិ និង ក្នុង តំបន់ នា ពេល អនាគត ផងដែរ ៕
លិខិត អ្នកកាសែត កម្ពុជា៖ កាសែត អន្តរជាតិ ព្យាយាម លាក់បាំង ការពិត ពី កម្ពុជា
អតីត មន្ត្រី ទីភ្នាក់ងារ សម្ងាត់ សេអ៉ី អា អាមេរិក (CIA) បាន ថ្លែង ថា វា កាន់តែ មាន ភាពងាយស្រួល ក្នុង ការទិញ អ្នក រាយការណ៍ ព័ត៌មាន ម្នាក់ ជាជាង ការទិញ បណ្តាញ សារព័ត៌មាន មួយ ដើម្បី ផ្សព្វផ្សាយ ព័ត៌មាន បំផ្លើស ក្នុង ចេតនា បង្ក ចលាចល សង្គម និង ញុះញង់ ឱ្យ មាន ការ ងើប បះបោរ ហើយ នេះ ជា អ្វី ដែល យើង បាន ធ្វើ ហើយ សេអ៉ី អា ក៏ បាន រក្សា និង ធ្វើ ការងារ ជាមួយ អ្នកសារព័ត៌មាន អាមេរិក និង បរទេស ជាច្រើន ដោយ ផ្តល់ ប្រាក់ខែ » ។
វា ស្ទើរតែ មិន ជឿ ដែល អ្នកកាសែត វិជ្ជាជីវៈ មួយ ត្រូវបាន គេ ទិញ បាន និង ផលិត ឯកសារ វិដេអូ ដែល បំភ័ន្តសាធារណៈ មតិ និង ធ្វើឱ្យ ប៉ះពាល់ ដល់ កត្តិយស ជាតិ និង ប្រជាជន កម្ពុជា ។ តើ នរណា ទៅ ជា អ្នក នៅ ពីក្រោយ ខ្នង នៃ ការផលិត វិដេអូ នេះ ? ប្រសិន មិន ដូច អ្វី ដែល លើកឡើង ទេ អ្នកកាសែត ទូរទស្សន៍ អាល់ហ្សា ហ្សីរ៉ា គួរ មាន ភាពក្លាហាន ទទួលស្គាល់ ពី កង្វះខាត ក្នុង វិជ្ជាជីវៈ របស់ ខ្លួន ហើយ ធ្វើ ការកែតម្រូវ និង បង្ហាញ ពី ការពិត នៃ វិដេអូ ក្បត់ ជាតិ របស់ កឹម សុខា ជាជាង ការលាក់បាំង ដើម្បី ផលប្រយោជន៍ នយោបាយ ។
សូម ទស្សនា វិដេអូ ពេញ ដែល លោក កឹម សុខា ថ្លែង អំពី ផែនការ បដិវត្ត ពណ៌ ។
ពី អតីត អ្នកសារព័ត៌មាន កម្ពុជា សម័យ សង្គ្រាម មួយ រូបរាជធានី ភ្នំពេញ . ថ្ងៃទី ១៩ ខែកក្កដា ឆ្នាំ ២០១៨
របស់ ខ្លួន ដែល ថា « ធ្វើឲ្យ មនុស្ស គ្រប់ គ្នា មាន ឱកាស លេង កីឡា » ខណៈ ក្រុមហ៊ុន លក់ សម្ភារៈ កីឡា ដ៏ ធំ មួយ នេះ នឹង បើក សម្ពោធ ហាង ទំនិញ ទី មួយ របស់ ខ្លួន ជា ផ្លូវការ នៅ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៨ ខាងមុខ នេះ នៅ រាជធានី ភ្នំពេញ ដែល នឹង ធ្វើឲ្យ ប្រជាជន កម្ពុជា ងាយស្រួល ស្វែងរក សម្ភារៈ កីឡាកាន់ យ៉ាង សម្បូរ បែប នេះ ។
កាន់តែ ពិសេស អតិថិជន អាច ចុះឈ្មោះ ចូល ជា សមាជិក សហគមន៍ Decathlon និង អាច ទទួលបាន អត្ថប្រយោជន៍ បន្ថែម រួម មាន៖ ការបញ្ចូន ផលិតផល ត្រឡប់ ទៅវិញ ក្នុង រយៈពេល ៣៦៥ ថ្ងៃ ប្រសិនបើ មិន ត្រូវការ ការចូលរួម ព្រឹត្តិការណ៍ កីឡា ដោយ សេរី ឬ ក៏ ការធ្វើតេស្ត ផលិតផល ព្រមទាំង ការបញ្ជាទិញ ផលិតផល តាម អនឡាញ និង ទទួលបាន ការកក់ទុក ទំនិញ ក្នុង ហាង ឬ ទទួលបាន ការដឹកជញ្ជូន ដល់ ផ្ទះ ។
សមត្ថកិច្ច បាន ឲ្យដឹង ថា ការដោះលែង ជន ត្រូវ ចោទ ទាំង ៥នាក់ របស់ លោក ចៅក្រម កោ វណ្ឌី ធ្វើឡើង បន្ទាប់ពី លោក ចែ សុង ជា តំណាង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន បើក ការស៊ើបសួរ និង សម្រេច ចោទប្រកាន់ លើ ក្រុម ជនសង្ស័យ ៥នាក់ ពី បទ ហិង្សា ដោយ ចេតនា មាន ស្ថាន ទម្ងន់ ទោស បញ្ជូន ទៅ ចៅក្រម ស៊ើបសួរ ចាត់ការ បន្ត ដើម្បី ដោះលែង ។
* ទី ៥៖ ឈ្មោះ ហ៊ុល វណ្ណះ ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ កងយោធពល ខេមរភូមិន្ទ ឋានន្តរសក្តិ វរសេនី យ៏ ទោ កង ឯកភាព នាយកដ្ឋាន ហិរញ្ញវត្ថុ អគ្គ ភស្តុភារ ហិរញ្ញវត្ថុ ក . ព. ជ ស្នាក់ នៅ ផ្ទះ លេខ ៥៦Eo ផ្លូវ លេខ ១២២ ក្រុម១០ សង្កាត់ មិត្តភាព ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ ។
( ដាប្លីន ) ៖ ក្រុមហ៊ុន អាកាសចរណ៍ រីយ៉ាន អ៊ែរ (Ryanair) បាន ប្រកាស នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ថា ខ្លួន បាន សម្រេចចិត្ត លុបចោល ជើងហោះ ចំនួន ១៦ ឆ្ពោះទៅ មក រវាង ប្រទេស អៀរឡង់ និង អង់គ្លេស ដោយសារតែ គំរោង ធ្វើ កូដកម្មតវ៉ា ពីសំណាក់ ក្រុម ពី ឡុត នៅ សប្ដាហ៍ ក្រោយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ថ្ងៃសៅរ៍ ទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ ។
ជើងហោះ ដែល ត្រូវបាន លុបចោល មាន កាលវិភាគ ហោះហើរ នៅ ថ្ងៃអង្គារ ទី២៤ ខែកក្កដា នេះ ហើយ ការសម្រេចចិត្ត លុបចោល នេះ ទៀតសោត ធ្វើឡើង ដោយសារតែ សហជីព តំណាង ឱ្យ ពី ឡុត បាន បដិសេធ លុបចោល គំរោង ធ្វើ កូដកម្ម ដែល គ្រោង ទុក ក្នុង ថ្ងៃ តែ មួយ នេះ ។
មគ្គុទ្ទេសក៍ ទេសចរណ៍ និង ជា ម្ចាស់ អាហារដ្ឋាន - ផ្ទះសំណាក់ នៅ ឃុំ អូរ សោម លោក នួន លីម បាន ឲ្យដឹង ថា កំណើន អ្នកទេសចរ ទៅ លេង កម្សាន្ត នៅ ឃុំ អូរ សោម បាន ផ្តល់ ការងារ យ៉ាង ច្រើន ដល់ ប្រជាពលរដ្ឋ នៅ ឃុំ អូរ សោម ទាំង អ្នកនាំ ភ្ញៀវ ទេសចរ និង ប្រជាពលរដ្ឋ ប្រកបរបរ លក់ដូរ ផ្សេង ៗ ។
សូម បញ្ជាក់ ថា ចាប់តាំងពី បង្កើតឡើង នៅ ចុង ឆ្នាំ ២០១៧ កម្មវិធី « មែក សឺដេស និង កំណប់ អាថ៌កំបាំង » បាន ធ្វើ បេសកកម្ម ផ្សព្វផ្សាយ សក្តានុពល ទេសចរណ៍ នៅ ខេត្ត ចំនួន ៣ រួចហើយ រួម មាន ខេត្ត ពោធិ៍សាត់ កំពង់ស្ពឺ និង ខេត្ត រតនគិរី ។ នៅក្នុង ខេត្ត កំពង់ស្ពឺ ក្រុមការងារ បាន ពុះពារ ឡើង លើ ភ្នំ ឱរ៉ាល់ ដែល ជា ភ្នំ ខ្ពស់ ជាង គេ នៅ កម្ពុជា ១.៨១៣ ម៉ែត្រ ។ ការផ្សព្វផ្សាយ ពី ផ្ទាំង ទស្សនីយភាព ដ៏ ស្រស់ ត្រកាល នៅលើ កំពូល ភ្នំ ឱរ៉ាល់ នេះ ក៏ បាន និង កំពុង ធ្វើឲ្យ មាន ការទាក់ទាញ ភ្ញៀវ ទេសចរ ជាខ្លាំង ផងដែរ ។
រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ លោក ថោង ខុន ក៏ ធ្លាប់ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កម្មវិធី « មែក សឺដេស និង កំណប់ អាថ៌កំបាំង » ផងដែរ ចំពោះ បេសកកម្ម ជួយ លើកកម្ពស់ និង ជំរុញ វិស័យ ទេសចរណ៍ នៅ កម្ពុជា ដែល ជា វិស័យ ស្នូល មួយ សម្រាប់ សេដ្ឋកិច្ច ជាតិ ៕ គណៈប្រតិភូ ប្រឆាំង អំពើពុករលួយ ហុងកុង បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា រយៈពេល ៥ ថ្ងៃ
ក្នុង ដំណើរទស្សនកិច្ច នេះ គណៈប្រតិភូ ICAC នឹង ចូល ជួប ពិភាក្សា ការងារ ជាមួយ លោក ទេសរដ្ឋមន្ត្រី ឱម យ៉ិនទៀង ប្រធាន អ. ប. ព និង ចូល ជួយ សម្តែង ការគួរសម ជាមួយ លោក តុ ប សំ ប្រធាន ក្រុមប្រឹក្សា ជាតិ ប្រឆាំង អំពើពុករលួយ កម្ពុជា ។
ដំណើរទស្ស កិច្ច មន្ត្រី ជាន់ ខ្ពស់ របស់ ICAC មកកាន់ ប្រទេស ស្ថិត តាម បណ្តោយ ផ្លូវ ខ្សែក្រវ៉ាត់ សេដ្ឋកិច្ច ផ្លូវ មួយ ក្រវ៉ាត់ មួយ នេះ ក្នុង គោលបំណង រឹត ចំណង ទំនាក់ទំនង លើ កាងារ ប្រយុទ្ធ ប្រឆាំង អំពើពុករលួយ ឲ្យ កាន់តែ ជិតស្និទ្ធ និង មាន ប្រសិទ្ធភាព ៕
មន្រ្តី ជាន់ ខ្ពស់ បក្ស ប្រជាជន៖ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន គឺ គ្មាន សង្គ្រាម ដូច អតីតកាល ទេ . ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាំឲ្យ ជាតិ មាន សន្តិភាព និង ការអភិវឌ្ឍ ឥត ឈប់ឈរ
( ព្រៃវែង ) ៖ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក ពោធិ៍ រៀង និង ជា ប្រធាន ក្រុមការងារ ឃុំ កំពង់ ឬ ស្សី ខេត្ត ព្រៃវែង លោក ឯ ម សំណាង បាន លើកឡើង ថា បោះឆ្នោត ជូន គណបក្ស ប្រជាជន គឺ គ្មាន សង្គ្រាម ដូច អតីតកាល នោះ ទេ ហើយ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា គឺ មាន សន្តិភាព ពាសពេញ ផ្ទៃ ប្រទេស និង ការអភិវឌ្ឍ រាល់ ថ្ងៃ ឈប់ឈរ ពី មួយ ថ្ងៃ ទៅ មួយ ។
ការលើកឡើង របស់ លោក ឯ ម សំណាង ធ្វើឡើង នា ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នា ឱកាស លោក ចុះ ជួប សមាជិក សមាជិកា បក្ស និង ប្រជាពលរដ្ឋ ដែល ស្រលាញ់ គណបក្ស ប្រជាជន ក្នុង មូលដ្ឋាន ឃុំ កំពង់ ឬ ស្សី ខេត្ត ព្រៃវែង ប្រមាណ ជាង ៩០០ នាក់ រួម និង ថ្នាក់ដឹកនាំ មួយចំនួន ផ្សេង ទៀត ។
លោក បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា « បងប្អូន ទាំងអស់ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា គឺ គ្មាន សង្គ្រាម ឡើយ ហើយ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ធ្វើឲ្យ កម្ពុជា នា ពេល សព្វ ថ្ងៃ នេះ មាន សន្តិភាព រួម នឹង ការអភិឌ្ឍ ឥត ឈប់ឈរ ពី មួយ ថ្ងៃទី មួយ ថ្ងៃ ។ សម្តេច តេជោ ហ៊ុន សែន ជា អ្នកសង្គ្រោះ ប្រទេសជាតិ ចេញ ពី របប ខ្មៅ ងងឹត ប៉ុល ពត ហើយ យើង ទាំងអស់ គ្នា ត្រូវ ដឹង គុណ សម្តេច ជានិច្ច » ។
ក្រៅពី នេះ លោក ឯ ម សំណាង ក៏ បាន ពន្យល់ ពី របៀប នៃ ការបោះឆ្នោត ជូន ប្រជាពលរដ្ឋ ដែល កំណត់ ដោយ គជប រួមទាំង អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រស់ នៅ ឃុំ កំពង់ ឬ ស្សី ស្រុក ពោធិ៍ រៀង ខេត្ត ព្រៃវែង ទៅ ចូលរួម ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ អាណត្តិ ទី៦ នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ឲ្យបាន គ្រប់ ៗ គ្នា ហើយ បន្ត គាំទ្រ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ ដើម្បី បន្ត ឲ្យ សម្តេច តេជោ ហ៊ុន សែន ឈរឈ្មោះ ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ទៀត ដើម្បី ដឹកនាំ ប្រទេស តទៅទៀត ។
លោក បញ្ជាក់ ថា « យើង បោះឆ្នោត ជូន គណបក្ស កម្ពុជា ដើម្បី សម្រេច ជោគវាសនា អនាគត កូន ចៅ ខ្មែរ ហើយ ដើម្បី ធ្វើឲ្យ កម្ពុជា រីកចម្រើន បន្ថែម ទៀត នៅ ថ្ងៃ ក្រោយ មាន គណនបក្ស ប្រជាជន ប្រជាជន នឹង មាន ជីវភាព ធូធារ សន្តិភាព ការអភិវឌ្ឍ និង ភាពរីកចម្រើន » ។
សូម បញ្ជាក់ ថា យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត នេះ មាន រយៈពេល ២០ ថ្ងៃ ដែល ចាប់ផ្តើម ពី ថ្ងៃ នេះ រហូតដល់ ថ្ងៃទី ២៧ ខែកក្កដា ។ គណបក្ស ប្រជាជន កម្ពុជា មាន ឈ្មោះ ដើម ថា « បក្ស ប្រជាជន បដិវត្ដន៍ ខ្មែរ » បាន បដិសន្ធិ ឡើង នៅ ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ១៩៥១ ដោយ មាន ប្រភព ពី ចលនា តស៊ូ របស់ ប្រជាជន កម្ពុជា ប្រឆាំង ពួក អាណានិគម និយម ដើម្បី ឯករាជ្យ ជាតិ ។
ជាមួយគ្នា នោះ ដែរ លោក ឯ ម សំណាង បាន ប្រាប់ ទៅ ប្រជាពលរដ្ឋ ទាំងអស់ កុំ ឲ្យ ជឿ លើ ញុះញុុង និង សំដី ដ៏ កខ្វក់ របស់ ទណ្ឌិត សម រង្ស៊ី ដែល បាន លើកឡើង ថា ការបោះឆ្នោត អាណត្តិ នេះ មាន រយៈពេល ៣ ថ្ងៃ ហើយ ការលើកឡើង នេះ ជា ការបោកប្រាស់ សុទ្ធសាធ ដែល នាំឲ្យ ប្រជាពលរដ្ឋ មាន ការយល់ ច្រលំ ។
លោក បាន ពន្យល់ បញ្ជាក់ ទៅកាន់ ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ កំពង់ ឬ ស្សី ថា ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នៅ កម្ពុជា ក្នុង អាណត្តិ ទី៦នេះ មាន រយៈពេល ត្រឹមតែ មួយ ថ្ងៃ តែ ប៉ុណ្ណោះ គឺ នៅ ថ្ងៃអាទិត្យ ទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ មិន ដូច ការលើកឡើង របស់ ទណ្ឌិត សម រង្ស៊ី នោះ ឡើយ ៕ អភិបាល ខេត្ត កំពង់ចាម ចុះ ផ្សព្វផ្សាយ អំពី បញ្ហា គ្រោះថ្នាក់ ចរាចរណ៍ និង គ្រឿងញៀន ជូន ដល់ សិស្សានុសិស្ស ថ្នាក់ ទី១២ នៅ បឋមសិក្សា - វិទ្យាល័យ ដី ដុះ
( កំពង់ចាម ) ៖ នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក គួច ចំរើន អភិបាល ខេត្ត កំពង់ចាម បាន ចុះ ផ្សព្វផ្សាយ លើ បញ្ហា ធំ ដែល កំពុង ប្រឈម សម្រាប់ សង្គម មាន២ គឺ មាន បញ្ហា គ្រោះថ្នាក់ ចរាចរណ៍ នឹង បញ្ហា គ្រឿងញៀន ដើម្បី កាត់បន្ថយ នូវ ផល ប៉ះពាល់ ដល់ អាយុជីវិត ជន រួម ជាតិ ជារៀងរាល់ ថ្ងៃ នៅ បឋមសិក្សា និង វិទ្យាល័យ ដី ដុះ ក្រុង កំពង់ចាម
ជាមួយគ្នា នោះ លោក គួច ចំរើន ក៏ បាន ជំរុញ លើកទឹកចិត្ត ដល់ សិស្សានុសិស្ស ថ្នាក់ ទី១២ ឲ្យ ខិតខំ រៀនសូត្រ ដើម្បី បន្ត ការសិក្សា ទៅ ថ្នាក់ វិទ្យាល័យ បន្ត ទៅ មុខ ទៀត ។
លោក គួច ចំរើន បាន ថ្លែង ប្រាប់ ទៅ សិស្សានុសិស្ស នៃ បឋមសិក្សា - វិទ្យាល័យ ដី ដុះ ថា ក្នុង នាម ជា សិស្សសាលា ត្រូវ គិត លើ បញ្ហា ២ ដ៏ ធំ គឺ មាន គ្រោះថ្នាក់ ចរាចរណ៍ នឹង បញ្ហា គ្រឿងញៀន ដើម្បី កាត់បន្ថយ នូវ ផល ប៉ះពាល់ ដល់ អាយុជីវិត ជន រួម ជាតិ ជារៀងរាល់ ថ្ងៃ ។
លោក បាន បន្ដ ថា « យើង ត្រូវ ផ្សព្វផ្សាយ បន្ត ត្រូវ ប្រុងប្រយ័ត្ន ដោយ គោរព ច្បាប់ ចរាចរណ៍ ត្រូវ ពាក់ មួក សុវត្ថិភាព ចេះ អធ្យាស្រ័យ គ្នា ចេះ យោគយល់ គ្នា កុំ ប្រើប្រាស់ គ្រឿងញៀន កុំ សេព គ្រឿងស្រវឹង ជាដើម ក្នុង ពេល កំពុង បើកបរ ដើម្បី បញ្ជៀស នូវ គ្រោះថ្នាក់ ក្នុង ការបើកបរ » ។
អភិបាល ខេត្ត កំពង់ចាម បាន បញ្ជាក់ ថា ដូច្នេះ យើង ត្រូវ រួមគ្នា ថែរក្សា ជីវិត ដល់ ពលរដ្ឋ ដោយ កុំ ខឹង នឹង ការអនុវត្តន៍ នូវ ច្បាប់ ចរាចរណ៍ គឺ ដើម្បី កាត់បន្ថយ អត្រា ស្លាប់ ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ នៅលើ ដង ផ្លូវ ។ បញ្ហា ជាពិសេស ប្រចាំ ថ្ងៃ នោះ គឺ បញ្ហា សម្រាម ត្រូវ ធ្វើ ការគ្រប់គ្រង់ បាន ត្រឹមត្រូវ យើង ត្រូវ ប្រមូលប្រចាំ រៀបចំ សណ្តាប់ធ្នាប់ តាម ដងផ្លូវ សម្រួល ចរាចរណ៍ កុំ ឲ្យ កក់ ស្ទះ នៅលើ ដង ផ្លូវ ផងដែរ ។
នា ឱកាស នោះ លោក គួច ចំរើន បាន គូសបញ្ជាក់ ថា យុវជន គឺជា ទំពាំង ស្នង ឬស្សី សម្រាប់ ប្រទេសជាតិ ដើម្បី អភិវឌ្ឍន៍ កសាង ប្រទេស ឲ្យ មាន ភាពរុងរឿង រីកចម្រើន ជា បន្តបន្ទាប់ ទៀត ដោយ ត្រូវ ជៀស ឆ្ងាយ ពី គ្រឿងញៀន ត្រូវ យល់ដឹង នូវ ផល ប៉ះពាល់ ដោយ ខ្លួន ឯង និង សង្គមជាតិ ផងដែរ ។
អភិបាល ខេត្ត កំពង់ចាម ក៏ បាន ស្នើ ដល់ លោកគ្រូ - អ្នកគ្រូ ត្រូវ ធ្វើ ការណែនាំ លើ បញ្ហា អសកម្ម ដែល កើត មាន ឡើង លើ បញ្ហា គ្រោះថ្នាក់ នឹង បញ្ហា គ្រឿងញៀន ក្នុង ពេល គោរព ទង់ នៅ បឋមសិក្សា និង វិទ្យាល័យ ដី ដុះ ក្រុង កំពង់ចាម លោក បាន ជំរុញ ដល់ សិស្សានុសិស្ស ទាំងអស់ បន្ត ខិតខំ រៀនសូត្រ ដើម្បី ខ្លួន ឯង សង្គម គ្រួសារ នឹង ឈានដល់ ការអភិវឌ្ឍន៍ ប្រទេសជាតិ ផងដែរ ៕
លោក អូស្មាន ហាស្សា ន់៖ សហគមន៍ ខ្មែរ ឥស្លាម ឃុំ បឹង ចាត់ ខេត្ត កំពង់ធំ ទុក ការទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ គឺជា សំខាន់ ស្មើ អាយុជីវិត
ជាមួយគ្នា នេះ លោក អូស្មាន ហាស្សាន់ បាន កោតសរសើរ ដល់ អ្នក ឃុំ បឹង ដែល ជានិច្ចកាល តែងតែ បាន គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ហើយ ផ្តល់ ការទុកចិត្ត ផ្ញើ វាសនា នៅ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
លោក ប្រធាន គណៈ ចលនា សាសនិក ឥស្លាម របស់ គណបក្ស ប្រជាជន កម្ពុជា រូប នេះ បាន បន្ត ថា សន្តិភាព និង ការអភិវឌ្ឍ មកដល់ សព្វ ថ្ងៃ នេះ ក្រៅពី ការលះបង់ របស់ គណបក្ស ប្រជាជន កម្ពុជា វា ក៏ ជា ចំណែក នៃ ការចូលរួម កសាង ដោយ ឆន្ទៈ របស់ បងប្អូន ជន រួម ជាតិ និង ការផ្តល់ កម្លាំងចិត្ត ជាពិសេស ការបោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ៕
អ្នកជំនា ញ៖ ការព្យាបាល របួស ដោយសារ ការ លេង កីឡា មិន បាន ត្រឹមត្រូវ អាច បង្ក ជា ជំងឺ រ៉ាំរ៉ៃ និង ធ្លាក់ខ្លួន ពិការ ដូច្នេះ ត្រូវ កន្លែង ព្យាបាល ឲ្យបាន ត្រឹមត្រូវ
( ភ្នំពេញ ) ៖ បច្ចុប្បន្ន ការលេង កីឡា គ្រប់ ប្រភេទ កំពុងតែ ទទួលបាន ចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ពិសេស ក្នុង ស្រទាប់ យុវវ័យ ដែល មាន ទាំង អ្នកជំនាញ និង អ្នកលេង កីឡា ធម្មតា ព្រោះថា ការលេង កីឡា អាច នាំមក នូវ សន្ដិភាព និង សុខភាព ល្អ សម្រាប់ អ្នកគ្រប់ គ្នា ប៉ុន្ដែ ការលេង កីឡា អាច ប្រឈម នឹង គ្រោះថ្នាក់ បាន គ្រប់ ពេលវេលា បើ ទោះបីជា មាន ការហ្វឹកហាត់ យ៉ាង ក៏ដោយ នោះ ។
យ៉ាងណាមិញ សម្រាប់ ការព្យាបាល របួស ដោយសារ ការ លេង កីឡា មិន បាន ត្រឹមត្រូវ ត្រូវបាន អ្នកជំនាញ ផ្នែក ព្យាបាល របួស ដោយសារ ការ លេង កីឡា អះអាង ថា អាច បង្ក គ្រោះ ធំ ៗ ចំនួន ២ ដោយ ទី១៖ បង្ក ជា ជំងឺ រ៉ាំរ៉ៃ ព្យាបាល មិន ជា និង ទី ២៖ អាច ធ្វើឲ្យ ជនរងគ្រោះ ធ្លាក់ខ្លួន ពិការ អស់ មួយ ជីវិត ។ ហេតុ នេះ ហើយ អ្នកជំនាញ លើកទឹកចិត្ត ឲ្យ ជនរងគ្រោះ ទៅ រក ការព្យាបាល ឬ ជួប អ្នកជំនាញ ដើម្បី ព្យាបាល ឲ្យបាន ត្រឹមត្រូវ ។
ដោយសារ មើលឃើញ ពី កត្កា គ្រោះថ្នាក់ ទាំងនេះ ហើយ ទើប មាន ប្រធានបទ មួយ « ការព្យាបាល របួស ដោយសារ ការ លេង កីឡា » ដែល មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ភ្នំពេញ បាន រៀបចំ សិក្ខាសាលា ឡើង នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ដើម្បី ចែករំលែក ជា បទពិសោធន៍ ក៏ ដូចជា ផ្ដល់ នូវ ដំបូន្មាន ចាំបាច់ មួយ ចំនួន ដល់ សាធារណជន និង អត្តពលិក កម្ពុជា ។
វេជ្ជបណ្ឌិត រូប នេះ ក៏ បាន ផ្ដល់ ជា ដំបូន្មាន ថា ប្រសិនបើ អ្នក លេង កីឡា ជួប គ្រោះថ្នាក់ ហើយ នោះ ត្រូវតែ បញ្ឈប់ ការលេង ជាបន្ទាន់ ហើយ ត្រូវតែ ទៅ រក អ្នកជំនាញ ដើម្បីឲ្យ អ្នកជំនាញ ជួយ ព្យាបាល ឬ បញ្ចប់ ការគ្រោះថ្នាក់ នេះ ដើម្បី កុំ ឲ្យ របួស ចាស់ រើ ឡើងវិញ ។
ថ្លែង ក្នុង សិក្ខាសាលា នេះ លោក ណារីន ថា រ៉ា ប៊ុន ជុង ចារើន នាយក មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ភ្នំពេញ បាន បញ្ជាក់ ថា ប្រសិនបើ អ្នកទទួលរង របួស ដោយសារ ការ លេង កីឡា អាច មក រក ពិគ្រោះ ព្យាបាល នៅ មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ភ្នំពេញ ព្រោះថា មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ភ្នំពេញ មាន អ្នកជំនាញ ច្បាស់លាស់ សម្រាប់ ព្យាបាល លើ ករណី នេះ ហើយ មន្ទីរពេទ្យ ក៏ សហការ ជាមួយ គណៈកម្មាធិការ កីឡា អូឡាំពិក . សមាគម បាល់ទាល់ ផ្សេង ៗ ដើម្បី ជួយសង្គ្រោះ ពួកគាត់ ឲ្យបាន ទាន់ ពេល ។
លោក ប្រធាន មន្ទីរពេទ្យ ក៏ បាន បន្ថែម ថា មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ភ្នំពេញ មាន សម្ភារ បរិក្ខា ពេទ្យ គ្រប់គ្រាន់ ដើម្បី ត្រៀម សម្រាប់ ជួយសង្គ្រោះ ក៏ ដូចជា ការវះកាត់ ការរងគ្រោះ ដោយសារ ការ លេង កីឡា ។ ដោយឡែក មន្ទីរពេទ្យ រ៉ូយ៉ាល់ ក៏ មាន ការទទួលស្គាល់ ដោយ FIFA ដោយ រៀងរាល់ ២ឆ្នាំ ម្ដង FIFA តែងតែ មក ពិនិត្យ នូវ បរិក្ខា ទាំងអស់ នេះ ៕
សម្តេច ទៀ បាញ់ នឹង អញ្ជើញ ជា អធិបតី ពិធី ទទួល ដំណើរ មាតុភូមិ និវត្តន៍ កងទ័ព មួក ខៀវ កម្ពុជា ពី ប្រទេស ម៉ាលី និង ស៊ូ ដង់ ខាងត្បូង នា ថ្ងៃទី ២៣កក្កដា
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នឹង អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ទទួល ដំណើរ មាតុភូមិ និវត្តន៍ របស់ កងកម្លាំង រក្សា សន្តិភាព ដែល បាន បញ្ចប់ បេសកកម្ម នៅ សាធារណរដ្ឋ ម៉ាលី និង ស៊ូ ដង់ ខាងត្បូង ដែល ធ្វើឡើង នៅ អគារ មិត្តភាព នៃ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី នៅ រសៀល ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ ដែល អង្គភាព សារព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នា២០១៨ នេះ ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រសួង ការពារ ជាតិ អគ្គ បញ្ជាការដ្ឋាន តំណាង អង្គការ សហ ប្រជាជាតិ ភ្ញៀវ ជាតិ ភ្ញៀវ អន្តរជាតិ និង អ្នកសារព័ត៌មាន ជាច្រើន រូប ផងដែរ ។
តាម សេចក្តីប្រកាស ព័ត៌មាន ដដែល នេះ បាន ឱ្យដឹង ថា កងកម្លាំង រក្សា សន្តិភាព កម្ពុជា ដែល ធ្វើ មាតុភូមិ និវត្តន៍ នា ពេល នោះ រួម មាន៖ កង វិស្វកម្ម ព្រលានយន្តហោះ លេខ ១៨៩ ចំនួន ១៦៥ រូប. កង កម្ទេច គ្រាប់ មិន ទាន់ ផ្ទុះ លេខ ១២៣ ពី ប្រទេស ម៉ាលី ចំនួន ១៤៤ រូប និង កងរាជអាវុធហត្ថលេខ ៦១៨ ពី ប្រទេស ស៊ូ ដង់ ខាងត្បូង ចំនួន ៧៣ រូប ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ អ្នកនាំពាក្យ ក្រសួង ការពារ ជា តិ៖ និស្សិត គ្រឹះស្ថាន អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ អះអាង ថា ពួកគេ នឹង ទៅ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា តែ មួយ ថ្ងៃ គត់ (Video inside) ( ភ្នំពេញ ) ៖ យុវជន និង យុវតី ដែល ជា និស្សិត មួយ ក្រុម សិក្សា នៅ គ្រឹះស្ថាន អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ បាន ផលិត វីដេអូ អប់រំ មួយ ដោយ ជំរុញ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ អញ្ជើញ ចូលរួម បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា ។
ក្នុង វីដេអូ អប់រំ ក្រុម និស្សិត បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា ដើម្បី ក្លាយជា ប្រជាពលរដ្ឋ ល្អ ។ ការបោះឆ្នោត គឺ ដើម្បី ភាពរីកចម្រើន និង ការអភិវឌ្ឍ នៅ ប្រទេស កម្ពុជា បន្ត ទៅ ទៀត ។
បើ តាម វីដេអូ របស់ ក្រុម និស្សិត សន្លឹក ឆ្នោត មួយ សន្លឹក គឺជា ជោគវាសនា របស់ ប្រទេសជាតិ របស់ ពួកយើង និង អនាគត របស់ ពួកយើង ទាំងអស់ គ្នា ។ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ នឹង ប្រព្រឹត្តទៅ តែ មួយ ថ្ងៃ គត់ គឺ នៅ ថ្ងៃអាទិត្យ ទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ដោយ ចាប់ផ្តើម ពី ម៉ោង ៧៖០០ នាទី ព្រឹក រហូតដល់ ម៉ោង ៣៖០០ នាទី រសៀល ៕
លោក ហ៊ឹម ឆែម បន្ដ ជួប សំណេះសំណាល សមាជិក សមាជិកាបក្ស ប្រជាជន កម្ពុជា តាម ខ្នង ផ្ទះ នៅ ឃុំ អំពិល ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោក ហ៊ឹម ឆែម ប្រធាន គណៈកម្មាធិការ គណបក្ស ក្រសួង ធម្មការ និង សាសនា និង ក្រុមការងារ នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ចុះ ជួប សំណេះសំណាល និង សាកសួរ សុខទុក ជាមួយ ប្រជាពលរដ្ឋ សមាជិក សមាជិកា គណបក្ស ស្ថិត នៅក្នុង ភូមិ តា ម៉ៅ ឃុំ អំពិល ស្រុក រមាសហែក ខេត្ត ស្វាយរៀង ដោយ ផ្ទាល់ ។
ស្ថិត ក្នុង ឱកាស នោះ ផង លោក ប្រធាន ក្រុមការងារ បាន សាកសួរ សុខទុក អំពី សុខភាព ការរស់នៅ និង ជីវភាព របស់ ប្រជាពលរដ្ឋ សព្វ ថ្ងៃ មាន ការរីកចម្រើន យ៉ាងណា ដែរ និង បាន នាំ នូវ ការសាកសួរ សុខទុក អំពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ថ្នាក់ នាំ ទាំងអស់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ជូន ប្រជាពលរដ្ឋ ទាំងអស់ និង ជន រួម ជាតិ ទាំងមូល ដោយ សេចក្តីនឹករលឹក បំផុត ។
( កំពង់ស្ពឺ ) ៖ អាជ្ញាធរ ខេត្ត កំពង់ស្ពឺ និង ខេត្ត ព្រះសីហនុ បាន អនុញ្ញាតឲ្យ រថយន្ដ ធុន ធំ អាច ធ្វើចរាចរ បាន ឡើងវិញ នៅលើ ផ្លូវ ជាតិ លេខ ៤ នា ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ប៉ុន្ដែ តម្រូវឲ្យ រថយន្ដ ធុន ធំ ទាំងអស់ ធ្វើដំណើរ នៅលើ ទ្រូងផ្លូវ តែ ប៉ុណ្ណោះ សម្រាប់ កន្លែង ដែល រង ដោយ ទឹក ជំនន់ ដើម្បី ជៀស រៀង ការខូចខាត ផ្លូវ បន្ទាប់ពី ផ្អាក ការធ្វើ ការចរាចរ រយៈពេល ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ ដោយសារ បញ្ហា ទឹក ជំនន់ ហូរ កាត់ ផ្លូវ ។
បើ តាម ការបញ្ជាក់ ពី ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ឲ្យដឹង ថា « តាម ការឯកភាព ពី អភិបាល ខេត្ត ព្រះសីហនុ លោក យន្ត មីន . អភិបាល ខេត្ត កំពង់ស្ពឺ និង លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន គឺ កម្លាំង ឯកភាព ស្រុក កំពង់សិលា កំពុង សម្រួល ចរាចរណ៍ ឲ្យ រថយន្ដ ធុន ធំ ធ្វើដំណើរ បាន វិញ ហើយ » ។
ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន សង្កត់ ថា តែ ការបើក ឲ្យ រថយន្ដ ធុន ធំ អាច ធ្វើដំណើរ បាន នេះ តម្រូវឲ្យ រថយន្ដ ធុន ធំ ទាំងអស់ ធ្វើដំណើរ តែ នៅលើ ទ្រូងផ្លូវ តែ ប៉ុណ្ណោះ ដើម្បី ជៀស រៀង ខ្លាច មាន ការខូចខាត ផ្លូវ ខណៈ ដែល ផ្លូវ នេះ ទឹក ទើបតែ នឹង ស្រក ។
ខាងក្រោម នេះ ជា សារ ចរណែនាំ របស់ ក្រសួង ទេសចរ ណ៍៖
ទូក នេះ មាន ផ្ទុក អ្នកដំណើរ ២៩ នាក់ បូករួមទាំង អ្នកបញ្ជា ទូក ពីរ នាក់ ទៀត រីឯ ក្នុង ចំណោម មាន អ្នកស្លាប់ មាន អាយុ ចន្លោះ ពី ០១ ឆ្នាំ ដល់ ៧០ ឆ្នាំ ហើយ មិន តែ ប៉ុណ្ណោះ មនុស្ស ០៩ នាក់ នៃ អ្នកស្លាប់ ទាំង ១៧នាក់ គឺជា សមាជិក គ្រួសារ តែ មួយ ទៀតផង ។
គួរ ជម្រាប ថា ក្រុម អ្នកមុជទឹក អាមេរិក កំពុង តាម ស្វែងរក អ្នក ដែល បាន បាត់ខ្លួន ខណៈ មនុស្ស ០៧ នាក់ កំពុង សម្រាក ដើម្បី ទទួល ការព្យាបាល នៅឯ មន្ទីរពេទ្យ ក្នុង តំបន់ កើត ហេតុ ក្រោយពី ពួកគេ បាន រួច រស់ ជីវិត ពី គ្រោះថ្នាក់ លិច ទូក ខាងលើ ខណៈ មនុស្ស បាត់ខ្លួន មួយចំនួន ទៀត ក្រុម សង្គ្រោះ កំពុង ស្វែងរក ក្នុង បឹង ៕
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ អញ្ជើញ បើក ការដ្ឋាន សាងសង់ អគារ ទីលាន បាញ់ គ្រាប់ ពិត របស់ កងយោធពល ខេមរភូមិន្ទ នៅ ភ្នំ ជុំ រាយ ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក ការដ្ឋាន សាងសង់ អគារ ទីលាន បាញ់ គ្រាប់ ពិត របស់ កងយោធពល ខេមរភូមិន្ទ នៅ ឃុំ ពាម ស្រុក សាមគ្គី មាន ជ័យ ( តំបន់ ភ្នំ ជុំ រាយ ) ខេត្ត កំពង់ឆ្នាំង ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ ឧត្តមសេនីយ៍ មេបញ្ជាការ កងរាជអាវុធហត្ថ នាយ ទាហាន ពល ទាហាន សិក្ខាកាម កងរាជអាវុធហត្ថ ប្រមាណ ជាង ៨០០ នាក់ ផងដែរ ៕
ឡារីតា បញ្ចុះ តម្លៃ ១០% សម្រាប់ ការធ្វើដំណើរ ទៅ ចូលរួម បោះឆ្នោត !
( ភ្នំពេញ ) ៖ ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ អាណត្តិ ទី៦ ដែល នឹង ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ មាន ប្រជាពលរដ្ឋ យើង មួយចំនួន ធំ នឹង ត្រូវ ធ្វើដំណើរ ទៅកាន់ ស្រុក កំណើត ដើម្បី ចូលរួម បោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ និង គណបក្ស ដែល ខ្លួន ពេញចិត្ត ។
ក្រុមហ៊ុន ដឹក អ្នកដំណើរ បាន ដំណើរការ អាជីវកម្ម របស់ ខ្លួន តាំងពី ឆ្នាំ ២០១៣ ដើម្បី អភិវឌ្ឍន៍ លើ វិស័យ ដឹក អ្នកដំណើរ នៅ កម្ពុជា ដោយ ប្រើប្រាស់ នូវ បច្ចេកវិទ្យា ទាន់សម័យ ក្នុង ការទិញ សំបុត្រ រថយន្ត តាមរយៈ ទូរស័ព្ទ (App) និង ប្រើប្រាស់ នូវ រថយន្ត ថ្មី ជាមួយនឹង អ្នកបើកបរ ប្រកបដោយ បទពិសោធន៍ ខ្ពស់ ។
ឡារីតា អភិវឌ្ឍន៍ កម្រិត នៃ ការធ្វើដំណើរ ប្រកបដោយ បទពិសោធន៍ ខ្ពស់ ៕
ដូច្នេះ លោក រដ្ឋមន្ដ្រី សូម ប្រកាស ជូន ប្រជាពលរដ្ឋ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្ដាល ថា មិន មាន ការគំរាមកំហែង ពី ជំនន់ ទឹកភ្លៀង នៅ តាម ដងស្ទឹង ព្រែក ត្នោត ទៀត នោះ ឡើយ ។
បើ តាម លោក រដ្ឋមន្ដ្រី លឹម គាន ហោ ការគ្រប់គ្រង ដោយ មាន ប្រសិទ្ធភាព នេះ ក្នុង ប៉ុន្មាន ថ្ងៃ ខាងមុខ នេះ ក៏ មាន ការ បញ្ហា អ្វី កើតឡើង ទៀត ដែរ ដោយសារ ផ្នែក ខាងលើ ពុំ មាន ភ្លៀង ធ្លាក់ ហើយក៏ ពុំ មាន ការកើនឡើង ចំនួន ទឹក ទៀត នោះ ទេ ។
សូម ជម្រាប ថា ចំណាត់ការ ដ៏ មាន ប្រសិទ្ធភាព នេះ បាន ធ្វើឡើង បន្ទាប់ពី ក្រុមការងារ របស់ ក្រសួង ធនធាន ទឹក និង អាជ្ញាធរ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ បាន ប្រចាំ ការតាំងពី យប់ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ រហូតដល់ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា នេះ ដើម្បី ត្រៀម អន្ដរាគមន៍ ដើម្បី ទប់ស្កាត់ គ្រោះ ធម្មជាតិ នេះ ។
ជាមួយគ្នា នេះ លោក រដ្ឋមន្ដ្រី ក្រសួង ធនធាន ទឹក ក៏ សូម ថ្លែងអំណរគុណ ដល់ មន្ដ្រី អាជ្ញាធរ ពាក់ព័ន្ធ និង ប្រជាពលរដ្ឋ ដែល បាន សហការ ទាំងអស់ គ្នា ក្នុង ការទប់ស្កាត់ គ្រោះ ធម្មជាតិ មួយ នេះ កុំ ឲ្យ មាន ការប៉ះពាល់ និង គំរាមកំហែង នៅពេល ខាងមុខ នេះ ។
យ៉ាងណាមិញ សម្រាប់ ស្ថានភាព ជំនន់ ទឹកភ្លៀង និង ទឹក ជំនន់ នៅ ទូទាំង ប្រទេស នោះ លោក លឹម គាន ហោ បាន បញ្ជាក់ ថា ក៏ មាន ការថមថយ និង ធូរស្រាល ហើយ ពុំ មាន បញ្ហា អ្វី ចោទ នោះ ទេ ៕
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន ញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ៕ គ.ជ. ប៖ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ដែល មិន បាន ចុះឈ្មោះ សង្កេតការណ៍ មិន អាច ចេញ សេចក្ដីថ្លែងការណ៍ វាយតម្លៃ លើ ការបោះឆ្នោត បាន ឡើយ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត គ.ជ. ប បាន ឲ្យដឹង ថា សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ដែល មិន បាន សុំ ចុះឈ្មោះ ជា អ្នកសង្កេតការណ៍ ចូលរួម សង្កេតការណ៍ បោះឆ្នោត នៅ គ.ជ. ប មិន អាច ធ្វើ សកម្មភាព បំពេញ ការងារ និង សេចក្ដីថ្លែងការណ៍ នានា ដែល អាច សន្និដ្ឋាន បាន ថា ជា ការវាយតម្លៃ លើ ការបោះឆ្នោត បាន ឡើយ ។
នេះ ជា ខ្លឹមសារ ចំណុច មួយ ក្នុង ចំណោម ៣ចំណុច សំខាន់ ៗ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ក្នុង សេចក្ដីជូនដំណឹង ចេញផ្សាយ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ ស្ដីពី ការសង្កេតការណ៍ បោះឆ្នោត របស់ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ក្នុង ដំណើរការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ ។
គ.ជ. ប បាន បញ្ជាក់ ថា « សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ដែល មិន បាន សុំ ចុះឈ្មោះ ជា អ្នកសង្កេតការណ៍ ចូលរួម សង្កេតការណ៍ បោះឆ្នោត នៅ គ.ជ. ប មិន អាច ធ្វើ សកម្មភាព បំពេញ ការងារ និង សេចក្ដីថ្លែងការណ៍ នានា ដែល អាច សន្និដ្ឋាន បាន ថា ជា ការវាយតម្លៃ លើ ការបោះឆ្នោត បាន ឡើយ » ។
គ.ជ. ប បាន គូសបញ្ជាក់ ថា ដើម្បីឲ្យ ការបោះឆ្នោត ប្រព្រឹត្ដទៅ បាន ដោយ រលូន ល្អ តាម គោលការណ៍ នៃ ការបោះឆ្នោត ដោយ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ ស្រប តាម ច្បាប់ សមាគម និង អង្គការ មិន មែន រដ្ឋាភិបាល ត្រូវ អនុវត្ត តាម សេចក្ដីណែនាំ នេះ ឲ្យបាន មាន ប្រសិទ្ធភាព ខ្ពស់ ៕
សូម កុំ បើកបរ ស្ថិត ក្រោម ស្ថានភាពងងុយដេក ! ស្លាប់ ៥នាក់ និង រងរបួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១២០ ខែកក្កដា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ចំនួន ៥នាក់ . របួស ស្រាល ៣នាក់ និង របួស ធ្ងន់ ៦នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ៩លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៩គ្រឿង រថយន្ត តូច ៤គ្រឿង និង រថយន្ដ ធុន ធំ៣ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ . មិន គោរព សិទ្ធិ និង បត់ គ្រោះថ្នាក់ ។
ស្ថានភាព ទឹក ស្ទឹង ព្រែក ត្នោត លែង មាន អ្វី ត្រូវ ព្រួយបារម្ភ . ក្រុមការងារ ក្រសួង ធនធាន ទឹក កំពុង ប្រចាំ ការទប់ស្កាត់ រហូត ទល់ ភ្លឺ
លោក ចាន់ យុត្ថា បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « គិត ត្រឹម ម៉ោង នេះ ស្ថានភាព ទឹក ស្ទឹង ព្រែក ត្នោត លែង មាន អ្វី ដែល ត្រូវ គួរឲ្យ ព្រួយបារម្ភ ទៀត ហើយ ប៉ុន្ដែ នៅ យប់ នេះ ក្រុមការងារ ក្រសួង ធនធាន ទឹក ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក រដ្ឋមន្ដ្រី លឹម គាន ហោ សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន រាជធានី ភ្នំពេញ និង ប្រជាពលរដ្ឋ បាន និង កំពុង ប្រចាំ ការរហូត ទល់ ភ្លឺ នៅ ទំនប់ ៧មករា ដើម្បី ទប់ស្កាត់ និង ជួយ អន្ដរាគមន៍ នៅពេល មាន បញ្ហា កើតឡើង » ។
បើ តាម មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង ធនធាន ទឹក រូប នេះ រហូតមកដល់ ម៉ោង នេះ ទឹក មិន ទាន់ មាន ស្ថានភាព ធ្ងន់ធ្ងរ នោះ ទេ ដោយសារ ស្ថានភាព ទឹក នៅ ខាងលើ បាន ស្រក ហើយ លោក រដ្ឋមន្ដ្រី លឹម គាន ហោ បាន បញ្ជា ឲ្យ បើក ទ្វារ ទឹក នៅ រលាំង ជ្រៃ ខណៈ ដែល ទ្វារ ទឹក កំពង់ទួល នៃ ទំនប់ ៧មករា ដែល មាន ចំនួន ៣ទ្វារ នេះ គឺ លោក រដ្ឋមន្ដ្រី បាន បញ្ជា ឲ្យ ទម្លាក់ ចំនួន ២ម៉ែត្រ ។
លោក ចាន់ យុត្ថា បាន បន្ថែម ថា ស្ថានភាព ទឹក នៅ ខាងក្រោម ទ្វារ ទឹក ក៏ បាន ស្រកចុះ ផងដែរ ប៉ុន្ដែ ចម្ងាយ ប្រមាណ ៥គីឡូម៉ែត្រ ពី ទ្វារ ទឹក ទៅ ក្រោម មិន ទាន់ ស្រក នៅឡើយ ទេ គឺ នៅ ហ្នឹង ដែល ជា ធម្មជាតិ របស់ ទឹក ។ ជា រួម លោក បាន បញ្ជាក់ ថា ស្ថាន ទឹក ស្ទឹង ព្រែក ត្នោត ក្រុមការងារ ជំនាញ អាច គ្រប់គ្រង បាន ដោយ កន្លែងណា ទាប ក្រុមការងារ បាន កាយ ដី ដាក់ បន្ថែម និង មាន ច្រក ខ្សាច់ ដើម្បី ទប់ស្កាត់ ផងដែរ ។
យ៉ាងណា ក៏ដោយ ក្រុមការងារ ជំនាញ កំពុងតែ បន្ដ តាមដាន យ៉ាង យកចិត្តទុកដាក់ នៅ ស្ថានភាព ទឹក ស្ទឹង ព្រែក ត្នោត ពិសេស ខ្លាច មាន ទឹក ហូរ ច្រោះ ( មាន រន្ធ នាគ ) នៅ ខាងក្រោម ទំនប់ ដែល អាច បង្ក ជា គ្រោះថ្នាក់ ហើយ ប្រសិនបើ មាន ក្រុមការងារ បាន ធ្វើ ការបិត ការហូរច្រោះ ភ្លាម ៗ ផងដែរ ៕ លោក ហេង សួរ៖ ការប្រឡង ធ្វើតេស្ត ភាសា កូរ៉េ ថ្ងៃទី៣០ កក្កដា ត្រូវបាន លើក ទៅ ថ្ងៃទី ០៨ សីហា វិញ
លោក បាន អះអាង ថា ការប្រឡង ធ្វើតេស្ត ភាសា កូរ៉េ ដល់ ពលករ ខ្មែរ ចំនួន ៦៤០ នាក់ ដែល គ្រោង ធ្វើ នៅ ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០១៨ នោះ ត្រូវបាន ភាគី ទាំង ពីរ លើក ពេល ទៅ ថ្ងៃទី ០៨ ខែសីហា ឆ្នាំ ២០១៨ វិញ ។
សូម បញ្ជាក់ ថា តាមរយៈ កិច្ចព្រមព្រៀង រវាង កម្ពុជា និង កូរ៉េ ពលករ ខ្មែរ បាន ចេញ ទៅ ធ្វើការ នៅ ប្រទេស កូរ៉េ ខាងត្បូង ជារៀងរាល់ ឆ្នាំ ប៉ុន្តែ ពលករ ត្រូវ ឆ្លងកាត់ ការធ្វើតេស្ត ភាសា កូរ៉េ ដែល រៀបចំ ដោយ អង្គភាព អភិវឌ្ឍ ធនធាន មនុស្ស (HRD Korea) នៃ ក្រសួង ការងារ កូរ៉េ ជាមុន សិន ៕
ភ្ជាប់ ជាមួយ រូបភាព ស្រស់ ស្រូប អាហារ ថ្ងៃត្រង់ ប្រកបដោយ ភាពស្និទ្ធស្នាល ជាមួយ កម្មករ កម្ម ការិនី នៅ រោងចក្រ « ថប សាប មីត » កាលពី ថ្ងៃទី ១៨ ខែកក្កដា ឆ្នាំ ២០១៨ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ តាមរយៈ ទំព័រ Facebook ថា ទម្រាំ កម្ពុជា បាន ដូច ពេល បច្ចុប្បន្ន នេះ គឺ មាន ការលំបាក ខ្លាំង ណាស់ ក្នុង ការចាប់ផ្តើម ចេញ ពី ដំណាក់កាល គ្មាន អ្វី សោះ ។ សម្តេច តេជោ បាន បញ្ជាក់ ទៀត ថា គណបក្ស ប្រជាជន កម្ពុជា គឺ រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ កម្ពុជា ជានិច្ច ។
« គណបក្ស ប្រជាជន គឺ រួម សុខ រួម ទុក្ខ ជាមួយគ្នា ព្រោះថា សុខ ទុក្ខ បងប្អូន កូនក្មួយ គឺជា សុខ ទុក្ខ ផ្ទាល់ របស់ ខ្ញុំ ហើយក៏ ជា សុខ ទុក្ខ របស់ គ្រួសារ កម្ពុជា ទូទាំង ប្រទេស ។ យើង លំបាក ខ្លាំង ណាស់ ក្នុង ការកសាង កម្ពុជា ពី គ្មាន អ្វី សោះ មក កម្ពុជា សព្វ ថ្ងៃ នេះ ។ គណបក្ស ប្រជាជន គឺ ធានា មិន ឲ្យ ប្រទេសជាតិ វិល ទៅរក សង្រ្គាម វិនាសកម្ម ទៀត ឡើយ ។ ចាប់ពី ពេលនេះ តទៅ គឺ មាន តែ សុខ សន្តិភាព និង រីកចម្រើន ទៅ មុខ ហើយ ខ្ញុំ នឹង នៅ មើល ថែ កម្ពុជា ជារៀងរហូត » ។ សម្តេច តេជោ ហ៊ុន សែន បញ្ជាក់ ។
ក្នុង សារ នយោបាយ ចេញ ទាំង យប់ អាធ្រាត្រ នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន អរគុណ ដល់ កម្មករ កម្ម ការិនី ព្រមទាំង ប្រជាពលរដ្ឋ ខ្មែរ នៅ ទូទាំង ប្រទេស ដែល មាន ជំនឿ ទុកចិត្ត ឥត ងាក រេ ហើយ បន្ត បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា លេខរៀង ទី២០ ដើម្បី សម្តេច មាន ឱកាស អភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ឲ្យកាន់តែ រុងរឿង ៕
មន្រ្តី កាំ កុងត្រូល ចុះ ពិនិត្យ តាម បណ្តា ស្ថានីយ ដេប៉ូ ប្រេងឥន្ធនៈ មួយចំនួន នៅ ខណ្ឌ ទួលគោក . រកឃើញ ដេប៉ូ មួយ លក់ ប្រេង មិន ត្រឹមត្រូវ និង ប្រាប់ ឲ្យ កែតម្រូវ ជាបន្ទាន់
( ភ្នំពេញ ) ៖ ក្រុម ត្រួតពិនិត្យ ប្រេងឥន្ធនៈ របស់ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល នៃ ក្រសួង ពាណិជ្ជកម្ម នៅ ព្រឹក ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ តាមរយៈ រថយន្ត មន្ទីរពិសោធន៍ ប្រេងឥន្ធនៈ ចល័ត ដឹកនាំ ដោយ លោក ងួន សុមល្លី វង្ស អនុប្រធាន នាយកដ្ឋាន សហការ ជាមួយ មន្រ្តី ជំនាញ របស់ មន្ទីពិសោធន៍ បាន ចុះ ត្រួតពិនិត្យ បរិមាណ និង គុណភាព ប្រេងឥន្ធនៈ នៅ តាម ស្ថានីយ និង ដេប៉ូ មួយចំនួន ដែល មាន ទីតាំង នៅ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ។
លោក ងួន សុម ល្លីវង្ស បាន បញ្ជាក់ ថា ប្រតិបត្តិការ នេះ ក្នុង គោលបំណង ការពារ ផលប្រយោជន៍ សេដ្ឋកិច្ច អ្នកប្រើប្រាស់ ការពារ គ្រឿង ម៉ាស៊ីន នៃ យានជំនិះ គ្រប់ ប្រភេទ និង ការពារ បរិស្ថាន ដែល កើត ចេញ ពី ចំហេះ ប្រេងឥន្ធនៈ មិន សមស្រប និង ពិសេស ដើម្បី ទប់ស្កាត់ ការកែ្លង បន្លំ ។
ការត្រួតពិនិត្យ គុណភាព និង បរិមាណ នេះ គឺ ផ្អែក ទៅ លើ ឧបករណ៍ ត្រួតពិនិត្យ នៅនឹង កន្លែង ដូចជា ធុង ក្រឹត មាន មាឌ ជាក់លាក់ សម្រាប់ វាស់ បរិមាណ ប្រេង ដែល បាញ់ ចេញ ពី កុងទ័រ តាម ទំហំ ផ្សេង ខុសគ្នា មាន ចំណុះ ៥លីត្រ ១០លីត្រ និង ២០លីត្រ ។ ចំណែក សន្ទស្ស៍ អុក តាន និង សេតាន វិញ គឺ ប្រើ ឧបករណ៍ ក្នុង រថយន្ត មន្ទីពិសោធន៍ ចល័ត ។
ជា លទ្ធផល នៃ ការត្រួតពិនិត្យ គុណភាព និង បរិមាណ ប្រេងឥន្ធនៈ របស់ ស្ថានីយ និង ដេប៉ូ០៥ កន្លែង នៅ ទីតាំង ខាងលើ នេះ គឺ មាន ស្ថានីយ និង ដេប៉ូ០៤ កន្លែង ដែល មាន អនុលោម ភាព លើ ផ្នែក គុណភាព និង រង្វាស់ រង្វាល់ ចំណែក ដេប៉ូ ០១កន្លែង ទៀត មាន កង្វះ បរិមាណ ប្រេង មិន ត្រឹមត្រូវ តាម បទដ្ឋាន រង្វាស់ រង្វាល់ ។ ក្រុម មន្ត្រី ត្រួតពិនិត្យ បាន ឲ្យ ម្ចាស់ ស្ថានីយ និង ដេប៉ូធ្វើ កិច្ចសន្យា កែតម្រូវ ម៉ាស៊ីន លក់ ប្រេង តាម ការធ្វើ ព្យាសកម្ម ឲ្យបាន ត្រឹមត្រូវ ឡើងវិញ តាមរយៈ ស្ថាប័ន មាន សមត្ថកិច្ច ជំនាញ ។
លោក បន្ថែម ថា អ្នកប្រើប្រាស់ យានជំនិះ ទាំងអស់ ត្រូវ ពិចារណា ជាមុន ក្នុង ការជ្រើសរើស ស្ថានីយ / ដេប៉ូ ប្រេងឥន្ធនៈ ដែល ជា ក្រុមហ៊ុន ទុកចិត្ត ប្រើប្រាស់ ឧបករណ៍ ថ្មី លក់ ប្រេងសាំង ធម្មតា ឬ ស៊ុប ពែរ និង ម៉ាស៊ូត ដែល មាន គុណភាព ល្អ ហើយ គ្រប់ ចំនួន លីត្រ ពិនិត្យមើល លេខ កុងទ័រ នៅ ពី ចំណុច សូន្យ ជានិច្ច មុនពេល ចាក់ តាមដាន ដំណើរការ នៃ លេខ កុងទ័រ ដែល ត្រូវ ចាប់ផ្ដើម ជាមួយគ្នា នឹង ម៉ាស៊ីន បាញ់ ប្រេង រហូតដល់ ចំនួន លីត្រ ចុងក្រោយ ។
ជាមួយគ្នា នេះ លោក ក៏ បាន ស្នើ ប្រជាពលរដ្ឋ តាមដាន សេចក្តីជូនដំណឹង ពី តម្លៃ ប្រេងឥន្ធនៈ របស់ ក្រសួង ពាណិជ្ជកម្ម និង ត្រូវ ប្រុងប្រយ័ត្ន សុវត្ថិភាព ផ្នែក អគ្គីភ័យ ដោយ ពន្លត់ ម៉ាស៊ីន យានជំនិះ ពេល ចាក់ បំពេញ ប្រេង ក្នុង ស្ថានីយ និង សូម ផ្តល់ ព័ត៌មាន មក មន្រ្តី ជំនាញ កាំ កុងត្រូល ប្រចាំ រាជធានី ខេត្ត ឬ មក អគ្គ នាយកដ្ឋាន កាំកុងត្រូល ក្នុង ករណី ដែល បាតុភាព ជា យថាហេតុ ណាមួយ ៕ ទស្សនា ជម្រើស រូបភាព ស្តែង ពី ព្រឹត្តិការណ៍ អន្តរជាតិ ប្រចាំ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ ! (Photo inside)
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី២០ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
ថ្ងៃ នេះ ប្រជាពលរដ្ឋ ជិត ១ ពាន់ នាក់ ក្នុង ខេត្ត ព្រះវិហារ បាន មក ទទួល ការពិនិត្យ ព្យាបាល ពី ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត កូរ៉េ . តំណាងរាស្រ្ត សួស យ៉ារ៉ា អំពាវនាវ ឲ្យ ពលរដ្ឋ ទៅ បោះឆ្នោត បាន គ្រប់ ៗ គ្នា
ជាមួយគ្នា នេះ ដែរ លោក សួស យ៉ារ៉ា បាន ប្រាប់ បងប្អូន ប្រជាពលរដ្ឋ ថា សុខ ទុក្ខ និង សុខភាព របស់ បងប្អូន ប្រជាពលរដ្ឋ គឺជា ភារកិច្ច របស់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល កត្តា នេះ ហើយ ក្នុង នាម លោក ជា តំណាងរាស្ត្រ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក៏ ដូចជា ថ្នាក់ដឹកនាំ ខេត្ត តែង មាន ការគិតគូរ ជានិច្ច អំពី បញ្ហា នេះ ។
ជាក់ស្តែង ថ្ងៃ នេះ លោក បាន នាំ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត របស់ ប្រទេស កូរ៉េ មក ពិនិត្យ ព្យាបាល ជម្ងឺ ជូន បងប្អូន ប្រជាពលរដ្ឋ នៅ ខេត្ត ព្រះវិហារ ដោយ មិន គិត ថ្លៃ ហើយក៏ មិន បាច់ ចំណាយ ថ្លៃ យន្តហោះ ទៅ ពិនិត្យ សុខភាព នៅ ស្រុក គេ ដែរ គឺ គេ ជិះ យន្តហោះ មក ពិនិត្យ ឲ្យ យើង តែម្តង ដែល នេះ ជា ការគិតគូរ ខ្លាំង ណាស់ របស់ ថ្នាក់ដឹកនាំ ចំពោះ សុខភាព ប្រជាពលរដ្ឋ ។
លោក សួស យ៉ារ៉ា បាន អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ បន្ត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ដោយ អញ្ជើញ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ ដើម្បី បាន ឲ្យ លោក អាច បំរើ បងប្អូន ប្រជាពលរដ្ឋ ខេត្ត ព្រះវិហារ នៅ អណត្តិ ក្រោយ ទៀត ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ មាន រយៈពេល ១៤ ថ្ងៃ ហើយ យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី ០៦ នៅ កម្ពុជា មាន បរិយាកាស ល្អ ប្រសើរ ទាំង សន្តិសុខ សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ ហើយ កំពុង ប្រព្រឹត្តិ ទៅ ដោយ រលូន គ្មាន អំពើហិង្សា ។ នេះ បើ យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ គ.ជ. ប ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រលប់ ថ្ងៃទី ២០ ខែកក្កដា នេះ ។
រយៈពេល ១៤ ថ្ងៃ យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី ០៦ គ.ជ. ប បាន ទទួល ពាក្យបណ្តឹង ចំនួន ១៤ ក្នុង នោះ ក៏ មាន ៩ករណី ផងដែរ ត្រូវបាន ដោះស្រាយ រួចរាល់ ចំណែក បណ្តឹង សេសល់ ផ្សេង ទៀត គ.ជ. ប កំពុង ដោះស្រាយ ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្តីប្រកាស ព័ត៌មាន របស់ គ.ជ. ប ដូច ខាងក្រោម៖ កម្មករ ជិត ៣០០ នាក់ នៅ រោងចក្រ កាលីតុន ដួល សន្លប់ ដោយ ភ័យខ្លាច រឿង ឆ្លង ចរន្ដ អគ្គិសនី . អភិបាល ខេត្ត កំពង់ចាម និង លោក ម៉ា ឈឿន ចុះ ពិនិត្យ កន្លែង កើត ហេតុ និង ស្ថានភាព កម្មករ
( កំពង់ចាម ) ៖ កម្ម ការិនី សរុប ២៨៤ នាក់ ក្នុង នោះ ១២នាក់ ជា ស្ដ្រី មាន ផ្ទៃពោះ បាន ដួល សន្លប់ ជា បន្ដ បន្ទាប់ នៅក្នុង រោងចក្រ កាលីនតុន ស្ថិត ក្នុង ឃុំ ខ្នុល ដំបង ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម នៅ រសៀល ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បណ្ដាល មកពី ការភ័យខ្លាច រឿង ឆ្លង ចរន្ដ អគ្គិសនី ហើយ ខ្វះ ខ្យល់ ដកដង្ហើម ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ក្រោយ កើតកម្ម ការិនី ដែល បាន ជួល សន្លប់ ត្រូវបាន បញ្ជូន ទៅ សង្គ្រោះ ភ្លាម ៗ នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក បាធាយ និង មន្ទីរពេទ្យ បង្អែក ស្រុក ជើង ព្រៃ ដោយ ក្នុង នោះ មន្ទីរ បង្អែក ស្រុក បាធាយ មាន ជនរងគ្រោះ ដេក សម្រាក ព្យាបាល ចំនួន ១៣៨ នាក់ និង មន្ទីរ បង្អែក ស្រុក ជើង ព្រៃ មាន ជនរងគ្រោះកម្ម ការិនី ដេក សម្រាក ព្យាបាល ចំនួន ១៤៦ នាក់ ។
យ៉ាងណាមិញ បន្ទាប់ ដឹង នូវ ហេតុការណ៍ នេះ លោក គួច ចំរើន អភិបាល ខេត្ត កំពង់ចាម និង លោក ម៉ា ឈឿន ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ជើង ព្រៃ បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ និង ពិនិត្យមើល ស្ថានភាព ជាក់ស្ដែង នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក បាធាយ និង ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម ។
ទាំង លោក គួច ចំរើន និង លោក ម៉ា ឈឿន ដែល បាន ចុះ ទៅ ត្រួតពិនិត្យ អាការៈ ជនរងគ្រោះ ផ្ទាល់ និង បាន ណែនាំ ក្រុម គ្រូពេទ្យ យកចិត្តទុកដាក់ ជួយសង្គ្រោះ ឲ្យបាន ម៉ត់ចត់ បំផុត នៅ តាម មន្ទីរពេទ្យ បង្អែក ស្រុក ជើង ព្រៃ និង ស្រុក បាធាយ ។
អភិបាល ខេត្ត កំពង់ចាម បាន បញ្ជាក់ ថា ក្រោម ទទួលបាន ការពិនិត្យ និង សង្គ្រោះ យ៉ាង យកចិត្ដទុកដាក់ នោះ កម្ម ការិនី ទាំង២៨៤ នាក់ បាន មាន អាការៈ ធូរស្បើយ ដូច ដើម វិញ ហើយ ដោយ មិន មាន ជនរងគ្រោះ ណា ម្នាក់ មាន អាការៈ ធ្ងន់ធ្ងរ នោះ ទេ ៕
( កំពង់ស្ពឺ ) ៖ ដោយ ក្ដីបារម្ភ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅក្នុង ខេត្ត កំពង់ស្ពឺ លោក វេង សាខុន រដ្ឋមន្រ្ដី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង មន្ត្រី ជំនាញ បាន ចុះ ពិនិត្យ ស្ថានភាព នៃ ផល ប៉ះពាល់ ក្នុង គោលបំណង ស្វែងរក វិធានការអន្តរាគមន៍ ដើម្បី ជួយសង្គ្រោះ និង ស្តារ ស្ថានភាព ឲ្យ ល្អ ប្រសើរ ឡើងវិញ ជូន ប្រជាកសិករ ក្នុង រដូវ វស្សា ឆ្នាំ នេះ ។
ការចុះ ពិនិត្រ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ ដើម្បី ត្រួតពិនិត្រពី ស្ថានភាព បង្កបង្កើន ផល និង ជីវិត សត្វ ពាហនៈ របស់ ប្រជាកសិករ ក្នុង ស្រុក សំរោងទង ខេត្ត កំពង់ស្ពឺ ដែល ត្រូវបាន ប៉ះទង្គិច ដោយសារ ទទួលរង នូវ បាតុភាព គ្រោះ ធម្មជាតិ បង្កឡើង ដោយ ទឹក ជំនន់ ទឹកភ្លៀង ។
សូម បញ្ជាក់ ថា បាតុភាព គ្រោះ ធម្មជាតិ ដែល បង្កឡើង ដោយ ទឹក ជំនន់ នា ប៉ុន្មាន ថ្ងៃ នេះ បាន បង្កឲ្យ មាន ជំនន់ ទឹកភ្លៀង ហូរ កាត់ ដី ស្រែ របស់ ប្រជាកសិករ ជាង ១ ពាន់ ហិកតា ប៉ុន្តែ មក ទល់ ពេលនេះ ស្ថានភាព ទឹក ជំនន់ មិន បង្កឲ្យ ខូចខាត ធ្ងន់ធ្ងរ នោះ ទេ ទាំង ដំណាំ ស្រូវ និង សត្វ ហណៈ រហូតមកទល់ ពេលនេះ ទឹក បាន ស្រកចុះ ជា បណ្តើរ ៗ ហើយ ការលិចលង់ នៅសល់ តិចតួច ណាស់ គឺ នៅ សេសសល់ តែ តំបន់ ទំនប់ មាត់ អូរ តែ ប៉ណ្ណោះ ។
( កំពង់ចាម ) ៖ ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក ព្រៃឈរ និង ជា បេក្ខជន តំណាងរាស្ត្រ គណបក្ស ប្រជាជន កម្ពុជា មណ្ឌល ខេត្ត កំពង់ចាម លោក ប៉ាន សូរស័ក្តិ បាន សារភាព ប្រាប់ ប្រជាពលរដ្ឋ ស្រុក ព្រៃឈរ ថា ក្តី ប្រាថ្នា ចង់ ឃើញ ប្រជាជន ខ្មែរ បាន រស់ នៅ ក្រោម ម្លប់ សន្តិភាព ហើយ ប្រទេស កម្ពុជា បាន រីកចម្រើន ដូច អារ្យ ប្រទេស គឺជា ហេតុផល ចម្បង តែ មួយ គត់ ដែល ស្ថិត នៅ ពីក្រោយ ការធ្វើ មាតុភូមិ និវត្តន៍ របស់ លោក ពី សហរដ្ឋ អាមេរិក នៅក្នុង ឆ្នាំ ១៩៩២ ។
បេក្ខជន តំណាងរាស្ត្រ រូប នេះ បាន សារភាព ដូច្នោះ នា ឱកាស ចុះ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស តំណាងរាស្ត្រ នីតិកាល ទី៦ ដើម្បី ស្វែងរក សំឡេង ឆ្នោត នៅក្នុង ឃុំ ថ្ម ពូន នៃ ស្រុក ព្រៃឈរ ខេត្ត កំពង់ចាម នៅ រសៀល ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ ក្រោម ការចូលរួម ពី អាជ្ញាធរ មូលដ្ឋាន សមាជិក - សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា និង ប្រជាពលរដ្ឋ ប្រមាណ ៤០០ នាក់ ។
នៅក្នុង ឱកាស នោះ លោក ប៉ាន សូរស័ក្តិ បាន ជម្រាប ជូន ប្រជាពលរដ្ឋ និង សមាជិក - សមាជិកា ទាំងអស់ អំពី ការចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី បម្រើ ប្រជាពលរដ្ឋ និង ប្រទេសជាតិ ចាប់ពី តំណែង ទីប្រឹក្សា បច្ចេកទេស រហូត ទទួលបាន ទំនុកចិត្ត និង ការផ្តល់ តំណែង ពី រាជ រដ្ឋាភិបាល ជា រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម ប្រកបដោយ កិត្តិយស ដូច ពេល បច្ចុប្បន្ន ។
បន្ថែម លើ នេះ ទៀត លោក ប៉ាន សូរស័ក្តិ ក៏ បាន ថ្លែងអំណរគុណ ដល់ សមាជិក - សមាជិកា ទាំងអស់ ដែល កន្លងមក បាន ជឿជាក់ មក លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល និង បាន ផ្តល់ យុត្តិធម៌ ជូន គណបក្ស ប្រជាជន កម្ពុជា ។
សេចក្តីថ្លែងការណ៍ ពី មន្ទីរ បញ្ចកោណ បាន បញ្ជាក់ ទៀត ថា « ជំនួយ ខាងលើ នេះ នឹង ជួយ ដល់ ការហ្វឹកហ្វឺន បំពាក់ គ្រឿង បរិក្ខា ប្រឹក្សា ជំនាញ និង កសាង មូលដ្ឋាន ការពារ ខ្លួន របស់ កងកម្លាំង យោធា នៃ ប្រទេស អ៊ុយក្រែន » ។ ការផ្តល់ ជំនួយ ថ្មី នេះ គឺ កើត មាន ឡើង តែ ជិត មួយ សប្តាហ៍ ប៉ុណ្ណោះ បន្ទាប់ពី លោក ដូណាល់ ត្រាំ បាន បញ្ចប់ ជំនួប កំពូល ទ្វេ ភាគី លើក ដំបូង ជាមួយ លោក ពូទីន ដែល កាល ណោះ លោក ពូទីន ក៏ បាន ព្យាយាម លើកឡើង ពី បញ្ហា ភាគ ខាងកើត អ៊ុយក្រែន ផងដែរ ប៉ុន្តែ ត្រូវបាន លោក ត្រាំ បដិសេធ មិន ពិភាក្សា ឡើយ ។
អភិបាល ខេត្ត ព្រះវិហារ ប្រគល់ ម៉ូតូ ៥១ គ្រឿង ជា អំណោយ របស់ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការ នគរបាល ជាតិ ជូន ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទូទាំង ខេត្ត
( ព្រះវិហារ ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រគល់ ម៉ូតូ ចំនួន ៥១ គ្រឿង ដែល ជា អំណោយ របស់ ក្រសួង មហាផ្ទៃ និង អគ្គ ស្នងការ នគរបាល ជាតិ ប្រគល់ ជូន ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ សង្កាត់ នីមួយ ៗ ទាំង ៥១ ក្នុង ខេត្ត ព្រះវិហារ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះវិហារ ។
ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន បាន ឲ្យដឹង ថា នេះ ជា លើក ទី៤ ហើយ ដែល ក្រសួង មហាផ្ទៃ បាន ប្រគល់ របប ម៉ូតូ បន្ថែម ពីលើ របប សាំង និង ថវិកា ប្រចាំ ត្រីមាស ដែល ក្រសួង បាន ផ្ដល់ជូន ដល់ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ឃុំ - សង្កាត់ នៅ ទូទាំង ប្រទេស ក៏ ដូចជា ក្នុង ខេត្ត ព្រះវិហារ សម្រាប់ បម្រើ ឲ្យ កិច្ច ប្រតិបត្តិការ រក្សា សន្តិសុខ ជូន ប្រជាពលរដ្ឋ ។
ជាមួយគ្នា នេះ លោក ស្នងការ នគរបាល ខេត្ត បាន ជម្រុញឲ្យ កងកម្លាំង នគរបាល ទូទាំង ខេត្ត ត្រូវ យកចិត្តទុកដាក់ បង្រ្កាប បទល្មើស ផ្សេង ៗ ឲ្យ មាន ប្រសិទ្ធភាព ពិសេស ការអនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ទាំង ៩ចំណុច ។
ជាមួយគ្នា នេះ ផងដែរ លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ម៉ូតូ នេះ គឺ ប្រគល់ ឱ្យ ប៉ុស្តិ៍ នគរបាល ដោយ មិន គិត លុយ នោះ ទេ កន្លងមក នៅ ខេត្ត ផ្សេង បាន លេចឮ ព័ត៍មាន ថា មាន ការយក លុយ តែ សម្រាប់ ខេត្ត ព្រះវិហារ កុំ ឱ្យ កើតមាន ឱ្យ សោះ ដោយ លោក អភិបាល ខេត្ត បាន ផ្តាំផ្ញើរ ទៅ លោក ស្នងការ និង អធិការ ក្រុង ស្រុក ត្រូវ តាមដាន សកម្មភាព នេះ ផង ។
លោក អភិបាល ខេត្ត សង្កត់ធ្ងន់ ថា ឆ្លើយតប ទៅនឹង ការគិតគូរ យកចិត្តទុកដាក់ នេះ នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ទាំងអស់ ត្រូវ យក ម៉ូតូ ទៅ ប្រើប្រាស់ ឱ្យ បាន ចំ ទិសដៅ បម្រើ ឱ្យ ផលប្រយោជន៍ រួម ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ទូទៅ និង ចៀសវាង ឱ្យ បាន នូវ ការយកមធ្យោបាយ នេះ ទៅ ប្រើប្រាស់ ខុស គោលដៅ បម្រើ ឱ្យ ផលប្រយោជន៍ បុគ្គល ព្រមទាំង ថែរក្សា ឱ្យ បាន គង់វង្ស យូរអង្វែង ។
ជាមួយគ្នា នេះ ផងដែរ លោក អ៊ុន ចាន់ ដា បាន ឧបត្ថម្ភ ដល់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះវិហារ នូវ ស៊ីម៉ង់ត៍ ចំនួន ៣៦តោន សង្ក័ សី៥ម៉ែត្រ ចំនួន ៣៦ សន្លឹក សង្ក័ សី២ម៉ែត្រ ចំនួន ១៧សន្លឹក គ្រួស អង ឌឺ ចំនួន ៨២ ម៉ែត្រ គូប និង ខ្សាច់ ចំនួន ២៦ម៉ែត្រ គូប សម្រាប់ សាងសង់ ដាក់ សម្ភារ ផ្សេង ៗ ផងដែរ ៕ ករណី បាញ់ប្រហារ នៅ អាមេរិក កាន់តែ អាក្រក់ ! ក្មេងប្រុស អាយុ ០៤ ឆ្នាំ ទាញ កាំភ្លើង បាញ់ ក្មេងស្រី អាយុ ០២ ឆ្នាំ ស្លាប់ នៅ រដ្ឋ កាលីហ្វរញ៉ា !
សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា ប្រកាស ថា ខ្លួន មាន សមត្ថភាព គ្រប់គ្រាន់ ដើម្បី សង្កេតការណ៍ បោះឆ្នោត ខាងមុខ
( ភ្នំពេញ ) ៖ សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា នៅ ថ្ងៃទី ២១ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្តីប្រកាស ថា សមាគម មាន សមត្ថភាព គ្រប់គ្រាន់ ដើម្បី សង្កេតការណ៍ សម្រាប់ ការបោះឆ្នោត ជាតិ ជ្រើសតាំង តំណាងរាស្រ្ត អាណត្តិ ទី ០៦ នៅពេល ខាងមុខ នេះ ។
ការប្រកាស នេះ បាន ធ្វើឡើង បន្ទាប់ពី មាន សារព័ត៌មាន មួយ ចោទ សួរ ទៅដល់ សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា អំពី បទពិសោធន៍ សង្កេតការណ៍ បោះឆ្នោត របស់ ខ្លួន បន្ទាប់ពី សមាគម នេះ បាន ចុះឈ្មោះ ចូលរួម សង្កេតការណ៍ បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ។
នៅក្នុង ចម្លើយ ទៅនឹង ការចោទសួរ ខាងលើ នេះ សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា បាន ឆ្លើយតប ៥ ចំណុច ដែល មាន ខ្លឹមសារ ទាំងស្រុង ដូច ខាងក្រោម៖
ប .ស. ស និង អគ្គ នាយកដ្ឋាន ដឹកជញ្ជូន ផ្លូវគោក បន្ត យុទ្ធនាការ ប្រឡង យក បណ្ណ បើកបរ ដល់ អ្នកបើកបរ រថយន្ត ដឹក កម្មករ នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ បេឡា ជាតិ របប សន្តិសុខ សង្គម ( ប.ស. ស) បាន ចាត់ ក្រុមការងារ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក សម្រាប់ គាំពារ កម្មករ និយោជិត ( ស. ផ. ក) សហការ ជាមួយ អគ្គ នាយកដ្ឋាន ដឹកជញ្ជូន ផ្លូវគោក នៃ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បន្ត យុទ្ធនាការ រៀបចំ វគ្គ ប្រឡង យក បណ្ណ បើកបរ ដល់ អ្នកបើកបរ រថយន្ត ដឹក កម្មករ និយោជិត ដែល គ្មាន បណ្ណ បើកបរ តាម ប្រព័ន្ធ ស្វ័យប្រវត្តិកម្ម (Online) ដល់ អ្នកបើកបរ រថយន្ត ដឹក កម្មករ ដែល មាន ទីតាំង ស្ថិត នៅក្នុង តំបន់ សេដ្ឋកិច្ច ខេត្ត ព្រះសីហនុ ។
វគ្គ ប្រឡង យក បណ្ណ បើកបរ ដល់ អ្នកបើកបរ រថយន្ត ដឹក កម្មករ នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១៨ គោលបំណង ចម្បង គឺ ដើម្បីឱ្យ អ្នកបើកបរថយន្ត ដឹក កម្មករ ទាំងអស់ មាន បណ្ណ បើកបរ គ្រប់ ៗ គ្នា និង ត្រូវ មាន បណ្ណ បើកបរ រថយន្ត ស្រប តាម ប្រភេទ យានយន្ត ដឹក កម្មករ ដែល ច្បាប់ បាន កំណត់ ។
យុទ្ធនាការ ប្រឡង ផ្តល់ បណ្ណ បើកបរ នេះ រៀបចំឡើង ដោយ មាន អ្នកចូលរួម ជា អ្នកបើកបរ រថយន្ត ដឹក កម្មករ និយោជិត សរុប ចំនួន ៦៧ នាក់ ក្នុង នោះ អ្នក គ្មាន បណ្ណ បើកបរ មាន ចំនួន ២៦ នាក់ និង អ្នក មាន បណ្ណ បើកបរ មិន ស្រប តាម ប្រភេទ យានយន្ត មាន ចំនួន ៤១ នាក់ ( ប្រភេទ ឃ ) ។ នីតិវិធី នៃ ការប្រឡង នេះ មាន ទាំង ការប្រឡង ទ្រឹស្តី និង ដៃ ចង្កូត ផ្ទាល់ ។
វគ្គ ប្រឡង យក បណ្ណ បើកបរ នេះ ត្រូវបាន រៀបចំឡើង ដោយ មាន ការត្រួតពិនិត្យ និង គ្រប់គ្រង តាម ប្រព័ន្ធ ប្រតិបត្តិការ កុំព្យូទ័រ ស្វ័យប្រវត្តិ (Online) របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ដែល តម្រូវ ឱ្យ អ្នក ប្រឡង យក បណ្ណ បើកបរ ទាំងអស់ ត្រូវ អនុវត្ត តាម ការណែនាំ យ៉ាង ត្រឹមត្រូវ ។
យោង តាម របាយការណ៍ ត្រីមាស ទី២ ឆ្នាំ ២០១៨ របស់ ក្រុមការងារ ស. ផ. ក បាន ឱ្យដឹង ថា ករណី គ្រោះថ្នាក់ ចរាចរណ៍ មក លើ កម្មករ និយោជិត មាន ការថយចុះ ចំនួន ១០% បើ ធៀប នឹង ត្រីមាស ទី១ ឆ្នាំ ២០១៨ ។ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ដែល បង្កឡើង ដោយ រថយន្ត ដឹក កម្មករ និយោជិត មាន ចំនួន ៨ករណី ។
