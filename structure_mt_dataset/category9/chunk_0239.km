( ភ្នំពេញ ) ៖ យោង តាម ព្រះរាជ តម្រិះ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត សម្តេច ចៅហ្វា វាំង គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង ជា ព្រះរាជ តំណាង ដ៏ ខ្ពង់ខ្ពស់ របស់ ព្រះអង្គ បាន នាំយក ព្រះរាជ អំណោយ ដែល ជា ព្រះរាជ ទាន ដ៏ ថ្លៃថ្លា របស់ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ទៅ ចែកជូន ដល់ មន្ទីរពេទ្យ និង អង្គការ សមាគម នានា ។
សកម្មភាព នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២១ រួម ដំណើរ ដោយ លោក គុយ សុផល ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ និង ជា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក កិច្ចការ ទូទៅ អម ក្រសួង ព្រះបរម រាជ វាំង លោក ឈា ហន រដ្ឋមន្ត្រី អម ក្រសួង ព្រះបរម រាជ វាំង និង មន្ត្រី អ្នកមុខអ្នក ការសំខាន់ ៗ របស់ ក្រសួង ព្រះបរម រាជ វាំង ។
ព្រះរាជ អំណោយ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ប្រោស ព្រះរាជ ទាន តាមរយៈ សម្តេច ចៅហ្វា វាំង ព្រះរាជ តំណាង ក្នុង ឱកាស នេះ មាន៖
សម្តេច ចៅហ្វា វាំង បាន ជម្រាប ជូន ថា សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ មាន ព្រះរាជ ហឬ ទ័យ គិតគូរ ដ៏ ខ្ពង់ខ្ពស់ ជានិច្ច អំពី សុខ ទុក្ខ ក្នុង បញ្ហា ជីវភាព រស់ នៅ របស់ ប្រជារាស្រ្ត ក្រីក្រ ជួប ការលំបាក ដូន ជី ស្ត្រី កុមារា កុមារី ដែល មាន ជំងឺ បាន មក សម្រាក ព្យាបាល នៅ តាម មន្ទីរពេទ្យ និង រស់ នៅ ក្រោម ការបីបាច់ រក្សា របស់ អង្គការ សមាគម ទាំង នេះ ។
ហេតុ នេះ ហើយ សម្តេច ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ សព្វ ព្រះរាជ ហឬ ទ័យ ប្រោស ព្រះរាជ ទាន នូវ ព្រះរាជ ទ្រព្យ ដ៏ សន្ធឹកសន្ធាប់ ថ្លៃថ្លា តាមរយៈ សម្តេច ចៅហ្វា វាំង មាន ជា ថវិកា ស្បៀងអាហារ សម្ភារៈ អនាម័យ ព្រមទាំង គ្រឿង ឧបភោគ បរិភោគ សម្រាប់ ជួយ ទ្រទ្រង់ សកម្មភាព របស់ អង្គការ សមាគម និង ការជួយ លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជារាស្ត្រ ក្រីក្រ ដូន ជី ស្ត្រី កុមារា កុមារី ជា កូន ចៅ ចៅ ទួត របស់ ព្រះអង្គ ឲ្យ មាន ភាពល្អ ប្រសើរ ។
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន សម្រេច ផ្អាក សកម្មភាព អាជីវកម្ម ផលិតកម្ម របស់ ក្រុមហ៊ុន ធី អិល អ៊ែរ អិច ប្រេស ឯ . ក មាន ទីតាំង ស្ថិត នៅ អគារ លេខ ៣៤៥ ផ្លូវ ២១៥ សង្កាត់ ផ្សារ ដេប៉ូទី៣ ខណ្ឌ ទួលគោក ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។
សេចក្ដីសម្រេច ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ សម្រេច ផ្អាក អាជីវកម្ម ក្រុមហ៊ុន មួយ នេះ ជា បណ្ដោះអាសន្ន រយៈពេល ៧ ថ្ងៃ គិត ចាប់ពី ម៉ោង សូន្យ នា ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០២១ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន កំណត់ ទៀត ថា បុគ្គលិក និង កម្មករ និយោជិត ដែល បម្រើ ការងារ នៅ ទីតាំង នេះ ត្រូវ ចូលរួម សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន មន្ដ្រី ជំនាញ និង មន្ដ្រី សុខាភិបាល ដើម្បី ទៅ យក សំណាក វិភាគរក មេរោគ កូវីដ១៩ នៅ ទីតាំង ដែល បាន រៀបចំ និង ត្រូវ ធ្វើចត្តាឡី ស័ក ឲ្យបាន ត្រឹមត្រូវ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
និយោជក ម្ចាស់ ឬ អ្នកគ្រប់គ្រង ត្រូវ ចូលរួម សហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន មន្ដ្រី ជំនាញ និង មន្ដ្រី សុខាភិបាល ដើម្បី ស្រាវជ្រាវ និង កំណត់ អ្នក ប៉ះពាល់ ផ្សេង ៗ ទៀត ព្រមទាំង ចូលរួម សហការ អនុវត្ត រាល់ វិធានការ រដ្ឋបាល និង វិធានការ សុខាភិបាល ឲ្យបាន ម៉ឺងម៉ាត់ ។
ខាងក្រោម នេះ ជា សេចក្ដីសម្រេច របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ៖ ខេត្ត រតនគិរី រកឃើញ អ្នក ឆ្លង កូវីដ ម្នាក់ តាម ការធ្វើតេស្តរហ័ស ក្រោយ ធ្វើដំណើរ មកពី រាជធានី ភ្នំពេញ
លុះ ដល់ ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២១ បាន ធ្វើដំណើរ តាម រថយន្ត ឈ្នួល ដឹក អ្នកដំណើរ ពី ភ្នំពេញ មក ខេត្ត រតនគិរី តាម រថយន្ត ម៉ាក Ford ផ្លាកលេខ ភ្នំពេញ 2AV-4159 និង បាន មកដល់ ចំណុច ត្រួតពិនិត្យ បឋម ស្ពាន ស្រែពក ព្រំប្រទល់ ខេត្ត រតនគិរី - ស្ទឹងត្រែង ក្រុមការងារ ឆ្លើយតប បន្ទាន់ មន្ទីរ សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត រតនគិរី ដែល ប្រចាំ ការ នៅ ចំណុច គោលដៅ បាន ធ្វើ ការត្រួតពិនិត្យ និង កំណត់ ចូលនិយមន័យ សង្ស័យ ធ្វើតេស្ត រហ័ស លទ្ធផល វិជ្ជមាន ជំងឺ កូវីដ១៩ ។ ដោយឡែក អ្នក រួម ដំណើរ ១០នាក់ ទៀត អវិជ្ជមាន ។
បច្ចុប្បន្ន អ្នកវិជ្ជមាន និង អ្នក ពាក់ព័ន្ធ ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល និង ធ្វើចត្តាឡី ស័ក នៅ វិទ្យាល័យ ត្រពាំងក្រហម ស្ថិត នៅ ភូមិ ៣ ឃុំ ត្រពាំងក្រហម ស្រុក កូនមុំ ខេត្ត រតនគិរី ។
រដ្ឋបាល ខេត្ត រតនគិរី សង្ឃឹម យ៉ាង មុតមាំ ថា ប្រជាពលរដ្ឋ និង សាធារណជន ទាំងអស់ នឹង ចូលរួម សហការ អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត នូវ វិធានការ « ៣ការពារ .៣កុំ » ឲ្យបាន ខ្ជាប់ខ្ជួន ដើម្បី បង្ការ និង ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ចូលក្នុង សហគមន៍ និង ក្រុមគ្រួសារ ៕
ក្រសួង សុខាភិបាល បញ្ជាក់ ថា ការកែសម្រួល នេះ ធ្វើឡើង យោង លើ ការអនុវត្ត ជាក់ស្តែង ក្នុង ការព្យាបាល កូវីដ - ១៩ នៅ កម្ពុជា និង អនុសាសន៍ របស់ អង្គការ សុខភាព ពិភពលោក ស្តីពី លក្ខខណ្ឌ បញ្ចប់ ការព្យាបាល អ្នកជំងឺ វីដ - ១៩ ក្រសួង សុខាភិបាល ៕
សូម ជម្រាប ថា គិត ត្រឹម ព្រឹក ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៣៧.៣២១ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ សរុប ចំនួន ៣០. ៦១៧ នាក់ និង ស្លាប់ សរុប ចំនួន ៣១១ នាក់ ៕ អាជ្ញាធរ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង សម្រេច បើក ដំណើរការ តូប លក់ដូរ នៅ ផ្សារ ដូនស ឡើងវិញ ក្រោយ អាជីវករ បញ្ចប់ ការធ្វើចត្តាឡី ស័ក
( ស្វាយរៀង ) ៖ លោក ហែម សារិទ្ធ អភិបាល ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ១១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ក្រុមការងារ ស្រុក សហការ ជាមួយ ក្រុមប្រឹក្សា ឃុំ ដូន ស ចុះ ផ្សព្វផ្សាយ សេចក្តីជូនដំណឹង ស្តីពី ការបញ្ចប់ ការធ្វើចត្តាឡី ស័ក និង ដំណើរការ តូប លក់ដូរ នៅ ទីប្រជុំជន ផ្សារ ដូន ស ស្ថិត នៅ ឃុំ ដូនស ឡើងវិញ ។
លោក ហែម សារិទ្ធ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ បន្ត ចូលរួម អនុវត្ត វិធានការ ការពារ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល គឺ « ៣ការពារ ៣កុំ » ឱ្យ បាន ជាប់ ជាប្រចាំ ផងដែរ ។
រដ្ឋបាល ក្រុង កំពង់ឆ្នាំង បើក ឱ្យ ដំណើរការធ្វើចរាចរណ៍ រថយន្ត តាក់ស៊ី ទាំងអស់ រវាង ក្រុង កំពង់ឆ្នាំង - រាជធានី ភ្នំពេញ ឡើងវិញ ក្រោយ ផ្អាក ២ ថ្ងៃ
ជាមួយនឹង ការអនុញ្ញាតឱ្យ ចរាចរណ៍ រថយន្ត តាក់ស៊ី ឡើងវិញ នេះ រដ្ឋបាល ក្រុង កំពង់ឆ្នាំង ក៏ បាន អំពាវនាវ ចំពោះ ប្រជាពលរដ្ឋ ទូទៅ ដែល ធ្វើដំណើរ តាម រថយន្ត តាក់ស៊ី ប្រកាន់ភ្ជាប់ នូវ វិធានការ « ៣ការពារ ៣កុំ » ហើយ រថយន្ត តាក់ស៊ី ទាំងអស់ ត្រូវ ចូល ចត នៅ កន្លែង តែ មួយ តាម ការកំណត់ របស់ សមត្ថកិច្ច ហាម ចត ដោយ គ្មាន សណ្តាប់ធ្នាប់ របៀបរៀបរយ ដូចជា នៅ សួន ពុទ្ធិ សែន នាង កង្រី . ផ្លូវ កែង ជិត សាលា បឋមសិក្សា គំរូ ក្នុង និង កន្លែង ផ្សេង ៗ ទៀត ។
រដ្ឋបាល ក្រុង កំពង ឆ្នាំង ក៏ បាន អំពាវនាវ សារជាថ្មី ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល មាន ការពាក់ព័ន្ធ ជាមួយនឹង ឈ្មោះ ញូង វណ្ណា និង ឈ្មោះ សោម ឡុង ដែល វិជ្ជមាន មេរោគ កូវីដ - ១៩ (Covid-19) បើ មាន អាការៈ សុខភាព មិន ស្រួល ឬ មាន ការសង្ស័យ ត្រូវ ប្រញាប់ប្រញាល់ មក ពិនិត្យ សុខភាព នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ៕ តំណាង អ្នក ឧកញ៉ា ពុង ឃាវ សែ ចុះ ចែក អំណោយ ដល់ ប្រជាពលរដ្ឋ ២២៣ គ្រួសារ រស់ នៅក្នុង បុរី « រុងរឿង »
លោក ផន សុភាព បាន ឲ្យដឹង ថា កន្លងមក ក្រុមហ៊ុន បាន ធ្វើ ការចែក អំណោយ សប្បុរសធម៌ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល បាន ស្ម័គ្រចិត្ត រស់ នៅក្នុង បុរី រុងរឿង តំបន់ អភិវឌ្ឍន៍ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ បាន ចំនួន ២៧ លើក រួច មកហើយ ហើយ នេះ ក៏ ជា លើក ទី ២៨ ផងដែរ ។
ប៉ុន្តែ ក្រោយ ពី តំបន់ ជ្រោយ ចង្វារ នេះ ត្រូវបាន រាជ រដ្ឋាភិបាល សម្រេច ប្រគល់ សិទ្ធិ ឲ្យ ក្រុមហ៊ុន វិនិយោគទុន អណិក ជន កម្ពុជា (OCIC) ដើម្បី ធ្វើ ការអភិវឌ្ឍន៍ តំបន់ នេះ ឲ្យ ទៅជា ទីក្រុង រណប ថ្មី មួយ ទៀត នៅក្នុង រាជធានី ភ្នំពេញ ឃើញ ថា តំបន់ នេះ ត្រូវបាន ផ្លាស់ប្តូរ មុខមាត់ ថ្មី ស្រប តាម ការអភិវឌ្ឍន៍ របស់ ប្រទេសជាតិ ៕
ទោះជា បែប នេះ ក្តី អ្នកតាមដាន នានា ពិតជា បាន មើលឃើញ ថា ការលើកឡើង របស់ លោក បូរី ស ចន សុន ខាងលើ នេះ គឺជា ការបង្ហាញ យ៉ាង ច្បាស់ ថា ប្រធានាធិបតី អាមេរិក ដែល ទើប ឡើង កាន់អំណាច បាន ប៉ុន្មាន ខែ រូប នេះ មាន ទស្សន ពហុ ភាគី និយម ដែល ធ្វើឲ្យ សម្ព័ន្ធ អឺរ៉ុប ទាំងឡាយ ងាយស្រួល ក្នុង ការសហការ ជាមួយ ផ្ទុយ ពី អតីត រដ្ឋបាល លោក ដូណាល់ ត្រាំ ដែល បាន ធ្វើឲ្យ គ្រប់ គ្នា តក់ស្លុត ។
គួរ បញ្ជាក់ ថា មជ្ឈមណ្ឌល គ្រប់គ្រង និង បង្ការ ជំងឺ ឆ្លង របស់ សហរដ្ឋ អាមេរិក (CDC) នា ពេល បច្ចុប្បន្ន នេះ គឺ តម្រូវ ឱ្យ អ្នកដំណើរ និង នាវិក ច្រើន ជាង ៩៥ ភាគរយ ត្រូវ ទទួល ការចាក់ វ៉ាក់សាំង ទើប អនុញ្ញាតឱ្យ ខ្សែ នាវា ទេសចរណ៍ នោះ អាច ឆ្លងកាត់ សម្រាប់ ដំណើរកម្សាន្ត បាន ៕
លោក បៃ ដិន បាន គូសបញ្ជាក់ ដូច្នេះ ថា៖ « សហរដ្ឋ អាមេរិក កំពុង បរិច្ចាគ វ៉ាក់សាំង ៥០០ លាន ដូស ដោយ គ្មាន ភ្ជាប់ លក្ខខណ្ឌ អ្វី ទាំងអស់ ។ វ៉ាក់សាំង របស់ យើង មិន មានបញ្ចូល សម្ពាធ ណាមួយ ដើម្បី បង្ខំ ឬ ចង់បាន សម្បទាន មក វិញ នោះ ទេ ដ្បិត អ្វី ដែល យើង កំពុង ធ្វើ មាន គោលដៅ តែ មួយ គត់ នោះ គឺ សង្រ្គោះ ជីវិត មនុស្ស » ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៥១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១០ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៥១ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១១ ខែមិថុនា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៥១ នាក់ នោះ មាន ២០ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៤ករណី និង ជនសង្ស័យ ៣១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៤ករណី ។
ជាមួយគ្នា នេះ លោក បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ អនុវត្ត នូវ ពាក្យស្លោក « ៣កុំ ១រាយការណ៍ » ដែល មាន ន័យ ថា « កុំ ពាក់ព័ន្ធ កុំ អន្តរាគមន៍ កុំ លើកលែង ក្នុង បទល្មើស នានា និង ជួយ រាយការណ៍ ពី បទល្មើស គ្រឿងញៀន និង បទល្មើស ផ្សេង ៗ ទៀត » ដែល កើតមាន នៅ មូលដ្ឋាន របស់ ខ្លួន ជូន ដល់ សមត្ថកិច្ច ផងដែរ ៕ អាវុធហត្ថ រាជធានី ភ្នំពេញ បញ្ជូន ជនសង្ស័យ ម្នាក់ ទៅ តុលាការ ក្រោយ វាយ ប្រពន្ធ រហូត សន្លប់ នៅ ខណ្ឌ ដង្កោ
( ភ្នំពេញ ) ៖ សមត្ថកិច្ច ជំនាញ ការិយាល័យ ប្រឆាំង ការជួញដូរ មនុស្ស នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២១ បាន បញ្ជូន ជនសង្ស័យ ម្នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី បង្ក អំពើហិង្សា ដោយ ចេតនា ទៅ លើ ប្រពន្ធ ខ្លួន ។
ជនសង្ស័យ មាន ឈ្មោះ រ៉ន សុខ ជាតិ អាយុ ៣៦ ឆ្នាំ មុខរបរ បើកបរ រថយន្ត មាន ស្រុក កំណើត នៅ ភូមិ ព្រែក ទន្លាប់ ស្រុក លើក ដែក ខេត្ត កណ្តាល បច្ចុប្បន្ន ស្នាក់ នៅ បន្ទប់ ជួល ក្នុង ភូមិ តា ឡី សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ ។
ជនសង្ស័យ កំពុង ស្ថិត ក្រោម ចំណាត់ការ របស់ តុលាការ នៅឡើយ ដើម្បី បន្ត ចាត់ការ តាម ច្បាប់ ៕ ស្រវឹង សូម កុំ បើកបរ នាំ បង្ក គ្រោះថ្នាក់ ដល់ អ្នកដទៃ ! ស្លាប់ ២នាក់ និង របួស ម្នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១០ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ម្នាក់ ។
តំណាង អង្គការ សុខភាព ពិភពលោក រូប នេះ បាន ថ្លែង បន្ដ ថា « ការបន្ធូរបន្ថយ នូវ វិធានការពារ កូវី ដ១៩ នឹង ធ្វើឱ្យ មាន កំណើន កើនឡើង នៃ ការជួបជុំគ្នា ហើយ ការជួបជុំគ្នា នេះ ហើយ ដែល ជំរុញ ឱ្យ មាន ឆ្លងកាន់តែ ច្រើន ឡើង » ។
លោកស្រី លី អាយ ឡាន បាន បន្ដ ទៀត ថា « បច្ចុប្បន្ន នេះ មិន មែន ជា ពេលវេលា ដែល យើង ត្រូវ បន្ថូរ បន្ថយ វិធានការពារ កូវី ដ១៩ នោះ ទេ គឺជា ពេលវេលា មួយ ដែល ត្រូវ ខិតខំ បន្ថែម ទៀត ដើម្បី ការពារ រៀង ៗ ខ្លួន ដើម្បី យើង បាន ចៀស ផុត និង បញ្ចប់ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ នេះ ។ ខ្ញុំ សង្ឃឹម ថា យើង នឹង អាច ឆ្លងកាត់ ដំណាក់កាល ដ៏ លំបាក នេះ ទាំងអស់ គ្នា » ។
ពាក់ព័ន្ធ នឹង ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ នេះ លោកស្រី លី អាយ ឡាន ក៏ បាន គូសបញ្ជក់ ថា « ពលរដ្ឋ កម្ពុជា មាន ភ័ព្វសំណាង ណាស់ ដែល ទទួលបាន ការចាក់ វ៉ាក់សាំង ដោយ មិន គិត ថ្លៃ ទន្ទឹម នឹង នោះ ក៏ មាន មាន ជន បរទេស ផងដែរ ។ ហើយ ខ្ញុំ ពិតជា សប្បាយចិត្ដ ដែល ឃើញ មនុស្ស វ័យ ចំណាស់ និង ជន ដែល មាន ពិការភាព បាន ទទួល ការវ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជាពិសេស ផ្ដល់ អាទិភាព មុន គេ ដោយ ការយកចិត្ដទុកដាក់ » ។
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ១០ ខែមិថុនា ឆ្នាំ ២០២១
១៖ ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ៤២៦ នាក់ ខណៈ ជាសះស្បើយ ៧៦០ នាក់
៥៖ កម្ពុជា កោតសរសើរ ចិន ដែល ផ្តល់ វ៉ាក់សាំង កូវីដ រាប់ លាន ដូស ដល់ បណ្តា ប្រទេស មេគង្គ បាន ទាន់ ពេលវេលា
៧៖ បច្ចុប្បន្នភាព ប្រចាំ ថ្ងៃ៖ គិត ត្រឹម ព្រឹក ថ្ងៃទី ១០ ខែមិថុនា នេះ តំបន់ អាស៊ាន មាន អ្នក ឆ្លង កូវីដ១៩ ជាង ៤. ២៣លាន នាក់ ស្លាប់ ជាង ៨. ២៩ម៉ឺន នាក់
១១៖ អាមេរិក ប្រគល់ វត្ថុ បុរាណ សម័យ អង្គរ ចំនួន ២៧ រូប ដែល ត្រូវបាន ជួញដូរ មក ឲ្យ កម្ពុជា វិញ
១២៖ ថៃ រាយការណ៍ ពី ស្លាប់ ៤៣ នាក់ ដោយសារ កូវីដ - ១៩ និង ឆ្លង ថ្មី ៗ ២. ៣១០នាក់ ក្នុង របាយការណ៍ ថ្ងៃព្រហស្បតិ៍ នេះ
១៤៖ ក្រុម អ្នកជំនាញ UN អំពាវនាវ ឲ្យ មេដឹកនាំ G7 ធានា ការចែកចាយ វ៉ាក់សាំង « ប្រកបដោយ តម្លាភាព » ទៅកាន់ ប្រទេស ក្រីក្រ
១៥៖ មេ បក្ស ប្រឆាំង បេឡារុស ព្រមាន ថា បេឡារុស កំពុង ក្លាយជា « កូរ៉េ ខាងជើង » ប្រចំា ទ្វីប អ៉ឺរ៉ុប
១៦៖ វិភាគ អន្តរជា តិ៖ តើ រុស្ស៉ី គួរ ឬ មិន គួរ ខ្លាច ការធ្វើ យោធូបនីយកម្ម របស់ ជប៉ុន ?
