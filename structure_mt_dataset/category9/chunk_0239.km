( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០២១ នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ កម្ពុជា បាន អនុញ្ញាតឱ្យ អនុព័ន្ធ យោធា អាមេរិក ដែល បាន ផុត អាណត្តិ និង អនុព័ន្ធ យោធា អាមេរិក ថ្មី ចូល ជួប ពិភាក្សា ការងារ នៅ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី ។
ក្រោយ ជំនួប នេះ សម្តេច ពិជ័យ សេនា បាន បញ្ជាក់ ប្រាប់ Fresh News ឱ្យដឹង ថា ក្នុង ជំនួប នោះ ភាគី ទាំង ពីរ បាន បង្ហាញ អំពី ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ មួយចំនួន កន្លងមក ។ សម្តេច បាន សរសើរ អាមេរិក ដែល ជួយ បណ្តុះបណ្តាល ធនធាន មនុស្ស នៃ កងទ័ព កម្ពុជា ព្រមទាំង បាន ស្នើសុំ ឲ្យ អនុព័ន្ធ យោធា អាមេរិក បន្ត កិច្ចសហប្រតិបត្តិការ រវាង កងទ័ព កម្ពុជា និង អាមេរិក ដែល បាន ខកខាន កន្លងមក ដោយសារ វិបត្តិ ជំងឺ កូវីដ - ១៩ ។
ជំនួប រវាង ប្រមុខ ការពារ ជាតិ កម្ពុជា ជាមួយ អនុព័ន្ធ យោធា អាមេរិក បាន ធ្វើឡើង បន្ទាប់ពី កម្ពុជា យល់ព្រម តាម សំណើ អាមេរិក ដែល នឹង អនុញ្ញាតឱ្យ អនុព័ន្ធ យោធា អាមេរិក ចុះ ពិនិត្យមើល កំពង់ផែ រាម នៅពេល ខាងមុខ នេះ ដើម្បីឱ្យ អស់ មន្ទិល សង្ស័យ អំពី មូលដ្ឋាន ទ័ព ចិន ។
ទោះជា យ៉ាង នេះ ក្តី នៅក្នុង ជំនួប ខាងលើ នេះ ភាគី ទាំង ពីរ មិន បាន កំណត់ ពេលវេលា ជាក់លាក់ ដែល នឹង ចុះ ទៅកាន់ តំបន់ រាម នៅឡើយ ទេ ។
នា ពេល កន្លងទៅ សារព័ត៌មាន មួយចំនួន របស់ សហ អាមេរិក បន្ត វាយប្រហារ ជា បន្តបន្ទាប់ ថា កម្ពុជា បាន អនុញ្ញាតឱ្យ ចិន ដាក់ មូលដ្ឋាន ទ័ព នៅក្នុង ប្រទេស នៅ តំបន់ រាម ខណៈ ដែល កម្ពុជា បាន បំភ្លឺ ម្តង ហើយ ម្តង ទៀត ថា ខ្លួន មិន អនុវត្ត ផ្ទុយ ពី រដ្ឋធម្មនុញ្ញ ជា ច្បាប់ កំពូល របស់ ប្រទេស នោះ ឡើយ ហើយក៏ មិន មាន មូលដ្ឋាន ទ័ព បរទេស នៅក្នុង ប្រទេស កម្ពុជា ដូច ការផ្សព្វផ្សាយ បំភ្លៃ នោះ ដែរ ។
ពាក់ព័ន្ធ ករណី កំពង់ផែ រាម នេះ ត្រូវបាន សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បញ្ជាក់ ឱ្យដឹង ថា កម្ពុជា គ្រាន់តែ ទទួលបាន ជំនួយ ពី ចិន ដែល ជា មិត្ត ដែក ថែប ក្នុង ការជួយ សាងសង់ កំពង់ផែ តំបន់ រាម ឱ្យ មាន លក្ខណៈ ធំ ទូលាយ និង ទំនើប ជាង មុន ប៉ុណ្ណោះ ហើយ ជំនួយ នេះ មិន មាន លក្ខខណ្ឌ ដូច មហា អំណាច ដទៃ ទេ ។
សម្តេច បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា ពេលនេះ កំពង់ផែ រាម កំពុង ស្ថិត នៅក្នុង ដំណាក់កាល សាងសង់ នៅឡើយ ហើយ បន្ទាប់ពី សាងសង់ រួច កម្ពុជា ទេ ជា អ្នកប្រើប្រាស់ នូវ កំពង់ផែ ទំនើប នេះ ដោយ មិន បាន ប្រគល់ ឱ្យ ចិន ផ្តាច់ មុខ ដូច ការចោទប្រកាន់ របស់ អាមេរិក នោះ ឡើយ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ៖ អាជ្ញាធរ ច្រានចោល ព័ត៌មាន ថា មាន ការដាក់ គ្រឿងចក្រ ជីក កាត់ផ្តាច់ ផ្លូវ សាធារណៈ មិន ឲ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ចូលទៅ អាស្រ័យ ផល នៅ ឃុំ ព្រែក ដាច់ ស្រុក លើក ដែក ខេត្ត កណ្តាល
( កណ្តាល ) ៖ អាជ្ញាធរ មូលដ្ឋាន ឃុំ ព្រែក ដាច់ ស្រុក លើក ដែក ខេត្ត កណ្តាល នៅ ថ្ងៃទី ៨ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ច្រានចោល ព័ត៌មាន ថា មាន ការដាក់ គ្រឿងចក្រ ជីក កាត់ផ្តាច់ ផ្លូវ សាធារណៈ មិន ឲ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ចូលទៅ អាស្រ័យ ផល នៅ ភូមិ ព្រែក តូច ហើយ ការកាយ នេះ គឺ ធ្វើឡើង នៅក្នុង ដី ឯកជន ស្រប ច្បាប់ នោះ ទេ ។
អាជ្ញាធរ ថា មាន ប្រជាពលរដ្ឋ មួយចំនួន តូច មក តវ៉ា គឺ មិន មែន ជា ម្ចាស់ ដី ជាក់ស្តែង នៅ តំបន់ នោះ ឡើយ គ្រាន់តែ ធ្វើ ដើម្បី រឿង អ្វី មួយ នៅ ពីក្រោយ ខ្នង ប៉ុណ្ណោះ ។
ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ តំណាង ម្ចាស់ ដី ស្រប ច្បាប់ ក៏ បាន ចេញមុខ អះអាង នៅ ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ថា ពួកគាត់ មិន បាន ប្រើ គ្រឿងចក្រ កាយ ដី ផ្តាច់ ផ្លូវ សាធារណៈ នៅ ភូមិ ព្រែក តូច ឃុំ ព្រែក ដាច់ ធ្វើឲ្យ អ្នក ផ្សេង រង ទុក្ខ ដូច ការផ្សព្វផ្សាយ តាម បណ្តាញ សង្គម នោះ ឡើយ ។
ជាមួយគ្នា នេះ ដែរ តំណាង ម្ចាស់ ដី ស្រប ច្បាប់ ថ្លែង ទៀត ថា ខ្លួន បាន រៀបចំ ឯកសារ ពាក់ព័ន្ធ ផ្លូវ ច្បាប់ រួចហើយ ដើម្បីឲ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច វែក មុខ មេក្លោង នៅ ពីក្រោយ ខ្នង នៃ ការជួល និង អនុវត្ត ច្បាប់ លើ សកម្មជន ញុះញង់ ដីធ្លី ទាំងនេះ ឲ្យ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ ។
ជាមួយគ្នា នេះ អាជ្ញាធរ មូលដ្ឋាន ក៏ ពុំ បាន ឃុបឃិត ជាមួយ ឈ្មួញ ណា ដើម្បី ធ្វើបាប ពលរដ្ឋ ដូច ការចោទប្រកាន់ គ្មាន មូលដ្ឋាន ទាំងនោះ ឡើយ ហើយ អាជ្ញាធរ ក៏ កំពុង ជាប់រវល់ ជាមួយ ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ផងដែរ ។
សូម បញ្ជាក់ ថា ការចេញមុខ បដិសេធ បែប នេះ របស់ អាជ្ញាធរ និង ម្ចាស់ ដី ស្រប ច្បាប់ នៅ តំប ន់ នោះ បាន ធ្វើឡើង ក្រោយពី ពេល ថ្មី ៗ នេះ មាន ការផ្សព្វផ្សាយ ថា ប្រជាពលរដ្ឋ ប្រហែល ២០ នាក់ នៅក្នុង ភូមិ ព្រែក តូច ឃុំ ព្រែក ដាច់ ស្រុក លើក ដែក ខេត្ត កណ្តាល ចោទប្រកាន់ ថា មាន ការដាក់ គ្រឿងចក្រ ជីក កាត់ផ្តាច់ ផ្លូវ សាធារណៈ មិន ឲ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ ចូលទៅ អាស្រ័យ ផល ដូចជា នេសាទ ត្រី កាប់ អុស ដុត បេះ ត្រកួន ប្រលឹត ធ្វើ ស្រែ ចម្ការ នៅក្នុង ដីធ្លី របស់ ពួកគាត់ ទេ ៕
អ្នក ឧកញ៉ា គិត ម៉េង ឧបត្ថម្ភ ១ម៉ឺន ដុល្លារ ដល់ គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល
លោក គង់ សោភ័ណ្ឌ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ អ្នក ឧកញ៉ា គិត ម៉េង និង លោកជំទាវ ដែល បាន ឧបត្ថម្ភ ថវិកា ១០.០០០ ដុល្លារ ដើម្បី អបអរ ខួប ទី១៥៨ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ២០២១ ក្រោម ប្រធានបទ « ទាំងអស់ គ្នា រួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ និង កសាង ភាពធន់ របស់ សង្គមជាតិ » ។
លោក បន្ត ថា សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល នឹង យកចិត្តទុកដាក់ ប្រើប្រាស់ អំណោយ ដ៏ សប្បុរស នេះ ប្រកបដោយ តម្លាភាព ក្នុង ការបម្រើ សកម្មភាព មនុស្សធម៌ ជួយ ដល់ ជន ងាយ រងគ្រោះ និង ជនរងគ្រោះ ដោយ គ្រោះ ធម្មជាតិ និង គ្រោះមហន្តរាយ ផ្សេង ៗ ៕
ទីប្រឹក្សា ក្រសួង ធម្មការ ប្រគល់ អណ្តូង ទឹក ៧កន្លែង ដល់ ពលរដ្ឋ នៅ ខេត្ត ត្បូងឃ្មុំ និង អំពាវនាវ ឱ្យ ពលរដ្ឋ ប្រុងប្រយ័ត្ន ពី គ្រោះ ធម្មជាតិ
( ត្បូងឃ្មុំ ) ៖ លោក ខាន់ ខុន ទីប្រឹក្សា ក្រសួង ធម្មការ និង សាសនា និង ជា នាយក សមាគម បេសកកម្ម ដំណឹង ល្អ នា ព្រឹក ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ប្រគល់ អណ្តូង ទឹក ចំនួន ០៧ នៅ ឃុំ រកាព ប្រាំ ចំនួន ០៥ អណ្ដូង និង ឃុំ ទន្លេ បិទ ចំនួន ០២ អណ្ដូង ក្នុង ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
នា ឱកាស នោះ ដែរ លោក ខាន់ ខុន បាន លើកឡើង ថា អណ្តូង ទាំង ០៧ ដែល ប្រគល់ ជូន នា ពេលនេះ ដើម្បី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ និង លើកកម្ពស់ ជីវភាព គ្រួសារ ដល់ ប្រជាពលរដ្ឋ ក្នុង រដូវកាល ការរីករាដាល ជំងឺ កូវីដ១៩ នេះ ក៏ ដូចជា ជួយ សម្រួល ដល់ សេចក្ដីត្រូវការ របស់ ប្រជាពលរដ្ឋ ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ដោយ មិន ប្រកាន់ ពូជសាសន៍ ពណ៌ សម្បុរ ឬ និន្នាការ នយោបាយ អ្វី ឡើយ ។
លោក ខាន់ ខុន បាន អំពាវនាវ ឱ្យ ពលរដ្ឋ ប្រុងប្រយ័ត្ន ពី គ្រោះ ធម្មជាតិ ខ្យល់ កន្ត្រាក់ ផ្គរ រន្ទះ ថែរក្សា សុខភាព ឱ្យ បាន ល្អ ដោយ អនុវត្ត ការរស់នៅ ស្អាត ហូប ស្អាត កុំ បន្ទោរបង់ ពាសវាលពាសកាល ត្រូវ សម្រាន្ត ក្នុង មុង ដើម្បី ការពារ ពី ជំងឺ គ្រុនចាញ់ ឬ គ្រុន ឈាម ជាពិសេស បន្ត ចូលរួម អនុវត្ត វិធានការ ក្រសួង សុខាភិបាល និង រាជ រដ្ឋាភិបាល កម្ពុជា « ៣កុំ និង ៣ការពារ » ដើម្បី ជៀស ផុត ពី ជំងឺ កូវីដ១៩ ។
គួរ បញ្ជាក់ ថា រហូតមកទល់ ពេលនេះ ប្រទេស ចិន បាន កត់ត្រា នូវ ករណី ឆ្លង ជំងឺ COVID-19 សរុប នៅ ទូទាំង ប្រទេស ៩១. ៣០០ ករណី ក្នុង នោះ មាន អ្នកស្លាប់ ៤.៦៣៦ នាក់ និង អ្នក ជាសះស្បើយ ៨៦. ២៥៥ នាក់ ។ ករណី ឆ្លង សហគមន៍ នៅក្នុង ខេត្ត ក្វាង ទុង បាន និង កំពុង ធ្វើឲ្យ អាជ្ញាធរ ចិន បង្កើន ការប្រុងប្រយ័ត្ន ជាខ្លាំង ខណៈ ទីក្រុង និង ខេត្ត នៅ ជុំវិញ ខេត្ត ក្វាង ទុង ក៏ កំពុង ប្រុង ជើង ការខ្ពស់ ផងដែរ ៕
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ទទួល ជួប ឯក អគ្គ រដ្ឋទូត សាធារណរដ្ឋ ឆែក ថ្មី ប្រចាំ កម្ពុជា
លោក Tedros បាន សម្តែង ការខកចិត្ត របស់ លោក ដែល ថា ប្រទេស ក្រីក្រ ជាច្រើន មិន អាច សូម្បីតែ ផ្តល់ ការចាក់ វ៉ាក់សាំង ជូន ដល់ ក្រុម បុគ្គលិក សុខាភិបាល ក្រុម មនុស្ស ចាស់ និង ក្រុម ប្រជាជន ដទៃ ទៀត របស់ ពួកគេ ដែល ងាយ រងគ្រោះ បំផុត ដោយ ជំងឺ COVID-19 ខណៈ នា ពេល បច្ចុប្បន្ន នេះ ប្រទេស អ្នក មាន មួយចំនួន បាន និង កំពុង ទិញ វ៉ាក់សាំង ជាច្រើន ដូស ហើយ កំពុង ត្រៀម រៀបចំ ដើម្បី ចាប់ផ្តើម ផ្ដល់ ការចាក់ វ៉ាក់សាំង ជូន ដល់ ក្រុម កុមារ របស់ ពួកគេ ហើយ ។
លោក Tedros បាន អំពាវនាវ ឱ្យ មាន ការខិតខំ ប្រឹងប្រែង ជា សកល ដើម្បី ផ្ដល់ ការចាក់ វ៉ាក់សាំង ឱ្យ បាន យ៉ាងហោចណាស់ ១០ភាគរយ នៃ ចំនួន ប្រជាជន សរុប របស់ ប្រទេស នីមួយ ៗ នៅ ត្រឹម ខែកញ្ញា ហើយ យ៉ាងហោចណាស់ ៣០ ភាគរយ នៅ ត្រឹម ចុង ឆ្នាំ ២០២១ នេះ ។
