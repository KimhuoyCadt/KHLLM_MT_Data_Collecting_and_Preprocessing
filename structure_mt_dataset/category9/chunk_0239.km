( ភ្នំពេញ ) ៖ ឈរ លើ ជំនាញ ជា អ្នករកស៊ី ក្នុង វិស័យ អចលន វត្ថុ លោក ច្រឹក សុខ នីម ប្រធាន សមាគម អ្នក វាយតម្លៃ និង ភ្នាក់ងារ អចលន វត្ថុ កម្ពុជា បាន បង្ហើប ពី ទីតាំង ខេត្ត មួយចំនួន ដែល កំពុង ផ្ដល់ នូវ សក្ដានុពល នៃ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង អចលន ទ្រព្យ ដែល វិនិយោគិន មិន គួរ មើល រំលង ។
លោក ច្រឹក សុខ នីម ថ្លែង ឲ្យដឹង ថា « សម្រាប់ វិនិយោគិន ដែល វិនិយោគ លើ វិស័យ អចលន ទ្រព្យ គួរ វិនិយោគ ក្នុង រាជធានី ភ្នំពេញ តំបន់ ជាយ ក្រុង ភ្នំពេញ និង តាម បណ្ដា ខេត្ត មួយចំនួន ទៀត ដែល កំពុង ផ្សារ ជាប់ ជាមួយ រាជធានី ភ្នំពេញ មាន ដូចជា ខេត្ត កំពង់ស្ពឺ . ខេត្ត កណ្ដាល . ផ្នែក ខ្លះ នៃ ខេត្ត ព្រៃវែង ដែល ជា តំបន់ និង ខេត្ត មាន សក្ដានុពល ខ្ពស់ ព្រមទាំង អភិវឌ្ឍន៍ លឿន » ។
លោក បាន បន្ថែម ថា ការអះអាង បែប នេះ ដោយសារតែ ខេត្ត និង តំបន់ ទាំងនេះ ជា កន្លែង ដែល ផ្សារ ជាប់ ដោយ ផ្លូវ ក្រវាត់ ក្រុង ទី៣ ទី៤ និង ការអភិវឌ្ឍន៍ មុំ ៣៦០ឌឺ ក្រេ នៃ រាជធានី ភ្នំពេញ ដូច្នេះ តំបន់ ទាំងអស់ នេះ នឹង ផ្ដល់ សក្ដានុពល ខ្ពស់ នៃ ការអភិវឌ្ឍន៍ នៃ សេដ្ឋកិច្ច និង វិស័យ អចលន ទ្រព្យ ។
លោក ច្រឹក សុខ នីម ក៏ បាន បង្ហាញ ពី តំបន់ មួយចំនួន ទៀត ក្រៅ អំពី រាជធានី ភ្នំពេញ និង ខេត្ត ព្រះសីហនុ ដែល បាន និង កំពុង មាន សក្ដានុពល ខ្ពស់ ទាំង ផ្នែក អចលន ទ្រព្យ និង វិស័យ ទេសចរណ៍ គឺ មាន ខេត្ត កែប . សៀមរាប និង ខេត្ត កំពត ដែល ជា ខេត្ត ដែល មាន សក្ដានុពល ខ្ពស់ និង ជា ខេត្ត ដែល ទាក់ទាញ ភ្ញៀវ ទេសចរ និង ជំរុញ ដល់ វិស័យ អចលន ទ្រព្យ ។
លោក បន្ដ ថា នៅក្នុង ខេត្ត កែប មាន ការអភិវឌ្ឍន៍ លំនៅដ្ឋាន មួយចំនួន ធំ ពិសេស រី ស៊ត តូច ៗ កំពុង មាន វឌ្ឍនភាព រីឯ ខេត្ត កំពត ក៏ ចាប់ផ្ដើម ឡើង ពី កំពង់ផែ ជា ផ្នែក តូច មួយ សម្រួល ការដឹកជញ្ជូន ។ ចំណែក ខេត្ត សៀមរាប ជា ខេត្ត ដែល ផ្ដល់ សក្ដានុពល ខ្ពស់ ក្នុង ការទទួល ភ្ញៀវ ទេសចរ រាប់ លាន នាក់ ក្នុង មួយ ឆ្នាំ ៗ ។
លោក បញ្ជាក់ ថា មាន កត្តា ជាច្រើន ធ្វើឲ្យ ខេត្ត ទាំងនេះ មាន សក្ដានុពល ខ្ពស់ លើ វិស័យ ទេសចរណ៍ ខេត្ត សម្បូរ ដោយ ធនធាន ធម្មជាតិ . មាន ប្រាសាទ ដែល ជា កេរ្ដិ៍ តំណែល ពី ដូន តា ៕
បើ តាម គណៈកម្មការ សុខាភិបាល ជាតិ ចិន វ៉ាក់សាំង ២០. ២លាន ដូស ត្រូវបាន ចាក់ នៅ ទូទាំង ប្រទេស កាលពី ថ្ងៃសៅរ៍ ម្សិលមិញ ដែល នេះ បាន ធ្វើឱ្យ ចំនួន ចាក់ វ៉ាក់សាំង សរុប កើន ដល់ ១. ០១ ពាន់ លាន ដូស ។ កាលពី ប៉ុន្មាន សប្ដាហ៍ មុន ចិន បាន សម្រេចបាន ការចាក់ វ៉ាក់សាំង ២០ លាន ដូស ក្នុង មួយ ថ្ងៃ ពោលគឺ កើនឡើង ពី ៤. ៨លាន ដូស នៅក្នុង ខែមេសា និង ជិត ១២.៥លាន ដូស កាលពី ខែឧសភា ។
ប្រធាន យុវជន CPP ខេត្ត ព្រះវិហារ ផ្តាំ យុវជន បក្ស គោរព វិធានការ សុខាភិបាល និង អនុសាសន៍ ៣កុំ ៣ការពារ ដើម្បី ការពារ ជំងឺ កូវីដ
( ព្រះវិហារ ) ៖ លោក អ៊ុក គឹម សាន ប្រធាន យុវជន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ បាន ផ្តាំផ្ញើ ដល់ យុវជន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រះវិហារ ទាំងអស់ ត្រូវ គោរព ឱ្យ បាន ទៀងទាត់ តាម វិធានការ របស់ ក្រសួង សុខាភិបាល និង អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន « ៣កុំ និង ៣ការពារ » ដើម្បី ការពារ ខ្លួ ក្រុមគ្រួសារ និង សហគមន ពី ជំងឺ កូវីដ - ១៩ ។
ការថ្លែង អំពាវនាវ បែប នេះ របស់ លោក អ៊ុក គឹម សាន ក្នុង ឱកាស ដែល លោក ដឹកនាំ កិច្ចប្រជុំ ស្តីពី ការបូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆមាស ទី១ និង លើក ទិសដៅ ផែនការ សកម្មភាព ឆមាស ទី២ ឆ្នាំ ២០២១ របស់ ក្រុមការងារ យុវជន គណបក្ស ខេត្ត ព្រះវិហារ នា ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ដោយ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ និង សមាជិក - សមាជិកា នៃ យុវជន គណបក្ស ខេត្ត ព្រមទាំង សមាជិក - សមាជិកា ក្រុម ជំនួយការ ផងដែរ ។
នៅក្នុង កិច្ចប្រជុំ នេះ ដែរ លោក អ៊ុក គឹម សាន បាន ផ្តោត ជា សំខាន់ លើ ៥ចំណុច៖
* បាយការណ៍ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆមាស ទី១ និង លើក ទិសដៅ ផែនការ សកម្មភាព ការងារ ឆមាស ទី២ ឆ្នាំ ២០២១ ។
* សេចក្តីសម្រេច ស្តីពី ការរៀបចំ ផែនការ តាម ផែន នីមួយ ៗ និង របាយការណ៍ ។
* ផ្សព្វផ្សាយ សេចក្តីសម្រេច ស្តីពី ផែនការរួម ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ។
* ផ្សព្វផ្សាយ ពី តួនាទី ភារកិច្ច សិទ្ធិ រចនាសម្ពន្ធ និង របៀបរបប ធ្វើការ របស់ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជក កម្ពុជា ។
* ការចូលរួម មតិ យោបល់ របស់ ក្រុង ស្រុក ទាំង ៨ និង ផែន ទាំង ១១ នៃ យុវជន គណបក្ស ខេត្ត ព្រះវិហារ ។
នេះ ជា ការអនុវត្ត តាម បញ្ជា នាយ ឧត្ដមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង នាយ ឧត្ដមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង ទទួល ផែន ប្រឆាំង បទល្មើស គ្រឿងញៀន ក្រោម ការបញ្ជាដឹកនាំ ផ្ទាល់ របស់ លោក ឧត្ដមសេនីយ៍ ឯក ឡឹក វណ្ណៈ នាយក មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ខាងលើ សមត្ថកិច្ច ជំនាញ បាន កសាង សំណុំរឿង បញ្ជូន ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ បន្ត តាម នីតិវិធី ៕
មន្ទីរ សុខាភិបាល ខេត្ត កោះកុង បើក យុទ្ធនាការ ចាក់ ថ្នាំ វ៉ាក់សាំង លើក ដំបូង ជូន ពលរដ្ឋ ដើម្បី ចូលរួម ទប់ស្កាត់ ជំងឺ កូវីដ១៩
( កោះកុង ) ៖ ប្រជាពលរដ្ឋ ក្នុង ក្រុង ខេមរភូមិន្ទ ខេត្ត កោះកុង នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ ចាប់ផ្ដើម ទទួលបាន ការចាក់ វ៉ាក សាំង ការពារ ជំងឺ កូវីដ - ១៩ បណ្ដើរ ៗ ហើយ ក្រោម ការរៀបចំ របស់ មន្ទីរ សុខាភិបាល ខេត្ត កោះកុង ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង ការទប់ស្កាត់ ជំងឺ ដ៏ កាច សាហាវ នេះ ។
ការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ នេះ ធ្វើឡើង រយៈពេល ៣ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ២០ - ២២ ខែមិថុនា ឆ្នាំ ២០២១ ។ រីឯ ទីតាំង ចាក់ វ៉ាក់សាំង មាន ចំនួន ២ទីតាំ ង៖ ទីតាំង ទី១ នៅ ស្នាក់ការសាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កោះកុង និង ទីតាំង ទី២ នៅ ភោជនីដ្ឋាន ស៊ូ នឹង ស្ថិត ក្នុង ក្រុង ខេមរភូមិន្ទ ខេត្ត កោះកុង ។
លោក វេជ្ជបណ្ឌិត ទៅ ម៉ឹង បាន ឲ្យដឹង ថា ការបើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំ ការពារ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ ពលរដ្ឋ ជា លើក ដំបូង ក្រោយពី បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ ដែល ប្រឈម ជាង គេ មួយ រយៈ កន្លងមក ហើយ ។
លោក បាន បញ្ជាក់ ថា ការចាក់ ថ្នាំ វ៉ាក់សាំង ការពារ កូវីដ១៩ គឺ ក្រុម លោកគ្រូពេទ្យ ចាក់ វ៉ាក់សាំង បាន គ្រប់ ៗ គ្នា ទាំងអស់ ទាំង ជនជាតិ បទេស ក៏ ចាក់ ជូន ពួកគេ ដែរ ដោយ មិន រើសអើង ពូជសាសន៍ ឡើយ ។
លោក វេជ្ជបណ្ឌិត បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ គ្រប់ មូលដ្ឋាន ទាំងអស់ ទោះ បី ចាក់ ថ្នាំ វ៉ាក់សាំង ការពារ កូវី ដ១៩ រួចរាល់ ហើយ ក៏ ត្រូវ អនុវត្តន៍ នូវ វិធានការ ៣ការពារ ៣កុំ ឲ្យបាន ខ្ជាប់ខ្ជួន ដែរ ៕ រដ្ឋបាល ខេត្ត ក្រចេះ ជូនដំណឹង ពី ករណី ជាសះស្បើយ ពី ជំងឺ កូវីដ ១នាក់ ទៀត
( ក្រចេះ ) ៖ រដ្ឋបាល ខេត្ត ក្រចេះ នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ថា ក្រុម គ្រូពេទ្យ នៃ មន្ទីរពេទ្យ បង្អែក ខេត្ត ក្រចេះ បាន ព្យាបាល អ្នកជំងឺ កូវី១៩ ជាសះស្បើយ ម្នាក់ ទៀត ហើយ ។
យោង តាម លិខិត ជូន ដំណឹង របស់ រដ្ឋបាល ខេត្ត ក្រចេះ បាន បញ្ជាក់ ថា អ្នក ជាសះស្បើយ នោះ ឈ្មោះ ឡុង ឈាវ ហ៊ួ ភេទ ស្រី អាយុ ២៤ ឆ្នាំ រស់ នៅ ភូមិ ជើង ពាធ ឃុំ កោះ ខ្ញែ ស្រុក សំបូរ ខេត្ត ក្រចេះ ។ ក្រុម គ្រូពេទ្យ បាន អនុញ្ញាត្ត ឲ្យ ចេញ ពី មន្ទីរពេទ្យ ត្រឡប់ ទៅ លំនៅដ្ឋាន វិញ ដោយ តម្រូវឲ្យ បន្ត ធ្វើចត្តា ឡីស ក័ រយៈពេល ១៤ ថ្ងៃ នៅ ផ្ទះ ។
សូម បញ្ជាក់ ថា ខេត្ត ក្រចេះ អ្នកវិជ្ជមាន កូវីដ១៩ សរុប ចំនួន ២១ នាក់ ព្យាបាល ជាសះស្បើយ ចំនួន ១៣នាក់ ស្លាប់ ចំនួន ១នាក់ និង ៧នាក់ ទៀត កំពុង ព្យាបាល នៅឡើយ ៕
ពលរដ្ឋ និង គណៈកម្មការ វត្ត ផ្ទុះ ការតវ៉ា នឹង ព្រះសង្ឃ នៅ វត្ត កោះ ថ្មី នៃ ខេត្ត កណ្ដាល តាម សួរ រឿង បច្ច័យ សរុប ជាង ១ម៉ឺន ដុល្លារ តែ នៅ មិន ទាន់ មាន ដំណោះស្រាយ
( កណ្តាល ) ៖ ប្រជាពុទ្ធ បរិស័ទ និង គណៈកម្មការ វត្ត កោះ ថ្មី បាន លើក គ្នា ទៅ តវ៉ា ដល់ មុខ វត្ត តែម្ដង ដែល ស្ថិត ភូមិ កោះ ថ្មី ឃុំ ខ្ពប ស្រុក ស្អាង ខេត្ត កណ្ដាល ដើម្បី ទូល សុំ ឱ្យ ព្រះតេជគុណ អ៉ី ពិសិត ដែល គង់ នៅ វត្ត កោះ ថ្មី នេះ បង្ហាញ បច្ច័យ សរុប ចំនួន ១២០ លាន រៀល និង ប្រាក់ ដុល្លារ ជាង ៩.០០០ ដុល្លារ ទៀត បញ្ជាក់ ឱ្យ ពុទ្ធ បរិស័ទ បាន ឃើញ ជាក់ ភ្នែក ព្រោះតែ សង្ស័យ ថា បាត់ មិន ដឹង ប្រើប្រាស់ លើ ប្រការ ណា ខ្លះ ។
ប្រជាពលរដ្ឋ និង គណៈកម្មការ វត្ត កោះ ថ្មី បាន លើកឡើង ថា មូលហេតុ ដែល ពួកគាត់ លើក គ្នា តវ៉ា នេះ ដោយសារ ពួកគាត់ មើលឃើញ ថា ព្រះសង្ឃ អង្គ នេះ មាន ព្រះទ័យ មិន ស្មោះត្រង់ មាន កំហុស ខុសឆ្គង ពី ធម្មវិន័យ ជាច្រើន មិន សម ជា ព្រះសង្ឃ ជាពិសេស ធ្វើឲ្យ ប្រជាពុទ្ធ ស័ទ ចំណុះ ជើង វត្ត អស់ ជំនឿ លែង ទុកចិត្ត រហូត ចង់ កសាង សមិទ្ធផល អ្វី មួយ ក្នុង វត្ត សុខចិត្ត ធ្វើ ដោយ ខ្លួន ឯង ដូចជា ករណី កំពុង កសាង របង វត្ត និង កុដិ ជាដើម ។
ជាង នេះ ទៅ ទៀត រឿង ដែល ពួកគាត់ កាន់តែ អស់ ជំនឿ នោះ ខណៈ ដែល ពួកគាត់ បាន នាំគ្នា ទៅ ថ្វាយបង្គំ ទូល សួរនាំ រឿង កសាង ផ្លូវ បេតុង ចូល វត្ត និង ផ្លូវ បេតុង តាម របង មុខ វត្ត ស្រាប់តែ ព្រះសង្ឃ អង្គ នេះ មាន ថេរ ដីកា ថា អត់ មាន បច្ច័យ កសាង មាន តែ កាត់ ដី វត្ត លក់ ។
មិន តែ ប៉ុណ្ណោះ ព្រះសង្ឃ អង្គ នេះ ក៏ ថែម ចង់ រំសាយ គណៈកម្មការ វត្ត ចោល ថែម ទៀត ។ ករណី ដែល រំសាយ គណៈកម្មការ វត្ត នេះ ត្រូវបាន ប្រជាពលរដ្ឋ និង គណៈកម្មការ វត្ត ដាក់ ការសង្ស័យ ថា ការរំសាយ គណៈកម្មការ វត្ត នេះ គឺ ព្រះសង្ឃ អង្គ នេះ មាន ព្រះទ័យ ចេតនា ចង់ លាក់បាំង ពី រឿង បច្ច័យ ១២០ លាន រៀល និង ជាង ៩.០០០ ដុល្លារ នោះ ហើយ មើល ទៅ ។
រឿង ហេតុ ក៏ បាន អូសបន្លាយ មកដល់ ល្ងាច ថ្ងៃទី ១៧ ខែ ឆ្នាំ ដដែល ក្នុង ពេល នោះ ប្រជាពលរដ្ឋ និង គណៈកម្មការ វត្ត នាំគ្នា ទៅដល់ វត្ត ដើម្បី ដោះស្រាយ នោះ ប៉ុន្តែ ព្រះតេជគុណ អ៉ី ពិសិត មិន ព្រម មាន ថេរ ដីកា បំភ្លឺ ជាមួយ អ្នកសារព័ត៌មាន ពាក់ព័ន្ធ នឹង ករណី នេះ ទេ ។ ចំណែក មេភូមិ កោះ ថ្មី លោក កោ វ៉ារី បាន និយាយ ថា លោក មិន ដឹង រឿង នេះ ទេ លោក មកដល់ វត្ត នេះ ដោយសារ ព្រះសង្ឃ អ៉ី ពិសិត ហៅ មក ដោះស្រាយ តែ មិន ដឹង ថា ដោះស្រាយ រឿង អ្វី នោះ ទេ ៕
បច្ចុប្បន្ន ចិន គឺជា ប្រទេស មួយ ដែល ពឹងផ្អែក យ៉ាង ខ្លាំង លើ ការនាំចូល ថាមពល ដើម្បី ទ្រទ្រង់ ដំណើរការ សេដ្ឋកិច្ច របស់ ខ្លួន ជាពិសេស គឺ ការនាំចូល ប្រេង ពី បណ្ដា ប្រទេស ក្នុង តំបន់ មជ្ឈិមបូព៌ា ។ ដូច្នេះ ការរកឃើញ កំណប់ ប្រេង និង ឧស្ម័ន ខាងលើ អាចនឹង កាន់តែ ធ្វើឱ្យ ចិន មាន ឯករាជ្យភាព ខាង វិស័យ ថាមពល ហើយ អាចនឹង ប្រែ ខ្លួន ពី ប្រទេស អ្នកនាំចូល ទៅជា ប្រទេស នាំចេញ ប្រេង ដ៏ ធំ ដូច ដែល សហរដ្ឋ អាមេរិក ធ្លាប់ បាន ធ្វើ ក៏ ថា បាន ព្រមទាំង អាច ប្រើប្រាស់ ធនធាន ទាំង នេះ ជា អាវុធ ភូមិសាស្ត្រ នយោបាយ ទៀតផង ។
តែ អ្វី ដែល សំខាន់ នោះ គឺ ក្នុង រយៈពេល ខ្លី ឬ មធ្យម ចិន ប្រហែលជា ត្រូវ បំពេញ តម្រូវការ ទីផ្សារ នៅក្នុង ស្រុក ដ៏ ធំ និង សេដ្ឋកិច្ច ជាតិ ជាមុន សិន ហើយ មុននឹង ចាប់ផ្ដើម គិត ពី ផ្សារ នៅ ក្រៅ ស្រុក ។
ប្រទេស អ៉ី រ៉ង់ និង មហា អំណាច ចំនួន ៦ផ្សេង ទៀត បាន ជួប ចរចា គ្នា ចាប់តាំងពី ខែមេសា មក ម្លេះ ក្នុង គោលបំណង រៀបចំ កិច្ចចរចា ណាមួយ រវាង សហរដ្ឋ អាមេរិក និង អ៉ីរ៉ង់ ។ សហរដ្ឋ អាមេរិក នៅក្រោម ការដឹកនាំ របស់ អតីត ប្រធានាធិបតី លោក ដូណាល់ ត្រាំ បាន ដក ខ្លួន ចេញ ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ អ៉ី រ៉ង់ ឆ្នាំ ២០១៥ កាលពី ឆ្នាំ ២០១៨ ដោយ ចោទ ថា អ៉ី រ៉ង់ មិន បាន គោរព តាម កិច្ចព្រមព្រៀង នេះ ។
កិច្ចប្រជុំ ផ្លូវការ នៅ ថ្ងៃអាទិត្យ នេះ កើត មាន ឡើង តែ មួយ ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី លោក អ៉ីប្រាហ៊ីម រ៉ៃស៊ី ជាប់ ឆ្នោត ជា ប្រធានាធិបតី អ៉ីរ៉ង់ ថ្មី នៅក្នុង ការបោះឆ្នោត សកល កាលពី ថ្ងៃសុក្រ កន្លងទៅ នេះ ។
គួរ បញ្ជាក់ ថា ប្រទេសជា ភាគី ដែល នៅក្នុង កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ អ៉ីរ៉ង់ បច្ចុប្បន្ន មាន អ៉ីរ៉ង់ . រុស្ស៊ី . ចិន . បារាំង . ចក្រភព អង់គ្លេស . អាល្លឺម៉ង់ និង សហភាព អឺរ៉ុប ។ ចាប់តាំងពី អាមេរិក ដក ខ្លួន អ៉ីរ៉ង់ បាន បង្កើន ការចម្រាញ់ សារធាតុ អ៊ុយរ៉ាញ៉ូម ជា បន្តបន្ទាប់ ដែល នេះ កំពុង បង្កឱ្យ មាន ការព្រួយបារម្ភ ថា សកម្មភាព បែប នេះ នឹង បើក ផ្លូវ ឱ្យ អ៉ីរ៉ង់ ផលិត គ្រាប់បែក នុយក្លេអ៊ែរ ៕
អណ្តូង ទឹក ១០កន្លែង ត្រូវបាន ប្រគល់ ជូន ពលរដ្ឋ នៅ ស្រុក ថា ឡាបរិវ៉ាត់ ខេត្ត ស្ទឹងត្រែង សម្រាប់ ប្រើប្រាស់ ជា ប្រយោជន៍ រួម
( ស្ទឹងត្រែង ) ៖ លោក ខាន់ ខុន ទីប្រឹក្សា ក្រសួង ធម្មការ និង សាសនា និង ជា នាយក សមាគម បេសកកម្ម ដំណឹង ល្អ នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ប្រគល់ អណ្តូង ទឹក ១០កន្លែង ដល់ ពលរដ្ឋ នៅ ស្រុក ថា ឡាបរិវ៉ាត់ ខេត្ត ស្ទឹងត្រែង ដើម្បី សម្រួល ដល់ សេចក្ដីត្រូវការ របស់ ប្រជាពលរដ្ឋ ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ។ ឃុំ ទទួលបាន អណ្តូង មាន ឃុំ អន្លង់ ជ្រៃ ចំនួន ៥អណ្តូង ឃុំ ស្រែ ឫស្សី ចំនួន ៣អណ្តូង និង ឃុំ ថា ឡាបរិវ៉ាត់ ចំនួន ២អណ្តូង ។
លោក បាន បន្ត អំពានាវ ដល់ ពលរដ្ឋ ទាំងអស់ ត្រូវ ថែរក្សា សុខភាព ឱ្យ បាន ល្អ ដោយ អនុវត្ត ការរស់នៅ ស្អាត ហូប ស្អាត កុំ បន្ទោរបង់ ពាសវាលពាសកាល ត្រូវ សម្រាន្ត ក្នុង មុង ដើម្បី ការពារ ពី ជំងឺ គ្រុនចាញ់ ឬ គ្រុន ឈាម និង ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ដើម្បី ការពារ សុវត្ថិភាព ផ្ទាល់ខ្លួន និង អ្នកដទៃ កាត់បន្ថយ ការស្លាប់ ពិការភាព និង ជួយ អប់រំ ណែនាំ ដល់ កូន ចៅ ឱ្យ រស់ ឆ្ងាយ ពី គ្រឿងញៀន ព្រោះ គ្រឿងញៀន វា បំផ្លាញ អនាគត របស់ ក្រុមគ្រួសារ និង សង្គមជាតិ ។
ជាមួយគ្នា នេះ ដែរ អាជ្ញាធរដែនដី រួម ជាមួយ ប្រជាពលរដ្ឋ បាន ថ្លែងអំណរគុណ ដល់ លោក ខាន់ ខុន ក្រុមហ៊ុន ប៊ីម៉ារៀល អ៊ីស្ទេត និង គ្រិស្ត បរិស័ទ ក្នុង ប្រទេស និង ក្រៅ ប្រទេស ដែល ជួយ បំពេញ សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ៕
សម្តេច តេជោ ហ៊ុន សែន បាន រៀបរាប់ ខ្លឹមសារ តាមរយៈ បណ្តាញ សង្គម យ៉ាង ដូច្នេះ ថា៖
សំនួរ សង្ខេប ទាំងនេះ តែង បង្កប់ ក្នុង ខួរក្បាល ខ្ញុំ ជានិច្ច ហើយ ខ្ញុំ ក៏ មិន អាច ឆ្លើយ ជាមួយ សំនួរ នេះ ដោយ ខ្លួន ឯង បាន ដែរ ខ្ញុំ ទុក ជូន បងប្អូន ជន រួម ជាតិ មេត្តា ជួយ រក ចម្លើយ ៕
នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន អ្នកនាំពាក្យ ម្នាក់ នៃ ក្រសួង បរទេស អ៉ី ស្រាអែល បាន ចាត់ទុក លោក អ៉ីប្រាហ៊ីម រ៉ៃស៊ី គឺជា ប្រធានាធិបតី ដ៏ គ្រោះថ្នាក់ និង ជ្រុលនិយម បំផុត ម្នាក់ មិន ធ្លាប់ មាន ពីមុន មក នៅក្នុង ប្រទេស អ៉ីរ៉ង់ ។ អ្នកនាំពាក្យ រូប នេះ ក៏ បាន ព្រមាន ដែរ ថា លោក រ៉ៃស៊ី អាចនឹង បង្កើន សកម្មភាព នុយក្លេអ៊ែរ របស់ អ៉ីរ៉ង់ ។
គួរ បញ្ជាក់ ថា ក្រសួង មហាផ្ទៃ អ៉ី រ៉ង់ កាលពី ថ្ងៃសៅរ៍ ម្សិលមិញ នៅ ទីបំផុត ទៅ បាន ចេញ សេចក្តីប្រកាស ថា លោក អ៉ីប្រាហ៉ីម រ៉ៃស៉ី គឺជា បេក្ខជន ដែល ជាប់ ឆ្នោត ក្លាយជា ប្រធានាធិបតី ទី៨ នៃ ប្រទេស អ៉ីរ៉ង់ ដោយ ទទួលបាន ការគំា ទ្រ ៦២ ភាគរយ នៃ សន្លឹក ឆ្នោត សរុប ។ ក្រោយ ជាប់ ឆ្នោត លោក រ៉ៃស៊ី នឹង ចូល ស្បថ កាន់ តំណែង ជា ផ្លូវការ នៅ កំលុង ដើម ខែសីហា ខាងមុខ នេះ ៕
ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កម្ពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ២០ ខែមិថុនា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
សូម អាន ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក ជំនន់ របស់ ក្រសួង ធនធាន ទឹក ពី ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ដូច ខាងក្រោម៖ BREAKING: ក្រសួង សុខាភិបាល វៀតណាម រកឃើញ ករណី ឆ្លង កូវីដ១៩ ថ្ងៃសៅរ៍ ម្សិលមិញ កើនឡើង រហូតដល់ ចំនួន ៤៨៦ នាក់ ភាគ ច្រើន ឆ្លង នៅ ទីក្រុង ហូជីមិញ
( ហាណូយ ) ៖ ក្រសួង សុខាភិបាល ប្រទេស វៀតណាម នៅ ថ្ងៃសៅរ៍ ម្សិលមិញ នេះ បាន ប្រកាស រកឃើញ ករណី ឆ្លង ថ្មី នៃ ជំងឺ កូវីដ១៩ ចំនួន ៤៨៦ ករណី បន្ថែម ទៀត ដែល សុទ្ធតែ ជា ករណី ឆ្លង ក្នុង សហគមន៍ ។ នេះ បើ តាម តាម ការចេញផ្សាយ ដោយ គេហទំព័រ ក្រសួង សុខាភិបាល វៀតណាម បង្ហាញ តួលេខ នៅ យប់ ថ្ងៃសៅរ៍ ទី១៩ ខែមិថុនា ឆ្នាំ ២០២១ ។
( បន្ទាយមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ កាលពី ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២១ បាន ចេញ សេចក្តីសម្រេច ស្តីពី ការ បិទ ខ្ទប់ ការធ្វើដំណើរ ចេញ - ចូល ជា បណ្តោះអាសន្ន លើ ទីតាំង ចំណុច សំណង់ ផ្ទះល្វែង សម វិជ័យ ស្ថិត ក្នុង ភូមិ ក្បាល កោះ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ។
រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ បាន សម្រេច បិទ ការចេញ ចូល ទីតាំង មួយ នេះ មាន រយៈពេល ២សប្តាហ៍ ដោយ ចាប់ពី ថ្ងៃទី ១៩ ខែមិថុនា រហូតដល់ ថ្ងៃទី២ ខែកក្កដា ឆ្នាំ ២០២១ ដើម្បី ធានា ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង កុំ ឲ្យ មាន ការរីករាលដាល ជំងឺ កូវីដ១៩ កាន់តែ ខ្លាំង ឡើង ៕
