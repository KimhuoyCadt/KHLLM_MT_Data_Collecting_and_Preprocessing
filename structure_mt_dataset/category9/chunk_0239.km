( កំពង់ឆ្នាំង ) ៖ មហា ឧបាសក លឹម ឈុន មហា ឧបាសិកា ចាយ គង់ លោក ឧកញ៉ា អ៊ឹង ប៊ុន ហ៊ូវ និង លោកស្រី ហេង សុខា ដែល ម្ចាស់ អំណោយ ដែល បាន កសាង អគារ សម្ភព និង រោគ ស្ត្រី នៃ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង នា ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ ម្សិលមិញ បាន ឧបត្ថម ម៉ាស ១០០០ ប្រអប់ អាល់កុល ២០កាន និង ទឹក សុទ្ធ ម៉ាក ភ្នំ ជប់៣០០ យួរ ដល់ មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ដើម្បី ប្រើប្រាស់ បង្ការ និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ។
សម្ភារ ទាំងអស់ ខាងលើ នេះ មន្ទីរពេទ្យ បាន ចាត់ចែង ចែកជូន បុគ្គលិក ទាំងអស់ នៃ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ដើម្បី បង្ការ ការពារ និង ទប់ស្កាត់ ការរីករាយ ដាល ជំងឺ កូវីដ១៩ ក្នុង មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ។
ក្នុង នាម ថ្នាក់ដឹកនាំ និង បុគ្គលិក នៃ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ទាំងអស់ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ មហា ឧបាសក មហា ឧបាសិកា លោក ឧកញ៉ា និង លោកស្រី ដែល ជានិច្ចកាល លោក តែងតែ ខ្វល់ខ្វាយ អំពី សុខភាព របស់ បុគ្គលិក មន្ទីរពេទ្យ ខេត្ត ដែល កំពុងតែ មមា ញឹក ក្នុង ការជួយសង្គ្រោះ និង ព្យាបាល ដល់ អ្នកជំងឺ ក្នុង កាលៈទេសៈ ជំងឺ កូវីដ១៩ បច្ចុប្បន្ន នេះ កន្លងមក លោក តែង តែ បាន ជួយ ឧបត្ថម នូវ សម្ភារ ប្រើប្រាស់ ផ្សេង ៗ ដល់ បុគ្គ លិក មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ផងដែរ ។
បុគ្គលិក នៃ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ទាំងអស់ សូម គោរព ជូនពរ ដល់ មហា ឧបាសក មហា ឧបាសិកា លោក ឧកញ៉ា និង លោកស្រី ជួប តែ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
សមត្ថកិច្ច បញ្ជូន ជន ដៃ ដល់ ៣នាក់ ដែល កាប់ សម្លាប់ បុរស ម្នាក់ នៅ ស្រុក បាទី ខេត្ត តាកែវ ទៅ តុលាការ
( តាកែវ ) ៖ អធិការដ្ឋាន នគរបាល ស្រុក បាទី ខេត្ត តាកែវ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន បញ្ជូន ជន ដៃ ដល់ ៣នាក់ ទៅ សាលាដំបូង ខេត្ដ តាកែវ ក្រោយ ចាប់ខ្លួន ពាក់ព័ន្ធ អំពើ ឃាតកម្ម គិត ទុក ជាមុន ដែល បាន ប្រព្រឹត្ដទៅ នៅ ចំណុច ភូមិ ខ្នា ទង់ ឃុំ កុមារា ជា ស្រុក បាទី ខេត្ត តាកែវ បណ្ដាលឲ្យ ជនរងគ្រោះ ម្នាក់ ស្លាប់ ក្នុង ថ្លុក ឈាម កាលពី ថ្ងៃទី ១៩ ខែមិថុនា ឆ្នាំ ២០២១ ។
លោក វរសេនីយ៍ ឯក ឆាយ កែវ មុនី អធិការ នគរបាល ស្រុក បាទី បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា ក្រោយ ចាប់ខ្លួន កាលពី ថ្ងៃទី ២២ ខែមិថុនា ម្សិលមិញ ជន ដៃ ដល់ ទាំង ៣នាក់ នេះ ក្រោយ នគរបាល យុត្តិម ធ៌បញ្ចប់ ការសួរនាំ ត្រូវបាន ជំនាញ បញ្ជូន ទៅ តុលាការ នៅ ព្រឹក នេះ ដើម្បី ធ្វើ ការផ្ដន្ទាទោស តាម ផ្លូវ ច្បាប់ ។
កម្លាំង ជំនាញ អធិការដ្ឋាន នគរបាល ស្រុក បាទី សហការ ជាមួយ កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក រុក្ខគិរី ដោយ មាន ការចង្អុលបង្ហាញ ពី លោក ឧត្តមសេនីយ៍ ទោ សុខ សំណាង ស្នងការ នគរបាល ខេត្ត តាកែវ និង មាន ការសម្របសម្រួល នីតិវិធី ពី ព្រះរាជា អាជ្ញា ខេត្ត តាកែវ ចុះ ស្រាវជ្រាវ ជនសង្ស័យ ទាំង៣ បាន គេចខ្លួន មក ភ្នំពេញ វិញ ។
រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ អញ្ជើញ គោរព វិញ្ញាណក្ខន្ធ សព លោក អៀង ជេដ្ឋ ទីប្រឹក្សា ក្រសួង ព័ត៌មាន និង ជា អតីត ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន រួម ដំណើរ ដោយ លោក ទន់ សារ៉ាត រដ្ឋលេខាធិការ . លោក លី វ៉ាន់ ហុង ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក អគ្គ នាយក រដ្ឋបាល និង ហិរញ្ញវត្ថុ នៃ ក្រសួង ព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ គោរព វិញ្ញាណក្ខន្ធ សព លោក អៀង ជេដ្ឋ ទីប្រឹក្សា ក្រសួង ព័ត៌មាន និង ជា អតីត ប្រធាន មន្ទីរព័ត៌មាន ខេត្ត ព្រៃវែង និង ជា សមាជិក ក្រុមប្រឹក្សា ខេត្ត ព្រៃវែង ។
លោក អៀង ជេដ្ឋ បាន ទទួលមរណភាព កាលពី យប់ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ វេលា ម៉ោង ២៖ ៥៤ នាទី យប់ ក្នុង ជន្មាយុ ៦៥ ឆ្នាំ ដោយ រោគា ពាធ ហើយ សព ត្រូវបាន ក្រុមគ្រួសារ តម្កល់ ធ្វើ បុណ្យ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា នៅ គេហដ្ឋាន ស្ថិត ភូមិ លេខ ២ សង្កាត់ កំពង់លាវ ក្រុង ព្រៃវែង ខេត្ត ព្រៃវែង ។ នៅក្នុង ឱកាស ដ៏ ក្រៀមក្រំ នោះ លោក រដ្ឋមន្រ្តី ខៀវ កាញារីទ្ធ បាន សម្តែង ការចូលរួម រំលែក ទុក្ខ ជាមួយ លោកស្រី នួន ណាវី និង ក្រុមគ្រួសារ ដែល បាន បាត់បង់ រូប លោក អៀង ជេដ្ឋ ។
រដ្ឋមន្រ្តី ខៀវ កាញារីទ្ធ ចាត់ទុក មរណភាព នេះ គឺជា ការបាត់បង់ នូវ មន្ត្រី ដែល មាន ស្នាដៃ មួយ រូប ដែល ត្រូវ ជា ស្វាមី ជា បិតា បិតា ក្មេក និង ជា ជីតា ជាទីគោរព ស្រឡាញ់ បំផុត របស់ ក្រុមគ្រួសារ ទាំងអស់ នៃ សព ដែល ជានិច្ចកាល តែង បាន លះបង់ ខ្ពស់ ទាំង កម្លាំង កាយ ចិត្ត និង បញ្ញា ស្មារតី ក្នុង ការបី បាច់ ថែរក្សា កូន ៗ ជាទី ស្រឡាញ់ និង បាន ចូលរួមចំណែក យ៉ាង ធំធេង នៅក្នុង វិស័យ ព័ត៌មាន និង សោត ទស្សន៍ ក្នុង ការបម្រើ ជាតិ និង ប្រជាពលរដ្ឋ ។
មជ្ឈមណ្ឌល CCSA បាន គូសបញ្ជាក់ ប្រាប់ ថា ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ៣. ១៣៨ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ទូទៅ ខណៈ ៣៦ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ដោយឡែក អ្នកជំងឺ ចំនួន ១.៩៤១ នាក់ ផ្សេង ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
អាជ្ញាធរ ខេត្ត ឧត្តរមានជ័យ អនុញ្ញាតឱ្យ បើក ដំណើរការ នូវ អាជីវកម្ម ចំនួន ២ទីតាំង និង បញ្ចប់ ការបិទ ខ្ទប់ ទីតាំង ផ្ទះ ចំនួន ៣ខ្នង នៅ ក្រុង សំរោង ឡើងវិញ
( ឧត្តរមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ បាន ចេញ សេចក្តីសម្រេច ឱ្យ បើក ដំណើរការ នូវ អាជីវកម្ម ចំនួន ២ទីតាំង និង បញ្ចប់ ការបិទ ខ្ទប់ ទីតាំង ផ្ទះ ចំនួន ៣ខ្នង ស្ថិត នៅ ក្រុង សំរោង ឡើងវិញ បន្ទាប់ពី ផ្អាក មួយ រយៈ ដោយ ជាប់ ព័ន្ធ នឹង អ្នកជំងឺ កូវីដ១៩ គិត ចាប់ពី ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ ត ទៅ ។ នេះ បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ។
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ថា ទីតាំង អាជីវកម្ម ទាំង៣ នេះ រួម មាន៖
* ទី១៖ មន្ទីរ ពហុ សម្រាក ព្យាបាល និង សម្ភព សំរោង ស្ថិត នៅ ភូមិ សំរោង សង្កាត់ សំរោង ក្រុង សំរោង *ទី ២៖ អាជីវកម្ម ចំណត រថយន្ត អូរ ស្មាច់ ស្ថិត នៅ ភូមិ អូរ ស្មាច់ សង្កាត់ អូរ ស្មាច់ ក្រុង សំរោង និង ទី៣៖ និង បញ្ចប់ ការបិទ ខ្ទប់ ទីតាំង ផ្ទះ ចំនួន ៣ខ្នង ៕
អាជ្ញាធរ ខេត្ត ព្រះសីហនុ ផ្អាក ជា បណ្តោះអាសន្ន នូវ អាជីវកម្ម លក់ដូរ នៅ ផ្សារ វាល រេញ ក្នុង ស្រុក ព្រៃនប់ រយៈពេល ១៤ ថ្ងៃ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩
លោក គួច ចំរើន បាន ឱ្យដឹង ថា ការសម្រេច ផ្អាក ជា បណ្តោះអាសន្ន នូវ អាជីវកម្ម លក់ដូរ នៅ ផ្សារ វាល រេញ នេះ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ៕
មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ នាំ អំណោយ របស់ លោក ហ៊ុន ម៉ាណែត ចែកជូន ពលរដ្ឋ ៣០០ គ្រួសារ នៅ ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង លោក ហោ សេរី វឌ្ឍន៍ ប្រធាន មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ ព្រមទាំង ក្រុមការងារ នៅ ចុង សប្តាហ៍ កន្លងទៅ នេះ បាន នាំយក អំណោយ របស់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ព្រមទាំង សប្បុរសជន ដែល បាន បរិច្ចាគ តាមរយៈ មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ ប្រគល់ ជូន ដល់ ប្រជាពលរដ្ឋ ៣០០ គ្រួសារ ស្ថិត ក្នុង ភូមិ គីឡូ១០ ឃុំ អារក្ស ត្នោត ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម ។
លោក ទុន ណេត អភិបាល ស្រុក ស្ទឹងត្រង់ បាន ធ្វើ របាយការណ៍ ពី ស្ថានភាព ទូទៅ នៃ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ជាពិសេស នៃ ការវិវត្តន៍ ថ្មី ៗ នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ស្ថិត ក្នុង ស្រុក ស្ទឹងត្រង់ ទាំងមូល ។
ក្នុង កិច្ច សំណេះសំណាល របស់ លោក ហោ សេរី វឌ្ឍន៍ ប្រធាន មូលនិធិ . លោក បាន ពាំនាំ ការសួរសុខទុក្ខ ពីសំណាក់ លោក ហ៊ុន ម៉ាណែត និង ភរិយា ដល់ ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ១៩ និង បាន ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ បង្កើន ការប្រុងប្រយ័ត្ន ឱ្យ បាន ខ្ពស់ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោក ហោ សេរី វឌ្ឍន៍ ក៏ បាន ថ្លែងអំណរគុណ ដល់ សប្បុរសជន ទាំង ក្នុង និង ក្រៅ ប្រទេស ទាំងអស់ ដែល បាន បរិច្ចាគ តាមរយៈ មូលនិធិ កម្ពុជា ប្រឆាំង ជំងឺ កូវីដ១៩ នេះ ដើម្បី ជា ការរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការជួយសង្គ្រោះ ដល់ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ដោយសារ ជំងឺ កូវីដ១៩ ។
លោក ហោ សេរី វឌ្ឍន៍ ក៏ បាន ជម្រាប ទៅដល់ ប្រជាពលរដ្ឋ ពី យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ដែល មកដល់ ពេលនេះ សម្រេចបាន ជាង ៣ លាន នាក់ ហើយ ខេត្ត កំពង់ចាម នឹង ទទួលបាន នូវ ការចាក់ វ៉ាក់សាំង កូវីដ១៩ បន្ថែម ទៀត ក្នុង ពេល ឆាប់ ៗ នេះ ផងដែរ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន ចែករំលែក បទពិសោធន៍ នៃ ការប្រើប្រាស់ ម៉ាស ឱ្យ បាន ត្រឹមត្រូវ ជូន ដល់ ប្រជាពលរដ្ឋ ហើយក៏ បាន លើកទឹកចិត្ត ឱ្យ ប្រជាពលរដ្ឋ មាន ជំនឿចិត្ត លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន និង ថ្នាក់ដឹកនាំ ខេត្ត ដែល តែងតែ យកចិត្តទុកដាក់ ចំពោះ សុខ មាលភាព និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ទាំងអស់ ។
បើ តាម លោក អ៊ុន ចាន់ ដា តំណាង អាជ្ញាធរ ខេត្ត និង ប្រជាពលរដ្ឋ បាន ថ្លែងអំណរគុណ ដល់ លោក ហ៊ុន ម៉ាណែត និង សប្បុរសជន ទាំងអស់ ដែល បាន បរិច្ចាគ តាមរយៈ មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ ជូន មកដល់ ប្រជាពលរដ្ឋ ទាំង ៣០០ គ្រួសារ នា ពេលនេះ ។
ក្នុង ឱកាស នោះ ផងដែរ លោក អភិបាល ក៏ បាន ណែនាំ ដល់ អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវតែ យកចិត្តទុកដាក់ ខ្ពស់ នៅពេល ដឹង ថា មាន ការឆ្លង ជំងឺ កូវីដ១៩ ដល់ ប្រជាពលរដ្ឋ ណា ម្នាក់ ដើម្បី បញ្ជូន ពួកគាត់ ទៅ ធ្វើ ការព្យាបាល ហើយ សម្រាប់ អ្នក ពាក់ព័ន្ធ ត្រូវ បញ្ជូន ទៅ ធ្វើចត្តាឡី ស័ក ក្នុង មណ្ឌល តែម្តង គឺ មិន ត្រូវ ទុក ពួកគាត់ ធ្វើ ចាត្តាឡី ស័ក នៅ ផ្ទះ ទេ ព្រោះ វា អាច ជា ប្រភព នៃ ការចម្លង ប្រសិនបើ ពួកគាត់ មិន បាន គោរព តាម វិធាន របស់ គ្រូពេទ្យ ឬ អាជ្ញាធរ ។
គួរ បញ្ជាក់ ថា បើ តាម ទិន្នន័យ របស់ អាជ្ញាធរ សហព័ន្ធ ដែល បាន ធ្វើ បច្ចុប្បន្នភាព ចុងក្រោយ កាលពី ថ្ងៃចន្ទ សប្ដាហ៍ នេះ ប្រជាជន ជាង ១៥០ លាន នាក់ នៅ សហរដ្ឋ អាមេរិក ឬ ច្រើន ជាង ៤៥ ភាគរយ នៃ ប្រជាជន សរុប បាន ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ COVID-19 ពេញលេញ រួចហើយ ៕
គួរ បញ្ជាក់ ថា បើ តាម លោក ប្រធានាធិបតី អាហ្វ្រិក ខាងត្បូង គិត មក ទល់នឹង ពេលនេះ ទ្វីប អាហ្វ្រិក ទើបតែ សម្រេចបាន ការចាក់ វ៉ាក់សាំង ត្រឹមតែ ៤០ លាន ដូស ប៉ុណ្ណោះ ពោលគឺ តិច ជាង ២ភាគរយ នៃ ប្រជាជន អាហ្វ្រិក សរុប ៕
ខេត្ត សៀមរាប រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ៣៩ នាក់ និង ស្លាប់ ចំនួន ១នាក់ នៅ ថ្ងៃទី ២២ ខែមិថុនា
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប បាន ប្រកាស រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៣៩ នាក់ និង ស្លាប់ ចំនួន ១នាក់ នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ ខេត្ត បាន បញ្ជាក់ ថា អ្នក កេីត ជំងឺ កូវីដ១៩ នេះ ករណី ទី១ ដល់ ទី៣ ជា ករណី ពាក់ព័ន្ធ នឹង ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ដែល មាន ប្រភព ដើម មកពី ស្រុក ជីក្រែង ។
ករណី ទី៤ ដល់ ទី១៨ ជា ករណី មាន ប្រភព ចម្លង ចេញ ពី ភោជនីយដ្ឋាន ហេង ហេង ២។ ករណី ទី១៩ ដល់ ទី៣២ គឺជា ករណី ពុំ ទាន់ អាច សន្និដ្ឋាន ពី ប្រភព ចម្លង ច្បាស់លាស់ នៅឡើយ ។
ចំពោះ ករណី ទី៣៣ ដល់ ទី៣៥ ជា អ្នកធ្វើដំណើរ មក ពី ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ មក រក សេវា ព្យាបាល នៅ មន្ទីរពេទ្យ ជ័យ វរ្ម័ន ទី៧ ដោយ មាន អាការៈ សង្ស័យ ក្រុម គ្រូពេទ្យ បាន យក សំណាក ស្រាវជ្រាវ រក មេរោគ កូវីដ - ១៩ ទទួលបាន លទ្ធផល វិជ្ជមាន ។
ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២៩ ខែមិថុនា . កម្ពុជា នឹង មាន ភ្លៀង ធ្លាក់ ពី ខ្សោយ ទៅ ច្រើន សូម ប្រុងប្រយ័ត្ន ចំពោះ ខ្យល់ កន្ត្រាក់
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាព អាកាសធាតុ នៅ កម្ពុជា ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០២១ ។
ក្រសួង បញ្ជាក់ ថា ក្នុង រយៈពេល នេះ កម្ពុជា អាចនឹង មាន ភ្លៀង ធ្លាក់ ពី កម្រិត ខ្សោយ ទៅ ច្រើន ទៅ តាម តំបន់ ។ ជាមួយគ្នា នេះ ក្រសួង ក៏ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ សូម ប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ បាតុភូ ធម្មជាតិ ដូចជា ភ្លៀង ផ្គរ រន្ទះ និង ខ្យល់ កន្តាក់ ដែល អាច កើតមាន ជាពិសេស នៅ តំបន់ វាល ទំនាប ៕ ស្រវឹង សូម កុំ បើកបរ ! ស្លាប់ ៣នាក់ និង របួស ៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២២ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ៦នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន ប្រកាន់ ស្ដាំ . មិន គោរព សិទ្ធិ និង កត្តា យាន ៕
ខេត្ត ស្វាយរៀង រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ៦២ នាក់ ខណៈ ជាសះស្បើយ ៣៧នាក់ និង ស្លាប់ ម្នាក់
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នា ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន សេចក្ដីជូនដំណឹង ស្ដីពី ការរកឃើញ ករណី អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ៦២ នាក់ បន្ថែម ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ និង មាន អ្នក ជាសះស្បើយ ថ្មី ៣៧ នាក់ ទៀត ផងដែរ ខណៈ អ្នកស្លាប់ មាន ម្នាក់ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង៖ ថ្ងៃ ដំបូង នៃ ប្រតិបត្តិការ តាម ខេត្ត កងទ័ព ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ បាន ជិត ៦ម៉ឺន នាក់
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បាន បិទ បញ្ចប់ ទាំងស្រុង នូវ ការចាក់ដូស ទី១ នៅក្នុង រាជធានី ភ្នំពេញ នោះ នៅ ថ្ងៃអង្គារ ទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ក្រុមការងារ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ របស់ ក្រសួង ការពារ ជាតិ បាន ចាប់ផ្តើម ប្រតិបត្តិការ ចាក់ វ៉ាក់សាំង ជូន ដល់ ប្រជាពលរដ្ឋ នៅ តាម បណ្តា ខេត្ត ។
យោង តាម របាយការណ៍ បាន បង្ហាញ ថា ប្រតិបត្តិការ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ នៅ តាម បណ្តា ខេត្ត នេះ បាន ធ្វើឡើង នៅក្នុង ខេត្ត ព្រះសីហនុ ព្រះកោះ កុង កំពង់ស្ពឺ និង តាកែវ ។ របាយការណ៍ បាន បង្ហាញ ទៀត ថា ប្រតិបត្តិការ នៅ ថ្ងៃ ដំបូង នេះ ក្រុមការងារ របស់ ក្រសួង ការពារ ជាតិ ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ បាន ចំនួន ៥៨. ៣០៩ នាក់ ស្រី ៣៤. ៥៧២ នាក់ ។
ជាមួយ ការបើកប្រតិបត្តិការ នៅ តាម ខេត្ត នេះ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា ប្រធាន ប្រតិបត្តិការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្រសួង ការពារ ជាតិ បាន ចុះ ទៅ ពិនិត្យ ការងារ ចាក់ វ៉ាក់សាំង នៅក្នុង ខេត្ត ព្រះសីហនុ និង គ្រោង ចុះ ទៅតាម បណ្តា ខេត្ត មួយចំនួន ទៀត ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន កត់សម្គាល់ ថា ដោយសារតែ កងទ័ព មាន បទពិសោធន៍ ច្រើន ក្នុង ប្រតិបត្តិការ នៅក្នុង រាជធានី ភ្នំពេញ ដូច្នេះ ការចាប់ផ្តើម ដំណើរការចាក់ តាម បណ្តា ខេត្ត ក៏ មិន សូវ ជា មាន បញ្ហា ប្រឈម នោះ ឡើយ ខណៈ អាជ្ញាធរ មូលដ្ឋាន បាន ចូលរួម សហការ បាន ល្អ ប្រសើរ ។
លោក ឥត សារ៉ាត់ បាន កត់សម្គាល់ ឃើញ ផងដែរ ថា ប្រជាពលរដ្ឋ នៅ តាម បណ្តា ខេត្ត ក៏ បាន ជ្រូត ជ្រាប និង យល់ដឹង ច្រើន ពី គុណ តម្លៃ របស់ វ៉ាក់សាំង ហើយ បាន ចូលរួម ចាក់ យ៉ាង ផុល ផុស ។
បើ ទោះបីជា យ៉ាងណា លោក ឥត សារ៉ាត់ នៅតែ ក្រើន រំលឹក ដល់ ក្រុមការងារ ចាក់ វ៉ាក់សាំង មកពី ក្រសួង ការពារ ជាតិ ទាំងអស់ ឱ្យ បន្ត យកចិត្តទុកដាក់ លើ ការងារ ធ្វើ យ៉ាងណា ឱ្យ ការចាក់ ជូន ប្រជាពលរដ្ឋ ទទួលបាន ជោគជ័យ តាម ផែនការ របស់ រាជ រដ្ឋាភិបាល ។
លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទៅ ចាក់ វ៉ាក់សាំង ឱ្យ ស្តាប់ តាម ការណែនាំ របស់ អាជ្ញាធរ ដោយ ប្រកាន់ខ្ជាប់ នូវ វិធាន ទាំងឡាយ របស់ ក្រសួង សុខាភិបាល ក្នុង ការបង្ការ ការចម្លង ជំងឺ កូវីដ១៩ ៕ អាជ្ញាធរ ខេត្ត ឧត្ដរ មានជ័យ រកឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ១១នាក់ ជា ពលករ មកពី ប្រទេស ថៃ
សូម ជម្រាប ជូន ថា មកទល់ ពេលនេះ ខេត្ត ឧត្តរមានជ័យ មាន អ្នកជំងឺ កូវីដ១៩ ចំនួន ២០០ នាក់ ករណី ជា នាំចូល ពី បរទេស ចំនួន ១៦៥ នាក់ និង ករណី ពាក់ព័ន្ធ ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភៈ » ចំនួន ៣៥ នាក់ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ៩០ នាក់ ករណី ស្លាប់ ចំនួន ០២ នាក់ និង កំពុង សម្រាក ព្យាបាល ចំនួន ១០៨ នាក់ ( នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ចំនួន ២០ នាក់ នៅ មណ្ឌល ព្យាបាល ផ្ទះសំណាក់ ឧត្តម រដ្ឋ ចំនួន ៧០ នាក់ និង នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក អន្លង់ វែង ចំនួន ១៨នាក់ )៕
អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង សម្រេច បិទ ជា បណ្តោះអាសន្ន ផ្ទះ ចំនួន ០២ កន្លែង នៅ សង្កាត់ ផ្សារ ឆ្នាំង សង្កាត់ កំពង់ឆ្នាំង ដោយសារ ជាប់ពាក់ព័ន្ធ អ្នក កើត កូវីដ
( កំពង់ឆ្នាំង ) ៖ រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង សម្រេច បិទ ជា បណ្តោះអាសន្ន ផ្ទះ ចំនួន ០២ កន្លែង ស្ថិត នៅ ភូមិ ត្រពាំង បី សង្កាត់ ផ្សារ ឆ្នាំង និង ភូមិ ទួល ក្រឡាញ់ សង្កាត់ កំពង់ឆ្នាំង ក្នុង ភូមិសាស្រ្ត ក្រុង កំពង់ឆ្នាំង ខេត្ត កំពង់ឆ្នាំង ចាប់ពី ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ នេះ រហូត មាន ការជូនដំណឹង ជាថ្មី ។ នេះ បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ២២ ខែមិថុនា ៕
នគរបាល ខេត្ត ព្រះវិហារ ឃាត់ខ្លួន ក្មេង ទំនើង ២នាក់ ក្រោយ ថត កាន់ ដាវ បង្ហោះ តាម បណ្តាញ សង្គម ហ្វេក ប៊ុក
( ព្រះវិហារ ) ៖ ក្មេង ទំនើង ២នាក់ ដែល កាន់ ដាវ ថត បង្ហោះ តាម បណ្តាញ សង្គម ហ្វេក ប៊ុក ត្រូវបាន កម្លាំង នគរបាល ខេត្ត ព្រះវិហារ ស្រាវជ្រាវ ឃាត់ខ្លួន បាន នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ស្ថិត នៅ ភូមិ អន្ទិល ឃុំ យាង ស្រុក ជាំ ក្សាន្ត ។
មន្ត្រី នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះវិហារ បាន ថ្លែង ថា ក្រោយ មាន ការបង្ហោះ រូបភាព កាន់ ដាវ តាម បណ្តាញ ទំនាក់ទំនង សង្គម ហ្វេក ប៊ុក របស់ ក្មេងប្រុស ទាំង ២នាក់ នេះ លើ អាខោន ឈ្មោះ « ក្មេង ព្រះវិហារ ញៀន ម៉ាត » កាលពី ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០២១ និង មាន ការស៊ែ ចែករំលែក តគ្នា លោក ឧត្តមសេនីយ៍ ទោ សួស សុខ ដារ៉ា ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ បាន ណែនាំឲ្យ កម្លាំង នគរបាល ជំនាញ ស្រាវជ្រាវ ចាប់ខ្លួន ក្មេង ទាំង២ នេះ ឲ្យបាន ។
ដោយ អនុវត្តន៍ តាម បទបញ្ជា និង ការណែនាំ ពី លោក ឧត្តមសេនីយ៍ ទោស្នងការ នគរបាល ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ នេះ កម្លាំង នគរបាល ព្រហ្មទណ្ឌ នៃ ស្នងការការដ្ឋាន នគរបាល ខេត្ត បាន សហការ ជាមួយ កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក ជាំ ក្សាន្ត និង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល យាង បាន ចុះ ធ្វើ ការឃាត់ខ្លួន ក្មេង ទំនើង ទាំង ២នាក់ នេះ និង ដកហូត ដាវ ចំនួន ២ដើម និង នាំ មកកាន់ អធិការដ្ឋាន នគរបាល ស្រុក ជាំ ក្សាន្ត ។
ក្មេង ទំនើង ទាំង ២នាក់ ដែល សមត្ថកិច្ច ឃាត់ខ្លួន រួម មាន៖
សមត្ថកិច្ច បាន ហៅ អនាព្យាបាល មក ធានា ត្រឹមត្រូវ និង ធ្វើ កិច្ចសន្យា ច្បាស់លាស់ ។ សមត្ថកិច្ច ក៏ បាន អប់រំ ណែនាំ និង អនុញ្ញាតឲ្យ ក្មេង ទំនើង ទាំង ២នេះ វិលត្រឡប់ ទៅ ផ្ទះ វិញ ជាមួយ ការកោសក់ ក្បាល ជា ការព្រមាន ផងដែរ ៕ BREAKING: ថ្ងៃ នេះ វៀតណាម រកឃើញ ករណី ឆ្លង កូវីដ១៩ ចំនួន « ២៤៨ ករណី » បន្ថែម ទៀត ខណៈ ជាង ពាក់កណ្តាល នាក់ នៅ ទីក្រុង ហូជីមិញ
ក្នុង ចំណោម ករណី សហគមន៍ នៅ ថ្ងៃចន្ទ នេះ ទីក្រុង ហូជីមីញ នៅតែ អ្នក រ៉ាប់ រ៉ង ច្រើន ជាង គេ ជាមួយ ការរកឃើញ ករណី ឆ្លង ថ្មី ចំនួន ១៣៦ នាក់ ខណៈ ដែល ទីក្រុង មួយ នេះ បាន សម្រេច រឹតត្បិត វិធានការ សុខាភិបាល បន្ថែម កម្រិត ទៀត ដោយ ហាមឃាត់ ការជួបជុំគ្នា ដែល មាន គ្នា លើស ពី ០៣ នាក់ និង រក្សា គម្លាត ពី គ្នា ឲ្យ មាន ១.៥ម៉ែត នៅ តាម ទី សាធារណៈ ក៏ ដូចជា ហាម ចេញ ក្រៅ ផ្ទះ លើកលែងតែ មាន កិច្ចការ ចាំបាច់ ។
សរុប មកវិញ គិត ត្រឹម ថ្ងៃអង្គារ នេះ វៀតណាម មាន ករណី ឆ្លង កូវីដ - ១៩ សរុប នៅ ទូទាំង ប្រទេស កើន ដល់ ចំនួន ១៣. ៧៣១ នាក់ ក្នុង នោះ ស្លាប់ ៦៩ នាក់ ៕ ស្ទឹងត្រែង រកឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៤នាក់ បន្ថែម ទៀត ខណៈ ៣នាក់ ជា អ្នកធ្វើដំណើរ មកពី ខេត្ត កណ្តាល
( ស្ទឹងត្រែង ) ៖ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង នៅ ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរកឃើញ មនុស្ស ចំនួន ៤នាក់ ថ្មី បន្ថែម ទៀត ឆ្លង ជំងឺ កូវីដ១៩ ម្នាក់ ឆ្លង ក្នុង សហគមន៍ និង ៣នាក់ ទៀត ជា អ្នកធ្វើដំណើរ មកពី ខេត្ត កណ្តាល តាមរយៈ ការធ្វើតេស្ត រហ័ស ។
អ្នកជំងឺ ឈ្មោះ ខន រិទ្ធី មាន អាសយដ្ឋាន នៅ ភូមិ រាជានុកូលំ សង្កាត់ - ក្រុង - ខេត្ត ស្ទឹងត្រែង ធ្លាប់ បាន ធ្វើដំណើរ ទៅ ទីតាំង ផ្ទុះ ជំងឺ កូវីដ១៩ ក្នុង ខេត្ត រតនគិរី បាន ស្ម័គ្រចិត្ត តាម ការអំពាវនាវ របស់ រដ្ឋបាល ខេត្ត មក ជួប ក្រុម គ្រូពេទ្យ ដើម្បី យក សំណាក វិភាគរក ជំងឺ កូវីដ១៩ ។ ក្រោយ ត្រឡប់ មកដល់ ខេត្ត ស្ទឹងត្រែង វិញ គាត់ ធ្លាប់ បាន ទៅ ចម្ការ ផ្ទាល់ខ្លួន ទៅ ទំនាក់ទំនង ការងារ នៅ អធិការដ្ឋាន នគរបាល ស្រុក ថា ឡាបរិវ៉ាត់ និង ទៅ ធ្វើការ នៅ គ្រឹះស្ថាន WB Finance ។
១៖ ឈ្មោះ ស៊ឹម ម៉ាច ភេទ ស្រី អាយុ ៤៥ ឆ្នាំ ជនជាតិ ខ្មែរ មកពី ស្រុក ល្វាឯ ម ខេត្ត កណ្តាល ២៖ ឈ្មោះ សូ អាត ភេទ ប្រុស អាយុ ២១ ឆ្នាំ ជនជាតិ ខ្មែរ មកពី ស្រុក កោះ ធំ ខេត្ត កណ្តាល ៣៖ ឈ្មោះ វ៉ាន វ៉េត ភេទ ប្រុស អាយុ ១៦ ឆ្នាំ ជនជាតិ ខ្មែរ មកពី ស្រុក ស្អាង ខេត្ត កណ្តាល ។
លោក Cui ដែល មាន អាយុ ៦៨ ឆ្នាំ និង ដែល ហួស អាយុ ចូលនិវត្តន៍ ៣ ឆ្នាំ សម្រាប់ អ្នកការទូត ជាន់ ខ្ពស់ ចិន រូប នេះ ត្រូវបាន គេ ដឹង ថា បាន ចូល រូមចំណែក យ៉ាង ខ្លាំង ក្នុង ការរក្សា ភាពត្រជាក់ ក្នុង អំឡុង ពេល មាន ជម្លោះ មិន ចុះសម្រុង គ្នា រវាង រដ្ឋាភិបាល ក្រុង ប៉េកាំង និង រដ្ឋបាល អាមេរិក របស់ អតីត ប្រធានាធិបតី លោក ដូណាល់ ត្រាំ ។
ប្រធានាធិបតី រុស្ស៊ី លោក វ្លាឌីមៀ ពូទីន បាន ព្រមាន កាលពី ថ្ងៃចន្ទ ទី២១ ខែមិថុនា ថា ស្ថានភាព ជំងឺ កូវីដ១៩ នៅ តំបន់ ខ្លះ នៃ ប្រទេស រុស្ស៊ី កំពុង វិវឌ្ឍន៍ កាន់តែ អាក្រក់ ទៅ ហើយ ខណៈ អាជ្ញាធរ ចាប់ផ្តើម ជំរុញ ឲ្យ ប្រជាពលរដ្ឋ ឲ្យ មក ទទួល ការចាក់ វ៉ាក់សាំង ឡើងវិញ ដើម្បី បង្ការ ការកើនឡើង នូវ ករណី ថ្មី ។
( រ៉ង់ ហ្គូន ) ៖ សារព័ត៌មាន នៃ របប យោធា មីយ៉ាន់ម៉ា បាន ចេញផ្សាយ ថា ក្រុម ប្រដាប់អាវុធ ០៨ នាក់ ត្រូវបាន ចាប់ខ្លួន និង ០៨ នាក់ ផ្សេង ទៀត បាន ស្លាប់ នៅក្នុង ទីក្រុង ម៉ាន់ ដាឡាយ (Mandalay) ប្រទេស មីយ៉ាន់ម៉ា នៅក្នុង ថ្ងៃអង្គារ នេះ តែម្តង ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ចិន ស៉ីន ហួរ នៅ ល្ងាច ថ្ងៃអង្គារ ទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ ។
កំលុង ប្រតិបត្តិការ នោះ ការប៉ះទង្គិច គ្នា ក៏ បាន ផ្ទុះឡើង ដោយ ក្រុម ប្រដាប់អាវុធ ០៤ នាក់ បាន ស្លាប់ ខណៈ កងកម្លាំង សន្តិសុខ មួយ ចំនួន ក៏ បាន រងរបួស យ៉ាង ធ្ងន់ធ្ងរ ផងដែរ ។ ទន្ទឹមនឹង នេះ ដែរ ក្រុម ប្រដាប់អាវុធ មួយ ចំនួន ទៀត នៅក្នុង រថយន្ត មួយ គ្រឿង បាន បាញ់ប្រហារ ទៅ លើ កងកម្លាំង សន្តិសុខ និង បាន ជិះ រត់គេចខ្លួន បាត់ នៅក្នុង សង្កាត់ តែ មួយ ដដែល ។ បន្ទាប់មក ជន ប្រដាប់អាវុធ ០៤ នាក់ នោះ ក៏ ត្រូវបាន ប្រទះឃើញ ស្លាប់ បន្ទាប់ពី រថយន្ត របស់ ពួកគេ បាន បើក ទៅ បុក នឹង ម៉ាស៊ីន បំបែក ចរន្ត អគ្គិសនី មួយ គ្រឿង ។
គួរ បញ្ជាក់ ថា ពាក់ព័ន្ធ នឹង ការវាយប្រយុទ្ធ គ្នា ខាងលើ នេះ ក្រុម ប្រដាប់អាវុធ ប្រឆាំង របប យោធា មីយ៉ាន់ម៉ា បាន ប្រកាស ខ្លួន ឯង ថា ជា « កងកម្លាំង ការពារ ប្រជាជន ថ្មី នៅ ទីក្រុង ម៉ាន់ ដាឡាយ » ។ ពួកគេ ថែមទាំង បាន អះអាង ទៀត ថា ការប្រយុទ្ធ គ្នា បាន ចាប់ផ្តើម ហើយ ដោយ វា នឹង មាន បន្តបន្ទាប់ ទៀត ពោលគឺ ពួកគេ បាន ប្តេជ្ញា ថា នឹង តតាំង ជាមួយ យោធា មីយ៉ាន់ម៉ា នៅ ទីក្រុង ម៉ាន់ ដាឡាយ ដែល ស្ថិត នៅ ចំ កណ្តាល ប្រទេស នេះ ៕
រដ្ឋមន្ត្រី ការបរទេស អង់គ្លេស ជួប ពិភាក្សា ការងារ ជាមួយ រដ្ឋមន្ត្រី បរិស្ថាន កម្ពុជា
បន្ទាប់ពី មាន ជំនួប ជាមួយ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន កម្ពុជា លោក ដូមីនិក រ៉ា អាប់ ក៏ មាន កិច្ចប្រជុំ ទ្វេ ភាគី ជាមួយ លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន ផងដែរ ដោយ ផ្តោត ការពិភាក្សា លើ ទិដ្ឋភាព ផ្សេង ៗ នៃ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ព្រមទាំង បញ្ហា តំបន់ និង អន្តរជាតិ ដែល ជា ប្រយោជន៍ និង កង្វល់ រួម ។
ចំណេះដឹង ទូទៅ៖ បុគ្គល ទាំង ៧ ដែល មាន កម្ពស់ ខ្ពស់ បំផុត ក្នុង ប្រវត្តិសាស្រ្ត
