( ស្វាយរៀង ) ៖ លោក ជុក មុន្នី រដ្ឋលេខាធិការ ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ក្រុង ស្វាយរៀង បាន ជំរុញ ដល់ អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ គិតគូរ អំពី ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង អំឡុង ពេល ជំងឺ កូវីដ១៩ កំពុង រាលដាល នៅក្នុង សហគមន៍ ជាពិសេស ប្រជាពលរដ្ឋ ដែល កំពុង ជាប់ ធ្វើចត្តាឡី ស័ក នៅ តាម ខ្នង ផ្ទះ ដាច់ខាត មិន ត្រូវ ឱ្យ ពួកគាត់ ខ្វះ ស្បៀងអាហារ នោះ ឡើយ ។
ការជំរុញ បែប នេះ របស់ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ក្រុង ស្វាយរៀង បាន ធ្វើឡើង នៅក្នុង ឱកាស លោក ដឹកនាំ ក្រុមការងារ នាំយក គ្រឿង ឧបភោគ បរិភោគ ប្រគល់ ជូន ដល់ សាលា សង្កាត់ ចេក ក្រុង ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២១ ដើម្បី ផ្គត់ផ្គង់ ដល់ ប្រជាពលរដ្ឋ ដែល ជួប ការខ្វះខាត និង ប្រជាពលរដ្ឋ ដែល កំពុង ធ្វើជាប់ ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ ។
ការចុះ នាំយក អំណោយ ប្រគល់ ជូន ដល់ សង្កាត់ ចេក នេះ មាន ការចូលរួម ពី លោក ឥន ទឹម ប្រធាន ធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ និង លោក រៀម សុី ណា អនុប្រធាន ក្រុមការងារ និង លោក អភិបាល អភិបាល រង ក្រុង ស្វាយរៀង និង សមាជិក ក្រុមការងារ ចុះ ជួយ សង្កាត់ ជាច្រើន រូប ផងដែរ ។
លោក ជុក មុន្នី បាន បន្ត ថា « ក្នុង គ្រា ដែល ប្រទេស កម្ពុជា យើង កំពុង ឆ្លង រាលដាល ដោយ ជំងឺ កូវីដ១៩ ប្រមុខ ដឹកនាំ នៃ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ខិតខំ យកចិត្តទុកដាក់ ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ និង បាន គិតគូរ អំពី ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ដែល កំពុង ជួប ការខ្វះខាត នៅក្នុង កំឡុង ពេល ជំងឺ កូវីដ១៩ រាលដាល នៅក្នុង សហគមន៍ ក្នុង ព្រឹត្តិការណ៍ ២០កុម្ភៈ » ។
លោក ក៏ បាន ណែនាំ ឱ្យ ក្រុមប្រឹក្សា សង្កាត់ ពេល ទទួលបាន សម្ភារ នេះ ហើយ ត្រូវ ចេះ យក ទៅ ចែកជូន គ្រូសារ ដែល កំពុង ធ្វើចត្តាឡី ស័ក ដែល មាន អ្នកវិជ្ជមាន កូវីដ១៩ និង ណែនាំអោយ ពួកគាត់ អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ថែទាំ សុខភាព ឱ្យ បាន ល្អ ។
លោក ថោង ខុន ផ្សព្វផ្សាយ សេចក្ដីសម្រេច របស់ គណៈកម្មាធិការ កណ្ដាល ស្ដីពី ផែនការរួម ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ឃុំ - សង្កាត់ ២០២២ ជូន សមាជិក បក្ស ស្រុក បារាយណ៍ - តាំង គោក
( កំពង់ធំ )៖ លោក ថោង ខុន ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក នា ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ការប្រជុំ ផ្សព្វផ្សាយ សេចក្ដីសម្រេច របស់ គណៈកម្មាធិការ កណ្ដាល នៃ គណបក្ស ប្រជាជន កម្ពុជា ស្ដីពី ផែនការរួម ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ជូន ដល់ សមាជិក - សមាជិកា គណបក្ស ថ្នាក់ ស្រុក ឃុំ ភូមិ នៃ ស្រុក ទាំង ពីរ ។
នា ឱកាស នោះ លោក ហាក់ ម៉ុង ហួត ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក តាំង គោក និង លោក អួង សារឿន ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក បារាយណ៍ បាន ឡើង អាន សេចក្ដីព្រាង ផែនការ សកម្មភាព របស់ គណបក្ស ស្រុក រៀង ៗ ខ្លួន ដើម្បី ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ខាងមុខ ។
បន្ទាប់ពី ការអាន សេចក្ដីព្រាង ផែនការ នេះ រួចហើយ លោក ថោង ខុន បាន ណែនាំ នូវ ការងារ បន្ថែម មួយ ចំនួន ដល់ ប្រធាន គណបក្ស សមាជិក - សមាជិកា គណបក្ស ថ្នាក់ ស្រុក ឃុំ ភូមិ នៃ ស្រុក ទាំង ពីរ ដែល រួម មាន៖
* បញ្ចូល សមាសភាព បេក្ខ នារី និង យុវជន ទៅក្នុង រចនាសម្ពន្ធ របស់ គណបក្ស ន៊
* ខិតខំ គ្រប់គ្រង សមាជិក បក្ស ដែល ធ្វើ ចំណាកស្រុក ពិសេស ត្រូវ បង្កើន សមាជិក ថ្មី ពង្រឹង សមាជិក បក្ស ចាស់ ដើម្បី ដណ្ដើម ជ័យជម្នះ ជូន គណបក្ស ក្នុង ការបោះឆ្នោត ខាងមុខ ។
* ណែនាំឲ្យ ក្រុមការងារ ជំរុញ ការកសាង និង ជួសជុល កែលម្អ ទីស្នាក់ការ គណបក្ស ឃុំ ទាំងអស់ ឱ្យ មាន សោភ័ណភាព អនាម័យ បរិស្ថាន ល្អ បំពាក់ ឧបករណ៍ សម្ភារ : និង មធ្យោបាយ ធ្វើ ការងារ ឲ្យបាន គ្រប គ្រាន់ ពិសេស ជួសជុល ផ្លាក សញ្ញា គណបក្ស នៅ តាម ដងផ្លូវ និង នៅ តាម ភូមិ - ឃុំ ឱ្យ បាន ស្អាត ឡើងវិញ ។
* ក្ដាប់ ឱ្យ បាន នូវ សតិអារម្មណ៍ នយោបាយ សមាជិក គណបក្ស ។
* ផ្ទៀងផ្ទាត់ ឈ្មោះ របស់ សមាជិក បក្ស នៅ ក្នុង បញ្ជី ឈ្មោះ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) ប្រសិនបើ ឃើញ ខុស ទិន្នន័យ ណាមួយ ត្រូវ ទៅ ជួប ក្រុម ចុះឈ្មោះ ដើម្បី ធ្វើ ការកែតម្រូវ ភ្លាម ។
* ត្រូវ ខិតខំ ជំរុញ ដល់ ប្រជាពលរដ្ឋ ទូទៅ ចូលរួម ការ ក្នុង យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ដើម្បី បង្កើន ភាពសាំ នៅក្នុង សហគមន៍ ដែល ជា កត្តា ល្អ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ និង ការបោះឆ្នោត ជ្រើសតាំង សមាជិក សភា ។
លោក ថោង ខុន ក៏ បាន ណែនាំ ឱ្យ បន្ត ការអនុវត្ត តាម វិធានការ អនាម័យ របស់ ក្រសួង សុខាភិបាល ក៏ ដូចជា អនុសាសន៍ ណែនាំ របស់ សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី គឺ វិធានការ « ៣ការពារ ៣កុំ » ឱ្យ បាន ខ្ជាប់ខ្ជួន ជាប់ ជានិច្ច ។
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន លើកឡើង ថា ការបិទ ខ្ទប់ លំនៅដ្ឋាន របស់ បងប្អូន ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ រដ្ឋបាល រាជធានី ភ្នំពេញ ធ្វើឡើង ដោយ ការបង្ខំ ចិត្ត តែ ប៉ុណ្ណោះ មិន មាន ចេតនា ណាមួយ ធ្វើបាប បងប្អូន នោះ ទេ ពោលគឺ ចង់ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ មាន សុខ មោល ភាព ល្អ ជៀសវាង បាន នូវ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ខណៈ ដែល ជំងឺ នេះ បាន និង កំពុង វាយលុក នៅក្នុង រាជធានី និង នៅ តាម បណ្តាល ខេត្ត នានា នៅ ទូទាំង ព្រះរាជាណាចក្រ កម្ពុជា ។
ការលើកឡើង បែប នេះ របស់ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ ខណៈ ដែល លោក ដឹកនាំ អាជ្ញាធរ និង មន្ត្រី នាំយក អំណោយ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ប្រជាពលរដ្ឋ និង កម្មករ - កម្មការ នី ចំនួន ៧៩៨៨ គ្រួសារ នៅក្នុង តំបន់ បិទ ខ្ទប់ នៃ ភូមិ ព្រៃ ទា១ សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិសែន ជ័យ នា ព្រឹក ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ ។
លោក ឃួង ស្រេង បញ្ជាក់ ថា « ការបិទ ខ្ទប់ លំនៅដ្ឋាន របស់ បងប្អូន ប្រជាពលរដ្ឋ គឺ ធ្វើឡើង ដោយ ការបង្ខំ ចិត្ត ដើម្បី ទប់ស្កាត់ នូវ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។ ដូច្នេះ សូម បងប្អូន មេត្តា យោគយល់ និង រួមគ្នា ទប់ស្កាត់ ឲ្យបាន នូវ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ទាំងអស់ គ្នា » ។
លោក បន្ត ថា បងប្អូន ប្រជាពលរដ្ឋ កម្មករ កម្ម ការី នី រោងចក្រ រស់ នៅក្នុង ភូមិ ព្រៃ ទា១ សង្កាត់ ចោម ចៅ ទី៣ ខណ្ឌ ពោធិសែន ជ័យ ដែល ត្រូវបាន អាជ្ញាធរ បង្ខំ ចិត្ត បិទ ខ្ទុប ភូមិដ្ឋាន និង នាំយក អំណោយ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន មក ប្រគល់ ជូន នេះ មាន ចំនួ៧៩៨៨ គ្រួសារ ស្មើនឹង ៧៩៨៨ បន្ទប់ ដោយ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២៥ គីឡូ មី១ កេស ត្រីខ១យួរ ទឹកត្រី ទឹក ស៉ី អ៉ីវ ១យួរ និង ទឹក បរិសុទ្ធ ១កេស ។
លោក បន្ថែម ថា សម្តេច តេជោ ហ៊ុន សែន បាន យកចិត្តទុកដាក់ ណាស់ ចំពោះ ប្រជាពលរដ្ឋ កម្ពុជា ទាំងមូល សម្តេច មិន ត្រឹមតែ រំដោះ ប្រជាពលរដ្ឋ ចេញ ពី ការកាប់ សម្លាប់ នៃ របប ប៉ុល ពត ប៉ុណ្ណោះ ទេ សម្តេច នូវ បាន កសាង ប្រទេសជាតិ មួយ នេះ ពី បាត ដៃ ទទេ រហូត មាន ការអភិវឌ្ឍ រីកចំរើន មាន ទាំង រោងចក្រ សហគ្រាស កម្មករ កម្ម ការី នី បាន ប្រាក់ ខែ ខ្ពស់ ថែម ទៀត ។
លោក អភិបាល រាជធានី ក៏ ថ្លែង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទៀត ថា សូម បងប្អូន ជឿជាក់ លើ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ ប្រទេសជាតិ រីកចំរើន ដូច សព្វ ថ្ងៃ នេះ ។ សូម បងប្អូន ប្រជាពលរដ្ឋ កម្មករ កម្ម ការិនី កុំ ងាយ ជឿ អ្នក ថា ពេក សូម ជឿ មក លើ អ្នកធ្វើ ជឿ អ្នក ផ្តល់ ជឿ អ្នក ជួយ ជឿ អ្នក ទំនុកបម្រុង អ្នកថែទាំ យើង កុំ ជឿ អ្នក លើ អាកាស គេ បាន តែ មាត់ ទេ ។
ក្នុង ឱកាស នោះ ដែរ លោក ហែម ដារិទ្ធ អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន បញ្ជាក់ ថា អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ត្រូវបាន អាជ្ញាធរ រាជធានី ខណ្ឌ នាំ ទៅ ចែកជូន ប្រជាពលរដ្ឋ រងគ្រោះ និង ងាយ រងគ្រោះ ដោយ ជម្ងឺ កូវីដ - ១៩ នេះ បាន ចំនួន ជាង ១០ម៉ឺន ៥ ពាន់ គ្រួសារ ហើយ ៕
អាជ្ញាធរ ហាមឃាត់ ការជួបជុំ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩ បែរជា នាំគ្នា ប្រមូលផ្ដុំ លេង ល្បែង ស៉ី សង ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន នៅ តំបន់ ទំនប់ រលក ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ រហូតមកដល់ ពេលនេះ អាជ្ញាធរ ខេត្ត ព្រះសីហនុ បាន និង កំពុង បន្ដ ប្រយុទ្ធ ប្រឆាំង ជាមួយ ជំងឺ កូវីដ១៩ ដោយ ហាមឃាត់ ការជួបជុំ និង អនុវត្ត វិធានការ សុខាភិបាល ពិសេស នៅ តំបន់ ប្រឈម ជាមួយ ជំងឺ កូវីដ១៩ ។
គ្រា ដែល អាជ្ញាធរ កំពុង អនុវត្ដ វិធានការ រដ្ឋបាល នេះ មនុស្ស មួយ ក្រុម នៅ តំបន់ ដែល ប្រឈម គឺ តំបន់ ទំនប់ រលក បែរជា ប្រមូលផ្ដុំ គ្នា លេង ល្បែង ស៉ី សង ដោយ គ្មាន ខ្វាយខ្វល់ ជាមួយនឹង វិធានការ រដ្ឋបាល ទាល់តែសោះ ។ អ្នក ប្រមូលផ្ដុំ គ្នា លេង ល្បែង ស៉ី សង ទាំងនោះ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន នៅ ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ។
ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត កម្លាំង សមត្ថកិច្ច បាន ចុះ អនុវត្ត រឹត បណ្តឹង ហាមឃាត់ ការជួបជុំ និង មិន ពាក់ ម៉ាស់ នៅ តាម មូលដ្ឋាន ។
ជា លទ្ធផល សមត្ថកិច្ច បង្រ្កាប ការជួបជុំ លេង ល្បែង ស៉ីសង់ ( បៀ) បាន ចំនួន ៣វង់ ស្ថិត ក្នុង តំបន់ លឿង ( ជាពិសេស ក្នុង តំបន់ ទំនប់ រលក ) ដោយ ពួកគាត់ មិន គោរព វិធាន សុខាភិបាល ៣ការពារ និង ៣កុំ ។ លោក ឧត្តមសេនីយ៍ ស្នងការបាន បន្ដ ថា អ្នកលេង ល្បែង ទាំងនោះ ត្រូវបាន ឃាត់ យកមក ទី បញ្ជាការ ស្រាល ដើម្បី អនុវត្ត វិធាន រដ្ឋបាល និង វិធាន សុខាភិបាល ៕
ពលរដ្ឋ ជីវភាព ខ្វះខាត និង ធ្វើចត្តាឡី ស័ក ចំនួន ៤៥ គ្រួសារ នៅ ស្រុក កំពង់ត្របែក ទទួល អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ ពី សមាគម អតីត សិស្ស - និស្សិត នៅ កម្ពុជា
( ព្រៃវែង ) ៖ លោក មែ ស៊ី ថុន ប្រធាន សមាគម អតីត សិស្ស - និស្សិត នៅ កម្ពុជា និង សហការី នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន នាំយក នូវ គ្រឿង ឧបភោគ បរិភោគ មាន ដូចជា អង្ករ មី ត្រីខ ទឹកត្រី ទឹកស៊ីអ៊ីវ អំបិល ប៊ី ចេង និង ស្ករ ស ផ្តល់ ជូន ប្រជាពលរដ្ឋ ដែល បាន ធ្វើចត្តាឡី ស័ក និង មាន ជីវភាព ខ្វះខាត សរុប ចំនួន ៤៥ គ្រួសារ នៅ ឃុំ ជ្រៃ ស្រុក កំពង់ត្របែក ខេត្ត ព្រៃវែង ។
ក្នុង នោះ ក៏ មាន ការចូលរួម ពី លោក ហ៊ិន វន្នី អភិបាល រង ស្រុក កំពង់ត្របែក លោក មេឃុំ ជ្រៃ មេភូមិ ប៉ូលីស ប៉ុស្តិ៍ រដ្ឋបាល ឃុំ ជ្រៃ ថ្នាក់ដឹកនាំ សមាគម និង ប្រជាពលរដ្ឋ ផងដែរ ។
លោក ហ៊ិន វន្នី បាន ថ្លែង ថា ប្រជាជន ក្នុង ស្រុក កំពង់ត្របែក មាន អ្នក ឆ្លង កូវីដ - ១៩ សរុប ចំនួន ២៤ នាក់ បាន ជាសះស្បើយ សរុប ៨នាក់ កំពង់ព្យាបាល ១៤នាក់ និង ស្លាប់ ២នាក់ ( នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រៃវែង ) ។
លោក អភិបាល រង បាន បន្ត ថា លោក តំណាង អាជ្ញាធរ មូលដ្ឋាន និង ប្រជាពលរដ្ឋ សូម ថ្លែងអំណរគុណ ដល់ លោក មែ ស៊ី ថុន ប្រធាន សមាគម អតីត សិស្ស - និស្សិត នៅ កម្ពុជា សហការី និង សប្បុរសជន ទាំងអស់ ដែល បាន ផ្តល់ អំណោយ ជា ស្បៀងអាហារ ដល់ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត និង ធ្វើចត្តាឡី ស័ក ក្នុង ឃុំ ជ្រៃ ស្រុក កំពង់ត្របែក ក្នុង អំឡុង ពេល នៃ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ នេះ ។
លោក មែ ស៊ី ថុន បាន ឲ្យដឹង ថា អំណោយ ទាំងនេះ គឺ បាន មកពី កម្លាំង សាមគ្គី របស់ ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា របស់ សមាគម ព្រមទាំង លោក ចាស្ទីន រស់ នៅ រដ្ឋ តិចសាស់ សហរដ្ឋ អាមេរិក ។
លោក ប្រធាន សមាគម បាន បន្ត ថា ទោះជា អំណោយ នេះ តិចតួច ក្តី តែ វា គឺជា ទឹកចិត្ត នៃ ការចែករំលែក ជាពិសេស ក្នុង គ្រា ដ៏ លំបាក នេះ ដែល វា អាច ជួយ សម្រាល ការលំបាក ខ្លះ ៗ របស់ លោក តា លោកយាយ អ៊ុ ពូ មីង បងប្អូន ផងដែរ ។
លោក ប្រធាន សមាគម ក៏ បាន សំណូមពរ ដល់ ប្រជាជន នៅ ទីនេះ និង នៅ ទូទាំង ប្រទេស សូម ចូលរួម បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង អនុវត្ត វិធានការ « ៣ការពារ ៣កុំ » របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត និង ចូលរួម ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ឲ្យបាន គ្រប់ ៗ គ្នា ៕ ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ ២៧ នាក់ បន្ថែម ទៀត
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ២៧ នាក់ បន្ថែម ទៀត ដែល ក្នុង នោះ សុុទ្ធតែ អ្នក ពាក់ព័ន្ធ ជា មួុយ កម្មករ កម្ម ការិនី រោងចក្រ ។
( ភ្នំពេញ ) ៖ សមត្ថកិច្ច បាន ឃាត់ខ្លួន ជនសង្ស័យ ជា ឃាតក ម្នាក់ ដែល បាន ប្រើ កាំបិត ប័ុង តោកាប់ ទៅ លើ ជនរងគ្រោះ បណ្តាលឱ្យ ស្លាប់ នៅក្នុង ថ្លុក ឈាម យ៉ាង អាណោធ អាធ័ម កាលពី ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ ថ្មី ៗ នេះ នៅ សង្កាត់ ចាក់អង្រែ លេី ។ នេះ បើ តាម លោក សាន សុខ សីហា អ្នកនាំពាក្យ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ។
លោក បាន ឱ្យដឹង ទៀត ថា ជនសង្ស័យ ឃាតក ម្នាក់ ដែល បាន កាប់ ជនរងរងគ្រោះ ជា គូរ ទំនាស់ ដោយ ប្រើ កាំបិត បុ័ង តោ បណ្តាលឱ្យ ស្លាប់ កាលពី យប់ ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ ត្រូវបាន កម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ មានជ័យ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក ម៉េង វិមាន តារា អធិការ នគរបាល ខណ្ឌ មានជ័យ ស្រាវជ្រាវ និង ឃាត់ខ្លួន បាន ម្នាក់ ហើយ ជា ជនដៃ ដល់ រួមទាំង វត្ថុតាង កាលពី យប់ ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២១ ។
បច្ចុប្បន្ន នេះ សមត្ថកិច្ច កំពុង ធ្វេី ការសាកសួរ និង រៀបចំ សំណុំរឿង បញ្ជូន ទៅ តុលាការ ដេីម្បី អនុវត្ត បន្ត តាម នីតិវិធី ច្បាប់ ៕
សូម ជម្រាប ថា គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៣៣. ៦១៣ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ សរុប ចំនួន ២៦. ០៧៨ នាក់ និង ស្លាប់ សរុប ចំនួន ២៥២ នាក់ ៕ អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន៖ យើង រួមគ្នា ដាំ ដើមឈើ នៅក្នុង សហគមន៍ ដើម្បី បង្កើន ភាព បៃតង ចូលរួម អភិរក្ស ធនធាន ធម្មជាតិ និង ជីវៈ ចម្រុះ
( ត្បូងឃ្មុំ ) ៖ ក្នុង ឱកាស នៃ ការប្រារព្ធ ទិវា បរិស្ថាន ជាតិ និង ទិវា បរិស្ថាន ពិភពលោក ៥មិថុនា ២០២១ នេះ ក្រសួង បរិស្ថាន និង រដ្ឋបាល ក្រុង សួង នៃ ខេត្ត ត្បូងឃ្មុំ បាន សហការដាំ ដើមឈើ ប្រភេទ ឈើ ប្រណិត និង ដើម ផ្កា ដើម្បី បង្កើន ភាព បៃតង សម្រាប់ ក្រុង និង បណ្តុះ ស្មារតី ប្រជាពលរដ្ឋ ឱ្យ ស្រឡាញ់ និង ចូលរួម ការពារ បរិស្ថាន និង អភិរក្ស ធនធាន ធម្មជាតិ និង ជីវៈ ចម្រុះ ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា សកម្មភាព នៃ ការដាំ ដើមឈើ និង ដើម ផ្កា ប្រភេទ កម្រ នៅ ថ្ងៃ នេះ គឺជា សកម្មភាព មួយ ដ៏ ល្អ ប្រពៃ ដែល ត្រូវបាន ឱ្យ តម្លៃ ថា ជា ការលើកកម្ពស់ ការយល់ដឹង ពី បរិស្ថាន និង ធនធាន ធម្មជាតិ ហើយ រួមគ្នា ដាំ ដើមឈើ បន្ថែម នៅក្នុង សហគមន៍ និង ចូលរួម ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ ព្រៃឈើ សត្វ ព្រៃ ជីវៈ ចម្រុះ គ្រប់ ប្រភេទ ។
រដ្ឋលេខាធិការ មានប្រសាសន៍ ថា៖ « ការរួមគ្នា ដាំ ដើមឈើ តាម សហគមន៍ និង ទីប្រជុំជន មិន មែន បង្កើត ភាព បៃតង ជា ម្លប់ និង ការកាត់បន្ថយ ផល ប៉ះពាល់ នៃ ការប្រែប្រួល អាកាសធាតុ ទេ ប៉ុណ្ណោះ ទេ តែ បាន ចូលរួម ថែរក្សា និង អភិរក្ស ប្រភេទ ឈើ ប្រណីត សំខាន់ នៅក្នុង សហគមន៍ និង ចូលរួម បង្កើន វត្តមាន ឈើ ប្រណីត ក្នុង ប្រទេស កម្ពុជា និង ជា ការបន្សល់ទុក ជា កេរ តំណែល សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ » ។
អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន ឱ្យដឹង ថា នៅ រៀងរាល់ ឆ្នាំ កូន ឈើ ប្រណិត រួម មាន ប្រភេទ ឈើ គ្រញូង បេង នាង នួន ធ្នុង គគីរ ឈើ ទាល ជាច្រើន សែន ដើម ត្រូវបាន អាជ្ញាធរ ប្រជាពលរដ្ឋ ដាំ នៅ តាម តំបន់ នានា នៅក្នុង ប្រទេស កម្ពុជា ទាំង តាម ផ្លូវ សាធារណៈ តាម សាលារៀន វត្ត អារាម និង នៅ តាម តំបន់ ព្រៃ រិច រិល នានា ។
មន្ត្រី ជាន់ ខ្ពស់ រូប នេះ បាន ហៅ សកម្មភាព យ៉ាង ផុសផុល នៃ ការដាំ ដើមឈើ នៅ ទូទាំង ប្រទេស នេះ ថា ជា ចលនា ស្រឡាញ់ បរិស្ថាន និង ធនធាន ធម្មជាតិ និង ការចូលរួម យ៉ាង ផុសផុល នៃ ការដាំ ស្តារ ព្រៃឈើ ឡើងវិញ គឺជា កាយវិកា នៃ ការគោរព ស្រឡាញ់ និង ចូលរួម ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ និង ជីវៈ ចម្រុះ ឱ្យ បាន គង់វង្ស សម្រាប់ ជា ផលប្រយោជន៍ មនុស្ស រាប់ ជំនាន់តទៅ មុខ ទៀត ។
ជាមួយគ្នា នេះ ដែរ លោក នេត្រ ភក្ត្រា បាន លើកឡើង ថា « ដើមឈើ ដែល យើង ទាំងអស់ គ្នា បាន ដាំ នៅ ថ្ងៃ នេះ គឺ មាន ន័យ ថា កម្ពុជា នឹង មាន ដើមឈើ ថ្មី បន្ថែម លើ ធនធាន ព្រៃឈើ ដែល យើង មាន ស្រាប់ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ដែល យើង ទាំងអស់ គ្នា ត្រូវ ចូលរួម ការពារ និង អភិរក្ស » ។
រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ថា៖ « សូម បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ចូលរួម ដាំ ដើមឈើ ទាំងអស់ គ្នា ដើម្បី បង្កើត ភាព បៃតង បង្កើន គម្រប ព្រៃឈើ បន្ថែម និង ការពារ ធនធាន ធម្មជាតិ ព្រៃឈើ របស់ កម្ពុជា » ។
បើ តាម ការបញ្ជាក់ របស់ លោក នេត្រ ភក្ត្រា ប្រទេស កម្ពុជា បាន នឹង កំពុង ខិតខំ ប្រឹងប្រែង ការពារ ធន ធន ធម្មជាតិ ដែល ខ្លួន មាន ដោយ បង្កើត តំបន់ ការពារ ធម្មជាតិ និង តំបន់ អភិរក្ស ជាច្រើន កន្លែង ដែល រហូតមកទល់ ពេលនេះ ប្រព័ន្ធ តំបន់ ការពារ ពារ ធម្មជាតិ និង របៀង អភិរក្ស ជីវៈ ចម្រុះ ជាង ៧០ កន្លែង មាន ផ្ទៃដី ជាង ៧.៣លាន ហិកតា ស្មើ ប្រមាណ ជាង ៤១ ភាគរយ នៃ ផ្ទៃដី សរុប របស់ ប្រទេស កម្ពុជា និង ស្ថិត ក្រោម យុត្តាធិការ គ្រប់គ្រង និង អភិរក្ស របស់ ក្រសួង បរិស្ថាន ។
ក្រុង សួង នៃ ខេត្ត ត្បូងឃ្មុំ គឺជា ក្រុង មួយ ក្នុង ចំណោម ក្រុង ស្រុក នៃ ប្រទេស កម្ពុជា ដែល សកម្ម លើ ការបង្កើត គម្រប បៃតង និង ចូលរួម ថែរក្សា អភិរក្ស ធនធាន ធម្មជាតិ ដោយ ក្នុង នោះ បើ តាម ការបញ្ជាក់ របស់ លោក ជា ណារ៉ុន អភិបាល ក្រុង សួង ដើមឈើ ប្រណីត រួម មាន ដើម គ្រញូង ធ្នុង នាង នួន រួម នឹង ដើម ផ្កា ក្ងោក លឿង និង ដើម អន្ធ នេល ជាង ៣០០០ ដើម ហើយ ដែល ត្រូវបាន ដាំ នៅ តាម ដងផ្លូវ នានា ក្នុង ក្រុង សួង ។ រដ្ឋបាល ក្រុង នឹង បន្ត ដាំ ដើមឈើ បន្ថែម ទៀត នៅ ឆ្នាំ ខាងមុខ ។
ជាមួយគ្នា នេះ លោក អភិបាល ក្រុង សួង ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន ដែល បាន គាំទ្រ គំនិត ផ្តួចផ្តើម របស់ រដ្ឋបាល ក្រុង និង ផ្តល់ នូវ កូន ឈើ ប្រណីត រួម នឹង ដើម ផ្កា ក្ងោក ពណ៌ លឿង និង ដើម អន្ធ នេល ដើម្បី ដាំ ក្នុង ក្រុង ផងដែរ ៕
រដ្ឋបាល ខេត្ត ស្វាយរៀង អំពាវនាវ អ្នក ពាក់ព័ន្ធ ជាមួយ ស្ត្រី ម្នាក់ កើត កូវីដ ឈ្មោះ ផាន់ តុលា សូម ប្រញាប់ ទៅ ធ្វើតេស្ត រក មេរោគ កូវីដ ឱ្យ បាន ឆាប់ រហ័ស
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២១ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល ពាក់ព័ន្ធ ជាមួយ អ្នកជំងឺ កូវីដ១៩ ស្រ្តី ឈ្មោះ ផាន់ តុលា អាយុ ៣៤ ឆ្នាំ មាន មុខរបរ កម្មការិនី រោងចក្រ « កៅវ៉េ » នៅ សង្កាត់ បាវិត ក្រុង បាវិត តំបន់ សេដ្ឋកិច្ច មេនហាត ធេន រស់ នៅ ភូមិ អូក្អាម ឃុំ សំបួរ ស្រុក ស្វាយទាប ពាក់ ពន្ធ័ បន្ទប់ ពិគ្រោះ ស្រ្តី មាន ផ្ទៃពោះ មុននឹង ក្រោយ សំរាល ធ្មប មធ្យម ព្រំ សាវ៉ាន គិត ចាប់ពី យប់ ថ្ងៃទី ០២ ខែមិថុនា ឆ្នាំ ២០២១ ។
សូម បងប្អូន ដែល ពាក់ព័ន្ធ ទាំង ផ្ទាល់ និង ប្រយោល សូម ធ្វើចត្តាឡី ស័ក តាមដាន សុខភាព អនុវត្ត តាម វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ « ៣ការពារ ៣កុំ » របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្ត្រី នៃ កម្ពុជា ។
ជាមួយគ្នា នឹង ការអនុញ្ញាតឱ្យ បើក ដំណើរ ឡើងវិញ នេះ ដែរ អាជ្ញាធរ ខេត្ត កំពង់ចាម បាន បាន ណែនាំ ឱ្យ ម្ចាស់ ក្រុមហ៊ុន « ដាតាន់ អ៉ិន ដាស ស្ម្រៀល ឯ . ក » ត្រូវ រៀបចំ សង្វាក់ ផលិតកម្ម របស់ កម្មករ កម្ម ការិនី គឺ ត្រូវ ធ្វើ ការប្តូរ វេន កម្មករ កម្ម ការិនី និង ត្រូវ រក្សា គម្លាត សុវត្ថិភាព បុគ្គល ឱ្យ បាន ត្រឹមត្រូវ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕
ប្រទេស ចិន គិត ត្រឹម ថ្ងៃទី ០៣ ខែមិថុនា បាន ចាក់ វ៉ាក់សាំង សរុប ជាង ៧២៣. ៥លាន ដូស រួចហើយ ជូន ដល់ ប្រជាជន របស់ ខ្លួន ដែល ជា ចំនួន ច្រើន ជាង គេ បំផុត នៅក្នុង លោក ។ ទោះបីជា យ៉ាងណា កន្លងមក នេះ វ៉ាក់សាំង នានា នៅ ប្រទេស ចិន ត្រូវបាន អនុញ្ញាតឲ្យ ចាក់ តែ ទៅ លើ មនុស្ស អាយុ ១៨ ឆ្នាំ ឡើង ទៅ ប៉ុណ្ណោះ ។
លោក កែវ រតនៈ ចុះ សួរសុខទុក្ខ និង ផ្តល់ អំណោយ ជាច្រើន ដល់ កងកម្លាំង ឈរជើង ការពារ នៅ តាម ខ្សែ បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ក្នុង ភូមិសាស្ត្រ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ លោក កែវ រតនៈ រដ្ឋមន្រ្តី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី អគ្គ នាយក អគ្គិសនី កម្ពុជា និង ជា តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ប្រតិភូ អគ្គិសនី កម្ពុជា និង អាជ្ញាធរ អគ្គិសនី កម្ពុជា ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ ព្រមទាំង ឧបករណ៍ សម្ភារ ការពារ និង ប្រឆាំង កូវី ដ១៩ ឧបត្ថម្ភ ដល់ កងពល តូច អន្តរាគមន៍ លេខ ១៤ ក្នុង ខេត្ត ពោធិ៍សាត់ និង វរសេនា តូច លេខ១ ឈរជើង នៅ តំបន់ ថ្ម ដារ ព្រំដែន កម្ពុជា - ថៃ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក កែវ រតនៈ បាន បញ្ជាក់ ថា ទោះបី ក្នុង ស្ថានភាពលំបាក យ៉ាងណា ក៏ដោយ ក៏ រាជ រដ្ឋាភិបាល កម្ពុជា ពិសេស សម្តេច តេជោ ហ៊ុន សែន និង អគ្គិសនី កម្ពុជា ព្រមទាំង សហការី មិន ដែល ភ្លេច ពី សុខ ទុក្ខ របស់ បងប្អូន កងកម្លាំង នោះ ទេ ហើយ ការជួយ ឧបត្ថម្ភ សម្ភារ នេះ គឺ សំដៅ បំពេញការខ្វះខាត និង បន្ថែម ធនធាន ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បីឲ្យ បងប្អូន កងកម្លាំង មាន អារម្មណ៍ នឹង នរ ក្នុង ការឈរ ជើង ការពារ ទឹកដី ឲ្យបាន ប្រសើរ ។
បងប្អូន កងទ័ព កំពុង ឈរជើង នៅ តាម ព្រំដែន កម្ពុជា - ថៃ ក្នុង ភូមិសាស្ត្រ ខេត្ត ពោធិ៍សាត់ បាន បង្ហាញ នូវ ក្តី សប្បាយរីករាយ ដែល បាន ឃើញ អគ្គិសនី កម្ពុជា តែងតែ ចុះ សាកសួរ សុខទុក្ខ និង ជួយ ឧបត្ថម្ភ យ៉ាង ទៀត ទាត់ មិន ដែល ដាច់ ឡើយ ទោះ ក្នុង កាលៈទេសៈ ណា ក៏ដោយ ។
ជាមួយគ្នា នេះ បងប្អូន កងទ័ព សូម ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល ដែល បាន ផ្តល់ នូវ ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ពួកគាត់ និង ក្រុមគ្រួសារ ដើម្បី បានជា ខែល មួយ ក្នុង ការការពារ ជំងឺ កូវីដ១៩ ។
បងប្អូន កងទ័ព ក៏ បាន ផ្តាំផ្ញើ នូវ ការអរគុណ ដល់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សូម ជូនពរ ដល់ សម្តេច ទាំង២ ឲ្យ មាន អាយុ យ៉ឺន យូរ និង មាន ជោគជ័យ ក្នុង ការដឹកនាំ ប្រទេស កម្ពុជា ឆ្ពោះ ទៅកាន់ ការរីកចម្រើន កាន់តែ ខ្លាំងក្លា ឡើង ថែម ទៀត ៕
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៤១ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៤ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៤១ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមិថុនា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤១ នាក់ នោះ មាន ១៧នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៣ករណី និង ជនសង្ស័យ ២៤ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១១ករណី ។
អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ បន្ត អនុវត្តន៍ វិធានការ រដ្ឋបាល ជា បណ្តោះអាសន្ន ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ១៩ នៅ ភូមិសាស្ត្រ ក្រុង ប៉ោយប៉ែត រយៈពេល ១ សប្តាហ៍ ទៀត
( បន្ទាយមានជ័យ )៖ អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ ចេញ បាន សេចក្តីសម្រេច បន្ត អនុវត្តន៍ វិធានការ រដ្ឋបាល ជា បណ្តោះអាសន្ន ដើម្បី ទប់ សហកាត់ ការរីករាល នៃ ជំងឺ កូវីដ១៩ នៅ ភូមិសាស្ត្រ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ រយៈពេល ១ សប្តាហ៍ ទៀត គឺ ចាប់ពី ថ្ងៃទី ០៦ ដល់ ថ្ងៃទី ១២ ខែមិថុនា ឆ្នាំ ២០២១ ។ នេះ បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៥ ខែមិថុនា នេះ ។
រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា ត្រូវបាន បន្ត ផ្អាក ជា បណ្តោះអាសន្ន នូវ សកម្មភាព ការធ្វើចរាចរណ៍ ឆ្លងកាត់ ផ្លូវ ក្នុង ភូមិសាស្ត្រ រ ក្រុង ប៉ោយប៉ែត ចាប់ពី ម៉ោង ២០យប់ ដល់ ម៉ោង ៥ព្រឹក ជា កំហិត លើកលែងតែ ចំពោះ ករណី ដូច ខាងក្រោម៖
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ចុះ ពិនិត្យ កំណាត់ ផ្លូវ ជាតិ លេខ ៣ ដែល សាងសង់ រួចរាល់ ស្ទើរតែ ទាំងស្រុង
( ភ្នំពេញ ) ៖ កំណាត់ ផ្លូវ ជាតិ លេខ ៣ ប្រវែង ១៣៥ គីឡូម៉ែត្រ ពី រង្វង់ មូល ចោម ចៅ រាជធានី ភ្នំពេញ ទៅ ក្រុង កំពត ភាគ និរតី នៃ ប្រទេស កម្ពុជា បាន កែលំអរ និង សាងសង់ រួចរាល់ ស្ទើរ ទាំងស្រុង ហើយ ។
