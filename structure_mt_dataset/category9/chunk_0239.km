( មណ្ឌលគិរី ) ៖ ប្រភព ព័ត៌មាន ច្បាស់ ពី ប្រជាពលរដ្ឋ នៅ ខេត្ត មណ្ឌលគិរី បាន អះអាង ថា ដើម ស្រល់ ដែល គេ ដាំ មាន ទំហំ ធំ ៗ នៅក្នុង ស្រុក អូរ រាំង ក្បែរ ដី គម្រោង សាងសង់ ព្រលានយន្តហោះ ថ្មី ត្រូវ គេ កាប់ គាស់ និង ឈូសឆាយ បំផ្លាញ ចោល យ៉ាង អនាធិបតេយ្យ ដោយ គ្មាន ឃើញ មន្ត្រី ណា ចុះ ទៅ ត្រួតពិនិត្យ អ្វី ឡើយ ។
ប្រជាពលរដ្ឋ ដឹង ពី សកម្មភាព ខាងលើ បាន បន្ត អះអាង ថា អ្នក ដែល ធ្វើ សកម្មភាព កាប់ គាស់ និង ឈូស បំផ្លាញ ដើម ស្រល់ ដែល គេ ដាំ មាន អាយុកាល ជា យូរ ឆ្នាំ ដើម មាន ទំហំ ធំ ៗ ខាងលើ នេះ គឺជា មន្ត្រី ជំនាញ រដ្ឋបាល ព្រៃឈើ នៅក្នុង ខេត្ត តែម្ដង ព្រោះ គេ ស្គាល់ មុខ មន្ត្រី មេ ព្រៃ មួយចំនួន បាន ចុះ ទៅ ធ្វើ សកម្មភាព ដោយ ប្រើ រថយន្ត ខ្នាត ធំ ៗ និង គ្រឿងចក្រ រថយន្ត ស្ទូច ចុះ ទៅកាប់ អារ ជ្រៀក ហើយ ស្ទូច ដឹក ចេញ សូម្បីតែ គល់ ឈើ ក៏ ឈូសឆាយ រំលើង ចោល ដែរ ។
អ្វី ដែល គេ មាន ការភ្ញាក់ផ្អើល នោះ គឺ កន្លងមក គេ ធ្លាប់ តែ ឃើញ មន្ត្រី រដ្ឋបាល ព្រៃឈើ ខេត្ត និង ខាង ក្រុមហ៊ុន ដាំ ដើម ស្រល់ ដើរ ណែនាំ ហាមឃាត់ ប្រជាពលរដ្ឋ មិន ឲ្យ កាប់ គាស់ ដើម ស្រល់ ឬ រុករាន រំលោភបំពាន យក ដី ចំការស្រល់ តែ លើក នេះ បែរជា មន្ត្រី មេ ព្រៃ ខ្លួន ឯង ទៅ កាប់ គាស់ ឈីស ឆាយ ដី ចំការស្រល់ ទៅ វិញ មិន ដឹង ពួកគេ មាន បំណង កាប់ យក ឈស្រល់ ធំ ៗ ទាំងអស់ នោះ ឬ ក៏ ពួកគេ ឈូសឆាយ យក ដី ចំការស្រល់ នោះ ទៅ ធ្វើ កម្មសិទ្ធិ ឬ ធ្វើ អ្វី ផ្សេង នោះ ទេ ។
ប្រជាពលរដ្ឋ ដែល មើលឃើញ សកម្មភាព កាប់ គាស់ ឈូសឆាយ ដី ចំការស្រល់ ខាងលើ សំណូមពរ សុំឲ្យ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី ជួយ ចុះ ត្រួតពិនិត្យមើល ផង ថា តើ សកម្មភាព របស់ មន្ត្រី រដ្ឋបាល ព្រៃឈើ ខាងលើ នេះ ជា រឿង ស្រប ច្បាប់ ឬ ក៏ ជា សកម្មភាព អាង ខ្លួន មាន សិទ្ធិ អនុវត្ត ច្បាប់ ធ្វើ អ្វី ៗ ស្រេចតែ អំពើចិត្ត ៕
ខេត្ត កំពង់ចាម ប្រកាស ពី ករណី បុរស ម្នាក់ ស្លាប់ ដោយសារ ជំងឺ កូវីដ និង ទើប រកឃើញ វិជ្ជមាន កូវីដ ៤៥ នាក់ ទៀត
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៤៥ នាក់ បន្ថែម ទៀត និង ជាសះស្បើយ ចំនួន ៨៧ នាក់ នៅ ថ្ងៃទី ១៩ ខែមិថុនា ម្សិលមិញ ខណៈ ក្នុង ថ្ងៃ ជាមួយគ្នា នោះ ក៏ មាន ករណី ស្លាប ដោយសារ ជំងឺ កូវីដ ម្នាក់ ទៀត ផងដែរ ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត កំពង់ចាម ក៏ បាន ប្រកាស ពី ការស្លាប់ របស់ បុរស ម្នាក់ ផងដែរ ដោយសារ ជំងឺ កូវីដ១៩ ឈ្មោះ គង់ សត្ថា រ័ត្ន អាយុ ៣៨ ឆ្នាំ រស់ នៅ ភូមិ ទី៥ សង្កាត់ វាលវង់ ក្រុង កំពង់ចាម ។
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ អ្នកជំងឺ ចំនួន ២០ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ នៅក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ហើយ អ្នកជំងឺ ចំនួន ២. ៤០១នាក់ ផ្សេង ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ចំណេះដឹង ទូទៅ៖ តើ ជនជាតិ ណា ដែល បាន បង្កើត ម៉ាស់ អនាម័យ មុន គេ បង្អស់ ?
នៅ ចំពោះមុខ បញ្ហា នេះ រាជការ ឆេង ដែល រង ការរំខាន ដោយ ពួក អាណានិគម បស្ចិម លោក ផង និង ពីសំណាក់ ក្រុម បដិវត្ត ផង នោះ បាន ចាត់តាំង គ្រូពេទ្យ ល្បី ៗ ជាច្រើន មាន ទាំង គ្រូពេទ្យ បរទេស និង ពេទ្យ ជនជាតិ ចិន ដើម្បី រក មធ្យោបាយ កម្ចាត់ ជំងឺ ចង្រៃ នេះ ចេញ ពី មូលដ្ឋាន ប្រជាជន របស់ ខ្លួន ក្នុង នោះ ក៏ មាន ទាំង គ្រូពេទ្យ វ័យ ក្មេង អ៊ូ លាន តឺ (伍連德) ផងដែរ ។
មិន យូរ ប៉ុន្មាន គ្រូពេទ្យ ជនជាតិ បារាំង នោះ ក៏ ឆ្លង ជំងឺ ពិស ប៉េស្ត ស្លាប់ បាត់ ទៅ ឯ លោកគ្រូពេទ្យ អ៊ូ ដែល មាន វិធី ការពារ ខ្លួន ដោយ ការពាក់ ម៉ាស នោះ ក៏ នៅតែ អាច បន្ត ការងារ ពិនិត្យ ព្យាបាល អ្នកជំងឺ ប្រកបដោយ សុវត្ថិភាព ។ ប្រការ នេះ បាន បណ្ដាលឱ្យ មនុស្ស ទូទៅ មាន ការជឿជាក់ លើ អនុសាសន៍ របស់ លោកគ្រូពេទ្យ អ៊ូ យ៉ាង ខ្លាំង ហើយ នាំគ្នា អនុវត្ត តាម យ៉ាង ខ្ជាប់ខ្ជួន ។
គួរ បញ្ជាក់ ថា ទីក្រុង វ៉ាស៊ីនតោន បាន ប្រកាស ផ្ដល់ វ៉ាក់សាំង COVID-19 ឱ្យ កោះ តៃវ៉ាន់ នៅក្រោម ផែនការចែករំលែង វ៉ាក់សាំង ជាមួយ ពិភពលោក របស់ រដ្ឋបាល លោក ប្រធានាធិបតី ចូ បៃ ដិន និង បន្ទាប់ពី សមាជិក ព្រឹទ្ធសភា អាមេរិក បំពេញ ដំណើរទស្សនកិច្ច ទៅកាន់ កោះ តៃវ៉ាន់ កាលពី ពេល ថ្មី ៗ នេះ ។ ចិន ដែល តែងតែ អះអាង ថា កោះ តៃវ៉ាន់ ជា ខេត្ត មួយ របស់ ខ្លួន ក៏ បាន ប្រកាស ផ្ដល់ វ៉ាក់សាំង ឱ្យ កោះ តៃវ៉ាន់ ផងដែរ តែ ទីក្រុង តៃ ប៉ិមិន ទាន់ ឆ្លើយតប នោះ ទេ ៕
រដ្ឋបាល ខេត្ត តាកែវ បញ្ចប់ ការបិទ ខ្ទប់ និង បើក ដំណើរការ ឡើងវិញ នូវ ផ្សារ ត្រពាំង អណ្ដើក ស្រុក ត្រាំ កក់
( តាកែវ )៖ រដ្ឋបាល ខេត្ត តាកែវ នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ បាន ជូន ដំណឹង ស្ដីពី ការបញ្ចប់ ការបិទ ខ្ទប់ និង បើក ដំណើរការ ឡើងវិញ នូវ ផ្សារ ត្រពាំង អណ្ដើក នៃ ភូមិសាស្រ្ត ភូមិ ទួល ខ្លុង ឃុំ អូរ សារាយ ស្រុក ត្រាំ កក់ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត តាកែ វ៖
សូម ពាក់ មួក សុវត្ថិភាព ជានិច្ច ក្នុង ពេល បើកបរ ! ស្លាប់ ៤នាក់ និង របួស ៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ៤នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន ៕
ខេត្ត ព្រៃវែង បន្ត រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ២៤ នាក់ ថែម ទៀត
រដ្ឋបាល បន្ត ថា បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ទាំង ២៤ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង តាម មន្ទីរពេទ្យ បង្អែក ស្រុក របស់ ពួកគេ នីមួយ ៗ ។
ខេត្ត សៀមរាប រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ១១នាក់ ទៀត នៅ ថ្ងៃទី ២០ ខែមិថុនា
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប បាន ប្រកាស ពី ការរក ឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ១១នាក់ បន្ថែម ទៀត នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ។
ក្នុង លិខិត ប្រកាស ព័ត៌មាន រដ្ឋបាល ខេត្ត សៀមរាប បាន គូសបញ្ជាក់ ថា អ្នក កើត ជំងឺ កូវីដ១៩ ទាំង ១១នាក់ នេះ ករណី ទី១ ដល់ ទី២ ជា ករណី ពាក់ព័ន្ធ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ក្នុង សហគមន៍ ដែល មាន ប្រភព ដើម មកពី ស្រុក ជីក្រែង ចំពោះ ករណី ទី៣ ដល់ ទី៩ គឺជា ករណី ពុំ ទាន់ អាច សន្និដ្ឋាន ពី ប្រភព ចម្លង ច្បាស់លាស់ នៅឡើយ ។
ដោយឡែក ករណី ទី១០ និង ទី១១ គឺជា ប្រជាពលរដ្ឋ ដែល ត្រឡប់ មកពី ប្រទេស ថៃ មកដល់ ខេត្ត សៀមរាប ហើយ ជា ករណី សង្ស័យ ត្រូវបាន ក្រុម គ្រូពេទ្យ ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក នៅ វិទ្យាល័យ - សម្ដេច ឪ ។
សូម បញ្ជា កថ់ា មកទល់ ពេលនេះ ខេត្ត សៀមរាប មាន អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៥៨៧ នាក់ ហើយ ។ ក្នុង នោះ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ១៦៦ នាក់ ស្លាប់ ៥នាក់ និង ៤១៦ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប មណ្ឌល ចត្តាឡី ស័ក គរុកោសល្យ និង វិក្រឹត ការ ខេត្ត និង វិទ្យាល័យ ដំ ដែក ។
រដ្ឋបាល ខេត្ត សៀមរាប បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ឬ ដោយ ប្រយោល ជាមួយ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ដូច មាន រាយ នាម ក្នុង លិខិត នេះ សូម រួសរាន់ ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ ក្នុង ក្រុមគ្រួសារ រៀង ៗ ខ្លួន ឱ្យ បាន គ្រប់ ១៤ ថ្ងៃ ដោយ មិន ត្រូវ ពាក់ព័ន្ធ និង ប៉ះពាល់ ជាមួយ អ្នកដទៃ ជាដាច់ខាត ក្នុង ករណី មិន អនុវត្ត កាតព្វកិច្ចចត្តាឡី ស័ក រដ្ឋបាល ខេត្ត នឹង ចាត់ វិធានការ ផ្លូវ ច្បាប់ ចំពោះ បុគ្គល ទាំងឡាយ ណា ដែល លើ្មស នឹង វិធាន សុខាភិបាល នេះ ។
ខេត្ត បាត់ដំបង រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ ១២នាក់ ជាសះស្បើយ ១២នាក់ និង ស្លាប់ ម្នាក់
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង នា ព្រលប់ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ពី ការរក ឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ១២នាក់ ទៀត និង ជាសះស្បើយ ១២នាក់ ហើយ មាន ម្នាក់ ទៀត បាន ស្លាប់ ដោយសារ ជំងឺ នេះ ។
សូម បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ ខេត្ត បាត់ដំបង រកឃើញ ជំងឺ កូវីដ ចំនួន ៦៤៤ នាក់ ជាសះស្បើយ ចំនួន ៣៤៤ នាក់ កំពុង សម្រាក ព្យាបាល ចំនួន ២៩៦ នាក់ ទៀត និង ស្លាប់ ចំនួន ៤នាក់ ។
ខាងក្រោម ជា សេចក្តីប្រកាស របស់ រដ្ឋបាល ខេត្ត បាត់ដំប ង៖
ខេត្ត ព្រះវិហារ រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ ២នាក់ ទៀត . ម្នាក់ ធ្វើដំណើរ មកពី ខេត្ត កំពង់ធំ និង ម្នាក់ ទៀត ពី រាជធានី ភ្នំពេញ
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នា ព្រលប់ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ពី ការរក ឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ២នាក់ ទៀត ដោយ ម្នាក់ ធ្វើដំណើរ មកពី ខេត្ត កំពង់ធំ និង ម្នាក់ ទៀត ធ្វើដំណើរ មកពី រាជធានី ភ្នំពេញ ។
សូម បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ខេត្ត ព្រះវិហារ រកឃើញ ជំងឺ កូវីដ ចំនួន ៥៤ នាក់ បាន ព្យាបាល ជាសះស្បើយ ចំនួន ២០ នាក់ កំពុង សម្រាក ព្យាបាល ចំនួន ៣៤ នាក់ ទៀត ប៉ុន្តែ មិន ទាន់ មាន ករណី ស្លាប់ ដោយសារ ជំងឺ កូវីដ នេះ នោះ ទេ ៕
ដំណើរ ភៀសខ្លួន របស់ សម្តេច តេជោ ហ៊ុន សែន និង យុទ្ធ មិត្ត ត្រូវ ចាត់ទុក ជា ដំណើរតស៊ូ ដ៏ មាន គុណ តម្លៃ មិន អាច កាត់ថ្លៃ បាន នៅក្នុង ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ សម្រាប់ ជាតិ និង ប្រជាជន កម្ពុជា ។ ព្រោះតែ បែប នេះ ហើយ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង ការពារ ជាតិ បាន សម្រេច រៀបចំ ចងក្រង នូវ ឯកសារ ក៏ ដូចជា សំណង់ ទាំងឡាយ នៅ ទីតាំង តម្រាយ ផ្លូវ នៃ ដំណើរ ឆ្ពោះរក ការតស៊ូ រំដោះ ជាតិ នេះ ទុក ជា ការចងចាំ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ជំនាន់ ។
ការសាងសង់ សំណង់ ជា ការរំលឹក និង ចងចាំ ដល់ ដំណើរ តស៊ូ របស់ សម្តេច តេជោ ហ៊ុន សែន មិន ត្រឹមតែ ធ្វើឡើង នៅលើ ទឹកដី កម្ពុជា ប៉ុណ្ណោះ ទេ ។ នៅលើ ទឹកដី វៀតណាម ឯណោះ ក៏ មាន ការសាងសង់ សំណង់ មួយចំនួន ទុក ជា មរតក នៃ ការចងចាំ ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្ត្រ មួយ នេះ ផងដែរ ។
លើ ទឹកដី វៀតណាម ភាគី វៀតណាម បាន ជួយ សាងសង់ ផ្លូវ មួយ ខ្សែ ស្ថិត លើ តម្រាយ ផ្លូវ ដែល សម្តេច តេជោ បាន ធ្វើដំណើរ ភ្ជាប់ ពី ព្រំដែន កម្ពុជា ត្រង់ ដើម ទ្រយឹង ភ្ជាប់ រហូត ទៅដល់ ស្រុក ឡុក និញ ខេត្ត សុង ប៊ែ ប្រទេស វៀតណាម ។ វៀតណាម ក៏ បាន ជួយ សាងសង់ នូវ ផ្ទាំង សិលា មួយ ផ្ទាំង លើ ទឹកដី វៀតណាម ជាប់ នឹង ព្រំដែន នោះ ផងដែរ ។ ផ្ទាំង សិលា ដ៏ ធំ នោះ បាន ចារឹក នូវ ទង់ជាតិ កម្ពុជា និង វៀតណាម ហើយ ចារឹក នូវ អក្សរ កម្ពុជា និង វៀតណាម ទន្ទឹម គ្នា ផងដែរ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ នៅ ចំពោះមុខ សមភាគី គឺ លោក ឧត្តមសេនីយ៍ ឯក បម្រុង ហ្វាន វ៉ាន់ ហ្សាង បាន ហៅ វត្តមាន ផ្ទាំង សិលា មួយ ផ្ទាំង នេះ គឺជា ជោគជ័យ មួយ ដែល កម្ពុជា ចង់បាន ដើម្បី តម្កល់ ទុក ជា តឹកតាង ជា មរតក ប្រវត្តិសាស្ត្រ នៃ ដំណើរ តស៊ូ រំដោះ ប្រទេស របស់ សម្តេច តេជោ ហ៊ុន សែន និង យុទ្ធ មិត្ត ។
សម្តេច ពិជ័យ សេនា បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខាន់ បំផុត ដែល ខ្ញុំ បាន លើកឡើង ជា បន្តបន្ទាប់ ការធ្វើ ផ្លូវ ភ្ជាប់ ពី តំបន់ X16 ទៅ លើ ដល់ ស្រុក ឡក់នីញ នៃ សាធារណរដ្ឋ សង្កម និយម វៀតណាម ។ ថ្ងៃ នេះ យើង បាន ឃើញ ច្បាស់ សម្រេចបាន យ៉ាង ល្អ ប្រពៃ បំផុត សំខាន់ ជាង នេះ ទៅ ទៀត គឺ សិលាចារឹក មួយ ដែល យើង តម្រូវការដាក់ តាំង ឱ្យ ទាល់តែ បាន ដូច្នេះ ក្នុង រយៈពេល ដ៏ ខ្លី សិលាចារឹក នេះ ត្រូវបាន រៀបចំ សម្ពោធ នៅក្នុង ថ្ងៃ នេះ » ។
ក្រៅតែ ពី សមិទ្ធផល ដែល បាន និង កំពុង បង្ហាញ វត្ត ហើយ សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ ដែល ជា ខួប ៤៤ ឆ្នាំ នៃ ដំណើរ តស៊ូ របស់ សម្តេច តេជោ ហើយ នោះ នៅ ព្រឹក មិញ នេះ រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ កម្ពុជា និង វៀតណាម ក៏ បាន អញ្ជើញ រួមគ្នា បញ្ចុះ បឋមសិលា ដើម្បី សាងសង់ អគារ មិត្តភាព កម្ពុជា - វៀតណាម មួយ ខ្នង ទៀត ដែល មាន ការជួយគាំទ្រ ការសាងសង់ ពី ភាគី វៀតណាម ផងដែរ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន គូសបញ្ជាក់ ដែរ ថា សម្តេច នឹង ជំរុញ ដល់ ក្រុមការងារ ខ្លឹមសារ ឱ្យ បន្ត ខិតខំ សិក្សា ស្រាវជ្រាវ បន្ថែម រក នូវ ចំណុច ប្រវត្តិសាស្ត្រ ទាំង នៅលើ ទឹកដី កម្ពុជា និង វៀតណាម ដើម្បី ប្រមែប្រមូល ឯកសារ ឧបករណ៍ សម្ភារៈ យុទ្ធភ័ណ្ឌ ថែរក្សាទុកដាក់ ធ្វើជា វត្ថុ តឹក តាង ឱ្យ កាន់តែ រឹងមាំ ថែម ទៀត សម្រាប់ យុវជន និង មនុស្ស ជំនាន់ ក្រោយ យល់ដឹង ជ្រូត ជ្រាប បាន ច្បាស់លាស់ ត្រឹមត្រូវ នូវ ប្រវត្តិសាស្ត្រ ពិត ដែល វិវឌ្ឍ ទៅ តាម ដំណាក់កាល នីមួយ ៗ ដែល កម្ពុជា និង វៀតណាម បាន ឆ្លងកាត់ ។
ប្រកាស របស់ ក្រសួង សុខាភិបាល បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា ត្រូវបាន ដាក់ ឲ្យ ប្រើ នីតិវិធី ប្រតិបត្តិ ស្តង់ដារ សម្រាប់ គ្រប់គ្រង ថែទាំ និង ព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ កម្រិត ស្រាល និង គ្មាន រោគសញ្ញា នៅ តាម ផ្ទះ ដែល ជា ឧបសម្ព័ន្ធ នៃ ប្រកាស នេះ ជា ជំហាន ដំបូង ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ។
ក្រសួង បន្ត ថា ការដាក់ ឲ្យ ដំណើរការ ការព្យាបាល អ្នកជំងឺ កូវីដ - ១៩ កម្រិត ស្រាល និង គ្មាន រោគសញ្ញា នៅ តាម ផ្ទះ សម្រាប់ ភូមិសាស្ត្រ ខេត្ត ផ្សេង ទៀត ត្រូវ កំណត់ ដោយ ប្រកាស របស់ ក្រសួង សុខាភិបាល នៅ ពេល ក្រោយ ផ្អែក តាម កម្រិត នៃ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ភូមិសាស្រ្ត នីមួយ ៗ ៕ ខេត្ត មណ្ឌលគិរី រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ ៤នាក់ បន្ថែម ទៀត
( មណ្ឌលគិរី ) ៖ រដ្ឋបាល ខេត្ត មណ្ឌលគិរី នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន សេចក្ដីជូនដំណឹង ស្ដីពី ការរកឃើញ ករណី អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ៤នាក់ បន្ថែម ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត មណ្ឌលគិរី៖ ឥណ្ឌូនេស៊ី កត់ត្រា អ្នក ឆ្លង កូវីដ១៩ « ១៣. ៧៣៧ ករណី » និង ស្លាប់ ៣៧១ នាក់ ទៀត នៅ ថ្ងៃ នេះ ដែល ជា តួលេខ ខ្ពស់ បំផុត មិន ធ្លាប់ មាន
( ហ្សាកាតា ) ៖ អាជ្ញាធរ សុខាភិបាល ឥណ្ឌូនេស៊ី នៅ ថ្ងៃអាទិត្យ នេះ បាន ប្រកាស រកឃើញ ករណី ឆ្លង កូវីដ១៩ ចំនួន ១៣. ៧៣៧ ករណី ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ នេះ ដែល ជា តួលេខ ឆ្លង ប្រចាំ ថ្ងៃ ខ្ពស់ បំផុត ចាប់តាំងពី ខែមករា មក ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ យប់ ថ្ងៃអាទិត្យ ទី២០ ខែមិថុនា ឆ្នាំ ២០២១ ។
នៅ ថ្ងៃ ជាមួយគ្នា នេះ ក្រសួង សុខាភិបាក ឥណ្ឌូនេស៊ី ក៏ បាន កត់ត្រា អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ ដ៏ កាច សាហាវ នេះ ចំនួន ៣៧១ នាក់ បន្ថែម ទៀត ផងដែរ ។
ខេត្ត កោះកុង រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ ៦១ នាក់ និង ជាសះស្បើយ ២នាក់
( កោះកុង) ៖ រដ្ឋបាល ខេត្ត កោះកុង នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន សេចក្ដីជូនដំណឹង ស្ដីពី ការរកឃើញ ករណី អ្នកវិជ្ជមាន ជំងឺ កូវីដ - ១៩ ចំនួន ៦១ នាក់ បន្ថែម និង ជាសះស្បើយ ពី ជំងឺ នេះ ចំនួន ២នាក់ ទៀត ផងដែរ ។
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត កោះកុង៖ មនុស្ស ស្លាប់ ៤នាក់ នៅ ស្រុក ពារាំង ខេត្ត ព្រៃវែង ដោយសារ ផឹក ស្រា ដាច់ បាយ ដាច់ ទឹក
( ព្រៃវែង ) ៖ យ៉ាងហោចណាស់ មាន មនុស្ស ៤នាក់ បាន ស្លាប់ បាត់បង់ជីវិត នៅ ភូមិ យោត ឃុំ មេសរ ប្រចាន់ ស្រុក ពារាំង ខេត្ត ព្រៃវែង បន្ទាប់ពី ពួកគេ បាន ផឹក ស្រា ស ភ្លេច បាយ ភ្លេច ទឹក បណ្ដាលឱ្យ មាន អាការ ក្អួត ចង្អោរ ធ្វើ ទុក្ខ ក្នុង ខ្លួន ខ្យល់ គ រហូតដល់ ដាច់ខ្យល់ស្លាប់ តែម្ដង ។
សមត្ថកិច្ច ដដែល បាន បន្ត ថា នៅ មុនពេល កើត ហេតុ ជនរងគ្រោះ បាន ទិញ ស្រាស ផឹក កាលពី យប់ ថ្ងៃទី ១៨ ខែមិថុនា ឆ្នាំ ២០២១ លុះ ដល់ ព្រឹក ថ្ងៃទី ១៩ ក៏ មាន អាការ មិន ស្រួល ខ្លួន ធ្វើ ទុក្ខ ក្នុង ខ្លួន រហូត ដាច់ខ្យល់ស្លាប់ តែម្ដង ។
ទោះបី យ៉ាងណា សមត្ថកិច្ច បញ្ជាក់ ថា ការស្លាប់ មនុស្ស ៤នាក់ នេះ គឺ មកពី ពួកគេ ផឹក ស្រាស ជាប្រចាំ មិន សូវ ទទួលទាន អាហារ នោះ ឡើយ ក្នុង នោះ មាន ម្នាក់ ជា មនុស្ស វិកលចរិត ហើយ ផឹក ស្រា ជាប្រចាំ រីឯ ២នាក់ ទៀត ក៏ ផឹក ស្រា ជាប្រចាំ ដែរ ចំណែក ម្នាក់ ទៀត មកពី ធ្វើ ការហត់ អស់ កម្លាំង ហើយ ផឹក ស្រា ច្រើន ទើប ខ្យល់ គស្លាប់ តែម្តង ។
សូម បញ្ជាក់ ថា នៅ ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ មន្ត្រី ជំនាញ បាន ចុះ ពិនិត្យ ទីតាំង ផលិត ស្រាស នៅ ស្រុក ពារាំង ដើម្បី រក សារធាតុ ដែល ធ្វើឲ្យ មាន មនុស្ស ស្លាប់ ផងដែរ តែ លទ្ធផល យ៉ាងណា នោះ មិន ទាន់ បាន ទទួល ជា ផ្លូវការ នោះ ទេ ៕
ខេត្ត ព្រះវិហារ រកឃើញ ករណី វិជ្ជមាន ជំងឺ កូវីដ ២នាក់ ទៀត ជា ពលករ មកពី ប្រទេស ថៃ
( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការរកឃើញ មនុស្ស ២នាក់ ទៀត ជា ពលករ មកពី ប្រទេស ថៃ ឆ្លង ជំងឺ កូវីដ - ១៩ ។
យោង សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ បាន បញ្ជាក់ ថា មនុស្ស ២នាក់ ដែល រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ - ១៩ គឺជា ពលករ ឆ្លង ដែន មកពី ប្រទេស ថៃ ដោយ ម្នាក់ ឆ្លង តាម ច្រក អូរ បី ជាន់ ក្នុង ស្រុក អូរ ជ្រៅ និង ម្នាក់ ទៀត ឆ្លង តាម ច្រក ព្រំដែន ចំបក់ ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ និង បញ្ជូន មក ធ្វើចត្តាឡី ស័ក កម្រិត ១ នៅ ស្រុក ជាំ ក្សាន្ត កាលពី ថ្ងៃទី ៧ ខែមិថុនា លុះ ថ្ងៃទី ២០ នេះ ត្រូវ ក្រុម គ្រូពេទ្យ ធ្វើតេស្ត រកឃើញ ជំងឺ កូវីដ - ១៩ ។
ខាងក្រោម ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ៖ នគរបាល បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន ចាប់ខ្លួន ជនជាតិ ខ្មែរ ៤នាក់ និង រឹបអូស គ្រឿងញៀន ជាង ១គីឡូក្រាម នៅ ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ កម្លាំង នគរបាល ជំនាញ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន ចាប់ខ្លួន ជនជាតិ ខ្មែរ ៤នាក់ និង រឹបអូស គ្រឿងញៀន ជាង ១គីឡូក្រាម នៅ ខេត្ត បន្ទាយមានជ័យ ។
ការបង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ១៧ ខែមិថុនា ឆ្នាំ ២០២១ វេលា ម៉ោង ២០៖ ២១នាទី កម្លាំង ជំនាញ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន ( ក៤) ដឹកនាំ ដោយ លោក នាយក រង ឃឹង សារ៉ាត់ និង មាន ការចូលរួម ពី ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ដឹកនាំ សម្របសម្រួល ពី លោក កើត វណ្ណារ៉េត ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ បាន បើក ការស៊ើបអង្កេត ស្រាវជ្រាវ ឈាន ទៅ បង្ក្រាប បាន នៅ ចំណុច ផ្ទះសំណាក់ ប៉ោយប៉ែត ផាស ភូមិ ក្បាល ស្ពាន់២ សង្កាត់ ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
បច្ចុប្បន្ន ជនសង្ស័យ និង វត្ថុតាង ត្រូវបាន កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ តាម នីតិវិធី ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៦២៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ទូរស័ព្ទ ល្មើស សញ្ញា បត់ ជែង លើស ចំណុះ និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ស្លាកលេខ ទូរស័ព្ទ អត់ ខ្សែក្រវ៉ាត់ លើស ចំណុះ អាជីវកម្ម ឆៀក ជាដើម ។
មន្រ្តី សាលាដំបូង រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ពាក់ព័ន្ធ នឹង ការប្រមាថ ព្រះមហាក្សត្រ ជា ទង្វើ អសីលធម៌ ដែល មិន អាច អត់ឱន បាន ទៅ លើ ជន បរទេស សញ្ជាតិ អេស្ប៉ាញ ដែល ព្រះមហាក្សត្រ គឺជា ទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស ។
កាលពី ថ្ងៃទី ១៦ ខែមិថុនា ឆ្នាំ ២០២១ សមត្ថកិច្ច បាន ចាប់ខ្លួន សកម្មជន ចលនា មាតា ធម្មជាតិ ៣នាក់ រួម មាន ១៖ ឈ្មោះ ស៊ុន រដ្ឋា ភេទ ស្រី តួនាទី គណនី មាតា ធម្មជាតិ ទី២៖ ឈ្មោះ លី ចាន់ ដារ៉ាវុត ភេទ ប្រុស តួនាទី អ្នកស្រាវជ្រាវ និង Media Team និង ទី៣៖ ឈ្មោះ យឹម លាង ហ៉ី ភេទ ប្រុស តួនាទី សម្របសម្រួល ការងារ សកម្មជន ។
លោក អាឡិច ត្រូវបាន ក្រសួង មហាផ្ទៃ បណ្តេញ ចេញ កាលពី អំឡុង ខែកុម្ភៈ ឆ្នាំ ២០១៥ បន្ទាប់ពី បាន ធ្វើ សកម្មភាព ប្រឆាំង មួយចំនួន នៅ តំបន់ អារ៉ែង និង ប្រឆាំង ការបូម ខ្សាច់ នៅក្នុង ខេត្ត កោះកុង ដែល អាជ្ញាធរ អះអាង ល្មើស ច្បាប់ នៅ កម្ពុជា ។ បន្ទាប់ពី បណ្តេញ ចេញ ជន នេះ ក៏ ត្រូវបាន វ៉ៃ ត្រា ក្រហម ហាម ចូល ប្រទេស កម្ពុជា រហូត ផងដែរ ៕ ពលករ ១៦ នាក់ បម្រុង ឆ្លង ដែន ខុស ច្បាប់ ត្រូវ កម្លាំង សមត្ថកិច្ច ឃាត់ខ្លួន នៅជិត ព្រំដែន ក្នុង ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ ពលករ ខ្មែរ មាន គ្នា ១៦ នាក់ ( ស្រី ១០នាក់ ) បម្រុង លួច ឆ្លង ដែន ខុស ច្បាប់ ឆ្ពោះទៅ ទឹកដី ថៃ ក៏ ត្រូវបាន កម្លាំង សមត្ថកិច្ច នៃ វរសេនា តូច លេខ ៥១១ និង កងពល តូច ថ្មើរជើង លេខ ៥១ ឃាត់ខ្លួន បាន នៅ ត្រង់ ចំណុច ភូមិសាស្ត្រ ភូមិ សង្កែ ឃុំ បឹង បេង ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ ។
ដោយ មាន បទបញ្ជា ពី លោក ឧត្តមសេនីយ៍ ត្រី សឹង្ហ ទុំ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ និង ដឹកនាំ កម្លាំង ផ្ទាល់ ដោយ លោក វរសេនីយ៍ ត្រី លឹម វណ្ណា រិទ្ធ មេបញ្ជាការវរសេនា តូច ថ្មើរជើង លេខ ៥១១ បាន ដឹកនាំ កម្លាំង ល្បាត ២៤ ម៉ោង លើ ២៤ ម៉ោង ដោយ ប្តូរ វេន គ្នា សហការ ជាមួយ កម្លាំង វរសេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៨១៥ ដើម្បី ទប់ស្កាត់ ពលករ លួច ឆ្លង ដែន ខុស ច្បាប់ និង ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ មិន ឲ្យ ចូល ទៅក្នុង សហគមន៍ ។
ខណៈ កងកម្លាំង ចម្រុះ ល្បាត ក៏ បាន ជួប ពលករបម្រុង លួច ឆ្លង ដែន ចេញ ទៅ ប្រទេស ថៃ ត្រូវបាន កម្លាំង វរសេនា តូច លេខ ៥១១ កងពល តូច ថ្មើរជើង លេខ ៥១ ឃាត់ខ្លួន បាន នៅ យប់ រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ២០ ខែមិថុនា ឆ្នាំ ២០២១ ។
ក្រោយពី ឃាត់ខ្លួន បាន លោក វរសេនីយ៍ ត្រី លឹម វណ្ណា រិទ្ធ ក៏ បាន ណែនាំ ដល់ ពលករ ទាំងនោះ កុំ បន្ត ចាញ់បោក មេខ្យល់ ដែល តែងតែ បញ្ចុះបញ្ចូល នាំ ពលករ ឆ្លង ដែន ដោយ ខុស ច្បាប់ ដោយ មិន គិត ពី សុវត្ថិភាព និង ខាតបង់ ប្រាក់ ជា បន្តបន្ទាប់ ជាពិសេស សូម បន្ត ចូលរួម អនុវត្ត វិធានការ ៣កុំ ៣ការពារ ឲ្យបាន ទាំងអស់ គ្នា ។
បច្ចុប្បន្ន ពលករ ទាំង ១៦ នាក់ នោះ ត្រូវបាន បញ្ជូន ទៅ ធ្វើចត្តាទ្បីស័ក ១៤ ថ្ងៃ នៅ ស្រុក ម៉ាឡៃ និង បន្ត ស្រាវជ្រាវ រក មេខ្យល់ និង អ្នក ពាក់ព័ន្ធ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ៕
