( កំពង់ឆ្នាំង ) ៖ លោក ឧកញ៉ា អ៉ឹង ប៊ុន ហ៊ូវ ប្រធាន អគ្គ នាយ ក្រុមហ៊ុន ដូន ពេញ ( ខេមបូឌា ) គ្រុប និង ភរិយា លោកស្រី ហេង សុខា បាន ផ្តល់ ម៉ាស់ ចំនួន ៥ម៉ឺន ម៉ាស់ អាល់កុល ៦០០លីត្រ និង ទឹក ពិសា ភ្នំ ដប ៣០០ យួរ ជូន ដល់ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ដើម្បី ចូលរួម ក្នុង បេសកកម្ម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល កំពុង រាតត្បាត នៅក្នុង ប្រទេស កម្ពុជា ។ ម៉ាស់ អាល់កុល និង ទឹក បរិសុទ្ធ នេះ ជា អំណោយ លើក ទី២ ហើយ ដែល លោក ឧកញ៉ា និង ភរិយា បាន ផ្តល់ ជូន ទៅកាន់ មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង ។
អំណោយ កើត ចេញ ពី ស្មារតី ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ នេះ ត្រូវបាន ក្រុមការងារ របស់ លោក ឧកញ៉ា យក ទៅ ប្រគល់ ជូន មន្ទីរពេទ្យ នៅ ថ្ងៃចន្ទ ទី២១ ខែមិថុនា ឆ្នាំ ២០២១ ។
ប្រធាន មន្ទីរពេទ្យ ខេត្ត កំពង់ឆ្នាំង លោក វេជ្ជៈ បណ្ឌិត ទុំ សម្បត្តិ បាន សម្ដែង នូវ ទឹកចិត្ត សប្បាយរីករាយ និង បាន ថ្លែងអំណរ អរគុណ ចំពោះ ទឹកចិត្ត សប្បុរសធម៌ របស់ លោក ឧកញ៉ា និង លោកស្រី ព្រមទាំង ក្រុមគ្រួសារ ដែល តែងតែ គិតគូរ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពង់ឆ្នាំង ។
នៅ ដើម ខែឧសភា ឆ្នាំ ២០២១ លោក ឧកញ៉ា និង លោកស្រី បាន ជួយ ឧបត្ថម្ភ ម្ដង រួច មកហើយ តែ ដោយ ក្រុម គ្រូពេទ្យ នៅ មាន ការខ្វះខាត សម្ភារៈ ដូច បាន រៀបរាប់ ខាងលើ ទើប ជម្រុញ ឱ្យ លោក បន្ត ផ្ដល់ជូន បន្ថែម ទៀត សម្រាប់ បន្ត យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ដែល ក្រុម គ្រូពេទ្យ កំពុងតែ ម មារ ញឹក ក្នុង ការងារ នេះ ។
តាមរយៈ ក្រុមការងារ លោក ឧកញ៉ា អុឹង ប៊ុន ហ៊ូវ បាន ផ្តាំផ្ញើ អរគុណ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ ក្រុម គ្រូពេទ្យ ដែល បាន ខិតខំ អស់ ពី កម្លាំង កាយ ចិត្ត ជួយ ព្យាបាល និង ថែទាំង អ្នកជំងឺ ។ លោក ឧកញ៉ា នឹង នៅ បន្ត ផ្ដល់ កម្លាំងចិត្ត ជូន លោកគ្រូ អ្នកគ្រូពេទ្យ ជា កម្លាំង ប្រយុទ្ធ ជួរ មុខ ដែល ជា អ្នក អនុវត្ត ការងារ ផ្ទាល់ ដើម្បី កាត់ផ្ដាច់ ខ្សែ ចម្លង ជំងឺ កូវីដ - ១៩ ។
លោក ឧកញ៉ា បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ មេត្តា កុំ ភ្លេច ខ្លួន និង សូម បន្ត ចូលរួម អនុវត្ត នូវ គ្រប់ វិធានការ « ៣ការពារ ៣កុំ » ដែល ជា អនុសាសន៍ របស់ សម្តេច តេជោ ឱ្យ បាន ខ្ជាប់ខ្ជួន ជា ទីបំផុត ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២២ ខែមិថុនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៣២ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២៣ ខែមិថុនា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣២ នាក់ នោះ មាន ៩នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ៦ករណី និង ជនសង្ស័យ ២៣នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១២ករណី ។
ប្រធានាធិបតី រុស្ស៊ី លោក ពូទីន និយាយ ថា អង្គការ NATO កំពុង ធ្វើឱ្យ អន្តរាយ ដល់ សន្តិសុខ ទ្វីប អឺរ៉ុប ទាំងមូល (Video inside) ( ម៉ូស្គូ) ៖ ប្រធានាធិបតី រុស្ស៊ី លោក វ្លាឌីមៀ ពូទីន បាន និយាយ នៅ ថ្ងៃអង្គារ នេះ ថា ប្រព័ន្ធ សន្តិសុខ អឺរ៉ុប ទាំងមូល ត្រូវបាន បំផ្លាញ យ៉ាង ខ្លាំង ខណៈ ភាពតានតឹង កំពុង កើនឡើង និង ហានិភ័យ នៃ ការប្រណាំង ប្រជែង សភា វុធ ថ្មី កំពុង ក្លាយជា ការពិត ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ យប់ ថ្ងៃអង្គារ ទី ២២ ខែមិថុនា ឆ្នាំ ២០២១ ។
លោក ពូទីន បាន ធ្វើការកត់សម្គាល់ បែប នេះ នៅក្នុង អត្ថបទ មួយ ដែល ត្រូវបាន ចេញផ្សាយ ដោយ កាសែត ប្រចាំ សប្តាហ៍ អាល្លឺម៉ង់ Die Zeit ដើម្បី ប្រារព្ធ ខួប លើក ទី ៨០ នៃ ការចាប់ផ្តើម សង្គ្រាម ស្នេហាជាតិ របស់ សហភាព សូវៀត ប្រឆាំង នឹង របប ណា ស៊ី អាល្លឺម៉ង់ ។
លោក បាន សង្កត់ធ្ងន់ ថា ប្រទេស រុស្ស៊ី បាន ស្វែងរក ការអភិវឌ្ឍ ទំនាក់ទំនង របស់ ខ្លួន ជាមួយ អឺរ៉ុប ។ ប៉ុន្តែ ការពង្រីក ឥទ្ធិពល របស់ អង្គការ សន្ធិសញ្ញា អាត្លង់ទិក ភាគ ខាងជើង (NATO) ឆ្ពោះទៅ ទិក ខាងកើត បាន នាំឱ្យ មាន ការកើនឡើង នូវ ការ មិន ទុកចិត្ត គ្នា ទៅ វិញ ទៅ មក នៅ អឺរ៉ុប ។
