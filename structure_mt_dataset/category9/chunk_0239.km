( ព្រះវិហារ ) ៖ រដ្ឋបាល ខេត្ត ព្រះវិហារ នៅ ល្ងាច ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការរកឃើញ បុរស ២នាក់ ទៀត មាន វិជ្ជមាន កូវីដ១៩ ។ ក្នុង នោះ ម្នាក់ ពាក់ព័ន្ធ កម្មវិធី ភ្ជាប់ពាក្យ កូន ប្រជាពលរដ្ឋ រស់ នៅ ភូមិ ស្រអែម ជើង ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត កាលពី ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២១ កន្លងទៅ និង ម្នាក់ ទៀត ជា ពលករ ឆ្លង ដែន មកពី ប្រទេស ថៃ ។
សេចក្តីប្រកាស របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រលប់ ថ្ងៃ នេះ បាន បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ខេត្ត ព្រះវិហារ រកឃើញ កូវីដ ចំនួន ៩ករណី ក្នុង នោះ បាន ព្យាបាល ជាសះស្បើយ ៣ករណី និង កំពុង សម្រាក ព្យាបាល ចំនួន ៦ករណី ទៀត ៕ ខេត្ត បាត់ដំបង រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ ចំនួន ១២នាក់ ទៀត ជា ពលករ មកពី ប្រទេស ថៃ ៥នាក់ និង ជាសះស្បើយ ២នាក់
គិត មកដល់ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ខេត្ត បាត់ដំបង បាន រកឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ២៣៦ នាក់ ព្យាបាល ជាសះស្បើយ ចំនួន ៩៣ នាក់ ករណី ស្លាប់ ២នាក់ បញ្ជូន ទៅ ព្យាបាល នៅ ខេត្ត បន្ទាយមានជ័យ ចំនួន ២នាក់ និង កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក នានា ក្នុង ខេត្ត បាត់ដំបង ចំនួន ១៣៩ នាក់ ៕
ខេត្ត កំពង់ធំ បន្ត រកឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ២នាក់ ថ្មី បន្ថែម ទៀត និង ជាសះស្បើយ ១៥នាក់
ដើម្បី ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បន្ថែម ទៀត រដ្ឋបាល ខេត្ត សូម អំពាវនាវ ដល់ អ្នក ដែល ធ្លាប់ ប្រាស្រ័យទាក់ទង ជាមួយ អ្នកវិជ្ជមាន ខាងលើ សូម រួសរាន់ ទំនាក់ទំនង ទៅ អាជ្ញាធរ ឬ មណ្ឌល សុខភាព ដែល នៅ កៀក បំផុត ដើម្បី ពិនិត្យ សុខភាព និង ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ឱ្យ បាន ត្រឹមត្រូវ ។
នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ ដោយ បាន ទទួល ការព្យាបាល យ៉ាង យកចិត្តទុកដាក់ ពី ក្រុម គ្រូពេទ្យ អ្នកជំងឺ កូវីដ១៩ ចំនួន ១៥នាក់ ស្រី ០៦ នាក់ បាន ជាសះស្បើយ និង ត្រូវបាន អនុញ្ញាតឱ្យ ចេញ ទៅ ផ្ទះ ដោយ ត្រូវ បន្ត ធ្វើចត្តាឡី ស័ក ដោយ ខ្លួន ឯង រយៈពេល ១៤ ថ្ងៃ ។
គិត មកដល់ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ខេត្ត កំពង់ធំ បាន រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ សរុប ចំនួន ២៦៧ នាក់ ស្រី ១៥៥ នាក់ ក្នុង នោះ បាន ជាសះស្បើយ ចំនួន ១១៥ នាក់ ស្រី ៥៦ នាក់ ។ អ្នកជំងឺ ដែល នៅសល់ ចំនួន ១៥២ នាក់ ស្រី ៩៩ នាក់ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត មន្ទីរពេទ្យ បង្អែក បារាយណ៍ - សន្ទុក មន្ទីរពេទ្យ បង្អែក ស្ទោង មណ្ឌល វិទ្យាល័យ ជា ស៊ីម ប្រឡាយ និង មណ្ឌល វិទ្យាល័យ ហ៊ុន សែន បល្ល័ង្ក ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត កំពង់ធំ៖ ក្រសួង ការពារ ជាតិ ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន កងទ័ព . គ្រួសារ កងទ័ព និង ប្រជាពលរដ្ឋ បាន ចំនួន ១. ២៤៣. ៤៣០ នាក់ ក្នុង នោះ តំបន់ ក្រហម ជាង ៩៣ម៉ឺន នាក់
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ស្នើ សហរដ្ឋ អាមេរិក ឱ្យ ពិនិត្យ ឡើងវិញ លើ កិច្ចព្រមព្រៀង ពាក់ព័ន្ធ នឹង ការបញ្ជូន ពលរដ្ឋ ខ្មែរ រស់នៅ លើ ទឹកដី អាមេរិក ឱ្យ ត្រឡប់មក កម្ពុជា វិញ នៅពេល ពួកគេ បាន ប្រព្រឹត្ត ទោសទណ្ឌ អ្វី មួយ នោះ ។
រាជ រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋាភិបាល អាមេរិក ធ្លាប់ បាន ចុះ កិច្ចព្រមព្រៀង បញ្ជូន និង ទទួលយក ពលរដ្ឋ ខ្មែរ ពី សហរដ្ឋ អាមេរិក ឱ្យ ត្រឡប់មក កម្ពុជា វិញ កាលពី ឆ្នាំ ២០០២ ។ កិច្ចព្រមព្រៀង នេះ រដ្ឋាភិបាល សហរដ្ឋ អាមេរិក នឹង បញ្ជូន ពលរដ្ឋ ខ្មែរ ណា ដែល ប្រព្រឹត្ត ល្មើស ឱ្យ ត្រឡប់មក មាតុភូមិ វិញ ក្រោយពេល អនុវត្ត ទោស រួចរាល់ ។
ប៉ុន្តែ កាលពី ចុង ឆ្នាំ ២០១៧ ការបញ្ជូន ពលរដ្ឋ ខ្មែរ ពី អាមេរិក ត្រូវបាន ខកខាន ដោយសារតែ សហរដ្ឋ អាមេរិក មិន ព្រម តាម សំណើ កម្ពុជា ដែល ស្នើ ឱ្យ កែប្រែ លក្ខខណ្ឌ មួយ ចំនួន នៅក្នុង កិច្ចព្រមព្រៀង នេះ ដោយ ឈរ លើ គោលការណ៍ ស្ម័គ្រចិត្ត ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន តវ៉ា ច្រើន លើ រឿង នេះ ដោយសារ សម្តេច បាន ចាត់ទុក លក្ខខណ្ឌ នេះ ជា ការពង្រាត់ គ្រួសារ ខ្មែរ ដែល រស់ នៅ លើ ទឹកដី អាមេរិក ។
លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ក្នុង ជំនួប ជាមួយ អនុ រដ្ឋមន្ត្រី ការបរទេស នៅ រសៀល នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ស្នើ រដ្ឋបាល លោក ប្រធានាធិបតី ចូ បៃ ដិន ពិចារណា លើ លក្ខខណ្ឌ នេះ ឡើងវិញ ។
បើ តាម លោក អ៊ាង សុផល្លែត . លោកស្រី អនុ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក បាន យល់ព្រម យក សំណើ របស់ សម្តេច តេជោ ហ៊ុន សែន ដាក់ ជូន លោក ចូ បៃ ដិន ពិនិត្យ និង ពិចារណា ៕
សម្តេច ចៅហ្វា វាំង ចែក ព្រះរាជ អំណោយ ដក់ កុមារ កំព្រា នៅ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ នា ឱកាស អបអរសាទរ ទិវា បុណ្យ កុមារ អន្តរជាតិ ១ មិថុនា ខួប លើក ទី ៧២ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះមហាក្សត្រ នៃ កម្ពុជា ព្រះអង្គ បាន ប្រោស ព្រះរាជ ទាន ព្រះរាជ អំណោយ ដល់ មជ្ឈមណ្ឌល បណ្តុះបណ្តាល និង ថែរក្សា កុមារ កំព្រា និង មណ្ឌលកុមារ កំព្រា ភូមិ ខៃស៍ នៃ អង្គការ ឧបត្ថម្ភ កុមារ កំព្រា ស្ថិត នៅ ភូមិ ទី១ ឃុំ ត្រែង ត្រយឹង ស្រុក ភ្នំ ស្រួច ខេត្ត កំពង់ស្ពឺ ដើម្បី បន្ត ចែក ដល់ កុមារ កំព្រា ១១៣ នាក់ និង អ្នកគ្រប់គ្រង ៣០ នាក់ ទៀត ។
ព្រះរាជ អំណោយ ខាងលើ ត្រូវបាន នាំយក ទៅ ប្រគល់ ដល់ មជ្ឈមណ្ឌល និង អង្គការ ទាំង ពីរ នេះ នា ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ ក្រោម វត្តមាន សម្តេច ចៅហ្វា វាំង គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង រួម ដំណើរ ដោយ លោក គុយ សុផល ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ និង ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក កិច្ចការ ទូទៅ អម ក្រសួង ព្រះបរម រាជ វាំង លោក ឈា ហន រដ្ឋមន្ត្រី អម ក្រសួង ព្រះបរម រាជ វាំង ព្រមទាំង មន្ត្រី សំខាន់ ៗ របស់ ក្រសួង ព្រះបរម រាជ វាំង ។
សម្តេច ចៅហ្វា វាំង បាន ពាំនាំ ព្រះរាជ បណ្តាំ សាកសួរ សុខទុក្ខ ព្រះរាជ ហឫទ័យ នឹករលឹក និង ស្រឡាញ់ ដ៏ ជ្រាលជ្រៅ បំផុត ពី ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះអង្គ សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជ ទាន ដល់ អ្នកគ្រប់គ្រង និង កុមារា កុមារី រស់ នៅ ក្រោម ការគ្រប់គ្រង របស់ អង្គការ ទាំង ពីរ នេះ ។
ព្រះរាជ គុណូប ក្ការៈ ដ៏ ធំធេង ដែល កូន ចៅ ចៅ ទួត មិន អាច បំភ្លេច បាន នោះ ព្រះករុណា ព្រះវរ រាជ បិតា ជាតិ ខ្មែរ ព្រះបរម រតន កោដ្ឋ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ បាន លើកស្ទួយ ដល់ សិទ្ធិ សេរីភាព របស់ កុមារ កម្ពុជា ដោយ បាន ឡាយ ព្រះហត្ថលេខា លើ អនុសញ្ញា របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី សិទ្ធិ សេរីភាព របស់ កុមារ កាលពី ខែកញ្ញា ឆ្នាំ ១៩៩២ ដើម្បី ទទួលយក សិទ្ធិ សេរីភាព ដ៏ ត្រឹមត្រូវ នេះ មក អនុវត្ត និង គាំពារ រក្សា កុមារ នៅក្នុង មាតុភូមិ កម្ពុជា ។
លើស ពី នេះ ព្រះអង្គ បាន យក ព្រះរាជ ហឬ ទ័យ ទុកដាក់ នៅ គ្រប់ ពេលវេលា ចំពោះ កុមារ កម្ពុជា ដូចជា ការប្រារព្ធ ព្រះរាជ ពិធី សំណេះសំណាល សាកសួរ សុខទុក្ខ ប្រោស ព្រះរាជ ទាន នូវ ព្រះរាជ អំណោយ ផ្សេង ៗ មាន ស្បៀងអាហារ សម្លៀកបំពាក់ សម្ភារៈ សិក្សា ថវិកា ជាដើម ប្រោស ព្រះរាជ ទាន ដល់ កុមារ នៅ តាម ទីកន្លែង នានា ជា បន្តបន្ទាប់ ។
ក្នុង ឱកាស ដ៏ ប្រពៃ នេះ ដែរ អ្នកគ្រប់គ្រង មាន រដ្ឋបាល មេ ដោះ និង គ្រូបង្រៀន ព្រមទាំង កុមារ កំព្រា បាន ថ្វាយ ព្រះសព្ទ សាធុការ ពរ ដ៏ បវរ មហា ប្រសើរ ថ្វាយ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត សូម ព្រះអង្គ មាន ព្រះរាជ សុខុមាលភាព ដ៏ ល្អ បរិបូរណ៍ ព្រះកាយ ពល មាំ មួន និង មាន ព្រះជន្មាយុ ជាង រយ ព្រះវស្សា ដើម្បី គង់ ប្រថាប់ នៅជា ម្លប់ ដ៏ ត្រជាក់ ដល់ ជន រួម ជាតិ ជា កូន ចៅ របស់ ព្រះអង្គ ជាដរាបត រៀង ទៅ ៕
អគ្គិភ័យ ឆេះ រោងចក្រ ច្រាង ហួរ នៅ ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល . កម្លាំង នគរបាល កំពុង អន្តរាគមន៍ បាញ់ ពន្លត់
( កណ្ដាល ) ៖ អគ្គិភ័យ បាន ឆាបឆេះ រោងចក្រ មួយ កន្លែង នៅ ភូមិ ព្រែក សំរោង៣ សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ហើយ នៅ ពេល នេះ កម្លាំង នគរបាល ពន្លត់ អគ្គិភ័យ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពុង ដុត ដៃ ដុត ជើង បាញ់ ពន្លត់ ។
សកម្មភាព នេះ ដឹកនាំ បាញ់ ពន្លត់ ផ្ទាល់ ពីសំណាក់ លោក ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត ស្នងការ នគរបាល ខេត្ត កណ្ដាល ព្រមទាំង មាន វត្តមាន លោក នូ សុវណ្ណារ៉ា អភិបាល ក្រុង តាខ្មៅ ផងដែរ ។
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជាមួយ លោកជំទាវ ឈរ ណារី ចំពោះ មរណភាព ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ត្រាំ អ៉ីវ តឹក
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា សូម ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ និង សោកស្តាយ ជា ទីបំផុត ជាមួយ លោកជំទាវ ឈរ ណារី ត្រាំ អ៉ីវតឹក ព្រមទាំង ក្រុមគ្រួសារ ទាំងអស់ ចំពោះ ការបាត់បង់ ឯកឧត្ដម ទេសរដ្ឋមន្រ្តី ត្រាំ អ៉ីវ តឹក ។
ការចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ចាត់ទុក ការបាត់បង់ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ត្រាំ អុីវ តឹក គឺជា ការបាត់បង់ នូវ ស្វាមី ប្រកបដោយ សង្គហធម៌ ដ៏ ល្អ និង ជា ការបាត់បង់ ឪពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ដ៏ ល្អ មួយ រូប ។
ស្ថិត ក្នុង មរណទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង សូមឲ្យ វិញ្ញាណក្ខន្ធ ឯកឧត្ដម ទេសរដ្ឋមន្ត្រី ត្រាំ អ៉ីវ តឹក បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ ធនាគារ ជាតិ នៃ កម្ពុជា បោះផ្សាយ សៀវភៅ របាយការណ៍ ស្ថានភាព ស្ថិរភាព ហិរញ្ញវត្ថុ ប្រចាំ ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា បាន បោះផ្សាយ សៀវភៅ របាយការណ៍ ស្ថានភាព ស្ថិរភាព ហិរញ្ញវត្ថុ ប្រចាំ ឆ្នាំ ២០២០ ដែល បង្ហាញ ពី ការអភិវឌ្ឍ នា ពេល ថ្មី ៗ ក្នុង វិស័យ ម៉ាក្រូ សេដ្ឋកិច្ច និង វិស័យ ហិរញ្ញវត្ថុ ព្រមទាំង បញ្ហា ប្រឈម ។
សៀវភៅ របាយការណ៍ ស្ថានភាព ស្ថិរភាព ហិរញ្ញវត្ថុ ប្រចាំ ឆ្នាំ ២០២០ នេះ ពិភាក្សា ពី ទស្សនវិស័យ និង ហានិភ័យ នា ពេល អនាគត ដែល វិស័យ ហិរញ្ញវត្ថុ នឹង ជួបប្រទះ ក្នុង អំឡុង ពេល ដែល មាន ភាព មិន ច្បាស់លាស់ នៃ សេដ្ឋកិច្ច ក្នុង ស្រុក ក្នុង តំបន់ និង ពិភពលោក ដោយសារ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
សៀវភៅ នេះ នឹង ត្រូវបាន ប្រើប្រាស់ ជា ឯកសារ យោង សម្រាប់ បុគ្គល បម្រើការ នៅក្នុង វិស័យ ហិរញ្ញវត្ថុ បញ្ញា វ័ន្ត ដៃគូ អភិវឌ្ឍន៍ និង ភាគី ពាក់ព័ន្ធ ដើម្បី ស្វែងយល់ ឱ្យ បាន កាន់តែ ច្បាស់ អំពី ស្ថានភាព ស្ថិរភាព ហិរញ្ញវត្ថុ នៅក្នុង ប្រទេស កម្ពុជា ។
សូម ជម្រាប ថា ឆ្នាំ ២០២០ ជា ឆ្នាំ ប្រកបដោយ បញ្ហា ប្រឈម ដោយ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បាន ជះ ឥទ្ធិពល ដល់ សេដ្ឋកិច្ច និង ទីផ្សារ ហិរញ្ញវត្ថុ ពិភពលោក ។ ដូច នឹង ប្រទេស ដទៃ ទៀត ដែរ ប្រទេស កម្ពុជា ត្រូវបាន ប៉ះពាល់ ខ្លាំង ដោយសារ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នេះ ដែល ធ្វើឱ្យ សេដ្ឋកិច្ច មាន កំណើន អវិជ្ជមាន បន្ទាប់ពី សម្រេចបាន កំណើន ជា មធ្យម ក្នុង រង្វង់ ៨ភាគរយ ក្នុង រយៈពេល ពីរ ទសវត្សរ៍ កន្លងមក នេះ ។
ទោះបីជា មាន ផល ប៉ះពាល់ ពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក៏ដោយ វិស័យ ធនាគារ នៅ កម្ពុជា បន្ត មាន ភាពធន់ ដោយសារ ការ ដាក់ចេញ វិធានការម៉ាក្រូ និង មីក្រូ ប្រុងប្រយ័ត្ន បុរេសកម្ម និង មាន ប្រសិទ្ធភាព ។
ក្នុង ស្ថានភាព មិន ច្បាស់លាស់ នេះ ធនាគារ ជាតិ នៃ កម្ពុជា បន្ត តាមដាន ជាប្រចាំ នូវ ការវិវត្ត ថ្មី ៗ និង ត្រៀមខ្លួន ដាក់ចេញ វិធានការ តាម ការចាំបាច់ ដើម្បី បន្ត រួមចំណែក គាំទ្រ សកម្មភាព សេដ្ឋកិច្ច ស្រប តាម គោល នរយោបាយ របស់ រាជ រដ្ឋាភិបាល ៕ ខេត្ត ព្រៃវែង រកឃើញ អ្នកវិជ្ជមាន កូវីដ ចំនួន ៦៥ នាក់ ទៀត នៅ មូលដ្ឋាន ក្រុង ស្រុក ចំនួន ៦
រដ្ឋបាល ខេត្ត ព្រៃវែង បាន ឱ្យដឹង ថា មូលដ្ឋាន ស្រុក ទាំង ៦ ដែល រកឃើញ ករណី វិជ្ជមាន ជំងឺ កូវីដ១៩ រួម មាន៖ ក្រុង ព្រៃវែង ចំនួន ១៣នាក់ . ស្រុក ព្រះស្ដេច ចំនួន ២៦ នាក់ . ស្រុក បាភ្នំ ចំនួន ១៤នាក់ . ស្រុក ពាម ជរ ចំនួន ៤នាក់ . ស្រុក មេសាង ចំនួន ៧នាក់ និង ស្រុក កំពង់ត្របែក ចំនួន ១នាក់ ។
បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ទាំង ៦៥ នាក់ ខាងលើ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង តាម មន្ទីរពេទ្យ បង្អែក ស្រុក នីមួយ ៗ ៕
អភិបាល ខណ្ឌ ច្បារអំពៅ៖ សាមគ្គីភាព ផ្ទៃក្នុង ល្អ ជា គ្រឹះ យ៉ាង សំខាន់ របស់ កងកម្លាំង ក្នុង ការបំពេញ កិច្ចការងារ បម្រើ ក្នុង មូលដ្ឋាន
( ភ្នំពេញ ) ៖ លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ បាន ណែនាំ ដល់ កម្លាំង ប្រជាការពារ ទាំងអស់ ត្រូវ បង្កើន នូវ សាមគ្គីភាព ផ្ទៃក្នុង ចេះ ស្រឡាញ់ ចេះ យកអាសា គ្នា ក៏ ដូចជា ការសហការ គ្នា ឱ្យ បាន ល្អ មុតមាំ បំផុត ដើម្បី ជា ស្នូល គ្រឹះ ក្នុង ការបំពេញ ភារកិច្ច ថែរក្សា ការពារ ពិសេស បម្រើ ដល់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ខណ្ឌ ច្បារអំពៅ ទាំងមូល ផងដែរ ។
ការក្រើន រំលឹក របស់ លោក អភិបាល ខណ្ឌ ធ្វើឡើង នា វេលា រសៀល ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ ក្នុង ពិធី ចែកជូន អំណោយ ជា ស្បៀងអាហារ និង ថវិការ មួយចំនួន ជូន ដល់ កម្លាំង ប្រជាការពារ ខណ្ឌ ៥០ នាក់ ដែល បាន ពាលីកម្លាំង បំពេញ ភារកិច្ច ក្នុង រយៈកាល កន្លងទៅ ។
ក្នុង ឱកាស ដដែល នោះ លោក អភិបាល ខណ្ឌ ចេង មុនីរ៉ា បាន កោតស សើរ ខ្ពស់ ដល់ កងកម្លាំង សន្តិសុខ ខណ្ឌ ដែល មាន លះបង់ កម្លាំង កាយ ចិត្ត និង ពេលវេលា ក្នុង ការបំពេញ ភារកិច្ច បម្រើ ដល់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន កន្លងមក ដោយ មិន ខ្វល់ខ្វាយ ពី ការហត់ នឿយ ពិសេស នោះ គឺ ការឃ្លាត ឆ្ងាយ ពី ក្រុមគ្រួសារ មួយ រយះ ធំ ក្នុង រយៈកាល នៃ វិបត្តិ កូវីដ១៩ ដែល ជា ពេលវេលា កាត់ផ្តាច់ ការជួបជុំគ្នា សូម្បីតែ ក្រុមគ្រួសារ ក៏ មិន អាច ជិតស្និទ្ធិ បាន ឡើយ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៨ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១ករណី . ជួញដូរ ៧ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ១៤នាក់ ។
( កំពត) ៖ រដ្ឋបាល ខេត្ត កំពត នៅ រសៀល ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស រកឃើញ មនុស្ស ចំនួន ៥៧ នាក់ បន្ថែម ទៀត ឆ្លង ជំងឺ កូវីដ១៩ ដែល ទើប រកឃើញ ថ្មី ក្នុង នោះ ភាគ ច្រើន ជា បុគ្គលិក កាស៉ីណូ ។
តាមរយៈ សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន រដ្ឋបាល ខេត្ត កំពត បញ្ជាក់ ថា អ្នកជំងឺ ទាំងអស់ នេះ ត្រូវបាន ដាក់ ឲ្យ សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល វិទ្យាល័យ ព្រះបិតា ជាតិ និង មណ្ឌល ព្យាបាល សុខ គីម ម៉េង ហើយ បច្ចុប្បន្ន ក្រុម ឆ្លើយតប បន្ទាន់ បាន និង កំពុង ស្រាវជ្រាវ រក ទីតាំង និង កំណត់ មុខ សញ្ញា អ្នក ពាក់ព័ន្ធ ក្នុង ករណី នេះ បន្ដ ទៀត ។
រដ្ឋបាល ខេត្ត កំពត សូម ធ្វើ ការអំពាវនាវ ដល់ អ្នក ពាក់ព័ន្ធ សូម ធ្វើចត្តាឡី ស័ក តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ប្រសិនបើ មាន បញ្ហា សុខភាព សូម ទៅ យក សំណាក នៅ សាលា វិទ្យាល័យ ព្រះបិតា ជាតិ ឬ មន្ទីរពេទ្យ បង្អែក ដែល នៅជិត បំផុត ៕ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ លោក ទេសរដ្ឋមន្រ្តី ត្រាំ អ៉ីវ តឹក
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ល្ងាច ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ លោក ត្រាំ អ៉ីវ តឹក ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ដែល បាន ទទួលមរណភាព នៅ រសៀល ថ្ងៃទី១ ខែមិថុនា នេះ ក្នុង ជន្មាយុ ៧៣ ឆ្នាំ ដោយ រោគា ពាធ ។
មន្ត្រី សាលាដំបូង ខេត្ត ព្រះវិហារ នាំ ស៊ីម៉ង់ ចំនួន ៤តោន ប្រគល់ ជូន បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត សម្រាប់ សាងសង់ បន្ទប់ ឃុំឃាំង
( ព្រះវិហារ ) ៖ លោក វុធ សាវី ព្រះរាជអាជ្ញា រង និង ជា អ្នកនាំពាក្យ នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ព្រះវិហារ នៅ ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ក្រុមការងារ នាំ ស៊ីម៉ង់ ចំនួន ៤តោន ប្រគល់ ជូន ទីបញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត សម្រាប់ សាងសង់ បន្ទប់ ឃុំឃាំង ជនសង្ស័យ ដែល ត្រូវបាន ឃាត់ខ្លួន ក្នុង ករណី ប្រព្រឹត្ត បទល្មើស ផ្សេង ៗ ។
លោក វុធ សាវី បាន ថ្លែង ថា ការចូលរួម ឧបត្ថម្ភ ជា ស៊ីម៉ង់ ជូន ទីបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ព្រះវិហារ សម្រាប់ កសាង បន្ទប់ ឃុំឃាំង ថ្មី នៅ ពេល នេះ គឺ ដោយសារ លោក មើលឃើញ ពី ការខិតខំ ប្រឹងប្រែង របស់ មន្ត្រី កងរាជអាវុធហត្ថ ខេត្ត ក្នុង ការបំពេញ តួនាទី ភារកិច្ច ប្រកបដោយ ការទទួលខុសត្រូវ ពិសេស លើ ការងារ បង្រ្កាប បញ្ហា បទល្មើស នានា នៅក្នុង ខេត្ត ។
លោក ព្រះរាជអាជ្ញា រង បាន ថ្លែង សង្កត់ធ្ងន់ ថា បន្ទប់ ឃុំឃាំង ជនសង្ស័យ ជា កក្តា ចាំបាច់ ណាស់ ។ ពេល ដែល សមត្ថកិច្ច ចាប់ បាន ជនសង័យ ក្នុង ករណី ប្រព្រឹត្ត បទល្មើស ណាមួយ ហើយ ពេល ដែល យកមក ឃុំឃាំង នៅ បន្ទប់ មួយ ដែល មិន មាន សុវត្ថិភាព ឫ គុណភាព ដោយសា បន្ទប់ ចាស់ ឌ្រុធ ទ្រោម ហើយ ចៃដន្យ ជនសង្ស័យ រត់គេចខ្លួន បាត់ ទៀត តើ អ្នកណា ជា អ្នកទទួលខុសត្រូវ ? ដូច្នេះ ការសាងសង់ បន្ទប់ ឃុំឃាំង ថ្មី នៅក្នុង បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត នៅ ពេល នេះ គឺ លោក សូម កោតសរសើរ និង ចូលរួម គាំទ្រ ផងដែរ ។
សូម បញ្ជាក់ ថា លោក វុធ សាវី ក្នុង រយៈពេល ខ្លី នៃ ការចូលកាន់ តំណែង ជា ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត ព្រះវិហារ ត្រូវបាន មហាជន វាយតម្លៃ ខ្ពស់ ពី ភាពសុក្រិត និង យុត្តិធម៌ លើ ការអនុវត្ត ច្បាប់ ពិសេស លើ ការបង្រ្កាប បទល្មើស នានា នៅក្នុង ខេត្ត ទទួលបាន ជោគជ័យ ។ ជាមួយនឹង ការងារ ស្នូល លើ ការអនុវត្តន៍ ច្បាប់ លោក ក៏ បាន ចូលរួម ក្នុង កិច្ចការងារ សង្គម ជាច្រើន ផងដែរ ដូចជា ការផ្តល់ អំណោយ ជូន ជន ក្រីក្រ ជាដើម ។
( សៀមរាប ) ៖ អភិបាល ខេត្ត សៀមរាប លោក ទៀ សីហា បាន ប្រាប់ ឱ្យ អាជ្ញាធរ មូលដ្ឋាន ទាំងអស់ ក្នុង ខេត្ត សៀមរាប ត្រូវ បញ្ឈប់ ជាបន្ទាន់ រាល់ ការចុះហត្ថលេខា ឬ ការបញ្ជាក់ ទទួលស្គាល់ លើ លិខិត ផ្ទេរ សិទ្ធិ ពាក្យ ស្នើសុំ កាន់កាប់ ប្រើប្រាស់ ដីធ្លី លិខិត ទិញ លក់ ដី រដ្ឋ និង ការបញ្ជាក់ លើ ប្លង់ បង្ហាញ ទីតាំង ដី ជា អាទិ៍ ដែល ធ្វើឡើង នៅលើ ដី ក្នុង តំបន់ ការពារ ធម្មជាតិ និង ក្នុង របៀប អភិរក្សា ជីវៈ ចម្រុះ ។
* ណែនាំ ទៅ រដ្ឋបាល ឃុំ សង្កាត់ ឲ្យ បញ្ឈប់ រាល់ ការចុះហត្ថលេខា បញ្ជាក់ លើ លិខិត ផ្ទេរ សិទ្ធិ ពាក្យ ស្នើសុំ កាន់កាប់ ប្រើប្រាស់ ដីធ្លី លិខិត ទិញ លក់ ដី រដ្ឋ ឬ ការបញ្ជាក់ លើ ប្លង់ បង្ហាញ ទីតាំង ដី ជា អាទិ៍ នៅលើ ដី ដែល ស្ថិត ក្នុង តំបន់ ការពារ ធម្មជាតិ និង របៀង អភិរក្ស ជីវៈ ចម្រុះ នៃ ដែន សមត្ថកិច្ច របស់ ខ្លួន
* ចាត់ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ តាម ផ្លូវ ច្បាប់ ចំពោះ រដ្ឋបាល ឃុំ សង្កាត់ ណា ដែល នៅតែ បន្ដ ចុះហត្ថលេខា បញ្ជាក់ លើ លិខិត ផ្ទេរ សិទ្ធិ ពាក្យ ស្នើសុំ កាន់កាប់ ប្រើប្រាស់ ដីធ្លី ជា អាទិ៍ នៅលើ ដី បាន កាប់ ឆ្ការ រុករាន ទន្ទ្រាន ដី ព្រៃ រដ្ឋ ដោយ ខុស ច្បាប់ ដើម្បី ធ្វើជា កម្មសិទ្ធិ ដែល នៅលើ ដី ដែល ស្ថិត ក្នុង តំបន់ ការពារ ធម្មជាតិ និង របៀង អភិរក្ស ជីវៈ ចម្រុះ នៃ ដែន សមត្ថកិច្ច របស់ ខ្លួន
* សហការ ជាមួយ មន្ទីរ បរិស្ថាន ខេត្ត ដើម្បី ចុះ ទប់ស្កាត់ ការចូល កាប់ ឆ្ការ រុករាន ទន្ទ្រាន ដី ព្រៃ រដ្ឋ ដើម្បី ធ្វើជា កម្មសិទ្ធិ ស្ថិត ក្នុង តំបន់ ការពារ ធម្មជាតិ និង ក្នុង របៀង អភិរក្ស ជីវៈ ចម្រុះ
* ពិនិត្យ ស្រាវជ្រាវ និង មោឃ ភាព ឯកសារ ទាំងអស់ ដែល រដ្ឋបាល ឃុំ សង្កាត់ បាន ចុះហត្ថលេខា នា ពេល កន្លងមក ដែល មាន ការពាក់ព័ន្ធ នឹង ការកាន់កាប់ និង ការផ្ទេរ សិទ្ធិ ទាំងឡាយ លើ ដីធ្លី ស្ថិត ក្នុង តំបន់ ការពារ ធម្មជាតិ និង ក្នុង របៀង អភិរក្ស ជីវៈ ចម្រុះ ត្រូវ ធ្វើ របាយការណ៍ ស្ដីពី ការអនុវត្ត ការងារ នេះ មក រដ្ឋបាល ខេត្ត ឲ្យបាន ជ្រាប ជា ប្រចាំ ៕
ការអំពាវនាវ របស់ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ធ្វើឡើង បន្ទាប់ពី មាន ប្រជាពលរដ្ឋ ដែល ចាក់ វ៉ាក់សាំង ដូសទី១ មួយចំនួន មិន ឃើញ ទៅ ចាក់ វ៉ាក់សាំង ដូស ទី២។
ក្នុង បទសម្ភាសន៍ ជាមួយ ក្រុម អ្នក ព័ត៌មាន ពេល ចុះ ពិនិត្យ ការចាក់ វ៉ាក់សាំង នៅ អតីត តំបន់ ក្រហម នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ឱ្យដឹង ថា មាន ប្រជាពលរដ្ឋ តិចតួច នៅ អតីត តំបន់ ក្រហម ដែល បាន ចាក់ ដូសទី១ រួចរាល់ ហើយ នោះ មិន ឃើញ មក ចាក់ វ៉ាក់សាំង ដូស ទី២។
លោក ឥត សារ៉ាត់ បាន គូសបញ្ជាក់ ថា ការចាក់ វ៉ាក់សាំង ដូស ទី២ មាន សារៈសំខាន់ ណាស់ ក្នុង ការបង្កើត ភាពសុាំ និង ធ្វើឱ្យ វ៉ាក់សាំង មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
សូម បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ៣១ ខែមិថុនា ការចាក់ វ៉ាក់សាំង នៅ អតីត តំបន់ ក្រហម ដែល ចាប់ផ្តើម កាលពី ថ្ងៃទី ០១ ខែឧសភា នោះ កងទ័ព ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ បាន ជាង ៩២ ម៉ឺន នាក់ ខណៈ ការចាក់ដូស ទី២ បាន ជាង ៦៧ ម៉ឺន នាក់ ។ ការចាក់ដូសទី១ នៅក្នុង អតីត តំបន់ ក្រហម គ្រោង នឹង បញ្ចប់ នៅក្នុង សប្តាហ៍ នេះ ៕ ខេត្ត ឧត្តរមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នក ឆ្លង ជំងឺ កូវីដ ចំនួន ១ករណី ទៀត ជា ករណី នាំចូល ពី ប្រទេស ថៃ
យោង សេចក្តីប្រកាស របស់ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ បាន បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ខេត្ត ឧត្តរមានជ័យ រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៥៥ករណី ក្នុង នោះ ករណី នាំចូល ពី ក្រៅ ប្រទេស ចំនួន ៥៣ ករណី និង ករណី ឆ្លង ក្នុង សហគមន៍ ២០កុម្ភៈ ចំនួន ២ករណី និង បាន ព្យាបាល ជាសះស្បើយ ចំនួន ១៦ករណី កំពុង សម្រាក ព្យាបាល ចំនួន ៣៩ ករណី ទៀត ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ៖ ចិន សម្រេចបាន ការចាក់ វ៉ាក់សាំង បង្ការ កូវីដ - ១៩ ជាង « ៦៦០ លាន ដូស » ជូន ប្រជាជន ទូទាំង ប្រទេស
កាកបាទ ក្រហម កម្ពុជា ឧបត្ថម្ភ ថវិកា ១លាន ដុល្លារ អាមេរិក ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា
( ភ្នំពេញ ) ៖ កាកបាទ ក្រហម កម្ពុជា ឧបត្ថម្ភ ថវិកា ១លាន ដុល្លារ អាមេរិក ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល នេះ ជា លើក ទី៤ ត្រូវ ជា ឆ្នាំ ទី១០ ( លើក ទី១០ ) គិត ចាប់តាំងពី ឆ្នាំ ២០១២មក សម្រាប់ មន្ទីរពេទ្យ កុមារ គន្ធ បុប្ផា ។
ជាពិសេស ក្រុម គ្រូពេទ្យ និង បុគ្គលិក នៃ មន្ទីរពេទ្យ កុមារ គន្ធ បុប្ផា ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង ផ្តល់ សេវាកម្ម សុខភាព ជូន ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ កម្ពុជា រាប់ ពាន់ ម៉ឺន នាក់ នៅ ទូទាំង ប្រទេស ។ ជាមួយគ្នា នេះ លោកស្រី បាន ជម្រាប ជូន អំពី សកម្មភាព កៀរគរ រក មូលនិធិ ក្នុង ទិវា ៨ឧសភា និង ការអនុវត្ត សកម្មភាព មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ក្នុង ការជួយ ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត និង រងគ្រោះ ដោយ គ្រោះ ដោយ ទឹក ជំនន់ នា ពេល កន្លងមក ។
ជា កិច្ច ឆ្លើយតប លោក រស់ សីល វ៉ា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ កាកបាទ ក្រហម កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ខិតខំ ស្វះស្វែងរក ការឧបត្ថម្ភ គាំទ្រ ពី សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន ហើយ បាន បន្ត ចូលរួមចំណែក ជាមួយ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល នេះ បាន បង្ហាញ ពី ការគិតគូរ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក្នុង ការលើកកម្ពស់ សុខុមាលភាព កុមារ ដែល ជា មូលធន មនុស្ស នៅ កម្ពុជា ។
ទន្ទឹមនឹង នេះ លោក បាន រៀបរាប់ ពី វឌ្ឍនភាព ការងារ របស់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ទាំង ក្នុង ទិដ្ឋភាព ប្រតិបត្តិការ និង ទិដ្ឋភាព ហិរញ្ញវត្ថុ ជាពិសេស ពាក់ព័ន្ធ នឹង ការកៀរគរ មូលនិធិ ដែល បាន និង កំពុង រង ផល ប៉ះពាល់ ពី ជំងឺ កូវីដ - ១៩ ដែល ធ្វើឱ្យ មាន ការថយចុះ នៃ ទំហំ ថវិកា បរិច្ចាគ ពីសំណាក់ សប្បុរសជន នានា ។
ជាមួយគ្នា នេះ លោក វេជ្ជ. Denis Laurent ក៏ បាន សម្តែង នូវ ការដឹង គុណ ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ជួយ ដល់ មន្ទីរពេទ្យ កុមារ គន្ធ បុប្ផា ជា បន្តបន្ទាប់ ជាពិសេស ក្នុង ស្ថានភាព ដ៏ លំបាក នៃ ការរាតត្បាត ជា សកល នៃ ជំងឺ កូវីដ - ១៩ នា ពេលនេះ ។ នេះ ជា ការឧបត្ថម្ភ ដ៏ ថ្លៃថ្លា សម្រាប់ ជួយសង្គ្រោះ អាយុជីវិត ដល់ កុមារ ទាំងអស់ កំពុង សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ កុមារ គន្ធ បុប្ផា ។
សូម បញ្ជាក់ ថា នេះ ជា លើក ទី៤ ដែល កាកបាទ ក្រហម កម្ពុជា បាន ផ្តល់ ថវិកា ១លាន ដុល្លារ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ហើយ ដែល ត្រូវ ជា ឆ្នាំ ទី១០ ( ១០លើក ) សម្រាប់ មន្ទីរពេទ្យ កុមារ គន្ធ បុប្ផា គិត ចាប់តាំងពី ឆ្នាំ ២០១២ បន្តបន្ទាប់មក ៕ អាជ្ញាធរ ខេត្ត បាត់ដំបង បើក កិច្ចប្រជុំ ពង្រឹង ការងារ ស្រាវជ្រាវ បង្រ្កាប បទល្មើស ឆ្លង ដែន ខុស ច្បាប់ គ្រប់ ប្រភេទ ក្នុង ភូមិសាស្រ្ត ស្រុក សំឡូត
( បាត់ដំបង ) ៖ លោក ណុប ដារ៉ា អភិបាល រង ខេត្ត និង ជា ប្រធាន ក្រុមការងារ ស្រាវជ្រាវ បង្រ្កាប បទល្មើស ឆ្លង ដែន គ្រប់ ភេទ តំណាង ឱ្យ លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង នៅ ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ បាន បើក ប្រជុំ ការងារ ដើម្បី ពិភាក្សា ស្រាវជ្រាវ បង្រ្កាប បទល្មើស ឆ្លង ដែន ខុស ច្បាប់ គ្រប់ ប្រភេទ នៅក្នុង ភូមិសាស្រ្ត ស្រុក សំឡូត ខេត្ត បាត់ដំបង ។
នៅក្នុង កិច្ចប្រជុំ នេះ សំដៅ ពង្រឹង បន្ថែម ទៀត ក្នុង ការស្រាវជ្រាវ បង្រ្កាប បទល្មើស ឆ្លង ដែន ខុស ច្បាប់ គ្រប់ ប្រភេទ ពិសេស ស្រាវជ្រាវ រក មេខ្យល់ ដែល នាំ ពលករ ចេញ - ចូល ប្រទេស ថៃ ក៏ ដូចជា នាំ ពលករ គេច ចេញ ពី ការធ្វើចត្តាឡី ស័ក ។
នា ឱកាស នោះ ដែរ លោក បាន កោតសរសើរ ដល់ កងកម្លាំង ជួរ មុខ គ្រប់ ប្រភេទ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត និង ឃ្លាត ឆ្ងាយ ពី គ្រួសារ ជា ទីស្រឡាញ់ ដើម្បី ជាតិ មាតុភូមិ ដោយ ឃើញ ផ្ទាល់ នូវ ទុក លំបាក របស់ កងកម្លាំង ជួរ មុខ នោះ លោក បាន សន្យា ថា នឹង ពាំនាំ បញ្ហា ប្រឈម ទាំង នេះ ជម្រាប ជូន ដល់ ថ្នាក់ដឹកនាំ ខេត្ត ដើម្បី ដោះស្រាយ ជូន ក្នុង ពេល ឆាប់ ៗ នេះ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ២. ៦៤៨. ៨៥៩ នាក់ ។
បើ តាម ការគូសបញ្ជាក់ របស់ អាជ្ញាធរ បាន ឲ្យដឹង ថា ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ទាំងអស់ ខាងលើ មាន តែ មួយ ករណី ប៉ុណ្ណោះ ដែល ជា ករណី នាំចូល ។ ចំណែក ២៥០ ករណី ទៀត ជា ករណី សហគមន៍ ។
បើ តាម លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ក្រោយ ជំនួប ថា សម្តេច តេជោ ហ៊ុន សែន បាន ស្នើ ទៅ លោកស្រី អនុ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក ឱ្យ រដ្ឋាភិបាល អាមេរិក ពិចារណា និង ដោះស្រាយ លើ បញ្ហា បំណុល ដែល កម្ពុជា ជំពាក់ អាមេរិក ក្នុង របប លន់ ណុល ជិត ៧០០ លាន ដុល្លារ ( ទាំង ការ និង ដើម ) ។
លោក អ៊ាង សុផល្លែត បាន បញ្ជាក់ ថា សម្តេច តេជោ បាន ស្នើ យន្តការដោះស្រាយ លើ បំណុល នេះ ចំនួន ៣លក្ខខណ្ឌ រួម មាន៖ ១៖ អនុញ្ញាតឱ្យ កម្ពុជា សង ប្រាក់ បំណុល បន្តិច ម្តង ៗ . ២៖ សង តាម កម្មវិធី រំលោះ ការប្រាក់ ត្រឹម មួយ ភាគរយ និង ទី៣៖ បង្វែរ បំណុល ជាង ៧០ ភាគរយ ទៅជា ជំនួយ អភិវឌ្ឍន៍ នៅ កម្ពុជា លើ វិស័យ អប់រំ វប្បធម៌ និង ដោះ មីន ក៏ ដូចជា គ្រាប់ យុទ្ធភ័ណ្ឌ មិន ទាន់ ។
លោក អ៊ាង សុផល្លែត បាន បញ្ជាក់ ទៀត ថា តប តាម សំណើ នេះ លោកស្រី អនុ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក បាន សន្យា យក សំណើ ទៅ ជូន លោក ចូ បៃ ដិន ពិនិត្យ និង ដោះស្រាយ ។
រដ្ឋាភិបាល សាធារណរដ្ឋ របស់ លោក សេនា ប្រមុខ លន់ នល់ បាន ជាប់ជំពាក់ បំណុល រដ្ឋាភិបាល អាមេរិក ប្រមាណ ២៧៤ លាន ដុល្លារ ដែល មកដល់ បច្ចុប្បន្ន បំណុល នេះ បាន ឡើង ដល់ ជិត ៧០០ លាន ដុល្លារ ហើយ ។ បំណុល របប សាធារណរដ្ឋ នា ពេល នោះ ភាគ ច្រើន យកមក បម្រើ លើ វិស័យ យោធា និង ការធ្វើ សង្គ្រាម ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន ចាត់ទុក បំណុល នេះ ជា បំណុល កខ្វក់ ប្រៀប ដូចជា ការយកញញ រមក ដំលើ ក្បាល ប្រជាពលរដ្ឋ កម្ពុជា ព្រោះ ថវិកា បម្រើ ឱ្យ វិស័យ យោធា នា ពេល នោះ បាន នាំ ដល់ ភ្លើង សង្គ្រាម និង បង្ក ទុក វេទនា ជាខ្លាំង សម្រាប់ ពលរដ្ឋ កម្ពុជា ។
សូម ជម្រាប ថា ក្នុង ជំនួប ជាមួយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នា ពេលនេះ លោកស្រី អនុ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក បាន បង្ហាញ ពី ការពេញចិត្ត ជាខ្លាំង ចំពោះ កិច្ចសហប្រតិបត្តិការ ជាមួយ កម្ពុជា លើ វិស័យ ជាច្រើន ដូចជា ការរុករក អដ្ឋិធាតុ ទាហាន អាមេរិក នៅ កម្ពុជា . កិច្ចសហប្រតិបត្តិការ ប្រយុទ្ធ ប្រឆាំង ភេរវកម្ម . សកម្មភាព មនុស្សធម៌ ដូចជា ការ ឱ្យ នាវា វេស្ទើ ដាម ចូល ចត ។
លោកស្រី អនុ រដ្ឋមន្ត្រី ការបរទេស ក៏ បាន លើកឡើង ពី ឱកាស ក្នុង ការ ក្នុង ការពង្រីក កិច្ចសហប្រតិបត្តិការ វិស័យ ប្រេង និង ឱស្ម័ន . ការវិនិយោគ លើ បញ្ហា ទឹក ហេដ្ឋារចនាសម្ព័ន្ធ . ថាមពល បៃតង និង បញ្ហា ដទៃ ទៀត ។
សម្តេច តេជោ ហ៊ុន សែន បាន ឯកភាព ចំពោះ អ្វី ដែល លោកស្រី អនុ រដ្ឋមន្ត្រី ការបរទេស បាន លើកឡើង ។ សម្តេច តេជោ ក៏ បាន អរគុណ អាមេរិក ដែល បាន ជួយ រក សន្តិភាព នៅ កម្ពុជា និង ការផ្តល់ ជំនួយ អភិវឌ្ឍ ទាំង ផ្ទាល់ និង ប្រយោល ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែង អបអរសាទរ សហរដ្ឋ អាមេរិក ដែល ទទួលបាន លទ្ធផល ល្អ ប្រសើរ លើ ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ៕
ឧកញ៉ា នួន អក និង ឧកញ៉ា សុខ រ៉ាដូ ថ្លែងអំណរគុណ លោក មេធាវី គី តិច ដែល ជួយ ផ្តល់ ការពិភាក្សា និង ប្រឹក្សា យោបល់ ផ្នែក ច្បាប់
( ភ្នំពេញ ) ៖ ឧកញ៉ា នួន អក និង ឧកញ៉ា សុខ រ៉ាដូ ព្រមទាំង សហការី បាន ថ្លែងអំណរគុណ ចំពោះ លោក គី តិច ប្រធាន ក្រុម មេធាវី រាជ រដ្ឋាភិបាល និង ជា ប្រធាន ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន ដែល បាន អនុញ្ញាត ពួកគេ ចូល ជួប សម្តែង ការគួរសម និង ជួយ ប្រឹក្សា យោបល់ ផ្នែក ច្បាប់ ។
ឧកញ៉ា ទាំង ពីរ បាន ចាត់ទុក ថា នេះ ជា ការទទួលស្វាគមន៍ ប្រកបដោយ ភាពកក់ក្តៅ និង មនោសញ្ចេតនា បំផុត ។
ឧកញ៉ា នួន អក និង ឧកញ៉ា សុខ រ៉ាដូ បាន ជូន ពរ លោក គី តិច និង សហការី ទទួលបាន នូវ សុខភាព ល្អ បរិបូរណ៍ កម្លាំង មាំ មួន និង ចៀស ផុត ពី ជំងឺ កាច សាហាវ កូវីដ១៩ ៕ លោកស្រី និន សា ផុន ប្រធាន គណៈកម្មការ ទី៩ នៃ រដ្ឋសភា ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ លោក ទេសរដ្ឋមន្រ្តី ត្រាំ អ៉ីវ តឹក
( ភ្នំពេញ ) ៖ លោកស្រី និន សា ផុន ប្រធាន គណៈកម្មការ សាធារណការ ដឹកជញ្ជូន ទូរគមនាគមន៍ ប្រៃសណីយ៍ ឧស្សាហកម្ម រ៉ែ ថាមពល ពាណិជ្ជកម្ម រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នៃ រដ្ឋសភា នៅ ល្ងាច ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ លោក ត្រាំ អ៉ីវ តឹក ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ដែល បាន ទទួលមរណភាព នៅ រសៀល ថ្ងៃទី១ ខែមិថុនា នេះ ក្នុង ជន្មាយុ ៧៣ ឆ្នាំ ដោយ រោគា ពាធ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត កោះកុង៖ លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន តែងតែ យកចិត្តទុកដាក់ ចំពោះ អនាគត របស់ កុមារ
( ប៉េកាំង ) ៖ លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន តែងតែ យកចិត្តទុកដាក់ ចំពោះ អនាគត របស់ កុមារ ។ លោក តែងតែ សម្តែង ការអបអរសាទរ ជាពិសេស ដល់ កុមារ ទូទាំង ប្រទេស ចិន ក្នុង ឱកាស ទិវា កុមារ អន្តរជាតិ ១ មិថុនា ។ លោក តែងតែ ទៅ ជួប ជាមួយ កុមារ និង យុវជន ដើម្បី បង្ហាញ ពី ការសួរសុខទុក្ខ និង ការយកចិត្តទុកដាក់ ត្រូវបាន កុមារ ចិន ហៅ យ៉ាង ស្និទ្ធស្នាល ថា “ លោក តាស៊ី ” ។
លោក ស៊ី ជីន ភីង កើត នៅក្នុង គ្រួសារ អ្នក បដិវត្តន៍ ការអប់រំ ក្នុង ផ្ទះ តឹងរឹង ជីវភាព នៅ កុមារភាព របស់ លោក គឺ សាមញ្ញ ណាស់ ។ កាលពី ឆ្នាំ ២០០៣ ពេល ផ្តល់ បទសម្ភាសន៍ ជាមួយ ទូរទស្សន៍ មជ្ឈិម ចិន លោក បាន រំលឹក ថា កាល នោះ ខោអាវ ដែល យើង ស្លៀកពាក់ ជាទូទៅ មាន បំណះ ជាច្រើន ហើយ ត្រូវ ស្លៀកពាក់ ខោអាវត ពី បង ប្រុស ស្រី ។
លោក ស៊ី ជីន ភីង មាន បងប្អូន ០៦ នាក់ ដូច្នេះ ពេល នៅ តូច ជាទូទៅ គាត់ ត្រូវ ស្លៀក ខោអាវ របស់ បង ស្រី ។ លោក បាន និយាយ ថា ខោអាវ និង ស្បែកជើង ដែល មាន ផ្កា ខ្ញុំ មិន ចង់ ពាក់ ជាដាច់ខាត ក៏ប៉ុន្តែ ត្រូវតែ ពាក់ ។
ក្នុង ចិត្ត របស់ កុមារ ចិន លោក ស៊ី ជីន ភីង ជា ឥស្សរជន ដែល ចេះដឹង ច្រើន ផង ហើយក៏ ជា លោក តា ដ៏ ស្និទ្ធស្នាល គ្នា គួរឱ្យ ស្រឡាញ់ រាប់អាន ផង ។ កាលពី ថ្ងៃទី ២១ ខែឧសភា ឆ្នាំ ២០១៣ លោក ស៊ី ជីន ភីង បាន ទៅ សួរសុខទុក្ខ ប្រជាជនរងគ្រោះ រញ្ជួយ ដី នៃ ក្រុង ឡូសាន ខេត្ត សឺឈួន ។
* ប្រាស្រ័យទាក់ទង
លោក ស៊ី ជីន ភីង បាន ផ្តាំផ្ញើ កុមារ ចិន ថា៖
ឧត្តម គតិ ជា សញ្ញា ធ្វើដំណើរ ក្នុង ឆាក ជីវិត របស់ មនុស្ស ។ មនុស្ស ម្នាក់ បើ ចង់ បង្កើត សមិទ្ធផល របស់ ខ្លួន ត្រូវ មាន ឧត្តម គតិ របស់ ខ្លួន ។ មនុស្ស ម្នាក់ អាច មាន ឧត្តម គតិ ជាច្រើន ប៉ុន្តែ ក្នុង នោះ អ្វី ដែល សំខាន់ បំផុត គឺ ត្រូវ ផ្សារភ្ជាប់ ជាមួយ មាតុ ប្រទេស និង ប្រជាជន ៕ គម្រោង កសាង ផ្លូវ លំ ទៅជា ផ្លូវ ក្រាល កៅស៊ូ ជិត ១២គីឡូម៉ែត្រ នៅក្នុង ឃុំ មេលំ ស្រុក បរិបូណ៌ បាន ចាក់ កៅស៊ូ ជាង ៣គីឡូម៉ែត្រ ហើយ ដែល នឹង បញ្ចប់ គម្រោង នៅ ឆ្នាំ ២០២៣
( កំពង់ឆ្នាំង ) ៖ គម្រោង កសាង ផ្លូវ លំ ប្រែក្លាយទៅជា ផ្លូវ ក្រាល កៅស៊ូ ជិត ១២គីឡូម៉ែត្រ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ នៅក្នុង ឃុំ មេលំ ស្រុក បរិបូណ៌ ពេលនេះ បាន ចាក់ កៅស៊ូ ប្រវែង ជាង ៣គីឡូម៉ែត្រ ហើយ ដែល នឹង បញ្ចប់ គម្រោ ង នៅក្នុង ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក កេត សុខា មេឃុំ មេ លំ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២១ នេះ បាន ប្រាប់ ឲ្យដឹង ថា ផ្លូវ មួយ ខ្សែ នេះ មាន ប្រវែង ១១គីឡូ៩០០ ម៉ែត្រ ឆ្លងកាត់ ឃុំ មេលំ ឃុំ ផ្សារ និង ឆ្លងកាត់ ភូមិ ចំនួន ៤ គម្រោង ផ្លូវ ខាងលើ នេះ គឺ កសាង ដោយ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ដែល មាន រយៈពេល កុងត្រា កសាង២ ឆ្នាំ គឺ ឆ្នាំ ២០២០ - ២០២១ នឹង ត្រូវ បន្ត ថែទាំ ១ឆ្នាំ ទៀត ដែល នឹង បញ្ចប់ គម្រោង នៅក្នុង ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
លោក មេឃុំ មេលំ បាន បន្ត ថា មកដល់ ពេលនេះ ក្រុមហ៊ុន កសាង បាន ជាង ៥០ ភាគរយ ហើយ ក្នុង ពេល នេះ ក៏ បាន ចាក់ កៅស៊ូ នៅក្នុង ភូមិ មេលំបាន ប្រវែង ជាង ៣គីឡូម៉ែត្រ ផងដែរ ដោយ នៅ៣ ដំណាក់កាល ទៀត ទើប កសាង ផ្លូវ នេះ រួចរាល់ ។
លោក មេឃុំ បាន បញ្ជាក់ ថា នៅពេល បញ្ចប់ គម្រោង កសាង ផ្លូវ នេះ ប្រជាពលរដ្ឋ មាន ផ្លូវ គឺ ពិតជា មាន ក្តីសង្ឃឹម ព្រោះ អាច ដឹក កសិផល នានា ពី ក្នុង មូលដ្ឋាន យ៉ាង ងាយស្រួល យក ទៅ លក់ដូរ នៅ ទីផ្សារ និង បាន ប្រើប្រា ស់ត កូន ត ចៅ ទៀតផង ។
ក្នុង នាម អាជ្ញាធរ ឃុំ តំណាង ឲ្យ ប្រជាពលរដ្ឋ លោក សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ពិសេស ប្រមុខ រាជ រដ្ឋាភិបាល ដែល បាន ជួយ គិតគូរ ដល់ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ជូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន គឺ ពេល មាន ផ្លូវ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ពិតជា តែ ធូរធាប្រសើរឡើង ៕
គ.ជ. ប បញ្ជាក់ អំពី គោលបំណង នៃ ការរៀបចំ ការបោះឆ្នោត សាកល្បង ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ កន្លងមក ថ្មី ៗ នេះ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន រៀបចំ កិច្ចប្រជុំ ពិគ្រោះយោបល់ តាម អនឡាញ ស្ដីពី ការបោះឆ្នោត សាកល្បង ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឆ្នាំ ២០២១ ។ ដូច្នេះ បាន បញ្ជាក់ អំពី គោលបំណង នៃ ការរៀបចំ ការបោះឆ្នោត សាកល្បង នេះ ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ។
បាន បញ្ជាក់ អំពី គោលបំណង សំខាន់ នៃ ការបោះឆ្នោត សាកល្បង គឺ ដើម្បី៖
សូម ជម្រាប ជូន ថា ប្រសិនបើ ការបោះឆ្នោត សាកល្បង នៅ ពាក់កណ្តាល ឆ្នាំ ២០២១ ដំណើរការ ល្អ ប្រកបដោយ សុវត្ថិភាព និង ប្រសិទ្ធភាព កម្មវិធី ទំនើបកម្ម នៃ ដំណើរការ នេះ នឹង យក ទៅ អនុវត្ត សម្រាប់ ការបោះឆ្នោត សកល នៅ ឆ្នាំ ២០២២ និង ឆ្នាំ ២០២៣ ៕ ខេត្ត ស្ទឹងត្រែង រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត កូវីដ ម្នាក់ ដែល ធ្វើដំណើរ មកពី ខេត្ត កណ្តាល
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន បាន ឱ្យដឹង ថា អ្នកជំងឺ កូវីដ១៩ ម្នាក់ នេះ មាន កូន តូច ៗ ចំនួន ៣នាក់ និង បាន ជិះ រថយន្ត ដឹក អ្នកដំណើរ ពី រាជធានី ភ្នំពេញ ឆ្ពោះ មក ខេត្ត ស្ទឹងត្រែង នៅ ចំណុច ក្បែរ ស្ពាន ព្រែក តា មាក់ នា ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ។ អ្នកជំងឺ ម្នាក់ នេះ ឈ្មោះ រិន បូរ៉ា ភេទ ស្រី អាយុ ៣៤ ឆ្នាំ មាន ស្រុក កំណើត នៅ ភូមិ អន្លង់ ស្លែង ឃុំ សំបួរ មាស ស្រុក មុខ កំពូល ខេត្ត កណ្តាល ៕
គ្រឿងចក្រ៤ គ្រឿង និង រថយន្ត បែន ដឹក ដី៦ គ្រឿង ដែល ធ្វើ សកម្មភាព ជីក កកាយ ដី ខុស ច្បាប់ នៅ ស្រុក រលាប្អៀរ ត្រូវបាន កងរាជអាវុធហត្ថ ចុះ ឃាត់ ប្រគល់ឲ្យ ជំនាញ
( កំពង់ឆ្នាំង ) ៖ គ្រឿងចក្រ ប្រភេទ អ៊ិច ស្កាវ៉ាទ័រ និង រថយន្ត បែន ដឹក ដី សរុប១០ គ្រឿង ព្រមទាំង ម្ចាស់ គ្រឿងចក្រ ម្នាក់ ត្រូវបាន កងរាជអាវុធហត្ថ ខេត្ត កំពង់ឆ្នាំង ឃាត់ ខណៈ កំពុង ជីក ក កាយ យក អាច ម៌ ដី ក្នុង បឹង ដោយ មិន មាន ច្បាប់ អនុញ្ញាត នៅ សង្កាត់ ផ្សារ ឆ្នាំង ស្ថិត ភូមិ ត្រពាំង អញ្ចាញ ឃុំ ស្វាយជ្រុំ ស្រុក រលាប្អៀរ ។
លោក វរសេនីយ៍ ឯក ហង់ សុជាតិ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត កំពង់ឆ្នាំង បាន បញ្ជាក់ ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ រសៀល ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ថា ការឃាត់ គ្រឿងចក្រ និង រថយន្ត បែន ដឹក ដី ដែល ធ្វើ សកម្មភាព ជីក និង ដឹក អាចម៍ ដី គ្មាន ច្បាប់ ខាងលើ នេះ ត្រូវបាន កងរាជអាវុធហត្ថ ខេត្ត ដឹកនាំ ដោយ រូប លោក ផ្ទាល់ ចុះ អនុវត្ត តាម បញ្ជា របស់ លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង ។
ក្នុង ប្រតិបត្តិការ នេះ កម្លាំង ក៏ បាន ឃាត់ ឈ្មោះ សោម សុម៉ាលីន អាយុ ៥៧ ឆ្នាំ ។ រីឯ គ្រឿងចក្រ ទាំងអស់ នេះ គឺ សមត្ថកិច្ច ចុះ ឃាត់ ពេល ដែល កំពុង ធ្វើ សកម្មភាព ជីក កកាយ ដី ជាក់ស្ដែង នៅ ចំណុច ខាងលើ ។ បន្ទាប់ពី ធ្វើ ការសាកសួរ រួច កងរាជអាវុធហត្ថ ក៏ បាន ប្រគល់ ជូន គ្រឿងចក្រ និង រថយន្ត បែន ដឹក ដី ព្រមទាំង ម្ចាស់ គ្រឿងចក្រ ទៅឲ្យ រដ្ឋបាល ជលផល ដើម្បី ចាត់ការ បន្ត ។
លោក បញ្ជាក់ ទៀត ថា ក្នុង ចំណោម អ៊ិច ស្កាវា ទ័រ ទាំង៤ គ្រឿង គឺ ២ គ្រឿង បាន ធ្វើការ ផាកពិន័យ រួចហើយ នៅ២ គ្រឿង ទៀត មិន ទាន់ ឃើញ ម្ចាស់ យក ឯកសារ ពាក់ព័ន្ធ មក បង្ហាញ ដល់ សមត្ថកិច្ច នៅឡើយ ទេ ៕
កាកបាទ ក្រហម កម្ពុជា ផ្តល់ វិភាគទាន ប្រចាំ ឆ្នាំ ចំនួន ១លាន ដុល្លារ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា
ជំនួប នេះ បាន ពិភាក្សា អំពី វឌ្ឍនភាព ការងារ របស់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា . មន្ទីរពេទ្យ គន្ធ បុប្ផា និង ការងារ សំខាន់ ៗ របស់ កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ការផ្តល់ វិភាគទាន ប្រចាំ ឆ្នាំ នូវ ថវិកា ចំនួន ១.០០០.០០០ ដុល្លារ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ផងដែរ នា រសៀល ថ្ងៃអង្គារ ៦រោច ខែ ជេស្ឋ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស .២៥៦៥ ត្រូវនឹង ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នៅ ទីស្នាក់ការ កណ្ដាល កាកបាទ ក្រហម កម្ពុជា ។
ក្នុង ជំនួប នេះ លោកស្រី ពុំ ចន្ទីនី បាន សម្ដែង នូវ សេចក្ដីសោមនស្ស រីករាយ និង ស្វាគមន៍ ប្រតិភូ នៃ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល ដឹកនាំ ដោយ លោក រស់ សីល វ៉ា រដ្ឋលេខាធិការ និង ជា នាយក ប្រតិបត្តិ នៃ មូលនិធិ . តំណាង ពី មន្ទីរពេទ្យ គន្ធ បុប្ផា . ព្រមទាំង តំណាង មូលនិធិ គន្ធ បុប្ផា ស្វីស ផងដែរ ។
ជាមួយគ្នា នោះ លោកស្រី អគ្គ លេខាធិការ ក៏ បាន ពាំនាំ នូវ ក្តី នឹករលឹក និង ការសួរសុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដល់ កុមារ ទាំងអស់ ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ គន្ធ បុប្ផា . ជាពិសេស ក្នុង ថ្ងៃ នៃ ទិវា កុមារ អន្តរជាតិ ១ មិថុនា នេះ សូមឲ្យ បាន ឆាប់ ជាសះស្បើយ ពី ជំងឺ ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោកស្រី ពុំ ចន្ទីនី បាន ជម្រាប ជូន អំពី សកម្មភាព កៀរគរ និង ទទួល ថវិកា សប្បុរស និង ការអនុវត្ត សកម្មភាព សប្បុរសធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា នា ពេល កន្លងមក ដូចជា ការចុះ ជួយ ដល់ បណ្តា ប្រជាជនរងគ្រោះ និង មាន ការលំបាក ផ្នែក ជីវភាព ជាពិសេស ក្នុង ខណៈពេល ដែល ជំងឺ កូវីដ - ១៩ បាន និង កំពុង រាតត្បាត ក៏ ដូចជា សកម្មភាព សំខាន់ ៗ ផ្សេង ៗ ទៀត រួម មាន ការចុះ ជួយ ដល់ បណ្តា ប្រជាជន រងគ្រោះ ដោយ ទឹក ជំនន់ នា ពេល កន្លងមក និង ប្រជាជន ដែល រងគ្រោះ ដោយ កត្តា ផ្សេង ៗ និង មាន ការលំបាក ផ្នែក ជីវភាព ។
បន្ថែម លើ សកម្មភាព មនុស្សធម៌ សំខាន់ ៗ ជាច្រើន ដែល កាកបាទ ក្រហម កម្ពុជា បាន និង កំពុង អនុវត្ត . ការបន្ត ជួយ ឧបត្ថម្ភ ថវិកា ប្រចាំ ឆ្នាំ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដើម្បី ជួយ សង្រ្គោះ ជីវិត កុមារ នៅ កម្ពុជា ក៏ នៅតែ ជា សកម្មភាព អាទិភាព សំខាន់ មួយ របស់ កាកបាទ ក្រហម កម្ពុជា ផងដែរ ។
លោកស្រី ពុំ ចន្ទីនី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន លោក រស់ សីល វ៉ា និង លេខាធិការដ្ឋាន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង និង ការយកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការអនុវត្ត ការងារ និង កៀរគរ មូលនិធិ ដើម្បី ទ្រទ្រង់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ក្នុង ការជួយសង្គ្រោះ កុមារ នៅ កម្ពុជា ។
លោក រស់ សីល វ៉ា បាន សម្តែង នូវ ការកោតសរសើរ និង សេចក្តី គោរព ថ្លែងអំណរគុណ ដ៍ ខ្ពង់ខ្ពស់ ចំពោះ ការដឹកនាំ ប្រកបដោយ ភាពឈ្លាសវៃ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ធ្វើឲ្យ កាកបាទ ក្រហម កម្ពុជា មាន ការរីកចម្រើន យ៉ាង ខ្លាំង និង បាន ក្លាយជា ស្ថាប័ន មនុស្សធម៌ ដ៏ រឹងមាំ មួយ នៅ កម្ពុជា ។
លោកស្រី ពុំ ចន្ទីនី ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ លោក រស់ សីល វ៉ា ដែល បាន ចំណាយ ពេលវេលា ក្នុង ការជួប ពិភាក្សា និង បាន ប្រគល់ ជូន នូវ ថវិកា ឧបត្ថម្ភ ប្រចាំ ឆ្នាំ ២០២១ ចំនួន ១.០០០.០០០ ដុល្លារ អាមេរិក របស់ កាកបាទ ក្រហម កម្ពុជា ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សម្រាប់ ប្រគល់ បន្ត ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ៕
មេដឹកនាំ បាតុករ ថៃ ត្រូវ ដោះលែង ឱ្យ នៅ ក្រៅ ឃុំ ក្រោយ ឆ្លង កូវីដ - ១៩ ក្នុង ពន្ធនាគារ
BREAKING: រដ្ឋបាល រាជធានី ភ្នំពេញ ប្រាប់ ម្ចាស់ សណ្ឋាគារ ភោជនីយដ្ឋាន ក្រុមហ៊ុន និង ម្ចាស់ អាជីវកម្ម គ្រប់ ប្រភេទ ត្រូវ ផ្ដល់ ព័ត៌មាន ជូន អាជ្ញាធរ នៅពេល បុគ្គលិក សុំ ច្បាប់ ឈប់ សម្រាក ដោយ សង្ស័យ មាន ជំងឺ កូវីដ
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ជូន ដំណឹង ដល់ ម្ចាស់ សណ្ឋាគារ ម្ចាស់ ភោជនីយដ្ឋាន ម្ចាស់ ក្រុមហ៊ុន នានា និង ម្ចាស់ អាជីវកម្មដ្ឋាន គ្រប់ ប្រភេទ ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ នៅពេល បុគ្គលិក របស់ ខ្លួន សុំ ការអនុញ្ញាត ឈប់ សម្រាក ពី ការងារ ត្រូវ ផ្ដល់ ឈ្មោះ អាយដ្ឋាន លេខ ទូរស័ព្ទ មក អាជ្ញាធរ មាន សមត្ថកិច្ច ដើម្បី ធ្វើ ការវាយតម្លៃ ស្វែក រក ពី ការឆ្លង ជំងឺ កូវីដ១៩ ជូន ពួកគាត់ ។
ជាមួយគ្នា នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ បាន បង្ហាញ លេខ ទូរស័ព្ទ សម្រាប់ ទំនាក់ទំនង នៅ តាម បណ្ដា ខណ្ឌ ទាំង ១៤ ដើម្បី ពួកគាត់ ងាយស្រួល ក្នុង ការផ្ដល់ ព័ត៌មាន ផងដែរ ៕
អាជ្ញាធរ ខេត្ត កោះកុង សម្រេច បិទ ខ្ទប់ ភូមិសាស្រ្ត ខ្លះ ក្នុង ភូមិ ចំនួន ៣ ក្នុង ស្រុក ស្រែ អំបិល ក្រោយ ផ្ទុក ជំងឺ កូវីដ១៩
( កោះកុង) ៖ រដ្ឋបាល ខេត្ត កោះកុង បាន បើ កិច្ចប្រជុំ ពិភាក្សា គណៈ បញ្ជាការ ឯកភាព ខេត្ត ដើម្បី សម្រេច បិទ ខ្ទប់ ភូមិ មួយចំនួន ក្នុង តំបន់ ភូមិសាស្ត្រ មាន ផ្ទុក ជំងឺ កូវីដ១៩ ស្រុក ស្រែ អំបិល ។
កិច្ចប្រជុំ ពិភាក្សា នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ ក្រោម វត្តមាន លោកស្រី មិថុនា ភូថង អភិបាល ខេត្ត និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត ដោយ មាន ការចូលរួម ពីសំណាក់ ពី ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត អភិបាល ក្រុង ស្រុក មេបញ្ជាការ កម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ និង អាជ្ញាធរ មូលដ្ឋាន ផងដែរ ។
លោក វេជ្ជបណ្ឌិត ទៅ ម៉ឹង ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត បាន លើកឡើង ថា អ្នក ដែល មាន ផ្ទុក ជំងឺ កូវិដ១៩ មាន ចំនួន ជាង ១០០ នាក់ ហើយ ភាគ ច្រើន ឆ្លង មកពី កម្មករ រោងចក្រ ផលិត ចំណី សត្វ ស្ថិត នៅក្នុង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
លោក បាន បញ្ជាក់ ថា ភូមិ ដែល មាន អ្នក ឆ្លង កូវីដ ច្រើន ជាង គេ គឺ ភូមិ សីលា ម្នាង ឃុំ ស្រែ អំបិល ដែល មាន អ្នក ផ្ទុក ច្រើន ជា ភូមិ ដទៃ ។ លោក បាន បញ្ជាក់ ថា ចំពោះ អ្នក ផ្ទុក ជំងឺ ក្នុង ភូមិសាស្រ្ត ស្រែ អំបិល ទាំងនេះ ក្រុម គ្រូពេទ្យ និង អាជ្ញាធរ អាច គ្រប គ្រង បាន ដោយ មិន អនុញ្ញាតឲ្យ ធ្វើដំណើរ ចេញ ពី ភូមិ ឡើយ ពោល ត្រូវ កំណត់ ឲ្យ គាត់ ធ្វើច ក្តាឡី ស័ក ១៤ ថ្ងៃ ក្នុង កម្រិត ១ ដើម្បី រង់ចាំ លទ្ធផល តេស្ត ពី មន្ទីរពិសោធន៍ វិទ្យាស្ថាន ប៉ាស្ទ័រ ។
លោក ហ៊ាង សុទ្ធា យុត្តិ បាន ឱ្យដឹង ទៀត ថា គិត មកដល់ ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២១ ចំពោះ ដំណោះស្រាយ ផល ប៉ះពាល់ ក្នុង ការសាងសង់ ផ្លូវ ល្បឿន លឿន ភ្នំពេញ - ព្រះសីហនុ បាន សម្រេច ៩៩. ៩% ស្មើនឹង ១៨៦. ៨៦ គីឡូម៉ែត្រ ហើយ ក្រសួង កំពុងតែ ខិតខំ ធ្វើ ការដោះស្រាយ បញ្ហា ដែល នៅ សេសសល់ ឱ្យ បាន រួចរាល់ ក្នុង ពេល ឆាប់ ៗ នេះ ។
អ្នកនាំពាក្យ វ័យ ក្មេង រូប នេះ បាន បន្ត ថា ទោះបីជា ប្រទេស កម្ពុជា ប្រឈម នឹង ការីករាលដាល នៃ ជំងឺ កូវីដ១៩ យ៉ាងណា ក៏ដោយ តែ ដំណើរការ សាងសង់ ផ្លូវ ល្បឿន លឿន នេះ នៅតែ បន្ត ដដែល មិន មាន ការប៉ះពាល់ នោះ ទេ ដោយសារតែ ក្រុមការងារ បុគ្គលិក កម្មករ ទាំងអស់ បាន ប្រឹង តស៊ូ ជំនះ នូវ ស្ថានភាព ដ៏ លំបាក នេះ បាន ។
* បំពាក់ គ្រឿង បរិក្ខារ ផ្លូវថ្នល់ រួម មាន ផ្លាក សញ្ញា ចរាចរណ៍ ភ្លើង សញ្ញា ចរាចរណ៍ និង គំនូស សញ្ញា ចរាចរណ៍ ៕ កូរ៉េ ខាងត្បូង ពង្រីក កិច្ចប្រឹងប្រែង ចាក់ វ៉ាក់សាំង បង្ការ កូវីដ - ១៩ ជាមួយ វ៉ាក់សាំង ១លាន ដូស ដែល បាន ពី អាមេរិក
អាជ្ញាធរ កូរ៉េ ខាងត្បូង បាន កំណត់ ប្រើប្រាស់ វ៉ាក់សាំង បង្ការ ជំងឺ COVID-19 របស់ ក្រុមហ៊ុន ផលិត ឱសថ អាមេរិក J&J សម្រាប់ មន្ត្រី ដែល ពាក់ព័ន្ធ នឹង វិស័យ យោធា រួម មាន កងកម្លាំង បម្រុង និង កង ការពារ ស៉ី វិល ផងដែរ ព្រមទាំង ប្រជាជន ដែល មាន គម្រោង ធ្វើដំណើរ ទៅ បរទេស ឬ បំពេញ បេសកកម្ម ការ ទូត ជាដើម ។ មនុស្ស ប្រហែល ៣. ៧លាន នាក់ ដែល មាន សិទ្ធិ ទទួល ការចាក់ វ៉ាក់សាំង នេះ ហើយ មនុស្ស ប្រហែល ៨០០.០០០ នាក់ ហើយ ដែល បាន ចុះឈ្មោះ ដើម្បី ទទួល ការចាក់ វ៉ាក់សាំង J&J គិត ត្រឹម ថ្ងៃអង្គារ នេះ ។
( កណ្តាល ) ៖ ក្រុម អាជីវករ នៅ ផ្សារ ស្អាង ខាងជើង រកស៊ី លក់ដូរ តាម កញ្ច្រែង ល្អី និង បាន ប្រាក់ ចំណេញ បន្តិចបន្តួច សម្រាប់ ផ្គត់ផ្គង់ ជីវភាព គ្រួសារ បាន នាំគ្នា ស្នើសុំ ឲ្យ អាជ្ញាធរ ស្រុក ស្អាង ខេត្ត កណ្តាល ជួយ ដោះស្រាយ ជូន ពួកគាត់ ដោយសារ មាន ប្រជាពលរដ្ឋ ដែល រស់ នៅ ជាប់ ផ្សារ ស្អាង ខាងជើង និង ជាប់ ផ្លូវ ជាតិ លេខ ២១ បាន នាំគ្នា វាស់ ម៉ែត្រ លើ ផ្លូវ បេតុង និង ចិញ្ចើមផ្លូវ លើ ការ៉ូឡា កំណត់ ឲ្យ ពួកគាត់ លក់ដូរ ហើយ គិត លុយ ពី ៤ ទៅ ៥ម៉ឺន រៀល ក្នុង មួយ ខែ ។
អាជីវករ ទាំង នេះ នៅ រសៀល ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ឲ្យដឹង ថា អាជ្ញាធរ បាន បិទ ផ្សារ ស្អាង ខាងជើង នេះ កាលពី ដើម ខែឧសភា ឆ្នាំ ២០២១ កន្លងមក ហើយ ករណី នេះ បាន កើតឡើង បន្ទាប់ពី អាជ្ញាធរ បាន បើក ដំណើរការ ឲ្យ អាជីវករ ចូលទៅ លក់ដូរ ក្នុង ផ្សារ នោះ វិញ កាលពី ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២១ ។
ក្រុម អាជីវករ បាន លើកឡើង ទៀត ថា ពួកគាត់ ជា ប្រជាពលរដ្ឋ ក្រីក្រ ណាស់ ជីវភាព សព្វ ថ្ងៃ ពឹងផ្អែក លើ ការលក់ តាម កញ្ច្រែង នេះ ហើយ ជីវភាព បច្ចុប្បន្ន កំពុងតែ ជួប ការលំបាក ខ្វះខាត ដោយសារ ការឆ្លង ជំងឺ កូវីដ១៩ លក់ដូរ មិន សូវ ដាច់ ផង ស្រាប់តែ ម្ចាស់ ផ្ទះ គេ មក វាស់ កន្លែង ដែល ពួកគាត់ លក់ដូរ រាប់ ឆ្នាំ មកហើយ នោះ គិត លុយ ក្នុង មួយ ខែ មួយ ម៉ែត្រ ការ៉េ ៥ ម៉ឺន រៀល ថែម ទៀត ។
អាជីវករ បាន បន្ត ទៀត ថា កាលពី មិន ទាន់ បិទ ផ្សារ ម្ចាស់ ផ្ទះ យក តែ ៣០០០០ រៀល តាមរយៈ ប្រធាន ភាស៊ី ផ្សារ ។ លុះ បន្ទាប់ពី បិទ ផ្សារ ហើយ អាជ្ញាធរ បើកឲ្យ ដំណើរការលក់ដូរ វិញ ស្រាប់តែ ម្ចាស់ ផ្ទះ មក វាស់ ផ្លូវ បេតុង បែងចែក ក្នុង មួយ ម៉ែត្រ ការ៉េ គិត លុយ ៥ម៉ឺន រៀល ក្នុង មួយ ខែ ។
ចំណែក អ្នកលក់ដូរ នៅ តាម ចិញ្ចើមផ្លូវ ២១ វិញ ក៏ ម្ចាស់ ផ្ទះ វាស់ គិត លុយ ដូចគ្នា តាម ម្ចាស់ ផ្ទះ អ្នក រស់ នៅ ជាប់ ផ្សារ ផងដែរ ។ ក្រុម អាជីវករ ក្រីក្រ បាន ស្នើសុំ ឲ្យ អាជ្ញាធរ ជួយ ដោះស្រាយ ករណី ម្ចាស់ ផ្ទះ វាស់ ផ្លូវ ជំរឹត ទារ លុយ នេះ ផង ។ លោក ប៉ោ សេង ម្ចាស់ ភាស៊ី ផ្សារ ស្អាង មិន អាច សុំ ការពន្យល់ ពី បញ្ហា នេះ បាន ទេ ដោយសារ លោក ឆ្លើយ ថា មិន ពាក់ព័ន្ធ នឹង ខាង ភាស៊ី ផ្សារ ទេ ៕ វៀតណាម កំពុង ព្យាយាម ទិញ « បច្ចេកវិទ្យា ផលិត វ៉ាក់សាំង កូវីដ - ១៩ » ដើម្បី យកមក ផលិត ចែកចាយ ក្នុង ស្រុក និង អន្តរជាតិ
រដ្ឋបាល កូរ៉េ ខាងត្បូង ផ្តល់ ឧបករណ៍ ធ្វើ រោគវិនិច្ឆ័យ កូវីដ១៩ តម្លៃ សរុប ៣០ម៉ឺន ដុល្លារ ជូន រាជ រដ្ឋាភិបាល កម្ពុជា
( ភ្នំពេញ ) ៖ រដ្ឋាភិបាល និង ប្រជាជន កូរ៉េ ខាងត្បូង ផ្តល់ នូវ កញ្ចប់ ឧបករណ៍ ធ្វើ រោគវិនិច្ឆ័យ ជំងឺ កូវីដ១៩ ដែល មាន តម្លៃ សរុប ប្រមាណ ៣០ម៉ឺន ដុល្លារ អាមេរិក ជូន ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ចូលរួមចំណែក ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នៅ កម្ពុជា ។
ពិធី ប្រគល់ និង ទទួល ជំនួយ ឧបករណ៍ វេជ្ជសាស្ត្រ នេះ ត្រូវបាន ធ្វើឡើង នៅ រសៀល ថ្ងៃអង្គារ ទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ។ ភាគី កូរ៉េ ខាងត្បូង អញ្ជើញ ជា តំណាង ដោយ លោក លោក ផាក ហ៊ឺង ខ្យង់ ឯក អគ្គ រដ្ឋទូត សាធារណរដ្ឋ កូរ៉េ ប្រចាំ ប្រទេស កម្ពុជា ហើយ ភាគី កម្ពុជា តំណាង ដោយ លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ។
ក្នុង ពិធី នោះ លោក ឯក អគ្គ រដ្ឋទូត បាន ថ្លែង កោតសរសើរ ដល់ រដ្ឋាភិបាល កម្ពុជា ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង ឥត ឈប់ឈរ ក្នុង ការឆ្លើយតប ទៅនឹង ការរីករាលដាល ជំងឺ កូវីដ១៩ ជាមួយ ការដាក់ចេញ វិធានការ នានា ដើម្បី កាត់បន្ថយ ការរីករាល ជំងឺ ។ ជាពិសេស ការប្រឹងប្រែង ចាក់ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ បាន រហូតដល់ ជាង ២. ៥លាន នាក់ ។
លោក ឯក អគ្គ រដ្ឋទូត បាន គូសបញ្ជាក់ ដែរ ថា ចាប់តាំងពី ការផ្ទុះឡើង នៃ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា ប្រទេស កូរ៉េ មិន បាន ស្ទាក់ស្ទើរ ក្នុង ការរួមដៃ គ្នា ជាមួយ កម្ពុជា ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង មេរោគ នេះ នោះ ឡើយ ។
ក្នុង ឱកាស នោះ លោក ឯក អគ្គ រដ្ឋទូត បាន បង្ហាញ នូវ ទំនុកចិត្ត ខ្ពស់ ថា ប្រទេស កម្ពុជា នឹង ទទួលបាន ជោគជ័យ ក្នុង ការយកឈ្នះ លើ ជំងឺ រាតត្បាត កូវីដ១៩ ហើយ រដ្ឋាភិបាល កូរ៉េ បន្ត ធ្វើ ការជិតស្និទ្ធ ជាមួយ កម្ពុជា ដើម្បី ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង ប្រទេស ទាំង ពីរ ។
លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន លើកឡើង ក្នុង ឱកាស នោះ ថា ចំណង មិត្តភាព ជា ប្រពៃណី កម្ពុជា - កូរ៉េ ត្រូវបាន ពង្រឹង និង ពង្រីក ឥត ឈប់ឈរ និង បាន ផ្តល់ ជំនួយ ឥត សំណង ជាច្រើន ក្នុង ការរួមចំណែក ធ្វើឱ្យ ប្រសើរឡើងវិស័យ សុខាភិបាល កម្ពុជា ។ ជាពិសេស ចាប់តាំងពី ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ កូរ៉េ បាន ផ្តល់ ជំនួយ ជា ឧបករណ៍ សម្ភារៈ បរិក្ខារ វេជ្ជសាស្ត្រ មួយចំនួន និង ថវិកា ។
លោក រដ្ឋមន្ត្រី បន្ត ថា ជំនួយ មនុស្សធម៌ របស់ ភាគី មិត្ត កូរ៉េ នា ថ្ងៃ នេះ នឹង រួមចំណែក ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា ។
លោក រដ្ឋមន្ត្រី ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន កូរ៉េ ជាពិសេស លោក ឯក អគ្គ រដ្ឋទូត កូរ៉េ ប្រចាំ នៅ កម្ពុជា ដែល បាន សម្របសម្រួល ឱ្យ ដំណើរការ រៀបចំ ប្រគល់ - ទទួល ជំនួយ នេះ បាន ប្រព្រឹត្ត ដោយ រលូន ។ លោកសង្ឃឹម យ៉ាង មុតមាំ ថា សាធារណរដ្ឋ កូរ៉េ នឹង បន្ត ផ្តល់ ជំនួយ ជា បន្តបន្ទាប់ ទៀត ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ២៨៩ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២១
បើ តាម អ្នកនាំពាក្យ . គិត ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី១ ខែមិថុនា ក្នុង ឆ្នាំ ២០២១ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៨៥.៧៣៩ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៦២.០៩២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២៣.៦៤៧ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ទូរស័ព្ទ ល្មើស សញ្ញា និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ស្លាកលេខ ទូរស័ព្ទ អត់ ខ្សែក្រវ៉ាត់ និង លើស ចំណុះ ជាដើម ។
កុមារ កំព្រា នៅ មណ្ឌល ថែទាំ ក្នុង ខេត្ត ស្វាយរៀង ទទួលបាន អំណោយ ពី លោកស្រី ម៉ែន សំអន ក្នុង ឱកាស ខួប លើក ទី ៧២ ទិវា កុមារ អន្តរជាតិ
( ស្វាយរៀង ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច និង ជា តំណាងរាស្ត្រ មណ្ឌល ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២០១ នេះ បាន នាំយក អំណោយ ចុះ សួរសុខទុក្ខ កុមារ កំព្រា ដែល កំពុង ស្នាក់ នៅក្នុង មណ្ឌល ថែទាំ កុមា កំព្រា ក្នុង ខេត្ត ស្វាយរៀង ក្នុង ឱកាស ខួប លើក ទី ៧២ ទិវា កុមារ អន្តរជាតិ ១មិថុនា ខួប លើក ទី២០ ទិវា ពិភពលោក ប្រឆាំង ពលកម្ម កុមារ ១២មិថុនា និង ទិវា កុមារ កម្ពុជា ឆ្នាំ ២០២១ ។
លោកស្រី ម៉ែន សំអន បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិតិ្ត ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ជានិច្ចកាល សម្តេច តែងតែ នឹក រលឹក ដល់ កុមារ កំព្រា ដែល បាន នឹង កំពុង ស្នាក់ នៅ គ្រប់ មណ្ឌល ថែទាំ កុមារ កំព្រា នៅ ខេត្ដ ស្វាយរៀង នេះ ក៏ ដូច នៅ ទូទាំង ប្រទេស ផងដែរ ។
គួរ បញ្ជាក់ ថា មក ទល់នឹង ពេលនេះ ទាំង សហរដ្ឋ អាមេរិក និង ដាណឺម៉ាក មិន ទាន់ បាន ផ្ដល់ ចម្លើយ ឬ ការបកស្រាយ ណាមួយ ឡើយ ឆ្លើយតប ទៅនឹង ការចុះផ្សាយ របស់ បណ្ដា សារព័ត៌មាន ធំ ៗ នៅ អឺរ៉ុប ជុំវិញ រឿង អាស្រូវ លួច យក ការណ៍ ពី សម្ព័ន្ធមិត្ត ខ្លួន ឯង ។ ប៉ុន្តែ ការបែកធ្លាយ រឿង អាស្រូវ នេះ កើត មាន ឡើង តែ ជាង ២សប្ដាហ៍ ប៉ុណ្ណោះ មុននឹង ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បំពេញ ដំណើរទស្សនកិច្ច ជា លើក ដំបូង របស់ លោក ទៅកាន់ តំបន់ អឺរ៉ុប ចាប់តាំងពី ជាប់ ឆ្នោត ជា ប្រធានាធិបតី មក ៕
ស .ស .យ . ក ខេត្ត ស្វាយរៀង ផលិត កម្មវិធី វង់ តន្រ្តី ខ្មែរ រដូវកាល ទី២ ក្នុង វិញ្ញាសា សិល្បៈ បុរាណ ចម្រុះ
( ស្វាយរៀង ) ៖ នៅក្នុង ឆ្នាំ ២០២១ នេះ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត ស្វាយរៀង បាន ផលិត កម្មវិធី វង់ តន្រ្តី ខ្មែរ រដូវកាល ទី២ ក្នុង វិញ្ញាសា សិល្បៈ បុរាណ ចម្រុះ ក្នុង គោលបំណង ចូលរួម លើកកម្ពស់ និង ផ្សព្វផ្សាយ ឧបករណ៍ តន្រ្តី ខ្មែរ គ្រប់ ទម្រង់ និង សិល្បៈ បុរាណ គ្រប់ ប្រភេទ ដែល ជា អត្តសញ្ញាណ ជាតិ ។
នេះ គឺជា ឱកាស ពិសេស សម្រាប់ បេក្ខជន បេក្ខ នារី និង ប្អូន កុមារ តូច ៗ ជា ទោល ឬ ក៏ ជា ក្រុម ទាំង ២៥ រាជធានី - ខេត្ត ក្នុង ប្រទេស កម្ពុជា ដែល មាន ទេពកោសល្យ សិល្បៈ បុរាណ បាន បង្ហាញ សមត្ថភាព របស់ គាត់ ។
ក្នុង ដំណើរការ នៃ ការប្រកួត នេះ ផងដែរ កម្មវិធី វង់ តន្ត្រី ខ្មែរ រដូវកាល ទី២ នឹង មាន ការចូល ធ្វើជា គណៈកម្មការ ពីសំណាក់ សាស្រ្តចារ្យ ផ្នែក សិល្បៈ ចំនួន ៤រូប ដែល មាន បទពិសោធន៍ រាប់ សិប ទសវត្ស នៅក្នុង វិស័យ សិល្បៈ បុរាណ ដូច ជា៖
លោក បណ្ឌិត សាស្ត្រាចារ្យ យន់ ខៀន ឯកទេស តន្រ្តី ខ្មែរ . លោកស្រី សាស្រ្តាចារ្យ អ៊ុក សុផា ឯកទេសចម្រៀង អាយ៉ៃ និង ចម្រៀង ចាប៉ី . លោក ព្រឿង ឈាង ឯកទេសរបាំ បុរាណ របាំ ប្រជាប្រិយ និង ល្ខោន ខោល និង លោកស្រី សាស្រ្តចារ្យ អ៊ុយ លតា វណ្ណ ឯកទេសចម្រៀង យីកេ និង ចម្រៀង បាសាក់ ។
គួរ បញ្ជាក់ ថា កម្មវិធី វង់ តន្រ្តី ខ្មែរ រដូវកាល ទី២ នេះ នឹង ចាប់ផ្តើម ទទួល វីដេអូ ប្រកួត ចាប់ពី ថ្ងៃ នេះ តទៅ រហូតដល់ ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២១ ។
អាជ្ញាធរ ខេត្ត ព្រៃវែង រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ២នាក់ ទៀត នៅ ស្រុក មេសាង
លោក បាន បន្ត ថា « បុគ្គល ប៉ះពាល់ ផ្ទាល់ ជាមួយ ឈ្មោះ វាន ឆៃ បាន វិជ្ជមាន កូវីដ១៩ យក សំណាក លើក ទី១ ចំនួន ១នាក់ លទ្ធផល អវិជ្ជមាន បុគ្គល ប៉ះពាល់ ផ្ទាល់ ជាមួយ ឈ្មោះ ហួន តំ វិជ្ជមាន កូវីដ១៩ យក សំណាក លើក ទី១ ចំនួន ១នាក់ លទ្ធផល អវិជ្ជមាន » ។
លោក ញ៉ែ ម សៅ គ្រី បាន បញ្ជាក់ ថា បុគ្គល ដែល វិជ្ជមាន ជំងឺ កូវីដ១៩ ទាំង ២នាក់ មាន ឈ្មោះ ដូច ខាងក្រោម៖
ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ បាន ចេញផ្សាយ នៅ រសៀល ថ្ងៃអង្គារ ទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ដោយ ដកស្រង់ សម្តី របស់ លោក Gao ពី កិច្ចសម្ភាសន៍ ខាងលើ នេះ ថា « ខ្ញុំ មិន គិត ថា ប្រទេស ចិន កំពុង បង្ក ការរាំងស្ទះ នោះ ទេ ។ ចិន គ្រាន់តែ មិន ស្វាគមន៍ អ្នក ទាំងឡាយ ណា ដែល កំពុង សម្លឹង ឃើញ ផលប្រយោជន៍ អំពី ការចោទប្រកាន់ ចិន ឬ ព្យាយាម ទាមទារ ឲ្យ ចិន ទទួលខុសត្រូវ ចំពោះ ជំងឺ រាតត្បាត សកល នេះ តែ ប៉ុណ្ណោះ » ។
តំណាងរាស្ត្រ មណ្ឌល ត្បូងឃ្មុំ និង អាជ្ញាធរ ខេត្ត ចុះ ត្រួតពិនិត្យ ប្រឡាយ ទឹក និង ទំនប់ ទ្វារ ទឹក ៥កន្លែង ប្រភព ប្រើប្រាស់ និង ស្រោចស្រព ដំណាំ ពលរដ្ឋ ក្នុង មូលដ្ឋាន ស្រុក ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ លោក ប្រាជ្ញ ចន្ទ តំណាងរាស្ត្រ មណ្ឌល ខេត្ត ត្បូងឃ្មុំ និង ជា ប្រធាន គណៈកម្មការ ទី១ នៃ រដ្ឋសភា ពេញ មួយ ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២១ បាន ដឹកនាំ អាជ្ញាធរ ខេត្ត អញ្ជើញ ចុះ ត្រួតពិនិត្យ ការសាងសង់ ប្រឡាយ ទឹក មួយ កន្លែង ប្រវែង២.៥០០ម៉ែត្រ និង ទំនប់ ទ្វារ ទឹក ចំនួន ៤កន្លែង ផ្សេង គ្នា ទៀត សម្រាប់ ប្រើប្រាស់ និង ស្រោចស្រព ដី ស្រែ និង ដំណាំ ប្រជាពលរដ្ឋ ចំនួន ៤ឃុំ រួម មាន ឃុំ ជីរោទ៍ ទី១ ឃុំ ពាម ជី លាំង ឃុំ ថ្ម ពេជ្រ និង ឃុំ គរ ក្នុង ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
ប្រព័ន្ធ ធារាសាស្ត្រ បម្រើ ឱ្យ វិស័យ កសិកម្ម នៅ មូលដ្ឋាន ស្រុក ត្បូងឃ្មុំ នេះ ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា តាមរយៈ ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ ។
ក្នុង ឱកាស ចុះ ពិនិត្យ ការសាងសង់ នោះ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក ហាក់ សុខ មករា . លោក កេង ប៊ុន ណា . លោក ពាង ណារិទ្ធ អភិបាល រង ខេត្ត . លោក សេង សុខ ខឿន អភិបាល ស្រុក . លោក អាន ស៊ីណា ប្រធាន មន្ទីរ អភិវឌ្ឍន ជនបទ ខេត្ត ប្រធាន - អនុប្រធាន មន្ទីរ ពាក់ព័ន្ធ ជុំវិញ ខេត្ត លោក មេឃុំ មេភូមិ ព្រមទាំង ប្រជាពលរដ្ឋ ។
មានប្រសាសន៍ សំណេះសំណាល លោក ប្រាជ្ញ ចន្ទ បាន លើកឡើង ថា ប្រឡាយ ទឹក និង ទំនប់ ទ្វា ទឹក ដែល បាន កំពុង ដំណើរការការ សាងសង់ នេះ គឺជា ការខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ ពីសំណាក់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ក្នុង ការស្ដារ ប្រព័ន្ធ ធារាស្ត្រ ឡើងវិញ សម្រាប់ ប្រើប្រាស់ ស្រោចស្រព ដំណាំ និង ទប់ទល់ គ្រោះ រាំងស្ងួត ជាពិសេស ជួយ ដល់ វិស័យ កសិកម្ម ពង្រីក ផ្ទៃដី ដាំដុះ សំដៅ លើកកម្ពស់ ជីវភាព និង កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ទាំងមូល ។
លោក ប្រាជ្ញ ចន្ទ បាន ជំរុញ និង លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ត្បូងឃ្មុំ ទាំងមូល ត្រូវ នាំគ្នា ដាំដុះ ដំណាំ រួមផ្សំ និង បន្លែ បង្ការ ផ្សេង ៗ ដើម្បី កាត់បន្ថយ ការចំណាយ និង រក ប្រាក់ ចំណូល បន្ថែម ជួយ ទ្រទ្រង់ ជីវភាព គ្រួសារ ។ ដោយឡែក មន្រ្តី ជំនាញ ត្រូវ ចុះ សិក្សា ផ្តល់ ប្រឹក្សា ផ្នែក បច្ចេកទេស ដល់ ប្រជាពលរដ្ឋ ពិសេស បែងចែក ថា តើ ត្រូវ ដាំ ដំណាំ បន្លែ អ្វី ដែល មាន ទីផ្សារ ល្អ និង ត្រូវ តាម រដូវកាល ដាំដុះ ក្នុង ដំណាក់កាល នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
អ្នកតំណាងរាស្ត្រ មណ្ឌល ត្បូងឃ្មុំ ក៏ បាន សំណូមពរ ដល់ អាជ្ញាធរ និង ប្រជាពលរដ្ឋ ទាំង ៤ឃុំ ត្រូវ រួមគ្នា ថែរក្សា សមិទ្ធផល ដល់ មាន តម្លៃ ទាំងនេះ ឱ្យ បាន គង់វង្ស យូអង្វែង សម្រាប់ ទុក ជា សម្បត្តិ រួម ដល់ ក្មេង ជំនន់ ក្រោយ បន្ត ទៀត ។
បើ តាម លោក អាន ស៊ីណា ប្រធាន មន្ទីរ អភិវឌ្ឍ ជនបទ ខេត្ត ត្បូងឃ្មុំ បាន ឱ្យដឹង ថា ប្រឡាយ និង ទំនប់ ទ្វា ទឹក ដែល លោក ប្រាជ្ញ ចន្ទ និង អាជ្ញាធរ ខេត្ត បាន ចុះ ត្រួតពិនិត្យ ស្ថិត ក្នុង ០៤ ឃុំ នៃ មូលដ្ឋាន ស្រុក ត្បូងឃ្មុំ រួម មាន៖
ខេត្ត បន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ ចំនួន ៣៩ នាក់ បន្ថែម ទៀត ជា ពលករ មកពី ប្រទេស ថៃ
ជាមួយ ការរក ឃើញ អ្នកជំងឺ កូវីដ១៩ ទាំង ៣៩ នាក់ នេះ ក៏ មាន អ្នកជំងឺ ចំនួន ៦៦ នាក់ បាន ជាសះស្បើយ សម្រាប់ ថ្ងៃទី ០១ ខែឧសភា នេះ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ៖ ខេត្ត ត្បូងឃ្មុំ រកឃើញ មនុស្ស ៣នាក់ បន្ថែម ទៀត ឆ្លង ជំងឺ កូវីដ១៩ ក្នុង នោះ មកពី ប្រទេស ថៃ ២នាក់
ក្នុង សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ បាន អំពាវនាវ ដល់ អ្នក ប៉ះពាល់ ដោយ ផ្ទាល់ សូម រួសរាន់ ទៅ ជួប ក្រុម គ្រូពេទ្យ និង ធ្វើចត្តាឡី ស័ក ដើម្បី យក សំណាក ទៅ ពិនិត្យ និង អ្នក ប៉ះពាល់ ដោយ ប្រយោល សូម ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ រៀង ៗ ខ្លួន ដោយ មិន ត្រូវ ពាក់ព័ន្ធ និង ប៉ះពាល់ ជាំ មួយ អ្នកដទៃ ជាដាច់ខាត ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង បន្ត រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ១៧នាក់ ដែល ទើប រកឃើញ ថ្មី
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ១៧នាក់ បន្ថែម ទៀត ភាគ ច្រើន ជា កម្មករ កម្ម ការិនី រោងចក្រ ដោយ ក្នុង នោះ មាន ជនជាតិ វៀតណាម ចំនួន ០៦ នាក់ ដែល ទើប រកឃើញ ថ្មី ប្រកាស ដោយ ក្រសួង សុខាភិបាល ។
បច្ចុប្បន្ន អ្នកជំងឺ កូវីដ១៩ ទាំងអស់ នេះ ត្រូវបាន បញ្ជូន ទៅ ព្យាបាល នៅ មណ្ឌល ព្យាបាល ជំងឺ កូវីដ១៩ បាវិត . មន្ទីរពេទ្យ បង្អែក ស្វាយ ជ្រំ និង មន្ទីរពេទ្យ បង្អែក សាមគ្គី រំដួល ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង ក៏ បាន អំពាវនាវ ដល់ អ្នក ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ឬ ប្រយោល ជាមួយ អ្នកជំងឺ កូវីដ១៩ និង ទីតាំង ( ក្នុង លិខិត របស់ រដ្ឋបាល ខេត្ត ) គិត ចាប់ពី ថ្ងៃទី ១៨ ខែឧសភា ឆ្នាំ ២០២១ ត្រូវ ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ រយៈពេល ១៤ ថ្ងៃ ដើម្បី តាមដាន សុខភាព ក្នុង ករណី មាន អាការ ខុស ប្រក្រតី ត្រូវ ផ្ដល់ ព័ត៌មាន ទៅ អាជ្ញាធរ មូលដ្ឋាន និង រួសរាន់ ទៅ យក វត្ថុ វិភាគ សំណាក ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត ស្វាយរៀង៖
ប័ណ្ណ ចាក់ វ៉ាក់សាំង សំខាន់ ណាស់ ! លោក ឥត សារ៉ាត់ អំពាវនាវ ថែរក្សា ឱ្យ បាន ល្អ (Video inside) ( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា ប្រធាន ប្រតិបត្តិការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្រសួង ការពារ ជាតិ បាន អំពាវនាវ ដល់ អ្នក ចាក់ វ៉ាក់សាំង រួចរាល់ ត្រូវ រក្សា ប័ណ្ណ ចាក់ វ៉ាក់សាំង កុំ ឱ្យ បាត់បង់ ដើម្បី ទុក ប្រើប្រាស់ ក្នុង ភាពចាំបាច់ ណាមួយ ទៅ ថ្ងៃ ក្រោយ ។
ការអំពាវនាវ របស់ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ធ្វើឡើង ក្នុង ពេល រូប លោក អញ្ជើញ ពិនិត្យ ដំណើរការចាក់ វ៉ាក់សាំង នៅ តាម ទីតាំង ចាក់ វ៉ាក់សាំង នៅ អតីត តំបន់ ក្រហម ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ថ្លែង ថា « ប័ណ្ណ វ៉ាក់សាំង នេះ យើង ធ្វើ សម្រិត សម្រាំង ល្អ ណាស់ ។ សូម ថែរក្សា ឱ្យ បាន ល្អ កុំ ឱ្យ បាត់បង់ ឱ្យ សោះ ព្រោះ ប័ណ្ណ ចាក់ វ៉ាក់សាំង នេះ អាច មាន ភាពចាំបាច់ ក្នុង ការប្រើប្រាស់ ទៅ ថ្ងៃ ក្រោយ ។ ក្នុង នោះ អាចនឹង ប្រើប្រាស់ សម្រាប់ ធ្វើដំណើរ ឆ្លង ទៅកាន់ ប្រទេស ណាមួយ ថែម ទៀត ផង ។ ដូច្នេះ ត្រូវ ថែទាំ វា តែ បាត់ ទៅ គឺ នាំឱ្យ យើង ពិបាក ធ្វើ ឡើងវិញ និង ខាត ពេលវេលា »៕ សម្តេច ក្រឡាហោម ស ខេង តែងតាំង មុខ តំណែង មន្ត្រី នគរបាល ជាតិ ២រូប នៃ នាយកដ្ឋាន ព្រហ្មទណ្ឌ
មន្ត្រី នគរបាល ទាំង២រូប នេះ រួម មាន៖
* ទី១៖ លោក វរសេនីយ៍ ត្រី ប៊ុន សុខ គង់ អត្តលេខ ៧២១០៥ ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល
* ទី២៖ លោក អនុ សេនីយ៍ ឯក ម៉ម គន្ធែល អត្តលេខ ៥៩៤៥៤ ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ សម្តេច ក្រឡាហោម ស ខេង៖
១៖ មន្ទីរ ទេសចរណ៍ រាជធានី ភ្នំពេញ ត្រូវ សហការ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ និង រដ្ឋបាល ខេត្ត កណ្តាល និង អាជ្ញាធរ មូលដ្ឋាន ជូនដំណឹង អំពី គោលការណ៍ អនុញ្ញាតឱ្យ បើក ដំណើរការ ប្រតិបត្តិការ អាជីវកម្ម ភោជនីយដ្ឋាន ជាធម្មតា ឡើងវិញ នេះ ឱ្យ ដល់ គ្រប់ មូលដ្ឋាន អាជីវកម្ម ទាំងអស់ ។ ជាមួយគ្នា នេះ ត្រូវ បន្ត ពិនិត្យ និង ពង្រឹង បន្ថែម ទៀត នូវ ការអនុវត្ត វិធាន សុវត្ថិភាព ទេសចរណ៍ និង រាល់ វិធានការ ជាធរមាន ចំពោះ អាជីវកម្ម សេវាកម្ម ស្នាក់ នៅ ទេសចរណ៍ ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ។
៦៖ ព្រម ជាមួយ វិធានការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ គ្រប់ មូលដ្ឋាន អាជីវកម្ម ខាងលើ ត្រូវ ពង្រឹង គុណភាព សេវាកម្ម ថែរក្សា បរិស្ថាន - អនាម័យ និង រក្សា តម្លៃ ផលិតផល និង សេវាកម្ម ឱ្យ បាន សមរម្យ ។
៧៖ គ្រប់ មូលដ្ឋាន អាជីវកម្ម ខាងលើ ត្រូវ អនុវត្ត សារាចរ នេះ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។ ករណី ខកខាន មិន បាន អនុវត្ត ឬ អនុវត្ត មិន បាន ត្រឹមត្រូវ តាម ខ្លឹមសារ សារាចរ ណែនាំ នេះ មន្ទីរ ទេសចរណ៍ មិន ត្រូវ អនុញ្ញាតឱ្យ អាជីវកម្ម នោះ បើក ដំណើរការ ជាដាច់ខាត និង អាច ប្រឈម ទៅនឹង វិធានការ ច្បាប់ ជាធរមាន ពិសេស ច្បាប់ ស្តីពី វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ និង ជំងឺ កាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ។
តម្លៃ ប្រេងឥន្ធនៈ លក់ រាយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៥ ខែមិថុនា៖ តម្លៃ សាំង ធម្មតា ៣. ៨០០ រៀល និង ម៉ាស៊ូត តម្លៃ ៣. ៤៥០ រៀល ក្នុង ១លីត្រ
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការកំណត់ ថ្លៃ ប្រេងឥន្ធនៈ ត្រូវ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២១ ដោយ សាំង ធម្មតា ត្រូវ លក់ តម្លៃ ៣. ៨០០ រៀល ក្នុង មួយ លីត្រ និង ម៉ាស៊ូត លក់ ក្នុង តម្លៃ ៣.៤៥០ រៀល ក្នុង ១លីត្រ៕
ក្រសួង បរិស្ថាន នឹង ប្រារព្ធ ទិវា បរិស្ថាន ជាតិ និង បរិស្ថាន ពិភពលោក ៥មិថុនា ក្រោម ប្រធានបទ « ជីវៈ ចម្រុះ និង សុខភាព មនុស្ស » តាម អនឡាញ
( ភ្នំពេញ ) ៖ ក្រសួង បរិស្ថាន នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង មួយ ស្តីពី ការរៀបចំ ទិវា បរិស្ថាន ជាតិ និង បរិស្ថាន ពិភពលោក ក្រោម ប្រធានបទ « ជីវៈ ចម្រុះ និង សុខភាព មនុស្ស » នៅ ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២១ តាមរយៈ ការផ្សព្វផ្សាយ នៅលើ បណ្តាញ ទំនាក់ទំនង សង្គម នានា របស់ ក្រសួង ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
សូម ជម្រាប ថា គិត ត្រឹម ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ កម្ពុជា មាន អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ កើន រហូតដល់ ២២០ នាក់ នៅ ទូទាំង ប្រទេស ៕ ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ ៣១ នាក់ បន្ថែម ទៀត សុទ្ធតែ កម្មករ រោងចក្រ ខណៈ ជាសះស្បើយ ៦០ នាក់
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៣១ នាក់ បន្ថែម ទៀត ដែល ក្នុង នោះ ភាគ ច្រើន ជា កម្មករ កម្ម ការិនី រោងចក្រ ។ ខណៈ អ្នក ជាសះស្បើយ ចំនួន ៦០ នាក់ ។
( ព្រៃវែង ) ៖ មន្ត្រី ជំនាញ សុខាភិបាល ស្រុក ពារាំង ខេត្ត ព្រៃវែង នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចុះ បិទ មន្ទីរ សម្រាក ព្យាបាល និង សម្ភព « ឌឹម ផល្លីន » ជា បណ្ដោះអាសន្ន ដោយ តម្រូវ ឱ្យ អ្នកជំងឺ រួម នឹង គ្រូពេទ្យ នៅ មន្ទីរ សម្រាក ព្យាបាល នៅក្នុង គ្លីនិក នេះ ទាំងអស់ ធ្វើចត្តាឡី ស័ក ក្នុង មន្ទីរ សម្រាក ព្យាបាល មិន ឱ្យ ចេញ ក្រៅ ឡើយ និង ផ្សារ ព្រៃ ព្នៅ ស្រុក ពារាំង ក្រោយ អ្នកជំងឺ ចូល ព្យាបាល និង ចូល ទិញ ទំនិញ ។
ករណី បិទ មន្ទីរ សម្រាក ព្យាបាល និង សម្ភព « ឌឹម ផល្លីន » បន្ទាប់ពី អ្នកជំងឺ កូវីដ១៩ ម្នាក់ បាន ស្លាប់ នៅ រសៀល ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២១ ម្សិលមិញ ខណៈ បាន បញ្ជូន បន្ត ទៅ សង្គ្រោះ នៅ ភ្នំពេញ ។
អ្នកជំងឺ កូវីដ១៩ ដែល ស្លាប់ ឈ្មោះ គង់ សារិទ្ធ ភេទ ប្រុស អាយុ ៥២ ឆ្នាំ នៅ ភូមិ ព្រែក ដំបង ឃុំ កំពង់ចំលង ស្រុក ខ្សាច់ កណ្តាល ខេត្ត កណ្តាល ( ស្លាប់ នៅ មន្ទីរពេទ្យ លោកសង្ឃ វិជ្ជមាន កូវីដ១៩ ) និង មាន អ្នក ឆ្លង ចំនួន ២នាក់ ផងដែរ ។
បើ តាម លោក វិជ្ជបណ្ឌិត ឌឹម ផល្លីន ម្ចាស់ មន្ទីរ សម្រាក ព្យាបាល និង សម្ភព « ឌឹម ផល្លីន » បាន លើកឡើង ថា អ្នកជំងឺ ដែល ស្លាប់ ខាងលើ គឺ បាន ចូល មក ព្យាបាល ក្នុង មន្ទីរពេទ្យ របស់ លោក រយៈពេល ៣យប់ ដោយ ពុំ ដឹង ថា រូប គាត់ វិជ្ជមាន កូវីដ១៩ នោះ ទេ ។
លុះ ដល់ ព្រឹក ទី ៣១ ខែឧសភា ឆ្នាំ ២០២១ អ្នកជំងឺ ឈ្មោះ គង់ សារិទ្ធ មាន ស្ថានភាព គួរឱ្យ សង្ស័យ និង ធ្ងន់ធ្ងរ ទើប លោក តម្រូវ ឱ្យ ទៅ ព្យាបាល បន្ត នៅ ភ្នំពេញ លុះ ដល់ រសៀល ថ្ងៃ ដដែល ស្រាប់តែ ឮ ព័ត៌មាន ថា គាត់ ស្លាប់ ហើយ ដោយ លទ្ធផល វិជ្ជមាន កូវីដ១៩ ទៀតផង ។
លោក បាន បន្ត ថា ចំពោះ ផ្សារ ព្រៃ ព្នៅ ត្រូវបាន ហ៊ុព័ទ្ធ និង រក អ្នក ដែល ពាក់ព័ន្ធ ទាំង ផ្ទាល់ និង ប្រយោល ដើម្បី ធ្វើចត្តាឡី ស័ក និង ធ្វើតេស្ត រក មេរោគ កូវីត១៩ ឱ្យ បាន ត្រឹមត្រូវ ផងដែរ ចំណែកឯ គ្លីនិក « ឌឹម ផល្លីន » វិញ ក៏ តម្រូវ ឱ្យ ធ្វើចត្តាឡី ស័ក ទាំង បុគ្គលិក ពេទ្យ និង គ្រួសារ ឌឹម ផល្លី មាន ចំនួន ១២នាក់ តែ ការធ្វើតេស្ត យក សំណាក លើក ទី១ គឺ អវិជ្ជមាន ទាំងអស់ ។
លោក អភិបាល ស្រុក ពារាំង ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល ដឹងខ្លួន ថា បាន ប៉ះពាល់ ជាមួយ អ្នកជំងឺ កូវីដ១៩ សូម ប្រញាប់ ទៅ ធ្វើតេស្ត ឱ្យ បាន ទាន់ ពេលវេលា ជៀសវាង ការចម្លង ដល់ អ្នកដទៃ ហើយ សូម បន្ត អនុវត្តន៍ វិធានការ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល « ៣ ការពារ និង ៣» កុំ បើ មិន ចាំបាច់ កុំ ចេញ ក្រៅ ផ្ទះ ជាដើម ៕ បញ្ជូន ជនជាតិ វៀតណាម ៥នាក់ ទៅ កន្លែង ត្រៀម បណ្ដេញចេញ ពី កម្ពុជា នៅ ខេត្ត សៀមរាប ក្រោយ ចាប់ខ្លួន បន្ទាប់ពី លួច ឆ្លង ដែន ខុស ច្បាប់
( ប៉ៃលិន ) ៖ ជនជាតិ វៀតណាម ៥នាក់ ត្រូវបាន កម្លាំង ស្នងការដ្ឋាន នគរបាល ខេត្ត ប៉ៃលិន បញ្ជូន ទៅ កន្លែង ត្រៀម បណ្ដេញចេញ ពី កម្ពុជា នៅ ខេត្ត សៀមរាប នា ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ ក្រោយ ចាប់ខ្លួន បន្ទាប់ពី លួច ឆ្លង ដែន ដោយ ខុស ច្បាប់ កាលពី ពេល កន្លងទៅ ។
របាយការណ៍ របស់ លោក ឧត្តមសេនីយ៍ ទោ សេង សុគន្ធ ស្នងការ នគរបាល ខេត្ដ ប៉ៃលិន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា ជនជាតិ វៀតណាម ទាំង ៥នាក់ នេះ បាន លួច ឆ្លង ដែន ចូល កម្ពុជា ដោយ ខុស ច្បាប់ តាម ច្រក របៀង ក្នុង ខេត្ត ស្វាយរៀង ហើយ ត្រូវបាន កម្លាំង សមត្ថកិច្ច ចាប់ខ្លួន ។
លោក ឧត្តមសេនីយ៍ ទោ សេង សុគន្ធ បាន ឲ្យដឹង ថា ជនជាតិ វៀតណាម នេះ បាន បញ្ចប់ ការធ្វើចត្តាឡី ស័ក នៅ មណ្ឌល ចត្តាឡី ស័ក កម្រិត ១ នៅ ផ្ទះសំណាក់ ភ្នំ យ៉ាត ស្ថិត ក្នុង ភូមិ តា ង៉ែន លើ សង្កាត់ ប៉ៃលិន ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។ បច្ចុប្បន្ន ពួកគេ ត្រូវបាន បញ្ជូន ទៅ ស្នាក់ ការត្រៀម បណ្ដេញចេញ នាយកដ្ឋាន ស៉ើប អង្កេត និង អនុវត្ត នីតិវិធី នៃ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ នៅ ខេត្ត សៀមរាប ៕
អាជ្ញាធ ក្រុង ដូន កែវ បិទ មន្ទីរ សម្រាក ព្យ បាល និង សម្ភព « សោ សុខុម » ជា បណ្ដោះអាសន្ន ក្រោយ អ្នកជំងឺ កូវីដ១៩ ចូល ព្យាបាល
( តាកែវ )៖ អាជ្ញាធ ក្រុង ដូន កែវ ខេត្ត តាកែវ នៅ ព្រឹក ទី១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន បិទ ជា បណ្តោះអាសន្ន ចំពោះ មន្ទីរ សម្រាក ព្យាបាល និង សម្ភព « សោ សុខុម » មន្ទីរពិសោធន៍ វេជ្ជសាស្ត្រ ដែល មាន ទីតាំង ស្ថិត នៅ ភូមិ ឡូរី សង្កាត់ រកា ក្នុង ក្រុង ដូន កែវ ខេត្ត តាកែវ បន្ទាប់ពី មាន អ្នកជំងឺ កូវីដ១៩ ម្នាក់ បាន ចូល សម្រាក ព្យាបាល នៅ កន្លែង នេះ ។
លោក កង អាណាន់ អភិបាល ក្រុង ដូន កែវ បាន ឱ្យដឹង ថា ការបិត មន្ទីរ សម្រាក ព្យាបាល « សោ សុខុម » ជា បណ្ដោះអាសន្ន បន្ទាប់ពី មាន អ្នកជំងឺ ម្នាក់ បាន ចូល សម្រាក ព្យាបាល នៅ កន្លែង នេះ កាលពី ថ្ងៃទី៣០ ខែឧសភា ហើយ បាន វិល ត្រលប់ ទៅ ផ្ទះ ក៏ ត្រូវបាន បញ្ចូន មក ព្យាបាល បន្ត នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ហើយ បាន ស្លាប់ នៅ មន្ទីរពេទ្យ ។ អ្នកជំងឺ ដែល ស្លាប់ ក៏ ត្រូវបាន ធ្វើតេស្ត ហើយ រកឃើញ មាន ផ្ទុក ជំងឺ កូវីដ១៩ ។
បើ តាម លោក អភិបាល ក្រុង ដូន កែវ បាន បន្ត យ៉ាង ដូច្នេះ ថា៖ « មន្ទីរ សម្រាក ព្យាបាល នេះ នឹង ត្រូវ ផ្អាក ជា បណ្ដោះអាសន្ន ហើយ អ្នក ពាក់ព័ន្ធ ត្រូវ ធ្វើចត្តាឡី ស័ក ទៅ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ហើយ នឹង ត្រូវ យក សំណាក ទៅ ពិនឹត្យ រក មេរោគ កូវីដ១៩ ផងដែរ »៕
ខាងក្រោម នេះ គឺជា ឈ្មោះ សម្គាល់ របស់ វីរុស បំប្លែង ខ្លួន ថ្មី ជា ភាសា ក្រិក៖
ក្នុង ដំណើរទស្សនកិច្ច នេះ ធ្វើឡើង ក្នុង រយៈពេល ខ្លី តែ ប៉ុណ្ណោះ ។ ក្រៅតែ ពី ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ហើយ នោះ លោកស្រី មិន មាន ជំនួប ជាមួយ រដ្ឋមន្ត្រី ការបរទេស កម្ពុជា ឬ ស្ថាប័ន អង្គការ សង្គម ស៊ីវិល នៅ កម្ពុជា នោះ ឡើយ ។
ក្រោយ បញ្ចប់ ជំនួប ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ រួចហើយ លោកស្រី អនុ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក រូប នេះ បន្ត ការហោះហើរ ទៅកាន់ ទីក្រុង បាងកក ប្រទេស ថៃ តែម្តង ដើម្បី បំពេញ ទស្សនកិច្ច នៅ ថៃ នា ថ្ងៃស្អែក នេះ ។
ស្ត្រី ទើប សម្រាល កូន ៤គ្រួសារ និង គ្រួសារ សព ៣គ្រួសារ ទទួលបាន អំណោយ ពី ក្រុមការងារ ចុះ ជួយ ភូមិ ព្រែក តា ពៅ សង្កាត់ ដើម មាន ក្រុង តាខ្មៅ
( កណ្ដាល ) ៖ ស្ត្រី សម្រាល កូន ៤គ្រួសារ និង គ្រួសារ សព ចំនួន ៣គ្រួសារ ទទួលបាន អំណោយ ពី លោក វ៉ែន សុវិន ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ភូមិ ព្រែក តា ពៅ ទី ០១ សង្កាត់ ដើម មាន ក្រុង តាខ្មៅ ខេត្ត កណ្ដាល ។
ពិធី ប្រគល់ អំណោយ នេះ ធ្វើឡើង នៅ ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២១ ដែល មាន ការចូលរួម ពី លោក ឯក សំណាង ចៅសង្កាត់ ដើម មាន និង លោក តុល ឡោះ មេភូមិ ព្រែក តា ពៅ ទី១ រួមទាំង អ្នក ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ផងដែរ ។
សូម បញ្ជាក់ ថា អំណោយ ដែល លោក វ៉ែន សុវិន ឧបត្ថម្ភ រូម មាន៖
* ទី១៖ ស្រ្ដី សំរាល បុត្រ ០៤ គ្រួសារ៖
* ទី២៖ សំរាប់ គ្រួសារ មរណៈភាព ចំនួន ៣គ្រួសារ រួម មាន៖
លោក ហុក រិទ្ធី នាយក ខុទ្ទកាល័យ របស់ លោក ត្រាំ អ៉ីវ តឹក បាន បញ្ជាក់ ថា លោក ត្រាំ អ៉ីវ តឹក បាន ទទួលមរណភាព មែន នៅ រសៀល ថ្ងៃទី ០១ ខែមិថុនា នេះ ។ ខណៈ ដែល ក្រុមគ្រួសារ សព បាន បញ្ជាក់ ថា លោក ត្រាំ អ៉ីវ តឹក ទទួលមរណភាព ដោយ រោគា ពាធ ។
លោក ត្រាំ អ៉ីវ តឹក អាយុ ៧៣ ឆ្នាំ គឺជា អតីត រដ្ឋមន្ដ្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង អតីត រដ្ឋមន្រ្តី ក្រសួង ប្រៃសណីយ និង ទូរគមនាគមន៍ ។ បច្ចុប្បន្ន ក្នុង តំណែង ជា ទេសរដ្ឋមន្ដ្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស លោក ត្រាំ អ៉ីវ តឹក ក៏ ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក កំពង់លែង ខេត្ត កំពង់ឆ្នាំង ផងដែរ ។
បើ តាម លោក ហុក រិទ្ធី . បច្ចុប្បន្ន សព របស់ ទេសរដ្ឋមន្ដ្រី ត្រាំ អ៉ីវ តឹក កំពុង តម្កល់ ធ្វើ បុណ្យ នៅ គេហដ្ឋាន ក្បែរ មន្ទីរពេទ្យ ខេមម៉ា ស្ថិត ក្នុង សង្កាត់ បឹងកក់១ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ។
ជាមួយគ្នា នេះ លោក សួន សេរី រដ្ឋា ក្នុង នាម ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ស្រុក កំពង់លែង ក៏ បាន បង្ហោះ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ ទេសរដ្ឋមន្ដ្រី ត្រាំ អ៉ីវ តឹក ផងដែរ ។ លោក បាន ចាត់ទុក ថា ការទទួលមរណភាព របស់ ទេសរដ្ឋមន្ដ្រី គឺជា ការបាត់បង់ ធនធាន មនុស្ស ដ៏ សំខាន់ មួយ រូប ផងដែរ ៕
ខេត្ត រតនគិរី រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ម្នាក់ ជា ពលករ មកពី ប្រទេស ថៃ និង ជាសះស្បើយ ៥នាក់
ក្នុង សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ថា អ្នកជំងឺ កូវីដ១៩ ម្នាក់ នេះ ឈ្មោះ ពេជ្រ ធីតា ភេទ ស្រី អាយុ ៣៨ ឆ្នាំ ជា ពលករ វិលត្រឡប់ មកពី ប្រទេស ថៃ ជាមួយ ប្តី ឈ្មោះ ឡេង វុទ្ធី ដែល រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ១៩ កាលពី ថ្ងៃទី ២៨ ខែឧសភា ឆ្នាំ ២០២១ ។ បច្ចុប្បន្ន នេះ អ្នកជំងឺ នេះ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មណ្ឌល វិទ្យាល័យ ត្រពាំងក្រហម ស្រុក កូនមុំ ។
បដិមា ព្រះពុទ្ធ ប្រក់ នាគ នៅ ប្រាសាទ ផ្ទី ត្រូវបាន ផ្គុំ ឡើងវិញ ក្រោយ បាក់បែក រាប់ រយ ឆ្នាំ
( សៀមរាប ) ៖ ព្រះពុទ្ធ បដិមា ដ៏ ធំ មួយ ក្នុង ទម្រង់ ព្រះកិរិយា សមាធិ ហើយ មាន ពស់ នាគរាជ ប្រក់ ពីលើ ស្ថិត នៅ ប្រាសាទ ផ្ទី នោះ ត្រូវបាន ក្រុមការងារ របស់ អាជ្ញាធរ ជាតិ អប្សរា បញ្ចប់ ការជួសជុល ជា ស្ថាពរ ហើយ ដោយ បាន ផ្គុំ បំណែក ថ្ម ឡើងវិញ ក្រោយ បែកបាក់ ធ្លាក់ចុះ ដល់ ដី រាប់ រយ ឆ្នាំ មកហើយ នោះ ។ ប្រាសាទ ផ្ទី នេះ ជា ប្រាសាទ តូច មួយ នៅ ចំ កណ្ដាល បារាយណ៍ នៃ ប្រាសាទ បេង មាលា ស្ថិត ក្នុង ភូមិ បេង មាលា ឃុំ បេង មាលា ស្រុក ស្វាយលើ ខេត្ត សៀមរាប ។
បើ តាម អាជ្ញាធរ ជាតិ អប្សរា ដែល បាន បញ្ជាក់ ប្រាប់ Fresh News នា ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ឱ្យដឹង ថា គម្រោង ជួសជុល ប្រាសាទ ផ្ទី នេះ ត្រូវបាន សម្រេច រួចរាល់ នៅ ចុង ខែឧសភា បន្ទាប់ពី ចាប់ផ្តើម ដំណើរការ នៅ ដើម ខែមេសា ។ នៅ ដើម ខែមីនា ការធ្វើ កំណាយ ពិនិត្យ រចនាសម្ពន្ធ ប្រាសាទ នេះ បាន ចាប់ផ្តើម និង ឈានដល់ ការជួសជុល លើក តម្លៃ ឡើងវិញ ក្រោម ការចូលរួម ពី វិស័យ ឯកជន គឺ លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម មយ៉ាន ក្នុង បំណង ដើម្បី ចូលរួម អភិរក្ស មរតក សម្បត្តិ បេតិកភណ្ឌ ជាតិ ។
បើ តាម ការបញ្ជាក់ ពី លោក គឹម សុធិន អគ្គ នាយក រង អាជ្ញាធរ ជាតិ អប្សរា ពី ដើម ឡើយ ប្រាសាទ នេះ បាន ដួលរលំ ឃើញ តែ គំនរ ដុំ ថ្ម ។ លោក ថា គម្រោង ជួសជុល នេះ មាន ការលំបាក បន្ដិច ដែរ ព្រោះ ការដ្ឋាន ស្ថិត នៅ កណ្ដាល បារាយណ៍ ក្នុង ព្រៃ ហើយ ផ្លូវ ធ្វើដំណើរ មាន ភាពតូច បន្ដិច ដែល ពិបាក ក្នុង ការដឹកជញ្ជូន ថ្ម តាម រថយន្ត ធុន ធ្ងន់ ។
( ភ្នំពេញ ) ៖ ជនសង្ស័យ ម្នាក់ ក្នុង ចំណោម បក្ខពួក ២នាក់ ត្រូវបាន សមត្ថកិច្ច ខណ្ឌ ដង្កោ ឃាត់ខ្លួន បន្ទាប់ពី ពួកគេ ឆក់ កាបូប ស្ពាយ ពី ស្ត្រី ម្នាក់ មិន បាន សម្រេច កាលពី វេលា ម៉ោង ១៩៖៣០ នាទី យប់ ថ្ងៃទី ៣១ ខែឧសភា ឆ្នាំ ២០២១ ស្ថិត នៅ ភូមិ ព្រៃ ធំ សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
លោក វរសេនីយ៍ ទោ ជាង ហុក សែ ឣធិការ រង ខណ្ឌ ដង្កោ ទទួល ផ្នែក នគរបាល យុត្តិធម៌ បាន ឱ្យដឹង ថា ជនសង្ស័យ ដែល ឃាត់ខ្លួន មាន ឈ្មោះ អោ សុខ ន ភេទ ប្រុស អាយុ ១៩ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ ជាង ភ្លើង ស្នាក់ នៅ បន្ទប់ ជួល សង្កាត់ កាកាប ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ( ជនសង្ស័យ មាន សារធាតុ ញៀន ) ។ ចំណែក ជនរងគ្រោះ ឈ្មោះ ឆុន ស៊ី ថា ត ភេទ ស្រី អាយុ ៥២ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ លក់ដូរ ទីលំនៅ ភូមិ ព្រៃ ល្ង សង្កាត់ ចោម ចៅ ទី១ ខណ្ឌ ពោធិ៍សែនជ័យ ។
ពេល នោះ ក៏ មាន កម្លាំង សមត្ថកិច្ច ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ព្រៃ ស ដែល កំពុង ជិះ ម៉ូតូ ល្បាត តាម ផ្លូវ បេតុង ៣០ម៉ែត្រ នោះ ស្រាប់ បាន ជួយ អន្តរាគមន៍ ធ្វើ ការឡោមព័ទ្ធ ចាប់ ឃាត់ខ្លួន បាន ជនសង្ស័យ ម្នាក់ យកមក ធ្វើ ការសាកសួរ នៅ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ព្រៃ ស តាម នីតិវិធី ច្បាប់ ។
ក្រោយពី ធ្វើ ការសាកសួរ ជនសង្ស័យ បាន ឆ្លើយ សារភាព ប្រាប់ សមត្ថកិច្ច ថា រូប គេ និង បក្ខពួក ពិតជា បាន ធ្វើ សកម្មភាព ឆក់ កាបូប លុយ របស់ ជនរងគ្រោះ ប្រាកដ មែន ហើយ ជនរងគ្រោះ ក៏ បាន មក ដាក់ ពាក្យ បណ្តឹង ចំ ឈ្មោះ អោ សុខុន និង បក្ខពួក ដើម្បីឱ្យ សមត្ថកិច្ច ចាត់ការ តាម ផ្លូវ ច្បាប់ តែម្តង ៕
ពលរដ្ឋ រងគ្រោះ ដោយសារ អគ្គិភ័យ ឆេះ ផ្ទះ ៣គ្រួសារ នៅ ស្រុក ស្អាង ទទួលបាន អំណោយ ពី សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល
( កណ្តាល ) ៖ លោកស្រី ខុន លក្ខិណា សមាជិកា គណៈកម្មាធិការ សាខា តំណាង លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល នៅ ថ្ងៃទី ០១ ខែមិថុនា ឆ្នាំ ២០២១ នេះ បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ចុះ ចែកជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ អគ្គិភ័យ ឆេះ ផ្ទះ ចំនួន ៣គ្រួសារ នៅ ឃុំ ព្រែក គយ ស្រុក ស្អាង ខេត្ត កណ្តាល ។
លោកស្រី ខុន លក្ខិណា បាន ពាំនាំ នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដោយ ក្ដី នឹករលឹក និង ក្តី អាណិតអាសូរ ជា ទីបំផុត ។
លោកស្រី បាន បន្ត ទៀត ថា កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន តែង មាន ការគិតគូរ ជានិច្ច អំពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ទូទៅ នៅ គ្រប់ ពេលវេលា និង ថែមទាំង បាន ណែនាំ ជា ប្រចាំ ដល់ មន្រ្តី នៅ ថ្នាក់ មូលដ្ឋាន ទាំងអស់ ត្រូវ ពិនិត្យមើល ពី ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ព្រមទាំង ចុះ សុខ ទុក្ខ ដល់ ជន ងាយ រងគ្រោះ និង ជនរងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ផ្សេង ៗ ដោយ មិន ប្រកាន់ ពូជសាសន៍ សាសនា ឬ និន្នាការ នយោបាយ ឡើយ ។
CCSA បាន គូសបញ្ជាក់ បន្ថែម ទៀត ថា ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ អ្នកជំងឺ ចំនួន ៣៨ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ នៅក្នុង រយៈពេល ២៤ ម៉ោង កន្លងទៅ ដូចគ្នា ដែរ ។
គ.ជ. ប ជូនដំណឹង ពី ការដាក់ និង ការទទួល ពាក្យ សុំ ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ អ្នកសង្កេតការណ៍ ជាតិ និង អន្តរជាតិ សម្រាប់ ការបោះឆ្នោត សាកល្បង ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឆ្នាំ ២០២១
