ជា ភូមិសាស្ត្រ វា មាន ទំហំ ប្រមាណ ១២.
បុរសៈ កុំ សង្ឃឹម អី លោក ព្រោះ ខ្ញុំ គឺជា កូន កម្លោះ ក្នុង មង្គលការ នោះ !
ហេតុ ដូចនេះ មាន ប្រជាជន ជាច្រើន មកពី ប្រទេស នានា បាន ធ្វើ ចំណាកស្រុក ទៅ រស់ នៅក្នុង សហរដ្ឋ អាមេរិក ។
លោក បញ្ជាក់ ទៀត ថា សមយុទ្ធ នេះ ជា គំនិត ផ្តួចផ្តើម របស់ លោក ផ្ទាល់ ។
ហេតុ អ្វី សម្តេច ថ្លែង ថា ដំរី ជល់ គ្នា ងាប់ ស្រមោច ស្រអា
ពេញ មួយ សប្តាហ៍ មក នេះ គ្មាន ថ្ងៃ ណាមួយ ដែល លោក ដូណាល់ ត្រាំ មិន បញ្ចេញ ពាក្យ គំរាម ទាក់ទង នឹង កូរ៉េ ខាងជើង ទេ !
ទំព័រ ដើម សហគ្រិន ភាព តើ អ្នក យល់ ថា អតិថិជន របស់ អ្នក មាន អ្វី ខ្លះ ដែល ជា តម្រូវការ មូលដ្ឋាន របស់ ពួកគេ ?
យើង មិន ចាំបាច់ មាន កាតព្វកិច្ច និង ទំនួល ខុសត្រូវ ដែល មនុស្ស ពេញ វ័យ មាន ទេ ។
កម្ពុជា មាន សក្តានុពល ច្រើន សម្រាប់ ការអភិវឌ្ឍ នៅក្នុង តំបន់ ដ៏ រីកចម្រើន នេះ ។
លោក មាន គ្រួសារ និង មាន បុត្រ ចំនួន ០៣ នាក់ ។
ខ្ញុំ មិន ល្ងង់ ឈប់ កាន់អំណាច នៅ អាយុ ៦៥ ឆ្នាំ ទេ
ព្រឹត្តិការណ៍ នេះ នឹង កើតឡើង នៅ ថ្ងៃពុធ ហើយ នឹង មាន ការធ្វើ បាតុកម្ម តូច ៗ
រង់ចាំ ទទួល បម្រើ ដឹកជញ្ជូន ភ្ញៀវ ។
យើង ឃើញ ថា មាន ការផ្សព្វផ្សាយ របស់ ក្រសួង ដ៏ ដូចជា អង្គការ ស្ថាប័ន ផ្សេង ៗ
ទ្វារមាស គឺ បើក ដែល បន្ត មាន នៅក្នុង ខ្លួន ដូច ទៅនឹង បំពង់ ។
បញ្ហា លើ រថយន្ត អាច កើតមាន គ្រប់ ពេល ដែល អ្នកបើកបរ ត្រូវ ដឹង ។
និង ព្រះចេស្តា ដ៏ ខ្លាំង ពូកែ
ដូច្នេះ ការបោះឆ្នោត នោះ មិន ត្រូវ ចាំ ដល់ ឆ្នាំ ២០១៨ ឡើយ ។
ទំព័រ ដើម វិវាទ និង អាជ្ញា កណ្តាល
នេះ ជាបញ្ជី គំនិត ដើម្បីឱ្យ អ្នក ចាប់ផ្តើម ។
បើ នាង មិន ប្រឡូក សិល្បៈ ក៏ បាន ដែរ ព្រោះ ក្រុមគ្រួសារ នាង ជា អ្នករកស៊ី អាច ស្ទួយ ជីវភាព រស់ នៅ បាន ។
តុលាការ កំពូល លោក សម្លាប់ ខ្ញុំ ទៅ ត្រូវការ យុត្តិធម៌ តុលាការ ។
យើង ពុំ ត្រូវការ ស្ថានទូត មួយ របស់ សហរដ្ឋ អាមេរិក ឡើយ ។
ក្លាយជា ស្តេច ព្រៃ នេះ ហើយ អញ ស៊ីទន្សាយ ទាំងអស់ នេះ បាន ។
តែ រយៈពេល ប៉ុន្មាន ទសវត្សរ៍ ថ្មី ៗ
សិស្ស វិទ្យាល័យ ថើប គ្នា លេង នៅ ម៉ោង សម្រាក
រូបភាព វា នឹង វិលត្រឡប់ ទៅ កំណើត ដើម វិញ ។
ដូចនេះ ខ្ញុំ សង្ឃឹម ថា ថ្ងៃ ណាមួយ ពួកគាត់ នឹង យល់ ច្បាស់ ហើយ ស្វែងរក មធ្យោបាយ តាម ការបង្រួបបង្រួម ជាតិ ។
ប្រសិនបើ ជីវិត ផ្លូវភេទ របស់ អ្នក មិន សូវ ជា ល្អ ទេ វា នឹង បង្កអោយ មាន បញ្ហា ផ្សេង ៗ
ស្មាតហ្វូន មួយ ណា ខ្លាំង ជាង ?
មិន មាន វិធី អ្វី ដើម្បីឱ្យ គាត់ ចាកចេញ បាន ទេ ។
ដូច្នេះ យើង គ្រប់ គ្នា គួរតែ ត្រូវ យល់ដឹង ពី ពាក្យ ថា អត្ថន័យ នៃ ពាក្យ សុជីវធម៌ មាន ន័យ ដូចម្តេច ?
គ្រាន់តែ ប្រាក់ខែ កម្មករ ១៧៧ ដុល្លារ ក៏ រដ្ធាភិបាល មិន អាច អោយ បាន
ខ្ញុំ មានអារម្មណ៍ ថា ឯកោ ព្រោះ គ្មាន គ្រួសារ នៅ ទំនុកបម្រុង នឹង គេ ។
កំពុង គិត ដូច្នោះ កែវ មណី ធីតា លេច ចូលមក ។
ចិន បង្ហោះ ផ្កាយ រណប ចំនួន ពីរ សម្រាប់ ធ្វើ ពិសោធន៍ វិទ្យាសាស្ត្រ
ការបកប្រែ កំពុង ដំណើរការ ។
សេចក្តីរាយការណ៍ បន្ត ថា ភ្លាម ៗ
ដំណាំ ម្រេច អាច ប្រមូល ផល បាន នៅ ឆ្នាំ ទី ពីរ បន្ទាប់ពី ដាក់ ដាំ ។
គ្នា ដើម្បី តាក់តែង សរសេរ គម្រោង ច្បាប់ មួយ ឈ្មោះ ថា ច្បាប់ ស្តី អំពី ការប្រឆាំង អំពើពុករលួយ ។
ទី ពីរ អ្នក ផ្តល់ យោបល់ ជាច្រើន នាក់ នឹង ប្រាប់ អ្នក ឱ្យ រាប់ ដល់ ដប់ ។
រីឯ នៅ ខាងមុខ បន្ទប់ នីមួយ ៗ
ឧកញ៉ា គង់ ក្រឹង ភ្លេច អនុសាសន៍ នាយក រដ្ឋមន្ត្រី !
ឥឡូវនេះ មាន អ្វី គ្រប់ យ៉ាង ទាំងអស់ ។
អ្នក ទាំង ពីរ បាន រៀបការ ជាមួយគ្នា ក្នុង ឆ្នាំ ១៩៩៣ ក្រោយពី មាន ទំនាក់ទំនង ជាមួយគ្នា បាន រយៈពេល ៣ខែ ។
នេះ ពិតជា សំនួរ មិន ធម្មតា មួយ ដែល គ្មាន អ្នកណា អាច ឆ្លើយ បាន រហូតមក ទល់ ថ្ងៃ នេះ ។
នេះ ចម្លែក ណាស់ នាងខ្ញុំ មាន ធ្លាក់សជារៀងរាល់ ខែ តាម ទ្វារមាស ។
យើង ចាំ មើល ការផ្តល់ ចម្លើយក សិណ សាក្សី របស់ លោក នៅ ពីមុខ សភា ។
៩ នៅពេល ខ្ញុំ ឡើង ទៅ លើ ភ្នំ ដើម្បី ទទួល បន្ទះ ថ្ម គឺ បន្ទះ ថ្ម នៃ សម្ពន្ធ មេត្រី ដែល ព្រះអម្ចាស់ បាន ចង ជាមួយ អ្នក រាល់គ្នា ខ្ញុំ ស្ថិត នៅលើ ភ្នំ អស់ រយៈពេល សែសិប ថ្ងៃ សែសិប យប់ ដោយ មិន បាន បរិភោគ អាហារ ឬ ទឹក ទេ ។
លើ អ៊ីរ៉ង់ និង ស៊ីរី នៅ តំបន់ ព្រំដែន ដែល ជាប់ ជាមួយ ប្រទេស ខ្លួន ។
ក៏ នឹង ជួយសង្គ្រោះ ជីវិត នៃ មនុស្ស ក្រីក្រ ផង
អ្នក អាច ប្រើ កន្ទុយ ភ្នែក របស់ អ្នក សម្លឹង នាង ថា តើ នាង កំពុង សម្លឹង មក អ្នក ញឹកញាប់ ឬ ទេ ព្រោះថា បើ នារី ណា ម្នាក់ ចាប់អារម្មណ៍ នឹង អ្នកវិញ គេ នឹង សម្លឹង មក អ្នក ជារឿយ ៗ
ប្រចាំ ថ្ងៃ ក្នុង រយៈពេល ២៤ ម៉ោង
ក្រោយ ទទួល ជ័យជំនះ ។
ថា បើ មិន ជឿ សូម កុំ ប្រមាថ ដូច្នេះ ចង់ ដឹង រឿងរ៉ាវ ពិត មាន ដំណើរ ដើមទង យ៉ាងណា ជុំវិញ រឿង នេះ សូម ស្តាប់ កិច្ចសម្ភាសន៍ ផ្ទាល់ រវាង លោក អ៊ុំ កុសល និង លោក ឡា អ្នកស្រុក ថ្មគោល ខេត្ត បាត់ដំបង ដូចតទៅ ៖
បន្ទាប់ពី ឪពុក ម្តាយ របស់ ជនរងគ្រោះ មិន
នាង បក់ ដៃ ហៅ មិត្ត សម្លាញ់ ដែល អង្គុយ នៅក្នុង រថយន្ត ។
ខ្ញុំ មាន សេចក្តីអាណិតអាសូរ ចំពោះ អម រា យ៉ាង ខ្លាំង ។
ក្នុង ឆ្នាំ ១៩១៣ គាត់ បាន ហ្វឹកហ្វឺន កូន ៗ
ដែល លោក ទទួលបាន ពី កិច្ចប្រជុំ ជាច្រើន ថ្ងៃ មក នេះ ?
ហើយ ថា តើ ចៅក្រម ស៊ើបអង្កេត មាន សិទ្ធិ ឃាត់ទុក សំនុំរឿង ដើម្បី ការស៊ើបអង្កេត របៀប នេះ ក្នុង រយៈពេល ប៉ុន្មាន នោះ ឡើយ ។
រាប់ រយ កន្លែង នៅក្នុង ពិភពលោក ក៏ ដូចជា នៅក្នុង សហគមន៍ តូច ៗ
នានា លើ ទំព័រ ហ្វេសប៊ុក សប្តាហ៍ នេះ ក៏ មិន បាន
ក៏ប៉ុន្តែ ដើម្បី អនុវត្ត ការអប់រំ បរិយា បន្ន ប្រកបដោយ ភាពជោគជ័យ និង ប្រសិទ្ធភាព យើង ត្រូវការ ធនធាន មនុស្ស ដែល មាន សមត្ថភាព បណ្តុះបណ្តាល ខ្ពស់ ។
ដែរ ចាប់តាំងពី ម្សិលមិញ ចេញ ពី លីប៊ី ។
