ដោយសារតែ ខឹង អ្នកជិតខាង បើក ម៉ាញ៉េ លឺ ៗ
វា ជា កញ្ចប់ ពិន័យ រយៈពេល ៤ឆ្នាំ ហើយ កីឡា នីមួយ ៗ
ទោះបីជា លោក បាន ចាត់ទុក លោក អូបាម៉ាជា បុរស នៃ សេចក្តីសុច្ចរិត ដែល បាន ធ្វើត្រឹមត្រូវ ក្នុង ការសម្រេចចិត្ត ទាក់ទង នឹង ប្រទេស អាហ្វហ្គានី ស្ថន ក្តីា ក៏ លោក និយាយ ថា លោក ប្រធានាធិបតី មិន ស្រួល ចិត្ត នឹង សង្គ្រាម ក្នុង ប្រទេស អ៊ីរ៉ាក់ និង អាហ្វហ្គានីស្ថាន ដែល លោក ស្នង ពីរដ្ឋការ របស់ លោក ប៊ូស នោះ ទេ ។
ខ្ញុំ គិត ថា វា នឹង ល្អ សម្រាប់ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ៕
ចូលរួម កម្មវិធី នេះ ។
កម្មករ ទាំងអស់ ដែល ទទួលបាន ប្រាក់ខែ ពី រដ្ឋ នឹង មាន សិទ្ធិ ទទួលបាន ការគ្របដណ្តប់ ដោយ គ្រោងការ នោះ ។
តើ ការដក អាំង មាល តី អាច ធ្វើឱ្យ ប្រពន្ធ័តុលាការ ប្រសើរ ជាង មុន ទេ ?
ការនាំ អង្ករ ចេញ របស់ កម្ពុជា ទៅកាន់ ទីផ្សារ ក្រៅ ប្រទេស សម្រាប់ រយៈពេល ៦ខែ ដើម ឆ…
ការចូលរួម របស់ គបម ក្នុង ការបោះឆ្នោត ជាតិ ឆ្នាំ ២០១៨ ៕
សវនាការ របស់ សកម្មជន ដីធ្លី អ្នកស្រី ទេព វន្នី ត្រូវបាន ផ្អាក ដោយ មិន កំណត់ ពេល ច្បាស់លាស់
ជាច្រើន មាន ទាំង អ្នក ក្នុង ស្រុក និង ក្រៅ ស្រុក ប្រាថ្នា ចង់បាន នាង យក ធ្វើជា គូ គ្រង ទៀតផង ៕
យើង គ្រប់ គ្នា សុទ្ធតែ បាន ឃើញ ច្បាស់ ពី មហិច្ឆតា ក្រាញ អំណាច របស់ លោក កាដាហ្វ៊ី ។
ត្រូវតែ អង្គ សវនាការ សាលាឧទ្ធរណ៍ ហ្នឹង ពិចារណា ម្តង ទៀត និង លើកលែង ទោស ខ្ញុំ តែម្តង ។
នាង មាន ការតស៊ូ ច្រើន នៅលើ មុខរបរ មួយ នេះ ។
ដែល កើតឡើង យ៉ាង ពេញ បន្ទុក ។
នៅក្នុង ផ្ទះ ខ្ញុំ ក៏ គ្មាន អាហារ ឬ អាវធំ ដែរ
ហើយ ស្តាប់ ពាក្យ ខ្ញុំ ខ្ញុំ នឹង បង្រៀន អ្នក
ពួកគេ ទាក់ទាញ ចិត្ត ពួក អ្នក ដែល មិន មាំ មួន ។
ការជ្រើសរើស ស្រោម អនាម័យ មិន បាន ត្រឹមត្រូវ អាច បង្ក បញ្ហា មួយចំនួន ដល់ សេចក្តីសុខ លើ គ្រែ ដែរ ។
ប៉ុន្តែ បញ្ហា ដែល ការមាន ភ្លាម ៗ
ហើយ ធ្វើ ពិធី ជ្រមុជ ទឹក អោយ គេ ក្នុង ព្រះនាម ព្រះបិតា ព្រះបុត្រា
ទំនិញ និង សេវាកម្ម នៅ ទីក្រុង ប៉េកាំង មាន តម្លៃ ថ្លៃ ជាង គេ បំផុត នៅក្នុង ប្រទេស ចិន
លោក បាន បោះបង់ ការសិក្សា នៅ អាយុ ១៧ ឆ្នាំ ដើម្បី ទៅ ធ្វើការ នៅ ស្ថានីយ៍ ប្រេងឥន្ធនៈ ។
លោក មានប្រសាសន៍ ថា យើងខ្ញុំ ទាំងអស់ គ្នា នៅតែ ប្តេជ្ញាចិត្ត ដើម្បី រក យុត្តិធម៌ ជូន លោក ជា វិជ្ជា ហើយ ខ្ញុំ ជឿ ថា យុត៌្តធ មិ នឹង ទទួលបាន ថ្ងៃ ណាមួយ មិន ខាន ។
ខ្ញុំ មិន ចូលចិត្ត សើច ចំពោះ មនុស្ស ទេ ប៉ុន្តែ ខ្ញុំ ចូលចិត្ត សើច អំពី មនុស្ស ។
ខ្ញុំបាទ យើងខ្ញុំ ទាំងអស់ គ្នា សូម គោរព ជូនពរ ដល់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន
កាលពី មុន ឈឿង រចនា មាន សង្សារ ប្រុស ប៉ុន្តែ ពេលនេះ នាង ស្រលាញ់ មនុស្ស ស្រី ទៅ វិញ ។
ទាំងអស់ បានំ លើកលែងតែ ពាក្យ ជេរ ប្រមាថ !
ជិត មួយ ឆ្មាំ ទៅ ហើយ សុគន្ធ និសាហាក់ ដើរ ថយ ក្រោយ យ៉ាង ឆ្ងាយ
តើ មាន អ្វី កើតឡើង ខ្លះ ក្រោយពី អ្នក ឈប់ ផឹក ស្រា រយៈពេល ២១ ថ្ងៃ
និង កោះ ជាច្រើន ។
រុក្ខជាតិ ម្រុំ ត្រូវបាន គេ ប្រើ ក្នុង វិធី ជាច្រើន ក្នុង ការបង្កើត ជា ថ្នាំ បុរាណ ។
ចុច ប៊ូតុង ការទាញយក កម្មវិធី មក ប្រើប្រាស់
យើង នឹង ផ្តល់ ការងារ ចាស់ ឱ្យ គាត់ វិញ នៅពេល គាត់ អាច មក ធ្វើការ បាន ៕
នៅក្នុង ផ្នែក នេះ អ្នក នឹង បាន យល់ដឹង អំពី ការប្រើប្រាស់ ប្រព័ន្ធ ប្រតិបត្តិការ មួយ នេះ ដូចជា ៖
និង បាន ថត រូប ជា អនុស្សាវរីយ៍ ផងដែរ ៕
សេក ហាយ អ្នកនាង អ្នកនាង អាក្រក់ ណាស់ ។
បាន កើនឡើង ធ្វើឱ្យ តម្រូវការ ប្រើប្រាស់ ផលិតផល មាន ការផ្លាស់ប្តូរ ពី ផលិតផល តម្លៃ ទាប
យ៉ាងណា លោក ជឿជាក់ ថា រាល់ បញ្ហា នឹង មាន ដំណោះស្រាយ ។
ដែល ទទួលបាន គោរមងារ ជា សម្តេច រួម មាន ៖
សូម បញ្ជាក់ ដែរ ថា ក្រុម រដ្ឋ អ៊ីស្លាម បាន វាយ ដណ្តើម កាន់កាប់ យក ទីក្រុង នេះ តាំងពី ថ្ងៃទី ៤ខែសីហា ឆ្នាំ ២០១៤មក ៕
ហើយ ភាគ ច្រើន ដោះស្រាយ បាន ស្ងប់ស្ងៀម ។
នេះ គឺជា ភាព ស្រដៀង គ្នា ប្រាកដ និយម ៖
ការ ដែល តម្លៃ ប្រេង ធ្លាក់ចុះ វា ជា ចំណុច ល្អ ក្នុង បរិបទ ឥឡូវនេះ ប៉ុន្តែ វា នៅ បន្ត ធ្លាក់ចុះ ទៀត ឬ យ៉ាងណា ?
ហើយ ពួកយើង ក៏ នៅ ស្ងៀម ទាំងអស់ គ្នា ដោយសារ ទាល់ តំរឹះ ។
ម្ចាស់ ក្រុមហ៊ុន គួរតែ យកចិត្តទុកដាក់ ខ្ពស់ លើ អភិបាលកិច្ច ក្រុមហ៊ុន
គ្រប់ ស្ថានីយ វិទ្យុ ទូរទស្សន៍ ត្រូវ ផ្អាក ផ្សាយ កម្មវិធី ដែល មាន លក្ខណៈ សប្បាយ គគ្រឹកគគ្រេង ។
គេ ស្គាល់ លោក យ៉ាង ច្បាស់ នៅក្នុង វិស័យ ជំនួញ ប៉ុន្តែ តើ គាត់ នឹង ធ្វើ អ្វី ខ្លះ នៅក្នុង វិស័យ នយោបាយ ?
យើង ត្រូវតែ សោកស្តាយ ។
ដាក់ទោស ឬ ធ្វើ ទណ្ឌកម្ម មនុស្សម្នា ទេ ។
១៥ដ្បិត ព្រះអង្គ មាន ព្រះបន្ទូល ទៅកាន់ លោក ម៉ូសេថាៈ យើង នឹង មាន ចិត្ត មេត្តា ករុណា ដល់ នរណា ដែល យើង មេត្តា ករុណា ហើយ យើង ក៏ នឹង អាណិតអាសូរ នរណា ដែល យើង អាណិតអាសូរ ដែរ ។
កម្មករ កម្ម ការី មួយចំនួន ប្រើ ពាក្យ មិន សមរម្យ មិន អាច ទទួលយក បាន
កុំ ច្រឡំ ព្រឹត្តិការណ៍ នេះ និង ទិវា គ្មាន ខោ វែង ខែឧសភា ៕
ទៀត ត្រូវបាន គេ ធ្វើ ការដាំដុះ ពេញ មួយ ឆ្នាំ ដើម្បី ឆ្លើយតប ទៅនឹង សេចក្តីត្រូវការ របស់ គ្រួសារ ។
ស្ទើរ ទប់ សំណើច ពុំ បាន ជាមួយនឹង កំហុសឆ្គង បច្ចេកទេស ប្លែក ៗ
គ្រួសារ របស់ ខ្ញុំ ជា គ្រួសារ តូច មាន សមាជិក តែ បួន នាក់ ។
ហៃ គេ ឃើញ មាន ក្រុមហ៊ុន យ៉ាង ច្រើន ផ្តល់ សេវាកម្ម បែប នេះ ហើយ វា បាន ធ្វើឱ្យ តំបន់ នេះ ក្លាយ
មនោសញ្ចេតនា កក់ក្តៅ ចុះ សម្រុង នឹង គ្នា ។
ប្រាក់ ទាំងនេះ ភាគ ច្រើន រូប គេ រក បាន ពី ការធ្វើ ជំនួញ ។
យ៉ាងណា … អនុស្សាវរីយ៍
ពួកគេ ទាក់ទង គ្នា ជាច្រើន ឆ្នាំ មុនពេល រៀបការ នៅ ឆ្នាំ ២០០៨ ។
ប្រភព បន្ត ថា ដោយ ឃើញ កូន ដូច មាន សម្រស់ ស្រស់ គួរឱ្យ ចាប់ចិត្ត មាន សភាព
អេឡិចត្រូនិច និង គ្រឿង ប្រើប្រាស់ ក្នុង ព្រះវិហារ
ទាំងអស់ នេះ វា ការទាមទារ របស់ គាត់ មិន ដឹង ស្ថាប័ន ណា ជា អ្នកទទួលខុសត្រូវ ធ្វើ ការងារ ហ្នឹង ទេ ។
ចំណុច សំខាន់ ដែល ខ្ញុំ កំពុង លើកឡើង នេះ គឺ ៖
នេះ គឺ អាច ក្នុង រយៈពេល ប៉ុន្មាន ខែ ខាងមុខ នេះ ។
លើ វីដេអូ នេះ ផងដែរ ។
២សេចក្តី ទាំងអស់ ដែល អ្នក បាន ឮ ពី ខ្ញុំ នៅមុខ សាក្សី ជាច្រើន នាក់ ត្រូវ ប្រគល់អោយ បងប្អូន ណា ដែល ស្មោះត្រង់ និង មាន សមត្ថភាព អាច បង្រៀន បន្ត ទៅ អ្នក ផ្សេង ទៀត ចុះ ។
គ្មាន ឬ បង្ហាញ ៖
ជាតិ នេះ ជួបគ្នា មិន បាន ច្រៀង ដោយ ៖
ព្រះជាម្ចាស់ មិន គ្រាន់តែ មាន ផែនការ ឱ្យ ស្គាល់ សេចក្តីពិត អំពី ទ្រង់ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ទ្រង់ ចង់ឱ្យ លោក អ្នក រស់ នៅ តាម សេចក្តីពិត ទាំងនោះ ។
ការឈ្លោះ ឬ តមាត់ ជាមួយ នាង បាន ផលប្រយោជន៍ អ្វី មកវិញ ?
ក្នុង នោះ ធនាគារ នឹង សិក្សា លើ ចំណុច ចម្បង ៗ
អត់ ពួក ប្រឆាំង ក មិន ខ្វល់ បើ វា មិន ចេះដឹង អី ផង ចេះតែ រំខាន បោក ញុះញង់ ប្រមាថ
គោល នយោបាយ កំណែទម្រង់ ជា កញ្ចប់ ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ រួម មាន ៖
រួចហើយ យកមក បិទ នៅ ទីនោះ ជាច្រើន គ្រប់ ពណ៌ គ្រប់ ប្រទេស និង គ្រប់
ជា កូន ដែល ចេះ និយាយ កុហក ភូតភរ និយាយ មិន ពិតប្រាកដ បាត ដៃ ជា ខ្នង ដៃ មាន មិត្តភ័ក្តិ ច្រើន និង ប្លែក មុខ ខុសពី ធម្មតា ឬ ជា មិត្តភ័ក្តិ ដែល ខ្លាច មិន ហ៊ាន ចូលទៅ ជួប ជាមួយ លោក អ្នក ដើម្បី បាន ស្គាល់ ។
ឥណ្ឌូណេស៊ី ជា ប្រទេស សេដ្ឋកិច្ច ធំ ជាង គេ បំផុត នៅក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ ។
ថៃ ប្រកាស លើក ថ្ងៃ សង្ក្រាន្ត ចូល ឆ្នាំ ថ្មី ទៅ ពេល ក្រោយ
តែង មាន គ្រូបង្រៀន ទទួលបន្ទុក ចំនួន ៣នាក់ ។
ទៀត ជាមួយ វិនិយោគិន ក្នុង ស្រុក ៕
ប៉ុន្តែ មាន មូលហេតុ ច្រើន យ៉ាង ដែល បណ្តាលឱ្យ ភាគី ទាំង ពីរ មិន ចុះសម្រុង គ្នា ៖
យើង មាន កិត្តិយស ដោយ បាន ទទួល អ្នក សំណើ ។
រដ្ឋាភិបាល ថៃ និង ក្រុម ឧទ្ទាម រណសិរ្ស បដិវត្ត ជាតិ ទើបតែ បាន ព្រមព្រៀង គ្នា នា ពេល ថ្មី ៗ
ជា អ្វី ដែល ខ្ញុំ ចង់បាន ហើយ ខ្ញុំ នឹង ពេញចិត្ត ៕
ដើម្បី ជា ការគោរព ដល់ អ្នកស្លាប់ យើង មិន អាច ប្រាប់ មូលហេតុ ទៅកាន់ ប្រព័ន្ធ ផ្សព្វផ្សាយ បាន ទេ ។
ក្នុង ពេល ដែល យើង ធ្វើ ដូច្នេះ យើង ក៏ បាន ត្រូវ ធ្វើឱ្យ ផ្លាស់ ប្រែ ឱ្យ ដូច រូប នោះ ដោយ ជះ សិរី រុងរឿង របស់ លោក កាន់តែ ខ្លាំង ឡើង ៗ
លុះត្រាតែ ពេល យើង បរាជ័យ ទើប យើង ដឹង ថា នរណា ជា មិត្ត ពិតប្រាកដ របស់ យើង ។
ជា ឧទាហរណ៍ ពួកគេ បាន ព្យាយាម ផ្តល់ ភាពស្រប ច្បាប់ ដល់ ក្រុម ជន អន្តោប្រវេសន៍ ជាទូទៅ ប៉ុន្តែ ជនរងគ្រោះ ភាគ ច្រើន មិន មាន លិខិតស្នាម នោះ ទេ ដូច្នេះ ត្រូវ មាន ការ តាមដាន កង នាវា នៅ តាម ដែន សមុទ្រ ផងដែរ ។
រឿង ដំបូង ដែល គ្រូពេទ្យ នឹង ធ្វើ គឺ ធ្វើ ការពិនិត្យ រាងកាយ និង ពិចារណា ពី រោគសញ្ញា ដែល អ្នក បាន ជួបប្រទះ ។
អង្គការ អ្នកការពារ ជួរ មុខ ជា អង្គការ ការពារ សកម្មជនរងគ្រោះ ពី ការការពារ សិទ្ធិ មនុស្ស នៅក្នុង តំបន់ ។
ចំពោះ ខ្ញុំ ខ្ញុំ គិត ថា អ្វី ដែល សំខាន់ បំផុត គឺ ត្រូវ រស់ នៅ ដោយ សុភមង្គល និង មាន សុខភាពល្អ ។
ការព្យាបាទ ទាំងនេះ បាន ធ្វើឱ្យ លោក បារម្ភ ពី សុវត្ថិភាព ផ្ទាល់ខ្លួន និង កម្មករ ៖
ជន ដែល បាន បំផ្ទុះ គ្រាប់បែក ក្នុង …
ហើយ ថា ក្រុមហ៊ុន មូលធន ត្រូវបាន បង្កើត យ៉ាងដូចម្តេច ?
តើ មាន អ្វី កើតឡើង ប្រសិនបើ លោក សម រង្ស៊ី វិលត្រឡប់ ចូល ប្រទេស កម្ពុជា ?
ជា ពាក្យ ដែល តែង លេចឡើង ក្នុង ចម្រៀង ឬ ក្នុង រឿង ។
ដែល ខ្លួន គប្បី ត្រូវ ធ្វើ វិញ ។
និង ជ្រុល ទៅ បុ.ក ម៉ូតូ សរុប បណ្តាលឱ្យ មនុស្ស រ.ងគ្រោះ ដល់ ទៅ ៥នាក់ ចំណែក អ្នកបើកបរ រថយន្ត បង្ក បាន រត់គេចខ្លួន បាត់ ។
លោក មានប្រសាសន៍ ថា ពិភពលោក កំពុងតែ ចោល ខ្សែភ្នែក មក លើ កម្ពុជា ។
េល សង្គ្រាម ជាថ្មី ៕
ព្រោះថា ប្រវត្តិសាស្ត្រ គឺជា ការតាំង កាលបរិច្ឆេទ ។
អ្នកស្រី សុខ ហេង រៀបរាប់ ថា ៖
បច្ចុប្បន្ន ទារិកា ស្ថិត នៅ សភាព គ្រោះថ្នាក់ នៅឡើយ ។
ហេតុ នេះ ការចេះ ចាំ ថ្ងៃ ខែ ឆ្នាំ មាន ប្រយោជន៍ ជាច្រើន យ៉ាង ។
ទាំងនេះ គឺជា កត្តា ដែល ធ្វើអោយ អ្នក រាល់គ្នា ជួប បញ្ហា ជាច្រើន ដូចជា ៖
សាជីវកម្ម ពហុ ជាតិ កំណត់ហេតុ ឌីយ៉ា
ផ្ទះ ព័ត៌មាន សុខភាព កុំ បណ្តោយ !
តែ ខ្ញុំ គិត ថា រឿង នេះ វា ជា រឿង តូចតាច ទើប ខ្ញុំ អនុញ្ញាតឱ្យ នាយកដ្ឋាន ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ អញ្ជើញ ទៅ សាកសួរ ។
សូម ទស្សនា រូបភាព និង វីដេអូ អនុស្សាវរីយ៍ សង្ក្រាន្ត កំពង់ឆ្នាំង កាលពី ឆ្នាំ មុន តើ សប្បាយរីករាយ ប៉ុណ្ណា ?
ហើយ វា បាន ក្លាយជា ដំណើរកំសាន្ត លើក ដំបូង និង ចុងបញ្ចប់ របស់ នាង ដែរ ។
រឿង កំប្លែង របស់ សំលាញ់ ឯង ត្រូវ ចប់ សព្វគ្រប់ អស់ ហើយ …
ម៉ិចស៊ិក រង ប៉ះពាល់ ដោយ ការរញ្ជួយ ដី មួយ
ប្រទេស ស៊ូ ដង់ ខាងត្បូង ប្រកាស ឯករាជ្យ របស់ ខ្លួន
អាជីវកម្ម នានា ទូទាំង ពិភពលោក កំពុងតែ ប្រឈមមុខ នឹង ភាព មិន ប្រាកដប្រជា កាន់តែ ខ្លាំង ឡើង ។
លោក មាន បទពិសោធន៍ ការងារ រយៈពេល ជាង ១៣ ឆ្នាំ ដោយ លោក បាន បំពេញ ការងារ ជាមួយ ក្រុមហ៊ុន ស្ថាប័ន អាជីវកម្ម ធំ ៗ
យ៉ាងណាមិញ គេ សង្កេតឃើញ ថា អ្នកនយោបាយ ភាគ ច្រើន គាំទ្រ លោក កឹម សុខា បាន អនុវត្ត សាលក្រម របស់ តុលាការ កំពូល ភាគ ច្រើន ។
នោះ ត្រូវ ឆ្លើយ ថា គួរគប្បី ឱ្យ បណ្តា ជន ស្វែងរក ព្រះ របស់ ខ្លួន វិញ តើ នឹង រក ចំពោះ រូប ខ្មោច ជា ប្រយោជន៍ ដល់ មនុស្ស រស់ ធ្វើ អ្វី
ការធាត់ ទំនងជា កើតមាន នៅក្នុង ក្រុមគ្រួសារ ។
បទៈ អូន ផ្ញើ ខ្លួន ផង
កាល ថ្លែង ដល់ ការគាំទ្រ ដោយសាសនា ចក្រ ប្រតិកម្ម ដំបូង របស់ ខ្ញុំ គឺ ផ្តោត ទៅ លើ របៀប ដើម្បី ធានា ថា សមាជិក នឹង ប្រើ មួយ ម៉ោង បន្ថែម រាល់ ថ្ងៃអាទិត្យ ដើម្បី សិក្សា ដំណឹង ល្អ ដោយ មាន ប្រសិទ្ធភាព ។
ដូច្នេះ អ្នក គួរ លាប ឡេ ការពារ កម្តៅ ថ្ងៃ ឱ្យ បាន រាល់ ថ្ងៃ ដើម្បី ការពារ ស្បែក មុខ ។
យើង ដឹង អំពី ប្រវត្តិ នេះ ល្អ ជាង នរណា ទាំងអស់ ។
ការចង សម្ព័ន្ធន .
បុរស អូស្ត្រាលី ម្នាក់ ផឹក ស្រា ទាល់តែ គាំង បេះដូង ស្លាប់
ព្រឹក នេះ គ្មាន ភ័ស្តុតាង ណា មួយ ដែល គាត់ ពាក់ព័ន្ធ ទេ ។
គាត់ មាន ការទាក់ទង ស្និទ្ធស្នាល ជាមួយ ពលរដ្ឋ នៅ ថ្នាក់ ក្រោម ។
ខ្ញុំ ស្រឡាញ់ ពាក្យ នេះ ល្បួង ជាច្រើន ទៀត ។
ប៉ុន្តែ វា មាន ការពិបាក ព្រោះថា គ្មាន ទីកន្លែង ពិតប្រាកដ ណាមួយ ដែល មាន ប្រសិទ្ធភាព សម្រាប់ មនុស្ស គ្រប់ គ្នា នោះ ទេ ។
ខ្ញុំ សប្បាយ ចិត្ត នឹង ធ្វើ វា ពីព្រោះ មិន លំបាក ទេ ។
ចំណែកឯ ពូជសាសន៍ ជ្វីហ្វ ក៏ មាន អារម្មណ៍ ថា រង ការគំរាមកំហែង ។
ខ្ញុំ គិត ថា យើង កំពុង ធ្វើ ការប្រថុយប្រថាន ធំ សម្បើម ណាស់ ។
ព្រះអម្ចាស់ នឹង ប្រទាន រង្វាន់ ចំពោះ អ្វី ៗ
រដ្ឋាភិបាល កម្ពុជា ទាំងមូល ក៏ កំពុង តាមដាន ស្ថានភាព នៅក្នុង ប្រទេស ថៃ ដែរ ។
លោក ហ៊ុន សែន ថា គណបក្ស សង្គ្រោះ ជាតិ មិន ខុសពី ប៉ុល ពត
គ្រប់ មនុស្ស សុទ្ទ តែ មិន បរិបុណ្ណៈ ឬ បរិបូរណ៌ ហើយ អមតៈ នោះ ទេ ។
ខ្ញុំ គិត ថា វា នឹង ក្លាយជា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ដ៏ មាន ឥទ្ធិពល មួយ ។
រហូតមកដល់ ពេលនេះ នៅ មិន ទាន់ មាន ការឆ្លើយតប នូវ សំណួរ ទាំង ប្រាំពីរ របស់ ប្រធាន ក្រុម អ្នកតំណាងរាស្ត្រ បក្ស ប្រឆាំង សម រង្ស៊ី នៅឡើយ ទេ ។
ក៏ដោយ បើ បាត់ខ្លួន សូម ឱ្យ រដ្ឋាភិបាល ថៃ គាត់ សហការ ជាមួយ យើង ដែរ ហ្នឹង ណា៎ ។
អ្នក ទៅ ធ្វើការ ដើម្បី គ្រាន់តែ ធ្វើការ
គិត ត្រឹម ម៉ោង នេះ ភរិយា លោក បាន ស្ថិត នៅក្នុង បន្ទប់ សង្គ្រោះ បន្ទាន់ ៣ ថ្ងៃ មក ហើយ ។
ផែនការ ពង្រីក ផលិតកម្ម នេះ ធ្វើឡើង បន្ទាប់ពី ក្រុមហ៊ុន គ្រោង នឹង បញ្ឈប់ ការផលិត នៅ ទីក្រុង សៀងហៃ ។
មិន ដែល ឱន ក្រោម មើល មនុស្ស តូចតាច ដូចជា ពួកយើង ឡើយ ។
នៅ ពេល ដែល មនុស្ស ម្នាក់ ៗ
មិន បាន ទាំងនេះ ហៅ ថា កំណប់ ទ្រព្យ នៅនឹង កន្លែង ។
ខ្ញុំ មិន យល់ ថា អាចម៍ផ្កាយ ចង់បាន យ៉ាងម៉េច ។
ផ្តោត លើ ពាក្យ រឺ សំលេង នៅពេល អ្នក ហាត់ ដកដង្ហើម ជ្រៅ ។
មុខមាត់ សង្ហារ ថែម ទៀត ។
ប៊ូតង់ និង ចិន មិន មាន ទំនាក់ទំនង ការទូត ទេ ។
នោះ មិន មែន ជា ការធ្វើឱ្យ មាន ផលប្រយោជន៍ ដល់ ចិន ទេ ។
របស់ អតិថិជន ដោយ មិន ចរចា ពិបាក្សា គ្នា ជាមុន សិន ។
បញ្ចប់ តង់ទី១ ក្រុម ទាំង ពីរ សុទ្ធ ចូល គ្នា ១១ ។
គាត់ ជំពាក់ លុយ គេ ច្រើន ។
មើល ទីផ្សារ ទាំង ៩
ចំណេះដឹង មួយ នេះ ក៏ ជួយ អោយ អ្នកបង្កើត បានជា យុទ្ធិសាស្ត្រ ថ្មី ៗ
នៅ ពេល នេះ ក្នុង អាជីព របស់ ខ្ញុំ របស់ ខ្ញុំ
ដុំ សាច់ ក្នុង ស្បួន អាច កើតឡើង នៅ គ្រប់ វ័យ ។
ពេល ត្រាំ ក្នុង ទឹក ក្តៅ បេះដូង យើង ដំណើរការ លឿន និង ខ្លាំង ជាង មុន ។
ទំព័រ ដើម គួយល់ដឹង
ប៉ុន្តែ ខ្ញុំ ក៏ បាន វិលត្រឡប់មក រក ខគម្ពីរ នោះ វិញ ដោយ ការ នឹក ចាំ ជារៀងរាល់ យប់ ហើយ ព្រះទ្រង់ ក៏ បាន ជួយ ឱ្យ ខ្ញុំ មាន ជំនឿ លើ ទ្រង់ កាន់តែ ខ្លាំង បន្តិច ម្តង ៗ
មុន ការបោះឆ្នោត គណបក្ស ប្រជាធិបតេយ្យ មូលដ្ឋាន
ប្រធានាធិបតី ហ្វីលីពីន អះអាង ថា លោក នឹង ឈរឈ្មោះ ធ្វើជា អនុប្រធានាធិបតី វិញ សម្រាប់ ការបោះឆ្នោត ឆ្នាំ ២០២២
លោក កែប ជុតិ មារង ការរិះគន់ ក្នុង ហ្វេសប៊ុក និង ប្លុក
ប្រសិនបើ តុលាការ រកឃើញ ថា នាង ពិតជា មាន ពិរុទ្ធភាព ដូច ការចោទប្រកាន់ មែន នាង អាចនឹង ជាប់ ពន្ធនាគារ រហូតដល់ទៅ ៥០ ឆ្នាំ ៕
នៅក្នុង ឆ្នាំ ២០១៦ នេះ យើង សង្កេតឃើញ មាន រថយន្ត ម៉ាក ល្បី ៗ
ដែល មិន សូវ ជា ស្រឡាញ់ ឬ ចង់ បម្រើ ការងារ ព្រះជាម្ចាស់ ។
កម្ពុជា មិន មែន ជា ប្រទេស ផលិត គ្រឿងញៀន ទេ
សារ របស់ ញ៉ែម សុគន្ធ ពេល ទទួល សមាជិក ថ្មី
តែ បើ គិត ពី ប្រភេទ សម្ព័ន ភាព រវាង មនុស្ស វិញ យើង កត់សម្គាល់ ឃើញ ថា មនុស្ស ម្នាក់ ៗ
យើង មាន បញ្ហា ដែរ ប្រសិនបើ យើង មាន បញ្ហា សុខភាព ផ្សេង មួយចំនួន ទៀត ។
កុំ បារម្ភ ប្រិយមិត្ត អាច ធ្វើការ រក ទិញ នូវ បទចម្រៀង វ៉ុល ថ្មី ៗ
ចូលរួម ជាច្រើន នាក់ ។
ថ្ងៃ បន្ទាប់មក ប៉ូលិស ក៏ បាន ចាប់ខ្លួន នាយ ស្ទី ហ្វេន ។
មារ នៅក្នុង ដី ហ្នឹង បើ ដឹង រស សំឡេង ក្លិន
សង្គ្រោះ បឋមការថែទាំ សុខភាព
តើ ពេលណា តុលាការ កម្ពុជា អាច មាន លទ្ធភាព កាត់ទោស មន្ត្រី ដូច អ៊ុយក្រែន ?
ជាង នេះ នៅក្នុង រដូវ ខ្យល់ ស្ងួត រាងកាយ របស់ អ្នក នឹង ត្រូវការ ទឹក ច្រើន ជាង ធម្មតា ។
ព្រះគម្ពីរ បាន ចែង អំពី អំពើ បាប ក្នុង បទ គម្ពីរ រ៉ូម ៣២៣ ដែល ក្នុង នោះ លោក ប៉ុល បាន ប្រកាស ថា ពីព្រោះ គ្រប់ គ្នា បាន ធ្វើបាប ហើយ ខ្វះ មិន ដល់ សិរី ល្អ នៃ ព្រះ។
មេរោគ នេះ ត្រូវបាន បង្កប់ នៅក្នុង តំណរ ភ្ជាប់ ក្លែងក្លាយ មួយ ។
ស្រដៀង គ្នា នេះ ដែរ ពលរដ្ឋ ក្បែរខាង ម្នាក់ ទៀត គឺ លោកស្រី ប៊ិច ពុជ ។
ប្រសិនបើ បរាជ័យ នោះ នឹង ត្រូវ ប្រកាស ឱ្យ មាន ការបោះឆ្នោត ជាថ្មី ។
មួយចំនួន កំពុង បង្ហាញ ខ្លួន និង កំពុង មាន ការអភិវឌ្ឍ ជា បន្តបន្ទាប់ ផងដែរ ។
នេះ ខ្ញុំ មានអារម្មណ៍ ថា មាន ភាពលំបាក បន្តិចបន្តួច ដោយ ខ្ញុំ មិន ដឹង ថា ត្រូវ ធ្វើ បែប ណា នោះ ទេ ។
បង្ក្រាប ករណី ចែកចាយ ប្រើប្រាស់ គ្រឿងញៀន ឃាត់ ជនសង្ស័យ ម្នាក់ នគរបាល ជាតិ
អ្នក ត្រូវតែ អត់ធ្មត់ និង តស៊ូ ។
ខូចខាតៈ ស្រុត ផ្ទះបាយ ខាងក្រោយ តិចតួច ។
