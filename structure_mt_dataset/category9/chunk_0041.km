... ក្នុងគ្រប់ការ ទាំងអស់ដែលយើងអង្វរ រកទ្រង់ » ។
ព្រះអម្ចាស់ របស់ អ្នក គឺជា បិតា នៃ សកលលោក ។
គាត់ ប្រាប់ អ្វី ដែល គាត់ ដឹង គឺជា ការពិត ដើម្បី អោយ អ្នក ជឿ ។
ជម្លោះក៏កើតឡើងក្នុងចំណោមពួកគេដែរ ថាតើមួយ ណាជាអ្នកធំជាងគេ ។
ដ្បិតខ្ញុំបានទទួល ពីព្រះ‌ អម្ចាស់ ដែលខ្ញុំបានប្រគល់ឲ្យអ្នក រាល់គ្នាដែរ គឺថា ព្រះ‌ អម្ចាស់យេស៊ូនៅយប់ដែលគេក្បត់ទ្រង់យកនំប៉័ង ។
ប៉ុន្តែ មិន មែនអ្នក រាល់គ្នាស្វាគមន៍ដំណឹងល្អទេ ដ្បិតអេសាយដែលជាហោរាមាន ប្រសាសន៍ថា៖ « ព្រះ យេ ហូវ៉ា តើអ្នក ណាបានជឿដំណឹងរបស់យើង ? » ។
១២ « ប៉ុន្តែ ខ្ញុំសុំប្រាប់អ្នក រាល់គ្នាថា ការ នេះអ្នកមិនត្រឹមត្រូវទេ ដ្បិតព្រះជា ម្ចាស់ធំជាងមនុស្ស ។
អ្វី ដែល អ្នក កំពុង កាន់ នៅក្នុង ដៃ របស់ អ្នក គឺ ដូច ដែល គម្រប បង្ហាញ
ហើយនឹមនឹងដាក់លើ កអ្នកដែលមិនបានជឿ !
ស្ត្រី តែ ម្នាក់ ក្នុង ចំណោម មនុស្ស អមតៈ ។
ជោគវាសនា របស់ ពួកគេ ត្រូវបាន សរសេរ ដោយ ពិន្ទុ នៅលើ ថ្ងាស របស់ ពួកគេ
ហើយតើអំណាចរបស់ទ្រង់គ្មានដែនកំណត់ដល់យើងរាល់គ្នាដែលមានសេចក្តី ជំនឿ ដូចដែលបានឃើញនៅក្នុងការ ធ្វើការ នៃ កម្លាំងនៃអំណាចរបស់ទ្រង់
ហើយ ខ្ញុំ ដឹង ថា ព្រះគុណ របស់ ព្រះគឺ គ្រប់គ្រាន់ ហើយ ។
អ្នកមិនដែលដឹងថាអ្នកអាចនឹងសាច់អ្នក ណាទេ ( ក្រិចភ្នែកមើល ) ។
អ្នក ណាធ្វើតាមព្រះហឫទ័យរបស់ព្រះ អ្នក នោះជាម្ដាយ និងបងប្អូនរបស់ខ្ញុំ » ។
20 ក៏ប៉ុន្តែ អ្នកមិនបានស្គាល់ព្រះ គ្រីស្ទបែបនោះទេ ។
ដ្បិតអ្នក រាល់គ្នានៅក្នុងទីជំរកនៃ ទីខ្ពស់បំផុត ។
អ្នក បាន សម្លាប់ អ្នកនិពន្ធ នៃ ជីវិត ; ប៉ុន្តែ ព្រះ បានប្រោសទ្រង់ឲ្យមានព្រះជន្មរស់ឡើងវិញ ។
២ - ប៉ុន្តែយើងដឹងថា ការ វិនិច្ឆ័យរបស់ព្រះ គឺស្របតាមការ ពិតប្រឆាំងនឹងអ្នកដែលប្រព្រឹត្តបែបនេះ ។
និង ការគោរព ចំពោះ ជនជាតិ អារ៉ាប់ ។
អំណាចរបស់ពួកគេដើម្បីធ្វើឱ្យពួកគេធ្វើអ្វីដែលពួកគេចង់បាន។
ប៉ុន្តែ ព្រះ គង់នៅ ជាមួយនឹងកូនចៅរបស់ទ្រង់ ។
28 កូនចៅរបស់អ្នក បម្រើរបស់ព្រះអង្គនឹងបន្តទៅមុខ ហើយពូជ ‌ ពង្សរបស់ពួកគេនឹងត្រូវបានតាំងនៅចំពោះទ្រង់ » ។
« មានមនុស្សជាច្រើននៅសព្វថ្ងៃនេះដែលចាត់ទុកខ្លួនឯងថាជាមនុស្សអាក្រក់ ប៉ុន្តែ បទគម្ពីរជាសៀវភៅបិទ ត្រាសម្រាប់ពួកគេ ។
« តើអ្នក ជាមនុស្សរបស់ព្រះ ដែល មកពីស្រុកយូដាឬ ? » ។
ប៉ុន្តែការ មិនជឿលើអ្វីដែលលោកបាន សន្យា ។
" តើអ្នកត្រូវបានអនុញ្ញាតឱ្យសេព គប់ជាមួយនឹងអ្នកដែលបរិភោគសាច់ឬ ? "
ពេលដាក់ទណ្ឌកម្ម ព្រះ មាន បន្ទូលថា “ មិនទាន់ទេ ” ។
« ផល ផ្លែនៃមនុស្សសុចរិត គឺជាដើមជីវិត ហើយអ្នក ណាដែលមានប្រាជ្ញាចាប់យកជីវិតមនុស្ស ។
នេះហើយជាហោរាដែលនឹងចូល មកក្នុងពិភព លោក ។
តាម ព្យញ្ជនៈ គ្មាន អ្វី អាច លាក់បាំង ពី ទ្រង់ បាន ទេ ។
និង ក្រុមគ្រួសារ របស់ គាត់ ,
ប្រាកដណាស់ គាត់នឹងចេញមកជាមួយនឹងការ វិនិច្ឆ័យមួយចំនួន ។
ឪពុក ក៏ ដូចគ្នា ដែរ កូនប្រុស ក៏ ដូចគ្នា ដែរ ។
សាវ័កនិងបងប្អូននៅទូទាំងស្រុកយូដាបានឮថា សាសន៍ ដទៃក៏ទទួល យកព្រះបន្ទូលរបស់ព្រះ ដែរ ។
ប្រសិនបើ ព្រះគម្ពីរ ត្រូវបាន បំផុស គំនិត នោះ ប្រហែលជា ពួកគេ ធ្វើ ។
ហើយ សំខាន់ ជាង នេះ ទៅ ទៀត ពួកគេ បាន និយាយ ក្នុង ចំណោម ពួកគេ ថា៖
តើអ្នក ស្មានថាអ្នក ណាមុន អ័ ប្រាហាំ បើមិនមែនជាព្រះ?
គឺជា អ្នក បំរើ របស់ ព្រះ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ដែល ប្រាប់ អ្នក ពី ផ្លូវ ដើម្បី បាន សង្រ្គោះ ។
ហេតុនេះហើយបានជាជន ជាតិយូដាជាច្រើននាក់ដែលបានមក រកនាងម៉ារី ហើយឃើញការ ដែលព្រះ យេស៊ូធ្វើ ក៏ជឿលើលោក ។
យើងនឹងប្រោសគេឲ្យរួចពីអំពើអាក្រក់ដែលធ្វើឲ្យពួកគេរងទុក្ខ ។
ពួកគេកំពុង តែបំភ័យខ្ញុំ » ។
ដូច្នេះ វាគឺជាមួយនឹងការ រស់ឡើងវិញផងដែរ ។
ដ្បិតគាត់ និងអស់អ្នកដែលនៅ ជាមួយគាត់ងឿង ឆ្ងល់នឹងត្រីដ៏ អស្ចារ្យដែលគេចាប់បាន ។
ហើយ ដួងចិត្ត ពោរពេញ ដោយ អំណរ ។
វា គឺជា ការស្អប់ ការរីករាយ របស់ អ្នកដទៃ ។
« គ្មានអ្វីនៅក្នុងការ បង្កើតទាំងអស់ដែលលាក់បាំងពីព្រះនេត្ររបស់ព្រះ ឡើយ !
ដោយពោលថា មានចៅក្រមម្នាក់នៅក្រុងមួយ មិនកោតខ្លាចព្រះជា ម្ចាស់ ឬគោរពមនុស្សឡើយ ។
« ខ្ញុំមិនស្ទាក់ស្ទើរក្នុងការ ប្រកាសប្រាប់អ្នកអំពីព្រះហឫទ័យរបស់ព្រះ ទាំង ស្រុងទេ ។
ព្រះគង់ នៅ ជាមួយ យើង ។
ខ គម្ពីរ ទាំងអស់ គឺជា ព្រះដែល ដកដង្ហើម ហើយ មាន ប្រយោជន៍ សម្រាប់ ការបង្រៀន ការស្តីបន្ទោស ការកែតម្រូវ និង ការបណ្តុះបណ្តាល នៅក្នុង សេចក្តីសុចរិត ។
6 តើ ចាប ប្រាំ លក់ ក្នុង តម្លៃ ពីរ កាក់ ទេ ឬ ? ហើយមិនមាននរណាម្នាក់ក្នុងចំណោមពួកគេត្រូវបានបំភ្លេចចោលនៅចំពោះព្រះនេត្រនៃព្រះ ។
កាលលោកមាន ប្រសាសន៍ដូច្នេះហើយ ជន ជាតិយូដាក៏ចាកចេញទៅទាំងប្រកែកគ្នា ហើយប្រកែកគ្នា ។
ដូច្នេះ ភាសាជា សញ្ញាសម្រាប់អ្នកមិនជឿ មិនមែនសម្រាប់អ្នក ជឿទេ ។
គាត់បានពន្យល់ពួកគេនូវវគ្គបទ គម្ពីរទាំងឡាយដែលនិយាយអំពីខ្លួនគាត់ » ។
25 ដូច្នេះ ទ្រង់អាច សង្គ្រោះអស់អ្នកដែលចូលមក ឯព្រះ តាម រយៈទ្រង់បានទាំង ស្រុង ពីព្រោះទ្រង់តែងតែរស់នៅដើម្បីអង្វរពួកគេ ។
យ៉ាង សំខាន់ ចំពោះ កន្លែង ដែល យើង ប្រមូលផ្តុំ ជា សហគមន៍ នៃ អ្នក ជឿ
ប៉ុន្តែ ព្រះទ្រង់ប្រទានរូបកាយមួយដូចទ្រង់សព្វព្រះទ័យ ហើយដល់គ្រាប់ ពូជនីមួយ ៗមានរូបកាយរបស់វា។
គាត់បានទទួលយើងជាច្រើនឆ្នាំ មកហើយ ( ដោយមានការច្របូកច្របល់ខ្លះ ) ហើយសម្រាប់រឿងនោះ យើងមាន អំណរគុណ ។
« បន្ទាប់ពីពួកសាវ័កត្រឡប់មក ឯព្រះ យេស៊ូ វិញ ពួកគេប្រាប់ទ្រង់នូវអ្វីៗទាំងអស់ដែលពួកគេបានធ្វើ និងបង្រៀន ។
« មើលចុះ ជនជាតិអ៊ីស្រាអែលម្នាក់ដែលគ្មានការ បោកបញ្ឆោត » ។
អ្វី ដែល ត្រូវ ចាប់ផ្តើម ជាមួយ ពួកគេ ។
២០ លោកមាន ប្រសាសន៍ម្ដងទៀត ថា៖ « តើខ្ញុំនឹងប្រៀបធៀបព្រះរាជ្យរបស់ព្រះជាមួយអ្វី ?
ហើយទេវតាបាននិយាយថា៖ « នៅសម័យនេះសាសនាក៏ដូចគ្នាដែរ ដ្បិតព្រះអម្ចាស់មានព្រះបន្ទូលថា៖
ហើយអហារ៉ុន ដែលទ្រង់បានជ្រើសរើស ។
គាត់មិននិយាយអ្វីមួយម៉ាត់ឡើយ ដ្បិតគាត់នៅចំពោះមុខចៅក្រមដ៏សុចរិតនៃផែនដីទាំងមូល ។
នោះត្រូវបានលើកឡើងដោយឯកឧត្តម
ខ្ញុំ ជាប៉ូលិសសាលាមត្តេយ្យប្រឆាំងគាត់ » ។
ម្នាក់ ៗ ស្ថិត នៅក្នុង ពេលវេលា និង ទីកន្លែង របស់ ពួកគេ
បញ្ហាដែលបានពិភាក្សារវាងពួកគេ។
អ្នក សក្តិសមជាស្ត្រីពិត ( ឬបុរសបើជាស្ត្រី ) ។
ហើយទេវតាមួយអង្គបានបង្គាប់មកខ្ញុំពីព្រះ‌ អម្ចាស់ ថា៖ ‹ ចូរ នាំគាត់ទៅផ្ទះជាមួយនឹងអ្នក ដើម្បីឲ្យគាត់មានអ្វីស៊ី ផឹក ›» ។
ស្ត្រីចំណាស់ជាម្តាយ និងស្ត្រីក្មេងជាបងប្អូនស្រី ក្នុង ភាពបរិសុទ្ធទាំងអស់ ។
សូម ជំរាប សួរ ម៉ារី ដែល បាន ខិតខំ យ៉ាង ខ្លាំង សម្រាប់ អ្នក ។
ប៉ុន្តែអ្នក ណាដែល រស់នៅតាមសេចក្ដី ពិត ចូល មកក្នុងពន្លឺ ដើម្បីឲ្យឃើញច្បាស់ ...
តើមកពីគេមានការសង្ស័យដោយសម្ងាត់ ហើយខ្លាចគេបាត់ជំនឿរបស់ខ្លួនឬ ?
( គាត់មិនដឹងថាត្រូវនិយាយយ៉ាង ណាទេ ពួកគេភ័យខ្លាច ជាខ្លាំង ។ )
« ចូរនឹក ចាំពីពាក្យដែលទ្រង់បានធ្វើឲ្យទូលបង្គំមាន សង្ឃឹម » ។
៤ ប៉ុន្តែ ប្រជាជននៅទីក្រុងបានបែកបាក់គ្នា អ្នកខ្លះនៅខាង សាសន៍យូដា ហើយខ្លះទៀតជាសាវ័ក » ។
ផល ផ្លែ នៃ មនុស្ស សុចរិត គឺជា ដើមឈើ នៃ ជីវិត ហើយ អ្នកណា ដែល មាន ប្រាជ្ញា ចាប់ យក ជីវិត មនុស្ស ។
ពេលមកហូបបាយជុំគ្នាចាំមើលគ្នា ។
ហើយ សាឡូម៉ូន ជាសាឡូម៉ូន ។
សៀវភៅវិវរណៈមិនមែនជាឧបករណ៍ឌិកូដសម្រាប់លក្ខខណ្ឌដែលការ ព្យាបាលដ៏ អស្ចារ្យរបស់ព្រះ នឹងកើតឡើងនោះទេ ។
ដល់គាត់ជាទីពឹងជ្រក ចាប់ពីថ្ងៃនេះទៅ អស់មួយជីវិត » ។
ពេលនោះ ពួកមហាបូជាចារ្យ និង សហការីទាំងអស់របស់លោក ដែលជាសមាជិកនៃក្រុមសាឌូស៊ី មាន ចិត្តច្រណែន ។
គូកន របស់ ព្រះដ៏ វិសុទ្ធ ( សា) ត្រូវបាន សាបសូន្យ ដោយ ទុក្ខសោក ។
អ្វីដែលពួកគេប្រាថ្នាបានក្លាយជាបណ្តា សា មកលើពួកគេ ។
បន្ទាប់មក មាន ការមើល ពី ចម្ងាយ ។
ពួកគេជាកូនរបស់ព្រះ ព្រោះពួកគេបានរស់ឡើងវិញហើយ ។
« ចូរសរសើរ ត ម្កើងព្រះ នៃយើងរាល់គ្នា ទាំងអ្នក បម្រើទ្រង់ និងអ្នក រាល់គ្នាដែលកោតខ្លាចទ្រង់ ទាំងតូចទាំងធំ » ។
កូនរបស់ពួកគេនឹងស្វែង រកការ អនុគ្រោះពីជនក្រីក្រ ហើយដៃរបស់ពួកគេនឹងប្រគល់ទ្រព្យ សម្បត្តិរបស់ពួកគេវិញ ។
« ក៏មានជម្លោះមួយបានកើតឡើងក្នុងចំណោមពួកគេថាតើមួយ ណាក្នុងចំណោមពួកគេត្រូវបានគេចាត់ទុកថាធំជាងគេ » ។
ដោយសារតែ ពួកគេ ត្រូវបាន ចិញ្ចឹម ដោយ ស្ត្រី ជនជាតិ យូដា ។
ព្រះជាម្ចាស់ តែមួយគត់ដែលវិនិច្ឆ័យយើង ។
កិច្ចការ 6:11 ដូច្នេះ គេក៏សូកមនុស្សខ្លះថា យើងបានឮគាត់និយាយប្រឆាំងនឹងលោកម៉ូសេ និងប្រឆាំងនឹងព្រះ។
នាងសួរថា តើអ្វីទៅជាការ ពិត ហើយត្រង់ចំណុចនេះ តើនរណានឹងជួយ ?
36 ហេតុនេះហើយបានជាជន ជាតិយូដាពោលថា៖ « មើលថាលោកស្រឡាញ់លោកយ៉ាង ណា !
ប៉ុន្ដែ ព្រះបន្ទូល របស់ ព្រះបាន បន្ដ រីកចំរើន ឡើង ។
ពួកគេបានបង្ហាញបុរសទាំងនេះដល់ពួកសាវក ដែលបានអធិស្ឋាន ហើយដាក់ដៃលើពួកគេ ។
នេះហើយដែលហៅ ថា ភាពរឹង ប៉ឹងនៃបញ្ញា ។
អ្វីដែលពួកគេបានប្រតិកម្មនឹងអ្វីដែលពួកគេបានធ្វើជាសាក្សី » ។
ចុះ ហេតុអ្វីបានជាគេមិនសួរ ។
« កម្មករមកពីប្រទេសផ្សេងអាច មកធ្វើការ នៅ ទីនេះ ។
ដូច្នេះ អ្នក រាល់គ្នាធ្វើជាសាក្សីទាស់នឹងខ្លួនថា អ្នក រាល់គ្នាជាកូនចៅរបស់អ្នកដែលបានសម្លាប់ព្យាការី ។
( គាត់មិនដឹងថាត្រូវនិយាយយ៉ាង ណាទេ ពួកគេភ័យខ្លាច ជាខ្លាំង ។ )
ភ្នែកគេមាន តែមើលមិនឃើញ ។
« ពេលនោះ ទេវតាមួយអង្គបានលេចមក ឯទ្រង់ពីស្ថាន សួគ៌ ដោយពង្រឹងដល់ទ្រង់ » ។
ផ្លូវវែងឆ្ងាយសម្រាប់អ្នកដែលមិនស្គាល់ផ្លូវ
គេថាខ្លួនជា សាសន៍យូដា តែគេមិនមែនគេកុហកទេ ។
ហោរាបានសរសេរអ្វីដែលព្រះ បានប្រាប់ពួកគេ ។
១១ ពន្លឺភ្លឺមកលើមនុស្សសុចរិត ហើយមាន ចិត្តរីករាយចំពោះអំពើ ល្អ ។
« គាត់មិនទន់ខ្សោយក្នុងការ ទាក់ទងនឹងអ្នកទេ ប៉ុន្តែគាត់មានអំណាចក្នុងចំណោមអ្នក រាល់គ្នា ។
« តែទេវតាប្រាប់គេថា កុំខ្លាចអី ខ្ញុំនាំ ដំណឹងល្អដល់អ្នក រាល់គ្នា ដែលនឹងមានដល់មនុស្សទាំង អស់ » ។
នោះហើយជាមូលហេតុចម្បងដែលខ្ញុំយក ២០នាក់ » គាត់បានពន្យល់នៅពេលនោះ ។
មនុស្ស សុចរិត អាច លាក់ ខ្លួន បាន យ៉ាង ងាយ ក្នុង ចំណោម មនុស្សលោកិយ ។
ពេលចូលទៅជិតឪពុករបស់គេ គាត់និយាយ ថា៖ « មកជាមួយខ្ញុំ ។
ហើយទូល ថា៖ « លោកម្ចាស់អើយ សូមអាណិតមេត្ដាដល់កូនផង ដ្បិតគាត់កើតជំងឺឆ្កួតជ្រូក ហើយឈឺធ្ងន់ណាស់ ព្រោះគាត់ធ្លាក់ក្នុងភ្លើងជាញឹក ញាប់ ហើយធ្លាក់ទឹកជាញឹក ញាប់ ។
ដូច្នេះ ចូរសុំព្រះអម្ចាស់នៃអ្នកច្រូតកាត់ឲ្យបញ្ជូនកម្មករទៅក្នុងចំការ របស់ទ្រង់ » ។
បើគេដឹងច្បាស់ពី ភាព ស្របច្បាប់នៃអ្វីដែលគេធ្វើ ហេតុអ្វីបានជាពួកគេត្រូវរក្សាទុកជាការ សម្ងាត់ ? » ។
អ្នកណា បដិសេធ ព្រះបិតា និង ព្រះរាជ បុត្រា អ្នក នោះ ជា អ្នក ប្រឆាំង ព្រះគ្រិស្ដ » ។
« ឥឡូវនេះមានជម្លោះក្នុងចំណោមពួកគេ ដែលថាតើពួកគេមួយ ណាគួរចាត់ទុកថាធំជាងគេ ។
ខ្លួនគាត់មិនមែន ជាពន្លឺទេ - គាត់មកគ្រាន់ តែជាសាក្សីចំពោះពន្លឺប៉ុណ្ណោះ ។
ការពិត នៅ ចំពោះមុខ ពួកគេ ដូច្នេះ ពួកគេ អាច យល់ បាន ។
គ្រប់គ្រាន់ នៅ ថ្ងៃ នោះ គឺជា អំពើ អាក្រក់ របស់ វា និង អ្វី ៗ ទាំងអស់ ។
ដូច្នេះ ចូរសុំដល់ព្រះ យេហូវ៉ានៃការ ច្រូតកាត់ឲ្យចាត់កម្មករទៅក្នុងស្រែរបស់ទ្រង់ » ។
