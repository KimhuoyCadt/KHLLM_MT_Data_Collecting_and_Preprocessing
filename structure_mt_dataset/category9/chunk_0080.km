អរគុណ ព្រះ សម្រាប់ ការមាន សិទ្ធិ អំណាច ចុងក្រោយ លើ អ្វី គ្រប់ យ៉ាង ដែល កើតឡើង នៅក្នុង ជីវិត របស់ អ្នក ។
សេវាកម្ម គឺ ល្អ ឥត ខ្ចោះ ហើយ ម្ចាស់ ផ្ទះ មាន ភាព គួរសម និង មាន ប្រយោជន៍ ។
យើង ទាំងអស់ គ្នា ត្រូវតែ រស់ នៅ ជាមួយ វា ទោះបីជា ក្នុង នាម នៃ វឌ្ឍនភាព នៃ ចរន្ត ទឹក ក៏ដោយ ។
អ្នក ប្រឆាំង ដែល មាន សតិសម្បជញ្ញៈ ចូរ ប្រយ័ត្ន ។
មិន ថា ស្ថានភាព អាច អាក្រក់ យ៉ាងណា នោះ ទេ វា គឺជា អ្នក ដែល សម្រេចចិត្ត ថា ត្រូវ ឆ្លើយតប យ៉ាងណា ចំពោះ វា ។
នៅថ្ងៃដ៏រុងរឿងនោះ ត្រែនឹងបន្លឺឡើង ហើយគ្រប់ទាំងជង្គង់នឹងលុតចុះ ហើយសារភាពថា ទ្រង់ជាស្តេចនៃស្តេច និងជាព្រះ‌ អម្ចាស់នៃព្រះ‌ អម្ចាស់ ។
ពេល ខ្លះ ពួកគេ កាន់ អាវុធ ផងដែរ ។
មួយ ទៀត នៃ ព្រះវិញ្ញាណ ។
មាន គ្រូបង្រៀន និង សិស្ស ដទៃ ទៀត ។
នេះ បាន ធ្វើឱ្យ ភ្នាក់ងារ និង អ្នកនិពន្ធ រាប់ ពាន់ នាក់ ជាប់គាំង ។
ចន្លោះ នេះ ត្រូវបាន គេ ហៅ ថា គ្មាន តំបន់ ខាងមុខ ។
« គាត់រក្សាសមត្ថភាព ចរចានៅពេលដែលវាផ្តល់ ផលប្រយោជន៍ដល់រដ្ឋាភិបាល និងគាបសង្កត់នៅពេលរដ្ឋាភិបាលត្រូវបានគេគំរាម » ។
កុំព្រួយព្រោះ តែអ្នក ណាដែលចម្រើនទៅតាមផ្លូវរបស់ខ្លួន …» ។
ខ្ញុំ ស្រលាញ់ ការឱប ទាំងអស់ ហើយ ស្រលាញ់ នៅ ទីនោះ ។
ទឹកដី នៃ សុភមង្គល ជាតិ សរុប
ពួកគេ បាន ស្លាប់ មិន អាច បង្កើតឡើងវិញ បាន ទេ ។
ចូល ទៅកាន់ ហ្គេម កីឡា ដែល គាំទ្រ ។
ប៉ុន្តែ គ្រាន់តែ ភ្នែក មួយ ។
កុំប្រើថ្នាំសម្អាតដែលមានសំណឹក ហើយវានឹងមានរយៈពេលយូរ ។
ព្រះវិញ្ញាណ បរិសុទ្ធ ជួយ មើល ថែ ខ្ញុំ » ។
« ព្រះ មាន បន្ទូលមកយើងតាម រយៈមនុស្ស
ត្រូវ ប្រាកដ ថា អាន បន្ថែម ដើម្បី មើល រូបភាព ។
ត្រូវ ចាំ ថា មាន មនុស្ស នៅ ទីនោះ ដើម្បី វាយ អ្នក ផងដែរ ។
ផ្ទះ ចុងក្រោយ នៅ ខាងឆ្វេង ឆ្នាំ ២០០៩ ល្អ ជាង ផ្ទះ ដើម
គេមិនខ្មាសគេទេ ហើយពេលគេ ស៊ាំនឹងអ្នក គេត្រឡប់មកវិញរាល់ឆ្នាំ ។
ប៉ុន្តែវាក៏អាចកើតមានចំពោះស្ត្រីដែរ។
ខ្ញុំ អរ ព្រះគុណ ព្រះជាម្ចាស់ ពួកគេ ទាំងអស់ គ្នា មាន សុវត្ថិភាព ។
ការ វះកាត់របស់ខ្ញុំជិតបានជា សះស្បើយហើយ ហើយខ្ញុំមានអារម្មណ៍ល្អ ជារៀងរាល់ថ្ងៃ ។
របារ ស្ករគ្រាប់ បាន បាញ់ មុន ។
ពួកគេអស់រយៈពេលជាយូរមកហើយបានរៀបចំកម្មវិធីមួយសម្រាប់ពួកគេពីការ ដែលពួកគេមក
ខ្ញុំមានការ ភ្ញាក់ផ្អើលយ៉ាងខ្លាំងចំពោះហេតុការណ៍នៅព្រឹកនេះ ។
កូន របស់ ខ្ញុំ តែងតែ ដឹង ថា ខ្ញុំ ជា អ្នក ពន្លត់ អគ្គីភ័យ ។
អ្នក គឺជា ឧបសគ្គ សម្រាប់ ខ្ញុំ ។ ដ្បិតអ្នកមិននៅខាងព្រះ ទេ គឺជាមនុស្ស វិញ » ។
តាម ការពិត កញ្ឆា មាន កម្រិត ខ្ពស់ ។
តាមដែលខ្ញុំអាចប្រាប់បាន គាត់ពិតជាបានលះបង់ជីវិតរបស់គាត់ដើម្បីនោះ ។
ឥឡូវនេះ ដើម្បីជួយយើងយល់ពីបញ្ហានេះ ខ្ញុំបាន អញ្ជើញ Dr .
បាទ រឿង ព្រេង ទីក្រុង នេះ ជា ការពិត ។
ហើយត្រូវបានគេកំណត់ពេលដើម្បីសមត្ថភាព គឺមិនអាច ប្រែក្លាយខ្លួនគេបានទេ » ។
១៥ ប៉ុន្តែ ព្រះអម្ចាស់មានព្រះបន្ទូលទៅគាត់ ថា៖ « ចូរទៅចុះ ព្រោះបុរសនេះជាឧបករណ៍ដែលខ្ញុំជ្រើស រើស ដើម្បីដាក់ឈ្មោះខ្ញុំនៅចំពោះមុខ សាសន៍ ដទៃ ស្ដេច និងកូនចៅអ៊ីស្រាអែល ។
ពួកគេ មិន ត្រូវការ គម្រប ទេ ទុក ឱ្យ ពួកគេ ដកដង្ហើម ។
អ្នក មាន គំនិត យើង មាន ដំណោះស្រាយ ។
នៅ ពេល ដែល ពួកគេ យល់ ពី ទំនួល ខុសត្រូវការងារ របស់ ពួកគេ ពួកគេ នឹង ធ្វើ វា ដោយ មិន បាច់ សុំ ជំនួយ ពី អ្នកដទៃ ។
គាត់ គឺជា អ្នកគាំទ្រ ការធ្វើដំណើរ ។
ជា ឧទាហរណ៍ អនុញ្ញាតឱ្យ យើង ដឹង ថា ចិត្ត វិទ្យា របស់ ស្ត្រី មាន រូបរាង
ខ្ញុំ អាច ជួយ អ្នក ក្នុង ការ៖
អ្នកខ្លះបានចាកចេញពីមួយ រយៈពេលក្រោយមក ហើយអ្នកខ្លះមកពេលក្រោយ ។
ចម្លែក ណាស់ វា ជា ការពិត ថ្ងៃ នេះ ។
អ្នកណា ធំ ជាង ការបាក់បែក
អាថ៌កំបាំងមួយបានលេចចេញជាបន្តបន្ទាប់ ។
ហើយមនុស្សគិតថាយើងជាមនុស្សគ្មានសីលធម៌នៅខាងត្បូង ?
ជាពិសេស សម្រាប់ អ្នក ដែល មិន ទាន់ ត្រៀមខ្លួន ។
ខ្ញុំអាចស្វែងរកមនុស្សដែលត្រឹមត្រូវដើម្បីជួយខ្ញុំ កាន់កាប់ពិភពលោក ។
ឬ នាង នឹង ទទូច ថា នាង គ្រាន់តែ មិន ចាប់អារម្មណ៍ នឹង ទំនាក់ទំនង ជាមួយ គាត់ ?
មួយ សប្តាហ៍ ក្រោយមក ខ្ញុំ បាន ទៅ ដោយ គ្មាន ឯកសណ្ឋាន ហើយ ខ្ញុំ អាច មើល មិន ឃើញ ។
វាជាផ្នែកខាងមុខដែលធ្វើឲ្យខ្ញុំយល់ច្រឡំ ។
មនុស្សជាច្រើនមិនអាចត្រូវបាន សង្គ្រោះបានទេ » ។
រឿង សំខាន់ គឺ ពិតជា អាច បង្ហាញ ប្តី របស់ អ្នក ថា អ្នក នឹង នៅ ទីនោះ ដែល មាន បំណង សម្រាប់ គាត់ ដោយ មិន គិត ពី គាត់ ចង់ឱ្យ អ្នកសម្តែង ។
ពិភពលោក ប៉ុន្តែ ប្រសិនបើ អ្នក នឹង មិន ដាក់ នៅក្នុង
ហើយធ្វើឲ្យវាបែក ជារបៀបដែលទ្រង់ធ្វើឲ្យផែនដីរស់ឡើងវិញ បន្ទាប់ពីវាគ្មានជីវិត ។
គាត់ អាច ធ្វើដំណើរ តាម អ៊ីនធឺណិត ។
តើវាជាការ បែងចែកអាយុខ្លីឬទេ ?
បាវ ។ ការ លក់ទំនិញរបស់ពួកគេ និងយកព័ត៌មាន និងនិយាយដើមពីក្រុង ។
កំដៅនិងតឹងបានធ្វើឱ្យគាត់ ញ័រ។
លោក រដ្ឋមន្ត្រី បាន សង្កត់ធ្ងន់ ថា នៅក្នុង ប្រទេស ដែល មាន មនុស្ស 3.8 លាន នាក់ ប្រើប្រាស់ អ៊ីនធឺណិត ជាប្រចាំ ហើយ មនុស្ស 1.8 លាន នាក់ ជា អ្នកប្រើប្រាស់ សកម្ម នៅលើ Facebook បច្ចេកវិទ្យា និង ទូរស័ព្ទ ឆ្លាតវៃ លែង ត្រូវបាន បង្ខាំង ក្នុង គោលបំណង កម្សាន្ត និង ទំនាក់ទំនង ប៉ុន្តែ ពួកគេ ក៏ អាច ជា ឧបករណ៍ ផ្តល់ ព័ត៌មាន ដ៏ រឹងមាំ ផងដែរ ។ និង អ្នកជំរុញ ការផ្លាស់ប្តូរ សង្គម ។
ត្រូវដឹងថាច្បាប់គឺល្អ បើអ្នក ណាប្រើច្បាប់នោះ ។
« ហើយគ្មានសេចក្ដីសង្គ្រោះនៅក្នុងអ្នក ណាទៀតឡើយ ដ្បិតគ្មានឈ្មោះ ណាមួយនៅក្រោមស្ថាន សួគ៌បានប្រទាន មកក្នុងចំណោមមនុស្សដែលយើងត្រូវ សង្គ្រោះឡើយ » ( កិច្ចការ ៤: ១២) ។
