ខ្ញុំចង់ក្លាយជាការ លើកទឹក ចិត្តដល់អ្នកគាំទ្រ និងមនុស្សមិនត្រឹម តែនៅក្នុងសង្វៀនប៉ុណ្ណោះទេ ប៉ុន្តែក៏នៅក្រៅសង្វៀនដែរ » ។
តាមទ្រព្យ សម្បត្តិនៃព្រះគុណរបស់ព្រះអង្គ ដែលព្រះអង្គបានប្រទាន មកយើង ។
យ៉ាងណាមិញ អ្នកបង្កើតសន្តិភាពមាន ពរហើយ ព្រោះពួកគេនឹងត្រូវបានហៅថាជាកូនរបស់ព្រះ។
ប៉ុន្តែលោកថា លោកមិនបានលាតត្រដាងពីអាថ៌កំបាំងរដ្ឋណាមួយឡើយ ។
លើស ពី នេះ ទៀត ដើម្បី ធ្វើឱ្យ ប្រព័ន្ធ មាន
គ្មានអ្នក ណាជឿថាលោក ហូ
សូមអរគុណអ្នកដែលបានគាំទ្រ និងអ្នកដែលគោរពចៅហ្វាយរបស់ពួកគេអរគុណ » ។
ម្នាក់ទៀតបានឆ្លើយ ថា៖ « កម្មវិធីនានាមានកេរ្តិ៍ឈ្មោះសម្រាប់រឿងនេះ ។
ជឿ ថា ក្នុង ករណី អគ្គីភ័យ នៅក្នុង មួយ នៃ
" ខ្ញុំ ក៏ គាំទ្រ រឿង នេះ ដែរ ដោយសារ ការ ជាប់ ទាក់ទង គ្នា ខ្លាំង រវាង ប្រភេទ នៃ ឧក្រិដ្ឋកម្ម ទាំង នេះ និង អត្រា ប្រេវ៉ាឡង់ នៃ ការរំលោភ ផ្លូវភេទ " ។
អ្នកផ្សេងទៀតមិនអាចយល់អ្វីដែលពួកគេកំពុង តែនិយាយ ដូច្នេះពួកគេទាំងអស់គ្នានៅស្ងៀម ។
ពួកគេសួរគាត់ ថា៖ « តើយើងត្រូវធ្វើអ្វីដើម្បីបំពេញកិច្ចការរបស់ព្រះ? » ។
ប៉ុន្តែ វា ត្រឹមត្រូវ ព្រោះ វា ជា ភាសា សកល ។
ប៉ុន្តែសម្រាប់សំណាងអាក្រក់របស់ខ្ញុំ ពួកគេមិនអាចជួយខ្ញុំចេញពីរដ្ឋនេះបានទេ ។
រន្ធត់ណាស់ពេលឮថាជាប់នៅរដ្ឋកាលីហ្វ័រញ៉ា ។
ជន ពាល គឺជា វិញ្ញាណ សេរី ។
តើយើងអាចធ្វើយ៉ាង ណាដើម្បីស្ដារអំណាចជូនប្រជាពលរដ្ឋ ? » ។
ពេលឃើញព្រះអង្គក៏ថ្វាយបង្គំព្រះអង្គ ។ ប៉ុន្តែ អ្នក ខ្លះ សង្ស័យ ។
ពេលឃើញព្រះអង្គក៏ថ្វាយបង្គំព្រះអង្គ ។ ប៉ុន្តែ អ្នក ខ្លះ សង្ស័យ ។
វា ច្បាស់ ណាស់ ថា ពួកគេ ទាំងអស់ នឹង ត្រូវបាន ហៅ ។
ដូច្នេះ គេចាប់គាត់ ហើយសម្លាប់គាត់ ហើយបោះគាត់ចេញពីចំការ ។
ខ្ញុំមិនចង់បានកូនរបស់ខ្ញុំ ,
នៅក្នុង C យើង អាច សរសេរ ដូច ខាងក្រោមៈ
ត្រឡប់ មកពី ប្រទេស អាល្លឺម៉ង់៖
១៤ ខ្ញុំត្រូវមានកាតព្វកិច្ចទាំង សាសន៍ក្រិច និងអ្នកមិនក្រិក ទាំងអ្នក ប្រាជ្ញ និងមនុស្សល្ងង់ ។
ខ្ញុំមិនយល់ថា បុរសដែលចាប់ផ្ដើមវាជា សង្ឃទេ ។
កូនចៅយ៉ាកុប ឬអ៊ីស្រា ‌ អែលបានរស់នៅ ជាយូរមកហើយនៅស្រុកអេស៊ីប នៅលើដីដែលព្រះចៅផារ៉ោនប្រគល់ឲ្យ ។
វិធីសាស្រ្ត ដំបូង ដែល នាំឱ្យ អ្នក កំណត់ អត្តសញ្ញាណ ដោយ អ្នក មើល ! .
ការងារ បែប នេះ ទាមទារ ភាព រឹងមាំ ។
ហេតុ នេះ អ្វីដែលព្រះ បានរួមគ្នា គ្មានបុគ្គល ណាបំបែកចេញឡើយ ។
ដោយមិនព្រមជេរប្រមាថគ្នាទៅ វិញ ទៅមក ។
ប្រហែលជាមានអ្វីខុសគ្នានៅ ទីនេះ … ។
បូជាចារ្យស្នាក់នៅមាត់ទ្វារជាមួយទាហានប្រាំមួយ រយនាក់ ។
នៅ ពេល ដែល អ្នក ឈឺ រ៉ាំរ៉ៃ
ពី ភាពរីករាយ របស់ ពួកគេ ដោយ ភ្លេច ពី ហ្វូង មនុស្ស ដែល ព្យួរ លើ ពួកគេ ។
ហើយ ប្រសិនបើ ទ្រង់ ស្រឡាញ់ យើង ។
ម៉ាស៊ីន ត្រជាក់ ជា បច្ចេកវិទ្យា ...
តើអ្នកមិនដឹងទេថាវាជាអំពើ បាបរបស់អ្នកដែលគាត់បានដឹងដោយទុក្ខព្រួយ ?
យ៉ាង ណាមិញ នេះនៅមិនទាន់បញ្ជាក់ថានៅពេល ណានោះទេ ។
« ជួបផ្ទាល់ជាមួយលោកអធិការបតីខ្ញុំនឹង។
( ស្វែងរក ) សៀវភៅ គួរឱ្យ ចាប់អារម្មណ៍ ជាច្រើន នៅ បណ្ណាល័យ ។
ដោយ ចំណាយ ពេល មើល យ៉ាង ពិតប្រាកដ អ្នក ក៏ នឹង រៀន មើល ផងដែរ ។
បូជាចារ្យបានលាន់មាត់ ថា៖ « តើអ្នកសោកស្ដាយចំពោះអំពើ បាបរបស់អ្នកទេ ? » ។
មានអំពើអាក្រក់នៃការ មិនអើពើ ។
ពួកគេដាក់ខ្លួនបានល្អ ហើយមាន ភាព រីក ចម្រើន ទោះបីជាពួកគេមិនមែនជាអ្នកអង្គុយល្អក៏ដោយ ។
អ្នក អាច ធ្វើ ដូចនេះ មុនពេល ចាក់ ។
“ វាជាដំណើរការ ដ៏លំបាកមួយ ហើយខ្ញុំគិតថាគាត់បានធ្វើបានច្រើន ។
« ទ្រព្យ សម្បត្តិដែលទទួលបានដោយអំពើអាក្រក់នឹងគ្មានប្រយោជន៍អ្វីឡើយ ប៉ុន្តែសេចក្ដី សុចរិតជារបស់ដែល សង្គ្រោះពីសេចក្ដី ស្លាប់ » ។
ព្រះជាម្ចាស់ ទ្រង់ នឹង ឆ្លើយ ។
ស្ត្រី ដ៏ ស្រស់ស្អាត ដែល ជា ដៃគូ របស់ គាត់ ។
នោះ មិន មែន គ្រាន់តែ ជា ការយល់ឃើញ ទេ ក្រុមហ៊ុន កំពុង មាន បញ្ហា ។
ម៉ាស៊ីន បោះពុម្ព ឡាស៊ែរ ថ្មី អ្នក នឹង ត្រូវ ប្រយ័ត្ន -
អ្នកធ្វើដំណើរ ។
" ប្រជាជន អង់គ្លេស បាន ធ្វើ ការសម្រេចចិត្ត យ៉ាង ច្បាស់លាស់ ដើម្បី ដើរ លើ ផ្លូវ ផ្សេង ហើយ ខ្ញុំ គិត ថា ប្រទេស នេះ តម្រូវ ឱ្យ មាន ការដឹកនាំ ថ្មី ដើម្បី យក វា ទៅក្នុង ទិសដៅ នេះ " ។
អំពី អ្នកណា ដែល មាន និន្នាការ ។
សូម្បីតែតាក់ស៊ីក៏រកមិនឃើញដែរ ។
ខ្ញុំនិងក្រុមគ្រួសាររបស់ខ្ញុំ សប្បាយ ចិត្តក្នុងការ ស្នាក់នៅទីនោះម្តងទៀត » ។
ដូច្នេះ រក្សា ជាមួយ ពហុ នាម ពួកវា មាន តម្លៃ វា ក្នុង រយៈពេល វែង !
សន្និសីទ នីមួយ ៗ ផ្តោត លើ ក្រុមប្រឹក្សា សន្តិសុខ របស់ អង្គការ សហ ប្រជាជាតិ ។
ប្រសិនបើ អ្នក ធ្វើ ដូច្នេះ អ្នក អាច ក្លាយជា កម្មសិទ្ធិ ។
សវនាការលើករណីឃាតកម្មលើបុរសត្រូវបាន ពន្យារ ពេលម្តងទៀត ។
ដូច្នេះ លោកយេស៊ូបានស្វាគមន៍ពួកគេ ហើយចាប់ផ្ដើមមាន ប្រសាសន៍ទៅពួកគេអំពីរាជាណាចក្ររបស់ព្រះ ហើយព្យាបាលអ្នកដែលត្រូវការ ការ ព្យាបាល ។
ការពិន័យ ផ្សេង ៗ អាច ត្រូវបាន អនុវត្ត នៅពេល ព្យាយាម
« សូមជម្រាបសម្តេចថា យើងបានត្រឡប់មកវិញហើយ .. . ហើយយើងមានបំណងចង់យកអ្វីដែលជាកម្មសិទ្ធិរបស់យើងមកវិញដោយត្រឹមត្រូវ។
បបូរមាត់របស់អ្នក រាល់គ្នាដែលនឹកឃើញគាត់ទាំង ស្រុង !
តើ ពួកគេ នឹង បន្ត ការអភិវឌ្ឍន៍ ជារៀងរហូត ទេ ?
រកមើល នៅលើ ស្មា របស់ ពួកគេ ខណៈពេល ដែល នៅក្នុង ទីផ្សារ នា ពេល អនាគត ។
ក្មេង ចូលចិត្ត បង្ហាញ ខ្លួន ឯង ។
អ្នកត្រូវបានទទួលខុសត្រូវ។ - ពី ខ្ញុំ បន្តិច ។ -
