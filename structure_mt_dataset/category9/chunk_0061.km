ប្រទេស អ៊ីតាលី នឹង ត្រូវ ទម្លាក់ ចេញ ពី តំបន់ អឺរ៉ូ
តាមពិត មិន មែន ជា ព្រះយេស៊ូវ ទេ ដែល បាន ធ្វើ ពិធី ជ្រមុជ ទឹក ប៉ុន្តែ ជា អ្នកកាន់ តាម ទ្រង់ ។
ជំនឿរបស់នាងលើការ ដឹងអំពីព្រះបន្ទូលរបស់ព្រះ អាចហៀរចេញ ។
ខ្ញុំ ដឹង ថា អ្នកណា ជា អ្នក សម្លាប់ កូនស្រី ខ្ញុំ ។
យើង រីករាយ ក្នុង ការបម្រើ ក្នុង ដំណាក់ របស់ ព្រះ។
ដើម្បី ក្លាយជា បច្ចុប្បន្ន អ្នក គឺជា ការចងក្រង អតីតកាល របស់ អ្នក ។
ពេល នោះ នាងងក់ ក្បាល មក ខ្ញុំ ហើយ ចង្អុល ទៅ ផ្នែក ខាងស្តាំ នៃ សាឡុង ។
ហើយ ផ្តល់ ជា អំណោយ ដល់ សមាជិក គ្រួសារ របស់ អ្នក ។
អស់អ្នក ណាដែលជឿលើទ្រង់ ទទួលបានការ អត់ទោស បាបតាម រយៈព្រះនាមទ្រង់ ? » ។
៦ ដូច្នេះ ចូរយើងកុំ ងងុយ គេងដូចអ្នក ដទៃទៀតឡើយ ប៉ុន្តែចូរយើងនៅ តែភ្ញាក់ ហើយមាន ចិត្តស្ងប់ ។
ហើយ ពិតប្រាកដ ណាស់ ទ្រង់ បាន ទទួលយក ការបដិសេធ របស់ ប្រជាជន ដែល ទ្រង់ បាន យាង មក ដើម្បី សង្គ្រោះ ។
ហើយ ជា ការពិត បំណងប្រាថ្នា របស់ ពួកគេ ត្រូវបាន ផ្តល់ ដោយ ផ្នែក ដោយ មហា អំណាច ។
ខ្ញុំ ចូលចិត្ត វិធី ដែល គាត់ និយាយ ។
ដំណាំរដូវ រងាគឺនៅក្នុងនិងមានលក្ខណៈគ្រប់គ្រាន់ដោយខ្លួនឯង។
កំពុង ងាក ទៅ រក គ្នា ទៅ វិញ ទៅ មក ដើម្បី បន្ធូរបន្ថយ ការឈឺចាប់ និង ទុក្ខ ព្រួយ របស់ ពួកគេ ។
ម្ដាយរបស់គាត់ដែលធ្លាប់ធ្វើជាអ្នក បម្រើ - ជិតទាសករ - ពេលគាត់កើត ។
31 « កុំងាកទៅរកមេ ធ្មប់ ឬគ្រូ ធ្មប់ កុំស្វែង រកពួកគេ ហើយធ្វើឲ្យខ្លួនឯងមិនបរិសុទ្ធដោយ សារពួកគេឡើយ យើងជាព្រះ អម្ចាស់ ជាព្រះ របស់អ្នក ។
មាន « ជម្លោះក្នុងចំណោមពួកគេ ដែលថាតើមួយ ណាគួរចាត់ទុកថាធំជាងគេ » ។
ខ្ញុំក៏ចាប់អារម្មណ៍ខ្លាំងលើទីផ្សារឌីជីថលដែរ ។
អ្នកដែលត្រូវបានតែងតាំងឲ្យទទួលជីវិតអស់ កល្ប ជានិច្ចបានជឿ ។
ដូច្នេះ គេ នាំគាត់ទៅ ឯម៉ូសេ ។
អាហារ ប្រសិនបើ អ្នក មក មហាវិទ្យាល័យ ជើង ទទេ ។
គាត់ បាន ជួយ ខ្ញុំ ច្រើន ហើយ ពួកយើង ជា បងប្អូន នៅ ទីនេះ ។
« កុំប្រាប់អ្នក ណាម្នាក់នូវអ្វីដែលអ្នកបានឃើញឡើយ ដរាប ណាកូនមនុស្សបានរស់ឡើង វិញ » ។
ឥឡូវនេះ ធី ម៉ូថេបានត្រឡប់មកវិញ ហើយគាត់បាននាំ ដំណឹងល្អ មកយើងអំពីជំនឿ និងសេចក្ដី ស្រឡាញ់របស់អ្នក ។
យកចិត្តទុកដាក់ ចំពោះ របៀប ដែល អ្នកស្តាប់ ; សម្រាប់អ្នកដែលមាន នោះនឹងត្រូវបានផ្តល់បន្ថែមទៀត ។
ទឹកត្រជាក់ណាស់ » ។
ពួកគេ ទាំងអស់ គ្នា បាន បន្ទាប ខ្លួន ហើយ ទូល សូម ព្រះជា ម្ចាស់ ឲ្យ ធ្វើដំណើរ ប្រកបដោយ សុវត្ថិភាព ( ខ. ២១) ។
ខ្ញុំដឹងថាគាត់នឹងមិនសម្លាប់នរណាម្នាក់ឡើយ » ។
គាត់ បាន សន្យា ថា នឹង រៀបការ ជាមួយ ខ្ញុំ បន្ទាប់ពី រៀន ។
បើទោះបីជាពួកគេមួយដងក្នុងមួយខែ » ។
ដោយ បាន ប្រមូល ចំណេះដឹង យ៉ាង ច្រើន ពី វា ។
ថ្ងៃ គឺ សម្រាប់ អ្នក ទាំងអស់ គ្នា ហើយ រីករាយ នឹង ទូក សមុទ្រ និង ទេសភាព ។
ទាំង នេះ អាច ត្រូវបាន ប្រើ សម្រាប់ ពាណិជ្ជកម្ម និង ការប្រើប្រាស់ ផ្ទាល់ខ្លួន ។
ចូរឲ្យភ្នែកគេងងឹតមើលមិនឃើញ ហើយបែរខ្នងទៅជារៀងរហូត » ។
ចាប់ពីពេលនេះទៅ អ្នកស្គាល់គាត់ ហើយបានឃើញគាត់ហើយ !» ។
ពួកគេនឹងនៅក្នុងសេចក្ដី មេត្តា ក រុណារបស់ទ្រង់ជានិច្ច ។
« ទាំងបុរសនេះ ឬឪពុកម្ដាយរបស់គាត់មិនបានប្រព្រឹត្តអំពើ បាបទេ ប៉ុន្តែវាបានកើតឡើង ដើម្បីឲ្យកិច្ចការរបស់ព្រះ បានបង្ហាញក្នុងជីវិតរបស់គាត់ » ។
គាត់ត្រូវបានចោទប្រកាន់ក្រោម បទប្រើប្រាស់កុំព្យូទ័រ និងច្បាប់សន្តិសុខអ៊ីនធឺណិត ។
កសិករត្រូវអាម៉ាស់ហួសកម្រិត ។
យ៉ាង ណាតោះទៅមើលថានៅទី ណា៖
២៧ លោកឆ្លើយទៅគេ ថា៖ « ខ្ញុំប្រាប់អ្នក រាល់គ្នាហើយ តែអ្នក រាល់គ្នាមិនស្ដាប់ទេ ហេតុអ្វីបានជា ឮម្ដងទៀត ?
ភាពផ្ទុយ គ្នា ខ្លាំង នៃ អ្នក ជឿ និង អ្នក មិន ជឿ
នាងនឹងត្រូវជាន់លើអ្នក ណាដែលជ្រើសរើសដើរតាម ។
នេះជាទីក្រុងដែលខ្ញុំស្រឡាញ់ » ។
« បិតារបស់ខ្ញុំតែងតែធ្វើការ រហូតដល់សព្វថ្ងៃនេះ ហើយខ្ញុំក៏ធ្វើការ ដែរ » ។
ដោយ សារគាត់ជាមនុស្សសុចរិត គាត់ត្រូវរងទុក្ខ វេទនាក្នុងព្រលឹងពីមួយថ្ងៃទៅមួយថ្ងៃ ដោយ សារអ្វីដែលគាត់បានឃើញ និង ឮ ។
ខ្ញុំលះបង់ជីវិតដើម្បីចៀម ។
" ហើយសម្រាប់ពេលនេះ យើងចង់ក្រោកឈរឡើងវិញ ហើយអនុញ្ញាតឱ្យមានសំឡេងសំខាន់ ៗបន្ថែមទៀតឱ្យឮ " ។
មានមនុស្សជាច្រើននិយាយថា ហេ ស្តាប់។
កុំ បារម្ភ គាត់ គ្រាន់តែ ចង់ ធ្វើជា មិត្ត របស់ អ្នក ។
ប្រសិនបើ អ្នក មាន បងប្អូន បង្កើត ចូរ រាប់បញ្ចូល ពួកគេ តាំងពី ដំបូង មក ។
នៅសម័យ បច្ចុប្បន្ន លើកលែងតែ ពួកគេ ។
យើងបានជឿ ហើយដឹងថាទ្រង់ជាព្រះ ដ៏បរិសុទ្ធនៃព្រះ» ។
អ្នកនឹងសួរថា “ តើមួយល្អជាងមួយទៀតឬ ?
សព្វថ្ងៃនេះ ស្ត្រីមានសេរីភាព » ។
ក្នុងទ្រង់ យើងមានការ ប្រោសលោះតាម រយៈព្រះលោហិតរបស់ទ្រង់ ការ អត់ទោស បាប ស្របតាម ភាពសម្បូរបែបនៃព្រះគុណរបស់ព្រះ
« ចូរអ្នក មកពីក្រោយខ្ញុំ ( ឬ " ដូច្នេះ " នៅក្នុងការ អានខ្លះ ) សាតាំង ដ្បិតអ្នកកំពុងគិតដូចមនុស្សគិត ហើយមិនដូចព្រះ គិតនោះទេ ។
ហើយ អ័ដាម មិន មែន ជា អ្នក ដែល ត្រូវបាន បញ្ឆោត ទេ ។ វាគឺជាស្ត្រីដែលត្រូវបានគេបញ្ឆោត ហើយបានក្លាយជាមនុស្សមាន បាប » ។
គាត់ បាន និយាយ ថា " យ៉ាងហោចណាស់ យើង បាន ឱ្យ គាត់ ទៅ ផ្ទះ ដើម្បី នៅ ជាមួយ ឪពុក ម្តាយ របស់ គាត់ ដែល ជា កន្លែង ដែល ពួកគេ សប្បាយរីករាយ ណាស់ ដែល បាន ជួប គាត់ ទោះបីជា គាត់ ស្ថិត ក្នុង ស្ថានភាពលំបាក យ៉ាងណា ក៏ដោយ " ។
មិន អាច សម្រាក បន្ទាប់ពី ការងារ ពេញ មួយ ថ្ងៃ ?
សេចក្តី ថ្លែងការណ៍នោះបាននិយាយថា៖ « នេះគឺជាមនុស្ស ក្លាហាន ស្លេកស្លាំង និងមិនចេះចប់មុន។
ហើយ ដាក់ វា ក្នុង ទម្រង់ ត្រឹមត្រូវ ។
អេសាយ 2:17 ភាពខ្ពង់ខ្ពស់របស់មនុស្សនឹងត្រូវក្រាបចុះ ហើយ ភាពក្រអឺត ក្រទមរបស់មនុស្សនឹងត្រូវបន្ទាបចុះ ។ ព្រះអម្ចាស់ តែមួយអង្គគត់នឹងត្រូវលើក ត ម្កើងនៅថ្ងៃនោះ ។
នេះគឺដើម្បីជា សញ្ញានៃសេចក្ដី សញ្ញារវាងខ្ញុំនិងអ្នក ។
« ត្រូវថ្លែងទំនាយម្ដងទៀតលើប្រជាជាតិ ប្រជាជាតិ ភាសា និងស្ដេចជាច្រើន » ។
យើងនឹង នាំគេចេញពីស្រុកដែលគេស្នាក់នៅ ប៉ុន្តែគេមិនចូលទៅក្នុងទឹកដីអ៊ីស្រា ‌ អែលឡើយ ។
ខ្ញុំ ដឹង ថា អ្នកណា សំខាន់ បំផុត ក្នុង ជីវិត របស់ ខ្ញុំ ។
