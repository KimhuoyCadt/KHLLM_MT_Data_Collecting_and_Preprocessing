« ខ្ញុំមិនស្លាប់ទេ តែមានជីវិត ហើយប្រកាសអំពីកិច្ចការដែល មកពីព្រះ យេហូវ៉ា ។
ទិញ នៅក្នុង តំបន់ ដែល មាន ការ ចង់បាន ។
ស្ត្រីម្នាក់ត្រូវបានគេចាប់រំលោភ៣៧ ដង ។
ការអធិស្ឋាន និង ភ្លេង ការ ដែល បាន បន្លឺ ឡើង នៅក្នុង
ទាយ អ្វី ដែល ខ្ញុំ បាន រកឃើញ អំពី ពាក្យបញ្ជា ធម្មតា ។
អ្នក ត្រូវបាន កោតសរសើរ ដោយ មនុស្ស ជាច្រើន ។
វិវរណៈ 1:20 សេចក្តី អាថ៌កំបាំងនៃផ្កាយទាំងប្រាំពីរដែលអ្នកបានឃើញនៅដៃស្ដាំរបស់ខ្ញុំ និងជើង ចង្កៀងមាសទាំងប្រាំពីរគឺដូច តទៅ : ផ្កាយប្រាំពីរជាទេវតានៃពួកជំនុំទាំងប្រាំពីរ ហើយជើង ចង្កៀងទាំងប្រាំពីរ ជាព្រះវិហារទាំងប្រាំពីរ ។
ចូរបង្ហាញខ្លួនទៅពួកបូជាចារ្យ » ។
ប្តីរបស់នាងបានប្តឹងលែងលះគ្នានៅថ្ងៃទី ២ ខែវិច្ឆិកា ឆ្នាំ ២០១៧ ។
ពួកគេនឹងត្រូវគេចងដៃជើងជាប់នឹង កដោយខ្សែច្រវាក់ ច្រវាក់ ធ្វើឲ្យពួកគេលើសទម្ងន់ ។
ដល់ ពេល ទឹក ឡើង
សេចក្តីស្រឡាញ់ របស់ នាង !
តើយើងកំពុងណាត់គ្នាជាផ្លូវការ ?
ជនគណនា 32:18 យើងនឹងមិនត្រឡប់មកផ្ទះវិញឡើយ ដរាប ណាកូនចៅអ៊ីស្រា ‌ អែលទាំងអស់បានចូល មកក្នុង មរតករបស់ខ្លួន ។
ការ បញ្ចេញសំឡេងឱ្យបានត្រឹមត្រូវគឺមានសារៈ សំខាន់ខ្លាំងណាស់ ) ។
25 ប៉ុន្តែប៉ុលបាននិយាយថា៖ « ខ្ញុំមិនខឹងទេ ឯកឧត្តមភេស្ទុសអើយ ខ្ញុំកំពុង តែនិយាយពាក្យពិត និងដោយ ចិត្តគំនិត ។
ខ្ញុំឆ្ងល់ថាតើរឿងទាំងនេះត្រូវបានគេនិយាយឱ្យត្រង់ទៅក្នុងពិភពលោកក្រោយឬអត់ ?
ពេល ខ្លះ គាត់ នៅ ម្នាក់ឯង ។
គឺ 46:9 ចូរនឹក ចាំពីអតីតកាល ដ្បិតខ្ញុំជាព្រះ ហើយគ្មានអ្វីផ្សេងទៀតឡើយ ។ ខ្ញុំ ជា ព្រះ គ្មាន អ្នកណា ដូច ខ្ញុំ ទេ
មកដល់ពេលនេះ សាស្ត្រាចារ្យចំនួន ១២ បានចូលរួមក្នុងកម្មវិធី ។
ពេលចោទប្រកាន់គាត់ទៅតុលាការម្សិល មិញ គាត់បានឆ្លើយ ថា៖ « មាន ទោស » ។
“ ខ្ញុំមិនប្រាកដថាវាលេងដល់ចំណុចខ្លាំងរបស់យើងទេ ។
ការ កប់ទាំងរស់នឹងប្រសើរជាងការ ដាក់ទណ្ឌកម្មដែលពួកគេត្រូវរងទុក្ខ ។
យើង កំពុង ស្វែងរក ស្រស់ /
12:17 បន្ទាប់មកអ្វីដែលបាននិយាយតាម រយៈព្យាការីអេសាយត្រូវបានសម្រេចដោយនិយាយថា :
ខ្ញុំដឹងថាខ្ញុំនឹង រីករាយនឹងការ សំយោគនេះ » ។
ខ្ញុំនឹកឃើញថាឪពុកខ្ញុំកំពុងឈរនៅ រាន ហាលជាមួយ ...
ដំណើរ ទស្សនកិច្ចរបស់ឯក អគ្គ រដ្ឋទូតអាមេរិក និងភរិយា
" ពិភពលោក ទាំងមូល ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ មេកំណាច " ។
ហើយនៅពេលគេធ្វើដូច្នេះ គេមិនគួរទទួល ទោសអ្វីឡើយ » ។
និក្ខម នំ 19:19 ពេលដែលសំឡេង ត្រែបន្លឺឡើង កាន់ តែខ្លាំង លោកម៉ូសេ ក៏មាន ប្រសាសន៍ ហើយព្រះ ក៏ឆ្លើយ តបវិញដោយសំឡេង ។
គាត់មាន ប្រសាសន៍មកខ្ញុំថា អ្នក ទាំងនេះជា ដែលបានចេញពីទុក្ខ វេទនា ជាខ្លាំង ហើយបានបោកសម្លៀក បំពាក់ ហើយធ្វើឲ្យពួកគេមានពណ៌ ស ក្នុងឈាមកូនចៀម » ( វិវរណៈ ៧: ១៤) ។
គាត់នឹងបាន បញ្ចប់អាហារបីមុខដែលបានផ្តល់ជូនបងប្រុសរបស់គាត់ ។
ថ្ងៃ មួយ ខ្ញុំ បាន ឃើញ ការ៉េម
ល្បែង កំសាន្ត របស់ អាមេរិក ត្រលប់ មកវិញ ហើយ ។
ខ្ញុំ ប៉ុន្តែគាត់នៅយូរមកហើយ គាត់មានអាយុប៉ែតសិបឆ្នាំហើយ » ។
ជួបគ្នា នៅ ទីនោះ ព្រហ្ម ចារី របស់ ខ្ញុំ រត់ លើ ផ្លូវ ។
ខ្ញុំ នឹង វាយ អ្នកបើកបរ របស់ ខ្ញុំ ប្រសើរ ជាង ។
ហើយ បម្រើ ឪពុក ម្តាយ របស់ ពួកគេ ក្នុង ព្រះនាម នៃ ព្រះអម្ចាស់ ។
វា ស្អាត និង ច្បាស់ ហើយ វា ធ្វើឱ្យ អ្នក មានអារម្មណ៍ ល្អ ។
ខ្ញុំ៖ ប៉ុន្តែវាគ្រាន់ តែទៅផ្ទះ ។
ប្រាជ្ញា របស់ ពួក ឥសី ។
បងប្អូន ស្រី គ្មាន សៀវភៅ ការសិក្សា ឬ សេចក្ដីអធិប្បាយ ដ៏ មាន ឥទ្ធិពល ដូច ព្រះបន្ទូល ដ៏ មាន ព្រះជន្មរស់ របស់ ព្រះទេ !
និង ថា ការត្រួសត្រាយ នៃ សាមសិប បួន
វា ត្រូវតែ ត្រូវបាន បង្កើតឡើង ដោយសារតែ ការបំផ្លិចបំផ្លាញ ។
មិន ដូច ខ្ញុំ ទេ អ្នក ពោរពេញ ដោយ ជីវិត ។
របៀប ពិការ ភ្នែក ទ្វេ ។
ខ្ញុំគ្រាន់ តែមានអារម្មណ៍ថាវាជាការ ទទួលខុសត្រូវច្រើនជាង ។
វា អាច ធ្វើឱ្យ អ្នក ឆ្លងកាត់ ច្រើន ជាង អ្វី ដែល អ្នក គិត ។
ពេល គាត់ ព្យាយាម ពន្យល់ គាត់ បដិសេធ ខ្លួន ឯង ។
ខ្ញុំ ជា អ្នក កែសម្រួល កីឡា សម្រាប់ កាសែត ប្រចាំ សប្តាហ៍ តូច មួយ ។
គាត់ បាន ធ្វើដំណើរ និង ធ្វើដំណើរ ។
ពួកគេ នឹង ឃើញ ដូច្នេះ ។
តាមការ ចោទប្រកាន់ ខ្លឹមសារនៃសៀវភៅនេះត្រូវបានគេស្គាល់តែ ៥ នាក់ផ្សេងទៀត ។
នេះ ជា ព្រះបន្ទូល របស់ ព្រះសម្រាប់ ថ្ងៃ នេះ៖
វាចោទជាសំណួរថា ' តើអ្នក ណានឹង នាំយើងត្រឡប់ពីមាត់នៃការ បំផ្លាញ ?
យុត្តិកម្ម ដោយ ព័ត៌មាន មូលដ្ឋាន ។
ខ្ញុំ សង្ស័យថាគាត់មិនបានភ្លេច ។
ត្រូវបាន ដាក់ នៅក្នុង ការចាប់ឆ្នោត ដើម្បី ឈ្នះ រង្វាន់ ហើយ អ្នក ឈ្នះ នឹង ត្រូវបាន ចាប់ ដោយ ចៃដន្យ ។
ខ្ញុំដឹងរឿងនេះព្រោះខ្ញុំធ្លាប់ទៅមើលទម្ងន់ ម្តង ។
ថ្ងៃ មួយ ប្តី ប្រពន្ធ មួយ គូ កំពុង ឈ្លោះគ្នា ។
មាន ពួកគេ រាប់ ពាន់ នាក់ ហើយ ពួកគេ បាន បង្កើត ជា ផ្លូវ ដ៏ ក្រាស់ ។
សុភាសិត 30:32 « ប្រសិនបើអ្នកបានលេងសើច ហើយលើក ត ម្កើងខ្លួនឯង ឬបើអ្នកបានគ្រោងអាក្រក់ ចូរ ទះដៃបិទមាត់អ្នក !
មន្ត្រី ពន្ធនាគារ បាន ប្រាប់ AFP ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ ថា ពន្ធនាគារ ទូទាំង ប្រទេស នឹង ចាប់ផ្តើម ដោះលែង មនុស្ស ជាង ២៣.០០០ នាក់ នៅ ថ្ងៃសៅរ៍ ។
ឪពុករបស់នាងនិយាយថា ' តើអ្នកបានញ៉ាំសាច់នៅថ្ងៃនេះទេ ? '
លក្ខណៈដែលពួកគេកំពុងស្វែង រក » ។
១៩ « អាជីពពិតរបស់មនុស្សគឺរកផ្លូវទៅខ្លួន » ។
ជាច្រើន បាន កើតឡើង នៅក្នុង វិស័យ វេជ្ជសាស្ត្រ ចាប់តាំងពី ឆ្នាំ 1973 ។
