( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ កងពល តូច លេខ ៧០ បាន រៀបចំ ចាក់ វ៉ាក់សាំង ការពារ កូវីដ - ១៩ នៅ ទីបញ្ជាការ កងពល ដែល មាន អង្គភាព ចំណុះ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក ចំនួន ៥ អង្គភាព មាន ដូច ជា៖
ការចាក់ វ៉ាក់សាំង នៅ ថ្ងៃ ដំបូង ទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ យោធិន ដែល ចង់ និង ស្ម័គ្រចិត្ត ចាក់ មាន ចំនួន ១១៩៩ នាក់ ។
សូម ជំរាប ថា ការចាក់ វ៉ាក់សាំង នេះ ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ នាង ផាត រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង ការពារ ជាតិ . នាយ ឧត្តមសេនីយ៍ ស៊ុ សំណាង អគ្គ នាយក អគ្គ នាយកដ្ឋាន ភស្តុភារ និង ហិរញ្ញវត្ថុ នៃ ក្រសួង ការពារ ជាតិ . ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ មេបញ្ជាការ កងពល តូច លេខ ៧០ និង មេបញ្ជាការ នៅ តាម បណ្តា អង្គភាព ដែល ពាក់ព័ន្ធ ដ៏ទៃ ទៀត ។
សូម បញ្ជាក់ ថា ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ នេះ ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ បាន ដឹកនាំ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ កងពល តូច លេខ ៧០ ចាក់ វ៉ាក់សាំង ស៉ី ណូហ្វាម ប្រឆាំង ជំងឺ កូវីដ - ១៩ ដែល ជា ជំនួយ របស់ រដ្ឋាភិបាល សាធារណៈ រដ្ឋ ប្រជាមានិត ចិន ។
ថ្លែង ក្នុង ឱកាស នោះ ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ បាន មានប្រសាសន៍ ទៅកាន់ នាយ ទាហាន ពល ទាហាន ទាំងអស់ ថា ត្រូវ ជឿជាក់ លើ វ៉ាក់សាំង ស៉ី ណូហ្វាម នេះ ព្រោះ ទម្រាំ ផលិត បាន វ៉ាក់សាំង មួយ គឺ មាន ការគិតគូរ និង សិក្សា ល្អិតល្អន់ ជា ទីបំផុត ដូច្នេះ កុំ មាន ការព្រួយបារម្ភ នៅពេល ចាក់ ដោយ គ្រាន់តែ អនុវត្ត តាម ការណែនាំ របស់ គ្រូពេទ្យ ជំនាញ ឲ្យបាន ត្រឹមត្រូវ ។
មួយវិញទៀត ត្រូវ ជឿជាក់ លើ ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ និង ខ្ពង់ខ្ពស់ បំផុត របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល ទទួលយក វ៉ាក់សាំង ស៉ី ណូហ្វាម នេះ មក ចាក់ ជូន ប្រជាពលរដ្ឋ កម្ពុជា ដោយ ឥត គិត ថ្លៃ ពីសំណាក់ សាធារណៈ រដ្ឋ ប្រជាមានិត ចិន ។
វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ របស់ ចិន ចំនួន ៦០ ម៉ឺន ដូស នេះ ជា ប្រភេទ វ៉ាក់សាំង ស៉ី ណូហ្វាម ដែល ផលិត ដោយ រដ្ឋាភិបាល ចិន បាន បញ្ជូន មកដល់ ប្រទេស កម្ពុជា កាលពី រសៀល ថ្ងៃទី ៧ ខែកុម្ភៈ ៕ ឯក អគ្គ រដ្ឋទូត អ៊ីតាលី ប្រចាំ ប្រទេស កុងហ្គោ ត្រូវបាន គេ សម្លាប់ ក្នុង ការវាយប្រហារ មួយ នៅ ភាគ ខាងកើត ប្រទេស មួយ នេះ
( រ៉ូម ) ៖ ក្រសួង ការបរទេស អ៊ីតាលី បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា ឯក អគ្គ រដ្ឋទូត របស់ ខ្លួន ប្រចាំ សាធារណរដ្ឋ កុងហ្គោ និង ប៉ូលីស យោធា ម្នាក់ ដែល ធ្វើដំណើរ ជាមួយ គាត់ ត្រូវបាន គេ បាញ់ សម្លាប់ នៅក្នុង ការវាយប្រហារ ទៅ លើ ក្បួន រថយន្ត នៃ អង្គការ សហ ប្រជាជាតិ នៅ ភាគ ខាងកើត ប្រទេស ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន Arab News នៅ ថ្ងៃចន្ទ ទី២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ ។
ភ្លាម ៗ នេះ មិន ទាន់ មាន ព័ត៌មាន លម្អិត ពាក់ព័ន្ធ នឹង ហេតុការណ៍ នេះ នៅឡើយ ទេ ៕
សាលា រាជធានី ភ្នំពេញ ចេញ សេចក្តីណែនាំ ពី ការរឹតបន្តឹង ការអនុវត្ត វិធានការ គម្លាត សុវត្ថិភាព សង្គម និង គម្លាត សុវត្ថិភាព បុគ្គល ដើម្បី ទប់ស្កាត់ កូវីដ១៩
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួម ទប់ស្កាត់ និង រួមគ្នា ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ក្នុង « ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ » រដ្ឋបាល រាជធានី ភ្នំពេញ សូម ណែនាំ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ម្ចាស់ កម្មវិធី ម្ចាស់ អាជីវកម្មដ្ឋាន អាជ្ញាធរ មូលដ្ឋាន មន្ទីរ - អង្គភាព ជំនាញ និង គ្រប់ ភាគី ពាក់ព័ន្ធ ត្រូវ បន្ត យកចិត្តទុកដាក់ អនុវត្ត តាម គោលការណ៍ ណែនាំ របស់ ក្រសួង សុខាភិបាល ជាពិសេស ជំរុញ ការអនុវត្ត ឱ្យ បាន ម៉ឺងមាត់ បំផុត នូវ វិធានការ « ៣ ការពារ និង ៣ កុំ » របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ដើម្បី ឈាន ទៅ គ្រប់គ្រង បាន « ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ » រដ្ឋបាល រាជធានី ភ្នំពេញ សូម ធ្វើ ការណែនាំ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ម្ចាស់ កម្មវិធី ម្ចាស់ អាជីវកម្មដ្ឋាន និង គ្រប់ ភាគី ពាក់ព័ន្ធ ត្រូវ ចូលរួម អនុវត្ត ឱ្យ ម៉ឺងម៉ាត់ បំផុត នូវ វិធានការ គម្លាត សុវត្ថិភាព សង្គម និង គម្លាត សុវត្ថិភាព បុគ្គល ។
ក្នុង ករណី នៅតែ មិន ព្រម អនុវត្ត តាម វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ម្ចាស់ កម្មវិធី និង ម្ចាស់ អាជីវកម្មដ្ឋាន ត្រូវ ប្រឈមមុខ នឹង ការបិទ កម្មវិធី ឬ អាជីវកម្មដ្ឋាន ព្រមទាំង ត្រូវ ទទួល ទោស ទណ្ឌ ទៅ តាម ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន ។
រដ្ឋបាល រាជធានី ភ្នំពេញ ចាត់ ឱ្យ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ ក្នុង នាម គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ . រដ្ឋបាល សង្កាត់ និង មន្ទីរ - អង្គភាព ជំនាញ ជុំវិញ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ ចុះ ទៅ ត្រួតពិនិត្យ ទីតាំង ប្រារព្ធ កម្មវិធី ជួបជុំ ទាំងអស់ ដើម្បីឱ្យ ម្ចាស់ កម្មវិធី និង ម្ចាស់ អាជីវកម្មដ្ឋាន អនុវត្ត ឱ្យ ខាងតែ បាន នូវ រាល់ វិធានការ ការពារ ទាំងអស់ ខាងលើ ឱ្យ មាន ប្រសិទ្ធភាព និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ៕
( ភ្នំពេញ ) ៖ ដំណើរការ សាងសង់ អាកាសយានដ្ឋាន អន្ដរជាតិ ភ្នំពេញ ថ្មី ដែល មាន ទីតាំង ស្ថិត នៅ ស្រុក កណ្ដាល ស្ទឹង និង ស្រុក ស្អាង ខេត្ត កណ្ដាល និង ស្រុក បាទី ខេត្ត តាកែវ កំពុង ដំណើរការ ទៅ យ៉ាង រលូន ដោយ មិន មាន អ្វី ដែល នាំឲ្យ រាំងស្ទះ នោះ ឡើយ ហើយ គម្រោង នេះ នឹង បញ្ចប់ ទៅ តាម ផែនការ ដែល បាន កំណត់ នៅ ឆ្នាំ ២០២៣ ។
នេះ បើ តាម ការឲ្យដឹង ពី លោក ម៉ៅ ភិរុណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កណ្ដាល ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន ដែល រៀបចំ ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ ក្រោម ប្រធានបទ « វឌ្ឍន៍ ភាព មូលដ្ឋាន ឃុំ សង្កាត់ និង ទិសដៅ បន្ដ របស់ ខេត្ត កណ្ដាល » នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ។
លោក ម៉ៅ ភិរុណ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ការអភិវឌ្ឍ នេះ យើង បាន ដំណើរការ ទៅ តាម ផែនការ គ្រោង នៅក្នុង ឆ្នាំ ២០២៣ ឲ្យបាន ផ្លូវ មិន ទាំង៤ នោះ ទេ គឺ អាច បាន ផ្លូវ១ ឬ ២ សម្រាប់ នៅក្នុង ការដាក់ ឲ្យ ដំណើរការហោះហើរ បឋម ដំបូង ហើយ យើង នឹង អភិវឌ្ឍន៍ ជំហ៊ាន បន្ដ បន្ទាប់ ទៀត ដូច្នេះ បាន សេចក្ដី ថា ព្រលានយន្ដហោះ នេះ កំពុង ដំណើរការធម្មតា មិន មាន ជាប់គាំង នោះ ទេ » ។
បើ តាម លោក ម៉ៅ ភិរុណ នៅក្នុង តំបន់ ដែល គ្រោង សាងសង់ ព្រលានយន្តហោះ អាជ្ញាធរ បាន ដោះស្រាយ ទំនាស់ ដីធ្លី ជាមួយ ប្រជាពលរដ្ឋ ស្ទើ រួចរាល់ ទំាងស្រុង ហើយ ពោលគឺ នៅសល់ តិចតួច ទៀត ប៉ុណ្ណោះ ដែល កំពុង ពន្លឿន ការដោះស្រាយ ឲ្យ រួចរាល់ នៅពេល ឆាប់ ៗ នេះ ។
លោក បាន បន្ដ ថា ចំពោះ បញ្ហា ដោះស្រាយ ដី គឺ កំពុងតែ សម្របសម្រួល ជាមួយ ប្រជាពលរដ្ឋ តាមរយៈ ការផ្លាស់ប្តូរ ដី ជាមួយ ប្រជាពលរដ្ឋ ការទិញ ពី ប្រជាពលរដ្ឋ ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ទទួលបាន សំណង លក្ខណៈ សមរម្យ ដោយ មិន មាន ការបង្ខិតបង្ខំ ការគំរាមកំហែង ឬ ក៏ បណ្តេញ ប្រជាពលរដ្ឋ ចេញ សម្រាប់ ការវិនិយោគ នោះ ទេ ។
ដោយឡែក ក្រុមហ៊ុន របស់ អ្នក ឧកញ៉ា ពុង ឃាវ សែ កាន់កាប់ ភាគហ៊ុន ៩០ ភាគរយ ដោយ វិនិយោគ ទឹកប្រាក់ ចំនួន ១.៥០០ លាន ដុល្លារ អាមេរិក ក្នុង នោះ ទឹកប្រាក់ ១. ១០០ លាន ដុល្លារ ជា កម្ចី ពី ធនាគារ បរទេស និង ២៨០ លាន ដុល្លារ ជា របស់ ក្រុមហ៊ុន OCIC និង ២៨០ លាន ដុល្លារ ទៀត ជាដើមទុន ចុះបញ្ជី ៕ គណបក្ស ប្រជាជន កម្ពុជា ចូលរួម កិច្ចប្រជុំ សង្ខេប ខ្លឹមសារ ស្តីពី « ដំណើរ រឿង របស់ គណបក្ស កុម្មុយនីស្ត ចិន ក្រោម ប្រធានបទ៖ ធ្វើឲ្យ ជីវិត ទាំងអស់ គ្នា ប្រសើរឡើង » តាម ប្រព័ន្ធ វីដេអូ
កិច្ចប្រជុំ នេះ មាន ការអញ្ជើញ ចូលរួម ដោយ ផ្ទាល់ និង តាម ប្រព័ន្ធ អ៉ីនធឺណែត ពី ប្រតិភូ ចំនួន ជាង ៣០០ រូប និង ៨០ ប្រទេស ព្រមទាំង មាន ការចូលរួម ពី គណបក្ស នយោបាយ អង្គការ សង្គម ស៉ីវិល អ្នកសារព័ត៌មាន និង ក្រុម អ្នកប្រាជ្ញ (Think Tank) ក្នុង តំបន់ និង ពិភពលោក ប្រមាណ ជាង ២០០ រូប ។
លោក ទេព ង ន បាន ថ្លែង សុន្ទរកថា គន្លឹះ ដោយ បាន គូសបញ្ជាក់ ថា ជំងឺ កូវីដ - ១៩ បាន និង កំពុង គំរាមកំហែង យ៉ាង ធ្ងន់ធ្ងរ ដល់ សេដ្ឋកិច្ច សុខ មាលភាព និង អាយុជីវិត មនុស្ស រាប់ លាន នាក់ ជុំវិញ ពិភពលោក ។ ក្នុង ន័យ នេះ លោក បាន លើកទឹកចិត្ត ដល់ ប្រទេស ទាំងអស់ បន្ត ចាត់ទុក អាយុជីវិត សុវត្ថិភាព និង សុខភាព របស់ ប្រជាជន ជា អាទិភាព ខ្ពស់ ព្រមទាំង ជំរុញ សាមគ្គីភាព ជា សកល ដើម្បី ឆ្លើយតប នឹង ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ចក្ខុវិស័យ នៃ ការកសាង សហគមន៍ សុខភាព ពិភពលោក សម្រាប់ មនុស្ស ទាំងអស់ និង ស្មើ ៗ គ្នា ។
បើ តាម លោក ទេព ងន . ភាពក្រីក្រ គឺជា ឧបសគ្គ ចម្បង ចំពោះ ការសម្រេចបាន នូវ សិទ្ធិ មនុស្ស ។ ផលប្រយោជន៍ របស់ ប្រជាជន គួរតែ ត្រូវបាន គេ ចាត់ទុក ជា កិច្ចការ ដ៏ សំខាន់ បំផុត ហើយ ការអភិវឌ្ឍ គួរតែ ផ្តល់ នូវ អត្ថប្រយោជន៍ កាន់តែ ច្រើន ដល់ ប្រជាជន ទាំងអស់ ប្រកបដោយ សមធម៌ ។
លោក បាន ថ្លែង បញ្ជាក់ ថា គ្មាន គំរូ ណាមួយ ដែល ត្រូវ គ្រប់ ស្ថានភាព ទាំងអស់ នោះ ទេ សម្រាប់ ការការពារ និង ការធ្វើឱ្យ ប្រសើរឡើង នូវ ស្ថានភាព សិទ្ធិ មនុស្ស ។ ភាពចម្រុះ នៅក្នុង មាគ៌ា នៃ ការអភិវឌ្ឍ សិទ្ធិ មនុស្ស គួរ ត្រូវបាន គោរព ហើយ រាល់ ការប៉ុនប៉ង ទំាង ឡាយ ណា ក្នុង ការយក បញ្ហា សិទ្ធិ មនុស្ស ធ្វើជា បញ្ហា នយោបាយ ការអនុវត្ត ស្តង់ដារ ពីរ ឬ យក ហេតុផល សិទ្ធិ មនុស្ស ដើម្បី ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ ប្រទេស ដ៏ ទៃ គួរ ត្រូវបាន បដិសេធ ។
លោក បាន លើកទឹកចិត្ត ឲ្យ មាន ការខិតខំ ប្រឹងប្រែង រួមគ្នា របស់ គ្រប់ ភាគី ទាំងអស់ ដោយ ឈរ លើ គោលការណ៍ គោរព សិទ្ធិ អធិបតេយ្យ និង មិន ជ្រៀត ជ្រែក កិច្ចការ ផ្ទៃក្នុង របស់ រដ្ឋ ដទៃ ដើម្បី ជំរុញ និម្មាប នកម្ម អភិបាលកិច្ច ពិភពលោក ស្តីពី សិទ្ធិ មនុស្ស ដែល មាន សមធម៌ យុត្តិធម៌ បរិយាប័ន្ន និង មាន លក្ខណៈ ទូលំទូលាយ ជាង មុន ។
លោក បាន បន្ថែម ថា « ការជួបប្រជុំគ្នា នៅ ថ្ងៃ នេះ បាន ជួយ ឱ្យ យើង ទទួលបាន ការយល់ដឹង គ្រប់ ជ្រុងជ្រោយ និង ស៉ី ជម្រៅ អំពី គោល នយោបាយ របស់ ចិន ទាក់ទង នឹង ក្រុម ជនជាតិ ភាគ តិច និង ការអភិវឌ្ឍ តំបន់ ដែល មាន ប្រជាជន ជា ជនជាតិ ភាគ តិច រស់ នៅ ច្រើន រួមទាំង ស្ថានភាព ជាក់ស្តែង នៅ ស៉ីន ជាំង ដែល សេដ្ឋកិច្ច ស្ថិរភាព សង្គម សមភាព និង សាមគ្គីភាព ក្នុង ចំណោម ក្រុម ជនជាតិ ផ្សេង ៗ គ្នា និង ជីវភាព រស់ នៅ របស់ ប្រជាជន នៅតែ មាន ភាពប្រសើរ ឥត ឈប់ឈរ ។
លោក កោតសរសើរ ចំពោះ កិច្ចការ ដែល រដ្ឋាភិបាល ចិន បាន ធ្វើ ដើម្បី លើកកម្ពស់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម របស់ ក្រុម ជនជាតិ ភាគ តិច និង តំបន់ ដែល មាន ប្រជាជន ជា ជនជាតិ ភាគ តិច រស់ នៅ ច្រើន និង ការពារ សិទ្ធិ របស់ ពួកគេ ទាំងអស់ ឱ្យ មាន សេរីភាព ខាង ជំនឿ សាសនា និង អាច ប្រើ ភាសា របស់ ពួកគេ ផ្ទាល់ ហើយ សូម ប្រឆាំង នឹង ឥរិយាបទ របស់ មនុស្ស មួយចំនួន តូច និង ប្រទេស ខ្លះ ដែល បាន ញុះញង់ បំភ្លៃ ការពិត និង ប្រឌិត ព័ត៌មាន ចចាមអារ៉ាម បំភាន់មតិ អន្តរជាតិ មក លើ ស្ថានភាព នៅ ស៉ីន ជាំង ។
លោក ទេព ងន បន្ថែម ថា កម្ពុជា គាំទ្រ ការប្រយុទ្ធ ប្រឆាំង នឹង អំពើ ភេរវកម្ម និង គាំទ្រ វិធានការ ទាំងឡាយ ណា ដែល ធានា សិទ្ធិ អធិបតេយ្យ សណ្ដាប់ធ្នាប់ សង្គម សន្តិសុខ ជាតិ និង ការអភិវឌ្ឍន៍ ។ កម្ពុជា គោរព « គោល នយោបាយ ចិន មួយ » ហើយ ចាត់ទុក បញ្ហា តៃវ៉ាន់ ហុងកុង ទី បេ ស៉ីន ជាំង ជា កិច្ចការ ផ្ទៃក្នុង របស់ សាធារណរដ្ឋ ប្រជាមានិត ចិន ។
នៅ ចុងបញ្ចប់ អង្គប្រជុំ បាន ប្រកាស អនុម័ត សេចក្តីថ្លែងការណ៍ រួម ស្តីពី « ដំណើរ រឿង របស់ គណបក្ស កុម្មុយនីស្ត ចិន ៖ សេចក្តីសង្ខេប អំពី បញ្ហា នៅ ស៊ីន ជាំង »៕ ប្រធាន សកម្មជន ហ្វេសប៊ុក កម្ពុជា និង សហការី ១១រូប ត្រូវបាន តែងតាំង ជា ក្រុមការងារ ផ្សព្វផ្សាយ និង ទំនាក់ទំនង អង្គការ សង្គម ស៉ី វិល
( កណ្តាល ) ៖ លោកស្រី កុយ សុដានី ប្រធាន ក្រុមការងារ ផ្សព្វផ្សាយ និង ទំនាក់ទំនង អង្គការ សង្គម ស៉ីវិល នៅ ថ្ងៃសៅរ៍ ទី២០ ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ សេចក្ដីសម្រេច ស្ដីពី ការតែងតាំង បន្ថែម សមាសភាព ក្រុមការងារ ផ្សព្វផ្សាយ និង ទំនាក់ទំនង អង្គការ សង្គម ស៉ីវិល ដោយ មាន ការចូលរួម ពី ក្រុមការងារ ផ្សព្វផ្សាយ និង ទំនាក់ទំនង អង្គការ សង្គម ស៉ី វិល ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក និង គណៈកម្មាធិការ គណបក្ស ស្រុក កោះ ធំ សរុប ទាំងអស់ ចំនួន ៣២ រូប ។
ជា ទីបញ្ចប់ លោកស្រី ប្រធាន អង្គប្រជុំ បាន សម្ដែង នូវ សេចក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា សមាសភាព សមាជិក សមាជិកា ក្រុមការងារ ថ្មី ទាំង ១១រូប នេះ និង ចូលរួម ជាមួយ សមាជិក ទាំង ១៧រូប ផ្សេង ទៀត រួមគ្នា បំពេញ ការងារ ប្រកបដោយ ការទទួលខុសត្រូវ សាមគ្គីភាព សហការ ល្អ ក្នុង ស្មារតី យកចិត្តទុកដាក់ ខ្ពស់ ៕
ឥណ្ឌូណេស៊ី៖ គ្រោះ ទឹក ជំនន់ អាចនឹង វាយប្រហារ រដ្ឋធានីហ្សាការតា សា ជា ថ្មី ក្នុង សប្ដាហ៍ នេះ
( ហ្សាការតា) ៖ រដ្ឋធានីហ្សាការតា នៃ ប្រទេស ឥណ្ឌូណេស៊ី អាច ត្រូវ ប្រឈមមុខ នឹង គ្រោះ ទឹក ជំនន់ និង គ្រោះ រអិល បាក់ ដី បន្ថែម ទៀត នៅ សប្ដាហ៍ នេះ ខណៈ ទីភ្នាក់ងារ ឧតុនិយម បាន ព្យាករ ថា នឹង មាន ភ្លៀង ធ្លាក់ ពី កម្រិត មធ្យម ទៅ ខ្លាំង នៅ រយៈពេល ប៉ុន្មាន ថ្ងៃ ខាងមុខ នេះ ។ នេះ បើ យោង តាម ការចេញ ផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ថ្ងៃចន្ទ ទី២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ ។
បើ តាម ទីភ្នាក់ងារ ឧតុនិយម ឥណ្ឌូណេស៉ី ភ្លៀង ធ្លាក់ ខ្លាំង អាចនឹង វាយប្រហារ រដ្ឋធានីហ្សាការតា នៅ ល្ងាច ថ្ងៃចន្ទ នេះ ហើយ នឹង បន្ត រហូតដល់ ពេលព្រឹក ថ្ងៃអង្គារ ស្អែក នេះ ។ ភ្លៀង ធ្លាក់ នឹង មាន កម្រិត ទាប នៅ ថ្ងៃទី ២២ ខែកុម្ភៈ ប៉ុន្តែ វា អាចនឹង កើនឡើង ដល់ កម្រិត ធ្ងន់ នៅ ថ្ងៃទី ២៣ និង ថ្ងៃទី ២៤ ខែកុម្ភៈ ដែល អាច បង្កឱ្យ មាន គ្រោះ ទឹក ជំនន់ និង គ្រោះ រអិល បាក់ ដី ជា បន្តបន្ទាប់ នៅ រដ្ឋធានីហ្សាការតា និង តំបន់ ជាយ ៗ រដ្ឋធានី មួយ នេះ ។
គួរ បញ្ជាក់ ថា តំបន់ ជាច្រើន នៅក្នុង រដ្ឋធានីហ្សាការតា និង ទីក្រុង ជិតខាង Tangerang ទីក្រុង Bekasi ត្រូវបាន ជន់ លិច ដោយ ជំនន់ ទឹកភ្លៀង រហូតដល់ ខ្ពស់ ២ម៉ែត្រ កាលពី ថ្ងៃសៅរ៍ សប្ដាហ៍ មុន ។ កម្រិត ទឹកភ្លៀង ធ្លាក់ លើស ពី ១៥០ មីល្លីម៉ែត្រ ក្នុង មួយ ថ្ងៃ ត្រូវបាន គេ ចាត់ទុក ថា ធ្ងន់ធ្ងរ បំផុត ៕ ឧកញ៉ា លី យូ គៀក ចូល គាល់ ព្រះមហាក្សត្រ និង បាន ថ្វាយ ថវិកា ៥ម៉ឺន ដុល្លារ ព្រមទាំងអង្ករ ៥០តោន
( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ ព្រះករុណា ជា អម្ចាស់ ជីវិត លើ ត្បូង ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ព្រះអង្គ សព្វ ព្រះរាជ ហឫទ័យ ព្រះបរម រាជានុញ្ញាត ប្រោស ព្រះរាជ ទាន ជូន លោក ឧកញ៉ា លី យូគៀក ទីប្រឹក្សា សម្ដេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ជាតិ និង ក្រុមគ្រួសារ អញ្ជើញ ចូល ក្រាប ថ្វាយបង្គំ គាល់ នា ព្រះបរម រាជ វាំង ។
រោងចក្រ កែច្នៃ ស្វាយ និង បន្លែ ក្នុង តំបន់ អភិវឌ្ឍន៍ ស្តុក ក្រោល ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ នឹង លេច រូបរាង ឡើង នា ពេល ឆាប់ ៗ នេះ
( កំពង់ស្ពឺ ) ៖ គម្រោង អភិវឌ្ឍន៍ ស្តុក ក្រោល បាន សម្ពោធ ដាក់ ឲ្យ ដំណើរការ សាងសង់ រោងចក្រ កែរ ច្នៃ ស្វាយ បន្លែ លំនៅដ្ឋាន ដីឡូតិ៍ ផ្សារ មន្ទីពេទ្យ សម្ភព ២៤ ម៉ោង សាលារៀន និង ស្ថានីយ៍ ប្រេង ឥន្ទនៈ លើ ផ្ទៃដី សរុប ចំនួន ១៥ហិកតា ជា ផ្លូវការ ក្រោម អធិបធី ភាព លោកស្រី ឆៃ ច័ន្ទ រិទ្ធី សូលីដា រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន នៅ ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២១ ។
យោង តាម របាយការណ៍ នៅក្នុង តំបន់ អភិវឌ្ឍន៍ ស្តុក ក្រោល ស្ថិត នៅក្នុង ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ នេះ នឹង បើក រោងចក្រ មួយ មាន ១០អគារ ដើម្បី ផ្សាភ្ជាប់ ជាមួយ បណ្តុំ សហគ្រាស ដែល មាន ចក្ខុវិស័យ ទៅ លើ ការកែច្នៃ និង សម្អាត កសិផល រួម មាន៖ ដូចជា ផ្លែ ឈើ និង បន្លែ ដែល គ្រោង នឹង នាំចេញ ទៅកាន់ ទីផ្សារ អន្តរជាតិ ។
លោក អ៊ិន ឆាយ វ៉ាន ប្រធាន សមាគម ស្វាយ ខេត្ត កំពង់ស្ពឺ និង ជា ប្រធាន គម្រោង ស្តុក ក្រោល អភិវឌ្ឍន៍ បាន ឲ្យដឹង ថា ឆ្នាំ ២០២២ ខាងមុខ តំបន់ នេះ នឹង ក្លាយជា ទីប្រជុំជន មួយ ដែល ចាប់ យក កម្លាំង ពលកម្ម ស្រូបទាញយក ការ អភិវឌ្ឍ ក្នុង តំបន់ ដែល បាន ផ្តោត ទៅ លើ បណ្តុំ សហគ្រាស រៀបចំ ការកែច្នៃ ការលាង សម្អាត បន្លែ ផ្លែ ស្វាយ វេច ខ្ជប់ ដើម្បី នាំ ទៅ ទីផ្សារ អន្តរជាតិ ។ អ្វី ដែល ពិសេស ទៀត នោះ គម្រោង នេះ គឺ ផ្តល់ ឱកាស ការងារ ជូន ពលរដ្ឋ ក្នុង តំបន់ នេះ ប្រមាណ ២.៥០០ ដល់ ៣.០០០ នាក់ ។
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន បង្ហាញ តារា តម្លៃ ស្រូវ នៅ វាល ស្រែ ដែល កំពុង ប្រមូល ផល តាម បណ្តា ខេត្ត មួយចំនួន សម្រាប់ ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ ៕
ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២២ ខែកុម្ភៈ៖ បង្ក្រាប ២៣ករណី ឃាត់ខ្លួន ៥៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៣ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១១ករណី និង ជួញដូរ ១២ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥៦ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៥០៥ ករណី ឃាត់ មនុស្ស ១. ១៦២ នាក់ ( ស្រី ៥៣ នាក់ )៕
លោក Guterres បាន ថ្លែង នៅក្នុង ក្រុមប្រឹក្សា សិទ្ធិ មនុស្ស UN នៅ ទីក្រុង ហ្សឺណែវ យ៉ាង ដូច្នេះ ថា « យើង មើលឃើញ ការចុះខ្សោយ នៃ លទ្ធិ ប្រជាធិបតេយ្យ . ការប្រើ កម្លាំង ដ៏ ឃោរឃៅ . ការចាប់ ឃុំ ខ្លួន តាម អំពើចិត្ត និង ការបង្ក្រាប គ្រប់ ទម្រង់ ទាំងអស់ ។ ការរឹតត្បិត នៃ សេរីភាព ស៊ីវិល ។ ការវាយប្រហារ សង្គម ស៊ីវិល ។ ការរំលោភបំពាន យ៉ាង ធ្ងន់ធ្ងរ លើ ជនជាតិ ភាគ ច្រើន ដោយ គ្មាន ការទទួលខុសត្រូវ នៅក្នុង នោះ រួម មាន ទាំង ការបោសសម្អាត ជនជាតិ ដើម រ៉ូហ៊ីងយ៉ា ផងដែរ ... បញ្ជី នេះ ត្រូវ នៅ បន្ត កត់ត្រា ថែម ទៀត » ។
