( បន្ទាយមានជ័យ )៖ លោក ប៉ាន់ ខែម ប៊ុន ថន នាយក រង ខុទ្ទកាល័យ សម្តេច តេជោ ហ៊ុន សែន . លោក អ៉ំ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន ប្រគល់ ដី កម្មសិទ្ធិ ដែល ទទួលស្គាល់ ដោយ អាជ្ញាធរ មូលដ្ឋាន ភូមិ ឃុំ ស្រុក ជូន ប្រជាពលរដ្ឋ ជាង ២០ គ្រួសារ ឱ្យ មាន សិទ្ធិ កាន់កាប់ និង អាស្រ័យ ផល លើ ដី របស់ ខ្លួន ឡើងវិញ ក្រោយ មាន ក្រុមការងារ ខុទ្ទកាល័យ សម្តេច តេជោ ហ៊ុន សែន និង ក្រុមការងារ សាលា ខេត្ត បន្ទាយមានជ័យ បាន ដោះស្រាយ បញ្ចប់ វិវាទ តាម បែប ឈ្នះ ឈ្នះ ។
លោក អភិបាល ខេត្ត បាន សម្តែង ការអបអរសាទរ ចំពោះ ប្រជាពលរដ្ឋ ដែល ទទួលបាន សិទ្ធិ កាន់កាប់ និង អាស្រ័យ ផល លើ ដី របស់ ខ្លួន ឡើងវិញ នៅ ចំណុច បឹង ជង្រុក និង ៦៧១ ក្នុង ឃុំ ទួល ពង្រ ស្រុក ម៉ាឡៃ បន្ទាយមានជ័យ ជាមួយនឹង ឯកសារ ទទួលស្គាល់ ដោយ អាជ្ញាធរ មូលដ្ឋាន ភូមិ ឃុំ ស្រុក និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក ប៉ាន់ ខែម ប៊ុន ថន ដែល បាន ចុះ មក ជួយ ដោះស្រាយ បញ្ចប់ វិវាទ ដីធ្លី ដ៏ រ៉ាំរ៉ៃ តាម បែប ឈ្នះ ឈ្នះ ជូន ប្រជាពលរដ្ឋ ។
ក្នុង នាម អាជ្ញាធរ ខេត្ត បន្ទាយមានជ័យ លោក អភិបាល ខេត្ត នឹង ប្រឹងប្រែង ពន្លឿន ការអភិវឌ្ឍ តំបន់ នេះ ឱ្យ បាន លឿន បំផុត ពិសេស ការជំរុញ ឱ្យ ភ្លើង អគ្គិសនី និង ទឹក ស្អាត ដែល ជា មូលដ្ឋាន នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច គ្រួសារ ប្រជាពលរដ្ឋ ។
លោក ប៉ាន់ ខែម ប៊ុន ថន ក៏ បាន ក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ ត្រូវ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ និង អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ ទប់ស្កាត់ បង្ការ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ (COVID-19) តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ក៏ ដូចជា ប្រមុខ រាជ រដ្ឋាភិបាល ។
លោក ប៉ាន់ ខែម ប៊ុន ថន ក៏ បាន កោតសរសើរ ខ្ពស់ ចំពោះ កិច្ចសហការ ប្រកបដោយ ប្រសិទ្ធភាព របស់ ក្រុមការងារ សាលា ខេត្ត បន្ទាយមានជ័យ និង បញ្ជាការ ឯកភាព ខេត្ត បន្ទាយមានជ័យ ដែល បាន ជួយ ធ្វើឱ្យ ការដោះស្រាយ មាន ដំណើរ យ៉ាង ល្អ ប្រសើរ រហូត ឈាន មកដល់ ចំណុច ជោគជ័យ ដូច ថ្ងៃ នេះ ។ ពិសេស ថ្លែងអំណរគុណ ចំពោះ លោក ឧត្តមសេនីយ៍ បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ ដែល បាន ផ្តល់ កងកម្លាំង និង រថយន្ត សម្រាប់ ជួយ រើ រុះ និង ដឹកជញ្ជូន សម្ភារៈ ប្រជាពលរដ្ឋ ។
លោក ប៉ាន់ ខែម ប៊ុន ថន បាន បញ្ជាក់ ឱ្យដឹង ថា ចំពោះ ហេដ្ឋារចនាសម្ព័ន្ធ នៅក្នុង ទីតាំង ចំណុច អភិវឌ្ឍ ភូមិ បឹង ជង្រុក តេជោ ឈ្នះ ឈ្នះ ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត គឺ កំពុង មាន ដំណើរការ យ៉ាង សកម្ម ជារៀងរាល់ ថ្ងៃ ។ បន្ថែម លើ នេះ ក្រុមការងារ បាន និង កំពុង បន្ត សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ស្ថាប័ន អ្នក ច្បាប់ ដើម្បី ចាត់ វិធានការ ច្បាប់ ឱ្យ ខាងតែ បាន ចំពោះ ជន ខិលខូច ទាំងឡាយ ណា ដែល មាន សកម្មភាព ញុះញង់ បំភ្លៃ ការពិត ឬ ឆបោក ប្រជាពលរដ្ឋ ៕
* យុទ្ធសាស្ត្រ លោក បៃ ដិន
( ព្រះវិហារ ) ៖ លោក វេជ្ជបណ្ឌិត គួង ឡូ ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ បាន អំពាវនាវ ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង កម្លាំង នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ដែល បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ដូសទី១ កាល់ ពី ដើម ខែមីនា កន្លងទៅ សូម មក ទទួល ការចាក់ វ៉ាក់សាំង ដូស ទី២ ដែល ប្រព្រឹត្តិ ទៅ ចាប់ពី ថ្ងៃទី ១៧ រហូតដល់ ថ្ងៃទី៣០ ខែមីនា ឆ្នាំ ២០២១ ។
លោក ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ក៏ បាន បញ្ជាក់ ពី ពេលវេលា សម្រាប់ អ្នក ដែល ដល់ ពេល កំណត់ ក្នុង ការមក ទទួល វ៉ាក់សាំង ដូស ទី២ គឺ ត្រូវ មាន រយៈពេល ចន្លោះ ពី ១៤ ថ្ងៃ ហើយ ការចាក់ នេះ ធ្វើឡើង នៅ តាម ទីតាំង ចំនួន ២កន្លែង គឺ មន្ទីរពេទ្យ បង្អែក ១៦ មករា ខេត្ត ព្រះវិហារ និង មន្ទីរពេទ្យ បង្អែក ស្រុក ជាំ ក្សាន្ត ស្ថិត ក្នុង ស្រុក ជាំ ក្សាន្ត ។ យុទ្ធនាការ នេះ ចាប់ផ្តើម ពី ម៉ោង ៨ព្រឹក ដល់ ម៉ោង ១១ កន្លះ ថ្ងៃត្រង់ និង ចាប់ពី ម៉ោង២ ដល់ ម៉ោង ៤ ជារៀងរាល់ ថ្ងៃ ។
ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ក៏ បាន រំឮក ដល់ អ្នក ដែល បាន ចាក់ វ៉ាក់សាំង ដូស ទី២ បើ ទោះបី បាន ចាក់ រួច ក៏ ពិត មែន ប៉ុន្តែ កុំ ភ្លេច អនុវត្ត តាម វិធាន សុខាភិបាល គឺ រក្សា អនាម័យ ដោយ បន្ត លាង សម្អាត ដៃ ជាមួយ ទឹក អាល់កុល សាប៊ូ ឬ ជែល រក្សា គម្លាត សង្គម និង អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា គឺ ៣កុំ និង ៣ការពារ ឱ្យ បាន ខ្ជាប់ខ្ជួន ។
សូម បញ្ជាក់ ថា អ្នក មក ទទួល ការវ៉ាក់សាំង ត្រូវ ភ្ជាប់ មក ជាមួយ បណ្ណ ចាក់ វ៉ាក់សាំង លើក ទី១ ករណី មក យឺតយ៉ាវ ឬ លើស ថ្ងៃ ដែល បាន កំណត់ បន្ទាប់ពី បាន ចាក់ ដូសទី១ និង មិន អាច ចាក់ ដូស ទី២បាន ទេ ៕
អាជីវករ លក់ដូរ នៅមុខ ប្រាសាទ អង្គរវត្ត ត្អូញត្អែរ ពីរ ការ បាត់ ចំណូល ដោយសារ មិន មាន ភ្ញៀវ ទេសចរ
( សៀមរាប ) ៖ កាលពី មុន នៅ បរិវេណ មុខ ប្រាសាទ អង្គរវត្ត និង ខាងក្នុង នៅជិត ស្រះ ទឹក ខាងជើង មាន ការលក់ដូរ សំលៀកបំពាក់ និង វត្ថុអនុស្សាវរីយ៍ ជាច្រើន កន្លែង ។ បច្ចុប្បន្ន នេះ អាជ្ញាធរ ជាតិ អប្សរា បាន រៀបចំ ដាំ ដើមឈើ ស្មៅ និង ផ្កា ក៏ តម្រូវ ឱ្យ ពួកគាត់ មក លក់ដូរ នៅ ចំណត រថយន្ត វិញ ។
ការប្តូរ មក លក់ នៅមុខ ប្រាសាទ នេះ មាន រយៈពេល ២ឆ្នាំ ហើយ ហើយក៏ ស្រប ពេល ប្រទេស កម្ពុជា ក៏ ដូចជា ពិភពលោក ជួប វិបត្តិ ជំងឺ រាតត្បាត កូវីដ១៩ ហេតុ ដូច្នេះ ពុំ មាន ភ្ញៀវ ទេសចរ មក ទស្សនា ប្រាសាទ ដូន មុន ការលក់ដូរ ក៏ មិន សូវ ជា កាក់ កប នោះ ដែរ ។
នៅ មិន ឆ្ងាយ ប៉ុន្មាន ពី អ្នកលក់ ឯទៀត ដែល មាន តូប លក់ សំលៀកបំពាក់ និង វត្ថុអនុស្សាវរីយ៍ លាយ លំគ្នា ដែរ នោះ អ្នកស្រី មឿន សូត្រ មាន អាយុ ៥៦ ឆ្នាំ បាន ប្រាប់ ថា អ្នកស្រី លក់ នៅមុខ អង្គរ នេះ យូរ ឆ្នាំ មកហើយ គឺ លក់ តាំងពី កូន ៗ នៅ តូច ឥឡូវ ពួកគេ មាន អាយុ ២៦ ឆ្នាំ ហើយ ។
ងាក ទៅ ខាង មគ្គុទ្ទេសក៍ ដែល សុំ មិន បញ្ចេញ ឈ្មោះ បាន ប្រាប់ ថា លោក ធ្វើជា មគ្គុទ្ទេសក៍ ពី ឆ្នាំ ២០០៧ មក ហើយ ដោយសារ មិន ចង់ ធ្វើ ការ តាម ក្រុមហ៊ុន សណ្ឋាគារ ។ លោក បាន បន្ត ទៀត ថា ចាប់តាំងពី មាន ជំងឺ រាតត្បាត មក គាត់ មិន មាន ភ្ញៀវ ទេសចរ បរទេស ទេ មាន ភ្ញៀវ ទេសចរ ក្នុង ស្រុក ខ្លះ ៗ ដែល គាត់ ចង់ ដឹង ពី ប្រវត្តិ របស់ ប្រាសាទ អង្គរ ហើយ បាន ឱ្យ មគ្គុទេសក៍ នាំផ្លូវ គាត់ និង និយាយ រឿង ប្រវត្តិ ប្រាសាទ អង្គរ ដល់ ពួកគាក់ ដែល ប្តូរ នឹង កម្រៃ បន្តិចបន្តួច មកវិញ ។
បុគ្គលិក គ្រឹះស្ថាន អង្គរ មួយ រូប បាន បង្ហើប ប្រាប់ ថា រាល់ ថ្ងៃ នេះ មិន មាន ភ្ញៀវ ទេសចរ បរទេស ទេ មាន តែ ទេសចរ ក្នុង ស្រុក ហើយ បើ មាន ភ្ញៀវ ទេសចរ បរទេស ក៏ តិចតួច ដែរ គឺ ក្នុង មួយ ថ្ងៃ មាន ពី ៤ ឬ ៥នាក់ ហើយ ពួកគាត់ សុទ្ធតែ អ្នក ប្រកបរបរ នៅក្នុង ស្រុក ខ្មែរ ៕ ចាប់ខ្លួន មេ ការ២នាក់ និង អ្នក ពាក់ព័ន្ធ ករណី លួច បើក ខារ៉ាអូខេ បំពាន វិធានការ រាជ រដ្ឋាភិបាល នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ បាន ចាប់ខ្លួន មេ ការ២នាក់ និង អ្នក ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ក្នុង ហាង មួយ កន្លែង ដែល មាន យីហោ ឈ្មោះ « សម្រស់ ជាយ ក្រុង » ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ករណី លួច បើក ខារ៉ាអូខេ បំពាន វិធានការ រាជ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
ការបង្ក្រាប ករណី លួច បើក សកម្មភាព ខារ៉ាអូខេ នេះ ធ្វើឡើង នៅ យប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២១ វេលា ម៉ោង ២១៖០០ នាទី ដោយ មាន ការដឹកនាំ និង សម្របសម្រួល ពី លោក សេង ហៀង ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
យោង តាម របាយការណ៍ របស់ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ឲ្យដឹង ថា ពេល កម្លាំង សមត្ថកិច្ច ចុះ ទៅដល់ ចំណុច ផ្លូវ វិមាន ឈ្នះ ឈ្នះ ក្នុង ភូមិ សំរោង សង្កាត់ សំរោង ក្រោម ខណ្ឌ ពោធិ៍សែនជ័យ ក៏ បាន ឃើញ ហាង សម្រស់ ជាយ ក្រុង មាន ការផឹក ស៉ី ជួបជុំ មនុស្ស ច្រើន ខុសពី ការណែនាំ របស់ ក្រសួង សុខាភិបាល ទើប សមត្ថកិច្ច បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៩នាក់ ដែល ជា បុគ្គលិក បម្រើ ការងារ ក្នុង ហាង ខាងលើ នាំ ទៅ សួរនាំ ។
យោង តាម ចម្លើយ សារភាព របស់ ជនសង្ស័យ ទាំង ៩នាក់ និង ការចុះបង្ក្រាប ជាក់ស្តែង បង្ហាញ ថា មាន ករណី លួច បើក ខារ៉ាអូខេ ពិតប្រាកដ មែន ៕ គ្រួសារ សមាគម អតីត យុវជន កម្ពុជា ខេត្ត ក្រចេះ ចំនួន ៣៦ គ្រួសារ រស់ នៅ ឃុំ ស្វាយ ជ្រះ ស្រុក ស្នួល ចាប់ ឆ្នោត ជ្រើសរើស ឡូតិ៍ ដី កសិកម្ម
( ក្រចេះ ) ៖ លោក គង់ គឹម នី អភិបាល រង ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន រៀបចំ ពិធី ចាប់ ឆ្នោត ជ្រើសរើស ឡូតិ៍ ដី កសិកម្ម ជូន សមាគម អតីត យុវជន កម្ពុជា ខេត្ត ក្រចេះ នៅ ទីតាំង សម្បទាន ដី សង្គមកិច្ច ដែល ត្រូវ ប្រគល់ ជូន អតីត កងកម្លាំងប្រដាប់អាវុធ និង គ្រួសារ អតីត យុវជន ក្នុង ខេត្ត ចំនួន ៣៦ គ្រួសារ ស្ថិត ក្នុង ភូមិ សំបួរ សែន ជ័យ ឃុំ ស្វាយ ជ្រះ ស្រុក ស្នួល ខេត្ត ក្រចេះ ។
ក្នុង ពិធី នោះ ដែរ មាន ការចូលរួម ពី លោក ប្រធាន មន្ទីរ ប្រធាន រៀបចំ ដែនដី លោក ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត លោក ស្នងការ រង នគរបាល ខេត្ត មេបញ្ជាការ រង តំបន់ ប្រតិបត្តិការ សឹក រង ក្រចេះ លោក អភិបាល ស្រុក ស្នួល ព្រមទាំង អាជ្ញាធរ ស្រុក ឃុំ ជាច្រើន នាក់ ទៀត ។
លោក គង់ គឹម នី បាន បន្ត ថា ដី កសិកម្ម ដែល រៀបចំ ចាប់ ឆ្នោត ជ្រើសរើស នា ពេលនេះ មាន ចំនួន ១ហិកតា ដោយ ក្នុង មួយ គ្រួសារ សម្រាប់ ដីធ្លី ដែល បាន ចែកជូន ប្រជាពលរដ្ឋ នេះ គឺ មិន អនុញ្ញាតឱ្យ លក់ដូរ នោះ ទេ គឺ តម្រូវ ឱ្យ បងប្អូន ដាំដុះ ដំណាំ កសិកម្ម ដើម្បី ទ្រទ្រង ជីវភាព ។
លោអភិបាល រង ខេត្ត ក៏ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ជូន ដល់ អតីត យុទ្ធជន ដែល រស់ នៅ ទីនេះ ទាំងអស់ គ្នា និង ផ្តាំផ្ញើ ដល់ បងប្អូន ត្រូវ ចេះ ប្រុងប្រយត្ន័ ការពារ ខ្លួន ពី ជំងឺ កូវីដ - ១៩ និង ខិតខំ ប្រឹងប្រែង បំពេញ ការងារ ដែល មាន ស្រាប់ ដើម្បី ជួយ ដល់ ជីវភាព គ្រួសារ និង ត្រូវ ចេះ សាមគ្គី គ្នា ពេល មាន ធុរៈ ដោយ មិន ប្រកាន់ ពណ៌ សម្បុរ ជាតិ សាសន៍ ឬ និន្នាការ នយោបាយ ឡើយ ។
ការប្រកាស នេះ ធ្វើឡើង ខណៈ ដែល បណ្តា ប្រទេស ជាច្រើន កំពុង ព្យាយាម បង្កើន ល្បឿន នៃ ការអភិវឌ្ឍ វ៉ាក់សាំង រៀង ៗ ខ្លួន ចំ ពេល ដែល មាន កង្វះខាត នៃ ការផ្គត់ផ្គង់ វ៉ាក់សាំង ជា សកល និង ការព្រួយបារម្ភ ជុំវិញ បញ្ហា លេចចេញ នូវ វីរុស COVID-19 បំប្លែង ខ្លួន ថ្មី ។ ក្រសួង សុខាភិបាល វៀតណាម បាន គូសបញ្ជាក់ នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា « វិធានការ ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ រាតត្បាត COVID-19 នេះ មាន ការពឹងផ្អែក ធំធេង បំផុត លើ ការអភិវឌ្ឍ វ៉ាក់សាំង » ។
សេចក្តីថ្លែងការណ៍ ដែល កិច្ចប្រជុំ កំពូល នៃ « យន្តការចតុភាគី » លើក នេះ បាន ប្រកាស ពាក់ព័ន្ធ ដល់ វិស័យ ជាច្រើន ដូចជា ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ បម្រែបម្រួល អាកាសធាតុ និង សន្តិសុខ ក្នុង តំបន់ ជាដើម ។ ក្នុង នោះ ប្រទេស អាមេរិក ជប៉ុន និង អូស្ត្រាលី បាន ប្រកាស ថា ឈានដល់ មតិ ឯកភាព គ្នា នឹង បង្កើន ការវិនិយោគ ទៅ លើ សហគ្រាស ផលិត ឱសថ របស់ ឥណ្ឌា ដើម្បី បង្កើន បរិមាណ ផលិត វ៉ាក់សាំង ជំងឺ កូវីដ១៩ ។
បើ និយាយ ចំពោះ សហគមន៍ អន្តរជាតិ អ្វី ដែល គួរតែ យកចិត្តទុកដាក់ នោះ គឺ ពហុ ភាគី និយម ដែល រដ្ឋាភិបាល អាមេរិក បច្ចុប្បន្ន នេះ បាន អនុវត្ត តាមពិត ទៅ គឺជា រង្វង់ តូច និង នយោបាយ ចែក បក្សពួក ដែល មាន ភាព បិទ ទ្វារ និង ច្រានចោល ប្រទេស ផ្សេង ទៀត គឺជា « ពហុ ភាគី និយម ដែល មាន ជម្រើស » ។ នេះ នឹង បង្ក ភាពបែង បាក់ គ្នា និង ការប៉ះទង្គិច ថ្មី ហើយ ធ្វើឱ្យ ប៉ះពាល់ ដល់ សន្តិភាព និង ស្ថិរភាព ក្នុង តំបន់ ដែល គួរឱ្យ ប្រុងប្រយ័ត្ន ។
ពិភពលោក ត្រូវការ ពហុ ភាគី និយម កិច្ចការ លើ ផ្ទៃ អន្តរជាតិ គួរតែ ធ្វើ តាម ការពិគ្រោះ ពិភាក្សា ជាមួយគ្នា ។ ប្រសិនបើ « យន្តការចតុភាគី » ដែល ដឹកនាំ ដោយ សហរដ្ឋ អាមេរិក មិន កែប្រែ ធាតុ ពិត របស់ ខ្លួន ដែល ជា « ពហុ ភាគី និយម ក្លែងក្លាយ » ដែល ផ្ទុយ នឹង ចរន្ត យុគសម័យ និង គោលបំណង របស់ ប្រជាជន នោះ មុខ ជា នឹង បង់ កម្លាំង ឥត ប្រយោជន៍ ជា មិន ខាន ៕
រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ ម្នាក់ ទៀត នៅ ខណ្ឌ ឬស្សីកែវ ដែល ពាក់ព័ន្ធ តារា កំប្លែង ស្រី អ៊ិត ធ្វើឲ្យ កើនឡើង ទីតាំង ចត្តាឡី ស័ក ចំនួន ១៦កន្លែង
( ភ្នំពេញ )៖ គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ឫស្សីកែវ សហការ ជាមួយ ក្រុមការងារ ក្រសួង សុខាភិបាល បាន បន្ត រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ លើ បុរស អាយុ ៤១ ឆ្នាំ ម្នាក់ ទៀត ហើយ ដែល ពាក់ព័ន្ធ ជាមួយ អ្នកជំងឺ សេង ចិន្តា ហៅ អ៉ីត តារា កំប្លែង CTN និង មាន អ្នក ពាក់ព័ន្ធ ៣នាក់ ផ្សេង ទៀត ធ្វើឲ្យ កើនឡើង ទីតាំង ចត្តាឡី ស័ក ចំនួន ១៦កន្លែង ក្រោយពី បញ្ចប់ និង បើក ដំណើរការ ទីតាំង ចត្តាឡី ស័ក ពាក់ព័ន្ធ « ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ » ចំនួន ៣កន្លែង ឡើងវិញ ជាធម្មតា ។
ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ឫស្សីកែវ លោក ជា ពិសី បញ្ជាក់ ថា ក្រុមការងារ រដ្ឋបាល ខណ្ឌ និង ក្រុមការងារ ក្រសួង សុខាភិបាល បាន បន្ត ការរកឃើញ បុរស ម្នាក់ ដែល មាន ផ្ទុក ជំងឺ កូវីដ១៩ នេះ ស្ថិត នៅ តាម ផ្លូវ ជាតិ លេខ ៥ ភូមិ ផ្សារ តូច សង្កាត់ ទួល សង្កែទី១ នា ម៉ោង ០៨៖ ៥០ នាទី ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២១ ។
សូម បញ្ជាក់ ថា ស្រី អ៉ីត ត្រូវបាន រកឃើញ ថា កើត ជំងឺ កូវីដ - ១៩ នៅ ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២១ បន្ទាប់ពី រូប នាង ធ្លាប់ មាន ទំនាក់ទំនង ជាមួយ តារា ចម្រៀង វី ឌីណែត ៕
លោកស្រី ម៉ែន សំអន ជំរុញ ឲ្យ មន្ត្រី ទាំងអស់ ចូលរួម ចុះ ផ្សព្វផ្សាយ ច្បាប់ កូវីដ១៩ និង អនុក្រឹត្យ ថ្មី របស់ រាជ រដ្ឋាភិបាល ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ដឹង
( ភ្នំពេញ ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួ យេដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច បាន ជំរុញ ឲ្យ ថ្នាក់ដឹកនាំ ក្រសួង និង មន្ត្រី តាម មន្ទីរ រាជធានី - ខេត្ត ចូលរួម ចុះ ផ្សព្វផ្សាយ ច្បាប់ កូវីដ១៩ និង អនុក្រឹត្យ ថ្មី របស់ រាជ រដ្ឋាភិបាល ឲ្យបាន ទូលំទូលាយ ជូន ដល់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ។
លោក ណុប ចាន់ ណារិន្ទ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ថា ក្រសួង ត្រូវបាន រាជ រដ្ឋាភិបាល ប្រគល់ បេសកកម្ម ឲ្យដឹកនាំ និង គ្រប់គ្រង រាល់ កិច្ចការ សម្របសម្រួល ធ្វើ ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង ធ្វើ ការងារ អធិការកិច្ច លើ គ្រប់ វិស័យ ក្នុង នោះ ការផ្សព្វផ្សាយ ច្បាប់ គឺជា ផ្នែក មួយ នៃ ការងារ ស្នូល ដែល ត្រូវ អនុវត្តន៍ ។
លោកស្រី ម៉ែន សំអន បាន ផ្តល់ នូវ អនុសាសន៍ មួយចំនួន ទៅ លើ មធ្យោបាយ នៃ ការផ្សព្វផ្សាយ ក្នុង កាលៈទេសៈ កូវីដ - ១៩ ដោយ ត្រូវ ចែករំលែក ព័ត៌មាន ទាំងនេះ តាមរយៈ បណ្តាញ សង្គម ឬ ក្នុង ពេល ចុះ បំពេញ ការងារ ជាមួយ រដ្ឋបាល ខេត្ត - រាជធានី ខណៈ ទទួល ពលករ ធ្វើចត្តា ឡី ស័ក្ត ដែល ទើប ត្រឡប់ មកពី ក្រៅ ប្រទេស ឬ តំបន់ ផ្សេង ៗ ចូល មកដល់ ភូមិ កំណើត ក្នុង ពេល ចូល ឆ្នាំ ថ្មី ប្រពៃណី យ ខ្មែរ ។
សូម បញ្ជាក់ ថា ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច មាន អគ្គ នាយកដ្ឋាន មួយ ក្នុង ចំណោម អគ្គ នាយកដ្ឋាន ទាំង បី របស់ ក្រសួង គឺ អគ្គ នាយ ដ្ឋាន ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា ដែល ធ្វើ ការងារ ជំនាញ ច្បាប់ ផ្សព្វផ្សាយ ច្បាប់ និង ចូលរួម ធ្វើ សេចក្តីព្រាង តាក់តែង ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្តិ ជាមួយ រា ជេដ្ឋាភិបាល រដ្ឋសភា ព្រឹទ្ធសភា និង អង្គភាព រដ្ឋ នានា ផងដែរ ៕
រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ក្រើន រំលឹក មន្ត្រី ពេល ចុះ ណែនាំ ពលរដ្ឋ បង្ការ - ទប់ស្កាត់ ការឆ្លង បន្ត ជំងឺ កូវីដ១៩ តែ កុំ ភ្លេច អនុវត្តន៍ ខ្លួន ឯង ជា ចម្បង
( ត្បូងឃ្មុំ ) ៖ លោក ស៊ាក ឡេង ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ជា អធិបតីភាព បើក កិច្ចប្រជុំ សាមញ្ញ លើក ទី ២២ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខេត្ត ត្បូងឃ្មុំ នៅ សាលា ខេត្ត ត្បូងឃ្មុំ ។
កិច្ចប្រជុំ នេះ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត អភិបាល រង ខេត្ត នាយក រដ្ឋបាល នាយក ទី ចាត់ការ ប្រធាន ច្រក ចេញ ចូល នៃ សាលា ខេត្ត និង ប្រធាន - អនុប្រធាន មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ មួយ ចំនួន ។
ក្នុ្ងង កិច្ចប្រជុំ បាន ពិនិត្យ ពិភាក្សា និង អនុម័ត លើ សេចក្តីព្រាង កំណត់ហេតុ នៃ កិច្ចប្រជុំ សាមញ្ញ លើក ទី ២១ អាណត្តិ ទី៣ របស់ ក្រុមប្រឹក្សា ខេត្ត និង សេចក្តីព្រាង របាយការណ៍ រីកចម្រើន ប្រចាំ ខែកុម្ភៈ ឆ្នាំ ២០២១ របស់ រដ្ឋបាល ខេត្ត ដោយ សម្រេច យល់ព្រម សម្លេង គាំទ្រ ២៥ លើ ២៥ សម្លេង ព្រមទាំង បាន ឆ្លើយតប ដោះស្រាយ ជុំវិញ បញ្ហា ប្រឈម មួយ ចំនួន ដែល បាន លើកឡើង ក្នុង កិច្ចប្រជុំ នោះ ផងដែរ ។
សូម ជម្រាប ថា គិត ត្រឹម ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ក្នុង ខេត្ត ត្បូងឃ្មុំ ពលរដ្ឋ ដែល កំពុង ធ្វើចត្តាឡី ស័ក សរុប មាន ចំនួន ៦៤១ នាក់ ស្រី ២៧២ នាក់ ដោយឡែក ពលរដ្ឋ ដែល អនុញ្ញាតឲ្យ ទៅ គេហដ្ឋាន វិញ ក្រោយ ធ្វើចត្តាឡី ស័ក ចំនួន ១៤ ថ្ងៃ មាន ចំនួន ៦៣ នាក់ ស្រី ២៩ នាក់ ចំណែក ៥៧៨ នាក់ ទៀត កំពុង តាមដាន សុខភាព និង ធ្វើចត្តាឡី ស័ក បន្ត ដែល ភាគ ច្រើន សុទ្ធសឹង ជា ពលករ ដែល មកពី តាម តំបន់ ព្រំដែន ប្រទេស ថៃ ដែល រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ បាន រៀបចំ ឲ្យ មាន ក្រុមការងារ ទៅ ទទួល ដល់ តាម បណ្តា ខេត្ត នានា ៕
សូម ជម្រាប ថា កាលពី យប់ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២១ អ្នកស្រី ដេត ម៉ាលីណា បាន បង្ហោះ វីដេអូ តាម បណ្ដាញ ហ្វេសប៊ុក ដោយ បង្ហាញ ពី សកម្មភាព ដែល ឧកញ៉ា ឌួង ឆាយ ប្រើ អំពើហិង្សា មាន ការវាយតប់ ជាខ្លាំង ។ បន្ទាប់មក នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២១ ឧកញ៉ា ឌួង ឆាយ បាន បកស្រាយ តាម បណ្តាញ សង្គម វិញ ថា មូលហេតុ ដែល ខ្លួន វាយ អតីត ភរិយា ដោយសារតែ នាង បង្ខំ ឲ្យ ទៅគ្រៀវ ៕
សេចក្តីថ្លែងការណ៍ របស់ រដ្ឋសភា កម្ពុជា មាន ខ្លឹមសារ សំខាន់ ៗ ៤ចំណុច រួម មាន៖
១៖ ក្នុង នាម ជា រដ្ឋ ឯករាជ្យ និង អធិបតេយ្យ ប្រទេស កម្ពុជា មាន សិទ្ធិ អនុវត្ត នូវ គោល នយោបាយ ស្វ័យ សម្រេច របស់ ខ្លួន ដើម្បី ការពារ ផលប្រយោជន៍ ជាតិ រួមទាំង សន្តិភាព ស្ថិរភាព និង វិបុលភាព របស់ ប្រទេស ។ យើងខ្ញុំ មិន អាច អត់ អោន បាន ឡើយ ចំពោះ រាល់ ចេតនា និង សកម្មភាព ទាំងឡាយ ណា ដែល មាន បំណង បង្ក ការរំខាន ដល់ សុខ សន្តិភាព និង ស្ថេរភាព ដែល ខិតខំ រក បាន ដោយ លំបាក របស់ កម្ពុជា ។
២៖ ការជំនុំជម្រះ ក្តី ជនល្មើស ដែល ជាប់ពាក់ព័ន្ធ នឹង « ផែនការ ក្បត់ នា ថ្ងៃទី ៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ » គឺ ធ្វើឡើង ស្រប តាម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ របស់ ប្រទេស ដែល សម្រាប់ ពង្រឹង នីតិរដ្ឋ នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ។ រាល់ ការប៉ុនប៉ង រៀបចំ ផែនការបះបោរ តាមរយៈ ការប្រើប្រាស់ ភាសា បរិហារ កេរ្តិ៍ ញុះញង់ ឱ្យ មាន អំពើហិង្សា ក៏ ដូចជា ការអំពាវនាវ ឱ្យ កងកម្លាំងប្រដាប់អាវុធ ក្រោកឈរ ដើម្បី ផ្ដួលរំលំ រដ្ឋាភិបាល ស្រប ច្បាប់ គឺជា ទង្វើ ខុស ច្បាប់ និង ត្រូវតែ ធ្វើការ ថ្កោលទោស ជាដាច់ខាត ។
៤៖ ប្រជាធិបតេយ្យ រូបនីយ៍កម្ម នៅ កម្ពុជា កំពុង រីកចម្រើន ទៅ មុខ ជាលំដាប់ ហើយ មិន អាច វិលត្រឡប់ ថយ ក្រោយ បាន ឡើយ ដូច ដែល បាន ឆ្លុះបញ្ចាំង នៅក្នុង ទិដ្ឋភាព ប្រជាធិបតេយ្យ ដែល កំពុង វិវត្ត ទៅ មុខ ជានិច្ច ដែល បាន គ្របដណ្តប់ លើ គ្រប់ គណបក្ស នយោបាយ ទាំងអស់ ដែល មាន និន្នាការ និង គោលដៅ ផ្សេង ៗ គ្នា សង្គម ស៉ី វិល រីកចម្រើន មួយ សហជីព ពាណិជ្ជកម្ម និង ប្រព័ន្ធ ផ្សព្វផ្សាយ គ្រប់ ប្រភេទ ។
