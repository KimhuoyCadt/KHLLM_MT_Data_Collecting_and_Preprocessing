( ភ្នំពេញ ) ៖ លោកស្រី សាល សុជាតា អាយុ ៤០ ឆ្នាំ រស់ នៅ ផ្ទះ លេខ ៦៨ABEo ផ្លូវ ៣៤៨ ភូមិ ៨ សង្កាត់ ទួល ស្វាយ ព្រៃ ទី២ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ បាន ជ្រុះ បាត់ លិខិត ផ្ទេរ សិទ្ធ គ្រប់គ្រង និង ប្រើប្រាស់ ដីធ្លី មួយ កន្លែង នៅ សង្កាត់ ស្ទឹងមានជ័យ ទី១ ខណ្ឌ មានជ័យ ហើយ លោក ប្រកាស មិន ទទួលខុសត្រូវ ចំពោះ អ្នក ដែល រើស បាន យក ទៅ ប្រើប្រាស់ ខុស ច្បាប់ ។
លោកស្រី សាល សុជាតា បាន ឲ្យដឹង ថា លិខិត ផ្ទេរ សិទ្ធ គ្រប់គ្រង និង ប្រើប្រាស់ ដីធ្លី ខាងលើ នេះ លេខ ៣៩៤ ម ជម ជ ចុះ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០១៥ ស្ថិត នៅ ចំណុច ផ្លូវ លំ ភូមិ ថ្មី សង្កាត់ ស្ទឹងមានជ័យ ទី១ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ។
លោកស្រី សូម បញ្ជាក់ ថា « បើ ថ្ងៃ ក្រោយ មាន ជន ណា មក ទាមទារ ឬ តវ៉ា ថា លិខិត ផ្ទេរ សិទ្ធ គ្រប់គ្រង និង ប្រើប្រាស់ ដីធ្លី ខាងលើ នេះ មិន មែន របស់ ខ្ញុំបាទ នោះ ខ្ញុំ សូម ទទួលខុសត្រូវ ទាំងស្រុង ចំពោះ មុខ ច្បាប់ »៕
ក្រសួង សុខាភិបាល អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ ប្រុងប្រយ័ត្ន លើ ការទិញ ផលិត បំប៉ន សុខភាព ឬ អាហារ បំប៉ន សុខភាព នៅលើ បណ្តាញ សង្គម
សេចក្តីជូនដំណឹង របស់ ក្រសួង បាន បញ្ជាក់ ថា៖ « ផលិតផល បំប៉ន សុខភាព ឬ អាហារ បំប៉ន សុខភាព មិន អាច ឬ គ្មាន ប្រសិទ្ធ ក្នុង ការបង្ការ ឬ ព្យាបាល ជំងឺ ដូចជា ជំងឺ មហារីក ជំងឺ ទឹកនោម ផ្អែម លើស ឈាម ... បាន ឡើយ ផ្ទុយទៅវិញ ផលិតផល បំប៉ន សុខភាព មួយចំនួន អាច បង្កឲ្យ មាន ហានិភ័យ ចំពោះ សុខភាព និង ជួនកាល បង្ក គ្រោះថ្នាក់ ដល់ អាយុជីវិត » ។
សូម អាន សេចក្តីប្រកាស របស់ ក្រសួង សុខាភិបាល៖ អ្នកនាំពាក្យ ក្រសួង សាធារណការ៖ គិត ត្រឹម ចុង ខែកុម្ភៈ ឆ្នាំ ២០២១ នេះ ការលក់ ផ្លាកលេខ សំគាល់ យានយន្ត រក ចំណូល បាន ជិត ៥៣ លាន ដុល្លារ
លោក ហ៊ាង សុទ្ធា យុត្តិ បាន បញ្ជាក់ ទៀត ថា សម្រាប់ ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន ( ផ្លាកលេខ កម្ពុជា ) នេះ បាន ធ្វើ ការសិក្សា អស់ រយៈពេល ប្រមាណ ជិត ២ ឆ្នាំ ទើប បាន សម្រេច សម្ភោធ បើក ដំណើរការលក់ ជា ផ្លូវការ ក្រោម អធិបតីភាព លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ចូន នៅ ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២០ នៅ ផ្សារ ទំនើប អ៊ីអន២ រាជធានី ភ្នំពេញ ។
អ្នកនាំពាក្យ រូប នេះ បាន បន្ត ថា ការគ្រប់គ្រង ការលក់ លេខ ផ្ទាល់ខ្លួន នេះ ដែរ ក៏ មាន សមាសភាព ចម្រុះ ដែល ជា គណកម្មការ អន្តរ ក្រសួង រវាង ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង អង្គភាព ប្រយុទ្ធ ប្រឆាំង អំពើពុករលួយ ដែល ដឹកនាំ ដោយ លោកស្រី កុយ សុដានី រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
សូម បញ្ជាក់ ដែរ ថា លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ផ្តួចគំនិត ក្នុង ការធ្វើ ផ្លាក លេខ ពិសេស នេះ ឡើង ក្នុង គោលបំណង កៀរគរ ថវិកា ជូន ជាតិ ពី អ្នកប្រើប្រាស់ យានយន្ត ដែល ចង់បាន ផ្លាកលេខ ពិសេស នេះ ៕
កងកម្លាំង សហរដ្ឋ អាមេរិក ដាក់ពង្រាយ ប្រព័ន្ធ ការពារ ថ្មី នៅ មូលដ្ឋាន ទ័ព របស់ ខ្លួន នៅ ប្រទេស ស៊ីរី
( វ៉ាស៊ីនតោន ) ៖ ក្រុម អ្នក សង្កេតការណ៍ សង្គ្រាម បាន រាយការណ៍ ឲ្យដឹង នៅ ថ្ងៃសុក្រ នេះ ថា កងទ័ព អាមេរិក បាន ចាប់ផ្តើម ដាក់ពង្រាយ ប្រព័ន្ធ ការពារ ថ្មី នៅក្នុង មូលដ្ឋាន ទ័ព របស់ ខ្លួន ដែល ស្ថិត នៅ ភាគ ខាងជើង និង ភាគ ខាងកើត ប្រទេស ស៊ីរី ដើម្បី ការពារ ប្រឆាំង នឹង ការវាយប្រហារ ណាមួយ ដែល អាច កើតឡើង ពីសំណាក់ កង ជីវពល ដែល គាំទ្រ ដោយ អ៊ីរ៉ង់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ យប់ ថ្ងៃសុក្រ ទី ០៥ ខែមីនា ឆ្នាំ ២០២១ ។
ក្រុម អ្នក សង្កេតការណ៍ បាន សង្កត់ធ្ងន់ ថា ប្រព័ន្ធ ការពារ បន្ថែម ទៀត នឹង ត្រូវបាន ដាក់ពង្រាយ នៅ ប៉ុន្មាន ថ្ងៃ ខាងមុខ នេះ នៅឯ មូលដ្ឋាន ទ័ព អាមេរិក ទាំងអស់ នៅ ភាគ ខាងជើង និង ភាគ ខាងកើត នៃ ប្រទេស ស៊ីរី ។
ក្រុមការងារ ស្រុក បាភ្នំ ចុះ សួរសុខទុក្ខ លោក យាយ ចាស់ ៗ ជួប ការលំបាក ក្នុង ឱកាស ទិវា នារី អន្តរជាតិ ៨ មីនា
លោកយាយ លោក តា ទាំងអស់ នេះ ជា អ្នក ដែល កំពុង ជួប ការលំបាក ក្នុង ជីវភាព ម្យ៉ាង អាស្រ័យ ដោយ ត្រូវ ប្រឈម នឹង ផលវិបាក នៃ ជំងឺ កូវីដ - ១៩ និង ម្យ៉ាងទៀត ត្រូវ ទទួលបន្ទុក ចិញ្ចឹម បីបាច់ ថែរក្សា ចៅ តូច ៗ ដែល ឳពុក ម្តាយ ពួកគេ ត្រូវ ធ្វើ ចំណាកស្រុក ទៅ ធ្វើការ នៅ ទី ឆ្ងាយ ។
នៅក្នុង ឱកាស នោះ ក្រុមការងារ ស្រុក បាន ពាំនាំ នូវ អំណោយ ជា សំលៀកបំពាក់ និង ថវិកា មួយ ចំនួន ជូន ពួកគាត់ ផងដែរ ៕ សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២១
១៖ ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ក្នុង សហគមន៍ ចំនួន ២៣ នាក់ ថែម ទៀត ខណៈ អ្នកជំងឺ ៥នាក់ ជាសះស្បើយ
៣៖ ក្រសួង សុខាភិបាល ប្រកាស ផ្លូវការ អំពី កម្មវិធី ចាក់ វ៉ាក់សាំង កូវីដ១៩ លើ ប្រជាពលរដ្ឋ ចាប់ពី អាយុ ៦០ ឆ្នាំ ឡើង ទៅ
៥៖ រដ្ឋសភា អនុម័ត សេចក្តីព្រាង ច្បាប់ ស្តីពី វិធានការ ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ និង ជំងឺ ឆ្លងកាច សាហាវ ផ្សេង ទៀត
៧៖ ខែ ដំបូង ឆ្នាំ នេះ ចំណូល របស់ កំពង់ផែ ស្វយ័ត ភ្នំពេញ ធ្លាក់ចុះ ១២%
៩៖ តំណាងរាស្ត្រ ហ៊ុន ម៉ានី៖ រាជ រដ្ឋាភិបាល គ្រប់គ្រង ស្ថានភាព កូវីដ - ១៩ ល្អ បំផុត តែ ត្រូវ មាន ច្បាប់ ដើម្បី ជួយ សម្រួល បន្ថែម
១១៖ ផាក ពិន័យ បុរស ម្នាក់ ២លាន រៀល នៅ ខេត្ត ព្រះសីហនុ ព្រោះ ធ្វើចត្តាឡី ស័ក មិន ត្រឹមត្រូវ តាម ការណែនាំ
១២៖ អ្នកជំនាញ ជាន់ ខ្ពស់ នៅ UN ផ្តល់ យោបល់ ឲ្យ ដាក់ទណ្ឌកម្ម ផ្នែក អាវុធ ជា សកល ទៅ លើ យោធា មីយ៉ាន់ម៉ា
១៣៖ សិង្ហបុរី ណែនាំឲ្យ ប្រជាពលរដ្ឋ របស់ ខ្លួន ពិចារណា ចាកចេញ ពី ប្រទេស មីយ៉ាន់ម៉ា ឲ្យបាន ឆាប់ តាម ដែល អាច ធ្វើ ទៅ បាន
១៥៖ ចិន នឹង បន្ត ប្រឆាំង យ៉ាង ដាច់ខាត ចំពោះ ការចង់បាន ឯករាជ្យ នៃ កោះ តៃវ៉ាន់ ប៉ុន្តែ ចិន នៅតែ លើកស្ទួយ ទំនាក់ទំនង សន្តិភាព
១៧៖ សហរដ្ឋ អាមេរិក ទើប បញ្ចេញ ចំណាត់ការ ថ្មី ដើម្បី ប្រឆាំង យោធា មីយ៉ាន់ម៉ា ខណៈ មនុស្ស ៥៤ នាក់ ហើយ បាន ស្លាប់ នៅក្នុង បាតុកម្ម និង ជាង ១.៧០០ នាក់ ត្រូវបាន ចាប់ ឃុំ ខ្លួន
១៩៖ អូស្រ្តាលី ស្នើ ឱ្យ គណៈកម្មការ អឺរ៉ុប ពិនិត្យ ឡើងវិញ លើ ការបិទ ខ្ទប់ វ៉ាក់សាំង កូវីដ - ១៩ របស់ អ៉ីតាលី
២០៖ វ៉ាក់សាំង កូវីដ - ១៩ របស់ គុយ បា ចាប់ផ្តើម ការធ្វើតេស្ត ដំណាក់កាល ចុងក្រោយ
២២៖ ថៃ រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ ចំនួន ៧៩ នាក់ ថ្មី ទៀត នៅក្នុង របាយការណ៍ ថ្ងៃសុក្រ នេះ
២៤៖ សិង្ហបុរី៖ ដំណោះស្រាយ សន្តិវិធី សម្រាប់ មីយ៉ាន់ម៉ា នៅតែ អាច ធ្វើ ទៅ រួច បើ គ្រប់ ភាគី មាន កិច្ចសន្ទនា ដ៏ ពិតប្រាកដ
២៥៖ ហ្វីលីពីន រកឃើញ កូវីដ - ១៩ បំប្លែង ខ្លួន ថ្មី មាន ប្រភព ដើម មកពី អាហ្វ្រិក ខាងត្បូង ៥២ ករណី
២៦៖ បទ អត្ថាធិប្បាយ៖ « មហាសន្និបាត នៃ សភា ទាំង ពីរ របស់ ប្រទេស ចិន គឺជា ការរំពឹងទុក របស់ ពិភពលោក ដែល ស្ថិត ក្នុង ចំណុច ប្រសព្វ នៃ ប្រវត្តិសាស្ត្រ »
១៖ ព្រឹទ្ធសភា សហរដ្ឋ អាមេរិក ផ្តល់ ថវិកា ចំនួន ៣០ ពាន់ លាន ដុល្លារ ដើម្បី ជំរុញ វិស័យ ផលិត ឈីប
៧៖ ចំណេះដឹង ទូទៅ៖ ស៉ី ព បើក ឲ្យ ជន បរទេស លើ ពិភពលោក ចូល សញ្ជាតិ . មក ស្គាល់ វិធី ស្រប ច្បាប់ ៤យ៉ាង ដើម្បី ចូល សញ្ជាតិ ស៉ីព
ក្រោយ ចាក់ វ៉ាក់សាំង កូវីដ១៩ លើក ទី២ រួច បញ្ជាការដ្ឋាន ទ័ព ពិសេស ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន ដែល ស្វះស្វែងរក វ៉ាក់សាំង កូវីដ១៩ ចាក់ ជូន ពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ
( ភ្នំពេញ ) ៖ បញ្ជាការដ្ឋាន ទ័ព ពិសេស នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២១ បាន រៀបចំ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ លើក ទី២ ក្រោម កិច្ចសហការ របស់ ក្រុមការងារ នៃ នាយកដ្ឋាន សុខាភិបាល ក្រសួង ការពារ ជាតិ . ទី ចាត់ការ សុខាភិបាល អគ្គ បញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ ការិយាល័យ សុខាភិបាល កងទ័ព ជើងគោក ។
ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ នេះ ធ្វើឡើង ដោយ អនុវត្ត និង គោរព អនុសាសន៍ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ . នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ . ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក ។
ក្រោយ ចាក់ វ៉ាក់សាំង រួច បញ្ជាការដ្ឋាន ទ័ព ពិសេស បាន ថ្លែងអំណរគុណ និង សម្តែង ការដឹង គុណ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល គ្រប់ ពេលវេលា សម្តេច តែងតែ គិតគូរ ស្វះស្វែងរក វ៉ាក់សាំង កូវីដ១៩ ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ដោយ ឥត គិត ថ្លៃ ។
សូម ជម្រាប ថា គិត ត្រឹម ពេលនេះ កម្ពុជា មាន វ៉ាក់សាំង កូវីដ១៩ ចំនួន ២ប្រភេទ គឺ ស៉ី ណូហ្វាម ដែល ជា អំណោយ របស់ មិត្ត ចិន និង អាស្ត្រា ហ្សេណេកា ដែល ជា ជំនួយ របស់ អង្គការ សុខភាព ពិភពលោក តាមរយៈ យន្តការ កូវ៉ាក់ (COVAX) ។ វ៉ាក់សាំង អាស្ត្រា ហ្សេណេកា ត្រូវបាន ដឹក មកដល់ កម្ពុជា ក្នុង ដំណាក់កាល ដំបូង ចំនួន ៣២៤.០០០ ដូស កាលពី ថ្ងៃទី ០២ ខែមីនា ឆ្នាំ ២០២១ ។
សម្រាប់ វ៉ាក់សាំង ប្រភេទ ស៉ី ណូហ្វាម ដែល ជា អំណោយ របស់ មិត្ត ចិន ក៏ បាន ផ្តល់ ដល់ កម្ពុជា ចំនួន ១លាន ដូស ផងដែរ ។ ដំណាក់កាល ដំបូង នេះ ចិន បាន ដឹក វ៉ាក់សាំង ៦០ ម៉ឺន ដូស ដែល បាន មកដល់ កម្ពុជា កាលពី ថ្ងៃទី៧ ខែកុម្ភៈ ឆ្នាំ ២០២១ ខណៈ ៤០ ម៉ឺន ទៀត នឹង មកដល់ មុន បុណ្យ ចូល ឆ្នាំ ខ្មែរ ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ ប្រកាស ថា រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ត្រៀម បម្រុង វ៉ាក់សាំង ចំនួន ២០លាន ដូស សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ១០លាន នាក់ ដោយ មិន គិត ថ្លៃ ដោយ បុគ្គល ម្នាក់ ត្រូវ ចាក់ ចំនួន ។ ក្នុង ចំណោម វ៉ាក់សាំង ប្រឆាំង កូវីដ១៩ នៅក្នុង ផែនការ របស់ កម្ពុជា ទាំង ២០លាន ដូស នេះ មាន ជំនួយ ១១លាន ដូស ផងដែរ ។
ក្នុង ចំណោម ជំនួយ ១១លាន ដូស នោះ មាន វ៉ាក់សាំង ស៉ី ណូហ្វាម របស់ ចិន ចំនួន ១លាន ដូស ជំនួយ យន្តការ កូវ៉ាក់ ចំនួន ៧លាន ដូស . ជំនួយ ទឹកប្រាក់ របស់ អូស្រ្តាលី ២៨ លាន ដុល្លារ ស្មើនឹង ៣លាន ដូស ផងដែរ ។ ចំណែក តម្រូវការ ៩លាន ដូស ទៀត ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន អះអាង ថា នឹង បន្ត ស្នើសុំ និង ទិញ ពី ប្រទេស មួយចំនួន ៕ វៀតណាម បន្ត រកឃើញ ករណី ឆ្លង ថ្មី នៃ ជំងឺ កូវីដ - ១៩ ចំនួន ០៦ ករណី ទៀត នៅក្នុង របាយការណ៍ ថ្ងៃសុក្រ នេះ
រយៈពេល ៤ ថ្ងៃ បុគ្គលិក សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ដល់ មន្ត្រី ជួរ មុខ បាន ជិត ១ ពាន់ នាក់
( កំពង់ឆ្នាំង ) ៖ ដោយ មាន ការខិតខំ ប្រឹងប្រែង ពី ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ឆ្នាំង និង មាន ការយកចិត្តទុកដាក់ ពី ប្រធាន មន្ទីរពេទ្យ បង្អែក ខេត្ត ផង នោះ ត្រឹមតែ រយៈពេល ៤ ថ្ងៃ គិត ត្រឹម ថ្ងៃទី ២ ខែមីនា មកដល់ ថ្ងៃ៥ ខែមីនា ឆ្នាំ ២០២១ នេះ ក្រុម គ្រូពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ដល់ មន្ត្រី ជួរ មុខ របស់ ខេត្ត បាន ជិត ១ ពាន់ នាក់ ហើយ ។
ថ្ងៃ នេះ បុគ្គលិក សុខាភិបាល យើង កំពុង ចាក់ ជូន មន្ត្រី នគរបាល មន្ត្រី ពន្ធ ធនាគារ បុគ្គលិក សុខាភិបាល មន្ត្រី ពន្ធដា និង មន្ត្រី គយ នៅក្នុង ខេត្ត ជា បន្ត ទៀត ។ នេះ បើ តាម ការឲ្យដឹង ពី លោក វេជ្ជបណ្ឌិត ទុំ សម្បត្តិ ប្រធាន មន្ទីរពេទ្យ បង្អែក ខេត្ត កំពង់ឆ្នាំង ។
លោក វេជ្ជបណ្ឌិត បាន ឲ្យដឹង ទៀត ថា ចូលមកដល់ ថ្ងៃទី ៤នេះ ថ្នាក់ដឹកនាំ ក្នុង ខេត្ត មួយចំនួន ក៏ បាន អញ្ជើញ មក ទទួល ការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ បាន មួយ លើក ហើយ ដែរ ។
មនុស្ស ជាង ៧០០ នាក់ ត្រូវ ដាក់ ឲ្យ ធ្វើចត្តាឡី ស័ក នៅក្នុង កាស៊ីណូ « យ៉ុង យ័ន » ស្រុក កោះ ធំ ក្រោយ រកឃើញ ជនជាតិ ចិន ២នាក់ មាន ផ្ទុក កូវីដ១៩ ពេល មក លេង កាស៊ីណូ
លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្តាល បាន ដឹកនាំ ក្រុមការងារ មន្ទីរ ជំនាញ ពាក់ព័ន្ធ កងកម្លាំង មាន សមត្ថកិច្ច និង អាជ្ញាធរ ស្រុក នៅ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២១ នេះ ក្នុង ការចុះ ពិនិត្យ ទីតាំង កាស៊ីណូ យីហោ « យ៉ុង យ័ន » ដែល ការចុះ នេះ ធ្វើឡើង បន្ទាប់ពី រកឃើញ បុរស ជនជាតិ ចិន ម្នាក់ មាន ផ្ទុក ជំងឺ កូវីដ១៩ ស្ថិត នៅ ឃុំ សំពៅ ពូន ស្រុក កោះ ធំ ខេត្ត កណ្តាល ។
ជាង នេះ ទៅ ទៀត អាជ្ញាធរ ស្រុក និង កងកម្លាំង មាន សមត្ថកិច្ច បាន ធ្វើ ការយាម កាម ដើម្បី ថែរក្សា នូវ សុវត្ថិ សុខ ព្រមទាំង មិន អនុញ្ញាតឱ្យ អ្នកណា ម្នាក់ ចេញមក ខាងក្រៅ ក្នុង កំឡុង ពេល ធ្វើចត្តាឡី ស័ក ឡើយ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា កាស៊ីណូ នេះ ដែរ មាន ភ្ញៀវ និង បុគ្គលិក បំរើ ការងារ ដែល កំពុង ធ្វើចត្តាឡី ស័ក មាន ចំនួន ៧២៣ នាក់ បាន ធ្វើចត្តាឡី ស័ក និង បាន យក សំណាក ទៅ ធ្វើ ការពិនិត្យ បាន ចំនួន ២ដង រួច មកហើយ ហើយ ការធ្វើតេស្តសំណាក់ លើក ទី១ មិន បាន រកឃើញ អ្នក ដែល មាន ផ្ទុក ជំងឺ កូវីដ១៩ ឡើយ ប៉ុន្តែ បន្ទាប់ពី ពិនិត្យ លើក ទី២ បាន រកឃើញ បុរស ម្នាក់ ជនជាតិ ចិន មាន ផ្ទុក ជំងឺ កូវី - ១៩ ។
ប្រជាកសិករ រស់ នៅ ភូមិ ប៉ាង រលឹម ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន បាន ឲ្យដឹង ថា ការដាំ ដំណាំ ស្ពៃ ក្តោប ឆ្មាំ មុន ១គី ទ្បូក្រាម តម្លៃ ៣០០០ រៀល ចំណែកឯ ឆ្នាំ នេះ ១គី ទ្បូក្រាម តម្លៃ ត្រឹមតែ ២៥០០ រៀល ប៉ុណ្ណោះ ។ ក្នុង នោះ ដើម ខ្ទឹម ឆ្នាំ មុន ១គី ទ្បូក្រាម តម្លៃ ៦០០០ រៀល ចំណែកឯ ឆ្នាំ នេះ ១គី ទ្បូក្រាម តម្លៃ ២៥០០ រៀល ប៉ុណ្ណោះ ។
កសិករ ខាងលើ បន្ថែម ថា ការធ្លាក់ ថ្លៃ បែប នេះ គាត់ មិន ចំណេញ នោះ ទេ បើ គិត ថ្លៃ ពលកម្ម រួច ។ ថ្លែង ទាំង ក្តី អស់សង្ឃឹម ដោយសារ មិន មាន ទីផ្សារ សម្រាប់ លក់ ផលិតផល ដំណាំ កសិកម្ម នោះ កសិករ ដដែល បាន ត្រឹម សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ជួយ គាំទ្រ ផលិតផល កសិកម្ម ប៉ុណ្ណោះ ។
កសិករ ខាងលើ ក៏ បាន ធ្វើ ការអំពាវ ដល់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ជួយ បកស្រាយ និង ពន្យល់ រឿង ផលិតផល កសិកម្ម ចុះ ថោក បែប នេះ ផងដែរ ។ ជាទូទៅ ផលិតផល កសិកម្ម នៅ កម្ពុជា សព្វ ថ្ងៃ គ្មាន ទីផ្សារ នោះ ទេ ខណៈពេល ដែល ពលរដ្ឋ កម្ពុជា ប្រមាណ ៩០ % ពឹងផ្អែក លើ របរ កសិកម្ម នោះ ។
កសិករ ដដែល ថែមទាំង សំណូមពរ ដល់ ក្រសួង កសិកម្ម ជួយ ចាត់ មន្ត្រី ចុះ ជួយ ពន្យល់ បញ្ហា បច្ចេកទេស នៃ ការដាំដុះ ផ្នែក កសិកម្ម ទៀតផង ។ គាត់ ថ្លែង ថា ការប្រកបរបរ កសិកម្ម នេះ រយៈពេល ជិត ២០ ឆ្នាំ ហើយ ពុំ មាន មន្ត្រី ជំនាញ ណាមួយ ចុះ ជួយ ពន្យល់ ណែនាំ ដល់ ពួកគាត់ ក្នុង ការដាំដុះ នោះ ដែរ ៕ ប្រធាន គណបក្ស ខេត្ត កំពត ស្នើ មន្ត្រី សមាជិក ត្រូវ ខិតខំ ដោះស្រាយ រាល់ បញ្ហា ប្រឈម នានា នៅ មូលដ្ឋាន ឲ្យបាន ល្អ ដើម្បី បម្រើ ប្រយោជន៍ ប្រជាពលរដ្ឋ . ប្រយោជន៍ បក្ស និង ជាតិ
ការស្នើ បែប នេះ ខណ: លោក ជា វ តាយ ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ ជាមួយ មន្ត្រី គណបក្ស មូលដ្ឋាន ឃុំ កំពង់ត្រាច ខាងលិច នា ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២១ នៅ ស្នាក់ការ គណបក្ស ឃុំ កំពង់ត្រាច ខាងលិច ស្រុក កំពង់ត្រា ច ដោយ ម ចូលរួម ពី មន្ត្រី គណបក្ស ខេត្ត ស្រុក ជាច្រើន រូប ។
( ភ្នំពេញ ) ៖ លោក ជិន ម៉ាលីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន បំភ្លឺ ៣ចំណុច អំពី ទិដ្ឋភាព ច្បាប់ និង នីតិវិធី តុលាការ ចំពោះ សំណុំរឿង ផែនការ៩ វិច្ឆិកា របស់ ទណ្ឌិត សម រង្ស៉ី មេ ឧទ្ទាម ក្រៅ ច្បាប់ និង បក្ខពួក ។
ខាងក្រោម នេះ ជា ការបំភ្លឺ របស់ លោក ជិន ម៉ាលី ន៖
លោក ជិន ម៉ាលី ន បាន លើកឡើង ថា អំពើ និង សកម្មភាព ខាងលើ ទាំងនេះ មាន ភស្តុតាង ច្បាស់លាស់ និង រឹងមាំ ហើយ ភស្តុតាង ទាំងនេះ មួយចំនួន អាច រក បាន ដោយ ងាយស្រួល ព្រោះ ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក បាន ប្រើប្រាស់ ហ្វេសប៊ុក និង បណ្តាញ សង្គម ដទៃ ទៀត ធ្វើជា មធ្យោបាយ ដើម្បី បង្ហោះ សារ ញុះញង់ និង បម្រើ ឱ្យ ផែនការ សកម្មភាព ទុច្ចរិត របស់ ខ្លួន ខាងលើ ។
ជា ទិដ្ឋភាព ផ្លូវ ច្បាប់ តើ ប្រទេស ណាមួយ ក្នុង លោក នេះ ដែល មិន ចាត់ទុក « ផែនការ ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ខាងលើ » ថា ជា អំពើ ខុស ច្បាប់ ? ប្រទេស មួយចំនួន បាន ថែមទាំង ចាត់ទុក ក្រុម ទាំង នេះ ជា អង្គការ ភេរវ និយម ទៀត ផង ។
ដូច្នេះ វា ជា ការត្រឹមត្រូវ បំផុត ដែល រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ វិធានការ ចាំបាច់ នានា ក្នុង នាម ជា រដ្ឋ ឯករាជ្យ និង អធិបតេយ្យ ក្នុង នោះ រួម មាន វិធានការ ច្បាប់ វិធានការ នយោបាយ និង វិធានការការទូត ដោយ បាន បំផ្លាញ ចោល ទាំងស្រុង នូវ ផែន ការបំផ្លាញ កម្ពុជា ដែល ដឹកនាំ អនុវត្ត ដោយ ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក ហើយ ធានា ថែរក្សា បាន នូវ សុខ សន្តិភាព ស្ថិរភាព និង សេចក្តីសុខសាន របស់ ប្រជាជន ។
* វា ជា ការត្រឹមត្រូវ បំផុត ដែល ប្រទេស នានា ក្នុង ពិភពលោក មិន គាំទ្រ ផែនការ ខុស ច្បាប់ របស់ ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក និង បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការធ្វើឱ្យ ផែនការបំផ្លាញ សន្តិភាព សន្តិសុខ និង ស្ថិរភាព របស់ កម្ពុជា ដឹកនាំ ដោយ ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក ទទួលបរាជ័យ យ៉ាង អាម៉ាស់ ។
* វា ជា ការត្រឹមត្រូវ បំផុត ដែល ច្បាប់ របស់ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវបាន អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ ដើម្បី ផ្តន្ទាទោស ឧក្រិដ្ឋ ជន ក្នុង នាម រដ្ឋ អធិបតេយ្យ ដែល ប្រកាន់ យក គោលការណ៍ ដឹកនាំ តាម នីតិរដ្ឋ ។ យោង តាម ក្រម ព្រហ្មទណ្ឌ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ផែនការ ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ នេះ ត្រូវ ផ្តន្ទាទោស ក្រោម « បទល្មើស ឧបឃាត » តាម មាត្រា ៤៥១ ចំណែក អ្នក ដែល ចូលរួម ក្នុង គម្រោង ផែនការ នេះ ត្រូវ ផ្តន្ទាទោស ពី « បទល្មើស រួម គំនិត ក្បត់ » តាម មាត្រា ៤៥៣ ។
អ្នកនាំពាក្យ រូប នេះ បាន បញ្ជាក់ បន្ថែម ថា ចំពោះ ដីកា បង្គាប់ ឱ្យ ចាប់ខ្លួន ដែល ចេញ ដោយ តុលាការ កម្ពុជា គឺ មាន អានុភាព អនុវត្ត នៅក្នុង ដែនដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ហើយ ក្នុង ករណី ដែល ជនល្មើស រត់គេចខ្លួន ទៅ បរទេស ព្រះរាជអាជ្ញា អាច ស្នើសុំ ធ្វើ ការផ្សព្វផ្សាយ ជា អន្តរជាតិ នូវ ដីកា បង្គាប់ ឱ្យ ចាប់ខ្លួន តាមរយៈ ក្រសួង យុត្តិធម៌ ដោយ ប្រើ យន្តការ នានា ដែល មាន ប្រសិទ្ធភាព រួម មាន៖ យន្តការ ប៉ូលីស អាំង ទែរ ប៉ូល . យន្តការបត្យាប័ន ជាមួយ ប្រទេស ដែល មាន សន្ធិសញ្ញា បត្យាប័ន ជាមួយ កម្ពុជា ជាដើម ។
លោក ជិន ម៉ាលីន បញ្ជាក់ បន្ត ទៀត ថា ប៉ុន្តែ ជា គោលការណ៍ ច្បាប់ ចំពោះ ជនល្មើស ដែល មាន សញ្ជាតិ បរទេស រដ្ឋ បរទេស ដែល ជា ម្ចាស់ របស់ ពួក នឹង មិន ធ្វើ បត្យាប័ន ពលរដ្ឋ ដែល មាន សញ្ជាតិ របស់ គេ មក ឱ្យ កម្ពុជា ឡើយ ។ ដូចគ្នា នេះ កម្ពុជា ក៏ មិន អាច ធ្វើ បត្យាប័ន ពលរដ្ឋ ខ្លួន ឯង ទៅ ឱ្យ រដ្ឋ បរទេស នោះ ដែរ ៕
ចិន ជ្រើសរើស បាន ក្រុម អវកាសយានិក ដើម្បី ត្រៀម សម្រាប់ ការសាងសង់ ស្ថានីយ អវកាស ផ្ទាល់ខ្លួន ហើយ
( ប៉េកាំង ) ៖ អាជ្ញាធរ ផ្នែក អវកាស ចិន បាន ឲ្យដឹង ថា ក្រុម អវកាសយានិក ដែល នឹង ត្រូវ ចូលរួម ក្នុង ដំណើរការ សាងសង់ ស្ថានីយ អវកាស របស់ ប្រទេស ចិន ផ្ទាល់ នោះ គឺ ត្រូវបាន ជ្រើសរើស រួចរាល់ ហើយ ខណៈ ពួកគេ កំពុងតែ ទទួល កាហ្វឹកហាត់ ដើម្បី ត្រៀម បំពេញ បេសកកម្ម ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៉ីន ហួរ នៅ ថ្ងៃសុក្រ ទី ០៥ ខែមីនា ឆ្នាំ ២០២១ ។
ក្នុង ឆ្នាំ ២០២១ នេះ ប្រទេស ចិន នឹង ចាប់ផ្តើម បេសកកម្ម មួយ ចំនួន ពាក់ព័ន្ធ នឹង ការសាងសង់ ស្ថានីយ អវកាស របស់ ខ្លួន ក្នុង នោះ រួម មាន ទាំង ការបញ្ជូន កំណាត់ បន្ទប់ ស្នូល របស់ ស្ថានីយ ការបញ្ជូន សម្ភារៈ ផ្គត់ផ្គង់ ផ្សេង ៗ ព្រមទាំង ការបញ្ជូន អវកាសយានិក ឡើង ទៅកាន់ ទី អវកាស ដោយ បេសកកម្ម ទាំង នេះ នឹង ត្រូវ ធ្វើឡើង ជា បន្តបន្ទាប់ គ្នា តែម្តង ។
គួរ បញ្ជាក់ ថា ហ្វីលីពីន បាន ចាប់ផ្តើម យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ COVID-19 របស់ ខ្លួន កាលពី ថ្ងៃចន្ទ ដើម សប្ដាហ៍ នេះ ប៉ុន្តែ អ្នកជំនាញ សុខភាព មាន ការព្រួយបារម្ភ ថា ការរកឃើញ នូវ ករណី ឆ្លង នៃ វីរុស COVID-19 បំប្លែង ខ្លួន ថ្មី អាច ធ្វើឲ្យ មាន ការស្មុគស្មាញ ដល់ កិច្ចប្រឹងប្រែង របស់ ខ្លួន ៕
កាលពី ឆ្នាំ ២០២០ ប្រទេស ចិន បង្កើត ឱកាស ការងារ ថ្មី ៗ នៅ តាម ទីក្រុង និង ជនបទ បាន ជិត ១២លាន កន្លែង
( ប៉េកាំង ) ៖ លោក លី ខឺ ឈាង នាយក រដ្ឋមន្រ្តី ចិន បាន គូសបញ្ជាក់ នៅក្នុង របាយការណ៍ ការងារ រដ្ឋាភិបាល ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២១ នេះ ថា ប្រឈម នឹង បញ្ហា ដ៏ កម្រ ក្នុង ប្រវត្តិសាស្ត្រ កាលពី ឆ្នាំ ២០២០ ប្រទេស ចិន បាន ចាត់ទុក ការផ្តល់ ឱកាស ការងារ ជា ភារកិច្ច ចម្បង ដើម្បី ធានា ដល់ ជីវភាព រស់ នៅ របស់ ប្រជាជន ។
ក្នុង ឆ្នាំ ២០២០ កន្លងទៅ នេះ នៅ ទីក្រុង និង ជនបទ ទូទាំង ប្រទេស ចិន ឱកាស ការងារ ថ្មី ៗ រហូតដល់ ចំនួន ១១.៨៦០.០០០ កន្លែង ត្រូវបាន បង្កើតឡើង បន្ថែម ទៀត ខណៈ ដែល អត្រា បាត់បង់ ការងារ នៅ ទីក្រុង និង ជនបទ នា ចុង ឆ្នាំ ដដែល បាន ធ្លាក់ មក នៅ ត្រឹម ៥.២ភាគរយ ។ នៅ ឆ្នាំ ២០២១ នេះ វិញ ប្រទេស ចិន គ្រោង បន្ថែម ឱកាស ការងារ ថ្មី ៗ នៅ តាម ទីក្រុង និង ជនបទ ឲ្យ លើស ពី ១១លាន កន្លែង ចំណែក អត្រា បាត់បង់ ការងារ នៅ ទីក្រុង និង ជនបទ មាន ចំនួន ប្រមាណ ៥.៥ភាគរយ ។
ដោយឡែក បើ តាម ប្រភព ទិន្នន័យ មួយចំនួន ឱ្យដឹង ថា កាលពី ខែធ្នូ ឆ្នាំ ២០២០ ស្ថាប័ន ក្រៅពី វិស័យ កសិកម្ម នៃ អាមេរិក បាន កាត់បន្ថយ កម្លាំង ពលកម្ម ចំនួន ១៤ម៉ឺន នាក់ ហើយ អត្រា បាត់បង់ ការងារ គឺ ៦.៧ភាគរយ ។ ចំណែក អត្រា បាត់បង់ ការងារ នៃ តំបន់ ចាយ ប្រាក់ អឺរ៉ូវិញ គឺ ៨.៣ភាគរយ ។ រីឯ អត្រា បាត់បង់ ការងារ នៅ ជប៉ុន គឺ ២. ៩% ហើយ អត្រា បាត់បង់ ការងារ នៅ ឥណ្ឌា បាន កើន ដល់ ៩.០៦ ភាគរយ ខណៈ នៅ អាហ្វ្រិក ខាងត្បូង វិញ មាន អត្រា បាត់បង់ ការងារ នៅ ត្រីមាស ទី៤ ឆ្នាំ ២០២០ រហូតដល់ ៣២. ៥ភាគរយ ៕
នៅពេល មុន នេះ យោង តាម ទិន្នន័យ ដែល ចេញផ្សាយ ដោយ រដ្ឋបាល ជាតិ ស្ថិតិ ចិន បាន បង្ហាញ ថា ប្រឈមមុខ នឹង បរិយាកាស តានតឹង និង ស្មុគស្មាញ ទាំង ក្នុង ស្រុក និង ក្រៅ ប្រទេស ជាពិសេស ផល ប៉ះពាល់ ដ៏ ធ្ងន់ធ្ងរ ដែល បណ្តាល ពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ផលិតផល ក្នុង ស្រុក សរុប របស់ ប្រទេស ចិន ក្នុង ឆ្នាំ ២០២០ មាន ចំនួន ១០១.៦ ទ្រីលាន យាន់ ប្រាក់ ចិន បើ ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ ២០១៩ បាន កើនឡើង ២.៣ភាគរយ ដែល បាន ក្លាយជា អង្គភាព សេដ្ឋកិច្ច សំខាន់ តែ មួយ គត់ នៅលើ ពិភពលោក ដែល បាន សម្រេច កំណើន វិជ្ជមាន ៕
បទ អត្ថាធិប្បាយ៖ « មើល សមិទ្ធផល មហិមា របស់ ប្រទេស ចិន ចំពោះ ប្រជាជន ចិន និង ប្រជាជន ទូទាំង ពិភពលោក តាមរយៈ របាយការណ៍ ការងារ រដ្ឋាភិបាល ចិន ឆ្នាំ ២០២១ »
( ភ្នំពេញ ) ៖ ក្រោយពី បាន តាមដាន យ៉ាង យកចិត្តទុកដាក់ ទាក់ទង នឹង របាយការណ៍ ការងារ របស់ រដ្ឋាភិបាល ចិន ដែល បាន ថ្លែង ក្នុង កិច្ចប្រជុំ លើក ទី៤ នៃ មហាសន្និបាត សភា តំណាង ប្រជាជន ទូទាំង ប្រទេស ចិន នីតិកាល ទី ១៣ នា ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២១ ដោយ លោក លី ខឺ ឈាង នាយក រដ្ឋមន្រ្តី នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ខ្ញុំ មាន ការចាប់អារម្មណ៍ លើ ចំណុច សំខាន់ ចំនួន ២គឺ៖
ក្នុង ដំណើរ ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ ជំងឺ COVID-19 ដ៏ លំបាក លំបិន ជានិច្ចកាល មជ្ឈិម បក្ស កុម្មុយនិស្ត ចិន តែង បាន ប្រកាន់ខ្ជាប់ នូវ ការតម្កល់ ទុក ប្រជាជនជា អាទិភាព តម្កល់ ទុក សុវត្ថិភាព អាយុជីវិត របស់ ប្រជាជនជា អាទិភាព ។ លោក ស៊ី ជីន ពីង អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈិម បក្ស កុម្មុយនិស្ត ចិន បាន ដឹកនាំ និង ចាត់ចែង ការងារ ដោយ ផ្ទាល់ ព្រមទាំង ទទួលបាន ការគាំទ្រ ពីសំណាក់ ភាគី នានា ដោយ ពង្រឹង និង ពង្រីក សមិទ្ធផល នៃ ការងារ បង្ការ និង គ្រប់គ្រង ជំងឺ ឆ្លង ។
២៖ គាំពារ យ៉ាង មុតមាំ នូវ ប្រព័ន្ធ ពាណិជ្ជកម្ម ពហុ ភាគី
ដូច ដែល យើង បាន ដឹង តាមរយៈ របាយការណ៍ របស់ រដ្ឋាភិបាល ចិន ដែល បាន គូសបញ្ជាក់ ថា ប្រទេស ចិន តែ មួយ គត់ មាន កំណើន សេដ្ឋកិច្ច វិជ្ជមាន ក្នុង ចំណោម អង្គភាព សេដ្ឋកិច្ច សំខាន់ ៗ នៅលើ ពិភពលោក ព្រមទាំង ទទួល ជោគជ័យ ក្នុង យុទ្ធនាការ ពុះពារ ឧបសគ្គ ក្នុង ការលុបបំបាត់ ភាពក្រីក្រ និង ទទួលបាន សមិទ្ធផល ជា លក្ខណៈ សម្រេច ក្នុង កិច្ច កសាង សង្គម ដែល ប្រជាជន មាន ជីវភាព ធូរធារ បង្គួរ ដោយ គ្រប់ ជ្រុងជ្រោយ ដែល ប្រជាជន ចិន ពេញចិត្ត និង ជា ការកត់សម្គាល់ ខ្លាំង ពីសំណាក់ ប្រទេស នានា នៅ ទូទាំង ពិភពលោក ។
ជា រួម យើង ឃើញ ថា សមិទ្ធផល ដែល ប្រទេស ចិន សម្រេចបាន ហើយ ត្រូវបាន រាយការណ៍ ជា សាធារណៈ ក្នុង កិច្ចប្រជុំ លើក ទី៤នៃ មហាសន្និបាត សភា តំណាង ប្រជាជន ទូទាំង ប្រទេស ចិន នីតិកាល ទី ១៣ នា ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២១ ដោយ លោក លី ខឺ ឈាង នាយក រដ្ឋមន្ត្រី នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន គឺ ដោយសារតែ ប្រទេស ចិន នៅតែ បាន បន្ត ការរួមចំណែក ដល់ ការអភិវឌ្ឍ ជា សកល បន្ត ព្យាយាម សម្រេច នូវ ការរីកចម្រើន រួម ក៏ ដូចជា យុទ្ធសាស្រ្ត នៃ ការបើកចំហ ដែល ផ្តល់ ផលប្រយោជន៍ រួម និង ឈ្នះ - ឈ្នះ ដល់ បណ្តា ប្រទេស ទាំងអស់ ។
លើស ពី នេះ ប្រទេស ចិន តែង បាន ត្រៀម ខ្លួន រួច ជាស្រេច ក្នុង ការចែករំលែក បទពិសោធន៍ និង ន វានុវត្តភាព របស់ យើង ជាមួយ បណ្តា ប្រទេស ដទៃ ទៀត ហើយ សាទរ ដល់ ដំណើរ អភិវឌ្ឍន៍ ដ៏ ឆាប់រហ័ស របស់ បណ្តា ប្រទេស ទាំងអស់ ឆ្ពោះ ទៅរក ការអភិវឌ្ឍ រួម ។ ប្រទេស ចិន តែង ប្រកាន់ យក នូវ សណ្តាប់ធ្នាប់ អន្ដរជាតិ តាមរយៈ ការប្តេជ្ញាចិត្ត ចំពោះ មាគ៌ា នៃ ការអភិវឌ្ឍ និង កិច្ចសហប្រតិបត្តិការ ។
ដោយ បណ្ឌិត ជា មុនី ឫទ្ធិ ប្រធាន សមាគម អ្នកស្រាវជ្រាវ វឌ្ឍនភាព កម្ពុជា - ចិន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង និង អភិវឌ្ឍ តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា ណែនាំ ឱ្យ ខេត្ត ជាប់ ឆ្នេរសមុទ្រ រៀបចំ សោភ័ណភាព ឆ្នេរ ដើម្បី ត្រៀម ចូលរួម ប្រឡង ប្រណាំង ឆ្នេរ ខ្សាច់ កម្សាន្ត ស្អាត
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង និង អភិវឌ្ឍ តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា ហៅ កាត់ គ. អ. ឆ.ក . បាន ណែនាំ ឱ្យ រដ្ឋបាល ខេត្ត ជាប់ ឆ្នេរសមុទ្រ ទាំង បួន របស់ កម្ពុជា ត្រូវ រៀបចំ សោភ័ណភាព នៅ តាម ឆ្នេរសមុទ្រ សំខាន់ ៗ ក្នុង ខេត្ត របស់ ខ្លួន ដើម្បី ត្រៀម ចូលរួម ប្រឡង ប្រណាំង ឆ្នេរ ខ្សាច់ កម្សាន្ត ស្អាត នា ពេល ខាងមុខ ។
សូម បញ្ជាក់ ថា គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង និង អភិវឌ្ឍ តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា បាន ដាក់ចេញ ចលនា ប្រឡង ប្រណាំង ឆ្នេរ ខ្សាច់ កម្សាន្ត ស្អាត លើក ទី៣ ឆ្នាំ ២០២១ ដែល ការវាយតម្លៃ ត្រូវ ប្រើប្រាស់ គោលការណ៍ ណែនាំ ស្តីពី ការគ្រប់គ្រង ឆ្នេរ ខ្សាច់ កម្សាន្ត ដែល មាន ៨ សូចនាករ គោល រួម មាន ៦៨ លក្ខណៈ វិនិច្ឆ័យ ។ ឯកសារ គោលការណ៍ ណែណែនាំ ស្តីពី ការគ្រប់គ្រង ឆ្នេរ ខ្សាច់ កម្សាន្ត ដែល ត្រូវបាន បង្កើតឡើង តាំងពី ឆ្នាំ ២០១៦ នោះ នឹង ត្រូវ ធ្វើ បច្ចុប្បន្នភាព ដោយ បន្ថែម សូចនាករ ថ្មី ចំនួន ៣ ដូច រៀបរាប់ ខាងលើ ៕
លោក Verez បាន គូសបញ្ជាក់ ប្រាប់ ថា « យើង កំពុង ឈានចូល ដល់ ដំណាក់កាល ធ្វើតេស្ត សាកល្បង ដ៏ សំខាន់ ហើយ ដើម្បី បង្ហាញ ពី ប្រសិទ្ធភាព នៃ វ៉ាក់សាំង របស់ យើង » ។ បន្ទាប់ពី ត្រូវបាន អនុម័ត ដោយ មជ្ឈមណ្ឌល ត្រួតពិនិត្យ ឱសថ និង ឧបករណ៍ វេជ្ជសាស្រ្ត គុយ បា កាលពី ថ្ងៃពុធ សប្ដាហ៍ នេះ បេក្ខភាព វ៉ាក់សាំង ដែល ផលិត ក្នុង ស្រុក នេះ នឹង ចាប់ផ្តើម ចាក់ ជូន ដល់ អ្នកស្ម័គ្រចិត្ត នៅ ចុង ខែមីនា នេះ ហើយ ។
ចំណេះដឹង ទូទៅ៖ ភរិយា ប្រធានាធិបតី អាមេរិក ចន អេហ្វ កេណ្ណឺឌី មក ទស្សនកិច្ច នៅ កម្ពុជា បន្សល់ទុក នូវ អនុស្សាវរីយ៍ ជាច្រើន
សារព័ត៌មាន បរទេស ជាច្រើន បាន សរសេរ ខ្លឹមសារ យ៉ាង ដូច្នេះ ថា នៅពេល សួរ ថា « ហេតុ អ្វី បានជា ព្រះអង្គ ដាក់ ឈ្មោះ ផ្លូវ សម្រាប់ លោក ចន អេហ្វ កេណ្ណឌី នៅក្នុង ក្រុង ព្រះសីហនុ ដែល មិន មែន ជា រាជធានី របស់ ទ្រង់ នោះ ». ព្រះអង្គ មាន ព្រះបន្ទូល ថា « វា ត្រូវបាន ដាក់ឈ្មោះ តាម ខ្ញុំ . ទោះ យ៉ាងណា ឈ្មោះ របស់ ខ្ញុំ ត្រូវបាន ប្រើប្រាស់ ជាច្រើន ហើយ ក្នុង រាជធានី ភ្នំពេញ » ។
មាន អនុស្សាវរីយ៍ ជាច្រើន ដែល នៅសល់ ពី ដំណើរទស្សនកិច្ច របស់ លោកស្រី ចាកខ្វលីន ក្នុង នោះ រួម មាន៖
តើ ប្រទេស ចិន នឹង គ្រោង ផែនទី ផ្លូវ អភិវឌ្ឍន៍ ក្នុង មួយ រយៈ កាល នៅពេល អនាគត ដោយ របៀប ណា ? ហើយ ប្រទេស ចិន នឹង នាំមក នូវ ផលប្រយោជន៍ អ្វី ខ្លះ ដល់ បណ្តា ប្រទេស នានា នៅលើ ពិភពលោក ? សហគមន៍ អន្ដរជាតិ រំពឹងទុក ទទួល ដំណឹង ល្អ ដែល គួរឱ្យ មាន ក្តីរំភើប កាន់តែ ច្រើន ពីសំណាក់ មហាសន្និបាត នៃ សភា ទាំង ពីរ របស់ ប្រទេស ចិន នៅ ឆ្នាំ នេះ ។
* ផែនការអភិវឌ្ឍន៍ ជាតិ ៥ ឆ្នាំ ទី ១៤៖ ឆ្នាំ នេះ មហាសន្និបាត នៃ សភា ទាំង ពីរ របស់ ប្រទេស ចិន នឹង ពិនិត្យ ពិភាក្សា អំពី ផែនការអភិវឌ្ឍន៍ ជាតិ ៥ឆ្នាំ ទី១៤ និង សេចក្តីព្រាង ច្បាប់ ស្តីពី គោលដៅ ចក្ខុវិស័យ រយៈពេល វែង ឆ្នាំ ២០៣៥ ។ តាម ការផ្សាយ ដំណឹង របស់ ប្រព័ន្ធ សារព័ត៌មាន បរទេស ឱ្យដឹង ថា ប្រការ នេះ នឹង ជា ខ្លឹមសារ មួយ នៃ មហាសន្និបាត នៃ សភា ទាំង ពីរ របស់ ប្រទេស ចិន ឆ្នាំ នេះ ដែល ទទួល ការយកចិត្តទុកដាក់ យ៉ាង ទួលំទូលាយ ។
យោង តាម ការផ្សាយ ដំណឹង បាន ឱ្យដឹង ថា នៅ ឆ្នាំ ២០៣៥ ទំហំ សេដ្ឋកិច្ច សរុប និង ប្រាក់ ចំណូល គិត ជា មធ្យម ក្នុង មនុស្ស ម្នាក់ ៗ នៃ ប្រទេស ចិន នឹង កើន ទ្វេ ដង បើ ប្រៀបធៀប នឹង ពេល បច្ចុប្បន្ន ហើយ គោលដៅ នេះ នឹង សម្រេចបាន ក្រោម ពាក្យសន្យា របស់ ចិន ស្តីពី ការសម្រេច ឱ្យ បាន បញ្ឈប់ ការបញ្ចេញ ឧស្ម័ន កាបូន លើស កម្រិត នៅ ត្រឹម ឆ្នាំ ២០៦០ ។ បើ និយាយ ចំពោះ ប្រទេស ចិន នេះ គឺជា បញ្ហា ប្រឈម ដ៏ ធំធេង មួយ ។
* គោលដៅ អភិវឌ្ឍ ន៍៖ ទំហំ សេដ្ឋកិច្ច សរុប របស់ ចិន ក្នុង ឆ្នាំ ២០២០ បាន វាយ ទម្លុះ ១០០ ទ្រីលាន យាន់ ប្រាក់ ចិន ហើយ ផលិតផល ក្នុង ស្រុក សរុប បាន កើនឡើង ២.៣ភាគរយ បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០១៩ ។ ទោះបីជា ទទួលរង ផល ប៉ះពាល់ ពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក៏ដោយ ក៏ប៉ុន្តែ ប្រទេស ចិន នៅតែ បោះជំហាន ទៅ មខុផ្ទុយ នឹង និន្នាការ ដែល ក្លាយជា អង្គភាព សេដ្ឋកិច្ច សំខាន់ តែ មួយ គត់ លើ ពិភពលោក ដែល បាន សម្រេច កំណើន វិជ្ជមាន ។
* ការច្នៃប្រឌិត ថ្មី ផែ្នក បច្ចេកវិទ្យា៖ ចាប់តាំងពី អនុវត្ត « ផែនការអភិវឌ្ឍន៍ ជាតិ ៥ឆ្នាំ ទី១៣ » មក ប្រទេស ចិន បាន ទទួល សមិទ្ធផល ប្រកបដោយ លក្ខណៈ សម្រេច ក្នុង ការកសាង ប្រទេសជាតិ បែប ច្នៃប្រឌិត ថ្មី ដែល បាន បង្កើត ជា សភាពការណ៍ ដែល ផ្តល់ ថាម វ័ន្ត ដ៏ រឹងមាំ ផែ្នក បច្ចេកវិទ្យា ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ការកែលម្អ ជីវភាព រស់ នៅ របស់ ប្រជាជន និង សន្តិសុខ ជាតិ ជាដើម ។
ដោយសារ ភាព ទាក់ទាញ នៃ កំណើន សេដ្ឋកិច្ច យ៉ាង ឆាប់រហ័ស របស់ ប្រទេស ចិន និង ផែនការអភិវឌ្ឍន៍ ជាតិ ៥ឆ្នាំ ទី១៤ ដែល ជិត នឹង ប្រកាស ដោយ មហាសន្និបាត នៃ សភា ទាំង ពីរ បានជា មូលធន ជា សកល កំពុង នាំគ្នា ចូលក្នុង ទីផ្សារ ចិន ។ គិត មក ទល់ ចុង ខែកុម្ភៈ តម្លៃ សរុប នៃ ប័ណ្ណ រតនាគារ ចិន ដែល កាន់កាប់ ដោយ វិនិយោគិន បរទេស បាន លើស ពី ២ទ្រី លាន យាន់ ប្រាក់ ចិន ជា លើក ដំបូង ដែល បាន បំបែក កំណត់ត្រា ថ្មី ក្នុង ប្រវត្តិសាស្រ្ត ម្តង ទៀត ។
រំពឹង ថា ផែនទី ផ្លូវ អភិវឌ្ឍ នៅពេល អនាគត ដែល បង្ហាញ ដោយ ប្រទេស ចិន នឹង បញ្ជូន នូវ សញ្ញា វិជ្ជមាន កាន់តែ ច្រើន ទៅកាន់ ពិភពលោក ហើយ នាំមក នូវ ផលប្រយោជន៍ កាន់តែ ច្រើន ដល់ ការអភិវឌ្ឍ របស់ ពិភពលោក ទាំងមូល ៕ កញ្ចប់ ជំនួយ លើក ទី៣ របស់ សហគ្រិន ខ្មែរ នៅតែ បន្ត បើក ទទួល ពាក្យ ចូលរួម ដើម្បី ជួយ ដល់ សហគ្រាស ធុន តូច មធ្យម និង ធុរកិច្ច បង្កើត ថ្មី
( ភ្នំពេញ ) ៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ តាមរយៈ សហគ្រិន ខ្មែរ នៅតែ បន្ត បើក ទទួល ពាក្យ ចូលរួម កម្មវិធី កញ្ចប់ ជំនួយ លើក ទី៣ ដើម្បី ជួយ ដល់ សហគ្រាស ធុន តូច មធ្យម និង ធុរកិច្ច បង្កើត ថ្មី ។
កញ្ចាប់ ជំនួយ នេះ មាន ចក្ខុវិស័យ ជួយ ស្តារ សហគ្រាស ក្នុង ស្រុក ទាំង តូច មធ្យម និង ធុរកិច្ច បង្កើត ថ្មី លើ វិស័យ បច្ចេកវិទ្យា គមនាគមន៍ ព័ត៌មានវិទ្យា សេវាកម្ម កសិកម្ម និង ផលិតកម្ម ដែល កំពុង ប្រឈម អំឡុង ពេល វិបត្តិ កូវីដ - ១៩ ។
ជាក់ស្តែង រហូតមកដល់ ថ្ងៃ នេះ មាន បេក្ខជន ដាក់ពាក្យ ចូលរួម ពី ស្ទើរ គ្រប់ ខេត្ត ក្រុង ក្នុង ប្រទេស កម្ពុជា ដែល គ្របដណ្តប់ លើ វិស័យ អាទិភាព សំខាន់ ៗ ទាំង៤ ដែល សហគ្រិន ខ្មែរ បាន ផ្តោត ចិត្តទុកដាក់ ពោលគឺ អាជីវកម្ម សេវាកម្ម បដិសណ្ឋារកិច្ច ព័ត៌មានវិទ្យា និង កសិកម្ម ។
អគ្គ នាយក ប្រតិបត្តិ នៃ សហគ្រិន ខ្មែរ លោក បណ្ឌិត ឈៀង វណ្ឌ មុនិណ្ឌ បាន ថ្លែង ថា « ដោយ មើលឃើញ អំពី ប្រសិទ្ធភាព នៃ កញ្ចប់ ជំនួយ របស់ សហគ្រិន ខ្មែរ ទាំង ២លើ ក ចាប់តាំងពី ឆ្នាំ ២០២០មក ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ តាមរយៈ សហគ្រិន ខ្មែរ នៅតែ បើក ឱកាស ឲ្យ សហគ្រិន ក្នុង ស្រុក អាច ស្នើរ សុំ ប្រកួតប្រជែង ដើម្បី ទទួលបាន កញ្ចប់ ជំនួយ ដែល អាច ជួយ ពួកគាត់ បន្ត អាជីវកម្ម នៅ អំឡុង ពេល វិបត្តិ ជំងឺ កូវីដ ១៩ នេះ » ។
លោក ក៏ បាន លើកទឹកចិត្ត ដល់ សហគ្រិន ដែល ធ្លាប់ ចូលរួម ប្រកួត កាលពី រដូវកាល មុន ដែល មិន បាន ជាប់ ទទួល កញ្ចប់ ជំនួយ អាច ព្យាយាម ជាថ្មី ម្តង ទៀត និង បាន ក្រើន រំឮក ដល់ អ្នក មិន ទាន់ បាន ដាក់ពាក្យ សូម រួសរាន់ ដើម្បី កុំ ឲ្យ ឱកាស មាស នេះ កន្លងផុត ទៅ ។
ជាក់ស្តែង ដំណើរការ នៃ ការជ្រើសរើស អាជីវកម្ម ដើម្បី ទទួលបាន កញ្ចប់ ជំនួយ នេះ រួម មាន៖ ការធ្វើ បទបង្ហាញ អំពី ដំណើរ អាជីវកម្ម និង យុទ្ធសាស្រ្ត ក្នុង ការប្រើប្រាស់ កញ្ចប់ ថវិកា រហូតដល់ ជ្រើសរើស ជ័យលាភី ។
បើ តាម លោក Andrews ក្រុមប្រឹក្សា សន្តិសុខ របស់ UN គួរតែ ប្រញាប់ ដាក់ទណ្ឌកម្ម អាវុធ ជា លក្ខណៈ អន្តរជាតិ ហើយ ដាក់ទណ្ឌកម្ម ផ្នែក សេដ្ឋកិច្ច ថែម ទៀត ប្រឆាំង នឹង យោធា មីយ៉ាន់ម៉ា ផ្ទាល់ ព្រមទាំង ប្រភព ចំណូល ផ្សេង ៗ របស់ យោធា ។ មន្រ្តី UN រូប នេះ បាន បន្ត ទៀត ថា ស្រប ពេល ទន្ទឹម គ្នា UN និង សហគមន៍ អន្តរជាតិ ដាច់ខាត ត្រូវតែ កុំ ទទួលស្គាល់ ឲ្យ សោះ ថា យោធា មីយ៉ាន់ម៉ា ជា រដ្ឋាភិបាល ស្រប ច្បាប់ ក្រោយ ការទម្លាក់ រដ្ឋាភិបាល ស៉ី វិល របស់ លោកស្រី អោង សាន ស៊ូ ជី ។
ក្រុមហ៊ុន របស់ ថៃ Jet Capital បង្ហាញ ភាពស្អាតស្អំ និង ការបំពេញ គ្រប់ លក្ខខណ្ឌ របស់ ខ្លួន ទៅកាន់ រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម ដើម្បី បាន ចុះបញ្ជី ឈ្មោះ ក្រុមហ៊ុន ផ្លូវការ ផ្គត់ផ្គង់ សត្វ ជ្រូក មក កម្ពុជា
គោលការណ៍ ទាំង ១២ ចំណុច នោះ ដែល សរុប បញ្ចូល គ្នា តែ ៣លិខិត៖ ១៖ ត្រូវ មាន លិខិត បញ្ជាក់ សុខភាព សត្វ ។ ២៖ លិខិត ចាក់ វ៉ាក់សាំង លើ សត្វ ជ្រូក ( ១១ចំណុច ) បញ្ជាក់ ថា សត្វ ជ្រូក ដែល នាំចូល មក កម្ពុជា បាន ចាក់ វ៉ាក់សាំង ត្រឹមត្រូវ និង បញ្ជាក់ ថា គ្មាន ជំងឺ ។ ៣៖ លិខិត បញ្ជាក់ ពី ការធ្វើចត្តាឡី ស័ក សត្វ នៅនឹង មាត់ ច្រក ព្រំដែន ( ទឹកដី ថៃ ) ។
គោលការណ៍ ទាំង ១២ ចំណុច នេះ មាន ប្រទេស ថៃ ដែល ជា ប្រទេស ទទួលស្គាល់ ក្នុង តំបន់ ថា មាន ការគ្រប់គ្រង សត្វ រស់ បាន យ៉ាង ល្អ នោះ អនុវត្ត សម្រាប់ ការនាំចេញ ជ្រូក រស់ ទៅ បណ្តា ប្រទេស នានា មាន តែ លិខិត ទី១ និង លិខិត ទី២ ប៉ុណ្ណោះ សម្រាប់ លិខិត ទី៣ ដែល អគ្គ នាយក សុខភាព សត្វ របស់ កម្ពុជា តម្រូវ ធ្វើចត្តាឡី ស័ក សត្វ នៅនឹង មាត់ ច្រក ព្រំដែន នោះ គឺ ប្រទេស ថៃ តម្រូវឲ្យ មាន ការ ធ្វើចត្តាឡី ស័ក នៅនឹង កសិដ្ឋាន តែ ប៉ុណ្ណោះ ។
ការបន្ថែម ក្រុមហ៊ុន ផ្គត់ផ្គង់ នៅក្នុង ប្រទេស ថៃ គឺ មិន ពាក់ព័ន្ធ ឬ មាន ផល ប៉ះពាល់ ដល់ កសិដ្ឋាន ចិញ្ចឹម នៅក្នុង ស្រុក នោះ ទេ ផ្ទុយ មកវិញ រឹតតែ ធ្វើឲ្យ ការប្រកួតប្រជែង តម្លៃ កាន់តែ ធូរ ថ្លៃ មកដល់ ក្រុមហ៊ុន កម្ពុជា ដែល បញ្ជាទិញ នាំចូល នាំឲ្យ តម្លៃ ទីផ្សារ ជ្រូក កម្ពុជា វិល មក រក ភាព ប្រក្រតី ឡើងវិញ ។
មិន ត្រឹមតែ ប៉ុណ្ណោះ ការបូក បន្ថែម តម្លៃ ក្បាល ជ្រូក ( ខាង ថៃ គេ ហៅ ថា លក់ កូតា ) ព្រោះ ពួកគេ បាន សិទ្ធិ ផ្គត់ផ្គង់ គឺ ស្មើនឹង បាន កូតា អីចឹង បើ ក្រុមហ៊ុន ដទៃណា ចង់ ចាប់ ជ្រូក ផ្គត់ផ្គង់ ឲ្យ ដល់ ក្រុមហ៊ុន ជា ម៉ូយ ខ្លួន ខាង ខ្មែរ ដាច់ខាត ត្រូវតែ ឆ្លងកាត់ ការទិញ កូតា ពី ស្ត្រី ជនជាតិ ថៃ ម្នាក់ នោះ ឯង ដែល គេ លក់ ក្នុង តម្លៃ ខាង ថៃ ១៦ ដុល្លារ / ក្បាល ។
( កោះកុង ) ៖ លោក វេជ្ជបណ្ឌិត ទៅ ម៉ឹង ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កោះកុង នៅ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ឱ្យដឹង ថា ក្រោយ រកឃើញ ជនជាតិ ចិន ចំនួន ២នាក់ ជា បុគ្គលិក របស់ ក្រុមហ៊ុន ចិន មាន វិជ្ជមាន ជំងឺ កូវីដ១៩ អាជ្ញាធរ បាន ផ្អាក ការធ្វើដំណើរ ចេញ ចូល តំបន់ ក្រុមហ៊ុន ញូញៀន មួយ រយៈ សិន មិន ថា តែ ផ្លូវគោក ឬ ផ្លូវ ទឹក ឡើយ ដើម្បី ផ្តល់ លទ្ធភាព ដល់ មន្រ្តី សុខាភិបាល ស្រាវជ្រាវ រក មនុស្ស សង្ស័យ បន្ថែម ទៀត ។
លោក វេជ្ជបណ្ឌិត ទៅ ម៉ឺង បាន បន្ថែម ថា ចំពោះ ជនជាតិ ចិន ២នាក់ ដែល ជំងឺ កូវីដ១៩ ត្រូវ មន្ត្រី សុខាភិបាល បាន យក ពួកគាត់ មក សម្រាក ព្យាបាល ក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត រួចរាល់ ហើយ កាលពី យប់ មិញ នេះ ហើយ មន្ទីរពេទ្យ មាន ការយាម កាម ត្រឹមត្រូវ តឹងរឹង មិន មាន ការធ្វេសប្រហែស ឡើយ ។
លោក វេជ្ជបណ្ឌិត បាន បន្ត ថា ក្រោយ ធ្វើតេស្ត សំណាក ជនជាតិ ចិន ទាំង ៣៨ នាក់ ហើយ វិជ្ជមាន ២នាក់ នោះ មន្ត្រី សុខាភិបាល នឹង ធ្វើតេស្ត បន្ត បន្ថែម ទៀត រហូតដល់ តែ អស់ មនុស្ស ពី ក្រុមហ៊ុន នេះ ជា វិធានការ របស់ ក្រសួង សុខាភិបាល ដើម្បី ការពារ កូវីដ - ១៩ ចូលក្នុង សហគមន៍ ។
គួរ បញ្ជាក់ ថា សហរដ្ឋ អាមេរិក ដែល បាន ចំណាយ កញ្ចប់ ថវិកា យោធា ដល់ ទៅ ខ្ទង់ ៩៣៤ ពាន់ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ គិត ចាប់ពី ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០២០ ដល់ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០២១ បាន រិះគន់ យ៉ាង ខ្លាំង ចំពោះ ចិន ជុំវិញ អ្វី ដែល ទីក្រុង វ៉ាស៊ីនតោន ផ្ទាល់ បាន ចោទប្រកាន់ ថា ជា ការខ្វះខាត តម្លាភាព នៃ ការចំណាយ លើ វិស័យ យោធា របស់ ចិន ហើយ យោធា អាមេរិក ក៏ បាន សង្ស័យ ផងដែរ ថា ចិន កំពុង ព្យាយាម ដណ្ដើម តំណែង របស់ សហរដ្ឋ អាមេរិក ក្នុង នាម ជា មហាអំណាច យោធា លេខ មួយ នៅក្នុង តំបន់ អាស៊ី ខាងកើត ៕
( បាដាដ) ៖ សម្តេច ប៉ាប ហ្វ្រង់ ស័រ បាន ទៅដល់ ទីក្រុង បាដាដ នៃ ប្រទេស អ៊ីរ៉ាក់ ហើយ នៅ ថ្ងៃសុក្រ ទី៥ ខែមីនា នេះ សម្រាប់ ដំណើរទស្សនកិច្ច ក្រៅ ប្រទេស មួយ ដែល ប្រកបដោយ គ្រោះថ្នាក់ បំផុត ចាប់តាំងពី លោក បាន ជាប់ ឆ្នោត កាលពី ឆ្នាំ ២០១៣ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន CNA ។
