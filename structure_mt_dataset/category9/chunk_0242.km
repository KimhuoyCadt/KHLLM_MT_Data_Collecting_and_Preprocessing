( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា បាន លើកទឹកចិត្ត ដល់ គ្រឹះស្ថាន ឧត្តម សិក្សា រដ្ឋ និង ឯកជន ឱ្យ ដាក់ពាក្យ ចូលរួម បង្ហាញ ស្នាដៃ និពន្ធ និង កែលម្អ សៀវភៅ សិក្សា ឱ្យ បាន កាន់តែ ច្រើន ដើម្បី ជា គុណ ប្រយោជន៍ ដល់ តម្រូវការ របស់ និស្សិត កម្ពុជា ក្នុង ការសិក្សា និង ស្រាវជ្រាវ នៅ កម្រិត ឧត្តម សិក្សា ។
កិច្ចការ នេះ ធ្វើឡើង ក្នុង គោលដៅ បង្កើន បរិមាណ លើកកម្ពស់ គុណភាព និង ពង្រីក សមធម៌ នៃ ធនធាន សិក្សា ជា ខេមរ ភាសា ជូន ដល់ សិស្ស - និស្សិត ដែល កំពុង សិក្សា និង ស្រាវជ្រាវ នៅ កម្រិត ឧត្តម សិក្សា ។
ក្រសួង បាន បញ្ជាក់ ទៀត ថា គិត មក ត្រឹម ថ្ងៃទី ២ ខែមីនា ឆ្នាំ ២០២១ នេះ មាន គ្រឹះស្ថាន ឧត្តម សិក្សា ចំនួន ១៧ បាន ដាក់ពាក្យ ស្នើសុំ ថវិកា សម្រាប់ គាំទ្រ ដល់ ការរៀប រៀង និពន្ធ និង កែលម្អ សៀវភៅ សិក្សា ស្មើនឹង ៨៥៦ ចំណងជើង ។
ការចូលរួម នៃ គ្រឹះស្ថាន ឧត្តម សិក្សា រដ្ឋ និង ឯកជន ក្នុង គម្រោង ការរៀប រៀង និពន្ធ និង កែលម្អ សៀវភៅ សិក្សា ជា ការរួមចំណែក លើកកម្ពស់ វប្បធម៌ នៃ ការស្រាវជ្រាវ បំផុស គំនិត ច្នៃប្រឌិត និង ជំរុញ ការធ្វើ ន វានុវត្តន៍ ដើម្បី ជា ប្រយោជន៍ ដល់ វិស័យ អប់រំ យុវជន និង កីឡា ដែល ជា ការឆ្លើយតប ទៅនឹង ទីផ្សារ ពលកម្ម និង សាកល ភាវូបនីយកម្ម និង ជាពិសេស ជា ការគាំទ្រ ដល់ ការលើកកម្ពស់ គុណភាព នៃ ការរៀន ការបង្រៀន និង ការស្រាវជ្រាវ នៅ កម្រិត ឧត្តម សិក្សា មុខវិជ្ជា មួយ មុខ សៀវភៅ សិក្សា មួយ ក្បាល ។
ក្រសួង អប់រំ បាន លើកទឹកចិត្ត ជូន ដល់ គ្រឹះស្ថាន ឧត្តម សិក្សា រដ្ឋ និង ឯកជន ឱ្យ ចូលរួម ដាក់ពាក្យ ស្នើសុំ ថវិកា ពី មូលនិធិ ស្រាវជ្រាវ គំនិត ច្នៃប្រឌិត និង ន វានុវត្តន៍ ដើម្បី រៀប រៀង និពន្ធ និង កែលម្អ សៀវភៅ សិក្សា ឱ្យ បាន កាន់តែ ច្រើន បន្ថែម ទៀត ដើម្បី ជា គុណ ប្រយោជន៍ ដល់ តម្រូវការ របស់ និស្សិត កម្ពុជា ក្នុង ការសិក្សា និង ស្រាវជ្រាវ នៅ កម្រិត ឧត្តម សិក្សា ៕
អគ្គ សេនាធិការ ចម្រុះ នៃ យោធា កូរ៉េ ខាងត្បូង បាន ចេញ សេចក្តីប្រកាស ថា សម្ព័ន្ធមិត្ត ទាំង ពីរ នឹង ចាប់ផ្តើម ការធ្វើ សមយុទ្ធ ខាងលើ នៅ ថ្ងៃចន្ទ ដើម សប្តាហ៍ ក្រោយ នេះ ហើយ វា នឹង មាន រយៈពេល សរុប ០៩ ថ្ងៃ ។ យ៉ាងណាមិញ សមយុទ្ធ យោធា ប្រចាំ ឆ្នាំ នេះ នឹង មិន មាន ការចល័ត នៅ ខាងក្រៅ ឡើយ ហើយ ចំនួន កងទ័ព ចូលរួម ព្រមទាំង សម្ភារៈ ក៏ នឹង ត្រូវកាត់បន្ថយ ឲ្យ នៅ តិចតួច ជាង ធម្មតា ផងដែរ នៅ ចំពោះមុខ ការបន្តរាតត្បាត នៃ COVID-19 ។
គួរ បញ្ជាក់ ថា ការធ្វើ សមយុទ្ធ យោធា រូម គ្នា រវាង កូរ៉េ ខាងត្បូង និង សហរដ្ឋ អាមេរិក តែងតែ ស្ថិត ក្រោម ក្រសែភ្នែក ឃ្លាំមើល យ៉ាង យកចិត្តទុកដាក់ ពីសំណាក់ កូរ៉េ ខាងជើង ដែល ចាត់ទុក ពួកវា ថា ជា សកម្មភាព ហាត់ សម ដើម្បី ឈ្លានពាន ប្រទេស ខ្លួន ឬ ត្រៀម សម្រាប់ ការផ្ទុះ សង្រ្គាម ៕
( ភ្នំពេញ ) ៖ លោកជំទាវ កុយ ពិសី គឺជា ស្ត្រី ខ្មែរ ១រូប ដែល បាន ចំណាយ ពេលវេលា ជាង ២០ ឆ្នាំ ពោលគឺ ស្ទើ តែ ពាក់កណ្តាល ជីវិត លើ កិច្ចការ ព្រំដែន កម្ពុជា ។ លោកជំទាវ បាន ចាប់ផ្ដើម បេសកកម្ម បាន ចាប់ផ្តើម តាំងពី ដើម ឆ្នាំ ១៩៩៦ ។ គិត មកដល់ ពេលនេះ មាន ប្រមាណ ជាង ២០ ឆ្នាំ ហើយ ដែល លោកជំទាវ បាន ខិតខំ បំពេញ កិច្ចការ បម្រើ ជាតិ មាតុភូមិ លើ វិស័យ កិច្ចការ ព្រំដែន ។
បច្ចុប្បន្ន លោកជំទាវ កុយ ពិសី មាន តួនាទី ជា អនុប្រធាន លេខាធិការដ្ឋាន អចិន្ត្រៃយ៍ នៃ អាជ្ញាធរ ជាតិ ទទួលបន្ទុក កិច្ចការ ព្រំដែន និង ជា រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ ។ មិន តែ ប៉ុណ្ណោះ លោកជំទាវ ក៏ អ្នក ក្រុមការងារ ចុះ ពង្រឹង មូលដ្ឋាន គណៈប្រជាជន កម្ពុជា នៅក្នុង ខេត្ត ចចំនួន ២ ផងដែរ គឺ ខេត្ត កំពង់ធំ និង ខេត្ត តាកែវ ។
លោកជំទាវ ជា ស្រ្តី ខ្មែរ មួយ រូប ដែល តែងតែ ចូល តុ ចរចា អំពី កិច្ចការងារ ព្រំដែន ជាមួយ ប្រទេស ប្រទេស ក្បែ ខាង នៅក្នុង ចំណោម បុរស ដែល សុទ្ធសឹងតែ បញ្ញា វ័ន ហើយ សុទ្ធតែ មាន ឆន្ទៈ ក្នុង ការការពារ បូរណភាព ទឹកដី របស់ ខ្លួន ។ ជា ស្រ្តី ដែល ពោ ពេញ ដោយ ថាមពល មួយ រូប លោកជំទាវ បាន បំពេញ កិច្ចការងារ ព្រំដែន នេះ អស់ រយៈពេល ជាង ពាក់កណ្ដាល ជីវិត របស់ លោកជំទាវ ដើម្បី បំពេញ នូវ ទំនុកចិត្ត ដែល ប្រមុខ រាជ រដ្ឋាភិបាល បាន ផ្ដល់ឲ្យ ។
រាល់ កិច្ចការ ព្រំដែន មិន ថា នៅលើ តុ ចចារ ឬ នៅ តាម បង្គោល ព្រំដែន ប្រទេស ទេ គេ តែងតែ សង្កេតឃើញ វត្តមាន លោកជំទាវ កុយ ពិសី និង ក្រុមការងារ ជានិច្ច ហើយ វត្តមាន របស់ លោកជំទាវ គឺជានិច្ចកាល ស្ថិត ក្នុង ចំណោម បុរស ៗ ដែល ជា មន្ត្រីរាជការ ស៊ីវិល ផង ជា នគរបាល ផង ជា កងទ័ព ផង និង ជា អាជ្ញាធរដែនដី ផងដែរ ។
គួរ បញ្ជាក់ ថា ចំពោះ មុខ ករណី ឆ្លង និង ស្លាប់ ដោយសារ COVID-19 នៅតែ បន្ត ស្ថិត ក្នុង ចំនួន ច្រើន សហរដ្ឋ អាមេរិក ក៏ នៅតែ បន្ត សម្រុក ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ នេះ ជូន ដល់ ប្រជាជន របស់ ខ្លួន ផងដែរ ។ គិត ត្រឹម ចុង សប្តាហ៍ នេះ វ៉ាក់សាំង សរុប ជាង ៨៥លាន ដូស ហើយ ត្រូវបាន ចាក់ ជូន ដល់ ប្រជាជន ខណៈ វ៉ាក់សាំង សរុប ជាង ១១៤លាន ដូស ត្រូវបាន ដាក់ចេញ ។
គម្រោង កញ្ចប់ ថវិកា ខាងលើ បាន ឆ្លង ផុត សភា ក្នុង សំឡេង គាំទ្រ ចំនួន ៥០ និង ជំទាស់ ចំនួន ៤៩ ដោយ សមាជិក ព្រឹទ្ធសភា ទាំងអស់ នៃ បក្ស ប្រជាធិបតេយ្យ សុទ្ធតែ គាំទ្រ ហើយ សមាជិក បក្ស សាធារណរដ្ឋ សុទ្ធតែ ជំទាស់ ។ វា គឺជា កញ្ចប់ ថវិកា សង្រ្គោះ ដែល មាន ទំហំ ធំ បំផុត នៅក្នុង ប្រវត្តិសាស្រ្ត របស់ សហរដ្ឋ អាមេរិក ហើយ វា ជា ជ័យជម្នះ ធំធេង មួយ ជា លើក ដំបូង សម្រាប់ លោក បៃ ដិន ចាប់តាំងពី លោក បាន ឡើង កាន់អំណាច កាលពី ខែមករា មក ។
នៅ ថ្ងៃ នេះ ក្រសួង សុខាភិបាល ក៏ បាន ប្រកាស ពី ការព្យាបាល ជាសះស្បើយ អ្នកជំងឺ ១៩ នាក់ ផងដែរ ។
បើ តាម ក្រសួង សុខាភិបាល អ្នក ឆ្លង កូវីដ១៩ ចំនួន ៣៤ នាក់ នោះ មាន ៣នាក់ ធ្វើដំណើរ មកពី ក្រៅ ប្រទេស ដែល ពួកគាត់ ជា ជនជាតិ ខ្មែរ ដែល ជា កងទ័ព មួក ខៀវ ធ្វើដំណើរ មកពី ប្រទេស អាហ្វ្រិក ។ ចំណែក អ្នក ឆ្លង ក្នុង « សហគមន៍ ២០កុម្ភៈ » ចំនួន ៣១ នាក់ ក្នុង នោះ ជនជាតិ ចិន ២១ នាក់ ជនជាតិ ខ្មែរ ៩នាក់ និង ជនជាតិ វៀតណាម ម្នាក់ ។
ចំណែក អ្នក ជាសះស្បើយ ទាំង ១៩ នាក់ ដែល ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ វិញ គឺ មាន ជនជាតិ ចិន ១៦ នាក់ និង ជនជាតិ ខ្មែរ ២នាក់ និង វៀតណាម ម្នាក់ ។
ខាងក្រោម តារាង ព័ត៌មាន លម្អិត នៃ ការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ របស់ ក្រសួង សុខាភិបាល៖ កុមារ កំព្រា ម្នាក់ ត្រូវ គេ បាញ់ ស្លាប់ នៅ ខណ្ឌ កំបូល សង្ស័យ អ្នក បាញ់ សត្វ
