( ពិភពលោក ) ៖ នៅ ថ្ងៃសៅរ៍ ទី២០ ខែមីនា ឆ្នាំ ២០២១ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ ក្រុម មន្រ្តី ប៉ូលិស អូស្រ្តាលី នៅ ថ្ងៃសៅរ៍ នេះ បាន បញ្ជា ឱ្យ មនុស្ស ជាច្រើន ដែល រស់ នៅ តំបន់ ទំនាប តាម បណ្ដោយ ឆ្នេរសមុទ្រ ភាគ ខាងកើត នៃ ប្រទេស អូស្ត្រាលី ជម្លៀស ខ្លួន ចេញ ដោយសារតែ ភ្លៀង ធ្លាក់ ខ្លាំង បង្កឱ្យ មាន ទឹក ជំនន់ ដែល អាច « គំរាមកំហែង ដល់ អាយុជីវិត » នៅ ទូទាំង តំបន់ ។
២៖ សហរដ្ឋ អាមេរិក និង ចិន បាន ទាស់ សម្ដី គ្នា ជុំវិញ ការប្រយុទ្ធ ប្រឆំាំង ការរើសអើង ពូជសាសន៍ កំឡុង កិច្ចប្រជុំ តាម ប្រព័ន្ធ អនឡាញ នា ឱកាស ទិវា អន្តរជាតិ លុបបំបាត់ ការរើសអើង ពូជសាសន៍ រៀបចំឡើង នៅឯ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ ។
៥៖ ក្រុម កម្មករ រោងចក្រ កាត់ដេរ សម្លៀកបំពាក់ នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា បាន អំពាវនាវ ឱ្យ ក្រុមហ៊ុន ម៉ាក សញ្ញា ល្បី ៗ នៅ ទូទាំង ពិភពលោក រួមគ្នា ថ្កោលទោស រដ្ឋប្រហារ យោធា កាលពី ថ្ងៃទី ០១ ខែកុម្ភៈ កន្លងទៅ ខណៈ មនុស្ស ច្រើន ជាង ១៨០ នាក់ ហើយ បាន ស្លាប់ នៅក្នុង ការបង្រ្កាប ពីសំណាក់ កម្លាំង សន្តិសុខ នៃ រដ្ឋាភិបាល យោធា មីយ៉ាន់ម៉ា ។
គួរ ជម្រាប ថា ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ បាន វាយប្រហារ យ៉ាង ខ្លាំង ទៅ លើ ប្រជាជន កម្ពុជា ក្នុង ចំណោម នោះ គេ ក៏ សង្កេតឃើញ មាន ទារក ទារិកា និង ក្មេង តូច ៗ ជាច្រើន ក៏ រង នូវ ការវាយប្រហារ ដោយសារ ជំងឺ នេះ ផងដែរ ដោយ តម្រូវឲ្យ ក្រុម គ្រូពេទ្យ យក សំណាក ទៅ ពិនិត្យ ជា បន្ដ បន្ទាប់ ក្នុង ករណី មាន ការពាក់ព័ន្ធ ។
តាមរយៈ ករណី ដែល បាន កើតឡើង នេះ ក៏ ជា សារ មួយ ដើម្បី ក្រើន រំលឹក ដល់ ឪពុក ម្ដាយ អាណាព្យាបាល ត្រូវតែ បង្កើន នូវ ការប្រុងប្រយ័ត្ន ជា ចាំបាច់ ដើម្បី កុំ ឲ្យ ធ្លាក់ ក្នុង អន្ទាក់ ជំងឺ កូវីដ ហើយ ចម្លង បន្ដ ទៅ ក្រុមគ្រួសារ ពិសេស កូន តូច ៗ តែម្ដង ៕
ដាច់ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន ក្នុង ខណ្ឌ ជ្រោយ ចង្វារ និង ខណ្ឌ ព្រែក ព្នៅ ដោយសារ មាន រថយន្ត បើក ទាក់ ខ្សែភ្លើង
ក្នុង នោះ បណ្តាលឲ្យ ដាច់ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន ស្ថិត នៅ៖ ( ១) ភូមិ សំរោង ទាវ សង្កាត់ ក្រាំង ធ្នង់ ខណ្ឌ សែនសុខ ( ២) ភូមិ ពាម សង្កាត់ សំបូរ មាស សង្កាត់ បាក់ខែង សង្កាត់ ជ្រោយចង្វារ ខណ្ឌ ជ្រោយ ចង្វារ ( ៣) សង្កាត់ ព្រែក ព្នៅ ខណ្ឌ ព្រែក ព្នៅ រាជធានី ភ្នំពេញ ។
ក្រុមការងារ បច្ចេកទេស បាន ធ្វើ ការដាំ បង្គោល និង ភ្ជាប់ ចរន្ត ជូន អតិថិជន ឲ្យ មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ វេលា ម៉ោង ១៦៖១០នាទី រសៀល លើកលែងតែ បន្ទប់ ភ្លើង លេខ P1315-F1 ដែល មាន ទីតាំង ស្ថិត នៅ ភូមិ ត្រពាំង រាំង សង្កាត់ ឃ្មួញ ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
ក្រុមការងារ បច្ចេកទេស កំពុង ធ្វើ ការជួសជុល ខ្សែ បណ្ដាញ តង់ស្យុង ទាប (LV) ដើម្បី ភ្ជាប់ ចរន្ត ជូន អតិថិជន ឲ្យ មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ មុន វេលា ម៉ោង ២០៖០០ នាទី យប់ ៕
ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី បន្ត ចុះ ផ្សព្វផ្សាយ ពី វិធីសាស្ត្រ ការពារ - ទប់ស្កាត់ ជំងឺ កូវីដ១៩ និង ផ្តល់ អំណោយ មួយចំនួន ជូន ពលរដ្ឋ ក្នុង ស្រុក ឱរ៉ាល់
( កំពង់ស្ពឺ ) ៖ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី បាន បន្ត យុទ្ធនាការ របស់ ខ្លួន ក្នុង ការចុះ ជួយ អប់រំ ពី វិធីសាស្ត្រ ការពារ - ទប់ស្កាត់ ជំងឺ កូវីដ១៩ រួម និង ការចែកជូន អំណោយ មួយចំនួន ដល់ បងប្អូន ប្រជាពលរដ្ឋ រស់ នៅ តាម ខ្នង ផ្ទះ នៅ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ក្នុង គោលបំណង ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
អប់រំ ពី វិធានការ ការពារ ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ និង មាន បង្រៀន ប្រជាពលរដ្ឋ ឲ្យ យល់ដឹង អំពី ការរស់នៅ ស្អាត ប្រកបដោយ អនាម័យ ល្អ ដោយ លាង សម្អាត ដៃ នឹង អាកុល ឬ សាប៊ូ ពាក់ ម៉ាស់ ឲ្យបាន ត្រឹមត្រូវ នៅពេល ចាំបាច់ ហូប ស្អាត គេង ស្អាត ចែក អាកុល ម៉ាស់ ម៉ាស៊ីន វាស់ កម្តៅ សាប៊ូ ក្រដាស់ រូបភាព ផ្សព្វផ្សាយ អំពី ការថែរក្សា អនាម័យ រួមទាំង ស្បៀងអាហារ មាន ជា ត្រីខ មី ជាពិសេស អនុវត្ត ៣ការពារ ៣កុំ ក្នុង វិធានការ ការពារ Covid-19 ៖
លោក វេជ្ជបណ្ឌិត សាយ ឫទ្ធី បាន ឲ្យដឹង ថា ការចុះ ពិនិត្យ និង ព្យាបាល ប្រជាពលរដ្ឋ នេះ គឺជា ស្មារតី មនុស្សធម៌ សុទ្ធសាធ ដែល ស្តែង ចេញពី សេចក្តីស្រឡាញ់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង នាម ជា ឈាម ជ័រ ខ្មែរ ដូចគ្នា ខ្មែរ ស្រឡាញ់ ខ្មែរ ខ្មែរ រួបរួម គ្នា តែ មួយ អនាគត តែ មួយ ពោលគឺ ការព្យាបាល មិន ប្រកាន់ បក្សពួក សាសនា ឬ និន្នាការ នយោបាយ ណាមួយ ឡើយ សំដៅ ចូលរួម កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ មួយ ចំណែក ផងដែរ ។ បញ្ហា សុខភាព គឺជា មូលដ្ឋានគ្រឹះ ដើម្បី ឆ្ពោះ ទៅរក ភាពជោគជ័យ សុភមង្គល ជូន គ្រួសារ និង សង្គមជាតិ ។
អនុប្រធាន ប្រតិបត្តិ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ដែល តំណាង លោក លេង ផាលី រូប នេះ ក៏ បាន ឲ្យដឹង ទៀត ថា ការងារ មនុស្សធម៌ ចុះ ជួយ ប្រជាពលរដ្ឋ រៀង រហូតមក គឺ កើត ចេញ ពី ការឧបត្ថម្ភ គាំទ្រ និង ការចង្អុលបង្ហាញ ពីសំណាក់ លោក ហ៊ុន ម៉ានី ដែល លោក តែង ខ្វល់ខ្វាយ គិតគូរ និង រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក គ្រប់ កាល ទេសៈ ។
នៅ ថ្ងៃសៅរ៍ នេះ បាតុករ ម្នាក់ ទៀត ត្រូវបាន កម្លាំង សន្តិសុខ បាញ់ សម្លាប់ នៅក្នុង ការបង្ក្រាប មួយ ធ្វើឡើង ក្នុង ទីក្រុង រ៉ង់ ហ្គូន ។ សារព័ត៌មាន ក្នុង ស្រុក របស់ មីយ៉ាន់ម៉ា បាន រាយការណ៍ ឲ្យដឹង ថា មនុស្ស សរុប ២៣៨ នាក់ ហើយ បាន ស្លាប់ គិត ចាប់តាំងពី រដ្ឋប្រហារ និង បាតុកម្ម ផ្ទុះឡើង ខណៈ សារព័ត៌មាន បរទេស មួយចំនួន វិញ បាន ចុះផ្សាយ ថា ចំនួន មនុស្ស ស្លាប់ មាន ជិត ២០០ នាក់ ។
យោង តាម សារព័ត៌មាន Reuters បណ្តា ប្រទេស អាស៊ី មួយចំនួន បាន ចាប់ផ្តើម ដើរ តាម លោក ខាងលិច ដើម្បី ប្រឆាំង នឹង ការប្រើប្រាស់ កម្លាំង បាយ ដោយ កងកម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា ទៅ លើ ក្រុម បាតុករ ជាពិសេស នៅក្នុង ទីក្រុង រ៉ង់ ហ្គូន និង ម៉ាន់ ដាឡាយ ដែល សុទ្ធតែ ជា ទីក្រុង មាន ប្រជាជន រស់ នៅ ច្រើន ជាង គេ បំផុត នៅក្នុង ប្រទេស អាស៊ាន មួយ នេះ ។
ដោយឡែក នៅ ថ្ងៃសុក្រ សប្តាហ៍ នេះ ( ពេលវេលា នៅ ញូយ៉ក ) អគ្គ លេខាធិការ នៃ អង្គការ សហ ប្រជាជាតិ (UN) លោក អាន់តូនីញ៉ូ ហ្គូទែ រែស បាន ប្រកាស ថ្កោល ទោស ចំពោះ អ្វី ដែល លោក ផ្ទាល់ បាន មើលឃើញ ថា ជា ការបន្ត ប្រើប្រាស់ អំពើហិង្សា យ៉ាង សាហាវ ព្រៃផ្សៃ ដោយ យោធា មីយ៉ាន់ម៉ា ទៅ លើ ក្រុម បាតុករ ។ លោក អគ្គ លេខ ធិការ បាន អំពាវនាវ ឲ្យ អន្តរជាតិ រួមគ្នា ជា ធ្លុង មួយ យ៉ាង ម៉ឺងម៉ាត់ ដើម្បី ដោះស្រាយ បញ្ហា នេះ ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃសៅរ៍ ទី២០ ខែមីនា ឆ្នាំ ២០២១ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ចាត់ ឱ្យ មន្ត្រី នាំយក សារ លិខិត ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ សព លោក អនុ សេនីយ៍ ត្រី គឹម ឃី ស៊ុន មន្ត្រី នគរបាល ជាតិ បម្រើការ នៅ ក្រសួង មហាផ្ទៃ ដែល បាន ទទួលមរណភាព ដោយ ជំងឺ កូវីដ - ១៩ កាលពី ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ ។
ស្ថិត ក្នុង សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ លោក វេជ្ជបណ្ឌិត អ៊ុយ សំអាត នាយក នាយកដ្ឋាន គ្រប់គ្រង គ្រោះមហន្តរាយ កាកបាទ ក្រហម កម្ពុជា បាន ពាំនាំ នូវ ការរំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សូម បួងសួង ដល់ វិញ្ញាណក្ខន្ធ ស ព បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
នគរបាល ចុះបង្ក្រាប ករណី ចែកចាយ គ្រឿងញៀន ខុស ច្បាប់ ១ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៣នាក់ នៅ ក្រុង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ កម្លាំង ការិយាល័យ នគរបាល ប្រឆាំង គ្រឿងញៀន ខេត្ត ព្រះសីហនុ បាន ចុះបង្ក្រាប ករណី ចែកចាយ គ្រឿងញៀន ខុស ច្បាប់ ចំនួន ១ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៣នាក់ ។ សកម្មភាព ខាងលើ បាន ធ្វើឡើង នៅ យប់ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ ស្ថិត នៅ ក្រុម ៥ ភូមិ ៥ សង្កាត់ ៤ ក្រុង / ព្រះសីហនុ វេលា ម៉ោង ១៩៖ ២០នាទី ។
១៖ ឈ្មោះ គួយ គ្រឿន ភេទ ប្រុស អាយុ ២៧ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ២៖ ឈ្មោះ ហេង ស្រី ណេង ភេទ ស្រី អាយុ ២៨ ឆ្នាំ មុខរបរ ធ្វើការ នៅ ក្លឹប កំសាន្ត ៣៖ ឈ្មោះ សុខ ស្រី ពៅ ភេទ ស្រី អាយុ ២០ ឆ្នាំ មុខរបរ នារី ម៉ាស្សា ។
វត្ថុតាង ដកហូត ពី ជនសង្ស័យ រួម មាន៖ ម្សៅ ក្រាម សរ ថ្លា សង្ស័យ ជាសារ ញៀន ចំនួន ១២កញ្ចប់ និង ទូរស័ព្ទ ដៃ ១គ្រឿង ៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចាត់ មន្ត្រី នាំយក សារ រំលែក ទុក្ខ ព្រមទាំង គ្រឿង បរិភោគ និង បច្ច័យ បុណ្យ មួយចំនួន ជូន គ្រួសារ សព ភរិយា របស់ លោក ហួរ ឡាវី ដែល ទទួលមរណភាព ដោយ ជំងឺ កូវីដ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃសៅរ៍ ទី២០ ខែមីនា ឆ្នាំ ២០២១ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ចាត់ ឱ្យ មន្ត្រី នាំយក សារ លិខិត ចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ សព លោក ស្រី ងួន សុផាន្នី ត្រូវ ជា ភរិយា របស់ លោក ហួរ ឡាវី ដែល បាន ទទួលមរណភាព ដោយ ជំងឺ កូវីដ - ១៩ កាលពី ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ ។
ស្ថិត ក្នុង សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ លោក វេជ្ជបណ្ឌិត អ៊ុយ សំអាត នាយក នាយកដ្ឋាន គ្រប់គ្រង គ្រោះមហន្តរាយ កាកបាទ ក្រហម កម្ពុជា បាន ពាំនាំ នូវ ការរំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សូម បួងសួង ដល់ វិញ្ញាណក្ខន្ធ ស ព បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម បញ្ជាក់ ថា ដើម្បី ជួយ សម្រាល ដល់ ជីវភាព រស់ នៅ កាកបាទ ក្រហម កម្ពុជា បាន ឧបត្ថម្ភ ដល់ គ្រួសារ សព នូវ អង្ករ ១០០ គីឡូក្រាម . មី ៥កេស . ត្រីខ ៥០ កំប៉ុង . ទឹកក្រូច ៥កេស និង ថវិកា មួយ ចំនួន ៕ មន្រ្តី សុខាភិបាល អំពាវនាវ ពលរដ្ឋ ក្នុង ខេត្ត ព្រះវិហារ ដែល ធ្លាប់ ទៅ ព្យាបាល ជំងឺ នៅ គ្លីនិក « ៧៧៧ » ក្នុង ខេត្ត សៀមរាប កាលពី ថ្ងៃទី ១៧ - ១៩ សូម រាយការណ៍ មក មន្ត្រី ជំនាញ ជាបន្ទាន់
( ព្រះវិហារ ) ៖ លោក វេជ្ជបណ្ឌិត គួង ឡូ ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ខេត្ត ព្រះវិហារ ដែល បាន ទៅ សម្រាក ព្យាបាល ជំងឺ មន្ទីរ សម្រាក ព្យាបាល « ៧៧៧ » ស្ថិត នៅ ភូមិ សាលា កន្សែង ក្នុង ខេត្ត សៀមរាប កាលពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ សូម សហការ ជាមួយ មន្ទីរ សុខាភិបាល ឬ ទៅ ពិនិត្យ សុខភាព ដើម្បី ទប់ស្ការ់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ កុំ ឱ្យ ឆ្លង ចូល សហគមន៍ នៅក្នុង ខេត្ត ព្រះវិហារ ។
ការអំពាវនាវ បែប នេះ របស់ លោក វេជ្ជបណ្ឌិត គួង ឡូ បាន ធ្វើឡើង ក្រោយ នៅ គ្លីនិក ៧៧៧ បន្ទាប់ពី អាជ្ញាធរ ខេត្ត សៀមរាប ព្រមទាំង មន្ទីរ ពហុ ព្យាបាល សុខភាព ស្ថិត នៅ ភូមិ តា ភុល សង្កាត់ ស្វាយ ដង្គំ. បន្ទប់ ពិគ្រោះ ព្យាបាល ជំងឺ « ទូច កូ » ស្ថិត នៅ ភូមិ ទក្សិណ ខាងត្បូង និង បន្ទប់ ថែទាំ វេជ្ជសាស្ត្រ « ចាវ ចាន់ » ស្ថិត នៅ ភូមិ គោក តា ចាន់ សង្កាត់ គោក ចក ដែល បាន រកឃើញ មាន ជាប់ពាក់ព័ន្ធ អ្នកជំងឺ កូវីដ១៩ ឈ្មោះ ម៉ាប់ វ៉ុន អាយុ ៣៥ ឆ្នាំ ដែល បាន រកឃើញ នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ ។
លោក វេជ្ជបណ្ឌិត បាន គូសបញ្ជាក់ ថា មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ សង្ឃឹម យ៉ាង មុតមាំ ថា លោក លោកស្រី ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ព្រះវិហារ ដែល ធ្លាប់ បាន ទៅ ពិនិត្យ និង ព្យាបាល ជំងឺ នៅ គ្លីនិក « ៧៧៧ » និង ពេលវេលា ដូច បាន ជម្រាប ខាងលើ នឹង សហការ ជាមួយ មន្ទីរ សុខាភិបាល ខេត្ត ដើម្បី រួមគ្នា ទប់ស្កាត់ ការចំលង ជំងឺ កូវីដ - ១៩ ពី ម្នាក់ ទៅ ម្នាក់ ទៀត នៅក្នុង សហគមន៍ ។ ជាពិសេស ដើម្បី ថែរក្សា សុខភាព ផ្ទាល់ខ្លួន ផង និង សុខភាព របស់ កូន ចៅ បងប្អូន សាច់ញាតិ ផងដែរ ។
បន្ថែម ពី នេះ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម បន្ត អនុវត្តន៍ នូវ វិធានការ ៣កុំ និង ៣ការពារ និង ត្រូវ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន គ្រប់ ៗ គ្នា ៕ យល់ដឹង ពី ជំនួញ៖ អ្នកជំនាញ សេដ្ឋកិច្ច អះអាង ថា ការចាក់ វ៉ាក់សាំង ជូន ប្រជាជន និង ជន បរទេស ជា ការបង្កើត ទំនុកចិត្ដ ក្នុង ការទាក់ទាញ វិនិយោគ (Video inside)
( ភ្នំពេញ ) ៖ ការផ្ដល់ នូវ ការចាក់ វ៉ាក់សាំង ដោយ ឥត គិត ថ្លៃ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ជូន ដល់ ប្រជាជន ត្រូវបាន បណ្ឌិត ឆេង គីម ឡុង នាយក មជ្ឈមណ្ឌល ន វានុវត្តន៍ ផ្នែក អភិបាលកិច្ច និង ប្រជាធិបតេយ្យ របស់ វិទ្យាស្ថាន ចក្ខុវិស័យ អាស៊ី បាន អះអាង ថា ការផ្ដល់ នេះ ពិតជា ត្រឹមត្រូវ និង មាន សារៈសំខាន់ ក្នុង ការបង្កើត ឲ្យ មាន ទំនុកចិត្ដ សម្រាប់ បុគ្គល ម្នាក់ ៗ ក្នុង ការទាក់ទាញ វិនិយោគ ដើម្បី ស្ដារ សេដ្ឋកិច្ច ឡើងវិញ ។
លើស ពី នោះ ទៀត បណ្ឌិត ឆេង គីម ឡុង បាន បញ្ជាក់ ថា ការចាក់ វ៉ាក់សាំង គឺជា ការទប់ស្កាត់ នូវ ការរីករាលដាល ជំងឺ ឆ្លង កូវីដ - ១៩ ដែល មាន សារៈសំខាន់ ក្នុង ការផ្ដល់ នូវ ប្រព័ន្ធ ការពារ រាងកាយ ដល់ ប្រជាជន កម្ពុជា និង ជន បរទេស ដែល រស់ នៅក្នុង ប្រទេស កម្ពុជា ។
បណ្ឌិត ឆេង គីម ឡុង បាន ឲ្យដឹង ថា តាម បទ អន្ដរាគមន៍ របស់ ប្រមុខ ដឹកនាំ ក៏ ដូចជា ក្រសួង ពាក់ព័ន្ធ ជន បរទេស រស់ នៅ កម្ពុជា ក៏ អាច ទទួលបាន នូវ វ៉ាក់សាំង ដែរ ដូច្នេះ បញ្ជាក់ អំពី ការចូលរួម របស់ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ មិន គ្រាន់តែ ប្រជាជន កម្ពុជា ប៉ុណ្ណោះ ទេ ថែមទាំង ជួយ ការពារ ដល់ ជន បរទេស នៅ កម្ពុជា ផងដែរ ។
បណ្ឌិត ឆេង គីម ឡុង បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « វ៉ាក់សាំង គឺជា ការធានា ឲ្យបាន នូវ ការ កាត់បន្ថយ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ទាំង ដល់ សហគមន៍ ទាំង ដល់ បុគ្គល ម្នាក់ ៗ ក្នុង ន័យ ការពារ និង រក្សា នូវ សន្ដិសុខ សុខភាព សាធារណៈ របស់ ប្រជាជន » ។
លោក ថា តាមរយៈ ការផ្ដល់ នូវ វ៉ាក់សាំង ដល់ ប្រជាជន គឺ បង្កើត ឲ្យ មាន ទំនុកចិត្ដ សម្រាប់ បុគ្គល ម្នាក់ ៗ ទំនុកចិត្ដ របស់ ប្រជាជន ទូទៅ ។ ទំនុកចិត្ដ នេះ មាន សារៈសំខាន់ ណាស់ ព្រោះថា នៅ ពេល ដែល ប្រជាជន មាន ទំនុកចិត្ដ គាត់ អាច មាន ទំនុកចិត្ដ ក្នុង ការប្រកប មុខរបរ អាជីវកម្ម ឡើងវិញ ។
បន្ថែម ពី នោះ ទៀត បណ្ឌិត ឆេង គីម ឡុង បាន ឲ្យដឹង ថា ក្នុង ដំណាក់កាល រាជ រដ្ឋាភិបាល អាច គ្រប់គ្រង នៃ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ បាន ប្រទេសជាតិ អាច បើក នូវ សេដ្ឋកិច្ច ជាតិ ឡើងវិញ ដែល ស្ថិត នៅក្នុង កម្រិត គន្លង ថ្មី ។
លោក ថា ពេល នោះ មិន គ្រាន់តែ ទំនុកចិត្ដ របស់ ប្រជាជន នោះ ទេ វា ផ្ដល់ ទំនុកចិត្ដ របស់ វិស័យ ឯកជន ទូទៅ ទំនុកចិត្ដ របស់ ស្ថាប័ន សាធារណៈ ដែល បង្ក នូវ មូលដ្ឋាន គ្រឹះ សំខាន់ ដល់ សកម្មភាព សង្គម សកម្មភាព វប្បធម៌ សកម្មភាព សេដ្ឋកិច្ច - ពាណិជ្ជកម្ម ទូទៅ ឲ្យ ងើប ឡើងវិញ ។
បណ្ឌិត ឆេង គីម ឡុង អះអាង ថា ការងើប ឡើងវិញ ដែល ជំរុញ ដោយ ទំនុកចិត្ដ របស់ ប្រជាជន ទំនុកចិត្ដ របស់ វិស័យ ឯកជន និង ស្ថាប័ន រដ្ឋ គឺជា ការធានា ឲ្យ មាន សកម្មភាព ពាណិជ្ជកម្ម សេដ្ឋកិច្ច ងើប ឡើងវិញ ដែល នេះ ជា ចលករ ក្នុង ការជំរុញ នូវ ការ ងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច ។
លោក ថា នៅ ពេល ដែល រាជ រដ្ឋាភិបាល កម្ពុជា ផ្ដល់ វ៉ាក់សាំង ជូន ដល់ ប្រជាជន បាន ប្រមាណ ៧០ ភាគរយ ក្នុង ចំណោម នៃ ប្រជាជន សរុប នោះ ប្រព័ន្ធ ការពារ ជា សហគមន៍ របស់ កម្ពុជា នឹង សម្រេចបាន ហើយ ការសម្រេចបាន នេះ នឹង កាត់បន្ថយ បាន ច្រើន នូវ លទ្ធភាព ការឆ្លង រីករាលដាល ជំងឺ កូវីដ - ១៩ ។
បណ្ឌិត ឆេង គីម ឡុង រំពឹង ថា កម្ពុជា នឹង សម្រេចបាន នៅ ដំណាច់ ឆ្នាំ ២០២២ ក្នុង ការចាក់ វ៉ាក់សាំង ជូន ប្រជាជន ។ នៅ ពេល ដែល កម្ពុជា ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ បាន ច្រើន ហើយ នោះ លោក គិត ថា ទាំង ទេសចរណ៍ អន្ដរជាតិ ទាំង ទេសចរណ៍ ក្នុង ស្រុក នឹង ឈានដល់ ចំណុច មួយ មាន សន្ទុះ កើនឡើង ទាំង លំហូ ចូល ធុរកិច្ច អ្នកវិនិយោគិន ពី ក្រៅ ស្រុក ក៏ នឹង អាច ធ្វើដំណើរ មកវិញ ផងដែរ ។
បណ្ឌិត ឆេង គីម ឡុង បាន ឲ្យដឹង ទៀត ថា ការផ្ដល់ វ៉ាក់សាំង នៅ ព្រម ពេល គ្នា លើ ប្រទេស ជុំវិញ ពិភពលោក នឹង ជា ចំណុច ល្អ មួយ សម្រាប់ ការស្ដារ សេដ្ឋកិច្ច នៅក្នុង ពិភពលោក ដែល សេដ្ឋកិច្ច ពិភពលោក នៅក្នុង តំបន់ ក៏ នឹង ជួយ សេដ្ឋកិច្ច ក្នុង ស្រុក ដែរ ។
លោក ថា ការផ្ដល់ វ៉ាក់សាំង ក្នុង ស្រុក និង ការផ្ដល់ វ៉ាក់សាំង របស់ រដ្ឋាភិបាល ប្រទេស ផ្សេង ៗ ដល់ ប្រជាជន នៅក្នុង ប្រទេស វៀង ៗ ខ្លួន គឺជា មូលដ្ឋានគ្រឹះ សម្រាប់ ធានា នូវ សន្ដិសុខ ប្រជាជន សន្ដិសុខ សាធារណៈ និង ជំរុញ ការស្ដារ នៃ ការងើប ឡើងវិញ សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម នៅក្នុង ពិភពលោក ៕
ក្រសួង វប្បធម៌ ប្រកាស ផ្អាក ដំណើរការ ជា បណ្តោះអាសន្ន រោង ភាពយន្ត រោង សម្តែង សិល្បៈ និង សារ មន្ទីរ ទូទាំង ប្រទេស
( ភ្នំពេញ ) ៖ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ នៅ ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការផ្អាក ដំណើរការ ជា បណ្តោះអាសន្ន រាង ភាពយន្ត រោង សម្តែង សិល្បៈ និង សារមន្ទីរ ទូទាំង ប្រទេស ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ២១ ខែមីនា នេះ ។
ការសម្រេច ជា បណ្តោះអាសន្ន រាង ភាពយន្ត រោង សម្តែង សិល្បៈ និង សារមន្ទីរ ទូទាំង ប្រទេស កម្ពុជា គឺ ធ្វើឡើង ក្នុង គោលបំណង ចូលរួម ទប់ស្កាត់ ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២០ កុម្ភៈ » ដែល កំពុង បន្ត រីករាល ក្នុង ប្រទេស កម្ពុជា ។
សូម ជម្រាប ថា នៅ ព្រឹក ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២១ នេះ កម្ពុជា បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៤៨ នាក់ ក្នុង នោះ ករណី សហគមន៍ ក្នុង « ព្រឹត្តិការណ៍ ២០កុម្ភៈ » ចំនួន ៥៧ នាក់ និង ១ករណី ទៀត គឺជា ករណី នាំចូល ខណៈ អ្នកជំងឺ ចំនួន ១៥ នាក់ បាន ជាសះស្បើយ និង អនុញ្ញាតឱ្យ ចេញ ពី មន្ទីរពេទ្យ ។
គិត ត្រឹម ម៉ោង ៧៖០០ នាទី ព្រឹក ថ្ងៃទី ២១ ខែមីនា នេះ កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ សរុប ចំនួន ១៦៩០ នាក់ ក្នុង នោះ អ្នក ជាសះស្បើយ ចំនួន ៩៥០ នាក់ . អ្នក កំពុង សម្រាក ព្យាបាល ជំងឺ ចំនួន ៧៣៥ នាក់ . ស្លាប់ ចំនួន ៣នាក់ និង ២នាក់ ទៀត ស្លាប់ ដោយសារ ការរើ ថ្នាំ ញៀន ធ្ងន់ធ្ងរ និង ស្ទះ សរសៃ រ ឈាម បេះដូង ពេល កំពុង ទទួល ការព្យាបាល ជំងឺ កូវីដ១៩ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ៖ មនុស្ស ពេញ វ័យ នៅ ចក្រភព អង់គ្លេស ជាង ពាក់កណ្តាល ហើយ ដែល ទទួលបាន ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ យ៉ាងហោច ក៏ ១ដូស ដែរ
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការបន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៥៨ នាក់ ក្នុង នោះ ករណី សហគមន៍ ក្នុង « ព្រឹត្តិការណ៍ ២០កុម្ភៈ » ចំនួន ៥៧ នាក់ និង ១ករណី ទៀត គឺជា ករណី នាំចូល ខណៈ អ្នកជំងឺ ចំនួន ១៥ នាក់ បាន ជាសះស្បើយ និង អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ។
អ្នក ឆ្លង កូវីដ១៩ ទាំង ៥៨ នាក់ នោះ មាន ម្នាក់ ជា ស្ត្រី ជនជាតិ ចិន ធ្វើដំណើរ មកពី ប្រទេស ចិន មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ និង ៥៧ នាក់ ផ្សេង ទៀត ជា ករណី ឆ្លង ក្នុង « សហគមន៍ ២០កុម្ភៈ » ដែល រួម មាន៖ ជនជាតិ ចិន ចំនួន ១៧នាក់ និង ជនជាតិ ខ្មែរ ៤០ នាក់ រកឃើញ នៅ រាជធានី ភ្នំពេញ ខេត្ត កណ្តាល ខេត្ត ព្រះសីហនុ និង ខេត្ត សៀមរាប ។
សូម កុំ បើកបរ ក្នុង ស្ថានភាពងងុយដេក ! ស្លាប់ ៥នាក់ និង របួស ៨នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៨លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ៨នាក់ ។
ខាងក្រោម តារាង ព័ត៌មាន លម្អិត នៃ ការចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ របស់ ក្រសួង សុខាភិបាល៖ ឥណ្ឌូណេស៊ី រកឃើញ អ្នក ឆ្លង កូវីដ - ១៩ ចំនួន ៥. ៦៥៦ នាក់ . ស្លាប់ ១០៨ នាក់ ក្នុង ពេល មួយ ថ្ងៃ
គួរ បញ្ជាក់ ថា COVID-19 បាន និង កំពុង ឆ្លង រាតត្បាត ទូទាំង ខេត្ត ចំនួន ៣៤ នៃ ប្រទេស ឥណ្ឌូណេស៊ី ខណៈ រដ្ឋាភិបាល កំពុង ប្រឹងប្រែង បង្កើន ល្បឿន យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជូន ប្រជាជន នៅ ទូទាំង ប្រទេស ដោយ សង្ឃឹម ថា អាចនឹង គ្រប់គ្រង ជំងឺ ដ៏ កាច សាហាវ មួយ នេះ ក្នុង ពេល ឆាប់ ៗ ៕
គួរ បញ្ជាក់ ថា រមណីយដ្ឋាន នេះ បាន បម្រើ ជា ទីស្នាក់ នៅ ផ្លូវការ របស់ អតីត ប្រធានាធិបតី ចាប់តាំងពី លោក បាន ចាកចេញ ពី សេតវិមាន កាលពី ថ្ងៃទី ២០ ខែមករា មក ម្ល៉េះ ប៉ុន្តែ ពិធី ជប់លៀង និង សេវាកម្ម ព្រឹត្តិការណ៍ ផ្សេង ៗ នឹង នៅតែ បើក ដំណើរការដដែល ដែល វា បាន គោរព អនុវត្ត នូវ វិធានការណ៍ ឆ្លើយតប សមស្រប ទាំងអស់ ទៅ តាម ការណែនាំ របស់ មជ្ឈមណ្ឌល គ្រប់គ្រង និង បង្ការ ជំងឺ ឆ្លង អាមេរិក (CDC) ដើម្បី ការពារ ការឆ្លង រីករាលដាល នៃ ជំងឺ COVID-19 ៕
ក្រសួង ផ្អាក គ្រឹះស្ថាន សិក្សា រដ្ឋ និង ឯកជន ក្នុង ក្រុង សៀមរាប ពីរ សប្តាហ៍ ក្រោយ រកឃើញ អ្នក កើត កូវីដ១៩
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា បាន សម្រេច ផ្អាក ការសិក្សា នៅ តាម គ្រឹះស្ថាន សិក្សា ទាំង រដ្ឋ និង ឯកជន ក្នុង ក្រុង សៀមរាប រយៈពេល ពីរ សប្តាហ៍ ។ ការផ្អាក នេះ បាន ធ្វើឡើង ក្រោយពេល រដ្ឋបាល ខេត្ត សៀមរាប បាន រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ ម្នាក់ ទៀត ។
សូម បញ្ជាក់ ថា រដ្ឋបាល ខេត្ត សៀមរាប នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ បាន រកឃើញ បុរស អាយុ ៣៥ ឆ្នាំ ម្នាក់ កើត ជំងឺ កូវីដ១៩ ។ បុរស ម្នាក់ នេះ មាន ឈ្មោះ ម៉ាប់ វ៉ុន រស់ នៅ ភូមិ គោក ត្នោត សង្កាត់ គោក ចក ក្រុង សៀមរាប ប្រកប មុខរបរ ជា កម្មករ បើក រថយន្ត ដឹក ដី នៅ ភូមិ ដី ឥដ្ឋ ឃុំ ដី ឥដ្ឋ ស្រុក កៀនស្វាយ ខេត្ត កណ្តាល ។
បុរស រូប នេះ បាន ចូលទៅ ខេត្ត សៀមរាប កាលពី ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០២១ កន្លងទៅ នេះ ។ បុរស រូប នេះ ត្រូវបាន បញ្ជាក់ ថា ទៅកាន់ ទីតាំង ជាច្រើន នៅក្នុង ក្រុង សៀមរាប ដូច ជា៖ ពេទ្យ ចាវ ចាន់ នៅ ផ្សារ ភូមិភាគ ៤. ពេទ្យ ទូច កូ នៅ ខាងលិច ផ្សារ ដើម ក្រឡាញ់ . ពេទ្យ ៧៧៧ នៅ ផ្លូវ ជាតិ លេខ ៦ ខាងលិច ស្តុប ទន្លេ សាប និង គ្លីនិក សុខភាព ជាដើម ។
នៅ ថ្ងៃ នេះ ដែរ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ រដ្ឋបាល ខេត្ត សៀមរាប បាន សម្រេច បិទ ចរាចរ ចេញ - ចូល សង្កាត់ គោក ចក ក្រុង សៀមរាប . បិទ មន្ទីរ សម្រាក ព្យាបាល ៧៧៧ និង ទីតាំង ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ៕ ខេត្ត សៀមរាប រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ ម្នាក់ ទៀត . អាជ្ញាធរ បិទ សង្កាត់ គោក ចក
អាជ្ញាធរ បាន បញ្ជាក់ ថា បុរស រូប នេះ បាន ចូលទៅ ខេត្ត សៀមរាប កាលពី ថ្ងៃទី ០៧ ខែមីនា ឆ្នាំ ២០២១ កន្លងទៅ នេះ ។
ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត សៀមរាប បាន សម្រេច បិទ ចរាចរ ចេញ - ចូល សង្កាត់ គោក ចក ក្រុង សៀមរាប ចាប់ពី វេលា ម៉ោង ១៩៖០០ នាទី ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ តទៅ ។
រីឯ អ្នក រស់ នៅក្បែរ មន្ទីរពេទ្យ ៧៧៧ សូម យក សំណាក នៅ មន្ទីរពេទ្យ ៧៧៧ ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ តទៅ ៕
រដ្ឋបាល ខេត្ត សៀមរាប សង្ឃឹម យ៉ាង មុតមាំ ថា ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ពិសេស ពលរដ្ឋ ដែល រស់ នៅក្នុង សង្កាត់ គោក ចក ក្រុង សៀមរាប ចូលរួម អនុវត្ត ឱ្យ បាន ម៉ឺងមាត់ និង អនុវត្ត នូវ វិធានការ ការពារ របស់ រាជ រដ្ឋាភិបាល និង តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕
អាជ្ញាធរ ចុះ បិទ មន្ទីរ សម្រាក ព្យាបាល « ៧៧៧ » ក្នុង ក្រុង សៀមរាប ក្រោយ សង្ស័យ ពាក់ព័ន្ធ អ្នកជំងឺ កូវីដ១៩
( សៀមរាប ) ៖ អាជ្ញាធរ ខេត្ត សៀមរាប នៅ ល្ងាច ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន ចុះ ទៅ បិទ មន្ទីរ សម្រាក ព្យាបាល « ៧៧៧ » ក្នុង ក្រុង សៀមរាប ក្រោយពី សង្ស័យ ជាប់ពាក់ព័ន្ធ អ្នកជំងឺ កូវីដ១៩ ។
យោង តាម សេចក្តីរាយការណ៍ បាន បញ្ជាក់ ថា អាជ្ញាធរ បាន រកឃើញ បុរស ម្នាក់ ដែល សង្ស័យ កើត ជំងឺ កូវីដ១៩ នោះ បាន ចូល ទៅក្នុង មន្ទីរ សម្រាក ព្យាបាល ។ បច្ចុប្បន្ន អាជ្ញាធរ បាន យក បុរស រូប នោះ ទៅកាន់ មន្ទីរពេទ្យ បង្អែក ខេត្ត ដើម្បី ពិនិត្យ សុខភាព ។
ដោយឡែក មន្ទីរ សម្រាក ព្យាបាល ត្រូវ បិទ ទ្វារ បណ្តោះអាសន្ន សិន ។ អ្នកជំងឺ គ្រូពេទ្យ និង បុគ្គលិក បម្រើ ការងារ នៅក្នុង មន្ទីរ សម្រាក ព្យាបាល ត្រូវ ហាមឃាត់ មិន ឱ្យ ចេញ ពី មន្ទីរ សម្រាក ព្យាបាល នេះ ផងដែរ ។
ជាមួយគ្នា នេះ ក្រុម គ្រូពេទ្យ បាន ចុះ យក សំណាក ពី អ្នក ពាក់ព័ន្ធ នៅក្នុង មន្ទីរ សម្រាក ព្យាបាល នេះ ផងដែរ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៦៧៦ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ កម្លាំង នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ច្បារអំពៅ បាន បើក ប្រតិបត្តិ បង្ក្រាប មុខ សញ្ញា ឆក់ ទ្រព្យសម្បត្តិ របស់ ប្រជាពលរដ្ឋ បាន ដង ផ្លូវ ចំនួន ៦នាក់ ក្រោយ ធ្វើ សកម្មភាព បាន មួយ ដង្ហើម ចង្រិត ។
ការចាប់ខ្លួន ជនសង្ស័យ ទាំង៦នាក់ នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ នៅ ចំណុច ដីឡូតិ៍ គ្មាន លេខ ផ្លូវ បេតុង ភូមិ កោះ ក្របី សង្កាត់ ព្រែក ថ្មី ខណ្ឌ ច្បារអំពៅ ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា ជនរងគ្រោះ ឈ្មោះ អាត ស្រី កា អាយុ ១៧ ឆ្នាំ មុខរបរ ជាង អ៊ុត សក់ ស្នាក់ នៅ ភូមិ ព្រែក ថ្មី ១ សង្កាត់ ព្រែក ថ្មី ខណ្ឌ ច្បារអំពៅ សម្ភារ បាត់ រួម មាន ខ្សែក ផ្លាទីន ចំនួន ១ ខ្សែ ទម្ងន់ ៧ជី បន្ដោង មាន ត្បូង ពេជ្រ តំលៃ ជិត២.០០០ ដុល្លារ ។
លោក គាន់ ឌីណា អធិការ រង ទទួល ផែន ព្រហ្មទណ្ឌ ខណ្ឌ បាន ឲ្យដឹង ថា មុនពេល កើត ហេតុ ជនរងគ្រោះ និង មិត្តភ័ក្រ ជិះ ម៉ូតូ ឌុប គ្នា ទៅ ផឹក កាហ្វេ ពេល មកដល់ ចំណុច កើត ហេតុ ស្រាប់តែ មាន ជនសង្ស័យ ០៦ នាក់ ខាងលើ ជិះ ម៉ូតូ ០៣ គ្រឿង ធ្វើ សកម្មភាព ឆក់ ខ្សែក ជនរងគ្រោះ បាន សម្រេច រួច គេច ខ្លួន ។
ពេល នោះ ជនរងគ្រោះ ដេញ តាម ពីក្រោយ ស្រែក ចោរ ៗ ក៏ មាន សមត្ថកិច្ច ប៉ុស្តិ៍ រដ្ឋបាល ព្រែក ថ្មី ល្បាត ក្បែរ នោះ ដេញ តាម ដល់ ក្នុង ដីឡូត៍ ក្បែរ នោះ ក៏ ជនសង្ស័យ ដួល ម៉ូតូ ជ្រុះ បាត់ ខ្សែក ជនរងគ្រោះ មិន ដឹង នៅ កន្លែងណា រួច ជនសង្ស័យ បាន លោត ចូលក្នុង ទឹក បឹង ក្រោយមក ក៏ បាន សុំ កម្លាំង អន្តរាគមន៍ ព្រហ្មទណ្ឌ ខណ្ឌ ចុះ សហការ រយៈពេល ១ ម៉ោង ទើប ឃាត់ខ្លួន បាន ។ បច្ចុប្បន្ន ជនសង្ស័យ បាន បញ្ជូល ទៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដើម្បី កសាង សំណុំរឿង ទៅ តុលាការ ចាត់ការ តាម នីតិវិធី ៕
គណៈ មេធាវី កម្ពុជា ទទួលបាន មេធាវី ស្ម័គ្រចិត្ត ចូលរួម ៤៣៨ រូប សម្រាប់ ផ្តល់ ការពិគ្រោះយោបល់ ផ្នែក ច្បាប់ និង ការការពារ ក្ដីជូន ជន ក្រីក្រ ដោយ ឥត គិត កម្រៃ
( ភ្នំពេញ ) ៖ គិត ត្រឹម ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២១ គណៈ មេធាវី កម្ពុជា ទទួលបាន មេធាវី ស្ម័គ្រចិត្ត ចូលរួម ចំនួន ៤៣៨ រូប ហើយ ដើម្បី ផ្តល់ ការពិគ្រោះយោបល់ ផ្នែក ច្បាប់ និង ការការពារ ក្ដីជូន ជន ក្រីក្រ ដោយ ឥត គិត កម្រៃ ដែល ក្នុង នោះ មាន មេធាវី ចំនួន ១៨៣ រូប ស្ម័ត្រ ចិត្ត ផ្តល់ ការពិគ្រោះយោបល់ ដោយ ឥត គិត កម្រៃ និង មាន មេធាវី ចំនួន ១៤៦ រូប ស្ម័គ្រចិត្ត ការពារ ក្ដី ដោយ ឥត គិត កម្រៃ ។
តាម សេចក្ដីជូនដំណឹង របស់ គណៈ មេធាវី កម្ពុជា ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា បន្ទាប់ពី គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ធ្វើ ការអំពាវនាវ តាមរយៈ លិខិត លេខ ១៨៦ / គម / ២១ ចុះ ថ្ងៃទី៥ ខែកុម្ភៈ ឆ្នាំ ២០២១ គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទទួលបាន មេធាវី ស្ម័គ្រចិត្ត ចូលរួម ផ្តល់ ការពិគ្រោះយោបល់ ផ្នែក ច្បាប់ និង ការពារ ក្ដីជូន ជន ក្រីក្រ ដោយ ឥត គិត កម្រៃ យ៉ាង ផុសផុល ។
គណៈ មេធាវី ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ សមាជិក - សមាជិកា ដែល ជា មេធាវី ស្ម័គ្រចិត្ត ចូលរួម ចំនួន ៤៣៨ រូប ។ ជាមួយគ្នា នេះ គណៈ មេធាវី ក៏ បាន បញ្ជាក់ ដែរ ថា សម្រាប់ សាធារណជន ដែល មាន បំណង ពិគ្រោះយោបល់ ផ្នែក ច្បាប់ សូមអញ្ជើញ ទៅ ទទួល សេវា នេះ៖ ដោយ ឥត គិត កម្រៃ តាម តារាង ពេលវេលា និង អាសយដ្ឋាន ដែល ភ្ជាប់ ជួន ជាមួយ នេះ ។
គណៈ មេធាវី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន បន្ត អំពាវនាវ ដល់ សមាជិក - សមាជិកា ទាំងអស់ មេត្តា បន្ត ចូលរួម ធ្វើជា មេធាវី ស្ម័ត្រ ចិត្ត ក្នុង ការផ្តល់ ការពិគ្រោះយោបល់ ផ្នែក ច្បាប់ និង ការពារ ក្ដីជូន ជន ក្រីក្រ ដោយ ឥត គិត កម្រៃ ឱ្យ បាន កាន់តែ ច្រើន បន្ថែម ទៀត ដើម្បី ចូលរួម បម្រើ វិស័យ យុត្តិធម៌ សង្គម ឱ្យ កាន់តែ ប្រសើរឡើង ក៏ ដូចជា ដើម្បី លើកស្ទួយ ឧត្តមភាព និង កិត្យានុភាព នៃ វិជ្ជាជីវៈ មេធាវី ៕
អំណោយ សប្បុរសធម៌ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ត្រូវ លោក សេង ទៀង នាំយក ទៅ ប្រគល់ ជូន កូន ភ្លោះ បី គ្រួសារ ទី៣៧៤ នៅ ស្រុក តំបែរ ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ លោក សេង ទៀង ជំនួយការ ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកស្រី បាន នាំយក អំណោយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចែកជូន ប្រជាពលរដ្ឋ សម្រាល ទារិកា ភ្លោះ បី នាក់ ត្រូវ ជា ចៅ ៗ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដល់ ទី លំនៅដ្ឋាន របស់ គ្រួសារ នេះ ផ្ទាល់ នៅក្នុង ភូមិ ស្រម៉ ឃុំ ទឹក ជ្រៅ ស្រុក តំបែរ ខេត្ត ត្បូងឃ្មុំ ។ ការប្រគល់ អំណោយ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ ។
អំណោយ ដ៏ សប្បុរស ទាំងនោះ រួម មាន ថវិកា ៥លាន រៀល អង្ករ ៥០ គីឡូក្រាម ទឹកដោះគោ ២កេស ធំ ស្កសរ៥ គីឡូក្រាម សារុង២ និង ក្រម៉ា២ ។ ទារិកា ភ្លោះ ទាំង បី នាក់ នេះ ប្រសូត្រ នៅ ថ្ងៃទី ២៦ ខែកុម្ភៈ ឆ្នាំ ២០២១ នៅ មន្ទីរពេទ្យ សម្រាក ព្យាបាល និង សម្ភព អ៊ុក វ៉ារ៉ង់ ទី រួម ខេត្ត កំពង់ចាម ជា កូន លើក ទី៣ របស់ ឪពុក ឈ្មោះ ឈីន ភា អាយុ ៣៨ ឆ្នាំ ម្តាយ ឈ្មោះ ឃឹម ម៉ី អាយុ ៣៤ ឆ្នាំ អ្នក ទាំង ពីរ មាន មុខរបរ ជា កសិករ ។
ឆ្លៀត ឱកាស នេះ លោក ជំនួយការ ផ្ទាល់ បាន ធ្វើ ការក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម ថែរក្សា អនាម័យ រស់ នៅ ស្អាត លាង ដៃ ជាមួយ សាប៊ូ អាល់កុង ឬ ទឹក លាង ដៃ ដើម្បី ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ ដ៏ កាច សាហាវ ដែល បាន និង កំពុង រីករាលដាល នៅ ជុំវិញ ពិភពលោក ។
តំណាង គ្រួសារ កូន ភ្លោះ បាន ថ្លែង នូវ អំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដែល ជានិច្ចកាល តែងតែ ជួយ ដល់ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ទាំងអស់ ពិសេស ចំពោះ ប្រជាពលរដ្ឋ មាន ទុក្ខលំបាក គឺ តែងតែ មាន វត្តមាន សម្តេច ទាំង ទ្វេ ចុះ អន្តរាគមន៍ ទាល់ ពេលវេលា ៕
គ្រឿងញៀន បំផ្លាញ អនាគត ដ៏ ស្រស់ថ្លា របស់ អ្នក ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែមីនា៖ បង្ក្រាប ១២ករណី ឃាត់ខ្លួន ៦៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ២ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៦៥ នាក់ ។
សេចក្តីជូនដំណឹង របស់ លោក អភិបាល បាន បញ្ជាក់ ថា « ដើម្បី ចៀសវាង ការឆ្លង ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ទ្រង់ទ្រាយ កាន់តែ ធំ ទៅ ៗ រដ្ឋបាល រាជធានី ភ្នំពេញ សម្រេច ផ្អាក ដំណើរការ អាជីវកម្ម សេវា អ៉ីនធើណេត វិស័យ ព័ត៌មាន នៅ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ជា បណ្តោះអាសន្ន ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ តទៅ រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី » ។
ជាមួយគ្នា នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ណែនាំឲ្យ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខណ្ឌ ទាំង ១៤ ម្ចាស់ អាជីវកម្ម ហាង អ៉ីនធើណេត ទាំងអស់ ក្នុង រាជធានី ភ្នំពេញ ត្រូវ អនុវត្តន៍ ការសម្រេច ផ្អាក នេះ ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
សូម បញ្ជាក់ ថា ការសម្រេច ផ្អាក ដំណើរការ អាជីវកម្ម ហាង អ៉ីនធើណេត នេះ មិន មែន ជា ការផ្អាក ដំណើរការ ក្រុមហ៊ុន ផ្គត់ផ្គង់ សេវា អ៉ីនធើណេត (ISP) នោះ ទេ ៕ អភិបាល រាជធានី ភ្នំពេញ ផ្តល់ អាកុល ជាច្រើន ប៊ី ដុង ដល់ ផ្សារ រដ្ឋ ទាំង ២៥ ក្នុង រាជធានី ដើម្បី ចូលរួមចំណែក បង្ការ និង ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ទឹក អាកុល ជាច្រើន ប៊ី ដុង ត្រូវបាន លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ប្រគល់ជូន ផ្សារ ទាំង ២៥ នៅក្នុង រាជធានី ភ្នំពេញ ដើម្បីឲ្យ ប្រធាន ផ្សារ ទាំងអស់ យក ទៅ ប្រើប្រាស់ ក្នុង ការចូលរួមចំណែក បង្ការ និង ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ ខណៈ ដែល ជំងឺ នេះ បាន និង កំពុង រីករាលដាល ចូលក្នុង សហគមន៍ ជាថ្មី ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ។
ពិធី ប្រគល់ និង ទទួល ខាងលើ នេះ បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោក ឃួង ស្រេង ដោយ ក្នុង មួយ ផ្សារ ៗ ទទួលបាន អាកុល ចំនួន ៦ប៊ី ដុង ។
ជុំវិញ ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ នៃ ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ នេះ បើ តាម ប្រធាន ផ្សារ នីមួយ ៗ បាន រាយការណ៍ ជូន អភិបាល រាជធានី ភ្នំពេញ ថា មាន ផ្សារ មួយចំនួន បាន ថយចុះ ទាំង អាជីវករ និង អ្នកចូល ទិញ ទំនិញ ប្រមាណ ៥០ ភាគរយ ផ្សារ ខ្លះ ទៀត ថយចុះ ប្រមាណ ៤០ ភាគរយ ដោយសារតែ ពួកគេ ខ្លាច ឆ្លង កូវីដ - ១៩ ។
ចំណែក អាជីវករ វិញ ដោយ មិន សូវ មាន អ្នកចូល ទិញ ក៏ បាន បង្ខំ ចិត្ត បិទ តូប តែម្តង ។ ប៉ុន្តែ ទោះបីជា យ៉ាងណា ក្តី ក្រោម ការណែនាំ របស់ លោក ឃួង ស្រេង ប្រធាន ផ្សារ ទាំងអស់ បាន ប្រកាន់ភ្ជាប់ នូវ វិធាន របស់ ក្រសួង សុខាភិបាល គឺ ការតម្រូវឲ្យ ពាក់ ម៉ាស បាញ់ អាកុល វាស់ កំដៅ ការដាក់ ឱ្យ ប្រើប្រាស់ ប្រព័ន្ធ QR Code ទប់ស្កាត់ កូវីដ នៅ តាម ច្រក ចេញ ចូល ផ្សារ ពិសេស គឺ ការអនុវត្ត ៣កុំ និង ៣ការពារ ។
ក្នុង ពិធី ប្រគល់ និង ទទួល នោះ លោក ឃួង ស្រេង បាន ណែនាំ ដល់ ប្រធាន គណៈកម្មការ ផ្សារ រដ្ឋ ទាំង ២៥ ពេល វិលត្រឡប់ ផ្សារ វិញ យក អាល់ ទាំងនេះ ទៅ បាញ់ ជូន ប្រជាពលរដ្ឋ ចូល ផ្សារ និង អាជីវករ ទាំងឡាយ នៅក្នុង ផ្សារ ហើយ បន្ត អប់រំ ណែនាំ គាត់ ឱ្យ អនុវត្ត វិធានការ សុខាភិបាល មាន លាង ដៃ និង សាប៊ូ អាល់កុល ជែល ពិសេស អនុវត្ត វិធានការ៣កុំ និង ៣ការពារ របស់ សម្ដេច តេជោ ហ៊ុន សែន ឱ្យ បាន ខ្ជាប់ខ្ជួន ៕
ក្រុមការងារ ខេត្ត ក្រចេះ ចុះ ជួយ មន្ត្រី មូលដ្ឋាន ដើម្បី រៀបចំ បង្កើត ភូមិ ថ្មី នៅ ឃុំ បុស លាវ ស្រុក ចិត្រ បុរី
ការចុះ មូលដ្ឋាន ដើម្បី រៀបចំ បង្កើត ភូមិ ថ្មី មួយ នេះ ដែល ជា ដំណើរការ សាកល្បង ជា គំរូ សម្រាប់ កន្លែង ដទៃ ទៀត ត្រូវបាន ប្រព្រឹត្តទៅ នៅ ព្រឹក ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ ក្នុង បរិវេណ វត្ត ពោធិ រង្សី ស្ថិត ក្នុង ភូមិ ពោធិ ឃុំ បុស លាវ ដោយ មាន ការចូលរួម ពីសំណាក់ លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ រួម ជាមួយ អស់ លោក លោកស្រី ជា អភិបាល រង ខេត្ត អភិបាល ស្រុក ចិត្រ បុរី មន្ត្រីរាជការ ខេត្ត ព្រមទាំង មន្ត្រី មូលដ្ឋាន ជាច្រើន រូប ទៀត ។
លោក ថោង ខុន សម្រេចបាន ផ្លូវ លំ មួយ ខ្សែ ប្រវែង ១២គីឡូម៉ែត្រ តាម ការសន្យា ជាមួយ ពលរដ្ឋ នៅ ភូមិ គោក ត្របែក ស្រុក តាំង គោក
( កំពង់ធំ )៖ បន្ទាប់ពី សន្យា ជាមួយ ប្រជាពលរដ្ឋ នៅ ភូមិ គោក ត្របែក ឃុំ ស្រឡៅ ស្រុក តាំង គោក រួច មក លោក ថោង ខុន ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក ខេត្ត កំពង់ធំ ក៏ បាន កសាង ផ្លូវ លំ មួយ ខ្សែ ប្រវែង ១២ គីឡូម៉ែត្រ ជូន ប្រជាពលរដ្ឋ ខាងលើ តាម ការសន្យា ខណៈ ការកសាង ផ្លូវ លំ ដ៏ សំខាន់ មួយ នេះ ជិត សម្រច បាន ទាំងស្រុង ហើយ ។
ជាក់ស្ដែង នា ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ លោក ថោង ខុន បាន ដឹកនាំ ក្រុមការងារ ត្រួតពិនិត្យ ការងារ នៅ តាម ការដ្ឋាន កសាង ផ្លូវ ខាងលើ និង បាន ពិគ្រោះ ជាមួយ អាជ្ញាធរ ក្នុង ការរៀបចំ យន្តការថែទាំ ផ្លូវ បន្ត ទៅ ទៀត ផងដែរ ។
ក្រោយ មាន ការសន្យា ជាមួយ ប្រជាពលរដ្ឋ ខាងលើ រួចហើយ លោក ថោង ខុន បាន ចាត់ ក្រុមការងារ គ្រឿងចក្រ សម្ដេច តេជោ ដែល ប្រចាំ ការ នៅ « មណ្ឌល អភិវឌ្ឍន៍ ហ៊ុន សែន ទី៥ » ចុះ កសាង ភ្លាម ។ គិត មកដល់ ពេលនេះ ការកសាង ផ្លូវ លំ ខាងលើ បាន ចំណាយ រយៈពេល ២ ឆ្នាំ មកហើយ ខណៈ ការងារ ក៏ ជិត សម្រេចបាន ១០០ % ហើយ ។ ផ្លូវ លំ មួយ ខ្សែ នេះ ទៀតសោត គឺ មាន ប្រវែង ប្រមាណ ១១ គីឡូម៉ែត្រ និង មាន ទទឹង ៩ ម៉ែត្រ ក្នុង នោះ ក៏ មាន លូ ទទឹង ផ្លូវ និង ប្រឡាយ ទឹក នៅ ទន្ទឹម ជាមួយគ្នា ផងដែរ ។
បើ តាម លោក ថោង ខុន នៅពេល ផ្លូវ នេះ សម្រេច ការសាងសង់ ផ្លូវ លំ នេះ ហើយ វា នឹង ផ្ដល់ ផលប្រយោជន៍ ជាច្រើន ដល់ ប្រជាពលរដ្ឋ និង អ្នកដំណើរ ទាំង អ្នកធ្វើដំណើរ ទៅ ពី ឃុំ ស្រឡៅ ក៏ ដូចជា ប្រជាពលរដ្ឋ ដែល មកពី ភូមិ គោក ត្របែក ជាដើម ពិសេស គឺ នឹង ជួយ សម្រួល ដល់ ការដឹកជញ្ជូន កសិផល ស្រូវ ផល ដំណាំ ត្រី - សាច់ របស់របរ អីវ៉ាន់ ប្រើប្រាស់ និង គ្រឿង ឧបភោគ បរិភោគ ។
ក្នុង ពេល ជួប ដោយ ចៃដន្យ ជាមួយ លោក ថោង ខុន ក្នុង ពេល ចុះ ត្រួតពិនិត្យ ការងារ នោះ ប្រជាពលរដ្ឋ អ្នកធ្វើដំណើរ ប្រជាកសិករ ក៏ ដូចជា អាជ្ញាធរ មូលដ្ឋាន បាន បង្ហាញ នូវ ការសប្បាយរីករាយ យ៉ាង ខ្លាំង ចំពោះ សមិទ្ធផល ផ្លូវលំ នេះ ដោយ ពួកគាត់ រំពឹងទុក ថា ផ្លូវ ដ៏ មាន សារសំខាន់ នេះ នឹង ជួយ សម្រួល ដល់ ការរស់នៅ ការប្រកប មុខរបរ ពិសេស នឹង ជួយ ជំរុញ ជីវភាព បាន មួយ កម្រិត ទៀត ផងដែរ ៕
អភិបាល ខេត្ត ត្បូងឃ្មុំ នាំយក ស្បៀងអាហារ ម៉ាស និង ថវិកា ផ្តល់ ជូន ដល់ ស្នងការ នគរបាល ខេត្ត និង ណែនាំ កងកម្លាំង ទាំងអស់ បន្ត អនុវត្ត « ៣កុំ ៣ការពារ »
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង លោកស្រី ម៉េង វ៉ាន់ ដានីន ជា ម ច័ន្ទ សោភ័ណ រួមទាំង អភិបាល រង ខេត្ត ថ្នាក់ដឹកនាំ សាលា ខេត្ត មន្ទីរ ពាក់ព័ន្ធ ជុំវិញ ខេត្ត នៅ ព្រឹក ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ បាន ចុះ ជួប សំណេះសំណាល ជាមួយ កងកម្លាំង នគរបាល ជាតិ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ត្បូងឃ្មុំ ព្រមទាំង ឧបត្ថម្ភ អង្ករ ៤០ បេ មី ២០ កេស ធំ ម៉ាស ១កេស ធំ ទឹក សុទ្ធ ១០០ កេស និង ថវិកា ចំនួន ៥.០០០.០០០ រៀល ។
ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ត្រី ម៉ុន មាគ៌ា ស្នងការ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ត្បូងឃ្មុំ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការយកចិត្តទុកដាក់ ពីសំណាក់ លោក បណ្ឌិត អភិបាល ខេត្ត និង ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ ដែល តែងតែ បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ទាំង គ្រឿង ឧបភោគ បរិភោគ និង ថវិកា ដល់ កងកម្លាំង នគរបាល ដែល ជា សេនាធិការ ផ្ទាល់ ជូន គណ: បញ្ជាការ ឯកភាព ខេត្ត រដ្ឋបាល ខេត្ត ។
លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លោក ឧត្តមសេនីយ៍ ត្រី ស្នងការ នគរបាល ខេត្ត ថ្នាក់ដឹកនាំ និង កងកម្លាំង នគរបាល ទូទាំង ខេត្ត ក្នុង ការខិតខំ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ រក្សា បាន នូវ គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ទាំង ០៨ ចំណុច ពិសេស ជា កម្លាំង យ៉ាង សំខាន់ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការបង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ - ១៩ នៅក្នុង ខេត្ត ត្បូងឃ្មុំ ។
លោក បណ្ឌិត អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ចំពោះ អំណោយ ដែល ផ្តល់ ជូន នា ថ្ងៃ នេះ សម្រាប់ ប្រើប្រាស់ ទ្រទ្រង់ ជីវភាព កងកម្លាំង បម្រើ កិច្ចការ ការពារ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សាធារណៈ និង ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការបង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ - ១៩ ដែល កំពុង បង្ក ហានិភ័យ ដោយ គំរាមកំហែង មក លើ សុខភាព និង អាយុជីវិត ប្រជាជន កម្ពុជា នា ពេល បច្ចុប្បន្ន ។
ជាមួយគ្នា នោះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ បាន ណែនាំ ក្រើន រំលឹក ដល់ ថ្នាក់ដឹកនាំ និង កងកម្លាំង នគរបាល ទូទាំង ខេត្ត ត្បូងឃ្មុំ នូវ ចំណុច មួយចំនួន រួម មាន៖
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គណៈកម្មការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នា ព្រលប់ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ បាន លើកឡើង ថា បច្ចុប្បន្ន ដោយ ស្ថានភាព កូវីដ កំពុងតែ ផ្ទុះឡើង ក៏ ពិត មែន ក៏ប៉ុន្តែ ទីផ្សារ ពលកម្ម កំពុងតែ ត្រូវការ បងប្អូន យើង ដែល មាន ចំណេះ ជំនាញ ដើម្បី មក ធ្វើការ នៅ តាម បណ្តា ក្រុមហ៊ុន សហគ្រាស និង រោងចក្រ នានា ចៀសវាង បន្ត ការធ្វើ ចំណាកស្រុក ។
លោក បាន លើកឡើង បែប នេះ ក្នុង ឱកាស ចុះ ជួប សំណេះសំណាល និង សួរសុខទុក្ខ បងប្អូន ប្រជាពលរដ្ឋ ដែល ទើបតែ វិលត្រឡប់ មកពី ប្រទេស ថៃ ហើយ ត្រូវបាន នឹង កំពុង ដាក់ ឱ្យ នៅ ដាច់ដោយឡែក ចំនួន ១៤ ថ្ងៃ នៅ មណ្ឌល ចត្តាឡី ស័ក សាលា បឋមសិក្សា ទួល គ្រួស ស្ថិត ក្នុង ភូមិ ទួល គ្រួស សង្កាត់ ចំរើន ផល ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។
អភិបាល ខេត្ត ពោធិ៍សាត់ បាន ជម្រាប ជូន ពី ការរីកចម្រើន លើ គ្រប់ វិស័យ និង សមិទ្ធផល សម្រេចបាន នៅក្នុង ខេត្ត ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត ត ស៊ូ រហូត ទទួលបាន សុខ សន្តិភាព មក ទល់ បច្ចុប្បន្ន ។
លោក បាន សន្យា ថា នឹង រួម សុខ រួម ទុក្ខ ជាមួយ បងប្អូន យើង គ្រប់ ពេលវេលា ហើយ នៅ ថ្ងៃ បន្តបន្ទាប់ លោក នឹង បន្ត ចុះ ជួប សំណេះសំណាល សួរសុខទុក្ខ បងប្អូន យើង នៅ គ្រប់ មណ្ឌល ចត្តាឡី ស័ក នីមួយ ៗ ក្នុង ខេត្ត ហើយ ដែល នឹង អាច វិលត្រឡប់មក ទីនេះ ម្តង ទៀត ផងដែរ ។
ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន ក៏ បាន នាំយក វត្ថុ កំដរ ដៃ ផ្តល់ ជូន បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ចំនួន ៨៦ នាក់ ដោយ ក្នុង ម្នាក់ ៗ ទទួលបាន មី ១កេស ទឹក សុទ្ធ ៥ដប ត្រីខ១យួរ និង នំ មួយ កញ្ចប់ ស្មើ ២គីឡូក្រាម ៕ ម៉ាឡេស៊ី គាំទ្រ ឥណ្ឌូណេស៊ី លើ ការស្នើ ឱ្យ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន ស្ដីពី ស្ថានការណ៍ មីយ៉ាន់ម៉ា
លោក Muhyiddin បាន គូសបញ្ជាក់ នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ថា ការប្រើប្រាស់ អំពើហិង្សា ដ៏ សាហាវ ឃោឃៅ ប្រឆាំង នឹង ជន ស៊ីវិល ដែល មិន មាន អាវុធ គឺ ពិតជា រឿង ដែល មិន អាច ទទួលយក បាន ទេ ។ ស្ថានការណ៍ ដ៏ អាក្រក់ បែប នេះ ត្រូវតែ បញ្ឈប់ ជាបន្ទាន់ ដោយ បាន ជំរុញ ឲ្យ មេដឹកនាំ យោធា មីយ៉ាន់ម៉ា « ផ្លាស់ប្តូរ ទិសដៅ របស់ ខ្លួន និង ជ្រើសរើស ផ្លូវ ឆ្ពោះ ទៅរក ដំណោះស្រាយ ដោយ សន្តិវិធី » ។
លោក Muhyiddin បាន គូសបញ្ជាក់ បន្ថែម ដូច្នេះ ថា៖ « យើង នៅក្នុង ប្រទេស ម៉ាឡេស៊ី និង សហគមន៍ អាស៊ាន ដែល មាន ប្រទេស ចំនួន ១០ ជា សមាជិក មិន អាច ឈរ មើល ប្រទេស មីយ៉ាន់ម៉ា ជា បងប្អូន របស់ យើង ក្លាយជា ប្រទេស ដែល អស្ថិរភាព នៅក្នុង កណ្តាប់ដៃ របស់ មនុស្ស មួយចំនួន ដែល ប្រព្រឹត្តទៅ ដើម្បី លើកកម្ពស់ ផលប្រយោជន៍ ផ្ទាល់ខ្លួន របស់ ពួកគេ នោះ ទេ » ។
គួរ បញ្ជាក់ ថា ប្រធានាធិបតី ឥណ្ឌូណេស៊ី កាលពី ថ្ងៃសុក្រ សប្ដាហ៍ នេះ បាន អំពាវនាវ ឲ្យ បញ្ឈប់ ការប្រើប្រាស់ អំពើហិង្សា និង ស្ដារ លទ្ធិ ប្រជាធិបតេយ្យ ឡើងវិញ នៅក្នុង ប្រទេស មីយ៉ាន់ម៉ា និង បាន អំពាវនាវ ឲ្យ ប្រធាន សមាគមន៍ អាស៊ាន រៀបចំ កិច្ចប្រជុំ កម្រិត ខ្ពស់ មួយ ជាបន្ទាន់ ដើម្បី ពិភាក្សា អំពី ស្ថានការណ៍ នៅ ទីនោះ ៕
កូរ៉េ ខាងជើង នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ដែរ បាន ផ្តាច់ ចំណង ការទូត ជាមួយ ម៉ាឡេស៊ី ជា ការឆ្លើយតប ទៅនឹង ការធ្វើ បត្យាប័ន របស់ ម៉ាឡេស៉ី ចំពោះ ពលរដ្ឋ កូរ៉េ ខាងជើង ទៅកាន់ សហរដ្ឋ អាមេរិក កាលពី ដើម ខែមីនា នេះ ។ កូរ៉េ ខាងជើង បាន ចាត់ទុក ទង្វើ របស់ ម៉ាឡេស៉ី ថា ជា « ឧក្រិដ្ឋកម្ម ដែល មិន អាច អត់ឱន ឲ្យបាន » ប្រព្រឹត្តទៅ ក្រោម « ការស្តាប់ បង្គាប់ ដោយ ងងឹតងងុល » ព្រោះតែ សម្ពាធ របស់ សហរដ្ឋ អាមេរិក ។
គួរ បញ្ជាក់ ថា ទំនាក់ទំនង រវាង ម៉ាឡេស៊ី និង កូរ៉េ ខាងជើង ធ្លាប់ បាន ធ្លាក់ចុះ ដុន ដាប ខ្លាំង នៅ ពេល ដែល បងប្អូន ប្រុស ម្តាយ ទីទៃ របស់ លោក គីម ជុង អ៊ុន គឺ លោក គីម ជុង ណាំ (Kim Jong Nam) ត្រូវបាន គេ ធ្វើឃាត ដោយ ថ្នាំ ពុល នៅពេល លោក រង់ចាំ ជើងហោះហើរ នៅឯ អាកាសយានដ្ឋាន អន្តរជាតិ គូឡាឡាំពួ នៃ ប្រទេស ម៉ាឡេស៉ី ៕ សម្ដេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ផ្តល់ អំណោយ រថយន្ត ដឹក ទឹក២ គ្រឿង និង រ៉ឺម៉ក ម៉ូតូ២ គ្រឿង ជូន កងកម្លាំង ប្រចាំ ការ នៅ ភូមិ បឹង ជង្រុក តេជោ ឈ្នះ ឈ្នះ
( បន្ទាយមានជ័យ )៖ លោក ប៉ាន់ ខែម ប៊ុន ថន នាយក រង ខុទ្ទកាល័យ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន នាំយក រថយន្ត ដឹក ទឹក២ គ្រឿង និង រ៉ឺម៉ក ម៉ូតូ២ គ្រឿង ដែល ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រគល់ ជូន កម្លាំង កងរាជអាវុធហត្ថ និង កម្លាំង នគរបាល ប្រចាំ ការ នៅ ភូមិ បឹង ជង្រុក តេជោ ឈ្នះ ឈ្នះ ។
នៅ រសៀល ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ អគ្គ នាយក រដ្ឋបាល និង ហិរញ្ញវត្ថុ នៃ ក្រសួង សុខាភិបាល នឹង នាំយក ថវិកា ទៅ ចូលរួម បុណ្យ សព ដែល កំពុង រៀបចំ ធ្វើ បុណ្យ តាម ប្រពៃណី នៅ គេហដ្ឋាន រៀង ៗ ខ្លួន ។ ក្រៅពី ថវិកា ចូលរួម បុណ្យ សព របស់ ក្រសួង សុខាភិបាល តំណាង ឲ្យ រាជ រដ្ឋាភិបាល . ដោយឡែក ខាង សាលា រាជធានី ភ្នំពេញ ក៏ នឹង នាំយក នូវ ថវិកា របស់ សម្តេច តេជោ ហ៊ុន សែន និង ទេយ្យ ទាន មួយចំនួន ទៅ ចូលរួម បុណ្យ សព ផងដែរ ។
សូម បញ្ជាក់ ថា អ្នកស្រី នួន សុផាន្នី ភរិយា របស់ តារា ជើង ចាស់ ហួរ ឡាវី និង ត្រូវ ជា ម្តាយ របស់ តារាចម្រៀង វី ឌីណែត បាន ទទួលមរណភាព នៅ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ នេះ អំឡុង ពេល សំរាក ព្យាបាល ជំងឺ កូវីដ១៩ នៅ មន្ទីរពេទ្យ ។ អ្នកស្រី នួន សុផាន្នី ត្រូវបាន រកឃើញ កើត ជំងឺ កូវីដ១៩ កាលពី ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២១ ។ អ្នកស្រី បាន ឆ្លង ជំងឺ នេះ ពី កូនស្រី គឺ កញ្ញា វី ដាណែត ។
( ស្វាយរៀង ) ៖ ចំការអាកាស្យា និង ចំការ កៅស៊ូ ត្រូវ ភ្លើង ឆាបឆេះ អស់ ជាង ២ហិកតា បង្ក ការភ្ញាក់ផ្អើល ដល់ ប្រជាពលរដ្ឋ កាលពី វេលា ម៉ោង ១៨៖ ២០នាទី ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ ដោយ ផ្តើម ចេញ ពី ភ្លើង ឆេះ ស្រែ របស់ អ្នកស្រុក ។
សមត្ថកិច្ច នគរបាល ប៉ុស្តិ៍ រដ្ឋបាល ព្រៃ តា អី បាន ឲ្យដឹង ថា ចំការអាកាស្យា និង ចំការ កៅស៊ូ ដែល ត្រូវ ភ្លើង អគ្គីភ័យ ឆាបឆេះ អស់ ជាង ២ហិកតា នេះ មាន ម្ចាស់ ឈ្មោះ សួស សម្បត្តិ នៅ ភ្នំពេញ ប៉ុន្តែ មិន បណ្តាលឲ្យ ខូចខាត ដើម ធំ ៗ នោះ ទេ គ្រាន់តែ ឆេះ ស្តឹក ជ្រុះ នៅ ខាងក្រោម និង ដើម តូច ៗ ប៉ុណ្ណោះ ស្ថិត នៅក្នុង ភូមិ ត្រពាំង តា អី ឃុំ ព្រៃ តា អី ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង ។
ប្រភព បាន បន្ត ទៀត ថា ភ្លាម ៗ នោះ ផងដែរ ក្រោយពី ទទួលបាន ព័ត៌មាន ភ្លាម កម្លាំង ប៉ុស្តិ៍ រដ្ឋបាល និង ប្រជាពលរដ្ឋ សហការ ជាមួយ កម្លាំង ពន្លត់ អគ្គីភ័យ អធិការដ្ឋាន នគរបាល ស្រុក ស្វាយទាប ប្រើប្រាស់ ឡាន ទឹក ចំនួន១ គ្រឿង មក ជួយ អន្តរាគមន៍ ហើយ ភ្លើង រលត់ ទៅ វិញ នៅ ម៉ោង ២០៖ ៥០ នាទី ។
មូលហេតុ ភ្លើង ឆេះ ផ្ដើម ចេញ ពី ដី ស្រែ របស់ ប្រជាពលរដ្ឋ នៅក្បែ នោះ ហើយ បច្ចុប្បន្ន កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ព្រៃ តា អី កំពុងតែ ស្រាវជ្រាវ រក មូលហេតុ ដែល បណ្តាលឲ្យ មាន ភ្លើង ឆាបឆេះ នេះ ផងដែរ ៕ អាជ្ញាធរ រួមគ្នា ដាំ កូន ឈើ នៅ ខ្លោងទ្វារ ជ័យ ដើម្បី អភិរក្ស ប្រាសាទ និង បង្កើន គម្រប បៃតង បរិស្ថាន ក្នុង តំបន់ រមណីយដ្ឋាន អង្គរ
( សៀមរាប ) ៖ ក្រុម ភ្នាក់ងារ សណ្តាប់ធ្នាប់ ប្រចាំ ការតាម ប្រាសាទ និង អង្គភាព នគរបាល ការពារ បេតិកភណ្ឌ ប្រចាំ តំបន់ អង្គរ បាន រួមគ្នា ដាំ កូន ឈើ ស្ថិត នៅ គោលដៅ ការពារ ខាងកើត ខ្លោងទ្វារ ជ័យ ។
ការដាំ ដើមឈើ នេះ ធ្វេី ឡេីង នា ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ ក្នុង គោលបំណង ដើម្បី រួមគ្នា ថែរក្សា ទេសភាព វប្បធម៌ បង្កើត គម្រប បៃតង ដល់ បរិស្ថាន នៅក្នុង តំបន់ អង្គរ បង្កើន ជម្រក សត្វ ព្រៃ និង ជួយ ដល់ ការអភិរក្ស ប្រាសាទ ផង ។ កូន ឈើ ទាំងនោះ ត្រូវបាន ដាំ ឡើងវិញ ដើម្បី បំពេញ ចន្លោះ ព្រៃឈើ នៅ តាម ដងផ្លូវ និង ចូលរួមចំណែក ក្នុង កិច្ចការ អភិរក្ស និង អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព រមណីយដ្ឋាន អង្គរ ។
ការិយាល័យ ឧតុនិយម អូស្រ្តាលី បាន រាយការណ៍ បន្ថែម ថា ទីប្រជុំជន ក្នុង តំបន់ ត្រូវបាន គេ កត់សម្គាល់ ឃើញ ថា មាន កម្រិត ទឹកភ្លៀង ធ្លាក់ ខ្លាំង បំផុត គឺជាង ៣០០ មីល្លីម៉ែត្រ ដែល ធ្លាក់ ចាប់តាំងពី ព្រឹក ថ្ងៃសុក្រ មក ម្ល៉េះ ហើយ ភ្លៀង ធ្លាក់ ខ្លាំង នេះ ត្រូវបាន គេ ព្យាករណ៍ ថា នឹង បន្ត ធ្លាក់ រហូតដល់ ថ្ងៃសៅរ៍ « ដែល អាច នាំឱ្យ មាន ទឹក ជំនន់ ដែល គំរាមកំហែង ដល់ អាយុជីវិត នៅ ទូទាំង តំបន់ » ។
គួរ បញ្ជាក់ ថា សេវាកម្ម សង្គ្រោះ បន្ទាន់ បាន រាយការណ៍ ថា ខ្លួន បាន ទទួល ការហៅ ជំនួយ ពី មនុស្ស ជាង ៥០០ នាក់ ហើយ និង បាន ជួយសង្គ្រោះ តំបន់ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ចំនួន ១៨០ កន្លែង ក្នុង រយៈពេល ពេញ មួយ យប់ នៅ ភាគ ខាងជើង នៃ តំបន់ រងគ្រោះ ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ១៩ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៣៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២០ ខែមីនា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៧ នាក់ នោះ មាន ២៤ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៣ករណី និង ជនសង្ស័យ ១៣នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៦ ករណី ។
លោក បូរី ស ចន សុន អាយុ ៥៦ ឆ្នាំ បាន ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ COVID-19 សម្រាប់ ដូស ដំបូង របស់ លោក នៅ មន្ទីរពេទ្យ តែ មួយ ដែល កាលពី ជិត មួយ ឆ្នាំ មុន លោក ត្រូវបាន ក្រុម គ្រូពេទ្យ រៀបចំ ឱ្យ សម្រាក ព្យាបាល យ៉ាង យកចិត្តទុកដាក់ បំផុត បន្ទាប់ពី លោក បាន ធ្វើតេស្ត វិជ្ជមាន ចំពោះ ជំងឺ នេះ និង បាន ធ្លាក់ខ្លួន ឈឺ ធ្ងន់ ។
ក្នុង ព្រះរាជ សារ រំលែក មរណទុក្ខ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ ព្រះមហាក្សត្រី បាន ចាត់ទុក មរណភាព របស់ អ្នកស្រី នួន សុផាន្នី គឺជា ការបាត់បង់ ភរិយា និង ម្តាយ ដ៏ ល្អ ប្រពៃ មួយ ដែល ជាទីគោរព ស្រឡាញ់ នៃ បុត្រ ព្រមទាំង បងប្អូន និង ញាតិមិត្ត ទាំងឡាយ ។ សម្តេច ម៉ែ ក៏ បាន សូម ឱ្យ វិញ្ញាណក្ខន្ធ អ្នកស្រី នួន សុផាន្នី អញ្ជើញ ទៅកាន់ សុគតិភព កុំបី ខាន ។
សូម បញ្ជាក់ ថា អ្នកស្រី នួន សុផាន្នី ភរិយា របស់ តារា ជើង ចាស់ ហួរ ឡាវី និង ត្រូវ ជា ម្តាយ របស់ តារាចម្រៀង វី ឌីណែត បាន ទទួលមរណភាព នៅ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ នេះ អំឡុង ពេល សំរាក ព្យាបាល ជំងឺ កូវីដ១៩ នៅ មន្ទីរពេទ្យ ។
អ្នកស្រី នួន សុផាន្នី ត្រូវបាន រកឃើញ កើត ជំងឺ កូវីដ១៩ កាលពី ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២១ ។ អ្នកស្រី បាន ឆ្លង ជំងឺ នេះ ពី កូនស្រី គឺ កញ្ញា វី ឌីណែត ។
បច្ចុប្បន្ន កញ្ញា វី ឌីណែត និង ប្អូន ស្រី កំពុង សម្រាក ព្យាបាល ជំងឺ កូវីដ១៩ ខណៈ លោក ហួរ ឡាវី និង សមាជិក គ្រួសារ ដទៃ ទៀត ត្រូវបាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ។ កញ្ញា វី ឌីណែត និង ក្រុមគ្រួសារ បាន ត្រឹម ធ្វើ បុណ្យ ឧទ្ទិស កុសល ជូន វិញ្ញាណក្ខន្ធ នួន សុផាន្នី តាម ប្រព័ន្ធ វីដេអូ ប៉ុណ្ណោះ ៕ ក្រសួង អប់រំ ជូនដំណឹង ដល់ បុគ្គលិក អប់រំ គ្រប់ លំដាប់ថ្នាក់ ពី ការពិនិត្យ សុខាភាព ផ្ទាល់ខ្លួន បើ សង្ស័យ ប្រញាប់ ទៅ ធ្វើតេស្ត រក កូវីដ១៩
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ថ្មី មួយ ស្តីពី ការពិនិត្យ សុខភាព ផ្ទាល់ខ្លួន របស់ បុគ្គលិក អប់រំ គ្រប់ លំដាប់ថ្នាក់ ។
ក្នុង សេចក្តីជូនដំណឹង នេះ ក្រសួង អប់រំ បាន ណែនាំ ដល់ បុគ្គលិក អប់រំណា ដែល បាន ប៉ះពាល់ ជាមួយ សាធារណជន ច្រើន ព្រមទាំង កំពុង រស់ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល និង មាន រោគសញ្ញា ដូចជា គ្រុន ក្តៅ ក្អក កណ្តាស់ ឈឺ ក ហៀរ សំបោរ ហត់ ឬ ពិបាក ដកដង្ហើម សូម ទៅ ធ្វើតេស្ត រក កូវីដ១៩ ឲ្យ បាន ឆាប់ ៕
អ្នក ឆ្លង កូវីដ១៩ ថ្មី ទាំង ៥៤ នាក់ មាន ម្នាក់ ជា ស្ត្រី ជនជាតិ ខ្មែរ ធ្វើដំណើរ មកពី ប្រទេស សិង្ហបុរី មកដល់ កម្ពុជា នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២១ និង ៥៣ នាក់ ជា ករណី ឆ្លង ក្នុង សហគមន៍ នៃ ព្រឹត្តិការណ៍ ២០កុម្ភៈ រួម មាន៖ ជនជាតិ ខ្មែរ ៣២ នាក់ . ជនជាតិ ចិន ២០ នាក់ និង ជនជាតិ វៀតណាម ម្នាក់ ដែល រកឃើញ នៅ រាជធានី ភ្នំពេញ . ខេត្ត កណ្តាល និង ព្រះសីហនុ ។
ចំណែក អ្នក ជាសះស្បើយ ទាំង ១៨ នាក់ គឺ សុទ្ធសឹង ជា អ្នក ឆ្លង ក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២០កុម្ភៈ » រួម មាន៖ ជនជាតិ ចិន ១៤ នាក់ . ជនជាតិ វៀតណាម ២នាក់ . ជនជាតិ កូរ៉េ ម្នាក់ និង ជនជាតិ ខ្មែរ ម្នាក់ ទទួលបាន លទ្ធផល អវិជ្ជមាន កូវីដ១៩ ចំនួន ២ដង និង ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី កន្លែង ព្យាបាល ។
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន សម្តែង មរណទុក្ខ យ៉ាង ក្រៀមក្រំ និង សោកស្តាយ ជាខ្លាំង ជាមួយ តារា ចម្រៀង ជើង ចាស់ លោក ហូរ ឡាវី និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ លោកស្រី ងួន សុផាន្នី ដោយសារ ជំងឺ កូវីដ១៩ ។
ក្នុង សារលិខិត រំលែក មរណទុក្ខ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ចាត់ទុក មរណភាព របស់ លោកស្រី ងួន សុផាន្នី គឺជា ការបាត់បង់ ភរិយា ម្តាយ និង ជីដូន ដ៏ ល្អ និង ជាទីគោរព ស្រលាញ់ ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន បួងសួង សូម ឱ្យ វិញ្ញាណក្ខន្ធ លោកស្រី ងួន សុផាន្នី បាន ទៅកាន់ សុគតិភព ។ ជាមួយនឹង ការរំលែក ទុក្ខ នេះ សម្តេច កិត្តិព្រឹទ្ធិ បណ្ឌិត បាន ចូល បច្ច័យ បុណ្យ សព ចំនួន ១០លាន រៀល និង ទេយ្យ ទាន មួយចំនួន ទៀត ផងដែរ ។
អ្នកស្រី នួន សុផាន្នី ត្រូវបាន រកឃើញ កើត ជំងឺ កូវីដ១៩ កាលពី ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២១ ។ អ្នកស្រី បាន ឆ្លង ជំងឺ នេះ ពី កូនស្រី គឺ កញ្ញា វី ដាណែត ។
បច្ចុប្បន្ន កញ្ញា វី ដាណែត និង ប្អូន ស្រី កំពុង សម្រាក ព្យាបាល ជំងឺ កូវីដ១៩ ខណៈ លោក ហូរ ឡាវី និង សមាជិក គ្រួសារ ដទៃ ទៀត ត្រូវបាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ។ កញ្ញា វី ដាណែត និង ក្រុមគ្រួសារ បាន ត្រឹម ធ្វើ បុណ្យ ឧទ្ទិស កុសល ជូន វិញ្ញាណក្ខន្ធ នួន សុផាន្នី តាម ប្រព័ន្ធ វីដេអូ ប៉ុណ្ណោះ ៕ ក្រសួង បរិស្ថាន៖ កម្ពុជា ជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស កំពុង អនុវត្ត កម្មវិធី រេដ បូក (REDD+) បាន ល្អ
បើ តាម លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា រហូតមកដល់ ពេលនេះ មាន តែ ប្រទេស កម្ពុជា និង ប្រទេស ឥណ្ឌូនេស៊ី ប៉ុណ្ណោះ ក្នុង ប្រទេស អាស៊ាន ដែល បាន លក់ ឥណទាន កាបូន ក្នុង ទីផ្សារ កាបូន ស្ម័គ្រចិត្ត ។
លោក រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន គូសបញ្ជាក់ ថា ថវិកា ទាំងអស់ នេះ បាន យក ទៅ ប្រើប្រាស់ សម្រាប់ ការពារ ព្រៃឈើ និង អភិវឌ្ឍ ជីវភាព សហគមន៍ ក្នុង តំបន់ ការពារ ទាំង ពីរ ដើម្បី ធ្វើជា គំរូ សម្រាប់ ឈាន ទៅ ទទួលបាន ថវិកា « ការទូទាត់ ផ្អែក តាម លទ្ធផល » ពី មូលនិធិ អាកាសធាតុ បៃតង នៃ អនុសញ្ញា ក្របខ័ណ្ឌ សហប្រជាតិ ស្តីពី ការប្រែប្រួល អាកាសធាតុ ដែល គ្រង នឹង អនុវត្ត ចាប់ពី ឆ្នាំ ២០២០ ៕
អាវុធហត្ថ រាជធានី ភ្នំពេញ ឃាត់ ជនសង្ស័យ ចំនួន ០៤ នាក់ ជា បន្តបន្ទាប់ ពាក់ព័ន្ធ ករណី គ្រឿងញៀន
ជនសង្ស័យ ទាំង ០៤ នាក់ រួម មាន៖
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ០៤ នាក់ ត្រូវបាន បញ្ជូន ទៅ ការិយាល័យ ប្រឆាំង បទល្មើស គ្រឿងញៀន នៃ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ ការសាកសួរ និង កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ផ្តន្ទាទោស តាម នីតិវិធី ច្បាប់ ៕ កិច្ច ជំនួប យុទ្ធសាស្រ្ត ជាន់ ខ្ពស់ រវាង ចិន និង អាមេរិក បិទ បញ្ចប់ ហើយ . លោក Yang Jiechi និង លោក Wang Yi ផ្តល់ បទសម្ភាសន៍ រួម ជាមួយ ប្រព័ន្ធ សារព័ត៌មាន ចិន
គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ខេត្ត កំពង់ចាម បន្ត ទទួល ការឧបត្ថម្ភ ពី សប្បុរសជន
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ ខេត្ត នា រសៀល ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២១ បាន បន្ត ទទួល អំណោយ ឧបត្ថម្ភ ជា ថវិកា គ្រឿង ឧបភោគ បរិភោគ រួម នឹង សម្ភារៈ ពី សប្បុរសជន ដើម្បី ចូលរួម ក្នុង យុទ្ធនាការ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ ។
ស្ថិត ក្នុង ឱកាស នោះ ក្នុង នាម គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩ ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ថ្លែងអំណរ អរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ចិត្ត ប្រកបដោយ មនុស្សធម៌ របស់ សប្បុរសជន ទាំងអស់ ដែល បាន បរិច្ចាគ នូវ សម្ភារ : គ្រឿង ឧបភោគ បរិភោគ រួម នឹង ថវិកា មកដល់ គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ ជំងឺ កូវីដ - ១៩ ខេត្ត កំពង់ចាម ដើម្បី ប្រើប្រាស់ ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ ឆ្លង ដ៏ សាហាវ នេះ ។
ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន ក៏ បាន នាំយក វត្ថុ កំដរ ដៃ ផ្តល់ ជូន បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ចំនួន ៨៦ នាក់ ដោយ ក្នុង ម្នាក់ ៗ ទទួលបាន មី ១កេស ទឹក សុទ្ធ ៥ដប ត្រីខ១យួរ និង នំ មួយ កញ្ចប់ ស្មើ ២គីឡូក្រាម ៕
អគារ ស្កាយ ឡាញ នៅ ខណ្ឌ ៧មករា ដែល ផ្ទុះ ករណី កូវីដ ជាច្រើន នាក់ ត្រូវបាន អាជ្ញាធរ បើក ដំណើរការ ឡើងវិញ
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បិទ ទ្វារ មួយ រយៈ ដោយសារតែ មាន ការជាប់ពាក់ព័ន្ធ ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ នៅ ពេល នេះ អាជ្ញាធរ ខណ្ឌ ៧មករា បាន សម្រេច អនុញ្ញាតឲ្យ អគារ ស្កាយ ឡាញ ( អគារ A) បើក ដំណើរការ ជាធម្មតា វិញ ហើយ ។
ការអនុញ្ញាត នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២១ នេះ ក្រោម ការដឹកនាំ ចុះ ពិនិត្យ ផ្ទាល់ របស់ លោក លឹម សុភា អភិបាល នៃ គណៈអភិបាល ខណ្ឌ ៧មករា ។
ម្ចាស់ ទីតាំង អគារ ស្កាយ ឡាញ និង បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ស្នាក់ នៅក្នុង អគារ បាន សម្ដែង ក្ដី អបអរសាទរ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អាជ្ញាធរ ពាក់ព័ន្ធ គ្រប់ លំដាប់ថ្នាក់ និង ជាពិសេស ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ ដឹកនាំ ដ៏ ឈ្លាសវៃ ដែល ជានិច្ច ជាកាល សម្ដេច តែងតែ នៅ រួម សុខ រួម ទុក្ខ ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ដើម្បី ដោះស្រាយ រាល់ គ្រប់ បញ្ហា ជូន ប្រជាជន ទូទាំង ប្រទេស ។
