( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៦៤ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមីនា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៦៤ នាក់ នោះ មាន ២៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១១ករណី និង ជនសង្ស័យ ៣៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៦ករណី ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា ក្នុង ចំណោម អ្នក ឆ្លង ក្នុង សហគមន៍ ថ្មី ទាំង ៣៩ នាក់ មាន ជនជាតិ ខ្មែរ ២៩ នាក់ . ជនជាតិ ចិន ៥នាក់ និង ជនជាតិ វៀតណាម ៥នាក់ ដែល រកឃើញ នៅ រាជធានី ភ្នំពេញ ខេត្ត ព្រះសីហនុ កណ្តាល និង ព្រៃវែង ។
ចំណែក អ្នក ជាសះស្បើយ ទាំង ៤នាក់ វិញ គឺ ស្ត្រី ជនជាតិ ខ្មែរ ម្នាក់ និង បុរស ជនជាតិ ចិន ៣នាក់ ដែល ឆ្លង ក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២០កុម្ភៈ » ទទួលបាន លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន ២លើ ក និង អនុញ្ញាតឲ្យ ចេញ ពី កន្លែង ព្យាបាល ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ៧៣ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន និង ប្រជែង ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ១២ ខែមីនា ឆ្នាំ ២០២១ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
តួកគី គ្រោង នឹង ទិញ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ពី ចិន ចំនួន ៥០លាន ដូស បន្ថែម ទៀត
យោង តាម ទិន្នន័យ ចុងក្រោយ របស់ ក្រសួង សុខាភិបាល តួកគី បាន ឲ្យដឹង ថា រហូតមកដល់ ពេលនេះ វ៉ាក់សាំង ជាង ១០.៨ លាន ដូស ត្រូវបាន ផ្តល់ ជូន រួចរាល់ ដែល ជា ផ្នែក មួយ នៃ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ៕ អាជ្ញាធរ ខេត្ត សៀមរាប បន្ត ដឹក ពលករ តាម ព្រំដែន ថៃ ជាង ៣០០ នាក់ ទៀត មក ធ្វើចត្ដាឡី ស័ក ក្នុង ខេត្ត
( សៀមរាប ) ៖ ពលករ ខ្មែរ ជាង ៣០០ នាក់ បន្ថែម ទៀត នៅ ថ្ងៃទី ១២ ខែមីនា ត្រូវបាន អាជ្ញាធរ ខេត្ត សៀមរាប ទៅ ទទួល និង ដឹកជញ្ជូន តាម រថយន្ត ទាហាន ដើម្បី មក ធ្វើចត្តាឡី ស័ក នៅ តាម ស្រុក គោលដៅ នានា ក្នុង ខេត្ត សៀមរាប ។ ការដឹកជញ្ជូន នេះ បន្ទាប់ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្ដេច នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន បាន ប្រកាស បិទ ការធ្វើចត្តាឡី ស័ក នៅ តាម ខេត្ត ជាប់ ព្រំដែន ថៃ សម្រាប់ អ្នក ដែល មាន សុខភាព ធម្មតា ។
នា រសៀល ថ្ងៃទី ១២ ខែ មីនា ក្បួន រថយន្ត ចំនួន ១៧ គ្រឿង បាន ដឹក ពលករ ខ្មែរ ចំនួន ៣៣២ នាក់ ក្នុង នោះ មាន ស្រី ១២៩ នាក់ មកពី តាម បណ្ដា ខេត្ត ជាប់ ព្រំដែន កម្ពុជា - ថៃ រួម មាន ខេត្ត បន្ទាយមានជ័យ បាត់ដំបង ប៉ៃលិន និង ខេត្ត ឧត្តរមានជ័យ ។ ពលករ ទាំងនោះ គឺជា អ្នក ដែល បាន វិលត្រឡប់ ពី ប្រទេស ហើយ បាន និង កំពុង ធ្វើចត្ដាឡី ស័ក នៅ តាម មណ្ឌល ចត្ដាឡី ស័ក តាម ខេត្ត ជាប់ ព្រំដែន ។
ក្រុម ពលករ ខាងលើ ត្រូវបាន យកមក ពិនិត្យ សុខភាព នៅ តាម មណ្ឌល ចត្ដាឡី ស័ក ចំនួន ២ គឺ មណ្ឌល ចត្តាឡី ស័ក សាលា បឋមសិក្សា គរុកោសល្យ ខេត្ត និង សាលា បឋមសិក្សា វត្ត ស្វាយ ។ ដោយសារ ពលករ មាន ចំនួន ច្រើន អាជ្ញាធរ ខេត្ត សៀមរាប បាន បង្កើន មណ្ឌល ចត្ដាឡី ស័ក ចំនួន ១ បន្ថែម ទៀត គឺ សាលា បឋមសិក្សា វត្ត ស្វាយ ។
បើ តាម ការបញ្ជាក់ របស់ លោកស្រី យូ សុភា បាន ឲ្យដឹង ថា ពលករ ដែល បាន មក ក្រៅ ប្រទេស ហើយ បាន ធ្វើចត្តាឡី ស័ក នៅ តាម បណ្ដា ខេត្ត ជាប់ ព្រំដែន បាន ចូល មកកាន់ មណ្ឌល ចត្តាឡី ស័ក សាលា បឋមសិក្សា អនុវត្ត គរុកោសល្យ ខេត្ត គឺ ចំពោះ ពលករ ដែល មិន ទាន់ បាន ធ្វើចត្តាឡី ស័ក នៅ តាម ព្រំដែន តែ ចំពោះ បងប្អូន ពលករ ដែល បាន ចូលទៅ មណ្ឌល ចត្តាឡី ស័ក នៅ សាលា បឋមសិក្សា វត្ត ស្វាយ គឺ មាន បងប្អូន ខ្លះ បាន ធ្វើចត្តាឡី ស័ក គ្រប់ តាម គោលការណ៍ របស់ ក្រសួង សុខាភិបាល ខ្លះ មិន ទាន់ គ្រប់ ថ្ងៃ ត្រូវតែ បន្ត ផងដែរ ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃទី ៩ មីនា កន្លងទៅ អាជ្ញាធរ ខេត្ត សៀមរាប ក៏ ប បាន ដឹកជញ្ជូន ពលករ ពី ថៃ ជា ទ្រុង ទ្រាយ ធំ ផងដែរ ដែល សរុប ប្រមាណ ជាង ៧០០ នាក់ ដែល សរុប មកដល់ ពេលនេះ គឺ មាន ពលករ ខ្មែរ ជាង មួយ ពាន់ នាក់ ហើយ ៕ វៀតណាម រកឃើញ ករណី ឆ្លង ថ្មី នៃ ជំងឺ កូវីដ - ១៩ ចំនួន ១៧ករណី ទៀត នៅក្នុង របាយការណ៍ ថ្ងៃសុក្រ នេះ
បើ តាម ក្រសួង សុខាភិបាល វៀតណាម បាន ឲ្យដឹង ទៀត ថា ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ទាំងអស់ ខាងលើ មាន ១៣នាក់ ជា ករណី នាំចូល ពី ក្រៅ ប្រទេស ខណៈ ដែល ០៤ នាក់ ទៀត ជា ករណី ឆ្លង ក្នុង សហគមន៍ ។
ខាងក្រោម តារាង បញ្ជី បូកសរុប ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ របស់ លើក ទី១ និង លើក ទី២ របស់ ក្រសួង ការពារ ជាតិ៖ សម្ដេច តេជោ ហ៊ុន សែន ចេញ អនុក្រឹត្យ ស្ដីពី វិធានការ សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ និង ជំងឺ កាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត
( ភ្នំពេញ ) ៖ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្ដេច តេជោ ហ៊ុន សែន នា ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន ចេញ អនុក្រឹត្យ ស្ដីពី វិធានការ សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ និង ជំងឺ កាច សាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ក្នុង គោលបំណង ការពារ អាយុជីវិត របស់ ប្រជាពលរដ្ឋ សុខាភិបាល សាធារណៈ និង សណ្ដាប់ធ្នាប់ សាធារណៈ ព្រមទាំង កាត់បន្ថយ ឱ្យ បានជា អតិបរមា នូវ ផល ប៉ះពាល់ នៃ ការឆ្លង ជំងឺ នេះ ចំពោះ វិស័យ សង្គម និង សេដ្ឋកិច្ច នៅ កម្ពុជា ។
ក្រសួង ព័ត៌មាន សម្រេច លុប « សមាគម អ្នកសារព័ត៌មាន ហ្វេសប៊ុក កម្ពុជា » ក្រោយ ផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត និង បង្ក ចលាចល ដល់ សង្គម ដោយសារ បញ្ហា កូវីដ១៩
( ភ្នំពេញ ) ៖ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញារីទ្ធ នៅ ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២១ នេះ បាន សម្រេច លុប អាជ្ញា បណ្ណ « សមាគម អ្នកសារព័ត៌មាន ហ្វេសប៊ុក កម្ពុជា » ក្រោយ ផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ជុំវិញ ករណី ជំងឺ កូវីដ - ១៩ ដែល បង្ក ចលាចល ក្នុង សង្គម ។
ក្រៅពី ការលុប « សមាគម អ្នកសារព័ត៌មាន ហ្វេសប៊ុក កម្ពុជា » នេះ ដែរ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញារីទ្ធ នៅ ថ្ងៃទី ១២ ខែមីនា នេះ បាន សម្រេច លុប អាជ្ញា បណ្ណ គេហទំព័រ ចំនួន ២ ផងដែរ ដោយសារតែ គេហទំព័រ ទាំង ២នេះ បាន ផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ធ្វើឱ្យ សាធារណជន មាន ភាន់ច្រឡំ ព្រមទាំង បង្ក ចលាច កល ដល់ សង្គមជាតិ ជាដើម ៕
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច របស់ លោក ខៀវ កាញារី ទ្ធ៖ ចក្រភព អង់គ្លេស ណែនាំ ប្រជាជន ខ្លួន ឲ្យ ចាកចេញ ពី មីយ៉ាន់ម៉ា ខណៈ អំពើហិង្សា កំពុង កើនឡើង
ការអំពាវនាវ ពី ចក្រភព អង់គ្លេស ខាងលើ នេះ បាន កើត មាន ឡើង តែ មួយ ថ្ងៃ ប៉ុណ្ណោះ បន្ទាប់ពី សេចក្តីរាយការណ៍ នានា បាន ឲ្យដឹង ថា បាតុករ ចំនួន ១២នាក់ ទៀត បាន ស្លាប់ នៅក្នុង ការបង្ក្រាប ដោយ ហិង្សា ពីសំណាក់ កងកម្លាំង សន្តិសុខ មីយ៉ាន់ម៉ា ចំពោះមុខ ការទម្លាក់ បទ ចោទប្រកាន់ ថ្មី ៗ ទៀត ពី សំណាក់់ តុលាការ ទៅ លើ លោកស្រី អោង សាន ស៊ូ ជី ។
ក្រសួង ការបរទេស នៃ ចក្រភព អង់គ្លេស បាន គូសបញ្ជាក់ នៅក្នុង សេចក្តីការណ៍ នៅ ថ្ងៃសុក្រ នេះ យ៉ាង ដូច្នេះ ថា « យើង ផ្តល់ ដំបូន្មាន ឲ្យ ប្រជាជន នៃ ចក្រភព អង់គ្លេស ទាំងអស់ ចាកចេញ ពី ប្រទេស មីយ៉ាន់ម៉ា តាម មធ្យោបាយ ដែល អាច ធ្វើ ទៅ បាន លើកលែងតែ អ្នក ដែល មាន កិច្ចការ ចាំបាច់ បំផុត ដែល ត្រូវ បន្ត ស្នាក់ នៅ ទីនោះ ប៉ុណ្ណោះ ។ ភាពតានតឹង នយោបាយ និង ការប្រឆាំត វ៉ា កំពុងតែ រីក ធំ ឡើង ៗ គិត ចាប់តាំងពី យោធា ឡើង កាន់អំណាច ហើយ អំពើហិង្សា កំពុង បន្ត កើនឡើង ជាលំដាប់ » ។
គួរ បញ្ជាក់ ថា ចក្រភព អង់គ្លេស បាន ប្រកាស ថ្កោល ទោស រដ្ឋប្រហារ យោធា នៅ មីយ៉ាន់ម៉ា រួច មកហើយ និង បាន អំពាវនាវ ឲ្យ មីយ៉ាន់ម៉ា ស្តារ លទ្ធិ ប្រជាធិបតេយ្យ របស់ ខ្លួន ឡើងវិញ ។ ចក្រភព អង់គ្លេស ក៏ កំពុង ពិចារណា ក្នុង ការដាក់ទណ្ឌកម្ម ទៅ លើ របប យោធា នៅ មីយ៉ាន់ម៉ា ផងដែរ ៕
ចំណេះដឹង ទូទៅ៖ តើ បច្ចុប្បន្ន កម្ពុជា មាន តំបន់ ការពារ ធនធាន ធម្មជាតិ ប៉ុន្មាន ហើយ មាន ផ្ទៃដី ស្មើនឹង ប៉ុន្មាន ភាគរយ នៃ ផ្ទៃ ប្រទេស ?
( ភ្នំពេញ ) ៖ តំបន់ ការពារ ធនធាន ធម្មជាតិ គឺជា ដែនដី សម្បត្តិ សាធារណៈ របស់ រដ្ឋ រួម មាន ដែនដី គោក ឬ ដែន ទឹក រួមទាំង ឆ្នេរសមុទ្រ និង សមុទ្រ ស្ថិត នៅក្នុង តំបន់ ដែល ទទួលស្គាល់ ដោយ បញ្ញត្តិ នៃ ច្បាប់ ឬ តំបន់ ដែល បង្កើត ថ្មី ក្នុង ដែន សមត្ថកិច្ច របស់ ក្រសួង បរិស្ថាន ដែល ធានា បាន នូវ ការ ការពារ ប្រភេទ សត្វ ព្រៃ និង រុក្ខជាតិ សំខាន់ ៗ ក៏ ដូចជា សហគមន៍ ធម្មជាតិ ។
តើ បច្ចុប្បន្ន នេះ កម្ពុជា មាន តំបន់ ការពារ ធនធាន ធម្មជាតិ ប៉ុន្មាន កន្លែង ហើយ មាន វិសាលភាព សរុប ស្មើនឹង ប៉ុន្មាន ភាគរយ នៃ ផ្ទៃដី ប្រទេស ទាំងមូល ?
ដូច យើង ដឹង ហើយ ថា ប្រទេស កម្ពុជា មាន ផ្ទៃដី សរុប ១៨១.០៣៥ គីឡូម៉ែត ការ៉េ មាន ព្រំដែនដី គោក ខាងជើង និង ខាងលិច ជាប់ ប្រទេស ថៃ ៨០០ គីឡូម៉ែត្រ . ភាគ ឦសាន ជាប់ ជាមួយ ប្រទេស ឡាវ ៥៤១ គីឡូម៉ែត្រ និង នៅ ភាគ ខាងកើត និង អាគ្នេយ៍ ជាប់ ជាមួយ ប្រទេស វៀតណាម ១.២២៨ គីឡូម៉ែត្រ ។ ចំណែកឯ ព្រំដែន សមុទ្រ លាតសន្ធឹង លើ ឈូង សមុទ្រ ថៃ ប្រវែង ៤៤៣ គីឡូម៉ែត្រ ។
ពាក់ព័ន្ធ នឹង ចំនួន តំបន់ ការពារ ធនធាន ធម្មជាតិ នៅ កម្ពុជា លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន ឱ្យដឹង ថា រហូតមកដល់ ឆ្នាំ ២០២១ នេះ កម្ពុជា មាន តំបន់ ការពារ ធនធាន ធម្មជាតិ ចំនួន ៧៣ ដែល មាន ផ្ទៃដី សរុប ៧. ២៩៧.៣១៤ ហិកតា ស្មើនឹង ៤១ % នៃ ផ្ទៃដី ប្រទេស កម្ពុជា ទាំងមូល ។
តំបន់ ការពារ ធនធាន ធម្មជាតិ ចំនួន ៧៣ នេះ គឺ ស្ថិត នៅក្នុង ប្រភេទ តំបន់ ការពារ ធំ ៗ ចំនួន ៨ រួម មាន៖
តំបន់ ឧទ្យាន ជាតិ ទាំងនេះ សម្បូរ ទៅ ដោយ សត្វ ព្រៃ កម្រ ជាច្រើន ប្រភេទ និង សម្បត្តិ ទៅ ដោយ ព្រៃ ស្រោង ព្រៃរ បោះ និង ជា តំបន់ ទាក់ទាញ ភ្ញៀវ ទេសចរ ឱ្យ ចូល ទស្សនា បាន យ៉ាង ច្រើន ផងដែរ ។
តំបន់ ដែន ជម្រក សត្វ ព្រៃ ទាំងនេះ សម្បូរ ទៅ ដោយ ប្រភេទ សត្វ ព្រៃ ជិត ផុត ពូជ សត្វ ព្រៃ កម្រ សត្វ ព្រៃ រង ការគំរាមកំហែង ពពួក មច្ឆា ជាតិ ជិត ផុត ពូជ និង កម្រ ព្រមទាំង ជា ជម្រក សត្វ ព្រៃ និង ជីវ ចម្រុះ ជាច្រើន ប្រភេទ ពិសេស សម្បូរ ទៅ ដោយ ធនធាន ធម្មជាតិ ព្រៃ ស្រោង និង ព្រៃរ បោះ ជាដើម ។
ទី៣៖ តំបន់ ទេសភាព តំបន់ ទេសភាព នេះ ត្រូវ បែងចែក ជា ១៣ តំបន់ ផ្សេង ៗ គ្នា និង មាន ផ្ទៃដី សរុប ១៥៣.៦០៤ ហិកតា រួម មាន តំបន់ រមណីយដ្ឋាន អង្គរ តំបន់ បន្ទាយ ឆ្មារ តំបន់ ព្រះវិហារ តំបន់ អង្លង់ ព្រីង តំបន់ ទំនាប ខាងជើង ទន្លេ សាប តំបន់ បឹង ព្រែក ល្ពៅ តំបន់ អាង ត្រពាំង ថ្ម តំបន់ ប្រាសាទ បាកាន « ព្រះខ័ន កំពង់ស្វាយ » តំបន់ រនាម ដូន សំ តំបន់ សំបូរ ព្រៃ គុក តំបន់ បឹង លំកុដ តំបន់ ភ្នំ ក្រាំង ដី មាស និង តំបន់ បឹងយ៉ាក អោម - យ៉ាក ការ៉ា ។
សម្រាប់ តំបន់ ទេសភាព នេះ គឺ សម្បូរ ទៅ ដោយ ប្រាង្គ ប្រាសាទ បុរាណ សម្បត្តិ បេតិកភណ្ឌ វប្បធម៌ ព្រៃឈើ និង ធនធាន ធម្មជាតិ ជាច្រើន ទៀត ។
ទី៤៖ តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង ត្រូវ បែងចែក ជា ៨ តំបន់ ផ្សេង ៗ គ្នា និង មាន ផ្ទៃដី សរុប ៤១៥.៧៩៦ ហិកតា រួម មាន តំបន់ ដង ព្រែក តំបន់ សំឡូត តំបន់ ទន្លេ សាប តំបន់ ពញា ក្រែក តំបន់ ព្រែក ទឹក សាប ក្បាល ឆាយ តំបន់ ភ្នំ នាង កង្រី - ភ្នំ ទូក មាស តំបន់ សសរ ស្តម្ភ សត្វ តោ និង តំបន់ បឹងយក្ខឡោម ។
ទី៥៖ តំបន់ រ៉ាម សារ តំបន់ រ៉ាម សារ ត្រូវ បែងចែក ជា ៥ តំបន់ និង មាន ផ្ទៃ សរុប ៦០.៩៩៥ ហិកតា រួម មាន តំបន់ ស្ទឹងត្រែង តំបន់ កោះ កាពិ បឹង ទន្លេ ឆ្មារ តំបន់ ព្រែក ទាល់ និង តំបន់ ស្ទឹង សែន ។
ទី៧៖ តំបន់ បេតិកភណ្ឌ ធម្មជាតិ តំបន់ បេតិកភណ្ឌ ធម្មជាតិ នេះ ត្រូវ បែងចែក ជា ១១ តំបន់ ផ្សេង ៗ គ្នា និង មាន ផ្ទៃដី សរុប ៣៣.៩៥១ ហិកតា រួម មាន តំបន់ ភ្នំ ត្បែង តំបន់ ភ្នំ យ៉ាត តំបន់ ភ្នំ ប្រាំពីរ តំបន់ ជញ្ជាំង តំបន់ គិរី យង់ តំបន់ ភ្នំ ទាក់ ទ្រាំង តំបន់ ភ្នំ ព្រះនេត្រ ព្រះ តំបន់ ភ្នំ ព្រះ- ភ្នំ វែង តំបន់ ភ្នំ យាយ សំ តំបន់ ភ្នំ បាក់ និង តំបន់ ភ្នំ ស្វាយ ។
ទី៨៖ តំបន់ ឧទ្យាន សមុទ្រ តំបន់ ឧទ្យាន សមុទ្រ នេះ មាន ផ្ទៃដី សរុប ៥២.៤៤៨ ហិកតា គឺ តំបន់ សមុទ្រ កោះ រ៉ុង ។ ក្រៅពី នេះ ក៏ នៅ មាន តំបន់ អភិរក្ស ទឹក សាប បឹង ព្រែក ទប់ ដែល មាន ផ្ទៃដី សរុប ១.៦៣០ ហិកតា និង របៀង អភិរក្ស ជីវ ចម្រុះ ដែល មាន ផ្ទៃដី សរុប ១៤២.៧៩៤០ ហិកតា ។
ការបង្កើត ឱ្យ មាន តំបន់ ការពារ ទាំងអស់ នេះ របស់ រាជ រដ្ឋាភិបាល គឺ ក្នុង គោលបំណង កែប្រែ តំបន់ នានា ឱ្យ ក្លាយទៅជា តំបន់ បេតិកភណ្ឌ ធម្មជាតិ ភ្នំ លើកស្ទួយ តម្លៃ ទៅ លើ ប្រវត្តិសាស្ត្រ វប្បធម៌ ការអភិរក្ស ជីវ ចម្រុះ លើកស្ទួយ ជីវភាព ប្រជាពលរដ្ឋ និង វិស័យ ទេសចរណ៍ នៅ តំបន់ ទាំងនោះ ។
លោក នេត្រ ភក្ត្រា បាន បញ្ជាក់ ទៀត ថា ជាមួយ កិច្ច ខិតខំ ប្រឹងប្រែង ការពារ និង អភិរក្ស បាន ល្អ ក្រុមហ៊ុន បរទេស ធំ បាន ទិញ ឥណទាន កាបូន ពី កម្ពុជា ។ ចាប់តាំងពី ឆ្នាំ ២០១៦មក កម្ពុជា បាន លក់ ឥណទាន កាបូន ក្នុង ទីផ្សារ ស្ម័គ្រចិត្ត បាន ថវិកា ១១.៦ លាន ដុល្លារ អាមេរិក ដើម្បី យកមក ពង្រឹង ការងារ ការពារ និង អភិរក្ស ព្រៃឈើ និង អភិវឌ្ឍ សហគមន៍ មូលដ្ឋាន បង្កើត មុខរបរ និង ប្រាក់ ចំណូល ជូន ប្រជា សហគមន៍ ក សាង ជា របង ការពារ រឹងមាំ ការពារ តំបន់ ការពារ ធម្មជាតិ ផងដែរ ៕
ចាប់ វាយ ខ្នោះ ម្ចាស់ ខារ៉ាអូខេ « ពិភព តារ៉ារះ » នៅ ខណ្ឌ ពោធិ៍សែនជ័យ ក្រោយ លួច បើក អាជីវកម្ម មិន ស្ដាប់ ការណែនាំ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ម្ចាស់ ខារ៉ាអូខេ « ពិភព តារ៉ារះ » ដែល មាន ទីតាំង នៅ ខណ្ឌ ពោធិ៍សែនជ័យ ត្រូវ កម្លាំង នគរបាល ចាប់ វាយ ខ្នោះ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ចាត់ការ តាម ផ្លូវ ច្បាប់ ក្រោយ បន្ដ លួច បើក អាជីវកម្ម របស់ ខ្លួន មិន ស្ដាប់ តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ - ១៩ ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង នៅ យប់ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២១ នេះ ដឹកនាំ ដោយ លោក ហែម ដារិទ្ធ អភិបាល ខណ្ឌ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ពោធិ៍សែនជ័យ គ្រា ដែល លោក កំពុង ដឹកនាំ កម្លាំង ល្បាត ក្នុង មូលដ្ឋាន ហើយ ប្រទះឃើញ ខារ៉ាអូខេ មួយ នេះ លួច បើក ដំណើរការ និង មាន មនុស្ស ជាច្រើន ចូល ច្រៀង កម្សាន្ដ ។
ដោយឡែក ក្រៅពី ចាប់ វាយ ខ្នោះ ម្ចាស់ ទីតាំង ហើយ នោះ មនុស្ស ដែល នៅ គឃ្លើន ចូល ច្រៀង លេង សប្បាយ ដោយ មិន ខ្លាច ឆ្លង ជំងឺ កូវីដ - ១៩ ដែល កំពុង រីករាលដាល ក្នុង សហគមន៍ ចំនួន ១៥ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន បញ្ជូន ទៅកាន់ សាលា ខណ្ឌ ផងដែរ ដើម្បី ធ្វើ ការអប់រំ ណែនាំ ទើប អនុញ្ញាតឲ្យ ត្រឡប់ ទៅ ធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ រៀង ៗ ខ្លួន ។
អភិបាល ខណ្ឌ ពោធិ៍សែនជ័យ លោក ហែម ដារិទ្ធ បាន ប្រាប់ ភ្នាក់ងារ Fresh News ឲ្យដឹង បន្ថែម នៅ រសៀល ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២១ នេះ ថា រហូតមកដល់ រសៀល នេះ កម្លាំង នគរបាល ជំនាញ កំពុង កសាង សំណុំរឿង ដើម្បី បញ្ជូន ម្ចាស់ ទីតាំង ខារ៉ាអូខេ « ពិភព តារ៉ារះ » ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម ផ្លូវ ច្បាប់ ។
បន្ថែម ពី នេះ លោក ហែម ដារិទ្ធិ បាន ផ្ញើ សារ សារ ទៅកាន់ ក្រុម អ្នក រក ស៉ី នៅក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ ទាំងអស់ ត្រូវ អនុវត្ត តាម គោលការ របស់ អាជ្ញាធរ ដែល បាន ចុះ ទៅ ណែនាំ មិន ត្រូវ ប្រព្រឹត្ត ល្មើស ដែល នាំឲ្យ មាន ហានិភ័យ នោះ ទេ ជាពិសេស ហាង ខារ៉ាអូខេ បើ ហ៊ាន លួច លាក់ បើក ទៀត នោះ លោក នឹង ដឹកនាំ កម្លាំង ចុះ ទៅ ចាប់ វាយ ខ្នោះ ភ្លាម គ្មាន ការយោគយល់ ឡើយ ៕
ជន ឆបោក និង លួច លក់ ដី សហគមន៍ ម្នាក់ ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត កំពង់ឆ្នាំង ឃាត់ខ្លួន
( កំពង់ឆ្នាំង ) ៖ បុរស ម្នាក់ ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត កំពង់ឆ្នាំង ឃាត់ខ្លួន ពី បទ ឆបោក និង លួច លក់ ដី សហគមន៍ ក្នុង ឃុំ ប្រស្និប ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ។
ប្រតិបត្តិការ ចាប់ ឃាត់ខ្លួន នេះ បាន ធ្វើឡើង នៅ វេលា ម៉ោង ១៣៖០០ នាទី ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២១ នៅ ចំណុច ភូមិ ព្រៃ សំពៅ ឃុំ ប្រស្នឹប ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង និង បាន បញ្ជូន ទៅកាន់ ទី បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ដើម្បី ធ្វើ ការសាកសួរ ។
