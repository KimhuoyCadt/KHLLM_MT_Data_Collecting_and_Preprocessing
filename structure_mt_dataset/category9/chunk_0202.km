ដោយសារ ឯកសារ ខាងលើ នេះ យើង ដឹង ថា អ្នកស្រុក ភាគ ច្រើន ធ្វើ ស្រែ ចំការដាំ ស្រូវ ពោត ល្ងល្ពៅ ឃ្លោក ម្ទេស ត្រកួន ។
ថា រដ្ឋាភិបាល មិន គួរ ប្រើ អំពើហិង្សា លើ ពលរដ្ឋ ទេ ។
វា ទើប ត្រូវបាន សម្ពោធ ចេញ ក្នុង ព្រឹត្តិការណ៍ មួយ នៅឯ ទីក្រុ…
អត្ថាធិប្បាយ របស់ មន្ត្រី សិទ្ធិ មនុស្ស អ.ស.ប. នៅ កម្ពុជា អំពី ការចាប់ខ្លួន ថ្មី ៗ
ចាប់តាំងពី ដើម ខែកុម្ភៈ នេះ មក ទេសចរណ៍ នៅ ប្រទេស ថៃ បាន ធ្លាក់ចុះ ៤៣ ភាគរយ ។
ហេតុ ដូច្នេះ ភ្ញៀវ ទេសចរណ៍ អន្តរជាតិ ណា នៅពេល មក រដ្ឋធានី ហាណូយ ។
រដ្ឋាភិបាល អាល្លឺម៉ង់ ក៏ សម្តែង កង្វល់ ចំពោះ សង្គ្រាម ប្រឆាំង គ្រឿងញៀន នោះ ដែរ ៕
យោធា អាមេរិក បាន ឆ្លើយតប នឹង រុស្ស៊ី នា សប្តាហ៍ នេះ ដោយ …
តម្លៃ ប៉ុណ្ណឹង ល្មម ទិញ ជិះ ហើយ មាន វីដេអូ
ត្រូវ ទុក ដី សក្ការៈ នោះ មួយ ភាគ បួន ជា កម្មសិទ្ធិ របស់ ទីក្រុង ។
ទៀត គ្រាន់តែ ជួបប្រជុំ ជាមួយ អង្គ បោះឆ្នោត តាម ស្នាក់ការបក្ស ឬ នៅ ទីតាំង ឯកជន តែ ប៉ុណ្ណោះ ៕
បាន គ្រប់ យ៉ាង ដូចជា វត្ថុអនុស្សាវរីយ៍ និង សម្លៀកបំពាក់ ជាដើម ។
ពលករ ខ្មែរ អាច មាន លទ្ធភាព ទៅ បម្រើ ការងារ នៅ ប្រទេស អារ៉ាប៊ី សាអ៊ូឌីត
កាស្សែត ដើម អំពិល
ការចោទប្រកាន់ អាមេរិក គឺជា សម្តី របស់ លោក កឹម សុខា
គ្រឿង ក្នុង ជ្រូក នោះ សុទ្ធសឹង ជា របស់ មាន ជាតិ គីមី ទាំងអស់ ។
ដំណាក់កាល ទី២នឹង មាន ម៉ាស៊ីន រ៉េអាក់ទ័រ ចំនួន ២គ្រឿង ទៀត ដែល មាន អានុភាព ដូចគ្នា ៕
លើស ពី នោះ ទៀត ឯកឧត្តម វេង សា ខុន បាន ឱ្យដឹង ថា ភាគី ចិន នឹង អញ្ជើញ មក ត្រួតពិនិត្យ នូវ អ្វី ដែល កម្ពុជា ចង់ នាំចេញ ហើយ បើសិនជា គេ ពិនិត្យ ទៅ ឃើញ ហេដ្ឋាសម្ព័ន្ធ ក៏ ដូចជា ការចិញ្ចឹម ថែ បំប៉ន របស់ យើង បាន ល្អ គេ នឹង អនុញ្ញាត ។
ការចាប់ខ្លួន និង ការកាត់ទោស ពួកគេ ដែល ទទួលរង ការថ្កោលទោស ជាច្រើន ។
នៅនឹង កន្លែង ចំណែក អ្នកបើក ម៉ូតូ និង ក្មេងស្រី ម្នាក់ ទៀត អាយុ៣ ឆ្នាំ រងរបួស ស្រាល ។
ជា រួម ការចេញ អាល់ប៊ុម សុទ្ធ លើក នេះ មិន ធ្វើឱ្យ យើង ខកចិត្ត ទេ ។
កុំ ទៅ សង្កត់ធ្ងន់ លើ រឿង ការប្រកួត យក ចាញ់ ឈ្នះ ព្រោះ ក្មេង ម្នាក់ ៗ
ការងារ ដំណើរការ ទៅ មុខ ពុំ រ លូន ទាល់តែសោះ មាន បញ្ហា រាំងស្ទះ ច្រើន អណែក ។
អ៊ីចឹង ខ្ញុំ គិត ថា វា មិន ធ្ងន់ធ្ងរ អី ដល់ ថ្នាក់ បែកបាក់ ជាតិ នោះ ទេ ។
ខ្ញុំ បាន ស្តាប់ មក ហើយ ថា សេចក្តីនុ៎ះ ឯង ព្រះ មាន ព្រះភាគ បាន ត្រាស់ទុក ហើយ ។
ឌួង ហ្សូរីដា មិន មើល នឹង ភ្នែក ទេ ចុះ ទៅ ជួយ អ្នក គ្រោះថ្នាក់ ចរាចរណ៍ កណ្តាល ផ្លូវ
ក្នុង រយៈពេល សម ហេតុផល មួយ ឬ ដោះលែង ដោយ សម ហេតុផល ។
អត្ថបទ បន្ទាប់ ប៉ូលិស ហុងកុង ថា គ្រាប់បែក ដប សាំង ១០០ គ្រាប់ ត្រូវបាន ចោល ដោយ ក្រុម អ្នកតវ៉ា ហើយ ១៥០ នាក់ ត្រូវបាន ចាប់ខ្លួន
ចំណែក មនុស្ស ទី៣ត្រូវ ប៉ូលិស ចាប់ខ្លួន ។
ប្រេត ទាំងនោះ មាន មាត់ តូច ប៉ុន គូទ ម្ជុល មិន អាច បរិភោគ ចំណីអាហារ ដែល មាន ទំហំ ធម្មតា បាន ទេ ។
ទឹក អប់ យីហោ នេះ បាន ដាក់ លក់ ជាសាធារណៈ នៅ ឆ្នាំ ១៩៨១ប៉ុន្តែ នៅតែ បន្ត ល្បីល្បាញ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ។
ស្តេច កង់ ហ្គូរូ ដែល មាន ឈ្មោះ ល្បី ដោយសារ មាន សាច់ដុំ ធំ ពេលនេះ បាន …
របស់ ព្រះអង្គ អ្វី ទាំងអស់ នេះ គឺជា ការច្នៃប្រឌិត ដែល កើតឡើង នៅក្នុង សម័យ ហ័ង ទី ។
បឋម សោតា បន្ន សូត្រ ទី២
អូស្ត្រាលី នឹង បិទ ស្ថានទូត របស់ ខ្លួន នៅក្នុង ប្រទេស អាហ្គានីស្ថាន
តែ ថ្ងៃ មួយ ខ្ញុំ បាន ធ្វើ ការសម្រេចចិត្ត យ៉ាង ច្បាស់ ដោយ ដាក់កំហិត ខ្លួន ឯង ថា ខ្ញុំ ត្រូវតែ មាន ទំនួល ខុសត្រូវ និង បង្កើត ចក្ខុវិស័យ មួយ សម្រាប់ ខ្លួន ឯង ។
នេះ ជា ការផ្សាយ របស់ សារព័ត៌មាន ក្នុង ស្រុក ។
លោកស្រី ទេព វន្នី បាន បញ្ជាក់ ថា ការទាមទា ប្រឆាំង នឹង ការបណ្តេញ ចេញ ធ្វើឱ្យ ស្ត្រី ប្រឈមមុខ នឹង ការប្រថុយប្រថាន ជាច្រើន ៖
ចលនា និស្សិត ក្រៅ ប្រទេស ៖
ការឧបត្ថម្ភ ជា៣ ដំណាក់កាល
តើ ពេលណា តុលាការ កម្ពុជា អាច មាន លទ្ធភាព កាត់ទោស មន្ត្រី ដូច អ៊ុយក្រែន ?
ទាំង បួន លើក កន្លងមក នេះ ត្រូវបាន ទទួល ការវិនិច្ឆ័យ ថា កាន់តែ មាន ភាព សេរី និង ត្រឹមត្រូវ ជាង ការបោះឆ្នោត មុន ៗ
កីឡាករ ជីម ចិត្ត្រា ត្រូវបាន កណ្តាល រាប់ ក្រោយពី កីឡាករ ថៃ វាយ ឱ្យ សន្លប់ ។
ភ្ញៀវ ទេសចរ អន្តរជាតិ ដែល ចូលមក ទស្សនា កម្ពុជា នៅតែ មាន កំណើន ក្រោយ ការបោះឆ្នោត
រីឯ វិជ្ជា សម្រាប់ វិទ្យាសាស្ត្រ សង្គម ។
ពិសេស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខាងមុខ នេះ ក្រសួង នឹង អនុញ្ញាតឱ្យ បងប្អូន បាន ចូលទៅ កំសាន្ត ៕
ជា រុក្ខជាតិ ដែល ងាយស្រួល ដាំ និង មិន ចាំបាច់ ថែទាំ ច្រើន ឡើយ ។
មក ពាក្យ ហ្នឹង ក្លាយទៅជា បន្ទិត រួចត មក
ខាងក្រោម នេះ ជា សេចក្តីពន្យល់ លម្អិត នៃ ពាក្យ ទាំង បី ៖
តំណាង សហជីព ទូទាំង ប្រទេស នឹង កៀង គរ កម្មករ តាម រោងចក្រ នីមួយ ៗ
ដើម បណ្តឹង រដ្ឋប្បវេណី មិន ពេញចិត្ត នឹង សម្ពាធ ច្បាប់ របស់ តុលាការ ខ្មែរ ក្រហម
ឌីវីន និយាយ ថា វា ពិតជា ពិបាក មែនទែន ។
របស់ កងទ័ព អាមេរិក គឺជា មីស៊ីល ប្រឆាំង មីស៊ីល ឆ្លង ទ្វីប ចម្ងាយ មធ្យម ដែល មាន ល្បឿន យឺត ។
បាទ ពិតជា គំនិត សុទិដ្ឋិនិយម មែន !
គេ ត្រូវ គោរព តាម ពាក្យសន្យា ជាមួយ ប្រពន្ធ កូន ។
នេះ ជា សញ្ញា បង្ហាញ ថា ស្ថានភាព វិល ទៅរក ការចរចា ផ្នែក នយោបាយ ឡើងវិញ ហើយ ។
ការប៉ុនប៉ង របស់ អាមេរិក ដើម្បី ទប់ ចិន ដោយ ប្រើ បញ្ហា ស៊ីន ជាំង នឹង ត្រូវ បរាជ័យ
អ្នកនាង ហ៊ុល កុល ធីតា បច្ចេកទេស និង បញ្ចូល សូរស័ព្ទ ដោយ ៖
