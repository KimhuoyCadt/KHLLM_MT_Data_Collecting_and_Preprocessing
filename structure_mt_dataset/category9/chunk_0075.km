ហើយអដ្ឋិធាតុទាំងនោះត្រូវបានគេកប់ជាមួយនឹង វត្ថុទាំងនោះ ។
ស៊ីឌី តំណាង ឱ្យ ឌីសបង្រួម ។
មនុស្ស តែងតែ និយាយ អំពី បញ្ហា ។
វិវរណៈ 14:10 10 គាត់ក៏នឹងផឹកស្រានៃសេចក្ដី ក្រោធរបស់ព្រះ ដោយចាក់ពេញក្នុងពែងនៃកំហឹងរបស់គាត់ ហើយគាត់នឹងត្រូវរងទុក្ខដោយភ្លើង និងស្ពាន់ធ័រ នៅចំពោះមុខទេវតាបរិសុទ្ធ និងនៅចំពោះមុខកូនចៀម ។
ប្រជាជាតិចិនមានចំនួន ៥៦
មានជនជាតិស៊ែប៊ី ជាច្រើននាក់ដែលមិនបានរៀនអ្វីពីប្រវត្តិសាស្ត្រ ។
ប្រហែលជា ត្រូវការ ដក ចេញ ឬ ខ្លះ
មនុស្ស ជាច្រើន និយាយ មក ខ្ញុំ ថា " អាល់ប៊ុម របស់ អ្នក បាន ទទួល
ជាថ្មី ម្តង ទៀត សម្លាប់ ពួកគេ ដោយ សេចក្តីសប្បុរស ។
អ្វីដែលឪពុកនាងបានធ្វើចំពោះគ្រួសាររបស់អ្នក នោះគឺមិនអាចនិយាយបានឡើយ ។
របៀប មិន នៅជិត ។
បើអ្នក រាល់គ្នាប្រាថ្នាចង់បានគ្រប់លក្ខណ៍ ចូរទៅលក់ទ្រព្យ សម្បត្តិរបស់ខ្លួន ហើយឲ្យប្រាក់ដល់ជនក្រីក្រ នោះអ្នកនឹងបានទ្រព្យ សម្បត្តិនៅស្ថាន សួគ៌ ។ បន្ទាប់មក មក តាម ខ្ញុំ ។
នៅឯ កិច្ចប្រជុំ របស់ ពួកគេ កាលពី ដើម ខែ នេះ គាត់ នៅ ម្នាក់ឯង រយៈពេល ពីរ សប្តាហ៍ ។
អ្នក ផ្តល់ អាជ្ញាប័ណ្ណ ត្រូវ ទទួលខុសត្រូវ តាម មធ្យោបាយ ណាមួយ ចំពោះ ខ្លឹមសារ ណាមួយ ដែល បង្កើតឡើង ដោយ ឬ
ម៉េចគេមិនឆ្អែតដូចខ្ញុំ ?
តើ អ្នក បាន សាកល្បង គំនិត ខ្លះ ដើម្បី ដោះស្រាយ បញ្ហា ទេ ?
សន្តិភាពបាននាំ មកដល់ផ្លូវ។
ខាងលើ ខ្ញុំ ចេញពី ភាពយឺតយ៉ាវ ។
អ្នក ផ្តួលរំលំ រដ្ឋាភិបាល ដោយ កម្លាំង ។
និយាយតាមត្រង់ទៅ អ្នកចំណាយពេលមួយម៉ឺនឆ្នាំព្យាយាមបំផ្លាញប្រព័ន្ធ ហើយវាក៏ទៅបំផ្លាញខ្លួនឯង !
ពួកគេ មើល ទៅ ហាក់ដូចជា ដៃ ស្លាប់ កាន់តែ ច្រើន ឡើង ៗ ។
ប្រព័ន្ធ ពន្ធនាគារ រយៈពេល ដប់ ប្រាំ ឆ្នាំ ។
« សូមឲ្យខ្ញុំមានចម្ការទំពាំងបាយជូររបស់អ្នកសម្រាប់ធ្វើសួនបន្លែ ព្រោះវានៅជិតវាំងរបស់ខ្ញុំ ។
ដំបូង មើល កន្សែង ចេញ ជា បួន នៅពេល វា គ្រប់គ្រាន់ ។
អ្នក ប្រយុទ្ធ តាលី បង់ រាប់ រយ នាក់ ត្រូវបាន សម្លាប់
សាតាំងត្រូវបានលេបចូលដោយអំណាចនៃព្រះ» ។
បានប្រព្រឹត្តនឹងសិក្ខាបទទាំងនេះ ហើយបានតម្កល់នៅគ្រប់មុខតំណែងដែលខ្លួន កាន់ ។
គ្មាន ការសង្ស័យ ទេ ក្មេងប្រុស ទាំង នេះ គឺជា ព្រះដែល ដើរ ក្នុង ចំណោម បុរស ។
ជា លទ្ធផល នគរ របស់ គាត់ បាន បែកបាក់
រាស្ដ្រ របស់ ព្រះនឹង រង ទុក្ខ ។
យើង បង្កើត អាលី យ៉ាពី ទីនោះ ។
" ប្រសិនបើ អ្នក ចង់ រំលោភ លើ អធិបតេយ្យភាព និង សេចក្តីថ្លៃថ្នូរ របស់ ប្រទេស ចិន ជាមួយនឹង វិវាទ មិន រើសអើង និង ជំរិត យក ផល នៃ ការខិតខំ របស់ ប្រជាជន ចិន ខ្ញុំ ខ្លាច ថា នេះ ជា សុបិន្ត មួយ ហើយ អ្នក នឹង ធ្វើឱ្យ ខ្លួន ឯង អាម៉ាស់ " ។
ខ្ញុំមាន ចិត្តរីករាយដោយបានជួបមនុស្ស អស្ចារ្យទាំងនេះ » ។
អូសាម៉ា ប៊ីន ឡាដិន នៅតែ ធំ ហើយ ដំណើរ ស្វែងរក គាត់ នឹង មិន ឈប់ ទេ ។
នាង តែងតែ ស្រលាញ់ ភាសា អង់គ្លេស ប៉ុន្តែ មាន សញ្ញាបត្រ ផ្នែក ភាសា ។
វិធី បង់ប្រាក់ ថ្មី នេះ នឹង ផ្សាយ ផ្ទាល់ នៅ ថ្ងៃទី 1 ខែមីនា ។
ហេតុ អ្វី បានជា បេះដូង របស់ អ្នក វង្វេង ?
វា ជា ការត្រឹមត្រូវ ក្នុង ការទាក់ទាញ ។
មាន អ្វី ដែល ត្រូវ ប្រាប់ កូន របស់ អ្នក ដោយ មោទនភាព ។
នឹងទទួលបានអ្នកដែលដឹងថាតើវាត្រឹមត្រូវឬមិនត្រឹមត្រូវ។
ត្រូវ ប្រាកដ ថា ផ្តល់ឱ្យ ពួកគេ នូវ ការណែនាំ ច្បាស់លាស់ ដើម្បីឱ្យ ពួកគេ ស្ថិត នៅលើ ប្រធានបទ និង ដឹង ច្បាស់ ពី អ្វី ដែល ពួកគេ រំពឹងទុក ។
ថើប ដោយ ភ្លើង នៅ ពេលល្ងាច
ចុះក្រុមខ្ញុំចង់ដឹង ។
" ការ ដែលអាចនិយាយជាមួយគាត់អំពី វាមានប្រយោជន៍សម្រាប់ខ្ញុំព្រោះគាត់ដឹងពីការងារ " ។
១៤ « ដ្បិតយើងបានឮគាត់និយាយថា ព្រះ យេស៊ូ ជាអ្នកស្រុក ណា សា រ៉ែតនឹងបំផ្លាញកន្លែងនេះ ហើយផ្លាស់ប្ដូរទំនៀម ទម្លាប់ដែលម៉ូសេ បានប្រគល់មកយើង » ។
បង្កើត ពេលវេលា សម្រាប់ មិត្តភ័ក្តិ របស់ អ្នក ទោះបីជា អ្នក មាន ពេល ត្រឹមតែ ក្រេប កាហ្វេ រហ័ស មួយ កែវ ម្តង ក្នុង មួយ សប្តាហ៍ ក៏ដោយ ។
មើល ផ្ទះរបស់ឯងត្រូវទុកឲ្យឯងស្ងាត់សូន្យឈឹង ។ * សម្រាប់ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា អ្នកនឹងមិនឃើញខ្ញុំទៀតទេ រហូតដល់អ្នក និយាយថា “ អ្នកដែល មកក្នុងព្រះ‌នាមព្រះ‌ អម្ចាស់មាន ពរហើយ ” ។ '
ដូច្នេះអ្នក និយាយថា " អ្នក រាល់គ្នា " ខុសហើយ ។
យើង ថ្វាយបង្គំ ព្រះជាបិតា របស់ យើង ដែល គង់ នៅ ស្ថាន សួគ៌ ក្នុង ព្រះរាជ បុត្រា របស់ ទ្រង់ ដោយ ព្រះវិញ្ញាណ បរិសុទ្ធ របស់ ទ្រង់ និង តាមរយៈ ព្រះបន្ទូល នៃ ព្រះ ( ព្រះគម្ពីរ ) និង សាក្រាម៉ង់ ។
អ្នកនិពន្ធ អត្ថបទ ។
ប៉ុន្តែការពិតគឺថា ព្រះ មិនលុបចោលនូវ ផល វិបាកទាំងអស់នៃអំពើ បាបទេ ។
សូរ៉ូសចងចាំថា « ជំនួស ឱ្យការចុះ ចូលនឹងជោគវាសនារបស់យើង យើងបានទប់ទល់នឹង កម្លាំងអាក្រក់ដែលខ្លាំងជាងយើង ប៉ុន្តែយើងបានយកឈ្នះ។
ខ្ញុំគិតថានឹងក្លាយទៅ ជារបៀបដែលពិភពលោកជក់ ចិត្តនឹងរូបរាង
សាច់ ទាំងអស់ គឺ ដូចជា ស្មៅ ។
អ្វី ៗទាំងអស់ត្រូវបានសម្អាតដោយឈាម ហើយបើគ្មានការ បង្ហូរឈាម នោះក៏គ្មានការ អភ័យទោសដែរ ។
ព្រះអម្ចាស់ អើយ សូម ឱ្យ ទូលបង្គំ ធ្វើជា ឧបករណ៍ នៃ សេចក្តីអំណរ ។
នោះជា វិធីដែលបង្ហាញឱ្យឃើញក្នុងការ ប្រើលុយ
ម្រាម ដៃ ផ្លាស់ទី គឺ រីករាយ ណាស់ ។
ពួកគេសុខ ចិត្ត បម្រើ ទោះបីជាយ៉ាងណា ។
ដូច្នេះ ពួកគេ អាចនឹង ជាសះស្បើយ ។
គាត់មិនបានត្រៀមខ្លួនរួចរាល់ដើម្បីស្តាប់ ពីគ្រីស្ទានម្នាក់ដែលដឹងថាគាត់មិនល្អឥត ខ្ចោះទេ ។
មិន មាន ម៉ោង គ្រប់គ្រាន់ ក្នុង មួយ ថ្ងៃ ដើម្បី ដោះស្រាយ នាង ។
រហូតដល់ អ្នក អាច មើលឃើញ កូន ដែល មិន ទាន់ កើត របស់ អ្នក នៅក្នុង នាង ។
