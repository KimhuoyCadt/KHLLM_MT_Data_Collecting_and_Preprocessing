( មណ្ឌលគិរី ) ៖ នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ លោក ឈួន វិន ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត មណ្ឌលគិរី បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ហែរ ក្បួន បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភាព នីតិកាល ទី៥ ឆ្នាំ ២០២៤ នីតិកាល ទី៥ នៅ ក្រុង សែនមនោរម្យ ។
បន្ថែម ពីលើ នេះ លោក បាន គូសបញ្ជាក់ ពី តួនាទី ស្នូល របស់ គណបក្ស ប្រជាជន កម្ពុជា ជា គណបក្ស នយោបាយ តែ មួយ គត់ ដែល បាន នាំមក នូវ សុខ សន្តិភាព ពេញលេញ និង អភិវឌ្ឍ ជាតិ ឲ្យ រីកចម្រើន ដូច សព្វ ថ្ងៃ នេះ និង គ្មាន គណបក្ស ណាមួយ អាច មក ជំនួស តួនាទី នេះ បាន ឡើយ ។ លោក បាន បន្ថែម ថា គណបក្ស ប្រជាជន កម្ពុជា នៅ រួម សុខ រួម ទុក្ខ គ្រប់ កាលៈទេសៈ ជាមួយ ប្រជាជន និង បម្រើ ផលប្រយោជន៍ ប្រជាជន ជានិច្ច ។
សូម ជម្រាប ថា ខេត្ត មណ្ឌលគិរី ស្ថិត នៅ មណ្ឌល ភូមិភាគ ទី៨ ដែល មាន ៦ ខេត្ត និង មាន បេក្ខជន ឈរឈ្មោះ បោះឆ្នោត របស់ គណបក្ស ប្រជាជន កម្ពុជា ចំនួន ១២រូប ( ស្ត្រី ២រូប ) ជា បេក្ខភាព សមាជិក ព្រឹទ្ធសភា ដែល មាន លោក នាង ផាត ជា ប្រធាន ភូមិភាគ ។ ការបោះឆ្នោត ព្រឹទ្ធសភា នេះ ជា ការបោះឆ្នោត អសកល ប៉ុន្តែ ពិតជា មាន សារៈសំខាន់ ដ៏ ធំធេង និង ជា ការពង្រឹង ដំណើរការ ប្រជាធិបតេយ្យ និង នីតិរដ្ឋ នៅ កម្ពុជា ៕
( ភ្នំពេញ ) ៖ លោកស្រី ឧកញ៉ា កែវ មុំ ប្រធាន សភា មុខរបរ និង មីក្រូស ហគ្រាស កម្ពុជា បាន ប្រាប់ អំពី វិធីសាស្ដ្រ ដើម្បីឲ្យ ស្ដ្រី អភិវឌ្ឍន៍ អាជីវកម្ម របស់ ខ្លួន បាន កាន់ ឲ្យ តែ រីកចម្រើន ដែល ទាមទារ ឲ្យ មាន ការលើកទឹកចិត្ដ ពី ស្វាមី ក៏ ដូចជា ក្រុមគ្រួសារ ។
លោកស្រី ឧកញ៉ា កែវ មុំ បាន លើកឡើង ថា « ដើម្បីឲ្យ ស្ដ្រី ចូលរួម អភិវឌ្ឍន៍ សេដ្ឋកិច្ច របស់ គាត់ ឲ្យបាន កាន់តែ ធំ ឡើង ក៏ ត្រូវការ បុរស ដែល ជា ស្វាមី ឬ ក៏ ក្រុមគ្រួសារ ត្រូវ លើកទឹកចិត្ដ និង ជួយ ជំរុញ ធ្វើ ម្ដេច ឲ្យ ស្ដ្រី មាន ពេលវេលា គ្រប់គ្រាន់ ក្នុង ការចូលរួម វគ្គ បណ្ដុះបណ្ដាល ផ្សេង ៗ ពង្រឹង សមត្ថភាព និង ចំណេះដឹង ថ្មី ៗ ផ្សេង ៗ »៕
Safe home ក៏ មាន ជាង ជា បុគ្គលិក ផ្ទាល់ មាន ជំនាញ ច្បាស់លាស់ សុទ្ធសឹងតែង មេ ជាង មាន បទពិសោធន៍ ជាច្រើន ឆ្នាំ មាន ភាពទំនួល ខុសត្រូវ ជាមួយនឹង រចនាបថ ស្អាត ។ ដើម្បី ជៀសវាង ក្រុមហ៊ុន មួយចំនួន យក ជាង ពី ខាងក្រៅ ធ្វើ ជូន ដោយ គ្មាន ទំនួល ខុសត្រូវ និង សេវាកម្ម ល្អ សូម ជ្រើសរើស នៅ ទីនេះ ខណៈ ក្រុមហ៊ុន ក៏ ទទួល ចែកចាយ នូវ ផលិត ល្អ បំផុត ពី រោងចក្រ ផ្ទាល់ ផងដែរ ។
( ភ្នំពេញ ) ៖ លោកស្រី ឧកញ៉ា កែវ មុំ ប្រធាន សភា មុខរបរ និង មីក្រូស ហគ្រាស កម្ពុជា បាន បញ្ជាក់ ឲ្យដឹង ថា អាជីវកម្ម ក្រៅ ប្រព័ន្ធ ភាគ ច្រើន គឺ ខ្នាត មីក្រូ និង ខ្នាត តូច ភាគ ច្រើន មិន បាន កត់ត្រា ចំណូល - ចំណាយ - ចំណេញ ដែល ពិបាក ក្នុង ការទទួល កម្ចី ។
ស្ថានទូត ជប៉ុន រៀបចំ មហោស្រព គីហ្សូណា ជប៉ុន - កម្ពុជា ២០២៤
( ភ្នំពេញ ) ៖ ស្ថានទូត ជប៉ុន សហការ ជាមួយ មជ្ឈមណ្ឌល សហប្រតិបត្តិការ កម្ពុជា - ជប៉ុន (CJCC) និង ការិយាល័យ ទំនាក់ទំនង ភ្នំពេញ នៃ មូលនិធិ ជប៉ុន បាន រៀបចំ មហោស្រព គីហ្សូណា ជប៉ុន - កម្ពុជា ២០២៤ ដើម្បី អបអរសាទរ ខួប លើក ទី៧០ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង ពីរ កាលពី ឆ្នាំ មុន ។
ពិធី នេះ ធ្វើឡើង នៅ សាល អង្គរ - គីហ្សូណា ក្នុង CJCC ដោយ មាន ការចូលរួម ពី លោក តា និណៃ អ៊ិឈិ តុម៉ុ ឧបទូត នៃ ស្ថានទូត ជប៉ុន ប្រចាំ កម្ពុជា លោក បណ្ឌិត សភាចារ្យ ហង់ ជួនណារ៉ុន ឧប នាយក រដ្ឋមន្ត្រី និង រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា . លោកស្រី ប៉ែន មុនីមក រា រដ្ឋលេខាធិការ ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ព្រមទាំង មន្ត្រីរាជការ និង ភ្ញៀវ កិត្តិយស ជាច្រើន ទៀត ។
លោក តា និណៃ អ៊ិឈិ តុម៉ុ ឧបទូត បាន ថ្លែង ថា ក្នុង រយៈពេល ប្រារព្ធ ខួប លើក ទី៧០ កម្មវិធី នានា ច្រើន ជាង ៧០ ដែល ឆ្លុះបញ្ចាំង ពី មិត្តភាព ជប៉ុន និង កម្ពុជា ត្រូវបាន ប្រារព្ធ ឡើង តែ នៅក្នុង ប្រទេស កម្ពុជា និង មាន អ្នកចូលរួម ជាច្រើន ។ តាមរយៈ កម្មវិធី ទាំងនោះ យើង បាន បណ្តុះបន្ថែម នូវ ការយល់ដឹង ពី គ្នា ទៅ វិញ ទៅ មក ហើយ ជា លទ្ធផល មិត្តភាព នៃ ប្រទេស យើង ទាំង ពីរ កាន់តែ ជិតស្និទ្ធ ជាង ពេល ណា ៗ ទាំងអស់ ។
លោក បាន បន្ដ ថា ចាប់តាំងពី ឆ្នាំ ២០២៤ បាន ចាប់ផ្តើម យើង បាន អបអរសាទរ ខួប លើក ទី២០ នៃ ការបង្កើត មជ្ឈមណ្ឌល សហប្រតិបត្តិការ កម្ពុជា - ជប៉ុន (CJCC) ដែល បង្កើត ដំបូង ក្នុង ឆ្នាំ ២០០៤ ក្រោម ការជួយគាំទ្រ ដោយ រដ្ឋាភិបាល ជប៉ុន ។ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ចូលរួម កម្មវិធី សម្ពោធ នា ពេល នោះ និង បាន បង្ហាញ ពី ចំណាប់អារម្មណ៍ ការរំពឹងទុក របស់ សម្តេច សម្រាប់ ការអភិវឌ្ឍ នៃ CJCC ។
សម្តេច តេជោ ហ៊ុន សែន អំឡុង ទៅ សួរសុខទុក្ខ លោក ថាក់ ស៊ីន អតីត នាយក រដ្ឋមន្រ្តី ថៃ ដែល ជា បង ធម៌ របស់ សម្តេច កាលពី ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន អញ្ជើញ លោកស្រី អ៊ុង អ៉ីង ប្រធាន គណបក្ស ដឹកនាំ រដ្ឋាភិបាល ថៃ មក បំពេញ ទស្សនកិច្ច ដើម្បី រឹត ចំណង មិត្តភាព រវាង គណបក្ស នយោបាយ ទាំង ពីរ ហើយ លោកស្រី ក៏ បាន យល់ព្រម ភ្លាម ៗ ផងដែរ ។
តាមរយៈ សេចក្តីប្រកាស . គណបក្ស ប្រជាជន កម្ពុជា បាន បញ្ជាក់ ថា ការផ្លាស់ប្តូរ ទស្សនកិច្ច ជាន់ ខ្ពស់ រវាង គណបក្ស ទាំង ពីរ នេះ គឺ ក្នុង គោលបំណង ផ្លាស់ប្តូរ យោបល់ លើ កិច្ចសហ ប្រតិបត្តិការ នៃ ប្រទេស ជាប់ ភូមិ ផង របង គ្នា ដើម្បី បម្រើ ផលប្រយោជន៍ រួម របស់ ប្រជាជន និង គណបក្ស ទាំង ពីរ ដោយ ផ្អែក លើ ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ជិតស្និត រវាង គណបក្ស ទាំង ពីរ ។
( សៀមរាប ) ៖ លោក កុត គល់ ហេរញ្ញិក គណៈកម្មាធិការ ប្រតិបត្ត គណបក្ស ភ្លើង ទៀន ស្រុក អង្គរ ធំ ខេត្ត សៀមរាប បាន គោរព ស្នើសុំ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក យល់ឃើញ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ប៉ុណ្ណោះ ដែល ខិតខំ ប្រឹងប្រែង ដើម្បី ជាតិ និង ប្រជាជន ៕ ការអនុវត្ត បទបញ្ជា សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឲ្យ ត្រួតពិនិត្យ ទីតាំង ល្បែង ផ្សង សំណាង នៅ ខេត្ត កំពង់ចាម មាន ប្រសិទ្ធិភាព ខ្លាំង
( ភ្នំពេញ ) ៖ ល្បែង ផ្សង សំណាង គ្មាន ច្បាប់ អនុញ្ញាត បាន វាយលុក ក្នុង មូលដ្ឋាន ទូទាំង ប្រទេស កម្ពុជា ដែល ជា បញ្ហា មួយ នាំ ជា ការបង្ក អសន្តិសុខ ក្នុង សង្គម និង ធ្វើឲ្យ មាន រូបភាព មិន ល្អ ពីសំណាក់ អ្នកទេសចរ ផងដែរ ។ ល្បែង ផ្សង សំណាង ក៏ ត្រូវបាន គេ ចាត់ទុក ថា ជា អំពើ អបាយ មុខ ដែល នាំឲ្យ អ្នក លេង វា នឹង វិនាស ជាក់ ជា ពុំ ខាន ។
ដោយ មើលឃើញ ភាពអវិជ្ជមាន បែប នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី កម្ពុជា នៅ ថ្ងៃទី ១៤ ខែកុម្ភៈ ឆ្នាំ ២០២៤ កន្លងទៅ បាន ចេញ សារ សម្លេង ជា បទបញ្ជា ឲ្យ អភិបាល រាជធានី - ខេត្ត ទូទាំង ប្រទេស ត្រួតពិនិត្យ ជាបន្ទាន់ លើ ទីតាំង ល្បែង ផ្សង សំណាង ក្នុង ករណី មាន បន្ត បើក ថ្មី ទៀត ត្រូវ ចាត់ វិធានការបិទ ជាបន្ទាន់ និង រាយការណ៍ ផ្ទាល់ ជូន សម្តេច ។
ក្រោយ បទបញ្ជា របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អភិបាល រាជធានី - ខេត្ត ក៏ បាន ចេញ ប្រតិបត្តិការ យ៉ាង យកចិត្តទុកដាក់ និង ទទួលខុសត្រូវ លើ ដែន សមត្ថកិច្ច របស់ ខ្លួន ។ ចំពោះ ខេត្ត កំពង់ចាម ការអនុវត្ត បទបញ្ជា សម្តេច ធិបតី មាន ប្រសិទ្ធភាព យ៉ាង ខ្លាំង ដោយ គិត មកដល់ ពេលនេះ ទីតាំង ល្បែង ផ្សង សំណាង ៤៩២ ទីតាំង នៅក្នុង ខេត្ត នេះ ត្រូវបាន បិទ និង មិន មាន ទីតាំង ណា លួច បើក ទៀត ឡើយ ។
លោក អភិបាល ខេត្ត ក៏ បាន ណែនាំ គណៈ អភិបាល ក្រុង - ស្រុក ឱ្យ តាមដាន មើល ជាប្រចាំ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន លើ បញ្ហា នេះ និង ត្រូវ ធ្វើ បច្ចុប្បន្នភាព មួយ ខែ ម្ដង ដើម្បី គ្រប់គ្រង បញ្ហា ល្បែងស៊ីសង នេះ នូវ ទីតាំង ដែល បាន បិទ ដោយ ធានា ថា មិន ឲ្យ មាន ការលួច បើក ក្រោយ បាន បិទ ទាំងស្រុង រួចហើយ ។
នៅ រសៀល ថ្ងៃទី ១៤ ខែកុម្ភៈ និង នៅ ថ្ងៃទី ១៥ ខែកុម្ភៈ រដ្ឋបាល ខេត្ត កំពង់ចាម បាបិទ ទីតាំង ល្បែង ផ្សង សំណា ៤០៦ ទីតាំង ក្នុង នោះ មាន ទីតាំង មួយចំនួន បាន ស្ម័គ្រចិត្ត បិទ ដោយ ខ្លួន ឯង ផងដែ ។ ដោយសារ ការអនុវត្ត បទបញ្ជា សម្តេច ធិបតី យ៉ាង យកចិត្តទុកដាក់ ទើប ខេត្ត បាន បន្ត បិទ រហូតដល់ ៤៩២ ទីតាំង បើ គិត ដល់ ពេលនេះ ។
ប្រសិទ្ធភាព នៃ ការអនុវត្ត បទបញ្ជា សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឲ្យ ត្រួតពិនិត្យ ទីតាំង ល្បែង ផ្សង សំណាង នៅ ខេត្ត កំពង់ចាម ត្រូវបាន លោក បណ្ឌិត យង់ ពៅ អ្នកតាមដាន នយោបាយ និង សង្គម អបអរសាទរ ។ លោក បណ្ឌិត ថែមទាំង បាន លើកទឹកចិត្ត ឲ្យ បិទ ល្បែង ខុស ច្បាប់ ដោយ ធ្វើជា ប្រចាំ និង មិន មែន ធ្វើ ដើម្បី តែ ថត បង្ហាញ ក្នុង មួយ ខណៈពេល ឡើយ ។
ការបង្ក្រាប ល្បែង ផ្សង សំណាង ខុស ច្បាប់ ត្រូវបាន លោកស្រី បណ្ឌិត ព្រុំ ទេវី អ្នកស្រាវជ្រាវ ផ្នែក សេដ្ឋកិច្ច យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ។ លោកស្រី បាន អង្កេតឃើញ ថា មាន ម្ចាស់ អាជីវកម្ម មួយ ចំនួន បើក អាជីវកម្ម ល្បែង ផ្សង សំណាង ដោយ យក រឿង សេដ្ឋកិច្ច ក្រៅ ផ្លូវការ ធ្វើជា លេស ។
លោកស្រី បាន បន្ត ថា « ឧទាហរណ៍ ការកើតឡើង កន្លងមក ដូចជា ហូប ស្រា ទៅ ពុល ហើយ ស្រា នោះ នរណា អ្នកលក់ គឺ អ្នករកស៊ី ក្រៅ ប្រព័ន្ធ ។ អ្នកផលិត ស្រា ក្រៅ ប្រព័ន្ធ បើសិនជា មាន បញ្ហា ចាំ ផ្តើម ជ្រួលច្របល់ ។ មាន ស្លាប់ មាន អី អីចឹង ទៅ ដែល យើង ធ្លាប់ ឃើញ ក៏ប៉ុន្តែ វា ចាំ តែ មាន ហើយ គ្រប់ មុខ ទាំងអស់ ហើយ យើង ធ្វើ អ្វី អត់ ចេញ ទេ ។ រាជ រដ្ឋាភិបាល យើង នៅ អនុញ្ញាតឲ្យ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ដំណើរការ យើង ធូរ ៗ ដើម្បីឲ្យ អ្នក មាន ដើមទុន តិច គ្នា អាច ចិញ្ចឹម ជីវិត បាន » ។
លោកស្រី បណ្ឌិត បាន លើក ពី ការសិក្សា ថា កាល ជំនាន់ កូវីដ១៩ លោកស្រី បង្រៀន អនឡាញ ហើយ មាន និស្សិត ម្នាក់ ពុំ សូវ រៀន ទេ ។ ក្រោយមក នៅពេល សួរនាំ ទៅ និស្សិត នោះ ប្រាប់ ថា គាត់ ធ្វើការ ឲ្យ ក្រុមហ៊ុន មួយ លក់ ទូរសព្ទ ជជុះ មួយ កន្លែង ហើយ ទោះជា ពេល បិទ ខ្ទប់ បែប នោះ ក៏ មួយ ថ្ងៃ អាច លក់ បាន តិច បំផុត ១០០ គ្រឿង ដែរ ខណៈ អ្នកទិញ គឺ ជនជាតិ ចិន ដែល មិន ប្រើ ទូរសព្ទ ថ្មី ៗ ឡើយ និង ម្នាក់ ៗ ប្រើ ដល់ ទៅ ៨ គ្រឿង ឡើង ទៅ ។
លោកស្រី បណ្ឌិត បាន បន្ថែម ថា និស្សិត នេះ ជា បុគ្គលិក ក្នុង ហាង លក់ ទូរសព្ទ មិន ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ទៅ ណា ឡើយ ព្រោះ បាយ និង ទឹក មាន អ្នកផ្គត់ផ្គង់ ជាស្រេច ។ និស្សិត នេះ ដែរ ជា មនុស្ស តែ ម្នាក់ ដែល មាន សិទ្ធិ ទៅ យក ពី អ្នកបោះ ដុំ ហេតុ នេះ មាន ន័យ ថា អ្នក រកស៊ី អនឡាញ មិន ផ្លូវការ មាន ច្រើន ណាស់ ។
បទបញ្ជា របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឲ្យ ត្រួតពិនិត្យ ទីតាំង ល្បែង ផ្សង សំណាង ទូទាំង ប្រទេស បន្ទាប់ពី តារា កំប្លែង នាយ គ្រឿង បាន ច្រៀង និង ផលិត វីដេអូ ចម្រៀង ដើម្បី ផ្សព្វផ្សាយ ឲ្យ មហាជន លេង ល្បែង អនឡាញ ។ ដោយសារ ប្រតិកម្ម ខ្លាំង ៗ ពី អ្នកជំនាញ និង មហាជន ផង នោះ នាយ គ្រឿង បាន ចេញ វីដេអូ សុំទោស ជាសាធារណៈ និង សម្រេច លុប បទចម្រៀង ផ្សាយ ពី ល្បែង អនឡាញ នោះ ចេញ ពី បណ្តាញ សង្គម វិញ ហើយ នៅ ល្ងាច ថ្ងៃទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
ករណី នេះ ក៏ ត្រូវបាន លោកស្រី បណ្ឌិត ព្រុំ ទេវី លើកឡើង ថា ដោយសារតែ អាជីវកម្ម ល្បែង ផ្សង សំណាង ជ្រក នៅ ក្រោម ពាក្យ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ទាល់តែ មាន បញ្ហា ធំ កើតឡើង ទើប មាន ការ ដោះស្រាយ ។ ចំណុច នេះ រាជ រដ្ឋាភិបាល ក៏ មិន ខុស អ្នក ផ្សព្វផ្សាយ ពី ល្បែង ក៏ មិន អាច បន្ទោស បាន ។
លោកស្រី បណ្ឌិត ព្រុំ ទេវី ក៏ បាន លើក ជា ទស្សនៈ ថា ចំពោះ ការស្តីប្រដៅ ទៅ អ្នកចូលរួម ផ្សាយ ពី ល្បែង វា ជា រឿង ល្អ និង ឆាប់ ចប់ ប៉ុន្តែ បើ ចង់ឲ្យ ស្អាតស្អំ និង កុំ ឲ្យ មាន បញ្ហា ដដែល កើតឡើង មាន តែ សិក្សា អំពី អ្វី ទៅ ដែល ហៅ ថា សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ។ តើ វា ត្រូវ មាន ការអនុគ្រោះ កម្រិត ណា ក្នុង បរិបទ ណា ហើយ ធ្វើ ម៉េច ទៀត ទៅ ថ្ងៃ ក្រោយ ដើម្បីឲ្យ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ស្ថិត នៅក្នុង បរិបទ មួយ ដែល អនុគ្រោះ បាន ។ លោកស្រី បាន បន្ត ថា ការសិក្សា ពី បញ្ហា ដើម្បី រក ដំណោះស្រាយ ទើប ជា យន្តការ យូរអង្វែង ។
បើ តាម លោក រស់ ភីរុណ អគ្គ លេខាធិការ គណៈកម្មការគ្រប់គ្រង ល្បែង ពាណិជ្ជកម្ម កម្ពុជា អាជីវកម្ម ល្បែង ផ្សង សំណាង ដែល បាន ចុះបញ្ជី នៅ ឆ្នាំ ២០២៣ គឺ រក្សា ចំនួន ២១ ដដែល ដូច ឆ្នាំ ២០២២ ។ ដោយឡែក អាជីវកម្ម កាស៊ីណូ ដែល បាន ចុះបញ្ជី ក្នុង ឆ្នាំ ២០២៣ គឺ មាន ការកើនឡើង ចំនួន ៧ក្រុមហ៊ុន លើស ពី ឆ្នាំ ២០២២ ( កើន ពី ១៧៧ ដល់ ១៨៤ ) ។
បណ្ឌិត ប៉ែន ស៊ីម៉ន បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ នៅ ខេត្ត កំពត
( កំពត ) ៖ លោក បណ្ឌិត ប៉ែន ស៊ីម៉ន សមាជិក គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពត នា ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន អញ្ជើញ ជា អធិបតី ក្នុង ការបិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ។
ពិធី នេះ មាន ការចូលរួម ពី លោក បណ្ឌិត ម៉ៅ ធ និន ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត ដោយ មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល ជា អង្គ បោះឆ្នោត សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា និង អ្នក ពាក់ព័ន្ធ ជាង ៥០០០ នាក់ នៅ រង្វង់ មូល ធុរេន នៃ ក្រុង កំពត ។
ប្រធាន គណៈកម្មការរៀបចំ ការបោះឆ្នោត ខេត្ត កំពត លោក អ៊ុង វិសាល បាន ប្រាប់ ឲ្យដឹង ថា នៅ ថ្ងៃ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង ព្រឹទ្ធសភា នីតិកាល ទី៥ នា ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ ខេត្ត កំពត មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល បាន ដាក់ សំណើរ មក គណៈកម្មការ ខេត្ត ដើម្បី សុំ រៀបចំ ក្បួន ដង្ហែ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ដែល បាន ធ្វើឡើង នៅ ទីតាំង បរិវេណ រង្វង់ មូល ទុរេន នៃ ក្រុង កំពត ។
ព្យុហយាត្រា ធ្វើ នៅក្នុង ក្រុង កំពត ចូលទៅ ផ្នែក ខ្លះ នៃ ស្រុក ទឹក ឈូ និង ក្រុង បូក គោ ដែល អ្នកចូលរួម មកពី ក្រុង កំពត ក្រុង បូក គោ និង ស្រុក ទឹក ឈូ សរុប ចំនួន ប្រមាណ ៥ ពាន់ នាក់ ។
ប្រជាពលរដ្ឋ ចូលរួម ក្នុង ក្បូន ដង្ហែ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ពួកគាត់ បាន បង្ហាញ ចំណាប់អារម្មណ៍ របស់ ខ្លួន ថា ពួកគាត់ រីករាយ យ៉ាង ខ្លាំង ដែល បាន ចូលរួម ក្នុង ក្បួន ដង្ហែ បើក និង បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ព្រោះ ពួកគាត់ យល់ឃើញ ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា តែ មួយ គត់ ដែល អាច ដឹកនាំ ប្រទេស ឲ្យ រីកចម្រើន បន្ត ទៅ ថ្ងៃ មុខ ទៀត បាន ។
ពលរដ្ឋ បាន លើកឡើង ថា ពួកគាត់ ស្រឡាញ់ ជឿជាក់ និង គាំទ្រ ពេញ ទំហឹង ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ហើយ រំពឹង ថា ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ទៅ ថ្ងៃ មុខ ប្រទេស កាន់តែ រីកចម្រើន ជាក់ ជា មិន ខាន ៕
ខែ ដំបូង ឆ្នាំ នេះ កម្ពុជា រក ចំណូល បាន ជិត ៦០ លាន ដុល្លារ ពី ការលក់ ផលិតផល កៅស៊ូ
ក្នុង ខែមករា ឆ្នាំ ២០២៤ ជ័រ កៅស៊ូ មាន តម្លៃ ១.៤២៣ ដុល្លារ ក្នុង ១តោន កេីន ឡេីង ចំនួន ១៩ ដុល្លារ ក្នុង ១តោន ស្មើនឹង ១ភាគរយ បើ ធៀប នឹង រយៈពេល ដូចគ្នា នៃ ឆ្នាំ មុន ។ ចំណែក តម្លៃ នៃ ការនាំចេញ ឈើ កៅស៊ូ ក្នុង រយៈពេល ដូចគ្នា នេះ មាន តម្លៃ ២០៤ ដុល្លារ ក្នុង មួយ ម៉ែត្រ គីប ។
លោក ជា វ៉ាន់ ចាន់ អញ្ជើញ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ស្រុក ប្រាសាទ បល្ល័ង្ក
( កំពង់ធំ )៖ លោក ជា វ៉ាន់ ចាន់ អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក ប្រាសាទ បល្ល័ង្ក បាន អញ្ជើញ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ស្នាក់ការ គណបក្ស ស្រុក ប្រាសាទ បល្ល័ង្ក ខេត្ត កំពង់ធំ ថ្ងៃ ទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
លោក បាន លើកឡើង ថា ពិធី បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត នា ថ្ងៃ នេះ បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា ប្រទេស កម្ពុជា មាន សន្តិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព សង្គម ជាមួយ ការលើកកម្ពស់ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ការពារ បាន យ៉ាង រឹងមាំ នូវ សមិទ្ធផល នៃ សង្គមជាតិ ព្រមទាំង ការពារ ឯករាជ្យ ជាតិ អធិបតេយ្យ ជាតិ និង ការពារ ឆន្ទៈ និង ផលប្រយោជន៍ ប្រជាជន ។
លោក បាន ផ្តាំផ្ញើ ដល់ ក្រុមគ្រួសារ គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ សូម រួបរួម សាមគ្គី គ្នា ជា ធ្លុង មួយ ដើរ តាម បន្ទាត់ នយោបាយ ដ៏ ត្រឹមត្រូវ ច្បាស់លាស់ រឹងមាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន គណបក្ស ។
លោក ជា វ៉ាន់ ចាន់ បាន រម្លឹក នូវ សារ របស់ សម្តេច ប្រធាន គណបក្ស ដែល បាន រំឭក ដល់ អង្គ បោះឆ្នោត ទាំងអស់ ឱ្យ គោរព អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ ខ្ជាប់ខ្ជួន តាម ច្បាប់ បទបញ្ជា នីតិវិធី ក្រមសីលធម៌ នៃ ការបោះឆ្នោត និង គោរព លទ្ធផល នៃ ការបោះឆ្នោត និង បាន ផ្តាំផ្ញើ ដល់ អង្គ បោះឆ្នោត ទាំងអស់ សូម ថែរក្សា សុខភាព និង ពិនិត្យ ឯកសារ ពាក់ព័ន្ធ បម្រើ ឱ្យ ការបោះឆ្នោត ដើម្បី ត្រៀម ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី១ មាន រូប សញ្ញា បាច ផ្កា ជា សម្គាល់ ៕
រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ រក ចំណូល បាន ជិត ១០០ លាន ដុល្លារ ពី ការធ្វើ អាជីវកម្ម ទឹក ក្នុង ឆ្នាំ ២០២៣
របាយការណ៍ នេះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា រយៈពេល ១២ ខែ ឆ្នាំ ២០២៣ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ ទទួលបាន ចំណូល សរុប ចំនួន ៣៩២ ពាន់ លាន រៀល ឬ ប្រមាណ ជាង ៩៦ លាន ដុល្លារ ដោយ ទទួលបាន ផលចំណេញ ប្រមាណ ១៥០ ពាន់ លាន រៀល ឬ ប្រហែល ៣៦ លាន ដុល្លារ ខណៈ ការចំណាយ ប្រតិបត្តិការ ផ្សេង ៗ ក្នុង ឆ្នាំ ២០២៣ មាន ចំនួន ជាង ២៤១ ពាន់ លាន រៀល ឬ ប្រហែល ៥៩ លាន ដុល្លារ ។
ទិន្នន័យ ដដែល នេះ បាន បញ្ជាក់ ផងដែរ ថា ក្នុង ត្រីមាស ទី៤ ឆ្នាំ ២០២៣ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ រក ចំណូល បាន ជាង ១០៤ ពាន់ លាន រៀល ឬ ប្រហែលជាង ២៥ លាន ដុល្លារ និង ប្រាក់ ចំណេញ មុន បង់ ពន្ធ លើ ប្រាក់ ចំណូល ចំនួន ៤០ ពាន់ លាន រៀល ឬ ប្រហែល ជិត ១០លាន ដុល្លារ មាន កំណើន ប្រមាណ ជាង ៥០% ដែល កំណើន ប្រាក់ នេះ ចំណេញ ក្នុង ត្រីមាស ទី៤នេះ គឺ ដោយសារ ចំណូល ពី ការលក់ បាន កើនឡើង ខណៈ អត្រា បាត់បង់ ទឹក ត្រូវកាត់បន្ថយ ។
រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ បាន ប្រើប្រាស់ នូវ យន្តការ ដ៏ មាន ប្រសិទ្ធភាព ដើម្បី កាត់បន្ថយ អត្រា ទឹក បាត់បង់ មក នៅ១០. ៣៦% ក្នុង ត្រីមាស ទី៤ ឆ្នាំ ២០២៣ ។ ការរក្សា បាន អត្រា ទឹក បាត់បង់ នៅ ត្រឹម កម្រិត នេះ ជា កត្តា ចម្បង ដែល ធ្វើឱ្យ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ មាន ជីវភាព ហិរញ្ញវត្ថុ និង អភិវឌ្ឍ សហគ្រាស រក្សា នូវ ស្ថានភាព ហិរញ្ញវត្ថុ និង ការអភិវឌ្ឍ សហគ្រាស ប្រកបដោយ និរន្តភាព ។
សម្ដេច ក្រឡាហោម ស ខេង បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស តាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ នៅ ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ សម្ដេច ក្រឡាហោម ស ខេង អនុប្រធាន គណបក្ស ប្រជាជន កម្ពុជា នា ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស តាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ នៅ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ព្រៃវែង ។
ក្នុង ឱកាស នោះ សម្ដេច ក្រឡាហោម ស ខេង បាន ថ្លែង ថា ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ត្រូវ នឹង ថ្ងៃអាទិត្យ ១រោច ខែ មាឃ បញ្ចស័ក ព .ស ២៥៦៧ ខាងមុខ នេះ ជា ការបោះឆ្នោត មួយ ដ៏ មាន សារៈសំខាន់ ក្រៃលែង សម្រាប់ បុព្វហេតុ បន្ត កសាង ការពារ មាតុភូមិ កម្ពុជា យើង ឲ្យ កាន់តែ មាន ការអភិវឌ្ឍ រីកចម្រើន ជា បន្ត ទៀត ។
សម្ដេច ក្រឡាហោម បាន បន្ដ ថា ពិត មែន តែ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ជា ការបោះឆ្នោត អសកល ប៉ុន្តែ គឺជា ការបោះឆ្នោត ដែល កើត ចេញ ពី ឆន្ទៈ និង បំណងប្រាថ្នា របស់ ប្រជាជន កម្ពុជា ពិតប្រាកដ ព្រោះថា សមាជិក រដ្ឋសភា និង សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល ជា អ្នកបោះឆ្នោត គឺជា អ្នកតំណាង ដ៏ ឧត្តុង្គឧត្តម របស់ ប្រជាជន ដែល បាន ប្រសូត ចេញ ពី ឆន្ទៈ របស់ ប្រជាជន ។
គណបក្ស ប្រជាជន កម្ពុជា បាន ធ្វើ ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ ក្នុង ការអនុវត្ត ឲ្យបាន សម្រេច នូវ កម្មវិធី នយោបាយ នានា របស់ គណបក្ស ដែល បាន ប្រកាស ជូន ជន រួម ជាតិ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៧ ឆ្នាំ ២០២៣ និង កម្មវិធី នយោបាយ របស់ គណបក្ស សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ កាលពី ឆ្នាំ ២០២២ កន្លងមក ព្រមទាំង កម្មវិធី នយោបាយ សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន គូសបញ្ជាក់ នូវ គោលការណ៍ ជា មូលដ្ឋាន សម្រាប់ ការអភិវឌ្ឍ ឃុំ សង្កាត់ ដែល គណបក្ស ប្រជាជន កម្ពុជា បាន កំណត់ ក្នុង គោលការណ៍ សំខាន់ ៗ នៃ កម្មវិធី នយោបាយ របស់ គណបក្ស សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ដូច ខាងក្រោម៖
* ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ត្រូវបាន ផ្ដល់ ស្វ័យភាព សិទ្ធិ អំណាច ក្នុង ការដាក់ ចេញ គោល នយោបាយ សម្រាប់ ការអភិវឌ្ឍ ឃុំ សង្កាត់ របស់ ខ្លួន និង ការធ្វើ សេចក្តីសម្រេចចិត្ត ដោយ ឆន្ទានុសិទ្ធិ ក្នុង ការប្រើប្រាស់ ថវិកា ការផ្តល់ សេវា សាធារណៈ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច មូលដ្ឋាន ដែល បម្រើ ឲ្យ ផលប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ស្រប តាម ច្បាប់ និង លិខិត បទដ្ឋាន ជាធរមាន ។
* ក្រុមប្រឹក្សា ឃុំ សង្កាត់ មាន មុខងារ និង ការទទួលខុសត្រូវ ច្បាស់លាស់ លើ ការដឹកនាំ គ្រប់គ្រង ចាត់ចែង ការងារ រដ្ឋបាល សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ធនធាន ហិរញ្ញវត្ថុ ទ្រព្យសម្បត្តិ បុគ្គលិក និង ការផ្តល់ សេវា សាធារណៈ ចាំបាច់ និង ជា មូលដ្ឋាន នានា ព្រមទាំង ការអភិវឌ្ឍ សេដ្ឋកិច្ច មូលដ្ឋាន ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ស្រប តាម ការកំណត់ នៃ ច្បាប់ ។
* បង្កើន ល្បឿន ការផ្ទេរ មុខងារ ភ្ជាប់ ជាមួយ ធនធាន មនុស្ស ធនធាន ហិរញ្ញវត្ថុ និង សិទ្ធិ អំណាច ពី ថ្នាក់ ជាតិ ទៅ ថ្នាក់ ក្រោម ជាតិ ឲ្យបាន កាន់តែ ច្រើន និង ទាន់ ពេលវេលា ដើម្បី លើកកម្ពស់ គុណភាព ប្រសិទ្ធភាព នៃ ការផ្តល់ សេវា សាធារណៈ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ នៅ មូលដ្ឋាន ។
* បង្កើត ឲ្យ មាន យន្ត ការប្រកួតប្រជែង ដោយ ផ្អែក លើ សមិទ្ធកម្ម នៅ រដ្ឋបាល ឃុំ សង្កាត់ ដើម្បី ពង្រឹង សមត្ថភាព នៃ ការគ្រប់គ្រង ធនធាន ហិរញ្ញវត្ថុ និង ដើម្បី ទទួលបាន ធនធាន ហិរញ្ញវត្ថុ បន្ថែម សម្រាប់ ការអភិវឌ្ឍ មូលដ្ឋាន ៕
រាជ រដ្ឋាភិបាល បាន ចេញ អនុក្រឹត្យ ស្តីពី ការធ្វើ សុខដុមនីយកម្ម ប្រព័ន្ធ ចុះបញ្ជី និង គ្រប់គ្រង ទិន្នន័យ គាំពារ សង្គម
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចេញ អនុក្រឹត្យ ស្តីពី ការធ្វើ សុខដុមនីយកម្ម ប្រព័ន្ធ ចុះបញ្ជី និង គ្រប់គ្រង ទិន្នន័យ គាំពារ សង្គម ដើម្បី កំណត់ អំពី ការធ្វើ សុខដុមនីយកម្ម ប្រព័ន្ធ ចុះបញ្ជី និង គ្រប់គ្រង ទិន្នន័យ គាំពារ សង្គម ដើម្បី ធានា បាន នូវ ប្រសិទ្ធភាព តម្លាភាព គណនេយ្យភាព និង សង្គតិភាព នៃ ការអនុវត្ត ក្នុង ប្រព័ន្ធ គាំពារ សង្គម កម្ពុជា ។
អនុក្រឹត្យ នេះ មាន វិសាលភាព អនុវត្ត ចំពោះ រាល់ ប្រតិបត្តិការ ចុះបញ្ជី និង ផ្ទៀងផ្ទាត់ ទិន្នន័យ អត្ថសញ្ញាណ គាំពារ សង្គម និង ការធ្វើ អន្តរ ប្រតិបត្តិការ ឌីជីថល តាមរយៈ ថ្នាល គាំពារ សង្គម ឌីជីថល និង មូលដ្ឋាន ទិន្នន័យ ចុះបញ្ជី គាំពារ សង្គម ក្នុង ប្រព័ន្ធ គាំពារ សង្គម កម្ពុជា ដែល មាន ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដែល ជា សមាជិក ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
សូម អាន អនុក្រឹត្យ ស្តីពី ការធ្វើ សុខដុមនីយកម្ម ប្រព័ន្ធ ចុះបញ្ជី និង គ្រប់គ្រង ទិន្នន័យ គាំពារ សង្គម លម្អិត បន្ថែម ខាងក្រោម៖
លោក លី ធុជ៖ អង្គ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ជា តួអង្គ មួយ យ៉ាង សំខាន់ ក្នុង ការផ្តល់ កម្លាំង ដឹកនាំ ប្រទេសជាតិ ជូន គណបក្ស ប្រជាជន កម្ពុជា និង ផ្តល់ ជំនឿ ទុកចិត្ត ជូន ប្រជាពលរដ្ឋ
( ស្វាយរៀង ) ៖ នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ក្នុង ពិធី អបអរសាទរ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធិសភា នីតិកាល ទី៥ ភូមិភាគ ៦ របស់ គណបក្ស ប្រជាជន កម្ពុជា លោក លី ធុជ សមាជិក គណៈ កម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង បាវិត ខេត្ត ស្វាយរៀង បាន ជួប សំណេះសំណាល ជាមួយ អង្គ បោះឆ្នោត ស្ថិត ក្នុង ក្រុង បាវិត ខេត្ត ស្វាយរៀង ។
លោក បាន គូសបញ្ជាក់ ថា អង្គ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ គឺជា តួអង្គ មួយ យ៉ាង សំខាន់ ក្នុង ការផ្តល់ ជា កម្លាំង ដឹកនាំ ប្រទេសជាតិ របស់ គណបក្ស ប្រជាជន កម្ពុជា និង ជា ជំនឿ ទុកចិត្ត របស់ ប្រជាពលរដ្ឋ ។ អង្គ បោះឆ្នោត ទាំងអស់ ត្រូវ បង្ហាញ ពី ឆន្ទៈ មុះ មុត និង ស្វាមី ភក្តិ ជូន ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា និង បង្ហាញ ពី ឆន្ទៈ និង សេចក្តីទុកចិត្ត ដែល ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ឃុំ / សង្កាត់ ប្រគល់ជូន ។
តាង នាម សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន អនុប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ស្វាយរៀង លោក លី ធុជ បាន ណែនាំ ឱ្យ សមាជិក បក្ស ទាំងអស់ ត្រូវ បន្ត អនុវត្តន៍ ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម គោលការណ៍ របស់ គណបក្ស និង ការណែនាំ ផ្សេង ៗ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត សំដៅ ធ្វើដំណើរការបោះឆ្នោត នា ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ទទួលបាន ជោគជ័យ ។
ក្នុង ឱកាស នោះ លោក លី ធុជ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ប្រកបដោយ ការវាយតម្លៃ ខ្ពស់ ជូន ចំពោះ ក្រុមការងារ គណបក្ស ថ្នាក់ កណ្តាល គណបក្ស ក្រុង គណបក្ស សង្កាត់ និង សមាជិក បក្ស គ្រប់ ជាន់ ថ្នាក់ ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ស្មារតី បន្ត កិច្ច ខិតខំ ប្រឹងប្រែង បម្រើ ដល់ ផលប្រយោជន៍ របស់ គណបក្ស និង ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ៕
កម្ពុជា បង្ហាញ ផែនការ មេគ្រប់ ជ្រុងជ្រោយ ស្តីពី ប្រព័ន្ធ ដឹកជញ្ជូន អន្តរ មធ្យោបាយ និង ភស្តុភារកម្ម កម្ពុជា ២០២៣ - ២០៣៣ ក្រោយ ចំណាយ ពេល សិក្សា និង រៀបចំ រយៈពេល ៥ ឆ្នាំ
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ចំណាយ ពេល សិក្សា ប្រមាណ ជា៥ ឆ្នាំ នៅ ពេល នេះ កម្ពុជា រៀបចំ បាន ហើយ នូវ ផែនទី ចង្អុល ផ្លូវ មួយ សម្រាប់ ការកសាង ប្រព័ន្ធ ដឹកជញ្ជូន និង ភស្តុភារកម្ម ដ៏ ប្រទាក់ ក្រឡា មួយ ដើម្បី ជួយ គាំទ្រ ដល់ ការធ្វើ ធុរកិច្ច ឱ្យ កាន់តែ ល្អ ប្រសើរ ។
ផែនការ មេ ប្រព័ន្ធ ដឹកជញ្ជូន និង ភស្តុភារកម្ម របស់ កម្ពុជា នេះ បាន ចូលរួម សិក្សា និង រៀបចំ អង្គការ ចៃកា របស់ ជប៉ុន ធនាគារ ពិភពលោក និង ក្រុមហ៊ុន របស់ ចិន ផងដែរ ។ បន្ទាប់ពី សិក្សា និង រៀបចំ ចងក្រង រួចរាល់ ផែនការ មេ នេះ ត្រូវបាន សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឋានៈ ជា នាយក រដ្ឋមន្ត្រី កម្ពុជា ចុះហត្ថលេខា ដាក់ ឱ្យ ប្រើប្រាស់ កាលពី ថ្ងៃទី២ ខែសីហា ឆ្នាំ ២០២៣ ។
ផែនការ មេនេះ មាន គោលដៅ ធំ ៤ រួម មាន៖ ( ១) ពង្រីក និង ធ្វើឱ្យ កាន់តែ ប្រសើរឡើង នូវ វិសាលភាព គ្របដណ្តប់ និង សមត្ថភាព នៃ ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន . ( ២) ធ្វើឱ្យ ប្រសើរឡើង នូវ ប្រសិទ្ធភាព និង ស័ក្ដិសិទ្ធិភាព នៃ សេវា និង ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន . ( ៣) ជំរុញ និង លើក កម្ពស់ ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន សំដៅ គាំទ្រ គោល នយោបាយ អភិវឌ្ឍន៍ ជាតិ និង ( ៤) ពង្រឹង ប្រសិទ្ធភាព សេវា និង ចំណាយ ឡូជី ស្ទិក ។
តាម ការប៉ាន់ស្មាន គម្រោង ទាំងនេះ តម្រូវការ ហិរញ្ញប្បទាន សរុប ប្រមាណ ៣៦. ៦៧៩ លាន ដុល្លារ អាម៉េរិក ដែល ក្នុង នោះ តម្រូវការ ក្នុង រយៈពេល ខ្លី និង មធ្យម ពី ឆ្នាំ ២០២៣ ដល់ ២០២៧ មាន ប្រមាណ ១៩. ៩២៦ លាន ដុល្លារ អាម៉េរិក ស្មើនឹង ៣. ៩៨៥ លាន ដុល្លារ អាម៉េរិក ជា មធ្យម ប្រចាំ ឆ្នាំ ៕
( ក្រចេះ ) ៖ លោក នេត្រ ភក្ត្រា សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ បាន ដឹកនាំ សមាជិក សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ជាង ២០០០ នាក់ មក ពី ក្រុង ស្រុក ទាំង៧ នៃ ខេត្ត ក្រចេះ បិទ យុទ្ធនាការ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ នៅ ភូមិភាគ៥ មណ្ឌល ក្រចេះ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
យុទ្ធនាការ នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី អ្នកតំណាងរាស្ត្រ មណ្ឌល ក្រចេះ លោក ពេជ្រ ប៊ុន ធិន . លោក អ៉ឹម ចាន់ថុល . លោក វ៉ា ថន ប្រធាន គណៈកម្មាធិការ បក្ស ខេត្ត ក្រចេះ និង ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេរ្រ ក្រចេះ ។
ពិធី បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ដែល មាន ការដង្ហែរ ក្បួន នៅក្នុង ទី រួម ខេត្ត ក្រចេះ ជាមួយ ជ័យ ឃោស កង រំពង និង ការបញ្ជូន សារ ផ្សេង ៗ ទាក់ទង នឹង គោល នយោបាយ អាទិភាព របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការអភិវឌ្ឍ ជាតិ មាតុភូមិ ។
ខេត្ត ក្រចេះ ជា ខេត្ត មួយ ស្ថិត ក្នុង ភូមិភាគ ទី៨ ដែល មាន ៦ ខេត្ត រួម មាន ក្រចេះ កំពង់ធំ ព្រះវិហារ ស្ទឹងត្រែង រតនគិរី មណ្ឌលគិរី និង ស្ទឹងត្រែង សរុប មាន អាសនៈ ព្រឹទ្ធសភា ចំនួន ៦។
ប្រធាន ក្រុមការងារ បាន ថ្លែង ថា គណបក្ស ប្រជាជន កម្ពុជា គឺជា គណបក្ស តែ មួយ គត់ ដែល បាន ដើរ តួនាទី ស្នូល ក្នុង ការសង្គ្រោះ ជាតិ និង ប្រជាជន កម្ពុជា បញ្ចប់ សង្គ្រាម ស៊ីវិល នាំយក សុខ សន្តិភាព ពេញលេញ និង ការអភិវឌ្ឍ ជូន ជាតិ មាតុភូមិ ។
សូម បញ្ជាក់ ថា សម្រាប់ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស តាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ រយៈពេល ១៤ ថ្ងៃ ដែល បាន ចាប់ផ្តើម កាលពី ថ្ងៃទី ១០ ខែកុម្ភៈ ឆ្នាំ ២០២៤ និង បិទ បញ្ចប់ នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ គឺ បាន ប្រព្រឹត្តិ ទៅ ដោយ រលូន ក្រោម បរិយាកាស ល្អ ប្រសើរ គ្មាន អំពើហិង្សា កើតឡើង ឡើយ ៕ លោក អ៉ិត សំហេង ដឹកនាំ បិទ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ព្រឹទ្ធសភា នៅ ខណ្ឌ បឹងកេងកង
