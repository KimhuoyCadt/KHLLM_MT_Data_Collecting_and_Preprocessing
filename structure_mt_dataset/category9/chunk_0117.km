( កំពង់ស្ពឺ ) ៖ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ ប្រធាន សមាគម ឧកញ៉ា កម្ពុជា នៅ ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន ដឹកនាំ អ្នក ឧកញ៉ា និង ឧកញ៉ា ចំនួន ២៥ រូប ដែល សុទ្ធតែ ជា ថ្នាក់ដឹកនាំ និង ជា សមាជិក នៃ សមាគម ឧកញ៉ា កម្ពុជា ដើម្បី ចុះ សំណេះសំណាល និង ប្រគល់ ថវិកា ជូន មណ្ឌលកុមារ កំព្រា ចំនួន ៤ ដែល មាន ទីតាំង ស្ថិត នៅក្នុង ខេត្ត កំពង់ស្ពឺ និង ប្រារព្វ ធ្វើឡើង នៅ មណ្ឌលកុមារ កំព្រា ខេត្ត កំពង់ស្ពឺ ។
ក្នុង កម្មវិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ ព្រមទាំង ថ្នាក់ដឹកនាំ និង តំណាង មន្ទីរ ក៏ ដូចជា ស្ថាប័ន មួយចំនួន នៅក្នុង ខេត្ត កំពង់ស្ពឺ ផងដែរ ។
លោក វ៉ី សំណាង បាន ថ្លែង ថា មណ្ឌល ទំាង ៤នេះ រួម មាន៖ មណ្ឌលកុមារ កំព្រា ខេត្ត កំពង់ស្ពឺ មណ្ឌលកុមារ ព្រៃ ជុំ សហគមន៍ ផ្ទះ ជា ក្រុម របស់ យើង និង មណ្ឌលកុមារ ក្តីសង្ឃឹម ថ្មី ដែល មាន ចំនួន កុមារ ២០៦ នាក់ ក្នុង នោះ កុមារី ៨២ នាក់ រួម ជាមួយ បុគ្គលិក មើល ថែ កុមារ ចំនួន ២៨ នាក់ ។
លោក បាន បន្ថែម ថា ជានិច្ចកាល ថ្នាក់ដឹកនាំ ខេត្ត តែងតែ យកចិត្តទុកដាក់ គិត គូ ដល់ សុខ ទុក្ខ របស់ កុមារ ទាំងអស់ ដោយ បាន ព្យាយាម ស្វែងរក ជំនួយ នានា ដើម្បី ឧបត្ថម្ភ ដល់ ការផ្គត់ផ្គង់ អាហារ និង ការរៀនសូត្រ របស់ ពួកគេ ស្រប ទៅតាម គោល នយោបាយ សង្គមកិច្ច របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ដែល តែងតែ ខ្វល់ខ្វាយ ជាប់ ជាប្រចាំ អំពី កុមារ ជា ជនរងគ្រោះ កុមារ កំព្រា ជាដើម ជាពិសេស លើ ការផ្តល់ ការអប់រំ ដើម្បី បណ្តុះបណ្តាល ពួកគេ ជា ធនធាន មនុស្សនា ពេល អនាគត ។
ទន្ទឹមនឹង នេះ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ បាន ថ្លែង ថា ដោយ មើលឃើញ ពី ការខ្វះខាត និង តម្រូវការ ជាក់ស្តែង របស់ មណ្ឌលកុមារ កំព្រា ទាំង ៤នេះ សមាគម ឧកញ៉ា កម្ពុជា បាន កៀរគរ សប្បុរសជន នានា ដែល ជា សមាជិក របស់ សមាគម ដើម្បី ជួយ ដល់ កុមារ កំព្រា និង អ្នកមើល ថែ សរុប ចំនួន ២៣៤ នាក់ ដោយ អំណោយ ទាំង នេះ មាន ដូចជា៖ គ្រឿង ឧបភោគ បរិភោគ ប្រចាំ ថ្ងៃ និង សម្លៀកបំពាក់ ជាដើម សរុប ជា ថវិកា ចំនួន ៣២. ៨៤៧ ដុល្លារ អាម៉េរិក ដែល ជា ថវិកា របស់ សមាគម ឧកញ៉ា កម្ពុជា ។
ព្រម ជាមួយគ្នា នេះ សប្បុរសជន អ្នក ឧកញ៉ា និង ឧកញ៉ា ចំនួន ៥រូប បាន ចូលរួម ឧបត្ថម្ភ បន្ថែម ទៀត នូវ ថវិកា ផ្ទាល់ខ្លួន សរុប ចំនួន ៣០ លាន រៀល រួម មាន៖ ១៖ អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ ថវិកា ចំនួន ២០ លាន រៀល រួម នឹង ម៉ាស ១កេស ធំ និង អាវ ចំនួន ២៨០ អាវ ២៖ អ្នក ឧកញ៉ា តុល លន ថវិកា ចំនួន ៤លាន រៀល ៣៖ លោកស្រី ឧកញ៉ា កី ម៉ានេ និង លោកស្រី ឧកញ៉ា គួន ធីតា ថវិកា ចំនួន ៤លាន រៀល ៤៖ អ្នក ឧកញ៉ា លី សាំង ឡេង ថវិកា ចំនួន ២លាន រៀល ដូច្នេះ សរុប ទាំង ថវិកា និង សម្ភារៈ ទាំងអស់ មាន ចំនួន ៤០.៣៤៧ ដុល្លារ អាម៉េរិក ។
អ្នក ឧកញ៉ា លី យ៉ុង ផាត់ បាន បន្ត ថា តាមរយៈ អំណោយ នៅ ថ្ងៃ នេះ គឺជា ការចូលរួម បរិច្ចាគ របស់ សប្បុរសជន នានា ដែល ជា សមាជិក របស់ សមាគម និង ថវិកា របស់ សមាគម ក្រោម សកម្មភាព សប្បុរសធម៌ ហើយ អ្នក ឧកញ៉ា មាន ក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា អំណោយ ដែល សមាគម ឧកញ៉ា កម្ពុជា ផ្តល់ ជូន នៅ ពេល នេះ នឹង ត្រូវបាន ប្រើប្រាស់ ចំ គោលដៅ និង បាន បំពេញ តម្រូវការ របស់ ក្មួយ ៗ ដែល កំពុង ស្នាក់ នៅ និង សិក្សា នៅក្នុង មណ្ឌល ទាំង ៤នេះ ។
ជា ចុងក្រោយ អ្នក ឧកញ៉ា បាន ផ្តាំផ្ញើ និង លើកទឹកចិត្ត ដល់ ក្មួយ ៗ ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង រៀនសូត្រ ឲ្យ ខ្លាំង ពូកែ ដើម្បី ជា ទំពាំង ស្នង ឬស្សី សម្រាប់ បន្ត វេន ក្នុង ការថែរក្សា ការពារ ជាតិ មាតុភូមិ ក្នុង ការចូលរួម អភិវឌ្ឍ សេដ្ឋកិច្ច និង ប្រទេសជាតិ របស់ យើង ទាំងអស់ គ្នា ជាពិសេស ជៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន និង ល្បែង អបាយ មុខ ទាំងឡាយ ព្រមទាំង ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ដើម្បី ខ្លួន ឯង គ្រួសារ និង សង្គមជាតិ ទាំងមូល ។
វិភាគ អន្តរជា តិ៖ អ្វី ទៅជា អាវុធ នុយក្លេអ៊ែរ នៅ អវកាស របស់ រុស្ស៉ី ?
មូលនិធិ ជាតិ ជំនួយ សង្គម បើក វគ្គ បណ្តុះបណ្តាល គ្រូ បង្គោល រាជធានី - ខេត្ត ស្តីពី « ការអនុវត្ត កម្មវិធី ជាតិ ជំនួយ សង្គម ក្នុង កញ្ចប់ គ្រួសារ » នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ លោក យឺន ហុង ឆាត់ ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សេវា និង របប ឧបត្ថម្ភ តាវ កាលិក តំណាង លោក ស៊ឹម សុធន ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា អគ្គ នាយក មូលនិធិ ជាតិ ជំនួយ សង្គម បាន មានប្រសាសន៍ ក្នុង ពេល បើក វគ្គ បណ្តុះបណ្តាល នេះ ថា៖ វគ្គ បណ្តុះបណ្តាល បង្គោល ថ្នាក់ រាជធានី ខេត្ត ថ្ងៃ នេះ គឺជា វគ្គ បណ្តុះបណ្តាល ចុងក្រោយ សម្រាប់ ខេត្ត ទាំង៨ រួម មាន ខេត្ត បាត់ដំបង ប៉ៃលិន បន្ទាយមានជ័យ កំពង់ឆ្នាំង ពោធសាត់ សៀមរាប ឧត្តរមានជ័យ និង កំពង់ធំ ។
សម្រាប់ ជំហាន បន្ទាប់ គឺជា ការបណ្តុះបណ្តាល បន្ត ដល់ តួអង្គ ប្រតិបត្តិករ នៅ ថ្នាក់ មូលដ្ឋាន រួម មាន រដ្ឋបាល ឃុំ សង្កាត់ និង មូលដ្ឋាន សុខាភិបាល សាធារណៈ ដែល នឹង ប្រព្រឹត្តទៅ តាម រាជធានី ខេត្ត នីមួយ ៗ ដើម្បី ធានា ថា មាន សមត្ថភាព គ្រប់គ្រាន់ សម្រាប់ អនុវត្ត កម្មវិធី នេះ ឱ្យ ដំណើរការ ទៅ ប្រកបដោយ ប្រសិទ្ធភាព ស័ក្តិសិទ្ធិភាព និង ទទួលបាន ប្រសិទ្ធផល ខ្ពស់ ស្រប តាម ឆន្ទះ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ។
សាល ប្រជុំ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត សៀមរាប ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ៕ លិខិត មិត្ត អ្នកអាន៖ ប្រជាធិបតេយ្យ គឺជា ជម្រើស របស់ ប្រជាជន មួយ ទៅ តាម បរិបទ នៃ ប្រទេស នោះ
តើ អ្វី ជា ជម្រើស របស់ ប្រជាជន កម្ពុជា ?
ជម្រើស គឺ ដូច អ្វី ដែល ចែង ក្នុង បុព្វក ថា នៃ រដ្ឋធម្មនុញ្ញ « យើង ប្រជារាស្រ្ត ខ្មែរ បាន ភ្ញាក់ រលឹក ក្រោកឈរ ឡើង ចង បាច់ ឆន្ទៈ មោះ មុត ប្តូរផ្តាច់ រួបរួម គ្នា ពង្រឹង ឯកភាព ជាតិ រក្សា ការពារ ទឹកដី កម្ពុជា អធិបតេយ្យ ថ្លៃថ្លា និង អារ្យធម៌ អង្គរ ដ៏ បវរ ក សាង ប្រទេសជាតិ ឲ្យ ទៅជា « កោះសន្តិភាព » ឡើងវិញ ផ្អែក លើ ប្រព័ន្ធ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ធានា សិទ្ធិ មនុស្ស គោរព ច្បាប់ ទទួលខុសត្រូវ ចំពោះ វាសនា អនាគត ជាតិ ឲ្យបាន ឈានឡើង រីកចំរើន លូតលាស់ សម្បូរ រុងរឿង ជានិច្ច និរន្តរ៍ » ។
ក្នុង ន័យ នេះ ក្រោម ម្លប់ សន្តិភាព តាំងពី ឆ្នាំ ១៩៩៨ កម្ពុជា បាន ធ្វើជា ម្ខាស់ នៃ ជោគវាសនា របស់ ខ្លួន ដោយ រៀបចំ ការបោះឆ្នោត យ៉ាង ទៀងទាត់ ទៅ តាម កាល កំណត់ ដូច មាន ចែង ក្នុង មាត្រា ៧៨ នៃ រដ្ឋធម្មនុញ្ញ ។ មាត្រា ៧៦ នៃ រដ្ឋធម្មនុញ្ញ បាន ចែង ពី ការសម្ងាត់ នៃ ការបោះឆ្នោត ។ ការរក្សា ការសម្ងាត់ នេះ គឺជា លក្ខខណ្ឌ មួយ នៃ ការបោះឆ្នោត ដែល ប្រព្រឹត្តទៅ ដោយ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ បូករួម នឹង៖
* ប្រជាពលរដ្ឋ គ្រប់ រូប មាន សិទ្ធិ ស្មើ ៗ គ្នា ក្នុង ការឈរឈ្មោះ ជា បេក្ខជន * ប្រជាពលរដ្ឋ គ្រប់ រូប មាន សិទ្ធិ ស្មើគ្នា ក្នុង ការបង្កើត គណបក្ស នយោបាយ * ប្រជាពលរដ្ឋ គ្រប់ រូប និង គ្រប់ គណបក្ស នយោបាយ មាន សិទ្ធិ ស្មើគ្នា ក្នុង ការសម្តែង មតិ នយោបាយ ដោយ សេរី * យន្តការធានា សុវត្ថិភាព ជូន បេក្ខជន ក្នុង ពេល ឃោសនា បោះឆ្នោត និង ពេល បោះឆ្នោត និង * យន្តការ សុវត្តិភាព នៅពេល បោះឆ្នោត ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) គិត ត្រឹម ថ្ងៃ ម្សិលមិញ ទី១៦ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ដែល ជា ថ្ងៃទី ៧ នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ការឃោសនា បាន ប្រព្រឹត្តទៅ ដោយ រលូន មាន សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ ល្អ និង គ្មាន អំពើហិង្សា ។
អ្វី ទៅជា បេះដូង ពិតប្រាកដ នៃ លទ្ធិ ប្រជាធិបតេយ្យ ?
បេះដូង ពិតប្រាកដ គឺ ការបោះឆ្នោត ដោយ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ ហើយ ការបោះឆ្នោត ដោយ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ គឺ ត្រូវ បូក បញ្ចូល លក្ខខណ្ឌ ដូច បាន រៀបរាប់ ខាងលើ ។
តើ អាមេរិក ជា បិតា នៃ លទ្ធិ ប្រជាធិបតេយ្យ មែន ឬ ? តើ អ៊ឺរ៉ុប សហគមទាំង ២៧ ប្រទេស ពិតជា មាន ប្រជាធិបតេយ្យ ដូចគ្នា មែន ទេ ឬ អាល្លឺម៉ង់ ផ្សេង បារាំង ផ្សឹង ?
ចប់ សង្រ្គាម ត្រជាក់ គឺជា ការសាយភាយ នៃ លទ្ធិ ប្រជាធិបតេយ្យ របស់ អាមេរិក ហើយ អឺរ៉ុប គឺ ខិតខំ លើក កំពស់ លទ្ធិ ប្រជាធិបតេយ្យ ទៅកាន់ ពិភពលោក ប៉ុន្តែ សម្រាប់ លោក Dominique TRINQUAND ការវវិវត្តន៍ បច្ចុប្បន្ន អាមេរិក មិន អាច ទៅ រួច ទេ ហើយ អឺរ៉ុប បាន ប្រែប្រួល ពី ការអវិវឌ្ឍន៍ ប្រជាធិបតេយ្យ មក ត្រឹម ការពារ ប្រជាធិបតេយ្យ របស់ ខ្លួន តែ ប៉ុណ្ណោះ ។
ដូច្នេះ ជម្រើស របស់ ប្រជាជន កម្ពុជា គឺ បន្ត ថែរក្សា អ្វី ដែល យើង កំពុង មាន ប្រសើរ ជាង ការចង់បាន ហួស ហេតុ ដូច សុភាសិត មួយ ពោល ថា ចាប១ ក្នុង ដៃ ប្រសើរ ជាង ចាប ម្ភៃ ក្នុង ព្រៃ ។
គ.ជ. ប៖ រយៈពេល ១០ ថ្ងៃ នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ប្រព្រឹត្តទៅ ដោយ រលូន ពុំ មាន បាតុភាព ណាមួយ កើតឡើង គួរឱ្យ កត់សម្គាល់ ឡើយ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ដែល ជា ថ្ងៃទី ១០ នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ពុំ មាន ការហែ ក្បួន ឃោសនា បោះឆ្នោត ទេ ប៉ុន្តែ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត បាន ធ្វើ សកម្មភាព ឃោសនា ផ្សេង ៗ ទៀត តាម កម្មវិធី ដែល គណបក្ស នយោបាយ នីមួយ ៗ បាន គ្រោង ទុក ។
អ្នកបោះឆ្នោត ជា តំណាងរាស្ត្រ ក្នុង តំណែង និង សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ទាំងអស់ ក្នុង តំណែង សរុប ចំនួន ១១.៧៤៧ នាក់ ដែល បែងចែក ជា ៨ ភូមិភាគ និង ៣៣ ការិយាល័យ បោះឆ្នោត ៕
( សៀមរាប ) ៖ លៀង មេមត់ ជា ជំនឿ ដែល ខ្មែរ គោរព តាំងពី យូរ មកហើយ និង នៅតែ បន្ត ប្រតិបត្តិ រហូតដល់ សព្វ ថ្ងៃ ជាពិសេស អ្នក រស់ នៅក្នុង តំបន់ អង្គរ ។ ការគោរព អមនុស្ស មាន ដូចជា ព្រលឹង ដូន តា អារក្ស អ្នកតា ម្ចាស់ ទឹក ម្ចាស់ ដី ជាដើម គឺជា ការដឹង គុណ ដែល អមនុស្ស អាច ជួយ ឱ្យ ពួកគាត់ បាន សេចក្ដីសុខ ចម្រើន និង រួចផុត ពី ជំងឺ នានា ។
លោក តា ឌិន ហាន ដែល ជា អ្នក ស្នង រូប បាន រៀបចំ ពិធី លៀង មេមត់ នៅ ផ្ទះ របស់ គាត់ ស្ថិត នៅ ភូមិ ត្នោត ជ្រុំ ឃុំ ដូន កែវ ស្រុក ពួក មានប្រសាសន៍ ថា ពិធី លៀង មេមត់ ធ្វើឡើង ដើម្បី លា បំណន់ និង លា មាត់ ដែល បាន បន់ស្រន់ ក្រោយពី អ្នកជំងឺ បាន ជាសះស្បើយ និង ដើម្បី សុំ សេចក្ដីសុខ និង សេចក្ដីចម្រើន ឱ្យ ព្រលឹង ដូនតា ដែល ជា គ្រូកំណើត ឱ្យ បាន សប្បាយ ផង និង ឱ្យ អ្នក ស្នង រូប បានជា ពី ជំងឺ ផ្សេង ៗ ព្រមទាំង ការបង្ហាញ នូវ ការ នឹក គុណ ដល់ ខ្មោច ជីដូន ជីតា ដែល បាន ថែរក្សា ក្រុមគ្រួសារ ឱ្យ សុខ សប្បាយ កន្លងមក ។
លោក បន្ត ថា ជាមួយ ប្រទេស បារាំង សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន កសាង មិត្តភាព ជាមួយ ប្រធានា ធបិតី បារាំង លោក ម៉ាក្រុង និង ជាមួយ ថៃ សម្តេច តេជោ ហ៊ុន សែន បាន កសាង ទំនាក់ទំនង យ៉ាង ល្អ ។
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៧.៦៩១ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥.៩៩០ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៧០១ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក គ្រឿងញៀន ស្រវឹង ស្លាកលេខ កែច្នៃ ល្មើស ល្បឿន និង ភ្លើង - ផ្លាក ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ ស្រវឹង អត់ បណ្ណ បើកបរ ដឹក សំពីង សំពោង កែច្នៃ ភ្លើង - ផ្លាក ឆៀក គ្មាន ភ្លើង បំភ្លឺ និង លើស ល្បឿន ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៤ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន នាក់ របួស ចំនួន ០៥ នាក់ ( របួស ធ្ងន់ ចំនួន ០៤ នាក់ ) ។ រយៈពេល ១៩ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១៦៣ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៨៥ នាក់ របួស ២១៩ នាក់ ( របួស ធ្ងន់ ១៣៥ នាក់ )៕ លោក បណ្ឌិត កា ម៉ាធុល៖ ការបង្វែរ វិបតិ្ត ទៅ សមុទ្រ ក្រហម គឺជា យុទ្ធសាស្រ្ត របស់ អាមេរិក បំបែក សម្ព័ន្ធមិត្ត របស់ ចិន
( ភ្នំពេញ ) ៖ ថ្លែង នៅក្នុង កម្មវិធី Fresh Talk នា ថ្ងៃសៅរ៍ សប្ដាហ៍ កន្លងទៅ លោក បណ្ឌិត កា ម៉ាធុល អ្នកជំនាញ ភូមិសាស្រ្ត នយោបាយ បាន លើកឡើង ថា « ការបង្វែរ ស្ថានការណ៍ សង្រ្គាម ដែល កំពុង រាលដាល ជុំវិញ តំបន់ មជ្ឈិមបូព៌ា ជាពិសេស នៅ តំបន់ សមុទ្រ ក្រហម ដែល ត្រូវ ក្រុម ហ៊ូទី នៃ ប្រទេស យេ មែន បង្ក ជា វិបត្តិ ក្នុង ការដឹកជញ្ជូន ទំនិញ នោះ គឺជា យុត្តិសាស្រ្ត មួយ របស់ អាមេរិក នៅក្នុង ការបំបែក សម្ព័ន្ធ របស់ ចិន ដែល ស្ថិត នៅក្នុង តំបន់ មជ្ឈិមបូព៌ា » ។
បើ តាម អនុប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា ខាងលើ យ៉ាងណាមិញ យុត្តិសាស្រ្ត នេះ បើ ទោះជា អាមេរិក ចង់ ដាក់ សម្ពាធ លើ ប្រទេស ចិន ក៏ ពិត មែន ប៉ុន្តែ បើសិនជា សង្រ្គាម បន្ត អូសបន្លាយ កាន់តែ យូរ នោះ អ៉ី ស្រាអែល ក៏ ជួប វិបត្តិ វិញ ដូចគ្នា ។
ខាងក្រោម នេះ គឺជា កិច្ចសម្ភាស របស់ លោក បណ្ឌិត កា ម៉ាធុល ដែល មាន ខ្លឹមសារ ដូចតទៅ៖ អភិបាល រង ស្រុក អង្គរ បូរី ចុះ សួរសុខទុក្ខ និង ផ្តល់ អំណោយ ស្ត្រី ទើប ឆ្លង ទន្លេ រួច នៅ ឃុំ ព្រែក ផ្ទោល
( តាកែវ )៖ លោក ឈឹម ធី អភិបាល រង ស្រុក អង្គរ បូរី នៅ រសៀល ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន អញ្ជើញ ចុះ សាកសួរ សុខទុក្ខ លោកស្រី គង់ ចាន់ រ៉ា រស់ នៅ ភូមិ កំពង់ពោធិ៍ ឃុំ ព្រែក ផ្ទោល ស្រុក អង្គរ បូរី ដែល ទើប សម្រាល កូន រួច ដោយ មាន ការចូលរួម ពី លោក លោកស្រី ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ លោក មេឃុំ ក្រុមប្រឹក្សា ឃុំ មេភូមិ ។
ក្នុង ឱកាស ចុះ សាកសួរ សុខទុក្ខ នេះ ដែរ លោក ឈឹម ធី បាន ពាំនាំយក ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ របស់ ថ្នាក់ដឹកនាំ ហើយ បាន នាំយក នូវ សម្ភារ មាន ទឹក បរិសុទ្ធ ៣កេស ភេសជ្ជៈ ១កេស និង ថវិកា ចំនួន ៤០ ម៉ឺន រៀល ៕
លោក ប៉ែន បូណា ថ្លែង បែប នេះ ក្នុង សន្និសីទ សារព័ត៌មាន បង្ហាញ សមិទ្ធផល ការងារ ៦ខែ នៃ ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នា រសៀល ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ។
បើ តាម លោក ប៉ែន បូណា ប្រវត្តិសាស្ត្រ សម័យ ទំនើប ចាប់ រាប់ ពី ចុង សតវត្សរ៍ ទី ១៥ បើ គិត ពី ប្រទេស កម្ពុជា វិញ រួម មាន សម័យ ក្រោយ អង្គរ គឺ សម័យ ចតុម្មុខ លង្វែក ឧត្តុង្គ និង សម័យ បន្តបន្ទាប់មក មិន មាន សម័យ ណា មាន សន្តិភាព ពេញលេញ ហើយ យូរអង្វែង ដូច សម្តេច តេជោ ហ៊ុន សែន នោះ ទេ ។ ជាមួយគ្នា នេះ ក៏ មិន មាន សម័យ ណា ដែល ប្រទេស កម្ពុជា មាន ប្រព័ន្ធ គមនាគមន៍ ខ្វែង ខ្វាត់ មាន ផ្លូវ ហាយវេ និង មាន ផ្លូវ ល្បឿន លឿន តភ្ជាប់ យ៉ាង រលោង ស្រិល ដូចជា សម័យ សម្តេច តេជោ ហ៊ុន សែន ដែរ ។
លោក ប៉ែន បូណា បាន លើកឡើង បន្ត ថា សម្តេច តេជោ ហ៊ុន សែន ប្រទេស កម្ពុជា មាន អគារ ខ្ពស់ ៗ នៅ តាម រាជធានី ភ្នំពេញ ឬ ក៏ តាម ប្រជុំជន ដែល មើល ច្រឡំ នឹង បណ្តា ប្រទេស អភិវឌ្ឍ ផ្សេង ៗ ទៀត ទៀតផង ។ សម្តេច តេជោ ហ៊ុន សែន ប្រទេស កម្ពុជា សម្បូរបែប ដោយ ម្ហូប អាហារ ប្រជាជន ខ្មែរ អាច ចេញដំណើរ ដើរកម្សាន្ត គ្រប់ ទីកន្លែង គ្រប់ ខេត្ត គ្រប់ ខណ្ឌ និង រហូត ធ្វើដំណើរកម្សាន្ត នៅ ក្រៅ ប្រទេស យ៉ាង ច្រើន កុះករ ។
លោក ប៉ែន បូណា បាន បន្ថែម ថា សម្តេច តេជោ ហ៊ុន សែន ធ្វើឱ្យ ប្រជាពលរដ្ឋ មាន ឧបករណ៍ និង របស់របរ ទំនើប ៗ ប្រើប្រាស់ មាន សាលារៀន ស្អេក ស្កេះ នៅជិត ផ្ទះ ប្រជាពលរដ្ឋ និង មាន និស្សិត បញ្ចប់ ការសិក្សា មួយ ឆ្នាំ ៗ រាប់ ពាន់ ម៉ឺន នាក់ ។ មាន ន័យ ថា ការអភិវឌ្ឍ និង ការរីកចម្រើន របស់ សង្គម សេដ្ឋកិច្ច ជាតិ របស់ កម្ពុជា ដល់ កម្រិត កំពូល មាន តែ នៅ សម័យ តេជោ ហ៊ុន សែន តែ មួយ គត់ ក្នុង រយៈពេល ៥០០ ឆ្នាំ ចុងក្រោយ នេះ ។
លោក បន្ថែម ថា ក្រុម អ្នកដឹកនាំ ថ្មី នឹង នាំ ប្រទេស កម្ពុជា លឿន ទៅ មុខ ទៀត ដោយសារ មាន គ្រឹះ រួចស្រេច ដោយសារ រៀមច្បង កើតឡើង ដោយសារ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។ នេះ ជា ក្តីសង្ឃឹម រឹងមាំ ណាស់ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ៕ ក្រសួង សេដ្ឋកិច្ច ចេញ ប្រកាស ស្តីពី ការលើកទឹកចិត្ត ពន្ធដារ ចំពោះ សហគ្រាស ក្នុង វិស័យ ទេសចរណ៍
( ភ្នំពេញ ) ៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចេញ ប្រកាស ស្តីពី ការលើកទឹកចិត្ត ពន្ធដារ ចំពោះ សហគ្រាស ក្នុង វិស័យ ទេសចរណ៍ ។ នេះ បើ តាម ប្រកាស ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៩ ខែកុម្ភៈ នេះ ៕ គណៈកម្មការគ្រប់គ្រង ល្បែង ពាណិជ្ជកម្ម កម្ពុជា ចេញ សេចក្តីណែនាំ ពី ការពង្រឹង ការគ្រប់គ្រង ប្រតិបត្តិការ ល្បែង ផ្សង សំណាង នៅ កម្ពុជា
( ភ្នំពេញ )៖ គណៈកម្មការគ្រប់គ្រង ល្បែង ពាណិជ្ជកម្ម កម្ពុជា នៅ ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្តីណែនាំ ពី ការពង្រឹង ការគ្រប់គ្រង ប្រតិបត្តិការ ល្បែង ផ្សង សំណាង នៅ កម្ពុជា ។
លោក ខូយ រីដា សំណេះសំណាល ជាមួយ សមាជិក ក្រុមប្រឹក្សា ឃុំ ក្នុង ស្រុក វាលវែង ដែល ជា អង្គ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤
( ពោធិ៍សាត់ )៖ លោក ខូយ រីដា សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ ស្នាក់ការ គណបក្ស ស្រុក បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សមាជិក ក្រុមប្រឹក្សា ឃុំ ទាំង៥ ក្នុង ស្រុក វាលវែង ចំនួន ២៥ រូប ដែល ជា អង្គ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ដោយ មាន ការចូលរួម ពី លោក លោកស្រី សមាជិក ព្រឹទ្ធសភា អនុប្រធាន គណបក្ស ខេត្ត គណបក្ស ស្រុក និង សមាជិក ក្រុមប្រឹក្សា ស្រុក មួយចំនួន ទៀត ។
លោក វង្ស អេង អនុប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ស្រុក វាលវែង បាន ឱ្យដឹង ថា សមាជិក សមាជិកា ក្រុមប្រឹក្សា ឃុំ ទាំង៥ ក្នុង ស្រុក វាលវែង ដែល ជា អង្គ បោះឆ្នោត សរុប មាន ចំនួន ២៥ រូប ក្នុង នោះ ស្រី ៥រូប ។ សម្រាប់ យុទ្ធនាការ ឃោសនា បោះឆ្នោត បាន ចាប់ផ្ដើ ពី ថ្ងៃទី ១០ ដល់ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។ ចំពោះ ថ្ងៃទី ២៤ ជា ថ្ងៃ ស្ងប់ស្ងាត់ ហើយ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ គឺជា ថ្ងៃ បោះឆ្នោត ។
លោក ខូយ រីដា សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ពោធិ៍សាត់ បាន សម្ដែង នូវ ការគោរព និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមាជិក ក្រុមប្រឹក្សា សង្កាត់ ទាំងអស់ ក្នុង ក្រុង ពោធិ៍សាត់ ដែល កន្លងមក បាន យក អស់ កម្លាំង កាយ ចិត្ត ក្នុង ការបំពេញ ភារកិច្ច បម្រើ ប្រជាជន នៅ តាម មូលដ្ឋាន របស់ ខ្លួន បាន ល្អ ប្រសើរ ។
លោក បាន លើកឡើង ពី សមិទ្ធផល ធំ ៗ និង គម្រោង អភិវឌ្ឍ ខេត្ត ពោធិ៍សាត់ នា ពេល ខាងមុខ នេះ ដែល រាជ រដ្ឋាភិបាល ផ្ដោត ការយកចិត្តទុកដាក់ ផ្ដោត សំខាន់ មក លើ ខេត្ត ពោធិ៍សាត់ យ៉ាង ខ្លាំង ។ សូម ចូលរួម សហការ ជាមួយ គណបក្ស នយោបាយ ដទៃ និង អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ដើម្បី រក្សា បរិយាកាស នយោបាយ ល្អ ប្រសើរ ប្រកបដោយ សេរី យុត្តិធម៌ សណ្ដាប់ធ្នាប់ ល្អ និង សុវត្ថិភាព សម្រាប់ ការបោះឆ្នោត ក្នុង គោលដៅ ពង្រឹង លទ្ធិ ប្រជាធិបតេយ្យ និង នីតិរដ្ឋ នៅ កម្ពុជា ឲ្យ កាន់តែ រឹងមាំ ឡើង ។
លោក សូម ឱ្យ អង្គ បោះឆ្នោត ទាំងអស់ ថែរក្សា សុខភាព ឱ្យ បាន ល្អ ព្រមទាំង បាន អំពាវនាវ ទៅ បោះឆ្នោត និង បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន រូប សញ្ញា ទេ តា ចាច ផ្កា លេខរៀង ទី១ នៅលើ សន្លឹក ឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា ។ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា គឺ ធានា នូវ ជោគវាសនា ប្រទេសជាតិ ប្រជាជន និង ខ្លួន ឯង ផ្ទាល់ ។
សម្រាប់ ខេត្ត ពោធិ៍សាត់ គឺជា មណ្ឌល ភូមិភាគ ទី៧ ដែល អង្គ បោះឆ្នោត ទូទាំង ខេត្ត សរុប មាន ចំនួន ៣១១ នាក់ បូក នឹង តំណាងរាស្ត្រ ០៤ នាក់ ទៀត សរុប ៣១៥ នាក់ ។ មណ្ឌល បោះឆ្នោត មាន តែ មួយ កន្លែង ប៉ុណ្ណោះ គឺ មណ្ឌល ធនធាន ការិយាល័យ លេខ ៧០០៥ ដែល ស្ថិត នៅក្នុង បរិវេណ សាលា បឋមសិក្សា ពោធិ៍សាត់ ៕
លោក ប៉ែន បូណា បាន រំលេច សមិទ្ធផល លំអិត នៃ គោល នយោបាយ អាទិភាព ទាំង៦ ដូច ខាងក្រោម៖
ចំណុច នេះ លោក ប៉ែន បូណា បាន អះអាង ថា គោលបំណង របស់ សម្តេច ធិបតី មិន ត្រឹមតែ ផ្តល់ ជូន សេវា សុខាភិបាល គ្រប់ គ្នា ទេ តែ ជា សេវា ដែល មាន គុណភាព ពោលគឺ គ្រូពេទ្យ ពូកែ ធ្វើ រោគវិនិច្ឆ័យ ច្បាស់ ដាក់ ថ្នាំ ត្រូវ ហើយ ជា ថ្នាំ មាន គុណភាព ។
ទី២៖ ការបណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ បច្ចេកទេ ស៖ តាម គម្រោង គឺ បណ្តុះបណ្តាល ១លាន ៥សែន នាក់ ដោយ ឥត បង់ ប្រាក់ និង ទទួលបាន ការឧបត្ថម្ភ ២៨ ម៉ឺន រៀល ក្នុង មួយ ខែ ។ ឥឡូវនេះ មាន អ្នក ចុះឈ្មោះ ជិត ៣ម៉ឺន នាក់ ។ កាលពី ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២៤ កន្លងទៅ ក្រសួង ការងារ បាន ប្រកាស បើក បវេសនកាល នៃ វគ្គ បណ្តុះបណ្តាល ត្រូវបាន បើក ធ្វើ ដោយ មាន ចំនួន ៦៧៣ ថ្នាក់ ។ កំពុង បន្ត ធ្វើ និង ពង្រីក សកម្មភាព ទៀត មិន យូរ ទេ ១.៥លាន នាក់ នឹង គ្រប់ ចំនួន មាន ជំនាញ អាច រក ចំណូល បាន ។
ទី៣៖ កម្មវិធី ជាតិ ជំនួយ សង្គម៖ មាន ពីរ ប្រភេទ៖ ប្រភេទ ទី ១៖ កម្មវិធី ជាតិ ជំនួយ សង្គម ក្នុង កញ្ចប់ គ្រួសារ ៖ កម្មវិធី ឧបត្ថម សាច់ប្រាក់ ដល់ ស្ត្រី មាន ផ្ទៃពោះ និង កុមារ អាយុ ក្រោម ២ឆ្នាំ . ផ្តល់ អាហារូបករណ៍ ដល់ សិស្ស ក្រីក្រ ថ្នាក់ បឋម និង មធ្យមសិក្សា . ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ជន មាន ពិការ ភាព . ឧបត្ថម្ភ សាច់ប្រាក់ ជូន ជន ចាស់ជរា អាយុ ៦០ ឆ្នាំ ឡើង ។
ប្រភេទ ទី ២៖ កិច្ច គាំពារ សង្គម ឆ្លើយតប នឹង គ្រោះអាសន្ន រួម មាន គ្រោះ ធម្មជាតិ ( ខ្យល់ព្យុះ ទឹក ជំនន់ ) . វិបត្តិ សុខភាព សាធារណៈ . វិបត្តិ ម៉ាក្រូ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
ទី ៤៖ យុទ្ធសាស្ត្រ ជាតិ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ៖ មាន ប្រជាពលរដ្ឋ ច្រើន ណាស់ ដែល ប្រកប មុខរបរ ក្នុង សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ទូទាំង ប្រទេស ។ កិច្ចការងារ នេះ ធំ ប្រទាក់ ក្រឡា គ្នា ពី ក្រសួង ដល់ រាជធានី - ខេត្ត ដែល កំពុង មមាញឹក ខ្លាំង ដើម្បី រៀបចំ ប្រព័ន្ធ ការងារ ជាក់ស្តែង ដល់ អ្នក ប្រកបរបរ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ។
ទី ៥៖ យន្តការសម្របសម្រួល និង កម្មវិធី ហិរញ្ញប្បទាន៖ រាជ រដ្ឋាភិបាល ទម្លាក់ កញ្ចប់ ថវិកា ១០០ លាន ដុល្លារ ក្នុង ការចាប់ផ្តើម ហើយ អាច វិភាជ បន្ថែម ប្រសិនបើ ចាំបាច់ ។ យន្តការ នេះ មាន គោលដៅ ជួយ កសិករ ឱ្យ មាន ចំណូល ខ្ពស់ មាន លំនឹង ផលិតកម្ម រក្សា សន្តិសុខ ស្បៀង ... ។
ដើម្បី សម្រេច គោលដៅ នេះ ក្រសួង កសិកម្ម និង ពាណិជ្ជកម្ម កំពុង រួមគ្នា ធ្វើ កិច្ចការ មួយ ចំនួន រួម មាន៖ បង្កើត ក្រុមការងារ សម្របសម្រួល រួចហើយ រវាង ក្រសួង ទាំង ពីរ . ផ្តល់ ការណែនាំ ដល់ ថ្នាក់ រាជធានី ខេត្ត ឱ្យ បង្កើត ក្រុមការាង រចម្រុះ ដែរ . តាមដាន ការវិវត្ត តម្លៃ ស្រូវ អង្ករ ក្នុង ទីផ្សារ តំបន់ និង ពិភពលោក និង ត្រៀមលក្ខណៈ ទិញ ស្រូវ ស្តុក ទុក ដើម្បី សន្តិសុខ ស្បៀង និង រក្សា លំនឹង តម្លៃ ។
ទី៦៖ ការដាក់ពង្រាយ មន្ត្រី កសិកម្ម ឃុំ សង្កាត់៖ ឆ្លើយតប គោល នយោបាយ នេះ ក្រសួង កសិកម្ម សហការ ជាមួយ ក្រសួង មុខងារ សាធារណៈ បាន រៀបចំ ប្រលង ជ្រើសរើស មន្ត្រី ២៥០ នាក់ ជំហាន ដំបូង និង កំណត់ គោលដៅ ៨០០ ឃុំ សង្កាត់ ទៀត សម្រាប់ ជំហាន ទី២ នៅ ខែមេសា ខាងមុខ ។
ក្រៅពី សមិទ្ធផល ខាងលើ នេះ លោក ប៉ែន បូណា ក៏ បាន រំលេច នូវ សមិទ្ធផល សំខាន់ មួយចំនួន ទៀត លើ វិស័យ យុត្តិធម៌ វិស័យ មុខងារ សាធារណៈ វិស័យ ដីធ្លី និង សន្តិសុខ ។
វិស័យ មុខងារ សាធារណៈ៖ ក្នុង វិស័យ នេះ ក្រសួង មុខងារ សាធារណៈ ដឹកនាំ ដោយ លោក ហ៊ុន ម៉ានី ដឹកនាំ កំណែទម្រង់ ច្រើន យ៉ាង ក្នុង នោះ រៀបចំ ការប្រឡង ជ្រើសរើស មន្ត្រី ចូល បម្រើ ការងារ ចំនួន ពីរ លើក រួច មកហើយ រួម មាន ការប្រឡង ជ្រើសរើស មន្ត្រី កសិកម្ម ឃុំ ២៥០ នាក់ និង ជ្រើសរើស គ្រូ អប់រំ កាយ និង កីឡា ១០០ នាក់ ។ ការប្រលង ទាំង ពីរ លើ នេះ គឺជា ការប្រលង យ៉ាង ល្អ តម្លាភាព ទទួលបាន ការកោតសរសើរ ពី គ្រប់ មជ្ឈដ្ឋាន ។ និយាយ រួម គ្មាន ភាព មិន ប្រក្រតី គ្មាន ការសង្ស័យ ណាមួយ កើតឡើង ។
ក្រសួង មុខងារ សាធារណៈ ក៏ បាន និង កំពុង ដឹកនាំ ធ្វើ កំណែទម្រង់ ជាច្រើន ទៀត ដូចជា ការពង្រឹង សមត្ថភាព ស្ថាប័ន . ការពង្រឹង ការគ្រប់គ្រង និង បង្កើន សមត្ថភាព មន្ត្រីរាជការ . លើកកម្ពស់ ការផ្តល់ សេវា សាធារណៈ ..
តាមរយៈ សមិទ្ធផល ខាងលើ នេះ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី លោក ប៉ែន បូណា បាន បង្ហាញ ការសន្និដ្ឋាន ថា រយៈពេល ៦ខែ នេះ រាជ រដ្ឋាភិបាល របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជា រាជ រដ្ឋាភិបាល សកម្ម ហើយ មាន ចក្ខុវិស័យ ច្បាស់លាស់ . រាជ រដ្ឋាភិបាល ដែល មាន មេដឹកនាំ វ័យ ក្មេង តែ បទពិសោធន៍ ចាស់ទុំ . រាជ រដ្ឋាភិបាល ដែល ប្រើ ពេល តិច តែ ធ្វើ បាន ច្រើន . រាជ រដ្ឋាភិបាល ដែល មាន ប្រមុខ ដឹកនាំ មិន និយាយ តែ មាត់ តែ បង្ហាញ លទ្ធផល ។
លោក ប៉ែន បូណា បាន មើលឃើញ ដែរ ថា ត្រឹម ៦ខែ ប្រជាប្រិយភាព នៃ រាជ រដ្ឋាភិបាល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ហក់ ឡើង យ៉ាង ខ្ពស់ ដោយ ទទួលបាន ការគាំទ្រ ពី ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន ទាំង ជាតិ និង អន្តរជាតិ ។ ប្រជាពលរដ្ឋ ខ្មែរ ទាំង ក្មេង ចាស់ ប្រុស ស្រី តាមដាន សកម្មភាព រាជ រដ្ឋាភិបាល និង បាន ឃើញ ភាព សកម្ម និង សមិទ្ធផល ហួស ការរំពឹងទុក ហើយ ពួកគេ មាន ទំនុកចិត្ត ខ្ពស់ និង ផ្តល់ ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ។ មិន ដែល មាន ទេ រាជ រដ្ឋាភិបាល ដែល មាន ងាយុ ៦ខែ ហើយ មាន ប្រជាប្រិយភាព លឿន រហ័ស បែប នេះ ។
លោក ប៉ែន បូណា បាន សង្កត់ធ្ងន់ ថា រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជា ក្តីសង្ឃឹម ពិតប្រាកដ របស់ ប្រជាពលរដ្ឋ ស័ក្តិសម ជា អ្នក ស្នង តំណែង របស់ គណបក្ស ប្រជាជន កម្ពុជា ៕ អ៊ីស្រាអែល ព្រមាន ពលរដ្ឋ នៅ ហ្គាហ្សា មិន ឱ្យ ធ្វើ បុណ្យ Ramadan បើសិនជា មិន ដោះលែង ចំណាប់ខ្មាំង
សង្គ្រាម រវាង អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស ប៉ាឡេស្ទីន បាន ឈានចូល ១៣៦ ថ្ងៃ ហើយ គិត ត្រឹម ថ្ងៃ ១៩កុម្ភៈ ឆ្នាំ ២០២៤ ។ ក្រសួង សុខាភិបាល នៅ តំបន់ ហ្គាហ្សា ដែល គ្រប់គ្រង ដោយ ក្រុមហា ម៉ាស បាន និយាយ ថា យ៉ាងហោចណាស់ មនុស្ស ២៨.៩៨៥ នាក់ ត្រូវបាន សម្លាប់ និង ៦៨.៨៨៣ នាក់ បាន រងរបួស នៅក្នុង ការវាយប្រហារ របស់ អ៊ីស្រាអែល ក្នុង តំបន់ ហ្គាហ្សា ។
ក្រុង Rafah ដែល មាន ពលរដ្ឋ ប៉ាឡេ ស្ទីន ភៀស សឹក ជាង មួយ លាន នាក់ ជ្រក ស្នាក់ នៅ កំពុង ក្លាយជា ក្រុង ចុងក្រោយ បង្អស់ មួយ ដែល បារម្ភ ជុំវិញ ឈាម ហូរ ដាប ពោះ ដំរី បើសិនជា អ៊ីស្រាអែល នឹង ប្រើ មធ្យោបាយ វាយលុក ដោយ កម្លាំង ថ្មើរជើង ។ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បាន ហៅ អំពើ វាយប្រហារ របស់ នាយក រដ្ឋមន្ត្រី អ៊ីស្រាអែល លោក បិន ចាមីន ណេថាន់ យ៉ាហ៊ូ ថា បាន ដើរ ហួស ពី កម្រិត របស់ ហើយ ។
ក្រុម អ្នកការទូត បាន និយាយ ថា ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ទំនងជា នឹង បោះឆ្នោត នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ ជុំវិញ ការជំរុញ មួយ របស់ ប្រទេស អាល់ហ្សេរី សម្រាប់ ស្ថាប័ន ក្រុម ប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ដែល មាន សមាជិក ចំនួន ១៥ ប្រទេស ដើម្បី ស្វែងរក បទ ឈប់ បាញ់ មនុស្សធម៌ ភ្លាម ៗ មួយ នៅក្នុង សង្គ្រាម អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស់ ប៉ុន្តែ សហរដ្ឋ អាមេរិក កំពុង បញ្ចេញ សញ្ញា ថា គេ នឹង បោះឆ្នោត វេតូ ជុំវិញ ការស្នើរ ក បទ ឈប់ បាញ់ គ្នា នោះ ។
អ៊ីស្រាអែល បាន ថ្លែង ថា គេ នឹង លែង អនុគ្រោះ ដល់ ក្រុម ហេស បូឡាហ៍ ដែល បាន បង្ក សកម្មភាព តាម បណ្តោយ ព្រំដែន ទៀត ហើយ ។ អ៊ីស្រាអែល និយាយ ថា ភាពបរាជ័យ នៃ ដំណើរការទូត ជា អន្តរជាតិ ដែល មិន អាច បង្ខំឱ្យ ក្រុម ហេស បូឡាហ៍ ចេញ ឆ្ងាយ ពី តំបន់ ព្រំដែន នោះ គឺ នឹង តម្រូវ ចាំបាច់ ឱ្យ អ៊ីស្រាអែល ត្រូវ ធ្វើ ការវាយលុក តបត ដាក់ ទៅ វិញ ។
វត្ត ប្រាសាទ គោក ចក ក្នុង ក្រុសៀមរាប ប្រារព្ធ ធ្វើ ពិធី បុណ្យ ទេសនា មហា វេស្សន្តរជាត ក និង រាប់ បាត្រ ប្រគេន ព្រះសង្ឃ ចំនួន ១០៨ អង្គ
ព្រះគ្រូ វិចិត្រ វង្សា ហែម គឹម សាន ញាតិធ ម្មោ ព្រះចៅ អធិការ វត្ត ប្រាសាទ គោក ចក មាន សង្ឃ ដីកា ថា ការប្រារព្ធ ធ្វើ បុណ្យ ទេសនា មហា វេស្សន្តរជាតក ទៅ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា និង រាប់ បាត្រ ប្រគេន ព្រះសង្ឃ ចំនួន ១០៨ អង្គ នា ពេលនេះ ដើម្បី បាន បច្ច័យ យកមក ឲ្យ ថ្លៃ គ្រឿង សំណង់ នៃ ការជួសជុល ធ្វើ ឈាប នដ្ឋាន រួមទាំង ក្រាល ការ៉ូឡា នៅ បរិវេណ កន្លែង បូជា សព បន្ត ទៀត ដែល មាន ចំនួន ១.៥០០ ម៉ែត្រ ការ៉េ ត្រូវ ចំណាយ បច្ច័យ អស់ ៩.០០០ ដុល្លារ ( ក្នុង ១ម៉ែត្រ រ៉េតម្លៃ ៦ដុល្លារ ) ផងដែរ ។
ព្រះគ្រូ ចៅអធិការ មាន សង្ឃ ដីកា បន្ត ថា ពិធី បុណ្យ ទេសនា មហា វេស្សន្តរជាតក គឺ បុណ្យ ប្រពៃណី បែប ព្រះពុទ្ធ សាសនា ហើយ គឺជា ប្រវត្តិ រឿង សន្សំ កុសល ជាតិ ចុងក្រោយ បង្អស់ របស់ ព្រះវេស្សន្តរ ជា ព្រះពោធិសត្វ ដែល បាន បំពេញ បារមី ដ៏ មហស្ចារ្យ ពោល គឺ ទាន បារមី ដើម្បី បាន ត្រាស់ជា ព្រះសម្មាសម្ពុទ្ធ ក្នុង ជាតិ មុខ ។
ព្រះគ្រូ ចៅអធិការ បាន គូសបញ្ជាក់ ថា ក្នុង ពិធី នេះ ដែរ ក៏ មាន បងប្អូន ញាតិ ញោម ជិត ឆ្ងាយ ដែល បាន ចូលរួម ក្នុង ពិធី បុណ្យ ទេសនា មហា វេស្សន្ដរជា តក បាន ចូលរួម តាម កម្លាំង សទ្ធា ជ្រះថ្លា រៀង ៗ ខ្លូន ហើយ ក៏ មាន ការប្រមូល បច្ច័យ ពី បងប្អូន ពុទ្ធ បរិស័ទ យកមក បម្រើ ការក្រាល ការ៉ូឡា ដែល មាន ផ្ទៃក្រឡា ១.៥០០ ម៉ែត្រ ក្រឡា នៅ បរិវេណ ឈានបនដ្ឋាន ផងដែរ ៕
អភិបាល ខេត្ត ពោធិ៍សាត់ ដាក់ចេញ នូវ ផែនការ យ៉ាង ម៉ឺងម៉ាត់ ចំនួន ៨ ចំណុច ដើម្បី ត្រួតពិនិត្យ និង ពង្រឹង ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ទូទាំង ខេត្ត
( ពោធិ៍សាត់ )៖ លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត នា ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន ដាក់ចេញ នូវ ផែនការ យ៉ាង ម៉ឺងម៉ាត់ ចំនួន ៨ ចំណុច ទៅដល់ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត រដ្ឋបាល ស្រុក ក្រុង ឃុំ សង្កាត់ ជាពិសេស អង្គភាព កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ដើម្បី ត្រួតពិនិត្យ និង ពង្រឹង ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ទូទាំង ខេត្ត និង ត្រៀម បង្ក លក្ខណៈ ងាយស្រួល សម្របសម្រួល ដល់ វិនិយោគ មក អភិវឌ្ឍន៍ ខេត្ត ពោធិ៍សាត់ ។
ក្នុង កិច្ចប្រជុំ នោះ មាន ការរាយការណ៍ ពាក់ព័ន្ធ ការអនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវគោក បញ្ហា គ្រឿងញៀន ល្បែងស៊ីសង ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព សភាពការណ៍ សន្តិសុខ សណ្តាប់ធ្នាប់ តាម ខ្សែ បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ និង សេចក្តីរាយការណ៍ រដ្ឋបាល ស្រុក ក្រុង មន្ទីរ អង្គភាព និង កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ អំពី បញ្ហា ប្រឈម នៅក្នុង មូលដ្ឋាន ។
ពិត ណាស់ ថា ខេត្ត ពោធិ៍សាត់ បច្ចុប្បន្ន មាន ការប្រែ មុខ ប្រែ មាត់ ច្រើន ដែល ប្រមុខ រាជ រដ្ឋាភិបាល មាន ការយកចិត្តទុកដាក់ ខ្ពស់ ទម្លាក់ គម្រោង ផែនការអភិវឌ្ឍន៍ ជាច្រើន ដែល ទាមទារ ឱ្យ យើង ទាំងអស់ គ្នា ចូលរួម សហការ គាំទ្រ ព្រមទាំង សម្របសម្រួល គ្រប់ បែបយ៉ាង ដល់ វិនិយោគ គិន ។
លោក ក៏ បាន ដាក់ចេញ នូវ ផែនការ យ៉ាង ម៉ឺងម៉ាត់ ទៅដល់ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត រដ្ឋបាល ស្រុក ក្រុង ឃុំ សង្កាត់ ជាពិសេស អង្គភាព កងកម្លាំងប្រដាប់អាវុធ ទាំង ៣៖
ក្រសួង ទេសចរណ៍ រៀបចំ សិក្ខាសាលា ផ្សព្វផ្សាយ លទ្ធផល នៃ វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន លើក ទី១៩ អម ជាមួយ ការពង្រឹង គុណភាព សេវាកម្ម ទេសចរណ៍ នៅ ខេត្ត សៀមរាប
ជាមួយ នេះ ដែរ លោក ជឿជាក់ ថា សិក្ខាសាលា ផ្សព្វផ្សាយ នេះ នឹង ក្លាយជា ធាតុ ចូល មួយ យ៉ាង សំខាន់ សម្រាប់ ជំរុញ ប្រតិបត្តិករ ទេសចរណ៍ ឱ្យ យកចិត្តទុកដាក់ ពង្រឹង គុណភាព សេវាកម្ម ទេសចរណ៍ ឱ្យ បាន មាន ស្តង់ដា និង ឧត្តមានុវត្ត ខ្ពស់ ស័ក្កសម ជា គោលដៅ ទេសចរណ៍ អន្តរជាតិ ដ៏ ទាក់ទាញ ប្រកបដោយ គុណភាព . ផ្តល់ នូវ ធនធាន ទេសចរណ៍ សម្បូរបែប . មាន ការទទួលស្គាល់ ជា លក្ខណៈ សកល លើ ការអភិរក្ស និង កិច្ច គំាពារ សម្បត្តិ បេតិកភណ្ឌ វប្បធម៌ និង បរិស្ថាន ធម្មជាតិ និង មាន ភ្ញៀវ ទេសចរ មក កម្សាន្ត កាន់តែ ច្រើន ផងដែរ ៕
រដ្ឋបាល ខេត្ត បាត់ដំបង ជូនដំណឹង ស្តីពី ការទម្លាក់ កម្ពស់ ទឹក ស្ទឹង សង្កែ ដើម្បី បង្កើន សមត្ថភាព ផ្គត់ផ្គង់ ទឹក ស្អាត ក្នុង ខេត្ត
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការទម្លាក់ កម្ពស់ ទឹក ស្ទឹង សង្កែ ចាប់ពី កម្ពស់ ១០ម៉ែត្រ មក ត្រឹម៦.៥ម៉ែត្រ ដើម្បី ជួយ សម្រួល ដល់ ការងារ សាងសង់ ស្ថានីយ៍ បូប ទឹក ឆៅ និង ជួយ កាត់បន្ថយ ផល ប៉ះពាល់ នានា ក្នុង ការបង្កើន សមត្ថភាព ផ្គត់ផ្គង់ ទឹក ស្អាត ក្នុង ខេត្ត នៅក្នុង រយៈពេល ៣ខែ ដោយ គិត ចាប់ពី ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ រហូតដល់ ថ្ងៃទី ១៤ ខែឧសភា ឆ្នាំ ២០២៤ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឺង ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖ បទ វិភាគ៖ សន្ទុះ ខ្លាំងក្លា នៃ ការប្រើប្រាស់ ក្នុង បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន បាន បំពេញ បន្ថែម « ចរន្ត ក្តៅ » ទៅក្នុង ពិភពលោក ជា បន្តបន្ទាប់
បុណ្យ ចូល ឆ្នាំ ថ្មី ចិន ឆ្នាំ នេះ ជា បុណ្យ ចូល ឆ្នាំ ថ្មី ចិន មាន ប្រក្រតីភាព មុន គេ បង្អស់ បន្ទាប់ពី ប្រទេស ចិន បាន កែសម្រួល វិធានការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។ " ប្រទេស ចិន ដែល មាន ភាព ចល័ត " បាន ជំរុញ ដល់ កម្លាំង រស់រវើក នៃ ទីផ្សារ ប្រើប្រាស់ ។ ទំនៀមទំលាប់ ប្រពៃណី បុណ្យ ចូល ឆ្នាំ ថ្មី ចិន ដែល បាន បន្ត វេន ដល់ បច្ចុប្បន្ន នេះ និង រូបមន្ត ប្រើប្រាស់ ដែល ផ្លាស់ប្តូរ ថ្មី ជា បន្តបន្ទាប់ ជា សាក្សី នៃ ការជួបប្រទះ និង រួមបញ្ចូល គ្នា រវាង " ចាស់ និង ថ្មី " ។
កិច្ចប្រជុំ អំពី ការងារ សេដ្ឋកិច្ច មជ្ឈិម ចិន ដែល បើក ធ្វើ នៅ ចុង ឆ្នាំ មុន បាន លើកឡើង ថា បន្ទាប់ពី បញ្ចប់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ចិន នឹង ជំរុញ ការប្រើប្រាស់ ត្រូវ ពង្រីក ជា បន្តបន្ទាប់ ។ ក្រសួង ពាណិជ្ជកម្ម ចិន បាន កំណត់ ឆ្នាំ ២០២៤ជា " ឆ្នាំ ជំរុញ ការប្រើប្រាស់ " ហើយ នឹង រៀបចំ សកម្មភាព ជំរុញ ការប្រើប្រាស់ មួយចំនួន ។ រដ្ឋាភិបាល ចិន បាន ដាក់ចេញ វិធានការ ជាច្រើន ជំរុញ ឱ្យ សក្តានុពល នៃ ទីផ្សារ ប្រើប្រាស់ របស់ ចិន ត្រូវ បញ្ចេញ ឡើង និង រចនាស ម័្ពន្ធ ប្រើប្រាស់ ត្រូវ លើកកម្ពស់ ជា បន្តបន្ទាប់ ។
សន្ទុះ ខ្លាំងក្លា នៃ ការប្រើប្រាស់ ក្នុង បុណ្យ ចូល ឆ្នាំ ថ្មី ចិន ព្រម និង លក្ខណៈ សម្បតិ្ត សម្រាប់ ទ្រទ្រង់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ប្រកបដោយ គុណភាព ខ្ពស់ បាន កើនឡើង ជា បន្តបន្ទាប់ ដូច្នេះ នៅ ឆ្នាំ ២០២៤ សេដ្ឋកិច្ច ចិន មាន ជំនឿចិត្ត ថា នឹង មាន សភាព ល្អ ប្រសើរ ឡើងវិញ ជា បន្តបន្ទាប់ ហើយ បន្ដ ចាក់ បំពេញ " ចរន្ត ក្តៅ " ទៅក្នុង ពិភពលោក ៕
វិទ្យុ មិត្តភាព កម្ពុជា ចិន សមាគម យុវជន លើកកម្ពស់ សេដ្ឋកិច្ច ប្រជាជន កម្ពុជា ថ្កោល ទោស ចំពោះ ទង្វើ គំរាមកំហែង ដល់ អង្គ បោះឆ្នោត ដែល ធ្វើឡើង ដោយ គណបក្ស ភ្លើង ទៀន
( ភ្នំពេញ ) ៖ សមាគម យុវជន លើកកម្ពស់ សេដ្ឋកិច្ច ប្រជាជន កម្ពុជា ( ស.ស .ប .ក ) បាន ចេញ សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស ចំពោះ ទង្វើ គំរាមកំហែង រំលោភ ការ សម្ងាត់ និង ធ្វើឱ្យ បាត់ ទំនុកចិត្ត លើ ការបោះឆ្នោត សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល ធ្វើឡើង ដោយ គណបក្ស ភ្លើង ទៀន ។
សមាគម នេះ បាន ចាត់ទុក ថា ការគំរាមកំហែង នេះ វា បាន បង្កឱ្យ មាន ផល ប៉ះពាល់ ការបាត់បង់ នូវ ទំនុកចិត្ត លើ ការបោះឆ្នោត សមាជិក ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ផងដែរ ។
ទង្វើ គំរាមកំហែង នេះ ផ្ទុយ នឹង ច្បាប់ ស្តីពី ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ មាត្រា ៧១ ដែល ត្រូវ យកមក អនុវត្ត ក្នុង ការបោះ ឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ។ សកម្មភាព ខាងលើ ដែល គណបក្ស នយោបាយ មួយ នោះ បាន កំពុង ប្រព្រឹត្តិ គឺ ជា ទង្វើ ប្រឆាំង នឹង រដ្ឋធម្មនុញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ច្បាស់ ណាស់ ។
សមាគម យុវជន លើកកម្ពស់ សេដ្ឋកិច្ច ប្រជាជន កម្ពុជា ( ស.ស .ប .ក ) បាន គាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ សេចក្ដីថ្លែងការណ៍ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការ បោះឆ្នោត លេខ ០០២ គ.ជ. ប ចុះ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ និង សូម គាំទ្រ ចំពោះ សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង មហាផ្ទៃ លេខ ០០៤ ស ប្រក ចុះ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
សមាគម យុវជន លើកកម្ពស់ សេដ្ឋកិច្ច ប្រជាជន កម្ពុជា ( ស.ស .ប .ក ) សូម ស្នើរ ឱ្យ ក្រសួង មហាផ្ទៃ ចាត់ វិធាន ការ តាម ផ្លូវ ច្បាប់ យ៉ាង តឹងរឹង បំផុត ចំពោះ គណបក្ស នយោបាយ ដែល កំពុង គំរាមកំហែង និង បង្កឱ្យ មាន បញ្ហា ដល់ ដំណើរការ នៃ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នា ពេល ខាងមុខ នេះ ។
សមាគម យុវជន លើកកម្ពស់ សេដ្ឋកិច្ច ប្រជាជន កម្ពុជា ( ស.ស .ប .ក ) សូម ប្រកាស ចូលរួម ប្តេជ្ញា ការពារ ឱ្យ បាន នូវ សុខ សន្តិភាព ឱ្យ បាន ល្អ ព្រមទាំង សូម ធ្វើ ការអំពាវនាវ ដល់ សមាជិក ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ទាំងអស់ ទូទាំង ប្រទេស បោះឆ្នោត ជូន សមាជិក ព្រឹទ្ធសភា ដែល ខ្លួន ពេញចិត្ត និង កុំ មាន ការភ័យខ្លាច ចំពោះ សកម្មភាព នៃ ការគំរាម កំហែង នេះ ៕
មនុស្ស ជាង ៦០ នាក់ ត្រូវ ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ ៤៥ ករណី ពោល ថយចុះ នា សប្ដាហ៍ ចុងក្រោយ នេះ
( ភ្នំពេញ ) ៖ ក្នុង រយៈពេល ១សប្ដាហ៍ ចាប់ពី ថ្ងៃទី ១២ ដល់ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២៤ សមត្ថកិច្ច នគរបាល ជាតិ បាន បង្ក្រាប បទល្មើស ព្រហ្មទណ្ឌ ចំនួន ៤៥ ករណី នៅ ទូទាំង ប្រទេស ។ នេះ បើ តាម លោក ទូច សុឃៈ ( សុខៈ ) អ្នកនាំពាក្យ រង ក្រសួង មហាផ្ទៃ ។
បើ តាម អ្នកនាំពាក្យ រង ក្រសួង មហាផ្ទៃ ក្នុង កិច្ច ប្រតិបត្តិការ បង្ក្រាប បទល្មើស ទាំង ៤៥ ករណី សមត្ថកិច្ច នគរបាល ជាតិ បាន ក្រសោប ចាប់ ឃាត់ខ្លួន ជសង្ស័យ សរុប ចំនួន ៦៥ នាក់ កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម នីតិវិធី ។
ជា ការកត់សម្គាល់ បើ ធៀប នឹង សប្ដាហ៍ កន្លងទៅ ករណី បទល្មើស ព្រហ្មទណ្ឌ ក្នុង សប្ដាហ៍ ចុងក្រោយ នេះ បាន ថយចុះ ។ កាលពី សប្ដាហ៍ កន្លងទៅ នោះ នគរបាល ជាតិ បាន បង្ក្រាប បទល្មើស ព្រហ្មទណ្ឌ ជិត ៧០ ករណី និង ឃាត់ខ្លួន មនុស្ស ជាង ៩០ នាក់ ។
ឈរ លើ ទស្សនៈ « អ្វី ៗ ធ្វើ ដើម្បី ផ្ដល់ ភាពកក់ក្ដៅ ជូន ប្រជាពលរដ្ឋ » ចាប់ពី ដើម នីតិកាល ទី៧ នៃ រដ្ឋសភា អភិសន្តិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ បាន ដៅ យក ការងារ អាទិភាព ចំនួន ៦ ក្នុង នោះ ការបង្ការ និង បង្ក្រាប បទល្មើស ក្នុង សង្គម ក៏ ជា អាទិភាព ដែរ ។
លោក ទូច សុឃៈ បាន ឱ្យដឹង ថា អភិសន្តិ បណ្ឌិត បាន រម្លឹក ជារឿយ ៗ ឱ្យ អាជ្ញាធរ មូលដ្ឋាន រួមទាំង កម្លាំង នគរបាល ជាតិ យកចិត្តទុកដាក់ ជំរុញ អនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ - សង្កាត់ មាន សុវត្ថិភាព និង កៀរគរ ប្រជាពលរដ្ឋ ចូលរួម គាំទ្រ ឱ្យ បាន ផុសផុល តាម ទស្សនៈ « ប្រជាពលរដ្ឋ ម្នាក់ ក៏ ជា នគរបាល មួយ រូប »៕ លោក ម៉ារ យ៉ារិទ្ធិ៖ កត្តា ដែល នាំឱ្យ ពិភពលោក បារម្ភ និង ប្រឆាំង ខ្លាំង លើ ការវាយប្រហារ របស់ អ៉ី ស្រាអែល លើ ហាម៉ាស់ ដោយ ទ័ព ថ្មើរជើង ព្រោះ នឹង នាំឲ្យ មាន ការសម្លាប់ រង្គាល
សូម ទស្សនា ការ លើកឡើង របស់ លោក ម៉ារ យ៉ារិទ្ធិ ដែល មាន ខ្លឹមសារ ដូចតទៅ៖ រដ្ឋសភា ចេញ សេចក្តីជូនដំណឹង អំពី ការបើក កិច្ចប្រជុំ វិសាមញ្ញ ថ្ងៃទី ២១ ខែកុម្ភៈ ដើម្បី បោះឆ្នោត ផ្តល់ សេចក្តីទុកចិត្ត លើ ការតែងតាំង លោក ហ៊ុន ម៉ានី ជា ឧប នាយក រដ្ឋមន្រ្តី និង បន្ថែម ទេសរដ្ឋមន្រ្តី ២រូប ទៀត
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០២៤ រដ្ឋសភា កម្ពុជា នឹង បើក សម័យ ប្រជុំ រដ្ឋសភា ជា វិសាមញ្ញ នីតិកាល ទី៧ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា ដើម្បី ធ្វើ ការបោះឆ្នោត ផ្តល់ សេចក្តីទុកចិត្ត លើ ការ តែងតាំង បំពេញ បន្ថែម សមាសភាព រាជ រដ្ឋាភិបាល ចំនួន ៣រូប ។
សមាជិក រាជ រដ្ឋាភិបាល ៣រូប នោះ រួម មាន៖
១៖ លោក ហ៊ុន ម៉ានី ជា ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ ២៖ លោក ស្រី ថាម រុង្គ ជា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ៣៖ លោក ប៉ែន វិបុល ជា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង រដ្ឋសភា៖ លោក បណ្ឌិត កា ម៉ាធុល៖ អ៉ី ស្រាអែល ពិបាក ក្នុង ការបញ្ឈប់ សង្រ្គាម នៅ កាហ្សា ដោយសារ បញ្ហា សន្តិសុខ ប្រទេស របស់ ខ្លួន
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត កា ម៉ាធុល អ្នកជំនាញ ភូមិសាស្រ្ត នយោបាយ និង ជា អនុប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន លើ ឡើង ថា « អាមេរិក និង អ៉ី ស្រាអែល បាន និង កំពុង ផុង ខ្លួន នៅក្នុង សង្រ្គាម នៅ កាហ្សា ដែល ពិបាក ក្នុង ការបញ្ឈប់ ប្រសិនជា មិន អាច កម្ទេច ក្រុមហា ម៉ាស់ បាន ។ ហើយ បើសិនជា បន្ត កម្ទេច ក្រុមហា ម៉ាស ច្បាស់ ណាស់ នឹង ប៉ះពាល់ ខ្លាំង ទៅ លើ សិទ្ធិ មនុស្ស និង ច្បាប់ អន្តរជាតិ ដោយ តែ ការប៉ះពាល់ ដល់ ជន ស៊ីវិល ដែល អ៉ី ស្រាអែល ពិបាក ក្នុង ការបែងចែក » ។
សូម ទស្សនិកជន ទស្សនា កិច្ចសម្ភាសន៍ ខាងក្រោម ដូចត ទៅ៖ ទស្សនា វីដេអូ វេទិកា សារព័ត៌មាន លើក ទី២ ស្តីពី សមិទ្ធផល ការងារ រយៈពេល ៦ខែ របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត
រដ្ឋមន្ត្រី ទាំង ពីរ រូប បាន បង្ហាញ សេចក្តីសន្និដ្ឋាន របស់ ខ្លួន ថា ៦ខែ នៃ ការដឹកនាំ របស់ សម្តេច ធិបតី សម្រេចបាន សមិទ្ធផល ដ៏ គួរឱ្យ ភ្ញាក់ផ្អើល ទាំង ក្របខណ្ឌ ក្នុង ប្រទេស និង ក្រៅ ប្រទេស ។
ព្រះទេព សត្ថា សៀង សុខ ព្រះរាជា គណៈ ថ្នាក់ ចត្វា និង ជា ព្រះសត្ថា បារមី ព្រះមេ គណ ខេត្ត កំពង់ធំ ចាត់ តំណាង និមន្ត អប់រំ សីលធម៌ ដល់ សិស្សានុសិស្ស បឋមសិក្សា អនុវត្ត ហ៊ុន សែន អាចារ្យលាក់ ក្រុង ស្ទឹង សែន
ព្រះចន្ទ សោភណ រង្សី ស ចាន់ មាន សង្ឃ ដីការ ថា ការបណ្ដុះបណ្ដាល មូលដ្ឋានគ្រឹះ នៃ គុណធម៌ សីលធម៌ និង សុជីវធម៌ ដល់ សិស្ស ចាប់ពី ថ្នាក់ មត្តេយ្យ សិក្សា ឡើង ទៅ គឺជា រឿង ដែល ក្រសួង អប់រំ ត្រូវ យកចិត្តទុកដាក់ បំផុត ដើម្បី កសាង សង្គម មួយ ឲ្យ រីកចម្រើន ប្រកបដោយ សុភមង្គល ។ បើ សង្គមជាតិ មួយ សម្បូរ ទៅ ដោយ មនុស្ស អសីលធម៌ និង អគុណធម៌ សង្គម នោះ ក៏ សម្បូរ ទៅ ដោយ មនុស្ស មិន គោរព ច្បាប់ ជាតិ ដែរ ។
នៅក្នុង អប់រំ សីលធម៌ ព្រះអង្គ បាន បង្រៀន ៥ចំណុច ពី របៀប សំពះ គឺ៖
១៖ សំពះ ត្រឹម ថ្ងាស គឺ សំពះ ព្រះពុទ្ធ ព្រះធម៌ និង ព្រះសង្ឃ ២៖ សំពះ ត្រឹម ប្រជុំ ចិញ្ចើម ចំពោះ ព្រះមហាក្សត្រ ៣៖ សំពះ ត្រឹម ច្រមុះ ចំពោះ មាតាបិតា ចាស់ទុំ គ្រូ បាធ្យាយ ៤៖ សំពះ ត្រឹម មាត់ ចំពោះ អ្នក មាន វ័យ ច្រើន ជាង ឬ អ្នក ធំ ៥៖ សំពះ ត្រឹម ដើមទ្រូង ចំពោះ អ្នក មាន វ័យ ស្មើគ្នា មិត្តភក្តិ ឬ ឋានៈ ស្មើគ្នា ។
ចុងបញ្ចប់ ព្រះអង្គ ព្រះចន្ទ សោភណ រង្សី ស ចាន់ សម្ដែង នូវ ការគាំទ្រ ចំពោះ ការយកចិត្តទុកដាក់ របស់ លោក នាយក លោក គ្រូ អ្នកគ្រូ ដែល បាន និមន្ត ព្រះសង្ឃ មក អប់រំ ទូន្មាន នៅ តាម សាលា ហើយ នៅក្នុង នោះ ព្រះអង្គ ព្យាយាម លះបង់ ពេលវេលា ដើម្បី ចូលរួម នៅក្នុង សកម្មភាព អប់រំ នៅក្នុង វិស័យ អាណាចក្រ ដើម្បីឲ្យ មនុស្ស ជំនាន់ ក្រោយ ទទួលបាន នូវ សីលធម៌ មាន គុណធម៌ ក្លាយជា ពលរដ្ឋ ល្អ ក្នុង សង្គម ផងដែរ ៕
បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ផ្សព្វផ្សាយ ផែនការ កំណែទម្រង់ របស់ កងយោធពល ខេមរភូមិន្ទ និង ក្រមសីលធម៌ សម្រាប់ យោធិន ក្នុង ដំណើរការបោះឆ្នោត
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន វាយតម្លៃ ចំពោះ វីរភាព ដ៏ អង់អាច ក្លាហាន របស់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ដែល បាន លះបង់ គ្រប់ បែបយ៉ាង ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា ពិសេស ក្នុង សម័យ សង្គ្រាម ស៊ីវិល ដើម្បី ការពារ ទប់ស្កាត់ ការ វិលត្រឡប់ មកវិញ នៃ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង ក្នុង ពេល សង្គ្រាម ឈ្លានពាន នៅ តាម ព្រំដែន កម្ពុជា - ថៃ នា ពេល កន្លងទៅ ។
ក្នុង ឱកាស នេះ ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន ផ្សព្វផ្សាយ ខ្លឹមសារ សំខាន់ ៗ និង បទបញ្ជា មួយចំនួន របស់ ថ្នាក់ដឹកនាំ នៃ កងយោធពល ខេមរភូមិន្ទ ដែល បាន ថ្លែង ក្នុង អង្គ សិក្ខាសាលា បូកសរុប លទ្ធផល ការងារ យោធា សន្តិសុខ ឆ្នាំ ២០២៣ និង ដាក់ចេញ ទិសដៅ អនុវត្ត បន្ត សម្រាប់ ឆ្នាំ ២០២៤ របស់ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក កាលពី ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
លោក បាន ណែនាំ យោធិន គ្រប់ រូប ត្រូវ ចូលរួម យ៉ាង សកម្ម ក្នុង ការកំណែទម្រង់ របស់ កងយោធពល ខេមរភូមិន្ទ មាន ជាអាទិ៍ ការដាក់ យោធិន ឲ្យ ចូល សោធន និវត្តន៍ សម្រាប់ ឆ្នាំ ២០២៤ និង ឆ្នាំ ខាងមុខ ការហ្វឹកហ្វឺន រៀនសូត្រ ពង្រឹង តួនាទី ភារកិច្ច និង វិន័យ របស់ កងកម្លាំង ការអភិវឌ្ឍន៍ ធនធាន មនុស្ស និង ការគ្រប់គ្រង គ្រឿង សម្ភារ បច្ចេកទេស យោធា តាម ប្រព័ន្ធ ព័ត៌មានវិទ្យា ប្រកបដោយ ប្រសិទ្ធភាព ។
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន ប្រគល់ ភារកិច្ច ជូន ដល់ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ និង យោធិន គ្រប់ រូប ត្រូវ ត្រៀម កម្លាំង អន្តរាគមន៍ ដើម្បី ចូលរួម សហប្រតិបត្តិការ ឲ្យបាន ល្អ ក្នុង កិច្ចការពារ សន្តិសុខ សុវត្ថិភាព ជូន គណបក្ស នយោបាយ នានា ដោយ ស្មើភាព គ្នា ក្នុង ដំណើរការបោះឆ្នោត ជ្រើសតាំង ព្រឹទ្ធសភា និង ត្រូវ អនុវត្ត ឱ្យ បាន ម៉ឺងម៉ាត់ នូវ ក្រមសីលធម៌ សម្រាប់ កងយោធពល ខេមរភូមិន្ទ ក្នុង ដំណើរការបោះឆ្នោត ជ្រើសតាំង ព្រឹទ្ធសភា នៅពេល ខាងមុខ ឱ្យ ទទួលបាន សុវត្ថិភាព និង ជោគជ័យ ៕
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ សារលិខិត ជូន បងប្អូន ជន រួម ជាតិ ក្នុង ឱកាស ទិវា ជាតិ សុខភាព មាតា ទារក និង កុមារ
កម្មវិធី សម្ពោធ គម្រោង នេះ ក៏ មាន វត្តមាន ការអញ្ជើញ ពី ឯក អគ្គ រដ្ឋទូត សហគមន៍ អ៊ឺរ៉ុប ឯក អគ្គ រដ្ឋទូត ប្រទេស បារាំង និង អគ្គ រដ្ឋទូត ប្រទេស ហ្វីលីពីន ប្រចាំ កម្ពុជា និង ភ្ញៀវ កិត្ដិយ ស និង សិស្សានុសិស្ស ចូលរួម ផងដែរ ។
គម្រោង ខាងលើ នេះ គឺជា គំនិត ផ្តួចផ្តើម និង ជា ការសហការ ដែល ផ្តោត សំខាន់ លើ ការពង្រឹង សមត្ថភាព និង ជំនាញ មន្រ្តី ទទួលបន្ទុក ការិយាល័យ អន្តរជាតិ របស់ សាកលវិទ្យាល័យ នីមួយ ៗ (HEIs) ដែល ពាក់ព័ន្ធ ដើម្បី ឈាន ទៅ ជំរុញ កិច្ចសហប្រតិបត្តិការ រវាង សាកលវិទ្យាល័យ ក្នុង ប្រទេស អាស៊ាន និង រវាង សាកលវិទ្យាល័យ នៅ អាស៊ាន និង សហគមន៍ អឺរ៉ុប ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី ហង់ ជួន ណារ៉ុន បាន ផ្ដល់ នូវ អនុសាសន៍ គន្លឹះ មួយចំនួន ដល់ ក្រុមការងារ គម្រោង ទាំងមូល ដើម្បី អនុវត្ដ គម្រោង កាន់តែ មាន ភាពប្រសើរ ។
ជាមួយគ្នា នោះ លោកស្រី ទេព កូលាប សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ភ្នំពេញ អន្តរជាតិ (PPIU) បាន ថ្លែង ថា វត្តមាន ដ៏ ខ្ពង់ខ្ពស់ និង ប្រសាសន៍ ដ៏ មាន អត្ថន័យ នៅក្នុង កម្មវិធី បើក របស់ លោក បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា ពិតជា មាន តម្លៃ និង ជា ការលើកទឹកចិត្ត ដ៏ ធំធេង សម្រាប់ ក្រុមការងារ គម្រោង ទាំងមូល ដែល មកពី សាកលវិទ្យាល័យ សរុប ចំនួន ៨ ក្នុង នោះ រួម មាន៖
លោកស្រី ទេព កូលាប ក៏ បាន មានប្រសាសន៍ ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ លោក បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា ឯកឧត្តម ឯក អគ្គ រាជ ទូត លោក លោកស្រី និង សិស្សានុសិស្ស ដែល មាន វត្តមាន នៅក្នុង កម្មវិធី និង សន្យា ប្ដេជ្ញា សហការ ការងារ ក្នុង គម្រោង ប្រកបដោយ គុណភាព និង ភាពជោគជ័យ ៕ ស្អែក នេះ ! វេទិកា ការងារ របស់ NEA នឹង នាំយក ឱកាស ការងារ ជាង ៣ពាន់ កន្លែង សម្រាប់ យុវជន
យុវជន សិស្ស / និស្សិត ដែល កំពុង ស្វែងរក ការងារ ឬ ចង់ ផ្លាស់ប្តូរ ការងារ សូម ត្រៀម CV ដើម្បី ដាក់ពាក្យ និង សម្ភាស ការងារ ភ្លាម ៗ ជាមួយ តំណាង ក្រុមហ៊ុន ទាំង ២៥ ។ យុវជន ក៏ អាច ចូលរួម ក្នុង សិក្ខាសាលា ដែល នឹង មាន ការចូលរួម ចែករំលែក ចំណេះដឹង បទពិសោធន៍ ល្អ ៗ និង គន្លឹះ សំខាន់ ៗ ពីសំណាក់ វា គ្មិន ជំនាញ ៗ ពី សារៈសំខាន់ នៃ ការត្រៀមខ្លួន ចូល ទីផ្សារ ការងារ ក៏ ដូចជា ការត្រៀមខ្លួន ដាក់ពាក្យ ស្វែងរក ការងារ ផងដែរ ។
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល និង ជា ប្រធាន គណកម្មាធិការ បក្ស ខេត្ត នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន អញ្ជើញ បើក យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នៅ ទីស្នាក់ការ គណបក្ស ក្រុង អរិយក្សត្រ និង ស្រុក ខ្សាច់ កណ្ដាល ។
លោក គង់ សោភ័ណ្ឌ ក៏ បាន អំពាវនាវ ដល់ ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ជា អង្គ បោះឆ្នោត ទាំងអស់ សូម ចូលរួម ក្នុង យុទ្ធនាការ ឃោសនា បោះឆ្នោត ឱ្យ បាន សកម្ម បំផុត ដើម្បី បង្ហាញ អំពី សាមគ្គីភាព និង ឯកភាព ផ្ទៃក្នុង យ៉ាង រឹងមាំ របស់ គណបក្ស ដោយ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ភាព ថ្លៃថ្នូរ និង សីលធម៌ ដ៏ ល្អ ប្រសើរ និង ត្រូវ ស្មោះត្រង់ ដើម្បី គណបក្ស និង ប្រជាពលរដ្ឋ ។
លោក បាន ជំរុញ ឲ្យ ប្រធាន គណបក្ស ក្រុង - ស្រុក ត្រូវតែ ត្រួតពិនិត្យ ពិសេស នោះ គឺ នៅ ថ្ងៃទី ២៤ មុន មួយ ថ្ងៃ ឲ្យបាន ច្បាស់លាស់ ថា តើ ក្រុមប្រឹក្សា ឃុំ ជា អង្គ បោះឆ្នោត មាន ឯកសារ គ្រប់គ្រាន់ ហើយ ឬ នៅ ? ប្រសិនបើ មាន ការខ្វះចន្លោះ នឹង ចាត់ វិធានការ ដោះស្រាយ ជាបន្ទាន់ ។
លោក គង់ សោភ័ណ្ឌ សំណូមពរ ឲ្យ អង្គ បោះឆ្នោត ទាំងអស់ ត្រូវ ត្រៀមខ្លួន ឯកសារ អត្តសញ្ញាណប័ណ្ណ ការថែទាំ សុខភាព សុវត្ថិភាព ឲ្យបាន ល្អ ដើម្បី រួម បោះឆ្នោត នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខាងមុខ នេះ ៕ ពលរដ្ឋ ស្វាគមន៍ កណ្តាប់ដៃ ដែក របស់ អាជ្ញាធរ ចុះ បិទ ទីតាំង ល្បែង សំណាង តាម អនឡាញ ឆ្នោត ឡូតូ ជល់ មាន់
( កោះកុង ) ៖ ពលរដ្ឋ ខេត្ត កោះកុង បាន ស្វាគមន៍ កណ្តាប់ដៃ ដែក របស់ អាជ្ញាធរ ខេត្ត ដឹកនាំ ដោយ លោក ហាក់ ឡេង អភិបាល រង ខេត្ត និង ក្រុមការងារ គណៈ បញ្ជាការ ឯកភាព ក្រុង ស្រុក ចុះ បិទ ទីតាំង លែ្បង ផ្សង សំណាង អនឡាញ ឆ្នោត ឡូតូ ជល់ មាន់ និង ល្បែងស៊ីសង នានា ដែល មាន ទីតាំង នៅ តាម មូលដ្ឋាន ក្រុង ស្រុក បាន ចំនួន ៦៤ ទីតាំង ។
លោក ហាក់ ឡេង បាន ឲ្យដឹង ថា ក្នុង រយៈពេល ២ទៅ ៣ ថ្ងៃ នេះ អាជ្ញាធរ បាន អនុវត្ត បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ឲ្យ អាជ្ញាធរ គ្រប់ បណ្តា ខេត្ត បង្រ្កាប ល្បែង ផ្សង សំណាង គ្រប់ ប្រភេទ មិន ឲ្យ មាន ដើម្បី ភូមិ ឃុំ មាន សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ គ្រប់ មូលដ្ឋាន ។
លោក ហាក់ ឡេង បាន បន្ត ថា ការចុះ បិទ អាជីវកម្ម ល្បែង ផ្សង សំណាង តាម អនឡាញ ឆ្នោត ឡូតូ ជល់ មាន់ បាន ចំនួន ៦៤ ទីតាំង ហើយ ក្រុមការងារ បាន ធ្វើ កិច្ចសន្យា ហាម មិន ឲ្យ មាន បើក បន្ត បើ ម្ចាស់ ទីតាំង នៅ ប្រព្រឹត្ត គឺ ម្ចាស់ ទីតាំង និង ប្រឈប់ មុខ និង ផ្លូវ ជាធរមាន ។ នា ពេលនេះ ដែរ លោក បាន ឲ្យ ចៅសង្កាត់ មេឃុំ មេភូមិ និង ប៉ុស្តិ៍ រដ្ឋបាល ចុះ ពិនិត្យ ដោយ យកចិត្តទុកដាក់ នេះ ដើម្បី សុវត្តិភាព ប្រជាពលរដ្ឋ ។
ប្រជាពលរដ្ឋ រស់ នៅ តាម មូលដ្ឋាន នីមួយ ៗ មាន ការសប្បាយ ចិត្ត ក្នុង ការប្រើ កណ្តាល ដៃ ដែក របស់ អាជ្ញាធរ បាន ចុះ បិទ ទីតាំង អាជីវកម្ម ល្បែង ផ្សង សំណាង ឆ្នោត ឡូតូ ជល់ មាន់ តាម ប្រព័ន្ធ អនឡាញ ។
ពលរដ្ឋ បាន បន្ត ថា បើ មាន ល្បែង សុី សង នៅ តាម ភូមិ ឃុំ គឺ តែង មា អំពើហឹង្សា ក្នុង គ្រួសារ និង មាន ចោកម្ម បាត់បង់ ទ្រព្យសម្បតិ្ត ពលរដ្ឋ ហើយ ពលរដ្ឋ ដេក ក៏ មិន លក់ ដោយ ខ្លាច បាត់ របស់របរ គាត់ ៕
អាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ ចាប់ និង បញ្ជូន ជនសង្ស័យ ម្នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី ប្រើប្រាស់ ឯកសណ្ឋាន ខុស ច្បាប់
( បន្ទាយមានជ័យ )៖ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក ស្វាយ ចេក បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ឈ្មោះ គុជ វិតី អាយុ ២៦ ឆ្នាំ បច្ចុប្បន្ន រស់ នៅ ភូមិ ចំការគ ឃុំ ស្វាយ ចេក ស្រុក ស្វាយ ចេក ខេត្ត បន្ទាយមានជ័យ ។
ការឃាត់ខ្លួន នេះ ពាក់ព័ន្ធ ករណី ប្រើប្រាស់ ឯកសណ្ឋាន ជា អាទិ៍ ដែល មាន ភាពប្រហាក់ប្រហែល គ្នា នឹង នគរបាល ឬ យោធា និង ប្រើប្រាស់ សារធាតុ ញៀន កាលពី វេលា ម៉ោង ១៧៖៣០ នាទី ថ្ងៃទី ១៦ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ ភូមិ តេជោ ភ្នំ ឆ័ត្រ ឃុំ ស្វាយ ចេក ស្រុក ស្វាយ ចេក ។
ក្រោយ ឃាត់ខ្លួន និង សួរចម្លើយ . ជនសង្ស័យ បាន ឆ្លើយ សារភាព ថា ខ្លួន ពិតជា បាន ប្រើប្រាស់ ឯកសណ្ឋាន កងរាជអាវុធហត្ថ ពិតប្រាកដ មែន ហើយ ខ្លួន មិន មែន ជា មន្ត្រី កងរាជអាវុធហត្ថ នោះ ទេ បន្ទាប់មក កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក ស្វាយ ចេក បាន ធ្វើតេស្ត ទឹកនោម រកឃើញ មាន សារធាតុ ញៀន ផងដែរ ។
ដោយ ផ្អែក លើ ចម្លើយ សារភាព និង មាន ឯកសណ្ឋាន ដែល ជា វត្ថុតាង ជាក់ស្តែង . កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក បាន កសាង សំណុំរឿង បញ្ជូន មកកាន់ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត ចាត់ការ បន្ត តាម នីតិវិធី ។
បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ ខេត្ត បញ្ជូន ទៅ សាលាដំបូង ខេត្ត នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ ដើម្បី អនុវត្ត តាម នីតិវិធី ៕ ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ ស្នើ កាតា ជួយ បច្ចេកទេស ផ្នែក គ្រប់គ្រង គរុភ័ណ្ឌ ឥស្លាម នៅ កម្ពុជា
ក្នុង ជំនួប នោះ លោក ទេសរដ្ឋមន្ត្រី បាន ស្នើឲ្យ កាតា ពិនិត្យ លទ្ធភាព ជួយ ដល់ សហគមន៍ ឥស្លាម កម្ពុជា ដូចជា ជួយ ផ្តល់ ជា ទស្សនៈ ក្នុង ការរៀបចំ ច្បាប់ គ្រប់គ្រង គរុភ័ណ្ឌ ឥស្លាម និង ថវិកា បរិច្ចាគ (Zakat) ដោយ បញ្ជូន ក្រុម អ្នកជំនាញ មក កម្ពុជា ដើម្បី ផ្តល់ ជា បទពិសោធន៍ និង ចំណេះដឹង ផ្សេង ៗ ទាក់ទង នឹង ការរៀបចំ ប្រព័ន្ធ គ្រប់គ្រង បរិច្ចាគ (Zakat) ឬ អញ្ជើញ ភាគី កម្ពុជា ទៅ រដ្ឋកាតា ដើម្បី ស្វែងយល់ ជុំវិញ ករណី ខាងលើ ។
ជាង នេះ ទៅ ទៀត លោក ទេសរដ្ឋមន្ត្រី បាន ស្នើឲ្យ រដ្ឋមន្ត្រី ជួយ ពិនិត្យ លទ្ធភាព ក្នុង ការជួយ ដល់ សិស្ស និស្សិត ក្រីក្រ កម្ពុជា ដែល ខ្វះខាត ក្នុង ការបង់ ថ្លៃ សាលារៀន នៅ បណ្តា ប្រទេស ផ្សេង ៗ និង បង្កើន ចំនួន អាហារូបករណ៍ ដល់ សិស្ស និស្សិត ឥស្លាម កម្ពុជា ដើម្បីឱ្យ មាន ឱកាស បាន ទៅ សិក្សា នៅ ថ្នាក់ អនុវិទ្យាល័យ និង វិទ្យាល័យ នៃ វិទ្យាស្ថាន សាសនា នៃ រដ្ឋ កាតា ។
ជាមួយគ្នា នេះ លោក បាន ជម្រាប ពី ស្ថានការណ៍ នៅ កម្ពុជា ក្រោម ការដឹកនាំ ប្រកប ដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី និង បន្ត មក សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី បច្ចុប្បន្ន បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា ទទួលបាន សុខ សន្តិភាព ព្រមទាំង បាន ធ្វើឲ្យ មាន សុខដុមនីយកម្ម ជាតិ សាសន៍ និង សាសនា ប្រជាជន ត្រូវបាន យកចិត្តទុកដាក់ ពី រាជ រដ្ឋាភិបាល ដោយ មិន មាន ការរើសអើង ពូជសាសន៍ ឡើយ ។
ជា ការឆ្លើយតប លោក រដ្ឋមន្ត្រី បាន ឯកភាព ជា គោលការ ក្នុង ការជួយ ផ្តល់ ជា ទស្សនៈ ឬ ការផ្តល់ ជា បទពិសោធន៍ ផ្សេង ៗ ជុំវិញ ការបង្កើត ប្រព័ន្ធ គ្រប់គ្រង ថវិកា បរិច្ចាគ តាម ច្បាប់ ឥស្លាម ។ លោក រដ្ឋមន្ត្រី ក៏ បាន ឲ្យ ក្រុមការងារ របស់ លោក ធ្វើ ការសិក្សា ជុំវិញ លទ្ធភាព ជួយ ដល់ សិស្ស និស្សិត កម្ពុជា ដែល កំពុង ជួប ការលំបាក ក្នុង ការបង់ ថ្លៃ សាលារៀន នៅ បរទេស ។
ជា ចុងបញ្ចប់ លោក បាន សម្តែង នូវ អារម្មណ៍ រីករាយ និង គាំទ្រ ជាខ្លាំង ដែល រដ្ឋាភិបាល កម្ពុជា យកចិត្តទុកដាក់ លើ ប្រជាពលរដ្ឋ ទូទៅ ដោយ មិន មាន ការរើសអើង ជាពិសេស នោះ គឺ សហគមន៍ ឥស្លាម កម្ពុជា ត្រូវបាន យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការងាយស្រួល ប្រតិបត្តិ សាសនា និង ធ្វើ ការងារ ផ្សេង ៗ ៕
គណបក្ស នយោបាយ និង សង្គម ស៊ីវិល ជាង ៣០ នៅ កម្ពុជា ចេញ សេចក្តីថ្លែងការណ៍ ថ្កោលទោស គណបក្ស ភ្លើង ទៀន ចំពោះ ទង្វើ គំរាមកំហែង ដល់ អង្គ បោះឆ្នោត
( ភ្នំពេញ ) ៖ គិត រហូតមកដល់ ពេលនេះ គណបក្ស នយោបាយ និង សង្គម ស៊ីវិល ជាង ៣០ ហើយ ដែល បាន ចេញ សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស គណបក្ស ភ្លើង ទៀន ចំពោះ ទង្វើ គំរាមកំហែង ដល់ សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល ជា អង្គ បោះឆ្នោត ។
គណបក្ស នយោបាយ និង សង្គម ស៊ីវិល ទាំងនោះ បាន ចាត់ទុក ថា ទង្វើ គណបក្ស ភ្លើង ទៀន ជា ការគំរាមកំហែង ការរំលោភ ការ សម្ងាត់ និង ធ្វើឱ្យ បាត់ ទំនុកចិត្ត លើ ការបោះឆ្នោត សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល ផ្ទុយទៅនឹង មាត្រា ៧១ នៃ ច្បាប់ ស្តីពី ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ។
ខាងក្រោម នេះ ជា បញ្ជី ឈ្មោះ គណបក្ស នយោបាយ និង សង្គម ស៊ីវិល ដែល បាន ថ្កោលទោស គណបក្ស ភ្លើង ទៀន៖
* គណបក្ស នយោបាយ៖
១៖ គណបក្ស កម្លាំង ប្រជាធិបតេយ្យ ២៖ គណបក្ស មូលីណា កា៣៖ គណបក្ស កម្ពុជា សេរី ឯករាជ្យ ប្រជាធិបតេយ្យ ៤៖ គណបក្ស អំណាច ប្រជាពលរដ្ឋ ៥៖ គណបក្ស ឯកភាព ជាតិ ខ្មែរ ៥៖ គណបក្ស ខ្មែរ តែ មួយ ៧៖ គណបក្ស មហាសាមគ្គី ជាតិ ខ្មែរ ៨៖ គណបក្ស ខ្មែរ អភិវឌ្ឍន៍ សេដ្ឋកិច្ច ៩៖ គណបក្ស នគរ ប្រជាធិបតេយ្យ ១០៖ គណបក្ស ចលនា ប្រជាធិបតេយ្យ ១១៖ គណបក្ស ធម្មាធិបតេយ្យ ១២៖ គណបក្ស យុវជន កម្ពុជា
* សង្គម ស៊ីវិល៖
១៖ សមាគម ក្រុមការងារ ១០០ រាត្រី ២៖ អង្គការ - សមាគម ទាំង ១២៣៖ ក្រុម យុវជន សង្គម ស៊ីវិល និង ក្រុម សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ៤៖ សមាគម យុវជន ខ្មែរ មហានគរ ៥៖ សហជិព - សមាគម - ក្រុមហ៊ុន ទាំង១០
សេចក្ដីប្រកាស ព័ត៌មាន បាន ឲ្យដឹង ថា តាម សំណើ សុំ វិនិយោគ របស់ ក្រុមហ៊ុន ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន សម្រេច ចេញ វិញ្ញាបនបត្រ ចុះបញ្ជី គម្រោង វិនិយោគ មាន លក្ខណសម្បត្តិ គ្រប់គ្រាន់ ចំនួន ២២ ដែល មាន ទុន វិនិយោគ សរុប ប្រមាណ ជាង ៤៤៤ លាន ដុល្លារ អាម៉េរិក ។
ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន បញ្ជាក់ ថា ក្នុង រយៈពេល ១៥ ថ្ងៃ នៃ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ គម្រោង វិនិយោគ ដែល ទទួលបាន ការអនុម័ត រួម មាន៖
ការបញ្ជាក់ យ៉ាង ដូច្នេះ របស់ សម្ដេច ធិបតី ធ្វើឡើង ក្នុង ពិធី បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា ) ដែល មាន តម្លៃ ជាង ៦០ លាន ដុល្លារ នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
សម្ដេច ធិបតី បាន បន្ត ថា ក្នុង ប្រវត្តិសាស្ត្រ កម្ពុជា គឺ ធ្លាប់ ផ្លាស់ប្ដូរ រាជធានី ច្រើន លើក មក ហើយ រាប់ តាំងពី រាជធានី អង្គរ រហូតមកដល់ រាធានី ភ្នំពេញ បច្ចុប្បន្ន នេះ ដូច្នេះ មិន ចាំបាច់ លើក រាជធានី ទៅ កន្លែង ផ្សេង ទៀត ទេ គឺ ត្រូវ ពង្រឹង ការអភិវឌ្ឍ នៅ ហ្នឹង កន្លែង ពង្រីក ហេដ្ឋារចនាសម្ពន្ធ នៅ ទីក្រុង ភ្នំពេញ បច្ចុប្បន្ន ឱ្យ កាន់តែ រីកចម្រើន ។
គួរ ជម្រាប ដែរ ថា នៅក្នុង តំបន់ អាស៊ាន មាន ប្រទេស ចំនួន ៣ ដែល បាន ផ្លាស់ប្ដូរ និង កំពុង ផ្លាស់ប្ដូរាជធានី / រដ្ឋធានី របស់ ខ្លួន ក្នុង នោះ រួម មាន៖
ការអំពាវនាវ នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
សម្តេច បញ្ជាក់ ដូច្នេះ ថា៖ « រឿង ប៉ូលិស ចាប់ រឿង ប៉ូលិស បាញ់ ( ល្បឿន ) មិន បាញ់ យើង ពុំ គួរ ព្រួយបារម្ភ ពេក ថា នៅ កន្លែងណា អ្វី ដែល យើង គួរតែ ព្រួយបារម្ភ ហើយ យកចិត្តទុកដាក់ គឺ ថា ប្រជាពលរដ្ឋ របស់ យើង មាន ការ ស្វ័យ ទទួលខុសត្រូវ ក្នុង ការបើកបរ ដោយ បើកបរ មិន លើស ល្បឿន និង បើកបរ ដោយ មិន ប្រើ គ្រឿងស្រវឹង អា ហ្នឹង ជា ការងារ ល្អ » ។
កាលពី ពេល ថ្មី ៗ នេះ នគរបាល ខេត្ត កំពត បាន ដាក់ ស្លាក សម្គាល់ នៅលើ ផ្លូវ ជាតិ លេខ ៣ ដោយ ផ្តល់ ដំណឹង ដល់ អ្នកបើក ទាក់ទង នឹង ការកំណត់ ល្បឿន ក្រោម ៨០ គីឡូម៉ែត្រ ក្នុង មួួយ ម៉ោង ។ ស្លាក សម្គាល់ នេះ ក៏ ដាក់ បន្ថែម រូប នគរបាល ចរាចរណ៍ ឈរ បាញ់ ល្បឿន ផងដែរ ។
រូប នៃ ស្លាក សម្គាល់ នេះ ត្រូវបាន គេ បញ្ជូន ទៅដល់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ។ សម្តេច បាន លើកឡើង ថា ប្រសិនបើ ដាក់ ស្លាក បញ្ជាក់ បែប នេះ អាច ធ្វើឱ្យ អ្នកបើកបរ ល្មើស បន្ថយ ល្បឿន នៅ កន្លែង លើក ស្លាក តែ អាច បង្កើន ល្បឿន កន្លែង ដែល គ្មាន ស្លាក ។
សម្តេច សង្ឃឹម ថា ប្រជាពលរដ្ឋ ខ្មែរ នឹង មិន គិត ថា បើកបរ កន្លែងណា កុំ ឱ្យ ប៉ូលិស ចាប់ នោះ ទេ ប៉ុន្តែ សម្តេច សូម ឱ្យ គិត ថា បើកបរ ដោយ ទទួលខុសត្រូវ ដោយ ខ្លួន មិន ចង់ ធ្វើជា ឃាតករ សម្លាប់ អ្នក ផ្សេង ឬមួយ ធ្វើឱ្យ ខូច ទ្រព្យសម្បត្តិ ខ្លួន ឯង ទេ ។
សម្តេច បាន លើក ឧទាហរណ៍ អំពី ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅលើ ផ្លូវ ល្បឿន លឿន នា ថ្មី ៗ នេះ ដែល មនុស្ស មួយ រថយន្ត ស្លាប់ ស្ទើរតែ ទាំងអស់ នៅសល់ តែ ម្នាក់ ប៉ុណ្ណោះ ។ សម្តេច ចង់ឱ្យ ប្រជាពលរដ្ឋ បើកបរ ដោយ មាន ការទទួលខុសត្រូវ ប្រុងប្រយ័ត្ន ដោយ ខ្លួន ឯង ហើយ កុំ ខ្លាច ប៉ូលិស ចាប់ ឱ្យ សោះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ដល់ អ្នកបើកបរបង្ក គ្រោះថ្នាក់ ចរាចរណ៍ ទាំងអស់ កុំ ព្យាយាម គេចខ្លួន ប៉ុន្តែ ត្រូវ ចូល ខ្លួន ទទួលខុសត្រូវ ផងដែរ ៕ ប .ស. ស រៀបចំ កម្មវិធី ផ្សព្វផ្សាយ ស្តីពី វិជ្ជា សង្គ្រោះ បឋម ដល់ មន្ត្រី បុគ្គលិក ប .ស. ស ដើម្បី ជួយសង្គ្រោះ ពលរដ្ឋ និង កម្មករ
ក្នុង ពិធី នេះ ដែរ បាន ធ្វើឡើង នៅ ទីស្នាក់ការ បេឡា ជាតិ សន្តិសុខ សង្គម លោក ហេង សុផាន់ ណារិទ្ធ អគ្គ នាយក រង ប .ស.ស . នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ថ្លែង ថា វិជ្ជា សង្គ្រោះ បឋម គឺជា មុខវិជ្ជា ដ៏ មាន សារសំខាន់ មួយ ដែល យើង ទាំងអស់ គ្នា ត្រូវ សិក្សា ដើម្បី ទុក ជា មូលដ្ឋានគ្រឹះ សម្រាប់ សង្គ្រោះ ប្រជាពលរដ្ឋ នៅក្នុង សហគមន៍ ជាពិសេស កម្មករ និយោជិត ដែល រងគ្រោះថ្នាក់ ដោយ ចៃដន្យ ។
គួរ បញ្ជាក់ ដែរ ថា នៅ ឆ្នាំ ២០២៣ កន្លងទៅ ក្រុម គ្រូបង្គោល វិជ្ជា សង្គ្រោះ បឋម នៃ ប .ស.ស . បាន ចុះ អប់រំ ផ្សព្វផ្សាយ អំពី វិជ្ជា សង្គ្រោះ បឋម ជូន ដល់ កម្មករ និយោជិត តាម បណ្តា រោងចក្រ សហគ្រាស បាន ចំនួន ៥៨លើ ក ដោយ មាន អ្នកចូលរួម សរុប ៤.០៨៤ នាក់ ស្រី ២. ៧៤២នាក់ ផងដែរ ៕
លោក បណ្ឌិត កា ម៉ាធុល៖ ការវាយប្រហារ ដោយ ទ័ព ជើងគោក របស់ អ៉ី ស្រាអែល លើ ហា ម៉ាស់ កើតឡើង ទៅ បាន លុះត្រាតែ មាន ការវាយ បក ពី ក្រុមហា ម៉ាស់ វិញ តែ ប៉ុណ្ណោះ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត កា ម៉ាធុល អ្នកជំនាញ ភូមិសាស្រ្ត នយោបាយ បាន លើកឡើង ថា « បើ ទោះជា មាន ការគំរាម ក្នុង ការប្រើប្រាស់ ទ័ព ជើងគោក វាយប្រហារ លើ ក្រុមហា ម៉ាស់ នៅ ទីក្រុង Rafah ហើយ នាំឲ្យ មាន ការប្រឆាំង និង ព្រួយបារម្ភ ជាច្រើន ពីសំណាក់ អង្គការ អន្តរជាតិ និង បណ្ដា ប្រទេស នានា លើ ពិភ លោក ពិតប្រាកដ មែន ប៉ុន្តែ អ៉ី ស្រាអែល អាចនឹង វាយប្រហារ លើ ហាម៉ាស នៅ ពេល ដែល មាន ការបាញ់ តបត វិញ ពីសំណាក់ ក្រុមហា ម៉ាស់ នៅក្នុង ការវាយប្រហារ រយៈ ទ័ព អាកាស នេះ វិញ តែ ប៉ុណ្ណោះ » ។
អភិបាល ខេត្ត ព្រះវិហារ ណែនាំឲ្យ ពង្រឹង សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ក្នុង ព្រឹត្តិការណ៍ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា
( ព្រះវិហារ ) ៖ លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត បាន ណែនាំ ដល់ អាជ្ញាធរដែនដី និង សមត្ថកិច្ច ពាក់ព័ន្ធ នានា នៅ តាម ក្រុង ស្រុក ទូទាំង ខេត្ត ត្រូវ យកចិត្តទុកដាក់ រក្សា សុវត្ថិភាព ជូន អង្គ បោះឆ្នោត ក៏ ដូចជា រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ឲ្យបាន ល្អ ប្រសើរ អំឡុង ពេល បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ដែល នឹង ប្រព្រឹត្តទៅ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
ការថ្លែង ណែនាំ របស់ លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ដឹកនាំ កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ ដោយ មាន ការចូលរួម ពី លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ លោក លោកស្រី ជា ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត លោក អភិបាល ក្រុង ស្រុក ទាំង៨ មេឃុំ ចៅសង្កាត់ និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន ទៀត ។
លោក បាន បញ្ជាក់ ថា បញ្ហា សន្តិសុខ សណ្តាប់ធ្នាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ក៏ ដូចជា សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង មហាផ្ទៃ ស្តីពី ការបង្ខិតបង្ខំ គម្រាមកំហែង អ្នកបោះឆ្នោត ក៏ ដូចជា សេចក្តីថ្លែងការណ៍ របស់ គ.ជ. ប ស្តីពី ការគម្រាមកំហែង សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឲ្យ បោះឆ្នោត ជូន គណបក្ស នេះ ឬ គណបក្ស នោះ ជា ការរំលោភ សិទ្ធ ក្នុង ការសម្រេចចិត្ត របស់ អង្គ បោះឆ្នោត ។
ជាមួយគ្នា នេះ លោក គីម រិទ្ធី ក៏ បាន ប្រាប់ អង្គប្រជុំ ពី ការចុះ ពិនិត្យ ណែនាំ និង ផ្អាក ជា បណ្តោះអាសន្ន ការប្រកប អាជីវកម្ម ឆ្នោត ឡូតូ តាម អនឡាញ សរុប បាន ចំនួន ១២៨ ទីតាំង ។
លោក បាន ផ្តល់ អនុសាសន៍ ដឹកនាំ មួយចំនួន សម្រាប់ រដ្ឋបាល ក្រុង ស្រុក និង កម្លាំងប្រដាប់អាវុធ យក ទៅ អនុវត្ត រួម មាន៖
នៅក្នុង ឱកាស នេះ លោក គីម រិទ្ធី បាន ប្រគល់ រថយន្ត១ គ្រឿង ដល់ គណៈ បញ្ជការ ឯកភាព ក្រុង ព្រះវិហារ ដែល ជា រថយន្ត ទី៥ បន្ទាប់ពី បាន ប្រគល់ជូន រដ្ឋបាល ស្រុក គូលែន ស្រុក រវៀង ស្រុក ឆែប និង ស្រុក ជាំ ក្សាន្ត ៕
ឯកឧត្តម សន្ដិ បណ្ឌិត នេត សាវឿន ផ្ញើ សារ ថ្លែងអំណរគុណ ជូន ចំពោះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ដែល បាន ផ្ញើ សារ ជូនពរ ក្នុង ថ្ងៃ ខួបកំណើត
( ភ្នំពេញ ) ៖ ឯកឧត្តម សន្តិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ផ្ញើ សារលិខិត ថ្លែងអំណរគុណ ជូន ចំពោះ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ដែល ផ្ញើ សារ ជូនពរ លោក ក្នុង ឱកាស ថ្ងៃ ខួបកំណើត ។
តាមរយៈ លិខិត ថ្លែងអំណរគុណ នេះ ឯកឧត្តម សន្ដិ បណ្ឌិត នេត សាវឿន បាន រៀបរាប់ យ៉ាង ដូច្នេះ ថា៖
« ខ្ញុំបាទ និង ភរិយា មាន សេចក្តី សោមនស្ស រីករាយ ក្រៃលែង ឥត ឧបមា និង មាន កិត្តិយស ដ៏ ឧត្តុង្គឧត្តម ដោយ បាន ទទួល នូវ សព្ទ សាធុការ ពរ ដ៏ ថ្លៃថ្លា ប្រកបដោយ មនោសញ្ចេតនា យ៉ាង ជ្រាលជ្រៅ ពី សម្តេច មហា បវរធិបតី ក្នុង ឱកាស ខួបកំណើត របស់ ខ្ញុំបាទ ។
ឆ្លៀត ក្នុង ឱកាស នេះ ខ្ញុំបាទ និង ភរិយា សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ គុណ កែវ ទាំង បី វត្ថុ ស័ក្តិសិទ្ធិ ទាំងឡាយ ក្នុង លោក និង បុណ្យ បារមី បុព្វបុរស ខ្មែរ ថែរក្សា ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា សូម តាម ជួយ ថែរក្សា ការពារ និង ប្រទាន ពរ ជ័យ សិរី មង្គល វិបុល សុខ គ្រប់ ប្រការ ជូន ចំពោះ សម្តេច មហា បវរធិបតី និង លោកជំទាវ បណ្ឌិត ព្រមទាំង ក្រុមគ្រួសារ សូម បាន ប្រកប នូវ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ ជានិច្ច និរន្តរ៍ កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕
គួរ បញ្ជាក់ ថា ចំណាត់ការ នេះ កើត មាន ឡើង បន្ទាប់ពី ក្រុម កសិករ យល់ព្រម ផ្អាក ការតវ៉ា ដោយ សំដៅ ដង្ហែ ក្បួន ចូលក្នុង ទីក្រុង ញូវ ដែលី កាលពី ថ្ងៃអាទិត្យ ចុង សប្តាហ៍ កន្លងទៅ ។ យ៉ាង នេះ ក្តី សហជីព កសិករ និយាយ ថា ពួកគេ នឹង ចំណាយ ពេល ១ - ២ ថ្ងៃ ដើម្បី ធ្វើ ការសម្រេចចិត្ត លើ សំណើ កិច្ចព្រមព្រៀង របស់ រដ្ឋាភិបាល នេះ បន្ទាប់ពី ឈានដល់ ការឯកភាព គ្នា ក្នុង ចំណោម ពួកគេ ផ្ទាល់ ៕
លោក បណ្ឌិត ថោង ខុន ជួប សំណោះ សំណាល និង បង្រៀន គូស សន្លឹក ឆ្នោត ដល់ អង្គ បោះឆ្នោត ក្នុង ស្រុក តាំង គោក ដើម្បី ត្រៀម បោះឆ្នោត ព្រឹទ្ធសភា នីតិកាល ទី៥
( កំពង់ធំ )៖ លោក បណ្ឌិត ថោង ខុន សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា អនុប្រធាន ទី១ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត កំពង់ធំ នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល និង បង្រៀន គូស សន្លឹក ឆ្នោត ដល់ អង្គ បោះឆ្នោត នៅក្នុង ស្រុក តាំង គោក ដើម្បី ត្រៀម បោះឆ្នោត ព្រឹទ្ធសភា នីតិកាល ទី៥ នៅ ថ្ងៃអាទិត្យ ទី២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខណៈ ដែល គណបក្ស ប្រជាជន កម្ពុជា មាន រូប សញ្ញា ទេវតា បាច ផ្កា ជា សញ្ញា សំគាល់ និង មាន លេខរៀង ទី១ នៃ សន្លឹក ឆ្នោត ។
ពិធី នេះ បាន ធ្វើឡើង នៅ វត្ត ថ្លា ស្រុក តាំង គោក ដោយ មាន ការចូលរួម ពី លោកស្រី ឃួន ឃុន ឌី បេក្ខភាព សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ លោក ឈាង វណ្ណា រិទ្ធ អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក តាំង គោក និង លោក លោកស្រី ជា សមាជិក ក្រុមការងារ ចុះ ជួយ ស្រុក តាំង គោក លោក ហាក់ ម៉ុង ហួត ប្រធាន គណបក្ស ស្រុក តាំង គោក និង សមាជិក ក្រុមប្រឹក្សា ឃុំ នៃ ស្រុក តាំង គោក ជាច្រើន រូប ផងដែរ ។
លោក បណ្ឌិត ថោង ខុន ក៏ បាន បញ្ជាក់ ទៀត ថា ការបោះឆ្នោត ព្រឹទ្ធសភា នា ថ្ងៃអាទិត្យ ទី២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខាងមុខ នេះ ជា ការបោះឆ្នោត អសកល ផង ជា ការជ្រើសតាំង ដោយ រដ្ឋសភា ផង និង ចាត់តាំង ដោយ ព្រះមហាក្សត្រ ផង ។ ការបោះឆ្នោត ព្រឹទ្ធសភា នេះ គឺ ដើម្បី បន្ត និរន្តភាព ការគ្រប់គ្រង និង អភិវឌ្ឍ ប្រទេស ពិសេស ការបន្ត ថែរក្សា សន្តិភាព ដែល យើង ខំ ថែរក្សា ជា យូរ មកហើយ ជាពិសេស សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នឹង ត្រូវ ជ្រើសតាំង ជា ប្រធាន ព្រឹទ្ធសភា ។
បន្ថែម ពី នេះ លោក បណ្ឌិត ថោង ខុន បាន បញ្ជាក់ ដែរ ថា ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ខាងមុខ នេះ គឺជា ការបោះឆ្នោត ដែល ប្រព្រឹត្ត ដោយ រលូន សេរីភាព រក្សា ការសម្ងាត់ និង ប្រជាធិបតេយ្យ យ៉ាង ពិតប្រាកដ ហេីយ ការបោះឆ្នោត នេះ គឺ កេីត ចេញ ឆន្ទះ របស់ ពលរដ្ឋ ដោយ មិន មាន ការបង្ខិតបង្ខំ ឫ គំរាមកំហែង ដោយ ប្រការ ណាមួយ នោះ ឡេីយ ។
ជាមួយគ្នា នោះ ដែរ លោក បណ្ឌិត ថោង ខុន ក៏ បាន អំពាវនាវ ឱ្យ អង្គ បោះឆ្នោត ទាំងអស់ ចាប់ពី ថ្ងៃ នេះ រហូតដល់ ថ្ងៃ បោះឆ្នោត ថែរក្សា សុខភាព ឲ្យបាន ល្អ កុំ ទៅ ណា ឆ្ងាយ ៗ កុំ ពិសារ គ្រឿងស្រវឹង និង ទុកដាក់ អត្តសញ្ញាណ បណ្ណ សម្រាប់ បោះឆ្នោត ឲ្យបាន ល្អ ដើម្បី បាន ទៅ បោះឆ្នោត ព្រឹទ្ធសភា នីតិកាល ទី៥ នៅ ថ្ងៃអាទិត្យ ទី២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខាងមុខ ឱ្យ បាន គ្រប់ ៗ គ្នា ។
( ភ្នំពេញ ) ៖ គិត ពី ថ្ងៃទី ១២ ដល់ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ពោលគឺ រយៈពេល ១សប្ដាហ៍ សមត្ថកិច្ច នៃ ក្រសួង មហាផ្ទៃ បាន បើក ប្រតិបត្តិការ បង្ក្រាប ល្បែងស៊ីសង សរុប ចំនួន ១៤៨ ករណី ឃាត់ខ្លួនអ្នក ពាក់ព័ន្ធ ចំនួន ១៨៧ នាក់ ក្នុង នោះ បញ្ជូន ទៅ តុលាការ ចំនួន ១៣នាក់ និង អប់រំ ណែនាំ ធ្វើ កិច្ចសន្យា បញ្ឈប់ ចំនួន ១៧៤ នាក់ ។ នេះ បើ តាម លោក ទូច សុឃៈ ( សុខៈ ) អ្នកនាំពាក្យ រង ក្រសួង មហាផ្ទៃ ។
អ្នកនាំពាក្យ រង រូប នេះ បញ្ជាក់ បន្ថែម ថា ក្រោម ការបង្ក្រាប ល្បែងស៊ីសង ខុស ច្បាប់ នេះ សមត្ថកិច្ច ជំនាញ នៃ ក្រសួង មហាផ្ទៃ បាន អនុវត្ត វិធានការ ច្បាប់ ដោយ កសាង សំណុំរឿង ចំនួន ៤ករណី ដែល មាន ជនសង្ស័យ ចំនួន ១៣នាក់ បញ្ជូន ទៅកាន់ តុលាការ ចាត់ នីតិវិធី ចោទប្រកាន់ ផ្ដន្ទាទោស ។ ក្រៅពី នេះ ចំនួន ១៤៤ ករណី ទៀត ដែល មាន អ្នក ពាក់ព័ន្ធ ចំនួន ១៧៤ នាក់ រួម មាន៖
* ខេត្ត បាត់ដំបង ១៣៦ ករណី * ខេត្ត កំពត ៥ករណី * ខេត្ត តាកែវ ១ករណី * ខេត្ត ប៉ៃលិន ១ករណី * ខេត្ត ត្បូងឃ្មុំ ១ករណី ។ នគរបាល ក្រសួង មហាផ្ទៃ បាន ចាត់ វិធានការ រដ្ឋបាល ពោលគឺ អប់រំ ណែនាំ និង ធ្វើ កិច្ចសន្យា បញ្ឈប់ សកម្ម មិន ឱ្យ ប្រព្រឹត្ត តទៅទៀត ។
លោក ទូច សុឃៈ លើកឡើង ថា ក្រោម ការដឹកនាំ ប្រកបដោយ ភាពប៉ិនប្រសព្វ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល មាន ក្រសួង មហាផ្ទៃ ជា សេនាធិការ ក្រោម ការដឹកនាំ របស់ អភិសន្តិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បាន ដឹកនាំ បញ្ជា ឱ្យ សមត្ថកិច្ច យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ទិសដៅ អាទិភាព សំខាន់ ៗ ជាពិសេស ទិសដៅ អាទិភាព ទាំង៦ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង នីតិកាល ទី៧ នេះ ក្នុង នោះ ក៏ មាន ការ បង្ក្រាប ល្បែងស៊ីសង ខុស ច្បាប់ នេះ ផងដែរ ។
ន័រវែស នឹង ជួយ សម្របសម្រួល ការផ្ទេរ មូលនិធិ ពន្ធ ទៅដល់ អាជ្ញាធរ ប៉ាឡេស្ទីន
( អូស្លូ) ៖ រដ្ឋាភិបាល ន័រវែស បាន ប្រកាស ថា នឹង ជួយ សម្រួល ដល់ ការផ្ទេរ មូលនិធិ ពន្ធ ដែល អ៉ី ស្រាអែល ប្រមូល បាន ហើយ ត្រូវបាន បង្កក ទៅ ឱ្យ អាជ្ញាធរ ប៉ាឡេស្ទីន តាមរយៈ បណ្តាញ អង្គភាព គាំទ្រ ដោយ លោក ខាងលិច ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃចន្ទ ទី១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
នៅក្រោម កិច្ចព្រមព្រៀង សន្តិភាព បណ្តោះអាសន្ន ឆ្នាំ ១៩៩០ ក្រសួង ហិរញ្ញវត្ថុ អ៉ី សា្រអែល ជា អ្នក ប្រមូល ពន្ធ ជំនួស មុខ ឱ្យ អាជ្ញាធរ ប៉ាឡេស្ទីន ហើយ ត្រូវ ធ្វើ ការផ្ទេរ ជារៀងរាល់ ខែ ទៅ អាជ្ញាធរ ប៉ាឡេស្ទីន ប៉ុន្តែ ការវាយប្រហារ ថ្ងៃទី ៧ ខែតុលា របស់ ក្រុមហា ម៉ាស ធ្វើឱ្យ ដំណើរការ នេះ ត្រូវ ជាប់គាំង ។
ន័រវែស និយាយ ថា ដំណោះស្រាយ បណ្តោះអាសន្ន នេះ នឹង បើក ឱ្យ ការទូទាត់ នានា ដំណើរការ ឡើងវិញ ហើយ ទប់ស្កាត់ បាន នូវ ការដួលរលំ នៃ អាជ្ញាធរ ប៉ាឡេស្ទីន ដោយ ការមាន លទ្ធភាព បើក ប្រាក់ខែ និង ផ្តល់ សេវាកម្ម សំខាន់ ៗ ដូច ដា សាលារៀន មន្ទីរ ថែទាំ សុខភាព ជាដើម ។ បើ តាម នាយក រដ្ឋមន្រ្តី ន័រវែស លោក Jonas Gahr Stoere « នេះ សបញ្ជាក់ អំពី ការធ្វើឱ្យ ប្រសើរឡើង នូវ ស្ថិរភាព ក្នុង តំបន់ និង សម្រាប់ អាជ្ញាធរ ប៉ាឡេស្ទីន មាន លទ្ធភាព ការពារ ប្រជាជន របស់ ខ្លួន » ។
គួរ បញ្ជាក់ ថា ក្រោម កិច្ចព្រមព្រៀង ដំណោះស្រាយ គាំទ្រ ដោយ ក្រុម មន្រ្តី អ៉ី ស្រាអែល និង ប៉ាឡេស្ទីន ន័រវែស នឹង ធ្វើ ការ ក្នុង នាម ជា អន្តរ ការី កាន់កាប់ ប្រាក់ ចំណូល ដែល អ៉ី ស្រាអែល ប្រមូល បាន ចាប់តាំងពី ថ្ងៃទី ៧ ខែតុលា ៕ រូបភាព ពី Reuters អភិបាល ខេត្ត រតនគិរី បញ្ជា ឲ្យ ផ្អាក ល្បែងស៊ីសង តាម អនឡាញ នៅ ទូទាំង ខេត្ត ជា បណ្តោះអាសន្ន
( រតនគិរី ) ៖ លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន បញ្ជា ឲ្យ នគរបាល ប៉ុស្តិ៍ និង អធិការ នគរបាល ស្រុក ក្រុង ទាំងអស់ ត្រូវ បញ្ឈប់ មិន ឲ្យ មាន បើក ល្បែង ស៉ី សង តាម ទូរទស្សន៍ អនឡាញ ( ឆ្នោត ឡូតូ ) ទាំងអស់ ផ្អាក ជា បណ្តោះអាសន្ន ។
ការបញ្ជា របស់ លោក អភិបាល ខេត្ត ធ្វើឡើង បន្ទាប់ពី សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដាក់ បទបញ្ជា ឲ្យ អភិបាល រាជធានី ខេត្ត បាន ចេញ បទបញ្ជា ឲ្យ ផ្អាក រាល់ ការចេញ អាជ្ញា បណ្ណ ក្នុង ការផ្តល់ សិទ្ធិ បើក ទីតាំង ល្បែង ផ្សង សំណាង បន្ថែម នៅ តាម មូលដ្ឋាន ។
ជាមួយគ្នា នោះ សម្តេច ធិបតី បាន ឲ្យ គណៈកម្មការគ្រប់គ្រង ល្បែង ពាណិជ្ជកម្ម កម្ពុជា ជា ចំណុះ ឲ្យ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដឹកនាំ ប្រជុំ ជាបន្ទាន់ ជាមួយ សមត្ថកិច្ច អាជ្ញាធរ រួម បណ្តា អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដើម្បី ពិនិត្យ ឡើងវិញ និង រៀបចំ ឡើងវិញ រួមទាំង គោលការណ៍ និង ការគ្រប់គ្រង ល្បែង ផ្សង សំណាង នានា នៅ ទូទាំង ប្រទេស ។
សម្តេច បាន ដាក់បញ្ជា ឲ្យ គណៈ អភិបាល រាជធានី ខេត្ត ចាត់ វិធានការ ជាបន្ទាន់ ដើម្បី ត្រួតពិនិត្យ ទីតាំង ល្បែង ផ្សង សំណាង នៅ តាម មូលដ្ឋាន ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ក្នុង ករណី នៅ មាន បន្ត បើក ថ្មី ថែម ទៀត សូម ចាត់ វិធានការបិទ ជាបន្ទាន់ ដើម្បី ចាត់ វិធានការ ដែល អាច ឈាន ទៅដល់ ការដក អាជ្ញាបណ្ណ ក្នុង ខេត្ត ឬ នៅ ទូទាំង ប្រទេស តែម្តង ៕
រោងចក្រ ម្សៅ មី « ជា ទូច » នៅ ស្រុក អូរយ៉ាដាវ ខេត្ត រតនគិរី កំពុង មមាញឹក ទិញ ដំឡូង មី ស្រស់ ដោយ មិន ចាំបាច់ ដឹក ទៅ ប្រទេស ជិតខាង តែ ត្អូញត្អែរ ថា ខ្វះ កម្មករ ដោយសារ មាន សង្វាក់ ផលិតកម្ម ច្រើន
លោកស្រី បន្ត ថា ក្នុង មួយ ថ្ងៃ ៗ ក្រុមហ៊ុន អាច ទទួល ទិញ ពី ក្រុម ឈ្មួញ កណ្តាល ដឹក មកពី បណ្តា ខេត្ត មួយចំនួន ដូច ជា៖ ខេត្ត ឧត្តរមានជ័យ . ព្រះវិហារ . ក្រចេះ . ស្ទឹងត្រែង និង ខេត្ត រតនគិរី ។
លោកស្រី ថា រោងចក្រ អាច ផលិត ដំឡូង មី ស្រស់ បាន ចំនួន ១.២០០ តោន ទៅជា ម្សៅ មី បាន ចំនួន ៣០០តោន ក្នុង រយៈពេល ២៤ ម៉ោង ។ ការទិញ ដំឡូង មី ស្រស់ ចូល រោងចក្រ នៅ ថ្ងៃទី ១៩ ខែកុម្ភៈ តម្លៃ ក្នុង ១គីឡូក្រាម ៥០០ - ៥២០ រៀល ទៅ តាម ទីផ្សារ នៅ ប្រទេស វៀតណាម ហើយ កាត់ ចំនួន ២១ ភាគរយ ទៅ តាម ប្រភេទ ដំឡូង ជាក់ស្តែង ( ដី ឫស កាកសំណល់ ផ្សេង ៗ ) ហើយ កម្មករ ជំនាញ និង កម្មករ ធម្មតា ទទួលបាន ប្រាក់ខែ សមរម្យ ដោយ ផ្តល់ កន្លែង ស្នាក់ នៅ . ការហូបចុក និង ឈឺ ស្កាត់ ជាដើម ។
លោកស្រី ជា ទូច បន្ថែម ថា រោងចក្រ នេះ អាច ផលិត ម្សៅ មី ក្នុង មួយ ឆ្នាំ ៗ ប្រមាណ ២០០.០០០ តោន សម្រាប់ នាំចេញ ទៅ ក្រៅ ប្រទេស ជាពិសេស ប្រទេស ចិន ។ តែ ទោះជា យ៉ាងណា លោកស្រី បាន ត្អូញត្អែរ ពី កង្វះ កម្លាំង កម្មករ ហើយ ចំណាយ ច្រើន ទៅ លើ ថ្លៃ អគ្គិសនី ការដឹកជញ្ជូន ទៅ ប្រទេស ចិន ( ឆ្លងកាត់ វៀតណាម ) មិន សូវ ចំណេញ ទេ ប៉ុន្តែ សល់ កាក ដំឡូង ធ្វើ ជី . ធ្វើ ចំណីអាហារ សត្វ លក់ បាន ថវិកា ខ្លះ ។
អាជ្ញាធរ ពន្ធនាគារ រុស្ស៉ី បាន អះអាង ថា លោក Navalny ដែល មាន វ័យ ៤៧ ឆ្នាំ នៅ សុខ ៗ ស្រាប់តែ ដួល សន្លប់ បាត់បង់ ស្មារតី ហើយ ទទួលមរណភាព តែម្តង កាលពី ថ្ងៃសុក្រ សប្តាហ៍ មុន ក្រោយ ដើរ ហាត់ប្រាណ ក្នុង ពន្ធនាគារ មួយ កន្លែង នៅ ក្រុង Kharp ចម្ងាយ ប្រហែល១.៩០០ គីឡូម៉ែត្រ ពី ភាគ ឦសាន រដ្ឋធានី មូស្គូ និង ជា ទី ដែល រូបលោក ត្រូវ អនុវត្ត ទោស ជាប់ ពន្ធនាគារ សរុប ចំនួន ៣ទសវត្សរ៍ ។
( ភ្នំពេញ ) ៖ គណបក្ស ហ៊្វុនស៊ិនប៉ិច បាន ចេញ សេចក្តីថ្លែងការណ៍ ជា បន្តបន្ទាប់ ដោយ ថ្កោលទោស គណបក្ស ភ្លើង ទៀន ចំពោះ ទង្វើ គំរាមកំហែង ដល់ សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដែល ជា អង្គ បោះឆ្នោត នៅ មុន ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ខាងមុខ នេះ ។
គណបក្ស ហ៊្វុនស៊ិនប៉ិច ដែល បាន ចូលរួម យ៉ាង ក្លាហាន ក្នុង ការប្រកួតប្រជែង សម្រាប់ ការបោះឆ្នោត ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ មាន ឮ ការខកចិត្ត យ៉ាង ខ្លាំង ក្នុង ការឃើញ គណបក្ស មួយចំនួន ងាកចេញ ពី គោលការណ៍ ប្រជាធិបតេយ្យ ដោយ ប្រើប្រាស់ ការបំភិតបំភ័យ ការគំរាម កំហែង និង ការគាបសង្កត់ សិទ្ធិ និង សេរីភាព ក្នុង ការបោះឆ្នោត តាម ឆន្ទៈ របស់ អង្គ បោះឆ្នោត ។
គណបក្ស ហ៊្វុនស៊ិនប៉ិច បាន ចាត់ទុក ថា សកម្មភាព បែប នេះ មិន ត្រឹមតែ ធ្វើឱ្យ ខូច ដល់ ក្រមសីលធម៌ នៃ លទ្ធិ ប្រជាធិបតេយ្យ ប៉ុណ្ណោះ ទេ ថែម ទាំង ធ្វើឱ្យ ខូច ដល់ ខ្លឹមសារ នៃ ដំណើរការបោះឆ្នោត ដោយ យុត្តិធម៌ ក្បត់ តម្លៃ មូលដ្ឋាន នៃ ប្រព័ន្ធ ពហុ បក្ស និង ឧត្តម គតិ នៃ អភិបាលកិច្ច ប្រជាធិបតេយ្យ ពិតប្រាកដ ។ ជា ការចាំបាច់ ដែល គណបក្ស នយោបាយ ត្រូវ ចៀសវាង ការប្រព្រឹត្តិ ខុស ច្បាប់ និង គេចវេះ ពី គោលការណ៍ ណែនាំ ផ្សេង ៗ នៃ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ។
គណបក្ស ហ៊្វុនស៊ិនប៉ិច តស៊ូ មតិ ដើម្បី លើកតម្កើង និង គោរព តាម មនសិការ សម្បជញ្ញៈ រៀង ៗ ខ្លួន របស់ អង្គ បោះឆ្នោត ជានិច្ច ជាមួយគ្នា នេះ ដែរ គណបក្ស សូម អំពាវនាវ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត ក្នុង ការបោះឆ្នោត ជូន គណបក្ស ហ៊្វុនស៊ិនប៉ិច ដើម្បី ទុក លទ្ធភាព ថ្វាយ ព្រះអង្គម្ចាស់ នរោត្តម ចក្រាវុធ ដើម្បី ដឹកនាំ បង្រួបបង្រួម អ្នក ប្រជាធិបតេយ្យ ជំនាន់ ថ្មី ឲ្យ មាន ភាពរឹងមាំ មាន ទំនុកចិត្ត គ្រប់ មជ្ឈដ្ឋាន និង ពី ប្រជារាស្ត្រ ខ្មែរ ឡើងវិញ ៕
សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ធំ ចុះ អប់រំ ផ្សព្វផ្សាយ ស្ដីពី ការកាត់បន្ថយ ការប្រើប្រាស់ ថង់ ប្លាស្ទិក និង ធ្វើ ពលកម្ម សម្អាត បរិស្ថាន ស្រប តា ពាក្យស្លោក « លា ហើយ ប្លាស្ទិក »
លោក កែវ ផល បាន ឱ្យដឹង ថា គុណវិបត្តិ នៃ ការប្រើប្រាស់ ថង់ ប្លាស្ទិក គឺ ផលិត ឡើង ពី ប្រេង ខ្មៅ និង សារធាតុ គីមី ( តូនិច ) វា មាន ផល អាក្រក់ ខ្លាំង ណាស់ ដល់ បរិស្ថាន វា ត្រូវការ ចំណាយ ពេល រហូតដល់ទៅ ៥០០ ឆ្នាំ ទើប រលាយ និង បញ្ចេញ ជាតិ ពុល ដែល ធ្វើអោយ ប៉ះពាល់ ខ្លាំង ដល់ សភាវៈ មាន ជីវិត ទាំង លើ ដី និង ក្នុង ទឹក ពិសេស ធ្វើអោយ ផែនដី ឡើង កម្ដៅ ដូចនេះ ដើម្បី ចូលរួមចំណែក ក្នុង ការថែរក្សា បរិស្ថាន និង ជីវិត ទាំងឡាយ នៅលើ ភព ផែនដី យើង ទាំងអស់ គ្នា ត្រូវ ចូលរួម ក្នុង ការបញ្ឈប់ ការប្រើប្រាស់ ថង់ ប្លាស្ទិក ។
ថ្ងៃទី ៩ កុម្ភៈ ២០០១៖ លោក បាន ជាប់ ឆ្នោត ជា នាយក រដ្ឋមន្រ្តី ថៃ ។
ថ្ងៃទី ១ កុម្ភៈ ២០០៣៖ លោក បាន បើក យុទ្ធនាការ ទ្រង់ទ្រាយ ធំ ប្រឆាំង បទឧក្រិដ្ឋ គ្រឿងញៀន ដែល បាន សម្លាប់ មនុស្ស ជាង ២. ៨០០នាក់ ។
ថ្ងៃទី ២៨ កុម្ភៈ ២០០៨៖ លោក បាន ត្រឡប់ មកកាន់ ប្រទេស ថៃ ដើម្បី តវ៉ា ចំពោះ ការចោទប្រកាន់ ពាក់ព័ន្ធ អំពើពុករលួយ ។
ថ្ងៃទី ២២ សីហា ២០២៣៖ ទីបំផុត លោក បាន ធ្វើ មាតុភូមិ និវត្តន៍ វិញ ក្រោយ ការរស់នៅ និរទេស ខ្លួន ១៥ ឆ្នាំ ហើយ ភ្លាម ៗ ក៏ ត្រូវបាន នាំ ខ្លួន ទៅកាន់ ពន្ធនាគារ ក្នុង ទីក្រុង បាងកក បន្ទាប់ពី តុលាការ ផ្តន្ទាទោស ដោយ កំបាំងមុខ ឱ្យ ជាប់ ពន្ធនាគារ ៨ ឆ្នាំ ពី បទ រំលោភ អំណាច និង ជម្លោះ ផលប្រយោជន៍ ។
ថ្ងៃទី ២៣ សីហា ២០២៣៖ លោក ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ប៉ូលិស ក្នុង រាជធានី របស់ ថៃ ដោយសារ បញ្ហា សុខភាព ។
ថ្ងៃទី ៣១ សីហា ២០២៣៖ លោក បាន ដាក់ សំណើ សុំ ការព្រះរាជ ទាន លើកលែង ទោស ពី ព្រះមហាក្សត្រ ថៃ ។
ថ្ងៃទី១ កញ្ញា ២០២៣៖ លោក ទទួលបាន ការ ព្រះរាជ ទាន បន្ធូរបន្ថយ ទោស ពី ព្រះមហាក្សត្រ ដែល កាត់ រយៈពេល ជាប់ ពន្ធនាគារ ពី ៨ ឆ្នាំ មក នៅ ត្រឹមតែ ១ ឆ្នាំ ។
ថ្ងៃទី ១៣ ខែកុម្ភៈ ២០២៤៖ រដ្ឋមន្រ្តី យុត្តិធម៌ ថៃ បាន ប្រកាស ថា លោក ថាក់ ស៉ីន ស្ថិត ក្នុង ចំណោម ទណ្ឌិត ចំនួន ៩៤៥ នាក់ ដែល នឹង ត្រូវ ដោះលែង ឱ្យ មាន សេរីភាព មុនពេល កំណត់ ។
ប្រធាន មន្ទីរ រៀបចំ ដែនដី ខេត្ត កំពង់ធំ អំពាវនាវ ពលរដ្ឋ ម្ចាស់ ដី ក្នុង តំបន់ កាត់ ឆ្វៀល ចូលរួម ជាមួយ មន្ត្រី ជំនាញ ដើម្បី វាស់វែង បាន ទាន់ ពេល និង ឆាប់រហ័ស
( កំពង់ធំ )៖ បន្ទាប់ពី រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ អនុក្រឹត្យ កាត់ ឆ្វៀល ដី ជូន ប្រជាពលរដ្ឋ ចេញ ពី តំបន់ ៣ បញ្ចូល មក តំបន់ ២ ក្រុមការងារ ចុះបញ្ជី ដី ក្នុង ខេត្ត កំពង់ធំ បាន វាស់វែង ជូន ប្រជាពលរដ្ឋ ជាបន្ទាន់ លោក អ៊ឹម សុឌីណា ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត កំពង់ធំ ស្នើ អាជ្ញាធរ និង ប្រជាពលរដ្ឋ ជា ម្ចាស់ ដី ក្នុង តំបន់ កាត់ ឆ្វៀល ចូលរួម ជាមួយ មន្ត្រី ជំនាញ ដើម្បី វាស់វែង បាន ទាន់ ពេល និង ឆាប់រហ័ស ។
លោក ស្នើឲ្យ ក្រុមការងារ វាស់វែង ទាំងអស់ ខិតខំ ប្រឹងប្រែង បំពេញ កិច្ចការងារ វាស់វែង ដី ប្រកប ទៅ ដោយ ប្រសិទ្ធភាព តម្លាភាព និង ទទួលខុសត្រូវ ។
លោក ងួន រតនៈ៖ វិស័យ ព្រះពុទ្ធ សាសនា ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការអប់រំ ដែល មិន អាច កាត់ផ្ដាច់ ពី គ្នា
( កំពង់ធំ )៖ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ បាន លើកឡើង ថា វិស័យ ព្រះពុទ្ធ សាសនា ដើរ តួនាទី សំខាន់ ណាស់ សម្រាប់ ប្រជាពលរដ្ឋ គោរព ប្រតិបត្តិ និង ផ្សារភ្ជាប់ រវាង ពុទ្ធ ចក្រ និង អាណាចក្រ ដែល តួអង្គ ទាំង ពីរ នេះ មិន អាច កាត់ផ្ដាច់ ពី គ្នា បាន ឡើយ ហើយ ឥឡូវនេះ ព្រះពុទ្ធ សាសនា មាន ការរីកចម្រើន ដែល ទាមទារ ឲ្យ មាន ការចូលរួម ផ្សព្វផ្សាយ និង ធ្វើ កិច្ចការ នេះ រួមគ្នា បន្ត ទៅ ទៀត ។
លោក ងួន រតនៈ បាន ថ្លែង ដូចនេះ នៅក្នុង ពិធី ស្រោចស្រព សុគន្ធ វារី ប្រគេន ព្រះមហា ធម្មពង្សា សួន តារ៉ា ហេព្ភី ព្រះមេគុណ គណៈ ធម្មយុត្តិក និកាយ ខេត្ត កំពង់ធំ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ វត្ត ព្រះពុទ្ធ ជិន រាជ ភូមិ ក្បិល ឃុំ សាន់គរ ស្រុក កំពង់ស្វាយ ក្នុង នាម តំណាង លោក វង្សី វិស្សុត ។
លោក បាន រំលេច នូវ សរសរស្តម្ភ ទាំង បួន នៃ វិស័យ អប់ រំ៖
លោក បន្ត ទៀត ថា ប្រទេស កម្ពុជា មាន វប្បធម៌ មួយ គឺ « វប្បធម៌ នៃ ការចែករំលែក » ដែល វប្បធម៌ ដ៏ ផូរផង់ នេះ យើង បាន អនុវត្ត រហូតមក ហើយ យើង និង បន្ត កិច្ចការ នេះ បន្ត ទៀត ដោយ ខិតខំ ដោះស្រាយ នូវ បញ្ហា ក្តីកង្វល់ នានា ទៅ តាម លទ្ធភាព ដែល អាច ធ្វើ ទៅ បាន ។
ជាមួយគ្នា នេះ លោក បាន បញ្ជាក់ ប្រាប់ ដល់ ប្រជាពលរដ្ឋ ថា សម្រាប់ ខេត្ត កំពង់ធំ នឹង ទទួលបាន ទំនប់ ទប់ទឹក ដែល អាច ផ្ទុក ទឹក ជាង ៣០០ លាន ម៉ែត្រ គូប និង ចំណាយ ពេល សាងសង់ រួចរាល់ ជាង ២ឆ្នាំ ទៀត ដែល នេះ គឺជា ដំណឹង ល្អ សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត កំពង់ធំ ទាំងមូល ទទួលបាន នូវ ប្រយោជន៍ យ៉ាង ច្រើន ក្នុង វិស័យ កសិកម្ម ។
អង្គការ សប្បុរសធម៌ កាតា នឹង ផ្តល់ ជំនួយ កញ្ចប់ អាហារ ខែរ៉ាម៉ាឌន ខាងមុខ នេះ ដល់ សហគមន៍ ឥស្លាម កម្ពុជា
លោក បាន ស្នើឲ្យ អង្គការ សប្បុរសធម៌ កាតា ផ្តល់ ជំនួយ មនុស្សធម៌ ផ្សេង ៗ ដល់ កម្ពុជា សម្រាប់ ចែកជូន ប្រជាពលរដ្ឋ ក្រក្រី ប្រជាពលរដ្ឋ រងគ្រោះ ដោយសារ គ្រោះ ទឹក ជំនន់ និង ភ្លើង ឆេះ ផ្ទះ ខណៈ ថ្នាក់ដឹកនាំ កម្ពុជា តែងតែ ចុះ ជួប និង ចែក ជា អំណោយ នានា ក្នុង ការដោះស្រាយ បញ្ហា ជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ។ ទន្ទឹម គ្នា នេះ លោក បាន ស្នើសុំ កញ្ចប់ អាហារ ខែរ៉ាម៉ាឌន សម្រាប់ ចែកជូន សាសនិក ឥស្លាម កម្ពុជា ខណៈ បុណ្យ នេះ នឹង ខិត មកដល់ ក្នុង ខែមីនា ខាងមុខ នេះ ។
ជា ការឆ្លើយតប នាយក ប្រតិបត្តិ អង្គការ សប្បុរសធម៌ កាតា បាន បង្ហាញ អាម្មរណ៍ សប្បាយរីករាយ និង កោតសរសើរ ជាខ្លាំង ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា បន្ទាប់ពី បាន ស្តាប់ ការរៀបរាប់ លោក បណ្ឌិត អូស្មាន ហាស្សាន់ អំពី ស្ថានភាព សហគមន៍ ឥស្លាម កម្ពុជា ដែល ត្រូវបាន យកចិត្តទុកដាក់ ខ្ពស់ ពី រាជ រដ្ឋាភិបាល ។
លោក នាយក ប្រតិបត្តិ អង្គការ សប្បុរសធម៌ កាតា បាន សន្យា ថា នឹង ផ្តល់ ជំនួយ កញ្ចប់ អាហារ ខែរ៉ាម៉ាឌន ដល់ កម្ពុជា តាមរយៈ អង្គ មូនិធិ អភិវឌ្ឍន៍ មុស្លិ ម កម្ពុជា សម្រាប់ ចែកជូន សាសនិក ឥស្លាម ដែល មាន ជីវភាព ខ្វះខាត នៅ តាម បណ្តា ខេត្ត មួយចំនួន ។
នាយក រដ្ឋមន្រ្តី្ត អ៊ុយក្រែន ស្វែងរក ការជួយគាំទ្រ បន្ថែម ពី ជប៉ុន សម្រាប់ កិច្ចប្រឹងប្រែង ស្ថាបនា ប្រទេស ឡើងវិញ (Video inside) ( តូក្យូ) ៖ នា ថ្ងៃចន្ទ នេះ នាយក រដ្ឋមន្រ្តី អ៊ុយក្រែន បាន ទទូច ឱ្យ រដ្ឋាភិបាល ក៏ដូចជា វិស័យ ឯកជន ជប៉ុន បង្កើន ការជួយគាំទ្រ សម្រាប់ កិច្ចប្រឹងប្រែង កសាង ប្រទេស របស់ លោក ឡើងវិញ ក្រោយ រង ការបំផ្លិចបំផ្លាញ ដោយសារតែ សង្រ្គាម ឈ្លានពាន របស់ រុស្ស៉ី ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នា ថ្ងៃចន្ទ ទី១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
ថ្លែង ក្នុង សន្និសីទ មួយ ដែល មាន ការចូលរួម ពីសំណាក់ មន្រ្តី ថ្នាក់ដឹកនាំ រដ្ឋាភិបាល និង ធុរកិច្ច សរុប ៣០០ នាក់ មកពី ប្រទេស ជប៉ុន និង អ៊ុយក្រែន នាយក រដ្ឋមន្រ្តី អ៊ុយក្រែន លោក Denys Shmygal បាន និយាយ ដូច្នេះ ថា « ចាប់តាំងពី សង្រ្គាម ឈ្លានពាន បាន ចាប់ផ្តើម មក ជប៉ុន បាន ផ្តល់ឱ្យ អ៊ុយក្រែន នូវ ជំនួយ គាំទ្រ ចម្រុះ សរុប ជា ទឹកប្រាក់ លើស ១០ពាន់ លាន ដុល្លារ ។ ដោយសារ ការផ្តល់ មូលនិធិ នេះ អំលុង សង្រ្គាម យ៉ាង អាក្រក់ នេះ ដែល បង្កឡើង ដោយ រុស្ស៉ី ទើប ប្រជាជន អ៊ុយក្រែន រាប់ លាន នាក់ អាច នៅរស់រាន មាន ជីវិត » ។
លោក នាយក រដ្ឋមន្រ្តី អ៊ុយក្រែន បាន បន្ត ទៀត ថា « វិស័យ ឯកជន គឺជា ក្បាល ម៉ាស៉ីន ចម្បង សម្រាប់ កិច្ចប្រឹងប្រែង ស្ថាបនា ឡើងវិញ នៅ អ៊ុយក្រែន ។ យើង ចង់ បន្ត ធ្វើ ការរួមគ្នា ជាមួយ ជប៉ុន លើ កិច្ចខិតខំ ធ្វើ ទំនើបកម្ម និង កសាង ប្រទេស អ៊ុយក្រែន ឡើងវិញ ។ ខ្ញុំ ចង់ឱ្យ អ្នក ទាំងអស់ គ្នា ក្លាយជា ផ្នែក នៃ អព្ភូតហេតុ សេដ្ឋកិច្ច មួយ សម្រាប់ អ៊ុយក្រែន » ។ ជប៉ុន គឺជា ប្រទេស ដែល បាន បរិច្ចាគ ជំនួយ ធំ ជាង គេ លំដាប់ ទី៤ របស់ អ៊ុយក្រែន ។
គួរ បញ្ជាក់ ថា យោង តាម របាយការណ៍ រួម កាលពី សប្តាហ៍ មុន ដោយ រដ្ឋាភិបាល អ៊ុយក្រែន ធនាគារ ពិភពលោក អង្គការ សហ ប្រជាជាតិ និង សហភាព អឺរ៉ុប កិច្ចប្រឹងប្រែង ស្ថាបនា ឡើងវិញ នៅ អ៊ុយក្រែន នឹង ត្រូវ ចំណាយ ថវិកា ខ្ទង់ ៤៨៦ ពាន់ លាន ដុល្លារ សម្រាប់ រយៈពេល ១០ឆ្នាំ ខាងមុខ ក្នុង នោះ ១៥ ពាន់ លាន ដុល្លារ គឺ សម្រាប់ ឆ្នាំ ២០២៤ នេះ តែ ឯង ប៉ុណ្ណោះ ៕ រូបភាព ពី Reuters អ្នកជំនាញ គាំទ្រ អនុសាសន៍ សម្តេច ធិបតី លើ ការបង្កើន ជំនាញ ដល់ កម្មករ ព្រោះ ជា យុទ្ធសាស្ត្រ បង្កើន ផលិតភាព ការងារ និង ទាក់ទាញ វិនិយោគ
អ្នកជំនាញ សេដ្ឋកិច្ច រូប នេះ បាន បន្ដ ថា៖ « វា មាន សារៈសំខាន់ ណាស់ ក្នុង ការបង្កើន ផលិតភាព ការងារ នៅក្នុង វិស័យ ឧស្សាហកម្ម នៅ កម្ពុជា ដោយសារតែ គោលដៅ របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧នេះ គឺ បាន ដាក់ គោល នយោបាយ រុញ ច្រាន វិស័យ ឧស្សាហកម្ម នៅក្នុង ស្រុក ក្នុង គោលបំណង បង្កើន តម្លៃ បន្ថែម ដូច្នេះហើយ មាន តែ ការពង្រឹង កម្មវិធី ការបង្កើន ជំនាញ (Upskilling) និង ការផ្លាស់ប្តូរ ជំនាញ ដល់ កម្មករ និយោជិត ទេ ដែល អាច ឱ្យ គោល នយោបាយ នេះ ដើរ ទៅ មុខ បាន » ។
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ! យប់ មិញ នៅ រាជធានី ភ្នំពេញ ឃាត់ យានយន្ដ ល្មើស ៧០ គ្រឿង
( ភ្នំពេញ ) ៖ លទ្ធផល នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ និង ត្រួតពិនិត្យ ជាតិ អាល់កុល នៅ យប់ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ កម្លាំង សមត្ថកិច្ច បាន ឃាត់ យានយន្ដ ល្មើស ចំនួន ៧០ គ្រឿង ក្នុង នោះ រថយន្ត ចំនួន ២២ គ្រឿង និង ម៉ូតូ ៤៨ គ្រឿង ។
ជា លទ្ធផល តាម បណ្តា អធិការដ្ឋាន នគរបាល ខណ្ឌ បាន ចុះ អនុវត្ត រឹត បន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក និង ត្រួតពិនិត្យ ជាតិ អាល់កុល ដូច ខាងក្រោម៖ ឃាត់ យានយន្ត ល្មើស សរុប ចំនួន ៧០ គ្រឿង ( រថយន្ត ចំនួន ២២ គ្រឿង និង ម៉ូតូ ចំនួន ៤៨ គ្រឿង ) ៖
ថ្លែង ក្នុង ឱកាស អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ សម្តេច ធិបតី នាយក រដ្ឋមន្រ្តី បាន បញ្ជាក់ ដូច្នេះ ថា៖ « ផ្លូវ ជួយ សម្រួល ការធ្វើចរាចរណ៍ កាត់បន្ថយ ក្នុង ការចំណាយ បើក ឱកាស ឱ្យ ប្រជាពលរដ្ឋ អាច ប្រកប របប បាន ផ្លូវ ដូច សរសៃ ឈាម អញ្ចឹង ផ្លូវ ទៅដល់ ណា ចិញ្ចឹម សិរី រាង្គ នៅ ទីនោះ » ។
ការ ជំរុញ ឱ្យ រដ្ឋាភិបាល ចិន មក បន្ត ជួយ អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ នៅ កម្ពុជា ស្រប ពេល ដែល ពេល កំណើន ប្រជាជន និង ជីវភាព របស់ ពលរដ្ឋ កម្ពុជា កាន់តែ សម្បូរបែប ធ្វើឱ្យ មធ្យោបាយ ធ្វើដំណើរ មាន កាន់តែ ច្រើន ដែល ទាមទារ ឱ្យ មាន ការសិក្សា និង សាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ឱ្យ មាន ភាពប្រទាក់ ក្រឡា គ្នា ឱ្យ បាន កាន់តែ ច្រើន ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ស្នើ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
គួរ បញ្ជាក់ ថា ការវាយប្រហារ ដែល ក្រុម ហ៊ូទី និយាយ ថា ដើម្បី បង្ហាញ សាមគ្គីភាព ជាមួយ ប៉ាឡេស្ទីន ក្នុង សង្រ្គាម នៅ តំបន់ ហ្គាហ្សា បាន ធ្វើឱ្យ តម្លៃ ដឹកជញ្ជូន និង ធានារ៉ាប់រង ឡើង ថ្លៃ ដោយសារតែ ភាពរំខាន លើ ច្រកផ្លូវ ពាណិជ្ជកម្ម ដ៏ សំខាន់ រវាង តំបន់ អាស៉ី និង អឺរ៉ុប ដែល ត្រូវបាន ប្រើប្រាស់ យ៉ាង ទូលំទូលាយ ដោយ កប៉ាល់ មកពី ចិន ។
អតីត ប្រធានាធិបតី សហរដ្ឋ អាមេរិក លោក ត្រាំ បាន ធ្វើឱ្យ អឺរ៉ុប មិន សប្បាយ ចិត្ត ជុំវិញ ការ និយាយ ថា ប្រសិនបើ លោក ឈ្នះ ការបោះឆ្នោត ខែវិច្ឆិកា ខាងមុខ លោក នឹង មិន ផ្តោត លើ ការពារ សម្ព័ន្ធមិត្ត ណា តូ ដែល បរាជ័យ ក្នុង ចំណាយ ផ្នែក ការពារ ជាតិ នោះ ទេ ។
ករណី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ក្រោយ ចាត់ វិធានការ ច្បាប់ ហើយ នោះ ចិន តៃវ៉ាន់ ទាំង ពីរ នាក់ នឹង ត្រូវ ដេញ ចេញ ពី កម្ពុជា ។ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បង្ហាញ ក្តីសង្ឃឹម ថា ឆ្នាំ ផ្លាស់ប្តូរ ប្រជាពលរដ្ឋ កម្ពុជា - ចិន នៅ ឆ្នាំ ២០២៤ នឹង ក្លាយជា ចំណែក បន្សាប នូវ ព័ត៌មាន ខុសពី ការណ៍ ពិត ទាំងឡាយ នា ពេល កន្លងមក ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ
( ភ្នំពេញ ) ៖ ការកសាង ផ្លូវ និង ស្ពាន បម្រើ ជា ប្រយោជន៍ ដល់ ជាតិ និង ប្រជាជន គឺជា គោល នយោបាយ ដ៏ ចាំបាច់ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា ប្រកាន់ យក តាំងពី ពេល ដែល សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ មក ម្ល៉េះ ។ បន្ត មកដល់ អ្នកដឹកនាំ ឈាម ថ្មី សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ នៅតែ បន្ត យក នូវ គោល នយោបាយ នេះ ផងដែរ ។
នៅ ព្រឹក ថ្ងៃចន្ទ ១០កើត ខែ មាឃ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០ ២៤ នេះ ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា ) ដែល ជា ស្ពាន ឆ្លងកាត់ ទន្លេ ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ មួយ ខ្សែ ទៀត បាន ចាប់ផ្តើម ដំណើរការ សាងសង់ ជា ផ្លូវការ ហើយ ។ ពិធី បើក ការដ្ឋាន សាងសង់ ស្ពាន មួយ ខ្សែ នេះ ត្រូវបាន ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) ៖
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ កំណើន ចរាចរណ៍ កើនឡើង យ៉ាង ឆាប់រហ័ស ដែល នាំឱ្យ មាន ការកកស្ទះ ចរាចរណ៍ ខ្លាំង ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា គោលដៅ ចម្បង របស់ រាជ រដ្ឋាភិបាល រយៈពេល ជាង ៤០ ឆ្នាំ មក នេះ គឺ ការលុបបំបាត់ ភាពក្រីក្រ និង បង្កើន ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ តាមរយៈ ការបិទ បញ្ចប់ ភ្លើង សង្គ្រាម និង ជំរុញ ការអភិវឌ្ឍន៍ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា គោល នយោបាយ តភ្ជាប់ ហេដ្ឋារចនាសម្ព័ន្ធ ជួយ ឱ្យ ការធ្វើដំណើរ ប្រជាពលរដ្ឋ កាន់តែ ងាយស្រួល កាន់តែ លឿន កាត់បន្ថយ ពេលវេលា ធ្វើដំណើរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល គ្មាន ផែនការ កំណត់ ពិដាន ពលរដ្ឋ នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សម្តេច តេជោ ហ៊ុន សែន ប្រឹងប្រែង ក្នុង ការបញ្ចប់ សង្គ្រាម ហើយ សាង សុខ សន្តិភាព ។ ដូច្នេះ ទោះ តម្លៃ ណា ក៏ដោយ ត្រូវតែ រួមគ្នា រក្សា ឱ្យ បាន នូវ សុខ សន្តិភាព ទាំង ពេល បច្ចុប្បន្ន ទៅ អនាគត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា មាន ផ្លូវកាន់តែ រឹងមាំ ក្តីសង្ឃឹម កាន់តែ រឹងមាំ មាន ផ្លូវកាន់តែ ច្រើន ក្តីសង្ឃឹម ក៏ កាន់តែ ច្រើន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា គោលដៅ អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ នៅ កម្ពុជា មិន ដកថយ នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ផ្លូវ ដូច សរសៃ ឈាម អ៊ីចឹង ផ្លូវ ទៅដល់ ទីណា ជួយ ចិញ្ចឹម សរីរាង្គ នៅ ទីនោះ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ផ្លូវ មិន មែន ប្រើ សម្រាប់ តែ ការធ្វើ ចំណាកស្រុក ប៉ុណ្ណោះ ទេ តែ ផ្លូវ បាន រួមចំណែក រុញ រោងចក្រ និង ការងារ ជូន ប្រជាពលរដ្ឋ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា បច្ចុប្បន្ន កម្ពុជា មាន ស្ពាន ឆ្លងកាត់ ទន្លេ ចំនួន ២៥ ស្ពាន ។ ក្នុង នោះ ស្ពាន ចំនួន ១៩ ធ្វើ រួចរាល់ . ៣ស្ពាន កំពុង សាងសង់ និង ៣ស្ពាន ទៀត កំពុង សិក្សា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា កន្លែងណា ធ្វើ ផ្លូវ បង្ហាញ ថា កន្លែង ណុង មាន ប្រជាពលរដ្ឋ មាន ការអភិវឌ្ឍន៍ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល គ្មាន ផែនការរើ រាជធានី ចេញ ពី ភ្នំពេញ នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល គ្មាន ផែនការហាម ប្រជាពលរដ្ឋ យក កូន និង ហាម ពលរដ្ឋ ក្នុង ការទិញ យានយន្ត នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ផ្លូវ ក្នុង រាជធានី ភ្នំពេញ មិន អាច ពង្រីក បាន ទៀត នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ឱ្យ រដ្ឋបាល រាជ នី ភ្នំពេញ ត្រៀម រៀបចំ បញ្ចេញ រថយន្ត ដឹក ពលរដ្ឋ ទៅ លេង ស្រុក កំណើត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា មហិច្ឆតា របស់ កម្ពុជា មិន ត្រឹមតែ សាងសង់ ផ្លូវ ប៉ុណ្ណោះ ទេ គឺ សាងសង់ ដោយ ខ្លួន ឯង ថែម ទៀត តាមរយៈ ការបណ្តុះបណ្តាល វិស្វករ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា មកដល់ ពេល បច្ចុប្បន្ន ចិន ជួយ សាងសង់ ស្ពាន ឆ្លង ទន្លេ សរុប ចំនួន ១៦ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ប្រទេស ចិន ក្លាយជា ប្រទេស លំដាប់ ទី១ ផ្តល់ ឥណទាន សម្បទាន និង ជំនួយ សម្រាប់ ការអភិវឌ្ឍន៍ កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ស្នើ រដ្ឋាភិបាល ចិន បន្ត ជួយ ដល់ គម្រោង សាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ នៅ កម្ពុជា ដូចជា « គម្រោង ព្រែក ជីក តេជោ - ហ្វូណន ផ្លូវ រថភ្លើង ធុន ស្រាល និង ផ្លូវ ក្រោម ដី ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា កម្ពុជា បាន ប្រឹងប្រែង ប្រើ រយៈពេល ជាង ២០ ឆ្នាំ ក្នុង ការកសាង រូបភាព កម្ពុជា មាន សុខ សន្តិភាព និង មាន ស្ថេរភាព តែ មួយ រយៈ ចុងក្រោយ នេះ តាមរយៈ បណ្តាញ ផ្សព្វផ្សាយ បរទេស និង បញ្ហា មួយចំនួន ធ្វើឱ្យ ប៉ះពាល់ ដល់ រូបភាព ស្ថេរភាព របស់ កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បង្ហើប ថា មាន មនុស្ស ព្យាយាម អន្តរាគមន៍ ជួយ ជនជាតិ ចិន តៃវ៉ាន់ ពីរ នាក់ ដែល ផលិត វីដេអូ ប្រឌីត រឿង អាក្រក់ ពី កម្ពុជា តែ សម្តេច បាន បដិសេធ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា អ្នក ដែល យក កម្ពុជា ផលិត វីដេអូ ដើម្បី បាន អ្នកទស្សនា ច្រើន នឹង ត្រូវ ចាត់ វិធានការ តាម ច្បាប់ ។ ក្រោយ ចាត់ វិធានការ ច្បាប់ ហើយ នោះ នឹង ត្រូវ ដេញ ចេញ ពី កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ព្រមាន ដល់ ជន មាន ចេតនា អាក្រក់ ចំពោះ កម្ពុជា កុំ ចេះតែ ហ៊ាន ។ កម្ពុជា នឹង ចាត់ វិធានការ ម៉ឺងម៉ាត់ ចំពោះ ជន មាន ចេតនា អាក្រក់ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បង្ហាញ ក្តីសង្ឃឹម ថា ឆ្នាំ ផ្លាស់ប្តូរ ប្រជាពលរដ្ឋ កម្ពុជា - ចិន នៅ ឆ្នាំ ២០២៤ នឹង ក្លាយជា ចំណែក បន្សាប នូវ ព័ត៌មាន ខុសពី ការពិត ទាំងឡាយ នា ពេល កន្លងមក ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អំពាវនាវ ដល់ អ្នកបើកបរ កុំ ខ្លាច រឿង នគរបាល ចាប់ ត្រូវ មាន ស្មារតី គោរព ច្បាប់ បើកបរ មិន លើស ល្បឿន បើកបរ មិន ប្រើ គ្រឿងស្រវឹង ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា អ្វី ដែល រាជ រដ្ឋាភិបាល ចង់បាន គឺ អ្នកបើកបរ បើកបរ ដោយ ស្មារតី ទទួលខុសត្រូវ យោគយល់ អធ្យាស្រ័យ មិន បង្ក គ្រោះថ្នាក់ ដល់ អាយុជីវិត អ្នកដទៃ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ដល់ អ្នកបើកបរបង្ក គ្រោះថ្នាក់ ចរាចរណ៍ កុំ ព្យាយាម គេចខ្លួន ត្រូវ ចូល ខ្លួន ទទួលខុសត្រូវ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អំពាវនាវ ដល់ អ្នកដឹកជញ្ជូន កុំ ដឹក លើស ទម្ងន់ កំណត់ និង ពិនិត្យ លក្ខណៈ បច្ចេកទេស ឱ្យ បាន ត្រឹមត្រូវ ។
សេចក្ដីប្រកាស ព័ត៌មាន បាន ឲ្យដឹង ថា យុទ្ធនាការ ទិវា អន្តរជាតិ ៨មីនា គឺជា ព្រឹត្តិការណ៍ ជា សកល ដែល មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ បាន ប្រកាស ជា ទិវា របស់ អង្គការ សហ ប្រជាជាតិ ស្តីពី សិទ្ធិ ស្ត្រី និង សន្តិភាព ពិភពលោក នា ឆ្នាំ ១៩៧៧ ។
ជារៀងរាល់ ឆ្នាំ ព្រះរាជាណាចក្រ កម្ពុជា បាន រៀបចំ យុទ្ធនាការ ទិវា អន្តរជាតិ នារី ៨មីនា ដើម្បី រំលឹក ពី ការតស៊ូ ទាមទារ សិទ្ធិ ស្មើគ្នា សេរីភាព និង ឆ្លុះបញ្ចាំង អំពី វឌ្ឍនភាព សមិទ្ធផល បញ្ហា ប្រឈម ការប្តេជ្ញាចិត្ត និង វិធានការ ជា វិជ្ជមាន នានា នៅក្នុង ការលើកកម្ពស់ សមភាព យេនឌ័រ និង បង្កើន ភាពអង់អាច ដល់ ស្ត្រី និង ក្មេងស្រី គ្រប់ រូប ។
ការកំណត់ មូលបទ សម្រាប់ យុទ្ធនាការ ឆ្នាំ នេះ របស់ កម្ពុជា បាន រៀបចំឡើង ឆ្លើយតប នឹង បរិបទ នៃ ការវិវត្ត របស់ សង្គម ក្នុង យុគសម័យ ឌីជីថល និង ស្រប តាម ចក្ខុវិស័យ ដែល បាន ចង្អុលបង្ហាញ នៅក្នុង យុទ្ធសាស្ត បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង ក្របខណ្ឌ គោល នយោបាយ ក្នុង ការលើកកម្ពស់ សមភាព យេនឌ័រ និង បង្កើន ភាពអង់អាច ដល់ ស្រ្តី និង ក្មេងស្រី ។
នៅក្នុង នោះ ក្រសួង កិច្ចការ នារី និង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ នឹង រៀបចំ សកម្មភាព សំខាន់ ៗ ដូច ខាងក្រោម៖
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ៣៩ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៩ នាក់ នោះ មាន ២៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស គ្រឿងញៀន ១៩ករណី និង ជនសង្ស័យ ១១នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស ព្រហ្មទណ្ឌ ០៧ ករណី ។
នៅ ព្រឹក ថ្ងៃចន្ទ ១០កើត ខែ មាឃ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា ) ដែល ជា ស្ពាន ឆ្លងកាត់ ទន្លេ ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ មួយ ខ្សែ ទៀត ចាប់ផ្តើម ដំណើរការ សាងសង់ ជា ផ្លូវការ ហើយ ។ ពិធី បើក ការដ្ឋាន សាងសង់ ស្ពាន មួយ ខ្សែ នេះ ត្រូវបាន ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) ជា គម្រោង សាងសង់ ស្ពាន ឆ្លង ទន្លេ លើក ដំបូង សម្រាប់ រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ។ តាមរយៈ គម្រោង នេះ បាន បង្ហាញ ឱ្យ ឃើញ ច្បាស់ ពី និរន្តរភាព នៃ ការកសាង ជាតិ របស់ រាជ រដ្ឋាភិបាល កើត ចេញពី គណបក្ស ប្រជាជន កម្ពុជា ទោះបី នាយក រដ្ឋមន្ត្រី ត្រូវបាន ផ្លាស់ប្តូរ យ៉ាងណាក្តី ។
យោង តាម របាយការណ៍ បាន ឱ្យដឹង ថា ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) ជា ប្រភេទ ស្ពាន បេតុង ភ្លោះ មាន ប្រវែង ៨៤៥.៧ម៉ែត្រ មាន ចំណុច ចាប់ផ្តើម ពី ត្រើយ ខាងលិច ទន្លេ បាសាក់ ស្ថិត ក្នុង សង្កាត់ ចាក់អង្រែ ក្រោម ខណ្ឌ មានជ័យ និង ចំណុច បញ្ចប់ នៅ ត្រើយ ខាងកើត ទន្លេ បាសាក់ ស្ថិត ក្នុង សង្កាត់ ព្រែក ប្រា ខណ្ឌ ច្បារអំពៅ ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ។
ចំពោះ ផ្លូវ តភ្ជាប់ ក្បាល ស្ពាន មាន ប្រវែង សរុប ៨០៤.៣មែត្រ តភ្ជាប់ ពី ក្បាល ស្ពាន ទាំង សងខាង ទៅ មហាវិថី សំខាន់ ៗ នៅក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ។ ផ្លូវ តភ្ជាប់ ក្បាល ស្ពាន នេះ នឹង ត្រូវ ស្ថាបនា ទៅ តាម លក្ខណៈ បច្ចេកទេស ក្នុង នោះ ផ្លូវ តភ្ជាប់ ពី ក្បាល ស្ពាន ត្រើយ ខាងលិច មាន ប្រវែង ៣៧៩. ១៥ម៉ែត្រ និង ត្រើយ ខាងកើត មាន ប្រវែង ៤២៥. ១៥ម៉ែត្រ នឹង ត្រូវ ស្ថាបនា ជា ប្រភេទ ផ្លូវ បេតុង កៅស៊ូ AC អ៊ុត កម្រាស់ ៩សង់ទីម៉ែត្រ ទទឹង ២០ម៉ែត្រ លើ ទទឹង តួ ផ្លូវ រួម ២៧ម៉ែត្រ ។
គម្រោង នេះ ក៏ រួមបញ្ចូល ការស្ថាបនា រង្វង់ មូល ចំនួន ២កន្លែង នៅ សងខាង ក្បាល ស្ពាន និង ផ្លូវ អម ស្ពាន ទាំង សងខាង ចំនួន ៤កំណាត់ ប្រវែង សរុប ១.៥៤១ ម៉ែត្រ ដោយ ក្រាល បេតុង សរសៃ ដែក ព្រមទាំង ការស្ថាបនា ពង្រីក កំណាត់ ផ្លូវ ចំនួន ២ខ្សែ រួម មាន ផ្លូវ ជាតិ លេខ ២ ប្រវែង ៣០០ ម៉ែត្រ នៅ ត្រើយ ខាងលិច និង ផ្លូវ លេខ ១១០ ប្រវែង ១១០ ម៉ែត្រ នៅ ត្រើយ ខាងកើត ដើម្បី តភ្ជាប់ ជាមួយ ស្ពាន និង ការរៀបចំ បំពាក់ ស្លាកសញ្ញា និង គំនូស ចរាចរណ៍ ទៅ តាម បទដ្ឋាន បច្ចេកទេស ផ្លូវថ្នល់ ផងដែរ ។
របាយការណ៍ បន្ត ថា គម្រោង នេះ នឹង ត្រូវ អនុវត្ដ ការសាងសង់ ដោយ ក្រុមហ៊ុន សំណង់ សៀង ហៃ និង ត្រួតពិនិត្យ បច្ចេកទេស ដោយ ក្រុមហ៊ុន ទីប្រឹក្សា បច្ចេកទេស ក្វាង ចូវ វ៉ាន អាន ប្រើប្រាស់ រយៈពេល សាងសង់ ចំនួន ៤២ ខែ នឹង បញ្ចប់ នៅក្នុង អំឡុង ឆ្នាំ ២០២៧ ដោយ គ្រោង ចំណាយ ថវិកា សរុប ប្រមាណ ៦០. ២លាន ដុល្លារ អាម៉េរិក ដែល ជា ឥណទាន សម្បទាន ពី រដ្ឋាភិបាល ចិន រួម ជាមួយនឹង ថវិកា បដិភាគ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រាប់ ការដោះស្រាយ ផល ប៉ះពាល់ ការបោសសម្អាត គ្រាប់ មីន យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ និង ពន្ធ អាករ ផ្សេង ៗ ។
ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) គឺជា គម្រោង យុទ្ធសាស្រ្ត មួយ យ៉ាង សំខាន់ សម្រាប់ តភ្ជាប់ និង សម្រួល ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ។ ជាពិសេស កាត់បន្ថយ ការកកស្ទះ ចរាចរណ៍ នៅលើ ស្ពាន ព្រះមុនីវង្ស ។
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ត្រាស់បង្គាប់ កែសម្រួល មាត្រា ១០ថ្មី នៃ ព្រះរាជ ក្រឹត្យ ស្តីពី ការរៀបចំ និង ប្រព្រឹត្តទៅ នៃ ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព ។
បើ តាម ព្រះរាជ ក្រឹត្យ មាត្រា ១០ ត្រូវបាន កែសម្រួល ដោយ កំណត់ ថា ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព មាន អគ្គ លេខាធិការដ្ឋាន មួយ ជា សេនាធិការ សម្រាប់ ដំណើរការការងារ ប្រចាំ ថ្ងៃ ដែល មាន ទីតាំង ស្ថិត នៅក្នុង ក្រសួង បរិស្ថាន ។
អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព ដឹកនាំ ដោយ អគ្គ លេខាធិការ១ ( មួយ )រូប អម ដោយ អគ្គ លេខាធិការ រង មួយចំនួន ដែល ត្រូវ តែងតាំង ដោយ ព្រះរាជ ក្រឹត្យ ឬ អនុក្រឹត្យ ។
ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព ត្រូវ កំណត់ ដោយ អនុក្រឹត្យ ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត សម្រេច ប្តូរ ឈ្មោះ មូលដ្ឋាន សមុទ្រ កងទ័ព ជើងទឹក ទៅជា មូលដ្ឋាន សមុទ្រ រាម កងទ័ព ជើងទឹក
( ភ្នំពេញ ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន សម្រេច ប្តូរ ឈ្មោះ មូលដ្ឋាន សមុទ្រ កងទ័ព ជើងទឹក ទៅជា មូលដ្ឋាន សមុទ្រ រាម កងទ័ព ជើងទឹក ។
ក្នុង អនុក្រឹត្យ ចុះហត្ថលេខា ដោយ សម្តេច ធិបតី កាលពី ថ្ងៃទី ១៣ ខែកុម្ភៈ បាន បញ្ជាក់ ថា បទប្បញ្ញត្តិ ទាំងឡាយ ណា ដែល មាន ខ្លឹមសារ ផ្ទុយ នឹង អនុក្រឹត្យ នេះ ត្រូវ ទុក ជា និរាករណ៍ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សាធារណការ គាំទ្រ ការចូលរួម ពី វិស័យ ឯកជន ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការជំរុញ វិស័យ យានយន្ត អគ្គិសនី នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោក ពៅ ម៉ាលី រដ្ឋលេខាធិការ តំណាង លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ អគារ តាំង បង្ហាញ រថយន្ត របស់ ក្រុមហ៊ុន BYD ដោយ មាន ការចូលរួម ពីសំណាក់ ថ្នាក់ដឹកនាំ ក្រសួង និង មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ផងដែរ ។
នា ឱកាស នោះ លោក រដ្ឋលេខាធិការ ពៅ ម៉ាលី ក៏ បាន គូសបញ្ជាក់ ពី សន្ទុះ នៃ ការប្រើប្រាស់ យានយន្ត អគ្គិសនី នៅ កម្ពុជា យ៉ាង ឆាប់រហ័ស ដោយសារ ប្រជាពលរដ្ឋ មាន ការយល់ដឹង ពី គុណ ប្រយោជន៍ នៃ ការប្រើប្រាស់ មាន ផលចំណេញ ច្រើន បើ ធៀប ជាមួយ ការប្រើប្រាស់ យានយន្ត ចំហេះ ក្នុង ដូចជា ការសន្សំ សំចៃ លើ ការប្រើប្រាស់ ការថែទាំ និង មិន បំពុល បរិស្ថាន ។
ទន្ទឹមនឹង ការកើនឡើង នេះ កម្ពុជា ត្រូវការ គោល នយោបាយ ក៏ ដូចជា ហេដ្ឋារចនាសម្ព័ន្ធបញ្ចូល ថាមពល យានយន្ត អគ្គិសនី ឱ្យ បាន ទូលំទូលាយ ដែល ការចូលរួម ពី វិស័យ ឯកជន ជាមួយ រាជ រដ្ឋាភិបាល ពិតជា មាន សារៈសំខាន់ មិន អាច ខ្វះ បាន ក្នុង ការជំរុញ វិស័យ យានយន្ត អគ្គិសនី នៅ កម្ពុជា ៕ លោក សេរី កុសល ជួប សំណេះសំណាល ជាមួយ អង្គ បោះឆ្នោត នៅ បណ្តា ឃុំ ទាំង៦ នៃ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ត្រៀម សម្រាប់ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥
( បន្ទាយមានជ័យ )៖ លោក សេរី កុសល អ្នកតំណាងរាស្ត្រ និង ជា អនុប្រធាន ក្រុមការងារ បក្ស ចុះ ជួយ ខេត្ត បន្ទាយមានជ័យ ព្រមទាំង ក្រុមការងារ នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន ចុះ តាម បណ្តា ឃុំ នានា នៃ ស្រុក ភ្នំស្រុក ដើម្បី ពិនិត្យមើល អង្គ បោះឆ្នោត នៅ តាម ឃុំ ទាំង៦ ដោយ បាន ផ្តល់ នូវ សារ នយោបាយ ដល់ អង្គ បោះឆ្នោត ចំនួន ៣៥ រូប ដែល ត្រូវ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ខាងមុខ នេះ ។
ក្នុង ពិធី សំណេះសំណាល នោះ លោក សេរី កុសល បាន ថ្លែងអំណរគុណ ដល់ អង្គ បោះឆ្នោត ទាំង ៣៥ រូប និង សកម្មជន ដែល ចូលរួម ចំនួន ប្រមាណ ៤០០ នាក់ ដែល បាន មក ជួបជុំគ្នា នៅក្នុង ឃុំ ប៉ោយ ចារ ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ ។
លោក បាន ពាំនាំ នូវ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន ដែល សម្តេច ជា តួអង្គ ដ៏ សំខាន់ នៅក្នុង អង្គ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ទៅដល់ អង្គ បោះឆ្នោត ទាំងអស់ ។
លោក បាន លើកឡើង ពី អត្ថប្រយោជន៍ នៃ ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ដែល សម្តេច តេជោ ហ៊ុន សែន គឺជា បេក្ខភាព មួយ រូប នៅក្នុង អង្គ បោះឆ្នោត ដែល ទាំងអស់ គ្នា ត្រូវ ខិតខំ ប្រមូល គ្រប់ សមាជិក បក្ស ទាំងអស់ ដើម្បី អញ្ជើញ ទៅ បោះឆ្នោត ឱ្យ បាន នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ រួមទាំង ត្រូវ គោរព នូវ គោលការណ៍ ដែល បាន ដាក់ចេញ ដោយ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប) ។
លោក បន្ត ថា ក្រោយ ការបោះឆ្នោត សមាជិក ព្រឹទ្ធសភា ហើយ នោះ នៅពេល ខាងមុខ នឹង មាន ការបោះឆ្នោត ក្រុមប្រឹក្សា ស្រុក - ខេត្ត បន្ត ទៀត ដូច្នេះ អង្គ បោះឆ្នោត ទាំងអស់ ដែល ជាប់ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នេះ ពិតជា សំខាន់ ណាស់ ។
លោក សេរី ក សុល បាន និយាយ បែប កំប្លែង តែ មាន អត្ថន័យ ដោយ ប្រាប់ ដល់ អង្គ បោះឆ្នោត ទាំង ៣៥ រូប ថា នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ដែល ជា ថ្ងៃ បោះឆ្នោត អង្គ បោះឆ្នោត ទាំងអស់ ហាម ស្លាប់ ហាម ឈឺ និង ហាមរវល់ គឺ ត្រូវ ត្រៀមខ្លួន ទៅ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា ។
អ្នកការទូត បាន និយាយ ថា អាល់ហ្សេរី កាលពី ថ្ងៃសៅរ៍ បាន សុំ ឱ្យ ក្រុមប្រឹក្សា បោះឆ្នោត នៅ ថ្ងៃអង្គារ សប្តាហ៍ ក្រោយ នេះ ។ សេចក្តីសម្រេច របស់ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ តម្រូវ ឱ្យ មាន សំឡេង គាំទ្រ យ៉ាងតិច ៩ សំឡេង និង ដោយ គ្មាន ការវេតូ ពី សហរដ្ឋ អាមេរិក អង់គ្លេស បារាំង ចិន ឬ រុស្ស៊ី ដើម្បី អនុម័ត ។
ជា ប្រពៃណី រដ្ឋាភិបាល ក្រុង វ៉ាស៊ីនតោន តែងតែ ការពារ សម្ព័ន្ធមិត្ត របស់ ខ្លួន អ៊ីស្រាអែល ពី សកម្មភាព របស់ អង្គការ សហ ប្រជាជាតិ ហើយ បាន ប្រើ សិទ្ធិ វ៉េតូ ពីរ ដង រួច មកហើយ ចាប់តាំងពី ថ្ងៃទី ៧ខែតុលា ។ ប៉ុន្តែ វា ក៏ បាន អនុប្បវាទ ពីរ ដង ផងដែរ ដោយ អនុញ្ញាតឱ្យ ក្រុមប្រឹក្សា អនុម័ត ដំណោះស្រាយ ដែល មាន គោលបំណង ជំរុញ ជំនួយ មនុស្សធម៌ ដល់ តំបន់ ហ្គាហ្សា និង បាន អំពាវនាវ ឱ្យ មាន ការផ្អាក ជា បន្ទាន់ ផងដែរ ។
កិច្ចពិភាក្សា រវាង សហរដ្ឋ អាមេរិក អេហ្ស៊ីប អ៊ីស្រាអែល និង កាតា កំពុង បន្ត ស្វែងរក ការផ្អាក នៅក្នុង សង្រ្គាម និង ការដោះលែង ចំណាប់ខ្មាំង ដែល កាន់កាប់ ដោយ ក្រុមហា ម៉ាស់ ។
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៧.២៩៧ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥.៦៥២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៦៤៥ គ្រឿង ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៧ លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៣ នាក់ របួស ចំនួន ០៣ នាក់ ( របួស ធ្ងន់ ចំនួន ០៩ នាក់ ) ។ រយៈពេល ១៨ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១៥៩ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៨៥ នាក់ របួស ២១៤ នាក់ ( របួស ធ្ងន់ ១៣១ នាក់ )៕ ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ៖ បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ២៨ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ជនសង្ស័យ ២៨ នាក់ ។
លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ចែករំលែក ចំណេះដឹង បទពិសោធ ជីវិត និង ការងារ ដើម្បី ជា ត្រី វិស័យ ចង្អុល ទិស ក្នុង ការរៀបចំ គោលដៅ ជីវិត ក្នុង កម្មវិធី « បង ស្រី និង ប្អូន ស្រី »
( បាត់ដំបង ) ៖ នា ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភ : ឆ្នាំ ២០២៤ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី អគ្គ ស្នងការសមាគម កាយ ឫទ្ធិ នារី កម្ពុជា បាន អញ្ជើញ ជា វាគ្មិន កិត្តិយស ក្នុង កម្មវិធី « បង ស្រី និង ប្អូន ស្រី » ដោយ បាន ចែករំលែក ចំណេះដឹង បទពិសោធ ល្អ ៗ អំពី ការសិក្សា តាំងពី ថ្នាក់ បឋម ដល់ ថ្នាក់ បណ្ឌិត ជូន ប្អូន ៗ យុវតី សិស្ស - និស្សិត សមាជិក សមាជិកា និង ភ្ញៀវ កិត្តិយស សរុប ចំនួន ប្រមាណ ៦៥០ នាក់ នៅ សាល ប្រជុំ បាត់ដំបង ស៉ី ធីហល ស្ថិត ក្នុង ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ។
ក្នុង ឱកាស ដ៏ វិសេសវិសាល នោះ លោកជំទាវ បណ្ឌិត បាន ចែករំលែក ចំណេះដឹង បទពិសោធ ជីវិត និង ការងារ ដែល លោកជំទាវ បាន ជួបប្រទះ កន្លងមក ដើម្បី ជា ត្រី វិស័យ ចង្អុល ទិស ក្នុង ការរៀបចំ គោលដៅ ជីវិត ។ លើស ពី នេះ បទពិសោធ និង ចំណេះដឹង ទាំងនោះ បាន បង្ហាញ អំពី ថាមពល និង ការចាប់ផ្តើម ដ៏ ល្អ តាមរយៈ ការបណ្តុះ គំនិត វិជ្ជមាន ប្រកបដោយ ពុទ្ធិ និង ភាពម្ចាស់ការ ខ្លួន ឯង ដើម្បី យក ទៅ អនុវត្ត ក្នុង ជីវភាព ប្រចាំ ថ្ងៃ រួមទាំង ការសិក្សា និង ការប្រកប ការងារ ផ្សេង ៗ ។
អង្គ ពិធី ទាំងមូល បាន សម្តែង នូវ ក្ដីរីករាយ ចំពោះ ឱកាស ទទួលបាន ប្រសាសន៍ ដ៏ មាន សារៈសំខាន់ របស់ លោកជំទាវ បណ្ឌិត ជា ទុន គន្លឹះ សម្រាប់ យក ទៅ អនុវត្ត ក្នុង ការកសាង ជីវិត ឱ្យ កាន់តែ ប្រសើរឡើង ។ មួយ វិញទៀត នឹង កាន់តែ ជំរុញ ទឹកចិត្ត ឱ្យ ចូលរួម ការងារ ស្ម័គ្រចិត្ត ក្នុង សកម្មភាព សង្គម កាន់តែ ខ្លាំងក្លា បន្ថែម ទៀត ៕ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ! យប់ មិញ នៅ រាជធានី ភ្នំពេញ ឃាត់ យានយន្ដ ល្មើស ៩២ គ្រឿង
( ភ្នំពេញ ) ៖ លទ្ធផល នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ និង ត្រួតពិនិត្យ ជាតិ អាល់កុល នៅ យប់ ថ្ងៃទី ១៧ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ កម្លាំង សមត្ថកិច្ច បាន ឃាត់ យានយន្ដ ល្មើស ចំនួន ៩២ គ្រឿង ក្នុង នោះ រថយន្ត ចំនួន ៣០ គ្រឿង និង ម៉ូតូ ៦២ គ្រឿង ។
ជា លទ្ធផល តាម បណ្តា អធិការដ្ឋាន នគរបាល ខណ្ឌ បាន ចុះ អនុវត្ត រឹត បន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក និង ត្រួតពិនិត្យ ជាតិ អាល់កុល ដូច ខាងក្រោម៖ ឃាត់ យានយន្ត ល្មើស សរុប ចំនួន ៩២ គ្រឿង ( រថយន្ត ចំនួន ៣០ គ្រឿង និង ម៉ូតូ ចំនួន ៦២ គ្រឿង ) ៖
អភិបាល រង ស្រុក អូរ រាំង ដក កាំភ្លើង ភ្ជង់ អធិការ ស្រុក និង មេបញ្ជាការ សឹក រង ស្រុក ក្រោយ មាន ទំនាស់ ពាក្យសម្ដី
( មណ្ឌលគិរី ) ៖ លោក សុខ សុវណ្ណា រិទ្ធ អភិបាល រង ស្រុក អូរ រាំង ខេត្ត មណ្ឌលគិរី បាន ដក កាំភ្លើង ភ្ជង់ មេបញ្ជាការ សឹក រង ស្រុក និង អធិការ នគរបាល ស្រុក អូរ រាំង តាម ដងផ្លូវ នៅពេល រាត្រី បាន បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល ជាខ្លាំង ដល់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ។ ហេតុការណ៍ នេះ បាន បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល កាលពី យប់ ថ្ងៃទី ១៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ ចំណុច មុខ សាលា ឃុំ សែនមនោរម្យ ស្រុក អូរ រាំង ខេត្ត មណ្ឌលគិរី ។
លោក ហាក់ ទិត្យ ឬ ទ្ធី វង្ស អធិការ ស្រុក អូរ រាំង ក៏ បាន អះអាង ថា នៅពេល កើត ហេតុ លោក ឃើញ ភាគី ទាំង ពីរ ពោល លោក អភិបាល ស្រុក និង លោក មេបញ្ជាការ សឹក រង កំពុង ដក កាំភ្លើង ភ្ជង់ គ្នា ទៅ ហើយ ។ ភ្លាម នោះ លោក បាន ធ្វើ ការសម្របសម្រួល ប៉ុន្ដែ លោក អភិបាល រង ស្រុក នៅ រឹង ទទឹង ថែមទាំង រេកាំភ្លើង មក ភ្ជង់ លោក ថែម ទៀត ហើយ លោក ក៏ ស្ទុះ ទៅ ចាំ យក កាំភ្លើង ពី លោក អភិបាល រង ស្រុក តែម្ដង សំដៅ បញ្ចប់ វិវាទ ។
យ៉ាងណាមិញ ករណី នេះ លោក សៀក មុន្នី អភិបាល ស្រុក អូរ រាំង បាន កោះ កៅ ភាគី ទាំង ពីរ គឺ លោក អភិបាល រង ស្រុក និង មេបញ្ជាការ សឹក រង ស្រុក ដើម្បី ធ្វើ ការសួរនាំ និង បញ្ចប់ ទំនាស់ រវាង អ្នក ទាំង ពីរ ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ផ្ញើ សារ ជូនពរ ឯកឧត្តម ឧប នាយក រដ្ឋមន្ដ្រី នេត សាវឿន ក្នុង ថ្ងៃ ចម្រើន ជន្មាយុ គ្រប់ ៦៤ ឆ្នាំ ឈាន ចូល ៦៥ ឆ្នាំ
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ផ្ញើ សារលិខិត ជូន ពរ ជូនពរ ចំពោះ ឯកឧត្តម សន្តិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ក្នុង ឱកាស ដ៏ មហាន ក្ខត្ត ឫក្ស នៃ ថ្ងៃចម្រើន ជន្មាយុ គម្រប់ ៦៤ ឆ្នាំ ឈាន ចូល ៦៥ ឆ្នាំ ដែល នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃអាទិត្យ ៩កើត ខែ មាឃ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
តាម សារ លិខិត សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន យ៉ាង ដូច្នេះ ថា៖ « ឯកឧត្តម ជា ទី រាប់អាន ! ស្ថិត ក្នុង ឱកាស ជ័យ មង្គល នៃ ពិធី ខួបកំណើត របស់ ឯកឧត្តម គម្រប់ ៦៤ ឆ្នាំ ឈាន ចូល ៦៥ ឆ្នាំ ខ្ញុំ និង ភរិយា សូម ជូនពរ ជ័យ បវរ សួស្តី សិរី វឌ្ឍនា វិបុល សុខ ជូន ឯកឧត្តម សូម មាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង មាំ មួន ប្រាជ្ញា ស្មារតី ភ្លឺស្វាង និង មាន អាយុ យឺនយូរ ។
លោក Kuleba បាន បង្ហោះ សារ លើ បណ្តាញ ទំនាក់ទំនង សង្គម យ៉ាង ដូច្នេះ ថា « ខ្ញុំ ទើបតែ បាន ជួប សមភាគី ចិន របស់ ខ្ញុំ គឺ លោក វ៉ាង យី ហើយ ពិភាក្សា គ្នា អំពី ទំនាក់ទំនង ទ្វេ ភាគី ពាណិជ្ជកម្ម និង ភាពចាំបាច់ ក្នុង ការស្តារ សុខ សន្តិភាព ដែល យុត្តិធម៌ និង យូរអង្វែង នៅ អ៊ុយក្រែន ឡើងវិញ » ។ ប្រមុខ ការទូត នៃ ប្រទេស ទាំង ពីរ បាន ជួបគ្នា អំលុង ព្រឹត្តិការណ៍ សន្និសីទ សន្តិសុខ ទីក្រុង Munich នៅ ប្រទេស អាល្លឺម៉ង់ ។
យោង តាម សេចក្តីថ្លែងការណ៍ នា ថ្ងៃអាទិត្យ នេះ ដោយ ក្រសួង ការបរទេស ចិន អំលុង ការថ្លែង សុន្ទរកថា ក្នុង សន្និសីទ ខាងលើ លោក វ៉ាង បាន លើកឡើង ថា ចិន បាន បន្ត ពុះពារ លើកកម្ពស់ កិច្ចពិភាក្សា ស្វែងរក សន្តិភាព ក៏ ដូចជា ប្រឹងប្រែង ដើរ តួនាទី ប្រកបដោយ ភាពវិជ្ជមាន ក្នុង ការជួយ ស្តារ សុខ សន្តិភាព ឡើងវិញ ។
( ភ្នំពេញ ) ៖ លោក សន្ដិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្ដ្រី និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នៅ ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ បន្ដ របស់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ។ សន្និបាត បូកសរុប លទ្ធផល ការងារ នេះ ត្រូវបាន រៀបចំ ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ ដោយ មាន ការចូលរួម ពី អ្នក ពាក់ព័ន្ធ ទាំងអស់ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក សន្តិ បណ្ឌិត នេត សាវឿន ឧប នាយក រដ្ឋមន្រ្តី បាន វាយតម្លៃ ខ្ពស់ ចំពោះ សម ទ្ធិផល ការងារ ដែល អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ដែល សម្រេចបាន នា ពេល កន្លងមក ក៏ ដូចជា ការអនុវត្ត ផែនការ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទទួលបាន ជោគជ័យ តាំងពី លើក ទី១ រហូតមកដល់ លើក ទី៨ នៅ ឆ្នាំ ២០២៣ កន្លងទៅ នេះ ។
ជោគជ័យ ទាំងអស់ នេះ គឺ មិន អាច កាត់ផ្តាច់ បាន ពី ការដឹកនាំ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដោយ កន្លងមក សម្តេច តែងតែ យកចិត្តទុកដាក់ ណែនាំ តម្រង់ ទិស ដាក់ចេញ នូវ គោល នយោយ បាយ នានា ធ្វើ យ៉ាងណា ឲ្យ ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន មាន ភាពមុត ស្រួច និង ប្រកបដោយ ស័ក្ត សិទ្ធិភាព ។
ឧប នាយក រដ្ឋមន្រ្តី នេត សាវឿន បាន អះអាង ទៀត ថា សម្រាប់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ នៃ រដ្ឋសភា សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ចាត់ទុក បញ្ហា គ្រឿងញៀន ជា បញ្ហា អាទិភាព មួយ ក្នុង ចំណោម បញ្ហា អាទិភាព មួយចំនួន ទៀត ដែល ត្រូវ ដោះស្រាយ ចំពោះ មុខ ហើយ បាន បង្ហាញ ពី ឆន្ទៈ ដ៏ មុត ស្រួច បំផុត ក្នុង ការកាត់បន្ថយ និង ឈាន ទៅ លុបបំបាត់ ឲ្យ អស់ ពី កម្ពុជា ដើម្បី ឆ្លើយតប ទៅនឹង ក្តី ព្រួយបារម្ភ របស់ ប្រជាពលរដ្ឋ កម្ពុជា ទាំងមូល ។
សន្និបាត នា ថ្ងៃ នេះ ផ្តោត ទៅ លើ ទិសដៅ ការងារ អាទិភាព ចំនួន ៥ក្នុង នោះ រួម មាន៖ ១៖ ការងារ ផ្សព្វផ្សាយ និង អប់រំ . ២៖ ការគ្រប់គ្រង ត្រួតពិនិត្យ សារធាតុ ញៀន និង គីមីផ្សំ . ៣៖ ការងារ ព្យាបាល ស្តារ នីតិ សម្បទា និង សមាហរណកម្ម . ៤៖ ការងារ ពង្រឹង ប្រសិទ្ធិភាព អនុវត្ត ច្បាប់ និង ៥៖ ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ។
យោង តាម របាយការណ៍ របស់ នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ អគ្គ លេខាធិការ នៃ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ឲ្យដឹង ថា លទ្ធផល ការងារ ដែល អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន សម្រេចបាន នា ពេល កន្លងមក រួម មាន៖
* ទី៣៖ ការអនុវត្ត វិធានការអនុវត្ត ច្បាប់ ក្នុង ក្របខ័ណ្ឌ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ លើក ទី ៨៖
សារធាតុ គីមី ផ្សំ រឹបអូស បាន ១តោន ៤៦៩ គីឡូក្រាម /៤៧៦ តោន ១១៦ គីឡូក្រាម តិច ជាង ៤៧៤តោន ៦៤៧ គីឡូក្រាម គឺ តិច ជាង ប្រមាណ ជាង ៤០០ ដង បើ ធៀប នឹង ឆ្នាំ ២០២២ ។ រួមទាំង មធ្យោបាយ សម្ភារ និង ឧបករណ៍ កែច្នៃ ផលិត គ្រឿងញៀន ដែល បាន ចាប់ យក ក្នុង ប្រតិបត្តិការ បង្ក្រាប បទល្មើស គ្រឿងញៀន និង បាន បញ្ចូន ទៅ សាលាដំបូង រាជធានី ខេត្ត ជាច្រើន ផងដែរ ។
* ទី៤៖ បាន អនុញ្ញាតឱ្យ នាំចូល នូវ សារធាតុ ញៀន និង សារធាតុ គីមី ផ្សំ ដែល កំណត់ ក្នុង តារាង ឧបសម្ព័ន្ធ នៃ ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន សរុប ចំនួន ១៣១ .៧៥៨ តោន ១៣៥ គីឡូក្រាម ។
* ទី៦៖ បាន សហការ សម្របសម្រួល អនុវត្ត យន្តការ នៃ កិច្ចសហប្រតិបត្តិការ ត្រួតពិនិត្យ គ្រឿងញៀន ទាំង ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី ពហុ ភាគី ជាមួយ ប្រទេស ជាប់ ព្រំដែន ប្រទេស ក្នុង អនុ តំបន់ តំបន់ អន្តរជាតិ និង ដៃគូ អភិវឌ្ឍន៍ នានា ក៏ ដូចជា បាន បង្កើន សកម្មភាព ក្នុង ន័យ បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ ត្រួតពិនិត្យ គ្រឿងញៀន ទាំង នៅក្នុង ក្របខ័ណ្ឌ អន្តរជាតិ តំបន់ និង ទាំង ជាមួយ ប្រទេស ជាប់ ព្រំដែន ៕
ការលើកឡើង របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ធ្វើឡើង ក្នុង ឱកាស សម្ដេច អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ឲ្យដឹង ថា រាជ រដ្ឋាភិបាល អាជ្ញាធរ រាជធានី ភ្នំពេញ គ្មាន ផែនការហាមឃាត់ ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ បង្កើត កូន ច្រើន នោះ ទេ ក្នុង នោះ មួយ គ្រួសារ ប្រសិនបើ អាច បង្កើត កូន បាន ត្រឹម ៥នាក់ កាន់តែ ល្អ ប្រសើរ ជាក់ស្ដែង ប្រជាពលរដ្ឋ រស់ ក្នុង ទីក្រុង ភ្នំពេញ ពុំ ទាន់ ចង់ យក កូន ច្រើន នោះ ទេ តាម មធ្យម ភាគ តួលេខ ទូទាំង ប្រទេស កម្ពុជា អត្រា ពលរដ្ឋ មាន កូន មាន ត្រឹម១ កន្លះ ប៉ុណ្ណោះ ។
សម្ដេច ធិបតី ក៏ បាន លើកឡើង ថា បន្ថែម ពី នេះ ក៏ ត្រូវ គិតគូរ ដោះស្រាយ បញ្ហា ចរាចរណ៍ ក្នុង រាជធានី ភ្នំពេញ ដោយ ត្រូវ ចាប់ផ្ដើម ពី ពេល ឥឡូវនេះ តែម្ដង កន្លងមក យើង បាន គិរ គូរ ពី បញ្ហា ចរាចរណ៍ នេះ ដោយ សម្ដេច តេជោ ហ៊ុន សែន បាន ឲ្យ សិក្សា ជាច្រើន ហើយ រហូតដល់ បច្ចុប្បន្ន នេះ យើង ត្រូវតែ បន្ដ បន្ថែម ទៀត ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត៖ គោលដៅ ចម្បង របស់ រដ្ឋាភិបាល គឺ ការលើកកម្ពស់ ជីវភាព រស់ នៅ កាត់បន្ថយ ភាពក្រីក្រ របស់ ពលរដ្ឋ និង ជំរុញ ការអភិវឌ្ឍ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បញ្ជាក់ ថា គោលដៅ ចម្បង របស់ រាជ រដ្ឋាភិបាល រយៈពេល ជាង ៤០ ឆ្នាំ មក នេះ ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា គឺ ការលុបបំបាត់ ភាពក្រីក្រ និង បង្កើន ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ តាមរយៈ ការបិទ បញ្ចប់ ភ្លើង សង្គ្រាម និង ជំរុញ ការអភិវឌ្ឍ ។
ការបញ្ជាក់ បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព បើក ការដ្ឋាន ការសាងសង់ ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ នៅ រាជធានី ភ្នំពេញ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា សម្រាប់ គោលដៅ ចម្បង របស់ រាជ រដ្ឋាភិបាល ក្នុង អាណត្តិ ទី៧ និង អាណត្តិ មុន ៗ គឺ ជំរុញ កំណើន សេដ្ឋកិច្ច ប្រកបដោយ ជីវភាព បង្កើត ការងារ ឱ្យ បាន ច្រើន ។ ប្រែក្លាយ ពី បឹង ពី ព្រៃ ពី វាល ស្រែ កន្លែង អត់ ផ្លូវ ទៅជា កន្លែង ដែល មាន បង្កបង្កើន ផល កសិកម្ម រុញ ភ្លើង អគ្គិសនី រោងចក្រ ទៅដល់ មូលដ្ឋាន ដែល បាន បង្កើត ការងារ ជូន ប្រជាពលរដ្ឋ ជាច្រើន កន្លែង ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន លើកឡើង ថា ប្រសិនបើ រាប់ ត្រឹម ចុង ឆ្នាំ ១៩៩៨ ដែល ដាក់ចេញ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នោះ កម្ពុជា ទើបតែ បញ្ចប់ សង្គ្រាម ស៉ី វិល ទាំងស្រុង ប្រមាណ ២៥ ឆ្នាំ ប៉ុណ្ណោះ ។ ប៉ុន្តែ ក្រោម ដំបូល នៃ សន្តិភាព ពេញ ផ្ទៃ ប្រទេស នេះ បាន ធ្វើឱ្យ ជីវភាព របស់ ប្រជាពលរដ្ឋ កម្ពុជា មាន ការកើនឡើង យ៉ាង លឿន ក្នុង រយៈពេល ២៥ ឆ្នាំ មក នេះ ។
បន្ថែម ពី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បន្ត ថា នៅ ឆ្នាំ ១៩៧៩ ដល់ ឆ្នាំ ១៩៩៨ កម្ពុជា មិន ទាន់ បាន បិទ បញ្ចប់ សង្គ្រាម ទាំងស្រុង នៅឡើយ នោះ ទេ ដោយសារតែ ខ្មែរ ក្រហម នៅ មាន កម្លាំង របស់ ខ្លួន នៅ តាម តំបន់ ព្រៃ ភ្នំ ជា ដុំ ៗ នៅឡើយ ។ ហើយ ថវិកា ជាតិ ជាច្រើន ត្រូវបាន ចំណាយ លើ ការទិញ គ្រាប់ និង សព្វាវុធ សម្រាប់ ច្បាំង គ្នា និង កម្លាំង ពលកម្ម ជាតិ ច្រើន ត្រូវបាន បញ្ជូន ក្នុង ជួល កងទ័ព ដើម្បី ច្បាំង គ្នា លើ សមរភូមិ ជាដើម ។
ពីលើ វេទិកា ក្នុង ឱកាស អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ . សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន អះអាង ថា អ្នក ដែល យក កម្ពុជា ផលិត វីដេអូ ដើម្បី បាន អ្នកទស្សនា ច្រើន នឹង ត្រូវ ចាត់ វិធានការ តាម ច្បាប់ ជាធរមាន ហើយ ក្រោយ ចាត់ វិធានការ ច្បាប់ ហើយ នោះ នឹង ត្រូវ ដេញ ចេញ ពី កម្ពុជា តែម្ដង ។
សារ ព្រមាន របស់ សម្ដេច ធិបតី នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ធ្វើឡើង បន្ទាប់ពី សប្ដាហ៍ កន្លងទៅ នេះ មាន ជនជាតិ ចិន តៃវ៉ាន់ ២នាក់ ត្រូវបាន កម្លាំង សមត្ថកិច្ច ចាប់ខ្លួន បន្ទាប់ពី ពួកគេ រួមគ្នា ផលិត វីដេអូ ក្លែងក្លាយ សម្ដែង ជា អំពើ ចាប់ ជំរិត និង ធ្វើ ទារុណកម្ម នៅ ខេត្ត ព្រះសីហនុ ហើយ បង្ហោះ ចែកចាយ នៅលើ បណ្ដាញ សង្គម ដើម្បី បាន អ្នក ចូល ទស្សនា ច្រើន រួច ផលិតផល តាម អនឡាញ ជា ប្រយោជន៍ ផ្ទាល់ខ្លួន ។
ជនជាតិ ចិន តៃវ៉ាន់ ទាំង ពីរ នាក់ នេះ ក្រោយ ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន បាន កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង ខេត្ត ព្រះសីហនុ ហើយ ត្រូវបាន សាលាដំបូង ខេត្ត សម្រេច ផ្ដន្ទាទោស តាម ច្បាប់ ដោយ ដាក់ ពន្ធនាគារ ម្នាក់ ២ ឆ្នាំ និង ពិន័យ ជា ប្រាក់ ម្នាក់ ៤លាន រៀល ។ បើ តាម ការបញ្ជាក់ ថា ក្រោយ អនុវត្ត ទោស ចប់ នៅ ប្រទេស កម្ពុជា ជនជាតិ ចិន តៃវ៉ាន់ ទាំង ពីរ នាក់ នេះ នឹង ត្រូវ បណ្ដេញចេញ ពី កម្ពុជា ។
ទាក់ទិន ករណី នេះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន បង្ហើប ថា មាន អ្នកតវ៉ា ស្វែងរក កិច្ចអន្ដរាគមន៍ ដើម្បី ជួយ ដល់ យុវជន ចិន តៃវ៉ាន់ ទាំង ២នាក់ នេះ ក្រោយ ហេតុផល ថា ម្ដាយ របស់ ពួកគេ កំពុង ឈឺ ហើយ កំពុង សម្រាក ព្យាបាល ជំងឺ ប៉ុន្ដែ ត្រូវបាន សម្ដេច បដិសេធ ហើយ ស្ដី បន្ទោស ត្រឡប់ ទៅវិញ ថែម ទៀត ។ សម្ដេច ថា បើ ម្ដាយ ឈឺ យុវជន ទាំង ពីរ នាក់ នេះ ជា កូន អកត្តញ្ញូ មិន នៅ មើល ម្ដាយ បែរជា ជិះ យន្ដហោះ មក បំផ្លាញ កិត្តិយស ប្រទេស គេ ទៅ វិញ ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត . តាមរយៈ ការផលិត វីដេអូ ប្រឌិត បែប នេះ បាន បំផ្លាញ ដល់ កិត្តិយស របស់ ប្រទេស កម្ពុជា និង ប៉ះពាល់ ដល់ វិស័យ ទេសចរណ៍ ហើយ ជះ ឥទ្ធិពល ដល់ ប្រជាពលរដ្ឋ កម្ពុជា ។
សម្ដេច ធិបតី ប្រមុខ នៃ រាជ រដ្ឋាភិបាល បាន បន្ថែម ទៀត ថា កន្លងទៅ ក្រៅពី ករណី ប្រឌិត រឿង ចាប់ ជំរិត ជន បរទេស មួយចំនួន នោះ បាន ប្រឌិត រឿង ជួញដូរ សិរី រាង្គ នៅ ប្រទេស កម្ពុជា ថែម ទៀត ផង ដើម្បី តែ ទទួលបាន ជំនួយ ជា ផលប្រយោជន៍ ផ្ទាល់ ប៉ុន្ដែ ករណី ទាំងអស់ នេះ ក៏ ត្រូវបាន សមត្ថកិច្ច កម្ពុជា ស្រាវជ្រាវ និង លាតត្រដាង ការពិត ទៅកាន់ មហាជន ពិសេស មតិ អន្ដរជាតិ ជៀសវាង ការយល់ ច្រឡំ និង គិត ខុសមក កម្ពុជា ៕
ការលើកឡើង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អញ្ជើញ បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លង ទន្លេ បាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) តម្លៃ ជាង ៦០ លាន ដុល្លារ ដែល ជា ស្ពាន ឆ្លងកាត់ ទន្លេ ក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
ទន្ទឹម គ្នា នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា មាន ផ្លូវកាន់តែ រឹងមាំ ក្តីសង្ឃឹម កាន់តែ រឹងមាំ មាន ផ្លូវកាន់តែ ច្រើន ក្តីសង្ឃឹម ក៏ កាន់តែ ច្រើន ។ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ផ្លូវ ដូច សរសៃ ឈាម អ៊ីចឹង ផ្លូវ ទៅដល់ ទីណា ជួយ ចិញ្ចឹម សរីរាង្គ នៅ ទីនោះ ។
បន្ថែម ពី នោះ ទៀត សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា ផ្លូវ គឺ ជួយ សម្រួល ក្នុង ការធ្វើចរាចរណ៍ កាត់បន្ថយ ការចំណាយ និង បើក ឱកាស ឲ្យ ប្រជាពលរដ្ឋ អាច ប្រកបរបប រកស៊ី បាន ផងដែរ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ទៀត ថា ផ្លូវ មិន មែន ប្រើ សម្រាប់ តែ ការធ្វើ ចំណាកស្រុក ប៉ុណ្ណោះ ទេ តែ ផ្លូវ បាន រួមចំណែក រុញ រោងចក្រ និង ការងារ ជូន ប្រជាពលរដ្ឋ ។
បើ តាម ការបញ្ជាក់ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ឲ្យដឹង ថា បច្ចុប្បន្ន កម្ពុជា មាន ស្ពាន ឆ្លងកាត់ ទន្លេ ចំនួន ២៥ ស្ពាន ។ ក្នុង នោះ ស្ពាន ចំនួន ១៩ ធ្វើ រួចរាល់ . ៣ស្ពាន កំពុង សាងសង់ និង ៣ស្ពាន ទៀត កំពុង សិក្សា ។
បើ តាម CENTCOM ការវាយប្រហារ តាម ផ្លូវ អាកាស ទាំង ៥លើក ក្នុង នោះ រួម មាន ទាំង ការវាយប្រហារ លើ ដ្រូន ក្រោម សមុទ្រ របស់ ក្រុម ហ៊ូទី ជា លើក ដំបូង ចាប់តាំងពី សង្រ្គាម ក្នុង តំបន់ ហ្កាហ្សា ផ្ទុះឡើង កាលពី ខែតុលា ឆ្នាំ មុន មក និង ដ្រូន លើ ផ្ទៃ ទឹក ខណៈ ការវាយប្រហារ ៣លើក ផ្សេង ទៀត មាន គោលដៅ លើ មីស៊ីល គ្រូស ប្រឆាំង នាវា ចម្បាំង របស់ ក្រុម ហ៊ូទី ។
គួរ បញ្ជាក់ ថា ក្រុម ហ៊ូទី ដែល កំពុង គ្រប់គ្រង ទឹកដី មួយ ផ្នែក ធំ ក្នុង ប្រទេស យេម៉ែន រួមទាំង ទីក្រុង កំពង់ផែ Hodeida បាន ចាប់ផ្ដើម វាយប្រហារ លើ នាវា ចម្បាំង អាមេរិក និង កប៉ាល់ ដឹក ទំនិញ ក្នុង តំបន់ សមុទ្រ ក្រហម ក្នុង ខែវិច្ឆិកា ឆ្នាំ ២០២៣មក ដោយ មាន គោលដៅ លើ រាល់ កប៉ាល់ ឆ្ពោះ ទៅកាន់ អ៉ី ស្រាអែល ជា ការបង្ហាញ សាមគ្គីភាព ដល់ ប្រជាជន ប៉ាឡេស្ទីន ក្នុង តំបន់ ហ្កាហ្សា ដែល កំពុង រង ការបំផ្លិចបំផ្លាញ ដោយសារ សង្រ្គាម រវាង អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ៣នាក់ ។
ក្នុង អនុក្រឹត្យ បាន បញ្ជាក់ ថា កម្មវិធី កាត់បន្ថយ និង / ឬ លុបបំបាត់ ពន្ធ គយ នេះ ត្រូវបាន កំណត់ នៅក្នុង ឧបសម្ព័ន្ធ នៃ អនុក្រឹត្យ នេះ ។ កម្មវិធី កាត់បន្ថយ និង / ឬ លុបបំបាត់ ពន្ធ គយ ដូច មាន ចែង នៅក្នុង ឧបសម្ព័ន្ធ នៃ អនុក្រឹត្យ នេះ ត្រូវ អនុវត្ត ចំពោះ តែ ទំនិញ នាំចូល ទាំងឡាយ ណា ដែល មាន ដើមកំណើត នៅ បណ្តា ប្រទេស ជា សមាជិក នៃ កិច្ចព្រមព្រៀង នេះ តែ ប៉ុណ្ណោះ ដោយ អនុលោម តាម បទប្បញ្ញត្តិ នៃ ជំពូក ទី៣ ស្តីពី វិធាន ដើមកំណើត នៃ កិច្ចព្រមព្រៀង នេះ ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ដែល បាន ផ្ញើ ទៅកាន់ ស៊ីន ហួ ក្រសួង បាន និយាយ ថា ជនជាតិ ប៉ាឡេ ស្ទីន ចំនួន ៦៨.៨៨៣ នាក់ បាន រងរបួស ចាប់តាំងពី ការផ្ទុះឡើង នៃ ជម្លោះ អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស់ កាលពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ ។
ក្រសួង បាន បន្ថែម ថា កងទ័ព អ៊ីស្រាអែល បាន សម្លាប់ ជនជាតិ ប៉ាឡេស្ទីន ១២៧ នាក់ និង ២០៥ នាក់ ផ្សេង ទៀត របួស ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ នេះ ។
របាយការណ៍ ប បាន កត់សម្គាល់ ទៀត ថា ជនរងគ្រោះ មួយចំនួន នៅតែ ស្ថិត នៅក្រោម គំនរ បាក់បែក នៅឡើយ ចំពេល មាន ការទម្លាក់ គ្រាប់បែក យ៉ាង ធ្ងន់ធ្ងរ និង កង្វះ ផ្នែក ការពារ ស៊ីវិល និង ក្រុម រថយន្ត សង្គ្រោះ បន្ទាន់ ។
គួរ បញ្ជាក់ ថា អ៊ីស្រាអែល បាន និង កំពុង បើក ការវាយលុក ទ្រង់ទ្រាយ ធំ ប្រឆាំង នឹង ក្រុមហា ម៉ាស់ នៅ តំបន់ ហ្គាហ្សា ស្ទ្រីប ដើម្បី សងសឹក ប្រឆាំង នឹង ការវាយលុក របស់ ក្រុមហា ម៉ាស់ ឆ្លងកាត់ ព្រំដែន ភាគ ខាងត្បូង អ៊ីស្រាអែល កាលពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ ក្នុង អំឡុង ពេល ដែល មនុស្ស ប្រហែល ១.២០០ នាក់ បាន ស្លាប់ និង ជាង ២០០ នាក់ ត្រូវបាន ចាប់ ធ្វើជា ចំណាប់ខ្មាំង ៕
ជនជាតិ អ៊ីស្រាអែល ប្រហែល ៤៩០.០០០ នាក់ កំពុង រស់ នៅក្នុង តំបន់ West Bank ដែល អ៊ីស្រាអែល បាន កាន់កាប់ តាំងពី ឆ្នាំ ១៩៦៧ នៅក្នុង ការតាំង ទីលំនៅ រាប់ សិប កន្លែង ដែល ត្រូវបាន ចាត់ទុក ថា ខុស ច្បាប់ ក្រោម ច្បាប់ អន្តរជាតិ ។ ចំណែកឯ ជនជាតិ អ៊ីស្រាអែល ដែល រស់ នៅ ជាមួយ ជនជាតិ ប៉ាឡេ ស្ទីន មាន ប្រហែល បី លាន នាក់ នៅក្នុង តំបន់ ។
ប្រជាជន ប៉ាឡេស្ទីន ចាត់ទុក ការតាំង ទីលំនៅ របស់ អ៊ីស្រាអែល ថា ជា ឧក្រិដ្ឋកម្ម និង ជា ឧបសគ្គ ចម្បង ចំពោះ សន្តិភាព ប៉ុន្តែ អ្នក ជាតិនិយម និង អ្នកកាន់ សាសនា តឹង តែង ជាច្រើន យល់ឃើញ ថា ការរស់ នៅ ទីនោះ ជាជា ការបំពេញ ការសន្យា ដ៏ ពិសិដ្ឋ ។
ចាប់តាំងពី ការចាប់ផ្តើម នៃ សង្រ្គាម រវាង អ៊ីស្រាអែល និង ក្រុមហា ម៉ាស់ នៅ ថ្ងៃទី ៧ ខែតុលា ចំនួន នៃ ការប៉ះទង្គិច គ្នា រវាង កងកម្លាំង អ៊ីស្រាអែល និង ប៉ាឡេ ស្ទីន នៅ តំបន់ West Bank បាន កើនឡើង ។
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ពិធី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ ក្រសួង ការងារ កាលពី ថ្ងៃទី ០៨ ខែកុម្ភៈ បាន ផ្តល់ អនុសាសន៍ ណែនាំ ចំនួន ១៣ ចំណុច ឱ្យ ក្រសួង ការងារ អនុវត្ត ឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត ខណៈ អនុសាសន៍ ណែនាំ នានា របស់ សម្តេច ធិបតី នា ពេល កន្លងមក ក្រសួង ការងារ អនុវត្ត បាន យ៉ាង ជោគជ័យ ។
ជុំវិញ អនុសាសន៍ ណែនាំ នេះ លោក បណ្ឌិត គិន ភា អ្នកវិភាគ សង្គម - នយោបាយ នៅ កម្ពុជា បាន បញ្ជាក់ ថា ជា អនុសាសន៍ ណែនាំ ដ៏ មាន សារសំខាន់ សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ ជាពិសេស ប្រជាពលរដ្ឋ ដែល ធ្វើការ នៅ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ព្រោះ កន្លងមក ពលរដ្ឋ ទាំង នេះ មិន ទាន់ យន្តការគាំពារ សង្គម ណាមួយ សម្រាប់ ពួកគាត់ នោះ ទេ ។
តែ យ៉ាងណា សម្រាប់ រដ្ឋាភិបាល អាណត្តិ ទី៧ ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ដាក់ចេញ គោល នយោបាយ ដែល អាច ឱ្យ ពលរដ្ឋ ធ្វើការ នៅ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ ទទួលបាន សេវា ថែទាំ សុខភាព របស់ បេឡា ជាតិ សន្តិសុខ សង្គម « ប .ស. ស » ដែល ការណ៍ នេះ ជា រឿង គួរឱ្យ សាទ រ ខ្លាំង ណាស់ ។
លោក បណ្ឌិត គិន ភា បាន បន្ថែម ទៀត ថា សម្រាប់ របប សន្តិសុខ សង្គម នេះ គឺ មាន អត្ថប្រយោជន៍ ដល់ មហាសាល សម្រាប់ ប្រជាពលរដ្ឋ ហើយ ប្រសិនបើ មាន ការពង្រីក វិសាលភាព កាន់តែ ទូលំទូលាយ ថែម ទៀត នោះ លោក គិត ថា នេះ គឺជា ការជួយ ជាក់ស្តែង ចំពោះ ពលរដ្ឋ ពីសំណាក់ រដ្ឋាភិបាល ។
លោក បណ្ឌិត បញ្ជាក់ ទៀត ថា យ៉ាង ដើម្បី សម្រេច នូវ អនុសាសន៍ ណែនាំ របស់ សម្តេច ធិបតី គឺ ចាំបាច់ ត្រូវ មាន ក្របខ័ណ្ឌ គោល នយោបាយ ក្របខ័ណ្ឌ យុទ្ធសាស្ត្រ និង លិខិត បទដ្ឋាន គតិយុទ្ធ ផ្សេង ៗ ទៀត ដើម្បី ជា ធាតុ ចូល ធ្វើ យ៉ាងណា ឱ្យ ការអនុវត្ត កាន់តែ មាន ប្រសិទ្ធភាព ។
ជាថ្មី ម្ដង ទៀត លោក បណ្ឌិត គិន ភា បាន ជឿជាក់ ថា នៅពេល អនាគត របប សន្តិសុខ សង្គម នេះ នឹង ទទួលបាន ការចាប់អារម្មណ៍ កាន់តែ ច្រើន ពីសំណាក់ ប្រជាពលរដ្ឋ គ្រប់ រូប ៕
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ផ្ញើ សារ ជូនពរ ឯកឧត្តម ឧប នាយក រដ្ឋមន្ដ្រី ប្រចាំ ការ វង្សី វិស្សុត ក្នុង ថ្ងៃ ចម្រើន ជន្មាយុ គ្រប់ ៥៩ ឆ្នាំ ឈាន ចូល ៦០ ឆ្នាំ
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន ផ្ញើ សារ ជូនពរ ឯកឧត្តម ឧប នាយក រដ្ឋមន្ដ្រី ប្រចាំ ការ វង្សី វិស្សុត រដ្ឋមន្ដ្រី ទទួលបន្ទុក ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ក្នុង ឱកាស ដ៏ មហាន ក្ខត្ត ឫក្ស នៃ ថ្ងៃចម្រើន ជន្មាយុ គម្រប់ ៥៩ ឆ្នាំ ឈាន ចូល ៦០ ឆ្នាំ ។
តាមរយៈ សារលិខិត សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន យ៉ាង ដូច្នេះ ថា៖ « ឯកឧត្តម ជា ទី រាប់អាន ! ស្ថិត ក្នុង ឱកាស ជ័យ មង្គល នៃ ពិធី ខួបកំណើត របស់ ឯកឧត្តម គម្រប់ ៥៩ ឆ្នាំ ឈាន ចូល ៦០ ឆ្នាំ ខ្ញុំ និង ភរិយា សូម ជូនពរ ជ័យ បវរ សួស្តី សិរី វឌ្ឍនា វិបុល សុខ ជូន ឯកឧត្តម សូម មាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង មាំ មួន ប្រាជ្ញា ស្មារតី ភ្លឺស្វាង និង មាន អាយុ យឺនយូរ ។
( កំពត ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ស្នងការ នគរបាល ខេត្ត កំពត នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន ចាត់ ឱ្យ មន្ត្រី នគរបាល រៀបចំ តម្លើង ស្លាកសញ្ញា កំណត់ ល្បឿន លើ ផ្លូវ ជាតិ លេខ ៣ ពី ភ្នំពេញ មក ខេត្ត កំពត មាន ០៣ គោលដៅ ។
ស្នងការ នគរបាល ខេត្ត កំពត បាន ឱ្យដឹង ថា សម្រាប់ គោលដៅ ទាំង៣ នេះ រួម មាន៖
ចំពោះ ការតម្លើង ស្លាកសញ្ញា កំណត់ ល្បឿន លើ ផ្លូវ ជាតិ លេខ ៣នេះ ទទួលបាន ការសាទរ យ៉ាង ខ្លាំង ណាក់ ប្រជាពលរដ្ឋ ៕ គ.ជ. ប៖ ថ្ងៃទី ៩ នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ប្រព្រឹត្តទៅ ដោយ រលូន ពុំ មាន បាតុភាព ណាមួយ កើតឡើង គួរឱ្យ កត់សម្គាល់ ឡើយ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ដែល ជា ថ្ងៃទី ៩ នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ ពុំ មាន ការហែ ក្បួន ឃោសនា បោះឆ្នោត ទេ ប៉ុន្តែ គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត ទាំង ៤ គណបក្ស បាន ធ្វើ សកម្មភាព ឃោសនា ផ្សេង ទៀត ដើម្បី ផ្សព្វផ្សាយ អំពី គោល នយោបាយ របស់ គណបក្ស នយោបាយ ខ្លួន ដល់ អ្នកបោះឆ្នោត ។
ចាស់ជរា ក្រីក្រ គ្មាន ទីពឹង ចំនួន ៦០ នាក់ ទទួលបាន អំណោយ ពី សមាគម ក្រុមការងារ គ្រប់គ្រង សិស្ស - និសិ្សត អាហារូបករណ៍ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត
លោក ហាក់ ឡេង បាន ថ្លែង ថា សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត នៅតែ មាន ការយកចិត្តទុកដាក់ ទៅ លើ លោកយាយ លោក តាចាស់ជរា គ្មាន ទីពឹង ខ្វះខាត ជានិច្ច ដោយ សម្តេច ទាំង ទ្វេរ នៅតែ យកចិត្ត ទុក្ខ ដាក់ ជាប់ ជានិច្ច ទោះបី សម្តេច មិន ធ្វើ នាយក រដ្ឋមន្ត្រី ក៏ដោយ តែ បេះដូង សម្តេច នៅតែ មាន លោកយាយ លោក តា ជានិច្ច ។ ទោះបី អំណោយ ទាំងនេះ វា តិចតួច មែន តែ វា អាច ធ្វើឱ្យ លោកយាយ លោក តា បាន ដោះស្រាយ ក្នុង ជីវភាព គ្រួសារ បាន ធូរ មួយ គ្រា ផងដែរ ។
លោក បាន បន្ថែម ថា សម្តេច ទាំង ទ្វេរ តែ យកចិត្ត ទុក្ខ ដាក់ ដល់ ប្អូន ៗ ដែល ចង់ បន្ត ការសិក្សា តែ ក្នុង ជីវភាព ខ្វះខាត ហើយ នេះ ជា ឱ កាស ដ៏ ល្អ មួយ របស់ ក្រុមគ្រួសារ លោកយាយ លោក តា ដែល មាន កូន ចៅ ចង់ បន្ត ការសិក្សា ដើម្បីឱ្យ កូន ចៅ មាន ចំណេះដឹង ក្នុង ខ្លួន និង ប្រែក្លាយ យុវជន ឆ្នើម ហើយ កែប្រែ ក្នុង ជីវភាព គ្រួសារ បាន ល្អ ប្រសើរ ផងដែរ ។ អំណោយ ទាំងនោះ រួម មាន គ្រឿង ឧបភោគ បរិភោគ ខ្នើយ ភួយ និង ថវិកា ៥មុឺន រៀល ៕
បណ្ឌិត គិន ភា៖ យុទ្ធនាការ អប់រំ ផ្សព្វផ្សាយ ពិតជា ចាំបាច់ ដើម្បី បង្ការ ទប់ស្កាត់ អគ្គិភ័យ តាម រោងចក្រ និង ឧស្សាហកម្ម ទេសចរណ៍
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ពិធី បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ ក្រសួង ការងារ កាលពី ថ្ងៃទី ០៨ ខែកុម្ភៈ បាន ផ្តល់ អនុសាសន៍ ណែនាំ ចំនួន ១៣ ចំណុច ឱ្យ ក្រសួង ការងារ អនុវត្ត ឱ្យ កាន់តែ ប្រសើរ ថែម ទៀត ខណៈ អនុសាសន៍ ណែនាំ នានា របស់ សម្តេច ធិបតី នា ពេល កន្លងមក ក្រសួង ការងារ អនុវត្ត បាន ដោយ ជោគជ័យ ។
សម្រាប់ អនុសាសន៍ ណែនាំ ចំណុច ទី១០ របស់ សម្តេច ធិបតី ឱ្យ ក្រសួង ការងារ ត្រូវ សហការ ជាមួយ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បី រៀបចំ យុទ្ធនាការ អប់រំ និង ផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ នៅ ទូទាំង ប្រទេស សម្តៅ ជំរុញ និង លើកកម្ពស់ ការយល់ដឹង ជូន ដល់ បងប្អូន កម្មករ និយោជិត . អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ និង សាធារណជន អំពី វិធានការអប់រំ . បង្ការ និង ទប់ស្កាត់ អគ្គិភ័យ នៅ តាម បណ្តា សហគ្រាស និង គ្រឹះស្ថាន ធុរកិច្ច ក្នុង វិស័យ កម្មន្ត សាល និង ឧស្សាហកម្ម ទេសចរណ៍ ។
ជុំវិញ អនុសាសន៍ ណែនាំ នេះ លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន បញ្ជាក់ ថា លោក ពិតជា កោតសរសើរ និង គាំទ្រ ទាំងស្រុង ចំពោះ អនុសាសន៍ ណែនាំ របស់ សម្តេច ធិបតី ព្រោះ បញ្ហា គ្រោះ អគ្គិភ័យ នេះ អាច កើតឡើង ជា យថាហេតុ ដែល ទាមទារ ឱ្យ មាន វិធានការ ការអប់រំ និង បង្ការ ឱ្យ បាន ច្បាស់លាស់ ។
លោក បណ្ឌិត គិន ភា បាន បន្ត ថា ដើម្បី អនុវត្ត ឱ្យ បាន ជោគជ័យ ទៅតាម អនុសាសន៍ ណែនាំ របស់ សម្តេច ធិបតី ក្រសួង ការងារ ចាំបាច់ ត្រូវ មាន ការរៀបចំ វិធានការ ច្បាស់លាស់ ទាក់ទង នឹង ការផ្សព្វផ្សាយ អប់រំ ដើម្បីឱ្យ មាន ការយល់ដឹង ពី មូលហេតុ ដែល នាំឱ្យ កើតមាន គ្រោះ អគ្គិភ័យ ។ ជាមួយគ្នា នេះ ក៏ ត្រូវ មាន ការអប់រំ ផ្សព្វផ្សាយ ដល់ កម្មក និយោជិត បាន យល់ដឹង ពី ការសង្គ្រោះ បឋម នានា នៅពេល មាន អគ្គិភ័យ កើតឡើង ជាដើម ។
ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា រូប នេះ បាន បញ្ជាក់ បន្ថែម ទៀត ថា ក្រសួង ការងារ ក៏ ត្រូវ មាន កិច្ចសហការ ជាមួយ ម្ចាស់ រោងចក្រ សហគ្រាស នៅ ក្របខណ្ឌ ទូទាំង ប្រទេស ដើម្បីឱ្យ មាន ការរៀបចំ ច្រក ចេញ សុវត្ថិភាព បំពង់ ពន្លត់ អគ្គិភ័យ រួម នឹង ការហាត់ សម ពី ការជម្លៀស ខ្លួន ចេញ ពី អគ្គិភ័យ ជាដើម ។
ទន្ទឹមនឹង នេះ ក្រសួង ការងារ ក៏ ត្រូវ មាន កិច្ចសហការ ជាមួយ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ផ្សេង ទៀត ដូចជា ក្រសួង មហាផ្ទៃ ក្រសួង បរិស្ថាន និង អាជ្ញាធរ មូលដ្ឋាន នានា ដើម្បី ជំរុញ ការពន្លត់ អគ្គិភ័យ ឱ្យ បាន ទាន់ ពេលវេលា ដើម្បី បញ្ជៀស ការបង្ក គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ដល់ កម្មករ និយោជិត និង ម្ចាស់ រោងចក្រ សហគ្រាស នានា ៕
សមណ និស្សិត និង និស្សិត ឆ្នាំ ទី១ ជំនាន់ ទី២ ចំនួន ៧៨៣ អង្គ - នាក់ នៃ សាកលវិទ្យាល័យ សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី ប្រឡង គល់ បញ្ជី ក្រសួង អប់រំ ត្រៀម ចូលរៀន ឆ្នាំ ទី១
( កណ្ដាល ) ៖ សមណ និស្សិត និង និស្សិត ឆ្នាំ ទី១ ជំនាន់ ទី២ ចំនួន ៧៨៣ អង្គ - នាក់ នៃ សាកលវិទ្យាល័យ សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី បាន ចូល ប្រឡង គល់ បញ្ជី ក្រសួង អប់រំ យុវជន និង កីឡា ឆ្នាំ សិក្សា ២០២៣ - ២០២៤ ដើម្បី ត្រៀម ចូលរៀន ឆ្នាំ ទី១ ។
ការប្រឡង នេះ ធ្វើឡើង នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ក្រោម ព្រះវត្តមាន សម្តេច ព្រះមង្គល ទេ ពាចារ្យ វង្ស អានេតា សម្តេច ព្រះសង្ឃ នាយក រង នៃ គណៈធម្មយុត្តិក និកាយ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ជា ព្រះសាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី និង លោក ទូច វិសាល សុខ រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡាុ ។
សូម ជម្រាប ថា សាកលវិទ្យាល័យ សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី បង្កើតឡើង ក្នុង បុព្វហេតុ វិស័យ អប់រំ ជា ឧត្តម ប្រយោជន៍ ដល់ កូន ខ្មែរ គ្រប់ ជំនាន់តទៅ ដើម្បី ផ្តល់ ឱកាស ឱ្យ និស្សិត កុលបុត្រ ខ្មែរ គ្រប់ រូប បាន បន្ត ការសិក្សា រៀនសូត្រ ថ្នាក់ បរិញ្ញាបត្រ ដោយ មិន តម្រូវ ឱ្យ មាន ការបង់ ថ្លៃ សិក្សា នោះ ទេ ពោលគឺ សាកលវិទ្យាល័យ បាន ផ្តល់ ជូន និស្សិត នូវ អាហារូបករណ៍ សិក្សា ១០០ % ពី ឆ្នាំ ទី១ រហូតដល់ ឆ្នាំ ទី៤ ដែល ជា ឆ្នាំ បញ្ចប់ ការសិក្សា ។
បន្ថែម លើស នេះ សាកលវិទ្យាល័យ សម្ដេច ព្រះមហាសង្ឃរាជបួរ គ្រី ក៏ មាន ការសហការ ជាមួយ សាកលវិទ្យាល័យ បរទេស ជាច្រើន ផងដែរ សំដី ដល់ ការបញ្ជូន និស្សិត ទៅ សិក្សា ឆ្នាំ ទី៣ នៅ សាកលវិទ្យាល័យ បរទេស ណា នោះ ឱ្យ តែ ប្រឡង ជាប់ ពិសេស គឺ ភាសា អង់គ្លេស ជា ចម្បង ។
សូម បញ្ជាក់ ផងដែរ ថា សាកលវិទ្យាល័យ នេះ មាន មហាវិទ្យាល័យ ចំនួន ០៦ រួម មាន៖ មហាវិទ្យាល័យ សិល្បៈ មនុស្សសាស្ត្រ និង ភាសា . មហាវិទ្យាល័យ វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា . មហាវិទ្យាល័យ វិទ្យាសាស្ត្រ សង្គម . មហាវិទ្យាល័យ វិស្វកម្ម និង ស្ថាបត្យកម្ម មហាវិទ្យាល័យ សិក្សា អភិវឌ្ឍ និង ទេសចរណ៍ និង មហាវិទ្យាល័យ វិទ្យាសាស្រ្ត សេដ្ឋកិច្ច និង ធុរកិច្ច ដែល មាន មុខជំនាញ សរុប ៣២ ជំនាញ ៕ មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល រលឹក ឱសថការី ត្រូវ គោរព តាម និយាម វិជ្ជាជីវៈ ឱសថការី ដើម្បី កុំ ឲ្យ ប្រឈម ការដក អាជ្ញា បណ្ណ
( ភ្នំពេញ ) ៖ លោក ឱសថការី បាន បុត្តា អនុ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន ក្រុមប្រឹក្សា គណៈ ឱសថការី ជាតិ អាណត្តិ ទី២ នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ចូលរួម ជា អធិបតីភាព ក្នុង ពិធី ផ្សព្វផ្សាយ ស្តីពី និយាម វិជ្ជាជីវៈ ឱសថការី ដល់ សមាជិក សមាជិកា គណៈ ឱសថការី រាជធានី ភ្នំពេញ ចំនួន ជិត ១ ពាន់ នាក់ បាន ចូលរួម ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឱសថការី បាន បុត្តា បាន លើកឡើង ថា គោលបំណង កម្មវិធី នៅ ថ្ងៃ នេះ គឺ ដើម្បី ផ្សព្វផ្សាយ ឱ្យ ឱសថការី នៅ រាជធានី ភ្នំពេញ យល់ដឹង ពី លិខិត បទដ្ឋាន គិត យុត្ត ក្នុង នាម ឱសថការី គួរ អនុវត្ត យ៉ាងដូចម្តេច ខ្លះ ដើម្បី លើកកម្ពស់ សុខ មាលភាព ប្រជាពលរដ្ឋ ។
លើស ពី នេះ លោក បាន បុត្តា បាន ជំរុញ ដល់ ឱសថការី ត្រូវ គោរព តាម និយាម វិជ្ជាជីវៈ ឱសថការី ឲ្យបាន ខ្ជាប់ខ្ជួន ដើម្បី កុំ ឲ្យ ប្រឈម ការដក អាជ្ញាបណ្ណ ។
ឱសថការី បាន អះអាង ថា ពេល បាន ចូលរួម ក្នុង កម្មវិធី ផ្សព្វផ្សាយ និយាម វិជ្ជាជីវៈ ឱសថការី គឺ ទទួលបាន ចំណេះដឹង ច្រើន ពី លិខិ បទដ្ឋាន គតិយុត្ត ផ្សេង ៗ ពាក់ព័ន្ធ នឹង ការផ្តល់ សេវា ឱសថសាស្រ្ត ។ លើស ពី នេះ ពួកគេ ប្តេជ្ញា ថា នឹង ចូលរួម អនុវត្ត និយាម វិជ្ជាជីវៈ ឱសថការី ឲ្យបាន ត្រឹមត្រូវ ។
សូម ជម្រាប ថា និយាម វិជ្ជាជីវៈ ឱសថការី បង្កើតឡើង ក្នុង គោលបំណង សំខាន់ ៗ ចំនួន ៤រួម មាន៖
* ទី១៖ ដើម្បី បង្ហាញ អំពី សេវា ឱសថសាស្រ្ត ប្រកបដោយ គុណភាព សុវត្ថិភាព ប្រសិទ្ធភាព និង ក្រមសីលធម៌ វិជ្ជាជីវៈ ជូន ដល់ សាធារណៈ ជន
* ទី២៖ សម្រាប់ ប្រើ ជា ឧបករណ៍ តាមដាន និង វាយតម្លៃ លើ ការអនុវត្ត ការប្រកបដោយ វីជ្ជាជីវៈ ឱសថសាស្រ្ត របស់ ឱសថការី ដែល ប្រកប វិជ្ជាជីវៈ ឱសថសាស្រ្ត នៅ កម្ពុជា
* ទី៣៖ គឺ ដើម្បី ផ្តល់ ជា ធាតុ ចូលក្នុង ការរៀបចំ កែសម្រួល កម្មវិធី បណ្តុះបណ្តាល មុនពេល ចូល បម្រើ ការងារ ក៍ ដូចជា ផ្តល់ ការណែនាំ ដល់ ឱសថការី ដែល ប្រកប វិជ្ជាជីវៈ ឱសថសាស្រ្ត និង និស្សិត ឱសថសាស្រ្ត
* ទី៤៖ សម្រាប់ ប្រើប្រាស់ ជា មូលដ្ឋាន សម្រាប់ ការអភិវឌ្ឍ វិជ្ជាជីវៈ បន្ត និង បង្កើន គុណភាព នៃ ការផ្តល់ សេវា ឱសថសាស្រ្ត ។ និយាម វិជ្ជាជីវៈ ឱសថការី ត្រូវបាន ក្រសួង សុខាភិបាល ដាក់ ឱ្យ អនុវត្ត តាំងពី ឆ្នាំ ២០២៣មក ៕
តំណាង កម្ពុជា នឹង ចូលរួម កិច្ចប្រជុំ ពិនិត្យ របាយការណ៍ ជាតិ លើក ដំបូង ស្តីពី ការអនុវត្ត អនុសញ្ញា អន្តរជាតិ ពី ការការពារ ជន គ្រប់ រូប ពី ការបាត់ ខ្លួន ដោយ បង្ខំ នៅ ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស
( ភ្នំពេញ )៖ គណៈប្រតិភូ តំណាង រាជ រដ្ឋាភិបាល កម្ពុជា នឹង ទៅ ចូលរួម ការពិនិត្យ របាយការណ៍ ជាតិ លើក ដំបូង នៃ ការអនុវត្ត អនុសញ្ញា អន្តរជាតិ ស្តីពី ការការពារ ជន គ្រប់ រូប ពី ការបាត់ ខ្លួន ដោយ បង្ខំ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ១៩ - ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ ទីក្រុង ហ្សឺណែវ ប្រទេស ស្វីស ។
កម្ពុជា មាន ឆន្ទៈ យ៉ាង មុតមាំ ក្នុង ការលើកកម្ពស់ និង ការការពារ សិទ្ធិ មនុស្ស តាមរយៈ ការផ្តល់ សច្ចាប័ន និង ការចូល ជា សមាជិក កតិកាសញ្ញា និង អនុសញ្ញា សិទ្ធិ មនុស្ស អន្តរជាតិ ចំនួន ៨ ក្នុង ចំណោម សន្ធិសញ្ញ សិទ្ធិ មនុស្ស អន្តរជាតិ សំខាន់ ៗ ចំនួន ៩ ដែល ក្នុង នោះ កម្ពុជា គឺជា ប្រទេស តែ មួយ គត់ នៅ តំបន់ អាស៊ី អាគ្នេយ៍ ដែល បាន ផ្តល់ សច្ចាប័ន និង ចូល ជា សមាជិក នៃ អនុសញ្ញា អន្តរជាតិ ស្ដីពី ការការពារ ជន គ្រប់ រូប ពី ការបាត់ ខ្លួន ដោយ បង្ខំ នៅ ថ្ងៃទី ២៧ ខែមិថុនា ឆ្នាំ ២០១៣ ។
សូម បញ្ជាក់ ថា ក្នុង នាម ជា រដ្ឋ ភាគី នៃ អនុសញ្ញា អន្តរជាតិ ស្តីពី ការការពារ ជន គ្រប់ រូប ពី ការបាត់ ខ្លួន ដោយ បង្ខំ កម្ពុជា មាន កាតព្វកិច្ច សរសេរ បាយការណ៍ ដាក់ ជូន គណៈកម្មាធិការ ស្តីពី ការបាត់ ខ្លួន ដោយ បង្ខំ និង ត្រូវ បញ្ជូន គណៈប្រតិភូ ទៅ ចូលរួម ការពិនិត្យ របាយការណ៍ នៅ ចំពោះ មុខ គណៈកម្មាធិការ នេះ ក្នុង ទម្រង់ ជា កិច្ចសន្ទនា បែប ស្ថាបនា ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ នា
ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ ចង្អៀត ជំនាញ ស្រាវជ្រាវ និង បង្រ្កាប បទល្មើស ។
កិច្ចប្រជុំ នេះ មាន សមាសភាព ចូលរួម មាន លោក មេបញ្ជាការ រង ទទួល ជំនាញ នាយ សេនាធិការ ប្រធាន - អនុប្រធាន មន្ទីរ ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស នាយ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន នាយ ការិយាល័យ ព្រហ្មទណ្ឌ និង នាយ ការិយាល័យ ប្រឆាំង ការជួញដូរ មនុស្ស ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្នុង គោលបំណង សំដៅ បង្កើន ការ រក្សា សន្តិសុខ ជូន ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន ឱ្យ មាន សុវត្តិភាព ខ្ពស់ បំផុត និង ជំរុញ ការផ្សព្វផ្សាយ លេខ ទូរស័ព្ទ បន្ទាន់ ១២៩១ ដែល មាន អាវុធហត្ថ រាជធានី ភ្នំពេញ រងចាំ ទទួល និង ចេញ អន្តរាគមន៍ ២៤ / ២៤ ម៉ោង ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន លើកឡើង ថា កិច្ចការ ចំពោះមុខ ដែល ជំនាញ ត្រូវ យកចិត្តទុកដាក់ បំផុត គឺ ការបង្រ្កាប បទល្មើស គ្រឿងញៀន ជា អាទិភាព ចោរ លួច ចោរ ឆក់ ក៏ ដូចជា បទល្មើស ផ្សេង ៗ ទៀត ដែល បង្ក ចលាចល ដល់ សង្គម ។
លោក បន្ថែម ទៀត ថា ដើម្បី បង្កើន ប្រសិទ្ធិភាព ក្នុង ការបង្ក្រាប បទល្មើស ទាំងនេះ បាន ទាន់ ពេលវេលា កម្លាំង ជំនាញ ទាំងអស់ ត្រូវ ជម្រុញ ការស្វែងរក និង ទទួល ព័ត៌មាន ឱ្យ បាន ឆាប់ រហ័ស តាមរយៈ ការទំនាក់ទំនង ជិតស្និទ្ធ ជាមួយ ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន ជាពិសេស ជំរុញ ការផ្សព្វផ្សាយ លេខ ទូរស័ព្ទ អន្តរាគមន៍ បន្ទាន់ ២៤ / ២៤ ម៉ោង គឺ លេខ ១២៩១ ដល់ ប្រជាពលរដ្ឋ បាន ជ្រួតជ្រាប ឱ្យ កាន់តែ ច្រើន បំផុត ៕ អ្នកជំនាញ អារ្យធម៌ ខ្មែរ៖ ការបោះឆ្នោត ព្រឹទ្ធសភា នៅ កម្ពុជា ជា ក្បួន ច្បាប់ ប្រជាធិបតេយ្យ ចាស់ទុំ លើ ពិភពលោក
ពីព្រោះថា សមាជិក ព្រឹទ្ធសភា ដែល ប្រសូត្រ ពី អង្គ បោះឆ្នោត អសកល តំណាង ឲ្យ ភូមិភាគ នីមួយ ៗ នៃ ប្រទេស កម្ពុជា គឺជា តំណាង ប្រជាជាតិ ខ្មែរ ទាំងមូល មិន ខុសពី សមាជិក ព្រឹទ្ធសភា របស់ សហរដ្ឋ អាមេរិក . កាណាដា . អូស្រ្ដាលី. អ៊ីតាលី សហគមន៍ អឺរ៉ុប ឬ បណ្ដា ប្រទេស ប្រជាធិបតេយ្យ ជឿនលឿ នានា លើ ពិភពលោក នោះ ទេ ។
ដូចនេះ ចំពោះ ព្រឹទ្ធសភា ដែល ជា ស្ថាប័ន កំពូល របស់ បណ្ដា ប្រទេស ប្រជាធិបតេយ្យ ជឿនលឿន នានា លើ ពិភពលោក គឺជា ប្រពៃណី អ្នក ចាស់ទុំ នយោបាយ ដើម្បី សេចក្ដីថ្លៃថ្នូរ របស់ ជាតិ ដែល មាន តាំងពី បឋម កាល រៀង មក ។ ដូច្នេះ ការបោះឆ្នោត ព្រឹទ្ធសភា នៅ កម្ពុជា ជា ក្បួន ច្បាប់ ប្រជាធិបតេយ្យ ចាស់ទុំ លើ ពិភពលោក ៕
នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ អញ្ជើញ សម្ពោធ ពុទ្ធាភិសេក ឆ្លង កុដិ នៅ វត្ត ស្វាយ រមៀត ក្រុង សៀមរាប
( សៀមរាប ) ៖ នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ អគ្គ ស្នងការ រង នគរបាល ជាតិ ទទួល ដឹកនាំ ការងារ ព្រំដែន រួម ទទួល ទិស ភូមិភាគ ទី៣ ភូមិភាគ ទី៤ និង ភូមិភាគ ទី៥ និង លោកស្រី នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជា អធិបតី សម្ពោធ ពុទ្ធាភិសេក ឆ្លង កុដិ និង ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ វត្ត បារាយណ៍ មហាន ទី រតនា រាម ហៅ វត្ត ស្វាយ រមៀត ស្ថិត ក្នុង ភូមិ បន្ទាយ ឈើ សង្កាត់ ទឹក មើល ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
ពិធី នេះ មាន ការនិមន្ត របស់ ព្រះធម្មសិរី ជុំ គឹម ឡេង ព្រះសុមង្គល សិលាចារ្យ មេ គណ ខេត្ត និង និមន្ត ចូលរួម ពី ព្រះអនុគណក្រុង ចៅអធិការ វត្ត ថ្នាក់ដឹកនាំ មន្ទីរ ស្នងការ នគរបាល ខេត្ត អាជ្ញាធរ មូលដ្ឋាន សប្បុរសជន អាចារ្យ គណៈកម្មការ វត្ត សីល វ័ន្ត សីល វន្តី លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ ជាច្រើន ចូលរួម ផងដែ ។
នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល ក្នុង នីតិកាល ទី៧ ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី បាន កំពុង បន្ត ស្មារតី បង្រួបបង្រួម ជាតិ របស់ ថ្នាក់ដឹកនាំ ជា ឥស្សរជន កំពូល ៗ ដើមី្ប ធានា បាន នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ប្រទេសជាតិ និង បាន ធានា ក្រោម ស្មារតី នៃ រដ្ឋធម្មនុញ្ញ កម្ពុជា បន្ត ស្នាដៃ ពី ឥស្សរជន ជំនាន់ មុន និង ប្រែក្លាយ ប្រទេសជាតិ ពី ការយក ជីវិត ជាដើមទុន មក ជា នីតិរដ្ឋ គោរព សិទ្ធ មនុស្ស លទ្ធិ ប្រជាធិបតេយ្យ និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ បាន បន្ត ថា ការកសាង កុដិ ជា នាយ ឧត្តមសេនា សន ទាន ប្រគេន ព្រះសង្ឃ តម្កល់ ទុក ប្រើប្រាស់ ជា សម្បត្តិ គរុភ័ណ្ឌ ប្រកបដោយ រចនាបទ វប្បធម៌ ទំនៀមទម្លាប់ ព្រះពុទ្ធ សាសនា ខ្មែរ ។
នាយ ឧត្តមសេនីយ៍ ក៏ បាន លើក ពី ភាពវិនាសកម្ម ក្នុង របប បន ប្រល័យ ពូជសាសន៍ ប៉ុល ពត បាន យក ទី វត្តអារាម ធ្វើជា មន្ទីរឃុំឃាំង ជង្រុក ស្រូវ ក្រោល ចិញ្ចឹម សត្វ ឃ្លាំង ដាក់ ជី ធម្មជាតិ ព្រមទាំង បង្ខំ ព្រះសង្ឃ ឱ្យ លា ចាក សិក្ខាបទ ធ្វើជា ទាសករ ដាច់ ថ្លៃ និង ធ្វើ គត់ ផងដែរ ។ ក្រោយ ថ្ងៃ ជ័យជម្នះ ៧មក រា ១៩៧៩ វិស័យ សាសនា បាន រស់រាន ឡើងវិញ នៅក្នុង ដំណាក់កាល ប្រទេស មាន សុខ សន្តិភាព ស្ថេរភាព ពេញលេញ ហើយ បាន កំពុង កសាង និង អភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
នាយ ឧត្តមសេនីយ៍ ខេង សុមេធ បាន បន្ថែម ថា គោល នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី និង ជា ស្ថាបនិក សន្តិភាព របស់ កម្ពុជា បាន នាំមក នូវ សុខ សន្តិភាព ស្ថិរភាព សង្គម ឯកភាព ជាតិ ពេញលេញ ក្នុង រយៈពេល ជាង ២ទសវត្ស ចុងក្រោយ នេះ ពិតជា គុណ តម្លៃ ជា ប្រវត្តិសាស្រ្ត ដែល ប្រជាជន កម្ពុជា ទាំងមូល ត្រូវបាន រួបរួម សាមគ្គី ជា កម្លាំង ថែរក្សា ការពារ ជាតិ ឱ្យ បាន គង់ វង់ ជា អត មៈ ។
នាយ ឧត្តមសេនីយ៍ ក៏ បាន ផ្តាំផ្ញើ ដល់ ព្រះសង្ឃ គណៈកម្មការ វត្ត ប្រជាពុទ្ធ បរិស័ទ និង លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង កម្លាំង សមត្ថកិច្ច មូលដ្ឋាន ចូលរួម ក្នុង ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន នៅក្នុង មូលដ្ឋាន ខ្លួន និង ត្រូវ គោរព ច្បាប់ ចរាចរណ៍ ក្នុង ពេល បើកបរ ព្រមទាំង រួមគ្នា ថែរក្សា នូវ សមទ្ធិផល ថ្មី ក្នុង វត្ត ស្វាយ រមៀត ឱ្យ បាន គង់វង្ស ផងដែរ ។
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល បាន ថ្លែង ថា សមិទ្ធផល ថ្មី ៗ ដែល បាន កើតឡើង ក្នុង ព្រះពុទ្ធ សាសនា បាន បង្ហាញ ឱ្យ ឃើញ ពី ការរីកចម្រើន ក្នុង វិស័យ ពុទ្ធ ចក្រ ដែល កើតឡើង ពី មូលដ្ឋានគ្រឹះ ដ៏ សំខាន់ គឺ ប្រទេសជាតិ មាន សុខ សន្តិភាព មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ទាំង ពុទ្ធ ចក្រ និង អាណាចក្រ ។ ពិសេស ទាំងនេះ បាន មក ដោយសារ កម្ពុជា មាន មេដឹកនាំ ពេញ ដោយ សមត្ថភាព និង គុណធម៌ ។
លោក អភិបាល ខេត្ត ថ្លែង បែប នេះ នៅក្នុង ពិធី សម្ពោធ សមិទ្ធផល និង ស្រោចស្រព សុគន្ធ វារី ព្រះចៅ អធិការ វត្ត ប្រាសាទ រង្សី នៅ ភូមិ កំពង់ប្រាសាទ ឃុំ ស្វាយ រំពារ ស្រុក មុខ កំពូល កាលពី ថ្ងៃទី ១៧ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
ជាមួយគ្នា នេះ ដែរ លោក យី យ៉េន អភិបាល ស្រុក មុខ កំពូល បាន បញ្ជាក់ ថា សមិទ្ធផល ដែល ដាក់ សម្ពោធ នា ពេលនេះ រួម មាន៖ សាលា ធម្មសភា ខ្លោងទ្វារ កុដិ ១ខ្នង កម្ពស់ ២ជាន់ មាន ៤បន្ទប់ និង កុដិ ជួស ជួល ថ្មី ១ខ្នង កម្ពស់ ២ជាន់ មាន ៣បន្ទប់ ។ លោក អភិបាល ស្រុក បាន បញ្ជាក់ បន្ថែម ថា ទូទាំង ស្រុក មុខ កំពូល មាន វត្ត ចំនួន ២៤វត្ត សាលា ពុទ្ធិកៈ បឋមសិក្សា ចំនួន ១២កន្លែង សាលា វិបស្សនា ចំនួន ៣កន្លែង ព្រះសង្ឃ មាន ចំនួន ៤១២ អង្គ ។ ស្រុក ក៏ មាន វិហារ ឥស្លាម ចំនួន ៣កន្លែង និង វិហារ សាសនា គ្រឹស្ត ចំនួន ២កន្លែង ផងដែរ ៕
( ភ្នំពេញ ) ៖ បន្ទាប់ពី មាន ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ កាលពី ចុង ឆ្នាំ ២០១៩ បាន ធ្វើឱ្យ សកម្មភាព លក់ដូរ នៅ តាម បណ្តា ផ្សារ នីមួយ ៗ មាន ការធ្លាក់ចុះ យ៉ាង គំហុក ។ រហូតមកដល់ ដល់ ពេលនេះ បើ ទោះបីជា ការរាត ត្បាត ជំងឺ កូវីដ១៩ បាន ធូរស្រាល ហើយ សេដ្ឋកិច្ច ចាប់ផ្តើម បង្ហាញ និន្នាការកើនឡើង ក្តី ប៉ុន្តែ អាជីវករ មួយចំនួន នៅតែ មាន ការត្អូញត្អែរ ទាក់ទង នឹង ការលក់ដូរ របស់ ខ្លួន ដែល មិន ទាន់ បាន វិល ទៅ រក ភាព ប្រក្រតី វិញ ។
លោក លី សូដេត សេដ្ឋកិច្ច វិទូ ជាន់ ខ្ពស់ នៃ ធនាគារ ពិភពលោក (World Bank) ប្រចាំ កម្ពុជា បាន លើកឡើង ថា បន្ទាប់ពី មាន ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ហេដ្ឋារចនាសម្ព័ន្ធ សេដ្ឋកិច្ច ពិភពលោក មាន ការប្រែប្រួល ដែល បណ្តាលឱ្យ សកម្មភាព លក់ មិន ដូច មុន ទៀត ឡើយ ។
លោក បាន ព្យល់ យ៉ាង ដូច្នេះ ថា បើ ទោះបីជា សកម្មភាព វិល ទៅ ដូច មុន ការរីករាលដាល ជំងឺ កូវីដ១៩ ក៏ ការលក់ដូរ ក្នុង ទីផ្សារ មិន អាច វិល ទៅរក ស្ថានភាពមុន និង មិន ទទួលបាន ចំណូល ដូច មុន ដែរ ដោយសារតែ កម្មភាព សេដ្ឋកិច្ច បាន ប្រែប្រួល ។ ប្រសិនបើ អាជីវករ ចង់ឱ្យ ធ្វើឱ្យ សកម្មភាព លក់ដូរ របស់ ខ្លួន រីកចម្រើន ដូច មុន ទាល់តែ ប្តូរ វិធីសាស្រ្ត នៃ ការលក់ ដូចជា ការលក់ តាម អនឡាញ ជាដើម ។ ហើយ ទន្ទឹម គ្នា នេះ អាជីវកម្ម លក់ដូរ ល្អ បាន ដូច មុន បាន លុះត្រាតែ លុយ ចរាចរណ ក្នុង សេដ្ឋកិច្ច ។
លោក បាន ពន្យល់ បន្ត ថា « ផ្សារ ឥលូវនេះ មិន មែន ដូច កាល មុនពេល មាន ការរាត ត្បាត ជំងឺ កូវីដ នោះ ទេ បើ ទោះបីជា សេដ្ឋកិច្ច កើន ឡើងវិញ ក៏ដោយ ប៉ុន្តែ ការលក់ដូរ នឹង មិន អាច វិល ទៅ ដូច មុន វិញ បាន ទេ ដោយសារតែ មាន ការបែកខ្ញែក ច្រើន ។ ការបែកខ្ញែក នេះ ដោយ អ្នក ខ្លះ ប្តូរ ពី ការអង្គុយ លក់ ក្នុង ផ្សារ មក ដើរ លក់ នៅ តាម ផ្ទះ ហើយ អ្នក ខ្លះ ចាប់ផ្តើម បង្កើន ការលក់ តាម អនឡាញ » ។
( សៀមរាប ) ៖ ក្រសួង បរិស្ថាន កំពុង គិតគូ ស្រប តាម យុទ្ធសាស្រ្ត ចក្រា វិស័យ បរិស្ថាន ជួយ ឱ្យ ប្រជា សហគមន៍ ទាំងអស់ មាន បានជាមុន សិន ទើប ជួយ ឱ្យ ពួកគាត់ លែង ចូល ព្រៃ ប៉ះពាល់ ជាមួយ ធនធាន ធម្មជាតិ ដោយ ខុស ច្បាប់ ។ នេះ ជា ការលើកឡើ របស់ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន នៅក្នុង ការអញ្ចើញ ពិនិត្យ លើ សក្តានុពល ទេសចរណ៍ ធម្មជាតិ និង វប្បធ៌ម ដើម្បី អភិវឌ្ឍន៍ គោលដៅ កម្សាន្ត បៃតង នៅក្នុង ឧទ្យាន ជាតិ ព្រះជ័យ វរ្ម័ន - នរោត្តម « ភ្នំ គូលែន » នា ថ្ងៃទី ១៧ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
ក្នុង ឱកាស អញ្ជើញ ពិនិត្យ ទីតាំង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ នៅ ជំរុំ តង់ អូរ ជប់ ថ្មល់ នៃ សហគមន៍ តំបន់ ការពារ ធម្មជាតិ ព្រៃ ធំ អន្លង់ ធំ . លោក រដ្ឋមន្ត្រី បាន ថ្លែង ថា ការអភិវឌ្ឍន៍ នានា បន្ថែម នៅ ទីនេះ ដើម្បី បម្រើ ឱ្យ វិស័យ ទេសចរណ៍ បៃតង់ និង ផ្តល់ ជុំ រើស ការងារ ល្អ ប្រសើរ មួយ ទៀត ដើម្បី ជំរុញ ជីវភាព ប្រចាំ ថ្ងៃ របស់ ប្រជា សហគមន៍ តាមរយៈ ការផ្តល់ សេវាកម្ម ផ្សេង ដល់ ភ្ញៀវ ទេសចរ និង បោះបង់ ការងារ ខុស ច្បាប់ ទាំងឡាយ លើ ធនធាន ធម្មជាតិ ។
លោក រដ្ឋមន្រ្តី បាន បន្ថែម ថា ការជួយ ជំរុញ ជីវភាព សហគមន៍ ឱ្យ មាន រីកចម្រើន គឺ ស្រប តាម គោលការណ៍ រួម ស្តីពី ការគ្រប់គ្រង និង អភិវឌ្ឍ ក្នុង តំបន់ ការពារ ធម្មជាតិ ដែល បាន បាន បំបែក ចេញ ពី យុទ្ធសាស្រ្ត ចក្រា វិស័យ បរិស្ថាន ឆ្នាំ ២០២៣ - ២០២៨ ។
លើស ពី នេះ ក្រសួង បរិស្ថាន ជួយ ដល់ សហគមន៍ នៅលើ ភ្នំ គូលែន លើកស្ទួយ និង បង្ហាញ ពី ជាតិនិយម របស់ ខ្មែរ តាមរយៈ រៀបចំ ហេដ្ឋារចនាសម្ព័ន្ធ បៃតង មិន ចម្លង វប្បធម៌ ដទៃ តែ ផ្តួចផ្តើម និង បង្កើត នូវ គំនិត ថ្មី ៗ ដែល មាន លក្ខណៈ ជា ខ្មែរ ដែល ជំរុញ ឱ្យ មាន ការទាក់ទាញ ទេសចរ ក្រៅ ប្រទេស ឱ្យ មក កម្សាន្ត និង ទស្សនា តំបន់ ការពារ ធម្មជាតិ ដ៏ ល្អ របស់ កម្ពុជា ផងដែរ ។
លោក រដ្ឋមន្ត្រី អ៊ាង សុផល្លែត បាន ផ្តាំផ្ញើ ឱ្យ យកចិត្ត ទៅ ដាក់ លើ ការពារ ព្រៃ ធម្មជាតិ ដែល ជា ចលករ យ៉ាង សំខាន់ សម្រាប់ បង្កើន ចំណូល ជីវភាព តាមរយៈ ការទាក់ទាញ ភ្ញៀវ ទេសចរ និង ជាពិសេស សម្រាប់ ជួយ កម្ពុជា សម្រេច ទស្សនវិស័យ អព្យាក្រឹត កាបូន នៅ ឆ្នាំ ២០៥០ ។
បន្ថែម លើ នេះ លោក រដ្ឋមន្ត្រី ក៏ បាន លើកទឹកចិត្ត ឱ្យ ប្រជា សហគមន៍ ដាំ ដើមឈើ និង ចូលរួម ថែរក្សា អនាម័យ បរិស្ថាន នៅ តាម គោលដៅ ទេសចរណ៍ ធម្មជាតិ នានា ស្រប តាម ចលនា « ថ្ងៃ នេះ ខ្ញុំ មិន ប្រើ ថង់ ប្លាស្ទិច ទេ » ដែល បាន កំពុង ទទួលបាន ការចូលរួម ពី មនុស្ស ជិត ៥លាន នាក់ ៕
នាវា ទេសចរណ៍ ខ្នាត ធំ ១គ្រឿង ដឹក ភ្ញៀវ ទេសចរ ចម្រុះ ជាតិ សាសន៍ ៧៥៦ នាក់ ចូល ចតនៅ ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ នាវា ទេសចរណ៍ ខ្នាត ធំ១ គ្រឿង បាន ចូល ចត នៅ កំពង់ផែ ស្វយ័ត ក្រុង ព្រះសីហនុ នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ផ្ទុក ភ្ញៀវ ទេសចរ ចម្រុះ ជាតិ សាសន៍ និង នាវិក ចំនួន ៧៥៦ នាក់ មក លេង កម្សាន្ត ប្រទេស កម្ពុជា រយៈពេល ១ ថ្ងៃ ។
របាយការណ៍ បាន ឱ្យដឹង ថា បន្ទាប់ពី បាន ចូល ចត ក្រុមការងារ រួមទាំង អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ផ្នែក បាន ទទួល បដិសណ្ឋារកិច្ច ទទួល ភ្ញៀវ ទេសចរ និង រៀបចំ រក្សា សន្តិសុខ សុវត្ថិភាព ជូន ភ្ញៀវ គ្រប់ កន្លែង ដែល ភ្ញៀវ ទេសចរ ទៅ ទស្សនា យ៉ាង យកចិត្តទុកដាក់ បំផុត ។
សូម ជម្រាប ថា នាវា ទេសចរណ៍ ខ្នាត ធំ ១គ្រឿង នេះ បាន ចេញ ពី ប្រទេស ថៃ មក ចូល ចតនៅ ខេត្ត ព្រះសីហនុ និង បន្ត ដំណើរ ទៅកាន់ ប្រទេស វៀតណាម ៕ រដ្ឋមន្ត្រី ក្រសួង សាធារណការ ចុះ ពិនិត្យ ទីតាំង រៀបចំ ពិធី បើក ការដ្ឋាន សាងសង់ ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) នៅ ព្រឹក ស្អែក ក្រោម អធិបតីភាព សម្តេច ធិបតី ហ៊ុន ម៉ាណែត
( ភ្នំពេញ ) ៖ លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ដឹកនាំ គណៈប្រតិភូ ក្រសួង ចុះ ពិនិត្យ ទីតាំង ត្រៀម រៀបចំ ប្រារព្ធ ពិធី បើក ការដ្ឋាន គម្រោង សាងសង់ ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ ( ចាក់អង្រែ ក្រោម - ព្រែក ប្រា) និង ផ្លូវ តភ្ជាប់ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល នឹង ប្រព្រឹត្តទៅ នា ព្រឹក ស្អែក ថ្ងៃចន្ទ ទី១៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
នៅក្នុង ការចុះ ត្រួតពិនិត្យ នា ព្រឹក នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក សន្តិ បណ្ឌិត យូ ស៊ុន ឡុង រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ផ្សេង ទៀត ផងដែរ ។
គម្រោង សាងសង់ ស្ពាន ឆ្លងកាត់ ទន្លេបាសាក់ តភ្ជាប់ ពី សង្កាត់ ចាក់អង្រែ ក្រោម នៃ ខណ្ឌ មានជ័យ ទៅកាន់ សង្កាត់ ព្រែក ប្រា នៃ ខណ្ឌ ច្បារអំពៅ មាន ប្រវែង ៨៤៥ .៧០ ម៉ែត្រ ព្រមទាំង ផ្លូវ តភ្ជាប់ ប្រវែង សរុប ៨០៤.៣០ ម៉ែត្រ នេះ នឹង ក្លាយជា ស្ពាន ឆ្លងកាត់ ទន្លេ ទី៧ ដែល ស្ថិត ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ។
គួរ រម្លឹក ដែរ ថា ស្ពាន ឆ្លងកាត់ ទន្លេ ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ដែល កំពុង បើក ឱ្យ ដំណើរការ នា ពេល បច្ចុប្បន្ន រួម មាន ដូច ជា៖ ស្ពាន មិត្តភាព កម្ពុជា - ជប៉ុន ជ្រោយ ចង្វារ . ស្ពាន មិត្តភាព កម្ពុជា - ចិន ជ្រោយ ចង្វារ . ស្ពាន ព្រះមុនីវង្ស ច្បារអំពៅ ( ទី១) . ស្ពាន ព្រះមុនីវង្ស ច្បារអំពៅ ( ទី២) . ស្ពាន បេតុង ខ្សែ កាប ឆ្លង ទន្លេ សាប ប្ញស្សីកែវ និង ស្ពាន បេតុង ខ្សែ កាប តភ្ជាប់ តំបន់ អភិវឌ្ឍន៍ កោះន រា និង តំបន់ អភិវឌ្ឍន៍ កោះ ពេជ្រ ៕
នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត ហ៊ីង ប៊ុន ហៀង និង លោកជំទាវ ប៉ែន ចន្នី ដង្ហែ អង្គ ផ្កា ប្រាក់ វេរ ប្រមូល បច្ច័យ ១០០ លាន រៀល ប្រគេន ព្រះសង្ឃ វត្ត តុំ ក្រុង ដូន កែវ ខេត្ត តាកែវ
( តាកែវ )៖ ដើម្បី ចូលរួម លើកកម្ពស់ លើកម្ពស់ វិស័យ ព្រះពុទ្ធ សាសនា ឱ្យ កាន់តែ មាន ការរីកចម្រើន នា ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត ហ៊ីង ប៊ុន ហៀង នាយក រង ខុទ្ទកាល័យ សម្តេច ធិបតី ហ៊ុន ម៉ាណេត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង លោកជំទាវ ប៉ែន ចន្នី រួម ជាមួយ នាយ ទាហាន និង ពល ទាហាន បញ្ជាការដ្ឋាន អង្គរក្ស បាន ដង្ហែ អង្គ ផ្កា ប្រាក់ មក វេរ ប្រគេន ព្រះសង្ឃ វត្ត តុំ ស្ថិត នៅក្នុង ក្រុង ដូន កែវ ខេត្ត តាកែវ ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត និង លោកជំទាវ បាន វេរ ប្រគេន គ្រឿង ឧបភោគ - បរិភោគ ជាច្រើន មុខ និង បច្ច័យ អង្គ ផ្កា ប្រាក់ ចំនួន ១០០ លាន រៀល ជូន ដល់ ព្រះសង្ឃ វត្ត តុំ ដើម្បី រួមចំណែក កសាង សមិទ្ធផល នានា នៅក្នុង ទី អារាម នេះ ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ។
នាយ ឧត្តមសេនីយ៍ កិត្តិសង្គហ បណ្ឌិត ហ៊ីង ប៊ុន ហៀង ក៏ បាន គូសបញ្ជាក់ បន្ថែម ថា រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា នឹង បន្ត ជំរុញ អនុវត្ត កម្មវិធី កែទម្រង់ នានា សំដៅ លើកកម្ពស់ ជីវភាព ប្រជាពលរដ្ឋ ការការពារ សុខ សន្តិភាព . បូរណភាព ទឹកដី . ព្រះមហាក្សត្រ . ប្រជាជន និង រាជ រដ្ឋាភិបាល កម្ពុជា ដែល កើត ចេញ ពី ឆន្ទៈ ពិតប្រាកដ របស់ ប្រជាជន កម្ពុជា ៕
លោកស្រី ឃួន ឃុន ឌី បន្ត បើក យុទ្ធនាការ ឃោសនា បោះឆ្នោត ព្រឹទ្ធសភា នីតិកាល ទី៥ នៅ ស្រុក ស្ទោង ខេត្ត កំពង់ធំ
( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី បេក្ខជន ពេញ សិទ្ធ ជ្រើសរើស សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ ឆ្នាំ ២០២៤ នៅ ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន បន្ត អញ្ជើញ បើក យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ នៅ ស្រុក ស្ទោង ខេត្ត កំពង់ធំ ។
នា ឱកាស នោះ ដែរ លោកស្រី ឃួន ឃុន ឌី បាន ថ្លែង ទៅកាន់ អង្គ បោះឆ្នោត ទាំងអស់ គឺ មិន ត្រូវ ទទួលបាន ការគំរាមកំហែង ពី គណបក្ស នយោបាយ ណាមួយ ឡើយ ។
លោកស្រី ឃួន ឃុន ឌី បាន លើកឡើង ថា ការបោះឆ្នោត នេះ មាន សារៈសំខាន់ សូម ឱ្យ អង្គ បោះឆ្នោត ទាំងអស់ មាន ការប្រុងប្រយ័ត្ន ឱ្យ បាន ខ្ពស់ កុំ ឱ្យ មាន កំហុស និង បាន ជំរុញ ឱ្យ ប្រធាន គណបក្ស ស្រុក ត្រូវតែ ត្រួតពិនិត្យ ពិសេស នោះ គឺ នៅ ថ្ងៃទី ២៤ មុន មួយ ថ្ងៃ ឱ្យ បាន ច្បាស់លាស់ ថា តើ ក្រុមប្រឹក្សា ឃុំ ជា អង្គ បោះឆ្នោត មាន ឯកសារ គ្រប់គ្រាន់ ហើយ ឬ នៅ ? ប្រសិនបើ មាន ការខ្វះចន្លោះ នឹង ចាត់ វិធានការ ដោះស្រាយ ជាបន្ទាន់ សំដៅ ធានា បាន ប្រសិទ្ធភាព ការងារ ។
លោកស្រី បាន បន្ត ថា គុណ បំណាច់ ដ៏ ធំធេង របស់ សម្ដេច តេជោ ហ៊ុន សែន អគ្គ មគ្គុទេសន៍ ឯក បិតា សន្តិភាព ដែល បាន ខិតខំ កសាង ប្រទេសជាតិ ពី បាត ដៃ ទទេ ឱ្យ មាន ការរីកចម្រើន ដូច ឃើញ សព្វ ថ្ងៃ ប្រជាពលរដ្ឋ មាន ជីវភាព កាន់តែ ប្រសើរឡើង ពិសេស ដឹកនាំ ដោយ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន នឹង កំពុង កាន់តែ ខិតខំ ប្រឹងប្រែង ដឹកនាំ កសាង ប្រទេសជាតិ ឱ្យ កាន់តែ មាន ការអភិវឌ្ឍ ។
លោកស្រី ឃួន ឃុន ឌី សំណូមពរ ឱ្យ អង្គ បោះឆ្នោត ទាំងអស់ ត្រូវ ត្រៀមខ្លួន ឯកសារ អត្តសញ្ញាណប័ណ្ណ ការថែទាំ សុខភាព សុវត្ថិភាព ឱ្យ បាន ល្អ ដើម្បី រួម បោះឆ្នោត នៅ ថ្ងៃទី ២៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខាងមុខ នេះ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ១០០ % ដែល មាន លេខរៀង ទី១ រូប សញ្ញា ទេវតា បាច ផ្កា ជា សម្គាល់ ៕
យុទ្ធនាការ រឹតបន្តឹង ច្បាប់ ចរាចរណ៍ នៅ ខេត្ត ព្រះសីហនុ ! យានយន្ត ៤៤៣ គ្រឿង ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា យប់ ថ្ងៃទី ១៧ ខែកុម្ភៈ
( ព្រះសីហនុ) ៖ រដ្ឋបាល ខេត្ត ព្រះសីហនុ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត ព្រះសីហនុ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ ថា លទ្ធផល នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ និង ត្រួតពិនិត្យ ជាតិ អាល់កុល អាវុធ ជាតិ ផ្ទុះ ចំនួន ៤ គោលដៅ នា យប់ ថ្ងៃទី ១៧ ខែកុម្ភៈ នៅ តាម ភូមិសាស្ត្រ ក្នុង ក្រុង ស្រុក ទាំង៥ នៃ ខេត្ត ព្រះសីហនុ សមត្ថកិច្ច បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត ចំនួន ៤៤៣ គ្រឿង ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង រាង រាល់ យប់ ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក គួច ចំរើន ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត ព្រះសីហនុ និង លោក ឧត្តមសេនីយ៍ ឯក ស រដ្ឋា អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ និង តប តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា សំដៅ ទប់ស្កាត់ និង បង្ការ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ដែល ជា សញ្ញាណ គួរឱ្យ ព្រួយបារម្ភ ។
ជា លទ្ធផល ក្នុង ការចុះ ត្រួតពិនិត្យ អាវុធ ជាតិ ផ្ទុះ ចំនួន ៤ គោលដៅ នៅ តាម ភូមិសាស្ត្រ ក្នុង ក្រុង ស្រុក ទាំង៥ នៃ ខេត្ត ព្រះសីហនុ ដោយ បាន ធ្វើ ការត្រួតពិនិត្យ រថយន្ត តូច - ធំ ចំនួន ៤៤៣ គ្រឿង ម៉ូតូ និង Pass App ចំនួន ១០៣ គ្រឿង ទទួលបាន លទ្ធផល ដូច ខាងក្រោម៖
លទ្ធផល ចុះ ត្រួតពិនិត្យ អាវុធ ជាតិ ផ្ទុះ ចំនួន ៤ គោលដៅ នា យប់ ថ្ងៃទី ១៧ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ តាម ភូមិ សាស្ត្រ ក្នុង ក្រុង ស្រុក ទាំង៥ នៃ ខេត្ត ព្រះសីហនុ ដោយ បាន ធ្វេី ការត្រួតពិនិត្យ រថយន្ត តូច - ធំ ចំនួន ៤៤៣ គ្រឿង ម៉ូតូ និង Passapp ចំនួន ១០៣ គ្រឿង ទទួលបាន លទ្ធផល ដូច ខាងក្រោម៖
ពិធី នេះ បាន ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា និង ជា អនុប្រធាន ក្រុមការងារ ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ . លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ និង ជា អនុប្រធាន អចិន្ត្រៃយ៍ ក្រុមការងារ ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ និង លោក វេជ្ជ. អោ វណ្ណ ថេន អនុប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ស្ពឺ ។
មាន មតិ សំណេះសំណាល នា ឱកាស នោះ លោកស្រី ពុំ ចន្ទីនី បាន គូសបញ្ជាក់ ពី គោលបំណង សំខាន់ ចំនួន ៤ ក្នុង កម្មវិធី ថ្ងៃ នេះ គឺ៖ ១៖ អបអរ ទិវា ជាតិ សុខភាព មាតា ទារក និង កុមារ ២១កុម្ភៈ ដែល កត់សម្គាល់ នូវ ការបរិច្ឆេទ ដែល សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ទទួលគោរមងារ ទី២ ពី អង្គការ សហ ប្រជាជាតិ ជា ឥស្សរជន ឆ្នើម ថ្នាក់ ជាតិ នៃ ផែនការ សកម្មភាព រួម អគ្គ លេខាធិការ អង្គការ សហ ប្រជាជាតិ ដើម្បី សុខភាព ស្ត្រី និង កុមារ កាលពី ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០១១ ។
៤៖ បើក ឱកាស ឱ្យ យុវជន កាកបាទ ក្រហម កម្ពុជា បាន ចូលរួម ជីវភាព ក្នុង ការងារ សង្គម និង បន្ថែម គុណ តម្លៃ បំណិន ជីវិត ផ្សាភ្ជាប់ ការសិក្សា ជំនាញ ជាមួយនឹង ការចុះអនុវត្ត ជាក់ស្តែង ។
ជាមួយគ្នា នេះ ដើម្បី បន្ត ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ពង្រឹង ការលើកកម្ពស់ សុខភាព មាតា ទារក និង កុមារ . លោកស្រី អគ្គ លេខាធិការ បាន ពាំនាំ នូវ សារ អំពាវនាវ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ ជូន បងប្អូន ស្រ្តី ជា មាតា ទាំងអស់ ក្នុង ខ្លឹមសារ ដូច ជា៖
* សូម ឱ្យ ស្រ្តី មាន ផ្ទៃពោះ ទៅ ពិនិត្យ ផ្ទៃពោះ យ៉ាងតិច ៤ដង តាម ពេលវេលា កំណត់ ដើម្បី ទទួល វ៉ាក់សាំង បង្ការ គ្រប់ មុខ ជាពិសេស ស្ម័គ្រចិត្ត ធ្វើតេស្ត ឈាម រក មេរោគ អេដស៍ ស្វាយ និង រលាក ថ្លើម ប្រភេទ បេ ដើម្បី កុំ ឱ្យ មាន ការចម្លង មេរោគ ពី ម្តាយ ទៅ កូន ។ សូម ទៅ សម្រាល កូន នៅ មណ្ឌល សុខភាព ឬ មន្ទីរពេទ្យ ដែល មាន គ្រូពេទ្យ ជំនាញ ។
* សូម ទៅ ពិនិត្យ សុខភាព ក្រោយពេល សម្រាល ទាំង ម្តាយ ទាំង កូន យក កូន ទៅ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ ១១មុខ តាម ពេលវេលា កំណត់ ។ សូម បំបៅ កូន ដោយ ទឹកដោះ ម្តាយ តែ មួយ មុខ គត់ ចាប់ពី ពេល ទារក កើត ភ្លាម រហូតដល់ ទារក មាន អាយុ ៦ខែ និង ផ្តល់ អាហារ បបរ ខាប់ គ្រប់ គ្រឿង ដល់ កុមារ ។
ក្នុង ឱកាស បំពេញ ការងារ នោះ ដែរ ក្រុមការងារ បាន បែងចែក ជា ២ពីរ មុខ ព្រួញ ទៀត ដោយ លោកស្រី ពុំ ចន្ទីនី បាន ដឹកនាំ ក្រុមការងារ រួម ជាមួយ គ្រូពេទ្យ និង និស្សិត ពេទ្យ ចុះ សួរសុខទុក្ខ ស្ត្រី ទើប សម្រាល កូន តូច ចំនួន ៣គ្រួសារ នៅ តាម ផ្ទះ ដើម្បី ពិនិត្យ សុខភាព ផ្តល់ ថ្នាំ វីតាមីន និង អំណោយ មនុស្សធម៌ មួយចំនួន ។
ចំណែក លោកស្រី ម៉ែន នារី សោភ័គ និង ក្រុមការងារ បាន បន្ត ជួប ជាមួយ ស្ត្រី កូន តូច ជន ចាស់ជរា ចំនួន ៦៨ នាក់ ដើម្បី ធ្វើ ការអប់រំ ផ្សព្វផ្សាយ លើកកម្ពស់ ការយល់ដឹង ស្តីពី ការថែទាំ សុខភាព បឋម . បញ្ហា ប្រឈម របស់ ស្ត្រី ចំពោះ ជំងឺ មហារីក មាត់ ស្បូន និង ជំងឺ មហារីក សុដន់ . និង បញ្ហា ជំងឺ មិន ឆ្លង ៤ប្រភេទ ដូចជា ជំងឺ បេះដូង សរសៃ ឈាម ជំងឺ មហារីក ជំងឺ ទឹកនោម ផ្អែម និង ជំងឺ ផ្លូវ ដង្ហើម រ៉ាំរ៉ៃ ដែល ជំងឺ ទាំង នេះ បង្កឡើង ដោយ ការបរិភោគ ចំណីអាហារ និង ការប្រព្រឹត្ត របស់ មនុស្ស ម្នាក់ ៗ ។
កាលពី ថ្ងៃសៅរ៍ នាយក រដ្ឋមន្រ្តី ថៃ បច្ចុប្បន្ន គឺ លោក សេដ្ឋា ថា វីស៉ីន បាន ប្រកាស ជា ផ្លូវការ ថា លោក ថាក់ ស៉ីន នឹង ត្រូវ ដោះលែង នា ថ្ងៃអាទិត្យ នេះ ។ ចំណែក នៅ ព្រឹក ថ្ងៃអាទិត្យ នេះ លោក ថាក់ ស៉ីន ត្រូវបាន ក្រុម អ្នកសារព័ត៌មាន ប្រទះឃើញ អង្គុយ ក្នុង រថយន្ត១ គ្រឿង ជាមួយ កូនស្រី របស់ លោក ចាកចេញ ពី មន្ទីរពេទ្យ ប៉ូលិស នៅ ទីក្រុង បាងកក ជា ទី ដែល លោក អតីត នាយក រដ្ឋមន្រ្តី ថៃ បាន ចំណាយ ពេល ស្ថិត នៅ កន្លះ ឆ្នាំ ។ ប៉ុន្មាន នាទី ក្រោយ លោក ថាក់ ស៉ីន ក៏ បាន ទៅដល់ ផ្ទះ គ្រួសារ របស់ លោក ក្នុង រាជធានី ប្រទេស ថៃ ។
ក្រុមការងារ ខេត្ត ក្រចេះ គោរព ពាក្យ សន្យា សាងសង់ សាលា ល្អ ជូន ពលរដ្ឋ ក្រីក្រ នៅ ភូមិ ល្អ
( ច ង្រ្កង់ - ចិត្រ បុរី) ៖ នា ព្រឹក ថ្ងៃទី ១៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ស្ថិត ក្នុង បរិវេណ សាលា បឋមសិក្សា ល្អ នៃ ភូមិ ល្អ ឃុំ ច ង្រ្កង់ ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ អគារ សិក្សា មួយ ខ្នង ទើប សាងសង់ ថ្មី ត្រូវបាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ ដើម្បី ជា គុណ ប្រយោជន៍ នៃ ការអប់រំ សិក្សា សម្រាប់ កុមារា កុមារី នៃ តំបន់ ជនបទ ក្រីក្រ មួយ នេះ ។
ពិធី ជា មហោឡារិក នេះ ត្រូវបាន រៀបចំឡើង ដោយ អាជ្ញាធរ ខេត្ត ក្រចេះ ស្ថិត ក្រោម អធិបតីភាព លោក ទេសរដ្ឋមន្រ្តី ព្រុំ សុខា អតីត ប្រធាន ក្រុមការងារ ខេត្ត ក្រចេះ លោក រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន នេត្រ ភក្រ្តា ប្រធាន បច្ចុប្បន្ន របស់ ក្រុមការងារ ខេត្ត ក្រចេះ និង លោក អភិបាល ខេត្ត ក្រចេះ វ៉ា ថន ព្រមទាំង មាន ការចូលរួម ពីសំណាក់ ប្រជាពលរដ្ឋ មន្រ្តី មូលដ្ឋាន ខេត្ត ស្រុក និង អ្នកមុខអ្នក ការ នៃ ក្រុមការងារ ជាច្រើន រូប ទៀត ។
សូម បញ្ជាក់ ថា អគារ សិក្សា មួយ ខ្នង ថ្មី នេះ មាន ប្រាំ បន្ទប់ សាងសង់ ឡើង តាម ស្តង់ដា វិទ្យាល័យ ព្រះស៊ីសុវត្ថិ រាជធានី ភ្នំពេញ ចំណាយ ទឹកប្រាក់ អស់ ចំនួន ៨៥.០០០ $( ប្រាំបី ម៉ឺន ប្រាំ ពាន់ ដុល្លារ អាមេរិក ) ដែល ជា ការចូលរួម បច្ច័យ ដោយ សទ្ធា ជ្រះថ្លា នៃ សប្បុរសជន គ្រប់ ទិសទី នៅ ទូទាំង ប្រទេស តាមរយៈ បុណ្យ ផ្កា សាមគ្គី កាលពី ថ្ងៃទី ១៤ ខែកក្កដា ឆ្នាំ ២០២៣ ក្រោម ការផ្តើម គំនិត របស់ លោក ព្រុំ សុខា អតីត រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ ៕
ឥណ្ឌូណេស៊ី និង សិង្ហបុរី កំពុង ធ្វើ ការងារ ឆ្ពោះ ទៅរក កិច្ចសហការ ចាប់យក និង ស្តុក ទុក ឧស្ម័ន កាបូនិច
( ហ្សាការតា) ៖ រដ្ឋាភិបាល សិង្ហបុរី បាន ឱ្យដឹង នៅ ថ្ងៃព្រហស្បតិ៍ ថា សិង្ហបុរី បាន ក្លាយជា ប្រទេស ដំបូង គេ ដែល ចុះហត្ថលេខា លើ លិខិត សម្តែង បំណង (LOI) ជាមួយ ប្រទេស ឥណ្ឌូណេស៊ី លើ កិច្ចសហការ ឆ្លង ព្រំដែន ស្តីពី ការចាប់យក និង ការស្តុក ទុក កាបូន ឌី អុកស៊ីត (CCS) ។ នេះ បើ យោង តាម ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ ។
ទីភ្នាក់ងារ ព័ត៌មាន រ៉យទ័រ បាន រាយការណ៍ ថា ប្រទេស ឥណ្ឌូណេស៊ី ដែល មើលឃើញ សក្តានុពល ក្នុង ការអភិវឌ្ឍ វិស័យ ឧស្ម័ន ធម្មជាតិ និង CCS ថា ជា ផ្នែក មួយ នៃ ការផ្លាស់ប្តូរ សកលលោក ឆ្ពោះ ទៅកាន់ ឥន្ធនៈ បៃតង នោះ កាលពី ខែ មុន បាន ចេញ បទប្បញ្ញត្តិ ប្រធានាធិបតី មួយ ដែល អនុញ្ញាតឱ្យ ប្រតិបត្តិករ CCS បែងចែក ៣០ ភាគរយ នៃ សមត្ថភាព ផ្ទុក កាបូន របស់ ពួកគេ សម្រាប់ កាបូន ឌី អុកស៊ីត (CO2) ( ឬ ឧស្ម័ន កាបូនិច ) ដែល នាំចូល ។
ប្រទេស សិង្ហបុរី ដែល កំណត់ គោលដៅ បំភាយ ឧស្ម័ន សូន្យ ត្រឹម ឆ្នាំ ២០៥០ កំពុង សម្លឹង រកមើល បច្ចេកវិទ្យា បញ្ចេញ ឧស្ម័ន កាបូន ទាប ដូចជា ការប្រើប្រាស់ ឧស្ម័ន អ៊ីដ្រូសែន និង CCS ដែល ជា ផ្នែក មួយ នៃ វិធានការ កាត់បន្ថយ ឧស្ម័ន កាបូន របស់ ខ្លួន ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន រួម មួយ ដែល ចេញផ្សាយ កាល បី ថ្ងៃព្រហស្បតិ៍ ដោយ ប្រទេស ទាំង ពីរ បាន ឱ្យដឹង ថា សិង្ហបុរី និង ឥណ្ឌូនេស៊ី នឹង បង្កើត ក្រុមការងារ មួយ ដើម្បី រុករក កិច្ចព្រមព្រៀង ទ្វេ ភាគី ដែល ចង ភ្ជាប់ កាតព្វកិច្ច ផ្លូវ ច្បាប់ ស្តីពី ការដឹកជញ្ជូន ឧស្ម័ន កាបូនិច ឆ្លង ព្រំដែន និង ការស្តុក ទុក ឧស្ម័ន នេះ រវាង ប្រទេស ជិតខាង ទាំង ពីរ នេះ ។
លោក Jodi Mahardi អនុ រដ្ឋមន្ត្រី សម្របសម្រួល របស់ ឥណ្ឌូណេស៊ី ទទួលបន្ទុក គ្រប់គ្រង ថាមពល បាន ប្រាប់ រ៉យ ទ័រ ថា កិច្ចព្រមព្រៀង គ្រោង នេះ បាន បង្កើត ជា « ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ នៅក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង របស់ យើង ឆ្ពោះ ទៅរក ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង ការគ្រប់គ្រង បរិស្ថាន » ។
