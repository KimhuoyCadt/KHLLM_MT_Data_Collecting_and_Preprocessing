( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសៅរ៍ ៩រោច ខែ បុស្ស ឆ្នាំ ថោះ បញ្ចស័ក ពុទ្ធ សករាជ ២៥៦៧ ត្រូវ និង ថ្ងៃ៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ព្រមទាំង កូន ចៅ ក្រុមគ្រួសារ សាច់ញាតិ បាន បន្ត រៀបចំ ពិធី បុណ្យ គម្រប់ ខួប ១ ឆ្នាំ និង ឆ្លង ប្រាង្គ ព្រះចេតិយ ឧទ្ទិស កុល ដល់ ដួង វិញ្ញា ក្ខន្ធ លោកជំទាវ មហាសទ្ធា ភិរ័ក្ខ ធម្មសិរិរតន៍ អគ្គ មហា ឧបាសិកា ពុទ្ធសាសនូបត្ថម្ភក៍ ប៊ុន សុថា ដែល ត្រូវ ជា ប្អូន ថ្លៃ សម្តេច តេជោ ។
ការបញ្ជាក់ ឲ្យដឹង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ជា វ៉ាន់ ដេត ផ្ដល់ កិច្ចសម្ភាសន៍ ដល់ ក្រុម អ្នកសារព័ត៌មាន ពាក់ព័ន្ធ ថ្នាល ផ្ទៀងផ្ទាត់ ឯកសារ verify. gov. kh របស់ កម្ពុជា ឈ្នះ មេដាយ មាស នៃ ពានរង្វាន់ ឌីជីថល អាស៊ាន ឆ្នាំ ២០២៤ ក្នុង ពេល លោក ទើប ត្រឡប់ មកដល់ កម្ពុជា បន្ទាប់ពី ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ឌីជីថល អាស៊ាន លើក ទី៤ នា ព្រឹក ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
បន្ថែម ពី នោះ ទៀត លោក ជា វ៉ាន់ ដេត បាន ឲ្យដឹង ថា ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន ដាក់ ថ្នាល ផ្ទៀងផ្ទាត់ ឯកសារ verify. gov. kh នេះ នៅ តាម សកលវិទ្យាល័យ ដែល ក្រសួង បាន ចុះហត្ថលេខា ចំនួន ២២ សាកលវិទ្យាល័យ ដើម្បី ប្រើប្រាស់ ក្នុង សញ្ញាបត្រ ថ្នាក់ បរិញ្ញាបត្រ ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ និង ថ្នាក់ បណ្ឌិត ។
លើស ពី នោះ ទៀត លោក ជា វ៉ាន់ ដេត បាន លើកឡើង ថា ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នឹង បន្ដ ពង្រីក ដើម្បី ធ្វើម្ដេច ឲ្យ នា ពេល អនាគត ប្រទេស កម្ពុជា មិន ចាំបាច់ ប្រើប្រាស់ ឯកសារ សារធារណៈ ជា ក្រដាស បន្ដ ទៀត ទេ ដោយ ប្រើ បច្ចេកវិទ្យា ឌីជីថល ជំនួស ទាំងអស់ ។
ថ្នាល ផ្ទៀងផ្ទាត់ ឯកសារ verify. gov. kh ត្រូវបាន ដាក់ ឲ្យ ប្រើ ក្នុង គោលបំណង លុបបំបាត់ ការក្លែងបន្លំ ឯកសារ ផ្តល់ ភាពងាយស្រួល ក្នុង ការប្រើ និង ផ្ទៀងផ្ទាត់ ភាពត្រឹមត្រូវ នៃ ឯកសារ ផ្តល់ ទំនុកចិត្ត ចំណេញ ពេលវេលា និង កាត់បន្ថយ ចំណាយ នានា ព្រមទាំង ជំរុញ ការធ្វើ បរិវត្តកម្ម ឌីជីថល ស្រប តាម ឧត្តមានុវត្ត ជា អន្តរជាតិ ។
លោក ង៉ែត ពិទូ ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត រតនគិរី បាន ឱ្យដឹង ថា ក្បួន រថយន្ត បុរាណ ខាងលើ មកដល់ ខេត្ត រតនគិរី នា រសៀល ថ្ងៃទី២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ម្សិលមិញ ដោយ ធ្វើដំណើរ ចេញ ពី ទីក្រុង ព្រៃ នគរ ប្រទេស វៀតណាម ឆ្ពោះ មក ខេត្ត រតនគិរី តាម ច្រក ទ្វារ ព្រំដែន អន្តរជាតិ អូរ យ៉ាដាវ កម្ពុជា ។
សូម បញ្ជាក់ ថា អ្វី ជាជា ការចាប់អារម្មណ៍ នោះ គឺ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត រតនគិរី បាន សម្តែង នូវ ការសប្បាយរីករាយ និង ចាប់អារម្មណ៍ ជាខ្លាំង ដែល បាន ឃើញ ផ្ទាល់ ភ្នែក នូវ រថយន្ត បុរាណ ជាពិសេស យុវជន ជំនាន់ ក្រោយ ដែល ពួកគាត់ មិន ដែល បាន ឃើញ បាន ស្គាល់ នោះ ឡើយ ៕
ពលរដ្ឋ ក្រីក្រ ៥០ គ្រួសារ នៅ ស្រុក ចុង កាល់ ខេត្ត ឧត្តរមានជ័យ ទទួលបាន ប្រាក់ កម្ចី ដោយ ឥត ការប្រាក់ ពី កាកបាទ ក្រហម កម្ពុជា
( ឧត្តរមានជ័យ )៖ លោក ឃិន ញ៉ាណ អនុប្រធាន អចិន្ត្រៃយ៍ គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ឧត្តរមានជ័យ នា ថ្ងៃទី ២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន ដឹកនាំ ក្រុមការងារ ចុះ ផ្តល់ ប្រាក់ កម្ចី ដែល ជា ថវិកា របស់ កាកបាទ ក្រហម កម្ពុជា ផ្តល់ ជូន គ្រួសារ ក្រីក្រ គ្រួសារ ជន ពិការ និង ស្ត្រី មេម៉ាយ ចំនួន ៥០ គ្រួសារ នៅ ស្រុក ចុង កាល់ ។
នៅក្នុង ឱកាស នោះ លោក ឃិន ញ៉ាណ បាន ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពី លោក ប៉ែន កុសល្យ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ឧត្តរមានជ័យ ដែល ជានិច្ច ជាកាល តែងតែ គិតគូរ យកចិត្តទុកដាក់ ចំពោះ សុខ ទុក្ខ និង ជីវភាព របស់ នៅ របស់ ប្រជាពលរដ្ឋ ពិសេស ប្រជាពលរដ្ឋ ក្រីក្រ ស្ត្រី មេម៉ាយ ជន ពិការ ចាស់ជរា គ្មាន ទីពឹង ក្មេង កំព្រា ក៏ ដូចជា ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ធម្មជាតិ ផ្សេង ៗ ។
លោក ឃិន ញ៉ាណ បាន ថ្លែង ថា សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ឧត្តរមានជ័យ បាន ចុះ ផ្តល់ ប្រាក់ កម្ចី ដែល ជា ថវិកា របស់ កាកបាទ ក្រហម កម្ពុជា ជា ប្រាក់ កម្ចី ខ្នាត តូច ជូន ដល់ គ្រួសារ ពិការ ស្ត្រី មេម៉ាយ គ្រួសារ ក្រីក្រ ចំនួន ៥០ ករណី ដែល ក្នុង ១ករណី អាច កម្ចី បាន ថវិកា ចំនួន ១លាន រៀល ដោយ មិន មាន ការប្រាក់ ។
លោក ឃិន ញ៉ាណ បាន បញ្ជាក់ ថា ប្រាក់ កម្ចី ដែល ផ្តល់ ជូន ប្រជាពលរដ្ឋ ក្រីក្រ សម្រាប់ យក ទៅ ប្រកប មុខរបរ ផ្សេង ៗ នៅ ពេល នេះ មិន មែន ជា អំណោយ នោះ ទេ ហើយ បងប្អូន អាច កម្ចី រហូតដល់ រយៈពេល ១ ឆ្នាំ ដោយ មិន មាន ការប្រាក់ និង ត្រូវ សង ត្រឡប់ មកវិញ រយៈពេល ៦ ខែម្តង ដោយ ទឹកប្រាក់ ចំនួន ១លាន រៀល ត្រូវ សង មកវិញ ចំនួន ២លើ ក លើក ទី១ រយៈពេល ៦ខែ សង ៥០ ម៉ឺន រៀល និង លើក ទី២រយៈពេល ៦ខែ ទៀត ត្រូវ សង ៥០ ម៉ឺន រៀល ទៀត ដើម្បី កាកបាទ ក្រហម កម្ពុជា យក ទៅ បង្វិល ជូន បងប្អូន ក្រីក្រ កម្ចី បន្ត ទៀត ។
លោក ក៏ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ យើង ក្រោយពី ទទួលបាន ថវិកា កម្ចី នេះ ហើយ ត្រូវ ខិតខំ ពង្រីក មុខរបរ ដូចជា កសិកម្ម ចិញ្ចឹម សត្វ ដើម្បី លើកកម្ពស់ ជីវភាព គ្រួសារ ។
លោក ជា វ៉ាន់ ដេត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ បាន ជជែកគ្នា ជាមួយ រដ្ឋមន្ត្រី ឌីជីថល អាស៊ាន ទាំងអស់ ពេល ដែល ខ្ញុំ ចូលរួម ប្រជុំ នេះ គឺ យើង បាន ជជែកគ្នា ថា ថ្ងៃ ក្រោយ ទៅ យើង អាចនឹង ប្រើប្រាស់ ប្រព័ន្ធ នេះ នៅក្នុង ប្រទេស មួយ ៗ យក ទៅ ប្រើប្រាស់ ហើយ គេ គ្រប់គ្រង ប្រព័ន្ធ នេះ ខ្លួន គេ ដែល ប្រទេស មួយចំនួន មាន ការចាប់អារម្មណ៍ » ។
លោក បន្ដ ថា « មាន ប្រទេស មួយ បាន ឈានដល់ ការចរចារ MoU ហើយ ខណៈ ប្រទេស ៣ទៀត កំពុងតែ ឲ្យ អ្នកជំនាញ មើល ដូច្នេះ បើសិន ការងារ នេះ បាន សម្រេច គឺ យើង អាច យក ប្រព័ន្ធ នេះ ទៅ ដាក់ ឲ្យ ប្រើប្រាស់ នៅ គ្រប់ ប្រទេស អាស៊ាន ទាំងអស់ ហើយ យើង បាន នឹង រៀបចំ ឲ្យ ក្លាយទៅជា ប្រព័ន្ធ រួម មួយ សម្រាប់ យើង ប្រើប្រាស់ ទាំងអស់ គ្នា នៅក្នុង អាស៊ាន » ។
« មាន ន័យ ថា ឯកសារ ទាំងអស់ ពី កម្ពុជា គឺ យើង មិន មាន ការព្រួយបារម្ភ នៅ ពេល ដែល យើង ប្រើប្រាស់ នៅក្នុង ប្រទេស ផ្សេង ឬ ក៏ ប្រទេស ផ្សេង ឯកសារ ទាំងអស់ ដែល ឆ្លងកាត់ នៅ ប្រព័ន្ធ នេះ គឺ មក ប្រើប្រាស់ ប្រទេស កម្ពុជា ដោយ អត់ មាន ការព្រួយបារម្ភ ថា ក្លែងក្លាយ ឯកសារ » ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ជា វ៉ាន់ ដេត ។
លោក ជា វ៉ាន់ ដេត បាន លើកឡើង ថា នេះ ជា គោលដៅ ដែល ក្រសួង ចង់ឲ្យ ប្រព័ន្ធ នេះ ឲ្យ ក្លាយទៅជា ប្រព័ន្ធ រួម នៅក្នុង តំបន់ អាស៊ាន ហើយ សម្រាប់ ភ្ជាប់ ទៅនឹង ប្រព័ន្ធ អន្ដរជាតិ និង គោលដៅ ទី ពីរ គឺ ធ្វើ យ៉ាងម៉េច ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ហើយ អ្នកប្រើប្រាស់ ទាំង ក្រុមហ៊ុន ទាំង វិស័យ រដ្ឋ គឺ ប្រើប្រាស់ ប្រព័ន្ធ នេះ នៅក្នុង ប្រទេស កម្ពុជា ច្រើន ។
កម្ពុជា និង ថៃ ប្តេជ្ញាចិត្ត រួមគ្នា ការពារ ការបំពុល ទៅក្នុង បរិយាកាស ដើម្បី ការពារ សុខភាព សាធារណៈ ឆ្ពោះទៅ ភាព ស្អាត ៣ គឺ ស្អាត ទាំង បរិយាកាស ជុំវិញ ស្អាត ចិត្ត និង ស្អាត ទាំង សុខភាព
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ ក្រសួង បរិស្ថាន នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ក្រសួង ការបរទេស នៃ ប្រទេស ថៃ បាន ប្តេជ្ញាចិត្ត រួមគ្នា ទប់ស្កាត់ ផ្សែង អ័ព្ទ និង ការបំពុល ទៅក្នុង បរិយាកាស ដើម្បី ការពារ សុខ មាលភាព របស់ ប្រជាពលរដ្ឋ នៃ ប្រទេស ទាំង ពីរ ។
ការប្តេជ្ញាចិត្ត បាន ធ្វើឡើង ក្នុង ជំនួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ រវាង លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន និង លោក ចាក់ កាពុង សុង ម៉ានី អនុ រដ្ឋមន្រ្តី ក្រសួង ការបរទេស នៃ ប្រទេស ថៃ តាម ទូរស័ព្ទ នា រសៀល ថ្ងៃទី ០២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
( ស្វាយរៀង ) ៖ ជើង មាន់ ដែល ឈ្មួញ លួច នាំចូល ដោយ គ្មាន ច្បាប់ ចំនួន ៤កុងតឺន័រ ដែល ត្រូវ សមត្ថកិច្ច ជំនាញ បង្ក្រាប បាន កាលពី ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២៤ នឹង ត្រូវ ដុត កម្ទេចចោល នៅ ថ្ងៃទី៤ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ស្អែក នេះ នៅក្នុង ភូមិ ចុង ព្រែក សង្កាត់ ស្វាយរៀង ក្រុង ស្វាយរៀង ។
ជាមួយគ្នា នេះ នៅ កន្លែង ជីក រណ្ដៅ ត្រៀម ដុត ជើង មាន់ កម្ទេចចោល ក៏ មាន វត្តមាន មន្ត្រី ជំនាញ កងកម្លាំងប្រដាប់អាវុធ ការពារ យ៉ាង តឹងរឹង ផងដែរ ។
សូម បញ្ជាក់ ថា យោង តាម របាយការណ៍ ពី សាខា ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ សាខា ក . ប. ប ខេត្ត ស្វាយរៀង បាន ឱ្យដឹង ថា នៅ ថ្ងៃទី ៣១ ខែមករា វេលា ម៉ោង ២១៖ ២០នាទី មន្ត្រី សាខា ក . ប. ប ខេត្ត ស្វាយរៀង សហការ ជាមួយ កម្លាំង អាវុធហត្ថ ក្រោម ការសម្របសម្រួល ពី លោក ខាំ សុផារី ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ស្វាយរៀង បាន ឃាត់ កុងទីន័រ ចំនួន ៤គ្រឿង ដើម្បី ត្រួតពិនិត្យ ។ ក្រោយ ការត្រួតពិនិត្យ បាន រកឃើញ ថា រថយន្ត កុងតឺន័រ ទាំង ៤គ្រឿង នេះ ផ្ទុក ជើង មាន់ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ០៨៥ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៦. ០២១ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ សាលាដំបូង ខេត្ត ស្វាយរៀង ផ្ដន្ទាទោស ជនជាតិ វៀតណាម ៦នាក់ ក្រោយ បង្ក្រាប បាន ជាមួយ គ្រឿងញៀន ជាង ១តោន
( ស្វាយរៀង ) ៖ អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត ស្វាយរៀង តាមរយៈ សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន ឲ្យដឹង ថា កាលពី ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២៤ ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង ខេត្ត ស្វាយរៀង បាន ទទួល ចំណាត់ការលើ សំណុំ រឿង ព្រហ្មទណ្ឌ លេខៈ ៤៨ ចុះ ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២៤ មាន ជន ពាក់ព័ន្ធ ៦នាក់ ពាក់ព័ន្ធ បទល្មើស គ្រឿងញៀន ។
លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នៅ ព្រឹក ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន ផ្តល់ បទសម្ភាសន៍ ជុំវិញ ករណី ថ្នាល ផ្ទៀងផ្ទាត់ ឯកសារ របស់ កម្ពុជា verify .gov .kh ឈ្នះ មេដាយ មាស នៃ ពានរង្វាន់ ឌីជីថល អាស៊ាន ឆ្នាំ ២០២៤ ក្នុង ពេល លោក ទើប ត្រឡប់ មកដល់ កម្ពុជា បន្ទាប់ពី ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ឌីជីថល អាស៊ាន លើក ទី៤៕
ខាងក្រោម នេះ ជា វីដេអូ កិច្ចសម្ភាស ន៍៖ សាលាដំបូង ខេត្ត កំពង់ធំ បង្ហាញ ចំណាត់ការ តាម ផ្លូវ ច្បាប់ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ស្រុក ស្ទោង ដែល បង្ក ដោយ មន្ដ្រី ការិយាល័យ កសិកម្ម ស្រុក
យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ បាន ឲ្យដឹង ថា ក្រោយពី បាន ពិនិត្យ ស្រាវជ្រាវ ភស្តុតាង បាន បញ្ជាក់ ថា ជន បង្ក មាន ឈ្មោះ អែម សំអុន អាយុ ៥៥ ឆ្នាំ មាន មុខរបរ ជា អនុប្រធាន ការិយាល័យ កសិកម្ម ធនធាន ធម្មជាតិ និង បរិស្ថាន ស្រុក ស្ទោង ពិតជា បាន បើកបរ ស្ថិត ក្នុង ស្ថានភាព ស្រវឹង បង្កឲ្យ មាន គ្រោះថ្នាក់ ចរាចរណ៍ បណ្ដាល មាន ជនរងគ្រោះ ម្នាក់ បាន ស្លាប់ ប្រាកដ មែន ។
បន្ទាប់ពី បាន ស៊ើបសួរ រួច មក ជន ត្រូវ ចោទ ខាងលើ ត្រូវបាន ចៅក្រម ស៊ើបសួរ សាលាដំបូង ខេត្ត កំពង់ធំ សម្រេច បង្គាប់ ឲ្យ ឃុំ ខ្លួន តាម ដីកា បង្គាប់ ឃុំ ខ្លួន លេខៈ ១១៥ ចុះ ថ្ងៃទី ០១ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ដោយ ដាក់ ឲ្យ ស្ថិត នៅក្រោម ការពិនិត្យ ពី បទ « បើកបរ មាន ល្បឿន លឿន និង ក្នុង ស្ថានភាព ស្រវឹង ខ្ជីខ្ជា ខ្វះ ការប្រុងប្រយ័ត្ន និង បើកបរ ធ្វេសប្រហែស ខ្ជីខ្ជា ធ្វេសប្រហែស មិន ប្រុងប្រយ័ត្ន ឬ មិន គោរព កាតព្វកិច្ច បណ្ដាលឲ្យ ស្លាប់ អ្នកដទៃ » ។
បច្ចុប្បន្ន ជន ត្រូវ ចោទ ខាងលើ កំពុង ស្ថិត ក្រោម ការឃុំ ខ្លួន ក្នុង ពន្ធនាគារ ខេត្ត កំពង់ធំ រង់ចាំ ចំណាត់ការ នីតិវិធី បន្ត របស់ តុលាការ ៕ បណ្ឌិត កៅ គឹម ហួន ចូលរួម វេទិកា ថ្នាក់ រដ្ឋមន្ត្រី សហភាព អឺរ៉ុប - តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក លើក ទី ៣ និង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន - សហភាព អឺរ៉ុប លើក ទី២៤ និង ជួប ជាមួយ ថ្នាក់ដឹកនាំ សហភាព អឺរ៉ុប នៅ ទីក្រុង ព្រុច សែល
( បែលហ្ស៊ិក) ៖ នៅ ទីក្រុង ព្រុច សែល ព្រះរាជាណាចក្រ បែលហ្ស៊ិក នា ថ្ងៃទី ០២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ លោក បណ្ឌិត កៅ គឹម ហួន បាន អញ្ជើញ ចូលរួម ក្នុង វេទិកា ថ្នាក់ រដ្ឋមន្ត្រី សហភាព អឺរ៉ុប - តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក លើក ទី ៣។
វេទិកា នេះ ត្រូវបាន រៀបចំឡើង ចាប់តាំងពី ឆ្នាំ ២០២២ ជា វេទិកា សម្រាប់ ឲ្យ រដ្ឋ សមាជិក សហភាព អឺរ៉ុប ពិភាក្សា អំពី ការអនុវត្ត យុទ្ធសាស្ត្រ របស់ សហភាព អឺរ៉ុប កិច្ចសហប្រតិបត្តិការ ជាមួយ បណ្តា ប្រទេស នៅក្នុង តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក រួមទាំង សមាជិក អាស៊ាន ។ ឆ្នាំ នេះ វេទិកា ផ្តោត លើ បញ្ហា ដែល ជា ការប្រឈម ផ្នែក ភូមិសាស្ត្រ នយោបាយ និង សន្តិសុខ ក្នុង តំបន់ ឥណ្ឌូប៉ាស៊ីហ្វិក វិបុលភាព រួម ភាពធន់ ផ្នែក សេដ្ឋកិច្ច និង ការវ និយោគ ព្រមទាំង ការពន្លឿន ការផ្លាស់ប្តូរ បៃតង និង ថាមពល ។
លោក បណ្ឌិត អគ្គ លេខាធិការ អាស៊ាន បាន ជួប ពិភាក្សា ការងារ ជាមួយ លោកស្រី Elina Valtonen រដ្ឋមន្ត្រី ការបរទេស ហ្វាំងឡង់ ។ នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន បញ្ជាក់ ឡើងវិញ នូវ ការប្តេជ្ញាចិត្ត ក្នុង ការពង្រឹង បន្ថែម ទៀត នូវ ភាពជាដៃគូរ វាង អាស៊ាន និង ហ្វាំងឡង់ តាមរយៈ ការកំណត់ វិស័យ សហការ និង សហប្រតិបត្តិការ នានា ដែល អាច ធ្វើ ទៅ បាន ហើយ មាន ប្រយោជន៍ ទៅ វិញ ទៅ មក តាមរយៈ ក្របខណ្ឌ ទ្វេ ភាគី ផង និង ក្របខណ្ឌ ភាព ជាដៃគូ យុទ្ធសាស្ត្រ អាស៊ាន - សហភាព អឺរ៉ុប ផង ៕
គួរ បញ្ជាក់ ថា ផ្ទុយ ពី មីស៉ីល បាលិស្ទី គ ការធ្វើតេស្ត មីស៉ីល គ្រូ ស គឺ មិន ស្ថិត ក្រោម ការដាក់ទណ្ឌកម្ម បច្ចុប្បន្ន របស់ អង្គការ សហ ប្រជាជាតិ លើ ប្រទេស កូរ៉េ ខាងជើង នោះ ឡើយ ៕
សហរដ្ឋ អាមេរិក បាន ចោទប្រកាន់ ថា ការវាយប្រហារ ដោយ យន្ដហោះ ដ្រូន កាលពី ថ្ងៃអាទិត្យ សប្ដាហ៍ មុន គឺជា ស្នាដៃ របស់ ចលនា ប្រដាប់អាវុធ គាំទ្រ អ៉ីរ៉ង់ ។ ប៉ុន្តែ បាន សម្រេចចិត្ត មិន បើក ការវាយប្រហារ លើ ទឹកដី អ៉ីរ៉ង់ ដោយ ផ្ទាល់ នោះ ទេ ខណៈ ទីក្រុង វ៉ាស៊ីនតោន កំពុង ព្យាយាម កំញើញ និង ទប់ស្កាត់ កុំ ឱ្យ សង្រ្គាម ជាមួយ អ៉ីរ៉ង់ ដែល អាចនឹង ក្លាយជា សង្រ្គាម ក្នុង តំបន់ មជ្ឈិមបូព៌ា ទាំងមូល ផ្ទុះឡើង ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ដិន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ការសងសឹក របស់ យើង បាន ចាប់ផ្ដើម ហើយ នៅ ថ្ងៃ នេះ ហើយ នឹង បន្ត ធ្វើឡើង លើ គោលដៅ ដែល យើង ជា អ្នក កំណត់ » ។ យ៉ាងណា ក៏ដោយ លោក បៃ ដិន បាន អះអាង ថា សហរដ្ឋ អាមេរិក មិន មែន កំពុង ចង់ ធ្វើ សង្រ្គាម ក្នុង តំបន់ មជ្ឈិមបូព៌ា ឬ ក៏ កន្លែង ផ្សេង ទៀត នៅលើ ពិភពលោក ឡើយ ។ ប៉ុន្តែ លោក បាន ព្រមាន ថា សហរដ្ឋ អាមេរិក នឹង សងសឹក ជាដាច់ខាត ចំពោះ រាល់ ការវាយប្រហារ លើ កងទ័ព អាមេរិក ។
( ភ្នំពេញ ) ៖ នៅ សប្តាហ៍ ក្រោយ នេះ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង បើក សន្និបាត បូកសរុប ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ សម្រាប់ ឆ្នាំ ២០២៤ ។ សន្និបាត នេះ មាន រយៈពេល ពីរ ថ្ងៃ គឺ ថ្ងៃទី ៥ និង ៦ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
យោង តាម ការជូន ព័ត៌មាន របស់ ក្រសួង បាន ឱ្យដឹង ថា លោក ជា សុមេធី រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នឹង អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក សន្និបាត នៅ ថ្ងៃទី៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤ វេលា ម៉ោង ៨៖០០ ព្រឹក ។ រីឯ ពិធី បិទ ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ ២០២៤ វេលា ម៉ោង ៨៖០០ ព្រឹក ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូន អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
ក្រសួង បញ្ជាក់ ថា កម្រិត សម្ពាធ ទាប ខ្សោយ គ្របដណ្តប់ លើ កម្ពុជា រួម ជាមួយនឹង ខ្យល់ មូសុង ឦសាន ខ្សោយ ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឱ្យ៖ ចាប់ពី ថ្ងៃទី ៣ ដល់ ថ្ងៃទី៥ ខែកុម្ភៈ ឆ្នាំ ២០២៤៖
លោក Xi បាន និយាយ ថា ឆ្នាំ ២០២៣ គឺជា យុគសម័យ ប្រវត្តិសាស្ត្រ នៃ ទំនាក់ទំនង ចិន - វៀតណាម ជាមួយនឹង ការផ្លាស់ប្តូរ កម្រិត ខ្ពស់ ជាញឹកញាប់ រវាង ភាគី ទាំង ពីរ ការជឿទុកចិត្ត គ្នា ទៅ វិញ ទៅ មក ផ្នែក នយោបាយ កាន់តែ រឹងមាំ សកម្មភាព ផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន ដ៏ រស់រវើក និង មិត្តភាព ប្រពៃណី កាន់តែ រឹងមាំ ។
ដោយ កត់សម្គាល់ ថា លោក និង លោក Trong បាន រួមគ្នា ប្រកាស ពី ការកសាង សហគមន៍ អនាគត រួម រវាង ចិន - វៀតណាម ដែល មាន សារៈសំខាន់ ជា យុទ្ធសាស្ត្រ នោះ លោក Xi បាន និយាយ ថា វា បាន បើក ផ្លូវ ថ្មី និង ជំពូក ថ្មី សម្រាប់ ការអភិវឌ្ឍ ទំនាក់ទំនង រវាង បក្ស ទាំង ពីរ និង ប្រជាជាតិ ទាំង ពីរ ដែល ជា ការបង្ហាញ ឆន្ទៈ ដ៏ ម៉ឺងម៉ាត់ និង ការប្តេជ្ញាចិត្ត របស់ ភាគី ទាំង ពីរ ក្នុង ការសហការ និង ឆ្ពោះទៅ មុខ ៕
គួរ បញ្ជាក់ ថា ទីក្រុង ម៉ានីល បាន ច្រានចោល សំណើ របស់ ទីក្រុង ប៉េកាំង កាលពី ឆ្នាំ មុន ឱ្យ ដក ខ្មោច នាវា ចម្បាំង នោះ ចេញ ដែល នេះ បាន បង្កឱ្យ មាន ភាពតានតឹង ក្នុង ទំនាក់ទំនង រវាង ប្រទេស ទាំង២។ ចិន បាន អះអាង ពី ដែន អធិបតេយ្យ គ្រប់គ្រង ស្ទើរតែ ទាំងស្រុង លើ តំបន់ សមុទ្រ ចិន ខាងត្បូង ក្នុង នោះ រួម មាន ទាំង តំបន់ ទាមទារ អធិបតេយ្យ ដោយ វៀតណាម ហ្វីលីពីន ម៉ាឡេស៊ី ព្រុយណេ និង ឥណ្ឌូណេស៊ី ៕
( ភ្នំពេញ ) ៖ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ដាក់ចេញ អនុសាសន៍ ៦ចំណុច ឲ្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ អនុវត្ត ដោយ គោលដៅ រួម នោះ គឺ ដើម្បី ធ្វើឲ្យ ជីវភាព ពលរដ្ឋ កាន់តែ ប្រសើរឡើង ជាពិសេស គឺ កម្មករ កម្ម ការិនី តែ ម្តង ហើយ សម្រាប់ ឆ្នាំ ២០២៤ នេះ និង ឆ្នាំ ២០២៥ ខាងមុខ រាជ រដ្ឋាភិបាល ក៏ បាន ដាក់ចេញ នូវ អនុសាសន៍ បន្ថែម ៤ចំណុច ទៀត ។ តើ ក្រោយ អនុសាសន៍ នេះ ក្រសួង ការងារ បង្កើត បាន សមិទ្ធផល អ្វី ខ្លះ ?
សូម រង់ចាំ ទស្សនា កិច្ចពិភាក្សា ជាមួយ ឯកឧត្តម កត្តា អ៊ន អ្នកនាំពាក្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅក្នុង កម្មវិធី Fresh Talk នៅ ម៉ោង ៦៖០០ ល្ងាច ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នេះ តាម ទូរទស្សន៍ និង បណ្តាញ នានា របស់ Fresh News៕ លោក វង សូត និង ក្រុម អ្នកតំណាងរាស្រ្ត មណ្ឌល ខេត្ត ត្បូងឃ្មុំ ជួប សំណេះសំណាល ជាមួយ ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ទូទាំង ខេត្ត ត្បូងឃ្មុំ
( ត្បូង ឃ្ម) ៖ លោក វង សូត អនុប្រធាន ទី២ រដ្ឋសភា រួមទាំង ក្រុម អ្នកតំណាងរាស្រ្ត មណ្ឌល ខេត្ត ត្បូងឃ្មុំ បាន ជួប សំណេះសំណាល ជាមួយ ក្រុមប្រឹក្សា - ឃុំ សង្កាត់ ក្នុង ក្របខណ្ឌ ទូទាំង ខេត្ត ត្បូងឃ្មុំ ដែល ជា អង្គ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ។ ពិធី នេះ ការចួល រួម ពី បេក្ខជន ឈរ ឈ្នោះ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា សម្រាប់ ភូមិភាគ២ ( ខេត្ត កំពង់ចាម និង ខេត្ត ត្បូងឃ្មុំ ) ផងដែរ ។
លោក វង សូត បាន សម្តែង នូវ ភាពសប្បាយរីករាយ ចំពោះ វេទិកា ជួបជុំ នា ពេលនេះ រវាង តំណាងរាស្រ្ត និង ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ដែល ជា អង្គ បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា ដូចគ្នា ។
លោក បាន គូសបញ្ជាក់ ថា កម្ពុជា មាន ការបោះឆ្នោត ២ប្រភេទ គឺ ការបោះឆ្នោត សកល និង ការបោះឆ្នោត អសកល ។ ការបោះឆ្នោត បែប សកល គឺ មាន ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត និង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ។ ដោយឡែក ការបោះឆ្នោត បែប អសកល មាន ដូចជា ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា និង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ជាដើម ។
ការបោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា មាន អង្គ បោះឆ្នោត ពីរ ប្រភេទ គឺ តំណាងរាស្រ្ត ក្នុង តំណែង និង ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ។ នៅក្នុង ក្របខណ្ឌ ទូទាំង ខេត្ត ត្បូងឃ្មុំ មាន អង្គ បោះឆ្នោត សរុប ចំនួន ៥៤៤ រូប ក្នុង នោះ មាន តំណាងរាស្រ្ត ក្នុង តំណែង ចំនួន ៨រូប និង ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ ចំនួន ៥៣៦ រូប ។
( ភ្នំពេញ ) ៖ លោក ពៅ ម៉ាលី រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ថ្លែង បញ្ជាក់ ថា នៅក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ កំណើន នៃ ការប្រើប្រាស់ យានយន្ត នៅ កម្ពុជា មាន ការកើនឡើង គួរឱ្យ កត់សម្គាល់ ជាពិសេស ប្រភេទ យាយន្ត ថ្មី ៗ រួមទាំង យានយន្ត ដើរ ដោយ ម៉ាស៊ីន ចំហេះ ក្នុង (ICE) ប្រើប្រាស់ ថាមពល ហ្វូស៊ីល និង យានយន្ត អគ្គិសនី (EV) ប្រើប្រាស់ ថាមពល ស្អាត ផងដែរ ។
( កណ្ដាល ) ៖ ជនសង្ស័យ ដែល ជា ឃាតក សម្លាប់ ស្ត្រី មាន ផ្ទៃពោះ ៥ខែ និង ដុត សាកសព ហើយ ប្លន់ យក ម៉ូតូ ត្រូវបាន លោកស្រី ថ្លាង ស្រី ណុច ព្រះរាជអាជ្ញារ អយ្យកាល អម សាលាដំបូង ខេត្ត កណ្តាល បាន ចោទប្រកាន់ ពី បទ « ឃាតកម្ម គិត ទុក ជាមុន » តាម មាត្រា ២០០ ក្រម ព្រហ្មទណ្ឌ បញ្ជូន ទៅ ចៅក្រម ស៊ើបសួរ លោក ចៅក្រម ស៊ូ បញ្ញា រួចរាល់ ហើយ ។
សូម ជម្រាប ថា ឃាតក សម្លាប់ ស្ដ្រី មាន ផ្ទៃពោះ ៥ខែ ហើយ យក សាំង ចាក់ ដុត សាកសព រួច យក ម៉ូតូ ជនរងគ្រោះ ដែល បាន កើតឡើង កាលពី ថ្ងៃទី ១៤ ខែមករា ឆ្នាំ ២០២៤ កន្លងទៅ នៅ ចំណុច ព្រៃ ខាងជើង ភូមិ រំលេច ឃុំ ទួល ព្រេជ ស្រុក អង្គស្នួល ខេត្ត កណ្តាល និង ប្រទះឃើញ សាកសព ជនរងគ្រោះ នៅ ថ្ងៃទី ២១ ខែមករា ឆ្នាំ ២០២៤ នៅ ចំណុច ខាងលើ ត្រូវបាន កម្លាំង អាវុធហត្ថ ខេត្ត កណ្ដាល ស្រាវជ្រាវ បំបែក បាន ហើយ ។
ដំណើរ រឿង ហេតុ នាំឲ្យ ជនសង្ស័យ សម្លាប់ ជនរងគ្រោះ គឺ កន្លងមក ជនសង្ស័យ និង ជនរងគ្រោះ ធ្លាប់ មាន ទំនាក់ទំនង ស្នេហា នឹង គ្នា ជួបគ្នា លើក ចុងក្រោយ នៅ ថ្ងៃទី ១៤ ខែមករា ឆ្នាំ ២០២៤ មុនពេល កើត ហេតុ ជនសង្ស័យ បាន ទូរស័ព្ទហៅ មក គ្នា ។ ជនរងគ្រោះ ក៏ ព្រមព្រៀង មក ជួប ក្រោយ ជួប ហើយ ជនសង្ស័យ មាន គំនិត ជាស្រេច ត្រៀម ថា នឹង សម្លាប់ ជនរងគ្រោះ ដើម្បី យក ម៉ូតូ ។
ក្នុង រយៈពេល ប្រហែល មួយ ម៉ោង ក្រោយម ក ពួកគេ ទាំង ពី នាក់ បាន ចេញ ពី ផ្ទះសំណាក់ រក កន្លែង ដែល អំណោយផល ដើម្បី ធ្វើ សកម្មភាព សម្លាប់ ជនរងគ្រោះ រហូតមកដល់ កន្លែង កើត ហេតុ ខាង លើ ក៏ ឈប់ ម៉ូតូ អង្គុយ លេង មួយ សន្ទុះ ឃើញ ជនរងគ្រោះ អង្គុយ មិន ប្រយ័ត្ន ក៏ យក ខ្សែ អង្រឹង ដែល ត្រៀម ទុក ក្នុង ហោប៉ៅ ខោមក ធ្វើ សកម្មភាព ទាក់រឹកក ជនរងគ្រោះ ពីក្រោយ ហើយ ទាញ បង្វិល ផ្កាប់ មុខ មិន ឲ្យ រើ បម្រាស់ រួច ពេល នោះ ជនរងគ្រោះ ដាច់ខ្យល់ស្លាប់ ភ្លាម ៗ ។
រួចហើយ ជនសង្ស័យ ក៏ យក ខ្សែ ទាក់ក ជនរងគ្រោះ អូស ចូល ទៅក្នុង ព្រៃ ក្បែរ នោះ ប្រហែល៣០ ម៉ែត្រ ហើយ ប្រមូល ស្មៅ និង មែក ឈើ ងាប់ ៗ នៅជិត នោះ គ្រប លើស ពជនរងគ្រោះ រួច ជិះ ម៉ូតូ ជនរងគ្រោះ ទៅ ទិញ ប្រេងសាំង មួយ លីត្រ និង ដែក កេះ មួយ នៅ តូប លក់ អីវ៉ាន់ ក្នុង ឃុំ ទួល ព្រេជ ស្រុក អង្គស្នួល មក ស្រោច លើស ពជនរងគ្រោះ ហើយ កេះ ដែក កេះ ដុត សព តែម្តង ។ បន្ទាប់មក ជនសង្ស័យ យក ម៉ូតូ ជនរងគ្រោះ ជិះ គេចខ្លួន យក ទៅ លក់ នៅ ម្តុំ ផ្សារ ដេប៉ូ រាជធានី ភ្នំពេញ ។
នៅ ចំពោះមុខ សមត្ថកិច្ច ជនសង្ស័យ ឈ្មោះ រតនា ហៅ គាង បាន ឆ្លើយ សារភាព ថា ខ្លួន ពិតជា បាន រៀបចំ គម្រោង ផែនការ និង ត្រៀម សម្ភារៈ ទុក ជាមុន ដើម្បី សម្លាប់ ជនរងគ្រោះ ឈ្មោះ ថា រី ហៅ ស្រី មុី ពិតប្រាកដ មែន ។ មូលហេតុ ដោយ គេ ចាញ់ ល្បែង ជំពាក់ លុយ គេ ច្រើន ៕
( ភ្នំពេញ ) ៖ នៅ យប់ ថ្ងៃទី ០២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ដោយ អនុវត្ត តាម បទបញ្ជា ដ៏ ម៉ឺងម៉ាត់ របស់ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ កម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ ទួលគោក ចុះ អនុវត្ត រឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក និង ត្រួតពិនិត្យ ជាតិ ស្រវឹង បាន ធ្វើ ការឃាត់ Pass App ចំនួន ០២ គ្រឿង កែច្នៃ ខុស លក្ខណៈ បច្ចេកទេស ។
សូម ជម្រាប ថា លទ្ធផល នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ និង ត្រួតពិនិត្យ ជាតិ អាល់កុល នៅ យប់ ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ដែល ដឹកនាំ ផ្ទាល់ ដោយ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ឃាត់ យានយន្ដ ល្មើស ៨១ គ្រឿង ក្នុង នោះ រថយន្ត ៣១ គ្រឿង និង ម៉ូតូ ៥០ គ្រឿង ។
ជា លទ្ធផល តាម បណ្តា អធិការដ្ឋាន នគរបាល ខណ្ឌ បាន ចុះ អនុវត្ត រឹត បន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក និង ត្រួតពិនិត្យ ជាតិ អាល់កុល ដូច ខាងក្រោម៖ ឃាត់ យានយន្ត ល្មើស សរុប ចំនួន ៨១ គ្រឿង ( រថយន្ត ចំនួន ៣១ គ្រឿង . ម៉ូតូ ចំនួន ៥០ គ្រឿង ) ៖
* ទី២៖ បទល្មើស ផ្សេង ៗ ចំនួន ១៨គ្រឿ ង៖ អត់ មួក សុវត្ថិភាព ចំនួន ១១គ្រឿង . ឡាន គ្មាន ប័ណ្ណ បើកបរ ចំនួន៦ គ្រឿង និង រថយន្ដ ល្មើស សញ្ញា ចរាចរណ៍ ចំនួន ១ គ្រឿង ។
អភិបាល រង ខេត្ត កំពង់ចាម៖ វិស័យ សុខាភិបាល មាន អាទិភាព ខ្ពស់ ចូលរួមចំណែក កាត់បន្ថយ នូវ ភាព ក្រីក្រ របស់ ប្រជាពលរដ្ឋ
( កំពង់ចាម ) ៖ លោក ហាន កុសល អភិបាល រង ខេត្ត កំពង់ចាម បាន លើកឡើង ថា វិស័យ សុខាភិបាល ជា វិស័យ មួយ មាន អាទិភាព ខ្ពស់ ក្នុង ការចូលរួមចំណែក កាត់បន្ថយ នូវ ភាព ក្រីក្រ របស់ ប្រជាពលរដ្ឋ ហើយ នឹង ផ្ដល់ ឱ្យ ប្រជាពលរដ្ឋ នូវ សុខភាព និង សុខ មាលភាពល្អ ដើម្បី ជា កត្តា ចម្បង ក្នុង ការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ពួកគាត់ ។
លោក អភិបាល រង ខេត្ត បាន លើកឡើង ដូច្នេះ នា រសៀល ថ្ងៃទី២ ខែកុម្ភៈ ឆ្នាំ ២០២៤ នៅ មន្ទីរ សុខាភិបាល ក្នុង ពិធី បិទ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ឆ្នាំ ២០២៤ របស់ មន្ទីរ សុខាភិបាល រដ្ឋបាល ខេត្ត កំពង់ចាម ។
លោក ឃិន ញ៉ាណ បាន ថ្លែង ថា សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ឧត្តរមានជ័យ បាន ចុះ ផ្តល់ ប្រាក់ កម្ចី ដែល ជា ថវិកា របស់ កាកបាទ ក្រហម កម្ពុជា ជា ប្រាក់ កម្ចី ខ្នាត តូច ជូន ដល់ គ្រួសារ ពិការ ស្ត្រី មេម៉ាយ គ្រួសារ ក្រីក្រ ចំនួន ៥០ ករណី ដែល ក្នុង ១ករណី អាច កម្ចី បាន ថវិកា ចំនួន ១លាន រៀល ដោយ មិន មាន ការប្រាក់ ។
ក្នុង នាម លោក ប៉ែន កុសល្យ ក៏ ដូចជា មន្ត្រី សមាជិក សមាជិកា អ្នកស្ម័គ ចិត្ត កាកបាទ ក្រហម កម្ពុជា ទូទាំង ខេត្ត លោក ឃិន ញ៉ាណ សូម គោរព ជូនពរ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា សូម មាន សុខភាព ល្អ បរិបូរណ៍ និង ឆាប់ ជាសះស្បើយ ពី ជំងឺ ៕
បើ តាម ទី បញ្ជាការ កណ្ដាល សហរដ្ឋ អាមេរិក ឬ ហៅ កាត់ ថា CENTCOM នៅក្នុង ការវាយប្រហារ តាម ផ្លូវ អាកាស កាលពី ថ្ងៃសុក្រ ទី២ ខែកុម្ភៈ សហរដ្ឋ អាមេរិក បាន ប្រើប្រាស់ គ្រាប់បែក កំណត់ គោលដៅ ជាក់លាក់ ១២៥ គ្រាប់ លើ គោលដៅ ចំនួន ៨៥ ក្នុង នោះ រួម មាន ទីបញ្ជាការគ្រប់គ្រង និង មូលដ្ឋាន ស៊ើបការណ៍ រួមទាំង ឃ្លាំង ស្ដុក គ្រាប់ រ៉ុក្កែត មីស៊ីល និង យន្ដហោះ ដ្រូន ដែល ជា កម្មសិទ្ធិ របស់ កងកម្លាំង អ៉ី រ៉ង់ និង ចលនា ប្រដាប់អាវុធ គាំទ្រ ដោយ អ៉ីរ៉ង់ ក្នុង ប្រទេស ស៊ីរី និង អ៉ីរ៉ាក់ ។
យ៉ាងណា ក៏ដោយ ការវាយប្រហារ សងសឹក របស់ សហរដ្ឋ អាមេរិក បាន បង្កឱ្យ មាន ការព្រួយបារម្ភ រឹតតែ ខ្លាំង ពី ការកើនឡើង ភាពតានតឹង នៅក្នុង តំបន់ ដ្បិត វា អាចនឹង បង្កើត ជា វដ្ដ សងសឹក ដាក់ គ្នា ទៅ វិញ ទៅមក ។
គួរ បញ្ជាក់ ថា នៅក្នុង សុន្ទរកថា មួយ កាលពី ថ្ងៃសុក្រ លោក បៃ ដិន ក៏ បាន អះអាង ដែរ ថា សហរដ្ឋ អាមេរិក មិន មែន កំពុង ចង់ ធ្វើ សង្រ្គាម ក្នុង តំបន់ មជ្ឈិមបូព៌ា ឬ ក៏ កន្លែង ផ្សេង ទៀត នៅលើ ពិភពលោក ឡើយ ។ ប៉ុន្តែ លោក បាន ព្រមាន ថា សហរដ្ឋ អាមេរិក នឹង សងសឹក ជាដាច់ខាត ចំពោះ រាល់ ការវាយប្រហារ លើកងទ័ព អាមេរិក ៕ រូបភាព ពី Reuters រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន រកឃើញ បញ្ហា ប្រឈម ចំនួន ៣ ដែល បង្ក ជា ហានិភ័យ ដល់ បឹង ទន្លេ សាប
( បាត់ដំបង ) ៖ លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន បាន រកឃើញ នូវ បញ្ហា ប្រឈម ចំនួន ៣ ដែល កំពុង បំផ្លិចបំផ្លាញ ដល់ បឹង ទន្លេ សាប ។ បញ្ហា ទី ទាំង៣នេះ គឺ បញ្ហា ភ្លើង ឆេះ ព្រៃ . ការទន្ទ្រាន ព្រៃ យក ដី និង បម្រែបម្រួល អាកាសធាតុ ។
លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន ថ្លែង ថា បឹង ទន្លេ សាប គឺជា ឃ្លាំង ស្ដុក សារធាតុ ប្រូតេអ៉ីន ដ៏ សំខាន់ របស់ កម្ពុជា ដែល មាន ន័យ ថា ជា កន្លែង នៃ ប្រភព ត្រី ចម្រុះ រាប់ រយ ប្រភេទ សម្រាប់ ជា តម្រូវការ របស់ ប្រជាជន ខ្មែរ រាប់ លាន នាក់ ជារៀងរាល់ ឆ្នាំ ។
លោក រដ្ឋមន្ត្រី អ៊ាង សុផល្លែត បាន ឱ្យដឹង ថា សម្រាប់ បញ្ហា ប្រឈម ទី១ គឺ បញ្ហា ភ្លើង ឆេះ ព្រៃ ដែល កំពុង ក្លាយជា ក្ដីបារម្ភ មួយ បង្ក ដល់ ការបំផ្លិចបំផ្លាញ បឹង ទន្លេ សាប ។ ជា វិធានការចាំបាច់ ជាបន្ទាន់ ចំពោះ មុខ លោក បណ្ឌិត រដ្ឋមន្ត្រី ណែនាំ ឱ្យ មាន ការចូលរួម ទប់ស្កាត់ កុំ ឱ្យ ភ្លើង ឆេះ ព្រៃ តទៅទៀត ហើយ ជាមួយគ្នា នេះ លោក បាន ជំរុញ ការដាំដុះ កូន ឈើ ឡើងវិញ ឱ្យ បាន កាន់តែ ច្រើន ក្រោម កិច្ចសហការ រវាង ក្រសួង កសិកម្ម និង ក្រសួង បរិស្ថាន ព្រមទាំង ប្រជា សហគមន៍ ។
