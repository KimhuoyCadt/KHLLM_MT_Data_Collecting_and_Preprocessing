( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី២ ខែមីនា ឆ្នាំ ២០២៤ លោក វង្សី វិស្សុត ឧប នាយក រដ្ឋមន្ត្រី ប្រចាំ ការ រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្តីការ គណៈ រដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មការរៀបចំ ព្រះរាជ ពិធី បុណ្យ ថ្វាយ ព្រះសព សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ដឹកនាំ កិច្ចប្រជុំ ដើម្បី ពិភាក្សា អំពី ការរៀបចំ ព្រះរាជ ពិធី បុណ្យ ថ្វាយ ព្រះសព សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស ។
អង្គប្រជុំ បាន ធ្វើ ការបូកសរុប សកម្មភាព ការងារ នៃ ការរៀបចំ ព្រះរាជ ពិធី បុណ្យ ដែល បាន ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ២៧ ដល់ រហូត ថ្ងៃទី១ ខែមីនា ឆ្នាំ ២០២៤ និង ការរៀបចំ ផែនការ សកម្មភាព ការងារ សំខាន់ ៗ សម្រាប់ ព្រះរាជ ពិធី បុណ្យ ទក្ខិណា នុប្បទាន គម្រប់ ប្រាំពីរ ថ្ងៃ ដើម្បី ឧទ្ទិស ព្រះរាជ មហា កុសល ថ្វាយ ព្រះវិញ្ញាណក្ខន្ធ ព្រះបរម សព សម្ដេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស ព្រមទាំង ផែនការ សកម្មភាព ដែល អនុវត្ត បន្ត រហូតដល់ ថ្ងៃ ថ្វាយ ព្រះភ្លើង ព្រះសព ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី២ ខែមីនា ឆ្នាំ ២០២៤ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១៣៩. ០៩៥ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១៣៦. ០៣៧ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០៥៦ នាក់ ៕ ដល់ ភ្លាម ជួប ភ្លែត ! សម្តេច ធិបតី ហ៊ុន ម៉ាណែត អនុញ្ញាតឱ្យ ប្រធាន ក្រុមហ៊ុន របស់ អូស្ត្រាលី ជួប ពិភាក្សា ការងារ
( ម៉ែល ប៊ន . អូស្ត្រាលី ) ៖ មិន ខាត ឲ្យ ពេលវេលា នោះ ទេ ទោះ ត្រូវ ចំណាយ ថាមពល លើ យន្ត អស់ ពេល ប្រមាណ ១០ ម៉ោង យ៉ាងណា ក្តី គ្រាន់តែ ដល់ ប្រទេស អូស្ត្រាលី ភ្លាម សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ចាប់ផ្តើម ការងារ ភ្លាម ផងដែរ ។
ក្នុង រយៈពេល ៣៨ ថ្ងៃ នៃ យុទ្ធនាការ ជំរុញ និង ពន្លឿន ការដោះស្រាយ រឿងក្តី នៅ តាម តុលាការ ! សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង បាន ចាត់ការ សំណុំរឿង អត្រានុកូលដ្ឋាន រួច ចំនួន ៥៤៤ សំណុំរឿង
( កំពង់ឆ្នាំង ) ៖ អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង បាន សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ចំណាត់ការ សំណុំរឿង អត្រានុកូលដ្ឋាន ក្នុង រយៈពេល ៣៨ ថ្ងៃ នៃ ថ្ងៃ ធ្វើ ការ ( គិត ចាប់ពី ថ្ងៃទី ៩ ខែមករា ដល់ ថ្ងៃ ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ) នៃ យុទ្ធនាការ ជំរុញ និង ពន្លឿន ការដោះស្រាយ រឿងក្តី នៅ តាម តុលាការ ។
សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង មាន សំណុំរឿង អត្រានុកូលដ្ឋាន សរុប ចំនួន ៥៦៨ សំណុំរឿង និង បាន ចាត់ការ ដូច ខាងក្រោម៖
ទី ២៖ ក្នុង អំឡុង ពេល យុទ្ធនាការ មាន សំណុំរឿង អត្រានុកូលដ្ឋាន ចូល ថ្មី ចំនួន ២៧៥ សំណុំរឿង ហើយ ត្រូវបាន ចាត់ការ រួច ចំនួន ២៥១ សំណុំរឿង ។
សរុប ជា រួម ក្នុង រយៈពេល ៣៨ ថ្ងៃ . សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង បាន ចាត់ការ សំណុំរឿង អត្រានុកូលដ្ឋាន ចំនួន ៥៤៤ សំណុំរឿង ។
អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង សូម បញ្ជាក់ ជូន បន្ថែម ថា ចំពោះ សំណុំរឿង អត្រានុកូលដ្ឋាន ថ្មី ដែល នៅសល់ កំពុង ចាត់ការ ចំនួន ២៤ សំណុំរឿង . សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង នឹង ខិតខំ បន្ត ចំណាត់ការ ដោយ យកចិត្តទុកដាក់ ពិនិត្យភាពត្រឹមត្រូវ នៃ ឯកសារ ព្រមទាំង ភស្តុតាង នានា ដើម្បី ចេញ សេចក្ដីសម្រេច ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ឆាប់រហ័ស បំផុត ៕ ប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ខេត្ត កំពត - កែប ស្នេី ឱ្យ ក្រុម គ្រូពេទ្យ ប្រកបដោយ គុណធម៌ សមធម៌ និង សេចក្តីថ្លៃថ្នូរ នៃ វិជ្ជាជីវៈ សុខាភិបាល
( កំពត - កែប )៖ លោក កែវ សុផាន់ ប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ខេត្ត កំពត - កែប បាន ស្នើ ដល់ ជួរ ថ្នាក់ដឹកនាំ ក្រុម គ្រូពេទ្យ ជួយ ជ្រោមជ្រែង យកចិត្តទុកដាក់ និង ជំរុញ សកម្មភាព នានា ពី ថ្នាក់ ជាតិ សំដៅ ពន្លឿន នូវ ការអនុវត្ត ច្បាប់ បទបញ្ជា ផ្ទៃក្នុង ពង្រឹង នូវ គុណ វុឌ្ឍន៍ ការប្រតិបត្តិ វិជ្ជាជីវៈ ប្រកបដោយ គុណធម៌ សមធម៌ និង សេចក្តីថ្លៃថ្នូរ នៃ វិជ្ជា ជៈ សុខាភិបាល ដើម្បី ឈាន ទៅរក ការអភិវឌ្ឍ សង្គមជាតិ ស្រប តាម យុទ្ធសាស្ត្រ និង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។
ការស្នើ បែប នេះ របស់ លោក វេជ្ជបណ្ឌិត តាន់ ឆេង អនុប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កំពត និង លោក វេជ្ជបណ្ឌិត កែវ សុផាន់ ប្រធាន ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ខេត្ត កំពត - កែប ចូលរួម ជា អធិបតី ក្នុង ទិវា អភិវឌ្ឍន៍ វិជ្ជាជីវៈ វេជ្ជសាស្ត្រ បន្ត លើក ទី ១៤ របស់ ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ខេត្ត កំពត - កែប ដែល ធ្វើឡើង នៅ មន្ទីរ សុខាភិបាល ខេត្ត កំពត នា ថ្ងៃទី១ ខែមីនា ឆ្នាំ ២០២៤ ។
លោក វេជ្ជបណ្ឌិត កែវ សុផាន់ បញ្ជាក់ ទៀត ថា គិត ត្រឹម ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២៤ មាន សមាជិក សមាជិកា នៃ ក្រុមប្រឹក្សា គណៈ គ្រូពេទ្យ ខេត្ត កំពត - កែប បាន ចុះបញ្ជី ការសុំ អាជ្ញាបណ្ណ សរុប ៣០៩ រូប ក្នុង នោះ អាជ្ញា បណ្ណ មាន សុពលភាព ២៧៨ រូប និង អាជ្ញា បណ្ណ ហួស សុពលភាព ២៩ រូប និង ស្លាប់ ២រូប ។
លោក វេជ្ជបណ្ឌិត តាន់ ឆេង បាន កោតសរសើរ ចំពោះ គ្រូពេទ្យ ដែល បាន យកចិត្តទុកដាក់ ចូលរួម ក្នុង ការលើកកម្ពស់ ក្រមសីលធម៌ វិជ្ជាជីវៈ អនុវត្តន៍ បទបញ្ជា ផ្ទៃក្នុង ពង្រឹង នូវ គុណ វុឌ្ឍន៍ នៃ វិជ្ជាជីវៈ សុខាភិបាល សាធារណៈ និង ឯកជន ឱ្យ ប្រកបដោយ ប្រសិទ្ធិភាព និង សុវត្ថិភាព កាត់បន្ថយ អត្រា ស្លាប់ ពិការភាព និង គ្រោះថ្នាក់ ដោយ ការប្រើប្រាស់ ឱសថ ផ្សេង ៗ និង សេវាកម្ម ខុស ច្បាប់ ឬ គ្មាន គុណភាព ។
លោក ក៏ បាន រំលឹក ដល់ គ្រូពេទ្យ ទាំងអស់ ត្រូវ មាន ទាំង សមត្ថភាព ជំនាញ មាំ ទាំ តាម ទាន់ សម័យកាល ព្រម ជាមួយនឹង ក្រមសីលធម៌ វិជ្ជាជីវៈ ត្រឹមត្រូវ ហើយ គ្រូពេទ្យ ត្រូវ មើលឃើញ ប្រយោជន៍ របស់ អ្នកជំងឺ មុន ប្រយោជន៍ របស់ ខ្លួន និង ផ្តល់ សេវា វេជ្ជសាស្ត្រ ប្រកបដោយ ឥស្សរភាព ។
អនុប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កំពត បាន លើកឡើង ថា សុក មាលភាព ប្រជាពលរដ្ឋ ជា គុណ តម្លៃ មហាសាល របស់ អ្នក ប្រកប វិជ្ជាជីវៈ សុខាភិបាល ដ៏ មាន ប្រសិទ្ធិភាព សុវត្ថិភាព ដើម្បី ចូលរួម កាត់បន្ថយ អត្រា ស្លាប់ ពិការភាព និង អត្រា គ្រោះថ្នាក់ ដោយ ការប្រើប្រាស់ ឱសថ ផ្សេង ៗ ហើយ គ្រូពេទ្យ ត្រូវ គិត ថា « ទុក្ខលំបាក របស់ អ្នកជំងឺ គឺជា ទុក្ខលំបាក របស់ គ្រូពេទ្យ » ។
លោក បាន ស្នើ ឱ្យ អ្នក ប្រកប វិជ្ជជីវៈ សុខាភិបាល ទាំង រដ្ឋ និង ឯកជន ត្រូវ គោរព តាម គោលការណ៍ ក្រុម សីលធម៌ វិជ្ជាជីវៈ គ្រូពេទ្យ ៕ និយ័តករបរ ធន បាលកិច្ច ទទួលស្គាល់ ក្រុមហ៊ុន អ៊ែត វ៉ាន ថិច ប្រផឹធី សឺវីស ឯ . ក ជា ក្រុមហ៊ុន វាយតម្លៃ ក្នុង វិស័យ បរធន បាលកិច្ច
( ភ្នំពេញ ) ៖ ត្រឹមតែ ១ សប្តាហ៍ ប៉ុណ្ណោះ ទេវតា បាន ជប់ ទន្លេ ស្ងួត ពី ទន្លេ ដែល មាន សភាព ស្ងួត ហួត ហែង នា រដូវ ប្រាំង ទៅជា ទីកម្សាន្ត កុមារ អម ដោយ ផ្កា ស្បៃ រឿង ចម្រុះ ពណ៌ គួរ ជា ទី មនោរម្យ របស់ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិ ថ្នល់ កែង ឃុំ ព្រះធាតុ ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ ។
លោក បណ្ឌិត បាន បញ្ជាក់ ថា ពី ពេលនេះ ទៅ លែង ស្ងួត ហួត ហែង និង ស្ងប់ស្ងាត់ ទៀត ហើយ ព្រោះ យើង មាន កន្លែង កម្សាន្ត មាន ផ្លូវ រលោង ទាំងអស់ នេះ គឺជា សមិទ្ធផល របស់ រាជ រដ្ឋាភិបាល កម្ពុជា អាណត្តិ ទី៧ នែ រដ្ឋសភា ហើយ ជា កម្លាំង រួបរួម ដោយ បេះដូង ខ្មែរ របស់ យើង និង មាន ការជួយគាំទ្រ ពី សប្បុរសជន នៃ ប្រទេស កាណាដា ។ វប្បធម៌ ជួយ ដោយ សប្បុរស ត្រូវតែ បន្ត ទៅ ជាមួយគ្នា ថ្ងៃ នេះ ! សប្បុរសជន កាណាដា ជួយ យើង ថ្ងៃ ក្រោយ យើង នឹង បន្ត អំពើ សប្បុរសធម៌ នេះ ជួយ អ្នកផង ដទៃ ទៀត ។
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ចំនួន ២៨ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០២៤ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០២ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ២៨ នាក់ នោះ មាន ២០ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស គ្រឿងញៀន ១៤ករណី និង ជនសង្ស័យ ០៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មេីស ព្រហ្មទណ្ឌ ០៦ ករណី ។
សម្តេច ម៉ែន សំអន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ទិវា អន្តរជាតិ នារី ៨មីនា ឆ្នាំ ២០២៤ ខួប ទី១១៣ នៅ ក្រសួង អធិការកិច្ច
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨មីនា ឆ្នាំ ២០២៤ ខួប ទី១១៣ ក្រោម មូល បទ « ស្ត្រី និង ក្មេងស្រី ក្នុង បរិវត្តកម្ម ឌីជីថល » នៅ ក្រសួង អធិការកិច្ច ។
ដំណើរ អញ្ជើញ ដល់ អាកាសយានដ្ឋាន អន្តរជាតិ ម៉ែល ប៊ន សម្តេច ធិបតី និង លោកជំទាវ បណ្ឌិត ទទួលបាន ការស្វាគមន៍ ប្រកបដោយ ភាពកក់ក្តៅ ពីសំណាក់ លោក Tim Watts ឧបការី រដ្ឋមន្ត្រី ការបរទេស អូស្ត្រាលី និង ឯក អគ្គ រាជ ទូត ខ្មែរ ប្រចាំ នៅ អូស្ត្រាលី ។
ដោយឡែក នៅឯក សណ្ឋាគារ កន្លែង សម្តេច ធិបតី និង លោកជំទាវ បណ្ឌិត ស្នាក់ នៅឯណោះ វិញ ប្រជាពលរដ្ឋ និង និស្សិត ខ្មែរ ដែល កំពុង រស់ នៅ ធ្វើ ការ និង សិក្សា រៀនសូត្រ ក្នុង ប្រទេស អូស្ត្រាលី និង ណូវែលហ្សេឡង់ ជាច្រើន នាក់ បាន ចេញមក ទទួល និង ស្វាគមន៍ សម្តេច ធិបតី និង លោកជំទាវ បណ្ឌិត ដោយ ផ្ទាល់ ។
ប្រជាពលរដ្ឋ និង និសិត្ស ខ្មែរ បាន សម្តែង ក្តី សោមនស្ស រីករាយ ប្រកបដោយ ក្តី នឹករលឹក និង គោរព ស្រឡាញ់ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច ធិបតី និង លោកជំទាវ ។ ក្នុង ឱកាស នោះ ក្រៅពី ការបង្ហាញ ក្តី នឹករលឹក សម្តេច ធិបតី និង លោកជំទាវ បណ្ឌិត បាន អនុញ្ញាតឱ្យ ប្រជាពលរដ្ឋ បាន ថត រូប ជា អនុស្សាវរីយ៍ ប្រកបដោយ ក្តីស្និទ្ធស្នាល ជា ទីបំផុត ៕
បណ្ឌិត កៅ គឹម ហួន នឹង ដឹកនាំ គណៈប្រតិភូ ចូលរួម កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - អូស្ត្រាលី ដើម្បី អបអរ ខួប អនុស្សាវរីយ៍ ៥០ ឆ្នាំ នៃ ទំនាក់ទំនង ដៃគូ សន្ទនា អាស៊ាន - អូស្ត្រាលី
កិច្ចប្រជុំ កំពូល ពិសេស នេះ នឹង ផ្តល់ ឱកាស ឱ្យ មេដឹកនាំ បាន ពិនិត្យ ឡើងវិញ នូវ សមិទ្ធផល នៃ ទំនាក់ទំនង អាស៊ាន - អូស្ត្រាលី ក្នុង រយៈពេល ៥០ ឆ្នាំ កន្លងទៅ ព្រមទាំង ផ្លាស់ប្តូរ ទស្សន លើ បញ្ហា ពាក់ព័ន្ធ នានា សំដៅ ពង្រឹង ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - អូស្ត្រាលី ។
ក្រៅពី នេះ អគ្គ លេខាធិការ អាស៊ាន ក៏ នឹង ចូលរួម ថ្លែង ក្នុង ព្រឹត្តិការណ៍ អម មួយ ចំនួន ផងដែរ ដើម្បី ពង្រឹង ការទូត អាស៊ាន ៕ បើកបរ សូម ប្រុងប្រយ័ត្ន គ្រប់ វិនាទី ! ស្លាប់ ៨នាក់ និង របួស ១៧នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០១ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៨នាក់ និង របួស ធ្ងន់ ស្រាល ១៧នាក់ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០២៤ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៥. ៣១៦. ៧១២ នាក់ ។ ក្នុង នោះ រួម មាន៖
អាមេរិក ចង់ឱ្យ ក្រុម ប្រទេស G-7 ពន្លឿន ផែនការប្រើប្រាស់ ទ្រព្យសម្បត្តិ រុស្ស៊ី សម្រាប់ អ៊ុយក្រែន
( វ៉ាស៊ីនតោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ចូ បៃ ឌីន ចង់ឱ្យ ក្រុម ប្រទេស មាន សេដ្ឋកិច្ច លូតលាស់ ទាំង៧ (G-7) បង្កើត វឌ្ឍនភាព លើ ផែនការប្រើប្រាស់ ទ្រព្យសម្បត្តិ រដ្ឋ របស់ រុស្ស៊ី ដែល ត្រូវបាន បង្កក ដើម្បី ជួយ គាំទ្រ អ៊ុយក្រែន នៅពេល មេដឹកនាំ ក្រុម ប្រទេស នេះ ជួបប្រជុំ ក្នុង ខែមិថុនា នេះ បើ យោង តាម មនុស្ស ដែល ដឹង ពី បញ្ហា នេះ ។
ទីភ្នាក់ងារ ព័ត៌មាន Bloomberg បាន រាយការណ៍ ដោយ ដកស្រង់ ប្រភព ព័ត៌មាន ដែល និយាយ ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ នេះ ថា មន្ត្រី របស់ ក្រុម ប្រទេស G-7 បាន ពិភាក្សា អំពី ជម្រើស ក្នុង ការប្រើប្រាស់ ទ្រព្យសម្បត្តិ របស់ ធនាគារ កណ្តាល រុស្ស៊ី ដែល មាន តម្លៃ ២៨០ ពាន់ លាន ដុល្លារ រួមទាំង ការប្រើប្រាស់ ប្រាក់ នេះ ធ្វើជា វត្ថុ បញ្ចាំ ដើម្បី បោះផ្សាយ មូលបត្រ បំណុល ឬ ការចេញ លិខិត ធានា ប្រើប្រាស់ មូលនិធិ ដែល បាន បង្កក ទាំងនោះ ។
ការជជែក ដេញដោល នេះ បាន ធ្វើឡើង នៅ ពេល ដែល អ៊ុយក្រែន ប្រឈមមុខ នឹង កង្វះខាត កាំភ្លើង ធំ និង គ្រាប់ រំសេវ ដ៏ទៃ ទៀត ខណៈ ដែល ក្រុម ប្រទេស សម្ព័ន្ធមិត្តកំពុង តស៊ូ ក្នុង ការផ្គត់ផ្គង់ ឱ្យ បាន ឆាប់ រហ័ស ហើយ ជំនួយ សេដ្ឋកិច្ច ចំនួន ៦០ ពាន់ លាន ដុល្លារ នៅតែ ជាប់គាំង នៅក្នុង សភា អាមេរិក នៅឡើយ ។
យោង តាម ប្រភព ដែល បាន ដឹង ពី កិច្ចពិភាក្សា នា ពេល ថ្មី ៗ នេះ លោក បៃ ឌិន ក៏ បាន ប្រាប់ ជា លក្ខណៈ ឯកជន ដល់ ក្រុម ប្រទេស សម្ព័ន្ធមិត្ត ផងដែរ ប្រសិនបើ អ៊ុយក្រែន ចាញ់ សង្គ្រាម គាត់ ជឿ ថា សណ្តាប់ធ្នាប់ អន្តរជាតិ នឹង ចលាចល យ៉ាងហោចណាស់ ក្នុង រយៈពេល ប្រាំ ទសវត្សរ៍ ខាងមុខ ។
ក្រុម ប្រទេស សម្ព័ន្ធមិត្ត ទាំងអស់ យល់ស្រប ថា មូលនិធិ ទាំងនេះ មិន គួរ ស្ថិត ក្រោម ការគ្រប់គ្រង របស់ ប្រទេស រុស្ស៊ី ឡើយ លុះត្រាតែ ប្រទេស នេះ សន្យា ថា នឹង ជួយ ដល់ ការកសាង អ៊ុយក្រែន ឡើងវិញ ប៉ុន្តែ ក្រុម សម្ព័ន្ធមិត្ត នៅ មាន ការខ្វែងគំនិត គ្នា លើ បញ្ហា ថា តើ នឹង មាន ច្បាប់ រឹបអូស យក ទ្រព្យ ស្បត្តិ ទាំងនោះ ទាំងស្រុង ដែរ ឬ យ៉ាណា ។ មេដឹកនាំ របស់ ក្រុម ប្រទេស G-7 គ្រោង នឹង ជួប នៅ ប្រទេស អ៊ីតាលី ក្នុង ខែមិថុនា ឆ្នាំ នេះ ។
ប្រភព ដដែល បាន ប្រាប់ Bloomberg ថា លោក បៃ ឌិន ចង់ ឃើញ ទ្រព្យសម្បត្តិ ដែល រក ការបង្កក ទាំងនោះ ត្រូវបាន យក ទៅ ប្រើប្រាស់ ដើម្បី ជួយ ផ្តល់ មូលនិធិ ដល់ តម្រូវការ ថវិកា របស់ អ៊ុយក្រែន ហើយ ក្រោយមក ឆ្ពោះ ទៅរក ការកសាង ប្រទេស អ៊ុយក្រែន ឡើងវិញ ៕
វិភាគ អន្តរជា តិ៖ ហេតុ អ្វី គ្រូពេទ្យ កម្មសិក្សា នៅ កូរ៉េ ខាងត្បូង នាំគ្នា ឈប់ ធ្វើ ការ ?
( សេអ៊ូល ) ៖ ការវះកាត់ ត្រូវបាន លើក ពេល ការណាត់ជួប គ្រូពេទ្យ ត្រូវបាន លុបចោល រីឯ អ្នកជំងឺ ត្រូវបាន យក ចេញ ពី បន្ទប់ សង្រ្គោះ បន្ទាន់ ។ ទាំង នេះ គឺជា ស្ថានការណ៍ ដែល កំពុង កើតឡើង អស់ រយៈពេល លើស មួយ សប្ដាហ៍ មកហើយ នៅ តាម មន្ទីរពេទ្យ ធំ ៗ ក្នុង ប្រទេស កូរ៉េ ខាងត្បូង ដោយសារ ក្រុម គ្រូពេទ្យ កម្មសិក្សា រាប់ ពាន់ នាក់ បាន នាំគ្នា ឈប់ ធ្វើការ ។ ការពន្យារ ពេល ចូល ធ្វើ ការ វិញ របស់ ក្រុម គ្រូពេទ្យ ទាំង នេះ ត្រូវបាន ព្រមាន ថា អាចនឹង បង្ក ផលវិបាក យ៉ាង ធ្ងន់ធ្ងរ ។
ប៉ុន្តែ ក្រុម គ្រូពេទ្យ បាន អះអាង ថា ការបង្កើន ចំនួន និស្សិត ពេទ្យ មិន មែន ជា ដំណោះស្រាយ សម្រាប់ បញ្ហា សព្វ ថ្ងៃ នោះ ទេ ។ កាលពី ឆ្នាំ ២០២០ ផែនការបង្កើន ចំនួន និស្សិត ពេទ្យ របស់ អតីត ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ចែ អ៉ីន ក៏ ធ្លាប់ បាន ជំរុញ គ្រូពេទ្យ ធ្វើ កូដកម្ម មិន ចូល ធ្វើ ការ ដែរ ហើយ នៅ ទីបញ្ចប់ រដ្ឋាភិបាល របស់ លោក មូន បាន បោះចោល ផែនការ នេះ ។
ប្រកាស ចូលកាន់ តំណែង មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក ព្រៃឈរ . មេបញ្ជាការ អាវុធហត្ថ ខេត្ត ណែនាំឲ្យ បន្ដ ប្រឹងប្រែង អនុវត្ត តួនាទី ភារកិច្ច សំដៅ រក្សា សន្ដិសុខ សុវត្ថិភាព ជូន ពលរដ្ឋ
( កំពង់ចាម ) ៖ នៅ រសៀល ថ្ងៃទី ០១ ខែមីនា ឆ្នាំ ២០២៤ នេះ លោក ឧត្តមសេនីយ៍ ត្រី សោ សាវឿន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ចាម . លោក ប្រធាន ក្រុមប្រឹក្សា ព្រៃ ឈរ និង លោក អភិបាល ស្រុក ព្រៃឈរ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស តែងតាំង ផ្លាស់ប្តូរ មុខតំណែង មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ស្រុក ព្រៃឈរ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី មេបញ្ជាការ រង នាយ សេនាធិការ នាយ សេនាធិការ រង ប្រធាន មន្ទីរ មេបញ្ជាការ មូលដ្ឋាន ស្រុក ស្នាក់ការសន្តិសុខ អភិបាល រង ស្រុក នាយក រដ្ឋបាល ស្រុក អធិការ នគរបាល ក្រុង មេបញ្ជាការ ផ្នែក សឹក រង ស្រុក មេឃុំ មេ បុស្តិ៍ ព្រមទាំង មន្រ្តី រាជការ ជុំវិញ ស្រុក ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ត្រី សោ សាវឿន បាន ក្រើន រំលឹក និង ដាក់ បទបញ្ជា ដល់ កម្លាំង អាវុធហត្ថ ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង បង្ក្រាប និង ទប់ស្កាត់ នូវ រាល់ បទល្មើស គ្រប់ ប្រភេទ ពិសេស បទល្មើស ល្បែង ស៉ី សង ខុស ច្បាប់ គ្រប់ ប្រភេទ ឲ្យ អស់ ពី មូលដ្ឋាន តាម អនុសាសន៍ ដ៏ ម៉ឺងម៉ាត់ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
បន្ថែម ពី នេះ លោក ឧត្តមសេនីយ៍ ត្រី មេបញ្ជាការ បាន ណែនាំឲ្យ រក្សា សាមគ្គីភាព ផ្ទៃក្នុង អង្គភាព និង ពង្រឹង កិច្ចសហការ ជាមួយ បណ្ដាញ ស្ថាប័ន ពាក់ព័ន្ធ សំដៅ រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ៕ អគ្គិភ័យ ឆេះ រោងចក្រ មួយ កន្លែង នៅ ស្រុក ស្អាង ខេត្ត កណ្ដាល . សមត្ថកិច្ច ប្រើប្រាស់ ទឹក អស់ ២៣ឡាន ទើប គ្រប់គ្រង បាន ទាំងស្រុង
ក្រោយ ទទួល ព័ត៌មាន នេះ កម្លាំង សមត្ថកិច្ច របស់ ខេត្ត កណ្ដាល ដឹកនាំ ដោយ លោក ហាក់ សុខ មករា អភិបាល រង ខេត្ត លោក ណុប ដារ៉ា អភិបាល រង ខេត្ត និង លោក ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត ស្នងការ នគរបាល ខេត្ត សហការ ជាមួយ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្ដរាយ ដឹកនាំ ដោយ លោក គឹម វីរៈ អគ្គ លេខាធិការ ចេញ អន្ដរាគមន៍ ដើម្បី ជួយសង្គ្រោះ ។
យោង តាម របាយការណ៍ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ឲ្យដឹង ថា ក្នុង ប្រតិបត្តិការ នេះ កម្លាំង សមត្ថកិច្ច ប្រើប្រាស់ រថយន្ដ ពន្លត់ អគ្គិភ័យ ចំនួន ១៣ គ្រឿង និង ទឹក អស់ ចំនួន ២៣ឡាន ក្នុង នោះ រួម មាន រថយន្ដ នាយកដ្ឋាន បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ ចំនួន ៣គ្រឿង . ស្នងការដ្ឋាន នគរបាល ខេត្ត ចំនួន ៣គ្រឿង . គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ ចំនួន ៣គ្រឿង . ក្រុង ស្រុក ៤គ្រឿង ( ស្អាង . កោះ ធំ . កណ្តាល ស្ទឹង និង កៀន ស្វាយ ) និង រថយន្ដ ដឹក សម្ភារៈ ចំនួន ២គ្រឿង ។
សេចក្ដីរាយការណ៍ បាន បញ្ជាក់ ថា ដើម ចម ដែល នាំ ដោយ មាន គ្រោះថ្នាក់ សង្គម មួយ នេះ បណ្ដាល មកពី ឆ្លង ចរន្ដ អគ្គិសនី ។ ប៉ុន្ដែ ទោះជា យ៉ាងណា ក្នុង ហេតុការណ៍ នេះ មិន បណ្ដាលឲ្យ មនុស្ស ណា ម្នាក់ រងគ្រោះថ្នាក់ នោះ ឡើយ ៕
( ភ្នំពេញ ) ៖ ដោយ អនុវត្ត តាម បទបញ្ជា លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២៤ កម្លាំង ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ប៊ុន សត្យា ស្នងការ រង ទទួល ផែនការងារ នគរបាល ព្រហ្មទណ្ឌ និង លោក ឧត្តមសេនីយ៍ ទោ លី ប៊ុន អេង ស្នងការ រង ទទួល ដឹកនាំ ការិយាល័យ សហការ ជាមួយ កម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ ដង្កោ បាន ស្រាវជ្រាវ ឃាត់ខ្លួន ជនសង្ស័យ បន្តបន្ទាប់ ចំនួន ៦នាក់ ពាក់ព័ន្ធ អំពើ ប្លន់ ៣ករណី ។
បច្ចុប្បន្ន ជនសង្ស័យ វត្ថុតាង ជា មធ្យោបាយ ជិះ ធ្វើ សកម្មភាព និង ម៉ូតូ ជា របស់ ជនរងគ្រោះ ដែល ចាប់ យក បាន ខាងលើ កម្លាំង ការិយាល័យ កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម នីតិវិធី ៕
សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ឆ្នាំ ២០២៤ របស់ សាខា សមាគម នារី និង ក្រុម ចលនា ស្ត្រី ខេត្ត ពោធិ៍សាត់
