បើ តាម ជំនឿ អាពាហ៍ពិពាហ៍ ខ្មោច អ្នក ដែល ស្លាប់ ដោយ មិន ទាន់ បាន រៀបការ នោះ ព្រលឹង គេ មិន អាច ទៅ រស់ នៅ ជាមួយ ដូនតា ពួកគេ បាន ឡើយ
នាង បាន និយាយ ថា ខ្ញុំ មាន កូន ពីរ នាក់ នៅ ផ្ទះ ដូច្នេះ ច្បាស់ជា ខ្លាច និង ព្រួយបារម្ភ ។
ជាច្រើន ទៀត ដូចជា លោក សុះ ម៉ាច ជាដើម ។
ទៀត ចេញមក រសារភាព ដោយ កុំ មាន ការភ័យខ្លាច ។
រូបថត នេះ បង្ហាញ ឱ្យ ឃើញ ពី ផ្ទៃ មុខ ពិត របស់ តារា កូរ៉េ ដែល ជា តារា ក្នុង ដួងចិត្ត អ្នក
ក្រុម មន្ត្រី សន្តិសុខ ក៏ បាន កត់សម្គាល់ អំពី កង្វល់ ស្តីពី គ្រឿងផ្ទុះ បង្កប់ នៅក្នុង កន្លែង បូម ប្រេង នេះ ដែរ ។
សមត្ថកិច្ច បាន នាំយក ទាំង ម៉ូតូ និង រថយន្ត មក រក្សាទុក ដើម្បី រង់ចាំ ការដោះស្រាយ នៅ ពេល ក្រោយ ៕
តែ មួយ ប៉ប្រិច ភ្នែក សោះ លេប ត្របាក់ អស់សល់ …
ធ្វើឱ្យ ប្រជាពលរដ្ឋ មាន ជំនឿ ទុកចិត្ត ចំពោះ អាជ្ញាធរ ៕
ចំណុច ទាំងអស់ នេះ អាចនឹង បង្កើត ឱ្យ មាន ស្ថិរភាព សម្រាប់ ពលករ និង សម្រាប់ ប្រព័ន្ធ ទាំងមូល ៕
លោក ត្រាំ សង្កត់ធ្ងន់ ថា លោក ពិតជា ចាប់អារម្មណ៍ ខ្លាំង ណាស់ ចំពោះ កិច្ចប្រជុំ ជាមួយ លោក គីម និង សង្ឃឹម អាច ធ្វើ បាន ល្អ ។
ខ្ញុំ គិត ថា គ្រប់ គ្នា អន្ទះសា ជាពិសេស ជាមួយ ខ្ញុំ និង កាលវិភាគ របស់ ខ្ញុំ ។
លក់ ឧបករណ៍ បង្វែរ ស៊ុត ដោយ ស្វ័យប្រវត្តិ
ជា រឿង យង់ឃ្នង ខ្លាំង ណាស់ ដែល ចាប់ ពួកគាត់ ដាក់ ពន្ធនាគារ យ៉ាង ដូច្នេះ ។
អាពាហ៍ពិពាហ៍ ជា រឿង មួយ សំខាន់ ប៉ុន្តែ អ្វី ដែល សំខាន់ ជាង នេះ ទៅ ទៀត នោះ គឺ ជីវិត ក្រោយ អាពាហ៍ពិពាហ៍ ។
យើង ទន្ទឹងរង់ចាំ មើល នូវ ការ កើនឡើង នូវ ពាណិជ្ជកម្ម ទំនាក់ទំនង កាន់តែ ប្រសើរឡើង ក្នុង វិស័យ នេះ ព្រមទាំង ឱកាស វិនិយោគ ថ្មី ៗ
ទំព័រ ដើម សេដ្ឋកិច្ច អប់រំ អាន គំនិត សំខាន់ ៗ
ប្រទេស ចិន និង រុស្ស៊ី គឺជា ទីពឹង របស់ ប្រទេស កូរ៉េ ខាងជើង នៅ ពិភព ខាងក្រៅ ។
ប៉ុន្តែ កម្មករ ចង់ឱ្យ ក្រុមហ៊ុន ទទួលយក ទាំង ៤ចំណុច ។
ដំណើរ បោះ តង់ កម្សាន្ត នៅលើ ភ្នំ ត្រង៉ោល កំពុង ពេញនិយម !
នឹង បរាជ័យ ដែរ ។
សូម បញ្ជាក់ ឱ្យដឹង ផងដែរ ថា ដំណើរទស្សនៈកិច្ច របស់ ក្រុម គណៈប្រតិភូ អង្គការ សហ ប្រជាជាតិ នេះ គឺជា លើក ទី២ហើយ នៅលើ ទឹកដី កម្ពុជា ។
វា ជា ការត្រឹមត្រូវ ណាស់ ដែល ក្មេង ៗ
ខ្ញុំ សង្រួម ល្អ ក្នុង បាតិ មោក្ខ ផង ក្នុង ឥន្ទ្រិយ ទាំង ៥ផង ប្រកបរឿយ ៗ
ខ្សែ បម្រើ ជនជាតិ បារាំង ទាំង ពីរ នាក់ សុទ្ធតែ កំពុង នៅក្នុង ស្ថានភាព រត់ ចោល ក្លិប ក្នុង រដូវកាល នេះ ។
ចាប់ពី ស្អែក នេះ អាច មាន ភ្លៀង ធ្លាក់ ផ្គរ រន្ទះ ផងដែរ …
សួស្តី ប្រិយមិត្ត ដែល តែងតែ ទស្សនា ប្លក យុវជន ទាំងអស់ ក្នុង ប៉ុន្មាន អាទិត្យ នេះ ខ្ញុំ មិន ដែល សូវ បាន សរសេរ ប្រកាស អ្វី សោះ ជាពិសេស ទៅ ទៀត ប្លក មួយ នេះ ហាក់បីដូចជា សរសេរ ច្រើន តែ អំពី ផ្នែក ខាង កុំព្យូរ ទ័រ ។
យើង បាន ដឹង អំពី ពាក្យ ចចាមអារ៉ាម ដែល កំពុង ចរាចរ ។
មាន អារម្មណ៍ ថា សប្បាយ ហើយ សង្ឃឹម ថា ឈ្នះ ។
កាលបរិច្ឆេទ បញ្ចប់ ដែល បាន គ្រោង ទុក បាន មកពី ពេលណា ។
ពួកគាត់ បាន ឆ្លង ដែន
លោក ត្រុង បាន បន្ត ទៀត ថា គ្រួសារ វៀតណាម មាន ទាំងអស់ ៥៤ ជនជាតិ ក្នុង នោះ មាន ខ្មែរ
ចំពោះ អ្នក ជាប់ ឃុំ ស្ត្រី វិញ ត្រូវ អ្នកយាម ចាប់រំលោក ធ្វើបាប ។
សម្តេច តេជោ បាន មានប្រសាសន៍ បញ្ជាក់ ថា ខ្ញុំ សូម និយាយ ដោយ ច្បាស់ ៗ
សវនាការ គ្រោង នឹង ធ្វើឡើង នៅ ថ្ងៃទី ២៦ ខែមិថុនា ។
ចេះតែ ខ្លាច ដែរ ហ្នឹង ណា
ជនជាតិ បារាំង មួយ គូតុបតែង ខ្លួន បុរាណ ខ្មែរ ពិតជា ស្រស់ស្អាត ណាស់ តារា ញូស៍
ប្រាកដ ណាស់ ប្រិយមិត្ត ខ្លះ បាន ញ៉ាំ ហើយ ខ្លះ ទៅ ថា មិន ដែរ បាន ញ៉ាំ ទេ តែ មិន ថ្ងៃ នេះ ប្រិយមិត្ត នឹង ចាប់ផ្តើម រក វា ញ៉ាំ បន្ទាប់ពី ដឹង ពី អត្ថប្រយោជន៍ របស់ វា ។
ប៉ុន្តែ មាន គ្រួសារ ខ្លះ ការ ទាំងអស់ នេះ ទៅជា ផ្ទុយទៅវិញ ។
នឹង ទាក់ទង នឹង ដៃគូ ភ្លាម ដើម្បី ដោះស្រាយ ឱ្យ គាត់ ណាស់ !
សុទ្ធតែ មិន ទាន់ ធ្លាប់ បាន ដឹង របៀប កាន់ ពូ ថៅ ម្តងម្កាល ណា ទេ ។
មួយ ភាគ បួន នៃ កុមារ គ្រប់ អាយុ ចូលរៀន នៅលើ ពិភពលោក ចំនួន ប្រហែល ៣៣១ លាន នាក់ កំពុង រស់ នៅក្នុង តំបន់ អាស៊ី បូព៌ា និង ប៉ាស៊ីហ្វ៊ិក ។
ក្នុង ខ្លី ប វីដេអូ ដែល ជា ភ័ស្ត តាង ចុងក្រោយ មុនពេល នាង បាត់ខ្លួន ទៅ នោះ គឺ អេលី សាឡាម បាន បង្ហាញ នូវ អាកប្បកិរិយា ប្លែក ៗ
អ្នកតស៊ូ មាន តែ ទុក្ខ ជួប តែ សេចក្តីក្រអត់ឃ្លាន គ្មាន ពេល សប្បាយ រឺ ពេល ទំ
តែ ងាយ យល់ ជា សូត្រ ស្តីពី ការរស់នៅ ដ៏ ប្រសើរ នៅក្នុង សង្គម មនុស្ស ។
សូម មេត្តា ទាមទារ នូវ កុងត្រា និង ពិនិត្យ ជាលំអិត នូវ ផលប្រយោជន៏ ពិតប្រាកដ នៃ វិនិយោគ នេះ ។
លំហាត់ប្រាណ ទៀងទាត់ ជួយ អ្នក អោយ ដុត កាឡូរី បាន លឿន ទោះបីជា អ្នក នៅ អង្គុយ មួយ កន្លែង ក៏ដោយ ។
ទោះជា យ៉ាងណា វា ជា ការពិត មួយ គួរឱ្យ ញាក់ សាច់ ដែល បាន កើតឡើង កាលពី ពេល ថ្មី ៗ
វីដេអូ ស៊ើបអង្កេត របស់ អ្នកកាសែត វៀតណាម ៖
ខ្ទឹម ស ដំ៣កំពឹស
ក្រុម មន្ត្រី ចិន មិន បាន ធ្វើ អត្ថាធិប្បាយ អំពី ឧបទ្ទវហេតុ នេះ ទេ ៕
មេដឹកនាំ ខ្មែរ ត្រូវ មាន សីល ៥ ក្នុង ខ្លួន ។
និន្នាការ នេះ បាន កើនឡើង ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ពីព្រោះ ពួកគេ គិត ថា ធ្វើការ ដើម្បី ខ្លួន ឯង នឹង ជួយ ពួកគេ ឱ្យ ក្លាយជា អ្នក មាន យ៉ាង ឆាប់រហ័ស ។
ឯកឧត្តម ចម ប្រសិទ្ធ បាន បន្ត ទៀត ថា បច្ចុប្បន្ន ប្រទេស កម្ពុជា បាន ទទួល ការបណ្តាក់ទុន បន្ថែម ពី ប្រទេស ។
រើរ ផ្ទះ ឡៃ ឡុង
ព្រមទាំង ទទួល អំណោយទាន សំរាប់ ចែក ឱ្យ ដល់ មនុស្ស
រូប អញ្ញាណ សូត្រ ទី១
ថ្ងៃទី១ ដែល ក្រុម មិត្ត ៗ
អា នេះ វត្ត ម៉ែ ហ្អែង អ្នក ធើ អាត្រូវ គ្រាប់ អាច្រវាក់ ។
លោក បាន ចុះហត្ថលេខា លើ ការកសាង ជញ្ជាំង ព្រំដែន ភ្លាម ។
៤. រៀប គម្រោង សម្រាប់ ថ្ងៃស្អែក
ជ្រៅ ខ្លាច ពិបាក ។
