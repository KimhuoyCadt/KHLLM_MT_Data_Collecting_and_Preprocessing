កម្មវិធី នេះ នឹង អាច ងើប ឡើងវិញ ទិន្នន័យ ណាមួយ ទេ ប្រសិនបើ ខ្ញុំ មិន បាន ដឹង ពាក្យ សម្ងាត់ នោះ ?
មន្ត្រី ក្រសួង ការបរទេស អាមេរិក ម្នាក់ ក៏ បាន អះអាង ថា អាច មាន សង្ឃឹម តែ អ្វី ៗ
រីឯ ពលរដ្ឋ មិន ពុំ មាន ទទួល មួក ក៏ គួរ ចំណាយ ថវិកា ផ្ទាល់ខ្លួន ទិញ វា ដើម្បី សុវត្ថិភាព ។
ជាពិសេស ជំងឺ នេះ ភាគ ច្រើន កើតឡើង ចំពោះ ស្ត្រី វ័យ ក្មេង ខណៈពេល ដែល មក រដូវ រួច ។
សូម បញ្ជាក់ ថា បើ តាម គម្រោង នៅក្នុង ឆ្នាំ នេះ មាន ក្រុមហ៊ុន ផ្សារទំនើប ធំ ៗ
សូម ស្តាប់ ការអធិប្បាយ ពី ចេន សុជាតា ៖
កោះ ថ្មី មាតិកា អក្សរសាស្ត្រ ប្រលោមលោក សុំទោស ដែល ធ្វើឱ្យ បងប្អូន …
កំដៅ នៃ ច្បាប់ របស់ ជូលីការអនុវត្ត លំហាត់
គ្នា នៃ បេក្ខជន ដែល ឈរឈ្មោះ ក៏ ដូចជា សកម្មជន ដែល ត្រូវ ហែរ ក្បូន ឬ ការជួបជុំ ។
ភ្ញៀវ ប្រចាំ ថ្ងៃ លោក វង់ សុធារ៉ា ៖
យកមក សុទ្ធតែ ជនជាតិ យួន យកមក ទាំង កាំភ្លើង ទៀត ដូច្នេះ សហគមន៍ ហ្នឹង ចាប់ ។
រដ្ឋបាល ខណ្ឌ ទាំង ១២បញ្ចេញ កម្លាំង និង រថយន្ត ប្រ…
ប៉ុន្តែ សួរ ថា តើ យន្តហោះ នៃ ក្រុមហ៊ុន អាកាសចរណ៍ ម៉ាឡេស៊ី អ៊ែរ ឡាញ មួយ នេះ ទាំងមូល កំពុង ស្ថិត នៅ ទីណា នោះ គ្មាន នរណា ម្នាក់ ហ៊ាន អះអាង ឡើយ ៕
លោក ត្រាំ បញ្ជាក់ ថា រឿង តែ មួយ គត់ ដែល អាមេរិក នឹង ត្រូវ ធ្វើ ជាមួយ កូរ៉េ ខាងជើង
គឺ យ៉ាង ដូច្នេះហើយ បានជា អ្នកស្រុក ខ្លះ និយាយ ថា អ្នកតា កើត ពី អាចម៍ ឆ្កែ !
ខ្ញុំ គិត ថា នេះ ជា ចំណែក មួយ នៃ មូលហេតុ ដែល ធ្វើឱ្យ អង់គ្លេស ចាកចេញ ពី សហភាព អឺរ៉ុប ។
ការធ្វើឱ្យ ជន ស៊ីវិល ដាច់ ពោះ ស្លាប់ នៅក្នុង ប្រទេស ស៊ីរី អាច ជា បទឧក្រិដ្ឋកម្ម សង្គ្រាម
វា មិន ប្រើ ពេល យូរ ទេ ប៉ុន្តែ ១៥នាទី គឺជា ស្តង់ដារ នៅក្នុង ពិភពលោក ។
ឃើញ មួយ ឬ ពីរ ក្រុម ប៉ុណ្ណោះ ក្នុង មួយ សប្តាហ៍ ។
រឿង នេះ ត្រូវបាន ប្រាប់ ដោយ លោកគ្រូ សេដ្ឋកិច្ច របស់ ខ្ញុំ ហើយ គាត់ ប្រាប់ ថា ជា រឿង ពិត ក្នុង អំឡុង ពេល ១ ។
មាតិកា គេហទំព័រ អាច មិន បង្ហាញ បាន ត្រឹមត្រូវ ។
ការផ្អាក ផលិត នេះ នឹង ត្រូវ ចាប់ផ្តើម ពី ដើម ខែមករា ឆ្នាំ ថ្មី នេះ តែម្តង ។
យើង ជួយ បាន ប្រហែល តែ ៣០ ភាគរយ ទេ នៃ តម្រូវការ របស់ ប្រជាជន យើង ។
គួរ រំលឹក ផងដែរ ថា កាលពី ខែវិច្ឆិកា ឆ្នាំ មុន វីដេអូ របស់ ទេសចរ បរទេស មួយ រូប ដែល បង្ហាញ ពី ការនិយាយ ជាច្រើន ភាសា របស់ សាលី បាន ក្លាយជា វីដេអូ ដែល ល្បី លើ បណ្តាញ សង្គម ។
តែ ទោះជា យ៉ាង លោក មិន បាន ចុះហត្ថលេខា ព្រមព្រៀង ទេ ព្រោះ ប្រជាពលរដ្ឋ រាប់ រយ គ្រួសារ កំពុងតែ អាស្រ័យ ផល លើ បឹង នេះ ។
ថើប បែប នេះ ទន់ភ្លន់ តែ ខ្ញុំ អត់ មាន អ្នកសាក ផង ។
ខ្ញុំ ពិតជា ស្រលាញ់ កូន ខ្ញុំ ខ្លាំង ណាស់ មនោរម្យ . អាំង ហ្វូ
របស់ លោក អង់តុន ឆេកូហ្វ ឆេកូហ្វ អង់តុន
នឹង មិន គ្រប លើ ចំណែក នៃ មនុស្ស សុចរិត ឡើយ
ដោយឡែក ប្រទេស ជប៉ុន ដែល ប្រជាជន ទូទៅ និយម ផឹក ភេសជ្ជៈ ផ្អែម ៗ
ក្បាច់ ជជាយ ទី៤
បន្ទាប់មក អ្នកបើក ម៉ូតូ បាន ចាកចេញ ទៅ បាត់ ហើយ ភ្លាម ៗ
សូម អោយ យើង ធ្លាក់ ក្នុង កណ្តាប់ដៃ របស់ ព្រះអម្ចាស់ ជាជាង ធ្លាក់ ក្នុង កណ្តាប់ដៃ របស់ មនុស្ស ដ្បិត ព្រះអង្គ មាន ព្រះហឫទ័យ មេត្តា ករុណា ដ៏ ធំធេង ។
ទំព័រ ដើម ប្រៀបធៀប
អង់គ្លេស គុណ នាម និយាយ ភាសាមន និយាយ មន
គឺ បណ្តាល មកពី ការគិត ទាំង ១១យ៉ាង នេះ ៖
ដោយៈ មិត្ត អ្នកអាន
វិស្សមកាល រដូវ រងា ជិត មកដល់ ហើយ ចំពោះ រូប ខ្ញុំ ក៏ កៀក នឹង ថ្ងៃ ធ្វើ មាតុភូមិ និវត្តន៍ ហើយ ដែរ ព្រោះ រដូវ រងា បី ឆ្នាំ បាន កន្លងផុត ទៅ ហើយ ។
អនុប្រធាន ការិយាល័យ ចំនួន ០៣ រូប
លោក កឹម សុខា អតីត ប្រធាន គណបក្ស សង្គ្រោះ ជាតិ ។
អាមេរិក ទម្លាយ រឿង សម្ងាត់ ៖
ពិសេស នោះ ដែរ សម្តេច តេជោ បាន មានប្រសាសន៍ ដោយ ព្រមាន ធ្ងន់ ៗ
ការ៉ូលីណា ព្រីដ គ្រង មកុដ បវរកញ្ញា ប៉ាណា ម៉ា ឆ្នាំ ២០១៣
មាន ពិន្ទុ គ្រាប់ បាល់ នាំមុខ កាលពី ជើង ទី១ រួច មកហើយ ។
លោក អនុ សេនីយ៍ ត្រី ជយបរដ្ឋា ៖
បុគល គថ្តលប សំរ
មក ធ្វើអោយ មនុស្ស ប្រភេទ នេះ មាន ដំណែង រាង ខ្ពស់ គ្រាន់បើ ទៅ ហើយ ទោះជា អាយុ មិន ទាន់ ៣០ក្តី ។
បើ និយាយ ឱ្យ ចំ ទៅក្នុង រយៈពេល ៧ឆ្នាំ កន្លងមក ការប្រើប្រាស់ ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម មាន ការកើនឡើង ៣៦៥ ភាគរយ ។
កន្លងមក នាង បាន បង្ហាញ រាងកាយ សិចស៊ី ក្នុង ឈុត ហែលទឹក
សមាជិក ក្រុម គោ ព្រៃ កម្ពុជា ចេញ ទៅ ហុងកុង នៅ យប់ នេះ
បញ្ហា ទី២បាន ច្រាន ខ្ញុំ ពី ខាងក្រោយ ។
ទៀត ទឹក ជូត ការ៉ូដប តូច
របៀប ធ្វើ ឆា ក្តាម សេះ
ថ្វីបើ គាត់ ឈឺ ដែរ លោក តា គាត់ ខំប្រឹង ថែទាំ លោកយាយ ណាស់ ។
ប៉ុន្តែ យឹម សាវី បាន បញ្ជាក់ ថា សាលាក្រុង ភ្នំពេញ គ្មាន គំរោង សាកសួរ ឯក អគ្គ រដ្ឋទូត អាមេរិក អំពី បញ្ហា នេះ ទេ ។
ពួកគេ ទាំងនោះ បាន គ្រប់គ្រង ក្រុមហ៊ុន ដែល ធ្វើ ការដាក់ ទុន ទៅ លើ វិស័យ ដ៏ សំខាន់ ៗ
ដ៏ កម្រ ដែល អាច ឱ្យ ភ្ញៀវ ទេសចរណ៍ ជាតិ និង អន្តរជាតិ
ក្រោយមក លោក មិន បាន ទៅ សុំហត្ថលេខា ពី អ្នកស្រី ឡោក ខេង ម្តង ទៀត ឡើយ ប៉ុន្តែ បាន សម្រេចចិត្ត ប្តឹង អ្នកស្រី ទៅ តុលាការ តែម្តង ។
សាក ទៅ ហូលីដេអូរឫស្សី អី ម្តង មើល ខ្វះ អី កន្លែង !
ក្មេងស្រី អាយុ១០ ឆ្នាំ ប្រើ ធ្នូ ប្រមាញ់ ក្រពាប្រវែង ជិត ៤ម៉ែត្រ
ពិភពលោក កំពុង បោះជំហាន យ៉ាង ចម្បង ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ភាព ភាពក្រីក្រ សកល ។
នៅលើ ទីផ្សារ សព្វ ថ្ងៃ នេះ មាន គេហទំព័រ ភ្នាល់ កីឡា តាម អ៊ិនធឺរណែត ជាច្រើន ។
ក្រុង ស្រុក ខណ្ឌ ថ្មី ៖
យើង គ្រប់ គ្នា ដឹង ហើយ ថា បើ ខ្វះ ជាតិ ស័ង្កសី នោះ វា អាចនឹង បណ្តាលឱ្យ មាន បញ្ហា សក់ ជ្រុះ កើតឡើង បាន ។
យើង ត្រូវ ចេះ ជួយ ជ្រោង គ្នា ឡើង សាស្តា ៤៩១២ ។
