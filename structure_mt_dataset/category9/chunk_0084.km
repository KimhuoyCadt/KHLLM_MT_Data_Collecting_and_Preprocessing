« ព្រោះបើយើងភ្លេច យើងអនុញ្ញាតឲ្យវាកើតឡើងក្នុងសហគមន៍របស់យើង » ។
លោក ធ្លាប់ ជា សមាជិក សភា និង ជា រដ្ឋមន្ត្រី ។
នេះគឺដូចជាត្រូវបានចាក់ចូលក្នុងវៀនជាមួយនឹងដុំទឹកកកដ៏ អស្ចារ្យបំផុត ។
យ៉ាងណាមិញ ការពិត គឺ អំពី ការទទួលបាន ស្ត្រី ដែល អ្នក ត្រូវការ ។
ក្នុងចំណោមប្រទេសជិតខាងរបស់ឥណ្ឌា ចិនមានគោល លទ្ធិស្រដៀងគ្នានេះដែរ ប៉ុន្តែប៉ាគីស្ថានមិនមាន ។
ហើយក្នុង ន័យនេះ ពួកគេពិតជាមានរោគ សញ្ញាពីអ្នក ដទៃក្នុងប្រទេសអាល្លឺម៉ង់សព្វថ្ងៃនេះ » ។
ហើយគ្មាននរណាស្គាល់ប្អូនប្រុសរបស់គាត់ឡើយ ។
នៅ ពេល ដែល គាត់ ចាប់ផ្តើម គាត់ មិន ដឹង ថា ពេលណា ត្រូវ ឈប់ នៅក្រោម ការដឹកនាំ របស់ គាត់ ទេ ។
ក្រៅពី វត្ថុ ទាំងនេះ យើង អាច មើលឃើញ សូរ្យ គ្រាស ។
“ ពួកគេ កំពុង ឆ្ពោះទៅ មុខ ជានិច្ច ដូច្នេះ វា នឹង ពឹងផ្អែក ខ្លាំង ទៅ លើ នីមួយ ៗ
អាទិទេព ធំ ជាង គឺជា ឋានន្តរស័ក្តិ ដ៏ មាន ឥទ្ធិពល បំផុត ដែល ត្រូវបាន បូជា ដោយ សត្វ តិរច្ឆាន ។
ទ្រព្យសម្បត្តិ នេះ ត្រូវបាន បំពាក់ ដោយ គ្រឿង បរិក្ខារ ពេញលេញ និង អាច ផ្ដាច់ បាន ទាំងស្រុង ។
យើងប្រឆាំងនឹងអ្វីដែលផ្ទុយនឹង បទគម្ពីរ ។
សញ្ញា អាថ៌កំបាំង និង គួរឱ្យ ភ្ញាក់ផ្អើល នៅ ទីនោះ ។
យល់ថាក្រុងយេរូសាឡឹម ជាទីក្រុងមួយដែលពួកគេអាចចូលរួម
ប៉ុន្តែនាងក៏រំឮ ក ពីការ ឈឺចាប់ និងការ បាត់ បង់ជីវិតរបស់ម្តាយនាងផងដែរ ។
យើង ពិតជា ត្រូវ ហៅ សន្តិសុខ សម្រាប់ កិច្ចប្រជុំ ។
អ្នក អាច បរិច្ចាគ ទៅ សហរដ្ឋ អាមេរិក
ផ្លូវ ចេញ ពី ក្រុង យេរូសាឡឹម ។
គាត់បានការពារព្រះបន្ទូលដោយ ក្លាហាន — ខ ១៧
ខ្ញុំនឹងតាម ដាននាង កុំ បារម្ភ ។
ផ្ទុយទៅវិញ វា នឹង ត្រូវបាន រកឃើញ នៅក្នុង វឌ្ឍនភាព នៃ ការប្រមូល ។
វិវរណៈ ២០: ៧- ១០ ហើយពេលមួយពាន់ឆ្នាំត្រូវផុតកំណត់ នោះសាតាំងនឹងត្រូវបានដោះចេញពីគុករបស់វា ...
កោស ផ្នែក ខាងក្រោម រវាង ការលាយ ។
អ្នកអាចសន្សំប្រាក់បានច្រើនដោយទិញអាហារដែលផ្តល់សុខភាព ប៉ុន្តែមិនមាន ន័យថាវាងាយស្រួលនោះទេ ។
ក្រុមហ៊ុន ដី ត្រូវបាន លក់ ទៅ ឱ្យ ក្រុម
“ ជំនាញរបស់ខ្ញុំគឺដៃទៅ កាន់ដៃ និងកាំបិត ។
១១ ព្រះជាម្ចាស់ជាចៅក្រមដ៏សុចរិត ហើយជាព្រះ ដែលមានកំហឹង ជារៀងរាល់ថ្ងៃ ...
គាត់ បាន នាំ ខ្ញុំ តាម ច្រក ទ្វារ ខាងជើង ឆ្ពោះទៅ មុខ ផ្ទះ ។ ខ្ញុំមើលទៅឃើញសិរី ‌ រុងរឿងរបស់ព្រះ‌ អម្ចាស់ពេញព្រះ‌ ដំណាក់របស់ព្រះ‌ អម្ចាស់ ហើយខ្ញុំក៏ក្រាបមុខខ្ញុំ ។
ខ្ញុំ គិត ថា មនុស្ស ទើបតែ បាន សន្និដ្ឋាន ថា វា ជា បញ្ហា កម្មវិធី ។
សូមព្រះ‌ អម្ចាស់មានព្រះ‌ហឫទ័យសប្បុរសចំពោះអ្នក ដូចអ្នកបានប្រព្រឹត្តចំពោះខ្ញុំ និងកូនប្រុសរបស់ខ្ញុំដែលបានស្លាប់ទៅហើយ ។
នៅ តាម ផ្លូវ នាង បាន និយាយ មកកាន់ ខ្ញុំ ថា
បន្ទាប់មកយើងបានងាកទៅរកសំណួរនៃរបៀបដែលអ្នកអាចផ្លាស់ ប្តូ រខ្លួនឯង។
ដោយ សារ តែការ បែកបាក់គ្នាដែលខ្ញុំបានឃើញក្នុងប្រទេសយើង និងក្នុងសហគមន៍របស់យើង ខ្ញុំចង់ធ្វើអ្វីដែល វិជ្ជមាន ។
អគ្គីភ័យបានកើតឡើងនៅថ្ងៃ ចន្ទម្សិលមិញ ដោយគ្មានអ្នក ដំណើរនៅលើយន្តហោះឡើយ ។
ព្រះជាម្ចាស់ បាន ប្រោស ព្រះអង្គ អោយ មាន ព្រះជន្ម រស់ ឡើងវិញ នៅ ថ្ងៃទី បី ហើយ ទ្រង់ បាន ប្រទាន អោយ ព្រះអង្គ សំដែង អោយ ឃើញ មិន មែន ដល់ មនុស្ស ទាំងអស់ នោះ ទេ គឺ ដល់ សាក្សី ដែល បាន ជ្រើសរើស នៅ ចំពោះ ព្រះភ័ក្ត្រ ព្រះជាម្ចាស់ សូម្បីតែ ចំពោះ ពួកយើង ដែល បាន បរិភោគ និង ផឹក ជាមួយ ព្រះអង្គ បន្ទាប់ពី ព្រះអង្គ បាន រស់ ពី សុគត ឡើងវិញ ( កិច្ចការ ១០: ៤០, ៤១) ។
គួរឲ្យ ស្ដាយ ណាស់ ដែល ក្តៅ ខ្លួន ខ្លាំង និង មិន ទទួលបាន ការពេញចិត្ត ។
នេះ ច្រើន ជាង អ្វី ទាំងអស់ ។
រង់ចាំខណៈពេលមួយ ។
ទំនោរ ក្នុង ការធានា ( នោះ គឺ ប្លន់ ) អ្នកដំណើរ ឆ្លងកាត់
កុំ ច្របាច់ នំប៉័ង !
ផ្តល់ឱ្យ ខ្ញុំ នូវ ចំណេះដឹង ដ៏ អស្ចារ្យ អំពី ភាពល្អ និង អាថ៌កំបាំង នៃ ព្រះ។
ប្រជាជន អើយ ស្តាប់ ខ្ញុំ !
កន្លែង ណាមួយ ដែល ពួកគេ នៅ រស់ ពួកគេ ដឹងខ្លួន ។
យើងត្រូវធ្វើឱ្យប្រាកដថា យើងមិនដើរតាមផ្លូវនោះទេ » ។
អ្នក អាច ប្រើ វា ដើម្បី បង្រៀន នរណា ម្នាក់ នៅ កន្លែង ដាច់ស្រយាល ។
ដូច្នេះហើយបានជាមានការ រីក រាយយ៉ាងខ្លាំងនៅក្នុងទីក្រុងនោះ ។
ហើយគាត់បាននិយាយស្តី ពេលបង្ហាញរឿងមួយ ។
ចូរ យើង សន្សំ និង ទទួលខុសត្រូវ ចំពោះ ខ្លួន យើ ង៖
អ្នកដែលជឿលើព្រះឃើញព្រះ នៅគ្រប់សត្វមានជីវិត ។
គាត់ អធិស្ឋាន សម្រាប់ យើង "
វា គ្រប់គ្រាន់ ហើយ ដែល កម្មវិធី រុករក ដែល កំពុង តស៊ូ នេះ បង្ហាញ ឱ្យ ឃើញ វា ។
ខ្ញុំគិតថាខ្ញុំបានដាក់ដែក គោលហើយគាត់មើលទៅល្អ !
វា ត្រូវបាន ធ្វើ តាមរយៈ ទម្រង់ ។
មាន វិគី ភីឌា ជាច្រើន ទៀត ដែល ខ្ញុំ ចូលចិត្ត ។
អ្នកសម្រេចចិត្ត ធ្វើ ការ ដោយ គ្មាន ប្រព័ន្ធ គាំទ្រ ការសម្រេចចិត្ត ។
ហើយ ខ្ញុំ ដឹង ថា ព្រះយេស៊ូវ ស្រឡាញ់ ខ្ញុំ ។
តើអ្នកកំពុងតាម ដានវាជាទី បន្ទាល់ចំពោះអ្វីដែលអ្នកបានឃើញ និងបាន ឮឬ ?
សក្ខីកម្ម នៅក្នុង ជីវិត របស់ ពួក ជំនុំ ជាមួយនឹង ការយល់ដឹង កាន់តែ ច្បាស់
ពួកគេនឹងគោរព និងកោតខ្លាច ដល់ព្រះនាមរបស់ព្រះអម្ចាស់ ។
យើងនឹងទទួលបានច្បាប់ទាំងនោះ ។
ហើយ កុំ និយាយ ជាមួយគ្នា ។
ត្រលប់ មកវិញ យើង ស្លៀកពាក់ សម្រាប់ ព្រឹត្តិការណ៍ នីមួយ ៗ ។
ខ្ញុំ ចង់ អរគុណ អ្នក សម្រាប់ កម្មវិធី ដ៏ អស្ចារ្យ របស់ អ្នក ។
ហេតុ អ្វី បានជា ពួកគេ អស់សង្ឃឹម ខ្ញុំ មិន ដឹង ទេ ។
ដូច្នេះវាគ្មាន ភាព ស៊ី សង្វាក់គ្នាសម្រាប់ពួកគេ » ។
តើ អ្វី ជា ចំណង់ចំណូលចិត្ត របស់ អ្នក ជាមួយនឹង ចំណុច ប្រទាក់ ប៉ះ ?
“ ភូមិរបស់យើងមិនមានគ្រឿងផ្គត់ផ្គង់ទេ ។
ហើយដៃលាតចេញនិងសុន្ទរកថាអង្វរ
អ្វី គ្រប់ យ៉ាង ដែល អ្នក ត្រូវការ គឺ ត្រឹមត្រូវ នៅ ចុង ម្រាមដៃ របស់ អ្នក ដូច្នេះ មិន មាន ការដើរ ជុំវិញ ម៉ាស៊ីន កាត់ ស្មៅ ដើម្បី ធ្វើ ការកែតម្រូវ នោះ ទេ ។
ដ្បិត ទ្រង់ បាន សង្គ្រោះ យើង ពី អំពើ បាប របស់ យើង ។
ពីព្រោះគ្មានអ្នក ណាស្អប់សាច់របស់ខ្លួនឡើយ ប៉ុន្តែចិញ្ចឹមនិងស្រឡាញ់វា ដូចជាព្រះ‌ អម្ចាស់ធ្វើក្រុមជំនុំដែរ ។
ពេលនោះ ប៉ា ក៏និយាយថា “ តើកូនយល់ទេថាកូនរបស់ខ្ញុំ ? ” ។
តើអ្នកគិតយ៉ាង ណាចំពោះបុរស ពន្យល់រឿងឱ្យខ្ញុំ ?
“ ខ្ញុំ ស្គាល់ គ្រួសារ គាត់ ខ្ញុំ បាន ឃើញ ការងារ ស្ម័គ្រចិត្ត របស់ គាត់ ជាមួយ យុវជន នៃ សហគមន៍ នេះ ។
« កូនមនុស្សបានមកដើម្បីស្វែង រក ហើយ សង្គ្រោះអ្វីដែលបានបាត់ » ។
២៩ - ចំពោះអំណោយ និងការ ត្រាស់ហៅរបស់ព្រះ គឺមិនអាចដកវិញបានឡើយ ។
លើស ពី នេះ គ្រាន់តែ ចង្អុលបង្ហាញ អំពី សេវាកម្ម ដែល ស្រប ច្បាប់ និង ផ្តល់ ការណែនាំ ។
កុំព្រួយ ចិត្តនឹងការ ស្លាប់របស់ខ្ញុំឡើយ ដ្បិតខ្ញុំនាំ ដំណឹងល្អ មក » ។
ព្រះ និងព្រះ យេស៊ូវនៅ តែចង់ឲ្យយើងប្រោសមនុស្ស និងឲ្យមនុស្សជា សះស្បើយ ។
អ៊ីស្រា ‌ អែល ខ្ញុំនឹងធ្វើបន្ទាល់ទាស់នឹងអ្នក ។
អរគុណ ខ្ញុំ ប្រាប់ អ្នក ឱ្យដឹង នៅពេល ខ្ញុំ ចាប់ផ្តើម ជាមួយ AI ។
ការស្លាប់ នៃ ការធ្វើដំណើរ ផ្លូវ គ្រួសារ
មនុស្ស ភាគ ច្រើន ចង់ បាន ។
ពួកគេ គ្រាន់តែ ជា ឪពុក ម្តាយ របស់ យើង ប៉ុណ្ណោះ ” ។
មិន ធម្មតា ! ក្មេងស្រី អាយុ១០ ឆ្នាំ អាច បំបែក ឯតទគ្គកម្ម ជាតិ ក្នុង ការអង្គុយ អង្គុយ រហូតដល់ ជាង ២ពាន់ លាន ដង !
នៅពេលនេះការ សម្លាប់របស់នាងនៅ តែមិនទាន់ដោះស្រាយបាន។
ប្រសិនបើគាត់ពិតជាធ្វើខុសមែន គាត់នឹងទទួលខុសត្រូវ » ។
សាលាក្នុងព្រះវិហារគឺមិនគិតថ្លៃទេ ប៉ុន្តែអ្នកត្រូវ តែលើកទឹក ចិត្តគ្រូ » ។
ពួកគេ ដឹង ពី អ្វី ដែល ពួកគេ ត្រូវ ធ្វើ នៅលើ ទីលាន ។
ហើយ ខ្ញុំ បាន ចូល ពី វេទិកា រួចហើយ ។
ហើយប្រើប្រាក់ចំណូលដើម្បីទិញស្រាបៀរអង់គ្លេសថោក ៗ ។
ករណីខ្លះ ។ ពិតប្រាកដណាស់ ។
មិនយូរប៉ុន្មានលទ្ធផលនៃការ បោះឆ្នោតទំនុក ចិត្តក៏បានចេញ មក ។
នោះ ហើយ ជា មូលហេតុ ដែល ខ្ញុំ រង់ចាំ រហូតដល់ ថ្ងៃស្អែក ។
ជា ការប្រសើរ ណាស់ , ពណ៌ សក់ គឺជា វិធីសាស្រ្ត ដ៏ ល្អ បំផុត ដើម្បី ដោះស្រាយ ការលំបាក នេះ !
ដ្បិតខ្ញុំប្រាប់អ្នក រាល់គ្នាថា អ្នកនឹងលែងឃើញខ្ញុំទៀតហើយ រហូតទាល់ តែអ្នក និយាយថា ព្រះជាម្ចាស់ដែលយាងមកក្នុងព្រះនាមព្រះអម្ចាស់មានសុភមង្គលហើយ ! "
សម្រាប់ អ្នក និង អ្វី ដែល អ្នក បាន ធ្វើ
« កុំយកព្រះនាមព្រះអម្ចាស់ ជាព្រះ របស់អ្នកដោយឥតប្រយោជន៍ ( កុំប្រើវាដោយគ្មានហេតុ ផល ) ។
ខ្ញុំបានរៀបចំជាមួយមិត្តភ័ក្តិ ៥ នាក់ទៀតដើម្បីទៅក្នុងរណ្តៅ
វា បាន ប្រែក្លាយទៅជា ការជេរប្រមាថ ដ៏ គួរឱ្យ ស្អប់ខ្ពើម ទៅ វិញ ទៅមក ។
នាងបាននិយាយថា “ ប្រាប់ខ្ញុំតើអ្នក ណាសមជាងគេ ?
ស្ថាប័ន ទាំង ពីរ នេះ បាន ប្រាប់ រ៉យ ទ័រ ។
គិត ថា សាកលវិទ្យាល័យ អាច ជួយ ពួកគេ ជាមួយនឹង បញ្ហា ទាំងនេះ ។
ខ្ញុំ សង្ឃឹមថាអ្នកអាចឃើញការ លាក់ពុត » ។
ប្រសិនបើ វា នឹង នាំ អ្នក ទៅ កន្លែង ដែល អ្នក ត្រូវ ទៅ ទទួលយក ការផ្តល់ ជូន ។
ដូចគ្នានេះដែរ ម៉ូសេ ជាភ្នាក់ងារធ្វើឲ្យ ចិត្តរបស់ផារ៉ោនរឹងមាំដោយ សារការ ខ្វះការប្រែ ចិត្ត ។
ចុង សប្តាហ៍ បី ថ្ងៃ ខ្ញុំ បាន អាន បន្តិច ។
អ្នក អាច រកឃើញ កៅអី អង្គុយ រួចហើយ ។
បញ្ជាក់ ប្រាប់ ខ្ញុំ ហើយ ខ្ញុំ
ប្រាំបី ខែ ក្នុង ឆ្នាំ នេះ ។
អរគុណ សម្រាប់ ការជូនពរ ថ្ងៃ កំណើត តើ អ្នក សុខ សប្បាយ ជា ទេ ?
ចង់ដឹងតម្លៃម៉ាស៊ីនកិនរ៉ែទង់ដែងរបស់យើង ទាក់ទងតាមអ៊ី ម៉ែ ល ឥឡូវនេះ !
វាក៏ជាការ លំបាកក្នុងការ ស្រឡាញ់នរណាម្នាក់នៅពេលដែលអ្នកមានកំហឹងក្នុង ចិត្ត ។
ដោយ អ្នក ផ្សេង ទៀត ដែល បាន ព្យាយាម បញ្ហា នេះ ។
ប្រពន្ធនិងប្រពន្ធជាច្រើនមិនដឹងថាម៉េចទេ ។
“ ខ្ញុំសូមលើកទឹក ចិត្តអ្នក រាល់គ្នាឲ្យនិយាយជាមួយអាឡិចសាន់ ឌឺ ។
១៤ ថ្ងៃដែលខ្ញុំកើតមកត្រូវបណ្ដា សា ហើយ សូមកុំឲ្យថ្ងៃដែលម្ដាយខ្ញុំសម្រាលបានត្រូវបាន ពរឡើយ ។
យើង បាន ប្រែក្លាយ វា ទៅជា គេហទំព័រ ដែល រីកលូតលាស់ លឿន បំផុត នៅលើ អ៊ីនធឺណិត ។
នោះ ហើយ ជា ទាំងអស់ យើង បានជាប់គាំង ។
បើអ្នក ជាកូនគួរ តែត្រូវបានការពារ ។
ព្រះ‌បន្ទូលរបស់ព្រះ‌ អម្ចាស់កំពុង តែរីក រាលដាលពាស ‌ ពេញតំបន់ ។
អត់ឃើញរូបសម្លៀក បំពាក់ទេតើមានដែរឬទេ ?ស្បែកជើងស្អាតទាំងអស់ !
ពេលឃើញព្រះអង្គក៏ថ្វាយបង្គំព្រះអង្គ ប៉ុន្តែមានអ្នកខ្លះ សង្ស័យ ។
ចាប់បាន នៅក្នុង " អន្ទាក់ " បួន ផ្សេង គ្នា ដែល ធ្វើឱ្យ វា កាន់តែ ពិបាក សម្រាប់
សត្វ គោ មួយ ក្បាល ត្រូវបាន ផលិត ។
ម្យ៉ាង វិញ ទៀត ត្រូវ ត្រៀមខ្លួន ដើម្បី បើកបរ លើ ផ្លូវ ក្រួស ទោះបីជា អ្នក នៅលើ ផ្លូវ ធំ ក៏ដោយ ។
គាត់កំពុងឡើងភ្នំដើម្បីឃ្វាលពពែ ។
អ្នកណា សម្លាប់ ក៏ ត្រូវ ត្រៀម ស្លាប់ ដែរ ។
ប្រធានបទ សំខាន់ នៃ ការសរសេរ របស់ គាត់ គឺ គ្រោះថ្នាក់ នៃ កុម្មុយនិស្ត ។
អ្នក បានបំផុសគំនិតស្ត្រីនេះឱ្យទៅរកវា !
កុំ អង្គុយ ពេលព្រឹក ។
ឈ្មោះ របស់ អ្នក នៅលើ ហ្វេសប៊ុក ។
នៅ ចុងបញ្ចប់ នៃ រដូវ ក្តៅ ពួកគេ បាន រៀន អ្វី ថ្មី អំពី ខ្លួន ពួកគេ ហើយ បាន រកឃើញ មិត្តភាព និង ស្នេហា ។
វាជាការ ល្អប្រសិនបើយើងធ្វើបែបនោះ ។
បន្ទាប់មក ពួកគេបានអង្វរលោកឲ្យនៅ ជាមួយពួកគេមួយថ្ងៃ ។
ការវាយតម្លៃ គឺ បង្កើត ឱ្យ កាន់តែ ច្បាស់
" ខ្ញុំ ចង់ បង្កើត ប្រវត្តិសាស្ត្រ នៅក្នុង ផ្នែក របស់ ខ្ញុំ ។
« គេនឹង បណ្ដេញអ្នកចេញពីសាលា ប្រជុំ ពិតមែន ពេលវេលាមកដល់ អ្នក ណាដែលសម្លាប់អ្នក រាល់គ្នានឹងគិតថាគេថ្វាយព្រះ។
