សកម្មភាព របស់ ពួកគេ នេះ អាច បញ្ជាក់ បាន ថា ទំនាក់ទំនង ស្នេហា របស់ ពួកគេ នៅតែ ល្អ ដូច មុន ។
ផ្លែ ឈើ ប្រភេទ នេះ ក៏ ជួយ ជំរុញ និង បង្កើន ការចងចាំ បាន ផងដែរ ។
ដូចនេះ ប្រសិនជា អ្នក ចង់ មើល ទៅ ក្មេង ជាង អាយុ១០ ឆ្នាំ អ្នក គួរតែ ពិសារ អាហារ ទាំង ៧មុខ ខាងក្រោម នេះ ។
គ្នា ដើម្បី ត្រៀម ចូលរួម ប្រកួត និង ការហ្វឹកហាត់ នៅ ក្រៅ ប្រទេស ។
មាន ការប្រឈមមុខ ជាមួយ បញ្ហា ច្រើន ដូចជា បញ្ហា គ្រួសារ ការងារ ការសិក្សា .. ជាដើម ។
ហើយ ពួកយើង បាន ធ្វើ រឿង នេះ រួចហើយ ។
ការនាំចេញ សម្លៀកបំពាក់ ស្បែកជើង និង សម្ភារៈ សម្រាប់ ធ្វើដំណើរ របស់ កម្ពុជា មាន តម្លៃ ៩,៣ពាន់ លាន ដុល្លារ
វិធី ដោះស្រាយ ដ៏ មាន ប្រសិទ្ធភាព បំផុត នោះ គឺ ការចរចារ ជាមួយនឹង មនុស្ស ដែល ជាប់ពាក់ព័ន្ធ នឹង ទំនាស់ ។
មាន គណបក្ស ប្រជាជន ទើប មាន ជីវិត រស់ មកដល់ សព្វ ថ្ងៃ នេះ ។
ជន កម្ពុជា គួរតែ ត្រូវ ទទួលបាន សេរីភាព ពិត ប្រាកដ !
ដើម្បី ឆ្លើយតប ៕
ជំនឿ អរូបិយ នៅតែ មាន ឥទ្ធិពល ក្នុង …
យើង ធ្វើអោយ ផ្លូវ របស់ គេ នៅ ស្ងាត់ ជ្រងំ
ហើយ អ្នក ទាំង ពីរ ក៏ បាន ឯកភាព គ្នា បង្កើន កិច្ចពិភាក្សា ពិគ្រោះយោបល់ លើ បញ្ហា សន្តិសុខ ទ្វេ ភាគី ផងដែរ ។
វចនានុក្រម សម្តេច ជួន ណាត 3
អត្ថបទ លោក ចាន់ តារា
ឆេះ ទីតាំង បូម ប្រេង ក្នុង សមុទ្រ មួយ នៅ អាហ្សែ បៃហ្សង់ ស្លាប់ ម្នាក់ បាត់ខ្លួន ៣០ នាក់
មុនពេល ចាកចេញពី ទីនោះ អ្នក ទាំង ពី បាន ប្រកាស ថា ការជួបជុំគ្នា នឹង បន្ត នា ថ្ងៃស្អែក ។
បុរស សម្លឹង មុខ ខ្ញុំ ហើយ ញញឹម បែប កំប្លែង ។
ធ្វើការ ជាមួយ ក្រុមហ៊ុន ឯ
នេះ បើ តាម ការ ឱ្យដឹង ដោយ អាជ្ញាធរ អាល្លឺម៉ង់ ។
ដែល ធ្លាប់ ធ្វើ ដូច្នោះ ដែរ ។
ញ៉ាំ ឬ ផឹក ចំណីអាហារ មាន ជាតិ អាស៊ី ដជាប្រចាំ ។
គំនិត និង ទស្សនៈ នាំមក នូវ សកម្មភាព ហើយ សកម្មភាព នេះ ហើយ ដែល កំណត់ នូវ ភាពជោគជ័យ ។
បើ អញ្ចឹង សាលា រាជធានី ភ្នំពេញ គួរ ធ្វើ បង្គន់ កុំ យក លុយ ឱ្យ ពួកគាត់ បាន ចូល ដោយ មិន បាច់ បង់លុយ ។
ឆ្លើយតប ទៅកាន់ បុរិន្ទ បោះបង់ ការឆ្លើយតប
ដើម្បី ជា របង ការពារ ព្រំដែន មួយ ដ៏ រឹងមាំ ។
យុវតី រូប នេះ និយាយ ថា គាត់ ប្រចណ្ឌ ខ្ញុំ ណាស់ ពោលគឺ សូម្បីតែ ខ្ញុំ រាប់អាន ឬ និយាយ ជាមួយ អ្នកណា ក៏ អត់ បាន ដែរ !
ខ្ញុំ និយាយ ថា ការជំរុញ ឱ្យ មាន ការនិយាយ គ្នា គឺជា រឿង មួយ ល្អ ណាស់ ។
លោកស្រី នឹង ឈ្នះ ដោយ ចំនួន ច្រើន លើសលប់ ។
ជាពិសេស អ្នក ដែល មាន បញ្ហា ពេលព្រឹក ឡើង ហើយ ញ៉ាំ អ្វី មិន បាន គួរតែ ផឹក ភេសជ្ជៈ នេះ ។
ហើយ ថ្វាយ ព្រះនាម ថា អេម៉ាញូ អែល ។
បើ ឆាប់ ខឹង កុំ លេង អុក ដោយ សុភក្តី អ្នកនិពន្ធ ប៉ិច សង្វា វ៉ាន សូមស្វាគមន៍
បែបបទ របស់ គាត់ ធ្វើ អត់ ទាន់ បាន ត្រឹមត្រូវ តាម ណែនាំ របស់ ខ្ញុំ ផង ហ្នឹង ។
ម្យ៉ាងទៀត តម្លៃ យើង ថ្លៃ ក៏ យើង មិន អាច ចូល ទីផ្សារ បាន ដែរ ។
កម្ពុជា គួរ សប្បាយ ចិត្ត ទទួលយក ការចាញ់ ១ - ០
គណបក្ស ភាគ ច្រើន បាន បដិសេធ មិន ទទួលយក លទ្ធផល ប្រកាស បណ្តោះអាសន្ន របស់ គ.ជ. ប នោះ ទេ ។
លោកស្រី វេជ្ជបណ្ឌិត យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង …
ដោះ ដៃ លែង ទាក់ទង ជាមួយ តទៅទៀត ។
ទាំង៤ របស់ ជាតិ
រួម ជាមួយ ពាក្យពេចន៍ និយាយ បែប កំប្លែង ផងដែរ ថា ៖
គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត គ.ជ. ប កាលពី ថ្ងៃ ម្សិលមិញ បាន ប្រកាស ទទួលស្គាល់ គណបក្ស នយោបាយ ចំនួន ៤… អាន បន្ត
េចញ ពី កនចបេ់ ដើមី បេ
លទ្ធផល នេះ បើ ធៀប ជាមួយនឹង ល
ទារិកា ស្រី ម្នាក់ នៅ ប៉ាគីស្ថាន ដែល មាន ក្បាល ប៉ុន បាល់ទាត់ កំពុង រង់ចាំ ការវះកាត់ សង្គ្រោះ ជីវិត ដើម្បី ព្យាបាល ជំងឺ របស់ នាង ។
ការសិក្សា បាន បង្ហាញ ថា ថ្នាំ នេះ មាន ប្រសិទ្ធិភាព ក្នុង ការព្យាបាល ការជ្រុះ សក់ ប្រភេទ មួយ ចំនួន និង ត្រូវការ រយៈពេល ប្រើប្រាស់ ពី ៦ទៅ ១២ ខែ មុន ពេល ដែល វា មាន ប្រសិទ្ធិភាព ទាំងស្រុង ។
ត្រូវ បញ្ជូន ទៅ តំបន់ ប្រឈមមុ…
នេះ បើ យោង តាម ប្រភព ខាងលើ ដកស្រង់ របាយការណ៍ ស៊ើបការណ៍ សម្ងាត់ ។
វា សំខាន់ ណាស់ ដែល គ្រូ ទាយ ត្រូវ ចេះ ប្រមើល មើល ពី ចិត្ត របស់ ពួកគេ គួបផ្សំ នឹង ក្បួនគន់ គូរ ផងដែរ ។
ក្រុម អ្នកតវ៉ា បាន អំពាវនាវ ឱ្យ លោកស្រី ការីឡាំ ដែល លែង មាន ប្រជាប្រិយភាព នេះ ចុះចេញ ពី តំណែង ជា មេដឹកនាំ ប៉ុន្តែ លោកស្រី បាន ទទួល ការគាំទ្រ ពី ក្រុម មេដឹកនាំ ចិន ក្នុង អំឡុង ដំណើរទស្សនកិច្ច ប្រចាំ ឆ្នាំ ទៅកាន់ ទីក្រុង ប៉េកាំង កាលពី ថ្ងៃចន្ទ ។
៨០ កុមារ យ៉ូហាន មាន វ័យ ចំរើន ឡើង ជាលំដាប់ ទាំង ខាង រូបកាយ ទាំង ខាង វិញ្ញាណ ។
ជំនាន់ កាល ម៉ាក្ស គឺជា ការចាប់ផ្តើម ដំបូង នៃ គំរូ សេដ្ឋកិច្ច មូលធន ឧស្សហកម្ម ។
រងរបួស ធ្ងន់ ស្រាល ពីរ នាក់ ខណៈ បើក ម៉ូតូ ឌុប គ្នា ត្រូវ រថយន្ត បើក មក ពីក្រោយ បុក
ដែល ចូលចិត្ត ច្បាំង វិនាស ខ្ចាត់ខ្ចាយ ទៅ ។
អ្នក ត្រូវតែ ចង់ លុប អ្វី គ្រប់ យ៉ាង នៅលើ វា ដើម្បី រក្សា ទិន្នន័យ ផ្ទាល់ខ្លួន របស់ អ្នក មាន សុវត្ថិភាព និង ធានា សុវត្ថិភាព ។
ចែកជូន បងប្អូន ទស្សនា ទេ ពិបាក នឹង រក ប្រជាប្រិយភាព ណាស់ ។
ជំពូក នោះ បង្ហាញ អំពី អាថ៌កំបាំង នៃ ការអប់រំ វិញ្ញាណ មនុស្ស ឱ្យ មាន ចិត្ត អត់ធ្មត់ ដ៏ ប្រសើរ បំផុត ដែល ពួកគេ អាច មាន ។
ឱ្យ ទៅ ភោជនីយដ្ឋាន ទីក្រុង នេះ ។
អ៊ីចឹង ខ្ញុំ ត្រូវតែ និយាយ ។
កាលពី ម្សិលមិញ ក្រុម សង្គម ស៊ីវិល ចំនួន ២០ បាន ចូលរួម ប្រជុំ ជាមួយ តំណាង មកពី សារព័ត៌មាន ចំនួន ១៦ ក្នុង គោលបំណង ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ការយោគយល់ គ្នា រវាង វិស័យ ទាំង ពីរ ។
ខ្ញុំ សង្ឃឹម ថា អស់ លោក អ្នក កុំ បំភ្លៃ ន័យ អក្សរសាស្ត្រ តាម ចំណង់ តទៅទៀត ។
