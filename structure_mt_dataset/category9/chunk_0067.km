៤២ ទូលបង្គំនឹងមាន ចម្លើយចំពោះអ្នកដែលតិះដៀលទូលបង្គំ ដ្បិតទូលបង្គំបានទុក ចិត្តលើព្រះបន្ទូលរបស់ព្រះអង្គ ។
២៤ ឥឡូវនេះ គាត់នៅចំពោះព្រះភ័ក្ត្រព្រះ ក្នុងនាមយើង ។
ព្រះទ្រង់ ស្មោះត្រង់ ហើយទ្រង់សមនឹងទទួលពេលវេលា សរសើរ និងអរព្រះគុណរបស់យើង ។
អ្នកនឹងប្រសូតបានបុត្រមួយ ហើយអ្នកត្រូវឲ្យគាត់
ម៉ាថា យ 14:15 លុះព្រលឹមឡើង ពួកសិស្សចូលមកគាល់ព្រះអង្គទូល ថា៖ « ទីនេះជាទីស្ងាត់ជ្រងំ ហើយថ្ងៃក៏កន្លង ផុតទៅហើយ សូមឲ្យបណ្ដាជនចេញទៅរកទិញម្ហូបអាហារតាមភូមិ » ។
ដោយខ្លួនពួកគេផ្ទាល់បានធ្លាក់ចុះដើម្បីនិយាយក្នុងចំណោមពួកគេដើម្បីឱ្យ
ភាពរុងរឿង ; គាត់ ក្លាយជា តែ មួយ ជាមួយនឹង ក្រណាត់ នៃ ផ្ទះ ឬ ដី
ជាពិសេសប្រសិនបើពួកគេខ្លាចពេលពួកគេចូលគេង » ។
កាលពីម្សិល មិញដោយលើកយកសំណុំរឿងក្បត់ ជាតិប្រឆាំងនឹងអ្នក គ្រោងធ្វើរដ្ឋ ប្រហារ
មនុស្ស នឹង សង្ស័យ អ្វី ដែល អ្នក និយាយ ប៉ុន្តែ ពួកគេ តែងតែ ជឿ អ្វី ដែល អ្នក ធ្វើ ។
ដែល គាត់ បាន បម្រើ ដោយ យុត្តិធម៌ ។
ពួកគេបានបោះ បង់ចោលលោក ពួកគេមិនអើពើនឹងទីលំនៅរបស់ព្រះអម្ចាស់ ហើយពួកគេបានប្រឆាំងនឹងលោក ។
ជំនួយនោះបានមកពីអ្នកក្រុង មិនមែនមកពីអ្នកគ្រប់គ្រងពួកគេទេ ។
ជា ដំបូង ខ្ញុំ ចង់ ប្រាប់ អ្នក អំពី ស៊ីឌី ។
គេបានដឹងថាអ្វីទៅជា ន រក ..
ប្រាំ ឆ្នាំ ព្រះ អើយ ។
លោកបានកោះហៅបាឡាម ជាកូនរបស់លោកបេអ៊រ មកដាក់បណ្ដា សា អ្នក ។
ហើយកិច្ចការរបស់គាត់គឺ នាំប្រជាជនអ៊ីស្រាអែលជាច្រើនមក ឯព្រះអម្ចាស់ ជាព្រះ របស់ពួកគេ ។
ខ្ញុំ ឃើញ ជំនឿ របស់ អ្នក ។
លើកលែងតែ , នោះ គឺ ការដោះស្រាយ អាថ៌កំបាំង ។
ដោយ ប្រាជ្ញា នៃ អំពើ របស់ គាត់ ។
« ហើយសម្រាប់ទី បន្ទាល់នេះ ខ្ញុំរំពឹងថានឹងប្រាប់រឿងមួយនៅថ្ងៃជំនុំ ជំរះ » ។
ប៉ុន្តែ ពួកគេ កំពុង កាត់បន្ថយ សម្ពាធ ។
អ្នក ត្រូវតែ ទទួលបាន អ្វី មួយ សម្រាប់ វា ។
អ្នកបង្កើត សន្តិភាព មាន ពរ ។ ពួកគេ នឹង ត្រូវបាន គេ ហៅ ថា ជា កូន របស់ ព្រះជាម្ចាស់ ។
គណបក្ស ត្រូវតែ និយាយ ដោយ សំឡេង តែ មួយ ។
ទ្រង់បាននាំ នគរមកមួយ រយៈខ្លី
ពួកគេត្រូវបានគ្របដោយ ភាពងងឹត ហើយភ្នែករបស់ពួកគេត្រូវងងឹតព្រោះពួកគេស្ថិតក្នុងភ្លើង ន រក ។
២១ - ព្រោះបើព្រះ មិនមានមេត្តា ដល់មែកធម្មជាតិទេ នោះទ្រង់នឹងមិនមានមេត្តា ដល់អ្នកឡើយ ។
ហើយការ ផាកពិន័យមានប្រសិទ្ធភាព ។
" ហើយប្រសិនបើអ្នកដាក់ខ្លួនឯងនៅទីនោះ អ្នកនឹងទទួលបានមួយ ឬពីរ yeses ដែលនឹងធ្វើឱ្យវាមានតម្លៃទាំងអស់ " ។
មនុស្ស ជាច្រើន បាន និយាយ រួចហើយ ថា ពួកគេ នឹង មិន អនុវត្ត ច្បាប់ ពេញលេញ នោះ ទេ ។
គោរពយ៉ាងនេះហើយ ទើបគេតាំងព្រះអង្គជាស្ដេច ។
‹ យើងត្រូវឆ្លងកាត់ការ លំបាក ជាច្រើនដើម្បីចូលទៅក្នុងរាជាណាចក្ររបស់ព្រះ› ។
«បន្ទាប់ពីគាត់បាននិយាយដូច្នេះ គាត់បានច្រានចោលការ ប្រជុំ » ។
« សូមស្នាក់នៅ ទីនេះចុះ ដ្បិតព្រះ យេហូវ៉ាបានចាត់ខ្ញុំឲ្យទៅទន្លេយ័រ ដាន់ » ។
រដ្ឋាភិបាលបាននិយាយថា មិត្ត ភក្តិរបស់ Liu ក៏បានចូលរួមក្នុងពិធីបុណ្យ សពនេះដែរ ។
បើយើងសុខ ចិត្ត ប្រែ ចិត្ត ព្រះ នឹងអត់ទោសឲ្យយើង ។
អ្នក គឺ ជាអ្នកដែលខ្ញុំបាននិយាយពីសម័យបុរាណដោយអ្នក បម្រើរបស់យើង គឺជាព្យាការីនៃ សាសន៍អ៊ីស្រាអែល ។
១៤ ហើយនៅ ទីនេះ គាត់មានសិទ្ធិអំណាចពីពួកនាយកបូជាចារ្យ ដើម្បីចាប់អស់អ្នកដែលអំពាវនាវដល់ព្រះនាមទ្រង់ » ។
នៃព្រះ; ហើយប្រសិនបើវាចាប់ផ្ដើមពីយើងជាមុន តើនឹងមានលទ្ធផលយ៉ាង ណាសម្រាប់អ្នកដែលមិនគោរពតាមដំណឹងល្អរបស់
ខ្ញុំត្រឡប់មក ឯព្រះ យេហូវ៉ាវិញឥឡូវនេះ ។
ឬអ្នកទទួលប្រាក់ចំណូលគ្រប់ប្រភេទពី សប្បុរសធម៌សាធារណៈ
ហើយ យើង ជឿជាក់ លើ ពួកគេ ក្តី សុបិន និង គោលដៅ របស់ ពួកគេ ។
ការ ចូលចិត្ត ដែល មិន ធ្លាប់ មាន ពីមុន មក ។
ពេល ណាដែលព្រះ មាន បន្ទូលទៅ កាន់លោកម៉ូសេ ទ្រង់បានសម្ដែងតាម រយៈគុម្ពោតដែលឆេះ ឬចេញពីដុំពពក ឬតាម រយៈភ្លើង ។
ហើយស្តាប់របៀបដែលឯកឧត្តមរៀបរាប់ពីអ្វីដែលគាត់បានឃើញ ។
ម្នាក់ទៀតបាននិយាយថា៖ « អ្វីជាអំណោយមិនអាចកាត់ថ្លៃបាន ។
មិន មាន ច្បាប់ កំណត់ នៃ ការថ្វាយបង្គំ ទេ ។
ការបំពាន ច្បាប់ របស់ ព្រះ ដូចជា ការថ្វាយបង្គំ ព្រះ ឃាតកម្ម ។
ដូច ករណី ភូមិ អាបាឌីស ។
ខ្ញុំ មិន គិត ថា ការផ្លាស់ប្តូរ ទេ ។
គាត់ស្រែកទៅពួកគាត់ថា « សម្លាញ់ឯងអត់មានត្រីទេឬ ? » ពួកគេឆ្លើយថា « ទេ » ។
នឹង ទទួលបាន ដើម្បីឱ្យ ពួកគេ ដឹង ពី អ្វី ដែល ត្រូវ រំពឹង ។
១២ ព្រោះនៅពេលនោះ ព្រះវិញ្ញាណបរិសុទ្ធនឹងបង្រៀនអ្នក នូវអ្វីដែលអ្នកត្រូវនិយាយ » ។
ពេលពួកសិស្សយ៉ាកុប និង យ៉ូហានឃើញដូច្នេះ ពួកគេសួរ ថា៖ « លោកម្ចាស់ តើលោកចង់ឲ្យយើងហៅភ្លើងធ្លាក់ពីលើមេឃ មកបំផ្លាញពួកគេឬ ? » ។
ព្រះអម្ចាស់ ជាព្រះ របស់អ្នក នឹងប្រទាន ពរដល់អ្នក នៅក្នុងទឹកដីដែលព្រះអង្គប្រទានអោយអ្នក ។
ជា ដំបូង ជនជាតិ យូដា ត្រូវបាន ប្រគល់ ឱ្យ នូវ ព្រះបន្ទូល របស់ ព្រះជាម្ចាស់ ។
គ្មានអ្នក ណាជឿលើអ្នកទេ ដូច្នេះអ្នកត្រូវតែជឿជាក់លើខ្លួនឯងដើម្បីជោគជ័យ » ។
តើនេះមិនមែនជាអ្វីដែលបានកើតឡើងចំពោះកូនចៅអ៊ីស្រាអែលទេឬ ?
កុំ បារម្ភ ពី ខ្ញុំ ខ្ញុំ នឹង នៅក្បែរ ។
ពួកគេបានធ្វើដំណើរទៅតាមក្រុងនានាក្នុងស្រុកយូដា ហើយបង្រៀនប្រជាជន ។
ដោយ ការស្រមើស្រមៃ វា ធ្វើឱ្យ វា ចូល ទៅក្នុង ជីវិត របស់ អ្នក ហើយ អ្នក នឹង ចាប់ផ្តើម ទាក់ទាញ វា ។
ឥឡូវនេះ អ្នក ប្រហែលជាចង់ឲ្យប្រភេទត្រូវបាន បញ្ចូលក្នុង បញ្ជីផងដែរ ។
" ដោយគាត់មិនដឹងទេ គាត់មានឥទ្ធិពលយ៉ាងខ្លាំងមកលើខ្ញុំ " ។
ផ្សែង នៃ គ្រឿង ក្រអូប បាន មក ជាមួយ ការអធិស្ឋាន របស់ ពួក បរិសុទ្ធ
ហើយផែនដីទាំងមូលភ្ញាក់ផ្អើល ហើយដើរតាមសត្វ តិរច្ឆាន ។
ពន្លឺទាំងប្រាំពីរនេះតំណាងឲ្យព្រះនេត្ររបស់ព្រះអម្ចាស់ ដែលកំពុងសម្លឹងមើលទូទាំងផែនដី » ។
16 លោកនឹង បង្វែរកូនចៅអ៊ីស្រា ‌ អែលជាច្រើនមក រកព្រះ‌ អម្ចាស់ ជាព្រះ របស់ពួកគេ ។
ទោះ យ៉ាងណា ក៏ដោយ អ្នក នឹង ត្រូវបាន ជូន ដំណឹង អំពី បញ្ហា នេះ នៅពេល កក់ ។
នេះជាដំណាក់របស់ព្រះ ជាទ្វារនៃស្ថាន សួគ៌ » ។
និង ផ្តល់ ការយល់ឃើញ នៅ ជំហាន នីមួយ ៗ នៃ ផ្លូវ ។
និង ការកើត ជាថ្មី នៃ ការលះបង់ ។
ខ្ញុំ ចង់ ថ្វាយបង្គំ ព្រះបាន ល្អ ហើយ ខ្ញុំ ចង់ ធ្វើជា សាក្សី ដ៏ ល្អ សម្រាប់ ទ្រង់ ។
មិន មាន ការស្មាន ទៀត ទេ អំពី អ្វី ដែល នៅ ខាងក្នុង ។
ដូច្នេះ ហើយការ វិនិច្ឆ័យរបស់ខ្ញុំគឺថា យើងមិនគួរបង្កការ លំបាកដល់ សាសន៍ ដទៃដែលងាក មក រកព្រះ ឡើយ ។
ពិភពលោក កំពុង មើល សកម្មភាព របស់ យើង ។
ឥឡូវ នេះ ជា ពេល ដែល ត្រូវ ស្វែងយល់ បន្ថែម ដើម្បី កុំ ឱ្យ យើង ខ្លាច តិច ។
កាលហ្វូងមនុស្សឃើញដូច្នេះ ពួកគេភ្ញាក់ផ្អើល ហើយលើក ត ម្កើងព្រះ ដែលបានប្រទានអំណាចយ៉ាងនេះដល់មនុស្ស ។
២០ - ដ្បិតសេចក្ដី ក្រោធរបស់មនុស្សមិនបានបង្កើតសេចក្ដី សុចរិតនៃព្រះ ឡើយ ។
គាត់ ភ្ញាក់ ដឹងខ្លួន យ៉ាង ស្ទាត់ជំនាញ ។
៣៦ ហើយកុំស្បថដោយក្បាលអ្នកឡើយ ព្រោះអ្នកមិនអាចធ្វើសក់មួយពណ៌ ស ឬខ្មៅបានឡើយ ។
ដែល ត្រូវបាន លើកឡើង ប្រកបដោយ និរន្តរភាព ។
ឫសរបស់វារាក់ ហើយត្រូវបានខ្សោយដោយសារភ្លើង ។
ពួកគេ មាន ពេលវេលា ដ៏ អស្ចារ្យ ជាមួយគ្នា ។
ការដឹង ពី កម្លាំង របស់ ព្រះ ឬ ព្រះចេស្ដា របស់ ព្រះ គឺ ត្រូវ ដឹង ពី ភាព បរិសុទ្ធ របស់ ព្រះ ឬ ភាព ផ្សេង ទៀត របស់ ព្រះ។
២ យើងម្នាក់ ៗត្រូវផ្គាប់ ចិត្តអ្នកជិតខាងដើម្បី ផលប្រយោជន៍របស់ខ្លួន ដើម្បីកសាងគាត់ ។
តើគេនឹងនៅជាប់នឹងវត្ថុដែលកើតមកឬទេ ?
ប៉ុន្តែ មានអ្នកខ្លះមិនជឿ ដ្បិតព្រះ‌ យេស៊ូ ជ្រាបតាំងពីដើមដំបូង មកថា នរណាមិនជឿ ហើយនរណានឹងក្បត់ព្រះអង្គ ។
៦ អ្នកក៏ស្ថិតក្នុងចំណោមអ្នកដែលត្រូវបានហៅឲ្យធ្វើជារបស់ព្រះ យេស៊ូគ្រិស្ដ ។
ហើយ នៅ ពេល ដែល ចេញ ពី ភាពស្ងៀមស្ងាត់
« ទ្រង់មិនបានបែងចែករវាងយើងនិងគេឡើយ ដ្បិតទ្រង់បាន ប ន្សុទ្ធ ចិត្តគេដោយសេចក្ដី ជំនឿ » ។
រឿងដំបូងដែលខ្ញុំសរសេរ ខ្ញុំនិយាយរាប់ រយនាក់ ព្រោះខ្ញុំមិនអាចជឿថារឿងបែបនោះអាចកើតឡើងបាន » ។
យើង រៀបចំ រូប មន្ត ទាំងអស់ របស់ យើង ជាមួយ ទឹក បរិសុទ្ធ ។
វា ជា ថ្ងៃ កំណើត របស់ ខ្ញុំ គឺជា ថ្ងៃ កំណើត របស់ ខ្ញុំ
ហើយតើនរណាជាអ្នកប្រកាសបំបែកការតមអាហារមុនថ្ងៃលិច ?
តើអ្វីទៅជាអត្ថន័យនៃ
ហើយមិត្តរបស់ខ្ញុំរងទុក្ខយ៉ាង ណាមុនគាត់ស្លាប់ » ។
ដែល មិន ធ្លាប់ រស់ នៅក្នុង ពួកគេ ពីមុន មក ។
ហើយគាត់មាន ប្រសាសន៍មកខ្ញុំថា កុំធ្វើវាឡើយ ខ្ញុំ ជាខ្ញុំបម្រើជាមួយនឹងអ្នក និងជាមួយនឹងបងប្អូនរបស់អ្នក ជាអ្នកប្រកាសទំនាយ ហើយជាមួយនឹងអ្នកដែល កាន់តាមពាក្យនៃសៀវភៅនេះថា ចូរថ្វាយ បង្គំព្រះ។
តើអ្នកមិនបានយល់ពី គ្រឹះនៃផែនដីទេ ? "
គាត់បានបង្ខាំងខ្លួនគាត់ទៅនឹងបទ គម្ពីរ និងការ ដាស់តឿនដែលបានបំផុស គំនិតដោយវិវរណៈដែលបានធ្វើដល់គាត់ ។
បន្ទាប់មកពួកគេបានសុំឱ្យគាត់នៅជាមួយពួកគេច្រើនថ្ងៃ ។
គាត់បានសុំស្ត្រីនៅអណ្ដូងឲ្យទឹកគាត់ ។
ពាក្យរបស់ព្យាការីស្របនឹងសេចក្ដី នេះ ដូចមានចែងទុកមកថា៖
ដោយការសង្ស័យលើសិទ្ធិអំណាចរបស់អ្នកដែលនាំ ដំណឹងល្អ មក កាន់ពួកគេ នោះពួកគេកំពុងដាក់ការសង្ស័យលើខ្លួនគេ ។
អ្វីដែលទ្រង់បានធ្វើសម្រាប់យើង ហើយយើងមិនសូវគិតតែពីខ្លួនឯង
ព្រះ យេស៊ូមាន បន្ទូលថា៖ « អស់អ្នក ណាដែលមក ឯខ្ញុំ ហើយឮពាក្យខ្ញុំ ហើយធ្វើតាម នោះខ្ញុំនឹងបង្ហាញអ្នក រាល់គ្នាថាគាត់ដូចជាអ្នក សង់ផ្ទះដែលជីកជ្រៅ ហើយចាក់ គ្រឹះលើថ្ម
« ខ្ញុំបានឃើញព្រះអម្ចាស់ » ហើយថាគាត់បាននិយាយរឿងទាំងនេះទៅនាង ។
13 ហេតុដូច្នោះហើយ ខ្ញុំនិយាយជាពាក្យប្រស្នាទៅពួកគេ ដោយព្រោះឃើញគេមើលមិនឃើញ ហើយឮគេមិនឮ ហើយក៏មិនយល់ ។
ហើយ នេះ គឺជា អ្វី ដែល ពួកគេ បាន បន្សល់ទុក កេរ ដំណែល របស់ ពួកគេ ទៅកាន់ អ្នក ដែល មក ក្រោយ ។
ប៉ុន្តែ អ័ ប្រាហាំមាន ប្រសាសន៍ទៅគាត់ ថា៖ « គេមានម៉ូសេ និងហោរា ។
ហើយ ចាប់តាំងពី ពួកគេ បាន ស្លាប់ ទៅ ហើយ គ្មាន អ្វី នៅលើ ផែនដី អាច ធ្វើ បាន នោះ ទេ ។
ដូច្នេះ ព្យាការី ខ្លួន ឯង បាន ក្លាយជា កម្មវត្ថុ នៃ ការវាយប្រហារ របស់ គាត់ ។
ពួកគេ នឹង ស្លាប់ ដូច សត្វ គោ ។
បង្ហាញ ពួកគេ ថា អ្នក មិន គំរាមកំហែង ដល់ ពួកគេ ទេ ។
ខ្លះហៅទៅអ្នកមាន រហូតមកដល់ពេលនេះ យើងត្រូវបានគេហៅទៅអ្នកក្រ នៅផែនដី ។
៣ ដើម្បីឲ្យអ្នក រាល់គ្នាបានសុខ សប្បាយ ហើយអ្នកនឹងមានអាយុវែងនៅលើផែនដី ។
ជា ដំបូង ការចែករំលែក ម៉ាស៊ីន បោះពុម្ព ចាំបាច់ ត្រូវ បើក ។
ហើយថ្វាយ យញ្ញ បូជាតាមអ្វីដែលមានចែងទុកក្នុងក្រឹត្យ វិន័យរបស់ព្រះអម្ចាស់ថា៖ « អណ្តើកមួយគូ ឬព្រាបក្មេងពីរក្បាល » ។
ប្រភេទនេះមិនកើតឡើង តែរៀងរាល់ប្រាំមួយខែម្តង ដូចដែលសន្និសីទទូទៅធ្វើនោះទេ ។
គាត់ គឺជា អ្នកទទួលរង្វាន់ ជាច្រើន ។
ហើយទ្រង់ជ្រាបនូវអ្វីដែលទ្រង់កំពុងមាន បន្ទូល ។
មានអ្វីកើតឡើងចំពោះខ្ញុំ » ។
ចិត្ត និងគំនិតរបស់ពួកគេបានចូលរួមយ៉ាងពេញលេញ ។
« ទ្រង់បានចាក់ប្រេងតាំងខ្ញុំដើម្បីប្រកាសដំណឹងល្អដល់ជន ក្រីក្រ » ។
បុរសទាំងពីរឈរនៅកន្លែងដែលពួកគេប្រៀបដូចជាភ្នំទឹកកកដ៏ធ្ងន់ដែលបែរមុខទៅ រកគ្នា ។
ទង ផ្ចិត គឺ រាក់ ជាមួយនឹង ផ្នែក ខាងក្រោម ទី បី នៃ ចំហៀង ។
ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា មនុស្សជាច្រើននឹងព្យាយាមចូល ប៉ុន្តែមិនអាចចូលបានទេ ។
ម្នាក់ក្នុងចំណោមពួកគេបានសួរម្នាក់ទៀតថា " តើអ្នកនិងប្តីរបស់អ្នកធ្លាប់មានចំណុចកំពូលដំណាលគ្នាទេ ? "
ព្រះ បានបង្គាប់រាស្ដ្ររបស់ទ្រង់៖
23 ចូរនៅ ជាមួយនឹងខ្ញុំចុះ កុំខ្លាចឡើយ ដ្បិតអ្នក ណាដែលស្វែង រកជីវិតរបស់អ្នក នោះស្វែង រកពីខ្ញុំ ។ អ្នក នឹង មាន សុវត្ថិភាព ជាមួយ ខ្ញុំ ។
អ្នក ទាំងអស់គ្នាបានស្គាល់សេចក្ដី សុចរិត !
ទោះ យ៉ាងណា ក៏ដោយ មិន មាន សមីការ ជាមួយ ព្រះទេ ។
ខ្លួន គាត់ ផ្ទាល់ មិន មែន ជា ពន្លឺ ទេ ។ គាត់ គ្រាន់តែ មក ធ្វើជា សាក្សី ចំពោះ ពន្លឺ ប៉ុណ្ណោះ ។
២៧ « អ្នកត្រូវនិយាយពាក្យទាំងនេះទៅគេ ប៉ុន្តែគេមិនព្រមស្តាប់អ្នកទេ អ្នកនឹងហៅទៅគេដែរ តែគេមិនឆ្លើយ តបនឹងអ្នកឡើយ ។
« ហើយព្រះអម្ចាស់មានព្រះបន្ទូលទៅគាត់ថា : « តើនរណាជាអ្នក និយាយ ?
ដែល បម្រើការ ក្នុង ការការពារ ជាតិ អស់ ជាច្រើន ឆ្នាំ ។
គាត់បាននិយាយថា យើងជឿលើព្រះអម្ចាស់របស់ អើរ៉ុន និងលោកម៉ូសេ ។ '
ដែល ទ្រង់ ប្រកាស ពី ការយាង មក នៃ ព្រះដែល បាន សន្យា ។ ដាស់តឿន ពួកគេ ឱ្យ " ភ័យខ្លាច
ប៉ុន្តែ បន្ទាប់ពី បាន ចូលរួម ក្នុង ថ្នាក់ អក្ខរកម្ម នៅ មជ្ឈមណ្ឌល សិក្សា សហគមន៍ ដែល គាំទ្រ ដោយ សហព័ន្ធ ជាតិ នៃ សមាគម យូណេស្កូ នៃ ប្រទេស ជប៉ុន ជីវិត របស់ នាង បាន ផ្លាស់ប្តូរ យ៉ាង ខ្លាំង ។
ការបង្រៀន របស់ ព្យាការី ទាំងអស់ គឺ ដូចគ្នា ហើយ ជា សាសនា នៃ ការចុះ ចូល នឹង ឆន្ទៈ របស់ ព្រះ។
នាងបាននិយាយថា៖ « ដូចជាសត្វដែលមានពន្លឺផុសចេញពីស្រមោល នោះស្រមោលក៏នឹងចេញពីពន្លឺដែរ » ។
17 - គាត់មាន ប្រសាសន៍ទៅគាត់ថា៖ « ប្រសិនបើឥឡូវនេះខ្ញុំបានពេញ ចិត្តចំពោះមុខអ្នក ហើយ សូមបង្ហាញទីសំគាល់ដល់ខ្ញុំថា អ្នក នោះជាអ្នកដែលនិយាយជាមួយនឹងខ្ញុំ ។
ដ្បិតសេចក្ដី ក្រោធរបស់ព្រះ បានបើកសម្ដែង មកពីស្ថាន សួគ៌ ប្រឆាំងនឹងរាល់អំពើទុច្ចរិត និងអំពើទុច្ចរិតទាំង ឡាយរបស់មនុស្ស ដោយទប់ស្កាត់សេចក្ដី ពិតដោយទុច្ចរិត ។
« មានពេលច្រើនជាងមួយខែសម្រាប់ការ រៀបចំ ។
ជាច្រើន បាន កើតឡើង ចំពោះ ខ្ញុំ ក្នុង រយៈពេល ប្រាំមួយ ឆ្នាំ ។
សូមបង្ហាញព្រះវរ បិតាមកយើង នោះវាគ្រប់គ្រាន់សម្រាប់យើងហើយ » ។
ខ្ញុំមិនអាចទៅ ណាបានទៀតទេ ព្រោះឥឡូវចាស់ហើយ » ។
គ្មានសេចក្ដី មេត្តា ណាដើម្បីឲ្យគេទទួលបានសេចក្ដី មេត្តា ក រុណាឡើយ ។
២៣ - ប្រសិនបើអ្នកនឹងធ្វើការ នេះ ហើយព្រះ បានបង្គាប់អ្នកដូច្នេះ នោះអ្នកនឹងអាចទ្រាំទ្រ ហើយប្រជាជនទាំងអស់នេះក៏នឹងទៅកន្លែងរបស់ពួកគេដោយសុខសាន្ត ។
យើងនឹងមាន ភាព ច្របូកច្របល់ ប៉ុន្តែវានឹងមានការ គោរព » ។
អ្វីដែល ខ គម្ពីរទាំងនេះនិយាយអំពីត្រូវបានបង្ហាញដោយ ខទីមួយ និងចុងក្រោយ ។
« តើអ្នកមិនឃើញទេឬអីថាអ្វីដែលចូល មកពីខាងក្រៅអាចធ្វើឲ្យគាត់ ' មិនស្អាត ' ទេ ?
2 គាត់បាន ស្មោះត្រង់នឹងព្រះ ដែលបានតែងតាំងទ្រង់ ដូចម៉ូសេ នៅក្នុងគ្រួសាររបស់ព្រះ ទាំងអស់ដែរ ។
ដូចជាព្រះ យេស៊ូវបានត្រូវចាត់ពីស្ថានសួគ៌មក នោះទ្រង់ក៏ចាត់អ្នក រាល់គ្នាឲ្យ មកក្នុងលោកីយ៍ » ។
អ្នក រាល់គ្នាប្រាថ្នាចង់បាន ហើយបង្ហាញសេចក្ដី សុចរិតសម្រាប់ខ្លួនអ្នក រាល់គ្នា ។
គេក្រាបចុះដល់ដី ហើយសិរី ‌ ល្អនៃព្រះ‌ យេហូវ៉ាបានលេចមកដល់គេ ។
នោះ ហើយ ជា ពេល ដែល ការបញ្ជាទិញ ជាមុននឹង បើក ហើយ ប្រសិនបើ អ្នក ធ្វើ តាម ការទិញ ឧបករណ៍ នោះ អ្នក នឹង ទទួលបាន វា នៅ ថ្ងៃទី 23 ខែសីហា ។
“ ខ្ញុំ មាន កូន បួន នាក់ ប៉ុន្តែ ខ្ញុំ មិន អាច បញ្ជូន ពួកគេ ទាំងអស់ ទៅ មហាវិទ្យាល័យ បាន ទេ ។
សូម ចាំ ថា វា គឺជា ហេរ៉ូឌ ដែល បាន នាំ អ្នកប្រាជ្ញ មកពី បូព៌ា ដើម្បី បកស្រាយ ទី សំគាល់ ។
ទោះបីជា ខ្ញុំ នៅក្នុង ទី ងងឹត ក៏ដោយ ។
20 ខ្ញុំគ្មានអ្នក ណាដូចគាត់ទេ ដែលយក ចិត្តទុកដាក់នឹងសុខុមាលភាពរបស់អ្នក ។
« ខ្ញុំបាននិយាយរឿងទាំងនេះប្រាប់អ្នក រាល់គ្នា ដើម្បីកុំឲ្យអ្នកជំពប់ដួល ។
ពិតប្រាកដ ណាស់ អ្នក ដែល មិន សារភាព ឈ្មោះ នេះ គឺ មិន នៅក្នុង ការពិត និង មិន ស្គាល់ ការពិត ទាំងស្រុង !
ព្រះនឹង ធ្វើ ដូច ដែល គាត់ បាន សន្យា ។
នៅ ពេល ដែល ស្រា រួចរាល់ ក្នុង រយៈពេល ពីរ បី ឆ្នាំ វា នឹង ត្រូវ ដាក់ ដប ហើយ បន្ទាប់មក ដឹកជញ្ជូន ទៅ អ្នក ។
ហើយអ្នកដែលធ្វើចំណាក ស្រុក ហើយត្រូវគេ បណ្ដេញចេញពីផ្ទះ
សម្តេចប៉ាបបានបន្ត ថា៖ « ហេតុអ្វីបានជាព្រះអនុញ្ញាតឲ្យមានសាសនាច្រើនម្ល៉េះ ?
គាត់ បាន រស់ នៅ ពី សមុទ្រ៖ ជា អ្នកនេសាទ ។
នៅ អាយុ របស់ អ្នក អ្នក ស្ថិត ក្នុង កម្រិត ដែល អ្នក គួរតែ មាន ប្រាជ្ញា ។
« បញ្ជូនពន្លឺនិងសេចក្ដី ពិតរបស់អ្នកចេញមក សូមឲ្យពួកគេដឹកនាំខ្ញុំ » ។
តើ អ្នកណា ត្រូវបាន អនុញ្ញាតឱ្យ ចូល ផ្ទះ របស់ យើង ?
ប្រជាជន មកពី ប្រទេស អ៊ីតាលី ផ្ញើ សារ ជូនពរ អ្នក ។
នៃ ជន ជាតិអេហ្ស៊ីបទាំង អស់ » ។
តើអ្នក និយាយថាបុរសទាក់ទាញ ស្ត្រីដែលមានទំនុក ចិត្តច្រើនជាងមនុស្សស្រីដែលគ្មានសុវត្ថិភាពឬ ?
យើងជឿជាក់ថានឹងមានការ ស្ទុះងើបឡើងវិញ កាន់ តែខ្លាំងនៅពេលដែលសង្វាក់ផ្គត់ផ្គង់មានស្ថិរភាព » ។
អ្នក គឺជា បូជាចារ្យ ជារៀងរហូត ។
ស្រដៀងគ្នាដែរ កូនចៅលេវីម្នាក់បានមកដល់កន្លែងនោះ ។
នៅពេល ណាមួយ ពួកគេនឹងត្រូវបានគេបោសសម្អាត » ។
អ្នក ឲ្យនិងអ្នកទទួលបានក្លាយជាមនុស្ស តែមួយក្នុងពេលយប់ ។
បន្ទាប់ពី ទាំងអស់ គាត់ បាន ក្រៀមក្រំ ជាមួយ វា ពីមុន មក ។
ប្រធានបទ សម្រាប់ ឆ្នាំ នេះ គឺ " ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ដែន សមុទ្រ ឥណ្ឌា - អាស៊ាន " ។
ភាព កខ្វក់ ពី ពួកគេ ។
បាន សម្រេច ហើយ ថា ប្រជាជន របស់ គាត់ ឥឡូវនេះ កំពុង រស់ នៅក្នុង យុគ នៃ បេះដូង ពីរ ។
ដូចគ្នាដែរ គាត់ ប្រោះឈាមទាំងព្រះ‌ពន្លា និងអ្វី ៗដែលប្រើក្នុងពិធីនោះ ។
ក្បាល របស់ ខ្ញុំ ឥឡូវនេះ គឺ ផ្តោត លើ ការប្រកួត បាល់ទាត់ ពិភពលោក ។
« សេចក្ដីសង្គ្រោះមិនមែនជារង្វាន់សម្រាប់មនុស្សសុចរិតទេ វាជាអំណោយសម្រាប់មនុស្សមាន ទោស » ។
បាន រង ទុក្ខ ដោយ ល្ងីល្ងើ ដើម្បី ឆ្លងកាត់ ការលះបង់ ។
ស្ដេចយាងទៅដល់ក្រុង សឡា អឹម ហើយគង់នៅ ទីនោះ ហើយសោយរាជ្យដោយសេចក្ដី សុចរិត មិនបានរំលងព្រះបញ្ញត្តិរបស់ព្រះ ឡើយ ។
« ចូរប្រយ័ត្ននឹងការ ស្តាប់របស់អ្នក ចុះ ដ្បិតអ្នក ណាដែលមាននឹងត្រូវឲ្យ កាន់ តែច្រើន ហើយអ្នកដែលមិនមាន សូម្បីតែអ្វីដែលខ្លួនគិតថាមាននឹងត្រូវដកចេញ » ។
ពួកគេ ក៏ អនុញ្ញាតឱ្យ អ្នក ប្រមូល គម្ពីរ រាប់ សិប ។
ហើយប្រទេស ជាតិមានការតក់ស្លុត និងសោក សៅ ។
ខួង នៅក្នុង វា ដែល ជា ប្រភព នៃ
ប៉ុន្តែពួកគេត្រូវបានរារាំងដោយកន្លែងដែលពួកគេរស់ នៅ » ។
ប្រជាជាតិទាំងពីរមាន ស ត្រូវដែលហាក់ដូចជាតាំង ចិត្តដេញតាមពួកគេរហូតដល់ចុងផែនដី ។
ជា លទ្ធផល ពួកគេ ភ័យខ្លាច ក្នុង ការរស់ នៅក្នុង ផ្ទះ របស់ ពួកគេ ។
« តើមនុស្សអ្នកនឹកដល់គាត់យ៉ាង ណា ហើយកូនមនុស្សដែលអ្នកមើលថែគាត់ ? » ។
ប្រាកដណាស់ថាពួកគេខ្លាច ប៉ុន្តែអ្នកផ្សេងទៀតបានចូល មកជួយ ។
យើង មាន វីដេអូ បណ្តុះបណ្តាល ថ្មី ៗ ទាំងអស់ ។
« ពួកគេទាំងអស់បានទុក អគារក្នុងស្ថានភាពមានសុខភាព ល្អ ។
៨ ពួកអ្នក បម្រើគ្រប់គ្រងលើយើង ហើយគ្មានអ្នក ណារំដោះយើងពីកណ្ដាប់ដៃរបស់ពួកគេឡើយ ។
ផល ប៉ះពាល់ ខាង សរីរវិទ្យា ) ប្រសិនបើ មាន ។
វាដូចជាយើងជាអ្នកទទួលខុសត្រូវ » ។
មាត់ របស់ គាត់ នឹង ថ្កោល ទោស គាត់ ក្រោម ទម្ងន់ នៃ កម្លាំង របស់ ព្រះ។
នៅចំពោះព្រះភក្ត្ររបស់ព្រះអង្គ ហើយគេក៏ចូលទៅក្នុងភូមិមួយរបស់ជន ជាតិសាម៉ារី
ខ្ញុំនិយាយអំពីអ្វីដែលខ្ញុំបានឃើញជាមួយនឹងបិតារបស់ខ្ញុំ ហើយអ្នក រាល់គ្នាធ្វើតាមអ្វីដែលអ្នក រាល់គ្នាបានឮពីបិតារបស់អ្នក ។
វា ត្រូវបាន ផ្តល់ឱ្យ អ្នក ដើម្បី ដឹង ពី អាថ៌កំបាំង នៃ នគរ ស្ថាន សួគ៌ ប៉ុន្តែ ចំពោះ ពួកគេ វា មិន ត្រូវបាន ផ្តល់ឱ្យ ទេ ។
ដូច ដែល បាន បង្កើតឡើង ភាព ផ្អែម របស់ ផ្លែ ស្ត្រ បឺរី គឺជា អ្វី ដែល ធ្វើឱ្យ ពួកគេ ឆ្ងាញ់ ។
គ្មាន សន្តិភាព សម្រាប់ មនុស្ស អាក្រក់ ទេ !
យើង ចង់ ចង្អុល ទៅការគោរព ប្រណិប័តន៍ របស់ យើង ហើយ និយាយ ថា " មើល ខ្ញុំ កំពុង ធ្វើ នេះ ត្រឹមត្រូវ ដូច្នេះ ច្បាស់ ណាស់ វា នឹង រាប់បញ្ចូល អ្វី មួយ នៅ ថ្ងៃ ជំនុំ ជំរះ " ។
នោះ ហើយ ជា ស្នូល នៃ ការជំរុញ របស់ ពួកគេ នៅ ពីក្រោយ វា ។
គ្មាន នរណា ម្នាក់ ជំពាក់ លុយ ខ្ញុំ ទេ ។
ប៉ុន្តែ ពួកគេ ត្រូវបាន រក្សាទុក ជា សម្ងាត់ ។
បំណែក ទាំងនោះ កំពុង ត្រូវបាន ដាក់បញ្ចូល គ្នា ខ្លះ នៅក្នុង ដំណោះស្រាយ ។
ចំណែក ឯប្រពន្ធរបស់ស្តេចវិញគឺមានទម្លាប់ដុតគេចោល ។
តើអ្នក និយាយយ៉ាង ណាថា៖ « សូមបង្ហាញព្រះវរ បិតាឲ្យយើងឃើញ ?
11 ហើយគាត់បន្តនៅ ទីនោះមួយឆ្នាំប្រាំមួយខែ ដោយបង្រៀនព្រះបន្ទូលនៃព្រះ នៅក្នុងចំណោមពួកគេ ។
ទ្រង់មិនខក ចិត្តពួកគេឡើយ ហើយការ អធិប្បាយរបស់ទ្រង់ចំពោះវាគឺមាន បន្ទូលថា « បទ គម្ពីរនេះកំពុងត្រូវបានសម្រេចនៅថ្ងៃនេះ » ។
វា នឹង ជួយ សង្រ្គោះ អ្នក នៅពេល ដ៏ អាក្រក់ បំផុត ។
គ្មាននរណាម្នាក់បានឡើងទៅស្ថាន សួគ៌ឡើយ លើកលែង តែព្រះអង្គដែលបានយាងចុះ មកពីស្ថាន សួគ៌ គឺព្រះរាជ បុត្រាជាមនុស្ស ។
ដូច្នេះ គាត់បានយកវាទៅ ប៉ុន្តែមិនបានចំណាយវាទេ ។
នៅ តែម្នាក់ឯង ប្រសើរជាងនៅ ជាមួយអ្នកដែលប្រព្រឹត្តអាក្រក់ ។
មិន មាន ការចង្អុលបង្ហាញ នៅក្នុង បទ គម្ពីរ ដែល ពួក សិស្ស នោះ ទេ ។ ហើយ ព្រះបន្ទូល គឺជា ព្រះ។
ជា ការពិត វា កាន់តែ ប្រសើរឡើង ។
11 អ្នកនឹងបានចម្រើនឡើងក្នុងគ្រប់មធ្យោបាយ ដើម្បីមាន ចិត្តទូលាយគ្រប់បែបយ៉ាង ដែលតាម រយៈយើងរាល់គ្នានឹងបង្កើតការ អរព្រះ‌គុណដល់ព្រះ។
ដូច្នេះហើយ បាន នាំមក នៅ គ្រា ដែល វា នឹង បញ្ជា តម្លៃ ល្អ ។
ដូច្នេះឥឡូវនេះ ចូរចាត់គាត់មក ឯខ្ញុំចុះ ដ្បិតគាត់នឹងស្លាប់ជាប្រាកដ !» ។
ការ មិនជឿគឺជាការសង្ស័យក្នុងសេចក្ដី ពិត ខណៈដែលការ បដិសេធគឺមិនព្រមធ្វើតាមសេចក្ដី ពិត ។
ព្រះគម្ពីរ ប្រាប់ យើង ថា យ៉ូសៀស ធ្វើ អ្វី ដែល ត្រឹមត្រូវ គឺ ពិបាក ណាស់ ។
ខ្ញុំបានឃើញការ ជិះ ជាន់របស់ប្រជាជនរបស់យើងនៅស្រុកអេស៊ីប ហើយបានឮ សម្រែករបស់គេ ។
គាត់បាននិយាយថា៖ « ខ្ញុំទើបតែនៅ Asolo បានពីរឆ្នាំប៉ុណ្ណោះ។
ខ្យល់បាននិយាយថា “ ខ្ញុំខ្លាំងជាងអ្នក ” ។
ទូរស័ព្ទ មក ខ្ញុំ នៅពេល អ្នក ។
និង ជ្រើសរើស បុគ្គលិក ដែល អាស្រ័យ លើ អ្នក សម្រាប់ ឆ្មាំ ឆ្នេរសមុទ្រ ទំនើប ។
អូខេ ខ្ញុំ ប្រាកដ ថា នេះ ជា អ្វី ដែល អ្នក កំពុង រង់ចាំ ។
វាបង្ហាញថាគាត់ ជាអ្នកកុហកដែលបានសម្រេចហើយគិតលេខ » ។
និយាយ ទៅកាន់ គាត់ ហាក់ដូចជា កូនក្មេង ។
ដែល ពួកគេ បាន ត្អូញត្អែរ យ៉ាង ជូរ ចត់ ។
ដូច ដែល ខ្ញុំ បាន និយាយ នៅក្នុង វេទិកា ។
ការធានា អាចនឹង លែង ត្រូវការតទៅទៀត ។
មើលពួកអាចារ្យ ហើយចាំមើលរឿងនោះ » ។
គ្រាន់តែ មាន ទូរស័ព្ទ មួយ ក្នុង ដៃ ?
៨ ហើយនៅទីក្រុងនោះមានសេចក្តី រីករាយ ជាខ្លាំង ។
បើអ្នកចង់បានសុភមង្គលក្នុងមួយឆ្នាំ ... ... ទទួលបានលាភសំណាង ។
ដូច្នេះ ពួកគេបានរស់នៅដូចជាអ្នក ក្រ ។ ហើយ ពួកគេ ស៊ាំ នឹង រឿង នោះ ។
ដូច្នេះ ពេលវាកើតឡើង អ្នកនឹងជឿ ។
ព្រះអម្ចាស់នឹងមិនស្ដាប់ខ្ញុំឡើយ ។
គាត់និយាយអំពី វិធីថ្មីមួយដើម្បីថ្វាយបង្គំព្រះ— ដោយវិញ្ញាណ និងសេចក្ដីពិត ។
តើ ដំណើរកម្សាន្ត នៅ ប្រទេស បារាំង របស់ អ្នក ជា អ្វី ?
អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាស្លាប់ក៏ដោយ ក៏អ្នកនោះនឹងមានជីវិត » ។
ទ្រង់ មិន មែន ជា ស្តេច ដែល ត្រូវបាន តែងតាំង ទេ ។ គាត់ គឺជា ស្តេច ពី កំណើត ។
តាមពិត ជោគវាសនា របស់ គាត់ មិន ត្រូវបាន គេ ដឹង ទេ ។
កូនស្រីរបស់ផារ៉ោនក៏នាំគាត់ឡើងជាកូនប្រុសរបស់គាត់ ។
ភាព បរិសុទ្ធ របស់ ទ្រង់ ចូលចិត្ត ហ៊ីបហប ។
លើសពីនេះទៅទៀតគឺធ្វើឡើងដោយប្រជាជាតិ
ពួកគេត្រូវបានគេមើលឃើញយ៉ាងច្បាស់ ហើយក៏មិនគួរតាម ដានដែរ ។
រវាង ជីវិត និង ការស្លាប់ ; សម្រាប់ការ នេះ
ប្រសិនបើខ្ញុំបញ្ជូនពួកគេទៅផ្ទះដោយអត់ឃ្លាន ពួកគេនឹងដួលនៅតាមផ្លូវ ព្រោះពួកគេខ្លះមកឆ្ងាយ » ។
ដូច្នេះ អ្នក អាច រីករាយ នឹង ជីវិត ដ៏ អស្ចារ្យ បំផុត ។
សង្ឃឹម ថា ខ្ញុំ នឹង ក្លាយជា អ្នករត់ ធម្មតា ម្នាក់ នៅ ពេល នោះ ។
( ៩) នេះជា សម្ដីគួរឲ្យទុក ចិត្តដែល សមនឹងទទួល យកទាំង ស្រុង ។
ស្រែក ប្រឆាំង គាត់ ហៅ គាត់ ថា ជា កូន របស់ ឧកញ៉ា
ទ្រង់គង់នៅជិតពួកគេ ទោះជាពួកគេមិនស្គាល់ទ្រង់ពីដំបូងក៏ដោយ ។
« លទ្ធផលនៃជីវិតរបស់អ្នកនឹងមិនត្រូវបានកំណត់ដោយអ្នក ដទៃទេ ប៉ុន្តែដោយអ្វីដែលអ្នក សម្រេចគឺមានសារៈសំខាន់បំផុតក្នុងជីវិតរបស់អ្នក ។
ភាគ ច្រើន នៃ ពួកគេ នៅ មាន ជីវិត ទោះបីជា អ្នក ខ្លះ បាន ស្លាប់ ក៏ដោយ ។
២ ពួកគេបានឃើញអ្នក កាន់តាមទ្រង់ខ្លះកំពុងបរិភោគអាហារដោយដៃ « មិនស្អាត » ។
៤ ខ្ញុំមិនអង្គុយជាមួយមនុស្សបោកបញ្ឆោតទេ ហើយខ្ញុំក៏មិនចូលរួមជាមួយនឹងមនុស្សមានពុតដែរ ។
គាត់ខ្លាចចាប់កូនគាត់ពេលគាត់ខឹង ។
គាត់ពិតជាមានប្រយោជន៍ក្នុងការ លាត ត្រដាងការ ពិត » ។
វា ពិតជា មិន ស្រួល ប្រសិនបើ អ្នក ត្រូវ រស់ នៅ ទីនោះ យូរ ។
គេថាក្នុងមួយឆ្នាំគេបំភ្លេចចោលទាំងអស់ ប៉ុន្តែគេខុស. .
អ្នក រាល់គ្នាមិនបានចូលទេ ហើយអ្នកបានរារាំងអ្នកដែលចូល » ។
និង ការមក រដូវ និង ពេល សម្រាល ។
ឥឡូវគាត់តាមខ្ញុំ » ។
កុំ មានអារម្មណ៍ ថា សេវា របស់ អ្នក មាន តម្លៃ តិចតួច ។
អត់ធ្មត់ នោះ គាត់ នឹង ផ្តល់ឱ្យ យើង នូវ អ្វី ដែល អស្ចារ្យ ។
តើអ្នកទទួល យកថាគ្មានអ្វីដែលអ្នកអាចធ្វើដើម្បីទទួលបាន ពរ ជ័យ និងព្រះគុណរបស់ព្រះ ទេ ?
បុរសនេះនៅជាមួយគាត់ ព្រោះគាត់ក៏ជាស្រុកកាលីឡេដែរ » ។
រហូតដល់ពួកគេបានស្ទាត់ជំនាញ ។
ហេន រី៖ នេះ ជា ប្រពន្ធ ខ្ញុំ ។
បន្ទាប់មក ធ្មេញដែល រ លុងចេញពីមាត់ ។
គាត់ និងទេវតាដែលដើរតាមគាត់ត្រូវបានបណ្តេញចេញដើម្បីបង្កើតកន្លែងសម្រាប់ការ ប្រោសមនុស្សស្លាប់ឲ្យ រស់ឡើងវិញ ។
ពួកគេនឹងមិនលែង លះគ្នាទេ ព្រោះពួកគេមិនអាចលៃល ក បាន ។
គាត់បាននិយាយថា « ពាក្យខ្ញុំមិនល្អឥត ខ្ចោះទេ ។
អ្នក ខ្លះ ជឿ ថា ពួកគេ មាន ទេវតា ថែរក្សា ។
បន្ត រហូតដល់ នាង ត្រូវបាន គេ នាំ មកវិញ ។
“ ខ្ញុំ គិត ថា ប្រជាជន អាហ្វហ្គានីស្ថានភាគ ច្រើន ទទួលបាន អត្ថប្រយោជន៍ ពី អ្វី ដែល យើង ធ្វើ នៅ ទីនេះ ។
ផ្ទះ របស់ អ្នក កំពុង ឆ្ពោះទៅ មុខ ជាមួយនឹង ការណែនាំ ជា ជំហាន ៗ ពី ការបង្រួម ។
ពួកគេត្រូវ តែបីនាក់ហើយ » ។
គាត់ មាន ចំណេះដឹង ជាច្រើន ដែល គាត់ បាន ចែករំលែក ជាមួយ យើង ។
ប្រធានបទ៖ ចុះអ្នកត្រូវបានឆ្លើយច្រើនដងហើយឬនៅ ?
ប៉ុន្តែ ឥឡូវនេះ ពួកគេ មិន ប៉ះ នំបុ័ង ទេ ។
បុរសនោះជាមនុស្សចម្លែក ហើយបើឈ្លោះគ្នាត្រូវប្រយ័ត្ន។
ទីបំផុតស្ត្រីនោះក៏ស្លាប់ទៅ។
ពួកគេបានឮព្រះ‌បន្ទូលរបស់ព្រះ‌ អម្ចាស់ ក៏វិលត្រឡប់ទៅវិញ មិនបានទៅ ត ទល់ នឹងយេរ៉ូ‌ បោមឡើយ ។
បន្ទាប់មក យើងបានដំឡើងវាសម្រាប់គាត់ ហើយធ្វើឱ្យប្រាកដថា គាត់ពេញ ចិត្តនឹងវាទាំង ស្រុង ។
ពេលគេចេញទៅជួបយើងដូចមុន យើងនឹង រត់ចេញពីគេ ។
ហើយបាន បញ្ចប់ការ សិក្សាដោយកិត្តិយស » ។
ពេលឃើញបុរសម្នាក់ កាន់កំហឹង
ដូចយើងត្រូវបានគេប្រាប់ថា៖ « បើអ្នក រាល់គ្នាមិនជឿថាខ្ញុំជាទ្រង់ នោះអ្នកនឹងស្លាប់ក្នុងអំពើ បាបរបស់អ្នក » ។
ហេតុអ្វីបានជាយើងឃើញច្រើនម្ល៉េះ
ដូច្នេះ អ្វី ៗ ទាំងអស់ គឺ ចេញពី ពួកគេ ។
ដំណឹងល្អគឺមាន ន័យសម្រាប់សត្វគ្រប់រូប ។
១៨ កាល ណាមនុស្សសុចរិតបែរចេញពីសេចក្ដី សុចរិតទៅប្រព្រឹត្តអំពើទុច្ចរិត នោះនឹងត្រូវស្លាប់ក្នុងនោះ ។
នៅ ទីនេះ ពួកគេ គឺ សម្រាប់ អារ៉ាប់ រួម៖
ពេលនោះ គេបានឮសំឡេងមួយយ៉ាងខ្លាំងពីលើមេឃ មក កាន់គេ ថា៖ « ចូរឡើង មក » ។ ហើយពួកគេបានឡើងទៅលើមេឃក្នុងពពក ខណៈខ្មាំង ស ត្រូវសម្លឹងមើល » ។
ដើមឈើនេះមិនត្រឹម តែមានគ្រឿង លម្អតូចៗប៉ុណ្ណោះទេ ហើយវាញ័រខ្លាំង ។
ប៉ុន្តែជំនឿ ស្មោះមាន ន័យថាពួកគេ « ពិត » ជាមួយនឹងព្រះ។
បុរស និង ស្ត្រី មាន ភាពស្មើគ្នា លើ គ្រប់ វិស័យ ជាពិសេស ទាក់ទង នឹង អាពាហ៍ពិពាហ៍ និង បញ្ហា គ្រួសារ ។
ហើយក្មេងស្រី រត់ទៅរកម្ដាយវិញថា ឱម្ដាយអើយ មេ បានធ្លាក់ចូលទៅក្នុងអូរ ហើយត្រូវគេដឹកទៅឆ្ងាយ ។
ហើយគាត់បាននិយាយមក កាន់ខ្ញុំថាចូលទៅហើយមើលទៅគួរស្អប់ខ្ពើមអាក្រក់ដែលពួកគេធ្វើនៅទីនេះ។
តើអ្នកមិនដឹងថាខ្ញុំមានអំណាចដោះលែងអ្នកឬក៏ឆ្កាងអ្នក ?
ប៉ុន្តែការ ឆ្លើយ តបរបស់ អ័ ប្រាហាំគឺច្បាស់ថា៖ « គេមានម៉ូសេ និងហោរាគួរតែស្តាប់តាម » ( លូក .
ពេលឃើញបុរសនោះអាណិតគាត់ ។
ទេវតាទទួល ស្វាគមន៍ព្រះអង្គ ហើយ នាំព្រះអង្គទៅផ្ទះនៅស្ថាន បរម សុខ ។
គាត់ នឹង មិន ចូល ទៅក្នុង កន្លែង សម្រាក របស់ ខ្ញុំ ទេ ។
ព្រះអាទិត្យ រះ ឡើង ហើយ ផ្ទៃ មេឃ ទាំងអស់ ក៏ ភ្លឺ ច្បាស់ ។
ខណៈពេល ដែល រីករាយ នឹង ការឈ្នះ ណាមួយ ។
គាត់ មាន គ្រួសារ នៅ ទីនោះ ។
ឈ្មោះ ក្លែងក្លាយ គឺជា ឈ្មោះ ផ្សេង ទៀត ដែល ម្ចាស់ ផ្ទះ ត្រូវបាន គេ ស្គាល់ ។
« ខ្ញុំប្រាប់អ្នក ជាប្រាកដថា ខ្ញុំ ជាទ្វារសម្រាប់ចៀម ។
នោះគឺជា សញ្ញានៃការ ជិះសេះដ៏ពិតប្រាកដ » ។
ហើយ អំពើ បាប មិន ត្រឹមតែ ប៉ះពាល់ ដល់ មនុស្ស មាន បាប ប៉ុណ្ណោះ ទេ ។ វា បំបែក នៅលើ ក្រណាត់ នៃ ផែនដី ទាំងមូល ។
ក្នុងចម្ងាយបួនជើងពីគាត់ ។
២៤ ប៉ុន្តែ លោកយេស៊ូមិនទុក ចិត្តលើពួកគេទេ ព្រោះលោកស្គាល់ពួកគេទាំងអស់ ។
ប្រយ័ត្នការ លើសចំណុះ ។
ប្តូរថាគាត់យក បន្ទុកដាក់ ទោស ។
“ អ្នកបានឃើញអ្វីដែលពួកគេកំពុងធ្វើចំពោះយើងក្នុង តង់ទីមួយ។
ការភ្លេចភ្លាំង ដែល មក ជាមួយ ។
បើមនុស្សស្រីនិយាយថានាងមិនអាចចេញក្រៅជាមួយអ្នកបានព្រោះនាងត្រូវរៀន
ប្រសិនបើ អ្នក កំពុង ស្វែងរក កន្លែង ថ្វាយបង្គំ ជា ទៀងទាត់
យើងមិនត្រូវធ្វើបែបនេះចំពោះកូនរបស់យើងឡើយ ។
ទ្រង់ ជាអ្នកគ្រប់គ្រងកំពូលលើគ្រប់ ការណ៍ទាំងអស់ ហើយយើងអាចមានទំនុក ចិត្តលើការ ផ្ដល់ដ៏ ស្មោះត្រង់របស់ទ្រង់សម្រាប់ រាស្ដ្រទ្រង់ ។
ព្រះ មាន បន្ទូលថា ចូរចាកចេញពីស្រុករបស់អ្នក ហើយទៅស្រុកដែលខ្ញុំនឹងបង្ហាញអ្នកចុះ ។
ព្រះបាន ដាក់ អំណាច របស់ គាត់ ក្នុង ការបម្រើ នៃ សេចក្ដីមេត្ដាក រុណា ។
ប៉ុន្តែ ព្រះបន្ទូលរបស់ព្រះ បានបន្តរីក ចម្រើនឡើង ។
ប៉ុន្មាន នាទី ទៀត កូន របស់ អ្នក នឹង នៅ ទីនេះ ។
ពួកគេបានប្រមូលផ្តុំគ្នានៅក្នុងផ្ទះដើម្បីអធិស្ឋាន និងសារភាពចំពោះគ្នាទៅវិញទៅមក ។
ទិញ និង ប្រើ ផលិតផល នេះ ។
គេបានបោះឆ្នោតហើយ តើមានបញ្ហាអ្វី ? » ។
ប៉ុន្តែគាត់ត្រូវបានសត្វ លាស្តីបន្ទោសចំពោះទង្វើខុសឆ្គងរបស់គាត់ដោយសត្វ លា ដែលនិយាយដោយសំឡេងមនុស្ស ហើយទប់ទល់នឹង ភាពឆ្កួតរបស់ហោរា ។
យ៉ាង ណាក៏ដោយ ព្រះ មិនសព្វព្រះហឫទ័យនឹងពួកគេភាគច្រើនទេ ព្រោះពួកគេត្រូវគេវាយ ប្រហារនៅវាល រហោស្ថាន ។
ខ្ញុំក៏ដូចអ្នកដែរពេលបាត់ បង់ឪពុក » ។
ពេលជំហានដ៏ ក្លាហានរបស់គាត់បានដួល រ លំ ដោយ សារខ្យល់និង រលក ពេត្រុសបានស្រែក រកព្រះ យេស៊ូ ។
ឥឡូវនេះ វត្ថុទាំងនេះនឹងត្រូវបាននាំ មកលើផែនដី ។
ដូច្នេះ ដានី យ៉ែលសរសើរព្រះ នៃស្ថាន សួគ៌ ។
លុះ មកដល់ត្រើយម្ខាងនៃសមុទ្រ គេសួរថា ព្រះគ្រូ តើអ្នក មកទីនេះនៅពេលណា ?
« មិនបានបែងចែករវាងយើងនិងពួកគេទេ ដ្បិតដោយ សារសេចក្ដី ជំនឿ ទ្រង់បាន ប ន្សុទ្ធ ចិត្តពួកគេ ។
ដូច្នេះ បងប្អូនអើយ ចូរមាន ចិត្តចង់ទាយ ហើយកុំហាមអ្នក ណានិយាយភាសា ដទៃឡើយ ។
មិត្តភក្តិ និង ក្រុមគ្រួសារ របស់ អ្នក មិន ស្គាល់ អ្នកទេ ។
ពួកគេមិនដែលខុសពីមុនមកទេ » ។
ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលទៅគាត់ ថា៖ « ស្ដេចមានព្រះ‌បន្ទូលដូច្នេះថា ចូរចេញមក !
ពេលអ្នក រកឃើញអ្នកដែលសម្លាប់គ្រួសារអ្នក អ្នកនឹងត្រូវបានអនុញ្ញាតឱ្យធ្វើការ សងសឹកទាំងអស់ដែលអ្នកចង់បាន » ។
រចនា ឡើង មិន បង្ក គ្រោះថ្នាក់ ដល់ ត្រី ដែល ដាក់ នៅក្នុង នោះ ។
ដើម ទំពាំងបាយជូរ នឹង បង្កើត ផល ។
« ខ្ញុំនឹងមិនប្រតិកម្មនឹងអ្វីគ្រប់យ៉ាងដែលគាត់ (Thakur) និយាយនោះទេ ។
ហើយដល់រណ្តៅទាំងមូលដែលអ្នកត្រូវបានជីក » ។
ពួកគេមិនការពារកូនកំព្រា ហើយក៏មិនមានមូលហេតុ
ប៉ុន្តែ ម៉ូសេ និយាយថា៖ « នោះមិនមែនជាសំឡេងនៃសង្គ្រាមទេ ។
ឃើញហើយត្រេកអរ » ។
គាត់ធ្វើបានយ៉ាងល្អ ហើយនឹងមានការ ដឹក ជញ្ជូនមកវិញនៅថ្ងៃ បន្ទាប់ ។
« ហើយ កាលព្រះ យេស៊ូវបានឃើញថាទ្រង់ឆ្លើយដោយប្រាជ្ញា នោះទ្រង់មាន បន្ទូលទៅគាត់ថា អ្នក នៅមិនឆ្ងាយពីនគរនៃព្រះ ទេ » ( ម៉ាកុស ១២: ៣៤) ។
ក្នុងពេលវេលាដ៏ សម គួរ ទ្រង់បើកសម្ដែងសេចក្ដី នេះតាមពាក្យរបស់ទ្រង់ ក្នុងការ អធិប្បាយដែលបានប្រគល់ឲ្យខ្ញុំ ដោយ បញ្ជារបស់ព្រះជាព្រះសង្គ្រោះនៃយើង
វា គឺ សម្រាប់ ខ្លួន គាត់ ប៉ុន្តែ ដើម្បី បង្ហាញ វា ។
ឬ ចំណាយ ពេល 2 នាទី ដើម្បី ស្វែងយល់ អំពី មនុស្ស ដែល អ្នក ជួប ដំបូង មុនពេល អ្នក ជួបជុំគ្នា ។
ហើយ នៅ ពេល ដែល ទ្រង់ បើក ត្រា ទី ប្រាំពីរ នោះ មាន ភាពស្ងៀមស្ងាត់ នៅលើ មេឃ ប្រហែល កន្លះ ម៉ោង ។
យើង ប្រហែលជា ប៉ុន្តែ យើង មិន រស់ នៅ លើ កសិដ្ឋាន ទេ ។
នៅពេល អ្នក ចាប់ផ្តើម យល់ មនុស្ស នឹង ធ្វើ ការមើល មួយចំនួន ។
រហូតដល់ ថ្ងៃ ដែល គាត់ ជំពប់ ដួល ហើយ ជាប់ ក្នុង អន្ទាក់ របស់ គាត់
ផ្តល់ឱ្យ អ្នក ដ៏ទៃ នោះ អ្នក នឹង ទទួលបាន រង្វាន់ ។
លោកបានមាន ប្រសាសន៍ថា “ ទោះ ជាយ៉ាង ណាក៏ដោយ ” អ្នកចាប់ផ្តើមដកពាក្យបណ្តឹងអំពីយុត្តិធម៌យ៉ាងឆាប់ រហ័ស ។
ហើយបានប្រព្រឹត្តចំពោះពួកគេ ដើម្បីឲ្យពួកគេច្រៀងសរសើរទ្រង់ ។
ហើយអ្នកដែលមានអំណាចគឺ ជាអ្នកគ្រប់គ្រង ។
... ៦ ដូចគ្នាដែរ ចូរដាស់តឿនយុវជនឲ្យចេះទប់ ចិត្ត ។
កុំ បង្ហាញ ភាពលំអៀង ក្នុង ការវិនិច្ឆ័យ ។
ព្រះអម្ចាស់ របស់ ខ្ញុំ គង់ នៅ ជាមួយ ខ្ញុំ ហើយ ទ្រង់ នឹង ដឹកនាំ ខ្ញុំ » ។
ឥឡូវនេះ យើងទាំងអស់គ្នានៅ ទីនេះនៅចំពោះព្រះភ័ក្ត្រព្រះ ដើម្បីស្តាប់គ្រប់ទាំងសេចក្ដី ដែលព្រះ អម្ចាស់បានបង្គាប់ឲ្យអ្នក រាល់គ្នាប្រាប់យើង »» ។
ឥឡូវនេះ ដោយសារ ព្រះគុណ របស់ ទ្រង់ យើង មាន សេរីភាព ។
ហើយការ ស្រេកឃ្លានយុត្តិធម៌ដល់ពួកយើងដែលមាននំប៉័ង ។
30 ហើយទ្រង់មាន បន្ទូល ថា៖ « តើយើងគួរប្រដូចព្រះរាជាណាចក្ររបស់ព្រះ យ៉ាងដូចម្ដេច ?
ប៉ុន្តែពួកគេកំពុងអង្គុយក្នុងដែនដី សន្យា ដោយស្តាប់រឿងនោះ ។
វា ត្រូវបាន បញ្ជូន ដោយ ប្រូតុង ។
តើពួកគេសុទ្ធតែជា គ្រូច្បាប់ឬ ?
មនុស្ស ទាំងនេះ ដែល អ្នក ត្រូវ នៅ ឱ្យ ឆ្ងាយ ពី ។
ខ្ញុំមិននិយាយថាពួកគេនឹងជោគជ័យទេ ប៉ុន្តែខ្ញុំគិតថាពួកគេនឹងព្យាយាមវា » ។
ពិភពលោក ត្រូវការ ភាព ពេញលេញ ពី អ្នក ។
គាត់បន្តថា៖ « ខ្ញុំគិតថា ជាអំណោយនិងជាបណ្តា សា ។
ថាទ្រង់នឹងត្រូវហៅថាជាអ្នក ណា សារ៉ែន ។
