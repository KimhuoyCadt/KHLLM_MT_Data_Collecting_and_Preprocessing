28 ពេលនោះ ពួកសិស្សសួរលោក ថា៖ « តើយើងត្រូវធ្វើអ្វីដើម្បីធ្វើ កិច្ចការដែលព្រះតម្រូវ ? » ។
ពួកគេ មាន មោទនភាព ចំពោះ ទ្រព្យសម្បត្តិ និង ទ្រព្យសម្បត្តិ ។
គាត់នឹង រកយុត្តិធម៌ដោយស្មោះត្រង់ ។
មិនអាចជឿ កាលពី ១០ ឆ្នាំមុន ។
៣ ដើម្បីឲ្យអ្នក រាល់គ្នាបានសុខ សប្បាយ ហើយរស់នៅលើផែនដីបានយូរ ។
ហើយជាអកុសល ខ្ញុំបានបាត់ បង់ វានៅទីនោះ » ។
រាប់ចាប់តាំងពីការ ឃើញ ការ ស្តាប់ ការ ភ្លក់ ។
៧ ព្រោះបុរសនោះមិនគួររំពឹងថាគាត់នឹងបានអ្វីពីព្រះ អម្ចាស់ឡើយ ៨ គាត់ជាមនុស្សមាន ចិត្តពីរ មិនស្ថិតស្ថេរក្នុងគ្រប់ផ្លូវរបស់គាត់ ។
អ្នក មើល នឹង លើកទឹកចិត្ត ពួកគេ គ្រប់ ជំហាន ។
៣ ដើម្បីឲ្យអ្នក រាល់គ្នាបានសុខ សប្បាយ និងមានអាយុវែងនៅផែនដី ។
នេះពិតជាសក្ខីភាពមួយចំពោះការងាររបស់ពួកគេ ។
ពួកគេ នឹង ត្រូវបាន ដុត ។
១៩ ពេលជន ជាតិយូដាជំទាស់ ខ្ញុំត្រូវ បង្ខំ ចិត្តប្តឹងទៅសេសារ ។
នឹង មិន សាបសូន្យ ឡើយ ហើយ ឥទ្ធិពល របស់ វា នឹង មិន ស្លាប់ ឡើយ ។
ប្រសិនបើ អ្នក មិន អាច ធ្វើ ការកែតម្រូវ បាន ទេ សូម កំណត់ ការរំលឹក ដើម្បី ធ្វើ ដូច្នេះ ។
17 « ចូរនឹក ចាំពីអ្វីដែលជន ជាតិអាម៉ាលេកបានធ្វើចំពោះអ្នកនៅតាមផ្លូវ ពេលអ្នកចេញពីស្រុកអេស៊ីប ។
(8) ហើយ ព្រះជា ម្ចាស់ ទ្រង់ អាច ធ្វើឲ្យ ព្រះគុណ ទាំងឡាយ មាន បរិបូរណ៍ ចំពោះ អ្នក ដើម្បីឲ្យ អ្នក មាន ភាព គ្រប់គ្រាន់ ក្នុង គ្រប់ កិច្ចការ គ្រប់ ពេលវេលា នោះ អ្នក នឹង បាន បរិបូរ ក្នុង គ្រប់ កិច្ចការ ល្អ ។
ប៉ុន្តែគ្មានបទល្មើសព្រហ្មទណ្ឌត្រូវបានបង្កើតឡើងទេ ( ប្រការ ៧) ។
អ្នកនឹងត្រូវបានរក្សាឱ្យបានជាប់នឹងផ្ទៃនៃនាង Have ។
បុរស ម្នាក់ នេះ ប្រហែលជា មាន ការប្រកួតប្រជែង ខ្លះ ។
ខ ទី ៥៖ « បន្ទាប់មក ពួកសាវ័កទូលព្រះ អម្ចាស់ថា ‹ សូមបង្កើនសេចក្ដី ជំនឿរបស់យើង ›» ។
ថ្ងៃ មួយ នាង បាន សរសេរ សំបុត្រ ទៅ គាត់ ។
១៥ ប្រហែលជាដោយហេតុនេះហើយបានជាគាត់ត្រូវបានឃ្លាតចេញពីអ្នកមួយ រយៈសិន ដើម្បីឲ្យអ្នកនឹងបានគាត់ត្រឡប់មកវិញ ជារៀងរហូត
ការសន្យារបស់គាត់គឺមិនមែនសម្រាប់មនុស្សបំពានទេ ។
តើវាសម្រាប់ ភាព រីករាយឬទេ ?
ខ្ញុំ ចូលចិត្ត វិធី ដែល គាត់ និយាយ ។
រដូវ ក្តៅ ពេល វា មកដល់
បើបុរស ណាដែលគ្មានប្រពន្ធបាន ស ហាយ ស្មន់នឹងស្ត្រីដែលមិនមានប្ដី ?
នឹង មិន ត្រូវបាន បំពេញ មុន កាលបរិច្ឆេទ ផុត កំណត់ នោះ ទេ វា មាន កម្រិត ខ្ពស់
« ថ្ងៃនេះជាថ្ងៃបរិសុទ្ធចំពោះព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នក កុំយំសោកឡើយ » ។
ខ្ញុំ សម នឹង រស់ នៅក្នុង ទីក្រុង ល្អ ។
ព្រះចៅផារ៉ោនបានចាត់ រទេះចំបាំងរបស់ព្រះអង្គទៅចាប់លោកម៉ូសេ និងប្រជារាស្ត្ររបស់ព្រះអង្គឡើងវិញ ។
ហើយតើអ្វីទៅជាគ្រួសារដែលរងការ ខូចខាតក្នុងការ ចាត់ចែងមនុស្សស្លាប់ ?
តើ យើង រស់ នៅក្នុង ប្រទេស ណាស៊ី អាល្លឺម៉ង់ ទេ ?
ខ្ញុំបានលក់ផលិតផលឲ្យពួកគេច្រើនណាស់ » ។
ហើយមាត់របស់គេត្រូវបានជាប់ជាមួយនឹងការ លោភលន់ដ៏ខ្លាំង ក្លា ។
អល់ ឡោះ ពេញចិត្ត នឹង នាង ។
ហើយបន្ទាប់ពីបានពិចារណាលើការ ឈ្លោះប្រកែកគ្នារបស់ដើមបណ្តឹងនិង សហការីរបស់គាត់ហើយ ពួកគេទាំងអស់គ្នា ។
ប្រាប់ គាត់ ថា ខ្ញុំ មាន ជំងឺ ប៉េស្ត ខ្មៅ ។
ព្រះ ពិរោធរបស់ព្រះ‌ អម្ចាស់កំពុងតែបង្ហូរ មកលើយើងយ៉ាងខ្លាំង ព្រោះបុព្វបុរសរបស់យើងមិនបាន កាន់តាមព្រះ‌បន្ទូលរបស់ព្រះ‌ អម្ចាស់ ដោយធ្វើអ្វីទាំងអស់ដែលមានចែងទុកក្នុងសៀវភៅនេះ » ។
ខ្ញុំ នឹង ប្រាប់ អ្នក ពី អ្វី ដែល រដ្ឋាភិបាល នឹង មិន ។
ប៉ុន្តែទាហានម្នាក់បានចាក់លំពែងចំ ចំហៀងខ្លួន ស្រាប់តែមានឈាម និងទឹកចេញ មក ។ អ្នកដែលបានឃើញវាបានធ្វើជាសាក្សី - ទី បន្ទាល់របស់គាត់គឺពិត ហើយគាត់ដឹងថាគាត់កំពុងនិយាយការ ពិត - ដើម្បីឲ្យអ្នក រាល់គ្នាជឿផង .
បងប្អូន ប្រុស ស្រី ជាទីស្រឡាញ់ របស់ ខ្ញុំ ខ្ញុំ រីករាយ ដែល បាន នៅ ជាមួយ អ្នក នៅ ល្ងាច នេះ ។
គាត់នឹង បង្វែរកូនចៅអ៊ីស្រា ‌ អែលជាច្រើនមក ឯព្រះ‌ អម្ចាស់ ជាព្រះ របស់ពួកគេ ។
« ចាប់តាំងពីលោកម៉ូសេ និងព្យាការីទាំងអស់ ទ្រង់បានពន្យល់ប្រាប់ពួកគេក្នុង បទគម្ពីរទាំងអស់អំពីអង្គទ្រង់ » ។
ហើយមុនការ ប្រកួតសងសឹករបស់ពួកគេ ពួកគេមានរឿងជាច្រើនដែលត្រូវនិយាយ ។
ហើយទ្រង់បាន សន្យានឹង រកឃើញដោយអស់អ្នកដែលស្វែង រកទ្រង់ដោយអស់ពី ចិត្ត ។
ដូច្នេះ ខ្ញុំនឹងដាក់ទោសគាត់ រួចដោះលែងគាត់ » ។
ដូច្នេះ ខ្ញុំនឹងដាក់ទោសគាត់ រួចដោះលែងគាត់ » ។
៩ គេដាក់មាត់ ទល់ នឹងផ្ទៃមេឃ ហើយអណ្ដាតរបស់គេខ្វែងលើផែនដី » ។
ពួកគេនៅជាមួយយើងឥឡូវនេះ ភាគច្រើនគឺ ៥, ៦, ៧ ឆ្នាំ ។
តាម រយៈទ្រង់ អ្នក ជឿលើព្រះ ដែលប្រោសទ្រង់ពី សុគត ហើយលើក ត ម្កើងទ្រង់ ដូច្នេះហើយ សេចក្ដី ជំនឿ និងសេចក្ដីសង្ឃឹមរបស់អ្នក គឺនៅក្នុងព្រះ។
ថ្ងៃ នេះ អ្នក ទំនងជា បាន ជួប មនុស្ស ម្នាក់ ដែល នឹង ណែនាំ អ្នក; ការណែនាំ របស់ ពួកគេ អាច ជួយ អ្នក បាន ច្រើន ។
១៣ ហើយខ្ញុំនឹងធ្វើអ្វីដែលអ្នកសូមក្នុងនាមយើង ដើម្បីឲ្យព្រះវរ បិតាបាន ត ម្កើងឡើងក្នុងព្រះ បុត្រា ។
ពេលនោះពួកគេបានដឹងថាពួកគេត្រូវបានគេឃ្លាំមើល ។
ទោះ ជាយ៉ាង ណាក៏ដោយ អ្នក ណាដែលទាបជាងនៅក្នុងនគរស្ថាន សួគ៌គឺធំជាងគាត់ ។
យើងខ្ញុំបានជឿ ហើយដឹងថាទ្រង់ជាព្រះ ដ៏ វិសុទ្ធនៃព្រះ» ។
ខ្ញុំនឹងទុកឱ្យពួកគេស្លាប់ដោយការ ឈឺចាប់បំផុត » ។
សិរីរុងរឿងនៃផ្ទះចុងក្រោយនឹង អស្ចារ្យជាងអតីត !
ប៉ុន្តែពេត្រុស និងសាវ័កបានឆ្លើយ តបថា « ចាំបាច់ត្រូវស្តាប់បង្គាប់ព្រះ ជាជាងមនុស្ស ( មនុស្ស - ពហុ វចនៈ )
អ្នក ដែល បំផ្លាញ ពិភពលោក នឹង ត្រូវ ទទួល ទោស ។
ពួកគេ មួយចំនួន ចាប់ផ្តើម សៀវភៅ មួយ ក្បាល ហើយ បន្ទាប់មក រ លុង នៅ ចំ កណ្តាល ការស៊ូទ្រាំ របស់ ពួកគេ និង បោះបង់ ចោល ការសរសេរ ខណៈ ដែល ពួកគេ ខ្លះ បញ្ចប់ សៀវភៅ ទាំងមូល ។
សេចក្តីស្លាប់ បង្អាក់ យើង ពី ការបញ្ចប់ ដែល យើង ប្រាថ្នា ក្នុង ជីវិត មួយ ប៉ុន្តែ វា ក៏ រំឭក យើង អំពី តម្លៃ នៃ ជីវិត នីមួយ ៗ ផងដែរ ។
អ្នកដែលបានទទួល ក្រឹត្យ វិន័យដែលបានដាក់ជា ធរ មានតាម រយៈពួកទេវតា ប៉ុន្តែមិនបានប្រតិបត្តិតាមទេ ។
គាត់ឆ្លើយ ថា៖ « លោកម្ចាស់ សូមអនុញ្ញាតឲ្យខ្ញុំឃើញ » ។
នាង ងក់ក្បាលហើយនិយាយថា « ឯងចម្លែក !
១៩ - ដ្បិតអ្វីដែលអាចដឹងអំពីព្រះ គឺច្បាស់សម្រាប់ពួកគេ ព្រោះព្រះ បានបង្ហាញវាដល់ពួកគេ ។
គ្មានអ្វីដែលនិយាយឡើងវិញដើម្បីជាប្រយោជន៍ដល់មនុស្សនៅលើផែនដីទេ ។
ចាំមើលថាខ្ញុំអាច រស់បានយូរប៉ុណ្ណាទៅ !
នឹងត្រូវបានគេហៅមកវិញទាំងអស់ , ថាតើពួកគេនឹងត្រូវបានគេរំលឹកយ៉ាងច្បាស់ ,
" នៅពេល អ្នក និយាយ អ្នក គ្រាន់តែ និយាយ ឡើងវិញ នូវ អ្វី ដែល អ្នកដឹង រួចហើយ ប៉ុន្តែ នៅ ពេល អ្នកស្តាប់ អ្នក អាចនឹង រៀន អ្វី ថ្មី " ។
តើយើងអាច ក សាងស្ពាននៃការ យល់ដឹងរវាងអ្នកដែលបានបម្រើនិងអ្នកដែលមិនមានដោយរបៀបណា ?
តើទាំងអំពើអាក្រក់និងអំពើល្អមិនចេញពីព្រះឱស្ឋរបស់ព្រះ ដ៏ខ្ពង់ខ្ពស់ឬ ?
ដំបូងអ្នកបាននិយាយថា៖ « ទំនួលខុសត្រូវគឺនៅលើគាត់អ្នក ទាមទារ ។
ព្រះមិន បាន បង្កើត យើង ជា ក្លូន ទេ ។
« ខ្ញុំដឹងថា ព្រះ មេស្ស៊ីដែលហៅថាគ្រិស្ដនឹង មក ។
ខ្ញុំ កំពុង ស្វែងរក សិស្ស របស់ ខ្ញុំ ។
សក់របស់ពួកគេដូចជាសក់ស្ត្រី ហើយធ្មេញរបស់ពួកគេដូចជាធ្មេញសិង្ហ ។
វា បាន មកពី សម្លៀកបំពាក់ របស់ បុរស ផ្សេង ៗ ។
ជន ជាតិយូដាទាំងអស់បានយល់ពីគំនិតនៃ ការប្រែ ចិត្ត ដ្បិតវាត្រូវបានបង្រៀនក្នុងចំណោមពួកគេ ។
ព្រះអម្ចាស់នៃពិភពទាំងមូល ជាព្រះ នៃ ជន ជាតិអ៊ីស្រាអែលមានព្រះបន្ទូល ថា៖ « មើល៍ យើងនឹងដាក់ទោសអាំម៉ូននៃក្រុងថេ បេស ព្រះចៅផារ៉ោន និងស្រុកអេស៊ីបព្រមទាំងព្រះ និងស្ដេចរបស់នាង ពិតជាផារ៉ោន និងអស់អ្នកដែលទុក ចិត្តលើទ្រង់ ។
អ្នក នឹង ធ្វើឱ្យ ចិត្ត របស់ ពួកគេ រឹងមាំ ហើយ យកចិត្តទុកដាក់ ចំពោះ ពួកគេ ។
ពេលនោះ យើងនឹងប្រគល់ដីនេះឲ្យកូនចៅរបស់អ្នក » ។
លោកបង្រៀននៅក្នុងសាលា ប្រជុំ ហើយអ្នក រាល់គ្នាសរសើរ លោក ។
ហើយ ប្រសិនបើ ខួរក្បាល គឺជា កំណត់ត្រា នៃ អតីតកាល នៅ ពេល ដែល ពួកគេ ចាប់ផ្តើម ថ្ងៃ របស់ ពួកគេ ពួកគេ កំពុង គិត រួចទៅហើយ ពី អតីតកាល ។
ហើយពោលថា “ គេបានយកទ្រព្យ សម្បត្តិ មកធ្វើទុក្ខ ដល់ញាតិ ‌ សន្ដាន ” ។
ប្រជាជាតិនានានឹងកោតខ្លាច ដល់ព្រះនាមរបស់ព្រះអម្ចាស់ ។
ប្រហែលជាខ្ញុំនឹងបន្តងឿង ឆ្ងល់អំពីពួកគេ ហ៊ឺ !
17 កុំងាកចេញពីអ្នក បម្រើរបស់ព្រះអង្គឡើយ ចូរឆ្លើយ តបមកទូលបង្គំជាប្រញាប់ ដ្បិតទូលបង្គំមានបញ្ហា ។
កូនប្រុសទាំងដប់ ប្រាំមួយនាក់ដែលមានឈ្មោះថា បញ្ញាបង្គរ ។
ពួកគេ នឹង បត់ ថយ ក្រោយ ដើម្បី ជួយ មនុស្ស ដែល មាន សិទ្ធិ
« ហើយព្រះយេស៊ូវបានចេញទៅមើលឃើញហ្វូងមនុស្សយ៉ាងច្រើន។
សេរី និយម ដែល បដិសេធ អត្ថិភាព នៃ ទេវតា ឬ វិញ្ញាណ ឬ ការរស់ ឡើងវិញ ។
( ម៉ាថា យ ២០: ២៥- ២៨ ) - « ប៉ុន្តែ ព្រះ យេស៊ូហៅពួកគេមក ហើយមានព្រះបន្ទូល ថា៖ « អ្នក រាល់គ្នាដឹងហើយថា អ្នកគ្រប់គ្រងរបស់ សាសន៍ ដទៃជាម្ចាស់លើពួកគេ ហើយពួកអ្នកធំ កាន់អំណាចលើពួកគេ ។
យក ភេសជ្ជៈ ផ្ទាល់ខ្លួន របស់ អ្នក និង កៅអី បត់ ។
នេះ មិន មែន ជា ការសង្គ្រោះ ក្នុង ជីវិត របស់ ព្រះទេ ។
គាត់នឹងស្រែកអង្វរព្រះអម្ចាស់ប្រឆាំងនឹងអ្នក ហើយអ្នកនឹងមាន ទោស ។
ជីវិត របស់ កុមារ កំព្រា ,
ដូច្នេះ ខ្ញុំបានអធិស្ឋានដល់ព្រះ នៃស្ថាន សួគ៌ ។
អ័ព្ទ ត្រូវបាន សន្មត ថា ជា ដូង ប្រេង ។
ប៉ុន្តែគេមិនជឿពាក្យរបស់លោកទេ ។
ខ្ញុំមិនអនុញ្ញាតឲ្យស្ត្រី ណាម្នាក់បង្រៀន ឬប្រើអំណាចលើបុរសឡើយ ។ នាង ត្រូវ នៅ ស្ងៀម ដ្បិត អ័ដាម ត្រូវបាន បង្កើតឡើង មុន បន្ទាប់មក អេវ៉ា ។
ចូរស្វែង រកព្រះ‌ អម្ចាស់ ដើម្បីឲ្យគេមានត្រចៀកស្តាប់ ) ។
ថ្ងៃទី ប្រាំពីរ នៃ សប្តាហ៍ កំណត់ ជា ថ្ងៃ ឈប់សំរាក និង ថ្វាយបង្គំ ។
ហោរា ឬអ្នកសុបិននោះត្រូវកាត់ទោស ប្រហារជីវិត ដោយ សារបានញុះញង់ឲ្យបះបោរប្រឆាំងនឹងព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នក ដែលបាន នាំអ្នកចេញពីស្រុកអេស៊ីប ហើយបានរំដោះអ្នកពីស្រុកនៃទាសភាព ។
អ្នក អាច មាន សិទ្ធិ ផ្សេង ទៀត នៅក្រោម ច្បាប់ នៅក្នុង រដ្ឋ របស់ អ្នក ។
ហើយតើការ នេះកើតឡើងចំពោះខ្ញុំយ៉ាងដូចម្ដេចបានជាមាតារបស់ម្ចាស់ខ្ញុំមក ឯខ្ញុំ ? » ។
ពេលអ្នកឮពាក្យ « បណ្ឌិតសាសនា ចក្រ » តើអ្នកគិតយ៉ាង ណា ?
ដេញ ដោយ ស្រទាប់ នៃ ការកុហក ។
គាត់ ស្វែងរក ការផ្តាច់ ខ្លួន និង បំផ្លាញ នូវ អ្វី ដែល ព្រះបាន បង្កើត សម្រាប់ ការពេញចិត្ត របស់ គាត់ ។
' តើខ្ញុំបានធ្វើអ្វីនឹងអ្នក ដើម្បីឱ្យអ្នកវាយខ្ញុំបីដងនេះ ?
ហើយពួកគេកំពុងតែឃើញវត្ថុដែលគេមិនគួរឃើញ » ។
បង ស្រី របស់ ខ្ញុំ មានអាហារ ច្រើន ។
ប៉ុន្តែទ្រង់នឹងមាន បន្ទូលទៅអ្នកថា ‹ ខ្ញុំមិនដឹងថាអ្នក មកពី ណាទេ ›» ។
( ហើយ ជើង របស់ ខ្ញុំ នៅតែ ស្រែក ដាក់ ខ្ញុំ សូម្បីតែ បួន ឆ្នាំ ក្រោយមក ។
ហើយ ពួកគេ ត្រូវបាន បង្ខំឱ្យ ប្រកាស វា ។
វានឹងកើតឡើងប្រសិនបើអ្នកពិតជាស្តាប់តាមព្រះសូរ សៀងនៃព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នក » ។
តើយើងចង់ឲ្យមនុស្សនិយាយអ្វីអំពីយើងបន្ទាប់ពីយើងបាត់ទៅ ?
នេះជា សាសន៍យូដាតែម្នាក់គត់ក្នុងចំណោមអ្នករួមការងាររបស់ខ្ញុំសម្រាប់នគរព្រះ ហើយពួកគេបានសម្រាលទុក្ខខ្ញុំ » ។
ហើយ ខ្ញុំ និយាយ ត្រូវ ដូច ភ្លៀង ។
« គ្មានអ្នក ណាម្នាក់ហ៊ានចូលរួមជាមួយពួកគេទេ បើទោះជាគេគោរពយ៉ាងខ្លាំងពីប្រជាជនក៏ដោយ ។
ធ្វើនេះដើម្បីចងចាំខ្ញុំ » ។
ខ្ញុំជឿជាក់ដូចលោកដាវីឌ ដែរ ។
ទោះជាយ៉ាង ណាក៏ដោយ ទោះបីជាពួកគេត្រូវបានគេសរសើរដោយជំនឿក៏ដោយ ក៏មិនបានទទួលអ្វីដែលបាន សន្យាដែរ ។
នេះ អាច បើក ផ្លូវ ទៅ រក ការអភ័យទោស ។
ពួកគេ នឹង បង្ហាញ ការសរសើរ តម្កើង ព្រះអម្ចាស់ ។
ការចង ដូច្នេះ ពួកគេ ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ ភព សៅរ៍ ។
បើយើងមិនធ្វើទេ គាត់នឹងសម្លាប់យើងដោយគ្រោះកាច ឬដោយដាវ » ។
បើអ្នក និយាយថាជំរាប សួរទៅដែលត្រូវបានដុតនំប៉័ងកូន ។
« ពេលអ្នកចូលទៅក្នុងផ្ទះមួយ ចូរស្នាក់នៅ ទីនោះរហូតដល់អ្នកចេញពីក្រុងនោះ ។
មុនពេល អ្នក ចាប់ផ្តើម ធ្វើការ នៅ ប្រទេស អូស្ត្រាលី អ្នក ត្រូវតែ ទទួលបាន ការអនុញ្ញាត ពី នាយកដ្ឋាន កិច្ចការ ផ្ទៃក្នុង ប្រសិនបើ អ្នក ជា អ្នក រស់ នៅ បរទេស ។
ដូចគ្នា នេះ ផងដែរ ថា រោម នៅលើ ស្លាប ធ្វើ តាម រូបរាង នៃ ស្លាប ។
បន្ទាប់ពី មេរោគ ត្រូវបាន បង្កើត និង ចែកចាយ តើ អ្នកណា ប្រើប្រាស់ វា ?
ព្រះយេស៊ូមានព្រះបន្ទូលសួរគេ ថា៖ « ហេតុអ្វីបានជាអ្នក រាល់គ្នាដេក ?.. . ចូរក្រោកឡើងអធិស្ឋាន ដើម្បីកុំឲ្យធ្លាក់ក្នុងការ ល្បួង » ។
« ឥឡូវនេះ កូនមនុស្សត្រូវបានលើក ត ម្កើង ហើយព្រះ ក៏ត្រូវលើក ត ម្កើងនៅក្នុងទ្រង់ ។
ដូច្នេះ យើងពិតជាអាចថ្វាយ បង្គំទ្រង់ ។
បើ ក្នុង ជីវិត នេះ យើង មាន សង្ឃឹម លើ ព្រះគ្រីស្ទ នោះ យើង ត្រូវ អាណិត ជាង មនុស្ស ទាំងអស់ ។
ហើយហេតុអ្វីបានជាមានរឿងនេះកើតឡើងចំពោះខ្ញុំ ដែលមាតានៃព្រះ អម្ចាស់ មករកខ្ញុំ ? » ។
ប្រសិនបើការ នោះស្ថិតនៅក្នុងអ្នក រាល់គ្នា ដែលអ្នកបានឮតាំងពីដើមដំបូងមក អ្នកក៏នឹងស្ថិតនៅក្នុងព្រះបុត្រា និងក្នុងព្រះបិតាដែរ ។
អ្វី មួយ ដែល ត្រូវ ញ៉ាំ នៅ ទីនោះ ផងដែរ ។
អ្នកមិនត្រូវធ្វើសម្ពន្ធ មេត្រីជាមួយគេ ឬជាមួយព្រះ របស់គេឡើយ ។
៣៥ ប៉ុន្តែទទួល យកមនុស្សពីគ្រប់ទាំង សាសន៍ដែលកោតខ្លាចទ្រង់ ហើយប្រព្រឹត្តត្រឹមត្រូវ » ។
ពេត្រុស អង្គុយ នៅក្នុង ចំណោម ពួកគេ ។
ប៉ុន្តែគាត់ធំ ឡើងលឿន » ។
១០ គ្មាន ឧបសគ្គ រវាង សាសន៍ យូដា និង សាសន៍ ដទៃ ទេ ។ បុរសនិងស្ត្រី ; ពួក បរិសុទ្ធ និង មនុស្ស មាន បាប ។
នាងបានគំរាមលោកទាំងមិនសប្បាយ ចិត្ត ថា៖ « លោកម្ចាស់នឹងមិនមានរឿងនោះទេ ទាល់ តែខ្ញុំបាន ឮគ្រប់យ៉ាង » ។
ខ្ញុំនឹងធ្វើអ្វីដែលអ្នក រាល់គ្នាសូមក្នុងនាមយើង ដើម្បីអោយព្រះបុត្រាបានសំដែងសិរី រុងរឿងដល់ព្រះបិតា ។
ខ្ញុំនឹងធ្វើអ្វីដែលអ្នកសូមក្នុងនាមខ្ញុំ ដើម្បីអោយព្រះបុត្រាបានសំដែងសិរី រុងរឿងដល់ព្រះបិតា ។
« តាមខ្ញុំ យល់ ភាគីកម្ពុជាបានបដិសេធចំពោះរឿងនេះ ។
វា គ្រាន់តែ ជា ការសម្រេចចិត្ត របស់ អ៊ីស្រាអែល ប៉ុណ្ណោះ ។
១៤ ដ្បិតព្រះទ្រង់នឹង នាំគ្រប់ទាំងការ វិនិច្ឆ័យ គ្រប់ទាំងការ លាក់កំបាំង មិនថាល្អឬអាក្រក់ឡើយ » ។
ហើយអ្នក ណាដែលយឺតក្នុងការ ប្រព្រឹត្តល្អ នោះនឹងមិនប្រញាប់តាម វង្សត្រកូលរបស់ខ្លួនឡើយ ។
បង ដាលី តើមានរឿងអីដែរ ?
ថ្ងៃ មួយ ដែល គ្មាន ព្រះអាទិត្យ អាច មើលឃើញ ដែល ធ្វើឱ្យ គេ ស្ទើរតែ មិន អាច ប្រាប់ បាន ថា ម៉ោង ប៉ុន្មាន ។
យើងមិនបាន ពន្យារពេលមួយថ្ងៃទេ » ។
ដូចគ្នានេះដែរ អ្នកដែលហៅប្រជាជនថាជាអ្នកទទួល រងនឹងមានទោសដូចគ្នានឹងអ្នកដែលដើរតាមគាត់ដោយគ្មានការបន្ថយទោសចំពោះអ្នកប្រព្រឹត្តល្មើស » ។
អ្នក មិន អាច ផ្លាស់ប្តូរ វា នៅ ពេល ក្រោយ បាន ទេ ដូច្នេះ សូម ប្រយ័ត្ន !
អា តែសប្បាយ ចិត្តដែលគេ បង្អត់ខ្លួនឯង !
ដូច្នេះការ ផាកពិន័យដែលបានកំណត់នៅក្នុង Sec ។
ដ្បិត យើង ជា ព្រះវិហារ របស់ ព្រះ ដ៏ មាន ព្រះជន្ម រស់ ។ ដូច ដែល ព្រះបាន និយាយ ថា
អធិស្ឋាន សម្រាប់ ម៉ារី ។
៧ កាលគេដាក់គេនៅ កណ្ដាលហើយ គេសួរ ថា៖ « តើអ្នកធ្វើការ នេះដោយអាងអំណាចអ្វី ឬដោយឈ្មោះអ្វី ? » ។
ព្រះ យេស៊ូមាន បន្ទូលថា៖ « ប្រសិនបើព្រះរាជបុត្រាដោះលែងអ្នក រាល់គ្នានឹងមានសេរីភាពពិតមែន » ។
ហើយខ្ញុំនឹងធ្វើអ្វីដែលអ្នកសូមក្នុងនាមយើង ដើម្បីឱ្យព្រះ បុត្រាអាចនឹង នាំសិរីល្អដល់ព្រះបិតា ។
មាន តែយុត្តិធម៌សម្រាប់អ្នក » ។
អ្នកនឹងធ្វើសម្រាប់ស្ថានីយទីបួននៅពេលដែលវាច្បាស់ ។
15 ព្រះ‌ អម្ចាស់ ជាព្រះ នៃបុព្វបុរសរបស់ពួកគេ បានចាត់ព្រះ‌បន្ទូលមកពួកគេ តាម រយៈអ្នក នាំ សាររបស់ព្រះអង្គម្ដងហើយម្ដងទៀត ពីព្រោះទ្រង់មានព្រះទ័យអាណិតដល់ប្រជារាស្ត្ររបស់ទ្រង់ និងទីលំនៅរបស់ទ្រង់ ។
ចូរមាន កម្លាំង និង ចិត្ត ក្លាហានឡើង ដ្បិតព្រះ‌ អម្ចាស់នឹងធ្វើដូច្នេះចំពោះខ្មាំង ស ត្រូវទាំងអស់របស់អ្នក » ។
យើងបានលក់អាវុធទៅឲ្យសាដាម ហ៊ូសេនហើយមែន ទេ ?
ដូច្នេះហើយ នៅ ពេល ដែល យើង មិន អាច ទ្រាំទ្រ បាន ទៀត នោះ ពួកយើង គិត ថា វា ជា ការប្រសើរ ជាង ក្នុង ការទុក អោយ នៅ ម្នាក់ឯង នៅ ទីក្រុង អាថែន ។
“ គ្រួសារខ្ញុំមិនមែនជាអ្នកមានឬអ្វីនោះទេ ។
រជ្ជកាលរបស់វានឹងមាន រយៈពេលខ្លី ព្រោះខែ ឧសភាប្រាកដជានឹងបង្កើតកំណត់ត្រាមួយទៀត » ។
គាត់ហៅនាយទាហាន មកសួរគាត់ថា តើលោកយេស៊ូបានសោយទិវង្គតឬទេ ?
'ពីអ្នកដែលបានត្រឡប់ទៅថ្វាយ បង្គំវូដិនវិញ តើអ្នក ណាទៀត ?
