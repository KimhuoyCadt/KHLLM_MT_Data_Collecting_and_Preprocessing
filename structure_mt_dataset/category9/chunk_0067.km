ព្រះអម្ចាស់មានព្រះបន្ទូល ថា៖ « នៅថ្ងៃនោះ យើងនឹងកាត់សេះរបស់អ្នកចេញពី កណ្ដាលអ្នក ហើយនឹងបំផ្លាញ រទេះចំបាំងរបស់អ្នក ។
អត្ថបទ បន្ទាប់ នាំ ខ្ញុំ ទៅ រក អ្នកដឹកនាំ របស់ អ្នក ។
អូ អ្នក នឹង មិន ជួយ ធ្វើឱ្យ អារម្មណ៍ នេះ ត្រឹមត្រូវ ទេ ។
ចូរ និយាយ អំពី ខ្ញុំ ជាមុន សិន បន្ទាប់មក អ្នក ។
ទាំងអស់៖ យើង ប្រគល់ មកវិញ នូវ ចំណែក នៃ អ្វី ដែល យើង បាន ទទួល ពី ព្រះអង្គ ដោយ ការដឹង គុណ
អ្នកដែលអាចគ្រប់គ្រងកំហឹងរបស់ខ្លួន » ។
« យើងបានជូនដំណឹងដល់ក្រុមគ្រួសាររបស់ប៉ូលអំពីរឿងនេះ » ។
ហើយមនុស្សសុចរិតជាច្រើននឹងឃើញ ហើយខ្លាច ហើយគេនឹងសើចដាក់គាត់ ។
ហើយនៅពេលពួកគេត្រឡប់មក រកយើងវិញ ពួកគេនឹងក្លាយជាអ្នកចម្បាំង និង ជាអ្នកដឹកនាំដែលមានសមត្ថភាពដឹកនាំប្រជាជនទាំងមូល » ។
សូមឲ្យយើងថយចុះដោយចេតនា ដើម្បីឲ្យអ្នក កើនឡើង ។
ហេល កាត និងជាយ ក្រុងរបស់វា រេ ហូប និងជាយ ក្រុងនោះ គឺជាក្រុងបួន ។
ខ្ញុំ បាន ឃើញ រឿង ជាច្រើន ក្នុង អំឡុង ពេល ធ្វើដំណើរ ។
ប៉ុន្តែពួកគេនឹងត្រូវប្រាប់រឿងមួយដល់ទ្រង់ដែលប្រុងប្រៀបនឹងវិនិច្ឆ័យមនុស្សរស់ និងមនុស្សស្លាប់ ។
ប៉ុន្តែ ពួកគេនឹងត្រូវប្រាប់រឿងមួយដល់អ្នកដែលប្រុងប្រៀបនឹងវិនិច្ឆ័យមនុស្សរស់ និងមនុស្សស្លាប់ ។
ប្រ៊ូស គឺ នៅ ពីមុខ អ្នក ។
ដូច ដែល ពួកគេ នៅក្បែរ គ្រែ និង រួមបញ្ចូល មួយ ឆ្នាំ ។
ចូរទាញពួកគេមក កាន់ខ្លួនឯង ដើម្បីឲ្យពួកគេបានដឹងថាទ្រង់ជានរណា ហើយមក កាន់សេចក្ដី ជំនឿចុះ » ។
« ទ្រង់នឹងយាងមកដូចជាអ្នក រាល់គ្នាបានឃើញទ្រង់យាងទៅស្ថាន សួគ៌ដែរ » ។
ជាមួយនឹង កំណើន សេដ្ឋកិច្ច របស់ យើង ក្នុង អត្រា 7% ក្នុង មួយ ឆ្នាំ ខ្ញុំ មាន ទំនុកចិត្ត ថា យើង នឹង អាច សម្រេចបាន នូវ ការខិតខំ ប្រឹងប្រែង នេះ ។
អ្នក គឺជារបស់ខ្ញុំតាម វិធី ណាមួយដែលខ្ញុំមិនយល់ ។
« ចូរដាក់ឈ្មោះគាត់ថា ឡូ - អាំមី ដ្បិតអ្នកមិនមែនជា រាស្ត្ររបស់ខ្ញុំទេ ហើយខ្ញុំក៏មិនមែនជាព្រះ របស់អ្នកដែរ ។
« ខ្ញុំ សង្ឃឹមក្នុងព្រះអម្ចាស់យេស៊ូថានឹងចាត់ធី ម៉ូថេមកអ្នកក្នុងពេលឆាប់ ៗ ...
ដូច្នេះ យើងមិនត្រូវធ្វើបែបនេះចំពោះកូន ៗរបស់យើងឡើយ ។
ដាក់ ពួកវា នៅលើ សន្លឹក ដុត នំ ដើម្បី កុំ ឱ្យ វា ចង្អៀត ។
គាត់ បាន សរសេរ សំបុត្រ មួយ ឱ្យ នាង ។
ខ្ញុំ ចង់ ដឹង ថា អ្នកណា រារាំង ខ្ញុំ ។
ព្យុះ ទីហ្វុង៖ មនុស្ស រាប់ ពាន់ នាក់ ត្រូវបាន សម្លាប់
ការអនុញ្ញាត ត្រូវបាន ផ្តល់ ហើយ គាត់ ទទួលបាន ចំណាត់ថ្នាក់ ល្អ ដាច់ គេ ។
ប៉ុន្តែនៅពេលដែលវាគ្រប់គ្រងដោយច្បាប់ វានឹងក្លាយទៅជាការ បញ្ជូនអារក្ស » ។
គាត់មិនធ្លាប់ធ្វើបែបនោះទេពីមុនមក ( សម្អាតបន្ទប់ចាក់សោ ) ដូច្នេះយើងដឹងថាគាត់ចង់ធ្វើជំនួញ » ។
១១) អ្នកត្រូវទទួលនូវអ្វីដែលអ្នក សុំពីខ្ញុំដោយការ សូត្រសូត្រ ។
ប្រជាជន ទាំងអស់ នៅលើ ផែនដី នឹង ថ្វាយបង្គំ សត្វ នេះ - អស់ អ្នក ដែល មាន ឈ្មោះ មិន ត្រូវបាន សរសេរ នៅក្នុង សៀវភៅ ជីវិត របស់ កូន ចៀម ដែល ជា កូន ចៀម ដែល ត្រូវបាន សម្លាប់ តាំងពី ការបង្កើត ពិភពលោក ។
ពេលនេះ គ្រូច្បាប់ខ្លះនិយាយទៅ កាន់ខ្លួនថា
សេចក្ដីមេត្ដាក រុណា ( មាន ន័យ ថា ត្រូវបាន សង្គ្រោះ ពី ទារុណកម្ម នៃ ឋាននរក ) ។
ច្រើន ណាស់ អ្វី ៗ ដែល ពួកគេ ផ្តល់ឱ្យ អ្នក គឺជា ធម្មជាតិ ទី ពីរ ។
ទាសករអើយ ចូរចុះចូលចំពោះចៅហ្វាយរបស់ខ្លួនដោយសេចក្ដី គោរព មិនត្រឹម តែចំពោះអ្នកដែលមាន ចិត្តល្អប៉ុណ្ណោះទេ តែក៏ចំពោះអ្នកដែលឃោរឃៅដែរ ។
ឬ ការដាក់ទណ្ឌកម្ម ។
ពួកគេនឹងនៅស្រស់សម្រាប់មួយសប្តាហ៍ឬដូច្នេះ ប៉ុន្តែទំនងជាពួកគេនឹងមិនមានរយៈពេលយូរនោះទេ !
ហើយបែរក្បាលទៅរកស្ដេចអារក្ស ឯទៀតដែលនៅក្បែរគាត់ ។
« ចំពោះអ្នក រាល់គ្នា វាត្រូវបានអនុញ្ញាតឲ្យយល់ពីអាថ៌កំបាំងនៃ នគរស្ថាន សួគ៌ ប៉ុន្តែចំពោះពួកគេ វាមិនត្រូវបានផ្តល់ឲ្យទេ ។
ដូច្នេះ វា ធ្វើឱ្យ អ្នក ខកចិត្ត ដូច្នេះ អ្នកជំទាស់ ។
មនុស្សជាច្រើនដែលបានឮព្រះបន្ទូលបានក្លាយជាអ្នកជឿ ហើយចំនួនរបស់ពួកគេបានកើនឡើងដល់ប្រហែលប្រាំពាន់នាក់ ។
អ្នក មិន អាច ជឿ ទុកចិត្ត លើ ក្រុមហ៊ុន ឯកជន នៅក្នុង តំបន់ នោះ ទេ ។
ប៉ុន្តែអ្នកអាចនឹងសួរថា « តើខ្ញុំផ្តល់ពេលដល់ព្រះ ដោយរបៀប ណា?
ពេល ណាមនុស្សអាក្រក់ស្លាប់ សេចក្ដីសង្ឃឹមក៏ រលត់ ហើយសេចក្ដីសង្ឃឹមរបស់អាក្រក់ក៏ រលត់ទៅ ។
ច្រើន ក្រោយមក នាង ត្រូវបាន ដោះលែង ។
ថា ពួកគេ គួរតែ ណែនាំ និង ដឹកនាំ វា ។
ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលដូច្នេះថា មើល អញនឹង នាំឲ្យមាន មហន្តរាយដល់ទីនេះ និងដល់អ្នកស្រុក សូម្បីតែពាក្យទាំងប៉ុន្មានក្នុងសៀវភៅដែលស្តេចយូដាបានអាន ។
ខ្ញុំ មាន កិច្ចការ ជាច្រើន ដែល ត្រូវ ធ្វើ នៅ សាលា ។
ពួកគេនិយាយថា៖ « គាត់គឺបេល សេប៊ូប ។
ហើយពួកគេនិយាយថា “ ខ្ញុំគិតថាគាត់ស្រឡាញ់ខ្ញុំ ហើយខ្ញុំស្រឡាញ់គាត់ ” ។
តើអ្នកពិតជាចង់ធ្វើវីដេអូ។
ព្រះ បានមាន បន្ទូលទៅ កាន់លោកម៉ូសេ ខណៈដែលបុរសម្នាក់និយាយជាមួយមិត្តរបស់គាត់ ។
អ្នក បម្រើប្រាប់អ៊ីសាកនូវការ ទាំងអស់ដែលគាត់បានធ្វើ ។
ព្រះ ពិរោធរបស់ព្រះ‌ អម្ចាស់ដ៏ខ្លាំងក្លា នឹងយើងរាល់គ្នា ពីព្រោះបុព្វបុរសរបស់យើងមិនបានស្តាប់តាមពាក្យក្នុងសៀវភៅនេះ ដើម្បីធ្វើតាមគ្រប់ទាំងសេចក្ដី ដែលមានចែងទុកអំពីយើង ។
18 ពីព្រោះអ្នក ណាដែលបម្រើព្រះ‌គ្រិស្ដតាមរបៀបនេះ អ្នកនោះគាប់ព្រះហឫទ័យព្រះជាម្ចាស់ ហើយមនុស្សលោកក៏ពេញ ចិត្ត ។
តាម រយៈទ្រង់ អ្នក រាល់គ្នាជឿលើព្រះ ដែលប្រោសទ្រង់ឲ្យមានព្រះជន្មរស់ឡើងវិញ ហើយលើក ត ម្កើងទ្រង់ ដូច្នេះហើយ សេចក្តី ជំនឿ និងសេចក្តី សង្ឃឹមរបស់អ្នក គឺនៅក្នុងព្រះ» ។
« តើអ្នក ណាដែលនិយាយហើយកើតឡើង លុះ ត្រា តែព្រះ អម្ចាស់មិនបានបង្គាប់ ? » ។
ប៉ុន្តែ នៅ ពេល ដែល ដៃ របស់ កងពល ត្រូវបាន គេ ដឹក ទៅ ដ៏ អស្ចារ្យ
ហើយត្រូវបានគេបង្ហាញថាជាការ ទាក់ទាញចម្បង។
ប៉ុន្តែ អ្នក ណាដែលឮព្រះបន្ទូលនៃព្រះ ហើយ កាន់តាមនោះប្រាកដជាមាន ពរហើយ » ។
វានឹងបង្ហាញអ្នក នូវក្រាហ្វមួយដូចជាឯកសារភ្ជាប់ ។
ក្រៅពីនេះ អ្នកអាចក្លាយជាស្ដេច » ។
ប្រយ័ត្ន - វារញ៉េរញ៉ៃ ប៉ុន្តែ ឆ្ងាញ់ ណាស់ !
គ្មាននរណាម្នាក់បានឡើងទៅស្ថាន សួគ៌ឡើយ លើកលែង តែអ្នកដែលចុះ មកពីស្ថាន សួគ៌ គឺជាបុត្រមនុស្សដែលគង់នៅស្ថាន សួគ៌ ។
នៅ ពេល នោះ លោក ម្ចាស់
អ្នក ណាដែលឮពាក្យអធិស្ឋាន មនុស្សទាំងអស់នឹងមក ឯអ្នក ... » ។
ហើយការ បកស្រាយវាដោយពន្លឺអំណោយផលបំផុតសម្រាប់ដើម បណ្តឹង » ។
ពេល ដល់ ពេល ត្រូវ ទៅ ទាំងអស់ គ្នា ។
ថ្ងៃដែលរឿងនេះកើតឡើង ខ្ញុំនឹងចូលនិវត្តន៍ ។
កុំស្ដាប់ហេសេគាឡើយ ដ្បិតគាត់កំពុងបំភាន់អ្នក ពេលគាត់មាន ប្រសាសន៍ថា « ព្រះអម្ចាស់នឹង សង្គ្រោះយើង » ។
ចាប់តាំងពីថ្ងៃនោះមក ម្ដាយ និងឪពុករបស់នាងបានក្លាយជាអ្នកមិនជឿចំពោះនាង ។
តើនេះជាអ្វីដែលជាការ គោរពបូជានៃសិទ្ធិអំណាច ទោះបីជាវាអំពីអំណាចឬ ?
2:12 ហើយនេះជាទីសម្គាល់ដល់អ្នក រាល់គ្នាថា៖ « អ្នក រាល់គ្នានឹងឃើញទារកដែលរុំខ្លួនដេកនៅក្នុងស្នូក » ។
ពួកគេឆ្លើយ ថា៖ « សូមឲ្យយើងម្នាក់អង្គុយនៅខាងស្ដាំដៃ ហើយម្នាក់ទៀតនៅខាងឆ្វេង ជាសិរីរុងរឿងរបស់អ្នក » ។
ចូរព្យាយាមឈរដោយលើកដៃឡើង ហើយបាត ដៃឡើងដូចជាអ្នកដែលទទួល ពរ ជ័យ ។
នេះ អាច ធ្វើឱ្យ វា មាន ប្រយោជន៍ ជាង របាំង ខ្មៅ ។
ក្នុងព្រះនាមនៃព្រះ‌ អម្ចាស់ ជាព្រះ របស់ព្រះអង្គ ។ ហើយគេនឹងនៅជាប់ ដ្បិតឥឡូវនេះ ទ្រង់នឹងមានឋានៈធំ ដល់ចុងផែនដី ។
បន្ទាប់មក គាត់ បាន បំពេញ នៅក្នុង របស់ យើង សម្រាប់ វិធានការ ល្អ ។
បើគេមិនអាចជួយបាន គេនឹងចូលទៅគាល់ស្ដេច ។
កុំត្រឡប់មកប្រទេសនេះ។
ពួកគេ ចង់ សម្លាប់ យើង ជាមុន សិន ។
ដូចអ្នកស្នាក់នៅបាននិយាយថា « ចិញ្ចឹមក្បាលអ្នក ។
២១ ប្រាកដណាស់ មនុស្សអាក្រក់នឹងមិនត្រូវបានគេផ្ដន្ទាទោសឡើយ ប៉ុន្តែពូជមនុស្សសុចរិតនឹងត្រូវបានរំដោះ ។
ដូច្នេះហើយ គាត់បានឈប់ ហើយងាកទៅរកម្តាយរបស់គាត់ ។
“ ម៉ាថា ម៉ាថា អ្នកខ្វល់ខ្វាយនឹងរឿងជាច្រើន ។
របប អាហារ អ្នក នឹង ចូលចិត្ត វា ។
ហានិភ័យ អត្រា ការប្រាក់ កម្ចី ។
ប៉ុន្តែពួកគេរឹងមាំ និងមានរាងស្អាត ។
មួយៗភ្លឺភ្នែកហើយដូចបានរៀបរាប់ខាងមុនអីចឹង !» ។
លុះចូលមកគាល់ព្រះរាជា ទ្រង់ក្រាបថ្វាយ បង្គំព្រះរាជា ដោយព្រះភក្ត្រដល់ដី ។
ជួសជុល នៅក្រោម ដៃ មួយ ។
នៅ ពេល ដែល ពួកគេ ធានា សិទ្ធិ នៃ ការកត់សម្គាល់ នោះ
មាន ហ្គេម ខ្នាត តូច ជាច្រើន ទៀត ។
ខទី ៣៣ ពួកគេទូលឆ្លើយ ថា៖ « យើងខ្ញុំជាកូនចៅរបស់លោកអប្រាហាំ ហើយមិនដែលបានធ្វើជាខ្ញុំបម្រើរបស់អ្នក ណាឡើយ តើលោកមាន ប្រសាសន៍ថា « អ្នកនឹងមានសេរីភាពយ៉ាង ណា ? » ។
ហើយបានថ្វាយ បង្គំនៅក្នុងព្រះវិហារ ។
កុមារ គឺ ពេញចិត្ត ; ម្ដាយគាត់ចេះចិញ្ចឹមគាត់ ហើយចិញ្ចឹមគាត់ពីមួយថ្ងៃទៅមួយថ្ងៃ ។
បើគេចូល ចិត្តស្រីស្អាត ហើយអ្នកជ្រើស រើសស្អាត ប្រញាប់ ។
អនុវត្តទោសពេញ លេញរបស់គាត់ ដើម្បីថាគាត់នឹងទទួល ទោសយ៉ាងល្អ » ។
ពួកគេ និយាយ អំពី គាត់ ឥត ឈប់ឈរ ។
នៅក្នុង សហភាព អឺរ៉ុប នា ពេល អនាគត ។
ធ្វើ វា ឱ្យ ជាប់ លាប់ នោះ អ្នក នឹង ចូលចិត្ត ខ្លាំង ណាស់ ។
ជាង ការផ្តល់ ច្រើន បំផុត កើតឡើង ។
47 ព្រះ‌ យេស៊ូបង្រៀនក្នុងព្រះ‌វិហារ ជារៀងរាល់ថ្ងៃ ។
ហើយយកគាត់ទៅដាក់លើផ្នូរឪពុកគាត់ ។
៤ ហើយប្រសិនបើសមរម្យដែលខ្ញុំទៅដែរ គេនឹងទៅជាមួយខ្ញុំ ។
ប៉ុន្តែខ្ញុំមិនចង់សម្លាប់មនុស្ស ១០ លាននាក់ទេ » ។
នេះក៏ជាអត្ថន័យនៃពាក្យដែលព្រះ មាន ព្រះភាគទ្រង់ត្រាស់ថា
ទាំង នេះ គឺជា ពរ ជ័យ និង ការសន្យា ។
ដើម្បី អោយ អ្នក រាល់គ្នា ដឹង ច្បាស់ អំពី អ្វី ៗ ដែល អ្នក បាន បង្រៀន ។
គាត់ ថែមទាំង បញ្ជា ដល់ វិញ្ញាណ អាក្រក់ ហើយ ពួកគេ ក៏ ធ្វើ តាម គាត់ ។
« គាត់នឹង មកបំផ្លាញអ្នកដាំទំពាំងបាយ ជូរទាំងនេះ ហើយនឹងប្រគល់ចំការ ដល់អ្នក ឯទៀត ។
ទោះបីខ្ញុំមិននៅខាងអ្នកក្នុងរូប កាយក៏ដោយ ក៏ខ្ញុំនៅជាមួយអ្នក រាល់គ្នាដោយវិញ្ញាណ ហើយខ្ញុំបានប្រកាសសាលក្រមអ្នកដែលធ្វើការ នេះរួចហើយ ដូចជាខ្ញុំមានវត្តមានដែរ ។
ដូច្នេះ កុំឲ្យអ្វីដែលព្រះ បានចូលរួមនោះត្រូវបានចែកដោយមនុស្សឡើយ » ។
វា ដូចជា ពួកគេ មិន ចង់ឱ្យ យើង ចូល ទៅក្នុង ប្រទេស ។
ប្រហែលជា អ្នក ប្រហែលជា មិន មាន មិត្ត ច្រើន ទេ ។
31 យើងដឹងថា ព្រះ មិនស្តាប់តាមមនុស្សមាន បាបទេ តែទ្រង់ស្តាប់តាមអ្នក ណាដែលថ្វាយ ‌បង្គំទ្រង់ ហើយធ្វើតាមព្រះ‌ហឫទ័យទ្រង់ ។
ជន ជាតិយូដាម្នាក់ពោលថា៖ « យើងនឹងទៅជាមួយអ្នក រាល់គ្នា ព្រោះយើងបានឮថា ព្រះ គង់នៅជាមួយ »
ពេលទឹកស្រក ណូអេ និងក្រុមគ្រួសារបានចុះពីទូកទៅជាមួយសត្វ ។
ប៉ុន្តែយើងបានឃើញវាដោយភ្នែករបស់យើងផ្ទាល់ » ។
ហើយឥឡូវនេះ ព្រះហស្តនៃព្រះ អម្ចាស់ស្ថិតនៅលើអ្នក ហើយអ្នកនឹងត្រូវខ្វាក់ខ្វាក់មើលមិនឃើញព្រះអាទិត្យមួយ រយៈ ។
នោះ គឺជា អ្នក ជា មិត្ត ជាទីស្រឡាញ់ របស់ ខ្ញុំ ។
ថ្ងៃ នេះ យើង អាច និយាយ យ៉ាង ច្បាស់លាស់ ថា របប កាដាហ្វី បាន ដល់ ទី បញ្ចប់ ហើយ ។
មួយវិញទៀត ហ្វូង មនុស្ស បាន មក រក ទ្រង់ ហើយ ដូច ដែល ទ្រង់ បាន ទម្លាប់ ទ្រង់ កំពុង បង្រៀន ពួកគេ ។
ហើយមានសមត្ថភាពការពារម្ចាស់របស់ខ្លួនរាល់ថ្ងៃ ។
នំប៉័ងដែលខ្ញុំនឹងឲ្យគឺសម្រាប់ខ្លួនខ្ញុំសម្រាប់ជីវិតនៃពិភពលោក » ។
វា គឺជា ការស្តាប់ បង្គាប់ ព្រះ ដែល កំណត់ភាព បរិសុទ្ធ របស់ អ្នក ជឿ នៅ ចំពោះ ព្រះ។
ទោះជា យ៉ាងណា ក៏ដោយ គ្រោងការណ៍ បែប នេះ នឹង ត្រូវការ កិច្ចព្រមព្រៀង របស់ ស៊ីរី ។
នៅ សម័យ នោះ យើង មាន ឧទាហរណ៍ មួយ នៅក្នុង ពេត្រុស ។
បេះដូង នៃ អ្នកស្មោះត្រង់
ឬ បុរស ណាមួយ ; ប៉ុន្តែ គាត់ ត្រូវបាន ហ៊ុំព័ទ្ធ ។
យល់និងយល់ ចិត្តចំពោះអ្វីដែលពិតជារំខានអ្នក ដទៃ ។
នេះមិនមែនជារឿងដែលខ្ញុំប្រាថ្នាចង់បានកីឡាករ A និង B នេះទេ ហើយបើគេមិនមក ខ្ញុំនឹងខឹង ។
7:6 ប៉ុន្តែខ្ញុំនិយាយថានេះជា សម្បទាន , មិនមែនជា បញ្ញត្តិ .
« អ្នក ណាដែលចង់ក្លាយជាអ្នកធំត្រូវធ្វើជាអ្នក បម្រើរបស់អ្នក
31:15 ពេលវេលា របស់ ខ្ញុំ គឺ នៅក្នុង ដៃ របស់ អ្នក ; សូមរំដោះខ្ញុំចេញពីកណ្តាប់ដៃខ្មាំង ស ត្រូវ និងពីអ្នកដែលបៀតបៀនខ្ញុំ ។
ស្នេហា របស់ ឆ្កែ ផ្សេង ទៀត ។
« ប្រសិនបើសេចក្ដី ដែលអ្នក រាល់គ្នាបានឮតាំងពីដើមដំបូងនៅក្នុងអ្នក នោះអ្នកក៏នឹងបន្តនៅក្នុងព្រះបុត្រា និងក្នុងព្រះវរ បិតាដែរ ។
ប្រាក់ឧបត្ថម្ភ និងការ មើលថែកូនប្រុស
ប៉ុន្តែ ខ្ញុំ ស្រឡាញ់ ទឹកភ្នែក នៅលើ មេឃ ។
7 ពេលព្រឹកឡើង អ្នកនឹងឃើញសិរី ‌ រុងរឿងរបស់ព្រះ‌ អម្ចាស់ ព្រោះព្រះអង្គបាន ឮអ្នកត្អូញត្អែរអំពីព្រះអង្គ ។
ដូច្នេះ ខ្ញុំមិនអាចសម្រេច ចិត្តថាមួយ ណាដែលខ្ញុំចូលចិត្តជាង ។
ប្រសិនបើ វា ត្រូវបាន ដុត គាត់ នឹង ទទួលរង ការបាត់បង់ ។ ខ្លួន គាត់ ផ្ទាល់ នឹង បាន សង្រ្គោះ ប៉ុន្តែ គ្រាន់តែ ជា មនុស្ស ម្នាក់ ដែល គេច ផុត ពី ភ្លើង ។
និង កុមារ នៅ គ្រប់ ជ្រុង នៃ ផែនដី
ការទទួលខុសត្រូវ ការបញ្ជាក់ ឡើងវិញ ( ទី បី ) នៃ ការធ្វើ ទារុណកម្ម និង ការបញ្ជាក់ ពី មូលហេតុ ។
បណ្ណាល័យ អតិថិជន របស់ អ្នកលក់ ត្រូវ ដំឡើង នៅលើ ម៉ាស៊ីន ភ្ញៀវ ។
« តើនរណាខ្លះចង់ត្រូវពួកតាលី បង់សម្លាប់ ? » ។
វា នឹង ត្រឡប់ បញ្ជី សញ្ញា សម្ងាត់ ។
ប្រឈមមុខ នឹង ការសង្ស័យ ខ្លួន ឯង និង ទុក្ខ ព្រួយ ។
ប្រជាជាតិអ៊ីស្រាអែលមិនត្រូវបានលើកឡើងក្នុងសៀវភៅនោះទេ ។
ទ្រង់បានតាំងពួកគេ ជារៀងរហូត ។
គាត់ បាន អធិស្ឋាន យ៉ូហាន ១៧ ។
ដែល អស់ រយៈពេល ជាច្រើន ឆ្នាំ
មនុស្ស សុចរិត នឹង មក រក ទ្រង់
ខ្ញុំ ជា មនុស្ស ស្អាត បំផុត សម្រាប់ គាត់
( លូកា 12:9) ប៉ុន្តែអ្នក ណាដែលបដិសេធខ្ញុំនៅចំពោះមុខមនុស្សលោកនឹងត្រូវបដិសេធនៅចំពោះមុខពួកទេវតារបស់ព្រះ។
គាត់ នឹង គាំទ្រ និង ការពារ អ្នក ។
វាក៏មិនត្រូវបានគេគោរពកោតខ្លាចដែរ ពីព្រោះវាត្រូវបានបង្កើតឡើងដោយព្រះគ្រីស្ទដើម្បីឲ្យគេបរិភោគ ។
« ខ្ញុំនឹងមិនសុំទេ ខ្ញុំនឹងមិនសាកល្បងព្រះអម្ចាស់ឡើយ » ។
តើអ្នក ជាមនុស្ស រវល់ ហើយអ្នកមិនមានពេលគ្រប់គ្រាន់សម្រាប់ការ សម្អាត ?
2 យ៉ាកុបខឹងនឹងនាង ហើយនិយាយថា៖ « តើខ្ញុំនៅក្នុងកន្លែងនៃព្រះ ( អេឡូហ៊ីម ) ដែលបានរារាំងអ្នកមិនឲ្យមានកូនឬ ?
និង ខ្នង របស់ ពួកគេ
អ្នក ណាដែលធ្វើខុសនឹងត្រូវសងចំពោះកំហុសរបស់ខ្លួន ហើយគ្មានការ រើស អើងឡើយ ។
សន្តិភាពខ្ញុំទុកឱ្យអ្នក សន្តិភាពរបស់ខ្ញុំផ្តល់ឱ្យអ្នក ... កុំឱ្យ ចិត្តអ្នក រាល់គ្នាតប់ ប្រមល់ ហើយកុំខ្លាចឡើយ " ។
ពេលឃើញខ្លួនគេឃើញថាពាក់ព័ន្ធ » ។
ទោះបីជា សំឡេង របស់ នាង មិន ត្រូវបាន គេ ឮ ; ដូច្នេះ អេលីស្មានថានាងស្រវឹង ។
តើគេយកអ្វីមកជាមួយ ហើយគេបន្សល់ទុកអ្វី ?
តើអ្វីដែលល្អជាងការ ឈរ អង្គុយ និងដេក ?
អ្នក បានអត់ធ្មត់ ដូច្នេះអ្នកនឹងទទួលបានរង្វាន់ ។
" អ្នកទាំងនោះស្លៀកពាក់អាវ ស តើពួកគេ ជាអ្នក ណា ហើយមកពីណា ? "
ប្រសិនបើ អ្នក ធ្វើ អ្នក នឹង ទទួលបាន ការព្រមាន
ជន ជាតិយូដានិយាយទៅគាត់ ថា៖ ‹ តើលោកមានទីសំគាល់អ្វីដើម្បីបង្ហាញយើងពីការ ធ្វើដូច្នេះ ? › ។
ក្នុងនាមជានិស្សិតបរិញ្ញាបត្រវ័យក្មេង គាត់បាននិយាយថា “ ខ្ញុំបានរស់នៅជាមួយនឹងសុបិនដ៏ អស្ចារ្យ ។
បើអ្នកមិនបោះបង់ទេ អ្នកនឹងត្រូវ បណ្ដេញចេញពីក្រុង » ។
ប៉ុន្តែគេស្រែកយ៉ាងខ្លាំងថា « ឆ្កាងវាទៅ !» ។
យ៉ាកុបបានបន្តដំណើរទៅ ហើយទេវតានៃព្រះ បានជួបគាត់ ។
បន្ទាប់មកគាត់បាននិយាយថា " អ្វីដែលខ្ញុំធ្វើពេលទំនេរគឺអាស្រ័យលើខ្ញុំច្រើនណាស់ " ។
ខទី ២៣៖ ប៉ុល និងបាណា បាសបានតែងតាំងពួកអែល ឌើរសម្រាប់ពួកគេក្នុងព្រះវិហារនីមួយ ៗ ហើយដោយការ អធិស្ឋាន និងការតមអាហារ នោះបានតាំងពួកគេចំពោះព្រះអម្ចាស់ ដែលពួកគេបានទុក ចិត្ត ។
ព្រះ បានកំណត់ការ ចុះចូលរបស់ស្ត្រីដល់បុរស ជាផ្នែកមួយនៃការ បង្កើតដ៏ល្អរបស់គាត់ ។
« មក ខ្ញុំនឹងបង្ហាញកូនក្រមុំ ជាប្រពន្ធកូនចៀម » ។
ប៉ុន្តែ ខ្ញុំនឹងប្រកាសអំពី ការ នេះជារៀងរហូត៖ ខ្ញុំនឹងច្រៀងសរសើរដល់ព្រះ របស់យ៉ាកុប ។
អ្នកទទួលភ្ញៀវនិយាយថា “ ហេតុអ្វីបានជាអ្នកហៅយើង ?
ត្រូវ ប្រាកដ ថា ជំនួស ជាមួយនឹង ឈ្មោះ អ្នកប្រើប្រាស់ ។
ភាព សម្រាប់ មនុស្ស និង សម្រាប់ ព្រះ។
ថ្ងៃ នេះ គេ ព្យាយាម សម្លាប់ ខ្ញុំ ។
៤ ហើយគ្មានអ្នក ណាយកកិត្តិយស មកលើខ្លួនឡើយ ប៉ុន្តែគាត់ត្រូវបានព្រះ ហៅដូចលោកអើរ៉ុនដែរ ។
និក្ខម នំ 9:12 ប៉ុន្តែ ព្រះ‌ អម្ចាស់ធ្វើឲ្យព្រះចៅផារ៉ោនមានព្រះ‌ហឫទ័យរឹងមាំ ហើយព្រះអង្គមិនព្រមស្ដាប់លោកម៉ូសេ និងអើរ៉ុន ដូចព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលមក កាន់លោកម៉ូសេ ឡើយ ។
តើ អ្វី ជា វិធី ល្អ បំផុត ដើម្បី ទទួលបាន ប្រាជ្ញា ?
នៅលើ កុំព្យូទ័រ របស់ អ្នក ?
« ឥឡូវនេះ ស្ដីអំពី ការ រៀបអភិសេក ខ្ញុំមិនមាន បញ្ជាពីព្រះ អម្ចាស់ទេ ប៉ុន្តែខ្ញុំទុក ចិត្តវិនិច្ឆ័យអ្នកដែលគួរឲ្យទុក ចិត្តដោយព្រះហឫទ័យមេត្តា ក រុណារបស់ព្រះអម្ចាស់ ។
អាវយឺ ត៖ ខ្ញុំ ភ្ញាក់ ឡើង បែប នេះ
គ្មានអ្នក ណាថ្លង់ជាងអ្នកដែលមិនស្តាប់ ហើយក៏គ្មានអ្នក ណាខ្វាក់ជាងអ្នកដែលមិនព្រមមើលដែរ ។
នាងអង្វរគាត់ឲ្យមានមេត្តា ។ គាត់ បាន រំលោភ នាង ម្តង ទៀត ។
ខ្យល់ដូច្នេះហើយបានធ្លាក់ចុះ មក :
សម្រាប់អ្នក ណាដែលចង់ដាស់តឿនខ្ញុំ សូមទទួលវា ។
មាន ពរ ហើយ អ្នកណា ដែល មក ក្នុង ព្រះនាម នៃ ព្រះ។
នេះ ជា កន្លែង ដែល អារក្ស ចូល ។
ហើយទ្រង់មាន បន្ទូលទៅគេថា “ ខ្ញុំបានឃើញសាតាំងធ្លាក់ចុះ មកដូចផ្លេកបន្ទោរពីស្ថាន សួគ៌ ។
ដូច្នេះ មើល ចុះថ្ងៃនេះ ខ្ញុំ មកជាលើកដំបូងក្នុងចំណោម វង្សយ៉ូសែបទាំង អស់ ដើម្បីចុះទៅជួបនឹងស្តេចរបស់ខ្ញុំ » ។
ពួកគេចង់ប្រើកម្មវិធីបើកចំហ របស់ ខ្ញុំ ( ចុះ កាលបរិច្ឆេទ ) ហើយជាក់ស្តែងខ្ញុំបានអនុញ្ញាតឱ្យពួកគេ។
« ឪពុករបស់ខ្ញុំ ជាអ្នក បម្រើរបស់អ្នកបាននិយាយមក កាន់យើងថាអ្នកដឹងថាប្រពន្ធរបស់ខ្ញុំមានកូនប្រុសពីរនាក់នៅខាងខ្ញុំ។
អ្នក ដឹង អំពី អត្ថប្រយោជន៍ ដែល ពួកគេ មាន លើ អ្នក ឬ អំពី អត្ថប្រយោជន៍ ដែល អ្នក ពេញចិត្ត ចំពោះ ពួកគេ ។
ចូរលាងជម្រះពួកគេឲ្យឆ្ងាយដូចជាអំពើ បាប
ហើយ មនុស្ស ដែល មិន ចង់ ប្រឈមមុខ នឹង ការពិត
អ្វី ដែល ខ្ញុំ មិន អាច ធ្វើ បាន នៅពេល ខ្ញុំ មក ទីនេះ ខ្ញុំ អាច ធ្វើ បាន ឥឡូវនេះ ។
តាម រយៈទ្រង់ អស់អ្នកដែលជឿបានរាប់ជាសុចរិតពីអ្វីៗទាំង អស់ ដែលអ្នកមិនអាចរាប់ជាសុចរិតដោយក្រឹត្យ វិន័យរបស់លោកម៉ូសេ ឡើយ ។
28 អ្នក រាល់គ្នាជាអ្នកដែលនៅ ជាមួយខ្ញុំក្នុងការ ល្បួងរបស់ខ្ញុំ ។
សត្វ ផ្សោត មិន ទាន់ មាន
លោកបានហៅបាឡាម ជាកូនរបស់លោកបេអ៊រ មកដាក់បណ្តា សា លោក ។
គ្មាន សញ្ញាជញ្ជាំងត្រូវលាត ពីកំពូលជញ្ជាំងដែលគេដាក់នោះទេ ។
សូមផ្ញើសំបុត្រមួយច្បាប់ទៅស្ដេចអ៊ីស្រាអែល » ។
៤០ ប៉ុន្តែអ្វី ៗទាំងអស់ត្រូវធ្វើដោយសមស្រប និងរបៀប រៀបរយ ។
' តើអ្នក ជាអ្នកដែលត្រូវមកឬយើងគួររំពឹងទុកអ្នកផ្សេង ?
គាត់បាននិយាយថា៖ “ មានមួយមុននោះ ហើយមានមួយបន្ទាប់ពីគ្រាប់បាល់ដែលគាត់បានចេញ មក ។
ប៉ុន្តែពេលគេជាប់គាំង តើអ្នក ទុកវាឲ្យស្លាប់ឬ ?
ដូច្នេះ ទោះបីខ្ញុំមានទំនុក ចិត្តយ៉ាងខ្លាំងទៅលើព្រះ គ្រីស្ទ ហើយអាចបង្គាប់អ្នកឲ្យធ្វើអ្វីដែលត្រឹមត្រូវក៏ដោយ ។
នៅលើសេចក្ដី ជំនឿ និងការប្រែ ចិត្ត ដូច្នេះហើយវាមិនបន្តទៀតឡើយ ។
ក្រៀមស្វិតមុនពេលវេលា ហើយដើមរបស់វាធ្ងន់ដោយស្លាប់ ។
ហើយមិនផ្តល់ឱ្យភាគីទី បីណាមួយឡើយ ។
៣៣ អ្នកដែលទទួល យកទី បន្ទាល់របស់ទ្រង់បានបញ្ជាក់ថា ព្រះពិត ។
បើធ្លាក់ក្នុងដៃខុស !» ។
ផ្នែក នៃ ការលក់ គឺជា របស់ អ្នក ។
បោះចោល ការសង្ស័យ របស់ អ្នក បើ មិន ដូច្នេះ ទេ អ្នក នឹង ត្រូវ ដាក់ទណ្ឌកម្ម ចំពោះ ការ មិន ជឿ របស់ អ្នក ។
« ទោះបីជាមានពាក្យទាំងនេះក៏ដោយ ក៏ពួកគេមានការ លំបាកក្នុងការ រារាំងហ្វូង មនុស្សកុំឲ្យលះបង់ចំពោះពួកគេដែរ ។
ពិបាកពេកដែលអ្នកគ្រាន់ តែប្រាប់ខ្ញុំ ?
ប្រាកដណាស់ អ្នក បានមករកខ្ញុំដោយពាក្យសង្កត់ សង្កិន ។
នៅ ពេល ដែល មាន សន្តិភាព នៅក្នុង ចិត្ត វា នឹង បង្ហាញ នៅលើ មុខ ។
នៅ ថ្ងៃ នេះ យើងអធិស្ឋានសម្រាប់ពួកគេ ហើយទទួលបានការ អធ្យាស្រ័យសម្រាប់ពួកគេដើម្បីពួកគេ។
យើងនឹងប្រមូលពួកគេពីគ្រប់ទិស ទី ហើយ នាំពួកគេត្រឡប់ទៅស្រុកវិញ ។
តើអ្នកបានទទួលស្គាល់សម្រស់សមុទ្រហើយតើវារីក ដល់កម្រិតណា ?
រន្ធញើសរបស់ពួកគេបានបើក ហើយពួកគេនឹងទទួលបានរសជាតិ កាន់ តែច្រើន ។
« មើលទៅប្រជាជាតិនានា ហើយភ្ញាក់ផ្អើលយ៉ាងខ្លាំង ។
គាត់ស្នាក់នៅផ្ទះរបស់ស៊ីម៉ូន ជាអ្នកធ្វើសាច់ ។
១៦ « តើយើងត្រូវធ្វើយ៉ាង ណាចំពោះបុរសទាំងនេះ ? » ។ - ច្បាស់ណាស់ចំពោះអ្នក រាល់គ្នាដែល រស់នៅក្រុងយេរូសាឡិមថា អព្ភូតហេតុដ៏ អស្ចារ្យមួយបានកើតឡើងតាម រយៈពួកគេ ហើយយើងមិនអាចបដិសេធបានឡើយ ។
ប៉ុន្តែ ខ្ញុំ គោរព គាត់ ជា បុរស ។
ខ្ញុំមិនមែនជាអ្នក នយោបាយទេ ប៉ុន្តែខ្ញុំសូមឲ្យគ្រប់ភាគីអត់ធ្មត់ ។
