តើ អ្នក មាន ការភ័យខ្លាច ពេលវេលា ទេ ?
រឿង ល្ខោន គឺ គ្មាន អ្វី ថ្មី សម្រាប់ ក្រុម របស់ អាមេរិក ទេ ។
យើងនឹងធ្វើឲ្យអ្នក រាល់គ្នាកើនចំនួនមនុស្សជាច្រើនលើអ្នក រាល់គ្នា ជា វង្សអ៊ីស្រាអែលទាំងអស់ ហើយក្រុងទាំងនោះនឹងមានមនុស្ស រស់នៅ .. .
វា បើក ទ្វារ ឱ្យ អ្នក បន្ទាប់មក កំណត់ ការ ណាត់ជួប ។
គេមិនដឹងថាស្ត្រីរូបនេះស្លាប់យូរប៉ុណ្ណាទេ ។
ថ្ងៃមួយយើងឃើញគាត់យំ ហើយយើងក៏រត់ចេញទាំង ខ្មាស ។
អ្នក ណាដែលជឿលើខ្ញុំ ទោះជាសេចក្ដី ស្លាប់មកដល់ក៏ដោយ ក៏នឹងមានជីវិតជារៀងរហូត » ។
រុក្ខជាតិ បី ផ្សេង ទៀត មាន ផ្លែ ច្រើន ។
តើ នរណា ជា អ្នកសម្លាប់ បុរស ម្នាក់ នេះ ?
ហើយគាត់មាន ប្រសាសន៍ម្ដងទៀតថា « តើខ្ញុំគួរប្រៀបធៀបព្រះរាជ្យនៃព្រះទៅអ្វី ?
ផឹកមុនថ្ងៃត្រង់ មិនមែនមាន ន័យថាស្រវឹងមុនម៉ោង១២ យប់ទេ !
វា ដូចជា ប្រសិនបើ ពួកគេ លើក ដៃ សរសើរ អ្នក បង្កើត របស់ ពួកគេ ហើយ បន្ទាប់មក បាន ចំណាយ បោះ ផ្កា របស់ ពួកគេ ចុះ នៅ ជើង របស់ ពួកគេ ។
ច្រើន ណាស់ សម្រាប់ សត្វ ព្រៃ បរិភោគ អ្វី ដែល ល្អ សម្រាប់ ពួកគេ ។
ពួកគេ មិន ត្រូវបាន គេ មើលឃើញ ទេ លើកលែងតែ ឥទ្ធិពល របស់ វា ។
តន្ត្រី មិន តែងតែ ភ្លាម ៗ ទេ ។
ពួកគេឆ្លងកាត់ផ្លូវប្រាក់ មាស និងពេជ្រ រហូតដល់ទៅដល់បឹង ហើយចូលទូកទាំងបី ។
វត្ត អារាម សំខាន់ ៗ នៅ ទីនេះ ។
5 បន្ទាប់ពី ការអធិស្ឋាន នីមួយ ៗ ផងដែរ ។
សំឡេង តន្ត្រី - ទីក្រុង លឿន
« តាមទំនៀម ទម្លាប់របស់គាត់ លោកប៉ុលបានចូលទៅក្នុងសាលា ប្រជុំ ហើយនៅថ្ងៃ ស ប្ប័ទបីថ្ងៃ គាត់បានវែកញែកពី បទគម្ពីរ ជាមួយពួកគេ ...
ជួយ និង ចូលរួម ក្នុង ការចល័ត នេះ ។
“ ពួកគេបន្តិច បន្តួច ។
មន្ត្រី ពន្ធនាគារ បាន ប្រាប់ AFP ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ ថា ពន្ធនាគារ ទូទាំង ប្រទេស នឹង ចាប់ផ្តើម ដោះលែង មនុស្ស ជាង ២៣.០០០ នាក់ ។
តើ អ្នក ត្រូវការ ផ្នែក បន្ថែម ប៉ុន្មាន ក្នុង ពេល បច្ចុប្បន្ន និង អនាគត ?
« ឥឡូវនេះ ព្រះទ្រង់ បញ្ជាមនុស្សគ្រប់ទីកន្លែងឲ្យ ប្រែ ចិត្ត ដ្បិតទ្រង់បានកំណត់ថ្ងៃដែលទ្រង់នឹងជំនុំ ជម្រះពិភពលោកដោយយុត្តិធម៌ » ។
ខ្ញុំ ចង់ឱ្យ មនុស្ស ដួល នៅ ផ្ទះ ជំនួស ពួកគេ ។
អស់អ្នកដែលជឿលើទ្រង់គឺជាមនុស្សវង្វេង ។
កាលខ្ញុំមានអាយុរបស់អ្នក យុវជននិងស្ត្រីខ្លាច
ទុតិ យក ថា 1:14 ព្រះបាទដាវីឌមានរាជ ឱង្ការទៅគាត់ ថា៖ « ធ្វើដូចម្ដេចបានជាអ្នកមិនហ៊ានលើកដៃបំផ្លាញអ្នកដែលព្រះ បានចាក់ប្រេងតាំងនោះ ? » ។
នាង បាន ប្រើ ផ្ទះ មិត្តភក្តិ របស់ នាង សម្រាប់ ទីតាំង ។
កម្រិត នៃ ភាពចៃដន្យ ។
វា មកដល់ ការណាត់ជួប នារី ម្នាក់ ថា ពួកគេ ល្អ ឥត ខ្ចោះ ។
បន្ទាប់មក កុំ ទៅ ដោយ ស្ងប់ស្ងាត់ នៅ ពេល យប់ ។
និង ទីប្រឹក្សា បច្ចេកវិទ្យា របស់ លេខាធិការ ។
ហើយ វា ពេញចិត្ត ។
ជាពិសេសនៅពេលដែលស្ត្រីម្នាក់ត្រូវតែមានការ គិតគូរពីសុខភាព ជាខ្លាំង ។
ការងងុយ គេង របស់ គាត់ គឺ គួរឱ្យ ព្រួយបារម្ភ សម្រាប់ យើង ។
ខ្ញុំត្រូវគេបញ្ជូនទៅគុកប្តី ។
ពេលនោះ គេដឹងថាខ្លួនរងទុក្ខដោយ សារ តែការ ចង់បានរបស់ខ្លួន ។
បើមានអ្នក ណានិយាយរឿងនេះទៅអ្នក រត់ចេញ ។
ចុងក្រោយ ការជឿ លើ ផ្កាយ ឬ ជឿ លើ ទីនោះ ឬ ខ្លាច នៅក្នុង នោះ គឺជា ការថ្វាយបង្គំ រូប ព្រះ ហើយ ប្រឆាំង នឹង បញ្ញត្តិ ទី មួយ » ។
កញ្ជ្រោង ក្រហម មាន ច្រើន នៅ តំបន់ ជុំវិញ នេះ ។
« ព្រះជាម្ចាស់បានដកពាក្យតិះដៀលរបស់ខ្ញុំចេញ » ។
ហើយអាជីវកម្មដែលអ្នកកំពុងធ្វើមិន មែនជាអាជីវកម្មរបស់អ្នកទេ វាជារបស់យើង។
វា ជា គោល នយោបាយ របស់ រដ្ឋាភិបាល
តាម រយៈគាត់ អ្នក ជឿលើព្រះ ដែលបានប្រោសគាត់ឲ្យ រស់ឡើងវិញ ហើយលើក ត ម្កើងគាត់ ដូច្នេះហើយ ជំនឿ និងសេចក្ដីសង្ឃឹមរបស់អ្នកគឺស្ថិតនៅក្នុងព្រះ។
បងប្អូនបង្កើត១១ នាក់ កូន ៣ នាក់។
វាជាលើកដំបូងរបស់អ្នកម្ដងទៀត » ។
ចិញ្ចៀន អាច ត្រូវបាន បំផ្លាញ ដោយ ញញួរ ឬ ដោយ បោះ វា ទៅក្នុង ភ្លើង ។
ណាន គម្រោងអ្វី ?
អ្នក ដឹង ពី ការចាប់ផ្តើម នៃ រឿង ថា តើ មនុស្ស ទាំង នេះ នឹង ក្លាយជា អ្វី ។
មន្ទិល សង្ស័យ ដែល ជា វិធី របស់ ព្រះក្នុង ការធ្វើឱ្យ ពួកគេ សាកល្បង
‹ ខ្ញុំប្រាប់អ្នក ជាប្រាកដថា ថ្ងៃនេះ អ្នកនឹងនៅជាមួយខ្ញុំក្នុងឋានសួគ៌ ›» ។
ឧទាហរណ៍ ។ ជាមួយនឹង គ្រែ តែ មួយ ។
ពេល ចេញ ដំបូង គ្រប់ គ្នា ចង់បាន មួយ ។
៣៨ ប៉ុន្តែ អ្នកត្រូវទៅផ្ទះឪពុកខ្ញុំ និងគ្រួសារខ្ញុំ ហើយយកប្រពន្ធឲ្យកូនប្រុសខ្ញុំ ។
ហើយ អ្នក នឹង កម្ចាត់ ភាពយឺតយ៉ាវ ។
គ្រូបង្វឹក និង អ្នកចូលរួម ត្រូវបាន ផ្តល់ ឱកាស ដើម្បី ផ្តល់ មតិ កែលម្អ ។
អតីត មិត្ត ស្រី ឆ្កួត អ្នកនិពន្ធ ផលិត
សម្រាប់មហាសន្និបាតដែលនៅ សល់លោកអូបាម៉ា ត្រូវបានគេចោមរោមគ្រប់ទីកន្លែងដែលគាត់ទៅ ។
ខ្ញុំក៏ដឹងពីរបៀបដែលខ្ញុំអាចបំផ្លាញអ្វី ៗបានដែរ ។
ខ្ញុំ យល់ ថា ក្រសួង ការបរទេស កំពុង ដើរ តួនាទី យ៉ាង សកម្ម
នៅ ទីបញ្ចប់ មាន អ្វី ដែល ត្រូវ យកឈ្នះ លើ ពិភពលោក ។
ប៉ុន្តែបារាំងពិតជាមិនមែនជាប្រទេស តែមួយដែលត្រូវបានគេវាយ ប្រហារនោះទេ ។
ប្រសិនបើ អ្នក អាច ការពារ ។
នៅ ទីក្រុង ការ៉ាជី ចំនួន វគ្គ សិក្សា នៅក្នុង ទីក្រុង បាន កើនឡើង ដល់ ប្រាំ ។
វា ទាំងអស់ បាន ចាប់ផ្តើម នៅ យប់ ដែល ពួកគេ ចូល ទីក្រុង ។
តើ អ្នក សុបិន ចង់ ក្លាយជា គិលានុបដ្ឋាយិកា ...
អស់ រយៈពេល ៤០ថ្ងៃ លោកបានបង្ហាញខ្លួនដល់ពួកគេ ហើយនិយាយជាមួយនឹងគេអំពីរាជាណាចក្ររបស់ព្រះ។
ប្រញាប់ ទៅ ផ្ទះ វិញ ។
អ្នកអាចដាក់វាទៅក្នុងអ្វីក៏បាន » ។
« តើច្រើនប៉ុណ្ណាដែរ ពេលឮគេរាយការណ៍ថា បើយើងផឹកបន្តិច វាល្អសម្រាប់សុខភាពយើង ? »
