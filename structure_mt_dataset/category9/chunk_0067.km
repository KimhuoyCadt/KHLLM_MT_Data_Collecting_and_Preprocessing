ក្រោម ពន្លឺ ភ្លើង៖ ខ្ញុំ រួចរាល់ ហើយ !
« យើងដឹងថាមនុស្សម្នាក់បានរាប់ជាសុចរិតដោយការ ប្រព្រឹត្តនៃក្រិត្យវិន័យប៉ុណ្ណោះគឺដោយ សារសេចក្ដី ជំនឿលើព្រះ យេស៊ូវគ្រីស្ទ » ( កាឡាទី ២: ១៦) ។
២៤ គ្មានអ្នក ណាស្វែង រកសេចក្ដី ល្អរបស់ខ្លួនឡើយ គឺស្វែង រកសេចក្ដី ល្អរបស់អ្នក ដទៃវិញ ។
បី ឆ្នាំ បន្ទាប់ នាង ស្ទើរតែ ជិះ លើ គ្រែ ។
សិស្សនៅរដ្ឋកាលីហ្វ័រញ៉ាបានរងទុក្ខ អស់ រយៈពេលមួយឆ្នាំ ហើយឥឡូវពួកគេនឹងឈប់សម្រាកវិស្សមកាលរបស់ពួកគេ ។
ខាងក្រោមនេះជាចំណុចកំពូលទាំងប្រាំដើម្បីធានាថាកៅអីរថយន្តសម្រាប់កុមារមានសុវត្ថិភា ព៖
ពួក បរិសុទ្ធ មិន ត្រូវបាន វិនិច្ឆ័យ លើ សេចក្តីសុចរិត របស់ ពួកគេ ទេ គឺ មាន តែ អ្នក មិន ជឿ ប៉ុណ្ណោះ ។
បន្ទាប់មក ទ្រង់បានយាងទៅផ្ទះជាមួយពួកគេទៅភូមិ ណា សា រ៉ែត ហើយស្តាប់បង្គាប់ពួកគេ ។
គ្មានអ្នកក្រៅក្នុងទម្រង់ជារដ្ឋមន្ត្រី
ព្រះអម្ចាស់ ទត ឃើញ ការ ទាំង នេះ ។
ហើយចិនគ្មានតម្លៃទេ » ។
ដូចគ្នានេះផងដែរ វាជាលក្ខណៈគ្រួសារ ។
ហើយទោះបីជាខ្ញុំចង់ដឹងថាតើតម្លៃរបស់នាងកំពុងដំណើរការ យ៉ាង ណាដែរ ?
ហើយ អ្វី ក៏ដោយ ដែល អ្នក ធ្វើ សម្រាប់ ការរស់នៅ ក៏ សំខាន់ ផងដែរ ។
ខ្ញុំដើរឡើងសួរ ។
នេះ គឺ សម្រាប់ ផែនការ មូលដ្ឋាន របស់ ពួកគេ ដោយ ប្រើ ម៉ាស៊ីន មេលីនុច ។
រក្សា - ផឹក ពួកគេ ត្រូវបាន អនុញ្ញាតឱ្យ បន្ត
ពេលវេលា ជាច្រើន ដែល អ្នក ត្រូវបាន វាយប្រហារ ។
សម្អាត ពួកវា លាប ខ្លាញ់ ពួកវា ចាប់ផ្ដើម ពួកវា ឡើងវិញ ហើយ ប្តូរ ពួកវា ពី ឆ្វេង ទៅ ស្តាំ ។
ចូរធ្វើអ្វីដែលត្រឹមត្រូវ ហើយគេបាន ពរ ។ ធ្វើអ្វីខុស ហើយត្រូវបណ្តា សា ។
ទ្រង់មិនបានបែងចែករវាងយើងនិងគេទេ ដ្បិតទ្រង់បាន ប ន្សុទ្ធ ចិត្តគេដោយសេចក្ដី ជំនឿ ។
ក្នុងការ ចងចាំរបស់នាង នាងបានយក ចិត្តទុកដាក់នឹងព័ត៌មាន តែពីរដងប៉ុណ្ណោះ ។
ដូច ដែល ពួកគេ នឹង មិន ទទួលបាន អត្ថប្រយោជន៍ ណាមួយ ពី វា ។
" ខ្ញុំ គិត ថា អ្នក ត្រូវ មាន គ្រួសារ ក្រឡុក របស់ អ្នកតំណាង ។
( មិនមែននិយាយពីអ្វីផ្សេងទៀតដែលវាល្អសម្រាប់
គាត់ ចង់ បង្ហាញ ថា ដូច ខាងលើ
ខ្ញុំ ក៏ សូម ថ្លែងអំណរគុណ ម្តង ទៀត ចំពោះ សហការី របស់ ខ្ញុំ នៅលើ ក្រុមប្រឹក្សាភិបាល សម្រាប់ ការប្តេជ្ញាចិត្ត និង ជំនួយ របស់ ពួកគេ ពេញ មួយ ឆ្នាំ ។
យើងនឹងកំដៅវាបន្តិចហើយយើងបានរៀបចំ។
ពី ភាពទទេ នៃ ទុក្ខ ព្រួយ របស់ គាត់ ។
ខ្ញុំបានទូរស័ព្ទទៅ ហើយខ្ញុំ សប្បាយ ចិត្តពេលបានឮថារូបថតនោះជារូបពិត ហើយមួយថ្ងៃក្រោយមក យ៉ូសែបបាននៅផ្ទះ » ។
ខ្ញុំ ចង់ ចាប់ផ្តើម ការពិភាក្សា អំពី ទង់ជាតិ អាមេរិក ។
ជាអំណោយមួយគឺដើម្បីស្ដារវាឡើង វិញ » ។
មេធ្មប់ និង បិសាច ។
មិនត្រូវខ្ចាត់ខ្ចាយពេញផ្ទៃផែនដីឡើយ » ។
គាត់បាននិយាយថា៖ « ខ្ញុំមានកុងត្រាពីរឆ្នាំទៀត ។
ឪពុក របស់ គាត់ ជា ជនជាតិ កាណាដា ។
បើក ឡាន របស់ អ្នក ចូល ទៅក្នុង សាល ប្រគុំតន្ត្រី ។
បង្ហាញ អ្នក ថា អ្នក ជា
លទ្ធផល នៃ ទីក្រុង ក្យូតូ ។
៧ « ប្រសិនបើគេ រកឃើញថាគេលួចបងប្អូន ណាម្នាក់ពីជន ជាតិអ៊ីស្រាអែល ហើយបើគេចាត់ទុកគាត់ជាខ្ញុំ បម្រើ ឬលក់គាត់ នោះចោរនឹងត្រូវស្លាប់ ។
ប៉ុន្តែមានប្រទេសប៉ូឡូញ ដែលមិនឆ្ងាយប៉ុន្មានពីសាធារណរដ្ឋឆេក ។
ខ្ញុំ បាន សរសេរ ទៅ គាត់ ផ្ទាល់ ដើម្បី ឆ្លើយតប មក ខ្ញុំ អំពី សង្គ្រាម ។
កម្ចី ទិញ ផ្ទះ ច្រើន តែ ជា ការសន្យា ពេញ មួយ ជីវិត ដែល យើង ត្រូវ យកចិត្តទុកដាក់ ។
គាត់នៅ តែមានឥទ្ធិពល » ។
គាត់ នឹង ព្យាយាម ធ្វើឱ្យ ខ្ញុំ ស្ថិត ក្នុង ជួរ របស់ គាត់ ។
គេមិនជឿពាក្យរបស់ទ្រង់ទេ !
នេះ ជាកន្លែងដែលព្រះ អង្គ ប្រជុំគ្នាដើម្បីសម្រេចជោគ វាសនារបស់មនុស្ស និងធ្វើសិប្បកម្ម ច្នៃ និងធ្វើឈើ ។
អ្នក ណាដែលជឿលើខ្ញុំ អ្នក នោះនឹងមានជីវិត ទោះជាអ្នកនោះស្លាប់ក៏ដោយ » ។
នៅ ថ្ងៃស្អែក នេះ គួរតែ ផ្សាយ ពាណិជ្ជកម្ម យូរ ល្មម ដែល អាច គ្របដណ្តប់ នៅក្រោម
អូ ម៉េចវា រលាកបេះដូងដល់កាតព្វកិច្ច !
អញ្ចឹងឥឡូវនេះជាស្រីទល់នឹងមនុស្សស្រីហើយ !
ពេត្រុស ពន្យល់ ថា ពួកគេ ទាំងអស់ បាន ទទួល ការលើកលែង ទោស ពី ព្រះមហាក្សត្រ ។
ពួកគេ នឹង ត្រូវ ប្រគល់ ឱ្យ ដាវ
« ដ្បិតទ្រង់បានប្រោសមនុស្សជាច្រើនឲ្យជា ដើម្បីឲ្យអស់អ្នកដែលមានជំងឺខំ ប្រឹងទៅពាល់ទ្រង់ » ។
តើពួកគេបានបង្ហាញវាក្នុងលក្ខណៈដែលស្របតាមរបៀបដែលវាត្រូវបានកំណត់ក្នុងជំពូកទី 1 ដែរឬទេ ?
ក្នុងកំឡុងពេលថ្ងៃក្តៅបំផុត ពួកគេលូនចូលក្រោមផ្ទាំងថ្មសម្រាប់ម្លប់ ។
វា បាន ធ្វើឱ្យ ខ្ញុំ សើម នៅ ទីបញ្ចប់ ។
គ្មាន អ្នកណា ដូច អ្នក នៅលើ មេឃ និង នៅលើ ផែនដី ឡើយ ។
សុភាពបុរសទាំងពីរនាក់នោះបាន បង់ថ្លៃសេវារបស់ពួកគេ ។
មនុស្ស ដែល យល់ស្រប ជាមួយ យើង
ការឆ្លើយតប ទៅនឹង ចក្ខុវិស័យ ។
និងសេចក្តីថ្លែងការណ៍របស់ព្រះអង្គទាក់ទងនឹង សម្បថ៖
ហើយ នៅក្នុង ករណី នៃ បញ្ហា ទាំងអស់ ដែល បង្កើតឡើង ដោយ សត្រូវ ។
ពិធីសារ នៃ ការអនុវត្ត គាំទ្រ ដល់ លទ្ធផល សម្រាប់ ជនល្មើស ។
ដើម្បី ប្រាកដ ថា ខ្ញុំ នៅ ស្ថាន សួគ៌ ពិត ។
អំពើទុច្ចរិតរបស់ វង្សអ៊ីស្រា ‌ អែល មកលើវា អ្នកនឹងទទួល ទោសកំហុសរបស់ពួកគេ ។
គាត់ត្រូវបានចាប់ដាក់ពន្ធនាគារ តាំងពីឆ្នាំ ២០១៤ ។
ការដើរ របស់ ខ្ញុំ ជាមួយ ព្រះ៖ ស៊ូ កុំ ច្រៀង ពាក្យ
