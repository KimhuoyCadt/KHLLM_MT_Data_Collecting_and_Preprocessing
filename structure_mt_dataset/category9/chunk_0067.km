ដូច្នេះ អ្វី ដែល បាន កើតឡើង ចំពោះ ខ្ញុំ
“ លើកនេះខ្ញុំនៅ តែមានពេលវេលាដ៏ អស្ចារ្យ ប៉ុន្តែខ្ញុំនៅកន្លែងដ៏ អស្ចារ្យដែលស្រលាញ់ ។
គ្មានអ្នក ណាធំជាងព្រះ ឡើយ ។ គ្មាននរណាអាចហាមឃាត់ទ្រង់បានឡើយ ។
និង ភាពអស់សង្ឃឹម ជាថ្មី ។
កូនសោដែលមិន ទាន់ រកឃើញដែល ជារបស់។
បន្ទាប់មក គាត់ បាន ដឹង ពី អ្វី ដែល គាត់ មាន នៅក្នុង ដៃ របស់ គាត់ ។
អ្នកដែលក្លាយជាកូននៃការ វិនាស ហើយបដិសេធព្រះវិញ្ញាណបរិសុទ្ធ គឺជាមនុស្ស តែមួយគត់ដែលនឹងមិនត្រូវបានអត់ទោស ។
« តើមនុស្ស ជាមនុស្សដែលទ្រង់នឹកឃើញដល់ទ្រង់ ហើយជាកូនមនុស្សដែលទ្រង់យក ចិត្តទុកដាក់នឹងទ្រង់យ៉ាង ណា ? »
« តើមនុស្សអ្នកនឹកដល់គាត់យ៉ាង ណា ហើយកូនមនុស្សដែលអ្នកមើលថែគាត់ ?
« កំណើនរបស់ប្រទេសចិនកំពុងក្លាយជា កង្វល់សម្រាប់មនុស្សមួយចំនួន ។
ដាក់ នៅ ចំពោះ មុខ គាត់ ក្នុង មាត្រដ្ឋាន នៃ សេចក្តីពិត និង ភាពត្រឹមត្រូវ ។
ហើយត្រូវបានគេធ្វើទុក្ខ បុក ម្នេញរហូតដល់ផុតពូជ ។
« យើងមិនគាំទ្ររឿងនេះទេ ព្រោះយើងជឿលើសិទ្ធិមនុស្ស ។
អារក្ស មើលឃើញ ភាព ទន់ខ្សោយ ; បន្ទាប់មក លេង នៅលើ វា ។
ហើយបន្ទាប់ពីទ្រង់បានមាន បន្ទូល ការណ៍ទាំងនេះហើយ អស់អ្នកដែលប្រឆាំងនឹងទ្រង់ត្រូវ ខ្មាស ។ ហើយប្រជាជនទាំងអស់បានត្រេក អរចំពោះការ ដ៏រុងរឿងដែលទ្រង់បានធ្វើ » ។
តើអ្នកស្លាប់ក្នុងហេតុការណ៍នេះឈ្មោះអ្វី ?
យក ពី ពួកគេ ពី មនុស្សលោភលន់ អាក្រក់ ។
1:37 ដ្បិតគ្មានអ្វីដែលព្រះ មិនអាចធ្វើបាន .
អ្នកបង្កើតសន្តិភាពមានសុភមង្គលហើយ ដ្បិតអ្នកនោះនឹងត្រូវបានហៅថាជាកូនរបស់ព្រះ។
