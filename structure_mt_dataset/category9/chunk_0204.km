លទ្ធផល ស្វែងរក ពាក្យ គន្លឹះ ដី រដ្ឋ
៣. ផែនការ គ្មាន សកម្មភាព
អូន ស្រឡាញ់ បង ។
បើ គណបក្ស សង្គ្រោះ ជាតិ លោក សម រង្ស៊ី មិន ចូលរួម ការបោះឆ្នោត នឹង ខាត
ចាប់តាំងពី នាង ចូល សិល្បះ ១០ឆ្នាំ មក នេះ នាង បាន ប្តូរ រថយន្ត របស់ នាង មិន លើស ពី ៥ គ្រឿង ឡើយ ។
សមត្ថកិច្ច បាន សហការ ជាមួយ ក្រុម គ្រូពេទ្យ ខេត្ត ពិនិត្យ សាកសព ។
សុភា ខ្លាំង កណ្តាប់ដៃ ពិសេស កណ្តាប់ដៃ ឆ្វេង ។
ចូរ អត់ធ្មត់ អ្វី ៗ
លោក អ៊ិន សុភិន និង ចៅ ស្រី ទើប កើត នៅ មន្ទីរពេទ្យ ។
ពាក់ព័ន្ធ នឹង ចំណុច នេះ លោក និយាយ ថា ៖
រហូតដល់ ឆ្នាំ ២០០០ អាជ្ញាធរ ជាតិ ទទួលបន្ទុក ក
តែ គ្រប់ ជ្រុង ចាំង ជៈ ដោយ ទេសភាព មាស នៃ មហាសមុទ្រ ប៉ាស៊ីហ្វិក ។
លោក មករាបដិសេធ ធ្វើ អត្ថាធិប្បាយ ។
ការងារ កើតមាន រឿង រំខាន ច្រើន ធ្វើឱ្យ សម្ពាធ កើនឡើង ទ្វេ ដង ។
គិត ហើយ ដើរ ដល់ ផ្ទះ ក៏ កុហក ប្រាប់ ប្រពន្ធ ថា
លោក តូច ធន ជា ប្រធាន ការិយាល័យ ច្រក ចេញ ចូល
ម៉ូតូ នៅ មាំ ល្អ គ្រឿង ដើម ទាំងអស់ គ្មាន ការកែឆ្នែ លើ ផ្នែក ណាមួយ ទេ ។
ពួកគេ មាន ផ្ទះ ហើយ បញ្ហា ទាំងអស់ នេះ បាន ប៉ះពាល់ ពួកគេ ក៏ប៉ុន្តែ យើង ក៏ យល់ ដែរ ថា វា ជា កាតព្វកិច្ច របស់ យើង ទៅ ប្រកួត ហើយ ខំ ឱ្យ អស់ ពី សមត្ថភាព ។
កិត្តិយស និង ស្នេហា -
ផែនទី មាន ៥គឺ ៖
សមាជិក មិន អចិន្ត្រៃយ៍ នៃ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ មាន អាណត្តិ ២ឆ្នាំ ម្តង ។
កម្មករ រោងចក្រ សាប្រ៊ីណា នៅតែ បន្ត បិទ ផ្លូវ ជាតិ លេខ ៤ខណៈ ថៅកែ មិន រក ដំណោះស្រាយ
រុញ ទៅ រុញ មក ដើម្បី អូសបន្លាយ រហូតដល់
លោក ថា លោក បាន រាយការណ៍ ជូន ទៅ ថ្នាក់ លើ ហើយ ប៉ុន្តែ មិន ទាន់ មាន ការសម្រេច យ៉ាងណា នោះ ទេ ។
ប៉ុន្តែ ដោយសារ គាត់ ជាប់ នៅ ចិន មុន គាត់ សម្រេចចិត្ត ទៅ តែម្តង ។
ចំណុច នេះ រដ្ឋអាជ្ញា ត្រូវ ប្រឹង យកឈ្នះ ឱ្យ បាន ព្រោះ ជា គន្លឹះ ដ៏ សំខាន់ នៃ សវនាការ ។
ទៀត នឹង អាច មកដល់ ជិត ចុង ឆ្នាំ នេះ
លោក បាន គីមូន ទទួលងារ ជា មហា មេដឹកនាំ ពិភពលោក
