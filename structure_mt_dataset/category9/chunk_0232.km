( ភ្នំពេញ ) ៖ កង វិស្វកម្ម ពហុ ជំនាញ លេខ ៩២៨ ដែល មាន កម្លាំង សរុប ចំនួន ១៨៤ ក្នុង នោះ ស្ត្រី ៣០ នាក់ បាន វិលត្រឡប់មក មាតុភូមិ កម្ពុជា វិញ នៅ យប់ ថ្ងៃទី ០៣ ខែ វកុម្ភៈ ឆ្នាំ ២០២២ នេះ ក្រោយ បញ្ចប់ បេសកកម្ម មនុស្សធម៌ រក្សា សន្តិភាព អស់ រយៈពេល ១ឆ្នាំ ប្រកបដោយ ជោ គេ ជ័យ ដូច បណ្តា កង មុន ៗ នៅ សាធារណរដ្ឋ លី បង់ ។
នេះ សបញ្ជាក់ ឱ្យ ឃើញ ថា កម្លាំង មួក ខៀវ កម្ពុជា ពិតជា បាន ធ្វើ ន វានុវត្ត ចំណេះ ជំនាញ ក្នុង បរិបទ នៃ ការ រស់ នៅ ថ្មី និង សាមគ្គីភាព សហប្រតិបត្តិការ គោរព វិន័យ ល្អ និង ភាពអង់អាច ក្លាហាន ក្នុង ការអនុវត្ត តួនាទី របស់ ខ្លួន គ្រប់ ពេលវេលា និង គ្រប់ ទីកន្លែង នៃ តំបន់ ដែល ខ្លួន បាន ចូលរួម ពិសេស ការអនុវត្ត នូវ វិធាន នៃ ការការពារ មេរោគ កូវីដ១៩ ។
ពិធី ទទួល កង វិស្វកម្ម ពហុ ជំនាញ លេខ ៩២៨ ត្រូវបាន ធ្វើឡើង ក្រោម វត្តមាន នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី អនុប្រធាន គណៈកម្មាធិការ ជាតិ និង ជា អគ្គ នាយក មជ្ឈមណ្ឌល ជាតិ គ្រប់គ្រង កងកម្លាំង រក្សា សន្តិភាព បោសសម្អាត មីន និង កាកសំណល់ សង្គ្រាម ព្រមទាំង ថ្នាក់ដឹកនាំ កងទ័ព មួក ខៀវ មួយចំនួន នៅ ព្រលានយន្តហោះ VIP ។
នាយ ឧត្តមសេនីយ៍ បាន បញ្ជាក់ ថា៖ « តែ គួរឱ្យ សោកស្តាយ ដែល បងប្អូន យើង ១ នាក់ បាន រងគ្រោះថ្នាក់ ដោយសារ ឧបទ្ទវហេតុ ផ្ទុះ មីន បង្កឱ្យ មាន វិប្បដិសារី ដល់ ជាតិ អង្គភាព ក្រុមគ្រួសារ និង ខ្លួន ឯង ផ្ទាល់ ។ នេះ គឺជា មេរៀន និង បទពិសោធន៍ ដែល យើង នីមួយ ៗ ត្រូវ ចងចាំ ចង ក្រង និង ចែករំលែក ដល់ បងប្អូន ប្តូរ វេន ក្រោយ ៗ អនុវត្ត ឱ្យ បាន ដាច់ខាត តាម បទដ្ឋាន របស់ អ. ប.ស. ដោយ យក « សុវត្ថិភាព ជា ចម្បង » ។
នាយ ឧត្តមសេនីយ៍ សែម សុវណ្ណ នី បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សួរសុខទុក្ខ និង ស្វាគមន៍ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ និង ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ ចំពោះ ការវិល ត្រលប់ ប្រកបដោយ សុខ សុវត្ថិភាព ជាមួយនឹង ភាពជោគជ័យ ក្នុង ការបំពេញ ភារកិច្ច ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៤.៣៥៨ . ៨៥៤ នាក់ ។ ក្នុង រួម មាន៖
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ជួប តំណាង ស្ថានីយ ប្រេងឥន្ធនៈ ជជែក ពី ការរៀបចំ កន្លែង បញ្ចូល ថាមពល យានយន្ត អគ្គិសនី
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន និង កំពុង ប្រឹងប្រែង ឆ្ពោះ ទៅកាន់ ការសម្រេច មហិច្ឆតា ជំរុញ ការប្រើប្រាស់ យានយន្ត អគ្គិសនី នៅ កម្ពុជា ដើម្បី ជួយ ដល់ បរិស្ថាន និង កាត់បន្ថយ ការបំពុល ក្នុង បរិយាកាស ។
នៅ ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ជួប ជាមួយ តំណាង ស្ថានីយ ប្រេងឥន្ធនៈ ធំ ៗ នៅ កម្ពុជា មាន ដូចជា ក្រុមហ៊ុន សូគី មិច ក្រុមហ៊ុន តូតាល់ ក្រុមហ៊ុន តេលា ក្រុមហ៊ុន កាល់ តិច និង ក្រុមហ៊ុន ភីធី ធី ដើម្បី ពិភាក្សា លើ ការងារ រៀបចំ ឧបករណ៍ សម្ភារបញ្ចូល ថាមពល យានយន្ត អគ្គិសនី (EV Charging Station) ។ ការរៀបចំ កន្លែង បញ្ចូល ថាមពល យានយន្ត អគ្គិសនី គឺជា ធាតុ ដ៏ សំខាន់ ដើម្បី ឈាន ទៅការលើកទឹកចិត្ត ឱ្យ ប្រើប្រាស់ រថយន្ត អគ្គិសនី ។
ក្នុង ជំនួប នេះ លោក ទេសរដ្ឋមន្ត្រី បាន ជម្រាប ជូន អំពី បច្ចុប្បន្នភាព នៃ ការជំរុញ ការប្រើប្រាស់ យានយន្ត អគ្គិសនី EVs ដែល ជា គម្រោង កិច្ចសហប្រតិបត្តិការ រវាង ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ជាមួយ កម្មវិធី អភិវឌ្ឍន៍ សហ ប្រជាជាតិ (UNDP) ទាក់ទង ការដំឡើង ស្ថានីយ សាក ថ្ម យានយន្ត EVs ការរៀបចំ ផែនការ មេ សម្រាប់ គាំទ្រ ដល់ ការប្រើប្រាស់ យានយន្ត EVs ក្រោម ការគាំទ្រ ពី UNDP និង ការផ្ដល់ជូន ម៉ូតូ ដើរ ដោយ ថាមពល អគ្គិសនី ចំនួន ៣០ គ្រឿង ដើម្បី ធ្វើ ការសាកល្បង ផងដែរ ។
លោក ស៊ុន ចាន់ថុល ក៏ បាន គូសបញ្ជាក់ អំពី ការប្តេជ្ញាចិត្ត របស់ កម្ពុជា ក្នុង ទិសដៅ ឆ្ពោះ ទៅកាន់ ការសម្រេចបាន នូវ ការ កាត់បន្ថយ ការបំភាយ ឧស្ម័ន កាបូន ទៅក្នុង បរិយាកាស ផែនដី ឱ្យ នៅ កម្រិត សូន្យ នៅ ឆ្នាំ ២០៥០ និង បាន ដាក់ ជូន ផែនការ មេស្តីពី ការប្រើប្រាស់ យានយន្ត អគ្គិសនី ទៅ អង្គការ សហ ប្រជាជាតិ ដោយ កំណត់ ឱ្យ មាន ការប្រើប្រាស់ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី ក្នុង អត្រា ៤០% និង ម៉ូតូ ដើរ ដោយ ថាមពល អគ្គិសនី ក្នុង អត្រា ៣០% ។
កិច្ចប្រជុំ នេះ ក្រុមហ៊ុន បាន សម្ដែង ការគាំទ្រ គំនិត ផ្តួចផ្តើម របស់ ក្រសួង និង ខិតខំ ធ្វើ ការងារ ជាមួយ ថ្នាក់ដឹកនាំ របស់ ខ្លួន ក្នុង ការពិនិត្យ លទ្ធភាព ដំឡើង ឧបករណ៍ សាក ថ្ម យានយន្ត EVs នៅ តាម បណ្តា ទីតាំង ស្ថានីយ នានា របស់ ខ្លួន ៕ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា លោក ជា ចាន់តូ ផ្ញេីរសារ រំលែក មរណទុក្ខ ជូន លោកស្រី ម៉ៅ សាមឿន ឈា ថាំង និង ក្រុមគ្រួសារ ចំពោះ មរណភាព លោក វេជ្ជបណ្ឌិត ឈា ថាំង អតីត រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល
( ភ្នំពេញ ) ៖ លោក ជា ចាន់តូ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា បាន ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន លោកស្រី ម៉ៅ សាមឿន ឈា ថាំង និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ លោក វេជ្ជបណ្ឌិត ឈា ថាំង អតីត រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល អតីត អ្នកតំណាងរាស្ត្រ មណ្ឌល ក្រចេះ និង ជា អតីត សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី១ និង នីតិកាល ទី២ ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃចន្ទ ១៤រោច ខែ បុស្ស ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស .២៥៦៥ ត្រូវនឹង ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២២ វេលា ម៉ោង ៣៖២៥ នាទី រសៀល ក្នុង ជន្មាយុ ៨៧ ឆ្នាំ ដោយ ជរា ពាធ ។
មរណភាព របស់ លោក វេជ្ជបណ្ឌិត ឈា ថាំង គឺជា ការបាត់បង់ នូវ ស្វាមី បិតា និង ជីតា ដ៏ ឧត្តុង្គឧត្តម ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ជា កុលបុត្រ ដ៏ ប្រពៃ ជា ឥស្សរជន និង ជា ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ មួយ រូប ធ្លាប់ បាន រួមចំណែក កសាង ធនធាន មនុស្ស ក្នុង វិស័យ សុខាភិបាល ក្រោយ ថ្ងៃ រំដោះ ៧ មក រា ១៩៧៩ បាន ធ្វើ ពលិកម្ម គ្រប់ បែបយ៉ាង ដើម្បី បុព្វហេតុ បម្រើ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ។
ក្នុង ឱកាស ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ លោក ថោង ខុន បាន ចូលរួម សម្តែង នូវ មរណទុក្ខ ដោយ ក្តីស្រណោះ អាឡោះអាល័យ ជាមួយ លោកស្រី បុត្រា បុត្រី ចៅ ៗ និង ក្រុមគ្រួសារ ព្រមទាំង ញាតិមិត្ត ទាំងអស់ នៃ សព ហើយ សូម ឧទ្ទិស បួងសួង ឲ្យ ដួង វិញ្ញាណក្ខន្ធ លោក វេជ្ជបណ្ឌិត ឈា ថាំង បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៤៤៤ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២
បើ តាម អ្នកនាំពាក្យ . គិត ថ្ងៃទី ០៣ ខែកុម្ភៈ ក្នុង ឆ្នាំ ២០២២ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២១.៥៨០ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១៦.៤១២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៥. ១៦៨ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ទូរស័ព្ទ បត់ ជែង ល្មើស សញ្ញា និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ស្លាកលេខ លើស ចំណុះ ខ្សែក្រវ៉ាត់ ទូរស័ព្ទ អាជីវកម្ម ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៧ លើក ក្នុង នោះ ស្លាប់ ចំនួន ០៥ នាក់ របួស ១០នាក់ ( របួស ធ្ងន់ ០៤ នាក់ ) ។ រយៈពេល ៣៤ ថ្ងៃ នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៣៨៤ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ២១៤ នាក់ របួស ៥០៩ នាក់ ( របួស ធ្ងន់ ៣៤៥ នាក់ )៕
អភិបាល រាជធានី ភ្នំពេញ ស្នើ អ្នក វិនិយោគ ជប៉ុន មក វិនិយោគ លើ វិស័យ កសិកម្ម
លោក អភិបាល រាជធានី ភ្នំពេញ បាន ថ្លែង ថា នៅ កម្ពុជា ពិសេស នៅ រាជធានី ភ្នំពេញ មាន សក្តានុពល ខ្លាំង លើ វិស័យ កសិកម្ម ក្នុង នោះ បាន សង្កត់ធ្ងន់ លើ ការចិញ្ចឹម ត្រី និង ការដាំ ខ្ទឹម បារាំង សំរាប់ នាំចេញ ទៅ ទីផ្សារ សំខាន់ ៗ ដូចជា ប្រទេស ចិន ជាដើម នៅពេល កម្ពុជា បាន ចុះហត្ថលេខា រួចហើយ លើ ការធ្វើ ពាណិជ្ជកម្ម សេរី ជាមួយ ភាគី ចិន លើ ការនាំ ផលិត កសិកម្ម ពី កម្ពុជា ចូលទៅ ទីផ្សារ ចិន ។
លោក អភិបាល រាជធានី បាន លើកឡើង ថា ជប៉ុន មាន បច្ចេកទេស ច្បាស់លាស់ ក្នុង ការចិញ្ចឹម ត្រី នាំចេញ រួមទាំង ផល ដំណាំ ផ្សេង ៗ ទៀត ទៅកាន់ ទីផ្សារ នៃ បណ្តា ប្រទេស នានា ។ ដូច្នេះ ជប៉ុន អាច បញ្ជូន អ្នក វិនិយោគ មក សិក្សា លើ វិស័យ កសិកម្ម នៅ កម្ពុជា ប្រកបដោយ សក្តានុពល ។
ក្នុង ឱកាស នោះ ដែរ លោក បាន ប្រគល់ ប្លង់ ដី មួយ ហិត តា ដែល ជា អំណោយ របស់ ជនជាតិ ជប៉ុន ម្នាក់ ដល់ អភិបាល រាជធានី ភ្នំពេញ សម្រាប់ ធ្វើជា សួនច្បារ សាធារណៈ មួយ ដើម្បី អបអរសាទរ ខួប លើក ទី៣០ ឆ្នាំ ដែល ជប៉ុន បាន បញ្ជូន កងកម្លាំង របស់ ខ្លួន មក រក្សា សន្តិសុខ អន្តរជាតិ ៕ រុស្ស៊ី បន្ត បំបែក កំណត់ត្រា ថ្មី ជាមួយ ការមើល ឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ៗ ជាង ១៥៥ . ៧៦៨ ករណី ក្នុង មួយ ថ្ងៃ
( ម៉ូស្គូ) ៖ អាជ្ញាធរ រុស្ស៊ី បាន បញ្ជាក់ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ ពី ការរកឃើញ នូវ ករណី ឆ្លង ថ្មី នៃ ជំងឺ កូវីដ១៩ ចំនួន ១៥៥. ៧៦៨ នាក់ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដែល ជា តួលេខ ឆ្លង ប្រចាំ ថ្ងៃ ខ្ពស់ បំផុត មិន ធ្លាប់ មាន ដែល នាំឱ្យ ចំនួន សរុប ទូទាំង ប្រទេស កើនឡើង ដល់ ១២.២៨៤ . ៥៦៤ ករណី ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃព្រហស្បតិ៍ ទី០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
ថៃ៖ មនុស្ស ជិត ១០.០០០ នាក់ ឆ្លង កូវីដ - ១៩ និង អ្នកជំងឺ ២២ នាក់ ស្លាប់ ក្នុង របាយការណ៍ ថ្ងៃសុក្រ នេះ
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ២២ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ៧. ៨២៧ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
អស់ រយៈពេល ជាច្រើន ឆ្នាំ ទិវា សុវត្ថិភាព អ៉ីនធឺណិត បាន ក្លាយជា ព្រឹត្តិការណ៍ សកល ដ៏ សំខាន់ មួយ ក្នុង កម្មវិធី សុវត្ថិភាព តាម ប្រព័ន្ធ អនឡាញ ។ ដោយ ចាប់ផ្តើម ពី គម្រោង SafeBorders របស់ សហភាព អ៊ឺរ៉ុប ក្នុង ឆ្នាំ ២០០៤ ហើយ បាន បន្ត អនុវត្ត ដោយ បណ្តាញ Insafe ជា សកម្មភាព មួយ ក្នុង ចំណោម សកម្មភាព នានា ក្នុង ឆ្នាំ ២០០៥ ទិវា សុវត្ថិភាព អ៊ីនធឺណិត បាន ពង្រីក វិសាលភាព របស់ ខ្លួន ហើយ មាន ប្រទេស និង ដែនដី ប្រមាណ ជា ២០០ នៅ ទូទាំង ពិភពលោក បាន ចូលរួម ប្រារព្ធ អបអរសាទរ ។
នៅ ប្រទេស កម្ពុជា អង្គការ សកម្មភាព ដើម្បី កុមារ (APLE) ដែល ជា សមាជិក នៃ គណៈកម្មាធិការ សុវត្ថិភាព អ៉ីនធឺណិត បាន ប្រារព្ធ ទិវា នេះ ឡើង ចាប់តាំងពី ឆ្នាំ ២០១៩ ។ មនុស្ស រាប់ ពាន់ នាក់ ជាពិសេស កុមារ និង យុវជន វ័យ ក្មេង បាន ចូលរួម ប្រារព្ធ ទិវា សុវត្ថិភាព អ៉ីនធឺណិត នេះ បី ឆ្នាំ ជាប់ គ្នា ។
លោក សំលៀង សីលា បាន បង្ហាញ ក្តីសង្ឃ ថា ព្រឹត្តិការណ៍ ឆ្នាំ នេះ នឹង ក្លាយជា ជំហ៊ាន ដ៏ សំខាន់ ឆ្ពោះ ទៅការរក្សា សុវត្ថិភាព កុមារ តាម ប្រព័ន្ធ អនឡាញ និង ផ្តល់ឱ្យ ពួកគេ នូវ ភាពសប្បាយ រីករាយ ជាពិសេស សម្រាប់ កុមារ និង យុវជន វ័យ ក្មេង ដែល នឹង ចូលរួម ដោយ ផ្ទាល់ ។ បន្ទាប់ពី កម្មវិធី នៅ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ ទិវា សុវត្ថិភាព អ៉ីនធឺណិត ក៏ នឹង ត្រូវ ប្រារព្ធ ធ្វើឡើង ជាមួយ កុមារ ចំនួន ៣០០ នាក់ មកពី វិទ្យាល័យ ឯកជន ចំនួន ពីរ ក្នុង រាជធានី ភ្នំពេញ ។
លោក សំលៀង សីលា បាន លើកឡើង ថា៖ « ការចូលរួម ប្រារព្ធ ទិវា សុវត្ថិភាព អ៉ីនធឺណិត នេះ បាន សំដែង នូវ ការប្តេជ្ញាចិត្ត ដ៏ មុះ មុត របស់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ក្នុង ការការពារ កុមារ ពី គ្រប់ ទម្រង់ ទាំងអស់ នៃ ការរំលោភបំពាន រួមទាំង ការរំលោភបំពាន តាម ប្រព័ន្ធ អនឡាញ និង បាន ក្លាយជា ចំណែក ដ៏ ធំ មួយ នៃ ការផ្លាស់ប្តូរ ឥរិយាបទ និង ការជម្រុញ ទឹកចិត្ត ឱ្យ មាន ការប្រើប្រាស់ បច្ចេកវិទ្យា អ៊ីនធឺណិត ប្រកបដោយ ការទទួលខុសត្រូវ ការគោរព ការចេះ គិត ពិចារណា និង ភាពច្នៃប្រឌិត » ។
លោក សំលៀង សីលា ស្វាគមន៍ បណ្តាញ សារព័ត៌មាន ទាំងអស់ ចូលរួម ក្នុង « ទិវា សុវត្ថិភាព អ៊ីនធឺណិត ឆ្នាំ ២០២២ » និង ចូលរួម បំពេញ តួនាទី រក្សា សុវត្ថិភាព កុមារ តាម ប្រព័ន្ធ អនឡាញ តាមរយៈ ការចូលរួម ផ្សព្វផ្សាយ ដល់ សាធារណជន ទូទៅ ។
អភិបាល ខេត្ត ពោធិ៍សាត់ ស្នើ អភិបាល ក្រុង ស្រុក ទាំងអស់ ត្រូវ ចូលរួម ដាច់ខាត ក្នុង កិច្ចប្រជុំ ប្រចាំ ខែ របស់ គណៈ អភិបាល ខេត្ត
( ពោធិ៍សាត់ )៖ លោក ជា វ តាយ អភិបាល នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ បាន ស្នើ ដល់ អភិបាល ក្រុង ស្រុក ទាំងអស់ ត្រូវតែ ចូលរួម ជាដាច់ខាត ក្នុង កិច្ចប្រជុំ ប្រចាំ ខែ របស់ គណៈ អភិបាល ខេត្ត ដែល ធ្វើឡើង រៀងរាល់ មួយ ខែម្តង ដើម្បី ក្តាប់ សភាពការណ៍ រួម នា ពេល បច្ចុប្បន្ន លើក យក បញ្ហា ប្រឈម រួមគ្នា ដោះស្រាយ ធ្វើ យ៉ាងណា បម្រើ សេវា សាធារណៈ ក៏ ដូចជា សេចក្តីត្រូវការ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ ។
លោក បាន ស្នើ បែប នេះ ក្នុង កិច្ចប្រជុំ គណៈ អភិបាល ខេត្ត ប្រចាំ ខែមករា និង លើក ទិសដៅ អនុវត្ត បន្ត នៅ ខែកុម្ភៈ ឆ្នាំ ២០២២ ដោយ បាន ការចូលរួម ពីសំណាក់ លោក អភិបាល រង នៃ គណៈអភិបាល ខេត្ត នាយក នាយក រង រដ្ឋបាល សាលា ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ អភិបាល ក្រុង ស្រុក និង អង្គភាព ចំណុះ សាលា ខេត្ត ជាច្រើន នាក់ ទៀត ។
លោក អភិបាល ខេត្ត បាន ក្រើន រំលឹក ដល់ អភិបាល ក្រុង ស្រុក ទាំងអស់ ត្រូវ បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ប្រសើរ តាម ការណែនាំ របស់ ក្រសួង មហាផ្ទៃ ក៏ ដូចជា ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ។
ពាក់ព័ន្ធ បទល្មើស គ្រឿងញៀន ល្បែងស៊ីសង គ្រប់ ប្រភេទ ករណី ចោរកម្ម ការកាប់បំផ្លាញ ព្រៃឈើ ការកាប់ ទន្ទ្រាន ដី ព្រៃ របស់ រដ្ឋ យក ធ្វើជា កម្មសិទ្ធិ ការដឹកជញ្ជូន ឈើ ប្រណិត គ្រប់ រូបភាព បទល្មើស ជល ផល និង បទល្មើស ផ្សេង ៗ ទៀត លោក សូម ឱ្យ គណៈ បញ្ជាការ ឯកភាព ក្រុង ស្រុក យកចិត្តទុកដាក់ បង្ក្រាប ឱ្យ ខាងតែ បាន ដើម្បីឱ្យ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ។ រដ្ឋបាល ក្រុង និង មន្ទីរ បរិស្ថាន ខេត្ត ត្រូវ ជម្រុញ លើ ការប្រមូល សំរាម នៅ តាម ទី សាធារណៈ ឱ្យ បាន ស្អាត ល្អ ដើម្បី សោភណ្ឌភាព បរិស្ថាន និង សុខភាព ប្រជាពលរដ្ឋ ។
( ភ្នំពេញ ) ៖ នៅក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ចិន - វៀតណាម រយៈពេល ៤ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី ៣១ ខែមករា ដល់ ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ មាន ករណី អគ្គិភ័យ ឆាបឆេះ ផ្ទះ ប្រជាពលរដ្ឋ តូប លក់ដូរ និង បន្ទប់ ចំនួន ៧ករណី ក្នុង នោះ មាន ផ្ទះ ចំនួន ៥ ប៉ុន្តែ មិន បង្កឱ្យ មនុស្ស របួស និង ស្លាប់ នោះ ទេ ។
តាម របាយការណ៍ របស់ នាយកដ្ឋាន បង្ការ និង ពន្លត់ អគ្គិភ័យ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន បញ្ជាក់ ថា សម្រាប់ ករណី គ្រោះថ្នាក់ អគ្គិភ័យ នេះ បាន ថយចុះ ៧ភាគរយ បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០២១ ។
មូលហេតុ ដែល បង្កឱ្យ មាន ករណី អគ្គិភ័យ កើតឡើង រួម មាន៖ ឆ្លង ចរន្ត អគ្គិសនី ៣លើក . ភ្លើង ព្រៃ រាល ឆេះ ២លើក . ផ្ទុះ កំប៉ុង ហ្គាស ១លើ ក និង ភ្លើង ចង្ក្រាន ១លើក ។
សម្រាប់ រាជធានី - ខេត្ត ដែល កើត អគ្គិភ័យ រួម មាន៖ ខេត្ត ព្រៃវែង . ខេត្ត ត្បូងឃ្មុំ . ខេត្ត ស្ទឹងត្រែង . ខេត្ត ព្រះវិហារ . ខេត្ត ឧត្តរមានជ័យ និង ខេត្ត សៀមរាប ៕
សេចក្តីជូនដំណឹង បាន បញ្ជាក់ ថា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ បាន កែលម្អ និង សាងសង់ រោងចក្រ ផលិត ទឹក ស្អាត ថ្មី និង ពង្រីក បណ្តាញ ចែកចាយ ថ្មី ជា បន្តបន្ទាប់ ដើម្បី សម្រេចបាន នូវ ការផ្គត់ផ្គង់ ទឹក ស្អាត ជូន ប្រជាពលរដ្ឋ ទូទាំង រាជធានី ភ្នំពេញ និង ទីក្រុង តាខ្មៅ ស្រប តាម គោលដៅ អភិវឌ្ឍ ប្រកបដោយ ចីរភាព ឆ្នាំ ២០១៦ - ២០៣០ របស់ រាជ រដ្ឋាភិបាល ។
បច្ចុប្បន្ន នេះ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ មាន រោងចក្រ ផលិត ទឹក ស្អាត សរុប ចំនួន ៤ទីតាំង និង ផលិត ទឹក ស្អាត បានជា មធ្យម ៦សែន ម៉ែត្រ គូប / ថ្ងៃ ។ ក៏ប៉ុន្តែ ជាក់ស្តែង ដោយសារ កំណើន នៃ សកម្មភាព សេដ្ឋកិច្ច នៅ រាជធានី ភ្នំពេញ ធ្វើឱ្យ តម្រូវការ ទឹក ស្អាត បាន កើនឡើង ខ្ពស់ ជាង សមត្ថភាព ផលិត ពោលគឺ តម្រូវការ ជាក់ស្តែង ប្រមាណ ជា ៨សែន ម៉ែត្រ គូប / ថ្ងៃ ដែល ធ្វើឱ្យ មាន កង្វះ ទឹក ស្អាត សម្រាប់ ចែកចាយ ក្នុង ម៉ោង មាន តម្រូវការ ទឹក ខ្ពស់ ជាពិសេស ខ្វះ ទឹក នៅ តំបន់ ជាយ រាជធានី ភ្នំពេញ និង ជាយ ក្រុង តាខ្មៅ ។
រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ បន្ត ថា ដោយ ពិនិត្យ ឃើញ ថា ការខ្វះ ទឹក នា រដូវ ប្រាំង ឆ្នាំ ២០២២ នេះ ជា ការខ្វះ ទឹក ស្អាត ប្រើប្រាស់ ចុងក្រោយ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ សូម អំពាវនាវ ដល់ អតិថិជន ទាំងអស់ ទាំង ក្នុង រាជធានី ភ្នំពេញ និង ក្រុង តាខ្មៅ មេត្តា ជួយ សន្សំ សំចៃ ទឹក ស្អាត ដើម្បី ផ្តល់ ក្តីករុណា និង ចែករំលែក ទឹក ទៅដល់ អតិថិជន ផ្សេង ទៀត ជាពិសេស អតិថិជន រស់ នៅ ក្នុង តំបន់ ជាយ ក្រុង ៕ កាណាដា នឹង មិន ប្រើ កងទ័ព បង្រ្កាប ក្រុម បាតុករ ឡើយ ខណៈ បាតុកម្ម ជាច្រើន គ្រោង នឹង ធ្វើឡើង
ការអះអាង របស់ លោក ឌ្រូដូ កើត មាន ឡើង បន្ទាប់ពី មន្ត្រី ប៉ូលិស ជាន់ ខ្ពស់ ប្រចាំ រដ្ឋធានី អូតា វ៉ា (Ottawa) បាន ឱ្យដឹង កាលពី ថ្ងៃពុធ ថា មាន កាំភ្លើង ជាច្រើន ដើម ត្រូវបាន គេ រត់ ពន្ធ ប្រគល់ ទៅ ឱ្យ ក្រុម បាតុករ ដែល នេះ តម្រូវ ឱ្យ មាន ការប្រើប្រាស់ កម្លាំង យោធា ។ ប៉ុន្តែ គំនិត នេះ ត្រូវបាន លោក ឌ្រូដូ ដែល កំពុង ប្រឈមមុខ នឹង ការទាមទារ ឱ្យ ចុះចេញ ពី តំណែង ផង នោះ ច្រានចោល ។
សេចក្តីថ្លែងការណ៍ ដដែល បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា ប្រទេស ចិន និង រុស្ស៊ី បាន បាន សម្របសម្រួល ជំហរ រៀង ៗ ខ្លួន ទៅ លើ បញ្ហា ប្រឈម សំខាន់ រួម ក្នុង តំបន់ ដូចជា អ៊ុយក្រែន . អាហ្វហ្កានីស្ថាន និង ស្ថានការណ៍ នៅ ឧបទ្វីប កូរ៉េ ជាដើម ។ យ៉ាងណា ក៏ដោយ ភាពស៊ីជម្រៅ បន្ថែម ពី នេះ ទៀត អំពី កិច្ចប្រជុំ ខាងលើ នេះ គឺ មិន ត្រូវបាន លើកឡើង នោះ ឡើយ ។
គួរ បញ្ជាក់ ថា ប្រទេស អ៊ុយក្រែន ថ្មី ៗ នេះ បាន អះអាង ថា រុស្ស៊ី បាន ដាក់ពង្រាយ កងទ័ព សរុប ១១៥.០០០ នាក់ នៅក្បែរ ព្រំដែន របស់ ខ្លួន ជា សញ្ញា បង្ហាញ អំពី ការវាយប្រហារ ដែល ជិត នឹង កើតឡើង ។ រុស្ស៊ី នៅតែ ច្រានចោល ការចោទប្រកាន់ ថា ខ្លួន មាន ផែនការវាយលុក អ៊ុយក្រែន ខណៈ បណ្តា ប្រទេស លោក ខាងលិច នៅតែ បន្ត ការចោទប្រកាន់ រឿង នេះ ជានិច្ច ។
បើ តាម លោក ផៃ ស៊ីផាន សេចក្តីព្រាង ច្បាប់ នេះ នឹង រួមចំណែក ផ្តល់ នូវ សារៈប្រយោជន៍ ក្នុង ការអភិវឌ្ឍ វិស័យ កសិកម្ម ដូច ខាងក្រោម៖
លោក ណេដ ប្រាយស៍ (Ned Price) អ្នកនាំពាក្យ នៃ ក្រសួង ការបរទេស អាមេរិក បាន ធ្វើ ការចោទប្រកាន់ ប្រទេស រុស្ស៊ី យ៉ាង ដូច្នេះ ទៀត ថា ជម្រើស មួយ ក្នុង ចំណោម ជម្រើស ជាច្រើន របស់ ទីក្រុង ម៉ូស្គូ នោះ គឺ ការប្រឌិត ឡើង នូវ វីដេអូ ក្រាហ្វិក អំពី ការផ្ទុះ មួយ ដែល សំដៅ លើ ពលរដ្ឋ រុស្ស៊ី និង មាន អ្នកកាន់ ទុក្ខ ផងដែរ ព្រមទាំង ឧបករណ៍ ដែល បង្ហាញ ថា វា ជា ទង្វើ របស់ អ៊ុយក្រែន ឬ បណ្តា ប្រទេស សម្ព័ន្ធមិត្ត ។
បើ តាម មន្ត្រី ចារកម្ម អាមេរិក ទីក្រុង ម៉ូស្គូ អាចនឹង បញ្ចេញ វីដេអូ ដូច ខាងលើ នេះ ដើម្បី ពន្យល់ ពលរដ្ឋ របស់ ខ្លួន អំពី ការគំរាមកំហែង សន្តិសុខ ចំពោះ រុស្ស៊ី និង ឲ្យ ពួកគេ គាំទ្រ ប្រតិបត្តិការ យោធា ។ ទីក្រុង វ៉ាស៊ីនតោន បាន សង្កត់ធ្ងន់ ទៀត ថា ប្រសិនបើ វីដេអូ បែប នេះ ត្រូវបាន ចេញផ្សាយ មែន នោះ វា នឹង អាច បំពេញ តាម តម្រូវការ របស់ ប្រធានាធិបតី រុស្ស៊ី លោក វ៉ាឌីមៀ ពូទីន ក្នុង ការបើកប្រតិបត្តិការ យោធា ប្រឆាំង នឹង អ៊ុយក្រែន ប្រកបដោយ ភាពត្រឹមត្រូវ នៅក្នុង ភ្នែក រាស្ត្រ របស់ លោក ។
ព្រឹក នេះ សម្តេច តេជោ អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃសុក្រ ទី ០៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី ដើម្បី ពិភាក្សា និង ឆ្លៀង នូវ របៀបវារៈ មួយចំនួន ។
លោក ផៃ ស៊ីផាន រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន ឱ្យដឹង ថា កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី នា ព្រឹក នេះ ពិភាក្សា លើ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការការពារ រុក្ខជាតិ និង ភូត គាម អនាម័យ និង បញ្ហា ផ្សេង ៗ ៕
ក្រសួង សុខាភិបាល ប្រកាស ឲ្យ ក្រុម បាតុករ អតីត បុគ្គលិក ណាហ្គាវើលដ៍ ទាំងអស់ ទៅ ធ្វើតេស្ត រក វីរុស កូវីដ១៩ ដើម្បី បញ្ចៀស ការឆ្លង ទ្រង់ទ្រាយ ធំ ក្រោយ រកឃើញ មេរោគ បំប្លែង ថ្មី អូមី ក្រុង លើ បាតុករ ម្នាក់
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ដោយ តម្រូវឲ្យ ក្រុម បាតុករ អតីត បុគ្គលិក ណាហ្គាវើលដ៍ ទាំងអស់ ទៅ ធ្វើតេស្ត រក វីរុស កូវីដ១៩ ដើម្បី បញ្ចៀស ការឆ្លង ទ្រង់ទ្រាយ ធំ ក្រោយ រកឃើញ មេរោគ បំប្លែង ថ្មី អូមី ក្រុង លើ បាតុករ ម្នាក់ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ១០នាក់ ។
( សិង្ហបុរី ) ៖ ប្រទេស សិង្ហបុរី បាន រាយការណ៍ ពី ករណី ឆ្លង កូវីដ១៩ ថ្មី ៗ ចំនួន ៤. ២៩៧ ករណី បន្ថែម ទៀត គិត ត្រឹម ថ្ងៃព្រហស្បតិ៍ ទី០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA ចេញផ្សាយ យប់ ថ្ងៃព្រហស្បតិ៍ ។
