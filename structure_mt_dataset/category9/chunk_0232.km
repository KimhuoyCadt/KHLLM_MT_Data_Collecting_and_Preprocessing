( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ លោក នួន ផារ័ត្ន អភិបាល រង រាជធានី ភ្នំពេញ តំណាង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ជួប សំណេះសំណាល ជាមួយ ក្រុម និស្សិត ជ័យលាភី អាហារូបករណ៍ ចំនួន ២៩ រូប ដែល នឹង ចេញ ទៅ បន្ត ការសិក្សា ថ្នាក់ បរិញ្ញាបត្រ ជាន់ ខ្ពស់ នៅ ប្រទេស អូស្ត្រាលី ។
ជាមួយគ្នា នេះ លោក អភិបាល រង ក៏ បាន ចែករំលែក បទពិសោធន៍ ជា អតីត និស្សិត អាហារូបករណ៍ ទៅ សិក្សា នៅ ប្រទេស បារាំង កាលពី ២០ ឆ្នាំ មុន ព្រមទាំង ឆ្លៀត ផ្តាំផ្ញើ និង សំណូមពរ ដល់ ក្រុម និស្សិត ជ័យលាភី ធ្វើជា អគ្គ រដ្ឋទូត សុឆន្ទៈ របស់ កម្ពុជា ដោយ ផ្សព្វផ្សាយ អំពី ការអភិវឌ្ឍ របស់ ប្រទេសជាតិ ទៅដល់ បរទេស ជាពិសេស ថែរក្សា សុខភាព ឱ្យ បាន ល្អ និង ខិតខំ ប្រឹងប្រែង រៀនសូត្រ ក្រេប យក ចំណេះដឹង ដើម្បី ចូលរួម អភិវឌ្ឍន៍ ប្រទេសជាតិ យើង នៅពេល ត្រឡប់ មកកាន់ មាតុ ប្រទេស វិញ ។
ជា ចុងក្រោយ លោក អភិបាល រង ក៏ បាន ពាំនាំ ថវិកា ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តាមរយៈ លោក អភិបាល រាជធានី ភ្នំពេញ ផ្ញើ ជូន ដល់ ក្រុម និស្សិត ជ័យលាភី ផងដែរ ៕ មូលនិធិ ជន ពិការ នៃ ក្រសួង សង្គមកិច្ច ប្រគល់ ផ្ទះ មួយ ខ្នង ជូន ជន ពិការ ក្រីក្រ រស់ នៅក្នុង ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ លោក គុណ ជា ស៊ីន សមាជិក ក្រុមប្រឹក្សាភិបាល នៃ មូលនិធិ ជន ពិការ តំណាង ឱ្យ លោក រឿន រិទ្ធី រ័ត្ន ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ មូលនិធិ ជន ពិការ នៅ ថ្ងៃទី៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ បាន ចុះ ប្រគល់ ផ្ទះ ថ្មី ១ខ្នង របស់ មូលនិធិ ជន ពិការ ធ្វើ អំពី ថ្ម ប្រក ស័ង្កសី ទំហំ ៤គុណ៦ម៉ែត្រ ជូន ជន ពិការ ក្រីក្រ ឈ្មោះ តេង ចាន់ ថន ភេទ ស្រី ជា ជនពិការ ទន់ អវយវៈ ក្រោម ទាំង ២ រស់ នៅ ភូមិ ថ្នល់ ថ្មី ឃុំ ជ្រៃ បាក់ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ។
ជន ពិការ ខាងលើ រស់ នៅ ជាមួយ ម្តាយ ចាស់ជរា នៅក្នុង ផ្ទះ ទាម ផ្ទាល់ ដី ទំហំ ៥ម៉ែត្រ គុណ៦ម៉ែត្រ ធ្វើ ពី ឈើ ជញ្ជាំង ប្រក់ ស្លឹក ត្នោត និង ដំបូល ស័ង្កសី មាន សភាព ចាស់ ទ្រុឌទ្រោម និង ធ្លុះធ្លាយ ដោយ អន្លើរ ។ មុខរបរ បច្ចុប្បន្ន របស់ គាត់ គឺ ធ្វើ នំ លក់ បន្តិចបន្តួច ជាមួយ ម្តាយ ចាស់ ដូចជា នំ អន្សម នំ អាកោ ត្នោត និង ក្រឡាន ជាដើម ដោយ ម្តាយ ចាស់ ជា អ្នក ដើរ លក់ នៅ តាម ផ្ទះ អ្នកស្រុក ជិតខាង ។
ជំនួស មុខ ឱ្យ គ្រួសារ ជន ពិការ លោក មេឃុំ ជ្រៃ បាក់ បាន ថ្លែងអំណរគុណ ដល់ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា តាមរយៈ មូលនិធិ ជន ពិការ ដែល បាន សាងសង់ ផ្ទះ ថ្មី ១ ខ្នង ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន លោក ដែល នេះ ពិតជា ការកាត់បន្ថយ ទុក្ខលំបាក របស់ ជន ពិការ បាន មួយ ចំណែក ធំ ។
ក្នុង ពិធី នេះ ដែរ មូលនិធិ ជន ពិការ ក៏ បាន ផ្តល់ ជូន នូវ អំណោយ សប្បុរសធម៌ របស់ មូលនិធិ ជន ពិការ សម្រាប់ ផ្តល់ ជូន ដល់ គ្រួសារ ជន ពិការ ដែល ទទួលបាន ផ្ទះ ថ្មី នូវ ថវិកា ចំនួន ១០ម៉ឺន រៀល អង្ករ ២៥ គីឡូ ក្រោម ត្រីខ២យួរ ទឹក ស៊ីវ អ៊ីវ១យួរ ទឹកត្រី ១យួរ អំបិល ២កញ្ចប់ និង មី១កេស ជាមួយគ្នា នេះ អាជ្ញាធរ ឃុំ ជ្រៃ បាក់ ក៏ បាន ឧបត្ថម្ភ បន្ថែម នូវ សម្ភារៈ ប្រើប្រាស់ និង គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ផងដែរ ៕
( ភ្នំពេញ ) ៖ ដោយ មាន ទំនាក់ទំនង កិច្ចសហការ ល្អ ជាមួយគ្នា សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ បញ្ញា ជាតិ លោកជំទាវ ឧកញ៉ា បណ្ឌិត ជា សុវណ្ណ នី បាន ផ្ដល់ អាហារូបករណ៍ ថ្នាក់ បរិញ្ញាបត្រ និង បរិញ្ញាបត្រ ជាន់ ខ្ពស់ សរុប ចំនួន ២០កន្លែង ដល់ លោក លឹម ជា វុត្ថា អគ្គ នាយក បណ្ដាញ ព័ត៌មាន Fresh News ដើម្បី ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការបណ្ដុះបណ្ដាល ធនធាន មនុស្ស ។
វិមាន ក្រឹមឡាំង បាន ប្រកាស ឲ្យដឹង នៅ ក្រោយ កិច្ចសន្ទនា ខាងលើ នេះ ថា មេដឹកនាំ ទាំង ពីរ រូប បាន បន្ត « ការសន្ទនា ជាមួយគ្នា លើ ប្រធានបទ សំខាន់ ៗ » ពាក់ព័ន្ធ ស្ថានភាព នានា នៅ អ៊ុយក្រែន ព្រមទាំង ការបង្កើត ឲ្យ មាន « ការធានា សន្តិសុខ រយៈពេល វែង និង ស្រប ច្បាប់ » រវាង ប្រទេស រុស្ស៊ី និង ក្រុម ប្រទេស លោក ខាងលិច ។
ស្ថិត ក្នុង ឱកាស នោះ លោក ពូទីន ក៏ បាន លើកឡើង ប្រាប់ លោក ម៉ាក្រុង អំពី « សេចក្តីថ្លែងការណ៍ បែប បង្កហេតុ និង សកម្មភាព របស់ ថ្នាក់ដឹកនាំ ក្រុង កៀវ » ដែល បាន ប្រឆាំង ទៅនឹង កិច្ចព្រមព្រៀង ទី ក្រុង មីង (Minsk) ស្តីពី ការដោះស្រាយ វិបត្តិ អ៊ុយក្រែន ផងដែរ ។
គួរ បញ្ជាក់ ថា លោក ពូទីន និង លោក ម៉ាក្រុង បាន ធ្វើ ការសន្ទនា តាម ទូរស័ព្ទ កាលពី ថ្ងៃទី ២៨ និង ថ្ងៃទី ៣១ ខែមករា ដើម្បី ផ្លាស់ប្តូរ ទស្សន គ្នា ជុំវិញ បញ្ហា ដូច ខាងលើ នេះ ខណៈ ដែល ភាពតានតឹង រវាង រុស្ស៊ី និង ក្រុម សម្ព័ន្ធមិត្ត NATO ដឹកនាំ ដោយ សហរដ្ឋ អាមេរិក បាន ផ្ទុះឡើង ក្នុង រយៈពេល ប៉ុន្មាន សប្តាហ៍ កន្លងមក នេះ ។
អ្វី ដែល រុស្ស៊ី បាន ទាមទារ កន្លងមក នោះ គឺ សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត NATO ត្រូវតែ ធានា ថា អ៊ុយក្រែន គ្មាន ថ្ងៃ ក្លាយជា សមាជិក មួយ របស់ NATO ជាដាច់ខាត ព្រោះ វា នឹង ក្លាយជា ការគំរាមកំហែង ដោយ ប្រយោល ចំពោះ សន្តិសុខ រុស្ស៊ី ។ តែ យ៉ាងណា សហរដ្ឋ អាមេរិក បាន បដិសេធ ចំពោះ ការទាមទារ នេះ និង បាន កៀរគរ សម្ព័ន្ធមិត្ត ដើម្បី គំរាម ដាក់់ ទណ្ឌកម្ម ធ្ងន់ធ្ងរ លើ រុស្ស៊ី ប្រសិនបើ ការវាយប្រហារ អ៊ុយក្រែន ផ្ទុះឡើង ថែម ទៀត ៕
មន្រ្តី ជំនាញ៖ ជា ឃាតក ដែល សម្លាប់ មនុស្ស មួយ ថ្ងៃ ចាប់ពី ៣នាក់ ទៅ ៦នាក់ គឺ ការប្រើប្រាស់ ផ្លូវ មិន គោរព ច្បាប់ ចរាចរណ៍
( កំពង់ស្ពឺ ) ៖ នៅ ថ្ងៃទី៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ លោក ឈួន វ៉ន ប្រធាន ផ្នែក ដឹកជញ្ជូន នៃ ស .ស .យ . ក វិស័យ សាធារណការ និង ដឹកជញ្ជូន បាន ថ្លែង ក្នុង បើក វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី « សុវត្ថិភាព ច្បាប់ ចរាចរណ៍ » ថា សូម បងប្អូន ប្រើប្រាស់ ផ្លូវ ជាតិ ទាំងអស់ ត្រូវ គោរព ច្បាប់ ចរាចរ ឲ្យបាន ខ្ជាប់ខ្ជួន ព្រោះ កត្តា គ្រោះថ្នាក់ ចរាចរណ៍ បាន សម្លាប់ អ្នកធ្វើដំណើរ លើ ដង ផ្លូវ សាធារណៈ ជារៀងរាល់ ថ្ងៃ មិន តិច ជាង ៣ ទៅ ៦នាក់ ជារៀងរាល់ ។ គ្រោះថ្នាក់ ចរាចរណ៍ កាច សាហាវ ជាង ជំងឺ កូវីដ១៩ ទៅ ទៀត ។
លោក ឈួន វ៉ន បាន ថ្លែង បន្ត ថា ខេត្ត កំពង់ស្ពឺ រយៈពេល ៦០ ថ្ងៃ កន្លងមក នេះ ពុំ មាន អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ នៅឡើយ ទេ ។ នេះ យោង តាម របាយការណ៍ របស់ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ផ្ដល់ជូន ដោយ លោក សរ សុពុត្រា អភិបាល រង ខេត្ត កំពង់ស្ពឺ ដែល ប្រធាន ស .ស .យ . ក បាន បញ្ជាក់ ផងដែរ ថា អ្វី ដែល គួរ ខ្លាច គឺ គ្រោះថ្នាក់ ចរាចរណ៍ សម្លាប់ មនុស្ស រាល់ ថ្ងៃ ។
លោក ឈួន វ៉ន ស្នើសុំ ឲ្យ យុវជន ស .ស .យ . ក ទាំងអស់ ក្រោយពី បញ្ចប់ វគ្គ បណ្ដុះបណ្ដាល នេះ ទៅ ត្រូវ យក ទៅ អប់រំ ណែនាំ បន្ត ដល់ ក្រុម យុវជន ដទៃ ទៀត នៅ តាម មន្ទីរ អង្គភាព របស់ ខ្លួន ឲ្យបាន យល់ដឹង ពី ហានិភ័យ ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល បន្សល់ទុក្ខសោកនាដកម្ម ដ៏ ធំធេង សម្រាប់ សង្គម គ្រួសារ និង សង្គមជាតិ ហើយ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ឲ្យបាន ទាំងអស់ គ្នា ។
ក្នុង ពិធី បើក វគ្គ បណ្ដុះបណ្ដាល ស្ដីពី « សុវត្ថិភាព ច្បាប់ ចរាចរណ៍ » ដល់ សមាជិក សមាជិកា ស.ស .យ . ក ខេត្ត កំពង់ស្ពឺ នៅ បណ្ណាល័យ កំពង់ស្ពឺ មាន សមាជិក សមាជិកា ចូលរួម ជាង ២០០ នាក់ មកពី តាម មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង តំណាង អភិបាល រង ទទួលបន្ទុក ក្រុង ស្រុក ទាំង៨ និង បាន ចែក មួក សុវត្តិភាព ជូន សមាជិក អង្គ ពិធី ៕
ប្រកាស បញ្ចូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ថ្មី ចំនួន ១៣៧ នាក់ នៅ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូរណ៌ ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ សមាជិក សមាជិកា ថ្មី គណបក្ស ប្រជាជន កម្ពុជា ចំនួន ១៣៧ នាក់ នៅ ឃុំ ឆ្នុក ទ្រូ ស្រុក បរិបូរណ៌ ខេត្ត កំពង់ឆ្នាំង ត្រូវបាន ប្រកាស បញ្ចូល ជា សមាជិក បក្ស នា ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
តំណាង សមាជិក គណបក្ស ដែល ទើប បញ្ចូល ថ្មី ទាំង ១៣៧ នាក់ បាន ធ្វើ ការប្តេជ្ញាចិត្ត ស្មោះស្ម័គ្រ គាំទ្រ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា នៅ គ្រប់ អាណ្ណត្តិ ដើម្បី បន្ត រក្សា សន្តិភាព និង ការអភិវឌ្ឍ រីកចម្រើន របស់ ប្រទេសជាតិ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី ។
សមាជិក ថ្មី របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ឃុំ ឆ្នុក ទ្រូ ប្តេជ្ញា គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី និង គាំទ្រ លោក ហ៊ុន ម៉ាណែត ជា បេក្ខជន នាយក រដ្ឋមន្ត្រី សម្រាប់ ពេល អនាគត ។
លោក សូ ស៊ី នួន បាន លើកឡើង ថា គណបក្ស ប្រជាជន កម្ពុជា ជា គណបក្ស ដែល មាន ភាព ចាស់ទុំ ខាង នយោបាយ ជា គណបក្ស ដែល បាន រំដោះ ប្រទេសជាតិ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង បាន នាំយក នូវ សន្តិភាព និង ការអភិវឌ្ឍន៍ ពេញលេញ ជូន ប្រទេសជាតិ និង ប្រជាជន កម្ពុជា ជាក់ស្តែង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ការចាក់ វ៉ាក់សាំង ជូន ដល់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស ជា ការខិតខំ ប្រឹងប្រែង របស់ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក ថា ការសម្រេចចិត្ត ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ជា ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ បង្ហាញ ពី ការយល់ដឹង និង ឆន្ទៈ ចង់បាន សន្តិភាព និង អភិវឌ្ឍ បន្ត ទៅ មុខ ទៀត ។
នា ឱកាស នោះ ក្រុមការងារ បាន ឧបត្ថម្ភ វត្ថុអនុស្សាវរីយ៍ ជូន នូវ បណ្ណ សម្គាល់ សមាជិក បក្ស ចំនួន ១. សៀវភៅ លក្ខន្តិកៈ បក្ស ចំនួន ១ ក្បាល . សារ៉ុង ចំនួន ១. អាវយឺត១. មួក ចំនួន ១. អាហារ សម្រន់ ១កញ្ចប់ និង ថវិកា ចំនួន ១០.០០០ រៀល ក្នុង ម្នាក់ ។ ពិធី នេះ ប្រព្រឹត្ត ធ្វើឡើង ដោយ អនុវត្តន៍ តាម វិធានការ សុខាភិបាល និង វិធានការ « ៣កុំ និង ៣ការពារ » បាន យ៉ាង ខ្ជាប់ខ្ជួន ផងដែរ ៕ ខេត្ត ស្ទឹងត្រែង មាន ភ្ញៀវ ទៅ កម្សាន្ត ក្នុង ឱកាស ចូលឆ្នាំ ចិន ជាង ៧០០០ នាក់ បញ្ជាក់ ពី វិស័យ ទេសចរណ៍ ដំណើរការ ល្អ ឡើងវិញ
( ស្ទឹងត្រែង ) ៖ ភ្ញៀវ ទេសចរ ជាតិ បាន ទៅ លេង កម្សាន្ត តាម តំបន់ រមណីយដ្ឋាន ទេសចរណ៍ នានា ក្នុង ខេត្ត ស្ទឹងត្រែង មាន ប្រមាណ ជាង ៧០០០ នាក់ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ចិន វៀតណាម រយៈពេល ៣ ថ្ងៃ ។ មន្ត្រី នៃ មន្ទីរ ទេសចរណ៍ ខេត្ត បាន ចាត់ទុក ថា នេះ ជា សញ្ញា មួយ បង្ហាញ ពី វិស័យ ទេសចរណ៍ បាន ដំណើរការ ល្អ ឡើងវិញ បន្ទាប់ពី ជួប វិបត្តិ ជំងឺ កូវីដ១៩ កន្លងមក ។
ក្នុង ដំណើរកម្សាន្ត របស់ ភ្ញៀវ ទេសចរ នៅ តាម តំបន់ រមណីយដ្ឋាន ទេសចរណ៍ នានា នៅ ខេត្ត ស្ទឹងត្រែង ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ប្រពៃណី ចិន វៀតណាម រយៈពេល ៣ ថ្ងៃ លោក អ៊ុន ប៉ោសឿន ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត បាន កត់សំគាល់ ថា ភ្ញៀវ ទេសចរ មាន ភាពសប្បាយរីករាយ ក្នុង ការធ្វើដំណើរកម្សាន្ត និង មាន ការទទួលខុសត្រូវ ខ្ពស់ ចំពោះ សុខភាព ផងដែរ ។
លោក ប្រធាន មន្ទីរ បន្ត ថា៖ « នេះ ជា ការរួមគ្នា អនុវត្ត នូវ វិធាន សុខាភិបាល ទោះបី ថា បងប្អូន ប្រជាពលរដ្ឋ យើង ទទួលបាន ការចាក់ វ៉ាក់សាំង ហើយក៏ ដោយ ពួកគាត់ មាន ការយល់ដឹង និង គោរព បាន យ៉ាង ខ្ជាប់ខ្ជួន នូវ វិធានការបី កុំ បី ការពារ និង ចូលរួម ផ្នែក បរិស្ថាន ក៏ បាន ល្អ ប្រសើរ ដែរ » ។
ទន្ទឹមនឹង ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ គួបផ្សំ នឹង រាជ រដ្ឋាភិបាល បាន បង្កើន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ លោក សំណូមពរ ឱ្យ ម្ចាស់ រមណីយដ្ឋាន គិត ពី ការរៀបចំ ឱ្យ មាន សោភណ្ឌភាព និង សុវត្ថិភាព ជូន ភ្ញៀវ ធ្វើ យ៉ាងម៉េច ឲ្យ មាន សុវត្ថិភាព ភ្ញៀវ ទេសចរ ដែល ចូលមក លេង កម្សាន្ត នៅ ទីនេះ ជាពិសេស គោរព នូវ វិធានការ « ៣កុំ និង ៣ការពារ » ហើយ ត្រូវ មាន វិធានការ សុវត្ថិភាព ទេសចរណ៍ ។
លោក ផាន់ ប៊ុន ហាត់ ភ្ញៀវ ទេសចរ មកពី ខេត្ត កំពង់ចាម បាន ទទួលស្គាល់ ថា នេះ ជា ផ្នែក មួយ ពង្រឹង ទៅ លើ វិស័យ ទេសចរណ៍ ស្រប គ្នា ទៅនឹង រាជ រដ្ឋាភិបាល ធ្វើ ការអភិវឌ្ឍ ប្រទេស មាន ការរីកចម្រើន ឡើង ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ហើយ កម្លាំង សមត្ថកិច្ច មូលដ្ឋាន ក៏ បាន ការពារ សន្តិសុខ បាន ល្អ ប្រសើរ ផងដែរ ។
លោក អះអាង ថា ក្នុង ដំណើរកម្សាន្ត លោក នឹង ធ្វើដំណើរ ឱ្យ បាន គ្រប់ ខេត្ត នៅ ភាគ ឥសាន្ត នៃ ប្រទេស កម្ពុជា ព្រោះ ត្រូវ ចេញដំណើរ ពី ខេត្ត កំពង់ចាម ចូលទៅ ខេត្ត កំពង់ធំ ទៅកាន់ ខេត្ត ព្រះវិហារ បន្ត មក សំរាក នៅ ខេត្ត ស្ទឹងត្រែង ហើយ ចេញដំណើរ ទៅ រតនគីរី និង ទៅ សំរាក នៅ មណ្ឌលគីរី ចេញ ទៅ ខេត្ត ក្រចេះ ហើយ បន្ត ទៅ ត្បូងឃ្មុំ និង ចូល ខេត្ត កំពង់ចាម វិញ តែម្តង ។
សូម បញ្ជាក់ ថា ភ្ញៀវ ទេសចរ ជាតិ ឆ្នាំ នេះ មក លេង នៅ តាម រមណីយដ្ឋាន នានា ក្នុង ខេត្ត ស្ទឹងត្រែង មិន ដល់ មួយ ម៉ឺន នាក់ ក៏ ពិត មែន តែ ជា វត្តមាន មួយ បង្ហាញ ឱ្យ ឃើញ ពី វិស័យ ទេសចរ ជាតិ យើង កំពុង ត្រូវបាន ដំណើរ ឡើងវិញ បន្ទាប់ពី ប្រមុខ រាជ រដ្ឋាភិបាល បាន ផ្តើម បើក ប្រទេស ឡើងវិញ នៅ ចុង ឆ្នាំ ២០២១មក ៕
ផ្ទះ ចាស់ អាយុកាល ជិត ១០០ ឆ្នាំ ចំនួន ១៣ល្វែង នៅ ផ្សារ ក្រោម ក្នុង ក្រុង កំពង់ឆ្នាំង កំពុង ដំណើរការវាយ កម្ទេចចោល
( កំពង់ឆ្នាំង ) ៖ ផ្ទះ ថ្ម ទ្រុឌទ្រោម ចំនួន ១៣ល្វែង ដែល មាន អាយុកាល ៩១ ឆ្នាំ ហើយ នោះ នៅក្នុង ភូមិ ផ្សារ ឆ្នាំង សង្កាត់ ផ្សារ ឆ្នាំង ក្រុង កំពង់ឆ្នាំង បាន និង កំពុង ដំណើរការវាយ កម្ទេចចោល ហើយ ។ វា ជា អគារ សម័យ អាណានិគម និយម បារាំង ដែល ត្រូវបាន សាងសង់ ឡើង នៅ ឆ្នាំ ១៩៣១ ។
បុរស ម្នាក់ ជា មេ ការការទទួលខុស ត្រូវ ក្នុង ការវាយ កម្ទេច ផ្ទះ ថ្ម ទាំង ១៣ ល្វែង នេះ នៅ ព្រឹក ថ្ងៃទី ៤ ខែកុម្ភៈ ឆ្នាំ ២០ ២២ បាន និយាយ ឲ្យដឹង ថា ក្រុមហ៊ុន លោក បាន ដំណើរ ការវាយ កម្ទេច ផ្ទះ ថ្ម នេះ បាន បាន រយៈពេល ៣ ថ្ងៃ ហើយ និង ប្រហែល ជាង ១០ ថ្ងៃ ទៀត នឹង រួចរាល់ ។
បុរស ជា មេការ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការសាងសង់ ផ្ទះ ថ្ម ទាំង ១៣ល្វែង នេះ ឡើងវិញ គឺ ម្ចាស់ ផ្ទះ មិន ទាន់ ចរចា តម្លៃ ត្រូវ ជាមួយ ក្រុមហ៊ុន ដែល ត្រូវ សាងសង់ ផ្ទះល្វែង នេះ ឡើងវិញ នៅឡើយ ដែរ ។
ដោយឡែក ប្រភព ពី ប្រជាពលរដ្ឋ នៅជិត ផ្ទះល្វែង នេះ បាន ឲ្យដឹង ថា ថ្លៃ ឈ្នួល វាយ កម្ទេច ផ្ទះ ថ្ម ១៣ល្វែង នេះ ក្នុង មួយ ល្វែង ៗ ត្រូវ ចំណាយ ប្រាក់ ប្រមាណ ១.៧០០ ដុល្លារ ។
លោក ហ៊ីង ភ័ព មិនា អភិបាល រង ក្រុង កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា កាលពី សប្តាហ៍ មុន អាជ្ញាធរ ខេត្ត បាន ចេញ លិខិត អនុញ្ញា ឲ្យ ម្ចាស់ ផ្ទះ ទាំង ១៣ល្វែង ជួល ក្រុមហ៊ុន កម្ទេច ផ្ទះ ថ្ម ទ្រុឌទ្រោម នេះ ចោល ដោយ ម្ចាស់ ផ្ទះ ត្រូវ ចរចា ថ្លៃ ឈ្នួល វាយ ផ្ទះ ថ្ម នេះ ជាមួយ ក្រុមហ៊ុន ដោយ ខ្លួន ឯង ។
គួរ បញ្ជាក់ ថា ការបំផ្ទុះ គ្រាប់បែក ធ្វើ អត្តឃាត ខ្លួន ឯង ពីសំណាក់ មេដឹកនាំ ISIS ខាងលើ នេះ ក៏ បាន ធ្វើឲ្យ មនុស្សម្នា ផ្សេង ទៀត នៅក្នុង អគារ លំនៅឋាន កម្ពស់ ៣ជាន់ ក្នុង ក្រុង Atmeh នោះ បាត់បង់ជីវិត ផងដែរ ។ សហរដ្ឋ អាមេរិក បាន ចាត់ទុក ថា ការបាត់បង់ជីវិត ជន ស៊ីវិល ទាំងអស់ នេះ គឺជា ស្នាដៃ របស់ ក្រុម ISIS ៕
ចំណេះដឹង ទូទៅ៖ នៅ សតវត្ស ទី ១៨ អ្នកប្រាជ្ញ ពីរ រូប ធ្លាប់ ផ្ទុះ សង្គ្រាម ពាក្យសម្ដី ដាក់ គ្នា រហូតដល់ ថ្ងៃ ស្លាប់
( ភ្នំពេញ ) ៖ សតវត្ស ទី ១៦ដល់ ទី១៩ ជា ពេលវេលា ដែល លេចឡើង នូវ បណ្ដា អ្នកប្រាជ្ញ ល្បី ៗ ជា បន្តបន្ទាប់ ដោយ អ្នក ខ្លះ ជា អ្នក រកឃើញ នូវ របកគំហើញ ថ្មី ៗ អ្នក ខ្លះ ទៀត ក៏ ជា បង្កើត នូវ ទស្សនវិជ្ជា ផ្សេង ៗ ប៉ុន្តែ នៅ អំលុង ចុង សតវត្ស ទី ១៨ មាន សង្គ្រាម ពាក្យសម្ដី របស់ អ្នកប្រាជ្ញ ពីរ រូប បាន ផ្ទុះឡើង ព្រោះតែ ការយល់ឃើញ ផ្សេង ៗ ពី គ្នា ។
លោក រ៉ូសូ បាន ប្រឆាំង នឹង វិសមភាព ក្នុង ការចាត់ ថ្នាក់ របស់ វណ្ណៈ ខណៈ ដែល លោក វ៉ុល ទែរ បាន ប្រឆាំង អំពី សេរីភាព នៃ ការបញ្ចេញមតិ និង សាសនា ។ នៅ មាន កិច្ចសន្យា សង្គម និង រឿងរ៉ាវ ជាច្រើន ទៀត ដែល ធ្វើឱ្យ សង្គ្រាម ពាក្យសម្តី នេះ បន្ត មាន រហូតដល់ លោក ទាំង ពីរ ទទួលមរណភាព រៀង ៗ ខ្លួន ។
តែ ទោះជា យ៉ាងណា អ្នកប្រាជ្ញ ទាំង ពីរ នេះ ហើយ ដែល បាន ផ្លាស់ប្តូរ ផ្នត់គំនិត នៃ ទស្សនៈ របស់ មនុស្ស យើង នា ពេល ក្រោយ ៗ មក ទៀត ។ លោក ទាំង ពីរ មាន ទស្សនៈ ដូចគ្នា ត្រង់ ការប្រឆាំង នឹង ផ្នត់គំនិត បុរាណ ក៏ប៉ុន្តែ មាន គំនិត ផ្ទុយ គ្នា ក្នុង ទស្សនៈ នៃ ការផ្លាស់ប្ដូរ ផ្នត់គំនិត សម័យ ទំនើប ។
ការអះអាង បែប នេះ របស់ អគ្គ មេបញ្ជាការ កងទ័ព ជើងគោក ភូមិន្ទ ថៃ បាន ធ្វើ ក្នុង ឱកាស ដែល លោក ចូល ជួប សម្តែង ការគួរសម ជាមួយ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ នា រសៀល ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នាទី ស្តីការ ក្រសួង ការពារ ជាតិ ក្នុង ឱកាស បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។
នៅក្នុង ឱកាស នោះ អគ្គ មេបញ្ជាការ កងទ័ព ជើងគោក ភូមិន្ទ ថៃ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ និង ពី នាយក រដ្ឋមន្ត្រី ថៃ លោក ប្រាយុទ្ធ ចាន់ អូចារ ជូន ដល់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ។ នាយ ឧត្តមសេនីយ៍ ក៏ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការវិវត្តន៍ រីកចម្រើន លើ គ្រប់ វិស័យ របស់ ប្រទេស កម្ពុជា និង កងយោធពល ខេមរភូមិន្ទ ។
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន សម្តែង នូវ ការស្វាគមន៍ និង វាយតម្លៃ ខ្ពស់ ចំពោះ នាយ ឧត្តមសេនីយ៍ ណារ៉ុង ផាន់ ជិត កែវ ថា ដែល បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ នៃ កងទ័ព ជើងគោក ភូមិន្ទ ថៃ បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា និង ជួបពិភាក្សា ការងារ ទ្វេ ភាគី ជាមួយនឹង ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក ។
បន្ថែម ពី នេះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន គូសបញ្ជាក់ ដែរ ថា ក្នុង នាម ប្រធាន ប្តូរ វេន អាស៊ាន កម្ពុជា នឹង ខិតខំ បំពេញ តួនាទី ឱ្យ បាន ពេញលេញ និង បាន ស្នើសុំ ដល់ អគ្គ មេបញ្ជាការ កងទ័ព ជើងគោក ភូមិន្ទ ថៃ ជួយ គាំទ្រ ដើម្បីឱ្យ កិច្ចប្រជុំ នៅ ឆ្នាំ នេះ ទទួលបាន ជោគជ័យ តាម ការគ្រោងទុក ៕
មន្ត្រី ជាន់ ខ្ពស់៖ គ.ជ. ប ធ្វើការ យ៉ាង ប្រុងប្រយ័ត្ន និង ហ្មត់ចត់ ប្រកបដោយ ភាពត្រឹមត្រូវ តម្លាភាព និង យុត្តិធម៌ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២
( កំពត ) ៖ លោក តុ ប ឫទ្ធី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន សេវា ច្បាប់ និង បច្ចេកទេស នៃ អគ្គ លេខាធិការ គ.ជ. ប និង ជា ប្រធាន ក្រុម ចុះ សម្របសម្រួល និង ត្រួតពិនិត្យ ការប្រឡង ជ្រើសរើស មន្ត្រី លេខាធិការដ្ឋាន នៃ គណៈកម្មការរៀបចំ ការបោះឆ្នោត ខេត្ត កំពត បាន លើកឡើង ថា សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ខាងមុខ នេះ ជា គោលការណ៍ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត គ.ជ. ប បាន ធ្វើការ យ៉ាង ប្រុងប្រយ័ត្ន និង ហ្មត់ចត់ ប្រកបដោយ ភាពត្រឹមត្រូវ តម្លាភាព និង យុត្តិធម៌ ។
ការលើកឡើង បែប នេះ របស់ លោក តុ ប ឫទ្ធី បាន ធ្វើឡើង ក្នុង ឱកាស ចុះ សម្របសម្រួល និង ត្រួតពិនិត្យ ការប្រឡង ជ្រើសរើស មន្ត្រី លេខាធិការដ្ឋាន នៃ គណៈកម្មការ រៀបចំ ការបោះឆ្នោត ខេត្ត កំពត នា ព្រឹក ថ្ងៃទី ០៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
