អ្នក ឧកញ៉ា ទ្រី ភាព បាន ឱ្យដឹង ដែរ ថា ក្រុមហ៊ុន ទាំង ៩ របស់ លោក ដែល កំពុង ដំណើរការ នា ពេល បច្ចុប្បន្ន នេះ មាន ដូចជា ក្រុមហ៊ុន ធ្វើ ផ្លូវថ្នល់ ក្រុមហ៊ុន ដឹកជញ្ជូន ក្រុមហ៊ុន ប្រេង ក្រុមហ៊ុន ចំការ កៅស៊ូ និង ក្រុមហ៊ុន ទេសចរណ៍ ជាដើម ។ ក្រុមហ៊ុន ដែល ដំណើរការ ល្អ ជាង គេ គឺ ក្រុមហ៊ុន ចំការ កៅស៊ូ ដែល មាន ផ្ទៃដី ដាំដុះ ប្រមាណ ជា ៦ពាន់ ហិកតា នៅក្នុង ស្រុក រវាង ខេត្ត ព្រះវិហារ ។
WHO ៖ សំរាម ទ្រង់ទ្រាយ ធំ ពី បណ្តា មន្ទីរពេទ្យ កូវីដ - ១៩ កំពុង គំរាមកំហែង សុខភាព ទូទាំង ពិភពលោក
របាយការណ៍ ខាង លើ នេះ ក៏ បាន គូសបញ្ជាក់ ផងដែរ ថា ឧបករណ៍ វេជ្ជសាស្ត្រ មួយចំនួន អាច មាន ជាប់ នូវ មេរោគ COVID-19 ក្រោយ ប្រើប្រាស់ រួច ដែល ជា ហេតុ បង្ខំ ឲ្យ ក្រុមការងារ សុខាភិបាល ធ្វើ ការដុត កម្ទេចចោល ដើម្បី បំផ្លាញ មេរោគ ទាំងនោះ ។ WHO បាន ព្រមាន ថា សហគមន៍ ក្រីក្រ និង មិន បាន ចាត់ចែង ការគ្រប់គ្រង សំរាម វេជ្ជសាស្ត្រ ទាំងនេះ ឲ្យបាន ត្រឹមត្រូវ នោះ នឹង បង្ក ផល ប៉ះពាល់ ដល់ ខ្យល់់ អាកាស និង ទឹក ប្រើប្រាស់ ។
របាយការណ៍ WHO ក៏ បាន ជំរុញ ផងដែរ ឲ្យ មាន ការធ្វើ កំណែទម្រង់ និង ការវិនិយោគ ក្នុង នោះ រួម ការកាត់បន្ថយ ការប្រើប្រាស់ របស់ វេចខ្ចប់ ដែល នាំឲ្យ មាន ការបោះចោល សំរាម ផ្លាស្ទិក កាន់តែ ច្រើន និង ងាក មក ប្រើប្រាស់ របស់របរ ដែល អាច ប្រើប្រាស់ ឡើងវិញ បាន ជាដើម ។
នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត ម៉ៅ ប៊ុន ណារិន សូម គោរព អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ត្រូវបាន ជ្រើសរើស ជា ជ័យលាភី ពានរង្វាន់ សន្តិភាព ស៊ុន ហាក់ ឆ្នាំ ២០២២
ឯកឧត្តម វ៉ា គឹម ហុង គោរព អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ត្រូវបាន ជ្រើសរើស ជា ជ័យលាភី ពានរង្វាន់ សន្តិភាព ស៊ុន ហាក់ ឆ្នាំ ២០២២
សម្ដេច ហេង សំរិន ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ត្រូវបាន ជ្រើសរើស ជា ជ័យលាភី ពានរង្វាន់ សន្តិភាព ស៊ុន ហាក់ ឆ្នាំ ២០២២
លោកស្រី រដ្ឋលេខាធិការ បាន ដាស់តឿន សា ជា ថ្មី ទៀត ថា ដើម្បី រស់ នៅ តាម គន្លង ប្រក្រតី ភាព ថ្មី ក្នុង បរិបទ ជំងឺ កូវីដ បាន យូរអង្វែង តទៅ ប្រជាជន ទាំងអស់ គ្នា ត្រូវ ខិតខំ ចូលរួម អនុវត្ត តាម វិធានការ « ៣ការពារ និង ៣កុំ » និង វិធានការ សុខាភិបាល ផ្សេង ទៀត ពិសេស ក្នុង បុណ្យ ចូល ឆ្នាំ ចិន នេះ ឬ ពិធី អាពាហ៍ពិពាហ៍ និង ពិធី កម្ម ផ្សេង ៗ ។
ចំណុច មួយ ទៀត ដែល លោកស្រី ឱ វណ្ណឌីន បាន ស្នើ យ៉ាង ទទូច ដែរ នោះ គឺ អំពាវនាវ ឱ្យ ប្រជាជន ដែល បាន ចាក់ វ៉ាក់សាំង ដូស ទី២ហើយ គឺ សូម ទៅ ចាក់ដូស ទី៣ នៅ តាម ទីតាំង នានា មាន មណ្ឌល សុខភាព មន្ទីរពេទ្យ បង្អែក និង មន្ទីរពេទ្យ ជាតិ ទៅ តាម ពេល កំណត់ ឲ្យបាន គ្រប់ គ្នា ពីព្រោះ ការចាក់ វ៉ាក់សាំង នេះ គឺ ជួយ បង្កើន អង់ទីករ បង្កើន ភាពសុាំ ដែល ប្រៀប ដូចជា កង ការពារ ក្នុង រាងកាយ ក្នុង ការប្រឆាំង ជាមួយ មេរោគ កូវីដ១៩ ដើម្បីឱ្យ សហគមន៍ រួចផុត ពី ការចម្លង ជំងឺ កូវីដ១៩ កាត់បន្ថយ អត្រា អ្នក ឆ្លង និង អត្រា អ្នកស្លាប់ ផងដែរ ។
ចំពោះ អ្នកដល់ វេន ចាក់ ដូស ទី៤ នៅ រាជធានី ភ្នំពេញ ក៏ ត្រូវ ទៅ ចាក់ នៅ តាម ទីតាំង និង ពេលវេលា ដែល រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ជូន ដំណឹង ជា បណ្ដើរ ៗ នោះ ដើម្បី ការពារ រាងកាយ ពី មេរោគ បំប្លែង ថ្មី អូមី ក្រុង ។
គួរ ជម្រាប ថា នា ឱកាស ឈប់ សម្រាក និង ដើរកម្សាន្ត សម្រាប់ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ នេះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក៏ បាន អំពាវនាវ ដល់ ប្រជាជន សូម មាន ការប្រុងប្រយ័ត្ន ចំពោះ អូមី ក្រុង (Omicron) ដែល ជា ប្រភេទ ជំងឺ កូវីដ១៩ បំប្លែង ថ្មី ខណៈ នៅក្នុង សហគមន៍ កំពុង បន្ត រាលដាល មិន ទាន់ ថយចុះ នៅឡើយ ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី បាន អំពាវនាវ ឱ្យ ប្រជាជន បន្ត អនុវត្ត វិធានការ « ៣ការពារ និង ៣កុំ » ឱ្យ បាន ខ្ជាប់ខ្ជួន គួបផ្សំ ជាមួយនឹង ការចាក់ វ៉ាក់សាំង ឱ្យ បាន គ្រប់ ដូស ទៅ តាម ពេល កំណត់ ទើប អាច ធានា បាន នូវ ការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ ៕
អភិបាល ខេត្ត កំពង់ចាម ឯកភាព ឱ្យ រៀបចំ សម្ពោធ អគា រដ្ឋបាល ១ខ្នង នៃ ពុទ្ធិ សាកលវិទ្យាល័យ សម្តេច តេជោ ហ៊ុន សែន ដែល សាង់ សង់ អស់ ជា ង ៦៤ម៉ឺន ដុល្លារ
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី១ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ជួប ពិភាក្សា ការងារ មួយចំនួន ជាមួយ ព្រះ សាកលវិទ្យាធិការ និង គណៈ គ្រប់គ្រង នៃ ពុទ្ធិ សាកលវិទ្យាល័យ សម្តេច តេជោ ហ៊ុន សែន ស្តីពី ការបណ្តុះបណ្តាល និង ស្នេី សុំ គោលការណ៍ ប្រារព្ធ ពិធី បេីក សម្ពាធ អគារ រដ្ឋបាល ថ្មី ១ខ្នង ដែល មាន ទីតាំង ស្ថិត នៅ ភូមិ ជ្រោយ ថ្ម សង្កាត់ បឹង កុក ក្រុង កំពង់ចាម នា ពេល ខាងមុខ នេះ ផងដែរ ។
ក្នុង ឱកាស នោះ ដែរ លោក អអភិបាល ខេត្ត បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ព្រះសាកលវិទ្យាធិការ និង គណៈ គ្រប់គ្រង នៃ ពុទ្ធិ សាកលវិទ្យាល័យ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ដែល បាន រួម សាមគ្គី គ្នា ក្នុង ការខិតខំ គៀង គរ ស្វែងរក សប្បុរសជន ដេីម្បី សាងសង់ អគារ រដ្ឋបាល ថ្មី ១ខ្នង ដែល មាន បណ្ដោយ ប្រវែង ១៨ម៉ែត្រ ទទឹង ប្រវែង ១៦ម៉ែត្រ កម្ពស់ ៤ជាន់ ក្នុង តម្លៃ ប្រមាណ ជាជាង ៦៤ ម៉ឺន ដុល្លារ សម្រាប់ ឱ្យ មន្ត្រី សង្ឃ និង មន្ត្រីរាជការ បំពេញ ការងារ ប្រចាំ ថ្ងៃ ។
ជាមួយគ្នា នោះ លោក អភិបាល ខេត្ត ក៏ បាន ឯកភាព គាំទ្រ ចំពោះ ការ ស្នើ សុំ រៀបចំ ប្រារព្ធ ពិធី បេីក សម្ពាធ ដាក់ ឲ្យ ប្រេី ប្រាស់ ជា ផ្លូវការ នូវ អគារ រដ្ឋបាល នៃ ពុទ្ធិ សាកលវិទ្យាល័យ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ទើប នឹង សាងសង់ រួចរាល់ ជា ស្ថាពរ ក្នុង អំឡុង ខែ វិច្ឆិកា ឆ្នាំ ២០២១ កន្លងទៅ នេះ ។
( ភ្នំពេញ ) ៖ មហា ឧបាសិកា សោម លេន ដែល ត្រូវ ជា ញោម ស្រី បង្កេីត របស់ សម្តេច ព្រះពុទ្ធ ជ័យ មុនី ឃឹម សន ព្រះមេ ប្រធាន លេខាធិការដ្ឋាន គណៈ សង្ឃ នាយក និង ជា គណរាជធានី ភ្នំពេញ បាន ទទួល អនិច្ចកម្ម នៅ ថ្ងៃទី១ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
បច្ចុប្បន្ន សព មហា ឧបាសិកា សោម លេន ត្រូវបាន តម្កល់ នៅ ភូមិ ចុង អង្ករ ឃុំ ពេជសារ ស្រុក កោះ អណ្តែ ត ខេត្ត តាកែវ ៕
ថៃ៖ មនុស្ស ជាង ៧. ៤០០ នាក់ ឆ្លង កូវីដ - ១៩ និង អ្នកជំងឺ ១២នាក់ ស្លាប់ ក្នុង របាយការណ៍ ថ្ងៃអង្គារ នេះ
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ១២នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ៨. ៧១៥ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
ក្រសួង បរិស្ថាន ណែនាំ ពី វិធានការ ទប់ស្កាត់ និង កាត់បន្ថយ ការបំពុល ខ្យល់ សាធារណៈ ដើម្បី ធានា គុណភាព ខ្យល់ ឱ្យ ល្អ ប្រសើរ
តាម ការបញ្ជាក់ របស់ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា មន្ត្រី នាំ ពាក្យ នៃ ក្រសួង បរិស្ថាន គុណភាព ខ្យល់ នៅតែ មាន កម្រិត ក្រោម ស្តង់ដា មាន គុណភាព ល្អ បើ ទោះបីជា កម្រិត កំហាប់ ភាគ ល្អិត និចល មាន ការកើនឡើង ជាពិសេស កំហាប់ ប៉ារ៉ាម៉ែត្រ ភាគ ល្អិត និចល PM10 និង PM2.5 បន្តិច ក៏ដោយ ។
លោក រដ្ឋលេខាធិការ បាន ថ្លែង ថា យោង តាម លទ្ធផល នៃ ការអនុវត្ត តាមដាន គុណភាព ខ្យល់ ពី ស្ថានីយ ត្រួតពិនិត្យ គុណភាព ខ្យល់ ដែល ក្រសួង បរិស្ថាន បាន ដំឡើង នៅ តាម បណ្តា រាជធានី - ខេត្ត ទូទាំង ប្រទេស បាន បង្ហាញ ថា ស្ថានភាព គុណភាព ខ្យល់ មាន ការធ្លាក់ចុះ ជាពិសេស កំហាប់ ប៉ារ៉ាម៉ែត្រ ភាគ ល្អិត និចល PM10 និង PM2.5 អាច មាន កើនឡើង លើស កម្រិត ស្តង់ដា នៅ បណ្តា ខេត្ត មួយចំនួន ដែល ជា ហានិភ័យ បង្ក ផល ប៉ះពាល់ ចំពោះ សុខភាព ប្រជាពលរដ្ឋ និង បរិស្ថាន ។
លោក នេត្រ ភក្ត្រា បាន ឱ្យដឹង ថា ប្រភព និង សកម្មភាព សំខាន់ ៗ ដែល ជា ហេតុ បង្កឱ្យ មាន កំហាប់ ភាគ ល្អិត និចល PM10 និង PM2.5 មាន ការកើនឡើង រួម មាន ការបញ្ចេញ ផ្សែង ពី រោងចក្រ ឧស្សាហកម្ម ពី យានយន្ត ប្រើប្រាស់ ប្រេង ម៉ាស៊ូត ពី ចំហេះ ឥន្ធនៈ ផ្សេង ៗ ពិសេស ភ្លើង ឆេះ ព្រៃ ការដុត វាល ស្មៅ ការដុត សំណល់ កសិកម្ម ការដុត រាន ព្រៃ ការដុត គល់ ជញ្រ្ជាំង ស្រូវ ការដុត សំរាម សំណល់ រឹង នៅ ទីចំហ និង ការឆេះ សំណល់ ទីលាន ចាក់ សំណល់ ព្រមទាំង ការហុយ ធូលីពី ការដ្ឋាន សំណង់ ជាដើម ។
លោក រដ្ឋលេខាធិការ បាន ថ្លែង ថា ដោយ ពិនិត្យ ឃើញ នូវ បញ្ហា បែប នេះ និង ដើម្បី កែលម្អ គុណភាព ខ្យល់ នៅ តាម រាជធានី - ខេត្ត ក្រសួង បរិស្ថាន ជម្រាប ជូន ដល់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ និង មន្ទីរ បរិស្ថាន រាជធានី - ខេត្ត នូវ វិធានការ មួយចំនួន ដូច ខាងក្រោម៖
១៖ ត្រូវ ចាត់ វិធានការ ទប់ស្កាត់ ភ្លើង ឆេះ ព្រៃ និង ការដុត សំរាម សំណល់ រឹង នៅ តាម ទី ចំហ ការឆេះ នៅ តាម ទីលាន ចាក់ សំណល់ ។២៖ ត្រូវ ចាត់ វិធានការ ទប់ស្កាត់ ការហុយ ធូលីពី ការដ្ឋាន សំណង់ និង ការដា្ឋ ន កែលម្អ ហេដ្ឋារចនាសម្ព័ន្ធ និង ធូលី ហុយ នៅ តាម ដងផ្លូវ ។ ៣៖ ការធ្វើ សម្អាត អនាម័យ នៅ តាម ដងផ្លូវ និង ទី សាធារណៈ ។ ៤៖ អប់រំ ប្រជាពលរដ្ឋ កុំ ឱ្យ ដុត សំរាម សំណល់ រឹង ការដុត ស្មៅ គល់ ជញ្រ្ជាំង និង សំណល់ កសិកម្ម ផ្សេង ៗ ទៀត ។
លោក បាន ថ្លែង ថា ជា វិធានការ នៃ ការកាត់បន្ថយ ការបំពុល ខ្យល់ ក្រសួង បរិស្ថាន បាន ផ្តួចផ្តើម រៀបចំ ផែនការខ្យល់ ស្អាត កម្ពុជា ដោយ មាន កិច្ចសហការផ្តល់ បច្ចេកទេស និង ហរិញ្ញវត្ថុ ពី កម្មវិធី ភាព ជាដៃគូ ស្តីពី ខ្យល់ ស្អាត អាស៊ី ប៉ាស៊ីហ្វិក នៃ កម្មវិធី បរិស្ថាន សហ ប្រជាជាតិ និង វិទ្យាស្ថាន បរិស្ថាន ស្តុក ខូម នៃ ប្រទេស ស៊ុយ អ៊ែត ។
ថ្មី ៗ នេះ ក្រសួង បរិស្ថាន បាន ចេញផ្សាយ ផែនការខ្យល់ ស្អាត កម្ពុជា ដែល ជា ឯកសារ យុទ្ធសាស្រ្ត ជាតិ សំដៅ កំណត់ សកម្មភាព កាត់បន្ថយ ការបញ្ចេញ ឧស្ម័ន បំពុល ខ្យល់ នៅ ប្រទេស កម្ពុជា ។
ផែនការខ្យល់ ស្អាត កម្ពុជា ត្រូវបាន រៀបចំឡើង ដោយ ធ្វើ សមាហរណកម្ម ជាមួយ គោល នយោបាយ និង លិខិត បទដ្ឋាន គតិយុត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដូចជា សារាចរ លេខ ០១ ស្តីពី វិធានការ ទប់ស្កាត់ និង កាត់បន្ថយ ការបំពុល ខ្យល់ សាធារណៈ អនុក្រឹត្យ ស្តីពី ការត្រួតពិនិត្យ ការបំពុល ខ្យល់ និង ការរំខាន ដោយ សំឡេង ដើម្បី ដាក់ ចេញ ជា វិធានការ កាត់បន្ថយ ការបញ្ចេញ សារធាតុ បំពុល ខ្យល់ ។
លោក រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន អំពាវនាវ ដល់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ និង មន្ទីរ បរិស្ថាន រាជធានី - ខេត្ត មាន វិធានការ ទប់ស្កាត់ ឱ្យ មាន ប្រសិទ្ធភាព និង ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ដើម្បី រក្សា បាន នូវ គុណភាព ខ្យល់ ល្អ ប្រសើរ ដល់ ពលរដ្ឋ កម្ពុជា ៕ ស្វែងយល់ ពី វប្បធម៌ « សុខដុម » នៃ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន
* សុខដុម ជា រឿង សំខាន់ មួយ ដែល អាច ផ្សារភ្ជាប់ បណ្តា ប្រទេស ជាមួយគ្នា
* ភាពខុសគ្នា រួម រស់ នៅ ជាមួយ ក កើត ជា ភាពសុខដុមរមនា
* ធម្មជាតិ និង មនុស្សជាតិ មាន ភាពសុខដុម
វប្បធម៌ « សុខដុម » ផ្តួចផ្តើម ពី ទស្សនៈ គាំពារ អេកូឡូស៊ី ដែល សមស្រប នឹង តម្រូវការទូទៅ នៃ ការអភិវឌ្ឍ បៃតង របស់ ប្រជាជន នៃ បណ្តា ប្រទេស ។ ការអនុលោម តាម ក្រឹត ក្រម ធម្មជាតិ និង គោរព ធម្មជាតិ មាន អំណោយផល ដល់ ការជំរុញ សេដ្ឋកិច្ច ពិភពលោក ឱ្យ ស្តារ ឡើងវិញ ប្រកបដោយ ភាព បៃតង ។
* មនុស្សម្នា រួម រស់ នៅ ដោយ សុខដុមរមនា
វប្បធម៌ « សុខដុម » ផ្សព្វផ្សាយ ពី សច្ចធម៌ ដែល ថា មនុស្ស ត្រូវ មាន គុណធម៌ ដែល សមស្រប នឹង តម្រូវការទូទៅ របស់ ប្រជាជន គ្រប់ ប្រទេស ដែល ចង់បាន ការផ្លាស់ប្តូរ គ្នា យ៉ាង សុខដុមរមនា ។ យើង មិន បំភ្លេច គ្រា ដែល មនុស្សម្នា ជួយ គាំទ្រ គ្នា ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង ជួប នឹង លំបាក ទើប ដឹង ពី មិត្តភាព ពិត ។
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី១ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ថា មិន មាន អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ នោះ ទេ រយៈពេល ២៨ ថ្ងៃ ជាប់ គ្នា ហើយ ចាប់ពី តាំងពី ថ្ងៃទី ៥ ខែមករា មក កម្ពុជា មិន មាន អ្នកស្លាប់ ដោយ ជំងឺ កូវីដ១៩ ខណៈ ថ្ងៃ នេះ រកឃើញ អ្នក ឆ្លង កូវីដ ថ្មី ប្រភេទ អូមី ក្រុង ចំនួន ៣៥ នាក់ ក្នុង នោះ ករណី នាំចូល ចំនួន ៧នាក់ និង ឆ្លង ក្នុង សហគមន៍ ២៨ នាក់ . អ្នកជំងឺ ចំនួន ៩៨ នាក់ ជាសះស្បើយ ។
សូម ជម្រាប ថា គិត ត្រឹម ការប្រកាស របស់ ក្រសួង សុខាភិបាល ថ្ងៃទី១ ខែកុម្ភៈ ឆ្នាំ ២០២២ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១២១. ៣៩០ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១១៧. ៦៣៣ នាក់ . ស្លាប់ សរុប ចំនួន ៣. ០១៥ នាក់ ៕ ជប៉ុន ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន សិក្សា បញ្ចៀស ទឹក ជំនន់ ស្ទឹង ព្រែក ត្នោត
លោក អ៊ាង សុផល្លែត ជំនួយការ ផ្ទាល់ របស់ សម្តេច តេជោ បាន ប្រាប់ អ្នក ព័ត៌មាន ថា ជា កិច្ច ឆ្លើយតប លើ សំណើ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ លោក សុខ ចិន្តា សោភា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា នាំ លោក Takahashi Fumaiki ជួប រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ស្ថាប័ន ពាក់ព័ន្ធ ដើម្បី បង្ហាញ គម្រោង សិក្សា ការបញ្ចៀស ទឹក ជំនន់ ស្ទឹង ព្រែក ត្នោត ។
សូម បញ្ជាក់ ថា ស្ទឹង ព្រែក ត្នោត ដែល ហួរ កាត់ ពី ជួរ ភ្នំ ឱរ៉ាល់ ក្នុង ខេត្ត កំពង់ស្ពឺ កាត់ តាម ខេត្ត កណ្តាល និង រាជធានី ភ្នំពេញ នោះ កាលពី ឆ្នាំ ២០២០ បាន បង្ក នូវ ការជន់ លិច ខ្លាំង ក្នុង រាជធានី ភ្នំពេញ ហើយ ឆ្នាំ ២០២១ ក៏ បាន ជន់ លិច ដែរ តែ មិន ធ្ងន់ធ្ងរ ដូច ឆ្នាំ ២០២០ នោះ ឡើយ ៕ សម្តេច តេជោ អនុញ្ញាតឱ្យ ប្រធាន សមាគម ជប៉ុន - កម្ពុជា ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ
ឯកឧត្តម បួន សារៈមុនី គោរព អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ត្រូវបាន ជ្រើសរើស ជា ជ័យលាភី ពានរង្វាន់ សន្តិភាព ស៊ុន ហាក់ ឆ្នាំ ២០២២
ការទទួល ពានរង្វាន់ សន្តិភាព ស៊ុន ហាក់ គឺជា មហា កិត្តិយស ដ៏ ធំធេង សម្រាប់ ប្រទេសជាតិ និង ប្រជាជន កម្ពុជា ទាំងមូល និង ស័ក្តិសម បំផុត ចំពោះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល ជា « បិតា ស្ថាបនិក សន្តិភាព » ដែល បាន ខិតខំ ប្រឹងប្រែង អស់ ពី កម្លាំង កាយ កម្លាំងចិត្ត និង បញ្ញា ញាណ ព្រមទាំង បាន ធ្វើ ពលិកម្ម គ្រប់ បែបយ៉ាង ក្នុង បេសកកម្ម ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន កម្ពុជា ។
ជាពិសេស ការដឹកនាំ បញ្ចប់ សង្គ្រាម បង្ហូរ ឈាម នៅ កម្ពុជា ធ្វើឱ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញលេញ . មាន ការបង្រួបបង្រួម ជាតិ និង ឯកភាព ទឹកដី ពេញលេញ . មាន ការធានា ឯករាជ្យ និង អធិបតេយ្យ ជាតិ . មាន ការលើកកម្ពស់ លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង នីតិរដ្ឋ ព្រមទាំង ធ្វើឱ្យ ប្រទេសជាតិ មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ និង មាន កិត្យានុភាព នៅលើ ឆាក អន្តរជាតិ ។
ក្នុង ឱកាស ដ៏ ប្រសើរ ថ្លៃថ្លា នេះ ខ្ញុំបាទ សូម លើកហត្ថ ប្រណម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ គុណ កែវ ទាំង បី ព្រមទាំង វត្ថុ ស័ក្តិសិទ្ធិ ក្នុង លោក សូម តាម ជួយ ថែរក្សា ការពារ និង ប្រោះ ព្រំប្រទាន ពរ ជ័យ បវរ សួស្តី ជ័យ មង្គល និង វិបុល សុខ គ្រប់ ប្រការ ជូន ចំពោះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ព្រមទាំង បុត្រា បុត្រី ចៅ ប្រុស ចៅ ស្រី ។
ឯកឧត្ដម កិត្តិបរិរក្ស បណ្ឌិត គាត ឈន់ គោរព អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ត្រូវបាន ជ្រើសរើស ជា ជ័យលាភី ពានរង្វាន់ សន្តិភាព ស៊ុន ហាក់ ឆ្នាំ ២០២២
