សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្តែង នូវ ការអបអរសាទរ ជូន ចំពោះ នាយ ឧត្តមសេនីយ៍ ណារ៉ុង ផាន់ ជិត កែវ ធែ ដែល ត្រូវបាន តែងតាំង ជា មេទ័ព ជើងគោក ថៃ ។ សម្តេច តេជោ ក៏ បាន សម្តែង នូវ ការពេញចិត្ត ចំពោះ ទំនាក់ទំនង រវាង កម្ពុជា និង ថៃ ។ សម្តេច តេជោ បាន មានប្រសាសន៍ ដោយ បង្ហាញ ការសង្កេត របស់ សម្តេច ថា ទំនាក់ទំនង រវាង កម្ពុជា និង ថៃ កាន់តែ ស៊ីជម្រៅ ឡើង និង មាន ជំនឿចិត្ត ទៅ វិញ ទៅ មក រវាង កងទ័ព នៃ ប្រទេស ទាំង ពីរ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន រំលឹក ទៅ មេទ័ព ជើងគោក ថៃ ដែរ ថា កងទ័ព គួរតែ ដើរតួ ជា អ្នកការទូត ដើម្បី រក្សា នូវ សន្តិភាព និង ស្ថេរភាព រវាង ប្រទេស និង ប្រទេស ។
លោក អ៊ាង សុផល្លែត បាន ដកស្រង់ ប្រសាសន៍ សម្តេច តេជោ មក បញ្ជាក់ ដូច្នេះ « សម្តេច តេជោ មានប្រសាសន៍ ថា កងទ័ព គម្បី ណា ដើរ តួនាទី ជា កងទ័ព ការទូត រក្សា សន្តិភាព ស្ថេរភាព បង្កើន ជំនឿ ទុកចិត្ត ដល់ ប្រជាជន នៅ តាម ព្រំដែន និង ជំនឿចិត្ត ប្រកបរបរ អាជីវកម្ម ជំរុញ ការអភិវឌ្ឍ នៅ តាម ព្រំដែន ។ ប្រែក្លាយ ព្រំដែន ឱ្យ ទៅជា តំបន់ ដែល មាន សន្តិភាព មិត្តភាព និង ការអភិវឌ្ឍ » ។
សូម បញ្ជាក់ ថា នៅក្នុង ជំនួប សម្តែង ការគួរសម នេះ អគ្គ មេបញ្ជាការ កងទ័ព ជើងគោក ថៃ បាន សម្តែង ការអបអរសាទរ ជូន សម្តេច តេជោ និង ប្រជាជន កម្ពុជា ដែល បាន ធ្វើជា ប្រធាន អាស៊ាន ។ លោក មេទ័ព ជើងគោក ថៃ ក៏ បាន សម្តែង នូវ ការគាំទ្រ ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ ទៅកាន់ ប្រទេស មីយ៉ាន់ម៉ា នា ពេល កន្លងទៅ ហើយ មាន ជំនឿ ជឿជាក់ ថា សម្តេច តេជោ នឹង នាំមក នូវ សាមគ្គីភាព និង វឌ្ឍនភាព របស់ អាស៊ាន នា ពេល ខាងមុខ ។
សម្តេច តេជោ ក៏ បាន ថ្លែងអំណរគុណ ជូន លោក មេទ័ព ជើងគោក ថៃ ដែល បាន គាំទ្រ កម្ពុជា ជា ប្រធាន អាស៊ាន និង គាំទ្រ ដំណើរទស្សនកិច្ច របស់ សម្តេច ទៅកាន់ ប្រទេស មីយ៉ាន់ម៉ា ដើម្បី ស្វែងរក ដំណោះស្រាយ បញ្ហា របស់ មីយ៉ាន់ម៉ា ។
ឆ្លៀត ក្នុង ឱកាស នោះ សម្តេច តេជោ បាន ថ្លែងអំណរគុណ រាជ រដ្ឋាភិបាល និង ប្រជាជន ថៃ ដែល កន្លងមក បាន ជួយ ដល់ ពលករ កម្ពុជា កំពុង រស់ នៅក្នុង ប្រទេស ថៃ និង បាន ថ្លែងអំណរគុណ រាជ រដ្ឋាភិបាល និង ប្រជាជន ថៃ ដែល បាន ជួយ ដល់ ប្រជាជន កម្ពុជា នៅ តាម ព្រំដែន ពេល មាន ជំងឺ បន្ទាន់ អាច ចូលទៅ ព្យាបាល ជំងឺ ក្នុង ប្រទេស ថៃ ។
នៅក្នុង ជំនួប សម្តែង ការគួរសម នៅ រសៀល ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បំពាក់ គ្រឿង ឥស្សរិយយស ថ្នាក់ មេដាយ សហមេត្រី ដែល ជា ការប្រោស ព្រះរាជ ទាន របស់ ព្រះមហាក្សត្រ ខ្មែរ ជូន នាយ ឧត្តមសេនីយ៍ ណារ៉ុង ផាន់ ជិត កែវ ធែ ផងដែរ ។
ក្នុង របាយការណ៍ ថ្ងៃព្រហស្បតិ៍ នេះ ដែរ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ២៩១ នាក់ បន្ថែម ទៀត ផងដែរ ។
ជែល លាង ដៃ ចំនួន ៧២៨ កេស ស្មើនឹង ១១. ៦៤៨ ដប ត្រូវបាន ប្រគល់ ជូន សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ពោធិ៍សាត់ ដើម្បី ចូលរួម ទទួលខុសត្រូវ ទប់ស្កាត់ ការចម្លង វីរុស កូវីដ១៩
ពិធី ប្រគល់ ទទួល ជែល ខាងលើ នេះ ធ្វើឡើង នៅ បរិវេណ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ពោធិ៍សាត់ ក្រោម អធិបតីភាព លោក វេជ្ជបណ្ឌិត អ៊ុយ សំអាត ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង គ្រោះមហន្តរាយ កាកបាទ ក្រហម កម្ពុជា និង លោក ជា វ តាយ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ពោធិ៍សាត់ ។
ក្មេងប្រុស ២នាក់ លង់ទឹក ស្លាប់ នៅ ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង
( ស្វាយរៀង ) ៖ ក្មេងប្រុស ២នាក់ ត្រូវ ជា បងប្អូន ជីដូនមួយ នឹង គ្នា ខណៈ ឪពុក ម្តាយ ទៅ ធ្វើការ រោងចក្រ ផ្ញើ ទុក នៅ ជាមួយ ជីដូន មើល ថែ ។ ពេល ជីដូនរវល់ ទៅ ទិញ ម្ហូប ក្មេង ទាំង ២ក៏ នាំគ្នា ចុះ លេង ទឹក ស្រះ ក្រោយ ផ្ទះ បណ្តាលឲ្យ លង់ទឹក ស្លាប់ ទាំង ២នាក់ គួរឲ្យ សង្វែក ។
ករណី ក្មេង លង់ទឹក ស្លាប់ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ៩៖១០នាទី ព្រឹក ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នៅ ភូមិ សង្គ្រោះ ឃុំ សុំបួរ ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង ។
សមត្ថកិច្ច នគរបាល ស្រុក ស្វាយទាប បាន ឲ្យដឹង ថា ក្មេងប្រុស ជនរងគ្រោះ រួម មាន៖
* ទី ១៖ មាន ឈ្មោះ រឿន ភក្ដ័ ត្រា ភេទ ប្រុស អាយុ ០៧ ឆ្នាំ ។ ឪពុក ឈ្មោះ ចាន់ ភក្តី មុខរបរ ធ្វើការ រោងចក្រ និង ប្រពន្ធ ឈ្មោះ នាង សំអូន មុខរបរ ធ្វើការ រោងចក្រ ។
* ទី ២៖ មាន ឈ្មោះ ហេង រដ្ឋា ភេទ ប្រុស អាយុ ០៦ ឆ្នាំ ។ ឪពុក ឈ្មោះ សរ សំណាង មុខរបរ ធ្វើការ រោងចក្រ និង ប្រពន្ធ ឈ្មោះ នាង សំអូន មុខរបរ ធ្វើការ រោងចក្រ ដែល មាន ទីលំនៅ រួមគ្នា ក្នុង ភូមិ សង្គ្រោះ ឃុំ សំបួរ ស្រុក ស្វាយទាប ខេត្ត ស្វាយរៀង ។
ក្រោយពី សមត្ថកិច្ច ទទួលបាន ព័ត៌មាន ខាងលើ នេះ ភ្លាម ក៏ បាន ចុះ មកដល់ កន្លែង កើត ហេតុ ជាមួយ អាជ្ញាធរដែនដី សមត្ថកិច្ច ជំនាញ និង គ្រូពេទ្យ ដើម្បី ពិនិត្យ សាកសព ។ សមត្ថកិច្ច និង គ្រូពេទ្យ ពិនិត្យ ឃើញ ថា សាកសព ក្មេងប្រុស ទាំង ២នាក់ ពិតជា ស្លាប់ ដោយសារ លង់ទឹក ពិតប្រាកដ មែន និង ប្រគល់ សាកសព ទៅ ក្រុមគ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ៕
ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែកុម្ភៈ៖ បង្ក្រាប ១៦ករណី ឃាត់ខ្លួន ៥៨ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៦ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី និង ជួញដូរ ១៣ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៥៨ នាក់ ។
( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្អង់ ខ្ពស់ បាន យាង ដល់ ទីក្រុង ប៉េកាំង ប្រទេស ចិន ដើម្បី យាង ចូលរួម បើក ព្រឹត្តិការណ៍ កីឡា អូឡាំពិក រដូវ រងា នៅ ថ្ងៃស្អែក ។
ការយាង ដល់ ទីក្រុង ប៉េកាំង របស់ ព្រះករុណា ជា ម្ចាស់ ជីវិត តម្កល់ លើ ត្បូង ត្រូវបាន ថ្វាយ ព្រះរាជ វឌ្ឍនកិច្ច និង ទទួល ព្រះរាជ ដំណើរ យ៉ាង កក់ក្តៅ ពី មន្ត្រី ជាន់ ខ្ពស់ ចិន ។ ព្រះវត្តមាន របស់ ព្រះអង្គ ត្រូវបាន ផ្សព្វផ្សាយ ដោយ ព័ត៌មាន CGTN របស់ ចិន ផងដែរ ។
សូម បញ្ជាក់ ថា ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី បាន យាង ចាកចេញ ពី កម្ពុជា នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី០៣ ខែកុម្ភៈ នេះ ។ ព្រះអង្គ នឹង គង់ ប្រថាប់ នៅ ទីក្រុង ប៉េកាំង រហូតដល់ ថ្ងៃទី ០៥ ខែកុម្ភៈ ទើប យាង ត្រឡប់ មកកាន់ កម្ពុជា វិញ ។
លោក Zhao Lijian បាន គូសបញ្ជាក់ ថា « ព្រះករុណា ព្រះមហាក្សត្រ គឺជា មិត្ត ចាស់ របស់ ប្រជាជន ចិន ។ យើងខ្ញុំ សូមស្វាគមន៍ យ៉ាង កក់ក្ដៅ ចំពោះ ព្រះអង្គ ដែល នឹង ស្ដេច យាង មកកាន់ ប្រទេស ចិន ដើម្បី យាង ជា សក្ខីជន ក្នុង ឱកាស ជា ប្រវត្តិសាស្ត្រ ដែល រដ្ឋធានី ប៉េកាំង នឹង ក្លាយជា ទីក្រុង លើក ដំបូង ក្នុង ការរៀបចំ កីឡា អូឡាំពិក រដូវ រងា » ។
សូម រម្លឹក ថា លោកយាយ សន តេង វ័យ ៧៣ ឆ្នាំ ទៅ ហើយ ប៉ុន្តែ ព្រោះតែ ជីវភាព ខ្វះខាត លោក បាន ខំប្រឹង ដើរ ចម្ងាយ ផ្លូវ ក្នុង ១ ថ្ងៃ ៗ មិន ក្រោម ១០គីឡូម៉ែត្រ ឡើយ ដើម្បី រើស អត ចាយ រក ប្រាក់ ចិញ្ចឹម ជីវិត ទាំង ជរា មាន ជម្ងឺ ជាប់ ខ្លួន ហើយ លោកយាយ បាន ប្រកប របរ នេះ រយៈពេល ជាង ៣០ ឆ្នាំ កន្លងមក ហើយ ។
លោកយាយ បាន ប្រាប់ បន្ត ទៀត ថា ប៉ុន្តែ ផ្ទះ ដែល រស់ នៅ សព្វ ថ្ងៃ នេះ ធំ គួរសម ដែរ ដែល ផ្ទះ នេះ ត្រូវបាន បងប្អូន សាងសង់ ឲ្យ លោកយាយ និង ស្វាមី រស់ នៅ ជា ថ្នូរ និង ដី មួយ កន្លែង នៅឯ ស្រុក កំណើត ។ លុះ ក្រោយមក លោក តា ក៏ ស្លាប់ បាត់ ហើយ កូនស្រី ក៏ មាន ជម្ងឺ លោកយាយ ក៏ បាន ខ្ចី លុយ ចង ការគេ ដើម្បី យកមក ព្យាបាល ជម្ងឺ កូនស្រី ។
ក្រោយមក ទៀត ដោយ គ្មាន ប្រាក់ បង់ ការគេ ធ្វើឲ្យ លុយ ជំពាក់ កាន់តែ កើនឡើង រហូត ត្រូវ គេ រឹបអូស យក ផ្ទះ បាត់ ទៅ ហើយ ដូច្នេះ ទើប ធ្វើឲ្យ លោកយាយ ជួប ការលំបាក ខ្លាំង ។ ពេលនេះ លោកយាយ សូម អរគុណ ខ្លាំង ណាស់ ចំពោះ លោក ឡា លីន និង ភរិយា ដែល បាន ជួយ ឧបត្ថម្ភ ក្នុង ពេល ដែល លោកយាយ កំពុង ជួប ការលំបាក ខ្វះខាត នេះ ៕ ផ្ទះ ប្រជាពលរដ្ឋ ២៣ ខ្នង ក្នុង ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ រង ការខូចខាត ដោយសារ ខ្យល់ កន្ត្រាក់
( បន្ទាយមានជ័យ )៖ មាន ភ្លៀង កក់ខែ មួយ មេ យ៉ាង ធំ លាយឡំ ទៅ ដោយ ខ្យល់ កន្ត្រាក់ បាន បក់ បោក មក ចំ២ភូមិ ក្នុង ស្រុក ម៉ាឡៃ បណ្តាលឲ្យ ផ្ទះ ប្រជាពលរដ្ឋ
ចំនួន ២៣ ខ្នង រង ការខូចខាត ក្នុង នោះ ធ្ងន់ ចំនួន ៨ខ្នង អស់ ទាំងស្រុង ក្នុង ភូមិ ចំនួន ២ ក្នុង ឃុំ ទួល ពង្រ ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ នៅ វេលា ម៉ោង ៦យប់ ថ្ងៃទី ០២ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
លោក បាន បញ្ជាក់ ទៀត ថា នៅ ថ្ងៃទី ៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ ដោយ ទទួលបាន ការណែនាំ របស់ លោក ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ លោក បាន ចាត់តាំង កម្លាំង អន្តរាគមន៍ របស់ វរៈ ចំនួន ២០ នាក់ ដឹកនាំ ដោយ លោក វរសេនីយ៍ ទោ មាស ម៉េង ហួង មេបញ្ជាការ រង វរសេនា តូច ការពារ ព្រំដែន គោក លេខ ៨១៥ សហការ ជាមួយ កម្លាំង នៃ អធិការដ្ឋាន នគរបាល ស្រុក ម៉ាឡៃ ចុះ ជួយ រៀបចំ និង ប្រមូល ស័ង្កសី ឈើ ដែល ហើរ ប៉ើង តាម ខ្យល់ ជូន ប្រជាពលរដ្ឋ និង ជួល ជុល ផ្ទះ ជូន គាត់ វិញ ផងដែរ ៕
លោក ពូទីន ប្រធានាធិបតី រុស្ស៊ី ផ្តល់ បទសម្ភាសន៍ ពិសេស ជាមួយ អគ្គ នាយក នៃ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន
ខ្ញុំ ជឿជាក់ ថា ការត្រៀម រៀបចំ ដោយ មាន គុណភាព ខ្ពស់ សម្រាប់ ការប្រកួត កីឡា អូឡាំពិក នឹង មាន ផលប្រយោជន៍ ដល់ អត្តពលិក ដើម្បីឱ្យ ពួកគេ បង្ហាញ សមត្ថភាព យ៉ាង ពេញលេញ ហើយ សម្រេច គោលដៅ តាម ការកំណត់ ។ ការរៀបចំ ព្រឹត្តិការណ៍ ប្រកួត កីឡា យ៉ាង ឱឡារិក ជួយ បង្កើន ការយល់ដឹង ពី គ្នា ទៅ វិញ ទៅ មក កាន់តែ ស៊ីជម្រៅ ហើយ ជំរុញ គោលការណ៍ « ប្រកួតប្រជែង ដោយ យុត្តិធម៌ » ដែល គេ ទទួលស្គាល់ ជាទូទៅ ។
យើង ប្រឆាំង ចំពោះ ទង្វើ ដែល ធ្វើឱ្យ កីឡា ទៅជា រឿង នយោបាយ ប្រឆាំង ចាត់ទុក កីឡា ជា ឧបករណ៍ សម្រាប់ ការដាក់ សម្ពាធ ការប្រកួតប្រជែង ដោយ អយុត្តិធម៌ និង រើសអើង ។ ខ្ញុំ ជឿជាក់ ថា ទីក្រុង ប៉េកាំង មុខ ជា នឹង រៀបចំ ការប្រកួត កីឡា អូឡាំពិក រដូវ រងា ឱ្យ ឈានដល់ កម្រិត ខ្ពស់ បំផុត ជា មិន ខាន ។ ទំនាក់ទំនង ភាពជាដៃគូ រវាង រុស្ស៊ី និង ប្រទេស ចិន មាន លក្ខណៈ នឹង នរ ហើយ បង្កើត លើ មូលដ្ឋាន ដែល គោរព គ្នា និង គិត ពិចារណា ផលប្រយោជន៍ ជាក់ស្តែង របស់ ខ្លួន ហើយ គោរព ច្បាប់ អន្តរជាតិ និង « ធម្មនុញ្ញ អង្គការ សហ ប្រជាជាតិ » ។
គំនិត ដែល យើង បាន កំណត់ ក្នុង « សន្ធិសញ្ញ សុខដុមរមនា រវាង រុស្ស៊ី និង ប្រទេស ចិន » ធ្វើឱ្យ ទំនាក់ទំនងជា ដៃគូរ វាង ប្រទេស ទាំង២ បាន ឡើង ដល់ កម្រិត ខ្ពស់ ដែល មិន ធ្លាប់ មាន ពីមុន មក ៕
សម្តេច តេជោ ហ៊ុន សែន អនុញ្ញាតឱ្យ មេទ័ព ជើងគោក ថៃ ចូល ជួប សម្តែង ការគួរសម
មុន ចាប់ផ្តើម កិច្ចពិភាក្សា សម្តេច តេជោ បាន បំពាក់ គ្រឿង ឥស្សរិយយស មេដាយ សហមេត្រី ជូន លោក ណារ៉ុង ផាន់ ជិត កែវ ធែ ផងដែរ ។
សូម បញ្ជាក់ ថា នាយ ឧត្តមសេនីយ៍ ណារ៉ុង ផាន់ ជិត កែវ ធែ បាន ដឹកនាំ គណៈប្រតិភូ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា នៅ ថ្ងៃទី ០៣ ខែកុម្ភៈ នេះ លោក បាន ចូល ជួប ពិភាក្សា ការងារ ជាមួយ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ ហើយក៏ បាន ចូល ជួប ពិភាក្ស ការងារ ជាមួយ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក ផងដែរ ៕
លោក គង់ វិបុល បាន លើកឡើង ថា ថ្មី ៗ នេះ ខ្ញុំ យល់ ថា រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន បញ្ជាក់ ច្រើន ហើយ ដោយ ពន្យល់ ច្បាស់ ពី ទិដ្ឋភាព បង្កើន ចំណូល . ការពារ សន្ដិសុខ ជាតិ និង បញ្ហា សង្គម ផ្សេង ៗ ទៀត ។
បន្ថែម ពី នោះ ទៀត លោក គង់ វិបុល បាន បញ្ជាក់ ថា នៅ ប្រទេស មួយចំនួន នៅក្នុង អាស៊ាន មាន យុទ្ធនាការ គ្រប់គ្រង ដូចគ្នា ហើយ គោលដៅ របស់ គេ មិន មែន បិទ សិទ្ធិ សេរីភាព ទេ ។ ប៉ុន្តែ ក្នុង ការពង្រឹង អភិបាលកិច្ច ល្អ សម្រាប់ ប្រទេស មិន មែន សម្រាប់ យកមក បិទ សិទ្ធិ សេរីភាព នោះ ទេ ។ ហើយ សព្វ ថ្ងៃ នៅ កម្ពុជា មាន ច្រើន ណាស់ ដែល មិន ចុះបញ្ជី ហើយ លក់ តាម អនឡាញ និង ជិះ សុទ្ធតែ ឡាន ទំនើប ។
លោក ង៉ែត ពិទូ បាន សម្តែង នូវ សុទិដ្ឋិនិយម ចំពោះ កំណើន ភ្ញៀវ ទេសចរ ដែល មាន ការហក់ ឡើង គួរឲ្យ កត់សម្គាល់ បើ ទោះបី ចំនួន ហក់ ឡើង មិន ច្រើន តាម ការរំពឹងទុក តែ នេះ គឺជា សញ្ញា ល្អ បង្ហាញ ថា ខេត្ត រតនគិរី ចាប់ផ្តើម មាន ភ្ញៀវ ទេសចរ មក លេង កម្សាន្ត វិញ ហើយ បន្ទាប់ពី រាជ រដ្ឋាភិបាល បើក ប្រទេស ឡើងវិញ ក្រោយ វិបត្តិ កូវីដ - ១៩ រយៈពេល ជិត ២ឆ្នាំ ។
ដោយឡែក ក្នុង រយៈពេល ៣ ថ្ងៃ នេះ គ្រប់ រមណីយដ្ឋាន ដែល ភ្ញៀវ បាន ទៅ លេង កម្សាន្ត សង្កេតឃើញ ថា ភ្ញៀវ ទេសចរ ទាំងអស់ បាន ចូលរួម ថែរក្សា អនាម័យ បរិស្ថាន បាន ល្អ ពោលគឺ ក្រោយ ហូបចុក រួច ពួកគាត់ បាន វេចខ្ចប់ សំរាម ទុកដាក់ បាន ត្រឹមត្រូវ និង សូម ថ្លែងអំណរគុណ ចំពោះ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ដែល បាន មក លេង កម្សាន្ត ក្នុង ទឹកដី ខេត្ត រតនគិរី ។
អរគុណ ម្ចាស់ ផ្ទះសំណាក់ សណ្ឋាគារ និង ម្ចាស់ សេវាកម្ម ម្ហូប អាហារ ទាំងអស់ ដែល នៅតែ បន្ត ការរឹតបន្តឹង វិធានការ អនាម័យ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដើម្បី បង្ការ កុំ ឲ្យ មាន ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ ។ អរគុណ ផងដែរ ចំពោះ សមត្ថកិច្ច ពាក់ព័ន្ធ ដែល បាន បំពេញ តួនាទី ភារកិច្ច ចូលរួម ថែរក្សា ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ទាំង យប់ ទាំង ថ្ងៃ ជូន ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ បាន យ៉ាង ល្អ ប្រសើរ ។
ចំណែកឯ លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន ស្នងការ នគរបាល ខេត្ត រតនគិរី បញ្ជាក់ ឲ្យដឹង ថា ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ចិន - វៀតណាម ទូទាំង ខេត្ត គ្មាន បញ្ហា អ្វី កើតឡើង នោះ ទេ គឺ កម្លាំង សហការ ជាមួយ សមត្ថកិច្ច ពាក់ព័ន្ធ ផ្សេង ទៀត រៀបចំ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សុវត្ថិភាព ជូន ពួកគាត់ មក កម្សាន្ត ប្រកបដោយ សេចក្តីសប្បាយរីករាយ ៕
គ.ជ. ប ជូនដំណឹង ស្តីពី ការដាក់ និង ការទទួល ពាក្យ សុំ ចុះបញ្ជី បេក្ខជន នៃ គណបក្ស នយោបាយ សម្រាប់ ឈរឈ្មោះ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥
សូម អាន សេចក្ដីជូនដំណឹង ខាងក្រោម៖ កាកបាទ ក្រហម កម្ពុជា ជួប សំណេះសំណាល ជាមួយ ក្រុម និសិ្សត ជ័យលាភី អាហារូបករណ៍ រដ្ឋាភិបាល អូស្ត្រាលី
( ភ្នំពេញ ) ៖ កាកបាទ ក្រហម កម្ពុជា ជួប សំណេះសំណាល ជាមួយ ក្រុម និសិ្សត ជ័យលាភី អាហារូបករណ៍ រដ្ឋាភិបាល អូស្ត្រាលី ចំនួន ២០ នាក់ ក្រោម អធិបតីភាព លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា ដែល ប្រារព្ធ ធ្វើឡើង នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា កាលពី ដើម សប្តាហ៍ នេះ ។
ក្នុង ឱកាស នោះ ដែរ លោកស្រី អគ្គ លេខាធិការ បាន ពាំនាំ ប្រសាសន៍ ផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង បង្ហាញ ពី សាវតា ខ្លះ ៗ នៃ ការកកើតឡើង របស់ កាកបាទ ក្រហម កម្ពុជា ផងដែរ ។
ជាមួយគ្នា នោះ លោកស្រី នួន មករា តំណាង បេក្ខជន ជ័យលាភី អាហារូកណ៍ រដ្ឋាភិបាល អូស្ត្រាលី សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល តែងតែ យកចិត្តទុកដាក់ និង ជួយ ជ្រោមជ្រែង លើកទឹកចិត្ត ដល់ ក្រុម និស្សិត កន្លងមក ។
លោកស្រី បាន បន្ត ថា សម្រាប់ សមាជិក នៃ បេក្ខជន ទាំង ២០ នាក់ នេះ គឺជា មន្ត្រីរាជការ ៧នាក់ មន្ត្រី អង្គការ ក្រៅ រដ្ឋ ភិបាល ៣នាក់ និង បុគ្គលិក ក្រុមហ៊ុន ឯកជន ១០នាក់ ហើយ សមាជិក ៥នាក់ នឹង ត្រៀម ចេញ ដំណើរ ទៅ បន្ត ការសិក្សា ដើម ខែកុម្ភៈ នេះ និង សមាជិក ដទៃ ទៀត ត្រៀម ចេញ ដំណើរ នៅក្នុង ខែមិថុនា ឆ្នាំ ២០២២ នេះ ដែរ ។
ចាប់តាំងពី ឆ្នាំ ១៩៩៤ មក និសិ្សត អាហារូបករណ៍ រដ្ឋាភិបាល អូស្ត្រាលី មាន ប្រមាណ ជាង ៩០០ នាក់ ដែល បាន សិក្សា ថ្នាក់ ក្រោយ ឧត្តម សិក្សា នៅ ប្រទេស អូស្ត្រាលី ហើយនិស្សិត ជ័យលាភី នីមួយ ៗ បាន វិលត្រឡប់ មកកាន់ មាតុភូមិ វិញ ជាមួយ គំនិត និង ចំណេះដឹង ថ្មី ៗ និង សមត្ថភាព ដែល ជាដើមទុន សំខាន់ ៗ ក្នុង ការចូលរួម ចំណែក ដឹកនាំ វិស័យ របស់ ពួកគេ និង អភិវឌ្ឍ ប្រទេសជាតិ ។
លោកស្រី បន្ត ថា សម្រាប់ ការសិក្សា ឆ្នាំ ២០២១ មាន និស្សិត ចំនួន ២៥ នាក់ និង ឆ្នាំ ២០២២ នេះ មាន និស្សិត ចំនួន ៥៤ នាក់ ត្រូវ ជ្រើសរើស តាមរយៈ ការវាយតម្លៃ ដ៏ ក្រិត ក្រម ពី ក្រុម គណៈកម្មាធិការ របស់ កម្មវិធី អាហារូបករណ៍ ។
ទន្ទឹម នឹង នោះ លោកស្រី និង ក្រុម និស្សិត បាន គោរព ថ្លែងអំណរគុណ ដល់ លោកស្រី អគ្គ លេខាធិការ . អគ្គ លេខាធិការ រង ទី១ និង សហការី កាកបាទ ក្រហម កម្ពុជា ដែល បាន ផ្តល់ បទពិសោធន៍ និង បង្ហាញ សកម្មភាព មនុស្សធម៌ ល្អ ៗ ដែល ធ្វើឱ្យ ក្រុម និស្សិត ទទួលបាន ចំណេះដឹង ជាច្រើន និង យល់ កាន់តែ ច្បាស់ អំពី សកម្មភាព មនុស្សធម៌ ដែល មាន លក្ខន្តិកៈ វិធាន នៃ នីតិក្រម បទបញ្ញត្តិ ហិរញ្ញវត្ថុ ត្រឹមត្រូវ និង មាន យុទ្ធសាស្ត្រ ដែល មាន រយៈពេល ១០ឆ្នាំ សម្រាប់ អនុវត្ត ការងារ ជួយ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ និង ងាយ រងគ្រោះ បំផុត ៕
បទ វិភាគ អន្តរជាតិ៖ ការប្រកួត កីឡា អូឡាំពិក រដូវ រងា ក្រុង ប៉េកាំង នឹង ជា ការប្រកួត កីឡា ប្រកបដោយ សុវត្ថិភាព មួយ លើក
ប៉ុន្តែ ប្រព័ន្ធ សារព័ត៌មាន លោក ខាងលិច មួយចំនួន តូច បាន មួល បង្កាច់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ភាគី ចិន ថា « ម៉ឺងម៉ាត់ ខ្លាំង ពេក » និង « ទម្លាយ ព័ត៌មាន របស់ បុគ្គល » ជាដើម ដើម្បី លាប ព័ណ៌ លើ វិធានការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ របស់ ភាគី ចិន ក៏ ដូចជា បំផ្លិចបំផ្លាញ បរិយាកាស នៃ ការប្រកួត កីឡា អូឡាំពិក រដូវ រងា ផងដែរ ។ តើ ការពិត គឺ អ្វី ? អត្តពលិក និង ភាគី នានា ពាក់ព័ន្ធ ដែល ចូលរួម ការប្រកួត កីឡា អូឡាំពិក រដូវ រងា មាន ការវិនិច្ឆ័យ ដ៏ ត្រឹមត្រូវ របស់ ខ្លួន ។
គួរ បញ្ជាក់ ផងដែរ ថា កត្តា វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា បាន ផ្តល់ ជំនួយ ដ៏ សំខាន់ ដល់ ប្រទេស ចិន ក្នុង ការរៀបចំ ការប្រកួត កីឡា អូឡាំពិក ប្រកបដោយ សុវត្ថិភាព ។ ដូចជា ក្នុង « ភោជនីយដ្ឋាន វៃ ឆ្លាត » មួយ នៃ មជ្ឈមណ្ឌល ប្រព័ន្ធ សារព័ត៌មាន សំខាន់ នៃ ការប្រកួត កីឡា អូឡាំពិក រដូវ រងា ក្រុង ប៉េកាំង មនុស្ស យន្ត ធ្វើ ម្ហូប នៅ ពីក្រោយ អេក្រង់ កញ្ចក់ រួច បញ្ជូន ម្ហូប ទៅដល់ មុខ អ្នក ហៅ ម្ហូប តាមរយៈ ប្រព័ន្ធ បញ្ជូន ម្ហូប ពី ជាន់ លើ នៃ ភោជនីយដ្ឋាន ដើម្បី កាត់បន្ថយ ការទាក់ទង រវាង មនុស្ស និង មនុស្ស ។
ក្នុង មួយ រយៈពេល ខាងមុខ ទៀត ក្រុង ប៉េកាំង មិន ត្រឹមតែ នឹង បង្ហាញ នូវ ការប្រកួត កីឡា អូឡាំពិក រដូវ រងា ប្រកបដោយ ភាព សាមញ្ញ សុវត្ថិភាព និង ភាពអស្ចារ្យ ជូន ចំពោះ ទូទាំង ពិភពលោក ប៉ុណ្ណោះ ទេ ជាង ទៅ ទៀត ប្រទេស ចិន ក៏ នឹង បង្ហាញ ពី តម្រិះ បញ្ញា និង កម្លាំង កាយ ចិត្ត របស់ ខ្លួន ក្នុង ការយកឈ្នះ លើ ជំងឺ កូវីដ១៩ ដើម្បី បំពេញ បន្ថែម នូវ ទំនុកចិត្ត និង ក្តីសង្ឃឹម កាន់តែ ច្រើន ឡើង ៗ ដល់ ពិភពលោក ក្នុង បរិបទ ជំងឺ កូវីដ១៩ ៕
