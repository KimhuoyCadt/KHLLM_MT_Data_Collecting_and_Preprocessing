( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ចេញ សេចក្តីណែនាំ ស្តីពី ការអនុវត្ត កាតព្វកិច្ច សារពើពន្ធ ចំពោះ គម្រោង សកម្មភាព នានា ស្ថិត នៅក្រោម ក្របខ័ណ្ឌ នៃ កិច្ចព្រមព្រៀង ជំនួយ ឥត សំណង កិច្ចព្រមព្រៀង កម្ចី ហិរញ្ញប្បទាន ឬ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ។ នេះ បើ តាម សេចក្តីណែនាំ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី១ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ៕
សូម អាន សេចក្តីណែនាំ ដូច ខាងក្រោម៖ ក្រសួង ធនធាន ទឹក ជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា ចាប់ពី ថ្ងៃទី ២ - ៨ ខែកុម្ភៈ ឆ្នាំ ២០២២ . អាច មាន ភ្លៀង ធ្លាក់ ពី កម្រិត ពី ខ្សោយ ទៅ មធ្យម
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ថ្ងៃទី១ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា ចាប់ពី ថ្ងៃទី ២ - ៨ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២២ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៤.៣៥៣ . ៦២១ នាក់ ។ ក្នុង រួម មាន៖
ខាងក្រោម នេះ ជា ប្រភេទ មីស៊ីល ដែល កូរ៉េ ខាងជើង បាន ធ្វើតេស្ដ ជា បន្តបន្ទាប់ នៅក្នុង ខែមករា នេះ៖
* មីស៊ីល គ្រូស រយៈ ចម្ងាយ ឆ្ងាយ
មន្ត្រី និង កម្លាំង សណ្ដាប់ធ្នាប់ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ ទាំងអស់ ទទួល ថវិកា លើកទឹកចិត្ត ពី អភិបាល ខណ្ឌ
( ភ្នំពេញ ) ៖ មន្ត្រី និង កងកម្លាំង សណ្ដាប់ធ្នាប់ នៃ រដ្ឋបាល ខណ្ឌ ឫស្សីកែវ ទាំងអស់ ដោយ មាន ការចូលរួម ពី លោក ស៊ូ សោគ ន្ធ អភិបាល រង ខណ្ឌ នៅ ថ្ងៃ ៣១ ខែមករា ឆ្នាំ ២០២២ នេះ បាន ទទួល ថវិកា លើកទឹកចិត្ត ពី លោក ឯក ឃុន ដឿន អភិបាល ខណ្ឌ ក្នុង ការខិតខំ ប្រឹងប្រែង បំពេញ ភារកិច្ច បាន ល្អ ប្រសើរ ទាំង ការផ្ដល់ សេវា និង ការថែរក្សា សន្តិសុខ ជូន ប្រជាពលរដ្ឋ ។
( យេរូសាឡឹម ) ៖ ក្រសួង សុខាភិបាល អ៊ីស្រាអែល បាន និយាយ នៅ ថ្ងៃចន្ទ នេះ មាន ករណី ថ្មី ចំនួន ៧៤. ៣១២ ករណី នៃ ជំងឺ កូវីដ១៩ ត្រូវបាន រាយការណ៍ នៅ ថ្ងៃ នេះ ដែល នាំឱ្យ ចំនួន ករណី សរុប នៅក្នុង ប្រទេស កើនឡើង ដល់ ២. ៨៥៨. ៩៩៥ ករណី ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃវន្ទ ទី៣១ ខែមករា ឆ្នាំ ២០២២ ។
ក្នុង ថ្ងៃ ចន្ទ នេះ ដែរ ក្រសួង សុខាភិបាល អ៊ីស្រាអែល ក៏ បាន រកឃើញ អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ ដ៏ កាច សាហាវ នេះ ចំនួន ១៩ នាក់ ទៀត ផងដែរ ដែល នាំឲ្យ ចំនួន អ្នកស្លាប់ សរុប កើន ដល់ ៨. ៧២៤ នាក់ ៕
ការទទួលបាន ពានរង្វាន់ សន្តិភាព ដ៏ ឧត្តុង្គឧត្តម ខាងលើ នេះ គឺ ពិតជា ស័ក្តិសម នឹង កិត្តិនាម ដ៏ ថ្លៃថ្លា វិសេសវិសាល របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក្នុង បេសកកម្ម រំដោះ ជាតិ មាតុភូមិ កសាង និង ថែរក្សា សន្តិភាព ព្រមទាំង ដឹកនាំ អភិវឌ្ឍ ប្រទេសជាតិ ឲ្យបាន រីកចម្រើន រុងរឿង តាំងពី ដើម រហូតដល់ ពេល បច្ចុប្បន្ន ។
សមិទ្ធផល សន្តិភាព នៃ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ពិសេស នយោបាយ ឈ្នះ - ឈ្នះ គឺជា សក្ខីកម្ម មួយ ដែល បង្ហាញ ទៅកាន់ ពិភពលោក ទាំងមូល ឲ្យ ឃើញ ច្បាស់ ថា សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ជា មេដឹកនាំ ដ៏ វិសេសវិសាល និង ជា មគ្គុទេសក៍ ឯក នៃ សន្តិភាព សម្រាប់ ប្រទេស កម្ពុជា និង ជា គំរូ សម្រាប់ តំបន់ និង ពិភពលោក ។
ឯកឧត្ដម ស៊ុយ សែម គោរព អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ត្រូវបាន ជ្រើសរើស ជា ជ័យលាភី ពានរង្វាន់ សន្តិភាព ស៊ុន ហាក់ ឆ្នាំ ២០២២
អង្គភាព ប្រឆាំង អំពើពុករលួយ ទទួលបាន ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ពី មន្ត្រីរាជការ ជាង ១ម៉ឺន ច្បាប់ រួចរាល់ ហើយ
អង្គភាព ប្រឆាំង អំពើពុករលួយ បាន ឱ្យដឹង ថា ការប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ដែល ធ្វើឡើង ពីរ ឆ្នាំ ម្តង នេះ ត្រូវបាន ធ្វើឡើង ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ៣១ ខែមករា ។ ក្នុង នោះ ក្រុមការងារ នៃ នាយកដ្ឋាន ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល បាន ចាំ ទទួល ឯកសារ ប្រកាស រៀងរាល់ ថ្ងៃ ដោយ មិន ឈប់ សម្រាក ថ្ងៃសៅរ៍ អាទិត្យ ឬ ថ្ងៃ បុណ្យ ឡើយ ។
មាត្រា ១៨ បាន ចែង ថា មន្ត្រី ដែល បាន កំណត់ ដូច ខាងលើ នេះ ត្រូវ ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល របស់ ខ្លួន រៀងរាល់ ពីរ ឆ្នាំ ម្តង នៅ ដើម ខែមករា ហើយ មិន ឱ្យ ហួស ពី ថ្ងៃទី ៣១ ខែមករា ឡើយ ៕
កម្ពុជា - ជប៉ុន នឹង រៀបចំ ធ្វើជា សួន មិត្តភាព នៃ ប្រទេស ទាំង ពីរ ឱ្យ សាធារណជន លេង កម្សាន្ត នៅ រាជធានី ភ្នំពេញ
សម្តេច តេជោ ហ៊ុន សែន បាន ស្វាគមន៍ និង គាំទ្រ ឱ្យ មាន ការរៀបចំ សួន សាធារណៈ នេះ ដោយ ដាក់ ឈ្មោះ ថា សួន មិត្តភាព កម្ពុជា - ជប៉ុន ។ សម្តេច តេជោ ក៏ បាន ណែនាំ លោក សុខ ចិន្តា សោភា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ជជែក និង ធ្វើការ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ ។
មន្រ្តី ជំនាញ កសិកម្ម និង ទូត អាល្លឺម៉ង់ ប្រចាំ កម្ពុជា ជំរុញ ឱ្យ កសិករ ពង្រឹង បច្ចេកទេស ដាំ ស្វាយ ដើម្បី នាំចេញ ទៅ អឺរ៉ុប (Video inside) ( កំពង់ស្ពឺ ) ៖ មន្រ្តី ជំនាញ កសិកម្ម និង ទូត អាល្លឺម៉ង់ និង ក្រុមហ៊ុន នាំចេញ ស្វាយ បាន ជំរុញ ឱ្យ កសិករ ត្រូវ ធ្វើ ទំនើបកម្ម លើ បច្ចេកទេស ដាំ ស្វាយ ឱ្យ ស្រប តាម ស្តង់ដារ និង គុណភាព ជាពិសេស បង្កើន ការដាំ ស្វាយ ខុស រដូវ ដើម្បី បង្កើន ការនាំឱ្យ ចេញ ឱ្យ បាន គ្រប់ រដូវកាល និង បង្កើន តម្លៃ បន្ថែម ក៏ ដូចជា ឈាន ទៅ នាំចេញ ទៅ ទីផ្សារ អឺរ៉ុប ។
មន្រ្តី និង ទូត អាល្លឺម៉ង់ និង ក្រុមហ៊ុន នាំចេញ ស្វាយ ជំរុញ បែប នេះ ធ្វើឡើង ក្នុង ដំណើរទស្សនកិច្ច នៅ ចម្ការស្វាយ រិច ហ្វាម ជម្ជូ ព្រឹក្ស ក្នុង ស្រុក ឧត្តុង ខេត្ត កំពង់ស្ពឺ កាលពី ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២២ ដោយ មាន ការចូលរួម ពី អគ្គ រដ្ឋទូត អាល្លឺម៉ង់ ប្រចាំ នៅ កម្ពុជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន កសិកម្ម និង កសិករ ដាំ ស្វាយ មកពី ៥ ខេត្ត ក្នុង ប្រទេស កម្ពុជា ។
