( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៤៤ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែកុម្ភៈ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៤៤ នាក់ នោះ មាន ១៦នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១១ករណី និង ជនសង្ស័យ ២៨ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១២ករណី ។
ថ្ងៃ នេះ ជា ខួប លើក ទី៤៣ ឆ្នាំ នៃ ការជួបជុំគ្នា ឡើងវិញ រវាង សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត . សម្តេច តេជោ រៀបរាប់ រឿងរ៉ាវ ក្រោយ ការជួបជុំ ភរិយា និង កូនប្រុស ហ៊ុន ម៉ាណែត
សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហោះ ខ្លឹមសារ ទាំងស្រុង យ៉ាង ដូច្នេះ ថា៖
ខ្ញុំ បក ស្ករគ្រាប់ ប្រគល់អោយ ម៉ាណែត តែ កូន រុញ ដៃ ខ្ញុំ ចេញ ដល់ ពេល ខ្ញុំ ហូប ស្ករគ្រាប់ ទើប ម៉ាណែត ដឹង ថា ជា របស់ សម្រាប់ ញាំ ម្តង នេះ ម៉ាណែត ញាំ ស្ករគ្រាប់ ទាំង សំបក រហូត ភរិយា ខ្ញុំ ឃើញ ក៏ បក សំបក ស្ករគ្រាប់ អោយ តែ គាត់ អោយ ញាំតែ ២គ្រាប់ ប៉ុណ្ណោះ ព្រោះ ខ្លាច កូន ក្តៅ ខ្លួន ។ នេះ ហើយ ជា រសជាតិ នៃ កុមារ ជំនាន់ ប៉ុល ពត ដែល មិន ដែល បាន របស់ ហូប ឬ សម្ភារៈ នៃ ល្បែង លេង សម្រាប់ កុមារ ។
សូម បញ្ជាក់ ជូន ថា ខ្ញុំ និង ភរិយា ចិញ្ចឹម កូន ចំនួន ៥នាក់ មិន ដែល មាន មេដោះ ទេ គ្រប់ យ៉ាង យើង ត្រូវ ធ្វើ ខ្លួន ឯង ដើម្បី កូន ។ ដោយសារ រឿង កូនប្រុស ក្រោម ពន្លឺ ព្រះច័ន្ទ ពេញ បូរណមី កំពុង ត្រូវបាន ថត ខ្ញុំ សង្ឃឹម ថា វគ្គ នេះ អាច បង្កើត បានជា ឈុត ឆាក មួយចំនួន ផងដែរ ៕ កុំ ឲ្យ ថ្ងៃ សប្បាយ ក្លាយជា ទុក្ខ ដោយសារ ការបើកបរ របស់ អ្នក ! ស្លាប់ ២នាក់ និង របួស ៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៣ ខែកុម្ភៈ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៦លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ស្រាល ៥នាក់ ។
ឧត្តមសេនីយ ឯក ម៉ៅ សុផាន់ ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ ឯក ម៉ៅ សុផាន់ មេបញ្ជាការ កងពល តូច លេខ ៧០ និង មេបញ្ជាការង នាយ ទាហាន នាយ ទាហាន រង ព្រមទាំង ពល ទាហាន ទាំងអស់ នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារលិខិត មួយ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ ដែល បាន ទទួល អនិច្ចកម្ម នា វេលា ម៉ោង ១០:៤៥ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ក្នុង ជន្មាយុ ៧៩ ឆ្នាំ ដោយ រោគា ពាធ ។
លោក ឧត្តមសេនីយ ឯក ម៉ៅ សុផាន់ បាន សម្តែង ការសោកស្តាយ រក អ្វី មក ប្រៀបផ្ទឹម ពុំ បាន ដោយ ទទួល ដំណឹង អំពី មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សារឿន ។
ក្នុង ឱកាស ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ លោក ឧត្តមសេនីយ ឯក ម៉ៅ សុផាន់ សូម ចូលរួម ចែករំលែក នូវ មរណទុក្ខ ដោយ ក្តីស្រណោះ និង ការអាឡោះអាល័យ ជាមួយ លោកស្រី សុខ លាង និង បុត្រា បុត្រី ព្រមទាំង បងប្អូន កូនក្មួយ ទាំងអស់ នៃ សព ដោយ សេចក្តីសង្វេគ ជា ទីបំផុត ។
លោក ឧត្តមសេនីយ ឯក ម៉ៅ សុផាន់ សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន បាន ឆាប់ ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ស្អែក នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នឹង ធ្វើ សន្និសីទ ព័ត៌មាន ពី « វឌ្ឍនភាព មូលដ្ឋាន ឃុំ សង្កាត់ និង ទិសដៅ ការងារ បន្ត របស់ ខេត្ត មណ្ឌលគិរី »
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ រសសៀល ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ ស្អែក នេះ នឹង រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « វឌ្ឍនភាព មូលដ្ឋាន ឃុំ សង្កាត់ និង ទិសដៅ ការងារ បន្ត របស់ ខេត្ត មណ្ឌលគិរី » ។
លោកស្រី កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ នាយ ឧត្តមសេនីយ៍ សុខ សខឿន រដ្ឋលេខាធិការ ក្រសួង ការពា ជាតិ
( ភ្នំពេញ ) ៖ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ឃួន សុដារី អនុប្រធាន ទី២ នៃ រដ្ឋសភា បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សាខឿន រដ្ឋលេខាធិការ ក្រសួង ការពា ជាតិ ដែល បាន ទទួល អនិច្ចកម្ម នា វេលា ម៉ោង ១០:៤៥ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភះ ឆ្នាំ ២០២២ ក្នុង ជន្មាយុ ៧៩ ឆ្នាំ ដោយ រោគា ពាធ ។
ជាមួយនឹង ការសម្តែង ការសោកស្តាយ រក អ្វី មក ប្រៀបផ្ទឹម ពុំ បាន ដោយ ទទួល ដំណឹង អំពី មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សខឿន លោកស្រី កិត្តិសង្គហ បណ្ឌិត បាន លើកឡើង ថា មរណភាព របស់ ឯកឧត្តម គឺជា ការបាត់បង់ ស្វាមី បិតា ជីតា ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជា ការបាត់បង់ នូវ មិត្ត រួម អាវុធ តស៊ូ រំដោះ ជាតិ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង បាន រួម សុខ រួម ទុក្ខ ជាមួយគ្នា ក្នុង ការបំរើ ជាតិ និង ប្រជាជន កម្ពុជា រហូតដល់ ថ្ងៃ អវសាន នៃ ជីវិត ។
ក្នុង ឱកាស ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ សូម ចូលរួម ចែករំលែក នូវ មរណទុក្ខ ដោយ ក្តីស្រណោះ និង ការអាឡោះអាល័យ ជាមួយ លោកស្រី សុខ លាង និង បុត្រា បុត្រី ព្រមទាំង បងប្អូន កូនក្មួយ ទាំងអស់ នៃ សព ដោយ សេចក្តីសង្វេគ ជា ទីបំផុត ។ សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ នាយ ឧត្តមសេនីយ៍ សុខ សារ ឌឺន បាន ឆាប់ ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
អតីត អ្នកគាំទ្រ អតីត គណបក្ស សង្គ្រោះ ជាតិ ក្នុង ខេត្ត កំពង់ចាម ១១៣ នាក់ ទៀត ស្ម័គ្រចិត្ត រួមរស់ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា
( កំពង់ចាម ) ៖ ប្រជាពលរដ្ឋ ដែល ជា អតីត អ្នកគាំទ្រ អតីត គណបក្ស សង្គ្រោះ ជាតិ នៅក្នុង ខេត្ត កំពង់ចាម ប្រមាណ ១១៣ នាក់ ទៀត បាន ផ្លាស់ ចិត្ត ចូលរួម រស់ និង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា វិញ បន្ទាប់ពី ពួកគេ បាន ពិចារណា និង មើលឃើញ ច្បាស់ នូវ គុណ តម្លៃ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន ។
នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ លោក ផេង គីម ស្រ៊ុន អនុប្រធាន ក្រុមការងារ លោក លី សាម៉េត ទីប្រឹក្សា សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា រួម ជាមួយ ក្រុមការងារ បាន រៀបចំ កិច្ច សំណេះសំណាល មួយ ជាមួយ ប្រជាពលរដ្ឋ ដែល ប្រែចិត្ត មក គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ទាំង ១១៣ នាក់ នោះ ។
ក្នុង ឱកាស នោះ លោក ផេង គីម ស្រ៊ុន បាន សម្តែង នូវ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ ប្រជាពលរដ្ឋ ទាំង ១១៣ នាក់ ។ លោក ផេង គីម ស្រ៊ុន បាន ថ្លែង ថា ការសម្រេចចិត្ត របស់ ប្រជាពលរដ្ឋ ទាំង ១១៣ នាក់ គឺជា ការសម្រេចចិត្ត មួយ ប្រកបដោយ ភាពត្រឹមត្រូវ ។ ត្រឹមត្រូវ ត្រង់ ថា ការគាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា គឺជា ការគាំទ្រ នូវ តម្លៃ សុខ សន្តិភាព ស្ថេរភាព សង្គម និង ការអភិវឌ្ឍ ដែល ជា តម្រូវការ ដ៏ ចាំបាច់ របស់ ប្រជាពលរដ្ឋ គ្រប់ រូប ។
លោក ផេង គីម ស្រ៊ុន បាន ឆ្លៀត គូស រំលេច នូវ គុណ តម្លៃ ជាច្រើន របស់ គណបក្ស ប្រជាជន កម្ពុជា ក្នុង បុព្វហេតុ ជាតិ និង ប្រជាជន ។ លោក បាន អះអាង ថា គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន តែងតែ តម្កល់ ប្រយោជន៍ ជាតិ និង ប្រជាជនជា ធំ ហើយ បាន ដាក់ចេញ គោល នយោបាយ ចម្បង គឺ ដើម្បី ជាតិ និង ប្រជាជន ។
បន្ទាប់ពី សំណេះសំណាល លោក ផេង គីម ស្រ៊ុន ដែល អម ដំណេីរ ដោយ លោក កែវ ផុង និង លោក គង់ លីវ៉ា បាន ពាំនាំ នូវ អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា តាមរយៈ លោក លី សាម៉េត ហៅ គ្រូមា ចែកជូន អតីត សកម្មជន និង អ្នកគាំទ្រ អតីត គណបក្ស សង្គ្រោះ ជាតិ ទាំង ១១៣ នាក់ នោះ ផងដែរ ៕ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារលិខិត មួយ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ ដែល បាន ទទួល អនិច្ចកម្ម នា វេលា ម៉ោង ១០៖៤៥ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ក្នុង ជន្មាយុ ៧៩ ឆ្នាំ ដោយ រោគា ពាធ ។
តាមរយៈ សារលិខិត មួយ ផ្ញើ ទៅកាន់ លោកស្រី សុខ លាង ដែល ជា ភរិយា របស់ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន . សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន សម្តែង ការសោកស្តាយ រក អ្វី មក ប្រៀបផ្ទឹម ពុំ បាន ដោយ ទទួល ដំណឹង អំពី មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សារឿន ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន លើកឡើង ថា មរណភាព របស់ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សុខ សារឿន គឺជា ការបាត់បង់ ស្វាមី បិតា ជីតា ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជា ការបាត់បង់ អ្នកតស៊ូ រំដោះ ជាតិ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត និង បាន ចូលរួម បំរើ ជាតិ និង ប្រជាជន កម្ពុជា រហូតដល់ ថ្ងៃ អវសាន នៃ ជីវិត ។
ក្នុង ឱកាស ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ចូលរួម ចែករំលែក នូវ មរណទុក្ខ ដោយ ក្តីស្រណោះ និង ការអាឡោះអាល័យ ជាមួយ លោកស្រី សុខ លាង និង បុត្រា បុត្រី ព្រមទាំង បងប្អូន កូនក្មួយ ទាំងអស់ នៃ សព ដោយ សេចក្តីសង្វេគ ជា ទីបំផុត ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន បាន ឆាប់ ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
កូរ៉េ ខាងត្បូង អនុម័ត ឲ្យ ប្រើប្រាស់ វ៉ាក់សាំង កូវីដ១៩ លើ កុមារ អាយុ ពី ៥ដល់ ១១ឆ្នាំ ជា លើក ដំបូង ខណៈ ដែល អូមី ក្រុង កំពុង វាយប្រហារ ខ្លាំង
( សេអ៊ូល ) ៖ ទីភ្នាក់ងារ សុវត្ថិភាព ឱសថ របស់ ប្រទេស កូរ៉េ ខាងត្បូង នៅ ថ្ងៃពុធ នេះ បាន អនុញ្ញាតឱ្យ ប្រើប្រាស់ វ៉ាក់សាំង កូវីដ១៩ សម្រាប់ កុមារ អាយុ ពី៥ ដល់ ១១ឆ្នាំ ជា លើក ដំបូង ចំពេល មាន ការរីករាលដាល យ៉ាង ឆាប់រហ័ស នៃ វីរុស អូមី ក្រុង ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន ស៊ី ហួរ នៅ ថ្ងៃពុធ ទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
ក្រសួង បាន និយាយ ថា ការអនុញ្ញាត នេះ គឺ មាន គោលបំណង ជួយ បង្ការ ការឆ្លង និង ការសម្រាក នៅ មន្ទីរពេទ្យ របស់ កុមារ ចំពេល មាន ការរីករាលដាល នៃ វីរុស Omicron ដែល កំពុង វាយលុក ខ្លាំង ។
ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៣ ខែកុម្ភៈ៖ បង្ក្រាប ១៩ករណី ឃាត់ខ្លួន ៣៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៩ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី . ដឹកជញ្ជូន រក្សាទុក ៣ករណី . ជួញដូរ ១៣ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៣៦ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៩២០ ករណី ឃាត់ មនុស្ស ២១១៥ នាក់ ( ស្រី ១៧២ នាក់ )៕
ចំណេះដឹង ទូទៅ៖ ប្រទេស ណា ដែល មាន កងទ័ព ច្រើន ជាង គេ បង្អស់ ?
ក្រៅពី ទាហាន សកម្ម ជាង ២លាន នាក់ នេះ ប្រទេស ចិន ក៏ មាន ទាហានបម្រុង ជាង កន្លះ លាន នាក់ ទៀត និង ទាហាន ជាប់ កាតព្វកិច្ច យោធា កន្លះ លាន នាក់ ទៀត ផងដែរ ។
កងទ័ព រំដោះ ប្រជាជន ចិន ចែកចេញ ជា ៥ ប្រភេទ រួម មាន៖ កងទ័ព ជើងគោក កងទ័ព ជើងទឹក កងទ័ព អាកាស កងទ័ព គ្រាប់ រ៉ុក្កែត ( មុន ឆ្នាំ ២០១៦ មាន ឈ្មោះ ដើម ថា កងទ័ព កាំភ្លើង ធំ ) និង កងទ័ព ជំនួយ យុទ្ធសាស្ត្រ ។ កងទ័ព រំដោះ ប្រជាជន ចិន នេះ ទៀតសោត ក៏ ចែកចេញ ជា ៥ភូមិភាគ គឺ ភូមិភាគ ខាងលិច ភូមិភាគ ខាងកើត ភូមិភាគ ខាងជើង ភូមិភាគ ខាងត្បូង និង ភូមិភាគ កណ្ដាល ។
បន្ទាប់ពី ប្រទេស ចិន គឺ ប្រទេស ឥណ្ឌា ដែល មាន កងទ័ព សកម្ម ចំនួន ១. ៣៩លាន នាក់ គឺ ប្រហាក់ប្រហែល នឹង កងទ័ព សហរដ្ឋ អាមេរិក ដែល មាន ចំនួន ១. ៣៤លាន នាក់ ។ រីឯ ប្រទេស កូរ៉េ ខាងជើង វិញ គឺ មាន កងទ័ព ចំនួន ១. ២៨លាន នាក់ ៕
ចៅក្រម ស៉ើប សួរ សុង ប៊ុណ្ណា រិទ្ធិ សម្រេច ដោះលែង បុរស ម្នាក់ ក្នុង សំណុំរឿង រំលោភ កុមារី
( ភ្នំពេញ ) ៖ លោក សុង ប៊ុណ្ណា រិទ្ធិ ចៅក្រម ស៉ើប សួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ ត្រូវ គេ រាយការណ៍ ថា បាន សម្រេច ដោះលែង ជន ត្រូវ ចោទ ម្នាក់ ពាក់ព័ន្ធ ករណី រំលោភ សេពសន្ថវៈ ។ ការដោះលែង បាន ធ្វើឡើង កាលពី រសៀល ថ្ងៃទី ២២ ខែកុម្ភៈ ឆ្នាំ ២០២២ ម្សិលមិញ ។
លោក សុង ប៊ុណ្ណា រិទ្ធិ បាន សម្រេច ដាក់ ជន ត្រូវ ចោទ ឈ្មោះ ជា សុជាតិ ហៅ សុខុម អាយុ ៦៧ ឆ្នាំ ឱ្យ នៅក្រោម ការត្រួតពិនិត្យ តាម ផ្លូវ តុលាការ ( មិន ឃុំ ខ្លួន បណ្ដោះអាសន្ន ) បន្ទាប់ពី លោក ព្រះរាជអាជ្ញា រង ម៉ុត ដារ៉ា ជា តំណាង អយ្យការ បាន បើក ការស៉ើប សួរ និង សម្រេច ចោទប្រកាន់ លើ ជនល្មើស ពី បទ រំលោភ សេពសន្ថវៈ ប្រព្រឹត កាលពី អំឡុង ខែមករា ឆ្នាំ ២០២០ នៅ ចំណុច ភូមិ ព្រៃ ខ្លា ឃុំ កុមារា ជា ស្រុក បាទី ខេត្ត តាកែវ យោង តាម មាត្រា ២៣៩ នៃ ក្រម ព្រហ្មទណ្ឌ ។
ជុំវិញ ការដោះលែង ជន ត្រូវ ចោទ ឈ្មោះ ជា សុជាតិ ហៅ សុខុម ត្រូវបាន លោក ព្រះរាជអាជ្ញា រង ប្លង់ សុផល អ្នកនាំពាក្យ នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ប្រាប់ អ្នកសារព័ត៌មាន ថា លោក មិន ទាន់ ទទួលបាន ព័ត៌មាន ស្តីពី ការប្ដឹង ឧទ្ធរណ៍ ពីសំណាក់ តំណាង អយ្យការ កាន់ សំណុំរឿង លើ សេចក្តីសម្រេច របស់ ចៅក្រម ស៉ើប សួរ នៅឡើយ ទេ ។
គួរ រំលឹក ថា ជន ត្រូវ ចោទ ឈ្មោះ ជា សុជាតិ ហៅ សុខុម ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ឃាត់ខ្លួន បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ១៩ ខែកុម្ភៈ ឆ្នាំ ២០២២ ពាក់ព័ន្ធ បទល្មើស ខាងលើ ដោយ យោង តាម ពាក្យបណ្ដឹង របស់ ជនរងគ្រោះ ៕
សម្តេច តេជោ ហ៊ុន សែន ថ្លែង បែប នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២២ របស់ ក្រសួង មហាផ្ទៃ នៅ រសៀល ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ផ្តាំ ដល់ អ្នកដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ជំនាន់ ក្រោយ មិន ឲ្យ យក ពន្ធ ដី កសិកម្ម ពី កសិករ នោះ ដែរ ។ សម្តេច ថ្លែង បែប កំប្លែង ថា បើ មាន មេដឹកនាំ ជំនាន់ ក្រោយ របស់ គណបក្ស ប្រជាជន ណា ហ៊ាន យក ពន្ធ ដី កសិកម្ម ពី កសិករ វិញ្ញាណ សម្តេច នឹង ដាក់ បណ្តាសារ ។
សម្តេច តេជោ ហ៊ុន សែន មានប្រសាសន៍ បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « គណបក្ស ប្រជាជន កម្ពុជា ដឹកនាំ តាំងពី ឆ្នាំ ១៩៧៩ ហើយ បើ គណបក្ស ប្រជាជន កម្ពុជា បន្ត ដឹកនាំ តទៅទៀត ពន្ធ ដី ស្រែ ពន្ធ ដី ចម្ការ ពន្ធ ដី កសិកម្ម របស់ ប្រជាពលរដ្ឋ ក៏ នៅតែ មិន យក ។ បើសិន មេដឹកនាំ ជំនាន់ ក្រោយ យក ពន្ធ ដី ស្រែ បើ វិញ្ញាណ ខ្ញុំ ដឹង ខ្ញុំ នឹង ដាក់ បណ្តាសារ ។ ព្រោះ នេះ ជា នយោបាយ របស់ ខ្ញុំ តាំងពីដើម មក ដែល ខ្ញុំ មិន យក ពន្ធ ដី ស្រែ ពី កសិករ ទេ ខ្ញុំ មិន យក ពន្ធ ដី កសិកម្ម ពី កសិករ ទេ » ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការយក ពន្ធ ពី ដី កសិកម្ម មិន អាច ធ្វើឱ្យ រដ្ឋ ក្លាយជា អ្នក មាន ទេ ដូច្នេះ សូម ទុក ឱ្យ កសិករ ក្លាយជា អ្នក មាន ទៅ ចុះ ។ សម្តេច តេជោ បាន រំលឹក រឿង ភូមិ តិរច្ឆាន នៅ ខេត្ត កំពង់ឆ្នាំង ដែល ពលរដ្ឋ ខ្មែរ បះបោរ សម្លាប់ បារាំង ដោយសារតែ ការយក ពន្ធ លើ ដី ស្រែ ។
ទោះបីជា យ៉ាង នេះ ក្តី សម្តេច តេជោ ហ៊ុន សែន បាន ស្នើ ឱ្យ រួមគ្នា គាំទ្រ ដល់ អ្នក ប្រមូល ចំណូល ជូន រដ្ឋ ដូចជា អង្គភាព គយ និង ពន្ធដារ ជាដើម ។ ក្នុង នោះ ដែរ សម្តេច ប្រកាស ឈប់ អត់ ឱនការយក ពន្ធ សម្រាប់ អ្នកជិះ រថយន្ត គេច ពន្ធ ដែល ជ្រក ក្រោម ស្លាកលេខ រដ្ឋ ជាដើម ៕
លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ
( ភ្នំពេញ ) ៖ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារលិខិត មួយ ចូលរួម រំលែក ទុក្ខ ចំពោះ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពា ជាតិ ដែល បាន ទទួល អនិច្ចកម្ម នា វេលា ម៉ោង ១០:៤៥ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភៈ នេះ ក្នុង ជន្មាយុ ៧៩ ឆ្នាំ ដោយ រោគា ពាធ ។
លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន សម្តែង ការសោកស្តាយ រក អ្វី មក ប្រៀបផ្ទឹម ពុំ បាន ដោយ ទទួល ដំណឹង អំពី មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សារឿន ។
ក្នុង ឱកាស ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ នាយ ឧត្តមសេនីយ៍ សូម ចូលរួម ចែករំលែក នូវ មរណទុក្ខ ដោយ ក្តីស្រណោះ និង ការអាឡោះអាល័យ ជាមួយ លោកស្រី សុខ លាង និង បុត្រា បុត្រី ព្រមទាំង បងប្អូន កូនក្មួយ ទាំងអស់ នៃ សព ដោយ សេចក្តីសង្វេគ ជា ទីបំផុត ។
សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន បាន ឆាប់ ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ដឹកនាំ គណៈប្រតិភូ ក្រសួង ចូលរួម ក្នុង កិច្ចប្រជុំ សំខាន់២ របស់ គណៈកម្មការ សេដ្ឋកិច្ច សហ ប្រជាជាតិ សម្រាប់ អឺរ៉ុប
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ដ្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ថ្ងៃទី ២២ ខែកុម្ភះ ឆ្នាំ ២០២២ នេះ បាន ដឹកនាំ គណៈប្រតិភូ ក្រសួង ចូលរួម ក្នុង កិច្ចប្រជុំ ខួប លើក ទី ៧៥ នៃ គណៈកម្មាធិការ ដឹកជញ្ជូន និង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ដឹកជញ្ជូន លើក ទី ៨៤ នៃ គណៈកម្មាធិការ ដឹកជញ្ជូន (ITC) របស់ គណៈកម្មការ សេដ្ឋកិច្ច សហ ប្រជាជាតិ សម្រាប់ អឺរ៉ុប (ECE) ក្រោម ប្រធានបទ៖ ការតភ្ជាប់ និង ការជំរុញ ការតភ្ជាប់ ការដឹកជញ្ជូន ប្រកបដោយ ចីរភាព ។
កិច្ចប្រជុំ នេះ ធ្វើឡើង រយៈពេល ៤ ថ្ងៃ តាម ប្រព័ន្ធ វីដេអូ ពី ចម្ងាយ ចាប់ពី ថ្ងៃទី ២២ ដល់ ២៥ ខែកុម្ភះ ឆ្នាំ ២០២២ ដោយ មាន ការចូលរួម ពី រដ្ឋមន្ត្រី ដឹកជញ្ជូន នៃ រដ្ឋ ជា សមាជិក តំណាង អន្តរ រដ្ឋាភិបាល តំណាង អង្គការ អន្តរជាតិ វិស័យ ឯកជន និង ភាគី ពាក់ព័ន្ធ ផងដែរ ។
ថ្លែង នា ឱកាស នោះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ក៏ បាន គូសបញ្ជាក់ ពី តួនាទី យ៉ាង សំខាន់ នៃ ការតភ្ជាប់ ការដឹកជញ្ជូន ដើម្បី អភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម របស់ ប្រទេស ផ្តល់ ឱកាស សម្រាប់ ការងារ ការបើក ទីផ្សារ ការផ្គត់ផ្គង់ ធ្វើ ពាណិជ្ជកម្ម ក្នុង ស្រុក និង អន្តរជាតិ និង លើកកម្ពស់ ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន កាន់តែ ស៊ីជម្រៅ នៅ ជុំវិញ ពិភពលោក ។
លោក ទេសរដ្ឋមន្ត្រី បាន សម្តែង ជំនឿ យ៉ាង មុតមាំ ថា ការវិនិយោគ លើ ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន មាន សារសំខាន់ មិន ត្រឹមតែ តាម ទស្សនៈ សេដ្ឋកិច្ច ប៉ុណ្ណោះ ទេ ប៉ុន្តែ វា ថែមទាំង មាន សារសំខាន់ ក្នុង ការជួយ ជំរុញ ដល់ ការដឹកជញ្ជូន សាធារណៈ ការតភ្ជាប់ ពី តំបន់ មួយ ទៅ តំបន់ មួយ ដើម្បី ផ្គត់ផ្គង់ និង ចែកចាយ ទំនិញ ឱ្យ កាន់តែ ប្រសើរ និង បាន ស្នើ ឱ្យ ដៃគូ អភិវឌ្ឍន៍ ចូលរួម ជាមួយ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន កម្ពុជា ឱ្យ កាន់តែ មាន ការរីកចម្រើន ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន លើកឡើង អំពី ការចូលរួម របស់ កម្ពុជា ជាមួយ កិច្ចព្រមព្រៀង សម្របសម្រួល ការដឹកជញ្ជូន ឆ្លង ព្រំដែន (CBTA) ដើម្បី ធានា ឱ្យ មាន លំហូរ ដោយ រលូន នៃ ទំនិញ សេវាកម្ម និង អ្នកដំណើរ ឆ្លងកាត់ ព្រំដែន ជួយ សម្រួល ដល់ ពាណិជ្ជកម្ម និង លើកកម្ពស់ សមត្ថភាព ប្រកួត ប្រជែង របស់ ប្រទេស ផងដែរ ៕
ការអំពាវនាវ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្ដេច តេជោ ហ៊ុន សែន អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប ការងារ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២២ របស់ ក្រសួង មហាផ្ទៃ នា រសៀល ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « សូម អំពាវនាវ ឲ្យ គ្រប់ ក្រុមហ៊ុន ទាំងអស់ បំពេញ កាតព្វកិច្ច ពន្ធដារ កុំ ឲ្យ ជំពាក់ ។ ខ្ញុំ ឃើញ ថា តួលេខ បំណុល មួយចំនួន ដែល ក្រុមហ៊ុន បាន ជំពាក់ ចំពោះ រដ្ឋ ក៏ នៅសល់ ច្រើន » ។
សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា តួលេខ បំណុល ដែល ក្រុមហ៊ុន បាន ជំពាក់ ចំពោះ រាជ រដ្ឋាភិបាល ឃើញ ថា នៅសល់ ចំនួន ច្រើន ដូច្នេះ ក្រុមហ៊ុន ទាំងអស់ សូម មេត្ដា ប្រញាប់ប្រញាល់ មក បង់ ពន្ធ ។
សូម បញ្ជាក់ ថា ក្នុង ខែមករា ឆ្នាំ ២០២២ ចំណូល ពន្ធ ដែល អគ្គ នាយកដ្ឋាន ពន្ធដារ ប្រមូល បាន មាន ២៨៨.២៣ លាន ដុល្លារ បើ ប្រៀបធៀប នឹង ខែមករា ឆ្នាំ ២០២១ ឃើញ ថា កើនឡើង ប្រមាណ ជា ៧១. ០៣ លាន ដុល្លារ ស្មើនឹង ៣២. ៧០% ។
បើ តាម អគ្គ នាយកដ្ឋាន ពន្ធដារ ក្នុង ខែមករា ឆ្នាំ ២០២២ ចំណូល ពី ប្រភេទ ពន្ធ សំខាន់ ៗ ៥ ប្រភេទ មាន កំណើន ឡើង គួរឲ្យ កត់សម្គាល់ ធៀប នឹង ខែមករា ឆ្នាំ ២០២១ ក្នុង នោះ៖
សម្ដេច ប្រមុខ នៃ រាជ រដ្ឋាភិបាល បាន គូសបញ្ជាក់ ថា នៅពេល រាជ រដ្ឋាភិបាល ផ្ទេរ ការងារ ពី ថ្នាក់ ជាតិ ទៅកាន់ ថ្នាក់ ក្រោម ជាតិ នោះ កិច្ចការ នៅ ថ្នាក់ ក្រោម ជាតិ កាន់តែ មាន ច្រើន ជាង មុន ដូច្នេះហើយ បានជា គណៈ អចិន្ដ្រៃយ៍ ប្រគល់ ភារកិច្ច ជូន សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ ដើម្បី ធ្វើ វិសោធនកម្ម ច្បាប់ ទាក់ទង ជាមួយនឹង ការបង្កើន ចំនួន កៅអី សម្រាប់ គណៈ អភិបាល រាជធានី - ខេត្ត ក្រុង ស្រុក ខណ្ឌ ។
ក្នុង ន័យ នេះ សម្ដេច បាន សង្កត់ធ្ងន់ ថា ខេត្ត ក្រុង ស្រុក ខណ្ឌ ណា ដែល មាន ខ្មែរ ឥស្លាម រស់ នៅ ច្រើន គម្បី មាន អភិបាល រង ម្នាក់ នៅក្នុង នោះ ។ ការធ្វើ បែប នេះ ដើម្បី ងាយស្រួល ដល់ ទំនាក់ទំនង បែប សហគមន៍ និង ជា ផ្នែក មួយ នៃ សុខដុមនីយ ក្នុង ចំណោម ជាតិ សាសន៍ របស់ កម្ពុជា ។
បើ តាម ប្រសាសន៍ របស់ សម្ដេច តេជោ ហ៊ុន សែន ខេត្ត ដែល មាន បងប្អូន ខ្មែរ ឥស្លាម ច្រើន មាន មិន ច្រើន ទេ ក្នុង នោះ មាន ខេត្ត កំពង់ចាម ក្រចេះ កំពង់ធំ ពោធិ៍សាត់ កំពត និង រាជធានី ភ្នំពេញ ជាដើម ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន សង្កត់ធ្ងន់ ថា កាល ដែល សម្ដេច ណែនាំឲ្យ ធ្វើ បែប នេះ ដើម្បី ងាយស្រួល ដល់ ការបំពេញ កិច្ចការងារ ផ្សេង ៗ ពិសេស នៅ តំបន់ ដែល មាន ខ្មែរ ឥស្លាម រស់ នៅ ច្រើន ក្នុង ករណី មាន បញ្ហា អ្វី កើតឡើង អ្នក ដែល ដើរតួ សំខាន់ ក្នុង ការសម្របសម្រួល គឺ ថ្នាក់ដឹកនាំ ជា ខ្មែរ ឥស្លាម ផ្ទាល់ តែម្ដង ដែល ត្រូវ ចេញ មុខ មុន គេ ដើម្បី ដោះស្រាយ ៕
នាយ ឧត្តមសេនីយ៍ ហ៊ុយ ពិសិដ្ឋ . នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព របស់ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ហ៊ុយ ពិសិដ្ឋ . នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង ព្រមទាំង មេបញ្ជាការ មេបញ្ជាការ រង នាយ - ពល ទាហាន ក្នុង បញ្ជាការដ្ឋាន អង្គរក្ស ទាំងមូល នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារលិខិត មួយ ចូលរួម រំលែក ទុក្ខ ចំពោះ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពា ជាតិ ដែល បាន ទទួល អនិច្ចកម្ម នា វេលា ម៉ោង ១០:៤៥ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភះ នេះ ក្នុង ជន្មាយុ ៧៩ ឆ្នាំ ដោយ រោគា ពាធ ។
នាយ ឧត្តមសេនីយ៍ ហ៊ុយ ពិសិដ្ឋ . នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង បាន សម្តែង ការសោកស្តាយ រក អ្វី មក ប្រៀបផ្ទឹម ពុំ បាន ដោយ ទទួល ដំណឹង អំពី មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សារឿន ។
នាយ ឧត្តមសេនីយ៍ ហ៊ុយ ពិសិដ្ឋ . នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន បាន ឆាប់ ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ជុំវិញ បញ្ហា សាច់ ជ្រូក ឡើង ថ្លៃ និង ការរៀបចំ យន្តការដាក់ ដេញថ្លៃ នាំចូល ជ្រូក រស់ មក ផ្គត់ផ្គង់ តម្រូវការ ក្នុង ស្រុក . សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា សម្តេច បាន ចារ ឲ្យ ក្រសួង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ធ្វើ ការងារ នេះ ឲ្យបាន ឆាប់ ដើម្បី ជួយ ដល់ អ្នក ចិញ្ចឹម ផង និង ជួយ ដល់ អ្នក ហូប ផងដែរ ទប់ស្កាត់ អតិផរណា ។
សម្តេច តេជោ ហ៊ុន សែន រិះគន់ ថា រដ្ឋមន្រ្តី វេង សាខុន ក្រសួង សេដ្ឋកិច្ច បាន អញ្ជើញ ទៅ ប្រជុំ ក៏ មិន ព្រម ទៅ ប្រជុំ ដោះស្រាយ ដែរ ។ សម្តេច តេជោ ហ៊ុន សែន ចោទ សួរ រដ្ឋមន្រ្តី កសិកម្ម វេង សាខុន ថា « លោក ឯង ដោះស្រាយ យ៉ាងម៉េច បានជា ធ្វើឱ្យ សាច់ ជ្រូក ឡើង ថ្លៃ ? »!
សម្តេច តេជោ ហ៊ុន សែន រិះគន់ ថា របៀប ធ្វើការ របស់ រដ្ឋមន្រ្តី វេង សាខុន ជា របៀប « ជិះ សេះ មើល ផ្កា » ហើយ សម្តេច តឹង ទ្រូង ណាស់ ជាមួយនឹង ការងារ រដ្ឋមន្រ្តី វេង សាខុន នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ពាក់ព័ន្ធ បញ្ហា សាច់ ជ្រូក នេះ មិន អាច ធ្វើ តម្រូវតែ ចិត្ត អ្នក ចិញ្ចឹម តែ ប៉ុន្មាន នាក់ នោះ ទេ គឺ ត្រូវ គ្រប់គ្រង អតិផរណា តម្លៃ លើ ទីផ្សារ ផងដែរ ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ចាយ សាំង យុន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ក្រុមគ្រួសារ នៅ ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ បាន ផ្ញើ សារលិខិត មួយ ចូលរួម រំលែក ទុក្ខ ចំពោះ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន រដ្ឋលេខាធិការ ក្រសួង ការពា ជាតិ ដែល បាន ទទួល អនិច្ចកម្ម នា វេលា ម៉ោង ១០:៤៥ នាទី ព្រឹក ថ្ងៃទី ២៣ ខែកុម្ភះ នេះ ក្នុង ជន្មាយុ ៧៩ ឆ្នាំ ដោយ រោគា ពាធ ។
នាយ ឧត្តមសេនីយ៍ ចាយ សាំង យុន បាន សម្តែង ការសោកស្តាយ រក អ្វី មក ប្រៀបផ្ទឹម ពុំ បាន ដោយ ទទួល ដំណឹង អំពី មរណភាព នាយ ឧត្តមសេនីយ៍ សុខ សារឿន ។
នាយ ឧត្តមសេនីយ៍ ចាយ សាំង យុន សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ នាយ ឧត្តមសេនីយ៍ សុខ សារឿន បាន ឆាប់ ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
អគ្គិសនី កម្ពុជា ជូនដំណឹង ពី ការរអាក់រអួល ចរន្ត នៅ ថ្ងៃ នេះ ដល់ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២២ ដើម្បី រុះរើ គន្លង ខ្សែ បណ្តាញ ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ ដល់ ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២២ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
សូម អាន សេចក្តីជូនដំណឹង របស់ អគ្គិសនី កម្ពុជា ដូច ខាងក្រោម៖ ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ស្វាគមន៍ និង ពិភាក្សា ការងារ ជាមួយ នាយក រដ្ឋមន្ត្រី ម៉ាឡេស៊ី នៅ វិមាន សន្តិភាព
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា អញ្ជើញ ទទួលស្វាគមន៍ ជា ផ្លូវការ នៃ ដំណើរ បំពេញ ទស្សនកិច្ច របស់ លោក អ៉ីស្មា អែល សាប្រ៊ី ប៊ីន យ៉ាកុប នាយក រដ្ឋមន្ត្រី ម៉ាឡេស៊ី ព្រមទាំង ជួបពិភាក្សា ការងារ ។
ពិធី ទទួលស្វាគមន៍ និង ពិភាក្សា ការងារ នេះ នឹង ធ្វើឡើង នី វិមាន សន្តិភាព ។ បន្ទាប់ពី ជំនួប ពិភាក្សា សម្តេច តេជោ ហ៊ុន សែន និង លោក នាយក រដ្ឋមន្ត្រី ម៉ាឡេស៊ី នឹង មាន ធ្វើ សន្និសីទ ព័ត៌មាន រួមគ្នា ផងដែរ ។
បើ តាម ក្រសួង ការបរទេស កម្ពុជា បាន អះអាង ថា ជំនួប ពិភាក្សា រវាង សម្ដេច តេជោ ហ៊ុន សែន និង លោក ដាតុ ស្រ៊ី អ៉ីស្មា អែល សាប្រ៊ី ប៊ីន យ៉ាកុប នឹង ពិភាក្សា អំពី ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី រួម មាន វិស័យ ពាណិជ្ជកម្ម និង ការវិនិយោគ សេដ្ឋកិច្ច - សង្គម ការពារ ជាតិ និង សន្តិសុខ និង ការស្តារ សង្គម - សេដ្ឋកិច្ច ឡើងវិញ ក្រោយ វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ ។ នាយក រដ្ឋមន្ត្រី ទាំង ពីរ នឹង ផ្លាស់ប្តូរ ទស្សនៈ លើ បញ្ហា តំបន់ និង អន្តរជាតិ នានា ដែល ជា ផលប្រយោជន៍ និង ក្តីបារម្ភ រួម ផងដែរ ។
លោក ដាតុ ស្រ៊ី អ៊ីស្មា អែល ប៊ីន យ៉ាកុប ធ្លាប់ បាន ជួប ពិភាក្សា ការងារ តាម ប្រព័ន្ធ វីដេអូ ជាមួយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី កាលពី ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២២ រួច ម្តង ផងដែរ ។
សូម បញ្ជាក់ ថា លោក អ៉ីស្មា អែល សាប្រ៊ី ប៊ីន យ៉ាកុប បាន អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា នៅ រសៀល ថ្ងៃទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ដើម្បី បំពេញ ទស្សនកិច្ច ជា លើក ដំបូង នៅក្នុង ប្រទេស កម្ពុជា រយៈពេល ពីរ ថ្ងៃ គឺ ថ្ងៃទី ២៣ និង ២៤ ខែកុម្ភៈ ។ ដំណើរទស្សនកិច្ច នេះ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ព្រមទាំង ផ្លាស់ប្តូរ ទស្សនៈ លើ បញ្ហា តំបន់ និង អន្តរជាតិ ។
យោង តាម ក្រសួង ការបរទេស បាន អះអាង ថា ក្នុង អំឡុង ពេល ទស្សនកិច្ច នៅ កម្ពុជា នេះ លោក នាយក រដ្ឋមន្រ្តី ម៉ាឡេស៊ី នឹង អញ្ជើញ ចូល ថ្វាយបង្គំ គាល់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ កម្ពុជា នៅ ព្រះបរម រាជ វាំង ហើយ លោក ក៏ នឹង អញ្ជើញ ចូល ជួប សម្ដែង ការគួរសម ចំពោះ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា និង សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ផងដែរ ។
នាយក រដ្ឋមន្រ្តី ម៉ាឡេស៊ី ក៏ នឹង អញ្ជើញ ដាក់ កម្រង ផ្កា គោរព វិញ្ញាណក្ខន្ធ នៅ វិមាន ឯករាជ្យ និង នៅ មណ្ឌ ប ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្ដម សីហនុ « ព្រះបរម រតន កោដ្ឋ » អតីត ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ផងដែរ ។
សូម បញ្ជាក់ ថា កម្ពុជា និង ម៉ាឡេស៊ី បាន ភ្ជាប់ ទំនាក់ទំនង ការទូត នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ១៩៥៧ ។ ប្រទេស ទាំង ពីរ បាន យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ល្អ ជាមួយគ្នា ។ ដើម្បី ពង្រឹង ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ល្អ ជាមួយគ្នា នេះ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ នៃ ប្រទេស ទាំង ពីរ តែងតែ ផ្លាស់ប្តូរ ដំណើរទស្សនកិច្ច រវាង គ្នា ជា បន្តបន្ទាប់ ។
សម្រាប់ ទំហំ វិនិយោគ និង ការធ្វើ ពាណិជ្ជកម្ម រវាង កម្ពុជា និង ម៉ាឡេស៊ី មាន ទំហំ ធំ គួរឱ្យ កត់សម្គាល់ ផងដែរ ។ របាយការណ៍ បង្ហាញ ថា ទំហំ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ កាលពី ឆ្នាំ ២០២១ សម្រេចបាន ជាង ៥០០ លាន ដុល្លារ អាមេរិក ។ ក្នុង នោះ ទំនិញ សំខាន់ ៗ ដែល កម្ពុជា នាំចូល ពី ប្រទេស ម៉ាឡេស៊ី មាន ដូច ជា៖ ប្រេងឥន្ធនៈ បំពង់ទី ប និង ទុយោ ជ័រ ដុំ ហ្រ្វាំង និង ដុំ ស្ពឺកង់ ក្រណាត់ ត្បាញ ភេសជ្ជៈ និង អាហារ កែច្នៃ ពី ម្សៅ ។
ដោយឡែក ទំនិញ សំខាន់ ៗ ដែល កម្ពុជា នាំចេញ ទៅ ម៉ាឡេស៊ី វិញ រួម មាន៖ សម្លៀកបំពាក់ គ្រាប់ ធញ្ញជាតិ ម៉ូទ័រ អគ្គិសនី អង្ករ គ្រាប់ និង សាច់ ត្នោត ។ ប្រទេស ម៉ាឡេស៊ី តែងតែ ឈរ លំដាប់ ទី១ ក្នុង ចំណោម សមាជិក អាស៊ាន ដែល នាំ អង្ករ ពី កម្ពុជា ច្រើន ជាង គេ ។ ក្នុង នោះ រយៈពេល ១១ខែ ឆ្នាំ ២០២១ ម៉ាឡេស៊ី នាំ អង្ករ ពី កម្ពុជា ជាង ៤ម៉ឺន តោន ។
របាយការណ៍ បាន បង្ហាញ ថា គិត ចាប់ពី ឆ្នាំ ២០១៤ ដល់ ឆ្នាំ ២០២១ ការវិនិយោគ របស់ ម៉ាឡេស៊ី នៅ កម្ពុជា មាន ទឹកប្រាក់ ជាង ១៤លាន ដុល្លារ ដុល្លារ អាមេរិក ។
កម្ពុជា និង ម៉ាឡេស៊ី ក៏ មាន កិច្ចសហប្រតិបត្តិការ រួមគ្នា លើ វិស័យ ជាច្រើន ផ្សេង ទៀត ដូចជា វិស័យ សន្តិសុខ និង ការពារ ជាតិ . វិស័យ អប់រំ វប្បធម៌ និង សុខាភិបាល ជាដើម ៕
ព្រឹក ស្អែក សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ស្វាគមន៍ និង ពិភាក្សា ការងារ ជាមួយ នាយក រដ្ឋមន្ត្រី ម៉ាឡេស៊ី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី២៤ ខែកុម្ភៈ ឆ្នាំ ២០២២ ស្អែក នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នឹង អញ្ជើញ ទទួលស្វាគមន៍ ជា ផ្លូវការ នៃ ដំណើរ បំពេញ ទស្សនកិច្ច របស់ លោក អ៉ីស្មា អែល សាប្រ៊ី ប៊ីន យ៉ាកុប នាយក រដ្ឋមន្ត្រី ម៉ាឡេស៊ី ព្រមទាំង ជួបពិភាក្សា ការងារ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ២៣ ខែកុម្ភៈ ឆ្នាំ ២០២២ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖ ១៖ ទីបំផុត លោក ចូ បៃ ដិន ប្រកាស ចេញ នូវ ទណ្ឌកម្ម ក្តៅ ៗ លើ រុស្ស៉ី ដោយ មាន គោលដៅ លើ បុគ្គល មាន ឥទ្ធិពល និង វិស័យ ធនាគារ
២៖ ទីបំផុត លោក វ៉្លាឌីមៀ ពូទីន ទទួលបាន ការអនុម័ត ពី សភា រុស្ស៉ី ដើម្បី បញ្ជូន ទ័ព ចូល ទៅកាន់ តំបន់ ផ្តាច់ ខ្លួន ២ នៅ ភាគ ខាងកើត អ៊ុយក្រែន
៣៖ ស្ប្រ ធានាធិបតី អ៊ុយក្រែន ច្រានចោល ការដាក់ពង្រាយ ទ័ព ទ្រង់ទ្រាយ ធំ ពេលនេះ ប៉ុន្តែ កំពុង ត្រៀម ទ័ព បម្រុង សម្រាប់ ថ្ងៃ មុខ
៤៖ ទីបំផុត សហភាព អឺរ៉ុប (EU) សម្រេច ទម្លាក់ កញ្ចប់ ទណ្ឌកម្ម ថ្មី លើ រុស្ស៉ី ឆ្លើយតប នឹង វិបត្តិ អ៊ុយក្រែន . តែ មិន បាន ដាក់ទណ្ឌកម្ម លោក ពូទីន ដោយ ផ្ទាល់ ទេ
