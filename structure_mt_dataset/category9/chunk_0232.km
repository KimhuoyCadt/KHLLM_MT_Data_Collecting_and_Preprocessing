( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេម ភូមិន្ទ និង ជា មេបញ្ជាការ អាវុធហត្ថ លើ ផ្ទៃ ប្រទេស បាន អញ្ជើញ ជួប ពិភាក្សា និង ពិសា បាយ សាមគ្គី ជាមួយ លោក លោកស្រី រៀមច្បង សាស្ត្រាចារ្យ ជា អ្នកនិពន្ធ អ្នកតន្ត្រី ជើង ចាស់ ដើម្បី លើកទឹកចិត្ត រួមគ្នា អភិរក្ស និង អភិវឌ្ឍ សិល្បៈ វប្បធម៌ តូរ តន្ត្រី នៅ ប្រទេស កម្ពុជា យើង ។
សម្រាប់ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ត្រូវបាន គេ មើលឃើញ ថា លោក ជា ថ្នាក់ដឹកនាំ ម្នាក់ ដែល តែងតែ យកចិត្ត ចំពោះ សុខ ទុក្ខ បងប្អូន ជើង ចាស់ ផ្នែក និពន្ធ និង តន្រ្តី ករ ហើយក៏ បាន ចំណាយ ធនធាន ផ្ទាល់ របស់ លោក ជួយ ឧបត្ថម្ភ ជូន បុគ្គល ទាំងនោះ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ ផងដែរ ។
នៅក្នុង ពិធី ជំនួប សំណេះសំណាល និង បាយ សាមគ្គី ជាមួយ រៀម ច្បង សាស្ត្រាចារ្យ ជា អ្នកនិពន្ធ អ្នកតន្ត្រី ជើង ចាស់ ខាងលើ នេះ នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន កោតសរសើរ ចំពោះ អតីតការងារ និង ស្នាដៃ ជាច្រើន របស់ ពួកគាត់ ដែល បាន បន្សល់ទុក សម្រាប់ កូន ចៅ ចំនាន់ ក្រោយ ឲ្យបាន ដឹង បាន ស្គាល់ ចំពោះ វប្បធម៌ និង សិល្បៈ របស់ ជាតិ យើង ហើយ សូមឲ្យ បន្ត ចែករំលែក ចំណេះដឹង ទាំងនេះ តាម លទ្ធភាព ដែល អាច ធ្វើ បាន ជូន កូន ចៅ របស់ យើង បន្ត ទៀត ៕
ប្រធាន តុលាការ និង ព្រះរាជអាជ្ញា រាជធានី ភ្នំពេញ សំណូមពរ ឲ្យ មន្រ្តី ក្រោម ឱវាទ ទាំងអស់ ខិតខំ ព្យាយាម ក្នុង ការផ្ដល់ សេវា យុត្តិធម៌ ជូន ប្រជាពលរដ្ឋ ដោយ ឈរ លើ គោលការ ច្បាប់ ជាធរមាន
( ភ្នំពេញ ) ៖ សាលាដំបូង រាជធានី ភ្នំពេញ និង តំណាង អយ្យការ អម សាលាដំបូង ពេញ មួយ ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នេះ បាន បើក កិច្ចប្រជុំ ពិនិត្យមើល លទ្ធផល ការងារ ឆ្នាំ ២០២១ និង លើក ទិដៅ ការងារ ឆ្នាំ ២០២២ ។
លោក ច្រឹង ខ្មៅ ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ថ្លែង បើក អង្គ សន្និបាត ថា សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ រដ្ឋបាល ឆ្នាំ ២០២២ ដែល ជា សន្និបាត លើក ទី៨ ត្រូវបាន រៀបចំឡើង ដោយ ផ្អែក លើ ស្មារតី មាត្រា ៣៤ នៃ ច្បាប់ ស្ដីពី ការរៀបចំ អង្គការ តុលាការ ក្នុង គោលបំណង ដូច ខាងក្រោម៖
* ទី១៖ បង្ហាញ ឱ្យ ឃើញ សមិទ្ធផល ទាំងឡាយ ដែល ខិតខំ ធ្វើ ហើយ សម្រេចបាន *ទី ២៖ កំណត់ បញ្ហា ប្រឈម ដែល កើតមាន និង រក ដំណោះស្រាយ ដ៏ ត្រឹមត្រូវ សម្រាប់ បញ្ហា ទាំងនោះ តាមរយៈ កិច្ចពិភាក្សា ផ្លាស់ប្ដូរ បទពិសោធ * ទី ៣៖ កំណត់ ទិសដៅ ផែនការ សកម្មភាព ការងារ ឱ្យ បាន ច្បាស់លាស់ នា ពេល ខាងមុខ ដែល ជា សកម្មភាព ចូលរួមចំណែក កម្មវិធី នយោបាយ កំណែទម្រង់ ច្បាប់ និង ប្រព័ន្ធ យុត្តិធម៌ របស់ រាជ រដ្ឋា ភោបាល ឱ្យ សម្រេច ជា ផ្លែ ផ្កា ដ៏ ត្រចះត្រចង់ ។
លោក អ៊ី រិន្ទ ប្រធាន លេខាធិការដ្ឋាន រដ្ឋបាល នៃ សាលាដំបូង រាជធានី ភ្នំពេញ បាន អាន សេចក្ដីព្រាង របាយការណ៍ លទ្ធផល សកម្មភាព ការងារ ឆ្នាំ ២០២១ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២២ ជូន អង្គ សន្និបាត ជ្រាប ហើយ អង្គ សន្និបាត បាន ឯកភាព លើ សេចក្ដីព្រាង របាយការណ៍ ទាំងស្រុង ។
លោក ប្រធាន តុលាការ បន្ត ថា « ខ្ញុំ សូមឲ្យ លោក លោកស្រី ចៅក្រម ព្រះរាជអាជ្ញា រង ក្រឡាបញ្ជី មន្រ្តី អាជ្ញា សាលា និង មន្រ្តី ទាំងអស់ នៃ លេខាធិការដ្ឋាន រដ្ឋបាល ត្រូវ ខិតខំ បំពេញ ភារកិច្ច របស់ ខ្លួន ស្រប តាម ច្បាប់ នីតិវិធី វិជ្ជាជីវៈ មនសិការ និង សាមគ្គី គ្នា បន្ថែម ទៀត ដើម្បី សម្រេច នូវ ទិសដៅ ការងារ រដ្ឋបាល ដែល បាន ដាក់ចេញ សម្រាប់ ឆ្នាំ ២០២២ និង ដើម្បី ទទួលបាន ការជឿទុកចិត្ត ពី ប្រជាពលរដ្ឋ ក្នុង ការផ្ដល់ សេវា យុត្តិធម៌ ជូន ពួកគាត់ » ។
មុន បិទ បញ្ចប់ អង្គ សន្និបាត លោក ប្រធាន សាលាដំបូង បាន ស្នើ ដល់ សុំ មន្ត្រី ទាំងអស់ បន្ត គាំទ្រ និង អនុវត្ត បន្ត នូវ ផែនការ យុទ្ធសាស្រ្ត របស់ រាជ រដ្ឋាភិបាល ជា អាទិ៍៖
* ទី១៖ ការពង្រឹង ការអនុវត្ត ច្បាប់ ឱ្យ បាន ត្រឹមត្រូវ *ទី ២៖ ការពង្រឹង ភាពស្អាតស្អំ និង ក្រមសីលធម៌ វីជ្ជាជីវៈ របស់ មន្ត្រី ក្នុង ការអនុវត្ត ច្បាប់ * ទី ៣៖ ពង្រឹង យន្តការវិន័យ ការងារ និង ការធ្វើ ទំនើបកម្ម រដ្ឋបាល យុត្តិធម៌ * ទី៤៖ ការលើកកម្ពស់ ការផ្តល់ សេវា ច្បាប់ / យុទ្ធសាស្រ្ត លើកកម្ពស់ ការផ្តល់ សេវា ផ្នែក ច្បាប់ * ទី៥៖ ការពង្រឹង និង កែលម្អ យន្តការដោះស្រាយ វិវាទ ដែល អាច ឆ្លើយតប ទៅនឹង ស្ថានភាព ជាក់ស្ដែង របស់ សង្គម ប្រកបដោយ ប្រសិទ្ធភាព ៕
កាលពី ថ្ងៃពុធ សប្តាហ៍ មុន នេះ លោក គីម ជុង អ៊ុន ប្រមុខ ដឹកនាំ កំពូល នៃ ប្រទេស កូរ៉េ ខាងជើង បាន បង្ហើប នៅក្នុង កិច្ចប្រជុំ របស់ គណបក្ស ពលករ កូរ៉េ ថា ប្រទេស របស់ លោក អាចនឹង ចាប់ផ្តើម « សកម្មភាព ទាំងអស់ ដែល ត្រូវបាន ផ្អាក ពីមុន » ដើម្បី ឆ្លើយតប ចំពោះ សកម្មភាព អរិយភាព ដែល សហរដ្ឋ អាមេរិក កំពុង មាន មក លើ ទីក្រុង ព្យុងយ៉ាង ។
សកម្មភាព ដែល ត្រូវបាន ផ្អាក នោះ គឺ សំដៅ ទៅ លើ ការធ្វើតេស្ត អាវុធ នុយក្លេអ៊ែរ និង មីស៊ីល ផ្លោង រយៈ ចម្ងាយ ឆ្ងាយ ឬ ដែល យើង ស្គាល់ ថា មីស៊ីល អន្តរជាតិ ICBM ដែល លោក គីម ជុង អ៊ុន បាន ព្រមព្រៀង ផ្អាក កាលពី ឆ្នាំ ២០១៨ ដើម្បី ស្វាគមន៍ កិច្ចសន្ទនា ជា ប្រវត្តិសាស្ត្រ ជាមួយ លោក ដូណាល់ ត្រាំ ដែល កាល ណោះ ជា ប្រធានាធិបតី សហរដ្ឋ អាមេរិក ។
គួរ បញ្ជាក់ ថា បន្ទាប់ពី ការធ្វើតេស្ត មីស៊ីល រហូតដល់ទៅ ៤លើក ចាប់ពី ដើម ខែមករា ឆ្នាំ ២០២២ ប្រទេស កូរ៉េ ខាងត្បូង ជប៉ុន និង សហរដ្ឋ អាមេរិក បាន និង កំពុង តាមដាន សកម្មភាព កូរ៉េ ខាងជើង មិន ដាក់ ភ្នែក នោះ ឡើយ ជាពិសេស គឺ នៅ ពេល ដែល ប្រទេស នេះ កំពុង ត្រៀម ប្រារព្ធ ពិធី បុណ្យ ធំ ៗ ដូចជា ខួបកំណើត ឆ្នាំ ទី ៨០ នៃ លោក គីម ជុង អ៊ីល ដែល ត្រូវ ជា ឪពុក របស់ លោក គីម ជុង អ៊ុន នៅ ថ្ងៃទី ១៦ ខែកុម្ភៈ និង ខួបកំណើត ឆ្នាំ ទី ១១០ នៃ លោក គីម អ៊ីល ស៊ុង ដែល ត្រូវ ជា ជីតា របស់ លោក គីម ជុង អ៊ុន នៅ ថ្ងៃទី ១៥ ខែមេសា ៕
រដ្ឋមន្ត្រី ក្រសួង សាធារណការ ប្តេជ្ញា ជំរុញ ឱ្យ មាន ការប្រើប្រាស់ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី ឱ្យ បាន ទូលំទូលាយ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ នៅក្នុង ឱកាស ទទួល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ គណៈប្រតិភូ សហព័ន្ធ ឧស្សាហកម្ម យានយន្ត កម្ពុជា (CAIF) ដើម្បី ពិភាក្សា លើ គោល នយោបាយ គាំទ្រ សម្រាប់ រថយន្ត ប្រើប្រាស់ ថាមពល អគ្គិសនី (EV) នៅ កម្ពុជា លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ប្តេជ្ញា ជំរុញ ឱ្យ មាន ការប្រើប្រាស់ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី ឱ្យ បាន ទូលំទូលាយ នៅ កម្ពុជា ដើម្បី ចូលរួម កាត់បន្ថយ ការបំភាយ ឧស្ម័ន កាបូន ទៅក្នុង បរិយាកាស ផែនដី ។
ជំនួប នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នេះ នៅ ទីស្ដីការ ក្រសួង ដោយ គណៈប្រតិភូ សហព័ន្ធ ឧស្សាហកម្ម យានយន្ត កម្ពុជា ដឹកនាំ ដោយ លោក តាន់ មុនី វណ្ណ ប្រធាន សហព័ន្ធ និង ជា អនុប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង មាន ការចូលរួម អម ដំណើរ ពី អគ្គ នាយក ក្រុមហ៊ុន រថយន្ត មួយ ទៀត ចំនួន ផងដែរ ។
បន្ថែម ពី នេះ លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន គូសបញ្ជាក់ ពី តួនាទី នាំមុខ និង ការប្តេជ្ញាចិត្ត ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ របស់ ក្រសួង ក្នុង ការជំរុញ ការ ប្រើប្រាស់ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី ឱ្យ បាន ទូលំទូលាយ និង បាន បន្ថែម ថា រាជ រដ្ឋាភិបាល មាន ការបើកចំហរ ទូលំទូលាយ ដល់ វិនិយោគិន ទាំង ក្នុង ស្រុក ក៏ ដូចជា ក្រៅ ស្រុក វិនិយោគ លើ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ សម្រាប់ ដំណើរការ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី ។
នា ឱកាស នោះ គណៈប្រតិភូ សហព័ន្ធ ឧស្សាហកម្ម យានយន្ត កម្ពុជា បាន សំណូមពរ ឱ្យ ក្រសួង ជួយ ពិនិត្យ និង សម្របសម្រួល លើ ការងារ បច្ចេកទេស ពាក់ព័ន្ធ នឹង ការដំឡើង ឧបករណ៍ ស្តង់ដា រួម ( យ ថា ប្រភេទ តែ មួយ ) ដែល អាច ឱ្យ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី គ្រប់ ប្រភេទ ទាំងអស់ ដោត សាក ថ្ម EVs នៅ តាម ស្ថានីយ សាក ថ្ម ណាមួយ ក៏ បាន និង បាន ស្នើ ឱ្យ មាន គោល នយោបាយ សម្រាប់ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី ផងដែរ ។
ជា ការឆ្លើយតប លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន ណែនាំ ឱ្យ សហព័ន្ធ សហការ ឱ្យ បាន ជិតស្និទ្ធ ជាមួយ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ក្រោម ឱវាទ ក្រសួង សំដៅ ដោះស្រាយ បញ្ហា ដែល សហព័ន្ធ បាន លើកឡើង ឱ្យ បាន ជោគជ័យ ដើម្បី ជំរុញ លើកទឹកចិត្ត ឱ្យ មាន ការប្រើប្រាស់ រថយន្ត ដើរ ដោយ ថាមពល អគ្គិសនី បាន ទូលំទូលាយ និង ទាក់ទាញ ចំណាប់ អារម្មណ៍ ខ្ពស់ ពី វិស័យ ឯកជន ក៏ ដូចជា សាធារណជន ជាទូទៅ ផងដែរ ។
បន្ថែម ពី នេះ លោក ស៊ុន ចាន់ថុល ក៏ បាន ជម្រាប ជូន ភ្ញៀវ អំពី ការបង្កើត វិទ្យាស្ថាន តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន ដើម្បី បណ្តុះបណ្តាល ធនធាន មនុស្ស និង ដោះស្រាយ បញ្ហា កង្វះ អ្នក បច្ចេកទេស សម្រាប់ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវថ្នល់ ស្ពាន ការបង្កើត មណ្ឌល ផ្តល់ សេវា សាធារណៈ ដើម្បី បង្ខិត សេវា ទៅ កៀក ប្រជាពលរដ្ឋ ។
( សៀមរាប ) ៖ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត សៀមរាប បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ជូន គ្រួសារ ក្រីក្រ និង មាន ជំងឺ ប្រចាំ កាយ មួយ គ្រួសារ ស្ថិត នៅ ភូមិ ប្រាសាទ ត្រាវ ឃុំ គោក ដូង ស្រុក អង្គរ ជុំ ខេត្ត សៀមរាប ។
លោក ក៏ បាន ក្រើនរលឹក ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ ថែរក្សា សុខភាព ហើយ អាជ្ញាធរ ភូមិ ឃុំ នៅតែ បន្ត ផ្សព្វផ្សាយ ដល់ ប្រជាពលរដ្ឋ មាន ការប្រុងប្រយ័ត្ន និង ចូលរួម អនុវត្ត វិធានការ ការពារ ជំងឺ កូវីដ - ១៩ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ព្រោះថា ជំងឺ នេះ នៅតែ បន្ត ឆ្លង រីករាលដាល នៅក្នុង ប្រទេស កម្ពុជា និង ជា សកលលោក នៅឡើយ ។
អំណោយ មនុស្សធម៌ ដែល ផ្ដល់ជូន រួម មាន អង្ករ ៣០ គីឡូក្រាម ត្រីខ១យួរ ទឹកត្រី ១យួរ ទឹកស៊ី អ៉ីវ១យួរ ប្រេង ឆា ចំណុះ ២លីត្រ ១ដប សម្ភារ ប្រើប្រាស់ មួយ ឃីត និង ថវិកា ២៧០.០០០ រៀល ផងដែរ ៕ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា និង OHCHR រៀបចំ ពិភាក្សា ពិគ្រោះយោបល់ ជាមួយ សហជីព ស្តីពី « សេចក្តីព្រាង ច្បាប់ ស្តីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ គណៈកម្មាធិការ ជាតិ សិទ្ធិ មនុស្ស កម្ពុជា »
( ភ្នំពេញ )៖ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នេះ បាន សហការ ជាមួយ ការិយាល័យ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស នៅ កម្ពុជា (OHCHR) រៀបចំ សិក្ខាសាលា ពិគ្រោះ យោបល់ ជាមួយ សហជីព ស្តីពី « សេចក្តីព្រាង ច្បាប់ ស្តីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ គណៈកម្មាធិការ ជាតិ សិទ្ធិ មនុស្ស កម្ពុជា » ក្នុង គោលដៅ ប្រមូល ធាតុ ចូល បន្ថែម ពី ខាង សហជីព និង ភាគី ពាក់ព័ន្ធ នានា ដើម្បី ធានា បាន នូវ តម្លាភាព និង ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ។
នា ឱកាស នោះ ដែរ លោក កែវ រ៉េមី បាន ឱ្យដឹង ថា ការបង្កើត ស្ថាប័ន គណៈកម្មាធិការ ជាតិ សិទ្ធិ មនុស្ស កម្ពុជា គឺជា កិច្ចខិតខំ របស់ រាជ រដ្ឋាភិបាល ក្នុង ឆន្ទៈ លើកស្ទួយ សិទ្ធិ មនុស្ស ហើយ គណៈកម្មាធិការ ជាតិ សិទ្ធិ មនុស្ស កម្ពុជា ដែល នឹង បង្កើតឡើង នេះ គឺជា ស្ថាប័ន ជាតិ ឯករាជ្យ អព្យាក្រឹត្យ ក្នុង ការបំពេញ ការងារ លើ វិស័យ សិទ្ធិ មនុស្ស ។
ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន បញ្ជាក់ ថា ក្រោម ការយកចិត្តទុកដាក់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការការពារ និង លើកកម្ពស់ សិទ្ធិ មនុស្ស និង ដើម្បីឱ្យ ការគោរព សិទ្ធិ មនុស្ស នៅ កម្ពុជា កាន់តែ មាន ប្រសិទ្ធិភាព ទើប អនុញ្ញាតឱ្យ គ.ស.ម .ក . ធ្វើ សេចក្តីព្រាង ច្បាប់ នេះ ឡើង ។
លោក Pradeep Wagle បាន ថ្លែង ថា « ក្នុង នាម ការិយាល័យ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុល សិទ្ធិ មនុស្ស ប្រចាំ កម្ពុជា ខ្ញុំ សូម បញ្ជាក់ ឡើងវិញ អំពី ឆន្ទៈ របស់ ការិយាល័យ របស់ ខ្ញុំ នៅក្នុង ការគាំទ្រ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ការពារ និង លើកស្ទួយ សិទ្ធិ មនុស្ស សម្រាប់ ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង ប្រទេស កម្ពុជា » ។
អង្គ សិក្ខាសាលា បាន ពិភាក្សា ផ្តល់ យោបល់ និង ផ្តល់ ធាតុ ចូល យ៉ាង សកម្ម ផុស ផុល ចំពោះ មាត្រា និង ជំពួក នីមួយ ៗ ក្នុង ស្មារតី សាមគ្គីភាព និង ស្និទ្ធស្នាល ៕ អគ្គ នាយក ក្លឹប ឆ្នេរសមុទ្រ ដែល ស្អាត បំផុត លើ សកលលោក កោតសរសើរ កម្ពុជា ដែល ខិតខំ រៀបចំ វេទិកា ទេសចរណ៍ អាស៊ាន ប្រកបដោយ ភាពជោគជ័យ
ក្នុង សារលិខិត នោះ បាន បញ្ជាក់ ថា អគ្គ នាយក ក្លឹប ឆ្នេរសមុទ្រ ដែល ស្អាត បំផុត លើ សាកលលោក បាន កោតសរសើរ យ៉ាង ខ្លាំង ចំពោះ ជោគជ័យ នៃ ការរៀបចំ វេទិកា ទេសចរណ៍ អាស៊ាន ឆ្នាំ ២០២២ នៅ ក្រុង ព្រះសីហនុ ក្រោម ការដឹកនាំ រៀបចំ ដោយ លោក ថោង ខុន រដ្ឋមន្រ្តី ក្រសួង ទេសចរណ៍ និង ជា ប្រធាន វេទិកា ទេសចរណ៍ អាស៊ាន ឆ្នាំ ២០២២ ជាពិសេស តាមរយៈ ការចូលរួម ដោយ ផ្ទាល់ ពី បណ្តា ប្រតិភូ និង ភ្ញៀវ កិត្តិយស អន្តរជាតិ ដែល អញ្ជើញ មកពី បណ្តា ប្រទេស ជាច្រើន ក្នុង ពិភពលោក រួមទាំង រូបលោក ផ្ទាល់ ដែល មកពី ប្រទេស បារាំង ។
អគ្គ នាយក ក្លឹប ឆ្នេរ រូប នេះ បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី ដែល បាន ទទួលយល់ព្រម ធ្វើជា ម្ចាស់ ផ្ទះ នៃ មហាសន្និបាត ពិភពលោក របស់ ក្លឹប ឆ្នេរសមុទ្រ ដែល ស្អាត បំផុត លើ សាកលលោក ឆ្នាំ ២០២២ ដែល ជា លទ្ធផល នៃ ជំនួប សម្តែង ការគួរសម ប្រកប ភាព ស្និទ្ធស្នាល មិត្តភាព និយាយ ត្រង់ ៗ មក ចេញ ពី បេះដូង រវាង ភាគី ទាំង ពីរ នា ឱកាស ពិធី បុណ្យ សមុទ្រ កាលពី កំឡុង ខែធ្នូ ឆ្នាំ ២០១៨ នៅ ខេត្ត កោះកុង ។
លោក បាន បង្ហាញ ក្ដីសង្ឃឹម យ៉ាង មុតមាំ ថា សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី នឹង ផ្តល់ កិត្តិយស ដ៏ ខ្ពង់ខ្ពស់ អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក ឬ កម្មវិធី ណាមួយ នៃ អង្គ មហាសន្និបាត ដែល គ្រោង រៀបចំ នា កំឡុង ខែធ្នូ ឆ្នាំ ២០២២ នៅ ក្រុង ព្រះសីហនុ ភ្ជាប់ ជាមួយ រមណីយដ្ឋាន តារា សាគរ ក្នុង ខេត្ត កោះកុង ។
ឧកញ៉ា នួន ឫទ្ធី អគ្គ នាយក ក្រុមហ៊ុន KFA បាន ថ្លែង ថា ក្នុង ស្ថានភាព ដែល វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា មិន ទាន់ មាន សន្ទុះ ឡើងវិញ ការពន្យារ ពេល អនុវត្ត ការយក ពន្ធ លើ ចំណេញ មូលធន ចំនួន ២ឆ្នាំ ទៀត នឹង ជួយ ដល់ ចរន្ត ទិញ លក់ អចលន ទ្រព្យ នៅ កម្ពុជា ។
ការស្នើ ពន្យា នេះ ដោយសារតែ វិស័យ មួយចំនួន នៅ មិន ទាន់ អាច វិលត្រឡប់ ទៅការធ្វើ ធុរកិច្ច ជាធម្មតា វិញ ទេ ដែល វិស័យ ទាំងនេះ ត្រូវការ ការគាំទ្រ មួយ រយៈ បន្ថែម ទៀត ទោះបីជា ពេលនេះ ស្ថានភាព ជំងឺ កូវីដ១៩ មាន ភាព ស្រាកស្រាន្តក្តី ។ ដើម្បី ជួយ សម្រួល ដល់ ការងើប ឡើងវិញ រាជ រដ្ឋាភិបាល នឹង បន្ត រៀបចំ នូវ វិធានការពាក់ព័ន្ធ ចាំបាច់ នានា ក្នុង ការជួយ សម្រាល បន្ទុក សារពើពន្ធ ដល់ សហគ្រាស ទាំងនេះ និង បន្ត លើកកម្ពស់ គុណភាព នៃ ការផ្តល់ សេវា របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ បន្ថែម ទៀត ។
តាម ការព្យាករណ៍ របស់ រាជ រដ្ឋាភិបាល កាលពី ពេល ថ្មី ៗ នេះ វិស័យ សំណង់ និង អចលន ទ្រព្យ នៅ កម្ពុជា នឹង បន្ត ងើប ឡើងវិញ ក្នុង ល្បឿន យឺត នៅ ឆ្នាំ ២០២២ ដោយសារ ការរំពឹងទុក ការងើប ឡើងវិញ សន្សឹម ៗ នូវ ទំនុកចិត្ត វិនិយោគ និង រំហូរ ទុន វិនិយោគ ជាពិសេស សកម្មភាព សំណង់ បម្រើ ឱ្យ វិស័យ ទេសចរណ៍ និង ពាណិជ្ជកម្ម ៕ រដ្ឋមន្ត្រី ក្រសួង អប់រំ ដាក់ ចេញ វិធានការ៣ ចំណុច ក្នុង ឱកាស បើក ដំណើរការ សាលារៀន ឡើងវិញ ប្រកបដោយ សុវត្ថិភាព (Video inside)
( ភ្នំពេញ ) ៖ បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា បាន ចេញ សារ អំពាវនាវ និង ការថ្លែងអំណរគុណ ដល់ លោកគ្រូ អ្នកគ្រូ អាណាព្យាបាល សិស្សានុសិស្ស និង ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន ជួយ គាំទ្រ ដល់ ការបើក ដំណើរការ សាលារៀន ប្រកបដោយ សុវត្ថិភាព និង សុខុមាលភាព ក្នុង បរិបទ កូវីដ - ១៩ ក្នុង ទិវា អប់រំ អន្តរជាតិ ២៤ មករា ។
ក្នុង វីដេអូ ជិត ៤នាទី ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នេះ បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន បាន សម្តែង នូវ កតញ្ញូតាធម៌ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ដឹកនាំ ការងារ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ ទទួលបាន ជោគជ័យ ដែល បាន ផ្តល់ អាទិភាព នៅក្នុង ការចាក់ វ៉ាក់សាំង ដល់ បុគ្គលិក អប់រំ លោកគ្រូ អ្នកគ្រូ ព្រមទាំង សិស្សានុសិស្ស ទាំងអស់ ដែល អាច ឲ្យ បើក សាលារៀន ដំណើរការបាន វិញ ។
បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន ក៏ សូម ថ្លែងអំណរគុណ ដល់ លោកគ្រូ អ្នកគ្រូ ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង អស់ ពី កម្លាំង កាយ ចិត្ត នៅក្នុង ការរៀន ប្រើប្រាស់ បច្ចេកវិទ្យា ដើម្បី ផ្តល់ ការអប់រំ ដល់ សិស្សានុសិស្ស នៅក្នុង បរិបទ នៃ ការផ្អាក ដំណើរការ សាលារៀន ហើយក៏ បាន ចេញ នូវ គំនិត ច្នៃប្រឌិត នៅក្នុង ការបង្រៀន តាម បែប អេឡិចត្រូនិក ការបង្រៀន តាម បណ្ដុំ . ការបង្រៀន តាម ខ្នង ផ្ទះ . ការបង្រៀន ដោយ ប្រើប្រាស់ សន្លឹក កិច្ចការ និង ការបង្រៀន ពី ចម្ងាយ ។
បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន សូម វាយតម្លៃ ខ្ពស់ នៅក្នុង ទិវា អប់រំ អន្តរជាតិ នេះ ចំពោះ ការខិតខំ ប្រឹងប្រែង របស់ ដៃគូ អភិវឌ្ឍន៍ ក៏ ដូចជា សហគមន៍ មាតាបិតា ដែល បាន ជួយ គាំទ្រ ដល់ ក្រសួង អប់រំ យុវជន និង កីឡា ជួយ គាំទ្រ ដល់ សាលារៀន ដើម្បី ផ្ដល់ នូវ សម្ភារៈ ឧបទេស និង អនាម័យ ផ្សេង ៗ ដើម្បី ធានា បាន នូវ ការ បើក ដំណើរការ សាលារៀន ប្រកបដោយ សុវត្ថិភាព ចាប់ពី ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២២ ។
ក្រសួង អប់រំ យុវជន និង កីឡា បាន បើក វេសនាកាល ថ្មី ដើម្បី ផ្តល់ ឱកាស ឲ្យ សិស្សានុសិស្ស បាន ចូល រៀន ឡើងវិញ ដូច្នេះ តាង នាម ក្រសួង អប់រំ យុវជន និង កីឡា បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន សូម ដាក់ចេញ នូវ វិធានការ ដូចត ទៅ៖
ទី១៖ សូមឲ្យ គ្រឹះស្ថាន សិក្សា ទាំងអស់ ប្រុងប្រយ័ត្ន អនុវត្ត ឲ្យបាន យ៉ាង ខ្ជាប់ខ្ជួន នូវ ស្តង់ដារ សុវត្ថិភាព អនាម័យ ដែល ក្រសួង អប់រំ យុវជន និង កីឡា និង ក្រសួង សុខាភិបាល បាន ដាក់ចេញ ជាពិសេស គឺ អនុវត្ត នូវ អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី គឺ បី កុំ និង បី ការពារ
ទី២៖ ត្រូវ បង្កើត ឲ្យ មាន ជា គណៈកម្មការ សុវត្ថិភាព សុខភាព សិក្សា នៅ តាម ខេត្ត ក្រុង ហើយ បង្កើត ឲ្យ មាន គណៈកម្មការ សុខភាព សិក្សា នៅ តាម គ្រឹះស្ថាន សិក្សា ឲ្យ មាន ការចូលរួម ពី មណ្ឌល សុខភាព មាន គ្រូបង្គោល និង គ្រូ ប្រចាំ ថ្នាក់
ទី៣៖ សូម អនុវត្ដ នៅ តាម តំបន់ ណា ដែល មាន ហានិភ័យ ខ្ពស់ នូវ ការរៀន តាម បណ្ដុំ ដោយ មិន ត្រូវ ឲ្យ ចំនួន សរុប សិស្ស លើស ពី ២០ ឬ ២៥ នាក់ ឡើយ ហើយ រក្សា នូវ គម្លាត ឲ្យបាន យ៉ាង ខ្ជាប់ខ្ជួន ហើយ ត្រូវ រៀន ផ្លាស់ វេន គ្នា ៕
កញ្ចប់ សព្វាវុធ ដំបូង ទម្ងន់ សរុប ប្រមាណ ជា ៩០តោន នៃ ជំនួយ យោធា ខាងលើ ដែល ត្រូវបាន សហរដ្ឋ អាមេរិក អនុម័ត កាលពី ខែធ្នូ ឆ្នាំ ២០២១ បាន ទៅដល់ រដ្ឋធានី របស់ អ៊ុយក្រែន កាលពី ថ្ងៃសៅរ៍ ចុង សប្តាហ៍ កន្លងទៅ នេះ ។
ទីក្រុង វ៉ាស៉ីនតោន បាន អះអាង ថា ខ្លួន នឹង បន្ត ផ្តល់ ការជួយគាំទ្រ ដល់ អ៊ុយក្រែន ចំពោះ មុខ ក្តីបារម្ភ អំពី ការប្រមូលផ្តុំ កម្លាំង ទ័ព រាប់ ម៉ឺន នាក់ របស់ ប្រទេស រុស្ស៉ី នៅ តាម បណ្តោយ ព្រំប្រទល់ អ៊ុយក្រែន ដែល ត្រូវ ក្រុម ប្រទេស លោក ខាងលិច សង្ស័យ ថា ជា ការត្រៀម លើក ទ័ព ចូល ឈ្លានពាន ។ យ៉ាងណា ក្តី ទីក្រុង ម៉ូស្គូ បាន បដិសេធ ថា មិន មាន គម្រោង ត្រៀម ធ្វើ ប្រតិបត្តិការ យោធា លើ ប្រទេស ណាមួយ ដូច ការចោទប្រកាន់ នោះ ទេ ៕
ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ជូនដំណឹង ពី ការដាក់ ឲ្យ ប្រើប្រាស់ ប្រព័ន្ធ សហគមន៍ ឌីជីថល កម្ពុជា
សេចក្ដីជូនដំណឹង របស់ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន បញ្ជាក់ ថា ស្រប តាម គោល នយោបាយ សេដ្ឋកិច្ច និង សង្គម ឌីជីថល និង ដើម្បី គាំទ្រ ដល់ ការអនុវត្ត គោល នយោបាយ រដ្ឋាភិបាល ឌីជីថល ក្រសួង បាន បង្កើត ប្រព័ន្ធ « សហគមន៍ ឌីជីថល កម្ពុជា » ។
ប្រព័ន្ធ នេះ បង្កើតឡើង ក្នុង គោលបំណង ប្រមូលផ្តុំ បុគ្គល ដែល មាន គុណ វុឌ្ឍ ផ្នែក បច្ចេកវិទ្យា ឌីជីថល ទាំង ក្នុង ប្រទេស និង ក្រៅ ប្រទេស ចុះឈ្មោះ ចូល ប្រើប្រាស់ ប្រព័ន្ធ ដើម្បី ទទួលបាន ឱកាស ក្នុង ការអភិវឌ្ឍ ជំនាញ វិជ្ជាជីវៈ របស់ ខ្លួន ឱកាស ការងារ ល្អ ការចែករំលែក ចំណេះដឹង និង បទពិសោធ ទៅ វិញ ទៅ មក រវាង អ្នកជំនាញ ព្រមទាំង ព័ត៌មាន សំខាន់ ៗ ពាក់ព័ន្ធ នឹង គោល នយោបាយ ក្នុង វិស័យ បច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន ផងដែរ ។
( ពោធិ៍សាត់ )៖ លោក កែវ រតនៈ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី អគ្គ នាយក អគ្គិសនី កម្ពុជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក ក្រគរ និង ស្រុក កណ្តៀង និង លោក ជា វ តាយ អភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នេះ បាន អញ្ជើញ ជួប សំណេះសំណាល សួរសុខទុក និង នាំយក អំណោយ របស់ អគ្គិសនី កម្ពុជា និង អាជ្ញាធរ អគ្គិសនី កម្ពុជា ទៅ ចែកជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ កងពល តូច អន្តរាគមន៍ លេខ ១៤ ដែល អង្គភាព សម្ព័ន្ធ មេត្រីភាព នឹង គ្នា ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ បរិវេណ បញ្ជាការដ្ឋាន កងពល តូច អន្តរាគមន៍ លេខ ១៤ ដោយ បាន ការចូលរួម ពី លោក ម៉ក់ រ៉ា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . តំណាង អាជ្ញាធរ អគ្គិសនី . អភិបាល រង នៃ គណៈអភិបាល ខេត្ត . មេបញ្ជាការ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣. ប្រធាន អនុប្រធាន មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត . ក្រុមការងារ . អាជ្ញាធរ ស្រុក ឃុំ និង បងប្អូន កងកម្លាំង ប្រមាណ ជិត ៨០០ នាក់ ។
លោក បាន ថ្លែង ថា គិត ទល់ ពេលនេះ ប្រទេស កម្ពុជា ស្ថិត ក្នុង ស្ថានភាពរឹងមាំ ក្នុង ការចាកចេញ ពី ជំងឺ កូវីដ១៩ តែ ទោះជា យ៉ាង នេះ ក្តី ស្ថានភាព ដែល កំពុង ប្រឈមមុខ បច្ចុប្បន្ន គឺ ការឆ្លង រីករាលដាល មេរោគ បំប្លែង ថ្មី ប្រភេទ អូមី ក្រុង ដែល ទាមទារ ឱ្យ យើង ទាំងអស់ គ្នា ត្រូវ ទៅ ទទួល វ៉ាក់សាំង កូវីដ១៩ ដូស ជម្រុញ ដើម្បី បង្កើន ប្រព័ន្ធ ភាពស៊ាំ ទប់ស្កាត់ ការឆ្លង រីករាល ទៅក្នុង សហគមន៍ ។
លោក កែវ រតនៈ បាន បន្ថែម ថា មិន យូរ ទេ ស្ថានភាព សេដ្ឋកិច្ច នៅក្នុង ប្រទេស និយាយ ជា រួម និង និយាយ ដោយឡែក សម្រាប់ ខេត្ត ពោធិ៍សាត់ នឹង មាន ការរីកចម្រើន ដូច ដើម វិញ ជាក់ ជា ពុំ ខាន ។ លោក សូម សន្យា ថា នឹង រៀបចំ ឱ្យ មាន កម្មវិធី ជួបជុំ អាហារ សាមគ្គី នៅ មុន ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ នា ពេល ខាងមុខ ប្រសិនបើ ស្ថានភាព កូវីដ១៩ ធូរស្រាល ពិសេស យើង ទាំងអស់ គ្នា បាន ទទួល វ៉ាក់សាំង ដូស ជម្រុញ គ្រប់ ៗ គ្នា ។
ទន្ទឹមនឹង នេះ ដែរ លោក ក៏ សូម ផ្ដាំផ្ញើ ដល់ កងកម្លាំង របស់ យើង ទាំងអស់ ត្រូវ បន្ត ថែរក្សា សុខភាព របស់ ខ្លួន ឱ្យ បាន ល្អ ដោយ ត្រូវ ចូលរួម អនុវត្ត វិធានការ « ៣កុំ និង ៣ការពារ » របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា វិធានការ នានា របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ជាប់ ជាប្រចាំ ដើម្បី សហគមន៍ របស់ យើង គ្មាន ជំងឺ កូវីដ១៩ ។
លោក ហ្កៃដូ បាន ចេញ សេចក្តី អំពាវនាវ ខាងលើ កំលុង ព្រឹត្តិការណ៍ មួយ ដែល រៀបចំឡើង ដើម្បី រំលឹក ខួប នៃ ការបញ្ចប់ របប យោធា ផ្តាច់ការ កាលពី ឆ្នាំ ១៩៥៨ ។ មេបក្ស ប្រឆាំង លេចធ្លោ រូប នេះ បាន សង្កត់ធ្ងន់ ថា បណ្តា បក្ស ប្រឆាំង នៅ វេណេស៊ុយអេឡា ចាំបាច់ ត្រូវ រួម សាមគ្គី គ្នា ហើយ ត្រៀមលក្ខណៈ ចាប់ពី ពេលនេះ តទៅ នៅ ចំពោះមុខ ការប្រកួតប្រជែង យក តំណែង ប្រធានាធិបតី ដែល បច្ចុប្បន្ន គ្រោង នឹង ធ្វើឡើង នៅ ឆ្នាំ ២០២៤ ។
គួរ បញ្ជាក់ ថា កន្លងមក ប្រទេស លោក ខាងលិច ជាច្រើន ធ្លាប់ បាន បង្ហាញ ការគាំទ្រ លោក ហ័ន ហ្កៃដូ ជា មេដឹកនាំ នៃ ប្រទេស វេណេស៊ុយអេឡា ប៉ុន្តែ ចាប់តាំងតែពី ការបោះឆ្នោត ថ្នាក់ តំបន់ កាលពី ឆ្នាំ ២០២១ នៅ វេណេស៊ុយអេឡា ប្រទេស ភាគ ច្រើន ព្រមទាំង សហភាព អឺរ៉ុប បាន គាំទ្រ រូប លោក ត្រឹម ជា មេ បក្ស ប្រឆាំង នាំមុខ មួយ រូប ប៉ុណ្ណោះ ៕
ស្អែក នេះ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នឹង ធ្វើ សន្និសីទ ព័ត៌មាន ពី « វឌ្ឍនភាព មូលដ្ឋាន ឃុំ សង្កាត់ និង ទិសដៅ ការងារ បន្ត របស់ ខេត្ត កំពង់ឆ្នាំង »
( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២២ ស្អែក នេះ នឹង រៀបចំ សន្និសីទ សារព័ត៌មាន ស្តីពី « វឌ្ឍនភាព មូលដ្ឋាន ឃុំ សង្កាត់ និង ទិសដៅ ការងារ បន្ត របស់ ខេត្ត កំពង់ឆ្នាំង » ។
សន្និសីទ សារព័ត៌មាន នេះ ប្រព្រឹត្ត ឡើង ក្នុង គោលបំណង បំផុស និង បង្ហាញ ជាសាធារណៈ នូវ យន្តការ ប្រជាធិបតេយ្យ ថ្នាក់ ក្រោម ជាតិ ជា ប្រវត្តិសាស្ត្រ របស់ កម្ពុជា និង ផ្សព្វផ្សាយ ពី សមិទ្ធផល ដែល ថ្នាក់ មូលដ្ឋាន ខិតខំ ប្រឹងប្រែង បំពេញ ការងារ សម្រេចបាន ក្នុង កិច្ច រក្សា បាន នូវ ការជឿទុកចិត្ត ចូលរួម និង គាំទ្រ ទាំងស្រុង លើ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ៕ សាខា កាកបាទ ក្រហម ខេត្ត កណ្តាល រៀបចំ កិច្ចប្រជុំ ពិភាក្សា ស្តីពី ផែនការអភិវឌ្ឍ សាខា តាម យុទ្ធសាស្ត្រ ២០២១ - ២០៣០
កិច្ចប្រជុំ នេះ មាន ការអញ្ជេីញ ជា អធិបតី ពី លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា និង អញ្ជើញ ចូលរួម ពី លោក គង់ សោភ័ណ្ឌ ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល ព្រមទាំង សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា មន្ត្រី ប្រតិបត្តិ សាខា និង មន្ត្រី បច្ចេកទេស ពី ទីស្នាក់ការ កណ្តាល សរុប ចំនួន ២០ នាក់ ដែល កិច្ចប្រជុំ នេះ ប្រព្រឹត្តទៅ នៅ ស្នាក់ការសាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល ។
ក្នុង ឱកាស នៃ កិច្ចប្រជុំ នោះ លោកស្រី អគ្គ លេខាធិការ រង ទី១ បាន ពាំនាំ ការផ្តាំផ្ញើ សួរសុខទុក្ខ និង កោតសរសើរ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ចំពោះ គណៈ កិត្តិយស គណៈកម្មាធិការ និង ក្រុម ប្រតិបត្តិ សាខា អនុសាខា ក្រុម កាកបាទ ក្រហម កម្ពុជា តាម ឃុំ និង អ្នកស្ម័គ្រចិត្ត យុវជន កាកបាទ ក្រហម កម្ពុជា នៃ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កណ្តាល ដែល បាន និង កំពុង បំពេញ សកម្មភាព មនុស្សធម៌ ទទួលបាន លទ្ធផល គួរ ជា ទី មោទនៈ ។
ចំណាត់ការ នេះ គឺ បន្ថែម លើ សញ្ញា ជាច្រើន ដែល ថា លោក ខាងលិច កំពុង រៀបចំ សម្រាប់ សកម្មភាព ឈ្លានពាន របស់ រុស្ស៊ី ប្រឆាំង នឹង អ៊ុយក្រែន ទោះបីជា ទីក្រុង ម៉ូស្គូ បាន បដិសេធ ម្តង ហើយ ម្តង ទៀត ចំពោះ គម្រោង ឈ្លានពាន ណាមួយ ក៏ដោយ ។
ក្នុង របាយការណ៍ ថ្ងៃចន្ទ នេះ ដែរ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ កូវីដ១៩ ចំនួន ១៦៥ នាក់ បន្ថែម ទៀត ផងដែរ ។
សាជីវកម្ម ធានា ឥណទាន កម្ពុជា និង ស្ថាប័ន ចំនួន ២ទៀត រួមគ្នា ជំរុញ ការវិនិយោគ លើ បច្ចេកវិទ្យា ជីវ ឧស្ម័ន ខ្នាត ធំ នៅ កម្ពុជា
ក្រោម ក្របខណ្ឌ នៃ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា នេះ ភាគី ទាំង ពីរ បាន ឯកភាព លើ គោលបំណង រួមគ្នា ដើម្បី កំណត់ កាលានុវត្តភាព សម្រាប់ សកម្មភាព សហការ និង កម្មវិធី នានា ដើម្បី ជួយ លើកកម្ពស់ បច្ចេកវិទ្យា ជីវ ឧស្ម័ន និង ជំរុញ ការវិនិយោគ តាមរយៈ យន្តការ ចែករំលែក ហានិភ័យ ដែល សមស្រប និង ដើម្បី ទាញ ផលប្រយោជន៍ ពី ការសហការ ដែល បាន កំណត់ នេះ ដើម្បី ផ្សារ ភ្ជាប់ គម្លាត ចំណេះដឹង នៃ ខ្សែ ច្រវាក់ តម្លៃ ជីវ ឧស្ម័ន ក្នុង ចំណោម ដៃ គូ សហការ និង ភាគី ពាក់ព័ន្ធ ។
កិច្ចសហប្រតិបត្តិការ បែប នេះ នឹង ផ្តល់ លទ្ធភាព ឲ្យ កសិករ សហគមន៍ ជនបទ និង កសិធុរកិច្ច ធ្វើ ឲ្យ ជីវភាព កាន់តែ ប្រសើរឡើង និង បង្កើន ផលចំណេញ ពី ធុរកិច្ច របស់ ខ្លូន ប្រកបដោយ ប្រសិទ្ធិភាព និង ចីរភាព ។
តំណាង ឲ្យ CGCC បន្ដ ថា « ដោយសារ វិស័យ កសិកម្ម គឺជា ប្រភព ដ៏ ធំ បំផុត ទី2 នៃ ការបំភាយ ឧស្ម័ន ផ្ទះ កញ្ចក់ (GHG) វា នឹង បណ្តាលឲ្យ មាន ការប្រែប្រួល អាកាសធាតុ ដូចជា ភ្លៀង មូសុង បន្តបន្ទាប់ និង សីតុណ្ហភាព កាន់តែ ខ្ពស់ ដែល នឹង មាន ផល ប៉ះពាល់ អវិជ្ជមាន លើ វិស័យ នេះ ដូច្នេះហើយ ការកាត់បន្ថយ ការប្រែប្រួល អាកាសធាតុ គឺ មាន សារៈសំខាន់ ណាស់ សម្រាប់ និរន្តរភាព នៃ ឧស្សាហកម្ម កែច្នៃ កសិផល និង វិស័យ ចញ្ចឹម សត្វ » ។
« បន្ថែម ពីលើ ភាពជាដៃគូ យុទ្ធសាស្ត្រ របស់ យើង ជាមួយ ធនាគារ ពាណិជ្ជកម្ម យើង មាន កិត្តិយស ដែល មាន ឱកាស សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ CGCC ដែល ជា ស្ថាប័ន ធានា ឥណទាន នៅក្រោម ការគ្រប់គ្រង របស់ រដ្ឋាភិបាល ដើម្បី ផ្តល់ នូវ ដំណោះស្រាយ ហិរញ្ញវត្ថុ ប្រកបដោយ ភាពច្នៃប្រឌិត ក្នុង ការគាំទ្រ ដល់ ការអភិវឌ្ឍ និង ប្រើប្រាស់ បច្ចេកវិទ្យា ជីវ ឧស្ម័ន សម្រាប់ កសិធុរកិច្ច » ។ នេះ បើ តាម ការលើកឡើង របស់ លោក ឡោ លី តួ នាយក BTIC ។
លោក បាន ពន្យល់ បន្ថែម ថា «MOU នេះ នឹង អនុញ្ញាតឲ្យ តួអង្គ សំខាន់ ៗ ទាំងអស់ រួមទាំង BTIC. CGCC និង ដៃគូ ធនាគារ របស់ ខ្លួន ក៏ ដូចជា ភាគី ពាក់ព័ន្ធ ផ្សេង ទៀត ធ្វើ ការរួមគ្នា យ៉ាង ជិតស្និទ្ធ និង មាន ប្រសិទ្ធភាព ជាង មុន លើ ការងារ អាទិភាព សំខាន់ ៗ មួយចំនួន ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ ក សិធុរកិច្ច កម្ពុជា ក្នុង ការទទួលយក បច្ចេកវិទ្យ ជីវឧស្ម័ន នេះ ដើម្បី ដោះស្រាយ បញ្ហា គ្រប់គ្រង កាកសំណល់ ប្រកបដោយ ប្រសិទ្ធភាព » ។
លោក បាន បន្ត ថា « យើង ជឿជាក់ ថា ភាពជាដៃគូ នេះ នឹង ជំរុញ កំណើន រយៈពេល វែង ក្នុង វិស័យ ផលិតកម្ម សត្វ និង ការកែច្នៃ កសិផល តាមរយៈ ការលើកកម្ពស់ ថាមពល កកើត ឡើង វិញ និង ការគ្រប់គ្រង កាកសំណល់ ឲ្យបាន ត្រឹមត្រូវ ក៏ ដូចជា រួមចំណែក ដល់ ការប្តេជ្ញាចិត្ត របស់ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ការប្រែប្រួល អាកាសធាតុ » ។
លោក សុខ ណារិន តំណាង ប្រចាំ ប្រទេស នៃ អង្គការ UNIDO ប្រចាំ ប្រទេស កម្ពុជា បាន បញ្ជាក់ ពី សារៈសំខាន់ នៃ កិច្ចសហការ ក្នុង ការចូលរួមចំណែក ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង កន្លងមក ក្នុង ការអភិវឌ្ឍ បរិយាកាស អំណោយផល សម្រាប់ ការវិនិយោគ ដើម្បី ដោះស្រាយ បញ្ហា ប្រឈម ផ្នែក ហិរញ្ញវត្ថុ ដែល វិនិយោគិន ជួបប្រទះ ក្នុង ការវិនិយោគ លើ គម្រោង ជីវឧស្ម័ន ខ្នាត ធំ ។
លោក ថា « ខ្ញុំ រីករាយ ដែល CGCC កំពុង បង្ហាញ ថា វិស័យ ហិរញ្ញវត្ថុ របស់ យើង មាន ឆន្ទៈ ក្នុង ការសិក្សា សម្រប ខ្លួន និង មាន ភាពបត់បែន ជាង មុន ។ ភាព ច្នៃប្រឌិត ក្នុង ការបង្កើត យន្តការ ហិរញ្ញប្បទាន ពិតជា មាន សារសំខាន់ ណាស់ ក្នុង ការគាំទ្រ ការងារ អភិវឌ្ឍន៍ ជាច្រើន ។
ភាព ច្នៃប្រឌិត នៃ យន្តការ ហិរញ្ញប្បទាន នេះ នឹង ជំរុញ ឲ្យ មាន ការវិនិយោគ បន្ថែម ទៀត លើ បច្ចេកវិទ្យា ជីវ ឧស្ម័ន ខ្នាត ធំ ក្នុង កសិធុរកិច្ច ដែល ជា របកគំហើញ ដ៏ សំខាន់ សម្រាប់ អ្នក វិនិយោគ ក្នុង ការទទួលយក និង អនុវត្ត បច្ចេកវិទ្យា ថាមពល កកើត ឡើងវិញ ទៅក្នុង ការអនុវត្ត អាជីវកម្ម របស់ ពួកគេ ។ ការវិនិយោគ លើ ថាមពល ស្អាត ប្រភេទ នេះ នឹង បង្កើត ផល ប្រយោជន៍ ផ្នែក សេដ្ឋកិច្ច បរិស្ថាន និង សង្គម ជាច្រើន ដល់ អ្នកប្រើប្រាស់ ម្ចាស់ កសិដ្ឋាន អ្នក វិនិយោគ និង សង្គម ។
អនុស្សរណៈ យោគយល់ នេះ គឺ ស្រប គ្នា ទៅនឹង កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ក្នុង ការធ្វើ បច្ចុប្បន្នភាព នៃ គោល នយោបាយ ជីវ ឧស្ម័ន សម្រាប់ ឆ្នាំ ២០២១ - ២០៣០ ក៏ ដូចជា គោលបំណង ជាច្រើន ទៀត ដែល រាជ រដ្ឋាភិបាល បាន កំណត់ នៅក្នុង កម្មវិធី ដើម្បី ភាព ជាដៃគូ ប្រទេស (PCP) របស់ អង្គការ UNIDO ក្នុង ការលើកកម្ពស់ វិស័យ ថាមពល ប្រកបដោយ និរន្តរភាព និង សេដ្ឋកិច្ច វិល ជុំ ៕
បណ្ឌិត ហ៊ុន ម៉ាណែត ផ្តល់ កុំព្យូទ័រ យួរ ដៃ ម្នាក់ មួយ គ្រឿង ដល់ សិស្ស និទ្ទេស A ទាំង ៥៤ នាក់ ក្នុង ខេត្ត ត្បូងឃ្មុំ
នេះ ជា ការលើកទឹកចិត្ត ដល់ សិស្សានុសិស្ស ដែល ខិតខំ សិក្សា ប្រលង ជាប់ ទទួលបាន និទ្ទេស ល្អ ក្នុង ចំណោម សិស្ស ដែល ប្រលង ជាប់ ជាស្ថាពរ សរុប ២៩៤៤ នាក់ ក្នុង ខេត្ត ត្បូងឃ្មុំ ទាំងមូល បើ ទោះបីជា ស្ថិត ក្នុង ការលំបាក សិក្សា រៀនសូត្រ ក្នុង បរិបទ ឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ជា សកល នេះ ។
ក្នុង ឱកាស សំណេះសំណាល ផ្តល់ រង្វាន់ និង ថវិកា លើកទឹកចិត្ត នា ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នៅ សាលា ខេត្ត ត្បូងឃ្មុំ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ ក៏ បាន ចែក ថវិកា ដល់ លោកគ្រូ អ្នកគ្រូ និង អាណាព្យាបាល សិស្ស ដែល ខិតខំ បង្ហាត់ បង្រៀន អប់រំ ទូន្មាន ណែនាំ រហូត ទទួលបាន លទ្ធផល ផ្លែ ផ្កា ដ៏ ល្អ នា ពេលនេះ ផងដែរ ។
ជាមួយនឹង ការជួប សំណេះសំណាល និង ផ្តល់ រង្វាន់ លើកទឹកចិត្ត នេះ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ គូសបញ្ជាក់ ថា យុវជន សម័យ តេជោ ពិតជា មាន សំណាង ដែល មាន ឱកាស សិក្សា រៀនសូត្រ យ៉ាង ទូលំទូលាយ ដើម្បី យក ចំណេះដឹង ទៅ អភិវឌ្ឍ ខ្លួន ឯង គ្រួសារ និង សង្គមជាតិ ទាំងមូល ។
លោក បន្ត ថា ដោយ អនុវត្ត តាម គោល នយោបាយ ឈ្នះ ឈ្នះ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ បាន ធ្វើឲ្យ កម្ពុជា មាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ទើប ប្រជាពលរដ្ឋ មាន ឱកាស គ្រប់ បែបយ៉ាង ក្នុង ការរស់នៅ ប្រកបរបរ ទទួលទាន ចិញ្ចឹម ជីវិត ពិសេស គឺ មាន ឱកាស ឲ្យ កូន ៗ ដែល ជា ទំពាំង ស្នង ឫស្សី បាន រៀនសូត្រ និង ឱកាស ការងារ យ៉ាង ច្រើន រង់ចាំ ពួកគាត់ ទៅ បំពេញ ។
ACU កោះហៅ មនុស្ស ១១នាក់ ករណី ក្លែង បន្លំ ឯកសារ សាធារណៈ និង ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង ពាក់ព័ន្ធ នឹង កោះ រ៉ុង
( ភ្នំពេញ ) ៖ អង្គភាព ប្រឆាំង អំពើពុករលួយ (ACU) បាន ចេញ លិខិត ជាថ្មី កោះហៅ បុគ្គល ១១រូប ឱ្យ ចូល ខ្លួន នៅ ថ្ងៃទី ៧ ខែកុម្ភៈ ឆ្នាំ ២០២២ ខាងមុខ នេះ ដើម្បី បំភ្លឺ ជុំវិញ អំពើ ក្លែង បន្លំ ឯកសារ សាធារណៈ និង ប្រើប្រាស់ ឯកសារ សាធារណៈ ក្លែង . អំពើ សម គំនិត ក្នុង ការក្លែងបន្លំ ឯកសារ សាធារណៈ និង អំពើ ប្រឆាំង នឹង អ្នក រាជការ សាធារណៈ មាន ស្ថាន ទម្ងន់ ទោស ពាក់ព័ន្ធ នឹង កោះ រ៉ុង ខេត្ត ព្រះសីហនុ ។
កន្លងមក អង្គភាព ប្រឆាំង អំពើពុករលួយ ធ្លាប់ បាន ចេញ លិខិត កោះហៅ បុគ្គល ចំនួន ១១រូប នេះ ឱ្យ ចូលខ្លួន បំភ្លឺ នៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ កាលពី ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២១ ម្តង រួចទៅហើយ ។ ប៉ុន្តែ ដោយ មូលហេតុ សាមីខ្លួន បាន ព្យាយាម គេចវេស ពី លំនៅឋាន និង មិន បាន ទទួល លិខិត កោះហៅ នេះ ដូចនេះ អង្គភាព ប្រឆាំង អំពើពុករលួយ ក៏ បាន ចេញ លិខិត កោះហៅ ពួកគេ ជាថ្មី ទៀត ។
ជាមួយនឹង ការកោះហៅ ជាថ្មី នេះ ACU បាន ព្រមាន ថា ក្នុង ករណី ដែល សាមីខ្លួន នៅតែ គេចវេស មិន ចូលខ្លួន ឆ្លើយ បំភ្លឺ តាម កាលបរិច្ឆេទ ដែល បាន កំណត់ ក្នុង លិខិត កោះហៅ នេះ ទេ អង្គភាព ប្រឆាំង អំពើពុករលួយ នឹង ចេញ លិខិត បញ្ជា ឱ្យ ចូល ខ្លួន ដែល អនុញ្ញាតឱ្យ មន្រ្ដី នគរបាល យុត្តិធម៌ ប្រើប្រាស់ កម្លាំង សាធារណៈ ដើម្បី បង្ខំឱ្យ ចូល បង្ហាញ ខ្លួន ៕ ក្រសួង ចំនួន ៣ ចេញ ប្រកាស ពី ការជ្រើសរើស និង ការកំណត់ តួនាទី និង ភារកិច្ច របស់ ជំនួយការហិរញ្ញវត្ថុ រដ្ឋបាល ឃុំ សង្កាត់
( ភ្នំពេញ ) ៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . ក្រសួង មហាផ្ទៃ និង ក្រសួង មុខងារ សាធារណៈ បាន ចេញ ប្រកាស អន្ដរ ក្រសួង ស្ដីពី ការជ្រើសរើស និង ការកំណត់ តួនាទី និង ភារកិច្ច របស់ ជំនួយការហិរញ្ញវត្ថុ រដ្ឋបាល ឃុំ សង្កាត់ ។ នេះ បើ តាម ប្រកាស អន្ដរ ក្រសួង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ ៕
ខាងក្រោម នេះ ជា ប្រកាស អន្ដរ ក្រសួង ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖ បុត្រា សម្តេច ក្រុម ព្រះ ប្តេជ្ញា ធ្វើឲ្យ គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច ទទួល ការគាំទ្រ សារជាថ្មី ក្នុង ការបោះឆ្នោត នា ពេល ខាងមុខ
( កំពត ) ៖ ព្រះអង្គម្ចាស់ នរោត្តម ចក្រាវុធ ព្រះប្រធាន ស្តីទី គណបក្ស ហ៊្វុនស៊ិនប៉ិច មាន បន្ទូល ប្តេជ្ញា យ៉ាង មុះមុត ក្នុង ការការពារ ថែរក្សា គណបក្ស ឱ្យ គង់វង្ស ហើយ ព្រះអង្គ មាន ជំនឿ ថា គណបក្ស ហ៊្វុនស៊ិនប៉ិច នឹង ទទួលបាន គាំទ្រ សារជាថ្មី ក្នុង ការបោះឆ្នោត នា ពេល ខាងមុខ ។
ការប្រកាស នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ ក្នុង ឱកាស ដែល ព្រះអង្គម្ចាស់ យាង ចុះ ជួប សំណេះសំណាល ជាមួយ ថ្នាក់ដឹកនាំ ថ្នាក់ ខេត្ត ស្រុក ឃុំ នៅ ទីស្នាក់ការបក្ស ខេត្ត កំពត ក្នុង ឃុំ ព្រៃ ឃ្មុំ ស្រុក ទឹក ឈូ ខេត្ត កំពត ។ អម ព្រះដំណើរ នា ឱកាស នោះ ក៏ មាន ការអញ្ជើញ ពី អនុប្រធាន គណបក្ស ព្រមទាំង ថ្នាក់ដឹកនាំ ជាច្រើន រូប ផងដែរ ។
ព្រះអង្គម្ចាស់ ចក្រាវុធ បាន ប្រកាស ថា ទ្រង់ នឹង យាង ចុះ ទៅតាម បណ្ដា រាជធានី - ខេត្ត ផ្សេង ៗ ទៀត ដើម្បី ប្រមែប្រមូល អ្នក រាជានិយម និង អ្នកគាំទ្រ ឡើង ដើម្បី ធ្វើឱ្យ គណបក្ស ហ៊្វុនស៊ិនប៉ិច ក្លាយជា កម្លាំង ជាតិ ដ៏ រឹងមាំ ហើយ នឹង បន្ត ចូលរួម ថែរក្សា ការពារ សន្តិភាព ស្ថេរភាព នយោបាយ និង ការអភិវឌ្ឃន៍ ដែល ជា សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ។
លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល បាន ឱ្យ Fresh News ដឹង ថា វ៉ាក់សាំង ជា ជំនួយ របស់ ប៉ូឡូញ នឹង ដឹក មកដល់ ប្រទេស កម្ពុជា នៅ ល្ងាច ថ្ងៃអង្គារ ទី២៥ ខែមករា ឆ្នាំ ២០២២ ហើយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នឹង អញ្ជើញ ទទួល វ៉ាក់សាំង នោះ ដោយ ផ្ទាល់ នៅ ព្រលានយន្តហោះ ។
វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ គឺ ឱបករណ៍ ដ៏ ចាំបាច់ មួយ បន្ថែម ពីលើ វិធាន សុខាភិបាល ដើម្បី ប្រយុទ្ធ ប្រឆាំង ការរាត ត្បាត ជំងឺ កូវីដ១៩ និង ការពា អាយុជីវិត ប្រជាពលរដ្ឋ ពី ជំងឺ ឆ្លង សកល ក្នុង សតវត្សរ៍ ទី ២១ នេះ ។ សម្តេច តេជោ ហ៊ុន សែន អគ្គ មេបញ្ជាការ កំពូល លើ សមរភូមិ ជំងឺ កូវីដ១៩ បាន សម្រេច យក ការងារ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ គឺជា កិច្ចការ ដ៏ ចាំបាច់ បំផុត សម្រាប់ ការយកឈ្នះ លើស ត្រូវ ឥត ស្រមោល កូវីដ១៩ និង ការពារ អាយុជីវិត ប្រជាពលរដ្ឋ ។
មិន ត្រឹមតែ ប៉ុណ្ណឹង ទេ ប្រព័ន្ធ ថត បែប វៃ ឆ្លាត និង ផ្សាយ បន្ត ផ្ទាល់ តាម អនឡាញ ដែល សិក្សា ស្រាវជ្រាវ និង ផលិត ដោយ ក្រុមហ៊ុន ចិន បាន ផ្សារភ្ជាប់ ការថត គោលដៅ ចលនា ក្នុង ល្បឿន លឿន នៅនឹង កន្លែង ដល់ ការផលិត និង ដឹកនាំ ការផ្សាយ កម្មវិធី តាម អនឡាញ រហូតដល់ ការចូល ទស្សនា ព្រឹត្តិ ការ ប្រកួត កីឡា ដោយ មាន អន្តរកម្ម ដែល បាន នាំមក នូវ ការ ដក បទពិសោធន៍ ថ្មី ស្រឡាង ដល់ ទស្សនិកជន ។
( ភ្នំពេញ ) ៖ រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន៤ គ្រឿង ក្នុង គម្រោង ធ្វើឱ្យ ប្រសើរឡើង នូវ សមត្ថភាព ពន្លត់ អគ្គិភ័យ តាមរយៈ ការផ្តល់ រថយន្ត ពន្លត់ អគ្គិភ័យ ដែល ប្រើប្រាស់ រួច ត្រូវបាន ប្រគល់ជូន រដ្ឋបាល រាជធានី ភ្នំពេញ ក្រោម ហិរញ្ញប្បទាន ឥត សំណង របស់ រដ្ឋាភិបាល ជប៉ុន ( គម្រោង គូសាណូណិ) ។
ពិធី ប្រគល់ - ទទួល រថយន្ត ពន្លត់ អគ្គិភ័យ ប្រើប្រាស់ រួច ចំនួន ៤ គ្រឿង នេះ បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២២ នេះ ក្រោម វត្តមាន លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង លោក មិកា មិ ម៉ាសាហ៊ីរ៉ូ (MIKAMI MASAHIRO) ឯក អគ្គ រដ្ឋទូត វិសាមញ្ញ និង ពេញ សមត្ថភាព របស់ ប្រទេស ជប៉ុន ប្រចាំ នៅ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ការិយាល័យ កណ្តាល នគរបាល អាវុធ ជាតិ ផ្ទុះ និង អគ្គិភ័យ នៃ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ភូមិឡ កំបោ សង្កាត់ ស្វាយប៉ាក ខណ្ឌ ឬស្សីកែវ ។
លោក បន្ត ថា គ្រោះ អគ្គិភ័យ បាន បង្ក នូវ វិនាសកម្ម ធ្វើឱ្យ បាត់បង់ អាយុជីវិត ប្រជាពលរដ្ឋ និង ធ្វើឱ្យ ខូចខាត ទ្រព្យ សម្បត្តិ រដ្ឋ និង ឯកជន ជាច្រើន ហើយ ក្នុង ពេល ប្រតិបត្តិការ កងកម្លាំង ពន្លត់ អគ្គិភ័យ ក៏ បាន ជូប ប្រទៈ នូវ ភាពស្មុគស្មាញ ប្រឈម ទៅនឹង ការលំបាក ទាំង បច្ចេកទេស និង សមត្ថភាព ជំនាញ ឯកទេស ជាពិសេស ភាព ប្រថុយប្រថាន ខ្ពស់ ទៅនឹង គ្រោះថ្នាក់ ដល់ អាយុជីវិត ថែម ទៀត ផង ។
បើ ផ្អែក តាម របាយការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ នៅក្នុង ឆ្នាំ ២០២១ កន្លងទៅ នេះ សភាពការណ៍ គ្រោះ អគ្គិភ័យ នៅ រាជធានី ភ្នំពេញ បាន កើត មាន ឡើង ចំនួន ១៣០ លើក បណ្តាលឱ្យ មនុស្ស ស្លាប់ ចំនួន ១២ នាក់ . របួស ចំនួន ២៣ នាក់ និង បាន បណ្ដាលឱ្យ ខូចខាត ទ្រព្យ សម្បត្តិ ដូចជា ឆេះ ផ្ទះ ២៨ ខ្នង . ឃ្លាំង - រោច ក្រ ១០ កន្លែង . បន្ទប់ ស្នាក់ នៅ ៣៦ បន្ទប់ . រថយន្ត ៣៦ គ្រឿង . យានយន្ត គ្រឿងចក្រ និង សម្ភារៈ បរិក្ខារ មាន តម្លៃ ជាច្រើន ទៀត ។
លោក បន្ត ថា គម្រោង នេះ នឹង រួមចំណែក យ៉ាង សំខាន់ ក្នុង ការធ្វើឱ្យ ប្រសើរឡើង នូវ សុវត្ថិភាព និង ជួយ ការពារ ទ្រព្យសម្បត្តិ របស់ ប្រជាជន ដែល រស់ នៅក្នុង តំបន់ ព្រមទាំង ភ្ញៀវ ទេសចរ និង អ្នកជំនួញ ដែល ធ្វើដំណើរ មកពី ជុំវិញ ពិភពលោក ផងដែរ ៕
លោកស្រី អ៊ូ ធីតា ពៅ ភរិយា អភិបាល ខេត្ត ព្រះសីហនុ និង លោកស្រី ម៉ែន ចិន្តា ចូលរួម ដាំ ដើមឈើ សម្រាប់ ដាំលម្អ ក្នុង ទី បញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ លោកស្រី អ៊ូ ធីតា ពៅ ភរិយា លោក គួច ចំរើន អភិបាល ខេត្ត ព្រះសីហនុ និង លោកស្រី ម៉ែន ចិន្តា និង ស្វាមី នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមករា នេះ បាន អញ្ជើញ ចូលរួម ដាំ កូន ឈើ កូន ផ្កា លម្អ សួនច្បារ ក្នុង ទី បញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះសីហនុ និង ចុះ សួរសុខទុក្ខ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ដឹកនាំ ដោយ ឧត្តមសេនីយ៍ ត្រី នូវ សំអុល មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះសីហនុ ។
ក្នុង ឱកាស នោះ ដែរ លោកស្រី អ៊ូ ធីតា ពៅ បាន នាំយក ថវិកា និង បន្លែ ធម្មជាតិ ឧបត្ថម្ភ ផ្ទះ បាយ កងទ័ព ផងដែរ ។ ដោយឡែក ឧកញ៉ា ម៉ែន ចិន្តា បាន ឧបត្ថម្ភ កូន ឈើ និង កូន ផ្កា ចំនួន ជាង ១០០ គុម្ព សម្រាប់ ដាំលម្អ ក្នុង ទី បញ្ជាការ ជាពិសេស ខាងមុខ អគារ ទើប សាងសង់ ថ្មី ។
ឧត្តមសេនីយ៍ ត្រី នូវ សំអុល មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះសីហនុ បាន ផ្តាំផ្ញើ តាមរយៈ លោកស្រី អ៊ូ ធីតា ពៅ គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ លោក គួច ចំរើន ដែល តែងតែ យកចិត្តទុកដាក់ ផ្តល់ ទាំង សម្ភារ ថវិកា និង ស្មារតី ដល់ អង្គភាព តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះសីហនុ ។
លោក មេបញ្ជាការ ក៏ បាន គោរព ថ្លែងអំណរគុណ ដល់ លោកស្រី ម៉ែន ចិន្តា ដែល ផ្ដល់ អំណោយ កូន ឈើ និង កូន ផ្កា ជាច្រើន ដើម និង បាន នាំ សមាជិក គ្រួសារ មក ចូលរួម ដាំ កូន ឈើ កូន ផ្កា ជាមួយ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន យ៉ាង សប្បាយរីករាយ ៕
ចំណេះដឹង ទូទៅ៖ ប្រវត្តិ នៃ ការធ្វើ ពាណិជ្ជកម្ម អន្តរជាតិ
( ភ្នំពេញ ) ៖ ប្រវត្តិ នៃ ការធ្វើ ពាណិជ្ជកម្ម អន្តរជាតិ មាន ប្រវត្តិ ជា យូរ លង់ ណាស់ មកហើយ ខណៈ អ្នក ប្រវត្តិសាស្ត្រ បាន បង្ហាញ ថា វា បាន កើតឡើង ចាប់តាំងពី ពេល ដែល មនុស្ស ចេះ រស់ នៅ ជា កុលសម្ព័ន្ធ មក ម៉្លេះ ។ តើ ប្រវត្តិ នៃ ការធ្វើ ពាណិជ្ជកម្ម នេះ មាន ដំណើរ ដើមទង យ៉ាងណា ខ្លះ ?
បុរាណវិទូ បាន រកឃើញ ថា បណ្ដាញ ពាណិជ្ជកម្ម អន្តរជាតិ លើក ដំបូង នៅលើ ពិភពលោក បាន កើតមាន តាំងពី ប្រមាណ ៣៥០០ ឆ្នាំ មុន គ្រិស្ដ សករាជ មក ម្ល៉េះ ដោយ វា បាន លេចឡើង នៅ តំបន់ មេ សូប៉ូតាមី (Mesopotamia) ស្ថិត នៅ ប្រទេស អ៉ីរ៉ាក់ និង អ៉ីរ៉ង់ បច្ចុប្បន្ន ។ ចំណែក នៅ ប្រទេស ចិន បុរាណ ឯណោះ វិញ ការលេចឡើង នូវ បណ្ដាញ ផ្លូវ សូត្រ នា អំលុង ឆ្នាំ ២០០០ - ១០០០ មុន គ្រិស្ដ សករាជ ក៏ ត្រូវបាន គេ ចាត់ទុក ថា ជា បណ្ដាញ ពាណិជ្ជកម្ម អន្តរជាតិ ផងដែរ ។
នៅ ដើម គ្រិស្ដ សករាជ ក្នុង ពេល ដែល ឥទ្ធិពល ក្រិក បុរាណ មាន ភាព ថមថយ ពួក រ៉ូម៉ាំង ក៏ បាន កសាង ចក្រភព ដ៏ ធំ មួយ របស់ ខ្លួន ជាមួយនឹង ការពង្រីក ពាណិជ្ជកម្ម រហូតដល់ ទឹកដី ចក្រភព អង់គ្លេស សព្វ ថ្ងៃ និង តំបន់ ផ្សេង ទៀត នៅ អឺរ៉ុប ខាងជើង ប៉ុន្តែ នៅ ពេល ចក្រភព រ៉ូម ខាងលិច ដួលរលំ ទៅ ចរន្ត នៃ ការពាណិជ្ជកម្ម អន្តរជាតិ នៅ តំបន់ នេះ ក៏ បាន ធ្លាក់ចុះ ជាមួយគ្នា ផងដែរ ។
ចាប់ពី សតវត្ស ទី៥ - ១៥ ពាណិជ្ជករ អារ៉ាប់ បាន បន្ត ទំនៀមទម្លាប់ ពាណិជ្ជកម្ម អន្តរជាតិ ពី ពួក អឺរ៉ុប ដោយ ពួកគេ បាន បង្កើត បណ្ដាញ ពាណិជ្ជកម្ម យ៉ាង ធំ នៅ ជុំវិញ ឈូង សមុទ្រ ពែរ្ស តំបន់ អាហ្វ្រិក ឥណ្ឌា និង តំបន់ អាស៉ី អាគ្នេយ៍ ជា ហេតុ ធ្វើឱ្យ មាន ការរីកចម្រើន លើ វិស័យ ពាណិជ្ជកម្ម រវាង ប្រទេស ចិន ឥណ្ឌា ជ្វា ម៉ាឡេ ខ្មែរ ភូមា ចាម៉្បា ក្រោយមក ក៏ មាន សៀម និង យួន ទៀត ផងដែរ ។
ផុត ពី សម័យ អាណានិគម នេះ ទៅ ពិភពលោក ក៏ បាន ឈានដល់ សម័យ សង្គ្រាម លោក លើក ទី២ ឆ្នាំ ១៩៣៩ - ១៩៤៥ ។ ចាប់តាំងពី ពេល នោះ មក ពិភពលោក ក៏ បាន បង្កើត អង្គការ ពាណិជ្ជកម្ម ជា បន្តបន្ទាប់ ដើម្បី រៀបចំ ការធ្វើ ពាណិជ្ជកម្ម អន្តរជាតិ ឱ្យ មាន សណ្ដាប់ធ្នាប់ ឡើងវិញ ៕
សមិទ្ធផល គួរឱ្យ កត់សម្គាល់ នេះ បាន មក ដោយ មិន ងាយ នោះ ទេ ។ ក្នុង រយៈពេល ជាង ២ ឆ្នាំ ចុងក្រោយ នេះ សេដ្ឋកិច្ច ចិន បាន ទប់ទល់ ដោយ មាន ប្រសិទ្ធភាព នូវ កម្លាំង សម្ពាធ ដែល បណ្តាល មកពី ការរីករាលដាល នៃ ជំងឺ កូវីដ ១៩ ហើយ បាន បង្ហាញ ពី ភាពធន់ យ៉ាង ខ្លាំង ដែល បាន បញ្ជាក់ ថា និន្នាការ ល្អ ប្រសើរ ជាទូទៅ ក្នុង រយៈពេល យូរ មិន ផ្លាស់ប្ដូរ ឡើយ ។
សមិទ្ធផល អភិវឌ្ឍន៍ ដែល ចិន ទទួលបាន ក្នុង រយៈពេល មួយ ឆ្នាំ កន្លងមក សុទ្ធតែ បាន ពង្រឹង នូវ មូលដ្ឋានគ្រឹះ យ៉ាង រឹងមាំ ដើម្បី សម្រេច គោលដៅ នានា តាម ពេល កំណត់ ។ ដោយឡែក អាស្រ័យ លើ មូលដ្ឋានគ្រឹះ ដ៏ រឹងមាំ បែប នេះ និន្នាការ ដ៏ ល្អ ប្រសើរ ជាទូទៅ ក្នុង រយៈពេល យូរ របស់ សេដ្ឋកិច្ច ចិន មាន ភាព កាន់តែ ខ្លាំងក្លា ហើយ សមត្ថភាព ទប់ទល់ នឹង ការប្រឈម និង ហានិភ័យ គ្រប់ បែបយ៉ាង មាន ភាពជឿជាក់ កាន់តែ ប្រសើរឡើង ៗ ។
ឆ្នាំ ២០២២ ប្រទេស ចិន បាន ត្រៀមលក្ខណៈ រួចហើយ ។ យើង មុខ ជា នឹង ជំរុញ សេដ្ឋកិច្ច ចិន ឱ្យ ដណ្តើម បាន សិទ្ធិ ម្ចាស់ ការ ឧត្តមភាព និង អនាគត ដ៏ ភ្លឺស្វាង ក្នុង ការអភិវឌ្ឍ ប្រកបដោយ គុណភាព ខ្ពស់ ជាក់ ជា មិន ខាន ! ៕ (#CCFR Comment#) អភិបាល ខេត្ត ត្បូង ឃ្មុំ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត គឺជា កុលបុត្រ បន្ត វេន ពោរពេញ ដោយ សក្ដានុពល ទាំង ចំណេះដឹង សមត្ថភាព បទពិសោធន៍ ចំណេះ ធ្វើ និង គុណសម្បត្តិ គ្រប់គ្រាន់ ស័ក្តិសម បំផុត សម្រាប់ ដឹកនាំ ប្រទេស នា ពេល អនាគត
ការថ្លែង របស់ លោក អភិបាល ខេត្ត ត្បូងឃ្មុំ បែប នេះ ធ្វើឡើង នៅក្នុង ពិធី សំណេះសំណាល និង ប្រគល់ អំណោយ កុំព្យូទ័រ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ដល់ សិស្ស ដែល បាន ប្រឡង ជាប់ សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ និទ្ទេស A ចំនួន ៥៤ នាក់ ឆ្នាំ សិក្សា ២០២០ - ២០២១ នៅក្នុង ខេត្ត ត្បូងឃ្មុំ ។
( កំពង់ស្ពឺ ) ៖ លោក យឹម សុខុម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ១៤ ខែមករា ឆ្នាំ ២០២២ បាន សំណេះសំណាល ជាមួយ អ្នកគ្រូ លោកគ្រូ និង សិស្ស ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ដែល ទទួលបាន និទ្ទេស A ទាំង ៣៣ នាក់ ក្នុង ក្របខណ្ឌ ខេត្ត កំពង់ស្ពឺ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង ចូលរួម អបអរសាទរ ចំពោះ លទ្ធផល ដែល ក្មួយ ៗ ទទួលបាន នៅ ពលេនេះ ។
លោក នុប សុធន វិចិត្រ អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ឲ្យដឹង ថា « ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន លើក សំណើ គោរព ជូន សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី រួចហើយ ដើម្បី សុំ ពន្យារ ពេល ការអនុវត្ត ពន្ធ លើ ចំណេញ មូលធន គឺ ដើម្បី ចូលរួម អនុវត្ត ក្របខណ្ឌ យុទ្ធសាស្ត្រ និង កម្មវិធី ស្តារ និង ជំរុញ កំណើន សេដ្ឋកិច្ច កម្ពុជា ក្នុង ការរស់នៅ ជាមួយ កូវីដ - ១៩ តាម គន្លង ប្រក្រតី ភាព ថ្មី សម្រាប់ ឆ្នាំ ២០២១ - ២០២៣ ដើម្បី ជំរុញ ការវិនិយោគ និង ជួយ សម្រួល ជីវភាព របស់ ប្រជាពលរដ្ឋ » ។
ទន្ទឹម នេះ ទោះជា មាន វិបត្តិ នៃ ជំងឺ កូវីង - ១៩ អគ្គ នាយកដ្ឋាន ពន្ធដារ មិន បាន ដកថយ ពី កិច្ចការងារ កែទម្រង់ ដើម្បី លើកកម្ពស់ អនុលោម ភាព ការផ្តល់ សេវា សាធារណៈ និង ការប្រមូល ចំណូល ជា រួម ។
ពន្ធ លើ ចំណេញ មូលធន មាន វិសាលភាព កំណត់ យក លើ ចំណេញ មូលធន ចំពោះ តែ រូប វន្ត បុគ្គល និវា សន ជន និង អ្នក ជាប់ ពន្ធ អនិវា សន ជន ( ជា រូប វន្ត បុគ្គល ឬ នីតិបុគ្គល ដែល មិន មែន ជា អ្នក ជាប់ ពន្ធ និវា សន ជន ) តាម អត្រា ២០% នៃ ចំណេញ មូលធន ពោលគឺ ចំណេញ ដែល សម្រេចបាន ពី ការលក់ ឬ ផ្ទេរ មូលធន ៦ ប្រភេទ រួម មាន៖ អចលន ទ្រព្យ ភតិសន្យា ទ្រព្យ វិនិយោគ កេរ្តិ៍ឈ្មោះ អាជីវកម្ម កម្មសិទ្ធិ បញ្ញា និង រូបិយវត្ថុ បរទេស ។
រីឯ នីតិបុគ្គល និវា សន ជន ដែល បាន ចុះបញ្ជី ពន្ធដារ និង ប្រកាស បង់ ពន្ធ លើ ប្រាក់ ចំណូល ប្រចាំ ឆ្នាំ រួចរាល់ មិន មានបន្ទុក ពន្ធ នេះ បន្ថែម ទៀត ទេ ។ ពន្ធ លើ ចំណេញ មូលធន ប្រមូល លើ ចំណេញ មូលធន ដែល សម្រេចបាន នៅពេល មាន ប្រតិបត្តិការ លក់ ឬ ផ្ទេរ មូលធន ដែល មាន ចំណេញ ប៉ុណ្ណោះ ក្នុង ករណី មិន មាន ចំណេញ គឺ មិន មាន កាតព្វកិច្ច បង់ ពន្ធ នេះ ទេ ។
សូម ជម្រាប ថា អគ្គ នាយកដ្ឋាន ពន្ធដារ នៃ ក្រសួង សេដ្ឋកិច្ច បាន កំណត់ ថា ការប្រមូល ចំណូល ពន្ធ លើ ពន្ធ ចំណេញ មូលធន ត្រូវ ចាប់ផ្តើម អនុវត្តន៍ ចាប់ពី ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២២ត ទៅ បន្ទាប់ពី ពន្ធ នេះ ត្រូវបាន ពន្យារ ពេល អនុវត្តន៍ រយៈពេល ១ ឆ្នាំ កន្លងមក ។ ប៉ុន្តែ ពេលនេះ អាចនឹង បន្ត ពន្យារ ពេល ២ឆ្នាំ ទៀត ដែល អាចនឹង ចាប់ផ្តើម នៅ ថ្ងៃទី១ ខែមករា ឆ្នាំ ២០២៤ត ទៅ ៕
ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ១៣នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ៨. ១០០ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
( កំពត ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ស្នើ ក៏ ដូចជា សំណូមពរ ដល់ សមាជិក សមាជិកា ( ស.ស .យ .ក ) ទាំងអស់ ត្រូវតែ យកចិត្តទុកដាក់ អភិវឌ្ឍ សមត្ថភាព របស់ ខ្លួន បន្ថែម ទៀត ឱ្យ អស់ លទ្ធភាព ដើម្បី ចូលរួម ចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ការខិតខំ រៀនសូត្រ ធ្វើ គំរូល្អ និង ដំណើរ ជោគជ័យ របស់ ថ្នាក់ដឹកនាំ ទាំង ការ គិត និង ការអនុវត្ត ការងារ ។
ការស្នើ និង សំណូមពរ ដូចនេះ ខណៈ លោក ហ៊ុន ម៉ានី លោក ជឹង ផល្លា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ម៉ៅ ធ និន អភិបាល ខេត្ត កំពត ធ្វើជា អធិបតី ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ គណៈកម្មាធិការ ឃុំ - សង្កាត់ ក្រុង - ស្រុក ខេត្ត ក្នុង រចនាសម្ព័ន្ធ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ( ស.ស .យ .ក ) ខេត្ត កំពត នា ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២២ នៅ សាល ប្រជុំ សាលា ខេត្ត កំពត ។
លោក ហ៊ុន ម៉ានី បាន បន្ត ថា ក្នុង នាម យុវជន ជា អ្នក បន្ត វេន ត្រូវ មាន ភារកិច្ច ថែទាំ និង ទទួលខុសត្រូវ ចំពោះ ជោគវាសនា អនាគត របស់ ប្រទេសជាតិ ដោយ មិន ត្រឹមតែ ធ្វើ សកម្មភាព ជួយ លើ ការងារ សង្គម និង ការងារ មនុស្សធម៌ តែ ប៉ុណ្ណោះ ទេ ។
ជាមួយគ្នា នេះ ដែរ លោក ហ៊ុន ម៉ានី ក៏ បាន ធ្វើការកត់សម្គាល់ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ការងារ ដែល ស .ស .យ .ក . ខេត្ត កំពត បាន សហការ ល្អ ជាមួយនឹង អាជ្ញាធរ គ្រប់ ជាន់ ថ្នាក់ ក្នុង ខេត្ត ដើម្បី បម្រើ ការងារ សង្គម និង មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន បាន ល្អ ប្រសើរ នា រយៈពេល កន្លងមក ។
សកម្មភាព ទាំងអស់ របស់ សមាជិក សមាជិកា ( ស.ស .យ .ក ) គឺ កើត ចេញពី ការលះបង់ របស់ សមាជិក សមាជិកា នៅ ទូទាំង ប្រទេស ហើយ ត្រូវបាន ទទួលស្គាល់ ពីសំណាក់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន និង សាធារណជន ដោយ បាន ផ្សារ ភា្ជប់ ស្លាកសញ្ញា នៃ ស្ថាប័ន និង ឯកសណ្ឋាន ( ស.ស .យ .ក ) ទៅនឹង សកម្មភាព ល្អ ៗ និង ភាពវិជ្ជមាន សម្រាប់ សង្គម ។
* ត្រូវ លាង ដៃ ឱ្យ បាន ញឹកញាប់ ជាមួយ សាប៊ូ និង ទឹក ស្អាត ឱ្យ បាន ញឹកញាប់ បន្ទាប់ពី ការប៉ះពាល់ សត្វ បោច សំអាត សត្វ បសុបក្សី ឬ វត្ថុ ផ្សេង ៗ ដែល អាច ជា ប្រភព ចម្លង រោគ ព្រមទាំង ប្រកាន់ខ្ជាប់ នូវ ការអនុវត្តន៍ អនាម័យ និង ចំណីអាហារ ដែល មាន សុវត្ថិភាព ល្អ និង ចម្អិន ម្ហូប អាហារ ឱ្យ បាន ឆ្អិន ល្អ មុននឹង បរិភោគ ។
* គួរ ត្រូវ ជៀសវាង ការចូលទៅ កន្លែង ចិញ្ចឹម សត្វ ( បើ គ្មាន ភារកិច្ច ឬ ប៉ះពាល់ ផ្ទាល់ ជាមួយ សត្វ នៅ តាម កសិដ្ឋាន ចិញ្ចឹម សត្វ និង ទីផ្សារ បក្សី រស់ ឬ ចូល កន្លែង សត្តឃាត ឬ ប៉ះពាល់ ជាមួយ ផ្ទៃ ណាមួយ ដែល កខ្វក់ ឬ ប្រឡាក់ ដោយ លាមក សត្វ បសុបក្សី ឬ សត្វ ដទៃ ទៀត ។
* ជៀសវាង ប្រជ្រៀត គ្នា នៅពេល ទិញ ម្ហូប អាហារ ទិញ សាច់ ឬ បក្សី រស់ ឬ សម្ភារៈ នានា ជាពិសេស ត្រូវ ចេះ ត្រៀមលក្ខណៈ ទុក ជាមុន ពី ចម្ងាយ ជៀសវាង ការកកស្ទះ ឬ ការកកកុញ មនុស្ស ច្រើន នៅ តាម ទីផ្សារ ឬ ហាង នៅក្នុង ថ្ងៃ តែ មួយ ឬ ក្នុង ថ្ងៃ នៃ ពិធី នានា ជាដើម ។
