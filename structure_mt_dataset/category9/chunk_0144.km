ជនជាតិ ជប៉ុន មិន ស្ថិត នៅក្រោម បំរាម នេះ ទេ ។
លោកស្រី ស្ទុះ ចេញ ទៅ បើក ទ្វារ ផ្ទះ ស្រាប់តែ លេច រូប បុរស បារាំង ម្នាក់ រាង ទាប ធាត់ នៅ ចំពោះមុខ ។
ការប្រើ ពាក្យ ច្បាស់លាស់ អ្នកអាន អាច យល់ ដល់ គោល គំនិត និង ចរិត លក្ខណៈ របស់ អ្នក សរសេរ បាន ដោយ ងាយ ពុំ បាច់ មាន ការពន្យល់ ច្រើន ។
ប៉ុន្តែ ទោះជា យ៉ាងណា ការជ្រើសរើស ទិញ ខុនដូ មិន ថា ជាន់ ណាល្អ នោះ ទេ គឺ ផ្អែក ទៅ លើ ជំនឿ និង ប្រាក់ ក្នុង ហោប៉ៅ របស់ បុគ្គល ម្នាក់ ៗ
កែច្នៃ គីមី កោត
សូម្បីតែ អ្នកម្តាយ ដែល ទទួលទាន គ្រឿងស្រវឹង ក៏ អាច ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភាព របស់ ទារក ដែរ ។
ខ្ញុំ មិន ពេញចិត្ត នឹង សកម្មភាព ជប៉ុន ដើរ លក់ នុយក្លេអ៊ែរ នៅ បរទេស ទេ !
ហាក់ដូចជា ការបង្ហាញ ខ្លួន លើក ចុងក្រោយ របស់ ពួកគេ អញ្ចឹង ។
ក្រុមការងារ តចរន្ត អគ្គិសនី តាម បន្ទប់ ជួល ឈប់ សម្រាក ១០ ថ្ងៃ
មញុំ បាន ទាក់ទង សាកលវិទ៉ល័យ មួយចំ
អង្គរក ម្វុជ ទេឝ
រហូតមកដល់ សព្វ ថ្ងៃ - កម្សាន្ត
ចាងហ្វាង គេហទំព័រ ៤នាក់ ក្លាយជា អ្នកទោស …
បន្ទាប់មក នៅ រឹម ម្ខាង គេ រុំ ភ្ជាប់ ដង ឈើ មួយ ដើម្បី ស្រួល បើក មើល អក្សរ ខាងក្នុង ។
មនុស្ស ម្នាក់ អាច រីករាយ ទៅ បាន ព្រោះ គេ ពេញចិត្ត នូវ អ្វី ដែល គេ មាន ។
ចុច ប៊ូតុង ទិញ នៅ ជ្រុង កំពូល ខាងឆ្វេង ។
ខ្ញុំ បាន ឃើញ ដោយ ផ្ទាល់ គឺ មាន បុគ្គលិក ខ្មែរ ធ្វើការ នៅក្នុង ហ្នឹង ដែរ ។
ហើយ កីឡាករ ភាគ ច្រើន មក ពី យុវជន ថ្នាល សាលា បាល់ទាត់ ជាតិ ។
សៀវភៅ ភូមិ ខ្ញុំ
សម្តេច តេជោ តើ កម្ពុជា មាន ការចាំបាច់ រំលោភ រដ្ឋធម្មនុញ្ញ ខ្លួន …
ឧបត្ថម្ភ ដោយ ប្លក , រូបភាព
គេ រំពឹង ថា គាត់ អាចនឹង ចេញ ពី មន្ទីរពេទ្យ ក្នុង រយៈពេល ប្រហែលជា ២ខែ ខាងមុខ ។
យើង មាន កាតព្វកិច្ច ត្រូវ កម្ចាត់ ហានិភ័យ ទាំងនេះ សម្រាប់ អាមេរិក ។
តើ អំឡុង ពេល មាន ផ្ទៃពោះ សុដន់ មាន ការប្រែប្រួល ដូចម្តេច ខ្លះ ?
ដើម្បី ស្ទូច ត្រី បាន គេ ត្រូវការ អ្វី ខ្លះ ?
ជំរុញ យ៉ាង ខ្លាំង កិច្ចការ ឃោសនា ការ ទូត សំដៅ ឆ្លៀត យក ឱ្យ បាន អតិបរមា នូវ ការគាំទ្រ របស់ មិត្តភក្តិ អន្តរជាតិ ផងដែរ ៕
ពូកែ បាន តែ បាញ់ សម្លាប់ ប្រជាពលរដ្ឋ របស់ ខ្លួន តែ ប៉ុណ្ណោះ !
ជាទូទៅ ប្រាក់ ចំណូល បាន ពី ការងារ ទាំង នេះ គួរតែ ត្រូវបាន ដាល់ ចូលក្នុង គណនី ធនាគារ ច្បាស់លាស់ ប៉ុន្តែ តើ អ្នក មាន ធនាគារ ក្នុង ចិត្ត ឬ នៅ ?
ប្រទេស ទាំង ៥មាន ប្រជាជន ចូលចិត្ត មើល គេហទំព័រ សិច ច្រើន ជាង គេ បំផុត
ប្អូន កុមារ កាម ទេព
តែង មាន ចិត្ត ស្រវា ស្រទេញ រក គ្រាប់ ចូល ទី ដូច្នេះ គេ នឹង នៅ ជាមួយ យើង រយៈពេល ៥ឆ្នាំ ទៀត ។
វីអូឌី មិន ទាន់ អាច សុំ ការបញ្ជាក់ បន្ថែម ពី លោក ប៉ែន ចំរ៉ុង បាន នៅឡើយ ទេ ។
៣កុំ នឹកស្មាន ថា ល្អ នឹង យើង
ក្រុម តាលី បង់ អះអាង ថា ខ្លួន ជា អ្នកទទួលខុសត្រូវ លើ ការវាយប្រហារ នេះ ។
ត្រាំ បង្ក ការបែកបាក់ ច្រើន ណាស់
ខេត្ត ស្រែគង្គ មាន ស្រុក
តំណាង សហជីព ដាក់ ញត្តិ នៅ ក្រសួង ការងារ ពី ថ្ងៃចន្ទ ។
មកពី បាតុកម្ម ភ្លាម ព្រលះ ហ៊ុន សែន ខ្លាំង ៗ
ជា បន្ថែម ទៀត ដូចជា ៖
នេះ ៥វិធី ការពារ ខ្លួន កុំ ឱ្យ ផ្តាសាយ ក្នុង រដូវ រងា
ច្រើន ក្នុង ជីវិត រមែង ទទួលបាន ផល ល្អ ដល់ សុខភាពល្អ ។
សំឡេង នោះ ឮ កាន់តែ ច្បាស់ ឡើង ៗ
មាន ប្រទេស ជប៉ុន បារាំង ហូឡង់ និង ប្រទេស អាមេរិក ផងដែរ ៕
ប៉ុន្តែ អ្នក ទាំងនោះ មិន មាន សិទ្ធិ ក្នុង ការធ្វើ សេចក្តីសម្រេច ឬ ពុំ ទទួល ការទុកចិត្ត ពី ថ្នាក់ លើ ហើយ មតិ យោបល់ របស់ ពួកគាត់ មិន ត្រូវបាន ទទួលស្គាល់ ។
យោង តាម សិទ្ធិ ការងារ ការធ្វើ ការ ថែម ម៉ោង ជា សិទ្ធិ របស់ កម្មករ ក្នុង ការសម្រេចចិត្ត ថា ធ្វើ ឬ មិន ធ្វើ រោងចក្រ គ្មាន សិទ្ធិ បង្ខំ នោះ ទេ ។
អីចឹង គេ អត់ ហ៊ាន ចូលមក វិនិយោគ នៅក្នុង ស្រុក យើង ។
កងកម្លាំង របស់ យើង នា ពេល បច្ចុប្បន្ន នេះ បាន និង កំពុង ចង ក្រង នូវ បទឧក្រិដ្ឋកម្ម ទាំងនោះ ។
អង្គហេតុ វា កើតឡើង យ៉ាងម៉េច បើ យើង ដឹង នរណា ខុស នរណា ត្រូវ ហើយ អា ហ្នឹង ស្រួល ដោះស្រាយ ។
ពួកគេ នៅ ជាមួយគ្នា ដោយសារតែ ពួកគេ ស្រឡាញ់ គ្នា ហើយក៏ ត្រូវការ ចំណាយ ពេលវេលា នៅ ជាមួយគ្នា ឱ្យ កាន់តែ ច្រើន ដែរ ។
តាំងតែពី កាល នោះ មក គេ ក៏ បាន ប្រព្រឹត្ត នៅក្នុង ធម៌ ទាំង ៦ប្រការ នោះ ។
ទោះ យ៉ាងណា ពួក មេដឹកនាំ ប្រឆាំង បាន មាន ការប្រុងប្រយ័ត្ន ណាស់ ចំពោះ រឿង នេះ ដោយ មិន ទទួលយក ឬ បដិសេធ ត្រង់ ៗ
ក៏ កើនឡើង ទៅតាម នោះ ដែរ ។
លុះណាតែ មាន ការចូលរួម ពី អ្នកធ្វើដំណើរ គ្រប់ ៗ
មាតិការ ចក្ខុវិស័យ គិត ដូចជា សេដ្ឋ …
ក្នុង នោះ មាន ការ បង្ការ បង្ក្រាប សង្គ្រោះ ។
អង្គរ ធំ ឥឡូវ សិរី រ័ត្ន ដូចជា មានអារម្មណ៍ សប្បាយ ចិត្ត ណាស់ មាន ខាត់ ស្បែក ទេ បាន ជា សជាង មុន ?
ខ្ញុំ បង្រៀន គ្រូ ដែល បង្រៀន ក្មេង ទាំងនោះ ដែល ពួកគេ ក្មេង ៗ
ស្រលាញ់ គ្នា ត្រូវ គិត វែងឆ្ងាយ កុំ ឱ្យ ខាត យុវភាព អត់ អំពើ
កន្លែង ទាំងនេះ នឹង ក្លាយជា ចំណុច ផ្តល់
គរ ជើង គ្នា ហើយ លោក ទៅ នោះ មាន តែ ធ្លាក់ ប្រជាប្រិយភាព ។
ទាំងនេះ ពុំ មាន អ្វី ក្រៅពី ដើម្បី ព្យាយាម ការពារ និង រក្សា អំណាច របស់ រដ្ឋាភិបាល ទេ ។
ក្នុង ការដោះស្រាយ បញ្ហា ជីវិត ។
ព័ត៌មាន សុខភាព តាមពិត ចេះតែ ឈឺ ក្បាល នៅ ពេលព្រឹក មកពី មូលហេតុ ទាំង នេះ សោះ
