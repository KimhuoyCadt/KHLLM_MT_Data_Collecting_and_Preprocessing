តើអ្វីជួយយើងឲ្យលះចោលរបស់ដ៏ឥតប្រយោជន៍ ?
១១៩ : ៣៧) ក្នុងអត្ថបទបន្ទាប់ យើងនឹងពិភាក្សាបន្ថែមទៅទៀតអំពីប្រយោជន៍ដែលយើងទទួល ពេលធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ា ។
ព្រះយេ ហូវ៉ាលើកទឹក ចិត្ដជនជាតិអ៊ីស្រាអែលឲ្យ« ធ្វើស្រែខ្លួន » និងមិនដេញតាមអ្វីដែលឥតប្រយោជន៍
កុំឲ្យសេចក្ដីប្រាថ្នាចង់បានវត្ថុទ្រព្យ នាំឲ្យយើងធ្វើកិច្ចបម្រើព្រះយេ ហូវ៉ាតិចជាងមុន
ពួកអ្នកចាស់ទុំអាចពោលពាក្យដែលមានប្រយោជន៍ច្រើនណាស់ !
ចូរស្វែងរកការណែនាំពីព្រះយេ ហូវ៉ាក្នុងគ្រប់ប្រការ
ជាជាងទុក ចិត្ដទៅលើប្រាជ្ញារបស់ខ្លួន ម្ដេចក៏យើងគួរធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ា ?
ស្ដីអំពីការណែនាំរបស់ព្រះយេ ហូវ៉ា តើមានសំណួរអ្វី ខ្លះ ?
បើយើងចាត់ទុករបស់ដ៏ឥតប្រយោជន៍ដែលអាចនាំឲ្យមានគ្រោះថ្នាក់ ថាជារបស់ដ៏ល្អវិញ យើងកំពុងបន្លំខ្លួនហើយ !
១៧: ៥, ៩) អាស្រ័យហេតុនេះ អ្នកតែងបទទំនុកដំកើងបង្ហាញថាគាត់មានប្រាជ្ញាមែន ដោយអធិដ្ឋានថា៖ « សូមផ្សាយពន្លឺនឹងសេចក្ដីពិត ចេញមកនាំមុខទូលបង្គំ ដើម្បីឲ្យបាននាំទូលបង្គំ » ។ ( ទំនុក .
ប៉ុន្ដែ ម្ដេចក៏គួរឲ្យទុក ចិត្ដការណែនាំពីព្រះយេ ហូវ៉ា ជាជាងទុក ចិត្ដការណែនាំពីអ្នកឯទៀត ?
តើយើងគួរបណ្ដុះឲ្យមានចិត្ដគំនិតបែបណា ដើម្បីទទួលប្រយោជន៍ពីការណែនាំរបស់ព្រះយេ ហូវ៉ា ?
អត្ថបទនេះនឹងឆ្លើយសំណួរដ៏សំខាន់ទាំងនេះ ។
ការណែនាំពីព្រះយេ ហូវ៉ាម្ដេចក៏គួរឲ្យទុក ចិត្ដ ?
តើមានមូលហេតុអ្វី ខ្លះឲ្យយើងទុក ចិត្ដទាំងស្រុងទៅលើការណែនាំពីព្រះយេ ហូវ៉ា ?
ព្រះយេ ហូវ៉ាជាបិតារបស់យើងនៅឯស្ថានសួគ៌ ។ ព្រះយេ ហូវ៉ាស្គាល់យើងម្នា ក់ ៗយ៉ាងច្បាស់ ហើយទ្រង់ចេះស្ទង់មើលចិត្ដរបស់យើងផង ។ ( ១សាំ .
២១: ២) ចំពោះព្រះយេ ហូវ៉ា ស្ដេចដាវីឌមានប្រសាសន៍ថា៖ « ទ្រង់ជ្រាបការដែលទូលបង្គំអង្គុយចុះ នឹងការដែលទូលបង្គំក្រោកឡើងផង ទ្រង់ក៏យល់គំនិតរបស់ទូលបង្គំពីចំងាយដែរ ដ្បិតឱព្រះយេ ហូវ៉ាអើយ !
ចំណុចសំខាន់មួយ ទៀត ព្រះយេ ហូវ៉ាមានអំណាចខ្លាំងក្លាបំផុត ។ ស្ដីអំពីរឿងនេះ អ្នកតែងបទទំនុក ដំកើងបានសរសេរថា៖ « អ្នកណាដែលនៅជាប់ក្នុងទីកំបាំងនៃព្រះដ៏ខ្ពស់បំផុត នោះនឹងបានជ្រកនៅក្រោមម្លប់នៃព្រះដ៏មានគ្រប់ព្រះចេស្តា ។ ឯទូលបង្គំនឹងពោលពីព្រះយេ ហូវ៉ាថា៖ ‹ ទ្រង់ជាទីពឹងពំនាក់ ជាបន្ទាយនៃទូលបង្គំ គឺជាព្រះនៃទូលបង្គំហើយ ទូលបង្គំទុក ចិត្ដនឹងទ្រង់ › » ។ ( ទំនុក .
ប៉ុន្ដែ តើយើងត្រូវការការណែនាំពីព្រះយេ ហូវ៉ានៅពេលណា ខ្លះ ?
ការណែនាំពីព្រះយេ ហូវ៉ា ត្រូវការពេលណា ?
តើយើងត្រូវការការណែនាំពីព្រះយេ ហូវ៉ានៅពេលណា ខ្លះ ?
៤៨ : ១៤ ) ពួកគ្រិស្ដសាសនិកដែលមានប្រាជ្ញាក៏ធ្វើតាមគំរូរបស់អ្នកតែងបទទំនុក ដំកើង ដោយស្វែងរកការណែនាំពីព្រះយេ ហូវ៉ាជានិច្ច ។
ប៉ុន្ដែ ម្ដងម្កាលយើងក៏ត្រូវការជំនួយច្រើនជាងធម្មតា ។ ជួនកាលយើង« មានសេចក្ដីវេទនា » ប្រហែលជាដោយសារមានជំងឺរ៉ាំរ៉ៃ មានគេបៀតបៀនយើង ឬដោយសារបានបាត់បង់ការងារជាដើម ។ ( ទំនុក .
សូមចាំថា យើងត្រូវតែធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ាដោយស្ម័គ្រពីចិត្ដ ។ បើយើងមិនចង់ធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ា ទ្រង់មិនបង្ខំយើងទេ ។ មនុស្សមុនគេបង្អស់ដែលបានសម្រេចចិត្ដថា មិនចង់ធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ា គឺនាងអេ វ៉ា ។ លទ្ធផលអាក្រក់នោះបង្ហាញថា ការសម្រេចចិត្ដមិនល្អ មានគ្រោះថ្នាក់មែន !
សូមគិតដែរ ថាតើការប្រព្រឹត្ដរបស់អេ វ៉ាសឲ្យឃើញចិត្ដគំនិតបែបណា ?
បើយើងមិនធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ា តើនេះសឲ្យឃើញចិត្ដគំនិតបែបណា ?
ម្ដេចក៏ទង្វើបែបនោះគ្មានប្រយោជន៍ ?
ម្ដេចក៏យើងមិនបណ្ដោយខ្លួនតាមចិត្ដសេរី ?
សូមគិតអំពីអ្វីដែលបានកើតឡើងនៅប្រទេសអ៊ីស្រាអែលសម័យបុរាណ ។ ពេលបណ្ដាជនអ៊ីស្រាអែលបានធ្វើ ការសម្រេចចិត្ដល្អ ដោយស្តាប់បង្គាប់ព្រះយេ ហូវ៉ា ទ្រង់បានការពារពួកគេ ។ ( យ៉ូស .
២៤: ១៥, ២១, ៣១ ) ក៏ប៉ុន្ដែ ជាញយដង ពួកគេបានប្រព្រឹត្ដដោយសេរីពេក ។ នៅសម័យយេរេមា ព្រះយេ ហូវ៉ាមានប្រសាសន៍អំពីពួកអ៊ីស្រាអែលថា៖ « គេមិនបានស្តាប់តាមសោះ ក៏មិនបានផ្ទៀងត្រចៀកផង គឺគេបានដើរតាម តែគំនិតរបស់ខ្លួនគេ នឹងសេចក្ដីរឹងចចេសក្នុងចិត្ដអាក្រក់របស់គេវិញ ។ គេបានរាថយក្រោយ ឥតជឿនទៅខាងមុខទេ ! »
ដូច្នេះ កុំឲ្យយើងមានចិត្ដមានះ និងបណ្ដោយខ្លួនតាមទំនើងចិត្ដ ដល់ម៉្លេះបានជាយើងមិនព្រមធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ា ។ បើដូច្នេះ យើងនឹងដើរតាមឬធ្វើតាមគំនិតរបស់ខ្លួនវិញ ហើយ« រាថយក្រោយ ឥតជឿនទៅខាងមុខទេ ! »
ធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ាយ៉ាងដូចម្ដេច ?
សេចក្ដីស្រឡាញ់ចំពោះព្រះយេ ហូវ៉ាជំរុញចិត្ដយើងឲ្យចង់ធ្វើតាមការណែនាំពីទ្រង់ ។ ក៏ប៉ុន្ដែ ប៉ុលបានបញ្ជាក់ពីលក្ខណៈសម្បត្ដិមួយទៀតដែលជាចាំបាច់ដែរ ។ ប៉ុលសរសេរថា៖ « យើងខ្ញុំដើរដោយជំនឿ មិនមែនដោយមើលឃើញទេ » ។ ហេតុអ្វីក៏សំខាន់ម៉្លេះឲ្យយើងមានចិត្ដជឿ ?
ជំនឿគឺសំខាន់ដល់ម៉្លេះ ពីព្រោះព្រះយេ ហូវ៉ានាំយើងទៅតាម« ផ្លូវសុចរិត » ។ ប៉ុន្ដែ ផ្លូវទាំងនោះមិននាំយើងឲ្យក្លាយទៅជាអ្នក មានស្ដុកស្ដម្ភ ឬមាន មុខមានមាត់ក្នុងពិភពលោកនេះឡើយ ។ ( ទំនុក .
ម្ដេចក៏ហាការត្រូវបង្ហាញចិត្ដរាប ទាប ?
១៦: ២, ៦, ៨, ៩) ប្រហែលជាហាការមិនចូលចិត្ដស្តាប់សារនោះទេ ពីព្រោះការធ្វើតាមការណែនាំពីទេវតានោះ តម្រូវឲ្យនាងបន្ទាប ខ្លួន ។ យ៉ាងណាក៏ដោយ ហាការបានបន្ទាប ខ្លួន ហើយបានធ្វើតាមការណែនាំពីទេវតាមែន !
សូមរៀបរាប់អំពីកាលៈទេសៈខ្លះដែលតម្រូវឲ្យយើងមានចិត្ដរាប ទាបដើម្បីធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ា ។
តើព្រះយេ ហូវ៉ាផ្ដល់ការណែនាំតាមរបៀបណា ខ្លះ ?
តើព្រះយេ ហូវ៉ាផ្ដល់ការណែនាំតាមរយៈបងប្អូនគ្រិស្ដសាសនិកដែលរួបរួមគ្នាដោយភាតរភាពយ៉ាងដូចម្ដេច ?
៣២ : ១) ប្អូន ៗក្នុងរង្វង់គ្រួសារដែលជាគ្រិស្ដសាសនិក ក៏មានវិធីមួយ ទៀតដែលគេអាចរកការណែនាំពីព្រះយេ ហូវ៉ា ។ ដោយសារមាតាបិតាជឿទៅលើព្រះយេ ហូវ៉ា ទ្រង់ប្រទានភារកិច្ចឲ្យពួកគាត់ផ្ដល់ការណែនាំពីទ្រង់ ។ ដូច្នេះ គប្បីឲ្យប្អូន ៗស្វែងរកការណែនាំពីព្រះយេ ហូវ៉ាតាមរយៈមាតាបិតាដែលជាអ្នកជឿ ។ — អេភ.
ដោយសារយើងខំស្វែងរកការណែនាំពីព្រះយេ ហូវ៉ាជានិច្ច តើយើងអាចទទួលពរអ្វី ខ្លះ ?
គឺច្បាស់ហើយថា ព្រះយេ ហូវ៉ាផ្ដល់ការណែនាំដោយវិធីផ្សេង ៗ ។ ដូច្នេះ គប្បីឲ្យយើងឆ្លៀតយកប្រយោជន៍ពីការណែនាំរបស់ព្រះយេ ហូវ៉ា ។ ស្ដេចដាវីឌបានសរសេរអំពីគ្រាដែលពួកអ៊ីស្រាអែលមានចិត្ដស្មោះត្រង់ចំពោះព្រះយេ ហូវ៉ាថា៖ « ពួកឰ យុកោយើងខ្ញុំបានទុក ចិត្ដនឹងទ្រង់ ។ គេបានទុក ចិត្ដ ហើយទ្រង់បានប្រោសឲ្យរួច ។ គេបានអំពាវនាវដល់ទ្រង់ ហើយបានរួចចេញ ។ គេបានទុក ចិត្ដនឹងទ្រង់ ហើយមិនត្រូវខ្មាសឡើយ » ។ ( ទំនុក .
២២: ៣-៥) បើយើងធ្វើតាមការណែនាំពីព្រះយេ ហូវ៉ាដោយមានទំនុក ចិត្ដបែបនោះ យើងក៏« មិនត្រូវខ្មាស »ដែរ ។ គ្មានអ្វីទាល់តែសោះ ដែលនឹងនាំឲ្យយើងខក ចិត្ដឡើយ ។ បើយើង« ទុកដាក់នឹងព្រះយេ ហូវ៉ា » ជាជាងពឹងទៅលើប្រាជ្ញារបស់ខ្លួន យើងនឹងទទួលពរដ៏វិសេស ។ ( ទំនុក .
ពួកអ្នកសុចរិតនឹងបានស្រុកទុក ជាមរដក ហើយ នឹងនៅក្នុងស្រុកនោះជានិច្ច » ។ — ទំនុក .
តើយើងស្វែងរកការណែនាំពីព្រះយេ ហូវ៉ាក្នុងគ្រប់ប្រការទេ ?
នាងអេ វ៉ាមិនព្រមទទួលស្គាល់ ឋានៈរបស់ព្រះយេ ហូវ៉ាជាព្រះដ៏ខ្ពស់បំផុតទេ
ដើម្បីធ្វើតាមការណែនាំពីទេវតា តើនាងហាការត្រូវតែមាន ចិត្ដគំនិតបែបណា ?
តើព្រះយេ ហូវ៉ាបង្ហាញយ៉ាងណា ថាទ្រង់ឲ្យតម្លៃចំពោះប្អូន ៗដែលថ្វាយបង្គំទ្រង់ ?
ព្រះយេ ហូវ៉ាឲ្យតម្លៃចំពោះគ្រិស្ដសាសនិកដែលនៅក្មេង ថាមានលក្ខណៈដូចជាទឹកសន្សើមដែលស្រោចស្រពដំណាំ ពីព្រោះអាចជួយចម្រើនកម្លាំងដល់អ្នកដទៃ ។ យ៉ាងនេះ ព្រះយេ ហូវ៉ាបានទាយថា នៅថ្ងៃដែលព្រះយេស៊ូ« ដំរៀបក្បួន ទ័ព » នោះពួកកំលោះក្រមុំនឹង« ថ្វាយខ្លួនស្ម័គ្រពីចិត្ដ »ក្នុងកិច្ចបម្រើព្រះគ្រិស្ដ ។ ( ទំនុក .
តើការនឹកចាំពីព្រះយេ ហូវ៉ារួមបញ្ចូលអ្វី ខ្លះ ?
សូមគិតអំពីអំណរដែលព្រះយេ ហូវ៉ាមាន ពេលទ្រង់ឃើញប្អូន ៗនឹកចាំពីទ្រង់ជាព្រះដែលបានបង្កើតរបស់សព្វសារពើ ។ ( សាស .
៤៨: ១៧, ១៨ ) តើប្អូន ៗមានទស្សនៈបែបនេះចំពោះព្រះយេ ហូវ៉ាដែលជាអ្នកបង្កើតអ្វី ៗទាំងអស់ទេ ?
តើព្រះយេស៊ូបានបង្ហាញយ៉ាងណា ថាទ្រង់ពឹងទៅលើព្រះយេ ហូវ៉ា ?
នៅសព្វ ថ្ងៃនេះ ហេតុអ្វីក៏សំខាន់ដល់ម៉្លេះឲ្យយើងពឹងទៅលើព្រះយេ ហូវ៉ា ?
នោះទ្រង់នឹងដំរង់អស់ ទាំងផ្លូវច្រករបស់ឯង » ។ មិនយូរប៉ុន្មានក្រោយព្រះយេស៊ូបានទទួលការជ្រមុជទឹក សាតាំងព្យាយាមល្បួងទ្រង់ ដោយខំញុះញង់ទ្រង់ឲ្យប្រាថ្នាចង់បានអំណាចនិងសិរីរុងរឿងក្នុងពិភពលោកនេះ ។ ប៉ុន្ដែ ព្រះយេស៊ូមិនចាញ់ល្បិចសាតាំងទេ ។ ព្រះយេស៊ូដឹងថា មនុស្សត្រូវតែមាន ‹ ចិត្ដសុភាព នឹងកោតខ្លាចព្រះយេ ហូវ៉ា › ទើបអាចទទួល« ទ្រព្យសម្បត្ដិ កិ ត្ដិ សព្ទនឹងជីវិត »ដែលពិតជាមានប្រយោជន៍ ។ — សុ.
យ៉ាងនេះ ឆាប់ ៗខាងមុខ ប្អូន ៗនឹងទទួល« ជីវិតអស់កល្បជានិច្ច » ជាមិនខាន ។ — ១ធី .
ចូរមានប្រាជ្ញាចុះ !
គួរឲ្យស្តាយណាស់ !
ប្អូន ៗខ្លះមិនបានប្រុងប្រយ័ត្នទេ ។ ពួកគេលែងទទួលស្គាល់ថា ទីបញ្ចប់នៃពិភពលោកនេះជិតដល់ហើយ !
ប្អូន ៗឯទៀតបានសេព គប់ជាមួយមនុស្សមិនល្អ ហើយបានមើលរូបអាសអាភាស ដែលក្រោយមកបានបណ្ដាលឲ្យគេធ្វើ អំពើបាប ។ ( សុ.
ផ្ទុយទៅវិញ ចូរឲ្យយើងរៀនពីគំរូរបស់ពួកអ៊ីស្រាអែល ដោយមើលព្រឹត្ដិការណ៍ដែលបានកើតឡើងនៅឆ្នាំ១៤៧៣ មុនគ.
ពេលពួកគេបានបោះជំរំនៅឯវាលស្រុកម៉ូ អាប់ មិនយូរប៉ុន្មានមុនពួកគេបានចូលទៅក្នុងស្រុកសន្យា ។ តើអ្វីបានកើតឡើង ?
បណ្ដាជនអ៊ីស្រាអែលចាប់ផ្ដើមរួមដំណេកជាមួយនឹងពួកកូនស្រីជនជាតិម៉ូ អាប់ ព្រមទាំងក្រាបថ្វាយបង្គំព្រះបា ល ពេ អររបស់ពួកគេផង !
ទោះជាស្រុកសន្យាដែលជាកេរមត៌កពិសេសបានស្ថិតនៅជិតក្ដី បណ្ដាជនអ៊ីស្រាអែលប្រមាណ២៤.០០០នាក់បានបាត់បង់ជីវិត ។ គួរឲ្យស្តាយណាស់ ! — ជន .
ចូរសូមព្រះយេ ហូវ៉ាជួយប្អូន ៗឲ្យផ្ចង់អារម្មណ៍ទៅលើការដ៏ល្អចុះ !
ព្រះយេ ហូវ៉ាតែងតែស្តាប់អស់អ្នកដែលរកជំនួយពីទ្រង់យ៉ាងស្មោះអស់ពីចិត្ដ ។ ( សូមអាន លូកា ១១: ៩-១៣ ) ការពិភាក្សាអំពីរឿងល្អ ៗក៏អាចជួយប្អូន ៗឲ្យតម្រង់ចិត្ដ គំនិតឲ្យបានត្រង់ឡើងវិញ ។
មូលហេតុមួយដែលយុវជនយុវតីជាច្រើនក្នុងពិភពលោកនេះមិនចេះទប់ចិត្ដ ហើយគិត តែពីសប្បាយ គឺដោយសារពួកគេឥតមាន« ការបើកសំដែង » ដែលមានន័យថា គ្មានអ្នកណាបានបើកសម្ដែងឲ្យគេស្គាល់ការណែនាំពីព្រះយេ ហូវ៉ា ហើយគ្មាននរណាបានបើកសម្ដែងឲ្យគេមានសេចក្ដីសង្ឃឹមចំពោះពេលអនាគត ។ ( សុ.
ជាជាងច្រណែនចង់បានការសប្បាយដូចមនុស្សបែបនោះ គប្បីឲ្យយើងនឹកចាំពីសេចក្ដីសង្ឃឹមដ៏អស្ចារ្យដែលព្រះយេ ហូវ៉ាប្រទានឲ្យអស់អ្នកដែលស្មោះត្រង់នឹងទ្រង់ ។ បើប្អូនជាអ្នកបម្រើព្រះយេ ហូវ៉ា តើប្អូនរង់ចាំពិភពលោកថ្មីដោយរីករាយទេ ?
