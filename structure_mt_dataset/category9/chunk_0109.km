តើប៉ុលមានទំនាក់ទំនងយ៉ាងណាជាមួយនឹងក្រុម ជំនុំនានានៅឯកោះក្រេត ?
ក្រោយសាវ័កប៉ុលបានធ្វើដំណើរជាសាសន ទូតអស់បីដងនោះ គេបានចាប់ខ្លួនគាត់ ហើយនៅទីបំផុតគេក៏បញ្ជូនគាត់ទៅឯទីក្រុងរ៉ូម ។ នៅទីនោះ ប៉ុលបានជាប់គុកអស់ពីរឆ្នាំ ។ ពេលគេដោះលែងប៉ុល តើគាត់បានធ្វើអ្វី ?
យើងដឹងថាប៉ុលបានទៅលេងកោះក្រេតជាមួយលោកទី តុស តែមិនដឹងពេលណាដែលពួកគាត់បានទៅទេ ។ ក្រោយមកទៀត ប៉ុលបានសរសេរទៅកាន់ទី តុសថា៖ « ខ្ញុំបានទុកឲ្យអ្នកនៅកោះក្រេត ដើម្បីនឹងរៀបចំការដែលនៅខ្វះឲ្យស្រួលបួលឡើង ហើយនឹងតាំងឲ្យមានពួកចាស់ទុំនៅគ្រប់ទាំងទីក្រុង » ។ ដើម្បីសម្រេចកិច្ចការនោះ ទី តុសត្រូវតែមានទំនាក់ទំនងជាមួយបងប្អូនខ្លះដែលមានបញ្ហាក្នុងការវិនិច្ឆ័យខ្លួនឲ្យបានត្រឹមត្រូវ ។
នៅកោះក្រេត តើទី តុសត្រូវជួយដោះស្រាយបញ្ហាអ្វី ?
មុនដំបូង ប៉ុលបានសរសេរចំពោះទី តុសអំពីលក្ខណៈដែលពួកប្រុស ៗត្រូវតែមាន ទើបពួកគេអាចទទួលភារកិច្ចជាអ្នកចាស់ទុំ ។ ក្រោយមក គាត់បានបញ្ជាក់ថា អ្នកខ្លះនៅទីនោះជាមនុស្ស« រឹងរូស ...
អ្នកដែលស្មោក គ្រោកទាំងបញ្ញាចិត្ដ
តើប៉ុលបានសរសេរអ្វីខ្លះជូនចំពោះទី តុសស្ដីអំពីបញ្ញាចិត្ដ ?
តើអ្នកខ្លះក្នុងក្រុម ជំនុំពីបុរាណធ្លាប់មានគំនិតខុសឆ្គងបែបណា ?
តើយើងអាចទទួលប្រយោជន៍អ្វីខ្លះពីសំបុត្រដែលប៉ុលសរសេរចំពោះទី តុស ?
តើបទគម្ពីរក្នុងសៀវភៅហេព្រើរ ១៣: ៤ ហាមមិនឲ្យស្វាមីភរិយាធ្វើអ្វី ?
ក្មេងជំទង់ជាច្រើនដោះសាថា ការរួមភេទបែបនេះគ្មានអ្វីខុសឡើយ ពីព្រោះមិនមែនជាការរួមដំណេកទេ ។ បើដូច្នេះ តើគ្រិស្ដសាសនិកអាចចាត់ទុកការរួមភេទតាមមាត់ជាអំពើដែលមិនស្មោក គ្រោកឬ ?
ស្ដីអំពីការរួមភេទតាមមាត់ តើគ្រិស្ដសាសនិកពិតមានទស្សនៈខុសគ្នាយ៉ាងណាពីមនុស្សក្នុងពិភពលោកនេះ ?
បទគម្ពីរក្នុងសៀវភៅហេព្រើរ ១៣: ៤ និងកូរិន ថូស ទី១ ៦: ៩ បង្ហាញយ៉ាងច្បាស់ថា ព្រះយេ ហូវ៉ាស្អប់នូវការផិតក្បត់និងអំពើដែលប្រាសចាកសីលធម៌ខាងផ្លូវភេទ ( ភាសាក្រិច ភ នៀរ ) ។ ប៉ុន្ដែ តើអំពើដែលប្រាសចាកសីលធម៌ខាងផ្លូវភេទរួមបញ្ចូលអ្វីខ្លះ ?
គួរឬមិនគួរស្រេចទៅលើវិចារណញ្ញាណ
បើ« គ្រប់ទាំងអស់ជាស្អាត »នោះ ម្ដេចក៏យើងត្រូវការបញ្ញាចិត្ដនិងវិចារណញ្ញាណ ?
ពេលប៉ុលសរសេរថា៖ « គ្រប់ទាំងអស់ជាស្អាតដល់អ្នកណាដែលស្អាត » តើគាត់ចង់បញ្ជាក់ន័យអ្វី ?
តើពិធីអាពាហ៍ ពិពាហ៍ ( ឬបុណ្យសពក៏បាន ) អាចនាំឲ្យមានរឿងពិបាកអ្វី ?
សូមពិនិត្យមើលការសម្រេចចិត្ដខុសគ្នារបស់បងស្រីពីរនាក់ដូចតទៅនេះ ។
តើបងប្អូនខ្លះប្រហែលជាត្រិះរិះរាវរកហេតុផលយ៉ាងណា ស្ដីអំពីការចូលរួមពិធីអាពាហ៍ ពិពាហ៍តាមប្រពៃណី ?
ចុះយ៉ាងណាចំពោះនាងចន្ថាវិញ ?
ហេតុអ្វីក៏មិនជាការចម្លែកអ្វីឡើយ ដែលគ្រិស្ដសាសនិកពីរនាក់សម្រេចចិត្ដខុសពីគ្នា ?
ដោយសារគ្រិស្ដសាសនិកទាំងពីរនាក់នេះត្រិះរិះរាវរកហេតុផលនិងសម្រេចចិត្ដខុសពីគ្នានោះ តើនេះមានន័យថា ការសម្រេចចិត្ដរបស់ពួកគេមិនជាការសំខាន់ឬ ?
ឬមួយក៏ តើទស្សនៈខុសគ្នារបស់ពីរនាក់នេះមានន័យថា ម្នាក់មិនសូវចេះរាវរកហេតុផលឲ្យស្គាល់ខុសនិងត្រូវ ហើយខ្វះសមត្ថភាពវិនិច្ឆ័យខ្លួនឬទេ ?
តើគ្រិស្ដសាសនិកទាំងឡាយគួរចងចាំចំណុចអ្វីស្ដីអំពីរឿងដែលស្រេចទៅលើចិត្ដរបស់ខ្លួន ?
ប៉ុន្ដែ តើការសម្រេចចិត្ដរបស់ចន្ថាដើម្បីមានវត្ដ មាននៅទីនោះ ជាការសម្រេចមិនល្អឬ ?
តាមពិត អ្នកដទៃគ្មានសិទ្ធិវិនិច្ឆ័យទេ ។ បើចន្ថាសម្រេចចិត្ដមានវត្ដ មាននៅទីនោះ តែមិនរួមចំណែកសោះក្នុងទំនៀមទម្លាប់សាសនា អ្នកដទៃមិនគួរវិនិច្ឆ័យនិងរិះគន់គាត់ឡើយ ។ សូមចាំឱវាទរបស់ប៉ុលស្ដីអំពីការសម្រេចចិត្ដដោយខ្លួនឯង ដែលទាក់ទងនឹងការបរិភោគឬមិនបរិភោគអាហារផ្សេង ៗ ។ គាត់សរសេរថា៖ « កុំឲ្យអ្នកដែលបរិភោគ មើលងាយដល់អ្នកដែលមិនបរិភោគឡើយ ក៏កុំឲ្យអ្នកដែលមិនបរិភោគ និន្ទាចំពោះអ្នកដែលបរិភោគដែរ ...
អ្នកនោះឈរឬដួលក្ដី នោះស្រេចនឹងចៅហ្វាយទេតើ ហើយគេនឹងបានឈរមែន ដ្បិតព្រះទ្រង់អាចនឹងតាំងឲ្យឈរបាន » ។ គឺច្បាស់ហើយ គ្រិស្ដសាសនិកពិតមិនបង្ខំអ្នកដទៃដែលបានបណ្ដុះឲ្យមានសមត្ថភាពវិនិច្ឆ័យខ្លួន ឲ្យធ្វើព្រងើយនឹងវិចារណញ្ញាណរបស់ខ្លួនឡើយ ។ បើពួកគេមិនយកចិត្ដទុកដាក់នឹងបញ្ញាចិត្ដ ព្រមទាំងមិនស្តាប់តាមវិចារណញ្ញាណរបស់ខ្លួន នេះអាចនាំឲ្យមានគ្រោះថ្នាក់ដល់ជីវិត ។
សូមរៀបរាប់ឧទាហរណ៍មួយដែលបង្ហាញថា ការចូលទៅជិតព្រះជានិច្ចអាចមានឥទ្ធិពលបន្ដិចម្ដង ៗទៅលើការសម្រេចចិត្ដនិងសមត្ថភាពវិនិច្ឆ័យខ្លួន ។
បន្ដិចម្ដង ៗ វិចិត្រទទួលចំណេះកាន់តែច្រើនអំពីព្រះ ហើយក៏ចូលកាន់តែជិតនឹងទ្រង់ផង ។ តើមានលទ្ធផលអ្វី ?
តើយើងមានអំណរដោយព្រោះអ្វី ?
ក្នុងការសំណេះសំណាលជាមួយ ‹ អ្នកដែលស្អាត › ពោលគឺ បងប្អូនដែលមានទស្សនៈដូចលោកម្ចាស់របស់យើង ស្ដីអំពីគោលការណ៍សីលធម៌ដែល ‹ ស្អាតស្អំ › និងការថ្វាយបង្គំដែលគាប់ចិត្ដទ្រង់ ។ ចូរឲ្យយើងរាល់គ្នាមានគោលដៅបណ្ដុះឲ្យមានសមត្ថភាពវិនិច្ឆ័យខ្លួនកាន់តែល្អឡើង ៗ និងរក្សាឲ្យមានវិចារណញ្ញាណជានិច្ច ដែលបង្ហាញថាយើងមានចំណេះដឹងពិត ព្រមទាំងគោរពថ្វាយបង្គំព្រះយេ ហូវ៉ាយ៉ាងអស់ពីចិត្ដ ។ — ទី តុស ១: ១
គោលសំ ខាន់ ៗពីសៀវភៅអូបាឌា យ៉ូណា សនិងមីកា
។ មីការៀបរាប់តែបន្ដិចបន្ដួចអំពីខ្លួនគាត់ថា មកពីភូមិ« ម៉ូរ៉ា ស៊ី ត » ហើយថាព្រះយេ ហូវ៉ាមានប្រសាសន៍ទៅកាន់គាត់« នៅក្នុងរាជ្យនៃយ៉ូ ថា ម អេ ហាស នឹងហេ សេ គា ជាស្ដេចយូដា » ។ ( មីកា ១: ១) យើងដឹងថាមីកាយល់អំពីជីវិតនៅឯស្រុកស្រែ ពីព្រោះពាក្យប្រៀប ប្រដូចដែលគាត់ប្រើដើម្បីបញ្ជាក់ចំណុចសំ ខាន់ ៗក្នុងសារដែលគាត់ផ្សាយនោះ គឺទាក់ទងនឹងរឿងស្រុកស្រែ ។
ស្រុកអេ ដំម« នឹងត្រូវកាត់ចេញជារៀងរាបដរាប »
អូបាឌាមានប្រសាសន៍អំពីជនជាតិអេ ដំមថា៖ « សេចក្ដីអាម៉ាស់ខ្មាសនឹងគ្របលើឯង ឯងនឹងត្រូវកាត់ចេញជារៀងរាបដរាប ដោយព្រោះការច្រឡោតដែលឯងបានប្រព្រឹត្ដនឹងពួកយ៉ាកុបជាបងប្អូនឯង » ។ អូបាឌាចាំច្បាស់នូវអំពើឃោរឃៅរបស់ពួកអេ ដំម ដែលពួកគេបានប្រព្រឹត្ដទៅលើកូនចៅរបស់យ៉ាកុបឬពួកអ៊ីស្រាអែល មិនយូរប៉ុន្មានមុននោះ ។ នៅឆ្នាំ៦០៧មុនគ.
ពេលដែលពួកបា ប៊ី ឡូនបានបំផ្លាញទីក្រុងយេ រូ សា ឡិមចោល ពួកអេ ដំម« បានឈរមើល » ថែមទាំងចងសម្ព័ន្ធមេត្រីជាមួយ« ពួកអ្នកដទៃ »ដែលបានទន្ទ្រានចូលស្រុកយូដា ។ — អូបាឌា ១០, ១១
រីឯពួកវង្សយ៉ាកុប ព្រះយេ ហូវ៉ាមានបំណងស្តារពួកគេឡើងវិញ ។ បទទំនាយរបស់អូបាឌារៀបរាប់ថា៖ « នៅភ្នំស៊ី យ៉ូននឹងមានពួកអ្នកខ្លះដែលរួចជីវិត ហើយភ្នំនោះនឹងបានបរិសុទ្ធ » ។ — អូបាឌា ១៧
៥-៨ — ពេលប្រៀបធៀបសេចក្ដីហិនវិនាសរបស់ជនជាតិអេ ដំមទៅនឹងពួកចោរដែលមកប្លន់នៅពេលយប់ និងពួកអ្នកដែលបេះផ្លែទំពាំងបាយជូរ តើនេះបង្កប់អត្ថន័យដ៏សំខាន់អ្វី ?
ស្របទៅតាមទំនាយរបស់ព្រះ ជនជាតិអេ ដំមដែលធ្លាប់មានពលរដ្ឋមួយចំនួនស្ថិតក្រោមអំណាចរដ្ឋាភិបាលដែលគ្រប់គ្រងលើទឹកដីដែលមានទល់ដែនជាក់លាក់ បានផុតពូជសូន្យអស់ទៅ ។ ប្រមាណ៥៥០ឆ្នាំ មុនគ.
ជនជាតិអារ៉ាប់មួយពួក ហៅថាជនជាតិណា បា ថេ បានទៅរស់នៅលើទឹកដីរបស់ពួកអេ ដំម ដែលបង្ខំឲ្យបណ្ដា ជនអេ ដំមរើទៅនៅស្រុកយូដាប៉ែកខាងត្បូង ។ ក្រោយពួករ៉ូមបានបំផ្លាញចោលទីក្រុងយេ រូ សា ឡិមនៅឆ្នាំ៧០ គ.
ជនជាតិអេ ដំមលែងមានទៀត ។
៣, ៤: ស្រុកអេ ដំមស្ថិតនៅតំបន់ដែលសម្បូរទៅដោយក្រហែងថ្មនិងភ្នំខ្ពស់ ៗផង ដូច្នេះមិនស្រួលទេ ឲ្យខ្មាំងសត្រូវឈ្នះលើពួកគេ ។ អាស្រ័យហេតុនេះ ជនជាតិអេ ដំមប្រហែលជាមានអំ ណួ តនៅក្នុងចិត្ដថា ពួកគេមានសុវត្ថិភាពហើយមិនចាំបាច់ខ្លាចអ្វីសោះ ។ ទោះជាយ៉ាងណាក៏ដោយ គ្មាននរណាអាចគេចរួចឡើយ ពេលព្រះយេ ហូវ៉ាវិនិច្ឆ័យទោស ។
១៧-២០: ទំនាយនេះបញ្ជាក់ពីការនាំកូនចៅរបស់យ៉ាកុបឲ្យមកស្រុកវិញ ចាប់ផ្ដើមសម្រេចពេលជនជាតិអ៊ីស្រាអែលខ្លះបានចេញពីស្រុកបា ប៊ី ឡូន ដើម្បីវិលត្រឡប់ទៅទីក្រុងយេ រូ សា ឡិមវិញ នៅឆ្នាំ៥៣៧ មុនគ.
។ ពាក្យរបស់ព្រះយេ ហូវ៉ាតែងតែសម្រេច ។ យើងអាចទុកចិត្ដទាំងស្រុងទៅលើសេចក្ដីសន្យារបស់ទ្រង់ ។
ចម្លើយចំពោះសំណួរអំពីបទគម្ពីរ :
១: ១, ២; ៣: ១០: ព្រះយេ ហូវ៉ាមិនបង្ហាញចិត្ដមេ ត្ដាដោយសន្ដោសប្រណីដល់ជនជាតិតែមួយ ឬមនុស្សមួយពួកដ៏ពិសេសណាទេ ។ « ព្រះយេ ហូវ៉ាទ្រង់ល្អដល់មនុស្សទាំងអស់ ហើយព្រះហឫទ័យទន់សន្ដោសរបស់ទ្រង់ ក៏គ្របលើកិច្ចការរបស់ទ្រង់ទាំងប៉ុន្មាន » ។ — ទំនុក ដំកើង ១៤៥ : ៩
ពីព្រោះអ្នកទីក្រុងនី នី វេ« បានលាកចេញពីផ្លូវអាក្រក់របស់គេ » ។ ស្រដៀងគ្នានៅសព្វថ្ងៃនេះ ព្រះយេ ហូវ៉ានឹងមិនកាត់ទោសមនុស្សដែលធ្វើបាប ឲ្យតែពួកគេប្រែចិត្ដយ៉ាងស្មោះ ។
៤: ១-៤: មនុស្សមិនអាចឃាត់ព្រះយេ ហូវ៉ាពីការបង្ហាញចិត្ដអាណិតអាសូរឡើយ ។ យើងត្រូវតែប្រុងប្រយ័ត្ន កុំឲ្យមានទំនោរចិត្ដចង់រិះគន់ពេលដែលព្រះយេ ហូវ៉ាអាណិតមេ ត្ដាដល់នរណាម្នាក់ ។
តើព្រះយេ ហូវ៉ាបានប្រព្រឹត្ដដោយអ យុត្ ដិ ធម៌ទៅលើបណ្ដា ជនអ៊ីស្រាអែលឬ ?
តើតម្រូវការរបស់ទ្រង់តឹងរ៉ឹងពេកឬទេ ?
៤: ១-៤ —« នៅជាន់ក្រោយ » តើព្រះយេ ហូវ៉ា« ធ្វើជាចៅក្រមដល់សាសន៍ជាច្រើន ហើយនឹងសំរេចសេចក្ដីពីដំណើរប្រទេសមានអំណាចខ្លាំងផ្សេង ៗ »យ៉ាងដូចម្ដេច ?
ពួកបា ប៊ី ឡូនបានដុតចោលទីក្រុងយេ រូ សា ឡិម ។ ( របាក្សត្រ ទី២ ៣៦ : ១៩ ) ណាមួយទៀត ព្រះមេស្ ស៊ីបានកើតមកនៅឯក្រុង« បេ ថ្លេ ហិមអេ ប្រា តា » ស្របទៅតាមទំនាយមែន !
២: ១, ២: គប្បីឲ្យយើងប្រុងប្រយ័ត្ន កុំឲ្យអះអាងថា យើងកំពុងបម្រើព្រះយេ ហូវ៉ា តែតាមពិតចាត់ទុកការស្វែងរកទ្រព្យសម្បត្ដិជាអាទិភាពក្នុងជីវិត ជាជាងស្វែងរក« នគរនឹងសេចក្ដីសុចរិតនៃ »ជាមុនសិន ។ — ម៉ាថា យ ៦: ៣៣; ធី ម៉ូថេ ទី១ ៦: ៩, ១០
៣: ១-៣, ៥: ចំពោះអស់អ្នកដែលមានភារកិច្ចនាំមុខរាស្ដ្ររបស់ព្រះយេ ហូវ៉ា ទ្រង់តម្រូវឲ្យពួកគេប្រព្រឹត្ដដោយយុត្ ដិ ធម៌ ។
៣: ៤: បើយើងចង់ឲ្យព្រះយេ ហូវ៉ាធ្វើតាមសំណូមពររបស់យើង យើងមិនគួរប្រព្រឹត្ដអំពើបាបជាទម្លាប់ ឬមានមុខពីរឡើយ ។
៣: ៨: យើងអាចបំពេញភារកិច្ចរបស់យើងជាអ្នកប្រកាសដំណឹងល្អបាន ដែលរួមបញ្ចូលការប្រកាសសារអំពីទោសដែលមនុស្សនឹងទទួលពីព្រះយេ ហូវ៉ា ឲ្យតែយើងទទួលកម្លាំងពីសកម្មពលរបស់ទ្រង់ ។
៥: ៤: ទំនាយនេះសំដៅទៅលើព្រះមេស្ ស៊ី ហើយបញ្ជាក់ថា ពេលខ្មាំងសត្រូវពាធារាស្ដ្ររបស់ព្រះយេ ហូវ៉ា ទ្រង់នឹងលើក« អ្នកគង្វាល៧នាក់ »និង« ពួកជាប្រធាន៨នាក់ »ឲ្យនាំមុខពួកគេ ។ លេខ៧នេះបញ្ជាក់ថា អ្នកនាំមុខមានចំនួនពេញលេញ ហើយលេខ៨ក៏បញ្ជាក់ទៀតថា ពួកគេមានគ្នាច្រើនណាស់ !
៦: ៣, ៤: គប្បីឲ្យយើងយកត ម្រាប់តាមព្រះយេ ហូវ៉ាដោយមានមេ ត្ដានិងចិត្ដអាណិតអាសូរ សូម្បីតែចំពោះអស់អ្នកដែលពិបាកស្រឡាញ់ និងអ្នកដែលមិនបានរក្សាឲ្យមានភាពជិតស្និទ្ធជាមួយនឹងទ្រង់ ។
ចូរ« ប្រព្រឹត្ដតាមព្រះនាមនៃព្រះយេ ហូវ៉ា »ជានិច្ច
ពាក្យសន្យារបស់ព្រះយេ ហូវ៉ាតែងតែសម្រេចគ្រប់ជំពូក
ពេលយ៉ូស្វេនិយាយទៅកាន់ពួកចាស់ទុំនោះ តើជនជាតិអ៊ីស្រាអែលស្ថិតក្នុងស្ថានភាពបែបណា ? តើយ៉ូស្វេមានប្រសាសន៍យ៉ាងណាទៅកាន់ពួកចាស់ទុំទាំងនោះ ?
តើព្រះយេ ហូវ៉ាធានាថានឹងជួយបណ្ដា ជនអ៊ីស្រាអែលយ៉ាងណា ?
តើបន្ទូលឬពាក្យសន្យាណាខ្លះរបស់ព្រះយេ ហូវ៉ាបានសម្រេចនៅសម័យយ៉ូស្វេ ?
ព្រះយេ ហូវ៉ាដោះរាស្ដ្រទ្រង់ឲ្យរួច
តើព្រះយេ ហូវ៉ាបានដោះជនជាតិអ៊ីស្រាអែលឲ្យរួចពីស្រុកអេ ស៊ី បដោយរបៀបណា ?
ព្រះយេ ហូវ៉ាការពាររាស្ដ្រទ្រង់
ចុះយ៉ាងណាចំពោះពាក្យសន្យារបស់ព្រះយេ ហូវ៉ាដែលថា ទ្រង់នឹងការពាររាស្ដ្រទ្រង់ ?
តើព្រះយេ ហូវ៉ាការពារបណ្ដា ជនអ៊ីស្រាអែលយ៉ាងដូចម្ដេច ( ក) ពេលពួកគេនៅក្នុងទីរហោឋាន ?
ក្រោយជនជាតិអ៊ីស្រាអែលបានឆ្លងកាត់សមុទ្រក្រហមនោះ ពួកគេបានដើរកាត់ទីកន្លែងដែលបានពណ៌នាថា ជា« ទី រហោស្ថានសំបើ មគួរស្ញែងខ្លាច ដែលមានពស់ភ្លើងនឹងខ្យា ដំរី មានដីហួត ហែង ឥតមានទឹក » ។ ( ចោទិយក ថា ៨: ១៥) ព្រះយេ ហូវ៉ាក៏បានការពាររាស្ដ្រទ្រង់នៅទីនោះដែរ ។ ចុះយ៉ាងណាចំពោះពេលដែលពួកគេបានចូលទៅក្នុងស្រុកសន្យាវិញ ?
ជនជាតិកា ណានទាំងនោះ មានពលទ័ពខ្លាំងក្លាហើយខំទប់ទល់នឹងពួកអ៊ីស្រាអែល ។ យ៉ាងណាក៏ដោយ ព្រះយេ ហូវ៉ាមានប្រសាសន៍ទៅកាន់យ៉ូស្វេថា៖ « ចូររៀបចំឆ្លងទន្លេយ័រ ដាន់ឥឡូវនេះចុះ !
នៅក្នុងទីរហោឋាន តើព្រះយេ ហូវ៉ាបានថែទាំរាស្ដ្រទ្រង់តាមរបៀបណាខ្លះ ?
សូមគិតអំពីពាក្យសន្យាទីបីរបស់ព្រះយេ ហូវ៉ាដែលថាទ្រង់នឹងថែទាំរាស្ដ្រទ្រង់ ។ មិនយូរប៉ុន្មានក្រោយព្រះយេ ហូវ៉ាបានដោះជនជាតិអ៊ីស្រាអែលឲ្យរួចពីស្រុកអេ ស៊ី ប ទ្រង់សន្យាថា៖ « មើល !
អញនឹងបង្អុរភ្លៀងជានំប៉័ងពីលើមេឃមកឲ្យឯងរាល់គ្នា ត្រូវឲ្យបណ្ដា ជនចេញទៅរើសឲ្យល្មមតែ១ថ្ងៃរាល់ ៗថ្ងៃ » ។ ស្របទៅតាមពាក្យសន្យានោះ ព្រះយេ ហូវ៉ាបានប្រទាន« នំប៉័ងពីលើមេឃ »មែន !
អស់រយៈពេល៤០ឆ្នាំក្នុងទីរហោឋាននោះ ព្រះយេ ហូវ៉ាបានថែទាំជនជាតិអ៊ីស្រាអែលដោយប្រទានទឹកនិងអាហារ ។ ព្រះយេ ហូវ៉ាក៏បានថែទាំរាស្ដ្រទ្រង់ដោយធ្វើអព្ភូតហេតុកុំឲ្យសម្លៀកបំពាក់របស់ពួកគេសឹកទៅ ហើយមិនឲ្យជើងរបស់ពួកគេពុរពងឬហើមឡើយ ។ ( ចោទិយក ថា ៨: ៣, ៤) យ៉ូស្វេបានឃើញព្រឹត្ដិការណ៍ទាំងអស់នោះផ្ទាល់នឹងភ្នែក ។ ព្រះយេ ហូវ៉ាបានដោះរាស្ដ្រទ្រង់ឲ្យរួច ព្រមទាំងការពារនិងថែទាំពួកគេរហូត ស្របទៅតាមពាក្យសន្យារបស់ទ្រង់ ។
របៀបព្រះយេ ហូវ៉ាដោះរាស្ដ្រទ្រង់ឲ្យរួចនៅសព្វថ្ងៃនេះ
តើពាក្យទាំងនោះបង្កប់អត្ថន័យអ្វី ?
ចុះយ៉ាងណាចំពោះសម័យនេះ ?
នៅថ្ងៃសុក្រ ទី២ ខែតុលា ឆ្នាំ១៩១៤ បងប្រុសឆា ល្ស ថេ ហ្ស រ៉ា សិល ដែលជាអ្នកដឹកនាំពួកសិស្សគម្ពីរនៅសម័យនោះ គាត់បានដើរចូលបន្ទប់ដែលជាទីកន្លែងដែលគេបរិភោគអាហារក្នុងការិយាល័យបេ ត អែលនៅទីក្រុងប៊្រូ គ្លិន រដ្ឋញូ វយ៉ ក នាសហរដ្ឋអាម៉េរិក ។ គាត់មានទឹកមុខរីករាយ ហើយមានប្រសាសន៍ថា៖ « អរុណសួស្ដីបងប្អូនទាំងអស់គ្នា ! »
។ មុនគាត់អង្គុយចុះ គាត់បានប្រកាសដោយចិត្ដរំភើបថា៖ « គ្រារបស់សាសន៍ដទៃបានផុតកំណត់ហើយ !
។ ដូចនៅសម័យរបស់ពួកអ៊ីស្រាអែលនោះ កំណត់ពេលរបស់ព្រះយេ ហូវ៉ាជាមហាក្សត្រនៃសកលលោកទាំងមូលបានមកដល់ ឲ្យទ្រង់ចាត់វិធានការដើម្បីជួយរាស្ដ្ររបស់ទ្រង់ ។ គឺច្បាស់ហើយថា ព្រះយេ ហូវ៉ាបានចាត់វិធានការភ្លាម !
តើការរំដោះនោះបើកឱកាសឲ្យមានអ្វីកើតឡើង ?
ព្រះយេ ហូវ៉ាបានប្រគល់ឲ្យសាវ័កយ៉ូហានស្រមៃឃើញអ្នកទាំងនោះទុកជាមុន ហើយគាត់បានពណ៌នាអំពីពួកគេថា ជា« មនុស្ស១ហ្វូងយ៉ាងធំដែលគ្មានអ្នកណាអាចនឹងរាប់បានឡើយ គេមកពីគ្រប់ទាំងសាសន៍ គ្រប់ទាំងពូជមនុស្ស គ្រប់ទាំងគ្រួសារ ហើយគ្រប់ទាំងភាសា » ។ ក្នុងអំឡុងជីវិតរបស់អ្នក តើអ្នកបានឃើញចំនួនស្ម របន្ទាល់ព្រះយេ ហូវ៉ាកើនឡើងច្រើនប៉ុណ្ណា ?
នៅសព្វថ្ងៃនេះ ម្ដេចក៏ព្រះយេ ហូវ៉ាត្រូវតែការពាររាស្ដ្រទ្រង់ ?
យើងបានពិនិត្យមើលរួចហើយថា ជនជាតិអ៊ីស្រាអែលនៅសម័យយ៉ូស្វេបានពឹងទៅលើព្រះយេ ហូវ៉ា ឲ្យទ្រង់ជួយការពារពួកគេ ។ ចុះយ៉ាងណាចំពោះរាស្ដ្ររបស់ទ្រង់នៅសព្វថ្ងៃនេះ ?
តើអ្នកបានឃើញភ័ស្ដុតាងអ្វីខ្លះដែលបញ្ជាក់ថាព្រះយេ ហូវ៉ាការពាររាស្ដ្រទ្រង់ ?
សព្វថ្ងៃនេះ តើអ្នកទាំងនោះនៅតែមានអំណាចឬ ?
ព្រះយេ ហូវ៉ាក៏ការពារអ្នកទាំងនោះដែរ ដោយនឹកចាំពួកគេជានិច្ច ហាក់ដូចជាពួកគេរង់ចាំទ្រង់នៅកន្លែងដែលមានសុវត្ថិភាពជាទីបំផុត ។ ច្បាស់ហើយ ពាក្យសន្យារបស់ព្រះយេ ហូវ៉ាដែលថា ទ្រង់នឹងការពាររាស្ដ្រទ្រង់ ពិតជាបានសម្រេចគ្រប់ជំពូកមែន !
មនុស្សជាច្រើននឹងខំរកយល់ ហើយចំណេះនឹងបានចំរើនឡើង » ។ — ដានី យ៉ែល ១២: ៤
តើមានភ័ស្ដុតាងអ្វីដែលបញ្ជាក់ថាចំណេះពិតកំពុងចម្រើនឡើងនៅសព្វថ្ងៃនេះ ?
សកម្មពលរបស់ព្រះយេ ហូវ៉ាបាននាំមនុស្សពីគ្រប់ទិសទីនៃផែនដី ឲ្យទទួលចំណេះត្រឹមត្រូវអំពីព្រះពិតនិងគោលបំណងរបស់ទ្រង់ ។ នៅសព្វថ្ងៃនេះ គេបានបោះពុម្ពគម្ពីរច្រើន ហើយក៏មានសៀវភៅច្រើនទៀតដែរ ដែលបកស្រាយន័យគម្ពីរដើម្បីជួយមនុស្សឲ្យយល់នូវសេចក្ដីពិតក្នុងគម្ពីរដែលមានតម្លៃណាស់ ។ ជាឧទាហរណ៍ សូមគិតអំពីសៀវភៅសិក្សាដែលមានចំណងជើងថា តើព្រះគម្ពីរពិតជាបង្រៀនយ៉ាងណា ?
និង« ហេតុអ្វីព្រះឲ្យមនុស្សរងទុក្ខវេទនា ? »
។ រាប់ពាន់ឆ្នាំមកហើយ មនុស្សបានឆ្ងល់អំពីរឿងទាំងនេះ ។ តែឥឡូវនេះ យើងមានចម្លើយហើយ ។ ទោះបើមនុស្សបានស្ថិតក្នុងភាពល្ងង់ខ្លៅនិងមានគ្រិស្ដសាសនាមិនពិតបំភាន់ពួកគេអស់រាប់រយឆ្នាំហើយក៏ដោយ បណ្ដាំរបស់ព្រះយេ ហូវ៉ានៅតែផ្ដល់ចំណេះពិត ប្រៀបដូចជាអាហារដែលអាចពង្រឹងកម្លាំងដល់អស់អ្នកដែលប្រាថ្នាចង់បម្រើទ្រង់ ។
តើនេះនាំឲ្យអ្នកសន្និដ្ឋានយ៉ាងណា ?
ដូច្នេះ យកល្អឲ្យយើងទុកចិត្ដទៅលើបណ្ដាំរបស់ព្រះយេ ហូវ៉ាចុះ !
ហេតុអ្វីបានជាយើងអាចជឿថានឹងមានអនាគតដ៏ល្អបាន ?
ព្រះយេ ហូវ៉ាបានចាត់វិធានការដើម្បីដោះរាស្ដ្រទ្រង់ឲ្យរួច
នៅឯសមុទ្រក្រហម តើព្រះយេ ហូវ៉ាបានការពាររាស្ដ្រទ្រង់យ៉ាងណា ?
ការឈ្វេងយល់« សេចក្ដីជ្រាលជ្រៅនៃព្រះ »
ហេតុអ្វីក៏ចាំបាច់ម៉្លេះឲ្យយើងយល់ច្បាស់នូវមូលហេតុដែលយើងជឿទៅលើសេចក្ដីពិតក្នុងគម្ពីរ ?
ហេតុអ្វីបានជាចាំបាច់ម៉្លេះឲ្យយើងឈ្វេងយល់នូវ« សេចក្ដីជ្រាលជ្រៅ »ទាំងនោះ ?
តើការសិក្សាគម្ពីររួមបញ្ចូលអ្វីខ្លះ ?
តើសកម្មពលរបស់ព្រះយេ ហូវ៉ាជួយឲ្យឈ្វេងយល់« គ្រប់ទាំងអស់ »យ៉ាងដូចម្ដេច ?
ហេតុអ្វីបានជាមនុស្សជាច្រើនមិនយល់នូវ« សេចក្ដីជ្រាលជ្រៅនៃព្រះ » ?
ក្នុងជំពូកទី៣នៃសំបុត្រដែលប៉ុលសរសេរចំពោះក្រុម ជំនុំនៅទីក្រុងអេភេសូរ តើគាត់សំដៅទៅលើសេចក្ដីជ្រាលជ្រៅអ្វីខ្លះនៃព្រះ?
ដែលយើងមានឯក សិទ្ធិយល់អ្វីដែលពួកទេវតាចាប់អារម្មណ៍ចង់យល់ដែរ ។ បន្ទាប់មក ប៉ុលជូនយោបល់ថា យើងគួរខំព្យាយាមដើម្បីឲ្យ« យល់ជាមួយនឹងពួកបរិសុទ្ធទាំងអស់គ្នាពីទទឹង បណ្ដោយ ជំរៅនឹងកំពស់ »នៃជំនឿរបស់យើងជាគ្រិស្ដសាសនិក ។ ឥឡូវយើងសូមពិនិត្យមើលសេចក្ដីបង្រៀនដ៏ជ្រាលជ្រៅខ្លះ ៗ ដែលអាចជួយយើងឲ្យយល់នូវសេចក្ដីពិតក្នុងគម្ពីរកាន់តែច្បាស់ ។
តើបទគម្ពីរអ្វីខ្លះបង្ហាញថា គ្រិស្ដសាសនិកទាំងឡាយនៅផែនដីដែលមានសេចក្ដីសង្ឃឹមឡើងទៅស្ថាន សួគ៌ រួមគ្នាជា ‹ អ្នកបំរើស្មោះត្រង់ដែលមានវិនិច្ឆ័យល្អ › ?
ឧទាហរណ៍មួយទៀតពីសេចក្ដីបង្រៀនដ៏ជ្រាលជ្រៅដែលព្រះយេ ហូវ៉ាបានបើកសម្ដែងឲ្យយើងស្គាល់ គឺទាក់ទងនឹងគោលបំណងរបស់ទ្រង់ក្នុងការជ្រើសរើសមនុស្ស១៤៤.០០០នាក់ ។ យើងយល់និងជឿថា អស់អ្នកនៅផែនដីដែលមានសេចក្ដីសង្ឃឹមឡើងទៅស្ថាន សួគ៌ រួមគ្នាជា ‹ អ្នកបំរើស្មោះត្រង់ដែលមានវិនិច្ឆ័យល្អ › ដែលព្រះយេស៊ូពន្យល់ថា នឹងប្រទាន« អាហារ »ឲ្យពួកផ្ទះលោកតាមត្រូវពេល ។ តើបទគម្ពីរណាខ្លះបញ្ជាក់ពីការយល់ដឹងនេះ ?
ឬមួយក៏ តើព្រះយេស៊ូប្រហែលជានិយាយទូទៅវិញ ហើយសំដៅទៅលើគ្រិស្ដសាសនិកណាក៏ដោយ ដែលជួយពង្រឹងជំនឿឲ្យបងប្អូនគ្នីគ្នា ជាអ្នកបម្រើស្មោះត្រង់ ?
ព្រះយេ ហូវ៉ាមានប្រសាសន៍ទៅកាន់ជនជាតិអ៊ីស្រាអែលថា៖ « ឯងរាល់គ្នាជាស្ម របន្ទាល់របស់អញ ហើយជាអ្នកបំរើដែលអញបានរើសតាំង » ។ ( អេសាយ ៤៣ : ១០) ប៉ុន្ដែ នៅថ្ងៃទី១១ ខែណែ សាន ឆ្នាំ៣៣ គ.
ព្រះយេស៊ូបានមានប្រសាសន៍ទៅកាន់អ្នកធំដែលកំពុងដឹកនាំជនជាតិអ៊ីស្រាអែលថា ព្រះយេ ហូវ៉ាលែងទទួលស្គាល់ជនជាតិអ៊ីស្រាអែលជាអ្នកបម្រើរបស់ទ្រង់ទៀត ។ ព្រះយេស៊ូមានប្រសាសន៍ថា៖ « នគរព្រះនឹងត្រូវហូតចេញពីអ្នករាល់គ្នា ប្រគល់ទៅឲ្យសាសន៍១ទៀត ដែលគេនឹងបង្កើតផលរបស់នគរនោះ » ។ ព្រះយេស៊ូក៏មានប្រសាសន៍ទៅកាន់ហ្វូងមនុស្សថា៖ « មើល !
ផ្ទះឯងនឹងត្រូវចោលស្ងាត់ទុកឲ្យឯង » ។ ពេលពួកអ៊ីស្រាអែលជាអ្នកបម្រើព្រះយេ ហូវ៉ា ពួកគេមិនបានរក្សាឲ្យមានភាពស្មោះត្រង់ចំពោះទ្រង់ ហើយក៏គ្មានវិនិច្ឆ័យល្អទេ ។ ( អេសាយ ២៩: ១៣, ១៤ ) នៅថ្ងៃនោះឯងដែលព្រះយេស៊ូបានវិនិច្ឆ័យទោសពួកអ៊ីស្រាអែល ទ្រង់ក៏បានសួរសំណួរថា៖‹ តើអ្នកណាជាអ្នកបំរើស្មោះត្រង់ដែលមានវិនិច្ឆ័យល្អ ? ›
។ បើនិយាយឲ្យចំទៅ ព្រះយេស៊ូបានសួរថា ‹ តើជនជាតិមួយណាដែលមានវិនិច្ឆ័យល្អ ដើម្បីធ្វើជាអ្នកបម្រើស្មោះត្រង់របស់ព្រះយេ ហូវ៉ាជំនួសជនជាតិអ៊ីស្រាអែល ? ›
។ សាវ័កពេត្រុសបានឆ្លើយសំណួរនោះពេលដែលគាត់ជម្រាបក្រុម ជំនុំនៃពួកគ្រិស្ដសាសនិកដែលមានសេចក្ដីសង្ឃឹមឡើងទៅស្ថាន សួគ៌ថា៖ « អ្នករាល់គ្នា ...
ជាសាសន៍បរិសុទ្ធ ជារាស្ដ្រដ៏ជាកេរ្ដិ៍អាករនៃព្រះ » ។ មនុស្សមួយពួកដែលប្រៀបដូចជាជនជាតិថ្មីមួយនោះ ដែលគម្ពីរហៅថា « សាសន៍អ៊ីស្រាអែលនៃព្រះ » បានក្លាយទៅជាអ្នកបម្រើថ្មីរបស់ព្រះយេ ហូវ៉ា ។ បណ្ដា ជនទាំងឡាយ ដែលជាជនជាតិអ៊ីស្រាអែលពីបុរាណនោះ បានរួមគ្នាជា« អ្នកបំរើ »តែមួយ ។ ដូចគ្នាដែរ គ្រិស្ដសាសនិកទាំងឡាយនៅផែនដី ដែលមានសេចក្ដីសង្ឃឹមឡើងទៅស្ថាន សួគ៌ក៏រួមគ្នាជា« អ្នកបំរើ »មួយក្រុម ដែល ‹ ស្មោះត្រង់និងមានវិនិច្ឆ័យល្អ › ។ យើងពិតជាមានឯក សិទ្ធិពិសេសមែន !
សិក្សាដោយខ្លួនឯងនាំឲ្យមានអំណរ
ហេតុអ្វីបានជាការសិក្សាគម្ពីរនាំឲ្យយើងមានអំណរច្រើនជាងការអានត្រួស ៗតែប៉ុណ្ណោះ ?
ហេតុនេះហើយការសិក្សាគម្ពីរនាំឲ្យយើងមានអំណរច្រើនជាងការអានត្រួស ៗតែប៉ុណ្ណោះ ។ ដូច្នេះ ពេលអ្នកអានសៀវភៅនី មួយ ៗដែលអង្គការរបស់ព្រះយេ ហូវ៉ាបោះពុម្ពនោះ ចូរសួរខ្លួនឯងថា ‹ តើការពន្យល់នេះមានលក្ខណៈខុសគ្នាពីអ្វីដែលខ្ញុំយល់ពីមុនឬ ?
តើខ្ញុំស្គាល់បទគម្ពីរនិងហេតុផលឯទៀតដែលគាំទ្រចំណុចដែលបានបញ្ជាក់ក្នុងអត្ថបទនេះឬ ? ›
។ បើយល់មិនច្បាស់ទេ ចូរកត់សំណួរដែលអ្នកចង់ស្រាវជ្រាវថែមទៀត ហើយឆ្លៀតពេលនៅថ្ងៃក្រោយដើម្បីសិក្សាប្រធាននោះឲ្យបានល្អិតល្អន់ជាង ។
ធ្វើដូចម្ដេចឲ្យមានប្រយោជន៍យូរអង្វែងពីការស្រាវជ្រាវនោះ ?
តើយើងអាចសិក្សាស្រាវជ្រាវប្រធានណាខ្លះ ដើម្បីឲ្យមានអំណរក្នុងការឈ្វេងយល់គម្ពីរកាន់តែច្បាស់ ?
ជួយកូនឲ្យចូលចិត្ដសិក្សាគម្ពីរ
តើយើងអាចជួយកូនឲ្យចូលចិត្ដសិក្សាគម្ពីរដោយវិធីណាខ្លះ ?
ពេលសិក្សាស្រាវជ្រាវប្រធានផ្សេង ៗក្នុងគម្ពីរដោយខ្លួនឯង តើយើងត្រូវប្រយ័ត្ននឹងអ្វី ?
ពីព្រោះមានសេចក្ដីសន្យាមួយក្នុងគម្ពីរដែលថា អស់អ្នកដែលខំស្វែងរកចំណេះ នោះ ‹ នឹងស្គាល់ព្រះអង្គ › បាន ។ — សុភាសិត ២: ៤, ៥
