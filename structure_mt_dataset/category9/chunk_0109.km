កិច្ចបម្រើព្រះមានច្រើនយ៉ាង
ព្រះយេ ហូវ៉ាជួយយើងឲ្យរួចពីលប់របស់នាយព្រាន
ហេតុអ្វីបានជាយើងគួរប្រយ័ត្ននឹងវា ?
គ្រិស្ដសាសនិកពិតទាំងឡាយមានខ្មាំងសត្រូវមួយប្រៀបដូចជាសត្វព្រៃដែលចង់តែត្របាក់ស៊ីពួកគេ ។ ខ្មាំងនោះមានសតិបញ្ញាមិនធម្មតា ហើយក៏ឆ្លៀវ ឆ្លាតផង ។ បទទំនុក ដំកើងទី៩១ : ៣ ហៅវាថា ជា« នាយព្រាន » ។ តើខ្មាំងសត្រូវនេះជាអ្នកណា ?
ចាប់តាំងពីទស្សនាវដ្ដីប៉ម យាម ចុះថ្ងៃទី១ ខែមិថុនា ឆ្នាំ១៨៨៣ មកម៉្លេះ នេះបានសម្គាល់សាតាំងដែលជាមេកំណាចថា ជានាយព្រាននោះឯង ។ សត្រូវនេះឆ្លាតណាស់ ហើយវាខំរកមធ្យោបាយដើម្បីបំភាន់រាស្ដ្ររបស់ព្រះយេ ហូវ៉ានិងនាំពួកគេឲ្យវង្វេង ដូចជាព្រានបក្សីរៀបលប់ដើម្បីចាប់សត្វស្លាប ។ *
ហេតុអ្វីបានជាគម្ពីរប្រៀបធៀបសាតាំងទៅនឹងនាយព្រាន ?
ហេតុអ្វីក៏ការ ‹ ខ្លាចមនុស្ស › មានឥទ្ធិពលខ្លាំងដល់ម៉្លេះ ?
ប្រហែលជាដោយសារគាត់សេព គប់ជាមួយពួកម៉ាកមិនល្អ ហើយគាត់មិនហ៊ានបដិសេធ ក្រែង លោពួកគេចំអកមើលងាយគាត់វិញ ។ ប្អូន ៗយុវជនយុវតីទាំងឡាយអើយ !
បើប្អូន ៗមិនចង់ឲ្យវាចាប់ប្អូនជាប់ទេ ចូរឃាត់ចិត្ដកុំបណ្ដោយខ្លួនធ្វើខុសនឹងច្បាប់ព្រះយេ ហូវ៉ាឡើយ !
តើអ្នកជឿថា ពេលធ្វើតាមឆន្ទៈរបស់ព្រះយេ ហូវ៉ា ទ្រង់នឹងរកវិធីថែទាំអ្នកនឹងក្រុមគ្រួសាររបស់អ្នកឬទេ ?
ឬមួយក៏ តើមេកំណាចអាចចាប់អ្នកបាន ដោយល្បួងអ្នកឲ្យធ្វើតាមចិត្ដវាពីព្រោះអ្នកខ្លាចមនុស្សទេ ?
យើងសូមលើកទឹកចិត្ដបងប្អូនឲ្យអធិស្ឋានសូមព្រះយេ ហូវ៉ាជួយអ្នកឲ្យគិតវែងឆ្ងាយអំពីសំណួរទាំងនេះ ។
ហេតុអ្វីបានជាគ្រិស្ដសាសនិកខ្លះទាក់ជាប់ដោយចំណង់ចង់បានវត្ថុទ្រព្យ ?
ចុះយ៉ាងណាចំពោះយើងវិញ ?
តើចំណង់ចង់បានវត្ថុទ្រព្យជំរុញយើងឲ្យលែងចាត់ទុកកិច្ចបម្រើព្រះជាអាទិភាពឬទេ ?
បើយើងមានចិត្ដគំនិតស្រឡាញ់វត្ថុទ្រព្យយ៉ាងនេះ ។
ទាក់ជាប់ដោយការកម្សាន្ដមិនល្អ
តើគ្រិស្ដសាសនិកម្នា ក់ ៗគួរពិនិត្យមើលចិត្ដគំនិតរបស់ខ្លួនស្ដីអំពីអ្វី ?
តើអ្វីបង្ហាញថា ការព្រមានឲ្យប្រុងប្រយ័ត្ននឹងកម្មវិធីទូរទស្សន៍ដែលយើងមើល នៅតែមានប្រយោជន៍ ?
តើបងប្អូនខ្លះមានប្រសាសន៍យ៉ាងណាអំពីប្រយោជន៍ដែលពួកគេបានទទួលពីការព្រមានអំពីកម្មវិធីទូរទស្សន៍ ?
តើរឿងទាំងនោះអាចមានឥទ្ធិពលទៅលើចំណងមិត្ដ ភាពរបស់ខ្ញុំជាមួយព្រះយេ ហូវ៉ាទេ ?
។ ប្រសិនបើកម្មវិធីទូរទស្សន៍២៥ឆ្នាំមុន មានឥទ្ធិពលអាក្រក់ទៅលើចិត្ដគំនិតរបស់មនុស្ស ចុះយ៉ាងណាវិញចំពោះកម្មវិធីនៅសព្វថ្ងៃនេះ តើអាចមានឥទ្ធិពលខ្លាំងប៉ុណ្ណាមកលើយើង ?
យើងត្រូវតែប្រុងប្រយ័ត្ននឹងការកម្សាន្ដគ្រប់បែបយ៉ាងដែលសាតាំងប្រើដូចជាលប់ មិនថាជារឿងស្នេហាលន្លង់លន្លោចតាមកញ្ចក់ទូរទស្សន៍ ហ្គេមវីដេអូដ៏សាហាវឃោរឃៅ ឬវីដេអូចម្រៀងដែលមានរូបភាពនិងពាក្យអាសអាភាសជាដើម ។
ទាក់ជាប់ដោយការខ្វែងគំនិត
តើមេកំណាចទាក់ជាប់បងប្អូនខ្លះដោយរបៀបណា ?
បើអ្នកខ្វែងគំនិតនឹងបងប្អូនគ្រិស្ដសាសនិក តើអ្នកអាចធ្វើយ៉ាងណា ?
បានរួចខ្លួនដោយស្ថិតក្នុង« ទីកំបាំងនៃព្រះដ៏ខ្ពស់បំផុត »
នៅក្នុងសម័យដែលពោរពេញទៅដោយគ្រោះថ្នាក់នេះ តើយើងគួរមានទស្សនៈយ៉ាងណាចំពោះ« ទីកំបាំង »និង« ម្លប់ »របស់ព្រះយេ ហូវ៉ា ?
យើងរស់នៅក្នុងសម័យដែលពោរពេញទៅដោយគ្រោះថ្នាក់ ។ បើព្រះយេ ហូវ៉ាមិនបានការពារយើង សាតាំងច្បាស់ជានឹងបំផ្លាញយើងឲ្យអស់តែម្ដង ។ ដូច្នេះ បើយើងមិនចង់ឲ្យ« នាយព្រាន »ទាក់យើងជាប់ យើងត្រូវតែពួននៅក្នុង« ទីកំបាំងនៃព្រះដ៏ខ្ពស់បំផុត » ហាក់ដូចជាយើង« ជ្រកនៅក្រោមម្លប់នៃព្រះដ៏មានគ្រប់ព្រះចេស្តា » ដែលមានន័យថា យើងពឹងទៅលើព្រះយេ ហូវ៉ាជាអ្នកជួយការពារ ។ — ទំនុក ដំកើង ៩១ : ១
តើអ្នកចូលចិត្ដការកម្សាន្ដដែលព្រះយេ ហូវ៉ាស្អប់ឬ ?
តើចាំបាច់ខ្វល់ពីថ្ងៃស្អែកឬ ?
។ ឬក៏អ្នកប្រហែលជាបានឮអ្នកដទៃនិយាយថា « សូមតែមួយរស់ប៉ុណ្ណោះ » « គិតតែពីសប្បាយទៅ ! »
អ្វីផ្សេងទៀតមិនសំខាន់ទេ » ។ មនុស្សនៅសម័យលោកប៉ុលដែលជាសាវ័ករបស់ព្រះយេស៊ូក៏មានទស្សនៈដូចគ្នាដែរ ។ ពួកគេបាននិយាយថា៖ ‹ ចូរយើងស៊ីផឹកទៅចុះ !
ចំពោះមនុស្សរាប់លាននាក់ឯទៀត ពួកគេមិនដែលគិតពីការស៊ីផឹកសប្បាយទេ ពីព្រោះកាលៈទេសៈក្នុងជីវិតបង្ខំឲ្យពួកគេសូមតែមួយរស់សឹងតែមិនបានផង ។ តើបានប្រយោជន៍អ្វីឲ្យគិតពីថ្ងៃស្អែក បើពួកគេនៅតែលំបាកវេទនាដដែល ?
តើគួរគិតពីថ្ងៃស្អែកឬ ?
សូម្បីតែមនុស្សដែលមិនសូវលំបាកវេទនា ក៏ខ្ជិលគិតពីអនាគតដែរ ។ អ្នកខ្លះនិយាយថា « ចាំបាច់គិតធ្វើអី ? »
តើលោកអ្នកគិតយ៉ាងណា ?
តើគប្បីឲ្យយើងគិតតែមួយរស់ប៉ុណ្ណោះ ដោយមិនខ្វល់ពីថ្ងៃស្អែកឬ ?
សូមពិចារណាយោបល់ក្នុងអត្ថបទបន្ទាប់ ។
អ្វីផ្សេងទៀតមិនសំខាន់ទេ »
ប្រសិនបើពួកគេបានគិតវែងឆ្ងាយនិងរៀបចំទុកជាមុន តើទីក្រុងនោះអាចទទួលការហិនហោចតិចជាងឬ ?
ចាំបាច់គិតពីថ្ងៃស្អែក !
តើនេះបង្កប់អត្ថន័យថា គប្បីឲ្យយើងគិតតែមួយរស់ប៉ុណ្ណោះ ដោយមិនខ្វល់ពីថ្ងៃស្អែកឬ ?
តើព្រះយេស៊ូនិងអ្នកកាន់តាមលោកពិតជាមានគំនិតដូច្នេះឬទេ ?
សូមអានពាក្យទាំងឡាយដែលព្រះយេស៊ូបាននិយាយនៅពេលនោះ ដែលមានដូចតទៅ ។ សរុបសេចក្ដី ព្រះយេស៊ូមានប្រសាសន៍ថា៖ ‹ កុំឲ្យខ្វល់ខ្វាយនឹងជីវិត ដែលនឹងបរិភោគអ្វី ឬនឹងរូបកាយដែលនឹងស្លៀកពាក់អ្វីនោះឡើយ ។ ចូរពិចារណាពីសត្វស្លាបនៅលើអាកាស វាមិនសាបព្រោះ មិនច្រូតកាត់ឬប្រមូលដាក់ក្នុងជង្រុកផង តែបិតានៅស្ថានសួគ៌ចិញ្ចឹមវា ។ ចុះនៅក្នុងពួកអ្នករាល់គ្នា តើមានអ្នកឯណាដែលអាចនឹង ដោយសារសេចក្ដីខ្វល់ខ្វាយបានឬទេ ?
ចូររំពឹងគិតតែពីផ្កាឈូកនៅក្នុងបឹងដែលដុះជាយ៉ាងដូចម្ដេច គឺវាមិននឿយហត់នឹងធ្វើការឬស្រាវរវៃទេ ។ ដូច្នេះ កុំឲ្យខ្វល់ខ្វាយថា តើត្រូវបរិភោគអ្វីឬស្លៀកពាក់អ្វីនោះឡើយ ។ គឺជាសាសន៍ដទៃទេតើ ដែលខំស្វែងរករបស់ទាំងនោះវិញ ។ ឯបិតានៅស្ថាន សួគ៌ជ្រាបហើយ ថាអ្នករាល់គ្នាត្រូវការរបស់ទាំងនោះដែរ › ។ — ម៉ាថា យ ៦: ២៥-៣២; ខ.
ពេលនិយាយបញ្ចប់ ព្រះយេស៊ូជូនយោបល់ពីរយ៉ាង ។ មុនដំបូង ព្រះយេស៊ូមានប្រសាសន៍ថា៖ « ចូរស្វែងរកនគរនឹងសេចក្ដីសុចរិតនៃព្រះជាមុនសិន ទើបគ្រប់របស់ទាំងនោះនឹងបានប្រទានមកអ្នករាល់គ្នាថែមទៀតផង » ។ ទី ពីរ ព្រះយេស៊ូជូនយោបល់ថា៖ « ដូច្នេះ កុំឲ្យខ្វល់ខ្វាយនឹងថ្ងៃស្អែកឡើយ » តែ« ចាំស្អែកសឹមគិតពីរឿងថ្ងៃស្អែកទៅ ! »
បិតានៅស្ថានសួគ៌ជ្រាបពីអ្វីដែលយើងត្រូវការ
តើពាក្យរបស់ព្រះយេស៊ូស្តាប់ទៅដូចជាអ្នកកាន់តាម ដែលរួមបញ្ចូលពួកកសិករផង មិនគួរ ‹ សាបព្រោះ ច្រូតកាត់ឬប្រមូលផលទុកក្នុងជង្រុក › ឬ ?
តើស្តាប់ទៅដូចជាព្រះយេស៊ូមិនចង់ឲ្យពួកគេធ្វើការ ‹ នឿយហត់ក្នុងការស្រាវរវៃ › ដើម្បីឲ្យមានក្រណាត់សម្រាប់កាត់ដេរជាសម្លៀកបំពាក់ឬ ?
ចុះយ៉ាងណាចំពោះការខ្វល់ខ្វាយវិញ ?
ពួកគេជៀសទាំងស្រុងមិនបានទេ ។ សូម្បីតែព្រះយេស៊ូក៏ធ្លាប់មានចិត្ដអន្ទះអន្ទែងពន់ប្រមាណដែរ នៅរាត្រីនោះដែលសត្រូវបានចាប់លោក ។ — លូកា ២២: ៤៤
ដូច្នេះ យោបល់របស់ព្រះយេស៊ូពិតជាមានប្រយោជន៍មែន !
ជាពិសេសពេលមានបញ្ហាគាបសង្កត់លើយើង ដែលអាចបង្កហេតុឲ្យយើងខ្វល់ខ្វាយហួសល្បត់ ។
មនុស្សនៅសម័យព្រះយេស៊ូក៏ចេះចង់បានវត្ថុទ្រព្យដែរ ។ ពួកគេបានចាត់ទុកទ្រព្យសម្បត្ដិជាអ្វីដែលមានអាទិភាពក្នុងជីវិត ។ ប៉ុន្ដែ ព្រះយេស៊ូបានលើកទឹកចិត្ដអ្នកដែលស្តាប់លោកឲ្យមានទស្សនៈផ្សេងវិញ ។ អ្នកស្តាប់ទាំងនោះជាជនជាតិយូដាដែលបានថ្វាយខ្លួនជាអ្នកបម្រើព្រះយេ ហូវ៉ា ដូច្នេះ ‹ ការដែលពួកគេត្រូវធ្វើ › គឺ« កោតខ្លាចដល់ព្រះ ហើយកាន់តាមបញ្ញ ត្ដ »ព្រះផង ។ — សាស្តា ១២: ១៣; ខ.
លោកចង់បញ្ជាក់ន័យថា ថ្ងៃនេះយើងមានកង្វល់ល្មមគ្រប់គ្រាន់ហើយ ដូច្នេះកុំឲ្យយើងខ្វល់ខ្វាយហួសហេតុពេកពីអ្វីដែលនឹងកើតឡើងនៅថ្ងៃស្អែក ។ គម្ពីរមួយទៀត (Today’s English Version) បកប្រែឃ្លានេះថា៖ « កុំខ្វល់ខ្វាយអំពីថ្ងៃស្អែក ពីព្រោះព្រឹត្ដិការណ៍នៅថ្ងៃស្អែកនឹងផ្ដល់ហេតុផ្សេងឲ្យខ្វល់ខ្វាយដែរ ។ ដោយសារយើងមានបញ្ហាផ្សេង ៗរៀងរាល់ថ្ងៃ នោះគ្មានប្រយោជន៍ទេ ឲ្យយើងខ្វល់អំពីថ្ងៃស្អែក » ។ — ម៉ាថា យ ៦: ៣៤
ចូរឲ្យយើង« ទន្ទឹងចាំ »ថ្ងៃជំនុំជម្រះរបស់ព្រះយេ ហូវ៉ាចុះ !
តើយើងគួរធ្វើដូចម្ដេច ?
តើលោកអ្នកត្រូវការជំនួយដើម្បីឲ្យយល់នូវសារក្នុងគម្ពីរឬទេ ?
បើត្រូវការជំនួយមែន សូមអញ្ជើញស្នើសុំជំនួយពីពួកស្ម របន្ទាល់ព្រះយេ ហូវ៉ា ឬសរសេរសំបុត្រស្នើសុំជំនួយពីអង្គការដែលបោះពុម្ពទស្សនាវដ្ដីនេះ ។ សរុបសេចក្ដី បើយើងចង់បានអនាគតដ៏ល្អអស្ចារ្យ នោះចាំបាច់ណាស់ឲ្យយើងគិតពីថ្ងៃស្អែកមែន !
ម្ដងម្កាលយើងឮដំណឹងអំពីមនុស្សដែលបានជួយសង្គ្រោះជីវិតអ្នកដទៃ ហើយជួនកាលពួកគេក៏សុខចិត្ដផ្សងគ្រោះថ្នាក់ដើម្បីជួយអ្នករងគ្រោះ ។ មនុស្សជាច្រើនចាត់ទុកមនុស្សបែបនោះ ជាវីរ បុរសដែលក្លាហានណាស់ !
ប៉ុន្ដែ បុរសម្នាក់ដែលបានជួយប្អូនប្រុសម្នាក់ទៀតបានមានប្រសាសន៍ថា៖ « យើងគួរតែជួយគេ ។ ខ្ញុំមិនចង់ឲ្យនរណាម្នាក់សរសើរត ម្កើងទេ តែខ្ញុំគ្រាន់តែចង់ជួយគាត់ប៉ុណ្ណោះ » ។
ហេតុអ្វីក៏ស្មារតីលះបង់របស់មនុស្សដែលចង់ជួយអ្នកដទៃ មិនស៊ីគ្នានឹងទ្រឹស្ដីវិ វត្ដ ន៍ ?
យើងកំពុងរស់នៅ« ជាន់ក្រោយបង្អស់ » ដែលជា« គ្រាលំបាកណាស់ » ហើយមនុស្សជាច្រើន« មានចិត្ដសាហាវ »និង« មិនចូលចិត្ដនឹងការល្អ »សោះ ។ យ៉ាងណាក៏ដោយ យើងប្រហែលជាធ្លាប់ឃើញមនុស្សជួយអ្នកដទៃ ឬធ្លាប់មានគេជួយយើងក៏មិនដឹង ។ ដោយសារមនុស្សជាច្រើនមានចិត្ដល្អ ហើយចង់ជួយអ្នកដទៃ នេះបណ្ដាលឲ្យមហាជនមានទស្សនៈថា មនុស្សមានទំនោរចិត្ដនេះតាំងពីកំណើត ។
បើ ហ្សែនរបស់មនុស្សមានទំនោរចិត្ដចង់កើនឡើងតែឯង ដោយមិនគិតដល់ប្រយោជន៍អ្នកដទៃ នេះគឺខុសស្រឡះពីទំនោរចិត្ដរបស់មនុស្សដែលមានស្មារតីលះបង់វិញ » ( សាស្ត្រា ចារ្យ Francis S .
ហេតុអ្វីក៏មនុស្សទាំងអស់ត្រូវតែទទួលខុសត្រូវចំពោះព្រះដែលបានបង្កើតរបស់សព្វ សារពើ ?
តើមនុស្សច្រើនប៉ុណ្ណាមានសមត្ថភាពត្រិះរិះរាវរកហេតុផលឲ្យឃើញច្បាស់នូវភាពយុត្ ដិ ធម៌និងអ យុត្ ដិ ធម៌ ?
។ សូមគិតទៅមើល ម្ដេចបានជាកូនក្មេងខ្លះដឹងពីអ្វីដែលខុសនិងត្រូវទោះជាគ្មានអ្នកណាប្រាប់ក្ដី ?
ពាក្យ « កាលណា »ឬ ‹ ពេលណា › នោះ បង្កប់អត្ថន័យថា ពួកគេច្រើនតែ ‹ ប្រព្រឹត្ដតាមក្រិត្យវិន័យដោយឯកឯង › ។ ដូច្នេះ វិចារណញ្ញាណជំរុញពួកគេឲ្យប្រព្រឹត្ដបែបសំណំនឹងអ្វីដែលយើងធ្លាប់អានក្នុងក្រឹត្យវិន័យរបស់ព្រះ ។
វិចារណញ្ញាណ បញ្ញាចិត្ដ មនសិការដំណើរការយ៉ាងណា ?
