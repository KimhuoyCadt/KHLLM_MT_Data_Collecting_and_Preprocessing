តើអ្វីនឹងជួយយើងឲ្យបំពេញតាមគោលបំណងពិតក្នុងជីវិត ?
ក្នុងនាមជាគ្រិស្ដសាសនិក យើងមានឯក សិទ្ធិពិសេសជាអ្នកដែលស្គាល់ព្រះ ហើយមានចំណេះដែលផ្ដល់ហេតុឲ្យយើងសង្ឃឹមទទួលសេចក្ដីសង្គ្រោះ ។ បើដូច្នេះ កុំឲ្យយើង« ទទួលព្រះគុណរបស់ព្រះដោយបែបឥតប្រយោជន៍ » ឬ« ទុកចោលជាអសារឥតការឡើយ » ។ ផ្ទុយទៅវិញ ចូរឲ្យយើងយកពេលដែលមានតម្លៃក្នុងជីវិតយើងសរសើរព្រះយេ ហូវ៉ាចុះ !
ពេលធ្វើការសម្រេចចិត្ដអំពីអ្វីដែលគួរនឹងលះចោលនោះ ពួកគ្រិស្ដសាសនិកត្រូវតែប្រុងប្រយ័ត្នដែរ
វិធីបំពេញតាមគោលបំណងរបស់ព្រះក្នុងជីវិតសព្វថ្ងៃនេះ
ហេតុអ្វីបានជាសាសន ទូតនិងគ្នីគ្នារបស់គាត់បានធ្វើការនឿយហត់បែបនោះ ?
តើយើងអាចបម្រើព្រះយេ ហូវ៉ាដោយរបៀបណាខ្លះ ?
ការជឿនទៅមុខដោយសម្រេចការជាបណ្ដើរ ៗ
តើការធ្វើតាមបំណងចិត្ដរបស់ព្រះយេ ហូវ៉ាតម្រូវឲ្យយើងសម្រេចការអ្វីខ្លះ ?
បើយើងចេះតែខ្វល់ខ្វាយដោយឥតហេតុ តើយើងអាចយកឈ្នះលើកង្វល់ទាំងនោះដោយរបៀបណា ?
តើពួកគេនឹងស្រឡាញ់ខ្ញុំឬ ?
ហេតុអ្វីក៏សំខាន់ម៉្លេះឲ្យយើងមានផែនការក្នុងជីវិតដើម្បីបំពេញតាមគោលបំណងរបស់ព្រះ?
សូមរៀបរាប់ឧទាហរណ៍មួយដែលបង្ហាញពីរបៀបដែលយើងអាចកែប្រែបាន ដើម្បីឲ្យមានគោលបំណងសមស្របនឹងគោលបំណងរបស់ព្រះយេ ហូវ៉ា ។
ឯងមានអាយុ៣០ឆ្នាំហើយ តែមិនដែលបំពេញគោលបំណងល្អអ្វីសោះក្នុងជីវិត ! ›
ចូររៀនឲ្យចេះប្រមាណកម្លាំងខ្លួន
ហេតុអ្វីក៏សំខាន់ម៉្លេះឲ្យយើងចេះប្រមាណកម្លាំងខ្លួនក្នុងកិច្ចបម្រើព្រះ?
ពេលគ្រិស្ដសាសនិកម្នាក់នេះបានព្យាយាមបម្រើព្រះយេ ហូវ៉ាយ៉ាងអស់ពីសមត្ថភាព និងប្រកបការងារអស់ពីកម្លាំងផងដែរ តើមានលទ្ធផលអ្វី ?
តើកិច្ចការផ្សព្វផ្សាយរបស់យើងអាចមានឥទ្ធិពលយ៉ាងណាទៅលើមនុស្សដទៃ ?
ចូរចាត់ទុកការបំពេញតាមគោលបំណងរបស់ព្រះ ជាអាជីព
ក្រៅពីកិច្ចបម្រើជាមួយក្រុម ជំនុំនាតំបន់ខ្លួន តើយើងអាចមានឱកាសបម្រើការនៅកន្លែងណាទៀត ?
តើអ្នកគួរជ្រើសរើសបំពេញតាមកិច្ចបម្រើបែបណា ?
បើអ្នកប្រាថ្នាចង់ធ្វើកិច្ចបម្រើព្រះពេញពេលដែរ តើអ្នកគួរធ្វើអ្វីខ្លះ ?
តើអ្នកអាចបំពេញតាមគោលបំណងរបស់ព្រះយេ ហូវ៉ាដោយចាត់ទុកកិច្ចបម្រើពេញពេលជាអាជីពបានទេ ?
តើការបំពេញតាមគោលបំណងរបស់ព្រះយេ ហូវ៉ាអាចនាំឲ្យមានលទ្ធផលអ្វីខ្លះ ?
ចូរនិយាយជាមួយបងប្អូនខ្លះដែលបានបម្រើព្រះយេ ហូវ៉ាយ៉ាងយូរ ជាពិសេសបងប្អូនណាដែលបានធ្វើកិច្ចបម្រើពេញពេលច្រើនឆ្នាំទៅហើយ ។ ពួកគាត់គាប់ចិត្ដនិងជីវិតដែលមានន័យខ្លឹមសារណាស់ !
តើអ្វីនាំឲ្យពួកគ្រិស្ដសាសនិកមានជីវិតសប្បាយដែលមានន័យខ្លឹមសារ ?
ហេតុអ្វីក៏សំខាន់ម៉្លេះឲ្យយើងបំពេញតាមគោលបំណងរបស់ព្រះក្នុងជីវិតសព្វថ្ងៃនេះ ?
ចុះយ៉ាងណាចំពោះអ្នកផ្ទាល់ ?
តើអ្នកកំពុងបំពេញតាមគោលបំណងអ្វីក្នុងជីវិតសព្វថ្ងៃនេះ ?
បើអ្នកមិនមានគោលដៅជាក់លាក់ក្នុងការបំពេញតាមគោលបំណងរបស់ព្រះយេ ហូវ៉ា អ្នកច្បាស់ជានឹងបែរទៅជាជាប់រវល់នឹងកិច្ចការបន្ទាប់បន្សំវិញ ។ តើការដេញតាមអ្វី ៗក្នុងពិភពលោកនេះរបស់សាតាំងមានប្រយោជន៍ទេ ?
មិនយូរប៉ុន្មានទៀត ពេលដែលគ្រា« វេទនាជាខ្លាំង »ចាប់ផ្ដើមនោះ ទ្រព្យសម្បត្ដិនិងមុខមាត់ធំដុំក្នុងពិភពលោកនេះនឹងគ្មានតម្លៃអ្វីសោះ !
នៅគ្រានោះ មានតែចំណងមិត្ដ ភាពជាមួយព្រះយេ ហូវ៉ាប៉ុណ្ណោះ ដែលមានតម្លៃ ។ ដូច្នេះ នៅពេលនោះឯង យើងនឹងមានចិត្ដរីករាយមែន !
ដែលយើងបានបម្រើព្រះយេ ហូវ៉ាព្រមទាំងអ្នកដទៃ និងបំពេញតាមគោលបំណងរបស់ទ្រង់ក្នុងជីវិតយើង ។ — ម៉ាថា យ ២៤ : ២១; វិវរណៈ ៧: ១៤, ១៥
