15 ដែលទ្រង់នឹងសម្ដែងឲ្យឃើញនៅពេលវេលារបស់ទ្រង់ គឺ ជាអ្នកដែលមាន ពរហើយ តែមួយគត់ ជាស្តេចនៃ អស់ទាំងស្តេច និងជាព្រះ នៃ អស់ទាំងអស់
ពិតប្រាកដ ណាស់ ទី សំគាល់ របស់ សាវ័ក មួយ រូប បាន កើត នៅក្នុង ចំណោម អ្នក រាល់គ្នា ដោយ ការអត់ធ្មត់ ក្នុង ទី សំគាល់ ការអស្ចារ្យ និង ការអស្ចារ្យ និង ការប្រព្រឹត្ដ ដ៏ ខ្លាំងក្លា ។ » ( កូរិន ថូស ទី២ ១២:១០ - ១២) ។
ឈ្មោះត្រូវបានគេដាក់ឲ្យដោយ ស ត្រូវរបស់ពួកគេ ក្នុងគោលបំណង ចំអកឲ្យពួកគេ ។
ធ្វើឱ្យ ពួកគេ ស្ទាក់ស្ទើរ ក្នុង វិធី ជាច្រើន ។
ដោយ សារ ការណ៍នេះ មនុស្សទាំងអស់នឹងដឹងថា អ្នក រាល់គ្នាជាសិស្សរបស់ខ្ញុំ បើអ្នក រាល់គ្នាស្រឡាញ់គ្នាទៅវិញទៅ មក » ។
‹ លោកយេស៊ូបានចូលទៅក្នុងផ្ទះមួយ ហើយមានហ្វូងមនុស្ស មកជុំគ្នាម្ដងទៀត ដើម្បីកុំឲ្យលោកនិងពួកសិស្សរបស់លោកសូម្បីតែបរិភោគផង › ។
គ្មានអ្នក ណាអាចមើលមុខខ្ញុំបានឡើយ » ។
នាំចូល៖ អ្នក អាច ប្រើ អ្នកជំនួយការនាំចូល និង នាំចេញ ដើម្បី នាំចូល ទិន្នន័យ ពី ប្រភព ផ្សេង ទៀត ។
« ព្រោះបើអ្នកលះបង់ការ ភ័យខ្លាច នោះអ្នកនឹងឈប់អធិស្ឋាន ។
របស់ អ្នក ច្រើន ដូច្នេះ ប្រសិនបើ អ្នកទិញ ពាក្យ ពិត នៃ ប្រាជ្ញា ។
ចូរអង្វរ រកព្រះនាមព្រះ របស់អ្នក ប៉ុន្តែកុំដុតភ្លើងឡើយ » ។
ប្រជាជាតិទាំងអស់ដែលភ្លេចព្រះ នឹងត្រូវវិនាស ។
ហើយពួកគេនឹង រស់នៅយ៉ាងសុខសាន្ត ដ្បិតឥឡូវនេះ ទ្រង់ជាធំ ដល់ចុងផែនដី ។
នេះ ជារឿងថ្មីសម្រាប់ខ្ញុំ ប៉ុន្តែខ្ញុំត្រូវនិយាយថា វាជាគំនិតល្អណាស់ពីរដ្ឋាភិបាល ។
ចាប់ពី ថ្ងៃ នោះ មក សមុទ្រ កាន់តែ ក្តៅ បន្តិច ។
ហើយទ្រង់នឹង សោយរាជ្យលើ វង្សយ៉ាកុបជារៀងរហូត ហើយរាជាណាចក្ររបស់ទ្រង់នឹងគ្មាន ទី បញ្ចប់ឡើយ ។
៤ លោកត្រូវឆ្លងកាត់ស្រុកសាម៉ារី ។
ហើយពួកគេមិនចង់បានអ្វីដែលជាកម្មសិទ្ធិនោះទេ » ។
មនុស្ស គឺជា ស្នាដៃ របស់ ព្រះ។
ដែល គាត់ ត្រូវបាន គេ លើកឡើង ។
( ខ្ញុំមានការ យល់ឃើញទាបណាស់ )
16 បើយើងខ្វល់ខ្វាយ អ្វី ៗដែលព្រះ បានដកពីឪពុកយើងជារបស់យើង និងកូនចៅរបស់យើង ដូច្នេះ ចូរធ្វើតាមអ្វីដែលព្រះ បានបង្គាប់ឲ្យធ្វើ » ។
សាវ័កបានបន្តថ្លែង ទី បន្ទាល់យ៉ាងខ្លាំងអំពី ការ រស់ឡើងវិញរបស់ព្រះអម្ចាស់យេស៊ូវ ។
ពេលអ្នកធ្វើដូច្នេះ អ្នកនឹងត្រូវបានចូលក្នុងការ រស់ឡើងវិញដំបូង ។
បើអ្នកចង់បាន វិធីថ្មី អ្នកត្រូវជ្រើសរើសរដ្ឋាភិបាលថ្មី » ។
វាគឺជារឿងមួយដែលប្លែកពីគេ ។
ពួកគេគិតថាពួកគេនឹងចាកចេញក្នុងជីវិតនេះ ប៉ុន្តែពួកគេនឹងមិនរួចខ្លួនក្នុងថ្ងៃអនាគតឡើយ » ។
៤ នេះជាដើមអូលីវពីរ និងជើង ចង្កៀងទាំងពីរ ដែលឈរនៅចំពោះព្រះភក្ត្រព្រះអម្ចាស់នៃផែនដី ។
សហគមន៍របស់ខ្ញុំត្រូវការ វា ហើយខ្ញុំរំភើប ចិត្តក្នុងការ បង្កើតវាសម្រាប់ពួកគេ » ។
យើងជាអ្នកជួលរបស់ទ្រង់ ហើយយើងទាំងអស់គ្នា ហើយយើងទាំងអស់គ្នាជាកម្មសិទ្ធិរបស់ទ្រង់ ។
កាលទ្រង់មានព្រះជន្ម១២ វស្សា គេក៏ឡើងទៅបុណ្យតាមទំនៀម ទម្លាប់ ។
តើអ្នកចង់ទទួលបានបទពិសោធន៍នៃការ អភ័យទោស និងជីវិតដ៏អស់ កល្ប ដែលព្រះយេស៊ូវ គ្រីស្ទបានយាងមកក្នុងពិភពលោកដើម្បីប្រទានដល់អ្នកដែរឬទេ ?
« អ្នក ណាដែលជឿលើខ្ញុំ អ្នកនោះមិនជឿ តែលើខ្ញុំទេ គឺជឿលើព្រះអង្គដែលចាត់ខ្ញុំឲ្យ មក ។
គឺជាកូនចៅរបស់សេត ដែលគេហៅដូច្នេះ
ខ្ញុំនឹងខិតខំធ្វើឲ្យអ្នកទទួលបានរង្វាន់យ៉ាងច្រើន » ។
ដើម្បីឱ្យ ព្រលឹង ដាក់ ពួកគេ នៅក្នុង ស៊ុម ខាងស្តាំ នៃ ចិត្ត ។
ខ្ញុំបម្រើរបស់ខ្ញុំនឹងបានអ្វីដែលគាត់សុំ » ។
បើជាព្រះហឫទ័យរបស់ព្រះ នោះត្រូវរងទុក្ខព្រោះ តែអំពើ ល្អ ប្រសើរជាងធ្វើអំពើអាក្រក់ ។
និង ជាច្រើន សតវត្ស ដែល ពួកគេ ស្ទើរតែ ត្រូវបាន បំភ្លេច ចោល និង ការរស់ ឡើងវិញ ដ៏ អស្ចារ្យ
29 អ័ ប្រាហាំឆ្លើយ ថា៖ « គេមានម៉ូសេ និងហោរា សូមឲ្យពួកគេស្តាប់តាមចុះ !» ។
គាត់ឆ្លើយ ថា៖ « វិមានដ៏ខ្ពង់ខ្ពស់របស់អ្នក បម្រើដែលលះបង់របស់ទ្រង់នឹងមាន បន្ទាប់មក
ព្រះអម្ចាស់មានព្រះបន្ទូល ថា៖ « ពេលអ្នកធ្វើពិធីជប់លៀងអាហារថ្ងៃត្រង់ ឬអាហារពេលល្ងាច កុំ អញ្ជើញមិត្តភ័ក្ដិ បងប្អូនញាតិមិត្ត មកទេ ព្រោះគេនឹងសងអ្នក ដោយ អញ្ជើញអ្នក មកវិញ ។
“ ឥឡូវនេះ ការ ផ្តោតអារម្មណ៍របស់ខ្ញុំគឺទៅលើ ម៉េង បូ។
ឥឡូវនេះ ចំពោះស្ត្រីព្រហ្ម ចារី ខ្ញុំមិនមាន បញ្ញត្តិពីព្រះ អម្ចាស់ទេ ប៉ុន្តែខ្ញុំកាត់ទោសដូចជាបានទទួលសេចក្ដី មេត្តា ក រុណាពីព្រះ អម្ចាស់ ដើម្បីគួរឲ្យទុក ចិត្ត ។
ពិតប្រាកដ ណាស់ ឧត្តមភាព នៃ អ្នកចេះដឹង ជាង អ្នក គោរព បូជា គឺ ដូចជា ព្រះច័ន្ទ ពេញ វង់ លើ ផ្កាយ ទាំងអស់ ។
« ក្នុងចំណោមហោរា ណាដែលឪពុកឯងមិនបានបៀតបៀន ?
ចូរចៀសចេញពីអំពើអាក្រក់ទាំង ឡាយ [១ ថ.
ទោះបីខ្ញុំមិនស្ថិតនៅក្រោមក្រិត្យវិន័យក៏ដោយ ប៉ុន្តែចំពោះអ្នកដែលនៅក្រោមក្រិត្យវិន័យ ខ្ញុំនឹងនៅក្រោមក្រិត្យវិន័យដូចគ្នា ។
17 ព្រះ របស់ខ្ញុំនឹងដេញពួកគេចេញពីព្រោះពួកគេមិនបានស្តាប់តាម លោក ។ ហើយ ពួកគេ នឹង វង្វេង ក្នុង ចំណោម ប្រជាជាតិ នានា ។
ហើយការ ប្រកែកគ្នាបានកើតឡើងក្នុងចំណោមពួកគេថាតើក្នុងចំណោមពួកគេមួយ ណាធំជាងគេ ។
គ្មានអ្នក ណាអាចត្រូវបាន សង្គ្រោះដោយគ្មានព្រះនាមនៃព្រះអម្ចាស់ឡើយ
នាងបានអង្វរព្រះ យេស៊ូឲ្យ បណ្ដេញអារក្សចេញពីកូនស្រីរបស់នាង ។
បញ្ជូន ពួកគេ ទៅ អ្នក ដែល បង្កើត ការបំផ្លិចបំផ្លាញ ក្នុង នាម នៃ សេចក្តីជំនឿ ។
គ្មានវេទមន្ត និងអាថ៌កំបាំងនៅក្នុងមនុស្សដែលដាក់ឆន្ទៈរបស់ខ្លួនទៅលើគ្នាទៅវិញទៅមក ។
សូមប្រាប់ខ្ញុំផង បើអ្នក ពិចារណាឡើង វិញ » ។
ខ្ញុំមិនអាចធ្វើវាបាន ហើយមនុស្សភាគច្រើនមិនអាចធ្វើវាបាន » ។
អ្នក នឹង ស្វែងយល់ បន្ថែម អំពី ឧបករណ៍ ទាំងនោះ នៅក្នុង ជំពូក ទី 17 ។
គាត់បាននិយាយថា៖ « ពេលឡានចូលដល់ក្នុង ឡមានមនុស្សពីរនាក់ចូល ។
យើងជឿលើព្រះ ដ៏មានព្រះជន្មគង់នៅ និងពិតតែមួយ ដែលជាព្រះ ដ៏វិសុទ្ធ សេចក្ដី ស្រឡាញ់ អស់ កល្ប ជា និច្ច និង ជាអ្នកបង្កើត និង ជាអ្នកការពារអ្វី ៗទាំងអស់ ។
ខ្ញុំគិតថា គួរតែបង្ហាញ ជា សាធារណៈ ។
« តែមនុស្សដែលស្គាល់ព្រះ របស់ខ្លួននឹងមាន កម្លាំង » ។
ដូច្នេះ ចូរអង្វរម្ចាស់ចំរូតឲ្យបញ្ជូនកម្មករទៅច្រូតកាត់វិញ ។
ដូចក្នុងថ្ងៃនៃ ភាព ក្រៀមក្រំ ដូច្នេះក្នុងថ្ងៃនៃការរង ទុក្ខ ។
ដូច្នេះអ្នក និយាយថាតើអ្នក ណាខ្វល់?
គ្មាននរណាម្នាក់បានឡើងទៅស្ថាន សួគ៌ឡើយ លើកលែង តែព្រះអង្គដែលបានយាងចុះ មកពីស្ថាន សួគ៌ គឺបុត្រមនុស្ស ។
សូមឲ្យអ្នក រាល់គ្នាស្គាល់ព្រះ និងអំពីព្រះ‌ យេស៊ូ ជាព្រះ‌ អម្ចាស់នៃយើងរាល់គ្នាបានចម្រើនឡើងនូវព្រះគុណ និងសន្តិភាព ។
ដោយនិយាយថា៖ « ប្រសិនបើអ្នកឧស្សាហ៍ស្ដាប់ព្រះសូរ សៀងរបស់ព្រះអម្ចាស់ជាព្រះ របស់អ្នក ហើយធ្វើ ។
លោកនឹង នាំជន ជាតិអ៊ីស្រាអែលជាច្រើនមក ឯព្រះ‌ អម្ចាស់ ជាព្រះ របស់ពួកគេ វិញ » ។
អ្នក ឲ្យគេ ដូច្នេះគេធ្វើតាមផ្លូវគេ ។
ប៉ុន្តែអ្នក ណាដែលតូចជាងគេនៅក្នុងនគរស្ថាន សួគ៌គឺធំជាងគាត់ ។
ប៉ុន្តែអ្នក ណាដែលតូចជាងគេនៅក្នុងនគរស្ថាន សួគ៌គឺធំជាងគាត់ ។
ឪពុកម្តាយរបស់នាងមិនអាចជឿអ្វីដែលនាងបាននិយាយនោះទេ ។
ឥឡូវនេះ គាត់បានអវត្តមានពីយើងហើយ ប៉ុន្តែគាត់រីករាយក្នុងវត្តមានរបស់ព្រះអម្ចាស់ ។
បែងចែក ការពិត ពី ការ មិន ពិត ឬ ឱ្យ តម្លៃ ចំពោះ កាតព្វកិច្ច ប្រាប់ ការពិត ។
អ្នក នឹង ត្រូវបាន បង្ហាញ ជាមួយនឹង អេក្រង់ ដូច បាន បង្ហាញ ខាងក្រោម :
ដូច្នេះ បងប្អូនអើយ ចូរចាត់បុរសប្រាំពីរនាក់ក្នុងចំណោមអ្នក រាល់គ្នា ដែលមានកេរ្តិ៍ឈ្មោះល្អ ដែលពោរពេញទៅដោយព្រះវិញ្ញាណ និងប្រាជ្ញា ហើយយើងនឹងដាក់ពួកគេឲ្យទទួល បន្ទុកកិច្ចការនេះ ។
១៤ អ្នកអាចសុំអ្វីពីខ្ញុំក្នុងនាមខ្ញុំ ហើយខ្ញុំនឹងធ្វើ ។
មានអារម្មណ៍ល្អ តែលើផ្ទៃប៉ុណ្ណោះ » ។
ប៉ុន្តែ ការអនុញ្ញាត ត្រូវបាន បដិសេធ ។
ហេតុអ្វីបានជាអ្នកប្រាកដក្នុង ចិត្តថាអ្នក ជាកម្មសិទ្ធិរបស់មនុស្សតិច តួចដែលបាន សង្គ្រោះ ហើយមិនមែនជាមនុស្សជាច្រើនដែលមិនបាន សង្គ្រោះ ?
ការ នៅក្នុង ពេល នេះ មាន ថាមពល របស់ វា ទាំងអស់ ។
គោក្របីក្នុងរដូវ រងាត្រូវស្រោចទឹកឱ្យបានល្អ ។
« ក្នុងចំណោមព្យាការី ណាដែលបិតារបស់អ្នកមិនបៀតបៀន ?
ហើយប្រទានឲ្យពួកគេនូវសេចក្តី អំណរនៃការ មាននៅក្នុងសេចក្តីសុចរិតរបស់ទ្រង់ ។
ចូរធ្វើអ្វីគ្រប់យ៉ាងដែលយើងត្រូវ ការ ដើម្បីយើងនឹងត្រូវបានសរសេរនៅក្នុងសៀវភៅជីវិត ។
ហើយ វា នឹង មាន កត្តា កំណត់ នៃ ភាពធ្ងន់ធ្ងរ ។
ខ្ញុំ បាន បោះឆ្នោត ឱ្យ កាតា ព្រោះ វា ដល់ ពេល ដែល ត្រូវ ទៅ ប្រទេស មួយ នៅក្នុង ផ្នែក នៃ ពិភពលោក នោះ ។
ចំពោះ នគររបស់ព្រះ មិនមានក្នុងពាក្យទេ តែជាអំណាច ។
មិន ដឹងថាដំបែ តូចដំណើរការ ពេញមួយដុំទេ? »
៣ គេពោលថា៖ « អ្នកបានចូលទៅផ្ទះមនុស្សមិនកាត់ស្បែក ហើយបរិភោគជាមួយនឹងគេ » ។
ប្រោសគាត់ឲ្យជា សះស្បើយ ដើម្បីឲ្យគាត់អាចនិយាយ និងមើល ។
តើយើងអបអរពួកគេជា វិធីត្រឹមត្រូវឬទេ ?
តើព្រះជានរណាក្រៅពីជាព្រះ ដែលអត់ទោស ?
អ្នក ទាំងពីរទូល ថា៖ « លោកម្ចាស់ ប្រសិនបើលោកនៅ ទីនេះ ប្អូនប្រុសខ្ញុំមិនស្លាប់ទេ » ។
តើអត្ថិភាពរបស់ព្រះ មានជាប់ពាក់ព័ន្ធនឹងការ មានឬអត់នៃពេលវេលា ?
គិតថាគាត់ធ្វើបែបនេះចំពោះអ្នក ដទៃឬ ? »
អ្នក ជា ប្អូន ស្រី របស់ ខ្ញុំ អ្នក គួរតែ ដឹង ។
ទ្រង់ នឹង បង្រៀន យើង អំពី ផ្លូវ របស់ ទ្រង់ ។
នឹង បង្កើន គុណសម្បត្តិ សម្រាប់ គាត់ ។
២ សាឡូម៉ូនបានឆ្លើយសំណួរទាំងអស់របស់នាង ។ គ្មានអ្វីលាក់កំបាំងពីសាឡូម៉ូន ដែលទ្រង់មិនបានពន្យល់នាងឡើយ ។
ហើយយើងដឹងថាការ កាត់ទោសរបស់ព្រះ ប្រឆាំងនឹងអ្នកដែលប្រព្រឹត្តបែបនេះគឺផ្អែកលើសេចក្ដី ពិត ។
ខ្ញុំ មកទីនេះដើម្បីស្វែង រកឪពុក » ។
ដូច្នេះ ក្រុម ជំនុំ ត្រូវបាន ពង្រឹង នៅក្នុង ជំនឿ ហើយ កើនឡើង ជារៀងរាល់ ថ្ងៃ ។
ហើយមុនពេលអ្នក ចាកចេញ យើងមានដំបូន្មានមួយ » ។
ប៉ុន្តែមិនមានវិវរណៈទេ ។
នាងប្រាប់ខ្ញុំថាបីខែមុនមានបុរសម្នាក់ ។
« គេនឹងផ្ញើអំណោយដល់គ្នាទៅវិញទៅមក ពីព្រោះហោរាទាំងពីរនេះបានធ្វើទារុណកម្មអស់អ្នកដែល រស់នៅលើផែនដី » ។
នេះ ពិតជា ភស្តុតាង ដ៏ រឹងមាំ នៃ សេចក្តីសប្បុរស របស់ អល់ ឡោះ ដែល ត្រូវបាន បំភ្លេច ចោល ដោយ បុរស ជាច្រើន ។
បន្ទាប់មក លោក បាន បើក ការយល់ដឹង របស់ ពួកគេ ដើម្បី អោយ ពួកគេ យល់ បទគម្ពីរ ។ ហើយមាន ប្រសាសន៍ទៅពួកគេថា មានចែងទុកមកដូច្នេះថា .. .
« ដ្បិតបើយើងប្រព្រឹត្តអំពើ បាបដោយស្ម័គ្រ ចិត្ត បន្ទាប់ពីនោះយើងបានទទួលចំណេះអំពីសេចក្ដី ពិត នោះនឹងលែងមាន យញ្ញ បូជាសម្រាប់អំពើ បាបទៀតហើយ » ។
ទ្រព្យសម្បត្តិ របស់ ប្រទេស នេះ ,
ហើយមុននឹងពួកគេដឹងថាពួកគេបានឆ្លងផុតការ ចុះឈ្មោះ ។
កុំ ប្រើ ទឹក ច្រើន ។
មហា បូជាចារ្យ គ្រប់ រូប ត្រូវបាន ជ្រើសរើស ពី ក្នុង ចំណោម បុរស ហើយ ត្រូវបាន តែងតាំង ឱ្យ តំណាង ពួកគេ នៅក្នុង បញ្ហា ទាក់ទង នឹង ព្រះ ដើម្បី ថ្វាយ អំណោយ និង យញ្ញ បូជា សម្រាប់ អំពើ បាប ។
ដូច ដែល ទ្រង់ បាន សន្យា នឹង បុព្វបុរស របស់ យើង
ដើម្បីអនុវត្តការ វិនិច្ឆ័យ » ។
ត្រូវបាន លើកតម្កើង ដោយ ជនជាតិ អារ៉ាប់ ។
22 ហេតុនេះហើយបានជាខ្ញុំត្រូវបានរារាំងមិនឲ្យមក រកអ្នកជាញឹក ញាប់ ។
ទ្រង់នឹងធ្វើឲ្យពួកគេស្គាល់សេចក្ដី សញ្ញារបស់ទ្រង់ ។
