បន្ទាប់មកដូច តទៅ : ហើយអ្នកបានអង្រួនមនុស្សអាក្រក់ចេញពីវា។
ដូច្នេះ ចូរប្រយ័ត្នកុំឲ្យពន្លឺដែលនៅក្នុងខ្លួនឯងជាងងឹតឡើយ ។
វា គ្រោង នឹង បញ្ចូល គ្នា ជាមួយ ពួកគេ ចាប់ពី ថ្ងៃ ដំបូង នៃ ការបង្កើត របស់ ពួកគេ ។
កុំ ទទួល ការចោទប្រកាន់ លើ អ្នក ចាស់ទុំ លើកលែងតែ សាក្សី ពីរ ឬ បី នាក់ ប៉ុណ្ណោះ ។
សូមឲ្យបងប្រុសខ្ញុំតាមខ្ញុំ ។
ព្រះទ្រង់បានត្រាស់ហៅមនុស្សម្នាក់ ៗពីមួយទៅមួយ ។
ខ្ញុំ ចង់ បន្លាច អ្នក មួយ ភ្លែត ។
ថាគេមកចំណាយពេលជាមួយឯង » ។
នេះ ជាទំព័រ ភាពមិនច្បាស់ លាស់របស់បុរសខ្លាំង ។
២០ ពេលអ្នកធ្វើជាខ្ញុំបម្រើរបស់អំពើ បាប អ្នក បានរួចពីការ គ្រប់គ្រងនៃសេចក្ដី សុចរិត ។
ពួកគេនឹងត្រូវបានអនុញ្ញាតឱ្យដោះ ស្រាយបញ្ហាដោយខ្លួនគេ » ។
យើងខ្ញុំជឿ ហើយដឹងថាអ្នកគឺជាព្រះ ដ៏បរិសុទ្ធនៃព្រះ» ។
អ្នកខ្លះមាន ចិត្តក្រអឺត ក្រទម ហាក់ដូចជាមិនមក រកអ្នក រាល់គ្នា ។
យើង នឹង ចោទប្រកាន់ គាត់ ចំពោះ អ្វី មួយ ដែល គាត់ ( ត្រូវបាន ចោទប្រកាន់ ) បាន ប្តេជ្ញាចិត្ត ធ្វើ ។
បុរសឃ្លង់ម្នាក់បានមកលុតជង្គង់នៅចំពោះមុខគាត់ ហើយទូល ថា៖ « លោកម្ចាស់ បើព្រះអង្គសព្វព្រះហឫទ័យ សូមប្រោសទូលបង្គំឲ្យបាន ជាស្អាត » ។
ហើយ អ័ដាម មិន មែន ជា អ្នក ដែល ត្រូវបាន បញ្ឆោត ទេ ។ ប៉ុន្តែស្ត្រីនោះជាស្ត្រីដែលត្រូវបានគេបញ្ឆោត ហើយបានក្លាយជាមនុស្សមាន បាប ។
ពួកគេបានធ្វើដំណើរទៅគ្រប់ទីក្រុងនានាក្នុងស្រុកយូដា ហើយបង្រៀនប្រជាជន ។
បានឃើញ ហើយបានធ្វើបន្ទាល់ថា នេះជាព្រះរាជ បុត្រានៃព្រះ» ។
ថ្ងៃ ណាមួយ ការឈឺចាប់ នេះ នឹង មាន ប្រយោជន៍ សម្រាប់ អ្នក ” ។
ដូច្នេះ បងប្អូនអើយ ចូរមាន ចិត្តចង់ទាយ ហើយកុំហាមមិនឲ្យនិយាយភាសា ដទៃឡើយ ។
គាត់នឹងមានអំណាចគ្រប់យ៉ាង ហើយ បង្រួបបង្រួម ជាតិ សាសន៍យូដា ។
ព្រះជាម្ចាស់ក្នុងព្រះនាមព្រះអង្គ ដើម្បីអោយការ អធិស្ឋានរបស់ពួកគេមក កាន់ព្រះជាម្ចាស់ជាព្រះបិតាតាមរយៈព្រះហស្ដរបស់ព្រះអង្គ ។
ការថ្វាយបង្គំ នៅក្នុង ដំណាក់ របស់ ព្រះ។
ហើយ ពួកគេ ទាំងអស់ មាន គុណវិបត្តិ របស់ ពួកគេ ពួកគេ ទាំងអស់ មាន ការសង្ស័យ របស់ ពួកគេ ។
ចូរមាន ចិត្តអត់ ធ្មត់ ហើយឈរឲ្យរឹងមាំ ដ្បិតការ យាងមករបស់ព្រះ អម្ចាស់ជិត មកដល់ហើយ ។
ប៉ុន្តែពួកគេបានសង្កេតមើលវារាប់ ពាន់ដងពីមុនមក ហើយពួកគេមិនចាប់អារម្មណ៍ឡើយ ។
« ព្រះយេស៊ូវ អើយ សូម ទទួល វិញ្ញាណ ខ្ញុំ ចុះ ។
ដូច្នេះ សូម ហៅ ពួកគេ ថា អ្នក ស៊ីប
យើងបានប្រព្រឹត្តអំពើ បាបជាមួយនឹងបុព្វបុរសរបស់យើង យើងបានប្រព្រឹត្តអំពើទុច្ចរិត យើងបានប្រព្រឹត្តអំពើអាក្រក់ ។
ប្រាប់ នាង ថា ឥឡូវនេះ អ្នក មាន អាយុ គ្រប់គ្រាន់ ហើយ ។
នេះគឺជាព្រះជាព្រះវរ បិតា — ជាអ្នកបង្កើត ដែលលើសពីការ យល់ដឹងទាំងអស់ ។
ហើយក៏មានជម្លោះក្នុងចំណោមពួកគេ ដែលក្នុងចំណោមពួកគេគួរចាត់ទុកថាជាអ្នកធំជាងគេ ។
“ ព្រះអម្ចាស់ អើយ ព្រះអង្គ បាន ប្រទាន ព្រះគុណ ដល់ ទូលបង្គំ ។
14 កាលទ្រង់បានហៅមនុស្សទាំងអស់ឲ្យមក ឯទ្រង់ហើយ ទ្រង់មានព្រះ‌បន្ទូលទៅគេ ថា៖ « អ្នក រាល់គ្នាស្តាប់ខ្ញុំ ហើយយល់
តាម រូបរាង នៃ មុខ របស់ ពួកគេ ។
ប៉ុន្តែ គាត់ បាន បដិសេធ មិន ផឹក វា ; ផ្ទុយទៅវិញ គាត់បានចាក់វាថ្វាយព្រះអម្ចាស់ ។
នេះជាដើមអូលីវពីរ និងជើង ចង្កៀងពីរដែលឈរនៅចំពោះព្រះ អម្ចាស់នៃផែនដី ( បាន ព្យាករណ៍នៅក្នុង សាការី 4) ។
" តើអ្នក និយាយរឿងនេះដោយខ្លួនឯងដោយខ្លួនឯង ឬអ្នកផ្សេងនិយាយប្រាប់អ្នកអំពីខ្ញុំ ? "
ប្រសិនបើពួកគេគ្រាន់ តែរង់ចាំ នោះព្រះ នឹងជំនួសសាវ័ក ជាសាវកប៉ុល ។
នេះបង្ហាញថា ព្រះ យេហូវ៉ាពេញដោយសេចក្ដី មេត្តា ក រុណា » ។
ពេល ណាម្នាក់ សង្ស័យ ឬវង្វេង ម្នាក់ទៀតរកឃើញផ្លូវ ( ជណ្ដើរចេញពីវាលភក់ ) ។
“ ខ្ញុំគិតថាប្រសិនបើប៉ារីសធ្លាក់ចេញ វានឹងក្លាយជាការ ខក ចិត្តដ៏ធំមួយសម្រាប់ពួកគេ ។
ខ្ញុំបានឃើញ ហើយបានថ្លែង ទី បន្ទាល់ថា នេះជាព្រះរាជ បុត្រានៃព្រះ» ។
ព្រះជាប្រភព នៃ ជីវិត ទាំងអស់ ដូច្នេះ នៅពេល អ្នក ដើរ ទៅ ជិត កន្លែង ដែល ព្រះគង់
ប៉ុន្តែគាត់ឆ្លើយ ថា៖ « លោកម្ចាស់ សូមឲ្យខ្ញុំទៅបញ្ចុះ សពឪពុកខ្ញុំសិន » ។
អ្វីដែលគាត់កំពុងធ្វើឲ្យអ្នក ធ្វើ » ។
ដោយ ផ្អែក លើ ឈ្មោះ ក្រុមហ៊ុន យើង នឹង ផ្តោត លើ ការបង្ហោះ គេហទំព័រ បៃតង មួយ នាទី ។
ពួកគេខ្លះស្រែក ថា៖ « បើយើងមិនទទួលបានយុត្តិធម៌ទេ គេក៏មិនបានរស់នៅដោយសុខសាន្តដែរ !
ត្រូវរក្សាទុកសម្រាប់អ៊ីអនមួយ » ។
ខ្ញុំនឹង នាំអ្នកទៅ កាន់ទ្វីបមួយ ដូចជា រស្មីនៃស្ថាន សួគ៌នឹង នាំអ្នកទៅ កាន់អនាគត កាល » ។
លុះចូលទៅគាល់ព្រះបាទ ទ្រង់ក្រាបនៅចំពោះព្រះភក្ត្រស្តេច ។
ប្រជាជនទាំងអស់បានឃើញដូច្នេះ ក៏សរសើរ ត ម្កើងព្រះជាម្ចាស់ ។
« អ្នក ណាដែលជ្រើសរើសធ្វើតាមព្រះហឫទ័យរបស់ព្រះ អ្នកនឹងដឹងថាតើការ បង្រៀនរបស់ខ្ញុំ មកពីព្រះ ឬថាខ្ញុំ និយាយដោយខ្លួនឯងឬអត់ » ។
នាងទូល ថា៖ « លោកម្ចាស់ បើលោកមកទីនេះ ប្អូនប្រុសរបស់ខ្ញុំមិនបានស្លាប់ទេ » ។
ក្នុង អំឡុង ពេល ថ្ងៃ រក្សា ពួកគេ ឱ្យ នៅ ជាមួយ អ្នកគ្រប់ ពេលវេលា និង បង្កើត ទំនុកចិត្ត ។
ហ្វូងមនុស្សដ៏ច្រើនមក រកទ្រង់ ពេលឮគេធ្វើទាំងអស់ ។
នៅពេលនោះ ទ្រង់នឹងវិនិច្ឆ័យពិភពលោកដោយសុចរិត និងយុត្តិធម៌ ( ១១: ៤) ។
ពួកគេ ត្អូញត្អែរ អំពី មនុស្ស ដែល ធ្វើបាប ពួកគេ ។
ហើយ អាកប្បកិរិយា របស់ នាង គឺ ដូចជា ទេវតា ។
៧ ហើយអ្នកបាននិយាយថា៖ « ខ្ញុំនឹងក្លាយជាស្ត្រីដ៏ខ្ពង់ខ្ពស់ ជារៀងរហូត » ។
« ពេលល្ងាច មក មានមនុស្សជាច្រើនដែលត្រូវអារក្សចូលមក ឯទ្រង់ ហើយទ្រង់បានបណ្ដេញវិញ្ញាណចេញដោយពាក្យ សម្ដី ហើយប្រោសអ្នកជំងឺទាំងអស់ ។
ពេលគាត់ត្រូវបោះ បង់ចោល កូនស្រីរបស់ផារ៉ោនក៏យកគាត់ទៅចិញ្ចឹមជាកូនប្រុសរបស់គាត់ ។
