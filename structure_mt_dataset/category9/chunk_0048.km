ខ្ញុំ សម្លឹងមើល ហើយ ប្រាប់ ខ្លួន ឯង ថា រឿង នេះ មិន កើតឡើង ចំពោះ ខ្ញុំ ទេ ។
អ្វីដែលអ្នកទើបនឹងពណ៌នាគឺបទឧក្រិដ្ឋនៅសហរដ្ឋអាមេរិក ។
សក់ទាំងអស់របស់ខ្ញុំគឺជារបស់ខ្ញុំ ហើយមិនត្រូវបានលាបពណ៌ទេ » ។
វា ស៊ី ផ្លែ ឈើ និង បន្លែ គ្រប់ ប្រភេទ ហើយ ប្រែក្លាយ វា ទៅជា ស្ថិរភាព រលូន ។
ហើយការ ភ័យខ្លាច ជាឧបសគ្គធំមួយក្នុងការ ជួបអ្នកជំងឺនៅពេលដែលយើងត្រូវ ការ ។
ការ អង្វររបស់ព្រះអង្គនៅថ្ងៃបូជា និងនៅថ្ងៃសុក្រ ។
ស្ថិត នៅក្នុង ជ្រលង នៃ ការសម្រេចចិត្ត ?
មាន ពរហើយនាងដែលជឿថាអ្វីដែលព្រះ អម្ចាស់មានព្រះបន្ទូលនឹងនាងនឹងបានសម្រេច ។
" ទោះបីជា គ្រួសារ របស់ អ្នក មិន យល់ ថា ថ្ងៃ នេះ ជឿជាក់ លើ ខ្ញុំ ពួកគេ នឹង នៅពេល អ្នក ទៅ មហាវិទ្យាល័យ ឬ ចាប់ផ្តើម អាជីវកម្ម របស់ អ្នក " ។
មានអាយុបួន ឬប្រាំឆ្នាំ ហើយឪពុករបស់គេបានបង្កើតសត្វប្រចៀវចេញពីបន្ទះឈើ » ។
តើ ពេលណា ខ្ញុំ នឹង បាន នៅ ជាមួយ អ្នក ម្តង ទៀត ក្នុង ស្ថានភាពស្ងប់ស្ងាត់ ?
ឥឡូវនេះ ខ្ញុំ យល់ កាន់តែ ច្បាស់ អំពី ប្រជាសាស្រ្ត ។
ហើយ វា មាន ច្រើន ក្រៃលែង ។
កុំចេញទៅក្នុងទី ចំហ បើមិនប្រាកដថាគ្មានជ្រូកព្រៃនៅក្បែរនោះ ។
គាត់ជាមនុស្សថ្លៃថ្នូរដែលមានបុព្វហេតុសុចរិតសម្រាប់អំពើ បាប ។
អេសាយ 55:8 « ដ្បិតគំនិតរបស់យើងមិនមែនជាគំនិតរបស់អ្នកទេ ហើយផ្លូវរបស់អ្នកក៏មិនមែនជាផ្លូវរបស់យើងដែរ » ។
( ប្រសិនបើអ្នក ណាមិនចេះគ្រប់គ្រងក្រុមគ្រួសាររបស់ខ្លួន តើគាត់អាចមើលថែក្រុមជំនុំរបស់ព្រះ ដោយរបៀប ណា ? )
" មនុស្ស ដែល មាន សុខភាព ល្អ មិន ត្រូវការ គ្រូពេទ្យ ទេ ។
គ្មានអ្វីត្រូវបានគេបោះ បង់ចោល ឬ កក់ទុកចាប់តាំងពីពេលនោះមក ។
ប្រសិនបើ គេ ឃើញ ទេវតា ចុះ មក លើ ទី បញ្ចុះ សព ក្នុង សុបិន នោះ វា បង្ហាញ ពី វត្តមាន របស់ ព្រលឹង ដែល មាន ពរ និង សុចរិត នៅក្នុង កន្លែង នោះ ។
ការស្តាប់ ពួកគេ ពិតជា អស្ចារ្យ ណាស់ ។
បាន ទាក់ទង គាត់ តាម អ៊ីនធឺណិត ។
យើង រស់ នៅ ដើម្បី លើកតម្កើង សិរី រុងរឿង របស់ ព្រះជាម្ចាស់ ។
តើអ្នកកំពុងស្វែង រក ... គូស្នេហ៍នេះ?
អ្នក រាល់គ្នាត្រូវបានគេបោះចោលមុន ប៉ុន្តែមាន ន័យថាយើងមានសិទ្ធិប្ដឹងឬ ?
១៤៧ ទូលបង្គំបានរារាំងដល់ពេលព្រឹកព្រលឹម ហើយស្រែកឡើងថា ទូលបង្គំ សង្ឃឹមនឹងព្រះបន្ទូលរបស់ព្រះអង្គ ។
នាង និយាយ ជា ភាសា អ៊ីតាលី ។
ផ្អែមណាស់ពេលមានគាត់ទៅផ្ទះពេលថ្ងៃ ។
ដល់ ពេល សន្សំ ថ្ងៃ ជាមួយ កាហ្វេ ត្រជាក់ ។
និង ពោរពេញ ដោយ ថាមពល ។
៨ ដូច្នេះ ទីក្រុងនោះមាន អំណរជាខ្លាំង ។
គាត់បានធ្វើជាគំរូដល់យើងទាំងអស់គ្នា ។
អាណា មិន ខ្មាស់ នឹង រូបរាង របស់ នាង ទេ ។
« តើអ្នកកំពុង តែស្វែង រកថាតើប្រភពអ្វី?
ខ្ញុំដឹងថា អ្នក រាល់គ្នាមិនអាចអត់ឱនឲ្យមនុស្សអាក្រក់បានទេ គឺអ្នកបានល្បង លអ្នកដែលអះអាងថាខ្លួនជាសាវ័ក ប៉ុន្តែមិនមែនជាសាវ័ក ហើយរកឃើញថាពួកគេមិនពិត ។ . . .
នាង ចង់ឱ្យ ពួកគេ ដឹង ថា អ្នកណា ជា ចៅហ្វាយ ។
ដូច្នេះខ្ញុំដឹងថាតើលេសរបស់ខ្ញុំជាអ្វី » ។
នៅ សល់មួយទៀតត្រូវបានគេឃើញ ។
« ទោះជាលក្ខខណ្ឌ ណាដែលអ្នកដាក់លើគាត់ គាត់នៅក្នុងការ ដោះលែង គាត់ស្ថិតនៅក្នុងការ កាត់ទោសព្យួរ ។
ហើយរហូតមកដល់ពេលនេះ វាចូល ចិត្តអ្វីដែលវាមើលឃើញ » ។
ដូច្នេះ គេនឹង រក វិធីដើម្បីពង្រីកវាចេញ ។
គេ នឹង បណ្ដេញ អ្នក ចេញ ពី សាលាប្រជុំ ។ មែន ហើយ ពេលវេលាមកដល់ហើយ ដែលអ្នក ណាសម្លាប់អ្នក រាល់គ្នានឹងគិតថាអ្នកនោះកំពុងថ្វាយព្រះ» ។
ដើម្បី រស់ នៅ ដោយ សេរី ពី អំពើ បាប ទាំងអស់ ដូច ដែល បាន បង្ហាញ នៅក្នុង ការអធិស្ឋាន នៃ ការប្រែចិត្ត ។
" គឺអំពី ការ ភ័យខ្លាចនៃការ បំភ្លេចមនុស្សក្នុងជីវិតរបស់អ្នក។
ជាមួយនឹងការ កែ លម្អ ជាច្រើនដែលបានធ្វើក្នុងពេលថ្ងៃ » ។
គាត់ មិន ហ៊ាន បង្ហាញ ភាព ទន់ខ្សោយ នៅ ចំពោះមុខ ឪពុក របស់ គាត់ ទេ ។
ប្រសិនបើ ពួកគេ មិន មែន ជា សិស្ស របស់ ទ្រង់ ពិតប្រាកដ ទេ ពួកគេ នឹង មិន ត្រូវបាន ផ្តល់ អំណាច នោះ ទេ ។
ទាំង នេះ គឺជា មនុស្ស ដែល ចូលចិត្ត និយាយ ។
ដូច្នេះកន្លះសតវត្សមកហើយ ពួកគេដូចជា កប៉ាល់ឆ្លងកាត់ពេលយប់ ។
នោះមាន ន័យថាពួកគេបាន បង្វែរផ្លូវរួចហើយនៅពេលនោះ ។
ផ្តល់ឱ្យ គាត់ នូវ បញ្ជី ការងារ ត្រូវ ធ្វើ ហើយ ឱ្យ គាត់ ជួយ អ្នកគ្រប់គ្រង វា ។ "
សតិសម្បជញ្ញៈរបស់ខ្ញុំច្បាស់ ប៉ុន្តែគឺព្រះអម្ចាស់ដែលវិនិច្ឆ័យខ្ញុំ ។
ព្រះគម្ពីរ មិន ត្រូវបាន សរសេរ មក យើង ទេ ។
នាងក៏បាននិយាយដែរថា នាងចង់ឲ្យហ្វីលីពីនមានឧបករណ៍ដូចគ្នា ។
ថ្ងៃ មកដល់ហើយ ហើយមិនមានអ្វីផ្លាស់ប្តូរក្រៅពីកម្រិតនៃការ ខក ចិត្តរបស់អ្នក ជឿពិត ។
ពួកគេ នឹង បង្កើន អារម្មណ៍ របស់ អ្នក ភ្លាម ៗ បន្ទាប់ពី អ្នកមើល ពួកគេ ។
មហា បូជាចារ្យ គ្រប់ រូប ត្រូវបាន ជ្រើសរើស ពី ក្នុង ចំណោម បុរស ហើយ ត្រូវបាន តែងតាំង ឱ្យ តំណាង ពួកគេ នៅក្នុង បញ្ហា ទាក់ទង នឹង ព្រះ ដើម្បី ថ្វាយ អំណោយ និង យញ្ញ បូជា សម្រាប់ អំពើ បាប ។
៨ ចូរប្រយ័ត្នកុំឲ្យបាត់បង់នូវអ្វីដែលយើងបានធ្វើឡើយ ប៉ុន្តែដើម្បីឲ្យអ្នក រាល់គ្នាបានរង្វាន់ពេញ លេញ ។
អាស៊ី អាគ្នេយ៍ មួយ ទៀត ។
1:10 ហើយខ្ញុំនឹងបញ្ជូនភ្លើងទៅលើជញ្ជាំងនៃក្រុង ទី រ៉ុស , ហើយវានឹងលេបត្របាក់អគាររបស់ខ្លួន .
នៅពេល បំពាក់ ដោយ ដាវ ដៃ មួយ
គាត់និយាយថា៖ « អត់មានមុខរបរទេ អ្នកណាថាមានមុខរបរ?
ពេលមួយខ្ញុំពិការភ្នែក ប៉ុន្តែឥឡូវខ្ញុំឃើញ ។
រួចក្រាបចុះថ្វាយបង្គំ ។
" ប្រាកដ ណាស់ ដាវ នឹង ចាក់ ទម្លុះ ព្រលឹង អ្នក ផងដែរ ដើម្បី អោយ គំនិត ខាងក្នុង របស់ មនុស្ស ជាច្រើន បាន លាតត្រដាង " ។
ជំរាប សួរ ម៉ារី ដែល បាន ខិតខំ ដើម្បី អ្នក ។
គោលបំណ ង៖ កុំ ធ្លាក់
បើមិនធ្វើទេ គេនឹងស្លាប់ធ្វើ ការ ។
ពេលពេត្រុសឃើញដូច្នេះ គាត់ក៏ប្រាប់ប្រជាជនថា
« បើអ្នកនៅជាប់នឹងខ្ញុំ ហើយពាក្យរបស់ខ្ញុំនៅជាប់នឹងអ្នក ចូរសុំអ្វីដែលអ្នកចង់បាន នោះវានឹងឲ្យអ្នក » ។
គាត់បានយកដើមទំពាំងបាយជូរមួយពីស្រុកអេស៊ីប ។
បន្ទាប់មក ព្រះ‌ យេស៊ូចាប់ផ្ដើមបរិហារក្រុងនានា ដែលព្រះអង្គបានធ្វើការ អស្ចារ្យ ជាច្រើនរបស់ព្រះអង្គ ។
បន្ទាប់មកគាត់និយាយថា “ នេះជាការ ទៅលើកដំបូងរបស់ខ្ញុំ ។
ឥឡូវនេះបានចាប់គាត់ចូលគុកម្ដងទៀត ។
លេខ កូដ កំហុស ប្រសិនបើ មាន កំហុស ។
ព្រះដ៏ ខ្ពស់ បំផុត លើ ព្រះទាំងអស់ នៃ ផែនដី ។
មនុស្សមួយចំនួនសូម្បីតែបុរសពីរនាក់នៅ ទីនោះហាក់ដូចជាស្រឡាញ់វា។
ប្រសិនបើ បក្សី របស់ អ្នក មិន ចង់ បាន ។
ហើយអ្វីដែលគាត់មាន ន័យគឺថា មនុស្សទាំងអស់ត្រូវបានគេប្រកាសថាមានកំហុសដោយសារអំពើ បាបរបស់អ័ដាម ។
និង បណ្ដេញមនុស្សចេញពីតំបន់ ។
យើងអនុញ្ញាតឱ្យពួកគេទទួលពិន័យជាមិន ខាន » ។
នៅ ពេលណា ដែល នរណា ម្នាក់ ព្យាយាម ប្រាប់ គាត់ ពី ការពិត គាត់ បាន បដិសេធ ភស្តុតាង និង អំណះអំណាង ដែល ត្រូវបាន បង្ហាញ ដល់ គាត់ ។
១៤ « អ្នក រាល់គ្នា ជាពន្លឺនៃពិភពលោក ទីក្រុងមួយដែលឈរលើភ្នំមិនអាចលាក់ខ្លួនបានឡើយ ។
ទន្ទឹម នឹង នោះ អ្នក នឹង មិន អាច រកឃើញ ការស្វាគមន៍ ណាមួយ នៅឯ សិប្បកម្ម ពីរ ប្រភេទ នោះ ទេ ។
វា ជា ការ ល្អ ដែល ឃើញ អ្នក កំពុង ធ្វើ អ្វី មួយ សម្រាប់ ខ្លួនអ្នក ។
វានឹងយកសៀវភៅដប់ក្បាលដើម្បីពណ៌នាវា » ។
ឥឡូវនេះ តើ ខ្ញុំ គួរ ព្រួយបារម្ភ អំពី រឿង នេះ ទេ ?
វានឹងពិបាកណាស់ ប៉ុន្តែយើងអាចធ្វើបាន !
ភាគ ច្រើន ប្រសិនបើ យើង ទាំងអស់ គ្នា មិន បាន ដឹង ពី ការអធិស្ឋាន របស់ ព្រះអម្ចាស់ ដែល បាន ប្រទាន មក យើង ដោយ ព្រះអម្ចាស់ យេស៊ូវ របស់ យើង ។
យើងទាំងអស់គ្នាខ្លាច យកមួយពីដើមឈើព្យួរ ។
ពួកគេមានច្រើនជាងពួកគេដឹងពីអ្វីដែលត្រូវធ្វើជាមួយ ( ភាគ ច្រើនពួកគេទោះយ៉ាង ណា ក៏ដោយ ) ហើយពួកគេចង់ចំណាយវា ។
ដោយសារតែ អ្នក មិត្ត របស់ ខ្ញុំ ។
ភីលីព 1:10 ដើម្បីឲ្យអ្នក រាល់គ្នាអាចដឹងថាអ្វីដែលល្អបំផុត ហើយអាចនឹងបរិសុទ្ធ និងគ្មានកំហុសរហូតដល់ថ្ងៃនៃព្រះ‌ គ្រីស្ទ ។
គាត់ ដឹង ថា គាត់ និយាយ ការពិត ហើយ គាត់ បាន ថ្លែង ទី បន្ទាល់ ដើម្បីឱ្យ អ្នក ជឿ ផងដែរ ។
ហើយនឹងត្រូវបានរួម បញ្ចូលជាមួយកៅ អី ។
81:11 ប៉ុន្តែ ប្រជាជនរបស់យើងមិនបានស្តាប់តាមសំឡេងរបស់យើង , ហើយអ៊ីស្រាអែលមិនបានយល់ព្រមនឹងខ្ញុំ .
ការរចនា ដែល បាន អនុម័ត
39:17 អស់អ្នកដែលគេចពីការ គោរពប្រណិប័តន៍ព្រះ ហើយ ប្រែ ចិត្តចំពោះអល់ ឡោះ ដំណឹងល្អរបស់ពួកគេ ។
ហើយវាកំពុងដើរទៅក្នុងទិសខាងស្ដាំ ដូច្នេះតើអ្នកធ្វើយ៉ាង ណា ?
ពិតជា មាន អបិយជំនឿ ច្រើន ណាស់ ដែល ជាប់ទាក់ទង នឹង ការរមាស់ បាត ដៃ ។
តាមពិត - ប៉ុន្តែ ប្រសិនបើ អ្នក ក្រឡេក មើល មេដឹកនាំ ទាំង ពីរ
ភាពខុសគ្នា នៃ វ៉ិចទ័រ ត្រូវបាន បង្កើតឡើង នីមួយ ៗ ។
ដូច្នេះហើយ នៅពេលដែលម៉ូសេ ចុះពីភ្នំ គាត់ត្រូវបានកែប្រែ ។
ចូរទៅអង្វរដល់ការ សោយទិវង្គតរបស់ទ្រង់ ដែលដៃដែលចិញ្ចឹមអ្នកជាប់ ។
ដែល កំពុង ធ្វើ រឿង ទាំងនេះ ។
ខ្ញុំ ស្គាល់ ខ្លួន ឯង កាន់តែ ច្បាស់ ហើយ ជឿជាក់ លើ ខ្លួន ឯង ជាង ។
៦ លោកយេហ៊ូវក្រោកឡើងចូលទៅក្នុងផ្ទះ ។
២០ ខ្ញុំបានប្រាប់អ្នក ថា អ្នក បានទៅដល់តំបន់ភ្នំរបស់ជន ជាតិអាម៉ូរី ដែលព្រះអម្ចាស់ ជាព្រះ នៃយើងបានប្រទាន មកយើង ។
នៅពេល ថ្ងៃ អ្នក អាច ឃើញ សត្វ ស្លាប ទឹក ជាច្រើន ។
ជីវិត ត្រូវតែ ទៅ មុខ ។
អ័ ប្រាហាំ អ៊ីសាក យ៉ាកុប ដាវីឌ ជាដើម ត្រូវបាន សង្គ្រោះ ដោយ ជំនឿ លើ កិច្ចព្រមព្រៀង ដែល បាន ធ្វើ ចំពោះ ពួកគេ ថា មេស្ស៊ី ដែល បាន សន្យា នឹង យាង មក ដើម្បី ធ្វើ សច្ចាប័ន លើ សេចក្តីសញ្ញា ជាមួយនឹង ព្រះលោហិត របស់ ទ្រង់ ដែល នឹង ដង្វាយ ធួន សម្រាប់ អំពើ បាប របស់ ពួកគេ ។
គាត់មិនធាត់ទេ ប៉ុន្តែគាត់មិនឡើងទម្ងន់ទៀតទេ ។
៨ ជាមនុស្សមាន ចិត្តពីរ មិនស្ថិតស្ថេរក្នុងគ្រប់ទាំងផ្លូវរបស់ខ្លួន ។
« អ្នក រាល់គ្នាបានរស់ នៅដោយរីករាយនៅលើផែនដី ហើយមាន ចិត្តលោភលន់ អ្នក រាល់គ្នាបានចិញ្ចឹម ចិត្តរបស់អ្នក រាល់គ្នា ដូចជាថ្ងៃនៃការ សម្លាប់ » ( យ៉ាកុប ៥: ៥) ។
ត្រឡប់ទៅទីក្រុង ឡុងដ៍ហើយត្រឡប់ទៅធ្វើការ!
ខ្ញុំ គិត ថា គាត់ ចូលចិត្ត ការងារ នេះ ។
ជន ជាតិយូដាបាន ជំទាស់ ដូច្នេះខ្ញុំត្រូវ បង្ខំ ចិត្តប្តឹងទៅសេសារ ។
“ យើងដាក់ទៅអ្នកថានេះមិនគ្រប់គ្រាន់ ។
ខ្ញុំ សង្ឃឹម ថា អ្នក នឹង យល់ ។
យើង ប្រាកដជា នឹង ត្រលប់ មកវិញ ។ ហ្វេសប៊ុក
“ ភូមិ ទាំងមូល កំពុង គាំទ្រ ខ្ញុំ ។
ខ្ញុំគិតថាសម្រស់គឺសំខាន់នៅពេលនោះ ព្រោះវារំឭកមនុស្សអំពីតម្លៃនៃព្រះ ក្នុងការ គោរពប្រណិប័តន៍របស់ពួកគេ ។
មុនពេល អ្នក អាច ចាប់ផ្តើម ធ្វើការ ជាមួយ មូលដ្ឋាន ទិន្នន័យ របស់ អ្នក អ្នក ត្រូវតែ ភ្ជាប់ ទៅ ម៉ាស៊ីន មេជាមុន សិន ។
ពេលខ្ញុំងូតទឹកពេលយប់ វាទទួលខ្ញុំ ។
បំណងប្រាថ្នាខាងលោកិយទាំងអស់របស់គាត់ត្រូវបានសម្រេច ។
អាស្រ័យ លើ កម្មវិធី រុករក របស់ អ្នក ។
ប្រសិនបើ អ្នក បាន សាកល្បង ហ្គេម បក្សី ខឹង មួយ ។
ដាច់ខាត មិន ត្រូវ លើស ពី ពីរ ធាតុ ដែល ត្រូវ ចុះហត្ថលេខា ។
ទាំង នេះ គឺជា អ្វី ដែល ពួកគេ ហៅ ថា អ្នក ចម្បាំង អធិស្ឋាន ។
ក្មេងប្រុស នោះ នឹង ក្លាយជា
ក្នុង អំឡុង ពេល វគ្គ រដូវ ក្តៅ ដំបូង នឹង មាន ភាពខុសគ្នា នៃ
ភ្ញាក់ផ្អើល ដល់ កូនក្រមុំ !
កូនប្រុសកូនស្រីរបស់អ្នកដែលអ្នកបានទុកនៅស្រុកយូដានឹងត្រូវគេសម្លាប់ដោយដាវ ។
អ៊ីស្រាអែលបង្ហាញក្នុង បញ្ជីនៃអ្នកដែលកែងជើងរបស់ផារ៉ោនបានជាន់ជើង រួមនឹងជនជាតិអារ៉ាមជាច្រើនប្រភេទ ។
