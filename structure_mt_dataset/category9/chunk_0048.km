ខ្ញុំគិតថាគាត់ចង់ឃើញអ្វីមួយកើតឡើង » ។
អ្នកដែលគ្មានសុវត្ថិភាព គឺអ្នកដែលធ្វើចំណាកស្រុក ។
រហូតដល់ ម៉ោង កំណត់ ។
ប៉ុន្តែខ្ញុំនឹកប៉ែនហើយមែនទេ ?
ដូច្នេះ ចូរអធិស្ឋានដល់ព្រះ‌ អម្ចាស់នៃការ ច្រូតកាត់ ដើម្បីចាត់កម្មករឲ្យចូលច្រូតកាត់ ។
នៅ ទីនោះ គាត់ អង្គុយ នៅ ខាងស្តាំ ដៃ របស់ ព្រះបិតា របស់ គាត់ អង្វរ អ្នក ជឿ ។
គាត់បានដឹងថា ព្រះ អាចប្រោសអ៊ីសាកឲ្យ រស់ឡើងវិញ ( ជានិមិត្តរូបនៃព្រះអម្ចាស់យេស៊ូវ ) ពី សុគត ។
វាមិនមែនដោយ កម្លាំង ឬដោយ កម្លាំងទេ ប៉ុន្តែព្រះគុណរបស់ព្រះ គឺគ្រប់គ្រាន់សម្រាប់យើង !
យើង ក៏ ដឹង ដែរ ថា ច្បាប់ នេះ មិន មែន សម្រាប់ មនុស្ស សុចរិត ទេ ប៉ុន្តែ សម្រាប់ អ្នក ដែល បំពាន ច្បាប់ និង អ្នក បះបោរ ពួក ទុច្ចរិត និង អំពើ បាប មនុស្ស មិន បរិសុទ្ធ និង មិន គោរព សាសនា សម្រាប់ អ្នក ដែល សម្លាប់ ឪពុក ម្ដាយ ឃាតករ ផិត ក្បត់ និង អ្នក បោកប្រាស់ ឈ្មួញ ទាសករ និង អ្នកភូត កុហក ។ និង អ្នកភូត កុហក ...
កូនប្រុសខ្ញុំថ្វាយ បង្គំគាត់ » ។
ប្រសិនបើអ្នកនៅជាប់នឹងខ្ញុំ ហើយពាក្យរបស់ខ្ញុំនៅជាប់នឹងអ្នក អ្នកអាចនឹងសួរអ្នក នូវអ្វីដែលអ្នកចង់ ហើយវានឹងត្រូវបានសម្រេចសម្រាប់អ្នក ។
ដ្បិតដោយ សារ តែការ ទាំងនេះ ព្រះ ពិរោធនឹង មកដល់ ។
សូមប្រាកដថា អ្វីដែលព្យាការីបាននិយាយមិនកើតចំពោះអ្នកដែរ ។
ប្រជាជាតិរបស់អ្នកផ្ទាល់ និងពួកនាយកបូជាចារ្យបានប្រគល់អ្នក មកអោយ ខ្ញុំ៖ តើអ្នកបានធ្វើអ្វី ?
គាត់លាក់មុខមិនឃើញ » ។
នៅ ទីនេះ គាត់ បាន លះបង់ ពេលវេលា របស់ គាត់ សម្រាប់ ការដាំដុះ របស់ វា ។
សន្យា ណាដែលមិនលើសពីសម្លៀក បំពាក់ដែលហួស សម័យនោះឡើយ » ។
បេថា នី៖ ហើយគាត់លើកដៃឡើង ហើយឲ្យ ពរពួកគេ ។
ចូរចងចាំនូវអ្វីដែលទ្រង់បានធ្វើ ដែលទ្រង់បានបង្ហាញអង្គ ទ្រង់ ជាអ្នក ហើយកុំវង្វេងឡើយ ។
ចុះពីឈើឆ្កាង ហើយយើងនឹងជឿលើទ្រង់ » ( ម៉ាថា យ ។
« ក្នុងចំណោមព្យាការី ណាដែលបុព្វបុរសរបស់អ្នកមិនបានបៀតបៀន ? » ។
ដូច្នេះ នេះ គឺជា ផល បូកសរុប នៃ ការថែ សួន របស់ ខ្ញុំ សម្រាប់ ថ្ងៃ ។
សុភមង្គល បច្ចុប្បន្ន របស់ ពួកគេ គឺជា លទ្ធផល នៃ ទុក្ខវេទនា ពីមុន របស់ ពួកគេ ហើយ រំលឹក ពី ការគិត របស់ វា ។
ហើយ វា គឺជា ព្រះដែល ផ្តល់ សន្តិភាព ។
Twitter មិនមែនជាក្រុមហ៊ុន ឬជាក្រុមហ៊ុនដ៏ល្បីមួយនោះទេ .. . វាជាមធ្យោបាយទំនាក់ទំនងដ៏មានប្រសិទ្ធភាព ។
ពេលថ្ងៃ រះ ទ្រង់បានហៅពួកសិស្សរបស់ទ្រង់ ហើយទ្រង់ជ្រើស រើសពួកគេ ១២ នាក់ — ទ្រង់ក៏ដាក់ឈ្មោះពួកគេថាជាសាវ័ក ។
ថាពួកគេនឹងរៀបការ គឺជាការ ផ្តល់ឱ្យ ហើយពួកគេបាននិយាយអំពី វាជាយូរមកហើយ ។
វា និយាយ ថា : ខ្ញុំ បាន ទទួល ពី ព្រះអម្ចាស់ នូវ អ្វី ដែល ខ្ញុំ បាន ប្រគល់ ជូន អ្នក ថា ព្រះអម្ចាស់ យេស៊ូ នៅ យប់ មុនពេល គាត់ ត្រូវបាន គេ ក្បត់ គាត់ បាន យក នំបុ័ង ។
រូបមន្តសម្រាប់នោះគឺជាការ បុកគូទបែបបុរាណដ៏ល្អ ហើយនោះជាអ្វីដែលពួកគេបានផ្ដល់ឱ្យយើងនៅថ្ងៃនេះ » ។
គ្មាននរណាម្នាក់បានឡើងទៅស្ថាន សួគ៌ឡើយ លើកលែង តែអ្នកដែលបានមកពីស្ថាន សួគ៌ គឺបុត្រមនុស្ស ។
អ្នក ទាំងនេះមិនស្រវឹងដូចអ្នក ស្មានទេ ព្រោះម៉ោង៩ ព្រឹកប៉ុណ្ណោះ ។
តើ អ្នក នឹង ធ្វើដំណើរ នៅ ពេលណា ។
ប្រជាជនទាំងអស់ព្យាយាមពាល់ព្រះអង្គ ព្រោះអំណាចបានមក ពីព្រះអង្គ ហើយប្រោសគេទាំងអស់គ្នា ។
ការសម្រេចចិត្ត ផ្លាស់ប្តូរ ជីវិត របស់ អ្នក ចាប់ផ្តើម នៅ ទីនេះ ។
យើងនឹងដាក់ទោសគេ ដោយព្រោះអំពើអាក្រក់ដែលគេបានប្រព្រឹត្ត ។
គាត់និយាយថា៖ «ឡាសារជាមិត្តរបស់យើងឥឡូវកំពុងដេក លក់ ។
២១ ដោយ សារអ្នកខ្លះដែលបាន លះ បង់គំនិតរបស់ខ្លួន នោះបានបែរចេញពីជំនឿ ។
ព្រះបន្ទូល របស់ ព្រះអាច បំបែក រវាង ព្រលឹង និង វិញ្ញាណ ។
ពេល គាត់ អធិស្ឋាន គាត់ មិន អាច រក ព្រះបាន ទេ ។
ចូរ អរសប្បាយ នៅ ថ្ងៃ នោះ ហើយ លោត ទៅ ដោយ អំណរ ព្រោះ រង្វាន់ របស់ អ្នក នៅ ស្ថាន សួគ៌ គឺ អស្ចារ្យ ណាស់ ។
ហើយអ្វីគ្រប់យ៉ាងដែលយើងនិយាយ យើងសន្មតថាជាគាត់ » ។
មិត្ត ភក្តិ ជាទី ស្រឡាញ់របស់ខ្ញុំមួយចំនួនបានទទួល មរណភាព ហើយ » ។
ដូច្នេះហើយពួកគេអោនមើលពួកគេ ។
កាលគេបានរកឃើញព្រះអង្គនៅត្រើយម្ខាងនៃសមុទ្រ គេទូលព្រះអង្គ ថា៖ « លោកគ្រូ តើព្រះអង្គមកដល់ទីនេះនៅពេលណា ? » ។
ទ្រង់ បាន បង្កើត សកលលោក ទ្រង់ បាន បង្កើត ផ្ទៃ មេឃ និង ផែនដី ។
« បងប្អូន អើយ ខ្ញុំ បាន បំពេញ កាតព្វកិច្ច ចំពោះ ព្រះជាម្ចាស់ ដោយ មនសិការ ល្អ រហូតមកដល់ សព្វ ថ្ងៃ នេះ » ។
« អ្នកបាន រង ទុក្ខរួមនឹងអ្នកដែលជាប់គុក ហើយទទួល យកដោយរីករាយនឹងការ រឹបអូសទ្រព្យ សម្បត្តិរបស់អ្នក ពីព្រោះអ្នកបានដឹងថាខ្លួនអ្នកមានទ្រព្យ សម្បត្តិល្អប្រសើរជាងមុន និងស្ថិតស្ថេរ ។
ទ្រង់ នឹង វិនិច្ឆ័យ ពិភពលោក ដោយ សុចរិត ។
សេរីភាព នៃ ក្រុមហ៊ុន គោរព បូជា នៃ អាជ្ញា កណ្តាល ;
គាត់ បាន ឆ្លើយ ពួកគេ ច្រើន បំផុត
វា ជា ថ្ងៃ ដំណឹង ដ៏ អស្ចារ្យ សម្រាប់ ពួកគេ ។
ការជួល រថយន្ត មួយ ផ្លូវ នៅ សហរដ្ឋ អាមេរិក
ខ្ញុំនឹងនៅជាមួយគាត់រហូតដល់យើងម្នាក់ស្លាប់ » ។
« ទ្រង់នឹងចម្រើនដល់យើង » ។
ហើយ បន្ត រហូតដល់ អ្នក មាន ស្តុក ពេញ ។
ស្ថាន សួគ៌ ដើម្បី អង្វរ មនុស្សជាតិ ឱ្យ ផ្សះផ្សា ជាមួយ ព្រះជាម្ចាស់ ។
ខទី 4: ប្រជាជន នៅ ទីក្រុង បាន បែកបាក់ គ្នា ; អ្នកខ្លះនៅខាង សាសន៍យូដា ខ្លះទៀតជាសាវ័ក ។
បើ ខ្ញុំ ស្រលាញ់ អ្នក កាន់តែ ច្រើន តើ អ្នក ស្រលាញ់ ខ្ញុំ តិច ទេ ?
បន្ទាប់មក ញ៉ាំ ឬ ដាក់ ក្នុង ទូរទឹកកក ។
ជនជាតិ សាម៉ារី ល្អ គឺជា មុខតំណែង ដែល ត្រូវបាន តែងតាំង ។
ហើយ ខ្ញុំ ជា អ្នក ដែល ព្រះដ៏ អស្ចារ្យ ។
បន្ទាប់មក យើងមើលការ ធ្វើដំណើរសម្រាប់អ្នកដែលអាចសម្របបាន និងអ្នកដែលមិនអាចធ្វើបាន ។
គ្រួសារ ទាំងអស់ នៅលើ ផែនដី នឹង ទទួល ពរ ដោយសារតែ អ្នក និង កូន ចៅ របស់ អ្នក ។
ត្រលប់ ទៅ ខែមិថុនា ។
ដូច្នេះ តើ ភាពស្ងៀមស្ងាត់ជាទម្រង់នៃ ភាពស្ងៀមស្ងាត់ឬ ?
ជម្រៅ របស់ ពួកគេ នៅ ពេល ដែល ពួកគេ បើក ខ្នង របស់ ពួកគេ
ឥឡូវនេះ ខ្ញុំ គិត ថា អ្វី ដែល ពួកគេ កំពុង ធ្វើ គឺ មាន សុវត្ថិភាព ។
ខ្ញុំត្រូវផ្តល់កិត្តិយសដល់អ្នកទាំងនោះឲ្យបានច្រើន ព្រោះពួកគេបានជួយបណ្ដុះខ្ញុំឲ្យក្លាយជាអ្នកដែលខ្ញុំសព្វ ថ្ងៃ » ។
ហើយ គាត់ បាន ឮ ការអធិស្ឋាន របស់ ខ្ញុំ ។
គាត់បាននិយាយថា៖ « ខ្ញុំមានមនសិការស្អាត ស្អំ ។
នេះជាទង្វើល្អសម្រាប់ពួកគេ ។
« ការ មកដល់នៃមនុស្សដែលគ្មានច្បាប់ នឹងស្របតាមកិច្ចការរបស់សាតាំង ដែលបានបង្ហាញនៅក្នុងអព្ភូតហេតុ ទី សំគាល់ និងការ អស្ចារ្យ ក្លែងក្លាយគ្រប់ប្រភេទ » ។
ហើយអ្នកក៏ធ្វើបន្ទាល់ដែរ ព្រោះអ្នកនៅជាមួយខ្ញុំតាំងពីដើមដំបូង មក ។
និង ហាសិប បួន ហិចតា ។
ខ្ញុំនិយាយអំពីអ្វីដែលខ្ញុំបានឃើញជាមួយនឹងបិតារបស់ខ្ញុំ ហើយអ្នក រាល់គ្នាធ្វើតាមអ្វីដែលអ្នក រាល់គ្នាបានឮពីឪពុករបស់អ្នក » ។
តើអ្នកដែលមានការ និមិត្ត និងអ្នកដែលលើកទឹក ចិត្តពួកគេបានទៅជាអ្វី ?
អង្វរ សម្រាប់ ម្តាយ ទាំងអស់ នៃ សម័យ របស់ យើង ដូច្នេះ ថា ពួកគេ អាច
ក្រៅពីឈ្មោះរបស់អ្នក រាល់គ្នា វាបង្ហាញពីពេលដែលពួកគេសកម្មចុងក្រោយនៅលើ Messenger ។
នៃ ប្រវែង នៃ ការពន្យា ពេល ។
ប្រាជ្ញា និង ភាពល្អ នៃ អ្វី ដែល មិន ត្រូវបាន បង្ហាញ ។
នៅក្នុង ព្រលឹង នោះ នឹង ត្រូវ កាត់ ចេញ ពី ក្នុង ចំណោម ប្រជាជន របស់ គាត់ ។
ឬ សម្រាប់ រយៈពេល ដែល អ្នក បាន ផ្តល់ ការអនុញ្ញាត ។
ស្គាល់គ្រប់ ជាតិ សាសន៍សម្រាប់ការ គោរពប្រតិបត្តិនៃសេចក្ដី ជំនឿ » ។
28:9 ដូច្នេះ តើអ្នកនឹងនិយាយនៅចំពោះមុខពួកអ្នកដែលកំពុងបំផ្លាញអ្នក នៅចំពោះមុខ ដៃនៃអ្នកដែលកំពុងសម្លាប់អ្នកថា ' ខ្ញុំ ជាព្រះ,' ទោះជាអ្នក ជាមនុស្ស , និងមិនមែនជាព្រះ?
ហើយស្ត្រីមានឋានៈខ្ពង់ខ្ពស់។
ដោយ ភាពរីករាយ ។
ដូច្នេះតើអ្នកនឹង មករកខ្ញុំឬខ្ញុំនឹង មក កាន់អ្នក ? '» ។
ម្យ៉ាង វិញ ទៀត ការចោទប្រកាន់ គឺជា អ្វី ដែល សាតាំង ធ្វើ ។
2 គេ នឹង បណ្ដេញ អ្នក ចេញ ពី សាលាប្រជុំ ។ ពិតប្រាកដ ណាស់ ពេលវេលា នឹង មកដល់ អ្នកណា ដែល សម្លាប់ អ្នក អ្នក នោះ នឹង គិត ថា អ្នក នោះ កំពុង ថ្វាយបង្គំ ព្រះ។
អ្នកនឹងត្រូវហៅថាអ៊ីស្រាអែល » ។
ខ្ញុំមិនដឹងថា ហេតុអ្វីបានជាប្ដីខ្ញុំធ្វើបែបនេះមកលើខ្ញុំ » ។
ហើយដើម្បីស្គាល់សេចក្ដី ស្រឡាញ់របស់ព្រះគ្រិស្ដដែលលើសជាងចំណេះដឹង ដើម្បីឲ្យអ្នកអាចទទួលបានការ បំពេញរហូតដល់ ភាព ពេញលេញនៃព្រះ។
ហើយពេលពាក់គេប្រកាសម៉ាកដល់មនុស្សនៅក្បែរនោះ ។
ពួកគេ បាន បង្ខំ ជីវិត ចេញ ពី ពួកគេ ។
ប៉ុន្តែរង្វាន់ត្រូវបានផ្តល់ជូនដោយ ស្មោះអស់ពី ចិត្ត ។
ដូច្នេះ មាន រយៈ ទទឹង ច្រើន នៅ ទីនោះ ។
ពីព្រោះអ្នកកំពុងជួប ប្រទះនឹងជម្លោះដូចគ្នាដែលអ្នកបានឃើញខ្ញុំនៅក្នុង ហើយឥឡូវនេះបានឮថាខ្ញុំនៅ តែប្រឈមមុខនឹង។
ព្រះ របស់យើងនឹងយាងមក ហើយមិននៅស្ងៀមឡើយ ។
លោកបានមាន ប្រសាសន៍ថា “ នេះជា ចម្លើយរបស់ខ្ញុំចំពោះការ ផ្តល់ជូនដែលអ្នក ជាអ្នកទទួល ” ។
« ដ្បិតបើព្រះ មិនបានទុកមែកធម្មជាតិទេ ទ្រង់ក៏មិនទុកអ្នកដែរ ។
ខ្ញុំ នឹង អធិស្ឋាន ដល់ គាត់ ពេញ មួយ ជីវិត របស់ ខ្ញុំ ។
“ យើង ទាំងអស់ គ្នា ត្រូវ រង់ចាំ បន្តិច ទៀត រហូតដល់ ថ្ងៃទី ២៤ ខែមីនា ។
នេះបើតាមការ ពិត ។
ហើយខ្លួនឯងបានប្រកាស ជាគ្រូទាយ ។
យើងខ្ញុំជឿ ហើយដឹងថាអ្នកគឺជាព្រះ ដ៏បរិសុទ្ធនៃព្រះ» ។
ប្រោសអ្នកចេញពីកណ្ដាប់ដៃរបស់អ្នកខ្លាំងពូកែ ។
រួចគាត់លុតជង្គង់ ហើយស្រែកយ៉ាងខ្លាំងថា
« អ្នក ណាបរិភោគនំបុ័ងនេះ អ្នក នោះនឹងមានជីវិតជារៀងរហូត ។
អ្វីគ្រប់យ៉ាងដែលយើងបានញ៉ាំ ( និងផឹក ) គឺមិនគួរឱ្យជឿ ។
អ្នក នឹង ចែករំលែក កន្លែង រស់ នៅ និង ផ្ទះ បាយ ជាមួយ អ្នក ជួល ផ្សេង ទៀត ។
ដើម្បី បញ្ជាក់ ដល់ ជនជាតិ យូដា ថា ពួកគេ ពិតជា មកពី ព្រះ។
ហើយ ជួយសង្គ្រោះ ពួកគេ ពី ការភ្លេចភ្លាំង ។
ព្រះទ្រង់ធ្វើដូច្នេះ ដើម្បីឲ្យគេស្វែង រកទ្រង់ ហើយប្រហែលជាឈោងទៅរកទ្រង់ » ។
ហើយទំនាយរបស់អេសាយបានសម្រេចក្នុងពួកគេ » ។
ខ្ញុំ គិត ថា វា សំខាន់ ជាង ក្នុង ការយក ឈ្មោះ របស់ ខ្ញុំ ចេញ នៅ ប្រទេស កូរ៉េ ។
ម្នាល ភិក្ខុទាំង ឡាយ កាលបើកាយទៀង ត្រង់ ចិត្តក៏ទៀងត្រង់ ។
ទ្រង់បានប្រគល់ដៃនាង ហើយលើកនាងទៅជើងនាង ហើយហៅអ្នក ជឿ និងស្ត្រីមេម៉ាយ នោះទ្រង់ក៏ប្រគល់នាងទៅពួកគេវិញទាំង រស់ ។
កូន ចៅ របស់ ព្រះអម្ចាស់ របស់ យើង ។
ហើយ ជួយ ពួកគេ ឱ្យដឹកនាំ ជីវិត ដ៏ វិសេសវិសាល ។
នេះជាបុត្រដ៏ ជាទី ស្រឡាញ់របស់ខ្ញុំ ដែលខ្ញុំពេញ ចិត្ត ។ ស្តាប់ ទ្រង់ !'
ដើម្បី បញ្ឆោត អ្នកបោះឆ្នោត ប្រសិនបើ អាច ធ្វើ ទៅ បាន ។
អ្នក នោះមិនមែនជាអ្នកដែលសរសើរខ្លួនឯងដែលពេញ ចិត្តទេ គឺ ជាអ្នកដែលព្រះ‌ អម្ចាស់សរសើរ ។
