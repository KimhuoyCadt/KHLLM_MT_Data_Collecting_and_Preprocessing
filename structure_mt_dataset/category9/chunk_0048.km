3 អ្នកយាមទ្វារបើកទ្វារឲ្យគាត់ ហើយចៀមក៏ស្តាប់សំឡេងគាត់ ។
កីឡាករ សញ្ជាតិ អាឡឺម៉ង់ បាន និយាយ ថា “ ខ្ញុំ ពិតជា គិត ថា ពួកគេ ជា ក្រុម ល្អ បំផុត នៅក្នុង ពិភពលោក នៅ ពេល នេះ ប៉ុន្តែ ខ្ញុំ ដឹង ថា យើង អាច យកឈ្នះ ពួកគេ ។
តាម រយៈការ ចូលខ្លួនរបស់ទ្រង់ ទ្រង់មាន បន្ទូលថា “ ខ្ញុំ ជាផ្លូវ ជាសេចក្តី ពិត និងជាជីវិត ។
ខ្ញុំ ស្រលាញ់ អ្នកគាំទ្រ របស់ ខ្ញុំ ទូទាំង ពិភពលោក !
ដូច្នេះ ចុច លើ ឈ្មោះ ពណ៌ ក្រហម របស់ ពួកគេ ហើយ ទៅ មើល បញ្ជី ឈ្មោះ ផ្សេង ទៀត ។
ប៉ុន្តែគាត់ជាហោរាម្នាក់ ហើយបានដឹងថាព្រះ បាន សន្យាលើគាត់ថាគាត់នឹងដាក់កូន ចៅម្នាក់លើបល្ល័ង្ករបស់គាត់ ។
មិន មាន គំរូ មួយ សម្រាប់ ការណែនាំ ទេ ។
រន្ធ , នៅ ពេល ដែល ត្រូវបាន អំពាវនាវ ឱ្យ បំពេញ កាតព្វកិច្ច របស់ ពួកគេ ។
ស្វែងរក ហាក់បីដូចជា ពួកគេ គួរ សម ជាង
កូនប្រុស ពីរ នាក់ ត្រូវបាន សម្លាប់ ។
ក្រុង ហេស បូន និងតំបន់ជាយ ក្រុង ក្រុង យ៉ាស៊ើរ និងតំបន់ជាយ ក្រុងទាំងបួន ។
ដោយ សារអំពើទុច្ចរិតរបស់ប្រជាជាតិទាំងនេះ ព្រះ អម្ចាស់នឹង បណ្ដេញពួកគេចេញពីមុខអ្នក រាល់គ្នា ។
នឹងត្រឡប់ទូរស័ព្ទវិញនៅពេលល្ងាច » ។
ហើយបុរសទាំង ពីរនាក់ជាជនជាតិម៉ូ ស្លី ម។
ប្រជាជនយូដាបានចាក់ប្រេងតាំងខ្ញុំជាស្ដេចលើពួកគេ » ។
រីករាយ ណាស់ ដែល បាន ជួប ជាមួយ គ្រួសារ របស់ អ្នក ។
ទ្រង់បានឃើញដោយសេចក្តី វេទនា ដើម្បីឃើញនូវអ្វីដែលបានទទួល អ្វីដែលបាន សង្គ្រោះ ។
ការបង្ហាញ ទ្រព្យសម្បត្តិ និង អំណាច នេះ មាន គោលបំណង ពីរ ។
តើអ្នកបាន រចនាអ្នកប្រណាំង / ទូកក្តោងពីមុនទេ ?
ហើយព្រលឹងរបស់គាត់បានឆ្លើយទៅគាត់ថាប្រហែលជាវានៅក្នុងទីក្រុងនេះ។
ហើយយើងនឹងលើកទង់របស់ព្យាការីរបស់យើង ( ឃើញ ) ។
រក្សា កំណត់ហេតុ ប្រចាំ ថ្ងៃ ត្រឹមត្រូវ នៃ ព្រឹត្តិការណ៍ និង ឥទ្ធិពល របស់ វា មក លើ អ្នក ដូច ដែល វា កើតឡើង ។
ហើយ ពួកគេ អះអាង ថា ពួកគេ នឹង សង ប្រាក់ វិញ ប្រសិនបើ វា មិន ដំណើរការ ។
ដើមឈើ ទាំង នេះ មាន សារៈសំខាន់ សម្រាប់ យើង ។
មួយ ពាន់ ឆ្នាំ មុន ការបង្កើត ពិភពលោក នេះ ហើយ ថា វា នៅ ទីនោះ ដែល ទេវតា គោរព
ដូច្នេះ វាជាការ វិនិច្ឆ័យរបស់ខ្ញុំ ដែលយើងមិនគួរបង្កការ លំបាកដល់ សាសន៍ ដទៃដែលងាក មក រកព្រះ ឡើយ ។
យើងដឹងថាកុលសម្ព័ន្ធ ណាដែលពួកគេ មកពី ណា ហើយពួកគេមានទំនាក់ ទំនងជាមួយនឹង (Mossad) ។
ពួកគេ នឹង ភ្ញាក់ផ្អើល ចំពោះ ភាព គួរ សម របស់ អ្នក ។
ខ្ញុំមិនចង់ឲ្យអ្នក ណាមើលមុខខ្ញុំទេ ។
នេះ ជារឿងដ៏ល្អបំផុតដែលភរិយាអាចធ្វើបាន ដើម្បីឲ្យស្វាមីមានសុភមង្គលពេញមួយថ្ងៃ ។
អ្វី ៗនៅ ចន្លោះស្ថាន សួគ៌ និងឋាន នរកនឹងត្រូវរហែកជាមួយគ្នា។
« សម្លាញ់អើយ អ្នកមាន ចិត្ត ស្មោះត្រង់នឹងអ្វីដែលអ្នកកំពុងធ្វើសម្រាប់បងប្អូន ទោះបីជាពួកគេ ជាមនុស្សចម្លែកចំពោះអ្នកក៏ដោយ ។
២៧ ស៊ីយ៉ូននឹងត្រូវប្រោស លោះដោយយុត្តិធម៌ ហើយពួកអ្នកដែលត្រឡប់មកវិញដោយសេចក្ដី សុចរិត ។
ប្រសិនបើយើងស្លាប់ក្នុងអំពើ បាបរបស់យើង យើងនឹងត្រូវបានបំបែក ជារៀងរហូតពីព្រះ ហើយ បញ្ចប់ទៅក្នុង ន រក ។
គាត់ នឹង ស្លាប់ យ៉ាង សាហាវ ។
ដូច្នេះ ចូរអង្វរព្រះអម្ចាស់នៃអ្នក ច្រូត កាត់ឲ្យបញ្ជូនកម្មករទៅច្រូតកាត់ ។
ធ្វើការ ល្អរបស់អ្នក និយាយប្រឆាំងនឹងឆន្ទៈរបស់ពួកគេ » ។
ថែរក្សា ពួកគេ ( ជាញឹកញាប់ ជាមួយនឹង ការសន្យា នៃ ទ្រព្យសម្បត្តិ មរតក ឬ
ថា ពួកគេ ក៏ ដូចជា អ្នក ដែល ពួកគេ បាន រៀបការ នឹង ត្រូវបាន រក្សាទុក យ៉ាង បរិសុទ្ធ ។
វា ដូចជា ស្ត្រី ទាំងអស់ នៅក្នុង ភ្នែក របស់ អ្នក មើល ។
យើងរស់នៅផ្ទះធំមួយ ព្រោះគាត់ រកបានច្រើន ។
លុះទ្រង់មានព្រះជន្ម១២ វស្សា ក៏ឡើងទៅបុណ្យតាមទំនៀម ទម្លាប់ ។
ពេលពួកគេ ឮអំពីច្បាប់ទាំងនេះ ពួកគេនឹងនិយាយថា៖ « ប្រជាជាតិអ៊ីស្រាអែលដ៏ធំនេះមានប្រាជ្ញានិងការ យល់ដឹង » ។
ត្រលប់ មកវិញ តាម ពេលវេលា កំណត់ ។
ដូច ដែល ពួកគេ មិន បាន ត្រឡប់ មកវិញ
ដូច្នេះ ចូរធ្វើអាហារមួយពេល៖ ប្រសិនបើព្រះអាទិត្យកំពុង រះ នោះគឺជាថ្ងៃដ៏ អស្ចារ្យ ។
ខ្ញុំ បាន ឃើញ រឿង នេះ កើតឡើង នៅក្នុង គ្រួសារ របស់ ខ្ញុំ ។
គាត់ ត្រូវបាន គេ ស្គាល់ ថា ល្អ បំផុត សម្រាប់ រឿង និទាន របស់ គាត់ នៅក្នុង សកលលោក ដែល ខ្ចាត់ខ្ចាយ ។
ហេតុនេះហើយបានជាខ្ញុំបានកាត់វាដោយពួកព្យាការី ខ្ញុំបានសម្លាប់គេដោយពាក្យ សម្ដីរបស់ខ្ញុំ ហើយការ វិនិច្ឆ័យរបស់ខ្ញុំក៏ចេញទៅដូច ជាពន្លឺ ( ហូ ៦: ៥) ។
ដរាបណា អ្នក ត្រៀមខ្លួន ដើម្បី ដាក់ទោស មនុស្ស អាក្រក់ ។
ដូច្នេះ យើងខិតខំប្រតិបត្តិ វាដោយការ កោតខ្លាចព្រះ និងដោយ ចិត្តអាណិត ។
ត្រូវ ក្លាហាន ចំពោះ ការពិត និង អំណាច របស់ វា
‹ អ្នក ណាដែលឈរយ៉ាងរឹងមាំដល់ចុងបំផុតនឹងបាន សង្គ្រោះ › ។
11 ខ្ញុំ សង្ឃឹម ថា អ្នក នឹង ស៊ូទ្រាំ នឹង ភាពល្ងង់ខ្លៅ របស់ ខ្ញុំ បន្តិច ។ ប៉ុន្តែ អ្នក កំពុង ធ្វើ វា រួចហើយ ។
ព្រះ នៃយើងខ្ញុំមិនដូចរូបព្រះ របស់ សាសន៍ ដទៃដែលគេធ្វើដោយមនុស្សដែលគោរពបូជានោះទេ ។
ប៉ុន្តែពួកគេត្រូវបានឃុំ ខ្លួនដោយសម្ងាត់ ។
កូនចៅអ៊ីស្រា ‌ អែលជាច្រើននឹងបែរទៅរកព្រះ‌ អម្ចាស់ ជាព្រះ របស់គេ ។
ប៉ុន្តែធ្វើ ដូចម្តេចទើបដឹងថាអ្នកកំពុងរងគ្រោះដោយសារអ្វីផ្សេង?
៨ ហើយខ្ញុំ យ៉ូហាន បានឮ ហើយបានឃើញរឿងទាំងនេះ ។
ត្រូវបាន បង្ហូរ សម្រាប់ មនុស្ស ជាច្រើន សម្រាប់ ការអភ័យទោស ពី អំពើ បាប ។
ក្មេងស្រី ឆ្លាត ទទួលបាន អ្វី ដែល ពួកគេ ចង់បាន ។
កុំ ទុក វា ចោល ក្នុង ផ្ទះ ដែល ការប្រើប្រាស់ របស់ ពួកគេ មាន ភាពងាយស្រួល ។
ពួកគេដើរទៅតាមជ្រលងទន្លេយ័រ ដាន់ ។
ដូច្នេះ គាត់ក៏ចេញទៅ ហើយយំយ៉ាងជូរ ចត់ ។
កាអ៊ីនបានដឹងថាគាត់ត្រូវការ ដង្វាយឈាម ដូចអេបិលបានធ្វើ ។
រីករាយ ជាមួយ ខ្សែភាពយន្ត ។
