ពួកយើង នឹង ខិតខំ ប្រឹងប្រែង ជានិច្ច ដើម្បី ទទួលបាន លទ្ធផល ល្អ នូវ ពេល បញ្ចប់ រដូវកាល ។
គូ បញ្ចាក់ ផងដែរ ថា ចំពោះ ជនជាតិ ខ្មែរ ពិធី រៀបអាពាហ៍ពិពាហ៍ គឺជា ព្រឹត្តិការណ៍ ដ៏ សំខាន់ ខ្លាំង ណាស់ សម្រាប់ ជីវិត មនុស្ស ម្នាក់ ៗ
សហរដ្ឋ អាមេរិក ផ្ញើ សារ រំលែក ទុក្ខ ក្រុមគ្រួសារ ជនរងគ្រោះ ទាំង ៧១ នាក់ ដែល ស្លាប់ ក្នុង ករណី ធ្លាក់ យន្តហោះ រុស្ស៊ី
គួរ បញ្ជាក់ ដែរ ថា នាង បាន ទទួល ពានរង្វាន់ នេះ ក្រោយពី ទទួល ការបោះឆ្នោត គាំទ្រ ប្រមាណ ៣៦, ៦៧៩សំឡេង ៕
ពពាក់ពពូន ហើយ មាន គ្រឿងញៀន ជាច្រើន ទៀត
ស្ថាប័ន នេះ គ្មាន បាន ការ អ្វី ទាំងអស់ សូម្បីតែ ប្រជាពលរដ្ឋ ក៏ មិន ពឹងពាក់ ដើម្បី ជួយ ដោះស្រាយ វិបត្តិ ឱ្យ ពួកគេ បាន ដែរ ។
ប្រធានបទ ស្រាវជ្រាវ
ទម្លាប់ ធ្វើជា ប្រចាំ និង ទៀងទាត់ ទើប អាច បាន រូបរាង ស្អាត បែប នេះ ដោយ នាង មិន បាន ទៅ កែសម្រស់ ឯណា នោះ ទេ ។
កន្លែង សម្រាប់ ទិញ ទំនិញ និង ទទួលទាន អាហារ ក្នុង បឹងកេងកង
លុយកាក់ មាន ខ្ទង់ ត្រូវ ចំណាយ ច្រើន នៅ ថ្ងៃ នេះ ។
អ្នក មិន មែន ប្រឈមមុខ នឹង បញ្ហា នេះ តែ ម្នាក់ឯង រហូត នោះ ទេ ។
ទង្វើ បែប នេះ គួរ ណាស់ កម្លោះ ក្រមុំ ទាំងឡាយ គ្រប់ រូប ពិចារណា មិន ត្រូវ ធ្វើ អ្វី មួយ ឱ្យ ប៉ះពាល់ ដល់ កិត្តិយស គ្រួសារ និង សង្គមជាតិ នោះ ឡើយ ។
៣០ លោក មាន កូនប្រុស ទាំងអស់ចិតសិប នាក់ ដ្បិត លោក មាន ប្រពន្ធ ច្រើន ។
តាមរយៈ នេះ ហើយ ទើប ធ្វើឱ្យ មហាជន កាន់តែ មាន ភាពសង្ស័យ ខ្លាំង ឡើង លើ រឿង នេះ ។
ទើប ភ្ជាប់ពាក្យ បាន មួយ រយៈ ស្រាប់តែ មាន អ្នក ហ៊ាន ទាត់ ធាក់ សូដានីតា
ខ្ញុំ ពិតជា សរសើរ ដោយ ស្មោះ ចំពោះ ការរៀបចំ ដ៏ ល្អ នេះ ។
នំ នេះ ក៏ បាន យក ឈ្មោះ តាម សែរាជ វង្ស របស់ ព្រះអង្គម្ចាស់ ល្វីស៍ មកពី រាជ វង្ស បាធេន ប៊ើក រហូតមក ។
រហូត នៅសល់ តែ ៤នាក់ ចុងក្រោយ ដើម្បីឱ្យ ពួកគេ ធ្វើ ការប្រកួត គ្នា ដណ្តើម ជើងឯក ។
ដូចជា ការរំលោភ សេពសន្ថវៈ ការទុក មនុស្ស មាន ជំងឺ ឱ្យ ស្លាប់ ដោយ មិន បញ្ជូន ទៅ មន្ទីរពេទ្យ ជាដើម ។
ការផ្លាស់ប្តូរ សេចក្តី បង្រៀន របស់ យើង មិន គួរ ធ្វើឱ្យ យើង ភ្ញាក់ផ្អើល ឬ រំខាន ដល់ ចិត្ត យើង ឡើយ ។
សូម ឱ្យ វិញ្ញាណក្ខន្ធ ពុក ទៅកាន់ ទី មួយ អស្ចារ្យ អស់ កាល ជានិច្ច ពុក នៅក្នុង ចិត្ត កូន ជារៀងរហូត កូន ចង់ និយាយ ជាមួយ ពុក ចង់ ប្រាប់ ថា កូន ស្រឡាញ់ ណាស់ ។
សកម្មភាព ចាក់ វ៉ាក់សាំង នៅ ភ្នំពេញ ពី ថ្ងៃ ១៣តុលា ។
លោក នាយ ខណ្ឌ រដ្ឋបាល បាន ឱ្យដឹង ថា ប្រតិបត្តិការ នេះ គោលដៅ ទី១ ៖
អ្នកស្រី ឈុន សុខា ជា អនុប្រធាន សហជីព ប្រចាំ ណាហ្គាវើលដ៍ ស្វាគមន៍ ចំពោះ ការគាំទ្រ ពី អង្គការ សង្គម ស៊ីវិល ផ្សេងទៀត ដើម្បី តស៊ូ ជាមួយនឹង អ្វី ដែល អ្នកស្រី ហៅ ថា ភាព អយុត្តិធម៌ កំពុង កើតមាន ចំពោះ មេដឹកនាំ សហជីព ។
របរ ឡើង ត្នោត អាច និយាយ ថា ជា ការចាប់អារម្មណ៍ សម្រាប់ ប្រជាពលរដ្ឋ នៅ ស្រុក ស្រែ មួយចំនួន តូច ដែល ពួកគាត់ បាន ចាប់ យក របរ នេះ ធ្វើជា របរ បន្ទាប់បន្សំ ។
បើ បញ្ហា ទាំងនេះ កើតឡើង គួរ ធ្វើ ដូចម្តេច ?
ចង់ ផ្តួល ហ៊ុន សែន តាមរយៈ បាតុកម្ម ឬ ក៏ តាមរយៈ កម្លាំង ទ័ព ?
លោក បារម្ភ មិន អាច លក់ ស្រូវ បាន ហើយ បំណុល កាន់តែ កើនឡើង ខណៈ លោក ធ្វើ ស្រែ ចំនួន ១០ហិកតា ហើយ ជួល គេ ៦ហិកតា ។
អោយ ឆេះ រហូតដល់ គ្រឹះ ។
ក្រោយមក ក៏ មាន ការ បង្ក្រាប ដោយ កម្លាំង អាជ្ញាធរ ។
គឺ ធ្វើ តាម ការមើលឃើញ ស្តាប់ លឺត ៗ
ទីក្រុង ឡុងដ៍ - អាកាសធាតុ នៅក្នុង ខែមករា, សីតុណ្ហភាព ទឹក
លោក បាន និយាយ ថា នេះ គឺជា សកម្មភាព បង្កហេតុ ចុងក្រោយ បង្អស់ និង ប្រទូសរ៉ាយ របស់ អ៊ីរ៉ង់ ចំពោះ នាវា ដែល កំពុង ធ្វើ ប្រតិបត្តិការ នៅក្នុង ដែន ទឹក អន្តរជាតិ ។
ក្រុម អ្នកជំនាញ អន្តរជាតិ នឹង ធ្វើដំណើរ ទៅកាន់ ចក្រភព អង់គ្លេស ក្នុង ពេល ឆាប់ ៗ
ប្តឹង មនុស្ស ៥នាក់ នៃ ចលនា សង្គ្រោះ …
អន្តរជាតូបនីយកម្ម នៃ វិវាទ ព្រ…
ពាក់ករណី នេះ លោក ឌីពៅ អភិបាល រង ក្រុង បាត់ដំបង បាន ចេញ លិខិត បញ្ឈប់ មិន ឱ្យ សាងសង់ បន្ត ទៀត ។
លោកស្រី មុំ ម៉ានុត បាន ឱ្យដឹង ទៀត ថា គាត់ បាន ចូលខ្លួន ទាញ ហេតុផល ផ្ទាល់ មាត់ នៅ តុលាការ ម្តង រួច មកហើយ ។
អត្ថន័យ នាម ខ្លួនខ្ញុំ ចូលចិត្ត
ចំណែក ២នាក់ ទៀត មិន ទាន់ សារភាព ថា បាន ពាក់ព័ន្ធ ក្នុង អំពើ ប្លន់ ប្រដាប់អាវុធ នោះ ទេ ។
មន្ត្រី នគរបាល ខណ្ឌ សែនសុខ បាន និយាយ ថា ការចុះបង្ក្រាប គ្រឿងញៀន នេះ គឺ ធ្វើឡើង តាម របៀប ចុះ ធ្វើ រដ្ឋបាល ដោយ មាន ការអនុញ្ញាតិ ពី គណៈ អភិបាល ខណ្ឌ និង មន្ត្រី តុលាការ ផងដែរ ៕
របស់ ពួកគេ ដើម្បី ប្រតិបត្តិ តាម សាសនា អ៊ីស្លាម ។
ទាំងនេះ ក៏ ដោយសារតែ សារធាតុ គីមី ដែល ត្រូវបាន គេ ប្រើ សម្រាប់ លាយ នៅក្នុង ថ្នាំ លាប ក្រចក អស់ ទាំងនោះ ។
តែ ត្រូវ ជា អាហារ សម្រន់ ដែល សម្បូរ ជីវជាតិ ញ៉ាំ រយៈពេល មួយ ម៉ោង មុន ហាត់ ។
ឈាម នឹង លំហូរ ទៅ កាន់ ផ្នែក ផ្សេង ៗ
លោក បន្ត ថា ការឈប់ សម្រាក របស់ កម្មករ ក្រសួង បាន កំណត់ តាម តំបន់ ផ្សេង ៗ
វា ជួយ ផ្តល់ ជាតិ សំណើម ដល់ ស្បែក ។
វា ទាក់ទង នឹង រឿង បច្ចេកទេស បន្តិច ។
លោក ថ្លែង នៅក្នុង សន្និសីទ មួយ ថា ៖
មិន ចេះ សុគត ទៀត
លើស ពី នេះ គាត់ ក៏ បាន ចែករំលែក នូវ បច្ចេកទេស នានា សម្រាប់ មហាជន ទូទៅ អាច ធ្វើ បាន ដូច គាត់ ផងដែរ ។
លោក រ៉ូប៊ីន មេក ភឺ សិន
រយៈពេល មធ្យម នៃ ការឃុំ ខ្លួន កុមារ ស្វែងរក សិទ្ធិ ជ្រកកោន ទាំងនោះ គឺ មាន រយៈពេល លើស ពី បួន រយ ថ្ងៃ ។
ឥត វិលត្រឡប់ មកវិញ ឡើយ ។
សូម បញ្ជាក់ ថា ទាល់តែ មាន ដំណរ អិន ធើនិត បាន អាច ស្តាប់ បាន ។
រដ្ឋាភិបាល ថៃ អនុម័ត ការចែកចាយ ផ្សេង ៗ
ចិន ៣ ផេន ហ៊ួរ មិន មែន ត្បាញ របាំង ការពារ មុខ ក្មេង សហជីព អ្នកលក់
ការងារ ធ្លាក់ចុះ កើតមាន ទំនាស់ ឈ្មោះ ប្រកែកគ្នា ។
យ៉ាងណា រឿង ស៊យ ផ្ទួន ៗ
ដូច្នេះហើយ ការសាងសង់ ថ្នាក់ កុំព្យូទ័រ នេះ មាន ន័យ ណាស់ សម្រាប់ ពួកយើង ទាំងអស់ គ្នា ។
ម្តាយ កញ្ញា ខេមរៈ ស្រី ពៅ និយាយ ទៅកាន់ សព កូនស្រី ស្តាប់ ហើយ រំជួល ចិត្ត ចង់ យំ …
នៅក្នុង អំឡុង ពេល សង្គ្រាម មនុស្ស ចំនួន ៥ម៉ឺន នាក់ ត្រូវបាន សម្លាប់ និង មនុស្ស រាប់ លាន នាក់ បាត់បង់ ទីជម្រក ។
ប្រជាពលរដ្ឋ នាំគ្នា ដេញ ចាប់ ជនសង្ស័យ ប្រគល់អោយ ប៉ូលិស តែម្តង ៕
តាម ការស្រាវជ្រាវ ថ្មី បំផុត របស់ ក្រុម អ្នកវិទ្យាសាស្ត្រ ថៃ បាន ឱ្យដឹង ថា ញើស នៅក្រោម ក្លៀក អាច ជា …
លទ្ធផល ឆ្នោត បឋម នៃ ការបោះឆ្នោត អសកល ក្នុង រាជធានី ភ្នំពេញ
អ្នក ជុំវិញ ខ្លួន តែងតែ ចូលចិត្ត ពឹងពាក់ លើ អ្នក ។
បិទ កុង តាក់ ប្រដាប់ ផ្លុំ សក់ ក្នុង ពេល ដែល យើង កំពុង លាប ចាហ៊ួយ ឬ ក្រែម សរសៃ សក់
កូរ៉េ ខាងជើង ព្រមាន ឱ្យ កាដូ ដ៏ ធំ មួយ ដល់ អាមេរិក ក្រោយ ការធ្វើតេស្ត ចុងក្រោយ
ខ្លាឃ្មុំ កូកា - កូឡា ខ្លាឃ្មុំ នៅលើ ទឹកកក
ភាព ស្ថិតស្ថេរ នៅ ត្រង់ ថា អ្វី ដែល អ្នក ធ្វើ ត្រូវតែ ជា លទ្ធផល ជះ ត្រឡប់ បង្ហាញ ពី ហេតុ អ្វី អ្នក ធ្វើ វា និង ដំណើរការណ៍ ដែល អ្នកប្រើប្រាស់ ដែល ធាតុ ផ្សំ នៃ ដង្ហើម ភាពជោគជ័យ ទាំង ៣នេះ ត្រូវ មាន ភាព តោង ស្អិត ល្មួត នឹង គ្នា ជានិច្ច ។
បើសិនជាជាតិ រីកចំរើន សិទ្វិ មនុស្ស រីកចំរើន បង មិន សប្បាយ ចិត្ត រឺ ។
ប្រសិនបើ ក្រុមប្រឹក្សា គេ កាត់សេចក្តី ថា យ៉ាងម៉េច យ៉ាង ម៉ាចាំ គេ តាម លទ្ធផល ហ្នឹង ទៅ ។
ចាប់អារម្មណ៍ ក្បាច់ ក្បូរ ហ្នឹង ស្អាត តែ ម៌្តង ពណ ហ្នឹង ក៏ សម ដែរ ។
មាន អាង ហែលទឹក ជា លក្ខណៈ ផ្ទាល់ខ្លួន មាន សួនច្បារ ផ្ទាល់ខ្លួន ជាមួយ ទំហំ ដី ២៤គុណ នឹង ៣០ម៉ែត្រ ការ៉េ ។
ខ្ញុំ សូម បញ្ជាក់ ថា ខ្ញុំ ស្រី ណូ មិន ដែល មាន ប្រវត្តិ ទាក់ទង បុរស ណា មាន ប្រពន្ធ ហើយ មិន ដែល មាន ប្រវត្តិ មាន ស្នេហា មិន ស្អាតស្អំ ដែល សង្គម មិន ឱ្យ តម្លៃ ទេ ។
សូមស្វាគមន៍ អ្នក ចំណូល ស្រុក ថ្មី និង កូន ៗ
ខាងលើ ឬ ដាច់ដោយឡែក ពី គ្នា ឬ រួមគ្នា ។
វា ប៉ះពាល់ ទាំងអស់ ទាំង កូនក្តី ខ្ញុំ ទាំង នីតិវិធី តុលាការ ដែល គេ ត្រូវ រក្សា ការសម្ងាត់ ទាំងអស់ ។
នរណា ក៏ មាន ទម្លាប់ មិន ល្អ ដែល គួរ ជម្រុះ ចោល ដែរ រួមទាំង អ្នក ផងដែរ ។
ជីហ្គាម៉ែត្រ ទៅ ណាណូ ម៉ែត្រ
បាតុកម្ម ទាមទារ ឱ្យ ត្រួតត្រា កាំភ្លើង បាន ធ្វើ នៅ រដ្ឋធានី វ៉ាស៊ីនតោន និង ទីក្រុង នានា ជុំវិញ ពិភពលោក
