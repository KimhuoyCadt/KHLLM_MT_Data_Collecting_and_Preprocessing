( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២១ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ២ករណី . ដឹកជញ្ជូន រក្សាទុក ៥ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣៧ នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ អបអរសាទរ និង ជូនពរ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ដែល ត្រូវបាន ព្រះមហាក្សត្រ ប្រទាន គោរមងារ ជា « សម្ដេច កិត្តិសង្គហ បណ្ឌិត »
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន ផ្ញើ សារ អបអរសាទរ និង ជូនពរ ជូន ចំពោះ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច ក្នុង ឱកាស ដែល ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ប្រោស ព្រះរាជ ទាន គោរម ងា « សម្ដេច កិត្តិសង្គហ បណ្ឌិត » ។
នៅក្នុង លិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បណ្តាញ ព័ត៌មាន Fresh News នៅ រសៀល ថ្ងៃ នេះ សម្តេច តេជោ បាន មានប្រសាសន៍ ថា ភរិយា ខ្ញុំ និង រូប ខ្ញុំ មាន សេចក្តីរីករាយ ជា អនេកប្បការ ដែល លោកជំទាវ ត្រូវបាន ព្រះមហាក្សត្រ ព្រះរាជាណាចក្រ កម្ពុជា ទ្រង់ សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជ ទាន គោរមងារ ជា សម្តេច កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ។
ក្នុង ឱកាស ដ៏ វិសេស ថ្លៃថ្លា នេះ សម្តេច តេជោ ហ៊ុន សែន សូម ជូនពរ សម្ដេច កិត្តិសង្គហ បណ្ឌិត និង កូនប្រុស កូនស្រី ប្រកបដោយ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ និង សូម សម្រេចបាន ជោគជ័យ ក្នុង គ្រប់ ភារកិច្ច បម្រើ ជាតិ និង មាតុភូមិ ៕ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ឃុំ កណ្តោល ជ្រុំ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ជួប សំណេះសំណាល ជាមួយនិង អតីត សកម្មជន គណបក្ស ប្រឆាំង ចំនួន ១៤៥ នាក់
( ត្បូងឃ្មុំ ) ៖ លោក តូច ចាន់ នី ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ឃុំ កណ្តោល ជ្រុំ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សំណេះសំណាល ជាមួយនិង អតីត សកម្មជន គណបក្ស ប្រឆាំង ១៤៥ នាក់ ដែល មក ចូលរួម ជីវភាព បក្ស ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា នៅ ស្នាក់ការ គណបក្ស ឃុំ កណ្តោល ជ្រុំ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី អនុប្រធាន ក្រុមការងារ លោក លោកស្រី សមាជិក ក្រុមការងារ ចុះ ជួយ ភូមិ ផងដែរ ។
បន្ទាប់មក លោក ប្រធាន គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ឃុំ កណ្តោល ជ្រុំ បាន អាន សេចក្តីសម្រេច បញ្ចូល សមាជិក បក្ស ថ្មី ទាំង ១៤៥ នាក់ ។ ជាមួយគ្នា នោះ ប្រធាន គណ: អធិបតី ក៏ បាន ប្រគល់ សេចក្តីសម្រេច ដល់ តំណាង សមាជិក ថ្មី ទាំង ១៤៥ នាក់ ។
ក្នុង ឱកាស នោះ លោក តូច ចាន់ នី ក៏ បាន ពាំនាំ ការសួរ សុខ ទុក្ខ និង ការនឹករលឹក ពី លោក វង សូត ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ជូន ចំពោះ សមាជិក - សមាជិកា ទាំងអស់ និង ពន្យល់ ដល់ ប្រជាពលរដ្ឋ ពី សារៈសំខាន់ នៃ ការចូលរួម ជីវភាព ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន គោល នយោបាយ ច្បាស់លាស់ និង មាន សក្តានុពលភាព ក្នុង ការគ្រប់គ្រង ដឹកនាំ និង កសាង ប្រទេសជាតិ ឱ្យ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ ជា និរន្ត ។
លោក បាន មានប្រសាស ន៏ បន្ថែម ទៀត ថា សមាជិក សមាជិកា ទាំងអស់ ត្រូវ ចេះ ស្រលាញ់ និង ជួយ សមាជិក សមាជិកា គណបក្ស ដូចគ្នា ជា សមាជិក សមាជិកា គណប្ស ប្រជាជន កម្ពុជា ត្រូវ ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា គណបក្ស មិន ទុក អោយ ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ អត់ បាយ នោះ ទេ ។
លោក តូច ចាន់ នី បាន ពាំនាំ ថវិកា និង វត្ថុអនុស្សាវរីយ៍ របស់ លោក វង សូត ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ មូលដ្ឋាន ស្រុក ពញា ក្រែក និង លោកស្រី ជូន ដល់ សមាជិក ថ្មី ទាំងអស់ ក្នុង ម្នាក់ ៗ ទទួលបាន អាវ បក្ស ០១. មួក បក្ស ០១. ក្រម៉ា ០១ និង ថវិកា ២០.០០០ រៀល ។
លោបាន រៀបចំ កម្មវិធី អាហារ សាមគ្គី រួមគ្នា ជាមួយ បងប្អូន សមាជិក សមាជិកា ថ្មី មួយ ពេល ផងដែរ ។
នៅ រសៀល ថ្ងៃ ដដែល លោក តូច ចាន់ នី ព្រមទាំង លោក សុខ ប៊ុន រួមទាំង ក្រុមការងារ ចុះ ជួយ ឃុំ កណ្តោល ជ្រុំ បាន ចុះ សួរសុខទុក្ខ ក្មួយ ៗ នៅ មេត្ត យ្យ សហគមន៏ មាន ភូមិ ដោត ភូមិ ពង ទឹក ភូមិ ស្វាយ មាស បាន ពាំនាំ នៅ អំណោយ សម្បុរស ធម៌ តាមរយៈ ក្រុមការងារ ជូន ដល់ ក្មួយ ចំនួន ៩៥ នាក់ ផងដែរ ៕ ទេសរដ្ឋមន្រ្តី លី ធុជ នាំយក អំណោយ សប្បុរសធម៌ របស់ សមាគម ពាណិជ្ជកម្ម អូស្រា្តលី ចែកជូន ដល់ ចាស់ជរា និង គ្រួសារ ក្រីក្រ ចំនួន ២៨០ គ្រួសារ នៅ ក្រុង បាវិត
អំណោយ ដ៏ សប្បុរស នេះ គឺជា លើក ទី៤ ដែល សមាគម ពាណិជ្ជកម្ម អូស្រ្តាលី មាន លោក សារ៉ា ជេក សុន ជា ប្រធាន និង លោក តាន់ សិទ្ធី ជា អនុប្រធាន បាន ចូលរួម ជាមួយ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ តាមរយៈ របស់ លោក ស៊ុយ ជីហ៊ាង ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន សង្កាត់ ច្រក ម្ទេស ។
ក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្រ្តី បាន ពាំនាំ សេចក្តីនឹករលឹក និង សាកសួរ សុខទុក្ខ ពី សម្តេច តេជោ និង សម្តេច កិត្តិព្រឺទ្ធ បណ្ឌិត ជូន ដល់ ប្រជាពលរដ្ឋ ស្ថិត ក្នុង ក្រុង បាវិត ទាំងអស់ ព្រមទាំង បាន ថ្លែងអំណរគុណ ចំពោះ ការផ្តល់ នូវ ទំនុកចិត្ត និង ការជឿជាក់ លើ ការដឹកនាំ របស់ សម្តេច តេជោ តាមរយៈ ការបោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា នា ពេល កន្លងមក នេះ ។
លោក បន្ត ទៀត ថា សន្លឹក ឆ្នោត របស់ បងប្អូន មួយ សន្លឹក បាន បង្ហាញ ពី ការគាំទ្រ នូវ គោល នយោបាយ ដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង គណបក្ស ប្រជាជន កម្ពុជា ក្នុង ការអភិវឌ្ឍ នៅ តាម មូលដ្ឋាន និង ដើម្បី ភាពសុខដុម របស់ ប្រជាពលរដ្ឋ មូលដ្ឋាន ផងដែរ ។ ជាមួយគ្នា នេះ លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាជន ទាំងអស់ បន្ត ការគាំទ្រ សម្តេច តេជោ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា សម្រាប់ អាណត្តិ ទី៧ ឆ្នាំ ២០២៣ នា ពេល ខាងមុខ ដើម្បី បន្ត ដឹកនាំ ប្រទេសជាតិ ឲ្យ កាន់តែ មាន ការអភិវឌ្ឍ ។
ពិធី នេះ បាន ធ្វេី ឡេីង នា ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ នៅ វិទ្យាល័យ ស្វាយរៀង ដោយ មាន ការចូលរួម ពី លោក ចាន់ វិចិត្រ . លោក កុយ សុធារ៉ា . រួមទាំង លោក លោកស្រី សមាជិក សមាគម និង លោកគ្រូ អ្នកគ្រូ ជា ច្រេីន រូប ផងដែរ ។
លេីក ឡេីង នា ឱកាស នោះ លោក កេត រិទ្ធី បាន ឱ្យដឹង ថា គោលបំណង នៃ ការរៀបចំ ជួបជុំ នេះ ដើម្បី ជា ការតបស្នង សង គុណ ដល់ លោកគ្រូ អ្នកគ្រូ ដែល លោក តែងតែ បាន ចំណាយ ពេលវេលា ដ៏ មាន តម្លៃ ដើម្បី ធ្វើ ការបង្ហាត់ បង្រៀន ដល់ សិស្សានុសិស្ស ដោយ មិន ខ្លាច ភាពនឿយហត់ រហូត ធ្វើឱ្យ សិស្ស ទាំងអស់ ទទួលបាន ភាពជោគជ័យ និង មាន ការងារ ធ្វើ សម ប្រកប មួយ និង បាន អះអាង ថា ដោយសារ មាន វត្តមាន លោកគ្រូ អ្នកគ្រូ ដែល ជា អ្នកមាន គុណ ទី២ ទើប ធ្វើឱ្យ រូប លោក មាន ថ្ងៃ នេះ ផងដែរ ។
បន្ថែម ពី នេះ លោក កេត រិទ្ធី ក្នុង នាម តំណាង ឱ្យ មិត្តភក្តិ រួម ជំនាន់ ទាំងអស់ សូម ថ្លែងអំណរ អរគុណ ដល់ លោកគ្រូ អ្នក ដែល បាន ជួយ បង្ហាត់ បង្រៀន ដល់ កូនសិស្ស ទាំងអស់ ឱ្យ ទទួលបាន ជោគជ័យ និង ក្លាយជា ទំពាំង ស្នង ឫស្សី ដែល សង្គម ចង់បាន និង បាន គោរព ជូនពរ ដល់ លោកគ្រូ អ្នកគ្រូ នា ឱកាស ពិធី ចូល ឆ្នាំ ថ្មី ប្រណៃណី ជាតិ ខ្មែរ ដែល នឹង ឈានចូល មកដល់ ក្នុង ពេល ដ៏ ខ្លី ខាងមុខ នេះ សូម មាន សុខភាព ល្អ និង បន្ត ក្លាយជា ម្លប់ សម្រាប់ សិស្សានុសិស្ស បន្ត ទៀត ផងដែរ ។
រុស្ស៉ី បាន អះអាង ជា យូរ មកហើយ ថា ខ្លួន បាន និង កំពុង ដឹកនាំ ការតស៊ូ ប្រយុទ្ធ ប្រឆាំង នឹង អនុត្តរភាព របស់ សហរដ្ឋ អាមេរិក នៅលើ ឆាក អន្តរជាតិ ហើយ ថា សង្រ្គាម របស់ ខ្លួន នៅ អ៊ុយក្រែន ក៏ ជា ផ្នែក មួយ នៃ ការតស៊ូ នេះ ដែរ ។ នៅក្នុង សប្ដាហ៍ នេះ ទីក្រុង មូស្គូ បាន បញ្ជាក់ ថា ខ្លួន គ្មាន ជម្រើស អ្វី ផ្សេង ទៀត នោះ ទេ ដោយ មាន តែ ត្រូវ បន្ត ធ្វើ សង្រ្គាម ដ្បិត មើល មិន ទាន់ ឃើញ ឡើយ ពី ដំណោះស្រាយ តាម ផ្លូវការទូត ។
ថ្លែង នៅក្នុង សន្និសីទ សារព័ត៌មាន មួយ នៅ ក្រោយ ជំនួប ជាមួយ សមភាគី តួកគី ក្នុង ទីក្រុង អង់ការ៉ា ប្រទេស តួកគី កាលពី ថ្ងៃសុក្រ ទី៧ ខែមេសា នេះ បាន កត់សម្គាល់ ដូច្នេះ ថា « រាល់ កិច្ចចរចា ទាំងឡាយ ចាំបាច់ ត្រូវតែ ឈរ លើ មូលដ្ឋាន មាន រួមបញ្ចូល ផលប្រយោជន៍ និង ក្ដីកង្វល់ របស់ រុស្ស៉ី ... ហើយក៏ គួរតែ ឈរ លើ គោលការណ៍ ដែល មាន សណ្ដាប់ធ្នាប់ ពិភពលោក ថ្មី មួយ ជា មូលដ្ឋាន ផងដែរ » ។
គួរ បញ្ជាក់ ថា បើ តាម លោក សឺហ្គៃ ឡាវ រ៉ូវ រុស្ស៉ី បាន ច្រានចោល សណ្ដាប់ធ្នាប់ ពិភពលោក មាន ប៉ូល តែ មួយ ឬ ត្រូវបាន គ្រប់គ្រង ផ្ដាច់ មុខ ដោយ សហរដ្ឋ អាមេរិក ៕
សូម ជម្រាប ថា នៅ ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ប្រកាស ឧបត្ថម ដល់ កីឡាករ Thiago ចំនួន ២ម៉ឺន ដុល្លារ . លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ឧបត្ថម្ភ ២.០០០ ដុល្លារ . លោកស្រី ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ឧបត្ថម្ភ ១.០០០ ដុល្លារ និង លោក ខៀវ កាញ៉ារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ឧបត្ថម្ភ ចំនួន ១.០០០ ដុល្លារ ៕
ជុំវិញ ការបង្កើន ចំនួន ប្រជាជន ក្រពើ ភ្នំ ឬ ក្រពើ ត្រី ឱ្យ មាន ចំនួន ច្រើន ឡើងវិញ នោះ លោក លូ វន្នី ប្រធាន កម្មវិធី អភិរក្ស ដី គោក នៃ អង្គការ សត្វ ព្រៃ និង រុក្ខជាតិ អន្តរជាតិ (FFI) ប្រចាំ ប្រទេស កម្ពុជា បាន ឱ្យដឹង ថា បច្ចុប្បន្ន មាន អង្គការ រួម នឹង ក្រុមហ៊ុន ចំនួន ៤ កំពុង សិក្សា ក៏ ដូចជា អភិរក្ស ទៅ លើ សត្វ ក្រពើ ភ្នំ ដែល ជា ប្រភេទ សត្វ ជិត ផុត ពូជ បំផុត លើ ពិភពលោក និង ស្ថិត ក្នុង បញ្ជី ក្រហម របស់ អង្គការ IUCN ដើម្បី ពន្លែង ទៅក្នុង តំបន់ ព្រៃ ធម្មជាតិ
លោក លូ វន្នី បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ ស្តារ សត្វ ក្រពើ ភ្នំ ឡើងវិញ ពីព្រោះថា នៅលើ ពិភពលោក យើង នេះ មាន សត្វ ក្រពើ ភ្នំ តែ ជាង ១ ពាន់ ក្បាល ប៉ុណ្ណោះ ហើយ ក្នុង ចំណោម នោះ ប្រទេស កម្ពុជា មាន សត្វ ក្រពើ ភ្នំ ប្រមាណ ជាង ៤០០ ក្បាល ។
បន្ថែម ពី នេះ អ្នក មន្ត្រី អង្គការ ផ្នែក អភិរក្ស សត្វ ក្រពើ ភ្នំ រូប នេះ បាន បញ្ជាក់ ថា បច្ចុប្បន្ន អង្គការ របស់ លោក មាន មជ្ឈមណ្ឌល បង្កាត់ ពូជ មួយ កន្លែង នៅ សួន សត្វ ភ្នំ តាម៉ៅ ដែល មាន សត្វ ក្រពើ ភ្នំ កំពុង បង្កាត់ និង ចិញ្ចឹម ថែរក្សា ចំនួន ១០៨ ក្បាល ក្នុង នោះ មាន ក្រពើ ភ្នំ ដែល កំពុង ពង កូន ចំនួន ៥សំបុក មាន ស៊ុត សរុប ចំនួន ១២៣ គ្រាប់ និង កំពុង ត្រូវបាន ដាក់ ក្នុង ទូភ្ញាស់ ។
ដោយឡែក សម្រាប់ ចំនួន តួលេខ ព្រលែង កូនក្រពើ ទៅក្នុង ធម្មជាតិ វិញ សម្រាប់ ឆ្នាំ ២០២៣នេះ . លោក វន្នី បាន គូសបញ្ជាក់ ថា មិន ទាន់ មាន តួលេខ ច្បាស់ នៅឡើយ នោះ ទេ ពីព្រោះ ត្រូវ ពិគ្រោះយោបល់ ជា មួួយ ស្ថាប័ន ដែល ពាក់ព័ន្ធ ដើម្បី កំណត់ ទីតាំង ព្រលែង ខណៈ តំបន់ ជួរ ភ្នំ ក្រវាញ ជា ទីតាំង ដែល មាន លក្ខណៈ ពិសេស សម្រាប់ ជម្រក របស់ ក្រពើ ភ្នំ ។
លោក បាន បន្ថែម ថា ក្រសួង បរិស្ថាន កំពុង ត្រៀមលក្ខណៈ ជាមួយ អង្គការ WWF ដើម្បី ធ្វើ ការបង្កើន ចំនួន សត្វ ក្រពើ ភ្នំ នៅ តាម តំបន់ ទន្លេ ស្រែ ពក តាមរយៈ ការលែង កូន សត្វ ក្រពើ ភ្នំ ដែល បាន តាមរយៈ ការភ្ញាស់ របស់ មន្ត្រី ជំនាញ ។
លោក នេត្រ ភក្រ្តា បាន លើកឡើង ថា « តាម អ្វី ដែល ខ្ញុំ ទទួលបាន គឺ យើង បាន ធ្វើ ការបង្កាត់ កូនក្រពើ ភ្នំ ច្រើន ហើយ យើង បាន លែង ចូលក្នុង តំបន់ ការពារ ធម្មជាតិ ជាពិសេស តំបន់ ទី ជម្រក សត្វ ក្រពើ ភ្នំ » ។
បន្ថែម លើ នេះ មន្ត្រី ជាន់ ខ្ពស់ រូប នេះ បាន គូសបញ្ជាក់ ថា ការបង្កាត់ ពូជ នេះ មិន មែន ជា រឿង ចម្លែក ហើយក៏ ពុំ មែន តែ កម្ពុជា ដែរ ពោលគឺ សត្វ មួយចំនួន ដែល ទទួល ការគំរាមកំហែង ជិត ផុត ពូជ គឺ គេ បាន រៀបចំ វិធីសាស្ដ្រ បង្កាត់ ពូជ ហើយ លែង ចូលក្នុង ជម្រក ធម្មជាតិ វិញ ដើម្បី បន្សាំ ក្នុង ធម្មជាតិ ។ មកដល់ ថ្ងៃ នេះ កម្ពុជា បាន ធ្វើ ការបង្កាត់ ពូជ សត្វ កម្រ ៗ មួយចំនួន ដូច ជា៖ សត្វ ក្រពើ ភ្នំ សត្វ អណ្តើក លួង និង កន្ធាយ ក្បាល កង្កែប ជាដើម ។
បើ តាម លោក សេង ទៀក ប្រធាន អង្គការ WWF កំពុង បន្ត តាមដាន ស្ថានភាព សត្វ ក្រពើ ភ្នំ នៅ តំបន់ ស្រែ ពក និង ពង្រឹង វិធានការ ការពារ ទី ជម្រក របស់ សត្វ នេះ ពី ការគំរាមកំហែង ផ្សេង ៗ បន្ថែម ពី នេះ ដើម្បី បង្កើន ចំនួន ក្រពើ ភ្នំ ឱ្យ មាន ចំនួន ច្រើន នៅ តំបន់ នេះ គឺ ទាមទារ ឱ្យ យក ក្រពើ ពី តំបន់ ផ្សេង ទៀត មក លែង នៅ តំបន់ ស្រែ ពក ។ ខណៈ ចំនួន ក្រពើ ដែល រកឃើញ កន្លង គឺ មាន សញ្ញាណ នៃ ការរីកធំធាត់ ក្នុង ជម្រក ធម្មជាតិ របស់ វា ។
តំណាង អង្គការ CI បាន បន្ត ថា ដោយ ពិភាក្សា យ៉ាង យកចិត្តទុកដាក់ សំណាក់ ក្រសួង បរិស្ថាន ក្រុហ៊ុន វារី អគ្គិសនី និង អង្គការ ពាក់ព័ន្ធ បាន ទម្លាក់ កម្ពស់ ទំបន់ វារី អគ្គិសនី រហូតបញ្ចៀស ការប៉ះពាល់ ត្រពាំង ដែល មាន សត្វ ក្រពើ រស់ នៅក្នុង តំបន់ អូរ សោម និង តំបន់ តាំ តៃ ទាំងមូល ផងដែរ ដូច្នេះ ការសាងសង់ ទំបន់ វារី អគ្គិសនី កន្លងមក មិន បាន បង្ក ផល ប៉ះពាល់ ដល់ ទី ជម្រក របស់ សត្វ ក្រពើ ភ្នំ នោះ ទេ ៕
ព័ត៌មាន លម្អិត៖ ករណី ខ្មាន់ កាំភ្លើង បាញ់ប្រហារ នៅ ក្រុង សៀមរាប . ខ្មាន់ កាំភ្លើង និង បង ថ្លៃ ស្រី កំពុង សង្គ្រោះ បន្ទាន់ ខណៈ ប្រពន្ធ និង ប្អូន ថ្លៃ ប្រុស ស្លាប់
( សៀមរាប ) ៖ ហេតុការណ៍ បាញ់ប្រហារ មួយ បាន បង្កឲ្យ មាន ការភ្ញាក់ យ៉ាង ខ្លាំង នៅ ព្រឹក ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២៣ ស្ថិត ក្នុង ភូមិ តា រៀន សង្កាត់ សាលា កំរើក ក្រុង សៀមរាប ខេត្ត សៀមរាប ដោយសារតែ ខ្មាន់ កាំភ្លើង ម្នាក់ បាញ់ប្រហារ មនុស្ស ៣នាក់ ក្នុង នោះ មាន ប្រពន្ធ . បង ថ្លៃ ស្រី និង ប្អូន ថ្លៃ ប្រុស រួច បាញ់ សម្លាប់ ខ្លួន តាម ក្រោយ ។
ជនរងគ្រោះ សរុប ទាំង ៥នាក់ រួម មាន៖
ដោយឡែក ជនរងគ្រោះ ដៃ ដល់ ឈ្មោះ ផា លាង ហៃ អាយុ ៤០ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ស្នាក់ នៅ បន្ទប់ ជួល ប៉ុន្តែ កម្លាំង កំណត់ ទីតាំង ជាក់លាក់ មិន ទាន់ បាន ( កំពុង សង្គ្រោះ ) ។
សមត្ថកិច្ច បាន រៀបរាប់ អង្គហេតុ ថា នៅ វេលា ម៉ោង ៧៖៣០ នាទី ព្រឹក ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២៣ ជនសង្ស័យ ឈ្មោះ ផា លាង ហៃ ប្រដាប់ ដោយ អាវុធ ខ្លី ម៉ាក CF98 ចំនួន ១ដើម ក្នុង ដៃ បាន សម្រុក ចូល ទៅក្នុង ផ្ទះ ជនរងគ្រោះ ឈ្មោះ ហាក់ ដារ៉ុង អាយុ ៤៥ ឆ្នាំ នៅ ជាន់ ទី១ ស្ថិត នៅ ភូមិ តា រៀន សង្កាត់ សាលា កំរើក ហើយ បាន ចាក់ សាំង ដុត ខោអាវ នៅមុខ បន្ទប់ ជនរងគ្រោះ បន្ទាប់មក បាន បាញ់ ទៅ លើ ជនរងគ្រោះ ឈ្មោះ ហាក់ ដារ៉ុង ត្រូវ ចំក្រោម ផ្ចិត ចំនួន ១គ្រាប់ ( ស្លាប់ នៅ កន្លែង កើត ហេតុ ) ។
បន្ទាប់មក ជន ដៃ ដល់ បាន ឡើងជិះ ម៉ូតូ សំដៅ ទៅ កន្លែង កើត ហេតុ ទី២ គឺ តូប លក់ បន្លែ របស់ ឈ្មោះ យ៉ង់ ស្រី មុំ អាយុ ៤៥ ឆ្នាំ ជាប់ ផ្សារ លើ ធំ ថ្មី ស្ថិត នៅ ភូមិ ដក ពោធ៌ សង្កាត់ ស្ល ក្រាម ពេល ទៅដល់ ជន ដៃ ដល់ បាន បាញ់ ទៅ លើ ជនរងគ្រោះ ឈ្មោះ យ៉ង់ ស្រី មុំ ចំនួន ២គ្រាប់ ចំទ្រូង ខាងស្តាំ ចំនួន ១គ្រាប់ និង ចំទ្រូង ខាង ធ្វេង ចំនួន ១គ្រាប់ ( កំពុង សង្គ្រោះ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប ) ។
( ភ្នំពេញ ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន គណ:កម្មាធិការ កែទម្រង់ រដ្ឋបាល សាធារណៈ បាន អញ្ជើញ ធ្វើបាឋ កថា ស្ដីពី « ភាពជា អ្នកដឹកនាំ ន វានុវត្តន៍ និង គុណាធិបតេយ្យ ក្នុង រដ្ឋបាល សាធារណៈ » ជូន ដល់ សាស្ត្រាចារ្យ និង និស្សិត នៃ វិទ្យាស្ថាន ខេម អេដ (CamEd) នៅ រាជធានី ភ្នំពេញ ។
ពិធី នេះ បាន ប្រព្រឹត្តទៅ នា រសៀល ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២៣ នៅ វិទ្យាស្ថាន ខេម អេដ (CamEd) ដោយ មាន ការចូលរួម ពីសំណាក់ លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ នៃ ក្រសួង មុខងារ សាធារណៈ ព្រមទាំង គណៈ គ្រប់គ្រង សាលា សាស្ត្រាចារ្យ និង និសិ្សត សរុប មាន អ្នកចូលរួម ចំនួន ជាង ១៥០ នាក់ ។
លោក រដ្ឋមន្ត្រី ដែល ជា ប្រធាន គណ:កម្មាធិការ កែទម្រង់ រដ្ឋបាល សាធារណៈ បាន សង្កត់ធ្ងន់ ថា « ភាពជា អ្នកដឹកនាំ (Leadership) គឺជា សិល្បៈ នៃ ការគិត និង ការសម្រេច ។ សារៈប្រយោជន៍ នៃ ភាព ជា អ្នកដឹកនាំ គឺ សម្រាប់ ប្រើប្រាស់ ក្នុង ជីវិត រស់ នៅ របស់ មនុស្ស ទាំងអស់ មិន ថា មន្រ្តី រាជការ កម្មករ កសិករ សិស្ស និសិ្សត និង ប្រជាពលរដ្ឋ គ្រប់ រូប តស៊ូ រៀនសូត្រ ប្រកបរបររកស៊ី បំរើ ការងារ តាម សម្មា អាជី វោ ដើម្បី ដឹកនាំ ជីវិត ឆ្លងកាត់ ការលំបាក ឧបសគ្គ ឆ្ពោះ ទៅកាន់ អនាគត រៀង ៗ ខ្លួន » ។
លោក រដ្ឋមន្រ្តី បាន ចែករំលែក ដោយ ផ្សាភ្ជាប់ ទ្រឹស្តី នៃ ការសិក្សា ជាមួយ បទពិសោធន៍ ការងារ ជាក់ស្តែង ដែល ខ្លួន លោក បាន ឆ្លងកាត់ ក្នុង នាម ជា អ្នក រដ្ឋបាល បម្រើ ការងារ សាធារណៈ រយៈពេល ជាង ៤០ ឆ្នាំ កន្លងមក ពិសេស ៣ឆ្នាំ ចុងក្រោយ ក្នុង នាម ជា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ ដែល បាន ពុះពារ ជំនះ ដោះស្រាយ ការលំបាក ស្មុគស្មាញ បង្ក ដោយ កូវីដ - ១៩ ជម្រុញ ការងារ ក្នុង ស្មារតី បុរេសកម្ម ប្រកបដោយ ន វានុវត្តន៍ ដំណើរការជា ប្រក្រតី មាន ភាពធន់ រលូន ដើរ ទាន់ ការវិវត្ត ប្រែប្រួល សភាពការណ៍ នៃ សម័យកាល ។
តាមរយៈ ការធ្វើបាឋ កថា នេះ លោក រដ្ឋមន្រ្តី បាន គូសបញ្ជាក់ ច្បាស់ ពី វឌ្ឍនភាព ថ្មី ៗ នៃ កំណែទម្រង់ រដ្ឋបាល សាធារណៈ ក្រោម មគ្គុទ្ទេសក៍ ផ្ទាល់ ថ្លៃថ្លា របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល បាន ធ្វើឱ្យ ប្រទេស កម្ពុជា រួច ចាក ផុត ពី សង្គ្រាម ពី ការបែកបាក់ ជាតិ នាំ សង្គមជាតិ កម្ពុជា មកកាន់ សុខ សន្តិភាព ឯកភាព ជាតិ និង មាន ការអភិវឌ្ឍ ប្រកបដោយ វិបុលភាព ដរាបត រៀងមក ។
ជោគជ័យ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ក្នុង ការប្រយុទ្ធ ឈ្នះ កូវីដ - ១៩ នាំ សង្គមជាតិ មកកាន់ ប្រក្រតី ធម្មតា ឡើងវិញ ដូច សព្វ ថ្ងៃ និង ជោគជ័យ ដ៏ ត្រចះត្រចង់ នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន និង កិច្ចប្រជុំ កំពូល ពាក់ព័ន្ធ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ចាប់ពី ថ្ងៃទី ១០ ដល់ ទី ១៣ ខែវិច្ឆិកា ឆ្នាំ ២០២២ កន្លងមក ជា សក្ខីភាព យ៉ាង ប្រត្យក្ស បញ្ជាក់ ពី ផ្លែ ផ្កា នៃ ការកែទម្រង់ ផ្លាស់ប្តូរ មុខមាត់ កម្ពុជា ពិតប្រាកដ ។
ចុងបញ្ចប់ លោក រដ្ឋមន្ត្រី ព្រុំ សុខា បាន សម្តែង នូវ ក្តីសង្ឃឹម យ៉ាង មុតមាំ ថា តាមរយៈ បាឋ កថា ចែករំលែក នេះ នឹង បាន ក្លាយជា គតិ សម្រាប់ ការត្រិះរិះ ពិចារណា រួមចំណែក ជួយ និស្សិត ទាំងអស់ អាច ប្រើប្រាស់ ដើម្បី ជា ប្រយោជន៍ នៃ ការកសាង ជីវិត និង អនាគត ៕
លោកជំទាវ វេជ្ជបណ្ឌិត យក់ សម្បត្តិ និង ស្វាមី បរិច្ចាគ ថវិកា ១០លាន រៀល ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ លោកជំទាវ វេជ្ជបណ្ឌិត យក់ សម្បត្តិ រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សុខាភិបាល និង ស្វាមី បាន បរិច្ចាគ ថវិកា ចំនួន ១០លាន រៀល ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
លោកជំទាវ វេជ្ជបណ្ឌិត យក់ សម្បត្តិ និង ស្វាមី តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
លោក ហ៊ុន ម៉ានី៖ « ព្រឹត្តិការណ៍ អង្គរ សង្ក្រាន្ត » ធ្វើឡើង ដើម្បី លើកតម្កើង នូវ សិល្បៈ អរិយធម៌ និង វប្បធម៌ ដ៏ ផូរផង់ របស់ កម្ពុជា
( សៀមរាប ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី បើក « កម្មវិធី ជិះ កង់ អង្គរ សង្ក្រាន្ត » នា ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ នៅមុខ បរិវេណ ឧទ្យាន ជាតិ អង្គរវត្ត ។ កម្មវិធី នេះ មាន ការចូលរួម ពីសំណាក់ អនុប្រធាន ស ស យ ក សមាជិក និង សាធារណជន ចំនួន ១៤ ក្រុម សរុប ប្រមាណ ៤១២ នាក់ ផងដែរ ។
ថ្លែង ក្នុង ពិធី បើក នេះ លោក ហ៊ុន ម៉ានី បាន លើកឡើង ថា គោលបំណង នៃ ការបង្កើត កម្មវិធី នេះ ឡើង គឺ ដើម្បី អបអរសាទរ ខួប១០ ឆ្នាំ នៃ ព្រឹត្តិការណ៍ អង្គរ សង្រ្កាន្ត និង ដើម្បី អបអរសាទរ ការឈាន មកដល់ ព្រឹត្តិការណ៍ ការប្រកួត កីឡា ស៊ីហ្គេម លើក ទី ៣២ និង អាស៊ាន ប៉ារ៉ាហ្គេម លើក ទី ១២ ដែល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ។
លោក បាន បន្ត ថា « ព្រឹត្តិការណ៍ នេះ ក៏ ធ្វើឡើង ដើម្បី លើកតម្កើង នូវ កិត្យានុភាព ជាតិ សិល្បៈ អរិយធម៌ វប្បធម៌ ដ៏ ផូរផង់ របស់ កម្ពុជា ជាពិសេស គឺ បង្ហាញ ពី មោទកភាព ក្នុង នាម ជា ខ្មែរ ដូចគ្នា » ។
លោក បាន បន្ត ទៀត ថា ព្រឹត្តិការណ៍ អង្គរ សង្ក្រាន្ត ដែល នឹង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ១៤ - ១៦ ខែមេសា ក្រោម ប្រធានបទ « ក្តីស្រមៃ និង ក្តីសង្ឃឹម » នឹង ផ្តល់ ឱកាស ដល់ ប្រជាជន កម្ពុជា ទាំងអស់ ក៏ ដូចជា មិត្តភ័ក្តិ អន្តរជាតិ ទាំងអស់ បាន ជួបជុំគ្នា រីករាយ និង ទទួលបាន បទពិសោធន៍ មិន អាច បំភ្លេច បាន ក្នុង ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ។
កិច្ចពិភាក្សា នេះ មាន នឹង មាន វាគ្មិន ចូលរួម ដូច ជា៖
( បាត់ដំបង ) ៖ រដ្ឋបាល ខេត្ត បាត់ដំបង នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន រៀប ពិធី ក្រុង ពាលី សូត្រ មន្ត បួងសួង សុំ សេចក្តីសុខ រាប់ បាត ប្រគេន ព្រះសង្ឃ ចំនួន ៨២ អង្គ និង ទស្សនា របាំ ត្រុដិ ដើម្បី អបអរសាទរ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ មមី ប្រពៃណី ជាតិ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ គ. ស២០២៣ ។
ពិធី នេះ ធ្វើឡើង នៅ មុខ លោតា ដំបង គ្រញូង និង ក្នុង សាលាខេត្ត ដឹកនាំ ដោយ លោក លោក អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង ភរិយា . លោក សុខ លូ អភិបាល ខេត្ត និង ភរិយា និង មាន ការអញ្ជើញ ចូលរួម អភិបាល ក្រុង ស្រុក ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត មន្រ្តី រាជការ សាលា ខេត្ត ចូលរួម ផងដែរ ។
លោក សុខ លូ បាន លើកឡើង ថា ជារៀងរាល់ ឆ្នាំ រដ្ឋបាល ខេត្ត តែងតែ រៀបចំ ព្រឹត្តការណ៍ បុណ្យ ជាតិ ធំ ៗ ដោយ មាន រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ជា ប្រមុខ ដឹកនាំ បាន កំណត់ ទៅ តាម ក្នុង ប្រតិទិន ប្រចាំ ឆ្នាំ ស្រាប់ ។
ក្នុង ឱកាស នោះ ខេត្ត បាន រៀបចំ បួងសួង ដល់ លោកតា ដំបង គ្រញូង និង វត្ថុ ស័ក្តិសិទ្ធ ក្នុង ខេត្ត ព្រមទាំង បាន សូត្រ មន្ត សូម ព្រះសង្ឃ បាន ប្រោស ព្រំ ដល់ កូន ចៅ ឲ្យ មាន សិរី សួស្តី ជ័យ មង្គល វិបុល សុខ គ្រប់ ប្រការ សម្រាប់ ឆ្នាំ ថ្មី និង រាប់ បាត ប្រគេន ដល់ ព្រះសង្ឃ ចំនួន ៨២ អង្គ ដើម្បី ឧទ្ទិស កុសល ជូនញ្ញាតិការ ដែល បាន បែកបាក់ ចែក ឋាន ទៅ ហើយ នោះ មក ទទួល កុសល ផល បុណ្យ ដែល កូន ចៅ បាន ធ្វើ ជូន និង ឲ្យ ពរ កូន ចៅ បាន សុខស ប្យាយ ទាំងអស់ គ្នា ក្នុង ឆ្នាំ ថ្មី នេះ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា នៅក្នុង ឆ្នាំ ២០២៣ នេះ មាន ព្រឹត្តការណ៍ ជាច្រើន ដែល ខេត្ត យើង បាន ធ្វើ រួច និង កំពុង បន្ត ធ្វើ នា ពេល ខាងមុខ នេះ ដោយ មាន ការតុបតែង លម្អ ក្រុង និង នៅ តាម ស្ថាប័ន រៀង ៗ ខ្លួន គឺ ធ្វើ សង្រ្កាន្ដ បាត់ដំបង ឆ្នាំ នេះ ដើម្បី អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ខ្មែរ ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ២០២៣ នេះ ជូន ប្រជាពលរដ្ឋ រស់ នៅ ខេត្ត ផ្សេង ៗ បាន មក លេង កម្សាន្ត សប្បាយរីករាយ នៅ ស្រុក កំណើត បាន ជួបជុំ គ្រួសារ និង ដើរលេង ទេសចរណ៍ នៅ តាម រម្មណីដ្ឋាន នានា សប្បាយរីករាយ ផងដែរ ៕
គោ៨ ក្បាល ត្រូវ រន្ទះ បាញ់ ងាប់ ទាំង កណ្ដាល អធ្រាត្រ នៅ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង
( កំពង់ឆ្នាំង ) ៖ សត្វ គោ ០៨ ក្បាល ត្រូវបាន រន្ទះ បាញ់ ងាប់ ទាំង ពាក់កណ្ដាល អាធ្រាត្រ ស្ថិត ក្នុង ភូមិ កំពង់ អួរ ឃុំ ឃុន រ៉ង់ ស្រុក បរិបូណ៌ ខេត្ត កំពង់ឆ្នាំង ។
លោក មេភូមិ កំពង់ អួរ បាន ប្រាប់ តាម ទូរស័ព្ទ ឱ្យដឹង ថា នៅ វេលា ម៉ោង ០១៖០០ នាទី រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៣ មាន ភ្លៀង មួយ មេ យ៉ាង ខ្លាំង និង ខ្យល់ លាយឡំ និង ផ្គរ រន្ទះ ផង បាន ធ្វើឲ្យ សត្វ គោ ០៨ ក្បា ល ដេក ក្នុង ក្រោល ត្រូវបាន រន្ទះ បាញ់ ងាប់ នៅ និង កន្លែង ។
លោក មេភូមិ បាន បញ្ជាក់ ថា ហ្វូង គោ ដែល នៅក្នុង ក្រោល ទាំងអស់ មាន ជាង ២០ ក្បាល តែ ត្រូវ រន្ទះ បាញ់ ងាប់ ០៨ ក្បាល ក្រៅពី នោះ គឺ ពុំ មាន គ្រោះថ្នាក់ អ្វី ឡើយ ។
លោក បញ្ជាក់ ទៀត ថា សត្វ គោ ទាំងអស់ នេះ គឺ ម្ចាស់ របស់ វា នៅ ភូមិ សេរី ក្នុង ឃុំ ខុន រ៉ង់ ហើយ ម្ចាស់ បាន ធ្វើ ក្រោល ឱ្យ ដេក នៅមុខ វត្ត កំពង់អួរ ដែល មាន ចម្ងាយ ពី ផ្ទះ ម្ចាស់ ជាង ២គីឡូម៉ែត្រ ដើម្បី ងាយស្រួល និង ឃ្វាល ផងដែរ ។
ហេតុការណ៍ ខាង លើ នេះ ម្ចាស់ សត្វ គោ មាន ការសោកស្ដាយ យ៉ាង ខ្លាំង តែ នេះ វា ជា គ្រោះ ធម្មជាតិ ដែល មិន អាច ដឹង មុន ។ ការបាត់បង់ សត្វ គោ ៨ ក្បាល នេះ ជា ខាតបង់ មួយ ដែល មាន ទំហំ ធំធេង ផងដែរ សម្រាប់ ប្រជាកសិករ នៅ ស្រុ ក ស្រែ ចម្ការ ។
ក្នុង នាម លោក ជា អាជ្ញាធរ មាន តែ ការចូលរួម សោកស្ដាយ ជាមួយនឹង ម្ចាស់ សត្វ គោ តែ ប៉ុណ្ណោះ ហើយ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ស្រុក តាម ទី ជនបទ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ទាំងអស់ គ្នា ព្រោះ រដូវ វស្សា ជិត ចូល មកដល់ ហេតុ នេះ ទាំង ភ្លៀង ផ្គរ រន្ទះ ខ្យល់ កន្រ្តាក់ គឺ កាច សាហាវ ណាស់ ដូច្នេះ ត្រូវតែ មាន ការប្រុងប្រយ័ត្ន ទាំងអស់ គ្នា ៕
លោក បណ្ឌិត ហ៊ុន ម៉ាណែត៖ សន្តិភាព និង ស្ថិរភាព ជា បរិស្ថាន អំណោយផល ដ៏ ធំ បំផុត សម្រាប់ សង្គម កម្ពុជា ទាំងមូល
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ប្រធាន គណៈកម្មាធិការ អាហារូបករណ៍ សិស្ស - និស្សិត ក្រីក្រ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន បញ្ជាក់ ថា សន្តិភាព និង ស្ថិរភាព គឺជា បរិស្ថាន អំណោយផល ដ៏ ធំ បំផុត សម្រាប់ សង្គម កម្ពុជា ទាំងមូល ។
លោក បាន គូស រំលេច ទៀត ថា « ដូចនេះ ភារកិច្ច ចម្បង របស់ ប្រជាពលរដ្ឋ គ្រប់ រូប ៗ គឺ ការបន្ត រួបរួម គ្នា ថែរក្សា កេរ ដំណែល ដ៏ មាន តម្លៃ មហាសាល នេះ ឱ្យ បាន គង់វង្ស សម្រាប់ ជាតិ និង ប្រជាជន គ្រប់ ជំនាន់តទៅ តាមរយៈ ការអនុវត្ត នូវ គោល នយោបាយ ដ៏ ត្រឹមត្រូវ និង ឥត ងាក រេ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា សំដៅ ជំរុញ ការអភិវឌ្ឍ ជាតិ មាតុភូមិ និង ធ្វើ យ៉ាង ឱ្យ ប្រជាជន ទទួលបាន នូវ ផល សម្រាប់ ខ្លួន និង គ្រួសារ ហើយ អាចនឹង ផ្តល់ ផល ត្រលប់មក សង្គមជាតិ ទាំងមូល វិញ ផងដែរ » ។
ការថ្លែង បញ្ជាក់ របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត នេះ បាន ធ្វើឡើង ក្នុង ពិធី សំណេះសំណាល និង ពិសា អាហារ សាមគ្គី ជាមួយ សមាជិក - សមាជិកា សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា កាលពី ល្ងាច ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២៣ ។
នៅក្នុង ឱកាស នោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត សូម អរគុណ និង កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ សមាជិក - សមាជិកា ទាំងអស់ នៃ សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា ដែល បាន រួបរួម គ្នា ចូលរួម យ៉ាង សកម្ម ក្នុង កិច្ចការ អប់រំ និង បណ្តុះបណ្តាល ធនធាន មនុស្ស នៅ កម្ពុជា ជា ប្រយោជន៍ សម្រាប់ អនាគត របស់ សិស្ស - និស្សិត ដោយ សម្រេចបាន នូវ សមិទ្ធផល ជាច្រើន ចាប់តាំងពី ការបង្កើត សមាគម នេះ នា ឆ្នាំ ២០០៤ ដើម្បី ចូលរួម អនុវត្ត គោល នយោបាយ ក្នុង វិស័យ អប់រំ របស់ រាជ រដ្ឋាភិបាល ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ ក៏ បាន សម្ដែង ការថ្កោលទោស ផងដែរ ចំពោះ សកម្មភាព យោធា របស់ ចិន ដោយ ហៅ ថា ជា សកម្មភាព គ្មាន ហេតុផល ។ បើ តាម ក្រសួង នៅក្នុង ចំណោម យន្ដហោះ ចម្បាំង ចិន ទំាង ៤២ គ្រឿង ខាងលើ ក្នុង នោះ មាន ២៩ គ្រឿង បាន ហោះ ឆ្លងកាត់ ខ្សែ បន្ទាត់ កណ្ដាល នៃ តំបន់ ច្រក សមុទ្រ តៃវ៉ាន់ នៅ ចន្លោះ ពី ម៉ោង ៦ និង ១១ព្រឹក ថ្ងៃសៅរ៍ នេះ ( ម៉ោង នៅក្នុង តំបន់ ) ។
ការប្រគល់ ប្រាក់ ឧបត្ថម្ភ នេះ គឺជា ការលើកទឹកចិត្ត ចំពោះ កីឡាករ Thiago ដែល ជានិច្ចកាល តែងតែ ជួយ លើកតម្កើង តម្លៃ វប្បធម៌ ខ្មែរ ពិសេស គឺ ក្បាច់គុន ខ្មែរ ផ្សព្វផ្សាយ នៅលើ ឆាក ជាតិ និង អន្តរជាតិ នា ពេល កន្លងមក ។
សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន បញ្ជាក់ ដែរ ថា ប្រសិនបើ មិន ខុស ទាស់ ផ្នែក ផ្លូវ ច្បាប់ ណាមួយ របស់ ប្រេស៊ីល ទេ នោះ សម្ដេច នឹង ស្នើ ទៅ ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដើម្បី ទ្រង់ ព្រះរាជានុញ្ញាត ផ្តល់ សញ្ជាតិ ខ្មែរ ជូន កីឡាករ Thiago នេះ ដើម្បី ជា ការលើកទឹកចិត្ត បន្ថែម ចំពោះ ការលើកតម្កើង តម្លៃ វប្បធម៌ ខ្មែរ ពិសេស គឺ ក្បាច់គុន ខ្មែរ ផ្សព្វផ្សាយ នៅលើ ឆាក ជាតិ និង អន្តរជាតិ នា ពេល កន្លងមក ៕
ក្នុង ជំនួប នេះ សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា អាចារ្យ ត្រូវ ខិតខំ ដើរ តួនាទី ជា អ្នកសម្របសម្រួល ជៀសវាង ការចាក់ ភ្លើង បន្ថែម ជាមួយ ជម្លោះ ណាមួយ ដូច្នេះ ប្រសិនបើ អនុវត្ត ចំណុច នេះ បាន នឹង ធ្វើឲ្យ មាន សុខដុមនីយកម្ម ក្នុង ទី អារាម ហើយក៏ ជា គំរូ ឲ្យ ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ។
បន្ថែម ពី នេះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន អំពាវនាវ ដល់ អាចារ្យ អាចារិនី ត្រូវ រួមគ្នា សហការ ជាមួយ គណៈ សង្ឃ និង អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ បំពេញ ភារកិច្ច ឲ្យបាន ល្អ តាម តួនាទី ភារកិច្ច និង តាម លិខិត បទដ្ឋាន គតិយុត្ត នានា ដើម្បី រួមចំណែក ទ្រទ្រង់ ព្រះពុទ្ធ សាសនា ដែល ជា មូលដ្ឋាន ដ៏ មាន សារៈសំខាន់ សម្រាប់ ការអភិវឌ្ឍ សង្គម ។
ការអំពាវនាវ បែប នេះ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅ នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី នៅ ទូទាំង ប្រទេស សរុប ១៥០០ នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការរក្សា នូវ សន្តិភាព និង ស្ថេរភាព នយោបាយ គឺជា កិច្ចការ ដ៏ សំខាន់ ត្រូវ ចូលរួម ទាំងអស់ គ្នា ។
សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ យ៉ាង ដូច្នេះ ថា៖ « សូម លោកយាយ លោតា ញាតិ ញោម បងប្អូន ទាំងឡាយ ចូលរួម ជាមួយ អនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព យក អា ហ្នឹង ធ្វើជា ស្នូល ព្រោះ រឿង វា នៅ មូលដ្ឋាន ទាំងអស់ ហ្នឹង អ៊ឹ ចឹង ថ្ងៃ ហ្នឹង បាន ជួប អាចារ្យ បាន អាចារិនី ដែល នៅ តាម ទី អារាម នានា ផ្តល់ ការអប់រំ ចំពោះ ប្រជាពលរដ្ឋ ដែល គាត់ សុំ សីល ឬ ក្មេង ៗ ទៅ ធ្វើ បុណ្យ ទាន យើង ផ្តល់ ការអប់រំ មាន បញ្ហា គ្រឿងញៀន ល្បែង ស៉ី សង បញ្ហា សុវត្ថិភាព ចរាចរណ៍ ... !» ។
បន្ថែម ពី នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្រាប់ បញ្ហា ធ្ងន់ធ្ងរ ណា ពេល បច្ចុប្បន្ន នេះ គឺ បញ្ហា គ្រឿងញៀន ប្រសិនបើ កូន និង សាច់ញាតិ របស់ យើង ឬ ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ប្រព្រឹត្ត អំពើ គ្រឿងញៀន និង លេង ល្បែង ស៉ី សង ច្រើន វា នឹង កើតឡើង នូវ អំពើ ចោរប្លន់ ចោរ លួច នៅក្នុង មូលដ្ឋាន ជាដើម ។
ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បញ្ជាក់ ថា អាចារ្យ អាចារិនី ព្រះសង្ឃ ត្រូវ បន្ត ផ្តល់ ការអប់រំ នូវ អំពើ ល្អ ទាំងឡាយ ដល់ ប្រជាពលរដ្ឋ ។ ជាមួយគ្នា នេះ សម្តេច បន្ត ថា « កាលណា ប្រជាពលរដ្ឋ មាន សីលធម៌ ល្អ គុណធម៌ ល្អ អំពើ ទុច្ចរិត មិន កើតឡើង ទេ ហើយ បើ វា កើតឡើង ក៏ តិចតួច អ៊ឹ ចឹង សូម ជួយ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម » ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា អាណាចក្រ និង ពុទ្ធ ចក្រ ផ្សារភ្ជាប់គ្នា យ៉ាង សំខាន់ មិន អាច ខ្វះ គ្នា បាន នោះ ឡើយ ។ ដូចនេះ ការផ្សារ ភ្ជាប់ រវាង អាណាចក្រ និង ពុទ្ធ ចក្រ គឺជា ទស្សនៈ វិស័យ នយោបាយ របស់ បក្ស ប្រជាជន កម្ពុជា តាំងពី ពេល ចាប់ផ្តើម តស៊ូ រំដោះ ជាតិ ៕ សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ផ្តល់ ថវិកា ចំនួន ២០.០០០ ដុល្លារ និង ស្នើសុំ ព្រះមហាក្សត្រ ផ្តល់ សញ្ជាតិ ខ្មែរ ដល់ កីឡាករ Thiago Teixeira សញ្ជាតិ ប្រេស៊ីល
ស្ថាប័ន WMO បាន ចុះបញ្ជី ក្នុង សមាគម ប្រដាល់ ម៉ឺយ ថៃ កាលពី ឆ្នាំ ២០១១ ស្រប ពេល សមាគម ប្រដាល់ ថៃ នេះ បាន បង្កើតឡើង តាំងពី ឆ្នាំ ១៩៨៣ ដោយ មាន លោក ឆៃណា វុត សិរី សាំ ផាន់ ជា ប្រធាន លោក អារុណ សិរី សាំ ផាន់ ជា អនុប្រធាន និង លោកស្រី ចេដ សិរី សាំ ផាន់ ជា អគ្គ លេខាធិការ ។ ម៉ឺយ ថៃ បាន ប្រកាស និង ផ្សព្វផ្សាយ ទៅកាន់ ពិភពលោក ជាង ៥០ ប្រទេស ដោយ ក្នុង នោះ បាន ចូល ជា សមាជិក ពេញលេញ ៥០ ប្រទេស នៅលើ ពិភពលោក ។
សម្តេច តេជោ ហ៊ុន សែន លើកឡើង ថា បុគ្គល ប៊ុត ប៊ុន តិញ សម្តេច មិន ហៅ វា ជា ព្រះសង្ឃ ទេ ព្រោះ ជា ក្មេង ពាល គ្រាន់តែ យក ស្បង់ ចីពរ ទៅ គ្របដណ្តប់ ធ្វើជា សង្ឃ តែ ប៉ុណ្ណោះ ។
សម្តេច តេជោ ហ៊ុន សែន ចាត់ទុក ការចោទ សម្តេច ផ្តល់ លុយ ឱ្យ លោក ជេម សុខ ពីសំណាក់ « អាខ្មៅ » គឺជាធម៌មុសា ល្មើស ធម៌ វិន័យ មួយ ក្នុង ព្រះពុទ្ធ សាសនា ។ តែ យ៉ាងណា សម្តេច តេជោ ហ៊ុន សែន បាន ទុក ផ្លូវ ឲ្យ បុគ្គល ប៊ុត ប៊ុន តិញ ចេញមុខ សុំទោស សម្តេច នោះ សម្តេច នឹង លែង ឈប់ រក រឿង ។
ការថ្លែង របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី នៅ ទូទាំង ប្រទេស សរុប ១៥០០ នាក់ នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ ។
ជាមួយគ្នា នោះ ដែរ បើ តាម ក្រុម មន្ត្រី អាមេរិក ក្រុម មន្ត្រី និង អ្នកគាំទ្រ រុស្ស៉ី ទំនង ជា អ្នក នៅ ពីក្រោយ ការបែកធ្លាយ ឯកសារ សម្ងាត់ យោធា តែ នៅ មិន ទាន់ មាន ការបញ្ជាក់ ថា ឯកសារ ទាំងនោះ លេច ធ្លាយ ដោយ របៀប ណា នោះ ទេ ខណៈ មន្ទីរ បញ្ចកោណ កំពុង បើក ការស៊ើបអង្កេត ។
កម្ពុជា នៅតែ ជា ទីជម្រក ដល់ សត្វ ព្រៃ ជិត ផុត ពូជ ខណៈ ក្រសួង បរិស្ថាន នៅតែ ជំរុញ ឱ្យ មាន ការចូលរួម យ៉ាង សកម្ម ពី គ្រប់ ស្ថាប័ន ពាក់ព័ន្ធ ក្នុង ការអភិរក្ស សត្វ ព្រៃ
( ពោធិ៍សាត់ )៖ បើ យោង តាម ការសិក្សា ថ្មី ៗ បាន បញ្ជាក់ ថា ប្រទេស កម្ពុជា នៅតែ ជា ទីជម្រក ដល់ សត្វ ព្រៃ ជា ច្រើន ប្រភេទ រួមទាំង សត្វ ដែល ត្រូវបាន កំណត់ ថា ផុត ពូជ ឬ ជិត ផុត ពូជ ។ ខណៈ ដែល ក្រសួង បរិស្ថាន បាន ជំរុញ ឱ្យ មាន ការចូលរួម យ៉ាង សកម្ម ពី គ្រប់ ស្ថាប័ន ពាក់ព័ន្ធ រួម មាន ថ្នាក់ ក្រោម ជាតិ និង អាជ្ញាធរ ខេត្ត ក្នុង ការពង្រឹង ការអនុវត្ត ច្បាប់ ដែល គាំទ្រ ដល់ ការការពារ សត្វ ព្រៃ និង លើកទឹកចិត្ត ដល់ សហគមន៍ មូលដ្ឋាន ក្នុង ការអភិរក្ស សត្វ ព្រៃ ដើម្បី អភិវឌ្ឍន៍ អេកូ ទេសចរណ៍ ។
រដ្ឋមន្ត្រី ការងារ ស្វាគមន៍ ក្រុមហ៊ុន បច្ចេកវិទ្យា ព័ត៌មាន របស់ ឥណ្ឌា មក ជួយ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ដល់ យុវជន កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ស្វាគមន៍ ដល់ ក្រុមហ៊ុន បច្ចេកវិទ្យា ព័ត៌មាន ក៏ ដូចជា ដៃគូ ដែល ធ្វើ ការពាក់ព័ន្ធ នឹង ការអភិវឌ្ឍ ជំនាញ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ របស់ ឥណ្ឌា ទាំងអស់ ចូលរួម សហការ កសាង ធនធាន មនុស្ស ផ្នែក ជំនាញ វិជ្ជាជីវៈ ដល់ យុវជន កម្ពុជា សម្រាប់ ឆ្លើយតប ទៅនឹង តម្រូវការ ទីផ្សារ ការងារ ដែល នឹង គាំទ្រ ដល់ ការវិនិយោគ ។
លោក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា កម្ពុជា ទទួលស្គាល់ ថា ប្រទេស ឥណ្ឌា ជា ប្រទេស ឈាន មុខ គេ ក្នុង វិស័យ បច្ចេកវិទ្យា ព័ត៌មាន និង ការអភិវឌ្ឍ ជំនាញ ហើយ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក៏ សូមស្វាគមន៍ ដល់ ក្រុមហ៊ុន បច្ចេកវិទ្យា ព័ត៌មាន ក៏ ដូចជា ដៃគូ ដែល ធ្វើ ការពាក់ព័ន្ធ នឹង ការអភិវឌ្ឍ ជំនាញ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ របស់ ឥណ្ឌា ទាំងអស់ ចូលរួម សហការ កសាង ធនធាន មនុស្ស ផ្នែក ជំនាញ វិជ្ជាជីវៈ ដល់ យុវជន កម្ពុជា សម្រាប់ ឆ្លើយតប ទៅនឹង តម្រូវការ ទីផ្សារ ការងារ ដែល នឹង គាំទ្រ ដល់ ការវិនិយោគ ។
លោក បាន ថ្លែងអំណរគុណ ពោះ ស្ថានកុងស៊ុល កិត្តិយស ឥណ្ឌា និង សភា ពាណិជ្ជកម្ម ឥណ្ឌា (INCHAM) ដែល បាន សហការរៀបចំ កម្មវិធី ដ៏ មាន សារៈសំខាន់ នេះ ដោយ កំណត់ យក ប្រធានបទ « ឱកាស វិនិយោគ សម្រាប់ ក្រុមហ៊ុន ឥណ្ឌា នៅក្នុង វិស័យ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ និង ឧស្សាហកម្ម ៤.០ ដើម្បី ធ្វើ ការពិភាក្សា ចែករំលែក បទពិសោធន៍ ល្អ សំដៅ ធ្វើឱ្យ ប្រសើរឡើង នូវ បរិយាកាស ធុរកិច្ច វិនិយោគ ភាព ប្រកួតប្រជែង ការទទួលខុសត្រូវ សង្គម និង ដើម្បី បង្ក ភាពទាក់ទាញ វិនិយោគទុន ពី បរទេស បន្ថែម ទៀត មក កម្ពុជា ជាពិសេស មកពី ឥណ្ឌា ។
លោក បាន លើកឡើង ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល មាន គោលការណ៍ គ្រឹះ ក្នុង ការរក្សា ឱ្យ បាន នូវ សុខ សន្តិភាព កម្ពុជា អាច ធានា បាន នូវ ស្ថិរភាព សង្គម និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ធានា នូវ ទំនុកចិត្ត ដល់ អ្នកវិនិយោគិន ទាំង ក្នុង និង ក្រៅ ប្រទេស កាន់តែ ជឿ ទុកចិត្ត យ៉ាង មុតមាំ ក្នុង ការបណ្តាក់ទុន វិនិយោគ និង ធ្វើឱ្យ សេដ្ឋកិច្ច កម្ពុជា មាន កំណើន ថេរ ព្រមទាំង បាន បង្កើត និង បង្កើន ឱកាស ការងារ ជាច្រើន ជូន ប្រជាពលរដ្ឋ ។
លោក អ៉ិត សំហេង បាន វាយ ការវាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ រវាង ប្រទេស ឥណ្ឌា និង ប្រទេស កម្ពុជា ដែល បាន ចូលរួមចំណែក អភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម កម្ពុជា លើ គ្រប់ វិស័យ ជាពិសេស កិច្ចសហប្រតិបត្តិការ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ ដែល កន្លងមក ភាគី ឥណ្ឌា បាន ផ្តល់ អាហារូបករណ៍ រាប់ រយ កន្លែង សម្រាប់ សិក្ខាកាម របស់ កម្ពុជា ។
លោក រដ្ឋមន្ត្រី សង្ឃឹម ថា តាមរយៈ វេទិកា កម្មវិធី នា ថ្ងៃ នេះ នឹង បង្កើន នូវ ភាព ជឿ ទុកចិត្ត ដល់ បណ្តា ក្រុមហ៊ុន ឥណ្ឌា បង្កើន ការវិនិយោគ និង ទាក់ទាញ អ្នក វិនិយោគទុន ថ្មី ៗ ថែម ទៀត ជាក់ ជា មិន ខាន ៕ នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត ទទួល ជួប បដិសណ្ឋារកិច្ច ស្វាគមន៍ ចំពោះ គណៈប្រតិភូ បញ្ជាការដ្ឋាន កងទ័ព ការពារ ព្រំដែន នៃ ក្រសួង ការពារ ប្រទេស វៀតណាម
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងទ័ព ជើងគោក នៅ រសៀល ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២៣ បាន ទទួល ជួប សំណេះសំណាល ជាមួយ គណៈប្រតិភូ បញ្ជាការដ្ឋាន កងទ័ព ការពារ ព្រំដែន នៃ ក្រសួង ការពារ ប្រទេស សាធារណរដ្ឋ សង្គម និយម វៀតណាម ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ង្វៀន ហ៊ួយ ភ្វឿង មេបញ្ជាការ រង បញ្ជាការដ្ឋាន កងទ័ព ការពារ ព្រំដែន វៀតណាម ទទួលបន្ទុក ការងារ ភាគ ខាងត្បូង ។
ជា ការឆ្លើយតប នាយ ឧត្តមសេនីយ៍ ហ៊ុន ម៉ាណែត បាន សម្តែង នូវ ការអរគុណ ចំពោះ ទឹកចិត្ត និង កាយវិការ ប្រកបដោយ មិត្តភាព ជិតស្និទ្ធ រវាង កងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ និង បញ្ជាការដ្ឋាន កងទ័ព ការពារ ព្រំដែន វៀតណាម ដែល ស្តែង ឡើង តាមរយៈ ការអញ្ជើញ មក សាកសួរ សុខទុក្ខ និង ជូនពរ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដូច ពេលនេះ ។
ទន្ទឹមនឹង នេះ នាយ ឧត្តមសេនីយ៍ ក៏ បាន វាយតម្លៃ ខ្ពស់ និង គាំទ្រ ចំពោះ លទ្ធផល នៃ កិច្ចសហប្រតិបត្តិការ រវាង អង្គភាព ទាំង ពីរ លើ ការងារ ជាច្រើន រួម មាន ជាអាទិ៍៖ ការបង្ការ ទប់ស្កាត់ បទល្មើស ឆ្លង ដែន គ្រប់ ប្រភេទ . ការងារ ខណ្ឌ សីមា និង ការបោះ បង្គោល ព្រំដែន ព្រមទាំង ការសហការបង្ក លក្ខណៈ ងាយស្រួល ដល់ ប្រជាជន និង ប្រជាជន អាច ធ្វើ សកម្មភាព ផ្លាស់ប្តូរ សេដ្ឋកិច្ច ជាមួយគ្នា ទៅ វិញ ទៅ មក នៅ តាម បណ្តោយ ព្រំដែន នៃ ប្រទេស ទាំង ពីរ ។
( ភ្នំពេញ ) ៖ « ពិព័រណ៍ កេសរ កូល កម្ពុជា » ដែល រៀបចំឡើង ដើម្បី អបអរសាទរ វេទិកា កេសរ កូល ជាតិ លើក ទី៣ និង ការប្រកាស ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ សៀវភៅ មគ្គុទ្ទេសក៍ ស្តីពី បន្លែ នៅ ប្រទេស កម្ពុជា បាន ប្រារព្ធ បើក ជា ផ្លូវការ នៅ ថ្ងៃសុក្រ ទី៧ ខែមេសា ឆ្នាំ ២០២៣ នៅ ផ្សារ ទំនើប អ៉ី អន១ រាជធានី ភ្នំពេញ ។
វត្តមាន ក្នុង ឱកាស នេះ មាន លោកស្រី ម៉ុម ថា នី រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន លោកស្រី ឌិត នីតា ភរិយា លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន និង ប្រធាន ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព រួម ជាមួយ ថ្នាក់ដឹកនាំ មក ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ឯក អគ្គ រាជ ទូត ឯក អគ្គ រដ្ឋទូត វិស័យ ឯកជន សាស្រ្តាចារ្យ អ្នកសិក្សា ស្រាវជ្រាវ សិស្ស និស្សិត និង ប្រជាពលរដ្ឋ ចូលរួម យ៉ាង ច្រើន កុះករ ។
ពិព័រណ៍ កេសរ កូល កម្ពុជា បាន បង្ហាញ ជូន អំពី ប្រភេទ រុក្ខជាតិ និង សមិទ្ធផល ពាក់ព័ន្ធ នានា រួម មាន៖ ការតាំង បង្ហាញ និង ផ្សព្វផ្សាយ ពី តម្លៃ របស់ កេសរ កូល ព្រៃ កេសរ កូល បង្កាត់ រុក្ខជាតិ តាំង លម្អ រុក្ខជាតិ ក្នុង សួន ប្រទាល រុក្ខជាតិ ឈើ ប្រណិត និង ហូប ផ្លែ ផលិតផល កសិកម្ម ធម្មជាតិ ផល និង អនុផល ព្រៃឈើ រូបថត និង គំនូរ ពាក់ព័ន្ធ នឹង ធម្មជាតិ ជីវៈ ចម្រុះ និង កេសរ កូល ។ល ។
ការលើកឡើង បែប នេះ របស់ លោក នេត្រ ភក្ត្រា បាន ធ្វើឡើង ក្នុង សន្និសីទ សារ ពត៌មាន ស្តីពី យុទ្ធនាការ អន្ទាក់ សូន្យ ដំណាក់កាល ទី២ នា ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២៣ នៅ មន្ទីរ បរិស្ថាន ខេត្ត ពោធិ៍សាត់ ។
អ្នកនាំពាក្យ រូប នេះ បាន ឱ្យដឹង យ៉ាង ដូច្នេះ ថា៖ « ក្រសួង បរិស្ថាន ជាមួយ អង្គការ WA និង ប្រទេស ឥណ្ឌា បាន កំពុងតែ ធ្វើ ការរួមគ្នា ដើម្បី រៀបចំ នូវ បទដ្ឋាន បច្ចេកទេស នាំយក ប្រភេទ សត្វ ខ្លាំ ធំ ពី ប្រទេស ឥណ្ឌា ដើម្បី បង្កើន ចំនួន សត្វ កម្រ នៅ ប្រទេស កម្ពុជា យើង ។ ទិសដៅ ទី មួយ គឺ តម្រង់ ទៅ តំបន់ ជួរ ភ្នំ ក្រវាញ » ។
ជាមួយគ្នា នេះ ដែរ លោក នេត្រ ភក្ត្រា បាន ឱ្យដឹង ថា នៅ កម្ពុជា ធ្លាប់ មាន ខ្លា ធំ ដែល វត្តមាន របស់ វា ត្រូវបាន គេ ឃើញ មាន ចុងក្រោយ បំផុត នៅ ឆ្នាំ ២០០៧ ដែល ថត បាន នៅក្នុង ដែន ជម្រក សត្វ ព្រៃ នៃ ខេត្ត មណ្ឌលគិរី បើ គិត ត្រឹម ឆ្នាំ ២០២៣ មាន រយៈពេល ១៦ ឆ្នាំ មកហើយ ដែល គេ មិន ឃើញ វត្តមាន សត្វ ខ្លា ធំ ទៀត ទេ ដែល អាច សន្និដ្ឋាន បាន ថា កម្ពុជា បាន បាត់ ពូជ ប្រភេទ សត្វ ខ្លា ធំ នេះ ហើយ ។ សត្វ ខ្លា ធំ នៅ កម្ពុជា ដែល បាន បាត់បង់ ទៅ នោះ អាច បណ្តាល មកពី ការដាក់ អន្ទាក់ ។
ជុំវិញ គម្រោង ស្តារ វត្តមាន ខ្លាំ ធំ ឱ្យ មាន វត្តមាន នៅក្នុង ព្រៃ ធម្មជាតិ កម្ពុជា វិញ . ត្រូវ លោក នេត្រ ភក្ត្រា បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន គាំទ្រ បច្ចេកទេស ដោយ សហការ ជាមួយ រដ្ឋាភិបាល ប្រទេស ឥណ្ឌា ដើម្បី យក ប្រភេទ សត្វ ខ្លា ធំ មកកាន់ ប្រទេស កម្ពុជា ។
លោក នេត្រ ភក្ត្រា បាន គូសបញ្ជាក់ ថា៖ « យើង រំពឹង ថា នីតិវិធី នឹង សម្រេច នា ពេល ខាងមុខ ... ! ហើយ ម មន្ត្រី ជំនាញ នៃ ក្រសួង បរិស្ថាន តំណាង អង្គការ WA ក៏ បាន ធ្វើដំណើរ ទៅ ប្រទេស ឥណ្ឌា ធ្វើ ការសិក្សា ហើយ ដំណើរការ នៃ កិច្ចការងារ នឹង មាន ការវិវត្តន៍ ជំហាន ហើយ សង្ឃឹម ថា ប្រទេស កម្ពុជា របស់ យើង នឹង លទ្ធភាព ការស្តារ ប្រភេទ សត្វ ខ្លា ធំ នេះ នៅក្នុង ព្រៃ ធម្មជាតិ របស់ យើង ឡើងវិញ » ។
នា ឱកាស នោះ ដែរ លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា ក្រសួង បរិស្ថានសង្ឃឹម ជឿជាក់ ថា គម្រោង នេះ នឹង ទទួលបាន ជោគជ័យ ក្រោយ មាន កិច្ចព្រមព្រៀង ជាមួយ រដ្ឋាភិបាល ឥណ្ឌា ក្នុង ការអនុវត្ត គម្រោង នេះ ។
នាយិកា ប្រតិបត្តិ អង្គការ សម្ព័ន្ធមិត្ត សត្វ ព្រៃ (WA) កញ្ញា បណ្ឌិត ស៊ូវណ្ណា ហ្គោន ឡែត ធ្លាប់ បាន ឱ្យដឹង ថា នា ពេល កន្លងទៅ ថា សត្វ ខ្លា ធំ ដែល នឹង ត្រូវ នាំ មកពី ប្រទេស ឥណ្ឌា នឹង ត្រូវ លែង ក្នុង តំបន់ ជួរ ភ្នំ ក្រវាញ ជា តំបន់ ដែល សូន្យ អន្ទាក់ និង ត្រូវបាន បំពាក់ កាមេរ៉ា តាមដាន យ៉ាង យកចិត្តទុកដាក់ ពីសំណាក់ មន្ត្រី អភិរក្ស ។
សូម ជម្រាប ថា កាលពី ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០២២ កន្លងទៅ កម្ពុជា និង ឥណ្ឌា បាន ចុះ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ស្តីពី កិច្ចសហប្រតិបត្តិការ ក្នុង ការអភិរក្ស ជីវៈ ចម្រុះ ការគ្រប់គ្រង សត្វ ព្រៃ ដោយ និរន្តរភាព និង យុទ្ធសាស្រ្ត ស្តារ សត្វ ខ្លា ធំ និង ទី ជម្រក របស់ វា នៅ ប្រទេស កម្ពុជា ។
គម្រោង ស្តារ សត្វ ខ្លា ធំ ឡើងវិញ នេះ បន្ទាប់ពី បាត់ វត្តមាន ពី ទឹកដី កម្ពុជា កាលពី អំឡុង ឆ្នាំ ២០០៧ ខណៈ នៅ ទូទាំង ពិភពលោក នៅ ឆ្នាំ ២០១០ ត្រូវបាន គេ ប៉ាន់ប្រមាណ ថា មាន ចំនួន សត្វ ខ្លា ធំ ប្រហែល៣ ២០០ ក្បាល ដែល ចំនួន នេះ មាន ការថយចុះ ៩៥ ភាគរយ បើ ធៀប ទៅនឹង ចំនួន របស់ វា ធ្លាប់ មាន ក្នុង ដើម ទសវត្សរ៍ ទី២០ ប្រហែល១០ ម៉ឺន ក្បាល ៕ រដ្ឋមន្ត្រី ប្រៃសណីយ៍ និង ឯក អគ្គ រដ្ឋទូត ជប៉ុន ចូលរួម អបអរសាទរ ឆ្នាំ ថ្មី ជាមួយ សមាគម អតីត និស្សិត ខ្មែរ ពី ប្រទេស ជប៉ុន
កម្មវិធី កម្សាន្ត របស់ សមាគម អតីត និស្សិត ខ្មែរ មកពី ប្រទេស ជប៉ុន នេះ ធ្វើឡើង នា រាត្រី ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២៣ នៅ សណ្ឋាគារ កាំបូឌីយ៉ាណា ។ នា ឱកាស នោះ លោក វ៉ា កូរ៉ា ប្រធាន សមាគម អតីត និស្សិត ខ្មែរ មកពី ប្រទេស ជប៉ុន JAC បាន លើកឡើង ថា ពិធី បុណ្យ ចូល ឆ្នាំ ខ្មែរ ឆ្នាំ នេះ គឺ ពិតជា ពិសេស ត្រង់ ថា ស្រប នឹង ឱកាស ខួប ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត រវាង កម្ពុជា និង ជប៉ុន ព្រមទាំង ខួប ២០+ ១ នៃ សមាគម អតីត និស្សិត ខ្មែរ មកពី ប្រទេស ជប៉ុន ។
លោក ប្រធាន បាន បន្ត ថា សមាគម JAC មាន ចក្ខុវិស័យ បង្កើត និង ពង្រឹង សម្ពន្ធភាព ជាមួយ សមាគម អតីត និស្សិត មកពី ក្រៅ ប្រទេស ដើម្បី បង្កើត បណ្តាញ អ្នកជំនាញ ដ៏ មាន សក្ដានុពល និង ជំរុញ ការអភិវឌ្ឍ នៅ ប្រទេស កម្ពុជា ។
ជាមួយគ្នា នោះ លោក ឯក អគ្គ រដ្ឋទូត ជប៉ុន អេណុ អាត់ ស៊ូស្ស៉ឹ បាន លើកឡើង ថា បន្ទាប់ពី បញ្ចប់ សង្គ្រាម ស៉ី វិល នៅ កម្ពុជា ប្រទេស ជប៉ុន បាន បន្ត ទទួល និស្សិត កម្ពុជា ឱ្យ ទៅ សិក្សា នៅ ប្រទេស ខ្លួន ក្រោម កម្មវិធី អាហារូបករណ៍ រដ្ឋាភិបាល ជប៉ុន តាំងពី ឆ្នាំ ១៩៩២ ពោល មកដល់ ពេលនេះ គឺជាង ៣០ ឆ្នាំ មកហើយ ក្នុង នោះ មាន និស្សិត កម្ពុជា ជាង ១. ៤០០ នាក់ បាន ទៅ សិក្សា នៅ ប្រទេស ជប៉ុន រួមទាំង និស្សិត ដែល ស្ថិត ក្រោម ក្របខណ្ឌ មូលនិធិ ប្រជាជន ជប៉ុន សម្រាប់ ការអភិវឌ្ឍ ធនធាន មនុស្ស នៅ កម្ពុជា (JDS) ។
លោក អេណុ អាត់ ស៊ូស្ស៉ឹ បាន បន្ថែម ថា នា ឱកាស ខួប ៧០ ឆ្នាំ នៃ ទំនាក់ទំនង ការទូត រវាង ប្រទេស ជប៉ុន និង កម្ពុជា ភាគី ទាំង ពីរ ប្រឹងប្រែង រក្សា ទំនាក់ទំនង ជា ប្រវត្តិសាស្ត្រ និង មិត្តភាព រវាង គ្នា និង គ្នា ពិសេស គឺ តាមរយៈ ទំនាក់ទំនង របស់ សមាគម អតីត និស្សិត កម្ពុជា មកពី ប្រទេស ជប៉ុន JAC ។
ទន្ទឹម នឹង នោះ ដែរ លោក រដ្ឋមន្ត្រី ជា វ៉ាន់ ដេត ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ ការជំរុញ ទំនាក់ទំនង មិត្តភាព រវាង កម្ពុជា និង ជប៉ុន និង បាន អបអរសាទរ ខួប លើក ទី៧០ នៃ ទំនាក់ទំនង ការទូត រវាង កម្ពុជា - ជប៉ុន ក៏ ដូចជា ខួប លើក ទី២០ របស់ សមាគម JAC ផងដែរ ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ក៏ មាន មន្ត្រី ជាន់ ខ្ពស់ មួយចំនួន ដែល បាន បញ្ចប់ ការសិក្សា ពី ប្រទេស ជប៉ុន ក្នុង វិស័យ ព័ត៌មានវិទ្យា ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ។ ពួកគេ រួមគ្នា ជាមួយ មន្ត្រី ដែល មាន ទេពកោសល្យ ផ្សេង ទៀត បង្កើត ប្រព័ន្ធ បច្ចេកវិទ្យា ជាង ១៨ សម្រាប់ ការប្រើប្រាស់ ផ្ទៃក្នុង របស់ ក្រសួង ដែល ពាក់ព័ន្ធ នឹង ប្រព័ន្ធ គ្រប់គ្រង ហិរញ្ញវត្ថុ និង អចលន ទ្រព្យ សម្រាប់ ជា គំរូ សាកល្បង ដ៏ គួរឱ្យ ចាប់អារម្មណ៍ ។
សូម ជម្រាប ដែរ ថា ក្រៅពី ការថ្លែង សុន្ទរកថា ខាងលើ នេះ អង្គ ពិធី ក៏ បាន រៀបចំ ជា ការសរសេរ អក្សរ ជប៉ុន ( កាន់ ជិ) ការប្រគល់ វត្ថុអនុស្សាវរីយ៍ ការជជែក ពិភាក្សា និង ទទួល អាហារ សាមគ្គី ការលេង ល្បែង ប្រជាប្រិយ ខ្មែរ និង ការរាំ លេង កម្សាន្ត ជា ចង្វាក់ ប្រពៃណី ខ្មែរ ផងដែរ ៕ មន្ទីរ សុខាភិបាល ខេត្ត រតនគិរី និង ដៃគូ ចុះ ធ្វើ យុទ្ធនាការ លើកកម្ពស់ ការយល់ដឹង ពាក់ព័ន្ធ ការសម្រាល កូន និង បង្កើន ការចាក់ វ៉ាក់សាំង ដល់ កុមារ អាយុ ក្រោម ៥ ឆ្នាំ
( រតនគិរី ) ៖ មន្ទីរ សុខាភិបាល ខេត្ត រតនគិរី សហការ ជាមួយ គម្រោង គិរី ចុះ ធ្វើ យុទ្ធនាការ ដើរ រួមគ្នា ដើម្បី លើកកម្ពស់ ចំណេះដឹង របស់ ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ និង បង្កើន ការយល់ដឹង ដល់ ស្រ្តី មាន ផ្ទែពោះ អំពី សារៈសំខាន់ នៃ ការថែទាំ មុន និង ក្រោយ សម្រាល និង បង្កើន ការចាក់ វ៉ាក់សាំង ដល់ កុមារ អាយុ ក្រោម ៥ឆ្នាំ ។
យុទ្ធនាការ ដ៏ មាន សារៈសំខាន់ នេះ រៀបចំ ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ៧ ខែមេសា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព លោក ឌុច ចាន់តូ អភិបាល រង ខេត្ត រតនគិរី និង លោក អ៊ុង រតនា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត រតនគិរី ព្រមទាំង មាន ការចូលរួម ពី មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ។
លោក វេជ្ជបណ្ឌិត អ៊ុង រតនា បាន លើកឡើង ថា យុទ្ធនាការ នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ ចំណេះដឹង ដល់ ប្រជាជន ក្នុង សហគមន៍ ជាពិសេស បង្កើន ការយល់ដឹង ដល់ ស្ត្រី មាន ផ្ទៃពោះ អំពី សារៈសំខាន់ ការថែទាំ សុខភាព មុនពេល សម្រាល សញ្ញា គ្រោះ ថ្នាក់ អំឡុង ពេល មាន ផ្ទៃពោះ ការថែទាំ សុខភាព ក្រោយ សម្រាល និង ជំរុញ ការចាក់ វ៉ាក់សាំង ដល់ កុមារ ក្រោម ៥ឆ្នាំ ។
លោក ថា គម្រោង នេះ ក៏ មាន គោលបំណង ធ្វើឱ្យ ប្រសើរឡើង នូវ គុណភាព នៃ ការផ្តល់ សេវា សុខភាព មាតា និង ទារក ការធ្វើឱ្យ ប្រសើរឡើង នូវ លទ្ធភាព មក ទទួល សេវា សុខភាព និង ការលើកកម្ពស់ ចំណេះដឹង របស់ សហគមន៍ ។
លោក អភិបាល រង ខេត្ត បាន អំពាវនាវ ដល់ អ្នកម្ដាយ គ្រប់ រូប ដែល មាន ផ្ទៃពោះ ត្រូវ ទៅ ទទួល សេវា ថែទាំ នៅ មណ្ឌល សុខភាព យ៉ាងតិច ៤ដង មុន សម្រាល ហើយ បន្ទាប់ពី សម្រាល កូន ត្រូវ ទៅ ទទួល ការថែទាំ នៅ មណ្ឌល សុខភាព ឱ្យ បាន ១០ដង និង យក កូន ទៅ ចាក់ វ៉ាក់សាំង ១១មុខ ផងដែរ ។
លោក បាន ថ្លែងអំណរគុណ ដល់ ប្រទេស កូរ៉េ ដែល បាន គាំទ្រ ថវិការ លើ គម្រោង នេះ ដែល បាន ចូលរួមចំណែក បន្ថែម ក្នុង ការពង្រឹង ប្រព័ន្ធ សុខាភិបាល ក្នុង ខេត្ត រន តគិរី ឱ្យ កាន់តែ មាន គុណភាព ប្រសើរឡើង បន្ថែម ទៀត ៕
ឯកឧត្តម បណ្ឌិត សភាចារ្យ ជូ វិជិត្ត និង លោកជំទាវ ម៉ៅ ណារ៉ា បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៣
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត សភាចារ្យ ជូ វិជិត្ត រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋលេខាធិការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង លោកជំទាវ ម៉ៅ ណារ៉ា បាន បរិច្ចាគ ថវិកា ចំនួន ៥ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម បណ្ឌិត សភាចារ្យ ជូ វិជិត្ត និង លោកជំទាវ ម៉ៅ ណារ៉ា តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម សន្តិ បណ្ឌិត សុខ ផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង លោកជំទាវ គឹម ហេង បាន បរិច្ចាគ ថវិកា ចំនួន ៥ពាន់ ដុល្លារ អាមេរិក ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៣ ។
ឯកឧត្តម សន្តិ បណ្ឌិត សុខ ផល និង លោកជំទាវ គឹម ហេង តែងតែ ចូលរួម បរិច្ចាគ ថវិកា ជារៀងរាល់ ឆ្នាំ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦០ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ហើយក៏ តែងតែ បាន ចូលរួម ឧបត្ថម្ភ ថវិកា ជួយ ដល់ យុទ្ធនាការ ផ្សេង ៗ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ព្រមទាំង បាន ចូលរួម ជួយ ឧបត្ថម្ភ ដល់ កម្មវិធី សប្បុរស ជាច្រើន ទៀត ។
សូម ជម្រាប ថា នៅ ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ប្រកាស ឧបត្ថម ដល់ កីឡាករ Thiago ចំនួន ២ម៉ឺន ដុល្លារ . លោក ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ឧបត្ថម្ភ ២០០០ ដុល្លារ . លោកស្រី ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ឧបត្ថម្ភ ១០០០ ដុល្លារ និង លោក ខៀវ កាញ៉ារីទ្ធ រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ឧបត្ថម្ភ ចំនួន ១០០០ ដុល្លារ ៕
ក្រសួង សុខាភិបាល ចេញ សេចក្ដីណែនាំ ក្រើន រំលឹក ឲ្យ ពលរដ្ឋ ប្រុងប្រយ័ត្ន ជំងឺ កូវីដ១៩ . ផ្ដាសាយ បក្សី និង ពុល ចំណីអាហារ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន ចេញ សេចក្ដីណែនាំ ក្រើន រំលឹក ស្ដីពី ការការពារ ការចម្លង ជំងឺ កូវីដ១៩ . ជំងឺ ផ្ដាសាយ បក្សី និង ការបង្ការ ការ ពុល ចំណីអាហារ ឬ ពុល ស្រាស ដែល រៀបចំ មិន ត្រឹមត្រូវ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ដែល ចូលមកដល់ ចាប់ពី ថ្ងៃទី ១៤ ដល់ ថ្ងៃទី ១៦ ខែេម សា ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង រៀបចំ ពិធី សូត្រ មន្ត បួងសួង សុំ សេចក្តីសុខ នា ឱកាស ឆ្នាំ ថ្មី និង សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ សួន បាញ់ ទឹក តាម ចង្វាក់ ភ្លេង នៅមុខ សាលា ខេត្ត
( កំពង់ឆ្នាំង ) ៖ សួន បាញ់ ទឹក តាម ចង្វាក់ ភ្លេង ទើបតែ កសាង រួច ថ្មី ៗ ដែល មាន ឈ្មោះ ថា « សួនច្បារ ឯកឧត្តម បណ្ឌិត សុភាចារ្យ អ៊ុក រ៉ាប៊ុន » ស្ថិត នៅមុខ សាលា ខេត្ត កំពង់ឆ្នាំង ត្រូវបាន ដាក់ សម្ពោធ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នៅ ល្ងាច ថ្ងៃទី ០៧ ខែ មេសា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព លោក បណ្ឌិត សុភាចារ្យ អ៊ុក រ៉ាប៊ុន និង ដោយ មាន ការចូលរួម ពី លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត កំពង់ឆ្នាំង មន្ត្រីរាជការ លោកគ្រូ អ្នកគ្រូ និង ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ផងដែរ ដែល មាន វត្ត មាន សរុប ចំនួន ៩០៥ នាក់ ។
នៅក្នុង ពិធី នេះ លោក ស៊ុន សុវណ្ណា រិទ្ធិ បាន ថ្លែង ថា សួន បាញ់ ទឹក នេះ បំពាក់ ឧបករណ៍ បច្ចេកទេស បាញ់ ទឹក ទំហំ ៣៨ម៉ែត្រ ការ៉េ ក្រាល ថ្ម ម៉ាប ទំហំ ៥១៣០ ម៉ែត្រ កា រ៉េ បំពាក់ ភ្លើង ហ្វា ដែល មាន កម្ពស់ ២២ម៉ែត្រ ចំនួន ៣ដើម និង បាន រៀបចំ ធ្វើជា ចំណ តថយន្ត ជុំវិញ សួន និង ដាំ ស្មៅ ជុំវិញ សួន ផងដែរ ។
សួន បាញ់ ទឹក នេះ បាន កសាង ដោយ ក្រុមការងារ បច្ចេក ទេស អគ្គ ភ័ស្តុភា ក្រសួង មហាផ្ទៃ ក សាង រយៈពេល ១ ឆ្នាំ ចាប់ពី ខែមេសា ឆ្នាំ ២០២២ ដល់ ខែមេសា ឆ្នាំ ២០២៣ ។
នៅក្នុង ពិធី នេះ លោក ស៊ុន សុវណ្ណា រិទ្ធិ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ មន្ត្រីរាជការ ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ លោកគ្រូ អ្នកគ្រូ និង ប្រជាពលរដ្ឋ នៅ ក្នុង ខេត្ត កំពង់ឆ្នាំង ទាំងអស់ ដែល បាន សហការ ជាមួយ រដ្ឋ បាល ខេត្ត រដ្ឋបាល ស្រុក និង អាជ្ញាធរ ឃុំ សង្កាត់ ក្នុង ការអ ភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ លើ គ្រប់ វិស័យ ឲ្យ មាន ការរីកចម្រើ ន ក្នុង រយៈពេល មួយ ឆ្នាំ កន្លងមក នេះ ។
ជាមួយគ្នា នេះ នៅក្នុង ឱកាស ឆ្នាំ ថ្មី នេះ សូម គោរព ជូនពរ លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ រួមទាំង ប្រជាពលរដ្ឋ ទាំងអស់ នៅក្នុង ខេត្ត កំពង់ឆ្នាំង សូម ជួបប្រ ទះ តែ នឹង ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ និង មានជ័យជំនះ គ្រប់ ភារកិច្ច កុំបី ឃ្លាង ឃ្លាត ឡើយ ។
លោក បណ្ឌិត សុភាចារ្យ អ៊ុក រ៉ាប៊ុន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត កំពង់ឆ្នាំង នៅក្នុង ឱកាស នេះ អបអរសាទរ យ៉ាង ក្រៃលែង ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ នូវ សួន បាញ់ ទឹក ថ្មី តាម ចង្វាក់ ភ្លេង ដ៏ ទំនើប នេះ ដែល បណ្ដា ខេត្ត នានា ពុំ ទាន់ មាន ហើយ នេះ ជា លើក ទី មួយ ហើយ ដែល រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង បាន កសាង សមិទ្ធិផល ថ្មី ដ៏ ល្អ មួយ នេះ ដើម្បី ជា ចំណង ដៃ ជូន ប្រជាពលរដ្ឋ ខេត្ត កំពង់ឆ្នាំង នៅក្នុង ឱកា សបុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ។
លោក បាន បន្ត ថា សួន បាញ់ ទឹក តាម ចង្វាក់ ភ្លេង នេះ ប្រជាពលរដ្ឋ ដែល ចង់ ឃើញ មិន មែន ត្រឹមតែ អ្នក ខេត្ត កំពង់ឆ្នាំង នោះ ទេ គឺ នៅ តាម បណ្ដា ខេត្ត នានា ក៏ ចង់ ឃើញ ផងដែរ ដូច្នេះ ចាប់ពី ថ្ងៃ នេះ ទៅ ប្រជាពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរណ៍ ដែល ឆ្លងកាត់ និង មក លេង ក្នុង ខេត្ត កំពង់ឆ្នាំង ពិតជា បាន ឃើញ សួន បាញ់ ទឹក តាម ចង្វាក់ ភ្លេង ដ៏ ទំនើប នេះ នៅមុខ សាលា ខេត្ត ខេត្ត កំពង់ឆ្នាំង ។
សម្ដេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន កសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន គ្រប់ វិស័យ នៅក្រោម ម្លប់ សុខ សន្តិ ភាព សម្រាប់ ខេត្ត កំពង់ឆ្នាំង វិញ ក៏ មាន ការរីកចម្រើន គួរឲ្យ កត់សម្គាល់ ផងដែរ ។ ការរីកចម្រើន ទាំង នេះ គឺជា ការខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ ខេត្ត និង មន្ត្រីរាជការ ជុំវិញ ខេត្ត ដែល បាន សហការធ្វើ ការងារ តាម ជំនាញ ទើប សម្រេចបាន លទ្ធផល យ៉ាង ប្រសើរ និង ទទួលបាន នូវ សមិទ្ធផល ថ្មី ៗ ជា ច្រើន ។
នៅក្នុង ឱកាស ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ នេះ លោក បណ្ឌិត សភាចារ្យ ក៏ សូម ជូនពរ ដល់ ថ្នាក់ដឹកនាំ ខេត្ត មន្ត្រីរាជការ ជុំវិញ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ ទាំង បី និង ប្រជាពលរដ្ឋ នៅ ក្នុង ខេត្ត កំពង់ឆ្នាំង ទាំងអស់ សូម ទទួលបាន សេចក្តីសុខ គ្រប់ ប្រការ និង សិរី សួស្ដី និង ប្រកប មុខរបរ នានា សូម ទទួលបាន ជោគជ័យ គ្រប់ ៗ គ្នា នៅក្រោម ម្លប់ ដ៏ ត្រជាក់ នៃ សុខ សន្តិភាព ៕
លោក ប៊ី សុភាព អបអរសាទរ លោក ទុំ ហ៊ែលហង្ស រី ដែល ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ ផ្តល់ គោរមងារ ជា « ឧកញ៉ា »
( ភ្នំពេញ ) ៖ លោក ប៊ី សុភាព និង ក្រុមគ្រួសារ សូម សម្តែង នូវ ការអបអរសាទរ យ៉ាង ស្មោះ អស់ ពី ដួងចិត្ត ជូន ចំពោះ លោក ទុំ ហ៊ែលហង្ស រី ដែល ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ទ្រង់ មាន ព្រះរាជ ហឫទ័យ ប្រោស ព្រះទាន នូវ គោរមងារ ជា « ឧកញ៉ា » ។
ព្រះរាជ ទាន ត្រាស់បង្គាប់ ផ្តល់ គោរមងារ អ្នក ឧកញ៉ា នេះ ជា សក្ខីភាព ឆ្លុះបង្ហាញ អំពី កិច្ច ខិតខំ ប្រឹងប្រែង ទាំង កម្លាំង កាយ និង ចិត្ត ដោយ មិន ខ្លាច នឿយហត់ របស់ ឧកញ៉ា ក្នុង បុព្វហេតុ ដើម្បី ជួយ សង្គមជាតិ និង ចូលរួមចំណែក ដល់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ប្រទេសជាតិ ជា ទី ស្នេហា នៃ យើង ឱ្យ កាន់តែ រីកចម្រើន ។ ទន្ទឹមនឹង នេះ ការប្រទាន នេះ ពិតជា ស័ក្តិសម និង ផ្ដល់ កិត្តិយស ដ៏ ឧត្តុង្គឧត្តម សម្រាប់ លោក ឧកញ៉ា និង ក្រុមគ្រួសារ ។
ឆ្លៀត នៅក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម បួងសួង ដល់ វត្ថុ ស័ក្ដិសិទ្ធិ ក្នុង លោក សូម ជួយ តាម ថ រក្សា និង ប្រោះ ព្រំ ប្រសិទ្ធ ពរ ជ័យ ជូន ចំពោះ លោក ឧកញ៉ា និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ ជា ទីស្រលាញ់ សូម ជួប ប្រទះ នូវ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ ជានិច្ច និរន្តរ៍ ៕
សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ យោបល់ ដល់ អាចារ្យ ឱ្យ ពិភាក្សា ជាមួយ ម្ចាស់ ដើម ការ រឿង ដាក់ កូនប្រុស អង្គុយ ផ្ទឹម នៅ ខាងឆ្វេង ឬ ខាងស្តាំ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ផ្តល់ យោបល់ ដល់ អាចារ្យ ដែល ចាត់ចែង ពិធី រៀបអាពាហ៍ពិពាហ៍ ឱ្យ ពិភាក្សា ជាមួយ ម្ចាស់ ដើមការជាមុន រឿង ដាក់ កូនកំលោះ អង្គុយ ផ្ទឹម នៅ ខាងឆ្វេង ឬ ខាងស្តាំ នូក ក្រមុំ ជៀសវាង ធ្វើឱ្យ ខូច ពិធី ការ ដោយសារ ម្ចាស់ ដើម ការទាស់ គ្នា ជាមួយ អាចារ្យ ។
ការផ្ដល់ យោបល់ នេះ ធ្វើឡើង ក្នុង ឱកាស សម្ដេច តេជោ ហ៊ុន សែន ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី នៅ ទូទាំង ប្រទេស សរុប ១៥០០ នាក់ នា ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២៣ ស្រប ពេល នឹង ការប្រារព្ធ ទិវា ព្រះពុទ្ធ សាសនា អន្តរជាតិ ៨មេសា ។
នា ឱកាស នោះ សម្ដេច តេជោ បាន លើកឡើង ដល់ ចំណុច នៃ ការរៀបចំ ពិធី អាពាហ៍ពិពាហ៍ ដែល តែង មាន អាចារ្យ ជា អ្នក ចាត់ចែង កិច្ច ពិធី នានា ដូចជា ការសំពះ ផ្ទឹម កាត់ សក់ ចង់ ដៃ ជាដើម ។ សម្ដេច បាន ផ្តល់ យោបល់ ដល់ អាចារ្យ ដែល ចាត់ចែង ពិធី រៀបអាពាហ៍ពិពាហ៍ ឱ្យ ពិភាក្សា ជាមួយ ម្ចាស់ ដើមការជាមុន រឿង ដាក់ កូនកំលោះ អង្គុយ ផ្ទឹម នៅ ខាងឆ្វេង ឬ ខាងស្តាំ នូក ក្រមុំ ជៀសវាង ធ្វើឱ្យ ខូច ពិធី ការ ដោយសារ ម្ចាស់ ដើម ការទាស់ គ្នា ជាមួយ អាចារ្យ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តាំផ្ញើ ទៅ អាចារ្យ កុំ ឱ្យ រឹង ទទឹង ជាមួយ ម្ចាស់ ដើម ការ ឬ ទាមទារ ថា ត្រូវតែ អនុវត្ត តាម ក្បួន ច្បាប់ ហើយ ទៅ បង្ខំ ម្ចាស់ ដើម ការរឿង ដាក់ កូនប្រុស នៅ ខាងឆ្វេង ឬ ខាងស្តាំ ។
សម្ដេច នាយក រដ្ឋមន្ត្រី បាន ហាមប្រាម ថា មិន អាច យក ក្បួន ទៅ បង្ខំឱ្យ គ្រួសារ ម្ចាស់ ដើម ការទទួលយក នោះ ទេ ពោលគឺ ត្រូវ សួរ គ្នា ជាមួយគ្នា ជាមុន ទើប មិន បណ្ដាលឱ្យ ខូច ពិធី ។
សម្ដេច តេជោ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ត្រូវ សួរនាំ ជាមួយ ម្ចាស់ ដើមការជាមុន បើ ម្ចាស់ ដើមការយក តាម ទំនៀមទម្លាប់ ដែល ពួកគាត់ ធ្លាប់ ធ្វើ ដែល ដាក់ ប្រុស នៅ ខាងស្ដាំ គឺ សូម ធ្វើ តាម ម្ចាស់ ដើម ការទៅ ប៉ុន្តែ ក្នុង ករណី ខាង ម្ចាស់ ដើម ការគេ ថា ស្រេច លើ លោក អាចារ្យ ដូច្នេះ លោក អាចារ្យ ចាត់ចែង ខ្លួន ឯង ទៅ » ។
សម្តេច គូសបញ្ជាក់ បែប នេះ ដោយ សម្តេច មាន ការបារម្ភ ថា ក្រោយពេល ដែល សម្តេច អំពាវនាវ ដល់ ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ កាលពី ថ្ងៃទី ៧ មេសា ម្សិលមិញ ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី ឱ្យ បញ្ចៀស រាល់ ការរឹបអូស ទ្រព្យសម្បត្តិ ដល់ អ្នក មិន មាន លទ្ធភាព ពិត ប្រាកដ ហើយ នោះ ក្រែង មាន ប្រជាពលរដ្ឋ មួយចំនួន ដែល ជាប់ កម្ចី ជាមួយ ធនាគារ ឬ មីក្រូ ហិរញ្ញ មាន លុយ ហើយ មិន យក ទៅ សង ធនាគារ ខណៈ បណ្តា ស្ថាប័ន ទាំងនោះ ក៏ បាន ផ្តល់ ការអនុគ្រោះ ច្រើន ដែរ ។
ការលើកឡើង របស់ សម្តេច តេជោ ហ៊ុន សែន ធ្វើឡើង នៅក្នុង ឱកាស សម្តេច អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី នៅ កោះ ពេជ្រ នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ ។
សម្តេច តេជោ មានប្រសាសន៍ បន្ថែម ថា៖ « រដ្ឋាភិបាល សុំ ការអនុគ្រោះ រៀបចំ ឥណទាន ឡើងវិញ ចំពោះ អ្នកជំពាក់ ធនាគារ ឱ្យ យោគយល់ ចំពោះ ការលំបាក ក្នុង ការសង យឺត ឬ ផ្សេង ៗ អាច ប្រើប្រាស់ រយៈពេល ខ្លះ តែ មិន មែន ផ្អែក ទៅ លើ បញ្ហា នេះ មិន សង ធនាគារ មាន លុយ ហើយ មិន សង ទេ ។ »
ជាមួយគ្នា នេះ សម្តេច បញ្ជាក់ បន្ថែម ថា ប្រសិនបើ បុគ្គល ណា ម្នាក់ ដែល ញុះញង់ ភ្ជាប់ រឿង នយោបាយ ទៅនឹង ករណី ជំពាក់ បំណុល ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ ដោយ ដើរ ឃោសនា ថា បើ បក្ស គេ ឈ្នះ មិន សង សូម ឱ្យ ធនាគារ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ទាំងនោះ ចាត់ វិធានការ ប្តឹង ទៅ តុលារ ដើម្បី រឹបអូស ទ្រព្យសម្បត្តិ បុគ្គល នោះ ដើម្បី កុំ ឱ្យ ដើរ បង្ក រឿង ទៀត ។
ក្នុង ឱកាស ជួប ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ ថា ធនធាន មនុស្ស ដែល មាន ការចេះដឹង នៅក្នុង ព្រះពុទ្ធ សាសនា និង សាសនា ដ៏ទៃ ទៀត សុទ្ធតែ បាន ជួយ រួមចំណែក ដល់ ការអភិវឌ្ឍ សង្គមជាតិ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « យើង ត្រូវ គួបផ្សំ គ្នា រវាង ពុទ្ធ ចក្រ និង អាណាចក្រ នៅ ទីនេះ ដើម្បី ជួយ ដល់ សង្គម របស់ យើង ហើយ ធនធាន មនុស្ស ដែល មាន ការចេះដឹង នៅក្នុង ព្រះពុទ្ធ សាសនា និង សាសនា ដទៃ ទៀត សុទ្ធតែ បាន ជួយ រួមចំណែក ដល់ ការអភិវឌ្ឍ សង្គម ។ ចំណុច នេះ ដែល គេ មិន ត្រូវ មើល ស្រាល ក្នុង ការដឹកនាំ ប្រទេសជាតិ មួយ ហើយ មើល ស្រាល ជាមួយ តួនាទី សាសនា នោះ ទេ » ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន គូសបញ្ជាក់ ថា រដ្ឋ ក៏ ទទួលបាន ផលប្រយោជន៍ ពី ព្រះពុទ្ធ សាសនា ឬ សាសនា ដទៃ ទៀត ត្រឡប់ មកវិញ ផងដែរ ពោល មាន ន័យ ថា គ្រប់ សាសនា ទាំងអស់ តែងតែ អប់រំ ទូន្មាន មនុស្ស ឲ្យ ធ្វើ អំពើ ល្អ ដូច្នេះ អំពើ ល្អ នេះ ហើយ បាន ជួយ ដល់ រដ្ឋ ក្នុង ការគ្រប់គ្រង សង្គម ។ ចំណុច នេះ សម្ដេច អះអាង ថា ចំណង ទាក់ទង គ្នា រវាង អាណាចក្រ និង ពុទ្ធ ចក្រ នេះ ត្រូវបាន សម្តេច សរសេរ ក្នុង និក្ខេប បទ បណ្ឌិត វិទ្យាសាស្ត្រ នយោបាយ តាំងពី ៣០ ឆ្នាំ មុន មក ម្ល៉េះ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន បន្ថែម ទៀត ថា គ្រប់ សាសនា ទាំងអស់ ទាំង ព្រះពុទ្ធ សាសនា គ្រិស្ដ សាសនា ឥស្លាម សាសនា គឺ ណែនាំឲ្យ មនុស្ស ប្រព្រឹត្ត តែ អំពើ ល្អ ដូច្នេះ បើ មនុស្ស ធ្វើ អំពើ ល្អ គ្រប់ ទីកន្លែង ហើយ នោះ ។ ផ្ទុយទៅវិញ បើ មនុស្ស ប្រព្រឹត្ត អំពើ អាក្រក់ ច្រើន រដ្ឋ ក៏ ទទួល ការលំបាក ដោយ ត្រូវ យក មនុស្ស ទាំងនោះ មក ផ្ដន្ទាទោស ដាក់ ពន្ធនាគារ ដូច្នេះ រឿង មិន មែន សាមញ្ញ ពេក នោះ ទេ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង យ៉ាង ដូចនេះ នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី នៅ ទូទាំង ប្រទេស សរុប ១៥០០ នាក់ នៅ មជ្ឈមណ្ឌល កោះ ពេជ្រ ។
បន្ថែម ពី នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ឱ្យដឹង ទៀត ថា សម្តេច គឺជា មនុស្ស ចាប់ ឆាយ ប៉ុន្តែ ការចាប់ ឆាយ របស់ សម្តេច នេះ ហើយ ដែល បាន រៀបចំ គោល នយោបាយ ត្រូវ ជាមួយនឹង គោលដៅ ដែល ប្រជាជន ចង់បាន ផងដែរ ៕ តំណាង លោក ហេង សួរ ប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ឃុំ ផ្អាវ ស្នើ ប្រធាន សាខា បក្ស ភូមិ និង ប្រធាន ក្រុម បក្ស ត្រូវ យកចិត្តទុកដាក់ អំពី សុខ ទុក្ខ របស់ សមាជិក បក្ស ក្នុង ដែន គ្រប់គ្រង របស់ ខ្លួន
លោក ឡេង តុង បាន បញ្ជាក់ ផងដែរ ថា ដើម្បី ឈាន ទៅ ការទទួល នូវ ជ័យ ជំនះ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នា ពេល ខាងមុខ ប្រធាន សាខា បក្ស ភូមិ និង ក្រុម បក្ស ត្រូវ ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជំរុញ ឱ្យ សមាជិក បក្ស ទាំងអស់ ទៅ បោះឆ្នោត ឱ្យ បាន គ្រប់ ៗ គ្នា ជូន គណបក្ស ប្រជាជន កម្ពុជា ។
លោក អនុប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ឃុំ ផ្អាវ គូសបញ្ជាក់ ថា ក្រោយពី លោក ហេង សួរ បាន ទទួលបន្ទុក លើ ការងារ មូលដ្ឋាន ឃុំ ផ្អាវ ដោយ ក្នុង នោះ បាន ធ្វើ ការកែលម្អ ស្នាក់ការបក្ស ឃុំ . កែលម្អ ដល់ មណ្ឌល សុខភាព . ផ្តល់ ការលើកទឹកចិត្ត ចំពោះ ភូមិ ណា ដែល ទទួលបាន សម្លេង លើស ការបោះឆ្នោត អាណត្តិ មុន . សិក្សា កែលម្អ ដំបូល ផ្សារ ផ្អាវ . សិក្សា រក វិធីសាស្រ្ត ក្នុង ការរំដោះ ទឹក ចេញ នៅ ខែ វស្សា និង អាជ្ញាធរ មាន ភាពស្វាហាប់ ក្នុង ការជួយ សម្រួល ដល់ ការងារ របស់ ប្រជាពលរដ្ឋ ដោយ មិន ប្រកាន់ និន្នាការ ។
ពេល អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី នៅ កោះ ពេជ្រ នៅ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ស្វាគមន៍ រាល់ ការចែករំលែក គំនិត និង ទស្សនៈ ផ្សេង ៗ តែ មិន ត្រូវ ឱ្យ ជ្រុល ជ្រួស នោះ ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ក្នុង ជីវិត នយោបាយ របស់ ខ្ញុំ តែងតែ ជោគជ័យ ជារៀងរហូតមក តែ ខ្ញុំ មិន ទាន់ ប្រកាស ថា ជា គ្រូ ជោគជ័យ ទេ ហើយក៏ មិន ទាន់ អាច ទៅ បង្រៀន អ្នកដទៃ ពី ភាពជោគជ័យ នោះ ដែរ ។ ខ្ញុំ លើកទឹក ឱ្យ បន្ត មាន ការបង្ហាត់ បង្រៀន បណ្តុះ ផ្នត់គំនិត វិជ្ជមាន និង ជោគជ័យ ដល់ ស្រទាប់ មហាជន ខ្មែរ តែ ក៏ ត្រូវ ជៀសវាង នូវ ពាក្យពេចន៍ ខ្លះ ៗ ដែល មាន ភាពរសើប និង បង្ក បញ្ហា ដល់ សង្គម » ។
សូម ជម្រាប ថា ថ្មី ៗ នេះ មាន បុគ្គល មួយចំនួន ដែល តែង ខ្លួន ជា គ្រូ ជោគជ័យ បើក សិក្ខាចែករំលែក គំនិត របស់ ពួកគេ ដល់ មហាជន ហើយ ថែមទាំង បង្កឲ្យ មាន មតិ រិះគន់ ដោយសារ មាន ការបង្កើត ប្រធានបទ « ទម្លាប់ អ្នក មាន » ដោយ ប្រៀបធៀប វណ្ណៈ សង្គម ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ០៨ ខែមេសា ឆ្នាំ ២០២៣ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ អាចារ្យ អាចារិនី នៅ ទូទាំង ប្រទេស សរុប ១៥០០ នាក់ ។
ពិធី សំណេះសំណាល ជាមួយ អាចារ្យ - អាចារិនី ប្រព្រឹត្តទៅ ស្រប ពេល ប្រជាពុទ្ធ បរិស័ទ ទាំង ៥១ ប្រទេស នៃ ទ្វីប ទាំង៥ ដែល ជា សមាជិក នៃ ព្រះពុទ្ធ សាសនា ពិភពលោក កំពុង សប្បាយរីករាយ ត្រេកអរ ប្រារព្ធ ពិធី បុណ្យ ទិវា ព្រះពុទ្ធ សាសនា អន្តរជាតិ ៨មេសា នៅលើ សកលលោក នា ថ្ងៃ នេះ ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការផ្សារ ភ្ជាប់ រវាង អាណាចក្រ និង ពុទ្ធ ចក្រ គឺជា ទស្សនៈ វិស័យ នយោបាយ របស់ បក្ស ប្រជាជន កម្ពុជា តាំងពី ពេល ចាប់ផ្តើម តស៊ូ រំដោះ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នៅ ឆ្នាំ ១៩៧០ នៅពេល ផ្នែក អាណាចក្រ ជួប វិបត្តិ សង្គ្រាម ផ្នែក ពុទ្ធ ចក្រ ក៏ ជួប នឹង វិបត្តិ ដូចគ្នា ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អាណាចក្រ និង ពុទ្ធ ចក្រ ផ្សារភ្ជាប់គ្នា យ៉ាង សំខាន់ មិន អាច ខ្វះ គ្នា បាន នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ចំណង ទាក់ទង គ្នា រវាង អាណាចក្រ និង ពុទ្ធ ចក្រ នេះ ត្រូវបាន សម្តេច សរសេរ ក្នុង និក្ខេប បទ បណ្ឌិត វិទ្យាសាស្ត្រ នយោបាយ តាំងពី ៣០ ឆ្នាំ មុន មក ម្ល៉េះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការដឹកនាំ ប្រទេសជាតិ មិន អាច មើលស្រាល តួនាទី សាសនា នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង រំលឹក ថា សម្តេច លើកឡើង ពី វិបត្តិ អាចារ្យ ផ្តើម ចេញ ពី ពិធី មង្គលការ កូន របស់ លោក ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី ។ ក្នុង ពិធី នោះ អាចារ្យ ភ្លេច វាយ ឃ្មោះ ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តល់ យោបល់ ដល់ អាចារ្យ ឱ្យ ពិភាក្សា ជាមួយ ម្ចាស់ ដើម ការ រឿង ដាក់ កូនប្រុស អង្គុយ ផ្ទឹម នៅ ខាងឆ្វេង ឬ ខាងស្តាំ ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តាំ ទៅ អាចារ្យ កុំ ឱ្យ រឹង ទទឹង យក ក្បួន ច្បាប់ ទៅ បង្ខំ ម្ចាស់ ដើម ការរឿង ដាក់ កូនប្រុស នៅ ខាងឆ្វេង ឬ ខាងស្តាំ ។
* សម្តេច តេជោ ហ៊ុន សែន សរសើរ ភរិយា របស់ សម្តេច គិតគូរ គ្រប់ សព្វ ទាំងអស់ នៅពេល មាន កម្មវិធី បុណ្យ ទាន ឬ មង្គលការ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ភរិយា របស់ សម្តេច ជា បង្អែក ដ៏ សំខាន់ នៅក្នុង ជីវិត របស់ សម្តេច ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច បាន យក ជីវិត ទៅ ដូរ ជាមួយ សន្តិភាព ដូរ យក អាយុជីវិត របស់ ប្រជាពលរដ្ឋ និង ការធ្វើ កំណែទម្រង់ សេដ្ឋកិច្ច ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ស្វាគមន៍ រាល់ ការចែករំលែក គំនិត និង ទស្សនៈ ផ្សេង ៗ តែ មិន ត្រូវ ឱ្យ ជ្រុល ជ្រួស នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល បាន សម្រេច នូវ សមិទ្ធផល ច្រើន ណាស់ សម្រាប់ ជាតិ និង ប្រជាជន ។ សមិទ្ធផល នោះ រួម មាន ការរក្សា បាន ស្ថេរភាព នយោបាយ ការគ្រប់គ្រង បាន ជំងឺ កូវីដ១៩ ការគ្រប់គ្រង សេដ្ឋកិច្ច ជាតិ បាន ល្អ ប្រសើរ ចាត់តាំង ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ បាន ដោយ ជោគជ័យ និង ការដឹកនាំ កិច្ចប្រជុំ អាស៊ាន ដោយ ជោគជ័យ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការរក្សា នូវ សន្តិភាព និង ស្ថេរភាព នយោបាយ គឺជា កិច្ចការ ដ៏ សំខាន់ ត្រូវ ចូលរួម ទាំងអស់ គ្នា ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ អាចារ្យ អាចារិនី ចូលរួម អប់រំ ពលរដ្ឋ និង យុវជន នៅ តាម ភូមិឋាន ឱ្យ លះបង់ អំពើ អបាយ មុខ ដូចជា ល្បែងស៊ីសង និង ការប្រើប្រាស់ គ្រឿងញៀន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា មាន តែ គណបក្ស ប្រជាជន មួយ ប៉ុណ្ណោះ មាន លទ្ធភាព រក្សា សុខ សន្តិភាព និង ស្ថេរភាព នយោបាយ ។
* សម្តេច តេជោ ហ៊ុន សែន បន្ត លើកទឹកចិត្ត ដល់ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ចាប់ វិធានការរឹបអូស ទ្រព្យ របស់ ជន ញុះញង់ មិន ឱ្យ សង ប្រាក់ ទៅ គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តាំ ទៅ អ្នក ខ្ចី ប្រាក់ ពី គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ទាំងអស់ មាន លុយ ត្រូវ សង ទៅ ធនាគារ កុំ ផ្តេក ផ្តួល លើប្រសាសន៍ សម្តេច ស្នើ ឱ្យ មាន ការអនុគ្រោះ មាន លុយ ហើយ មិន យក ទៅ សង គេ ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តាំ អាចារ្យ កុំ ឱ្យ លូក ដៃ ក្នុង កិច្ចការ ព្រះសង្ឃ ច្រើន ពេក ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការថែរក្សា វប្បធម៌ អរិយធម៌ គឺ សំខាន់ ណាស់ ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ឱ្យ សប្បុរស ជន ជួយ ឧបត្ថម្ភ ឧបករណ៍ ភ្លេង ពិណពាទ្យ ទៅ តាម ទី អារាម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ចាត់ទុក មនុស្ស នៅក្នុង ប្រទេស ទាំងអស់ ជា គ្រូ របស់ សម្តេច ។
( ភ្នំពេញ ) ៖ សមាគម គ្រឹះស្ថាន ឧត្តម សិក្សា កម្ពុជា ដែល មាន ១២១ គ្រឹះស្ថាន សិក្សា ជា សមាជិក នៅ ល្ងាច ថ្ងៃទី ០៧ ខែមេសា ឆ្នាំ ២០២៣ នេះ បាន រៀបចំ ពិធី សំណេះសំណាល និង ពិសា អាហារ សាមគ្គី អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ក្រោម អធិបតីភាព លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ប្រធាន គណៈកម្មាធិការ អាហារូបករណ៍ សិស្ស - និស្សិត ក្រីក្រ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ។
ក្នុង នោះ ក៏ មាន ការចូលរួម ពីសំណាក់ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា . លោក ហ៊ុន ម៉ានិត នាយក រង ខុទ្ទកាល័យ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង អប់រំ យុវជន និង កីឡា ថ្នាក់ដឹកនាំ សាលា រាជធានី ភ្នំពេញ ភ្ញៀវ កិត្តិយស ជាតិ - អន្តរជាតិ និង សមាជិក សមាគម ប្រមាណ ជាង ៣០០ នាក់ ។
តាម របាយការណ៍ លោក បណ្ឌិត លី ឆេង ប្រធាន គណៈប្រតិបត្តិ បាន បង្ហាញ ថា សមាគម មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ជាពិសេស ក្នុង ការជួយ ពង្រឹង សេវា អប់រំ ប្រកបដោយ គុណភាព រួមចំណែក អភិវឌ្ឍន៍ វិស័យ អប់រំ នៅ កម្ពុជា និង បង្កើត ធនធាន មនុស្ស ជាមួយ រាជ រដ្ឋាភិបាល ដែល មាន ក្រសួង អប់រំ យុវជន និង កីឡា ជា សេនាធិការ ។ សមាគម បាន ចាប់ផ្តើម នៅ ឆ្នាំ ២០០៤ ហើយ បច្ចុប្បន្ន នេះ មាន ១២១ គ្រឹះស្ថាន សិក្សា ជា សមាជិក និង បាន ដំណើរការ តាមរយៈ ការបោះឆ្នោត ៦អាណត្តិ រួច មកហើយ ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ហេង វ៉ាន់ ដា ប្រធាន ក្រុមប្រឹក្សាភិបាល តំណាង សមាគម ទាំងមូល បាន ប្រកាស សារ គាំទ្រ ពេញ ទំហឹង សម្តេច តេជោ ហ៊ុន សែន ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សម្រាប់ អាណត្តិ ទី៧ នៃ រដ្ឋសភា និង គាំទ្រ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត ជា បេក្ខភាព នាយក រដ្ឋមន្ត្រី សម្រាប់ ពេល អនាគត ផងដែរ ។
ក្នុង ឱកាស ដ៏ ឧត្តុង្គឧត្តម នោះ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន វាយតម្លៃ ខ្ពស់ និង កោតសរសើរ ដល់ ថ្នាក់ដឹកនាំ និង សមាជិក សមាគម ទាំងអស់ ដែល បាន ដឹកនាំ គ្
រប់ គ្រង និង បំពេញ ការងារ រៀង ៗ ខ្លួន ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ រហូត ទទួលបាន ជោគជ័យ និង មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ។
