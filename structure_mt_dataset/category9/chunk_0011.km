ក្នុង កម្មវិធី នេះ ក្រុមហ៊ុន ស៊ី ភី. ក្រុមហ៊ុន ពេជ្រ មុន្នី និង ក្រុមហ៊ុន Betagro ក៏ បាន បង្ហាញ ពី ផលិតផល កែច្នៃ ក្នុង ស្រុក ដែល ក្រុមហ៊ុន ផលិត បាន សម្រាប់ ផ្គត់ផ្គង់ សាច់ សត្វ ជូន ដល់ អ្នក បរិភោគ ជូន ដល់ មន្ដ្រីរាជការ ទាំង ៣០០ នាក់ ផងដែរ ។
ក្នុង នោះ មាន ការចូលរួម ពីសំណាក់ លោក លោកស្រី អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន សុខភាព សត្វ និង ផលិតកម្ម សត្វ លោក ប្រធាន នាយកដ្ឋាន លោក នាយក វិទ្យាស្ថាន ជាតិ ស្រាវជ្រាវ សុខភាព សត្វ និង ផលិតកម្ម សត្វ លោក ប្រធាន សមាគម អ្នក ចិញ្ចឹម សត្វ កម្ពុជា ។
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា គណៈ គ្រូពេទ្យ កម្ពុជា នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ ផ្ញើ សារ រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
* ព្រឹត្តិការណ៍ ចម្លែក ពីរ
ព្រឹត្តិការណ៍ ចម្លែក ពីរ បាន កើតឡើង ក្នុង រយៈពេល ប៉ុន្មាន សប្ដាហ៍ មក នេះ នោះ គឺ ការបាត់ ខ្លួន ០៣ សប្ដាហ៍ របស់ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន រហូតដល់ មាន ពាក្យ ចចាមអារ៉ាម ខ្លះ ថា លោក បាន ស្លាប់ បាត់ ទៅ ហើយ និង ខ្លះ ទៀត ថា ក្លាយជា មនុស្ស រុក្ខជាតិ ជាដើម ។
ចំណែកឯ ព្រឹត្តិការណ៍ ចុងក្រោយ បំផុត នោះ គឺ ការបាញ់ កាំភ្លើង ដាក់ គ្នា ទៅ វិញ ទៅ មក រវាង ទាហាន កូរ៉េ ខាងត្បូង និង កូរ៉េ ខាងជើង នៅឯ តំបន់ ព្រំដែន គ្មាន យោធា នៃ ប្រទេស ទាំង ពីរ កាលពី ថ្ងៃ អាទិត្យ កន្លងទៅ នេះ ហើយ ដែល ព័ត៌មាន ជាច្រើន ថា ការបាញ់ តបត គ្នា នេះ បាន ផ្ទុះឡើង ដំបូង ចេញ ពី ខាង កូរ៉េ ខាងជើង ។
កូរ៉េ ខាងជើង មិន បាន ពន្យល់ អ្វី ទាល់តែសោះ ទាំង ការបាត់ ខ្លួន របស់ លោក គីម ជុង អ៊ុន និង ការបាញ់ប្រហារ ដាក់ គ្នា ជាមួយ ទាហាន កូរ៉េ ខាងត្បូង ។ វា ហាក់ដូចជា ពួកគេ ធ្វើ ដូចជា គ្មាន រឿង អ្វី កើតឡើង ហើយក៏ មិន បាន សម្ដែង ការព្រួយបារម្ភ ចំពោះ អ្វី ដែល បាន កើតឡើង នោះ ដែរ ។ តែ យ៉ាងណា រឿង បែប នេះ គឺជា ទម្លាប់ របស់ កូរ៉េ ខាងជើង ទៅ ហើយ នោះ គឺ « មិន ឆ្លើយ គឺជា ចម្លើយ » ។
កូរ៉េ ខាងជើង ជាញឹកញាប់ មិន ដែល ពន្យល់ ពី សកម្មភាព ដែល ខ្លួន កំពុង និង បាន ធ្វើឡើយ ហើយ នៅពេល សកម្មភាព បង្ក រឿង ដែល ខ្លួន បាន ប្រព្រឹត្ត ជា កំហុស ដ៏ ធំ ដែល ពិបាក នឹង ធ្វើជា មិន ដឹង កូរ៉េ ខាងជើង នឹង និយាយ កុហក បើ ទោះជា មាន ភស្តុតាង កណ្តាល វាល ក៏ដោយ ។ ជា ឧទាហរណ៍ ដូចជា ហេតុការណ៍ បាញ់ ពន្លិច នាវា ចម្បាំង កូរ៉េ ខាងត្បូង កាលពី ឆ្នាំ ២០១០ និង ការបំផ្ទុះ គ្រាប់ លើ យន្ដហោះ មួយ គ្រឿង នៃ ក្រុមហ៊ុន អាកាសចរណ៍ កូរ៉េ ខាងត្បូង កាលពី ឆ្នាំ ១៩៨៧ គឺ កូរ៉េ ខាងជើង ធ្វើ មិន ដឹង មិន លឺ អ្វី ទាំងអស់ ។
* ហេតុ អ្វី បានជាពិបាក ធ្វើ ទំនាក់ទំនង ជាមួយ កូរ៉េ ខាងជើង ?
វិធីសាស្ត្រ មិន ឆ្លើយ គឺជា ចម្លើយ បាន បង្ហាញ ថា តើ ហេតុ អ្វី បានជា កូរ៉េ ខាងជើង ឯកោ . ហេតុ អ្វី បានជាពិបាក ធ្វើ ទំនាក់ទំនង ជាមួយ កូរ៉េ ខាងជើង ។ មេដឹកនាំ ប្រទេស មួយ នេះ មិន ដែល ខ្វល់ ឬ ក៏ ឈឺ ក្បាល ចំពោះ អ្វី ដែល គេ គ្រប់ គ្នា កំពុង គិត នោះ ទេ ។ លើស ពី នេះ ទៅ ទៀត រឿង ដែល ធ្វើឱ្យ គេ ពិបាក ធ្វើ ទំនាក់ទំនង ជាមួយ កូរ៉េ ខាងជើង នោះ គឺ ប្រទេស មួយ នេះ ដឹកនាំ ដោយ របប គ្រួសារ ផ្ដាច់ការ មិន មែន ជា របប កុម្មុយនិស្ដ ឡើយ ។
មិន តែ ប៉ុណ្ណោះ អ្វី ដែល ធ្វើឱ្យ ប្រទេស ក្បែរខាង ដូចជា ជប៉ុន និង កូរ៉េ ខាងត្បូង ព្រួយបារម្ភ នោះ គឺ កូរ៉េ ខាងជើង មាន អាវុធ នុយក្លេអ៊ែរ តែ មិន ដែល ខ្វល់ ឡើយ ពី ច្បាប់ អន្តរជាតិ ឬ ក៏ សីលធម៌ ជា សកល អ្វី នោះ ទេ ។ អ្វី ដែល ពួកគេ ខ្វល់ គឺ ធ្វើ យ៉ាងណា ឱ្យ តែ កូរ៉េ ខាងជើង ត្រូវ ស្ថិត នៅក្រោម ការដឹកនាំ របស់ គ្រួសារ ត្រកូល គីម តែ ប៉ុណ្ណោះ ៕
ជន ទំនើង ២នាក់ កាន់ ដាវ សាមូរ៉ៃ ជប៉ុន ស្រែក ផ្អើល ពេញ ភូមិ រក ជើង ខ្លាំង កាប់ គ្នា ជារៀងរាល់ ថ្ងៃ ត្រូវ ជាប់ ខ្នោះ ប៉ូលីស
( កណ្ដាល ) ៖ ជន ទំនើង កាច សាហាវ ២នាក់ ដៃគូ គ្នា ប្រដាប់ ដោយ ដាវ សាមូរ៉ៃ របស់ ជប៉ុន បាន ស្រែក ឡូឡា ជារៀងរាល់ ល្ងាច ប្រកូកប្រកាស ហៅ ជើង ខ្លាំង កាប់ ដូយ ២ស្មើ ជារៀងរាល់ ថ្ងៃ ដែល បង្កឱ្យ មាន ការភ័យខ្លាច ដល់ អ្នកភូមិ បារ៉ែ ន ក្រោម ឃុំ ស្វាយ ប្រទាល ស្រុក ស្អាង ខេត្ត កណ្តាល ជារៀងរាល់ ថ្ងៃ ។
ដោយសារ ទ្រាំ មិន បាន នឹង កាយវិការ សាហាវ យង់ឃ្នង របស់ ជនង ទំនើង មួយ គូ នេះ ពលរដ្ឋ បាន ប្ដឹង នគរបាល ឱ្យ ចាប់ខ្លួន ពួកគេ បាន សម្រេច នៅ ថ្ងៃទី ៥ ខែឧសភា ម្សិលមិញ នេះ ។
ប្រភព បន្ត ថា ជនសង្ស័យ ទាំង ២នាក់ មាន ឈ្មោះ ដូច ជា៖
១៖ ឈ្មោះ ទី ចាន់ ធា ភេទ ប្រុស អាយុ ២៩ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ មិន ពិតប្រាកដ មាន ទីលំនៅ ភូមិ បារ៉ែ ន ក្រោម ឃុំ ស្វាយ ប្រទាល ស្រុក ស្អាង ខេត្ត កណ្ដាល ។ ២៖ ឈ្មោះ ភឿន ចិត្រា ហៅ ប្រុស ភេទ ប្រុស អាយុ ២១ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ មិន ពិតប្រាកដ ទីលំនៅ ភូមិ បារ៉ែ ន ក្រោម ឃុំ ស្វាយ ប្រទាល ស្រុក ស្អាង ខេត្ត កណ្តាល ។
ការស្ទង់ មតិ ខាងលើ ដែល ប្រព្រឹត្តទៅ កាលពី ថ្ងៃចន្ទ និង ថ្ងៃអង្គារ ដើម សប្តាហ៍ នេះ បាន រកឃើញ ថា ៤៣ ភាគរយ នៃ ប្រជាជន អាមេរិក ដែល មាន សិទ្ធិ បោះឆ្នោត បាន និយាយ ថា ពួកគេ នឹង គាំទ្រ លោក បៃ ដិន ក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី ថ្ងៃ ០៣ វិច្ឆិកា ខណៈ ៤១ ភាគរយ បាន និយាយ ថា នឹង គាំទ្រ លោក ត្រាំ គឺ ខុសគ្នា តែ ០២ ភាគរយ ប៉ុណ្ណោះ ។ បើ ក្រឡេក ទៅ មើល ការស្ទង់ មតិ កាលពី សប្តាហ៍ មុន វិញ គឺ លោក បៃ ដិន នាំមុខ លោក ត្រាំ រហូតដល់ ០៦ ភាគរយ ហើយ សប្តាហ៍ មុន មួយ ទៀត គឺ នាំមុខ រហូត ទៅ ០៨ ភាគរយ ឯណោះ ។
ក្រៅពី នេះ ទៀត ៣៧ភាគរយ បាន លើកឡើង ថា លោក ត្រាំ សក្តិសម ក្នុង ការដឹកនាំ កិច្ចប្រឹងប្រែង ប្រយុទ្ធ ប្រឆាំង ការរាតត្បាត នៃ ជំងឺ COVID-19 ហើយ មាន តែ ៣៥ ភាគរយ ប៉ុណ្ណោះ យល់ ថា លោក បៃ ដិន សក្តិសម ជាង ខណៈ កាលពី ពាក់កណ្តាល ខែមេសា គឺ សំឡេង គាំទ្រ លោក បៃ ដិន បាន នាំមុខ លោក ត្រាំ ត្រង់ ចំណុច នេះ ប៉ុន្តែ ឥឡូវ បែរជា លោក ត្រាំ នាំមុខ វិញ ៕ កម្លាំង អាវុធហត្ថ ខេត្ត តាកែវ បង្រ្កាប ក្រុម អ្នកប្រើប្រាស់ និង ជួញដូរ គ្រឿងញៀន ជា យុវជន ១៣នាក់
( តាកែវ )៖ យុវជន យុវនារី ស្ទាវ មួយ ក្រុម មាន គ្នា ១៣ នាក់ ដែល ជា មុខសញ្ញា ប្រើប្រាស់ និង ជួញដូរ គ្រឿងញៀន ត្រូវបាន កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត តាកែវ ចុះបង្ក្រាប នៅ ព្រឹក ថ្ងៃពុធ ទី៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ នៅ ផ្ទះសំណាក់ យីហោ ៦៦ ស្ថិត នៅ ភូមិ ប្រហ៊ូត សង្កាត់ រកា ក្រៅ ក្រុង ដូន កែវ ។
ឧត្តមសេនីយ៍ ត្រី ឡា ឡៃ មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត តាកែវ បាន ថ្លែង ឲ្យដឹង ថា ប្រតិបត្តិការ ចុះបង្រ្កាប មុខ សញ្ញា ប្រើប្រាស់ និង ចែកចាយ គ្រឿងញៀន នៅ ចំណុច ផ្ទះសំណាក់ ខាងលើ ដកហូត បាន វត្ថុតាង មួយចំនួន មាន ម៉ូតូ ៤គ្រឿង ដាវ ២ និង ថ្នាំ ញៀន ៤កញ្ចប់ ។ ប្រតិបត្តិការ ត្រូវបាន ធ្វើឡើង ក្រោម ការសម្របសម្រួល នីតិវិធី ពី លោក លោក ជីវ ចាន់ តារា ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត តាកែវ ដោយ កម្លាំង បាន ឃាត់ខ្លួន បាន ជនសង្ស័យ ចំនួន ១៣នាក់ ក្នុង នោះ មាន ស្រី ចំនួន ៦នាក់ ។
ឧត្តមសេនីយ៍ ត្រី ឡា ឡៃ បាន បន្ត ថា ជនសង្ស័យ ជា ស្រ្តី ចំនួន ៦នាក់ ដែល ប្រើប្រាស់ គ្រឿងញៀន ត្រូវបាន ព្រះរាជអាជ្ញា អោយ បញ្ជូន ទៅកាន់ មន្ទីរ សង្គមកិច្ច ។ ដោយឡែក ជនសង្ស័យ ជា ប្រុស ៗ ចំនួន ៦នាក់ ទៀត ដែល ប្រើប្រាស់ និង ចែកចាយ នឹង ត្រូវ កសាង សំណុំរឿង បញ្ជូន ទៅ ចាត់ការ បន្ត តាម នីតិវិធី ៕
ជុំវិញ បញ្ហា នេះ ដែរ ភាគី អ៊ីស្រាអែល ឯណោះ វិញ ក៏ បាន គូសបញ្ជាក់ នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន របស់ ខ្លួន យ៉ាង ដូច្នេះ ដែរ ថា « រថក្រោះ របស់ យើង បាន បាញ់ គ្រាប់ មីស៊ីល ទៅកាន់ ទីតាំង យោធា ចំនួន ០៣ កន្លែង របស់ ក្រុម ចលនា ហាម៉ាស់ នៅ តំបន់ ហ្គាហ្សា ស្ទ្រីប ដើម្បី សងសឹក ទៅនឹង គ្រាប់ រ៉ុក្កែត ដែល បាន បាញ់ ចេញ ពី ទីនោះ » ។ របាយការណ៍ ដដែល នេះ បាន បន្ថែម ថា « គ្រាប់ កាំជ្រួច មីស៊ីល ទាំងនេះ បាន ធ្លាក់ នៅ ទីវាល ដោយ មិន បង្កឲ្យ មាន មនុស្ស រងរបួស ឬ ស្លាប់ ឡើយ » ។
គួរ ជម្រាប ថា នៅ ព្រឹក ថ្ងៃ ដដែល នោះ កាំ ជ្រួច មីស៊ីល ដែល ធ្វើ ដោយ ដៃ ត្រូវបាន បាញ់ ចេញ ពី ឆ្នេរសមុទ្រ ហ្គាហ្សា ចូល ទៅក្នុង ដែនដី អ៊ីស្រាអែល ប៉ុន្តែ មិន បាន បង្កឲ្យ ខូចខាត អ្វី ឡើយ ។ ការប្រយុទ្ធ គ្នា ខាងលើ នេះ គឺជា ការបំពាន ទៅនឹង ការអំពាវនាវ ជាច្រើន លើក ច្រើន សារ ពីសំណាក់ ប្រមុខ UN ចំពោះ មុខ បញ្ហា COVID-19 ដែល គ្រប់ គ្នា សុទ្ធតែ អាច រងគ្រោះ ៕
បុរី ឡុង នី បើក ការដ្ឋាន សាងសង់ ការិយាល័យ កណ្តាល បុរី ឡុង នី និង បូទី កា កម្ពស់ ១១ជាន់ ស្ថិត នៅ តាម បណ្តោយ ផ្លូវ ទ្រុង មាន់
( ភ្នំពេញ ) ៖ បុរី ឡុង នី នៅ ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន បើក ការដ្ឋាន សាងសង់ ការិយាល័យ កណ្តាល បុរី ឡុង នី និង បូទី កា ដែល មាន កំពស់ ១១ជាន់ នៅ តាម បណ្តោយ ផ្លូវ ទ្រុង មាន់ ស្ថិត នៅ ភូមិ ដំណាក់ ធំ៣ សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ នៅ ជាប់ នឹង របង ក្រសួង កិច្ចការ នារី ដើម្បី ជា ការជួយ សម្រួល និង ផ្តល់ ទំនុកចិត្ត កាន់តែ ខ្ពស់ សម្រាប់ អតិថិជន ផងដែរ ។
បុរី ឡុង នី ជា បុរី ដែល នាំមក នូវ ផ្ទះ ក្នុង ក្តីស្រម៉ៃ និង ភាពអស្ចារ្យ ក្នុង ការរស់នៅ ប្រកបដោយ ផាសុកភាព ។ បុរី ឡុង នី គឺ នាំមក គុណភាព សំណង់ សោភ័ណភាព និង ភាពស៊ីវិល័យ ភាពល្អ នៃ ទីតាំង នៃ គំរោង ភាព ឈាន មុខ នៃ សម័យកាល ទំនើប និង ភាពលឿន នៃ ការសាងសង់ និង មាន លក្ខណៈ ពិសេស ៗ ជាច្រើន ដូច ជា៖
ប្រការ នេះ វា បាន ធ្វើឲ្យ ករណី នាំចូល សរុប ពី ក្រៅ ប្រទេស បាន កើន ដល់ ១. ៦៧៨ ករណី ហើយ ដោយ ក្នុង នោះ មាន អ្នកជំងឺ ចំនួន ១.៤០០ នាក់ បាន ជាសះស្បើយ ឡើងវិញ ខណៈ ២៧៨ នាក់ ផ្សេង ទៀង កំពុង សម្រាក ព្យាបាល នៅឯ មន្ទីរពេទ្យ នៅឡើយ ក្នុង នោះ ០៥ នាក់ កំពុង ស្ថិត ក្នុង ស្ថានភាព ធ្ងន់ធ្ងរ ។ ទោះជា យ៉ាងណាមិន មាន ករណី ស្លាប់ ត្រូវបាន រាយការណ៍ ក្នុង ចំណោម ករណី នាំចូល ទាំងនោះ ទេ ។
ដោយឡែក សម្រាប់ របាយការណ៍ ប្រចាំ ថ្ងៃ ស្តីពី តួលេខ អ្នក ជាសះស្បើយ ពី ជំងឺ COVID-19 វិញ ក្រសួង សុខាភិបាល ចិន បាន បង្ហាញ ឲ្យដឹង ថា ចំនួន សរុប នៃ អ្នក ដែល បាន ជាសះស្បើយ នៅ ទូទាំង ប្រទេស ចិន បាន កើន ដល់ ៧៧. ៩១១ នាក់ ហើយ បន្ទាប់ពី អ្នកជំងឺ ចំនួន ៥៨ នាក់ បន្ថែម ទៀត ទើបតែ បាន ជាសះស្បើយ និង បាន ចាកចេញ ពី មន្ទីរពេទ្យ កាលពី ថ្ងៃអង្គារ ម្សិលមិញ នេះ ។
គណៈកម្មាធិការ អន្តរជាតិ កាកបាទ ក្រហម ប្រចាំ កម្ពុជា ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត ជូន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចំពោះ មរណភាព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី
( ភ្នំពេញ )៖ គណៈកម្មាធិការ អន្តរជាតិ កាកបាទ ក្រហម ប្រចាំ កម្ពុជា បាន ផ្ញើ សារលិខិត ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត ជូន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល មាតា អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ២ម៉១២ ទៀប ភ្លឺ ថ្ងៃចន្ទ ១៣កើត ខែពិសាខ ឆ្នាំ ជូត ទោស័ក ព .ស.២៥៦៣ ត្រូវនឹង ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២០ ក្នុង ជន្មាយុ ៩៦ ឆ្នាំ ដោយ ជរា ពាធ ។
សូម អ្នកឧញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី សូម បាន ទៅ ចាប់បដិសន្ធិ ក្នុង បរម សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រធាន ព្រមទាំង ក្រុមគ្រួសារ ទទួល នូវ ការចូលរួម រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ នេះ និង ទទួល នូវ ការគោរព អំពី យើងខ្ញុំ ទាំងអស់ គ្នា ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង នៃ សារលិខិត ចូលរួម រំលែក មរណទុក្ខ របស់ គណៈកម្មាធិការ អន្តរជាតិ កាកបាទ ក្រហម ប្រចាំ កម្ពុជា ផ្ញេី ជូន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ៖ កម្លាំង នគរបាល បង្ក្រាប បាន ជនសង្ស័យ ម្នាក់ ដកហូត បាន ថ្នាំ ញៀន ១៤ កញ្ចប់ នៅ ស្រុក សន្ទុក ខេត្ត កំពង់ធំ
( កំពង់ធំ )៖ ដោយ មាន ការសម្របសម្រួល នីតិវិធី ពី លោក ស៊ិន វិរ : ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ធំ និង ក្រោម ការដឹកនាំ បញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ទោ អ៊ុក កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ធំ កម្លាំង ជំនាញ នៃ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ធំ បាន ចេញ ប្រតិបត្តិការ បង្ក្រាប បទល្មើស គ្រឿងញៀន នៅ ចំណុច ចំការស្វាយចន្ទី មួយ កន្លែង ស្ថិត ក្នុង ភូមិ ជ័យ មង្គល ឃុំ ជ្រាប់ ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
ប្រតិបត្តិការ ចុះបង្ក្រាប នេះ ធ្វើឡើង នៅ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២០ ដោយ បាន ឃាត់ខ្លួន ជនសង្ស័យ ១នាក់ និង ដកហូត បាន ម្សៅ ក្រាម ពណ៍ ស ថ្លា សង្ស័យ ជា សារធាតុ ញៀន ខុស ច្បាប់ ចំនួន ១៤ កញ្ចប់ ទម្ងន់ ២៥ ក្រាម និង ទូរស័ព្ទដៃ ចំនួន ០១ គ្រឿង ។
ប្រភព ពី កម្លាំង នគរបាល បាន ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ០៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ថា ជនសង្ស័យ ដែល បាន ឃាត់ខ្លួន មាន ឈ្មោះ កែវ រ៉ា ភេទ ប្រុស អាយុ ៤៨ ឆ្នាំ មុខរបរ រត់ ម៉ូតូ ឌុប រស់ នៅ ភូមិ ជ័យ ជំនះ ឃុំ ក កោះ ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។ ករណី ខាង នេះ សមត្ថភាព ជំនាញ បាន នាំ ខ្លួន ជនសង្ស័យ និង វត្ថុតាង មកកាន់ ការិយាល័យ ប្រឆាំង គ្រឿងញៀង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ធំ ដើម្បី កសាង នីតិវិធី ចាត់ការ បន្ត ៕
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ នគ បាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ បាន បញ្ជូន ខ្លូន ជនសង្ស័យ ឈ្មោះ សេង សុភ័ក្រត្រា អាយុ ៤៧ ឆ្នាំ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម ច្បាប់ ពាក់ ពន្ធ័ករណី ធ្វើ សកម្មភាព គំរាម សម្លាប់ . គំរាម ហែក កេរ្ដិ៍ . ប្រើប្រាស់ អាវុធ ខុស ច្បាប់ និង ឆបោក ។
កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន ចាប់ខ្លួន បុរស នះ កុរោយ បន្លំ ជា នគរបាល ពាក់ ផ្កាយ ពីរ នៅ ក្រសួង មហាផ្ទៃ ហើយ ធ្វើ សកម្មភាព គំរាម សម្លាប់ . គំរាម ហែក កេរ្ដិ៍ . ប្រើប្រាស់ អាវុធ ដោយ ខុស ច្បាប់ និង ឆបោក ។ ការឃាត់ ជនសង្ស័យ រូប នេះ បាន ធ្វើឡើង កាលពី ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នៅ សង្កាត់ ជ្រោយចង្វារ ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។
ជនសង្ស័យ ដែល កម្លាំង នគរបាល ជំនាញ ឃាត់ខ្លួន ឈ្មោះ សេង សុភ័ក្រត្រា អាយុ ៤៧ ឆ្នាំ ។ ការឃាត់ខ្លួន នេះ ក៏ មាន ការសម្របសម្រួល នីតិវិធី ពី លោក កែវ សុធា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ផងដែរ ។
