( ភ្នំពេញ ) ៖ ឯកឧត្ដម ជា វ៉ាន់ ដេត រដ្ឋមន្ត្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ និង លោកជំទាវ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ ទាំងអស់ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ ផ្ញើ សារ រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល៖ ផ្លូវ ជាតិ លេខ ១១ សាងសង់ ត្រឹមត្រូវ តាម ស្ទង់ ដារ បច្ចេកទេស គ្រោង នឹង បញ្ចប់ នៅ ចុង ឆ្នាំ ២០២០ នេះ
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន បញ្ជាក់ ថា គម្រោង សាងសង់ ផ្លូវ ជាតិ លេខ ១១ តភ្ជាប់ ពី អ្នកលឿង ទៅកាន់ ថ្នល់ ទទឹង ខេត្ត ត្បូងឃ្មុំ ប្រវែង ៩៦ គីឡូម៉ែត្រ ដែល គ្រោង នឹង ចំណាយ ថវិកា សាងសង់ ប្រមាណ ៩៨ លាន ដុល្លារ គ្រោង នឹង បញ្ចប់ ការសាងសង់ នៅ ចុង ឆ្នាំ ២០២០ នេះ ជាមួយនឹង គុណភាព ក្នុង ការសាងសង់ បាន ត្រឹមត្រូវ តាម ស្ទង់ ដារ បច្ចេកទេស ដែល ក្រសួង បាន កំណត់ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង បញ្ជាក់ យ៉ាង ដូចនេះ នា ព្រឹក ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ ក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យមើល វឌ្ឍនភាព នៃ គម្រោង សាងសង់ ផ្លូវ ជាតិ លេខ ១១។
លោក ទេសរដ្ឋមន្ត្រី បាន បញ្ជាក់ ទៀត ថា ដើម្បី មើល ឱ្យ បាន ដឹង ច្បាស់ ពី គុណភាព ផ្លូវ នេះ ក្រុមការងារ បាន ឃួង ផ្លូវ មើល កំរាស់ កៅស៊ូ ដោយ មិន មាន ការ កំណត់ កន្លែង ទុក មុន នោះ ទេ ដោយ ជាក់ស្តែង គឺ មាន កំរាស់ កៅស៊ូ ត្រឹមត្រូវ តាម ស្ទង់ ដារ បច្ចេក ដែល ក្រសួង បាន កំណត់ ដោយ កន្លែង ខ្លះ មាន កំរាស់ លើស ការកំណត់ ថែម ទៀត ផង ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បញ្ជាក់ ទៀត ថា ចាប់ពី ពេលនេះ ទៅ ក្រសួង សាធារណការ នឹង លែង ឱ្យ មាន ផ្លូវ ដូច ដែល បងប្អូន ប្រជាពលរដ្ឋ លើកឡើង ថា ចាក់ ស្តើង ស៊ី ក្រាស់ ចាក់ ក្រាស ស៊ីស្តើង ទៀត ហើយ ដោយ នឹង ធ្វើ ផ្លូវ ឱ្យ មាន គុណភាព ឱ្យ បាន រឹងមាំ លែង ធ្វើ ផ្លូវ ជាប់ រហូត ទៀត ហើយ ។
លោក ទេសរដ្ឋមន្ត្រី បាន បញ្ជាក់ ទៀត ថា ផ្លូវ ខ្លះ ខូច មិន មែន ដោយសារតែ ការធ្វើ ផ្លូវ គ្មាន គុណភាព នោះ ទេ គឺ ដោយសារតែ ការដឹក ទំនិញ លើស ការកំណត់ ដោយ ច្បាស់ ដឹក ធ្ងន់ ពេក កន្លែង មាន ការសាងសង់ ផ្ទះ ខ្ពស់ ជាង ផ្លូវ ដែល ធ្វើឱ្យ ទឹក ដក់ នៅលើ ផ្លូវ ទើប ធ្វើឱ្យ ផ្លូវ ឆាប់ ខូច ដូចនេះ ហើយ ត្រូវតែ ចូលរួម គោរព ច្បាប់ ទាំងអស់ គ្នា កុំ ដឹក ទំនិញ លើស ការកំណត់ ទើប ធ្វើឱ្យ ផ្លូវ យើង អាច ជាប់ ប្រើប្រាស់ បាន យូរអង្វែង ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន គូសបញ្ជាក់ ទៀត ថា លោក នឹង នៅតែ បន្ត ចាត់ ឱ្យ ក្រុមការងារ ពិសេស ចុះ ត្រួតពិនិត្យ ការសាងសង់ ផ្លូវ ជា បន្ត ទៅ ទៀត ដោយ មិន ឱ្យ មាន ការ ដឹង ជាមុន ដើម្បី ធានា ឱ្យ បាន ថា ការសាងសង់ ផ្លូវ គឺ ត្រូវតែ ប្រកបដោយ គុណភាព និង ត្រឹមត្រូវ តាម ស្ទង់ ដារ បច្ចេកទេស ដោយ កន្លងមក ក៏ មាន ក្រុមហ៊ុន ខ្លះ សាងសង់ មិន ត្រឹមត្រូវ តាម ស្ទង់ ដារ បច្ចេក ត្រូវបាន ក្រសួង តម្រូវ ឱ្យ ធ្វើ ឡើងវិញ និង ត្រូវបាន ព្រមាន ជា បន្តបន្ទាប់ ផងដែរ ។
សូម បញ្ជាក់ ថា គម្រោង សាងសង់ ផ្លូវ ជាតិ លេខ ១១នេះ ជា ប្រភេទ ផ្លូវ ក្រាល បេតុង កៅស៊ូ AC កម្រាស់ ៥សង់ទីម៉ែត្រ លើកកម្ពស់ និង ពង្រីក ទទឹង ផ្លូវ ពី ៩ម៉ែត្រ ទៅ ១១ម៉ែត្រ ក្រាល ស្រទាប់ គ្រឹះ ទាំងលើ និង ទាំង ក្រោម កម្រាស់ ៦០សង់ទីម៉ែត្រ មាន ទិស ចរាចរណ៍ ចំនួន ២គន្លង ( ១ទៅ ១មក ) បំពាក់ ដោយ ផ្លាក សញ្ញា ចរាចរណ៍ គូស គំនូស ចរាចរណ៍ បង្គោល គីឡូម៉ែត្រ និង បង្គោល សុវត្ថិភាព តាម ដងផ្លូវ ផងដែរ ។
លោក រដ្ឋមន្ត្រី ស៊ុយ សែម សម្ពោធ ផ្លូវ ក្រាល គ្រួសារ ក្រហម ៤ខ្សែ ជាង ៣៣ គីឡូម៉ែត្រ និង ស្ពាន ដែក បាឡេ ៦កន្លែង ចំណាយ ជាង ៥៤ ម៉ឺន ដុល្លារ ក្នុង ស្រុក វាលវែង
លោក រដ្ឋមន្ត្រី ស៊ុយ សែម បាន ថ្លែង ថា ការសម្រេចបាន ជោគជ័យ ក្នុង ការស្តារ និង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន ខ្វាត់ ខ្វែង ប្រទាក់ ក្រឡា ដោយ រលូន ពី ទីប្រជុំជន រហូតដល ជនបទ ដែល ក្រសួង និង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ព្រមទាំង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ បាន អនុវត្ត កន្លងមក គឺ អាស្រ័យ ដោយ ការគាំទ្រ ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ចាត់ទុក ថា ហេដ្ឋារចនា សម្ព័ន្ធ ដឹកជញ្ជូន ជា វិស័យ អាទិភាព របស់ ជាតិ ។
ដូចនេះ ផ្លូវ លំ គ្រួស ក្រហម ៤ខ្សែ មាន ប្រវែង ៣៣ .២៧០ ម៉ែត្រ និង ស្ពាន ដែក ៦កន្លែង ដោយ ចំណាយ ថវិកា អស់ ជាង ៥៤ ម៉ឺន ដុល្លារ អាមេរិក នៅក្នុង ឃុំ ថ្ម ដា និង ឃុំ ក្រពើ ពីរ ស្រុក វាលវែង ដែល បាន សម្ពោធ នា ពេលនេះ គឺជា សមិទ្ធិផល ថ្មី មួយ ទៀត ព្រោះថា ផ្លូវ លំ ជនបទ គឺជា សរសៃ ឈាម សេដ្ឋកិច្ច ជាតិ ដ៏ មាន សក្តានុពល របស់ បងប្អូន ប្រជាពលរដ្ឋ រស់ នៅក្នុង តំបន់ នេះ ក៏ ដូច កងកម្លាំងប្រដាប់អាវុធ ដែល មាន ភារកិច្ច រក្សា ការពារ ខ្សែ បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ងាយស្រួល ក្នុង ដឹកជញ្ជូន កសិផល និង ធ្វើដំណើរ ជាដើម ។
នៅពេល ទទួលបាន នូវ សមិទ្ធិផល ទាំងនេះ សូម អាជ្ញាធរ និង ប្រជាពលរដ្ឋ ចូលរួម ជួយ ថែរក្សា ឱ្យ បាន គង់វង្ស យូរអង្វែង ជាមួយគ្នា នោះ ដែរ ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការការពារ បង្ការ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ដោយ អនុវត្ត ទៅ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ជាប្រចាំ ព្រមទាំង ចែកជូន វត្ថុ កំដរ ដៃ ដល់ អ្នកចូលរួម និង ឧបត្ថម្ភ ថវិកា ៤ពាន់ ដុល្លារ អាមេរិក ដល់ សាលា បឋមសិក្សា ក្រសាំង ភ្នៅ សម្រាប់ ជួសជុល សាលា ផងដែរ ៕
អ្នកតំណាងរាស្ត្រ មណ្ឌល ស្វាយរៀង ម៉ែន សំអន ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ មរណភាព របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី
( ភ្នំពេញ ) ៖ លោកជំទាវ កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន អ្នកតំណាងរាស្ត្រ មណ្ឌល ស្វាយរៀង និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ ផ្ញើ សារ រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
នាយ ឧត្ដមសេនីយ៍ អ៊ុយ សារិន ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ មរណភាព របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្ដមសេនីយ៍ អ៊ុយ សារិន អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ និង លោកជំទាវ ព្រមទាំង ក្រុមគ្រួសារ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ ផ្ញើ សារ រំលែក មរណទុក្ខ ដ៏ ក្រៀមក្រំ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
នាយ ឧត្តមសេនីយ៍ ឈុំ សុជាត ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ មរណភាព របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឈុំ សុជាត រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ក្រុមគ្រួសារ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ ឯកឧត្តម ត្រាក់ ថៃ សៀង និង លោកជំទាវ អុឹង កន្ថា ផាវី ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ ឧសភា ឆ្នាំ ២០២០
( ពោធិ៍សាត់ )៖ លោក ស្មាន ទៀត រដ្ឋលេខាធិការ ក្រសួង រ៉ែ និង ថាមពល ក្នុង នាម អនុប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ក្រគរ និង ស្រុក កណ្តៀង ខេត្ត ពោធិសាត់ អម ដំណើរ ដោយ លោក អភិបាល ស្រុក ក្រគរ លោក ប្រធាន គណបក្ស ស្រុក យុវជន ស .ស .យ . ក លោក មេឃុំ ព្រមទាំង ក្រុមការងារ បាន ចុះ ជួប និង សាកសួរ សុខទុក្ខ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែត ឥស្លាម និង ចែកជូន កញ្ចប់ អាហារ ស្រាយ បួស ពិសេស បាន ផ្សព្វផ្សាយ ពី វិធានការ ការពារ វីរុស កូវីដ១៩ ផងដែរ ។
ស្ថិត នៅក្នុង ជំនួប រវាង ក្រុមការងារ នឹង ពលរដ្ឋ នា ពេល ថ្មី ៗ កន្លងទៅ នេះ លោក ស្មាន ទៀត បាន លើកឡើង ថា ខែ រ៉ម៉ាឌន ជា ខែបួសដ៍ ពិសិដ្ឋ របស់ សាសនា ឥស្លាម ដែល តម្រូវ ដល់ គ្រប់ សាសនិក គ្រប់ អាយុ ប្រតិបត្តិ តម បួស អាហារ ខណៈ ស្រុក ទេស យើង កំពុង មាន សុខ សន្តិភាព សុវត្ថិភាព ការរីកចំរើន ឥត ឈប់ឈរ ក្រោម ម្លប់ សន្តិភាព ដ៍ កក់ក្ដៅ ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក ស្មាន ទៀត បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក រដ្ឋមន្ត្រី ស៊ុយ សែម និង លោក កែវ រតនៈ រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី អគ្គ នាយក អគ្គិសនី កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ក្រគ និង ស្រុក កណ្តៀង ផងដែរ ។
លោក ស្មាន ទៀត បាន ណែនាំ ដល់ ពលរដ្ឋ ទាំងអស់ សូម កុំ ធ្វេសប្រហែស នឹង វីរុស កូវីដ១៩ ឱ្យ សោះ ត្បិត វា មាន ភាពស្ងប់ស្ងាត់ មែន ពិត ប៉ុន្តែ ចូរ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ខ្ចាប់ ខ្ចួន ដើម្បី បញ្ជៀស ហានិភ័យ ណាមួយ កើតឡើង ជា យថាហេតុ ។
លោក ថា សូម ពលរដ្ឋ រស់ នៅ ស្អាត ហូប ស្អាត ផឹក ស្អាត ឧស្សាហ៍ លាង ដៃ នឹង សាប៊ូ ទឹក សម្លាប់ មេរោគ ឬ អាល់កុល ជេល អាល់កុល រក្សា គម្លាត ពី គ្នា និង ហាម ការជួបជុំ ណាមួយ ពិសេស សូម កុំ ទាន់ អាល ថ្វាយបង្គុំ រួមគ្នា នៅក្នុង វិហារ តែ អាច ថ្វាយបង្គុំ នៅ រួមគ្នា ជាមួយ ក្រុមគ្រួសារ នៅ តាម ខ្នង ផ្ទះ រៀង ៗ ខ្លួន បាន ៕ អភិបាល ខេត្ត ឧត្ដរ មានជ័យ ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ មរណភាព របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី
( ភ្នំពេញ ) ៖ ឯកឧត្តម ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្ដរ មានជ័យ និង លោកជំទាវ ព្រមទាំង មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ឧត្ដរ មានជ័យ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
អភិបាល ខេត្ត កំពង់ធំ ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ មរណភាព របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី
( ភ្នំពេញ ) ៖ ឯកឧត្ដម សុខ លូ អភិបាល ខេត្ត កំពង់ធំ និង លោកជំទាវ ព្រមទាំង មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
ក្រសួង ទេសចរ ណ៍៖ ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប នឹង ជំរុញ ឱ្យ ខេត្ត នេះ ក្លាយជា គោលដៅ ទេសចរណ៍ មាន ភាពប្រកួតប្រជែង ក្នុង តំបន់ និង ពិភពលោក
( កែប )៖ ខណៈ ការសិក្សា រៀបចំ ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប បាន និង កំពុង ដំណើរការ ជា បណ្ដើរ ៗ ហើយ នោះ ក្រសួង ទេសចរណ៍ បាន បង្ហាញ ការជឿជាក់ ថា ផែនការ មេ នេះ នឹង ជួយ ឱ្យ ខេត្ត កែប ក្លាយជា គោលដៅ ទេសចរណ៍ ធម្មជាតិ ស្ងប់ស្ងាត់ ប្រណីត កម្រិត ខ្ពស់ ប្រកបដោយ ភាពទាក់ទាញ និង ភាពប្រកួតប្រជែង នៅក្នុង តំបន់ និង ពិភពលោក ។
ការលើកឡើង នេះ ត្រូវបាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ ការរៀបចំ ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប ក្រោម អធិបតីភាព លោក ទិត ចន្ថា រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង ទេសចរណ៍ ក្នុង នាម តំណាង លោក រដ្ឋមន្ត្រី ថោង ខុន ព្រម ជាមួយ លោក ជា បូរ៉ា រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង លោក កែន សត្ថា អភិបាល ខេត្ត កែប នៅ សាលា ខេត្ត កែប នា ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ ។
លោក នី ផល្លី អនុ រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង ជា ប្រធាន លេខាធិការដ្ឋាន នៃ គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី សិក្សា រៀបចំ ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប បាន លើកឡើង ថា ដើម្បី គាំទ្រ ដល់ ការសិក្សា រៀបចំ ផែនការ មេអភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ ខេត្ត កែប នេះ កាលពី ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២០ រាជ រដ្ឋាភិបាល បាន បង្កើត គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី សិក្សា រៀបចំ ផែនការ មេ សម្រាប់ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ខេត្ត កែប និង ខេត្ត មណ្ឌលគិរី ។
លោក នី ផល្លី បាន បន្ត ថា ដំណើរការ នៃ ការសិក្សា រៀបចំ ផែនការ មេអភិវឌ្ឍ ន៍៍ ទេសចរណ៍ ខេត្ត កែប នេះ ត្រូវបាន ចាប់ អនុវត្ត តាំងពី ខែធ្នូ ឆ្នាំ ២០១៩ មក ម្ល៉េះ ហើយ ចាប់ពី ពេលនេះ តទៅ មុខ នឹង មាន ការចូលរួម ផ្ដល់ ធាតុ ចូល និង ផ្ដល់ ការគាំទ្រ ពីសំណាក់ រដ្ឋបាល ខេត្ត មន្ទីរ អង្គភាព ជំនាញ នៅ ថ្នាក់ ខេត្ត ដើម្បីឱ្យ ការរៀបចំ ផែនការ មេ នេះ មាន ភាព គ្រប់ ជ្រុងជ្រោយ និង ការទទួលខុសត្រូវ រួម ។
នា ឱកាស នោះ លោក ទិត ចន្ថា ក៏ បាន ណែនាំ ដល់ ក្រុមការងារ ដែល ចូលរួម សិក្សា រៀបចំ ផែនការ មេ នេះ ត្រូវ រួមគ្នា គិតគូរ ទាំង ភាពវិជ្ជមាន អវិជ្ជមាន និង ការគ្រប់គ្រង ហានិភ័យ ទៅ លើ ផ្នែក បរិស្ថាន ប្រព័ន្ធ ទឹក ស្អាត សំណង់ សូរិយោដី សាធារណការ និង ផ្នែក ពាក់ព័ន្ធ ដទៃ ទៀត សំដៅ ធ្វើឱ្យ ភ្ញៀវ ទេសចរ ដិត ជាប់ ការចងចាំ ចំណុច ពិសេស ៗ ក្រោយ បាន មក ទស្សនា ខេត្ត នេះ ។
ក្រសួង ទេសចរណ៍ ក៏ បាន ស្នើ ឱ្យ រដ្ឋបាល ខេត្ត កែប បង្កើត ក្រុមការងារ ជំនាញ មួយ ដើម្បី គាំទ្រ និង ចូលរួម ក្នុង ការសិក្សា ស្រាវជ្រាវ ជាមួយ ក្រុមការងារ ថ្នាក់ ជាតិ ដើម្បីឱ្យ ការរៀបចំ ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប នេះ សម្រេចបាន ប្រកបដោយ ភាពត្រឹមត្រូវ សមភាព តម្លាភាព និង ធានា បាន និរន្តរភាព ។
លោក កែន សត្ថា បាន បង្ហាញ ការគាំទ្រ ចំពោះ សំណើ របស់ ក្រសួង ទេសចរណ៍ និង បាន លើក សំណើ គម្រោង ផែនការ មួយចំនួន ដាក់បញ្ចូល ទៅក្នុង ផែនការ មេ ខាងលើ ដូចជា ការអភិវឌ្ឍ ឆ្នេរ ខ្សាច់ ទេសចរណ៍ ថ្មី ( ចាប់ពី ស្ថានីយ ចម្រោះ ទឹក កខ្វក់ រហូតដល់ ព្រៃ កោងកាង ) និង ឆ្នេរ ខ្សាច់ អង្កោល ស្ថិត ក្នុង ឃុំ អង្កោល ស្រុក ដំណាក់ ចង្អើរ ក៏ ដូចជា ការបង្កើត កំពង់ផែ ទេសចរណ៍ ខ្នាត តូច នៅ កោះ ទន្សាយ ការរៀបចំ ឱ្យ មាន កន្ត្រក ខ្សែ រ៉ក សម្រាប់ ឱ្យ ទេសចរ ជិះ លេង កម្សាន្ត ពី គោលដៅ ទេសចរណ៍ មួយ ទៅ គោលដៅ មួយ ទៀត ជាដើម ។
បើ តាម លោក នី ផល្លី សេចក្តីព្រាង ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប នេះ គ្រោង នឹង បញ្ចប់ នៅ ដំណាច់ ខែកក្កដា ឆ្នាំ ២០២០ ហើយ អាចនឹង ដាក់ ឆ្លង កិច្ចប្រជុំ គណៈកម្មការ អន្តរ ក្រសួង នា ខែសីហា ឆ្នាំ ២០២០ ខាងមុខ នេះ ។ បន្ទាប់ពី មាន ការកែសម្រួល ឬ មាន ការសម្រេច ឯកភាព ពី ប្រមុខ រាជ រដ្ឋាភិបាល ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត កែប នេះ នឹង ត្រូវ យកមក អនុវត្ត ចាប់ពី ឆ្នាំ ២០២១ ដល់ ឆ្នាំ ២០៣៥ និង អាច មាន ការពិនិត្យ កែសម្រួល សម្រាប់ ការអនុវត្ត នៅ ឆ្នាំ បន្តបន្ទាប់ ទៀត ៕
ឯកឧត្តម ស្វាយ សំអ៊ាង ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចំពោះ មរណភាព របស់ អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី
( ភ្នំពេញ ) ៖ ឯកឧត្តម ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី និង លោកជំទាវ ព្រមទាំង មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ឧប នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង លោកជំទាវ ព្រមទាំង មន្រ្តី ក្រោម ឱវាទ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ សារ រំលែក មរណទុក្ខ សូម គោរព ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ក្រុមគ្រួសារ នៃ សព អ្នក ឧកញ៉ា ព្រឹទ្ធ មហា ឧបាសិកា ធម្មញ្ញាណ វិវឌ្ឍនា ប៊ុន ស៊ាង លី ។
គួរ បញ្ជាក់ ថា រដ្ឋាភិបាល នូវែលសេឡង់ បាន ទម្លាក់ កម្រិត ភាពអាសន្ន ពី លេខ ៤ មក នៅ ត្រឹម លេខ ៣ កាលពី ថ្ងៃអង្គារ សប្ដាហ៍ មុន ហើយ សម្រាប់ កម្រិត លេខ ៣ នេះ នឹង នៅតែ បន្ត មាន សុពលភាព រយៈពេល យ៉ាងតិច ០២ សប្ដាហ៍ រហូតដល់ មាន ការសម្រេចចិត្ត ជាថ្មី នៅ ថ្ងៃទី ១១ ខែឧសភា ៕
( ភ្នំពេញ ) ៖ លោក វ៉ង អ៊ី ប្រធាន ក្រុម សង្គ្រោះ ប្រចាំ ខេត្ត គួយ ចូវ របស់ អង្គការ សង្គ្រោះ មេឃ ពណ៌ ខៀវ ប្រទេស ចិន បាន បញ្ជាក់ ជំហរ យ៉ាង ច្បាស់ ថា ជា កណ្យាណ មិត្ត ជួយ គ្នា ក្នុង គ្រា ក្រ យើង ស្ម័គ្រចិត្ត ប្រកបដោយ ឆន្ទៈ ក្នុង ការប្រើប្រាស់ នូវ អាជីព បទពិសោធន៍ ប្រកបដោយ វិជ្ជាជីវៈ ដើម្បី ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា និង ប្រជាជន កម្ពុជា ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ការរាតត្បាត ជសកល នៅ កម្ពុជា នៃ ជំងឺ COVID-19 ។
លោក កឹម រដ្ឋ វិសិដ្ឋ បាន បន្ត ថា តាមរយៈ ការចូលរួម បំពេញ បេសកកម្ម នេះ គឺ ឆ្លុះបញ្ចាំង ពី ការចូលរួម ទទួលខុសត្រូវ នឹង ការចែករំលែក បទពិសោធន៍ ក្នុង កម្រិត អន្តរជាតិ ជាពិសេស នៅ តា ដង ផ្លូវ សូត្រ ដែល ជា គំនិត ផ្តួចផ្តើម មួយ ក្នុង ការកសាង សហគមន៍ នៅ តាម ដងផ្លូវ សូត្រ ហើយ បេសកកម្ម នេះ នឹង បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ដល់ ការលុបបំបាត់ ការទប់ស្កាត់ ជំងឺ COVID-19 នៅ កម្ពុជា ផងដែរ ។
បន្ថែម ពី នេះ លោក កឹម រដ្ឋ វិសិដ្ឋ បាន បញ្ជាក់ ថា ការបំពេញ បេសកកម្ម របស់ ក្រុម អ្នកជំនាញ ស្ម័គ្រចិត្ត ចំនួន ១០រូប មក ពី អង្គការ សង្គ្រោះ មេឃ ពណ៌ ខៀវ នៅ កម្ពុជា រយៈពេល ១៥ ថ្ងៃ គឺជា ការចែករំលែក បទពិសោធន៍ របស់ មិត្ត ចិន ដែល ធ្លាប់ ពើបប្រទះ នឹង ជំងឺ ដ៏ កាច សាហាវ នេះ មុន គេ បង្អស់ ព្រមទាំង ទទួលបាន ជោគជ័យ ក្នុង ការទប់ស្កាត់ និង ការព្យាបាល ជំងឺ នេះ រហូត មាន ស្ថានភាពធូរស្រាល ជាខ្លាំង ផងដែរ ។
