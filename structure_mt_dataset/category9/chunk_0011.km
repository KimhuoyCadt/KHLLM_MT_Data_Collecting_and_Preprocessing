( ព្រៃវែង ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ បាន ចុះ ទៅ ជួប សាកសួរ សុខទុក្ខ កម្មករ ពលករ ចំណាកស្រុក និង ប្រជាពលរដ្ឋ មកពី ភូមិ ទាំង ១៨ ក្នុង ឃុំ ដែល បាន មក ជួបជុំ ប្រមូលផ្តុំ គ្នា នៅ ៥កន្លែង ផ្សេង គ្នា សរុប ចំនួន ១១០ នាក់ តំណាង ឱ្យ គ្រួសារ ជួប ការលំបាក ដោយសារ ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ១៩ ។
ការចុះ សាកសួរ សុខទុក្ខ នេះ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ដោយ មាន ការ អម ដំណើរ ពីសំណាក់ រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ និង សហការី ប្រធាន ក្រុមប្រឹក្សា និង អភិបាល ស្រុក ព្រមទាំង លោកស្រី អស់ លោក ក្នុង ក្រុមការងារ ចុះ ជួយ ឃុំ ធាយ និង ស្រុក បាភ្នំ ។
ក្នុង ពេល ជួប សំណេះសំណាល លោក រដ្ឋមន្ត្រី និង ជា ប្រធាន ក្រុមការងារ បាន លើកឡើង កោតសរសើរ ចំពោះ ការខិតខំ ប្រឹងប្រែង ដោយ ផ្ទាល់ របស់ បងប្អូន កម្មករ ពលករ ចំណាកស្រុក និង ក្រុម ញាតិ គ្រួសារ របស់ ខ្លួន រួម ជាមួយ ការជ្រោមជ្រែង ជាប្រចាំ របស់ ក្រុមការងារ និង អាជ្ញាធរ មូលដ្ឋាន ដែល បាន ពុះពារ ការលំបាក ជម្នះ រាល់ បញ្ហា ប្រឈម ជា ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ១៩ ។
ទោះបីជា មាន ចលនា របស់ ប្រជាពលរដ្ឋ ចំណាកស្រុក ចេញ ចូល មូលដ្ឋាន ជា បន្តបន្ទាប់ អាស្រ័យ ដោយ ស្ថានភាពមុខរបរ និង ការងារ ហើយ ពេល ខ្លះ ទៀត តម្រូវ ឱ្យ មាន ការ ធ្វើចត្តាឡី ស័ក ចំពោះ បងប្អូន ដែល ទើប ត្រឡប់ ពី ក្រៅ ប្រទេស ក៏ដោយ ក្តី ប៉ុន្តែ លើ ការជាក់ស្តែង ការខិតខំ ប្រឹងប្រែង រួម នេះ បាន រួមចំណែក យ៉ាង សំខាន់ ទប់ស្កាត់ មិន ឱ្យ ជំងឺ ដ៏ កាច សាហាវ នេះ ឆ្លង ចូលក្នុង សហគមន៍ បាន ឡើយ ។
ក្នុង ឱកាស នោះ ដែរ លោក រដ្ឋមន្ត្រី និង ក្រុមការងារ ក៏ បាន ជូន អំណោយ មួយចំនួន ដល់ ប្រជាពលរដ្ឋ រួម មាន អង្ករ មី ទឹកត្រី ទឹកស៊ីអ៊ីវ អំបិល ទឹក សុទ្ធ ម៉ាស ពាក់ មុខ សាប៊ូ លាង ដៃ និង ថវិកា មួយ ចំនួន ផង ៕
ប្រធាន មន្ទីរ រៀបចំ ដែនដី ខេត្ត បន្ទាយមានជ័យ ក្រើន រំឮក ដល់ មន្ត្រី ឱ្យ ចៀសវាង យក ឧបករណ៍ ឬ ម៉ាស៊ីន ទៅ វាស់វែង ដី លក្ខណៈ ឯកជន ដើម្បី ផលប្រយោជន៍ ផ្ទាល់ខ្លួន
( បន្ទាយមានជ័យ )៖ លោក អាង ណារិទ្ធ ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត បន្ទាយមានជ័យ បាន ក្រើន រំលឹក ដល់ មន្ត្រី នៅពេល ចុះ វាស់វែង ដី តំបន់ ណាមួយ ត្រូវ មាន ការដាក់ពាក្យ ស្នើសុំ ទិដ្ឋការបញ្ជក់ ពី ការចុះ វាស វែង ចៀសវាង ការយក ឧបករណ៍ ឬ ម៉ាស៊ីន ទៅ វាស់វែង ដី ជា លក្ខណៈ ឯកជន ដើម្បី ផលប្រយោជន៍ ផ្ទាល់ខ្លួន ដែល អាច ធ្វើឱ្យ មាន ផល ប៉ះពាល់ ផ្សេង ៗ ដូច ជា៖ តំបន ដី ហាមឃាត់ ឬ ដី ទំនាស់ ជាដើម ដែល អាច នាំឱ្យ មាន បញ្ហា ផ្សេង ៗ ។
ការក្រើន រំឮក បែប នេះ របស់ លោក អាង ណារិទ្ធ បាន ធ្វើឡើង នា ឱកាស បើក កិច្ចប្រជុំ ស្តីពី « ការពិនិត្យ វឌ្ឍនភាព ការងារ ចុះបញ្ជី ដីធ្លី មាន លក្ខណៈ ជា ប្រព័ន្ធ » ប្រព្រឹត្ត ក្រោម វត្តមាន លោក លី សារី អភិបាល រង ខេត្ត បន្ទា មានជ័យ នា ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០២០ ម្សិលមិញ ។
លោក អាង ណារិទ្ធ បាន ឱ្យដឹង ថា បច្ចុប្បន្ន នេះ ក្រុមការងារ ចុះបញ្ជី មាន លក្ខណៈ ជា ប្រព័ន្ធ ក្នុង ខេត្ត បន្ទាយមានជ័យ មាន ចំនួន ៧ក្រុម ដែល អនុវត្ត ការងារ លើ ៩ក្រុង - ស្រុក នៅ ទូទាំង ខេត្ត ។
ជាមួយគ្នា នេះ ដែរ ប្រធាន មន្ទីរ រូប នេះ ក៏ បាន សង្កត់ធ្ងន់ ថា រាល់ ការចុះ វាស់វែង ដីធ្លី ក្តី ត្រូវ កំណត់ ទីតាំង ឱ្យ បាន ច្បាស់ ថា ត្រូវ មាន ឯកសណ្ឋាន ឱ្យ បាន ត្រឹមត្រូវ ហើយ បើ យក ឧបរកណ៍ ទៅ វាស់វែង ដី ឯកជន ដោយ គ្មាន ច្បាប់ អនុញ្ញាត មន្ត្រី នោះ ត្រូវ ទទួលខុសត្រូវ ខ្លួន ឯង ។
លោក លី សារី ក៏ បាន ថ្លែង ការកោតសរសើរ ដល់ មន្ត្រី ភូមិបាល ដែល កន្លងមក បាន ខិតខំ បំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន បាន យ៉ាង ល្អ លើ កិច្ចការងារ ចុះបញ្ជី ដីធ្លី លក្ខណៈ ជា ប្រព័ន្ធ ជូន ដល់ ប្រជាពលរដ្ឋ ។
ទន្ទឹម នឹង នោះ លោក អភិបាល រង ខេត្ត ក៏ បាន ជំរុញ លើកទឹកចិត្ត ដល់ មន្ត្រី ភូមិបាល ត្រូវ បន្ត ចុះបញ្ជី ដីធ្លី ជូន ពលរដ្ឋ បន្ត ទៀត ដើម្បីឱ្យ ពួកគាត់ ទទួលបាន ឯកសារ កាន់ ពេញលេញ និង ចាត់ចែង តាម តម្រូវការ របស់ ពួកគាត់ ៕ ខួប ៧៥ ឆ្នាំ ថ្ងៃ កំណើត នគរបាល ជាតិ ! សន្តិ បណ្ឌិត សុខ ផល អបអរសាទរ ជូន នាយ ឧត្តមសេនីយ៍ នេត សាវឿន និង នគរបាល ទូទាំង ប្រទេស
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស អបអរសាទរ ទិវា ខួប អនុស្សាវរីយ៍ លើក ទី ៧៥ ថ្ងៃបដិសន្ធិ កងកម្លាំង នគរបាល ជាតិ . សន្តិ បណ្ឌិត សុខ ផល រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ បាន ចូលរួម អបអរសាទរ និង ជូនពរ ទៅកាន់ អគ្គ ស្នងការ នគរបាល ជាតិ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន និង កម្លាំង នគរបាល ជាតិ ទូទាំង ប្រទេស ។
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ សន្ដិ បណ្ឌិត សុខ ផល ដែល ជា អតីត មន្រ្តី នគរបាល ជាន់ ខ្ពស់ មួយ រូប បាន លើកទឹកចិត្ត និង សំណូមពរ កងកម្លាំង នគរបាល ជាតិ គ្រប់ ផែន ជំនាញ គ្រប់ ថ្នាក់ នៅ ទូទាំង ប្រទេស បន្ដ នូវ វីរភាព អង់អាច ក្លាហាន លើកកម្ពស់ ស្មារតី ស្នេហាជាតិ ។
លោក បាន បញ្ជាក់ ទៀត ថា នគរបាល ជាតិ ទាំងអស់ ត្រូវ បន្ដ រួមគ្នា រក្សា ឲ្យបាន នូវ សន្ដិភាព ការពារ ឯករាជ្យ អធិបតេយ្យ ជាតិ បូរណភាព ទឹកដី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ការពារ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ និង ប្ដេជ្ញា មិន ឲ្យ មាន រចនាសម្ព័ន្ធ និង សកម្មភាព បដិវត្តន៍ ពណ៌ កើតមាន សារជាថ្មី លើកទឹកចិត្ត កម្ពុជា ជាដាច់ខាត ។
លោក បាន គូស រំលេច ថា ការរៀបចំ ប្រារព្ធ ខួប អនុស្សាវរីយ៍ លើក ទី ៧៥ ថ្ងៃ កំណើត នគរបាល ជាតិ កម្ពុជា មាន អត្ថន័យ សំខាន់ ៗ ពីរ សំខាន់ រួម មាន៖
* ទី១៖ ដើម្បី ឧទ្ទិស រំលឹក ដល់ ស្នា ព្រះហស្ថ និង គុណូបការៈ របស់ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្តម សីហនុ ព្រះមហា វីរក្សត្រ « ព្រះបរម រតន កោដ្ឋ » ដែល ព្រះអង្គ បាន បង្កើត អង្គ ប្រតិបត្តិ ច្បាប់ នេះ ក្នុង ព្រះរាជ បំណង ធានា ស្ថិរភាព សន្តិសុខ សណ្ដាប់ធ្នាប់ សង្គម ។* ទី២៖ គឺជា ការរំឭក ការចងចាំ នូវ ដំណើរ ឆ្លងកាត់ ជា ប្រវត្តិសាស្ត្រ របស់ រៀមច្បង នៃ កងកម្លាំង នគរបាល ជាតិ គ្រប់ ជំនាន់ ក្នុង បុព្វហេតុ សន្តិសុខ ជាតិ និង ភាពសុខសាន្ត របស់ ប្រជាពលរដ្ឋ ។
( ប៊ែរឡាំង ) ៖ ហាង កាហ្វេ មួយ នៅ ប្រទេស អាល្លឺម៉ង់ បាន ប្រារព្វ ពិធី បើក ហាង របស់ ខ្លួន ឡើងវិញ ជូន អតិថិជន ដោយ តម្រូវឲ្យ អ្នកចូលរួម ទាំងអស់ ពាក់ មួក ម្យ៉ាង នៅលើ ក្បាល ដើម្បី រក្សា គម្លាត សុវត្ថិភាព ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNN នា រសៀល ថ្ងៃសៅរ៍ ទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ ។
ម្ចាស់ ហាង ខាងលើ បាន បង្ហោះ រូបថត មួយ សន្លឹក នៅលើ ប្រព័ន្ធ ទំនាក់ទំនង សង្គម ដោយ មាន អម ជាមួយ សំណេរ មួយ ឃ្លា យ៉ាង ដូច្នេះ ថា « ថ្ងៃ នេះ វិធានការរក្សា គម្លាត សុវត្ថិភាព គឺ បែប ហ្នឹង ឯង » ។
យោង តាម វីដេអូ ដែល ផលិត ដោយ អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស បាន បញ្ជាក់ ថា វីដេអូ នេះ មាន រយៈពេល ១៩នាទី ៣៩ វិនាទី ។ សូម ទស្សនា វីដេអូ ដែល មាន អត្ថន័យ និង ខ្លឹមសារ ទាំង ស្រុង៖ អភិបាល ខណ្ឌ ចំការមន ណែនាំឲ្យ ពលរដ្ឋ កុំ មាន ការធ្វេសប្រហែស នឹង ជំងឺ COVID-19 និង ស្តាប់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល បន្ត ទៀត
លោក ថេង សុថុល បាន លើកឡើង បែប នេះ ក្នុង ពេល អញ្ជើញ ចុះ សួរសុខទុក្ខ សំណេះសំណាល ផ្សព្វផ្សាយ បិទ ខិត បណ្ណ ពី ការបង្ការ ជំងឺ Covid-19 ជូន ប្រជាពលរដ្ឋ តាម ខ្នង ផ្ទះ ដែល រស់ នៅ តាម បណ្តោយ ប្រឡាយ លូ បឹងត្របែក ស្ថិត ក្នុង ភូមិ ៥ សង្កាត់ ផ្សារ ដើម ថ្កូវ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ព្រឹក ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ។
លោក ថេង សុថុល ក៏ បាន ណែនាំ ដល់ ប្រជាពលរដ្ឋ ត្រូវតែ បន្ត យកចិត្តទុកដាក់ ថែរក្សា សុខភាព កុំ មើល ស្រាល ចំពោះ ស្ថានភាព នៃ ជំងឺ ឆ្លង ជាដាច់ខាត បើ ទោះបីជា រយៈកាល ចុងក្រោយ នេះ ក្រសួង សុខាភិបាល មិន មាន រកឃើញ អ្នកជំងឺ ឆ្លង ថ្មី ក៏ដោយ ហើយ ត្រូវ ស្តាប់ ការចាក់ ផ្សព្វផ្សាយ តាម មេក្រូ នៅក្នុង ភូមិ សង្កាត់ នា សព្វ ថ្ងៃ នេះ ត្រូវ ថែរក្សា អនាម័យ និង បរិស្ថាន កន្លែង ស្នាក់ នៅ ត្រូវ ប្រកាន់ភ្ជាប់ ការរស់នៅ ស្អាត ហូប ស្អាត ជាពិសេស អនាម័យ ចំពោះ កុមារ តូច ៗ ផងដែរ ។
ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីប្រកាស ថា អ្នកជំងឺ COVID-19 ម្នាក់ ចុងក្រោយ គេ ពោលគឺ អ្នកជំងឺ ទី១២២ បាន ជាសះស្បើយ ដែល ធ្វើឲ្យ ប្រទេស កម្ពុជា ក្លាយជា ប្រទេស គ្មាន អ្នកជំងឺ កូវីដ១៩ ទៀត ទេ ។
ក្នុង ឱកាស ចុះ សំណេះសំណាល អភិបាល ខណ្ឌ ចំការមន លោក ថេង សុថុល ក៏ បាន នាំយក អំណោយ បន្តិចបន្តួច សំរាប់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៦០ គ្រួសារ ដែល ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ស្ករ ស ទឹកត្រី អំបិល ទឹកត្រី សាប៊ូ ម៉ាស ផងដែរ ៕
ពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ ៤០ គ្រួសារ នៅ ស្រុក បន្ទាយ អំពិល ទទួលបាន អំណោយ មនុស្សធម៌ ពី កាកបាទ ក្រហម កម្ពុជា
( ឧត្តរមានជ័យ ) ៖ យ៉ាងហោចណាស់ មាន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ខ្យល់ កន្ត្រាក់ បណ្តាលឲ្យ រលំ ផ្ទះ និង របើក ដំបូល ចំនួន ៤០ គ្រួសារ រស់ នៅ ស្រុក បន្ទាយ អំពិល ខេត្ត ឧត្តរមានជ័យ ទទួលបាន អំណោយ មនុស្សធម៌ ពី កាកបាទ ក្រហម កម្ពុជា ។
ពិធី ប្រគល់ អំណោយ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ក្រោម វត្តមាន លោក ឃិន ញ៉ាណ អភិបាល រង ខេត្ត ឧត្តរមានជ័យ និង ជា អនុប្រធាន អចិន្ត្រៃយ៍ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត និង ក្រុមការងារ តំណាង លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ និង ជា ប្រធាន គណៈកម្មការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ។
ជាមួយគ្នា នោះ ដែរ លោក ឃិន ញ៉ាណ ក៏ បាន ណែនាំឲ្យ ប្រជាពលរដ្ឋ កុំ អស់សង្ឃឹម ផ្ទុយទៅវិញ ត្រូវ ខិតខំ ធ្វើ ការងារ តាមរបរ រៀង ៗ ខ្លួន ដើម្បី លើកស្ទួយ ជីវភាព គ្រួសារ ។ លោក បញ្ជាក់ ថា ថ្វីត្បិតតែ ជំងឺ កូវីដ១ ៩ត្រូវបាន គ្រូពេទ្យ បាល ជាសះស្បើយ ១២២ ក៏ដោយ ក៏ ត្រូវ បន្ត ចូលរួម ទប់ស្កាត់ ការពារ ជំងឺ កូវីដ១៩ នេះ ជានិច្ច ដែរ ដោយ មិន ត្រូវ ប្រហែស ឡើយ ពោល គី ត្រូវ អនុវត្ត ឲ្យបាន តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕
( ភ្នំពេញ ) ៖ ស្រ្តី ម្នាក់ ឈ្មោះ លាន វ៉ារី ដែល ពាក់ព័ន្ធ អំពើ រឆ បោក និង ចេញ សែក គ្មាន សាច់ប្រាក់ ជាង ៦ម៉ឺន ដុល្លារ ត្រូវបាន កម្លាំង រាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ឃាត់ខ្លួន កាលពី ម៉ោង ១២ ថ្ងៃត្រង់ ទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នៅក្នុង បុរី ពិភព ថ្មី ចំការ ដូង ២ ស្ថិត ក្នុង ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
ការឃាត់ខ្លួន ស្ត្រី សង្ស័យ រូប នេះ ធ្វើឡើង តាម ដីការបញ្ជា របស់ តំណាង អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ និង តាម បណ្តឹង របស់ ជនរងគ្រោះ ឈ្មោះ អ៊ុច រចនា ។ សមត្ថកិច្ច អាវុធហត្ថ បាន និង កំពុង កសាង សំណុំរឿង និង ត្រៀម បញ្ជូន ទៅកាន់ តុលាការ ដើម្បី ចាត់ការ តាម ច្បាប់ ។
យោង តាម ការផ្សព្វផ្សាយ របស់ ក្រសួង យុត្តិធម៌ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន ឲ្យដឹង ថា សំណើ នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ រួមទាំង សហការី បាន ចូល ជួប ពិភាក្សា ការងារ ជាមួយ ប្រធាន អង្គភាព ប្រឆាំង អំពើពុករលួយ នៅ រសៀល ថ្ងៃសុក្រ ទី ១៥ ខែឧសភា ឆ្នាំ ២០២ នៅ ទីស្តីការ អង្គភាព ប្រឆាំង អំពើពុករលួយ ។
ក្រសួង យុត្តិធម៌ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ឯកឧត្តម កើត រិទ្ធ រួមទាំង សហការី បាន ចូល ជួប ពិភាក្សា ការងារ ជាមួយ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ឱម យ៉ិនទៀង អំពី យុទ្ធនាការ ដោះស្រាយ ការកកស្ទះ សំណុំរឿង នៅ តាម សាលាដំបូង រាជធានី - ខេត្ត ដែល នឹង ប្រកាស ដំណើរការ នៅ ដើម សប្តាហ៍ ក្រោយ នេះ និង ស្នើសុំ កិច្ចសហការ ជាមួយ អង្គភាព ប្រឆាំង អំពើពុករលួយ ក្នុង ដំណើរការ នៃ ការអនុវត្ត យុទ្ធនាការ ដោះស្រាយ ការកកស្ទះ សំណុំរឿង នៅ តាម សាលាដំបូង រាជធានី - ខេត្ត » ។
សូម បញ្ជាក់ ថា លោក កើត រិទ្ធ នឹង ប្រកាស បើក យុទ្ធនាការ ដោះស្រាយ ការកកស្ទះ សំណុំរឿង នៅ តាម សាលាដំបូង រាជធានី - ខេត្ត នៅ វេលា ម៉ោង ៨៖៣០ ព្រឹក ថ្ងៃទី ១៨ ខែឧសភា ឆ្នាំ ២០២០ ខាងមុខ នេះ នាទី ស្តីការ ក្រសួង យុត្តិធម៌ ។ ក្រោយ ពិធី ប្រកាស បើក យុទ្ធនាការ នេះ លោក នឹង ធ្វើ សន្និសីទ សារព័ត៌មាន មួយ ដើម្បី បង្ហាញ អំពី គោលបំណង និង វិធានការ មួយចំនួន នៃ យុទ្ធនាការ ដោះស្រាយ ការកកស្ទះ សំណុំរឿង នៅ តាម សាលាដំបូង រាជធានី - ខេត្ត ។
រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ កាលពី ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២០ បាន សម្រេច បង្កើត គណៈកម្មការ ដឹកនាំ យុទ្ធនាការ ដោះស្រា ការកកស្ទះ សំណុំរឿង នៅ តាម សាលាដំបូង រាជធានី - ខេត្ត ដែល មាន ភារកិច្ច រួម មាន៖
បើ ក្រឡេក ទៅ លើ បណ្តា កោះ ដែល វៀតណាម កាន់កាប់ នៅ ទីប្រជុំ កោះ ស្ព្រាតលី (Spartly) នៃ សមុទ្រ ចិន ខាងត្បូង គឺ មិន ទំនង ធ្វើជា មូលដ្ឋាន ផ្គត់ផ្គង់ ឬ ទីតាំង ឆ្លងកាត់ សម្រាប់ នាវា របស់ កងទ័ព ជើងទឹក អាមេរិក នោះ ឡើយ ដោយសារ ការខ្វះខាត ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ ហើយ ពួកវា ស្ថិត នៅក្បែរ ៗ នឹង បណ្តា កោះ សិប្បនិម្មិត របស់ ចិន ដែល ពោរពេញ ដោយ សព្វាវុធ ថែម ទៀត ។
យោង តាម ការវិភាគ ដដែល គោល នយោបាយ របស់ វៀតណាម ទំនងជា នឹង នៅ ដដែល គឺ ផ្តោត ទៅ លើ ការផ្សារ ភ្ជាប់ ទំនង ជាមួយ បណ្តា ប្រទេស មហា អំណាច ដោយ មិន ប្រកាន់ យក ប្រទេស ណាមួយ ជា ធំ តែម្តង នោះ ឡើយ ពោលគឺ វៀតណាម នឹង មិន ទៅ ឈរ នៅ ខាង អាមេរិក ហើយ ងាក ទៅ ប្រឆាំង ចិន នោះ ទេ ។
ស្ដ្រី រូប នេះ បាន ថ្លែង ថា « ខ្ញុំ បាន ធ្វើតេស្ដ រក ជំងឺ កូវីដ១៩ នៅ ថ្ងៃទី ២៧ ខែមីនា ឆ្នាំ ២០២០ ពេល ចេញ នូវ លទ្ធផល ថា ខ្ញុំ វិជ្ជមាន ខ្ញុំ ពិតជា ស្លុតចិត្ដ ខ្លាំង ភ័យខ្លាច ណាស់ ដោយសារតែ ខ្ញុំ បាន ឃើញ ថា នៅ បណ្ដា ប្រទេស ជឿនលឿន លើ សកលលោក អ្នកជំងឺ កូវីដ១៩ នេះ មាន អ្នកស្លាប់ ច្រើន » ។
ប៉ុន្ដែ « ពេល ខ្ញុំ បាន ទទួល ព័ត៌មាន ថា នៅ កម្ពុជា យើង មិន មាន ករណី ស្លាប់ ដូច នៅ បណ្ដា ប្រទេស លើ សក លោក ហើយ ជាសះស្បើយ ជា បន្ដ បន្ទាប់ ធ្វើឱ្យ ខ្ញុំ មាន កម្លាំងចិត្ដ តតាំង ជាមួយ មេរោគ នេះ ជាង នោះ ទៅ ទៀត ពេល ដែល បាន មក ព្យាបាល ជាមួយ ក្រុម គ្រូពេទ្យ ( មន្ទីរពេទ្យ ខេត្ដ បន្ទាយមានជ័យ ) សុទ្ធតែ ជំនាញ ឆ្នើម ណាស់ ៗ មិន ចាញ់ ស្រុក គេ ជាពិសេស បាន ខិតខំ ព្យាបាល និង មើល ថែ ពួក ខ្ញុំ យ៉ាង យកចិត្ដ ទុក លើ ២៤ ម៉ោង » ។
ជា ប្រចាំ រាល់ អ្នកជំងឺ កូវីដ១៩ ទាំងអស់ គ្រូពេទ្យ ណែនាំ ឱ្យ ធ្វើ លំហាត់ប្រាណ ហូប ឆ្អែត ៗ ឆ្ងាញ់ ៗ និង សម្រាន ឱ្យ បាន ច្រើន មិន ឱ្យ ខ្វល់ខ្វាយ ឬ គិត ច្រើន ទេ ហើយ តែងតែ ជំរុញ លើកទឹកចិត្ដ និង ការថែទាំ ពី ក្រុម គ្រូពេទ្យ ជាប់ ជានិច្ច ។ នេះ បើ តាម ការបញ្ជាក់ របស់ ស្ដ្រី អាយុ ៣៦ ឆ្នាំ ខាងលើ នេះ ។
ក្នុង ឱកាស អ្នក ជា ពី ជំងឺ កូវីដ១៩ ចុងក្រោយ គេ ក្នុង ចំណោយ ១២២ នាក់ នៅ កម្ពុជា នេះ ត្រូវបាន ចេញ ពី មន្ទីរពេទ្យ មិត្ដភាព ខ្មែរ - សូវៀត នៅ ព្រឹក នេះ ក៏ មាន វត្ដមាន របស់ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង . ប្រធាន អង្គការ សុខភាព ពិភពលោក ប្រចាំ កម្ពុជា និង មន្ដ្រី ជាន់ ខ្ពស់ សុខាភិបាល រួមទាំង ក្រុម គ្រូពេទ្យ ជួរ មុខ បាន ចូលរួម អបអរសាទរ និង បន្ដ ណែនាំ វិធានការ ការពារ ពេល ទៅកាន់ គេហដ្ឋាន វិញ ផងដែរ ៕
លោក គុណ ញឹម ណែនាំ ដល់ អង្គការ បេសកកម្ម សុខុមាលភាព សង្គម កម្ពុជា កុំ បន្ធូរ ដៃ ក្នុង ការបង្ការ ជំងឺ កូវីដ ទោះបី កម្ពុជា អស់ អ្នក កើត ជំងឺ នេះ ក៏ដោយ
( ភ្នំពេញ ) ៖ គិត ថ្ងៃ ត្រឹម ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ កម្ពុជា បាន ព្យាបាល អ្នកជំងឺ កូវីដ ឱ្យ ជាសះស្បើយ អស់ ទាំង ១២២ នាក់ ហើយ ប៉ុន្តែ មិន មែន មាន ន័យ ថា កម្ពុជា រួចផុត ទុក្ខ ភ័យ ពី ការឆ្លង ជំងឺ នេះ នោះ ឡើយ ពោល ស្ថានភាព ប្រទេស នៅតែ ស្ថិត ក្នុង ភាពផុយស្រួយ និង អាច មាន រលក ទី២ នៃ ការឆ្លង ជំងឺ កូវី ដ ប្រសិនបើ ប្រជាពលរដ្ឋ គ្រប់ គ្នា បន្ធូរ ដៃ ក្នុង ការអនុវត្ត វិធាន អនាម័យ ប្រកបដោយ ការប្រុងប្រយ័ត្ន ខ្ពស់ ។
នេះ គឺជា ការផ្សព្វផ្សាយ របស់ លោក គុណ ញឹម ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ( អគរ ) ក្នុង ពេល លោក ដឹកនាំ មន្ត្រី នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ កុមារ កំព្រា នៅ អង្គការ បេសកកម្ម សុខុមាលភាព សង្គម កម្ពុជា ( ប.ស .ក ) ស្ថិត នៅក្នុង សង្កាត់ ទឹកល្អក់ ទី៣ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃសៅរ៍ ១០ រោច ខែពិសាខ ឆ្នាំ ជូត ទោស័ក ព .ស . ២៥៦៤ ត្រូវនឹង ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ ។
ថ្លែង ក្នុង ពិធី នេះ លោក គុណ ញឹម បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន និង កំពុង បន្ត អនុវត្ត យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ ១៩ ប្រកបដោយ ប្រសិទ្ធភាព ដោយ បាន ទប់ស្កាត់ ការឆ្លង រាតត្បាត ក្នុង សហគមន៍ និង បាន ព្យាបាល អ្នកជំងឺ ទាំង ១២២ នាក់ ឱ្យ ជាសះស្បើយ ទាំងស្រុង និង ពុំ មាន តួលេខ អ្នក ឆ្លង ថ្មី ក្នុង រយៈពេល ប៉ុន្មាន សប្តាហ៍ កន្លងមក នេះ ។
ប៉ុន្តែ ស្ថានការណ៍ នៃ ការរីករាលដាល ជំងឺ នេះ ស្ថិត ក្នុង ភាពផុយស្រួយ នៅឡើយ ទេ ដែល ទាមទារ ឱ្យ ពលរដ្ឋ គ្រប់ រូប រួមទាំង កុមារ កំព្រា និង បុគ្គលិក ទាំងអស់ ក្នុង អង្គការ ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ អនាម័យ ផ្ទាល់ខ្លួន នានា ដែល បាន ណែនាំ ដោយ ក្រសួង សុខាភិបាល ។
លោក គុណ ញឹម បាន បន្ត ថា ការឧបត្ថម្ភ ថ្ងៃ នេះ ជា ផ្នែក មួយ នៃ ការចូលរួម ទ្រទ្រង់ ដល់ កិច្ច ដំណើរការ ក៏ ដូចជា ការចូលរួម លើកទឹកចិត្ត ដល់ បុគ្គលិក ស្ម័គ្រចិត្ត និង កុមារ កំព្រា ដែល កំពុង បំពេញ ភារកិច្ច និង ស្នាក់ នៅ អង្គការ បេសកកម្ម សុខុមាលភាព សង្គម កម្ពុជា ( ប.ស .ក ) ដោយ អាច ដោះស្រាយ ការខ្វះខាត និង តម្រូវការ ជា មូលដ្ឋាន ផ្សេង ៗ របស់ ប.ស.ក បាន មួយ គ្រា ជាពិសេស ក្នុង គ្រា ដ៏ លំបាក នៃ ការរាត ត្បាត ជំងឺ កូវីដ ១៩ ដែល បាន និង កំពុង បង្ក ផល ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច របស់ កម្ពុជា និង ពិភពលោក ទាំងមូល ៕
សម្ដេច តេជោ ហ៊ុន សែន ផ្ញើ សារលិខិត ចូលរួម រំលែក មរណទុក្ខ ជូន លោកស្រី សួស ណារ៉ា ហ៊ឹម ឆែម ចំពោះ មរណភាព ទេសរដ្ឋមន្ត្រី ហ៊ឹម ឆែម (Video inside) ( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ រសៀល ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ សារលិខិត ចូលរួម រំលែក មរណទុក្ខ ជូន លោកស្រី សួស ណារ៉ា ហ៊ឹម ឆែម ចំពោះ មរណភាព ទេសរដ្ឋមន្ត្រី ហ៊ឹម ឆែម ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា អតីត រដ្ឋមន្ត្រី ក្រសួង ធម្មការ និង សាសនា ។
ក្នុង សារលិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « ខ្ញុំ និង ភរិយា មាន ក្ដី ខ្សឹកខ្សួល រំជួល ចិត្ត ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ថា ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ហ៊ឹម ឆែម ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា អតីត រដ្ឋមន្ត្រី ក្រសួង ធម្មការ និង សាសនា ទទួលមរណភាព នៅ ថ្ងៃសៅរ៍ ១០រោច ខែពិសាខ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៤ ត្រូវ នឹង ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ វេលា ម៉ោង ១០:៥៥ នាទី ព្រឹក ក្នុង ជន្មាយុ ៨២ ឆ្នាំ ដោយ រោគា ពាធ ។
ខ្ញុំ និង ភរិយា សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ ស ព ឯកឧត្តម ទេសរដ្ឋមន្ត្រី ហ៊ឹម ឆែម សូម ឆាប់ បាន ចាប់កំណើត កើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ក្លាយជា បការៈ ដទៃ ឡើយ ៕ ឃាត់ខ្លួន ជនសង្ស័យ ២នាក់ ប្តី ប្រពន្ធ ក្រោយ លួច ម៉ូតូ បាន សម្រេច នៅ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ ជនសង្ស័យ ២នាក់ ប្តី ប្រពន្ធ ត្រូវបាន សមត្ថកិច្ច ស្រាវជ្រាវ និង ឃាត់ខ្លួន ក្រោយពេល ពួកគេ ធ្វើ សកម្មភាព លួច កាច់ ក ម៉ូតូ របស់ ប្រជាពលរដ្ឋ ពេល ជិះ ទៅ ចូលរួម ក្នុង អាពាហ៍ពិពាហ៍ សាច់ញាតិ ។ ក្រោយពេល ឃាត់ខ្លួន ជនសង្ស័យ បាន សារភាព ថា ពួកគេ ពិតជា បាន ប្រព្រឹត្ត ដូច ជនរងគ្រោះ បាន ប្តឹង សមត្ថកិច្ច ពិតប្រាកដ មែន ។
ករណី ឃាត់ខ្លួន នេះ ធ្វើឡើង កាលពី រសៀល ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០២០ ខណៈ ដែល ពួកគេ បាន នាំគ្នា ជិះ ម៉ូតូ ខាងលើ មក បុណ្យ បងប្អូន នៅ ចំណុច ភូមិ ព្រៃ ស្រគុំ ឃុំ ស្យា ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ ។
ក្រោយមក ជនរងគ្រោះ ជា ម្ចាស់ ម៉ូតូ បាន ដាក់ ពាក្យ បណ្តឹង និង រាយការណ៍ ជូន សមត្ថកិច្ច និង ឈានដល់ ការស៊ើបអង្កេត ឃាត់ខ្លួន បាន មុខ សញ្ញា ( ពីរ នាក់ ត្រូវ ជា ប្តី ប្រពន្ធ ) នៅ វេលា ម៉ោង និង ទីតាំង កើត ហេតុ ខាង លើ ។
ក្រោយ ឃាត់ខ្លួន កម្លាំង សមត្ថកិច្ច បាន ត្រួតពិនិត្យ និង ឆែកឆេរ នៅក្រោម ពូក ម៉ូតូ ដោយ រកឃើញ មាន សោរ ម៉ូតូ ចំនួន ០៧ និង ទុលេវីស្ស ចំនួន ០២ ដើម រួច ក៏ ចាត់ បញ្ជូន ជនសង្ស័យ ( ពីរ នាក់ ត្រូវ ជា ប្តី ប្រពន្ធ ) មកកាន់ អធិការដ្ឋាន នគរបាល ស្រុក កណ្តៀង ដើម្បី ធ្វើ ការសាកសួរ និង បំពេញ បែបបទ ចាត់ការ តាម នីតិវិធី ៕ ស្មៀន សង្កាត់ អូរឫស្សី ខេត្ត ក្រចេះ ច្រានចោល ការចោទ ថា លោក យក គ្រឿងចក្រ ទៅ ឈូសឆាយ លើ ដី កំពុង មាន ទំនាស់
( ក្រចេះ ) ៖ លោក ធឹង រិទ្ធី ស្មៀន សង្កាត់ អូរឬស្សី ក្រុង - ខេត្ត ក្រចេះ បាន បដិសេធ ការចោទ ថា លោក ថ្លើមធំ ហ៊ាន យក គ្រឿងចក្រ ទៅ ឈូសឆាយ លើ ដី មាន ទំនាស់ មួយ កន្លែង ស្ថិត នៅ ភូមិ កាប៉ួ សង្កាត់ អូរឫស្សី ក្រុង ក្រចេះ ។
លោក បន្ត ទៀត ថា លោក បាន ទៅ កាយ ដី នោះ បាន មួយ ព្រឹក មិន ទាន់ បាន ដាក់ លូផង ស្រាប់តែ មាន សារព័ត៌មាន មួយចំនួន បាន ចុះផ្សាយ លោក ថា ថ្លើម ធំ ត្រឹម ស្មៀន សង្កាត់ សោះ ហ៊ាន លួច យក គ្រឿងចក្រ ទៅកាយ លើ ដី មាន ទំនាស់ ដោះស្រាយ មិន ទាន់ ចប់ ។
បើ តាម លោក ហ៊ឹម និមល ឪពុក របស់ លោក បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ១០៖ ៤៤ នាទី ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ហើយ សព កំពុង តម្កល់ ធ្វើ បុណ្យ តាម ប្រពៃណី នៅ គេហដ្ឋាន ក្នុង បុរី ប៉េង ហួត បឹង ស្នោ ខណ្ឌ ច្បារអំពៅ ។
សេចក្តីជូនដំណឹង ខាងលើ នេះ ចាត់ទុក ជា ការអញ្ជើញ ញាតិមិត្ត ជិត ឆ្ងាយ ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន រដ្ឋ នានា អញ្ជើញ ចូលរួម ពិធី បុណ្យ សព តាម សទ្ធា ជ្រះថ្លា ៕
តាមរយៈ សំណេរ នៅលើ គណនី Twitter ផ្លូវការ របស់ ខ្លួន លោក ដូណាល់ ត្រាំ បាន ធ្វើ លើកឡើង យ៉ាង ដូច្នេះ ថា « ខ្ញុំ មាន មោទនភាព ក្នុង ការប្រកាស ថា សហរដ្ឋ អាមេរិក នឹង បរិច្ចាគ ម៉ាស៊ីន ជួយ ការដកដង្ហើម ដល់ មិត្ត របស់ យើង នៅក្នុង ប្រទេស ឥណ្ឌា ។ យើង ឈរ ជាមួយ ប្រទេស ឥណ្ឌា និង លោក ណារិន ដ្រា ម៉ូឌី ក្នុង កំឡុង ពេល មាន ជំងឺ រាតត្បាត នេះ ។ យើង កំពុង សហការ គ្នា លើ ការអភិវឌ្ឍ វ៉ាក់សាំង ។ ពួកយើង នឹង យកឈ្នះ លើ ខ្មាំង សត្រូវ ដែល យើង មើល មិន ឃើញ នេះ ឲ្យបាន » ។
( កំពង់ធំ ) ៖ អគ្គ ស្នងការ នគរបាល ជាតិ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន បាន បញ្ជា ឱ្យ សមត្ថកិច្ច ជំនាញ ចាត់ វិធានការ ជាបន្ទាន់ តាម វិន័យ កងកម្លាំង នគរបាល ជាតិ និង តាម ច្បាប់ ជាបន្ទាន់ ទៅ លើ នាយ ការិយាល័យ ចរាចរណ៍ ផ្លូវគោក នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ធំ បន្ទាប់ពី មន្ត្រី នគរបាល រូប នេះ ស្រវឹង ស្រា បើក រថយន្ត បុក រនាំង រូបសំណាក លោក អាចារ្យលាក់ ហើយ ជេរ ប្រមាថ យ៉ាង ធ្ងន់ ៗ ទៅ លើ លោក អភិបាល ខេត្ត កំពង់ធំ ទៀតផង ។
យោង តាម របាយការណ៍ របស់ សមត្ថកិច្ច ខេត្ត បាន បញ្ជាក់ ថា មន្ត្រី នគរបាល ដែល ជា បក្ខពួក ហើយ បាន រំដោះ យក លោក រុំ សុវិជ្ជា ចេញ មិន ឲ្យ សមត្ថកិច្ច ក្រុង ស្រឹង សែន អនុវត្ត ច្បាប់ រួម មាន៖
អ្នក ដែល ឃើញ ហេតុការណ៍ នេះ បាន សំណូមពរ ដល់ សម្ដេច ក្រឡាហោម និង នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ មេត្តា ចាត់ វិធានការ ឱ្យ បាន ធ្ងន់ធ្ងរ ចំពោះ បុគ្គល នេះ ដើម្បី ជា គំរូ ដល់ មន្ត្រី ដទៃ ទៀត និង ដើម្បី ចូលរួម ការរឹតបន្ដឹង ការនុវត្តន៍ ច្បាប់ ចរាចរណ៍ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ថែម ទៀត ហើយ ការសូម ទោស ណាមួយ វា មិន អាច បំពេញ នូវ ទោស កំហុស របស់ ខ្លួន ដែល បាន ធ្វើ នោះ ឡើយ ៕
ក្រុមការងារ បក្ស ប្រជាជន ចុះ ជួយ ឃុំ បុស ខ្នុរ ស្រុក ចំការលើ ចុះ ពិនិត្យ ការសាងសង់ អគារ សិក្សា អំណោយ លោក ហ៊ុន ម៉ានិត និង ចែក អំណោយ ជូន ពលរដ្ឋ ក្រីក្រ មាន ជំងឺ ប្រចាំ កាយ
ថ្លែង ក្នុង ឱកាស នោះ លោក ងួន វិទូ បាន ក្រើន រំលឹក ដល់ ក្រុម ជាង ដែល កំពុង សាងសង់ អគារ សិក្សា នេះ ត្រូវ ផ្ដោត ការយកចិត្តទុកដាក់ ក្នុង ការសាងសង់ ដោយ ត្រូវ គិត លើ គុណភាព ជា ចម្បង និង ត្រូវ ធ្វើ អ្វី ទៅ តាម បទដ្ឋាន ដែល បាន កំណត់ ពោល ធ្វើ យ៉ាងណា ឲ្យ អគារ សិក្សា នេះ មាន គុណភាព ដើម្បី បម្រើ ដល់ ការសិក្សា បាន យូរអង្វែង ។
ជាមួយគ្នា នេះ លោក ងួន វិទូ ក៏ កោតសរសើរ ក្រុម ជាង ដែល សាងសង់ អគារ សិក្សា មួយ នេះ ដែល រក្សា អនាម័យ ដោយ មាន ពាក់ ម៉ាស់ ការពារ ត្រឹមត្រូវ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោក ងួន វិទូ និង ក្រុមការងារ ក៏ បាន បន្ដ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ជូន សមាជិក ក្រុមប្រឹក្សា ដែល មាន ជំងឺ និង ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ក្រីក្រ លំបាក និង មាន ជំងឺ ប្រចាំ កាយ ចំនួន ៤គ្រួសារ ផងដែរ ។
អនុប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ឃុំ បុស ខ្នុរ រូប នេះ ក៏ បាន ផ្ដាំផ្ញើ នូវ ការសាកសួរ ទុក្ខ ពី លោក ហ៊ុន ម៉ានិត និង លោក ឌួង ឧត្តម ព្រមទាំង ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ជូន សមាជិក ក្រុមប្រឹក្សា និង ប្រជាពលរដ្ឋ ក្រីក្រ ផងដែរ ។ លោក បាន បញ្ជាក់ ថា ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា មិន ដែល មើល រំលង ទុក្ខលំបាក របស់ សមាជិក ខ្លួន ឬ ប្រជាពលរដ្ឋ ណា ម្នាក់ នោះ ទេ ។
លោក ងួន វិទូ បាន ជម្រាប ឲ្យ សមាជិក ក្រុមប្រឹក្សា និង ប្រជាពលរដ្ឋ ត្រូវ ខិតខំ ថែរក្សា សុខភាព ដើម្បី ឆាប់ បាន ជាសះស្បើយ និង បន្ដ ប្រកប មុខរបរ របស់ ខ្លួន ប្រចាំ ថ្ងៃ ។ លើស ពី នេះ លោក បាន ផ្ដាំផ្ញើ ឲ្យ ពលរដ្ឋ ត្រូវ រក្សា អនាម័យ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដើម្បី ជៀស ឆ្ងាយ ពី ជំងឺ ផ្សេង ៗ ពិសេស ជំងឺ កូវីដ១៩ ៕
លោកស្រី ម៉ែន សំអន ផ្ដាំផ្ញើ ដល់ អាជ្ញាធរ និង ប្រជាពលរដ្ឋ ទាំងអស់ រួមគ្នា ប្រយុទ្ធ ប្រឆាំង ជំងឺ COVID-19 បន្ត ទៀត ទោះបី កម្ពុជា មិន មាន អ្នក ឆ្លង ថ្មី និង ជាសះស្បើយ ទាំងអស់ ក្តី
លោកស្រី ម៉ែន សំអន ថ្លែង បែប នេះ ខណៈ នាំ អំណោយ ផ្ដល់ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៦៩ គ្រួសារ រស់ នៅ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង ។ លោកស្រី បាន ផ្ដាំផ្ញើ សួរសុខទុក្ខ និង សេចក្ដី នឹករលឹក ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល សម្តេច ទាំង ទ្វេរ តែងតែ យកចិត្ត ទុក្ខ ដាក់ ចំពោះ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ដោយ មិន ឲ្យ មាន ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ ដាច់ បាយ ឡើយ ។
លោកស្រី ម៉ែន សំអន ក៏ បាន ជូន ពរ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទទួលបាន នូវ សុខភាព ល្អ និង ជោគជ័យ ក្នុង ភារកិច្ចការងារ គ្រប់ ៗ ក្រុមគ្រួសារ ពិសេស អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ៖
* ទី១៖ ប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ គ្រប់ ៗ ក្រុមគ្រួសារ ក្នុង ការចូលរួម ទប់ស្កាត់ នូវ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ជាពិសេស មិន ត្រូវ ភ្លេច ខ្លួន នោះ ទេ បើ ទោះបីជា ប្រទេស កម្ពុជា មាន អ្នក ឆ្លង នៅ មាន តិច ក្រោម ការអនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង សារាចរ ណែនាំ និង វិធានការណ៍ ជាច្រើន របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ។ ស្រប ពេល ដែល កម្ពុជា មកដល់ ថ្ងៃ នេះ អ្នក ឆ្លង មាន អ្នក ជាសះស្បើយ មាន ចំនួន ១២២ នាក់ និង ពុំ មាន អ្នកស្លាប់ នោះ ទេ ។
* ទី២៖ យើង ទាំងអស់ គ្នា ត្រូវ ជំរុញ ការងារ កសិកម្ម ក្នុង ការដាំដុះ ចិញ្ចឹម សត្វ នៅក្នុង មូលដ្ឋាន ជាពិសេស ត្រូវ រក្សាទុក្ខ នូវ ស្បៀងអាហារ ដូចជា អង្គរ អំបិល ប្រហុក ត្រី សាច់ ប្រសិនបើ ជំងឺ កូវីដ១៩ នេះ នៅតែ អូសបន្លាយ ។
* ទី៣៖ ត្រូវ ចូលរួម ទាំងអស់ គ្នា ក្នុង ការគោរព ច្បាប់ ចរាចរណ៍ ផ្លូវ គោ គ ដើម្បី កាត់បន្ថយ នូវ គ្រោះថ្នាក់ និង ការបាត់បង់ អាយុ ។
ក្នុង សកម្មភាព ចុះ អំណោយ ផ្ដល់ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៦៩ គ្រួសារ រស់ នៅ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន បាន នាំ អំណោយ សប្បុរសធម៌ របស់ សាខា កាទបាទ ក្រហម ខេត្ត ស្វាយរៀង ដល់ ប្រជាពលរដ្ឋ រួម មាន៖ អង្ករ មី ត្រីខ កំប៉ុង និង ថវិកា ចំនួន ទៀត ផងដែរ ៕
គួរ បញ្ជាក់ ថា អាជ្ញាធរ បាន រកឃើញ អ្នកស្លាប់ ២៤ នាក់ នៅ ហ្នឹង កន្លែង កើត ហេតុតែម្តង ខណៈ ៣៥ នាក់ ទៀត រងរបួស ក្នុង នោះ មួយចំនួន របួស ធ្ងន់ ត្រូវបាន បញ្ជូន ទៅ មន្ទីរពេទ្យ ។ ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បាន កើត មាន ឡើង នៅ អំឡុង ពេល ដែល ប្រទេស ឥណ្ឌា កំពុង ស្ថិត ក្នុង ការបិទ ទ្វារ នៅឡើយ ដើម្បី ទប់ទល់ នឹង ជំងឺ រាតត្បាត សកល COVID-19 ៕
នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន ជំរុញ នាយ ទាហាន ទាំងអស់ បន្ត ចូលរួម ថែទាំ សុខភាព និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា អនុប្រធាន គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី នឹង ប្រយុទ្ធ ជំងឺ កូវីដ១៩ បាន ជំរុញ ដល់ នាយ ទាហាន ពល ទាហាន ទាំងអស់ ត្រូវ បន្ត ថែទាំង សុខភាព អនាម័យ ចូលរួម ថែទាំ សុខភាព និង រួមគ្នា ការពារ ទប់ស្កាត់ និង បង្ការ ជំងឺ កូវីដ១៩ ជា លើក ទី២ ។
ការជំរុញ បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ផ្សព្វផ្សាយ ស្តី អំពី ការទប់ស្កាត់ បង្ការ ជំងឺ កូវីដ - ១៩ ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ព្រមទាំង គ្រួសារ កងទ័ព ចំណុះ ឱ្យ បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ពិសេស នា ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០២០ ។
ទាក់ទង ទៅ នឹង វិធានការ ការពារ បាន ល្អ របស់ កងយោធពល ខេមរភូមិន្ទ នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន បាន បញ្ជាក់ ថា កត្តា នេះ ដោយសារ បណ្តា កង ឯកភាព ខ. ភ. ម បាន អនុវត្ត បាន ត្រឹមត្រូវ ស្រប ទៅតាម សេចក្តីណែនាំ បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ក្រសួង ការពារ ជាតិ អគ្គ បញ្ជាការ កងយោធពល ខេមរភូមិន្ទ បាន ដាក់ចុះ ដោយ បាន អនុវត្ត នូវ ការធ្វើ អនាម័យ រស់ នៅ ស្អាត ហូប អាហារ មាន អនាម័យ ពាក់ ម៉ាស និង លាង ដៃ ជាមួយ សាប៊ូ ឬ អាកុល ជាប្រចាំ ។
នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន បាន បន្ត ទៀត ថា ថ្វីត្បិតតែ ជំងឺ កូវីដ - ១៩ យើង បាន ទប់ស្កាត់ ទទួលបាន ជោគជ័យ ក្នុង ដំណាក់កាល ទី ១នេះ ក៏ ពិត មែន ប៉ុន្តែ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក៏ ដូចជា គ្រួសារ កងទ័ព ត្រូវ មាន ការប្រុងប្រយ័ត្ន ជាប្រចាំ ដោយ យើង បន្ត ការរស់នៅ មាន មាន អនាម័យ រក្សា គម្លាត ពី គ្នា ត្រូវ លាង ដៃ ឱ្យ បាន ញឹកញាប់ ធ្វើ អនាម័យ សម្អាត ខ្លួនប្រាណ ជាប្រចាំ ស្រប តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដែល បាន ដាក់ចេញ ដើម្បី សុខភាព ផ្ទាល់ខ្លួន និង សម្រាប់ ក្រុមគ្រួសារ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន បាន ជំរុញ លើកទឹកចិត្ត ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្នុង យោធភូមិភាគ ពិសេស ត្រូវ បន្ត យកចិត្តទុកដាក់ លើ ការងារ បង្កបង្កើន ផល ចិញ្ចឹម សត្វ គ្រប់ ប្រភេទ ដើម្បី លើកស្ទួយ ជីវភាព រស់ នៅ របស់ ខ្លួន ឱ្យ បាន ល្អ ប្រសើរ ។
និស្សិត AUPP ដែល បាន បញ្ចប់ ថ្នាក់ បរិញ្ញាបត្រ ផ្នែក គ្រប់គ្រង ធុរកិច្ច និង ផ្នែក ច្បាប់ មាន មោទនភាព ខ្លាំង ណាស់ ដែល មាន វត្តមាន នៅក្នុង កម្មវិធី បញ្ចប់ ការសិក្សា ដែល ពោរពេញ ទៅ ដោយ និស្សិត អន្តរជាតិ ចម្រុះ ជាតិ សាសន៍ ទូទាំង ពិភពលោក ។
សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ អារី ហ្សូណា លោក ROBERT C. ROBBINS បាន បញ្ជាក់ ក្នុង សារ អេឡិចត្រូនិច ថា៖ « ការបញ្ចប់ នៃ ឆ្នាំ សិក្សា នេះ គឺជា ព្រឹត្តិការណ៍ ដែល ត្រូវបាន ទន្ទឹងរង់ចាំ ជា យូរ មកហើយ សម្រាប់ និស្សិត បញ្ចប់ ការសិក្សា រាប់ ពាន់ នាក់ របស់ យើង ដែល បាន ចំណាយ ពេលវេលា ជាច្រើន ឆ្នាំ កន្លងមក ក្នុង ការយកចិត្តទុកដាក់ រៀនសូត្រ ការបង្កើត ចំណង មិត្តភាព យ៉ាង ជ្រាលជ្រៅ និង វគ្គ បណ្តុះបណ្តាល សម្រាប់ អាជីព និង សម្រាប់ ភាពជោគជ័យ ក្នុង ការរៀនសូត្រ ពេញ មួយ ជីវិត របស់ ពួកគេ » ។
ឧប នាយក រដ្ឋមន្ដ្រី ហោ ណាំ ហុង ចែក ម៉ាស់ ដល់ ពលរដ្ឋ ១០០ គ្រួសារ នៅ ខណ្ឌ កំបូល និង ក្រើន រំឮក ឱ្យ ធ្វើ អនាម័យ ជាប្រចាំ
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ដ្រី ហោ ណាំ ហុង នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន នាំ ម៉ាស់ យក ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ចំនួន ១០០ គ្រួសារ ព្រមទាំង ឧបត្ថម្ភ ថវិកា ជូន មេ គ្រួសារ មួយចំនួន ស្ថិត នៅ ភូមិ ទួល លៀប សង្កាត់ ស្នោរ ខណ្ឌ កំបូល រាជធានី ភ្នំពេញ ព្រមទាំង ណែនាំ ដល់ ពួកគាត់ អំពី ការធ្វើ អនាម័យ ជាប្រចាំ ដើម្បី ការរីករាតត្បាត នៃ ជំងឺ COVID-19 ។
ក្នុង ឱកាស នោះ ដែរ ឧប នាយក រដ្ឋមន្ដ្រី ហោ ណាំ ហុង ក៏ បាន ណែនាំ ឱ្យ លាង ដៃ ញឹកញាប់ ជាមួយ សាប៊ូ ព្រមទាំង ប្រគល់ ថវិកា ខ្លះ ដល់ ចៅសង្កាត់ ស្នោរ ដើម្បី ទិញ សាប៊ូ ជូន ប្រជាពលរដ្ឋ ។
ឧបនាយ រដ្ឋមន្ដ្រី ក៏ បាន ជម្រាប ជូន ប្រជាជន អំពី បច្ចុប្បន្នភាព នៃ ជំងឺ COVID-19 នៅ កម្ពុជា ដែល អ្នកជំងឺ ១២២ នាក់ បាន ជាសះស្បើយ អស់ ហើយ ពុំ មាន អ្នក បាត់បង់ជីវិត ទេ ហើយក៏ មិន មាន ការឆ្លង រាតត្បាត ជំងឺ នេះ ដូច ប្រទេស នានា ក្នុង លោក នោះ ទេ ក្រោម ការដឹកនាំ ដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដែល មាន ក្រសួង សុខាភិបាល ជា សេនាធិការ និង ដោយ មាន ការខិតខំ តស៊ូ ស្វិត ស្វែង គួរ ជាទីគោរព របស់ គ្រូពេទ្យ គ្រប់ ជាន់ ថ្នាក់ របស់ កម្ពុជា ។
សូម បញ្ជាក់ ថា យោង តាម ក្រសួង សុខាភិបាល ចេញ សេចក្តីប្រកាស នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ថា អ្នកជំងឺ កូវីដ១៩ ម្នាក់ ចុងក្រោយ គេ ពោលគឺ អ្នកជំងឺ ទី១២២ បាន ជាសះស្បើយ ដែល បាន ធ្វើឱ្យ ប្រទេស កម្ពុជា ក្លាយជា ប្រទេស គ្មាន អ្នកជំងឺ កូវីដ១៩ ( ជាសះស្បើយ ១០០ ភាគរយ ) ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា អ្នកជំងឺ កូវីដ១៩ ទី១២២ ដែល ជាសះស្បើយ ជា ស្រ្តី ជនជាតិ ខ្មែរ អាយុ ៣៦ ឆ្នាំ រស់ នៅ ភូមិ ប៉ា លេឡៃ សង្កាត់ ផ្សារ កណ្តាល ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។ ក្រសួង បាន បញ្ជាក់ ថា នៅ ពេល នេះ កម្ពុជា មិន មាន អ្នកជំងឺ កូវីដ១៩ ព្យាបាល ទៀត ឡើយ នៅ ទូទាំង ប្រទេស ៕
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អំពាវនាវ ដល់ ពលរដ្ឋ ក្នុង ក្រុង សៀមរាប បន្ត ប្រុងប្រយ័ត្ន ខ្ពស់ ចូលរួម ទប់ស្កាត់ COVID-19
( សៀមរាប ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ សមាជិក អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ក្រុង សៀមរាប ខេត្ត សៀមរាប បាន អំពាវនាវ ដល់ សមាជិក សមាជិការបក្ស និង ប្រជាពលរដ្ឋ ទាំងអស់ នី ក្នុង ក្រុង - ខេត្ត សៀមរាប ឱ្យ បន្ត បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ក្នុង ការចូលរួម ទប់ស្កាត់ និង ការពារ ជំងឺ ឆ្លង ដ៏ កាច សាហាវ វីរុស កូវីដ១៩ នេះ កុំ បី ធ្វេសប្រហែស ក្នុង ១វិនាទី ណា ឡើយ ។
ការអំពាវនាវ បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ក្នុង ត្រីមាស ទី១ និង ដាក់ ទិសដៅ បន្ត ត្រីមាស ទី២ ឆ្នាំ ២០២០ របស់ ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
ជាមួយគ្នា នេះ ដែរ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ក៏ បាន បញ្ជាក់ ជូន ដល់ សមាជិក សមាជិកា បក្ស និង ប្រជាពលរដ្ឋ ក្នុង ក្រុង សៀមរាប យ៉ាង ច្បាស់ ថា សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា និង ប្រជាពលរដ្ឋ ទាំងអស់ ក្នុង ក្រុង សៀមរាប សូម ជឿ លើ ការដឹកនាំ ប្រទេស របស់ គណបក្ស ប្រជាជន កម្ពុជា និង រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ហើយ សូម កុំ ជឿ លើ ការឃោសនា បោកប្រាស់ ណាមួយ ដែល នាំឱ្យ ប្រទេសជាតិ ធ្លាក់ ក្នុង គ្រោះមហន្តរាយ ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ក្នុង ឱកាស អបអរសាទរ ទិវា ខួប អនុស្សាវរីយ៍ លើក ទី ៧៥ ថ្ងៃបដិសន្ធិ កងកម្លាំង នគរបាល ជាតិ បាន ក្រើន រំលឹក ដល់ មន្ដ្រី នគរបាល ទាំងអស់ ត្រូវ ត្រួតពិនិត្យ កែលម្អ និង អប់រំ សីលធម៌ វិន័យ អាកប្បកិរិយា និង មនសិការ វិជ្ជាជីវៈ របស់ ខ្លួន ដើម្បី បម្រើ ផលប្រយោជន៍ ជូន ជាតិ និង ប្រជាជន កម្ពុជា ។
ក្នុង សារលិខិត អបអរសាទរ ផ្ញើ ជូន កងកម្លាំង នគរបាល ជាតិ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន លើកទឹកចិត្ត និង សំណូមពរ កងកម្លាំង នគរបាល ជាតិ គ្រប់ ផែន ជំនាញ គ្រប់ ថ្នាក់ នៅ ទូទាំង ប្រទេស បន្ដ នូវ វីរភាព អង់អាច ក្លាហាន លើកកម្ពស់ ស្មារតី ស្នេហាជាតិ ។
នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បាន បញ្ជាក់ ទៀត ថា នគរបាល ជាតិ ទាំងអស់ ត្រូវ បន្ដ រួមគ្នា រក្សា ឲ្យបាន នូវ សន្ដិភាព ការពារ ឯករាជ្យ អធិបតេយ្យ ជាតិ បូរណភាព ទឹកដី ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ ការពារ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ និង ប្ដេជ្ញា មិន ឲ្យ មាន រចនាសម្ព័ន្ធ និង សកម្មភាព បដិវត្តន៍ ពណ៌ កើតមាន សារជាថ្មី លើកទឹកចិត្ត កម្ពុជា ជាដាច់ខាត ។
( ភ្នំពេញ ) ៖ ទោះ ស្ថិត ក្នុង កាលៈទេសៈ ណា ក៏ដោយ អគ្គ នាយិកា ក្រុមហ៊ុន KCR Group ដែល ជា ស្ត្រី អ្នកជំនួញ វ័យ ក្មេង របស់ កម្ពុជា មួយ រូប តែង ផ្តួចផ្តើម គំនិត ឲ្យ ក្រុមការងារ ចុះ ធ្វើ សកម្មភាព សប្បុរសធម៌ ជា ហូរហែរ មិន ដាច់ នោះ ទេ ។ សកម្មភាព មនុស្សធម៌ ទាំង នេះ ត្រូវបាន មហាជន ជាច្រើន សម្តែង នូវ ការសាទរ និង ពេញចិត្ត ជាខ្លាំង ។
១ លោកយាយ ឃិន ខែន នៅ ភូមិ យុល ចេក ឃុំ ជីខ្មា ស្រុក ទ្រាំង ខេត្ត តាកែវ ២ លោក ពូ វង បូ នៅ ភូមិ ចំបក់ ឃុំ ទួល ព្រិច ស្រុក គីរីវង្ស ខេត្ត តាកែវ ៣ លោកយាយ ទូច តេង នៅ ភូមិ ព្រៃ តា ព្រិច ឃុំ ស្តេច គង់ ខាងជើង ស្រុក បន្ទាយមាស ខេត្ត កំពត៤ លោក តា អៀម សួន នៅ ភូមិ ត្រពាំង ស្គន់ ឃុំ ត្រពាំង រាំង ស្រុក ជុំ គីរី ខេត្ត កំពត៥ លោកយាយ ពឿន មួយ នៅ ភូមិ បឹង និមល ឃុំ បឹង និមល ស្រុក ឈូក ខេត្ត កំពត៦ លោកយាយ ជន រឹត នៅ ភូមិ ត្រពាំង៣ ឃុំ ត្រពាំង៣ ស្រុក ឈូក ខេត្ត កំពត
( ភ្នំពេញ ) ៖ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ទទួល ម៉ាស មុខ១០.០០០ បន្ទះ ជែល លាង ដៃ១.០០០ ដប និង ទឹក អាល់កុល លាង ដៃ ១៨០លីត្រ ពី ណាហ្គាវើលដ៍ បេះដូង សប្បុរស ដែល ជា ផ្នែក ទំនួល ខុសត្រូវការងារ សង្គម របស់ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ។
ឧត្តមសេនីយ៍ ទោ ជា សណ្តាប់ តំណាង លោក ឧត្តមសេនីយ៍ ឯក ឡោ សុឡេង អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការហិរញ្ញកិច្ច និង ភស្តុភារ បាន ទទួល សម្ភារ ការពារ ទាំង នេះ ។
លោក បន្ដ ថា សម្ភារ ទាំង នេះ នឹង ត្រូវ ប្រើប្រាស់ ដោយ មន្ត្រី របស់ ពួកគេ និង សហគមន៍ ដែល មាន តម្រូវការ ជា ចាំបាច់ បំផុត ។ យើង ត្រូវ ធ្វើការ ជាមួយគ្នា និង ធានា ថា ប្រជាពលរដ្ឋ គ្រប់ រូប ទទួលបាន ការ ការពារ ហើយ យើង អាច បង្កើត ឲ្យ មាន ការផ្លាស់ប្តូរ មួយ ពោលគឺ រក្សា សហគមន៍ របស់ យើង ឲ្យ មាន សុវត្ថិភាព ។
ឧត្តមសេនីយ៍ ទោ ជា សណ្តាប់ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ទឹកចិត្ត សប្បុរស របស់ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ។ លោក ថា ជំងឺ នេះ បាន ប៉ះពាល់ ដល់ គ្រប់ វិស័យ នៅក្នុង សង្គម ហើយ យើង ស្វាគមន៍ ការឧបត្ថម្ភ ទាំងអស់ ពី វិស័យ ឯកជន ដើម្បី ការពារ សហគមន៍ ដែល យើង បម្រើ និង ការពារ ។
ក្រសួង សុខាភិបាល សម្រេច ផ្អាក បណ្ដោះអាសន្ន ការចេញផ្សាយ ព័ត៌មាន ប្រចាំ ថ្ងៃ និង ការធ្វើ សន្និសីទ សារព័ត៌មាន ប្រចាំ សប្តាហ៍ ចាប់ពី ថ្ងៃស្អែក នេះ (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន សម្រេច ផ្អាក ធ្វើជា បណ្ដោះអាសន្ន ការចេញផ្សាយ សេចក្ដីជូន ព័ត៌មាន ប្រចាំ ថ្ងៃ និង ការធ្វើ សន្និសីទ សារព័ត៌មាន ប្រចាំ សប្តាហ៍ ចាប់ពី ថ្ងៃអាទិត្យ ទី១៧ ខែឧសភា ឆ្នាំ ២០២០ នេះ តទៅ ។ នេះ បើ តាម សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ ។
ក្នុង សេចក្ដីប្រកាស ព័ត៌មាន បាន បញ្ជាក់ ថា « ក្រសួង សូម ជម្រាប ជូន សាធារណជន ទាំងអស់ ឲ្យបាន ជ្រាប ថា ការចេញផ្សាយ សេចក្ដីជូន ព័ត៌មាន ប្រចាំ ថ្ងៃ និង ការធ្វើ សន្និសីទ សារព័ត៌មាន ប្រចាំ សប្តាហ៍ ត្រូវបាន ផ្អាក ធ្វើជា បណ្ដោះអាសន្ន ចាប់ពី ថ្ងៃអាទិត្យ ទី ១៧ ខែឧសភា ឆ្នាំ ២០២០ នេះ តទៅ » ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ឲ្យដឹង ថា នៅពេល ខាងមុខ នេះ ប្រសិនបើ មាន រកឃើញ ករណី វិជ្ជមាន កូវីដ - ១៩ ថ្មី ឬ ការវិវត្តន៍ ថ្មី ពាក់ព័ន្ធ នឹង ស្ថានភាព ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា ក្រសួង នឹង ជម្រាប ជូនដំណឹង ជូន សាធារណជន ទាំងអស់ ឲ្យបាន ជ្រាប ជា មិន ខាន ឡើយ ។
ក្រសួង សុខាភិបាល សូម បញ្ជាក់ ជូន ថា ការផ្អាក ជូន ព័ត៌មាន និង ការផ្អាក ធ្វើ សន្និសីទ សារព័ត៌មាន នេះ មិន មែន ជា ការបង្ហាញ ពី ការចម្លង វីរុស កូវីដ - ១៩ នៅ កម្ពុជា ត្រូវបាន បញ្ចប់ ជាស្ថាពរ នោះ ឡើយ ។
សូម ជម្រាប ថា នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ក្រសួង សុខាភិបាល បាន ប្រកាស ថា អ្នកជំងឺ កូវីដ១៩ ម្នាក់ ចុងក្រោយ គេ ពោលគឺ អ្នកជំងឺ ទី១២២ បាន ជាសះស្បើយ ដែល បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា ក្លាយជា ប្រទេស គ្មាន អ្នកជំងឺ កូវីដ១៩ ( ជាសះស្បើយ ១០០ ភាគរយ ) ។
អភិបាល ខេត្ត ត្បូងឃ្មុំ នាំយក អំណោយ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ចែកជូន ពលរដ្ឋ ក្រីក្រ ៥០ គ្រួសារ ក្នុង ស្រុក អូរ រាំង ឪ
( ត្បូងឃ្មុំ ) ៖ នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម ខេត្ត និង លោកស្រី រួម ជាមួយ ក្រុមការងារ អញ្ជើញ ចុះ សំណេះសំណាល នាំយក អំណោយ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន តាមរយៈ សាខា កាកបាទ ក្រហម ខេត្ត ទៅ ចែកជូន ប្រជាពលរដ្ឋ ជា ជន ងាយ រងគ្រោះ ទី ទាល់ ក្រ ស្ត្រី មេម៉ាយ និង ជន ពិការ ចំនួន ៥០ គ្រួសារ ក្នុង ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ ។
សូម បញ្ជាក់ ដែរ ថា អំណោយ ដែល ត្រូវបាន ចែកជូន ជន ងាយ រងគ្រោះ ទាំង ៥០ គ្រួសារ នោះ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម ទឹកត្រី ទឹកស៊ីអ៊ីវ ត្រីខ មី ប្រេង ឆា ម៉ាស់ អាល់កុល និង ថវិកា ចំនួន ២ម៉ឺន រៀល ក៏ ដូចជា ផ្តល់ ជូន នូវ ស្បៀងអាហារ ម៉ាស់ អាល់កុល និង ថវិកា មួយ ចំនួន ដល់ អនុសាខា កាកបាទ ក្រហម ស្រុក អូរ រាំង ឪ សម្រាប់ បន្ត ចែកជូន ពលរដ្ឋ ជន ងាយ រងគ្រោះ ផងដែរ ។
បន្ទាប់មក លោក ជា ម ច័ន្ទ សោភ័ណ និង លោកស្រី រួមទាំង ក្រុមការងារ បាន បន្ត ដំណើរ ចុះ ទៅ ត្រួតពិនិត្យ ទីតាំង ចត្តា ឡី ស័ក្ត ដោយ សំណេះសំណាល ផ្តល់ ជូន គ្រឿង ឧបភោគ បរិភោគ ម៉ាស់ អាល់កុល និង ថវិកា ១០ម៉ឺន រៀល ក្នុង ម្នាក់ ៗ ដល់ ពលករ ដែល ទើប មកពី ក្រៅ ប្រទេស ចំនួន ២២ នាក់ កំពុង ដាក់ ខ្លួន ឱ្យ នៅ ដាច់ដោយឡែក រយៈ ១៤ ថ្ងៃ ក្នុង ស្រុក អូរ រាំង ឱ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ ក៏ បាន អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ បង្កើន ការប្រុងប្រយ័ត្ន នៅក្នុង សកម្មភាព ប្រចាំ ថ្ងៃ របស់ ខ្លួន ត្រូវ រក្សា អនាម័យ ជាប់ ជានិច្ច មិន ត្រូវ ជួបជុំ ឬ ប្រមូលផ្តុំ គ្នា ក្នុង អំឡុង ពេល នេះ នោះ ទេ ។
( ត្បូងឃ្មុំ ) ៖ លោក ខ្វៃ អាទិត្យា អគ្គ នាយក ស្ថានីយ៍ វិទ្យុ និង ទូរទស្សន៍ អប្សរា និង ជា អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ឃុំ ព្រះធាតុ ស្រុក អូរ រាំង ឪ ខេត្ត ត្បូងឃ្មុំ នា ព្រឹក ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ចុះ ផ្សព្វផ្សាយ ការអប់រំ ការពារ ប្រឆាំង ជំងឺ កូវីដ ១៩ ដល់ ប្រជាពលរដ្ឋ ឃុំ ព្រះធាតុ និង ចែក សម្ភារៈ មួយចំនួន ។
លោក បាន បន្ថែម ថា អំណោយ សប្បុរសធម៌ នា ថ្ងៃ នេះ ក៏ ជា ការបង្ហាញ នូវ ការយកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ប្រជាពលរដ្ឋ គ្រប់ រូប ពីសំណាក់ ថ្នាក់ដឹកនាំ ពិសេស គឺ ក្រុមការងារ រាជ រដ្ឋាភិបាល និង ក្រុមការងារ គណបក្ស គ្រប់ លំដាប់ថ្នាក់ តាម ទិស ស្លោក « ចូលរួម សម្រាប់ គ្រប់ ៗ គ្នា មិន ទុក នរណា ម្នាក់ ចោល » ។
ជាមួយគ្នា នេះ លោក ខ្វៃ អាទិត្យា ក៏ បាន សំណូមពរ ឲ្យ ប្រជាពលរដ្ឋ ត្រូវតែ បន្ត ថែរក្សា សុខភាព និង មាន អនាម័យ ល្អ ក្នុង ការរស់នៅ៖
ក្រោយ លួច ចាក់ ដី រំលោភ យក ប្រឡាយ សាធារណៈ នៅ ឃុំ ស្វាយជ្រុំ ខេត្ត កណ្តាល អាជ្ញាធរ បាន ចុះ ហាមឃាត់ និង ហៅ អ្នក រំលោភ មក សួរ នាំ
( កណ្ដាល ) ៖ អ្នកភូមិ ស្វាយជ្រុំ ឃុំ ស្វាយជ្រុំ ស្រុក ខ្សាច់ កណ្ដាល បាន រាយការណ៍ ឲ្យដឹង នៅ ថ្ងៃទី ១៦ ខែឧសភា ឆ្នាំ ២០២០ នេះ ថា ពួកគេ បាន ឃើញ ឈ្មួញ មាន លុយ ម្នាក់ ដែល រកស៊ី ខាង កាយ ដី លក់ អាចម៍ ដី ឈ្មោះ មហា រដ្ឋាត្រេឌីង បាន ធ្វើ សកម្មភាព ចាក់ ដី រំលោភ យក ប្រឡាយ សាធារណៈ របស់ រដ្ឋ ធ្វើជា កម្មសិទ្ធិ របស់ ខ្លួន ខណៈ ដែល ពលរដ្ឋ ស្នើសុំ អាជ្ញាធរ ពាក់ព័ន្ធ ធ្វើ ការទប់ស្កាត់ ផង បើ ពុំ ដូច្នោះ ទេ ប្រឡាយ សាធារណៈ នេះ នឹង ត្រូវបាត់បង់ ធ្លាក់ ចូល ក្នុង ដៃ ឈ្មួញ មិន ខាន ឡើយ ។
ប្រជាពលរដ្ឋ បាន រាយការណ៍ ថា ពួកគេ បាន ចាក់ លុប ប្រឡាយ នេះ បាន ជាច្រើន ម៉ែត្រ ហើយ បើសិនជា មិន ទប់ស្កាត់ ទេ ប្រឡាយ សាធារណៈ នេះ នឹង ក្លាយទៅជា របស់ ឯកជន យ៉ាង អនាធិបតេយ្យ មិន ខាន ឡើយ ។
រីឯ លោក ប៊ុន ផេង អភិបាល ស្រុក ខ្សាច់ កណ្ដាល ក៏ បាន បញ្ជាក់ ដែរ ថា ខាង អាជ្ញាធរ បាន ហាមឃាត់ សកម្មភាព ចាក់ ដី លុប ប្រឡាយ នេះ ហើយ ព្រមទាំង ហៅ ភាគី ខាង លោក មហា រដ្ឋា នោះ ចូល ខ្លួន ដោះស្រាយ បញ្ហា នៅ ថ្ងៃច័ន្ទ សប្ដាហ៍ ក្រោយ ។
អំពី បញ្ហា នេះ ក្រុម ប្រជាពលរដ្ឋ អ្នក អាស្រ័យ ផល បាន ស្នើ ដល់ អភិបាល ខេត្ត មេត្តា ជួយ រក្សាទុក ប្រឡាយ ទឹក នេះ ផង ដើម្បី បាន ពួកគាត់ ប្រើប្រាស់ សំរាប់ ដំណាំ ចំការ និង ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ប៉ុន្តែ បើសិន ណា គេ ពិតជា លុប ប្រឡាយ មែន ហាក់បីដូច កាត់ផ្ដាច់ សង្ខា របស់ ពួកគាត់ ដូច្នោះ ដែរ ព្រោះ មនុស្ស រស់ នៅ ត្រូវការ ទឹក បើ គេ កាត់ផ្ដាច់ ផ្លូវ ទឹក ដូច កាត់ផ្ដាច់ ដង្ហើម របស់ ពលរដ្ឋ ដូច្នោះ ដែរ ។
ជាមួយគ្នា នេះ សម្ដេច តេជោ ហ៊ុន សែន នៅតែ បន្ដ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ បន្ដ ប្រុងប្រយ័ត្ន ខ្ពស់ មាន អនាម័យ ជាប់ ជាប្រចាំ គឺ ត្រូវ ពាក់ ម៉ាស លាង សម្អាត ដៃ ជាមួយ សាប៊ូ ទឹក អាល់កុល ឬ ជេល សម្លាប់ មេរោគ ឆ្លង ផ្សេង ៗ ហើយ ត្រូវ រក្សា គម្លាត សុវត្ថិភាព ព្រោះ ក្រែង ជំងឺ នេះ ផ្ទុះឡើង ជាថ្មី ខណៈ ពិភពលោក មិន ទាន់ មាន ថ្នាំ ព្យាបាល នៅឡើយ ទេ ។
ពិត មែន តែ យើង ពុំ មាន ករណី ថ្មី ក៏ដោយ សូម បងប្អូន ប្រជាពលរដ្ឋ បន្ត ប្រុងប្រយ័ត្ន ខ្ពស់ មាន អនាម័យ ជាប់ ជាប្រចាំ គឺ ត្រូវ ពាក់ ម៉ាស ដុស លាង សម្អាត ដៃ ជាមួយ សាប៊ូ ទឹក អាល់កុល ឬ ជេល សម្លាប់ មេរោគ ឆ្លង ផ្សេង ៗ ហើយ បន្ត រក្សា គម្លាត ឆ្ងាយ ពី គ្នា និង កុំ ចេញ ក្រៅ ផ្ទះ បើ គ្មាន ការចាំបាច់ អ្វី ទេ នោះ ។
បើ តាម ការបញ្ជាក់ របស់ ក្រសួង សុខាភិបាល វៀតណាម បាន ឲ្យដឹង ថា ០១ករណី ចុងក្រោយ នេះ គឺជា ស្ត្រី វៀតណាម ម្នាក់ អាយុ ៦២ ឆ្នាំ ដែល ទើបតែ ត្រឡប់ មកពី ប្រទេស រុស្ស៉ី កាលពី ថ្ងៃពុធ សប្តាហ៍ នេះ ។ ទោះជា យ៉ាងណា វៀតណាម មិន មាន ករណី ឆ្លង នៅក្នុង ស្រុក ផ្ទាល់ សម្រាប់ រយៈពេល ៣០ ថ្ងៃ ជាប់ ៗ គ្នា មក ហើយ ដោយ ករណី ថ្មី ៗ សុទ្ធតែ ករណី អ្នកជំងឺ ដែល ឆ្លង នៅ ក្រៅ ប្រទេស ហើយ ត្រូវបាន ពិនិត្យ ឃើញ ពេល ចូល ដល់ ប្រទេស វៀតណាម ។
យោង តាម របាយការណ៍ របស់ អាជ្ញាធរ វៀតណាម បាន ឲ្យដឹង ថា មាន មនុស្ស ជាង ១២.០០០ នាក់ ហើយ ដែល ត្រូវបាន ត្រួតពិនិត្យ និង ដាក់ ឲ្យ នៅ ដាច់ដោយឡែក ខណៈ ក្នុង ចំណោម ករណី ឆ្លង ទាំងអស់ គឺ ២៦០ នាក់ បាន ជាសះស្បើយ ឡើងវិញ និង ពុំ មាន ករណី ស្លាប់ ឡើយ ៕
អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង ប្រជុំ ផ្សព្វផ្សាយ ការអនុវត្តន៍ ផែនការ សុវត្ថិភាព អាយុជីវិត ប្រជាពលរដ្ឋ កំពុង រស់ នៅក្នុង អគារ ទ្រុឌទ្រោម ១៣ល្វែង
( កំពង់ឆ្នាំង ) ៖ លោក សាន់ យូ អភិបាល រង ខេត្ត និង ជា ប្រធាន ក្រុមការងារ ចម្រុះ របស់ ខេត្ត ប្រជុំ ផ្សព្វផ្សាយ ការអនុវត្តន៍ ផែនការ សុវត្តិភាព អាយុជីវិត ប្រជាពលរដ្ឋ ១៦ គ្រួសារ កំពុង រស់ នៅ ក្នុង អគារ ទ្រុឌទ្រោម ១៣ល្វែង ក្នុង សង្កាត់ ផ្សារ ឆ្នាំង ក្រុង កំពង់ឆ្នាំង ទទួលបាន ជោគជ័យ ដោយ ប្រជាពលរដ្ឋ ព្រម ចាកចេញ ពី អគារ ទ្រុឌទ្រោម នោះ និង រងចាំ សាងសង់ អគារ ថ្មី ក្នុង ពេល ឆាប់ ៗ នេះ ផងដែរ ។
ជាមួយគ្នា នេះ លោក រុំ សុវិជ្ជា ក៏ ធ្លាប់ បាន ជេរ ប្រមាថ ដោយ សម្តី អសុរោះ ទៅ លើ អ្នកគ្រូពេទ្យ នៅ ខេត្ត កំពង់ធំ កាលពី ពេល កន្លងទៅ ផងដែរ ពេល ដែល រូប គាត់ បាន ចូលទៅ អុក ឡុក រក រឿង នៅក្នុង មន្ទីរពេទ្យ ដើម្បី ចូល មើល មិត្តភក្តិ ផឹក ស៊ី របស់ ខ្លួន ជួប គ្រោះថ្នាក់ ចរាចរណ៍ ហើយ ត្រូវបាន គេ បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ។
ការបង្ហាញ ក្តីសង្ឃឹម របស់ លោក ត្រាំ គឺ មើល ទៅ មាន សុទិដ្ឋិនិយម ខ្ពស់ ជាង អ្វី ដែល បណ្តា ប្រទេស អឺរ៉ុប បាន ព្យាករណ៍ ។ យោង តាម ទីភ្នាក់ងារ ឯកទេស ផ្នែក ឱសថ របស់ អឺរ៉ុប វ៉ាក់សាំង ដែល អាច ប្រើប្រាស់ ផ្លូវការ គឺ ត្រូវ ចំណាយ ពេល អភិវឌ្ឍ យ៉ាងតិច ក៏ ០១ឆ្នាំ ទៀត ដែរ ហើយ នេះ គឺ ក្នុង ករណី ដែល មាន សុទិដ្ឋ និយម ខ្ពស់ បំផុត ដ្បិត ជាទូទៅ វា ត្រូវ ប្រើ ពេល យូរ ឆ្នាំ ។
គួរ ជម្រាប ថា កន្លងមក អ្នកវិទ្យាសាស្រ្ត មិន ធ្លាប់ អភិវឌ្ឍ វ៉ាក់សាំង បាន ជោគជ័យ សម្រាប់ វីរុស កូរ៉ូណា ប្រភេទ ណាមួយ ឡើយ ដែល ឆ្លង មកកាន់ មនុស្ស ។ វ៉ាក់សាំង គឺ មាន សម្រាប់ តែ វីរុស កូរ៉ូណា ដែល ឆ្លង រវាង សត្វ ប៉ុណ្ណោះ ឧទាហរណ៍ ដូចជា ប្រភេទ វីរុស កូរ៉ូណា ដែល ឆ្លង ក្នុង ចំណោម សត្វ មាន់ ។ វ៉ាក់សាំង នោះ ត្រូវបាន ប្រើប្រាស់ ដោយ ម្ចាស់ កសិដ្ឋាន ចិញ្ចឹម មាន់ ប៉ុន្តែ វា មាន គុណវិបត្តិ ធំ មួយ គឺ មាន់ មួយចំនួន ត្រូវ ងាប់ ដែល វ៉ាក់សាំង បែប នេះ បើ ប្រើ សម្រាប់ មនុស្ស យើង គឺ មិន អាច ទទួលយក បាន ដាច់ខាត ៕
សូម អរគុណ ទ័ព អាវ សរបស់ កម្ពុជា ទាំង ជួរ មុខ និង ជួរ ក្រោយ ដែល បាន ពួត ដៃ យ៉ាង ស្វាហាប់ និង ពលីកម្ម សព្វ បែប យ៉ាង ដោយ មិន ខ្លាច នឿយហត់ ប្រយុទ្ធ ជាមួយ ជំងឺ កូវីដ១៩ ដោយ អង់អាច ក្លាហាន ។
ប្រទេស កម្ពុជា ត្រូវបាន រកឃើញ អ្នក កើត ជំងឺ កូវីដ១៩ ករណី ដំបូង លើ បុរស ជនជាតិ ចិន មកពី ទីក្រុង វូហាន ខេត្ត ហឺ ប៉ី ប្រទេស ចិន ក្នុង ខែមករា ឆ្នាំ ២០២០ ។ បន្ទាប់ពី បុរស រូប នេះ បាន ព្យាបាល ជា ទៅ កម្ពុជា ក៏ បាន រកឃើញ ករណី ទី២កើត លើ បុរស ជនជាតិ ខ្មែរ នៅក្នុង ខេត្ត សៀមរាប នៅក្នុង ខែមីនា ។ បុរស ជនជាតិ ខ្មែរ រូប នេះ គឺជា ជនជាតិ ខ្មែរ ដំបូង គេ ដែល បាន ឆ្លង ជំងឺ កូវីដ១៩ ដោយ ឆ្លង ពី បុរស ជនជាតិ ជប៉ុន ដែល ធ្វើការ ជាមួយគ្នា ។
ចាប់ពី ខែមីនា នោះ មក រហូតដល់ ខែ ដើម ខែមេសា កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ជា បន្តបន្ទាប់ រហូតដល់ទៅ ១២២ រូប ។ អ្នក ដែល បាន ឆ្លង ជំងឺ កូវីដ១៩ នេះ មាន ជនជាតិ ខ្មែរ ៥១ រូប និង ជន បរទេស ៧១ រូប ។ ជន បរទេស ដែល បាន រកឃើញ ឆ្លង ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស កម្ពុជា នេះ រួម មាន៖ ចិន អាមេរិក អង់គ្លេស បារាំង កាណាដា ប៊ែលហ្សិក ម៉ាឡេស៊ី ឥណ្ឌូនេស៊ី និង វៀតណាម ។
បើ ទោះបី ថា មកដល់ ពេលនេះ កម្ពុជា មិន ទាន់ ឆ្លង ផុត ពី ហានិភ័យ និង ដំណាក់កាល នៃ ការឆ្លង ជំងឺ កូវីដ១៩ ដែល ជា មេរោគ បង្ក ការភ័យខ្លាច និង ចលាចល នៅក្នុង ពិភពលោក យ៉ាងណា ក្តី តែ ការព្យាបាល អ្នកជំងឺ ឱ្យ ជាសះស្បើយ អស់ និង មិន គ្រោះថ្នាក់ ដល់ អាយុជីវិត អ្នកជំងឺ គឺជា ភាពជោគជ័យ ប្រកបដោយ មោត ទនភាព និង គួរឱ្យ រីករាយ ជា ពន់ពេក ។
ផ្ទុយ ពី ការវាយតម្លៃ ប្រកបដោយ ភាពទុទ្ទិដ្ឋិនិយម ពី ក្រុម ជន ទាំងនេះ កម្ពុជា បែរជា ទទួលបាន ការវាយតម្លៃ និង កោតសរសើរ មិន ដាច់ ពី មាត់ ពី អង្គការ សុខភាព ពិភពលោក ប្រចាំ នៅ កម្ពុជា ពាក់ព័ន្ធ ការដាក់ចេញ វិធានការ និង ចំណាត់ការ ទាំងឡាយ ប្រកបដោយ ភាពប្រាកដ និយម ច្បាស់លាស់ និង ទាន់ ពេលវេលា ដើម្បី ឆ្លើយតប បង្ការ ទប់ស្កាត់ និង ប្រយុទ្ធ ប្រឆាំង ជាមួយ ជំងឺ កូវីដ១៩ ។
បន្ថែម ពីលើ នេះ ក្រុម ប្រទេស ដែល គេ មាន មោទនភាព ថា ជា ប្រទេស មាន វិស័យ សុខាភិបាល ជឿនលឿន ពោរពេញ ដោយ បច្ចេកវិទ្យា ទំនើប នោះ បែរជា រងគ្រោះ ធ្ងន់ធ្ងរ ពី ការវាយប្រហារ ជំងឺ កូវីដ១៩ ជីវិត ពលរដ្ឋ រាប់ សិប ម៉ឺន នាក់ បាន ឆ្លង និង រាប់ ពាន់ រាប់ ម៉ឺន នាក់ ទៀត បាន បាត់បង់ជីវិត ។
មកដល់ ត្រឹម ព្រឹក ថ្ងៃទី ១៦ ខែឧសភា ជំងឺ កូវីដ១៩ បាន និង កំពុង រីកសាយភាយ និង វាយប្រហារ លើ ប្រទេស និង ដែនដី ចំនួន ២១៣ ។ អ្នក ឆ្លង ជំងឺ មាន ជិត ៥លាន នាក់ អ្នកស្លាប់ មាន ជាង ៣០ម៉ឺន នាក់ និង អ្នក ព្យាបាល ជាង មាន ជាង ១.៧លាន នាក់ ។ ប្រទេស ដែល មាន អ្នក ឆ្លង និង ស្លាប់ ដោយ ជំងឺ កូវីដ១៩ ច្រើន ជាង គេ សុទ្ធតែ ជា ប្រទេស ដែល មាន វិស័យ សុខាភិបាល ជឿនលឿន និង ជា ប្រទេស មហា អំណាច សេដ្ឋកិច្ច ផងដែរ ។
ប្រទេស ចំនួន ៥ ដែល មាន អ្នក ឆ្លង និង ស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ ច្រើន ជាង គេ ហើយ កំពុង បន្ត រីករាលដាល ខ្លាំង មិន ទាន់ ស្រាកស្រាន នៅឡើយ នោះ រួម មាន៖ សហរដ្ឋ អាមេរិក នាំមុខ គេ បន្ទាប់មក មាន អេស្បាញ រុស្ស៉ី អង់គ្លេស និង អ៉ីតាលី ។
ជំងឺ កូវីដ១៩ ជា ជំងឺ ឆ្លង ថ្មី មួយ ដែល មិន ទាន់ មាន ថ្នាំ បង្ការ ឬ ថ្នាំ ព្យាបាល ឱ្យ ច្បាស់លាស់ នៅឡើយ នោះ ទេ ។ ដូច្នេះ សមត្ថភាព នៃ ការព្យាបាល ជំងឺ មួយ នេះ មិន ចំណុះ នៅលើ ប្រទេស មាន វិស័យ សុខាភិបាល ខ្លាំងក្លា ឬ ប្រទេស មាន វិស័យ សុខាភិបាល ទុន ខ្សោយ នោះ ឡើយ ពោល បច្ចេកទេស នៃ ការព្យាបាល ជំងឺ នេះ មាន កម្រិត ប្រហាក់ប្រហែល គ្នា ប៉ុណ្ណោះ ។
ប៉ុន្តែ អ្វី ដែល ជា ប្រសិទ្ធភាព ក្នុង ប្រតិបត្តិការ ប្រយុទ្ធ ប្រឆាំង ជាមួយ ជំងឺ ឆ្លង ប្រភេទ ថ្មី មួយ នេះ គឺ ការដាក់ចេញ នូវ វិធានការ និង ចំណាត់ការ ឱ្យ បាន ទាន់ ពេលវេលា ធ្វើ យ៉ាងណា កុំ ឱ្យ ជំងឺ មួយ នេះ ឆ្លង រាតត្បាត ខ្លាំង ។
សម្រាប់ សហរដ្ឋ អាមេរិក និង បណ្តា ប្រទេស លោក ខាងលិច មួយចំនួន ទៀត ប្រការ ដែល នាំឱ្យ ប្រទេស ទាំងនេះ ឆ្លង រីករាលដាល ខ្លាំង ស្ទើរតែ បាត់បង់ ម្ចាស់ ការ បែប នេះ ការប្រមាថ ចំពោះ ស្ថានការណ៍ និង ការប្រមាថ លើ ឥទ្ធិពល នៃ ជំងឺ នេះ ជា រឿង ចម្បង ។
អ៉ីតាលី ជា ប្រទេស នៅ តំបន់ អឺរ៉ុប ដែល បាន រង ការរីករាលដាល ជំងឺ កូវីដ១៩ មុនដំបូង គេ ។ ផ្តើម ចេញ ពី ពលរដ្ឋ ដែល មើល ស្រាល និង ប្រមាថ ចំពោះ ជំងឺ កូវីដ១៩ ថា គ្មាន អនុភាព វាយប្រហារ សុខភាព របស់ ពួកគេ នោះ ធ្វើឱ្យ ពួកគេ ផ្គើន និង មិន គោរព តាម វិធានការ ក៏ ដូចជា ការណែនាំ ទាំងឡាយ របស់ រដ្ឋ និង អ្នកជំនាញ ហើយ នៅតែ បន្ត ធ្វើ សកម្មភាព ដើរហើរ និង ជួបជុំ ទីបំផុត ធ្វើឱ្យ ជំងឺ នេះ វាយប្រហារ យ៉ាង ធ្ងន់ធ្ងរ បំផុត ។
ក្រៅពី អ៉ីតាលី បណ្តា ប្រទេស ដទៃ ទៀត នៅ តំបន់ អឺរ៉ុប រួមទាំង អាមេរិក ផង មិន ត្រឹមតែ ប្រជាពលរដ្ឋ នោះ ទេ ដែល មើល ស្រាល ចំពោះ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ សូម្បីតែ មេដឹកនាំ ប្រទេស ទាំងអស់ នេះ ហាក់ មិន មាន ភាពច្បាស់លាស់ និង ប្រាកដ និយម ក្នុង ការគ្រប់គ្រង និង ដឹកនាំ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ មួយ នេះ ផងដែរ ។ ពួកគេ នៅតែ អល់ អែក និង បែងចែក មិន ដាច់ ថា រវាង ជម្រើស រក្សា ដំណើរការ សេដ្ឋកិច្ច និង ការរាំងខ្ទប់ ជំងឺ កូវីដ១៩ មិន ឱ្យ រីករាលដាល មួយ ណា សំខាន់ ជាង ?
មេដឹកនាំ នៃ បណ្តា ប្រទេស ទាំងនេះ ដោយ បារម្ភ ពី ផល ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច នៅក្នុង ប្រទេស ពួកគេ នៅតែ ស្ទាក់ស្ទើរ ក្នុង ការសម្រេចចិត្ត បិទ ប្រទេស និង ដំណើរ គោរចរ ដើម្បី ទប់ស្កាត់ ការរីករាលដាល ជំងឺ បើ ទោះបី ជំងឺ បាន វាយលុក ចូលក្នុង ប្រទេស ទៅ ហើយក្តី ។ ព្រោះតែ ភាពអល់ អែក និង ស្ទាក់ស្ទើរ លើ ការសម្រេចចិត្ត ក្នុង ការជ្រើសរើស វិធានការរាំងខ្ទប់ ប្រទេស ឬ ត្រូវ រក្សា ដង្ហើម សេដ្ឋកិច្ច នេះ ទីបំផុត ធ្វើឱ្យ ការរីករាល ជំងឺ កូវីដ១៩ មាន សភាព អាណោច អាធម ។
សម្រាប់ កម្ពុជា វិញ ជន ដែល មិន សូវ ជា ផ្តល់ គុណសម្បត្តិ និង លើកទឹកចិត្ត ចំពោះ ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល នោះ គេ អាចនឹង លើកឡើង ថា ការ ដែល កម្ពុជា មិន សូវ មាន ជំងឺ រីករាលដាល បែប នេះ ដោយសារតែ កត្តា ចំនួន ប្រជាពលរដ្ឋ តិចតួច និង បញ្ហា អាកាសធាតុ ដែល ជួយ រាំង ខ្ទប់ ការរីករាល ជំងឺ កូវីដ១៩ ។
តែ បើ យោង ទៅតាម ស្ថិតិ ប្រទេស កំពុង រាតត្បាត ដោយសារ ជំងឺ កូវីដ១៩ នៅលើ ពិភពលោក បាន បង្ហាញ ឱ្យ ឃើញ ថា ការរីករាតត្បាត ជំងឺ កូវីដ១៩ មិន ចំណុះ លើ ប្រទេស តូច ប្រជាជន តិច ឬ អាកាសធាតុ នោះ ឡើយ ។ ដ្បិត ថា បណ្តា ប្រទេស ដែល មាន អាកាសធាតុ ក្តៅ ជាង កម្ពុជា ដូចជា នៅ តំបន់ អាហ្វ្រិក និង នៅ បណ្តា ប្រទេស មាន ចំនួន ប្រជាជន តិច ជាង កម្ពុជា នោះ ក៏ មាន អត្រា ឆ្លង ជំងឺ នេះ ច្រើន ជាង កម្ពុជា ឆ្ងាយ ណាស់ ដែរ ។
នៅពេល យើង ពិនិត្យ ទៅ លើ ទិដ្ឋភាព នេះ ទើប យើង អាច មើលឃើញ ថា ការ ដែល កម្ពុជា អាច គ្រប់គ្រង និង ទប់ស្កាត់ មិន ឱ្យ ជំងឺ កូវីដ១៩រីករាលដាល ខ្លាំង មិន មែន ជា រឿង សាមញ្ញ ឬ ផ្អែក លើ ព្រេង វាសនា នោះ ឡើយ ។ លទ្ធផល ដ៏ គាប់ ប្រសើរ គឺ បាន កើត ចេញ ភាពប្រាកដ និយម និង ច្បាស់លាស់ ក្នុង ការដឹកនាំ គ្រប់គ្រង និង ចាត់ចែង របស់ រាជ រដ្ឋាភិបាល ។
សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា អគ្គមេបញ្ជាការ កំពូល ក្នុង សមរភូមិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ សត្រូវ ឥត ស្រមោល នេះ បាន តាមដាន អង្កេត និង វាយតម្លៃ ដោយ ម៉ត់ចត់ មុននឹង ដាក់ ចេញ វិធានការ មួយ ដំណាក់ ៗ ជាមួយ ភាពប្រយ័ត្នប្រយែង និង ច្បាស់លាស់ ជា ទីបំផុត ។
មេដឹកនាំ ដែល មាន ជីវិត ជា អតីត យុទ្ធជន និង ជា មេបញ្ជាការលើ សមរភូមិ សង្គ្រាម ប្រយុទ្ធ រាប់ ភ្លេច រូប នេះ ត្រូវបាន គេ ដឹង ថា ជា មេបញ្ជាការ មួយ រូប មិន ដែល មើលងាយ សត្រូវ ឬ មើល ស្រាល សមរភូមិ សង្គ្រាម ម្តង ណា នោះ ឡើយ ព្រោះតែ ហេតុ បែប នេះ ហើយ ទើប ធ្វើឱ្យ មេបញ្ជាការ រូប នេះ ច្បាំង យកឈ្នះ ស្ទើរ គ្រប់ សមរភូមិ ។ បទពិសោធន៍ នេះ ក៏ បាន ក្រើន រំលឹក អគ្គ មេបញ្ជាការ កំពូល រូប នេះ មិន ឱ្យ មើល ស្រាល និង ធ្វេសប្រហែស ក្នុង សមរភូមិ សង្គ្រាម ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ដូចគ្នា ។
ដើម្បី ប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន អគ្គ មគ្គុទ្ទេសក៍ ដ៏ ឆ្នើម របស់ កម្ពុជា បាន ឆ្លើយតប បន្ទាន់ តាម ការដាក់ចេញ វិធានការចាំបាច់ ជា ច្រើន មាន ដូចជា ការសម្រេច បង្កើត គណៈកម្មការ ជាតិ ដែល ប្រមូលផ្តុំ សមាសភាព មក ពី គ្រប់ ក្រសួង ស្ថាប័ន និង អាជ្ញាធរ ក្រោម ជាតិ ដែល មាន សម្តេច ផ្ទាល់ ជា ប្រធាន ដើម្បី បញ្ជា ចាត់ចែង ការងារ ។
ក្រៅពី គណៈកម្មការ ថ្នាក់ ជាតិ ហើយ នោះ សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ បាន គណៈកម្មការ អន្តរ ក្រសួង មួយ ទៀត ដែល ជា អ្នក ប្រតិបត្តិការ ផ្ទាល់ លើ ការប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ ។ គណៈកម្មការ អន្តរ ក្រសួង នេះ មាន លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល ជា អ្នកដឹកនាំ ដោយ ផ្ទាល់ ហើយ មាន សមាសភាព មក ពី គ្រប់ ក្រសួង ស្ថាប័ន ។
ការអប់រំ ផ្សព្វផ្សាយ ពី វិធានការ ទប់ស្កាត់ និង ការពារ ជំងឺ កូវីដ១៩ ត្រូវបាន ផលិត ឡើង និង ផ្សព្វផ្សាយ យ៉ាង ទូលំទូលាយ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ និង បណ្តាញ សង្គម ព្រមទាំង ការចុះ ផ្សព្វផ្សាយ ដោយ ផ្ទាល់ នៅ តាម ភូមិឋាន របស់ ប្រជាពលរដ្ឋ ពីសំណាក់ ក្រុមការងារ ថ្នាក់ ជាតិ ។
ក្នុង កំលុង ពេល កម្ពុជា កើតមាន ជំងឺ កូវីដ១៩ ពី ខែមករា ដល់ ខែមេសា សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ មុខ ក្នុង សន្និសីទ ព័ត៌មាន ដ៏ កម្រ ចំនួន ៤លើក ដើម្បី ផ្ញើ សារ ទៅកាន់ ប្រជាពលរដ្ឋ ពី វិធានការ ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ រាតត្បាត ដ៏ កាច សាហាវ នេះ ។ តាមរយៈ សន្និសីទ ព័ត៌មាន នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន អំពាវនាវ ដោយ ផ្ទាល់ មាត់ ទៅកាន់ ប្រជាពលរដ្ឋ ឱ្យ ចូលរួម ប្រយុទ្ធ ប្រឆាំង ជំងឺ និង ការពារ ខ្លួន កុំ ឱ្យ ឆ្លង ជំងឺ ។
សរុម រួម មកការគ្រប់គ្រង ចាត់ចែង និង ដាក់ចេញ នូវ វិធានការ ដ៏ ច្បាស់លាស់ និង ម៉ត់ចត់ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ព្រមទាំង ការចូលរួម អនុវត្តន៍ ប្រកបដោយ ការយកចិត្តទុកដាក់ ពី មន្ត្រី គ្រប់ ក្រសួង ស្ថាប័ន ជាពិសេស មន្ត្រី ក្រសួង សុខាភិបាល និង ក្រុម គ្រូពេទ្យ ជា កងទ័ព អាវ ស ទាំង អ្នក នៅ ជួរ មុខ និង ជួរ ក្រោយ ជា លទ្ធផល ដ៏ គាប់ ប្រសើរ សម្រាប់ កម្ពុជា ទប់ស្កាត់ មិន ឱ្យ ជំងឺ កូវីដ១៩រីករាលដាល ខ្លាំង ។
លទ្ធផល ដ៏ គួរឱ្យ រីករាយ នេះ ក៏ មិន អាច កាត់ផ្តាច់ ផងដែរ ពី ការចូលរួម របស់ ប្រជាពលរដ្ឋ កម្ពុជា ទាំងមូល ពោល ប្រជាពលរដ្ឋ កម្ពុជា ប្រជាពលរដ្ឋ ល្អ បាន គោរព តាម បទបញ្ជា និង ការណែនាំ ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល និង មន្ត្រី ជំនាញ ដោយ អនុវត្តន៍ យ៉ាង ខ្ជាប់ខ្ជួន នូវ វិធាន អនាម័យ ក្នុង ការការពារ ជំងឺ ។
បើ ទោះបី ថា មកដល់ ថ្ងៃទី ១៦ ខែឧសភា មាន រយៈពេល ៣៣ ថ្ងៃ ដែល កម្ពុជា រក មិន ឃើញ មាន អ្នក កើត ជំងឺ កូវីដ១៩ ករណី ថ្មី ហើយ អ្នកជំងឺ ត្រូវបាន ព្យាបាល អស់ យ៉ាងណា ក្តី តែ មន្ត្រី ជំនាញ ក្រសួង សុខាភិបាល និង មន្ត្រី ជំនាញ របស់ អង្គការ សុខភាព ពិភពលោក ប្រចាំ នៅ កម្ពុជា បាន ព្រមាន ថា កម្ពុជា មិន ទាន់ ឆ្លង ផុត ពី ដំណាក់កាល នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ នោះ ឡើយ ហើយ នៅតែ ប្រឈម ចំពោះ រលក នៃ ការរីករាលដាល នៃ ដំណាក់កាល ទី ពីរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន គូស រំលេច ក្នុង សារលិខិត ជូន ពរ នេះ ថា ការរៀបចំ ប្រារព្ធ ខួប អនុស្សាវរីយ៍ លើក ទី ៧៥ ថ្ងៃ កំណើត នគរបាល ជាតិ កម្ពុជា មាន អត្ថន័យ សំខាន់ ៗ ពីរ សំខាន់ ។ ទី មួយ ដើម្បី ឧទ្ទិស រំលឹក ដល់ ស្នា ព្រះហស្ថ និង គុណូបការៈ របស់ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្តម សីហនុ ព្រះមហា វីរក្សត្រ « ព្រះបរម រតន កោដ្ឋ » ដែល ព្រះអង្គ បាន បង្កើត អង្គ ប្រតិបត្តិ ច្បាប់ នេះ ក្នុង ព្រះរាជ បំណង ធានា ស្ថិរភាព សន្តិសុខ សណ្ដាប់ធ្នាប់ សង្គម ។
ទី ពីរ គឺជា ការរំឭក ការចងចាំ នូវ ដំណើរ ឆ្លងកាត់ ជា ប្រវត្តិសាស្ត្រ របស់ រៀមច្បង នៃ កងកម្លាំង នគរបាល ជាតិ គ្រប់ ជំនាន់ ក្នុង បុព្វហេតុ សន្តិសុខ ជាតិ និង ភាពសុខសាន្ត របស់ ប្រជាពលរដ្ឋ ។
ខាងក្រោម ជា សារលិខិត ជូន ពរ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ផ្ញើ ជូន នគរបាល ជា តិ៖
ការសម្រេច ឲ្យ មាន ការនាំចេញ ស្រូវ អង្ករ ស និង ត្រី ឡើងវិញ នេះ ធ្វើឡើង ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ដ្រី នា ព្រឹក ថ្ងៃទី ១៥ ខែឧសភា ឆ្នាំ ២០២០ ក្រោម អធិបតីភាព សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន ផ្លូវការ លទ្ធផល នៃ សម័យ ប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ដ្រី បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « រាជ រដ្ឋាភិបាល សម្រេច ផ្តល់ ការអនុញ្ញាតឲ្យ ធ្វើការនាំចេញ ស្រូវ អង្ករ ស និង ត្រី ទៅ ក្រៅ ប្រទេស ឡើងវិញ ចាប់ពី ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២០ នេះ តទៅ ដូច មុនពេល ប្រកាស បិទ ដោយ ផ្អែក លើ តុល្យភាព ស្បៀង សម្រាប់ តម្រូវការ ក្នុង ប្រទេស បន្ទាប់ពី ត្រូវបាន ផ្អាក ការនាំចេញ នា ពេល កន្លងមក » ។
សូម ជម្រាប ថា ដើម្បី តុល្យភាព ស្បៀង សម្រាប់ តម្រូវការ ក្នុង ប្រទេស ក្នុង ពេល ជួបប្រទះ វិបត្តិ ជំងឺ កូវីដ១៩ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស បិទ ការនាំចេញ ស្រូវ អង្ករ ស ចាប់ អនុវត្តន៍ ពី ម៉ោង ២៣៖ ៥៩ នាទី ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២០ ការហាមឃាត់ ការនាំចេញ អង្ករ នេះ គឺ ហាមឃាត់ តែ អង្ករ ស និង ស្រូវ ប៉ុណ្ណោះ ចំពោះ អង្ករ ក្រអូប ត្រូវបាន អនុញ្ញាតឲ្យ នាំចេញ ធម្មតា ។
ជាមួយគ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន កាលពី ថ្ងៃទី ០៤ ខែមេសា ឆ្នាំ ២០២០ ក៏ បាន ដាក់ចេញ វិធានការ ឱ្យ ក្រសួង ពាក់ព័ន្ធ ហាមឃាត់ ការនាំចេញ ត្រី ទៅ ក្រៅ ប្រទេស ផងដែរ ដើម្បី ត្រៀម បម្រុងទុក កុំ ឱ្យ មាន ការខ្វះខាត លើ ស្បៀងអាហារ សម្រាប់ ប្រជាពលរដ្ឋ ។
