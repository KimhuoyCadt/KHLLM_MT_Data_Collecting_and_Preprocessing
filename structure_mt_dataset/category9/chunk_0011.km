( ភ្នំពេញ ) ៖ មន្ដ្រី យោធា ពាក់ ស័ក្ដិ ៤ កន្លះ ម្នាក់ ឈ្មោះ ជា សុខ ហេង បាន កាន់ កាំភ្លើង ចូល គំរាម ម្ចាស់ ផ្ទះសំណាក់ KIS ស្ថិត នៅ សង្កាត់ ចោម ចៅ៣ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ដោយ មិន ដឹង មូលហេតុ ។ ហេតុការណ៍ នេះ កើតឡើង នៅ វេលា ម៉ោង ជាង ១រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ០១ ខែឧសភា ឆ្នាំ ២០២០ ។
ម្ចាស់ ផ្ទះសំណាក់ រងគ្រោះ បាន បញ្ជាក់ ថា គាត់ និង មន្ដ្រី យោធា ខាងលើ មិន ដែល ឈ្លោះគ្នា អ្វី នោះ ទេ ប៉ុន្ដែ គ្រាន់តែ ធ្លាប់ ស្គាល់ គ្នា ដោយសារ ផ្ទះ មន្ដ្រី យោធា ខាងលើ នៅ ក្រោយ ផ្ទះសំណាក់ របស់ គាត់ ។ ប៉ុន្ដែ មិន ដឹង ថា មន្ដ្រី យោធា នោះ មាន គោលបំណង អ្វី នោះ ទេ បាន កាន់ កាំភ្លើង មក គំរាម និង ស្រែក ឡូឡា នៅមុខ ផ្ទះសំណាក់ របស់ គាត់ ផ្អើល គេ ឯង បែប នេះ ។
ដោយសារតែ មាន ភាពភ័យខ្លាច អំពី សុវត្ថិភាព ផ្ទាល់ខ្លួន លុះ ព្រឹកឡើង ម្ចាស់ ផ្ទះសំណាក់ រងគ្រោះ ខាងលើ បាន ទៅ ដាក់ពាក្យបណ្ដឹង នៅ មូលដ្ឋាន កងរាជអាវុធហត្ថ ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បីឲ្យ សមត្ថកិច្ច ជួយ អន្ដរាគមន៍ ដោះស្រាយ បញ្ហា នេះ ។
យ៉ាងណា ក៏ដោយ គេ មិន ទាន់ ដឹង ថា មន្ដ្រី យោធា ខាងលើ បម្រើ ការងារ នៅ អង្គភាព ណា នោះ ទេ ៕
លិខិត មិត្ត អ្នកអាន៖ « សម្រែក សារិកា ក្នុង ទ្រុង ស្រែក ព្រួយបារម្ភ ពី សេរីភាព ចាប នៅលើ ចុង ឈើ »
( ភ្នំពេញ ) ៖ ក្នុង ខណៈ ដែល ពិភពលោក កំពុង ប្រយុទ្ធ ប្រឆាំង យ៉ាង ខ្លាំងក្លា ជាមួយនឹង កូវីដ១៩ ដែល ជា សត្រូវ រួម របស់ មនុស្សជាតិ នៅលើ ផែនដី មាន បណ្តាញ ផ្សាយ ព័ត៌មាន ក្នុង ស្រុក និង ក្រៅ ប្រទេស កម្ពុជា មួយចំនួន ដែល ស៊ីឈ្នួល បម្រើ បរទេស ក៏ ដូចជា ក្រុម ដែល អះអាង តាំង ខ្លួន ថា ជា អ្នកវិភាគ ឯករាជ បាន នាំគ្នា និយាយ រិះគន់ វាយប្រហារ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ថា បាន យក បញ្ហា កូវីដ១៩ ដើម្បី បំបិទ សិទ្ធិ សេរីភាព សារព័ត៌មាន នៅ កម្ពុជា ។
ពួកគេ បាន ចាត់ទុក វិធានការប្រឆាំង ព័ត៌មាន ក្លែងក្លាយ និង វិធានការ ធ្វើចត្តាឡី ស័ក ឬ ក៏ ការរឹត បន្តឹង សេរីភាព ជួបជុំ ខ្លះ ៗ នៅ កម្ពុជា ថា ជា ការធ្វើឲ្យ ប៉ះពាល់ ដល់ សេរីភាព សារព័ត៌មាន ឬ ក៏ ប៉ះពាល់ ដល់ សិទ្ធិ បញ្ចេញមតិ ។ ប៉ុន្តែ ពួកគេ ភ្លេច គិត ថា វិធានការ ខ្លះ ៗ ដែល រដ្ឋាភិបាល ភ្នំពេញ បាន ដាក់ចេញ កាលពី ពេល កន្លងទៅ នេះ គឺ វា តិចតួច និង ស្រាល ណាស់ បើ ប្រៀបធៀប ទៅនឹង វិធានការ ក្នុង បណ្តា ប្រទេស ផ្សេង នៅ អាស៊ី យើង ជាពិសេស នៅ អឺរ៉ុប និង នៅ សហរដ្ឋ អាមេរិក ។
យើង ក៏ អាច និយាយ បាន ដែរ ថា រលក ទី១ នៃ កូវីដ១៩ ត្រូវបាន កម្ពុជា គ្រប់គ្រង បាន ដោយ ជោគជ័យ ខណៈពេល ដែល ប្រទេស ជាច្រើន ក្នុង តំបន់ និង ក្នុង ពិភពលោក កំពុង បន្ត រង ការវាយ ប្រហារ ពេញ ទំហឹង ពី មេរោគ ដ៏ ប្រល័យ នេះ ដែល បាន ឆ្លង ដល់ មនុស្ស ជាង ៣លាន នាក់ និង បាន សម្លាប់ មនុស្ស ជាង ២២ ម៉ឺន នាក់ ហើយ នៅ ជុំវិញ ពិភពលោក ។
អ្វី ដែល គួរឲ្យ អស់ សំណើច បំផុត នោះ គឺ ក្រុម មនុស្ស អគតិ និង អមិត្ត ទាំងនោះ បាន ចោទ ថា កម្ពុជា បាន យក បញ្ហា កូវីដ១៩ ដើម្បី បំបិទ សិទ្ធិ សេរីភាព សារព័ត៌មាន ខណៈពេល ដែល ខ្លួន ពួកគេ កំពុង រស់ នៅក្នុង ផ្ទះ មិន អាច ចេញ ទៅ ណា បាន ឡើយ រយៈពេល ជាច្រើន សប្តាហ៍ ឬ ច្រើន ខែ មក ហើយ នេះ ។ បើ និយាយ តាម បែប ផ្សេង វិញ វា មិន ខុស អ្វី ពី សត្វ សារិកា ដែល កំពុង ជាប់ នៅក្នុង ទ្រុង ហើយ ស្រែក ថា ព្រួយបារម្ភ អំពី សិទ្ធ សេរីភាព សត្វ ចាប ដែល កំពុង ហោះហើរ ដោយ សេរី នៅលើ ដើមឈើ នោះ ឡើយ ។
សរុប មកវិញ កម្ពុជា កំពុង បាន សុខ ហើយ . កម្ពុជា គ្រប់គ្រង កូវីដ១៩ បាន ល្អ ហើយ . កម្ពុជា គ្មាន អ្នក ស្លាប់ ដោយសារ មេរោគ នេះ ទេ ហើយ ប្រជាពលរដ្ឋ ខ្មែរ ក៏ ដូចជា អ្នកសារព័ត៌មាន ទាំងឡាយ ដែរ ក៏ កំពុង មាន សេរីភាព ពេញលេញ ដោយ មិន បានជាប់ ទ្រុង ដូច សារិកា ឡើយ ។
កម្ពុជា មិន បាន ទទួលរង ផល ប៉ះពាល់ សេដ្ឋកិច្ច ខ្លាំង ដូច បណ្តា ប្រទេស នៅ អឺរ៉ុប និង សហរដ្ឋ អាមេរិក ឡើយ ។ សេដ្ឋកិច្ច សង្គម កម្ពុជា ស្ថិត ក្នុង ស្ថានភាព ស្ទើរតែ ប្រក្រតី ដោយ មាន ការប៉ះពាល់ តិចតួច ប៉ុណ្ណោះ ។ កម្ពុជា ក៏ មិន បាន ប្រកាស ដាក់ ប្រទេស ក្នុង គ្រា អាសន្ន ដូច ដែល បណ្តាញ ផ្សាយ ព័ត៌មាន ភូត កុហក មួយចំនួន លើកឡើង ដើម្បី មួល បង្កាច់ និង បំភិតបំភ័យ នោះ ដែរ ។
មូលនិធិ « ម៉ានី » និង ដៃ គូ សហការ នាំយក អំណោយ មួយចំនួន ចែកជូន ដល់ សង្កាត់ ទាំង ១០៥ សង្កាត់ ក្នុង រាជធានី ភ្នំពេញ ដើម្បី បន្ត ចែកជូន ប្រជាជន ជួប ការលំបាក
ដោយឡែក ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ លោក សំហេង បុរស សមាជិក ក្រុមប្រឹក្សាភិបាល តំណាង លោក ហ៊ុន ម៉ានី ប្រធាន ក្រុមប្រឹក្សាភិបាល មូលនិធិ « ម៉ានី » បាន នាំយក អំណោយ ទៅ ចែកជូន ៤សង្កាត់ ដោយ មួយ សង្កាត់ ចំនួន ១០០ កញ្ចប់ ។
នា ឱកាស នេះ លោក សំហេង បុរស សមាជិក ក្រុមប្រឹក្សាភិបាល មូលនិធិ ម៉ានី បាន ឲ្យដឹង ថា « នេះ គឺជា ការចាប់ផ្តើម មួយ របស់ មូលនិធិ « ម៉ានី » ហើយ ទៅ ថ្ងៃ ខាងមុខ ទៀត មូលនិធិ « ម៉ានី » នឹង ខិតខំ កសាង កម្លាំង សាមគ្គីភាព ឱ្យ បាន ធំ និង ទូលំទូលាយ មួយ សម្រាប់ ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា និង ស្ថាប័ន ផ្សេង ៗ ទៀត ក្នុង ការជួយគាំទ្រ ប្រជាជន កម្ពុជា នៅ ទូទាំង ប្រទេស » ។
ក្នុង ន័យ នេះ លោក សំហេង បុរស បញ្ជាក់ បន្ថែម ថា ក្រុមហ៊ុន ស្ថាប័ន សប្បុរសជន សាធារណជន និង ប្រជាពលរដ្ឋ គ្រប់ ប្រភេទ ទាំងអស់ អាច ចូលរួម ជាមួយ មូលនិធិ ម៉ានី ក្នុង ការបម្រើ ឧត្តម ប្រយោជន៍ ប្រជាជន កម្ពុជា ឱ្យ បាន កាន់តែ ច្រើន និង ទូលាយ ថែម ទៀត ។
មន្ត្រី ជំនាញ ផ្នែក ជំងឺ ឆ្លង វ័យ ៧៩ ឆ្នាំ រូប នេះ បាន សង្កត់ធ្ងន់ ម្តង ហើយ ម្តង ទៀត នូវ ភាពចាំបាច់ ក្នុង ការចាត់ វិធានការ ដ៏ តឹងរ៉ឹង រួមទាំង ការពង្រីក គោលការណ៍ ណែនាំ សង្គម របស់ រដ្ឋាភិបាល សហព័ន្ធ បន្ថែម ទៀត ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ COVID-19 តាំងពី ដើមទី មក ម្ល៉េះ ខណៈ ដែល លោក ប្រធានាធិបតី ដូណាល់ ត្រាំ នៅ ពេល នោះ បាន ព្យាយាម មើល ស្រាល ស្ថានការណ៍ ៕
បើ តាម លោក ឡុង ឌីម៉ង់ ពលរដ្ឋ ខ្មែរ ខាងលើ នេះ មាន អាយុ ២១ ឆ្នាំ គឺជា និស្សិត ដែល កំពុង សិក្សា នៅ ចក្រភព អង់គ្លេស ហើយនិស្សិត រូប នេះ ធ្លាប់ មាន អាការៈ ផ្តាសាយ នៅ អង់គ្លេស ទើប គ្រួសារ គាត់ ឲ្យ មក ស្រុក ខ្មែរ ស្រប ពេល នឹង សាលា ឲ្យ សិស្ស ទាំងអស់ សម្រាក ពី ការសិក្សា ។ លុះ ធ្វើដំណើរ ចេញ ពី ប្រទេស អង់គ្លេស ហើយ ត្រូវ ដូរ ជើងហោះហើរ នៅ ទីក្រុង សេអ៊ូល កាលពី ថ្ងៃអាទិត្យ ទី ២៦ ខែមេសា ឆ្នាំ ២០២០ ស្រាប់តែ អាជ្ញាធរ សុខាភិបាល កូរ៉េ ខាងត្បូង រកឃើញ ថា គាត់ មាន ផ្ទុក ជំងឺ កូវីដ - ១៩ ។
អង្គការ NASA ជ្រើសរើស ក្រុមហ៊ុន អាមេរិក ចំនួន ៣ ឲ្យ អភិវឌ្ឍ យាន ដើម្បី នាំ ក្រុម អវកាសយានិក ទៅ ចុះ លើ ផ្ទៃ ព្រះច័ន្ទ នៅ ឆ្នាំ ២០២៤
ស .ស.ស .ក បាន បន្ត ថា សុខភាព ពោលគឺ សិទ្ធិ រស់រាន មាន ជីវិត ក្នុង ពេលនេះ នៅតែ ជា អាទិភាព ចម្បង បំផុត និង មាន តម្លៃ ជាង អ្វី ៗ ទាំងអស់ ។ ដរាបណា អាយុជីវិត ត្រូវបាន ថែរក្សា ការពារ ល្អ ប្រសើរ ទើប មនុស្ស គ្រប់ ៗ រូប មាន ឱកាស អនុវត្ត សិទ្ធិ ដទៃ ទៀត រួមទាំង សិទ្ធិ សេរីភាព សារព័ត៌មាន និង សិទ្ធិ បញ្ចេញមតិ ផងដែរ ។
សហភាព សហព័ន្ធ អ្នកសារព័ត៌មាន កម្ពុជា រួម ជាមួយ ប្រជាជន កម្ពុជា ពិតជា មាន ការត្រេកអរ ដែល កម្ពុជា មាន អ្នក ឆ្លង ជំងឺ នេះ ក្នុង អត្រា ទាប ហើយ ពលរដ្ឋ ដែល ឆ្លង ជំងឺ នេះ ក៏ ទទួល ការយកចិត្តទុកដាក់ ជួយ ព្យាបាល ពីសំណាក់ ក្រុម វេជ្ជបណ្ឌិត រហូត បាន ជាសះស្បើយ ជិត អស់ ហើយ ដោយ គ្មាន អ្នកណា ម្នាក់ រងគ្រោះ ដល់ អាយុជីវិត ឡើយ ។
សហភាព សហព័ន្ធ អ្នកសារព័ត៌មាន កម្ពុជា សូម យក ឱកាស ទិវា សេរីភាព សារព័ត៌មាន ឆ្នាំ នេះ ប្រែក្លាយជា ថ្ងៃ នឹករលឹក និង ការដឹងគុណ ដល់ រៀមច្បង សារព័ត៌មាន របស់ យើង សរុប ១៨ រូប ដែល ពួកគាត់ បាន ដឹក ដៃ អ្នក ទាំងឡាយ ក្នុង វិស័យ នេះ ឆ្លងកាត់ ដំណាក់កាល នីមួយ ៗ ហើយ ឥឡូវ ពួកគាត់ ខ្លះ ក្លាយជា ព្រឹទ្ធាចារ្យ និង មាន វ័យ ជរា ទៅ ហើយ ។
គួរ ជម្រាប ថា ថ្ងៃសៅរ៍ នេះ គឺជា ថ្ងៃទី ៣៩ ហើយ នៃ វិធានការបិទ ប្រទេស នៅ ទូទាំង ឥណ្ឌា ដែល ត្រូវបាន ដាក់ចេញ ដើម្បី ទប់ទល់ ការរាតត្បាត នៃ COVID-19 ។ វិធានការបិទ ប្រទេស នេះ ត្រូវបាន រដ្ឋាភិបាល ឥណ្ឌា ប្រកាស កាលពី ថ្ងៃទី ២៥ ខែមីនា ហើយ កាលពី យប់ ថ្ងៃសុក្រ ម្សិលមិញ ត្រូវបាន សម្រេច ពន្យារ ពេល ជាថ្មី ម្តង ទៀត ឲ្យ ដល់ ថ្ងៃទី ១៧ ខែឧសភា ខណៈ កន្លងមក វា ត្រូវ ផុត នៅ ថ្ងៃទី ០៣ ខែឧសភា ។
នៅក្រោម វិធានការបិទ ប្រទេស នេះ ការធ្វើដំណើរ តាម ផ្លូវ អាកាស ផ្លូវ ដែក ផ្លូវ រថភ្លើង ក្រោម ដី ព្រមទាំង ការធ្វើដំណើរ ឆ្លង រដ្ឋ តាម ផ្លូវគោក នឹង នៅតែ មិន អនុញ្ញាត ដដែល ។ រីឯ សាលារៀន សណ្ឋាគារ ភោជនីយដ្ឋាន រោង ភាពយន្ត ផ្សារ ទំនើប ក្លឹប ហាត់ប្រាណ និង កីឡដ្ឋាន នឹង នៅតែ ត្រូវ បន្ត បិទ ទ្វារ ខណៈ ការជួបជុំ ប្រមូលផ្តុំ គ្នា នៅតែ ស្ថិត ក្រោម ការហាមឃាត់ ។ ប៉ុន្តែ រដ្ឋាភិបាល ឥណ្ឌា បាន បញ្ជាក់ ថា នឹង ផ្តល់ ការបន្ធូរបន្ថយ ភាពរឹតត្បិត នៅ តាម តំបន់ មួយចំនួន ដែល ពុំ មាន ករណី ឆ្លង ថ្មី ៗ ៕
បើ បូក បញ្ជូល ករណី ឆ្លង ថ្មី ដែល ជា ករណី នាំចូល ០១ករណី ខាងលើ នេះ វា ធ្វើឲ្យ ចំនួន ករណី ឆ្លង សរុប ទាំងអស់ នៅ ទូទាំង ចិន ដី គោក បាន កើន ដល់ ៨២. ៨៧៥ ករណី ខណៈ តួលេខ នៃ ករណី អ្នកស្លាប់ គឺ នៅ រក្សា បាន ត្រឹម ៤.៦៣៣ នាក់ ដដែល ពោលគឺ គ្មាន ករណី ស្លាប់ ឡើយ សូម្បីតែ ម្នាក់ នៅក្នុង រយៈពេល ដូចគ្នា នេះ ។
ក្រៅពី នោះ សត្វ ទោច មកុដ ផ្សេង ទៀត ដែល បាន ដោះលែង នា ពេល កន្លងមក គឺ នៅ ខ្លោងទ្វារ ខ្មោច មាន ចំនួន ៤ ក្បាល និង នៅ ខ្លោងទ្វារ តា កាវ មាន ចំនួន ២ ក្បាល កំពុង ផ្សាំ ក្នុង ទ្រុង ហើយ គ្រោង នឹង ដោះលែង នៅ រដូវ វស្សា ខាងមុខ នេះ ។ សរុប នៅ ឧទ្យាន អង្គរ សត្វ ទោច មកុដ ទាំងអស់ មាន ចំនួន ១១ ក្បាល ។
ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ក្រុមការងារ គ្រោង នឹង យក ២ ក្បាល បន្ថែម ទៀត ដាក់ នៅក្បែរ បឹង សន្ធ មារ ( ខាងជើង ឈៀង ខាងលិច ក្នុង បរិវេណ តំបន់ អង្គរ ធំ ) ក្រោយពី សង់ ទ្រុង សម្រាប់ ផ្សាំ រួចរាល់ ។
ដើម្បីឲ្យ សត្វ ព្រៃ ទាំងអស់ នោះ បន្ត វត្តមាន នៅក្នុង ព្រៃ ធម្មជាតិ នៃ ឧទ្យាន អង្គរ និង បង្កើន ចំនួន បន្ថែម ទៀត អាជ្ញាធរ ជាតិ អប្សរា និង គម្រោង ដោះលែង សត្វ ព្រៃ ក្នុង ឧទ្យាន អង្គរ បាន អំពាវនាវ ជូន សាធារណជន ភ្ញៀវ ជាតិ អន្តរជាតិ ជាពិសេស ប្រជាពលរដ្ឋ ដែល រស់ នៅ តំបន់ អង្គរ សូម ត្រូវ ចូលរួម ថែរក្សា សត្វ ទាំងនោះ ទាំងអស់ គ្នា ៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ លោកជំទាវ សុទ្ធ សុមាលី និង ក្រុម មហា វេស្សន្តរ ឧបត្ថម្ភ ថវិកា ១លាន រៀល ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ឆ្នាំ ២០២០
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បន្ថែម ថា « ទោះបី ចំនួន អ្នក ដែល ឆ្លង មេរោគ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ច្រើន ស្ទើរ អស់ ហើយ ក្តី ហើយ មក ទល់ ថ្ងៃ នេះ ក៏ ពុំ មាន អ្នក ឆ្លង ថ្មី ក៏ដោយ ក៏ សូម បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ដោយ ប្រើ ម៉ាស ទឹក អាល់កុល និង ជែល លាង សម្អាត កម្ចាត់ មេរោគ និង បាក់តេរី ផ្សេង ៗ ឱ្យ បាន ជាប្រចាំ » ។
ទន្ទឹមនឹង ការអំពាវនាវ ប្រជាពលរដ្ឋ ឱ្យ ថែទាំ សុខភាព កុំ ឱ្យ ឆ្លង ជំងឺ កូវីដ ហើយ នោះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន អំពាវនាវ ប្រជាពលរដ្ឋ ជាពិសេស យុវជន ត្រូវតែ គោរព ច្បាប់ ចរាចរណ៍ ព្រោះ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល បាន កើតឡើង រាល់ ថ្ងៃ បាន សម្លាប់ អាយុជីវិត ពលរដ្ឋ ច្រើន ជាង ជំងឺ ឆ្លង កូវីវីដ ១៩ទៅ ទៀត ៕
ជា ការកត់សម្គាល់ ការយក រថយន្ដ សម្រុក ទៅ ឆៀក នេះ ធ្វើឡើង បន្ទាប់ពី រាជ រដ្ឋាភិបាល បាន ចេញ អនុក្រឹត្យ បង្កើន ការ ផាកពិន័យ ចំពោះ អ្នកបើកបរ ល្មើស ច្បាប់ ស្ដីពី ចរាចរណ៍ ផ្លូវគោក ហើយ ត្រូវ គណៈកម្មាធិការ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក កំណត់ ឲ្យ អនុវត្ត ចាប់ពី ថ្ងៃទី ០១ ខែឧសភា ឆ្នាំ ២០២០២ត ទៅ ។
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ឧកញ៉ា គង់ ប៊ុន ហាវ និង លោកជំទាវ អប់ សុភាព ដែល បាន ឧបត្ថម្ភ ថវិកា ១០.០០០ ដុល្លារ ( មួយ ម៉ឺន ដុល្លារ អាមេរិក ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី ចូលរួម អបអរសាទរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ សន្តិភាព និង កាកបាទ ក្រហម កម្ពុជា »៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ លោកស្រី យស សុគន្ធា និង ស្វាមី សៀ យី ចិន ឧបត្ថម្ភ ថវិកា ១លាន រៀល ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ឆ្នាំ ២០២០
៤៖ ចក្រភព អង់គ្លេស មាន ករណី ឆ្លង សរុប ១៧៧. ៤៥៤ ករណី ក្នុង នោះ ស្លាប់ ២៧. ៥១០ នាក់ និង ចំនួន អ្នក ជាសះស្បើយ ឡើងវិញ នៅតែ មិន មាន បញ្ជាក់ ។
គម្រោង វិនិយោគ ថ្មី ៗ ទាំង ៣៧ នោះ រួម មាន៖
អ្នក ដែល ជាសះស្បើយ ជា បុរស ជនជាតិ ខ្មែរ អាយុ ៥៨ ឆ្នាំ ស្នាក់ នៅក្នុង សណ្ឋាគារ មួយ នៅ ក្រុង ព្រះសីហនុ ( ជា អ្នក ប៉ះពាល់ ផ្ទាល់ ជាមួយ ក្រុម អ្នកទេសចរ បារាំង មាន វីរុស កូវីដ - ១៩ នៅ ក្រុង ព្រះសីហនុ និង ជា អ្នកគ្រប់គ្រង និង ធ្វើ បដិសណ្ឋារកិច្ច ផ្ទាល់ ជាមួយ ភ្ញៀវ ទេសចរ បារាំង ទាំងអស់ នោះ ) ត្រូវបាន ព្យាបាល ជាសះស្បើយ ដោយ ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ ចំនួន ០២ ដង និង ត្រូវបាន អនុញ្ញាតឱ្យ ចេញ ពី បន្ទប់ ព្យាបាល ក្នុង សណ្ឋាគារ មួយ នៅ ក្រុង ព្រះសីហនុ ៕
UNCT កោតសរសើរ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការឆ្លើយតប បាន យ៉ាង ឆាប់រហ័ស និង ទាន់ ពេលវេលា គ្រប់គ្រង ករណី វិជ្ជមាន កូវីដ ទាំង ១២២ នាក់ បាន ល្អ ដោយ ព្យាបាល ជាសះស្បើយ សឹង ទាំងអស់
ការថ្លែង បែប នេះ របស់ លោកស្រី ក្នុង កិច្ចប្រជុំ រវាង គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ជាមួយ ក្រុម ទីភ្នាក់ងារ អង្គការ សហ ប្រជាជាតិ ប្រចាំ កម្ពុជា ដែល មាន ការចូលរួម ស្រុក ចំនួន ទាំងអស់ ប៉ុន្មាន ១១០ នាក់ នៅ ចុង ខែមេសា នេះ ។
លោកស្រី បន្ដ ថា « ប៉ុន្ដែ ការងារ របស់ យើង នៅ ពុំ ទាន់ ចប់ នៅឡើយ ទេ ដូចគ្នា នឹង ប្រទេស នានា ទាំងអស់ ដែរ យើង ត្រៀមខ្លួន និង កែលំអ វិធី ដែល យើង ឆ្លើយតប នឹង ជំងឺ កូវីដ១៩ ដើម្បី យើង អាច បញ្ឈប់ ឬ ពន្សឹត ការឆ្លង វីរុស នេះ និង កាត់បន្ថយ ឱ្យ នៅ កម្រិត អប្បបរមា នូវ ផល ប៉ះពាល់ ដល់ សុខភាព សង្គម និង សេដ្ឋកិច្ច ។ យើង សង្ឃឹម ថា អ្វី ៗ នឹង ល្អ ឡើងវិញ ប៉ុន្ដែ ត្រូវ ត្រៀម សម្រាប់ ករណី ធ្ងន់ធ្ងរ » ។
សម្រាប់ កម្ពុជា ក៏ អាច ជួបប្រទះ នឹង កត្តា ប្រឈម និង ផល ប៉ះពាល់ ជាច្រើន ក្រៅពី វិស័យ សុខាភិបាល ដូចជា វិស័យ អប់រំ ទេសចរណ៍ ពាណិជ្ជកម្ម សេដ្ឋកិច្ច និង វិស័យ ឧស្សាហកម្ម ផងដែរ ។
សូម ជម្រាប ថា ដោយ មាន ការបេ្តជ្ញាចិត្ត ក្រោម ការដឹកនាំយក ចិត្តទុកដាក់ ប្រកបដោយ ភាពឈ្លាសវៃ និង គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ផែនការ មេ បទបញ្ជា និង វិធានការ នានា ព្រមទាំង ការឆ្លើយតប បន្ទាន់ ត្រូវបាន ដាក់ចេញ ឲ្យ អនុវត្ត នៅ ទូទាំង ប្រទេស ដើម្បី ការពារ ទប់ស្កាត់ ការរីករាលដាល នៃ វីរុស កូវីដ - ១៩ បាន រហ័ស ទាន់ ពេលវេលា ក្រោម យន្តការសម្របសម្រួល និង គ្រប់គ្រង ដោយ៖
១៖ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ដឹកនាំ ផ្ទាល់ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា
២៖ គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ដឹកនាំ ដោយ ឯកឧត្តម រដ្ឋមន្ត្រី ផ្ទាល់
ជាមួយគ្នា នេះ កម្ពុជា បាន បង្កើត និង កំពុង អនុវត្ត នូវ ផែនការ មេ សម្រាប់ ឆ្លើយតប នឹង ជំងឺ កូវីដ - ១៩ ដែល ផ្តោត លើ សេណារីយ៉ូ ០៣ ផ្សេង ៗ គ្នា ។ លើស ពី នេះ ទៀត ដើម្បី ឆ្លើយតប ទៅនឹង ជំងឺ រាតត្បាត ជា សកល នេះ ក្រសួង ពាក់ព័ន្ធ នានា ក៏ បាន បង្កើត គណៈកម្មការ និង ក្រុមការងារ មួយ ចំនួន ទៀត ផងដែរ ។
ជាក់ស្តែង ចំពោះ ការឆ្លើយតប សុខភាព សាធារណៈ របស់ កម្ពុជា លើ ការរាតត្បាត នៃ វីរុស កូវីដ - ១៩ នេះ ត្រូវបាន ធ្វើឡើង ជាបន្ទាន់ ដោយ មាន ការពិគ្រោះយោបល់ ជាមួយ អង្គការ សុខភាព ពិភពលោក និង ដៃគូ ពាក់ព័ន្ធ នានា ដែល ផ្តោត លើ អន្តរាគមន៍ អាទិភាព ចំនួន ០៩ រួម មាន៖
១៖ ការរៀបចំ ផែនការ និង ការគ្រប់គ្រង ហេតុការ ចំពោះ មុខ
២៖ ការតាមដាន និង ការវាយតម្លៃ ហានិភ័យ
៣៖ ការពង្រឹង សមត្ថភាព មន្ទីរពិសោធន៍
៤៖ សេវា ថែទាំ សុខភាព និង ការគ្រប់គ្រង ការព្យាបាល
៥៖ ការបង្ការ និង ត្រួតពិនិត្យ ការចម្លង រោគ
៦៖ វិធានការ សុខភាព សាធារណៈ
៧៖ ទំនាក់ទំនង ហានិភ័យ
៨៖ ការគ្រប់គ្រង ច្រក ចេញ ចូល នៅ ព្រំដែន
៩៖ ប្រតិបត្តិការ ភស្តុភារ ឱសថ និង បរិក្ខារ ពេទ្យ ៕ ពលរដ្ឋ ខ្វះខាត រស់ នៅ លើ ភ្នំ ជាប់ ព្រំដែន ថៃ ក្នុង ស្រុក អន្លង់ វែង ទទួលបាន អំណោយ ពី ក្រុមហ៊ុន ឯកជន
( ឧត្តរមានជ័យ )៖ ប្រជាពលរដ្ឋ ក្រីក្រ រស់ នៅ តំបន់ លើ ភ្នំ ជាប់ ព្រំដែន ថៃ ស្ថិត ក្នុង ភូមិ ជាំ ( អូរ ថ្ម ) ឃុំ ត្រពាំង ប្រីយ៍ ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ នៅ ព្រឹក ថ្ងៃទី ០២ ខែឧសភា ឆ្នាំ ២០២០ នេះ ទទួលបាន អំណោយ សង្រ្គោះ បន្ទាន់ ពី ក្រុមហ៊ុន ឯកជន ឈ្មោះ ថា សាម៉ន ខេមរៈ អភិវឌ្ឍន៍ ។
លោក ផល សាម៉ន បាន គូសបញ្ជាក់ ថា ក្រុមការងារ បាន នាំ អំណោយ ចែកជូន ប្រជាពលរដ្ឋ តាម ខ្នង ផ្ទះ ដោយ មិន ធ្វើ ការប្រមូលផ្តុំ នោះ ទេ ការធ្វើ បែប នេះ គឺ ក្នុង គោលបំណង រួមចំណែក ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។ លោក ក៏ ធ្វើ ការណែនាំ ប្រជាពលរដ្ឋ ត្រូវ អនុវត្ត ឲ្យបាន ទៀងទាត់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដើម្បី ការពារ ជំងឺ កូវីដ១៩ កុំ ឲ្យ កើតមាន លើ សមាជិក គ្រួសារ និង សហគមន៍ ។
ប្រជាពលរដ្ឋ បាន សម្តែង នូវ ការអរគុណ ចំពោះ ក្រុមហ៊ុន សាម៉ន ខេមរៈ អភិវឌ្ឍន៍ ក៏ ដូចជា អជ្ញាធរ មូលដ្ឋាន ដែល បាន គិតគូរ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ ពួកគាត់ ព្រោះ ស្រប ពេល ដែល ជំងឺ កូវីដ១៩ កំពុងតែ កើត មាន ឡើង នៅលើ សកលលោក បាន ធ្វើឲ្យ ជីវភាព រស់ នៅ របស់ ពួកគាត់ ជួប បញ្ហា ដែល កាលពី មិន ទាន់ មាន ជំងឺ កូវីដ១៩ នេះ ពួកគាត់ រស់ នៅ តាម ព្រំដែន អាច ប្រកបរបរ ទទួលទាន បាន ដូចជា រុញ រទេះ ទំនិញ រត់ មូតូ ឌុប និង លក់ដូរ ... ជាដើម ។
របាយការណ៍ របស់ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន ឲ្យដឹង ថា កម្ពុជា សំរេច ការនាំចេញ អង្ករ របស់ ខ្លួន ក្នុង រយៈពេល ៤ខែ ដំបូង នៃ ឆ្នាំ ២០២០ បាន ជាង ៣០ម៉ឺន តោន ដែល បរិមាណ នេះ ស្មើនឹង ជាង ៤៨% នៃ ការនាំចេញ សរុប របស់ ឆ្នាំ ២០១៩ ។
ការនាំចេញ ៤ខែ ដំបូង មាន ចំនួន ៣០០.២៥២ តោន គឺ មាន កំណើន ចំនួន ៤១ % បើ ប្រៀប ជាមួយ ៤ខែ ដើម ឆ្នាំ ២០១៩ ដែល នាំចេញ បាន ប្រមាណ ត្រឹម ចំនួន ២១៣ .៧៦៣ តោន តែ ប៉ុណ្ណោះ ។ នេះ ជា កំណើន មួយ ដែល គួរឲ្យ កត់សំគាល់ បំផុត របស់ កម្ពុជា ដែល បាន សំរេច ការនាំចេញ មាន តួលេខ ខ្ពស់ បំផុត ក្នុង រយៈពេល ៤ខែ ដើម ឆ្នាំ នៃ ការនាំចេញ របស់ កម្ពុជា ក្នុង រយៈពេល ១០ឆ្នាំ ចុងក្រោយ ។
ដោយឡែក សំរាប់ ខែមេសា ឆ្នាំ ២០២០ ទោះបី រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ យកចិត្តទុកដាក់ គិតគូរ យ៉ាង ហ្មត់ចត់ ចំពោះ សន្តិសុខ ស្បៀង សំរាប់ ប្រជាពលរដ្ឋ កម្ពុជា ដោយ ផ្អាក ការនាំចេញ « អង្ករស » មួយ រយៈពេល ខ្លី ក៏ដោយ ក៏ ការនាំចេញ អង្ករ ក្រអូប របស់ កម្ពុជា បាន សម្រេច ជាង ៦៩ ពាន់ តោន ដែល ផ្តល់ នូវ តំលៃ មួយ យ៉ាង ខ្ពស់ សំរាប់ អាជីវករ និង អ្នករកស៊ី នៅក្នុង វិស័យ ស្រូវ អង្ករ ។
ការនាំចេញ អង្ករ កម្ពុជា ក្នុង ខែមេសា ឆ្នាំ ២០២០ សង្កេតឃើញ ថា ជាង ៣៩% គឺ បាន នាំ ទៅ ប្រទេស នៅ ទ្វីប អ៊ឺរ៉ុប ជាង ៣០% ទៅ ប្រទេស ចិន ជាង ១៣% ទៅ បណ្តា ប្រទេស នៅក្នុង រដ្ឋ សមាជិក អាស៊ាន ជាពិសេស ប្រទេស ម៉ាឡេស៊ី និង ព្រុយណេ ហើយ ១៨% ទៅកាន់ តំបន់ ផ្សេង ៗ ដែល ក្នុង នោះ ប្រទេស អូស្ត្រាលី ញូហ្សេឡែន មាន ការកើនឡើង គួរឲ្យ កត់សំគាល់ ។ ការនាំចេញ នេះ គឺ មាន កំណើន ជាង ៦១% បៀបធៀប ទៅ ខែមេសា ឆ្នាំ ២០១៩ ដូចគ្នា ។
លោក សុង សារ៉ន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « អ្វី ដែល មើលឃើញ កំណើន កើន ខ្លាំង រយៈពេល ៤ខែ នេះ កើន ទៅ លើ ទីផ្សារ ថ្មី របស់ យើង និង កំណើន ទីផ្សារ សហគមន៍ អ៊ឺរ៉ុប ងើប ឡើងវិញ . ទីផ្សារ ថ្មី យើង ឃើញ មាន ហុងកុង លោត ខ្លាំង មែនទែន ហើយ អូស្ដ្រាលី ក៏ មាន ការកើនឡើង ខ្លាំង ដែរ » ។
លោក បន្ដ ថា « ទីផ្សារ ថ្មី ដែល យើង កសាង មក នេះ គឺជា ទីផ្សារ មួយ ដែល មាន គុណភាព ដែល ពេញនិយម ទៅ លើ ការប្រើប្រាស់ អង្ករ ប្រភេទ ក្រអូប របស់ យើង នេះ ជា ក្ដីសង្ឃឹម របស់ យើង មួយ សម្រាប់ ពង្រីក ការនាំចេញ អង្ករ ក្រអូប នា ពេល ខាងមុខ »៕ ស្វែងយល់៖ « ការប្រឹងប្រែង ខួង ចូល ស្រទាប់ រឹង នៃ ភព ផែនដី ដោយ ក្រុម ប្រទេស មហា អំណាច »
ក្រសួង បរិស្ថាន នឹង បន្ត ចាត់ វិធានការ ផ្លូវ ច្បាប់ ប្រឆាំង នឹង ជនល្មើស ដែល បាន រុករាន ទន្ទ្រាន កាន់កាប់ ដី ព្រៃ នៅក្នុង តំបន់ ដែន ជម្រក សត្វ ព្រៃ ទាំង ៤
រដ្ឋលេខាធិការ និង ជា មន្ត្រី នាំ ពាក្យ ក្រសួង បរិស្ថាន លោក នេត្រ ភក្ត្រា បាន គូសបញ្ជាក់ ថា៖ « គ្មាន ជន ណា ម្នាក់ មាន សិទ្ធិ កាន់កាប់ ដីធ្លី ទិញ ឬ លក់ដូរ ដីធ្លី នៅក្នុង តំបន់ ការពារ ធម្មជាតិ បាន ឡើយ » ។
រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន រូប នេះ ក៏ បាន ថ្លែង បញ្ជាក់ ថា « ក្រសួង បរិស្ថាន សូម បដិសេធ នូវ រាល់ ឯកសារ ពាក់ព័ន្ធ នឹង ការកាន់កាប់ ដី ដោយ ខុស ច្បាប់ គ្រប់ ប្រភេទ ដូចជា ការទន្ទ្រាន កាន់កាប់ ការផ្ទេរ ការទិញ លក់ ដី ដោយ ខុស ច្បាប់ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ » ។
( កណ្ដាល ) ៖ នគរបាល ក្រុង តាខ្មៅ ខេត្ត កណ្តាល បាន ឃាត់ខ្លួន ចោរ ឆក់ ២នាក់ គ្រា ដែល ពួកគេ បាន ធ្វើ សកម្មភាព ឆក់ កាបូប ដៃ ពលរដ្ឋ នៅ តាម ផ្លូវ បណ្ដាលឱ្យ របួស ៣នាក់ ប្ដី - ប្រពន្ធ កូន រីឯ ខាង អង្គរក្ស ម្នាក់ រងរបួស ចំ កញ្ចឹងក ផងដែរ ដោយសារ ត្រូវ មួយ ដុំ ថ្ម របស់ ក្រុម ចោរ ។ នៅក្នុង ហេតុការណ៍ នេះ ពេល ឃើញ ចោរ ឆក់ ហើយ ព្យាយាម បើក រត់ នគរបាល ក្រុង តាខ្មៅ និង ក្រុម អង្គរក្ស តាម ប្រដេញ ពីក្រោយ យ៉ាង ប្រសេចប្រសាច ផ្អើល ក្រុង តាខ្មៅ ដូច ក្នុង រឿង ហុងកុង ហើយ ឈានដល់ ការចាប់ខ្លួន ចោរ ឆក់ ដៃ ឆើត បាន សម្រេច ។
សកម្មភាព ប្រដេញ ចាប់ ចោរ ដៃ ឆើត នេះ បាន បង្ក ការភ្ញាក់ផ្អើល នៅ ម៉ោង ៣ទៀប ភ្លឺ ថ្ងៃទី៣០ ខែមេសា កន្លងទៅ ចំណុច តាម ផ្លូវ ២១ មុខ ផ្ទះសំណាក់ ភ្នំ មាស ភូមិ សំរោង៣ សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល ។
លោក បន្ត ថា ជនរងគ្រោះ មាន គ្នា ចំនួន ៣នាក់ ប៉ុន្តែ ពុំ ស្គាល់ ឈ្មោះ ឡើយ ព្រោះ ពេល មាន គ្រោះថ្នាក់ ភ្លាម សាច់ញាតិ បាន មក យក ទៅ មន្ទីរពេទ្យ បាត់ និង គ្មាន ដាក់ពាក្យ ប្ដឹង នោះ ដែរ ដោយ ដឹង តែ ពួកគេ មាន របួស ស្នាម ដូច ជា៖
រីឯ ជនសង្ស័យ វិញ មាន គ្នា ចំនួន ២នា ក់៖
* ទី១៖ ឈ្មោះ មឿន រដ្ឋា អាយុ ១៦ ឆ្នាំ មាន ទីលំនៅ ភូមិ ព្រែក សំរោង១ សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល មុខរបរ មិន ពិតប្រាកដ * ទី២៖ ឈ្មោះ ពិសិដ្ឋ វឌ្ឍនៈ អាយុ ១៧ ឆ្នាំ មាន ទីលំនៅ ភូមិ ព្រែក សំរោង សង្កាត់ តា ខ្មៅ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល មុខរបរ មិន ពិតប្រាកដ ។
ចំពោះ វត្ថុង តាង ចាប់ យក បាន រួម មាន៖
លោក អធិការ បាន រៀបរាប់ សាច់រឿង ថា កាលពី ពេលវេលា កើត ជនរងគ្រោះ ៣នាក់ ឪពុក ម្តាយ និង កូនស្រី បាន នាំគ្នា ជិះ ម៉ូតូ ដឹក ត្រី ទៅ លក់ នៅ ផ្សារ ដោយ ឪពុក ជា អ្នកបើក ម៉ូតូ ចំណែក ម្តាយ និង កូនស្រី អង្គុយ ខាងក្រោយ លើ កេះ ដាក់ ឡាំត្រី ។
ពេល នោះ ស្រាប់តែ ឃើញ ជនសង្ស័យ ២នាក់ ជិះ ម៉ូតូ ១ គ្រឿង បាន ធ្វើ សកម្មភាព ឆក់ កាបូប របស់ គាត់ បណ្តាលឲ្យ ជនរងគ្រោះ ទាំង ៣នាក់ ដួល ម៉ូតូ លើ ថ្នល់ មាន របួស ស្នាម ទាំងអស់ គ្នា ។ ជួន ពេល នោះ ក៏ ជួប នឹង កម្លាំង ល្បាត របស់ បញ្ជាការដ្ឋាន អង្គរក្ស ក៏ បាន ជិះ ដេញ តាម តែ ត្រូវ ជនសង្ស័យ យក ដុំ ថ្ម គប់ ទៅ លើ កម្លាំង អង្គរក្ស ចំក ខាងឆ្វេង បណ្តាលឲ្យ មាន របួស ស្នាម ។
លោក បន្ត ទៀត ថា ក្រោយ កើត ហេតុ ជនរងគ្រោះ ទាំង ៣នាក់ ត្រូវ បងប្អូន ដឹក យក ទៅ ព្យាបាល នៅ មន្ទីពេទ្យ បាត់ ទៅ រួច កម្លាំង សមត្ថកិច្ច ប៉ុស្តិ៍ តា ខ្មៅ បាន ប្រដេញ ចាប់ខ្លួន ចោរ ឆក់ នោះ ប្រសេចប្រសាច ទំរាំ ចាប់ បាន ជនសង្ស័យ និង វត្ថុតាង យកមក ចាត់ការ តាម នីតិវិធី តែម្តង ។
លោក អធិការ បញ្ជាក់ ទៀត ថា តាម ចម្លើយ សារភាព របស់ ជនសង្ស័យ បាន ឆ្លើយ ថា ពួក ខ្លួន ធ្លាប់ បាន ធ្វើ សកម្មភាព ឆក់ កាបូប គេ បាន សម្រេច ចំនួន ២ដង គឺ លើក ទី១ នៅ គល់ ស្ពាន ព្រែក សំរោង កាលពី ៣ខែ មុន បាន ទូរស័ព្ទ ១គ្រឿង និង លើក ចុងក្រោយ ដូច ករណី រៀបរាប់ ខាងលើ មិន បាន សម្រេច ហើយក៏ ត្រូវ សមត្ថកិច្ច ឃាត់ខ្លួន បាន ពិតប្រាកដ មែន ។
ជនសង្ស័យ ទាំង ២រូប ត្រូវបាន នគរបាល ក្រុង តាខ្មៅ កសាង សំណុំរឿង តាម នីតិវិធី ៕
ពលរដ្ឋ រងគ្រោះ ដោយសាខ្យល់ កន្រ្តាក់ ៣០៥ គ្រួសារ នៅ ស្រុក មុខ កំពូល ខេត្ត កណ្ដាល ទទួលបាន អំណោយ ពី រដ្ឋបាល ខេត្ត និង ក្រុមការងារ
( កណ្ដាល ) ៖ ក្រុម ប្រជាពលរដ្ឋ ឃុំ ព្រែក ដំបង ចំនួន ៣០៥ គ្រួសារ ដែល រងគ្រោះ ដោយសារ ខ្យល់ កន្ត្រាក់ ធ្វើឱ្យ ប៉ះពាល់ ដល់ ផ្ទះ សំបែង និង ខូចខាត ទ្រព្យសម្បត្តិ នោះ ត្រូវបាន លោក តាំង ម៉េង លាន អភិបាល រង ខេត្ត កណ្ដាល អម ដំណើរ ដោយ លោក អេង ទូច ប្រធាន ក្រុមការងារ ចុះ ជួយ ឃុំ ព្រែក ដំបង ព្រមទាំង មន្ត្រី ជាច្រើន នាក់ ចុះ សួរសុខទុក្ខ និង ចែក អំណោយ ព្រមទាំង ផ្សព្វផ្សាយ វិធានការ ជុំវិញ បញ្ហា វីរុស កូវីដ - ១៩ ផងដែរ ។
សកម្មភាព ជំនួប ជាមួយ ពលរដ្ឋ នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី១ ខែឧសភា ឆ្នាំ ២០២០ ខណៈ ដែល ខ្យល់ កន្ត្រាក់ បាន វាយប្រហារ អ្នកភូមិ ទាំង ៣០៥ គ្រួសារ នៅ ឃុំ ព្រែក ដំបង កាលពី ថ្ងៃទី ២៥ ខែមេសា កន្លងទៅ ។
លោក តាំង ម៉េង លាន បាន លើកឡើង ថា ក្នុង នាម លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល គឺ អាជ្ញាធរ មិន ទុក ឱ្យ ពលរដ្ឋ ណា ម្នាក់ មាន ការលំបាក ឡើយ ពិសេស នៅ គ្រា មាន អាសន្ន អន់ ក្រ លោក អភិបាល ខេត្ត តែងតែ យកចិត្តទុកដាក់ ជួយ ដល់ ប្រជាពលរដ្ឋ ជានិច្ច ។
