( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា លាង ម៉េង ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ធនាគារ ជី ប ម៉ុង បាន សម្តែង ការអបអរសាទរ ជូន ឯកឧត្តម កេង សុម៉ារិទ្ធ ត្រូវបាន សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ប្រមុខរដ្ឋ ស្ដី ទី បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋលេខាធិការ ក្រសួង យុត្ដិធម៌ ។
ក្នុង ឱកាស ដ៏ វិសេសវិសាល នេះ លោក ឧកញ៉ា លាង ម៉េង សូម ជូនពរ ឯកឧត្តម កេង សុម៉ារិទ្ធ សូម មាន សុខភាព ល្អ បរិបូរណ៍ ពលានុភាព មាំមួន ក្លៀវក្លា ប្រាជ្ញា ភ្លឺ ថ្លា ឆ្លាតវៃ ដើម្បី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី បព្វហេតុ វិស័យ យុត្តិធម៌ សម្រាប់ ប្រជាជាតិ មួយ នេះ និង សម្រាប់ ប្រជាពលរដ្ឋ កម្ពុជា ទាំងមូល ៕ ស្នងការ នគរបាល ខេត្ត ស្វាយរៀង ចុះ ណែនាំ កងកម្លាំង រឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ត្រូវ អនុវត្តន៍ ច្បាប់ ឱ្យ បាន ត្រឹមត្រូវ និង ប្រកបដោយ សុជីវធម៌ ខ្ពស់
( ស្វាយរៀង ) ៖ លោក ឧត្តមសេនីយ៍ ទោ កឹង ឃ ន ស្នងការ នគរបាល ខេត្ត ស្វា រៀង ព្រមទាំង ស្នងការ រង នគរបាល ខេត្ត នៅ ព្រឹក ថ្ងៃទី ០១ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន ចុះ ពិនិត្យ និង ណែនាំ កម្លាំង ចម្រុះ នៅ គ្រប់ គោលដៅ ទូទាំង ខេត្ត ក្នុង ប្រតិបត្តិការ ត្រួតពិនិត្យ ការរឹតបន្តឹង ការអនុវត្តន៍ ច្បាប់ ចរាចរណ៍ ផ្លូវគោក តាម អនុក្រឹត្យ លេខ ៣៩ ន អន ក្រ. បក ត្រូវ អនុវត្តន៍ ច្បាប់ ឱ្យ បាន ត្រឹមត្រូវ និង មាន សុជីវធម៍ ខ្ពស់ ជាមួយ ពលរដ្ឋ ផងដែរ ។
បើ នគរបាល ចរាចរណ៍ ខេត្ត ស្វាយរៀង មាន គោលដៅ ត្រួតពិនិត្យ មាន ចំនួន ១៩ គោលដៅ ( ការិយាល័យ ៣ គោលដៅ និង ក្នុង ១ក្រុង / ស្រុក ចំនួន ២ គោលដៅ ស្មើនឹង ១៦ គោលដៅ ) មាន កម្លាំង ចម្រុះ រួម ២៣១ នាក់ ( កម្លាំង នគរបាល ១៧៦ នាក់ អាវុធហត្ថ ១៥នាក់ និង ប្រជាការពារ ៤០ នាក់ ។
លោក ឧកញ៉ា លាង ឃុន ផ្ញើ សារ អបអរសាទរ ជូន ឯកឧត្តម កេង សុម៉ារិទ្ធ ដែល ត្រូវបាន តែងតាំង ជា រដ្ឋលេខាធិការ ក្រសួង យុត្តិធម៌
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា លាង ឃុន ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ក្រុមហ៊ុន ជី ប ម៉ុង បាន សម្តែង ការអបអរសាទរ ជូន ចំពោះ ឯកឧត្តម កេង សុម៉ារិទ្ធ ត្រូវបាន សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ប្រមុខរដ្ឋ ស្ដី ទី បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋលេខាធិការ ក្រសួង យុត្ដិធម៌ ។
ជាមួយនឹង ការផ្តល់ ស្ថានទូត ហើយ នោះ ក៏ ត្រូវ ភ្ជាប់ មក ជាមួយ នូវ ឯកសារ ដូច ជា៖
ជាមួយគ្នា នេះ ស្ថានទូត តម្រូវឲ្យ បងប្អូន ផ្ញើ ព័ត៌មាន ខាងលើ ឱ្យ បាន មុន ថ្ងៃទី៧ ខែឧសភា ឆ្នាំ ២០២០ ៕
ព័ត៌មាន លម្អិត សូម អាន សេចក្តីជូនដំណឹង ទាំង ស្រុង៖
លោក វង្សី វិស្សុត៖ បច្ចុប្បន្ន រាជ រដ្ឋាភិបាល កំពុង រៀបចំ និង ដាក់ ចេញ គោល នយោបាយ និង កម្មវិធី ជំនួយ សង្គម ក្នុង អំឡុង ពេល ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩
លោក វង្សី វិស្សុត បាន វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ការងារ ជាច្រើន ដែល សម្រេចបាន នៅក្នុង ពេល កន្លងមក លើ គ្រប់ វិស័យ ទាំង ផ្នែក ពុទ្ធ ចក្រ និង អាណាចក្រ ពិសេស ការដោះស្រាយ បញ្ហា និង សំណូមពរ របស់ ប្រជាជន នៅក្នុង មូលដ្ឋាន និង ការធ្វើ សកម្មភាព សង្គម និង មនុស្សធម៌ ផ្សេង ៗ ដូចជា ការជួយ ឧបត្ថម្ភ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ដែល ខ្វះខាត ជីវភាព និង ងាយ រងគ្រោះ នៅក្នុង មូលដ្ឋាន ឃុំ ទាំង៧ ក្នុង ស្រុក មុខ កំពូល ។
ជាង នេះ ទៅ ទៀត មន្រ្តី គណបក្ស ទាំងអស់ ត្រូវ ចូលរួម គ្រប់គ្រង គ្រប់ សមរភូមិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ នេះ ឱ្យ បាន ល្អ ដោយ ត្រូវ ចេះ ប្រើប្រាស់ វិបត្តិ នៃ ជំងឺ នេះ ឱ្យ ក្លាយទៅជា ឱកាស ក្នុង ការបម្រើ ប្រជាជន ឱ្យ ល្អ ដើម្បី ទាក់ទាញ ការគាំទ្រ បន្ថែម ពី ប្រជាជន និង កាន់តែ មាន សមត្ថភាព ចេះ ប្រឈម ដោះស្រាយ និង ទប់ស្កាត់ នឹង វិបត្តិ នានា ទៅ ថ្ងៃ មុខ ទាំង វិបត្តិ បណ្តាល មកពី សេដ្ឋកិច្ច ឬ ជំងឺ ដង្តាត់ ផ្សេង ៗ ។ លោក ក៏ បាន សម្រេច បង្កើត មូលនិធិ ប្រយុទ្ធ នឹង ជំងឺ កូវិដ - ១៩ នៅក្នុង ស្រុក មុខ កំពូល ផងដែរ ។
លោក ក៏ បាន ណែនាំ ដល់ មន្រ្តី គណបក្ស ត្រូវ បន្ត រក្សា សាមគ្គីភាព ផ្ទៃ ក្នុង បក្ស រឹងមាំ និង រួម ដៃ គ្នា ក្នុង ការបម្រើ ប្រទេសជាតិ និង ប្រជាជន ដោយ ស្មោះត្រង់ ពិសេស ការផ្តល់ សេវា សាធារណៈ ផ្សេង ៗ ជូន ប្រជាជន ។ ទន្ទឹមនឹង នេះ ត្រូវ បន្ត សកម្មភាព មនុស្សធម៌ និង កម្មវិធី ជំនួយ សង្គម ដល់ ប្រជាជន ក្រីក្រ ខ្វះខាត ជីវភាព និង ងាយ រងគ្រោះ តែ ត្រូវ ធ្វើ យ៉ាងណា កំណត់ អត្តសញ្ញាណកម្ម ឱ្យ ចំ គោលដៅ និង ច្បាស់លាស់ ។
ជាមួយគ្នា នេះ ក៏ ត្រូវ យកចិត្តទុកដាក់ ដល់ បញ្ហា បរិស្ថាន . អនាម័យ និង ការការពារ ទ្រព្យសម្បត្តិ រដ្ឋ ដូចជា បឹងបួរ ជាដើម ឱ្យ បាន គង់វង្ស ។ ក្រៅពី នេះ ក៏ ត្រូវ ពង្រឹង ការអនុវត្ត ច្បាប់ ដើម្បី បន្ត លុបបំបាត់ អំពើ ខុស ច្បាប់ នានា ពិសេស បញ្ហា គ្រឿងញៀន និង ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ។
លោក ក៏ បាន សម្រេច បង្កើត ក្រុមការងារ ចំពោះ កិច្ច មួយចំនួន ដើម្បី ដោះស្រាយ បញ្ហា មួយចំនួន នៅក្នុង ស្រុក មុខ កំពូល ។ នៅក្នុង ឱកាស នោះ ដែរ លោក ក៏ បាន ណែនាំ ដល់ មន្រ្តី គណបក្ស ឱ្យ បន្ត ចលនា ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ចូលរួម គាំទ្រ ដល់ យុទ្ធនាការ រឹតបន្តឹង ការអនុវត្ត ច្បាប់ ចរាចរណ៍ ដោយ គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ដើម្បី ចូលរួមចំណែក កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ៕
« ក្លឹប រ៉ូត ថា រី » បន្ត នាំ សម្ភារ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ជូន មន្ទីរពេទ្យ ខេត្ត បាត់ដំបង
កញ្ញា អុឹង ជឺ អុី និង លោក ឈរ វែង ងួន បាន បង្ហាញ ការជឿជាក់ ថា ជំនួយ នេះ ជា ការរួមគ្នា ដើម្បី ជៀស ផុត ពី ការរីករាលដាល នៃ ជំងឺ និង ធ្វើឱ្យ សង្គម មាន ស្ថេរភាព និង ធ្វើឱ្យ ប្រទេស កាន់តែ រឹងមាំ ។
គួរ ជម្រាប ថា ថ្ងៃសុក្រ នេះ ជា ថ្ងៃទី ៣៨ហើយ នៃ ការអនុវត្ត វិធានការបិទ ប្រទេស របស់ រដ្ឋាភិបាល ឥណ្ឌា ដើម្បី ទប់ទល់ ការឆ្លង រាលដាល នៃ ជំងឺ COVID-19 ដែល ត្រូវបាន ដាក់ ចេញ កាលពី ថ្ងៃទី ២៥ ខែមីនា ហើយ ត្រូវបាន ពន្យារ ទៅដល់ ថ្ងៃទី ០៣ ខែឧសភា ។ សម្រាប់ នៅ ថ្ងៃទី ០៤ ខែឧសភា គោលការណ៍ ណែនាំ ថ្មី ស្តីពី ការបន្ត ប្រយុទ្ធ ប្រឆាំង COVID-19 នឹង ត្រូវ ដាក់ ឲ្យ អនុវត្ត ដោយ តំបន់ ជាច្រើន នៅ ប្រទេស ឥណ្ឌា នឹង ទទួល ការបន្ធូរបន្ថយ ការរឹតបន្តឹង ៕
ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ ចេញ បំភ្លឺ ក្រោយ មាន ជន អគតិបង្ហោះ តាម បណ្ដាញ សង្គម ពាក់ព័ន្ធ កម្លាំង នគរបាល ហ្វឹកហាត់ ត្រៀម ចុះល្បាត បង្ក្រាប បទល្មើស តាម ព្រំដែន ជាមួយ វៀតណាម
( តាកែវ )៖ អ្នកនាំពាក្យ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ បាន ចេញ លិខិត បំភ្លឺ ជូន សាធារណជន ឲ្យបាន ជ្រាប ក្រោយ មាន ជន អគតិ មួយចំនួន បង្ហោះ តាម បណ្ដាញ សង្គម ដោយ ផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ពាក់ព័ន្ធ នឹង កម្លាំង នគរបាល ធ្វើ ការហ្វឹកហាត់ ដើម្បី ត្រៀម ចុះល្បាត បង្ក្រាប បទល្មើស ជាពិសេស បទល្មើស គ្រឿងញៀន តាម ព្រំដែន ជាមួយ ប្រទេស វៀតណាម ។
ក្នុង ន័យ នេះ អ្នកនាំពាក្យ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ សូម រំលឹក ជូន ថា កាលពី ថ្ងៃទី ២៧ - ២៨ ខែសីហា ឆ្នាំ ២០១៩ ក្រសួង ការពារ ជាតិ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ក្រសួង ការពារ ជាតិ នៃ សាធារណៈ រដ្ឋ សង្គម និយម វៀតណាម បាន រៀបចំ ពិធី ជួប ប្រាស្រ័យ មិត្តភាព ព្រំដែន ( កម្ពុជា - វៀតណាម ) ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ ក្នុង ការបង្ការ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ឆ្លង ដែន គ្រប់ ប្រភេទ ជាពិសេស បទល្មើស គ្រឿងញៀន ឆ្លងកាត់ ព្រំដែន នៃ ខេត្ត ទាំង បី ។
ចំពោះ ការបង្ហោះ ផ្សព្វផ្សាយ នូវ ខ្លឹមសារ ខាងលើ គឺជា ការប្រឌិត ទាំងស្រុង ខុសពី រូបភាព និង ខ្លឹមសារ ពិត ដែល មាន ចេតនា ញុះញង់ បំពុល សង្គម និង បង្ករ ឱ្យ មាន ការរើសអើង ជាតិ សាសន៍ បង្កើត ឱ្យ មាន អសន្តិសុខ នៅ តាម ព្រំដែន ផ្ទុយ ពី សកម្មភាព ជាក់ស្តែង របស់ កងកម្លាំង នគរបាល ជាតិ ដែល ខិតខំ ថែរក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ សង្គម បង្កើន ភាព សុខដុមរម្យ នា នៅ តាម បន្ទាត់ ព្រំដែន ជូន ប្រជាពលរដ្ឋ នៃ ប្រទេស ទាំង ពីរ ៕
ក្រុមហ៊ុន ក្នុង ស្រុក បើក កសិដ្ឋាន ចិញ្ចឹម បង្គា បែប ធម្មជាតិ លើ ផ្ទៃដី ១០០ ហិកតា នៅ ខេត្ត ព្រះសីហនុ . រដ្ឋមន្ដ្រី កសិកម្ម លើកទឹកចិត្ដ ឲ្យ ខិតខំ ពង្រីក ការចិញ្ចឹម បន្ថែម ទៀត
( ព្រះសីហនុ) ៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ អម ដំណើរ ដោយ លោក អេង ជា សាន ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា ប្រធាន រដ្ឋបាល ជលផល . លោក គង់ វីតាណៈ អភិបាល រង ខេត្ត និង សហការី នា ព្រឹក ថ្ងៃទី ០១ ខែឧសភា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ចុះ មក ពិនិត្យ ពី វឌ្ឍនភាព នៃ ការអភិវឌ្ឍ កសិដ្ឋាន ចិញ្ចឹម បង្គា បែប ធម្មជាតិ របស់ ក្រុមហ៊ុន ហេង ហេង ដែល មាន ទីតាំង ស្ថិត នៅ ភូមិ អូរ ចំណារ ឃុំ អូរ ឧកញ៉ា ហេង ស្រុក ព្រៃនប់ ខេត្ត ព្រះសីហនុ ។
ចំពោះ កម្រៃ ក្នុង ១ ឆ្នាំ អាច រក ចំណូល បាន ១ម៉ឺន ដុល្លារ ( ដក ប្រាក់ ចំណាយ រួច ) ដោយ បង្គា ធម្មជាតិ មាន តម្លៃ ៥ ទៅ ៧ដុល្លារ ក្នុង មួយ គីឡូ ។ បង្គា ធម្មជាតិ នេះ ទីផ្សារ កំពុង ពេញនិយម ណាស់ ជាពិសេស តាម ភោជនីយដ្ឋាន ធំ ៗ នៅ ខេត្ត ព្រះសីហនុ និង នៅ ភ្នំពេញ ។ អនាគត គ្រោង នឹង ពង្រីក ផ្ទៃដី ចិញ្ចឹម បន្ថែម ភ្ញាស់ កូន បង្គា និង កូន ក្តាម លក់ ជូន ប្រជានេសាទ ក្នុង តំបន់ នេះ ព្រមទាំង បង្កើត សិប្បកម្ម បង្គា ក្រៀម ផងដែរ ។
ដោយឡែក កសិករ ដែល ធ្លាប់ តែ ធ្វើ ស្រែ ទទួល ផល តាម យថា កម្ម បច្ចុប្បន្ន ងាក មក ប្រកាន់ យក របរ ចិញ្ចឹម បង្គា តាម បែប ធម្មជាតិ ហើយ នឹង ពង្រីក ផ្ទៃដី បន្ថែម ដោយ អនុវត្ត ផលិតកម្ម កសិកម្ម តាម កិច្ចសន្យា ជាមួយ ក្រុមហ៊ុន ។
មិន តែ ប៉ុណ្ណោះ លោក វេង សាខុន ក៏ បាន សម្តែង នូវ ការ គាំទ្រ ចំពោះ ឆន្ទៈ ពង្រីក ផ្ទៃដី ចិញ្ចឹម នា ពេល អនាគត ដែល វា នឹង ចូលរួមចំណែក បង្កើន ផលិតផល បង្គា ធម្មជាតិ សម្រាប់ ទីផ្សារ ក្នុង ស្រុក និង ធ្វើ ការកែច្នៃ សម្រាប់ នាំចេញ ថែរក្សា បរិស្ថាន និង សុខភាព អ្នក បរិភោគ ។
ដោយឡែក សម្រាប់ តែ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ មាន ម៉ូតូ និង រថយន្ដ ៩៨០ គ្រឿង ដែល សមត្ថកិច្ច ធ្វើ ការឃាត់ ដោយសារ ការ ល្មើស ច្បាប់ ចរាចរណ៍ នេះ ក្នុង នោះ មាន ម៉ូតូ ៩០០ គ្រឿង និង រថយន្ត ៨០ គ្រឿង ។
វិធានការរឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក នេះ គឺ ដាក់ ចេញ ដើម្បី ឆ្លើយតប នឹង ភាពអាសន្ន នៃ គ្រោះថ្នាក់ ចរាចរណ៍ ដែល មាន កំណើន យ៉ាង គំហុក កាលពី ឆ្នាំ កន្លងទៅ បាន បណ្ដាលឱ្យ មាន អ្នកស្លាប់ របួស ពិការ បង្កឱ្យ មាន កុមារ កំព្រា និង ការវិនាស ព្រាត់ប្រាស់ ក្នុង គ្រួសារ ទាំង នៅក្នុង ស្ថានភាព ដែល ប្រទេសជាតិ បាន ចាក ផុត ពី ភ្លើង សង្គ្រាម មាន សន្តិភាព និង ការអភិវឌ្ឍន៍ ទៅ ហើយ នោះ ។
មុននឹង ចាប់ផ្តើម អនុវត្តន៍ នូវ ការរឹតបន្តឹង ច្បាប់ នេះ មន្ត្រី នគរបាល ចរាចរណ៍ បាន ធ្វើ ការផ្សព្វផ្សាយ អស់ ពេល មួយ រយៈ កន្លងមក ហើយ ។
ជាមួយគ្នា នេះ ចំពោះ ការដំឡើង កម្រិត ផាក ពិន័យ សម្ដេច បាន ផ្ដល់ ការពន្យល់ ជូន ទៅ វិញ បងប្អូន ប្រជាពលរដ្ឋ ថា មិន មែន មាន ន័យ ថា ក្រសួង មហាផ្ទៃ អគ្គ ស្នងការ ឬ អង្គភាព នគរបាល ចរាចរណ៍ ដែល ដឹកនាំ និង អ្នក អនុវត្ត ច្បាប់ ចង់បាន ប្រាក់ ពី ប្រពលរដ្ឋ នោះ ទេ ។ ផ្ទុយទៅវិញ នេះ គឺជា ការថែរក្សា ប្រាក់ និង ថែរក្សា សុវត្ថិភាព ជូន ពលរដ្ឋ ទៅ វិញ ទេ ៕
បញ្ជូន ជន ដៃ ដល់ ដែល ប៉ង រំលោភ និង សម្លាប់ កម្មការិនី រោងចក្រ នៅ ខណ្ឌ មានជ័យ ទៅ តុលាការ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី១ ខែឧសភា ឆ្នាំ ២០២០ នេះ នគរបាល ខណ្ឌ មានជ័យ បាន បញ្ជូន ជន ដៃ ដល់ វង់ ភារម្យ ដែល ប៉ង រំលោភ និង សម្លាប់ នារី រងគ្រោះ ជា កម្មការិនី ម្នាក់ នៅ សង្កាត់ ស្ទឹងមានជ័យ ទី៣ ខណ្ឌ មានជ័យ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ប្រគល់ ឱ្យ តំណាង អយ្យការ បើក ការស៊ើបសួរ និង ចោទប្រកាន់ តាម ច្បាប់ ។
លោក វរសេនីយ៍ ឯក ម៉េង វិមាន តារា បាន បញ្ជាក់ ថា ជនសង្ស័យ ដែល សមត្ថកិច្ច ឃាត់ខ្លួន ឈ្មោះ វង់ ភារម្យ អាយុ ២៨ ឆ្នាំ មុខរបរ កម្មករ សំណង់ ( មាន ផ្ទុក សារធាតុ ញៀន ) ទីលំនៅ បន្ទប់ ជួល គ្មាន លេខ ផ្លូវ បេតុង ភូមិ ទ្រា៤ សង្កាត់ ស្ទឹងមានជ័យ ទី៣ ខណ្ឌ មានជ័យ មុខរបរ កម្មករ សំណង់ ។ ដោយឡែក ជនរងគ្រោះ ឈ្មោះ ស៊ាត ស៊ន អាយុ ២៨ ឆ្នាំ មុខរបរ កម្មការិនី រោងចក្រ ។
លោក អធិការ បាន ប្រាប់ អំពី ដំណើរ រឿង ថា នៅ មុនពេល កើត ហេតុ ជនសង្ស័យ បាន យក កូន កាំបិទ ចិត បន្លែ ដើរ ចូល បន្ទប់ នារី ជនរងគ្រោះ គំរាម ចាប់រំលោភ តែ នារី ជនរងគ្រោះ មិន ព្រម ក៏ ជនសង្ស័យ យក កូន កាំបិត ចិត បន្លែ ចាក់ ទៅ នារី រងគ្រោះ ហើយ យក ជ្រុញ និង ឆ្នាំង បាយ វាយ ក្បាល ជនរងគ្រោះ បន្ថែម បណ្តាលឲ្យ ស្លាប់ តែម្តង ។
បន្ទាប់មក ជនសង្ស័យ បាន រត់គេចខ្លួន ពី កន្លែង កើត ហេតុ ទៅ លួច ម៉ូតូ របស់ គេ ក្បែរ កន្លែង ហេតុ ដើម្បី គេច ក៏ ត្រូវបាន កម្លាំង សមត្ថកិច្ច ធ្វើ ការស្រាវជ្រាវ ឃាត់ខ្លួន តែម្តង ៕
( ភ្នំពេញ ) ៖ លោកស្រី ឥន លី ម្មី ប្រធាន អនុសាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ខណ្ឌ ចំការមន និង លោកស្រី កែវ សាម៉ុល អភិបាល រង ខណ្ឌ និង សហការី នៅ ព្រឹក ថ្ងៃទី ០១ ខែឧសភា ឆ្នាំ ២០២០ បាន ចុះ ផ្សព្វផ្សាយ អប់រំ ផ្តល់ ចំណេះដឹង ស្តីពី វិធានការ ការពារ ទប់ស្កាត់ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ COVID-19 និង ចែក អំណោយ សប្បុរសធម៌ ជូន ដល់ ប្រជាពលរដ្ឋ តាម ខ្នង ផ្ទះ ដែល ជួប ការខ្វះខាត ចំនួន ២០ គ្រួសារ រស់ នៅ ភូមិ ៩ និង ភូមិ ១៦ សង្កាត់ ទន្លេបាសាក់ ។
លោកស្រី បាន ថ្លែង ថា ប្រទេស កម្ពុជា យើង នៅតែ មាន ហានិភ័យ ទទួលរង នូវ ការវាយលុក ពី វីរុស កូវីដ១៩ (COVID-19) គ្រប់ ពេលវេលា និង គ្រប់ ទីកន្លែង បើសិនជា យើង ភ្លេច ខ្លួន មិន មាន ការប្រុងប្រយ័ត្ន នោះ ទោះ ក្នុង រយៈពេល មក នេះ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា រក មិន ឃើញ ករណី ថ្មី និង មាន អ្នក ជាសះស្បើយ ជា បន្ដ បន្ទាប់ ដោយ បច្ចុប្បន្នសល់ អ្នក ឈឺតែ ៣នាក់ ដែល កំពុងតែ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ នៃ អ្នក ឆ្លង សរុប ១២២ នាក់ នេះ ។
លោកស្រី ថ្លែង បន្ដ ថា « សូម កុំ ភ្លេច ខ្លួន យើង អាច ភ្លេច កូវីដ១៩ បាន គ្រប់ ពេលវេលា ក៏ប៉ុន្ដែ កូវីដ១៩ មិន ភ្លេច យើង នោះ ឡើយ ដូច្នេះ សូម បន្ដ ប្រុងប្រយ័ត្ន និង អនុវត្ដ ដៃ ស្អាត ជាប់ ជានិច្ច » ។
ក្នុង កម្មវិធី មនុស្សធម៌ នេះ លោកស្រី ឥន លី ម្មី បាន លើកឡើង អំពី ការមើលឃើញ ជាក់ស្ដែង ពី ការលំបាក របស់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ និង មាន ជំងឺ ។ លោកស្រី ក៏ បាន ពាំនាំយក អង្ករ និង ឃីត ដែល ជា អំណោយ របស់ កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ មក ឧបត្ថម្ភ ជូន ដើម្បី ជួយ សម្រួល ដល់ ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ពោលគឺ មិន ឲ្យ ប្រជាពលរដ្ឋ ស្លាប់ ដោយ អត់ បាយ ឡើយ ។
បន្ថែម ពី នេះ លោកស្រី ឥន លី ម្មី ក៏ បាន ពាំនាំ នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ និង ការដឹកនាំ ចង្អុលបង្ហាញ ចំ គោលដៅ ពីសំណាក់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា គឺ ត្រូវ ឲ្យ យកចិត្តទុកដាក់ ខ្ពស់ លើ ប្រជាពលរដ្ឋ ក្រីក្រ លំបាក ចាស់ជរា ជួប ការខ្វះខាត ឬ គ្មាន ទីពឹង ជាដើម « ពោលគឺជា ជន ងាយ រងគ្រោះ » ដាច់ខាត មិន ត្រូវ មើល រំលង ឡើយ ។
នា ឱកាស នោះ ប្រជាពលរដ្ឋ ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ ក្រុមការងារ អនុសាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ ខណ្ឌ ដែល ដឹកនាំ ដោយ លោកស្រី ឥន លី ម្មី ប្រធាន អនុសាខា សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ តំណាង ឲ្យ លោក ថេង សុថុល ប្រធាន អនុសាខា កាកបាទ ក្រហម កម្ពុជា និង ជា អភិបាល ខណ្ឌ ៕
របាយការណ៍ របស់ នាយកដ្ឋាន ដឹកជញ្ជូន ផ្លូវគោក នៃ ក្រសួង សាធារណការ បាន បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ទៅ ទទួល សេវា ធ្វើ ប្តូរ ឬ ពន្យារ បណ្ណ បើកបរ នៅ ទូទាំង ប្រទេស គិត ចាប់ពី ថ្ងៃទី ១៥ ដល់ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២០ មាន ចំនួន សរុប ១៣. ៩៩៦ នាក់ ក្នុង នោះ រួម មាន៖
