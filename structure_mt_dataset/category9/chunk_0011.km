( ភ្នំពេញ ) ៖ កាន់តែ អស្ចារ្យ និង ងាយស្រួល ជាង មុន ទៅ ទៀត ជាពិសេស សម្រាប់ អ្នក រស់ នៅ និង ធ្វើការ នៅ ប្រទេស កូរ៉េ ខាងត្បូង អាច ធ្វើ ការផ្ញើ ប្រាក់ មក ប្រទេស កម្ពុជា បាន តាមរយៈ ធនាគារ កូមីន ហើយ អ្នកទទួល អាច ដក តាមរយៈ ភ្នាក់ងារ និង ការិយា របស់ អេ អឹម ខេ ទូទាំង ប្រទេស បាន យ៉ាង រហ័ស និង មាន សុវត្ថិភាព ខ្ពស់ ។
គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ អេ អិម ខេ ភីអ៊ិល ស៊ី នៅ រសៀល ថ្ងៃទី ១៥ មេសា ឆ្នាំ ២០២០ បាន លើកឡើង ក្នុង សេចក្តីប្រកាស ព័ត មាន ថា សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល កំពុង រស់ នៅ និង ធ្វើការ នៅ កូរ៉េ ខាងត្បូង ដែល មាន បំណង ចង់ ផ្ញើ ប្រាក់ មក កម្ពុជា គ្រា ដែល មិន អាច មក ប្រទេស កំណើត ក្នុង ស្ថានភាព ជំងឺ កូវីដ១៩ អស់ បារម្ភ និង លែង ជា បញ្ហា ទៀត ហើយ ដោយ ចាប់ពី ថ្ងៃ នេះ តទៅ គឺ អាច ផ្ញើ ប្រាក់ បាន តាមរយៈ ធនាគារ កូមីន ដែល មាន ជាច្រើន សាខា នៅ ប្រទេស កូរ៉េ ។
គួរ បញ្ជាក់ ផងដែរ ថា អេ អឹម ខេ គឺជា គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ដែល ឈាន មុខ គេ លើ វិសាលភាព ប្រតិបត្តិការ និង ចំនួន អតិថិជន គិត ត្រឹម ខែមីនា ឆ្នាំ ២០២០ អេ អឹម ខេ មាន អតិថិជន សរុប ចំនួន ជាង ៩៥ម៉ឺន នាក់ ជាមួយនឹង ផលប័ត្រ ប្រាក់ កម្ចី ជាង ៣៥០ លាន ដុល្លារ អាមេរិក និង ប្រាក់ បញ្ញើ ជាង ១៧០ លាន ដុល្លារ អាមេរិក មាន ការិយាល័យ ប្រតិបត្តិការ ចំនួន ១៤៩ កន្លែង និង មាន ភ្នាក់ងារ ជិត ៦០០០កន្លែង នៅ ទូទាំង ប្រទេស ។
តាម សេចក្ដីបំភ្លឺ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ឲ្យដឹង ថា មូលហេតុ ឃាត់ខ្លួន ពីព្រោះ លោក ហង្ស សុភាព ចុះផ្សាយ ម្ដង ហើយ ម្ដង ទៀត ករណី ជា ជនសង្ស័យ កាប់ ស្ត្រី មេម៉ាយ ក្រីក្រ និង កូនស្រី ០២ នាក់ នៅ ភូមិ តាឡង់ ឃុំ ត្នោត ចុង ស្រង់ ស្រុក បន្ទាយមាស ខេត្ត កំពត ជា ជនដៃ ដល់ ដែល ជនរងគ្រោះ ស្គាល់ ត្រូវបាន សមត្ថកិច្ច ដោះលែង ដោយ ពុំ បាន ជូន ដំណឹង ទៅ ក្រុមគ្រួសារ ជនរងគ្រោះ ។
តាមពិត ជនល្មើស ពិតប្រាកដ នៅ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២០ វេលា ម៉ោង ១៥៖៣០ នាទី សមត្ថកិច្ច បាន ចាប់ខ្លួន ហើយ ជន នេះ ឈ្មោះ ផង សន ហៅ ( ចយ ) ភេទ ប្រុស កើត ឆ្នាំ ២០០០ នៅ ភូមិ តាឡង់ ឃុំ ត្នោត ចុង ស្រង់ ស្រុក បន្ទាយមាស ខេត្ត កំពត មុខរបរ គ្មាន ជា មុខសញ្ញា ប្រើប្រាស់ និង ចែកចាយ គ្រឿងញៀន ។
ក្រោយ ចាប់ខ្លួន ជនល្មើស ផង សន ហៅ ( ចយ ) បាន សារភាព ថា៖ នៅ ម៉ោង មួយ យប់ រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២០ រូប ខ្លួន ពិតជា បាន ប្រព្រឹត្ត មែន ព្រមទាំង រឹបអូស យក បាន ទូរស័ព្ទ ទាំង៣ គ្រឿង ជា របស់ ជនរងគ្រោះ ដែល ផ្ទុយ ស្រឡះ ពី ការចោទប្រកាន់ របស់ ជនរងគ្រោះ និង អ្នកកាសែត ហង្ស សុភាព ។
( ភ្នំពេញ ) ៖ សម្ដេច ព្រះអគ្គមហាសង្ឃរាជ្យ រាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្ដេច ព្រះហាសង្ឃរាជ នៃ កម្ពុជា បាន ធ្វើ ការចែក ទាន ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៥០ គ្រួសារ និង ប្រជាពលរដ្ឋ ក្រីក្រ ជាច្រើន ទៀត ។
សម្ដេច ព្រះមហាសង្ឃរាជ ទេព វង្ស បាន ប្រគល់ ជូន ព្រះរាជ អំណោយ ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៥០ គ្រួសារ និង ជន ក្រីក្រ ជាច្រើន ទៀត នា រសៀល ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម អម ដំណើរ ដោយ ព្រះមន្រ្តី សង្ឃ ។
ក្នុង ឱកាស ផ្ដល់ជូន ព្រះរាជ អំណោយ នេះ សម្ដេច ព្រះមហាសង្ឃរាជ មាន ព្រះសង្ឃ ដី ការអប់រំ ប្រជាពលរដ្ឋ ត្រូវ យកចិត្តទុកដាក់ ការពារ សុខភាព របស់ ខ្លួន និង គ្រួសារ ធ្វើ យ៉ាងណា រួមគ្នា ទប់ស្កាត់ ការរីករាលដាល ជំងឺ COVID-19 ។ សម្ដេច ព្រះមហាសង្ឃរាជ ក៏ មាន ព្រះសង្ឃ ដីកា ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ គោរព និង អនុវត្ត តាម សេចក្ដីណែនាំ របស់ ក្រសួង សុខាភិបាល និង តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ទប ស្កាត់ ជំងឺ COVID-19 ទាំងអស់ គ្នា ។
ក្រៅពី ការចែកជូន ព្រះអំណោយ សម្ដេច ព្រះមហាសង្ឃរាជ ក៏ បាន បំពាក់ មេដាយ ជូណ ឥស្សរៈ ជន ចំនួន ៣រូប ដែល បាន បំពេញ សកម្មភាព ស្នាដៃ ជាច្រើន សម្រាប់ សកម្មភាព ដ៏ ថ្លៃថ្លា ក្នុង វិស័យ ព្រះពុទ្ធ សាសនា ។
សម្រាប់ ប្រជាពលរដ្ឋ ដែល ទទួលបាន ព្រះរាជ អំណោយ ក៏ បាន សម្ដែង ចិត្ត ត្រេកអរ ចំពោះ ការសណ្ដោស ប្រណី របស់ ព្រះអង្គ ដែល តែងតែ ខ្វាយខ្វល់ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ និង បាន ជួយ ឧបត្ថម្ភ ជានិច្ច ជាកាល ។
គួរ បញ្ជាក់ ថា គិត ត្រឹម ពេលនេះ នៅក្នុង ប្រទេស អូស្រ្តាលី មាន ករណី ឆ្លង COVID-19 សរុប ជាង ៦.៤០០ ករណី ក្នុង នោះ ស្លាប់ ៦៣ នាក់ ប៉ុន្តែ អត្រា ឆ្លង និង ស្លាប់ ថ្មី ៗ មិន បាន កើនឡើង ច្រើន នោះ ឡើយ នា ប៉ុន្មាន សប្តាហ៍ ចុងក្រោយ នេះ ដោយសារតែ វិធានការ ទប់ស្កាត់ របស់ រដ្ឋាភិបាល អូស្រ្តាលី យ៉ាង តឹងរ៉ឹង បំផុត ៕ អភិបាល ខេត្ត កំពត បន្ត ប្រគល់ សម្ភារ និង បរិក្ខារ ដល់ មន្ទីរពេទ្យ បង្អែក ចំនួន ៥ និង មណ្ឌល សុខភាព ចំនួន ៦៤ ដើម្បី បង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ១៩
( កំពត) ៖ នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ នេះ លោក ជា វ តាយ អភិបាល ខេត្ត បាន ដឹកនាំ ក្រុមការ និង មន្ទីរ ពាក់ព័ន្ធ បន្ត ប្រគល់ សម្ភារ និង គ្រឿង បរិក្ខា ជូន ដល់ មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ បង្អែក ចំនួន ៥ និង មណ្ឌល សុខភាព ចំនួន ៦៤ ដើម្បី ឆ្លើយតប យុទ្ធនាការ បង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ១៩ ។
ក្នុង ពិធី ប្រគល់ នេះ លោក ជា វ តាយ បាន ថ្លែង ថា បច្ចុប្បន្ន ស្ថានភាព ជំងឺ ឆ្លង កូវីដ១៩ បាន នឹង កំពុង រីករាលដាល ក្នុង ពិភពលោក ហើយ បញ្ហា នេះ គឺជា បន្ទុក ដ៏ លំបាក ធ្ងន់ធ្ងរ សម្រាប់ នៅ កម្ពុជា យើង ផងដែរ ។ នៅក្នុង ស្ថានការណ៍ ដ៏ លំបាក ធ្ងន់ធ្ងរ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ប្រកបដោយ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្ដេច តេជោ ហ៊ុន សែន បាន នឹង កំពុង យកចិត្តទុកដាក់ ដើម្បី ដោះស្រាយ នូវ បញ្ហា ដ៏ លំបាក នេះ ។
លោក ជា វ តាយ បាន បន្ត ថា ដូច្នេះ ដើម្បី រួមចំណែក ការលំបាក ជាមួយ រាជ រដ្ឋាភិបាល នោះ រដ្ឋបាល ខេត្ត កំពត នា រយៈពេល កន្លងមក តែង បាន យកចិត្តទុកដាក់ ដោះស្រាយ ផ្ដល់ ស្បៀងអាហារ ទំនុប បម្រុង ជូន ដល់ ប្រជាពលរដ្ឋ ប្រឈម ការខ្វះខាត រួម នឹង សម្ភារ វេជ្ជសាស្ត្រ មួយចំនួន ទៀត ជា បន្តបន្ទាប់ ដែល បម្រើ ឱ្យ សកម្មភាព ប្រយុទ្ធ បង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ១៩ ដែល ក្នុង នោះ បាន ធ្វើ ការបែងចែក សម្រាប់ ដល់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន និង អាជ្ញាធរ ក្រុង ស្រុក ឃុំ សង្កាត់ ក្នុង ខេត្ត ចំនួន ២លើក រួច មកហើយ ផងដែរ ។
ដោយឡែក ជា ការជាក់ស្ដែង ការបែងចែក ប្រគល់ ជូន នូវ អំណោយ សម្ភារ បម្រើ ដល់ សកម្មភាព ប្រយុទ្ធ បង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ១៩ ដល់ មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ បង្អែក នា ពេលនេះ គឺជា លើក ទី៣ ហើយ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា សកម្មភាព ទាំងអស់ នេះ គឺ មិន អាច ខ្វះ បាន ពី ការចូលរួម របស់ សប្បុរសជន ជា ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង ក្រុមហ៊ុន សហគ្រាស នានា ដែល គិត មកដល់ ពេលនេះ ជំនួយ ឧបត្ថម្ភ របស់ សប្បុរសជន ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ជូន ដល់ រដ្ឋបាល ខេត្ត គិត ជា ថវិកា សរុប ចំនួន ១៩. ៥០០ ដុល្លារ និង ១៥លាន ៩សែន រៀល រួម និង គ្រឿង ឧបភោគ បរិភោគ សម្ភារ បរិក្ខារ វេជ្ជសាស្រ្ត មួយចំនួន បម្រើ ដល់ សកម្មភាព ប្រយុទ្ធ បង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ បាន ឆ្លើយតប យ៉ាង ល្អ ប្រសើរ ផងដែរ ។
លោក ជា វ តាយ ក៏ បាន ផ្ដាំផ្ញើ ដល់ គ្រូពេទ្យ តាម មណ្ឌល សុខភាព និង មន្ទីរពេទ្យ បង្អែក ក្នុង ខេត្ត ទាំងអស់ ឱ្យ បន្ត ការខិតខំ យកចិត្តទុកដាក់ និង សហការ ថែម ទៀត ឱ្យ បាន ល្អ ជាមួយនឹង អាជ្ញាធរ មូលដ្ឋាន រួម នឹង អ្នក ពាក់ព័ន្ធ ពិសេស ធ្វើ ការផ្សព្វផ្សាយ អប់រំ ដល់ ប្រជាពលរដ្ឋ អំពី វិធានការ អនាម័យ របស់ ក្រសួង សុខាភិបាល គឺ ក្នុង គោលដៅ រួម ដើម្បី ធ្វើ យ៉ាងណា រួមគ្នា ទប់ស្កាត់ ការឆ្លង ជំងឺ ដ៏ កាច សាហាវ មួយ នេះ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
សម្ភារ ដែល បាន ប្រគល់ ជូន នា ពេលនេះ ជូន មន្ទីរពេទ្យ បង្អែក ចំនួន ៥ រួម មាន៖ ធុង បាញ់ ថ្នាំ សម្លាប់ មេរោគ ចំនួន ១០. ម៉ាស់ ២៥ ប្រអប់ . ទឹក សាប៊ូ លាង ដៃ១០ ធុង និង សម្រាប់ មណ្ឌល សុខភាព ចំនួន ៦៤ បាន ប្រគល់ ជូន ម៉ាស់ ១៩២ ប្រអប់ . អាកុល ៣២០លីត្រ និង ឧបករណ៍ សម្រាប់ ស្ទង់ កំដៅ ចំនួន ៦៤ ផងដែរ ៕ អភិបាល ខេត្ត កំពង់ចាម ចុះ ពិនិត្យ ស្ថានភាព ការងារ និង ការថែទាំ សុខភាព របស់ កម្មករ - កម្ម ការិនី នៅ រោងចក្រ មេត ថេក
( កំពង់ចាម ) ៖ លោក ខ្លូត ផន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពង់ចាម និង អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន គណៈកម្មការ ប្រឆាំង ជំងឺ កូវីដ១៩ ខេត្ត លោក អ៊ុន ចាន់ ដា អម ដំណើរ ដោយ អភិបាល រង ខេត្ត និង មន្ត្រី ពាក់ព័ន្ធ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ បាន ចុះ ពិនិត្យ អំពី ស្ថានភាព ការងារ និង ការថែទាំ សុខភាព របស់ កម្មករ - កម្ម ការិនី នៃ រោងចក្រ មេត ថេក ស្ថិត នៅក្នុង ភូមិ អំពិល ឃុំ អំពិល ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម ។
លោក គៀង ទា គង់ ជំនួយការ អគ្គ នាយក ក្រុមហ៊ុន មេត ថេក បាន ឲ្យដឹង ថា រោងចក្រ កាត់ដេរ មេត ថេក មាន កម្មករ - កម្ម ការិនី សរុប ៣៧២៥ នាក់ ប្រុស ៣៤៤ នាក់ ស្រី ៣៣៨១ នាក់ ។
លោក គៀង ទា គង់ បាន ឲ្យដឹង ទៀត ថា រោងចក្រ របស់ លោក បាន ដំណើរការការងារ ជាធម្មតា ។ ជាមួយគ្នា នេះ ការថែទាំ សុខភាព កម្មករ - កម្មការ នី ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ខាង រោងចក្រ បាន ប្រើ ទឹក អាកុល សម្រាប់ លាងសម្អាត ដៃ និង ដាក់ ម៉ាស៉ីន ស្កេន កំដៅ មុនពេល អនុញ្ញាតឲ្យ កម្មករ - កម្ម ការិនី ចូល បំពេញ ការងារ របស់ ខ្លួន ។
ស្ថិត ក្នុង ឱកាស នោះ ដែរ លោក អ៊ុន ចាន់ ដា បាន ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ រោងចក្រ កាត់ដេរ ក្រុមហ៊ុន មេត ថេក ដែល បាន ចូលរួម ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នា ពេល កន្លងមក នេះ ។
ទន្ទឹម នឹង នោះ លោក អភិបាល ខេត្ត បាន សំណូមពរ ថ្នាក់ដឹកនាំ ក្រុមហ៊ុន បន្ត កិច្ចការ អនុវត្ត តាម គោលការណ៍ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង សុខាភិបាល ដើម្បី រួមគ្នា ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ជាមួយ គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ខេត្ត កំពង់ចាម ឲ្យបាន កាន់តែ ល្អ ប្រសើរ ដើម្បី សុខ មាលភាពអស់ គ្នា ៕ សាកលវិទ្យាល័យ UME សាខា ខេត្ត កំពង់ចាម នាំយក ថវិកា ជាង ១២លាន រៀល ចូលរួម ជាមួយ អាជ្ញាធរ ខេត្ត ដើម្បី ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
ស្ថិត ក្នុង ឱកាស នោះ ប្រធាន គណៈកម្មការ ប្រឆាំង ជំងឺ កូវីដ១៩ ខេត្ត លោក អ៊ុន ចាន់ ដា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ លោក មួន វាសនា ទីប្រឹក្សា សម្ដេច ហេង សំរិន និង ជា ប្រធាន គណៈ គ្រប់គ្រង សាកលវិទ្យាល័យ UME សាខា ខេត្ត កំពង់ចាម ដែល បាន ផ្តួចផ្តើម គំនិត រៃ អង្គាស ថវិកា រួមគ្នា យកមក ផ្តល់ ជូន គណៈកម្មការ ប្រឆាំង ជំងឺ កូវីដ១៩ ខេត្ត កំពង់ចាម នា ពេលនេះ ។
តម្លៃ សាំង ធ្លាក់ចុះ ថែម ទៀត ហើយ មក នៅ ត្រឹម២. ២៥០រៀល និង ម៉ាស៊ូត តម្លៃ ២. ៣០០រៀល ក្នុង ១លីត្រ
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ថ្មី មួយ ស្តីពី ការកំណត់ ថ្លៃ ប្រេងឥន្ធនៈ ត្រូវ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី៣០ ខែមេសា ឆ្នាំ ២០២០ ដោយ សាំង ធម្មតា ត្រូវ លក់ តម្លៃ ២. ២៥០រៀល ក្នុង មួយ លីត្រ និង ម៉ាស៊ូត លក់ ក្នុង តម្លៃ ២. ៣០០រៀល ក្នុង ១លីត្រ ។
លោក អគ្គ លេខាធិការ WHO បាន ថ្លែង ចេញពី ទីស្នាក់ការ កណ្តាល នៅ ទីក្រុង ហ្សឺណែវ នៃ ប្រទេស ស្វីស តាម បណ្តាញ វីដេអូ ខុន ហ្វឺរិន ថា អង្គការ លោក ពិតជា អរគុណ ណាស់ ចំពោះ ប្រជាជន អង្គការ និង បុគ្គល ជាច្រើន ដែល បាន បង្ហាញ ការគាំទ្រ និង ការប្តេជ្ញាចិត្ត ចំពោះ WHO នា ពេល ថ្មី ៗ កន្លងទៅ នេះ ជាពិសេស ជុំវិញ ការជួយ តាម ផ្នែក ហិរញ្ញវត្ថុ តែម្តង ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ ឯកឧត្តម សុខ សុភ័ក្ត្រ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ២លាន រៀល ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ឯកឧត្តម សុខ សុភ័ក្ត្រ រដ្ឋលេខាធិការ ក្រសួង ពាណិជ្ជកម្ម និង លោកជំទាវ ដែល បាន ឧបត្ថម្ភ ថវិកា ២.០០០.០០០ រៀល ( ពីរ លាន រៀល ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី ចូលរួម អបអរសាទរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ សន្តិភាព និង កាកបាទ ក្រហម កម្ពុជា »៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ ឯកឧត្តម បណ្ឌិត សំ សិរី រតន៍ និង លោកជំទាវ ឧបត្ថម្ភ ថវិកា ២ពាន់ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ឧបត្ថម្ភ ទឹក បរិសុទ្ធ កម្ពុជា ចំនួន ៣០០ កេស និង ទឹក ផ្លែឈើ ជូប ចំនួន ១០០ កេស ជូន ដល់ កងរាជអាវុធហត្ថ ខេត្ត កណ្តាល សម្រាប់ ប្រើប្រាស់ ក្នុង យុទ្ធនាការ យាម ល្បាត និង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ការឧបត្ថម្ភ នេះ គឺ បន្ថែម ពីលើ ទឹក បរិសុទ្ធ កម្ពុជា និង ទឹក ផ្លែឈើ ជូប សរុប ជាង ២៥០០ កេស ដែល ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ទើប បាន ឧបត្ថម្ភ ដល់ សមត្ថកិច្ច ដែល កំពុង ប្រចាំ ការតាមរនាំង បិទ ផ្លូវ ឆ្លង ព្រំប្រទល់ ខេត្ត ក្រុង នានា ទូទាំង ប្រទេស ។
កន្លងមក ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ដែល ជា ពាណិជ្ជកម្ម មួយ របស់ ក្រុមហ៊ុន ជី ប ម៉ុង បាន បរិច្ចាគ ថវិកា ចំនួន ៥០ ម៉ឺន ដុល្លារ សហរដ្ឋ អាមេរិក ជូន ដល់ រាជ រដ្ឋាភិបាល និង ទឹក បរិសុទ្ធ ចំនួន ៣ ពាន់ កេស ជូន ក្រសួង សុខាភិបាល សម្រាប់ ចាត់ចែង ប្រើប្រាស់ ក្នុង យុទ្ធនាកា ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នេះ ផងដែរ ៕
លោក គឹម សន្តិភាព បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « មិន មែន មាន ន័យ ថា ប្រទេស ត្រូវបាន ដាក់ ស្ថិត ក្នុង ភាពអាសន្ន ក្រោយពេល មាន ព្រះរាជ ក្រម ប្រកាស ឱ្យ ប្រើប្រាស់ ច្បាប់ ស្តីពី ការគ្រប់គ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន នោះ ទេ ។ ការដាក់ ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន » នៅ ពេលណា នោះ គឺ ប្រកាស ដោយ ព្រះមហាក្សត្រ ( ព្រះរាជ ក្រឹត្យ ) ក្រោយពី បាន មតិ ឯកភាព ពី នាយក រដ្ឋមន្ត្រី ប្រធាន រដ្ឋសភា និង ប្រធាន ព្រឹទ្ធសភា ស្រប តាម មាត្រា ២២ ថ្មី នៃ រដ្ឋធម្មនុញ្ញ !» ។
លោក បន្ត ថា៖ « ជា រួម មាន ន័យ ថា ច្បាប់ ស្តីពី ការគ្រប់គ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន នឹង យកមក អនុវត្ត ក្រោយពេល មាន ការប្រកាស ដាក់ ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន !» ។
« សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រប់គ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន » មាន ៥ជំពូក និង ១២មាត្ ដែល រៀបចំ ដោយ រាជ រដ្ឋាភិបាល ដើម្បី ដឹកនាំ ប្រទេសជាតិ ពេល ដាក់ ឱ្យ ស្ថិត នៅក្នុង ភាពអាសន្ន ត្រូវបាន រដ្ឋសភា អនុម័ត ហើយ នៅក្នុង កិច្ចប្រជុំ ពេញ អង្គ នា ព្រឹក ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ ។ ជាមួយគ្នា នេះ ច្បាប់ នេះ នឹង ត្រូវ ដាក់ ឱ្យ ព្រឹទ្ធសភា ឱ្យ យោបល់ នៅ ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០២០ ។
សេចក្តីព្រាង ច្បាប់ នេះ នឹង ផ្តល់ ជា មូលដ្ឋាន គតិយុត្ត ដើម្បី ធានា ដល់ ការអនុវត្តមាត្រា ២២ ថ្មី នៃ រដ្ឋធម្មនុញ្ញ និង ជា មូលដ្ឋាន គតិយុត្ត កំណត់ សិទ្ធិ អំណាច របស់ រាជ រដ្ឋាភិបាល ក្នុង ការដាក់ចេញ នូវ វិធានការចាំបាច់ ដែល មិន អាច ខ្វះ បាន ដើម្បី ឆ្លើយតប ទៅនឹង ស្ថានភាព របស់ ប្រទេស ក្នុង ភាពអាសន្ន សំដៅ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ការពារ អាយុជីវិត និង សុខភាព របស់ ប្រជាពលរដ្ឋ ព្រមទាំង ការពាំរ ទ្រព្យសម្បត្តិ និង បរិស្ថាន ។
សូម បញ្ជាក់ ថា សម្ដេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន បង្ហើរ សារ ជូន ជន រួម ជាតិ អំពី ការពិចារណា ទូល ថ្វាយ ព្រះមហាក្សត្រ សុំ រា ជានុញ្ញាត ដើម្បី ដាក់ ប្រទេស កម្ពុជា « ឱ្យ ស្ថិត នៅក្នុង ភាពអាសន្ន » ខណៈ ស្ថានភាពរីករាលដាល ជំងឺ កូវីដ១៩ កាន់តែ ច្រើន ឡើង ដោយ មាន អ្នក ឆ្លង ប្រមាណ ជាង ១០០ នាក់ ៕
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ឯកឧត្តម ផាន អូន អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ការពារ អ្នក ប្រេី ប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្រ្កាប ការក្លែងបន្លំ ដែល បាន ឧបត្ថម្ភ ថវិកា ៣.០០០ ដុល្លារ ( បី ពាន់ ដុល្លារ អាមេរិក ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី ចូលរួម អបអរសាទរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ សន្តិភាព និង កាកបាទ ក្រហម កម្ពុជា »៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ ឯកឧត្តម ស៊ឹម កា ប្រធាន ស្តីទី ព្រឹទ្ធសភា ឧបត្ថម្ភ ថវិកា ២០ លាន រៀល ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ឯកឧត្តម ស៊ឹម កា ប្រធាន ស្តីទី ព្រឹទ្ធសភា ដែល បាន ឧបត្ថម្ភ ថវិកា ២០.០០០.០០០ រៀល ( ម្ភៃ លាន រៀល ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី ចូលរួម អបអរសាទរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ សន្តិភាព និង កាកបាទ ក្រហម កម្ពុជា »៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ លោកជំទាវ រដ្ឋមន្ត្រី ភឿង ស កុណា ដែល បាន ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា ឆ្នាំ ២០២០
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោកជំទាវ ភឿង ស កុណា រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ដែល បាន ឧបត្ថម្ភ ថវិកា ១០.០០០ ដុល្លារ ( មួយ ម៉ឺន ដុល្លារ អាមេរិក ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី ចូលរួម អបអរសាទរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ សន្តិភាព និង កាកបាទ ក្រហម កម្ពុជា »៕
ឧត្តមសេនីយ៍ ឯក បណ្ឌិត អ៊ុក កោសា និង នាយ ទាហាន នៅ នាយកដ្ឋាន អភិវឌ្ឍន៍ ក្រសួង ការពារ ជាតិ ១១១ រូប បរិច្ចាគ ថវិកា ជាង ៣៨ លាន រៀល ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក បណ្ឌិត អ៊ុក កោសា អគ្គ នាយក រង អគ្គ នាយកដ្ឋាន នយោបាយ និង កិច្ចការ បរទេស និង ជា នាយក នាយកដ្ឋាន អភិវឌ្ឍន៍ ក្រសួង ការពារ ជាតិ ព្រទាំង នាយ ទាហាន ក្រោម ឱវាទ ចំនួន ១១១ រូប នៅ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល សរុប ជា ថវិកា ចំនួន ៣៨.៥៥០.០០០ រៀល ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ។
ការលើកឡើង បែប នេះ របស់ លោក អគ្គ នាយក រង បច្ចេកទេស ធ្វើឡើង ក្នុង សន្និសីទ សារព័ត៌មាន ស្ដីពី « វឌ្ឍនភាព ទិសដៅ ការងារ បន្ដ របស់ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៉ី វិល » ដែល រៀបចំឡើង ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល ។
លោក ស៊ីន ចាន់ សិរី វុត្ថា បាន ថ្លែង ថា នៅក្នុង ប្រទេស កម្ពុជា យោង តាម ស្ថិតិ បាន ឲ្យដឹង ថា បន្ទាប់ពី កើតមាន ជំងឺ កូវីដ១៩ នេះ ក្នុង ខែមករា ឆ្នាំ ២០២០ ភ្ញៀវ មាន ការថយចុះ ជា មធ្យម ប្រមាណ ២០ ភាគរយ . ចំពោះ ខែកុម្ភៈ មាន ការថយចុះ ប្រមាណ ៥០ ភាគរយ . នៅក្នុង ខែមីនា ថយចុះ ជាង ៧០ ភាគរយ ហើយ ចំពោះ ខែមេសា នេះ មាន ការថយចុះ រហូតដល់ ជាង ៩០ ភាគរយ គិត ត្រឹម ថ្ងៃទី ៤ ខែមេសា ឆ្នាំ ២០២០ នេះ ។
លោក បាន បន្ដ ថា ជា ការពិត ក្រុមហ៊ុន អាកាសចរ នៅ កម្ពុជា អាច ប្រឈម នឹង ការបិទ ទ្វារ ដោយសារតែ បញ្ហា នៃ ជំងឺ កូវីដ១៩ ប៉ុន្ដែ មិន មែន មាន តែ ក្រុមហ៊ុន នៅ កម្ពុជា ប៉ុណ្ណោះ ទេ ក្រុមហ៊ុន នៅលើ ពិភពលោក ជាច្រើន ក៏ កំពុង ជួ បញ្ហា នេះ ដូចគ្នា ។ និយាយ ដោយឡែក ចំពោះ កម្ពុជា ក្រុមហ៊ុន អាកាសចរ ស៊ីវិល ទាំងអស់ អាច ទប់ទល់ បាន ដោយសារតែ មាន ការគាំទ្រ ពី គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។
លោក បាន បន្ថែម ថា « គិត រហូតមកដល់ ថ្ងៃ នេះ មិន មាន ក្រុមហ៊ុន ណាមួយ ប្រកាស ក្ស័យ ធន នៅឡើយ ទេ ដោយសារតែ រាជ រដ្ឋាភិបាល បាន ដាក់ ទិសដៅ ធ្វើអន្ដរាគមន៍ ជួយ ដល់ ក្រុមហ៊ុន អាកាសចរ ស៊ីវិល ទាំង៦ នៅ កម្ពុជា គឺ ការផ្ដល់ នូវ ការ រួច ពន្ធ អប្បបរិមា១០ ភាគរយ ក្នុង រយៈពេល ៣ខែ . ការពន្យារ ពេល ការបង់ប្រាក់ សង់ ត្រឡប់ ទៅ រដ្ឋ ជាដើម » ។
លោក ស៊ីន ចាន់ សិរី វុត្ថា ឲ្យដឹង ទៀត ថា ប្រសិនបើ ជំងឺ កូវីដ១៩ នេះ នៅតែ បន្ដ គឺ ច្បាស់ ណាស់ កម្ពុជា មាន ការខាតបង់ ច្រើន មែនទែន ប៉ុន្ដែ មិន អាច វាយតម្លៃ បាន នៅឡើយ ទេ ថា តើ មាន ហេតុការណ៍ អ្វី កើតឡើង នោះ ទេ ? ព្រោះ កុ្រមហ៊ុន អាកាសចរ នីមួយ ៗ តែងតែ មាន យុទ្ធសាស្រ្ដ ផ្សេង ៗ គ្នា ក្នុង ការប្រកប អាជីវកម្ម ៕
ការអះអាង យ៉ាង ដូច្នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ស៊ីន ចាន់ សិរី វុត្ថា អញ្ជើញ ចូលរួម ជា វាគ្មិន ក្នុង សន្និសីទ សារ ព័ត៌មាន ស្ដីពី « វឌ្ឍនភាព និង ទិសដៅ ការងារ បន្ដ របស់ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល » ដែល រៀបចំ ដោយ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល នៅ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី នា ព្រឹក ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ នេះ ។
លោក ស៊ីន ចាន់ សិរី វុត្ថា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ការអភិវឌ្ឍន៍ អាកាសយានដ្ឋាន ភ្នំពេញ ថ្មី នៅតែ បន្ដ ដំណើរការ ប៉ុន្ដែ មាន ផ្ដល់ ប៉ះពាល់ ខ្លះ ពី ជំងឺ COVID-19 ដោយសារតែ អ្នកជំនាញ ចិន មួយចំនួន ដែល ក្នុង នោះ ភាគ ច្រើន ជា ក្រុមហ៊ុន ចិន អីចឹង ដោយសារតែ អ្នកជំនាញ ទៅ ស្រុក ហើយ ពិបាក ត្រឡប់ មកវិញ ដូច្នេះ មាន ការយឺតយ៉ាវ ប៉ុន្ដែ ដំណើរការ ធម្មតា ប៉ុន្ដែ យឺត ជាង មុន មាន ជំងឺ COVID-19 ប៉ុន្ដែ នៅ ដំណើរការ សាងសង់ បន្ដ រហូត មកដល់ ពេលនេះ អាកាសយានដ្ឋាន ភ្នំពេញ ថ្មី នេះ បាន ៣០ ភាគរយ ហើយ » ។
ជាមួយគ្នា នោះ អ្នកនាំពាក្យ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល រូប នេះ ក៏ បាន ច្រានចោល ចំពោះ ព័ត៌មាន មួយចំនួន ដែល ថា អាកាស ព្រលានយន្តហោះ ភ្នំពេញ ថ្មី ត្រូវបាន ប្ដួរ ទីតាំង គឺជា ព័ត៌មាន មិន ពិត នោះ ឡើយ ខណៈ ដែល ដំណើរការសាងសង អាកាស ព្រលានយន្តហោះ ភ្នំពេញ ថ្មី នេះ កំពុងតែ បន្ដ ដំណើរការ សាងសង់ ជាធម្មតា ។
បើ តាម ការឲ្យដឹង ពី លោក ស៊ីន ចាន់ សិរី វុត្ថា ព្រលានយន្តហោះ ភ្នំពេញ ថ្មី ដែល មាន ទីតាំង នៅលើ ទឹកដី ខេត្ត កណ្តាល និង តាកែវ នេះ គឺ ចែក ជា២ ដំណាក់កាល ធំ ៗ ដោយ ដំណាក់កាល ទី១ ព្យាករណ៍ ថា នៅ ឆ្នាំ ២០៣០ នឹង ទទួលបាន អ្នកដំណើរ ១៣លាន នាក់ ហើយ ដំណាក់កាល ទី២ នៅ ឆ្នាំ ២០៥០ នឹង ទទួលបាន អ្នកដំណើរ ៣០លាន នាក់ ។
គួរ រំលឹក ថា គម្រោង ព្រលានយន្តហោះ ភ្នំពេញ ថ្មី នេះ ត្រូវបាន ប្រកាស ឡើង ក្នុង ដំណើរ ទេ ស្សនកិច្ច របស់ លោក នាយក រដ្ឋមន្ត្រី ចិន លី ខឺ ឈាង មក កម្ពុជា កាលពី ខែមករា ឆ្នាំ ២០១៨ ។ នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន និង លោក នាយក រដ្ឋមន្ត្រី ចិន ក៏ បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ចុះហត្ថលេខា គម្រោង វិនិយោគ រវាង ក្រុមហ៊ុន OCIC អ្នក ឧកញ៉ា ពុង ឃាវ សែ និង ក្រុមហ៊ុន ចិន ផងដែរ ។
ដោយឡែក ក្រុមហ៊ុន របស់ អ្នក ឧកញ៉ា ពុង ឃាវ សែ កាន់កាប់ ភាគហ៊ុន ៩០ ភាគរយ ដោយ វិនិយោគ ទឹកប្រាក់ ចំនួន ១.៥០០ លាន ដុល្លារ អាមេរិក ក្នុង នោះ ទឹកប្រាក់ ១. ១០០ លាន ដុល្លារ ជា កម្ចី ពី ធនាគារ បរទេស និង ២៨០ លាន ដុល្លារ ជា របស់ ក្រុមហ៊ុន OCIC និង ២៨០ លាន ដុល្លារ ទៀត ជាដើមទុន ចុះបញ្ជី ៕
មេបញ្ជាការ រង យោធភូមិភាគ ទី៥ ខេត្ត បន្ទាយមានជ័យ អះអាង ថា រថយន្ត ស្លាកលេខ ខ. ម ដែល សមត្ថកិច្ច ឃាត់ទុក មាន ស្លាកលេខ ត្រឹមត្រូវ និង ជា កម្មសិទ្ធិ របស់ នាយកដ្ឋាន វិស្វកម្ម ក្រសួង ការពារ ជាតិ
( បន្ទាយមានជ័យ )៖ មន្រ្តី យោធា ជាន់ ខ្ពស់ យោធ ភូមិភាគ ទី៥ ក្នុង ខេត្ត បន្ទាយមានជ័យ បាន អះអាង ថា រថយន្ត ពណ៌ ត្រេអ៊ីមួយ គ្រឿង ដឹក ថ្ម ដែល សមត្ថកិច្ច ចាប់ ឃាត់ ជា រថយន្ត របស់ នាយកដ្ឋាន វិស្វកម្ម ក្រសួង ការពារ ជាតិ និង មាន ស្លាកលេខ ត្រឹមត្រូវ ហើយ មាន ការទទួលស្គាល់ ក្រសួង ទៀតផង ។
លោក ឧត្តមសេនីយ៍ ទោ ភ្លន់ តារា មេបញ្ជាការ រង យោធភូមិភាគ ទី៥ បាន ប្រាប់ នៅ រសៀល ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២០ នេះ ថា កាលពី ម្សិលមិញ ខាង សមត្ថកិច្ច ខេត្ត បន្ទាយមានជ័យ បាន ឃាត់ រថយន្ត ដឹក ថ្ម របស់ លោក មួយ គ្រឿង ដោយ ហេតុ ថា មិន មាន ស្លាកលេខ ត្រឹមត្រូវ យក ទៅ រក្សាទុក និង បាន ប្រគល់ ជូន មន្រ្តី គយ ចាត់ការ បន្ត ទៀត ។
លោក ឧត្តមសេនីយ៍ បាន បញ្ជាក់ ថា រថយន្ត នេះ លោក បាន ជួល ពី នាយកដ្ឋាន វិស្វកម្ម ក្រសួង ការពារ ជាតិ ដើម្បី ដឹក ថ្ម ហើយ រថយន្ត នេះ ទៀតសោត មាន ស្លាកលេខ ត្រឹមត្រូវ និង មាន ការទទួល ស្គាល់ ត្រឹមត្រូវ ពី ថ្នាក់ដឹកនាំ ក្រសួង ទៀតផង ដូច្នេះ លោក សូម អំពាវនាវ កុំ ឲ្យ មាន ការភ័ន្តច្រឡំ ចំពោះ ករណី នេះ ។
បើ តាម លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ រង ភូមិភាគ បើសិន ខាង មន្រ្តី គយ ពិនិត្យ ទៅ មាន បញ្ហា និង ត្រូវ បង់ ពន្ធ នោះ ខាង អង្គភាព នឹង ធ្វើ ការដោះស្រាយ ជូន តាម ការជាក់ស្តែង ៕
លោក គុណ ញឹម នាំយក អំណោយ និង សម្ភារៈ មួយចំនួន ចែកជូន អង្គការ មូលនិធិ កុមារ និង និស្សិត កម្ពុជា
( ភ្នំពេញ ) ៖ លោក គុណ ញឹម ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា នា ព្រឹក ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ចុះ សួរសុខទុក្ខ និង នាំយក គ្រឿង ឧបភោគ បរិភោគ ផលិតផល សម្អាត និង រក្សា អនាម័យ ម៉ាស ឧបករណ៍ វាស់ កម្តៅ និង ថវិកា មួយ ចំនួន ចែកជូន ដល់ យុវជន និង កុមារ ជា សមាជិក សិស្សានុសិស្ស និង បុគ្គលិក ស្ម័គ្រចិត្ត បម្រើការ នៅ អង្គការ មូលនិធិ កុមារ និង និស្សិត កម្ពុជា ។
ការនាំយក អំណោយ និង សម្ភារៈ ចែកជូន អ្នកបម្រើការ ខាងលើ នេះ គឺ សំដៅ ជួយ កាត់បន្ថយ ការលំបាក របស់ កុមារ កំព្រា និង និស្សិត កម្ពុជា ក្នុង ស្ថានភាព នៃ ការរីករាលដាល ជំងឺ ផ្លូវ ដង្ហើម ថ្មី ដែល បណ្តាល មកពី វីរុស កូរ៉ូ ណា ។
អំណោយ នេះ បាន មកពី មូលនិធិ សប្បុរសធម៌ នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ដើម្បី ជួយ ជន ងាយ រងគ្រោះ ក្នុង ស្ថានការណ៍ នៃ ការរាត ត្បាត ជំងឺ ផ្លូវ ដង្ហើម កូវីដ១៩ ដែល កំពុង យាយី ដល់ សុខភាព និង អាយុជីវិត ប្រជាពលរដ្ឋ កម្ពុជា ក៏ ដូចជា ពិភពលោក ទាំងមូល ៕
( ព្រះវិហារ ) ៖ លោក សំ លាង ទ្រី ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ រួម ជាមួយ ថ្នាក់ដឹកនាំ ជាច្រើន រូប ពេញ មួយ ថ្ងៃទី ១៥ ខែមេសា ឆ្នាំ ២០២០ ដែល ជា ថ្ងៃទី ៣ នៃ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ បាន ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ លើកទឹកចិត្ត ដល់ មន្ត្រី កម្មករ នៅ តាម ការដ្ឋាន នានា ដែល កំពុង បំពេញ ភារកិច្ច រៀង ៗ ខ្លួន គោរព តាម បទបញ្ជា រាជ រដ្ឋាភិបាល ក្នុង ការចូលរួម ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
លោក សំ លាង ទ្រី បាន ឲ្យដឹង ថា ដោយ អនុវត្ត តាម បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ការណែនាំ របស់ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ ក្នុង ការចូលរួម ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ បុគ្គលិក កម្មករ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត គ្រប់ ផ្នែក ទាំងអស់ គឺ មិន បាន ឈប់ សម្រាក ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី នោះ ទេ ។
លោក បន្ដ ថា ផ្ទុយទៅវិញ មន្ត្រី កម្មករ ទាំងអស់ គឺ បំពេញ ការងារ ដូច ធម្មតា តាម កន្លែង រៀង ខ្លួន ។ ជាក់ស្តែង នៅ ថ្ងៃ នេះ ដែរ លោក បាន ដឹកនាំ ក្រុមការងារ បាន ចុះ ពិនិត្យ ការងារ ថែទាំ ផ្លូវថ្នល់ ផ្លូវ ជាតិ លេខ ៩ ក្នុង ភូមិសាស្ត្រ ស្រុក ត្បែងមានជ័យ និង ផ្លូវ ជាតិ លេខ ៩២ ក្នុង ភូមិសាស្ត្រ ឃុំ កំពង់ស្រឡៅ មួយ ឃុំ កំពង់ស្រឡៅ ពីរ ស្រុក ឆែប ដែល អនុវត្ត ដោយ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ ។
( ភ្នំពេញ ) ៖ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន កងពល តូច អន្តរាគមន៍ លេខ ១២៨ នៃ យោធ ភូមិភាគ ទី១ ឈរ ជើង នៅ ព្រំដែន កម្ពុជា - ឡាវ សរុប ២៥១២ នាក់ បាន រួមគ្នា បរិច្ចាគ ថវិកា សរុប ជាង ៧០ លាន រៀល ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ក្នុង ប្រតិបត្តិការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
ថវិកា ជាង ៧០ លាន រៀល នេះ ត្រូវបាន កងពល តូច អន្តរាគមន៍ លេខ ១២៨ យក ប្រគល់ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នៅ ព្រឹក ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ នេះ ។
កងពល តូច អន្តរាគមន៍ លេខ ១២៨ ជា កងពល មួយ ដែល សម្តេច តេជោ ហ៊ុន សែន បង្កើតឡើង នៅ ឆ្នាំ ២០១៧ ដើម្បី ឈរ ជើង ការពារ ដែនដី កម្ពុជា នៅ ព្រំដែន កម្ពុជា - ឡាវ ក្នុង ខេត្ត ស្ទឹងត្រែង ។
លោក ឧត្តមសេនីយ៍ ទោ មៀច សាមុត មេបញ្ជាការ កងពល តូច អន្តរាគមន៍ លេខ ១២៨ បាន គូសបញ្ជាក់ ថា ការបរិច្ចាគ នេះ ជា ស្មារតី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល កំពុង រាលដាល នៅក្នុង ប្រទេស កម្ពុជា ។
លោក មេបញ្ជាការ រូប នេះ បន្ថែម ថា « បងប្អូន កងទ័ព របស់ យើង មិន ត្រឹមតែ មាន តួនាទី ភារកិច្ច ស្នូល ក្នុង ការការពារ ជាតិ មាតុភូមិ ការពារ បូរណភាព ទឹកដី នោះ ទេ ។ តែ កងទ័ព របស់ យើង ក៏ មាន ស្មារតី ចូលរួមចំណែក រំលែក ទុក្ខលំបាក របស់ ជាតិ និង ប្រជាជន យើង នៅ គ្រប់ កាលៈទេសៈ » ។
( កំពង់ស្ពឺ ) ៖ សប្បុរសជន នៅតែ បន្ត ការចូលរួម បរិច្ចា សម្រាប់ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ទៅ តាម ទឹកចិត្ត មនុស្សធម៌ តាមរយៈ តំណាង ក្រុមហ៊ុន រោងចក្រ សហគ្រាស ក្រុម អាជីវករ គ្រប់ មជ្ឈដ្ឋាន នៅក្នុង ខេត្ត ជា ការរួមចំណែក ជាមួយ រដ្ឋបាល ខេត្ត ក៏ ដូចជា រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការលើកកម្ពស់ សុខុមាលភាព សង្គម ។
លោក វ៉ី សំណាង បាន លើកឡើង ថា កាយវិការ ទាំង នេះ បាន បង្ហាញ អំពី សាមគ្គីភាព ព្រមទាំង បាន បង្ហាញ អំពី ទឹកចិត្ត មនុស្សធម៌ ក្នុង ការចូលរួមចំណែក យ៉ាង សកម្ម ជាមួយ រដ្ឋបាល ខេត្ត ក៏ ដូចជា តប តាម ការអំពាវនាវ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការចូលរួម ទប់ស្កាត់ តាម វិធី គ្រប់ បែបយ៉ាង ដើម្បីឲ្យ ប្រជាជន ឲ្យ ចាក ផុត អំពី ជំងឺ ឆ្លង ដ៏ កាច សាហាវ មួយ នេះ ដែល ពិភពលោក កំពុង មាន ការព្រួយបារម្ភ ។
កុមារី ក្រីក្រ ពិការ ដៃ ម្ខាង នៅ ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ទទួលបាន អំណោយ សប្បុរសធម៌
( ព្រៃវែង ) ៖ សមាគម សប្បុរសធម៌ កម្ពុជា - បារាំង បាន មក យក កង់ មួយ គ្រឿង និង អំណោយ សប្បុរសជន ទៅ ជូន កុមារី ក្រីក្រ ថែមទាំង ពិការ ដៃ ម្ខាង ម្នាក់ នៅ ភូមិ ស្វា ចារ ឃុំ អង្គរ រាជ្យ ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ។
លោក សុខ នីកូឡា ប្រធាន សមាគម សប្បុរសធម៌ កម្ពុជា - បារាំង បាន ប្រាប់ ឲ្យដឹង ថា នៅ រសៀល ថ្ងៃទី ១៥ ខែមេសា ម្សិលមិញ នេះ រូប លោក និង ក្រុមការងា បាន នាំយក នូវ អំណោយ សប្បុរសធម៌ ដែល ជា អំណោយ ពី លោក ឧកញ៉ា ជឹង ធាន គាត និង លោកស្រី ព្រមទាំង បុត្រ នៅ ប្រទេស បារាំង ទៅ ប្រគល់ ជូន ដល់ ផ្ទះ កុមារី ឈ្មោះ ឌឹម ស្រី យ៉ា អាយុ ១៤ ឆ្នាំ រស់ នៅ ភូមិ ស្វាយ ចារ ឃុំ អង្គរ រាជ្យ ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ។
ថ្ងៃទី ១៥ ខែមេសា ដែល ជា ថ្ងៃ ខួបកំណើត របស់ លោក គីម អ៉ីល ស៊ុង បិតា ស្ថាបនិក របស់ ប្រទេស កូរ៉េ ខាងជើង គឺជា ទិវា ដ៏ សំខាន់ បំផុត នៅក្នុង ប្រទេស នេះ ។ ប្រជាជន កូរ៉េ ខាងជើង ទាំងអស់ ត្រូវបាន អប់រំ តាំងតែពី កើត មក ឲ្យ គោរព និង ដឹងគុណ ជានិច្ច ចំពោះ លោក គីម អ៉ីល ស៊ុង និង កូនប្រុស របស់ គាត់ គឺ លោក គីម ជុង អ៉ីល ដែល ត្រូវ ជា ឪពុក លោក គីម ជុង អ៊ុន ។
យ៉ាងណាមិញ សម្រាប់ ការប្រារព្ធ ទិវា ខួប លោក គីម អ៉ីល ស៊ុង នៅ ឆ្នាំ នេះ គេ ពុំ បាន ឃើញ មាន ការលើកឡើង ពី ឈ្មោះ លោក គីម ជុង អ៊ុន នៅក្នុង សេចក្តីរាយការណ៍ ព័ត៌មាន ផ្លូវការ ណាមួយ របស់ រដ្ឋាភិបាល កូរ៉េ ខាងជើង ឡើយ ខណៈ ចាប់តាំងតែពី ឡើង កាន់អំណាច នៅ ចុង ឆ្នាំ ២០១១ លោក គីម ជុង អ៊ុន តែងតែ មាន វត្តមាន ជានិច្ច នៅ ថ្ងៃ ខួបកំណើត របស់ លោក គីម អ៉ីលស៊ុល ក៏ ដូចជា ខួប របស់ លោក គីម ជុង អ៉ីល ។
ក្នុង ឱកាស នោះ លោក អភិបាល ក៏ សូម ថ្លែងអំណរគុណ ដល់ សប្បុរសជន គ្រប់ ទិសទី តែង បាន ផ្តល់ អំណោយ មនុស្សធម៌ ជា បន្តបន្ទាប់ កន្លងមក ជាក់ស្តែង ថ្ងៃ នេះ កញ្ញា និង ក្រុមគ្រួសារ បាន នាំ អំណោយ ជា ស្បៀង និង ថវិកា ផ្ទាល់ខ្លួន ផ្តល់ ជូន គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ COVID-19 ខេត្ត ។
ប្រធាន ក្រុមប្រឹក្សា និង សមាជិក ក្រុមប្រឹក្សា ខេត្ត ព្រះវិហារ ១៨ រូប ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្សរ៍ របស់ ខ្លួន ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ សរុប ថវិកា ជាង ១៩ លាន រៀល
( ព្រះវិហារ ) ៖ លោក ឡុង សុវណ្ណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង សមាជិក ក្រុមប្រឹក្សា ខេត្ត ព្រះវិហារ ចំនួន ១៨ រូប ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល សរុប ជា ថវិកា ចំនួន ១៩.៤០០.០០០ រៀល ។
ខាងក្រោម នេះ ជា បញ្ជី ឈ្មោះ ប្រធាន ក្រុមប្រឹក្សា និង សមាជិក ក្រុមប្រឹក្សា ខេត្ត ព្រះវិហារ ដែល ចូលរួម បរិច្ចាគ ថវិកា៖
បើ តាម ក្រសួង ការពារ ជាតិ បារាំង បច្ចុប្បន្ន ក្រុម នាវា ចម្បាំង ខាងលើ កំពុង ទទួល ការបាញ់ សម្លាប់ មេរោគ ៕ មន្ត្រីរាជការ ស្រុក ឱរ៉ាល់ ៤១ នាក់ បរិច្ចាគ ប្រាក់ បៀវត្ស ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ មន្ត្រីរាជការ នៅក្នុង ស្រុក ឱរ៉ាល់ សរុប ៤១ នាក់ បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្សរ៍ របស់ ខ្លួន ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ដោះស្រាយ ការលំបាក ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
