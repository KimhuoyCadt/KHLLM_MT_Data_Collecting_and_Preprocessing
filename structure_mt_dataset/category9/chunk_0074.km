f ការផ្តល់ ហិរញ្ញប្បទាន របស់ ប្រទេស
ប្រសិទ្ធភាព ទាប ជាង នេះ អាច ជា ហេតុផល មួយ ដែល មន្ត្រី ចិន មួយចំនួន បាន អណ្តែត លើ គំនិត ដែល ថា វ៉ាក់សាំង របស់ ប្រទេស នេះ ប្រហែលជា ត្រូវ ផ្តល់ឱ្យ រួម ជាមួយនឹង ការចាក់ វ៉ាក់សាំង ផ្សេង ទៀត ។
តើកិច្ចសន្យាប្រភេទ ណានោះ គាត់មិនចង់បង្ហាញ ជា សាធារណៈទេ ។
នៅលើ ទឹកកក ស្តេច គួរតែ ល្អ ។
ម្តង ទៀត សម្រាប់ ការរស់ នៅ ។
ប្រហែលជាខ្ញុំអាចកម្ចាត់ពួកគេ ហើយ បណ្ដេញពួកគេចេញពីស្រុក ព្រោះខ្ញុំដឹងថាអ្នក ណាដែលអ្នកឲ្យ ពរនោះមាន ពរ ហើយអ្នក ណាដែលអ្នកដាក់បណ្ដា សា ក៏ត្រូវបណ្ដា សា» ។
ដោយ ប្រើ យន្តហោះ ស្លាប ថេរ និង ឧទ្ធម្ភាគចក្រ ។
ខណៈពេលដែលគេនិយាយថា៖ « ថ្ងៃនេះ បើអ្នក រាល់គ្នានឹងឮសំឡេងទ្រង់ កុំធ្វើ ចិត្តរឹងប៉ឹងដូចនៅក្នុងការ បះបោរឡើយ » ។
១០ ហើយអ្នក ណាដែលនិយាយពាក្យទាស់នឹងកូនមនុស្ស នោះនឹងបានអត់ទោសឲ្យគាត់ ។ រីឯអ្នក ណាដែលប្រមាថព្រះវិញ្ញាណបរិសុទ្ធ នោះនឹងមិនបានអត់ទោសឲ្យគាត់ឡើយ ។
ហើយរហូតមកដល់សព្វថ្ងៃនេះ មានគេនិយាយថា “ នឹងនៅលើភ្នំនៃព្រះ‌ អម្ចាស់
ប៉ុន្តែគឺលោកយេស៊ូដែលមាន ប្រសាសន៍ថា៖ «ហេតុនេះហើយបានជាខ្ញុំបាននិយាយថា អ្នកនឹងស្លាប់ក្នុងអំពើ បាបរបស់អ្នក ដ្បិតបើអ្នក រាល់គ្នាមិនជឿថាខ្ញុំ ជាអ្នកដែលខ្ញុំអះអាងនោះទេ អ្នកនឹងស្លាប់ក្នុងអំពើ បាបរបស់អ្នក រាល់គ្នា » ។
ឈ្មោះ របស់ ខ្ញុំ គឺជា រឿង ដំបូង ដែល គាត់ និយាយ ។
“ មាន ការងារ ជាច្រើន ដែល យើង ត្រូវ ធ្វើ ដើម្បីឱ្យ មនុស្ស មាន ទំនុកចិត្ត ។
ប៉ុន្តែ ទោះបីជាយើង ឬទេវតាមកពីស្ថាន សួគ៌ ប្រកាសដំណឹងល្អ ណាមួយផ្សេងទៀតដល់អ្នក រាល់គ្នា ក្រៅពីដំណឹងល្អដែលយើងបានប្រកាសប្រាប់អ្នក រាល់គ្នាក៏ដោយ សូមឲ្យអ្នកនោះត្រូវបណ្ដា សា ចុះ » ។
ព្រះស៊ូ ទ្រាំនឹងយើង ដោយរារាំងយើងមិនឲ្យធ្លាក់ទៅឆ្ងាយ ដូចជាយើងពិតជានឹងធ្វើប្រសិនបើទ្រង់មិននៅជាមួយយើង ។
« កូនមនុស្សបាន មកស្វែង រក ហើយ សង្គ្រោះអ្វីដែលបានបាត់ បង់ » ។
