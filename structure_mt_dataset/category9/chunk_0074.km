ព្យាយាមបំបែក ភាព អាម៉ាស់ កញ្ញា ចេន ហៅថាម៉េច ?
ព្រះយេស៊ូមានព្រះបន្ទូល តប ថា៖ « តើខ្ញុំមិនប្រាប់អ្នក រាល់គ្នាថា បើអ្នក ជឿ អ្នកនឹងឃើញសិរី រុងរឿងរបស់ព្រះជាម្ចាស់ ? » ។
សត្វ លា មិន ចាំបាច់ និយាយ អ្វី ទេ ។
“ ខ្ញុំ តែងតែ ស្រឡាញ់ នូវែលសេឡង់ ចាប់តាំងពី ការមក លេង លើក ដំបូង របស់ ខ្ញុំ នៅ ទីនោះ កាលពី រាប់ សិប ឆ្នាំ មុន ។
តើអ្នក ស្រឡាញ់ខ្ញុំជាងបុរសផ្សេងទៀតស្រឡាញ់ខ្ញុំ។
យើងមិនស្និទ្ធស្នាលនឹងដាវីឌទេ ហើយយើងក៏មិនបានផ្សាយពាណិជ្ជកម្មថានៅក្នុងដាវីឌដែរ យើងនៅប៊ូកេត ដូចដែលបានផ្សាយ ។
វា ត្រូវបាន សន្មត់ ថា មាន លក្ខណៈ ផ្ទាល់ខ្លួន ផងដែរ !
ហេព្រើរ 11:14-16 ចំពោះ អស់អ្នកដែលនិយាយបែបនេះ ប្រកាសយ៉ាងច្បាស់ថា ពួកគេស្វែង រកប្រទេសរបស់ខ្លួន ។
តើព្រះអង្គបានរកឃើញអ្វីខ្លះពីអ្នក បម្រើរបស់ព្រះអង្គ ដរាប ណាទូលបង្គំនៅចំពោះមុខព្រះអង្គរហូតមកដល់សព្វថ្ងៃនេះ ដើម្បីកុំឱ្យទូលបង្គំទៅច្បាំងនឹងខ្មាំង ស ត្រូវរបស់ព្រះចៅអធិរាជ ?
តើ អ្នក មានអារម្មណ៍ ថា ជីវិត របស់ អ្នក ពោរពេញ ដោយ ភាពច្របូកច្របល់ និង ច្របូកច្របល់ មែន ទេ ?
ខ្ញុំ នឹង ទៅ ជាមួយ ពួកគេ ម្តង ទៀត ។
កូនខ្ញុំស្រលាញ់ខ្ញុំហើយ !
អ្នកអាចឃើញថាមួយនេះត្រូវបានគេបាញ់។
ឧត្តមសេនីយ ហូឡង់ មួយ រូប បាន ចូលកាន់ តំណែង បញ្ជាការ ។
ក្មេងស្រី ទាំង បួន បាន ឡើង លើ ឆាក ។
ខ្ញុំមិនចង់ឲ្យនាងចូលរួមទៀតទេ ។
នៅ ខាងក្នុង ត្រូវតែ មាន ពន្លឺ និង មាន ខ្យល់អាកាស ។
ពួកគេ នៅតែ លេចធ្លោ ក្នុង ប្រវត្តិសាស្ត្រ ដោយសារ ពួកគេ ជា នរណា និង អ្វី ដែល ពួកគេ បាន ធ្វើ ។
យើងដឹងហើយជឿថាអ្នក ជាព្រះ ដ៏ វិសុទ្ធរបស់ព្រះ» ។
ព្រះ របស់ខ្ញុំគឺ ជាថ្មដា របស់ខ្ញុំដែលខ្ញុំជ្រកកោន ។
ហេតុ អ្វី បានជា ពួកគេ ប្រើប្រាស់ គ្រឿងញៀន ខុស ច្បាប់ ពេល កំពុង ធ្វើ ការ ?
ការផ្លាស់ប្តូរ ដូចជា ការរាំ ដំបូង បន្ទាប់ពី
ផ្សាយ ដំណឹង ល្អ ដល់ ជន ក្រីក្រ ។
កុំ ធានា ចុងបញ្ចប់ នៅពេល អ្នក បាន បញ្ចប់ ។
ប្រសិនបើពួកគេឈ្នះថ្ងៃនេះ ពួកគេនឹងឡើងទៅ កាន់ចំណាត់ថ្នាក់លេខប្រាំក្នុងតារាង ។
ពួកគេ ជាអ្នកដែលធ្វើឲ្យខ្ញុំអស់ផ្កា » ។
ទាក់ទាញ ដោយ រាល់ អ៊ីញ
ថានាងមិនស្រឡាញ់គាត់ទៀតទេ ហើយគាត់មិនប្រាកដថាគាត់ខ្វល់ទេ ។
« ប៉ុន្តែ អ្នក បានបដិសេធចំពោះព្រះ ដ៏បរិសុទ្ធ និងសុចរិត ហើយទាមទារឲ្យមានអ្នកសម្លាប់ឃាតកម្នាក់ » ។
នៅក្នុង អត្ថបទ មុន យើង បាន ពិនិត្យមើល ប្រវត្តិ របស់ ចាវ៉ា ។
« ដូច្នេះ ពួកគេបានប្រញាប់ប្រញាល់ទៅរកម៉ារៀ និង យ៉ូសែប ហើយកូននោះដេកក្នុងស្នូក » ។
« យើងនឹងមិនអង្គុយ ហើយយើងក៏មិនបិទមាត់ដែរ ។
៣ តើព្រះពររបស់ព្រះអម្ចាស់មានអ្វី ខ្លះ ?
កុំ ត្រូវ អារក្ស ល្បួង កូន ចៀម តូច
អត់មានឆ្កែទេ តែនៅ តែស្រលាញ់គេ ?
20 ចូរសរសេរវានៅលើក្របទ្វារផ្ទះរបស់អ្នក និងនៅមាត់ទ្វាររបស់អ្នក ។
យើងចង់លើកទឹក ចិត្តឱ្យមានការ ចែករំលែកការ អនុវត្តល្អ។
ហើយនោះជាការ កែសម្រួលដ៏ធំមួយចាប់តាំងពីខ្ញុំមិនដែលចង់មានកូនមករដូវ ។
ត្រង់នេះ រឿងដែលគេខ្លាច តម្រូវឲ្យមានក្នុងករណីនេះ ។
សូម ក្រឡេក មើល របៀប រក្សា សុវត្ថិភាព ពេល ញ៉ាំ បង្អែម ។
អ្នក ដែល ព្យាយាម និង រីកចម្រើន ក្នុង ការគ្រប់គ្រង ទម្ងន់ គឺជា អ្នក ដែល មាន ការយល់ដឹង នៅក្នុង ទីតាំង សម្រក ទម្ងន់ ។
ដើម្បី ផ្លាស់ប្តូរ ស្ថានភាព យើង ប្តូរ សំណួរ ។
អ្នក ប្រហែលជាមានអ្វីដែលអ្នកផ្សេងមិនធ្វើ ។
តើកុំព្យូទ័ររបស់រថយន្តមាន ភាពឆ្លាត វៃគ្រប់គ្រាន់ក្នុងការ គ្រប់គ្រងធាតុចូលច្រើនក្នុងពេលតែមួយដែរឬទេ ?
នឹង មាន សេចក្តីរីករាយ ក្នុង ការបង្កើត គំនិត រួមគ្នា អំពី អ្វី ដែល ពាក្យ ត្រូវ
តើអាចទាក់ទងនឹងការ ឈឺចាប់របស់ ទីណា ជុំវិញការ មានកូនឬអត់ ?
ខ្ញុំ ចង់ និយាយ អំពី រដ្ឋាភិបាល ។
អ៊ីស្រាអែលបានធ្លាក់ចេញពីព្រះ ប៉ុន្តែគេមិនបានដឹងថាខ្លួនបានធ្លាក់ខ្លួនឡើយ ។
រឿង តែ មួយ គត់ គឺ អ្នក នឹង ត្រូវ ជ្រើសរើស មួយ ដែល សមរម្យ សម្រាប់ ការងារ របស់ អ្នក ។
រហូតដល់ នាង រៀបការ ជាមួយ បុរស
អាម៉ូញាក់ សម្រាប់ ការប្រើប្រាស់ ដើមឈើ ។
« កុំរុះរើរបងរហូតដល់ដឹងពីមូលហេតុដែលគេដាក់ » ។
តាំងពីគាត់មកផ្ទះក៏គ្មានហេតុ ផលសម្រាប់គាត់ស្នាក់នៅដែរ ។
អ្នក ដែល ល្បួង និង អ្នក ដែល ល្បួង បង្កើត អ្វី មួយ
ចំពោះ អ្នក និយមន័យ ផ្ទះ របស់ ខ្ញុំ ។
ព្រះរាជ បុត្រា និង ព្រះវិញ្ញាណ ឲ្យ ដូច ព្រះបិតា ។ អះអាងថាពួកគេ
ក្នុងពេល សម្ភាសគាត់បាននិយាយថា “ យើងរស់នៅផ្ទះសាច់ញាតិ ដូច្នេះយើងតែងតែនៅខាងក្រៅ ។
ខ្ញុំ និងមនុស្សទាំងអស់ដែលនៅ ជាមួយនឹងទៅជិតទីក្រុង ។
ខ្ញុំដូចជាវង្វេងពេលគាត់ចាកចេញពីម្សិលមិញ ។
បង្កើត រឿង អំពី រូបភាព ទាំងនោះ ។
មនុស្ស ចូលចិត្ត មើល នាង ព្រោះ នាង បោកប្រាស់ ។
ដូច្នេះ ទ្រង់មាន បន្ទូលទៅគេថា « ឈប់ខ្លាចឥឡូវនេះទៅ !
បន្ទាត់ ត្រូវតែ ស៊ីមេ ទ្រី ឆ្លងកាត់បន្ទាត់ កណ្តាល នៃ តុលាការ ។
អ្នកមិនអាចត្រូវបានគេលួចចូលទេរហូតដល់អ្នកមិនមានកំហុសដោយខ្លួនឯង។
