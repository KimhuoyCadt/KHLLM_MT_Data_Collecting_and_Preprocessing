ដូច្នេះ ជា រួម យើង ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការរក្សា ស្ថិរភាព ការផ្គត់ផ្គង់ អគ្គិសនី ដល់ ប្រជាពលរដ្ឋ ។
បាតុករ ជាច្រើន ពាន់ នាក់ ប្រឆាំង ការសុំ កូន ចិញ្ចឹម
លោក ហ៊ុន ម៉ានី បាន ជំរុញ លើកទឹកចិត្ត ប្អូន ៗ
កុំ ថា រដ្ឋាភិបាល ហ៊ុន សែន ផ្តាច់ការ នេះ មិន មែន ជា ការតស៊ូ មតិ ទេ ។
ឧទាហរណ៍ បញ្ញើ ក្អែកបញ្ញត្តិ អនុញ្ញាត កញ្ញា សញ្ញា ។
ការលើកឡើង អំពី ការព្រួយបារម្ភ និង ការគំរាមកំហែង ឱ្យ ពិនិត្យ ឡើងវិញ នូវ ឋានៈ អនុគ្រោះ ពន្ធ នេះ កាលពី លើក មុន ៗ
ក៏ប៉ុន្តែ ដោយ មាន សេចក្តីប្តេជ្ញាចិត្ត នឹង ភាពម្ចាស់ការ ក្នុង សកម្មភាព របស់ បណ្តា
រ អនុវត្ត និស្សិត ស្រី ក៏ ត្រូវ ដោះ គ្រឿង បន្លាស់
ពិត មែន ហើយក៏ ចង់អោយ ប្រិយមិត្ត សាកល្បង ដែរ ដោយ ប្រើ នូវ វិធី ងាយ ៗ
ប៉ូលិស កំពុង រក ក្រុមគ្រួសារ ដើម្បី ស្វែក រក ព័ត៌មាន ខ្លះ ៗ
ប្រទះឃើញ សព កុមារី អាយុ ១៣ ឆ្នាំ ម្នាក់ ក្នុង ទឹក កំប្លោក សង្ស័យ ជា ករណី រំលោភ សម្លាប់
ក៏ប៉ុន្តែ ជា យថាហេតុ ពួកគេ នឹង ផលិត វ៉ាក់សាំង នេះ ឱ្យ បាន ដល់ កម្រិត នេះ ។
ហេតុ ៥យ៉ាង ដែល មាន ចំណង់ ចង់បាន បុត្រ
វិធីសាស្ត្រ ទី1 ទូរស័ព្ទ ចល័ត វីគី
បច្ចុប្បន្ន លោក ជា គ្រូពេទ្យ ទូទៅ មួយ រូប នៅ មន្ទីរ សំរាក ព្យាបាល នាគ ទេព ។
ដើម្បី រក្សា ក្តីរំភើប នោះ ឱ្យ នៅតែ រស់រវើក ។
កូន ឆ្លើយ ទៅ បា ធ្វើ វា ហី តាម ដោយ សេចក្តីពិចារណា ។
លោកស្រី បញ្ជាក់ ទៀត ថា រណារ យន្ត ត្រូវបាន រក្សា ក្នុង ឃ្លាំង ក្នុង ស្នាក់ការស្រែ វា ល នៅ ឃុំ ធ្មា ។
លោក រដ្ឋមន្ត្រី បាន ឱ្យដឹង ថា សព្វ ថ្ងៃ ការដាំដុះ ដំណាំ ទុរេន របស់ …
បំផុត នៅលើ ពិភពលោក ។
កាល ណោះ រាល់ ពេល ល្ញាច បង ប្រុស របស់ ខ្ញុំ តែងតែ ជិះ កង់ ឌប់ ខ្ញុំ ទៅ រៀន ភាសារ អង់គ្លេស រាល់ ថ្ញៃតែ ខ្ញុំ អត់ ចូលរៀន ទេ លួច ចូល លេខ ហ្គម រហេូត ។
ប្រសិនបើ កម្មករ ត្រូវបាន អនុញ្ញាតឱ្យ ឈប់ សម្រាក មាន ប្រាក់ខែ កម្មករ នឹង មាន ពេល ចូលរួម តវ៉ា ជាមួយ គណបក្ស ប្រឆាំង ។
នេះ ជា ការឆ្លើយតប របស់ ថ្នាក់ដឹកនាំ ខេត្ត មកកាន់ ពួកយើង ។
ក្មេងស្រី អាយុ ១១ត្រូវ បង ជីដូនមួយ ចាប់រំលោភ ក្មេង អានា ចារ
ធានា ការពារ បូរណភាព ទឹកដី ប្រទេស កម្ពុជា គឺជា វិធានការ ដ៏ ត្រឹមត្រូវ ។
ដាំ ផ្ទាល់ ដី ស្វាយ ក្រហម ត្រូវបាន គេ ដាំ នៅក្នុង ផើង ធំ ៗ
សម្រួល ការប្រើប្រាស់
ចំណុច ទាំង ៣នេះ ដែល អាជីវកម្ម អនឡាញ ចាយវាយ ខ្ជះខ្ជាយ បំផុត !
ឡាវ ម៉េង ឃីន សមាជិក ព្រឹទ្ធសភា គណ
អ៊ីចឹង គាត់ គិត អំពី ច្បាប់ ជា មូលដ្ឋាន នៅក្នុង ការការពារ ជួយ ដល់ សហភាតា ។
និង ចុច ស៊ី ផ្លេត ម្លង់ គេ ឯង សារព័ត៌មាន នគរ វត្ត
សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បញ្ជាក់ ដូច្នេះ ម៉េច បាន ខ្ញុំ និង រង្ស៊ី វា បែក គ្នា !
មិន ធ្លាប់ ដឹង ពីមុន សោះឡើយ ថា សណ្តែក ក្រហម ជា អាហារ ល្អ សម្រាប់ សម្រក ទម្ងន់ !
ខាងក្រោម នេះ ជា ការសង្ខេប អំពី រឿង អាស្រូវ ស្នេហា របស់ អ្នក សិល្បៈ ដែល កើតមាន ក្នុង ឆ្នាំ ២០១២ ៖
នេះ បើ តាម ការបញ្ជាក់ របស់ មន្ត្រី ឥណ្ឌា ជាច្រើន ។
បញ្ហា ព្រំដែន គឺជា បញ្ហា ធ្ងន់ធ្ងរ មួយ ។
ក្នុង អំឡុង ពេល វាស់វែង និង បិទ ផ្សាយ ជាសាធារណៈ
ស្រុក ខណ្ឌ នីមួយ ៗ
លោក អំសំអាត អ្នកគ្រប់គ្រង បច្ចេកទេស នៅ អង្គការ លីកាដូ បាន ថ្លែង ថា យើង បាន ទទួល ពាក្យបណ្តឹង ពី ប្រជាពលរដ្ឋ ស្ទើរតែ គ្រប់ ខេត្ត នៅក្នុង ប្រទេស កម្ពុជា ៕
ចំណុច ដាំ គឺជា ដើមឈើ ពិត បណ្តើរ ៗ
នាម សិទ្ធ ជិាតក ទី ៧
អ្នក ជិះ ម៉ូតូ ម្នាក់ ត្រូវ ឡាន បុក ស្លាប់
បើ តាម សម្តេច តេជោ ហ៊ុន សែន យន្តហោះ នេះ អាច ចូលរួម ក្នុង ប្រតិបត្តិការ ទឹក ជំនន់ និង ភ្លើង ឆេះ ជាដើម ។
សមាជិក ១ លោក ឈុន ចេតនា
សញ្ញា ទាំង ៧យ៉ាង ដែល បញ្ជាក់ ថា អ្នក កំពុង ប្រឈមមុខ នឹង ជំងឺ បាក់ទឹកចិត្ត !
មនុស្ស ជោគជ័យ ទទួលយក ការភ័យខ្លាច និង ការលំបាក ទាំងអស់ ហើយ បោះជំហាន ទៅ មុខ ខិត ទៅ រក គោលដៅ របស់ គេ ។
មួយចំនួន ពុំ មាន លទ្ធភាព ជួល ម៉ោង ផ្សាយ ដូច គណបក្ស ធំ ៗ
គ្នា ទៅនឹង ការបញ្ចេញមតិ របស់ តារា សម្តែង សួង សាខា រ៉ានីត ខាងលើ ផងដែរ ៕
អំពើហិង្សា និង បៀតបៀន នៅ កន្លែង ការងារ ជា កត្តា រាំងស្ទះ ផលិតភាព ការងារ និង សុខុមាលភាព កម្មករ
ការប្រែប្រួល ពេល មក រដូវ ឈឺ តំបន់ ស្បូន មិន បាត់ ទម្ងន់ ធ្លាក់ចុះ ដោយ គ្មាន មូលហេតុ ។
ទោះបីជា យ៉ាងណា អ្នកស្រី អះអាង ថា បច្ចុប្បន្ន គ្រួសារ កំពុង ជួប បញ្ហា ជីវភាព បន្ទាប់ពី នាយ ស្មាញ ខ្លួន ឈឺ មិន អាច រក ចំណូល បាន ដូច ពីមុន ។
គាត់ រំលឹក ការអី ជា រឿង របស់ គាត់ ប៉ុន្តែ មិន អាច យកមក ចាក់ ល្អក់កករ នៅក្នុង បុណ្យ របស់ គេ ទេ ។
ខ្ញុំ អាយុ ១៨ប្តី ខ្ញុំ អាយុ ៦០ គ្រាន់តែ ខ្ញុំ ស្លៀក ខ្លី បន្តិច ប្តី ខ្ញុំ គាំង បេះដូង ស្លាប់ បាត់ ខ្មែរ កូសា បា
នៅ ពេល នោះ ខ្ញុំ បាន ជាប់ ចំណាត់ថ្នាក់ លេខ ៧ក្នុង ជំរើស ៨នាក់ ។
ឥឡូវនេះ យើង ជួបគ្នា ជា លើក ដំបូង ប៉ុន្តែ ខ្ញុំ សង្ឃឹម ថា បើសិន មាន សំណូមពរ យើង ក៏ អាច កំណត់ ជាមួយគ្នា មួយ ឆ្នាំ ម្តង ។
ចំនួន ៦ក្នុង ប្រទេស សិង្ហបុរី ចំពោះ ទស្សនវិស័យ របស់ ពួកគេ សម្រាប់ រយៈពេល ៦ខែ បន្ទាប់ រហូតដល់ ខែកញ្ញា ។
លោក បណ្ឌិត បញ្ជាក់ ថា តាម ទស្សនៈ របស់ ព្រហ្មញ្ញ សាសនា ចក្រវាឡ ទាំងមូល ត្រូវបាន បែងចែក ជា ៤យុគគឺ ៖
លោក សាំង គង់ គឺជា មនុស្ស ដែល អ្នក បន្ទាយមានជ័យ តែងតែ និយាយ ត ៗ
ជា សំណួរ ចុងក្រោយ តើ អ្វី ជា ការប្រមើល មើល របស់ លោក បណ្ឌិត ចំពោះ អនាគត នៃ សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន ?
នួន ជា មាន ប្រតិកម្ម យ៉ាង ខ្លាំង ចំពោះ សក្ខីកម្ម ដែល លោក បាន ផ្តល់ ទៅ លើ ការប្រើ ពាក្យ ថា យួន ។
ក្រុម ទាំង នេះ ត្រូវ សមត្ថកិច្ច រារាំង មិន ឱ្យ ចូលក្នុង រាជធានី ភ្នំពេញ ទេ ។
សូម ចុច ទីនេះ សម្រាប់ របាយការណ៍ លម្អិត ។
គិត តែ ថត រូប បង្ហោះ បង្អួត ស្រី ពេល ប្រពន្ធ ស្តី ឱ្យ វាយ ប៉ោង មុខ
សេង ហាង លក់ បន្លែ ធម្មជាតិ នៅ បឹងកេងកង ១ក្នុង …
ការខ្វះខាត អ្នក បើក យន្តហោះ អាច រារាំង ដល់ កំណើន របស់ ក្រុមហ៊ុន អាកាសចរណ៍
លោក ក៏ បាន ផ្តល់ អនុសាសន៍ ថា សម្រាប់ ខេត្ត បាត់ដំបង យើង ត្រូវ ធ្វើ ពិធី នេះ ជារៀងរាល់ ឆ្នាំ ចាប់ពី ឆ្នាំ នេះ តទៅ ផងដែរ ។
យើង យកមធ្យោបាយ ផ្សេង ៗ
នៅ ម៉ោង ជាង ៤រសៀល ថ្ងៃទី ២៥ ខែតុលា ពិធី ចាប់ផ្តើម បិទ បញ្ចប់ ។
និយាយ ដល់ ការគេង វា ទំនងជា មាន ភាពពិបាក ច្រើន សម្រាប់ ស្ត … សុខភាព ស្ត្រី
ជីវិត ជា របស់ ក្តៅ
ឃាត់ខ្លួន ៣នាក់ ពាក់ព័ន្ធ គ្រឿងញៀន
សូម កុំ និយាយ អាធុន ហ្នឹង ការនិយាយ ខុស ។
១ - ពាក្យសម្តី ដែល ស្តាប់ ហើយ អស់សង្ឃឹម ត្រូវ បំភ្លេច ចោល ភ្លាម ។
ព្រះបរម សាស្តា ទ្រង់ ត្រាស់ សម្តែង នូវ រឿង នេះ ហើយ ព្រះភគវា ព្រះអង្គ ទ្រង់ ប្រទាន នូវ ឱវាទ ដូច្នេះ ថា ម្នាល ភិក្ខុ ទាំងឡាយ គួរ កោត ដែរ យ៉ាង ពួកក្សត្រ ទាំងនោះ ធ្លាប់ តែ កាន់ ដំបង កាន់ គ្រឿង សស្ត្រា ហើយ មក ចេះ មាន អំណត់ ព្រមទាំង ប្រព្រឹត្ត ល្អ បែប នេះ បាន ។
បើ អ្នក ធ្វើ បែប នេះ ពាក្យ សម្ងាត់ របស់ អ្នក គួរតែ ១២ខ្ទង់ ។
នៅ ថ្ងៃ នេះ ដំណើរ ជីវិត របស់ លោក អ្នក ជឿនលឿន គួរសម ដូចនេះ បើ ចង់ ទំនាក់ទំនង ការងារ ឬ ចាប់ផ្តើម ធ្វើ អ្វី មួយ តែង មាន ការជឿនលឿន ទៅ មុខ ជានិច្ច ។
ចាំ តែ បរទេស ជួយ ទាំង រដ្ឋ ទាំង រាស្ត្រ សុទ្ធតែ គ្មាន បាន ការ ។
បន្ទាប់ ដកស្រង់ ម្រះ
វ៉េន រូនី ស្រក់ ទឹកភ្នែក បន្ទាប់ពី បង្ហាញ មុខ លើក …
ព្យាបាល កំចាត់ មុន និង បំបាត់ ស្លាកស្នាម បាន ឆាប់ រហ័ស
៣ - កាត់បន្ថយ ស្ករ ស្ត្រី ណា ដែល ចូលចិត្ត ផ្អែម អាច មិន សូវ សប្បាយ ចិត្ត ចំណុច នេះ ប៉ុន្មាន ឡើយ ព្រោះ ការពិត ស្ករ គឺជា តួអង្គ កំណាច ដែល ចាំ បំផ្លាញ កូឡា ជេន និង អ៊ីឡាស្ទីន ក្នុង រាងកាយ របស់ យើង ។
ជម្ងឺ បេះដូង គជា ឃាតករ លេខ មួយ របស់ មនុស្ស ប្រុស ស្រី ក្នុង សហរដ្ឋ អាមេរិក ដូច្នេះ ជំហាន ទាំងនេះ គឺ មាន សារៈសំខាន់ សំរាប់ មនុស្ស គ្រប់ គ្នា ។
នេះ បើ យោង តាម តំណាង ពាណិជ្ជកម្ម សហរដ្ឋ អាមេរិក ។
អ្វី ដែល ខ្ញុំ ឆ្លើយ គឺ ខ្ញុំ សម្របសម្រួល ទេ ។
គ្នា ដែល ជួយ លើក សម្រស់ របស់ ពួកគេ រៀង ៗ
លាបង រហូត ហើយ ប្អូន ប្រុស ពៅ សម្លាញ់ ចិត្ត របស់ បង ហេតុអី បាន យក ប្អូន ខ្ញុំ ទៅ ទាំង បែប នេះ
នឹង ដំណើរការ ទៅ យ៉ាង ល្អ ។
ដោយសារ ការសម្លាប់ លួច ឆក់ ប្លន់ ឬ ប្រព្រឹត្ត អំពើ ជ្រុលនិយម ផ្សេង ៗ
ការបកស្រាយ ផ្ទាល់ ៗ
ប៉ុន្តែ បើ ទោះបីជា មាន ការលំបាក និង នឿយហត់ បន្តិច មែន ក៏ នាង នូវ តែ មានអារម្មណ៍ សប្បាយ ចិត្ត និង មិន រាថយ នោះ ឡើយ ។
ភាគហ៊ុន និង ប្រេង ធ្លាក់ ថ្លៃ៣ ថ្ងៃ ជាប់ គ្នា ដោយ …
ការធ្លាក់ ភ្លៀង កំរិត ១៨០ មីលីម៉ែត្រ ក្នុង មួយ ថ្ងៃ អាច ចាត់ទុក ថា ជា ភ្លៀង ខ្លាំង ។
បទ វិភាគ បាន សង្កត់ធ្ងន់ ថា បច្ចុប្បន្ន នេះ ការគ្រប់គ្រង និង ដោះស្រាយ បញ្ហា អាកាសធាតុ ពិភពលោក កំពុង ឈានចូល ដំណាក់កាល គន្លឹះ ។
ពេលនេះ មន្ត្រី ជំនាញ កំពុង សាកសួរ ជនសង្ស័យ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ហើយ ៕
ម្ទេស ៥ដំអោយ បែក
សម្ភារះ សម្រាប់ ពន្លឿន ការស្រាវជ្រាវ រក សញ្ញា នៃ ជីវិត អតិសុខុមប្រាណ លើ ពិភព ព្រះអង្គារ
ផ្ទះ ត្រូវបាន រើ ហើយ កែលំអ ថ្មី ។
តម្លៃ នេះ អាច ធ្វើឱ្យ គេ ទទួល តម្លៃ ពី CPP រហូតដល់ ថ្នាក់ ទីប្រឹក្សា រាជ រដ្ឋាភិបាល ឬ អនុ រដ្ឋលេខាធិការ ឬ អាច ទទួលបាន តំណែង អ្វី មួយ ទៅ ។
ទទួលបាន ថវិកា២០០,០០០រៀល ម្ភៃ ម៉ឺន រៀល គត់ ៕
តើ អ្នក ទុកចិត្ត
ការព្យាបាល និង ការជួយ ខ្លួន ឯង
គាត់ វ៉ៃ សម្លាប់ ហើយ គាត់ ឱ្យ ខ្ញុំ ទៅ កប់ ព្រោះ គាត់ ប្រើ ឱ្យ ខ្ញុំ កាប់ រណ្តៅ ។
អត្ថបទ បន្ទាប់រោះ ថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៦ខែសីហា ស្លាប់ ៥នាក់ របួស ៨នាក់
ស្វាយ ស្រូវ ម្រេច
លិខិត បាន បញ្ជាក់ ថា ៖
លោក ហ៊ុន សែន ការពារ ភាព ស្រប ច្បាប់ របស់ រដ្ឋាភិបាល
ប៉ុន្តែ ពួកគេ អះអាង ថា កំពុង ធ្វើ កិច្ចសហការ ជាមួយ អង្គភាព ទ័ព ក្នុង ការតាម ស្រាវជ្រាវ ក្រុម ចោរប្លន់ នោះ ហើយ ។
ត្រង់ ចំណុច នេះ លោក បណ្ឌិត អាច ពន្យល់ បាន ទេ នូវ ការយល់ដឹង ឬ ក៏ ទស្សនៈ របស់ កឹម សុខា អំពី ប្រយោជន៍ នៃ សន្តិភាព ?
យោគេ ន្ទ្រាលយ យោគ ឥន្ទ្រ អាលយ
ក្រុម សិទ្ធិ មនុស្ស ថ្កោល ទោស ការបំបិទ សំឡេង ក្រុម តវ៉ា ដីធ្លី
ពី សត្រូវ ទៅ ជា មិត្ត
ឪពុក ម្តាយ មាន ការព្រួយបារម្ភ ជាខ្លាំង នៅ ពេល ដែល កូន ក្តៅ ខ្លួន តែ អ្វី ដែល ធ្វើឱ្យ ពួកគាត់ ស្ត្រេស និង ថប់បារម្ភ ជាង នឹង ទៅ ទៀត នោះ គឺ ធ្វើ យ៉ាង ឱ្យ កូន ត្រជាក់ ខ្លួន វិញ ហើយ មិន មាន ផល ប៉ះពាល់ ដល់ កូន ទៅ ថ្ងៃ ក្រោយ ។
ភីយ៉ា បង្ហើប អារម្មណ៍ ពិត ក្នុង ចិត្ត ក្រោយ ក្លាយជា ទូត សុឆន្ទៈ របស់ ម៉ាលី - ជីវិត និង សង្គម
សផទល់ របស់ ពកេួគ ។
ការរចនាយន្តការ នៃ cam រួមផ្សំគ្នា ។
ទង់ជាតិ នៃ ព្រះរាជាណាចក្រ កម្ពុជា សេក មាស
លោកស្រី សុទ្ធី ហៃដ្ឋ ៖
ហើយ ព្រោះ រដូវកាន់ បិណ្ឌ កាន់តែ ជិត ចូល មកដល់ ។
ពិភព អច្ឆរិយៈ និង ភាពសម្បូណ៍ បែប
រហូតដល់ ១៥ម៉ឺន ដុល្លារ ក្នុង គោលបំណង ជួយ សម្រួល ដល់ ជីវភាព ជន ពិការ ។
