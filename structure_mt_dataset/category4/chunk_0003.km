តើអ្នកអាចវាស់អោយខ្ញុំបានទេ ?
នេះមិនមែនទំហំខ្ញុំទេ ។
សូមយកអាតូចជាងនេះ ។
ខ្ញុំកំពុងរកកាបូបដៃមួយ ។
នេះជាស្បែកពិតឬ ?
វារាងធំបន្តិច ។
តើអ្នកអាចបង្ហាញក្រែមផាត់ភ្នែកបានទេ ?
តើអ្នកមានពណ៌ផ្សេងទេ ?
តើអាចបង្ហាញចិញ្ចៀននេះអោយខ្ញុំបានទេ ?
តើអ្នកមានម៉ូដផ្សេងទេ ?
តើមានធានារ៉ាប់រងទេ ?
តើអ្នកអាចព្រីនហ្វីលនេះបានទេ ?
សូមហត្ថលេខារបស់អ្នក ។
តើសែកអ្នកដំណើរបានទេ ?
សូមជាមួយធានារ៉ាប់រង ។
ផ្ញើធម្មតាថ្លៃប៉ុន្មាន ?
តើអ្នកអាចខ្ចប់វាជាកាដូបានទេ ?
តើអ្នកអាចខ្ចប់ផ្សេងគ្នាបានទេ ?
ខ្ញុំចង់បានប្រាក់បង្វិលមកវិញ ។
តើខ្ញុំអាចប្ដូរវាបានទេ ?
មានបែកត្រង់នេះ ។
ខ្ញុំទុកកាម៉េរានៅក្នុងតាក់ស៊ី ។
តើកន្លែងបាត់និងរកឃើញរបស់នៅឯណា ?
តើអ្នកមានឃើញកាបូបខ្មៅនៅត្រង់នេះទេ ?
កាបូបនិងកាម៉េរា ។
តើខ្ញុំអាចសុំច្បាប់ចំលងនៃរបាយការណ៍ប៉ូលីសបានទេ ?
ខ្ញុំត្រូវការថ្នាំខ្លះ ។
សុំថ្នាំផ្តាសាយ ។
តើអ្នកបង់បិតដំបៅទេ ?
តើអ្នកអាចបំពេញវេជ្ជបញ្ជានេះបានទេ ?
ខ្ញុំមិនសូវយល់ទេ ។
ស្តាប់មើលទៅល្អ ។
តើអ្នកអាចនិយាយម្តងទៀតបានទេ ?
អត់ទោស តើកៅអីខ្ញុំនៅទីណា ?
ខ្ញុំសុំកន្លែងអង្គុយដែលគ្មានការជក់បារី ។
តើខ្ញុំអាចដាក់កាបូបខ្ញុំខាងលើបានទេ ?
ខ្ញុំមិនអាចដាក់កាបូបខ្ញុំក្រោមកៅអីអង្គុយទេ ។ តើអ្នកអាចរក្សាអោយខ្ញុំបានទេ ?
តើខ្ញុំអាចប្ដូរកន្លែងអង្គុយបានទេ ?
តើខ្ញុំទេរកន្លែងអង្គុយយ៉ាងម៉េច ?
តើខ្ញុំអាចទេរកៅអីខ្ញុំបានទេ ?
តើអ្នកអាចប្ដូរកន្លែងជាមួយខ្ញុំបានទេ ?
តើអាចបង្ហាញខ្ញុំពីរបៀបដាក់ខ្សែក្រវ៉ាត់បានទេ ?
តើអាចប្រាប់ខ្ញុំពីរបៀបបើកភ្លើងបានទេ ?
ខ្ញុំមិនយល់ទេ ។ តើអ្នកអាចនិយាយយឺតៗបានទេ ?
តើមានអ្នកបំរើលើយន្តហោះដែលចេះជប៉ុនទេ ?
តើខ្ញុំអាចសុំស្រាមួយកែវបានទេ ?
ខ្ញុំចង់បានកាហ្វេមួយកែវ ។
តើអ្នកអាចយកទឹកផ្លែប៉ោមអោយនាងខ្លះបានទេ ?
តើខ្ញុំអាចសុំទឹកក្រូចស្រស់និងទឹកកកខ្លះបានទេ ?
តើទឹកនេះជាសេវាកម្មមិនគិតថ្លៃឬ ?
តើខ្ញុំអាចសុំភេសជ្ជៈមួយទៀតបានទេ ?
មានបញ្ហាខ្លះជាមួយកាសត្រចៀកនេះ ។
តើប៉ុស្តមួយណាដែលភ្លេងពេញនិយមនៅ ?
តើខ្ញុំអាចសុំភេសជ្ជៈខ្លះមុនអាហារបានទេ ?
តើអ្នកចង់បានមួយណា សាច់ឬបន្លែ ?
ខ្ញុំចង់បានសាច់ ។
ខ្ញុំចង់បានត្រី ។
ខ្ញុំនឹងគេងហើយ ដូចនេះខ្ញុំមិនត្រូវការអាហារទេ ។ អរគុណ ។
តើអ្នកមានម្ហូបសាច់មាន់ទេ ?
តើខ្ញុំអាចសុំក្រូចឆ្មាខ្លះសំរាប់តែខ្ញុំបានទេ ?
តើអាចសំអាតតុខ្ញុំបានទេ ?
ខ្ញុំមានអារម្មណ៍ថាផ្តាសាយ ។
ខ្ញុំគិតថាខ្ញុំពុលយន្តហោះហើយ ។
ខ្ញុំគិតថាខ្ញុំផឹកច្រើនពេក ។
មិត្តខ្ញុំមើលទៅដូចជាពុលយន្តហោះហើយ ។
តើខ្ញុំសុំភួយថែមមួយបានទេ ?
តើខ្ញុំសូមខ្នើយអោបបានទេ ?
តើអាចអោយខ្ញុំទឹកមួយកែវទៀតបានទេ ?
ខ្ញុំសុំកន្សែងក្តៅបានទេ ?
តើអាចយកថ្នាំចុកពោះខ្លះអោយខ្ញុំបានទេ ?
តើអ្នកអាចជួយខ្ញុំទៅបន្ទប់ទឹកបានទេ ?
តើអ្នកមានថង់ពុលយន្តហោះទេ ?
ខ្ញុំគ្រាន់បើហើយ អរគុណ ។
តើអ្នកលក់ទំនិញមិនជាប់ពន្ធទេ ?
តើអ្នកមានស៊ីហ្គាទេ ?
តើអាវការពារជីវិតខ្ញុំនៅទីណា ?
តើអាចប្រាប់ខ្ញុំពីសេចក្តីប្រកាសម្តងទៀតបានទេ ?
តើអាចប្រាប់ខ្ញុំពីរបៀបបំពេញបានទេ ?
តើខ្ញុំបំពេញទំរង់ច្រកចូលនេះត្រឹមត្រូវទេ ?
តើជើងហោះហើរនេះដល់ទាន់ពេលទេ ?
តើកន្លែងអន្តោប្រវេសន៍នៅទីណា ?
ខ្ញុំមកដើម្បីមុខជំនួញ ។
ខ្ញុំនឹងរៀនវិទ្យាសាស្ត្រនៅសកលវិទ្យាល័យ ។
ខ្ញុំមកលេងមិត្តខ្ញុំ ។
ខ្ញុំមកវិស្សមកាល ។ ដើរមើល ។
ការងារអ្វីដែរ ?
ខ្ញុំធ្វើការអោយធនាគារមួយ ។
នេះជាការធ្វើដំណើរដំបូងរបស់អ្នកឬ ?
បាទ ជាលើកដំបូង ។
នេះជាលើកទីពីររបស់ខ្ញុំ ។
តើអ្នកនឹងទៅលេងកន្លែងណាក្នុងប្រទេសនេះ ?
តើអ្នកនឹងនៅទីណាក្នុងការធ្វើដំណើរអ្នកនេះ ?
ខ្ញុំនឹងនៅជាមួយមិត្តខ្ញុំ ។
តើអ្នកនឹងនៅក្នុងប្រទេសនេះយូរប៉ុណ្ណា ?
ប្រហែលមួយសប្ដាហ៍ ។
តើអ្នកជាសមាជិក្រុមមែនទេ ?
តើអ្នកមានលុយប៉ុន្មានជាប់ខ្លួន ?
ខ្ញុំមានប្រហែលបីរយដុល្លារ ។
តើអ្នកសំបុត្រត្រលប់ទៅជប៉ុនវិញទេ ?
ទេ ខ្ញុំនឹងរកអោយបានអំឡុងពេលការស្នាក់នៅខ្ញុំ ។
ខ្ញុំនឹងទៅវិញតាមផ្លូវគោក ។
សូមលិខិតឆ្លងដែននិងកាតប្រកាស ។
ខ្ញុំមានបារីដប់សុងនិងស្រាបីដប ។
ខ្ញុំមានកាម៉េរ៉ាវីដេអូមួយ ។
អ្នកត្រូវបង់ពន្ធសម្រាប់របស់ទាំងនេះ ។
សូមបង្ហាញកាបូបរបស់ខ្ញុំ ។
តើអ្នកមានរុក្ខជាតិទេ ?
នេះជាកាដូសំរាប់មិត្តខ្ញុំ ។
នេះជាថ្នាំខ្ញុំ ។
វាជាកាបូបស្បែកធំមួយ ។
វាជាកាបូបក្រហមមួយជាមួយស្លាកមួយ ។
តើអ្នកមានស្លាកសំរាប់កាបូបអ្នកទេ ?
តើអ្នកអាចជួយខ្ញុំរកកាបូបខ្ញុំបានទេ ?
យើងចង់ធ្វើរបាយការណ៍បាត់កាបូប ។
សូមទាក់ទងខ្ញុំនៅពេលអ្នករកឃើញកាបូបខ្ញុំ ។
តើអ្នកចង់អោយគេដឹកវាទៅសណ្ឋាគារអ្នកឆាប់ៗទេត ?
ខ្ញុំឃើញកាបូបខ្ញុំខូចហើយ ។
ខ្ញុំទាមទារអោយក្រុមហ៊ុននេះសងការខូចខាត ។
តើក្រុមហ៊ុននឹងសងទេ ?
តើខ្ញុំអាចជិះឡានក្រុងទៅទៅក្រុងនៅទីណា ?
តើវាថ្លៃប៉ុន្មានទៅទីក្រុងតាមរយៈឡានក្រុងព្រលានយន្តហោះ ?
តើអ្នកអាចបើកប្រាក់ពីសែកធ្វើដំណើរនេះបានទេ ?
តើអ្នកមានអត្តសញ្ញាណសំគាល់ទេ ?
ខ្ញុំចង់ប្ដូរលុយយ៉េនទៅជាដុល្លារខ្លះបានទេ ?
ខ្ញុំចង់ប្ដូរប្រាក់ទាំងនេះទៅជាកាក់បានទេ ?
ខ្ញុំចង់បានលុយរាយខ្លះ ។
សូមចុះហត្ថលេខាលើសែកត្រង់នេះ ។
របងឡើងយន្តហោះអ្នកគឺលេខដប់ប្រាំពីរ ។
ខ្ញុំបានបាត់បណ្ណឡើងយន្តហោះហើយ ។
តើខ្ញុំអាចនៅលើយន្តហោះបានទេ ?
តើខ្ញុំអាចចាប់ផ្តើមឡើងបាននៅម៉ោងប៉ុន្មាន ?
ខ្ញុំចង់បានកន្លែងអង្គុយនៅជាប់បង្អួច ។
តើបន្ទប់រង់ចាំនៅទីណា ?
ខ្ញុំចង់បានកន្លែងអង្គុយនៅផ្លូវដើរ ។
តើអ្នកអាចបើកឃ្លុបក្រោយបានទេ ?
