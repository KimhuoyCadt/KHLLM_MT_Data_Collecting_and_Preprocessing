តើអ្នកងាចត្រួតពិនិត្យប្រេងហ្វ្រាំងបានទេ ?
តើអ្នកអាចបង្ហាញខ្ញុំបានទេថានៅលើផែនទីនេះខ្ញុំនៅកន្លែងណា ?
តើអ្នកអាចប្រាប់ខ្ញុំពីរកន្លែងគួរឱ្យចាប់អារម្មណ៍មួយចំនួននៅក្នុងក្រុងនេះបានទេ ?
ខ្ញុំមានការចាប់អារម្មណ៍នឹងស្ថាបត្យកម្ម ។
តើកន្លែងដែលល្អបំផុតដើម្បីជួបមនុស្សក្មេងៗនៅឯណា ?
តើទីណាជាកន្លែងមួយដែលអាចរីករាយជាមួយនិងទេសភាពស្រស់ស្អាត ?
តើវាចំណាយពេលប៉ុន្មានដើម្បីទៅដល់ទៅទីនោះ និងត្រឡប់មកដល់វិញ ?
តើអ្នកអាចណែនាំទីកន្លែងមួយចំនួនដែលខ្ញុំអាចទៅ និងត្រឡប់មកវិញនៅថ្ងៃនេះបានទេ ?
ខ្ញុំចង់ជិះរទេះសេះ ។ តើវាមានតម្លៃប៉ុន្មាន ?
តើមានការធ្វើដំណើរកំសាន្តតាមទឹកមើលទេសភាពរយៈពេលពីរម៉ោងដែរឬទេ ?
តើខ្ញុំអាចទិញសំបុត្រនៅទីនេះបានទេ ?
តើខ្ញុំអាចឡើងជិះទូកនៅឯណា ?
អ្នកគួរតែឡើងជិះឡានក្រុងលេខប្រាំ ។
តើមានហាងអំណោយដែរឬទេ ?
តើហាងលក់ទំនិញបើកយូរដល់ពេលណា ?
តើពួកវាបើកនៅថ្ងៃអាទិត្យទេ ?
តើវាបើក និងបិទនៅម៉ោងប៉ុន្មាន ?
តើមានការធ្វើដំណើរកំសាន្តរយៈពេលកន្លះថ្ងៃដែរឬទ ?
តើមានការធ្វើដំណើរកំសាន្តរយៈពេលមួយរសៀលដែរឬទ ?
តើមានដំណើរកំសាន្តមួយយប់ឬទ ?
តើអ្នកអាចប្រាប់ខ្ញុំកន្លែងដែលពួកយើងនឹងឡើងជិះដំណើរកំសាន្តបានដែរឬទ ?
ទេអត់ទេ ។ ពួកយើងនឹងមើលវាពីឡានក្រុង ។
តើវានឹងចំណាយពេលប៉ុន្មានដើម្បីបញ្ចប់ការធ្វើដំណើរកំសាន្តនេះ ?
នៅកន្លែងណា និងម៉ោងប៉ុន្មានដែលយើងត្រឡប់មកវិញ ?
តើពួកយើងមានអ្នកមគ្គទេសន៍និយាយភាសាជប៉ុនដែរឬទេ ?
ខ្ញុំចង់ជួលអ្នកមគ្គទេសន៍និយាយភាសាជប៉ុន ។
ខ្ញុំសុំទោស ។ ពួកយើងមានតែអ្នកមគ្គទេសន៍និយាយភាសាអងគ្លេស ។
តើនរណារស់នៅទីនេះ ?
តើទន្លេនោះមានឈ្មោះអ្វី ?
តើខ្ញុំមានពេលគ្រប់គ្រាន់ដើម្បីថតរូបដែរឬទ ?
តើខ្ញុំមានពេលញ៉ាំអីដែរឬទេ ?
តើខ្ញុំអាចទៅបន្ទប់សំរាន្តបានទេ ?
តើខ្ញុំគួរតែត្រឡប់មកឡានក្រុងវិញនៅមុនម៉ោងប៉ុន្មាន ?
តើបឹងនោះមានឈ្មោះអ្វី ?
អត់ទោស ។ តើអ្នកអាចប្រាប់ខ្ញុំពីផ្លូវទៅកាន់ការិយាល័យប្រៃសណីយ៍បានទេ ?
អ្នកគួរតែជិះឡានក្រុង ។
តើមានចំណតឡានក្រុងប៉ុន្មានរហូតដល់ទីនោះ ?
ខ្ញុំនឹងយកអ្នកទៅទីនោះ ។
តើវានៅខាងឆ្វេង ឬខាងស្តាំដៃ ?
តើមានជួរផ្ទះល្វែងប៉ុន្មាន ?
តើមានការបញ្ចុះតម្លៃខ្លះទេ ?
តើពួកយើងពុំអាចយកឥវ៉ាន់ទាំងនោះជាមួយអ្នកបានទេ ។
តើអ្នកអាចថែរក្សាឥវ៉ាន់ទាំងនោះបានទេ ?
តើនរណាគូររូបភាពនេះ ?
តើអ្នកមានការងារល្បីល្បាញទេនៅទីនេះ ?
ខ្ញុំមានការចាប់អារម្មណ៍នឹងរូបចម្លាក់ ។
តើអ្នកចាប់ផ្តើមដំណើរទេសចរណ៍មានមគ្គទេសន៍នៅម៉ោងប៉ុន្មាន ?
តើអ្នកអាចណែនាំអ្វីមួយដែលមានប្រជាប្រិយសម្រាប់ជាវត្ថុអនុស្សាវរីយ៍បានទេ ?
តើមានកន្លែងណាមួយដែលខ្ញុំអាចញ៉ាំអីបានទេ ?
តើព្រះវិហារនោះមានឈ្មោះអ្វី ?
តើរូបចម្លាក់នោះជាអ្វី ?
តើអ្នកអាចថតរូបភាពនេះបានទេ ?
គ្រាន់តែរុញគម្របនេះបានហើយ ។
តើអ្នកចង់ថតរូបជាមួយខ្ញុំទេ ?
តើអ្នកអាចសរសេរអាស័យដ្ឋានរបស់អ្នកនៅទីនេះបានទេ ?
តើអាចឱ្យហ្វីលពណ៌ខ្ញុំមួយដុំបានទេ ?
តើខ្ញុំអាចឱ្យគេលាងហ្វិលនៅឯណា ?
តើអ្នកអាចលាងហ្វីលនេះបានទេ ?
តើអ្នកអាចថតចម្លងរូបភាពនេះបានទេ ?
តើខ្ញុំអាចយកវារួចរាល់នៅពេលណា ?
តើអ្នកអាចត្រួតពិនិត្យវាសម្រាប់ខ្ញុំបានដែរឬទេ ?
ខ្ញុំចង់មើលការប្រគំភ្លេងមួយ ។
តើមានតន្ត្រីខ្លះទេនៅយប់នេះ ឬយប់ស្អែក ?
តើកាសម្តែងអ្វីដែលមានប្រជាប្រិយភាពជាងគេនាពេលឥលូវនេះ ?
តើការសម្តែងនៅពេលល្ងាចលើកដំបូងចាប់ផ្តើមនៅម៉ោងប៉ុន្មាន ?
តើភ្លេងអ្វីដែលមានប្រជាប្រិយភាពជាងគេនាពេលឥលូវនេះ ?
តើកន្លែងអង្គុយនៅឯណា ?
តើអ្នកមានបន្ទប់ឈរខ្លះទេ ?
តើខ្ញុំអាចបានកន្លែងអង្គុយនៅក្នុងបន្ទប់ទស្សនាពិសេសបានទេ ?
ខ្ញុំចង់បានកន្លែងអង្គុយដែលនៅមិនឆ្ងាយមកវិញទេ ។
ខ្ញុំចង់បានកន្លែងអង្គុយមួយដែលនៅកណ្តាល ។
តើខ្ញុំអាចបានកន្លែងអង្គុយនៅក្នុងក្រុមភ្លេងបានទេ ?
តើការសម្តែងប្រភេទណាដែលអ្នកមាន ?
តើមានសំលៀកបំពាក់ផ្លូវការដែលតម្រូវដែលឬទេ ?
ហើយចុះនារីវិញ ?
សូមកុំពាក់ខោខោប៊យ ឬក៏អាវយឺត ។
ពួកយើងនឹងថែរក្សាអាវធំរបស់អ្នក ។
សូមឱ្យតុខ្ញុំមួយបានទេ ?
តើខ្ញុំអាចប្ដូរកន្លែងអង្គុយរបស់ខ្ញុំទៅកាន់ជួរមុខបានទេ ?
សូមឱ្យស្រាវីស្គី និងសូដាមួយ និងស្រាគោញាក់មួយមក ?
តើតម្លៃរាប់បញ្ចូលរាល់ការគិតទាំងអស់ឬ ?
សូមឱ្យអាវធំខ្ញុំបានទេ ?
តើមានកន្លែងរាំនៅក្នុងក្រុងនេះដែរឬទេ ?
តើខ្ញុំអាចដើរទៅទីនោះពីទីនេះបានទេ ?
តើអ្នកបិទនៅពេលណានៅយប់នេះ ?
នៅម៉ោងបីព្រឹក ។
សូមឱ្យខ្ញុំមួយទៀតមក ។
តើកាស៊ីណូបើកនៅម៉ោងប៉ុន្មាន ?
តើអ្នកអាចណែនាំកាស៊ីណូល្អមួយបានទេ ?
តើមនុស្សគ្រប់រូបត្រូវអនុញ្ញាតឱ្យចូលកាស៊ីណូឬ ?
នៅបេឡានៅទីនោះ ។
សូមអោយដំឡូងបារាំងស្រួយតំលៃដប់ដុល្លារ ។
ខ្ញុំចង់សាកល្បែបង្វិលកង់មូល ។
តើខ្ញុំអាចលេងមួយនវដោយរបៀបណា ?
អ្នកគ្រាន់តែដាក់កាក់ក្នុងលេខដែលអ្នកភ្លាល់ ។
ខ្ញុំភ្លាល់បីដុល្លារលើមួយនេះ ។
តើខ្ញុំអាចនៅទីនេះដើម្បីមើលវាបានដែរឬទេ ?
សូមឱ្យវីស្គីខ្ញុំមួយមក ?
តើខ្ញុំអាចមើលការប្រកួតបាល់ទាត់យប់នេះបានទេ ?
តើវាចប់ប្រហែលជានៅម៉ោងប៉ុន្មាន ?
តើអាចឱ្យសំបុត្រខ្ញុំមួយបានទេ ?
តើអ្នកអាចយកសំបុត្រពីរឱ្យខ្ញុំបានទេ ?
តើមានកន្លែងមួយដែលខ្ញុំអាចញ៉ាំអាហារបានដែរឬទេ ?
លេខគឺលេខប្រាំពីរ ។
តើមានឡានក្រុងមួយបន្ទាប់ពីការប្រកួតដែរឬទេ ?
សូមឱ្យហតដកមួយ និងទឹកក្រូចមួយមក ?
តើខ្ញុំអាចទិញអាវយឺតនៅឯណា ?
ខ្ញុំចង់លេងកូនហ្គោល ។ តើមានតារាងវាយកូនហ្គោលណាមួយនៅក្បែរនេះទេ ?
ប្រាកដជាបាន ។ តើអ្នកចង់លេងនៅពេលណា ?
នៅថ្ងៃស្អែកប្រសិនជាអាច ។
ពួកយើងមានគ្នាបីនាក់ ។
វាប្រហែលជាមិនអីនោះទេប្រសិនបើអ្នកចាប់ផ្តើមនៅម៉ោងប្រាំបីគត់ ។
តម្លៃសាមសិបដុល្លារក្នុងម្នាក់រាប់បញ្ចូលទាំងថ្លៃឈ្នួលពណ៌បៃតង និងការដឹកជញ្ជូនធ្វើដំណើរជុំវិញ ។
ប្រាំដុល្លារសម្រាប់រទោះមួយ ។
ក្លឹបជួលតម្លៃប្រាំបីដុល្លារសម្រាប់មួយឈុតពេញ និងការជួលស្បែកជើងគឺពីរដុល្លារ ។
តើអ្នកនឹងចាកចេញនៅម៉ោងប៉ុន្មាននៅថ្ងៃស្អែក ?
សូមមកកន្លែងទទួលភ្ញៀវក្នុងសណ្ឋាគារនៅម៉ោងប្រាំពីរគត់ ។
តើខ្ញុំអាចកក់ទីលានវាយតែនីសនៅម៉ោងប្រាំបួនគត់ក្នុងមួយម៉ោង ?
តើមានរឿងរ៉ាវមិនធម្មតាដែលបានបង្កើតនៅក្នុងក្រុងនេះទេ ?
តើតូបបើកនៅម៉ោងប៉ុន្មាន ?
ខ្ញុំចង់ទិញប្រដាប់ប្រដាផ្ទះបាយ ។
តើអ្នកអាចណែនាំហាងលក់ទំនិញដែលមានប្រជាប្រិយក្នុងចំណោមមនុស្សក្មេងៗបានទេ ?
តើខ្ញុំអាចទិញសំលៀកបំពាក់នៅឯណា ?
តើអ្នកលក់អ្វីនៅជាន់ទីពីរ ?
ខ្ញុំចង់ទិញឈុតហែលទឹក ។ តើខ្ញុំអាចរកវានៅឯណា ?
តើអ្នកមានអ្វីដែលធ្វើជាពិសេសនៅក្នុងតំបន់នេះដែរឬទេ ?
ខ្ញុំកំពុងស្វែងរកអ្វីមួយសម្រាប់ម្តាយរបស់ខ្ញុំ ។
តើអ្នកអាចណែនាំអ្វីមួយដែលល្អសម្រាប់ជាវត្ថុអនុស្សាវរីយ៍បានទេ ?
តើអ្នកអាចបង្ហាញអាវរងារតូចៗបានទេ ?
តើអ្នកអាចបង្ហាញអាវរងារនោះមកខ្ញុំបានទេ ?
ខ្ញុំចង់មើលមួយនេះ ។
ខ្ញុំចង់បានអាមួយនៅតាមបង្អួចនោះ ។
តើពណ៌ប្រភេទអ្វីដែលអ្នកមាន ?
ខ្ញុំកំពុងរកមើលអាវយឺតមួយសម្រាប់ក្មេងប្រុសអាយុដប់ឆ្នាំ ។
តើអ្នកមានម៉ូតផ្សេងខ្លះទេ ?
ខ្ញុំកំពុងរកមើលអាវយឺតមួយសម្រាប់ក្មេងស្រីអាំយុដប់ឆ្នាំ ?
មួយនេះតឹងខ្លាំងណាស់ ។
មួយនេះរលុងខ្លាំងណាស់ ។
តើអ្នកមានមួយផ្សេងដែលចាំងជាងនេះបានទេ ?
តើខ្ញុំអាចពាក់វាម្តងទៀតបានទេ ?
ខ្ញុំមានអារម្មណ៍ថាតឹងនៅទីនេះ ។
តើខ្ញុំគួរតែយកអាវទំហំអ្វី ?
តើអ្នកមានសំលៀកបំពាក់មានពណ៌សដែរឬទេ ?
តើអ្នកអាចបង្ហាញចិញ្ចៀននេះមកខ្ញុំបានទេ ?
ខ្ញុំសុំទោស ។ ខ្ញុំនឹងមកម្តងទៀត ។
តើអ្នកមានការឆ្នៃម៉ូតផ្សេងដែរឬទេ ?
តើអ្នកមានអាមួយតូចជាងនេះបន្តិចបានទេ ?
តើអ្នកមានអ្វីមួយដែលមានកូនសោរដែរឬទេ ?
ខ្ញុំចង់បានចំនួនបីដូចនឹងមួយនេះ ។
នេះជាអំណោយមួយ ។
តើអ្នកខ្ចប់ទាំងនេះដាច់ដោយឡែកពីគ្នាបានទេ ?
តើខ្ញុំអាចសុំស្បោងក្រដាសបានទេ ?
តើអ្នកអាចបង្ហើតបែបបទសម្រាប់ខ្ញុំបានដែរឬទេ ?
តើមានកន្លែងប្ដូរប្រាក់ដែរឬទេ ?
តើមានកំហុសនៅក្នុងវិក័យប័ត្រនេះឬ ?
ខ្ញុំនៅមិនទាន់បានលុយអាប់មកវិញនៅឡើយទេ ។
តើអ្នកអាចប្រាប់ខ្ញុំរបៀបធ្វើឱ្យវាមិនជាប់ពន្ធបានទេ ?
សូមឱ្យបែបបទដកប្រាក់ពន្ធមកវិញបានទេ ?
តើអ្នកអាចដឹកជញ្ជូនវាទៅកាន់សណ្ឋាគារ Boston បានដែរឬទេ ?
តើខ្ញុំគួរតែធ្វើអ្វីដើម្បីអាចផ្ញើររបស់នេះទៅកាន់ប្រទេសជប៉ុនបាន ?
