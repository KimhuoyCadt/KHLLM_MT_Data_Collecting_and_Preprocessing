សមាជិកនៃរដ្ឋសភាមានរយៈពេលប្រាំមួយឆ្នាំក្នុងមួយអណត្តិ ក្នុងខណៈពេលដែលសមាជិកពាក់កណ្តាលទទួលការបោះឆ្នោតរៀងរាល់បីឆ្នាំម្តង ។
តើអាយុដែលអាចបោះឆ្នោតបាននៅក្នុងប្រទេសជប៉ុនគឺប៉ុន្មាន ?
តើការិយាល័យរដ្ឋាភិបាលកណ្តាលមានប៉ុន្មាន ?
មានប្រហែលម្ភៃ ។
MITI មានការល្បីល្បាញសូម្បីនៅក្រៅប្រទេសជប៉ុន ។
វាគឺជាក្រសួងពាណិជ្ជកម្ម និងឧស្សាហកម្មអន្តរជាតិ ។ វាបានបង្កើនពាណិជ្ជកម្មអន្តរជាតិបន្ទាប់ពីសង្រ្គាមដែលនេះជាមូលហេតុ ។
នៅក្នុងប្រទេស ផែនការថវិកានៅក្រសួងសុខភាព និងសុខុមាលភាពមានចំនួនច្រើន ។
ក្នុងចំណោមរដ្ឋាភិបាលក្នុងតំបន់ រដ្ឋាភិបាលរាជធានី Tokyo មានទំហំធំធំជាងគេខ្លាំងណាស់ ។
មានចំនួនសែសិបប្រាំមួយ ។ ខេត្តនីមួយៗត្រូវបានដឹកនាំដោយអភិបាលម្នាក់ ហើយខេត្តនីមួយៗមានសភារបស់វារៀងៗខ្លួន ។
តើមានគណបក្សនយោបាយចំនួនប៉ុន្មាន ?
ខ្ញុំពុំដឹងចំនួនប្រាកដទេ ។ គណបក្សប្រជាធិបតេយ្យសេរីនិយមគ្រប់គ្រងរដ្ឋាភិបាល ។
ខ្ញុំយល់ថាប្រទេសជប៉ុនពុំមានយោធានទេ ។
ពួកយើងមានកងកម្លាំងការពារផ្ទាល់ខ្លួន ។
ប៉ុន្តែពួកយើងពុំអាចប្រើប្រាស់ពួកគេសម្រាប់ការការពារផ្ទាល់ខ្លួនដទៃទៀតទេ ។
សេដ្ឋកិច្ចក្រោយសង្គ្រាមរបស់ប្រទេសជប៉ុនមានដំណើរការគួរឱ្យកត់សម្គាល់ ត្រូវទេ ?
ត្រូវហើយ ។ ឥលូវនេះប្រទេសជប៉ុនមានផលិតផលជាតិសរុបធំបំផុតទីពីរនៅលើពិភពលោក ។
វាគឺជាតម្លៃទំនិញ និងសេវាកម្មសរុបដែលបានផលិតដកនឹងថ្លៃដើមវត្ថុធាតុដើម ។
វាត្រូវបានប្រើប្រាស់ជាការវាស់វែងសកម្មភាពសេដ្ឋកិច្ចជាតិមួយ ។
តើកណើនសេដ្ឋកិច្ចមានអត្រាប៉ុន្មាន ?
កំណើតរបស់ពួកយើងមានការធ្លាក់ចុះនាពេលថ្មីៗនេះ ហើយអត្រានេះបច្ចុប្បន្នប្រហែលបីទៅបួនភាគរយ ។
ចាប់ពីឆ្នាំមួយពាន់ប្រាំបួនរយហាសិបប្រាំដល់ហុកសិប អត្រាកើនឡើងគឺច្រើនជាងដប់ភាគរយក្នុងមួយឆ្នាំ ។
តើអ្វីដែលនាំឱ្យមានការកើនឡើងខ្ពស់ទៅបាន ?
ខ្ញុំគិតថាមានហេតុផលជាច្រើន ។
ពួកយើងចាំបាច់ត្រូវនាំចូលវត្ថុធាតុដើម និងធនធានថាមពល ។
ប៉ុន្តែពួកយើងមានកម្លាំងពលកម្មមានគុណភាព ។
ពួកយើងនាំចូលបច្ចេកទេសថ្មី និងបរិក្ខាពីប្រទេសដទៃ ។
ជាមួយនិងផលិតផលដំណើរការនៅក្នុងប្រទេសជប៉ុន ពួកយើងបង្កើនទីផ្សារនាំចេញរបស់យើង ។
ប្រទេសជប៉ុននាំចេញច្រើនជាងនាំចូល ។
ជញ្ជីងពាណិជ្ជកម្មគឺពណ៌ខ្មៅ ត្រូវទេ ?
អតិរេកកំពុងតូចជាងមុន ។
អតិរេកកំពុងធំជាងមុនម្តងទៀត ។
តម្រូវការក្នុងស្រុករបស់ប្រទេសជប៉ុនមានការថយចុះ ។
ផលិតករព្យាយាមបង្កើនការនាំចេញ ។
អាជីវកម្មពុំមានការល្អប្រសើរជាងមុនឡើយបើទៅបីជាអត្រាការប្រាក់តូចជាងមុនក៏ដោយ ។
អត្រាការប្រាក់នឹងត្រូវបានបញ្ចុះថែមទៀត ។
ផលិតកម្មគ្រឿងយន្តគឺជាឧស្សាហកម្មចំបងរបស់ប្រទេសជប៉ុន ។
ក្រុមហ៊ុនគ្រឿងយន្តរបស់ពួកយើងកំពុងមានការប្រកួតប្រជែងនៅក្នុងទីផ្សារអន្តរជាតិ ។
តើពួកវាទាំងអស់ជារថយន្តនាំចេញឬ ?
អត់ទេ ។ ពួកវាត្រូវបាផលិតនៅក្នុងប្រទេសផ្សេងៗ ។
ពុំមានរថយន្តសហរដ្ឋអាមេរិកច្រើនទេនៅក្នុងប្រទេសជប៉ុន ។
ក្រុមហ៊ុនសហរដ្ឋអាមេរិកពុំផលិតរថយន្តរបស់ពួកគេនៅក្នុងប្រទេសជប៉ុនឡើយ ។
រថយន្តសហរដ្ឋអាមេរិកធ្លាប់ជានិមិត្តសញ្ញានៃទ្រព្យសម្បត្តិ ។
ក្រុមហ៊ុនកុំព្យូទ័រសហរដ្ឋអាមេរិកកំពុងដំណើរការយ៉ាងល្អនៅក្នុងប្រទេសជប៉ុន ។
តើមានក្រុមហ៊ុនដទៃទៀតអ្វីខ្លះដែលដំណើរការយ៉ាងល្អ ?
តើវាលំបានទេក្នុងការស្វែងរកការងារធ្វើ ?
វាមានការលំបាកជាងកាលពីឆ្នាំមុន ។
ពុំមានការងារច្រើនទេ ។
អ្នកពុំអាចផ្លាស់ប្ដូរការងាររបស់អ្នកងាយស្រួលឡើយ ។
ប្រជាជនជប៉ុនពុំផ្លាស់ប្ដូរការងាររបស់ពួកគេញឹកញាប់ឡើយ ។
ប៉ុន្តែខ្ញុំលឺថាស្ត្រីផ្លាស់ប្ដូរការងាររបស់ពួកគេជារឿយៗ ។
តើមានស្ត្រីច្រើនទេដែលក្លាយជាប្រធាន ?
ទេ តិចតួចណាស់ ។ នេះប្រហែលជាហេតុផលមួយដែលស្ត្រីពុំពុំស្ថិតនៅជាប់ក្នុងក្រុមហ៊ុនតែមួយ ។
តើទីផ្សារភាគហ៊ុនយ៉ាងម៉េចដែរសព្វថ្ងៃនេះ ?
ទីផ្សារភាគហ៊ុននៅសហរដ្ឋហាក់ដូចជាល្អ ។ ទីផ្សារនៅក្នុងប្រទេសជប៉ុននៅចំនុចអាក្រក់បំផុតរបស់ពួកគេ ។
ពីព្រោះតែដំណើរការក្នុងក្រុមហ៊ុនធំៗជាច្រើនកំពុងតែអាក្រក់ទៅ ។
តើអ្នកគិតថាពេលណាវានឹងល្អប្រសើរ ?
វានឹងចំណាយពេលបីបួនខែមុននឹងល្អប្រសើរឡើងវិញ ។
អ្នកពុំគួរលក់ភាគហ៊ុននៅពេលឥលូវនោះទេ ប្រសិនបើអ្នកមានខ្លះនោះ ។
បាទ វាជាបញ្ហានៃការបផ្លាញនូវសំណល់ ។
អ្នកមានកន្លែងពីរបីដើម្បីបោះចោលកាកសំណល់ ។
ដូច្នេះ ពួកយើងកំពុងព្យាយាមប្រើប្រាស់សំណល់មួយចំនួនឡើងវិញ ។
បរិមាណនៃកាកសំណល់ឧស្សាហកម្មត្រូវបានកាត់បន្ថយដោយប្រព្រឹត្តិកម្ម ។
ដូច្នេះ បញ្ហានៃការចម្លងរោគផ្នែកបរិស្ថានក៏មានការកាត់បន្ថយផងដែរ ។ ត្រូវទេ ?
ត្រូវហើយ ប្រព្រឹត្តិកម្មមានគោលបំណងចំពោះភាពមិនល្អផ្នែកបរិស្ថាន ។
ប៉ុន្តែថ្លៃដើមមានការកើនឡើងត ត្រូវទេ ?
តើប្រទេសជប៉ុនអាចផលិតអាហារដែលវាត្រូវការដែរឬទ ?
មិនអាចទេ ។ ត្រឹមតែពាក់កណ្តាលប៉ុណ្ណោះ ។
ប៉ុន្តែអ្នកមានភាពគ្រប់គ្រាន់ផ្ទាល់ខ្លួនសម្រាប់អាហារចំបងដូចជាអង្ករ ត្រូវទេ ?
ការប្រើប្រាស់អង្កររបស់ពួកយើងមានការថយចុះ ។
តើវាដូច្នេះឬ ? តើវាកើតឡើងដូចម្តេច ?
មនុស្សវ័យក្មេងញ៉ាំនំប៉័ងច្រើនជាងមុន ។
មនុស្សដែលញ៉ាំមីសម្រាប់អាហារថ្ងៃត្រង់ក៏មានការកើនឡើងផងដែរ ។
មីភ្លាមៗក៏លក់ដាច់យ៉ាងល្អផងដែរ ។
តម្លៃរបស់វាមានការថយចុះ ។
រឿងនេះបានជួយពួកយើង ។
យើងទិញអាហារសមុទ្រជាច្រើនផងដែរពីប្រទេសដទៃ ។
ប៉ុន្តែពួកយើងដាំបន្លែនៅទីនេះ ។
ការនាំចូលបន្លែក៏មានការកើនឡើងផងដែរ ។
ខ្ញុំបានទទួលសំបុត្រអញ្ជើញពី Haruko-san សម្រាប់ការទទួលពិធីរៀបមង្គលការរបស់នាង ។
វានៅថ្ងៃទៅដប់ប្រាំខែមិថុនា ។ ខ្ញុំត្រូវបានប្រាប់ថាវាជាថ្ងៃសំណាងមួយដែលត្រូវបានគេហៅថា taian ។
ខ្ញុំដឹងហើយ ។ នាងនឹងក្លាយជាកូនក្រមុំនៅខែមិថុនា ។
ជាធម្មតាបុរសស្លៀកពាក់ខោអាងឈុតផ្លូវការពណ៌ខ្មៅ ។ អាវធំអាហារពេលល្ងាចវានឹងល្អប្រាកដណាស់ ។
ហើយអ្នកពាក់ក្រវ៉ាត់កបូពណ៌ខ្មៅ ឬក្រវ៉ាត់កពណ៌ស ។
តើអ្នកជាធម្មតាផ្តល់អំណោយអាពាហ៍ពិពាហ៍អ្វីនៅក្នុងប្រទេសជប៉ុន ?
ពួកយើងពុំយកអំណោយអ្វីទៅក្នុងការទទួលនេះឡើយ ។ ជំនួសមកវិញ ភ្ញៀវយកប្រាក់ទៅ ។
អ្នកដាក់ប្រាក់ទៅក្នុងស្រោមសំបុត្រដែលបានតុបតែងជាពិសេសដែលត្រូវបានគេហៅថា shugibukuro ។
តើខ្ញុំគួរផ្តល់ឱ្យចំនួនប៉ុន្មាន ?
វាតែងតែជាសំណួរមួយ ។ វាជាការល្អក្នុងការសួរមិត្តភ័ក្តិមួយចំនួន ហើយយកទៅចំនួនស្រដៀងគ្នា ។
ខ្ញុំក៏ត្រូវបានស្មើឱ្យថ្លែងពាក្យសំដីមួយផងដែរ ។
វាអស្ចារ្យណាស់ ។ តើអ្នកនឹងនិយាយជាភាសាអង់គ្លេស ឬភាសាជប៉ុន ?
ខ្ញុំកំពុងគិតថានិយាយភាសាអង់គ្លេស ពីព្រោះតែមិត្តភ័ក្កិម្នាក់របស់ Haruko-san យល់ព្រមក្នុងការបកប្រែ ។
តើអ្នកស្លៀកពាក់បែបណានៅពេលដែលអ្នកចូលរួមពិធីបុណ្យសព ?
ពួកយើងស្លៀកពាក់អាវឈុតពណ៌ខ្មៅ និងក្រវ៉ាត់កពណ៌ខ្មៅ ។
មនុស្សមួយចំនួនយកធម៌ស្វាធ្យាយទៅជាមួយផងដែរ ។
តើពិធីបុណ្យសពប្រារព្វនៅក្នុងវិហារឬ ?
ត្រឹមត្រូវប្រសិនបើមនុស្សនោះជាពុទ្ធាសនិក ។ ប៉ុន្តែគ្រួសារជាច្រើនប្រារព្វពិធីបុណ្យសពនៅឯផ្ទះរបស់ពួកគេ ។
អ្នកកាន់ទុក្ខម្នាក់ៗផ្ត់នូវធូបនៅមុខសាកសព ។
ជាមួយនេះផងដែរ ក្នុងករណីពិធីបុណ្យសព វាជាទំនៀមទំលាប់សម្រាប់អ្នកកាន់ទុកក្នុងការយកមកនូវប្រាក់ក្នុងស្រោមសំបុត្រដែលត្រូវបានគេហៅថា okoden ។
វាមានន័យថាជាការជួយឧបត្ថមអ្នកដែលស្លាប់ទៅសម្រាប់ការចំណាយនៃបុណ្យសព ។
បរិមាណពាក់កណ្តាលនៃ okoden ត្រូវបានត្រឡប់មកវិញជាទម្រង់នៃទំនិញដែលជាការថ្លែងអំណរគុណ ។
ជនជាតិជប៉ុនវ័យក្មេងមានការយល់ដឹងជាមួយនិងម៉ូត ។
ពួកគេមានចំនង់ក្នុងការសិក្សាពីម៉ូតចុងក្រោយពីទូរទស្សន៍ និងទស្សនាវដ្តី ។
ប៉ុន្តែពួកគេមានអាកប្បកិរិយាផ្សេងៗគ្នា ។
តើមានភាពខុសគ្នាយ៉ាងណាទៅ ?
ជាឧទាហរណ៍ ខ្ញុំមិនដែលឃើញដៃគូក្មេងៗថើបគ្នានៅទីសាធារណៈនោះទេ ។
ខ្ញឃើញហើយ ។ អ្នកមិនទើសទាល់ចំពោះការថើបគ្នានៅតាមទីសាធារណៈនៅក្នុងសហរដ្ឋអាមេរិកនោះទេ ។ ខ្ញុំបានឃើញឈុតឆាកបែបហ្នឹងនៅក្នុងភាពយន្ត ។
វាជាការរីករាយនៅទីនោះ ។
ដោយមានលក្ខណៈផ្ទុយគ្នា ខ្ញុំជួនកាលឃើញអ្វីមួយដែលខ្ញុំមិនឃើញនៅសហរដ្ឋអាមេរិក ។
ស្ត្រីជាគូរត្រូវបានឃើញបណ្តើរគ្នានៅតាមផ្លូវដោយកាន់ដៃគ្នា ។
បាទ ពួកយើងឃើញពួកគេ ស្ត្រីក្មេងៗ ។ ពួកគេជាមិត្តភ័ក្តិល្អនឹងគ្នា ។
នៅសហរដ្ឋអាមេរិក ពួកគេអាចនឹងគិតថាគូរស្នេហាមានទំនាក់ទំនងជាមួយគ្នាជាជាងគ្រាន់តែជាមិត្តភ័ក្តិ ។
ការនិយាយដោយការប៉ះពាល់គ្នា បុរសជនជាតិអាមេរិកដាក់ដៃជុំវិញខ្នងរបស់នារីជាលក្ខណៈធម្មជាតិ ។
តើស្ត្រីទទួលរឿងហ្នឹងទេ ?
ប្រាកដណាស់ នៅពេលដែលវាមានរបៀបធម្មជាតិ ។
វាជាបញ្ហាទំនៀមទម្លាប់ ។ នៅក្នុងប្រទេសជប៉ុន ធ្លាប់មានច្បាប់សីលធម៌ដែលក្មេងប្រុសមិនត្រូវអង្គុយជាមួយក្មេងស្ត្រីបន្ទាប់ពីពួកគេមានអាយុដល់ប្រាំពីរឆ្នាំ ។
តើវាត្រូវបានអនុវត្តតាមឬទេ ?
វាប្រហែលជាមត្តេយ្យសាលាដ៏មានភាពល្បីល្បាញ ។
ហេតុអ្វីបានជាវាល្បីល្បាញ ?
វាពីព្រោះតែអ្នកបញ្ចប់ពីសាលាមត្តេយ្យចូលទៅក្នុងសាលាបឋមដ៏ល្បីល្បាញ ។
តើអ្វីជាសាលាបឋមដ៏ល្បីល្បាញ ?
បាទ វាគឺជាសាលាមត្តេយ្យដែលបញ្ជូនអ្នកបញ្ចប់ជាច្រើនទៅក្នុងសាលាអនុវិទ្យាល័យដែលល្អ ។
ខ្ញុំឃើញហើយ ។ ដូចនេះ ច្បាស់ជាមានសាកលវិទ្យាល័យដែលអ្នកទាំងអស់គ្នាចង់ចូលសិក្សា ។
តើហេតុអ្វីបានជារឿងនេះកើតឡើង ?
អ្នកបញ្ចប់ការសិក្សាពីសាកលវិទ្យាល័យដ៏ល្អអាចមានអត្ថប្រយោជន៍ពីវានៅក្នុងសហគមន៍ ។
តើការរៀបចំអ្វីដែលអ្នកធ្វើដើម្បីទទួលបានជោគជ័យនៅក្នុងការប្រលង ?
ជាធម្មតា ពួកគេចូលរៀននៅសាលារៀបចំ ឬបំប៉ន ឬមានគ្រូបង្រៀនតាមផ្ទះ ។
វាមានតម្លៃថ្លៃ តើមិនត្រូវទេឬ ?
តើអ្នកមានមធ្យោបាយអ្វីដើម្បីចូលរៀននៅសាកលវិទ្យាល័យក្រៅអំពីការប្រលងជាប់ ?
បាទ ពួកយើងមាន ។ នាពេលថ្មីៗនេះ ចំនួននៃមហាវិទ្យាល័យដែលទទួលស្គាល់ការចូលនៃសិស្សដែលណែនាំដោយសាលាប្រលងបញ្ចប់កំពុងមានការកើនឡើង ។
ខ្ញុំត្រូវបានគេប្រាប់ថាថ្លៃឈ្នួលការប្រលង និងថ្លៃឈ្នួលសិក្សាគឺមានតម្លៃថ្លៃ ។
បាទ ពួកគេមានតម្លៃថ្លៃណាស់ក្នុងករណីមហាវិទ្យាល័យឯកជន ។
តើសិស្សត្រូវមានការប្រលងប៉ុន្មាន ?
សិស្សម្នាក់ដែលខ្ញុំបានស្គាល់ផ្ញើរពាក្យច្រើនជាងដប់ ។
នៅពេលដែលខ្ញុំបានទៅ Kyoto នៅថ្ងៃបន្ទាប់ ខ្ញុំបានឃើញសិស្សជាច្រើនក្រុម ។
តើវាជាដំណើរកំសាន្តកម្មសិក្សាឬ ?
បាទ ។ ពួកគេសិក្សាមុននឹងការធ្វើដំណើរ និងសរសេររបាយការណ៍នៅពេលនោះ ។
សូម្បីតែមានសិស្សខ្លះទៅប្រទេសក្រៅសម្រាប់ដំណើរកំសាន្តកម្មសិក្សានាពេលឥលូវនេះ ។
មានភាពប្រណិត ។ ឪពុកម្តាយចំណាយសម្រាប់វាត្រូវទេ ?
បាទ ពួកគេចំណាយ ។ ប្រាក់សម្រាប់អ្វីជាច្រើន ។
ខ្ញុំចង់បានកាហ្វេ ។
ខ្ញុំត្រូវការស្រាបៀរ ។
ខ្ញុំចង់បានទឹកបរិសុទ្ធមួយដប ។
ខ្ញុំត្រូវការមួយនេះ ។
ខ្ញុំចង់ទៅកាន់សារមន្ទីរសិល្បះ ។
ខ្ញុំចង់ញ៉ាំអាហារពេលល្ងាច ។
ខ្ញុំត្រូវការកាហ្វេ ។
ខ្ញុំចង់ញ៉ាំការ៉េម ។
ខ្ញុំសូមឱ្យអ្នកមកជាមួយខ្ញុំ ។
ខ្ញុំចង់ឱ្យអ្នកថតរូវរបស់ខ្ញុំ ។
ខ្ញុំចង់ឱ្យអ្នកមើលរូបថតកូនស្រីរបស់ខ្ញុំ ។
សូមកក់តុមួយសម្រាប់មនុស្សប្រាំនាក់ ។
តើអ្នកនឹងយកកាហ្វេឱ្យខ្ញុំខ្លះទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបទៅដល់ទីនោះបានទេ ?
តើអ្នកអាចរង់ចាំមួយភ្លែតបានទេ ?
សូមអ្នកមកជាមួយខ្ញុំបានដែរឬទ ?
តើខ្ញុំអាចប្រើទូរស័ព្ទបានដែរឬទេ ?
តើគាត់ជាមនុស្សប្រភេទណា ?
តើអ្វីជាហេតុផល ?
តើនរណាដែលមានទំនួលខុសត្រូវ ?
តើអ្នកទើបហៅទូរស័ព្ទទៅកាន់នរណា ?
តើអ្នកនឹងឆ្លើយមកខ្ញុំនៅពេលណា ?
តើពួកយើងចាប់ផ្តើមឡើងជិះនៅពេលណា ?
តើខ្ញុំគួរតែមកនៅម៉ោងប៉ុន្មាន ?
តើហេតុអ្វីបានជាវាមានតម្លៃចំនួននេះ ?
ហេតុអ្វីបានជារថភ្លើងពន្យាពេល ?
តើគ្រួសារបស់អ្នកសុខសប្បាយឬទ ?
តើអ្នកបើកកាបូបនេះដោយរបៀបណា ?
តើមានមនុស្សប៉ុន្មាននាក់នៅលើដំណើរកំសាន្ត ?
តើអ្នកត្រូវការមួយណា ?
តើអ្នកមានសៀវភៅមុខម្ហូបថេរដែរឬទេ ?
តើអ្នកមានប័ណ្ណទស្សនារបស់អ្នកដែរឬទេ ?
តើពួកគេផ្តល់ប្រាក់មកវិញទេ ?
តើគាត់ដឹងថាពួកយើងនៅទីនេះឬទេ ?
តើអ្នកនិយាយប្រាកដមែនឬ ?
តើស្ត្រីម្នាក់នោះជាម្តាយរបស់អ្នកឬ ?
តើសៀវភៅរូបភាពនោះឥតគិតថ្លៃឬ ?
តើមានមួយផ្សេងមានពណ៌ដទៃឬទេ ?
តើមានបន្ទប់នៅសល់ឬទេ ?
ទេ ខ្ញុំមិនមានប្រាក់ច្រើនបែបហ្នឹងទេ ។
ខ្ញុំមិនអាចទទួលការផ្តល់ឱ្យរបស់អ្នកនោះទេ ។
ខ្ញុំនឹងមិនទៅដើរមើលទេសភាពទេថ្ងៃនេះ ។
ខ្ញុំមិនមែនជាលេខារបស់គាត់ទេ ។
ពួកយើងនឹងមិនជិះជើងហោះហើរនៅពេលព្រឹកនោះទេ ។
សេវាមិនលឿននោះទេ ។
ពុំមាននរណាម្នាក់ដឹងពីវានោះទេ ។
ពុំមាននរណាម្នាក់នៅក្នុងកន្លែងទទួលភ្ញៀវនោះទេ ។
ខ្ញុំពុំត្រូវការដំបូន្មាននោះទេ ។
ពុំមានការគិតប្រាក់ដែលចាំបាច់នោះទេ ។
ខ្ញុំពុំស្ទាក់ស្ទើរនោះទេ ។
ខ្ញុំគឺជាគ្រូបង្រៀន ។
ខ្ញុំបានមានការរំភើប ។
អ្នកមានសម្រស់ស្រស់ស្អាត ។
ម្ហូបនេះមានរសជាតិឆ្ងាញ់ ។
កូនប្រុសរបស់ខ្ញុំមានគម្រោងក្លាយជាវេជ្ជបណ្ឌិតម្នាក់ ។
បុរសនោះបានខឹងសម្បា ។
ពួកគេមានភាពចិត្តល្អចំពោះខ្ញុំ ។
ខ្ញុំត្រូវតែទៅស្ថានីយ៍នាពេលឥលូវនេះ ។
ខ្ញុំនឹងដើរទៅកាន់សណ្ឋាគាររបស់ខ្ញុំ ។
គាត់នឹងមកដល់សណ្ឋាគាររបស់គាត់ឆាប់ៗ ។
ពួកយើងកំពុងហោះហើរជាមួយក្រុមមួយ ។
ខ្ញុំមានប្រាក់ខ្លះ ។
ខ្ញុំកំពុងស្វែងរកហាងនេះ ។
ខ្ញុំបានធ្វើឱ្យបែកកែវដោយអចេតនា ។
នាងចង់ទិញសំលៀកបំពាក់មួយសម្រាប់ ។
តើអ្នកលេងកូនហ្គោលទេ ?
ខ្ញុំចង់បានទឹកត្រជាក់មួយកែវ ។
តើខ្ញុំអាចស្វែងរកឥវ៉ាន់របស់ខ្ញុំនៅឯណា ?
ខ្ញុំត្រូវការទឹកត្រជាក់មួយកែវ ។
ពួកយើងត្រូវជួបគ្នានៅព្រលានយន្តហោះនៅម៉ោងបី ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបបំពេញបែបបទនេះបានទេ ?
គេហាមឃាត់មិនអោយជក់បារីនៅទីនេះទេ មិនអញ្ចឹងទេឬ ?
តើអ្នកនឹងត្រួតពិនិត្យខាងក្នុងកាបូបនេះដែរឬ ?
តើខ្ញុំត្រូវពាក់ខ្សែក្រវ៉ាត់សុវត្ថិភាពនេះដោយរបៀបណា ?
សូមរៀបចំទម្រង់ការអន្តោប្រវេសន៍ ។
តើភាពយន្តនេះនឹងចាក់បញ្ចាំងនៅពេលណា ?
ឥវ៉ាន់របស់ខ្ញុំត្រូវបានត្រួតពិនិត្យរួចហើយ ។
សូមសរសេរអាស័យដ្ឋានអចិន្ត្រៃយ៍របស់អ្នក ។
តើឥវ៉ាន់ដែលអាចយកតាមបានមានកំណត់ដែរឬទេ ?
សូមពន្យល់វាឱ្យបានច្បាស់ជាងហ្នឹង ។
ខ្ញុំបានទិញសំបុត្រថោកដើម្បីកាត់បន្ថយការចំណាយ ។
ពេលវេលាឡើងយន្តហោះកំពុងមានសំពាធលើខ្ញុំ ។
សូមឱ្យប្រាកដថាអ្នកមិនបានភ្លេចរបស់អ្វីមួយទេ ។
សូមកែតម្រូវចំនុចនេះ ។
នេះបានលើសទំងន់ដែលបានកំណត់ហើយ ។
យើងទើបតែបានឆ្លងកាត់ប្រទេសសិង្ហបុរីរួច ។
នាំគ្នាទូរស័ព្ទទៅសណ្ឋាគារភ្លាមនៅពេលដែលយើងទៅដល់ទីក្រុងឡុង ។
សូមប្រញ៉ាប់ទៅព្រលានយន្តហោះភ្លាម ។
ចុងក្រោយ យន្តហោះបានហោះឡើងហើយ ។
តើយន្តហោះនឹងហោះឆ្លងកាត់ភ្នំអាល់ឬទេ ?
សូមយកឥវ៉ាន់នេះទៅឡានតាក់ស៊ី ។
តើពេលវេលាយន្តហោះចេញដំនើរនឹងផ្លាស់ប្ដូរច្រើនទេ ?
ខ្ញុំមកទាន់ពេលត្រួតពិនិត្យចូល ។
