វារលុងនៅទីនេះ ។
តើអ្នកមានទំហំលេខប្រាំមួយកន្លះដែរអត់ ?
តើទំហំនេះគិតជាប៉ុន្មានសង់ទីម៉ែត ?
កែងនេះដួចជាទាបពេកហើយសំរាប់ខ្ញុំ ។
កែងនេះដូចជាខ្ពស់ពេកហើយសំរាប់ខ្ញុំ ។
សូមបង្ហាញរបស់នេះមួយដែលនៅខាងឆ្វេងដៃរាប់ពីទីបួនវិញ ។
តើនេះធ្វើពីមាសសុទ្ធមែនទេ ?
តើអ្នកជួយបង្ហាញចិញ្ចៀនខ្លះអោយខ្ញុំផងបានទេ ?
សូមបង្ហាញរបស់នេះមួយដែលនៅខាងស្តាំដៃរាប់ពីទីបួនវិញ ។
របស់មួយដែលនៅខាងស្តាំដៃចុងក្រោយនេះ ។
ខ្ញុំចង់បានពេជ្រមួយគ្រាប់ ។
តើវាជានាឡិកាដើរដោយខ្យល់មែនទេ ?
តើអ្នកជួយវាស់ទំហំចិញ្ចៀនម្រាម ដៃរបស់ខ្ញុំផងបានដែរទេ ?
តើមានការធានាដែរអត់ ?
តើនេះជាទ្រនិចនាឡិកាមែនទេ ?
តើថ្មសាកមានរយៈរហូតដល់ពេលណាដែរ ?
តើធ្វើម៉េចទើបវាត្រឹមត្រូវ ?
តើវាធន់ទ្រាន់នឹងទឹកដែរអត់ ?
តើវាផលិតចេញពីក្រុមអ្វី ?
តើអ្នកមានពណ៌ដែលភ្លឺជាងនេះដែរអត់ ?
តើខ្ញុំសុំមើលក្រែមលាបមាត់ខ្លះផងបានអត់ ?
តើអ្នកមានម៉ាក ឌីអរ ដែរទេ ?
ខ្ញុំត្រូវការថ្នាំលាបក្រចកម៉ាក ប៉ូលីស ឆានែល ។
តើអ្នកមានពណ៌ដែលដិតជាងនេះដែរទេ ?
តើខ្ញុំអាចទិញច្រាសដុសធ្មេញនៅកន្លែងណាបាន ?
តើទាំងអស់មានតំលៃប៉ុន្មានដែរ ?
សូមជួយខ្ចប់វាជាកាដូផង ។
តើអ្នកចង់ខ្ចប់វាដោយឡែកមែនទេ ?
តើគិតរួមទាំងពន្ធដែរទេ ?
តើអ្នកទទួលក្រេឌីតកាតនេះដែរអត់ ?
តើអាចផ្ញើវាទៅសណ្ឋាគាររបស់ខ្ញុំបានដែរទេ ?
វាមានតំលៃថ្លៃបន្តិចហើយ ។
ថវិការបស់ខ្ញុំមានហាសិបដុល្លារ ។
ខ្ញុំនឹងទិញវា ប្រសិនបើវាមានតំលៃសាមសិបប្រាំដុល្លារ ។
ប្រសិនបើវាមានតំលៃថោកជាងនេះបន្តិច ។ ខ្ញុំសុំទោសផង ។
តើខ្ញុំអាចសុំបែបបទប្រាក់សំណងពន្ធ បានដែរទេ ?
តើអ្នកអាចប្ដូរអាមួយនេះទៅជាអាមួយផ្សេងទៀតបានដែរអត់ ?
របស់នេះមិនដំណើរការអ្វីទាំងអស់ ។
នៅកន្លែងនេះមានប្រហោង ។
តើអ្នកអាចប្ដូររបស់នេះទៅជារបស់ថ្មីមួយបានដែរទេ ?
ខ្ញុំអាចមានប្រាក់សំនងដែរទេ ?
តើនៅម្តុំនេះមានការិយាល័យផ្តល់ព័ត៌មានអ្នកទេសចរណ៍ដែរទេ ?
តើអ្នកមានខិតប័ណ្ណទស្សនកិច្ចសំរាប់ទីក្រុងនេះដែរទេ ?
សូមអ្នកជួយណែនាំកន្លែងណាមួយសំរាប់ដើរទិញទំនិញបាន ?
សូមអ្នកជួយណែនាំទីកន្លែងដែលគួរអោយចាប់អារម្មណ៍ខ្លះៗ សំរាប់ការទស្សនានៅក្នុងទីក្រុងនេះបានដែរទេ ?
នៅថ្ងៃស្អែកបើកដែរទេ ?
ក្នុងសប្ដាហ៍នេះ តើនៅក្នុងក្រុងនេះ មានព្រឹត្តិការណ៍គួរអោយចាប់អារម្មណ៍ រឺមួយក៏ ពិធីបុណ្យអ្វីដែរអត់ ?
តើធ្វើម៉េចទើបខ្ញុំអាចទៅហូលីវ៉ូដបាន ?
តើធ្វើយ៉ាងណាទើបខ្ញុំអាចទៅសារមន្ទីរសិល្បៈនេះបាន ?
តើវាបើកអត់ថ្ងៃនេះ ?
តើថ្ងៃនេះ អ្នកមានព្រឹត្តិការណ៍អ្វីគួរអោយចាប់អារម្មណ៍ រឺពិធីបុណ្យអ្វីដែររឺទេ ?
តើខ្ញុំអាចមើលព្រឹត្តិការណ៍នៅឯណា ?
តើអ្នកអាចណែនាំដំណើរកំសាន្តដែលពេញនិយមមកអោយខ្ញុំខ្លះផងបានទេ ?
តើខ្ញុំអាចធ្វើដំណើរកំសាន្តឥលូវបានដែរទេ ?
តើដំណើរកំសាន្តនេះឆ្ពោះទៅកាន់សួនសត្វប្រ៊ុន មែនទេ ?
នៅក្នុងដំណើរកំសាន្ត មានបូកបញ្ចូលអាហារដែរទេ ?
តើវាចាប់ផ្តើមនៅកន្លែងណា ពេលណាដែរ ?
តើខ្ញុំអាចកក់ទុកមួយនៅទីនេះបានទេ ?
ខ្ញុំនឹងធ្វើដំណើរកំសាន្ត ។
ខ្ញុំត្រូវការធកក់ទុកមួយ សំរាប់ដំណើរកំសាន្តនៅថ្ងៃស្អែក ។
តើភ្នំនោះមានឈ្មោះអ្វី ?
តើពួកយើងចេញពីទីនេះនៅម៉ោងប៉ុន្មាន ?
តើប្រាសាទនោះមានឈ្មោះអ្វី ?
តើប្រាសាទនោះមានរឿងអ្វីនៅពីក្រោយវា ?
តើវាល្បីល្បាញលើអ្វី ?
តើវានឹងបិទនៅម៉ោងប៉ុន្មាន ?
តើការងារអ្វីដែលល្បីល្បាញជាងគេបង្អស់នៅសារមន្ទីរនេះ ?
តើនាងជាមនុស្សប្រភេទណា ?
មនុស្សជំទង់ពីរនាក់ ។
តើការងារអ្វីដែលល្បីល្បាញជាងគេបង្អស់នៅសារមន្ទីរសិល្បៈនេះ ?
តើអ្នកណាជាអ្នកធ្វើការ ?
តើអ្នកមានកន្លែងផឹកស្រាស្តាប់ភ្លេងដែរទេ ?
តើខ្ញុំអាចជក់បារីបាននៅឯណា ?
គ្រាន់តែចុចប៊ូតុងនេះ ។
ចាំខ្ញុំផ្ញើរូបភាពអោយអ្នក ។
តើអ្នកជួយថតរូបអោយពួកខ្ញុំផងបានទេ ?
តើខ្ញុំអាចប្ដូរហ្វីលបាននៅកន្លែងណា ?
សូមទំហំស្តង់ដារ ។
សូមមេត្តាកូពីរូបថតនេះផង ។
តើរបស់បោះពុម្ភរបស់ខ្ញុំរួចរាល់ហើយនៅ ?
តើអ្នកមានថ្មសាក ដូចអាមួយនេះដែរទេ ?
ខ្ញុំមិនចង់ឆ្លុះមើលកាំរស្មីអ៊ិច ។
តើអ្នកមានទស្សនាវដ្តីកំសាន្តដែរទេ ?
តើនៅជិតនេះមានភ្នាក់ងារលក់សំបុត្រដែរទេ ?
ខ្ញុំចង់មើលការប្រគំភ្លេង ។
ខ្ញុំចង់មើលការសំដែងចុងក្រោយបង្អស់ ។
តើមានកន្លែងណាដែលខ្ញុំអាចស្តាប់តន្ត្រីបុរាណបាន ?
តើនៅរោងមហោស្រពជាតិមានអ្វីទៅ ?
តើរោងភាពយន្ត ប៊ក់អូហ្វីស មាននៅឯណា ?
ខ្ញុំសុំទិញសំបុត្ររឿង «ឡែស មីសសឺរ៉េប៊ល់»ចំនួនពីរសន្លឹក សំរាប់ថ្ងៃទីប្រាំពីរខែមិថុនា ?
ការសំដែងពេលរសៀល រឺពេលល្ងាច ?
បាទ ពេលល្ងាច ។
ខ្ញុំសុំទោសផង ការសំដែងនោះលក់អស់បាត់អស់ហើយ ។
តើអ្នកមានសំបុត្រនៅបន្ទប់ឈរមើលដែរទេ ?
ខ្ញុំត្រូវការកៅអីអង្គុយសំរាប់ថ្ងៃនេះ ។
តើអ្នកអាចបង្ហាញខ្ញុំ ពីកៅអីនេះបានទេ ?
តើអ្នកមានកម្មវិធីដែរទេ ?
តើខ្សែភាពយន្តអ្វីដែលល្បីជាងគេបង្អស់ ហើយចេញក្រោយគេ ?
តើរឿង «ខឺសស៊ី ឡូវ» ចាក់បញ្ចាំងនៅម៉ោងណាដែរ ?
ទិញសំបុត្ររឿង «ខឺសស៊ី ឡូវ» មួយសន្លឹក ។
សូមជួយណែនាំក្លិបរាត្រីល្អមួយអោយខ្ញុំផងបានទេ ?
តើការចាក់បញ្ចាំងប្រភេទអ្វីដែលពួកយើងអាចមើលបាន ?
តើខ្ញុំចាំបាច់ត្រូវស្លៀកពាក់ជាផ្លូវការដែរទេ ?
សាយ័ន្តសួស្តី ។ តើអ្នកមានបានកក់ទុករួចហើយនៅ ?
តើខ្ញុំអាចប្ដូរកន្លែងអង្គុយរបស់ខ្ញុំទៅទល់មុខនេះបានដែរទេ ?
តើក្នុងទីក្រុងនេះ ឌីស្កូដែលធំជាងគេ នៅកន្លែងណា ?
តើនៅទីនោះមានយុវជនដែរទេ ?
ជួយណែនាំកាស៊ីណូខ្លះអោយផង ?
តើហ្គេមប្រភេទណាដែលពួកយើងអាចលេងនៅទីនេះបាន ?
តើតុរ៉ូឡេតនៅកន្លែងណា ?
សូមអ្នកជួយបង្ហាញពីវិធីលេងហ្គេមនេះផង ?
ម្ភៃដុល្លារ សុំកាក់ទាំងអស់ ។
ខ្ញុំចាក់ភ្នាល់ប្រាំដុល្លារ ។
តើខ្ញុំអាចមើលការប្រកួតប្រកួតកីឡាបែសប៊ល់ជំនាញបានទេ ក្នុងថ្ងៃនេះ ?
តើអ្នកអាចយកសំបុត្រមួយសំរាប់ខ្ញុំបានទេ ?
ខ្ញុំត្រូវការកន្លែងឈរទស្សនានៅទីលាន ។
តើខ្ញុំត្រូវទៅយកសំបុត្រនៅកន្លែងណា ?
តើធ្វើម៉េចទើបខ្ញុំអាចទៅដល់ទីលានប្រកួតបាល់បាន ?
ការកក់ទុកលេខ សូន្យ សូន្យ មួយ ។
ហើយតើច្រកមួយណាដែលខ្ញុំគួរចូលទៅ ?
តើការប្រកួតយ៉ាងម៉េចទៅហើយ ?
ពួកយើងចង់វាយ ។
ព្រះជាម្ចាស់អើយ ។
តើខ្ញុំអាចលេងធិននីសនៅឯណាបាន ?
តើកីឡាប្រភេទណាទើបខ្ញុំអាចលេងបាននៅជិតនេះ ?
តើខ្ញុំអាចកក់ទីលានធិននីសមួយកន្លែងបានទេ ?
ខ្ញុំត្រូវការលេងនៅថ្ងៃស្អែកនៅម៉ោងដប់ព្រឹក ប្រហែលមួយម៉ោង ។
តើពួកយើងអាចជួលរ៉ាកែតវាយបានទេ ?
តើទាំងអស់ថ្លៃប៉ុន្មានដែរ ?
តើយើងអាចដើរទៅទីលានបានទេ ?
តើខ្ញុំអាចធ្វើការកក់ទុកទីនេះសំរាប់លេងកូនហ្គោល ?
តើទីវាលបៃតងនោះ មានតំលៃប៉ុន្មាន ?
តើមួយថ្ងៃតំលៃប៉ុន្មាន ?
តើមានជំរាលសំរាប់អ្នកចាប់ផ្តើមដំបូងដែរអត់ ?
តើវគ្គចាប់ផ្តើមដំបូងមួយណា ?
តើអ្នកមានផែនទីនៃជំរាលទាំងនេះដែរទេ ?
តើសំបុត្រមួយថ្ងៃ មានតំលៃប៉ុន្មានដែរ ?
សូមមេត្តាទូរស័ព្ទទៅប៉ូលីសជួយសង្គ្រោះផង ។
ខ្ញុំអាចជួលកង់មួយបានដែរទេ ?
តើអ្នកមានផែនទីសំរាប់ការជិះកង់ដែរទេ ?
ខ្ញុំចង់សាកចុះមុជទឹកក្រោមបាតសមុទ្រ ។
តើនៅម្តុំនេះ មានអាងហែលទឹកដែរទេ ?
តើមានកន្លែងណាដែលខ្ញុំអាចទិញឈុតហែលទឹកបានទេ ?
តើបន្ទប់មុជទឹកផ្កាឈូកនៅឯណាមាន ?
ខ្ញុំនឹងទៅមុជទឹកនៅក្រោមបាតសមុទ្រ ។
តើមានកន្លែងមុជទឹកក្រោមបាតសមុទ្រដែរទេ ?
ខ្ញុំមិនបានបញ្ជាក់ទេ ។
តើធ្វើម៉េចទើបខ្ញុំអាចទទួលអាជ្ញាប័ណ្ណមុជទឹកក្រោមបាតសមុទ្របាន ?
តើមានសាលាណាដែលបង្រៀនជ្រមុជទឹកក្រោមបាតសមុទ្រដែរទេ ?
តើអាជ្ញាប័ណ្ណប្រភេទអ្វីដែលខ្ញុំអាចទទួលបាន ?
តើជិះតាក់ស៊ីទៅកាន់ ស្ថាប័នស្មីតសុនៀន មានតំលៃប៉ុន្មាន ?
តើអ្នកជួយបើកម៉ាស៊ីនត្រជាក់បានទេ ?
តើអ្នកអាចទូរស័ព្ទទៅប៉ូលីសអោយខ្ញុំផងបានដែរទេ ?
ទៅ លីនកូល ម៉េមម៉ូរៀល ។
តើអ្នកអាចបើកហិបបានទេ ?
តើអ្នកអាចបើកម៉ាស៊ីនកំដៅបានទេ ?
សុំសំបុត្រទៅទីក្រុងដេនវឺរ ១ជើង លំដាប់ទីពីរ ។
សុំសំបុត្រពីរសន្លឹកទៅទីក្រុងស៊ីកាហ្គូ ទៅមក រថយន្តក្លិប ។
ខ្ញុំមានសំបុត្រឆ្លងផ្លូវដែក ។
ខ្ញុំនឹងចាប់ផ្តើមប្រើសំបុត្រឆ្លងផ្លូវដែកសហរដ្ឋអាមេរិករបស់ខ្ញុំនៅថ្ងៃនេះ ។
តើបន្ទប់វេចខ្ចប់នៅឯណា ?
តើខ្ញុំអាចមើលកាលវិភាគនៅកន្លែងណាបាន ?
តើរថភ្លើងបន្ទាប់ទៅទីក្រុងស៊ីកាហ្គូចេញនៅម៉ោងប៉ុន្មាន ?
តើនេះជារថភ្លើងដែលត្រូវទៅទីក្រុងដេនវឺរផ្ទាល់មែនទេ ?
តើរថភ្លើងទៅដល់ទីក្រុងដេនវឺរនៅម៉ោងប៉ុន្មាន ?
តើម៉ោងប៉ុន្មានទើបរថភ្លើជើងដំបូងបន្ទាប់ទៅកាន់ទីក្រុងស៊ីកាហ្គូចេញដំណើរ ?
តើម៉ោងប៉ុន្មានទើបរថភ្លើថជើងចុងក្រោយបន្ទាប់ទៅកាន់ទីក្រុងស៊ីកាហ្គូចេញដំណើរ ?
តើរថភ្លើងនេះទៅទីក្រុងសៀថថល់មែនទេ ?
តើផ្លូវដែកមួយណាដែលទៅទីក្រុងសៀថថល់ ?
តើរថភ្លើងឈប់នៅទីក្រុងម៉ានស៍ហ្វៀលមែនទេ ?
តើបន្ទប់គេងរបស់ខ្ញុំនៅឯណា ?
តើរថយន្តនេះទៅទីក្រុងស៊ីកាហ្គូមែនទេ ?
តើកន្លែងអង្គុយនេះមានគេកក់នៅ ?
សុំសំបុត្រមួយទៅទីក្រុងដេទ្រតមួយសន្លឹក ។
តើរថយន្តក្រុងទៅទីក្រុងដេទ្រតចេញពីណាមក ?
តើរថយន្តក្រុងទៅទីក្រុងដេទ្រតចេញដំណើរនៅម៉ោងប៉ុន្មាន ?
តើត្រូវចំណាយពេលប៉ុន្មានដើម្បីទៅដល់ទីក្រុងដេទ្រត ?
សុំសំបុត្រពីរសន្លឹកទីក្រុងដេទ្រត ។
តើរថយន្តក្រុងទៅទីក្រុងដេទ្រតចេញតាមច្រកមួយណា ?
តើម៉ោងប៉ុន្មានទើបរថយន្តក្រុងចេញដំណើរ ?
តើត្រូវចំណាយរយៈពេលប៉ុន្មានទើបទៅដល់ចំណតបន្ទាប់ ?
ខ្ញុំចង់ចុះនៅទីនេះ ។
តើរថយន្តក្រុងមួយណាទៅទីក្រុង ?
តើនេះទៅមជ្ឈមណ្ឌលស៊ីវ៉ីកមែនដែរទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេ ថាតើពេលណាទើបយើងឡើងទៅមជ្ឈមណ្ឌលស៊ីវ៉ីក ?
តើខ្ញុំអាចទិញសញ្ញាសំងាត់រថភ្លើងក្រោមដីនៅឯណា ?
តើកន្លែងណាដែលខ្ញុំអាចទិញសំបុត្រផ្លូវក្រោមដីបាន ?
តើខ្ញុំគួរតែឡើងជិះរថភ្លើងនៅស្ថានីយ៍មួយណា ដើម្បីទៅកាន់អគាររដ្ឋកប់ពពក ?
តើនេះជារថភ្លើងដែលត្រូវទៅកាន់ហ្រ្គែនស៊ិនទ្រាល់មែនទេ ?
តើមានចំណតប៉ុន្មាននៅតាមផ្លូវទៅវិថី វ៉ល ?
តើរថភ្លើងឈប់ចតនៅវិថី វ៉ល មែនទេ ?
តើវាមានតំលៃប៉ុន្មានសំរាប់មួយសប្ដាហ៍ ?
ខ្ញុំត្រូវការឡានអូតូ ។
តើខ្ញុំអាចទម្លាក់វានៅទីក្រុងសាន់ហ្រ្វាន់ស៊ីស្កូបានអត់ ?
តើអ្នកមានប្រភេទដូចគ្នា តែមានពណ៌ផ្សេងគ្នាដែរទេ ?
តើវាមានតំលៃប៉ុន្មានសំរាប់រយៈពេលពីរថ្ងៃ ?
វាមានទាំងហ្កាសដែរអត់ ?
តើម៉ោងប៉ុន្មានខ្ញុំគួរតែបញ្ជូនឡានអោយវិញ ?
តើអ្នកជួយប្រាប់ខ្ញុំពីវិធីបើកធុងហ្កាសបានទេ ?
ខ្ញុំចង់ចំណាយប្រាក់តាមរយៈកាតក្រេឌីតសំរាប់លេខពីរ ។
ខ្ញុំចង់ចំណាយប្រាក់សុទ្ធសំរាប់លេខពីរ ។
ដប់ដុល្លារសំរាប់លេខពីរ ។
តើអ្នកជួយប្រាប់ខ្ញុំពីវិធីប្រើប្រដាប់ចាក់សាំងបានដែរទេ ?
សូមឧស្ម័នមួយដែលមានតំលៃដប់ដុល្លារ ។
សូមជួយត្រួតពិនិត្យកង់ផងបានទេ ?
តើខ្ញុំអាចយកផែនទីផ្លូវបាននៅឯណា ?
ពីទីនេះទៅរដ្ឋធានី អ៊ីនដាយអាណាប៉ូលីស តើមានប្រវែងប៉ុន្មាន ម៉ៃ ?
តើខ្ញុំកំពុងតែទៅកាន់ទីក្រុងស៊ីកាហ្កូតាមផ្លូវត្រូវដែរអត់ ?
សូមអ្នកជួយប្រាប់ខ្ញុំថាតើឥលូវខ្ញុំកំពុងនៅឯណាក្នុងផែនទីនេះ ?
ខ្ញុំបាត់កាបូប ។
តើធ្វើម៉េចទើបខ្ញុំអាចទៅសណ្ឋាគារអាប៊េសេ ?
ម៉ែតនិយាយថាអស់ដប់ដុល្លារ ។
ខ្ញុំនឹងសួរអ្នកយាមទ្វារពីតំលៃត្រឹមត្រូវ ។
ខ្ញុំនឹងរាយការណ៍ទៅប៉ូលីស ។
ខ្ញុំខកជើងរថភ្លើង ។
ខ្ញុំខកជើងរថយន្តក្រុង ។
ខ្ញុំភ្លេចកាបូបនៅលើរថយន្តក្រុង ។
តើអ្នកអាចផ្តល់សំណងអោយខ្ញុំវិញលើសំបុត្រមួយនេះបានដែរទេ ?
រថយន្តរបស់ខ្ញុំធូរកង់ស្ពែត ។
ខ្ញុំអស់ហ្គាស ។
ហ្រ្វាំងមិនដំណើរការបានល្អសោះ ។
ខ្ញុំមិនបានកោសវាទេ ។
សូមមេត្តាទូរស័ព្ទទៅឡានពេទ្យសង្គ្រោះបន្ទាន់ផង ។
តើនៅម្តុំនេះមានកន្លែងទូរស័ព្ទបង់ប្រាក់ដែរទេ ?
ឡានត្រូវបានខូចខ្ទេចខ្ទីអស់ហើយ ។
ខ្ញុំគិតថាមកពីវាក្តៅខ្លាំងពេក ។
តើនៅម្តុំនេះមានហាងជួសជុលរថយន្តអូតូដែរទេ ?
ខ្ញុំមិនបានធ្វើវាអោយកំប៉ិតកំពៀចទេ ។
ខ្ញុំជួបនឹងគ្រោះថ្នាក់ចរាចរណ៍ ។
ខ្ញុំបានបុករថយន្តរបស់អ្នកដទៃ ។
មានមនុស្សម្នាក់រងរបួស ។
ខ្ញុំគិតថាគ្មានមនុស្សរបួសទេ ។
នៅវិថីលេខ កៅសិបប្រាំ ។ ខ្ញុំកំពុងនៅតាមផ្លូវទៅសមុទ្រម៉ៃយ៉ាមី ។
សូមអ្នកជួយហៅទូរស័ព្ទអោយខ្ញុំផង ?
នេះជាលេខទូរស័ព្ទ ។
សូមជួយប្រាប់ខ្ញុំពីរបៀបហៅទូរស័ព្ទចេញផង ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេ ថាតើលេខទូរស័ព្ទនៅសណ្ឋាគារ ស៊ាំងហ្រ្គីឡាប៉ុន្មានដែរ ?
អាឡូ ។ តើនេះជាផ្ទះរបស់វ៉ែធស៍ មែនទេ ?
តើខ្ញុំអាចនិយាយជាមួយ ម៉ារីបានដែរទេ ?
តើខ្ញុំអាចផ្តែផ្តាំទៅនាងបានដែរទេ ?
ជួយប្រាប់នាងផងថា តានីហ្គឹឈី ទូរស័ព្ទមក ?
ខ្ញុំ ម៉ាឈីកុ តានីហ្គឹឈី មកពីប្រទេសជប៉ុន ។
ខ្ញុំកំពុងស្នាក់នៅសណ្ឋាគារ ហ៊ីលតុន បន្ទប់លេខ ពីររយម្ភៃ ។
ខ្ញុំនឹងទូរស័ព្ទទៅនាងលើកក្រោយទៀត ។
អាឡូ ។ តើនេះជាសណ្ឋាគារ ស៊ាំងហ្រ្គីឡា មែនទេ ?
តើខ្ញុំអាចនិយាយជាមួយ លោក ចូនស៍ នៅបន្ទប់លេខ ប្រាំរយម្ភៃមួយ បានដែរអត់ ?
សូមមេត្តាភ្ជាប់ទីកាន់លេខ មួយ សូន្យ ពីរ ។
តើនៅទីនេះមានអ្នកណាអាចនិយាយភាសាជប៉ុនបានដែរទេ ?
ខ្ញុំសុំទោស ។ ខ្ញុំទូរស័ព្ទច្រឡំលេខ ។
សូមទូរស័ព្ទទៅតំបន់ឆ្ងាយ ។
លេខទូរស័ព្ទគឺមានលេខ មួយ ពីរ បី បួន ប្រាំ ប្រាំមួយ ប្រាំពីរ ប្រាំបី ប្រាំបួន សូន្យ មួយ ពីរ ។
សូមបញ្ចូលពីរដុល្លារ ។ អ្នកអាចនិយាយបានបីនាទី ។
សូមបញ្ចូលពីរដុល្លារ ។ អ្នកអាចនិយាយបានមួយនាទី ។
ខ្ញុំចង់ហៅទូរស័ព្ទអន្តរជាតិទៅកាន់ប្រទេសជប៉ុន ។
សូមប្រតិបត្តិករប្រទេសជប៉ុន ។
សូមហៅស្ថានីយ៍ទៅកាន់ប្រទេសជប៉ុន ។
សុំលេខទូរស័ព្ទ និងឈ្មោះកម្មវិធីជប់លៀង ។
សូមកុំដាក់ទូរសព្ទចុះ ។
សូមមេត្តាព្យាយាមម្តងទៀត ។
សូមតែមតំលៃសែសិបសេន ចំនួនប្រាំ ។
តើអ្នកមានតែមរំលឹកខួបដែរទេ ?
ចំណាយប្រាក់លើការដឹកជញ្ជូន ។
តើខ្ញុំត្រូវបំពេញសំណុំបែបបទសេចក្តីប្រកាសពន្ធមែនទេ ?
សូមអ្នកជួយហៅគ្រូពេទ្យអោយមកបន្ទប់របស់ខ្ញុំផង ?
តើនៅទីនេះមានថ្នាំផ្តាសាយដែលអត់ ?
តើអ្នកស្គាល់គ្រូពេទ្យជំនាញផ្នែករោគស្ត្រីដែរទេ ?
តើនៅជិតនេះមានមន្ទីរពេទ្យដែរទេ ?
សូមជួយនាំខ្ញុំទៅមន្ទីរពេទ្យផង ?
សូមអ្នកជួយហៅឡានពេទ្យសង្គ្រោះបន្ទាន់អោយខ្ញុំផង ?
ខ្ញុំមានអារម្មណ៍ថាចុករោយ ។
ខ្ញុំគ្រិចកជើងខាងស្តាំ ។
ខ្ញុំប៉ះត្រូវក្បាល ។
សូមជួយហៅតាក់ស៊ីអោយខ្ញុំមួយផង ?
ប្រភេទឈាមរបស់ខ្ញុំគឺ ប៊ី ។
ប្រភេទឈាមរបស់ខ្ញុំគឺ អេប៊ី ។
តើខ្ញុំចាំបាច់ត្រូវសំរាកលើគ្រែមែនទេ ?
តើខ្ញុំត្រូវសំរាកលើគ្រែរយៈពេលប៉ុន្មានណាដែរ ?
ខ្ញុំមានទំងន់ ។
តើខ្ញុំអាចបន្តដំណើរកំសាន្តចាប់ពីថ្ងៃស្អែកបានដែរទេ ?
តើអ្នកធ្លាប់មានវាពីមុនមកដែរទេ ?
តើខ្ញុំត្រូវចំនាយពេលស្នាក់នៅមន្ទីរពេទ្យរយៈពេលប៉ុណ្ណាដែរ ?
ខ្ញុំមានរយៈពេលរបស់ខ្ញុំ ។
ខ្ញុំនឹងចាក់ថ្នាំអោយអ្នក ។
ខ្ញុំសុំវេជ្ជបញ្ជាផង ?
តើអ្នកបំពេញតាមវេជ្ជបញ្ជានេះមែនទេ ?
កាបូបលុយរបស់ខ្ញុំត្រូវបានគេលួចហើយ ។
តើអ្នកមានប្រទះឃើញវ៉ាល្លីពណ៌ក្រហមមួយដែរទេ ?
វាប្រហែលជាត្រូវបានគេលួច ។
សូមទុកលេខកាតរបស់ខ្ញុំជាមោឃៈ ។
តើអ្នកត្រូវការបំពេញបែបបទពាក្យបណ្តឹងដែរអត់ ?
សុំជំនួយខ្លះមក ។
ខ្ញុំមានតែប៉ុណ្ណឹងទេ ។
អោយកាបូបអ្នកមកខ្ញុំ ។
តើអ្នកចង់ពិសារភេសជ្ជៈអ្វីដែរ ?
តើជាលុយយ៉េនជប៉ុនបានដែរទេ ?
ខ្ញុំត្រូវការគេង ។
តើអ្នកធ្វើដំណើរតែម្នាក់ឯងមែនទេ ?
បើខ្ញុំមិនយកកាបូបទៅតាម តើមិនអីមែនទេ ?
តើពេលណាទើបយើងទៅដល់សាន់ហ្រ្វាន់ស៊ីស្កូ ?
តើអ្វីជាគោលបំណងក្នុងការធ្វើដំណើរកំសាន្តរបស់អ្នក ?
នៅឯសណ្ឋាគារផាក ។
បួនរយដុល្លារគិតាលុយសុទ្ធ ហើយ ពីរពាន់ដុល្លារជាសែកត្រាវិលឡឺ ។
តើខ្ញុំអាចសុំមើលសំណុំបែបបទសេចក្តីប្រកាសពន្ធរបស់អ្នកបានដែរទេ ?
បាទ មួយនេះហើយ ។
ស្រាជប៉ុនសាកិ បីដប ។
តើជើងហោះហើររបស់អ្នកលេខប៉ុន្មានដែរ ?
សូន្យ សូន្យ បី ហ្សេអាអ៊ិល ។
វាគឺជាវ៉ាល្លីពណ៌ត្នោតទំហំមធ្យមមួយ ។
សូមប្ដូរពីលុយយ៉េនទៅជាលុយដុល្លារ ។
សូមជួយប្រាប់ខ្ញុំពីអត្រាប្ដូរប្រាក់នៅថ្ងៃនេះផង ?
សុំវិក័យបត្រដប់ដុល្លារចំនួនបួន ហើយប្ដូរទៅជាលុយរាយ ។
ខ្ញុំចង់ប្ដូរទៅជាលុយរាយ ។
តើមានបន្ទប់ណាទំនេរសំរាប់យប់នេះដែរទេ ?
សូមជួយណែនាំសណ្ឋាគារដទៃទៀតអោយខ្ញុំផង ?
ចុះសណ្ឋាគារធឺមីណល់ ដែលនៅម្តុំកាច់ជ្រុងនោះម៉េចដែរ ?
សូមយកបន្ទប់គ្រែមួយ ។
សុំបន្ទប់គ្រែពីរមានបន្ទប់ទឹក ។
ខ្ញុំឈ្មោះលោក ថេរ៉ាសាវ៉ា ។
ខ្ញុំនឹងទៅដល់ទីនោះភ្លាមៗ ។
ខ្ញុំនឹងទៅដល់សណ្ឋាគាររបស់អ្នកនៅប្រហែលម៉ោងប្រាំបួនល្ងាចនេះ ។
ខ្ញុំបានកក់ទុកមួយកន្លែងនៅទីក្រុងតូក្យូកាលពីសប្ដាហ៍មុន ។
ខ្ញុំអាចកាន់វ៉ាល្លីរបស់ខ្ញុំបាន ។
សូមអញ្ជើញមកតាមផ្លូវនេះ ។ មានអីទៀតទេ ?
អត់ទេ អរគុណច្រើន ។ នេះជាលុយធីបរបស់អ្នក ។
បន្ទប់នេះគឺលេខ ប្រាំពីរ សូន្យ ប្រាំពីរ ។
សុំទឹកតែពីរកែវ ។
សូមជួយយកឈុតអាហារពេលព្រឹកចំនួនពីរ មកអោយខ្ញុំនៅម៉ោងប្រាំបី ?
សូមជួយទូរស័ព្ទដាស់ខ្ញុំនៅម៉ោងប្រាំពីរព្រឹកស្អែកផង ។
តើអ្នកធ្វើវានៅយប់នេះមែនទេ ?
ខ្ញុំបើកទ្វារមិនរួចទេ ។
ខ្ញុំមិនដឹងពីរបៀបប្រើទេ ។
ខ្ញុំចង់ផ្ញើរហ្វាក់ ។
តើអ្នកនឹងផ្ញើរសារទៅមែនទេ ?
តើអ្នកមានបានប្រើប្រាស់ទូទឹកកកដែរទេ ?
បាទ ខ្ញុំបានយកទឹកក្រូចមួយកំប៉ុង ។
នេះជាវិក័យបត្ររបស់អ្នក ។ គិតជាជាលុយសុទ្ធ រឺជាក្រេដីតកាត ?
សូមគិតជាអាមេរិកអ៊ិចប្រ៊េសកាត ។
សូមស៊ីញ៉េនៅទីនេះ ។
តើអ្នកមានបានប្រើប្រាស់ទូទឹកកកដែរទេ ?
ខ្ញុំត្រូវការកក់ទុកមួយនៅម៉ោងប្រាំពីរ ។
សូមកក់តុមួយសំរាប់មនុស្សពីរអ្នកនៅម៉ោងប្រាំបី ។
តើពួកយើងចាំបាច់ត្រូវស្លៀកពាក់តាមផ្លូវការដែរទេ ?
តើអ្នកមានតុទំនេរសំរាប់ពួកយើងដែរទេ ?
ខ្ញុំខ្លាចតែ ពួកយើងមានភ្ញៀវពេញទេ ។
តើអ្នកអាចរង់ចាំនៅទីនេះបានដែរទេ ?
ពួកយើងត្រូវការតុមួយដែលជិតមាត់បង្អួច ។
ចុះតុនេះយ៉ាងម៉េចដែរ ?
តើវាស្ងួត រឺក៏ ផ្អែម ?
សូមមេត្តាទុកពេលអោយខ្ញុំបន្តិចទៀតផង ។
តើតំបន់អ្វីដែលជាតំបន់ម្ហូបពិសេស ?
ខ្ញុំនឹងទទួលទានឈុតអាហារពេលល្ងាចមួយនេះ ។
តើអ្នកត្រូវការអ្វីដែរ ស៊ុប រឺមួយក៏ សាឡាដ ?
សូមបង្អែម សោសេន អាយស៍ឡេន ។
ខ្ញុំសុំទឹកមួយកែវទៀតបានដែរទេ ?
ការកុម្ម៉ង់របស់ខ្ញុំជិតមកដល់នៅ ?
បង្អែមរបស់ខ្ញុំនៅមិនទាន់មកដល់ទេ ។
សូមជួយប្ដូរចានគោះបារីនេះផង ?
ប្រាកដណាស់ ។ ខ្ញុំសុំស៊ីញ៉េរបស់អ្នក នៅត្រង់នេះផង ?
ពួកយើងចង់គិតលុយជាសែកផ្សេងគ្នា ។
ខ្ញុំសុំកន្ត្រកដាក់កូនឆ្កែមួយផង ?
ខ្ញុំនឹងស្រស់ស្រូបអាហារពេលព្រឹកបេ ។
សូមពងទាក្រឡុកជាមួយនិងសាច់ជ្រូកបីជាន់ ។
ត្រូវការកាហ្វេបន្ថែមដែរទេ ?
សាច់ក្រកពីរ និងទឹកក្រូចមួយ ។
លាយជាមួយទឹកជ្រលក់ម៉ូតាក និងទឹកប៉េងប៉ោះដែររឺទេ ?
លាយទាំងពីរមក ។
អត់ទេ អរគុណច្រើន ។ ខ្ញុំចូលចិត្តវា ។
ញ៉ាំនៅទីនេះ រឺក៏ ខ្ចប់ ?
ស្រាវីស្គីប៊ួរប៊ូន និងទឹក ។
បាទ ខ្ញុំកំពុងរកមើលកាបូបមួយ ។
កាដូមួយសំរាប់អ្នកម្តាយរបស់ខ្ញុំ ។
សំរាប់អាមួយនោះ ខ្ញុំសូមគិតមើលសិន ។
វាជាសរសៃសូត្រពិតៗ ។
តើអ្នកមានអាប្រភេទដដែល តែពណ៌ផ្សេងគ្នាដែរទេ ?
អស់សាមសិបប្រាំ ដុល្លារ ។
តើផ្នែកគ្រឿងសំអាងនៅកន្លែងណា ?
សូមមេត្តាសាកសួរនៅកន្លែងផ្តល់ព័ត៌មាន ។
សូមប្រើជណ្តើរយន្តនៅទីនោះ ។
បង្ហាញខ្ញុំនូវគូល័រត្របកភ្នែកខ្លះមក ។
សូមជួយណែនាំនូវម្សៅទ្រនាប់ដែលល្អមួយសំរាប់ខ្ញុំ ។
តើម៉ាកនេះអ្នកមានផលិតអីផ្សេងដែរអត់ ?
បាទ ពួកយើងមាន ។
សុំទោសផង លក់អស់ពីស្តុកហើយ ។
លើកយកអាមួយនោះនៅទីនោះ ។
ដូចជារលុងពេកសំរាប់ខ្ញុំ ។
មើលទៅ តើខ្ញុំដូចជាឆើតឆាយបន្តិចដែរអត់ ?
តើកញ្ចក់បញ្ឈរនៅឯណា ?
សូមជួយលៃតម្រឹមប្រវែងផង ?
តើត្រូវចំណាយពេលប៉ុន្មានក្នុងការធ្វើវា ?
ជួយខ្ចប់វាផង ។
តើខ្ញុំអាចទទួលយកវានៅព្រលានយន្តហោះបានដែរទេ ?
ខ្ញុំចង់បានទឹកអប់ម៉ាកឆានែល មួយភាគបួនមួយអង់ ចំនួនមួយដប ។
អោយបារីម៉ាក ស៊ីលកាត់ខ្ញុំមួយកញ្ចប់ ។
ល្អ គ្មានបញ្ហាទេ ។ អោយខ្ញុំសុំមើលលិខិតឆ្លងដែនរបស់អ្នកផង ?
តើខ្ញុំអាចទទួលវាដោយឥតគិតថ្លៃពន្ធបានទេ ?
សូមអ្នកជួយបំពេញវាផង ?
សូមមេត្តាផ្សាយស្រោមសំបុត្រនេះនៅព្រលានយន្តហោះផង ។
អ្នកនឹងទទួលបានប្រាក់សំណងចូលទៅគណនីធនាគាររបស់អ្នក ក្នុងរយៈពេល ពីរសប្ដាហ៍ ។
សូមផ្តល់ការបញ្ចុះតំលៃអោយខ្ញុំមក ។
ខ្ញុំនឹងគិតចុះអោយអ្នក ម្ភៃភាគរយនៃតំលៃសរុប ។
តើអ្នកអាចចុះតំលៃអោយថោកជាងនេះបន្តិចបានដែរអត់ ?
អូទេ វាបានបញ្ចុះតំលៃរួចទៅហើយ ។
ខ្ញុំមានត្រឹមតែ ម្ភៃប្រាំដុល្លារ ។
ខ្ញុំពិបាកសំរេចចិត្តណាស់ឥលូវនេះ ។
ខ្ញុំបានទំលាក់ម៉ាស៊ីនថតរបស់ខ្ញុំ ។ វាខូចបាត់ហើយ ។
វាកើនប្រហែល សាមសិបនាទី ក្នុងមួយថ្ងៃ ។
វាបាត់ ម្ភៃនាទី ក្នុងមួយថ្ងៃ ។
តើនៅពេលណាខ្ញុំអាចលើកវាបាន ?
ជួយប្រាប់ខ្ញុំអោយដឹងផងថាពេលណារួចរាល់ ។
សូមជួយបង្ហាញខ្ញុំនូវពណ៌ផ្សេងៗគ្នា ។
សូមជួយបង្ហាញខ្ញុំនូវទំហំផ្សេងៗគ្នា ។
តើវារឹងមាំដែរអត់ ?
ខ្ញុំចូលចិត្តរបស់ទាន់សម័យមួយ ។
តើរ៉ូបនេះប្រភេទ ឌ្រីពដ្រាយមែនទេ ?
តើវារួញដែរអត់ ?
តើនាឡិកានេះចូលទឹកដែរអត់ ?
តើការបញ្ចូលដែលអាចប្រើបាន ?
តើពួកវាមានភាពខុសគ្នាត្រង់ណាខ្លះ ?
តើស្បែកជើងទាំងនេះនាំចូលពីសហរដ្ឋអាមេរិកមែនទេ ?
ជួយប្រាប់ខ្ញុំពីវិធីប្រើរបស់នេះផង ។
តើអ្នកប្រកាន់ខ្ញុំដែរទេ ប្រសិនបើខ្ញុំប៉ះវា ?
តើនាឡិកានេះធានាបានប៉ុន្មានឆ្នាំដែរ ?
តើស្ថិតនៅក្នុងបន្ទុករបស់អ្នកណា ?
តើអ្នកណាជាអ្នកនៅក្រោយគេ ?
របស់នេះគឺកខ្វក់ណាស់ ។
វាមានស្នាមប្រឡាក់មួយ ។
សូមផែនទីទីក្រុងមួយ ។
ខ្ញុំចង់ដើរលេងជុំវិញ ។
ខ្ញុំពិតជាចង់មើលប្រាសាទណាស់ ។
តើមានកន្លែងល្អណាខ្លះដែលត្រូវមើល ?
តើចាប់ផ្តើមនៅកន្លែងណា ពេលណា ?
តើវាមានតំលៃប៉ុន្មានសំរាប់ពាក់កណ្តាលថ្ងៃ ?
តើម៉ោងបើកនៅសួនរុក្ខសាស្ត្រនេះ គឺជាអ្វី ?
តើអ្នកមានការផ្តល់ជូនពិសេសចសំរាប់ក្រុមមួយដែរទេ ?
សុំអភ័យទោសផង តើអ្នកអាចជួយថតរូបអោយខ្ញុំបានដែរអត់ ?
គ្រាន់តែចុចវា ។
សូមទុកកាបូបស្ពាយរបស់អ្នកនៅក្នុងបន្ទប់សាធារណៈនេះចុះ ។
សូមលុយកាក់ ម្ភៃដុល្លារ ។
ខ្ញុំនឹងព្យាយាមម្តងទៀត ។
គិតលុយកាក់អោយខ្ញុំ ។
តើនៅទីនេះមានបញ្ចុះតំលៃសំរាប់សិស្សដែរទេ ?
សូមសំបុត្រពីរសំរាប់ការសម្តែងនៅថ្ងៃពុធ ។
តើការសម្តែងនឹងចាប់ផ្តើមនៅពេលណា ?
តើមានអ្នកណាអង្គុយនៅទីនេះដែរទេ ?
ខ្ញុំចង់លេងកូនគោល ។
តើខ្ញុំអាចជួលស្បែកជើង និងក្លិបបានដែរទេ ?
ខ្ញុំចង់លេងធិននីស ។
សូមធ្វើការកក់ទីធ្លាវាយធីននីសមួយ ។
តើខ្ញុំអាចជួលរ៉ាកែតបានទេ ?
នេះជាបទពិសោធន៍ដំបូងរបស់ខ្ញុំ ។
ខ្ញុំចង់ចូលទៅសាលា ។
តើខ្ញុំអាចមេរៀនឯកជន ?
ខ្ញុំចង់ទៅទស្សនាហ្គេមបាល់ទាត់ ។
តើអ្នកណាជាក្រុមប្រឆាំង ?
ទៅកាន់សណ្ឋាគារផាក ។
តាមផ្លូវកាត់ជាងគេ ។
ខ្ញុំនៅទីនោះ កាលពីអាយុប្រាំឆ្នាំ ។
យើងនៅទីនោះមែនទេ ?
អោយខ្ញុំចុះនៅទីនេះ ។
តើអ្នកអាចជួយយួរកាបូបស្ពាយរបស់ខ្ញុំបានដែរទេ ?
តើទៅព្រលានយន្តហោះមែនទេ ?
តើមានចំណតប៉ុន្មានទៅកាន់សារមន្ទីរ ?
តើកន្លែងលក់សំបុត្រនៅឯណា ?
សូមផែនទីផ្លូវក្រោមដី ។
តើមានចំណតដែលរហ័សនៅស្ថានីយ៍ដែរទេ ?
សុំពីរកន្លែងនៅជួរមុខគេបង្អស់ ទៅទីក្រុង សាន់ឌីហ្គូ ។
តើថ្ងៃល្អមានប៉ុន្មានថ្ងៃ ?
តើនៅមានសុពលភាពទៀតដែរទេ ?
សុំទោស វានៅមិនទាន់ផុតកំណត់ទេ ។
តើខ្ញុំអាចឈប់បានទេ ?
តើរថភ្លើងចាប់ផ្តើមនៅម៉ោងប៉ុន្មាន ?
ចេញពីច្រកមួយណា ?
តើវាជាច្រកចេញដែលត្រូវទៅទីក្រុងញ៉ូវយកមែនទេ ?
ចេញពីផ្លូវដើរមួយណា ?
តើនៅក្នុងចិត្តរបស់អ្នក មានប្រភេទណា ?
រថយន្តចង្កូតអូតូមួយ ។
ក្នុងមួយថ្ងៃ ម្ភៃប្រាំដុល្លារ បូកបន្ថែម ម្ភៃសេនក្នុងមួយម៉ៃ ។
មានបញ្ចូលធានារ៉ាប់រងដែរអត់ ?
ខ្ញុំអាចចាក់សាំងរថយន្តបានទេ ?
ចាក់អោយខ្ញុំសាមសិបលី ។
ចាក់អោយខ្ញុំសាមសិបលីត្រ ។
កៅអីអង្គុយថ្នាក់សេដ្ឋកិច្ចមួយ ទៅទីក្រុង ឡូស អេជិលឡេស ។
តើវាទាន់ពេលអត់ ?
តើច្រកមួយណាសំរាប់ ហ្សេអាអ៊ែល សេវែន ?
សូមកៅអីអង្គុយអត់មានកន្លែងជក់បារី ។
ខ្ញុំពេញចិត្តកៅអីអង្គុយមាត់បង្អួច ។
តើខ្ញុំអាចសុំអាហារបួសបានដែរទេ ?
ជួយប្រាប់ខ្ញុំធ្វើម៉េចទៅដល់ទីនោះបាន ។
ទៅត្រង់ ហើយបត់ឆ្វេង ។
ផ្លូវនេះទៅខាងក្រោម ។
គឺនៅទីនេះហើយ ។
ពីទីនេះ ទៅកាច់ជ្រុង មានប្លុកពីរ ។
វាចំណាយពេលច្រើនជាង សាមសិបនាទី ។
តើជិះតាក់ស៊ីពីនេះទៅសារមន្ទីរសិល្បៈ អស់ថ្លៃប៉ុន្មានដែរ ?
យ៉ាងហោចណាស់ក៏ ម្ភៃដុល្លារ ។
តើអ្នកអាចបង្ហាញខ្ញុំនៅលើផែនទីនេះបានដែរទេ ?
ពីទីនេះទៅ តើមានប្លុកប៉ុន្មាន ?
វាគឺនៅតាមបណ្តោយផ្លូវនេះ ។
តើជិះតាក់ស៊ីខេបពីនេះទៅសារមន្ទីរសិល្បៈ អស់ថ្លៃប៉ុន្មានដែរ ?
តើទៅតាមផ្លូវនេះទៅសណ្ឋាគារត្រឹមត្រូវដែរទេ ?
តើច្បាស់ដែរទេ ?
សូមទូរស័ព្ទចម្ងាយឆ្ងាយទៅកាន់ទីក្រុងតូក្យូ ។
លោក ថាណាកា នៅបន្ទប់លេខ ប្រាំ ហាសិបពីរ ។
ហៅទូរស័ព្ទប្រមូល ។
ហៅទូរស័ព្ទពីមនុស្សម្នាក់ទៅមនុស្សម្នាក់ ។
សូមឈ្មោះពិធីជប់លៀង និងលេខទូរស័ព្ទរបស់អ្នក ។
តូក្យូ សូន្យ បី ប្រាំបី មួយ មួយ ប្រាំ ប្រាំ ពីរ បួន កញ្ញា មីឈីកុ កាតុ ។
ពិធីជប់លៀងរបស់អ្នករួចហើយ ។ ចាប់ផ្តើម ។
សុំទោសផង ពួកគេមិនទទួលទូរស័ព្ទទេ ។
មិនអាចទាក់ទងបានទេ ។
បណ្តាញត្រូវបានតភ្ជាប់ ។
នេះគឺ ថេរ៉ាអុ មកពីប្រទេសជប៉ុន ។
អោយខ្ញុំសុំទោសផង គាត់បានចាកចេញអំបាញ់មិញនេះហើយ ។ តើអ្នកត្រូវការអោយខ្ញុំផ្តាំប្រាប់គាត់អោយទូរស័ព្ទទៅវិញ ពេលដែលគាត់ត្រឡប់មកវិញដែរទេ ?
តើខ្ញុំអាចផ្ញើសារបានទេ ?
តើអ្នកមានអ្នកណាដែលអាចនិយាយភាសាជប៉ុនបានដែរអត់ ?
តើទូរស័ព្ទសាធារណៈនៅឯណា ?
អាឡូ នេះជាប្រតិបត្តិករ ។
ទៅទីក្រុង ឡូសអ៊ែនជាឡែស លេខ ប្រាំ មួយ មួយ ប្រាំពីរ ពីរ ប្រាំពីរ បី ។
អាឡូ តើនេះជាលោក ក្លាកមែនទេ ?
ដឹកជញ្ជូនវាជាពិសេស ។
តើចំណាយរយៈពេលប៉ុន្មាទើបដល់ប្រទេសជប៉ុន ?
តើយ៉ាងម៉េចបានជាអ្នកចូលចិត្តវា ?
តើសក់របស់អ្នកបត់ទៅខាងណា ?
ខ្ញុំចង់ធ្វើការកក់ទុកមួយ នៅម៉ោង ប្រាំ ។
សុំខ្លីបន្តិច ។
ខ្ញុំចង់បានម៉ូដដដែល ។
ហើយចុះថ្នាំក្រចកម៉ាក ម៉ានីខ្យួរ វិញ ?
កាបូបលុយរបស់ខ្ញុំ និងលិខិតឆ្លងដែន ។
កាបូបលុយរបស់ខ្ញុំបាត់ហើយ ។
តើមានលុយប៉ុន្មាននៅក្នុងនោះ ?
មានលុយសុទ្ធប្រហែលមួយរយហាសិបដុល្លារ ។
មានមនុស្សរបួស ។
មើលខ្លួនឯងទៅ ។
តើខ្ញុំគួរតែទៅរាយការណ៍នៅកន្លែងណា ?
តើកន្លែងដែលរក្សាទុករបស់ដែលបាត់ មាននៅឯណា ?
ប្រសិនបើរកឃើញ សូមជួយប្រាប់ខ្ញុំអោយដឹងផង ។
ខ្ញុំនិយាយភាសាអង់គ្លេសមិនបានល្អទេ ។
ជួយយកខ្ញុំទៅមន្ទីរពេទ្យផង ។
ខ្ញុំចង់ធ្វើការណាត់ជួបមួយ ។
ខ្ញុំចង់ទៅមើលគ្រូពេទ្យ ។
ខ្ញុំចង់ក្អួត ។
បំពង់ក របស់ខ្ញុំឈឺ ។
ធ្មេញប៉ះចេញមកក្រៅ ។
ខ្ញុំបុកជង្គង់របស់ខ្ញុំ ។
កជើងរបស់ខ្ញុំហើម ។
ខ្ញុំមានស្នាមមុតមួយនៅទីនេះ ។
ឃ្មុំទិចដៃរបស់ខ្ញុំ ។
ខ្ញុំមានដំបៅពងបែកធ្ងន់ធ្ងរមួយនៅលើជើង ។
តើខ្ញុំអាចបន្តការធ្វើដំណើរបានដែរអត់ ?
សូមជួយរុំរបួសបឋមឲ្យខ្ញុំផង ។
តើផឹកវាទៅ មិនអីទេមែនទេ ?
តើឱសថស្ថានមាននៅឯណា ?
លេបថ្នាំនេះបន្ទាប់ពីអាហារ ។
តើថ្នាំនេះមានផលប៉ះពាល់ដែររឺទេ ?
ខ្ញុំអត់មានអារម្មណ៍ប្រសើរឡើងអ្វីសោះ ។
តើឱសថការីនៅឯណា ?
ល្អណាស់ ហើយចុះអ្នកវិញ ?
មិនសូវល្អប៉ុន្មានទេ ។
ខ្ញុំក៏រីករាយណាស់ដែលបានជួបអ្នក ។
ខ្ញុំឈ្មោះ តូម៉ូកូ សាអេគី ។
ម្តាយរបស់ខ្ញុំផ្ញើសេចក្តីរាប់អានដល់អ្នក ។
វាគ្មានអ្វីទាំងអស់ ។
នេះជាក្តីរីករាយរបស់ខ្ញុំ ។
សុំទោសដែលរំខានអ្នក ។
ខ្ញុំមិនយល់ព្រមជាមួយអ្នកទេ ។
ខ្ញុំខ្លាចក្រែងតែមិនអាច ។
វាជាថ្ងៃដែលស្រស់ស្រាយ ពិតមែនទេ ?
ចំជាថ្ងៃអាក្រក់បំផុត ។
តើនៅខាងក្រៅមានភ្លៀងមែនទេ ?
ក្តៅខ្លាំងណាស់ ។
ត្រជាក់ខ្លាំងណាស់ ។
ខ្ញុំបារម្ភខ្លាចវានឹងធ្លាក់ព្រិល ។
វាគ្រាន់តែរលឹមស្រិចៗប៉ុណ្ណោះ ។
វានឹងឈប់ពេលឆាប់ៗនេះ ។
តើអ្នកមានពេលដែររឺទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីម៉ោងផងបានទេ ?
ម៉ោងបួនសាមសិបនាទី ។
ម៉ោងបួនកន្លះ ។
តើអ្នកបាននិយាយថាម៉េច ?
តើអ្នកអាចនិយាយវាម្តងទៀតបានទេ ?
ខ្ញុំមិនអាចធ្វើតាមអ្នកបានទេ ?
រីករាយដែលបានជួបអ្នកម្តងទៀត ។
តោះញ៉ាំនំប៉័ងដុត ។
បាទ ។ សូមមេត្តាជក់បារីនៅខាងក្រៅ ។
ខ្ញុំសូមអនុញ្ញាតណែនាំមិត្តភក្តិរបស់ខ្ញុំ ។
នេះជាមិត្តរួមការងាររបស់ខ្ញុំគឺ កញ្ញា ហុងដា ។
ខ្ញុំមានគ្រប់យ៉ាងហើយ អរគុណ ។
ខ្ញុំពិតជាពេញចិត្តនឹងពិធីជប់លៀងរបស់អ្នកណាស់ ។
ខ្ញុំសូមជូនពរអ្នកជួបតែអ្វីដែលល្អឥតខ្ចោះ ។
ខ្ញុំសង្ឃឹមថាអ្នកនឹងមានអាពាហ៍ពិពាហ៍ដ៏រីករាយមួយ ។
អ្នកជាបុរសដែលមានសំណាងម្នាក់ ។
នេះជាកាដូដែដែលចេញពីបេះដូងរបស់ខ្ញុំ ។
ខ្ញុំចង់មើលអ្នកនៅពេលដែលសេចក្តីរីករាយរបស់អ្នកនឹងសម្រេចបាននៅពេលឆាប់ៗនេះ ។
តើនៅពេលណាជាពេលដែលវាងាយស្រួលសំរាប់អ្នក ?
ខ្ញុំចង់ប្ដូរការណាត់ជួបរបស់ពួកយើង ។
ខ្ញុំបារម្ភខ្ញុំត្រូវលុបចោលការណាត់ជួបរបស់យើង ។
វាមានទំហំដូចគ្នាប្រហែលនៅរដ្ឋកាលីហ្វនីញ៉ា ។
ប្រទេសជប៉ុនមានកោះធំៗបួន ។
វាក្តៅហើយសើមនៅរដូវក្តៅ ។
យើងមានរដូវភ្លៀងនៅខែមិថុនា និងខែកក្កដា ។
សំលៀកបំពាក់ប្រពៃណីទំនៀមទំលាប់ជនជាតិជប៉ុនគឺហៅថា «គីម៉ូណូ» ។
ពួកយើងស្លៀកពាក់គីម៉ូណូនៅឱកាសពិសេស ។
តើមានកីឡាពេញនិយមអ្វីខ្លះ នៅប្រទេសជប៉ុន ?
សូមមេត្តាពាក់ខ្សែក្រវ៉ាត់កៅអីអង្គុយរបស់អ្នក ហើយប្រតិបត្តិតាមស្លាកសញ្ញា «ហាមជក់បារី» រហូតដល់វាបិទ ។
ពួកយើងនឹងចេញដំណើរនៅពេលប៉ុន្មាននាទីនេះ ។ សូមប្រាកដថាខ្សែក្រវ៉ាត់កៅអីអង្គុយរបស់អ្នកគឺបានពាក់មានសុវត្ថិភាព ។
ប្រសិនបើអ្នកចង់អោយពួកយើងបំរើលោកអ្នក សូមកុំស្ទាក់ស្ទើរក្នុងការទូរស័ព្ទមកកាន់យើងខ្ញុំ ។
យើងខ្ញុំកំពុងតែធ្វើការចុះចតនៅព្រលានយន្តហោះ ហូណូលូលូ ។ ម៉ោងនៅក្នុងតំបន់គឺម៉ោង ប្រាំពីរសាមសិបនាទីព្រឹក ថ្ងៃព្រហស្បត្តិ៍ទីដប់ ខែសីហា ។ អាកាសធាតុនៅ ហូណូលូលូ គឺមធ្យមហើយ សីតុណ្ហភាពដីគឺ សាមសិបដឺក្រេ សង់ទីក្រាត រឺ ប៉ែតសិបប្រាំមួយដឺក្រេ ស្ទង់កំដៅ ។
ខ្ញុំត្រូវការបើកបង្អួច ។
ខ្ញុំត្រូវការមើលកាសែត ។
ខ្ញុំចង់ទៅមើលខ្សែភាពយន្ត ។
តើអ្នកមានផែនទីផ្លូវក្រោមដីដែរទេ ?
តើនៅទីក្រុងនេះមានបឹងដែរអត់ ?
តើអ្នកចាកចេញពីទីនេះ នៅពេលណា ?
តើនារីម្នាក់នេះជាអ្នកណា ?
តើអ្នកចង់ឃើញអ្នកណា ?
តើមួយណាដែលអ្នកចូលចិត្តខ្លាំងជាងគេ ?
តើអ្នកមកទីនេះដោយសារអ្វី ?
ខ្ញុំចាប់ពាក្យរបស់អ្នកមិនបានទេ ។
ខ្ញុំឈ្មោះ មីកាកូ អ៊ីកេដា ។
នេះជាមិត្តភក្តិខ្ញុំគឺ រីសា ។
ខ្ញុំមកពីប្រទេសជប៉ុន ។
តើគ្រប់យ៉ាងមិនអីទេមែនទេ ?
អរគុណ ប៉ុណ្ណឹងគ្រប់គ្រាន់ហើយ ។
តើអ្នកមានពេលដែរទេ នៅយប់នេះ ?
វាជាបញ្ហាជីវិត និងការស្លាប់រស់ ។
អស់លោក លោកស្រី ដោយសារតែមានគ្រោះថ្នាក់មួយនៅឯព្រលានយន្តហោះ ការមកដល់របស់ពួកយើង ត្រូវបានពន្យាពេល ។
តើខ្ញុំអាចផ្លាស់ទីតាំងទៅម្ខាងផ្សេងទៀតបានទេ ?
តើទីនេះជាកៅអីអង្គុយគ្មានជក់បារីមែនទេ ?
សូមភួយផ្សេងទៀត ។
មិនអីទេ ខ្ញុំនឹងយកអោយអ្នកក្នុងពេលបន្តិចទៀតនេះ ។
តើអ្នកបរិភោគអាហារពេលថ្ងៃត្រង់រួចរឺនៅ ?
បាទ ខ្ញុំចូលចិត្តវា ។
ខ្ញុំសុំទោស ប៉ុន្តែយើងខ្ញុំមានតែស្រាបៀ និង ស្រាវីស្គី ។
ល្អ អញ្ចឹងខ្ញុំយកស្រាវីស្គី ។
បាទ គ្មានបញ្ហា ។
តើរយៈពេលប៉ុន្មានទៅទីក្រុងប៉ារីស ?
សូមឲ្យថ្នាំខ្ញុំខ្លះមក ។
ខ្ញុំអត់មានចំណង់អាហារសោះ ។
ខ្ញុំស្រវឹងខ្លាំងណាស់ ។
ល្អ ។ តើអ្នកស្នាក់នៅទីនេះរយៈពេលប៉ុន្មាន ?
នៅសណា្ឋគារមួយនៅទីក្រុងញ៉ូវយ៉ក ។
នេះជាសណ្ឋាគារដែលខ្ញុំនឹងស្នាក់នៅ ។
ខ្ញុំមានលុយសុទ្ធពីររយដុល្លារ និង លុយនៅក្នុងសែកត្រាវែល្លឺរ មានចំនួន ពីរពាន់ដុល្លារ ។
តើនៅកន្លែងណាដែលខ្ញុំអាចទទួលយកវ៉ាល្លីរបស់ខ្ញុំសំរាប់ការហោះហើរយន្តហោះជប៉ុន ច្យេអាអ៊ែល ប្រាំសូន្យមួយ បាន ?
វាគឺពណ៌បៃតង ហើយប្រហែលទំហំប៉ុននេះ ។
ឈ្មោះរបស់ខ្ញុំ និងអាសយដ្ឋាន សុទ្ធតែនៅលើវ៉ាល្លី ។
សូមបើកកាបួបរបស់អ្នក ។ តើនេះគឺជាអ្វី ?
វាគឺជារបស់ប្រើប្រាស់ផ្ទាល់ខ្លួនរបស់ខ្ញុំ ។
របស់នេះមិនត្រូវបានអនុញ្ញាតឡើយ ។
តើអ្នកមានដំណាំ និង ផ្លែឈើអ្វីខ្លះ ?
តើការហោះហើរមួយណាដែលខ្ញុំនឹងត្រូវចេញទៅបន្ទាប់ ?
កៅអីអង្គុយនេះទំរេតមិនបានទេ ។ តើអ្នកអាចព្យាយាមជួសជុលវាបានដែរទេ ?
សូមមេត្តាបង់ពន្ធចំពោះវត្ថុទាំងអស់នៅទីនោះ ។
សួស្តី ខ្ញុំធ្វើការកក់ទុកមួយ ឈ្មោះរបស់ខ្ញុំគឺ តាកាកូ អ៊ីកេដា ។ នេះគឺជាកាតបញ្ជាក់ ។
សូមមេត្តារង់ចាំបន្តិច ។ បាទ យើងខ្ញុំនមានបន្ទប់មួយសំរាប់អ្នក ។
សូមបំពេញកាតសុំចុះឈ្មោះនេះ ។
សូមយកកាបូបវ៉ាល្លីរបស់ខ្ញុំទៅបន្ទប់ផង ។
នេះជាបន្ទប់លេខ ដប់ ម្ភៃប្រាំ ។ សូមសេវាកម្មបន្ទប់ផង ។
សូមនាំយកនូវអាហារពេលព្រឹកពីរឈុត ។ នៅក្នុងបញ្ជីរាយមុខម្ហូប លេខរៀងពីរ ហើយនិងតែទឹកដោះគោពីរកែវ ។
សូមហៅតាក់ស៊ីមួយគ្រឿងនៅម៉ោងប្រាំបួនពេលព្រឹក ។
តើខ្ញុំអាចផ្ញើសារនេះទៅកាន់កញ្ញា មីយ៉ាតា បន្ទប់លេខ ដប់ពីរ ដប់មួយបានដែរទេ ?
ខ្ញុំត្រូវការផែនទីផ្លូវក្រោមដី ។
ខ្ញុំចេញទៅខាងក្រៅ ។ នេះជាសោរបន្ទប់របស់ខ្ញុំ ។
អាវក្រណាត់ពីរ និងអាចធំពីរ ។ នៅទីនេះមានស្នាមប្រឡាក់ ។
នេះគឺជាប្រតិបត្តិករសំរាប់សេវាកម្មទូរស័ព្ទអន្តរជាតិ ។
ទូរស័ព្ទមានខ្សែទៅកាន់កញ្ញា កាយ៉ូ ហ៊ីរ៉ូកាវ៉ា លេខទូរស័ព្ទប្រទេសជប៉ុន សូន្យ មួយ ពីរ បី បួន ប្រាំ ប្រាំមួយ ប្រាំពីរ ប្រាំបី ប្រាំបួន ។
សូមរង់ចាំសិន ។
ដៃគូរបស់អ្នកនៅក្នុងបណ្តាញ ។
ខ្ញុំត្រូវការផ្ញើកាតផូស្តាល់នេះទៅប្រទេសជប៉ុនតាមរយៈម៉ែលជើងកាស ។
ខ្ញុំត្រូវការផ្ញើកញ្ចប់មួយនេះទៅប្រទេសជប៉ុនតាមរយៈសមុទ្រ ។
សូមតែម សែសិបសេន ចំនួនដប់មក ។
ខ្ញុំត្រូវការផ្ញើកាតផូស្តាល់នេះទៅប្រទេសជប៉ុនតាមរយៈការផ្ញើរហ័ស ។
ខ្ញុំត្រូវការផ្ញើកាតផូស្តាល់នេះទៅប្រទេសជប៉ុនតាមរយៈម៉ែលរីជីសស្ទឺរ ។
តើនៅសណ្ឋាគារនេះ មានសម្ផស្សដែរទេ ?
តើអ្នកអាចផ្តល់យោបល់ពីហាងសម្ផស្សល្អមួយនៅជិតនេះបានដែរទេ ?
ខ្ញុំត្រូវការធ្វើការណាត់ជួបមួយសំរាប់គ្នាដប់នាក់ នៅពេលព្រឹក ។
នៅសណ្ឋាគារនេះ តើមានហាងកាត់សក់បុរសដែរទេ ?
មានហាងសម្ផស្សនៅទីនេះអត់ ?
សូមប្ដូរបន្ទប់របស់ខ្ញុំផង ។ វាធុំក្លិនគួរអោយអស់សំណើចណាស់ ។
បន្ទប់នៅជាប់នេះគឺគួរអោយរំខានខ្លាំងណាស់ ។
សូមអភ័យទោស ខ្ញុំបានចាក់សោរចេញហើយ ។
ខ្ញុំមិនទាន់ទទួលយកខោអាវបោកអ៊ុត្រឡប់មកវិញនៅឡើយ ។
ខ្ញុំនៅតែរង់ចាំអាហារពេលព្រឹករបស់ខ្ញុំ ។ តើខ្ញុំអាចទទួលបាននៅ ?
តើវាទៅជាយ៉ាងណា ?
សូមបង្ហាញប័ណ្ណបន្ទុកអោយខ្ញុំផង ។
នេះមិនមែនជាសញ្ញារបស់ខ្ញុំទេ ។
សូមអ្នកជួយហៅតាក់ស៊ីអោយខ្ញុំផង ?
កាតនេះ ល្អអត់ ?
ខ្ញុំសុំទោស ប៉ុន្តែយើងឆ្អែតហើយ ។
តើអ្នកអាចអោយឈ្មោះសណ្ឋាគារដទៃទៀតបានទេ ?
ខ្ញុំត្រូវការស្នាក់នៅមួយយប់ទៀត ។ តើអាចបានអត់ ?
ខ្ញុំត្រូវការលុបចោលការកក់បន្ទប់របស់ខ្ញុំ ។
ខ្ញុំចង់បានបន្ទប់មួយដែលមានទេសភាពស្អាត ។
មួយរយដុល្លារទាំងថ្លៃពន្ធ ។
រួមមានទាំងអាហារពេលព្រឹក និងអាហារពេលល្ងាចមែនទេ ?
សំរាប់ខ្ញុំវាមានតំលៃថ្លៃ ។
សូមជួយណែនាំភោជនីយដ្ឋានដែលមានតំលៃថោកសមរម្យមួយផង ។
តើខ្ញុំគួរតែពាក់ក្រវ៉ាត់កនៅទីនេះបានទេ ?
តុមួយសំរាប់មនុស្សបួននាក់ នៅម៉ោងប្រាំពីរ ឈ្មោះរបស់ខ្ញុំគឺសាកៃ ។
ខ្ញុំមានកក់ទុកមួយកន្លែង នៅម៉ោងប្រាំពីរ សាកៃ ។
ខ្ញុំត្រូវការពេលបន្ថែមបន្តិចទៀត ។
តើខ្ញុំអាចទទួលការកុម៉្មង់របស់អ្នកបានរឺនៅ ?
ខ្ញុំត្រូវការការហោះហើរមួយ ។
ខ្ញុំត្រូវការសាច់ត្រីសាល់ម៉ុងអាំងមួយ និងឈុតអាហារលេខពីរ ។
ស្រាក្រហមមួយកែវ បានទេ ?
សូមស្រាសមួយដបតូច ។
សូមស្រាមួយកែវផ្សេងទៀត ។
ការកុម្ម៉ង់របស់ខ្ញុំនៅមិនទាន់មកនៅឡើយទេ ។
ខ្ញុំបានធ្វើអោយបែកកែវមួយ ។
ពួកយើងត្រូវការបង់ដោយប្រើកាតនេះ ។
តើខ្ញុំអាចអង្គុយនៅទីនេះបានដែរទេ ?
តើខ្ញុំអាចអង្គុយនៅកន្លែងមួយដោយគ្រាន់តែញ៉ាំនំខេក និងកាហ្វេបានដែរទេ ?
ទៅកាន់សារមន្ទីរសិល្បៈ ។
អ្នកគិតតំលៃលើសពីខ្ញុំ ។
ខ្ញុំអត់លុយអាប់បានត្រឹមត្រូវទេ ។
តើមានចំណតប៉ុន្មានដែរ នៅផ្លូវទីបី ?
វាចំណាយ កៅសិបប្រាំបួននាទី ដោយជើង ។
សូមប្រាប់ខ្ញុំពីកាលវិភាគ ។
តើនេះជាស្ថានីយ៍ដឹកជញ្ជូនត្រឹមត្រូវមែនទេ ?
ខ្ញុំបានឆ្លងកាត់ហួសចំណត ។
ខ្ញុំខកចំណតរបស់ខ្ញុំហើយ ។ តើវាត្រូវចំនាយពេលប៉ុន្មានដើម្បីទៅដល់ចំណតបន្ទាប់ ?
ការមកដល់របស់យើងនឹងត្រូវពន្យាពេល ។
តើទៅយកខ្ញុំនៅឯណា ?
ខ្ញុំចង់ជួលរថយន្តមួយគ្រឿង សូមប្រាប់ខ្ញុំពីតារាងតំលៃ ។
តើខ្ញុំអាចចាកចេញនៅគោលដៅរបស់ខ្ញុំបានដែរអត់ ?
សូមធានារ៉ាប់រង ។
តើអ្នកអាចប្រាប់ខ្ញុំពីផ្លូវទៅសារមន្ទីរបានទេ ?
សូមបង្ហាញប្រាប់ខ្ញុំថាតើខ្ញុំនៅកន្លែងណានៅផែនទីនេះ ។
ខ្ញុំកំពុងព្យាយាមទៅកាន់ទីកន្លែងនេះ ។
តើមួយណាប្រសើរជាង ទៅតាមផ្លូវក្រោ មដី រឺក៏តាមរថយន្តក្រុង ?
តើអ្នកអាចគូរផែនទីអោយខ្ញុំមួយផងបានទេ ?
ពីពេលនេះទៅ ប្រហែលប៉ុន្មាន ?
ទៅត្រង់តាមបណ្តោយផ្លូវនេះ បួនប្លុក ។ ហើយបត់ទៅខាងឆ្វេងតាមនិមិត្តសញ្ញា ។
ខ្ញុំសុំទោស តើអ្នកអាចធ្វើវាម្តងទៀតបានទេ ?
ខ្ញុំវង្វេងផ្លូវហើយ ។ មិញនេះ តើអ្នកមានឃើញក្រុមទេសចរណ៍ជនជាតិជប៉ុនដែរទេ ?
តើខ្ញុំអាចស្វែងរកប្រអប់ទូរស័ព្ទបាននៅកន្លែងណា ?
ខ្ញុំកំពុងស្វែងរកមិត្តភក្តិរបស់ខ្ញុំ ។
តើខ្ញុំអាចរកផ្សារទំនើបនៅកន្លែងណា ?
តើនៅម្តុំនេះ មានហាងលក់អនុស្សាវរីយ៍ដែរទេ ?
តើកន្លែងណាដែលខ្ញុំអាចរកគ្រឿងសំភារៈតុបតែងបាន ?
តើផ្នែកសៀវភៅនៅកន្លែងណា ?
តើទំនិញកីឡាលក់នៅជាន់មួយណា ?
នៅជាន់ទីប្រាំ ។
គ្រាន់តែមើលទេ អរគុណ ។
ខ្ញុំត្រូវការមើលពណ៌ផ្សេងពីនេះទៀត ។
វាមានតំលៃថ្លៃពេកសំរាប់ខ្ញុំ ។ សូមបង្ហាញអាមានតំលៃថោកជាងនេះមួយផង ។
វាមិនសាកសមល្អទេ ។
តើរ៉ូបនេះមានតំលៃប៉ុន្មាន ?
តើអ្នកមាន ប្រភេទដូចគ្នា ប៉ុន្តែការរចនាម៉ូដដទៃផ្សេងទៀតអត់ ?
សូមអភ័យទោស សូមបង្ហាញខ្សែកមាសអោយខ្ញុំ រាប់ពីខាងស្តាំដៃ ទីបី ។
តើកាច់ជ្រុងនេះអត់គិតពន្ធមែនទេ ?
តើអ្នកចង់ធ្វើវាអត់គេចពន្ធមែនទេ ? សូមបំពេញនៅក្នុងបែបបទនេះ ។
ខ្ញុំគួរតែបានលុយអាប់ចំនួន ចិតសិបប្រាំមួយសេន ។
ខ្ញុំអាចបង់ប្រាក់តាមរយៈសែកត្រាវែលឺនេះបានទេ ?
ចំនួនលុយអាប់នេះមិនត្រឹមត្រូវទេ ។
ខ្ចប់ដោយឡែកពីគ្នា ហើយដាក់បូអោយមួយមុខមួយៗផង ។
តើអ្នកណាខ្លះធ្វើការ ?
តើអ្នកមានប្រភេទកៅអីបែបណាខ្លះ ហើយគិតថ្លៃប៉ុន្មានដែរ ?
តើអ្នកមានកៅអីកក់ទុកហើយរឺនៅ ?
តើខ្សែភាពយន្តដំណើរការមានរយៈពេលប៉ុណ្ណា ?
តើមានកន្លែងអង្គុយហើយនៅ ?
តើប៉ុន្មានថ្ងៃនេះ មានការប្រកួតធិននីសធំៗដែរទេ ?
ឥលូវបិទរដូវកាលហើយ ។
ពីម៉ោងដប់ទៅដល់ម៉ោងដប់ពីរ ។
តើខ្ញុំអាចជួលសំភារៈឧបករណ៍កូនហ្គោលបានដែរទេ ?
ខ្ញុំចង់រៀនមេរៀនជិះស្គីមួយ ។
តើហាងជួលកង់នៅឯណា ?
ខ្ញុំត្រូវការជួលស្គីខ្លះ ដងស្គី និងស្បែកជើងស្គី ។
សូមបង្ហាញខ្ញុំពីឈុតរបស់វាផង ។
ខ្ញុំត្រូវការទិញនុយសំរាប់ស្ទូចត្រីទន្លេ ។
សូមជួយអោយខ្ញុំនូវនុយស្ទូចត្រីមួយគូរផង ។
សូមប្រាប់ខ្ញុំពីកន្លែងល្អពិសេសនៅទនេ្លនេះ ។
សូមប្រាប់ខ្ញុំពីកន្លែងល្អសំរាប់ជិះក្តារលើសមុទ្រ ។
អ្នកពូកែជិះក្តារលើសមុទ្រមែន ។
អ្នកពិតជាមានជំនាញណាស់ក្នុងការជិះក្តារលើសមុទ្រ ។
ខ្ញុំចង់រៀននៅក្នុងសាលាជ្រមុចក្នុងទឹកសមុទ្រ ។
តើអ្នកមកជ្រមុចទឹកសមុទ្រនៅទីនេះ ប៉ុន្មានដងហើយ ?
ខ្ញុំចង់ទៅរាំនៅឌីស្កូដែលល្បីជាងគេបំផុត ។
សូមបង្រៀនខ្ញុំពីជំហានចង្វាក់ផងបានដែរទេ ?
តោះសំរាកមួយភ្លែតសិន ។
សុំ ស្រាស្កុតអនឌឹរគ ពីរកែវ ។
ខ្ញុំភ្នាល់លេខដប់បួនឋឋ ចំនួនដប់ដុល្លារ ។
ខ្ញុំចង់ធ្វើការភ្នាល់ស្នូកឃ័រ ។
សូមអភ័យទោស សូមជួយរុញសន្ទះបើកពន្លឺអោយចូលផង ។
តើអ្នកទទួលប្ដូរលុយនៅសណ្ឋាគារនេះដែរទេ ?
តើអ្នកចង់បានលុយបែបណាដែរ ? សូមមេត្តាបំពេញនៅទីនេះ ហើយសុំស៊ីញ៉េផង ។
សុំកាក់ ហាសិបសេន ចំនួនម្ភៃ ក្រដាសមួយដុល្លារ ចំនួនដប់ និង ក្រដាសដប់ដុល្លារ ចំនួនប្រាំ ។
តើអ្នកអាចប្ដូរក្រដាសដប់ដុល្លារមួយបានទេ ?
តើអ្នកប្ដូរពីលុយយ៉េនជប៉ុន ទៅជាលុយដុល្លារបានអត់ ?
ខ្ញុំចង់បំបែកលុយក្រដាសដប់ដុល្លារនេះ ទៅជា ក្រដាសប្រាំដុល្លារមួយសន្លឹក និងក្រដាសមួយដុល្លារប្រាំសន្លឹក ។
ចុះហត្ថលេខានៅទីនេះ ។
សុំចុះហត្ថលេខានៅខាងក្រោយមូលប្បទានប័ត្រនេះ ។
សុំអាប់លុយរាយ ។
សុំអភ័យទោស ប៉ុន្តែអានេះដូចជាខ្លី ។
ខ្ញុំបានអោយអ្នកក្រដាសម្ភៃដុល្លារ ។
តើអ្នកអាចគិតអោយល្អិតល្អន់បានទេ ?
សុំទោស ប៉ុន្តែយើងមិនទទួលប្រភេទមូលប្បទានប័ត្រអ្នកដំណើរទេ ។
តើអ្នកអាចស្នើរសុំធនាគារទេខ្ញុំត្រូវទៅហើយ ?
ខ្ញុំត្រូវការលុយដែលផ្ញើពីប្រទេសជប៉ុន ។
តើអ្នកមានគណនីមួយទេ ?
តើខ្ញុំមានលុយដែលផ្ញើមកពីគណនីធនាគាររបស់ខ្ញុំនៅជប៉ុនទេ ?
ខ្ញុំមានលិខិតឆ្លងដែន មូលប្បទានប័ត្រ និងសាច់ប្រាក់ក្នុងនោះ ។
ខ្ញុំមិនច្បាស់ពីទីកន្លែងទេ ។
ខ្ញុំបានទុកវាចោលក្នុងឡានតាក់ស៊ី ។
ខ្ញុំបានទុកវាចោលក្នុងរថភ្លើង ។
ខ្ញុំមិនចាំថានៅកន្លែងណាទេ ។
ខ្ញុំគិតថាខ្ញុំបានទុកវាចោលលើកៅអី ។
តើប៉ូលីសនៅឯណា ? ខ្ញុំចង់រាយការណ៍ ។
ខ្ញុំត្រូវបានគេប្លន់កាបូបនៅមុខធនាគារ ។
សូមអភ័យទោស តើអ្នកអាចជួយខ្ញុំតេទៅប៉ូលីសបានទេ ?
ខ្ញុំត្រូវបានគេលួចកាបូបលុយតាមផ្លូវ ។
ខ្ញុំមានប្រហែលជាពីររយដុល្លារក្នុងនោះ ។
មានបុរសក្មេងៗពីរនាក់ ។
ខ្ញុំមានអារម្មណ៍មិនល្អ ហើយចង់ក្អួត ។
ខ្ញុំគ្មានចង់ញ៉ាំអ្វីទេ ។
ពេលខ្លះពោះរបស់ខ្ញុំឈឺ ។
ខ្ញុំមានជំងឺរ៉ាំរ៉ៃ ។
ខ្ញុំមានជំងឺរ៉ាំរ៉ៃ ។
ខ្ញុំមានជំងឺរ៉ាំរ៉ៃ ។
ខ្ញុំមានជំងឺរ៉ាំរ៉ៃ ។
ខ្ញុំមានជំងឺរ៉ាំរ៉ៃ ។
សូមអភ័យទោស សូមជួយតេហៅឡានពេទ្យមក ។
តើអ្នកអាចជូនខ្ញុំទៅមន្ទីរពេទ្យបានទេ ?
ដូចជាមានបញ្ហាអ្វី ?
វាដូចជាអ្នកមានជំងឺរលាកខ្នែងពោះវៀន ។
វាមិនគួរគប្បីចំពោះអ្នកទៅបន្តដំណើរទៀតទេ ។
តើទាំងធានារ៉ាប់រងធ្វើដំណើររបស់ខ្ញុំទេ ?
សូមអោយសំបុត្រពេទ្យមួយមកខ្ញុំ ។
តើអ្នកអាចសរសេរវេជ្ជបញ្ជាសំរាប់ខ្ញុំបានទេ ?
តើខ្ញុំអាចទទួលបានវេជ្ជបញ្ជាពេញនៅឯណា ?
ខ្ញុំត្រូវការថ្នាំខ្លះសំរាប់ជំងឺផ្ដាសាយ ។
សូមសរសេរបំញេញវេជ្ជបញ្ជា ។
តើខ្ញុំលេបថ្នាំនេះប៉ុន្មានដង ?
បីដងក្នុងមួយថ្ងៃ ក្រោយពេលបាយម្ដងៗ ។
មានឧបទ្ទវហេតុដ៏អាក្រក់មួយ ។
តើនឹងយូរប៉ុណ្ណាទៀតមុនយើងចាប់ផ្ដើម ?
យើងនឹងទៅដល់ទីនោះក្នុងពេលមួយម៉ោង ។
ជើងហោះហើរហ្សីអាអិលលេខប្រាំសូន្យបីនៅខែឧសភាថ្ងៃទីដប់ប្រាំ ។ ខ្ញុំបានធ្វើដំណើរទៅដល់ទីក្រុងតូក្យូ ។
តើខ្ញុំអាចទទួលបានការបង្វិលសងសំបុត្រនេះនៅឯណា ?
ខ្ញុំចង់លុបចោលការកក់ទុកការហោះហើរនៅថ្ងៃទីប្រាំខែឧសភា ហើយកក់មួយវិញនៅថ្ងៃទីប្រាំបួន ខែឧសភាវិញ ។
សុំពិនិត្យមើលសំរាប់ជើងហោះហើរហ្សីអាអិលទៅណារីតា ។
បាទ ។ តើខ្ញុំអាចសុំមើលលិខិតឆ្លងដែន និងសំបុត្ររបស់អ្នកបានទេ ?
តើខ្ញុំអាចចុះឈ្មោះនៅហ្នឹងសំរាប់ជើងហោះហើរហ្សីអាអិលទៅណារីតាបានទេ ?
តេទៅស្ថានីយ៍អគ្គិភ័យ ។
ខ្ញុំត្រូវការភួយមួយ ។
តើម៉ោងប៉ុន្មានយើងចុះចតនៅក្រុងឡុង ?
តើខ្ញុំអាចជិះរថយន្តប្រណិតសំរាប់សណ្ឋាគារហីលតុននៅឯណា ?
តើវាថ្លៃប៉ុន្មានទៅប៉ារីស ?
តើចំណតនេះនៅផ្លូវវ៉ល ?
តើអ្នកមានដឹងភោជនីយដ្ឋានល្អៗខ្លះនៅជិតនេះទេ ?
សូមប្រាប់ខ្ញុំពីកន្លែងដែលគួរអោយចាប់អារម្មណ៍ខ្លះៗក្នុងក្រុង ។
តើអាចកក់សំបុត្រមួយសំរាប់ការប្រគំតន្ត្រីបានទេ ?
ទេ ខ្ញុំកំពុងរកមើលកាបូបស្បែកមួយ ។
តើខ្ញុំអាចយកអានេះចេញបានទេ ?
តើកៅអីជាប់របៀងផ្លូវមិនអីទេ ?
តើខ្ញុំអាចសុំស្រាទំពាំងបាយជូរខ្លះបានទេ ?
តើអ្នកត្រូវការមួយណា សាច់គោរឺសាច់មាន់ ?
តើខ្ញុំអាចសុំស្រាវីស្គីបានទេ ?
តើអ្នកត្រូវការស្រាវីស្គីរបស់អ្នកបែបណាដែរ ?
សូមដាក់ទឹកកក ។
តើយូរប៉ុណ្ណាមុនយើងទៅដល់ស៊ីតនី ?
តើមានអ្នកណានិយាយភាសាជប៉ុនបានទេ ?
តើអ្នកអាចអោយខ្ញុំខ្ចីប៊ិចបានទេ ?
តើអ្នកនឹងស្នាក់នៅប៉ុន្មានថ្ងៃ ?
ប្រហែលជាពីរសប្ដាហ៍ ។
ប្រហែលមួយពាន់ដុល្លារ ។
យល់ព្រម ។ សុវត្ថិភាពក្នុងការធ្វើដំណើរ ។
ក្រុមហ៊ុនអាកាសចរណ៍ អាអិលម្ភៃប្រាំមួយ ពីប្រទេសជប៉ុន ។
ខ្ញុំបានចុះឈ្មោះវ៉ាលីសពីរហើយ ។
ខ្ញុំកំពុងស្នាក់នៅសណ្ឋាគារប៉ាលធីម៉ម ។
តើអ្នកអាចជួយតេមកខ្ញុំបានទេនៅពេលអ្នករកកាបូបរបស់ខ្ញុំបាន ?
ខ្ញុំមានស្រាអង្ករជប៉ុនមួយដប ។
តើអ្នកមានផ្លែឈើ រឺក៏ដើមឈើអ្វីខ្លះទេ ?
តើឡានក្រុងអាកាសយានដ្ឋានទៅផ្សារក្នុងទីក្រុងនៅឯណា ?
តើអ្នកអាចប្ដូរវាជាលុយដុល្លារបានទេ ?
តើខ្ញុំអាចប្ដូរលុយរាយខ្លះបានទេ ?
ខ្ញុំចង់បានការធ្វើដំណើរមើលទេសភាពមួយ ។
តើវាថ្លៃប៉ុន្មានសំរាប់កន្លះថ្ងៃ ?
សូមទៅកាន់អាកាសយានដ្ឋាន ។
តើវាថ្លៃប៉ុន្មានសំរាប់សណ្ឋាគារផាក ?
នេះគឺម្ភៃ ។ រក្សាការប្រែប្រួលហ្នឹង ។
តើឡានក្រុងមួយដែលទៅផ្សារក្នុងទីក្រុងនៅឯណា ?
តើអ្នកទៅផ្សារក្នុងទីក្រុងអត់ ?
ឡានក្រុងនេះត្រូវទេដែលទៅសូហូ ?
តើអ្នកឈប់នៅសណ្ឋាគារហីលតុន ?
សុំប្ដូរសំបុត្រ ។
សុំប្រាប់ខ្ញុំបានទេនៅពេលដែលយើងទៅដល់ទីនោះ ?
តើស្ថានីយ៍ឡានក្រុងសំរាប់ឡានក្រុងហ្ក្រេហាតនៅឯណា ?
តើម៉ោងប៉ុន្មានឡានក្រុងបន្ទាប់ចេញ ?
តើអ្នកឈប់នៅហ្នឹងយូរប៉ុន្មានហើយ ?
សុំផែនទីផ្លូវក្រោមដី ។
សុំប័ណ្ណប្រាំមក ។
តើខ្សែមួយណាដែលខ្ញុំគួរជិះដើម្បីឆ្ពោះទៅសួនសាធារណៈកណ្តាលក្រុង ?
តើនេះជាកន្លែងឡើងចុះសំរាប់ស្ថានីយ៍សោតហ្វេរីត្រូវទេ ?
តើមានប៉ុន្មានចំណតទៅហ្កេនសេនថឺ ?
តើចំណតនេះនៅផ្លូវវ៉ល ?
តើច្រកមួយណាសំរាប់ចំណត ?
តើម៉ោងប៉ុន្មានទើបរថភ្លើងដំបូងចេញ ?
សុំសំបុត្រតែទៅ វ៉ាសេនតោន ឌីស៊ី ពីរសន្លឹក ។
ខ្ញុំត្រូវការកក់កៅអីមួយទៅស៊ីតថល ។
ខ្ញុំត្រូវការកន្លែងដេកខាងលើនៃនាវា ។
ខ្ញុំត្រូវការកន្លែងដេកខាងក្រោមនៃនាវា ។
សុំសំបុត្រដំណើរកំសាន្ដជុំវិញ វ៉ាសេនតោន ឌីស៊ី ពីរសន្លឹក ។
តើប្រើពេលយូរប៉ុន្មានទៅស៊ីតថល ?
នេះគឺជារថភ្លើងទៅប៊ូសតុន ?
សួស្ដី ។ ខ្ញុំមានការកក់មួយ ។
ឈ្មោះរបស់ខ្ញុំគឺ ណាកាមឹរ៉ា ។
ខ្ញុំត្រូវការជួលឡានទំហំលម្មមួយដែលមានទ្វាបួន ។
តើអ្នកមានបណ្ណ័ឥនទានទេ ?
តើអ្នកនឹងបើកបរយូរប៉ុនណាទៀត ?
សំរាប់ប្រាំមួយថ្ងៃ ។
តើអ្នកពេញចិត្តធានារ៉ាប់រងរបស់អ្នកយ៉ាងម្ដេចដែរ ?
តំលៃដែលធ្លាក់ហ្នឹងប៉ុន្មាន ?
តើខ្ញុំទាក់ទងក្នុងករណីបន្ទាន់នៅឯណាបាន ?
តើខ្ញុំទៅដល់ហ្វីវ៉េ មួយ សូន្យ មួយដោយរប្រៀបណា ?
តើខ្ញុំទៅដល់ឌីសនីសឡេនដោយរប្រៀបណា ?
សុំចាក់សាំង១០ដុល្លារ ។
តើខ្ញុំប្រើស្នប់នេះយ៉ាងម៉េចទៅ ?
នេះជាលុយអាប់របស់អ្នក ។ អរគុណ ។
អ្នកបានអោយអាប់លុយអោយខ្ញុំខុសហើយ ។
ខ្ញុំបានចាក់សាំង១០ដុល្លារហើយ ។
សុំឈ្មោះរបស់អ្នក និងលេខជើងហោះហើរ ?
ឈ្មោះរបស់ខ្ញុំគឺ ហ្កូរ៉ុ តាកាដា ។
ខ្ញុំកំពុងជិះយន្តហោះលេខដប់ពីរទៅទីក្រុងតូក្យូ ។
ខែឧសភាថ្ងៃទីដប់បី ។ ម៉ោងចេញដំណើរគឺ ដប់មួយសាមសិបនាទីពេលព្រឹក ។
តុក្រុមហ៊ុនអាកាសចរណ៍ អាអិលនៅឯណា ?
តើអ្នកមានកាបូបមួយសំរាប់ពិនិត្យទេ ?
បាទ កាបូបទាំងពីរនេះ ។
តើអ្នកត្រូវការកៅអីជក់បារី រឺកៅអីមិនជក់បារី ?
សូមយកកន្លែងមិនជក់បារី ។
តើអ្នកត្រូវការកៅអីជាប់បង្អួច រឺកៅអីជាប់របៀងផ្លូវដើរ ?
ខ្ញុំត្រូវការបន្ទប់មួយគ្រែពីរ ។ តើបន្ទប់ហ្នឹងតំលៃប៉ុន្មានក្នុងមួយយប់ ?
ហាសិបដុល្លារក្នុងមួយយប់ទាំងពន្ធអាករ ។
តើខ្ញុំអាចមានឈ្មោះរបស់អ្នក និងលេខទូរស័ព្ទបានទេ ?
ខ្ញុំឈ្មោះ យឹសឹកិ តាណាកា ឥឡូវខ្ញុំកំពុងតេចេញពីអាកាសយានដ្ឋានទៅ ។
មិនអិទេ ។ អរគុណសម្រាប់ទូរសព្ទមក ។
តើខ្ញុំអាចកក់សណ្ឋាគារទីនេះបានទេ ?
ខ្ញុំចង់បានបន្ទប់ភ្លោះ មានតម្លៃក្រោម២០ដុល្លារមួយយប់ ។
សម្រាប់ពីរយប់មួយថ្ងៃ ។
តើអ្នកមានឡានមកទទួលដែរទេ ?
ខ្ញុំឈ្មោះ ខែនឈិ តាខេដា ។
សូមបំពេញបែបបទ ហើយស៊ីញ៉េកន្លែងនេះ ។
តើអ្នកចង់បានបន្ទប់បែបណាដែរ ?
សូមបន្ទប់មានគ្រែពីរ ។
តើអ្នកបន្ទប់ថោកជាងនេះដែរទេ ?
តើអ្នកអាចជញ្ជូនអីវ៉ាន់ខ្ញុំឡើងលើបានទេ ?
តើនៅពេលណាដែលយើងពិនិត្យក្រៅម៉ោង ?
យើងត្រូវការកូនសោពីរ ។
តើអ្នកអាចត្រឡប់មកបន្តិចទៀតនេះបានទេ ?
នេះបន្ទប់លេខ ២ ០ ១ ។ ខ្ញុំចង់ធ្វើការកុម្ម៉ង់អាហារពេលព្រឹកស្អែក ។
ខ្ញុំចង់ញ៉ាំសាច់គោអាំងក្រូចឆ្មា និងកាហ្វេ ។
ខ្ញុំចង់បានទឹកកកដុំ ហើយនឹងទឹកត្រជាក់ ។
សូមយកស៊ុបជូនខ្ញុំ ។
ខ្ញុំចង់អ្នកទូរសព្ទដាស់ខ្ញុំនៅព្រឹកស្អែក ។
នៅម៉ោងមប្រាំមួយសាមសិបនាទី ព្រឹក ។
តើអ្នកជួយលើកឡើងបានដែរទេ ?
ខ្ញុំត្រូវការនៅម៉ោងបួនល្ងាច ។
ខ្ញុំនឹងទូរស័ព្ទទៅវិញនៅពេលក្រោយ អរគុណ ។
តើអ្នកទទួលនូវសាររបស់ខ្ញុំហើយនៅ ?
តើអ្នកប្រាប់គាត់ទូរសព្ទទៅអ៊ីឈីហារ៉ា នៅសណ្ឋាគារផាក នៅបន្ទប់លេខពីរ អូ មួយហើយនៅ ?
ខ្ញុំទូរសព្ទទីក្រុងតូក្យូ ប្រទេសជប៉ុន ។ តើខ្ញុំអាចទូរសព្ទទៅផ្ទាល់បានដែរទេ ?
បន្ទប់លេខពីរ សូន្យ បួន ។ ក្តៅនេះមិនដំណើរការទេ ។
ខ្ញុំបានចាក់សោបន្ទប់របស់ខ្ញុំ ។
ទូរទស្សន៍នេះមិនដំណើរការទេ ។
តើខ្ញុំអាចសុំកូនសោបន្ទាប់របស់ខ្ញុំបានទេ ?
តើបង្អួចនៅទល់មុខនោះបើកដែរទេ ?
តើអ្នកមាននរណាម្នាក់ដែលអាចនិយាយភាសាជប៉ុនបានដែរទេ ?
តើផ្សារដែលជិតជាងគេនៅកន្លែងណាដែរ ?
តើមានឡានទេសចរណ៍ដែរទេ ?
តើអ្នកអាចជួយបន្ទប់នូវជើងហោះហើររបស់ខ្ញុំម្តងទៀតបានដែរទេ ?
ខ្ញុំស្នាក់នៅទីនេះមួយយប់ទៀត ។ តើខ្ញុំអាចនៅបានទេ ?
តើវានឹងមកដល់ប្រញាប់ដែរទេ ?
តើអ្នកអាចហៅឡានតាក់ស៊ីនៅម៉ោងប្រំាមួយព្រឹកបានដែរទេ ?
តើឆ្ងាយប៉ុណ្ណាសម្រាប់ធ្វើដំណើរទៅព្រលាយន្តហោះជេអេហ្វខេដោយតាក់ស៊ី ?
តើម៉ោងប៉ុន្មានខ្ញុំចេញដំណើរពីទីនេះប្រសិនបើខ្ញុំជិះតាក់ស៊ី ?
តើអ្នកបានញ៉ាំអ្វីខ្លះដែរទេនៅក្នុងទូរទឹកកក ?
ខ្ញុំមិនបានផឹកស្រាបៀរ៍ទេ ។
តើអ្នកចង់បង់លុយសុទ្ធ ឬក៏កាតឥណទាន ?
ខ្ញុំបានភ្លេចរបស់នៅក្នុងបន្ទប់របស់ខ្ញុំ ។
តើខ្ញុំអាចត្រឡប់ទៅរកមើលបានទេ ?
តើអ្នកអានណែនាំខ្ញុំនូវភោជនីយដា្ឋននៅជិតនេះបានដែរទេ ?
តើទីនេះមានភោជនីយដ្ឋានដែរទេ ?
តើនេះជាភោជនីយដា្ឋនដែលមានតម្លៃថ្លៃមែនទេ ?
ខ្ញុំចង់កក់អាហារសម្រាប់មនុស្សបីនាក់នៅម៉ោងប្រំាបួនយប់នេះ ។
អ្នកមិនត្រូវការកក់អ្វីទេ ។ អ្នកមកបានគ្រប់ពេល ។
ខ្ញុំសុំទោស ប៉ុន្តែវាពេញគ្រប់ពេលទំាងអស់ ។
ខ្ញុំចង់ធ្វើការកក់នៅម៉ោងប្រាំពីរនេះ ។
ប្រសើរណាស់ ខ្ញុំនឹងមកម្តងទៀត ។
សុំទោស ប៉ុន្តែតុទំាងអស់ពេញ ។ តើចង់ចង់នៅរង់ចំាដែរទេ ?
ខ្ញុំគិតថាប្រហែលជា២០នាទីទៀត ។
អូខេ ។ យើងនៅរង់ចំានៅក្នុងបារ៍ ។
តើខ្ញុំញ៉ាំអាហារពេលនេះបាន ?
ខ្ញុំចង់ញ៉ាំបាយពេលល្ងាចនៅលើដំបូល ។
នៅមានមនុស្សម្នាក់ទៀតមកញ៉ាំជាមួយយើងយឺតបន្តិច ។
តើខ្ញុំមើលពិធីជប់លៀងរបស់ខ្ញុំបានទេ ?
តើអ្នកត្រូវការអ្វីពិសាបានដែរទេ ?
ខ្ញុំចង់បានស្រាមួយកែវញ៉ាំ ។
តើខ្ញុំអាចសុំអាហារដូចតុនោះបានដែរទេ ?
យើងមានម្ហូបអីតាលី បារំាង និងឈីសខៀវ ។
ខ្ញុំញ៉ាំម្ហូបអីតាលី ។
តើខ្ញុំអាចសុំទឹកមួយកែវបានដែរទេ ?
តើខ្ញុំអាចសុំនំប៉័ងបានដែរទេ ?
គ្រប់យ៉ាងនៅល្អប្រសើរ ។
តើយីហ៊ោអ្វីដែរ ?
តើអ្នកញ៉ាំអាហារសម្រន់ហើយនៅ ?
តើអ្នកមានស្រាក្រឡុកពិសេសដែរទេ ?
តើកន្លែងណាខ្ញុំអាចពិនិត្យបាន ?
តើអ្នកប្ដូរតម្លែនេះទៅបន្ទប់របស់ខ្ញុំបានទេ ?
ខ្ញុំចង់យកចេញ ។
ហំាបឺហ្គឺពីរ ហើយកូកាកូឡាពីរដប ។
តើជាន់មួយណាសក់សម្លៀកបំពាក់បុរស ?
តើកន្លែងលក់អាចស្ត្រីនៅទីណា ?
ទេ ខ្ញុំគ្រាន់តែមើលទេ ។
បាទ ខ្ញុំរកមើលអាវធំ ។
តើអ្នកមានរូបថតដែរទេ ?
តើនៅពេលណាអ្នកបិត ?
ខ្ញុំមិនចូលចិត្តម៉ូដនេះទេ ។
តើអ្នកមានអ្វីផ្សេងទៀតក្រោម៨០ដុល្លារទេ ?
សូម២០ដុល្លារ ។
តើអ្នកអាចបញ្ចុះតម្លៃឱ្យខ្ញុំបានដែរទេ ?
តើទំាងអស់នេះរាល់ថ្ងៃទំាងអស់របស់អ្នក ?
ខ្ញុំសុំទោស ។ ខ្ញុំនឹងមកបន្តិចទៀត ។
តើខ្ញុំអាចប្រើកាតធ្វើដំណើរបានដែរទេ ?
តើខ្ញុំអាចសុំមើលអត្តលេខបានដែរទេ ?
តើអ្នកអាចបង្ហាញខ្ញុំក្រវិលទីពីរនៅខាងឆ្វេងដែបានដែរទេ ?
សូមខ្ចប់មួយនេះដូចជាកាដូ ។
តើខ្ញុំអាចប្រើអាវធំនៅក្បែរបង្អួចបានទេ ?
តើកន្លែងលក់អាវទីណាដែរ ?
ខ្ញុំចូលចិត្ត ប៉ុន្តែតូចពេកសម្រាប់ខ្ញុំ ។
តើអ្នកមានទំហំធំជាងនេះបន្តិចទេ ?
នេះដូចជាសមណាស់ហើយ ។
តើអ្នកមានពណ៌ផ្សេងសម្រាប់អាវចាក់ដែរទេ ?
តើអ្នកអាចបញ្ចូលទំហំចំហៀងសម្រាប់ខ្ញុំបានដែរទេ ?
តើថ្លៃប៉ុន្មានសម្រាប់ការកែច្នៃបន្ថែម ?
ខ្ញុំជូនអ្នកមួយរយដុល្លារជាស្ហៀក ។
ទំហំនេះមិនត្រូវនឹងខ្ញុំទេ ។
ខ្ញុំចង់មើលម៉ូដែលថ្មីរបស់ភាពយន្តនេះ ។
តើអ្នករឿងចុងក្រោយបង្អស់ជារឿងអ្វី ?
តើមានរោងភាពយន្តនៅជុំវិញទីនេះដែរទេ ?
តើរឿងសំខាន់របស់ភាពយន្តចិនជាអ្វី ?
ខ្ញុំចង់ទៅមើលការប្រគំតន្ត្រីរ៉កនៅយប់នេះ ។
តើវានៅកន្លែងណាដែរ ?
តើយើងអាចដើរទៅទីនោះបានទេ ?
យើងចង់អង្គុយជាមួយគ្នា ។
ខ្ញុំចង់អង្គុយនៅក្នុងវង់តន្ត្រីនោះ ។
តើអ្នកអាចប្រាបខ្ញុំបានទេកន្លែងដូរសំបុត្រនៅទីណា ?
តើអ្នកប្រាប់ខ្ញុំបានទេកៅអីខ្ញុំនៅត្រង់ណា ?
តើបន្ទប់ទឹកនៅទីណា ?
តើអ្នកអាចណែនំាងខ្ញុំពីក្លឹបល្អមួយបានដែរទេ ?
តើមានក្លឹបកម្សាន្តនៅជុំវិញទីនេះទេ ?
តើខ្ញុំអាចញ៉ាំទីនេះបានទេ ?
ប្រាក់នេះដប់ដុល្លារបានហើយ ។
២០ភាគដួប ដុល្លារ ។
៥០ដុល្លារសម្រាប់ឆីបមួយនេះ ។
ខ្ញុំចង់ចាយលុយ ។
ដាក់កាក់របស់ខ្ញុំ ។
តើកន្លែងណាខ្ញុំធ្វើកក់សំបុត្រសម្រាប់មើលការសម្តែងនៅយប់នេះ ?
តើមានទូកសម្រាប់ជិះកម្សាន្តទីក្រុងទេ ?
តើអ្នកមានលិខិតបណ្ណសម្រាប់ដំណើរកម្សាន្តទេ ?
ខ្ញុំចង់ជិះដើរកម្សាន្តនៅជុំវិញទីក្រុង ។
តើខ្ញុំអាចកក់សម្រាប់ដំណើរកម្សាន្តជុំវិញទីក្រុងដែរទេ ?
តើដំណើរកម្សាន្តប្រភេទណាអ្នកបើកបម្រើការ ?
តើអ្នកមានដំណើរកម្សាន្តមួយថ្ងៃទេ ?
តើមានដំណើរកម្សាន្តពេលរសៀលដែរទេ ?
តើដំណើរកម្សាន្តផ្សេងទេដែលធ្វើដំណើរមើលជុំវិញពិភពលោក ?
តើមានអ្វីខ្លះដែលបូកបញ្ចូលជាមួយតម្លៃនេះ ?
តើកម្សាន្តចាប់ផ្តើមនៅពេលណា ?
តើម៉ោងប៉ុន្មានអ្នកត្រឡប់មក ?
តើដំណើរកម្សាន្តយូរប៉ុណ្ណា ?
តើកន្លែងណាយើងជិះឡានបាន ?
យើងជូនអ្នកទៅសណ្ឋាគារពេលនេះ ។
តើកន្លែងណា ហើយម៉ោងប៉ុន្មានយើងអាចរង់ចំាអ្នក ?
តើខ្ញុំអាចចុះនៅសណ្ឋាគារបានដែរទេ ?
តើខ្ញុំអាចកក់កន្លែងវាយកូនហ្គោលបានដែរទេ ?
តើពេលណាអ្នកចង់លេង ?
ខ្ញុំចង់ទៅលេងទឹក ។
តើកន្លែងណាដែលខ្ញុំអាចដាក់ពាក្យទៅសាលារៀនហែលទឹកបាន ?
តើអ្នកអាចបង្ហាញខ្ញុំនូវកម្មវិធី និងបញ្ជីតម្លៃបានទេ ?
ខ្ញុំចង់សិក្សានៅវគ្គនេះ ។
ខ្ញុំរៀនដំបូងនូវការហែលទឹក ។
តើអ្នកមានផែនទីជិះស្គីនៅជុំវិញនេះដែរទេ ?
តើមួយណាដែលជាវគ្គដំបូងនូវវគ្គនេះ ?
តើអ្នកអាចប្ដូរស្បែកជើងបន្តិចបានដែរទេ ?
តើអ្នកអាចដូរស្បែកជើងកវែងនេះទំហំតូចបានទេ ?
ខ្ញុំនឹងរៀននូវវគ្គជិះស្គីនេះ ។
ខ្ញុំធ្វើការកក់នូវកន្លែងលេងទិន្តិស្តនៅម៉ោង ១០ រយៈពេលពីរម៉ោង ។
តើខ្ញុំអា ចជួយលនូវរ៉ាកែតបានទេ ?
ខ្ញុំដូចជាមានអារម្មណ៍វិលមុខបន្តិច ។
ខ្ញុំឈឺកខ្លំាងណាស់ ។
ខ្ញុំមានប្រវត្តិ ។
តើរោគវិនិច្ឆ័យរបស់អ្នកជាអ្វីដែរ ?
អ្នកប្រហែលជាផ្តាសសាយ ។
អ្នកគ្រាន់តែចូលនូវមន្ទីរពេទ្យរបស់ខ្ញុំអ្នកជាសះស្បើយ ។
អ្នកមានកិច្ចសហប្រតិបត្តិការមួយ ។
តើអ្នកមានថ្នំាបាត់ឈឺពោះដែរទេ ?
ញ៉ាំម្តងមួយគ្រាប់សម្រាប់បីពេលក្នុងមួយថ្ងៃក្រោយពេលបាយ ។
តើអ្នកហៅប៊ូលីសបានដែរទេ ?
លិខិតឆ្លងដែននិងលុយរបស់ខ្ញុំនៅក្នុងនោះ ។
តើអ្នកអាចហៅខ្ញុំ ប្រសិនបើអ្នករកកាបូបឃើញ ?
ខ្ញុំចង់បាននូវក្រណាត់ពណ៌ក្រហម ។
តើអ្នកអា ចជួយយកកែវទឹកជូនខ្ញុំបានដែរទេ ?
តើខ្ញុំអាចញ៉ាំហំាបឺហ្គឺរបានទេ ?
តើខ្ញុំអាចយកនូវភួយផ្សេងទៀតបានដែរទេ ?
តើអ្នកខ្ញុំអាចខ្ចីបិចបានដែរទេ ?
តើខ្ញុំអាចប្រើទូរសព្ទនេះបានដែរទេ ?
តើមានការិយាល័យប្រៃយណីនៅជិតនេះទេ ?
តើមានភោជនីយដា្ឋននៅក្នុងសណ្ឋាគារដែរទេ ?
តើអ្នកអ្នកមានការ៉េមដែរទេ ?
តើអ្នកមានដំណើរកម្សាន្តកន្លះថ្ងៃដែរទេ ?
តើរថភ្លើងនឹងមកដល់ម៉ោងប៉ុន្មានដែរ ?
តើចំណតហ្គាសនៅទីណា ?
សូមប៊ិបស៊ីដបធំពីរដប ។
សូមប្រហិតតូចមួយផង ។
តើខ្ញុំអាចសុំនំភីហ្សាធំមួយបានទេ ?
ខ្ញុំចង់បានតូកូខ្នាតកណ្តាលចំនួនបី ។
រីករាយដែលបានជួបអ្នកដូចគ្នា ។
ខ្ញុំសុំទោស ប៉ុន្តែខ្ញុំមិនបានប៉ះអ្នកទេ ។
សុំទោស សម្រាប់ការរំខានអ្នក ។
តើអ្នកធ្វើដំណើរទៅរដ្ឋឡូអាន់ជឺឡែសផងមែនទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំនៅកៅអីខ្ញុំនៅកន្លែងណា ?
តើខ្ញុំអាចប្ដូរទៅកន្លែងដែលគ្មានការជក់បារីបានដែរទេ ?
តើអ្នកអាចដូរកន្លែងអង្គយជាមួយខ្ញុំបានដែរទេ ?
តើខ្ញុំអាចជួយអ្នកកាន់កាបូបានទេ ?
ខ្ញុំចង់ញ៉ាំស្រាវិស្គី ។
តើប្រភេទអ្វីដែលអ្នកមានហើយមានការពេញនិយមជាងគេ ?
អត់ទេ ស្គត់ និងទឹក ។
តើខ្ញុំអាចសុំកាហ្វេមួយកែវបានដែរទេ ?
តើអ្នកចង់ពិសាកាហ្វេទេ ?
ខ្ញុំមានគ្រប់គ្រាន់ហើយ ។ អរគុណ ។
ខ្ញុំមិនទាន់មានអារម្មណ៍ពេលនេះទេ ។
តើខ្ញុំអាចញ៉ាំពេលក្រោយបានទេ ?
តើខ្ញុំអាចញ៉ាំអាហារពេលនេះបានទេ ? ខ្ញុំមិនទាន់បានញ៉ាំពីមុនទេ ។
តើខ្ញុំអាចទុកពែងកាហ្វេទីនេះបានទេ ?
តើអ្នកមានក្រដាសផ្សេងទៀតរបស់ជប៉ុនដែរទេ ?
តើប៉ុស្តិ៍មួយណាដែលទូរទស្សន៍លេង ?
តើជាភាសារបស់ជប៉ុនមែនទេ ?
តើខ្ញុំអាចសាកនូវក្រវិលនេះបានដែរទេ ?
សុំអធ្យាស្រ័យ ខ្ញុំមានអារម្មណ៍ដូចជាឈឺ ។
តើខ្ញុំអាចសុំលិខិតបញ្ជាក់អតិថិជនបានដែរទេ ?
តើអ្នកជួយខ្ញុំបំពេញនូវលិខិតនេះបានដែរទេ ?
តើខ្ញុំអាចខ្ចីប៊ិបានដែរទេ ?
តើម៉ោងក្នុងតំបន់ទីក្រុងញូវយ៉កម៉ោងប៉ុន្មានហើយ ?
តើអ្នកស្នាក់នៅទីនោះយូរប៉ុណ្ណាដែរ ?
អូខេ ។ រីករាយការស្នាក់នៅរបស់អ្នក ។
តើកន្លែងណាខ្ញុំអាចយកកាបូបរបស់ខ្ញុំ ជើងហោះហើរលេខ២១បាន ?
វាលិសរបស់ខ្ញុំបាត់ ។
ជើងហោះហើរជេអេអែលលេខ២១មកពីតូក្យូ ។
តើអ្នកមានបិតឈ្មោះនៅលើដែរទេ ?
សូមទូរសព្ទមកខ្ញុំនៅសណ្ឋាគារពេលអ្នករកឃើញ ។
សូមលិខិតបញ្ជាក់អតិថិជន ។
សូមបង់តម្លៃលើពន្ធសម្រាប់ផលិតនៅទីនោះ ។
ខ្ញុំត្រូវឆ្លងកាត់ទីនេះ ។
តើខ្ញុំអាចដូរលុយនៅកន្លែងណាបានទេ ?
តើអ្នកអាចដូចលុយយ៉េនជាលុយដុល្លារបានដែរទេ ?
តើអ្នកអាចដូរលុយយ៉េនជានៅក្នុងអត្រាប្រាក់ក្នុងតំបន់ ?
តើអ្នកត្រូវការដូរលុយចំនួនប៉ុន្មានដែរ ?
ហាសិបពាន់យ៉េន ។
តើនៅក្នុងវិក្ក័យរបស់អ្នកប៉ុន្មានដែរ ?
តើខ្ញុំអាចជួយកាត់វាលិបានទេ ?
អរគុណ ។ ទំាងនោះត្រូវយកទៅឡានតាក់ស៊ីឈប់នោះ ។
ខ្ញុំអាចគ្រប់គ្រងពួកវាដោយខ្លួនខ្ញុំបាន ។
តើថ្លៃប៉ុន្មានសម្រាប់ការធ្វើសម្រាកនៅអូលីដេអិនដោយតាក់ស៊ី ?
តើកន្លែងណាខ្ញុំអាចជិះឡានទៅទីក្រុងបាន ?
តើទីនោះកន្លែងជិះឡានពីអូលីដេអិនមែនទេ ?
តើថ្លៃប៉ុន្មានសម្រាប់ការហៅទូរសព្ទរយៈពេលយូ ?
តើអ្នកអាចប្រញាប់ទៅស្ថានីយ៍កណ្តាលបានទេ ?
តើថ្លៃប៉ុន្មានសម្រាប់ទៅហ្គាណេហ្គី ហ៊ល ?
តើអ្នកអាចដាក់កាបូបនៅខាងក្រោយបានទេ ?
សូមបត់ស្តាំ នៅផភ្លើងស្តប់ខាងបន្ទាប់នោះ ។
តើឡាននៅខាងស្តំាងដៃទៅរដ្ឋឡូអាន់ជឺឡែសមែនទេ ?
តើចំណតជិតជាងគេទៅកាន់ផ្សាររបស់ហ្វាមមើលនៅឯណា ?
ប្រាំដុល្លារសម្រាប់កាតឥណទាន ។
តើអ្នកមានតារាងធ្វើដំណើររបស់រថភ្លើងក្រោមដីដែរទេ ?
តើរថភ្លើងនោះធ្វើដំណើរទៅទីក្រុងអូញៀនដែរទេ ?
ខ្ញុំចង់ជួលឡានមួយសម្រាប់រយៈពេលបីថ្ងៃ ។
យើងមានឡានម៉ាកតូយូតាម៉ាហ្សីម៉ាទំនេរ ។
ខ្ញុំចង់បានឡានខ្នាតកណ្តាលមួយ ។
ខ្ញុំចង់បានទំហំធំល្មម ។
ខ្ញុំចង់បានឡានល៊ុហ្សារី ។
តើអ្នកមានម៉ូស្ទាំង ?
ខ្ញុំចង់បានឡានមានចង្កឹះលេខដែ ។
តើតម្លៃមួយថ្ងៃថ្លៃប៉ុន្មានដែរ ?
តើខ្ញុំអាចសុំបញ្ជីតម្លៃបានដែរទេ ?
ខ្ញុំចង់បាននូវការធានារាប់រង ។
សូមបំពេញនៅស៊ុពើអាន់លែត ។
ជើងហើរជេអេអេលលេខ ប្រំា ទៅតូក្យូនៅថ្ងៃទី៣ ថ្ងៃចន្ទ ។
តើថ្លៃប៉ុន្មានសម្រាប់ការបង់លើទម្ងន់លើសនេះ ?
សូមយកកៅអីផ្នែកជក់បារី ។
តើច្រកចេញលេខពីរនៅកន្លែងណា ?
សូមបន្ទប់ភ្លោះពីរ ។
សូមបន្ទប់គ្រែពីរ ។
តើអ្នកមានបន្ទប់ទំនេរសម្រាប់យប់នេះ ?
ខ្ញុំចង់ស្នាក់នៅសណ្ឋាគារដែលនៅជិតទីក្រុង ។
ខ្ញុំចង់បានបន្ទប់មានទេសភាពមាត់សមុទ្រ ។
តើថ្ងៃណាដែលអ្នកចង់កក់ ?
ប្រហែលនៅថ្ងៃទីពីរ ។
ខ្ញុំចង់លុបចោលការកក់សម្រាប់ខែសីហាថ្ងៃទី២១ ។
តើអ្នកនឹងបង់ជាមួយលុយសុទ្ធ ឬក៏កាតឥណទាន ?
តើអ្នកយកប័ណ្ណវីសាទេ ?
តើអ្នកទទួលវិសាកាតដែរទេ ?
ខ្ញុំចង់ធ្វើការហៅនូវសេវាកម្មបន្ទប់ ។
តើខ្ញុំអាចអាចបោកគក់របស់ខ្ញុំនៅព្រឹកថ្ងៃស្អែកបានដែរទេ ?
តើអ្នកអាចទុកកូនសោបន្ទប់ខ្ញុំបានដែរទេ ?
តើអ្នកអាចរក្សារបស់មានតម្លៃខ្ញុំបានដែរទេ ?
តើអ្នកមានសេវាកម្មសម្រាប់ថតចម្លងដែរទេ ?
តើអ្នកអាចជួយផ្ញើសំបុត្រនេះតាមអ៊ីម៉ែលបានដែរទេ ?
ខ្ញុំមានបញ្ហាមួយ ។
នៅក្នុងបន្ទប់របស់ខ្ញុំមានទឹកក្តៅទេ ។
ម៉ាស៊ីនត្រជាក់នេះមិនដំណើរការទេ ។
ទូរទឹកកក់នេះមិនដំណើរការទេ ។
ទូរទស្សន៍អត់ដើរ ។
តើអ្នកប្រាប់ពួកគេឱ្សស្ងាត់បានដែរទេ ?
តើអ្នកអាចបញ្ចូននរណាម្នាក់មកទីនេះប្រញាប់បានដែរទេ ?
ខ្ញុំចង់ដូរបន្ទប់ខ្ញុំ ។
ខ្ញុំគិតមាននេះជាកំហុស ។
តើអ្នកអាចទុកកាបូបខ្ញុំរហូតដល់ម៉ោងប្រំា ?
អរគុណ ។ ខ្ញុំពេញចិត្តកន្លែងស្នាក់នៅណាស់ ។
តើមានភោជនីយដា្ឋនចិននៅជិតនេះដែរទេ ?
តើទីនោះមានតម្លៃសមរម្យដែរទេ ?
តើមានភោជនីយដា្ឋនជប៉ុននៅជិតនេះដែរទេ ?
តើមានភោជនីយដា្ឋនម៉ិកហ្សិកកូនៅជិតនេះដែរទេ ?
តើមានភោជនីយដា្ឋនអីតាលីនៅជិតនេះដែរទេ ?
តើមានភោជនីយដា្ឋនកូរេនៅជិតនេះដែរទេ ?
តើមានភោជនីយដា្ឋនវៀតណាមនៅទីជិតនេះដែរទេ ?
តើមានភោជនីយដា្ឋនបារំាងនៅជិតនេះដែរទេ ?
ខ្ញុំចង់ធ្វើការកក់សម្រាប់មនុស្សបីនាក់នៅម៉ោងប្រំាពីរយប់នេះ ។
ខ្ញុំចង់លុបការកក់របស់ខ្ញុំនៅយប់នេះ ។
ខ្ញុំឈ្មោះ សូហ្សូគិ ។ ខ្ញុំបានធ្វើការកក់នៅម៉ោងប្រាំមួយ ។
រាត្រីសួស្តី ។ តើអ្នកតុសម្រាប់មនុស្សពីរនាក់ទេ ?
នៅមានមនុស្សពីរនាក់ទៀតចូលរួមតែមកយឺតបន្តិច ។
តើអ្នកអាចយកអ្វីមកញ៉ាំបានដែរទេ ?
បាទ យើងចង់ស្រាក្រហមពីរដប ។
អត់ទេ អរគុណ ។ តើយើងអាចសុំទឹកពីរដបបានដែរទេ ?
មិនទាន់ទេ ។ តើអ្នកទុកពេលឱ្យយើងបន្តិចទៀតបានដែរទេ ?
តើទឹកម្ទេសត្រូវប្រតិកម្មជាមួយអ្វីដែរ ?
ខ្ញុំនឹងញ៉ាំឆ្អឹងខ្ចី សាច់គោអំាងសម្រាប់អាហារពេលល្ងាច ។
តើខ្ញុំអាចសុំម្ហូបដូចជាតុមួយនោះបានដែរទេ ?
រសជាតិឆ្ងាញ់ណាស់ ។
អាហាររបស់ខ្ញុំមិនទាន់បានទេ ។
ត្រីនេះចម្អិនដូចជាជ្រុលបន្តិច ។
ខ្ញុំអាចលើកចានចេញបានដែរទេ ?
ខ្ញុំសុំកាហ្វេ និងផ្លែប៉ោម ។
តើអ្នកខ្ញុំអាចញ៉ាំហាំបឺហ្គឺបានដែរទេ ?
សុំដំឡូងបារំាងចៀនចានធំមួយ ។
សូមប៊ិបស៊ីដបធំ ។
សូមសំាងវិចសាច់មាន់ជាមួយនិងស្ពៃខៀវ ។
សូមឆ្អិនល្មម ឬឆ្អិនល្អជាងនេះ ។
តើខ្ញុំអាចសុំភីហ្សាហាវ៉ាធំជាងនេះបន្ថែមទៀតបានទេ ?
តើកន្លែងលក់សម្លៀកបំពាក់ស្ត្រីនៅទីណាដែរ ?
តើជាន់ទីប៉ុន្មានកន្លែងលក់ស្បែកជើង ?
តើខ្ញុំអាចជួយអ្នកបានទេ ?
ខ្ញុំកំពុងរកមើលកាដូសំរាប់លោកយាយរបស់ខ្ញុំ ។
ខ្ញុំចង់បានតម្លៃក្រោម៥០ដុល្លារ ។
តើអ្នកកាន់នូវបឹបឺរី ?
ខ្ញុំសុំទោស ប៉ុន្តែនេះមិនជាគំនិតខ្ញុំទេ ។
ខ្ញុំនឹងមកម្តងទៀត ។ អរគុណគ្រប់យ៉ាង ។
ខ្ញុំចាយជាលុយសុទ្ធ ។
តើខ្ញុំអាចសុំមើលអត្តលេខអ្នកបានទេ ?
នេះជាលិខិតឆ្លងដែនរបស់ខ្ញុំ និងកាតឥណទាន ។
តើខ្ញុំអាចដូរវិញបានដែរទេ ?
វាដូចជារលុងបន្តិចនៅត្រង់ចង្កេះខ្ញុំ ។
សំពត់នេះដូចខ្លីពេក ។
តើអ្នកធ្វើឱ្យធំជាងនេះបន្តិចបានដែរទេ ?
តើអ្នកមានមួយនេះជាពណ៌ក្រហមដែរទេ ?
តើអ្នកមានមួយនេះជាពណ៌ខ្មៅដែរទេ ?
តើអ្នកមានមួយនពណ៌ខៀវដែរទេ ?
តើនេះជាត្បូងក្លែងមែនទេ ?
ពួកវាដូចជាធ្ងន់ពេក ។
វាសមជាមួយខ្ញុំណាស់ ។
តើអ្នកអាចយកមួយនេះបានដែរទេ ?
តើខ្ញុំសុំប្រអប់កាដូពីរបានដែរទេ ?
តើច្រកលក់សំឡីអនាម័យមួយណា ?
ច្រកលេខប្រំាពីរ ។
ក្រដាស់ ឬក៏ផ្លាស្ទិក ?
តើទីនោះផ្លូវតូចចង្អៀតណាស់មែនទេ ?
តើអ្នកមានដំណើរកម្សាន្តពេញថ្ងៃទេ ?
តើដំណើរកម្សាន្តនេះទៅហូលីវូដដែរទេ ?
តើខ្ញុំអាចកក់សម្រាប់ដំណើរកម្សាន្តទីក្រុងបានដែរទេ ?
យើងមកជួបជុំគ្នាទីនេះមួយម៉ោងទៀត ។
តើអ្នកអាចចុចចំណុចតូចនោះបានដែរទេ ?
តើពេលណាមានការសម្តែងជាបន្ទប់ទៀត ?
មនុស្សធំពីរនាក់ សម្រាប់ អី ធី ។
តើមានសំបុត្រសម្រាប់ការសម្តែងនៅយប់នេះដែរទេ ?
តើខ្ញុំអាចសុំកៅអីបីសំខាន់បានដែលទំនេរបានដែរទេ ?
តើអ្នកចង់បង់សំបុត្រនេះយ៉ាងដូចម្តេច ?
សូមបង់ជាម៉ាស្ទើកាតរបស់ខ្ញុំ ។
តើអ្នកបង្ហាញខ្ញុំ កៅអីខ្ញុំនៅទីណា ?
តើតន្ត្រីប្រភេទណាដែលពួកគេប្រគំនៅទីនេះ ?
តើនរណាជាអ្នកសម្តែងនៅយប់ថ្ងៃសុក្រនេះ ?
តើអ្នកមានអ្វីសម្រាប់នៅទីនេះដែរទេ ?
តើខ្ញុំអាចតម្លៃមួយរយដុល្លារសម្រាប់ហ្វុយស៊ីបនេះ ?
តើខ្ញុំដូរកន្លែងនេះបានទេ ?
ខ្ញុំចង់ថាមួយរយដុល្លារ ។
ខ្ញុំចង់ជួលកន្លែងពីរសម្រាប់លេងកូនហ្គោល ។
ខ្ញុំចង់រៀនមេរៀនជិះស្គី ។
តើកន្លែងណាខ្ញុំអាចទិញសំបុត្រចេញបាន ?
ខ្ញុំចង់បានស្គីខ្លីបន្តិច ។
តើខ្ញុំអាចដូរស្បែកជើងកវែងធំមួយគូនេះបានដែរទេ ?
តើខ្ញុំអាចប្ដូរស្បែកជើងកវែងតូចមួយគូនេះបានដែរទេ ?
តើនរណាដែលជាដៃគូប្រកួតជាមួយអង់ហ្គែលនៅយប់នេះ ?
កៅអីពីរនៅក្នុងខាងក្រៅ ។
កៅពីរនៅក្នុងប្រអប់នោះ ។
ខ្ញុំបានបាត់សំបុត្រយន្តហោះ ។
វីសាកាតរបស់ខ្ញុំត្រូវបានគេលួច ។
តើមានអ្វីខ្លះនៅក្នុងកាបូប ?
ខ្ញុំលុយប្រហែលជា៥០ដុល្លារនៃសុទ្ធ និងវិសាកាត ។
តើប្រហែលជាបាត់ និងទៅរកនៅក្នុងហាងមែនទេ ?
តើខ្ញុំរាយការណ៍ជូនប៉ូលិសបានដែរទេ ?
នរណាក៏បានជួយទួរប្រាប់ប៉ូលិសផង ។
ខ្ញុំបានគ្រោះថ្នាក់ចរាចរណ៍ ។
គ្មាននរណាម្នាក់ដែលមានប្រយោជន៍ ។
តើទូរសព្ទហៅឡានសង្គ្រោះបន្ទាន់បានទេ ?
តើខ្ញុំសុំមើលអាជ្ញបណ្ណបើកបរ និងការចុះឈ្មោះកាតបានដែរទេ ?
ខ្ញុំមិនពូកែនិយាយភាសាអង់គ្លេសទេ ។
តើខ្ញុំអាចសុំរបាការណ៍គ្រោះថ្នាក់បានដែរទេ ?
ខ្ញុំបែកកង់ហើយ ។
ខ្ញុំគិតថាខ្ញុំផ្តាសាយ ។
ខ្ញុំស្ថិតក្នុងពេលនេះ ។
ចង្កេះរបស់ខ្ញុំឈឺ ។
តើមានគ្រូពេទ្យនិយាយភាសាជប៉ុនដែរទេនៅក្នុងការិយាល័យរបស់អ្នក ?
ខ្ញុំមានអាល់ឡ័រហ្ស៊ីជាមួយថ្នាំអាស្ពៀរីន ។
តើខ្ញុំអាចសុំវិក្ក័យបត្តសម្រាប់អាជ្ញាបណ្ណបានដែរទេ ?
សូមយកវេជ្ជបញ្ញានេះទៅហ្វាម៉ាស៊ី ។
តើអ្នកបំពេញនូវវេជ្ជបញ្ជានេះសម្រាប់ខ្ញុំបានដែរទេ ?
សុភាពនារីឈ្មោះជូឌីបានទូរសព្ទមកខ្ញុំ ។
ទីនេះជាការបញ្ជាក់ពីលេខខ្ញុំ ។
ខ្ញុំនឹងយកអ្នក ។
តើបន្ទប់ទឹកនៅកន្លែងណា ?
ខ្ញុំមិនអាចអរគុណអ្នកគ្រប់គ្រាន់ទេ ។
សុំទោស ? ខ្ញុំសុំអភ័យទោសពីអ្នកបានទេ ?
ខ្ញុំនិយាយភាសាអង់គ្លេសតិចតួចទេ ។
ខ្ញុំមិនជឿវាទេ ។
ខ្ញុំមកពីប្រទេសជប៉ុន ។
ខ្ញុំឈ្មោះសាឆីកូ យ៉ាម៉ាម៉ូតូ ។
ខ្ញុំអាយុ២២ឆ្នាំ ។
សុំប្រាប់ខ្ញុំពីរបៀបប្រើវាបានទេ ។
តើអ្នកនឹងរក្សាវាក្នុងការបូបនេះទេ ?
តើអ្នកនឹងស្នាក់នៅចក្រភពអង់គ្លេសប៉ុន្មានថ្ងៃដែរ ?
តើអ្នកមានសំបុត្រយន្តហោះត្រឡប់ទៅវិញទេ ?
ខ្ញុំមានលុយ១០០០ផោន ។
វីសានេះមានរយពេល៦ខែ ។
តើកន្លែងណាដែលខ្ញុំអាចទទួលឥវ៉ាន់បាន ?
សុំដើរទៅត្រង់ ។
ទាំងនេះគឺជារបស់ប្រើប្រាស់ផ្ទាល់ខ្លួន ។
តើកន្លែងណាខ្ញុំអាចប្ដូរលុយបាន ?
តើអត្រាកម្រៃប៉ុន្មានដែលអ្នកនឹងផ្តល់ឲ្យ ?
សុំប្ដូរ២០ដុល្លារជាលុយផោន ។
តើអ្នកនឹងរួមបញ្ចូលទាំងការផ្លាស់ប្ដូរចំនួនតូចទេ ?
ខ្ញុំគិតថានេះជាការបូកខុស ។ វាមិនមែនចំនួនតូចទេ ?
តើមានធនាគារណាដែលបើកនៅថ្ងៃសៅរ៍ ?
សុំបំបែកជា៥ ១០ផែនស៍ ។
តើកន្លែងណាដែលយើងអាចកក់សណ្ឋាគារបាន ?
តើមានមណ្ឌលព័ត៌មានទេសចរណ៍នៅក្នុងព្រលានយន្តហោះទេ ?
តើចំណតឡានក្រុងសម្រាប់កណ្តាលក្រុងនៅកន្លែងណា ?
តើនៅប្រ៊ីទីសអ៊ែរវេនៅកន្លែងណាប្ដូរលុយ ?
សូមសួស្តីប៉ារីស ។
ខ្ញុំមានកាបូបអីវ៉ាន់ពីរ ។
តើខ្ញុំត្រូវការមានកាតចុះពីកប៉ាល់មែនទេ ?
តើកន្លែងណាខ្ញុំអាចទទួលកាតចុះពីកប៉ាល់បាន ?
តើនេះពិតជារថភ្លើងទៅប៉ារីសមែនទេ ?
ខ្ញុំអាចមានខ្នើយ១នឹងផួយ១បានទេ ?
តើទៅហ្វ្រង់ហ្វ័តប៉ុន្មានម៉ោង ?
សួស្តីនេះជាប្រ៊ីទីសអ៊ែរវេ ។
ថ្ងៃទី១៣ខែសីហា ។
តើជើងហោះហើរមួយណា ?
ជើងហោះហើរលេខ០២៤ទៅក្រុងតូក្យូ ។
យល់ព្រម ។ អ្នកបានបញ្ជាក់រួចហើយ ។
ខ្ញុំចង់ធ្វើឲ្យប្រាកដថាពេលណានឹងចាកចេញ ។
ពេលព្រឹកម៉ោង១១នឹង១៥នាទី ។
តើពេលណាខ្ញុំពិនិត្យចូលបាន ?
អ្នកត្រូវពិនិត្យចូលមិនលើស១ម៉ោងដំបូង ។
សួស្តីនេះគឺជប៉ុនអ៊ែរឡាញ ។
តើអ្នកមានសំបុត្រទេ ?
ថ្ងៃទី២៩ខែសីហា ។
ខ្ញុំសុំទោសនៅថ្ងៃទី២៩ខែសីហាកៅអីទាំងអស់ត្រូវបានគេយកអស់ហើយ ។
ខ្ញុំចង់ហោះហើរឆាប់ៗបើអាចទៅរួច ។
យើងអាចឲ្យអ្នក១កៅអីនៅថ្ងៃទី១៣ខែសីហា ។
ជើងហោះហើររបស់លេខ០២៤ចាកចេញនៅម៉ោង១១នឹង១៥នាទី ។
តើព្រលានយន្តហោះណាមួយខ្ញុំនឹងចាកចេញ ?
នៅព្រលានយន្តហោះហៀតត្រូចំណតលេខ៣ ។
សំបុត្រសម្រាប់តែទៅឫទៅមក ?
គ្មានការបញ្ចុះតម្លៃទេ ។
ខ្ញុំមានកាតនិសិត្ស ។
ខ្ញុំចង់ទៅញូវយ៉កនៅថ្ងៃស្អែក ។
តែម្នាក់ឯង ឫត្រឡប់មកវិញ ?
សុំសំបុត្រត្រឡប់មកវិញ ។
រថភ្លើងចាកចេញពីគីងក្រោស ។
នៅបង្អួចមួយណាដែលខ្ញុំអាចទិញសំបុត្រទៅខេមប្រ៊ីដបាន ?
តើកន្លែងណាខ្ញុំអាចទទួលបានសំបុត្របញ្ចុះតម្លៃសម្រាប់និសិត្ស ?
ខ្ញុំចង់ទៅកម្សាន្តនៅញូវយ៉ក់ លីវ័រផូលនឹងឆែសស្ទ័រ ។ តើអ្នកនឹងប្រាប់ខ្ញុំធ្វើរបៀបណាដែលថោក ?
តើរថភ្លើងថ្ងៃនេះដំណើរការទេ ?
ខ្ញុំចង់ទៅខេមប្រ៊ីនៅរសៀលនេះ ។ តើពេលណារថភ្លើងចេញដំណើរ ?
តើខ្ញុំអាចទៅនឹងត្រឡប់មកក្នុងថ្ងៃនេះបានទេ ?
តើពេលណារថភ្លើងខ្ញុំអាចជិតត្រឡប់មកវិញបាន ?
តើមាននៅខាងក្រោយទេ ?
ពីស្ថានីយមួយណាដែលរថភ្លើងចាកចេញ ?
ខ្ញុំចង់កក់កៅអីមួយកន្លែងទៅអេឌីប៊ឹក ។
តើទៅអេឌីប៊ឹកថ្លៃប៉ុន្មាន ?
សុំសំបុត្រជាន់ទី២មួយសន្លឹកទៅអេឌីប៊ឹក ។
សុំសំបុត្រថ្ងៃស្អែកសម្រាប់រថភ្លើងល្បឿនលឿនលេខ១២៥០ ។
សុំឡានមានផ្សែង ។
តើសំបុត្រត្រឡប់មកវិញពេលណាជាការល្អ ?
តើរថភ្លើងនេះទៅអេឌីប៊ឹកផ្ទាល់ទេ ?
តើជិះរថភ្លើងដេកទៅអេឌីប៊ឹកថ្លៃប៉ុន្មាន ?
ខ្ញុំចង់កក់រថភ្លើងដេកទៅអេឌីប៊ឹកសម្រាប់យប់នេះ ។
សុំជាន់លើបំផុត ។
តើពេលណាខ្ញុំអាចធ្វើការកក់បាន ?
ខ្ញុំចង់ធ្វើការផ្លាស់ប្ដូរការកក់របស់ខ្ញុំ ។
២សុំសំបុត្រជាន់ទី២មួយសន្លឹកទៅអេឌីប៊ឹក ។
សុំឡានគ្មានផ្សែង ។
ខ្ញុំចង់ចាប់ផ្តើមប្រើប្រាស់អឺរែលផាសថ្ងៃនេះ ។
តើអ្នកនឹងបិទតែមហើយសរសេរនៅលើនេះផង ?
ខ្ញុំចង់ចាប់ផ្តើមប្រើប្រាស់រយពេល២១ថ្ងៃពីថ្ងៃខានស្អែកទៅ ។
ខ្ញុំបាត់អឺរែលផាស ។
នេះជាកំណាត់ដែលនៅសល់ ។
តើអឺរែលផាសប្រើសម្រាប់រថភ្លើងនេះបានទេ ?
តើមានការបញ្ចុះតម្លៃសម្រាប់អឺរែលផាសដែលឈរទេ ?
តើកន្លែងណាខ្ញុំអាចប្ដូររថភ្លើងជិះទៅអេឌីប៊ឹកបាន ?
តើអ្នកនឹងសរសេរភ្ជាប់នៅត្រង់នេះមែនទេ ?
តើរយពេលប៉ុន្មានជិះទៅដល់អេឌីប៊ឹក ?
តើផ្លូវដែកណាសម្រាប់ទៅអេឌីប៊ឹក ?
នេះទៅអេឌីប៊ឹក ?
តើរថភ្លើងនេះឈប់នៅអេឌីប៊ឹកមែនទេ ?
តើឡាននេះទៅអេឌីប៊ឹកមែនទេ ?
តើប៉ុន្មាននាទីទៅដល់អេឌីប៊ឹក ?
អ្នកនឹងឃើញខ្ញុំពេលពួកយើងធ្វើដំណើរទៅដល់អេឌីប៊ឹក ?
ខ្ញុំបានបាត់កាបូបនៅលើរថភ្លើង ។
តើចំណតឡានក្រុងសម្រាប់ក្រុងអុកហ្វ័ដនៅឯណា ?
តើខ្ញុំអាចទិញសំបុត្រនៅលើឡានបានទេ ?
តើពេលណាឡានក្រុងអុកហ្វ័ដចេញដំណើរ ?
តើពេលណាឡាក្រុងបន្ទាប់ចេញដំណើរ ?
ខ្ញុំចង់ជួលឡានតូចល្មមមួយ ។
ខ្ញុំចង់ជួលឡានក្នុងប្រភេទអេ ។
ខ្ញុំចង់ជួលឡានរយពេល២៤ម៉ោង ។
តើខ្ញុំអាចចុះនៅអេឌីប៊ឹកបានទេ ?
សុំឲ្យកន្លែងខ្លះដើម្បីហៅក្នុងករណីមានបញ្ហា ។
សុំនៅក្នុងកាប៊ីន ។
សុំជាន់ទី១មួយសន្លឹកទៅខាលែស ។
សុំខាងក្រៅកាប៊ីន ។
តើនៅជាន់លើតែឯងថ្លៃប៉ុន្មាន ?
លើដំបូលនាវាល្អសម្រាប់ខ្ញុំ ។
តើអ្នកនឹងផ្លាស់ប្ដូរខ្ញុំទៅកាប៊ីជាន់ទី២មែនទេ ?
តើអ្នកនឹងឲ្យខ្ញុំនូវតារាងពេលវេលាមែនទេ ?
តើអ្នកជិះតាក់ស៊ីជាមួយខ្ញុំបានទេ ?
សុំទៅស្ថានីយវីទ័ររៀ ។
អត្រាកម្រិតខុសពីម៉ែត ។
តើតម្លៃទៅព្រលានយន្តហោះថ្លៃប៉ុន្មាន ?
តើអ្នកនឹងនាំខ្ញុំទៅឃេនទតឺប៊ឺរីហើយយកខ្ញុំមកវិញទេ ?
តើអ្នកនឹងរងចាំខ្ញុំកំឡុងពេលខ្ញុំទស្សនាវិហារទេ ?
សរុបជិះប៉ុន្មានម៉ោង ?
វាថ្លៃណាស់ ។ តើអ្នកចុះតម្លៃបានទេ ?
តើស្ថានីយនៅកន្លែងណាដែលជិតបំផុត ?
តើនៅក្រោមដីកន្លែងណាខ្ញុំអាចទិញសំបុត្របាន ?
ខ្ញុំទៅដោយជិះរថភ្លើងក្រោមដី ។
តើច្រកចេញមួយណាទៅត្រាហ្វាល់ហ្គឺស៊ែរ ?
តើផ្លូវអ្វីខ្ញុំគួរជិះទៅឡុងដ៏ថោវ័រ ?
ខ្ញុំចង់ទៅឡុងដ៏ថោវ័រដោយឡានក្រុង ។
តើនេះទៅឡុងដ៏ថោវ័រមែនទេ ?
តើអ្នកនឹងទៅទទួលខ្ញុំពេលដែលខ្ញុំទៅដល់មែនទេ ?
តើទៅឡុងដ៏ថោវ័រថ្លៃប៉ុន្មាន ?
ខ្ញុំសុំទោសខ្ញុំចង់ចុះនៅចំណតបន្ទាប់ ។
តើកន្លែណាខ្ញុំគួរប្ដូរឡានក្រុង ?
ខ្ញុំប្រហែលជាមានផែនទីផ្លូវក្រោមដី ?
ខ្ញុំសុំទោសតើកន្លែងនេះជាភីកាឌីលលីសៀខាស់មែនទែ ?
ខ្ញុំចង់ទៅឡុងដ៏ថោវ័រ ។
តើចម្ងាយប៉ុន្មានបើដើរពីទីនេះទៅឡុងដ៏ថោវ័រ ?
នេះទៅត្រង់មែនទេ ?
ទៅខាងស្តាំឫខាងឆ្វេង ?
ទៅមុខឲ្យត្រង់ ?
តើខ្ញុំបត់ខាងឆ្វេងមែនទេ ?
តើមានសញ្ញាដែលយើងអាចធ្វើតាម ?
បត់ឆ្វេងនៅកាច់ជ្រុងទី៣ ។
តើអ្នកមានសញ្ញានៅលើផែនទីទេ ?
តើខ្ញុំត្រូវបត់ខាងស្តាំមែនទេ ?
ខ្ញុំសុំទោសសុំផែនទីក្រុងមួយ ។
នេះកន្លែងអ្នកវានៅទំនេរ ។
តើខ្ញុំអាចទៅខេស្ទ័លដោយរបៀបណា ?
អ្នកអាចទៅត្រង់នោះដោយឡានក្រុងលេខ៨ ។
តើអ្នកនឹងប្រាប់ខ្ញុំពីកន្លែដែលចំណាប់អារម្មណ៍នៅក្រុងនេះ ?
ខ្ញុំចង់ទៅភីខាល់លីសៀកាស់ ។
តើអ្នកមានការប្ដូរម៉ូតូកង់បួនទេ ?
តើវីនស័រឃេសលបើកនៅរដូវកាលនេះទេ ?
តើវាបើកពេលណាហើយនឹងបិទពេលណា ?
តើមានកន្លែងផ្សេងដែលខ្ញុំអាចចូលទស្សនានៅក្រុងបាន ?
តើអ្នកនឹងស្នើសុំកន្លែងដែលខ្ញុំអាចទៅនឹងត្រឡប់មកវិញក្នុងថ្ងៃតែ១ ?
តើកន្លែងណាខ្ញុំអាចជិះទូកកម្សាន្តទីក្រុងបាន ?
តើបន្ទប់ជួលនៅម្តុំនេះដែលជិតបំផុតនៅឯណា ?
សុំសំបុត្រមួយសន្លឹកសម្រាប់និសិត្ស ។
តើមាននបន្ទប់បណ្តោះអាសន្នទែ ?
តើអ្នកមានសៀវភៅស្តើងទាក់ទងសារមន្ទីរទេ ?
តើអ្នកមានបោះពុម្ភសៀវភៅអង់គ្លេសទេ ?
តើអ្នកលក់កាតប្រៃសណីយ៍ទេ ?
តើយើងអាចជិះទៅបន្ទាយបានទេ ?
ជាដំណើរកម្សាន្តកន្លះថ្ងៃមែនទេ ?
ខ្ញុំប្រហែលជាមានសៀវភៅស្តើង១ក្បាល ?
អ្នកនឹងប្រាប់ខ្ញុំតើដំណើរកម្សាន្តមួយណាដែលពេញនិយម ?
តើកន្លែងណាខ្ញុំអាចកក់វាទុកបាន ?
ខ្ញុំចង់ចូលរួមដំណើរកម្សាន្តទៅស្តូនហែន ។
តើកន្លែណាពេលណាវាចាកចេញ ?
តើកន្លែងណាកំឡុងពេលណាយើងនឹងត្រឡប់មកវិញ ?
តើមានទេសចរណ៍ណាមួយដែលមគ្គទេសក៍និយាយភាសាជប៉ុនទេ ?
តើអ្នកមានដំណើរកម្សាន្តផ្សេងទេ ?
តើមានទេសចរណ៍ណាមួយដែលមគ្គទេសក៍និយាយភាសាអង់គ្លេសទេ ?
តើអ្នកមានកក់មគ្គទេសក៍សម្រាប់ព្រឹតិការណ៍ក្នុងនេះទេ ?
ខ្ញុំចង់ទៅមើលការប្រគំតន្ត្រីរ៉ក់ ។
តើអ្នកមានកៅអីឈរទេ ?
តើសំបុត្រថ្ងៃនេះនៅតែមានសុពលភាពមែនទេ ?
តើអ្នកមានការរងចាំជាប្រព័ន្ធទេ ?
តើថោកមួយនេះថ្លៃប៉ុន្មាន ?
សុំអាថ្លៃជាងនេះបានទេ ។
តើខ្ញុំអាចទៅផ្នែកខោខៅប៊យនឹងស្បែកជើងបានទេ ?
តើខ្ញុំអាចទៅផ្នែកសម្លៀកបំពាក់ដូចនេះបានទេ ?
តើស្អែកថ្ងៃអ្វី ?
តើតម្លៃមួយនេះថ្លៃប៉ុន្មានដែរ ?
តើខ្ញុំទៅរោងល្ខោនដោយរបៀបណា ?
តើពេលនេះជារឿងអ្វី ?
តើកន្លែងណាខ្ញុំអាចមើលរឿងបាន ?
ពេលណារឿងនេះចាក់បញ្ចាំង ?
តើម្តុំនេះមានហាងឌីស្កូទេ ?
តើអ្នកមានការសម្តែងផ្ទាល់ទេ ?
តើពួកគេលេងតន្ត្រីប្រភេទអ្វី ?
អ្នកស្អាតណាស់ ។
ខ្ញុំចង់ទៅមើលហ្គេមសូកគឺ ។
ខ្ញុំចង់ដឹងព័ត៌មានពីហ្គេមសូកគឺ ។
តើមានការជិះស្គីដែលមានទិដ្ឋភាពស្រស់ស្អាតបែបនេះទេ ?
តើចំណតឡានក្រុងហ្គ្រ៊ីនវ័លនៅឯណា ?
តើអ្នកគិតនឹងទៅថ្ងៃស្អែកល្អទេ ?
ខ្ញុំប្រហែលជាមានចំណោទផែនទី១ ?
តើកន្លែងណាខ្ញុំអាចជិះស្គីឡើងបាន ?
តើនៅហ្គ្រ៊ីនវ័លដ៏កន្លែងណាអាចលើកឡើងលើបាន ?
តើកន្លែងណាខ្ញុំអាចទិញសំបុត្រជិះពេញ១ថ្ងៃ ?
តើកន្លែងណាសម្រាប់ជិះស្គីលេងកម្សាន្ត ?
តើនៅខាងឆ្វេងឥវ៉ាន់មែនទេ ?
តើពេលណានឹងឈប់ជិះ ?
តើមួយណាជាភ្នំស ?
២ឆ្នាំហើយចាប់ពីខ្ញុំចាប់ផ្តើមជិះស្គី ។
តើកន្លែងណាខ្ញុំអាចទិញសំបុត្រចូលជិះបាន ?
ខ្ញុំចង់ជួលស្គីគូ ។
សុំស្គីគូមួយប្រវែង១៧៧សង់ទីម៉ែត ។
សុំស្បែកជើង១គូប្រវែង៩អ៊ីង ។
ខ្ញុំបានធ្វើឲ្យស្គី១ ។
ខ្ញុំបាត់ស្រោម១ ។
តើអ្នកនឹងហៅអ្នកល្បាតទេ ?
ខ្ញុំសុំទោសតើអ្នកនឹងយករូបភាពខ្ញុំទេ ?
អ្នកគួរតែអង្គុយឫឈរជាមួយពួកយើង ?
ខ្ញុំប្រហែលជាយករូបភាពរបស់អ្នក ?
ខ្ញុំចង់បានហ្វីលពណ៌១ដុំក្នុងទំហំ៣៦ឡើងទៅ ។
ខ្ញុំនឹងចម្លងផ្ញើទៅអញអ្នក ។ តើអ្នកសរសេរអាស័យដ្ឋានរបស់អ្នកទេ ?
តើមានកន្លែងណាទទួលបង្កើតភាពយន្តរបស់ខ្ញុំ ?
ខ្ញុំយករូបភាពជាមួយកាមេរ៉ាវីឌេអូរបស់ខ្ញុំ ?
តើអ្នកមានកាសែតតន្ត្រីស្រុកស្រែទេ ?
ខ្ញុំចង់ចាក់សាកស្តាប់សិន ។
តើមានហាងនៅម្តុំនេះទេ ?
តើហាងមួយណាដែលមានទំនិញល្អៗ ?
ខ្ញុំកំពុងស្វែងរកហាងដែលលក់ទំនិញមានតម្លៃអាចយកបាន ។
តើហាងលក់កាដូដែលយុវវ័យចូលចិត្តនៅកន្លែងណា ?
តើកន្លែងណារាប់គ្រឿងបន្លាស់ ?
ខ្ញុំត្រូវការវត្ថុអនុស្សាវរីយ៍ដែលនាំចូលមកពីប្រទេសអង់គ្លេសតែប៉ុណ្ណោះ ។
ខ្ញុំត្រូវការវត្ថុអនុស្សាវរីយ៍សម្រាប់មិត្តប្រុសរបស់ខ្ញុំ ។
ខ្ញុំត្រូវការវត្ថុអនុស្សាវរីយ៍សម្រាប់ម្តាយរបស់ខ្ញុំ ។
តើអ្នកមានម៉ូតផ្សេងទេ ?
តើខ្ញុំអាចមើលអារយឺតនេះបានទេ ?
តើអានេះជាអ្វី ?
តើមានអាផលិតពីក្រណាត់ផ្សេងទេ ?
តើអ្នកអាចលក់រាយបានទេ ?
ខ្ញុំត្រូវការគ្រឿងទេសដាក់លើសាច់ជ្រូកជញ្ច្រាំ ។
អ្នកនឹងរុំវាមែនទេ ?
តើអ្នកនឹងរុំវាលក់រាយមែនទេ ?
តើខ្ញុំអាចកាន់កាតាបនេះបានទេ ?
ខ្ញុំមិនបានទទួលបានការប្ដូរមកវិញនៅឡើយទេ ។
តើអ្នកនឹងផ្ញើទៅជប៉ុនមែនទេ ?
ខ្ញុំត្រូវការកក់សាប៊ូនឹងកាត់សក់ ។
សុំកាត់ត្រឹមតែ២អ៊ីងបានហើយ ។
ខ្ញុំត្រូវការទៅកន្លែងមួយ ។
តើបន្ទប់គ្រែ១ដែលមានបន្ទប់ទឹកថ្លៃប៉ុន្មាន ?
៨០ផោនជាមួយនិងអាហារពេលព្រឹក ។
តើមានបន្ទប់ដែលមានតម្លៃ៧៥ផោនទេ ?
ខ្ញុំយកបន្ទប់នោះ ។
អ្នកអាចប្រាប់ខ្ញុំបានទេតើសណ្ឋាគារណាខ្លះដែលស្អាតហើយថោកទៀត ?
អ្នកអាចប្រាប់ខ្ញុំបានទេតើសណ្ឋាគារណាខ្លះដែលនៅជិតសា្ថណីយ ?
តើមានអាគារស្នាក់នៅឫសណ្ឋាគារយុវជននៅត្រង់នេះទេ ?
អ្នកអាចប្រាប់ខ្ញុំបានទេតើសណ្ឋាគារណាខ្លះដែលមានតម្លៃក្រោម៥០ផោនក្នុង១យប់ទេ ?
តើខ្ញុំទៅសណ្ឋាគារយុវជនដោយរបៀបណា ?
តើដើរទៅចម្ងាយប៉ុន្មានដែរ ?
តើអ្នកនឹងកក់១បន្ទប់សម្រាប់យប់នេះ ?
សុំបន្ទប់ដែលមានបន្ទប់ទឹក ។
តើស្នាក់នៅ១សប្ដាហ៍មានការបញ្ចុះតម្លៃទេ ?
តើខ្ញុំចំណាយវាពេលឥឡូវឫពេលចេញ ?
តើការស្នាក់នៅ១ខែមានការបញ្ចុះតម្លៃទេ ?
ខ្ញុំបានធ្វើការកក់ហើយ ។ ខ្ញុំឈ្មោះសាឆីឃូ យ៉ាម៉ាម៉ូតូ ។
តើមានទឹកក្តៅ២៤ម៉ោងក្នុង១ថ្ងៃទេ ?
តើពេលណាខ្ញុំអាចហូបអាហារពេលព្រឹកបាន ?
អ្នកអាចប្រាប់ខ្ញុំបានទេតើភោជនីយដា្ឋនម្តុំនេះណាមួយដែលឆ្ញាញ់ហើយថោក ?
ខ្ញុំនឹងត្រឡប់ទៅវិញនៅយប់នេះ ។
តើពេលណាអ្នកបិទទ្វារមុខ ?
ខ្ញុំក្រោកម៉ោង៦ព្រឹកស្អែក ។
តើអ្នកនឹងរក្សាតម្លៃសម្រាប់ខ្ញុំមែនទេ ?
បន្ទប់ខ្ញុំត្រជាក់ណាស់ ។
ខ្ញុំត្រូវការងូតទឹក ។
តើពេលណាខ្ញុំអាចទទួលទានអាហារពេលព្រឹកបាន ?
ខ្ញុំមិនដឹងថានាឡិកានេះដើរយ៉ាងម៉េចទេ ?
ខ្ញុំត្រូវការស្នាក់នៅលើសពី១យប់ ។
ខ្ញុំនឹងចាកចេញ១យប់មុន ។
តើអ្នកមានតារាងរថភ្លើងចេញដំណើរទេ ?
តើអ្នកអាចរក្សាឥវ៉ាន់នេះដល់ទៅ៥បានទេ ?
ខ្ញុំមិនមានកាតសមាជិកទេ ។
ប៉ុន្តែខ្ញុំត្រូវការស្នាក់នៅ១យប់ ។
ខ្ញុំត្រូវការមានកាតសមាជិក ។
ខ្ញុំមានកម្រាលគ្រែខ្លួនឯងហើយ ។
ខ្ញុំសុំខ្ចីកម្រាលគ្រែបានទេ ។
តើកិច្ចការផ្សេងទេ ?
ខ្ញុំអាចនិយាយជាមួយឃារីនបានទេ ?
នាងមិននៅផ្ទះទេឥឡូវនេះ ។
ខ្ញុំនឹងខលទៅនាងម្តទៀត ។ អរគុណ ។
អ្នកអាចប្រាប់ខ្ញុំពីរបៀបខលពីទូរសព្ទនេះបានទេ ?
តើខ្ញុំត្រូវបញ្ចូលកាក់ជាមុនមែនទេ ?
សួស្តីនេះជាសណ្ឋាគារសាវុយមែនទេ ?
នេះយ៉ាម៉ាម៉ូតូកំពុងនិយាយ ។
ខ្ញុំចង់ធ្វើការខលទៅជប៉ុន ។
អ្នកអាចប្រាប់ខ្ញុំបានទេតើលេខកូដទូរសព្ទប្រទេសជប៉ុនគឺអ្វី ?
ខ្ញុំនឹងចំណាយខ្លួនឯង ។
នេះជាសហការីសេវាកម្មទូរសព្ទអន្តរជាតិ ។
យើងនឹងខលទៅក្រុងតូក្យូប៉ុន្តែគ្មានការឆ្លើយតប ។
ផ្ញើនេះទៅជប៉ុនដោយតេឡេក្រាម ។
ខ្ញុំត្រូវការទទួលប្រអប់នេះ ។
វាត្រូវបានព្រីនទាំងអស់ ។
ខ្ញុំត្រូវការផ្ញើរបស់នេះដោយកប៉ាល់ ។
វាជាទំនិញផ្ទាលខ្លួនទាំងអស់ ។
ខ្ញុំរកកាបូបឥវ៉ាន់របស់ខ្ញុំមិនឃើញ ។
តើជើងហោះហើរអ្វីដែលអ្នកធ្វើដំណើរមកដល់ ?
ខុំ្ញបានមកដល់ប្រ៊ីដទីសអ៊ែរវេហើយជើហោះហើរលេខ២០៤ ។
តើយើងទាក់ទង់ទៅអ្នកដោយរបៀបណាប្រសិនបើយើងរកឃើញឥវ៉ាន់របស់អ្នក ?
ខ្ញុំនៅសណ្ឋាគារជាប់ផ្លូវចេម ។
តើកន្លែងដែលរបស់បាត់រកឃើញនៅឯណា ?
ខ្ញុំសុំទោសខ្ញុំភ្លេចកាបូបនៅលើរថភ្លើង ។
ខ្ញុំបានមកដល់រថភ្លើងដែលមានលេខ១២៥០ឡុងដ៏ ។
តើកាបូបប្រភេទណាដែលអ្នកយកចេញក្រោយគេ ?
កាបូបស្ពាយស្មាពណ៌ស ។
សៀវភៅមគ្គទេសក៍១ក្បាល ។
សរសេរអាស័យដ្ឋានដែលយើងអាចទាក់ទងអ្នកបាន ។
ប្រសិនបើយើងរកឃើញវាយើងនឹងខលទៅអ្នក ។
តើពេលណាអ្នកគិតថានឹងរកឃើញវា ? តើកន្លែងណាដែលខ្ញុំអាចមកទទួលបាន ?
តើអ្នកនឹងខលទៅបុគ្គលិកដែលនិយាយភាសាជប៉ុន ?
កាបូបមានស្លាកឈ្មោះ ។
ខ្ញុំសុំទោសខ្ញុំរកកាមេរ៉ាមិនឃើញទេ ។
តើអ្នកដាក់វានៅកន្លែងណា ?
តើអ្នកនឹងធ្វើរបាយការណ៍ពីការលួចដើម្បីទទួលប្រាក់ពីក្រុមហ៊ុនធានារ៉ាប់រងជប៉ុនមែនទេ ?
តើអ្នកនឹងចាកចេញពីក្រុងឡុងដ៏នៅពេលណា ?
ថ្ងៃទី១៥ខែកក្កដា ។
តើកន្លែងណាដែលយើងអាចផ្ញើទៅអ្នកប្រសិនបើរកឃើញវា ?
នៅក្រុងប៉ារីស ។
ខ្ញុំនឹងចាកចេញនៅថ្ងៃស្អែក ។ សុំផ្ញើវាទៅជប៉ុនពេលអ្នករកឃើញវា ។
សុំរៀបរាប់ពីការបាត់ ។
ខ្ញុំមិនដឹងទេ ។ វាត្រូវបានលួចនៅកន្លែងនោះ ។
តើខ្ញុំអាចទៅទទួលនៅស្ថានទូតជប៉ុនបានទេ ?
ខ្ញុំបានមកទទួលលិខិតឆ្លងដែនខ្ញុំដែលបានបោះពុម្ភ ។
តើកន្លែងណាពេលណាដែលអ្នកបាត់វា ?
ខ្ញុំត្រូវបានគេលួចនៅលើរថភ្លើងកាលពីម្សិលមិញ ។
ខ្ញុំបានប្រើពីលេខនេះទៅលេខនោះ ។
តើអ្នកទិញវានៅកន្លែងណា ?
ខ្ញុំបានកក់ត្រាការលួចរួចហើយ ។
តើអ្នកអាចស៊ើបអង្គេតពីវានៅតូក្យូបានទេ ?
យើងបញ្ជាក់ពីវារួចហើយយើងបានបោះពុម្ភវារួចដែរ ។
តើអ្នកនឹងបោះពុម្ភវាមែនទេ ?
តើអ្នកអាចបោះពុម្ភវាឲ្យបានត្រឹមត្រូវបានទេ ?
តើស្ថានីយមួយណាដែលជិតបំផុតនៃកន្លែងខ្ញុំអាចទទួលបានការបោះពុម្ភបាន ?
អ្នកត្រូវតែទៅវៀនណា ។
ឈប់សួរខ្ញុំហើយ ។
សុំចាប់ផ្តើមតម្លៃម៉ែត ។
ខ្ញុំមិនដែលចង់បានវាទេ ។
វាមិនថ្លៃនោះទេ ។
ឲ្យថ្នាំមកខ្ញុំខ្លះមក ។
ខ្ញុំមានប្រតិកម្មជាមួយងាវ ។
តើខ្ញុំគួរហូបអ្វី ?
ខ្ញុំនៅតែមិនមានអារម្មណ៍ល្អទេ ។
ខ្ញុំចង់ព្យាបាលជំងឺផ្តាសាយ ។
សុំលេប៣ដងក្នុង១ថ្ងៃមុនពេលបាយ ។
យើងមិនលក់ថ្នាំដោយគ្មានវេជ្ជបញ្ជានោះទេ ។
តើខ្ញុំអាចហូបអ្វីបានពេលនេះ ?
អាហារពេលល្ងាចមិនបម្រើរហូតដល់ម៉ោង៧ ។ ឥឡូវបានតែផឹកទឹកតេប៉ុណ្ណោះ ។
អ្នកមិនអាចហូបអ្វីបានទេ ?
យើងមានបន្ទះឈីប ។
ខ្ញុំចង់ហូបម្ហូបបារាំងខ្លះ ។
តើអ្នកស្គាល់ភោជនីយដ្ឋានដែលឆ្ងាញ់ជិតនេះទេ ?
តើម្តុំនេះមានភោជនីយដ្ឋានឆ្ងាញ់ហើយថោកជាតិ ?
តើក្រៅពីផ្លូវនេះមានភោជនីយដ្ឋានច្រើនទេ ?
យើងត្រូវការតុ១សម្រាប់គ្នា៤នាក់នៅម៉ោង៧នឹង៣០នាទីយប់ ។
ខ្ញុំសុំទោស ។ មិនតុច្រើនទេ ។
យើងអាចផ្តល់ជួនអ្នក១កន្លែងនៅម៉ោងនឹង៣០នាទី ។
យើងនឹងយកវានៅម៉ោង៩នឹង៣០នាទី ។
ខ្ញុំឈ្មោះយ៉ាម៉ាម៉ូតូ ។
ខ្ញុំត្រូវការម្ហូបក្នុងតម្លៃប្រហែល៣០ផោនក្នុង១នាក់ ។
ហើយយើងត្រូវការមានអ្នកជំនាញរបស់អ្នក ។
ប្រាកដហើយ ។ យើងរីកនឹងជួបអ្នកនៅម៉ោង៩នឹង៣០នាទី ។
តើខ្ញុំគួរតែស្លៀកពាក់បែបណា ?
សុំអ្នកស្លៀកពាក់ឲ្យបានសមរម្យ ?
យើងបានកក់១តុនៅម៉ោង៩នឹង៣០នាទី ។ ខ្ញុំឈ្មោះយ៉ាម៉ាម៉ូតូ ។
យើងត្រូវការតុនៅជិតបង្អួច ។
តើអ្នកនឹងយកការកុម្ម៉ង់របស់យើងទេ ?
តើអ្វីជាភាពពិសេសរបស់អ្នក ?
តើអ្នកមានមឺនុយពិសេសទេ ?
ខ្ញុំសុំទោស តើខ្ញុំអាចសួរអ្វីដែលអ្នកមានបានទេ ?
ឲ្យម្ហូបនោះមកខ្ញុំ ។
ខ្ញុំសុំទោសខ្ញុំត្រូវការទឹកខ្លះ ?
តើអ្នកបានដាក់អំបិលឲ្យខ្ញុំទេ ?
តើកាហ្វេមានបញ្ចូលជាមួយអាហារទេ ?
យើងត្រូវការចំណាយផ្សេងៗគ្នា ។
ខ្ញុំនឹងរក្សាវិក័យបត្រទុក ។
ខ្ញុំគិតនេះជាការគិតខុស ។
សុំត្រី ឈីប នឹងឃូគ១កូនដប់ ។
តើមានកន្លែងអង្គុយផ្សេងទេ ?
តើខ្ញុំអាចយកកាំបិតនឹងសមនៅកន្លែងណា ?
ខ្ញុំត្រូវការពែងតែ១ ?
ខ្ញុំត្រូវការនំឃេកជាចំណែកៗ ។
នេះជាអាហារបូហ្វេរ ។
តើខ្ញុំគួរចំណាយមុន ?
តើខ្ញុំអាចយកកៅអីដែលខ្ញុំចូលចិត្តបានទេ ?
តើខ្ញុំគួរតែកុម្ម៉ង់នៅកន្លែងណា ?
តើយើងអាចហូបដោយការចម្អិនវាមែនទេ ?
តើអ្វីដែលថោកហើយល្អ ?
ខ្ញុំនឹងយកវាចំនួន១០០ក្រាម ។
ខ្ញុំនឹងយកវាមួយចំណិត ។
តើអ្នកមានស្រាក្រហមចំនួនកន្លះលីត្រដែរទេ ?
តើអ្នកមានកាំបិតនិងសមទេ ?
តើវាត្រូវទុកយូរប៉ុណ្ណា ?
តើអ្នកមាននំផាយដែលដាក់តែបន្លែដែរឬទេ ?
តើំមួយណាស្រាល ?
ចេញពីផ្លូវនេះទៅ ។
ទម្លាក់វាចុះ ។
លុតជង្គង់ចុះ ។
ដាក់កាំភ្លើងចុះ ។
កម្ចាត់វាចោលទៅ ។
គ្មានល្បិចទេ ។
ខ្ញុំគ្មានអ្វីផ្លាស់ប្ដូរទេ ។
ខ្ញុំគ្មានប្រាក់ទេ ។
ច្រើនពេកហើយសម្រាប់ខ្ញុំ ។
ខ្ញុំត្រូវបានគេបាញ់ ។
សូមចេញលិខិតបញ្ជាក់របស់ប៉ូលីស ។
ខោអាវរបស់ខ្ញុំត្រូវគេលួច ។
ក្រវិលរបស់ខ្ញុំត្រូវគេលួច ។
ខ្ញុំត្រូវបានគេចាក់ ។
ខ្ញុំត្រូវបានគេវាយ ។
ខ្ញុំមានគ្រោះថ្នាក់រថយន្ត ។
ខ្ញុំមានអាការៈដូចនេះឯង ។
ខ្ញុំមានអាការៈបែបនេះតាំងតែពីយប់មិញ ។
ខ្ញុំមានប្រតិកម្មជាមួយរបស់ទាំងនោះ ។
សូមចេញលិខិតពេទ្យនិងកន្ទុយសំបុត្រសម្រាប់ការធានារ៉ាប់រង ។
ធានារ៉ាប់រងរបស់ខ្ញុំនឹងចេញថ្លៃឲ្យ ។
អ្នកនឹងជាឆាប់ៗ ។ កុំបារម្ភ ។
អ្នកយកល្អគួរតែត្រលប់ទៅកាន់ប្រទេសរបស់អ្នកវិញហើយទៅកាន់មន្ទីរពេទ្យ ។
អ្នកត្រូវតែសម្រាក២ទៅ៣ថ្ងៃ ។
ខ្ញុំនឹងឲ្យវេជ្ជបញ្ជាទៅអ្នក ។
អ្នកត្រូវតែមកម្តងទៀត ។
សូមចៀសវាងវាតាមរបស់ទាំងនេះ ។
ខ្ញុំមានអាការៈអស់ទាំងនេះតាំងតែពីព្រឹកមិញ ។
ខ្ញុំសូមអភ័យទោស ។
ខ្ញុំមានការសោកស្តាយខ្លាំងណាស់ ។
ខ្ញុំមានវចនានុក្រមល្អមួយ ។
ច្បាប់នេះនឹងប្រើបានល្អក្នុងករណីនេះ ។
វាជារឿងល្អរបស់អ្នកដែលធ្វើឲ្យវាអាចកម្រើកបាន ។
ទិដ្ឋាការរបស់ខ្ញុំនឹងមានសុពលភាព៦ខែ ។
គាត់មានពេលវេលាយ៉ាងសប្បាយរីករាយ ។
នាងពូកែលេងបៀរ ។
វាពន្យល់មិនបានល្អសោះ ។
ខ្ញុំស្គាល់រឿងល្អពីរឿងអាក្រក់ ។
ប្រឹងតាមសម្ថភាពរបស់អ្នក ។
លំហាត់ប្រាណច្រើនពេកនឹងប៉ះពាល់ដល់អ្នក ។
ម្តាយរបស់ខ្ញុំបានធ្វើនំស្រួយ ។
ឆ័ត្រនេះនឹងប្រើជាដំបង ។
ខ្ញុំពិតជាស្រលាញ់គាត់ណាស់ ។
មិនដែលធ្វើអ្វីដែលខ្ញុំឃើញថាជារឿងយ៉ាងឆ្កួតលីលាដូចនេះទេ ។
គាត់បានជ្រើសរើសប្រពន្ធរបស់គាត់ដោយសារតែនាងបានដេរធ្វើអាវក្រៅរបស់នាង ។
តើអ្នកមានរបស់អ្វីដែលធ្វើពីកប្បាសទេ ?
នាងបានធ្វើម្ហូបឲ្យខ្ញុំញ៉ាំ ។
ខ្ញុំត្រូវបានបង្គាប់ឲ្យទៅផ្ទះតែម្តងបន្ទាប់ពីចេញពីរៀនពីសាលា ។
គាត់ធ្វើដូចជាគាត់មិនដឹងពីវត្តមានរបស់ខ្ញុំអ៊ីចឹង ។
ខ្ញុំគិតថាអ្នកកំពុងដើរផ្លូវខុសហើយ ។
ខ្ញុំគួរតែទៅពេលនេះ ។
នាឡិកានេះមិនដើរទេ ។
វិស្សមកាលប្រព្រឹត្តទៅលឿនណាស់ ។
ធនាគារ យូអេស ទៅដល់គ្រប់ទីកន្លែង ។
ស្បែកជើងរបស់អ្នកមិនសមនឹងពណ៌ខោអាវសោះ ។
ខ្ញុំនឹងរកពាក្យអ្វីមកអរគុណអស់ទេ ។
ខ្ញុំជាសិស្ស ។
ខ្ញុំមកទីនេះដោយសារមុខជំនួញរបស់ខ្ញុំ ។
ខ្ញុំមកទីនេះដើម្បីសួរសុខទុក្ខមិត្តភក្តិ ។
អាកាសធាតុថ្ងៃនេះពិតជាស្រស់ថ្លាណាស់ ។
ខ្ញុំជាអ្នកធ្វើការនៅការិយាល័យ ។
សុំកាហ្វេ បាទ ។
ខ្ញុំចង់ញ៉ាំកាហ្វេ ។
ខ្ញុំចង់ទៅសាន់ឌីយេហ្គោ ។
ខ្ញុំចង់ទំនេររហូត ។
ខ្ញុំចង់ក្លាយជាអ្នករាយការណ៍ព័ត៌មាន ។
តើអ្នកត្រូវការញ៉ាំអី ?
តើអ្នកត្រូវការសាច់ជ្រូកឬសាច់ត្រី ?
តើអ្នកចង់ផឹកអី ?
យើងផឹកកាហ្វេ តែ ទឹកក្រូចស្រស់ កូកាកូឡា ស្រាបៀរ និងទឹកបរិសុទ្ធ ។
តើអ្នកចង់ពិសារស្រាវីស្គីទេ ?
វាជាប្រភេទនៃគ្រឿងត្រជាក់ ។
តើខ្ញុំអាចប្ដូរកៅអីអង្គុយបានទេ ?
តើអ្នកមានលក់អីវ៉ាន់មិនបង់ពន្ធនៅលើយន្តហោះទេ ?
តើយូរប៉ុណ្ណាទៀតទើបយើងទៅដល់ក្រុងញូយ៉ក ?
តើខ្ញុំអាចសុំសំបុត្រចុះពីយន្តហោះ មួយទៀតបានទេ ?
តើអ្នកអាចជួយបំពេញបែបបទនេះឲ្យខ្ញុំផងបានទេ ?
វាជាប្រភេទមួយនៃអាការៈក្តៅ ។
តើត្រូវសំចតនៅព្រលានយន្តហោះហៀរថ្រូ យូរប៉ុណ្ណា ?
តើមានហាងលក់របស់មិនគិតពន្ធនៅកន្លែងរង់ចាំទេ ?
តើបញ្ជរឆ្លងកាត់អាកាសចរណ៍ណ៌យូណាយធីត នៅឯណា ?
តើច្រករង់ចាំបន្តដំណើរសម្រាប់អាកាសចរណ៍ជប៉ុន ជើងហោះហើរលេខ២១៤ នៅឯណា ?
តើខ្ញុំអាចធ្វើការរៀបចំការធ្វើដំណើរហោះហើររបស់ខ្ញុំនៅឯណា ?
ខ្ញុំបានបញ្ជាក់ការកក់របស់ខ្ញុំនៅប្រទេសជប៉ុនហើយ ។
ច្រករង់ចាំបន្តដំណើរសម្រាប់វីជីន អាត្លង់ទិក ជើងហោះហើរលេខ២០៤ត្រូវបានផ្លាស់ប្ដូរហើយ ។
ខ្ញុំបានខកខានជើងហោះហើរបន្ត ។
តើអ្នកអាចពិនិត្យបានទេបើសិនជាមានជើងហោះហើរនៅសល់ ?
តើអ្នកនឹងស្នាក់នៅក្នុងទីក្រុងឡុងដ៍យូរប៉ុណ្ណា ?
ខ្ញុំមានប្រាក់៩០០ដុល្លារ ។
តើអ្នកអាចស្នាក់នៅម្តងទៀតបានទេ ?
ខ្ញុំសូមអភ័យទោស ខ្ញុំមិនយល់ពីអ្នកសោះ ។
កំពុងរៀនភាសាអង់គ្លេស ។
រយៈពេល១០ថ្ងៃ ។
តើអ្នកអាចមើលក្នុងនោះឲ្យខ្ញុំបានទេ ?
តើមានកាបូបប៉ុន្មានដែលអ្នកបាត់ ?
តើវាមានរាងរៅយ៉ាងម៉េច ?
វាជាកាបូបធំមានពណ៌បៃតង ។
វាជាកាបូបពណ៌ខ្មៅមានកង់រុញ ស្លាកដាក់ថា បូស្តុន ។
សូមមេត្តាអត់ធ្មត់នៅពេលដែលយើងរកវា ។
សូមបំពេញបែបបទនៃទម្រង់ក្នុងការបាត់កាបូប ។
សូមទូរស័ព្ទមកខ្ញុំនៅសណ្ឋាគារឲ្យបានឆាប់នៅពេលអ្នករកឃើញវា ។
សូមសងខ្ញុំបើអ្នករកវាមិនឃើញ ។
សម្រាប់កំឡុងពេលវេលានេះ តើអ្នកអាចឲ្យប្រាក់ខ្ញុំខ្លះដូចនេះខ្ញុំអាចទិញរបស់ចាំបាច់ខ្លះបាន ។
លិខិតឆ្លងដែនរបស់អ្នកនិងលិខិតបញ្ជាក់ ។
តើមានអ្វីនៅក្នុងកាបូប ?
សូមបើកកាបូបរបស់អ្នក ។
វាជាកាដូសម្រាប់មិត្តភក្តិរបស់ខ្ញុំ ។
តើម្សៅសៗនៅជាអ្វី ?
គ្រាន់តែជាថ្នាំត្រជាក់ប៉ុណ្ណោះ ។
របស់នេះគឺត្រូវបានហាមប្រាម ។
អ្នកបានយករបស់ច្រើនជាងអ្វីដែលគេអនុញ្ញាតហើយ ។
គ្រាន់តែជាថ្នាំក្រពះប៉ុណ្ណោះ ។
សូមប្ដូរវាជាប្រាក់ដុល្លារ ។
ខ្ញុំចង់បង់ប្រាក់នូវសំបុត្រធ្វើដំណើររបស់ខ្ញុំ ។
តើធនាគារនៅឯណា ?
តើម៉ោងធ្វើការរបស់ធនាគារគឺម៉ោងប៉ុន្មាន ?
តើអត្រាប្ដូរប្រាក់ថ្លៃប៉ុន្មាន ?
តើអ្នកអាចប្ដូរប្រាក់១០០ដុល្លារកាណាដាទៅជាដុល្លារអាមេរិកបានទេ ?
ប្ដូរប្រាក់ជាប្រាក់ថ្លៃតូចៗ ។
តើអ្នកអាចប្ដូរប្រាក់ជាប្រាក់ថ្លៃតូចៗបានទេ ?
ខ្ញុំសុំទោស ខ្ញុំគ្មានប្រាក់តូចៗទេ ។
តើនេះមិនខ្លីពេកទេ ?
អ្នកអាចបំបែកវាជាបួនចំណែកបានទេ ?
តើរថយន្តក្រុងនេះទៅទីប្រជុំជនទេ ?
វាចំណាយពេលប្រហែល៥០នាទី ។
ទៅកាន់ទីប្រជុំជន ។
តើអ្នកអាចជូនខ្ញុំទៅកាន់អាស័យដ្ឋាននេះបានទេ ?
សូមជិះឲ្យបានលឿនតាមដែលអាចធ្វើទៅបាន ។
ហើយតើវាថ្លៃប៉ុន្មានដើម្បីធ្វើដំណើរទៅកាន់ទីប្រជុំជន ?
តើខ្ញុំអាចដាក់កាបូបរបស់ខ្ញុំនៅក្នុងឃ្លុបដាក់ឥវ៉ាន់បានទេ ?
តើមានមជ្ឈមណ្ឌលផ្តល់ព័ត៌មានទេសចរណ៍នៅព្រលានយន្តហោះដែរឬទេ ?
មានខ្លះ ប្រហែលជាខ្ទង់២០០ដុល្លារ ។
តើមានសណ្ឋាគារដែលមានតម្លៃថោកដែរទេ ?
តើអ្នកមានបញ្ជីសណ្ឋាគារដែរទេ ?
តើអ្នកអាចកក់សណ្ឋាគារនេះឲ្យខ្ញុំបានទេ ?
តើអ្នកអាចឲ្យប្រាក់បញ្ញើជាមុនបានទេ ?
សូមបង់ប្រាក់ដែលនៅសេសសល់តាមក្រោយនៅឯសណ្ឋាគារ ។
តើអ្នកប្រាប់ខ្ញុំថាទៅសណ្ឋាគារដោយរបៀបណាផងបានទេ ?
តើខ្ញុំគួរទៅទីនោះដោយរបៀបណា ?
វាចំណាយពេលប្រហែល៤០នាទីដោយជិះរថយន្តក្រុង ។
វាចំណាយពេលប្រហែល៤០នាទីដោយជិះរថភ្លើងក្រោមដី ។
វាចំណាយពេលប្រហែល៤០នាទីដោយជិះរថយន្តតាក់ស៊ី ។
តើអ្នកត្រូវការកន្លែងជក់បារី ឬមិនជក់បារី ?
សូមកន្លែងមិនជក់បារី ។
តើអ្នកចូលចិត្តកៅអីក្បែរបង្អួចឬក្បែរផ្លូវ ?
ខ្ញុំសុំទោស ។ កៅអីជាប់បង្អួចពេញអស់ហើយ ។
ក្នុងករណីនោះ កៅអីតាមផ្លូវដើរវាសមរម្យ ។
ខ្ញុំសុំទោស ។ កៅអីតាមផ្លូវដើរពេញអស់ហើយ ។
កៅអីនៅក្បែរតាមផ្លូវដើរ ។
ក្នុងករណីនោះ កៅអីជាប់បង្អួចវាសមរម្យ ។
តើខ្ញុំអាចសុំកៅអីអង្គុយជាប់មិត្តភក្តិខ្ញុំបានទេ ?
តើអ្នកមានកាបូបប៉ុន្មាន ?
ខ្ញុំគ្មានវ៉ាលីសដែលត្រូវចុះបញ្ជីចូលទេ ។
អ្នកត្រូវតែបង់ប្រាក់បន្ថែម ។
តើខ្ញុំអាចយួរវាបានទេ ?
តើខ្ញុំត្រូវការប័ណ្ណចុះឡើងទេ ?
តើនេះជាច្រកត្រឹមត្រូវទៅកាន់ទីក្រុងប៉ារីសមែនទេ ?
សូមសំបុត្រទៅមក ជិះលេងជុំវិញទៅកាន់ម៉ាយអាមិ ។
ទៅកាន់ទីក្រុងញូវយ៉ក ?
សួស្តី អាកាសចរណ៍ដែលតា ។
សូមកាលបរិច្ឆេទថ្ងៃចេញដំណើរ ។
ថ្ងៃទី១០ខែមីនា ។
សូមលេខជើងហោះហើរ ។
លេខជើងហោះហើរ ២០៨ ទៅកាន់ទីក្រុងតូក្យូ ។
ខ្ញុំមានឈ្មោះស៊ីនកូ គិមូរ៉ា ។
ខ្ញុំចង់ឆែកពីរសានូវថ្ងៃចេញដំណើរ ។
អ្នកអាចឆែកវាក្នុងកំលុងពេលពីរម៉ោងមុននឹងពេលចេញដំណើរ ។
តើខ្ញុំគួរចូលទៅចុះឈ្មោះចូលនៅពេលណា ?
អ្នកត្រូវចុះឈ្មោះចូលយ៉ាងតិច១ម៉ោងមុននឹងចេញដំណើរ ។
អត់ទោស ។ តើខ្ញុំសុំឈ្មោះរបស់អ្នកបានទេ ?
ខ្ញុំចង់កក់ជើងហោះហើរទៅកាន់ទីក្រុងតូក្យូ ។
ថ្ងៃទី២៣ ខែមីនា ។
ខ្ញុំសុំទោស កៅអីទាំងអស់ត្រូវបានគេយកអស់ហើយសម្រាប់ថ្ងៃទី២៣ខែមីនា ។
ខ្ញុំចង់ចាកចេញឲ្យបានឆាប់តាមដែលអាចធ្វើទៅបាន ។
យើងអាចទុកកៅអីឲ្យអ្នកមួយនៅថ្ងៃទី២៤ខែមីនា ។
លេខជើងហោះហើររបស់អ្នកគឺលេខ ២០៨ ម៉ោងចេញដំណើរគឺម៉ោង១០និង៥៥នាទី ។
អាកាសយានដ្ឋានអន្តរជាតិចន អេហ្វ កេណឺឌី ។
ទៅកាន់ទីក្រុងឡូសអេងចេឡេស ។
ខ្ញុំមានប័ណ្ណសម្គាល់និស្សិតអន្តរជាតិ ។
ខ្ញុំត្រូវការកៅអីមួយនៃជើងហោះហើរដែលតា ៩២៦ ទៅកាន់ញូវយ៉ក ។
ខ្ញុំខ្លាចតែកៅអីទាំងអស់ពេញអស់ទេ ។
តើអ្នកអាចបង្ហាញសំបុត្ររបស់អ្នកមកខ្ញុំបានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបប្រើលិខិតផាសនេះបានទេ ?
តើខ្ញុំអាចកក់ការហោះហើរដោយប្រើលិខិតផាសនេះបានទេ ?
តើខ្ញុំអាចទិញសំបុត្រមួយទៅកាន់ឈីកាហ្គោ បានទេ ?
សូមកៅអីថ្នាក់ទីពីរឬកៅអីធម្មតា ។
តើបញ្ជរណាដែលខ្ញុំអាចទិញសំបុត្រទៅកាន់ម៉ាយអាមិ ?
តើខ្ញុំអាចទិញសំបុត្រចុះថ្លៃសម្រាប់សិស្សបាននៅឯណា ?
តើអ្នកបង្ហាញពីម៉ោងហោះហើរដល់ខ្ញុំបានទេ ?
តើអ្នកអាចបង្ហាញខ្ញុំពីរបៀបមើលម៉ោងហោះហើរបានទេ ?
តើអាកាសចរណ៍មួយណាដែលមានតម្លៃថោកទៅកាន់ម៉ាយអាមិ ?
ខ្ញុំចង់ទៅកាន់ទីក្រុងសាន់ឌីយេហ្គោនារសៀលនេះ ។ តើម៉ោងប៉ុន្មានដែលរទេះភ្លើងចេញដំណើរ ?
តើរថភ្លើងចាកចេញពីស្ថានីយ៍អ្វី ?
ខ្ញុំចង់កក់កៅអីមួយទៅកាន់សៀតថល ។
តើថ្លៃប៉ុន្មានទៅកាន់សៀតថល ?
ថ្នាក់ទីពីរ សំបុត្រទៅ ទៅកាន់សៀតថល ។
តើសំបុត្រសម្រាប់ត្រលប់មកវិញមានសុពលភាពយូរប៉ុណ្ណា ?
តើរថភ្លើងនេះជិះទៅដោយផ្ទាល់ទៅកាន់សៀតថល ?
តើវាសំខាន់ទេបើប្ដូរជិះបន្ត ?
តើវាត្រូវចំណាយប៉ុន្មានសម្រាប់កៅអីអាចដេកបាន ទៅកាន់ទីក្រុងម៉ាឌ្រីដ ?
ខ្ញុំចង់កក់កៅអីដេកបាទៅកាន់ទីក្រុងម៉ាឌ្រីដនាយប់នេះ ។
តើខ្ញុំអាចកក់សំបុត្របាននៅឯណា ?
សំបុត្រថ្នាក់ទីពីរចំនួនពីរ សំបុត្រទៅ ទៅកាន់សៀតថល ។
ខ្ញុំចង់ចាប់ផ្តើមប្រើអឺរ៉េលផាស ចាប់ពីថ្ងៃនេះទៅ ។
តើយើងអាចឡើងជិះដោយប្រើលិខិតអឺរ៉េលផាស នេះបានទេ ?
តើមានការបញ្ចុះតម្លៃដោយប្រើលិខិតអឺរ៉េលផាសនេះទេ ?
តើខ្ញុំគួរប្ដូររថភ្លើងទៅកាន់ប្រទេសប៉ូឡូញបាននៅឯណា ?
តើផ្លូវណាទៅកាន់អាត្លង់តា ?
តើរថភ្លើងឈប់ នៅឯទីក្រុងវ៉ាស៊ីនតោនមែនទេ ?
រហូតដល់រថភ្លើងមកដល់ តើយូរប៉ុណ្ណា ?
តើរថភ្លើងនេះជិះឆ្ពោះទៅសៀតថលមែនទេ ?
តើរថយន្តនេះជិះទៅកាន់សៀតថលមែនទេ ?
តើចំណាយពេលយូរប៉ុណ្ណាទៅដល់ឡូសអេនចេឡេស ?
តើវាចំណាយពេលយូរប៉ុណ្ណាទៅដល់ឡូសអេនចេឡេស ?
តើអ្នកនឹងប្រាប់ខ្ញុំឲ្យដឹងដែរទេ នៅពេលយើងមកដល់សាន់ប្រាន់ស៊ីស្កូ ?
សាន់ប្រាន់ស៊ីស្កូគឺជាស្ថានីយ៍ទីបីចាប់ពីទីនេះ ។
តើវាត្រូវចំណាយប៉ុន្មានពីឡូសអេនចេឡេសទៅកាន់ទីក្រុងសាន់ប្រាន់ស៊ីស្កូ ?
តើយើងនឹងឈប់នៅទីនេះយូរប៉ុណ្ណា ?
តើខ្ញុំអាចសុំផែនទីទីក្រុងនេះបានទេ ?
តើខ្ញុំអាចទិញសំបុត្រនៅក្នុងរថយន្តក្រុងបានទេ ?
តើចំណតរថយន្តក្រុងសម្រាប់ទៅម៉េមភីសនៅឯណា ?
តើយើងត្រូវប្ដូររថយន្តក្រុងដើម្បីទៅដល់ម៉េមភីសទេ ?
តើម៉ោងប៉ុន្មានដែលរថយន្តក្រុងទៅម៉េសភីសនឹងចេញដំណើរ ?
តើវាចំណាយអស់ប៉ុន្មានដើម្បីទៅដល់ម៉េមភីស ?
តើខ្ញុំគួរទុកកាបូបខ្ញុំនៅឯណា ?
តើរថយន្តក្រុងនេះជិះទៅកាន់ម៉េមភីសមែនទេ ?
អត់ទោស ខ្ញុំចង់ចុះពីលើរថយន្តក្រុង ។
តើខ្ញុំអាចសុំឈប់ ដោយសំបុត្រនេះបានទេ ?
តើខ្ញុំអាចសុំសំបុត្រច្រើនបានទេ ?
តើស្ថានីយ៍បន្តដំណើរ ផ្ទះប្រផេះ នៅឯណា ?
តើបញ្ជរផ្តល់ព័ត៌មាន ផ្ទះប្រផេះ នៅឯណា ?
តើចំណតរថយន្តក្រុង ផ្ទះប្រផេះ នៅឯណា ?
តើខ្ញុំអាចសុំលិខិតឆ្លងកាត់ជាថ្មីមួយទៀតបានទេ ? ខ្ញុំបានប្រើគូប៉ុងចុងក្រោយអស់ហើយ ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបប្រើតារាងកាលវិភាគនេះបានទេ ?
តើអ្នកអានម៉ោងបានដោយរបៀបណា ?
ហ្គោស៊ីក តំណាងឲ្យពេលរសៀល ចំណែកឯអាស្នាមស្តើងៗតំណាងឲ្យពេលព្រឹក ។
តើវាឈប់សំចតនៅទីនេះយូរប៉ុណ្ណា ?
តើម៉ោងប៉ុន្មានវានឹងចាកចេញ ?
តើកន្លែងឈប់សម្រាកបន្ទាប់នៅពេលណា ?
ទេ មិនទាន់ទេ ។ តើខ្ញុំគួរធ្វើយ៉ាងម៉េច ?
តើខ្ញុំអាចមើលលិខិតឆ្លងដែនរបស់អ្នកនិងប័ណ្ណបើកបរអន្តរជាតិបានទេ ?
នេះជាប័ណ្ណបើកបរអន្តរជាតិរបស់ខ្ញុំ ។
ខ្ញុំចង់ជួលរថយន្តជិះធម្មតា ។
តើខ្ញុំអាចមើលបញ្ជីអត្រាតម្លៃរបស់អ្នកបានទេ ?
តើថ្លៃប៉ុន្មានសម្រាប់រយៈពេលពីរថ្ងៃ ?
ខ្ញុំចង់ជួលរថយន្តនេះសម្រាប់រយៈពេល២៤ម៉ោង ។
ខ្ញុំចូលចិត្តឡានប្រើចង្កឹះលេខអូតូជាង ។
តើខ្ញុំត្រូវបង់ប្រាក់កក់ជាមុន ?
តើអ្នកទទួលវិសាកាតដែរទេ ?
តើខ្ញុំអាចសងវាវិញនៅឌីនវឺរបានទេ ?
តើអ្នកអាចឲ្យទីតាំងខ្លះដល់ខ្ញុំបានទេក្នុងករណីមានបញ្ហា ?
ខ្ញុំចង់ជួលរថយន្តនេះសម្រាប់រយៈពេល១ថ្ងៃ ។
សូមចាក់សាំងផង ។
សូមឲ្យខ្ញុំ២០ដុល្លារសម្រាប់តម្លៃសាំង ។
តើថ្លៃប៉ុន្មានក្នុងមួយលីត្រ ?
តើអ្នកអាចបង្ហាញពីរបៀបចាក់សាំងនៅក្នុងធុង ឲ្យខ្ញុំបានទេ ?
តើអ្នកអាចឆែកមើលសំបកកង់ផងបានទេ ?
ម៉ាស៊ីនមិនដំណើរការល្អឡើយ ។ តើអ្នកអាចជយយឆែកមើលឲ្យខ្ញុំផងបានទេ ?
អំប្រ៉ាយ៉ាមើលទៅដំណើរការមិនល្អសោះ ។
សូមមើលនៅខាងក្នុងកាប៊ីន ។
សូមមើលនៅខាងក្រៅកាប៊ីន ។
ខ្ញុំត្រូវការកាប៊ីនដែលមានបង្អួច ។
ខ្ញុំមានអារម្មណ៍ថាពុលរលក ។ តើខ្ញុំអាចសុំថ្នាំខ្លះបានទេ ?
តើខ្ញុំអាចសុំផែនទីរថភ្លើងក្រោមដីបានទេ ?
តើខ្ញុំអាចទៅទិញសំបុត្ររថភ្លើងក្រោមដីបាននៅឯណា ?
តើច្រកចេញណាមួយទៅកាន់មជ្ឈមណ្ឌលរ៉ុកហ្វេលើរ ?
តើផ្លូវណាមួយដែលខ្ញុំអាចទៅដល់ភូមិគ្រីនវិច ?
ទៅកាន់ប៉មថ្រឹម ។
សូមបើកឲ្យលឿនតាមដែលអាចធ្វើទៅបាន ។
តើចំណាយប៉ុន្មានដើម្បីទៅដល់ព្រលានយន្តហោះ ?
តើអ្នកអាចជូនខ្ញុំទៅនិងមកពីព្រលានយន្តហោះវិញបានទេ ?
តើអ្នកអាចរង់ចាំខ្ញុំនៅពេលខ្ញុំចាំជូនដំណើរមិត្តភក្តិខ្ញុំបានទេ ?
តើអ្នកឈប់នៅទីនេះបានទេ ?
វាមិនជាថ្លៃប៉ុន្មានទេ ។ តើអ្នកអាចឲ្យខ្ញុំសម្រាកបន្តិចបានទេ ?
អត់ទោស តើអ្នកអាចប្រាប់ខ្ញុំថាទៅដល់ធីហ្វាននី បានដោយរបៀបណា ?
ជិះរថយន្តក្រុងលេខ៤៦ ពីចំណតរថយន្តក្រុងដែលនៅជិតបំផុតហើយចុះនៅចំណតទី៥ ។
តើមានសញ្ញាសម្គាល់នៅក្បែរៗនោះដែរទេ ?
មានធនាគារមួយនៅទល់មុខផ្លូវ ។
អត់ទោស តើយូនៀនស្វ៊ែរនៅឯណា ?
អត់ទោស តើអ្នកអាចប្រាប់ខ្ញុំថាខ្ញុំអាចទៅប្ដូររូបិយប័ណ្ណបរទេសបាននៅឯណា ?
ខ្ញុំចង់ទៅកាន់អាស័យដ្ឋាននេះ ។
តើផ្លូវណាទៅត្បូង ?
តើវាទៅឆ្វេងឬទៅស្តាំ ?
ទៅឆ្វេងហើយនៅកាច់ជ្រុងទី៣ ។
វានៅខាងចុងផ្លូវ ។
តើអ្នកអាចកត់ចំណាំវាលើផែនទីផងបានទេ ?
ទៅស្តាំហើយនៅកាច់ជ្រុងទី៣ ។
អត់ទោស តើខ្ញុំអាចសុំផែនទីទីក្រុងនេះបានទេ ?
នេះនែ មិនគិតថ្លៃទេ ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេថាទៅកាន់ វ៉េស្តមិនឺរ អាបេ បានដោយរបៀបណា ?
យក សាយខលឡាញ ឬ ឌីស្ទ្រីកឡាញ ។
រាជវាំង បាក់ឃីងហាម បើខ្ញុំទាយ ។
តើកន្លែងណាដែលពេញនិយមបំផុត ក្នុងការទៅទស្សនា ?
ខ្ញុំចង់ទៅរុក្ខវិថីទី៥ ។
តើសួនសត្វប្រូនហ្ស៍នឹងបើកនៅរដូវនេះមែនទេ ?
តើថ្ងៃណាខ្លះដែលវាបិទ ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេពីម៉ោងបើកនិងបិទ ?
តើអ្នកអាចប្រាប់ពីថ្ងៃល្អសម្រាប់ការដើរកម្សាន្តបានទេ ?
តើកំពង់ផែទូកជិះកម្សាន្តនៅឯណា ?
តើភាគច្រើនគេជួបជុំគ្នានៅឯណា ?
តើអ្នកប្រាប់ខ្ញុំពីកន្លែងគួរឲ្យចាប់អារម្មណ៍នៅជាយក្រុងបានទេ ?
បាទ ។ តើខ្ញុំអាចគ្រាន់តែចុចប៊ូតុងនេះមែនទេ ?
តើអ្នកអាចថតរូបឲ្យជាប់អគារនេះខាងក្រោយបានទេ ?
តើអ្នកអាចថតរូបខ្ញុំច្រើនជាងនេះទៀតបានទេ ?
តើអ្នកអាចជួយថតរូបឲ្យខ្ញុំបានទេ ?
ខ្ញុំនឹងផ្ញើរូបភាពឲ្យអ្នក ។
តើខ្ញុំអាចសុំអាស័យដ្ឋានរបស់អ្នកបានទេ ?
តើមានកន្លែងណានៅជុំវិញនេះដែលអាចទិញហ្វីលថតរូបបានទេ ?
ហ្វីលថតមានពណ៌មួយដុំ ចំនួន៣៦ប៉ុស្តិ៍ ។
ហាមមិនឲ្យមានការថតបើកភ្លើង ។
វាថ្លៃ៦ដុល្លារ ។
តើអ្នកចុះថ្លៃទេ ?
យើងមានការបញ្ចុះតម្លៃសម្រាប់និស្សិត សិស្ស និងសិស្សច្បង ។
តើខ្ញុំត្រូវធ្វើអ្វីខ្លះជាមួយនិងកាបូបរបស់ខ្ញុំ ?
អ្នកអាចទុកកាបូបអ្នកនៅទីនេះបាន ។
តើអ្នកបើកនៅថ្ងៃនេះរហូតដល់ម៉ោងប៉ុន្មាន ?
តើអ្នកអនុញ្ញាតឲ្យចូលរហូតដល់ម៉ោងប៉ុន្មាន ?
តើអ្នកមានសៀវភៅមគ្គទេសក៍ដែរទេ ?
តើអ្នកមានសៀវភៅមគ្គទេសក៍ជាភាសាជប៉ុនដែរទេ ?
តើអ្នកមានខិតប័ណ្ណខ្លីៗដោយមិនគិតថ្លៃដែរទេ ?
តើអ្នកមានសៀវភៅទេសចរណ៍ដែរទេ ?
តើការបង្ហាញសិល្បៈគួរឲ្យចាប់អារម្មណ៍នៅឯណា ?
តើអ្នកអាចប្រាប់ខ្ញុំបន្តិចបានទេអំពីសិល្បៈនៅក្នុងបន្ទប់នេះ ?
តើខ្ញុំអាចទិញវត្ថុអនុស្សាវរីយ៍ពីសារមន្ទីរនៅឯណា ?
តើមានកន្លែងសម្រាប់សម្រាកទេ ?
តើច្រកចេញនៅកន្លែងណាដែរ ?
តើមានព្រឹត្តិការណ៍អ្វីនៅយប់នេះ ?
ខ្ញុំចង់ទៅមើលការប្រគំតន្ត្រីរ៉ុក ។
តើខ្ញុំអាចទិញសំបុត្រសម្រាប់ថ្ងៃនេះបានទេ ?
តើពេលណាទើបអ្នកមានលក់សំបុត្រ ?
ខ្ញុំនឹងទិញសំបុត្រថ្ងៃតិចបំផុត ។
តើមានអ្វីកើតឡើងនៅថ្ងៃស្អែក ?
តើខ្ញុំអាចទៅមើល ឌឹ ហ្វេនថម អហ្វ ឌិ អូប៉េរ៉ា នៅឯណា ?
តើកម្មវិធីថ្ងៃនេះមានអ្វីខ្លះ ?
