ពីព្រោះតែរដូវក្តៅនៅក្នុងប្រទេសជប៉ុនជាធម្មតាក្តៅខ្លាំងណាស់ ហើយពួកយើងពុំមានម៉ាស៊ីនត្រជាក់នៅក្នុងថ្ងៃចាស់នោះទេ ។
ត្រីមាសគឺមានន័យក្នុងគោលបំណងដូចគ្នា ។ ពួកយើងឃើញវា ហើយបានចាប់ធាតុត្រជាក់ ។
ពុំមានអ្វីពិសេសទេ ។ ពួកគេពេញចិត្តផ្ការៀងរាល់ព្រឹក ។
ខ្ញុំជារឿយៗឃើញឆ្កែ និងឆ្មាសព្វថ្ងៃនេះ ។ តើជនជាតិជប៉ុនចូលចិត្តសត្វឬ ?
បាទ ជានិច្ចកាលមានមនុស្សជាច្រើនដែលថែរក្សាឆ្កៃមួយ ឬឆ្មាមួយ ឬទាំងពីរ ។
មានឆ្កែជាច្រើនប្រភេទ ត្រូវទេ ?
ក្រៅពីការបង្កាត់ពូជក្នុងស្រុក ឆ្កៃបរទេសជាច្រើនត្រូវបាននាំចូលមក ។
មួយចំនួនដូចជាឆ្កែ Kishu គឺធំ ប៉ុន្តែភាគច្រើនគឺមានទំហំមធម្យម ។
តើពួកគេឱ្យចំណីអ្វីទៅពួកវា ? អាហារឆ្កែ ?
ទេ ។ នៅសល់ក្នុងកេះរបស់ខ្ញុំ ។
តើអ្នកអាចទិញកូនឆ្កែនៅឯណា ?
នៅឯហាងលក់សត្វចិញ្ចឹម ។ ពួកគេលក់កូនឆ្មា សត្វកំប្រុក និងសត្វដទៃទៀតជាច្រើន ។
ឆ្មាក៏ជាសត្វចិញ្ចឹមមួយដែលមានប្រជាប្រិយ ត្រូវទេ ?
ឆ្មា និងឆ្កែគឺជាគូរប្រកួតប្រជែងនៃសត្វចិញ្ចឹម ។ អ្នកដែលចូលចិត្តឆ្មាមិនចូលចិត្តឆ្កែខ្លាំងទេ ហើយផ្ទុយមកវិញ ។
តើអ្នកចូលចិត្តមួយណាជាង ឆ្កែ ឬឆ្មា ?
បាទ ខ្ញុំចូលចិត្តទាំងពីរ ។
ហើយចុះបក្សី និងត្រីនៅតំបន់ត្រូពិច ?
ទាំងពីរគឺមានប្រជាប្រិយក្នុងចំណោមក្មេងៗ និងមនុស្សស្រី ។
ខ្ញុំបានលឺថាមានអ្នកខ្លះទុកពស់ជាសត្វចិញ្ចឹម ។ ខ្ញុំមិនយល់រឿងហ្នឹងទេ ។
ខ្ញុំមិនចូលចិត្តសត្វលូនទេ ។
តើថ្ងៃបុណ្យជាតិរបស់ប្រទេសជប៉ុនមានប៉ុន្មាន ?
ពួកយើងមានថ្ងៃបុណ្យជាតិដប់ប្រាំថ្ងៃ ។
អ្នកមានច្រើន ។
ពួកយើងពុំមានបុណ្យជាតិទាក់ទងនឹងសាសនាទេ ។
ពួកយើងពុំមានថ្ងៃបុណ្យជាតិដែលអាចផ្លាស់ប្ដូរបានផងដែរ ។
ថ្ងៃទីបួនខែឧសភាត្រូវបានដាក់ជាថ្ងៃបុណ្យជាតិនាពេលថ្មីៗនេះ ។
តើអ្វីជាចំនុចសំខាន់ ?
ថ្ងៃទីបីនិងទីប្រាំខែឧសភាត្រូវជាថ្ងៃបុណ្យជាតិ ។ ដូច្នេះ យើងក៍សំរេចចិត្តបន្ថែមថ្ងៃទីបួនមួយទៀតដើម្បីបង្គ្រប់អោយឈប់សំរាកបានបីថ្ងៃជាប់គ្នា
វាជាគោលនយោបាយមួយដើម្បីដោះស្រាយគំនិតពិភពលោកដែលថាជនជាតិជប៉ុនធ្វើការច្រើនហួសហេតុ ។
គេអាចនិយាយថាប្រវត្តិសាស្ត្រ ប្រពៃណី និងវប្បធម៌នៃជាតិមួយ កំណត់ឱ្យមានថ្ងៃបុណ្យជាតិរបស់ប្រទេសនោះ ។
តើប្រទេសជប៉ុនមានថ្ងៃវិស្សមកាលអ្វីខ្លះ ?
ដំបូងគឺថ្ងៃទីមួយខែមករាដែលជាថ្ងៃចូលឆ្នាំថ្មី ។ គេហៅថាអុសូកាត់ជឺ ។
ពួកយើងប្រារព្វពិធីចូលឆ្នាំថ្មីបន្ទាប់ពីឆ្នាំចាស់ឆ្លងផុតប្រកបដោយសុវត្ថិភាព ។
ផ្ទះនានាត្រូវបានតុបតែងដោយ កាដូម៉ាត់ជឹ និង អុកាហ្សារិ បើទោះបីជាទំលាប់នេះរៀងហួសសម័យក៏ដោយ ។
នារីៗស្លៀកពាក់យ៉ាងទាន់សម័យ ។
ម្ហូបអាហារចូលឆ្នាំថ្មីដែលគេហៅថា អាហារអុសេឈិ ក៍នៅត្រូវបានគេរៀបចំស្ទើរគ្រប់គ្រាន់ផ្ទះសូម្បីសម័យឥលូវ ។
មនុស្សរាប់លាននាក់ធ្វើដំនើរទៅវត្តដើម្បីធ្វើសក្ការៈបូជាដំបូងសំរាប់ឆ្នាំថ្មី ។
ថ្ងៃទីដប់ប្រាំខែមករាគឺជាថ្ងៃនៃមនុស្សពេញវ័យ ។
មនុស្សវ័យក្មេងដែលគ្រប់អាយុម្ភៃឆ្នាំក្នុងឆ្នាំមុនត្រូវបានគេផ្តល់កិត្តិយស ។
យោងតាមសៀវភៅប្រវត្តិសាស្ត្រដ៏ចំណាស់បំផុត វាគឺជាថ្ងៃដែលរាជាធិរាជដំបូងបានឡើងសោជរាជ្យលើរាជបល្ល័ង្គ ។
រាជាធិរាជបច្ចុប្បន្នរបស់ពួកយើងគឺជារាជាធិរាជទីមួយរយម្ភៃប្រាំ ។
ថ្ងៃទីម្ភៃខែមីនាគឺជាថ្ងៃនៃនិទាឃរដូវដែលពេលវាលាថ្ងៃ និងយប់ស្មើគ្នា ។
អាស្រ័យលើឆ្នាំនីមួយៗ វាអាចត្រវចំថ្ងៃទីម្ភៃមួយខែមីនា ។
វាជាថ្ងៃកណ្តាលនៃសប្ដាហ៍ដែលមានពេលថ្ងៃ និងយប់ស្មើគ្នា ហើយគ្រួសារជាច្រើនធ្វើដំនើរទៅកាន់ផ្នូរនៃបុព្វការីជនរបស់ពួកគេ ។
ថ្ងៃទីម្ភៃប្រាំបួនខែមេសាគឺជាថ្ងៃចំរើនព្រះជន្មនៃអធិរាជ Showa ដែលជាព្រះបិតារបស់អធិរាជបច្ចុប្បន្ន ។ គេហៅថ្ងៃនេះថាជាថ្ងៃពណ៌បៃតង ។
ថ្ងៃទីបីខែឧសភាគឺជាថ្ងៃបុណ្យរដ្ឋធម្មនុញ្ញ ។
នៅថ្ងៃទីបី ខែឧសភា ឆ្នាំមួយពាន់ប្រាំបួនរយសែសិបប្រាំពីរ រដ្ឋធម្មនុញ្ញបច្ចុប្បន្នរបស់ពួកយើងត្រូវបានប្រកាសឱ្យប្រើប្រាស់ ។
ថ្ងៃទីប្រាំ ខែឧសភា គឺជាថ្ងៃបុណ្យកុមារ ។
វាធ្លាប់ជាថ្ងៃដ៏សប្បាយអឹកធឹកក្នុងការឱ្យពរដល់ក្មេងប្រុសៗរីកចំរើនលូតលាស់ប្រកបដោយសុខភាពល្អ ។ គេបានហៅថ្ងៃនេះថា Tango-no-sekku ។
សព្វថ្ងៃនេះ កម្មវិធីសម្រាប់ថ្ងៃនេះត្រូវបានធ្វើឡើងសម្រាប់ទាំងក្មេងប្រុស និងក្មេងស្រី ។
ក្នុងថ្ងៃនេះ ខ្លែងរូបត្រីត្រូវបានបង្ហូតឡើង ហើយតុក្កតារូបសាមូរ៉ៃត្រូវបានដាក់តាំងបង្ហាញ ។
មានថ្ងៃដ៏សប្បាយអឹកធឹកសម្រាប់ក្មេងស្រីៗនៅថ្ងៃទីបីខែមីនា ។
ថ្ងៃទីដប់ប្រាំខែកញ្ញាគឺជាថ្ងៃនៃការគោរពសម្រាប់មនុស្សវ័យចំណាស់ ។
កម្មវិធីជាច្រើនត្រូវបានប្រារព្វឡើងសម្រាប់ប្រជាពលរដ្ឋចំណាស់ៗ ។
ថ្ងៃទីម្ភៃមួយខែកញ្ញាគឺជាថ្ងៃសរទរដូវដែលមានពេលថ្ងៃ និងពេលយប់ស្មើគ្នា ។
ថ្ងៃទីដប់ខែតុលាគឺជាថ្ងៃកីឡា ។
ថ្ងៃបុណ្យនេះត្រូវបានបង្កើតឡើងដើម្បីរំលឹកដល់ការប្រកួតកីឡាអូឡាំពិកទីក្រុងតូក្យូនៅក្នុងឆ្នាំមួយពាន់ប្រាំបួនរយហុកសិបបួន ។
ថ្ងៃទីបីខែវិច្ឆិកាគឺជាថ្ងៃបុណ្យវប្បធម៌ជាតី ។
ពិធីបុណ្យ និងសកម្មភាពបែបវប្បធម៌ត្រូវបានប្រារព្វឡើងនៅតាមទីកន្លែងនានា ។
លំដាប់លំដោយនៃសគុណវប្បធម៌ត្រូវបានផ្តល់ជូនដាច់ដោយឡែកពីគ្នារវាងវិចិត្រករ និងអ្នកប្រាជ្ញនៅថ្ងៃនេះ ។
ថ្ងៃទីម្ភៃបីខែវិច្ឆិកាគឺជាថ្ងៃថ្លែងអំណរគុណដល់ពលកម្ម ។
នៅឆ្នាំនានាកន្លងទៅ វាជាថ្ងៃដើម្បីអបអរសាទរការប្រមូលផលស្រូវ ។
ថ្ងៃទីម្ភៃបីខែធ្នូគឺជាថ្ងៃចំរើនព្រះជន្មរបស់អធិរាជ ។
ពួកយើងក៍មានព្រឹត្តិការណ៍ប្រចាំឆ្នាំជាច្រើនទៀតក្រៅអំពីថ្ងៃបុណ្យជាតិទាំងនេះ ។
ថ្ងៃទីបីខែកុម្ភៈគឺជាថ្ងៃសិតជឹប៊ឺង ដែលជាថ្ងៃមុននឹងរដូវផ្ការីកចាប់ផ្តើមយោងតាមប្រតិទិនច័ន្ទគតិ ។ ពេលខ្លះវាត្រូវចំថ្ងៃទីបួនខែកុម្ភៈ ។
ពួកយើងបាចសណ្តែងសៀងលីងដើម្បីដេញអស់រាល់ព្រលឹងអាក្រក់ ។
វាជាថ្ងៃបុណ្យសម្រាប់ក្មេងស្រីៗ ហើយកូនក្រមុំជ័រជាច្រើនក្នុងសំលៀកបំពាក់ប្រពៃណីត្រូវបានដាក់តាំងបង្ហាញ ។
ព្រឹត្តិការណ៍សំខាន់បំផុតនៅខែមេសាគឺជាការទស្សនាទេសភាពរីកស្គុសស្គាយនៃផ្កាឆឺរី ។ ប្រជាជនជាច្រើនប្រារព្វពិធីជប់លៀងនៅក្រោមដើមឆឺរី ។
នៅថ្ងៃទីប្រាំពីរខែកក្កដាគេប្រារព្វពិធី Tanabata មានន័យថាពិធីបុណ្យដួងតារា ។
មនុស្សម្នាតុបតែងដើមឬស្សីដោយព្យូរសន្លឹកក្រដាសនៅតាមមែកឬស្សី រួចសរសេរការបួងសួងរបស់ពួកគេនៅលើក្រដាសទាំងនោះ ។
អុបុង គឺជាថ្ងៃបុណ្យនៃព្រះពុទ្ធសាសនាដើម្បីឧទ្ទិសដល់ព្រលឹងបុព្វការីជនដែលបានចែកឋានទៅ ។ វាត្រូវបានប្រារព្វឡើងក្នុងខែសីហានៅតាមក្នុងតំបន់ផ្សេងៗ ។
វាត្រូវបានគេជឿថាព្រលឹងបុព្វការីជនទាំងឡាយនឹងត្រឡប់មករកគ្រួសាររបស់ពួកគេនៅអំឡុងពិធីបុណ្យ Obon ។
មនុស្សម្នាជាច្រើនចាកចេញពីទីក្រុងរួចធ្វើដំនើរត្រឡប់មកស្រុកកំណើតរបស់ពួកគេដើម្បីប្រារព្វពិធី បុណ្យ Obon ។ វាហាក់ដូចជាវិស្សមកាលរដូវក្តៅ ។
នៅក្នុងរដូវនេះ បុងអុដូរិ ឬ របាំបុង ដែលជារបាំម្យ៉ាងត្រូវបានសម្តែងនៅក្នុងប្រទេសជប៉ុន ។
មនុស្សជាច្រើនបានជួបជុំគ្នាដើម្បីទស្សនាព្រះច័ន្ទពេញវង់នាពេលយប់នៅក្នុងខែកញ្ញាដែលភ្លឺច្បាស់ជាងនៅថ្ងៃទីដប់ប្រាំខែសីហាតាមប្រតិទិនច័ន្ទគតិ ។
ថ្ងៃទីដប់ប្រាំខែវិច្ឆិកាគឺជាថ្ងៃ ស៊ីឈិ‌-‌ហ្កូ-សាន ឬហៅថាបុណ្យ ប្រាំពីរ ប្រាំ បី ។
ក្មេងស្រីៗអាយុប្រាំពីរឆ្នាំ ក្មេងប្រុសៗអាយុប្រាំឆ្នាំ និងក្មេងប្រុសក្មេងស្រីអាយុបីឆ្នាំត្រូវបាននាំទៅកាន់វត្តអារ៉ាម ។
ឪពុកម្តាយ និងកូនៗថ្លែងអំនរគុណចំពោះព្រះជាម្ចាស់ដែលក្មេងៗបានរីកធំធាត់ដល់អាយុទាំងនោះប្រកបដោយសុវត្ថិភាព ។
ក្មេងៗទាំងអស់បានស្លៀកពាក់ដូចជាមនុស្សពេញវ័យ ។
ម្យ៉ាងទៀង ខែធ្នូគឺជារដូវនៃការជូនអំណោយ ដែលពួកយើងហៅថា oseibo ។ ពួកយើងផ្ញើរអំណោយទៅកាន់អ្នកដែលធ្លាប់មានគុណលើពួកយើងពីមុនមក ។
ពួកយើងសរសេរប័ណ្ណសួស្តីឆ្នាំថ្មី ហើយផ្ញើរទៅកាន់ពួកគេ ។ ប័ណ្ណទាំងនោះនឹងទៅដល់នៅថ្ងៃទីមួយខែមករា ។
នៅពេលយប់នៃមួយថ្ងៃមុនចូលឆ្នាំថ្មី ពួកយើងបរិភោគមីបណ្តើរ ក្នុងពេលរង់ចាំទស្សនា និងស្តាប់សំលេងជួងតាមកញ្ចក់ទូរទស្សន៍ដែលបន្លឺចេញពីទីវត្តអារ៉ាមនានាជាសញ្ញានៃការបញ្ចប់នៃឆ្នាំចាស់តាមទូរទស្សន៍នៅអំឡុងពេលញ៉ាំមី ។ នេះជារបៀបនៃការបញ្ចប់ឆ្នាំរបស់ពួកយើង ។
អ្នកគួរតែរាយការណ៍ទៅប៉ូលីសភ្លាម ។
ខ្ញុំបានភ្លេចកាបូបរបស់ខ្ញុំនៅក្នុងឡានឈ្នួល ។
នាំគ្នាទាក់ទងទៅក្រុមហ៊ុនតាក់ស៊ី ។
ខ្ញុំនឹងព្យាយាមស្វែងរកវា ។
តើវាជាកាបូបបែបណា ?
វាជាកាបូបពណ៌ខ្មៅ ។
នៅលើកាបូបនោះមានស្លាកឈ្មោះរបស់ខ្ញុំ ។
តើមានអ្វីនៅក្នុងកាបូបនោះ ?
ពួកគេនិយាយថាពួកគេនឹងទាក់ទងមកអ្នកប្រសិនបើពួកគេរកវាឃើញ ។
សូមសរសេរអំពីទីកន្លែងដែលយើងអាចទាក់ទងអ្នកបាន ។
តើមាននរណាម្នាក់ដែលចេះនិយាយភាសាអង់គ្លេសដែរឬទេ ?
តើខ្ញុំអាចសុំក្រដាសមួយសន្លឹកដែលបញ្ជាក់ថាខ្ញុំត្រូវបានប្លន់ដែរឬទេ ?
មានគ្រោះថ្នាក់ចរាចរមួយបានកើតឡើង ។
នាំគ្នាទូរស័ព្ទទៅប៉ូលីស ។
នាំគ្នារាយការណ៍ដល់ក្រុមហ៊ុនជួលឡាន ។
តើលេខអជ្ញារប័ណ្ណមានលេខប៉ុន្មាន ?
អ្នកគួរតែទៅកាន់មន្ទីរពេទ្យ ។
តើអ្នកចងចាំថាវាកើតឡើងយ៉ាងដូចម្តេចដែរឬទេ ?
អ្នកនឹងត្រូវបានជួយសង្គ្រោះបន្ទាន់ ។
តើអ្នកមានឈាមប្រភេទអ្វី ?
តើអ្នកកំពុងឈឺចាប់ឬ ?
អ្នកមើលទៅមិនសូវស្រួលទេ ។
ខ្ញុំឈឺត្រង់ពោះ ។
តើនៅកន្លែងណាឱ្យច្បាស់លាស់ ?
តើជាការឈឺចាប់ដូចម្តេច ?
តើវាជាការឈឺស្ពឹកឬ ?
ចាំខ្ញុំស្ទង់កំដៅរបស់អ្នក ។
អ្នកគួរតែទៅជួបវេជ្ជបណ្ឌិត ។
សូមឱ្យថ្នាំខ្ញុំបានទេ ?
ខ្ញុំនឹងសរសេរវេជ្ជបញ្ជាសម្រាប់អ្នក ។
សូមយកវេជ្ជបញ្ជានេះទៅទិញថ្នាំនៅឱសថស្ថាន ។
ញ៉ាំថ្នាំនេះបីដងក្នុងមួយថ្ងៃបន្ទាប់ពីញ៉ាំអាហារ ។
ភាគខាងជើងរបស់ប្រទេសជប៉ុនលាតសន្ធឹងដល់ទីក្រុងម៉ុងទ្រីអាស់នៃប្រទេសកាណាដា
កោះភាគខាងត្បូងបំផុតរបស់ប្រទេសជប៉ុនលលាតសន្ធឹងយ៉ាងឆ្ងាយដល់ចុងតំបន់ហ្វ្លូរីដា ។
ប្រទេសជប៉ុនផ្គុំដោយកោះបួនជាសំខាន់ ។
លើសពីនេះទៀត មានកោះតូចៗច្រើនជាងបីពាន់កោះ ។
ប្រទេសជប៉ុនជាប់នឹងមហាសមុទ្រប៉ាស៊ីហ្វិកនៅភាគខាងត្បូង និងជាប់សមុទ្រជប៉ុននៅភាគខាងជើង ។
ច្រើនជាងចិតសិបភាគរយនៃផ្ទៃដីគឺជាតំបន់ភ្នំគ្របដណ្តប់ដោយព្រៃ ។
វាជាមូលហេតុដែលធ្វើឱ្យនៅសល់ដីតិចតួចប៉ុណ្ណោះសម្រាប់ការដាំដុះ ។
ចំនួនប្រជាជនប្រទេសជប៉ុនមានប្រហែលមួយរយម្ភៃលាននាក់ ។
ចំនួនប្រជាជនរបស់ពួកយើងមានការកើនយ៉ាងយឺតៗបំផុត ។
អត្រាកំណើតមានការថយចុះ ។
អត្រាស្លាប់មានការថយចុះផងដែរ ។
ការរំពឹងនៃអាយុជីវិតរបស់ជនជាតិជប៉ុនគឺបានវែងជាងគេបំផុតលើពិភពលោក ។
ស្ត្រីអាចរស់នៅបានវែងជាងបុរសប្រហែលប្រាំឆ្នាំ ។
ចំនួនប្រជាជននៃមនុស្សចំណាស់មានការកើនឡើងថេរ ។
ម្នាក់ក្នុងចំណោមប្រជាជនបួននាក់មានអាយុច្រើនជាងហុកសិបប្រាំឆ្នាំ ។
