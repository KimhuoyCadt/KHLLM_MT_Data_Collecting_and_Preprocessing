នៅម៉ោងប្រាំបីគត់ ។
ដូចនេះខ្ញុំនឹងទៅដល់បន្ទប់របស់អ្នកនៅម៉ោងប្រាំបីហាសិបនាទី ។
សូមទុកវានៅខាងក្រៅបន្ទប់របស់អ្នកនៅព្រឹកស្អែក ។
សូមបញ្ជូននរណាម្នាក់មកយកឥវ៉ាន់របស់ខ្ញុំចុះក្រោម ។
ខ្ញុំបានញ៉ាំទឹកក្រូចនៅក្នុងបាតូច ។
ខ្ញុំគិតថាមានកំហុសនៅក្នុងវិក័យប័ត្រនេះ ។
តើអ្នកអាចរក្សាទុកឥវ៉ាន់របស់ខ្ញុំរហូតដល់ម៉ោងប្រាំគត់បានដែរឬទេ ?
នេះជាអាស័យដ្ឋានបន្តទៅទៀតរបស់ខ្ញុំ ។
តើអ្នកមានអត្រាបញ្ចុះខ្លះសម្រាប់សមាជិកដែរឬទេ ?
តើមានផ្ទះបាយមួយទេ ?
តើខ្ញុំអាចចំអិនអាហារខ្លួនឯងបានទេ ?
តើខ្ញុំអាចទៅទីនោះដោយឡានក្រុង ឬផ្លូវក្រោមដី ?
ខ្ញុំនឹងទៅដល់ទីនោះមុនម៉ោងប្រាំពីរយប់នេះ ។
តើខ្ញុំប្រើអាងទឹក ឬផ្កាឈូកនៅយប់នេះ ?
ខ្ញុំចង់ស្នាក់នៅមួយថ្ងៃថែមទៀត ។
ខ្ញុំចង់បានភោជនីយដ្ឋានដែលមានតម្លៃសមហេតុផល ។
ខ្ញុំចង់បានភោជនីយដ្ឋានស្ងប់ស្ងាត់មួយ ។
ខ្ញុំចង់បានភោជនីយដ្ឋានមួយជាមួយនិងបរិយាកាសរីករាយ ។
តើតំបន់សំខាន់សម្រាប់ភោជនីយដ្ឋាននៅឯណា ?
តើមានភោជនីយដ្ឋានដែលមិនថ្លៃនៅជិតទីនេះដែរឬទេ ?
តើអ្នកមានស្គាល់ភោជនីយដ្ឋានខ្លះដែលបើកនៅពេលនេះដែរឬទេ ?
តើភោជនីយដ្ឋានអ៊ីតាលីដែលជិតជាងគេនៅឯណា ?
ខ្ញុំចង់កក់តុមួយសម្រាប់មនុស្សបីនាក់ ។
ពួកយើងជាក្រុមមួយមានមនុស្សប្រាំមួយនាក់ ។
ពួកយើងចង់បានតុមួយទាំងអស់គ្នា ។
ពួកយើងនឹងមកនៅម៉ោងប្រាំបីគត់ ។
ខ្ញុំសុំទោស ។ ពួកយើងមានភ្ញៀវច្រើនណាស់ នៅល្ងាចនេះ ។
ពួកយើងអាចរង់ចាំរហូតដល់ម៉ោងយប់ជ្រៅ ។
ម៉ោងប្រាំបួនគួរតែល្អ ។
ពួកយើងចង់បានតុមួយដែលមានទេសភាពសួនច្បារ ។
វាមិនអីទេ ។ សុំឈ្មោះអ្នកមក ។
តើអ្នកមានអ្វីសម្រាប់ភាពពិសេសនៅថ្ងៃនេះ ?
តើស្ត្រីគួរតែស្លៀកពាក់សំលៀកបំពាក់ផ្លូវការទេ ?
សូមកុំពាក់ខោខោប៊យ ។
ខ្ញុំសុំទោស ប៉ុន្តែខ្ញុំចង់លុបចោលការកក់ ។
តើពួកយើងអាចបានតុមួយនៅជ្រុងបានដែរឬទេ ?
ប្រាកដជាមាន ។ សូមមកតាមផ្លូវនេះ ។
តុរបស់ពួកយើងពេញអស់ហើយឥលូវនេះ ។ តើអ្នកអាចរង់ចាំមួយភ្លែតបានដែរឬទេ ?
ខ្ញុំទាយថាពួកយើងអាចផ្តល់តុមួយឱ្យអ្នកនៅក្នុងរយៈពេលសាមសិបនាទី ។
តើអ្នកមានភេសជ្ជៈអ្វីសម្រាប់ជាស្រាឆ្ងាញ់បាយ ?
តើអ្នកមានស្រាបៀក្នុងតំបន់ដែរឬទេ ?
ខ្ញុំចង់បានស្រាក្នុងតំបន់ខ្លះ ។
ខ្ញុំចង់បានស្រាក្រហមបារាំង ។
ខ្ញុំសូមកុម្ម៉ង់បានដែរឬទេ ?
តើពួកយើងអាចសុំវិក័យប័ត្រដាច់ដោយឡែកបានទេ ?
តើអ្នកមានអ្វីពិសេសទេថ្ងៃនេះ ?
ខ្ញុំចង់បានអ្វីមួយដែលពិសេស ។
តើអ្នកមានតុដែលគិតលុយថេរដែរឬទេ ?
ខ្ញុំចង់បានតុដែលគិតលុយថេរ ។
ខ្ញុំចង់បានអាហារសម្រន់ និងម្ហូបសាច់ ។
ខ្ញុំចង់បានអាហារពេលល្ងាចដែលមានតម្លៃថោកជាងសាមសិបដុល្លាររាប់បញ្ចូលទាំងភេសជ្ជះ ។
ខ្ញុំចាំបាច់ត្រូវជៀសវាងអាហារដែលមានជាតិធាត់ ។
តើខ្ញុំអាចបានវាមិនសូវហើរបានទេ ?
តើអ្នកចង់បានសាច់បន្ទះរបស់អ្នកបែបណា ?
ខ្ញុំចាំបាច់ត្រូវជៀសវាងអាហារដែលមានជាតិអំបិល ។
ខ្ញុំចាំបាច់ត្រូវជៀសវាងអាហារដែលមានជាតិស្ករ ។
តើអាចឱ្យទឹកបរិសុទ្ធខ្ញុំមួយបានទេ ?
សូមឱ្យទឹកបរិសុទ្ធដែលគ្មានជាតិកាបូណាត ។
វាល្អខ្លាំងណាស់ ។
ខ្ញុំចង់បានបង្អែមមួយ ។
ខ្ញុំចង់បានអ្វីមួយដែលស្រទន់ គ្រាន់តែប្រូមា និងនំខេកខ្លះមក ។
តើខ្ញុំអាចសុំវាបន្តិចបានទេ ?
តើផ្លែឈើប្រភេទណាដែលអ្នកមាន ?
តើកាហ្វេរាប់បញ្ចូលក្នុងអាហារនេះទេ ?
តើអ្នកអាចហុចម្រេចឱ្យខ្ញុំបានទេ ?
មួយនេះរៀងឆៅបន្តិច ។
វាច្រើនជាងអ្វីដែលខ្ញុំអាចញ៉ាំបាន ។
គ្មានអ្វីទៀតទេ អរគុណអ្នក ។
តើខ្ញុំគួរតែបង់ប្រាក់នៅឯណា ?
តើការគិតបា្រក់ទាំងមូលរាប់បញ្ចូលដែរឬទេ ?
សូមឱ្យវិក័យប័ត្រខ្ញុំបានទេ ?
សូមសរសេរលេខបន្ទប់របស់អ្នក ។
តើអ្នកអាចគិតវាទៅក្នុងថ្លៃបន្ទប់របស់ខ្ញុំបានដែរឬទេ ?
តើអ្នកនឹងញ៉ាំនៅទីនេះ ឬត្រូវយកទៅ ?
សូមឱ្យហតដកខ្ញុំបានទេ ?
សុំជាមួយនិងទឹកប៉េងប៉ោះ ។
ហើយចុះខ្ទឹមបារាំង ឬស្ពៃខៀវ ?
សូមសាំងវ៉ិចមួយ ។
តើអ្នកចង់បានមួយណាសម្រាប់នំប៉័ង ស្រូវស ស្រូវរ៉ៃ ឬស្រូវសាល៉ី ?
តើអ្នកនឹងញ៉ាំនៅទីនេះ ឬនេះត្រូវយកចេញទៅខាងក្រៅ ?
ខ្ញុំចង់បានសាច់គោដុតជាមួយនិងប្រូម៉ាស្វីស ប៉េងប៉ោះ និងសាឡាដលេទូស ។
តើអ្នកអាចបញ្ជាក់អ្វីមួយសម្រាប់បញ្ជាក់ពីអាយុរបស់អ្នកបានដែរឬទេ ?
តើអ្នកមានសាលាដពណ៌បៃតងទេ ?
ខ្ញុំបានស៊ុតក្រឡុក ។
សូមឱ្យសាំងវ៉ិចសាច់ភ្លៅមួយមក ?
តើខ្ញុំអាចយកកៅអីនេះបានដែរឬទេ ?
តើខ្ញុំអាចយកកូនកាំបិត និងសមនៅឯណា ?
តើអ្នកមានអំបិលទេ ?
តើអ្នកមានម្រេចទេ ?
ថ្ងៃទីដប់ ខែមិថុនា ។
ខ្ញុំចង់បញ្ជាក់ពីពេលវេលាដែលវាចាកចេញ ។
ខ្ញុំនៅតែមិនអាចរកឃើញឈ្មោះរបស់អ្នកនៅក្នុងបញ្ជីកក់បានទេ ។
យ៉ាងណាក៏ដោយ ពួកយើងមានមានការកក់ថ្មីសម្រាប់ជើងហោះហើរនេះ ។ គ្មានបញ្ហាទេ ។
កន្លែងអង្គុយថ្នាក់សេដ្ឋកិច្ចមួយ តើមិនអីទេឬ ?
អរគុណច្រើន ។ តើអ្នកត្រួតពិនិត្យចូលនៅម៉ោងប៉ុន្មាន ?
ពីរម៉ោងមុនពេលវេលាចាកចេញ ។
ដូចនេះ សូមធ្វើការកក់ថ្មីឱ្យខ្ញុំមួយ ។
សុំទោស ប៉ុន្តែជើងហោះហើរនេះពេញហើយ ។
តើអ្វីដែលអាចទៅរួចដែលខ្ញុំអាចបានកន្លែងអង្គុយប្រសិនបើខ្ញុំរង់ចាំ ?
នៅថ្ងៃខានស្អែក គឺថ្ងៃសុក្រ ។
តើលេខជើងហោះហើរនេះគឺប៉ុន្មាន និងពេលវាលាចេញដំណើរ ?
បីរយសាមសិបដុល្លារសម្រាប់មនុស្សម្នាក់សម្រាប់ពីរផ្នែក ។
តើអ្នកអាចអនុវត្តផ្សេងគ្នានៃសំបុត្រដែលខ្ញុំមានបានទេ ?
ទេ ពួកយើងមិនអាចទ ។ អ្នកអាចត្រូវសងប្រាក់វិញសម្រាប់ផ្នែកដែលមិនបានប្រើនៃសំបុត្ររបស់អ្នកនៅក្នុងប្រទេសជ ប៉ុន ។
ខ្ញុំចង់បានបន្ទប់គ្រែមួយ ចង់បាននៅជិតព្រលានយន្តហោះជាង ។
មានសណ្ឋាគារបីនៅក្នុងព្រលានយន្តហោះ ។ តើប្រភេទអ្វីដេលអ្នកចង់បាន ?
សូមអាមួយកម្រិតមធ្យម ។
