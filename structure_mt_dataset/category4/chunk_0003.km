សាច់គោបន្ទះរបស់ខ្ញុំមិនទាន់មកទេ ។
តើខ្ញុំអាចរកបន្ទប់ទឹកនៅឯណាបាន ?
មានប្រាំមួយនាក់នៅក្នុងពិធីជប់លៀងរបស់ពួកយើង ។ ពួកយើងចង់អង្គុយនៅតុជាមួយគ្នា ។
សូមអភ័យទោស ។ តើខ្ញុំអាចកម៉្មង់ឥលូវបានទេ ?
តើអ្នកមានទឹកស៊ីអ៊ីវទេ ?
តើអ្នកទទួលកាតវីសាទេ ?
តើអ្នកអាចបំរើអ្វីបន្ទាន់ ?
ខ្ញុំខ្លាចក្រែងតែនេះមិនមែនជាអ្វីដែលខ្ញុំកម៉្មងទេ ។
សូមប៊ឺហ្គឺប្រូម៉ាសមួយនិងកូកាកូឡាតូចមួយ ។
សូមដាក់បន្ថែមទឹកប៉េងប៉ោះនិងខ្ទឹមបារាំងហើយម៉ូតាតតិច ។
សូមដាក់វាក្នុងនំរាងសាជី ។
ប៊ឺហ្គឺប្រូម៉ាសមួយនិងកូកាកូឡាតូចមួយ ។ តើវានឹងអស់ហើយ ?
តើវានេះគឺសំរាប់ខ្ចប់រឺបរិភោគនៅទីនេះ ?
ខ្ញុំនឹងខ្ចប់យកទៅ ។
សូមអោយវាមកនៅម៉ោងពីរកន្លះ ។
ជាមួយម៉ូតាតទឹកប៉េងប៉ោះរឺជ្រក់ ?
តើនេះគឺសំរាប់ខ្ចប់រឺបរិភោគនៅទីនេះ ?
នៅលើនំបុ័ងពណ៌ស នំបុ័ងស្រូវរ៉ៃ ឬក៏ នំបុ័ងស្រូវសាលី ?
កាហ្វេជាមួយក្រែមនិងស្ករ ។
ខ្ញុំចង់បានការ៉េម ។
តើរសជាតិអ្វីដែលអ្នកចូលចិត្ត ?
ខ្ញុំចង់បានរសជាតិវ៉ានិឡា ។ សូមដាក់វានៅក្នុងនំរាងសាជី ។
សូមបន្ថែមម៉ូតាត ។
សូមដាក់ម៉ូតាតតិច ។
តើពួកយើងអាចយកការកុម្ម៉ង់របស់ពួកយើងទៅក្រៅបានទេ ?
តើនំបុ័ងប្រភេទអ្វីដែលអ្នកមាន ?
តើអ្នកអាចសូមរៀបតុអោយស្អាតអោយខ្ញុំបានទេ ?
ខ្ញុំកំពុងរង់ចាំប្រាក់អាប់របស់ខ្ញុំ ។
ខ្ញុំសុំទោស ។ ខ្ញុំបានធ្វើអោយកំពបកាហ្វេខ្លះ ។
តើនេះគឺភោជនីយដា្ឋនសេវាកម្មផ្ទាល់ខ្លួនមែនទេ ?
សូមកុំដាក់ទឹកប៉េងប៉ោះ ។
សូមកុំដាក់ម៉ូតាត ។
ខ្ញុំចង់ប្ដូរប្រាក់យេនជប៉ុនទៅជាដុល្លារ ។
តើខ្ញុំអាចប្ដូរសែកអ្នកដំណើរទៅជាប្រាក់សុទ្ធនៅទីនេះបានទេ ?
សូមសន្លឹកម្ភៃចំនួនបួន សន្លឹកដប់ចំនួនមួយ និងលុយរាយ ។
អត្រាថ្ងៃនេះគឺមួយរយសាមសិបយេនទៅជាដុល្លារ ។ តើអ្នកចង់ប្ដូរប៉ុន្មាន ?
បីម៉ឺនយេនសូមរួមបញ្ចូលប្រាក់រាយខ្លះផង ។
បាទលោក ។ តើលោកមានអ្វីជាការបញ្ជាក់ទេ ?
សូមមួយរយដុល្លារ ។ សូមសន្លឹកម្ភៃចំនួនបួន សន្លឹកដប់ចំនួនមួយ និងលុយរាយ ។
បាន ។ តើអ្នកអាចចុះហត្ថលេខាលើសែកនៅទីនេះមែនទេ ?
សូមបំបែកប្រាក់នេះ ។
ខ្ញុំចង់បើកប្រាក់ពីររយដុល្លារនៅកាតវីសារបស់ខ្ញុំ ។
ខ្ញុំចង់បើកគណនីមួយ ។
ខ្ញុំមិនគិតថាការគណនានេះគឺត្រឹមត្រូវទេ ។
តើអត្រាប្ដូរប្រាក់នៅថ្ងៃនេះគឺប៉ុន្មាន ?
តើអ្នកអាចសូមប្ដូរវានេះបានទេ ?
តើធនាគារបើកនៅថ្ងៃសៅរ៍ទេ ?
តើមានសាខាធនាគារជប៉ុននៅក្បែរទីនេះទេ ?
ខ្ញុំចង់ផ្ញើរកាតផូស្តារខ្លះទៅប្រទេសជប៉ុនដោយតាមផ្លូវអាកាស ។
សូមអភ័យទោស ។ តើខ្ញុំអាចទិញតែមប្រៃសណីយ៍នៅទីនេះបានទេ ?
ទេ ។ សូមទៅកាន់បង្អួចនៅខាងនោះ ។
ខ្ញុំចង់ផ្ញើរកាតផូស្តារខ្លះទៅប្រទេសជប៉ុនដោយតាមផ្លូវអាកាស ។ តើតែមប្រៃសណីយ៍គឺមានប៉ុន្មាន ?
មួយៗតំលៃហាសិបសេន ។
អោយខ្ញុំតែមហាសិបសេនចំនួនដប់ ។
បាន ។ ប្រាំដុល្លារសរុបទាំងអស់ ។
ដោយការផ្ញើរតាមផ្លូវគោកនិងផ្លូវទឹក ។ តើវាមានរយះពេលយូរប៉ុន្មានដើម្បីទៅដល់ប្រទេសជប៉ុន ?
ប្រហែលមួយខែ ។ តើមាតិកាគឺអ្វីខ្លះ ?
សូមបំពេញបែបបទការប្រកាសគយនេះហើយបិទវានៅលើកញ្ចប់ឥវ៉ាន់ ។
តើនេះគឺអាស័យដ្ឋានក្រៅមែនទេ ?
ខ្ញុំចង់បញ្ជាក់មាតិកា ។
សូមផ្ញើរសំបុត្រនេះទៅប្រទេសជប៉ុនដោយការដឹកជញ្ចូនពិសេស ។
សូមផ្ញើសំបុត្រតាមយន្តហោះ ។
តើខ្ញុំអាចរករថយន្តក្រុងទៅកាន់ទីក្រុងញ៉ូវយ៉កនៅឯណា ?
តើមានសេវាកម្មរថយន្តក្រុងទៅកាន់លីនខនសេនធើទេ ?
តើនេះគឺរថយន្តក្រុងត្រឹមត្រូវសំរាប់ក្រុមហ៊ុនទេសចរណ៍ប្រទេសជប៉ុនមែនទេ ?
ខ្ញុំចង់យកដំណើរទេសចរណ៍ដើរទស្សនានៃទីក្រុងនេះ ។
ជិះរថយន្តក្រុងលេខបួនហើយចុះនៅស្ថានីយ ។
តើខ្ញុំត្រូវទិញសំបុត្រមុនពេលចេញដំណើរមែនទេ ?
ទេ ។ បង់ប្រាក់ទៅអ្នកបើកបរ ។
បាននេះហើយ ។ រថយន្តក្រុងទៅខាងជើងលេខប្រាំទៅផ្លូវនោះ ។
វាគួរតែនៅទីនេះក្នុងរយះពេលដប់ប្រាំនាទី ។
តើខ្ញុំអាចប្រាប់ដំណឹងទៅអ្នកបើកបរនៅពេលខ្ញុំចង់ចុះពីរថយន្តក្រុងដោយរបៀបណា ?
ទាញខ្សែភ្លើង ។
ចុចកណ្តឹងរោទិ៍ ។
មួយដុល្លារហាសិបសេន ។
សូមអោយខ្ញុំដឹងនៅពេលពួកយើងទៅដល់ទីនោះ ។
ចុះដំណើរទេសចរណ៍សំរាប់កន្លះថ្ងៃដោយរថយន្តក្រុងនេះយ៉ាងម៉េចដែរ ? វាមានរយះពេលបួនម៉ោង ។
គួរអោយចាប់អារម្មណ៍ ។ តើដំណើរទេសចរណ៍គឺមានតំលៃប៉ុន្មាន ?
សាមសិបប្រាំដុល្លារ ។
តើចំណតរថយន្តក្រុងណាមួយនៅក្បែរកីឡាដ្ឋានសៀរ ?
តើខ្ញុំត្រូវចុះចំណតនៅឯណាសំរាប់ស្ថានទូតជប៉ុន ?
តើមានចំណតប៉ុន្មានមុននឹងខ្ញុំចុះចំណតសំរាប់យ៉ូនានស្វ៊ែរ ?
តើខ្ញុំអាចទៅដល់ឆ្នេរវេណាយដោយរថយន្តក្រុងទេ ?
តើតំលៃជិះគឺប៉ុន្មាន ?
តើខ្ញុំត្រូវជិះរយះពេលប៉ុន្មាន ?
តើខ្ញុំត្រូវទៅប្ដូររថយន្តក្រុងដើម្បីទៅហូលីហ្វូតនៅឯណា ?
សូមនាំខ្ញុំទៅអាកាសយាន ។
តើវានឹងមានតំលៃប៉ុន្មានក្នុងការទៅសណ្ឋាគារហៀរតុន ?
សូមដាក់វ៉ាលីរបស់ខ្ញុំនៅកន្លែងដាក់ឥវ៉ាន់ខាងក្រោយឡាន ។
បត់ឆ្វេងហើយអ្នកនឹងរកឃើញវា ។ អ្នកមិនអាចខកវាទេ ។
តើក្រុមហ៊ុនទេសចរណ៍ណាមួយ ?
នេះគឺម្ភៃ ។ ទុកប្រាក់អាប់ ។
ប្រហែលម្ភៃដុល្លារ ។
អ្នកបើកឡានខ្ញុំមិនមានពេលវេលាច្រើនទេ ។ តើអ្នកអាចសូមប្រញាប់បានទេ ?
ពួកយើងគួរទូរស័ព្ទទៅប៉ូលីសល្អជាង ។
សូមឈប់នៅទីនេះ ។
សូមទៅកាន់អាស័យដ្ឋាននេះ ។
ខ្ញុំនឹងទូរស័ព្ទទៅក្រុមហ៊ុនរបស់អ្នក ។
តើខ្ញុំអាចទទួលបានរថយន្តឈ្នួលនៅទីនេះទេ ?
តើអ្នកអាចហៅទូរស័ព្ទទៅរថយន្តតាក់ស៊ីសំរាប់ខ្ញុំបានទេ ?
អ្នកកាន់ឥវ៉ាន់ ។ សូមយួរវ៉ាលីរបស់ខ្ញុំទៅកាន់រថយន្តតាក់ស៊ី ។
តើវានឹងត្រូវចំណាយរយះពេលប៉ុន្មានដើម្បីទៅដល់អាកាសយានដ្ឋាន ?
តើអ្នកអាចរង់ចាំខ្ញុំបានទេ ?
វានោះមិនមែនជាអ្វីដែលបាននិយាយពីមុនទេ ។
តើខ្ញុំអាចសូមបិទបង្អួចបានទេ ?
តើអ្នកអាចសូមបើកម៉ាស៊ីនត្រជាក់បានទេ ?
តើអ្នកអាចបើកបរយឺតបន្តិចបានទេ ?
សូមទុកប្រាក់អាប់ ។
សូមសំបុត្រសំរាប់ទៅហើយត្រលប់មកវិញទៅកាន់បូស្កន់ ។
តើរថភ្លើងបន្ទាប់សំរាប់វ៉ាស៊ីនតោនឌីស៊ីគឺនៅពេលណា ?
សំបុត្រដែលមិនសូវនិយម ?
វានឹងត្រូវជាប៉ែតសិបដុល្លារ ។
មួយម្ភៃនាទី ។ វានឹងចេញទៅទាន់ម៉ោង ។
តើផ្លូវដែកអ្វីដែលវានឹងចាកចេញ ?
វាមិនទាន់បានសំរេចទេ ។ លេខផ្លូវដែកនឹងត្រូវបានប្រកាសនៅទីនោះដប់ប្រាំនាទីមុនចេញដំណើរ ។
ដើរទៅត្រង់សំរាប់ពីរអាគារហើយអ្នកនឹងរកឃើញវា ។ អ្នកមិនអាចខកវាទេ ។
តើខ្ញុំអាចទទួលបានកាកនៅឯណា ?
អ្នកអាចទទួលពួកវាបាននៅទីនោះ ។
តើតំលៃទៅកាន់វ៉ាស៊ីនតោនឌីស៊ីគឺប៉ុន្មាន ?
តើវាត្រូវចំណាយរយះពេលប៉ុន្មានដើម្បីទៅដល់ភីឡាឌឺភៀល ?
ខ្ញុំចង់ទៅស៊ីកាកូ ។ តើខ្ញុំគួរផ្ទេរនៅឯណា ?
តើខ្ញុំអាចឈប់សំរាកនៅតាមផ្លូវបានទេ ?
ខ្ញុំបានដាក់ប្រាក់ទៅក្នុងម៉ាស៊ីនហើយប៉ុន្តែខ្ញុំមិនបានទទួលបានសំបុត្រទេ ។
តើអ្នកមានកន្លែងបរិភោគអាហារនៅលើរថភ្លើងទេ ?
តើអ្នកអាចដាក់វ៉ាលីរបស់ខ្ញុំនៅលើប្រដាប់ព្យួរបានទេ ?
សូមអភ័យទោស ។ តើខ្ញុំអាចប្រើវាអស់បានទេ ?
តើរថភ្លើងនេះទៅឯណា ?
សូមអោយផែនទីផ្លូវអោយខ្ញុំ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទរយះចំងាយឆ្ងាយទៅកាន់លូអេនជីលេស ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទទៅក្រៅប្រទេសទៅកាន់ប្រទេសជប៉ុន ។ នេះគឺយ៉ូគីម៉ូរ៉ាយក្នុងបន្ទប់បីដប់ពីរ ។ ខ្ញុំចង់ជំនួសការហៅទូរស័ព្ទបង់ប្រាក់ដោយអ្នកទទួលទៅកាន់លោកកេស៊ូគេម៉ូរ៉ាយ ។ លេខទូរស័ព្ទគឺតូក្យូសូន្យបីបីប្រាំពីរពីរប្រាំមួយប្រាំបីបីប្រាំបួនមួយ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទរយះចំងាយឆ្ងាយទៅកាន់លូអេនជីលេសពីរមួយបីប្រាំពីរប្រាំពីរពីរពីរមួយពីរមួយ ។ នេះគឺហារ៉ាដាក្នុងបន្ទប់បួនសូន្យប្រាំ ។
ក្រុមហ៊ុនអាកាសចរណ៍យូណាយថីត ។ តើខ្ញុំអាចជួយអ្វីអ្នកបាន ?
ខ្ញុំចង់បញ្ជាក់ការកក់របស់ខ្ញុំម្តងទៀត ។ លេខជើងហោះហើរកៅសិបប្រាំពីរទៅកាន់តូក្យូខែមករាទីប្រាំបី ។ ឈ្មោះរបស់ខ្ញុំគឺលោកថារ៉ូហារ៉ាដា ។
ភោជនីយដា្ឋនរ៉េនបូ ។
ខ្ញុំចង់សូមកក់តុមួយសំរាប់មនុស្សពីរនាក់នៅម៉ោងប្រាំពីរ ។
ប្រាកដណាស់ ។ តើខ្ញុំអាចសូមមានឈ្មោះនិងលេខទូរស័ព្ទរបស់អ្នកបានទេ ?
ឈ្មោះរបស់ខ្ញុំគឺយ៉ាម៉ាដាហើយលេខរបស់ខ្ញុំគឺមួយពីរបីបួនប្រាំប្រាំមួយប្រាំពីរ ។
បានលោក ។ ពួកយើងនឹងជួបលោកនៅម៉ោងប្រាំពីរ ។
តើខ្ញុំគួរបង់ប្រាក់ប៉ុន្មាន ?
ខ្ញុំសុំទោស ។ តើអ្នកអាចនិយាយវានោះម្តងទៀតបានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំតំលៃសំរាប់ការហៅទូរស័ព្ទនេះបានទេ ?
សូមហៅទូរស័ព្ទទៅកាន់គ្រូពេទ្យសំរាប់ខ្ញុំ ។
នេះគឺគីដាក្នុងបន្ទប់លេខប្រាំពីរម្ភៃប្រាំបួន ។ ខ្ញុំមានការឈឺចាប់ខ្លាំងនៅពោះរបស់ខ្ញុំ ។ សូមហៅគ្រូពេទ្យសំរាប់ខ្ញុំ ។
តាំងពីម្សិលមិញ ។
អ្នកផ្តាសាយហើយ ។
អ្នកត្រជាក់ហើយ ។
វាមិនអាចទៅរួចទេ ។ អ្នកគួរតែសំរាកល្អជាង ។
តើអ្នកអាចហៅទូរស័ព្ទទៅកាន់គ្រូពេទ្យដែលចេះភាសាជប៉ុនទេ ?
ខ្ញុំមានការឈឺចាប់ដូចគេចាក់នៅក្នុងពោះ ។
តើអ្នកអាចអោយខ្ញុំនូវការសង្គ្រោះបឋមបន្ទាន់ទេ ?
តើខ្ញុំនឹងត្រូវសំរាកនៅលើគ្រែយូរប៉ុន្មាន ?
តើខ្ញុំត្រូវទៅមន្ទីរពេទ្យទេ ?
តើអ្នកមានទែម៉ូម៉ែតទេ ?
ខ្ញុំមានមុននៅលើមុខរបស់ខ្ញុំ ។
ខ្ញុំមានការធានារ៉ាប់រងសុខភាព ។
តើអ្នកនឹងអោយខ្ញុំនូវថ្នាំបំបាត់ការឈឺចាប់ទេ ?
តើអ្នកអាចនឹងនាំខ្ញុំទៅជួបគ្រូពេទ្យទេ ?
គាត់គឺខ្ពស់ហើយគាត់មានសក់ពណ៌ត្នោត ។
កាបូបរបស់ខ្ញុំត្រូវបានលួច ។ កាបូបលុយនិងលិខិតឆ្លងដែនរបស់ខ្ញុំគឺនៅខាងក្នុងវា ។
អូ ។ អ្នកគួរផ្តល់ដំណឹងទៅកាន់កន្លែងកុងស៊ុលឥលូវនេះ ។
តើអ្នកនឹងសរសេររបាយការណ៍សំរាប់ខ្ញុំទេ ?
ខ្ញុំបានបាត់សែកអ្នកដំណើររបស់ខ្ញុំ ។ ខ្ញុំចង់លុបចោលអ្វីដែលនៅសល់ទាំងអស់ ។ តើខ្ញុំអាចដាក់ពាក្យសំរាប់ការផ្សាយម្តងទៀតបានទេ ?
អ្នកមានរបាយការណ៍ប៉ូលីសមែនទេ ? តើលេខសែករបស់អ្នកគឺប៉ុន្មាន ?
គេឆក់ហោប៉ៅខ្ញុំ ។
តើអ្នកបានឃើញនរណាបានធ្វើវាទេ ?
តើគាត់មានរូបរាងយ៉ាងណា ?
សូមហៅទូរស័ព្ទទៅកាន់កុងស៊ុលជប៉ុន ។
ខ្ញុំចង់បំពេញរបាយការណ៍ប៉ូលីសមួយ ។
ខ្ញុំត្រូវបានបុកត្រូវ ។
ពួកយើងមានគ្រោះថ្នាក់ចរាចរណ៍ ។
ខ្ញុំមិនបានឃើញមុខរបស់គាត់ទេ ។
តើកន្លែងកុងស៊ុលជប៉ុននៅឯណា ?
តើមន្ទីរពេទ្យនៅឯណា ?
ហេតុអ្វីបានជាខ្ញុំមិនអាចបញ្ចូនវានេះត្រលប់ទៅវិញ ?
ខ្ញុំចង់បានប្រាក់រាយខ្លះ ។
តើអ្នកអាចហុចអំបិលអោយខ្ញុំបានទេ ?
តើអ្នកអាចនឹងហុចអំបិលអោយខ្ញុំបានទេ ?
ប្រគល់ប្រាក់របស់អ្នកអោយខ្ញុំ ។
អោយប្រាក់ចុះ ។
តើណាមួយដែលអ្នកចង់បានសំរាប់អាហារពេលល្ងាចសាច់គោរឺសាច់ត្រី ?
សូមអោយខ្ញុំនូវថ្នាំខ្លះ ។
តើភេសជ្ជះប្រភេទអ្វីដែលអ្នកមាន ?
សូមសំអាតតុនេះឡើង ។
ខ្ញុំមិនលឺអ្វីទាំងអស់នៅកាស់ត្រចៀកនេះ ។
ខ្ញុំមិនដឹងពីរបៀបបំពេញបែបបទនេះទេ ។
តើមានអ្នកបំរើការតាមយន្តហោះដែលនិយាយភាសាជប៉ុនទេ ?
តើអ្នកមានគម្រោងស្នាក់នៅយូរប៉ុន្មាន ?
តើការិយាល័យរករបស់បាត់ឃើញនៅឯណា ?
ខ្ញុំបានបាត់ស្លាកទាមទារហើយ ។
វ៉ាលីរបស់ខ្ញុំបែកហើយ ។
វ៉ាលីរបស់ខ្ញុំគឺពណ៌ក្រហមនិងខ្នាតកណ្តាល ។
តើលេខអ្វីដែលខ្ញុំគួរហើយពីទីនេះទៅ ?
ខ្ញុំចង់សូមបញ្ជាក់ការកក់របស់ខ្ញុំម្តងទៀត ។ ឈ្មោះរបស់ខ្ញុំគឺអេយ៉ាកូអ៊ីតូ ។ លេខជើងហោះហើរគឺប្រាំមួយសូន្យមួយនៅខែសីហាទីសាមសិប ។
សូមកន្លែងអង្គុយខាងបង្អួចនៅផ្នែកហាមមិនអោយជក់បារី ។
សូមកន្លែងអង្គុយខាងផ្លូវដើរនៅក្នុងផ្នែកហាមមិនអោយជក់បារី ។
ខ្ញុំចង់បាននំបុ័ងសាំងវ៉ិចខ្លះ ។
តើអ្នកមានបានយកភេសជ្ជះពីទូរទឹកកកទេ ?
បាទកូកាកូឡាពីរ ។
នេះមូលប្បទានប័ត្ររបស់អ្នក ។
នេះគឺឯកសារអំនះអំណាងរបស់ខ្ញុំ ។
សូមយួរកាតាបរបស់ខ្ញុំ ។
សូមទុករបស់មានតំលៃរបស់ខ្ញុំ ។
សូមអោយខ្ញុំនូវរបស់មានតំលៃរបស់ខ្ញុំ ។
សូមត្រួតពិនិត្យទូរទស្សន៍ ។
សូមជួសជុលចង្កៀង ។
ខ្ញុំចង់បានការហៅទូរស័ព្ទដាស់ពីដំណេកនៅម៉ោងប្រាំពីរ ។
ខ្ញុំបានចាក់សោរខ្ញុំនៅខាងក្រៅ ។ សូមបើកទ្វារ ។
មនុស្សនៅបន្ទប់បន្ទាប់គឺឡូឡាណាស់ ។
សូមប្ដូរបន្ទប់របស់ខ្ញុំ ។
តើបន្ទប់បោកអ៊ុតនៅឯណា ?
ខ្ញុំទុកចោលរបស់ខ្លះនៅបន្ទប់ប្រាំសូន្យបី ។
សូមទុកវ៉ាលីនេះរហូតដល់ម៉ោងប្រាំមួយល្ងាចនេះ ។
តើអាវយឺតក្រៅនេះមានតំលៃប៉ុន្មាន ?
ចិតសិបដុល្លាររួមបញ្ចូលពន្ធ ។
សូមអោយខ្ញុំនូវការបញ្ចុះតំលៃ ។
តើអាវធំក្រៅនៅឯណា ?
ខ្ញុំគឺទំហំលេខប្រាំ ។
សូមបង្ហាញខ្ញុំធំមួយ ។
វាគឺថ្លៃខ្លាំងណាស់ ។
តើអ្នកអាចធ្វើការបំលាស់ប្ដូរបានទេ ?
ខ្ញុំចង់បានមួយនេះ ។
សូមខ្ចប់វាជាកាដូ ។
សូមខ្ចប់ពួកវាដាច់ពីគ្នា ។
សូមអោយខ្ញុំវិក័យប័ត្រមួយ ។
ខ្ញុំគិតថាអ្នកបានអោយខ្ញុំនូវប្រាក់អាប់ខុស ។
តើខ្ញុំអាចបញ្ចូនត្រលប់ទៅវិញបានទេ ?
សូមសាច់គោបន្ទះពេលល្ងាច ។
ប្រាកដណាស់ ។ នេះគឺសែករបស់អ្នក ។
ពួកយើងចង់កក់តុមួយសំរាប់មនុស្សពីរនាក់នៅម៉ោងប្រាំពីរយប់នេះ ។
ខ្ញុំចង់បានអានេះ ។
សូមអោយខ្ញុំគិតអំពីវា ។
សូមអោយខ្ញុំថង់ច្រកសត្វឆ្កែមួយ
សូមហេមប៊ឺហ្គឺមួយនិងកាហ្វេតូចមួយ ។
វាមកនៅម៉ោងពីរកន្លះ ។
ទេវាមានសុពលភាព ។
សូមទីពីរពីខាងឆ្វេង ។
សូមកាហ្វេជាមួយក្រែមនិងស្ករ ។
មិនដាក់ទឹកប៉េងប៉ោះ ។
ខ្ញុំបានធ្វើកំពបកាហ្វេខ្លះ ។
សូមប្ដូរយេននេះទៅជាដុល្លារ ។
សូមពីរម៉ឺនយេន ។
តើខ្ញុំអាចប្ដូរសែកអ្នកដំណើរខ្លះទៅជាប្រាក់សុទ្ធបានទេ ?
បាទ ។ តើអ្នកមានឯកសារសំគាល់ទេ ?
បាទ ។ នេះគឺលិខិតឆ្លងដែនរបស់ខ្ញុំ ។
តើអត្រាថ្ងៃនេះគឺប៉ុន្មាន ?
សូមប្ដូរវានេះទៅជាដុល្លារ ។
សូមសន្លឹកម្ភៃចំនួនពីរ និង សន្លឹកដប់ចំនួនមួយ ។
សូមអោយខ្ញុំប្រាក់រាយខ្លះ ។
ខ្ញុំគិតថាការគណនានេះខុស ។
តើខ្ញុំអាចដកប្រាក់បីរយដុល្លារដោយកាតវីសារបស់ខ្ញុំបានទេ ?
តើខ្ញុំអាចផ្ញើរប្រាក់ពីប្រទេសជប៉ុនបានទេ ?
សូមតែមហាសិបសេនមួយ ។
សូមផ្ញើរកញ្ចប់ឥវ៉ាន់នេះទៅកាន់ប្រទេសជប៉ុន ។
របស់បោះពុម្ភ ។
តើវាមានតំលៃប៉ុន្មានក្នុងការផ្ញើរកាតផូស្តារទៅកាន់ប្រទេសជប៉ុនតាមផ្លូវអាកាស ?
សូមផ្ញើរវានេះការដឹកជញ្ចូនពិសេស ។
ខ្ញុំចង់ផ្ញើរវានេះលក្ខណះធនាមិនបាត់ ?
សូមអោយខ្ញុំតែមហាសិបសេនចំនួនដប់ ។
តើអាស្រ័យដ្ឋាននេះមិនមានបញ្ហាទេ ?
តើអ្នកអាចធានាកញ្ចប់ឥវ៉ាន់នេះទេ ?
តើវានឹងទៅដល់ប្រទេសជប៉ុននៅពេលណា ?
សូមផ្ញើរទូរលេខទៅកាន់តូក្យូ ។
សូមសំបុត្រទៅហើយត្រលប់មកវិញទៅកាន់ស៊ីកាកូមួយ ។
ចិតសិបដុល្លារ ។
តើផ្លូវដែកមួយណាដែលទិសដៅទៅកាន់បូស្តន់ចាកចេញ ?
តើរថយន្តក្រុងនេះទៅកាន់ខាមេលមែនទេ ?
តើរថភ្លើងបន្ទាប់សំរាប់បូស្តូនចាកចេញនៅពេលណា ?
សូមប្រាប់ខ្ញុំនៅពេលពួកយើងទៅដល់លូអេនជីលេស ។
ខ្ញុំបានហួសចំណតរបស់ខ្ញុំហើយ ។
តើរថយន្តក្រុងទៅកាន់ណាប៉ាចាកចេញពីឯណា ?
តើវានឹងមានតំលៃប៉ុន្មានក្នុងការទៅថេមស៊្វែរ ?
សូមការហៅទូរស័ព្ទបង់ប្រាក់ដោយអ្នកទទួលទៅកាន់ប្រទេសជប៉ុន ។
លេខគឺសូន្យបីបីប្រាំពីរពីរប្រាំមួយប្រាំបីមួយប្រាំបួនប្រាំពីរ ។
អ្នកម្ខាងទៀតគឺនៅលើបណ្តាញហើយ ។
សួស្តី ។ តើនេះគឺកន្លែងស្នាក់នៅហ្វ្រូស្តឺមែនទេ ?
តើខ្ញុំអាចសូមនិយាយទៅកាន់វ៉រលេសបានទេ ?
ខ្ញុំមានលេខខុស ។
អញ្ចឹងខ្ញុំនឹងហៅទូរស័ព្ទត្រលប់ទៅវិញ ។
សូមការហៅទូរស័ព្ទរយះចំងាយឆ្ងាយដោយបង់ប្រាក់នៅពេលជួបមនុស្សត្រូវ ។
សូមការហៅទូរស័ព្ទទទួលដោយនរណាក៏បាន ។
សូមប្រាប់ខ្ញុំវាមានតំលៃប៉ុន្មាន ។
តើអ្នកមានជំងឺឈឺក្បាលនេះយូរប៉ុន្មានហើយ ?
តើអ្នកអាចបំពេញវិជ្ជបញ្ជានេះទេ ?
តើញឹកញ៉ាប់ប៉ុន្មានក្នុងមួយថ្ងៃដែលខ្ញុំគួរលេបថ្នាំនេះ ?
លេបវាបីដងក្នុងមួយថ្ងៃក្រោយពេលអាហារ ។
សូមជួយហៅវេជ្ជបណ្ឌិតម្នាក់មក ។
តើអ្នកមានទែម៉ូម៉ែតពេទ្យទេ ?
ខ្ញុំមិនមានវិជ្ជបញ្ជាទេ ។
សូមផ្តល់ដំណឹងទៅស្ថានកុងស៊ុលឥលូវនេះ ។
សូមលេខសែករបស់អ្នក ។
តើជនល្មើសមានរូបរាងដូចម្តេច ?
គាត់គឺខ្ពស់ជាមួយសក់ពណ៌ទង់ដែង ។
ខ្ញុំមានគ្រោះថ្នាក់ចរាចរណ៍នៅមហាវីថីលេខប្រាំ ។
ខ្ញុំមិនសូវចេះភាសាអង់គ្លេសទេ ។
នរណាម្នាក់ត្រូវបានរងរបួស ។
នរណាម្នាក់លូកហោប៉ៅរបស់ខ្ញុំ ។
ខ្ញុំចង់ដាក់ពាក្យផ្សាយម្តងទៀត ។
វាមិនមែនជាកំហុសរបស់ខ្ញុំទេ ។
ខ្ញុំទុកកាបូបរបស់ខ្ញុំនៅបន្ទប់រង់ចាំ ។
តើកៅអីហុកសិបអេនៅឯណា ?
សូមទុករបស់នេះនៅកន្លែងណាមួយ ។
តើខ្ញុំអាចទំរេតកៅអីនេះបានទេ ?
កៅអីគឺខូចហើយ ។
តើពួកយើងអាចប្ដូរកន្លែងអង្គុយបានទេ ?
តើខ្ញុំអាចប្ដូរទៅផ្នែកជក់បារីបានទេ ?
តើមានផ្នែកហាមមិនអោយជក់បារីទេ ?
សូមហៅអ្នកបម្រើភេទស្រីជនជាតិជប៉ុនម្នាក់ ។
តើកន្លែងដែលអ្នកទៅនៅឯណា ?
តើពួកយើងហោះចេញទៅនៅពេលណា ?
តើពួកយើងទៅដល់ស៊ីកាកូនៅពេលណា ?
យកអោយខ្ញុំនូវកាស់ត្រចៀកមួយគូ ?
សាច់គោបន្ទះរឺសាច់មាន់ ?
ខ្ញុំនឹងមិនបរិភោគអាហារទេ ។
តើពួកយើងត្រូវបង់ប្រាក់សំរាប់ភេសជ្ជះទេ ?
សូមទឹកផ្លែឈើខ្លះ ។
តើជើងហោះហើរនឹងចាកចេញទាន់ពេលទេ ?
តើខ្ញុំគួរត្រលប់មកវិញនៅពេលណា ?
ខ្ញុំជាអ្នកដំណើរចាំដូរជើងយន្តហោះ ។
តើពួកយើងអាចនៅលើយន្តហោះទេ ?
តើខ្ញុំអាចធ្វើការប្ដូរជើងយន្តហោះភ្លាមៗបានទេ ?
តើសេចក្តីដំណឹងនោះពីអ្វី ?
ពួកយើងនឹងត្រូវបានពន្យាពេលមួយម៉ោង ។
តើអ្នកមានទិដ្ឋាការសិស្សទេ ?
នៅសណ្ឋាគារហូលីដេយអ៊ីននៅលូអេនជីលេស ។
តើអ្នកមកពីទីណានៅក្នុងប្រទេសជប៉ុន ?
នេះគឺការមកទស្សនាលើកដំបូង ។
សូមបង្ហាញខ្ញុំអ្វីនៅខាងក្នុង ។
គ្រាន់តែរបស់របរផ្ទាល់ខ្លួន ។
តើអ្វីនៅក្នុងកាតាបពណ៌សនេះ ?
តើខ្ញុំត្រូវបង់ពន្ធនៅឯណា ?
សូមឯកសារអំនះអំណាងរបស់អ្នក ។
របស់នេះគឺមិនត្រូវអនុញ្ញាតទេ ។
តើឯកសារទាមទារសងវ៉ាលីនៅឯណា ?
តើវាមានរូបរាងយ៉ាងណា ?
វាគឺវ៉ាលីពណ៌ខៀវខ្នាតកណ្តាលមួយ ។
តើអ្នកមានវ៉ាលីចំនួនប៉ុន្មាន ?
បីតែប៉ុណ្ណោះ ។
វ៉ាលីរបស់ខ្ញុំបាត់ហើយ ។
តើខ្ញុំអាចត្រួតពិនិត្យវ៉ាលីរបស់ខ្ញុំនៅទីនេះបានទេ ?
សូមហៅអ្នកកាន់អីវ៉ាន់ ។
ខ្ញុំចង់ប្ដូរប្រាក់ខ្លះ ។
សូមប្ដូរប្រាក់យេនទៅជាដុល្លារ ។
សូមប្ដូរសែកអ្នកដំណើរជាប្រាក់សុទ្ធ ។
សូមក្រដាសប្រាក់ដប់ដុល្លារប្រាំ ។
សូមអោយលុយរាយផង ។
សូមប្ដូរប្រាក់នេះទៅជាកាក់ ។
សូមចុះហត្ថលេខានៅទីនេះ ។
ចុះហត្ថលេខានៅខាងក្រោយនៃសែក ។
តើអត្រាប្ដូរប្រាក់ថ្ងៃនេះគឺប៉ុន្មាន ?
សូមធ្វើការកក់ ។
សូមលុបចោលការកក់របស់ខ្ញុំ ។
ខ្ញុំចង់បានសណ្ឋាគារដែលធូរថ្លៃមួយ ។
សូមបន្ទប់មួយប្រហែលហុកសិបដុល្លារ ។
តើបន្ទប់មានម៉ាស៊ីនត្រជាក់ទេ ?
បន្ទប់មួយជាមួយបន្ទប់ងូតទឹកនិងទឹកផ្កាឈូក ។
តើខ្ញុំត្រូវបង់ប្រាក់ជាមុនទេ ?
តើអ្នកមានសណ្ឋាគារផ្សេងមួយទៀតទេ ?
ខ្ញុំនឹងធ្វើវាភ្លាមហើយរហ័ស ។
ខ្ញុំចង់ស្នាក់នៅបីយប់ ។
សូមបន្ទប់ជាមួយទេសភាពស្អាតមួយ ។
ពួកយើងមានការកក់ ។
តើបន្ទប់មានតំលៃប៉ុន្មាន ?
នេះគឺការបញ្ជាក់ ។
តើវានេះបញ្ចូលអាហារពេលព្រឹកទេ ?
សូមកូនសោរ ។ បន្ទប់ដប់មួយដប់ប្រាំពីរ ។
តើអ្នកមានទូរដែកសុវត្ថិភាពទេ ?
ខ្ញុំចង់យកលិខិតឆ្លងដែនរបស់ខ្ញុំទៅក្រៅ ។
តើមានហាងអ៊ុតសក់ទេ ?
ខ្ញុំចង់បង់ប្រាក់ជាប្រាក់សុទ្ធ ។
កូនសោររបស់ខ្ញុំគឺខូចហើយ ។
ខ្ញុំបានទុកកូនសោររបស់ខ្ញុំនៅក្នុងបន្ទប់របស់ខ្ញុំ ។
សូមកាហ្វេមួយនិងទឹកតែពីរ ។
អាហារពេលព្រឹកនៅម៉ោងប្រាំបីព្រឹកស្អែក ។
សូមយកកាសែតព្រឹកថ្ងៃនេះ ។
សូមការហៅទូរស័ព្ទដាស់ពីដំណេកនៅម៉ោងប្រាំពីរ ។
ខ្ញុំនៅកំពុងរង់ចាំអាហារពេលព្រឹករបស់ខ្ញុំ ។
សូមយកវិក័យប័ត្ររបស់ខ្ញុំអោយខ្ញុំ ។
តើវិក័យប័ត្ររបស់ខ្ញុំអស់ប៉ុន្មាន ?
មិនមានទឹកក្តៅចេញទេ ។
មិនមានទឹកចេញពីទឹកផ្កាឈូកទេ ។
មិនមានកន្សែងខ្លះទេ ។
បង្គន់មិនហូរទឹកទេ ។
អំពូលមិនដំណើរការទេ ។
ទូរទស្សន៍ខូចហើយ ។
សូមតំឡើងកំដៅ ។
សូមបន្ថយសំដៅ ។
តើពេលចាកចេញគឺនៅពេលណា ?
សូមជួយចុះឈ្មោះចេញអោយផង ។
អោយខ្ញុំបង់ប្រាក់របស់ខ្ញុំ ។
សូមបង្ហាញខ្ញុំនូវតំលៃ ។
តើមានបង់ប្រាក់បន្ថែមទេ ?
ខ្ញុំនឹងបង់ប្រាក់ដោយប័ណ្ណឥណទាន ។
វាគឺបន្ទប់ល្អមួយ ។
សូមទុកវ៉ាលីនេះ ។
ប្រាំម៉ោងទៀតបានទេ ?
តើមានភោជនីយដា្ឋនល្អខ្លះទេ ?
តើភោជនីយដា្ឋនោះថ្លៃទេ ?
សូមធ្វើការកក់ ។
សូមតុសំរាប់មនុស្សបួននាក់នៅម៉ោងប្រាំមួយ ។
តើវាគឺរ៉ូបផ្លូវការមែនទេ ?
តើខ្ញុំគួរពាក់អាវធំក្រៅទេ ?
តើអ្នកមានតុសំរាប់មនុស្សប្រាំនាក់ទេ ?
បីនាក់នៃពួកយើង ។
មនុស្សម្នាក់កំពុងមកតាមក្រោយ ។
ពួកយើងចង់បានតុមួយនៅខាងបង្អួច ។
ខ្ញុំចង់សាកម្ហូបប្រចាំតំបន់ខ្លះ ។
តើនេះគឺការីប្រភេទអ្វី ?
តើអ្នកអាចធ្វើវានៅពេលនេះបានទេ ?
ខ្ញុំចង់បានស៊ុតអ៊ូម៉ូឡែត ។
តើវានោះមកជាមួយសាឡាតទេ ?
ពួកយើងនឹងមានស្រាបៀរដែលមានពពុះច្រើនបួនដប ។
សូមទឹកមួយកែវ ។
សូមស្រាបៀរពីរបន្ថែម ។
ខ្ញុំចង់អោយកាហ្វេរបស់ខ្ញុំខ្មៅ ។
តើអ្នកអាចយកចានមួយផ្សេងទៀតអោយពួកយើងបានទេ ?
ខ្ញុំចង់បានការ៉េមសំរាប់បង្អែម ។
សូមហុចទឹកជ្រលក់ប៉េងប៉ោះអោយខ្ញុំ ។
ពួកយើងពេញចិត្តនឹងអាហារពេលល្ងាច ។
ខ្ញុំចង់យកវានេះទៅផ្ទះ ។
ទាំងអស់ប៉ុន្មាន ?
តើខ្ញុំអាចបង់ប្រាក់ជាមួយនិងកាតឥណទាននេះបានទេ ?
ខ្ញុំនឹងបង់ប្រាក់ដាច់ដោយឡែកពីគ្នា ។
ខ្ញុំមិនអាចបរិភោគអស់ទេប៉ុន្តែឆ្ងាញ់ ។
អាហារគឺល្អណាស់ ។
ខ្ញុំនឹងចេញប្រាក់សំរាប់ពីរនាក់យើង ។
ខ្ញុំបានបញ្ចូលប្រាក់ទឹកតែហើយ ។
តើមាននរណាមកទីនេះទេ ?
តើអ្នកអាចខិតទៅខាងបានទេ ?
ខ្ញុំចង់អោយរបស់ខ្ញុំទៅ ។
ពួកយើងនឹងបរិភោគនៅទីនេះ ។
សូមភេសជ្ជះខ្នាតកណ្តាលដែលគ្មានជាតិអាកុលពីរ ។
ហេមប៊ឺហ្គឺរមួយនិងទឹកផ្លែក្រូចមួយ ។
ខ្ញុំនឹងមានពីរ ។
សូមត្រឹមតែទឹកជ្រលក់ប៉េងប៉ោះ ។
តើអ្នកមានអំបិលខ្លះទេ ?
តើខ្ញុំអាចមានកន្សែងជូតដៃមួយទេ ?
សូមធ្វើវាទ្វេដង ។
