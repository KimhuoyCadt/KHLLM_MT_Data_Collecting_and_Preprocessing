ខ្ញុំចង់បានស្តាយនេះ ។
តើស្តាយណាដែលចុងក្រោយបំផុត ?
សូមធ្វើសក់ខ្ញុំតាមបែបធម្មជាតិ ។
ខ្ញុំចង់ធ្វើសក់អោយរួញ ។
ខ្ញុំចង់សំអាតត្រចៀករបស់ខ្ញុំ ។
ខ្ញុំចង់សិតសក់មកខាងឆ្វេង ។
គ្រាន់តែកាត់សក់ទេ ។
សូមដាក់ឡេខ្លះលើសក់ខ្ញុំផង ។
ខ្ញុំមិនត្រូវការឡេឬក៏ប្រេងសក់អីទេ ។
តើខ្ញុំអាចអ៊ុតសក់នៅទីនេះបានទេ ?
ខ្ញុំចង់ហៅទូរស័ព្ទទៅកាន់តូក្យូ ។
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបប្រើទូរស័ព្ទនេះដើម្បីហៅចេញបានទេ ?
តើខ្ញុំប្រើទូរស័ព្ទនេះដើម្បីហៅចេញបានទេ ?
តើខ្ញុំអាចសុំប្រើទូរស័ព្ទរបស់អ្នកបានទេ ?
តើខ្ញុំអាចរកទូរស័ព្ទសាធារណៈនៅឯណាបាន ?
តើអ្នកអាចនិយាយអោយលឺជាងនេះទៀតបានទេ ?
ទូរស័ព្ទនេះត្រូវបានកាត់ផ្តាច់ហើយ ។
ខ្ញុំចង់ផ្ញើសារ ។
តើមានប្រអប់សំបុត្រក្បែរនេះទេ ?
តើផ្ញើតាមយន្តហោះថ្លៃប៉ុន្មាន ?
តើខ្ញុំគួរទុកតែមនៅឯណា ?
តើសេវាប្រៃសណីយ៍ថ្លៃប៉ុន្មាន ?
តើការិយាល័យតេឡេក្រាមនៅឯណា ?
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបផ្ញើតាមតេឡេក្រាមបានទេ ?
តើខ្ញុំអាចហៅទូរស័ព្ទក្នុងស្រុកពីទូរស័ព្ទនេះដោយរបៀបណា ?
តើខ្ញុំអាចធ្វើការហៅទូរស័ព្ទទៅឆ្ងាយតាមរយៈទូរស័ព្ទនេះបានទេ ?
តើខ្ញុំអាចធ្វើការហៅទូរស័ព្ទតែម្តងបានទេ ?
តើខ្ញុំគួរតែហៅទៅកាន់សហការីជាមុនសិនឬ ?
តើលេខប៉ុន្មានសំរាប់ហៅទៅកាន់សហការី ?
តើលេខប៉ុន្មានសំរាប់ហៅទៅសួរព័ត៌មាន ?
ខ្ញុំចង់លេខទូរស័ព្ទរបស់សណ្ឋាគារមេផ្លោវ័រ ។
សូមហៅទៅកាន់លេខបី ប្រាំពីរ ប្រាំមួយ ប្រាំពីរ មួយ បី បួន ។
សូមហៅទៅកាន់ឈិខាហ្គូ លេខប្រាំបី ប្រាំពីរ ប្រាំពីរ ប្រាំមួយ ប្រាំ សូន្យ ប្រាំពីរ ។
នេះគឺលេខប្រាំបី ប្រាំបួន ប្រាំ បួន បី បី សណ្ឋាគារមាផ្លោវ័រ បន្ទប់លេខប្រាំ ដប់បួន ឡូសអេនជិឡេស ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទអន្តរជាតិដែលគិតលុយពេលដែលភាគីម្ខាងទៀតលើកទូរស័ព្ទ ។
តើខ្ញុំអាចធ្វើការហៅទូរស័ព្ទដែលគិតលុយពីភាគីម្ខាងទៀតទៅប្រទេសជប៉ុនបានទេ ?
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទដែលគិតលុយពីប័ណ្ណឥណទាន ។
ខ្ញុំចង់ហៅទូរស័ព្ទទៅកាន់តូក្យូ ។
តើអ្នកអាចលុបចោលការហៅទូរស័ព្ទទៅកាន់តូក្យូបានទេ ?
សូមអោយខ្ញុំដឹងពីតំលៃនៅពេលក្រោយ ។
តើការហៅទូរស័ព្ទមិញអស់ថ្លៃប៉ុន្មាន ?
ខ្ញុំចង់បានលេខទូរស័ព្ទសំរាប់សេវាហៅទូរស័ព្ទអន្តរជាតិ ។
តើពេលនេះម៉ោងប៉ុន្មានហើយនៅប្រទេសជប៉ុន ?
តើរវាងតូក្យូនិងទីនេះខុសគ្នាប៉ុន្មានម៉ោង ?
តើលេខកូដទូរស័ព្ទអន្តរជាតិរបស់ជប៉ុនគឺអ្វី ?
តើខ្ញុំអាចហៅទូរស័ព្ទទៅប្រទេសបារាំងពីទីនេះតែម្តងបានទេ ?
តើនេះគឺលេខប្រាំ ប្រាំពីរ ប្រាំពីរ ប្រាំមួយ ប្រាំ សូន្យ ប្រាំពីរដែរឬទេ ?
នេះគឺស៊ូស៊ុយគីកំពុងនិយាយ ។
តើលោកសាសាអូកាឥឡូវទំនេរទេ ?
តើអ្នកអាចប្រាប់លោករុកជឺថាខ្ញុំបានហៅមកបានទេ ?
បើអ្នកមិនប្រកាន់ទេ តើអ្នកអាចហៅមកពេលក្រោយម្តងទៀតបានទេ ?
ខ្ញុំនឹងហៅមកម្តងទៀត ។
តើខ្ញុំគួរតែហៅមកវិញម៉ោងប៉ុន្មាន ?
សូមចុចលេខបន្ថែម ប្រាំបួន មួយ ប្រាំមួយ ។
ខ្ញុំមិនមានកាក់ទៀតទេ ។
ខ្ញុំត្រូវដាក់ទូរស័ព្ទចុះហើយឥលូវ ។
ខ្ញុំនឹងទូរស័ព្ទទៅអ្នកវិញឥលូវនេះ ។
ខ្ញុំប្រាកដជាបានចុចទៅលេខទូរស័ព្ទខុសហើយ ។
តើមាននរណាទូរស័ព្ទមកខ្ញុំទេ ?
តើអាចសូមអ្នកលើកទូរស័ព្ទបានទេ ?
អរគុណសំរាប់ការទូរស័ព្ទរបស់អ្នក ។
ខ្ញុំចង់ផ្ញើសំបុត្រមួយទៅប្រទេសជប៉ុន ។
សូមផ្ញើតាមរយៈសេវារហ័ស ។
សូមអោយតាមប៉ុស្ដិ៍ដែលបានចុះបញ្ជី ។
តើបង្អួចណាមួយសំរាប់ការផ្ញើមានការធានារ៉ាប់រង ?
តើតែមក្នុងស្រុកមានតំលៃប៉ុន្មាន ?
តើតែមផ្ញើតាមផ្លូវអាកាសទៅប្រទេសជប៉ុនមានតំលៃប៉ុន្មាន ?
តើវាត្រូវការរយៈពេលប៉ុន្មានសំរាប់ការផ្ញើតាមផ្លូវទឹក ?
ខ្ញុំបានដាក់រូបភាពខ្លះ ។
តើខ្ញុំអាចសុំតែមប្រៃសណីយ៍ សំរាប់ផ្ញើកាតពីរតាមរយៈផ្លូវអាកាស ទៅកាន់ប្រទេសជប៉ុនបានទេ ?
តើខ្ញុំអាចសុំតែមប្រៃសណីយ៍ សំរាប់ផ្ញើសំបុត្រមួយតាមរយៈផ្លូវអាកាស ទៅកាន់ប្រទេសជប៉ុនបានទេ ?
ខ្ញុំចង់ផ្ញើកញ្ចប់ឥវ៉ាន់នេះទៅកាន់ប្រទេសជប៉ុន តាមរយៈផ្លូវទឹក ។
តើអ្នកអាចថ្លឹងកញ្ចប់ឥវ៉ាន់នេះបានទេ ?
តើខ្ញុំអាចដាក់សំបុត្រនៅក្នុងវាបានទេ ?
តើខ្ញុំអាចអោយគេខ្ចប់ឥវ៉ាន់នេះនៅឯណា ?
តើខ្ញុំអាចសុំទំរង់សំរាប់ប្រកាសពន្ធគយមួយបានទេ ?
តើខ្ញុំអាចផ្ញើទូរលេខដោយរបៀបណា ?
សូមផ្ញើសារនេះដោយទូរលេខ ។
ដោយបង់ថ្លៃពេញ ។
ខ្ញុំចង់ផ្ញើទូរលេខមួយក្រៅប្រទេស ។
តើថ្លៃទូរលេខប៉ុន្មានដែរ ?
តើពាក្យមួយមានតំលៃប៉ុន្មាន ?
តើវាត្រូវបានរាប់ជាពាក្យមែនទេ ?
ខ្ញុំចង់ធ្វើការផ្ញើប្រាក់តាមទូរលេខ ។
ខ្ញុំចង់ធ្វើការកក់មួយ ។
ខ្ញុំចង់កក់កៅអីមួយពីលោអេនជីលេស ទៅកាន់តូក្យូ ។
តើខ្ញុំត្រូវតែកក់កៅអី ?
តើអ្នកមានជើងហោះហើរទៅកាន់ហ្វតវ៉េយនី ?
តើតំលៃសំបុត្រយន្តហោះពីញ៉ូវយ៉ក ទៅកាន់ប៊ូស្តុនប៉ុន្មាន ?
តើខ្ញុំអាចប្រើកាតជិះនេះបានទេ ?
តើជើងហោះហើរនេះឈប់នៅម៉ាយអាមីដែររឺទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីលេខកក់របស់ខ្ញុំបានទេ ?
ខ្ញុំបានធ្វើការកក់ម្សិលមិញ ។
លេខកក់របស់ខ្ញុំគឺម្ភៃ ប្រាំបួន កៅសិប មួយ ។
ខ្ញុំចង់បញ្ជាក់ជើងហោះហើររបស់ខ្ញុំម្តងទៀត ពីទីក្រុងឡុង ទៅកាន់តូក្យូ ។
តើខ្ញុំត្រូវតែបញ្ជាក់ម្តងទៀត ?
តើខ្ញុំអាចបញ្ជាក់ម្តងទៀតដោយទូរស័ព្ទបានទេ ?
តើខ្ញុំអាចប្ដូរការកក់របស់ខ្ញុំបានទេ ?
ខ្ញុំចង់កក់កៅមួយ ពីហូណូលូលូ ទៅកាន់តូក្យូ ។
តើអ្នកចង់ចាកចេញនៅពេលណា ?
មានជើងហោះហើរមួយនៅម៉ោងដប់សាមសិបនាទីព្រឹក ។
តើនេះជាជើងហោះហើរត្រង់មែនទេ ?
តើអ្នកមានជើងហោះហើរផ្សេងទៀតទេ ?
តើមួយណាដែលអ្នកចង់បាន កន្លែងអង្គុយជក់បារីរឺកន្លែងអង្គុយមិនជក់បារី ?
លេខជើងហោះហើររបស់អ្នកគឺខេអេ សូន្យ សូន្យ មួយ ច្រកលេខម្ភៃប្រាំពីរ ។
សូមមកព្រលានយន្តហោះ អោយបានត្រឹមម៉ោងប្រាំបី សាមសិបនាទី យ៉ាងយឺតបំផុត ។
តើខ្ញុំត្រូវតែធ្វើការបញ្ជាក់ម្តងទៀត ?
តើខ្ញុំអាចសុំបញ្ជាក់ជើងហោះហើររបស់ខ្ញុំម្តងទៀតបានទេ ?
តាគីអូ គីមូតុ ។ គីមូតុគឺត្រកូលរបស់ខ្ញុំ ។
លេខជើងហោះហើរគឺភីខេ ប្រាំពីរ សូន្យ ប្រាំបី នៅខែកញ្ញា ថ្ងៃទីប្រាំ ។
តើអ្នកអាចសូមត្រួតពិនិត្យវាម្តងទៀតបានទេ ?
តើអ្នកអាចប្ដូរកាលបរិច្ឆេទជើងហោះហើររបស់ខ្ញុំ ពីទីក្រុងឡុង ទៅកាន់តូក្យូបានទេ ?
ខ្ញុំចង់លុបចោលការកក់របស់ខ្ញុំសំរាប់ជើងហោះហើរ នៅខែតុលា ថ្ងៃទីដប់បួន ហើយសូមកក់មួយ នៅខែតុលា ថ្ងៃទីម្ភៃមួយ ជំនួសវិញ ។
ខ្ញុំចង់កក់កៅអីមួយទៅកាន់ញ៉ូវយ៉ក ។
តើខ្ញុំអាចមានកៅអីនៅលើរថភ្លើងសំរាប់ថ្ងៃនេះនៅម៉ោងប្រាំពីរល្ងាចបានទេ ?
ចុះថ្ងៃស្អែកម៉ោងប្រាំពីរល្ងាចវិញ ?
តើមានព្រលឹមជាងនេះទេ ?
ពួកយើងមានតែមួយក្នុងមួយថ្ងៃសំរាប់ញ៉ូវយ៉ក ។
អញ្ចឹង ខ្ញុំនឹងជិះរថភ្លើង ស្អែកម៉ោងប្រាំពីរល្ងាច ។
តើខ្ញុំត្រូវតែប្ដូររថភ្លើងទេ ?
អ្នកត្រូវតែប្ដូរនៅស្ថានីយស៊ីកាហ្គូ ។
តើម៉ោងប៉ុន្មានដែលខ្ញុំគួរទៅដល់ស្ថានីយ ?
អ្នកត្រូវតែទៅដល់ទីនោះ មិនអោយយឺតជាងម៉ោងប្រាំមួយ សាមសិបនាទី ។
តើខ្ញុំត្រូវការការកក់ ដើម្បីទៅដោយនាវាទេ ?
តើពួកវាទាំងអស់ជាកៅអីមិនកក់ មែនទេ ?
តើម៉ោងប៉ុន្មានដែលនាវាចាកចេញ ?
តើខ្ញុំអាចបរិភោគអាហារពេលយប់នៅលើកប៉ាល់ទេ ?
តើវាមានតំលៃប៉ុន្មានដើម្បីទៅទីនោះដោយកប៉ាល់ ?
តើនេះគឺជាជើងហោះហើរប្រចាំថ្ងៃមែនទេ ?
ខ្ញុំចង់បានកៅអីមួយនៅខាងបង្អួច ។
ខ្ញុំចង់បានប្រាក់សងមកវិញសំរាប់សំបុត្រនេះ ។
ខ្ញុំចង់ទិញកាតជិះដំណើរកំសាន្តជំនួសវិញ ។
តើខ្ញុំអាចយកប្រាក់សងមកវិញសំរាប់សំបុត្រនេះនៅឯណា ?
ខ្ញុំមានជើងហោះហើរនៅម៉ោងដប់ព្រឹកស្អែក ។
ខ្ញុំត្រូវទៅដល់ព្រលានយន្តហោះ ត្រឹមម៉ោងប្រាំបីព្រឹកស្អែក ។
ខ្ញុំត្រូវចាកចេញពីទីនេះ នៅម៉ោងប្រាំពីរ សាមសិបនាទី ព្រឹកស្អែក ។
តើអ្នកអាចនាំខ្ញុំទៅកាន់ព្រលានយន្តហោះបានទេ ?
តើអ្នកអាចទូរស័ព្ទហៅឡានតាក់ស៊ីសំរាប់ខ្ញុំបានទេ ?
តើម៉ោងប៉ុន្មានដែលខ្ញុំគួរចាកចេញពីសណ្ឋាគារដើម្បីទៅទាន់ពេលសំរាប់ជើងហោះហើររបស់ខ្ញុំ ?
ខ្ញុំចង់ចុះឈ្មោះផ្ញើកាបូបទាំងនេះ ។
តើម៉ោងប៉ុន្មានដែលខ្ញុំគួរទៅដល់ច្រកចាកចេញ ?
តើហាងមិនគិតពន្ធនៅឯណា ?
តើវានៅក្នុងការកំណត់ឥតគិតពន្ធទេ ?
តើវានឹងមានតំលៃប៉ុន្មានជាយ៉េន ?
តើអ្នកអាចជួយប្ដូរជាលុយយ៉េនអោយបានខ្ញុំបានទេ ?
ទិសដៅរបស់ខ្ញុំគឺតូក្យូ ។
តើខ្ញុំអាចសុំកាតចុះពីយានមួយបានទេ ?
តើខ្ញុំអាចសុំទំរង់ប្រកាសពន្ធគយមួយបានទេ ?
តើអ្នកអាចពន្យល់ពីរបៀបបំពេញវានេះបានទេ ?
សូមអភ័យទោស តើម៉ោងប៉ុន្មានដែលយន្តហោះនឹងទៅដល់តូក្យូ ?
តើអ្នកមានសេវាកម្មឡានក្រុងទៅកាន់ព្រលានយន្តហោះទេ ?
តើមានឡានក្រុងបើកទៅកាន់ព្រលានយន្តហោះទេ ?
តើចំណតឡានក្រុងនៅក្បែរសណ្ឋាគារទេ ?
តើម៉ោងប៉ុន្មានដែលខ្ញុំគួរជិះឡានក្រុងយ៉ាងយឺតបំផុត ?
តើចំណតសំរាប់ឡានក្រុងទៅកាន់អាកាសយាននៅឯណា ?
តើអ្នកនឹងបញ្ចូនឡានឈ្នួលនៅម៉ោងប្រាំពីរសាមសិបនាទីព្រឹកស្អែកទេ ?
ខ្ញុំនឹងរង់ចាំនៅមុខសណ្ឋាគារស្កាយវ៉េយ ។
ខ្ញុំចង់អោយឡានឈ្នួលមកទទួលខ្ញុំនៅម៉ោងដប់ដប់ប្រាំនាទី ។
តើវានឹងចំណាយពេលប៉ុន្មានដើម្បីទៅកាន់អាកាសយានដោយឡានក្រុង ?
តើវានឹងចំណាយប្រាក់អស់ប៉ុន្មានដើម្បីទៅកាន់អាកាសយានដោយឡានតាក់ស៊ី ?
តើខ្ញុំអាចត្រួតពិនិត្យវ៉ាលីរបស់ខ្ញុំនៅឯណា ?
ខ្ញុំមានវ៉ាលីចំនួនពីរ ។
តើខ្ញុំសូមមានផ្លាកវ៉ាលីបានទេ ?
តើម៉ោងចាកចេញនៅលើកាលវិភាគមែនទេ ?
តើការហោះហើរនឹងត្រូវបានពន្យាពេលទេ ?
តើត្រូវពន្យាពេលនៅម៉ោងប៉ុន្មាន ?
តើការហោះហើរនឹងត្រូវបានលុបចោលមែនទេ ?
តើមូលហេតុនៃការពន្យាពេលគឺអ្វី ?
តើមានរយះពេលប៉ុន្មានដែលការហោះហើរត្រូវបានពន្យាពេល ?
តើអ្នកមានកាតរូបភាពទេ ?
តើអ្នកនឹងទទួលជាប្រាក់យេនជប៉ុនទេ ?
តើនាឡិកានេះត្រូវបានផលិតនៅឯណា ?
តើវាគឺម៉ាកអាមេរិចមែនទេ ?
តើនេះគឺម៉ាកអ្វី ?
តើអ្នកមានសូកូឡាផលិតនៅប្រទេសហូឡង់ទេ ?
តើបារីទាំងនេះគឺស្រទន់មែនទេ ?
តើខ្ញុំនឹងនៅក្នុងការកំណត់មិនគិតពន្ធប្រសិនបើខ្ញុំយកបី ?
ខ្ញុំចង់ប្ដូរទឹកអប់នេះ ។
ខ្ញុំបានទូរស័ព្ទទៅកាន់តូក្យូហើយពួកគេបាននិយាយថាពួកគេមិនចង់បានវាទេ ។
តើខ្ញុំត្រូវតែប្រកាសរបស់ទាំងនេះដែរ ?
តើពួកយើងនឹងទៅដល់តូក្យូទាន់ម៉ោង ?
តើខ្ញុំអាចសូមមានរបស់ដើម្បីសរសេរជាមួយ ?
ខ្ញុំចង់កំណត់នាឡិការបស់ខ្ញុំទៅនឹងម៉ោងតំបន់នៅតូក្យូ ។
តើកន្លែងដែលរបស់បាត់រកឃើញនៅឯណា ?
ខ្ញុំបានបាត់កាបូបរបស់ខ្ញុំ ។
ខ្ញុំបានដាក់លិខិតឆ្លងដែនរបស់ខ្ញុំនៅកន្លែងណាមួយ ។
កាបូបរបស់ខ្ញុំត្រូវបានគេលួចទៅជាមួយលិខិតឆ្លងដែនរបស់ខ្ញុំ ។
សូមនាំខ្ញុំទៅជួបប៉ូលីស ។
តើនរណាដែលខ្ញុំគួរនិយាយទៅ ?
ខ្ញុំត្រូវតែទៅស្ថានទូតជប៉ុន ។
ខ្ញុំបានទុកចោលលិខិតឆ្លងដែនរបស់ខ្ញុំនៅក្នុងឡានតាក់ស៊ី ។
ខ្ញុំមិនមានពេលវេលាមើលវាទេ ។
ខ្ញុំមិនបានចាំថាឡានប្រភេទអ្វីនោះទេ ។
ខ្ញុំមិនបានចាំវាច្បាស់ទេ ។
ខ្ញុំបានទុកចោលកាបូបរបស់ខ្ញុំនៅក្នុងភោជនីយដា្ឋនប្រហែលមួយម៉ោងមុន ។
វាគឺកាបូបស្បែកពណ៌ក្រហម ។
ខ្ញុំគិតថាខ្ញុំទុកវាចោលនៅក្បែរកន្លែងគិតប្រាក់ ។
ខ្ញុំមិនច្បាស់ថាខ្ញុំទុកវាចោលនៅកន្លែងណាទេ ។
តើអ្នកអាចសូមជួយរកវាឥលូវបានទេ ?
ប្រសិនបើអ្នករកវាឃើញតើអ្នកអាចសូមជួយទុកវាអោយខ្ញុំបានទេ ?
ខ្ញុំនឹងទៅដល់ទៅនោះប្រហែលសាមសិបនាទី ។
ខ្ញុំត្រូវបានប្លន់កាបូបដៃរបស់ខ្ញុំនៅមុខធនាគារ ។
ខ្ញុំមានលិខិតឆ្លងដែនរបស់ខ្ញុំសែកនិងប្រាក់សុទ្ធនៅក្នុងកាបូបដៃរបស់ខ្ញុំ ។
វាគឺពីរបីនាទីកន្លងទៅ ។
តើអ្នកអាចសូមទូរស័ព្ទទៅកាន់ប៉ូលីសឥលូវបានទេ ?
ខ្ញុំចង់ជូនដំណឹងទៅប៉ូលីស ។
តើមានការដែលអាចទៅរួចក្នុងការបានលិខិតឆ្លងដែនរបស់ខ្ញុំមកវិញទេ ?
កូនស្រីរបស់ខ្ញុំបានកំពុងបាត់ខ្លួនហើយ ។
ខ្ញុំបានបាត់ដាមគាត់នៅមុខហាងទំនិញ ។
វាគឺម្ភៃនាទីកន្លងទៅ ។
នាងគឺក្មេងស្រីជប៉ុនអាយុប្រាំបីឆ្នាំ ។
វាគឺស្លៀកអាវក្រៅពណ៌ប្រផេះនិងសំពត់ពណ៌ក្រហម ។
តើអ្នកអាចទូរស័ព្ទមកខ្ញុំខណះនាងត្រូវបានរកឃើញ ?
ខ្ញុំបែកកង់ហើយ ។
ឡានរបស់ខ្ញុំបានរលត់ ។
ឡានរបស់ខ្ញុំបានរអិលចុះពីថ្នល់ ។
ខ្ញុំមានគ្រោះថ្នាក់តូចមួយ ។
ខ្ញុំមានជម្លោះមួយ ។
ឡានរបស់ខ្ញុំបានបុកទល់នឹងបង្គោលភ្លើង ។
ភ្លើងចរាចរណ៍គឺពណ៌បៃតង ។
ខ្ញុំគឺនៅក្នុងល្បឿនកំណត់ ។
ខ្ញុំមិនមានទំនួលខុសត្រូវចំពោះវាទេ ។
ឡានរបស់ខ្ញុំត្រូវបានរលត់នៅផ្លូវជិះលឿន ។
តើខ្ញុំអាចទូរស័ព្ទទៅប៉ូលីសពីទីនេះដោយរបៀបណា ?
តើអ្នកអាចបញ្ចូននរណាបានទេ ?
មានមនុស្សរបួសនៅទីនេះ ។
តើវាប្រសើរក្នុងការផ្តល់ដំណឹងទៅប៉ូលីសទេ ?
តើខ្ញុំគួរផ្តល់ដំណឹងទៅស្ថានទូតជប៉ុនទេ ?
តើអ្នកអាចទូរស័ព្ទទៅក្រុមហ៊ុនដែលខ្ញុំធ្វើការទេ ?
តើអ្នកអាចអោយសារនេះទៅកាន់មិត្តរបស់ខ្ញុំបានទេ ?
តើអ្នកអាចនាំខ្ញុំទៅកាន់ផ្នែកដែលត្រឹមត្រូវបានទេ ?
តើខ្ញុំអាចសូមនិយាយទៅកាន់អ្នកមានទទួលខុសត្រូវ ?
ខ្ញុំឈឺខ្លាំងណាស់ ។
ខ្ញុំចង់មានការត្រួតពិនិត្យបែបវិជ្ជសាស្ត្រ ។
ខ្ញុំចង់ជួបគ្រូពេទ្យ ។
ខ្ញុំមិនអាចកំរើកដោយខ្លួនខ្ញុំផ្ទាល់ទេ ។
ខ្ញុំផ្តាសាយខ្លាំង ។
ខ្ញុំក្តៅខ្លួនតិចៗ ។
ខ្ញុំមិនអាចបញ្ឈប់ការក្អកទេ ។
មានការឈឺចាប់ដូចគេចាក់នៅខ្នងរបស់ខ្ញុំ ។
ខ្ញុំមិនអាចបកស្រាយស្ថានភាពរបស់ខ្ញុំជាភាសាអង់គ្លេសទេ ។
ខ្ញុំបាក់ជើង ។
កដៃរបស់ខ្ញុំត្រូវបានគ្រេច ។
ខ្ញុំនឹងអាចជាសះស្បើយឆាប់ទេ ?
តើខ្ញុំអាចសូមមានវិជ្ជបញ្ជាទេ ?
តើអ្នកមានអ្វីសំរាប់ការឈឺក្បាល ?
ខ្ញុំចង់បានថ្នាំសំរាប់ការពិបាករំលាយអាហារ ។
ខ្ញុំចង់ធ្វើការណាត់សំរាប់ការពិគ្រោះយោបល់ ។
ពេលណាក៏ល្អសំរាប់ខ្ញុំដែរ ។
