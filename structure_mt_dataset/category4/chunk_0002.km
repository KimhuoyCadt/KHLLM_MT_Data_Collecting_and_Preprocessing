បើសិនជាអ្នកប្រញាប់ សូមអញ្ជើញជិះតាក់ស៊ីទៅសណ្ឋាគារ ។
ទេ ខ្ញុំនឹងចាំនៅទីនេះសំរាប់ឡានលីមម៉ូស៊ីន ។
សូមទូរស័ព្ទមកខ្ញុំនៅពេលក្រោយ ។
ឡានលីមម៉ូស៊ីនមកមួយទៀតហើយ ។ សូមយកកាបូបរបស់ខ្ញុំ ។
ពិតប្រាកដណាស់ ។
នេះពួកយើង មានចំនួនបួន មែនទេ ?
ខ្ញុំនឹងយកកាបូបតូចដោយខ្លួនឯង ។
ហាសិបសេនសំរាប់កាបូបមួយ ដូច្នេះវាពីរដុល្លារ ។
អរគុណអ្នកខ្លាំងណាស់ ។ សូមអោយមានការធ្វើដំណើរល្អ ។
ខ្ញុំចង់សួរអ្នករឿងមួយ ។
តើខ្ញុំត្រូវអោយលុយធីបទៅអ្នកបើកបរឡានលីមម៉ូស៊ីនទេ ?
បាទ ខ្ញុំចង់ស្នាក់នៅសណ្ឋាគារនេះ ។
តើអ្នកបានធ្វើការកក់ហើយឬនៅ ?
បាទ ខ្ញុំបានកក់តាមការិយាល័យទេសចរណ៍ជប៉ុននៅតូក្យូ ។
ល្អណាស់ លោក ។ តើខ្ញុំអាចសុំឈ្មោះរបស់អ្នកបានទេ ?
ឈ្មោះរបស់ខ្ញុំគឺអ៊ិឈិរ៉ុ ថាណាកា ។
តើអ្នកមានគូប៉ុងអ្វី ឬក៏ ប័ណ្ណផ្លាស់ប្ដូរអ្វីធ្វើដោយភ្នាក់ងារទេសចរណ៍នោះទេ ?
អូ មាន ។ ខ្ញុំមានប័ណ្ណចំលងមួយនៅទីនេះ ។
សូមចាំមួយភ្លែត លោកថាណាកា ។ ខ្ញុំនឹងត្រួតពិនិត្យរបាយការណ៍របស់ពួកយើង ។
តើអ្នកនឹងស្នាក់នៅជាមួយពួកយើងយូរប៉ុណ្ណា ?
ពួកយើងមានបន្ទប់គ្រែមួយជាមួយទឹកផ្កាឈូក ។
ជាមួយទឹកផ្កាឈូក ? មិនមែនជាមួយអាងត្រាំទឹកទេ ?
ខ្ញុំត្រូវការបន្ទប់មួយជាមួយអាងត្រាំទឹក ។
សូមអភ័យទោស បន្ទប់មួយដែលនៅសល់គឺមានតែទឹកផ្កាឈូក ។
តើអ្នកអាចយកបន្ទប់នឹងសំរាប់តែយប់នេះបានទេ ?
តើអ្នកអាចអោយបន្ទប់មួយដែលមានអាងត្រាំទឹកដល់ខ្ញុំនៅថ្ងៃស្អែកបានទេ ?
បាទ ពួកយើងអាចធ្វើបាន ។
អញ្ចឹង ខ្ញុំនឹងយកបន្ទប់ហ្នឹង ។
សូមមេត្តាបំពេញនៅក្នុងក្រដាសចុះឈ្មោះនេះ ។
លោកថាណាកា នេះជាសោបន្ទប់របស់លោក ។ បន្ទប់របស់លោកគឺប្រាំ ម្ភៃប្រាំពីរ ។
វានៅជាន់ទីប្រាំណាលោក ។
តើវាជាបន្ទប់ស្ងប់ស្ងាត់ឬ ?
បាទ វាជាបន្ទប់ធំហើយស្ងប់ស្ងាត់ ។
វាពិតជាបន្ទប់ដ៏ស្ងប់ស្ងាត់ ។
តើបន្ទប់ហ្នឹងថ្លៃប៉ុន្មាន ?
ហាសិបដុល្លារក្នុងមួយយប់ ។
បាទ វាមិនរួមបញ្ចូលអាហារទេ ។
តើតំលៃសេវាកម្មប៉ុន្មានដែរ ?
ហាសិបភាគរយនៃតំលៃសេវាកម្មបន្ទប់នឹងបូកបន្ថែមទៅក្នុងវិក័យប័ត្រ ។
ពន្ធនឹងត្រូវបានគិតផ្សេងពីគ្នា ។
ឥឡូវនេះអ្នកកាន់វ៉ាលីនឹងយកកាបូបវ៉ាលីរបស់អ្នក ។
តើនេះជាវ៉ាលីទាំងអស់ដែលអ្នកមានឬ ?
កុំយកវ៉ាលីច្រលំ ។ នោះមិនមែនជាវ៉ាលីរបស់ខ្ញុំទេ ។
វាមើលទៅសឹងតែដូចគ្នា ។
ខ្ញុំមានរបស់ខ្ញុំនៅទីនេះ ពីរវ៉ាលី ។
ឥឡូវនេះ ខ្ញុំនឹងបង្ហាញបន្ទប់ដល់អ្នក ។
ផ្លូវនេះបាទ ។ បន្ទប់លេខប្រាំ ម្ភៃប្រាំពីរ ។
នេះជាបន្ទប់ស្ងប់ស្ងាត់ ។ ល្អណាស់ ។
បាទ នឹងហើយ ។ បន្ទប់ហ្នឹងមានទេសភាពល្អផងដែរ ។
បន្ទប់ទទួលទានអាហារធំនៅជាន់ទីដប់ពីរ ។
តើមានកន្លែងផ្សេងទៀតសំរាប់ការញ៉ាំនៅក្នុងនេះទេ ?
បន្ទប់សំរាប់ដុតអាហារប្រភេទអាឡឺខាតគឺនៅជាប់ទីមួយ ។
ហាងកាហ្វេគឺនៅជាន់ក្រោមដី ។
វាគឺជាកន្លែងល្អសំរាប់អាហារសំរន់ មែនទេ ?
វាពិតប្រាកដណាស់ ។
និយាយអញ្ចឹង តើខ្ញុំអាចញ៉ាំអាហារពេលល្ងាចបាននៅពេលណា ?
បន្ទប់ទទួលទានអាហារធំនឹងបើកនៅម៉ោងប្រាំបី ហើយបិទនៅម៉ោងដប់ ។
ចុះបន្ទប់ដុតសាច់វិញ ?
ពួកយើងបើកពីម៉ោងប្រាំបីកន្លះទៅម៉ោងដប់មួយ ។
វាដូចជាយឺតបន្តិចនៅពេលល្ងាច ។
ហាងកាហ្វេគឺបើកម្ភៃបួនម៉ោងក្នុងមួយថ្ងៃ ។
តើខ្ញុំត្រូវការក្រវ៉ាត់ក និង អាវក្រៅវែងនៅបន្ទប់ទទួលទានអាហារទេ ?
បាទ នៅក្នុងបន្ទប់ទទួលទានអាហារ និង បន្ទប់ដុតសាច់ ។
ឥឡូវខ្ញុំយល់ពីគំនិតហ្នឹងហើយ ។
តើមានសំណួរអ្វីផ្សេងទៀតទេ ?
តើអ្នកលក់តែមទេ ?
បាទ ពួកយើងមាននៅជាន់ក្រោមនៃសំណង់ដំបូលក្រហមនោះ ។
តែមក៏អាចទិញបាននៅទូរលក់របស់បំរើសេវាកម្មខ្លួនឯងនៅកន្លែងអង្គុយទទួលភ្ញៀវ ។
តើអ្នកគិតលុយរបស់អ្នកធ្វើការដល់ពាក់កណ្តាលយប់មែនទេ ?
បាទ ពួកយើងបើកពេញមួយយប់ ។
របស់សំខាន់បំផុត ពេលណាជាពេលឈែកអាវ ?
អរគុណអ្នកច្រើនសំរាប់រឿងកន្លងមក ។
បាទពួកយើងមាននៅសំណង់ដំបូលក្រហមនៅជាន់ក្រោមដី ។
អរុណសួស្តី ។ តើអ្នកមានគ្នាប៉ុន្មាននាក់សំរាប់ការទទួលទានអាហារ ?
តែម្នាក់ទេ ខ្ញុំផ្ទាល់ ។
តើអ្នកចាំបន្តិចបានទេ ?
តើខ្ញុំអាចទទួលការកុម្ម៉ង់របស់អ្នកបានទេ ?
តើអាហារពេលព្រឹកថេប៊លឌឺហតតេរបស់អ្នកមានអ្វី ?
ចាប់ពីលេខមួយទៅលេខប្រាំគឺក្លិបប្រេកហ្វឺស ។
ខ្ញុំយល់ហើយ ។ ខ្ញុំយកក្លិបប្រេកហ្វឺសលេខមួយ ។
វានឹងមានផ្លែឈើឬក៏ទឹកផ្លែឈើ ពងទា នំបុ័ងដុតនិងភេសជ្ជៈមួយ ។
សូមយកពងទាចៀន ពងលឿងនៅខាងលើជាមួយសាច់បេខន ។
ខ្ញុំយកក្រូចថ្លុង ។
សូមកុំធ្វើអោយនំបុ័ងស្រួយពេក ។
សូមយកពងទាក្រឡុកជាមួយបេខន ។
បេខនគួរតែស្រួយ អ្នកដឹងទេ ?
តើខ្ញុំអាចសុំទឹកខ្លះបានទេ ?
បាទ សូមចាំមួយភ្លែត ។ តើអ្នកត្រូវការកាហ្វេរបស់អ្នកឥឡូវនេះទេ ?
ទេ មិនមែនពេលនេះទេ សូមពេលក្រោយ ។
ខ្ញុំសង្ឃឹមថាអ្នកនឹងពេញចិត្តជាមួយអាហារពេលព្រឹកនេះ ។
វាល្អណាស់ ។ តើខ្ញុំអាចសុំវិក័យប័ត្របានទេ ?
រសៀលសួស្តី ។ ខ្ញុំកក់តុសំរាប់មនុស្សពីរនាក់ ។
ឈ្មោះរបស់ខ្ញុំគឺអាគិកូ ថាណាកា ។
កញ្ញាថាណាកា អូ សូមអញ្ជើញមកតាមផ្លូវនេះ ។
អរគុណ ។ កន្លែងអង្គុយទាំងនេះពិតជាល្អណាស់ ។
ខ្ញុំរីករាយណាស់ដែលអ្នកចូលចិត្តពួកវា ។
ការកុម្ម៉ង់របស់អ្នក ? តើអ្នកត្រូវការភេសជ្ជៈទេ ?
តើអ្នកត្រូវការម៉ាកអ្វី ?
តើអ្នកមានម៉ាកអ្វី ?
អញ្ចឹងខ្ញុំយកម៉ាកអេ ។
តើត្រូវការអាហារសំរន់អ្វីទេ ?
បាទ បង្គារស្រុះជាមួយទឹកជ្រលក់សំរាប់ខ្ញុំ និង ត្រីសាម៉ុនដុតសំរាប់គាត់ ។
បង្គារ និង ត្រីសាម៉ុនដុត ?
បាទ ត្រឹមត្រូវហើយ ។
សូមយកស៊ុបគ្រីមប៉េងប៉ោះពីរ ។
ត្រី និង ម្ហូបក្លែម ?
តើត្រូវការម្ហូបអឌឺវរអ្វីទេ ?
តើអ្នកនឹងញ៉ាំអ្វីសំរាប់ម្ហូបក្លែម ?
តើអ្នកចង់បានសាច់ស្ទេករបស់អ្នកយ៉ាងម៉េច ?
តើមានអាហារបន្ថែមតូចៗអ្វីទៀតទេ ?
តើទឹកជ្រលក់ប្រភេទណា ?
សូមយកទឹកជ្រលក់បែបបារាំង ។
ការ៉េមប៉ាហ្វេស្ត្រប៊ឺរីពីរ ។
តើអ្នកមានកាហ្វេដែលមិនមានជាតិកាហ្វេអ៊ីនទេ ?
សួស្តី អ្នករៀបចំបន្ទប់មែនទេ ?
បាទ តើខ្ញុំអាចជួយអ្វីបាន ?
សូមរៀបចំគ្រែរបស់ខ្ញុំអោយបានមុនម៉ោងប្រាំមួយ ។
ប្រាកដណាស់ ខ្ញុំនឹងធ្វើវា ។
ខ្ញុំចង់ផ្ញើរកញ្ចប់ឥវ៉ាន់មួយ ។ តើអ្នកណាគ្រប់គ្រងកញ្ចប់ឥវ៉ាន់ ?
សូមសួរអ្នកកាន់វ៉ាលី ។
សួស្តី កន្លែងទទួលភ្ញៀវមែនទេ ? មានការផ្ញើរសារអ្វីទេ ?
តើខ្ញុំអាចសុំឈ្មោះនិងលេខបន្ទប់របស់អ្នកបានទេ ?
នេះគឺលោកអ៊ិឈិរ៉ុ ថាណាកា បន្ទប់លេខប្រាំ ម្ភៃប្រាំពីរ ។
បាទ មានសំបុត្រមួយសំរាប់លោកនៅទីនេះ ។
ខ្ញុំនឹងរង់ចាំអ្នក ។
ខ្ញុំគឺលោកថាណាកា ខ្ញុំទើបតែនិយាយជាមួយអ្នក ។
នេះគឺសំបុត្រមួយសំរាប់អ្នក ។
សូមចុះហត្ថលេខាសំរាប់ការទទួលសំបុត្រ ។
សួស្តី សេវាកម្មបន្ទប់មែនទេ ?
តើខ្ញុំអាចសុំស្រាវីស្គីអនឌឺរ៉ុកមួយបានទេ ?
បាទ ខ្ញុំនឹងយកវាមកបន្តិចទៀតនេះ ។
នេះគឺការកុម្ម៉ង់របស់អ្នក ។
អរគុណ នេះរបស់អ្នក ។
អរគុណអ្នកច្រើន ។ រាត្រីសួស្តី ។
សួស្តី កន្លែងទទួលភ្ញៀវមែនទេ ? ដាស់ខ្ញុំនៅម៉ោងប្រាំព្រឹកស្អែក ។
ម៉ោងប្រាំព្រឹកស្អែក ?
ខ្ញុំនឹងឈែកអាវនៅម៉ោងប្រាំមួយកន្លះ ។
តើអ្នកមានកាបូបវ៉ាលីច្រើនទេ ?
ទេ មិនមានច្រើនទេ ។ តែពីរវ៉ាលីប៉ុណ្ណោះ ។
អ្នកកាន់វ៉ាលីរបស់យើងនឹងទៅយកវានៅម៉ោងប្រាំមួយកន្លះ ។
តើខ្ញុំគួរទុកវ៉ាលីរបស់ខ្ញុំនៅខាងក្រៅទ្វារទេ ?
អាវសមួយ និង ស្រោមជើងពីរគូរ ។
ពួកយើងនឹងធ្វើវាហើយសំរាប់អ្នកប្រហែលជានៅថ្ងៃត្រង់ ។
តើវាថ្លៃប៉ុន្មាន ?
មួយដុល្លារសំរាប់អាវមួយ និង មួយដុល្លារសំរាប់ស្រោមជើងពីរគូរ ។
ខ្ញុំភ្លេចសោរបស់ខ្ញុំនៅក្នុងបន្ទប់ ហើយក៏ចាក់សោ ។
គ្នានបញ្ហា ។ ជំនួយការអ្នកគ្រប់គ្រងរបស់ពួកយើងមានសោមេសំរាប់បើកវា ។
សូមអោយគាត់បើកទ្វារអោយខ្ញុំ ។
ខ្ញុំរកសាប៊ូ ឬក៏ កន្សែងពោះគោមិនឃើញសោះនៅក្នុងបន្ទប់របស់ខ្ញុំ ។
គ្រាន់តែបើកទ្វារកញ្ចក់នៅក្នុងបន្ទប់ទឹក ហើយអ្នកនឹងឃើញពួកវា ។
សូមចាំមួយភ្លែត ។ ខ្ញុំនៅក្នុងបន្ទប់ទឹក ។
នេះគឺជាអ្នករៀបចំផ្ទះ ។ ខ្ញុំនឹងមកវិញបន្តិចទៀត ។
ខ្ញុំនឹងឈែកអាវឥឡូវនេះ ។
អ៊ិឈិរ៉ុ ថាណាកា លេខបន្ទប់ប្រាំ ម្ភៃប្រាំពីរ ។
នេះជាវិក័យប័ត្ររបស់អ្នក ។ វាអស់បីរយកៅសិបពីរដុល្លារ ។
បាទ ប័ណ្ណអ្នកទេសចរណ៍គឺមិនអីទេ ។
អញ្ចឹង ខ្ញុំនឹងបង់បីរយហាសិបដុល្លារជាប័ណ្ណអ្នកទេសចរណ៍ ។
ខ្ញុំយល់ហើយ ។ អរគុណអ្នកច្រើន ។
ខ្ញុំរីករាយជាមួយការស្នាក់នៅជាមួយអ្នក ។
ខ្ញុំរីករាយណាស់ដែលលឺដូច្នេះ ។ សូមមកម្តងទៀត ។
ឥឡូវ តើខ្ញុំអាចសុំសោបន្ទប់របស់អ្នកបានទេ ?
នេះរបស់អ្នក ។ តើកាបូបវ៉ាលីរបស់ខ្ញុំយកមកក្រោមហើយឬ ?
កាបូបវ៉ាលីរបស់អ្នកនៅទីនោះហើយ ។
សូមយកកាបូបវ៉ាលីនេះទៅច្រកចេញខាងមុខហើយហៅតាក់ស៊ីផង ។
តើអ្នកមានធួរដើរកំសាន្តណាទេ ?
បាទ ។ តើចំណាយពេលប៉ុន្មានសំរាប់ដំណើរកំសាន្តមួយ ?
អីញ្ចឹង ពួកយើងមានដំណើរកំសាន្តល្អមួយសំរាប់អ្នក ។ វាគឺជាដំណើរកំសាន្តវិសម្សកាលពេញមួយថ្ងៃ ។
ស្តាប់ទៅដូចគួរអោយចាប់អារម្មណ៍ ។ តើដំណើរកំសាន្តហ្នឹងចាប់ផ្តើមនៅពេលណា ?
វាចាប់ផ្តើមនៅម៉ោងប្រាំបួនព្រឹក និងបញ្ចប់នៅម៉ោងប្រាំល្ងាច ។
តើខ្ញុំញ៉ាំអាហារថ្ងៃត្រង់នៅឯណា ?
នៅភោជនីយដ្ឋានឌី នៅក្នុងព្រៃស៊ី ។
តើម្នាក់ថ្លៃប៉ុន្មាន ?
ម្ភៃប្រាំដុល្លាររួមទាំងថ្លៃឡានក្រុង ថ្លៃមគ្គទេសក៍ និង ថ្លៃចូល ។
តើភ្នំដែលមានកំពូលគ្របដណ្តប់ដោយដុំទឹកកកនោះឈ្មោះអ្វី ?
ពួកយើងហៅវាថាភ្នំប៊ី ។ វាប្រហែលជាម្ភៃម៉ែលពីទីនេះ ។
តើអាគារដែលមានជញ្ជាំងធ្វើពីកញ្ចក់ជាអាគារអ្វី ?
នោះគឺជាមជ្ឈមណ្ឌលពាណិជ្ជកម្មដែលទើបនឹងសាងសង់រួច ។
តើអាគារដែលចម្លែកមួយនោះជាអាគារអ្វី ?
នោហៅថាប៉មឌី ។ វាសំរាប់ចតយានយន្ត ។
តើផ្លូវហ្នឹងឈ្មោះអ្វី ?
នេះគឺផ្លូវជី ហើយក៏ជាផ្លូវដ៏ធំបំផុតក្នុងក្រុងហ្នឹង ។
ទៅមុខត្រង់ហើយអាគារពណ៌សហ្នឹងនៅមុខគេ ។
អរគុណ ខ្ញុំនឹងព្យាយាមទៅទីនោះ ។
ផ្លូវនេះ ហើយបត់ស្តាំ ។
អរគុណ ខ្ញុំស្ទើរតែវង្វេងផ្លូវទៅហើយ ។
ផ្លូវនេះ ហើយបត់ឆ្វេង ។
តើខ្ញុំអាចថតរូបស្ពាននោះបានទេ ?
បាទ អ្នកអាចថតបាន ប៉ុន្តែកុំថតរូបផ្លូវរូងនេះអោយសោះ ។
ខ្ញុំមិនមែនជាឧទាហរណ៌ល្អទេ ។
យល់ព្រម ។ អរគុណអ្នកជាអនេក ។
ខ្ញុំនឹងផ្ញើរូបទៅអ្នកពេលដែលវាបោះពុម្ភហើយ ។
អ្នកពិតជាចិត្តល្អណាស់ ។
ពេលនេះ ពួកយើងនឹងថតរូបក្រុមទាំងមូលរបស់យើង ។
ហើយខ្ញុំចង់អោយអ្នកចូលរួមជាមួយពួកយើងដែល ប្រសិនបើអ្នកមិនប្រកាន់ ។
សូមឈរនៅកណ្តាលក្រុមរបស់ពួកយើង ។
សូមអរគុណដែលចូលរួមជាមួយពួកយើង ។
ខ្ញុំទេដែលគួរតែអរគុណ ។
តើខ្ញុំអាចជួយអ្វីអ្នកបាន ? តើអ្នកចង់បានកូនតុក្កតាក្រមុំខ្លះទេ ?
ខ្ញុំគ្រាន់តែមើលទេ អរគុណ ។
តើខ្ញុំអាចទិញស្រោមដៃនៅកន្លែងណា ?
យើងមានហាងលក់ស្រោមដៃនៅជាន់ទីពីរ ។
អរគុណ ។ តើស្រោមដៃមួយគូនេះថ្លៃប៉ុន្មាន ?
ពួកវាធំពេកសំរាប់ខ្ញុំ ។ តើអ្នកមានទំហំតូចជាងនេះទេ ?
សូមចាំមួយភ្លែត ។ ខ្ញុំនឹងទៅរកមើលសិន ។
សូមយកអាវលេខប៉ុននេះអោយខ្ញុំ ។
ខ្ញុំគិតមើលតិច សំរាប់ក្មេងប្រុសអាយុដប់ពីរឆ្នាំ ។
វាលឺពេកហើយ ។ តើអ្នកអាចបង្ហាញខ្ញុំអាមួយទៀតបានទេ ?
ពួកយើងមានពីរ ។ តើអ្នកចូលចិត្តមួយណា ?
វាថ្លៃប្រាំមួយដុល្លារ ។ តើអ្នកយកវាទេ ?
ខ្ញុំនឹងយកវា ។ ខ្ចប់វាជាកាដូមក ។
បាទ សូមបង់លុយនៅកន្លែងគិតលុយនៅទីនោះ ។
តើអ្នកមានប៊ិចក្បាលមូលមួយទេ ?
ប៊ិចក្បាលមូលនេះសរសេរល្អណាស់ ។ តើមួយឡូថ្លៃប៉ុន្មាន ?
ម្ភៃបួនដុល្លារ ។ តើអ្នកត្រូវការច្រើនទៀតទេ ?
តើអ្នកអាចចុះថ្លៃអោយខ្ញុំទេប្រសិនបើខ្ញុំទិញពីរឡូ ?
អឺ ខ្ញុំនឹងចុះថ្លៃជាពិសេស គឺសែសិបបីដុល្លារ ។
ល្អណាស់ ។ ខ្ញុំនឹងយកប៊ិចទាំងនេះ ។ ចុះស្លាបប៉ាកាទាំងនោះវិញ ?
មួយបីដុល្លារ ។
តើអ្នកចុះតម្លៃអោយខ្ញុំបានទេបើទិញមួយឡូ ?
ពួកយើងអាចចុះតម្លៃសំរាប់តែប៊ិចក្បាលមូលប៉ុណ្ណោះ ។
នេះគឺជាលុយសំរាប់ប៊ិចក្បាលមូលទាំងនេះ ។ ក្រដាសមួយរយដុល្លារមួយសន្លឹក ។
អរគុណ ។ នេះគឺលុយអាប់ ហាសិបប្រាំពីរដុល្លារ ។
តើអ្នកអាចអោយលុយរាយខ្ញុំខ្លះបានទេ ?
បាទ តើអ្នកចង់បានលុយរាយយ៉ាងម៉េចខ្លះ ?
នេះខ្ញុំមានក្រដាសមួយរយដុល្លារមួយសន្លឹក ។ អោយខ្ញុំក្រដាសម្ភៃប្រាំសន្លឹកមក ។
តើអ្នកអាចបំបែកក្រដាសម្ភៃដុល្លារទៅជាក្រដាសរាយម្ភៃសន្លឹកបានទេ ?
តើអ្នកត្រូវការកាក់ខ្លះទេ ?
ពួកយើងអត់មានកាក់ទេ ។
តើអ្នកអាចប្ដូរមូលប្បទានប័ត្រអ្នកទេសចរណ៍ជាសាច់ប្រាក់បានទេ ?
នៅធនាគារឬក៏នៅកន្លែងគិតលុយនៅក្នុងសណ្ឋាគារ ។
តើអ្នកអាចប្ដូរមូលប្បទានប័ត្រជាលុយយ៉េនជប៉ុនបានទេ ?
ទេ យើងមិនអាចទេ ។ ប្រសិនបើអ្នកចង់ទិញអ្វីមួយ លុយយ៉េនទើបប្រើបាន ។
តើអ្នកអាចប្រាប់ខ្ញុំពីអត្រាប្ដូរប្រាក់ថ្ងៃនេះបានទេ ?
ពីររយម្ភៃយ៉េនសំរាប់មួយដុល្លារ ។
សូមអោយស្រាវីស្គីខ្ញុំពីរដបនិងស្រាប្រ៊េនឌីមួយដបមក ។
តើខ្ញុំអាចសុំមើលសំបុត្រធ្វើដំណើររបស់អ្នកបានទេ ?
ល្អណាស់ តើអ្នកចង់បានប្រភេទអ្វីដែរ ?
សំរាប់ស្រាវីស្គីប៊ី និងស្រាប្រ៊េនឌីស៊ី ។
តើអ្នកមានបារីខ្លះទេ ?
ប្រសិនបើវាគ្មានពន្ធទេ ខ្ញុំនឹងយកប្រអប់ស៊ីមួយកាតុង ។
មួយកាតុងមានបារីពីររយដើម ។
អារុណសួស្តី ។ សូមអង្គុយចុះ ។
អារុណសួស្តី ។ តើខ្ញុំអាចកាត់សក់បានទេ ?
អត់កក់សក់ អត់កោរពុកមាត់ គ្រាន់តែកាត់សក់ប៉ុណ្ណោះ ។
តើអ្នកចង់កាត់សក់យ៉ាងម៉េច ?
មិនវែងពេកហើយក៏មិនខ្លីពេក ។
បាទ កុំកាត់ជើងសក់របស់ខ្ញុំ ។ ទុកវានៅចឹងទៅ ។
អាខាងឆ្វេងហ្នឹងសុំតម្រឹមបន្តិចមក ។
អត់ទេ នៅខាងមុខបន្តិច ។ បាទ គឺនៅទីនោះ ។
គ្រាន់តែសិតសក់របស់ខ្ញុំមកខានហ្នឹងបានហើយ ។
តើអ្នកមានប្រើថ្នាំជំនួយសក់ដែរឬទេ ?
ខ្ញុំចង់កក់សក់របស់ខ្ញុំ ។
ល្អ សូមអង្គុយចុះ ។
បន្ទាប់ពីកក់សក់ ខ្ញុំចង់ធ្វើក្រចក ។
ប្រាកដណាស់ តើអ្នកត្រូវការអ៊ុតសក់ទេ ?
បាទ តែកុំដាក់ខ្លាំងពេក ។
បាទ ខ្ញុំនឹងចំណាំវាទុក ។
តើអ្នកមានតុមួយសំរាប់មនុស្សបីនាក់ទេ ?
បាទ យើងមានតុមួយនៅជិតបង្អួតដែលមានទេសភាពល្អ ។
តើនេះគឺជាភោជនីយដ្ឋានគ្រឿងសមុទ្រមែនទេ ?
បាទ នេះគឺជាមុខម្ហូបណែនាំពីចុងភៅសំរាប់ថ្ងៃនេះ ។
នេះគឺជាមុខម្ហូបពិសេសសំរាប់ថ្ងៃនេះ ត្រីអណ្តាតឆ្កែអាំងជាមួយក្រូចឆ្មា ។
អោយខ្ញុំបន្ទះសាច់ហាំអាំង ប៉ុន្តែកុំយកក្រាស់ដូចហ្នឹងអី ។
សូមខ្ចប់នំប៉័ងសាច់ក្រកពីរ ។
ប្រាកដណាស់ នេះគឺទឹកម៉ូស្តាត ។
សូមអោយស្រាស្កុតពីរនិងទឹក ។
បាទ ខ្ញុំនឹងយកវាទៅភ្លាម ។
តើពេលណាការសម្តែងចាប់ផ្តើម ?
ពួកយើងមានការសម្តែងដ៏អស្ចារ្យមួយចាប់ផ្តើមនៅម៉ោងដប់ ។
អីចឹង ពួកយើងចង់ប្ដូរកៅអីរបស់ពួកយើងដែលនៅខាងមុខ តើវាមិនអីទេឬ ?
វាប្រហែលជាមិនអីទេ ប៉ុន្តែខ្ញុំត្រូវសួរអ្នកគ្រប់គ្រងរបស់ពួកយើងសិន ។
ខ្ញុំចង់បញ្ជាក់ម្តងទៀតពីជើងយន្តហោះរបស់ខ្ញុំទៅកាន់ឡូសអេនជិឡេសនៃក្រុមហ៊ុនអាកាសចរណ៍ប៊ី ។
តើនៅពេលណាហើយលេខជើងយន្តហោះលេខប៉ុន្មាន ?
លេខជើងយន្តហោះគឺលេខប្រាំពីរទៅកាន់ឡូសអេនជិឡេសថ្ងៃស្អែក ។
តើអ្នកបានធ្វើការកក់ហើយឬនៅ ?
ខ្ញុំមាននៅតូក្យូ ។
តើអ្នកឈ្មោះអ្វី ?
ល្អណាស់ លោកតាណាកា កៅអីរបស់អ្នកពេលនេះត្រូវបានបញ្ជាក់ម្តងទៀតហើយ ។
វាចេញដំណើរនៅម៉ោងប្រាំបីម្ភៃប្រាំនាទីព្រឹកពីអាកាសយានដ្ឋានសាន់ហ្វ្រាន់ស៊ីស្កូ ។
តើម៉ោងប៉ុន្មានខ្ញុំគួរទៅដល់ទីនោះ ?
សូមទៅដល់ទីនោះយ៉ាងយូរបំផុតម៉ោងប្រាំពីរសាមសិបនាទីព្រឹក ។
តើខ្ញុំអាចសុំអាសយដ្ឋានទំនាក់ទំនងរបស់អ្នកបានទេ ?
ខ្ញុំកំពុងស្នាក់នៅសណ្ឋាគារភ្រីនសេស ។
តើកន្លែងសំរាប់ឈែកអ៊ីនសំរាប់ក្រុមហ៊ុនអាកាសចរណ៍ប៊ីនៅឯណា ?
នៅកន្លែងមានអក្សរពណ៌ក្រហមនៅទីនោះ ។
នេះគឺជាស្លាកសំរាប់យកអីវ៉ាន់ សូមទៅកាន់ច្រកទ្វារលេខប្រាំ ។
តើច្រកទ្វារលេខប្រាំនេះសំរាប់ជើងយន្តហោះលេខប្រាំពីរមែន ?
ជើងយន្តហោះលេខប្រាំពីរត្រូវបានពន្យាពេលពីរម៉ោង ។
ខ្ញុំចង់បានពីរសំបុត្រទៅកាន់ប៊ី ។
តើទូររថភ្លើងខូជឬក៏ភូលមែន ?
តើរថភ្លើងមួយណា ?
ខ្សែលេខប្រាំនៅខាងនោះ ។
ទេ អ្នកមិនចាំបាច់ផ្ទេរទៅកាន់រថភ្លើងផ្សេងទៀតទេ ។
តើខ្ញុំអាចសុំឈប់សំរាប់ជាមួយនិងសំបុត្រនេះបានទេ ?
បាទ ការឈប់សំរាប់គឺឥតគិតថ្លៃទេ ។
តើនេះគឺជាក្រុមហ៊ុនកាសកាដលីមីធីដមែនទេ ?
សូមអភ័យទោស ខ្ញុំគិតថានេះជាកន្លែងអង្គុយរបស់ខ្ញុំ ។
សុំទោស ខ្ញុំនឹងមើលថែឆ្កែហ្នឹងអោយ ។
តើខ្ញុំអាចជក់បារីនៅទីនេះបានទេ ?
នៅទីនេះអត់បានទេ ។ មានបន្ទប់សំរាប់ជក់បារីមួយនៅខាងក្រោយទូររថភ្លើងនេះ ។
តើខ្ញុំអាចញ៉ាំនៅលើរថភ្លើងបានទេ ?
ពួកយើងមានទូររថភ្លើងសំរាប់ញ៉ាំអាហារនិងហាងកាហ្វេនៅលើរថភ្លើងនេះ ។
សូមចាំបន្តិច ។ ខ្ញុំនឹងមើលកាលវិភាគសិន ។ វាមានរយៈពេលបីម៉ោង ។
ពួកយើងមានទូររថភ្លើងសំរាប់គេងនិងហាងកាហ្វេនៅលើរថភ្លើងនេះ ។
សុំសំបុត្រ ? អ្នកខកចំណតរបស់អ្នកហើយ ។
តើខ្ញុំអាចត្រលប់ទៅគោលដៅរបស់ខ្ញុំវិញដោយរបៀបណា ?
ចុះនៅស្ថានីយ៍បន្ទាប់និងជិះរថភ្លើងលេខប្រាំបី ។
ខ្ញុំចង់ទៅតាមកប៉ាល់ ប៉ុន្តែតើបន្ទប់ទាំងនោះយ៉ាងម៉េចដែរ ?
បន្ទប់ទាំងអស់គឺអាចគេងបានពីរនាក់ ។
តើអ្នកមានសេវាកម្មទូកចម្លងទៅកាន់ឌីទេ ?
បាទ ពួកយើងមាន ។ ទូកបើកលើទឹកនិងកប៉ាលហោះលើទឹកទាំងអស់អាចរកជិះបាន ។
តើខ្ញុំត្រូវកក់កន្លែងនៅលើទូកសំរាប់ចុះទៅទន្លេទេ ?
ទេ ទូកហ្នឹងមិនអាចកក់កៅអីជាមុនបានទេ ។
តើឡានក្រុងនេះទៅកាន់រុក្ខវិថីឌីដែរឬទេ ?
តើថ្លៃប៉ុន្មានទៅកាន់រុក្ខវិថីឌី ?
ចិតសិបប្រាំសេន ។ សូមដាក់លុយនៅក្នុងម៉ាស៊ីននេះ ។
សូមប្រាប់ខ្ញុំអោយដឹងផងពេលដែលយើងទៅដល់រុក្ខវិថីឌី ។
តើស្ថានីយឡានក្រុងសំរាប់ឡានក្រុងទៅឆ្ងាយៗនៅឯណា ?
អ្នកនឹងឃើញស្ថានីយឡានក្រុងនៅកាច់ជ្រុងផ្លូវហ្នឹង ។
សុំសំបុត្រមួយទៅកាន់វ៉ាស៊ីនតោន ។ តើជិះតាមឡានក្រុងប្រើរយៈពេលប៉ុន្មាន ?
ប្រាំមួយម៉ោងរួមទាំងការឈប់សំរាក ។
ទៅកាន់ទីកន្លែងនេះ ។
តើអ្នកអាចប្រញាប់បានទេ ។ ខ្ញុំយឹតហើយ ។
តើអ្នកអាចបត់ស្តាំបានទេ ?
នៅទីនេះអត់អាចបត់ស្តាំបានទេ ។
នេះយកមកដល់សេនត្រល់ផ្លាសាហើយ ។ កុងទ័រប្រាប់ថាអស់ប្រាំបួនដុល្លារ ។
តើអ្នកអាចបត់ឆ្វេងបានទេ ?
នៅទីនេះអត់អាចបត់ឆ្វេងបានទេ ។
សួស្តី នេះគឺសហការី សេវាកម្មទូរស័ព្ទអន្តរជាតិ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទទៅកាន់តូក្យូ ប្រទេសជប៉ុន ។
វាគឺតូក្យូ សូន្យបីបីពីរប្រាំប្រាំពីរប្រាំបីបីប្រាំបួនមួយ ។
សូន្យបីគឺជាលេខកូដតំបន់មែនទេ ?
តើខ្ញុំអាចសុំលេខទូរស័ព្ទរបស់អ្នកបានទេ ?
ពីរមួយពីរបីបួនប្រាំបីបីបីពាន់ ។
សូមបិទទូរស័ព្ទបន្តិច ។ ខ្ញុំនឹងហៅទៅវិញនាពេលក្រោយ ។
យល់ព្រម ខ្ញុំបិទទូរស័ព្ទឥឡូវនេះហើយ ។
សូស្តី ពួកយើងហៅពីតូក្យូ ប៉ុន្តែគ្មានអ្នកណាលើកសោះ ។
អូ ខ្ញុំភ្លេចថាម៉ោងខុសគ្នា ។ ពេលនេះគឺវាពាក់កណ្តាលអាធ្រាត្រនៅតូក្យូ ។
សូមព្យាយាមទៅកាន់តូក្យូម្តងទៀត ។ សូមធ្វើការហៅទូរស័ព្ទដែលគិតលុយពីអ្នកទទួល ។
សូស្តី ភាគីរបស់អ្នកនៅលើខ្សែនេះ ។ សូមអញ្ចើញ ។
សូស្តី ម៉ូស៊ីម៉ុស៊ី ។
តើអ្នកចប់ហើយឬ ?
បាទ ។ តើហៅទូរស័ព្ទមិញអស់ប៉ុន្មាន ?
អស់ដប់ប្រាំបីដុល្លារ ។
ទេ អត់បង់ទេ ។ អ្នកទទួលនឹងបង់ហើយ ។
ខ្ញុំចង់ផ្ញើកាតប៉ុស្តាល់ទាំងនេះទៅប្រទេសជប៉ុន ។
តើអ្នកត្រូវការតែមប្រៃសណីយ៍ទេ ?
បាទ តើសំរាប់កាតប៉ុស្តាល់ទាំងប្រាំមួយនេះថ្លៃប៉ុន្មាន ?
មួយៗថ្លៃដប់ប្រាំសេន ទាំងអស់ថ្លៃកៅសិបសេន ។
អោយខ្ញុំបន្ទះបិតសំរាប់កាតទាំងនេះដើម្បីផ្ញើតាមយន្តហោះ ។
ខ្ញុំបានពួកវាអោយអ្នកជាមួយនិងតែមប្រៃសណីយ៍ ។
ខ្ញុំចង់ផ្ញើដប់ពីរកញ្ចប់ទៅកាន់ប្រទេសជប៉ុន ។
អឺ ខ្ញុំនឹងថ្លឹងពួកវាម្តងមួយ ។
មួយៗទម្ងន់ដូចគ្នា ។
ប្រហែលហើយ តែយើងត្រូវតែថ្លឹងវាដាច់ពីគ្នា ។
នេះគឺជាទីដប់ពីរ និងជាចំណែកចុងក្រោយដែរ ។
តើអ្នកចង់ផ្ញើពួកវាតាមយន្តហោះឬក៏កប៉ាល ?
ផ្ញើពួកវាតាមកប៉ាល ។
តើនៅក្នុងពូកវាមានអីដែរ ?
សៀវភៅនិងប័ណ្ណផ្សាយពាណិជ្ជកម្ម ។
បាទ គឺពួកវា ។ តើវាត្រូវការរយៈពេលប៉ុន្មានដើម្បីទៅដល់ជប៉ុន ?
ខ្ញុំសូមគិតមើលតិច ប្រហែលជាដប់ពីរថ្ងៃ ។
ផ្ញើពួកវាតាមសមុទ្រ ។
ខ្ញុំឈឺក្បាលខ្លាំង ។ តើអ្នកស្គាល់ពេទ្យល្អៗនៅក្បែរនេះទេ ?
ខ្ញុំស្គាល់វេជ្ជបណ្ឌិតគួរអោយទុកចិត្តម្នាក់ ។
តើអ្នកអាចហៅគាត់អោយខ្ញុំបានទេ ?
ទេ អ្នកត្រូវតែទៅមន្ទីរពេទ្យឯកជន ។ គាត់នឹងទទួលអ្នកនៅទីនោះ ។
តើវាគឺជាមន្ទីរពេទ្យឯកជនអេហ្វឬ ?
តើអ្នកឈឺអីដែរ ?
ខ្ញុំឈឺក្បាលខ្លាំង ហើយខ្ញុំចុកខ្នង ។
តើអ្នកឈឺត្រង់កន្លាក់ដែរឬទេ ?
ទេ គ្រាន់តែឈឺក្បាលនិងឈឺខ្នងប៉ុណ្ណោះ ។
ឥឡូវនេះ បើកមាត់របស់អ្នក ។ តើអ្នកឈឺកទេ ?
សូមក្រាបនៅទីនោះ ។ ក្រាបខ្នងចុះ ។
បាទ ដាក់ប្រដាប់វាស់កម្តៅក្នុងមាត់របស់អ្នក ។
លើពោះរបស់អ្នក ។
អ្នកក្តៅខ្លួនបន្តិច ។ អ្នកផ្តាសាយហើយ ។
តើវាធ្ងន់ធ្ងរទេ ?
ទេ វាមិនគួរអោយភ័យទេ ។ សំរាប់ពីរបីថ្ងៃទៅអ្នកនឹងស្រួលបួលឡើងវិញហើយ ។
អរគុណ លោកគ្រូពេទ្យ ។ តើខ្ញុំត្រូវបង់ប៉ុន្មាន ?
ដប់ប្រាំដុល្លារសំរាប់ថ្លៃពិនិត្យរោគវិនិច្ឆ័យ ។ ខ្ញុំនឹងចេញវេជ្ជបញ្ជាអោយអ្នក ។
តើខ្ញុំអាចយកថ្នាំនៅទីនេះបានទេ ?
ទេ អ្នកអាចទិញនៅហាងថ្នាំបាន ។
សូមនិយាយវាម្តងទៀត ។
ខ្ញុំឈ្មោះគេនជិ ម៉ូរិតា ។ តើខ្ញុំអាចសុំឈ្មោះរបស់អ្នកបានទេ ?
ខ្ញុំគឺ អែន ប្រ៊ោន ។
ខ្ញុំមកពីយ៉ូកូហាម៉ា ប្រទេសជប៉ុន ។
យ៉ូកូហាម៉ានៅជិតតូក្យូ ។
ខ្ញុំនឹងទៅញូវយក ។ ចុះអ្នកវិញ ?
ខ្ញុំនឹងទៅឈិខាហ្គូ ។
ខ្ញុំគឺជាបុគ្គលិកក្រុមហ៊ុនម្នាក់ ។
ខ្ញុំជួយកិច្ចការនៅផ្ទះ ។
ខ្ញុំគឺជាមេផ្ទះ ។
ខ្ញុំគឺជាវិស្វករមួយរូប ។
ខ្ញុំគឺជាគ្រូពេទ្យ ។
ខ្ញុំគឺជាបុគ្គលិកធនាគារ ។
ពិធីបុណ្យផឹកតែជាកម្មវិធីមួយដែលខ្ញុំចូលចិត្តធ្វើនៅពេលទំនេរ ។
ពិធីបុណ្យផឹកតែគឺជាសកម្មភាពប្រពៃណីទំនៀមទំលាប់ដែលជាប់ទាក់ទងនឹងការបំរើនិងផឹកទឹកតែ ។
អិគេបាណាគឺជាសិល្បៈនៃការតុបតែងផ្កា ។ មានសាលាអិគេបាណាច្រើនជាងបីពាន់សាលានៅក្នុងប្រទេសជប៉ុន ។
សូដុគឺជាសិល្បៈនៃអក្សរផ្ចង់ ។ អ្នកអក្សរផ្ចង់ប្រើប្រាស់ហ៊្វូឌេ ស៊ុមិ និងហានស៊ិ ។
ហ្គុគឺជាល្បែងមួយដែលលេងជាមួយនិងដុំថ្មពណ៌ខ្មៅនិងសនៅលើក្តារមួយ ។ នៅចុងការប្រកួត អ្នកដែលមានគ្រប់គ្រងតំបន់ច្រើនជាងគឺជាអ្នកឈ្នះ ។
សូដុគឺជាសិល្បៈនៃអក្សរផ្ចង់ ។ អ្នកអក្សរផ្ចង់ប្រើប្រាស់ជក់សរសេរ ទឹកខ្មៅឥណ្ឌា និងក្រដាសសរសេររបស់ជប៉ុន ។
ខេនដុ គឺជាកីឡាចាក់សាបរបស់ជប៉ុន ។ គូបដិបក្សវាយនឹងឈើឬស្សីពិសេសម្យ៉ាងជំនួសអោយដាវ ។
ជូដុ ការប្រយុទ្ធដៃនឹងដៃ គឺជាក្បាច់គុណមួយរបស់ជប៉ុនសំរាប់ការពារខ្លួន ។
ការាត់តេ ការប្រយុទ្ធដៃនឹងដៃផ្តោតសំខាន់លើកណ្តាប់ដៃនិងការធាក់ដ៏មុតស្រួច ក៏ជាក្បាច់គុណមួយរបស់ជប៉ុនសំរាប់ការពារខ្លួនដែរ ។
តើអ្នកធ្លាប់ធ្វើដំណើរទៅប្រទេសជប៉ុនទេ ? ខ្ញុំជូនពរអោយអ្នកបានទៅលេងដែរ ។
ខ្ញុំនឹងទៅ ប្រសិនបើមានឪកាស ។ ខ្ញុំនឹងទៅប្រសិនបើខ្ញុំមានពេល ។
សុំស្រាស្កុតនិងទឹកមួយ ។
ខ្ញុំមានអារម្មណ៍អត់សូវស្រួលខ្លួនទេ ។
តើខ្ញុំអាចសុំថ្នាំពុលយន្តហោះខ្លះបានទេ ?
តើខ្ញុំអាចសុំខ្នើយនិងភួយមួយបានទេ ?
តើខ្ញុំអាចទម្រេតកៅអីនេះទៅក្រោយពេលនេះបានទេ ?
សុភាពនារីនិងសុភាពបុរសទាំងអស់ មេក្រុមជចកូហេន និងយានិករបស់គាត់ទាំងអស់សូមស្វាគមន៍អ្នកដែលធ្វើដំណើរតាមក្រុមហ៊ុនអាកាសចរណ៍យូណាយធីត ជើងហោះហើរប្រាំបីសូន្យសូន្យទៅកាន់ញូវយក ។ ប្រសិនបើអ្នកត្រូវការអីក្នុងពេលធ្វើដំណើរ លោកអ្នកអាចសាកសួរបាន ពួកយើងនឹងរីករាយនឹងជួយ ។
នៅសណ្ឋាគារសាប់មីត ។
ប្រហែលជាដប់ប្រាំថ្ងៃ ។
អឺ ម្ភៃពីរថ្ងៃគួរតែគ្រប់គ្រាន់ហើយ ។ អរគុណ ។
សូមអោយមានការស្នាក់នៅដ៏ល្អមួយ ។
ទាំងនេះគឺជានំប៊ីសស្គីជប៉ុន ។
របស់របរផ្ទាល់ខ្លួន ។
កាដូសំរាប់មិត្តរបស់ខ្ញុំ ។
សូមយកអីវ៉ាន់របស់ខ្ញុំទៅកាន់បញ្ឈររង់ចាំឡានក្រុងទំនើប ។
តើរថយន្តទំនើបនេះទៅកាន់សណ្ឋាគារសាប់មីតដែរឬទេ ?
តើខ្ញុំអាចស្វែងរករថយន្តទំនើបទៅសណ្ឋាគារសាប់មីតនៅឯណា ?
ជិះវារហូតដល់ស្ថានីយ ។ ពីទីនោះអ្នកអាចដើរទៅសណ្ឋាគារដោយខ្លួនឯងបានហើយ ។
តើខ្ញុំត្រូវបង់ថ្លៃធ្វើដំណើរនេះអោយអ្នកណា ?
ទៅយកសំបុត្ររបស់អ្នកនៅការិយាល័យ ។
តើចំណតមួយណាដែលនៅជិតសណ្ឋាគារសាប់មីតបំផុត ?
យើងឈប់នៅសណ្ឋាគារប៊េវ័រលី ។ អ្នកចុះនៅទីនោះ ។ ដើរតែពីរបីនាទីដល់សណ្ឋាគារសាប់មីតហើយ ។
តាប្យូ អូសូរ៉ា ។
សូមចាំបន្តិច ។ យកបន្ទប់មួយមានគ្រែភ្លោះមានបន្ទប់ទឹកនៅក្នុងតម្លៃសែសិបប្រាំដុល្លារសំរាប់មួយយប់ ។ សែសិបប្រាំដុល្លារ ។ តើវាមិនអីទេឬ ?
តើគិតលុយម៉ោងប៉ុន្មាន ?
សូស្តី សហការី ?
ខ្ញុំចង់បានការហៅទូរស័ព្ទមកដាស់នៅព្រឹកស្អែកម៉ោងប្រាំពីរ ។
អូសូរ៉ានៅប្រាំ មួយ ប្រាំពីរ ។
គ្មានទឹកក្តៅ ។
គ្មានរូបនៅលើកញ្ចក់ទូរទស្សន៍ទេ ។
ធុងទឹកកកខូចហើយ ។
ខ្ញុំជាប់សោរនៅក្នុងបន្ទប់របស់ខ្ញុំ ។
ម៉ាស៊ីនកម្តៅខូចហើយ ។
សូស្តី សេវាកម្មបន្ទប់មែនទេ ? យកស្រាវីស្គីជាមួយទឹកកកមកកាន់បន្ទប់ប្រាំដប់ប្រាំពីរ ។ សុំនំប៊ីសស្គីផ្សេងៗនិងឈឺសរួមទាំងភេសជ្ជៈផង ។
តើអ្នកអាចយកអាហារពេលព្រឹកមកអោយខ្ញុំពេលនេះបានទេ ?
តើខ្ញុំអាចបានពួកវាត្រលប់មកវិញនៅពេលណា ?
ល្ងាចថ្ងៃខានស្អែក ។
ខ្ញុំចង់អោយខោអាវរបស់ខ្ញុំបោកគក់អោយហើយនៅមុនម៉ោងប្រាំពីរព្រឹកស្អែកប្រសិនបើអាចទៅរួច ។
ខ្ញុំចង់ធ្វើការណាត់ជួបមួយនៅថ្ងៃនេះម៉ោងប្រាំល្ងាច ។
ប្រាកដណាស់ ។ តើយើងអាចបំរើអ្វីអ្នកបាន ?
ខ្ញុំចង់អ៊ុតសក់និងធ្វើក្រចក ។
អិគុយុ អូសូរ៉ា ។
សុំគិតលុយ ។ ខ្ញុំចេញទៅហើយ ។
នេះវិក័យប័ត្ររបស់លោក ។
ខ្ញុំនឹងបង់វាជាមួយនិងមូលប្បទានប័ត្រទេសចរណ៍ ។
សូមអរគុណលោកដែលបានស្នាក់នៅជាមួយពួកយើង ។
សូមត្រលប់មកវិញឆាប់ៗ ។
តើភោជនីយដ្ឋានបារាំងនៅឯណា ?
តើខ្ញុំត្រូវធ្វើការកក់ទុកជាមុនទេ ?
តើចាំបាច់ត្រូវពាក់អាវធំនិងក្រវាត់កឬ ?
តើនារីៗគួរតែពាក់សំលៀកបំពាក់ផ្លូវការឬក៏ពួកគេអាចពាក់ខោអាវធម្មតាៗបាន ?
តើភោជនីយដ្ឋានហ្នឹងអាចបើកយឺតរហូតដល់ពេលណា ?
តើអ្នកអាចកក់អោយខ្ញុំបានទេ ?
ខ្ញុំមានការកក់រួចហើយ ។ អូសូរ៉ា ។
តុសំរាប់ពីរនាក់ឬ ?
ខ្ញុំនឹងយកអានេះនិងអានេះ ។
ខ្ញុំនឹងយកស្រាហ្វីមហ្លង់និងទឹកស៊ុបខ្ទឹមបារាំង ។
សុំនំភៃឈឿរីសំរាប់បង្អែមនិងកាហ្វេ ។
តើអ្នកអាចហុចអំបិលអោយខ្ញុំបានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីហាងបំរើដោយខ្លួនឯងដែលនៅជិតនេះបំផុតនៅកន្លែងណាបានទេ ?
សុំនំប៉័ងហត់ដកពីរ ។
ជាមួយនិងទឹកមូស្តាត ទឹកប៉េងប៉ោះ ឬក៏ទឹករីលីស ?
ជាមួយនិងទឹកមូស្តាត ខ្ទឹមបារាំង និងទឹកប៉េងប៉ោះ ។
តើមានហាងដែលភ្ញៀវចាប់ម្ហូបដោយខ្លួនឯងនៅក្បែរនេះទេ ?
ខ្ញុំដាក់លុយចូលហើយតែគ្មានអ្វីចេញមកសោះ ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេថាបារដែលក់អាហារសម្រន់នៅជិតបំផុតនៅឯណា ?
សុំនំសាន់វ៉ិច ។
ស្រាវិស្គីពីរនិងទឹក ។
តើបង្កាន់ដៃហ្នឹងរួមបញ្ចូលនឹងថ្លៃចូលដែរឬទេ ?
សូមបង្ហាញខ្ញុំពីខិតប័ណ្ណខ្លះៗនៃដំណើរកំសាន្ត ។ ខ្ញុំចង់ទៅលេងរូបសំណាក់សន្តិភាព ។
តើអ្នកមានដំណើរកំសាន្តតាមរយៈឡានក្រុងចំនួនប្រាំម៉ោងដែរឬទេ ?
តើដំណើរកំសាន្តនេះថ្លៃប៉ុន្មាន ? តើអ្នកមគ្គទេសចេះនិយាយភាសាជប៉ុនទេ ?
តើអ្នកអាចមកយកខ្ញុំនៅសណ្ឋាគារសាប់មីតបានទេ ?
តើដំណើរកំសាន្តបញ្ចប់នៅម៉ោងប៉ុន្មាន ?
តើអ្នកមានផែនទីទីក្រុងដែលឥតគិតថ្លៃមួយទេ ?
តើផ្លូវនេះឈ្មោះអ្វី ?
តើអាគារនោះជាអាគារអ្វី ?
ដើរទៅមុខត្រង់រហូតអ្នកទៅដល់ស្តុបទីពីរ ។
តាមខ្ញុំមក ។ ខ្ញុំនឹងអ្នកដល់ទីនោះ ។
ចាំខ្ញុំគូសផែនទីអោយអ្នក ។
វាឆ្ងាយពេកហើយ ។ យកល្អជិះតាក់ស៊ីទៅ ។
ខ្ញុំចង់មើលកុន ។
ខ្ញុំចង់ជួលក្តារជិះទូកក្តោង ។
ខ្ញុំចង់លេងហ្គុលហ្វ៍ ។
ខ្ញុំចង់ទៅស្ទូចត្រី ។
ខ្ញុំចង់ឃើញរបាំបាល់ឡេ ។
ខ្ញុំចង់មើលការប្រកួតបាល់ទាត់ ។
ខ្ញុំចង់មើលការប្រកួតបេស្បលមួយ ។
ខ្ញុំចង់មើលការប្រកួតបាល់ទាត់ ។
ខ្ញុំចង់ជួលទូកមួយ ។
ខ្ញុំចង់លេងតេនីស ។
ខ្ញុំចង់ទៅជិះលើខ្នងសេះ ។
តើអ្នកអាចថតរូបអោយខ្ញុំបានទេ ?
តើមានហាងកាមេរ៉ាណានៅក្បែរនេះទេ ?
តើអ្នកអាចជួសជុលវាទេ ? តើវាហើយពេលណា ?
តើមានសេវាឡានក្រុងទៅកាន់សារមន្ទីរហ្វដឬទេ ?
តើចំណតឡានក្រុងសំរាប់ទៅសារមន្ទីរហ្វដនៅកន្លែងណា ?
តើអ្នកទៅសារមន្ទីរហ្វដដែរឬទេ ?
តើទៅសារមន្ទីរថ្លៃប៉ុន្មាន ?
ប្រាប់ខ្ញុំនៅពេលដែលយើងទៅដល់សារមន្ទីរ ។
ឈិខាហ្គូ តែទៅមួយសំបុត្រ ។
តើឡានក្រុងចេញនៅម៉ោងប៉ុន្មាន ?
សូមហៅតាក់ស៊ីអោយខ្ញុំមួយ ។
តើខ្ញុំអាចរកកន្លែងឈរចាំតាក់ស៊ីនៅឯណា ?
ទៅកាន់សារមន្ទីរហ្វដ ។
ទីនេះ យើងដល់ហើយ ។
ខ្ញុំចង់ជួលឡានមួយ ។
ឡានតូចល្មមមួយ ។
តើអ្នកគិតថ្លៃប៉ុន្មានក្នុងមួយថ្ងៃ ?
ដប់ប្រាំដុល្លារសំរាប់ម្ភៃបួនម៉ោង បូកបន្ថែមនឹងម្ភៃសេនក្នុងមួយម៉ែល ។
តើរួមបញ្ចូលការធានារ៉ាប់រងដែរឬទេ ?
ខ្ញុំចង់មើលវាសិនមុននឹងខ្ញុំជួលវា ។
តើខ្ញុំអាចកក់ទូររថភ្លើងនៅឯណា ?
ខ្ញុំចង់កក់គ្រែមួយនៅលើទូកទៅកាន់ម៉ាយអាមិ ។
តើទៅដល់ម៉ាយអាមិចំណាយអស់ពេលប៉ុន្មាន ?
តើមួយថ្ងៃៗមានទូកចំនួនប៉ុន្មាន ?
តើខ្ញុំត្រូវបង់ប៉ុន្មានសំរាប់បន្ទប់ឯកជនមួយ ?
តើនាងជិះទូកក្តោងនៅម៉ោងប៉ុន្មាន ?
តើខ្ញុំត្រូវបង់ប៉ុន្មានសំរាប់បន្ទប់ឯកជនមួយ ។
សុំសំបុត្រពីរនៅលើទូររថភ្លើងដែលមានគ្រែដេកទៅកាន់ឈិខាហ្គូ ។
បាទ អ្នកអាចឈប់នៅស្ថានីយណាក៏បានពីទីនេះនិងឈិខាហ្គូ ។
កាបូបលុយនិងម៉ាស៊ីនថតរូបរបស់ខ្ញុំត្រូវបានគេលួចហើយ ។
ខ្ញុំបាត់នាឡិកាដៃរបស់ខ្ញុំ ។
ខ្ញុំទុកវានៅបន្ទប់របស់ខ្ញុំ ។
ខ្ញុំត្រូវបានគេប្លន់យកគ្រឿងអលង្ការ ។
ចោរឆក់ហោប៉ៅបានលួចយកមូលប្បទានប័ត្រទេសចរណ៍របស់ខ្ញុំ ។
តើអ្នកអាចប្ដូរលុយនេះបានទេ ?
ខ្ញុំចង់បានក្រដាសម្ភៃដុល្លារបួនសន្លឹកនិងក្រដាសរាយម្ភៃសន្លឹកសំរាប់ក្រដាសមួយររយដុល្លារនេះ ។
តើអ្នកអាចប្ដូរវាទៅកាន់លុយយ៉េនជប៉ុនបានទេ ?
ខ្ញុំចង់ទិញអាវក្រៅខោប៊ូយមួយ ។ តើខ្ញុំអាចទិញវានៅឯណា ?
តើអ្នកមានអាវចាក់ទេ ?
សូមបង្ហាញខ្ញុំនូវអាវចាក់តូចខ្លះ ។
វាគឺឆើតពេក ។ តើអ្នកមានមួយផ្សេងទៀតទេ ?
តើអ្នកអាចចុះតំលៃខ្លះអោយខ្ញុំបានទេ ?
ខ្ញុំនឹងយកពីរក្នុងចំណោមរបស់ទាំងនេះ ។
តើអ្នកអាចខ្ចប់វាបានទេ ?
សូមធ្វើវិក័យប័ត្រសំរាប់របស់នេះអោយខ្ញុំ ។
សួស្តី តើលោកប្រោននៅទីនោះទេ ? នេះគឺថាប៊ីអូ អាអូសូរ៉ា ។
គាត់មិននៅទីនេះទេ ។ គាត់នឹងត្រលប់មកវិញប្រហែលមួយម៉ោងទៀត ។
ខ្ញុំនឹងទូរស័ព្ទទៅគាត់នៅពេលក្រោយ ។
បាទ ខ្ញុំនឹងប្រាប់គាត់ ។ អរគុណសំរាប់ការទូរស័ព្ទមក ។
អ្នកភ្ជាប់បណ្តាញ ? ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទអន្តរជាតិទៅកាន់តូក្យូ ។ នេះគឺលោកតាប៊ីអូ បន្ទប់លេខប្រាំ សែសិបបី ។ ខ្ញុំចង់ទូរស័ព្ទដោយគិតលុយតែនៅពេលបានជួបភាគីម្ខាងទៀត ហើយអោយអ្នកទទួលជាអ្នកបង់ប្រាក់ ទៅកាន់កញ្ញាយ៉ូកូ អាអូសូរ៉ា នៅតូក្យូ លេខបី ពីរ ប្រាំ ប្រាំពីរ ប្រាំបី បី ប្រាំមួយ ប្រាំបួន ។
សូមកុំទាន់ដាក់ទូរស័ព្ទចុះ ហើយរង់ចាំ ។
កញ្ញាយ៉ូកូ អាអូសូរ៉ា ? លោកអាអូសូរ៉ា ហៅទូរស័ព្ទមកអ្នកដោយអោយអ្នកចេញលើចំណាយថ្លៃទូរស័ព្ទនេះ ។ តើអ្នកទទួលការហៅនេះទេ ?
ភាគីរបស់អ្នកគឺត្រូវបានភ្ជាប់ហើយ ។ សូមចាប់ផ្តើម ។
តើអ្នកអាចប្រាប់ខ្ញុំពីផ្លូវទៅកាន់ការិយាល័យប្រៃសណីយ៍បានទេ ?
តើមានប្រអប់សំបុត្រខ្លះនៅក្បែរទីនេះទេ ?
ខ្ញុំចង់ផ្ញើរបស់នេះតាមរយៈផ្លូវអាកាស ។
ខ្ញុំចង់ផ្ញើរបស់នេះតាមរយៈផ្លូវទឹក ។
ខ្ញុំចង់ផ្ញើរបស់នេះជាប៉ុស្តិ៍កញ្ចប់ប្រៃសណីយ៍ ។
បំពេញវាហើយបិទលើកញ្ចប់ឥវ៉ាន់ ។
ខ្ញុំចង់ផ្ញើវាដោយទូរលេខ ។
សូមធ្វើវាជាទូរលេខដែលមានអាត្រាពេញមួយ ។
ខ្ញុំឈឺខ្លាំងណាស់នៅក្នុងពោះរបស់ខ្ញុំ ។
តើខ្ញុំត្រូវចំណាយរយៈពេលប៉ុន្មានដើម្បីធូរស្បើយ ?
តើខ្ញុំអាចបន្តដំណើរកំសាន្តទេ ?
តើខ្ញុំត្រូវស្នាក់នៅមន្ទីរពេទ្យទេ ?
តើអ្នកនឹងផ្តល់អោយខ្ញុំនូវការសង្គ្រោះបឋមទេ ?
តើខ្ញុំត្រូវលេបថ្នាំញឹកញាប់ប៉ុណ្ណាដែរ ?
ភ្នែកខ្ញុំឈឺ ។
ភ្នែករបស់ខ្ញុំមានអារម្មណ៍ថាហត់ ។
ភ្នែកខ្ញុំរមាស់ ។
ភ្នែករបស់ខ្ញុំចេញទឹកដូចស្លេសពណ៌លឿង ។
ភ្នែករបស់ខ្ញុំចុះខ្សោយ ។
ការមើលឃើញរបស់ខ្ញុំគឺទាបទៅៗ ។
ខ្ញុំមើលរបស់មិនសូវឃើញទេ ។
ខ្ញុំមិនអាចមើលឃើញវត្ថុនៅពេលល្ងាចទេ ។
ខ្ញុំឈឺត្រចៀកខ្លាំង ។
ខ្ញុំមានការឈឺខ្ទោកៗនៅក្នុងត្រចៀក ។
ខ្ញុំឈឺត្រចៀកស្ទំៗ ។
ខ្ញុំហ៊ឹងត្រចៀក ។
ខ្ញុំស្តាប់មិនសូវលឺទេ ។
ច្រមុះរបស់ខ្ញុំឈឺ ។
ខ្ញុំហៀរសំបោរណាស់ ។
ច្រមុះរបស់ខ្ញុំតឹងជិតអស់ហើយ ។
ខ្ញុំឈាមច្រមុះ ។
ច្រមុះរបស់ខ្ញុំរមាស់ ។
ខ្ញុំផ្តាសាយ ។
ខ្ញុំឈឺបំពង់ក ។
ខ្ញុំក្អកស្លេសច្រើន ។
ខ្ញុំមានបំពង់កឡើងក្រហមគ្រើមៗ ។
ខ្ញុំមានធ្មេញរង្គើរមួយ ។
ធ្មេញខ្ញុំបាត់អាកន្លែងប៉ះ ។
ខ្ញុំបានគ្រេចកពេលខ្ញុំកំពុងគេង ។
ខ្ញុំដកដង្ហើមអត់ស្រួលសោះ ។
ខ្ញុំទទួលរងការឈឺចាប់ពីជំងឺហឺត ។
ខ្ញុំឆ្អល់ចុងដង្ហើម ។
ខ្ញុំមានបញ្ហាបេះដូង ។
ខ្ញុំឈឺទ្រូង ។
ខ្ញុំមានការឈឺចុកចាប់ខ្លាំងនៅក្នុងពោះ ។
ខ្ញុំមានអារម្មណ៍ឈឺស្ទំៗ ។
ខ្ញុំមានបញ្ហាក្រពះ ។
ខ្ញុំមានអារម្មណ៍ចង់ក្អួត ។
ខ្ញុំក្អួតមកចេញឈាម ។
ខ្ញុំមានជំងឺរាគរូស ។
ខ្ញុំទល់លាមក ។
ខ្ញុំទទួលរងជំងឺខ្វះឈាម ។
ខ្ញុំបានបាក់ជើងរបស់ខ្ញុំហើយ ។
ខ្ញុំឈឺឆ្អឹងកន្លាក់ ។
របួសហ្នឹងក្លាយហើយ ។
សូមបំពេញវេជ្ជបញ្ជារបស់ខ្ញុំ ។
តើខ្ញុំអាចទិញថ្នាំក្រពះនៅទីនេះដោយមិនមានវេជ្ជបញ្ជាបានទេ ?
វាគឺជាជើងហោះហើរលេខប្រាំពីរ សូន្យ បី ទៅកាន់តូក្យូ នៅខែកញ្ញា ទីបួន ថ្ងៃសុក្រ ។
ខ្ញុំគឺលោកតាប៊ីអូ អាអូសូរ៉ា ។
បាន លោកអាអូសូរ៉ា ជើងហោះហើររបស់លោកឥឡូវគឺត្រូវបានបញ្ជាក់ហើយ ។
តើអ្នកអាចចុះឈ្មោះផ្ញើវ៉ាលីពីរនេះអោយខ្ញុំបានទេ ?
តើអ្នកអាចចុះឈ្មោះផ្ញើកាបូបពីរនេះអោយខ្ញុំបានទេ ?
តើបញ្ជរចុះឈ្មោះរបស់ក្រុមហ៊ុនអាកាសចរណ៍អេប៊ីស៊ីនៅឯណា ?
អ្នកធ្វើដំណើរចាកចេញតាមរយៈជើងហោះហើររបស់ក្រុមហ៊ុនអាកាសចរណ៍អេប៊ីស៊ី លេខប្រាំពីរ សូន្យ បី ឆ្ពោះទៅតូក្យូ សូមទៅកាន់ច្រកលេខម្ភៃ សំរាប់បែបបទរដ្ឋាភិបាល ។
ខ្ញុំសុខសប្បាយទេ អរគុណ ។
ឈ្មោះរបស់ខ្ញុំគឺចេម ចនសិន ។
តើអ្នកសុខសប្បាយទេ លោកចនសិន ?
រីករាយដែលបានជួបអ្នក លោកចនសិន ។
វាគឺម៉ោងប្រាំ ដប់នាទី ។
បាទ បន្តិចបន្តួច ។
តើខ្ញុំអាចសុំជួយអ្នករកកន្លែងអង្គុយរបស់អ្នកបានទេ ?
ឌី ដប់ពីរគឺលេខកៅអីរបស់ខ្ញុំ ។ តើវានៅឯណា ?
សូមមកតាមផ្លូវនេះ ។
កន្លែងអង្គុយរបស់អ្នកគឺនៅទីនោះ ខាងបង្អួច ។
ខ្ញុំនឹងដាក់វានៅលើប្រដាប់ព្យួរអោយអ្នក ។
សូមដាក់របស់របររបស់អ្នកនៅក្រោមកៅអីរបស់អ្នក ។
កន្លែងអង្គុយរបស់អ្នកគឺនៅទីនោះ ជាប់ច្រកដើរ ។
សូមបង្ហាញខ្ញុំពីរបៀបពាក់វា ។
សូមកុំជក់បារី រហូតដល់សញ្ញាហាមជក់បារីត្រូវបានបិទ ។
សូមពន្លត់បារីរបស់អ្នក ។
តើអ្នកចង់បានកាសែតមួយទេ ?
ខ្ញុំមិនមានអារម្មណ៍ស្រួលខ្លួនទេ ។ សូមអោយថ្នាំខ្ញុំខ្លះមក ។
បាទ លោក ។ ខ្ញុំនឹងទៅយកវាអោយអ្នកឥឡូវ ។
តើអ្នកចង់បានទស្សនាវដ្តីមួយដែរទេ ?
តើអ្នករួចរាល់សំរាប់អាហារសម្រន់ហើយរឺនៅ ?
តើខ្ញុំអាចសុំយកភេសជ្ជៈខ្លះអោយអ្នកបានទេ ?
បាន ។ សូមអោយស្រាម៉ាទីនីស្ងួតមួយ ។
មួយដុល្លារហាសិបសេន លោក ។
វាគឺជារបស់ផ្តល់ជូនដោយការគោរពពីក្រុមហ៊ុនអាកាសចរណ៍ លោក ។
ខ្ញុំមិនឃ្លានទេឥឡូវ ។
តើអ្នកចង់បានទឹកផ្លែឈើខ្លះទេ ?
តើអ្នកបរិភោគអាហារពេលយប់របស់ហើយរឺនៅ ?
បាទ ខ្ញុំបានរីករាយនឹងវាណាស់ ។
យកផ្លែឈើសំរាប់ខ្លួនអ្នក ។
សូមអោយភេសជ្ជៈទឹកខ្ញី ។
តើខ្ញុំអាចបើកភ្លើងដោយរបៀបណា ?
អ្នកចុចកុងតាក់នេះ ។
តើខ្ញុំអាចបិទភ្លើងដោយរបៀបណា ?
សូមយករបស់មានតំលៃទៅជាមួយអ្នក ។
សូមអោយខ្ញុំស្រាវីស្គីមួយដប ។
ឥលូវពួកយើងកំពុងខិតទៅអាកាសយានដ្ឋានអន្តរជាតិហូណូលូលូ ។
ខ្ញុំបានផ្លាស់ប្ដូរជើងហោះហើរ ។
តើជើងហោះហើរណាដែលអ្នកប្ដូរទៅ ?
សូមលិខិតឆ្លងដែនរបស់អ្នក ?
ឈ្មោះរបស់ខ្ញុំគឺយ៉ូស៊ីអូតាណាកា ។
សូមសរសេរជាអក្សរដិត ។
ខ្ញុំនៅទីនេះដើម្បីមើលទេសភាព ។
អរគុណ ។ រីករាយជាមួយការស្នាក់នៅរបស់អ្នក ។
សំរាប់ពីរបីថ្ងៃ ។
ទេវាគឺសំរាប់ការប្រើប្រាស់ផ្ទាល់ខ្លួន ។
នេះគឺកាដូនាឡិកាដៃរឺ ?
នេះគឺកាដូស្រារឺ ?
នេះគឺកាដូទឹកអប់រឺ ?
នេះគឺកាដូគ្រឿងអលង្ការឺ ?
នេះគឺកាដូវិទ្យុត្រង់ស៊ីស្ទ័ររឺ ?
នេះគឺកាដូម៉ាស៊ីនថតសំលេងរឺ ?
នេះគឺកាដូម៉ាស៊ីនថតប្រាំបីមីលីម៉ែតរឺ ?
ខ្ញុំមានបីរយដុល្លារអាមេរិច ។
ខ្ញុំចង់ប្ដូរប្រាក់ខ្លះ ។
សូមប្ដូរសែកអ្នកដំណើរនេះសំរាប់ប្រាក់សុទ្ធ ។
បាទសូមបំពេញបែបបទនេះ ។
សូមអោយប្រាក់រាយខ្លះអោយខ្ញុំ ។
សូមប្ដូរវាជាក្រដាស់ប្រាក់តូច ។
សូមអោយខ្ញុំក្រដាស់ប្រាក់តូចៗខ្លះ ។
សូមអោយខ្ញុំនូវប្រាក់កាក់តូចៗខ្លះ ។
នេះគឺមួយភាគបួន ។
ប្រាក់កាក់បួនបានមួយដុល្លារមែនទេ ?
តើខ្ញុំអាចទៅកាន់សណ្ឋាគារហៀតុនដោយរបៀបណា ?
អ្នកអាចទៅដោយរថយន្តលីមូហ្សីន ។ តាមរបៀបនោះវាថោកជាង ។
តើខ្ញុំអាចទៅកាន់ការិយាល័យព័ត៌មានទេសចរណ៍ដោយរបៀបណា ?
អ្នកអាចទៅទីនោះដោយរថយន្តក្រុងអាកាសយាន ។
តើខ្ញុំអាចទៅកាន់ស្ថានីយ៍អាកាសយានដោយរបៀបណា ?
វាប្រសើរជាងក្នុងការជិះឡានតាក់ស៊ី ។
តើតំលៃតាក់ស៊ីប៉ុន្មានដែរ ?
អ្នកយួរឥវ៉ាន់សូមយកវ៉ាលីនេះទៅកាន់រថយន្តតាក់ស៊ី ។
សូមនាំខ្ញុំទៅកាន់សណ្ឋាគារអេមផាយយើរ ។
យកខ្ញុំទៅកាន់អាសយដ្ឋាននេះ ។
នេះគឺប្រាក់បន្ថែមសំរាប់អ្នក ។
សាយ័នសួស្តីលោក ។ តើខ្ញុំអាចសូមអ្នកបានទេ ?
តើអ្នកឈ្មោះអ្វី ?
តើអ្នកនឹងអាចបំពេញកាតចុះឈ្មោះបានទេ ?
តើតំលៃនៃបន្ទប់គឺប៉ុន្មាន ?
វាគឺមួយរយដុល្លារក្នុងមួយថ្ងៃ ។
តើវាមានបញ្ចូលពន្ធទេ ?
ទេវាមិនបញ្ចូលប្រាក់ពន្ធនិងតំលៃសេវាកម្មទេ ។
បន្ទប់របស់អ្នកគឺលេខដប់ពីរហាសិបជាន់ទីដប់ពីរ ។ អ្នកយួរឥវ៉ាន់នឹងបង្ហាញផ្លូវអ្នក ។
សូមជិះជណ្តើរយន្ត ។
នេះគឺបន្ទប់របស់អ្នកលោក ។
តើខ្ញុំគួរដាក់វ៉ាលីរបស់អ្នកនៅឯណា ?
សូមដាក់នៅលើតុ ។
វាគឺបន្ទប់ដែលមានផាសុកភាពមែនទេ ?
សូមអោយអាជាប់បង្អួច ។
សូមដាក់វានៅក្នុងក្រដាសសាមីពណ៌ត្នោតនេះ ។
នេះជារបស់ខ្លះសំរាប់អ្នក ។
តើមានអ្វីផ្សេងទៀតទេ ?
អរគុណ ។ នេះគឺកូនសោររបស់អ្នក ។ ខ្ញុំសង្ឃឹមថាអ្នកនឹងមានការស្នាក់នៅដោយរីករាយមួយ ។
វ៉ាលីមួយរបស់ខ្ញុំគឺបាត់ ។
តើខ្ញុំអាចទូរស័ព្ទទៅកាន់សេវាកម្មបន្ទប់ដោយរបៀបណា ?
សូមចុចលេខប្រាំបួននៅលើទូរស័ព្ទនេះ ។
តើខ្ញុំធ្វើការហៅទូរស័ព្ទដោយរបៀបណា ?
តើខ្ញុំទូរស័ព្ទទៅកាន់តុព័ត៌មានដោយរបៀបណា ?
សូមចុចលេខមួយដើម្បីទូរស័ព្ទទៅកាន់អ្នកភ្ជាប់ទំនាក់ទំនង ។
សូមភ្ជាប់ខ្ញុំទៅលេខបីពីរប្រាំមួយពីរប្រាំបួនមួយប្រាំបី ។
សូមទុករបស់មានតំលៃរបស់ខ្ញុំនៅក្នុងទូរដែករបស់អ្នក ។
សូមដាស់ខ្ញុំនៅម៉ោងប្រាំមួយព្រឹកស្អែក ។
តើអាហារពេលព្រឹកបំរើនៅម៉ោងប៉ុន្មាន ?
តើខ្ញុំអាចបរិភោគអាហារពេលព្រឹកនៅឯណា ?
សូមយកអាហារពេលព្រឹករបស់ខ្ញុំមកបន្ទប់របស់ខ្ញុំ ។
អរុណសួស្តី ។ តើអ្នកមានតុនៅខាងបង្អួចទេ ?
សូមយកកាហ្វេមួយប៉ាន់មកបន្ទប់របស់ខ្ញុំ ។
តើខ្ញុំអាចកត់ការកុម្ម៉ង់របស់លោកបានទេ ?
បាទ ។ ខ្ញុំនឹងយកទឹកផ្លែឈើប៉េងប៉ោះសាច់ជ្រូកបីជាន់និងស៊ុតនិងនំបុ័ងអាំង ។
តើអ្នកចង់បានស៊ុតរបស់អ្នកយ៉ាងដូចម្តេច ?
តើលោកស្រីចង់បរិភោគធញ្ញជាតិទេ ?
ចា ។ សូមយកធញ្ញជាតិធ្វើពីពោតស្តើងៗអោយខ្ញុំ ។
ស៊ុតចៀនវាយចូលគ្នា ។
ស៊ុតស្ងោរឆ្អិន ។
ស៊ុតស្ងោរភ្នៅ ។
សូមចៀនជាប់ភ្នៅ ។
បាទ ។ សូមយកម្សៅធញ្ញជាតិអោយខ្ញុំ ។
បាទ ។ សូមយកនំដូរណាត់អោយខ្ញុំ ។
តើអ្នកចង់បានតែរឺកាហ្វេ ?
សូមតែជាមួយទឹកដោះគោ ។
ទៅកាន់ណាហ្គូលយ៉ាប្រទេសជប៉ុន ។
សូមចាំមួយភ្លេតលោក ។ ខ្ញុំនឹងទូរស័ព្ទទៅអ្នកភ្ជាប់ទំនាក់ទំនងក្រៅប្រទេសសំរាប់អ្នក ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទពីម្នាក់ទៅម្នាក់ ។
តើមួយណាដែលចង់បានពណ៌ជ្រៅរឺរាក់ ?
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទទៅណាហ្គូយ៉ាលេខប្រាំបីមួយមួយមួយប្រាំបីប្រាំប្រាំ ។
នេះគឺមួយសំរាប់លោក ។
វាគឺឥតគិតថ្លៃ ។ ជំនូននៃសណ្ឋាគារ ។
តើខ្ញុំអាចយកផែនទីនៃឡានក្រុងដើរកំសាន្តនៅឯណា ?
តើខ្ញុំអាចយកកាលវិភាគរថភ្លើងនៅឯណា ?
តើឈ្មោះនិងលេខបន្ទប់របស់អ្នកគឺអ្វី ?
ឈ្មោះរបស់ខ្ញុំគឺកាម៉ីហើយលេខបន្ទប់របស់ខ្ញុំគឺដប់ពីរហាសិបប្រាំ ។
តើម៉ោងប៉ុន្មានដែលអ្នកចង់ចាកចេញ ?
ប្រហែលម៉ោងដប់ ។
ខ្ញុំសង្ឃឹមថានឹងអ្នកនឹងត្រលប់មកម្តងទៀត ។
តើវាមានតំលៃប៉ុន្មាន ?
វិក័យប័ត្ររបស់អ្នកគឺមួយរយហាសិបដុល្លារនិងសែសិប្រាំសេន ។
តើអ្នកទទួលសែកអ្នកទេសចរណ៍ទេ ?
តើអ្នកនឹងទូរស័ព្ទទៅឡានឈ្នួលសំរាប់ខ្ញុំបានទេ ?
ខ្ញុំត្រូវទៅដល់អាកាសយាននៅម៉ោងប្រាំបួនសាមសិបនាទី ។
ខ្ញុំចង់អោយត្រួតពិនិត្យកាបូបរបស់ខ្ញុំហើយដាក់វានៅបន្ទប់ដាក់ឥវ៉ាន់រហូតដល់ម៉ោងបី ។
តើអ្នកអាចរង់ចាំមួយភ្លេតបានទេ ? ឥលូវនេះពួកយើងពេញហើយ ។
ខ្ញុំសូមទោសដែលអោយអ្នករង់ចាំ ។ ឥលូវពួកយើងមានតុសំរាប់អ្នកហើយ ។ សូមមកតាមផ្លូវនេះ ។
តើបញ្ជីមុខម្ហូបថ្ងៃនេះគឺអ្វី ?
ថ្ងៃនេះពួកយើងមានត្រីទឹកសាបល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានត្រីទឹកសមុទ្រថូណាល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានត្រីទឹកសមុទ្រសាឌីនល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានបង្កងសមុទ្រល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានកំពឹសល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានបង្កងល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានងាវសមុទ្រល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានលាសសមុទ្រល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានក្តាមល្អខ្លាំងខ្លះ ។
ថ្ងៃនេះពួកយើងមានខ្យងសមុទ្រល្អខ្លាំងខ្លះ ។
សូមអោយខ្ញុំស្រាបាត់វ៉េយសើរមួយដប ។
បាទខ្ញុំនឹងបរិភោគស្រាម៉ាទីនីជាមួយគ្រឿងក្លែម ។
សូមអោយស៊ុបថ្លាសាច់សុទ្ធ ។
បាទខ្ញុំនឹងបរិភោគស្រាធុងជាមួយគ្រឿងក្លែម ។
បាទខ្ញុំនឹងបរិភោគស្រាវីស្គីនិងសូដាជាមួយគ្រឿងក្លែម ។
បាទខ្ញុំនឹងបរិភោគស្រាកាឡុកជាមួយគ្រឿងក្លែម ។
បាទខ្ញុំនឹងបរិភោគស្រាសំប៉ាញជាមួយគ្រឿងក្លែម ។
បាទខ្ញុំនឹងបរិភោគស្រាថ្នាំជាមួយគ្រឿងក្លែម ។
បាទខ្ញុំនឹងបរិភោគស្រាអេស្បាញជាមួយគ្រឿងក្លែម ។
តើអ្នកចង់បានបង្អែមទេ ?
ខ្ញុំនឹងសាកការ៉េមខ្លះ ។
សូមតែកាហ្វេទេ ។
ពួកយើងមានស្រាក្រហមដ៏ល្អបំផុត ។
ពួកយើងមានស្រាសដ៏ល្អបំផុត ។
ពួកយើងមានស្រាពណ៌កុលាប ។
ខ្ញុំនឹងសាកបង្អែមសង់ខ្យាខ្លះ ។
ខ្ញុំនឹងសាកទឹកផ្លែឈើខ្លះ ។
ខ្ញុំនឹងសាកផ្លែឈើខ្លះ ។
តើវានឹងរួចរាលឆាប់នេះទេ ?
ខ្ញុំមិនមានពេលវេលាច្រើនទេ ។ តើអ្នកអាចប្រញ៉ាប់ធ្វើនូវការកម៉្មង់របស់ខ្ញុំបានទេ ?
សូមបរិភោគជាមួយទឹកជ្រលក់នេះ ។
តើអ្នកចូលចិត្តវាទេ ?
បាទខ្ញុំចូលចិត្តវាខ្លាំងណាស់ ។ អរគុណ ។
ខ្ញុំមិនទាន់រួចរាល់ទេ ។
សូមបំបែកប្រាក់នេះ ។
សូមនំបុ័ងហេមប៊ឺហ្គឺនិងសាឡាត ។
សូមសាច់មាន់ដុត ។
ដំឡូងបារាំងទន់ៗនិងស្ពៃក្តោបជ្រក់ ។
តើខ្ញុំអាចសូមមានមួយនោះបានទេ ?
សូមសំបុត្រយន្តហោះត្រលប់ទៅមកទៅកាន់វ៉េនណាយចំនួនពីរ ។
សូមអភ័យទោសប៉ុន្តែតើសំបុត្រនៅមាត់បង្អួតនៅឯណា ?
សូមអភ័យទោសប៉ុន្តែតើអ្នកលក់សំបុត្រស័្វយប្រវត្តិនៅឯណា ?
សូមសំបុត្រលំដាប់ថ្នាក់លេខមួយទៅកាន់វ៉េនណាយចំនួនពីរ ។
សូមសំបុត្រលំដាប់ថ្នាក់លេខពីរទៅកាន់វ៉េនណាយចំនួនពីរ ។
សូមសំបុត្រទៅវ៉េនណាយចំនួនពីរ ។
តើរថភ្លើងនេះមានកន្លែងគេងទេ ?
ផ្លូវលេខប្រាំ ។
ខ្ញុំចង់កក់កៅអីខ្លះនៅលើរថភ្លើងនេះ ។
តើរថភ្លើងនេះមានកន្លែងបរិភោគទេ ?
តើរថភ្លើងនេះមានកន្លែងលក់អាហារទេ ?
តើម៉ោងប៉ុន្មានដែលវាទៅដល់មីលានោ ?
សូមអោយខ្ញុំដឹងនៅពេលដែលពួកយើងទៅដល់ម៉ូនីច ។
កៅអីនេះត្រូវបានគេប្រើហើយ ។
តើខ្ញុំប្ដូររថភ្លើងនៅឯណា ?
សូមអភ័យទោសប៉ុន្តែតើរថយន្តក្រុងសំរាប់អាកាសយានចាកចេញនៅឯណា ?
ទៅពីរអាគារហើយបត់ឆ្វេង ។
តើឡាននេះទៅសារមន្ទីរអង់គ្លេសមែនទេ ?
តើឡានក្រុងនេះឈប់នៅសួនសត្វទេ ?
តើឡានក្រុងណាទៅស្ថានីយ៍កណ្តាល ?
នៅផ្លូវទីចិតសិបពីរ ។
ខ្ញុំខ្លាចក្រែងតែខ្ញុំជិះឡានក្រុងខុស ។
មេត្រូភូលីថេនអូផារ៉ាហាវ ។
ចុះនៅចំណតមួយទៀតហើយជិះលេខហុកសិបប្រាំបី ។
នៅចំណតលេខបួន ។
តើខ្ញុំប្ដូររថភ្លើងទៅកាន់សួនសត្វនៅឯណា ?
តើខ្ញុំប្ដូរឡានទៅកាន់សួនសត្វនៅឯណា ?
ប្រហែលដប់នាទី ។
រៀងរាល់ម្ភៃនាទី ។
ច្រើនជាងដប់នាទី ។
តិចជាងដប់នាទី ។
ខ្ញុំបានទុកកាបូបរបស់ខ្ញុំនៅលើរថភ្លើង ។
តើផ្លូវមួយណាសំរាប់ចេញទៅការិយាល័យប៉ុស្តិ៍កណ្តាល ?
ទៅផ្លូវចេញនោះនៅខាងឆ្វេង ។
សូមអភ័យទោសប៉ុន្តែតើមានចំណតប៉ុន្មានទៅកាន់ផ្លូវទីហុកសិបប្រាំបី ?
វាគឺនៅចំណតទីបីពីទីនេះ ។
តើអ្នកអាចដឹកខ្ញុំទៅអាកាសយានខេននីឌីបានទេ ?
តើអ្នកនឹងអាចជួយខ្ញុំជាមួយវ៉ាលីទាំងនេះបានទេ ?
ប្រាកដ ។ ខ្ញុំនឹងដាក់ពួកវានៅបាំងឡានខាងក្រោយ ។
ប្រហែលសាមសិបនាទីខ្ញុំស្មាន ។
សូមឈប់នៅទីនេះ ។ ខ្ញុំចង់ថតរូបខ្លះ ។
តើអ្នកអាចរង់ចាំនៅទីនេះមួយនាទីបានទេ ?
ខ្ញុំនឹងត្រលប់មកវិញរយះពេលប្រាំនាទី ។
តើអ្នកអាចរង់ចាំនៅទីនេះមួយភ្លេតបានទេ ?
ម្ភៃដុល្លារនិងដប់សេន ។
នេះគឺប្រាក់ម្ភៃមួយដុល្លារ ។ សូមរក្សាការប្ដូរ ។
តើខ្ញុំត្រូវបង់ប្រាក់បន្ថែមសំរាប់វ៉ាលីនេះទេ ?
តើឡានតាក់ស៊ីនេះទំនេរទេ ?
បត់ឆ្វេងនៅកាច់ជ្រុងនោះ ។
ប្រាកដណាស់ ។ តូចល្មមរឺធម្មតា ?
តើខ្ញុំអាចសូមមើលប័ណ្ណបើកបររបស់អ្នកបានទេ ?
អរគុណ ។ សូមបំពេញបែបបទទាំងនេះ ។
សូមស្រួលក្នុងការដោះស្រាយ ។
តើខ្ញុំអាចសូមមើលប័ណ្ណបើកបរអន្តរជាតិរបស់អ្នកបានទេ ?
សូមបំពេញកិច្ចសន្យាទាំងនេះ ។
តើអ្នកចង់ប្រើវានៅពេលណា ?
នៅម៉ោងប្រាំបួនព្រឹកស្អែក ។
សែសិបដុល្លារក្នុងមួយថ្ងៃ ។
សែសិបដុល្លារក្នុងមួយសប្ដាហ៍ ។
បាន ។ សាំងធម្មតារឺគុណភាពខ្ពស់ ?
ធម្មតា ។ ហើយតើអ្នកនឹងត្រួតពិនិត្យសំពាធកង់ផងបានទេ ?
សូមទៅតាមផ្លូវនេះរយះបីម៉ាយហើយអ្នកនឹងមើលឃើញសញ្ញាមួយ ។
សូមអភ័យទោសលោកភ្នាក់ងារ ?
បាទ ។ តើខ្ញុំអាចជួយអ្នកបាន ?
តើអ្នកនឹងប្រាប់ខ្ញុំផ្លូវទៅកាន់ស្ថានីយ៍កណ្តាលបានទេ ?
បាន ។ បត់ឆ្វេងនៅកាច់ជ្រុងមួយទៀត ។ ហើយអ្នកនឹងឃើញវានៅខាងមុខ ។
អ្នកនឹងឃើញវានៅខាងស្តាំដៃរបស់អ្នក ។
អ្នកនឹងឃើញវានៅខាងឆ្វេងដៃរបស់អ្នក ។
ប្រាកដណាស់ ។ តើអ្នកចង់ទៅឯណា ?
ដើរទៅត្រង់តាមផ្លូវនេះប្រហែលកន្លះម៉ាយ ។ អ្នកនឹងមកដល់សួន ។
តើខ្ញុំអាចទៅកាន់សួនសត្វដោយរបៀបណា ?
ចុះចំណោត ។ អ្នកនឹងទៅដល់ផ្លូវបំបែក ។ បន្ទាប់មកទៅខាងឆ្វេង ។
ប្រហែលដប់ប្រាំនាទី ។
តើខ្ញុំអាចទៅកាន់សារមន្ទីរសិល្បះដោយរបៀបណា ?
តើខ្ញុំអាចទៅកាន់វិចិត្រសាលដោយរបៀបណា ?
តើខ្ញុំអាចទៅកាន់ប្រាសាទដោយរបៀបណា ?
តើខ្ញុំអាចទៅកាន់ប៉មដោយរបៀបណា ?
តើខ្ញុំអាចទៅកាន់ព្រះបរមរាជវាំងដោយរបៀបណា ?
អ្នកអាចប៉ុន្តែវាប្រសើរជាងក្នុងការទៅដោយឡានក្រុង ។ ចំណតឡានក្រុងគឺនៅផ្លូវម្ខាងទៀត ។
តើអ្នកនឹងគូសផែនទីសំរាប់ខ្ញុំបានទេ ?
សូមចង្អុលកន្លែងដែលពួកយើងនៅលើផែនទី ។
សូមអភ័យទោសប៉ុន្តែតើផ្លូវអ្វីដែលពួកយើងនៅឥលូវនេះ ?
ពួកយើងនៅលើផ្លូវទីសែសិបប្រាំបី ។
បាទ ? តើខ្ញុំអាចជួយអ្វីអ្នកបាន ?
តើខ្ញុំនៅផ្លូវត្រូវទៅកាន់សាលាក្រុងទេ ?
បាទអ្នកត្រូវហើយ ។ ដើរទៅត្រង់ ។
សូមអភ័យទោសប៉ុន្តែតើខ្ញុំនៅលើរថភ្លើងត្រូវទៅកាន់សួនសត្វទេ ?
ទេ ។ ខ្ញុំខ្លាចក្រែងអ្នកជិះរថភ្លើងខុស ។
សូមអភ័យទោស ។ តើមានហាងទំនិញនៅក្បែរទីនេះទេ ?
បាទ ។ ទៅពីរអាគារហើយអ្នកនឹងរកឃើញមួយ ។
សូមអភ័យទោសប៉ុន្តែតើអ្នកអាចប្រាប់ផ្លូវខ្ញុំទៅកាន់ស្ថានីយ៍បានទេ ?
ខ្ញុំសូមទោស ។ ខ្ញុំគឺជាអ្នកក្រៅតំបន់នេះដែរ ។
តើការិយាល័យព័ត៌មាននៅឯណា ?
តើមានស្ពាននៅក្បែរនេះទេ ?
សូមអភ័យទោសប៉ុន្តែតើអ្នកអាចប្រាប់ផ្លូវខ្ញុំទៅកាន់ស្ថានីយ៍ប៉ូលីសបានទេ ?
សូមអភ័យទោស ។ តើខ្ញុំអាចរកឃើញទីភ្នាក់ងារទេសចរណ៍នៅឯណា ?
វានៅជាន់ទីប្រាំពីរ ។ ជិះជណ្តើរយន្តនៅខាងចុងសាល ។
បាទខ្ញុំចង់ដើរមើលទេសភាពនៃទីក្រុង ។
តើរយះពេលប៉ុន្មានដែលអ្នកអាចចំណាយ ?
ខ្ញុំអាចចំណាយពេលថ្ងៃត្រង់ទាំងមូល ។
បាទមានការធ្វើដំណើរច្រើន ។
បាទខ្ញុំចង់ដើរមើលទេសភាពនៃកន្លែងល្បីៗ ។
បាទខ្ញុំចង់ដើរមើលទេសភាពនៃកន្លែងទាក់ទងនឹងប្រវត្តិសាស្ត្រ ។
អ្នកអាចមើលវិមានរដ្ឋសភាសេតវិមាន ។ ល ។
តើអ្វីដែលខ្ញុំអាចមើលនៅដំណើរកំសាន្តពេលព្រឹក ?
បាទហើយវាត្រូវបានផ្តល់នៅក្នុងភាសាបារាំងអាល្លឺម៉ង់អេស៉្បាញនិងជប៉ុនផងដែរ ។
តើដំណើរកំសាន្តប្រើរយះពេលប៉ុន្មាន ?
ប្រហែលបួនម៉ោង ។
ម្ភៃដុល្លារមុន ។
តើផ្លូវនេះរួមបញ្ចូលអាហារទេ ?
តើខ្ញុំអាចចូលរួមដំណើរកំសាន្តនៅសណ្ឋាគារស៊ីទេ ?
បាទឡានក្រុងនឹងទៅដល់សណ្ឋាគារប្រហែលម៉ោងដប់ដប់ប្រាំនាទី ។
ពួកយើងនឹងត្រលប់ទៅវិញនៅម៉ោងបួនសាមសិបនាទី ។
តើពួកយើងមានពេលមើលវិចិត្រសាលខាងក្នុងទេ ?
បាទអ្នកនឹងមានរយះពេលមួយម៉ោងដើម្បីមើលវា ។
ឥលូវអ្នកអាចចេញពីឡានក្រុងហើយមានពេលទំនេរសាមសិបនាទី ។
តើម៉ោងប៉ុន្មានដែលពួកយើងគួរត្រលប់មកវិញ ?
ខ្ញុំចង់ជួលអ្នកមគ្គទេសក៍ដែលនិយាយភាសាអង់គ្លេស ។
ល្អណាស់លោក ។ សូមបំពេញបែបបទនេះ ។
ហាសិបដុល្លារ ។
តើពួកយើងនឹងមើលអ្វីនៅថ្ងៃនេះ ?
ខ្ញុំចង់ជួលអ្នកមគ្គទេសក៍ដែលនិយាយភាសាជប៉ុន ។
វ៉េសមីនស្ទ័រអេបបី ។
បាទវាគឺបើកសំរាប់សាធារណះ ។
តើអាគារនេះមានកំពស់ប៉ុន្មាន ?
តើនេះគឺរូបសំណាក់នរណា ?
តើខ្ញុំអាចមានកៅអីជាន់ទីពីរសំរាប់ល្ងាចនេះបានទេ ?
សូមទោសកៅអីនៅជាន់ទីពីរទាំងអស់ត្រូវបានទិញអស់ហើយ ។
តើខ្ញុំអាចមានកៅអីជាន់ក្រោមពីរសំរាប់ល្ងាចនេះទេ ?
តើខ្ញុំអាចសុំកន្លែងអង្គុយពីរនៅរានហាល សំរាប់ល្ងាចនេះបានទេ ?
តើខ្ញុំអាចសុំកន្លែងអង្គុយនៅផ្នែកខាងក្រោយសំរាប់ល្ងាចនេះបានទេ ?
ខ្ញុំចង់បានកន្លែងអង្គុយពិសេសពីរ ។
តើអ្នកអាចបង្ហាញពួកយើងទៅកាន់កន្លែងអង្គុយរបស់ពួកយើងបានទេ ?
ប្រាកដណាស់ ។ សូមមកតាមផ្លូវនេះ ។ ទីបីនិងទីបួននៃជួរនេះ ។
តើគេចាប់ផ្តើមនៅពេលណា ?
នៅម៉ោងប្រាំពីរ ។ វានឹងចប់នៅម៉ោងដប់ ។
តើមានចន្លោះពេលប៉ុន្មានរវាងការសំដែងទីមួយនិងទីពីរ ?
ពេលសំរាកគឺសាមសិបនាទី ។
តើតួឯកក្នុងរឿងនេះជានរណាដែរ ?
តើមានការសំដែងអ្វីដែរនៅឯរោងមហោស្រពផី នៅល្ងាចនេះ ?
តើមានការសំដែងអ្វីនៅពេលនេះ ?
មហោរីបែបជនបទរបស់ប៊ីសូវេន និងការប្រគំតន្ត្រីម៉ូសាត ។
តើអ្នកគាប់ចិត្តនឹងតន្ត្រីយ៉ាងម៉េចដែរ ?
តើការតាំងពិព័រណ៍សំខាន់នៅវិចិត្រសាលនេះមានអ្វីខ្លះ ?
វាមានការប្រមូលផ្តុំល្អៗនូវគំនូរទេសភាព ។
វាមានការប្រមូលផ្តុំល្អៗនូវគំនូរគូរដោយប្រេង ។
វាមានការប្រមូលផ្តុំល្អៗនូវគំនូរគូរដោយគូរល័រទឹក ។
វាមានការប្រមូលផ្តុំល្អៗនូវគំនូរពាក់កណ្តាលខ្លួនមនុស្ស ។
វាមានការប្រមូលផ្តុំល្អៗនូវរូបចម្លាក់ ។
វាមានការប្រមូលផ្តុំល្អៗនូវស្នាដៃដែលធ្វើពីសំរិទ្ធ ។
វាមានការប្រមូលផ្តុំល្អៗនូវស្នាដៃដែលធ្វើពីថ្មម៉ាប ។
វាមានការប្រមូលផ្តុំល្អៗនូវសិល្បះនៃស្ថាបត្យកម្ម ។
ប្រាកដណាស់លោក ។ តើម៉ោងប៉ុន្មានដែលលោកចង់ទៅ ?
ខ្ញុំចង់បានការហោះហើរនៅពេលថ្ងៃត្រង់ ។
ខ្ញុំបានធ្វើការកក់មួយនៅតូក្យូ ។
ខ្ញុំចង់កក់នៅខែសីហា ថ្ងៃទីដប់ប្រាំ សំរាប់ជើងហោះហើររបស់ក្រុមហ៊ុនអាកាសចរណ៍ស្វីសអ៊ែ មានលេខមួយ សូន្យ សូន្យ ។
ពួកយើងមានជើងហោះហើររបស់ក្រុមហ៊ុនអាកាសចរណ៍លូថានសា លេខពីរ បួន ប្រាំ នៅម៉ោងបួនសែសិបនាទីល្ងាច ។
តើម៉ោងប៉ុន្មានវាទៅដល់ទីក្រុងឡុង ?
នៅម៉ោងប្រាំបី ដប់ប្រាំពីរនាទីម៉ោងនៅទីក្រុងឡុង ។
ខ្ញុំចង់កក់កន្លែងអង្គុយមួយ សំរាប់ជើងហោះហើរភីអេអេ លេខប្រាំ សូន្យ ប្រាំ នៅម៉ោងប្រាំពីរ សែសិបប្រាំនាទី ។
ខ្ញុំខ្លាចក្រែងកន្លែងអង្គុយទាំងអស់ត្រូវបានកក់អស់ហើយ ។
តើអាមួយបន្ទាប់ចាកចេញទៅកាន់តូក្យូនៅពេលណា ?
សូមដាក់ខ្ញុំនៅក្នុងបញ្ជីរង់ចាំ ។
សូមកាហ្វេមួយប៉ាន់ ។
សូមកាហ្វេមួយកែវ ។
សូមការ៉េមទឹកកក ។
សូមការ៉េមសាន់ដេ ។
សូមនំធ្វើពីផ្លែប៉ោម ។
តើខ្ញុំអាចសុំឈើគូសមួយបានទេ ?
សូមបង្អែមសង់ខ្យា ។
សូមនំខេកខ្លីៗ ។
តើខ្ញុំអាចមានចានគោះបារីទេ ?
សូមទឹកផ្លែម្នាស់បីកែវ ។
សូមទឹកផ្លែទំពាំងបាយជូបីកែវ ។
សូមទឹកផ្លែភីជបីកែវ ។
សូមទឹកផ្លែព័របីកែវ ។
សូមទឹកផ្លែក្រូចឆ្មារលឿងបីកែវ ។
នៅម៉ោងប្រាំបួន ម្ភៃនាទី ។
បាន ។ សូមកក់កន្លែងអង្គុយលំដាប់លេខមួយ សំរាប់ជើងហោះហើរនោះ ។
ខ្ញុំចង់ធ្វើការបញ្ជាក់ពីជើងយន្តហោះរបស់ខ្ញុំម្តងទៀត ។
សូមឈ្មោះនិងលេខជើងហោះហើររបស់អ្នក ។
ឈ្មោះរបស់ខ្ញុំគឺសាតូ ។ លេខជើងហោះហើររបស់ខ្ញុំគឺ អេសអេអេស ប្រាំមួយ បួន ប្រាំបួន ។ កាលបរិច្ឆេទគឺខែមេសា ថ្ងៃទីបី ។ ពីកូផេនហាហ្គេនទៅហេមបឺក ។ កៅអីថ្នាក់សន្សំសំចៃ ។
កន្លែងអង្គុយរបស់អ្នកត្រូវបានកក់ ។
ខ្ញុំចង់ប្ដូរការកក់របស់ខ្ញុំ ។ តើខ្ញុំអាចប្ដូរជើងហោះហើរ ភីអេអេ ប្រាំ សូន្យ ប្រាំ ទៅជើងហោះហើរ ប្រាំ មួយ ប្រាំ បានទេ ?
សូមអង្គុយនៅខាងក្រោយ ។
សូមអោយខ្ញុំនូវកន្លែងអង្គុយនៅជាប់ផ្លូវដើរនៅខាងក្រោយ ។
តើបញ្ជរចុះឈ្មោះឡើងជិះរបស់ក្រុមហ៊ុនអាកាសចរណ៍លូថានសានៅឯណា ?
ទៅត្រង់អោយដល់ចុងរោងមហោស្រព បត់ស្តាំ ហើយដើរទៅប្រហែលមួយរយម៉ែត្រ ។
តើខ្ញុំអាចសូមចុះឈ្មោះសំរាប់ជើងហោះហើរ ជេអេអ៊ែល លេខបួន សូន្យ ពីរ សំរាប់ទៅទីកុ្រងឡុងបានទេ ?
ប្រាកដណាស់ ។ តើខ្ញុំអាចសូមមើលសំបុត្ររបស់អ្នកបានទេ ?
តើជើងហោះហើរ ជេអេអ៊ែល លេខបួន សូន្យ ពីរ ចាកចេញតាមកាលវិភាគដែរទេ ?
វាត្រូវបានពន្យាពេលប្រហែលមួយម៉ោង ។ វានឹងចាកចេញនៅម៉ោងប្រាំ ដប់នាទីល្ងាច ។
តើអ្នកមានវ៉ាលីទេ ?
ខ្ញុំចង់ចុះឈ្មោះផ្ញើវ៉ាលីទាំងនេះ ។
នឹងមានការពន្យាពេលបន្តិច ។
ម៉ោងចាកចេញនឹងត្រូវបានប្រកាស ។
ខ្ញុំនឹងយករបស់នេះទៅជាមួយខ្ញុំចូលក្នុងយន្តហោះ ។
អោយខ្ញុំថ្លឹងពួកវា ។ នេះគឺស្លាកសំរាប់យកអីវ៉ាន់វិញរបស់អ្នក ។ សូមទៅកាន់ច្រកលេខសាមសិបប្រាំ ត្រឹមម៉ោងបី សាមសិបនាទី ។
វ៉ាលីរបស់អ្នកគឺលើសប្រាំគីឡូក្រាម ។
តើតំលៃប៉ុន្មានសំរាប់វ៉ាលីដែលលើសគីឡូ ?
មួយរយម្ភៃដុល្លារ ។
ច្រកលេខសាមសិបប្រាំ ។
តើផ្លូវណាទៅច្រកលេខសាមសិបប្រាំ ?
ទៅជាន់លើហើយបត់ស្តាំ ។ វាគឺនៅខាងឆ្វេងដៃរបស់អ្នក ។
សូមយកចិត្តទុកដាក់ ។ ជើងហោះហើររបស់ក្រុមហ៊ុនអាកាសចរណ៍លូថានសា លេខពីរ បួន ប្រាំ នឹងចាកចេញនៅពេលឆាប់ៗនេះ ទៅកាន់ទីក្រុងឡុង ។ អ្នកដំណើរនៅក្នុងជើងហោះហើរនេះត្រូវបានស្នើរអោយឆ្លងកាត់គយ កន្លែងដាច់ពីគេ និងអន្តោប្រវេសន៍ ហើយឆ្ពោះទៅកាន់ច្រកលេខសាមសិបប្រាំ ។
បាទ ។ តើអ្នកអាចធ្វើការកក់សណ្ឋាគារសំរាប់ខ្ញុំបានទេ ?
ខ្ញុំចង់បានបន្ទប់មួយនៅប៉ារីស សំរាប់ពីរយប់ ចាប់ផ្តើមពីថ្ងៃខាងស្អែក ។
ខែឧសភា ថ្ងៃទីដប់ប្រាំ និងដប់ប្រាំមួយ ?
សណ្ឋាគារផាកសាយ ។
សួស្តី សូមភ្ជាប់ខ្ញុំទៅកាន់ការិយាល័យកក់ ។
សុំពេលមួយភ្លេត ។
អរុណសួស្តី ។ តើខ្ញុំអាចជួយអ្នកបានទេ ?
បាទ ។ ខ្ញុំចង់កក់បន្ទប់មួយ ។
តើអ្នកចង់ស្នាក់នៅយូរប៉ុណ្ណា ?
ល្អណាស់ លោកស្រី ។ តើអ្នកចង់ស្នាក់នៅពេលណា ?
នៅយប់ថ្ងៃពុធ ។
បន្ទប់គ្រែមួយហើយមានបន្ទប់ទឹក ។
បានលោកស្រី ។ តើខ្ញុំអាចសូមឈ្មោះរបស់អ្នកបានទេ ?
បន្ទប់ស្ងាត់មួយ ។
តើអ្នកមានបន្ទប់គ្រែមួយសំរាប់យប់នេះទេ ?
ខ្ញុំសុំទោស លោក ប៉ុន្តែពួកយើងត្រូវបានកក់ពេញហើយ ។
តើអ្នកអាចណែនាំសណ្ឋាគារផ្សេងទៀតទេ ?
អ្នកអាចសាកសណ្ឋាគារហេឆរឺសណ្ឋាគារស៊ី ។
តើមានតំលៃប៉ុន្មានសំរាប់បន្ទប់នោះ ?
មួយរយដុល្លារសំរាប់មួយយប់បូកពន្ធនិងតំលៃសេវាកម្ម ។
វានៅចន្លោះរវាងហុកសិបប្រាំនិងមួយរយហាសិបដុល្លារលោក ។
ខ្ញុំនឹងយកបន្ទប់មួយតំលៃហុកសិបប្រាំដុល្លារ ។
តើតំលៃសេវាកម្មរួមបញ្ចូលទេ ?
ឈ្មោះរបស់ខ្ញុំគឺតាណាកា ។ ខ្ញុំទើបតែមកដល់អាកាសយានអេច ។ ខ្ញុំចង់បញ្ជាក់ការកក់ ។
ខ្ញុំនឹងចួលទៅប្រហែលម៉ោងប្រាំបួនពីព្រោះតែការពន្យាពេលរបស់យន្តហោះ ។
ខ្ញុំបានធ្វើការកក់សំរាប់យប់នេះ ។
បាទ ។ សូមបង្ហាញខ្ញុំនូវអាវខ្លះ ។
ខ្ញុំចង់បានវត្ថុអនុស្សាវរីយ៍សំរាប់កូនប្រុសរបស់ខ្ញុំ ។
ទេអរគុណ ។ ខ្ញុំគ្រាន់តែដើរមើលទេ ។
តើហាងបើកម៉ោងប៉ុន្មាន ?
ខ្ញុំនឹងសួរអ្នកក្រោយពីខ្ញុំដើរមើលហើយ ។
តើហាងបិទម៉ោងប៉ុន្មាន ?
មិនសូវជាល្អទេ ។
ខ្ញុំសូមទោសវាគឺជាអ្វីដែលពួកយើងមាន ។
បង្ហាញខ្ញុំនូវមួយផ្សេងទៀត ។
ខ្ញុំនឹងណែនាំមួយនេះ ។
ខ្ញុំមិនអាចមានលទ្ធភាពបង់វានោះទេ ។
តើអ្នកអាចបញ្ចុះតំលៃទេប្រសិនបើខ្ញុំទិញបី ?
បានខ្ញុំនឹងអោយអ្នកនូវការបញ្ចុះតំលៃដប់ភាគរយ ។
ហាសិបបីដុល្លារ ។ ប្រាក់សុទ្ធរឺកាតឥណទាន ?
នេះគឺប្រាក់រាយ ។ ពីរដុល្លារ ។
ខ្ញុំសូមទោសពួកយើងមានតែតំលៃមួយប៉ុណ្ណោះ ។
តើអ្នកអាចបញ្ចុះវាអោយថោកបន្តិចទេ ?
អញ្ចឹងខ្ញុំនឹងបញ្ចុះត្រឹមសែសិបដុល្លារ ។
តើមាននរណាម្នាក់ក្នុងចំណោមអ្នកនិយាយភាសាអង់គ្លេសទេ ?
តើមាននរណាម្នាក់ក្នុងចំណោមអ្នកនិយាយភាសាជប៉ុនទេ ?
សាយ័នសួស្តីលោក ។ តើខ្ញុំអាចជួយអ្វីអ្នក ?
តើខ្ញុំអាចទិញសំលៀកបំពាក់របស់បុរសនៅឯណា ?
ពួកគេនៅជាន់ទីពីរ ។
តើហាងលក់សំភារះការិយាល័យនៅជាន់ទីប៉ុន្មាន ?
នៅជាន់ទីប្រាំ ។ សូមជិះជណ្តើរយន្តនៅខាងឆ្វេងដៃរបស់អ្នក ។
តើជាន់ទីបីនៅឯណា ?
ពួកគេនៅជាន់ផ្ទាល់ដី ។
តើហាងលក់សំភារះអគ្គិសនីនៅជាន់ទីប៉ុន្មាន ?
តើហាងលក់សំភារះផ្ទះបាយនៅជាន់ទីប៉ុន្មាន ?
អរគុណលោកស្រី ។ សូមយកវិក័យប័ត្រទៅកាន់អ្នកគិតប្រាក់ហើយបង់ប្រាក់នៅទីនោះ ។
សូមផ្ញើរវាទៅកាន់ប្រទេសជប៉ុន ។
សូមលាងហើយផ្តិតហ្វីលទាំងនេះ ។
តើទំហំអ្វីដែលអ្នកចង់បាន ?
សូមពង្រីកវាពីរដងនឹងទំហំវា ។
សូមធ្វើការចំលងបី ។
ខ្ញុំចង់បានពួកវាកាន់តែឆាប់កាន់តែល្អ ។
ថ្ងៃខានស្អែក ។
សូមដាក់ការសំដែងនៃរឿងនៅក្នុងម៉ាស៊ីនថតនេះ ។
ប្រភេទអ្វីលោក ?
សូមយកអាសាមសិបប្រាំមួយអ៊ិចផូសឺនៃសាមសិបប្រាំមីលីម៉ែត្រកូល័រនេង៉ាធីវ ។
សូមត្រួតពិនិត្យមើលម៉ាស៊ីនថតរបស់ខ្ញុំ ។
វាមានបញ្ហានឹងសន្ទះបើកអោយពន្លឺចូល ។
តើវាមានតំលៃប៉ុន្មានសំរាប់ការចំលងលើស ?
អាវពណ៌ខៀវរឺពណ៌ត្នោតខ្ចី ។
តើខ្ញុំអាចយកទំហំរបស់អ្នកបានទេ ?
ខ្ញុំចង់បានអាវធំមួយ ។
ខ្ញុំចង់បានប្លូបឺរីខ្លះ ។
ខ្ញុំចង់បានអាវភ្លៀងមួយ ។
ខ្ញុំចង់បានខោខ្លះ ។
ខ្ញុំចង់បានខោជើងវែងខ្លះ ។
ខ្ញុំចង់បានអាវកាក់មួយ ។
ខ្ញុំចង់បានសំលៀកបំពាក់ក្នុង ។
ខ្ញុំចង់បានសំលៀកបំពាក់កីឡា ។
តើអ្នកចង់បានរបស់នេះទេ ?
វាមិនមែនជាអ្វីដែលខ្ញុំចង់បានប្រាកដទេ ។
បាទវាប្រសើរជាង ។
សូមអោយខ្ញុំមើលក្រវ៉ាត់ករបស់អ្នក ។
តើនេះមានតំលៃប៉ុន្មាន ?
នេះគឺរបស់រាងថោកបន្តិច ។ ខ្ញុំគិតថាវាក្លាយជារបស់អ្នក ។
តើខ្ញុំអាចជួយអ្នកអ្វីបានលោកស្រី ?
ចា ។ ខ្ញុំកំពុងរកមើលរ៉ូបមួយ ។
តើអ្នកចង់បានរបស់ដែលធ្វើសំរាប់កុម្ម៉ង់ ?
ទេខ្ញុំចង់បានរបស់មួយដែលធ្វើស្រាប់ ។
វាសមនឹងសំលៀកបំពាក់កំផ្លេរបស់អ្នក ។
ចា ។ ខ្ញុំកំពុងរកមើលអាវស្រីមួយ ។
បាទ ។ ខ្ញុំកំពុងរកមើលសំពត់មួយ ។
បាទ ។ ខ្ញុំកំពុងរកមើលអាវក្រៅមួយ ។
បាទ ។ ខ្ញុំកំពុងរកមើលអាវធំមួយ ។
បាទ ។ ខ្ញុំកំពុងរកមើលខោជើងប៉ាត់ ។
បាទ ។ ខ្ញុំកំពុងរកមើលស្រោមជើង ។
បាទ ។ ខ្ញុំកំពុងរកមើលស្រោមជើងវែង ។
នេះគឺរាងសម្ញែងបន្តិចសំរាប់ខ្ញុំ ។
ពណ៌ព្រលាំនេះគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
វាសាកសមនឹងខ្ញុំណាស់ ។
ពណ៌ក្រហមគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
ពណ៌សគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
ពណ៌ខ្មៅគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
ពណ៌ត្នោតគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
ពណ៌ខៀវគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
ពណ៌ប្រផេះគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
ពណ៌ផ្កាឈូកគឺប្រជាប្រិយណាស់ឆ្នាំនេះ ។
វាគឺវែងខ្លាំងពេកហើយសំរាប់ខ្ញុំ ។ តើជាយក្រណាត់អាចលើកឡើងប្រហែលមួយអ៊ិងអោយខ្ញុំបានទេ ?
ប្រាកដណាស់ ។ សូមរងចាំមួយម៉ោង ។
តើអ្នកកំពុងត្រូវបានដោះស្រាយរឺនៅ ?
មិនទាន់ទេ ។ ខ្ញុំត្រូវការសំភារះសំលៀកបំពាក់ខ្លះៗ ។
ពណ៌ប្រផេះមួយ ។
ខ្ញុំចង់បានរោមចៀមសុទ្ធ ។
ខ្ញុំចង់បានសូត្រសិប្បនិមិត្ត ។
ខ្ញុំចង់បាននីឡុង ។
ខ្ញុំចង់បានរបស់ដែលបោកសំអាតបាន ។
នេះគឺជារបស់ល្អបំផុតដែលពួកយើងមានឥលូវ ។
តើខ្ញុំអាចសាកស្បែកជើងទាំងនេះបានទេ ?
ទាំងនេះគឺតូចពេកហើយសំរាប់ខ្ញុំ ។
អញ្ចឹងសូមសាកមួយគូនេះ ។
សូមសំអាតស្បែកជើងរបស់ខ្ញុំ ។
តើខ្ញុំអាចសូមសាកស្បែកជើងកីឡាទាំងនេះបានទេ ?
តើខ្ញុំអាចសូមសាកស្បែកជើងកវែងទាំងនេះបានទេ ?
តើខ្ញុំអាចសូមសាកស្បែកជើងកែងទាំងនេះបានទេ ?
តើខ្ញុំអាចសូមសាកស្បែកជើងសង្រែកទាំងនេះបានទេ ?
ខ្ញុំចង់ប្ដូរកែងស្បែកជើង ។
តើស្បែកអ្វីដែលកាបូបប្រុសនេះធ្វើពី ?
សូមបង្ហាញខ្ញុំនូវស្រោមដៃស្បែក ។
តើស្បែកអ្វីដែលកាបូបស្រីនេះធ្វើពី ?
តើស្បែកអ្វីដែលកាបូបយួរដៃនេះធ្វើពី ?
តើស្បែកអ្វីដែលកូនសៀវភៅដាក់ក្នុងហោប៉ៅនេះធ្វើពី ?
តើស្បែកអ្វីដែលកាបូបនេះធ្វើពី ?
តើស្បែកអ្វីដែលវ៉ាលីនេះធ្វើពី ?
តើស្បែកអ្វីដែលសំពត់នេះធ្វើពី ?
តើស្បែកអ្វីដែលកាតាបនេះធ្វើពី ?
តើអ្នកចង់សំដៅទៅមួយនេះលោក ?
សូមបង្ហាញខ្ញុំនូវនាឡិកាដៃសំរាប់បុរស ?
តើអ្នកនឹងបង្ហាញខ្ញុំនាឡិកាដៃនោះទេ ?
តើអ្នកនឹងបង្ហាញខ្ញុំនាឡិកាលើជញ្ជាំងនោះទេ ?
តើអ្នកនឹងបង្ហាញខ្ញុំនាឡិការោទិ៍សំរាប់ដំណើរកំសាន្តទេ ?
ប្រាកដណាស់ ។ មួយនេះយ៉ាងម៉េចដែរ ? នេះគឺស្វ័យប្រវត្តិធន់នឹងទឹកហើយមាំ ។
ខ្ញុំចង់បាននាឡិកាដៃទំហំតូចខ្លះៗសំរាប់នារី ។
តើអ្នកមានស្តើងជាងនេះមួយទេ ?
នាឡិកាដៃរបស់ខ្ញុំយឺតប្រាំនាទីក្នុងមួយថ្ងៃ ។
នាឡិកាដៃនេះដើរលឿនជាងបីនាទីក្នុងមួយថ្ងៃ ។
នាឡិការបស់ខ្ញុំដើរលឿនប្រាំនាទីក្នុងមួយថ្ងៃ ។
នាឡិការបស់ខ្ញុំដើរយឺតបីនាទីក្នុងមួយថ្ងៃ ។
ខ្ញុំចង់ទិញវ៉ែនតាថ្មីមួយគូ ។
ប៉ុន្មានដឺក្រេដែរ ?
តើអ្នកអាចអាននូវអ្វីដែលត្រូវបានបោះពុម្ភនៅខាងក្រោមទេ ?
អញ្ចឹងសូមសាកមួយគូនេះ ។
ខ្ញុំចង់ទិញប្រអប់វ៉ែនតាថ្មីមួយ ។
ខ្ញុំចង់ទិញកញ្ចក់ដាក់ក្នុងភ្នែកមួយ ។
ឥលូវខ្ញុំអាចមើលឃើញច្បាស់ណាស់ ។
សូមប្ដូរកញ្ចក់ ។ តើអ្នកអាចធ្វើវារួចរាល់ខណះខ្ញុំរង់ចាំ ?
វានឹងត្រូវបានធ្វើរួចរាល់ក្នុងរយះពេលមួយម៉ោង ។
ខ្ញុំខ្លាចក្រែងខ្ញុំមិនអាច ។ វាត្រូវការពេលវេលា ។
ស៊ុមកញ្ចក់វ៉ែនតារបស់ខ្ញុំគឺខូចហើយ ។
តើវត្ថុអនុស្សាវរីយ៍ពីប្រទេសអង់គ្លេសអ្វីដែលអ្នកណែនាំ ?
តុក្កតាកូនក្រមុំមកពីស្តុតលេននេះយ៉ាងម៉េចដែរ ?
ខ្ញុំកំពុងស្វែងរករបស់សំរាប់មិត្តស្រីរបស់ខ្ញុំ ។
ខ្ញុំផ្តល់យោបល់កន្លាស់រឺបន្តោងខ្សែក ។
សូមប្រើវាធ្វើជាទ្រនាប់ ។
ចុះគំរូប្លាស្ទិចនេះយ៉ាងម៉េចដែរ ?
ចុះខ្លែងនេះយ៉ាងម៉េចដែរ ?
ចុះរូបភាពនេះយ៉ាងម៉េចដែរ ?
ចុះរបាយការណ៍នេះយ៉ាងម៉េចដែរ ?
ខ្ញុំនឹងផ្តល់យោបល់ខ្សែកមួយ ។
ខ្ញុំនឹងផ្តល់យោបល់ខ្សែក្រវ៉ាត់មួយ ។
ខ្ញុំនឹងផ្តល់យោបល់សំលៀកបំពាក់រោមសត្វ ។
ខ្ញុំនឹងផ្តល់យោបល់គ្រឿងអលង្កាមួយ ។
ខ្ញុំនឹងផ្តល់យោបល់ក្រវិលមួយ ។
ខ្ញុំនឹងផ្តល់យោបល់របស់ចម្លែកមួយ ។
សូមប្រើវាធ្វើជាថាស ។
សូមប្រើវាធ្វើជាកន្តក់ ។
សូមប្រើវាធ្វើជាប្រដាប់ព្យួរ ។
តើខ្ញុំអាចទិញទំនិញធ្វើដោយដៃនៅឯណា ?
តើហាងលក់របស់ឥតគិតពន្ធនៅឯណា ?
តើខ្ញុំអាចទិញឆ្នាំងនៅឯណា ?
តើខ្ញុំអាចទិញចាននៅឯណា ?
តើខ្ញុំអាចទិញសំលៀកបំពាក់ប្រពៃណីនៅឯណា ?
តើខ្ញុំអាចទិញកំរាលតុនៅឯណា ?
តើខ្ញុំអាចទិញគ្រឿងបន្លាស់នៅឯណា ?
បាទ ។ តើអ្នកចង់បានប៉ុន្មាន ?
អោយខ្ញុំនូវស្រាវីស្គីពីរដបនិងស្រាគូញ៉ាក់មួយ ។
ប្រាកដណាស់ ។ តើខ្ញុំអាចសូមមើលសំបុត្ររបស់អ្នកបានទេ ?
បាទ ។ តើអ្នកចង់បានម៉ាកអ្វី ?
អោយខ្ញុំថ្នាំជក់ខ្លះ ។
អោយបារីស៊ីហ្គាមួយ ។
អោយខ្សៀខ្ញុំមួយ ។
អោយខ្ញុំបារីមួយកញ្ចប់ ។
តើអ្នកមានវិជ្ជបញ្ជាឬទេ ?
ខ្ញុំមិនអាចលក់វាដោយគ្មានវិជ្ជបញ្ជាទេ ។
សូមអោយខ្ញុំនូវថ្នាំផ្តាសាយខ្លះ ។
ខ្ញុំឈឺបំពង់ក ។ តើអ្វីដែលល្អសំរាប់វា ?
លេបវាក្រោយពេលអាហារបីដងក្នុងមួយថ្ងៃ ។
សូមថែរក្សាខ្លួនអ្នក ។
សូមអោយខ្ញុំទឹកអប់កូឡូញមួយដប ។
ខ្ញុំចង់បានមូលនិធិខ្លះ ។
តើទឹកអប់ប្រភេទអ្វីដែលអ្នកចង់បាន ?
ខ្លះសំរាប់ស្ត្រីក្មេង ។
សូមអោយខ្ញុំឡេមួយដប ។
ខ្ញុំចង់បានម្សៅលាបមុខខ្លះ ។
ខ្ញុំចង់បានម្សៅលាបមុខប្រអប់ខ្លះ ។
ខ្ញុំចង់បានក្រែមលាបបបូរមាត់ខ្លះ ។
ខ្ញុំចង់បានក្រដាសសំអាតខ្លះ ។
ខ្លះសំរាប់ស្ត្រីវ័យកណ្តាល ។
សូមអោយខ្ញុំមួយអ៊ន ។
អោយខ្ញុំសាប៊ូកក់សក់និងក្រែមកោរពុកមាត់ខ្លះ ។
ខ្ញុំកំពុងស្វែងរកប្រដាប់កាត់ក្រចក ។
សូមអោយខ្ញុំកន្លះអ៊ន ។
អោយខ្ញុំកាំបិតកោរពុកមាត់ខ្លះ ។
អោយខ្ញុំក្រដាសទន់ៗខ្លះ ។
អោយខ្ញុំសាប៊ូដុសខ្លួនខ្លះ ។
ខ្ញុំកំពុងស្វែងរកក្រាស់មួយ ។
ខ្ញុំកំពុងស្វែងរកកន្ត្រៃមួយ ។
ខ្ញុំកំពុងស្វែងរកកាំបិតបត់មួយ ។
ខ្ញុំកំពុងស្វែងរកម្ជុលខ្ទាសមួយ ។
ខ្ញុំកំពុងស្វែងរកសាប៊ូបោកសំលៀកបំពាក់ ។
ខ្ញុំកំពុងស្វែងរកម្ជុលមួយ ។
ខ្ញុំកំពុងស្វែងរកឡេវ ។
ខ្ញុំកំពុងស្វែងរកអំបោះដេរ ។
ខ្ញុំកំពុងស្វែងរកប្រដាប់កឹបមួយ ។
ខ្ញុំកំពុងស្វែងរកជ័របិទ ។
ខ្ញុំកំពុងស្វែងរកកាវមួយ ។
ខ្ញុំកំពុងស្វែងរកឆ័ត្រមួយ ។
សូមតែកាត់សក់ទេ ។
ខ្ញុំចង់បានការកោរពុកមាត់ ។
សូមកាត់តម្រឹមបានហើយ ។
សូមធ្វើវាអោយខ្លីបន្តិច ។
បាទនៅម៉ោងពីរសាមសិបនាទី ។ ឈ្មោះរបស់ខ្ញុំគឺយ៉ូស៊ីកូកាម៉ី ។
ខ្ញុំចង់អោយកក់ហើយមូលសក់ ។
ខ្ញុំចង់បានសក់អ៊ុតទន់ ។
ខ្ញុំមិនមានពេលវេលាច្រើនទេ ។
ខ្ញុំចង់បានសក់អ៊ុតមាំ ។
ខ្ញុំចង់បានសក់អ៊ុតកំណាញ់ ។
អោយខ្ញុំថ្លឹងវា ។
ដោយការដឹកជញ្ជូនពិសេស ?
ដោយការផ្ញើរតាមប៉ុស្តិ៍ដោយមានការធានា ?
នៅបង្អួចលេខបួន ។
ខ្ញុំចង់ផ្ញើរទូរលេខមួយ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទឆ្ងាយទៅកាន់សាន់ហ្វ្រាន់ស៊ីស្កូ ។
សូមលេខទូរស័ព្ទ ។
ប្រាំមួយបីពីរប្រាំពីរមួយប្រាំបួនប្រាំមួយលេខកូដតំបន់បួនពីរប្រាំ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទទៅកាន់សាន់ហ្វ្រាន់ស៊ីស្កូ ។
ខ្ញុំចង់ទូរស័ព្ទទៅសាន់ហ្វ្រាន់ស៊ីស្កូ ។
តើវាមានតំលៃប៉ុន្មានសំរាប់ការហៅទូរស័ព្ទឆ្ងាយទៅកាន់តូក្យូ ?
សូមធ្វើវាអោយក្លាយជាការហៅដោយបង់ដោយអ្នកទទួល ។
បាន ។ តើខ្ញុំអាចសូមឈ្មោះរបស់អ្នកបានទេ ?
សូមចាំមួយភ្លេត ។
ក្រុមរបស់អ្នកគឺនៅលើប្រព័ន្ធហើយ ។ សូមចាប់ផ្តើម ។
ក្រុមហ៊ុនវ៉េសត្រេតដីង ។
នេះគឺលោកស៊ូជូគី ។ តើខ្ញុំអាចនិយាយទៅកាន់លោកចនបានទេ ?
សូមចាំមួយភ្លេត ។ ខ្ញុំនឹងទាក់ទងអ្នកទៅលោកចន ។
លោកចនទើបតែចេញក្រៅ ។
គាត់នឹងត្រលប់មកវិញក្នុងរយះពេលមួយម៉ោង ។
តើនរណាកំពុងទូរស័ព្ទមក ?
គាត់មិននៅទីនេះទេ ។
បាន ។ មួយម៉ោងទៀតខ្ញុំនឹងទូរស័ព្ទទៅគាត់ម្តងទៀត ។
តើអ្នកចង់អោយគាត់ទូរស័ព្ទត្រលប់ទៅវិញទេ ?
ទេ ។ សូមប្រាប់គាត់ថាខ្ញុំទូរស័ព្ទទៅ ។
នេះគឺលោកស៊ូជូគីកំពុងនិយាយខ្ញុំចង់សួរអំពីការកក់សណ្ឋាគារ ។
តើអ្នកចង់បន្សល់ទុកសារទេ ?
សូមចាំមួយនាទី ។
អ្នកលក់ដែលទាក់ទងគឺនៅប្រព័ន្ធមួយទៀត ។ តើអ្នកនឹងរង់ចាំមួយនាទី ?
ប្រសិនបើអ្នកបន្សល់លេខរបស់អ្នកគាត់នឹងទូរស័ព្ទទៅអ្នកលោក ។
អរគុណ ។ លេខរបស់ខ្ញុំគឺបីសូន្យពីរបួនប្រាំបីប្រាំមួយប្រាំ ។
សួស្តីលោកស៊ូជូគី ។ ខ្ញុំរីករាយណាស់ដែលអ្នកនៅទីនេះ ។ តើខ្ញុំអាចជួបអ្នកនៅពេលណា ?
ខ្ញុំមិនអាចស្តាប់បាននូវអ្វីដែលអ្នកបាននិយាយទេ ។
ខ្ញុំមិនអាចលឺអ្នកច្បាស់ទេ ។
ខ្ញុំមានអារម្មណ៍ថាឈឺខ្លាំង ។
ខ្ញុំនឹងទូរស័ព្ទទៅឡានពេទ្យ ។
គាត់ឈឺហើយ ។ សូមទូរស័ព្ទទៅកាន់គ្រូពេទ្យអោយគាត់ ។
សូមអង្គុយចុះ ។ តើមានបញ្ហាអ្វី ?
ខ្ញុំអាចបរិភោគបានតិចណាស់ ។
បាទហើយខ្ញុំឈឺបំពង់ក ។
តើវាធ្ងន់ធ្ងរទេ ?
អ្នកមានជំងឺរលាកខ្នែងពោះវៀន ។
ខ្ញុំនឹងអោយវេជ្ជបញ្ជាទៅអ្នក ។ យកវាទៅអោយអ្នកលក់ថ្នាំ ។
មើលថែរក្សាខ្លួនអ្នក ។
អាគារពីរខាងមុខ ។
ម៉ាស៊ីនថតរបស់ខ្ញុំត្រូវបានលួចហើយ ។
ចោរលួចហោប៉ៅរបស់ខ្ញុំ ។
ខ្ញុំបានទុកកាបូបរបស់ខ្ញុំនៅឡានក្រុង ។
កាបូបរបស់ខ្ញុំត្រូវបានលួចហើយ ។
កាបូបរបស់ខ្ញុំត្រូវបានលួចហើយ ។
មានគ្រោះថ្នាក់ចរាចរណ៍មួយ ។
ខ្ញុំសូមទោសអ្នកមិនអាចទេ ។
សូមដាក់ឥេវ៉ាន់របស់អ្នកនៅក្រោមកៅអីអ្នក ។
ស្វាគមន៍ការនៅលើអ៊ែហ្វ្រាន់ ។
ពួកយើងនឹងទៅដល់សាមសិបនាទីក្រោយកាលវិភាគ ។
តើអ្នកមានទស្សានាវដ្តីភាសាជប៉ុនមួយទេ ?
តើអ្នករួចរាល់សំរាប់នំចំណីហើយរឺនៅ ?
តើខ្ញុំអាចបង់ប្រាក់ជាប្រាក់យេនបានទេ ?
តើពួកយើងកំពុងហោះហើរលឿនប៉ុណ្ណាឥលូវ ?
ឈ្មោះរបស់អ្នក ?
អរគុណ ។ រីករាយនឹងដំណើរកំសាន្តរបស់អ្នក ។
តើនេះគឺវ៉ាលីរបស់អ្នកទាំងអស់ ?
សូមប្ដូរប្រាក់បរទេសនេះទៅជាប្រាក់សុទ្ធ ។
សូមប្ដូរប្រាក់បារាំងនេះទៅជាប្រាក់សុទ្ធ ។
សូមប្ដូរសែកផ្ទាល់ខ្លួននេះទៅជាប្រាក់សុទ្ធ ។
អ្នកយួរឥវ៉ាន់សូមយកវ៉ាលីនេះទៅកាន់ឡានតាក់ស៊ី ។
ឈ្មោះរបស់ខ្ញុំគឺកាម៉ី ។ ខ្ញុំមានការកក់នៅទីនេះសំរាប់ពីរយប់ ។
សូមចាំបន្តិច ។ លោកកាម៉ី មកពីតូក្យូ ។ បាទ ពួកយើងមានការកក់ទុកជាមុនមួយសំរាប់លោក ។
សូមបន្ទប់មានគ្រែពីរនិងមានបន្ទប់ទឹក ។
សូមបន្ទប់មានគ្រែមួយនិងគ្មានបន្ទប់ទឹក ។
សូមបន្ទប់មានគ្រែមួយនិងប៉ៅអ៊ីមួយ ។
សូមបន្ទប់មានគ្រែពីរនិងប៉ៅអ៊ីមួយ ។
សូមបន្ទប់មានគ្រែភ្លោះនិងប៉ៅអ៊ីមួយ ។
សូមបន្ទប់មានគ្រែភ្លោះនិងមានបន្ទប់ទឹក ។
សូមបន្ទប់មានគ្រែភ្លោះនិងគ្មានបន្ទប់ទឹក ។
សូមបន្ទប់មានគ្រែពីរនិងគ្មានបន្ទប់ទឹក ។
វាថ្លៃមួយរយដុល្លារសំរាប់មួយថ្ងៃ ។
រួចរាល់ហើយ លោក ជាន់ទីដប់ពីរ ។ បន្ទប់របស់លោកស្ថិតនៅចុងអាគារនេះ ។
ក្នុងថង់ក្រដាសពណ៌ត្នោតទាំងនេះ ។
តើអ្នកអាចបើកម៉ាស៊ីនកំដៅបានទេ ?
ម៉ោងដប់ពីរថ្ងៃត្រង់ ។
អញ្ចឹង ទុកអោយខ្ញុំទៅត្រួតពិនិត្យនៅតុខាងមុខ ។
តើខ្ញុំអាចទូរស័ព្ទទៅកាន់សេវាកម្មបន្ទប់ដោយរបៀបណា ?
សូមហៅទូរស័ព្ទមកដាស់ខ្ញុំនៅម៉ោងប្រាំមួយព្រឹកស្អែក ។
សោរមេហ្នឹងខូចហើយ ។
បាទ ។ ខ្ញុំនឹងយកទឹកផ្លែក្រូចស្រស់ ។
បាទ ។ សូមយកនំភែនខេកមកអោយខ្ញុំ ។
បាទ ។ សូមយកនំដូណាត់មកអោយខ្ញុំ ។
សហការី ? ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទដែលគិតលុយពេលម្ខាងទៀតលើក ។
តើខ្ញុំអាចយកផែនទីសំរាប់ដើរលេងនៅឯណា ?
តើខ្ញុំអាចយកផែនទីសំរាប់កាលវិភាគផ្លូវដែកនៅឯណាបាន ?
តើអ្នកអាចណែនាំកន្លែងដែលមានទស្សនីយភាពល្អមួយបានទេ ?
វិក័យប័ត្ររបស់អ្នកអស់មួយរយហាសិបដុល្លារនិងសែសិបប្រាំសេន ។
ខ្ញុំចង់ផ្ញើកាបូបរបស់ខ្ញុំរហូតដល់ម៉ោងបី ។
ពួកយើងមានត្រីសាលម៉ុនល្អៗសំរាប់ថ្ងៃនេះ ។
សុំអោយស៊ុបមានសាច់និងបន្លែ ។
សូមអោយខ្ញុំស្រាបៀរដ្រាហ្វមួយ ។
តើអ្នកចង់បានបាយទេ ?
ពួកយើងយកស្រាក្រហម ។
ពួកយើងយកស្រាស ។
ខ្ញុំចង់សាកនំផៃខ្លះ ។
តើអ្នកយកនំបុ័ងទេ ?
តើរួមបញ្ចូលថ្លៃសេវាកម្មទេ ?
តើខ្ញុំអាចសុំអានោះបានទេ ?
សុំក្រែមកាហ្វេ ។
សុំក្រែមកាហ្វេស្រស់ ។
សុំស្ករកាហ្វេ ។
សុំទឹកដោះគោសំរាប់កាហ្វេ ។
សុំកាកាវកាហ្វេ ។
សុំនំខេកក្រែមតូចមួយ ។
សុំទឹកផ្លែមេឡុងបីកែវ ។
សុំសំបុត្រមួយទៅម៉ាឌ្រីត ។
សុំសំបុត្រពីរទៅមកទៅកាន់វេនីស ។
តើខ្ញុំចុះនៅឯណាដើម្បីទៅដល់សួនសត្វ ?
នៅផ្លូវទីចិតសិបពីរ ។
តើអ្នកចង់ទៅណា ?
ប្រហែលកន្លះម៉ោង ។
តើផ្លូវណាទៅកាន់ផ្លូវចូលសំរាប់ការិយាល័យប្រៃសណីយ៍កណ្តាល ?
នេះ ម្ភៃមួយដុល្លារ ។ ទុកលុយអាប់ចុះ ។
តើបើកឆ្ងាយណាស់ទេ ?
តើខ្ញុំអាចសុំមើលប័ណ្ណបើកបរអន្តរជាតិរបស់អ្នកបានទេ ?
អរគុណ ។ សូមបំពេញកិច្ចសន្យាទាំងនេះ ។
សែសិបដុល្លារសំរាប់មួយថ្ងៃបូកនឹងប្រាំបីសេនសំរាប់មួយម៉ែល ។
អញ្ចឹង ។ យកសាំងធម្មតា ឬសាំងដែលមានថាមពលខ្លាំង ?
តើអ្នកអាចបង្ហាញខ្ញុំពីផ្លូវសំរាប់ទៅកាន់ស្ថានីយកណ្តាលដែរឬទេ ?
មិនអីទេ ។ បត់ឆ្វេងនៅកាច់ជ្រុងទីបី ។ អ្នកនឹងឃើញវានៅខាងមុខអ្នកតែម្តង ។
មិនអីទេ ។ បត់ស្តាំនៅកាច់ជ្រុងបន្ទាប់ ។ អ្នកនឹងឃើញវានៅខាងមុខអ្នកតែម្តង ។
មិនអីទេ ។ បត់ឆ្វេងនៅកាច់ជ្រុងបន្ទាប់ ។ អ្នកនឹងឃើញវានៅខាងមុខអ្នកតែម្តង ។
មិនអីទេ ។ បត់ស្តាំនៅកាច់ជ្រុងទីបី ។ អ្នកនឹងឃើញវានៅខាងមុខអ្នកតែម្តង ។
ទៅកាន់ឧទ្យានហាយផាក ។
ទៅមុខត្រង់តាមទន្លេប្រហែលជាកន្លះម៉ែល ។ អ្នកនឹងទៅដល់សួនឧទ្យានហើយ ។
តើខ្ញុំអាចទៅវិចិត្រសាលដោយរបៀបណា ?
ទៅកាន់ចំណោតហ្នឹង ។ អ្នកនឹងទៅដល់ផ្លូវបែកជាបី ។ បន្ទាប់មកទៅខាងឆ្វេង ។
ច្រើនជាងម្ភៃនាទី ។
សូមអភ័យទោស តើរុក្ខវិថីណាដែលយើងកំពុងនៅ ?
សូមអភ័យទោស តើផ្លូវប្រសព្វណាដែលយើងកំពុងនៅ ?
សូមអភ័យទោស ។ តើមានទូរស័ព្ទសាធារណៈនៅជិតនេះទេ ?
បាទ ។ នៅម្តុំកាច់ជ្រុងហ្នឹង អ្នកនឹងឃើញមួយហើយ ។
សូមអភ័យទោស តើអ្នកអាចនាំផ្លូវខ្ញុំទៅកាន់អាសយដ្ឋាននេះបានទេ ?
សូមអភ័យទោស ។ តើមានគំនូសសឆ្លងកាត់នៅជិតនេះទេ ?
សូមអភ័យទោស ។ តើមានស្ពាននៅជិតនេះទេ ?
ខ្ញុំអាចចំណាយពេលមួយល្ងាចពេញ ។
តើមានការពន្យល់ជាភាសាអង់គ្លេសដែរឬទេ ?
តើដំណើរកំសាន្តមួយថ្ងៃពេញត្រូវការរយៈពេលប៉ុន្មាន ?
ម៉ោងបីកន្លះ ។ សូមកុំមកយឺត ។
តើកន្លែងអង្គុយជាន់ទីមួយបានទេ ?
តើខ្ញុំអាចកក់កន្លែងអង្គុយពីរសំរាប់ល្ងាចនេះបានទេ ?
តើខ្ញុំអាចកក់កន្លែងអង្គុយប្រអប់ពីរសំរាប់ល្ងាចនេះបានទេ ?
សុំទោស កន្លែងអង្គុយសំរាប់កក់ទាំងអស់ពេញហើយ ។
សុំទោស កន្លែងអង្គុយប្រអប់ទាំងអស់លក់អស់ហើយ ។
សុំទោស កន្លែងមើលវង់តន្ត្រីលក់អស់ហើយ ។
សុំទោស កន្លែងអង្គុយនៅយ៉រលក់អស់ហើយ ។
សុំទោស កន្លែងអង្គុយក្រោយៗដែលថោកលក់អស់ហើយ ។
តើអ្នកនិពន្ធល្ខោនហ្នឹងជានរណា ?
តើការជ្រើសរើសសំរាប់ថ្ងៃនេះគឺអ្វី ?
តើល្ងាចនេះបញ្ចាំងអ្វីនៅរោងកុន ?
តើអ្នកណាដែលគូររូបគំនូរនេះ ?
ខ្ញុំចង់កក់កៅអីមួយ ថ្នាក់អេកូណូមិ ទៅកាន់ទីក្រុងឡុង ថ្ងៃអាទិត្យក្រោយ ។
ខ្ញុំចង់កក់កៅអីមួយ នៅថ្ងៃដប់ប្រាំ ខែសីហា ជើងហោះហើរ ស្វីសអ៊ែរ លេខមួយ សូន្យ សូន្យ ។
ខ្ញុំចង់កក់កៅអីមួយ សំរាប់ជើងហោះហើរ ភីអេអេ លេខប្រាំ សូន្យ ប្រាំ នៅម៉ោងប្រាំពីរ សែសិបប្រាំ ។
ឈ្មោះរបស់ខ្ញុំគឺសាតូ ។ ជើងហោះហើររបស់ខ្ញុំគឺអេសអេអេស ប្រាំមួយបួនប្រាំបួន ។ ថ្ងៃទីបីខែមេសា ។ ពីខូប៉េខាជេនទៅហាំប៊ឺក អេកូណូមិ ក្លាស ។
សូមអោយកៅអីជិតបង្អួចនៅខាងក្រោយមកខ្ញុំមួយ ។
សូមអោយកៅអីនៅចំហៀងនៅខាងក្រោយមកខ្ញុំ ។
សូមអោយកៅអីនៅចំហៀងនៅខាងមុខមកខ្ញុំ ។
សូមអោយកៅអីនៅចំហៀងនៅកណ្តាលមកខ្ញុំ ។
សូមអោយកៅអីជិតបង្អួចនៅខាងមុខមកខ្ញុំមួយ ។
សូមអោយកៅអីជិតបង្អួចនៅកណ្តាលមកខ្ញុំមួយ ។
ខ្ញុំចង់ប្ដូរការកក់របស់ខ្ញុំ ។ តើខ្ញុំអាចលុបចោលជើងហោះហើរផានអាន់ លេខប្រាំសូន្យប្រាំ ទៅកាន់លេខប្រាំមួយប្រាំបានទេ ?
ទុកអោយខ្ញុំថ្លឹងវា ។ នេះគឺស្លាកវ៉ាលីរបស់អ្នក ។ សូមទៅកាន់ច្រកសាមសិបប្រាំមុនម៉ោងបីកន្លះ ។
ខ្ញុំនឹងយកបន្ទប់តម្លៃដប់ប្រាំដុល្លារ ។
បង្ហាញខ្ញុំពណ៌ផ្សេងទៀត ។
បង្ហាញខ្ញុំអាទំហំធំជាងនេះ ។
បង្ហាញខ្ញុំអាទំហំតូចជាងនេះ ។
តើអ្នកអាចចុះតម្លៃអោយខ្ញុំបានទេ ប្រសិនបើខ្ញុំទិញបី ?
តើជាន់ណាលក់សំភារៈអេឡិចត្រូនិច ?
ខ្ញុំចង់បានអានេះ ។
សូមពង្រីកវាអោយធំនិងផ្តិតហ្វីលទាំងនេះមក ។
មួយសប្ដាហ៍ចាប់ពីថ្ងៃនេះ ។
ប្រដាប់ច្រោះខូចហើយ ។
អំពូលភ្លើងផ្លាសខូចហើយ ។
ប្រដាប់វាស់ពន្លឺខូចហើយ ។
ខ្ញុំចង់បានអាវសឺមី ។
បាទ ។ ខ្ញុំរកមើលខោមួយកំផ្លេ ។
ពណ៌លឿងគឺពេញនិយមណាស់សំរាប់ឆ្នាំនេះ ។
តើអ្នកនឹងបង្ហាញខ្ញុំនាឡិកានោះបានទេ ?
តើអ្នកនឹងបង្ហាញខ្ញុំនាឡិការោទិ៍នោះបានទេ ?
នាឡិកាខ្ញុំដើរខុសប្រាំនាទី ។
នាឡិកាខ្ញុំដើរលឿនប្រាំនាទី ។
នាឡិកាខ្ញុំដើរយឺតប្រាំនាទី ។
តើខ្ញុំអាចពិនិត្យមើលភ្នែករបស់អ្នកបានទេ ?
ចុះតុក្កតានេះដែលធ្វើនៅស្កុតលែនយ៉ាងម៉េចដែរ ?
ចុះគំរូប្លាស្ទិកនេះដែលធ្វើនៅស្កុតលែនយ៉ាងម៉េចដែរ ?
ចុះខ្លែងនេះដែលធ្វើនៅស្កុតលែនយ៉ាងម៉េចដែរ ?
ចុះរូបគំនូរនេះដែលគូរនៅស្កុតលែនយ៉ាងម៉េចដែរ ?
ចុះចំរៀងនេះដែលថតនៅស្កុតលែនយ៉ាងម៉េចដែរ ?
ខ្ញុំសូមណែនាំគ្រឿងអលង្ការ ។
ខ្ញុំសូមណែនាំក្រវិល ។
តើខ្ញុំអាចទិញថូនៅឯណា ?
តើខ្ញុំអាចទិញសំលៀកបំពាក់ប្រពៃណីនៅឯណា ?
តើខ្ញុំអាចទិញកម្រាលតុនៅឯណា ?
បាទ ។ តើអ្នកចង់បានប៉ុន្មាន ?
តើដែកកេះគិតពន្ធដែរឬទេ ?
តើគ្រឿងអលង្ការគិតពន្ធដែរឬទេ ?
តើចិញ្ចៀនគិតពន្ធដែរឬទេ ?
តើស្លាបប៉ាកាគិតពន្ធដែរឬទេ ?
ឲ្យបារីខ្ញុំមួយកាតុងមក ។
ឲ្យម៉ាកនេះខ្ញុំមួយកញ្ចប់មក ។
បាទ ។ តើអ្នកចង់បានម៉ាកអីខ្លាំងជាងគេ ?
សូមអោយខ្ញុំថ្នាំអាស្ពីរីនខ្លះមក ។
ខ្ញុំក្អក ។ តើមានថ្នាំល្អអីសំរាប់វាទេ ?
តើខ្ញុំអាចសាកក្លិនហ្នឹងបានទេ ?
ខ្ញុំចង់បានក្រដាស់ជូតមាត់ ។
ខ្ញុំកំពុងរកមើលកន្ត្រៃ ។
ខ្ញុំកំពុងរកមើលប្រដាប់គាស់ដប ។
ខ្ញុំកំពុងរកមើលម្សៅសាប៊ូ ។
ខ្ញុំកំពុងរកមើលឡេវអាវ ។
ខ្ញុំកំពុងរកមើលអំបោះ ។
ខ្ញុំកំពុងរកមើលកាវ ។
ខ្ញុំចង់សិតសក់មកខាងឆ្វេង ។
ចុះម៉ាស៊ីនសំងួតខោអាវយ៉ាងម៉េចដែរ ?
តើអ្នកមានការណាត់ជួបទេ ?
ធ្វើក្រចកខ្ញុំមួយ ។
ខ្ញុំចង់ផ្ញើរបស់របរផ្ទាល់ខ្លួនទៅប្រទេសជប៉ុន ។
ខ្ញុំចង់ផ្ញើឯកសារនេះទៅប្រទេសជប៉ុន ។
ខ្ញុំចង់ផ្ញើកាតប៉ុស្តាល់នេះទៅប្រទេសជប៉ុន ។
ខ្ញុំចង់ផ្ញើកាតប៉ុស្តាល់រូបភាពនេះទៅប្រទេសជប៉ុន ។
ប្រហែលមួយសប្ដាហ៍ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទឆ្លងសមុទ្រទៅកាន់សាន់ហ្វ្រានស៊ីស្កូ ។
ល្អ ។ តើខ្ញុំអាចសុំឈ្មោះរបស់អ្នកបានទេ ?
នេះគឺលោកស៊ូស៊ុយគីកំពុងនិយាយ ។ ខ្ញុំសូមនិយាយទៅកាន់លោកចន ។
ភ្នាក់ងារវេសត្រាវែល ។
ប្រធានផ្នែកនៅខ្សែមួយទៀត ។ តើអ្នកនឹងចាំមួយភ្លែតបានទេ ?
គាត់ឈឺហើយ ។ សូមហៅគិលានុបដ្ឋាយិកាអោយគាត់មួយ ។
តើនេះគឺជាការពិគ្រោះយោបល់របស់លោកវេជ្ជបណ្ឌិតអេចឬ ?
តើខ្ញុំអាចសុំថ្នាំរបស់ខ្ញុំបានទេ ?
ទេ ។ ប្រសិនបើអ្នកលេបវាពីរបីថ្ងៃ អ្នកនឹងល្អជាងមុនមិនខាន ។
ខ្ញុំនឹងអោយវេជ្ជបញ្ជាទៅអ្នក ។ យកវាទៅហាងលក់ថ្នាំទៅ ។
ខ្ញុំបាត់កាបូបស្រីរបស់ខ្ញុំ ។
ខ្ញុំបាត់កាបូបលុយរបស់ខ្ញុំ ។
មានគ្រោះថ្នាក់ចរាចរណ៍រវាងឡាននិងឡានមួយបានកើតឡើង ។ សូមមកអោយលឿន ។
មានគ្រោះថ្នាក់ចរាចរណ៍រមួយបានកើតឡើង ។ សូមមកអោយលឿន ។
មានការប៉ះទង្គិចមួយ ។ សូមមកអោយលឿន ។
មានការត្រូវរបួសមួយ ។ សូមមកអោយលឿន ។
ខ្ញុំសុខសប្បាយទេ អរគុណ ។
រីករាយដែលបានជួបអ្នក ។
ខ្ញុំសូមណែនាំពីខ្លួនរបស់ខ្ញុំ ។
សូមអោយមានថ្ងៃល្អ ។
សូមអោយមានថ្ងៃចុងសប្ដាហ៍ល្អ ។
ថែរក្សាខ្លួន ។
អរគុណសំរាប់គ្រប់យ៉ាង ។
ខ្ញុំសប្បាយចិត្តណាស់ ។
ខ្ញុំរីករាយដែលបាននិយាយជាមួយអ្នក ។
វាសប្បាយណាស់ ។
ខ្ញុំសោកស្តាយជាអនេក ។
ខ្ញុំសូមទោសដែលមកយឺត ។
ខ្ញុំតាមអ្នកនិយាយអត់ទាន់ទេ ។
តើអ្នកអាចប្រាប់ខ្ញុំម្តងទៀតបានទេ ?
តើអ្នកអាចនិយាយម្តងទៀតយឺតបានទេ ?
តើអ្នកអាចនិយាយវាម្តងទៀតជាពាក្យសាមញ្ញបានទេ ?
តើវាមានន័យថាម៉េច ?
សុំទោស ខ្ញុំមិនយល់ទេ ។
ខ្ញុំមិនសូវយល់ទេ ។
តើពាក្យនេះមានន័យថាម៉េច ?
តើអ្នកពន្យល់វាម្តងទៀតបានទេ ?
