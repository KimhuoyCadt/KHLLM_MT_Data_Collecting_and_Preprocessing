ចុះម៉ោងបីយ៉ាងម៉េចដែរ ?
ខ្ញុំមិនមានប្រាក់រាយទេ ។
សូមកូនសោររបស់ខ្ញុំ ។ បន្ទប់លេខបីសែសិបមួយ ។
តើល្បែងកំសាន្តដែលអ្នកចូលចិត្តគឺអ្វី ?
សូមអោយខ្ញុំនូវហត្ថលេខារបស់អ្នកនៅទីនេះ ។
ពួកយើងអាចនិយាយពីវានៅហាងកាហ្វេ ។
ប្រាប់ខ្ញុំបន្ថែមអំពីអ្នក ។
តើអ្នកប្រកាន់ក្នុងការថតជាមួយខ្ញុំទេ ?
តើអ្នកប្រកាន់ចុចសន្ទះបើកអោយពន្លឺចូលសំរាប់ខ្ញុំទេ ?
តើមានសេវាកម្មរថយន្តលីមូហ្សីនទៅកាន់ទីក្រុងទេ ?
សូមទៅកាន់សណ្ឋាគារហ្វេមុន ។
តើខ្ញុំអាចសូមមានស្រោមសំបុត្រនេះបានទេ ?
សូមចាំហ្នឹងហើយ, ខ្ញុំនឹងត្រឡប់មកវិញនៅប្រាំនាទីទៀត ។
សូមឈប់មុនទៅដល់ផ្លូវប្រសព្វនោះ ។
សូមបញ្ជូនឡានមកការិយាល័យ ។
តើអ្វីជាអត្រាប្ដូរប្រាក់ថ្ងៃនេះ ?
សូមប្រគល់លិខិតបញ្ជាក់សុខភាពអោយខ្ញុំផង ។
ក្រពះខ្ញុំឈឺ ។
ខ្ញុំគ្រុនហើយ ។
ខ្ញុំញ៉ាំច្រើនពេក ។
ខ្ញុំផឹកច្រើនពេក ។
ខ្ញុំគិតថាជើងរបស់ខ្ញុំបាក់ហើយ ។
តើខ្ញុំត្រូវតែចូលសំរាកពេទ្យរឺ ?
សូមបង្ហាញបណ្ណ័ជិះយន្ដហោះ ។
សូមអភ័យទោស, ប៉ុន្តែលេខកៅអីរបស់ខ្ញុំគឺ អឺហាសិបប្រាំមួយ ។ វានៅកន្លែងណា ?
តើខ្ញុំគួរដាក់ឥវ៉ាន់របស់ខ្ញុំនៅទីណា ?
សូមដាក់នៅខាងក្រោមកៅអី ។
សូមដាក់របស់ដែលស្រាលៗនិងអាវក្រៅនៅលើប្រដាប់សំរាប់ព្យួរ ។
សូមអភ័យទោស, ប៉ុន្តែសុំពន្យល់ពីបូតុងទាំងនេះបន្តិច ?
មួយនៅខាងឆ្វេងគឺជាប៊ូតុងចុចទំរេតកៅអីនិងភ្លើង ហើយមួយនៅខាងស្តាំគឺជ្រើសរើសចំម្រៀង និងចុចហៅបុគ្គលិករបស់យើង
អោយខ្ញុំសុំភួយនិងខ្នើយ ?
តើលោកត្រូវការភេសជ្ជៈទេ ?
បាទ, តើខ្ញុំអាចសុំទឹកក្រូចបានទេ ?
តើអ្នកអាចធ្វើស្រាក្រឡុកបានទេ ?
បាទ, តើខ្ញុំអាចសុំទឹកក្រូចកូកាបានទេ ?
បាទ, តើខ្ញុំអាចសុំទឹកប៉េងបោះបានទេ ?
បាទ, យើងមានស្រាម៉ាទីនី, ម៉ាន់ហាន និងសម័យចាស់មួយ ។
បើចឹង, សុំយកស្រាអិចត្រាដាយម៉ាទីនីមក ។
ពីរដុល្លារម្ភៃសេន
បាទ, នោះប្រហែលជាប្រាំពីររយយ៉េន ។
តើលោកត្រូវការអាហារល្ងាចទេ ?
តើលោកពិសារអាហាររួចរាល់ហើយរឺនៅ ?
បាទ, សុំលើកចានទាំងនេះទៅ ។
វាពិតជាឆ្ងាញ់ណាស់ ។
តើលោកត្រូវការអាហារពេលព្រឹកដែររឺទេ ?
តើលោកត្រូវការអាហារសំរន់ដែររឺទេ ?
តើកាសទាំងនោះថ្លៃប៉ុន្មាន ?
តើនៅពេលណាយើងទៅដល់សានហ្វ្រាន់ស៊ីស្កូ ?
តើពួកយើងត្រូវឈប់នៅទីនេះរយៈពេលប៉ុន្មានដែរ ?
ប្រហែលរយៈពេល សែសិបប្រាំនាទី ។
បាទ, អ្នកអាច, ប៉ុន្តែអ្នកគួរតែយករបស់ដែលមានតំលៃរបស់អ្នកទៅតាមខ្លួន ។
សូមមេត្តាប្រាប់ខ្ញុំនៅពេលដែលយន្តហោះរៀបនឹងចាកចេញ ។
កុំបារម្ភ ។ ពួកយើងនឹងប្រកាសជាដំណឹង ។
តើពេលណាដែលការតភ្ជាប់ការហោះហើរនេះត្រូវចេញដំណើរទៅទីក្រុង ឡាស វ៉េហ្កាស ?
គឺនៅម៉ោងដប់ព្រឹក, ម៉ោងនៅក្នុងតំបន់ ។
សូមអភ័យទោស, ខ្ញុំមិនស្រួលខ្លួនទេ ។
តើខ្ញុំអាចសុំថ្នាំអ្នកបានដែរទេ ?
ប្រាកដជាបាន ។ ខ្ញុំនឹងយកអោយអ្នកឥលូវនេះ ។
តើអ្នកមានអារម្មណ៍យ៉ាងម៉េចដែរ ?
ខ្ញុំដឹងហើយ ។ ហើយសូមជួយយកទឹកអោយខ្ញុំមួយកែវផង ។
បាទ ។ សូមមេត្តាបន្តការត្រួតពិនិត្យលិខិតឆ្លងដែន ។
ខ្ញុំកំពុងមានដំណើរទស្សនាកំសាន្ត ។
ខ្ញុំមកដើម្បីជំនួញ ។
ខ្ញុំឈ្មោះ កេកូ តាកិស៊ីតា ។
ទើបតែ ម្ភៃថ្ងៃ ។
ទាំងនេះជាឥវ៉ាន់របស់ខ្ញុំ
សូមជួយបើកកាបូបនេះផង ។
តើមានអ្វីនៅក្នុងកាបូបតូចនេះ ?
គឺមានកាមេរ៉ាថតទំហំ ប្រាំបីមីលីម៉ែតមួយ ។ វាជារបស់ប្រើប្រាស់ផ្ទាល់ខ្លួនរបស់ខ្ញុំ ។
តើនេះជាកញ្ចប់អ្វី ?
វាគឺជាសារាយស្ងួត និងតែបៃតង ។
ទាំងនេះជាអំណោយសំរាប់មិត្តភក្តិរបស់អ្នក តើមែនដែរទេ ?
បាទ, ខ្ញុំមានក្រដាសកាតុងពីរ ។
តើនេះជាអំណោយស្រាសាកិជប៉ុនមែនដែរទេ ?
និយាយអញ្ចឹង, តើឥលូវលោកមានលុយប៉ុន្មាន ?
ខ្ញុំមាន បួនរយដុល្លារសហរដ្ឋអាមេរិក ។
សូមអភ័យទោស, ខ្ញុំកំពុងតែរកទូទូរស័ព្ទ ។
វាគឺនៅតាមផ្លូវក្រោមនៃសាល ។
វានៅលើជាន់ទីពីរ ។
វានៅទល់មុខបន្ទប់រង់ចាំ ។
ខ្ញុំចង់ទៅសណ្ឋាគារ ហ្វែរម៉ោន ។
តើលោកត្រូវការប្រើឡានវែង លីម៉ូស៊ីន រឺមួយក៏តាក់ស៊ី ?
ខ្ញុំគិតថាខ្ញុំជិះឡានវែង លីម៉ូស៊ីនទៅវិញ ។
តើឡានវែង លីម៉ូស៊ីន មានតំលៃប៉ុន្មានដែរ ?
តំលៃ ប្រាំពីររយហាសិបដុល្លារ ។
វាគឺនៅទល់មុខច្រកចេញខាងត្បូង ។ រថយន្តក្រុងបន្ទាប់គឺនៅម៉ោងមួយ សាមសិបនាទីរសៀល ។
ទៅកាន់ច្រកចេញខាងត្បូង តើដើរតែបន្តិចមែនទេ ?
វាមិនឆ្ងាយពេកទេ ។
តើឈ្នួលកាន់ឥវ៉ាន់មានតំលៃប៉ុន្មានដែរ ?
កាបូបមួយតំលៃ ចិតសិបប្រាំសេន ។
តើឡានវែង លីម៉ូស៊ីននេះនឹងទៅវិថីទីប្រាំពីរមែនទេ ?
អត់ទេ, គឺវាទៅចំណតរថយន្តក្រុងចុងក្រោយបង្អស់ ។
ខ្ញុំចង់ទៅសណ្ឋាគារ សេនហ្រ្វាន់ស៊ីស ។ តើទីនោះគិតថ្លៃប៉ុន្មានដែរ ?
ប្រាំដុល្លារ ។
ល្អ, អញ្ចឹងជួយជូនខ្ញុំទៅ សេនហ្វ្រាន់ស៊ីន ។
សូមមេត្តាជូនខ្ញុំទៅកាន់អាស័យដ្ឋាននេះ ។
តើអ្នកអាចរក្សាទុកវ៉ាលីសរបស់ខ្ញុំរហូតដល់ម៉ោង ប្រាំពីរបានដែរទេ ?
អរុណសួស្តីលោក ។ តើខ្ញុំអាចជួយអ្នកបានទេ ?
តើខ្ញុំអាចសុំស្គាល់ឈ្មោះលោកផងបានដែរទេ ?
ខ្ញុំឈ្មោះ សាកឺរ៉ាដា ។
បាទ, ពួកយើងមានការកក់ទុកសំរាប់លោក ។
តើលោកនឹងស្នាក់នៅជាមួយពួកយើងរយៈពេលប៉ុន្មានដែរ ?
ពួកយើងមានបន្ទប់គ្រែមួយ ដែលមានបន្ទប់ទឹក រឺអាងទឹក ។
ខ្ញុំបានធ្វើការកក់ទុកបន្ទប់មួយជាមួយនិងបន្ទប់ទឹកតាមរយៈការិយាល័យទេសចរណ៍ទីក្រុងតូក្យូ ។
អញ្ចឹង សូមអញ្ជើញទៅបន្ទប់នោះ ។
តើគ្រែពីរមានតំលៃខុសគ្នាម៉េចដែរ ?
ពួកយើងចង់បានបន្ទប់មួយគ្រែពីរជាមួយនិងបន្ទប់ទឹក ។
មួយថ្ងៃ តំលៃ ប៉ែតសិបប្រាំដុល្លារ ។
គ្រាន់តែឈ្មោះរបស់អ្នក និងអាស័យដ្ឋានទៅបានហើយ ។
តើខ្ញុំអាចសុំផែនទីខ្លះ និងសៀវភៅណែនាំពីទីក្រុងនេះបានដែរទេ ?
លោក សាកឹរ៉ាដា, នេះជាសោរបន្ទប់របស់លោក ។ បន្ទប់របស់លោកគឺ ប្រាំពីររយសែសិបប្រាំពីរ នៅជាន់ទីប្រាំពីរ ។
អ្នកបំរើនឹងបង្ហាញពីបន្ទប់របស់អ្នក ។
នៅផ្លូវនេះ ។ សូមជិះជណ្តើរយន្តនេះ ។
ខ្ញុំភ្លេចសួរអ្នករឿងមួយ ។ តើអ្នកដឹងទេថា ម៉ោងចាកចេញនៅម៉ោងប៉ុន្មានដែរ ?
បាទ, នេះជាបន្ទប់របស់លោក ។
អរគុណ ។ សូមជួយដាក់វ៉ាល្លីរបស់ខ្ញុំ និងកាបូបរបស់ខ្ញុំនៅក្បែរគ្រែគេង ។
ហើយកន្លែងណាជាប៊ូតុងចុចថេរម៉ូស្តេធ ?
តើខ្ញុំត្រូវដាក់បោកអ៊ុតនៅកន្លែងណា ?
សូមដាក់ចូលក្នុងកន្ត្រកពណ៌លឿងនេះចុះ ។
អរគុណ ។ សូមស្នាក់នៅអោយសុខស្រួលចុះ ។
បាទ, តើខ្ញុំអាចជួយអ្វីអ្នកបានទេ ?
អ្នកអាចទូរស័ព្ទទៅផ្នែកសេវាកម្មបន្ទប់បានទេ ?
បាទ, ខ្ញុំនឹងធ្វើភ្លាមៗនេះ ។
នេះជាសេវាកម្មបន្ទប់ ។
ទីនេះជាបន្ទប់លេខ ប្រាំពីរ សែសិបប្រាំពីរ ។ តើលោកមានបំរើប្រភេទ ខុកថេលអ្វីខ្លះ ?
ពួកយើងមានប្រភេទ អាឡិចសេនដឺរ, ក្រេម ដឹ កូកូ, ម៉ាហ្ការីតា, ថមកូល្លីន, ហ្ក្រាសហ៊ូបផ័រ, ហើយនិងហ្កាល្លីណូ បន្ទាប់ពីភេសជ្ជៈពេលល្ងាច ។
ចាំខ្ញុំគិតសិន ។ ខ្ញុំយកក្រេម ដឹ កូកូមួយ, និងហ្កាល្លីណូដាក់ទឹកកកមួយ ។
បាទខ្ញុំដឹងហើយ ។ ខ្ញុំនឹងយកអោយលោកឥលូវនេះ ។
នេះជាការកុម៉្មង់របស់លោក ។ សូមជួយស៊ីញ៉េនៅលើវិកយប័ត្រនេះ ។
សូមចុចអោយខ្ញុំនូវលេខ បី បួន មួយ ប្រាំបួន ប្រាំមួយ ប្រាំបួន ប្រាំមួយ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទទៅកាន់កន្លែងឆ្ងាយ ។
ខ្ញុំចង់ហៅទូរស័ព្ទទៅឯនាយសមុទ្រ ។
តើលោកចង់ទូរស័ព្ទទៅប្រទេសណាដែរ ?
ទៅទីក្រុង អាល់កឺគ្យូ , ប្រទេសម៉ិចស៊ីកូ ។
ខ្ញុំនឹងភ្ជាប់អោយលោកទៅផ្ទាល់តែម្តង ។
ទៅទីក្រុង អ៊ីឈីហ្កាវ៉ា, ខេត្ត ឈីបា, ប្រទេសជប៉ុន ។
អាឡូ ។ ទីនេះជាប្រតិបត្តិករឯនាយសមុទ្រ ។ តើលោកត្រូវការទូរស័ព្ទទៅលេខប៉ុន្មានដែរ ?
ខ្ញុំចងហៅទូរស័ព្ទទៅ ទីក្រុង អ៊ីឈីហ្កាវ៉ា, ខេត្ត ឈីបា, ប្រទេសជប៉ុន ។ លេខកូដតំបន់គឺ សូន្យ បួន ប្រាំពីរ បី ។ លេខទូរស័ព្ទគឺ ប្រាំពីរ ពីរ ប្រាំ ប្រាំ ពីរ ប្រាំពីរ ។
បណ្តាញកំពុងជាប់រវល់ ។
អញ្ចឹង, ខ្ញុំនឹងទូរស័ព្ទទៅលោកម្តងទៀតនៅពេលក្រោយ ។ អរគុណ ។
សូមអភ័យទោស ។ ខ្ញុំចង់ដឹងពីព័ត៌មានខ្លះៗអំពីសណ្ឋាគារនេះ ។
ប្រាកដណាស់, តើលោកត្រូវការអ្វីដែរ ?
តើហាងកាហ្វេនៅឯណា ?
ពួកយើងមានពីរកន្លែង ។ មួយកន្លែងគឺនៅទីនោះ, ហើយមួយកន្លែងទៀតគឺនៅលើកន្លែងឡោនច៍ ។
ពួកយើងមានបន្ទប់បរិភោគអាហារពីរបន្ទប់ ។ បន្ទប់បរិភោគអាហារមួយដែលតូចនោះគឺនៅជាន់ផ្ទាល់ដី ។ បន្ទប់បរិភោគអាហារធំគឺនៅជិតហាងកាហ្វេលើឡោនច៍ ។
តើនៅបន្ទប់បរិភោគអាហារតូច ចាប់ផ្តើមអាហារពេលល្ងាច នៅម៉ោងប៉ុន្មាន ?
ចាប់ពីម៉ោងប្រាំកន្លះដល់ម៉ោងដប់ ។ បន្ទប់បរិភោគអាហារធំនឹងចាប់បើកនៅម៉ោងប្រាំពីរ ហើយបិទនៅម៉ោងដប់ ។
នៅក្នុងបន្ទប់បរិភោគអាហារធំ តើតំរូវអោយយើងពាក់ក្រវ៉ាត់ក និងអាវធំដែរទេ ?
តើអ្នកមានលក់តែមប្រៃសណីយ៍ដែរទេ ?
បាទ, លោកអាចទិញតែមជាច្រើនប្រភេទនៅម៉ាស៊ីនលក់អូតូម៉ាទិចនៅឡប់ប៊ី ។
បាទ, សំណួរចុងក្រោយ ។ តើបារនៅជាន់ទីប៉ុន្មាន ?
នៅជាន់ផ្ទាល់ដី ។ សូមរីករាយជាមួយពេលវេលារបស់អ្នក ។
អរុណសួស្តី ។ អញ្ជើញប៉ុន្មាននាក់ដែរ ?
បើអាចទៅរួច, ខ្ញុំចង់អង្គុយនៅតុមួយដែលនៅជិតមាត់បង្អួច ។
តើលោកប្រញាប់ដែររឺទេ ?
សូមលោករង់ចាំបន្តិច ។
តុដែលនៅជិតមាត់បង្អួចបានរៀបចំរួចរាល់អស់ហើយ ។ សូមអញ្ជើញមកតាមផ្លូវនេះ ។
ពួកយើងនៅមិនទាន់សំរេចចិត្តនៅឡើយទេ ។
ចាំខ្ញុំគិតមើលសិន ។ ខ្ញុំយកទឹកក្រូច, ហើយនិងសាច់ជ្រូកបីជាន់និងពង និងថូស ។
បាទ, ខ្ញុំយកទឹកប៉េងប៉ោះ, សាឡាដដំឡូង, ពងក្រឡុកជាមួយថូស ។
សាច់ជ្រូកបីជាន់ សុំអោយក្រៀម ។
សូមអោយឆ្អិនមួយចំហៀង ។
សូមចៀនឆ្អិនទាំងសងខាង ។
ឆ្អិនពាក់កណ្តាល ។
សូមស្ងោរអោយឆ្អិន ។
ខ្ញុំសូមកាហ្វេក្រាស់ ។
តើលោកត្រូវការកាហ្វេឥលូវដែរទេ ?
អត់ទេ, ចាំបន្តិចទៀត ។
ទូរទស្សន៍នៅក្នុងបន្ទប់របស់ខ្ញុំខូចហើយ ។
អ្នកបច្ចេកទេសនឹងទៅដល់ពេលឆាប់ៗនេះ ។
សូមជួយធ្វើអោយបន្ទប់នេះកក់ក្តៅបន្តិចមក ។
សូមរង់ចាំប្រហែលមួយម៉ោង ។ ឥលូវពួកយើងកំពុងជួសជុលម៉ាស៊ីនកំដៅ ។
តើមានកន្លែងណាអាចដោតឌុយម៉ាស៊ីនផ្លុំសក់បានដែរទេ ?
វាគឺនៅខាងក្រោមទូទូរទស្សន៍ ។ សូមកុំប្រើវាយូរពេក ។ ចំនួនវ៉ុលរវវាងប្រទេសជប៉ុន និងនៅទីក្រុងនេះមានភាពខុសគ្នា ។
វាគឺនៅខាងក្រោមកន្លែងលាង ។
គឺនៅតុកន្លែងទទួលភ្ញៀវ ។ ខ្ញុំបាននាំអ្នកបច្ចេកទេសទៅជួសជុលទូរទស្សន៍រួចហើយ ។
បន្តិចទៀតយើងនឹងត្រឡប់មកវិញ ។
ខ្ញុំ ណាហ្កៃស៊ី នៅបន្ទប់លេខ ដប់បួន ប៉ែតសិបប្រាំបី ។ ខ្ញុំចង់ចាកចេញនៅពេលព្រឹកស្អែក ។
តើម៉ោងប៉ុន្មានអ្នកចង់ចាកចេញ ?
ប្រហែលម៉ោងប្រាំបី ។
សូមជួយបញ្ជូនអ្នកបំរើមកកាន់បន្ទប់របស់ខ្ញុំលេខ ប្រាំពីរ សែសិបប្រាំ ។
នេះជាវិកយប័ត្ររបស់លោក ។ អស់ ពីររយប៉ែតសិបបួនដុល្លារ ។
ខ្ញុំបង់ប្រាក់ជាលុយសុទ្ធ ។
ខ្ញុំនឹងបង់ជាសែកអ្នកធ្វើដំណើរ ។
ដូច្នេះខ្ញុំនឹងបង់ចំនួន បីរយដុល្លារដោយសែក ។
ខ្ញុំដឹង ។ តើខ្ញុំសុំសោរបន្ទប់របស់អ្នកបានដែរទេ ?
នេះ ។ តើគេកំពុងយកវ៉ាលីសរបស់ខ្ញុំមកខាងក្រោមរឺ ?
បាទ, លោក, វ៉ាលីសរបស់លោកគឺនៅទីនោះហើយ ។
ជួយហៅតាក់ស៊ីអោយខ្ញុំបានទេ ?
អរគុណខ្លាំងណាស់ ។ សណ្ឋាគារនេះពិតជាអស្ចារ្យ ។
អរគុណ ។ សូមអញ្ជើញមកម្តងទៀត ។
តើអញ្ជើញមកប៉ុន្មាននាក់ដែរ ?
មួយក្រុមមានប្រាំនាក់ ។
សូមតុសំរាប់មនុស្សពីរនាក់ ។
តើនេះជាតុទំនេរមែនទេ ?
តើលោកអាចរង់ចាំបន្តិចបានដែរទេ ? ឥលូវតុពេញអស់ហើយ ។
ខ្ញុំសូមឈ្មោះលោកផង ? ខ្ញុំនឹងហៅលោកនៅពេលដែលពួកយើងមានតុ ។
លោក កាវ៉ាអ៊ី, ពួកយើងមានតុមួយសំរាប់លោកហើយ ។ សូមអញ្ជើញមកផ្លូវនេះ ។
តើអ្វីជាចំណុចពិសេសនៃភោជនីយដ្ឋាននេះ ?
នេះជាសាច់គោស្តេក ។
ម្ហូបម៉ិចសិក ។
សាច់មាន់ និង ឆ្អឹងជំនីជ្រូក ។
តើលោកចូលចិត្តឆ្អិនបែបណា ?
ហើយចុះសាឡាដវិញ ?
បាទ, ខ្ញុំត្រូវការសាឡាដបៃតង ។
ទឹកជ្រលក់អ៊ីតាលី ។
ទឹកជ្រលក់បារាំង ។
ទឹកជ្រលក់ថោសេន អាយឡេន ។
ហើយចុះស៊ុបវិញ ?
តើលោកត្រូវការភេសជ្ជៈអ្វីដែរ ?
ចាំមួយភ្លែត ។ សុំស្រាក្រហម ។
ខ្ញុំយកម៉ាកនេះ ។
តើអ្នកស្រាបៀរជប៉ុនទេ ?
អញ្ចឹងអោយសាប់ប៉ូរ៉ូ មកខ្ញុំមួយដប ។
ខ្ញុំនឹងយកប្រភេទអាហារសម្រន់ ។
បាទ , ខ្ញុំយកខុកថេលបង្គាមួយ ។
ខ្ញុំត្រូវការខុកថេលក្តាម ។
តើលោកត្រូវការបង្អែមដែរទេ ?
ខ្ញុំត្រូវការការ៉េមរសជាតិសូកូឡាផាហ្វេត ។
សួស្តី ។ នេះជាបញ្ជីមុខម្ហូប ។
សូមលោកអញ្ជើញហៅខ្ញុំនៅពេលដែលលោកសំរេចការកុម៉្មង់រួច ។
ខ្ញុំនៅមិនទាន់សំរេចនៅឡើយ ។
ខ្ញុំចង់សាកល្បងភ្លក់ម្ហូបនៅរដ្ឋនេះ ។
តើមានតារាងម្ហូប ដឹ ហ៊ូតដែរទេ ?
តើអ្នកមានអ្វីណែនាំខ្ញុំនៅម្ហូប ដឹ ហ៊ូត ដែរទេ ?
បើសិនជាលោកចូលចិត្តបរិភោគអាហារ, ខ្ញុំនឹងណែនាំលេខបី ។
ខ្ញុំចង់សាកអាហារនៅតំបន់នេះ ។
ខ្ញុំចង់សាកអាហារនៅខេត្តនេះ ។
ខ្ញុំចង់សាកអាហារនៅទីក្រុងនេះ ។
ខ្ញុំចង់សាកអាហារនៅកំពុងផែនេសាទនេះ ។
តើអ្នកមាន តារាងម្ហូប ដឹ ហ៊ូតដែរទេ ?
មានអាហារសមុទ្រដែរទេ ?
តើលោកមានឈុត អាឡាកាត ដែរទេ ?
ទំនងឆ្ងាញ់ ។ ខ្ញុំយកអាមួយហ្នឹងចុះ ។
ពិតជាឆ្ងាញ់មែន ។
អោយហេមប៊ឺរហ្គ័រខ្ញុំមួយ, ខ្ទឹមបារាំងបំពង និងស្រាបៀរ៉ូត ។
យើងមានខ្នាតធំ, កណ្តាល, និងតូច ។
យកខ្នាតមធ្យមទាំងអស់ ។
សាច់ក្រកទំហំកណ្តាល ចំនួនពីរ ។ ហើយនិងទឹកក្រូចកែវធំពីរ ។
សុំសាឡាដនិងដំឡូងកិន ។
តើមានត្រីចៀនដែរទេ ?
សុំទោស, ថ្ងៃនេះត្រីលក់អស់បាត់ហើយ ។
សុំឈុតអាហារ និងកាហ្វេ ។
តើទឹកជ្រលក់ម៉ាស្តាតនៅឯណា ?
អោយស្រាបឺរប៊នដាក់ទឹកកកខ្ញុំមួយកែវ ។
ចាំមួយភ្លែត ។ តើមានស្រាក្រឡុក បាកាឌី ។
ហើយយើងសុំកុម៉្មង់នំណីបន្តទៀតបានទេ ?
ខ្ញុំនឹងនាំយកម្ហូប ហស ដរ ។
សូមអភ័យទោស, កញ្ញា ខ្ញុំសូមមួយទៀត ។
ម្យ៉ាងទៀត, តើពេលណាការសំដែងចាប់ផ្តើម ?
វាចាប់ផ្តើមពីម៉ោង ប្រាំបួន ។
ខ្ញុំសុំកាហ្វេមួយកែវ ។
ខ្ញុំត្រូវការបិកយប័ត្រ ។
ទាំងអស់ សែសិបបី ដុល្លារ ។
នេះជាលុយអាប់ ។
ខ្ញុំគិតថា ខ្ញុំបានទទួលលុយអាប់ខុស ។
សុំទោស, នេះជាកំហុសរបស់ពួកយើង ។
តើអ្នកបញ្ចុះតំលៃអោយខ្ញុំបានដែរទេ ?
អត់ទេ, ខ្ញុំគ្រាន់តែមើលប៉ុណ្ណោះ ។ អរគុណ ។
សែសិបប្រាំមួយ ។ លុយសុទ្ធ រឺក្រេឌីតកាត ?
នេះជាលុយអាប់ ។
តើមានបារីដែរទេ ?
បាទ, តើលោកត្រូវការម៉ាកអ្វីដែរ ?
អោយម៉ាកកាតុងខ្ញុំមួយមក ។ យកអាវែង ។
បាទ, ខ្ញុំត្រូវការពិនិត្យលិខិតឆ្លងដែន ។
ចាំមួយភ្លែត ។ សំរាប់ប្រភេទ វីស្គី ខ្ញុំយក ជេកដានីញ៉ែល, ហើយចំពោះ ប្រ៊ែនឌីវិញ, ខ្ញុំយកម៉ាកណាប៉ុឡេអុង ។
តើអ្នកមានអ្វីជួយណែនាំខ្ញុំពីវត្ថុអនុស្សាវរីយ៍ពីប្រទេសអាមេរិកដែររឺទេ ?
ហើយចុះទំនិញចំលាក់ ?
ខ្ញុំចង់ទិញអ្វីមួយសំរាប់មិត្តប្រុសរបស់ខ្ញុំ ។
ខ្ញុំសូមណែនាំនូវមួកខោប៊យ រឺ ខ្សែក្រវ៉ាត់ ។
ខ្ញុំចង់ទិញអ្វីមួយសំរាប់មិត្តស្រីរបស់ខ្ញុំ ។
ខ្ញុំចង់ទិញអ្វីមួយសំរាប់ប្អូនប្រុសរបស់ខ្ញុំ ។
ខ្ញុំចង់ទិញអ្វីមួយសំរាប់កូនសិស្សនៅថ្នាក់មធ្យមរបស់ខ្ញុំ ។
ខ្ញុំចង់ទិញអ្វីមួយសំរាប់ប្រពន្ធរបស់ខ្ញុំ ។
ខ្ញុំចង់ទិញអ្វីមួយសំរាប់ប្ដីរបស់ខ្ញុំ ។
ខ្ញុំនឹងណែនាំក្រវិល រឺ កន្លាស់អាវ ។
ខ្ញុំនឹងណែនាំទឹកអប់ រឺ ឡេ ។
បាទ, ខ្ញុំកំពុងស្វែងរកអាវក្រៅ ។
តើអ្នកមានទំហំធំប៉ុនខ្ញុំដែរទេ ?
តើមានអ្វីដែលដូចអាមួយនេះដែរទេ ?
ខ្ញុំគិតថាវាដូចជាតឹងពេក ។
វាមើលទៅល្អសំរាប់លោកណាស់ ។
ខ្ញុំគិតថាវាដូចជារលុង ។
ខ្ញុំកំពុងរកខោជើងប៉ាត់ ។
ខ្ញុំកំពុងរកអាវរងា ។
ខ្ញុំកំពុងរកអាវ ។
ខ្ញុំកំពុងរកសំពត់ខ្លី ។
ខ្ញុំកំពុងរកឈុតប៉ានតាឡូន ។
បាទ, ខ្ញុំក៏គិតចឹងដែរ, ប៉ុន្តែ, ជើងខោដូចជាវែងស្លូពេក ។ តើអាចកាត់អោយខ្លីដែរទេ ?
បាទ, បានលោកស្រី ។ ពួកយើង នឹងធ្វើជូនលោកស្រីក្នុងរយៈពេលពីរថ្ងៃ ។
តំលៃគឺ បួនរយសាមសិបដុល្លារ, មែនទេ ? តើអាចបញ្ចុះថោកជាងនេះបន្តិចបានដែរទេ ?
តើលោកចង់បានប៉ុណ្ណា ?
អត់ទេ, ខ្ញុំកំពុងតែគណនា ។
ចាំមួយភ្លែត, ខ្ញុំនឹងបញ្ចុះតំលៃពិសេសជូនលោក, ត្រឹម បួនរយដុល្លារ ។
ល្អណាស់ ។ ខ្ញុំនឹងយកវា ។ អ្នកពិតជាមនុស្សល្អមែន ។
ខ្ញុំរីករាយណាស់ដែលលោកនិយាយបែបនេះ ។
ខ្ញុំចង់បានហ្វីលគូល័រទំហំ សាមសិបប្រាំមួយ ចំនួនបីដុំ ។
តើខ្ញុំអាចបញ្ចូលហ្វីលទៅក្នុងកាម៉េរ៉ារបស់លោកបានដែរទេ ?
បាទ, បាន ។ តើនេះជាហ្វីលផលិតផលរបស់ប្រទេសជប៉ុនមែនទេ ?
បាទ, ពួកយើងមានម៉ាក សាកឹរ៉ា និង ហ្វុជីនៅហាង ។
អោយខ្ញុំនៅហ្វីលភាពយន្តដែលមានទំហំដប់ប្រាំមួយមីលីម៉ែតជាមួយនិងទំហំសំលេងច្បាស់ ។
តើអ្នកមានហ្វីលសំរាប់ស្លាយគូល័រដែរទេ ?
សូមយកវានៅផ្សារទំនើប ។
សូមជួយផ្តិតហ្វីលនេះអោយខ្ញុំ ។
តើលោកត្រូវការទំហំប៉ុណ្ណាដែរ ?
កន្លែស្យាត់ធ័របិទហើយ ។
តើអាចជួសជុលវាបានទេ ?
តើកន្លែងណាជាកន្លែងផ្គត់ផ្គង់សំភារៈក្នុងផ្ទះ ?
សូមបង្ហាញខ្ញុំនូវស្បែកជើងកវែងដែលផលិតនៅប្រទេសអាមេរិក ។
តើផ្នែកកូនក្មេងនៅឯណា ?
តើផ្នែកគ្រឿងសំអាងនៅឯណា ?
តើផ្នែកសំលៀកបំពាក់នារីនៅឯណា ?
តើផ្នែកស្បែកជើងនៅឯណា ?
តើផ្នែកតុក្កតានៅឯណា ?
តើទំនិញដែលមានក្បូរក្បាច់មាននៅឯណា ?
ទាំងនេះជាប្រភេទផ្សេងៗគ្នា ។
ខ្ញុំអាចលបានទេ ?
វាដូចជាធំសំរាប់ខ្ញុំខ្លាំងណាស់ ។ តើមានអាតូចជាងនេះដែរទេ ?
តើអ្នកមានលក់ស្បែកជើងកែងទាបដែរទេ ?
បាទ, ចុះអាមួយនេះយ៉ាងម៉េចដែរ ?
ខ្ញុំគិតថា វាដូចជាតឹងបន្តិច ។
ប៉ុន្តែ វានឹងស្រួល បន្ទាប់ពីពាក់វាចូល ។
តើអ្នកមានស្បែកជើងមានស្នាមម្រាមជើងដែរទេ ?
ខ្ញុំនឹងដើរមុននឹងសំរេចចិត្ត ។ អរគុណ ។
បង្ហាញខ្ញុំពី ការងារស៊ែល ។
តើអ្វីទៅជាស៊ែល ?
វាគឺផ្នែកមួយនៃសំបកខ្យងចេញពីសមុទ្រការីប៊ីន ។
តើសៀវភៅគម្របស្បែកនេះ មានតំលៃប៉ុន្មានដែរ ?
តើចំលាក់នេះមានតំលៃប៉ុន្មានដែរ ?
តើគំនូរផុសនេះ មានតំលៃប៉ុន្មានដែរ ?
តើបន្តោងសោរនេះមានតំលៃប៉ុន្មានដែរ ?
តំលៃ ប្រាំមួយដុល្លារ សែសិបសេន ។
វាដូចជាថ្លៃបន្តិច ។
ខ្ញុំអាចទិញនៅកន្លែងផ្សេងមានតំលៃថោកជាងនេះ ។
បើអ្នកបញ្ចុះតំលៃអោយខ្ញុំ, ខ្ញុំនឹងទិញវា ។
បាទ, បើសិនជាលោកទិញចាប់ពីប្រាំពីរបន្តោងឡើងទៅ, ខ្ញុំនឹងធ្វើការបញ្ចុះតំលៃអោយលោក ដប់ភាគរយ ។
ហើយចុះបើទិញប្រាំវិញ ? ខ្ញុំមិនត្រូវការច្រើនទេ ។
តើចាបជ័រនេះមានតំលៃប៉ុន្មានដែរ ?
តើចានដែលមានការរចនានេះមានតំលៃប៉ុន្មានដែរ ?
លោកឈ្នះហើយ ។ ទិញប្រាំក៏បានដែរ ។
សូមអភ័យទោស, ប៉ុន្តែតើអ្នកជួយប្រាប់ផ្លូវខ្ញុំទៅ យ៉ូញៀន ស្ខែរ បានទេ ?
ទៅត្រង់ហើយបត់ស្តាំនៅកាច់ជ្រុងទីបី ។ លោកនឹងឃើញវានៅនឹងមុខរបស់លោក ។
ខ្ញុំកំពុងរក ហាងមួយហៅថា ឌីម៉ាហ្កូស ។
លោកអាចឃើញវា បើសិនជាលោកទៅកែងនោះ ។
នៅតំបន់នេះ មានហាងលក់ស្បែកជើងដែរទេ ?
វានៅផ្លូវឆ្លងខាងមុខ ។
តើធ្វើម៉េចទើបខ្ញុំអាចទៅមជ្ឈមណ្ឌលទំនិញ វ៉េសហ្គេត ?
ទៅផ្លូវធំបែកជាបួននៅកន្លែងនោះ រួចបត់ស្តាំ ។
ល្អណាស់ ។ ទៅផ្លូវនេះរហូតដល់ចប់ ។
សូមអភ័យទោស, ប៉ុន្តែខ្ញុំវង្វេងផ្លូវហើយ ។
បាទ, ខ្ញុំអាចជួយអ្នកបានទេ ?
តើលោកអាចចង្អុលប្រាប់នៅលើផែនទីនេះបានទេ ?
បា្រកដជាអាច, ពួកយើងឥលូវកំពុងនៅទៅនេះ ។
ខ្ញុំចង់ទៅផ្ទះសំណាក់ រ៉ាម៉ាដា ។
គឺនៅខាងស្តាំនៃអគារមុខនោះ ។ ដូច្នេះ,ត្រឡប់ទៅផ្លូវដដែល អ្នកបានមកដល់ រហូតដល់ ភ្លើងស្តុបចរាចរណ៍ ។ បន្ទាប់មក, បត់ទៅឆ្វេង ។
នៅឆ្ងាយដែរអត់ ?
មិននៅឆ្ងាយទេ ។ ប្រហែល ដប់ប្រាំនាទី ។
តើធ្វើម៉េចទើបខ្ញុំអាចជិះឡានក្រុងទៅទីក្រុងបាន ?
នៅទីនោះមានចំណតឡានក្រុងនៅពីមុខសណ្ឋាគារហ៊ីលតុន ។
តើឡានក្រុងលេខប៉ុន្មានចេញទៅផ្លូវ កូឡុមប៊ឺស ?
ជិះលេខ សែសិបពីរ ។
តើឡានក្រុងនេះទៅឧទ្យាន ហែដមែនទេ ?
អត់ទេ, អ្នកត្រូវបញ្ជូនប ន្ត ។ នេះជាសំបុត្របញ្ជូន ។
ចុះនៅចំណតខាងមុខ ។ បន្ទាប់មកជិះលេខ ប្រាំមួយ ។
ចុះទៅជាន់លើ ហើយនៅខាងឆ្វេងដៃ ។
តើឡានបន្ទាប់ដែលរហ័សទៅទីក្រុងឡុង នៅម៉ោងប៉ុន្មានដែរ ?
ឡានរហ័សបន្ទាប់នៅ មួយម៉ោងទៀត ។
អោយសំបុត្រ សំរាប់ តេហ្សេវ៉េទៅ លីយ៉ុន ចំនួនពីរសន្លឹក ។
តើខ្ញុំត្រូវចាំតេហ្សេវ៉ាទៅកាន់ទីក្រុងប៉ារីស នៅកន្លែងណា ?
វានឹងទៅដល់លេខពីរ, ដូច្នេះសូមមេត្តារង់ចាំ ។
តើច្រកមួយណាដែលចេញដំណើរទៅទីក្រុង ម៉ូនិច ?
ចេញពីច្រកលេខបី ។
ចំណតបន្ទាប់ដល់ណា ?
គឺនៅ ទីក្រុងម៉េនឆេសស្ទឺរ ។
សូមអោយសំបុត្រធ្វើដំណើរជុំវិញទៅកាន់ទីក្រុងរ៉ូម ចំនួនពីរសន្លឹកមក ។
លំដាប់លេខមួយ រឺលំដាប់លេខពីរ ?
លំដាប់លេខពីរបានហើយ ។
តើម៉ោងប៉ុន្មានទើបទៅដល់ទីក្រុងម៉ាឌ្រីដ ?
អត់ទេ, ខ្ញុំមិនគិតថាវានឹងមកទេ ។
សូមអភ័យទោស, តើខ្ញុំអាចញ៉ាំនៅលើរថភ្លើងបានដែរទេ ?
ខ្ញុំគិតថានៅលើរថភ្លើងនេះមានរថយន្តបរិភោគអាហារមួយ ហើយនិងហាងកាហ្វេមួយ ។
ខ្ញុំក៏ជាជនបរទេសដែរ, ដូច្នេះហើយលោកគួរតែសួរអ្នកយកលុយលើរថភ្លើង ។
តើខ្ញុំអាចប្ដូរលុយនៅទីនេះបានទេ ?
ខ្ញុំចង់ដូរលុយយ៉េនជប៉ុនទៅជាលុយដុល្លារ ។
បន្ទាប់មក, សូមមេតា្តបំពេញលិខិតបែបបទនេះហើយ សូមស៊ីញ៉េផង ។
តើលោកមានលុយប៉ុន្មានយ៉េនដែរ ?
ម្ភៃម៉ឺនយ៉េន ។
សូមលោកជួយគិតលុយចំនួនមួយរយដុល្លារតាមរយៈសែកអ្នកធ្វើដំណើរនេះផង ។
ខ្ញុំចង់គិតលុយតាមសែកអ្នកធ្វើដំណើរទាំងនេះ ។
សូមទៅមាត់បង្អួចទីប្រាំ ។
សូមលោកជួយគិតលុយចំនួនប្រាំរយដុល្លារតាមរយៈសែកអ្នកធ្វើដំណើរនេះផង ។
បាទ, ខ្ញុំមានលិខិតឆ្លងដែន ។
បាទ, ល្អណាស់ ។ តើលោកចង់បានយ៉ាងម៉េចដែរ ?
ខ្ញុំចង់បានក្រដាសហាសិប ចំនួនប្រាំបួនសន្លឹក , ក្រដាសម្ភៃ ចំនួនពីរសន្លឹក ហើយនិងក្រដាសដប់ មួយសន្លឹក ។
នេះលោក ។ សូមលោកអញ្ជើញពិនិត្យមើល ។
សូមជួយប្ដូរវិកយប័ត្រម្ភៃដុល្លារទៅជាវិកយប័ត្រតូចផង ។
តើលោកចង់បានយ៉ាងម៉េចដែរ ?
សុំមួយដុល្លារ ដប់សន្លឹក មួយដុល្លារ ប្រាំសន្លឹក ហើយនៅសល់លុយរាយ
ខ្ញុំចង់ផ្ញើកាតទាំងនេះទៅប្រទេសជប៉ុន ។ តើទាំងអស់មានតំលៃប៉ុន្មានដែរ ?
អស់ពីរដុល្លារ សែសិបសេន ។
ខ្ញុំចង់ផ្ញើសំបុត្រទាំងនេះទៅខេត្តយ៉ាម៉ាហ្គឹឈី, នៅប្រទេសជប៉ុន ។
តើលោកចង់ផ្ញើតាមរយៈយន្តហោះ រឺកប៉ាល់ ?
សូមជួយផ្ញើតាមរយៈយន្តហោះ ។
ទាំងនេះសុទ្ធតែជាខិតប័ណ្ណផ្សព្វផ្សាយ ។
បើផ្ញើលឿន ត្រូវចំណាយពេលប៉ុណ្ណាដែរ ?
បួន ទៅប្រាំថ្ងៃ ។
កញ្ចប់នេះជាសៀវភៅមួយក្បាល, ដូច្នេះហើយសូមជួយផ្ញើតាមកប៉ាល់ ។
ដូច្នេះសូមជួយបំពេញសំណុំបែបបទសេចក្តីប្រកាសពន្ធមួយនេះផង ។
តើខ្ញុំអាចដាក់ស្លាកឥវ៉ាន់នេះនៅកន្លែងណាបានដែរ ?
ទុកនៅកន្លែងណាដែលងាយស្រួលចំណាំ ហើយមើលឃើញ ។
វត្ថុទាំងនេះអាចបែកបាក់, ដូច្នេះហើយខ្ញុំត្រូវការការធានា ។
គិតបន្ថែមទាំងអស់គឺ ប្រាំពីរដុល្លារ ។
ខ្ញុំសុំតែមម្ភៃប្រាំសេន ចំនួនដប់ ហើយនិងតែមដប់សេន ចំនួនដប់ ។
ខ្ញុំកំពុងតែប្រមូលតែម, ដូច្នេះសូមអោយតែមប្រភេទផ្សេងៗមកខ្ញុំតាមតែអ្នកអាចធ្វើទៅបាន ។
សូមអ្នកជួយហៅនរណាម្នាក់ដែលនៅស្ថានកុងស៊ុលជប៉ុនអោយខ្ញុំផងបានដែរទេ ?
តើអ្នកអាចទូរស័ព្ទទៅនរណាម្នាក់នៅស្ថានទូតជប៉ុនអោយខ្ញុំបានទេ ?
សូមអភ័យទោស, ប៉ុន្តែតើនៅម្តុំនេះមានអ្នកជំនាញផ្នែកឱសថដែរទេ ?
វាពិតជាអាក្រក់មែន ។ ខ្ញុំនឹងទូរស័ព្ទទៅវេជ្ជបណ្ឌិត ហើយធ្វើការណាត់ជួបសំរាប់លោកភ្លាមៗនេះ ។
លោកវេជ្ជបណ្ឌិតនិយាយថាលោកអាចទៅឥលូវបាន ។ គ្លីនីកគឺនៅទល់មុខនឹងសណ្ឋាគារ ។
ខ្ញុំឈ្មោះ ណុហ្គឹឈី ។ ខ្ញុំទើបតែទូរស័ព្ទចេញពីសណ្ឋាគារ ។
ល្អណាស់ ។ សូមលោកជួយបំពេញក្រដាសនេះ ។ សរសេរឈ្មោះ, អាស័យដ្ឋាន, លេខទូរស័ព្ទ, និងអាយុរបស់លោក ។
តើខ្ញុំអាចសរសេរអាស័យដ្ឋាន និងលេខទូរស័ព្ទរបស់សណ្ឋាគារខ្ញុំបានអត់ ?
មិនអីទេ ។ តើលោកមានប្រតិកម្មនឹងជាតិគីមី រឺក៏ អាឡែហ្សីដែរទេ ?
បាទ អញ្ចឹង, សូមជួយបង់ថ្លៃចុះឈ្មោះ និងថ្លៃពិនិត្យជំងឺសំរាប់លើកដំបូងផង ។
លោកវេជ្ជបណ្ឌិតនឹងមកពិនិត្យមើលលោកឥលូវនេះ ។ សូមមេត្តារង់ចាំរហូតដល់យើងហៅលោក ។
បាទ, ហើយព្រឹកនេះខ្ញុំរាគពីរដងហើយ ។
តើម្សិលមិញលោកបានញ៉ាំអ្វី ?
ខ្ញុំបានញ៉ាំអាហារសមុទ្រនៅភោជនីយដ្ឋានអ៊ីតាលីមួយកន្លែង ។ បន្ទាប់មក, ខ្ញុំបានទៅបារ ហើយផឹកស្រាវ៉ីស្គីដាក់ទឹកកក ។
សូមដោះអាវរបស់លោកចេញ ។ ខ្ញុំចង់ស្តាប់លោក ។
ទម្រេតខ្លួននៅទីនេះ ។ ខ្ញុំក៏ចង់ធ្វើការពិនិត្យក្រពះរបស់លោក ។
ខ្ញុំគិតថាមកពីលោកផឹកច្រើនពេក ហើយបណ្តាលអោយលោកមានជំងឺផ្តាសាយ ខណៈពេលដែលលោកកំពុងគេង ។
កុំបារម្ភអី ។ ខ្ញុំនឹងចាក់ថ្នាំជូនលោក ។ ហើយលោកត្រូវទិញថ្នាំនេះនៅឱសថស្ថាន ។
ខ្ញុំមានបញ្ហាធ្មេញពុកមួយ ។ ខ្ញុំទ្រាំមិនបានទេ ។
បើកមាត់មក ។ ធ្មេញនោះបែកប្រហោងធំណាស់ ។
ខ្ញុំចង់ដកវាចេញ ។
ទេ, លោកមិនគួរដកវាចេញទេ ។
តើលោកស្នាក់នៅប្រទេសអាល្លឺម៉ង់រយៈពេលប៉ុន្មានហើយ ?
រយៈពេលមួយសប្ដាហ៍ ។
បន្ទាប់មក, ខ្ញុំនឹងអោយថ្នាំបំបាត់ការឈឺចាប់ ។ បន្ទាប់ពីត្រឡប់ទៅប្រទេសជប៉ុនវិញ តើលោកត្រូវធ្វើការព្យាបាលដែរទេ ?
នេះជាវេជ្ជបញ្ជារបស់លោក ។ យកវាទៅឱសថស្ថាន ហើយប្រើប្រាស់តាមហ្នឹងចុះ ។
ស្សេកស្ពៀរស៍ «ម៉ាកប៊េត» ។
តើនៅមានកន្លែងអង្គុយជាន់ទីមួយដែរទេ ?
កន្លែងអង្គុយនៅជាន់ទីពីរនៅមាន ។
ល្អ ។ អោយខ្ញុំពីរកន្លែងមក ។
អស់សាមសិបផោន ។
រឿង ដឹឃើតធេន បញ្ចាំងនៅម៉ោងប្រាំពីរ ។ វាបញ្ចប់នៅម៉ោងដប់ ។
ខ្ញុំចង់ខ្ចីវ៉ែនតាអូប៉េរ៉ា ។
វានៅជិតបន្ទប់ផ្លាស់ខោអាវ ។
ចន្លោះការសំដែងលើកទីមួយ និងការសំដែងលើកទីពីរ មានរយៈពេលប៉ុន្មានដែរ ?
តើទីតាំងកន្លែងអង្គុយនៅឯណា ?
កន្លែងអង្គុយរបស់លោកនៅជួរសេ, លេខប្រាំពីរ ។ សូមមកតាមផ្លូវនេះមក ។
តើអ្នកណាជាអ្នកដើរតួមុនគេ ?
គឺជាលោក អាធឺរ ម៉ុងហ្កូម៉េរី ។
អរគុណលោកច្រើនណាស់សំរាប់អ្វីៗគ្រប់យ៉ាង ។ បើសិនលោកមិនយល់ទាស់ទេ, លោកអាចនៅជាមួយខ្ញុំបាន ។
តើនៅល្ងាចនេះមានអ្វីបញ្ចាំងនៅរោងមហោស្រពសាន់ហ្រ្វាន់ស៊ីស្កូ ?
តើលោកដឹងដែរទេ ថាអ្នកណាកំពុងតែច្រៀង ?
អោយខ្ញុំគិតមើលសិន ។ អូ, គឺលោក ចននីខេសហ៍ ហើយនិងអ្នកនាង ខារផេនធឺរ ។
តើលោកចង់ស្តាប់ចម្រៀងរបស់ពួកគាត់ដែរទេ ?
បាទ, ប្រសិនបើមាន, ល្ងាចនេះ ខ្ញុំចង់បានកន្លែងនៅខាងមុខយ៉រមួយកន្លែង ។
បាទ, ខ្ញុំនឹងឆែកមើល ។
ពួកគេបាននិយាយថា កន្លែងអង្គុយទាំងអស់បានលក់ដាច់អស់ហើយ ។
អូអញ្ចឹង ? តើអាចមានកន្លែងអង្គុយពីរសំរាប់ពេលយប់ថ្ងៃស្អែកដែរទេ ?
បាទ, បាន ។ តើលោកត្រូវការកន្លែងអង្គុយនៅខាងមុខយ៉រមែនទេ ?
ខ្ញុំមិនយល់ទេ ។
លោកមិនចាំបាច់អរគុណខ្ញុំនោះទេ ។
ខ្ញុំជាជនជាតិជប៉ុន ។
ជួយនិយាយវាម្តងទៀតបានទេ ?
សូមអោយមានថ្ងៃល្អ ។
ខ្ញុំមិនសូវស្រួលខ្លួនទេ ។ ខ្ញុំមានជំងឺផ្តាសាយ ។
ជឿជាក់លើអ្វីដែលយើងកំពុងឃើញ ។
ខ្ញុំឈ្មោះ ហ៊ីរ៉ូមី ។
ខ្ញុំមកពីប្រទេសជប៉ុន ។
ខ្ញុំជាអ្នកទេសចរណ៍ ។
ខ្ញុំអាចនិយាយភាសាអង់គ្លេសបានតិចៗ ។
សូមនិយាយយឺតៗ ។
បុរសថ្លៃថ្នូរមិនមែនជាមនុស្សមានគ្រោះថ្នាក់ឡើយ ។
ខ្ញុំឈ្មោះតូម៉ូកូ ម៉ាអេបា ។
ខ្ញុំឈ្មោះម៉ារាអាន វ៉ីលលៀម ។
ខ្ញុំមកពីទីក្រុងតូក្យូ, ប្រទេសជប៉ុន ។
ខ្ញុំកំពុងតែធ្វើការនៅក្រុមហ៊ុនហ្សេ ។
បាទ, នេះជាដំណើរកំសាន្តលើកដំបូង ។
សូមស្នាក់នៅក្នុងប្រទេសនេះដោយក្តីរីករាយ ។
គ្មានវិធីសាស្ត្រល្អអស្ចារ្យណាដើម្បីរៀនទេ ។
អរគុណសំរាប់អំណោយ ។
ខ្ញុំចូលចិត្តប្រទេសនេះខ្លាំងណាស់ ។
ស្តោះហើយកុំលេបវិញ ។
សត្វចាបចាប់ដង្កូវស៊ីពេលព្រលឹម ។
ខ្ញុំសុំពឹងអ្នកមួយបានដែរទេ ?
តើលោកជួយខ្ញុំបានទេ ?
តើប្រើរបស់នេះរបៀបម៉េចទៅ ?
តើអ្នកអាចប្រាប់ខ្ញុំអំពីផ្លូវទៅសណ្ឋាគារហ៊ីលតុនបានអត់ ?
សូមជួយប្រាប់ខ្ញុំពីវិធីប្រើទូរស័ព្ទនេះផង ។
តើអ្នកអាចនិយាយភាសាអង់គ្លេសបានដែរទេ ?
តើអ្នកមិនចេះភាសាអង់គ្លេសទេរឺ ?
អាកាសធាតុថ្ងៃនេះយ៉ាងម៉េចដែរ ?
តើអ្នកដឹងពីការព្យាករណ៍អាកាសធាតុនៅថ្ងៃស្អែកដែរទេ ?
នេះជាថ្ងៃល្អ ។
ការប្រញាប់ធ្វើអោយខាតបង់ ។
មេឃមានដុំពពក ។
ខ្យល់ព្យុះទីហ្វុងនឹងវាយប្រហារទីក្រុងតូក្យូនៅល្ងាចនេះ ។
វាឡើងដល់ម្ភៃប្រាំដឺក្រេ ។
រដូវរងានេះ សំបូរព្រិលណាស់, ពិតមែនអត់ ?
រដូវផ្ការីកជារដូវដែលល្អជាងគេបំផុត ។
ការងារមនុស្សគ្រប់គ្នាមិនមែនជាការងាររបស់នរណាម្នាក់ទេ ។
ម៉ោងដប់មួយ កន្លះ ។
ម៉ោងប្រាំមួយ ដប់ប្រាំនាទី ។
មនុស្សអន់ ប្រើរបស់អន់
ខ្វះដប់ប្រាំនាទីម៉ោងបួន ។
តើថ្ងៃនេះជាថ្ងៃអ្វីនៃសប្ដាហ៍ ?
នេះជាថ្ងៃសុក្រ ។
វាគ្មានពេលទៀតទេ ។
ខ្ញុំនឹងទៅស្នាក់នៅកោះហាវៃរយៈពេលពីរសប្ដាហ៍ ។
តើថ្ងៃនេះជាថ្ងៃអ្វីនៃខែ ?
នៅថ្ងៃទីបី ខែឧសភា ។
តើថ្ងៃកំណើតរបស់អ្នកនៅពេលណា ?
គិតហើយសឹមគូរ ។
តើអ្នកមកដល់ទីនេះតាំងពេលណា ?
ខ្ញុំបានមកទីនេះតាំងពីម្សិលមិញ ។
គាត់ធ្វើអោយបែក ។
តើអ្នករស់នៅឯណា ?
ខ្ញុំរស់នៅទីក្រុងបាងកក ។
តក់ៗពេញបំពង់ ។
តើអ្នកកំពុងតែធ្វើអ្វី ?
ខ្ញុំកំពុងអានកាសែត ។
តើអ្នកចូលចិត្តមួយណាជាងគេ, កាហ្វេ រឺ តែ ?
ខ្ញុំចូលចិត្តតែជាងគេ ។
នាងនៅម៉ានីឡា ។
តើឡាននេះជារបស់អ្នកណា ?
វាជារបស់ខ្ញុំ ។
តើអ្នកបានជួបនឹងអ្នកណា ?
ខ្ញុំបានជួបកញ្ញា ខេយ៍ ។
ពីព្រោះគាត់ចេញទៅបាត់ហើយ ។
ខ្ញុំអាយុប្រាំបីឆ្នាំ ។
តើអ្នកមានកូនប៉ុន្មាន ?
ខ្ញុំមានកូនពីរនាក់ ។
វាមានប្រវែងប្រាំម៉ែត្រ ។
តើលោកនឹងស្នាក់នៅកោះហាវៃរយៈពេលប៉ុន្មាន ?
តើអ្នកជិះអ្វីទៅសាលារៀន ?
ខ្ញុំទៅសាលារៀនដោយជិះរថយន្តក្រុង ។
តើលោកគេងយប់មិញយ៉ាងម៉េចដែរ ?
តើលោកចូលចិត្តប្រទេសអូស្ត្រាលីយ៉ាងណាដែរ ?
តើអ្នកលក់ក្រួចទាំងអស់នេះ តំលៃប៉ុន្មានដែរ ?
មួយគីឡូក្រាម មួយដុល្លារ ។
តើមានកន្លែងអង្គុយនៅកន្លែងអត់ជក់បារីដែរទេ ?
ខ្ញុំព្រួយបារម្ភថាពួកយើងមិនមានអ្វីបើក ។
តើអ្នកអាចទុករបស់នេះអោយខ្ញុំបានទេ ?
តើខ្ញុំអាចប្ដូរកន្លែងអង្គុយនេះបានអត់ ?
កាសត្រចៀកនេះមិនដំណើរការទេ ។
ខ្ញុំរងារ ។ សូមជួយយកភួយអោយខ្ញុំមួយផង ។
អរុណសួស្តីអស់លោក លោកស្រី អ្នកនាងកញ្ញា ។ ប្រធានអ្នកបើកបរ លោក អឹអិដា និងអ្នកជំនួយការរបស់គាត់ លោក អាកាសាកា ចង់ស្វាគមន៍អស់លោកអ្នកដែលនៅលើជើងរហោះហើរ អ៊ឹមអូ របស់យើងខ្ញុំ ។ នេះជាការហោះហើរ សូន្យសូន្យប្រាំមួយ ឆ្ពោះទៅកាន់ទីក្រុងញ៉ូវយក ។ នៅពេលនេះ, សូមលោកអ្នកប្រាកដថាខ្សែក្រវ៉ាត់នៅកន្លែងអង្គុយរបស់លោកអ្នកត្រូវបានរឹតបន្តឹង និតបន្ទាប ហើយសូមបញ្ឈប់ការជក់បារីរហូតដល់ពេលស្លាកសញ្ញាត្រូវបានរលត់ ។
យើងនឹងឈប់នៅទីនេះប្រហែលមួយម៉ោង ។
សូមមេត្តារង់ចាំនៅកន្លែងឆ្លងកាត់ព្រលានយន្តហោះ ។
តើច្រកចេញដំណើរអ្វី ?
គឺច្រកលេខប្រាំពីរ ។
តើម៉ោងមកដល់ប្រហែលប៉ុន្មាន ?
នៅទីក្រុងម៉ាឌ្រីដ តើម៉ោងប៉ុន្មានហើយ ?
សូមជួយបំពេញកាតចុះចត និងបែបបទគយ ។
ប្រហែល ដប់ថ្ងៃ ។
វ៉ាលីទាំងអស់ដែលចេញពីការហោះហើរនេះ បានមកដល់អស់ហើយ ។
សូមជួយបើកប្រអប់នេះ ។
ទាំងនេះជារបស់ខ្ញុំ ។
វ៉ាលីធំមួយពណ៌ខៀវ ។
បត់ទៅខាងឆ្វេង ។
ប្រាប់ខ្ញុំពីអត្រានៅថ្ងៃនេះ ។
សូមជួយប្ដូរលុយនេះទៅជាលុយរាយ ។
សូមជួយគិតលុយតាមរយៈសែកអ្នកដំណើរនេះ ។
តើខ្ញុំអាចប្ដូរលុយយ៉េនជប៉ុននៅទីនេះបានទេ ?
មួយដុល្លារអាមេរិកស្មើនឹង មួយរយសាមសិបយ៉េន ។
តើអ្នកប្ដូរប៉ុន្មានដែរ ?
សូមជួយបំពេញបែបបទនេះ ។
តើរថយន្តក្រុងមួយណាទៅសណ្ឋាគារហ៊ីលតុន ?
ជិះរថយន្តលេខប្រាំ ហើយចុះនៅទល់មុខសណ្ឋាគារហ៊ីលតុន ។
សូមទៅសណ្ឋាគារស្សេរ៉ាថោន ។
តើចំណតរថយន្តក្រុងនេះនៅទីក្រុងមែនទេ ?
តើទៅទីក្រុងចំណាយពេលប៉ុន្មាននាទី ?
សួស្តី, ខ្ញុំឈ្មោះ កូយ៉ាម៉ា ។
នេះជាកាតបញ្ជាក់របស់ខ្ញុំ ។
សូមជួយបំពេញបែបបទនេះ ។
ខ្ញុំសុំទោសលោក ។ បន្ទប់ទាំងអស់ត្រូវបានគេកក់ទុកហើយ ។
ខ្ញុំបានកក់ទុកតាមរយៈភ្នាក់ងារទេសចរណ៍ ។
សូមអភ័យទោស, តើអ្នកអាចណែនាំសណ្ឋាគារណាមួយអោយខ្ញុំបានទេ ?
នេះជាសោរ ។ បន្ទប់លេខ បួន ដប់ប្រាំពីរ ។
ខ្ញុំចង់ផ្ញើរបស់នេះតាមរយៈយន្តហោះ ។
តើខ្ញុំអាចប្រើប្រអប់សុវត្ថិភាពនេះបានដែរទេ ?
បាទ, សូមលោកជួយបំពេញបែបបទនេះ ។
តើខ្ញុំមានរបស់មានតំលៃម្តងទៀតបានទេ ?
តើម៉ោងចាកចេញពេលណាដែរ ?
តើលោកជួយប្រកបឈ្មោះរបស់លោកបានដែរទេ ?
នេះជាវិកយប័ត្រ ។
ជាថ្លៃភេសជ្ជៈ ។
បង្គន់មិនអាចប្រើប្រាស់បាន ។
អំពូលភ្លើងនៅក្នុងបន្ទប់របស់ខ្ញុំមិនដំណើរការ ។
ម៉ាស៊ីនត្រជាក់ខូចហើយ ។
សូមជួយបើកម៉ាស៊ីនកំដៅនេះផង ។
ខ្ញុំត្រូវការការជួសជុល ។
ខ្ញុំបានធ្វើអោយបាត់សោរនៅកន្លែងណាមួយ ។
ខ្ញុំធ្វើអោយបែកអំពូលភ្លើងនៅក្នុងបន្ទប់របស់ខ្ញុំដោយអចេតនា ។
សូមសេវាកម្មបន្ទប់ ។
សូមជួយយកសាំងវ៉ិចសាច់ហេម ចំនួនពីរ និងតែក្រូចឆ្មារ ។
តើបន្ទប់របស់លោកលេខប៉ុន្មាន ?
ខ្ញុំព្រួយខ្លាច យើងនឹងបិទ ។
វាត្រូវចំណាយពេលប្រហែល សាមសិបនាទី ។
សូមជួយជំរះស្នាមប្រឡាក់ទាំងនេះចេញផង ។
ខ្ញុំត្រូវការបោកអ៊ុតខោអាវមួយនេះ ។
សូមជួយទូរស័ព្ទទៅក្រៅប្រទេស ។
ទូរស័ព្ទទៅកញ្ញា តូម៉ូកូ ម៉ាអិបា, ដែលមានលេខទូរស័ព្ទនៅអូសាកា គឺ ប្រាំមួយ បី ប្រាំពីរ ប្រាំមួយ បួន បី ប្រាំបី ប្រាំ ប្រាំមួយ ។
សូមរង់ចាំបន្តិចសិន ។
ខ្ញុំមិនប្រញាប់ទេ ។ ខ្ញុំនឹងទូរស័ព្ទទៅនាងពេលក្រោយ ។
តើអ្នកអាចផ្ញើសារបានទេ ?
ខ្ញុំនឹងតភ្ជាប់ទៅអ្នកឥលូវ ។
សួស្តី, តើខ្ញុំអាចនិយាយជាមួយកញ្ញា តូមូកូបានទេ ?
ពេលនេះនាងចេញទៅខាងក្រៅហើយ ។ ខ្ញុំអាចស្គាល់ឈ្មោះលោកបានទេ ?
តើខ្ញុំអាចសុំផែនទីនៅទីក្រុងនេះបានដែរទេ ?
សូមអ្នកជួយស្នើសុំភោជនីយដ្ឋានមួយដែលល្អផង ។
ពួកយើងចង់សាកញ៉ាំអាហារនៅក្នុងតំបន់ ។
សូមជួយធ្វើការកក់ទុកសំរាប់មនុស្សពីរនាក់ ម៉ោងប្រាំបីល្ងាច ។
តើរថយន្តក្រុងចេញចាប់ពីកន្លែងណា ពេលណា ?
តើអ្នកទៅយកនៅម៉ោងប៉ុន្មានដែរ ?
ពួកយើងចង់មើលការសំដែងនៅរោងមហោស្រព ។
តើអ្នកអាចយកសំបុត្រអោយពួកយើងបានដែរទេ ?
សូមជួយហៅតាក់ស៊ីដើម្បីទៅរោងមហោស្រព ។
ខ្ញុំមានឈ្មោះថា ហាម៉ាស៊ីម៉ា ។ ខ្ញុំធ្វើការកក់ទុក ។
ប្រសិនបើអាច, ខ្ញុំសុំកន្លែងដែលនៅជិតមាត់បង្អួច ។
តើអ្វីទៅជាចំនុចពិសេសរបស់ភោជនីយដ្ឋាននេះ ?
មានអ្វីអោយខ្ញុំជួយដែរទេ ? តើលោកត្រូវការអ្វីដែរ ?
ប៊ឺហ្គ័រមួយ និងទឹកស្ត្រប៊ឺរីក្រឡុកមួយកែវ ។
ពីរដុល្លារ ហាសិបសេន ។ តើលោកខ្ចប់មែនទេ ?
សុំទឹកក្រូចកូកាមួយកែវ
ខ្ញុំគិតថាលុយនេះខុសហើយ ។
សូមធ្វើវិក័យប័ត្រផ្សេងពីគ្នា ។
ទំហំប៉ុន្មានដែរ ?
តើកន្លែងផ្លាហ្សានោះមានឈ្មោះអ្វីដែរ ?
នៅវិហារគ្រិស្តនេះត្រូវបានសាងសង់ឡើងប្រហែល បួនរយឆ្នាំកន្លងទៅ ។
ពួកយើងនឹងឈប់នៅទីនេះរយៈពេល សែសិបនាទី ។
តើខ្ញុំអាចឡើងជិះនៅឯណាបាន ?
តើថ្លៃចូលទស្សនា តំលៃប៉ុន្មានដែរ ?
តើផ្ទាំងគំនូរ ពីកាសស្សូនៅកន្លែងណា ?
គឺនៅខាងក្រោយហាងសំអាងនៅជាន់ទីមួយ ។
តើខ្ញុំអាចថតរូបនៅទីនេះបានដែរទេ ?
នៅទីនេះមិនអនុញ្ញាអោយថតរូបឡើយ ។
តើខ្ញុំអាចថតរូបជាមួយអ្នកបានដែរទេ ?
ថតអោយជាប់អគារខាងក្រោយនេះ ។
ខ្ញុំនឹងផ្ញើររូបថតទៅអោយលោក ។
សូមប្រាប់ពីអាសយដ្ឋានរបស់លោកមក ។
នៅម៉ោងដប់, ប៉ុន្តែរោងមហោស្រពចាប់ផ្តើមបើកនៅម៉ោងប្រាំបួនកន្លះ ។
សូមជួយកក់ទុកសំរាប់មនុស្សពីរនាក់ នៅតយប់នេះ ។
ខ្ញុំសុំទោស ព្រោះថាវាលក់អស់ហើយ ។
តើថ្ងៃនេះជាថ្ងៃអ្វី ?
តើខ្ញុំមានកម្មវិធីអ្វីដែរទេ ?
រឿងនេះគឺរៀបចំឡើងដោយលោក កឹរ៉ូសាវ៉ា ។
ចង្វាក់ហ្សាក គឺជាការពេញនិយមរបស់មនុស្សវ័យក្មេង ។
សូមអញ្ជើញផ្លូវនេះ ។ តើលោកត្រូវការភេសជ្ជៈអ្វីដែរ ?
តើនៅទីនេះបិទនៅម៉ោងប៉ុន្មាន ?
តើកន្លែងរាំណាដែលពេញនិយមជាងគេ ?
តើនេះជាក្លឹបសមាជិកមែនទេ ?
ខ្ញុំចូលចិត្តក្បាច់ដែលអ្នករាំ ។
យប់នេះខ្ញុំមានពេលដ៏អស្ចារ្យ ។
ខ្ញុំគ្រាន់តែមើលទេ, អរគុណ ។
ប្រវែងវាដូចជាវែងពេក ។ មានអាខ្លីជាងនេះដែរទេ ?
សូមបង្ហាញអ្វីដែលនៅក្នុងបង្អួច ។
បើអ្នកបញ្ចុះតំលៃ ខ្ញុំនឹងទិញ ។
វាមិនត្រូវនឹងខ្ញុំទេ ។ សូមជួយបង្ហាញអាតូចជាងនេះអោយខ្ញុំមួយមក ។
សូមជួយយកស្រាស្កុតវីស្គីអោយខ្ញុំ បីដបមក ។
ខ្ញុំត្រូវការទឹកអប់មួយដែលក្រអូបជាងគេ ។
នៅជប៉ុន តើវាមានតំលៃប៉ុន្មានដែរ ?
វាមានតំលៃលើសប្រហែលបីដង ។
តើប្រើវាយ៉ាងម៉េចទេ ?
ជួយខ្ចប់វាផង ។
តើខ្ញុំត្រូវបង់ពន្ធដែរទេ បើសិនជាខ្ញុំទិញឥវ៉ាន់ទាំងនេះ ។
សូមជួយយក អ៊ិចផូស័រ សាមសិបប្រាំមួយ ចំនួនពីរដុំ ។
សូមជួយជួសជុលវាផង ។ តើនៅពេលទើបរួចរាល់ ?
បោះពុម្ភទំហំនេះ មួយទំហំមួយសន្លឹក ។
តើអោយខ្ញុំបង្ហាញអ្នកពីអ្វីដែរ ?
តើអ្នកមានចិញ្ជៀនត្បូងពេជ្រទេ ?
មានបញ្ហាមិនប្រក្រតីជាមួយនិងម៉ាស៊ីនថតនេះ ។
ពិលមិនដំណើរការ ។
តើរូបរាងវាធ្វើអំពីអ្វីដែរ ?
នេះមិនមែនជាទំហំរបស់ខ្ញុំទេ ។
ពួកយើងនឹងកែច្នៃវាឆាប់ៗនេះ ។
នេះជាកាតធានារ៉ាប់រង ។
ខ្ញុំរងា ។ ខ្ញុំក្អកមិនបាត់សោះ ។
វេជ្ជបណ្ឌិតបានចេញវេជ្ជបញ្ជាអោយមកខ្ញុំ ។
ខ្ញុំមានបញ្ហាអាឡាក់ហ្សី ។
សូមបង្ហាញខ្ញុំផង ។
ខ្ញុំប្រើយ៉ាងម៉េចដែរ ?
ផឹកថ្នាំម្សៅនេះ បន្ទាប់ពេលទទួលទានអាហារ, លេបថ្នាំគ្រាប់ជារៀងរាល់ប្រាំបីម៉ោងម្តង ។
ខ្ញុំត្រូវការជួរថយន្តតូចមួយរយៈពេល ដប់ថ្ងៃ ។
សូមជួយបង្ហាញប័ណ្ណបើកបររបស់លោក ។
ខ្ញុំចូលចិត្តរថយន្តអូតូ ។
នេះជាតារាងរថយន្ត និងតំលៃ ។
តើខ្ញុំអាចសងទៅវិញនៅទីក្រុងផ្សេងបានដែរទេ ?
ប្រសិនបើមានបញ្ហាអ្វី, សូមមេត្តាទូរស័ព្ទមកលេខនេះ ។
តើអ្នកអាចពិនិត្យមើលសាំង និងទឹកបានដែរទេ ?
រថយន្តរបស់ខ្ញុំមិនដំណើរការសោះ ។
ខ្ញុំមុតស្បែក ។
ហ្វ្រាំងជើងគឺមិនដំណើរការទេ ។
តើអ្នកអាចមកទីនេះធ្វើការជួសជុលបានដែរទេ ?
តើវាមានចំងាយប៉ុន្មានដែរពីទីនេះ ទៅស្ថានីយ៍សាំងបន្ទាប់នេះ ?
តើការជួសជុលមានតំលៃប៉ុន្មានដែរ ?
សូមឲ្យបង្កាន់ដៃមកខ្ញុំ ។
តើចំណតរថយន្តក្រុងនៅកន្លែងណាដែលត្រូវទៅអាកាសយានដ្ឋាន ?
តើនេះជាខ្សែរថយន្តទៅកាន់ទីក្រុង ឡូស អេនចេលេសមែនទេ ?
តើរថយន្តក្រុងណាមួយដែលខ្ញុំគួរតែជិះដើម្បីទៅស្ថានីយ៍ ?
លោកគួរតែជិះរថយន្តលេខប្រាំពីរ ។
តើខ្ញុំត្រូវដាក់កាក់ចូលនៅកន្លែងណា ?
សូមជួយដាក់ខ្ញុំចុះនៅផ្លូវ ហ្វីហ អេវ៉េនញ៉ូ ។
សូមជួយប្រាប់ខ្ញុំផងពេលដែលទៅដល់ទីនោះ ។
តំលៃនេះគឺចិតសិបប្រាំសេន ។ សូមជួយប្ដូរអោយបានត្រឹមត្រូវ ។
តើខ្សែណាមួយត្រូវទៅទីក្រុង អេទ័រ ?
តើកន្លែងណាដែលខ្ញុំអាចប្ដូរសំរាប់ល្ខោនអូប៉េរ៉ា ?
តើមានស្ថានីយ៍ប៉ុន្មានដែលត្រូវទៅទីក្រុង ឡូវ៉្រេ ?
តើផ្លូវចូលទៅសារមន្ទីរសិល្បៈជាតិ នៅកន្លែងណា ?
តើសំបុត្រជិះបានច្រើនដង មានតំលៃប៉ុន្មានដែរ ?
សំបុត្រនេះគ្មានសុពលភាពទៀតទេ ។
តើវាចេញពីវេទិកាមួយណា ?
តើការតភ្ជាប់ទៅទីក្រុងប៉ារីស នៅម៉ោងប៉ុន្មាន ?
សូមបង្ហាញសំបុត្រ ។
ទីនេះជាកន្លែងទទួលទានអាហារក្នុងឡានលេខប្រាំពីរ ។
ខ្ញុំចង់លុបចោលសំបុត្រនេះ ។
តើអោយខ្ញុំរៀបចំកន្លែងគេងសំរាប់អ្នកដែរទេ ?
ប្រសិនជាលោកត្រូវការអ្វី, សូមចុចកន្លែងប៊ូតុងនេះ ។
តើលោកធ្លាប់ធ្វើដំណើរតាមរយៈកប៉ាល់ដែរទេ ?
ខ្ញុំធ្វើដំណើរទៅទីក្រុងហុងកុង តាមរយៈកប៉ាល់នៅខែក្រោយ ។
នៅលើកប៉ាល់មហាសមុទ្រដ៏ធំមួយ អ្នកនឹងមានអារម្មណ៍ថាអ្នកនៅក្នុងសណ្ឋាគារដ៏ធំមួយ ។
តើខ្ញុំអាចឡើងជិះនៅកន្លែងណា ?
តើអនុញ្ញាតិអោយភ្ញៀវទាំងអស់ឡើងលើដែររឺទេ ?
តើនៅខាងក្នុងរថយន្តជានាវាអ្វី ?
វាពិតជាសប្បាយរីករាយមែន ។
កប៉ាល់នេះធ្វើដំណើរក្នុងល្បឿន សាមសិបបួនចុចហាសិបពីរ ម៉ៃក្នុងមួយម៉ោង ។
ខ្ញុំមានអារម្មណ៍ថាឈឺហើយ ។ តើគ្រូពេទ្យនៅលើកប៉ាល់នេះនៅឯណា ?
ទឹកសមុទ្រថ្លាដូចកញ្ចក់ ។
តើវាមានរួមមានអ្វីខ្លះ ?
បញ្ហាផ្ទាល់ខ្លួនរបស់ខ្ញុំនិងបញ្ហាបោះពុម្ភ ។
ខ្ញុំសុំទំរង់បែបបទសំរាប់ទូរលេខ ។
ខ្ញុំចង់ផ្ញើទូរលេខមួយ ។
តើសំបុត្រមួយសន្លឹកបញ្ជូនទៅប្រទេសជប៉ុនតំលៃប៉ុន្មានដែរ ?
សូមផ្ញើខ្ញុំនូវគំរូមួយ ។
តើខ្ញុំអាចណាត់ជួបបានដែរទេ ?
ខ្ញុំអាចមកដល់នៅម៉ោង ពីរ ។
ល្អ, អញ្ចឹងខ្ញុំទុកចិត្តលើលោកហើយ ។
អោយខ្ញុំសុំមើលសៀវភៅម៉ូដសក់សិន ។
សូមជួយធ្វើតាមអោយដូចម៉ូដនេះផងណា ។
ខ្ញុំចង់អ៊ុតសក់រួញ ។
ខ្ញុំចង់កក់សក់ និងធ្វើម៉ូដ ។
សូមកាត់វាអោយខ្លីបន្តិច ។
ទឹកក្តៅខ្លាំងណាស់ ។
ខ្ញុំចង់ជួបលោក វីលីម ។
សូមអញ្ជើញអង្គុយ ហើយមេត្តារង់ចាំបន្តិចសិន ។
គាត់កំពុងតែប្រជុំ ។
នេះគឺលោក ក្លាហ្វ ម៉ៃឃ៊ែល, ជាអនុប្រធាននាយកប្រតិបត្តិរបស់ពួកយើង ។
ពួកយើងធ្វើជំនួញនៅក្នុង ហុកសិបប្រាំប្រទេស ។
លោកមានខ្សែបណ្តាញល្អមែនទែន ។
សេដ្ឋកិច្ចពិភពលោកកំពុងធ្លាក់ចុះ ។
ស្ថានភាពនេះគឺដំណើរការទៅសន្សឹមៗ ។
ទីផ្សាររូបិយវត្ថុគ្មានស្ថេរភាព ។
ពួកយើងកំពុងតែធ្វើការជំរុះចេញនូវរបាំងពាណិជ្ជកម្មបន្តិចម្តងៗ ។
អត្រាការប្រាក់ខ្ពស់កំពុងធ្វើអោយពួកយើងពិបាក ។
ពួកយើងមាន ភាគហ៊ុនទីផ្សារចំនួន សាមសិបភាគរយ ។
ពួកយើងមានកិច្ចព្រមព្រៀងអាជ្ញាប័ណ្ណនៅប្រទេសម៉ិចស៊ីកូ ។
តើគំរោងទីផ្សាររបស់លោកយ៉ាងណាហើយ ?
ពួកយើងកំពុងតែបង្កើតផលិតផលថ្មីៗ ។
តើថវិកាផ្សព្វផ្សាយពាណិជ្ជកម្មរបស់លោកមានប៉ុន្មានដែរ ?
ថ្ងៃនេះខ្ញុំមានក្តីសោមន្សរីករាយណាស់ដែលបានទទួលស្វាគមនអស់លោកនៅទីនេះ ។
ខ្ញុំមានក្តីសោមន្សរីករាយជាខ្លាំងដែលបាននិយាយពាក្យមួយចំនួនដើម្បីស្វាគមន៍ទៅកាន់លោក វីលី្លម ។
ខ្ញុំមិនដឹងថាគួរតែអរគុណអ្នកយ៉ាងណាដែលអ្នកបានប្រារព្វពិធីជប់លៀងស្វាគមន៍អោយខ្ញុំ ។
ថ្ងៃនេះតាងនាមខ្ញុំជំនួសអោយអ្នកគ្រប់គ្នានៅទីនេះ, ខ្ញុំចង់ប្រាប់ថាពួកយើងមានសេចក្តីរីករាយបំផុតដែលបានជួបលោកម្តងទៀត ។
សូមអញ្ជើញអង្គុយជាមួយពួកយើង ហើយស្រស់ស្រូបអាហារនិងភេសជ្ជៈជាមួយគ្នាក្នុងពេលវេលាដ៏ល្អ ។
ខ្ញុំសូមលើកកែវមួយដើម្បីលោក វីល្លីម របស់យើង ។
ឥលូវចាប់ផ្តើម និងផ្តល់អោយអ្នកនិយាយទាំងអស់ធ្វើការគាំទ្រពួកយើង ។
ខ្ញុំចង់ស្វាគមន៍អ្នកទាំងអស់គ្នានៅទីនេះសំរាប់ការជួបជុំគ្នាប្រចាំឆ្នាំលើកទី៣ មួយពាន់ប្រាំបួនរយកៅសិបមួយ ។
ខ្ញុំសង្ឃឹមថាអ្នកនឹងរីករាយការបង្រៀនរបស់គាត់ ហើយទទួលបាននូវអ្វីដែលអាចជួយអោយជីវិតរបស់អ្នករីកចំរើន ។
តោះ នាំគ្នាហែលទឹក ។
តើបន្ទប់ផ្លាស់សំលៀកបំពាក់នៅកន្លែងណាដែរ ?
កុំធ្វើអោយចូលដល់ស្ថានភាពដែលអ្នកមិនអាចធ្វើអ្វីបាន ។
ខ្ញុំរមួលក្រពើជើង ។
តើខ្ញុំអាចខ្ចីទូកពោងមួយនៅទីនេះបានដែរទេ ?
តើយើងអាចទៅជិះរលកបាននៅកន្លែងណាដែរ ?
តើកន្លែងជិះរលកខ្ពស់ប៉ុណ្ណាដែរ ?
ខ្ញុំចង់ឃើញផ្កាថ្មនិងត្រី ។
ខ្ញុំចង់រៀនជិះទូកក្តោង ។
វាពិតជាព្រះអាទិត្យលិចដ៏ស្អាតមែន មែនដែរទេ ?
ខ្ញុំចង់យកមេរៀនមួយនៅឯសាលាបង្រៀនជិះស្គី ។
តើកន្លែងជិះស្គីដែលល្អជាងគេបំផុតសំរាប់អ្នកជិះដំបូងនៅកន្លែងណាដែរ ?
តើខ្ញុំអាចរកទិញសំបុត្រសំរាប់ជិះលើកៅអីខ្សែពួរនៅកន្លែងណាដែរ ?
អ្នកអាចទៅទីនោះដោយប្រើកៅអីខ្សែពួរបីប្រភេទ ។
តើមានអាហារនៅកន្លែងសម្រាកជិះស្គីក្បែរជម្រាលភ្នំនោះដែរទេ ?
តើអ្នកបានជិះស្គីអស់រយៈពេលប៉ុន្មានហើយ ?
ការជិះស្គីគឺជាកីឡាដែលគួរអោយរំភើប មែនដែរទេ ?
តើអ្នកអាចនាំខ្ញុំទៅកន្លែងជិះស្គីលើទឹកកកបានដែរឬទេ ?
តើអ្នកអាចក្រោកឈរបានដែរទេ ?
សព្វថ្ងៃនេះ មនុស្សរាល់គ្នាឡើងភ្នំ ។
ខ្ញុំបានឡើងភ្នំម៉ុងប្ល៉ង់ដោយកន្ត្រកខ្សែពួរនៅឯប្រទេសស្វីសកាលពីឆ្នាំមុន ។
តើភ្នំម៉ុងប្ល៉ង់ខ្ពស់ប៉ុណ្ណាដែរ ?
វាមានកំពស់ប្រហែលបួនពាន់ប្រាំបីរយហាសិបម៉ែត្រ ។ វាគឺជាចំណុចមួយក្នុងចំណោមចំណុចដែលខ្ពស់បំផុតក្នុងជួរភ្នំអាល់នៃប្រទេសស្វីស ។
តើយើងត្រូវដើរយូរប៉ុណ្ណាទៀត ?
មាននៅសល់ប្រហែលដប់គីឡូម៉ែត្រទៀតមុនទៅដល់គោលដៅរបស់យើង ។
ព្រិលធ្វើអោយផ្លូវដើររអិល ។
ខ្ញុំអស់កំលាំងខ្លាំងណាស់ ហើយបែកញើសជោគ ។
វាពិតជាកន្លែងដ៏ល្អមួយសំរាប់មកបោះជំរុំ ។
ថែរក្សាខ្លួន ដោយសារតែអាកាសធាតុគឺផ្លាស់ប្ដូរខ្លាំងណាស់នៅលើភ្នំ ។
ពួកយើងចង់លេងតេនីសថ្ងៃនេះ ។
តើអ្នកមានកន្លែងទំនេរនៅពេលណាដែរ ?
តើខ្ញុំអាចខ្ចីកូនបាល់ និងរ៉ាកែតមួយសំរាប់វាយសីបានដែរទេ ?
តើវាថ្លៃប៉ុន្មានក្នុងមួយម៉ោង ?
ខ្ញុំជាអ្នកដំបូង ដូចដែលអ្នកបានដឹងហើយ ។
ខ្ញុំទាយថាអ្នកគឺជាកីឡាករដ៏ល្អម្នាក់ ។
តើអ្នកជ្រើសរើសអ្នកណាធ្វើជាដៃគូរបស់អ្នក ?
ខ្ញុំនឹងលេងបន្តទៅមុខ ។
តើអ្នកចង់លេងកីឡាមួយជាមួយគ្នាបានដែរឬទេ ?
មួយឈុតគឺជាការប្រកួត មែនទេ ?
យើងចង់លេងកីឡាវាយកូនគោល ។
តើយើងអាចចាប់ផ្តើមនៅម៉ោងប៉ុន្មានដែរ ?
តើគេមានកូនឡានអេឡិចត្រូនិចដែរទេ ?
តើខ្ញុំអាចខ្ចីប្រដាប់វាយកូនគោលមួយឈុតពេញបានដែរទេ ?
ខ្ញុំចង់ខ្ចីកូនទូចាក់សោរមួយ ។
ដល់វេនរបស់អ្នកហើយ ។
អ្នកអាចចាប់លេងកូនគោលមុនគេ បើអ្នកចង់ ។
អូរ ទេ ខ្ញុំវាយបញ្ឆិតកូនបាល់ទៀតហើយ ។
ខ្ញុំវាយវៀចទៅខាងឆ្វេងទៀតហើយ ។
អរគុណអ្នកខ្លាំងណាស់ដែលបានអញ្ជើញខ្ញុំថ្ងៃនេះ ។
ខ្ញុំរីករាយណាស់ដែលអ្នកអាចមកបាន ។
មើលទៅដូចជាអ្នករាល់គ្នានៅទីនេះ ។
សូមធ្វើអោយដូចអ្នកនៅផ្ទះខ្លួនឯង ។
តើអ្នកចង់បានភេសជ្ជៈអ្វីដែរ ?
សូមយកអោយច្រើនតាមតែអ្នកចង់ ។
អូរ វាយឺតខ្លះទៅហើយ ។ ខ្ញុំគិតថាខ្ញុំគួរតែទៅ ។
អរគុណសំរាប់ការទទួលរាក់ទាក់ដ៏ល្អរបស់អ្នក ។
ខ្ញុំបានរីករាយដោយខ្លួនឯងណាស់ ។
មិនមានអ្វីជាពិសេសទេ តែខ្ញុំចូលចិត្តភ្លេងខ្លាំងណាស់ ។
ការកំសាន្តរបស់ខ្ញុំគឺការស្ទូចត្រី ។
តើអ្នករៀនភាសាអង់គ្លេសរយៈពេលប៉ុន្មានហើយ ?
តើអ្នកគិតថាវិធីដ៏ល្អបំផុតក្នុងការរៀនភាសាបរទេសជាអ្វីទៅ ?
វិធីដ៏ល្អគឺទៅរស់នៅក្រៅប្រទេស ។
សូមអោយខ្ញុំគិតមួយរយៈ ។
តើខ្ញុំអាចនិយាយជាមួយអ្នកពីបីនាទីបានដែរទេ ?
គ្រឿងអេឡិចត្រូនិចថោកណាស់ តែថ្លៃអាហារនិងថ្លៃផ្ទះគឺខ្ពស់ខ្លាំងណាស់ ។
កម្មករជាច្រើនធ្វើដំណើរទៅកាន់កន្លែងធ្វើការរបស់ពួកគេ ហើយវាចំណាយពេលមួយ ទៅពីរម៉ោង ។
ការសិក្សាជាកាតព្វកិច្ចគឺ ប្រាំមួយឆ្នាំនៅសាលាបឋមសិក្សា និង បីឆ្នាំនៅអនុវិទ្យាល័យ ។
អ៊ីគេបាណាគឺជាសិល្បៈនៃការរៀបចំផ្កា ។
កាបឹគីគឺជាល្ខោនបុរាណសំដែងលើឆាកដោយមនុស្សប្រុស ។
ពុទ្ធសាសនាបង្រៀនមនុស្សពីរបៀបបង្កើតគំនិតដែលសន្តិភាពជានិរន្តកម្ម ។
មុខងារតួនាទីរបស់ស្ត្រីបានរីកចំរើនគ្រាន់បើជាងពីមុន បើទោះបីជាបុរសនៅតែមានមុខងារតួនាទីគ្របដណ្តប់ក្នុងសង្គមក្តី ។
សូស៊ីគឺជាដុំបាយតូចរាងទ្រវែងរុំពីលើដោយត្រីឆៅបន្ទះ ឬសាច់ខ្ចងឬគ្រំជាដើម ។
សូម៉ូគឺជាកីឡាបោកចំបាប់ជប៉ុនដែលប្រកបដោយការគោរព ។
អូរីហ្គាមីគឺជាសិល្បៈបុរាណជប៉ុនដែលបត់ក្រដាស់អោយទៅជារូបរាងផ្សេងៗ ។
យើងដោះស្បែកជើងរបស់យើងចេញនៅច្រកទ្វារចូលផ្ទះ ។ វាគឺជាទំនៀមទម្លាប់របស់ជប៉ុន ។
មិនមានគ្រែនៅក្នុងបន្ទប់ ។ ពេលយើងគេង យើងក្រាលភួយក្រាស់ហ្វឹទុននេះនៅលើកំរាលតាតាមី ។
ប្រទេសជប៉ុនឈានមុខគេនៅក្នុងពិភពលោកក្នុងការថែរក្សាសុវតិ្ថភាពសាធារណៈ ។
ដោះខោអាវរបស់អ្នកចេញសំរាប់ធ្វើការពិនិត្យ ។
យកវេជ្ជបញ្ជាទិញថ្នាំនេះទៅកាន់ហាងលក់ថ្នាំ ។
សូមពិសារអាហារដែលងាយស្រួលកិនរំលាយតាមដែលអាចធ្វើបាន ។
តើខ្ញុំត្រូវទទួលការព្យាបាលពិសេសណាទេ ?
ខ្ញុំនឹងវាស់សីតុណ្ហភាពរបស់អ្នក ។
គេងសំរាកដោយស្ងៀមស្ងាត់រយៈពេលពីរបីថ្ងៃ រហូតដល់សីតុណ្ហភាពរបស់អ្នកចុះ ។
ភ្នែករបស់ខ្ញុំឡើងក្រហមងាំង ។
ខ្ញុំឈឺត្រចៀក ។
ខ្ញុំក្អកស្លេស ។
កន្លែងធ្មេញប៉ះរបស់ខ្ញុំខូច ។
ខ្ញុំរលាកភ្លើង ។
ជួយខ្ញុំផង ។ ខ្ញុំត្រូវបានចោរប្លន់ ។
កាបូបលុយរបស់ខ្ញុំត្រូវបានគេលួចនៅតាមផ្លូវ ។
គេលួចកាបូបរបស់ខ្ញុំពេលដែលខ្ញុំកំពុងហៅទូរស័ព្ទ ។
សូមទូរស័ព្ទហៅប៉ូលីស ។
លុយនិងលិខិតឆ្លងដែនរបស់ខ្ញុំ ត្រូវបានគេលួច ។
មនុស្សប្រុសពីរនាក់បានលួចកាបូបដៃពីខ្ញុំ ។
ខ្ញុំត្រូវបានគេភ្ជង់នឹងចុងកាំបិត ។
សូមពន្យល់ពីវាម្តងទៀត ។
សូមទូរស័ព្ទទៅស្ថានទូតជប៉ុន ។
តើអ្នកអាចហៅអ្នកណាម្នាក់ដែលនិយាយភាសាជប៉ុនបានដែរឬទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីរបៀបធ្វើវាឡើងវិញបានដែរឬទេ ?
សូមរាយការណ៍អំពីការបាត់លិខិតឆ្លងដែនរបស់អ្នក ។
សូមប្រាប់ស្ថានកុងស៊ុលជប៉ុន បន្ទាប់ពីអ្នកបានរាយការណ៍វាទៅប៉ូលីស ។
ខ្ញុំមិនដឹងថាតើខ្ញុំធ្វើអោយវាបាត់ ឬក៏វាត្រូវបានគេលួច ។
បើអ្នករកវាឃើញ សូមប្រាប់អោយខ្ញុំដឹងផង ។
ធ្វើអោយតាមសម្រួល ។ ព្យាយាមចងចាំវា ។
ជ្រលក់កន្សែងរបស់អ្នកទៅក្នុងទឹក ហើយដាក់វាលើច្រមុះនិងមាត់របស់អ្នក ។
តោះ នាំគ្នាចាំដើម្បីអោយគេជួយ ។
តើនេះគឺជាក្រុមហ៊ុនអាកាសចរណ៍យូណាយធីតអ៊ែរឡាញឬ ? ខ្ញុំចង់បញ្ជាក់ឡើងវិញនូវការកក់លើជើងហោះហើររបស់ខ្ញុំ ។
ខ្ញុំនឹងជិះជើងហោះហើរលេខម្ភៃបីរបស់ក្រុមហ៊ុនអាកាសចរណ៍យូណាយធីតអ៊ែរឡាញ ទៅទីក្រុងសាន់ប្វ្រាន់ស៊ីស្កូនៅថ្ងៃទីសាមសិបមួយខែកក្កដា ។
តើអ្នកបានធ្វើការកក់របស់អ្នកនៅពេលណាដែរ ?
ខ្ញុំមិនឃើញឈ្មោះរបស់អ្នកក្នុងបញ្ជីកក់នេះទេ ។
ខ្ញុំបានធ្វើការកក់នៅពេលដែលខ្ញុំទិញសំបុត្រយន្តហោះនៅឯទីក្រុងអូសាកា ។
សូមមកយ៉ាងហោចណាស់មួយម៉ោងមុនការចេញដំណើរ ។
តើអ្នកអាចពិនិត្យមើលវាម្តងទៀតបានដែរទេ ?
ខ្ញុំមានវាឥឡូវនេះ ។ កៅអីរបស់អ្នកគឺត្រូវបានបញ្ជាក់ហើយសំរាប់ជើងហោះហើររបស់ក្រុមហ៊ុនអាកាសចរណ៍យូណាយធីតអ៊ែរឡាញ លេខហុកសិបពីរធ្វើដំណើរទៅទីក្រុងសាន់ប្វ្រាន់ស៊ីស្កូ ។
តើខ្ញុំអាចសុំលេខទំនាក់ទំនងរបស់អ្នកនៅក្នុងស្រុកបានដែរទេ ?
ខ្ញុំគិតថាខ្ញុំនឹងអានកាសែតមួយ ។
ខ្ញុំមានគំរោងទិញវត្ថុអនុស្សាវរីយ៍ ។
ខ្ញុំមានគំរោងរៀនលេងវាយកូនគោល ។
ខ្ញុំមានគំរោងកុម្ម៉ង់អាហារពេលយប់ ។
ខ្ញុំគិតថាយើងនឹងរាំ ។
ពួកគេមានគំរោងក្នុងការស្នាក់នៅ ។
ខ្ញុំគិតថាខ្ញុំនឹងទៅគេង ។
ខ្ញុំត្រូវការហៅទូរស័ព្ទទៅផ្ទះ ។
ខ្ញុំត្រូវការធ្វើការកក់ ។
ខ្ញុំត្រូវការផ្ញើប័ណ្ណប្រៃសណីយ៍មួយ ។
សូមស្តាប់ដោយប្រុងប្រយ័ត្ន ។
គាត់ត្រូវការទៅទិញអីវ៉ាន់ ។
ខ្ញុំចង់បានសំបុត្រថ្មី ។
ខ្ញុំចង់ប្ដូរគម្រោងពេលរបស់ខ្ញុំ ។
ខ្ញុំចង់បញ្ជាក់ឡើងវិញនូវជើងហោះហើរមួយ ។
គាត់ចង់បានភួយមួយ ។
ពួកគេចង់អោយរបស់នោះត្រលប់ទៅវិញ ។
នាងចង់បានស្រាបៀរ ។
យើងត្រូវការគ្រែមួយបន្ថែម ។
ខ្ញុំត្រូវការអោយហៅទូរស័ព្ទដាស់ ។
ខ្ញុំត្រូវការតុដែលធំជាងនេះមួយ ។
ខ្ញុំត្រូវការបន្ទប់មួយ ។
គាត់ត្រូវការកាត់សក់ ។
ពួកគេត្រូវការមគ្គទេសក៍ម្នាក់ ។
ខ្ញុំមិនមានគំរោងក្នុងការបង់លុយទេ ។
អ្នកមិនចាំបាច់ចុះហត្ថលេខាទេ ។
ខ្ញុំមិនចង់ចាំទេ ។
អ្នកមិនចាំបាច់មានក្រវ៉ាត់កទេ ។
វាគឺមិនចាំបាច់ទេ ។
ពួកគេមិនចង់ធ្វើអញ្ចឹងទេ ។
អ្នកនឹងបង់លុយឬ ?
តើយើងសំរេចដោយរបៀបណាទៅ ?
នាងត្រូវទៅជាមួយឬ ?
ហេតុអ្វីបានជាខ្ញុំត្រូវផ្លាស់ប្ដូរ ?
តើខ្ញុំត្រូវយកអ្វីដែរទៅ ?
ពួកគេចង់ដូរប្រាក់ ?
តើអ្នកចង់ជួបពេលណាដែរ ?
តើអ្នកចង់ញុំានៅកន្លែងណាដែរ ?
យើងត្រូវការការកក់មួយឬ ?
អ្នកណាត្រូវការតាក់ស៊ីមួយ ?
អ្នកត្រូវការជំនួយទេ ?
ត្រូវការអោយគេជួយទេ ?
នេះពិតជាធ្ងន់មែនទែន ។
ខ្ញុំមិនអាចចាត់ចែងវាតែម្នាក់ឯងទេ ។
តើអ្នកអាចជួយបានទេ ?
សូមជួយខ្ញុំផង ។
វាមិនសមត្រង់កន្លែងនេះ ។
នេះគឺធំណាស់ ហើយមិនត្រូវទេ ។
របស់នេះគឺងាយបាក់បែក ។
តើអ្នកមានកន្លែងទំនេរដើម្បីដាក់របស់នេះចូលបានដែរទេ ?
តើអ្នកអាចព្យួររបស់នេះបានដែរទេ ?
តោះ ហៅអ្នកបម្រើ ។
ខ្ញុំមានបញ្ហានឹងកៅអីរបស់ខ្ញុំ ។
ខ្ញុំគិតថាវាត្រូវបានកក់លើសហើយ ។
ខ្ញុំគិតថាវាគឺជាកំហុសធម្មតាមួយ ។
យើងកំពុងធ្វើដំណើរជាមួយគ្នា ។
យើងចង់អង្គុយជាមួយគ្នា ។
តើអ្នកអាចប្ដូរកៅអីជាមួយខ្ញុំបានដែរទេ ?
កៅអីនេះទំនេរឬ ?
តើកន្លែងនេះមិនអីទេ ?
ខ្ញុំចង់ផ្លាស់ចេញ ។ កៅអីនេះខូច ។
ខ្ញុំចង់បានកៅអីនៅជាប់បង្អួច ។ តើមានមួយទំនេរនៅកន្លែងណាដែរទេ ?
ខ្ញុំបានស្នើរសុំយកកៅអីមួយជាប់ផ្លូវដើរ ។ នេះមិនមែនជាកៅអីជាប់ផ្លូវដើរទេ ។ តើខ្ញុំអាចផ្លាស់បានទេ ?
ខ្ញុំចង់គេង អញ្ចឹងខ្ញុំចង់បានកៅអីដែលស្ងៀមស្ងាត់ ។ តើមានមួយទំនេរដែរទេ ?
តើមានបញ្ហាអ្វីដែរទេ ?
សូមអោយភួយមួយទៀត ។
សូមអោយខ្នើយខ្ញុំមួយ ។
តើអ្នកមានកាសែតមួយដែរទេ ? ជាភាសាជប៉ុនឬ ?
តើអ្នកអាចយកទស្សនាវដ្តីភាសាជប៉ុនមួយអោយខ្ញុំបានដែរទេ ?
សូមអោយទឹកក្តៅ ។
តើអ្នកមានប្រដាប់ប្រដាជាឈុតសំរាប់ដេរមួយដែរទេ ?
តើអ្នកមានល្បែងលេងខ្លះសំរាប់ក្មេងដែរទេ ?
បាទ សុំមួយនាទី ។
ខ្ញុំនឹងត្រលប់មកអ្នកវិញ នៅពេលដែលយើងលេងសូវរវល់ ។
សុំទោស យើងទាំងអស់គ្នាចេញទៅក្រៅសំរាកអស់ហើយ ។
អ្នកអាចយកវាដោយខ្លួនឯងនៅខាងនោះតែម្តង ។
ជាមួយក្រូចឆ្មា ?
ជាមួយអំបិលនិងម្រេច ?
ទឹកសូដាជាតិរ៉ែ ។
ទឹកសូដាមិនមានជាតិរ៉ែ ។
សូមអោយរស់ជាតិក្រូចឆ្មា ។
តើអ្នកមានស្រាទេ ?
តើអ្នកមានស្រាបៀរជប៉ុនដែរទេ ? តើអ្នកមានប្រភេទអ្វីដែរ ?
តើអ្នកមានសូដាដែលមិនធ្វើអោយឡើងទំងន់ដែរទេ ?
តើស្រាបៀរថ្លៃប៉ុន្មាន ?
តើស្រានេះមិនគិតថ្លៃឬ ?
តើអ្នកចង់បានសាច់ត្រីឬសាច់គោ ?
តើអ្នកចង់បានសាច់ជ្រូកឬសាច់មាន់ ?
តើអ្នកចង់អោយចំអិនសាច់គោរបស់អ្នកយ៉ាងដូចម្ត៉េចទៅ ?
តើសាច់មាន់នេះចៀនឬ ?
តើត្រីប្រភេទអ្វីទៅ ?
តើអ្នកណាបរិភោគអាហារបួស ?
តើអ្នកបានកុម្ម៉ង់អាហារកូនក្មេងមួយឬ ?
តើអ្នកណាបានកុម្ម៉ង់អាហារពិសេសនេះ ?
នោះជារបស់ខ្ញុំ ។
ខ្ញុំបានកុម្ម៉ង់វា ។
ខ្ញុំបានកុម្ម៉ង់អាហារបួស ។
ខ្ញុំញុំាអាហារកំពប់ ។ តើអ្នកអាចយកកូនកន្សែងជូតដៃមួយអោយខ្ញុំបានដែរទេ ?
តុនេះកខ្វក់ ។ ខ្ញុំចង់បានកូនកន្សែងជូតដៃមួយ ។
ខ្ញុំអត់ទាន់បានបង្អែមរបស់ខ្ញុំ ។
ខ្ញុំបានកុម្ម៉ង់វាដោយមិនយកអំបិល ។
ខ្ញុំបានកុម្ម៉ង់គ្រឿងសមុទ្រ ។
ខ្ញុំមិនទាន់បានសាឡាត់របស់ខ្ញុំ ។
ខ្ញុំមិនទាន់បានម្ហូបសំខាន់ៗនៅឡើយទេ ។
ខ្ញុំអត់ទាន់បានរបស់មូរនៅឡើយទេ ។
តើខ្ញុំអាចសុំសមថ្មីមួយបានដែរទេ ?
តែជាមួយទឹកដោះគោ ។
កាហ្វេជាមួយស្ករ ។
គ្រាន់តែទឹកក្តៅ ។
តើមានកាហ្វេនៅសល់ខ្លះទេ ?
អ្នកមានទឹកផ្លែឈើទេ ?
តើខ្ញុំអាចសុំស្លាបព្រាថ្មីមួយបានដែរទេ ?
សូមអោយទឹកអប់ម៉ាកឆ៉ាណែល ។
សូមអោយស្រាម៉ាកឈីវ៉ាស់រីហ្គាលចំនួនពីរដប ។
ខ្ញុំចង់បានប៊ិចពណ៌ខៀវមួយម៉ាកផាកឃឺរ ។
ខ្ញុំចង់បានកន្សែងបង់កមួយមានរូបសេះម៉ាកហ៉ែម ។
យើងមិនមានម៉ូតដែលដូចនោះបេះបិតទេឥឡូវនេះទេ ។ ខ្ញុំនឹងពិនិត្យមើលស្តុករបស់យើង ។ សូមចាំតែមួយនាទីទេ ។
របស់ទាំងនោះអស់ហើយ ។ តែយើងមានម៉ូតរូបលោកខែនិងផ្កាយ ។ វាពិតជាស្អាតខ្លាំងណាស់ ។
សូមអោយទឹកអប់ម៉ាកដាន់ហ៊ីល ។
សុំទោស ព្រោះថាយើងអស់ទឹកអប់ម៉ាកដាន់ហ៊ីលហើយឥឡូវនេះ ។ ចុះចំណែកម៉ាកផ្សេងវិញ ?
បាទ យើងមានទឹកអប់ម៉ាកចាស់ផលិតដោយអ៊ីវស៉េនឡូរ៉េន ។
ទេ អរគុណហើយ ។ វាដូចជាសំរាប់ក្មេងណាស់ ។ អ្នកមានមួយផ្សេងទៀតទេ ?
យើងមានទឹកអប់មនុស្សប្រុសម៉ាកឡ៉ូមផលិតដោយវើសេស និងស៊ីខេផលិតដោយកាល់វីនខ្លេន ។
យល់ព្រម ខ្ញុំនឹងយកម៉ាកវើសេស ។
តើអ្នកមានលុយអាប់តូចៗដែរទេ ?
ខ្ញុំនឹងយកលុយអាប់របស់អ្នកមកអោយពេលក្រោយ ។
ខ្ញុំនឹងត្រលប់មករកអ្នកវិញ ជាមួយនិងលុយអាប់ ។
តើលុយអាប់របស់ខ្ញុំមានបញ្ហាអ្វីដែរទៅ ?
តើខ្ញុំអាចយកលុយអាប់របស់ខ្ញុំបានដែរទេ ?
ក្បាលបំពង់បញ្ចេញខ្យល់នេះខូចហើយ ។
វាត្រជាក់ ។ តើអ្នកអាចធ្វើអ្វីបានដែរទេ ?
កាស់ស្តាប់ត្រចៀករបស់ខ្ញុំខូចហើយ ។
ខ្ញុំមិនអាចមើលភាពយន្តបានទេ ។
ខ្ញុំចង់ទំរេតខ្លួន ។
បង្គន់នេះខូចហើយ ។
ចានទឹកលាងដៃនេះខូចហើយ ។
ទ្វានេះបិទអត់ជិត ។
អំពូលហ្នឹងអត់ឆេះ ។
វាក្តៅ ។ តើអ្នកអាចធ្វើអីបានដែរទេ ?
ខ្ញុំមានអារម្មណ៍ធីងធោងមិនស្រួលខ្លួន ។
មិនមានសាប៊ូទៀតទេ ។
មិនមានកន្សែងពោះគោទៀតទេ ។
មិនមានពែងកែវទៀតទេ ។
សូមនំាអ្នកណាម្នាក់ដែលនិយាយភាសាជប៉ុន ។
នេះគឺមិនអាចទទួលយកបានទេ ។
ខ្ញុំចង់ដាក់ពាក្យបណ្តឹងមួយ ។
សូមអោយទំរង់មួយសំរាប់បំពេញដាក់ពាក្យបណ្តឹងមកខ្ញុំ ។
សូមបញ្ជូនអ្នកដែលទទួលបន្ទុកទៅ ។
ឈ្មោះរបស់អ្នកអ្វីដែរ ? ហើយឋានៈជាមន្ត្រី ?
សូមសរសេរវានៅទីនេះ ។
ខ្ញុំបានដេកលក់ ។
តើអ្នកអាចអោយខ្ញុំខ្ចីប៊ិចមួយបានដែរទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីលេខជើងហោះហើរនេះបានដែរទេ ?
ខ្ញុំបានធ្វើខុស ។ តើខ្ញុំអាចបានអាថ្មីមួយទៀតបានដែរទេ ?
តើយើងនឹងទៅដល់ឆាប់ប៉ុណ្ណាដែរ ?
តើអ៊ីធីអេរបស់យើងជាអ្វីទៅ ?
តើម៉ោងប៉ាន់ស្មានរបស់យើងក្នុងការទៅដល់ប៉ុន្មានដែរ ?
តើលេខរបស់ច្រកមកដល់ប៉ុន្មានដែរ ?
ខ្ញុំមានការដូរជិះបន្ត ។ តើខ្ញុំនឹងខកវាឬ ?
តើការចេញដំណើរនឹងត្រូវបានគេពន្យាឬ ?
ខ្ញុំទៅទីក្រុងប៉ូស្តុន ។ តើលេខច្រកសំរាប់ដូរជិះបន្តប៉ុន្មានដែរ ?
តើអាកាសធាតុយ៉ាងម៉េចដែរ ?
វាត្រជាក់គ្រាន់បើដែរ ។ តើអ្នកត្រូវការភួយបន្ថែមមួយដែរទេ ?
ពិតជាមានភ្លៀងច្រើនមែន ។ សង្ឃឹមថាវានឹងស្រលះ ។
តើម៉ោងប៉ុន្មានដែរ ?
ពេញគ្រាន់បើដែរ ។
នៅទំនេរគ្រាន់បើដែរ ។
កៅអីនេះទំនេរ ។ សូមអង្គុយចុះបើអ្នកចង់ ។
តើអ្នកអាចចេញទៅផ្លូវនេះបានដែរទេ ? ខ្ញុំនឹងធ្វើដំណើរចេញទៅឥឡូវនេះ ។
តើអ្នករស់នៅប្រទេសជប៉ុនឬ ?
ខ្ញុំមកដើម្បីមុខជំនួញ ។ ចុះអ្នកវិញ ?
ខ្ញុំមកដើរទស្សនាកំសាន្ដ ។ ចុះអ្នកវិញ ?
ខ្ញុំមកសួរសុខទុក្ខមិត្តភ័ក្ត្រ ។ ចុះអ្នកវិញ ?
ខ្ញុំនៅក្នុងវិស័យធនាគារ ។ ចុះអ្នកវិញ ?
ខ្ញុំជាស្ត្រីមេផ្ទះ ។ ចុះអ្នកវិញ ?
ខ្ញុំជាវិស្វករ ។ ចុះអ្នកវិញ ?
តើការងាររបស់អ្នកអ្វីដែរ ?
តើអ្នកស្គាល់ទីក្រុងស៊ីអាថលដែរទេ ?
ស្គាល់ភោជនីយដ្ឋានណាល្អមួយដែរទេ ?
ស្គាល់សណ្ឋាគារណាល្អមួយដែរទេ ?
ស្គាល់ក្លឹបពេលយប់ណាល្អមួយដែរទេ ?
ស្គាល់សួនណាល្អមួយដែរទេ ?
អីក៏គាប់ជួនគ្នាយ៉ាងនេះ ។
តើនោះគឺជាអ្វីដែរទៅ ?
ខ្ញុំមិនយល់សោះ ។
មិនយល់ពីវាសោះ ។
សូមនិយាយម្តងទៀត ។
តើអ្នកអាចនិយាយអោយយឺតជាងនេះបានដែរទេ ?
នោះគឺមិនអាចទៅរួចទេ ។
តើអ្នកអាចទាញថ្នើររបស់អ្នកឡើងលើបានដែរទេ ?
សូមអភ័យទោស ។ ខ្ញុំនឹងអានឥឡូវនេះ ។
ចង់មើលភាពយន្តឬធ្វើអ្វីដែរទេ ?
សូមអភ័យទោស ។ ខ្ញុំត្រូវការប្រើបង្គន់ ។
តើខ្ញុំអាចសួរសំនួរចុងក្រោយមួយបានដែរទេ ?
ខ្ញុំឈ្មោះតាគេស៊ី ។ ចុះអ្នកវិញ ?
តើខ្ញុំអាចសរសេរសំបុត្រមួយទៅអ្នកបានដែរឬទេ ?
រីករាយដែលបានជួបអ្នក ។
ត្រូវធ្វើការដូរជិះបន្ត ។ ទៅទីក្រុងប៉ូស្តុន ។
តើកន្លែងឡើងជិះមួយណាដែរ ?
ខ្ញុំត្រូវការអោយជួយ ។ ខ្ញុំមិនអាចដើរដោយខ្លួនឯទេ ។
ខ្ញុំត្រូវការកៅអីជិះមួយមានកង់ ។
ខ្ញុំបានស្នើរសុំជំនួយ ។
សូមនិយាយម្តងទៀត ។
សូមគូរផែនទីមួយអោយខ្ញុំ ។
ត្រូវធ្វើការដូរជិះបន្ត ។
តើច្រកលេខដប់ប្រាំមួយស៊ីនៅកន្លែងណាដែរ ?
តើស្ថានីយធ្វើដំណើរក្នុងស្រុកនៅកន្លែងណាដែរ ?
តើទីប្រជុំប៊ីនៅកន្លែងណាដែរ ?
តើបញ្ជររបស់ក្រុមហ៊ុនអាកាសចរណ៍ដែលតានៅកន្លែងណាដែរ ?
តើខ្ញុំត្រូវជិះឡានក្រុងដែរទេ ?
តើឡានដឹកទៅវិញទៅមកបន្ទាប់នឹងមកពេលណាដែរ ?
តើខ្ញុំនឹងយឺតឬ ?
តើយន្តហោះនឹងពន្យាការចេញដំណើរឬ ?
តើឡានក្រុងបន្ទាប់នឹងមកពេលណាដែរ ?
ខ្ញុំត្រូវស្វែងរកច្រកនេះ ។
នេះទៅទីក្រុងម៉ាយអាមីឬ ?
ខ្ញុំនឹងឈប់នៅទីក្រុងដេដ្រាត់ ហើយបន្តទៅទីក្រុងម៉ាយអាមី ។
ខ្ញុំត្រូវចុះ ។ នេះគឺជាយន្តហោះខុសទេ ។
សូមអភ័យទោស ។ ខ្ញុំចង់ទៅទីក្រុងម៉ាយអាមី ។
តើយន្តហោះទៅទីក្រុងម៉ាយអាមីនៅកន្លែងណាដែរ ?
ខ្ញុំត្រូវចុះ ។ នេះគឺជាឡានក្រុងខុសទេ ។
ខ្ញុំត្រូវចុះ ។ នេះគឺជារថភ្លើងខុសទេ ។
យើងកំពុងធ្វើដំណើរជាមួយគ្នា ។ នេះគឺជាគ្រួសាររបស់ខ្ញុំ ។
តើអ្នកមកពីណាដែរថ្ងៃនេះ ?
តើអ្នកមានគំរោងស្នាក់នៅកន្លែងណាដែរ ?
សណ្ឋាគារហ៊ីលតុន ។
នៅឯផ្ទះរបស់មិត្តភ័ក្ត្រខ្ញុំ ។
នៅឯផ្ទះរបស់គ្រួសារធម៌ខ្ញុំ ។
ប្រហែលបីពាន់ប្រាំរយដុល្លារ ។
ជួញដូរភាគហ៊ុន ។
ធនាគារកិច្ចអន្តរជាតិ ។
ខ្ញុំគឺជាលេខាធិការ ។
ខ្ញុំគឺជាអ្នកថតរូបក្រៅម៉ោង ។
ខ្ញុំគឺជាវិស្វករភ្លើង ។
ខ្ញុំអត់មានការងារធ្វើ ។
កាបូបរបស់ខ្ញុំមិននៅទីនេះទេ ។
បាត់កាបូបមួយ ។
វ៉ាលីដាក់ខោអាវរបស់ខ្ញុំរងការខូចខាត ។ ខ្ញុំត្រូវការទំរង់តវ៉ាមួយច្បាប់ ។
គ្រឿងអលង្ការរបស់ខ្ញុំបានបាត់ ។ ខ្ញុំចង់ធ្វើការរាយការណ៍មួយ ។
សូមអោយវិក័យប័ត្រសំរាប់យកកាបូបអីវ៉ាន់មកវិញ ។
សូមអោយសំបុត្រសំរាប់យកកាបូបអីវ៉ាន់មកវិញ ។
មានបារី ស្រា ឬកាដូខ្លះដែរទេ ?
បាទ ។ ស្រាសាកេជប៉ុនចំនួនពីរដប ។
តើមានអ្វីក្នុងកាបូបនេះ ?
តើអ្នកអាចបើកកាបូបនេះបានដែរឬទេ ?
ម៉ាស៊ីនថតវីដេអូ ។ សំរាប់ប្រើប្រាស់ផ្ទាល់ខ្លួន ។
ត្រីមឹកស្ងួត បន្ទះមឹកស្តើងៗ ហើយនិងទឹកស៊ីអ៊ីវ ។
គ្រឿងសណ្តែកមីសូ និងនំខេកសណ្តែកមានចាហួយ ។
អ្នកនឹងត្រូវបង់ពន្ធលើរបស់នេះ ។
តើពន្ធថ្លៃប៉ុន្មានដែរ ?
តើអត្រាដូរលុយយ៉េននិងដុល្លារប៉ុន្មានដែរ ?
មូលប្បទានប័ត្រអ្នកទេសចរណ៍ មិនអីទេ ?
សូមប្ដូរវាជាសាច់ប្រាក់ ។
សូមយកលុយផោនអង់គ្លេស ។
សូមបំបែកលុយនេះ ។
សូមអោយក្រដាស់តូចៗ ។
មិនមានប្ដូររូបិយប័ណ្ណអន្តរជាតិទេ ?
តែលុយយ៉េនជប៉ុនទេ ។
នៅពេលនៅទីក្រុងរ៉ូម ធ្វើដូចជនជាតិរ៉ូម៉ាំងធ្វើ ។
តើផ្លូវដ៏ល្អជាងគេគឺអ្វីដែរទៅ ?
តើផ្លូវដែលថោកជាងគឺអ្វីដែរទៅ ?
តើផ្លូវមួយណាលឿនជាងគេ ?
តើផ្សារឆ្ងាយពីនេះទេ ?
តើមានរថភ្លើងទេ ?
តើមានរថភ្លើងក្រោមដីទេ ?
តើមានឡានលីមូហ្សីនឬក៏អ្វីផ្សេងទៀតទេ ?
តើកន្លែងដឹកភ្ញៀវទៅមករបស់សណ្ឋាគារនៅឯណាដែរ ?
តើវាមិនគិតថ្លៃឬ ?
តើមានឡានក្រុងដឹកភ្ញៀវទៅមកមួយដែរទេ ?
តើឡានក្រុងបន្ទាប់មកពេលណា ?
តើលេខឡានក្រុងប៉ុន្មានដែរ ?
តើខ្ញុំត្រូវរៀបចំលុយត្រូវដូរអោយដូចតែម្តងឬ ?
តើរថភ្លើងក្រោមដីនៅកន្លែងណាដែរ ?
តើមានចំណតប៉ុន្មានដែរ ?
ចំណែកតំលៃវិញប៉ុន្មានដែរ ?
តើចំណតនៅកន្លែងណាដែរ ?
តើសណ្ឋាគារផ្លាស្ស៉ានៅកន្លែងណាដែរ ?
តើបន្ទប់ផ្តល់ព័ត៌មាននៅកន្លែងណាដែរ ?
តើច្រកចូលទៅរថភ្លើងក្រោមដីនៅកន្លែងណាដែរ ?
តើនេះទៅកន្លែងណាដែរ ?
តើយើងនៅកន្លែងណាដែរ ?
តើអ្នកនៅកន្លែងណាដែរ ?
តើថ្លៃប៉ុន្មានទៀត ?
តើប្រហែលថ្លៃប៉ុន្មាន ?
តើរថភ្លើងបន្ទាប់ពេលណាដែរ ?
តើឡានក្រុងចុងក្រោយគេពេលណាដែរ ?
តើខ្ញុំគួរបង់ថ្លៃពេលណាដែរ ?
តើយើងនឹងទៅដល់ពេលណាដែរ ?
តើយើងគួរទៅពេលណាដែរ ?
តើយើងគួរចុះពេលណាដែរ ?
តើផ្លូវមួយណាល្អជាងគេ ?
តើចំណតណាដែលនៅជិតជាងគេ ?
តើអាសយដ្ឋានរបស់អ្នកនៅទីនោះអ្វីដែរ ?
តើកន្លែងល្បីៗជាលក្ខណៈប្រវត្តិសាស្ដ្រនៅជិតជាងគេអ្វីដែរ ?
តើស្ថានីយបន្ទាប់អ្វីដែរ ?
តើបន្ទប់ផ្តល់ព័ត៌មាននៅកន្លែងណាដែរ ?
ទៅអោយត្រង់ទីនេះ ។ វានៅពីក្រោយបញ្ជររបស់ក្រុមហ៊ុនអាកាសចរណ៍អង់គ្លេស ។
ពីក្រោយកន្លែងណាដែរ ?
អូរ វាពិតជាអស្ចារ្យមែន ។ ការហោះហើររបស់អ្នកយ៉ាងម៉េចដែរ ?
ហេ ខ្ញុំនៅតាមផ្លូវទៅយកអ្នកហើយ អញ្ចឹងនាំគ្នាជួបប្រហែលដប់ប្រាំនាទីទៀត ។
ខ្ញុំយល់ហើយ ។ តែកន្លែងណាដែរ ?
តើអ្នកនៅកន្លែងណាដែរឥឡូវនេះ ?
នៅពីក្រៅកន្លែងយកអីវ៉ាន់តែម្តង ។
បាទ ឡើងជណ្ដើរយន្ដនេះ ទៅខាងក្រៅស្ថានីយធ្វើដំណើរ ហើយអ្នកនឹងឃើញចំណតឡានក្រុងមួយនៅខាងឆ្វេងដៃអ្នក ។
ឡើងជណ្តើរយន្ត ។ ចេញក្រៅស្ថានីយធ្វើដំណើរ ។ ចំណតឡានក្រុងនៅខាងឆ្វេង ?
នោះគឺត្រឹមត្រូវហើយ ។ វាគឺសំរាប់អ្នកចាកចេញធ្វើដំណើរ តែវាមិនសូវមានមនុស្សច្រើនដូចកន្លែងអ្នកធ្វើដំណើរមកដល់សោះ ។
យល់ព្រម ។ ខ្ញុំយល់ហើយ ។ ក្នុងដប់ប្រាំនាទីទៀត ?
ខ្ញុំនឹងរង់ចាំ ។
សុំអភ័យទោស លោក ? តើផ្លូវម៉េលវីននៅកន្លែងណាដែរ ?
នៅឯណោះ ? តើផ្លូវមួយណានៅឯណោះ ?
អញ្ចឹង ។ តើសណ្ឋាគារសេរ៉ាតោននៅម្តុំនោះទេ ?
បាទ ខ្ញុំគិតដូចនេះដែរ ។ ពីព្រោះវានៅជាប់នឹងចំនុចប្រសព្វនៃផ្លូវម៉េលវីន និងផ្លូវប្រ៉ូដវ៉េ ។ ពេលអ្នកទៅដល់ផ្លូវម៉េលវីន បត់ឆ្វេង ហើយបន្តទៅត្រង់ ។ អ្នកនឹងឃើញវាជាក់ជាមិនខាន ។
ទេ ។ ប្រហែលបីប្លុកចុះពីផ្លូវម៉េលវីន ។
ជាការរីករាយរបស់ខ្ញុំ ។
តើភោជនីយដ្ឋានរបស់អ្នកនៅកន្លែងណាដែរ ?
យើងនៅក្បែរបឹង ។ នៅឯចំនុចប្រសព្វនៃផ្លូវឡេកវីយ៉ូនិងផ្លូវទីបួន ហើយបត់ទៅផ្លូវដីខាងឆ្វេងដៃរបស់អ្នក ។
បាទ យើងនៅក្បែរទឹកតែម្តង ។ បើអ្នកទៅឆ្ងាយពេក អ្នកនឹងត្រូវហែលទឹក ។
តើស្ទូឌីយោរបស់អ្នកនៅកន្លែងណាដែរ ?
វាគឺជាកន្លែងមួយដែលពិបាករក ។ វានៅលើផ្លូវតូចមួយចេញពីផ្លូវម៉េនហ៉ាយវ៉េ ។
តើអ្នកអាចរៀបរាប់ពីស្ទូឌីយោរបស់អ្នកបានដែរទេ ?
បាទ បាន វាមានជញ្ជាំងមួយធ្វើពីបេតុងប្រហោងៗ ។ តែវាមានទ្វារពណ៌ផ្កាឈូកមួយ ។
យល់ហើយ ។ នោះគឺល្អគ្រប់គ្រាន់ហើយ ។ ខ្ញុំនឹងរកមើលវា ។
អស្ចារ្យ ។ ហៅទូរស័ព្ទបើអ្នកវង្វេងផ្លូវ ។
សុំអភ័យទោស ។ តើការិយាល័យប្រៃសណីយ៍នេះនៅកន្លែងណាដែរ ?
ចាំមើលមើល អ្នកដើរចុះទៅតាមផ្លូវនេះចំនួនបីប្លុក បន្ទាប់មកងាកទៅឆ្វេង បន្ទាប់ទៀតទៅហួសមួយប្លុកទៀត ហើយបត់ឆ្វេងត្រង់កន្លែងកាច់ជ្រុងក្រូវើ ។ អ្នកនឹងឃើញវានៅខាងឆ្វេងដៃរបស់អ្នក ។
ចាំ ។ តើអ្នកអាចនិយាយវាម្តងទៀតអោយយឺតជាងនេះបានទេ ។ ទៅបីប្លុក ។
បាទ បីប្លុកចុះទៅតាមផ្លូវនេះ ។ បន្ទាប់ទៀតបត់ឆ្វេង ។
បាទ ។ បន្ទាប់ទៀតដើរមួយប្លុកទៅកន្លែងកាច់ជ្រុងក្រូវើ ។
យល់ហើយ មួយប្លុក ។ កន្លែងកាច់ជ្រុងក្រូវើ ។
បត់ឆ្វេងទីនោះ ហើយអ្នកអាចឃើញការិយាល័យប្រៃសណីយ៍នេះនៅខាងស្តាំដៃអ្នក ។
បត់ឆ្វេង ។ វានៅខាងស្តាំដៃ ។
ត្រឹមត្រូវល្អណាស់ ។ សូមសំណាងល្អ ។
សូមគូសផែនទីមួយ ។
តើអ្នកអាចរៀបរាប់ពីវាបានដែរទេ ?
អោយខ្ញុំនិយាយម្តងទៀត ។
តើវាត្រឹមត្រូវទេ ?
ខ្ញុំកំពុងទូរស័ព្ទមកពីប្រទេសជប៉ុន ។
សូមធ្វើការកក់ ។
ខ្ញុំចង់ធ្វើការកក់មួយ ។
ចាំមួយនាទី ខ្ញុំនឹងភ្ជាប់អោយអ្នក ។
តុការិយាល័យកក់ ។ តើខ្ញុំអាចជួយអ្វីអ្នកបានយ៉ាងដូចម្តេចដែរ ?
ខ្ញុំចង់កក់បន្ទប់ ។
សំរាប់ភ្ញៀវប៉ុន្មាននាក់ដែរ ?
សូមកក់អោយសំរាប់ពីរនាក់ ។ ខ្ញុំចង់បានបន្ទប់មានគ្រែពីរ ។
នឹងមកដល់ថ្ងៃទីដប់ ខែមីនា ។ ចាកចេញថ្ងៃទីដប់ប្រាំបួន ខែមីនា ។
មិនអីទេ ។ យើងមានបន្ទប់នៅទំនេរនៅឡើយ ។
តើអ្នកមានបន្ទប់មួយដែលអាចមើលឃើញទេសភាពសួនដែរទេ ?
បាទ បន្ទប់របស់យើងមួយចំនួនមានទេសភាពសួន តែវាថ្លៃច្រើនជាង ។
បន្ទប់មានគ្រែពីរចំនួនមួយ ? សូមចាំមួយភ្លែត ។ វាថ្លៃចាប់ពីបីរយហាសិបដុល្លារក្នុងមួយយប់ ដោយមិនទាន់គិតបញ្ចូលថ្លៃពន្ធ ។
វាគឺថ្លៃគ្រាន់បើ ។
ចុះបើបន្ទប់មួយដែលអាចមើលឃើញទេសភាពសួនខ្លះវិញ ? ទាំងនោះគឺថ្លៃតែពីររយហាសិបដុល្លារប៉ុណ្ណោះ ។
យល់ព្រម ។ វាស្តាប់ទៅដូចជាល្អដែរ ។ តើថ្លៃប្រចំាសប្ដាហ៍វិញប៉ុន្មានដែរ ?
សូមចាំមួយភ្លែត ។ បាទ មានថ្លៃពិសេសមួយក្នុងខែមីនា ។ វាចុះថ្លៃម្ភៃភាគរយ សំរាប់ការស្នាក់នៅរយៈពេលមួយសប្ដាហ៍ឬច្រើនជាងនេះ ។
តើខ្ញុំគួរកក់បន្ទប់នេះអោយអ្នកទេ ?
ខ្ញុំយល់ហើយ ។ តើខ្ញុំអាចសុំលេខក្រេឌីតកាតរបស់អ្នកនិងថ្ងៃខែផុតកំណត់ សំរាប់រក្សាការកក់របស់អ្នកបានដែរទេ ?
ហើយ តើខ្ញុំអាចសុំឈ្មោះរបស់អ្នកបានដែរទេ ?
អរគុណ អ្នកនាងម៉ាត់សឹមឹរ៉ា ។ លេខកក់របស់អ្នកគឺ ស៊ី បួន ប្រាំមួយ ប្រាំពីរ ហើយឈ្មោះរបស់ខ្ញុំគឺអេឡេន ។
សូមហ្វាក់ការកក់នេះ ។
តុការិយាល័យកក់ ម៉ៃខលកំពុងនិយាយ ។ តើខ្ញុំអាចជួយអ្វីអ្នកបានដែរទេ ?
ខ្ញុំចង់កក់បន្ទប់ខ្លះ ។
ត្រូវការបន្ទប់ពីរ ។ មួយមានគ្រែតូចពីរ ។ មួយមានគ្រែធំមួយ ។ សំរាប់តែយប់នេះទេ ។
សូមអោយបន្ទប់ដែលនៅជិតគ្នា ។
ប្រាកដណាស់ ។ យើងមានបន្ទប់ពីរប្រភេទទំនេរនៅពេលនេះ ប្រភេទធម្មតានិងប្រភេទល្អពិសេស ។
តើអ្នកអាចរៀបរាប់មួយៗពីបន្ទប់ទាំងនេះអោយខ្ញុំបានដែរទេ ?
បាទ បន្ទប់ប្រភេទល្អពិសេសមានចង្កា្រនបាយតូចមួយ អាហារពេលព្រឹកមិនគិតលុយ ហើយមានរានហាលមួយបែរទៅសមុទ្រ ។ បន្ទប់ធម្មតាបែរមុខទៅផ្លូវ ប៉ុន្តែអ្នកអាចមើលឃើញភ្នំ ។
ខ្ញុំយល់ហើយ ។ តើបន្ទប់ប្រភេទល្អពិសេសថ្លៃប៉ុន្មានដែរ ?
បន្ទប់ប្រភេទល្អពិសេសថ្លៃកៅសិបប្រាំដុល្លារក្នុងមួយយប់ ហើយបន្ទប់ប្រភេទធម្មតាថ្លៃចិតសិបប្រាំដុល្លារ ។
អញ្ចឹង សូមអោយបន្ទប់ប្រភេទល្អពិសេស ។ ត្រូវការក្រេឌីតកាតដែរទេ ?
លោក វាមិនចាំបាច់ទេ ។ យើងនឹងចាត់ចែងវានៅពេលអ្នកចុះឈ្មោះចូលសណ្ឋាគារ ។ ម៉ោងចុះឈ្មោះចូលសណ្ឋាគារគឺចាប់ពីម៉ោងពីរកន្លះថ្ងៃ ។ ប៉ុន្តែយើងអាចរក្សាទុកកាបូបអីវ៉ាន់របស់អ្នកអោយអ្នកបាន បើអ្នកចង់ដើរទស្សនាកំសាន្តខ្លះមុននឹង ។
វាពិតជាជួយមែន ។ អរគុណ ។ ខ្ញុំសុំទោស សូមអោយឈ្មោះរបស់អ្នក ។
ឈ្មោះម៉ៃខល ។ ខ្ញុំនឹងនៅតុការិយាល័យ ពេលអ្នកមកទីនេះ ។
សូមរក្សាទុកកាបូបអីវ៉ាន់របស់ខ្ញុំ ។
ត្រលប់មកវិញអោយបានមុនម៉ោងបួនកន្លះ ។
ទិវាសួស្តី លោកវ៉ាដាក់ ។ តើខ្ញុំអាចសុំលេខកក់របស់អ្នកបានដែរទេ ?
ខ្ញុំដូចជាមិនអាចរកឃើញវាក្នុងកុំព្យូទ័របានទេ ។
ខ្ញុំមានប័ណ្ណបញ្ជាក់របស់ខ្ញុំ ។
អរគុណ ។ អា ខ្ញុំដឹងថាមានអ្វីបានកើតឡើងហើយ ។
ទេ លោក មិនត្រូវទេ ។ បន្ទប់របស់លោកត្រូវបានកក់ជាក្រុមមួយដោយចៃដន្យ ។ តើលោកគ្រាន់តែបំពេញទំរង់ចុះឈ្មោះនេះបានទេ ?
វាល្អហើយ ។ ហើយ លោក តើលោកចង់បង់ថ្លៃយ៉ាងដូចម្តេចដែរ ?
ដោយក្រេឌីតកាត ។ នេះគឺជាកាតរបស់ខ្ញុំ ។
អរគុណ ។ អ្នកកាន់អីវ៉ាន់នឹងយកកាបូបរបស់អ្នកមក កំឡុងពេលដែលខ្ញុំធ្វើដំណើរការនេះ ។
ខ្ញុំមានកាបូបបី ។
សូមហៅទូរស័ព្ទដាស់ខ្ញុំពេលព្រឹក ។ សូមហៅនៅម៉ោងប្រាំមួយកន្លះព្រឹក ។
ខ្ញុំចង់ប្រើទូទុកដាក់របស់សុវត្ថិភាពមួយ ។
អ្នកដែលតវ៉ានឹងទទួលបានការចាប់អារម្មណ៍ឬអ្វីដែលខ្លួនចង់បាន ។
បន្ទប់នេះមានក្លិនអាក្រក់ ។
ខ្ញុំចង់ដូរបន្ទប់ ។
តើវាមានអាត្រាដដែលឬ ?
បន្ទប់នេះគឺគ្រាន់បើច្រើនណាស់ ។ អរគុណ ។
បន្ទប់នេះគឺថ្លង់ខ្លាំងណាស់ ។
បន្ទប់នេះគឺងងឹតខ្លាំងណាស់ ។
