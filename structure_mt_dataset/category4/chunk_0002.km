ភ្លើងហ្រ្វាំងមិនដំណើរការ ។
ភ្លើងនៅខាងមុខមិនដំណើរការ ។
តើអ្នកអាខសាកថ្មបានទេ ?
ខ្ញុំអស់ថ្មហើយ ។
តើត្រូវចំនាយរយៈពេលប៉ុន្មានក្នុងការជួសជុល ?
សុំទោសដែលរំខាន ។ អរគុណច្រើន ។
សូមជួយប្រាប់ខ្ញុំអំពីផ្លូវទៅសណ្ឋាគារហ៊ីលតុន ។
តើមានសញ្ញាសំគាល់អ្វីខ្លះដែររឺទេ ?
ខ្ញុំអាចស្វែងរកវាបានយ៉ាងងាយស្រួលដែរទេ ?
តើផ្លូវនេះជាផ្លូវទៅ វិថីហ្វីហ៍មែនទេ ?
តើខ្ញុំអាចទៅទីនោះដោយជិះឡានក្រុងបានដែរទេ ?
តើខ្ញុំអាចទៅទីនោះដោយជិះរថភ្លើងបានដែរទេ ?
ខ្ញុំវង្វេងផ្លូវហើយ ។
តើនៅជិតនេះមានទូរស័ព្ទសាធារណៈដែរទេ ?
តើនៅជិតនេះមានបន្ទប់ទឹកដែររឺទេ ?
ខ្ញុំចង់មើលទេសភាពនៅទីក្រុងនេះ ។
តើនៅទីនេះមានឡានក្រុងទេសចរណ៍ក្នុងក្រុងដែរទេ ?
ខ្ញុំចង់ចុះឈ្មោះធ្វើទេសចរណ៍ទៅមើលទឹកធា្លក់ ។
តើខ្ញុំអាចមើលអ្វីបានសំរាប់ដំណើរទេសចរណ៍នេះ ?
តើមានការបញ្ចុះតំលៃសំរាប់សិស្សដែរទេ ?
តើនេះជាដំណើរកំសាន្តព្រឹក មែនទេ ?
តើនេះជាដំណើរកំសាន្តយប់មែនទេ ?
តើនេះជាដំណើរកំសាន្តកន្លះថ្ងៃមែនទេ ?
តើនេះជាដំណើរកំសាន្តមួយថ្ងៃមែនទេ ?
តើខ្ញុំអាចចូលរួមដំណើរកំសាន្តចាប់ពីសណ្ឋាគារ ស្សេរ៉ាថោន បានអត់ ?
តើម៉ោងប៉ុន្មានពួកយើងនឹងត្រឡប់មកវិញ ?
តើខ្ញុំអាចសុំកូនសៀវភៅកំសាន្តមួយផងបានទេ ?
តើនៅទីនេះ មានអ្វីដែលគួរអោយចាប់អារម្មណ៍ដែរទេ ?
តើអ្នកមានអ្វីត្រូវណែនាំខ្ញុំធ្វើទស្សនកិច្ចដែរអត់ ?
នៅទីនោះមានមគ្គទេសន៍ទេសចរណ៍ដែរអត់ ?
តើមគ្គទេសន៍ទេសចរណ៍ មានតំលៃប៉ុន្មានក្នុងមួយថ្ងៃ ?
តើពួកយើងអាចចូលទៅក្នុងបានទេ ?
តើម៉ោងប៉ុន្មានពួកយើងគួរត្រលប់មកវិញ ?
តើខ្ញុំអាចសុំសៀវភៅមគ្គទេសន៍មួយក្បាលផងបានទេ ?
តើនាងនិយាយភាសាជប៉ុនដែរទេ ?
តើពួកយើងមានពេលបរិភោគអាហារថ្ងៃត្រង់ដែរទេ ?
តើពួកយើងមានពេលចេញទៅលេងនៅជុំវិញនេះដែរទេ ?
តើខ្ញុំអាចថតរូបនៅទីនេះបានដែរទេ ?
តើខ្ញុំអាចថតរូបអ្នកបានដែរទេ ?
ខ្ញុំមិនប្រើជើងទម្រកាមេរ៉ាទេ ។
ខ្ញុំមិនប្រើពន្លឺទេ ។
ថតពួកយើងអោយជាប់នឹងអគារនោះ ។
រូបសំណាកនេះនៅជាមួយពួកយើងមែនទេ ?
តើកន្លែងណាដែលខ្ញុំអាចរកអ្នកថតរូបបាន ?
សូមហ្វីលខ្លះៗសំរាប់កាមេរ៉ានេះ ។
សូមហ្វីលផ្តិតគូល័រ ។
សូមហ្វីលស្លាយគូល័រ ។
សូមហ្វីលពណ៌ខ្មៅស ។
សូមអ៊ិចផូសឺរម្ភៃ ។
សូមអ៊ិចផូសឺរសាមសិបប្រាំមួយ ។
សូមថ្មស្ងួតមួយសំរាប់កាមេរ៉ានេះ ។
ខ្ញុំចង់ផ្តិតហ្វីលនេះ ។
ខ្ញុំចង់ផ្តិតហ្វីលមួយនេះ ។
សូមផ្តិតរលោង ។
សូមផ្តិតគ្រឺម ។
អ្នកអាចយកហ្វីលចេញមកអោយខ្ញុំមែនទេ ?
កាមេរ៉ារបស់ខ្ញុំមិនដំណើរការ ។
កន្លែងស្យាត់ធ័រមានបញ្ហា ។
ហ្វីលនេះជាប់គាំង ។
ពន្លឺភ្លើងមានបញ្ហា ។
កន្លែងស៊េរេទំហំហ្វីលមានបញ្ហា ។
កងស៊េរេរូបមានបញ្ហា ។
តើសាលតន្ត្រីនៅកន្លែងណា ?
តើកន្លែងណាខ្ញុំអាចមើលគេលេង ?
តើខ្ញុំអាចមើលកុននៅឯណាបាន ?
តើខ្ញុំអាចមើលអូប៉េរ៉ាបាននៅកន្លែងណា ?
តើខ្ញុំអាចមើលតន្ត្រីនៅឯណាបាន ?
ថ្ងៃនេះជាកម្មវិធីអ្វី ?
តើជានេះជាសោកនាដកម្មមែនទេ ?
តើនេះជាអាថ៌កំបាំងមែនទេ ?
វាជាការរីករាយដែរមែនទេសំរាប់ជនបរទេស ?
តើមានកន្លែងអង្គុយច្រើនសំរាប់ល្ងាចនេះដែរទេ ?
ខ្ញុំចង់កក់សំបុត្រទុកមួយសំរាប់ពេលយប់ថ្ងៃស្អែក ។
សូមកន្លែងអង្គុយនៅជាន់ទីពីរ ។
សូមនៅខាងក្រោយ ។
មិនមែននៅខាងក្រោយទេ ។
សូមនៅក្នុងសាល ។
ពេលណាទើបបញ្ចប់ ?
សុំទោស, ខ្ញុំកំពុងសំរាក ។
សូមកន្លែងអង្គុយនៅជាន់ទីមួយ ។
ទៅសំរាកនៅកន្លែងនោះ ។
ខ្ញុំមានពេលវេលាដ៏អស្ចារ្យ ។
