សួស្តី ។ តើនេះជាសណ្ឋាគារអាលហ្វ៉ា មែនទេ ?
តើអ្នកអាចភ្ជាប់ខ្ញុំទៅនឹងបន្ទប់បី ដប់ប្រាំពីរ បានទេ ?
សូមចុចលេខបន្តប្រាំ បួន សូន្យ ។
តើខ្ញុំធ្វើការហៅទូរស័ព្ទរយៈចំងាយឆ្ងាយដោយរបៀបណា ?
តើនេះគឺម៉ាទីនមែនទេ ?
តើនេះគឺលោកម៉ាទីនមែនទេ ?
តើនេះគឺមួយ ពីរ បី បួន ប្រាំ ប្រាំមួយ ប្រាំពីរ មែនទេ ?
តើខ្ញុំអាចសូមនិយាយទៅកាន់ច៉ច បានទេ ?
នេះគឺអាគីកុ អូនូ មិត្តរបស់ច៉ច ។
លោកម៉ាទីនគឺនៅខាងក្រៅឥលូវនេះ ។
តើម៉ោងប៉ុន្មានដែលគាត់នឹងត្រលប់មកវិញ ?
តើអ្នកអាចនឹងប្រាប់គាត់ថាអាគីកូវ៉ន់ទូរស័ព្ទទៅបានទេ ?
ខ្ញុំនឹងទូរស័ព្ទទៅគាត់ម្តងទៀត ។
តើអ្នកអាចអោយគាត់ទូរស័ព្ទមកខ្ញុំវិញបានទេ ?
សូមអភ័យទោស ច្រលំលេខ ។
ខ្ញុំចង់សូមធ្វើការហៅទូរស័ព្ទរយះចំងាយឆ្ងាយមួយ ។
មួយពីរបីបួនប្រាំប្រាំមួយប្រាំពីរប្រាំបីប្រាំបួនសូន្យ ។
ខ្ញុំនឹងទូរស័ព្ទត្រលប់ទៅអ្នកនៅពេលក្រោយ ។
តើលេខកូដទូរស័ព្ទអន្តរជាតិសំរាប់ប្រទេសអេស្បាញគឺប៉ុន្មាន ?
តើខ្ញុំអាចនិយាយទៅកាន់លោកម៉ាទីនបានទេ ?
នេះគឺអាគីកូវ៉ន់ ។
តើលេខកូដប្រទេសសំរាប់ប្រទេសអេស្បាញគឺប៉ុន្មាន ?
ខ្ញុំចង់សូមធ្វើការហៅទូរស័ព្ទទៅក្រៅប្រទេសទៅកាន់ប្រទេសជប៉ុន ។
សូមការហៅទូរស័ព្ទបង់ប្រាក់ពេលជួបមនុស្សត្រូវសំរាប់លោកតាកាស៊ីអ៊ីគឺដា ។
លេខគឺបីបីបួនប្រាំប្រាំមួយប្រាំពីរប្រាំបីប្រាំបួនសូន្យ ។
សូមដាក់ទូរស័ព្ទចុះ ។ ខ្ញុំនឹងទូរស័ព្ទត្រលប់ទៅអ្នកវិញនៅពេលក្រោយ ។
ទូរស័ព្ទកំពុងរោទិ៍ប៉ុន្តែគ្មាននរណាទទួល ។
ខ្ញុំចង់ធ្វើការទូរស័ព្ទដោយនរណាលើកក៏បានទៅកាន់ប្រទេសជប៉ុន ។
ខ្ញុំចង់ធ្វើការទូរស័ព្ទបង់ប្រាក់ពេលនិយាយទៅកាន់មនុស្សត្រូវទៅកាន់ប្រទេសជប៉ុន ។
ខ្ញុំចង់ធ្វើការទូរស័ព្ទដោយប្រើកាតឥណទានទៅកាន់ប្រទេសជប៉ុន ។
តើអ្នកអាចសាកល្បងម្តងទៀតនៅពេលក្រោយបានទេ ?
ក្រុមរបស់អ្នកគឺនៅលើបណ្តាញ ។ សូមចាប់ផ្តើម ។
តើអ្នកអាចប្រាប់ខ្ញុំនូវតំលៃទូរស័ព្ទនៅពេលក្រោយបានទេ ?
តើបង្អួចណាមួយសំរាប់តែមប្រៃសណីយ៍ ?
តើខ្ញុំអាចមានតែមប្រៃសណីយ៍សំរាប់កាតផូស្តាចំនួនប្រាំពីរទៅប្រទេសជប៉ុនបានទេ ?
តើវាមានតំលៃប៉ុន្មានដើម្បីផ្ញើរកាតផូស្តាមួយទៅកាន់ប្រទេសជប៉ុន ?
សូមតែមសាមសិបសេនចំនួនប្រាំ ។
តើខ្ញុំអាចមានស្លាកបិតសំរាប់ការផ្ញើរតាមអាកាសខ្លះបានទេ ?
តើខ្ញុំអាចផ្ញើរតាមអាកាសនៅឯណា ?
ខ្ញុំផ្ញើរកញ្ចប់ឥវ៉ាន់នេះ ។ តើខ្ញុំអាចដាក់សំបុត្រមួយនៅក្នុងវាបានទេ ?
តើបង្អួចណាមួយគឺសំរាប់កញ្ចប់ឥវ៉ាន់ ?
តើខ្ញុំអាចមានតែមសំរាប់សំបុត្រទៅកាន់ប្រទេសជប៉ុនបានទេ ?
តើខ្ញុំអាចខ្ចីស្កុតបានទេ ?
ខ្ញុំចង់ផ្ញើរវានេះដោយការផ្ញើរតាមអាកាសទៅប្រទេសជប៉ុន ។
តើវាត្រូវការរយះពេលប៉ុន្មានដើម្បីទៅដល់ប្រទេសជប៉ុនដោយតាមការផ្ញើរតាមអាកាស ?
តើវាមានតំលៃប៉ុន្មានទៅដល់ប្រទេសជប៉ុនដោយការផ្ញើរតាមអាកាស ?
តើដល់ប៉ុន្មានគីឡូដែលពួកយើងអាចផ្ញើរសំរាប់ចំនួនប្រាក់នោះ ?
តើវាមានតំលៃប៉ុន្មានដើម្បីធានាពីររយផោន ?
ខ្ញុំចង់យកវា ។
ពួកវាគឺរបស់របរផ្ទាល់ខ្លួន ។
ខ្ញុំចង់ផ្ញើរទូរសារមួយទៅកាន់ប្រទេសជប៉ុន ។
ខ្ញុំចង់ផ្ញើររបស់នេះដោយការផ្ញើរដោយមានការសងប្រសិនបើបាត់ទៅប្រទេសជប៉ុន ។
ខ្ញុំចង់ផ្ញើររបស់នេះជារបស់បោះពុម្ភទៅកាន់ប្រទេសជប៉ុន ។
តើវាត្រូវការរយះពេលប៉ុន្មានដើម្បីទៅដល់ប្រទេសជប៉ុនដោយតាមការផ្ញើរតាមដីគោកនិងសមុទ្រ ?
តើដល់ប៉ុន្មានគីឡូដែលពួកយើងអាចផ្ញើរសំរាប់ចំនួនប្រាក់ដប់ដុល្លារ ?
សូមអោយអារហ័ស ។
ពួកវាគឺសំលៀកបំពាក់ ។
ពួកវាគឺនំចំណី ។
ពួកវាគឺវត្ថុធ្វើដោយដៃ ។
ខ្ញុំចង់ផ្ញើទូរលេខមួយទៅកាន់ប្រទេសជប៉ុន ។
សូមផ្ញើរទូរសារនេះ ។
សូមបែបបទទូរលេខមួយ ។
សូមផ្ញើរវានេះដោយទូរលេខ ។
តើមានកន្លែងលេងកីឡាថេននីសជុំវិញនេះទេ ?
តើពួកយើងអាចជួលកន្លែងលេងឥលូវបានទេ ?
តើអ្នកអាចដាក់ខ្ញុំត្រលប់មកវិញសំរាប់រយះពេលមួយម៉ោងនៅម៉ោងបីថ្ងៃត្រង់ទេ ?
តើវាមានតំលៃប៉ុន្មានសំរាប់មួយម៉ោង ?
តើពួកយើងអាចជួលរ៉ាកែតនិងបាល់បានទេ ?
តើពួកយើងអាចលេងជាមួយនិងស្បែកជើងទាំងនេះបានទេ ?
ខ្សែគឺចាស់អស់ហើយ ។
តើមានកន្លែងលេងកូនគោលនៅជុំវិញនេះទេ ?
តើពួកយើងអាចជួលកន្លែងលេងនៅថ្ងៃស្អែកបានទេ ?
តើអ្នកអាចធ្វើការកក់សំរាប់កីឡាកូនគោលទេ ?
តើពួកយើងអាចលេងឥលូវបានទេ ?
ខ្ញុំអាចកក់វាបានប្រសិនបើអ្នកចាប់ផ្តើមនៅម៉ោងប្រាំបួន ។
តើពួកយើងអាចជួលសំលៀកបំពាក់លេងកីឡាកូនគោលទេ ?
តើអ្នកដឹងពីប្រវែងនៃដំបងដែលអ្នកនឹងត្រូវការទេ ?
សូមសាមសិបប្រាំបីអ៊ិន ។
ខ្ញុំចង់ទៅហែលទឹក ។
តើអ្នកអាចណែនាំនូវឆ្នេរសមុទ្រល្អមួយទេ ?
តើខ្ញុំអាចរៀនថ្នាក់ដំបូងបានទេ ?
ខ្ញុំមិនដែលបានធ្វើវាពីមុនមកទេ ។
ខ្ញុំធ្លាប់ជ្រមុជទឹកពីមុនប៉ុន្តែខ្ញុំមានសញ្ញាប័ត្រទេ ។
តើភាពច្បាស់ថ្ងៃនេះយ៉ាងម៉េចដែរ ?
តើពួកយើងអាចលេងនៅថ្ងៃទីប្រាំបីបានទេ ?
ខ្ញុំចូលចិត្តការជ្រមុជទឹកដោយប្រើអុកស៊ីសែន ។
តើអ្នកអាចណែនាំនូវអាងហែលទឹកល្អមួយទេ ?
តើអ្នកអាចណែនាំកន្លែងជ្រមុជទឹកដ៏ល្អមួយទេ ?
តើមានកន្លែងកំសាន្តលេងស្គីជាមួយនិងទេសភាពល្អទេ ?
តើមានចំណោទសំរាប់អ្នករៀនដំបូងទេ ?
តើខ្ញុំអាចសូមមានផែនទីនៃចំណោទទេ ?
តើចំណោទមួយណាសំរាប់អ្នករៀនដំបូង ?
តើខ្ញុំអាចជួលសំលៀកបំពាក់លេងស្គីទេ ?
ខ្ញុំចង់ជួលសំលៀកបំពាក់លេងស្គី ។
តើខ្ញុំអាចទទួលបានសំបុត្រអនុញ្ញាតសំរាប់មួយថ្ងៃនៅឯណា ?
តើកន្ត្រក់ឈប់នៅម៉ោងប៉ុន្មាន ?
តើមួយណាគឺចាងហ្វ្រា ?
ខ្ញុំបានជ្រុះដងដោលស្គីមួយ ។
សូមទូរស័ព្ទទៅកងអង្គទ័ពសង្គ្រោះ ។
តើខ្ញុំអាចទទួលបានសៀវភៅនៃប័ណ្ណកន្ត្រក់នៅឯណា ?
តើខ្ញុំអាចធ្វើការណាត់ជួបសំរាប់ស្អែកព្រឹកទេ ?
ចុះថ្ងៃត្រង់នេះម៉ោងមួយយ៉ាងម៉េចដែរ ?
សូមការកក់សក់និងការកាត់សក់ ។
សូមអ៊ុតសក់នៅថ្ងាសតែប៉ុណ្ណោះ ។
