គឺថ្លៃសមាជិកភាពដែលបានរួមបញ្ចូលនៅក្នុងតម្លៃនេះ ?
ត្រូវបានកម្រៃរបស់អ្នកប្រើអាងរបស់រួមបញ្ចូលនៅក្នុងតម្លៃ ?
ត្រូវបានកម្រៃសេវាសម្រាប់ការកម្សាន្តកម្សាន្តដែលរួមបញ្ចូល ?
តើតម្លៃនេះរួមបញ្ចូលទាំងថ្លៃចូល ?
សេវាដែលរួមបញ្ចូល ?
ការធានារ៉ាប់រងបានរួមបញ្ចូល ?
សំបុត្រការត្រឡប់មកវិញបានរួមបញ្ចូល ?
សៀវភៅមគ្គទេសក៍មួយបានរួមបញ្ចូល ?
ការចំណាយលើសំបុត្ររួមបញ្ចូល ?
អាហារពេលល្ងាចរួមបញ្ចូល ?
ការដឹកជញ្ជូនរួមបញ្ចូល ?
តម្លៃចូលរៀនដែលបានរួមបញ្ចូល ?
តើតម្លៃសម្រាប់ដំណើរទស្សនកិច្ចរថយន្តក្រុងនេះរួមមានអាហារថ្ងៃត្រង់ពន្លឺ ?
តើនេះរួមបញ្ចូលទាំងថ្លៃចូលទៅទាំងអស់នៃវត្ថុតាងសិល្បៈ ?
តើនេះរួមបញ្ចូលទាំងអាហារពេលព្រឹកក៏ដូចជាកន្លែងស្នាក់ ?
គឺជាតម្លៃជាមួយនិងការចំណាយលើសំបុត្ររួមនេះតើមានអ្វីរួមទាំង ?
តើតម្លៃនេះរួមបញ្ចូលទាំងការជិះ ?
តើតម្លៃនេះរួមបញ្ចូលទាំងទ្រនាប់ពែងយន្តហោះនេះ ?
អ្នកអាចចុះបន្តិចបន្ថែមទៀតលើតម្លៃ ?
គឺមានតម្លៃនេះអាចចរចារបាន ?
តើធ្វើដូចម្តេចច្រើននៃការបញ្ចុះតម្លៃមួយដែលអ្នកនឹងផ្តល់ឱ្យខ្ញុំ ?
តើអ្នកមិនអាក្រក់តម្លៃដប់ដុល្លារ ?
តើអ្នកនឹងផ្តល់ឱ្យខ្ញុំនូវការបញ្ចុះតម្លៃមួយប្រសិនបើខ្ញុំទិញជាងបី ?
ខ្ញុំនឹងទិញវាប្រសិនបើអ្នកផ្តល់ឱ្យការសម្រាកនៅលើតម្លៃមួយខ្ញុំ ។
តើខ្ញុំអាចទទួលបានការបញ្ចុះតំលៃដប់ភាគរយ ?
តើអ្នកមានឆន្ទៈក្នុងការគោះតម្លៃចុះទៅប្រាំពីរដុល្លារ ?
តើអ្នកអាចធ្វើឱ្យវាមានចំនួនសរុបដុល្លារដប់ប្រាំ ?
តើអ្នកអាចមិនមកចុះបន្តិចបន្ថែមទៀត ?
តើការសម្រាកតម្លៃមួយដែលអ្នកនឹងផ្តល់ឱ្យខ្ញុំ ?
ប្រសិនបើអ្នកបានផ្តល់នូវការបញ្ចុះតម្លៃមួយខ្ញុំ ខ្ញុំមានឆន្ទៈក្នុងការទិញការពិតមួយចំនួន ។
អ្វីដែលខ្ញុំបានទទួលជាមួយខ្ញុំគឺប្រាំពីរដុល្លារ ។
ខ្ញុំខ្លាចខ្ញុំមិនអាចមានលទ្ធភាពទិញវា ។
អ្នកអាចផ្លាស់ប្ដូរនេះសម្រាប់ខ្ញុំ ?
ខ្ញុំចង់ផ្លាស់ប្ដូរនេះសម្រាប់ខ្ញុំ ។
អ្នកអាចផ្លាស់ប្ដូរនេះទៅក្នុងវិក័យប័ត្រមួយដុល្លារ ?
តើអ្នកអាចផ្តល់ឱ្យខ្ញុំនូវការផ្លាស់ប្ដូរមួយចំនួនតូចនេះ ?
ខ្ញុំចង់វិក័យប័ត្រប្រាក់ដុល្លារចំនួនបួនប្រាំនាក់និងនៅសល់នៅក្នុងការផ្លាស់ប្ដូរ ។
តើអ្នកអាចផ្តល់ឱ្យខ្ញុំនូវការផ្លាស់ប្ដូរក្នុងបរិមាណនេះ ?
តើមានកន្លែងណាមួយដើម្បីផ្លាស់ប្ដូរប្រាក់នៅលើថ្ងៃឈប់សម្រាក ?
ខ្ញុំចង់ប្រាំដប់វិក័យប័ត្រប្រាក់ដុល្លារនិងដប់ប្រាំវិក័យប័ត្រប្រាក់ដុល្លារ ។
តើមានកន្លែងប្ដូរលុយបរទេសនៅជុំវិញនៅទីនេះ ?
ខ្ញុំចង់ផ្លាស់ប្ដូរប្រាក់យ៉េនទៅជាប្រាក់ដុល្លារ ។
ខ្ញុំចង់ផ្លាស់ប្ដូរជាច្រើនតូច ។
អ្នកអាចបំបែកវិក័យប័ត្រនេះសម្រាប់ខ្ញុំ ?
អ្នកអាចសូមផ្លាស់ប្ដូរសែសិបពាន់យ៉េន ?
ដែលបានមកដល់សរុបចំនួនមួយរយហុកសិបដុល្លារ ។
ដោយវិធីនេះខ្ញុំអាចពិនិត្យប្រាក់នេះផងដែរ ?
ខ្ញុំពិតជាសោកស្តាយប៉ុន្តែយើងមិនអាចធ្វើវាសម្រាប់អ្នកនៅទីនេះ ។ អ្នកនឹងត្រូវតែព្យាយាមធនាគារ ។
បាទមានមួយចុះផ្លូវចេញមុខទៅខាងស្ដាំ ។
ខ្ញុំចង់ធ្វើឱ្យមានការកក់ ។
ខ្ញុំបានកក់សំបុត្រចូលទស្សនាចំនួនពីររួចទៅហើយសម្រាប់យប់នេះ ។
ខ្ញុំចង់កក់សំបុត្រយន្តហោះសម្រាប់ញូវយ៉ក ។
ខ្ញុំចង់ធ្វើឱ្យការកក់សូម ។
ខ្ញុំចង់កក់សំបុត្រហ៊ុនអាកាសចរណ៍មួយ ។
ខ្ញុំចង់ធ្វើឱ្យការកក់អាហារពេលល្ងាច ។
ខ្ញុំចង់ធ្វើឱ្យការកក់អាហារពេលល្ងាចសម្រាប់បួននាក់ ។
ខ្ញុំចង់កក់សំបុត្រពីរ ។
តើខ្ញុំអាចធ្វើឱ្យការកក់ ?
ខ្ញុំចង់ធ្វើឱ្យការកក់សម្រាប់មនុស្សបីនាក់សម្រាប់ប្រាំពីរម៉ោង ។
តើខ្ញុំអាចមានតុការកក់បានទេ ?
ខ្ញុំមានការកក់មួយនៅលើសហរដ្ឋ ជើងហោះហើរមួយចំនួនប្រាំពីរបី ។
ត្រូវបានគេកក់បានទាមទារ ?
ខ្ញុំមានការកក់រួចទៅហើយ ។
យើងចង់កៅអីដោយបង្អួច ។
គឺជាកន្លែងអង្គុយដោយបង្អួចមួយដែលអាចប្រើបាន ?
ជាកៅអីដែលមិនមែនជាការជក់បារីអាចប្រើបាន ?
ខ្ញុំចង់ថ្នាក់ដំបូង ។
សូមធ្វើឱ្យវាបន្ទប់តែមួយជាមួយនិងការងូតទឹកនិងផ្កាឈូក ។
សូមធ្វើឱ្យវាបន្ទប់ពីរដងមួយដែលមានផ្កាឈូក ។
តើមានបន្ទប់ឯកជនណាមួយដែលអាចប្រើបាន ?
សូមផ្តល់នូវតារាងមួយដែលពួកយើងជាមួយនិងទិដ្ឋភាពដ៏ល្អនៃការបង្ហាញនេះ ។
សូមផ្តល់ឱ្យយើងនូវកៅអីឡើងមុខមួយ ។
ខ្ញុំចង់ថាជាមួយនិងទិដ្ឋភាពដ៏អស្ចារ្យមួយ ។
យើងចូលចិត្តតុយ៉ាងនោះ ។
ដែលតារាងរបស់យើងគឺជា ?
យើងចង់បានអាសនៈនៅច្រកផ្លូវបាន ។
ខ្ញុំចង់ផ្លាស់ប្ដូរទិសដៅ ។
ខ្ញុំចង់ផ្លាស់ប្ដូរកាលបរិច្ឆេទ ។
ខ្ញុំចង់ផ្លាស់ប្ដូរពេលវេលាកក់នេះ ។
តើខ្ញុំអាចផ្លាស់ប្ដូរនេះទៅម្ភៃប្រាំ ?
តើធ្វើដូចម្តេចអំពីម្ភៃទី ?
ខ្ញុំចង់បន្តការស្នាក់នៅរបស់ខ្ញុំ ។
ខ្ញុំចង់លុបចោលសំបុត្ររបស់ខ្ញុំ ។
ខ្ញុំចង់ផ្លាស់ប្ដូរថ្ងៃនៃការចាកចេញរបស់ខ្ញុំ ។
តើខ្ញុំគួរតែទៅបង់ប្រាក់សម្រាប់ការនេះ ?
តើអ្នកអាចស្នាក់នៅបន្ថែមពីរថ្ងៃទៀតបានទេ ?
តើមានការចោទប្រកាន់ចំពោះការលុបចោលមួយ ?
អ្នកអាចបង់ឱ្យខ្ញុំត្រឡប់មកវិញសម្រាប់សំបុត្រនេះ ?
ខ្ញុំចង់បញ្ជាក់សំបុត្រក្រុមហ៊ុនអាកាសចរណ៍របស់ខ្ញុំ ។
ខ្ញុំចង់បញ្ជាក់ថាការកក់សណ្ឋាគារខ្ញុំ ។
ខ្ញុំចង់បញ្ជាក់ពេលវេលាដែលការចាកចេញនេះ ។
ខ្ញុំចង់បញ្ជាក់ធាតុដែលខ្ញុំបានបញ្ជាឱ្យ ។
ខ្ញុំអាចបញ្ជាក់ពីចំនួនទឹកប្រាក់ដែលបាន ?
ខ្ញុំចង់ពិនិត្យមើលដើម្បីមើលថាតើឥវ៉ាន់បានមកដល់ ។
ខ្ញុំចង់បញ្ជាក់ចំនួននៅលើរថយន្តជួលរបស់ខ្ញុំ ។
ខ្ញុំចង់ពិនិត្យមើលជាថ្មីម្តងទៀតដែលជាកន្លែងដែលវាជាការដែលយើងនឹងនៅថ្ងៃស្អែក ។
