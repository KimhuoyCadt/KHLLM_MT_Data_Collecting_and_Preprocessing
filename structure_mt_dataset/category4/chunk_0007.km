ទាំងអស់ស្តាំសម្រាកលោកស្រីគីមូរា ។ ខ្ញុំកំពុងតែព្យាយាមតែមួយគត់ដើម្បីធ្វើការងាររបស់ខ្ញុំ ។
ខ្ញុំដឹង ។ ខ្ញុំពិតជាសោកស្តាយដែលខ្ញុំបានស្រែកនៅអ្នក ។
ស្ត្រីនៅទីនេះលោកស្រីលោក ។
សូមអញ្ជើញមកវិធីនេះលោកស្រីលោក ។
ឥឡូវនេះអ្វីដែលហាក់ដូចជាមានបញ្ហានេះលោកស្រីលោក ?
ខ្ញុំមានការឈឺចាប់ដ៏គួរឱ្យភ័យខ្លាចក្នុងក្រពះរបស់ខ្ញុំ ។
ខ្ញុំយល់ ។ តើមានការឈឺចាប់នេះបានកើតឡើង ?
ចាប់តាំងពីចុងយប់មុន ។
ខ្ញុំយល់ ។ សូមមើល យើងនឹង ? អ្នកអាចលើកឡើងយឺតដ៏ស្រស់ស្អាតរបស់អ្នក ? អ្នកមិនបរិភោគអ្វីទៅកាលពីម្សិលមិញ ?
តើអ្នកក្អួតឬតើអ្នកមានការរត់នេះ ?
ជាការប្រសើរណាស់ ដែលអាចជាឈឺក្រពះពី បរិភោគច្រើនពេក ។ អាឡែស៊ីទៅនឹងថ្នាំឬទេ ?
តើមានបញ្ហាបេះដូងទៀតទេ ?
អូខេ លោកគ្រូពេទ្យ ។ អរគុណច្រើន ។
ខ្ញុំពិតជាសោកស្តាយ ។ មើលខ្ញុំនឹងបង់ប្រាក់សម្រាប់អ្វីគ្រប់យ៉ាង ។ គ្រាន់តែមិនបានហៅប៉ូលីស ។ នឹងឪពុកខ្ញុំសម្លាប់ខ្ញុំ ។
សូមទោសខ្ញុំត្រូវ ។ ខ្ញុំក៏មានការហៅរិយាល័យជួលមួយរថយន្ត ។
រហ័សជួលរថយនអេ ។ តើខ្ញុំអាចជួយអ្នកបាន ?
ខ្ញុំមានដំណឹងអាក្រក់ ។
ខ្ញុំជាខាងក្រោយ-បញ្ចប់គ្រាន់តែឥឡូវនេះនៅលើផ្លូវទាំងពីរចិតសិបរវាងដាំដើមមនឈើនិងក្រិច ។ ហើយវាបានធ្លាក់ចុះតិចតួចនៅក្នុងការកាងនេះ ។
វាពិតជាមានតម្រូវការក្នុងការបារម្ភថាជាអ្នកមានការទទួលខុសត្រូវគ្របដណ្តប់គ្រោះថ្នាក់នោះទេ ។ គ្រាន់តែហៅប៉ូលីសនិងទទួលបានច្បាប់ចម្លងនៃរបាយការណ៍នេះ ។ តើអ្នកដឹងថាចំនួនដើម្បីហៅទូរស័ព្ទទៅប៉ូលីសបានដែរឬទេ ?
បាទខ្ញុំគិតថាដូច្នេះ ។ វាជាប្រាំបួននាក់បីនាក់ដប់ប្រាំបីរយនាក់នៅខាងស្ដាំ ?
នោះហើយជាវា ។ អ្នកអាចផ្លាស់ប្ដូររថយន្តរបស់អ្នកនៅការិយាល័យជិតបំផុតរបស់យើង ។
ខ្ញុំនឹងធ្វើវា ។ សូមអរគុណអ្នកខ្លាំងណាស់ ។
អ្នកឯងស្វាគមន៍ ។ អ្នកថែរក្សានិងការបើកបរមានសុវត្ថិភាព ។ ជម្រាបលា ។
មិនអីទេតើមានអ្វីកើតឡើង ?
មន្ត្រីខ្ញុំបានទទួលខាងក្រោយ-បញ្ចប់ ។
តើត្រឹមត្រូវកូនប្រុស ?
មិនអីទេ នេះហាក់ដូចជាច្បាស់លាស់ណាស់កាត់បន្ថយ ។ ទាំងពីរនៃអ្នកសូមផ្តល់ឱ្យខ្ញុំនូវអាជ្ញាប័ណ្ណនិងការចុះបញ្ជីរបស់អ្នក ។ ហើយកូនប្រុសខ្ញុំខ្លាចយើងនឹងមានការផ្តល់ឱ្យអ្នកនូវការធ្វើតេស្តខ្យល់ដកដង្ហើមមួយ ។
តើមានទីផ្សារនៅជិតទីនេះទេ ?
ខ្ញុំចង់ទទួលបានខ្សែភាពយន្តមួយចំនួន ។
អ្នកនឹងទទួលបានវានៅនាយកដ្ឋានកាមេរ៉ា ។
ដែលជាកន្លែងដែលសូមជាការដ្ឋានអាហារ ?
វាជានៅជាន់ទីនេះ ។
យើងបានបើកនៅម៉ោងដប់និងជិតស្និទ្ធនៅប្រាំមួយ ។
តើអ្នកកំពុងតែស្វែងរកអ្វីមួយពិសេស ?
សូមយកពេលវេលារបស់អ្នក ។ ប្រសិនបើអ្នកចង់បានជំនួយណាមួយដែលអនុញ្ញាតឱ្យខ្ញុំដឹង ។
ខ្ញុំចង់ក្រម៉ាមួយចំនួន ។
មួយណា ? តើអ្នកមានន័យមួយនេះ ?
ទេមួយទៅស្ដាំពណ៌ក្រហមមួយ ។
តើអ្នកមានលំនាំផ្សេងទៀតណាមួយទេ ?
តើអ្នកមានអ្វីដែលធ្វើពីសូត្រ ?
វាត្រូវបានធ្វើពីរោមចៀម ។
នេះគឺជាការក្រាស់ ។
យើងមានពណ៌ត្នោត ។
ខ្ញុំគិតថាមួយនេះ ។
តើអ្នកគិតថាមួយនេះសម្រាប់ខ្ញុំ ?
បាទ ខ្ញុំដូច្នេះដែរ ។ មើលស្រស់ស្អាត ។
តើអ្នកមានអាវពណ៌ខៀវនេះតូច ?
សូមវាស់ករបស់ខ្ញុំ ។
ខ្ញុំចង់ចាយបានយូរជាងនេះបន្តិច ។
អ្វីដែលត្រូវការនេះត្រូវបានប្រើសម្រាប់ ?
សូមដេរអាទិសង្កេតរបស់ខ្ញុំនៅលើ ។
តើថ្លៃប៉ុន្មាសម្រាប់ពន្ធនេះ ?
តើខ្ញុំអាចមានការបញ្ចុះតម្លៃទេ ?
ខ្ញុំខ្លាចវានៅតែមានតម្លៃថ្លៃពេកសម្រាប់ខ្ញុំ ។
តើធ្វើដូចម្តេចអំពីចិតសិបដុល្លារ ?
ដែនកំណត់នៃថវិការបស់ខ្ញុំនេះគឺជាពីររយដុល្លារ ។
ប្រសិនបើអ្នកបានកាត់បន្ថយតម្លៃដោយចំនួនដប់ភាគរយខ្ញុំនឹងទិញវា ។
ខ្ញុំមិនអាចរកឃើញមួយដែលខ្ញុំចូលចិត្ត ។
ជាការពិតណាស់យើងបានធ្វើ ។
សូមទោសយើងធ្វើមិនបាន ។ តែសាច់ប្រាក់ ។
តើអ្នកអាចបង្ហាញខ្ញុំឱ្យលេខសម្គាល់ខ្លះទេ ?
នេះគឺដប់ដុល្លារខ្លី ។
ខ្ញុំបានបង់អ្នកជាមួយនិងការវិក័យប័ត្ររយដុល្លារ ។
អ្នកមិនខុសទេ ។ យើងជាអ្នកមានកំហុស ។
អ្នកអាចដាក់វាក្នុងកាបូបមួយ ?
អ្នកអាចផ្ញើវាទៅកាន់ប្រទេសជប៉ុនដោយខ្យល់ ?
សេវានោះគឺមិនអាចរកបាន ។
តាមផ្លូវវានោះជាអ្វី ?
អ្នកនឹងត្រូវគ្របដណ្តប់វា ។
វាជាដោយឥតគិតថ្លៃ ។
ខ្ញុំគិតថាវាត្រូវចំណាយពេលប្រហែលពីរថ្ងៃ ។
កាលពីម្សិលមិញខ្ញុំបានទិញនេះហើយវាជាការខូច ។
តើអ្នកដឹងថាហាងដែលជាកន្លែងដែលខ្ញុំអាចទទួលបានវាថេរមួយ ?
នេះមិនធ្វើការឱ្យបានល្អ ។
ខ្ញុំគិតថាមានអ្វីមួយខុសជាមួយនិងវា ។
វាត្រូវបានគ្របដណ្តប់នៅតែមានដោយធានាបាន ។
អ្នកនឹងត្រូវតែរង់ចាំយ៉ាងហោចណាស់ពីរថ្ងៃ ។
អ្នកអាចធ្វើវាបានឆាប់ ?
តើខ្ញុំអាចមានវានាពេលបច្ចុប្បន្ននេះ ?
ខ្ញុំត្រូវការវានៅខាងស្ដាំទៅឆ្ងាយ ។
អំពីរបៀបដែលវានឹងត្រូវចំណាយអស់ ?
តើមានទីភ្នាក់ងារទេសចរណ៍មួយនៅជិតនៅទីនេះ ?
សូមបង្ហាញខ្ញុំពីរបៀបដើម្បីទទួលបានដើម្បីផូអេនិច ។
វិធីដ៏ល្អបំផុតដើម្បីទទួលបានតាមផ្លូវដែលជាអ្វី ?
នេះជាវិធីដែលលឿនបំផុតគឺការយករថយន្ដក្រុងមួយ ។
តើខ្ញុំអាចយកផ្លូវក្រោមដីដើម្បីឱ្យកងម៉ារីនអគារនេះ ?
តើរថភ្លើងនេះបានចូលទៅដោយផ្ទាល់ទៅរីជប៉ុន ?
តើខ្ញុំត្រូវផ្លាស់ប្ដូរ ?
អ្នកនឹងមានការផ្លាស់ប្ដូរនៅអាត្លង់តា ។
ចូរយករថភ្លើងក្នុងស្រុកនៅអាត្លង់តា ។
បន្ទាប់មកផ្លាស់ប្ដូរដើម្បីបង្ហាញនេះ ។
ទទួលបានបិទនៅឯស្ថានីយ៍ វិចតូរៀ និងយកបន្ទាត់ខាងកើតភាគខាងលិច ។
នៅពេលដែលរថយន្តក្រុងដំបូងសម្រាប់ក្រុងដែនវ័រជាអ្វី ?
វាជានៅម៉ោងប្រាំពីរសាមសិបនាទីយប់ ។
វាបានមកដល់នៅក្នុងប្រទេសប៊ូឡេន នៅថ្ងៃត្រង់ ។
ខ្ញុំអាចទទួលបានរថយន្តសម្រាប់អូឡាំបិចនៅកន្លែងណា ?
បង្អួចដែលជាកន្លែងដែលសំបុត្រហើយ ?
តើអ្នកអាចប្រាប់ខ្ញុំដែលជាកន្លែងដែលខ្ញុំអាចទទួលបានសំបុត្រសម្រាប់រថយន្តនេះទេ ?
ឡើងជណ្តើរទៅខាងឆ្វេងរបស់អ្នកហើយអ្នកនឹងរកឃើញវា ។
តើអ្នកមានកន្លែងអង្គុយណាមួយនៅលើប្រាំពីរដប់ប្រាំរថភ្លើង ?
តើសំបុត្រនេះមានសុពលភាពសម្រាប់ ?
ខ្ញុំចង់បានសំបុត្រថ្នាក់ជាលើកដំបូងទៅក្រុងឌេត្រូអេត ។
សូមយកសំបុត្រតែទៅ ។
តើប្រភេទនៃរថភ្លើងដែលអ្នកចង់យក ?
ខ្ញុំចូលចិត្តចង់ឱ្យទៅតាមរថភ្លើងក្នុងតំបន់ ។
តើអ្នកចង់បានអ្វីដែលជាប្រភេទនៃកៅអី ?
ចុះតម្លៃប៉ុន្មានដែរ ?
វាជាទាំងបីដុល្លារ ។
សូមបង់នៅលើរថយន្ដក្រុង ។
ដែលបទគឺសម្រាប់បូស្តុន ?
ដែលបទតើវាទុកឱ្យ ?
វាទុកពីបទបួន ។
នេះជាចំណតរថយន្ដក្រុងត្រឹមត្រូវសម្រាប់ថែមក្វរទ័រ ?
សូមយករថយន្ដក្រុងចំនួនពីរនាក់ ។
និងទទួលបានបិទការឈប់ទីបី ។
តើនេះជារថយន្ដក្រុងត្រឹមត្រូវសម្រាប់ ឡេវូត ?
តើរថយន្តនេះទៅកាន់ទីក្រុងម៉ារីណា ?
ទេវាមិនបានចូលទៅនៅក្បែរទីនោះ ។
អ្នកយករថយន្ដក្រុងនោះ ។
តើរថយន្តនេះទៅកាន់ទីក្រុងប៉ារីស ?
សុំទោស ប៉ុន្តែកៅអីនេះដោយឥតគិតថ្លៃ ?
សុំទោស ។ តើខ្ញុំអាចអង្គុយនៅទីនេះ ?
ប្ដីខ្ញុំនឹងមានត្រឡប់មកវិញឆាប់ ។
អ្នកគួរតែទទួលបានបិទនៅឯទីប្រាំអេវេណុយ ។
តើធ្វើដូចម្តេចជាច្រើនឈប់ទៅនឹងទីប្រាំ អេវណុយមាន ?
មានការឈប់ពីរ ។
វាជាលើកទីពីរឈប់ពីទីនេះ ។
ខ្ញុំខ្លាចអ្នកនៅលើរថភ្លើងខុស ។
តើអ្នកអាចប្រាប់ខ្ញុំពីកន្លែងដែលយើងកំពុងឆ្លងកាត់ឥឡូវនេះ ?
សូមប្រាប់ខ្ញុំនៅពេលដែលយើងបានឈានទៅដល់ថ្ងៃលិចអេវេណុយ ។
កម្មវិធីបញ្ជាខ្ញុំនឹងទទួលបានបិទនៅទីនេះ ។
ខ្ញុំអាចទទួលបានបិទនៅលើវិធីជាមួយនិងសំបុត្រនេះ ?
តើអ្នកចង់បានអ្វីដែលជាប្រភេទរថយន្ត ?
តើអ្នកមានរថយន្តតូចមួយ ?
តើមានមនុស្សប៉ុន្មានថ្ងៃតើអ្នកចង់ជួលរថយន្តនេះ ?
សម្រាប់រយៈពេលប្រាំមួយម៉ោង ។
តើខ្ញុំអាចធ្លាក់ចេញពីរថយន្តនៅអាត្លង់តា ?
អត្រានៃការជួលក្នុងមួយថ្ងៃជាអ្វី ?
សូមបង្ហាញខ្ញុំពីបញ្ជីនៃអត្រាការប្រាក់របស់អ្នក ។
ខ្ញុំនឹងយកអត្រាការប្រាក់ជារៀងរាល់ថ្ងៃនោះ ។
តើការចោទប្រកាន់ដែលរួមមានឧស្ម័ន ?
តើអ្នកណាដែលខ្ញុំគួរហៅក្នុងករណីមានបញ្ហា ?
តើចំនួនអ្នកស្លាប់នេះគឺជា ?
តើមានឧស្ម័នមួយនៅជិតនៅទីនេះ ?
ខ្ញុំចង់ត្រឡប់រថយន្តជួលរបស់ខ្ញុំ ។
ទ្វារនឹងមិនបិទ ។
ការប្រើឧបករណ៍នេសាទនេះនឹងមិនផ្លាស់ប្ដូរ ។
ហ្វ្រាំងនេះនឹងមិនធ្វើការទេ ។
ខ្ញុំមិនដឹងថាមានបញ្ហាអ្វីកើតឡើងជាមួយឡានខ្ញុំ ។
ខ្ញុំមានគ្រោះថ្នាក់ចរាចរណ៍ ។ ខ្ញុំត្រូវបានឡានជល់ ។
រថយន្តរបស់ខ្ញុំបានរអិលធ្លាក់នៅក្នុងភ្លៀង ។
រថយន្តនេះបានរត់នៅលើផ្លូវនោះ ។
វាមិនមែនជាកំហុសរបស់ខ្ញុំ ។ ដែលខ្ញុំមាននៅក្នុងដែនកំណត់ល្បឿន ។
តើខ្ញុំអាចមានវិញ្ញាបនប័ត្រគ្រោះថ្នាក់ចរាចរណ៍មួយបានទេ ?
សូមឱ្យខ្ញុំមើលឃើញអាជ្ញាប័ណ្ណបើកបររបស់អ្នក
ចំណតមិនត្រូវបានអនុញ្ញាតនៅទីនេះ ។
ខ្ញុំគិតថាខ្ញុំបានបាត់បង់វិធីរបស់ខ្ញុំ ។
សណ្ឋាគារដែលជាកន្លែងដែលនៅលើផែនទីនេះគឺជា ?
ខ្ញុំចូលចិត្តចង់ឱ្យទៅនៅទីនេះ ។
សូមបង្ហាញខ្ញុំថាតើស្ថានីយនេះនៅកន្លែងណាផង ។
តើផ្លូវនេះទៅកាន់ទីក្រុងសានតាមូនីហ្គា ?
ដែលវិធីនេះគឺឆ្នេរសមុទ្រនោះ ?
លើសពីទីនោះទៅឆ្វេង ។
វាជានៅពីក្រោយអគារនោះ ។
ឆ្លងកាត់ផ្លូវនោះហើយអ្នកនឹងរកឃើញនៅខាងឆ្វេងរបស់អ្នក ។
ខ្ញុំខ្លាចខ្ញុំពិតផងដែរចម្លែកមួយដែលនៅជុំវិញទីនេះ ។
វាជាការប្រហែលមួយគីឡូម៉ែត្រ ។
វាគឺជាការជិតស្និទ្ធនឹងនៅទីនេះ ?
ប្រាកដណាស់ ។ វាជាការយ៉ាងជិតស្និទ្ធណាស់ ។
អ្នកគួរតែយកឡានតាក់ស៊ីមួយ ។
វាមិនយកទៅតើឧទ្យានឡើងដោយរថយន្ដក្រុងនេះ ?
ខ្ញុំគិតថាវាត្រូវចំណាយពេលប្រហែលដប់នាទីដោយរថភ្លើងក្រោមដី ។
អ្នកអាចយកខ្ញុំនៅទីនោះ ?
ខ្ញុំនឹងនៅទីនោះផងដែរ ។
សុំទោស ប៉ុន្តែជាកន្លែងដែលជាបន្ទប់សល់បានទេ ?
តើខ្ញុំអាចសួរដែលជាកន្លែងដែលបន្ទប់នៅសល់ ?
អ្នកនឹងរកឃើញវានៅចុងបញ្ចប់អ្នកបញ្ចុះបញ្ចូលនេះ ។
តើមានបន្ទប់សំរាកនៅក្បែរនៅទីនេះ ?
បាទមានបន្ទប់សល់ប្រាក់ឈ្នួលមួយនៅស្ថានីយ៍នោះ ។
ប្រាកដណាស់ ។ សូមចេញ ទ្វារនោះហើយវានៅខាងឆ្វេង ។
ខ្ញុំចូលចិត្តចង់ទៅកាន់ការប្រគំតន្ត្រីមួយ ។
តើមានដំណើរទស្សនកិច្ចរបស់កម្មវិធីផ្សេងទេ ?
នៅពេលនិងកន្លែងដែលវាត្រូវបានគេលេង ?
ដែលជាកន្លែងដែលខ្ញុំអាចមើលឃើញការបង្ហាញបានដែរឬទេ ?
អ្នកអាចទទួលពួកគេនៅឯទីភ្នាក់ងារលក់សំបុត្រមួយ ។
តើមានកន្លែងអង្គុយដែលអ្នកចង់ ?
ខ្ញុំចង់កៅអីពីរ ។
ខ្ញុំពិតជាសោកស្តាយនោះទេប៉ុន្តែអាសនៈនេះត្រូវបានលក់ចេញទាំងអស់ ។
នៅពេលដែលមានពួកគេអាចប្រើបាន ?
តើពេលគេចាប់ផ្តើមលេង ?
កអាចលេងអែលក្រុមហ៊ុនអាកាសចរណ៍កូដូប៉ាសា ?
ដែលជាកន្លែងដែលយើងអាចលេងកីឡាវាយកូនគោល ?
តើខ្ញុំអាចលេងកីឡាវាយកូនគោលកាលពីថ្ងៃអាទិត្យក្រោយនេះ ?
ខ្ញុំពិតជាសោកស្តាយនោះទេប៉ុន្តែកាលពីថ្ងៃអាទិត្យក្រោយនេះគឺត្រូវបានកក់យ៉ាងពេញលេញ ។
ថ្ងៃសប្ដាហ៍ណាមួយដែលអ្នកចង់បាន ។
ខ្ញុំអាចធ្វើការកក់សម្រាប់ប្រាំបួនថ្ងៃសៅរ៍នេះ ?
ខ្ញុំចង់ជួលរ៉ាកែតពីរ ។
តើការចោទប្រកាន់លើការពេលវេលាគឺជា ?
វាមានសុវត្ថិភាពសម្រាប់អ្នកចាប់ផ្តើមដំបូង ?
ខ្ញុំចង់យករថយន្ដក្រុងមើលឃើញ-មើលឃើញមួយ ។
តើអ្វីទៅជាប្រភេទនៃដំណើរទេសចរណ៍មាន ?
តើអ្នកមានដំណើរទេសចរណ៍ណាមួយជុំវិញទីក្រុង ?
តើអ្នកបានជាដំណើរទស្សនកិច្ចទាំងអស់ថ្ងៃ ?
វាចាប់ផ្តើមនៅម៉ោងដប់ម៉ោងនៅពេលព្រឹក ។
វាត្រូវចំណាយពេលប្រហែលប្រាំពីរម៉ោង ។
ខ្ញុំចង់ធ្វើឱ្យការកក់មួយសម្រាប់ដំណើរទស្សនកិច្ចនេះ ។
ដែលជាកន្លែងដែលយើងអាចចូលរួមក្នុងដំណើរទស្សនកិច្ចនេះ ?
តើខ្ញុំអាចចូលរួមនៅក្នុងសណ្ឋាគារនេះ ?
ខ្ញុំពិតជាសោកស្តាយគ្មាននរណាម្នាក់និយាយជប៉ុន ។
ខ្ញុំឮថាមានក្លិបចង្វាក់ហ្សាសដ៏ល្អមួយចំនួន ។
ខ្ញុំបានឮគឺមានការសម្តែងមួយនៃការលេងថ្មីមួយ ។
ខ្ញុំពិតជាចាប់អារម្មណ៍ដូច្នេះនៅក្នុងវប្បធម៌អ៊ីស្លាម ។
ខ្ញុំចង់ឃើញផ្ទះរបស់អ្នក ។
តើអ្នកនឹងបង្ហាញខ្ញុំនៅទីនោះ ?
តើអ្នកអាចប្រាប់ខ្ញុំពីចំណុចល្អ ?
ខ្ញុំចង់ទៅទីផ្សារមួយ ។
សូមបង្ហាញខ្ញុំនៅជុំវិញទីក្រុង ។
សូមទទួលបានមកវិញនៅទីនេះដោយប្រាំមួយម៉ោង ។
តើក្នុងមួយថ្ងៃ ? តើធ្វើដូចម្តេចអំពីដប់ដុល្លារ ?
ពិតណាស់ អ្នកធ្វើបាន ។
ខ្ញុំសុំទោសមិនបានទៅតាមទីនោះ ។
ចូរយករូបភាពរបស់អ្នក ។
ខ្ញុំនឹងផ្ញើអ្នកច្បាប់ចម្លងមួយចំនួន ។
តើខ្ញុំអាចមានឈ្មោះនិងអាសយដ្ឋានរបស់អ្នក ?
តើមានរូបថតអភិវឌ្ឍសេវានៅជុំវិញនេះទេ ?
ខ្ញុំចង់វិលជុំមួយនៃខ្សែភាពយន្តពណ៌ជាមួយនិងសាមសិបប្រាំមួយប៉ះពាល់ ។
សូមអភិវឌ្ឍនិងបោះពុម្ភវិលនៃខ្សែភាពយន្តទាំងនេះ ។
ខ្ញុំចង់បញ្ចប់ម៉ាថ ។
អ្នកអាចធ្វើវានៅក្នុងពីរថ្ងៃ ?
តើអ្នកគិតប្រាក់សម្រាប់ការបោះពុម្ភ ?
ខ្ញុំពិតជាមានបញ្ហាធំ ។ ខ្ញុំមិនអាចរកឃើញកាបូបរបស់ខ្ញុំ ។
តើអ្នកអាចបង្ហាញខ្ញុំប្រអប់ប៉ូលីសដែលនៅជិតបំផុត ?
ដែលជាកន្លែងដែលត្រូវបានបាត់បង់និងបានរកឃើញថាការិយាល័យ ?
ខ្ញុំមានកាបូបរបស់ខ្ញុំបានលួចនៅស្ថានីយ៍នេះ ។
តើអ្នកដែលជាកន្លែងដែលដាក់វាខណៈពេលដែលអ្នកបានចេញ ?
ខ្ញុំគិតថាខ្ញុំបានដាក់វានៅក្នុងកាបូបរបស់ខ្ញុំ ។
ខ្ញុំមិនប្រាកដថាជាកន្លែងដែលខ្ញុំបានដាក់វា ។
ខ្ញុំត្រូវបានវាយប្រហារដោយក្រុមមួយ ។
ខ្ញុំអាចនឹងមានច្បាប់ចម្លងនៃរបាយការណ៍របស់អ្នក ?
អ្នកអាចពិនិត្យមើលអាសយដ្ឋានរបស់អាមេរិចប្រេសបានដែរឬទេ ?
ពួកគេត្រូវបានគេចេញផ្សាយនៅការិយាល័យរបស់អ្នកនៅក្នុងទីក្រុងតូក្យូ ។
នេះជាកំណត់ត្រារបស់ខ្ញុំ ។
នៅពេលដែលនិងជាកន្លែងដែលខ្ញុំអាចទទួលពួកគេ ?
អ្នកនឹងត្រូវរង់ចាំមួយសប្ដាហ៍ ។
សូមពិនិត្យមើលអាសយដ្ឋានរបស់ស្ថានទូតជប៉ុន ។
ខ្ញុំចង់អនុវត្តសម្រាប់បញ្ចេញម្តងទៀតនៃលិខិតឆ្លងដែនរបស់ខ្ញុំ ។
តើយើងត្រូវការទិដ្ឋាការសម្រាប់ប្រទេសបារាំងមួយបានទេ ?
ខ្ញុំចង់ដាក់ពាក្យសុំទិដ្ឋាការឆ្លងកាត់មួយ ។
សូមផ្តល់ឱ្យខ្ញុំនូវទម្រង់ពាក្យសុំទិដ្ឋាការ ។
តើធ្វើដូចម្តេចជាច្រើនរូបថតតើខ្ញុំត្រូវការ ?
ខ្ញុំចង់បន្តការស្នាក់នៅរបស់ខ្ញុំសម្រាប់រយៈពេលប្រាំថ្ងៃ ។
វាត្រូវបានផ្ញើដោយលួស ។
ដែលជាកន្លែងដែលសូមជាឱសថ ?
តើអ្នកមានវេជ្ជបញ្ជាពីគ្រូពេទ្យទេ ?
ទេខ្ញុំមិន ។ តើវាជាសិទ្ធិទាំងអស់ដោយគ្មានវេជ្ជបញ្ជាទេ ?
ខ្ញុំចង់ថ្នាំមួយចំនួនសម្រាប់ជំងឺផ្តាសាយ ។
តើអ្នកមានឡេភ្នែកទេ ?
ថ្នាំនេះធ្វើការផងដែរ ។
តើមានមនុស្សប៉ុន្មានដងខ្ញុំគួរតែយកវាក្នុងមួយថ្ងៃ ?
សូមយកវាមុនពេលគេង ។
អ្នកមិនត្រូវបានគេកំពុងសម្លឹងរកមើលបានយ៉ាងល្អ ។ តើជាអ្វីខុស ?
ភរិយារបស់ខ្ញុំបានដួលរលំ ។
អ្នកគួរតែយកថ្នាំមួយចំនួន ។
អ្នកអាចសូមផ្ដល់អនុសាសន៍គ្រូពេទ្យទេ ?
តើប្រភេទនៃការឈឺចាប់ដែលអ្នកមាន ?
ខ្ញុំឈឺក្បាល ។
ទ្រូងរបស់ខ្ញុំត្រូវបានសង្កត់ ។
ខ្ញុំមានកន្ទួលមួយទាំងអស់នៅលើរាងកាយរបស់ខ្ញុំ ។
បាទ ។ ខ្ញុំមានគ្រុនក្តៅមួយ ។
ជំងឺគ្រុនរបស់ខ្ញុំបានធ្លាក់ចុះ ។
វាមានឈាមនៅក្នុងទឹកនោមរបស់ខ្ញុំ ។
វាឈឺណាស់ពេលដែលខ្ញុំបត់ជើងតូច ។
ខ្ញុំមានធ្មេញអាក្រក់ ។
ដំបៅមានកកខ្ទុះ ។
ខ្ញុំសូមពិនិត្យមើលបំពង់ករបស់អ្នក ។
បើកមាត់របស់អ្នកធំទូលាយ ។
ខ្ញុំអាចព្យាបាលជំងឺរបស់ខ្ញុំបានយ៉ាងដូចម្តេច ?
អ្នកត្រូវការសម្រាកយ៉ាងហោចណាស់រយៈពេលពីរថ្ងៃ ។
តើវានឹងយកទៅសង្គ្រោះផងដែរ ?
ខ្ញុំបានកើនឡើងវិញជិត ។
នៅពេលដែលខ្ញុំអាចចាកចេញពីមន្ទីរពេទ្យនោះ ?
តើខ្ញុំអាចប្រើទម្រង់បែបបទការធានារ៉ាប់រងនេះទេ ?
សូមទោសអ្នកមិនអាចប្រើវាបាននៅទីនេះ ។
តើខ្ញុំអាចប្ដូរទៅកន្លែងនោះបានទេ ?
មាននរណាម្នាក់កំពុងអង្គុយកៅអីរបស់ខ្ញុំ ។
នេះគឺជាផ្នែកដែលមិនជក់បារី ?
អ្នកអាចរក្សាទុកអាវរបស់ខ្ញុំ ?
តើអ្វីទៅជាពេលដែលយើងនឹងមកដល់ ?
យើងមាននៅលើកាលវិភាគ ?
ម៉ោងក្នុងស្រុកនេះឥឡូវនេះជាអ្វី ?
តើធ្វើដូចម្តេចជាច្រើនម៉ោងដើម្បីទទួលបានទៅទីក្រុងឡុងដ៍ ?
តើអ្វីទៅជាពេលដែលវាគឺឥឡូវនេះ ? តើទីក្រុងឡុងដ៍ម៉ោង ?
សុំទោស ខ្ញុំអាចមានខូ ?
ខ្ញុំចង់សាច់អាំងពីភរិយាខ្ញុំ ។
តើខ្ញុំអាចមានអ្វីដែលក្តៅ ?
អ្នកអាចជួសជុលឱ្យខ្ញុំផឹកមួយទៀត ?
តើអ្នកមានទស្សនាវដ្តីប្រចាំសប្ដាហ៍ទេ ?
នៅពេលដែលអ្នកនឹងលក់ទំនិញរួចពន្ធលើក្រុមប្រឹក្សាភិបាល ?
ដែលជាកន្លែងដែលថង់ខ្យល់ជំងឺមួយដែលជាការ ?
អ្នកអាចសួរគាត់ដើម្បីបញ្ឈប់ការជក់បារីនៅទីនោះ ?
តើអ្នកធ្វើដំណើរសម្រាប់ធុរកិច្ច ?
កីឡាបាល់ទាត់ និងស៊ូម៉ូគឺមានការពេញនិយមយ៉ាងខ្លាំង ។
បានប្រាក់ខែចាប់ផ្តើមបន្ទាប់ពីបញ្ចប់ការសិក្សានៅក្នុងប្រទេសជប៉ុនគឺជាអ្វី ?
ប្រហែលមួយរយប៉ែតសិបម៉ឺនយ៉េនគឺជាការធម្មតា ។
យើងអាចធ្វើការដើរទិញឥវ៉ាន់មួយចំនួននៅក្នុងបន្ទប់ឆ្លងកាត់បានដែរឬទេ ?
ខ្ញុំចង់ពិនិត្យមើលនៅក្នុងការហោះហើរបន្ទាប់ទៀតរបស់ខ្ញុំ ។
បាទនៅទីនេះជាលិខិតឆ្លងដែនរបស់ខ្ញុំ ។
ខ្ញុំគ្រាន់តែនៅក្នុងការឆ្លងកាត់ ។
ខ្ញុំជាមួយនិងក្រុមមួយ ។
បីពាន់ដុល្លារនៅក្នុងសាច់ប្រាក់ ។
សុំទោស ខ្ញុំនេះគឺជាបន្ទាត់ដែលអ្នកគួរតែនៅចុងបញ្ចប់នោះ ។
វាជាវ៉ាលីពណ៌ខ្មៅដ៏ធំមួយ ។
សុំទោស អ្នកស្រី ។
បាទ ស្រាសាកិជប៉ុនពីរដប ។
តើអ្នកមានគ្រាប់ពូជរុក្ខជាតិឬ ?
តើខ្ញុំនឹងត្រូវបង់ពន្ធនោះ ?
វិក័យប័ត្រដប់ប្រាក់ដុល្លារចំនួនប្រាំនិងការផ្លាស់ប្ដូរខ្នាតតូច ។
ខ្ញុំចង់ផ្លាស់ប្ដូរខ្នាតតូច ។
ដែលជាកន្លែងដែលស្តង់ទូរស័ព្ទហើយ ?
ពេលនេះខ្ញុំពិតជានៅព្រលានយន្តហោះហើយខ្ញុំនឹងមាននៅក្នុងពីរម៉ោង ។
តើមានផ្លូវក្រោមដីដើម្បីឱ្យទីក្រុងនេះទេ ?
តើនេះហួសទៅសណ្ឋាគារហែលតុន ?
អ្នកអាចយកកញ្ចប់អ៊ីរបស់ខ្ញុំទៅតាក់ស៊ីបានទេ ?
ដើម្បីសណ្ឋាគារឧទ្យាន ។
បន្ទប់ទិដ្ឋភាពមហាសមុទ្រមួយជាមួយយ៉រ ។
ដែលជាកន្លែងដែលសូមជាមជ្ឈមណ្ឌលព័ត៌មានទេសចរណ៍ ?
ខ្ញុំចង់ធ្វើការកក់មួយ ។
តើអ្នកមានបន្ទប់ណាមួយដែលអាចរកបានសម្រាប់យប់នេះ ?
បន្ទប់តែមួយដែលមានផ្កាឈូក ។
តើវារួមបញ្ចូលទាំងអាហារពេលព្រឹក ?
ខ្ញុំឈ្មោះកញ្ញាអិហ្សាបាហ្សី ។
ខ្ញុំនឹងមកដល់នៅក្នុងសណ្ឋាគាររបស់លោកអ្នកនៅជុំវិញចំនួនប្រាំពីរនៅពេលល្ងាច ។
អាចអ្នកសូមមិនបានលុបចោលវា ?
ខ្ញុំកំពុងស្នាក់នៅរហូតដល់ថ្ងៃអង្គារក្រោយ ។
អ្នកអាចរកមើលបន្ទាប់ពីមានតម្លៃរបស់ខ្ញុំបានទេ ?
មិនអីទេអ្នកស្រី ។ សូមឱ្យខ្ញុំមានហត្ថលេខារបស់អ្នកនៅទីនេះ ?
តើខ្ញុំអាចរក្សាសំខាន់របស់ខ្ញុំជាមួយនិងខ្ញុំបានទេ ?
ខ្ញុំពិតជាសោកស្តាយនោះទេប៉ុន្តែខ្ញុំបានចាក់សោចេញពីបន្ទប់ខ្ញុំ ។
តើកន្លែងទូរសព្ទផ្ទះនៅទីណា ?
តើខ្ញុំអាចបន្តការស្នាក់នៅរបស់ខ្ញុំបីម៉ោងបន្ថែមទៀត ?
នេះជាបន្ទប់ដប់ពីរ អូ ប្រំា ។
សក្តានុពលនៃតែមួយ ។
អ្នកក៏អាចនាំយកមួយទឹកដោះគោក្តៅខ្ញុំ ?
តើអ្នកអាចនាំយកទៅបន្ទប់របស់ខ្ញុំអាហារពេលព្រឹករបស់ខ្ញុំ ?
ខ្ញុំចង់ឱ្យមានទឹកផ្លែប៉ោម នំបុ័ងអាំង ស៊ុតចៀននិងកាហ្វេ ។
សេវាកម្មបន្ទប់ ។ ខ្ញុំអាចចូលក្នុងបានទេ ?
សេវាបន្ទប់លោក ។
នេះគឺជាបន្ទប់លេខ មួយ អូ ប្រំា ។
ខ្ញុំចង់ឱ្យអ្នកចុចឈុតនេះ ។
សូមទូរសព្ទមកខ្ញុំនៅម៉ោងប្រំាមួយកន្លះ ។
តើអ្នកមានសេវាច្បាប់ចម្លង ?
គ្រាន់តែប្រាំច្បាប់ចម្លង ។
ខ្ញុំចង់ផ្ញើទូរសារ ។
អ្នកអាចធ្វើឱ្យវានៅចំនួនប្រាំពីរ ?
តើអ្នកមាន "ឆ្មា" សំបុត្រណាមួយដែលអាចរកបានសម្រាប់យប់នេះ ?
តើអ្នកនឹងធ្វើឱ្យរៀបចំសម្រាប់យើង ?
ដែលជាកន្លែងដែលខ្ញុំអាចទទួលបានសំបុត្រសម្រាប់ដំណើរទស្សនកិច្ចថ្ងៃលិចនេះ ?
ដែលជាកន្លែងដែលនេះគឺជាកន្លែងដែលគួរឱ្យចាប់អារម្មណ៍បំផុតនៅក្នុងតំបន់នេះទេ ?
សូមអ្នកជួយគូររូបភាពនៅកន្លែងនេះ ?
ខ្ញុំចង់ចូលរួមក្នុងដំណើរទស្សនកិច្ចពាក់កណ្តាលថ្ងៃ ។
តើមានសេវារថយន្តក្រុងទៅកាន់សារមន្ទីរនេះ ?
តើអ្នកអាចផ្តល់ឱ្យខ្ញុំនូវតារាងពេលវេលាមួយបានទេ ?
ខ្ញុំចង់បានសម្រាប់ការកម្សាន្តដើម្បីជួលឡានមួយ ។
ខ្ញុំចង់ជួលជិះកង់មួយ ។
តើអ្នកមានឱសថស្ថាននៅក្នុងសង្កាត់នេះបានទេ ?
តើមានហាងកែសម្ផស្សមួយនៅជិតនៅទីនេះ ?
ខ្ញុំចង់ធ្វើឱ្យមានការតែងតាំងសម្រាប់ប្រាំរសៀលថ្ងៃនេះ ។
តើថ្លៃទារក-អង្គុយនៅក្នុងមួយម៉ោងគឺជា ?
អ្នកអាចពិនិត្យមើលវានៅខាងស្ដាំនៅពេលនេះ ?
មិនមានសាប៊ូណាមួយនៅក្នុងបន្ទប់របស់ខ្ញុំ ។
អាចមាននរណាម្នាក់នៅទីនេះនិយាយភាសាអង់គ្លេស ?
នោះជាកំហុសរបស់អ្នក ។
លេខបន្ទប់របស់ខ្ញុំគឺលេខពីរ អូ បី ។
លោកស្រីអីហ្សីបាហ្សី ? អាចខ្ញុំមានគន្លឹះដ៏សំខាន់នេះ ?
សូមជួយជម្រះលុយផង ។
តើអ្នកទទួលយកការត្រួតពិនិត្យការធ្វើដំណើររបស់លោក ?
ខ្ញុំអាចនឹងចូលចិត្តជាមានតំលៃថោកមួយ ។
ការស្ងប់ស្ងាត់មួយគឺប្រសើរជាងមុន ។
ខ្ញុំចង់បរិភោគអាហារក្នុងស្រុក ។
តើយើងត្រូវស្លៀកពាក់ជាផ្លូវការ ?
ដែលស្រាទៅល្អបំផុតជាមួយនិងម្ហូបនេះ ?
សូមទោសយើងមិនបានត្រៀមខ្លួនជាស្រេចនៅឡើយទេ ។
អ្នកអាចផ្តល់ឱ្យយើងនូវពេលវេលាច្រើនជាងនេះបន្តិចបានទេ ?
ផលនេសាទនៅថ្ងៃនេះជាអ្វី ?
ជំនាញក្នុងស្រុកជាអ្វី ?
ជំនាញពិសេសរបស់អ្នកគឺអ្វី ?
អាហារនិងអាហារពេលល្ងាចសាច់គោអាំង ។
តើប្រភេទនៃស៊ុបដែលអ្នកមាន ?
នៅពេលដែលអ្នកចង់ឱ្យមានកាហ្វេ ?
បន្ទាប់ពីអាហាររួច ។
ខ្ញុំចង់ហូបផ្លែមួយចំនួនសម្រាប់បង្អែម ។
ខ្ញុំនឹងរំលងបង្អែមនេះ ។
ស៊ុបនេះគឺមិនក្តៅមិនត្រជាក់ ។
ខ្ញុំអាចមានទឹកជាច្រើនទៀតខ្លះបានទេ ?
តើអ្នកប្រញាប់គោលបំណងរបស់ខ្ញុំបានទេ ?
ខ្ញុំបានបញ្ជាឱ្យពេលវេលាដ៏យូរមកហើយ ។
សូមទោសវាជាច្រើនជាងដែលខ្ញុំបានរំពឹងទុក ។
បាទ នោះហើយជាការពិន័យ ។ តើខ្ញុំអាចមានហត្ថលេខារបស់អ្នកនៅទីនេះ ?
យើងចង់ត្រួតពិនិត្យដាច់ដោយឡែក ។
ខ្ញុំនឹងទិញអ្នកអាហារពេលល្ងាចនៅយប់នេះ ។
ខ្ញុំខ្លាចវាមិនត្រឹមត្រូវ ។
យើងបានរីករាយនឹងអាហារពេលល្ងាចនេះសូមអរគុណ ។
វាគឺជាការដែលអាចធ្វើបានដើម្បីទទួលបានផ្ទះនេះជាមួយខ្ញុំទេ ?
ប្រហិតពីរនិងមួយកូកកូឡាមួយដប ។
ទេអរគុណ ខ្ញុំចូលចិត្តវាធម្មតា ។
តើអ្នកចង់ធំឬតូច ?
សូមហាំបឺហ្គ័រមួយនិងទឹកដោះគោមួយ ។
តើអ្នកចង់ប៉េងប៉ោះនិងឈីសដាក់លើហាំបឺហ្គ័ររបស់អ្នក ?
សូមគ្រាន់តែប៉េងប៉ោះ ។
តើអ្នកចង់ទៅកំវាឡើង ?
តើអ្នកប្រើម៉ាស៊ីនផ្គត់ផ្គង់នេះដោយរបៀបណា ?
តើកន្លែងណាដែលអ្នកបានផ្ដល់អនុសាសន៍ទៅទស្សនា ?
តើខ្ញុំអាចចូលរួមក្នុងដំណើរទស្សនកិច្ចនៅសណ្ឋាគារផ្លាហ្សាបានដែរឬទេ ?
តើខ្ញុំអាចទទួលបានបិទនៅសណ្ឋាគារផ្លាហ្សា ?
តើដំណើរទស្សនកិច្ចនេះបានរួមបញ្ចូលវិចិត្រសាលសិល្បៈ ?
គឺជាមគ្គទេសក៍របស់ជប៉ុនដែលអាចប្រើបាន ?
ថ្លៃសេវាគឺជាអ្វី ?
តើសារមន្ទីរបិទ ?
សូមចាកចេញពីកាបូបធំរបស់អ្នកនៅទីនេះ ។
តើខ្ញុំអាចទទួលបានកាតាឡុកនៅសារមន្ទីរនេះបានដែរឬទេ ?
តើសិល្បៈរ៉ូម៉ាំង ?
នៅពេលដែលវាត្រូវបានគេលាបពណ៌ ?
សូមអភ័យទោស អាចយឺតអ្នកពន្យល់ ?
