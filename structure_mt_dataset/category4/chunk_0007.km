តើអ្នកមានកូនសៀវភៅព័ត៌មានទេ ?
តើមានសៀវភៅមគ្គទេសក៍អំពីសារមន្ទីរនេះទេ ?
សូមបន្ថែមល្បឿន ។
តើអ្នកចូលរួមថតរូបជាមួយយើង ?
ខ្ញុំនឹងផ្ញើអ្នកវិញរូបថតនេះ ។
ខ្ញុំនឹងយករូបថតរបស់អ្នក ។
បាតូ មូឆេនឹងរត់នៅយប់នេះ ?
តើបូករួមទំាងតម្លៃអាហារទំាងអស់ប៉ុន្មាន ?
កក់គឺជាការចាំបាច់ ?
តើខ្ញុំអាចកក់កៅអីនៅយប់ថ្ងៃស្អែកទេ ?
ពីរនាក់ ជាមួយនិងអាហារ ។
ខ្ញុំបានកក់ទុកហើយ ។ ខ្ញុំឈ្មោះអូកាម៉ាតូ ។
បាទលោក ។ អញ្ជើញតាមផ្លូវនេះ ។
ខ្ញុំកាន់កាបូប កាមេរ៉ាជូនអ្នក ។
ខ្ញុំអាចជួលវ៉ែនតាសម្រាប់អូបេរ៉ា ?
ចង់ប្ដូរទៅជាអាហារពេលព្រឹកនៅម៉ោង១៦ ។
តើថ្លៃសេវាការលុបចោលនេះឥតលុយមែទេ ?
តើបានបង់លុយសម្រាប់ភេសជ្ជៈនៅ ?
តើផ្លូវនេះទៅត្រង់ដល់ចំណតឡានក្រុងទេ ?
អ្នកអាចគូរផែនទីបានទេ ?
តើមានរថយន្តក្រុងទៅដោយផ្ទាល់ ?
តើមានថយន្ដក្រុងឈប់នៅជិតនេះទេ ?
សូនសួរនរណាម្នាក់ទៀតបានទេ ។
វានៅខាងឆ្វេង ។
វានៅខាងស្តាំ ។
សូមទៅបន្ទប់ទឹក ។
ថ្ងៃឈប់សម្រាក-កាតធ្វើដំណើរ ។
វាជាការល្អប្រសើរជាងមុនដើម្បីទៅឆ្ពោះទៅខាងកើត ?
តើខ្ញុំត្រូវផ្លាស់ប្ដូរកន្លែង ?
តើរថយន្តក្រុងមួយណាទៅទីក្រុងសាន់ហ្រាន់ស៊ីស្កូ ?
តើអ្នកបានកក់កៅអីហើយនៅ ?
តើកន្លែងដែលចេញនៅថ្ងៃត្រង់ប្រញាប់ទេ ?
សូមធ្វើការកក់ទុកសម្រាប់ថ្ងៃស្អែក ។
នៅក្នុងការប្រកួតជុំទីមួយដែលមានគ្នាបួននាក់ ។
តើអ្វីទៅជាពេលវេលាដែលបិទ ?
តើរទេះមានអ្វីខ្លះ ?
តើខ្ញុំអាចជួលក្លិបបាន ?
នេះគឺមានប្រហោងប្រាំ ?
យើងអាចលេងកីឡាវាយកូនបាល់នៅថ្ងៃនេះ ?
មួយម៉ោង នៅម៉ោងដប់មួយថ្ងៃ ។
អ្នកអាចលេងជាមួយខ្ញុំបានទេ ?
តើខ្ញុំអាចលេងជាមួយសំណាញ់ ?
អ្នកគឺជាអ្នកលេងដ៏ល្អ ។
តើនេះជាចំណុចចុងក្រោយ ?
ខ្ញុំចង់ជួលស្គីជិះនិងស្បែកជើង ។
ស្បែកជើងទាំងនេះធំពេកណាស់ ។
សូមផ្តល់សំបុត្រឱ្យខ្ញុំលើកទីមួយ ។
ខ្ញុំចង់ទៅលេងតំបន់ខ្យល់ត្រជាក់ ។
តើការជួលក្រុមប្រឹក្សាភិបាលមួយថ្ងៃពាក់កណ្តាលបានទេ ?
យើងអាចជួលគ្រូណែនំាបានទេ ?
តើធ្វើដូចម្តេចច្រើនសម្រាប់ពាក់កណ្តាលថ្ងៃ ?
កម្រៃសេវាដូចគ្នាសម្រាប់មេរៀនមនុស្សពីរនាក់ ?
សូមទៅពហុកីឡាដ្ឋានយ៉ានកេ ។
តើកីឡាដ្ឋានបើកនៅពេលណា ?
តើមានសំបុត្រសម្រាប់ការប្រកួតនៅថ្ងៃនេះ ?
ភាគរយប៉ែតសិបឈើនិងម្ភៃភាគរយសម្រាប់ប៊ូយេស្ទ័រ ។
ខ្ញុំចង់សាកល្បងមួយផ្សេងទៀតផងដែរ ។
ខ្ញុំមិនចូលចិត្តមួយនេះ ។
បង្ហាញអាវយឺតខ្ញុំមួយដែលនៅជិននោះ ។
វាជាពណ៌ដ៏ស្រស់ស្អាត ប៉ុន្តែភ្លឺបន្តិច ។
តើអ្នកមានអ្វីមួយជាមួយនិងពណ៌ងងឹត ?
តើថ្លៃប៉ុន្មានបើមិនគិតពីពន្ធនៃចំណាប់ផ្តើមដំបូង ?
ចំនួនសរុបលើសពីមួយពាន់ពីររយហ្រ្វង់ ។
តើខ្ញុំអាចដើរមើលបន្តិចបានទេ ?
បន្តទៀតចុះហើយតាមសំរួល ។
តើខ្ញុំអាចសាកស្បែកទាំងនោះបានទេ ?
ខ្ញុំគិតថា លេខប្រាំមួយកន្លះ ។
សូមអោយកៅអ៊ីមួយអង្គុយទីនោះ ។
តើអ្នកត្រូវការសាកអាលេខតូចមួយជាងហ្នឹងទេ ?
វាដូចជាតឹងបន្តិចពេក ។
អញ្ចឹង ដាក់ទ្រនាប់មួយខាងក្នុង ។
អូ នេះគឺល្មមតែម្តង ។
តើអ្នកត្រូវការមើលកាបូបដែលស៊ីគ្នាទេ ?
មានពីរប្រភេទ នេះនិងនេះ ។
បាទ ពួកវាគួរអោយស្រលាញ់ណាស់ ។
អញ្ចឹង សូមអោយខ្ញុំអាតូចជាងមួយនេះ ។
ពួកយើងក៏មានខ្សែក្រវ៉ាត់ដែលស៊ីគ្នាផងដែរ ។
ល្អណាស់ វាស្អាតៗ ប៉ុន្តែសូមអរគុណ ។
តើវាពិតជាត្បូងពណ៌ខៀវមែនទេ ?
ខ្ញុំនឹងទិញក្រវិលទាំងនោះផងដែរ ។
តើអ្នកអាចបញ្ចុះតម្លៃតិចបានទេ ?
សូមយកកាបូបសម្រាប់ធ្វើដំណើរនោះមកអោយខ្ញុំមើលបន្តិច ។
ផ្នែកខាងក្នុងគឺល្អណាស់ ។
សូមអញ្ជើញ លោកស្រី ។
សូមបង្ហាញក្រវ៉ាត់កទាំងនោះមកខ្ញុំ ។
ពួកវាស្អាតៗទាំងអស់ហើយ ។ ខ្ញុំមិនអាចសម្រេចចិត្តបានទេ ។
ល្អណាស់ ខ្ញុំនឹងយកអានេះនិងអានេះ ។
សូមកុំគិតពន្ធ ។
ជាន់ក្រាមដី នៅក្នុងអាគារ អានិច ។
ខ្ញុំកំពុងរកមើលក្រែមលាបបបូរមាត់មួយ ។
សូមប្រាប់ខ្ញុំលេខដែលអ្នកចង់បាន ។
ខ្ញុំចង់បានលេខប្រាំចំនួនមួយ លេខសាមសិប្រាំមួយចំនួនពីរ ។
តើខ្ញុំអាចទិញកន្សែងបង់កបាននៅឯណា ?
តើខ្ញុំអាចលាតវាចេញក្រៅបានទេ ?
តើអ្នកមានអាទំហំធំជាងនឹងបន្តិចទៀតទេ ?
តើខ្ញុំអាចសាកពាក់វាលើស្មាខ្ញុំបានទេ ?
ខ្ញុំចង់បានស្រាដាក់កែវទាំងនេះមួយឈុត ។
តើខ្ញុំអាចយកពួកវាទៅប្រទេសជប៉ុនដោយសុវត្ថិភាពបានទេ ?
តើអ្នកអាចផ្ញើវាទៅប្រទេសជប៉ុនបានទេ ?
សូមបង់ប្រាក់សម្រាប់ការដឹកជញ្ជូននិងការធានារ៉ាប់រង ។
សូមផ្ញើវាតាមយន្តហោះទៅប្រទេសជប៉ុន ។
អ្នកនឹងប្រាកដជាផ្ញើពួកវា មែនទេ ?
ខ្ញុំបានបាត់របស់មានតម្លៃរបស់ខ្ញុំ ។
លិខិតឆ្លងដែនរបស់ខ្ញុំ កាតឥណទាន សែកអ្នកដំណើរ និងលុយផងដែរ ។
សូមពន្យល់តើអ្វីបានកើតឡើង ។
ខ្ញុំនិយាយភាសាអង់គ្លេសមិនបានល្អទេ ។
សូមរកនរណាម្នាក់និយាយភាសាជប៉ុនបាន ។
សូមលុបចោលនូវសែកដែលបានបាត់ ។
តើខ្ញុំអាចដាក់ពាក្យធ្វើថ្មីបានទេ ?
សូមប្រាប់ពីចំនួនសែកដែលបានបាត់ ។
សូមអនុញ្ញាតិអោយខ្ញុំថតរូបអ្នក ។
តើមានប៉ូលីសនៅក្បែរនេះទេ ?
សូមអោយលិខិតបញ្ជាក់ពីការលួច ។
សូមហៅអ្នកសន្តិសុខ ។
ខ្ញុំទុកវានៅក្នុងប្រអប់ថត ។
តើអ្នកអាចបង្ហាញភស្តុតាងថាវាត្រូវបានគេលួចទេ ?
តើអ្នកអាចធ្វើវាសារជាថ្មីបានទេ ?
ខ្ញុំបានខកជើងហោះហើរ លេខប្រាំ សូន្យ មួយ ទៅហុងកុងហើយ ។
តើអ្នកជើងហោះហើរផ្សេងទៀតទេថ្ងៃនេះ ?
តើអ្នកមានអាជើងហោះហើរដែលឆាប់ជាងនេះទេ ?
តើការកក់របស់ខ្ញុំត្រូវបានលុបចោលហើយឬ ?
កៅអីថ្នាក់ប្រតិបត្តិក៏បានដែរ ។
នេះគឺបន្ទប់លេខបី ដប់បី ។
ប្រពន្ធរបស់ខ្ញុំគ្រុនក្តៅ ។
មិត្តរបស់ខ្ញុំគឺមានអារម្មណ៍មិនល្អ ។
គាត់មានអារម្មណ៍ថាចង់ក្អួត ។
តើមានមន្ទីរពេទ្យនៅក្បែរនេះទេ ?
តើអ្នកអាចហៅតាក់ស៊ីបានទេ ?
គាត់បាត់បង់ស្មារតីហើយ ។
តើអ្នកណាចេះភាសាជប៉ុនទេ ?
ខ្ញុំមានការឈឺចាប់ត្រង់ទ្រូង ។
នេះគឺសំបុត្រទិញថ្នាំ ។
យកវាទៅកន្លែងលក់ថ្នាំ ។
សូមអោយខ្ញុំនូវលទ្ធផលវិនិឆ័្ឆយរោគរបស់អ្នក ។
សូមបំពេញទំរង់បែបបទនេះ ។
តើរយៈពេលប៉ុន្មានទើបវាប្រសើរឡើងវិញ ?
សូមទៅឱសថស្ថានដែលនៅជិតបំផុត ។
ចូរប្រាប់ខ្ញុំពីរបៀបប្រើថ្នាំនេះ ។
សូមអោយថ្នាំផ្តាសាយមកខ្ញុំ ។
ខ្ញុំមានអារម្មណ៍ថាខ្សោយ ។
តើខ្ញុំអាចផឹកវាដោយមាត់ទទេបានទេ ?
ចូរប្រាប់ខ្ញុំពីរបៀបប្រើថ្នាំនេះ ។
ខ្ញុំមានអារម្មណ៍មិនល្អទេ ។
ខ្ញុំមានជំងឺរោគរលាកសួត ។
ខ្ញុំមានជំងឺរោគរលាកទងសួត ។
ខ្ញុំមានអាការៈគ្រុនក្តៅ ។
ខ្ញុំមានជំងឺរលាកក្រពះ ។
ខ្ញុំមានកន្ទួលនៅលើស្បែក ។
តើការចុះឈ្មោះឡើងជិះចាប់ផ្តើមនៅពេលណា ?
សូមអោយខ្ញុំមើលសំបុត្រយន្តហោះនិងលិខិតឆ្លងដែនរបស់អ្នក ។
ដំណើររបស់អ្នកឆ្ពោះទៅអូសាកា ឬ ?
សូមចុះឈ្មោះផ្ញើកាបូបអីវ៉ាន់នេះ ។
តើខ្ញុំអាចយករបស់នេះចូលក្នុងយន្តហោះបានទេ ?
ការហោះហើររបស់យើងតាមពេលវេលាទេ ?
បន្ទាប់ពីឆ្លងអន្តោប្រវេសន៍ អ្នកនឹងឃើញវា ។
សូមអោយ ខេមឹស និងអូលផា ។
សូមអោយកាតឡើងជិះរបស់អ្នក ។
តើតូក្យូជាគោលដៅរបស់អ្នក ?
តើអ្នកបានបំពេញកាតសំរាប់ចុះហើយឬនៅ ?
ឡានក្រុងលីមូហ្សីននឹងឈប់នៅច្រកខាងជើងដំបូងគេ ។
បន្ទាប់មក វាទៅច្រកខាងត្បូងនៃព្រលានយន្តហោះណារីតា មែនទេ ?
នេះគឺជាពួកយើង ។ ជាចុងក្រោយពួកយើងនិងទៅដល់ព្រលានយន្តហោះ ។
ព្រលានយន្តហោះនេះគឺស្អាតណាស់ ។ ខ្ញុំគឺជឿជាក់លើវា ខ្ញុំសង្ឃឹម ។
