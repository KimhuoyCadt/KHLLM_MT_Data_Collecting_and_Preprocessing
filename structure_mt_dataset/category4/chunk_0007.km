តើអ្នកអាចជួយខ្ញុំបានជួលរថយន្តមួយ ?
តើអ្នកអាចជួយខ្ញុំបានធ្វើផែនការសម្រាប់ថ្ងៃស្អែក ?
តើអ្នកអាចជួយខ្ញុំយកចេញសម្លៀកបំពាក់មួយចំនួន ?
តើអ្នកអាចជួយខ្ញុំបានបំពេញឯកសារទាំងនេះ ?
អ្នកអាចសរសេរវានៅទីនេះខ្ញុំ ?
អ្នកអាចសរសេរវានៅទីនេះខ្ញុំ ?
អ្នកអាចគូរវានៅទីនេះខ្ញុំ ?
អ្នកអាចគូរផែនទីមួយសម្រាប់ខ្ញុំ ?
សូមសរសេរចុះនូវអ្វីដែលអ្នកកំពុងនឹងទិញ ។
អ្នកអាចសរសេរចុះឈ្មោះរបស់ស្ថានីយ៍ដែលខ្ញុំមានដើម្បីទទួលបានបិទបានទេ ?
អ្នកអាចគូរឱ្យខ្ញុំផែនទីទៅកាន់ស្ថានីយ៍នេះ ?
អ្នកអាចគូរផែនទីដែលអាចទទួលបានខ្ញុំនៅទីនោះបានទេ ?
អ្នកអាចបំពេញក្រដាសនេះសម្រាប់ខ្លួនខ្ញុំ ?
សូមសរសេរនៅក្នុងការបោះពុម្ភ ។
អ្នកអាចបង្ហាញខ្ញុំពីរបៀបដើម្បីពិនិត្យអក្ខរាវិរុទ្ធ ?
ពេលវេលាមកដល់នឹងមានចំនួនបីម៉ោង ។
សូមប្រាប់ពួកគេខ្ញុំមាននៅពេលនេះមិនអាចមក ។
តើអ្នកទទួលសារហើយឬនៅ ?
សូមប្រាប់គាត់ថាវាត្រូវបានពន្យាពេលរហូតដល់សប្ដាហ៍ក្រោយនេះ ។
អាចដែលអ្នកបានឱ្យគាត់ហៅខ្ញុំ ?
សូមប្រាប់នាងថាខ្ញុំមិនអាចរង់ចាំណាមួយទៀតទេ ។
សូមប្រាប់ពួកគេថាខ្ញុំបានទទួលការបិទសិទ្ធិទាំងអស់ ។
សូមប្រាប់គាត់ថាខ្ញុំនឹងមកម្តងទៀត ។
សូមប្រាប់គាត់ថាខ្ញុំបានហៅគាត់នៅពេលដែលគាត់បានចេញ ។
សូមប្រាប់នាងថាខ្ញុំចង់ឃើញនាងនៅថ្ងៃបន្ទាប់ពីថ្ងៃស្អែកនេះ ។
សូមកុំភ្ញាក់ឱ្យខ្ញុំឡើង ។
សូមឱ្យខ្ញុំដេក ។
ឈប់យកដើមស្ពៃខៀវ ។
សូមឱ្យខ្ញុំដេករហូតដល់ម៉ោងប្រាំបួន ។
បើគ្មានទឹកកក ។
សូមកុំយកថានៅឡើយទេ ។
សូមកុំដាក់នៅក្នុងស្ករណាមួយទេ ។
សូមកុំប្រើក្រែមណាមួយឡើយ ។
សូមកុំដាក់ការហៅទូរស័ព្ទណាមួយតាមរយៈ ។
សូមមេត្តាកុំផ្តល់នូវគន្លឹះដ៏សំខាន់ដើម្បីនរណាម្នាក់ផ្សេងទៀតជាងខ្លួនខ្ញុំផ្ទាល់នេះ ។
កុំផ្តល់ឱ្យនេះទៅនរណាម្នាក់ដោយគ្មានការធ្វើឱ្យប្រាកដថាឈ្មោះរបស់ពួកគេជាមុនសិន ។
សូមកុំលុបចោលមុនពេលដែលថ្ងៃស្អែក ។
សូមកុំផ្លាស់ប្ដូរផែនការរបស់អ្នកសម្រាប់ជាប្រយោជន៍របស់ខ្ញុំ ។
