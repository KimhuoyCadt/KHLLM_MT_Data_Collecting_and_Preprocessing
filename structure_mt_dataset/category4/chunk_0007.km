ពួកគេបានរត់គ្រប់កៅសិបប្រាំបួននាទី ។
ពួកគេបានរត់ប្រហែលកៅសិបប្រាំបួនម៉ោង ។
វាមានកៅសិបប្រាំបួនរថយន្តក្រុងក្នុងមួយថ្ងៃ ។
នៅប្រហែលជាប្រំាបួន អូ ប្រាំបួន ។
កៅសិបប្រាំបួនដុលា្លរសម្រាប់មនុស្សម្នាក់ ។
តើខ្ញុំដាក់តម្លៃនេះនៅកន្លែងណា ?
ចូលទៅក្នុងប្រអប់នេះ ។
នៅពេលដែលអ្នកបានបិទ ។
ចេញនៅម៉ោងប្រំាបួន អូ ប្រំា ។
តម្លៃនេះគឺជាកៅសិបប្រាំបួនដុល្លារ ។
អត់ទេយើងចេញដំណើរផ្ទុយគ្នា ។
ពេលណារថភ្លើងទីពីរចេញដំណើរ ?
យើងចេញដំណើរនៅ ប្រំាបួន អូន ប្រំា ។
តើខ្ញុំអាចសុំមើលសំបុត្ររបស់អ្នកបានទេ ?
តើកន្លែងបញ្ចប់នៃរថភ្លើងនេះ ?
ខ្ញុំចង់បានសម្រាប់មួយថ្ងៃជួលរថយន្តសេដ្ឋកិច្ច ។
តើរថយន្តប្រភេទណាដែលអ្នកចង់បាន ?
តើខ្ញុំត្រូវការអ្វីខ្លះដើម្បីបង្ហាញការជួលរថយន្ត ?
អ្នកត្រូវការអ្វីដើម្បីបង្ហាញលិខិតអនុញ្ញាតបើកបរជាអន្ដរជាតិរបស់អ្នក ។
ប្រសិនបើអ្នកមានប័ណ្ណបញ្ចុះតម្លៃណាមួយ សូមបង្ហាញវា ។
ខ្ញុំចង់ឱ្យមានការធានារ៉ាប់រង ។
សូមចុះកិច្ចសន្យានៅកន្លែងនេះ ។
ខ្ញុំអាចរីករាយជាមួយនិងឯកសិទ្ធិនៃការបញ្ចុះតម្លៃជាមួយនិងកាតនេះ ?
ខ្ញុំបានធ្វើការកក់ក្នុងប្រទេសជប៉ុន ។
ខ្ញុំចង់ជួលរថយន្តតូចមួយសម្រាប់មួយថ្ងៃ ។
ខ្ញុំចង់ជួលរថយន្តសម្រាប់កន្លះថ្ងៃខ្នាតមធ្យម ។
ខ្ញុំចង់ជួលរថយន្តដែលមានស្តង់ដារសម្រាប់មួយថ្ងៃ ។
ខ្ញុំចង់ជួលរថយន្តដែលមានទំហំធំសម្រាប់មួយថ្ងៃ ។
ខ្ញុំចង់ជួលរថយន្តសម្រាប់មួយថ្ងៃ ។
អ្នកត្រូវការបង្ហាញនូវលិខិតឆ្លងដែនរបស់អ្នក ។
អ្នកត្រូវការបង្ហាញនូវកាតឥណទានរបស់អ្នក ។
តើអ្នកចង់ ភីអេអាយ ?
តើអ្នកចង់បានសន្និដ្ឋាន ?
តើអ្នកចង់ ភីអីស៊ី ?
ពេលនេះខ្ញុំចង់បានឡានត្រឡប់មកវិញ ?
នៅម៉ោងប្រាំបួននៅថ្ងៃស្អែក ។
នៅក្នុងរយៈពេលកៅសិបប្រាំបួនម៉ោង ។
តើខ្ញុំគួរបញ្ចូលធុងនេះ នៅពេលដែលខ្ញុំវិលត្រឡប់មករថយន្តវិញ ?
បាទ ជាច្បាប់ ។ ប៉ុន្តែប្រសិនបើអ្នកមិនអាចធ្វើវាបានដោយហេតុផលណាមួយនោះ មិនអីទេ ។
កៅសិបប្រាំបួនដុល្លារក្នុងមួយថ្ងៃ ។
កៅសិបប្រាំបួនដុល្លាររហូតដល់ទៅមួយរយគីឡូម៉ែត្រក្នុងមួយថ្ងៃ ។
កៅសិបប្រាំបួនសេន សម្រាប់រាល់ជាងមួយរយគីឡូម៉ែត្រនឹងត្រូវបានបន្ថែមតម្លៃដើម ។
សូមជួយចាយលុយ នៅពេលដែលអ្នកត្រឡប់មកវិញរថយន្ត ។
ប្រសិនបើអ្នកមិនមានកាតឥណទាន អ្នកត្រូវបង់ប្រាក់នៅក្នុងការដាក់ប្រាក់ការកៅសិបប្រាំបួនដុល្លារ ។
ខ្ញុំចង់កក់បន្ទប់តែមួយសម្រាប់យប់នេះ ។
បាទ មានបន្ទប់ដែលអាចប្រើបាន ។
យើងមានការសោកស្តាយខ្លាំងណាស់ ប៉ុន្តែបន្ទប់មួយត្រូវបានគេយកហើយ ។
ប៉ុន្តែយើងមានបន្ទប់ដែលទំនេរ ។
យើងមានការសោកស្តាយខ្លាំងណាស់ ប៉ុន្តែបន្ទប់ទាំងអស់ត្រូវបានយក ។
សូមកក់បន្ទប់តែមួយបន្ទាប់មក ។
តើតម្លៃបូករួមទំាងពន្ធមែនទេ ?
តើតម្លៃបូករួមទំាងអាហារពេលព្រឹក ?
ខ្ញុំចង់កក់បន្ទប់គ្រែពីរសម្រាប់មួយយប់ ។
ខ្ញុំចង់កក់បន្ទប់ភ្លោះមួយសម្រាប់យប់នេះ ។
យើងសូមអធ្យាស្រ័យផងចុះបន្ទប់គ្រែពីរបានកក់ទាំងអស់ ។
យើងសូមអធ្យាស្រ័យផងចុះបន្ទប់គ្រែពីរគេក់អស់ហើយ ។
ប៉ុន្តែយើងមានបន្ទប់គ្រែពីរអាចបម្រើការបាន ។
ប៉ុន្តែយើងមានបន្ទប់ពីរដែលអាចប្រើបាន ។
សូមធ្វើការកក់បន្ទប់គ្រែពីរ ។
សូមកក់បន្ទប់ភ្លោះមួយបន្ទាប់មក ។
ខ្ញុំចង់ស្នាក់នៅយប់ថ្ងៃស្អែកនៅសណ្ឋាគាររបស់អ្នក ។ តើអ្នកអាចកក់បន្ទប់មួយបានទេ ?
សូមពិនិត្យចូលសន្ទាប់ពីម៉ោងប្រំាបួនប្រំាបួននាទីព្រឹក ។
សូមពិនិត្យចេញនៅម៉ោងប្រាំបួនប្រំាបួននាទី ។
ខ្ញុំចង់ស្នាក់នៅកៅសិបប្រំាបួនយប់ ។
នេះគឺជាអ្វីទាំងអស់ដែលអ្នកចង់បញ្ញាក់ ?
តើអ្នកនឹងកក់បន្ទប់គ្រែពីរមែនទេ ?
តើអ្នកនឹងកក់បន្ទប់ភ្លោះមួយមែនទេ ?
សូមពិនិត្យមើលនៅបន្ទាប់ពីប្រាំបួន អូនៅម៉ោងប្រំាបួនព្រឹក ។
សូមពិនិត្យមើលបន្ទប់លេខប្រំាបួន អូន នៅម៉ោងប្រំាបួនល្ងាច ។
សុខសប្បាយជាទេ អរគុណ ។ ចុះអ្នកវិញ ?
ខ្ញុំដូចជាត្រជាក់បន្តិច ។
វាត្រជាក់ស្រួលណាស់ ។
ខ្ញុំសង្ឃឹមថាអ្នកមិនអស់កម្លំាង ។
សូមកុំជក់បារីនៅទីនេះ ។
ខ្ញុំនិយាយភាសាអង់គ្លេសបានតិចតួច ។
នៅលើផ្លូវទៅទីក្រុងឡុងដ៍យើងនឹងមានការចុះសំចតរយៈពេលខ្លីមួយនៅក្នុងទីក្រុងម៉ូស្គូ ។
នៅពេលនេះ សូមអ្នកប្រាកដថាខ្សែក្រវ៉ាត់កន្លែងអង្គុយរបស់អ្នកត្រូវបានដាក់គន្លឹះ និងបញ្ឈប់ការជក់បារីរហូតហួសសញ្ញាទៅបិទបម្រាម ។
យើងនឹងឆ្លងកាត់ថ្ងៃកំណត់ជាអន្តរជាតិ ។
យើងនឹងមានភាពច្របូកប្រចល់ ។ តើអ្នកមានសុវត្ថិភាព ខ្សែក្រវ៉ាត់កន្លែងអង្គុយរបស់អ្នកបញ្ឈប់ការប្រើប្រាស់ដែលមានភាពផ្ទុយគ្នា ។
តើអ្នកអាចនៅមានកៅអីសម្រាប់ពេលនេះ ។ យើងនឹងប្រាប់អ្នកនៅពេលដែលស្ពាននេះគឺស្ថិតទីតាំងនោះ ។
យើងនឹងឆ្លងកាត់តំបន់អេក្វាទ័រ ។
តើអ្នកចង់ពិសាអ្វីមុនពេលអាហារពេលល្ងាច ?
សាច់មាន់ ឬក៏សាច់គោសម្រាប់អាហារពេលល្ងាច ?
ចុះស្រាក្រហមយ៉ាងណាដែរ ?
បាទស្រាក្រហម ។
សូមកាហ្វេទឹកដោះគ្រោះ ។
សូមស្រាបន្ថែមទៀត ។
សូមកាសសម្រាប់ស្តាប់ ។
សូមអ្នកដំណើរឆ្លងកាត់ផ្លូវនេះ ។
ហើយច្រកចេញលេខប៉ុន្មាន ?
សូមហៅអ្នកណាម្នាក់ដែលនិយាយភាសាជប៉ុន ។
ទីនេះជាការបញ្ជាក់ពីបង្ហាញពីកាបួបរបស់ខ្ញុំ ។
អ្នកអាចប្ដូរលុយរបស់ជប៉ុនប្រាក់យ៉េន ?
សូមប្ដូរលុយនេះទៅផោន ។
សូមបញ្ចូលកាក់ ។
សូមចុះហត្ថលេខាទីនេះហើយបង្ហាញខ្ញុំលិខិតឆ្លងដែនរបស់លោក ។
សូមផ្លាស់ប្ដូរទៅជាវិក័យប័ត្រប្រាក់ដុល្លារដប់ ។
សូមឱ្យខ្ញុំដប់សម្រាប់ម្នាក់ ។
សូមធ្វើការកក់សណ្ឋាគារ ។
សណ្ឋាគារនៅ ក្វាទ័រឡាទីន ។
បន្ទប់តែមួយដែលមានទឹកផ្កាឈូក ។
ខ្ញុំឈ្មោះ តូម៉ូហិកូ អូកាម៉ូតូ ។
អ្នកនឹងស្នាក់នៅរយៈពេលពីរយប់តាមការកំណត់ ?
បាទ ជាមួយនិងការងូតទឹកមែនទេ ?
សូមចុះឈ្មោះនៅទីនេះលោក អូកាម៉ូតូ ។
នេះជាកូនសោរបស់អ្នក ។
