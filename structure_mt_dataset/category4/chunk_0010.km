ហាងកាដូគឺនៅជាប់នឹងបារអាហារសម្រន់ ។
សូមដាក់វត្ថុលោហៈធាតុទាំងអស់ដែលអ្នកមាននៅក្នុងថាសនេះ ។
តើអ្នកដឹងថារថភ្លើងចាកចេញឆាប់ប៉ុណ្ណាដែរ ?
ខ្ញុំគិតថា ប្រហែលជាប្រាំនាទីទេ ។
យកខ្ញុំទៅកាន់អាសយដ្ឋាននេះ ។ តើវាត្រូវចំណាយពេលយូរប៉ុណ្ណា ?
សូម តែទៅ ។ តើមានគិតថ្លៃសេវារហ័សបញ្ចូលដែរទេ ?
ទេ អ្នកត្រូវតែបង់វានៅលើយន្តហោះ ។
តើអ្នកចង់បានលំដាប់ខ្ពស់ ឬធម្មតា ?
សូមធម្មតា ។ ហើយតើអ្នកនឹងត្រួតពិនិត្យទឹក និងប្រេងដែរទេ ?
ប្រាកដហើយ ។ វាអស់ថ្លៃសែសិបប្រាំដុល្លារ ។
តើឡានប្រភេទអ្វីដែលអ្នកចង់បាន ?
ឡានតូចនឹងល្អបំផុត ។
បាទ ចា៎ស ខ្ញុំចង់បានធានារ៉ាប់រងពេញលេញ ។
តើអ្នកមានកន្លែងអង្គុយណានៅលើរថភ្លើងម៉ោងប្រាំបីដែរទេ ?
ខ្ញុំចង់កកកន្លែងអង្គុយនៅលើរថភ្លើងម៉ោងដប់ និងដបប្រាំនាទី ។
ខ្ញុំចង់បានបន្ទប់តូចៗ ។
ខ្ញុំចង់លុបចោលសំបុត្រនេះ ។
តើអ្នកអាចប្រាប់ខ្ញុំរថយន្តក្រុងមួយណាត្រូវជិះបានទេ ?
តើពីកន្លែងឡើងជិះមួយណាដែលរថភ្លើងចាកចេញ ?
តើរថភ្លើងមកញឹកញាប់ប៉ុណ្ណា ?
វាជាលើកទីពីរឈប់ពីទីនេះ ។
ចុះនៅចំណតទីបី ។
តើខ្ញុំអាចមានចំណតសម្រាកបានទេ ?
តើខ្ញុំត្រូវប្ដូរនៅឯណា ?
តើអ្នកអាចប្រាប់ខ្ញុំ នៅពេលខ្ញុំទៅដល់ទីនោះបានទេ ?
អោយខ្ញុំចុះនៅចំណតបន្ទាប់ ។
ខ្ញុំមានសំបុត្រកក់ទុក ។
ខ្ញុំគិតថានេះគឺជាកៅអីរបស់ខ្ញុំ ។
អ្នកអង្គុយខុសកន្លែងហើយ ។
នេះគឺជាឡានលេខដប់ពីរ ។
យើងមានគ្នាប្រាំនាក់ ។ តើយើងអាចជិះគ្រប់គ្នាទេ ?
តើវានឹងអស់ថ្លៃប៉ុន្មានទៅដល់ទីនោះ ?
តើវាចំណាយពេលយូរជាងយ៉ាងណា ?
តើឆាប់ប៉ុណ្ណាយើងទៅដល់ព្រលានយន្តហោះ ?
តើពេលប៉ុន្មានទៀងទំរាំយើងទៅដល់ ?
ប្រហែលដប់ប្រាំនាទីទៀត ។
ខ្ញុំត្រូវទៅដល់ទីនោះនៅម៉ោងបី ។
ខ្ញុំមិនមានពេលទំនេរទេ ។
ខ្ញុំមិនអាចខ្ជះខ្ជាយពេលទេ ។
ជិះផ្លូវណាជិតបំផុត ។
សូមយកមធ្យោបាយលឿនបំផុត ។
សូមជិះតាមផ្លូវជុំវិញសួន ។
ជិះតាមផ្លូវតាមបណ្តោយឆ្នេរ ។
ជិះតាមផ្លូវមួយរយម្ភៃបី ។
តើអ្នកអាចសូមចាំខ្ញុំបានទេ ?
សូមឱ្យខ្ញុំទទួលបានបិទនៅទីនេះសូម ។
តើអ្នកអាចជួយខ្ញុំយួរវ៉ាលីខ្ញុំបានទេ ?
តើអ្នកមិនគិតលុយលើសទេឬ ?
ទៅកាន់ទីប្រជុំជន ។
សូមទៅកាន់អាសយដ្ឋាននេះ ។
សូមទៅអាស័យដ្ឋាននេះ ។
សូមយកឡានតូចមួយ ។
តូចជាងឡានតូចនឹងល្អបំផុត ។
តើអ្នកមានឡានជប៉ុនដែរទេ ?
ខ្ញុំចង់បានឡានតូច ។
តើអត្រាតម្លៃជួលក្នុងមួយថ្ងៃថ្លៃប៉ុន្មានដែរ ?
តើអត្រាតម្លៃជួលក្នុងមួយម៉ាយល៍ថ្លៃប៉ុន្មានដែរ ?
សាមសិបដុល្លារក្នុងមួយថ្ងៃ បូករួមនឹងម្ភៃសិនក្នុងមួយម៉ាយល៍ ។
តើអ្នកអាចបង្ហាញខ្ញុំនូវបញ្ជីតម្លៃរបស់អ្នកបានទេ ?
ខ្ញុំនឹងយកអត្រាការប្រាក់ជារៀងរាល់ថ្ងៃនោះ ។
ខ្ញុំនឹងយកអត្រារយៈម៉ាយល៍ ។
តើថ្លៃទុកនៅទីនោះគឺប៉ុន្មាន ?
តើអ្នកចង់ជួលឡាននេះប៉ុន្មានថ្ងៃដែរ ?
ខ្ញុំចង់ជួលវារយៈពេលប្រាំមួយម៉ោង ។
ខ្ញុំចង់ជួលវាពីថ្ងៃទីប្រាំដល់ថ្ងៃទីដប់ ខែធ្នូ ។
ខ្ញុំចង់ទិញធានារ៉ាបរង ។
សូមចាក់សាំងធម្មតាអោយពេញមក ។
តម្លៃដប់ដុល្លារនៃប្រេងគ្មានជាតិសំន ។
សូមជួយពិនិត្យមើលថ្មផង ។
តើអ្នកនឹងពិនិត្យមើលប្រេង និងទឹកបានទេ ?
តើអ្នកចង់ពិនិត្យមើលសម្ពាធកង់ឡានដែរទេ ?
ម៉ាស៊ីនធ្វើមានសំឡេងខ្លំាងណាស់ ។
ចង្កឹះលេខដាក់អត់ចូល ។
ហ្វ្រាំងនេះនឹងមិនធ្វើការទេ ។
ឡានរបស់ខ្ញុំមានកង់មួយធូរ ។
ខ្ញុំចង់ត្រឡប់រថយន្តជួលរបស់ខ្ញុំ ។
តើថ្លៃឈ្នួលប៉ុន្មានក្នុងមួយថ្ងៃ ?
តើថ្លៃឈ្នួលប៉ុន្មានក្នុងមួយម៉ាយល៍ ?
ខ្ញុំចង់ជួលបួនថ្ងៃ ។
សួស្តី ។ តើខ្ញុំជួយអ្នកអ្វីបាន ?
បាទ ចា៎ស តើអ្នកមានកន្លែងទំនេរដែរទេ ?
ខ្ញុំចង់ស្នាក់នៅបីយប់ ។
បាទ ចា៎ស ខ្ញុំបានទូរស័ព្ទពីព្រលានយន្តហោះ ។ ឈ្មោះរបស់ខ្ញុំគឺ Sato ។
ត្រឹមត្រូវ កញ្ញា Sato ។ តើអ្នកអាចបំពេញទម្រង់បែបបទនេះបានទេ ?
តើម៉ោងប៉ុន្មានអ្នកនឹងពិនិត្យចេញ ?
ម៉ោងប្រហែលប្រាំមួយព្រឹក ។
តើអ្នកចង់ឱ្យយើងទូរសព្ទដាស់អ្នកដែរទេ ?
ខ្ញុំចង់បានបន្ទប់ទូលាយមួយជាមួយទេសភាពមហាសមុទ្រ ។
ចុះឈុតរាត្រីទឹកឃ្មុំយ៉ាងម៉េចដែរ ?
អូ មែនហើយ ។ វានឹងឥតខ្ចោះ ។
តើអ្នកចង់គិតវិក្កយបត្រយ៉ាងម៉េចដែរ ?
តើខ្ញុំអាចបង់តាមប័ណ្ណឥណទានបាទេ ?
បាន យើងទទួលប័ណ្ណឥណទានសំខាន់ៗ ។ តើអ្នកមានប័ណ្ណណាមួយក្នុងចំណោមទាំងនេះ ?
ខ្ញុំបានកក់ទុកទីនេះរួចហើយ ។
ខ្ញុំបានកក់នៅទីនេះពីយប់នេះទៅដល់ថ្ងៃទីដប ខែធ្នូ ។
ខ្ញុំបានទូរស័ព្ទពីព្រលានយន្តហោះមួយម៉ោងមុន ។
តើអ្នកមានលេខបញ្ជាក់ដែរទេ ?
នេះជាលិខិតបញ្ជាក់របស់ខ្ញុំ ។
ប្រាប់ឈ្មោះអ្នកឱ្យខ្ញុំដឹងផង ។
តើអ្នកប្រកបនាមត្រកូលអ្នកយ៉ាងម៉េច ?
ខ្ញុំមិនមានការកក់ក្នុងឈ្មោះរបស់អ្នកទេ ។
តើអ្នកអាចបំពេញប័ណ្ណចុះឈ្មោះនេះបានទេ ?
តើអ្នកអាចគ្រាន់តែចុះហត្ថលេខាលើទម្រង់បែបបទនេះបានទេ ?
ខ្ញុំមិនមានការកក់ទុកទេ ប៉ុន្តែខ្ញុំចង់បានបន្ទប់គ្រែមួយមួយយប់ ។
តើយើងអាចមានបន្ទប់គ្រែពីសម្រាប់រយៈពេលបីយប់បានទេ ?
តើអ្នកមានចំណូលចិត្តទៅនឹងបន្ទប់ប្រភេទអ្វីដែរ ?
ខ្ញុំចង់បានបន្ទប់ដែលមានទេសភាពមហាសមុទ្រ ។
ខ្ញុំចង់បានបន្ទប់ដែលមានគ្រែទំហំមនុស្សម្នាក់ ។
ខ្ញុំចង់បានបន្ទប់ដែលមានគ្រែទំហំមនុស្សពីរនាក់ ។
ខ្ញុំចង់ស្នាក់នៅទីនេះរហូតដល់ថ្ងៃអាទិត្យ ។
ខ្ញុំសុំទោស ប៉ុន្តែយើងមិនមានបន្ទប់ទំនេរទេយប់នេះ ។
ខ្ញុំខ្លាចតែយើងបានកក់ពេញអស់ហើយ ។
តើអ្នកអាចសូមណែនាំខ្ញុំទៅសណ្ឋាគាផ្សេងបានទេ ?
តើអ្នកអាចសូមណែនាំសណ្ឋាគាផ្សេងឱ្យខ្ញុំបានទេ ?
តើអ្នកមានបន្ទប់ទំនេរសម្រាប់យប់នេះដែរទេ ?
តើវាថ្លៃប៉ុន្មានសម្រាប់ក្មេង ?
បន្ទប់គ្រែមួយគឺមួយរយដុល្លារក្នុងមួយយប់រាប់បញ្ចូលទាំងអាហារពេលព្រឹក ។
បន្ទប់ជាន់ដំបូលរបស់យើងមានតម្លៃពីររយដុល្លារក្នុងមួយយប់ ។
ខ្ញុំខ្លាចតែវាថ្លៃពេកសម្រាប់ខ្ញុំ ។
ខ្ញុំបានបន្ទប់នៅក្រោមមួយរយដុល្លារ ។
តើអ្នកមានបន្ទប់ដែលមានទេសភាពទីក្រុងដែរទេ ?
តើវាជាមួយអាហារពេលព្រឹកដែរទេ ?
តើអត្រាបន្ទប់រាប់បញ្ចូលទាំងអាហារពេលព្រឹកដែរទេ ?
តើអត្រាបន្ទប់រាប់បញ្ចូលទាំងពន្ធ និងថ្លៃសេវាដែរទេ ?
តើខ្ញុំអាចយកស្នាមដិតនៃប័ណ្ណឥណទានរបស់អ្នកបានទេ ?
តាមប័ណ្ណឥណទាន ។
បង់តាមស្សែករបស់អ្នកទេសចរណ៍ ។
តើខ្ញុំអាចសុំប័ណ្ណសណ្ឋាគាររបស់អ្នកបានទេ ?
បន្ទប់របស់អ្នកគឺដប់ពីរ សែសិបបី នៅជាន់ទីដប់ពីរ ។
នេះគឺសោរបន្ទប់របស់អ្នក ។
ជណ្ដើរយន្ដនៅខាងស្ដាំដៃ ។
អរគុណ ។ នៅឱ្យសុខសប្បាយណា ។
ខ្ញុំចង់ចាកចេញមួយថ្ងៃមុនកំណត់ ។
ខ្ញុំចង់ស្នាក់នៅយូរជាងនេះមួយយប់ ។
ខ្ញុំចង់ស្នាក់នៅបីយប់ជំនួសឱ្យពីរយប់ ។
ខ្ញុំអាចកាន់វ៉ាល្លីរបស់ខ្ញុំបាន ។
តើអ្នកអាចជួយលើកឥវ៉ាន់ខ្ញុំបានទេ ?
តើច្រកចេញអាសន្ននៅឯណា ?
តើអ្នកមានអាងហែលទឹកនៅទីនេះដែរទេ ?
វាបើនៅម៉ោងប្រាំមួយ ។
តើខ្ញុំប្រើប្រអប់សុវត្ថិភាពបានទេ ?
តើថ្លៃបន្ទប់រាប់បញ្ចូលទាំងអាហារពេលព្រឹកដែរទេ ?
តើថ្លៃបន្ទប់រាប់បញ្ចូលពន្ធ និងថ្លៃសេវាកម្មដែរទេ ?
តើអ្នកអាចទូរស័ព្ទដាស់ខ្ញុំនៅម៉ោងប្រាំមួយព្រឹកស្អែកបានទេ ?
ខ្ញុំចង់បានម៉ាស៊ីនសម្ងួត ។
តើអ្នកអាចយកទឹកកក និងកែវពីរបានទេ ?
ខ្ញុំចង់ធ្វើការហៅនូវសេវាកម្មបន្ទប់ ។
តើខ្ញុំអាចមានសេវាកម្មបន្ទប់បានទេ ?
តើអ្នកអាចយកអាហារពេលព្រឹកនៅម៉ោងប្រាំបីព្រឹកស្អែកបានទេ ?
ខ្ញុំចង់កុម៉្មង់នំបុ័ងសាំងវ៉ិចត្រីថូណា និងតែមួយពែង ។
តើអ្នកអាចសូមយកកាហ្វេឱ្យខ្ញុំមួយពែងបានទេ ?
នេះគឺជាបន្ទប់លេខបី ដប់មួយ ។
តើអ្នកមានវិធីកំសាន្តអ្វីដែរទេ ?
ខ្ញុំចង់ផ្ញើសារនេះទៅប្រទេសជប៉ុនតាមទូរសារ ។
តើខ្ញុំអាចផ្ញើទូរសារមួយពីទីនេះបានទេ ?
តើអ្នកអាចផ្ញើប័ណ្ណប្រៃសណីយទាំងនេះឱ្យខ្ញុំបានទេ ?
ខ្ញុំបានស្នើសុំបន្ទប់គ្រែពីរ ហើយបន្ទប់នេះគឺគ្រែមួយគេងបានពីរនាក់ ។
ខ្ញុំបង្ខាំងទុកខ្លួនឯង ។
មានបញ្ហាមួយចំនួនជាមួយបន្ទប់របស់ខ្ញុំ ។
ខ្ញុំមិនអាចយកទឹកក្តៅប្រើបានទេ ។
ម៉ាស៊ីនត្រជាក់មិនដំណើរការក្នុងបន្ទប់របស់ខ្ញុំ ។
ឈុតទូរទស្សន៍មិនដំណើរការ ។
អំពូលភ្លើងលោតព្រិចៗ ។
អំពូលភ្លើងសឹងតែដាច់ ។
អំពូលភ្លើងបានដាច់ ។
តើខ្ញុំអាចប្ដូរអំពូលភ្លើងបានទេ ?
ខ្ញុំនឹងបញ្ជូននរណាម្នាក់ទៅពិនិត្យមើល ។
ជាងជួសជុលនឹងទៅដល់ខាងលើឥឡូវនេះហើយ ។
ខ្ញុំចង់ទូរស័ព្ទរកសេវាកម្មបន្ទប់ ។
អំពូលភ្លើងបានដាច់ ។
តើអ្នកអាចប្ដូរអំពូលម៉ែត្រនេះបានទេ ?
យើងបានទទួលខោអាវបោកគក់ស្អាតនៅព្រឹកនេះ ប៉ុន្តែមានបាត់មួយ ។
អាវក្រៅរបស់ខ្ញុំ ។
ចុះវាអាវក្រៅរបស់អ្នកមានពណ៌អ្វីដែរ ?
វាពណ៌ត្នោតស្រាល ។
តើអ្នកអាចពិនិត្យរកមើលវាឆាប់ៗបានទេ ?
បាទ ខ្ញុំនឹងរកមើលវាជូនអ្នកភ្លាមៗនេះ ។
បាទ ចា៎ស ខ្ញុំបានផឹកទឹករ៉ែអស់មួយដប ។
យើងមិនបានធ្វើការហៅទូរស័ព្ទណាមួយទេ ។
ពិតមែន ? ឱ្យខ្ញុំពិនិត្យមើលកុំព្យូទ័ររបស់យើងសិន ។
នេះវិក្កយបត្រអ្នក ។
ខ្ញុំបានពិនិត្យចេញ ប៉ុន្តែខ្ញុំបានទុកវ៉ែនតារបស់ខ្ញុំក្នុងបន្ទប់ ។
ពួកយើងនៅមិនទាន់សំរេចចិត្តនៅឡើយទេ ។
អូខេ សូមចំណាយពេលអ្នកចុះ ។ ខ្ញុំនឹងត្រឡប់មកវិញពេលក្រោយ ។
តើអ្នកចង់បានកាហ្វេ ឬតែ បន្ទាប់ពីអាហារ ?
ខ្ញុំត្រូវការហេមបឺរហ្គ័រមួយ និងទឹកក្រូចល្មមមួយ ។
តើខ្ញុំអាចយកកាហ្វេបន្ថែមខ្លះបានជូនលោកបានទេ ?
ទេ អរគុណ ។ យើងជិះចាកចេញហើយ ។
មិនអីទេអញ្ចឹង ។ ខាងក្រោមនេះជាវិក័យប័ត្រ ។ ខ្ញុំសង្ឃឹមថាអ្នករីករាយនឹងអាហារបាន ។
តើអ្នកចង់គិតប្រាក់ដោយឡែក ?
ទេ គិតចូលគ្នាទៅ ។ តើអ្នកទទួលមូលប្បទានប័ត្រអ្នកធ្វើដំណើរដែរទេ ?
សូមអធ្យាស្រ័យ យើងទទួលតែប្រាក់សុទ្ធទេ ។
តើអ្នកអាចណែនាំភោជនីយដ្ឋានអ៊ីតាលីនៅក្បែរនេះ ?
ខ្ញុំចង់ញុំាម្ហូបជប៉ុនមួយចំនួន ។
ខ្ញុំចង់ញុំាម្ហូបក្នុងតំបន់មួយចំនួន ។
ខ្ញុំចូលចិត្ដភោជនីយដ្ឋានតូចមួយដែលមានតន្ដ្រីកំដរ ។
ខ្ញុំចង់ញុំាអាហារពេលព្រឹកបែបអាមេរិក ។
ខ្ញុំត្រៀមចំណាយប៉ែតសិបដុល្លារក្នុងម្នាក់សម្រាប់អាហារល្ងាចល្ងាចនេះ ។
សាយ័ណ្ណសួស្ដី ។ ខ្ញុំឈ្មោះស៊ូស៊ូគិ ។
បាទ ខ្ញុំបានកក់ទុកសម្រាប់ម៉ោងប្រាំពីរ ។
ខ្ញុំមិនបានកក់ទុកទេ ។ តើអ្នកមានតុសម្រាប់មនុស្សពីនាក់ដែរទេ ?
យើងមានគ្នា៨នាក់ ។
យើងចង់អង្គុយនៅលើល្បាក់ជម្រាល ។
យើងចង់បានតុនៅតំបន់គ្មានផ្សែងបារី ។
តើខ្ញុំអាចអង្គុយកន្លែងដែលខ្ញុំចូលចិត្តបានទេ ?
សូមអធ្យាស្រ័យ វាមិនអាចទៅរួចទេ ។
យើងពេញឥឡូវនេះហើយ ។ តើអ្នកអាចរង់ចាំបន្តិចបានទេ ?
ខ្ញុំខ្លាចតែតុរបស់យើងពេញអស់ហើយ ។
សូវរង់ចាំមួយភ្លែត ។
តើត្រូវរង់ចំាយូរប៉ុណ្ណា ?
ប្រហែលដប់ប្រាំនាទី ។
យើងអាចមានតុទំនេរនៅម៉ោងប្រហែលប្រាំបួន ។
តើអ្នកចង់រង់ចាំនៅបារដែរទេ ?
ទិវាសួស្តី អ្នកស្រី ។
យើងនឹងទូរស័ព្ទទៅអ្នកឆាប់ៗនៅពេលបើក ។
តើវារួចរាល់នៅ ?
យើងមានក្រមសំលៀកបំពាក់នៅទីនេះ ។
អាវក្រៅ និងក្រវ៉ាត់កត្រូវបានតម្រូវ ។
អាវក្រៅកីឡាត្រូវបានតម្រូវ ។
ខ្ញុំស្នើសុំឱ្យអ្នកប្ដូរខោអាវ ហើយត្រឡប់ម្តងទៀតលោក ។
តើអ្នកអាចដោះអាវធំរបស់ខ្ញុំបានទេ ?
ខ្ញុំសង្ឃឹមថាអ្នកនឹងរីករាយជាមួយអាហាររបស់អ្នក ។
តើអាហាររបស់អ្នកយ៉ាងម៉េចដែរ ?
គ្មានយើងនៅតែបរិភោគ ។
ទេ ខ្ញុំធ្វើមិនទាន់ហើយទេ ។
តើខ្ញុំអាចសម្អាតខ្លះសម្រាប់អ្នកបានទេ ?
តើមេចុងភៅណែនាំអ្វី ?
