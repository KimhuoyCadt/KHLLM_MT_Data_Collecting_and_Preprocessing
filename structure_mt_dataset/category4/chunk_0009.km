មានប្រជាជនចម្រុះជាតិសាសន៍ផងដែរ ។
ខ្ញុំចូលចិត្តវានៅទីនេះ ។
តើមានជនជាតិជប៉ុនច្រើនទេមកហាងនេះ ?
នៅក្នុងពេលរដូវក្តៅ មានមកច្រើន ។
តើមានអ្នកមគ្គទេសន៍មកជាមួយទេ ?
ទេ ពួកគេមកតែឯង ។
តើនរណាខ្លះមកហាងនេះ ?
តើអ្នកអាចបញ្ចុះតម្លៃមួយនេះបន្តិចបានទេ ?
ខ្ញុំនឹងសួរប្រធាន ។
ខ្ញុំអាចបញ្ចុះតម្លៃបានបីភាគរយ ។
តើអ្នកមិនអាចបញ្ចុះបន្តិថែមទៀតទេ ?
តើអ្នកអាចបញ្ចុះឱ្យខ្ញុំដប់ភាគរយបានទេ ?
ប្រសិនបើខ្ញុំទិញពួកវាបី តើខ្ញុំអាចបានការបញ្ចុះតម្លៃបីភាគរយបានទេ ?
បាទ ចាស ពួកយើងអាចបញ្ចុះបានប្រាំភាគរយ ។
សូមបញ្ចុះឱ្យខ្ញុំដប់ភាគរយ ខ្ញុំនឹងទិញវា ។
តើអ្នកចុះត្រឹមមួយរយដុល្លារបានទេសម្រាប់មួយនេះ ?
ទេ វាមិនអាចទៅរួចទេ ។
ហើយចុះបើមួយរយម្ភៃប្រាំដុល្លារ ?
ខ្ញុំមិនអាចបញ្ចុះទាបជាងមួយរយសែសិបប្រាំដុល្លារបានទេ ។
ហើយចុះបើមួយរយដុល្លារសម្រាប់មួយនេះយ៉ាងណាដែរ ?
តើខ្ញុំអាចបញ្ចុះតម្លៃបានប៉ុន្មានសម្រាប់មួយនេះ ?
ខ្ញុំនឹងបញ្ចុះតម្លៃឱ្យអ្នកបានប្រាំភាគរយ ។
វានៅតែថ្លៃខ្លាំង ។ ចុះបើមួយរយដុល្លារយ៉ាងម៉េចដែរ ?
ខ្ញុំមិនអាចធ្វើបែបនេះបានទេ ប៉ុន្តែសម្រាប់អ្នកខ្ញុំបញ្ចុះជូនមួយ ។
អត់ទោស សូមឱ្យខ្ញុំខ្ចីម៉ាស៊ីនគិតលេខបានទេ ។
តើអ្នកធ្វើអ្វីមួយសម្រាប់តម្លៃនេះបានទេ ?
ខ្ញុំមិនអាចបញ្ចុះក្រោមតម្លៃនេះបានទេ ។
សូមឱ្យខ្ញុំខ្ចីក្រដាសខ្លះ និងប៊ិចមួយបានទេ ?
បាទ ចាស ប៉ុន្តែខ្ញុំនឹងទិញវានៅទីនេះប្រសិនបើអ្នកគិតឱ្យខ្ញុំក្នុងតម្លៃដូចគ្នា ។
តើខ្ញុំអាចបានតម្លៃដូចគ្នាបានទេ ?
នៅពេលដែលខ្ញុំមកទស្សនាពេលក្រោយ ខ្ញុំប្រាកដជាមកម្តងទៀត ។ ដូច្នេះ តើអ្នកអាចបញ្ចុះតម្លៃឱ្យខ្ញុំបានទេ ?
តើពេលណាអ្នកនឹងមកម្តងទៀត ?
ប្រហែលជារយៈពេលមួយឆ្នាំ ។
ខ្ញុំនឹងប្រាប់មិត្តរបស់ខ្ញុំអំពីហាងនេះ ដូច្នេះសូមផ្តល់ឱ្យខ្ញុំទៅ ។
តើអ្នកនឹងប្រាប់ពួកគេថាយ៉ាងដូម្តេច ?
អ្នកលក់ចិត្តល្អណាស់នៅក្នុងហាងនេះ ។
សូមកាត់ពន្ធចេញទៅ ។
ខ្ញុំគិតថាម្តាយខ្ញុំបា្រកដជាចូលចិត្តវត្ថុអនុស្សាវរីយ៍នេះ ។
តើអំណោយនេះសម្រាប់ម្តាយអ្នកឬ ? ខ្ញុំគិតថាគាត់នឹងចូលចិត្ត ។
ប៉ុន្តែវាលើថវិកាបន្តិចហើយ ។ ប្រសិនបើអ្នកបញ្ចុះតម្លៃ ខ្ញុំបាកដជាកោតសរសើរខ្លាំងណាស់ ។
មិនអីទេ ខ្ញុំទាយថាខ្ញុំអាចបញ្ចុះតម្លៃឱ្យអ្នកបានបីភាពរយ ។
នេះជាសាច់ប្រាក់ទាំងអស់ដែលខ្ញុំមាន ។
តើអ្នកមិនមានប័ណ្ណឥណទានទេឬ ?
ទេ តើអ្នកមិនអាចលក់មួយនេះច្រើនបានទេ ?
អ្នកអាចទិញវត្ថុទាំងនេះសម្រាប់បរមាណហ្នឹង ។
ទេ ខ្ញុំពិតជាចូលចិត្តមួយនេះ ។
សូមលក់វាមកឱ្យខ្ញុំ ។
ខ្ញុំចង់បានរបស់នេះ ។ ប៉ុន្តែវាលើថវិការបស់ខ្ញុំបន្តិចហើយ ។
តើអ្នកអាចចំណាយប៉ុន្មាន ?
បីរយដុល្លារ ។ តើអ្នកអាចបញ្ចុះថ្លៃពន្ធបានទេ ?
ខ្ញុំពិតជាចូលចិត្តមួយនេះណាស់ ប៉ុន្តែខ្ញុំចង់មើលវត្ថុផ្សេងផងដែរ ។
ល្អ នេះជាការតថ្លៃដ៏ពិតប្រាកដមួយ ។
សូមឱ្យខ្ញុំគិតពីវា ។ ខ្ញុំនឹងទៅត្រួតពិនិត្យជាមួយតូបផ្សេង ។
ខ្ញុំចង់មើលជំវិញ ។
កាបូបនេះគឺរហែកត្រង់គែម ។
ខ្ញុំនឹងជួសជុលស្នាមរហែកខ្លួនឯង ដូច្នេះតើអ្នកអាចបញ្ចុះតម្លៃឱ្យខ្ញុំបានទេ ?
ល្អ ខ្ញុំនឹងបញ្ចុះឱ្យប្រាំភាគរយ ។
ដៃអាវនេះវែងបន្តិចហើយ ។ តើអ្នកអាចកែឱ្យវាខ្លីជាងនេះបានទេ ?
បាទ ចាស ខ្ញុំនឹងយករយៈពេលពីរថ្ងៃ ។ តើវាមិនអីទេឬ ?
ខ្ញុំនឹងចាកចេញទៅប្រទេសជប៉ុននៅថ្ងៃស្អែក ។ ខ្ញុំអាចជួសជុលវានៅឯប្រទេសជប៉ុន ដូច្នេះអ្នកអាចបញ្ចុះតម្លៃបានទេ ?
មិនអីទេ ចុះតម្លៃបានប្រាំភាគរយ ។ តើប៉ុណ្ណឹងយល់ព្រមទេ ?
ខ្ញុំអាចជួសជុលវានៅប្រទេសជប៉ុន ដូច្នេះសូមបញ្ចុះឱ្យដប់ដុល្លារមក ។
តើអ្នកអាចគិតបីរយដុល្លារបានទេ ?
បីរយដុល្លារ ? តើអ្នកចង់គិតប្រាក់របៀបណា ?
អ៊ឹម មិនអីទេ ។
ខ្ញុំនឹងទូទាត់ជាសាច់ប្រាក់សម្រាប់តម្លៃល្អប្រសើរជាងនេះ ។
ខ្ញុំសប្បាយចិត្ត ។ ខ្ញុំទទួលបានការដោះស្រាយយ៉ាងល្អ ។ អរគុណច្រើន ។
ខ្ញុំរីករាយណាស់ដែលអ្នកសប្បាយរីករាយ ។
ខ្ញុំនឹងមកតូបនេះម្តងទៀត ។
សូមមកម្តងទៀត ។ ពួកយើងរង់ចាំ ។
ខ្ញុំបានទិញយ៉ាងល្អ ។
ខ្ញុំមិនអាចពន្យល់វាបានល្អទេ ។ តើមាននរណាម្នាក់ចេះនិយាយភាសាជប៉ុនទេ ?
ខ្ញុំសោកស្តាយណាស់ពុំមាននរណាម្នាក់ចេះនិយាយភាសាជប៉ុនទេ ។
អូ ពិតឬ ? តើខ្ញុំអាចដូចម្តេចទៅ ?
ខ្ញុំនឹងពិនិត្យមើលក្បែរនេះ ។ ប្រហែលជាមានមនុស្សជនជាតិជប៉ុននិយាយភាសាអង់គ្លេសម្នាក់ ។
ខ្ញុំមិនអាចសម្រេចចិត្តបានទេ ដូច្នេះខ្ញុំនឹងគិតវាមួយយប់សិន ។
ល្អ ខ្ញុំនឹងបញ្ចុះតម្លៃបីភាគរយ ។ តើវាយ៉ាងណាដែរ ?
ខ្ញុំត្រូវតែគិតពីរវាថែមទៀត ។
ខ្ញុំយល់ហើយ ។ សង្ឃឹមថាជួបអ្នកម្តងទៀតនៅថ្ងៃស្អែក ។
ប្រសិនបើអ្នកអាចបញ្ចុះតម្លៃថែមទៀត ខ្ញុំនឹងទិញវា ។
ខ្ញុំមិនអាចបញ្ចុះជាងនឹងបានទេ ។
សូមទុកឱ្យខ្ញុំគិតអំពីវា ។ សូមសរសេរឈ្មោះរបស់អ្នក និងតម្លៃបញ្ចុះនៅលើប័ណ្ណអាជីវកម្មរបស់អ្នក ។
យល់ព្រម ខ្ញុំយល់ហើយ ។
សូមសរសេរឈ្មោះរបស់អ្នក និងតម្លៃចុងក្រោយ ។
អ្នកពិតជាល្អមែន ។
អរគុណអ្នក ។ ប៉ុន្តែខ្ញុំមិនចូលចិត្តម៉ូតនេះទេ ។ ហើយខ្ញុំគិតថាខ្ញុំមិនអាចពាក់វានៅក្នុងប្រទេសជប៉ុនបានទេ ។
នៅទីនេះវាមិនត្រជាក់ដូចនៅប្រទេសជប៉ុនទេ ។
នេះមិនមែនជាវាទេ ។
នៅពេលដែលខ្ញុំលើកដៃរបស់ខ្ញុំ វាតឹងបន្តិច ។ តើខ្ញុំអាចសាកទំហំបន្ទាប់បានទេ ?
យល់ព្រម សូមសាកមួយនេះមើល ។
មួយនេះវាធំខ្លាំងណាស់ ។
ខ្ញុំត្រូវការទំហំផ្សេងពីនេះ ។
ពិតណាស់ ឥលូវនេះតម្លៃចុងក្រោយជាតម្លៃមួយពិសេសណាស់ ។
ខ្ញុំគ្រាន់តែមិនអាចទិញវា ។
វាមិនមែនសម្រាប់ខ្ញុំទេ ខ្ញុំគិតថានឹងជូនមិត្តភក្កិរបស់ខ្ញុំ ។
តើអ្នកស្គាល់ចំណង់ចំណូលចិត្តរបស់មិត្តភក្កិអ្នកលើសំលៀកបំពាក់ទេ ?
ដឹងច្រើន ។ ប៉ុន្តែបើគេទទួលបានអ្វីមួយដែលគេមិនចូលចិត្ត ពួកគេនឹងមិនសប្បាយរីករាយទេ ។
នេះសម្រាប់មិត្តភក្កិរបស់ខ្ញុំ មិនមែនខ្ញុំទេ ។
របស់នេះទើបតែមកដល់កាលពីម្សិលមិញ ។
អូ ពិតឬ ។ ខ្ញុំចង់ចំណាយពេល និងមើលផ្ទាល់ខ្លួនរបស់ខ្ញុំ ។
យល់ព្រម សូមធ្វើតាមដំណើរចុះ ។ សូមប្រាប់ខ្ញុំឱ្យដឹងប្រសិនបើអ្នកត្រូវការអ្វីមួយ ។
អរគុណច្រើន ខ្ញុំនឹងប្រាប់ ។
ខ្ញុំចំណាយពេលផ្ទាល់ខ្លួនរបស់ខ្ញុំ ។
វាថោកជាងនៅក្នុងប្រទេសជប៉ុនខ្លាំងណាស់ ។
វាថោកជាងនៅក្នុងប្រទេសជប៉ុនខ្លាំងណាស់ ។ ប៉ុន្តែកាលពីម្សិលមិញខ្ញុំបានចំណាយច្រើនណាស់ ដូច្នេះថ្ងៃនេះខ្ញុំមិនចំណាយច្រើនទេ ។
តើអ្នកបានទិញអ្វី ?
ខ្ញុំត្រូវការសន្សំសំចៃលុយ ។
តើខ្ញុំអាចត្រឡប់ ឬប្ដូមួយនេះបានទេ ?
ពួកយើងអាចប្ដូរវាបាន ។ ប្រសិនបើរបស់ខូច ពួកយើងអាចប្ដូរលុយជូនវិញបាន ។
ប្រសិនបើខ្ញុំចង់ដោះដូរមួយនេះ ពេលណាដែលខ្ញុំអាចមកយក ?
ក្នុងរយៈពេលមួយសប្ដាហ៍ សូមយកវិក័យប័ត្ររបស់អ្នកមកផង ។
អាវរងារពណ៌ដែលខ្ញុំបានទិញកាលពីសប្ដាហ៍មុនមិនសមខ្ញុំសោះ ។ តើខ្ញុំអាចប្ដូរវាយកពណ៌ផ្សេងបានទេ ?
តើពណ៌សល្អជាងនេះទេ ?
បាទ ចាស ខ្ញុំនឹងយកអាមួយពណ៌ស ។
នៅពេលដែលខ្ញុំពាក់មួយនេះ ទទឹងដូចជាតឹងបន្តិច ។ ដូច្នេះ ខ្ញុំចង់ដូរយកលុយវិញ ។
តូបនេះពុំមានគោលនយោបាយដូរជាលុយវិញទេ ។ ប៉ុន្តែពួកយើងអាចប្ដូរជូនអ្នកបាន ។
ប៉ុន្តែខ្ញុំមិនចូលចិត្តអ្វីមួយនៅទីនេះទេ ។ តើអ្នកអាចធ្វើអ្វីមួយចំពោះការប្ដូរជាលុយបានទេ ?
ខ្ញុំនឹងសួរម្ចាស់ហាង ។
អត់ទោស តើខ្ញុំអាចសុំកន្ត្រកដើរទិញឥវ៉ាន់ថែមទៀតបានទេ ?
ទេ ដូចមួយនេះល្អហើយ ។
យល់ព្រម នៅទីនេះ ។
តើខ្ញុំអាចសុំកន្ត្រកមួយទៀតបានទេ ?
តើខ្ញុំអាចឱ្យខ្ចប់អំណោយនេះបានទេ ?
តើបូពណ៌អ្វីដែលអ្នកចូលចិត្ត ពណ៌ផ្កាឈូក ឬពណ៌ខៀវ ?
សូមខ្ចប់ពួកវាដាច់ដោយឡែកពីគ្នា ។
ខ្ញុំចង់ឱ្យអ្នកខ្ចប់វាដាច់ដោយឡែកពីគ្នា ។
វានឹងចំណាយពេលម្ភៃនាទី ។
ខ្ញុំត្រូវមានអ្វីធ្វើនៅហាងផ្សេង ។ ខ្ញុំនឹងត្រឡប់មកវិញនៅសាមសិបនាទីទៀតដើម្បីយកវា ។
យល់ព្រម សាមសិបនាទី ពួកយើងនឹងធ្វើវារួចរាល់ ។
តើអ្នកអាចយកមួយនេះទៅកាន់សណ្ឋាគារបានទេ ?
បាទ ចាស ពុំមានបញ្ហាទេ ។ តើសណ្ឋាគារមួយណា ?
តើអ្នកអាចដឹកជញ្ជូនមួយនេះបានទេ ?
តើខ្ញុំត្រូវចំណាយលើជម្រើសទាំងនេះ ឬក៏ពួកវាមិនគិតប្រាក់ ?
ពួកវាមិនគិតប្រាក់ទេ ។
តើវាត្រូវចំណាយពេលប៉ុន្មាន ?
វាគួរតែរួចរាល់នៅមុនរសៀលនេះ ។
តើខ្ញុំត្រូវចំណាយលុយថ្លៃជម្រើសនេះទេ ?
តើវាធានារយៈពេលប៉ុន្មាន ?
ប្រសិនបើខ្ញុំផ្ញើរវាមកពីប្រទេសជប៉ុន តើអ្នកអាចជួសជុលវាបានទេ ?
ពិតណាស់ ។ ពួកយើងនឹងឱ្យនាមប័ណ្ណអាជីវកម្មរបស់យើង ។
ខ្ញុំបានសម្រេចចិត្តថាទិញជញ្ចៀនដែលអ្នកបានបង្ហាញខ្ញុំ ។ តើអ្នកអាចទុកវាឱ្យខ្ញុំបានទេ ?
អាមួយថ្លៃប្រាំរយដុល្លារ ត្រូវទេ ?
ខ្ញុំនឹងមកនៅថ្ងៃស្អែកដើម្បីយកវា ។
ពួកយើងនឹងរង់ចាំ ។
តើអ្នកអាចទុកមួយនេះសម្រាប់ខ្ញុំបានទេ ?
តើខ្ញុំគួរទុកវាឬ ?
តើវាមិនអីទេឬ ? ខ្ញុំមិនអាចសម្រេចចិត្តពេលនេះបានទេ ។ ដូច្នេះ ខ្ញុំនឹងទូរស័ព្ទមកនៅពេលក្រោយ ។
ពួកយើងបើកទ្វារហូរដល់ម៉ោងប្រាំបី ។ សូមសម្រេចចិត្តមុនពេលហ្នឹង ។
ខ្ញុំមិនអាចសម្រេចចិត្តបានទេ ដូច្នេះខ្ញុំនឹងទូរស័ព្ទមកនៅពេលក្រោយ ។
សូមប្រាប់ខ្ញុំបានទេថាភោជនីយដ្ឋានណាដែលមានប្រជាប្រិយនៅក្នុងតំបន់នេះ ។
ដោយរថយន្តតាក់ស៊ី វាចំណាយពេលប្រាំនាទី ។
តើមានភោជនីយដ្ឋានល្អមួយនៅឯណា ?
សម្រាប់មនុស្សពីរនាក់ តើនឹងអស់ថ្លៃប៉ុន្មាន ?
សម្រាប់តែអាហារគឺសែសិបដុល្លារ ។ ស្រាមួយដបនឹងមានតម្លៃប្រហែលដប់ដុល្លារ ។
វ៉ោ វាសមរម្យខ្លាំងណាស់ ។ ខ្ញុំនឹងសាកភោជនីយដ្ឋាននោះ ។
វានៅក្បែរសណ្ឋាគារ Star ។ ដូច្នេះអ្នកគួរតែអាចរកវាឃើញដោយស្រួល ។
តើភោជនីយដ្ឋាននេះមានតម្លៃប៉ុន្មាន ?
តើអ្នកណែនាំអ្វីនៅក្នុងភោជនីយដា្ឋននោះ ?
ឥលូវនេះជារដូវអយស្ទ័រ ដូច្នេះពួកវានឹងល្អ ។
តើអាហារអ្វីដែលឆ្ងាញ់ ?
តើអ្នកដឹងថាតើភោជនីយដ្ឋាននោះតម្រូវឱ្យកក់ឬទេ ?
ថ្ងៃនេះគឺគ្មានបញ្ហាទេ ប៉ុន្តែនៅចុងសប្ដាហ៍អ្នកត្រូវតែធ្វើការកក់ជាមុន ។
តើអ្នកមានស្គាល់លេខទូរស័ព្ទទេ ?
តើអ្នកចង់ឱ្យខ្ញុំត្រួតពិនិត្យសៀវភៅលេខទូរស័ព្ទទេ ?
តើមានលេខកូដសំលៀកបំពាក់នៅក្នុងភោជនីយដ្ឋាននោះទេ ?
តើមនុស្សម្នាជាធម្មតាពាក់អ្វី ?
វាអាស្រ័យលើបុគ្គល ។ អ្នកខ្លះស្លៀកខោខោប៊យ ហើយអ្នកស្លៀកពាក់ខោអាងកំប្លេ ។
តើមនុស្សម្នាស្លៀកពាក់បែបណា ?
តើវាអាចទៅរួចទេដែលយកតុជាប់បង្អួច ?
ខ្ញុំសុំទោស ។ ពួកយើងពុំមានតុដែលអ្នកស្នើទេ ។ នៅមួយម៉ោងទៀតតុនោះនឹងរួចរាល់ ។ តើអ្នកចង់ធ្វើបែបហ្នឹងឬ ?
ពួកយើងនឹងត្រឡប់មកវិញនៅមួយម៉ោងទៀត ។
សូមផ្តល់ពេលឱ្យពួកយើងបន្តិចទៀតមក ។
មិនអីទេ ។ ខ្ញុំនឹងមកពេលក្រោយ ។
សូមមេត្តារង់ចាំ ។
ខ្ញុំមិនយល់ពីបញ្ជីមុខម្ហូបនេះទេ ។ ខ្ញុំចង់ញ៉ាំត្រី ហើយនិងសាលាដមួយផងដែរ ។
ត្រី ? ភាពពីសេសថ្ងៃនេះគឺត្រីសំប៉ែតៗ ។
ខ្ញុំនឹងយកវា ។ តើអ្នកអាចធ្វើសាលាដមានតែបន្លែបានទេ ?
ខ្ញុំមានអារម្មណ៍ថាចង់ញ៉ាំត្រីខ្លះ ។
ខ្ញុំមិនស្គាល់ឈ្មោះស្រាខកថែលទេ ដូច្នេះតើអ្នកអាចធ្វើស្រាខកថែសបានទេ ?
យល់ព្រមសម្រាប់អ្នក ខ្ញុំនឹងធ្វើស្រាស ជាមួយសាបារាំង ។
សូមធ្វើស្រាខកថែលឱ្យខ្ញុំមួយ ។
ខ្ញុំមកទីនេះមួយឆ្នាំមុន ។ អាហារគឺអស្ចារ្យណាស់ ។
តើអ្នកបានញ៉ាំអ្វីនៅពេលមុន ?
ខ្ញុំគិតថាម្ហូបមាន់មានគ្រឿងផ្សំជី ។
កាលពីពេលមុនខ្ញុំមកទីនេះ ខ្ញុំញ៉ាំអាហារឆ្ងាញ់ណាស់ ។
អត់ទោស ។ តើពួកគេកំពុងញ៉ាំអ្វីនៅតុនោះ ? វាមើលទៅគួរឱ្យឆ្ងាញ់ ។
វាត្រូវចំណាយពេលខ្លះដើម្បីធ្វើវា ប៉ុន្តែវាជាមុខម្ហូបដែលមានប្រជាប្រិយខ្លាំងមួយរបស់យើង ។
សូមទុកវាទីនោះចុះ ។
ត្រីសាលម៉ុនញាត់ស្លឹកជីដុត ។
ហេតុអ្វីបានជាអ្នកមិនសាកវា ?
តើខ្ញុំគួរតែសាកអ្វី ?
តើអ្វីជាគ្រឿងក្លែមរបស់អ្នក ?
គ្រំចំពុះទាជាលក្ខណៈក្នុងខេត្ត ។
ចូរបា្រប់ខ្ញុំអ្វីដែលពិសេសថ្ងៃនេះ ។
ទេ ខ្ញុំគិតថាអ្នកនឹងមិនចូលចិត្តវាទេ ។
តើមានរសជាតិអ្វី ?
តើចំណែកនោះធំប៉ុណ្ណាទៅ ?
វាគឺសាច់មួយរយហាសិបក្រាមជាមួយនិងបន្លែបីប្រភេទ ។
មិនមានសាច់ក្លែមទេ មានតើម្ហូបហ្នឹង ។
ពួកយើងចង់រំលែកការកុម្ម៉ងនោះរវាងពួកយើងបីនាក់ ។
តើខ្ញុំអាចបែងចែកវាបានទេមិននឹងខ្ញុំបញ្ចេញវាមកក្រៅ ?
វាមកជាមួយនិងដំឡូងចៀន និងដំឡូងដុត ។
តើអ្នកត្រូវការដំឡូងចៀន ឬដំឡូងដុត ?
ខ្ញុំសុំកាហ្វេមក ?
វាល្អហើយអរគុណ ។
សូមមួយពែងទៀត ។
ហើយប្រសិនបើមានស្ពៃខៀវ ខ្ញុំចង់បានវាខ្លះ ។
នេះវាខុសពីអ្វីដែលខ្ញុំកុម្ម៉ង់ ។ ខ្ញុំពុំបានកុម្ម៉ងបែបនេះទេ ។
ដូច្នេះ តើការកុម្ម៉ង់រួចរាល់នៅ ?
ខ្ញុំនឹងយកវាមកឆាប់ៗ ។
មើលទៅស្រស់ស្អាតណាស់ ។
វ៉ោ វាមានក្លិនឈ្ងុយ ។
រីករាយអាហារពេលល្ងាចរបស់អ្នក ។
អូ រីករាយថ្ងៃខួបកំនើត ។
វាជាថ្ងៃខួបកំណើតរបស់នាង ។
អាហារគឺឆ្ងាញ់ ប៉ុន្តែខ្ញុំមិនអាចបញ្ចប់វាបានទេ ។ តើខ្ញុំអាចខ្ចប់អានៅសល់ទៅផ្ទះបានទេ ?
មិនអីទេ ។ ខ្ញុំនឹងឱ្យគេខ្ចប់សម្រាប់អ្នក ។
ទុកវានៅក្នុងទូរទឹកកកឱ្យឆាប់តាមតែអ្នកអាចធ្វើបាន ។
តើខ្ញុំអាចយករបស់នេះទៅបានទេ ?
ខ្ញុំចង់បានស្រាមួយកែវទៀត ។
វាគឺជាថ្លៃសេវាកម្ម ។
ខ្ញុំសុំទោសផង ។ វាជាកំហុសរបស់ពួកយើង ។
តើខ្ញុំអាចមើលវិក័យប័ត្របានទេ ?
អរគុណអ្នកច្រើន ។ តើអាហារយ៉ាងណាដែរ ?
ខ្ញុំនឹងយកមូលប្បទានប័ត្ររបស់អ្នកភ្លាម ។
សុំទោស ពួកយើងមិនទទួលរូបីយប័ណ្ណបរទេសទេ ។ តើអ្នកមានប័ណ្ណឥណទានទេ ?
តើប័ណ្ណឥណទានបែបណាដែលខ្ញុំអាចប្រើ ?
តើប័ណ្ណនេះអាចបានទេ ?
ពួកយើងចង់បង់ប្រាក់ម្នាក់ៗ ។
កាហ្វេ និងនំភី ។
វាគឺប្រាំពីរដុល្លារ ។
អត់ទោស តើអ្នកអាចប្ដូរជាសន្លឹកមួយដុល្លារបានទេ ?
សូមមួយភាគបួនមក ។
ខ្ញុំត្រូវការលុយរាយ ។
តម្លៃសរុបគឺដប់ប្រាំដុល្លារ ។
បាទ ហើយនៅក្នុងរដូវស្លឹកឈើជ្រុះ ពណ៌បានប្ដូរល្អណាស់ ។
នៅពេលបន្ទាប់ ខ្ញុំនឹងមកនៅរដូវស្លឹកឈើជ្រុះ ។
វាស្រស់ស្អាតណាស់នៅទីនេះ ។
ទេ ខ្ញុំមិនចូលចិត្តមើលវាទេ ។
ប្រសិនបើអ្នកមកពីប្រទេសជប៉ុន ខ្ញុំនឹងជាអ្នកនាំផ្លូវរបស់អ្នក ។
តើអ្នកចង់ឃើញប្រទេសជប៉ុនទេ ?
តើអ្នកកើតនៅទីនេះឬ ?
ខ្ញុំបានកើតនៅក្រុងមួយប្រហែលមួយរយគីឡូម៉ែតពីទីនេះ ។
តើពេលណាដែលអ្នកចាប់ផ្តើមរស់នៅទីក្រុងនេះ ?
ចាប់តាំងពីខ្ញុំជាសិស្សវិទ្យាល័យ ។
ភាសាវិទ្យា ។ ខ្ញុំគ្រាន់តែចាប់ផ្តើមសិក្សាភាសាជប៉ុននៅឆ្នាំនេះ ។
តើកន្លែងអ្វីដែលខ្ញុំគួរតែទៅទស្សនានៅជុំវិញនៅទីនេះ ?
ពីភ្នំនោះ អ្នកអាចឃើញទីក្រុងទាំងមូល ។ នៅអំឡុងរដូវនេះ មានផ្ការីកច្រើនប្រភេទ ។ ពួកវាស្រស់ស្អាតណាស់ ។
តើកន្លែងណាដែលខ្ញុំគួរតែទស្សនា ?
ដើម្បីជាការចងចាំ តើពួកយើងអាចថតរូបបានទេ ?
នៅពេលដែលខ្ញុំទទួលបានស្រោមសំបុត្ររូបថត ខ្ញុំនឹងផ្ញើរវា ។
អរគុណច្រើន ខ្ញុំទន្ទឹងរង់ចាំវា ។
នៅពេលព្រឹកខ្ញុំនឹងទៅសាលា ប៉ុន្តែខ្ញុំមិនមានគម្រោងពិសេសទេនៅរសៀលនេះ ។
ប្រសិនបើអ្នកមានពេល តោះយើងញ៉ាំអាហារថ្ងៃត្រង់រួមគ្នា ។
វាស្តាប់ទៅល្អ ។ នៅពេលរសៀលតើអាចឱ្យខ្ញុំធ្វើជាអ្នកនាំផ្លូវរបស់អ្នកតាមទីក្រុងនេះទេ ?
ប្រសិនបើមិនថ្វីទេ តើអ្នកអាចប្រាប់ខ្ញុំអាស័យដ្ឋានរបស់អ្នកបានទេ ?
ពិតណាស់ មិនមានបញ្ហាទេ ។ សូមប្រាប់ខ្ញុំអាស័យដ្ឋានរបស់អ្នកផងដែរ ។
នៅពេលដែលខ្ញុំត្រឡប់ទៅប្រទេសជប៉ុន ខ្ញុំនឹងសរសេរសំបុត្រមួយ ។ ប្រសិនបើអ្នកមានពេល សូមផ្ញើរសំបុត្រមកខ្ញុំមក ។
ខ្ញុំពិតជានឹងផ្ញើរសំបុត្រទៅអ្នក ។
តើមនុស្សនៅទីនេះធ្វើអ្វីនៅថ្ងៃសម្រាករបស់ពួកគេ ?
នៅរដូវក្តៅមនុស្សម្នាទៅបោះជំរុំ ប៉ុន្តែនៅរដូវរងារមនុស្សស្នាក់នៅផ្ទះ ។
ជាមួយនិងគ្រួសាររបស់គេ ។
ជាមួយនិងគ្រួសារ ជាមួយនិងមិត្តភក្កិ ។ ចុះជនជាតិជប៉ុនវិញ ?
តើមនុស្សធ្វើអ្វីនៅចុងសប្ដាហ៍ ?
បាទ ចាស វាជាលើកដំបូងរបស់ខ្ញុំ ។
នៅរយៈពេលមួយសប្ដាហ៍ ខ្ញុំនឹងទៅប្រទេសជប៉ុន ។
បាទ ចាស វាជាលើកដំបូងរបស់ខ្ញុំ ។
ខ្ញុំពិតជាចូលចិត្តវា ។ ខ្ញុំចង់សាករស់នៅក្នុងទីក្រុងនេះ ។
តើផ្នែកណាដែលអ្នកចូលចិត្ត ?
មានមនុស្សល្អជាច្រើន និងអាហារមានរសជាតិឆ្ងាញ់ ។
ខ្ញុំចូលចិត្តទីនេះ ។
តើមានមនុស្សច្រើនទេ ?
បាទ ចាស ។ ជាធម្មជាតិ មានអ្នកទេសចរណ៍ជាច្រើន ។
តើអ្នកមកដល់ទីនេះនៅពេលណា ? តើអ្នកមានគោលបំណងជាក់លាក់ទេ ?
ខ្ញុំបានមកដល់ទីនេះកាលពីថ្ងៃមុន ។ ខ្ញុំគ្រាន់តែមកដើម្បីមើលទេសភាព ។
តើអារម្មណ៍របស់អ្នកយ៉ាងណាដែរ ?
ខ្ញុំមានការភ្ញាក់ផ្អើលដែលព្រះអាទិត្យមិនលិចរហូតដល់ម៉ោងដប់មួយ ។
តើអ្នករស់នៅឯណានៅក្នុងប្រទេសជប៉ុន ?
ខ្ញុំនឹងទៅទីនោះនៅថ្ងៃស្អែក ។
ប្រសិនបើអ្នកទៅទីនោះ វាជាគំនិតល្អមួយដើម្បីទិញទំនិញសូត្រមួយចំនួន ។
តើវាជាផលិតផលពីសូត្រឬ ? តើខ្ញុំអាចទិញវាក្នុងតម្លៃទាបបានទេ ?
ខ្ញុំមិនទាន់ដឹងទេ ។ ប៉ុន្តែខ្ញុំចង់មកម្តងទៀត ។
តើរដូវណាដែលល្អបំផុត ?
តើពេលណាជាពេលដែលល្អបំផុត ?
ប្រហែលជាឆ្នាំក្រោយ ។
ពួកយើងគួរតែជួបគ្នាម្តងទៀត ។
ខ្ញុំនឹងទាក់ទងទៅអ្នកមុននឹងខ្ញុំទៅ ។
ប្រសិនបើអាចទៅរួច សូមឱ្យខ្ញុំដឹងពីគម្រោងរបស់អ្នកឱ្យបានឆាប់តាមតែអាចធ្វើទៅបាន ។
តើអ្នកមានអ៊ីមែលទេ ?
ដូច្នេះ ខ្ញុំនឹងផ្ញើរអ៊ីមែលទៅអ្នក ។ វាថោកជាង និងលឿនជាង ។
វាពិតប្រាកដណាស់ ។ តោះប្ដូរអាស័យដ្ឋានអ៊ីមែលគ្នាទៅវិញទៅមក ។
សូមប្រាប់ខ្ញុំពីអាស័យដ្ឋានអ៊ីមែលរបស់អ្នក ។
តើការលក់ដែលអាចតថ្លៃមាននៅពេលណា ?
សំលៀកបំពាក់ កាបូប ស្បែកជើង របស់របរបែបហ្នឹង ។
នៅដើមខែកុម្ភៈ និងពាក់កណ្តាលខែមិថុនា ។
តើមានការលក់នៅពេលណា ?
តើមានព្រឹត្តិការណ៍ខ្លះទេ ?
នៅពេលនោះ តើមានមនុស្សជាច្រើនពីកន្លែងផ្សេងមកទេ ?
បាទ ចាស មនុស្សមកពីពាសពេញពិភពលោក ។
តើនឹងមានព្រឹត្តិការណ៍អ្វី ?
នៅពេលបន្ទាប់ ខ្ញុំចង់មកនៅខែរងារ ។
អូ ។ តើនៅពេលណាដែលវាចាប់ផ្តើមធ្លាក់ព្រិល ?
ពេលវេលាដែលឆាប់បំផុតគឺនៅពាក់កណ្តាលខែតុលា ។
តើរដូវរងារមានលក្ខណៈដូចម្តេច ?
តើទីក្រុងនេះមានលក្ខណៈដូចម្តេចនៅក្នុងរដូវសម្រាក ?
នៅពេលល្ងាចវាចាប់ផ្តើមងងឹតនៅប្រហែលម៉ោងបួន ហើយហាងឆាប់បិទ ។
វាស្តាប់ទៅដូចជារសាប់រសល់ ។
វាគឺផ្ទុយគ្នាស្រឡោះពីររដូវធ្វើការ ។
តើរដូវឈប់សម្រាកមានលក្ខណៈដូចម្តេច ?
ខ្ញុំរីករាយណាស់ដែលខ្ញុំបានជួបអ្នក ។ អរគុណអ្នក ។
តើអ្នករីករាយខ្លួនអ្នកទេ ?
ខ្ញុំបានធ្វើការចងចាំអស្ចារ្យច្រើនណាស់ ។
អរគុណសម្រាប់ពេលវេលាដ៏អស្ចារ្យ ។
បាទ ចាស ថ្ងៃស្អែកជាថ្ងៃឈប់សម្រាករបស់ខ្ញុំ ។
តើអ្នកទំនេរទេនៅព្រឹកស្អែក ?
តើអ្នកមានគម្រោងទេយប់នេះ ?
តើអ្នករវល់ទេនៅរសៀលថ្ងៃស្អែក ?
តើអ្នកធ្វើការទេនៅថ្ងៃស្អែក ?
ខ្ញុំឈប់សម្រាកនៅថ្ងៃពុធ ។
ខ្ញុំឈប់សម្រាកនៅថ្ងៃព្រហស្បត្តិ៍ ។
ហេតុអ្វីបានជាយើងមិនញ៉ាំអាហារនៅខាងក្រៅទៅ ?
តើអ្នកចង់មកទេ ?
សុំទោស ខ្ញុំមានគម្រោងហើយ ។
ថ្ងៃណាក៏បានដែរលើកលែងថ្ងៃច័ន្ទ ។
ហើយចុះថ្ងៃចុងសប្ដាហ៍ ?
ថ្ងៃអាទិត្យគឺល្អ ។
តើយើងគួរតែទៅនៅពេលណា ?
ហើយចុះនៅរសៀលនេះ ?
ហើយចុះនៅថ្ងៃពុធក្រោយ ?
ព្រឹកថ្ងៃច័ន្ទគឺល្អ ។
ថ្ងៃស្អែកគឺល្អ ។
ប្រហែលជាម៉ោងប៉ុន្មាន ?
ហើយចុះនៅម៉ោងប្រាំពីរ ?
ពេលណាក៏បានដែរ ។
តើពេលណាដែលល្អបំផុតសម្រាប់អ្នក ?
តើពួកយើងគួរតែធ្វើវានៅពេលណា ?
ហើយចុះបន្ទាប់ពីម៉ោងប្រាំមួយ ?
ហើយចុះនៅពេលរសៀល ?
ពេលណាក៏បានបន្ទាប់ពីម៉ោងប្រាំពីរ ។
បន្ទាប់ពីម៉ោងប្រាំពីរគឺល្អ ។
ទីកន្លែងណាក៏បានដែលអ្នកចង់ ។
តើអ្នកអាចមកទីនេះបានទេ ?
តើអ្នកថាម៉េចប្រសិនបើខ្ញុំមកលេង ?
ហើយចុះបើនៅការិយាល័យរបស់ខ្ញុំ ?
តើអ្នកនឹងមិនមកលេងទេឬ ?
ខ្ញុំចង់អញ្ជើញអ្នកញ៉ាំអាហារពេលល្ងាចនៅថ្ងៃស្អែក ។
អរគុណច្រើន វានឹងល្អណាស់ ។
ធ្វើឱ្យប្រាកដថាអ្នកនឹងមកពិធីជប់លៀងរបស់ពួកយើង ។
តើអ្នកមិនមកពេលឥលូវទេឬ ?
មក ហើយជួបខ្ញុំ ?
ខ្ញុំចង់អញ្ជើញអ្នកទៅមើលការសម្តែង ។
សម្រាប់ថ្ងៃណា ?
ពួកយើងមានគ្នាប្រាំនាក់ ។
សូមហុចអំបិលឱ្យខ្ញុំ ។
តើអ្នកចូលចិត្តស៊ុតរបស់អ្នកបែបណា ?
សូមស៊ុតស្ងោរទន់ៗ ។
សូមហុចស្ករឱ្យខ្ញុំ ។
សូមហុចក្រែមឱ្យខ្ញុំ ។
សូមយកសាច់ហាំ និង ស៊ុត ។
ពួកវាទាំងអស់មើលទៅល្អណាស់ ។
វាមានរសជាតិឆ្ងាញ់ណាស់ ។
អូ ពួកយើងសុំទោសផង ។
ខ្ញុំសោកស្តាយណាស់ដែលនេះមិនមែនជាការកុម្ម៉ង់របស់អ្នក ។
សូមយកឱ្យខ្ញុំមួយផ្សេងទៀត ។
ទេអរគុណច្រើន ខ្ញុំគ្រាន់តែមើលសិនទេ ។
សូមអ្នកជួយខ្ចប់អំណោយនេះផង ?
តើអ្នកចូលចិត្តបូបែបណា ?
សូមខ្ចប់ពួកវាដាច់ដោយឡែកពីគ្នា ។
តើថ្លៃជាធម្មតាប៉ុន្មានទៅ ?
បាទ ចាស ពួកយើងបើកនៅថ្ងៃនេះ ។
ពួកយើងបើកនៅម៉ោងប្រាំបួន ។
សូមប្រាប់ខ្ញុំពីម៉ោងរកស៊ីរបស់អ្នក ។
តើថ្ងៃនេះអ្នកនឹងបិទនៅម៉ោងប៉ុន្មាន ?
តើអ្នកនឹងទៅលើឬ ?
សូមនៅជាន់ផ្ទាល់ដី ។
តើអ្នកនឹងនៅជាន់ក្រោមឬ ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេថាហាងនៅឯណា ?
វានៅក្បែរតូបលក់សៀវភៅ ។
ខ្ញុំជាអ្នកថ្មីនៅទីនេះផងដែរ ។
ខ្ញុំក៏មិនដឹងដែរ ។
អាហារពេលល្ងាចសាច់គោ ឬសាច់ត្រី ?
ខ្ញុំមានបារីបួនប្រអប់ ។
បាទ ចាស តើខ្ញុំអាចសុំឈ្មោះរបស់អ្នកបានទេ ?
ប្រហែលរាងរាល់ដប់នាទី ។
ខ្ញុំចង់ទៅកន្លែងនេះ ។
ខ្ញុំបានភ្លេចសោររបស់ខ្ញុំនៅក្នុងបន្ទប់របស់ខ្ញុំ ។
សួស្តី ។ តើអ្នកបំរើអាហារពេលថ្ងៃត្រង់ឬទេ ?
សួស្តី ។ តើខ្ញុំអាចសុំផែនទីផ្លូវក្រោមដីបានទេ ?
លាសិនហើយឥលូវនេះ ។
លាសិនហើយ ។ ជួបអ្នកនៅពេលក្រោយ ។
ជួបអ្នកនៅពេលណាមួយ ។
ខ្ញុំនឹងរ៉ាប់រងវិក័យប័ត្រនៅយប់នេះ ។
អរគុណអ្នកសម្រាប់ការបង្ហាញខ្ញុំនៅជុំវិញនេះ ។
ខ្ញុំសុំទោស ។ ខ្ញុំបានធ្វើឱ្យកំពប់ស្រានៅលើកំរាលព្រំ ។
សុំទោស ។ ខ្ញុំមិនបានធ្វើតាមនឹងទេ ។
អរគុណអ្នក ប៉ុន្តែអត់ទេអរគុណច្រើន ។
តើអ្នកអាចចំណាយពេលពីរបីនាទីបានទេ ?
យល់ព្រម ។ ទៅមុខត្រង់ ហើយបត់ឆ្វេង ។
តើអ្នកមានយកទស្សនាវដ្តីមកទេ ?
តើអ្នកចង់ចូលរួមជាមួយពួកយើងសម្រាប់អាហារពេលល្ងាចយប់នេះទេ ?
មិនអីទេ ។ តើម៉ោងប៉ុន្មានដែលអ្នកនឹងទៅ ?
តើអ្នកអាចឱ្យខ្ញុំបន្ទប់ធំជាងនេះបានទេ ?
តើអាចកក់កន្លែងអង្គុយបានទេ ?
តើវាទៅបានដែលផ្ញើរវាទៅកាន់ប្រទេសជប៉ុនតាមអាកាស ?
តើវាទៅបានដែលទៅយកខ្ញុំនៅសណ្ឋាគាររបស់ខ្ញុំ ?
តើវាមិនអីទេឬដែលសាកពាក់ក្រវិលនេះ ?
តើវាមិនអីទេឬដែលប្រើទូរស័ព្ទនេះ ?
