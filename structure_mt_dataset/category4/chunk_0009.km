ខ្ញុំសុំទោស ប៉ុន្តែវាកកកុញខ្លាំងណាស់សព្វថ្ងៃនេះ ។
ប៉ុន្តែខ្ញុំមិនអាចគេងបានទេនៅទីនេះ ។
យល់ព្រម ខ្ញុំនឹងត្រួតពិនិត្យរកកន្លែងអង្គុយទំនេរ ។
តើខ្ញុំអាចប្ដូរយកមួយនេះបានទេ ?
កុំប្ដូរប៉ុស្តិ៍ញឹកញាប់ខ្លាំងពេក ។
ហេតុអ្វីបានជាអ្នកមិនចេញក្រៅសម្រាប់ការផ្លាស់ប្ដូរ ?
វាថោកខ្លាំងណាស់លោក ។
ខ្ញុំចង់ទៅប៉ុន្តែខ្ញុំមានការណាត់មួយ ។
ខ្ញុំសុំទោស ប៉ុន្តែខ្ញុំមានគម្រោង ។
តើខ្ញុំអាចខ្ចីរថយន្តរបស់អ្នកបានទេ ?
តើអ្នកបាត់បង់សតិឬ ?
ខ្ញុំពិតជាត្រូវទៅមែន ។
រថយន្តឈប់ភ្លាម ហើយមិនដំណើរការ ។ តើខ្ញុំត្រូវធ្វើយ៉ាងណា ?
បាទ ចា៎ស សូមទូរស័ព្ទទៅលេខ ប្រាំ ប្រាំ ប្រាំ មួយ បី បួន នឹងប្រាក់គេថាអ្នកនៅកន្លែងណា ។
តើខ្ញុំត្រូវធ្វើអ្វីខ្លះ ?
សូមប្រាប់ខ្ញុំថាត្រូវធ្វើអ្វី ?
យល់ព្រម ប្រាប់ឈ្មោះ និងទីតាំងរបស់អ្នកមកខ្ញុំ ។
មានស្ថានីយ៍ប៉ូលីសនៅជិតសណ្ឋាគារ ។ សូមទៅទីនោះដើម្បីរាយការណ៍ ។
សូមស្តាប់ខ្ញុំដោយយកចិត្តទុកដាក់ ។
វាស្តាប់ទៅដូចស្រដៀង ។
មិនពិតទេ ។ ប៉ុន្តែខ្ញុំមានការឈឺក្បាលតិចតួច ។
ខ្ញុំឈឺក្បាលតិចតួច ។
ក្បាលរបស់ខ្ញុំឈឺតិចតួច ។
ខ្ញុំចង់ក្អួត ។
ខ្ញុំមានស្នាមជាំនៅលើជើងរបស់ខ្ញុំ ។
ក្បាលរបស់ខ្ញុំឈឺខ្លាំងណាស់ ។
ទេ គ្រាន់តែឈឺក្បាលទេ ។
តើអ្នកអាចវេចខ្ចប់របស់នេះបានទេ ?
តើអ្នកនឹងខ្ចប់អំណោយនេះទេ ?
តើវាអាចវេចខ្ចប់អំណោយនេះបានទេ ?
តើអ្នកអាចជួយខ្ញុំបានទេ ?
តើអ្នកអាចបង្ហាញខ្ញុំអាមួយពណ៌ខ្មៅបានទេ ?
មួយនេះឬ ? យល់ព្រមនេះយកទៅ ។
អ្នកអាចនាំឱ្យខ្ញុំកែវទឹកមួយ ?
រដូវផ្ការីកបានមកដល់ហើយ ។
អ្វីដែលនាំអ្នកមកដល់ទីនេះ ?
រថភ្លើងបានមកដល់ហើយ ។
វាជាអំណោយមួយដ៏ល្អមួយសម្រាប់អ្នក ។
អូ វាជាក្តីរីករាយរបស់យើង ។
ដូច្នេះ តើពួកយើងឬ ?
តើខ្ញុំត្រូវយកអ្វីទៅទេ ?
ខ្ញុំមានអារម្មណ៍ប្រសើរជាងមុនហើយ ។ អរគុណអ្នកច្រើនសម្រាប់គ្រប់យ៉ាង ។
ខ្ញុំមិនស្គាល់ឈ្មោះរបស់គាត់ទេ ។
មិនត្រូវនឹងចំណេះដឹងរបស់ខ្ញុំទេ ។
ខ្ញុំពុំដឹងថាមានបញ្ហាមួយឡើយ ។
ខ្ញុំពុំបានដឹងរឿងហ្នឹងទេ ។
វាមិនមែនជារឿងរបស់រឿងរបស់ខ្ញុំទេ ។
តើអ្នកមកពីប្រទេសចិនឬ ?
មានបង្អែមខ្លះទេ ?
ព្រលប់សួស្តី ។ សូមត្រួតពិនិត្យចូល ។
ព្រលប់សួស្តី ។ តើខ្ញុំសុំឈ្មោះរបស់អ្នកបានទេ ?
លាសិនហើយ ។ សូមស្នាក់នៅដោយក្តីសុខ ។
គ្រាន់តែសុខធម្មតាទេ អរគុណ ។ ចុះអ្នក ?
ខ្ញុំអស់កម្លាំងតិចតួច ។
អ្នកទាំងអស់គ្នាញញឹម ។ អ្នកត្រូវទៅទីនោះ ។
សូមរីករាយថ្ងៃវិស្សមកាល ។
សូមប្ដូរមួយនេះ ។
សូមយកក្រដាសដប់ដប់សន្លឹក ។
សូមយកក្រដាសប្រាំមួយសន្លឹក និង ក្រដាសមួយប្រាំសន្លឹក ។
ខ្ញុំមកគ្រប់គ្រាន់ផ្លូវពីប្រទេសប្រស៊ីល ។
អ្វីដែលនាំអ្នកមកដល់ទីនេះ ?
ពាណិជ្ជកម្ម និង សេចក្តីរីករាយ ។
បាទ ចា៎ស ឈ្មោះអ្នក ។
សូមចូលរួមជាមួយពួកយើងមក ។
ប្រសិនបើអ្នកនិយាយដូច្នេះ ។
យល់ព្រម វាគឺ បី បួន ប្រាំ ប្រាំមួយ ប្រាំបួន ប្រាំបី ប្រាំពីរ មួយ ។
សូមអាស័យដ្ឋានរបស់អ្នក ។
ខ្ញុំនឹងសរសេរវា ។
ទីនេះដូចគ្នា ។ សូមរីករាយជាមួយការធ្វើដំណើររបស់អ្នក ។
រីករាយដែលបាននិយាយជាមួយអ្នកដូចគ្នា ។ លាសិនហើយ ។
អរគុណច្រើន ។ សូមថែរក្សាខ្លួន ។
ខ្ញុំនិយាយភាសាអង់គ្លេសខ្លះ ។
តើហ្នឹងជាច្រកចូលឬ ?
បាទ ចា៎ស ប៉ុន្តែវាគ្មានពន្លឺទេ ។
ខ្ញុំសោកស្តាយណាស់ដែលអ្នកមិននៅទីនេះ ។ ប៉ុន្តែអ្នកអាចមកពីខាងក្រៅ ។
តើពួកយើងអាចថតរូបទាំងអស់គ្នាបានទេ ?
នៅទីនេះ លោកស្រី ?
សូមប្ដូរជាប្រាក់ដុល្លារ ។
មិនអីទេ ។ ខ្ញុំសូមលិខិតឆ្លងដែនរបស់អ្នកបានទេ ?
សូមយកក្រដាសមួយដប់សន្លឹក ។
បេឡានៅទីនោះនឹងធ្វើរឿងហ្នឹង ។
វាគឺ សែសិបប្រាំបួន កៅសិបប្រាំ ។
វាគឺ ពីររយហាសិបប្រាំដុល្លារ ម្ភៃប្រាំសេន ។
តើវាជាសាច់ប្រាក់ ឬប្រើប័ណ្ណ ?
ជាការពិតណាស់ ។ ចូរទៅពេលខាងមុខនិងការចុះហត្ថលេខាលើវា ។
ពន្ធត្រឡប់មកវិញ ?
អត់ទេអ្នកស្រី ។ អ្នកស្រីត្រូវទិញច្រើនជាងបីរយដុល្លារ ។
ប្រាក់អាប់ខុស ។
អូ ពិតឬ ? សូមឱ្យខ្ញុំត្រួតពិនិត្យវាម្តងទៀត ។
អ្នកត្រឹមត្រូវហើយ ។
វាមានជួរផ្ទះពីរនៅទីនោះ ។
បាទ ចា៎ស ត្រឹមត្រូវហើយនៅទីនោះ ។
វានៅក្នុងអគារនោះ ។
វានៅផ្នែកមួយទៀតនៃអគារនោះ ។
ទៅតាមផ្លូវនោះ ហើយទៅខាងស្តាំ ។
វាជាការល្អបំផុតដែលយកផ្លូវក្រោមដី ។
ខ្ញុំទាយថាអ្នកអាច ។
តើប៉ុន្មាននាទីទៅ ?
ប្រហែលជាដប់ទៅដប់ប្រាំនាទី ។
វានៅតាមច្រកដើរខាងស្តាំដៃរបស់អ្នក ។
អ្នកកំពុងអង្គុយលើកន្លែងរបស់ខ្ញុំហើយ ។
អូ សូមចាំបន្តិច ។ ខ្ញុំនឹងរំកិលឥវ៉ាន់របស់ខ្ញុំ ។
តើខ្ញុំអាចផ្លាស់ទៅកន្លែងអង្គុយជាប់បង្អួចបានទេ ?
តើពួកយើងអាចប្ដូរកន្លែងអង្គុយបានទេ ?
សូមអោយខ្ញុំចេញ ។
សូមចាំបន្តិច ។ យល់ព្រមបន្តទៀតចុះ ។
សូមអង្គុយនៅកន្លែងរបស់អ្នក ។
កាហ្វ តែក្តៅ ឬតែបៃតង ?
សូមដាក់វានៅទ្រុងខាងលើ ។
សូមមើលថែឥវ៉ាន់របស់ខ្ញុំផង ។
តើមានក្រដាសជប៉ុនខ្លះទេ ?
បាទ ចា៎ស ពួកយើងមានទាំងនេះ ។
តើមានទស្សនាវដ្តីជប៉ុនខ្លះទេ ?
សុំទោស ពួកយើងមិនមាននៅសល់ខ្លះទេ ។
កុងតាក់ភ្លើងខូចហើយ ។
អ្នកចុចប៊ូតុងខុសហើយ ។ នៅទីនេះ ។
ភាពយន្តបើកហើយ ?
វានឹងចាប់ផ្តើមរយៈពេលសាមសិបនាទីទៀត ។
តើប៉ុស្តិ៍មួយណា ?
ប៉ុស្តិ៍លេខមួយគឺភាសាអង់គ្លេស ហើយប៉ុស្តិ៍លេខពីរគឺភាសាជប៉ុន ។
តើមានការលក់ក្នុងជើងហោះហើរខ្លះទេ ?
ពួកយើងនឹងលក់ទំនិញក្នុងរយៈពេលខ្លី ។
សូមឱ្យថ្នាំខ្លះមក ។
ខ្ញុំនឹងយកជូនអ្នកមួយចំនួន ។
ពួកយើងនឹងជួបខ្យល់គួចរយៈពេលខ្លី ។ សូមដាក់ខ្សែក្រវ៉ាត់កន្លែងអង្គុយរបស់អ្នករៀងរ៉ាល់ពេលដែលអ្នកអង្គុយ ។
តើពួកគេនិយាយអ្វីខ្លះនៅក្នុងសេចក្តីប្រកាសនេះ ?
វានៅម៉ោងដប់ម្ភៃប្រាំនាទីព្រឹក ។
តើទៅដល់ទាន់ពេលឬទេ ?
