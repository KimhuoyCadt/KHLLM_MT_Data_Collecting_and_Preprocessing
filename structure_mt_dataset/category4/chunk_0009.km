ទាំងពីរនេះគឺមិនអីទេ ។
តើអ្នកអាចកែប្រែទំហំឲ្យខ្ញុំបានទេ ?
បាន តើកែប្រែឲ្យបានសមខ្លួន ។
វានឹងត្រូវចំណាយពេលពីរថ្ងៃ ។
វាជាថ្ងៃដែលខ្ញុំចាកចេញ ។ តើអ្នកអាចធ្វើឲ្យបានឆាប់បន្តិចបានទេ ?
តើការកែប្រែថ្លៃប៉ុណ្ណា ?
វាមិនគិតបា្រក់ទេ ។
អញ្ចឹង សូមធ្វើវាទៅ ។
វាថ្លៃពេកហើយ មិនបាច់កែប្រែទេ ។
ប្រាកដណាស់ សូមមកតាមផ្លូវនេះ ។
តើនេះជាឥវ៉ាន់របស់អ្នកមែនទេ ?
តើអ្នកអាចធ្វើវាត្រឹមថ្ងៃស្អែកទេ ?
តើបរិមាណនេះមិនអីទេមែនទេ ?
បាទ ចា៎ស វាល្អណាស់ ។
សូមធ្វើវាឲ្យវែងបន្តិច ។
ខ្ញុំសុំទោស ពួកយើងមិនអាចធ្វើឲ្យលឿនជាងនេះទេ ។
ខ្ញុំនឹងត្រូវបំភ្លេចវាហើយអញ្ចឹង ។
អញ្ចឹង ពួកយើងអាចធ្វើវាហើយនៅថ្ងៃស្អែក ។
សូមយករិក័យប័ត្រនេះមកជាមួយគ្រប់ពេលក្រោយពីម៉ោងប្រាំបួននៅជាន់ទីប្រាំបួន ។
វាល្អណាស់ ។ អរគុណ ។
សូមបង់ប្រាក់សម្រាប់តែវត្ថុតែប៉ុណ្ណោះឥលូវនេះ ។
បាទ ចា៎ស ពួកយើងអាចធ្វើវាហើយត្រឹមយប់ស្អែក ។
ខ្ញុំសុំទោស ពួកយើងមិនអាចធ្វើវាហើយឆាប់អញ្ចឹងទេ ។
អញ្ចឹង ក្នុងករណីនោះខ្ញុំមិនចាំបាច់បង់ថ្លៃកែប្រែទេមែនទេ ?
សូមធ្វើវាអោយខ្លីបន្តិច ។
តើវាថ្លៃប៉ុន្មាន ?
កៅសិបប្រាំបួនដុល្លារ ។
មួយតម្លៃកៅសិបប្រាំបួនដុល្លារ ។
តើតែមួយនេះថ្លៃប៉ុន្មាន ?
តម្លៃកៅសិបប្រាំបួនដុល្លារទាំងអស់ ។
តើខ្ញុំអាចទិញវត្ថុមួយក្នុងឈុតនេះបានទេ ?
តើនេះជាតម្លៃលក់ពិសេសមែនទេ ?
តើតម្លៃដោយបូកជាមួយពន្ធប៉ុន្មាន ?
តើតម្លៃធម្មតាប៉ុន្មាន ?
វាថ្លៃបន្តិចហើយ ។
តើអ្នកអាចចុះតម្លៃបន្តិចឲ្យខ្ញុំបានទេ ?
វាថ្លៃពេកហើយ ។ ខ្ញុំមិនអាចទិញបានទេ ។
តើវាមានលេខសូន្យច្រើនពេកទេ ?
អ្នកនិយាយត្រូវ ខ្ញុំបានធ្វើខុស ។
បើខ្ញុំទិញពួកវាទាំងពីរ តើអ្នកអាចចុះថ្លៃឲ្យខ្ញុំបានទេ ?
ខ្ញុំមិនត្រូវការច្រើនអញ្ចឹងទេ សូមលក់ពាក់កណ្តាលឲ្យខ្ញុំ ។
តើប្រអប់មួយថ្លៃប៉ុន្មាន ?
វាថ្លៃខ្លាំងណាស់ ។
បីតម្លៃកៅសិបប្រាំបួនដុល្លារ ។
ពួកវាមួយតម្លៃកៅសិបប្រាំបួនដុល្លារ ។
ពួកវាទាំងអស់សុទ្ធតែកៅសិបប្រាំបួនដុល្លារ ។
កៅសិបប្រាំបួនដុល្លារ ។
តើអ្នកអាចលក់វាក្នុងតម្លៃកៅសិបប្រាំបួនដុល្លារទេ ?
ខ្ញុំមិនអាចលក់បានទេ ។
បាន ខ្ញុំនឹងលក់វាក្នុងតម្លៃកៅសិបប្រាំបួនដុល្លារ ។
ខ្ញុំអាចលក់វាចំនួនពីរក្នុងតម្លៃកៅសិបប្រាំបួនដុល្លារ ។
ខ្ញុំនឹងត្រលប់មកវិញ ។
ខ្ញុំអាចលក់វាចំនួនបីក្នុងតម្លៃកៅសិបប្រាំបួនដុល្លារ ។
ខ្ញុំចង់បានអានេះ ។
តើអ្នកមានប័ណ្ណឡើងយន្តហោះ និងលិខិតឆ្លងដែនទេ ?
មិននៅជាមួយខ្ញុំទេ ។
ខ្ញុំសុំទោសអ្នកមិនអាចទិញវាទេ ។
អរគុណសម្រាប់ការទិញរបស់អ្នក ។ នេះជាប័ណ្ណទាមទារ ។
ភ្នាក់ងាររបស់យើងកំពុងរង់ចាំអ្នកក្នុងតំបន់ឡើងយន្តហោះ ។
តើហាងរបស់អ្នកអាចធ្វើនីតិវិធីទិញរួចពន្ធទេ ?
តើអ្នកមានយកលិខិតឆ្លងដែនមកទេ ?
នេះជាបែបបទប្រកាសរួចពន្ធ ។
សូមបំពេញចំណុចដែលតម្រូវឲ្យបំពេញ ។
តើអ្នកចង់ឲ្យខ្ញុំបំពេញវា ?
តើអ្នកចង់ទទួលសំណងរបស់អ្នកយ៉ាងម៉េច ?
ជាសាច់ប្រាក់នៅព្រលានយន្តហោះ ។
សូមផ្ញើមូលប្បទានប័ត្រ ។
សូមបង់វាចូលក្នុងគណនីប័ណ្ណឥណទានរបស់ខ្ញុំ ។
អ្នកយកវាលើគ្រឿងសម្រាប់បង្វិលអោយបត់ទៅក្រោយវិញនៅព្រលានយន្តហោះរបស់អ្នកក្នុងប្រទេសជប៉ុន ។
តើខ្ញុំយកវត្ថុរួចពន្ធនេះនៅឯណា ?
អញ្ចឹង ខ្ញុំនឹងទិញវា ។
បើមិនមានតម្លៃលើសពីកៅសិបប្រាំបួនដុល្លារទេ វាមិនមានរួចពន្ធទេ ។
អញ្ចឹង ពួកយើងមិនអាចធ្វើនីតិវិធីបានទេ ។
បើអ្នកទិញមួយនេះទៀត វាបង្គ្រប់បរិមាណរួចពន្ធ ។
អញ្ចឹង យកលិខិតឆ្លងដែន និងវិក័យប័ត្រមកពេលណាមួយក្នុងថ្ងៃនេះ ។ ពួកយើងអាចបំពេញនីតិវិធីបាន ។
អ្នកនឹងធ្វើបានល្អក្នុងមុខជំនួញ ។ ខ្ញុំយកមួយនោះដែរ ។
ខ្ញុំចង់បានសំណងពន្ធ ។
វារួចរាល់ហើយ ។ យកច្បាប់ចម្លងនេះ និងការទិញរបស់អ្នក ហើយបង្ហាញវាដល់គយនៅក្នុងព្រលានយន្តហោះ ។
ពួកយើងមិនអាចសងជាសាច់ប្រាក់នៅក្នុងព្រលានយន្តហោះនេះទេ ។ ដាក់ច្បាប់ចម្លងនោះក្នុងស្រោមសំបុត្រ ហើយដាក់វាក្នុងប្រអប់សំបុត្រនេះ ។
ខ្ញុំបានទិញវានៅទីនេះម្សិលមិញ ប៉ុន្តែមានស្នាមមួយលើវា ។
បាន ។ វាមានតម្លៃកៅសិបប្រាំបួនដុល្លារមែនទេ ?
តើអ្នកនឹងផ្លាស់ប្ដូជាមួយវត្ថុដូចគ្នាមែនទេ ?
បាន សូមមកតាមផ្លូវនេះ ។
សុំទោសពួកយើងមិនអាចទេ ពួកយើងមិនមានវត្ថុដូចគ្នាទេ ។
បាទ ចា៎ស ពួកយើងអាច ។ សូមត្រឡប់មកវិញនៅម៉ោងប្រហែលបី ។
សុំទោស ពួកយើងមិនអាចទេ ។ វាត្រូវការពេលវេលាលើសពីពីរ សបា្តហ៍ ។
ខ្ញុំបានទិញវានៅទីនេះម្សិលមិញ ប៉ុន្តែវាធំពេក ។ តើខ្ញុំអាចប្ដូរវាបានទេ ?
ខ្ញុំសុំទោស ពួកយើងមិនអនុញ្ញាតការប្ដូរទេ ។
អ្នកមិនអាចប្ដូរវត្ថុលក់ទេ ។
បាន រីករាយនឹងធ្វើ ។
ខ្ញុំបានទិញវានៅទីនេះម្សិលមិញ ប៉ុន្តែវាតូចពេក ។ តើខ្ញុំអាចប្ដូរវាបានទេ ?
សូមជ្រើសរើសវត្ថុមួយទៀតដែលមានតម្លៃដូចគ្នា ។
បាទ ចា៎ស ពួកយើងអាច ។ ត្រឡប់មកវិញមុនអ្នកចាកចេញ ។
សុំទោស មិនមានពេលវេលាគ្រប់គ្រាន់ទេ ។
ពេលដែលវាមកដល់ ពួកយើងនឹងបង់ប្រាក់ដឹកជញ្ជូនវាដល់អាសយដ្ឋានផ្ទះរបស់អ្នក ។
តើមានហាងដែលអាចជួសជុលវាក្នុងប្រទេសជប៉ុនទេ ?
បាទ ចា៎ស មាន ។ នេះជាអាសយដ្ឋានហាង ។
តើអ្នកនឹងផ្ញើវាទៅទីតាំងនេះក្នុងប្រទេសជប៉ុនក្រោយពីអ្នកជួសជុលរួច និងបង់ប្រាក់សម្រាប់ថ្លៃដឹកជញ្ជូន និងជួសជុល ?
សុំទោស ពួកយើងមិនអាចធ្វើអញ្ចឹងទេ ។
ខ្ចប់វាជាកាដូ ។
សូមដាក់តែវត្ថុទាំងនេះនៅក្នុងប្រអប់មួយ ។
មានការគិតប្រាក់សម្រាប់ប្រអប់ច្រើន ។ តើវាមិនអីទេមែនទេ ?
តើអ្នកចង់បានថង់ក្រដាស់ ឬប្លាស្ទិច ?
សូមប្រើថង់ក្រដាស់ ។
ខ្ញុំមិនមានប្រាក់គ្រប់គ្រាន់ទេឥលូវនេះ ។ ខ្ញុំចង់ត្រឡប់មកម្តងទៀតពេលក្រោយ ។ តើអ្នកអាចទុកវាឲ្យខ្ញុំបានទេ ?
បាន សូមឲ្យឈ្មោះរបស់អ្នក ។
តើអ្នកអាចផ្ញើវាទៅសណ្ឋាគាររបស់ខ្ញុំបានទេ ?
វាត្រូវចំណាយពេលបីថ្ងៃដើម្បីទៅដល់ ។
តើអ្នកអាចបញ្ជូនវាទៅប្រទេសជប៉ុនឲ្យខ្ញុំបានទេ ?
ទេ អរគុណអញ្ចឹង ។
ខ្ចប់វាជាមួយគ្នា ។
សូមដាក់តែវត្ថុទាំងនេះនៅក្នុងថង់មួយ ។
សូមប្រើថង់ប្លាស្ទិច ។
ខ្ញុំចង់ឲ្យវាមកដល់ត្រឹមរសៀលថ្ងៃស្អែក ។
ថ្លៃខ្ចប់គឺកៅសិបប្រាំបួនដុល្លារ និងកៅសិបប្រាំបួនសេនក្នុងវត្ថុមួយ ។ តើវាមិនអីទេមែនទេ ?
តើអ្នកចង់បានខ្សែបូទេ ?
ខ្ញុំឃើញអរគុណ ។
វាជាសេវាកម្មឥតគិតថ្លៃ ។
អញ្ចឹង ខ្ញុំចង់ឲ្យអ្នកបញ្ជូនវា ។
សូមអរគុណច្រើន ។ សូមទៅកន្លែងគិតប្រាក់ខាងនោះ ។
សូមបង់ប្រាក់ និងបោះត្រាលើក្រដាស់នេះនៅកន្លែងគិតប្រាក់ខាងនោះ ។
អរគុណចំពោះការជួយរបស់អ្នក ប៉ុន្តែខ្ញុំចង់គិតឲ្យបានយូរបន្តិច ។
អរគុណ សូមអញ្ជើញមកម្តងទៀត ។
ពួកវាខុសពីរូបភាពដែលខ្ញុំមាន ។ ខ្ញុំមិនចង់បានអ្វីទាំងអស់ ។
តើនេះជាអ្វី ? ខ្ញុំមិនបានទិញអ្វីដូចអញ្ចឹងទេ ។
តើមានកំហុសលើរិក័យប័ត្រមែនទេ ? ខ្ញុំគិតថាវាដូចជាថ្លៃជាងតម្លៃវាហើយ ។
ខ្ញុំបានបង់ប្រាក់រួចហើយ ។
លុយអាប់របស់ខ្ញុំគឺខុស ។ ខ្ញុំបានឲ្យក្រដាស់ហាសិបដុល្លារទៅអ្នក ។
មិនមានអ្វីដែលខ្ញុំចូលចិត្តទេ ។ សុំទោស ។ ខ្ញុំមិនចង់បានអ្វីទាំងអស់ ។
តើអ្នកចង់បង់ជាសាច់ប្រាក់ ឬប័ណ្ណឥណទាន ?
ខ្ញុំសុំទោស អ្នកមិនអាចប្រើវាទេ ។
តើខ្ញុំអាចសុំលុយអាប់ជាយេនបានទេ ?
អស់កៅសិបប្រាំបួនដុល្លារ និងកៅសិបប្រាំបួនសេន ។
អរគុណ ខ្ញុំរីករាយក្នុងការទិញទំនិញនៅទីនេះ ។
មិនមានកំហុសទេ ។ ពេលអ្នកបូកពន្ធ វាក្លាយជាតម្លៃនេះ ។
តើអាចប្រើមូលប្បទានបត្រ័អ្នកធ្វើដំណើរបានទេ ?
សួស្តី នេះជាបន្ទប់កៅសិបប្រាំបួន ។
ស្ថានភាពរបស់មិត្តខ្ញុំគឺធ្ងន់ធ្ងរ ។ គាត់ក្តៅខ្លួនខ្លាំង ។
តើមានគ្រូពេទ្យសណ្ឋាគារ ឬគ្រូពេទ្យដែលអាចទាក់ទងបានទេ ?
ស្ថានភាពរបស់ខ្ញុំមិនល្អទេ ។ តើអ្នកអាចណាត់ជួបគ្រូពេទ្យព្យាបាលជម្ងឺទូទៅបានទេ ?
ខ្ញុំមានបញ្ជីគ្រូពេទ្យដែលនិយាយភាសាជប៉ុន ។
ស្ថានភាពរបស់មិត្តខ្ញុំគឺធ្ងន់ធ្ងរ ។ គាត់គ្រុនញាក់ ។
ស្ថានភាពរបស់មិត្តខ្ញុំមិនល្អទេ ។ តើអ្នកអាចណាត់ជួបគ្រូពេទ្យភ្នែកបានទេ ?
មិត្តខ្ញុំឈឺ ។ គាត់ឈឺក្បាលខ្លាំងណាស់ ។
គាត់អាចស្លាប់បាន ។
ហៅឡានសង្គ្រោះបន្ទាន់ឲ្យបានឆាប់តាមដែលអាចធ្វើបាន ។
ខ្ញុំចង់ឲ្យគ្រូពេទ្យមកបន្ទប់របស់ខ្ញុំ ។
ការហៅគ្រូពេទ្យមកដល់បន្ទប់គឺថ្លៃ ។ សូមប្រើបន្ទប់ពិនិត្យរបស់សណ្ឋាគារ ។
អញ្ចឹង សូមណាត់ឲ្យខ្ញុំនៅមន្ទីរពេទ្យដែលមានបន្ទប់សង្គ្រោះបន្ទាន់ ។ ខ្ញុំនឹងទៅតាមឡានតាក់ស៊ី ។
អញ្ចឹង ពួកយើងមានគ្រូពេទ្យប្រចាំការនៅសណ្ឋាគារ ។ ខ្ញុំនឹងរៀបចំឲ្យគាត់ទៅបន្ទប់របស់អ្នកឆាប់ៗ ។ តើអ្នកគ្រប់គ្រងបន្ទប់អាចទៅដែរបានទេ ?
បាទ ចា៎ស បាន ។ សូមប្រញ៉ាប់ឡើង ។
ខ្ញុំគិតថាខ្ញុំដើរមិនរួចទេ ។
ខ្ញុំនឹងឲ្យអ្នកគ្រប់គ្រងបន្ទប់ទៅបន្ទប់របស់អ្នកជាមួយរទេះរុញ ។
អរគុណ ខ្ញុំនឹងរង់ចាំ ។
អញ្ចឹង ខ្ញុំនឹងទៅទីនោះ ។ សូមប្រាប់ពួកគេថាខ្ញុំកំពុងទៅហើយ ។
បើអាច ជាមួយគ្រូពេទ្យដែលនិយាយភាសាជប៉ុន ។
សុំទោស ខ្ញុំមិនស្គាល់ម្នាក់ណាទេ ។
អញ្ចឹង ពួកយើងមានគ្រូពេទ្យប្រចាំការ ។ ខ្ញុំនឹងរៀបចំឲ្យគាត់ទៅបន្ទប់របស់អ្នកឆាប់ៗ ។ តើអ្នកគ្រប់គ្រងបន្ទប់អាចទៅដែរបានទេ ?
ខ្ញុំគិតថាគាត់ដើរមិនរួចទេ ។
ខ្ញុំនឹងពន្យល់ជំនួសគាត់ ។
ខ្ញុំក្តៅខ្លួន និងគ្រុនញាក់ ។
មានឈាមនៅក្នុងនោះ ។
ខ្ញុំមិនមានអារម្មណ៍ចង់ក្អួតទេឥលូវនេះ ។
ខ្ញុំនៅតែអារម្មណ៍ចង់ក្អួត ។
ខ្ញុំនៅតែអារម្មណ៍ចង់ក្អួត ប៉ុន្តែតែក្អួតមិនចេញ ។
វាដូចជាទន់ជាងធម្មតា ។
មានឈាមនៅក្នុងនោះ ។
ខ្ញុំមិនក្តៅទេ ប៉ុន្តែខ្ញុំបែកញើស ។
បេះដូងរបស់គាត់កំពុងលោតញ៉ាប់ ។
គាត់ពិបាកដកដង្ហើម ។
គាត់ស្រាប់តែសន្លប់ភ្លាមៗ ។
ខ្ញុំមិនអាចទទួលការឆ្លើយតបពីគាត់ទេ ។
ពេលខ្ញុំហៅឈ្មោះគាត់ ខ្ញុំទទួលការឆ្លើយតបបន្តិច ។
ខ្ញុំនឹងពន្យល់ជំនួសគាត់ ។
បេះដូងរបស់គាត់កំពុងលោតមិនធម្មតា ។
គាត់ពិបាកដកដង្ហើម ។
គាត់ស្រាប់តែសន្លប់ភ្លាមៗ ។
ខ្ញុំមិនអាចទទួលការឆ្លើយតបពីគាត់ទេ ។
ពេលខ្ញុំហៅឈ្មោះគាត់ ខ្ញុំទទួលការឆ្លើយតបបន្តិច ។
វាដូចជាអ្វីៗទាំងអស់កំពុងវិលជុំវិញ ។
គាត់បាននៅក្នុងកន្លែងដែលក្តៅខ្លាំងរយៈពេលកៅសិបប្រាំបួនម៉ោង ។
ខ្ញុំឈឺចាប់នៅត្រង់នេះ ។
ភ្នែករបស់ខ្ញុំឈឺ ។
ការមើលឃើញរបស់ខ្ញុំដូចជារួមតូច ។
វាដូចជាចំណុចនៃពន្លឺកំពុងលោតចុះឡើង ។
អ្វីទាំងអស់គឺពណ៌ស ។
ខ្ញុំមានកន្ទួល ហើយវាឈឺ ។
ពេលដែលខ្ញុំលេបទឹកមាត់ វាឈឺ ។
វាមានអារម្មណ៍ថារដិបរដុបលើស្បែក ។
ខ្ញុំមិនអាចឈប់ក្អកបាន ហើយវាឈឺខ្លាំងណាស់ ។
វាឈឺខាងក្នុងភ្នែករបស់ខ្ញុំ ។
ខ្ញុំស្តាប់ឮមិនច្បាស់ទេ ។
ធ្មេញរបស់ខ្ញុំឈឺ ។ ខ្ញុំត្រូវការថ្នាំបំបាត់ការឈឺចាប់ ។
ខ្ញុំបាក់ធ្មេញមួយ ។ សូមជួសជុលវាបណ្តោះអាសន្នសិន ។ ខ្ញុំនឹងជួស ជុលវាឲ្យជាប់ល្អពេលដែលខ្ញុំទៅដល់ផ្ទះ ។
ផ្នែកចំហៀងរបស់ខ្ញុំឈឺ ។
វាដូចជាចំណុចខ្មៅកំពុងលោតចុះឡើង ។
ខ្ញុំមានកន្ទួល ហើយវារមាស់ ។
ខ្ញុំបាក់ធ្មេញមួយ ។ សូមជួសជុលវាបណ្តោះអាសន្នសិន ។ ខ្ញុំនឹងជួស ជុលវាឲ្យជាប់ល្អពេលដែលខ្ញុំទៅដល់ផ្ទះ ។
ខ្ញុំមុតកញ្ចក់នៅទីនេះ ។
ខ្ញុំបានធ្វើឲ្យប្រឡាក់ដីលើមុខរបួស ។
ខ្ញុំបានរលាកទឹកក្តៅ ។
វាឈឺ ហើយខ្ញុំមិនអាចកម្រើកវាបានទេ ។
វាហើមបន្តិចម្តងៗ ។
វាស្ពឹកនៅទីនេះ ។
ខ្ញុំអាចកម្រើកវាបានតិចៗ ។
វាឈឺពេលដែលខ្ញុំកម្រើកវា ។
ខ្ញុំឈឺខ្នងពេលដែលខ្ញុំលើកអ្វីធ្ងន់ៗ ។
ខ្ញុំមុតកាំបិតនៅទីនេះ ។
ខ្ញុំបានរលាកភ្លើង ។
ខ្ញុំប៉ះទង្គិចខ្លួនឯងខ្លាំងនៅទីនេះ ។
វាកម្រើកមិនបានទេនៅទីនេះ ។
ខ្ញុំឈឺខ្នងពេលដែលខ្ញុំគេងផ្ងារ ។
តើវាបែបនេះយូរប៉ុណ្ណាហើយ ?
ប្រហែលជាបីម៉ោង ។
ប្រហែលមួយសប្ដាហ៍ ។
តើអ្នកធ្លាប់ចូលគេងពេទ្យទេ ?
តើអ្នកធ្លាប់ចាក់ថ្នាំស្ពឹកទេ ?
តើមានឥទ្ធិពលអាក្រក់ទេ ?
បាទ ចា៎ស ខ្ញុំមានប្រតិកម្មជាមួយលម្អងផ្កា ។
តើអ្នកផឹកគ្រឿងស្រវឹងច្រើនទេ ?
បាទ ចា៎ស ពីព្រោះខ្ញុំចូលចិត្តវា ។
លើសពីមួយកញ្ចប់ក្នុងមួយថ្ងៃ ។
ដូចបំពង់បង្ហុយផ្សែង ។
តើអ្នកធ្លាប់វះកាត់ទេ ?
តាំងពីល្ងាចម្សិលមិញមកម៉្លេះ ។
បាទ ចា៎ស ខ្ញុំមានប្រតិកម្មជាមួយអាហារ ។
តើប្រភេទឈាមរបស់អ្នកគឺអ្វី ?
តើអ្នកមានបញ្ហាសុខភាពណាមួយទេ ?
តើអ្នកបានប្រើប្រាស់ថ្នាំទេ ?
ខ្ញុំកំពុងប្រើប្រាស់ថ្នាំដែលគ្រូពេទ្យចេញវេជ្ជបញ្ជាឲ្យ ។ នេះជាវេជ្ជបញ្ជា ។
ខ្ញុំបានផឹកទឹកមិនច្រោះ ។
ខ្ញុំបានញ៉ាំអាហារតូប ។
ខ្ញុំបានញ៉ាំគ្រឿងសមុទ្រ ។
តើចលនាពោះវៀនរបស់អ្នកយ៉ាងម៉េចដែរ ?
ខ្ញុំកំពុងព្យាបាលជម្ងឺបេះដូង ។
ខ្ញុំកំពុងព្យាបាលជំងឺទឹកនោមផ្អែម ។
សូមដោះឡេវអាវអ្នកចេញ ។
សូមដោះសម្លៀកបំពាក់អ្នកចេញ ។
សូមដកដង្ហើមវែងៗចូល និងចេញ ។
សូមលានអណ្តាតរបស់អ្នកចេញ ។
សូមសម្រាកផ្ងារនៅលើគ្រែ ។
ពេលខ្ញុំធ្វើអញ្ចឹង តើឈឺទេ ?
សាកស្ទង់ជីពចររបស់អ្នក ។
តោះបូមឈាមពិនិត្យ ។
តើការព្យាបាលអ្វី ?
តោះយកទឹកនោមពិនិត្យ ។
អ្នកអាចបន្តវិស្សមកាលរបស់អ្នកដូចដែលបានកំណត់ ។
សូមឈប់ជក់បារី ។
កាត់បន្ថយការផឹកគ្រឿងស្រវឹងរបស់អ្នក ។
សូមកុំប្រើប្រាស់សារធាតុជួយលើកកម្លាំង ។
សូមត្រឡប់មកវិញម្តងទៀតនៅថ្ងៃស្អែក ។
សូមសម្រាកពីរបីថ្ងៃ ។
ប្រហែលជាអ្នកគួរតែលុបចោលវិស្សមកាលរបស់អ្នក ហើយត្រឡប់ទៅប្រទេសជប៉ុនវិញ ។
អរគុណលោកគ្រូពេទ្យ ។
វាមិនបានប្រសើរទេ ។
វាបានប្រសើរបន្តិចហើយ ។
វាគ្រាន់បើច្រើនហើយ ។
ខ្ញុំនឹងត្រឡប់ទៅប្រទេសជប៉ុនវិញ ។
សូមចេញវេជ្ជបញ្ជាថ្នាំខ្លះ ។
សូមធ្វើការព្យាបាលបន្ទាន់ ។
សូមទូរស័ព្ទទៅស្ថានទូតជប៉ុន ។
តើអ្នកអាចផ្ញើសំបុត្រនេះទៅលេខនេះនៅប្រទេសជប៉ុនតាមទូរសារបានទេ ?
វានឹងតម្រូវរយៈពេលបីថ្ងៃក្នុងមន្ទីរពេទ្យ ។
សូមត្រឡប់មកវិញម្តងទៀតនៅថ្ងៃខានស្អែក ។
វានឹងតម្រូវរយៈពេលបួនថ្ងៃក្នុងមន្ទីរពេទ្យ ។
តើខ្ញុំមានអ្វី ?
វាអស់ពីររយដុល្លារ ។
ខ្ញុំចង់បានលិខិតបញ្ជាក់វេជ្ជសាស្ត្រ និងវិក័យប័ត្រ ។ ខ្ញុំត្រូវការវាសម្រាប់ការទាមទារធានារ៉ាប់រង ។
នេះជាបទបញ្ញាតិរបស់អ្នក ។
ខ្ញុំចង់បានច្បាប់ចម្លងសម្រាប់គ្រូពេទ្យក្នុងប្រទេសជប៉ុន ។
សូមយកថ្នាំផ្តាសាយ ។ ខ្ញុំមិនមានវេជ្ជបញ្ជាទេ ។
សូមយកទំហំតូចបំផុត ។ ខ្ញុំកំពុងដើរកំសាន្ត ។
សូមយកថ្នាំខ្ពុលមាត់ ។ ខ្ញុំមិនមានវេជ្ជបញ្ជាទេ ។
ខ្ញុំសុំទោសពួកយើងមិនទទួលវាទេ ។
អស់ដប់បីដុល្លារ និងហុបសិបសេន ។
សូមយកអាមួយដែលមានឈ្មោះហាង ។ ខ្ញុំនឹងប្រើវាសម្រាប់ការទាមទារធានារ៉ាប់រងរបស់ខ្ញុំ ។
សូមអោយបង្កាន់ដៃ ។
ម្តងលេបមួយគ្រាប់ ។
ខ្ញុំឈឺក្បាលខ្លាំងណាស់ ។
បើអាច សូមយកថ្នាំគ្រាប់ ។
ខ្ញុំក្តៅខ្លួនបន្តិច ។ តើអ្នកមានអ្វីល្អសម្រាប់បំបាត់វាទេ ?
ម្តងលេបមួយកញ្ចប់ ។
ខ្ញុំតឹងច្រមុះខ្លាំងណាស់ ។
បើអាច សុំជាម្សៅ ។
សូមជួយផង ។ វាជាការបន្ទាន់ ។
វាជាគ្រោះថ្នាក់រថយន្ត ។
នរណាម្នាក់បានបុកឡានរបស់ខ្ញុំ ។
ខ្ញុំត្រូវបានគេជួយ ។
ខ្ញុំត្រូវបានពួកប្រព្រឹត្តបទឧក្រិដ្ឋចាក់ ។
ខ្ញុំត្រូវបានគេបាញ់ ។
វត្ថុមានតម្លៃរបស់ខ្ញុំត្រូវបានយកដោយចោរ ។
ខ្ញុំត្រូវរបួស ។
មិត្តភក្កិរបស់ខ្ញុំធ្លាក់ពីច្រាំងថ្ម ។
មិត្តភក្កិរបស់ខ្ញុំធ្លាក់ចូលស្រះ ។
ខែនេះនៅថ្ងៃទីប្រាំបួន ។
មិត្ររបស់ខ្ញុំត្រូវបានឡានបុក ។
មិត្តភក្កិរបស់ខ្ញុំត្រូវរបួស ។
មិត្តរបស់ខ្ញុំគឺឈឺ ។
មិត្តភក្កិរបស់ខ្ញុំធ្លាក់ពីស្ពាន ។
មិត្តភក្កិរបស់ខ្ញុំធ្លាក់ចូលទន្លេ ។
ខែមុននៅថ្ងៃទីប្រាំបួន ។
សូមទូរស័ព្ទទៅផ្នែកពន្លត់អគ្គិភ័យ ។
ផ្លូវ A លេខម្ភៃប្រាំបួន ។
នៅកណ្តាលទីលាន C ។
អ្នកអាចឃើញធនាគារ D ។
វានៅជិតសារៈមន្ទីរ E ។
ខ្ញុំជាអ្នកទេសចរណ៍មកពីប្រទេសជប៉ុន ។
នៅខាងក្នុងជាកាបូបលុយរបស់ខ្ញុំ ។
សូមបំពេញរបាយការណ៍ពីចោរកម្មសម្រាប់ក្រុមហ៊ុនធានារ៉ាប់រង ។
អញ្ចឹង សូមបំពេញចំណុចសំខាន់នៅក្នុងបែបបទនេះ ។
ពួកយើងជាអ្នកទេសចរណ៍មកពីប្រទេសជប៉ុន ។
នៅខាងក្នុងជាប័ណ្ណឥណទានរបស់ខ្ញុំ ។
វាបានកើតឡើងម្សិលមិញក្នុងពេលរសៀលនៅម៉ោងដប់កន្លះ ។
សូមបំពេញរបាយការណ៍គ្រោះថ្នាក់សម្រាប់ក្រុមហ៊ុនធានារ៉ាប់រង ។
តើអ្នកបាននៅកន្លែងណា ?
តើវានៅផ្លូវអ្វី ?
តើអ្នកចាំលេខប័ណ្ណបើកបរទេ ?
តើឡានប្រភេទអ្វី ?
តើអ្នកចាំអ្នកបើកបរទេ ?
វាជាផ្លូវកៅសិបប្រាំបួន ។
វាជាឡានទីបីពីខាងមុខ ។
ពណ៌នៃឡានគឺពណ៌លឿង ។
លេខប័ណ្ណបើកបរគឺ AB មួយពីរបី ។
ខ្ញុំគិតថា វាត្រឹមត្រូវហើយ ។
តើវាត្រូវគេលួចយ៉ាងម៉េច ?
ដោយចោរលូកហោប៉ៅ ។
ខ្ញុំត្រូវបានគេបោក ។
វាត្រូវបានគេកញ្ឆក់ ។
វាត្រូវបានគេយកពេលខ្ញុំដាក់វាចុះ ។
តើអ្នកកំពុងធ្វើអ្វីនៅពេលនោះ ?
ខ្ញុំបានទស្សនៈ ។
ខ្ញុំកំពុងនិយាយជាមួយមិត្តភក្កិ ។
ខ្ញុំទទួលទូរស័ព្ទ ។
ខ្ញុំបានដើរផ្សារ ។
ខ្ញុំកំពុងដើរ ។
ខ្ញុំកំពុងញ៉ាំ ។
ខ្ញុំកំពុងអង្គុយនៅទីនោះ ។
សូមផ្តល់ព័ត៌មានលម្អិតឲ្យបានច្រើនតាមដែលអ្នកអាចធ្វើបានអំពីព្រឹត្តិការណ៍ ។
ខ្ញុំត្រូវបានឡោមព័ន្ធដោយក្មេងៗ ហើយពួកវាធ្វើឲ្យការ៉េមប្រឡាក់ខោអាវខ្ញុំ ។ ក្រោយមកកាបូបលុយរបស់ខ្ញុំក៏បាត់ ។
ការ៉េមពណ៌ត្រូវបានប្រឡាក់លើខោខ្ញុំ ។ ពេលដែលខ្ញុំកំពុងជូតវាចេញជាមួយក្រដាស់ជូតមាត់ដែលជនចម្លែកបានឲ្យខ្ញុំ គាត់បានរត់ទៅជាមួយកាបូបរបស់ខ្ញុំ ។
ខ្ញុំបានសម្គាល់ភ្លាមៗថាកាបូបដែលខ្ញុំបានដាក់នៅជិតជើងខ្ញុំបានបាត់ទៅហើយ ។
ជនចម្លែកបានសុំថតរូបឲ្យខ្ញុំ ហើយខ្ញុំបានប្រគល់កាមេរ៉ាឲ្យគាត់ ។ បន្ទាប់មក គាត់បានរត់ទៅជាមួយវាបាត់ទៅ ។
បុរសម្នាក់បានប៉ះខ្ញុំ ។ ក្រោយមកខ្ញុំបានសម្គាល់ថាកាបូបលុយរបស់ខ្ញុំបានបាត់ហើយ ។
ខ្ញុំបានសម្គាល់ថាកាបូបរបស់ខ្ញុំបានបើក និងកាមេរ៉ារបស់ខ្ញុំបានបាត់ ។
ជនចម្លែកបានដើរមក ហើយបានចាប់ផ្តើមនិយាយជាមួយខ្ញុំជាភាសាជប៉ុន ។ គាត់បាននិយាយថាពេលគាត់នៅប្រទេសជប៉ុន បុរសម្នាក់ចិត្តល្អចំពោះគាត់ណាស់ ដូច្នេះគាត់ចង់ធ្វើអ្វីមួយសម្រាប់ជនរួមជាតិជប៉ុន ។ ដូច្នេះខ្ញុំត្រូវគាត់នាំទៅទីនោះ ។
ក្រោយពីខ្ញុំបានផឹកទឹកក្រូចដែលត្រូវបានហុចឲ្យខ្ញុំ ខ្ញុំសន្លប់ ។ ពេលដែលខ្ញុំភ្ញាក់ឡើងកាបូបលុយ និងកាតាបរបស់ខ្ញុំបានបាត់ ។
គាត់បាននិយាយថា "តោះជប់លៀង" ហើយបាននាំខ្ញុំទៅកន្លែងលក់ស្រា ។ គាត់បាននិយាយថាគាត់ទៅទូរស័ព្ទ ហើយក៏ទៅបាត់ និងមិនមកវិញ ហើយខ្ញុំនៅជាប់ជាមួយវិក័យប័ត្រយ៉ាងច្រើន ។
ពេលដែលខ្ញុំកំពុងដើរតាមផ្លូវ មានដៃចេញពីកន្លែងងងឹត ហើយទាញខ្ញុំចូល ។ បន្ទាប់មកខ្ញុំត្រូវគេប្លន់កាបូបលុយ ។
ក្រោយពីខ្ញុំបានទិញអ្វីមួយ ខ្ញុំមិនប្រាកដពីតម្លៃនៃប្រាក់ ដូច្នេះខ្ញុំលាក្រដាស់ប្រាក់ដែលខ្ញុំមានដូចជាបៀរ ហើយឲ្យម្នាក់នោះយកបរិមាណដែលត្រឹមត្រូវ ។ ប៉ុន្តែពេលខ្ញុំត្រឡប់មកដល់សណ្ឋាគារ និងបានគណនាវា បរិមាណដែលខ្ញុំនៅសល់នៅតិចមែនទែន ។
ខ្ញុំបានទុកប្រាក់ជាច្រើននៅក្នុងប្រអប់តំកល់សុវត្ថិភាពនៅតុខាងមុខរបស់សណ្ឋាគារ ។ ប៉ុន្តែ ពេលដែលខ្ញុំបានបើកវានៅព្រឹកនេះ មានបាត់ប្រាក់ខ្លះ ។
ពេលដែលខ្ញុំកំពុងដើរតាមផ្លូវ មានដៃចេញពីកន្លែងងងឹត ហើយទាញខ្ញុំចូល ។ បន្ទាប់មកខ្ញុំត្រូវគេប្លន់ប្រាក់ ។
តើអ្នកបានឃើញជនល្មើសទេ ?
វាងងឹតណាស់ ហើយខ្ញុំមិនបានឃើញច្បាស់ទេ ។
តើជនល្មើសមានអត្តចរិកពិសេសណាមួយទេ ?
មានជនល្មើសម្នាក់ ។
