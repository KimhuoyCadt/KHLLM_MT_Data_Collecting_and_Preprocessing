វាថ្លៃពីររយដុល្លារក្នុងមួយយប់ ។
តើមាយអាផ្សេងដែលថោកជាងនេះទេ ?
អត់ទេ អាហារពេលមិនត្រូវបានរាប់បញ្ចូលទេ ។
បំពេញឈ្មោះ និងអាស័យដ្ឋានរបស់អ្នកនៅទីនេះ ។
ខ្ញុំបានទុកលុយទឹកតែនៅលើតុ ។
ខ្ញុំបានសរសេរលុយទឹកតែនៅទីនេះ ។
សូមផ្លាស់ប្ដូរការកក់របស់ខ្ញុំបានទេ ។
មួយយប់ទៀតយល់ព្រមទេ ?
ខ្ញុំសុំទោសពុំមានបន្ទប់នៅសល់ទេ ។
គ្មានបញ្ហាទេ អ្នកស្រី ។
តើថ្លៃបន្ថែមប៉ុន្មាន ?
វាគឺថ្លៃម្ភៃភាគរយនៃថ្លៃបន្ទប់ ។
តើអ្នកចូលចិត្តបែបណានៅក្នុងស៊ុតចៀនរបស់អ្នក ?
សូមដាក់ខ្ទឹមបារាំង និងផ្សិត ។
តើពេលត្រួតពិនិត្យចេញនៅពេលណា ?
វានៅម៉ោងដប់ពីរថ្ងៃត្រង់អ្នកស្រី ។
មានតែប្រភេទគ្រែមួយទេ ។
សូមគ្រែពីរមក ។
ខ្ញុំខ្លាចតែ ពួកយើងពុំមានបន្ទប់ភ្លោះនៅសល់ទេ ។
សូមគ្រែបន្ថែមមក ។
នំភីហ្សាពីរ និងតែក្តៅពីរ ។
សូមគិតប្រាក់ជាមួយបន្ទប់របស់ខ្ញុំ ។
បន្ទាប់មកសូមចុះហត្ថលេខានៅទីនេះ ។
សូមប្រដាប់គាស់ស្រាមួយ ។
វានឹងមានការគិតប្រាក់មួយដុល្លារ ។
ការបោសសម្អាតផ្ទះ ។ ពួកយើងមកទីនេះដើម្បីបាសសម្អាតបន្ទប់ ។
សូមត្រឡប់មកម្តងទៀត ។
សូមរៀបចំគ្រែ ។
ខ្ញុំនឹងបញ្ជូនអ្នកបម្រើទៅម្នាក់ ។
សូមដាក់វាទៅក្នុងការ៉ុងបោកគក់ និងទុកវានៅទីនេះ ។
វានឹងរួចរាល់មុនម៉ោងប្រាំល្ងាចស្អែក ។
សុំប្រអប់សុវត្ថិភាព ។
មិនអីទេអ្នកស្រី ។ នេះជាកូនសោររបស់អ្នក ។
ជួរនៅខាងក្រៅមួ ។
សូមចុចលេខប្រាំបួន បន្ទាប់មកលេខទូរស័ព្ទ ។
មិនអីទេអ្នកស្រី ?
សុំម៉ោងដប់មួយសែសិបប្រាំ ។
ចាំខ្ញុំមើលសិន ។ ពុំមានសារទេ អ្នកស្រី ។
វាចាប់ផ្តើមនៅម៉ោងប្រាំមួយគត់ ។
បាទ ចា៎ស ពួកយើងអាចបម្រើអ្នកចាប់ពីម៉ោងប្រាំបី ។
វាឆ្លងកាត់សាល ។
មានម៉ាស៊ីនលក់ទំនិញខ្លះទេ ?
វាមានមួយនៅផ្នែកខាងក្រោយនៃសាលនេះ ។
សូមឱ្យអាស័យដ្ឋានសណ្ឋាគារនេះមក ។
សូមយកស្រោមសំបុត្រនេះទៅ ។
សូមមើលថែរក្សាឥវ៉ាន់នេះផង ។
មិនអីទេ ។ នេះជាប័ណ្ណមកអះអាងរបស់អ្នក ។
សូមឱ្យឥវ៉ាន់របស់ខ្ញុំមកវិញមក ។
តើអាចឱ្យប័ណ្ណអះអាងរបស់អ្នកបានទេ ?
ខ្ញុំគិតថាប្រាំដុល្លារគ្រប់គ្រាន់ហើយ ។
សូមសេវាថតចម្លងមក ។
សូមថតចម្លងឯកសារនេះបីច្បាប់ ។
សូមផ្ញើរតាមទូរលេខ ។
សូមផ្ញើរទូរលេខឯកសារនេះទៅប្រទេសជប៉ុន ។
តើនៅម៉ោងពីរបានទេ ?
ទៅមុខត្រង់ ហើយបត់ស្តាំនៅភ្លើងសញ្ញាចរាចរ ។
យល់ព្រម តើមានប័ណ្ណប្រៃសណីយ៍ចំនួនប៉ុន្មានដែលអ្នកបានទទួល ?
វាមានតម្លៃចិតសិបប្រាំសេន ។
តុខាងមុខ តើអ្នកត្រូវការអ្វី ?
អ្នកប្រតិបត្តិការ តើអ្នកត្រូវការអ្វីដែរ ?
ខ្ញុំគឺ Sato នៅក្នុងបន្ទប់ដប់មួយម្ភៃប្រាំមួយ ។
បន្ទប់លេខដប់ពីរ ដប់ប្រាំ ។
ការពង្រីកពីរសាមសិបបួន ។
សូមទូរស័ព្ទមកខ្ញុំ ។
មិនអីទេ ខ្ញុំនឹងទូរស័ព្ទទៅ ។
ខ្ញុំនឹងចាំបាច់ត្រូវអញ្ជើញអ្នកឱ្យមកទីនេះ ។
មិនអាចលឺបានទេ ។
សូមឱ្យលឺជាងនេះបន្តិច ។
តើខ្ញុំអាចនិយាយបន្តបានទេ ?
យល់ព្រម ខ្ញុំកំពុងរពឹងការទូរស័ព្ទរបស់អ្នក ។
អូ ខ្ញុំរីករាយណាស់ដែលអ្នកបានទូរស័ព្ទមក ។
អ្នកតែងតែស្វាគមន៍ជានិច្ច ។ រីករាយណាស់ដែលបាននិយាយជាមួយអ្នក ។
សូមទូរស័ព្ទទៅប្រទេសជប៉ុន ។
នេះជាកូនសោរបម្រុង ។
ថ្លង់ខ្លាំងណាស់នៅជុំវិញបន្ទប់របស់ខ្ញុំ ។
សូមបន្ទប់ផ្សេងគ្នា ។
អនុញ្ញាតឱ្យខ្ញុំត្រួតពិនិត្យ និងមើលថាតើមានកន្លែងទំនេរទេ ។
ម៉ាស៊ីនត្រជាក់មិនដំណើរការទេ ។
តើអ្វីៗមិនអីទេឬ អ្នកស្រី ?
បន្ទប់នេះក្តៅណាស់ ។
ពុំមានភ្លើងទេ ។
កន្លែងបើកទឹកនេះមិនអាចបញ្ឈប់បានទេ ។
យល់ព្រម ខ្ញុំនឹងបញ្ជូនមនុស្សអ្នកទៅភ្លាម ។
ខ្ញុំនឹងដោះស្រាយវាឆាប់ៗ ។
វានឹងចំណាលពេលមួយភ្លែតប៉ុណ្ណ ។
សូមផ្លាស់ប្ដូរវាទៅ ។
ខ្ញុំនឹងដោះស្រាយវាភ្លាម ។
មានមនុស្សចម្លែកម្នាក់នៅក្នុងបន្ទប់របស់ខ្ញុំ ។
ខ្ញុំនឹងទៅត្រួតពិនិត្យវាភ្លាម ។
កំពុងចុះក្រោមហើយ ។
ខ្ញុំនឹងផ្ញើរមួយទៅភ្លាម ។
វាជាការគិតប្រាក់តាមទូរស័ព្ទ ។
តើអ្នកទាំងអស់គ្នារៀបចំទៅឬ ?
មិនអីទេ ។ នៅរយៈពលប្រាំនាទីទៀត ។
កន្លែងដែលល្អបំផុតគឺនៅជិតទីនេះ ។
បាទ ចា៎ស មានមួយនៅក្នុងសណ្ឋាគារនោះ ។
សូមឱ្យតុសម្រាប់មនុស្សបួននាក់យប់នេះ ។
ខ្ញុំសុំទោសពួកយើងពេញអស់ហើយនៅពេលនោះ ។
បាទ ចា៎ស អ្នកស្រី ។ អាវធំត្រូវតម្រូវសម្រាប់បុរសៗ ។
តើគាត់ត្រូវការក្រវ៉ាត់កទេ ?
វាពុំចាំបាច់ទេ អ្នកស្រី ។
សុំទោស ពួកយើងបានបិទហើយនៅពេលនេះ ។
វាចាប់ផ្តើមពីម៉ោងប្រាំសាមសិបនាទី អ្នកស្រី ។
សូមអោយពីរកន្លែងសំរាប់នៅបារ ។
ត្រូវហើយ សូមចូលមកខ្ញុំមក ។
គ្រាន់តែអាហារតិចតួចបានហើយ យល់ព្រមទេ ?
អ្នកត្រូវតែកុម្ម៉ង់អាហារពេលល្ងាចពេញ ។
សុំទោស ពួកយើងត្រូវបានកក់ពេញអស់ហើយនៅយប់នេះ ។
សូមអោយតុសំរាប់មនុស្សបួននាក់ ។
ជាអកុសល តុរបស់យើងទាំងអស់ពេញអស់ហើយនៅពេលនេះ ។
តើអ្នកចង់រងចាមនៅក្នុងបាទេ ?
យល់ព្រម ខ្ញុំនឹងរងចាំ ។
តើតុនេះត្រូវទេ ?
យល់ព្រម នឹងមានប្រាំនាក់ទាំងអស់ ។
ប្រាកដណាស់ ចូលមកក្នុងមក និងមើលជុំវិញចុះ ។
យកចិត្តិទុកដាក់ចំពោះកាហ្វេទេ ?
តែក្តៅ ឬតែទឹកកក ?
សូមស៊ុតពីរមក ។
សូមដាក់គ្រប់មុខទាំងអស់ ។
តើអ្នកចង់ញ៉ាំអ្វីពីក្នុងបានេះទេ ?
សូមស្រសដាក់កែវ ។
សូមយកស្រាក្រហមពីរ ។
តើអ្នកអាចណែនាំស្រាល្អបានទេ ?
ចុះមួយនេះ ? វាជាស្រាក្នុងតំបន់ ។
មានស្រាអ៊ីតាលីខ្លះទេ ?
បាទ ចា៎ស ។ ទាំងអស់នេះជាស្រាអ៊ីតាលី ។
ពុំទាន់រួចរាល់នៅឡើយទេ ។
ពួកយើងត្រូវការពេលវេលាបន្ថែមដើម្បីសំរេចចិត្ត ។
ពួកយើងអាចបំរើឆ្អឹងជំនីអ្នកឥលូវនេះ ។
មានអ្វីស្រាលៗទេ ?
អយស្ទ័រមួយចាននេះរាងស្រាលបន្តិច ។
សូមអាហារសំបុត្រមក ។
