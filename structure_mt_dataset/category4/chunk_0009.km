នេះជាប័ណ្ណឡើងយន្តហោះរបស់អ្នក ។ សូមទៅច្រកលេខដប់បួនពេលជើងយន្តហោះត្រូវបានប្រកាស ។
សូមស្វាគមន៍ការមកដល់សណ្ឋាគាររបស់ពួកយើង ។ សូមអញ្ជើញមកតាមនេះ ។
បាទ ចា៎ស ពួកយើងបានទុកបន្ទប់គ្រែពីរសម្រាប់បីយប់ ។
បើមានទំនេរមួយ ខ្ញុំចង់ប្ដូរទៅបន្ទប់ដែលមានទេសភាពសមុទ្រ ។
ខ្ញុំសុំទោស បន្ទប់ទាំងនោះមិនមានទំនេរទេថ្ងៃនេះ ប៉ុន្តែនឹងមានមួយទំនេរពីថ្ងៃស្អែកសម្រាប់មួយយប់ ។
គាត់នឹងនាំអ្នកទៅបន្ទប់ ។
សូមមកតាមផ្លូវនេះ ។ ឲ្យខ្ញុំជួយកាន់ឥវ៉ាន់របស់អ្នក ។
ជើងហោះហើរខ្ញុំមកដល់លឿន ។ តើអាចត្រួតពិនិត្យពេលនេះបានទេ ?
ខ្ញុំសុំទោស ជើងយន្តហោះរបស់ខ្ញុំត្រូវបានពន្យាពេល ហើយខ្ញុំនឹងចុះឈ្មោះចូលបន្ទប់ប្រហែលម៉ោងដប់មួយយប់ ។
សូមកុំបារម្ភអី ។ ពួកយើងនឹងរៀបចំវា ។
ខ្ញុំមានការកក់ចំនួនបីយប់ចាប់ពីថ្ងៃនេះទៅ ។
ខ្ញុំសុំទោស ។ ឈ្មោះរបស់អ្នកមិនមានក្នុងកុំព្យូទ័រទេ ។
ពិនិត្យជាមួយការសសេរបែបនេះ ។
ពិនិត្យឈ្មោះរបស់ខ្ញុំ ។
មានមនុស្សម្នាក់ទៀតមកជាមួយយើង អញ្ចឹងតើពួកយើងអាចសុំគ្រែបន្ថែមបានទេ ?
សុំទោស ។ មានកំហុសហើយ ។ ខ្ញុំកក់បន្ទប់គ្រែពីរមិនមែនគ្រែមួយគេងពីរនាក់ទេ ។
ខ្ញុំបានកក់ប្រាក់រួចហើយ ។
តើអ្នកអាចផ្លាស់ប្ដូរខ្ញុំទៅបន្ទប់ធំជាងនេះទេ ?
ខ្ញុំចង់បន្តមួយថ្ងៃទៀត ។
ខ្ញុំត្រូវចេញដំណើរលឿនជាងមួយថ្ងៃ ។
តើខ្ញុំអាចទុកលិខិតឆ្លងដែន និងវត្ថុមានតម្លៃរបស់ខ្ញុំនៅឯណា ?
តើអ្នកអាចប្រាប់ខ្ញុំថាបេឡាករនៅឯណាទេ ?
ខ្ញុំនឹងចុះឈ្មោះចេញនៅព្រលឹមថ្ងៃស្អែក ។
តើអ្នកអាចឲ្យអ្នកកាន់ឥវ៉ាន់មកបន្ទប់ខ្ញុំនៅម៉ោងប្រាំមួយព្រឹកទេ ?
បាទ ចា៎ស ប្រាកដណាស់ ។ តើអ្នកមានវ៉ាលីប៉ុន្មាន ?
ខ្ញុំមានវ៉ាលីបី ។
ខ្ញុំចង់ចុះឈ្មោះចេញ ។ នេះជាសោរបន្ទប់ ។
នេះជាវិក្កយបត្ររបស់អ្នក ។ តើអ្នកប្រើទូរទឹកកកទេព្រឹកនេះ ?
បាទ ចា៎ស ទឹកក្រូចស្រស់មួយ ។
សុំទោស ។ វិក័យប័ត្ររបស់ខ្ញុំដូចជាមានកំហុស ។ ខ្ញុំមិនបានទូរស័ព្ទ ទៅប្រទេសហ្វាំងឡង់ទេ ។
តើអ្នកអាចចុះហត្ថលេខាបានទេ ?
តើពួកយើងអាចទុកឥវ៉ាន់ជាមួយអ្នកពេលដែលពួកយើងទៅទិញឥវ៉ាន់បានទេ ?
បាទ ចា៎ស បាន ។ សូមសួរអ្នកយាម ។
បន្ទប់នេះនឹងទំនេរពីថ្ងៃស្អែកទៅ ។
បាទ ចា៎ស នេះជាបន្ទប់គួរឲ្យស្រឡាញ់ ។
បន្ទប់ស្អាតណាស់ ។ ខ្ញុំចូលចិត្តវា ។
តើបន្ទប់នេះថ្លៃប៉ុន្មាន ?
បីរយហាសិបដុល្លារ ? វាលើសពីគម្រោងចំណាយរបស់ខ្ញុំហើយ ។
វាមានតម្លៃបីរយហាសិបដុល្លារក្នុងមួយយប់ ។ វាមានតម្លៃមួយរយហាសិបដុល្លារលើសបន្ទប់ទេសភាពទីក្រុងដែលអ្នកបានកក់ ។
ឆ្នេរគឺនៅចំពីក្រោម ។ ទេសភាពគួរឲ្យចូលចិត្ត ។
តើពួកយើងអាចស្នាក់នៅទីនេះចាប់ពីស្អែកបានទេ ? សុំអង្វរ ?
វាគួរតែរ៉ូមែនទិចក្នុងការចែកស្រាសាំប៉ាញជាមួយអ្នកនៅលើយ៉ ។
មើលទៅអ្វីៗដូចជាល្អជាមួយមិត្តស្រីរបស់ខ្ញុំ ។ មួយយប់គួរតែមិនអីទេ ។
បន្ទប់របស់ខ្ញុំមិនបានសម្អាតទេ ។
គ្រែមិនបានរៀបចំទេ ។
បន្ទប់នេះគឺត្រជាក់ខ្លាំងណាស់ ។
សុំទោស ។ មានមនុស្សពីរនាក់ ប៉ុន្តែមានកន្សែងតែមួយឈុត ។
តើអ្នកអាចយកភួយឲ្យខ្ញុំបានទេ ?
បន្ទប់ធុំក្លិនផ្សិត ។
វាធុំក្លិនចម្លែក ។
បន្ទប់ធុំក្លិនដូចផ្សែង ។
មានបញ្ហាជាមួយទឹកផ្កាឈូក ។
ភ្លើងមិនភ្លឺទេ ។
មានបញ្ហាជាមួយម៉ាស៊ីនផ្លុំសក់ ។
ទឹកក្តៅមិនដំណើរការទេ ។
ខ្ញុំមិនអាចដាក់ប្រដាប់បង្ហូរទឹកទៅក្នុងអាងទឹកនោះទេ ។
ក្បាលរ៉ូមីណេទឹកបានបែក ។
បង្អួចបើកមិនបានទេ ។
ពួកយើងនឹងបញ្ជូននរណាម្នាក់ទៅជួសជុល សូមរង់ចាំ ។
ខ្ញុំបានរង់ចាំអ្នកជួសជុលរយៈពេលសាមសិបនាទីហើយ ។
ទោះបីជាយ៉ាងណាក៏ដោយតើអ្នកអាចឲ្យនរណាម្នាក់ឡើងមកទេ ?
មានបុរសចម្លែកម្នាក់នៅខាងក្រៅទ្វាររបស់ខ្ញុំ ។
ខ្ញុំបានភ្លេចកូនសោររបស់ខ្ញុំនៅក្នុងបន្ទប់ ។
ខ្ញុំបានបាត់សោរបន្ទប់ ។
សូមយកខ្ញុំទៅមន្ទីពេទ្យនេះ ។
សូមបង្ហាញខ្ញុំពីរបៀបកំណត់នាឡិការោទិ៍ ។
តើអ្នកអាចតំឡើងវានៅជិតបង្អួចបានទេ ?
តើអ្នកនឹងចុះហត្ថលេខាទីនេះឬ ?
សូមអរគុណច្រើន ។ សូមទូរស័ព្ទមកខ្ញុំពេលអ្នករួចរាល់ ។
សុំទោស ។ ខ្ញុំចង់បានអាហារពេលព្រឹកនៅថ្ងៃស្អែក ។
បាទ ចា៎ស ប្រាកដណាស់ ។ តើអ្នកអាចបំពេញបែបបទកុម្ម៉ង់ដែលនៅជិតខ្នើយអ្នក និងព្យួរវាលើដៃទ្វារខាងក្រៅបន្ទប់របស់អ្នកបានទេ ?
ខ្ញុំចង់បានឆាប់ៗ ។ តើវាត្រូវចំណាយពេលយូរប៉ុណ្ណា ?
ឥលូវនេះ ួកយើងមានការកុម្ម៉ង់ច្រើន ូច្នេះវានឹងចំណាយពេល ប្រហែលសាមសិបនាទី ។
តើអ្នកអាចធ្វើឲ្យលឿនតាមដែលអាចធ្វើបានទេ ?
តើអ្នកអាចអ៊ុតខោ និងបោកអាវរបស់ខ្ញុំបានទេ ?
ខ្ញុំចង់ឲ្យបោករួចរាល់នៅថ្ងៃស្អែកព្រឹក ។
សូមបំពេញបញ្ជីបោកស្ងួត និងទុកវាក្នុងថង់ប្លាស្ទិចលើគ្រែរបស់អ្នក ។
បាទ ចា៎ស លោកស្រី ។ តើអ្នកចង់បានម៉ោងប៉ុន្មាន ?
ម៉ោងប្រាំមួយ សាមសិបនាទី ។
សួស្តី ។ ខ្ញុំចង់ទូរស័ព្ទទៅប្រទេសជប៉ុន ។
អ្នកអាចវាយដោយផ្ទាល់ពីបន្ទប់របស់អ្នក ឬខ្ញុំអាចជួយអ្នកបាន ប៉ុន្តែមានការគិតប្រាក់បន្ថែម ។
តើខ្ញុំទូរស័ព្ទដោយផ្ទាល់ពីបន្ទប់របស់ខ្ញុំទៅតូក្យូតាមរបៀបណា ?
ចុចប្រាំបួនសម្រាប់ខ្សែខាងក្រៅ ហើយចុចប្រាំបីមួយសម្រាប់ប្រទេសជប៉ុន បីសម្រាប់ទីក្រុងតូក្យូ និងលេខទូរស័ព្ទ ។
ខ្ញុំចង់ធ្វើការហៅទូរស័ព្ទដោយបង់ប្រាក់ដោយអ្នកទទួលទៅកាន់ប្រទេសជប៉ុន ។
ខ្ញុំចង់បានបន្ទប់ប្រាំពីរសូន្យមួយ ។
សុំទោស លេខរបស់ខ្ញុំមិនត្រឹមត្រូវទេ ។
សូមយកសាប៊ូកក់សក់ឲ្យខ្ញុំ ។
សុំទោសដែលឲ្យលោករង់ចាំ ។
បាន ។ គ្រាន់តែសសេរលេខបន្ទប់របស់អ្នក និងចុះហត្ថលេខាទីនេះ ។
ខ្ញុំមានអារម្មណ៍អស្ចារ្យ ។
ជាពិសេសពីព្រោះជើងរបស់ខ្ញុំអស់កំលាំងពីការដើរពេញមួយថ្ងៃ ។
វាជួយបង្កើនចលនាឈាម និងជួយបន្ថយជើងហើម ។
ខ្ញុំចង់បានកន្សែងពីរ ។
