អារុណសួស្តី ។ តើវាមិនមែនជាថ្ងៃស្រស់ស្អាតទេមែនទេ ?
តើអ្នកនឹងកក់ឡានមួយសម្រាប់ខ្ញុំបានទេ ?
តើភោជនីយដ្ឋានមយយអ្នកអាចនឹងទៅសម្រាប់ការណាត់ជួបគូស្នេហ៍ ?
តើខ្ញុំអាចមានកូនសៀវភៅផ្សព្វផ្សាយសម្រាប់ទេសចរណ៍ដែរទេ ?
តើអ្នកនឹងជួយខ្ញុំផងបានទេ ?
តើម៉ោងសម្រាប់អាងហែលទឹកគឺប៉ុន្មាន ?
តើអ្នកអាចយកឱ្យខ្ញុំនូវកាហ្វេមួយពែងបានទេ ?
តើខ្ញុំអាចសុំភួយបន្ថែមខ្លះបានទេ ?
តើខ្ញុំអាចសូមខ្ចីម៉ាស៊ីនផ្លុំសក់បានទេ ?
ខ្ញុំត្រូវការវាធ្វើឱ្យរួចត្រឹមថ្ងៃស្អែក ។
តើខ្ញុំអាចកុម៉្មង់អាហារពេលព្រឹកបានទេ ?
ខ្ញុំចង់បានអាហារពេលព្រឹកនៅម៉ោងប្រាំបីក្នុងបន្ទប់របស់ខ្ញុំ ។
តើខ្ញុំអាចឱ្យគេយកវាមកបានទេ ?
តើខ្ញុំអាចឱ្យគេសម្អាតបន្ទប់ខ្ញុំបានទេ ?
តើអ្នកមានទូរស័ព្ទដៃជួលដែរទេ ?
តើខ្ញុំអាចថតចម្លងវានៅឯណា ?
ខ្ញុំចង់ផ្ញើអ៊ីម៉ែលមួយចំនួន ។
តើមជ្ឈមណ្ឌលពាណិជ្ជកម្មនៅឯណា ?
តើអ្នកអាចព្រីនឯកសារនេះចេញឱ្យខ្ញុំបាន ?
តើខ្ញុំអាចឱ្យគេវាយឯកសារនេះបានទេ ?
តើប៉ុន្មានជាម៉ោងធ្វើការនៅទីនេះ ?
តើអ្នកអាចបញ្ជូននរណាម្នាក់ឡើងមកបានទេ ?
អ្នកជិតខាងរបស់ខ្ញុំគឺឡូឡាពេកហើយ ខ្ញុំមិនអាចគេងលក់ទេ ។
មានបុរសម្នាក់នៅក្រៅបន្ទប់របស់ខ្ញុំ កំពុងធ្វើសកម្មភាពប្លែកៗ ។
តើអ្នកមានថ្នាំក្អកដែរទេ ?
តើខ្ញុំអាចសុំថ្នាំបំបាត់ការឈឺចាប់ខ្លះបានទេ ?
ខ្ញុំមិនអាចបើកបង្អួចនេះទេ ។
ខ្ញុំត្រូវបានគេជួយហើយ អរគុណ ។
វាមិនមែនជាអ្វីដែលខ្ញុំកំពុងស្វែងរកនោះទេ ។
ខ្ញុំចង់បានបង្កាន់ដៃបង់ប្រាក់ ។
សូមគិតថ្លៃវា ។
តើអ្នកអាចខ្ចប់វាបានទេ ?
វាគឺជាការតថ្លៃពិតប្រាកដ ។
តើអ្នកទុករបស់នេះឱ្យខ្ញុំបានទេ ? ខ្ញុំនឹងត្រឡប់មកវិញនៅថ្ងៃស្អែក ។
ប្រសិនបើអ្នកត្រូវការជំនួយណាមួយ សូមសួរខ្ញុំ ។
តើប័ណ្ណឥណទានមួយណាដែលអ្នកទទួល ?
តើអ្នកអាចក្រឡេកមើលរបស់នោះបានទេ ?
អត់ទោស តើអ្នកអាចជួយខ្ញុំបានទេ ?
តើខ្ញុំអាចយកសំបុត្រចំណតរបស់ខ្ញុំផ្ទៀងផ្ទាត់បានទេ ?
ខ្ញុំចង់ទទួលបានអ្វីមួយដែលខ្ញុំអាចគ្រាន់តែទិញនៅទីនេះបានហើយ ។
តើអ្នកអាចដាក់វានៅរង់ចាំសិនបានទេ ?
តើអ្នកអាចដាក់របស់ទាំងនេះក្នុងថង់ដោយឡែកបានទេ ?
តើខ្ញុំអាចពិនិត្យមើលខាងក្នុងម្តងទៀតបានទេ មុនពេលអ្នកខ្ចប់វា ?
ខ្ញុំចង់បានក្រដាសខ្ចប់ពណ៌បៃតងជាមួយខ្សែបូពណ៌លឿងលើវា ។
តើខ្ញុំមិនគិតពន្ធទេ ?
ខ្ញុំគិតថា ខ្ញុំទទួលបានការបញ្ចុះតម្លៃម្ភៃភាគរយពីចំនួនទឹកប្រាក់នេះ ។
ខ្ញុំគិតថាអ្នកបានគិតថ្លៃខ្ញុំឌុបសម្រាប់របស់នេះ ។
ខ្ញុំបានសម្រេចចិត្តថាមិនយកវាទេ ។
ខ្ញុំចង់ប្រគល់ត្រឡប់វា និងយកប្រាក់ត្រឡប់វិញ ។
តើខ្ញុំទទួលបានការបញ្ចុះតម្លៃសាមសិបភាគរយៈពីស្លាកនេះទេ ?
តម្លៃនេះបញ្ចុះរួចហើយ ។
ហា នៅកន្លែងបេឡា ។
ខ្ញុំមិនបានធ្វើឱ្យខូចវាទេ ។ វាខូចស្រាប់ ។
សូមលុបចោលស្លាកគិតថ្លៃ ។
តើអ្នកអាចលវាម្តងទៀត ?
តើអ្នកមានវាក្នុងទំហំលេខបួនដែរទេ ?
នឹងប្រហែលជាប្រាំហ្វីត និងកំពស់ប្រាំអ៊ីញ និងរាងស្គមបន្តិច ។ តើទំហំមួយណាល្អសម្រាប់នាង ?
តើវាផលិតពីសរសៃសូត្រសុទ្ធមែនទេ ?
តើអ្នកនឹងបែបវាឱ្យខ្ញុំមើលបានទេ ?
តើនេះជាអាវក្រៅដែលអាចបោកបាននៅផ្ទះមែនទេ ?
តើខ្ញុំគួរថែទាំវាដោយរបៀបណា ?
តើអ្នកអាចប្ដូរប្រវែងដៃបានទេ ?
តើអ្នកអាចប្រញាប់បានទេ ?
តើពេលណាឆាប់បំផុតដែលវាអាចធ្វើរួច ?
តើអ្នកអាចដេរជាយសំពត់ឱ្យខុំបានទេ ?
ខ្ញុំទើបតែទិញអាវនេះ ប៉ុន្តែខ្ញុំរកឃើញថាមានស្នាមប្រឡាក់នៅទីនេះ ។
ដៃអាវគឺវែងបន្តិចសម្រាប់ខ្ញុំ ។
ខ្ញុំកំពុងស្វែងរកកាបូបដែលមានខ្សែស្ពាយអាចសរ៉េបាន ។
ខ្ញុំកំពុងរកមើលកាបូបក្រវ៉ាត់ចង្កេះដើម្បីប្រើខណៈពេលខ្ញុំនៅទីនេះ ។
តើក្រដាសទំហំស្របច្បាប់ត្រូវវាទេ ?
តើសម្ភារៈនេះជាអ្វី ?
ខ្ញុំកំពុងស្វែងរកកាបូបស្ពាយដែលមានហោប៉ាវសម្រាប់ទូរស័ព្ទដៃ ។
តើខ្ញុំអាចមើលអាពណ៌ផ្សេងបានទេ ?
ខ្ញុំចង់បានកាបូបដែលធ្វើពីសរសៃអំបោះរឹង ។
តើវាងាយមានស្នាមក្វាចដែរទេ ?
តើហើរពណ៌ដែរទេ ?
វាមិនមែនស្បែកទេមែនទេ ?
ខ្ញុំមិនអាចបង់ថ្លៃច្រើនប៉ុណ្ណឹងសម្រាប់របស់ក្លែងក្លាយឡើយ ។
នេះគឺចង្អៀតបន្តិចហើយសម្រាប់ខ្ញុំ ។
ប្រអប់ជើងរបស់ខ្ញុំមានខ្នងជើងខ្ពស់ ។
តើម្ភៃប្រាំមួយសង់ទីម៉ែត្រស្មើប៉ុន្មានជាអ៊ីញ ?
តើអ្នកមានការរចនាដូចគ្នាជាពណ៌ត្នោតដែរទេ ?
តើអ្នកមិនមានអាតូចជាងនេះទេ ?
ខ្ញុំចង់ដឹងពីទំហំសមស្របរបស់ខ្ញុំ ។ តើអ្នកនឹងវាស់ប្រអប់ជើងខ្ញុំបានទេ ?
តើខ្ញុំអាចមើលគំនូសតាងទំហំបានទេ ?
តើអ្នកអាចយកឱ្យខ្ញុំនូវទំហំធំមួយលេខបានទេ ?
ខ្ញុំមិនដឹងអំពីស្បែកពស់នេះទេ ។
មួយគូនេះគឺស្ទើរតែឥតខ្ចោះលើកលែងតែកន្លាស់នេះ ។
នេះមិនត្រូវជាមួយទូដាក់ខោអាវរបស់ខ្ញុំទេ ។
វាអាក្រក់ពេកហើយ មិនមានទំហំរបស់ខ្ញុំ ។
តើអ្នកអាចហាន់សាច់នេះជាប្លុកស្ទើងជាងនេះបានទេ ?
ខ្ញុំស្គាល់ឈ្មោះវាទេ ប៉ុន្តែតើអ្នកមានមើមដែលបានប្រើសម្រាប់អាហារថៃ ឬម៉ិចស៊ិកដែរទេ ?
តើអ្នកជាធម្មតាចម្អិនត្រីនេះដែរទេ ?
តើខ្ញុំអាចប្រើប័ណ្ណឥណទានចំនួនទឹកប្រាប់ដប់ ឬតិចជាងនេះនៅកន្លែងបេឡាបានទេ ?
តើខ្ញុំអាចភ្លក់សាឡាត់អាល្លឺម៉ង់បានទេ ?
តើអ្នកណែនាំស្រាកាលីហ្វនីញ៉ាល្អបានទេ ?
ខ្ញុំកំពុងស្វែងរកស្រាត្រាំពេញដែលមានតម្លៃសមរម្យ ។
តើប្រភេទម្ហូបអ្វីស្រានេះត្រូវជាមួយ ?
ខ្ញុំកំពុងញុំាម្ហូបជប៉ុន ។ តើស្រាមួយណាវាត្រូវជាមួយ ?
តើស្រាមួយណានឹងត្រូវជាមួយត្រីសូម៉ុងអាំង ?
ខ្ញុំចង់បានស្រាដែលនឹងល្អបំផុតនៅអំឡុងពេលរាប់ថយក្រោយចូលសតវត្សទីម្ភៃមួយ ។
តើស្រានេះមកពីណា ហើយជាប្រភេទអ្វី ?
តើអ្នកអាចណែនាំស្រាក្រហមដែលមានតម្លៃប្រហែលម្ភៃដុល្លារបានទេ ?
តើធ្នើរនេះងាយដាក់ជាមួយគ្នាមែនទេ ?
តើអ្នកមានទៀនអណ្តែតដែរទេ ?
តើខ្ញុំត្រូវការឆ្នាំងសាកសម្រាប់ការប្រើចង្កៀងនេះនៅប្រទេសជប៉ុនដែរទេ ?
តើខ្ញុំអាចរកទិញឈុតគ្រឿងប្រាក់នៅឯណា ?
តើខ្ញុំអាចមើលកម្រាលពូកសំឡីខ្លះបានទេ ?
ខ្ញុំកំពុងស្វែងរកទៀនក្រអូប ។
តើចាននេះមានសុវត្ថិភាពជាមួយម៉ាស៊ីនកម្តៅដែរទេ ?
តើខ្ញុំអាចផ្ញើសំបុត្រនូវការបញ្ជាទិញគ្រឿងសង្ហារឹមនេះនៅប្រទេសជប៉ុនបានផងដែរ ?
តើអ្នកមានចានសម្រាប់ប្រើប្រាស់ជាមួយម៉ាស៊ីនដុតដែរទេ ?
តើកែវស្រានេះមានសុវត្ថិភាពជាមួយម៉ាស៊ីនលាងចានដែរទេ ?
ខ្ញុំមិនបានសម្គាល់នៅពេលខ្ញុំបានទិញរបស់នេះ ប៉ុន្តែវាមានស្នាមប្រេះនៅទីនេះ ។
