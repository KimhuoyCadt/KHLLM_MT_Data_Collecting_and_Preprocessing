តើអ្នកអាចចំអិនអាហារពេលក្រោយបានទេ ?
ហើយអ្នកនឹងរៀបចំគ្រែខ្លួនអ្នកផ្ទាល់ចាប់ពីល្ងាចនេះទៅ ។
ឆុងកាហ្វខ្លួនឯងនៅពេលព្រឹក យល់ព្រមទេ ?
ខ្ញុំចង់បោគគក់សំលៀកបំពាក់របស់ខ្ញុំ ។
អ្នកអាចប្រើម៉ាស៊ីនបោកគក់បាន ។
តោះលេងបិទពួន ។
ត្រូវហើយ ។ រាប់ពីមួយដល់ម្ភៃ ។
យល់ព្រម ។ ខ្ញុំនឹងចាប់អ្នក ហើយប្រើអ្នក ។
តើខ្ញុំអាចញ៉ាំអាហារនៅទីធ្លាជាមួយមិត្តភក្តិបានដែរឬទេ ?
នៅថ្ងៃសៅរ៍ក្រោយ យល់ព្រមទេ ?
ខ្ញុំចង់ទៅដើរទិញឥវ៉ាន់ ។
ខ្ញុំចង់មើលទូរទស្សន៍ ។
តើអ្នកអាចបើកភ្លើងបានទេ ?
ខ្ញុំចង់ឱ្យអ្នកជួយខ្ញុំ ។
តើអ្នកអាចលើកទូរស័ព្ទជំនួសខ្ញុំបានដែរឬទេ ?
ជួយខ្ញុំជាមួយនិងការសិក្សាភាសាអង់គ្លេស ។
តើអ្នកចង់ទៅមើលការប្រគុះតន្ត្រីទេ ?
នៅថ្ងៃសុក្រនេះ ។
សុំទោស ។ ខ្ញុំរវល់នៅថ្ងៃសុក្រ ។
តើអ្នកមានគម្រោងធ្វើអ្វី ?
ខ្ញុំនឹងទៅពិធីជប់លៀង ។
ខ្ញុំនឹងត្រឡប់ទៅប្រទេសជប៉ុននៅឆ្នាំក្រោយ ។
តើអ្នករវល់ទេនៅយប់នេះ ?
តើអ្នកមានគម្រោងអ្វីនៅឆ្នាំក្រោយ ?
តើប្រទេសជប៉ុនមានលក្ខណៈដូចម្តេច ?
ប្រជាជនជាច្រើននៅក្នុងប្រទេសតូចមួយ ។
ប៉ុន្តែជាកន្លែងដ៏ល្អសម្រាប់រស់នៅ ។ វាជាការមានសុវត្ថិភាពនិងស្អាត ។
វាមានប្រវត្តិសាស្ត្រដ៏វែងឆ្ងាយផងដែរ ។
វាបានលឺថាជនជាតិជប៉ុនប្រឹងប្រែងធ្វើការខ្លាំងណាស់ ។
ពួកគេមិនខ្ជិលនោះទេ ។
ពួកគេនិយាយថាប្រទេសជប៉ុនជាប្រទេសដ៏មានមួយ ។
តើថ្ងៃនេះអ្នកបានធ្វើអ្វីខ្លះ ?
ខ្ញុំសិក្សារយៈពេលបួនម៉ោងនៅសាលាភាសា ។
ខ្ញុំលេងតែនីស និងទៅដើរទិញឥវ៉ាន់នៅពេលរសៀស ។
ទេ ខ្ញុំរីករាយជាមួយខ្លួនឯង ។
តើអ្នកបានធ្វើអ្វី ?
ខ្ញុំបានជួបមិត្តភក្តិម្នាក់ ហើយពួកយើងញ៉ាំអាហារថ្ងៃត្រង់ជាមួយគ្នា ។
ប្រហែលជាមិត្តស្រីរបស់អ្នកហើយមើលទៅ ?
នាងមិនមែនជាមិត្តស្រីរបស់ខ្ញុំទេ ។ នាងគ្រាន់ជាមិត្តភ័ក្តិម្នាក់ ។
ខ្ញុំធ្វើឱ្យបែកពែងមួយ ។
កុំបារម្ភអី ។ វាកើតឡើងគ្រង់ពេលហ្នឹង ។
ខ្ញុំធ្វើឱ្យបែកកញ្ចប់បង្អួច ។
តើអ្នកមានអារម្មណ៍មិនអីទេឬ ?
បាទ ចាស ។ ខ្ញុំរីករាយនឹងខ្លួនឯងខ្លាំងណាស់ ។ ខ្ញុំមិនដឹងថាត្រូវអរគុណអ្នកយ៉ាងណាឱ្យបានគ្រប់គ្រាន់ ។
ពួកយើងសប្បាយរីករាយប្រសិនបើអ្នកសប្បាយរីករាយ ។
ខ្ញុំមានការចងចាំដ៏សប្បាយរី ។ ករាយដោយសារតែអ្នក ។
ពួកយើងនឹងនឹកអ្នកខ្លាំង ។
ខ្ញុំក៏ដូចគ្នា ។ ខ្ញុំនឹងមិនភ្លេចនរណាម្នាក់ឡើយ ។
សូមថែរក្សាខ្លួន ។ សូមធ្វើដំណើរដោយសុវត្ថិភាព ។
ខ្ញុំនឹងជួបអ្នកម្តងទៀត ។
សូមឱ្យខ្ញុំដឹងផង ប្រសិនបើអ្នកមកប្រទេជប៉ុន ។
ខ្ញុំនឹងសរសេរសំបុត្រមកអ្នកឆាប់ៗ ។
សុខសប្បាយជាទេ ។ ខ្ញុំពិតជាចង់និយាយជាមួយអ្នកណាស់ ។
បាទ ចាស ខ្ញុំក៏ដូចគ្នា ។ ខ្ញុំរីករាយខ្លាំងណាស់ដែលអ្នកទូរស័ព្ទមក ។
តើអាជីវកម្មរបស់អ្នកដូចម្តេចដែរ ?
នាងសុខសប្បាយជាទេ ។ នាងមានភាពមមាញឹកជាមួយនិងការងារ ។
ខ្ញុំពិតជាចង់ជួបអ្នក ហើយនឹងអ្នកខ្លាំងណាស់ ។ វាហាក់ដូចជាទើបតែម្សិលមិញដែលយើងជួបគ្នានៅសហរដ្ឋអាមេរិច ។
មកសហរដ្ឋអាមេរិចម្តងទៀតនៅពេលណាមួយ ។ ខ្ញុំនៅតែរង់ចាំអ្នក ។
អ្នកមើលទៅរីករាយណាស់ ។
អ្នកមើលទៅដូចជាមិនសូវមានព្រលឹងសោះ ។
ធម្មតាទេ អរគុណអ្នក ។
មិនសុខសប្បាយទេ អរគុណអ្នក ។
លាសិនហើយ ។ សូមឱ្យសំណាងល្អ ។
ខ្ញុំពិតជាមិនរីករាយទេដែលមើលអ្នកចេញទៅ ។
ខ្ញុំចង់នៅទីនេះឱ្យបានយូរជាងហ្នឹង ។
ខ្ញុំនឹងរង់ចាំសំបុត្ររបស់អ្នក ។
សូមធ្វើដំណើរដោយសុវត្ថិភាព ។
តើអ្នកកំពុងធ្វើដំណើរឬ ?
តើអ្នកកំពុងធ្វើការងារជំនួញឬ ?
តើអ្នកនៅវិស្សមកាលឬ ?
តើខ្ញុំអាចសុំលេខទូរស័ព្ទរបស់អ្នកបានទេ ?
តើខ្ញុំអាចសុំអាស័យដ្ឋានរបស់អ្នកបានទេ ?
តើអ្នកមកទីនេះញឹកញាប់ទេ ?
ខ្ញុំនឹងបំភ្លេចសន្តានចិត្តដ៏ល្អរបស់អ្នកឡើយ ។
វាគួរឱ្យអស្ចារ្យ ។
តើអ្នកបាននិយាយអ្វី ?
ខ្ញុំសុំទោស ខ្ញុំមិនយល់ពីអ្នកទេ ។
សូមនិយាយឱ្យសាមញ្ញៗ ។
សូមនិយាយឱ្យច្បាស់ៗ ។
តើខ្ញុំគួរតែទៅនៅម៉ោងប៉ុន្មាន ?
តើអាកាសធាតុនឹងល្អទេនៅថ្ងៃស្អែក ?
តើវានឹងត្រជាក់ទេនៅយប់នេះ ?
តើខ្ញុំចាំបាច់ត្រូវការអាវធំទេនៅលើកំពូលភ្នំ ?
តើនៅថ្ងៃស្អែកនឹងក្តៅជាងនេះឬ ?
តើខ្ញុំគួរតែទៅនៅពេលណា ?
តើអាកាសធាតុនឹងភ្លៀងយ៉ាងណាដែរនៅថ្ងៃស្អែក ?
តើអាកាសធាតុនឹងមានធ្លាក់ព្រិលទេនៅថ្ងៃស្អែក ?
តើវានឹងក្តៅទេនៅយប់នេះ ?
តើវានឹងមានអ័ព្ទទេនៅយប់នេះ ?
តើខ្ញុំត្រូវការការពារប្រឆាំងនឹងភាពត្រជាក់នៅលើកំពូលភ្នំទេ ?
សូមឈប់លេងសើចទៅ ។
សូមទុកពេលឱ្យខ្ញុំខ្លះដើម្បីគិតអំពីវា ។
ដូចដែលអ្នកបាននិយាយអញ្ចឹង ។
ពួកយើងនឹងខកយន្តហោះ ។
ពួកយើងនឹងខកពេលវេលាចេញដំណើរសម្រាប់រថភ្លើង ។
ពួកយើងនឹងខកខានការបើកវាំងនន ។
សូមធ្វើដំណើរតាមផ្លូវកាត់នេះ ។
ខ្ញុំជួបគ្រោះថ្នាក់ចរាចរដ៏ធ្ងន់ធ្ងរមួយ ។
ខ្ញុំបានជួបរឿងហេតុដ៏អាក្រក់មួយ ។
តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវដែលលឿនបំផុតបានទេ ?
តើខ្ញុំសុំខ្នើយមួយទៀតបានទេ ?
ខ្ញុំមិនចង់បានអាហារខ្លះទេ ។
ខ្ញុំមានអារម្មណ៍មិនល្អ ។ សូមឱ្យថ្នាំខ្ញុំខ្លះមក ។
ខ្ញុំមិនអាចទ្រាំនឹងភាពត្រជាក់បានទេ ។
សូមបង្ហាញខ្ញុំទឹកអប់មួយចំនួន ។
ខ្ញុំមានអារម្មណ៍រកកលចង់ក្អួត ។ សូមឱ្យថ្នាំខ្ញុំខ្លះមក ។
ខ្ញុំឈឺក្បាល ។ សូមឱ្យថ្នាំខ្ញុំខ្លះមក ។
ខ្ញុំឈឺពោះ ។ សូមឱ្យថ្នាំខ្ញុំខ្លះមក ។
ខ្ញុំមិនអាចទ្រាំនឹងភាពក្តៅបានទេ ។
តើអ្នកទទួលមូលប្បទានប័ណ្ណអ្នកដំណើរដែរឬទេ ?
តើខ្ញុំអាចមើលទស្សនាវដ្តីខ្លះបានទេ ?
ពុំមានកន្លែងទុកឥវ៉ាន់ទេ ។
តើកន្លែងណាជាកន្លែងជក់បារី ?
ខ្ញុំពុំអាចគេងបានទេដោយសារតែក្រុមនេះមានសំលេងខ្លាំងពេក ។
ខ្ញុំបានភ្លេចកាតាបមួយនៅអាកាសយានដ្ឋាន ។
ខ្ញុំគិតថាខ្ញុំពុលអាហារហើយ ។
កន្លែងអង្គុយនេះត្រូវបាកក់ជាន់គ្នា ។
សូមរៀបចំកន្លែងអង្គុយថ្នាក់លំដាប់ខ្ពស់មួយ ។
វាជាកំហុសរបស់អ្នក ។ អ្នកត្រូវធ្វើអ្វីមួយអំពីវា ។
សូមណែនាំពួកគេឱ្យមានភាពស្ងប់ស្ងាត់ ។
តើមានបុរស ឬនារីនិយាយភាសាជប៉ុនទេ ?
តើនេះជាលើកទីមួយរបស់អ្នកឬ ?
បាទ ចាស ស្រាវីស្គីពីរដប ។
សូមបង្ហាញខ្ញុំខាងក្នុងកញ្ចប់ឥវ៉ាន់របស់អ្នក ។
ទាំងអស់នេះជារបស់របររបស់ខ្ញុំ ។
ថ្នាំសម្រាប់បញ្ហាក្រពះ ។
ទាំងនេះជាសំបុត្រហោះហើរ ហើយនឹងរបស់របរអះអាង ។
សូមបញ្ជាក់ការកក់ម្តងទៀត ។
សូមប្រាប់ខ្ញុំកាលបរិច្ឆេទចេញដំណើររបស់អ្នក ។
ឥឡូវនេះ ការកក់របស់អ្នកបានបញ្ជាក់ម្តងទៀតហើយ ។
តើខ្ញុំមកដល់អាកាសយានដ្ឋាននៅមុនម៉ោងប៉ុន្មាន ?
សូមផ្លាស់ប្ដូរការកក់របស់ខ្ញុំ ។
តើមានជើងហោះហើរទៅទីក្រុង Tokyo ខ្លះទេនៅថ្ងៃអាទិត្យ ?
វាជាកំហុសរបស់ក្រុមហ៊ុនហោះហើរ ។
សូមធ្វើការកក់ជាថ្មីលើជើងហោះហើរភ្ជាប់ផ្សេងទៀត ។
ខ្ញុំត្រូវតែទៅដល់ទីក្រុង Tokyo នៅមុនថ្ងៃស្អែក ។
ខ្ញុំចង់ឱ្យក្រុមហ៊ុនហោះហើរចេញថ្លៃសណ្ឋាគារ និងថ្លៃអាហារ ។
ខ្ញុំត្រូវតែទៅដល់នៅមុនថ្ងៃទីប្រាំ ។
ខ្ញុំបានភ្លេចសំបុត្រហោះហើររបស់ខ្ញុំនៅសណ្ឋាគារ ។
ខ្ញុំបានបាត់សំបុត្រហោះហើររបស់ខ្ញុំ ។
ខ្ញុំពុំមានប្រាក់ទិញសំបុត្រយន្តហោះថ្មីឡើយ ។
ការមកដល់របស់ខ្ញុំនឹងយឺតសាមសិវនាទី ពីព្រោះតែការស្ទះចរាចរ ។ សូមពន្យាការត្រួតពិនិត្យចូលរបស់ខ្ញុំ ។
ខ្ញុំខកជើងហោះហើរ ANA សូន្យ មួយ បី ដោយសារតែការស្ទះចរាចរ ។
តើមានជើងហោះហើរផ្សេងទៀតទេនៅថ្ងៃនេះ ?
តើជើងហោះហើរនឹងយឺតរបៀបណាទៅ ?
តើខ្ញុំអាចជិះជើងហោះហើរតភ្ពាប់បានដែរឬទេ ?
តើការធ្វើដំណើរទៅទីក្រុងដោយតាក់ស៊ីមានតម្លៃប៉ុន្មាន ?
តើការធ្វើដំណើរទៅទីក្រុងដោយតាក់ស៊ីចំណាយរយៈពេលប៉ុន្មាន ?
តើផ្លូវក្រោមដីនៅឯណា ?
តើទៅកាន់ទីក្រុងតាមឡានក្រុងអាកាសយានដ្ឋានចំណាយថ្ងៃប៉ុន្មាន ?
តើទៅកាន់ទីក្រុងដោយរថលីមូហ្ស៊ីនចំណាយថ្ងៃប៉ុន្មាន ?
តើមានសណ្ឋាគារខ្លះទេនៅឆ្នេរសមុទ្រ ?
តើមានម៉ូតែលខ្លះទេនៅជិតទីនេះ ?
សូមបង្ហាញខ្ញុំនូវសណ្ឋាគារដែលជិតស្ថានីយ៍ ។
សូមបង្ហាញខ្ញុំនូវសណ្ឋាគារដែលជិតទីក្រុង ។
សូមបង្ហាញខ្ញុំនូវសណ្ឋាគារដែលជិតផ្នែកមមាញឹកនៅក្នុងទីក្រុង ។
តើមានបន្ទប់ដែលមានអាងទឹកថោកជាងនេះខ្លះទេ ?
សូមជួយគូរផែនទីមួយឱ្យខ្ញុំផង ។
សូមរៀបចំបន្ទប់ឱ្យខ្ញុំមួយនៅយប់នេះ ?
សូមបង្ហាញបន្ទប់ដល់ខ្ញុំបានទេ ?
តើនៅម៉ោងប៉ុន្មានត្រូវត្រួតពិនិត្យចូល ?
ខ្ញុំបានកក់ទុកនៅជាន់ទីដប់ប្រាំ ។
ខ្ញុំបានកក់ទុកនៅអាកាសយានដ្ឋានមួយរយៈពេលហើយ ។
តើអាហារពេលព្រឹកចាប់ផ្តើមនៅពេលណា ?
តើអ្នកអាចយូរឥវ៉ាន់របស់ខ្ញុំទៅបន្ទប់របស់ខ្ញុំបានដែរឬទេ ?
ខ្ញុំច្បាស់ថា ខ្ញុំបានកក់បន្ទប់ដែលមានទេសភាពសមុទ្រ ។
ប្រសិនបើអ្នកពុំមានបន្ទប់ សូមណែនាំខ្ញុំទៅសណ្ឋាគារដទៃ ។
សូមប្ដូរទៅបន្ទប់ភ្លោះវិញ ។
ខ្ញុំចង់បានភួយមួយទៀត ។
តើអ្នកយកទឹកក្រូចឱ្យខ្ញុំមួយកែវបានទេ ?
តើអាចឱ្យទឹកខ្ញុំមួយកែវឥតគិតប្រាក់បានទេ ?
សូមដាស់ខ្ញុំនៅព្រឹកស្អែកម៉ោងប្រាំបីគត់ ។
ខ្ញុំចង់កុម្ម៉ង់ស្រាសំប៉ាញមួយដប ។
ខ្ញុំចង់បានសេវាកម្មដឹកជញ្ជូន ។
សូមសម្អាតបន្ទប់នេះឱ្យបានលឿន ។
សូមជួយប្រាប់ខ្ញុំនូវភោជនីយដ្ឋានចិនល្អៗខ្លះបានទេ ?
តើមានផ្សារទំនើបនៅជិតនេះដែរឬទេ ?
តើខ្ញុំអាចកក់ការធ្វើដំណើរមានជម្រើសនៅទីនេះបានឬទេ ?
សូមប្រាប់ខ្ញុំមធ្យបាយល្អបំផុតទៅកាន់ក្លឹបឌីស្កូផង ។
តើអ្នកអាចហៅតាក់ស៊ីឱ្យខ្ញុំបានទេ ?
តើខ្ញុំគួរមើលព័ត៌មានការប្រគំតន្ត្រីនៅឯណា ?
សូមប្រាប់ខ្ញុំមធ្យបាយលឿនបំផុតទៅកាន់ក្លឹបឌីស្កូផង ។
សូមប្រាប់ខ្ញុំមធ្យបាយដែលថោកបំផុតទៅកាន់ក្លឹបឌីស្កូផង ។
ខ្ញុំបានជាប់សោរខ្លួនឯងនៅខាងក្រៅ ។
តើខ្ញុំអាចបានសំបុត្រតន្ត្រីនៅឯណា ?
តើអ្នកមានផែនទីទីក្រុងនេះដែរឬទេ ?
សូមប្ដូរសន្លឹកមួយនេះជាសន្លឹកតូចៗបានទេ ។
តើអ្នកអាចឱ្យខ្ញុំខ្ចីប្រដាប់ផ្លុំសក់បានទេ ?
ខ្ញុំចូលចិត្តផ្ញើរវត្ថុមានតម្លៃរបស់ខ្ញុំ ។
សូមយកប្រអប់សុវត្ថិភាពរបស់ខ្ញុំមក ។
តើភ្ញៀវអាចប្រើប្រាស់អាងហែលទឹកនេះដោយមិនគិតប្រាក់បានដែរឬទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំរបៀបប្រើប្រាស់អាងហែលទឹកនេះបានឬទេ ?
តើម៉ោងប៉ុន្មានដែលសូណាបើក និងបិទ ?
ខ្ញុំចង់កក់ទីលានវាយតែនីសនេះ ។
ខ្ញុំសុំខ្ចីរ៉ាកែតមួយតើបានទេ ?
សូមគិតលុយបន្ទប់របស់ខ្ញុំចុះ ។
ខ្ញុំចង់ធ្វើការណាត់ជួបនៅឯហាងអ៊ុតសក់ ។
តើការកក់ជាមុនចាំបាច់សម្រាប់ភោជនីយដ្ឋានដែរឬទេ ?
មានអ្វីខុសប្លែកជាមួយម៉ាស៊ីនត្រជាក់នេះ ។
សូមត្រួតពិនិត្យវា ។
ទឹកផ្កាឈូកក្តៅខ្លាំងណាស់ ។
សោរទ្វាមិនជាប់ទេ ។
សំលៀកបំពាក់បោកគក់របស់ខ្ញុំមិនទាន់មកដល់ទេ ។ តើនៅពេលណាដែលវារួចរាល់ ?
ខ្ញុំត្រូវការលុបចោលការកក់នៅថ្ងៃទីម្ភៃ ខែកក្កដា ។
ខ្ញុំត្រូវការប្ដូរការកក់របស់ខ្ញុំសម្រាប់ថ្ងៃទីម្ភៃ ខែកក្កដា ។
សូមប្ដូរកាលបរិច្ឆេទទៅថ្ងៃទីដប់បី ខែកក្កដាវិញ ។
សូមប្ដូរពីបន្ទប់គ្រែពីរ ទៅបន្ទប់ភ្លោះវិញ ។
មនុស្សម្នាក់នឹងត្រួតពិនិត្យចេញនៅថ្ងៃស្អែក ។
ខ្ញុំចង់ស្នាក់នៅមួយយប់ទៀតប្រសិនបើអាច ។
ខ្ញុំចង់ធ្វើការកក់មួយទៀតនៅបីថ្ងៃបន្ទាប់ ។
ខ្ញុំនឹងត្រឡប់មកវិញនៅមុនថ្ងៃទីដប់មួយ ។
តើអ្នកអាចបង្ហាញខ្ញុំពីកាលវិភាគរថយន្តក្រុងទៅមជ្ឈមណ្ឌលទីក្រុងបានដែរឬទេ ?
សូមឱ្យកូនសោរដន្ទប់ដប់ ដប់ពីរមកខ្ញុំ ។
លេខបន្ទប់របស់ខ្ញុំគឺ ដប់ ដប់ពីរ ។ តើមានសារខ្លះសម្រាប់ខ្ញុំដែរឬទេ ?
