អធ្យាស្រ័យ ។ វាជាកំហុសរបស់ខ្ញុំ ។
តើខ្ញុំអាចសរសេរឈ្មោះរបស់អ្នកបានទេ ។ អាសយដ្ឋាន និងលេខទូរស័ព្ទ សម្រាប់ក្រុមហ៊ុនធានារ៉ាប់រង ?
នេះគឺប័ណ្ណរបស់ខ្ញុំ ។ អ្នកអាចទាក់ទងខ្ញុំបានតាមអាស័យដ្ឋានដែលសរសេរនៅទីនេះ ។
បន្ទាប់ពីអ្នកយកឡានអោយគេជួសជុលហើយភ្លាម សូមផ្ញើសំបុត្រដែលមានតម្លៃនៅក្នុងនោះអោយខ្ញុំ ។ ខ្ញុំនឹងផ្ញើលុយមកអោយអ្នក ។
យល់ព្រម ។ សូមបើកបរដោយសុវត្ថិភាព ។
តើខ្ញុំសុំមើលប័ណ្ណធានារ៉ាប់រងអ្នកបានទេ ?
នេះគឺឡានជួល ។ នេះគឺជាកិច្ចសន្យា ។
ករបស់ខ្ញុំឈឺ ។ តើអ្នកអាចណែនាំអ្វីមួយបានទេ ?
ស្បែកខ្ញុំរលាកដោយកំដៅថ្ងៃយ៉ាងធ្ងន់ធ្ងរ ។ តើអ្នកអាចណែនាំអ្វីបានទេ ?
តើអ្នកមានថ្នាំក្អកដែរទេ ?
ខ្ញុំត្រូវការវ៉ែនតាការពារកំដៅថ្ងៃដ៏ល្អមួយ ។
តើក្រែមការពារកំដៅថ្ងៃប្រភេទខ្លាំងបំផុតរបស់អ្នកគឺអ្វី ?
តើថ្នាំអាស្ពីរីនប្រភេទខ្លាំងបំផុតរបស់គឺអ្វីទៅ ?
ខ្ញុំឈឺក្បាលខ្លាំងណាស់ ។ តើអ្នកអាចផ្ញើថ្នាំអាស្ពីរីនខ្លះបានទេ ?
ខ្ញុំឈឺពោះ ។ តើអ្នកអាចផ្ញើថ្នាំក្រពះខ្លះមកបានទេ ?
ខ្ញុំគ្រុនផ្តាសាយ ។ តើមាននរណាគេអាចជួយខ្ញុំបាន ?
ខ្ញុំមុតម្រាមដៃ ។ តើអ្នកអាចផ្ញើបង់ស្អិតបិទដំបៅនិងថ្នាំខ្លះមកបានទេ ?
តើអ្នកមានវេជ្ជបណ្ឌិតឬគិលានុប្បដ្ឋាកនៅសណ្ឋាគារនេះទេ ?
តើអ្នកអាចអោយលេខទូរស័ព្ទ និងឈ្មោះវេជ្ជបណ្ឌិតរបស់វេជ្ជបណ្ឌិតមកខ្ញុំបានទេ ?
តើអ្នកស្គាល់វេជ្ជបណ្ឌិតណាដែលនិយាយភាសាជប៉ុនទេ ?
ខ្ញុំហូបអាហារថ្ងៃត្រង់នៅភោជនីយដ្ឋាននៅសណ្ឋាគារ ហើយខ្ញុំមិនស្រួលខ្លួនខ្លាំងណាស់ ។
សួស្តី ។ ខ្ញុំមានអារម្មណ៍រាងដូចឈឺ ។
ក្បាលរបស់ខ្ញុំឈឺ ហើយខ្ញុំមានឈឺក ។
តើអ្នកមានក្អកអីដែរទេ ?
ចុះចំណែកហៀរសំបោរវិញ ?
អ្នកប្រហែលទើបតែគ្រុនផ្តាសាយហើយ ។ អ្នកគួរតែទិញថ្នាំក្អកនិងអាស្ពីរីនខ្លះទៅ ។
ត្រូវប្រាកដថាអ្នកទៅជួបវេជ្ជបណ្ឌិតប្រសិនបើវាកាន់តែធ្ងន់ធ្ងរ ។
ខ្ញុំឈឺពោះខ្លាំងណាស់ ។
ក្អួតនិងរាគរូស ។
ក្នុងករណីនោះ ខ្ញុំគិតថាអ្នកគួរមកថ្ងៃនេះហើយ ។
យើងមានម៉ោងទំនេរនៅម៉ោងពីរ ។ តើអ្នកអាចមកបានទេពេលនោះ ?
សូមអោយឈ្មោះនិងលេខទូរស័ព្ទនៃសណ្ឋាគារលោកមកហេតុនេះយើងអាចទូរស័ព្ទរកលោកបានប្រសិនបើយើងចាំបាច់ត្រូវធ្វើ ។
ខ្ញុំសូមទោស លោក យើងមិនអាចទទួលលោកបានទេថ្ងៃនេះ ។
ប៉ុន្តែខ្ញុំឈឺខ្លាំងណាស់ ។ តើខ្ញុំអាចមកបានទេប្រសិនបើមានគេលុបចោលការណាត់របស់គេ ?
បែបហ្នឹងប្រហែលជាអាចបាន ។
ខ្ញុំនឹងទូរស័ព្ទមកវិញនៅរសៀលនេះ ។
តើថ្ងៃនេះហាក់ដូចជាមានបញ្ហាអីដែរ ?
ខ្ញុំឈឺកហើយហៀរសំបោរ ។
មានគ្រុនក្តៅទេ ?
ចាំខ្ញុំយកកំដៅអ្នក ។ ខ្ញុំគិតថាអ្នកគ្រុនផ្តាសាយហើយ ។ ចាំខ្ញុំសរសេរវេជ្ជបញ្ជាសម្រាប់ថ្នាំមួយចំនួន ។
តើអ្នកអាចនិយាយបកស្រាយបានទេថាអ្នកមានបញ្ហាមិនស្រួលអ្វី ?
តើអាគារកន្លែងរបស់អ្នកមានរូបរាងយ៉ាងម៉េច ?
តើការិយាល័យអ្នកនៅជាន់ទីប៉ុន្មាន ?
អស្ចារ្យណាស់ដែលបានជួបអ្នក ។
វាជា ទីក្រុងឆើតឆាយណាស់ ។
ការសំដែងថ្ងៃនេះពិតជាធ្វើអោយខ្ញុំរំភើបចិត្តណាស់ ។
ខ្ញុំពិតជារីករាយណាស់ដែលមានពេលវេលាដ៏ល្អបែបនេះ ។
ខ្ញុំពិតជារីករាយណាស់ដែលមានពេលវេលាដ៏គួរអោយរីករាយបែបនេះ ។
អ្នកល្អនឹងខ្ញុំខ្លាំងណាស់ហើយខ្ញុំពិតជាមានការធ្វើដំណើរដ៏សប្បាយ ។ សូមអរគុណខ្លាំងណាស់ ។
តើអ្នកអាចមកទីនេះបានទេ ?
រឿងនោះពិតជាគួរអោយក្រៀមក្រំមែន ។
រឿងនេះពិតជាមិនអាចទទួលយកបានទេ ។
ខ្ញុំពិតជាមិនសប្បាយចិត្តទេអំពីរឿងនេះ ។
រឿងនេះពិតជាធ្វើអោយខ្ញុំខឹងខ្លាំងណាស់ ។
ពិតជាគួរអោយខ្មាស់ណាស់ ។
ខ្ញុំដឹងថាអ្នកមានអារម្មណ៍បែបណាច្បាស់ណាស់ ។
ខ្ញុំរីករាយខ្លាំងណាស់ដែលបានជួបអ្នក ។
លាហើយ ។ សង្ឃឹមថាបានជួបអ្នកម្តងទៀត ។
ថ្ងៃនេះអ្នកពិតជាទាន់សម័យណាស់ ។
នោះគឺសម្លៀកបំពាក់ស្អាតណាស់ ។
ខ្ញុំចូលចិត្តកំប្លេនោះណាស់ ។
ផ្ទះរបស់អ្នកអស្ចារ្យណាស់ ។
អ្នកបានធ្វើការងារអស្ចារ្យណាស់នៅក្នុងការតុបតែងផ្នែកខាងក្នុងនេះ ។
វាគួរអោយមានផាសុកភាពណាស់នៅទីនេះ ខ្ញុំពិតជាមានអារម្មណ៍ដូចនៅផ្ទះអញ្ចឹង ។
ម្ហូបនេះមានរសជាតិអស្ចារ្យខ្លាំងណាស់ ។
ខ្ញុំមិនដែលបានភ្លក់អ្វីមួយដែលមានរសជាតិប្លែកខុសធម្មតាបែបនេះឡើយ ។
ខ្ញុំចូលចិត្តការរៀបចំបែបនេះណាស់ ។
ទេសភាពនេះគឺប្រសើរលើសលន់ណាស់
ខ្ញុំមិនដែលបានឃើញទេសភាពអីដ៏ទូលាយបែបនេះឡើយ ។
អ្នកមានចរិតកំប្លែងដ៏អស្ចារ្យ ។
ខ្ញុំពិតជាយល់ស្របនឹងអ្វីដែលអ្នកនិយាយខ្លាំងណាស់ ។
ពិតមែនឬ ? អ្នកពិតជាល្អខ្លាំងណាស់ដែលនិយាយបែបនោះ ។
ខ្ញុំព្យាយាមទុកពោះទំនេរខ្លះដើម្បីដាក់បង្អែម ។
ខ្ញុំជាអ្នកតមសាច់ ហេតុនេះខ្ញុំសុខចិត្តមិនហូបសាច់ទេ បើសិនវាមិនជាបញ្ហា ។
សូមទោស ប៉ុន្តែមើលទៅខ្ញុំដូចជាជាប់មានណាត់ពេញហើយនៅថ្ងៃនោះ ។
ខ្ញុំមានកិច្ចការខានមិនបាននៅល្ងាចនេះ ។
ខ្ញុំធ្វើដំណើរដោយមានកាលវិភាគការងារមមាញឹកណាស់ ។ ខ្ញុំមិនមានពេលទេ ។
ប្រសិនបើយើងមានឱកាស សូមយើងមកជួបជុំគ្នានៅឱកាសមួយផ្សេងទៀត ។
ខ្ញុំបានស្ថិតនៅក្នុងការងារប្រភេទនោះអស់ពេលប្រាំឆ្នាំហើយ ។
ខ្ញុំពិតជាចូលចិត្តការងារខ្ញុំណាស់ ។
ខ្ញុំចង់ចូលប្រឡូកនៅក្នុងវិស័យសារព័ត៌មាននាពេលអនាគត ។
យើងរៀបការនឹងគ្នាពីរឆ្នាំហើយ ។
យើងមានកូនជាមួយគ្នាកាលពីឆ្នាំទៅ ។
យើងទើបតែរៀបការហើយ ហើយនេះគឺជាការក្រេបច័ន្ទទឹកឃ្មុំរបស់យើង ។
សូមនាំដៃគូរអ្នកមកផង ។
ខ្ញុំជាអ្នកគាំទ្រកីឡាកូនហ្គោល ។
ខ្ញុំចូលចិត្តមើលកីឡាបាល់បោះ ។
តើក្រុមមួយណាជាក្រុមដែលអ្នកចូលចិត្ត ?
តើកីឡាមួយណាដែលអ្នកយកចិត្តទុកដាក់បំផុតនៅឆ្នាំនេះ ?
ខ្ញុំជាអ្នកគាំទ្រយ៉ាងខ្លាំងក្លាចំពោះការចំអិនអាហារអាមេរិកាំង
ការចំអិនអាហារជាជំនាញពូកែរបស់ខ្ញុំ ។
តើមានមុខម្ហូបប្រភេទណាឬភោជនីយដ្ឋានប្រភេទណាដែលអ្នកអាចណែនាំបានទេ ?
ខ្ញុំកំពុងសិក្សាមុខជំនាញប្រវត្តិសាស្ត្រអាមេរិកនៅសាកលវិទ្យាល័យខ្ញុំ ។
ខ្ញុំសិក្សាផ្នែកសម្លេងនៅមហាវិទ្យាល័យតូរតន្ត្រី ។
ខ្ញុំធ្លាប់ទៅអ៊ីតាលីនៅក្នុងកម្មវិធីសិក្សាក្រៅប្រទេស ។
ខ្ញុំជាអ្នកនិពន្ធធ្វើការមិនជាប់កិច្ចសន្យានៅប្រទេសជប៉ុន
ខ្ញុំចាប់អារម្មណ៍ចំពោះដំណែងនៅក្នុងវិស័យបោះពុម្ភផ្សាយទស្សនាវដ្តីនៅសហរដ្ឋអាមេរិក
ខ្ញុំរំពឹងទុកដោយក្តីសង្ឃឹមថានឹងបានទៅធ្វើទេសចរណ៍មើលបណ្ណាគារនៅសហរដ្ឋអាមេរិក ។
ខ្ញុំអាចលេងព្យាណូបាន ។
ខ្ញុំអាចនិយាយភាសាជប៉ុនបាន ។
ប្រជាជនជប៉ុនវ័យក្មេងចូលចិត្តតន្ត្រីរ៉ក់ និងចាស ។
ខ្ញុំមិនចាប់អារម្មណ៍លើពិធីញ៉ាំតែឬពិធីរៀបចំផ្កានោះឡើយ ។
ខ្ញុំមិនអាចទ្រាំបាននឹងត្រីឆៅបានទេ ។
ខ្ញុំស្លៀកពាក់សម្លៀកបំពាក់គីម៉ូណូតែម្តងប៉ុណ្ណោះក្នុងមួយឆ្នាំ ។
ពេលចុងក្រោយបង្អស់ដែលខ្ញុំបានអានអក្សរសិល្ប៍បែបតន្តីរបស់ជប៉ុនគឺកាលនៅវិទ្យាល័យ ។
ទស្សនៈដែលថាស្ត្រីជប៉ុនចុះញ៉មនិងតែងតែស្តាប់បង្គាប់ប្ដីគឺជាការកុហក ។
ស្ត្រីជប៉ុនជាច្រើនបន្តធ្វើការបន្ទាប់ពីរៀបការនិងមានកូនរួច ។
នៅជប៉ុន ពេលនេះវាអាចទៅរួចសម្រាប់គូរស្រកររៀបការហើយក្នុងការមានត្រកូលផ្សេងវិញ ។
ប្រទេសជប៉ុនពិតប្រាកដគឺខុសពីរូបភាពដែលអ្នកគិតទុក ។
នោះគឺប្រទេសជប៉ុនកាលពីមួយរយឆ្នាំកន្លងផុតទៅ ។
ការប្រគំតន្ត្រីនេះគឺអស្ចារ្យណាស់ ។
ការប្រគំតន្ត្រីនេះគឺគួរអោយខកចិត្តមែនទែន ។
តើអ្នកធ្លាប់បានទៅសួនឧទ្យានល្បីល្បាញទេ ?
ខ្ញុំទើបតែបញ្ចប់ទស្សនកិច្ចទីនោះ ។
សូមអត់ទោស តើរទេះភ្លើងជិះលើស្ពានអាកាសនៅឯណា ?
តើខ្ញុំអាចទិញរបស់នេះដោយមិនជាប់ពន្ធទេ ?
ខ្ញុំមិនចង់បានច្រើនបែបនេះទេ ។
តែមួយភាគបួនបានហើយ ។
សម្រាប់ទៅលេងផ្ទះពូខ្ញុំ ។
ខ្ញុំចង់ដឹងនូវរឿងដែលកំពុងកើតឡើង ?
ខ្ញុំចង់ថាមួយណាជាមួយណា ?
តើអ្នកអាចពិនិត្យមើលពេលវេលាចេញដំណើរបានទេ ?
តើទូរស័ព្ទក្នុងផ្ទះនៅឯណា ?
បន្ទប់មួយម្ភៃប្រាំមួយ ។
មូលប្បទានប័ត្រអ្នកធ្វើដំណើរ មិនអីទេឬ ?
នេះគឺបន្ទប់ម្ភៃមួយដប់ពីរ ។ សូមយកកាហ្វេពីរកែវមកផង ។
តើនរណាគេហ្នឹង ?
សូមអត់ទោស ។ ខ្ញុំចាក់សោហើយភ្លេចសោរនៅខាងក្នុង ។
សូមអត់ទោស ។ សូមបង្ហាញផ្លូវខ្ញុំទៅកាន់មហោស្រពបានទេ ?
ខ្ញុំនឹងជួលប្រភេទនេះ ។ រួមបញ្ចូលទាំងការធានារ៉ាប់រងផង ។
សូមទៅកាន់សណ្ឋាគារ អេ ។
តើខ្ញុំអាចទៅសារៈមន្ទីរដោយសារឡានក្រុងបានទេ ?
មនុស្សធំពីរនាក់និងក្មេងម្នាក់ ។
ខ្ញុំចង់ពាក់វានេះឥឡូវហ្នឹង ។
អោយនំប៊ើកហ្គើរទំហំទ្វេរពីរ និងទឹកក្រូចច្របាច់ពីរ
ត្រូវការទឹកតែថែមទៀតទេ ?
សូមរង់ចាំនៅទីនេះដើម្បីអង្គុយ ។
ខ្ញុំសូមយកដូចគ្នាដែរ ។
សូមយកដូចគ្នាដែរ ។
ដល់ពេលងូតទឹកហើយ ។
ស្តាប់ទៅគួរចង់សើច ។
តើខ្ញុំគួរជូតតុទេ ?
ពិធីជប់លៀងរបស់អ្នកនៅបន្តទៅទៀត ។
សូមផ្ញើប៉ុស្តិកាតនេះទៅកាន់ជប៉ុនផង ។
សូមអោយខ្ញុំតែមប្រិ៍តម្លៃហាសិបសេនមក ។
តើចំណាយពេលយូរប៉ុនណាដើម្បីដល់ជប៉ុន ?
បិតវានៅលើកញ្ចប់ទៅ ។
មន្ត្រីតម្រួតបទបញ្ជា ។
មន្ត្រីតម្រួតបទបញ្ជា ឆាប់ចុះមក ។
សូមបញ្ជាក់ឡើងវិញម្តងទៀត ។
តើមានកញ្ចប់អីវ៉ាន់ដែលត្រូវចុះបញ្ជីចំនួនប៉ុន្មានដែរ ?
ខ្ញុំចង់សួរសំណួរខ្លះអំពីកញ្ចប់អីវ៉ាន់របស់អ្នក ។
តើកញ្ចប់អីវ៉ាន់នេះរបស់អ្នកឬ ?
តើកញ្ចប់អីវ៉ាន់អ្នកត្រូវបានទុកចោលដោយមិនមានអ្នកមើលមុនពេលមកដល់ព្រលានយន្តហោះឬ ?
តើអ្នកមិនមានកញ្ចប់របស់អ្នកផ្សេងទេឬ ?
ពិតជាអញ្ចឹងហើយ ។
តើខ្ញុំសុំភួយបានទេ ?
តើអ្នកមានកូកាកូឡាទេ ?
ចុះចំណែកស្រាខ្លះយ៉ាងម៉េចដែរ ?
ខ្ញុំចង់ប្ដូរកន្លែងរបស់ខ្ញុំ ។
ខ្ញុំពិតជាសោកស្តាយខ្លាំងណាស់ មិនមានកន្លែងនៅសល់ទំនេរទេ ។
វានឹងចាប់ផ្តើមភ្លាមៗបន្ទាប់ពីអាហារពេលល្ងាចរួច ។
តើនេះគឺពុលយន្តហោះមែនទេ ?
វាចំណាយពេលប្រហែលមួយម៉ោងកន្លះ ។
តើអ្នកមានប័ណ្ណជនអន្តោប្រវេសន៍ទេ ?
ខ្ញុំធ្វើការអោយស្ថានីយ៍ប្រេងឥន្ធនៈ ។
ខ្ញុំធ្វើការអោយក្រុមហ៊ុនធានារ៉ាប់រង ។
តើអ្នកចង់បើកកាបូបអ្នកឬ ?
វាជាថ្នាំបំបាត់ការឈឺក្បាល ។
សុំអភ័យទោស ។ តើចំណតឡានក្រុងនៅកន្លែងណាដែរ ?
មានចំណតរថយន្តក្រុងនៅខាងក្រៅទីនេះ ។
ពួកវារត់នៅរៀងរាល់ដប់ប្រាំនាទីម្តង ។
វាមានតម្លៃប្រាំបីដុល្លារ ។
តើវាចំណាយពេលយូរប៉ុនណាទៅកាន់សង្កាត់លក់ទំនិញ ?
វាចំណាយពេលប្រហែលកន្លះម៉ោង ។
ទុកអោយខ្ញុំចុះនៅសណ្ឋាគារប្លាហ្សា ។
សណ្ឋាគារប្លាហ្សា ។ តើមានអ្វីខ្ញុំអាចជួយបាន ?
ខ្ញុំត្រូវការឡានមកទទួល ។
សូមប្ដូរប្រាក់ ។ សូមយកប្រាក់ដុល្លារ ។
សូមទៅមណ្ឌល លីនខុន ។
តើវាចេញដំណើរនៅម៉ោងប៉ុន្មាន ?
តើអ្នកអាចដាក់វ៉ាលីសខ្ញុំនៅក្នុងគូទឡានបានទេ ?
ម៉ោងដប់ពីរហាសិបនាទី ។
ទៅកាន់កំពង់ផែវ៉ាស៊ីងតោន ។
ម៉ោងដប់សាមសិបនាទី ពីផ្លូវដែកលេខប្រាំ ។
អ្នកស្រីតើមានប៉ុន្មាននាក់ដែរ ?
តើបន្ទប់គ្រែធំសម្រាប់ពីរនាក់ឬបន្ទប់គ្រែពីរ ?
បន្ទប់គ្រែពីរ ។
រយៈពេលបួនយប់ ។
តើកាលបរិច្ឆេទចេញដំណើរគឺពេលណា ?
សូមចាំបន្តិច ។ ថ្ងៃទីដប់ប្រាំខែឧសភា ។
សួស្តី ។ បន្ទប់បីប្រាំពីរប្រាំ ។
តើនោះគឺបន្ទប់បីចិតសិបប្រាំមួយ ?
តើមាននរណាគេនិយាយភាសាជប៉ុនទេ ?
អ្នកចង់បានន័យបែបនោះ ។
សម្រាប់រយៈពេលបួនយប់ ។
យើងចង់ចុះឈ្មោះចូលសម្រាក ។
មែនហើយ ។ យើងមកដល់ជប៉ុនហើយ ។
អ្នកស្រី សូមឈ្មោះអ្នកស្រី ?
ខ្ញុំឈ្មោះកាអូរី សាណូ ហើយគាត់ឈ្មោះម៉ាមី កាតូ ។
តើអ្នកអាចប្រកបវាបានទេ ?
យើងចង់សំណាក់រយៈពេលបួនយប់ ។
តម្លៃចិតសិបប្រាំដុល្លារក្នុងមួយយប់ ។
បូករួមទាំងពន្ធ ?
អត់ទេ ។ ពន្ធមិនទាន់បូកបញ្ចូលទេ ។
តើអាហារពេលព្រឹកមានបូកបញ្ចូលនៅក្នុងតម្លៃនេះទេ ?
យើងចង់បង់លុយចេញ ។
នោះគឺមានតម្លៃបួនរយម្ភៃប្រាំបីដុល្លារសរុបទាំងអស់ ។
ទុកពេលអោយពួកយើងប៉ុន្មាននាទីសិន ។ យើងចង់ ពិនិត្យវិក្កយបត្រ ។
អរគុណ ។ សូមអោយមានពេលវេលាល្អ ។
សូមមានសុវត្ថិភាព
យើងចង់យកវត្ថុមានតម្លៃយើងមកតំកល់ទុក ។
តើយើងអាចបរិភោគអាហារពេលព្រឹកបាននៅកន្លែងណាខ្លះ ?
អាហារពេលព្រឹកគឺនៅក្នុងភោជនីយដ្ឋាន ។
ថ្ងៃស្អែក ម៉ោងប្រាំមួយសែសិបប្រាំនាទី ។
មានគេម្នាក់នៅខាងក្រៅទ្វារ ។
សូមជួយបញ្ជូនវេជ្ជបណ្ឌិតមកផង ។
តើអ្នកនឹងជួយផ្ញើរបស់នេះផងទេ ?
តើអ្នកដឹងថាតែមប្រិ៍តម្លៃប៉ុន្មានដែលខ្ញុំគួរដាក់នៅលើរបស់នេះ ?
តើអ្នកអាចប្ដូរជាសាច់ប្រាក់នូវមូលប្បទានប័ត្រអ្នកដំណើរនេះបានទេ ?
តើអ្នកអាចយកវាមកបន្ទប់ខ្ញុំបានទេ ?
ខ្ញុំមាននំសំខ្យាផ្លែឈើរី ។
តើអ្នកមិនយល់ទាស់ទេបើរង់ចាំបន្តិច ?
តែដប់នាទីទេអ្នកស្រី ។
សូមអោយស្រាធ្វើនៅផ្ទះចំនួនពីរកែវមក ។
គឺថា ខ្ញុំសូមណែនាំមុខម្ហូបពិសេសថ្ងៃនេះ ។
វាគឺជាសាច់កូនគោជាមួយក្រូចឆ្មារ និងប័រ ។
វាចំណាយពេលដប់ប្រាំនាទី ។
តើអ្នកសម្រេចចិត្តហើយឬនៅ ?
ខ្ញុំយកអាលេខបីទៅចុះ ។
ចុះចំណែកទឹកសាឡាត់ស្រូបវិញ ?
ខ្ញុំយកទឹកស្រូបធ្វើពីហ្វ្រូម៉ាពណ៌ខៀវទៅចុះ ។
ខ្ញុំកុម្ម៉ង់អាលេខបី ។
អ្វីដែលខ្ញុំកុម្ម៉ង់នៅមិនទាន់បានទេ ។
ខ្ញុំគិតថាវិក័យប័ត្រនេះខុសហើយ ។
តើខ្ញុំអាចសុំភីហ្សាបានទេ ?
ទាំងមូលឬតែមួយជ្រុងទេ ?
អោយភីហ្សាពីរជ្រុងមក
តើអ្នកចង់ថែមអីលើវា ?
ខ្ញុំយកសាច់ក្រកផេបភើរ៉ូនីចុះ ។
ចុះចំណែកសំបកខាងក្រៅនំភីហ្សាវិញ ?
ខ្ញុំយកអាក្រាស់ទៅចុះ ។
មានតែប៉ុណ្ណឹងទេឬ ?
យល់ព្រម ។ ខ្ញុំនឹងទូរស័ព្ទទៅអ្នកពេលពួកគេរួចរាល់ហើយ ។
ខ្ញុំចង់បាននំសាំងវិច ។
ខ្ញុំយកម្ហូបអ៊ីតាលីទៅចុះ ។
ខ្ញុំកំពុងរកមើលអាតូច ។
មែនហើយ ។ ខ្ញុំយកក្រវិលទាំងនេះទៅចុះ ។
តើទឹកអប់នៅឯណា ?
អាមួយនោះនៅលើជញ្ជាំង ។
ខ្ញុំរកអាខ្នាតមធ្យម ។
ពិតណាស់ ។ បន្ទប់លសាកសម្លៀកបំពាក់នៅខាងស្តាំនៅត្រង់នោះ ។
ត្រូវហើយ យើងយកវាជាពណ៌ខ្មៅ និងត្នោត ។
តើអ្នកចង់អោយខ្ញុំខ្ចប់វាទាំងអស់ជាមួយគ្នាមែនទេ ?
សូមខ្ចប់ដាច់ដោយឡែកពីគ្នា ។
យើងបិទនៅម៉ោងប្រាំមួយ ។
តើបញ្ចុះតម្លៃប៉ុន្មានដែរ ?
ចុះបើពីរថ្លៃហាសិបដុល្លារវិញយ៉ាងម៉េចដែរ ?
តាមផ្លូវអាកាសឬតាមផ្លូវកប៉ាល់ទឹក ?
តើខ្ញុំអាចកក់កន្លែងពីរកន្លែងបានទេ ?
តើអ្នកអាចថតរូបបានទេ ?
ខ្ញុំចង់ជួលកង់ ។
នេះគឺព័ត៌មានអំពីរថយន្តក្រុងទេសចរណ៍ ។
ប្រាំដុល្លារ ។
តើខ្ញុំអាចសុំសៀវភៅណែនាំពីជាន់អាគារបានទេ ?
តើអ្នកជាអ្នកចុងក្រោយគេនៃជួរមនុស្សមែនទេ ?
ពួកវានៅជាន់ទីបី ។
ខ្ញុំនឹងទិញអាហារថ្ងៃត្រង់អោយអ្នក ។
តើអ្នកនឹងជួយថតរូបពួកយើងបានទេ ?
តើខ្ញុំអាចកក់កន្លែងពីរកន្លែងសម្រាប់យប់នេះបានទេ ?
ពួកវាត្រូវបានលក់អស់ហើយ ។ ប៉ុន្តែយើងមានកន្លែងអង្គុយសម្រាប់យប់ថ្ងៃស្អែក ។
តើអ្នកចង់ជិះលើរទេះត្រាក់ទ័រតូចនេះទេ ?
ស្តាប់ទៅវាគួរអោយចាប់អារម្មណ៍ណាស់ ។
តៃកុង យើងចង់ជិះ ។
តម្លៃបីដុល្លារក្នុងមួយម៉ោង ។
សំរាប់ប្រាំថ្ងៃ ។
តើអ្នកចង់ជិះប៉ុន្មានម៉ោងដែរ ?
ចុះចំណែកការធានារ៉ាប់រងវិញ ?
មានតម្លៃដប់ដុល្លារ ។
តើមានឥន្ធនៈនៅក្នុងធុងទេ ?
នេះគឺបង្កាន់ដៃសំគាល់វ៉ាលី ។
តើជើងហោះហើរអ្វីទៅ ?
តើអ្នកមានបានឃើញអាវធំក្រៅរបស់ខ្ញុំទេ ?
ខ្ញុំភ្លេចចោលមូលប្បទានប័ត្រអ្នកដំណើររបស់ខ្ញុំនៅក្នុងរថយន្តក្រុង ។
ខ្ញុំចង់ទៅកាន់រុក្ខវិថីទីប្រាំ ។
តើខ្ញុំអាចប្ដូរកាលបរិច្ឆេទនៃសំបុត្រនេះបានទេ ?
តើថ្ងៃណាលោកចង់បានវិញ ?
ថ្ងៃច័ន្ទសប្ដាហ៍បន្ទាប់ ។
ខ្ញុំចង់លុបចោលសំបុត្រនេះ ។
ខ្ញុំឈឺនៅត្រង់ពោះ ។
សូមបញ្ជូនវេជ្ជបណ្ឌិតនិយាយភាសាជប៉ុន ។
ម៉ាស៊ីនឡានខ្ញុំឈប់ដើរ ។
ប្រទេសជប៉ុនត្រូវបានបង្កើតឡើងដោយកោះធំសំខាន់ចំនួនបួន ហុកកៃដូ ហុងស៊ូ ស្ហ៊ីហ្គុគឹះនិង ឃ្យូស៊្ហូ ។
ជប៉ុនមានទំហំមួយភាគម្ភៃប្រាំនៃសហរដ្ឋអាមេរិក ។
ប្រទេសជប៉ុនមានទំហំធំប្រហែលរដ្ឋកាលីហ្វ័រនៀ ។
ប្រហែលចិតសិបភាគរយនៃផ្ទៃដីជប៉ុនគឺជាភ្នំ ។
ភ្នំហ៊្វូជីមានកំពស់មួយម៉ឺនពីរពាន់បីរយប៉ែតសិបប្រាំបីហ្វ៊ីត ។
ការរញ្ជួយដីកើតមានញឹកញាប់នៅជប៉ុន ។
ក្យូតុជាទីក្រុងប្រវត្តិសាស្ត្រដែលជារាជធានីរបស់ជប៉ុនអស់កាលដ៏យូរ ។
គណបក្សកាន់អំណាចនៃប្រទេសជប៉ុនអស់រយៈកាលលើសពីសាមសិបឆ្នាំគឺជាគណបក្សប្រជាធិបតេយ្យសេរី ។
ប្រទេសជប៉ុនមានរដូវខុសៗគ្នាចំនួនបួនរដូវ ។
នៅតូក្យូ វាអាចធ្លាក់ព្រិលពីខែធ្នូរហូតដល់ខែមិនា ។
ខែមេសាជាខែមើលផ្កាឈើរី ។
ខែមិថុនាជារដូវភ្លៀងនៅប្រទេសជប៉ុន ។
នៅជប៉ុននៅរដូវក្តៅវាក្តៅស្អុះស្អាប់ខ្លាំង ។
ខ្យល់ព្យុះថាយហ៊្វូនកើតមានញឹកញាប់នៅរដូវស្លឹកឈើជ្រុះនៅជប៉ុន ។
ប្រជាជនប្រទេសជប៉ុនគឺប្រហែលមួយរយម្ភៃលាននាក់ ។
ចំនួនប្រជាជននៃទីក្រុងតូក្យូគឺប្រហែលដប់ពីរលាននាក់ ។
មិនមានប្រពៃណីនៃការអោយលុយទឹកតែនៅជប៉ុនឡើយ ។
ជនជាតិជប៉ុនដោះស្បែកជើងរបស់គេនៅពេលគេចូលផ្ទះ ។
ជនជាតិជប៉ុនអោនគំនាប់ពេលពួកគេស្វាគមន៍គ្នាទៅវិញទៅមក ។
ជនជាតិជប៉ុនបញ្ចេញសម្លេងពេលពួកគេញ៉ាំមីជប៉ុន ។
ជនជាតិជប៉ុនមិនលុបលាងខ្លួនគេនៅក្នុងអាងងូតទឹកឡើយ ។
មានវិធីបីយ៉ាងក្នុងការសរសេរភាសាជប៉ុន ។ គឺអក្សរកានជិ កាតាកាណាក់ និងហ៊ីរ៉ាកាណាក់ ។ អក្សរកានជិគឺអក្ខរក្រមចិន ។ កាតាកាណាក់និងហ៊ីរ៉ាកាណាក់គឺជាអក្ខរក្រមសម្រាប់បញ្ចេញសម្លេង ។ អក្ខរក្រមកាតាកាណាក់តាមធម្មតាត្រូវបានប្រើប្រាស់ដើម្បីសរសេរពាក្យបរទេសនិងពាក្យទៅតាមការបន្លឺសម្លេង ។
សឹងតែគ្រប់ផ្ទះជនជាតិជប៉ុនទាំងអស់មានបន្ទប់រចនាបថជប៉ុននិងរចនាបថអឺរ៉ុប ។
ជនជាតិជប៉ុនដេកនៅលើគ្រែឬនៅលើពូកញាត់សំឡីគរ ។
យូកាតាមិនមែនជាគីម៉ូណូទេប៉ុន្តែជាអាវវែងសម្រាប់ងូតទឹក ។
ជនជាតិជប៉ុនតាមធម្មតាមិនប្រើសម្លៀកបំពាក់គីម៉ូណូទេ ។
ជនជាតិជប៉ុនស្លៀកពាក់សម្លៀកបំពាក់គីម៉ូណូនៅក្នុងឱកាសពិសេស ។
គ្រួសារដែលនៅជួបជុំមូលគ្នាបានក្លាយជារឿងធម្មតាឃើញជាញឹកញាប់នៅជប៉ុន ។
ជនជាតិជប៉ុនតាមធម្មតាមានកូនពីរនាក់ ។
ប្រជាជនជប៉ុនសឹងគ្រប់គ្នាគិតថាពួកគេស្ថិតនៅក្នុងវណ្ណៈកណ្តាល ។
មធ្យោបាយដឹកជញ្ជូនសាធារណៈនៅតូក្យូមានការអភិវឌ្ឍន៍ខ្ពស់ណាស់ ។
ជនជាតិជប៉ុនចូលចិត្តធ្វើអី្វជាក្រុម ។
ជនជាតិជប៉ុនមានទំនៀមទម្លាប់ជូនអំណោយនៅក្នុងឱកាសជាច្រើន ។
កីឡាជាតិរបស់ជប៉ុនគឺកីឡាស៊ូម៉ូ ។
យូដូនិងការ៉ាត់តេជាកីឡាជំនាន់ដើមប៉ុន្តែពួកវាមិនសូវមានប្រជាប្រិយខ្លាំងទេ ។
តើអ្នករីករាយនឹងការធ្វើដំណើរអ្នកទេ ?
អ្នកទៅផ្ទះហើយ ?
កន្លែងអង្គុយជាប់នឹងច្រកដើរនៅត្រង់នោះ ។
តើខ្ញុំអាចយកកន្លែងអង្គុយនៅក្បែរបង្អួចនោះបានទេ ?
តើមានកន្លែងអង្គុយសម្រាប់អ្នកមិនជក់បារីទេ ?
នោះគឺកន្លែងអង្គុយរបស់ខ្ញុំ ។
ខ្ញុំខ្លាចតែនេះមិនមែនជាកន្លែងអង្គុយរបស់អ្នកទេ ។
តើអ្នកមានភេសជ្ជៈប្រភេទបែបណាខ្លះ ?
កាសស្តាប់ត្រចៀកមិនដំណើរការទេ ។
ខ្ញុំមិនទាន់បានទទួលអាហារខ្ញុំនៅឡើយទេ ។
តើខ្ញុំសុំកាហ្វេមួយពែងទៀតបានទេ ?
អត់ទោស ។ តើខ្ញុំអាចសួរអ្នកមួយសំណួរបានទេ ?
តើអ្នកនឹងផ្តល់អាហារអ្វីសម្រាប់អាហារមុខបន្ទាប់ ?
សាច់ជ្រូកនិងបន្លែខ្លះជាមួយនិងទឹកជ្រលក់ការី ។ ហេតុអី ?
អូ គ្មានអីទេ ។ ខ្ញុំគ្រាន់តែឆ្ងល់ចង់ដឹងប៉ុណ្ណោះ ។
តើអាកាសធាតុនៅទីក្រុងឡុងដ៏យ៉ាងម៉េចដែរ ?
អោយពីរមក ។ តើលុយយេនជប៉ុនបានដែរទេ ?
តើអ្នកលក់អីវ៉ាន់លើយន្តហោះដែរឬទេ ?
ខ្ញុំអាចសុំមើលប៉ាន់គំរូបានទេ ?
តើអ្នកអាចផ្ញើតាមប្រៃសណីយ៍ទៅប្រទេសជប៉ុនបានដែរទេ ?
តើអ្នកលក់របស់របរប្រភេទបែបណាខ្លះ ?
តើអ្នកពុលយានជំនិះមែនទេ ?
មែនហើយ ខ្ញុំគិតអញ្ចឹងដែរ
ខ្ញុំនឹងយករបស់ខ្លះមកអោយអ្នកសម្រាប់ពុលយានជំនិះ ។
តើអ្នកនឹងទៅផ្ទះវិញឬ ?
តើអ្នកនៅប្រទេសជប៉ុនយូរហើយ ?
មិនយូរណាស់ណាទេ ។ ត្រឹមតែកន្លះឆ្នាំប៉ុណ្ណោះ ។
តើអ្នកកំពុងធ្វើការមែនទេ ?
បាទ ។ យើងមានការិយាល័យសាខានៅប្រទេសជប៉ុន ។ នៅអូសាកា ។
តើអ្នកចូលចិត្តប្រទេសជប៉ុនទេ ?
តើអ្នកមកដើរលេងនៅប្រទេសជប៉ុនមែនទេ ?
តើគ្រួសារអ្នកស្នាក់នៅឯណានៅសហរដ្ឋអាមេរិក ?
អ្នកនឹកក្រុមគ្រួសារអ្នកព្រោះអ្នកមិនអាចឃើញមុខពួកគេ ត្រូវទេ ?
តើទីក្រុងមួយណាដែលអ្នកចូលចិត្តបំផុតក្នុងប្រទេសជប៉ុន ?
តើអាហារជប៉ុនអីដែលអ្នកចូលចិត្ត ?
តើអ្នកមានបញ្ហាអីទេនៅប្រទេសជប៉ុន ?
សណ្ឋាគារហ៊ីលតុនក្នុងក្រុងញូយ៉ក ។
ខ្ញុំមកទីនេះដើម្បីសិក្សា ។
ខ្ញុំនឹងស្នាក់នៅជាមួយមិត្តភក្តិខ្ញុំនៅទីក្រុងញូយ៉ក ។
ខ្ញុំនឹងស្នាក់នៅទីក្រុងញូយ៉ក ប៉ុន្តែខ្ញុំមិនទាន់សម្រេចចិត្តអំពីរឿងសណ្ឋាគារនៅឡើយ ។
ខ្ញុំនឹងទៅសិក្សានៅសាលារៀនភាសា ។
នេះជាសំបុត្រមកពីគាត់ ។
នេះជាសៀវភៅធនាគាររបស់ខ្ញុំ ។
នេះជាមូលប្បទានប័ត្រអ្នកធ្វើដំណើររបស់ខ្ញុំ ។
បាទ អោយតែជប៉ុនខ្លះមក ។
ប្រាំពីរដុល្លារ ។
ត្រូវការផ្លែឈើអីទេ ?
តើទីនេះខ្ញុំអាចប្ដូរលុយយ៉េនយកដុល្លារបានដែរទេ ?
ខ្ញុំចង់ប្ដូរប្រាក់ពីរម៉ឺនយ៉េន ។
តើអ្នកចង់បានក្រដាសប្រាក់ដូចម្តេចដែរ ?
សន្លឹកម្ភៃដុល្លារប្រាំសន្លឹក និងសន្លឹកដប់ដុល្លារប្រាំមួយសន្លឹក ។
សូមគិតប្រាក់តាមមូលប្បទានប័ត្រអ្នកធ្វើដំណើរទាំងនេះ ។
សូមប្ដូរជាលុយរ៉ាយតូចៗសម្រាប់សន្លឹកមួយនេះ ។
សូមបង្ហាញលិខិតឆ្លងកាត់របស់អ្នកមក ។
នៅក្នុងយន្តហោះនេះ ខ្ញុំសូមនៅទីនេះបានទេ ?
សូមចុះមកហើយរង់ចាំនៅបន្ទប់ឆ្លងកាត់សិន ។
យន្តហោះនេះត្រូវចេញដំណើរនៅវេលាម៉ោងប្រាំបីម្ភៃនាទី ។
តើខ្ញុំសុំប្ដូរវាទៅថ្ងៃទីម្ភៃខែមករាបានទេ ?
ចុះបើថ្ងៃទីម្ភៃមួយខែមករាបានទេ ?
ខ្ញុំលុបចោលតើបានទេ ?
មានមួយនៅទីនោះ ។
តើជាលុយយ៉េនជប៉ុនបានដែរទេ ?
ប្រាកដណាស់ ។ អធ្យាស្រ័យ ខ្ញុំអាចមើលលិខិតឆ្លងកាត់របស់អ្នកបានទេ ?
តើខ្ញុំអាចយកវានៅទីនេះបានទេ ?
សុំទោស ។ ប៉ុន្តែតើអ្នកអាចរង់ចាំសម្រាប់លុបចោលដោយប្ដូរទៅជើងហោះហើរបន្ទាប់បានទេ ?
នៅម៉ោងប្រាំបីសែសិបនាទី ។
តើមានចំនួនប៉ុន្មាននៅក្នុងបញ្ជីរងចាំ ?
អ្នកស្ថិតនៅលេខរៀងទីបី ។
សូមរង់ចាំនៅក្នុងបន្ទប់រង់ចាំនៅទីនោះ ។ ខ្ញុំនឹងហៅឈ្មោះរបស់អ្នក ។
វ៉ាលីដែលខ្ញុំបានត្រួតពិនិត្យនៅពេលចូលមិនបានចេញមកទេ ។
វ៉ាលីដែលខ្ញុំបានត្រួតពិនិត្យបានបាក់បែកខូចខាត ។
ខ្ញុំមានអារម្មណ៍ថាឈឺ ។ តើគ្លីនិកនៅទីណា ?
ខ្ញុំបានភ្លេចរបស់នៅក្នុងយន្តហោះ ។
តើវានៅសល់រយៈពេលប៉ុន្មានមុននឹងយើងចេញដំណើរ ?
ខ្ញុំត្រូវទៅដល់នៅយប់នេះ ។ តើអ្នកអាចទៅទទួលខ្ញុំនៅព្រលានយន្តហោះបានទេ ?
អ្នកអាចធ្វើដំណើរថ្មើរជើងប្រហែលសាមសិបនាទី ។
វាមានចម្ងាយឆ្ងាយបន្តិច ។ តើខ្ញុំអាចធ្វើដំណើរតាមរថភ្លើងបានទេ ?
វាពុំមានស្ថានីយ៍នៅជិតនេះទេ ។ ចុះបើធ្វើដំណើរតាមតាក់ស៊ីយ៉ាងម៉េចដែរ ?
