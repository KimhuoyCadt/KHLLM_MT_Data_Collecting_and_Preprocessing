ចុះចំណែកហាងកាហ្វេដែលយើងជួបគ្នាកាលពីលើកចុងក្រោយនោះវិញយ៉ាងម៉េចដែរ ?
ចុះចំណែកទៅមើលភាពយន្តយ៉ាងម៉េចដែរ ?
វារាងដូចជាយឺតពេលហើយ ។
សូមភ្ជាប់ខ្ញុំអោយនិយាយជាមួយលោក Tanaka នៅបន្ទប់ប្រាំបីម្ភៃផង ។
សូមប្រាប់គាត់ថាលោក Tanaka នឹងរង់ចាំការហៅទូរស័ព្ទគាត់ ។
វាបន្ទាន់ណាស់ ។
ខ្ញុំនឹងប្រាប់គាត់ភ្លាមពេលគាត់ត្រលប់មកវិញ ។
តើខ្ញុំគួរអោយគាត់ទូរស័ព្ទទៅរកអ្នកវិញពេលគាត់ត្រលប់មកដល់ទេ ?
តើគាត់អាចទូរស័ព្ទរកអ្នកយប់ជ្រៅដល់ថ្មើរណា ?
បណ្តាញទូរស័ព្ទយើងមិនល្អខ្លាំងណាស់ ។
ខ្ញុំនឹងទូរស័ព្ទរកលោកវិញនៅពេលមួយភ្លែតទៀត ។
ខ្ញុំមានការហៅទូរស័ព្ទនៅខ្សែទូរស័ព្ទមួយទៀត ។ សូមរង់ចាំបន្តិច ។
មានមនុស្សនៅត្រង់ទ្វារ ។ សូមរង់ចាំបន្តិច ។
ខ្ញុំគួរតែបិទហ្គាសហើយ ។ រង់ចាំមួយភ្លែត ។
សូមរង់ចាំមួយភ្លែត ។ ចាំខ្ញុំរកប៊ិចអោយបានសិន ។
នេះគឺ Miki ទូរស័ព្ទពីទីក្រុងតូក្យូប្រទេសជប៉ុន ។
តើអ្នកទូរស័ព្ទមកពីណាដែរ ?
ចាំតែមួយភ្លែតទេ ។ ខ្ញុំសួរប៉ូលីសជូនអ្នក ។
សូមដើរទៅត្រង់ ។
ទៅត្រង់ប្រហែលពីររយម៉ែត្រ ។
ដើរត្រង់ទៅប្រហែលដប់នាទី ។
វាឆ្ងាយណាស់ពីទីនេះ ។
វានៅជិតនេះទេ ។
អ្នកអាចបណ្តើរវាបាន ។
វានៅខាងក្រោយអាគារនេះ ។
ដើរត្រង់ប្រហែលប្រាំនាទ ។ ហើយបត់ឆ្វេង ។
មានផ្សារទំនើបនៅត្រង់កាច់ជ្រុង ។
មានហាងលក់ផ្កា ។
មានស្ថានីយ៍ប្រេងឥន្ធនៈពីរប្លុកពីទីនេះ ។
មានចំណតរថយន្តក្រុងនៅជិតផ្លាកសញ្ញាទីបី
មាននៅក្បែរហាងលក់សត្វចិញ្ចឹម ។
មួយរយម៉ែត្រខាងមុខនេះ ។
ប្រហែលពីររយម៉ែត្រខាងមុខ ។
មានធនាគារមួយនៅពីរប្លុកខាងមុខ ។
ប្រហែលមួយរយម៉ែត្រខាងក្រោយ ។
សូមទៅក្រោយវិញប្រហែលមួយរយម៉ែត្រ ។
ខ្ញុំនឹងទៅតាមទិសដៅនោះហើយ ។
ស្ថានីយ៍ស្ថិតនៅក្នុងទិសដៅនោះហើយ ។
តើអ្នកមានអាសយដ្ឋានទេ ?
វានៅកន្លែងណាមួយនៅជុំវិញទីនេះ ?
ខ្ញុំខ្លាចតែគ្មានកន្លែងបែបនេះទេ
ខ្ញុំសូមទោស ។ ខ្ញុំជាមនុស្សចំណូលថ្មីនៅទីនេះ ។ តើខ្ញុំអាចសួរប្រុសម្នាក់នោះអោយអ្នក បើអ្នកចង់បែបនោះ ? សូមចាំមួយភ្លែត ។
ខ្ញុំមិនស្គាល់អាគារនោះទេ ។ ប៉ុន្តែនេះគឺជាផ្លូវត្រូវហើយទៅកាន់ខណ្ឌ Aoyama ប្រាកដណាស់ ។
តើសោហ៊ុយទៅកាន់ក្រុងតូក្យូប៉ុន្មានដែរ ?
សោហ៊ុយគឺបួនពាន់យ៉េន ។
សោហ៊ុយគឺមួយរយកៅសិបយ៉េនសម្រាប់ចម្ងាយណាក៏ដោយ ។
យើងចុះផ្ទេរអ្នកដំណើរនៅស្ថានីយ៍បន្ទាប់ ។
សូមផ្ទេររថភ្លើងនៅត្រង់ស្ថានីយ៍ទីបី ។
អ្នកត្រូវតែបានកក់សំបុត្រទុកជាមុន ។
នៅម៉ោ ។ ដប់សាមសិបនាទីមានរថភ្លើងលឿនមានចំនួនកំណត់ ។
សំបុត្រមានសុពលភាពបានរយៈពេលបីថ្ងៃ ។
រថយន្តក្រុងមករៀងរាល់ដប់នាទី ។
អ្នកអាចហៅតាក់ស៊ីនៅតាមផ្លូវបាន ។
ភ្លើងពណ៌ក្រហមមានន័យថា "ទំនេរ" ។
សូមរង់ចាំនៅគន្លងផ្លូវដែកលេខប្រាំមួយ ។
រថភ្លើងមួយណាក៏បានដែរ ។
សូមប្រើរថយន្តក្រុងលេខមួយ ។
សូមប្រើរថភ្លើងក្រោមដី ។
សូមប្រើទ្វារខាងមុខ ។
អ្នកត្រូវតែប្រើប្រាស់រថយន្តក្រុ ។ តាក់ស៊ីឬក៏រថភ្លើង ។
សូមរង់ចាំមួយភ្លែត ។
សូមរង់ចាំ ។ ខ្ញុំទៅរកគាត់ ។
គាត់នឹងមកវិញនៅម៉ោងប្រហែលប្រាំបួន ។
គាត់នឹងត្រលប់មកវិញនៅក្នុងពេលមួយម៉ោង ។
គាត់នឹងមកវិញនៅម៉ោងដប់ ។
សូមទូរស័ព្ទមកម្តងទៀត ។
ទុកអោយខ្ញុំមកទទួលអ្នកទៅ ។
ខ្ញុំនឹងទទួលអ្នកនៅម៉ោងដប់ ។
ខ្ញុំនឹងទូរស័ព្ទរកអ្នកនៅផ្ទះអ្នកនៅម៉ោងប្រាំបួន ។
គាត់នឹងជួបអ្នកនៅស្ថានីយ៍ ។
ខ្ញុំនឹងជួបអ្នកនៅគន្លងផ្លូវដែកលេខប្រាំពីរ ។
ហេតុអីបានអ្នកមិនមកជួបយើងនៅរសៀលថ្ងៃសៅរ៍នេះ ?
មកជួបខ្ញុំថ្ងៃស្អែកនេះ ។
សូមមកផ្ទះរបស់ខ្ញុំ ។
ខ្ញុំចង់អោយអ្នកមកផ្ទះរបស់ខ្ញុំ ។
ប្រើរថយន្តក្រុងលេខមួយនិងចុះនៅចំណតទីបី ។
សូមអញ្ជើញចូលមកក្នុងមក ។
ពិសារតែ កាហ្វេ ឬក៏ស្រាបៀរ ?
ទុកអោយខ្ញុំណែនាំកូនស្រីខ្ញុំ ឈ្មោះ Miki ។
ខ្ញុំចង់អោយអ្នកជួបកូនប្រុសខ្ញុំ Jiro ។
ខ្ញុំចង់លាងដៃរបស់ខ្ញុំ ។
សូមចាត់ទុកដូចផ្ទះអ្នកចុះ ។
សូមដោះអាវធំអ្នកចេញទៅ ។
សូមសន្ធឹងជើងរបស់អ្នក ។
សូមលុបលាងខ្លួនអ្នកនៅខាងក្រៅអាងមុជទឹក ។
សូមកំដៅខ្លួនអ្នកនៅក្នុងអាងមុជទឹក ។
សូមមេត្តាប្រើប្រាស់កន្សែងនេះ ។
សូមនៅជាមួយយើងហើយយប់នេះ ។
វាយឺតពេលពេកហើយសម្រាប់រថភ្លើងចុងក្រោយនោះ ។
នេះគឺគ្រែរបស់អ្នក ។
ខ្ញុំនឹងនាំអ្នកទៅផ្ទះនៅក្នុងឡានខ្ញុំ ។
តើខ្ញុំគួរហៅឡានតាក់ស៊ីអោយអ្នកទេ ?
គួរប្រើឡានតាក់ស៊ីប្រសើរជាង
អរគុណអ្នកខ្លាំងណាស់ដែលបានមក ។
ល្ងាចនេះខ្ញុំមានពេលវេលាដ៏ល្អ ។
ត្រូវបា្រកដថាអ្នកមកទៀត ។
តើអ្នកដាក់អីនៅក្នុងវា ?
វាមានរសជាតិជូរ ។
ទាំងអស់នេះគឺធ្វើនៅផ្ទះ ។
វាត្រូវបានគេញ៉ាំដោយជ្រលក់ចូលក្នុងទឹកស៊ីអ៊ីវបន្តិចបន្តួច ។
សូមអញ្ជើញពិសារនំសាំងវិច ។
វាជាហាងរចនាបឋជប៉ុន ។
ចុះចំណែកផ្ទះសំណាក់យ៉ាងម៉េចវិញ ?
មានកន្លែងប្រវត្តិសាស្ត្រជាច្រើនកន្លែង ។
អ្នកអាចរីករាយនឹងការលេងស្គីនៅទីនោះ ។
តម្លៃបន្ទប់គឺប្រាំមួយពាន់យ៉េនក្នុងមួយយប់ ។
វាបូករួមទាំងអាហារពេលព្រឹក ។
វាជាបន្ទប់ដែលមានតម្លៃសមស្របបំផុត ។
ទីក្រុងក្យូតុមានភាពល្បីល្បាញព្រោះប្រាសាទរបស់វា ។
ព្រះពុទ្ធរូបធំមានកំពស់ប្រហែលហាសិបបីហ្វ៊ីត ។
ទន្លេមានទទឹងប្រវែងលើសពីមួយរយម៉ែត្រ ។
ចុះទៅឆ្នេរខ្សាច់ជាមួយខ្ញុំនៅថ្ងៃអាទិត្យយ៉ាងម៉េចដែរ ?
យើងនឹងធ្វើដំណើរកំសាន្តចុងសប្ដាហ៍ ។ ចូលរួមជាមួយយើងចុះបើសិនអ្នកចង់ ។
ទុកអោយខ្ញុំនាំអ្នកមើលជុំវិញទីក្រុងចុះ ។
មើលទៅទីនោះចុះ ។ អ្នកអាចមើលឃើញប៉មនិមិត្តរូបសំគាល់ ។
សូមប្រើប្រាស់ជណ្តើរយន្ត ។
បង្ហាញខ្ញុំអាខ្មៅមកមើល ។
តើអ្នកមានអាពណ៌ក្រហមដែរទេ ?
បា ។ យើងមានមួយចំនួននៅក្នុងស្តុក ។
នេះគឺរបស់ថ្មីចុងក្រោយបំផុត ។
នេះគឺប្រភេទថ្មីស្រឡាង ។
មួយនេះត្រូវបានធ្វើឡើងពីវត្ថុធាតុដើមល្អជាង ។
មួយនេះមិនជ្រាបទឹក ។
មួយនេះមិនចេញពណ៌ ។
វានឹងស្លកពណ៌បន្តិចបន្តួច ។
មួយនេះអាចលាងទឹកបាន ។
មួយនេះមិនជ្រួញពេលហាល ។
នេះគឺដែនកំនត់របស់យើងហើយ ។
ខ្ញុំមានច្រើនបំផុតត្រឹមតែប្រាំពាន់យ៉េនតែប៉ុណ្ណោះ ។
នេះគឺការធានា ។
មួយនេះត្រូវបានធានារយៈពេលមួយឆ្នាំ ។
មិនមានកម្រៃសម្រាប់ការយកទៅជូនដល់កន្លែងទេ ។
សូមទោសប៉ុន្តែពួកវាលក់អស់ហើយ ។
តើខ្ញុំគួរបញ្ជាទិញមួយដែរទេប្រសិនបើអ្នកចង់បាន ?
យើងប្រហែលនឹងអាចទទួលឥវ៉ាន់នៅត្រឹមដំណាច់ខែនេះ ។
បរិមាណដែលមានគឺមានកំរិត ។
យើងមិនដោះស្រាយរឿងអត្ថបទនោះឡើយ ។
តើអ្នកមានការឈឺចាប់ដទៃទៀតដែរទេ ?
តើអ្នកមានរោគសញ្ញាស្រដៀងគ្នានេះពីមុនមកទេ ?
ម្រាមដៃខ្ញុំមានអារម្មណ៍ស្ពឹក ។
ពេលខ្លះខ្ញុំមានអារម្មណ៍វិលមុខ ។
កែងដៃរបស់ខ្ញុំហើម ។
ខ្ញុំមានការឈឺចាប់ចុកមួលត្រង់នេះ ។
ភ្នែកខ្ញុំព្រិល ។
ខ្ញុំមានប្រតិកម្មកន្ទួលស្បែកនៅចំហៀងខ្លួន ។
ខ្ញុំអាចនឹងពុលអាហារ ។
ខ្ញុំមានបញ្ហាតម្រងនោម ។
ពីរឆ្នាំកន្លងទៅខ្ញុំមានបញ្ហាថ្លើម ។
កាលពីឆ្នាំមុនខ្ញុំមានជម្ងឺគាំងបេះដូង ។
ពោះវៀនខ្ញុំកម្រើក ។
ខ្ញុំកូរពោះឃ្លានអាហារ ។
ខ្ញុំឆ្អល់ចុងដង្ហើម ។
កូនខ្ញុំទង្គិចក្បាលរបស់គេយ៉ាងខ្លាំងនឹងជញ្ជាំង ។
កូនរបស់ខ្ញុំដល់ពេលកើតនៅខែតុលា ។
កូនរបស់ខ្ញុំមានជម្ងឺប្រកាច់ ។
ប្រពន្ធខ្ញុំបានបាត់បង់ស្មារតី ។
ប្ដីរបស់ខ្ញុំបានសន្លប់ធំ ។
ម្តាយរបស់ខ្ញុំខ្យល់គ ។
ប្ដីរបស់ខ្ញុំមានជម្ងឺគាំងបេះដូង ។
ខ្ញុំមានជីពចរមិនទៀងទាត់ ។
ខ្ញុំនឹងនាំអ្នកទៅកាន់មន្ទីរពេទ្យ ។
សូមហៅវេជ្ជបណ្ឌិត ។
អ្នកត្រូវតែស្ថិតនៅក្រោមការធ្វើវិភាគបន្ថែមទៀត ។
អ្នកត្រូវតែស្ថិតនៅក្រោមការធ្វើវិភាគខ្លះទៀត ។
យើងត្រូវការធ្វើការវិភាគខ្លះៗ ។
អ្នកអាចនឹងមានអារម្មណ៍គេចាក់ ។
តើអ្នកមានការឈឺចាប់នៅត្រង់នេះមែនទេ ?
យើងនឹងធ្វើការថតវិទ្យុសាស្ត្រទ្រូង ។
នេះគឺវេជ្ជបញ្ជារបស់អ្នក ។
គាត់ត្រូវតែទទួលការបញ្ចូលឈាមភ្លាមៗ ។
នាងត្រូវការការវះកាត់ ។
តើអ្នកយល់ព្រមចំពោះការវះកាត់ដែរឬទេ ?
គាត់ត្រូវតែធ្វើការវិភាគខានមិនបាន ។
អ្នកនឹងបានធូរស្បើយឆាប់ៗនេះ ។
លោក ។ មសុនស្ថិតនៅក្នុងស្ថានភាពធ្ងន់ធ្ងរ ។
នាងនៅក្នុងសភាពសន្លប់ធំ ។
គាត់ស្ថិតក្នុងស្ថានភាពធ្ងន់ធ្ងរ ។
ឱសថនេះគឺល្អសម្រាប់ជម្ងឺឈឺក្រពះ ។
ឱសថនេះមានផលវិបាកបន្ទាប់បន្សំតិចតួច ។
តើអ្នកមានប្រតិកម្មអាលែកហ្ស៊ីនឹងថ្នាំពេទ្យដែរទេ ?
សូមប្រើប្រាស់បីគ្រាប់បន្ទាប់ពីអាហារមួយពេលៗ ។
សម្រាប់មនុស្សពេញវ័ ។ ប្រើប្រាស់ពីគ្រាប់មួយដងក្នុងមួយ ថ្ងៃ ។
លាបប៉ូម៉ាតនេះត្រង់ផ្នែកដែលមានបញ្ហា ។
តម្លៃបន្ទប់គឺប្រាំពាន់យ៉េនសម្រាប់មួយយប់ ។
តម្លៃគឺបួនពាន់យ៉េនដោយគ្មានទីកន្លែងស្នាក់នៅ ។
ខ្ញុំទូរស័ព្ទមកដើម្បីសាកសួរប្រសិនបើអ្នកមានបន្ទប់មួយទំនេរសម្រាប់យប់នេះ ។
ចា៎ លោក ។ យើងមានបន្ទប់មួយទំនេរសម្រាប់យប់នេះ ។
សូមបំពេញប័ណ្ណនេះ ។
សូមបំពេញចន្លោះទទេនេះដោយឈ្មោះរបស់អ្នក ។
សូមចុះឈ្មោះក្នុងបញ្ជីចុះឈ្មោះ ។
សូមដោះស្បែកជើងអ្នកនៅទីនេះ ។
តើអ្នកត្រូវការបន្ទប់រចនាបឋជប៉ុនមែនទេ ?
ខ្ញុំជាអ្នករៀបចំបន្ទប់របស់អ្នក ។
តើខ្ញុំអាចសំអាតបន្ទប់អ្នកបានដែរទេ ?
តើខ្ញុំអាចរៀបចំគ្រែបានដែរទេ ?
បន្ទប់របស់អ្នកមានឈ្មោះថា "Sakura"ដែលមានន័យថាផ្កាឈើរី ។
តើខ្ញុំគួរដាក់វត្ថុមានតម្លៃរបស់អ្នកនៅក្នុងទូរដែកដែរទេ ?
តើលេខរបស់ "ការិយាល័យជួរមុខ" ប៉ុន្មានដែរ ?
បន្ទប់បរិភោគអាហារគឺស្ថិតនៅជាន់ទីមួយហើយបើកដំណើរការនៅម៉ោងប្រាំសាមសិបនាទីល្ងាច ។
បន្ទប់បាយបិទនៅម៉ោងប្រាំបួនល្ងាច ។
មានភោជនីយដ្ឋានច្រើននៅជុំវិញនេះ ។
វានៅជាន់ទីពីរនៅក្នុងឧបសម្ព័ន្ធ ។
មានភោជនីយដា្ឋនស៊ូស៊ីជប៉ុននៅជាន់ផ្ទាល់ដី ។
មានម៉ាស៊ីនលក់អាហារនៅកន្លែងទទួលភ្ញៀវក្នុងសណ្ឋាគារ ។
យើងសង្ឃឹមលើនាង ។
បានលោក ។ យើងមានបន្ទប់សម្រាប់លោក ។
នេះជាសារសម្រាប់អ្នក ។
គាត់ចង់ឲ្យអ្នកទូរស័ព្ទទៅវិញកាន់តែឆាប់កាន់តែល្អ ។
នេះជាវត្ថុអ្វី ?
នេះសម្រាប់សេវាកម្មបង់ប្រាក់ ។
នេះជាការប្រកាសពន្ធគយ ។
តើថ្ងៃចេញដំណើរនៅថ្ងៃណា ?
ថ្ងៃទីដប់បួន ខែកក្កដា ។
ការកក់របស់អ្នកត្រូវបានបញ្ជាក់ ។
សាច់គោ ឬត្រីសម្រាប់អាហារពេលយប់ ?
សូមថ្នាំសម្រាប់ពុលលើយន្តហោះ ។
មិត្តរបស់ខ្ញុំ និងខ្ញុំ បានបែកគ្នា ។
មានអ្វីខុសនៅទីនេះ ។
នេះជាការបញ្ជាក់របស់ខ្ញុំ ។
សូមផ្តល់នូវការបញ្ជាក់មួយចំនួន ។
សូមយកអាតូចផងដែរ ។
ខ្ញុំប្រាកដ ខ្ញុំបានកក់ ។
