អោយខ្ញុំសុំមួយមុខបីមក
តើអ្នកនាងត្រូវការមើលរបស់អីផ្សេងទៀតដែរទេ ?
តើខ្ញុំអាចស្លៀកលសំពត់នេះបានទេ ?
ពិតណាស់ ។ ចាំខ្ញុំដាក់វានៅក្នុងបន្ទប់ផ្លាស់សម្លៀកបំពាក់ជូនអ្នកនាង ។
ខ្ញុំចូលចិត្តអាមួយនេះ ។ ប៉ុន្តែវាធំពេក ។
ខ្ញុំចូលចិត្តវាខ្លាំងណាស់ ប៉ុន្តែដៃអាវធំពេកសម្រាប់ខ្ញុំ ។
អាហ្នឹងអាចកែសេរ៉េបាន ។
តើវាថ្លៃប៉ុន្មានដែរ ?
កាត់ដៃអាវអោយខ្លីអស់ថ្លៃដប់ប្រាំដុល្លារ ។
តើចំណាយពេលយូរប៉ុណ្ណាដែរ ?
យើងអាចធ្វើវាអោយរួចរាល់សម្រាប់អ្នកនាងក្នុងពេលពីរថ្ងៃ ។
ខ្ញុំចូលចិត្តម៉ូតនេះ ។
តើអ្នកមានម៉ូតនេះពណ៌ខ្មៅដែរទេ ?
ខ្ញុំចង់ដឹងថាតើអាចអោយគេដឹកចានឈុតនេះទៅទីក្រុងតូក្យូបានឬអត់ ?
សូមប្រាប់ខ្ញុំមកថាអស់ថ្លៃប៉ុន្មានដែរ ។
នៅមានទៀត តើយកវាទៅដាក់ដល់ផ្ទះខ្ញុំប្រើពេលយូរប៉ុណ្ណាដែរ ?
យើងអាចផ្ញើវាតាមផ្លូវអាកាសក្នុងតម្លៃហុកសិបប្រាំដុល្លារ ។
វាប្រើពេលពីរអាទិត្យសម្រាប់ការយកទៅជូន ។
ឬយើងអាចផ្ញើវាតាមផ្លូវទឹកក្នុងតម្លៃសាមសិបហើយវាប្រើពេលប្រាំមួយសប្ដាហ៌ ។
សូមផ្ញើវាតាមផ្លូវអាកាសចុះ ។
តើអ្នកធានាមិនអោយបែកបាក់យ៉ាងម៉េចដែរ ?
ហាងយើងខ្ញុំមានគោលការណ៍ដើម្បីធានាថាអ្នកទទួលបានទំនិញក្នុងសភាពល្អប្រសើរ ។
"ខ្មោចនៃរោងល្ខោន" បានសំដែងជូនមើលយូរមកហើយហើយល្អមើលណាស់ ។
តើអ្នកអាចធ្វើការកក់ទុកពេលល្ងាចថ្ងៃស្អែកអោយយើងផងបានទេ ?
សូមកក់ពីរកៅអីនៅក្នុងការប្រគំតន្ត្រី
ខ្ញុំត្រូវការចង់បានសំបុត្រពីរសម្រាប់"សត្វឆ្មា" ។
ខ្ញុំត្រូវការចង់ទិញយកកៅអីល្អបំផុតតាមដែលអាចទៅរួច ។
សួស្តី ។ សម្រាប់មនុស្សធំមួយ ។
តើខ្ញុំអាចសុំផែនទីបង្ហាញផ្លូវរបស់សារមន្ទីរនេះបានទេ ?
តើអ្នកដាក់តាំងពិព័រណ៍នេះយូរប៉ុនណាដែរ ?
តើខ្ញុំទៅកាន់អាគាររដ្ឋអាណាចក្រពីទីនេះដោយរបៀបណា ?
អ្នកនៅជិតបង្កើយទេ ។
តើដើរទៅប្រហែលប្រើពេលប៉ុន្មាន ?
មិនលើសពីប្រាំនាទីទេ ។
តើបញ្ជរដូរលុយនៅត្រង់ណាដែរ ?
គ្រាន់តែប្រើជណ្តើរយន្តនេះ ហើយបត់ឆ្វេងពេលអ្នកចុះពីជណ្តើរទៅដល់ហើយ ។
បាន ខ្ញុំចង់ដូរមូលប្បទានប័ត្រអ្នកដំណើរខ្លះយកសាច់ប្រាក់ ។
តើខ្ញុំអាចដូរលុយមួយរយដុល្លារបានទេ ?
តើអ្នកមានលិខិតឆ្លងដែនជាប់ខ្លួនដែរទេ ?
ខ្ញុំចង់ដូរប្រាក់យេនខ្លះយកប្រាក់ដុល្លារវិញ ។ តើបានដែរទេ ?
ប៉ុន្មានយេនដែរ ?
ប្រាំម៉ឺនយេន ។
ហាងឆេងប្ដូរប្រាក់ថ្ងៃនេះសម្រាប់ប្រាក់យេនគឺ មួយរយសាមសិបបួន យេនស្មើ មួយដុល្លារហេតុនេះវាស្មើនឹង បីរយចិតសិបបីដុល្លារ ដប់បី សេន ។
យើងកាត់យកមួយភាគរយសម្រាប់ថ្លៃឈ្នួល
សួស្តី ។ ខ្ញុំចង់ផ្ញើកញ្ចប់នេះទៅប្រទេសជប៉ុន ។
បាន ។ តើមានអ្វីដែលអាចបែកបាក់នៅក្នុងហ្នឹងទេ ?
តើអ្នកចង់ផ្ញើតាមផ្លូវអាកាសឬផ្លូវទឹក ?
តើអ្នកចង់ធានារ៉ាប់រងកញ្ចប់នេះទេ ?
តើថ្លៃដឹកជញ្ជូននិងថ្លៃធានារ៉ាប់រងប៉ុន្មានដែរ ?
ថ្លៃដឹកជញ្ជូនគឺម្ភៃប្រាំពីរដុល្លារ
នេះគឺតារាងថ្លៃធានារ៉ាប់រង ។
តម្លៃគឺអាស្រ័យលើថាតើអ្នកចង់ធានារ៉ាប់រងប៉ុន្មានដែរលើវា ។
ខ្ញុំចង់ធានារ៉ាប់រងវាក្នុងតម្លៃម្ភៃបួនដុល្លារទៅចុះ ។
នោះគឺបួនដុល្លារ និងហាសិបសេន ។
សរុបទាំងអស់សាមសិបមួយដុល្លារ និងហាសិបសេន
តើអ្នកត្រូវការអ្វីផ្សេងទៀតទេ ?
បាទ អោយតែមប្រិ៍តម្លៃម្ភៃប្រាំបួនសេនចំនួនបីមក
ថ្លៃសរុបថ្មីរបស់អ្នកគឺសាមសិបពីរដុល្លារ និងសាមសិបប្រាំពីរសេន ។
គាត់ធ្វើការនៅផ្នែកច្បាប់ពន្ធដារសាជីវកម្ម ។
អ្នកនាង Yamato កំពុងជាប់ប្រជុំរហូតដល់ម៉ោងបីរសៀលនេះ ។
តើលោកចង់ទុកសារសម្រាប់គាត់ឬទូរស័ព្ទមកវិញ ?
ខ្ញុំទុកសារសម្រាប់គាត់ចុះ ។
សូមជួយប្រកបឈ្មោះលោកអោយខ្ញុំផង ។
សួស្តី ។ តើលោកមកកាន់ទីនេះលោកដំបូងមែនទេ ?
អញ្ចឹងសូមមេត្តាបំពេញទម្រង់បែបបទនេះអោយពេញលេញតាមដែលអាចធ្វើបាន ។
សូមយកទម្រង់បែបបទទៅជាមួយទៅ ។
ហេតុអីបានមិនប្រាប់ខ្ញុំថាមានរឿងអីផង ?
ខ្ញុំឈឺក ខ្ញុំមានអារម្មណ៍អស់កំលាំងហើយខ្ញុំគិតថាខ្ញុំក្តៅខ្លួនទៀត ។
ចាំខ្ញុំមើលបំពង់កហើយវាស់កំដៅអ្នកទៅចុះ ។
តើអ្នកមានអារម្មណ៍បែបនេះយូរប៉ុនណាដែរហើយ ?
តាំងពីល្ងាចម្សិលមិញមកម៉្លេះ ។
អ្នកហើមក្រពេញសងខាងបំពង់ក ។
នោះគឺមូលហេតុដែលអ្នកពិបាកលេបនិងរាងគ្រុនក្តៅបន្តិច ។
ខ្ញុំនឹងសរសេរវេជ្ជបញ្ជាសម្រាប់ថ្នាំមួយចំនួន ។
តើខ្ញុំគួរសម្រាកលើគ្រែដែរទេ ?
ថ្ងៃនេះអ្នកគួរសម្រាកលើគ្រែហើយ ។
ហើយកុំប្រឹងធ្វើអីអោយសោះនៅពីរបីថ្ងៃបន្ទាប់នេះ ។
តើមួយថ្ងៃខ្ញុំលេបថ្នាំនេះប៉ុន្មានដងហើយប៉ុន្មានថ្ងៃដែរ ?
តើពេលកំពុងលេបថ្នាំនេះខ្ញុំគួរចៀសវាងអាហារប្រភេទណាដែរ ?
សូមចាំថាកុំផឹកស្រាអោយសោះពេលអ្នកកំពុងប្រើថ្នាំនេះ ។
មានរឿងអាក្រក់អ្វីម្យ៉ាងកើតឡើងហើយ ។
ប្រហែលកន្លះម៉ោងមុន កាបូបខ្ញុំត្រូវបានគេលួច ។
តើខ្ញុំគួរទូរស័ព្ទទៅប៉ុស្តិ៍ប៉ូលីសមួយណាអោយត្រូវកន្លែង ?
លេខរបស់ប៉ូលីសគឺ ប្រាំមួយ ប្រាំពី ប្រាំបី ប្រាំបួន មួយ ពីរ បី ។
បន្ទាប់ពីចប់សព្វគ្រប់ជាមួយប៉ូលីសហើយ សូមទូរស័ព្ទមកខ្ញុំម្តងទៀតព្រោះខ្ញុំអាចអោយអ្នកលេខដទៃទៀតដែលអ្នកត្រូវការ ។
ក្រុមហ៊ុនអាកាសចរណ៍យូណាយធីត ។
លេខជើងហោះហើរខ្ញុំគឺ UA មួយពីរសូន្យហើយពេលចេញដំណើរគឺ ម៉ោងមួយរសៀលនៅព្រលានយន្តហោះអន្តរជាតិខេនណេឌីនៅថ្ងៃទី ម្ភៃ ខែសីហា
ជើងហោះហើរអ្នកត្រូវបានបញ្ជាក់ឡើងវិញថាពិតជាត្រឹមត្រូវ ។
សូមលោកបង្ហាញខ្ញុំសំបុត្រនិងលិខិតឆ្លងដែនលោកផង ?
តើដាក់ខ្ញុំនៅកៅអីគ្មានការជក់បារីបានទេ ?
មិនអីទេ ។ នេះគឺលិខិតអនុញ្ញាត្តិឡើងយន្តហោះរបស់អ្នក ។
ច្រកទ្វារឡើងយន្តហោះគឺលេខហុកសិបបី ។
តើលោកចង់ចុះបញ្ជីកាបូបអីវ៉ាន់មួយណាដែរ ?
តែវ៉ាលីសមួយនេះទេ ។
សូមអញ្ជើញទៅកាន់ច្រកទ្វារឡើងយន្តហោះមុនម៉ោងដប់ពីរ ម្ភៃនាទីរសៀល
ខ្ញុំចង់លេងយូរតែបន្តិចទៀតទេ ។
តើពាក្យវេទមន្តអីទៅ ?
សូមទៅចុះ ខ្ញុំអាចលេងយូរតែបន្តិចទៀតទេបានទេ ?
សូមអត់ទោស តើអាចប្រាប់ខ្ញុំបានទេក្នុងបញ្ជីមុខម្ហូបនេះតើអាមួយនេះជាស្អីដែរ ?
នោះគឺម្ហូបពិសេសប្រចាំហាង ។ វាគឺសាច់ចំលកចំណិតដែលស្រូបដោយខ្លាញ់បានពីថ្លើម ។
ឯងមានលេខាស្រស់ឆើតឆាយដល់ហើយ ។
សូមនិយាយជាមួយលោកប្រធានផ្ទាល់ចុះ ។
លោកចង់ពិសារភេសជ្ជៈមុនអាហារដែរទេ ?
យើងមានទឹកផ្លែក្រូច ទឹកប៉េងប៉ោះ ទឹកក្រូចកំប៉ុង ទឹកក្រូចសេវិនអាប់ ។
អញ្ចឹងខ្ញុំសុំតែជប៉ុនខ្លះមក ។
ខ្ញុំចង់បានផ្លែឈើខ្លះផងដែរ ។
ខ្ញុំត្រូវការខ្លះដែរ ។
សាច់ចៀន ឬសម្លរការី ?
អោយខ្ញុំសុំអាហារបួសបានទេ ?
សូមហោះហើរដោយរីករាយ ។
នៅសហរដ្ឋអ្នករស់នៅឯណាដែរ ?
តើអ្នកកំពុងទៅសហរដ្ឋអាមេរិកមែនទេ ?
អ្នកចង់បានន័យថាម៉េច ? ពេលនេះអ្នកនិយាយអង់គ្លេសហើយតើ ។
អញ្ចឹងហេតុអីបានមិននិយាយថែមទៀតទៅ ?
បាន ប៉ុន្តែខ្ញុំសង្ឃឹមថាអ្នកយល់ភាសាជប៉ុនខ្លះៗដែរ ។
ខ្ញុំខ្លាចតែមានភ្លៀងទេ ។
ហេតុអីបានអ្នកមិនមកលេងជប៉ុនថ្ងៃណាមួយ ?
ផ្នែកខាងក្បាលនេះបែកខូចហើយ ។
តើថ្លៃប៉ុន្មានជាលុយយេនជប៉ុន ?
ខ្ញុំយល់តែខ្ញុំមិនអាចនិយាយបានឡើយ ។
ខ្ញុំមិនចេះពាក្យទេ ។
អូ គឺហ្នឹងហើយ ។ គឺអ្វីដែលខ្ញុំចង់ប្រាប់អ្នក ។
ពេលខ្ញុំនៅសហរដ្ឋ ខ្ញុំចង់ទៅមើលការតាំងពិព័រណ៍កំរាលធ្វើពីបំណែកក្រណាត់ដេរភ្ជាប់គ្នា ។
ខ្ញុំគិតថាវាជាការចាំបាច់ក្នុងការដោះស្រាយសំណួរពីពីទស្សនៈខុសពីនេះ ។
តើអ្នកយកលុយតាមខ្លួនមកប៉ុន្មានដែរ ?
គេជាមិត្តភក្តិទេ ។
តើអ្នកចង់ពាក់ពន្ធក្នុងការការងារនៅសហរដ្ឋដែរទេ ?
មិនអីទេ ។ សូមស្នាក់នៅទីនេះដោយរីករាយ ។
តើអ្នកមកជាក្រុមមែនទេ ?
តើអ្នកមកស្នាក់នៅទីនេះមានបំណងអីដែរ ?
តើមានស្រាអីដែរទេ ?
មានបារីអីដែរទេ ?
តើអ្នកមានស្អីគេនៅត្រង់នោះ ?
របស់ផ្ទាល់ខ្លួន ។
អំណោយអ្វីមែនទេ ?
សូមអត់ទោស តែខ្ញុំត្រូវការសាច់ប្រាក់ខ្លះ ។
មួយរយដុល្លារ ។
តើលោកចង់បានជាក្រដាស់ហាសិប ឬក្រដាស់ដប់ ?
អឺ ម្ភៃបីសន្លឹក ដប់បីសន្លឹក ប្រាំពីរសន្លឹក ។
លុយរាយខ្លះដែរទេ ?
សងលុយជំពាក់អ្នកអោយទាន់ពេលផង ។
ទៅកាន់ហ៊ីលតុនដោយតាក់ស៊ីប្រើពេលប៉ុនណាដែរ ?
ហើយថ្លៃប៉ុន្មានដែរ ?
ប្រហែលច្រើនបំផុតគឺដប់ប្រាំដុល្លារ ។
អស់ ប្រាំបួនដុល្លារ ។
មិនអីទេអញ្ចឹង ។ លោកឈ្មោះអីដែរ ?
តើនាងនឹងបើកឡានប្រភេទណាដែរ ?
ខ្ញុំបើកឡានប្រភេទតូចទៅចុះ ។
ខ្ញុំអាចសូមមើលប័ណ្ណបើកបរមានសុពលភាព និងប័ណ្ណឥណទានបានទេ ?
តើអ្នកត្រូវការការធានារ៉ាប់រងដែរឬទេ ?
តើអ្នកជាសមាជិកនៃក្លឹបជួលឡានប្រចាំរបស់យើងមែនទេ ?
ផ្លិតទឹកនេះមិនដំណើរការទេ ។
ភ្លើងខាងមុខក៏មិនឆេះដែរ ។
ម៉ាស៊ីនឡានក្តៅជ្រុលហើយ ។
ម៉ាស៊ីនឡានរលត់ហើយ ។
តើអ្នកបើកគម្របឃ្លុបឡានយ៉ាងម៉េច ?
តើអ្នកបន្ធូរហ្វ្រាំងដៃយ៉ាងម៉េច ?
កញ្ចក់ខាងក្រោយឡានស្រអាប់ណាស់ ។
កញ្ចក់ឡានប្រេះហើយ ។
យើងការនឹងគ្នានៅឆ្នាំមួយពាន់ប្រាំបួនរយចិតសិប ។
ស្វែងរកមិត្ត ។
នៅភ្លឺពេកនៅឡើយក្នុងការចូលដេក ។ យើងនៅសល់ចម្ងាយប៉ុន្មានម៉ាយទៀតត្រូវធ្វើដំណើរ ។
សូមអត់ទោស ខ្ញុំមានកក់ទុកមុនសម្រាប់មនុស្សពីរនាក់ ។
ហត្ថលេខាស្អីហ្នឹង ?
អក្សរ ខេ សម្រាប់ខាស៊ឺមិ ។
តើអ្នកត្រូវការបន្ទប់គ្រែធំសម្រាប់ពីរនាក់ ឬបន្ទប់គ្រែពីរដាច់គ្នា ?
ខ្ញុំមានកក់ទុកសម្រាប់មនុស្សម្នាក់ ។
សូមទោស ខ្ញុំរកមិនឃើញការកក់មានឈ្មោះនេះទេ ។ តើលោកមានលេខកក់ដែរទេ ?
ទេ តែខ្ញុំមានសក្ខីប័ណ្ណ ។
ខ្ញុំនឹងទៅខាងមុខ ។
តើលោកបង់ជាសាច់ប្រាក់ ឬប្រើប័ណ្ណឥណទាន ?
អត់ទោស សោរនេះបើកបន្ទប់ខ្ញុំមិនបានទេ ។
តើលោកមានមេដែកក្នុងហោប៉ៅលោកទេ ?
អូមាន ។ ខ្ញុំយកមេដែកសក្តិសិទ្ធិសម្រាប់ដាក់លើទ្វារទូរទឹកកកខ្ញុំ ។
សូមទុកវានៅក្នុងហោប៉ៅមួយទៀតចុះ ។ នេះគឺសោរថ្មីលោក ។
គ្រប់យ៉ាងគឺកខ្វក់ទាំងអស់ ។
មែនហើយលោក យើងនឹងពិនិត្យមើលរឿងនេះភ្លាម ។
សូមជួយពិនិត្យមើលការកក់ទុកខ្ញុំផង ។
លេខជើងហោះហើរគឺ ប្រំាមួយ មួយ ពីរ ទៅកាន់ក្រុងតូក្យូ ។
ខ្ញុំចង់ធ្វើជាមិត្តអ្នក ។
ខ្ញុំសូមស្រាបៀរខ្លះមក ។
ហើយ សូមអោយអាហារសម្រន់ខ្ញុំខ្លះផង ?
អូ គឺកំហុសខ្ញុំទេ ។
យ៉ាងម៉េច ? អ្នកចង់បានន័យថាម៉េច ?
អត់ទោស ប៉ុន្តែត្រូវការបន្ទប់គ្រែមួយ ។
លោកមានកក់ទុកមុនទេ ?
អត់ទោស ប៉ុន្តែខ្ញុំចង់កក់បន្ទប់គ្រែមួយទុក ។
តើខ្ញុំអាចសុំសាច់គោចៀនសម្រាប់អាហារពេលល្ងាចបានទេ ?
អត់ទោស តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវទៅកាន់កន្លែងឈ្មោះ ហ្គោលដិនហ្គេតផងបានទេ ?
ខ្ញុំចង់ស្នើសុំអ្នកទៅមើលកុនជាមួយ ។
តើលោកចង់មើលកុនមែនទេ ?
តើលោកធ្វើរឿងនោះអោយខ្ញុំបានទេ ?
អោយខ្ញុំសូមតែមប្រិ៍បានទេ ?
តើខ្ញុំអាចសូមផែនទីបានទេ ?
ត្រូវហើយ ។ ខ្ញុំចង់ទិញវត្ថុអនុស្សាវរីយ៍ខ្លះ ។ អ្នកអាចណែនាំរបស់គេនិយមទិញមួយបានទេ ?
ពិតជាបាន ។ យើងមានវត្ថុខ្ទាស់ចំណាំទំព័រសៀវភៅរបស់អាមេរិកកំណើតដើមដ៏គួរឲ្យស្រលាញ់ ។
ចាំខ្ញុំមើលសិន ។ ពួកវានេះថ្លៃ មួយដុល្លារម្ភៃប្រាំសេន ។
ខ្ញុំចង់បានម្ភៃ ។ តើមានចុះតម្លៃទេ ?
មិនអីទេ ។ ម្ភៃនេះខ្ញុំលក់អោយតែ ម្ភៃពីរដុល្លារទៅចុះដោយឥតគិតពន្ធ ។
អាកាសធាតុនេះគួរអោយចូលចិត្តណាស់ ។
តើអានេះអត់គិតពន្ធទេ ?
អត់ទោស តើអ្នកធ្វើការអីដែរ ?
ខ្ញុំជាវិស្វកររចនាសម្ព័ន្ធ ។
ខ្ញុំជាគណនេយ្យករ ។ ខ្ញុំធ្វើការអោយក្រុង ។
លេខសូន្យប៉ុន្មានខ្ទង់ ?
ទៅជួបអ្នកឥឡូវហើយ ។ ខ្ញុំរវល់ជាមួយភ្ញៀវម្នាក់សិន ។
សូមទោសរឿងនេះផង ។ ចុះពេលនេះសម្លៀកបំពាក់អីដែលអ្នកត្រូវការ ?
សម្លៀកបំពាក់នៅក្នុងបង្អួច ។
តើវាធ្វើពីអីដែរ ?
ខ្ញុំគិតថាកប្បាស ។
នេះនែ ។ តើអ្នកពាក់ខ្នាតអីដែរ ?
ខ្នាតលេខ ប្រាំពីរ ឬ ប្រាំបី ។
ខ្ញុំចង់ពាក់លសម្លៀកបំពាក់នេះសិន ។
ខ្ញុំចង់ពាក់លមួកនេះ ។
វារាងតូចចង្អៀតបន្តិចនៅជុំវិញមួយកំណត់ក្រោម ។
សម្លៀកបំពាក់ចុះល្មមយ៉ាងសមសួន ។
វារាងធំបន្តិចនៅជុំវិញមួយកំណត់ក្រោម ។
សូមធ្វើអោយដៃអាវរាងខ្លីបន្តិច ។
វានៅរាងតូចបន្តិចនៅជុំវិញស្មានៅឡើយ ។
វានៅរាងតូចបន្តិចនៅជុំវិញដៃ ។
វានៅរាងតូចបន្តិចនៅជុំវិញត្រគាក ។
វានៅរាងតូចបន្តិចនៅជុំវិញកែងដៃ ។
វានៅរាងតូចបន្តិចនៅជុំវិញក ។
សុមធ្វើអោយជាយសំពត់រាងខ្លីបន្តិចផង ។
ខ្ញុំកំពុងតែរកសម្លៀកបំពាក់ឈុតធ្វើពីឡែនគ្រើម ។ សូមប្រាប់ខ្ញុំពីខ្នាតខ្ញុំផង ។
មើលទៅអ្នកដូចជាខ្នាតសាមសិបប្រាំមួយ ។
ខ្ញុំចង់បានបី ។
ពណ៌ប្រផេះ ឬខៀវស្រស់ ?
អ្នកដូចម្តាយអ្នកណាស់ ។
ឈុតនេះធំពេកហើយ ។
ខោតឹងនៅជុំវិញចង្កេះ ។
អាវកាក់នេះធំពីខាងមុខ ។
សូមបង្រួមអាវកាក់នៅខាងក្រោយ ។
តើមានហាងទំនើបនៅទីនេះទេ ?
អ្នកបិទម៉ោងប៉ុន្មានដែរ ?
សូមស្រាស្កត់មួយដបមក ។
លោកមានអត្តសញ្ញាណប័ណ្ណទេ ?
អូ ម្ភៃបីឆ្នាំ ប៉ុន្តែហេតុអី ?
ចំពោះខ្ញុំ មើលទៅលោកមិនទាន់គ្រប់ដប់ប្រាំបីឆ្នាំទេ ។
អឺ នេះគឺលិខិតឆ្លងដែនខ្ញុំ ។
សូមទោស ។ គីកំហុសខ្ញុំ ។ តើលោកចង់បានស្រាស្កត់បែបណា ?
អត់ទោស តើលោកចង់អោយគេហៅលោកយ៉ាងម៉េច ?
សូមតុមួយសម្រាប់ពីរនាក់ ?
តើលោកអាចចាំនៅបារបានទេ ?
បាន សូមឆែកអាវធំខ្ញុំចុះ ។
បាន សូមឆែកកាបូបខ្ញុំចុះ ។
សូមតុមួយសម្រាប់គ្នាពីរនាក់ យប់នេះ ។
តុរួចរាល់ហើយលោក ។ អញ្ជើញតាមផ្លូវនេះ ។
លោកសម្រេចចិត្តថាលោកចង់ញ៉ាំអីហើយឬ ?
មែនហើយ ភរិយាខ្ញុំចង់ញ៉ាំសាច់ចៀន ។ ហើយខ្ញុំចង់ញ៉ាំសាច់ចៀម ។
អឺ មនុស្សច្រើនណាស់ចូលចិត្តសាច់ចំឡកហាងយើងណាស់ ។
វាជាសាច់គោចៀនបន្ទះល្អបំផុតហើយវាជាជំនាញរបស់ចុងភៅផង ។
បាន អញ្ចឹងយកអាហ្នឹងមក ។
លោកចង់ចំអីនបែបណាដែរ ?
បែបបារាំង កោះមួយពាន់ និងហ្វ្រូម៉ាខៀវ ។
ស្រាស្កត់ប្រភេទណាលោកត្រូវការ ?
មែនហើយ ។ អាចសុំបញ្ជីស្រាមើលផងបានទេ ?
ម៉េចក៏លោកមិនសាកស្រាមេដុករបស់យើងទៅ ? យើងនាំវាចូលផ្ទាល់តែម្តង ។
មិនអីទេ ។ យើងសាកកន្លះដបទៅចុះ ។
ហេតុអីលោកមិនមកទីក្រុងតូក្យូ ?
សូមកូលាបមួយថូមក ។
វាមានច្រមុះល្អបំផុត ។
ស្រានេះមានកេរ្តិ៍ឈ្មោះមែន ។
សំណាងអាក្រក់ ស្រាមានកេរ្តិ៍ឈ្មោះអស្ចារ្យសឹងតែជានិច្ចកាលមានតម្លៃរបស់វាជានិច្ច ។
ខ្ញុំចាស់ហើយ ។ ខ្ញុំលែងមានលទ្ធភាពផឹកស្រាថោកទៀតហើយ ។
អោយខ្ញុំមើលសិន ។ ខ្ញុំយកនំក្រែមដុតចុះ ។
ចុះចំណែកស្រីៗវិញ ?
ហើយកាហ្វេខ្លះដែរទេ ?
តើលោកខ្វល់ពីភេសជ្ជៈក្រោយអាហារពេលល្ងាចដែរ ?
យើងយកស្រាខ្លាំងនិងស្រាកូញ៉ាក់ចុះ ។
ខ្ញុំយកស្រាបែលលីលាយទឹកកកចុះ ។
ចុះចំណែកវាវិញ ?
តើខ្ញុំសូមទឹកកកជាមួយអាហារខ្ញុំបានទេ ?
សូមហុចម្រេចអោយខ្ញុំផង ។
អានោះសម្រាប់ឆ្កែខ្ញុំ ។
ខ្ញុំអាចទិញសំបុត្រពីសម្រាប់ចូលមើលការសំដែងស្តេចតោថ្ងៃសុក្រនេះបានទេ ?
ខ្ញុំខ្លាចតែលក់អស់ហើយទេ
តើអ្នកមានសំបុត្រសម្រាប់ពេលល្ងាចណាខ្លះ ?
មិនមានសម្រាប់ពេលល្ងាចទេ មានតែសម្រាប់ពេលរសៀល ។
អ្នកមានសំបុត្រសំរាប់ការសំដែងរសៀលថ្ងៃអាទិត្យទេ ?
អាចលក់អោយខ្ញុំពីរសំបុត្របានទេ ?
កៅអីមុខគេ ឬនៅលើយ៉ ?
កៅអីមុខខាងលើ ឬយ៉ខាងក្រោម ?
បាន នេះសំបុត្រលោក ។ សំបុត្រមួយថ្លៃ សាមសិប ដុល្លារ ។
អត់ទោស ខ្ញុំនៅក្នុងក្រុងនេះនាចុងសប្ដាហ៍ ។ តើមានកម្មវិធីកីឡាអីដែលខ្ញុំអាចទៅចូលរួមទេ ?
អឺ ពេលនេះចាំខ្ញុំមើលសិន ។ អូលោកសំណាងណាស់ ។ មានការប្រកួតរវាងក្រុមដត់ជើនិងចាយអិននៅពហុកីឡាដ្ឋានដត់ជើហើយអាចនឹងមានសំបុត្រសល់ផងដែរ ។
អស្ចារ្យណាស់អញ្ចឹង ។ ប៉ុន្តែតើវាថ្លៃខ្លាំងណាស់ទេ ?
តើលោកធ្វើអីខ្លះនៅចុងសប្ដាហ៍ ?
ខ្ញុំមិនធ្វើអ្វីទាំងអស់ ។
លោកចង់ទៅមើលការប្រកួតបេសបលទេ ?
មិត្តភក្តិខ្ញុំរៀបផែនការសម្រាប់ខ្ញុំ ។ យើងប្រហែលនឹងចាកចេញទៅក្រៅក្រុងផង ។
ថ្ងៃនេះជាថ្ងៃហេងរបស់ខ្ញុំ ។
សូមអត់ទោស តែខ្ញុំចង់លេងវាយកូនគោលនៅថ្ងៃចុងសប្ដាហ៍ ។ ប្រាប់ខ្ញុំបានទេថាតើអាចទៅរួចទេ ?
ពិតជាអាចលោក ។ មានវាលវាយកូនហ្គោលសាធារណៈច្រើនណាស់នៅតំបន់នេះ ។ លោកនឹងត្រូវតែកក់ទុកមុនហើយបង់ថ្លៃសម្រាប់ជួយបរិស្ថានតិចតួច ។ សូមទោសដែលសួរ តើលោកមកពីជប៉ុនមែនទេ ?
មែនហើយ ។ ខ្ញុំជាជនជាតិជប៉ុន ។
ខ្ញុំលឺថានៅប្រទេសលោកកីឡាវាយកូនហ្គោលថ្លៃខ្លាំងណាស់ ។ នៅអាមេរិក យើងមានក្លឹបជនបទដែលអ្នកត្រូវតែជាសមាជិកដើម្បីលេងបាន ។ ពេលខ្លះលោកមិនអាចចូលរួមនឹងក្លឹបបែបនោះបានទេបើទោះលោកមានលុយច្រើនក៏ដោយ ។ ប៉ុន្តែក៏នៅមានវាលវាយកូនហ្គោលសាធារណៈដែលនរណាក៏ដោយដែលអាចបង់ថ្លៃបន្តិចបន្តួចអាចលេងបាន ។ តើលោកចង់ឲ្យខ្ញុំកក់ទុកជូនលោកទេ ?
បាទ កក់ចុះ ។ នេះគឺនាមប័ណ្ណខ្ញុំ ។ នេះគឺរបៀបដែលខ្ញុំប្រកបឈ្មោះរបស់ខ្ញុំ ។
ពេលនេះយើងនឹងសម្រាកមួយភ្លែតដើម្បីផ្សព្វផ្សាយពាណិជ្ជកម្ម ។
ខ្ញុំថា អាកាសធាតុគួរឲ្យចូលចិត្ត ត្រូវដែរទេ ?
ត្រូវហើយ គួរអោយរីករាយណាស់ មែនទេ ?
មិនគួរសមទេដែលសួរមនុស្សម្នាក់ថាគេរកចំណូលបានប៉ុន្មាននោះ ។
នោះគឺសំពត់គួរអោយស្រឡាញ់ណាស់ ។
វាមានតម្លៃត្រឹមតែ ដប់ប្រាំបួនដុល្លារ កៅសិបប្រាំសេនប៉ុណ្ណោះក្នុងតម្លៃលក់បញ្ចុះថ្លៃ ។
សូមអត់ទោស តើទីធ្លាសហពន្ធនៅត្រង់ណា ?
មែនហើយ ។ អ្នកអាចដើរទៅកាន់រុក្ខវិថីលេខប្រាំ ឆ្ពោះទៅកាន់សួនច្បារសេនត្រល ។ ហើយបន្ទាប់មកបត់ស្តាំនៅលើផ្លូវលេខដប់បួន ។ លោកមិនអាចទៅហួសវាឡើយ ។
ប៉ុន្តែ ផ្លូវណាមួយឡើងទៅលើ ?
អឺ តើអ្នកទៅកាន់ទីធ្លាវ៉ាស៊ីងតោនដោយរបៀបណា ?
ខ្ញុំតាមពីក្រោយមេនាំផ្លូវក្រុមរបស់ខ្ញុំ ។
ចង់បានលុយរាយខ្លះសម្រាប់ថ្លៃឡានក្រុងទេ លោក ?
អូ គឺថា អត់ទេ អរគុណ ។ ខ្ញុំមានលុយរាយគ្រប់គ្រាន់ហើយ ។
លោកធ្វើត្រូវហើយ ។
គាត់ជាសិល្បករចោរ ។ ហេតុនេះសូមប្រយ័ត្នបន្តិច ។
បាទ អ្នកស្រី ។
ទុកអោយខ្ញុំជួយយកកាបូបលោកចុះ ។
ដូរលុយដុល្លារ ?
លោកជាមនុស្សកុហក់ ។
សូមអត់ទោស តែពោះខ្ញុំមិនស្រួលទេ ។
អោយខ្ញុំមើលបន្តិចមើល ។ ចុះបែបនេះវិញយ៉ាងម៉េចដែរ ?
ពោះខ្ញុំឈឺណាស់ ។
មានអ្វីម្យ៉ាងធំ លោកដឹងទេ ?
អ្វីម៉្យាងសម្រាប់ពោះ ។
អ្វីម៉្យាងសម្រាប់ក្បាល ។
ត្រូវហើយ សហការី ។
បាន ។ សូមដាក់លុយកាក់ថ្លៃម្ភៃប្រាំសេនចំនួនពីរកាក់ និងកាក់ប្រាំសេនមួយ ។
សួស្តី នេះគឺអៅគីកំពុងនិយាយ ។
ខ្ញុំចង់និយាយជាមួយលោកតាណាកា ។
សុមភ្ជាប់ទៅលេខបន្តបី ប្រាំបី មួយ ។
សួស្តី ។ អ្នកបានមកដល់ឧស្សាហកម្ម GW ហើយ ។ ពេលម៉ោងដំណើរការរបស់យើងគឺនៅរវាងម៉ោងប្រាំបួនព្រឹក និងប្រាំល្ងាច ។ បើសិនអ្នកដឹងលេខភ្ជាប់បន្តរបស់ភាគីដែលអ្នកកំពុងទូរស័ព្ទរក សូមចុចលេខនោះឥឡូវនេះ ។ ប្រសិនបើអ្នកហៅពីទូរស័ព្ទចុចលេខ សូមចុចឈ្មោះភាគីដែលអ្នកចង់ជួបនិយាយជាមួយ ។
ប៉ុស្តិកាតប្រាំ សំបុត្រពីរនិងកញ្ចប់មួយកញ្ចប់ ។
ទៅជប៉ុនទាំងអស់ ?
បាទ ចា៎ស ហើយទាំងអស់ផ្ញើតាមផ្លូវអាកាស ។
សម្រាប់តែមប្រិ៍ គឺដប់ប្រាំបីដុល្លារ ។ នេះគឺប្រកាសគយសម្រាប់កញ្ចប់របស់អ្នក ។
លិខិតពាណីជ្ជកម្មវែងអន្លាយដោយមិនចាំបាច់ក្នុងអាមេរិកមិនគ្រាន់តែគ្មានប្រសិទ្ធិភាពប៉ុណ្ណោះទេ ។ វាថែមទាំងឈ្លើយទៀតផង ។
ការសរសេររញ៉េរញ៉ៃគឺស្មើនឹងការគិតរញ៉េរញ៉ៃដែរ ។
ការសរសេរបានល្អគឺមិនគ្រាន់តែដឹងនូវអ្វីដែលត្រូវសរសេរប៉ុណ្ណោះទេ តែថែមទាំងដឹងនូវអ្វីដែលមិនគួរសរសេរទៀតផង ។
មែនហើយលោក ។ វេជ្ជបណ្ឌិតទៅដល់ទីនោះឆាប់ៗនេះហើយ ។
អឺ លោកមានគ្រុនក្តៅ ។ ពោះលោកវាយ៉ាងម៉េច ?
ពេលនេះហូបថ្នាំនេះសិនទៅ ។ លោកមានជម្ងឺឈឺក្រពះកំរិតស្រាល ។
តើម្រាមដៃលោកមានបញ្ហាអីដែរ ?
ខ្ញុំចង់ជួបនឹងវេជ្ជបណ្ឌិតនិយាយភាសាជប៉ុន ។
បុរសម្នាក់បានយកកាបូបលុយរបស់ខ្ញុំ ។
អោយខ្ញុំមើលសិន ។ លិខិតឆ្លងដែនខ្ញុំ មូលប្បទានប័ត្រអ្នកដំណើរខ្ញុំនិងសំបុត្រ យន្តហោះខ្ញុំ ។
អត់ទោស ខ្ញុំរកកាបូបខ្ញុំមិនឃើញទេ ។
តើវាមិនចេញមកតាមខ្សែពានបញ្ជូនរបស់ទេអី ?
ទេ ខ្ញុំរកវាមិនឃើញគ្រប់កន្លែង ។
តើខ្ញុំអាចសុំមើលកន្ទុយសំបុត្រអ្នកបានទេ ? ខ្ញុំនឹងព្យាយាមរកវាជូន ។
ខ្ញុំខ្លាចតែកាបូបលោកកំពុងនៅតាមផ្លូវទៅប្រទេសប្រេស៊ីលទេ ។
តែតើពេលនេះខ្ញុំគួរធ្វើយ៉ាងម៉េច ? ខ្ញុំនៅក្រុងញូយ៉កនេះរហូតដល់អាទិត្យក្រោយឯណោះ ។
មិនអីទេ ។ ខ្ញុំនឹងធានាអោយបានថាកាបូបអ្នកនឹងនៅទីនោះ ។
សូមធានាអោយបានណា ។
គាត់ត្រូវបានកោះហៅអោយមានមុខក្នុងតុលាការខែក្រោយនេះ ។
មិនមានអីច្រើនពេកទេ ។
គួរអោយចង់សើចមែន ។
អោយខ្ញុំបានសម្រាកបន្តិចផង ។
តើយ៉ាងម៉េចដែរ ?
របស់របរកំពុងតែតាមរកខ្ញុំ ។
ចំជាមនុស្សពូកែផ្គាប់មែន ។
គាត់ជាមនុស្សស្រួលណាស់ ។
ខ្ញុំពិបាកចិត្ ។ ហើយដាច់យ៉ៃ ។
ខ្ញុំរំភើបណាស់ ។
ខ្ញុំរន្ធត់មែនទែន ។
ខ្ញុំនឹងនឹកអ្នកមិនខាន ។
ខ្ញុំច្រណែនអ្នកណាស់ ។
តើខ្ញុំនឹងធ្វើអីទៅ ?
ខ្ញុំបានធូរចិត្តណាស់ ។
មិនដែលមានអារម្មណ៍ប្រសើរសោះ ។
ចនបក់ដៃលាដាក់ពួកយើង ។
ប្រធានាធិបតីគ្លីនតុនបក់ដៃបដិសណ្ឋារកិច្ចពួកយើង ។
បក់ដៃហៅតាក់ស៊ីអោយឈប ។ ឯងធ្វើបានទេ ?
សូមសង្ឃឹមថាមានសំណាងល្អចុះ ។
នាងទាក់ដៃជាមួយខ្ញុំ ។
អ៊ួក គាត់ធ្វើច្រមុះវែងដាក់ខ្ញុំ ។
សូមគ្រវាសភ្នែកអ្នកលើរបាយការណ៍នេះផង ។
សូមជួយមើលកាបូបខ្ញុំផងបានទេ ? ខ្ញុំត្រលប់មកវិញមួយភ្លែតទៀត ។
ចនតែងតែធ្វើភ្នែកដាក់ស្រីគ្រប់រូបដែលគេជួប ។
កុំគេចពីទំនួលខុសត្រូវរបស់អ្នក ។
វាប្រសើរបំផុតដែលបិទភ្នែកកុំធ្វើដឹងឭពីពួកគេ ។
ប្រធានខ្ញុំតែងតែបិទភ្នែកធ្វើមិនដឹងមិនលឺចំពោះកំហុសតូចតាច ។
គាត់បំបះត្រចៀកគាត់ពេលមានសម្លេងនៅខាងក្រៅ ។
ខ្ញុំនឹងខ្ទប់ត្រចៀកអ្នក ។
កូនស្រីខ្ញុំពេបមាត់ដាក់ទន្តពេទ្យ ។
នាងចំហរមាត់ភ្ញាក់ផ្អើលចំពោះព័ត៌មាន ។
ឃីធីទួញយំពេលប្ដីរបស់នាងចាកចេញ ។
ក្មេងៗកំពុងតែយំខ្សឹកខ្សួលអណ្តឺតអណ្តក់ព្រោះគេត្រូវបាន ឳពុកគេបន្ទោស ។
ណានស៊ីទួញយំយ៉ាងជូរចត់ភ្លាមៗបន្ទាប់ពីនាងជូនដំណើរមិត្តប្រុសនាងនៅព្រលានយន្តហោះ ។
ហ្វីលីសទ្រហោយំដោយសារព័ត៌មាន ។
ពេលខ្ញុំបានលឺរឿងរ៉ាវក្រៀមក្រំរបស់នា ។ ខ្ញុំឃើញខ្លួនឯងទួញយំព្រមជាមួយនាងដែរ ។
គាត់ងាកសម្លឹងនាងមួយភ្លែត ។
កុំសម្លឹងខ្ញុំបែបនោះ ។
ប្រពន្ធខ្ញុំសម្លឹងផ្តោតភ្នែកជាប់ត្មែរលើរូបសំណាក ។
កុំសម្លក់ខ្ញុំបែបនោះ ។
ដោយប្រធានចេះតែបន្តសម្លឹងជាប់ជានិច្ ។ យើងមិនអាចនិយាយគ្នាបានឡើយ ។
តើអ្នកកំពុងសើចរឿងអីហ្នឹង ?
កុំធ្វើអោយខ្ញុំសើចអី ។
អ្នកដែលសើចក្រោយគ ។ សើចសមជាងគេ ។
នាងកំពុងសើចក្អឹក ។ ផាត់ពណ៌រូបភាព ។
លោកប្រធានបានមកការិយាល័យជាមួយនិងស្នាមញញឹមដ៏ធំលើមុខរបស់គាត់ ។
គាត់ពេបមាត់ចំពោះពាក្យសំដីរបស់ខ្ញុំ ។
នាងញាក់មុខមាត់ដោយការឈឺចាប់ ។
គ្រូបង្រៀនចងចិញ្ចើមដាក់ក្មេងប្រុសដែលឡូឡា ។
កូនក្មេងធ្វើមុខមាត់ដាក់គ្នាទៅវិញទៅមក ។
