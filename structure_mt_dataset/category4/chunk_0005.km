តើថ្លៃប៉ុន្មានសម្រាប់ទៅ ថែមក្វ័រទ័រ ?
តើអ្នកអាចប្រាប់បានទេ តើប្រើសំបុត្រម៉ាស៊ីនដូចម្តេច ?
សូមប្រាប់ខ្ញុំទៅស្ថានីយកណ្តាលយ៉ាងម៉េច ។
តើឡានមួយណា ខ្ញុំអាចជិះរថភ្លើងទៅហែលថៅវ័របាន ?
តើរថភ្លើងនោះទៅថែមក្វ័រទ័រដែរទេ ?
តើឈប់នៅស្តប់បន្ទប់វេសស្មីនស្ទ័រ ?
ខ្ញុំចង់ទៅវេសស្មីនស្ទ័រ ។
ខ្ញុំខ្លាច ខ្ញុំជិះឡានខុស ។
តើច្រកចេញមួយណាដែលទៅឧទ្យាន ?
តើឡានមួយណាទៅឆាយណាថោន ?
តើឡានមកជាញឹកញាប់ដែរទេ ?
តើឡានមួយនោះទៅ ភូមិខាងជើងទេ ?
ខ្ញុំចង់ទៅឆាយណាថោន ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេ ពេលណាយើងមកដល់ទីនោះ ?
តើឡានតាមផ្លូវនេះទៅកាន់ភូមិខាងកើតមែនទេ ?
តើត្រូឡេនេះទៅភូមិខាងកើតដែរទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេ ពេលណាយើងទៅដល់ផ្លូវទី៥ ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេ ពេលណាយើងទៅដល់ចំណតខ្ញុំ ?
ខ្ញុំឈប់នៅចំណតបន្ទាប់ ។
