ខ្ញុំនឹងត្រឡប់មកវិញក្នុងពេលឆាប់ៗ នេះ ។
ខ្ញុំនឹងមិនត្រឡប់មកវិញទេ ។
វាត្រូវបានគេពន្យា ។ សូមសួរម្ដងទៀតនៅពេលក្រោយ ។
ពីនេះទៅសណ្ឋាគារចម្ងាយប៉ុន្មាន ?
ពីនេះទៅប្រាសាទត្រូវចំណាយពេលប៉ុន្មាន ?
តើអ្នកនៅអាមេរិករយៈពេលប៉ុន្មានហើយ ?
តើខ្ញុំត្រូវធ្វើដូចម្ដេចទើបអាចចំណាំគាត់បាន ?
ពីនេះទៅសណ្ឋាគារមិនជាឆ្ងាយប៉ុន្មានទេ ។
បើជិះឡានតូចត្រូវចំណាយពេលប្រហែលមួយម៉ោង ។
ខ្ញុំនៅអាមេរិកពីរឆ្នាំហើយ ។
តម្លៃប្រាំពីរដុល្លារហាសិបសេន ។
អ្នកមើលទៅដូចជាអស្ចារណាស់ ។
គាត់ពាក់អាវយឺតពណ៌បៃតង ។
តើផ្លូវមួយណាទៅស្ថានីយ៍រថភ្លើង ?
តើម្នាក់នោះជានរណា ?
តើមួយណាជាកាតាបរបស់អ្នក ?
ទៅផ្លូវខាងឆ្វេងទើបអាចទៅដល់ស្ថានីយ៍រថភ្លើង ។
ខ្ញុំចូលចិត្ដកាហ្វេជាង ។
នេះជាកាតាបរបស់ខ្ញុំ ។
ខ្ញុំផ្ដល់អនុសាសចំពោះបញ្ហានេះ ។
គាត់ជាបងប្រុសរបស់ខ្ញុំ ។
នាងជាបងស្រីរបស់ខ្ញុំ ។
ខ្ញុំនឹងទៅជួបជែម ។
ខ្ញុំជាស្រីបម្រើ ។
ប្រហែលជាអ្នកអាចនិយាយជាមួយលោកអេលីសាន់ ។
ម៉េចបានជាអ្នកធ្វើដូច្នោះ ?
ម៉េចបានជាយើងមិនបំបែកវាទៅ ?
ពីព្រោះខ្ញុំមានអារម្មណ៍មិនសូវស្រួល ។
តើអ្នកចូលចិត្ដប្រភេទអ្វី ?
តើត្រូវដាក់ការ៉េម ឬស្ករទេ ?
សូមទោស យើងអត់មានអាដូច្នោះទេ ។
តើយទៅក្រៅរកស្រាសផឹក ។
ពិតមែនហើយ ។ មុនដំបូងត្រូវសរសេរឈ្មោះរបស់អ្នកនៅទីសិន ។
សរសេរឈ្មោះប្រទេសរបស់អ្នក ។
ដាក់អាសយដ្ឋានរបស់អ្នកនៅទីនេះ ។
តើខ្ញុំអាចសុំមើលលិខិតឆ្លងដែនរបស់អ្នកបានទេ ?
នៅសណ្ឋាគារហ៊ីលតុននៃទីក្រុងបូស្ដុន ។
ខ្ញុំរកកាតាបរបស់ខ្ញុំមិនឃើញទេ ។
តើខ្ញុំអាចរាយការណ៍ពីការបាត់ឥវ៉ាន់បានទេ ?
ឡើងទៅជាន់ខាងលើត្រង់តុជីអេអិល ។
ពួកគេនឹងមើលថែអ្នក ។
ទៅមើលឥវ៉ាន់របស់អ្នកនៅក្នុងស្នាក់ការបណ្ដឹងមើស ។
ឥវ៉ាន់ដែលបានបាត់នេះសម្រាប់ផ្ញើទៅអ៊ែរឡាញយូណៃធិត ។
យើងនឹងយកឥវ៉ានទៅសណ្ឋាគាររបស់លោក ។
សុំទម្រង់សេចក្ដីថ្លែការរបស់អតិថិជនបន្ដិចបានទេ ?
នេះជាកាដូអនុស្សាវរីយ៍មិត្ដខ្ញុំឱ្យ ។
តើកន្លែងប្ដូរប្រាក់នៅទីណា ?
តើអ្នកអាចប្ដូរប្រាក់ដុល្លារមកជាប្រាក់ក្នុងតំបន់នេះបានទេ ?
តើអត្រាប្ដូរប្រាក់នៅទីនេះប៉ុន្មានដែរ ?
គ្រាន់តែជាអតិថិជនមកពីក្រៅ ។
បាទ យើងអាចប្ដូរបា្រក់បាន ។
តើបន្ទប់គ្រែពីរតម្លៃប៉ុន្មាន ?
តើមានតម្លៃសេវាអីទៀតទេ ?
ចុះបើសណ្ឋាគារនៅម្ដុំនេះដូចម្ដេចដែរ ?
ខ្ញុំសុំទោស អត់មានកន្លែងទំនេរទេ ។
ប្រាំបីដុល្លារក្នុងមួយយប់ ។
ថ្លៃសេវានឹងត្រូវគិតផ្សេង ។
គេនឹងយកថ្លៃពន្ធដប់ភាគរយ ។
ខ្ញុំបានត្រៀមបម្រុងទុកសម្រា ប់យប់នេះ ។
ខ្ញុំបានត្រៀមបម្រុងទុកសម្រាប់អាហារល្ងាចនេះ ។
នេះគឺជាការបញ្ជាក់បន្ថែម ។
តើអ្នកមានកន្លែងទំនេរទេ ?
បាទ យើងបានត្រៀមបម្រុងទុកសម្រាប់អ្នករួចរាល់ហើយ ។
សូមចុះឈ្មោះសិនទាន ។
សូមទោស យប់នេះយើងអត់មានកន្លែងទំនេរទេ ?
សូមទោស ពេញអស់ហើយ ។
តើខ្ញុំអាចផ្ញើកញ្ចប់សំបុត្រនេះនៅឯណា ?
តើខ្ញុំអាចសុំខ្ចីអង្គុលីលេខបានទេ ?
បន្ទប់អាហារធំជាងគេនៅជាន់ទៅដប់ ។
បារនៅជាន់ទីពីរ ។
វានៅខាងស្ដាំដៃត្រង់ផ្លូវកែង ។
អ្នកអាចទិញតែមប្រិយនៅក្នុងប៉ុស្ដិ៍នោះ ។
កញ្ចប់ឥវ៉ាន់អាចផ្ញើនៅទីនេះបាន ។
តើអ្នកអាចយកទឹកកកមកឱ្យខ្ញុំបន្ដិចបានទេ ?
ខ្ញុំត្រូវការកុម្ម៉ង់សាំងវិចសាច់ភ្លៅជ្រូកនិងកាហ្វេ ។
តើអ្នកអាចយកទឹកក្ដៅមកឱ្យខ្ញុំបន្ដិចបានទេ ?
តើអ្នកអាចយកស្រោមសំបុត្រនិងក្រដាសសរសេរមកឱ្យខ្ញុំបន្ដិចបានទេ ?
តើអ្នកអាចយកកន្សែងងូតទឹកមកឱ្យខ្ញុំបន្ដិចបានទេ ?
តើខ្ញុំត្រូវដាស់អ្នកនៅម៉ោងប៉ុន្មាន ?
ខ្ញុំត្រូវការកន្លែងបោកខោអាវ ។
ខ្ញុំត្រូវការបោកអាវយឺត ។
ខ្ញុំត្រូវការសំងួតអាមួយនេះ ។
តើថ្ងៃស្អែកហើយអត់ ?
តើថ្ងៃនេះហើយអត់ ?
តើរសៀលនេះហើយអត់ ?
ពីរដុល្លារសម្រាប់ខោមួយ ។
តើអ្នកចូលចិត្ដអាវយឺតវៀលក្លៀករបស់អ្នកទេ ?
ភ្លើងក្នុងបន្ទប់អត់ភ្លឺទេ ។
កាមេរ៉ារបស់ខ្ញុំភ្លេច ។
យើងនឹងឱ្យគេទៅបើកឱ្យអ្នក ។
នេះជាសោរបម្រុង ។
យើងនឹងបញ្ជូនអ្នកថែទាំទៅពិនិត្យមើល ។
បើប្ដូរបន្ទប់អ្នកថាម៉េចទេ ?
យើងនឹងបញ្ជូនគេទៅមើលការខុសត្រូវ ។
ខ្ញុំនឹងចេញនៅថ្ងៃស្អែគ ។
សូមបញ្ជូនអ្នកកាន់អីវ៉ាន់ម្នាក់ ។
តើអ្នកទុកឥវ៉ាន់ឱ្យខ្ញុំបានទេ ?
បាទ លេខបន្ទប់របស់អ្នក ?
ម៉ោងដប់មួយព្រឹក ។
ខ្ញុំនឹងបញ្ជូនឈ្នួលជញ្ជូនទៅ ។
សូមលោកចុះហត្ថលេខាលើវិក័យបត្រ ?
ពិតមែនហើយ ។ តើអ្នកមានក្រេឌីកាតប្រភេទណា ?
ទៅផ្លូវកែងវ៉ាស៊ីនតោតើត្រូវឡើងឡានក្រុងកន្លែងណា ?
ទៅម៉ៃមីតម្លៃប៉ុន្មាន ?
ទៅសិនត្រលផាកមានភ្លើងស្ដុបប៉ុន្មាន ?
ខ្ញុំត្រូវការសំបុត្រដើរលេងជុំវិញ ។
ឡានក្រុងនឹងឈប់នៅកន្លែងនោះ ។
អ្នកត្រូវប្ដូរជើងឡាននៅម៉ាឃិតស្រ្ទីត ។
អ្នកគួរតែចុះនៅម៉ាឃិតផ្លេស ។
តម្លៃចិតសិបប្រាំសេន ។
មានភ្លើងស្ដុបប្រាំ ។
តើអ្នកអាចជូនខ្ញុំទៅសណ្ឋាគារផ្លាសាបានទេ ?
អ្នកប្រញ៉ាប់បន្ដិចបានទេ ?
តើអ្នកចាំនៅទីនេះដប់នាទីបានទេ ?
តើអ្នកអាចជូនខ្ញុំទៅអាកាសយានដ្ឋានបានទេ ?
ពិតមែនហើយនៅបន្ទាប់ពីអគារនេះ ។
ពេលអ្នកឃើញ គ្រាន់តែបក់ដៃក៏បានហើយ ។
ក្រុមទីមួយអ្នកដើរកម្សាន្ដទៅវ៉ាស៊ីនតោសូមអញ្ជើញ ។
ខ្ញុំចង់កក់កៅអីមួយទៅបូស្ដុន ។
ខ្ញុំសូមទោស ពេញអស់ទៅហើយ ។
អ្នកអាចប្ដូរទៅជើងក្រោយ ។
ខ្ញុំចង់ដើរកម្សាន្ដដោយការជិះទូក ។
តើបានត្រៀមទុកមុនហើយឬនៅ ?
ខ្ញុំចង់ដើរកម្សាន្ដតាមដងទន្លេ ។
ខ្ញុំចង់ទៅកន្លែងចតនាវាកម្សាន្ដ ។
ទៅអៅហូចម្ងាយប៉ុន្មាន ?
ទេ កន្លែងអង្គុយទាំងអស់មិនបានត្រៀមទុកទេ ។
ត្រូវចំណាយពេលប្រហែលមួយម៉ោង ។
កប៉ាល់ចេញដំណើរនៅម៉ោងដប់ព្រឹក ។
យើងនឹងឈប់នៅទីនេះកន្លះម៉ោង ។
ខ្ញុំចូលចិត្ដមើលឡាន ។
ខ្ញុំចង់ជួលឡានប្រាំថ្ងៃ ។
ខ្ញុំនឹងទុកឡាននៅព្រលានយន្ដហោះសាន់ហ្វ្រាន់ស៊ីស្កូ ។
តើអ្នកចង់បានម៉ូដែលប្រភេទណា ?
សែសិបដុល្លារក្នុងមួយថ្ងៃ ។
បីសេនក្នុងមួយម៉ាយល៍ ។
ទេ ។ ឡានរបស់យើងទាំងអស់បង់ពន្ធតិច ។
សូមចាក់សាំងឱ្យពេញវិញផងពេលលងឡានវិញ ។
តើមានស្ថានីយ៍រថភ្លើងនៅជិតនេះទេ ?
តើមានភោជនីយដ្ឋានល្អៗ នៅជិតនេះទេ ?
តើមានកន្លែងចតនៅជិតនេះទេ ?
តើមានក្លឹបឌីស្កូនៅជិតនេះទេ ?
ឥឡូវនេះអ្នកកំពុងនៅលើផ្លូវលេខម្ភៃមួយ ។
ផ្លូវនេះនៅខាងជើង ។
ផ្លូវនេះត្រង់ទៅស្ថានីយ៍រថភ្លើង ។
តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវទៅសួនច្បារបានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវទៅស្ថានីយ៍រថភ្លើងបានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវរោងកុនបានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវទៅការិយាល័យប្រិយសនីយ៍បានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវទៅសារៈមន្ទីរសិល្បៈបានទេ ?
តើអ្នកអាចប្រាប់ខ្ញុំផ្លូវទៅមន្ទីរពេទ្យបានទេ ?
បើដើរត្រូវចំណាយពេលដប់នាទីមែនទេ ?
ខ្ញុំក៏មានអារម្មណ៍នៅទីនេះចម្លែកដែរ ។
ទៅតាមផ្លូវនេះ ។
វានៅត្រង់ភ្លើងស្ដុបទីមួយ ។
អ្នកនឹងឃើញវានៅខាងឆ្វេង ។
វានៅផ្លូវកែងទីពីរ ។
អ្នកមិនអាចដើរទៅបានទេ ។ វាឆ្ងាយណាស់ ។
តើអ្នកអាចប្រាប់ខ្ញុំអំពីកន្លែងដែលគួរឱ្យចាប់អារម្មណ៍បានទេ ?
តើអ្នកអាចណែនាំកន្លែងល្អៗ សម្រាប់ដើរកម្សាន្ដបានទេ ?
តើអ្នកមានមគ្គទេសន៍និយាយភាសាជប៉ុនដែរឬទេ ?
យើងមានដំណើរកម្សាន្ដល្អៗ សម្រាប់អ្នក ។
បាទ ។ យើងមានម្នាក់និយាយជប៉ុន ។
ចុះអំពីដំណើរកម្សាន្ដនេះ ?
កន្លែងនេះល្អណាស់ ។
នេះជាសៀវភៅបញ្ជីរដំណើរកម្សាន្ដរបស់ពួកយើង ។
តើខ្ញុំអាចមើលការផ្លាស់ប្ដូរអ្នកយាមថ្ងៃនេះបានទេ ?
ខ្ញុំចង់ទៅសួនប្រូឃ្លីនបុតានីកាល់ ។
ខ្ញុំត្រូវបារីរូបសេះ ។
បាទ យើងអាចរៀបចំចំពោះអ្នក ។
អ្នកអាចទៅទីនោះដោយជិះឡានក្រុង ។
បាទ វាត្រូវបានគេបើកនៅថ្ងៃនេះ ។
បាទ អ្នកអាចមើលវា ។
ខ្ញុំត្រូវការត្រៀមកន្លែងអង្គុយសម្រាប់យប់នេះ ។
តើតម្លៃកន្លែងអង្គុយប៉ុន្មានដែរ ?
ខ្ញុំត្រូវការត្រៀមកន្លែងអង្គុយសម្រាប់ព្រឹកថ្ងៃអង្គារនេះ ។
ខ្ញុំត្រូវការត្រៀមកន្លែងអង្គុយសម្រាប់ល្ងាចថ្ងៃសុក្រនេះ ។
មាននៅសល់តែពីរបីកន្លែងតែប៉ុណ្ណោះ ។
មួយហុកសិបប្រាំដុល្លារ ។
វានឹងរត់រហូតដល់ថ្ងៃសុក្រក្រោយ ។
ទេ ។ តែខ្លួនធម្មតាក៏បានហើយ ។
តើខ្ញុំអាចទៅក្រៅហើយមកវិញបន្ដិចទៀតបានទេ ?
អ្នកអាចយកតុមកប្រើបាន ។
បាទ ប៉ុន្ដែកុំធ្វើឱ្យបាត់សំបុត្រណា ។
នឹងចាប់ផ្ដើមនៅម៉ោងពីររសៀល ។
តើខ្ញុំអាចទៅរាំនៅកន្លែងណាខ្លះ ?
តើយប់នេះគេលេងល្ខោនអូពែរ៉ាអ្វី ?
តើអ្នកឃើញអាមួយដែលនៅលើទួលកាណេគីដែរឬទេ ?
មានកន្លែងរាំឌីស្កូមួយកន្លែងនៅក្នុងក្រុងនេះ ។
ការសម្ដែងលើកបន្ទាប់នឹងចាប់ផ្ដើមក្នុងពេលម្ភៃនាទីទៀត ។
វានឹងត្រូវបើកនៅម៉ោងប្រាំបីយប់ ។
តើខ្ញុំអាចថតជាវីឌីអូនៅទីនោះបានទេ ?
តើខ្ញុំអាចសុំរ៉ូលភាពយន្ដនោះបានទេ ?
ខ្ញុំនឹងផ្ញើរូបចម្លងទៅឱ្យអ្នក ។
សូមសួរអ្នកផ្សេង ។
ខ្ញុំទន្ទឹងរងចាំវា ។
វានឹងត្រូវបានគេធ្វើនៅល្ងាចថ្ងៃស្អែក ។
បាទ មានច្រើនប្រភេទណាស់ ។
ទេ ។ អាហារមិនរាប់បញ្ចូលទេ ។
វាមានកម្ពស់ពីរពាន់បួនរយម៉ែត្រ ។
វាមានអាយុពីររយឆ្នាំ ។
តើអ្នកអាចបង្ហាញវាឱ្យខ្ញុំឃើញបានទេ ?
តើអ្នកមានទឹកអប់ទេ ?
ខ្ញុំចង់ទិញអាវយឺតមួយ ។
ខ្ញុំចង់មើលអាមួយដែលនៅលើបង្អូច ។
ខ្ញុំចង់ទិញវត្ថុអនុស្សាវរីយ៍ ។
ខ្ញុំចង់ទិញកាដូសម្រាប់ក្មេងស្រីអាយុប្រាំឆ្នាំ ។
បាទ ។ តើអ្នកកំពុងរកមើលអ្វីមួយមែនទេ ?
ខ្ញុំកំពុងរកមើលអ្វីមួយសម្រាប់គ្រួសារខ្ញុំ ។
ខ្ញុំកំពុងរកមើលពោងហែលទឹក ។
ខ្ញុំកំពុងរកមើលស្បែកជើងមួយគូ ។
ខ្ញុំកំពុងរកមើលអាវយឺតសម្រាប់ក្មេងប្រុសអាយុដប់ឆ្នាំ ។
តើអ្នកមានម៉ាកផ្សេងទេ ?
តើអ្នកមានពណ៌ផ្សេងៗ ទេ ?
តើអ្នកមានអាតម្លៃក្រោមប្រំាបីដុល្លារទេ ?
អ្នកអាចរកបាននៅជាន់ទីដប់ ។
បាទពិតមែនហើយ ។ សុំចាំមួយភ្លែត ។
សូមទោស ។ ទាំងអស់នេះយើងមាន ។
អាមួយនេះវែងបន្ដិចសម្រាប់ខ្ញុំ ។
ពិតមែនហើយ ។ សូមអញ្ជើញទៅតាមផ្លូវនេះ ។
អាមួយនេះល្មមសម្រាប់អ្នក ។
សរុបទាំងអស់នេះប៉ុន្មាន ?
វាតម្លៃហាសិបដុល្លាររាប់បញ្ចូលទាំងពន្ធ ។
ខ្ញុំសូមទោស ។ ខ្ញុំមិនអាចបញ្ចុះតម្លៃបានទេ ។
ខ្ញុំនឹងបញ្ចុះតម្លៃសម្រាប់អ្នក ។
ចុះអំពីតម្លៃនេះ ?
បាទ យើងព្រមឱ្យពិនិត្យការធ្វើដំណើរ ។
អ្នកអាចចាយដោយប្រើវីសាឬម៉ាស្ទើកាត ។
សូមទៅគិតលុយនៅតុខាងនោះ ។
តើអ្នកអាចដូរអាមួយនេះចេញបានទេ ?
តើអ្នកអាចធ្វើឱ្យលឿនបន្ដិចបានទេ ?
ខ្ញុំគិតថាការផ្លាស់ប្ដូរនេះខ្លីណាស់ ។
តើមិនមានកំហុសក្នុងវិក័យបត្រគាត់ទេមែនទេ ?
ខ្ញុំភ្លេចឱ្យបា្រក់ដូរមកខ្ញុំ ។
ខ្ញុំខ្លាចតែយើងមិនអាចធ្វើបាន ។
អូ ពិតមែនឬ ? ខ្ញុំពិនិត្យមើលបន្ដិចមើស ។
ខ្ញុំគិតថាត្រឹមត្រូវហើយ ។
តើអ្នកមានប្រភេទជប់លៀងកណ្ដាលថ្ងៃទេ ?
ពិតមែនហើយ ។ តើអ្នកចង់ញ៉ាំអ្វី ?
ចាំខ្ញុំបង្ហាញបញ្ជីរឈ្មោះស្រាដល់អ្នក ។
នេះជាហ្គ្រីលដូវើសូលពិសេសរបស់ពួកយើង ។
បាន នេះគឺជាមេចុងភៅពិសេសសម្រាប់ថ្ងៃនេះ ។
តើអ្នកទទួលពិនិត្យអ្នកដំណើរឬពិនិត្យក្រេឌីតកាត ?
តើមានរាប់បញ្ចូលថ្លៃសេវាទេ ?
បាទ យើងទទួលយកបានទាំងអស់ ។
បាទ រាប់បញ្ចូល ។
ចំនួននេះគឺសម្រាប់ថ្លៃស្រាពីរដប ។
ថ្លៃសេវាបញ្ចូល ។
សរុបទាំងអស់មួយរយដុល្លារ ។
តើអ្នកចង់ញ៉ាំស្រាបៀរម៉ាកអ្វី ?
តើចង់ឱ្យខ្ញុំរកអ្វីជូនអ្នក ?
តើអ្នកចង់ថែមស្រាបៀរបន្ថែមទៀតទេ ?
ចុះប្រដាប់គាស់គម្របដបកូកាកូឡា ?
យើងមានប៊ូលវីស័រ ឈ្លីត និងមីល័រ ។
ម្ហូបកុម្ម៉ង់របស់ខ្ញុំមិនទាន់បានទេ ។
អានេះឆៅខ្លាំង ។
សូមទោស ចាំខ្ញុំមើលទៀត ។
សុំទោស ។ តើអ្នកកុម្ម៉ង់អ្វី ?
យើងនឹងចម្អិនបន្ថែមទៀត ។
ចាំមួយនាទី ។ ចាំខ្ញុំមើលសិន ។
នេះប្រាក់ដូរត្រឹមត្រូវ ។
តើអ្នកអាចប្រាប់លេខទូរស័ព្ទសណ្ឋាគារផ្លាហ្សាបានទេ ?
តើសាន់ហ្វ្រាន់ស៊ីស្កូលេខកូដតំបន់ប៉ុន្មាន ?
ខ្ញុំចង់តេទៅបូស្ដុន ។
លេខរបស់សណ្ឋាគារផ្លាហ្សាគឺមួយ ពីរ បី មួយ ពីរ បី បួន ។
មានសណ្ឋាគារផ្លាស្សាពីរក្នុងសៀវភៅរាយនាម ។
លេខកូដតំបន់សាន់ហ្រ្វាន់ស៊ីស្ដូគឺបួន មួយ ប្រាំ ។
ខ្ញុំមិនអាចទទួលយកទាំងស្រុងបានទេ ។
សម្រាប់ចម្ងាយឆ្ងាយវាយលេខប្រាំបួនហើយក្រោយមកលេខទូរស័ព្ទ ។
នោះគ្រាន់តែជាលេខនៅក្នុងសៀវភៅ ។
តើអ្នកស្គាល់អាសយដ្ឋាននោះទេ ?
សួស្ដី ។ តើលោកស្មីតនៅទីនោះទេ ?
សួស្ដី ។ ខ្ញុំតានីកំពុងនិយាយ ។
លេខបន្តគឺពីរ បី បួន ។
តើខ្ញុំអាចនិយាយជាមួយលោកចនបានទេ ?
តើអ្នកអាចប្រាប់គាត់ឱ្យតេមកខ្ញុំនៅម្ដុំម៉ោងប្រាំបីបានទេ ?
តើអ្នកអាចប្រាប់នាងឱ្យតេមកខ្ញុំនៅម្ដុំម៉ោងប្រាំបីបានទេ ?
ខ្ញុំស្មីតកំពុងនិយាយ ។
ចាំមួយភ្លែត ។ ខ្ញុំរកប៊ិក ។
ខ្ញុំចង់ទូរស័ព្ទទៅកាន់ប្រទេសជប៉ុន ។
អ្នកវះកាត់លំដាប់អន្ដរជាតិ ។
ខ្ញុំចង់ហៅទូរស័ព្ទទៅមនុស្សម្នាក់ដែលគិតលុយតែនៅពេលបាននិយាយជាមួយគាត់ ។
តើអ្នកចង់តេទៅលេខណា ?
តើអ្នកចង់តេទៅអ្នកណា ?
តើតម្លៃតេប៉ុន្មាន ?
ខ្ញុំចង់ប្រើក្រេឌីកាត ។
បាទ ។ អ្នកទទួលនឹងចេញថ្លៃឱ្យ ។
វាតម្លៃដប់ប្រាំបីដុល្លារ ។
សូមទោស ។ ពួកគេមិនទទួលយកតម្លៃនេះទេ ។
តើខ្ញុំសុំលេខកាតរបស់អ្នកបានទេ ?
ថ្ងៃផុតកំណត់ថ្ងៃណា ?
សូមទោស ។ យើងមិនអាចទទួលយកកាតនោះបានទេ ។
ខ្ញុំចង់ផ្ញើរបស់នេះដោយសេវារហ័ស ។
ខ្ញុំចង់ផ្ញើរបស់នេះដោយចុះបញ្ជីប្រៃសណីយ៍ ។
ខ្ញុំចង់បញ្ជូនរបស់នេះតាមរយៈកញ្ចប់ប្រៃសណីយ៍ទៅប្រទេសជប៉ុន ។
ខ្ញុំត្រូវការតែមប្រិយមួយចំនួន ។
ខ្ញុំត្រូវការកាតប្រៃសណីយ៍ ។
ខ្ញុំត្រូវការក្រដាសសរសេរ ។
ខ្ញុំចង់បានស្រោមសំបុត្រខ្លះ ។
អ្នកអាចទៅទទួលយកតែមប្រិយនៅតុខាងនោះ ។
តើអ្នកត្រូវការទំហំប៉ុណ្ណា ?
សំបុត្រផ្ញើទៅជប៉ុនតាមរយៈយន្ដហោះត្រូវប្រើតែមប្រិយតម្លៃប៉ុន្មាន ?
កញ្ចប់ផ្ញើតាមយន្ដហោះនេះត្រូវប្រើតែមប្រិយតម្លៃប៉ុន្មាន ?
តើសំបុត្រផ្ញើលឿនបំផុតត្រូវចំណាយប្រាក់ប៉ុន្មានខ្ពស់បំផុត ?
ផ្ញើសំបុត្រតាមកប៉ាល់ត្រូវចំណាយពេលប៉ុន្មានទើបទៅដល់ ?
សំណុំរឿងត្រូវបានព្រីនទាំងអស់ ។
តើខ្ញុំត្រូវតែបំពេញទម្រង់សេចក្ដីប្រកាសពន្ធគយនេះមែនទេ ?
វាទម្ងន់ប្រហែលបីផោន ។
អ្នកត្រូវបង់ប្រាក់ហាសិបដុល្លារតាមជើងយន្ដហោះ ។
វាត្រូវចំណាយពេលបួនសប្ដាហ៍តាមជើងទឹក ។
សូមសរសេរឈ្មោះនិងអាសយដ្ឋានរបស់អ្នកនៅទីនេះ ។
មិនមានសេវាសុំបុត្រផ្ញើត្រង់ទៅប្រទេសនោះនោះទេ ។
តើអ្នកចង់ផ្ញើឱ្យទៅចុះឈ្មោះទេ ?
មិនមែនសម្រាប់ប្រទេសនោះទេ ។
តើនេះជាសំបុត្រឯកជនដែលបានដាក់ក្នុងស្រោមឬ ?
សួស្ដី ។ ខ្ញុំឈ្មោះយ៉ាម៉ាដាកំពុងនិយាយ ។ តើខ្ញុំអាចនិយាយទៅកាន់លោកវ៉ាយបានទេ ?
សូមទោស ។ គាត់ទៅក្រៅបាត់ហើយ ។
ខ្ញុំមិនសូវច្បាស់ទេ ។ ប្រហែលជាល្ងាចនេះ ។
អរគុណ ។ ខ្ញុំនឹងតេទៅគាត់វិញបន្ដិចទៀតនេះ ។
តើអ្នកអាចប្រាប់ឈ្មោះនិងលេខជើងហោះហើររបស់អ្នកបានទេ ?
ខ្ញុំឈ្មោះអ៊ីឈីរ៉ូអូគូដា លេខជើងហោះហើរគឺយូអេសូន្យសូន្យបី ។
តើកាលបរិច្ឆេទចេញដំណើរពេលណា ?
អូខេ ។ យូអេសូន្យសូន្យបីទៅឡូអាន់ចឺឡែសថ្ងៃទីដប់ខែសីហាគឺត្រូវបានបញ្ជាក់ ។
តើអ្នកអាចប្រាប់ម្ដងទៀតបានទេ ?
តើនៅឯសណ្ឋាគារមានគ្រូពេទ្យប្រចាំទេ ?
ខ្ញុំនឹងបញ្ជូនគ្រូពេទ្យទៅភ្លាម ។
ខ្ញុំនឹងពិនិត្យរកមើលឈ្មោះមន្ទីរពេទ្យដែលនៅជិតបំផុត ។
ខ្ញុំនឹងប្រាប់លេខទូរស័ព្ទមន្ទីរពេទ្យដល់អ្នក ។
ខ្ញុំនឹងទាក់ទងពេទ្យប្រចាំសណ្ឋាគារ ។
ខ្ញុំនឹងពិនិត្យមើលបញ្ជីរឈ្មោះភ្ញៀវរបស់យើង ។
ខ្ញុំនឹងរកតាក់ស៊ីសម្រាប់អ្នក ។
ឡានសង្គ្រោះបន្ទាន់កំពុងតែមក ។
ខ្ញុំត្រូវសត្វទិច ។
គាត់របួសធ្ងន់ធ្ងរ ។
ដៃរបស់គាត់បាក់ហើយ ។
គាត់ឈឺត្រង់ក្បាល ។
ខ្ញុំឈឺធ្មេញ ។
ធ្មេញខ្ញុំបាក់ ។
ខ្ញុំឈឺអញ្ចាញ ។
ខ្ញុំត្រូវការបង់រុំរបួស ។
អ្នកចាំបាច់ត្រូវទៅមន្ទីរពេទ្យ ។
ខ្ញុំត្រូវតែប្រើខ្សែស្ពាយ ។
តើអ្នកទាស់ដោយសារឃ្មុំទិចមែនទេ ?
សូមដោះខោអាវចេញ ។
ទំរេតទៅខាងនោះ ។
ខ្ញុំត្រូវការទឹកនោមដើម្បីពិនិត្យ ។
ឈប់ជក់បារីនិងឈប់ផឹកស្រា ។
ខ្ញុំចង់អោយអ្នកថតកាំរស្មីអិចរេ ។
អ្នកត្រូវសម្រាកឱ្យបានពីរបីថ្ងៃ ។
ខ្ញុំចង់ត្រឡប់ទៅវិញនៅថ្ងៃស្អែក ។
នេះជាបទបញ្ញាតិរបស់អ្នក ។
ថ្នាំបំបាត់ការឈឺចាប់ ។
តើខ្ញុំត្រូវយកចំនួនប៉ុន្មាន ?
តើក្មេងម្នាក់ត្រូវយកប៉ុន្មាន ?
យកមួយក្រោយរៀងរាល់ពេលញ៉ាំអាហារ ។
យកមួយនៅពេលចូលគេង ។
តើខ្ញុំអាចសុំច្បាប់ថតចម្លងសម្រាប់គ្រូពេទ្យរបស់ខ្ញុំនៅជប៉ុនបានទេ ?
តើអ្នកអាចបំពេញនៅក្នុងទម្រង់ធានារ៉ាប់រងនេះបានទេ ?
តើការធានារ៉ាប់រងសេវាធ្វើដំណើរល្អទេ ?
តើក្រេឌីតកាតនេះល្អទេ ?
ក្រោយពេលបង់ប្រាក់រួច យើងនឹងបំពេញទម្រង់នេះ ។
ខ្ញុំចង់តេទៅក្រុមហ៊ុនធានារ៉ាប់រង ។
ខ្ញុំភ្លេចកាតាបនៅទីនោះ ។
ខ្ញុំបានភ្លេចកាបូបយួរដៃរបស់ខ្ញុំនៅកន្លែងណាមួយ ។
ខ្ញុំភ្លេចវានៅក្នុងភោជនីយដ្ឋាន ។
វាជាកាតាបស្បែកពណ៌ខ្មៅ ។
តើអ្នកអាចជួយរកឱ្យខ្ញុំបានទេ ?
ចោរឆក់កាបូបខ្ញុំ ។
ចោរឆក់ឆក់កាបូបលុយរបស់ខ្ញុំ ។
ខ្ញុំភ្លេចកាបូបនៅទីនេះ ឥឡូវអត់ឃើញទេ ។
