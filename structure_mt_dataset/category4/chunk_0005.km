តើអ្នកបានថតយកអ្វីពីទីក្រុងត្យូតូ ?
តើអ្នកចូលចិត្តអាកាសធាតុយ៉ាងណាដែរ ?
តើអាកាសធាតុយ៉ាងដូចម្តេច ?
តើអ្នកហៅដូចម្តេចជាភាសាជប៉ុន ?
តើអ្នកបានថតយកអ្វីពីទីក្រុងត្យូតូ ?
តើពេលណារថភ្លើងនឹងមក ?
តើពេលណាអ្នកចាប់ផ្តើមធ្វើ ?
តើពេលណាអ្នកមានវា ?
ពេលណា និងកន្លែងណា ?
តើអ្នកចេញដំណើរនៅម៉ោងប៉ុន្មានដែរ ?
ពេលនេះម៉ោងដប់ហើយ ។
កន្លែងណាដែលបន្ទប់នៅជិតទីនេះ ?
ខ្ញុំមិនដឹងថាខ្ញុំត្រូវទៅណាទេ ។
តើអ្នកចូលរួមមើលទូរទស្សននេះយ៉ាងដូចម្តេច ?
តើអ្នកនិយាយដូច ហាក់ជិដូរិ ជាភាសាជប៉ុន ?
តើអ្នកនិយាយដូច ហាំមីងបឺត ជាភាសាអង់គ្លេស ?
តើទំាងអស់ថ្លៃប៉ុន្មានដែរ ?
តើអ្នកស្នាក់នៅជប៉ុន្មានរយៈពេលប៉ុន្មានថ្ងៃដែរ ?
តើចម្ងាយប៉ុន្មានទៅទីនោះ ?
តើយើងគួរត្រៀមខ្លួនឱ្យហើយជាស្រេចមែនទេ ?
តើប៉ុន្មានដងដែលរថភ្លើងនឹងមកដល់ ?
រថភ្លើងមកក្នុងរយៈពេលដប់ប្រាំនាទីម្តង ។
តើអ្នកចូលចិត្តទៅមួយកន្លែងមួយណា រវាង តូក្យូ និងក្យូតូ ?
តើរថភ្លើងមួយណាខ្ញុំគួរជិះទៅអូសាកា ?
តើផ្លូវមួយណាទៅរោងភាពយន្តអេបីស៊ី ?
តើមួយណាដែលអ្នកគិតថាជម្រើសដ៏ល្អបំផុត ?
តើប្រធានបទមួយណាអ្នកថាល្អ ?
តើអ្នកធ្វើការជាមួយនរណា ?
តើនរណាខ្ពង់ជាងរវាង យូហ្សីអូ និងម៉ាសាអូ ?
តើនរណាដែលក្មេងនេះស្រដៀង ?
តើនរណាដែលអ្នកកំពុងរងចាំ ?
ហេតុអ្វីបានជាអ្នកនិយាយអញ្ចឹង ?
ហេតុអ្វីបានជាអ្នកធ្វើវា ?
តើអ្វីដែលធ្វើឱ្យអ្នកនិយាយអញ្ចឹង ?
នេះជារបស់បន្តិចបន្តួសម្រាប់អ្នក ។
នេះជាប្រពន្ធរបស់ខ្ញុំឈ្មោះកាយូកូ ។
នេះគឺជាកន្លែងដែលយើងនឹងទៅពេលនេះ ។
នេះគឺជាផ្លូវកាត់មួយ ។
ប្រហែលជាប្រំានាទីដើរពីចំណតឡាន ។
ទៅតាមឡានតាក់ស៊ីងាយស្រួល ។
វាមានភាពគួរសមណាស់ ។
គ្រាន់តែជាការបញ្ចេញមតិយោបល់ ។
ថ្ងៃនេះមេឃស្រឡះល្អណាស់ ។
គឺមានឡាននៅចតនៅមុខផ្ទះរបស់ខ្ញុំ ។
មានរបងនៅជុំវិញសាលារបស់ខ្ញុំ ។
វាមានអ្វីដែលមិនល្អជាមួយនិងវិទ្យុរបស់ខ្ញុំ ។
នោះគឺជាឡានដែលចេញនៅម៉ោងប្រាំពីរសាបសិបនាទី ។
សំបុត្រនៅលើតុសរសេរ ។
អាកាសធាតុអាក្រក់ណាស់, មិនអីចឹង ?
វាត្រូវធ្វើការសម្អាតឡើង ។
តើថ្ងៃត្រជាក់ខ្លាំងជាងពីម្សិលមិញ, មិនអីចឹង ?
ពីមួយថ្ងៃទៅមួយទៅមួយថ្ងៃត្រជាក់ណាស់, មិនអីចឹង ?
ថ្ងៃនេះគឺជាថ្ងៃដ៏ល្អ ។
មើលទៅព្រិលធ្លាក់, មិនអីចឹង ?
ខ្យល់ចាប់ផ្តើមខ្លំាងបន្តិចម្តងៗ ។
ថ្ងៃនេះខ្យល់ខ្លំាងណាស់ ។
តើអាកាសធាតុយ៉ាងម៉េចដែរ ?
យើងត្រូវទឹកភ្លៀងបន្តិចបន្តួចកាលពីម្សិលមិញ ។
អរគុណដែលបានមកជាមួយផ្លូវដ៏វែងឆ្ងាយ ។
អរគុណសម្រាប់សន្តានចិត្តដ៏ល្អ ។
អបអរសាទរសម្រាប់ភាពជោគជ័យរបស់អ្នក ។
ខ្ញុំសង្ឃឹមថាសុខសប្បាយ ។
ដូចជាអ្នកអីចឹង ។
សុំទោសុំ, ខ្ញុំនឹងត្រឡប់មកឆាប់ៗ ។
សូមចូលរួមរំលែកទុក្ខដោយស្មោះពីខ្ញុំ ។
ល្អសម្រាប់អ្នក ។
អរគុណព្រះជាម្ចាស់សម្រាប់ថ្ងៃសុក្រ ។
ជាពិតខ្ញុំត្រូវផ្លាស់ប្ដូរ ។
ខ្ញុំមានការភ្ងាក់ផ្អើលណាស់ ។
ខ្ញុំស្តីបន្ទោសខ្លួនឯង ។
ខ្ញុំខឹងខ្លំាងណាស់អំពីរឿងនេះ ។
វាធ្វើឱ្យខ្ញុំខឹងខ្លំាងណាស់ ។
វាដំណើរការល្អណាស់ ។
អ្នកមើលទៅពូកែខាងឧបករណ៍តន្រី្ត ។
អ្នកនឹងធ្វើបានល្អនៅពេលក្រោយ ។
អ្នកមើលទៅមឹងមួនណាស់ ។
ខ្ញុំមិនចង់ជាប់ពាក្យសម្តីអ្នកទេ ។
តើអ្នកនិយាយឱ្យខ្លំាងបន្តិចបានទេ ?
សំឡេងនេះគួរចាប់អារម្មណ៍ ។
ខ្ញុំឈ្មោះ តាគុយ៉ា លីយ៉ាម៉ា ។
ខ្ញុំមិនយល់ ។ សូមនិយាយម្តងទៀត ។
ខ្ញុំមកពីទីក្រុងតូក្យូប្រទេសជប៉ុន ។
តើអ្នកអាចនិយាយមួយៗយឺតៗបានទេ ?
តើថ្លៃប៉ុន្មានបូករួមទំាងតម្លៃពន្ធ ?
ខ្ញុំចង់បានបង្កាន់ដៃ ។
ខ្ញុំមិនចឹងប្ដូរកៅអីទេ ។
តើមួយណាអ្នកចូលចិត្ត អេ ឬ ប៊ី ?
ខ្ញុំឈឺក្បាល ។ ខ្ញុំអាចសុំខ្លះបានទេ ?
ប្រាំបួនថ្ងៃ ។
ប្រហែលប្រំាបួនថ្ងៃ ។
នៅសណ្ឋាគារហាឡឺគូឡានី ។
គ្មានអ្វីទេ, កញ្ញា ។
សូមជួយជូនខ្ញុំទៅសណ្ឋាគារសេរាតោផង ។
តើនេះគឺឡានក្រុងទៅដោនថោនមែនទេ ?
តើឡានមួយណាខ្ញុំគួរជិះទៅមជ្ឈមណ្ឌលទីក្រុង ?
តើថ្លៃប៉ុន្មានពីទីនេះទៅដល់ឆាយណាថោន ?
អ្នកអាចដាក់ខ្ញុំចុះនៅសារមន្ទីជាតិបានទេ ?
សូមសំបុត្រទៅទីក្រុងញ៉ូវយ៉ក ។
ពេលណារថភ្លើងជើងបន្ទាប់ទៅទីក្រុងញ៉ូវយ៉ក ?
នេះគឺជារថភ្លើងទៅទីក្រុងញ៉ូវយ៉កមែនទេ ?
ខ្ញុំចង់កក់ទុកសម្រាប់បីយប់ ។
នេះគឺបន្ទប់លេខប្រាំពីរ អូ បី ។ ខ្ញុំមិនចង់ហៅភ្នាក់ងារបន្ទប់ ។
ខ្ញុំមិនមានការកក់ទុកទេ ។
ខ្ញុំចង់បានបន្ទប់គ្រែមួយ ។
ខ្ញុំមិនចូលចិត្តបន្ទប់គ្រែពីរ ។
ខ្ញុំមិនចូលបន្ទប់រួមទេ ។
តើលេខប៉ុន្មានសម្រាប់សេវាកម្មទូរសព្ទដាស់ ?
នៅក្នុងបន្ទប់គ្មានចានលាងមុខក្នុងបន្ទប់ខ្ញុំ ។
តើខ្ញុំអាចប្រើបន្ទប់រហូតដល់ម៉ោងពីរបានទេ ?
តើអ្នកជាមួយខ្ញុំកាន់កាបូបបានទេ ?
ខ្ញុំរកអាវចាក់សម្រាប់ពុករបស់ខ្ញុំ ។
នេះគឺតូចពេកសម្រាប់ខ្ញុំ ។
តើគួរតែទិញមួយនេះ ?
ខ្ញុំចង់ទិញមួយនេះ ។
អត់ទេ, ខ្ញុំមិនបានគិតពីវា ។
តើអ្នកអាចខ្ចប់កាដូនេះបានទេ ?
ខ្ញុំអាចដើរផ្សារសម្រាប់ទិញកាបូបបានទេ ?
សូមទុកពេលឱ្យខ្ញុំបន្តិច ។
ខ្ញុំចង់បានទឹកមួយកែវ ។
ខ្ញុំមិនចូលចិត្តទឹកទេ ។
តើអ្នកមានផែនទីក្រុងនៅតំបន់នេះទេ ?
តើអ្នកអាចណែនាំកន្លែងគួរចារម្មណ៍នៅក្នុងទីក្រុងបានទេ ?
តើនៅជិតៗនេះទេ ?
ខ្ញុំចូលចិត្ត្តផ្ញើកាតផូស្តាល់តាមយន្តហោះទៅប្រទេសជប៉ុន ។
តើចំណាយពេលប៉ុន្មានសម្រាប់កញ្ចប់នេះទៅដល់ជប៉ុនតាមយន្តហោះ ?
ខ្ញុំមិនចូលចិត្តតែមយន្តហោះសម្រាប់បិទសំបុត្រទៅជប៉ុន ។
ម្ភៃប្រាំ,ហាសិបប្រាំ, ដប់ ដប់,ហើយនៅសល់ប៉ុន្មានដូល្លារទំាងអស់ ។
តើអត្រាការប្រាក់ដូរប្រាក់ដុល្លារទៅលុយយេនយ៉ាងម៉េចដែរថ្ងៃនេះ ?
ខ្ញុំមិនចង់ដូរលុយយេនទៅជាលុយដុល្លារ ។
តើអ្នកអាចដូរមួយពាន់យេនទៅជាលុយដុល្លារ ?
តើអត្រាការប្រាក់ដូរប្រាក់ដុល្លារទៅលុយយេនយ៉ាងម៉េចដែរថ្ងៃនេះ ?
សួស្តី ។ នេះគឺលោក តាគុមិ លិយ៉ាម៉ា ។ ខ្ញុំអាចជាមួយលោកស្មីត ?
នេះគឺលោកតាគុយ៉ាមិ លីយ៉ាម៉ានិយាយ ។
តើអ្នកអាចប្រាប់គាត់ជួយទូរសព្ទមកផងបានទេ ?
បាន ។ សូមលេខទូរសព្ទរបស់អ្នកបានទេ ?
តើអ្នកអាចប្រាប់គាត់ខ្ញុំទូរសព្ទទៅ ?
ខ្ញុំអាចជួបជាមួយលោកគ្រូពេទ្យបានទេ ?
បាទ, ខ្ញមានការណាត់ជួប ។
តើអ្នកដឹងថាមានលោកគ្រូពេទ្យដែលនិយាយភាសាជប៉ុនបានទេ ?
តើអ្វីដែលមានបញ្ហា ?
ខ្ញុំឈឺក្បាលណាស់ ។
ខ្ញុំរលាក់ពន្លឺថ្ងៃ, ហើយវាឈឺខ្លំាងណាស់ ។
តើប្រភេទអាហារអ្វីដែលល្អសម្រាប់ខ្ញុំ ?
គួរបន្តទៅទៀត ។
ខ្ញុំរលាក់, វាឈឺខ្លំាងណាស់ ។
ជួយ ។ ចោរជួលក្នុងបន្ទប់របស់ខ្ញុំ ។
តើអ្នកអាចបញ្ជាក់លេខទូរសព្ទស្ថានទូតជប៉ុនបានទេ ?
លេខកៅអីរបស់អ្នកគឺសាមសិបពីរអេ ។ បន្ទាប់មកចូលទៅត្រង់ចុះនេះ ។ វាជាកៅអីជិតបង្អួច ។
តើម៉ោងប៉ុន្មានយើងទៅដល់ហូណូលូលូ ?
ម៉ោងប្រំាពីរ សាបសិននាទីអេ.អឹម., ម៉ោងនៅហូណូលូលូ ។
តើកន្លែងណាយើងគួរទៅនាពេលបច្ចុប្បន្ននេះ ?
យើងហោះហើរឆ្លងកាន់មហាសមុទ្រប៉ាស៊ីហ្វិក ។
ខ្ញុំសុំកាហ្វេពីរកែវបានទេ ?
សុំទឹកតែបីកែវ ។
សូមមេត្តាឱ្យខ្ញុំសុំកាហ្វេបានដែរទេ ?
សូមមេត្តាឱ្យខ្ញុំសុំទឹកតែបានដែរទេ ?
សូមមេត្តាឱ្យខ្ញុំសុំទឹកដោះគោបានដែរទេ ?
សូមមេត្តាឱ្យខ្ញុំសុំទឹកក្រូវបានដែរទេ ?
សូមមេត្តាឱ្យខ្ញុំសុំទឹកទំពាំាងបាយជូបានដែរឬទេ ?
ខ្ញុំសុំទឹកកូកាបានដែរទេ ?
ខ្ញុំសុំទឹកប៊ិបស៊ីបានដែរទេ ?
តើខ្ញុំសុំសា្របៀរ៍ដើមបានដែរទេ ?
តើខ្ញុំសុំស្រាវីស្គី និងសូដាបានដែរទេ ?
តើខ្ញុំអាចសុំស្រាស្គតនៅលើថ្មបានដែរទេ ?
តើអ្នកចង់ញ៉ាំទឹកដែរទេ ?
តើអ្នកចង់ញ៉ាំកាហ្វេដែរទេ ?
តើអ្នកចង់ញ៉ាំទឹកដោះគោដែរទេ ?
តើអ្នកចង់ញ៉ាំទឹកក្រូចដែរទេ ?
តើអ្នកចង់ញ៉ាំស្រាទំពាំងបាយជូដែរទេ ?
តើអ្នកញ៉ាំកូកាកូឡាទេ ?
តើអ្នកញ៉ាំប៊ិស៊ីដែរទេ ?
តើអ្នកញ៉ាំស្រាបៀរ៍ដើមដែរទេ ?
តើអ្នកញ៉ាំបៀរដែរទេ ?
តើអ្នកញ៉ាំស្រាវីស្គី និងសូដាទេ ?
តើអ្នកញ៉ាំស្រាស្គតនៅលើថ្មដែរ ?
តើអ្នកចង់ញ៉ាំសាច់គោ ឬសាច់មាន់សម្រាប់អាហារល្ងាច ?
តើអ្នកថែរក្សាកាហ្វេទេ ?
ខ្ញុំឆ្អែត, ពេលនេះ ។ ប្រសិនបើអ្នកមិនអីទេ, សូមយកពាក់កណ្តាលនៅបួនម៉ោងក្រោយ ?
ឈ្មោះសណ្ឋាគារដែលលោកទៅសម្រាកនៅយប់មិញ ។
តើខ្ញុំអាចញ៉ាំស៊ុបឱ្យបានច្រើនជាងនេះទេ ?
តើខ្ញុំអាចសុំបឺរបានទេ ?
តើខ្ញុំអាចសុំស្រាបានដែរទេ ?
តើខ្ញុំសុំឆីសបន្ថែមបានទេ ?
តើខ្ញុំសុំអំបិលច្រើនជាងនេះបន្តិចបានទេ ?
សុំទោស, ខ្ញុំអាចសុំភួយបានទេ ?
សុំទោស, ខ្ញុំអាចសុំខ្នើយបានទេ ?
សុំទោស, ខ្ញុំអាចសុំកាសស្តាប់បានទេ ?
សុំទោស, ខ្ញុំអាចសុំកញ្ចប់កាតបានទេ ?
សុំទោស, ខ្ញុំអាចសុំរូបថតប៊ូស្តាល់បានទេ ?
សុំទោស, ខ្ញុំអាចសុំទស្សនាវដ្តីជប៉ុនមានទេ ?
សុំទោស, ខ្ញុំអាចសុំលិខិតបញ្ជាក់អតិថិជនបានទេ ?
បាទ, តើអ្នកជួយពន្យល់ពីរបៀបប្រើខ្សែក្រវ៉ាត់ខ្ញុំបានទេ ?
បាទ, តើអ្នកជួយពន្យល់ពីរបៀបបើកភ្លើងបានទេ ?
បាទ, តើអ្នកជួយពន្យល់ពីរបៀបប្រើកាសទូរសព្ទបានទេ ?
តើអ្នកគួរតែមើលវា ?
នៅទីនេះត្រជាក់ណាស់ ។
នៅទីនេះកក់ក្តៅណាស់ ។
កន្លែងអង្គុយនេះមិនដំណើរការ ។
គន្លឹះនេះមិនដំណើរការ ។
ភ្លើងនេះមិនដំណើរការ ។
តើអ្នកមានថង់សម្រាប់បាត់ពុលយន្តហោះទេ ?
តើអ្នកអាចចុចខ្សែក្រវ៉ាត់របស់អ្នកហើយនឹងឈប់ជក់បារីរហូតដល់ពេលចុះបានទេ ?
អស់លោកលោកស្រី, នៅពេលនេះយើងកំពុងតែហោះហើរនៅលើនីវ៉ូទឹកពីរពាន់ប្រាំបួនរយ និងក្នុងល្បឿនពីដីមួយប្រាំរយម៉ាយក្នុងមួយម៉ោង ។ យើងទៅដល់ហូណូលូលូនៅម៉ោងមួយទៀត ។
សូមពិនិត្យកៅអីអង្គុយរបស់អ្នកទៅតាមមុខងារផ្សេងៗ ។
ខ្ញុំធ្វើដំណើរទៅទីក្រុងញ៉ូវយ៉ក ។
សម្រាប់ធ្វើជំនួញ ។ ខ្ញុំទៅទំនាក់ពីធុរកិច្ចទីនោះ ។
អត់ទេ, សូមកុំធ្វើ ។
ខ្ញុំចូលរួមនិយាយអ្នក ។ សូមអរគុណ ។
ជាសម្ពាធលើអណ្តូងរ៉ែ ។ ក្រុមហ៊ុនរបស់អ្នកល្អណាស់ ។
ខ្ញុំជាអ្នកលក់ ។
នៅសណ្ឋាគារលេស្សិងតោនក្នុងទីក្រុងញ៉ូវយ៉ក ។
ខ្ញុំមិនដឹងថាអាសយដ្ឋានរបស់ខ្ញុំនៅឡើយទេ ។ ប៉ុន្តែខ្ញុំមានគម្រោងទៅស្នាក់នៅសណ្ឋាគារក្នុងទីក្រុងសានប្រាន់ស៊ីស្គូ ។
ខ្ញុំធ្វើការនៅការិយាល័យ ។
ខ្ញុំជាបុគ្កលិកក្រុមហ៊ុន ។
យើងធ្វើដំណើរជាក្រុម ។ ដូច្នេះដំណើរត្រូវមានសំបុត្រគ្រប់គ្នា ។
តើអ្នកមានមិត្តភក្តិនៅក្នុងប្រទេសនេះទេ ?
ខ្ញុំមានមួយពាន់ដុល្លារជាលុយសុទ្ធ ។
ខ្ញុំមានមួយពាន់ដុល្លារសម្រាប់ការធ្វើដំណើរ ។
ជើងហោះហើរខ្ញុំលេខដប់ប្រំាបួន អូ បី, យូ.អេស.អ៊ែរ ។
ប្រទេសនេះ, ប៉ុន្តែរ៉ែមិនទាន់បានច្នៃ ។
ពណ៌ត្នោត ។ ឈ្មោះរបស់ខ្ញុំនៅជិតនោះ ។
វាជាខ្សែក្រវ៉ាត់ពណ៌ទឹកក្រូចជុំវិញ ។
គឺមានរូបកណ្តុរមីកីនៅលើវា ។
កន្សែងពណក្រហមមួយដែលចង់នៅជាប់ដៃ ។
តើអ្នកមានកញ្ចប់បញ្ជាក់ទេ ?
ប្រសើណាស់, យើងនឹងប្រាប់អ្នកនៅពេលយើងធ្វើបាន ។ អ្នកជួយបំពេញលិខិតបានទេ ?
ខ្ញុំបានដាក់អីវាន់ខ្ញុំនៅក្នុងកាបូប ។ តើមានមធ្យោបាយអ្នកជួយខ្ញុំរហូតកាបូបខ្ញុំមកវិញ ?
ខ្ញុំមិនយល់ភាសាអង់គ្លេសល្អទេ ។ តើមាននរណាចេះនិយាយភាសាជប៉ុនដែរទេ ?
ជាងស្មាតបានធ្វើបាត់ ។
ចំណុះត្រវបានបាត់ ។
ខ្ញុំមានអ្វីចង់បញ្ជាក់ ។ ខ្ញុំមានស្រាសាកិមកពីជប៉ុន ។ សម្រាប់មិត្តខ្ញុំ ។
តើប្រហែលតម្លៃប៉ុន្មានដែរ ?
សូមបើកកាបូបរបស់អ្នក ។ តើអាចបកសំបកវាបានទេ ?
វាជាជ្រក់ ហើយជាម្ហូបជប៉ុន ។
វាអាហារសមុទ្រ ជាម្ហូបជាប៉ុន ។
នំធ្វើពីម្សៅ ជាម្ហូបជប៉ុន ។
វាជំនួសទឹកស៊ុបសណ្តែកសៀង ជាម្ហូបជប៉ុន ។
វាគ្រប់គ្រាន់សណ្តែក ជាម្ហូបជប៉ុន ។
នេះជានំម្ស៉ោង ជាម្ហូបអាហារជប៉ុន ។
ជំនួសដោយនំបញ្ចុក ជាម្ហូបអាហារជប៉ុន ។
នេះជាអាហារសម្រន់ ជាម្ហូបជប៉ុន ។
បាទ សម្រាប់រោគជំងឺហឺត ។
បាទ សម្រាប់ជំងឺទឹកនោមផ្អែម ។
បាទ សម្រាប់បន្ថយការឡើងសម្ពាធឈាម ។
តើអ្នកអាចណែកន្លែងល្អសម្រាប់ការស្នាក់នៅ ? ខ្ញុំមិនបានកក់ទេសម្រាប់យប់នេះ ។
ខ្ញុំមិនចង់ស្នាក់នៅសណ្ឋាគាថ្នាក់មធ្យមនោះទេ ។
ខ្ញុំចង់ស្នាក់នៅកន្លែងដែលសុវត្ថិភាព ។
វាគួរតែល្អជាងនេះប្រសិនបើខ្ញុំសម្អាតទីនេះ ។
តើអ្នកអាចណែនំាសណ្ឋាគារនៅកណ្តាលទីក្រុងបានទេ ?
សូមអ្នកជួយកក់បន្ទប់សម្រាប់ខ្ញុំមួយបានទេ ?
សណ្ឋាគារលលេហ្សីងតោន មានអ្វីខ្ញុំជួយទេ ?
ខ្ញុំត្រូវការបន្ទប់សម្រាប់យប់នេះ ។
ឈ្មោះរបស់ខ្ញុំគឺតាខេហ្សិ គិតាណូ ។ ខ្ញុំជាប្រធានទៅនេះ ។
ខ្ញុំនឹងមកដល់សណ្ឋាគារនៅប្រមាណម៉ោងប្រំាមួយល្ងាច ។
តើផ្លូវនេះគឺជាផ្លូវត្រឹមត្រូវទៅសួរព័ត៌មានមែនទេ ?
តើផ្លូវនេះត្រឹមត្រូវទេទៅទីស្នាក់ការពន្ធដារ ?
តើផ្លូវនេះត្រឹមត្រូវទេទៅកន្លែងដូរលុយ ?
តើនេះផ្លូវទៅចំណតឡានចុងក្រោយមែនទេ ?
តើផ្លូវនេះត្រឹមត្រូវទេទៅកន្លែងទិញទូរសព្ទ ?
តើផ្លូវរក្ខវិថីនេះទៅដល់ទីក្រុងដែរទេ ?
តើផ្លូវមួយណាដែលមានតម្លៃថោកជាងគេ ?
ខ្ញុំមិនចូលចិត្តហាងហែលទឹកភ្លោះទេ ។
ខ្ញុំមិនចូលចិត្តហាងហែលទឹកពីរទេ ។
ខ្ញុំមិនពេញចិត្តចំពោះហាងទឹកមិនសមរម្យទេ ។
តើកន្លែងណាដែលខ្ញុំអាចជិះឡានទៅសណ្ឋាគារលេហ្សីងតោនបានទេ ?
តើអ្នកអាចដឹកពូកយើងទៅសណ្ឋាគារលេហ្សីងតោនបានទេ ?
យើងនៅទីនេះ ។ សណ្ឋាគាររបស់អ្នក ។
ដប់ដុល្លារ និងម្ភៃប្រំាសេន លោក ។
តើនោះជាលីមូហ្សីងទៅសណ្ឋាគារលេហ្សីងតោនមែនទេ ?
ប្រំាពីរដុល្លារសម្រាប់មនុស្សម្នាក់ ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេពេលណាយើងទៅដល់សណ្ឋាគារលេហ្សីងតោន ?
ឈ្មោះរបស់ខ្ញុំគិតាណូ ។ ខ្ញុំបានកក់បន្ទប់ទុក ។
សូមចាំមួយភ្លេច ។ បាទ លោកគិតាណូ បន្ទប់ភ្លោះសម្រាប់បីយប់មែនទេ ?
លេខបន្ទប់របស់លោកគឺប្រំាបួន អូ ពីរ ។
មានអ្វីមួយខុសប្រក្រតី ។ តើអ្នកអាចជួយរកឈ្មោះខ្ញុំម្តងទៀតបានទេ ?
ខ្ញុំមិនបានកក់ទុកទេ ។ តើមានបន្ទប់ទំនេរសម្រាប់យប់នេះ ?
ប៉ែតសិបដុល្លារសម្រាប់មួយយប់ ។
អត់ទេ មិនរាប់បញ្ចូលពួកគេទេ ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេបំពេញលិខិតនេះយ៉ាងណា ?
ពិតឬ ។ សូមបំពេញលិខិតនេះខាងក្រៅ និងចុះហត្ថលេខាផង ។
ខ្ញុំមិនចង់បានបន្ទប់ភ្លោះទេសម្រាប់យប់នេះ ។
ខ្ញុំមិនពេញចិត្តបន្ទប់ពីរទេសម្រាប់យប់នេះ ។
តើម៉ោងប៉ុន្មានភោជនីយដ្ឋានឈប់បម្រើការអាហារពេលល្ងាច ?
មិនចង់រំខានគាត់ ។
សូមជួយសម្អាតបន្ទប់ផង ។
តើអាងហែលទឹកបិទនៅពេលណា ?
តើហាងនៅលក់វត្ថុអនុស្សាវរីយបិទ ?
ពេលបន្ទប់ទទួលភ្ញៀវសម្រាក ?
តើកន្លែងណាជាកន្លែងញ៉ាំស្រា ?
តើផ្លូវកោងនៅកន្លែងណា ?
តើបន្ទប់លេងហ្គេមនៅកន្លែងណា ?
តើកន្លែងលក់ផ្កានៅកន្លែងណា ?
តើអ្នកលក់គ្រឿងម៉ាស៊ីននេះយ៉ាងមេចដែរ ?
តើអ្នកធ្វើការជួសជុលគ្រឿងម៉ាស៊ីននេះយ៉ាងដូចម្តេច ?
បន្ទប់លេខប្រំាបី អូ ពីរ ។ សូមជួយនាំខ្ញុំទៅហាងកាហ្វេ ។
ខ្ញុំបានហៅនំខេកពីរមួយម៉ោងមុន ។ ខ្ញុំឆ្ងល់នូវអ្វីដែលបានកើតឡើងចំពោះពួកវា ។
តើអ្នកផ្ញើអ៊ីម៉ែលនូវសំបុត្រនេះដល់ខ្ញុំបានទេ ?
ខ្ញុំមិនចង់ឱ្យអ្នកកក់អាហារនៅភោជនីយដ្ឋានសម្រាប់ខ្ញុំទេ ។
តើអ្នកជួយទូរសព្ទហៅឡានឈ្នួលឱ្យខ្ញុំបានទេ ?
តើអ្នកអាចប្ដូរភោជនីយដ្ឋានដែលកក់សម្រាប់ខ្ញុំបានទេ ?
តើអ្នកអាចលុបចោលកក់ឱ្យខ្ញុំបានទេ ?
តើនោះគឺជាវិក្ក័យបត្រប្រាក់ដុល្លារ ?
តើអ្នកជួយបោកអាវសម្រាប់ខ្ញុំល្ងាចនេះទេ ?
ខ្ញុំត្រូវការអ្នកចេះភាសាជប៉ុន និងអ្នកបើកបរឡាន ។
សម្រាប់ព្រឹកស្អែក ។
ខ្ញុំត្រូវការអ្នកបកប្រភាសា ។
ខ្ញុំអាចសុំរបាយការណ៍ម្តងទៀតបានទេ ?
តើអ្នកហៅខ្ញុំនៅនៅព្រឹកថ្ងៃស្អែកម៉ោងប្រំាពីរបានទេ ?
ខ្ញុំទៅគេង ។ ដាស់ខ្ញុំក្រោកពីរម៉ោងទៀត ។
តើខ្ញុំចាយសុទ្ធសម្រាប់ការធ្វើដំណើរបានទេ ?
ពិតឬ ។ តើអ្នកត្រូវការលុយប៉ុន្មាន ?
អ្នកចម្រៀងប្រាំបីនាក់ និងអ្នកតន្ត្រីប្រំាបីនាក់ ។
តើអ្នកចូលទៅគេហទំព័ររបស់លោក ណាកាម៉ុរ៉ាបានទេ ?
ខ្ញុំទាក់ទងទៅលោក ណាកាម៉ុរ៉ា ។
ខ្ញុំមិនចង់ទូរសព្ទទៅទីតូក្យូទេ ។ សូមភ្ជាប់ការទំនាក់ទំនង ។
ឈ្មោះរបស់អ្នកនិងលេខបន្ទប់របស់អ្នក ។
ជើងហោះហើររបស់ខ្ញុំប្ដូរ ។ ខ្ញុំមិនចង់ស្នាក់នៅបីយប់ពីរថ្ងៃនោះទេ ។
តើខ្ញុំអាចយកបន្ទប់គ្រែមួយចំនួនពីរបានទេ ?
តើអ្នកមានផែនទីនៅជុំវិញនោះទេ ?
តើអ្នកមានសៀវភៅផែនទីសម្រាប់ទីក្រុងនេះទេ ?
ខ្ញុំនឹងចាកចេញពីព្រឹកថ្ងៃស្អែក ។ តើអ្នកទទួលបានគណនីរបស់ខ្ញុំរួចហើយនៅ ពីយប់មិញ ?
ខ្ញុំមិនចង់ត្រួតចេញទេ ។ សូមជួយបញ្ចូនអ្នកបម្រើមក ។
ខ្ញុំមិនយល់ចំណុចនេះទេ ។
ការគិតលុយសម្រាប់វីស៊ីអា ។
ពេលនេះខ្ញុំយល់ ។
ខ្ញុំគិតថាមិនត្រូវ ។ ខ្ញុំមិនប្រើវីស៊ីអា ។ តើអ្នកពិនិត្យម្តងទៀតបានទេ ?
អាងហែលទឹកនេះខូច ។ វាមិនដំណើរការល្អ ។
តើអ្នកនឹងមក ហើយពិនិត្យវាពេលនេះទេ ?
វាកក់ក្តៅណាស់ ។ តើអ្នកជួសជុលម៉ាស៊ីនត្រជាក់នេះបានទេ ?
បន្ទប់ជិតខាងសំឡេងឡូឡា ។
វាត្រជាក់ណាស់ ។
ខ្ញុំទុកសោនៅក្នុងបន្ទប់ ។
ខ្ញុំបានចាក់សោទុក ។
ខ្ញុំមិនទាន់បានទទួលនូវកាបូបរបស់ខ្ញុំទេ ។
ខ្ញុំឈឺធ្ងន់ណាស់ ។ តើអ្នកហៅលោកគ្រូពេទ្យជូនខ្ញុំបានទេ ?
កាបូបរបស់ខ្ញុំត្រូវបានបាត់នៅក្នុងបន្ទប់ ។
តើអ្នកមានបន្ទប់ដែលមានផាសុកផាពដែរ ?
នៅទីនោះ ។ ខ្ញុំអាចបញ្ចូលលេខសម្ងាត់នៅក្នុងម៉ាស៊ីនបានទេ ។
តើលេខសម្ងាត់ប៉ុន្មានដែរ ?
ចិតសិបប្រាំពីរសេន ។
សូមបិតសំបុត្រដែលទៅទីក្រុងឡុនដុនផង ។
ល្អសម្រាប់រយៈពេលបីថ្ងៃ ។
សម្រាប់មួយថ្ងៃ ។
សូមទោស ។ មិនវែងប៉ុន្មានទេ ។
សុំសំបុត្រមួយជើងទៅទីក្រុងវ៉ាស៊ិនតោន ។
សូមសំបុត្រធ្វើដំណើរទៅវ៉ាស៊ីនតោន ។
ពីក្រុងសែតថោនទៅព្រលានយន្តហោះ ។
តើព្រលានយន្តហោះមួយណាដែលអ្នកចង់ទៅ ?
ខ្ញុំនឹងទៅដល់ទីនោះនៅម៉ោង៩ ។ តើអ្នកអាចប្រញាប់ប្រញាល់បន្តិចបានទេ ?
អនុញា្តតិឱ្យខ្ញុំចេញពីទីនេះ ។
តើមានកន្លែងឈប់ប៉ុន្មាននៅផ្លូវបាខឺ ?
ចំនួនដប់ប្រំាស្តប់ ។
តើកន្លែងណាដែលខ្ញុំផ្ទេរជើងហោះហើរទៅខានតឺបូរី ?
អ្នកប្ដូរនៅរថភ្លើងនៅចំណតបន្ទាប់ ។
អ្នកមិនបានប្ដូរទេ ប៉ុន្តែឡាននេះសម្រាប់ទៅថ្មនិទាន ។
ខ្ញុំមិនបានកក់កៅអីទៅសានដៃហ្គូ ។
ខ្ញុំអាចកក់កៅអីនៅថ្ងៃច័នម៉ោងពីរសាបសិបនាទី ?
តើអ្នកចង់ពិភាក្សាជាមួយសិស្សដែរទេ ?
តើខ្ញុំអាចទៅវ៉ាស៊ីនតោនដូចម្តេចថ្ងៃនេះ ?
ចំណាយពេលបួនម៉ោងសម្រាប់ទៅទីក្រុងញ៉ូវយ៉ក ជើងចុងក្រោយពីវ៉ាស៊ីតោនទៅញ៉ូវយ៉ក ។
តើតារាងធ្វើដំណើរចេញពីទីក្រុងប៉ារីសរថភ្លើងណា ?
តើច្រកមួយណាជើងហោះហើរទៅម៉ៃមី ?
តើរថភ្លើងនោះចត់នៅទីក្រុងប៉ារីស ?
វាជាបទប្បញ្ញតិមួយហាមជក់បារីនៅក្នុងឡានក្រុងលុះត្រាមានការអនុញាតិពីច្បាប់ប្រទេស និងច្បាប់រដ្ឋ ។
តើខ្ញុំអាចទិញសំបុត្រទៅដេកនៅជេនេវ៉ា ?
តើខ្ញុំអាចទិញសំបុត្រប្រញាប់ទៅជេនីវ៉ាបានទេ ?
ប្រសិនបើអ្នកជក់បារី សូមមេត្តាទៅខាងក្រោយរថយន្តកន្លែងជុំវិញរបស់អ្នក ។
គ្មានហ្សីហ្គា ឬផ្សេងបារីដែលអនុញា្តតឱ្យមាននៅក្នុងឡានក្រុងនោះទេ ។
សូមឡានប្រចាំគ្រួសារមានទ្វាបួន ។
សូមទៅចំណតឡាន ។
តើឡាននោះមានម៉ាស៊ីនកម្តៅទេ ?
តើឡាននោះមានវិទ្យុទេ ?
តើអ្នកត្រូវការពេលប៉ុន្មានដែរ ?
តើគំរូមួយណាដែលអ្នកចង់បាន ?
សូមបញ្ចូលវាដោយស្វ័យប្រវត្តិ ។
តើរថយន្តនេះមានម៉ាស៊ីនត្រជាក់ទេ ?
តើខ្ញុំអាចចាកចេញពីឡានពេលមានគ្រោះអាសន្នបានទេ ?
អាជ្ញាពេញលេញ ។
កន្លែងណាខ្ញុំគួរតែទូរសព្ទ ប្រសិនបើមានបញ្ហាអាក្រក់កើតឡើង ?
ពិតឬ ។ ខ្ញុំឃើញអ្នករៀបចំវា ។
សុំដប់ប្រាំដូល្លារ ។
ជាបុព្វលាភ ឬក៏ទៀងទាន់ ?
ហ្វ្រាំងមិនធ្វើការមិនដំណើរការ ។
ពន្លឺសេរីភាពមិនដំណើរការ ។
អ្នកគួរតែត្រួតពិនិត្យប្រេងសំាង ?
អ្នកគួរតែត្រួតនូវហ្រ្វំាងជាមុន ?
អ្នកគួរតែត្រួតនូវរ៉ាដាទ័រជាមុនសិន ?
អ្នកគួរតែត្រួតពិនិត្យសំបកកង់ជាមុន ?
ឡានរបស់ខ្ញុំខូច ។ តើអ្នកអាចមកពេលនេះហើយជួយពិនិត្យបានទេ ?
តើរថយន្តរបស់អ្នកដូចជាអ្វី ?
ឡានពណ៌ត្នោតម៉ាជីវីលេខហុកសិបបី ។
មាននរណាម្នាក់ធ្វើឱ្យកញ្ចក់ឡានខ្ញុំបែក ពេលខ្ញុំមិននៅ ។
អរគុណ ប៉ុន្តែខ្ញុំគ្រាន់តែដើរមើល ។
អរគុណ ប៉ុន្តែនេះមិនមែនអ្វីដែលខ្ញុំចង់បានទេ ។
សុំទោសដែលខ្ញុំរំខានអ្នក ។
នោះជាអ្នកចម្រៀងមែនទេ ?
បន្ទប់មកអ្នកជួយយកម៉ាស៊ីនគិតលេខមកផង ?
តើអ្នកគួរដាក់ក្នុងប្រអប់កាដូរ ? តើត្រូវបន្ថែមតម្លៃដែរឬទេ ?
បាទ ។ យើងបន្ថែមតម្លៃនៃប្រអប់នេះ ។ មួយៗតម្លៃមូយដុល្លារ ។
តើអ្នកមានឧបករណ៍ផ្សេងៗទៀតទេ ?
តើអ្នកមានសម្លៀកបំពាក់ស្ត្រីទេ ?
តើអ្នកមានទំនិញល្អៗទេ ?
តើអ្នកមានសម្ភារៈក្មេងលេងដែរទេ ?
តើអ្នកមានផលិតផលគ្រឿងសម្អាងដែរទេ ?
តើអ្នកមានវត្ថុសំខាន់ៗដែរទេ ?
តើអ្នកមានក្រដាសរឹងដែរទេ ?
តើអ្នកមានស្លាបព្រាដែរ ?
តើអ្នកមានអីវ៉ាន់ធ្វើពីស្បែកដែរទេ ?
តើអ្នកមានសម្ភារៈប្រើប្រាស់នៅក្នុងគ្រួសារទេ ?
ខ្ញុំមិនចង់ផ្ញើរបស់នេះទៅប្រទេសជប៉ុនទេ ។
យើងបិទនៅម៉ោងប្រំាល្ងាច ។
ខ្ញុំមិនដឹងថាខ្ញុំអាចស្វែងរកកន្លែងលក់សម្ភារពេញនិយមនៅទីនេះទេ ។
"ជេស" គឺមានការពេញនិយមសម្រាប់ស្ត្រី ហើយ "ប៉ូលីតីស"សម្រាប់មនុស្សប្រុស ។
តើមួយនេះយ៉ាងម៉េចដែរ ?
តើមើលទៅវាមិនឆើតឆាយពេកទេឬ ?
សូមបង្ហាញបង្ហាញខ្ញុំពណ៌ក្រហម ។
អត់ទេ ខ្ញុំមានន័យធំមួយនោះ ។
ជាពិតណាស់ ។ បន្ទប់ផ្លាស់សម្លៀកបំពាក់នៅទីនោះ ។
មើលទៅដូចមិនសមរម្យសោះមែនទេ ?
ធំពេកសម្រាប់ខ្ញុំ ។ តើំអ្នកមានទំហំតូចជាងនេះទេ ?
តូចពេកសម្រាប់ខ្ញុំ ។ តើអ្នកមានទំហំធំជាងនេះទេ ?
នៅតឹងចង្កេះបន្តិច ។
វាធូចង្កេះបន្តិច ។
តើអ្នកមានដូចគ្នាហើយពណ៌ខុសគ្នាទេ ?
សុំទោស ប៉ុន្តែពណ៌ខៀវធំបន្តិចយើងមានពណ៌តែមួយ ។
តើអ្នកមានដូនគ្នាហើយមានគំរូផ្សេងគ្នាទេ ?
តើមានអាវចាក់ពណ៌ត្នោតដែរទេ ?
អ្នកមានក្រណាក់សូត្រវែង ។
