ខ្ញុំគិតថាពុករបស់អ្នកពិតជាសប្បាយចិតណាស់ ។
រីករាយថ្ងៃខួបកំណើត ។
សូមមានសុភមង្គលគ្រប់គ្នា ។
សូមអបអរសាទរដែលបានឡើងជាអ្នកចាត់ការថ្មី ។
សូមអបអរសាទរសម្រាប់ការបញ្ចប់ការសិក្សា ។
សូមអបអរសាទរសម្រាប់ការងារថ្មី ។
សូមអបអរសាទរសម្រាប់ភាពជោគជ័យរបស់អ្នក នៅក្នុងការប្រឡង ។
សូមអបអរសាទរខួបអនុស្សាវរីយ៍លើកទី៥០របស់អ្នក ។
សូមផឹកដើម្បីតំណែងរបស់អ្នក ។
សម្រាប់អនាគត់របស់អ្នក ។
រីករាយសម្រាប់ភាពជោគជ័យរបស់អ្នក ។
សូមអបអរសាទរការប្រឡងជាប់របស់អ្នក ។
សូមអបអរសាទរសម្រាប់ខួបអាពាហ៍ពិពាហ៍អ្នកលើកទី៥០ ។
ខ្ញុំទទួលដំណឹងថាជីតារបស់ខ្ញុំមរណភាព ។
សូមអរគុណគ្រប់យ៉ាង យូមិកូ ។
តើអ្នកមានអារម្មណ៍ម៉េចដែរ ?
សូមទទួលនូវសេចក្តីរំលែកពីខ្ញុំ ។
ខ្ញុំមិនដឹងនិយាយពីអ្វីទេ ។
អូ ខ្ញុំពិតសោកស្តាយដឹងដំណឹងនេះ ។
ពិតជាពិបាកខ្លំាងណាស់ ។ ខ្ញុំអាណិតអ្នកណាស់ ។
ខ្ញុំសូមចូលរួមរំលែកទុក្ខចំពោះអ្នកផង ។
ខ្ញុំមានការអាណិតអាសូរយ៉ាងខ្លំាងចំពោះអ្នក ។
ប្រសិនមានអ្វីខ្ញុំអាចជួយអ្នកបាន ជួយប្រាប់ខ្ញុំដឹងផង ។
តើកិច្ចប្រជុំពេលក្រោយធ្វើនៅពេលណា ជេន ?
ចាប់ពីថ្ងៃទី៣០រហូតដល់ថ្ងៃទី៣ ថ្ងៃសុក្រនេះ ។
នៅថ្ងៃសុក្រក្រោយនេះ ? ដូច្នេះថ្ងៃទី៥ ខែវិច្ឆិកា មិនអញ្ចឹង ?
ពិតជាត្រឹមត្រូវណាស់ ។ ប៉ុន្តែហេតុអ្វី ?
ម៉ែនិងប្អូនស្រីខ្ញុំមកពីប្រទេសជប៉ុន ។ ពួកគេនឹងមកដល់នៅម៉ោង៧នៅល្ងាចនេះ ។
បន្ទាប់មកខ្ញុំជួបអ្នកនៅ១០នាទីទៀត ។
ខ្ញុំសួរម៉ោងអ្នកបានទេ ?
ម៉ោងប្រាំពីរ ។
ទើបតែម៉ោងប្រាំមួយ ។
ម៉ោងប្រំាកន្លះ ។
ម៉ោងប្រាំបួនខ្វះដប់ប្រាំនាទី ។
តើម៉ោងត្រឹមត្រូវប៉ុន្មានហើយ ?
តើម៉ោងរបស់អ្នកត្រឹមត្រូវទេ ?
ម៉ោងបីសាមសិបនាទី ។
តើថ្ងៃនេះទីប៉ុន្មាន ?
ថ្ងៃទី១០ ខែមិថុនា ។
ថ្ងៃទី១៥ ខែឧសភា ។
នៅខែកក្កដាថ្ងៃទី៤ ថ្ងៃឯករាជ្យរបស់ប្រទេសអាមេរិក ។
ឪពុករបស់ខ្ញុំកើតថ្ងៃទី២០ ខែកុម្ភៈ គម្រប់ទី១៤ នៃអាយុ៥០ ។
នៅព្រឹកថ្ងៃទី១០ ខែមករា មានគ្រោះថ្នាក់ចរាចរណ៍កើតឡើង ។
នាងចាកចេញពីប្រទេសជប៉ុននៅសុក្រក្រោយនេះ ។
តើពេលណាអ្នកត្រឡប់ទៅហាវ៉ៃវិញ ?
ខ្ញុំត្រឡប់ទៅក្នុងមួយអាទិត្យទៀត ។
នាងទៅក្លឹបនៅរៀងរាល់ថ្ងៃអាទិត្យ ។
ខ្ញុំសុំទោសក្នុងការសំណួរនេះ ប៉ុន្តែ តើចំណូលប្រចាំឆ្នាំអ្នកប៉ុន្មានដែរ ?
ប្រហែលបីលានយ៉េនជាង ។
តើគិតជាដូល្លារប៉ុន្មានដែរ ?
ប្រហែលជា៣០០០ដុល្លារ ក្នុងអត្រាប្ដូរប្រាក់ សម្រាប់ពីមួយដុល្លារ និងម្ភៃយ៉េន ។
ដូច្នេះ ប្រហែល២៥០០ដុល្លាររាល់ខែ ។ យើងអាចធានាថាយើងនឹងសងលុយអ្នក៣០០០ដុល្លារក្នុងមួយខែ ។ តើគិតយ៉ាងម៉េចដែរ ?
តើចំនួនប្រជាជនចិនប៉ុន្មាននាក់ដែរ ?
ប្រហែលជាមួយពាន់លាននាក់ជាង ។
ខ្ញុំមានលុយម្ភៃបួនយ៉េន ។
តើអ្នកខ្ពស់ប៉ុន្មានដែរ
ខ្ញុំមានកម្ពស់ជើងប្រំាអ៊ិង ។
មិត្តភក្តិជាចម្រើននៅប្រទេសជប៉ុន ។
មិត្តរួមថ្នាក់២៣នាក់ជាសិស្សបរទេស ។
លោកមានកម្ពស់ជាមធ្យម៣២៣ ។
គាត់បានបើកឡានហួសល្បឿនប៉ែតសិបគីឡូម៉ែត្រមួយម៉ោង ។
គាត់បើកឡានល្បឿនលឿនហួសកំណត់ប៉ែតសិបគីឡូម៉ែត្រក្នុងមួយម៉ោង ។
ថ្ងៃនេះដូចជាអាកាសធាតុល្អ ។
ពិតណាស់ ។ ប៉ុន្តែខ្យល់ដូចជាខ្លំាងបន្តិច តើគិតអ្នកយ៉ាងណា ?
ប៉ុន្តែមិនក្តៅពេកក៏ត្រជាក់ពេកទេ ។
ខ្ញុំទាយថាត្រូវហើយ ។ សូមគិតមើល ត្រជាក់ណាស់កាលពីម្សិលមិញ ។
ព្យាករណ៍ថានៅស្អែកនឹងភ្លៀងពេលយប់ ។
ខ្ញុំសង្ឃឹមថាអាកាសធាតុល្អ សម្រាប់រយៈពេលពីរបីថ្ងៃនេះ ។
អាកាសធាតុណាស់ពេលនេះ ។
ខ្ញុំគិតថាអ្នកទាយត្រូវ ។
ថ្ងៃនេះក្តៅណាស ហើយស្អុះស្អាប់ មិនអញ្ចឹង ?
បាទ តម្រូវការ ។ ខ្ញុំដេកមិនលក់ពីព្រោះក្តៅ ។
ខ្ញុំមានអារម្មណ៍ចង់ផឹកបៀរ នៅពេលអាកាសធាតុក្តៅ ។
ថ្ងៃនេះថ្ងៃដ៏ស្រស់ស្អាតសម្រាប់ថ្ងៃនេះ ។
ថ្ងៃនេះក្តៅខ្លាំងណាស់ មិនអញ្ចឹង ?
សម្អាតវាឡើង មិនអញ្ចឹង ?
ថ្ងនេះពពកច្រើនណាស់ ។
មើលទៅហាក់ដូចជាភ្លៀង មិនអញ្ចឹង ?
បាទ មិនមែនទេ ។ មេឃមើលទៅកំរាមគំហែងយើង ។
មេឃចាប់ផ្តើមធ្លាក់ហើយ ។
ភ្លៀងធ្លាក់យ៉ាងខ្លាំង មិនអញ្ចឹង ?
ភ្លៀងធ្លាក់ដូចចាក់ទឹកទំាងគ្រុស ។
ខ្ញុំគិតថាភ្លៀងនឹងរាំងពេលឆាប់ៗ ។
ខ្យល់បន្ថែមកម្លំាងខ្លំាងជាងមុន ។
ភ្លៀងធ្លាក់ទៅជាព្រិល ។
យើងមានឱកាសបានឃើញព្រិលធ្លាក់ ។
ភ្លៀងធា្លក់លាយជាមួយព្រិល ។
មានភ្លៀងធ្លាក់ប្រហែល១៥ភាគរយប៉ុណ្ណោះ ។
ថ្ងៃនេះមានភ្លៀងធ្លាក់យ៉ាងខ្លំាង មិនអញ្ចឹង ?
អាកាសធាតុមិនសូវល្អសោះ មិនអញ្ចឹង ?
បាទ ត្រជាក់ណាស់ ។
ស្អាតនិងត្រជាក់ថ្ងៃនេះ មិនអញ្ចឹង ?
ឧតុនិយមបានរាយការណ៍ថាថ្ងៃស្អែកមេខស្រឡះ ប៉ុន្តែមពពកខ្លះៗ ។
យោងទៅតាមរបាយការណ៍ឧតុនិយម នឹងមានភ្លៀងថ្ងៃស្អែក ។
មើលទៅ ព្រិលធ្លាក់ ។
ពិតឬ ? គ្មានអ្វីឆ្ងល់ទេត្រជាក់ ។
ព្រិលធ្លាក់កម្ពស់៣០សង់ទីម៉ែត្រ ។
យើងឃើញព្រិលធ្លាក់ច្រើនឆ្នាំនេះ ។
តើអាកាសធាតុនៅទីក្រុងឡូអាន់ជឺឡែសម៉េចដែរ ?
សម្លៀកបំពាក់ខ្ញុំមិនស្ងួត ដោយសាភ្លៀងធ្លាក់ ។
ថ្ងៃបានចាប់ផ្តើមរះ ធ្វើឱ្យទឹកកករលាយ ។
ខ្ញុំស្អប់រដូវភ្លៀងធ្លាក់ ។
ការព្យាករណ៍ថាមានព្យុះទីហ្វុង ។
ខ្ញុំឈឺនៅពេលអាកាសធាតុប្រែប្រួល ។
ត្រជាក់ចង់កក ។
ខ្ញុំសូរអ្នកថាតើគ្រួសាររបស់អ្នកម៉េចហើយ ?
តើគ្រួសាររបស់អ្នកជាគ្រួសារធំមែនទេ ?
ខ្ញុំមានពុកម៉ែប្អូនស្រី៣នាក់ និងបងប្អូនប្រុស២នាក់ ។
សមាជិកគ្រួសារ៨នាក់ ? រស់នៅជាមួយគ្នាក្នុងផ្ទះ ខ្ញុំគិត ។
ការពិតណាស់ បងប្អូនប្រុស និងប្អូនស្រីខ្ញុំ បានរៀបការរួចហើយ ខ្ញុំនៅតែម្នាក់ឯងនិងពុកម៉ែខ្ញុំ ។
តើបងប្រុសរបស់អ្នករៀបការហើយឬនៅ ?
តើមានមនុស្សប៉ុន្មាននាក់នៅក្នុងគ្រួសាររបស់អ្នក ?
ចំនួនបួននាក់ ។
តើអ្នកមានបងប្អូនប្រុសស្រីប៉ុន្មាននាក់ ?
អត់ទេ ខ្ញុំមិនមានបងប្រុស ឬប្អូនស្រីទេ ។
បាទ ខ្ញុំមានប្អូនប្រុសម្នាក់ ។
ខ្ញុំមានបងប្រុសបីនាក់ និងប្អូនស្រីពីរនាក់ ។
ខ្ញុំមានបងប្អូនស្រីបួននាក់ ខ្ញុំជាកូនទីបី ។
បាទ ខ្ញុំមានកូន២នាក់ កូនប្រុសអាយុយ៧ឆ្នាំ ហើយស្រីអាយុ៨ឆ្នាំម្នាក់ ។
ខ្ញុំមិនទាន់មានកូនទេ ។
តើអ្នកមានកូនប៉ុន្មាននាក់ដែរ ?
ខ្ញុំមានកូនប្រុសម្នាក់និងកូនស្រីពីរនាក់ ។
ខ្ញុំមានប្រុសម្នាក់និងស្រី២នាក់ ។
តើឪពុកម្តារបស់អ្នកសុខសប្បាយទេ ?
ពួកគាត់សុខសប្បាយទេ ។
ម៉ែរបស់ខ្ញុំជាមេផ្ទះ ។
ម៉ែរបស់ខ្ញុំគាត់ធ្វើការក្រៅម៉ោង ។
ម៉ែរបស់ខ្ញុំគាត់ធ្វើកាបណ្ណាធិការឯករាជ្យ ។
ឪពុកខ្ញុំនឹងចូលនិវត្សនៅឆ្នំានេះ ។
ឪពុកខ្ញុំធ្វើការនៅសហគ្រាសហ្វស ។
អ្នកមើលទៅហាក់ស្លេកស្លំាង ។ អ្នកមានអារម្មណ៍យ៉ាងម៉េចដែរ ?
ពេលនេះខ្ញុំមិនសូវមានសុខភាពល្អទេ ។
ខ្ញុំជាញឹកញាប់ផឹកច្រើននៅពេលជួបជុំគ្នា ។
យើងមិនមែនក្មេងអ្វីនោះទេ ដូច្នេះយើងគួរតែថែរក្សាសុខភាពរបស់យើង ។
អ្នកគួរតែពិនិត្យសុខភាព ។
ហេតុអ្វីអ្នកមិនទៅពិនិត្យសុខភាពរបស់អ្នក ?
អ្នកគួរតែទៅឲ្យគ្រូពេទ្យពិនិត្យ ។
ខ្ញុំមានការណាត់ជួបដើម្បីពិនិត្យសុខភាពពីរដងក្នុងមួយឆ្នាំ ។
ខ្ញុំមិនដែលមានឈឺមួយថ្ងៃណាសោះក្នុងជីវិតខ្ញុំ ។
រឿងល្អបំផុតដើម្បីទប់ទល់ជំងឺ ត្រូវគេងយប់ឱ្យបានគ្រប់គ្រាន់ ។
មនុស្សដែលមើលទៅមានសុខភាពល្អ ជារឿយៗតែងទេជាអ្នកដែលមានការប្រុងប្រយត្ន័ខ្ពស់ ។
ខ្ញុំអាល់ឡាក់ហ្សីជាមួយនិងលម្អងផ្កាក្នុងអំឡុងពេលនេះរៀងរាល់ឆ្នាំ ។
ខ្ញុំលេងទិន្តនីស្ត ដើម្បីរក្សារាងកាយខ្ញុំ ។
ខ្ញុំធ្វើការក្រុមហ៊ុនកាត់ដេរ ក្នុងការផ្នែកនាំចេញ ។
អញ្ចឹង អ្នកធ្វើដំណើរជាញឹកញាប់ទៅក្រៅប្រទេសដើម្បីធ្វើជីវកម្ម មិនអញ្ចឹង ?
ចៅហ្វាយខ្ញុំធ្វើដំណើរគ្រប់ពេល ។ ប៉ុន្តែខ្ញុំគ្រាន់ទៅម្តងម្តាលក្នុងការងារសំខាន់ៗ ។
ខ្ញុំជាវិស្វការផ្នែកកុំព្យូទ័រ ។
ខ្ញុំធ្វើការងារផ្ទាល់ខ្លួន ។
តើធ្វើការក្នុងបណ្តាញណាដែរ ?
តើក្រុមហ៊ុនមួយណាដែលអ្នកធ្វើការជូន ?
ខ្ញុំធ្វើការនៅក្នុងផ្នែកលក់ នៃក្រុមហ៊ុនឌុបលវេ ។
ខ្ញុំអ្នកបើកប្រាក់ខែជូនកម្មករ ។
ខ្ញុំជាអ្នកជំនួញ ។
ខ្ញុំជាអ្នកសរសេរកម្មវិធី ។
ខ្ញុំជាអ្នកបកប្រែអាជីព ។
ក្រុមហ៊ុនពាណិជ្ជកម្ម ។
យើងភាគច្រើនលក់ឧបករណ៍អគ្គិសនីនៅក្នុងគ្រួសារ ។
តើអ្នកធ្វើការងារអ្វីដែរ ?
តើអ្នកទទួលខុសត្រូវអ្វីដែរ ?
ខ្ញុំទទួលបន្ទុការងារស្រាវជ្រាវ និងអភិវឌ្ឍន៍ ។
តើទីតំាងក្រុមហ៊ុនរបស់អ្នកមានទីតំាងនៅទីណាដែរ ?
នៅក្នុងទីក្រុងញូវយ៉ក ។
យើងមានទីតំាងនៅទីក្រុងញូវយ៉ក ។
តើក្រុមហ៊ុនរបស់អ្នកធំប៉ុណ្ណាដែរ ?
តើមានមនុស្សប៉ុន្មាននាក់ធ្វើការនៅទីនោះ ?
ក្រុមហ៊ុនយើងមានបុគ្គលិកទំាងអស់ចំនួន៥០០នាក់ ។
តើអ្នកធ្វើដំណើរឆ្ងាយប៉ុណ្ណាដែរ ?
តើអ្នកចំណាយពេលប៉ុន្មានសម្រាប់ការធ្វើដំណើរ ?
ពីផ្ទះទៅការិយាល័យ ខ្ញុំចំណាយពេល១ម៉ោងកន្លះសរុបទាំងអស់ ។
ខ្ញុំធ្វើដំណើរដោយរថភ្លើងក្រោមដី ។
ខ្ញុំជិះរថភ្លើងក្រោមដី ។
តើអ្នកធ្វើការប៉ុន្មានម៉ោង ?
ការិយាល័យខ្ញុំចាប់ផ្តើមធ្វើការនៅម៉ោង៩ ហើយបញ្ចប់នៅម៉ោង៥ ។
តើអ្នកមានថ្ងៃឈប់សម្រាកប៉ុន្មានដងក្នុងមួយឆ្នាំ ?
យើងមានប្រហែល១៣០ថ្ងៃ ។
ខ្ញុំមិនពេញចិត្តចំពោះប្រាក់ខែបច្ចុប្បន្ននេះទេ ។
ពិបាករស់ណាស់សម្រាប់ប្រាក់ខែរបស់ខ្ញុំ ។
តើអ្នកធ្វើការទីនេះប៉ុន្មានឆ្នំាហើយ ?
ខ្ញុំបានធ្វើការនៅទីនេះប្រហែលជា៦ឆ្នាំហើយ ។
តើអ្នកចូលចិត្តការងារនេះដែរទេ ?
តើអ្នករីករាយជាមួយការងារនេះដែរទេ ?
តើអ្នករីករាយនឹងការងារអ្នកដែរទេ ?
តើអ្នករីករាយការងារអ្នកដែរទេ ?
បាទ រីករាយខ្លាំងណាស់ ។
បាទ ខ្ញុំពេញចិត្តណាស់ ។
បាទ មានការប្រកួតប្រជែងខ្លំាងណស់ ។
អាជីវកម្មមានភាពលំបាកណាស់ ប៉ុន្តែបានផ្តល់ឱ្យខ្ញុំនូវភាពជោគជ័យ ។
ខ្ញុំនិយាយកុហក ប្រសិនខ្ញុំនិយាយថាខ្ញុំចូលចិត្តនូវអ្វីគ្រប់យ៉ាងអំពីនោះ ។
បាទ ប៉ុន្តែការងារខ្ញុំតឹងតែងណាស់ ។
ទេ គួរឱ្យធុញណាស់ ។
ទេ មិនគួរឱ្យចាប់អារម្មណ៍អ្វីទំាងអស់ ។
ខ្ញុំពិតជាចង់ប្ដូរការងារខ្លាំងណាស់ ។
ទីបំផុតខ្ញុំអាចរកការងាដែលខ្ញុំអាចប្រើប្រាស់ទេពកោសល្យរបស់ខ្ញុំ ។
ម្យ៉ាងវិញទៀត តើអ្វីជាចំណង់ចំណូលចិត្តអ្នក ជេន ?
រៀបចំផ្កា និងតុបតែងលម្អ ។
អ្នកមានឈាមជ័រជប៉ុនច្រើនជាងខ្ញុំ ។
ខ្ញុំបានសិក្សាតែរយៈពេលមួយឆ្នាំប៉ុណ្ណោះ ដូច្នេះខ្ញុំនៅតែជាអ្នកអនុវត្តដំបូងនៅឡើយ ។
តើខ្ញុំអាចមើលការងាររបស់អ្នកបានទេពេលក្រោយ ?
ពិតណាស់ ។ សូមអញ្ជើញមកផ្ទះខ្ញុំម្តងម្កាល ។
តើអ្នកបានចាប់អារម្មណ៍អ្វីដែរ ?
តើអ្នកធ្វើអ្វីនៅពេលទំនេរ ?
តើអ្នកប្រមូលអ្វីដែរ ?
តើអ្នកបានធ្វើរយៈពេលប៉ុណ្ណាហើយ ?
តើភាពយន្តប្រភេទណាដែលអ្នកចូលចិត្តមើល ?
ចំណង់ចំណូលចិត្តខ្ញុំគឺប្រមូលតែម ។
ចំណង់ចំណូលចិត្តខ្ញុំធ្វើសួន ។
ខ្ញុំធ្វើដំណើរទៅក្រៅប្រទេសរាល់ឆ្នំា ។
ខ្ញុំពិតជាឆ្កួតនឹងការរំាណាស់ ។
ចំណង់ចូលចិត្តខ្ញុំព្យាយាមធ្វើអ្វីថ្មីៗ ។
គាត់មានការចាប់អារម្មណ៍ខ្លាំងណាស់ ។
ការអានជាចំណូលចិត្តរបស់ខ្ញុំពេលទំនេរ ។
គាត់បង្វែរនូវចំណង់ចំណូលចិត្តទៅក្នុងការងាររបស់គាត់ ។
អ្នកមិនមានចំណង់ចំណូលចិត្តផ្សេងទេ មិនអញ្ចឹង ?
ប៊ូនសៃសំឡេងដូចជាចំណង់ចំណូលចិត្តរបស់មនុស្សចាស់ ។
ខ្ញុំឆ្ងល់ណាស់ថាប្រភេទពណ៌អ្វីនឹងឈានចូលក្នុងម៉ូដសម្លៀកបំពាក់នៅរដូវស្លឹកឈើជ្រុះ ។
អត្ថបទមួយបានបង្ហាញថាពណ៌ពេញនិយមបំផុតរដូវស្លឹកឈើជ្រុះគឺពណ៌ទឹកក្រូច ។ ប៉ុន្តែ ខ្ញុំមិនចូលចិត្តដើរជាក្រុមនោះទេ ។
ពិតណាស់ អ្នកជាអ្នកគ្រប់គ្រងសម្លៀកបំពាក់តែមួយគត់ ។
ម៉ូដសម្រាប់ការអ្នកធ្វើគំរូ មិនសំណៅរូបផ្កាទេ ។
អ្នកមើលទៅសមណាស់ ។ តើនេះជាឱកាសអ្វីដែរ ?
តើពណ៌អ្វីដែលមានការពេញនិយមពេលនេះ ?
ពណ៌ដែលពេញនិយមបំផុតបន្ទប់នោះរដូវផ្ការីក ពណ៌បៃតង អ្នកដឹងទេ ។
ខ្ញុំឮថាពណ៌នៅរដូវស្លឹកឈើជ្រុះពណ៌ចាប់ផ្តើម ។
ខ្ញុំពិតជាស្រឡាញ់ពណ៌ល្បាយនេះណាស់ ។
ពណ៌ខៀវខ្ចីជាពណ៌ដែលខ្ញុំចូលចិត្តបំផុត ។
សំពត់ខ្លី និងស្បែកជើងកវែងជាម៉ូដសម្រាប់ស្លៀកចេញទៅក្រៅ ។
គាត់ជាមនុស្សទាន់សម័យ ។
នាងស្លៀកពាក់ទៅមើលសមរម្យណាស់ ។
នាងសមនឹងសម្លៀកបំពាក់នេះមែនទេ ។
អ្នកពិតជាស្លៀកពាក់នូវម៉ូដចុងក្រោយនេះមែន ។
ខ្ញុំពិតជាចាប់ចិត្តនិងម៉ូដសម្លៀកបំពាក់នេះ ។
ខ្ញុំមិនចង់ចម្លងយកម៉ូដសម្លៀកបំពាក់នេះទេ ។
ខ្ញុំគ្មានអ្វីដែលគួររំខានជាមួយនិងម៉ូដចុងក្រោយនោះទេ ។
កាបូបលុយរបស់ខ្ញុំមិនអាចឈប់ប្រើប្ដូរជាមួយនិងម៉ូដនោះទេ ។
នាងជារឿយៗស្លៀកពាក់ឆើតឆាយណាស់ ។
សម្លៀកបំពាក់របស់គាត់ហួសសម័យហើយ ។
តើអ្នករចនាម៉ូដមួយណាដែលអ្នកពេញចិត្ត ?
កាល់វិន ខ្លែន ។
សម្លៀកបំពាក់នេះអ្នកមើលដូចជាស្គមពេក ។
បាទ សមនឹងអ្នកណាស់ ។
អ្នកគួរតែរកពណ៌ឱ្យមានពន្លឺជាងនេះបន្តិច ខ្ញុំគិត ។
តើម្ហូបប្រភេទណាដែលអ្នកពិសានៅថ្ងៃនេះ ?
ខ្ញុំមានអារម្មណ៍ចូលចិត្តម្ហូបជនជាតិភាគតិច ដូចជាម្ហូបថៃ ។
លោក មីឆែល ? ខ្ញុំមិនបានគិតថាលោកនឹងមកទីនេះទេ ?
ខ្ញុំចង់ទៅភោជនីយដ្ឋាននៅថ្ងៃណាមួយ ហើយចូលចិត្តខ្លំាងណាស់ ។ ប្រសិនជាអ្នកពេញចិត្តទៅទីនោះ ។
តើអាហារប្រភេទណាដែលអ្នកចូលចិត្តពេលបច្ចុប្បន្ននេះ ?
ខ្ញុំចង់ពិសាអាហារអេស្ប៉ាញ ។
ខ្ញុំសាកល្បងហូបម្ហូបពិសេសប្រចាំនៅប្រទេសនេះ ។
តើអ្នកធ្លាប់ញ៉ាំម្ហូបជប៉ុនដែរទេ ?
អ្នកគួរតែទៅសាកល្បងម្តង ។
ម្ហូបដែលធ្វើពីសណ្តែកសៀង ដូចជាតៅហ៊ូ មីសូ ជាដើម ជាអាហារដែលពេញនិយមសម្រាប់សុខភាព ។
ខ្ញុំសាកល្បងម្ហូបពិសេសប្រចំាតំបន់ ។
ខ្ញុំចូលចិត្តម្ហូបចិន ។
ខ្ញុំចូលចិត្តម្ហូបជនជាតិភាគតិច នៅផ្នែកមួយនៃម្ហូបវៀតណាម ។
តើអ្វីដែលជាពិសេសខ្ញុំចូលចិត្តគឺតែមផូរ៉ា ។
ខ្ញុំបានញ៉ាំស្ទើតែគ្រប់មុខទំាងអស់ ។
ខ្ញុំពិតជាមិនដែលបានហូបម្ហូបនេះទេ ។
តើអ្នកចូលចិត្តសូហ្សីដែរទេ ?
ខ្ញុំមិនដែលហូបពីមុនមកនោះទេ ។
ខ្ញុំចូលចិត្ត ប៉ុន្តែថ្លៃពេកសម្រាប់ខ្ញុំញ៉ាំ ។
តើមានអ្វីដែលអ្នកមិនចូលចិត្តដែរ ?
ខ្ញុំមិនចង់ញាំឈីសទេ ។
ខ្ញុំចូលចិត្តញ៉ាំត្រីឆៅនោះទេ ដូចជាសាហ្សីមីជាដើម ។
ខ្ញុំមិនចូលចិត្តអាហារដែលមានជាតិខ្លាញ់នោះទេ ។
បច្ចុប្បន្ននេះអាហារមានជាតខ្លាញ់កើតឡើង មិនអញ្ចឹង ?
អាហារដែលមានជាតិឆ្ងាញ់ពិតជាត្រូវទទួលការពេញនិយមនាពេលបច្ចុប្បន្ននេះ ។
ខ្ញុំគិតថាខ្ញុំក៏ចូលចិត្តអាហារជាតិខ្លាញ់ដែរ ។
គាត់ជំនាញផ្នែកភ្លក្សរស់ជាតិអាហារខ្លំាងណាស់ ។
នេះជាកន្លែងពិសេសសម្រាប់ញ៉ាំអាហារអ៊ីតាលី ។
ម្ហូបនេះមានរស់ជាតិឆ្ងាញ់នៅក្នុងរដូវកាលនេះ ។
គាត់ធ្វើម្ហូបដែលមានជាតិឆ្លាញ់ដោយខ្លួនគាត់ ។
ខ្ញុំចាត់ទុកខ្លួនឯងជាអ្នកជំនាញផ្នែកស្រាអាឡឺម៉ង់ ។
តើយើងគួរតែទៅបោះជុំរុំជាមួយម្តងនៅថ្ងៃណាមួយ ?
ប្រសើរណាស់ ។ ខ្ញុំរង់ចាំនូវឱកាសធ្វើអ្វីមួយដូចនេះ ។
សកម្មភាពក្រៅម៉ោងមានការពេញនិយមយ៉ាងខ្លំាងនៅអាមេរិក ។
អ្នកចូលរួមនូវសកម្មភាពក្រៅម៉ោង ប្រសិនបើអ្នកមិនមានអេវី ។
ពិតជាប្រសើរណាស់ប្រសិនបើអ្នកធ្វើបាន ។
ខ្ញុំចូលចិត្តទៅបោះជំរុំជាមួយមិត្តភក្តិខ្ញុំ ។
យើងចំណាយពេលទៅបោះជំរុំ ហើយនឹងចូលរួមនៅក្នុងរដូវកាលឈប់សម្រាក ។
ខ្ញុំពេលខ្លះខ្ញុំដើរមើលសត្វស្លាប ។
ធម្មជាតិពិតជាស្រស់ស្អាតណាស់ ។
ធម្មជាតិធ្វើឱ្យខ្ញុំបំភ្លេចបញ្ហារបស់ខ្ញុំនៅក្នុងលោកនេះ ។
ខ្ញុំជារឿយៗចេញទៅដើរកម្សាន្តជាមួយក្រុមគ្រួសារនៅចុងសប្ដាហ៍ ។
ខ្ញុំជឿជាក់ថានេះមធ្យោបាយមួយសម្រាប់សុខភាពដែលចំណាយពេលជាមួយដើមឈើ ។
អ្នកពិតជាមានអារម្មណ៍ស្រស់ស្រាយជាមួយនិងការជិះកង់មើលធម្មជាតិ ។
ខ្ញុំជាចុងក្រោយខ្ញុំទិញឡានហើយ ចន ។
ប្រើប្រាស់ឡានជប៉ុន ។ វាមានភាពស្ងប់ស្ងាត់ល្អ ។
ខ្ញុំបានបើកបររយៈពេលមួយឆ្នាំពេញហើយ ប៉ុន្តែខ្ញុំមិនមានទំនុកចិត្តក្នុងការទទួលយករថយន្តរបស់ជប៉ុនមួយនៅលើផ្លូវអាមេរិកដោយសារតែវាជារថយន្តស្តាំដៃដ្រាយ ។
ពិតជាស្អប់ស្ងាត់ល្អណាស់ ។
ខ្ញុំបានបើកបររយៈពេលមួយឆ្នាំហើយ ។
ខ្ញុំពិតជាពេញចិត្តឡានម៉ូដចាស់ៗ ។
ឡានរបស់ខ្ញុំជាឡានស៊ីប ។
កង់ឡានរបស់អ្នកដូចជាត្រជាក់ណាស់ ។
ខ្ញុំចូលចិត្តឡានជប៉ុន ។
ឡាននេះពិតជាមានសុវត្ថិភាពខ្ពស់ណាស់ ។
ឡាននោះអាចគ្រប់គ្រងបានល្អ ។
ឡានចាស់របស់ខ្ញុំប្រើមិនសូវស្រួលសោះ ។
ខ្ញុំបានព័ត៌មានថាមានម៉ូដថ្មីដែលប្រើប្រាស់ហ្ហាស ។
ចំណតឡាននេះអាចទុកចិត្តបាន ។
ឡាននេះពិតជាមានផាសុកភាពល្អណាស់ ។
ខ្ញុំបើកបររយៈពេល១៥ឆ្នាំហើយហើយមិនដែលបានជួបគ្រោះថ្នាក់ទេ ។
បាទ ។ ខ្ញុំលេងទិន្តិស្តនៅរាល់ថ្ងៃអាទិត្យ ។ ចុះអ្នកវិញម៉េចដែរ ?
តើកីឡាប្រភេទណាដែលអ្នកចូលចិត្តមើល ?
ខ្ញុំចូលចិត្តកីឡាបាល់ឱបជាវិជ្ជាជីវៈរបស់ខ្ញុំ ។ ខ្ញុំជាអ្នកគំាទ្រ ។
ខ្ញុំចូលចិត្តលេងកីឡានៅខាងក្រៅ ។
ខ្ញុំចូលចិត្តកីឡានៅរដូវក្តៅ ។
តើអ្នកលេងកូនហ្គោលជារឿយៗទេ ?
ខ្ញុំទើបចាប់ផ្តើមនិយាយពីមេរៀននេះ ។
តើកីឡាករមួយណាដែលអ្នកពេញចិត្តជាងគេ ?
ខ្ញុំរត់រាល់ហាត់ប្រាណពេលព្រឹក ។
តើអ្នកហ្វឹកហាត់កីឡាជូដូយូរប៉ុណ្ណាហើយ ?
ខ្ញុំមិនដែលសាកល្បងលេងកូនហ្គោលទេ ។
ខ្ញុំចូលចិត្តមើលកីឡាបាល់ទាត់ ។
ខ្ញុំចូលចិត្តមើលការប្រកួតកីឡាបាល់បោះជារៀងរាល់ឆ្នាំ ។
តើថ្ងៃនេះមានការប្រកួតកីឡាអ្វីដែរ ?
តើក្រុមណាដែលលេងនៅថ្ងៃនេះ ?
ខ្ញុំពិតជាមានអារម្មណ៍ស្រស់ស្រាយពេលមើលប្រកួតកីឡា ។
តើក្រុមណាដែលអ្នកបានជ្រើសរើស ?
ក្រុមបាល់ទះជាក្រុមតូច ។
ក្រុមដកហ្គ័រ ជាមួយថៃហ្គ័រ ។
ក្រុមតោបានស៊ីក្រុមសំាងពីរគ្រាប់ ។
ម៉ារិណ័របានឈ្នះក្រុម យានកេ ដោយ១០ ទល់នឹងមួយ ។
តើពិន្ទុប៉ុន្មាន ?
ប្រមាណជា៧ ទៅ៣ពិន្ទុ ។
អ្នកពូកែលេងទិនិស្តពូកែណាស់ ។
ខ្ញុំចង់កក់ធ្វើការកក់កន្លែងលេងទិន្តិស្ត ។
តើអ្នកធ្វើការដៃគូរលេងជាមួយខ្ញុំបានទេ ?
នេះសេវាកម្មរើសកូនបាល់ ។
តើអ្នកចង់រៀបចំទុកមុនទេ ?
បាទ ខ្ញុំនឹងទៅមុន ។
តើអ្នកជ្រើសរើសក្រុមមួយណា ?
ម៉ារីណ័រចាញ់ក្រុមយានខេ ដោយ១០ ទល់១ ។
តើអ្នកលេងកូនហ្គោលយូរប៉ុណ្ណាហើយ ?
ប្រហែលជា១៥ឆ្នំាមកហើយ ។
ខ្ញុំវាយបញ្ចូលឡូលើកទីមួយសម្រាប់ជីវិតរបស់ខ្ញុំសព្វថ្ងៃនេះ ។
មានឡូចំនួនប្រំា ។
តើអ្នកមានជំងឺដាច់សរសៃឈាមខួរក្បាល ?
ខ្ញុំពិតជាចាប់ផ្តើមដំបូង ។
សូមបង្ហាញខ្ញុំអាវគ្គលេងស្រួលៗមួយ ។
តើព្រិលថ្ងៃនេះដូចជាអ្វីដែរ ?
ព្រិលនេះសម្រាប់ការជិះស្គីលេង ។
តើមានកន្លែងហែលទឹកនៅជិតនេះដែរទេ ?
ខ្ញុំទៅហែលទឹកលេង ។
តើខ្ញុំអាចលេងបាន ?
តើកន្លែងណាជាចំណុចចាប់ផ្តើមដំបូង ?
សូមជូនខ្ញុំទៅក្រៅប្រទេស ។
តើខ្យល់នៅថ្ងៃនេះយ៉ាងម៉េចដែរ ?
ហេ ជាចម្រៀងដ៏ពិរោះ ។
ចង្វាក់យឺតៗសម្រាប់ខ្ញុំ ។
ខ្ញុំចូលចិត្តចង្ហាក់តុងហ្កូ ពីព្រោះជាចង្វាក់ញាប់ដូចរ៉ក ។
តើមិនអញ្ចឹង ? ខ្ញុំមិនចូលចិត្តតន្ត្រីទេ ។ ល្អបំផុតខ្ញុំស្តាប់តន្ត្រីបុរាណនៅបន្ទប់ស្ងាត់ៗ ។
បញ្ហាល្អបំផុតគឺមានពេលវេលាសម្រាប់ជួបជាមួយមិត្តភក្តិ ។
តើអ្នកចូលចិត្តចម្រៀងយ៉ាងណាដែរ ?
តើអ្នកចូលចិត្តតន្ត្រីប៉ប់ដែរទេ ?
តើអ្នកនិពន្ធមួយណាដែលអ្នកពេញចិត្ត ?
តើអ្នកចូលចិត្តតន្ត្រីដែរទេ ?
ខ្ញុំពិតជាចូលចិត្តតន្ត្រីណាស់ ។
ខ្ញុំចូលចិត្តចង្វាក់តុងហ្កូ ជាចង្វាក់លឿនជាងតែមប៉ូ ។
តើអ្នកចូលចិត្តហ្សាសដែរទេ ?
ខ្ញុំចូលចិត្តតន្ត្រីហ្សាសបុរាណ ។
ខ្ញុំចូលចិត្តស្តាប់តន្ត្រីបស្ចិមប្រទេស ។
ខ្ញុំពិតជាចូលចិត្តតន្ត្រីហ្សាស ។
ខ្ញុំពិតជាចូលចិត្តរ៉ក ។
ខ្ញុំចូលចិត្តតន្ត្រីបុរាណខ្លំាងណាស់ ។
ខ្ញុំចូលចិត្តមេរ៉ូឌីថែមប៊ូពីព្រោះចង្វាក់យឺត ។
ខ្ញុំចូលចិត្តស្តាប់តន្ត្រីកំដរអារម្មណ៍ ។
ខ្ញុំចូលចិត្តស្ដាប់ចម្រៀងដើម្បីលំហែអាមរ្មណ៍ ។
តើអ្នកពេញចិត្តអ្នកចម្រៀងមួយណា ?
ខ្ញុំចូលចិត្ត ហ្សីឌី ឡូបផើ ។
ខ្ញុំស្តាប់ចម្រៀងក្រុមសែតថែល ។
ខ្ញុំពេញចិត្តក្រុមប្រាម ជាពិសេសលោក បាច ។
ខ្ញុំមិនចូលចិត្តស្តាប់បទចម្រៀងអ្វីទំាងអស់ ។
តើអ្នកទៅមើលការប្រគំតន្ត្រីជាប្រចាំដែរទេ ?
ខ្ញុំជារឿយៗទៅមើលការប្រគំតន្ត្រីរ៉ក ។
សំបុត្រនេះដូចជាថ្លៃពេកសម្រាប់ខ្ញុំ ខ្ញុំមិនអាចទៅជាញឹកញាប់ទេ ។
តើអ្នកអាចលេងឧបករណ៍អ្វីបានខ្លះ ?
តើឧបករណ៍តន្ត្រីអ្វីដែលអ្នកលេង ?
ខ្ញុំអាចលេងប្យាណូខ្លះៗ ។
ខ្ញុំពូកែលេងហ្គីតា ។
តើអ្នកពូកែលេងវីយូឡុងដែរទេ ?
ខ្ញុំមិនសូវពូកែប៉ុន្មានទេ ។
ខ្ញុំចង់រៀនវគ្គលេងវីយូឡុង ។
ខ្ញុំជារឿយៗទៅច្រៀងការ៉អូខេ ។
ចម្រៀងដែលខ្ញុំពេញចិត្តគឺ ផ្លូវរបស់ខ្ញុំ ។
តើអ្នកមានខ្សែភាពយន្តណាមួយដែលអ្នកបានដើរតួទេ ?
តើធ្វើយ៉ាងណា"ការបាត់ពិភពលោក" ដែលដឹកនាំដោយលោកស្ពែលបឺត ។ ដែលជារឿងរំារៃបំផុត ។
អូ ខ្សែភាពយន្ដ អេស អេហ្វ អិច របស់ប្រជាជនដែលនិយាយពីនេះ ។ ប៉ុន្តែខ្ញុំពេញចិត្តនូវខ្សែភាពយន្តស្នេហា ។
ពិតឬ ? ប៉ុន្តែ "ការបាត់ពិភពលោក" ជាខ្សែភាពយន្ដសំខាន់បំផុត ។
ខ្ញុំយល់ ។ សូមទៅទស្សនានៅល្ងាចនេះ ។
ខ្ញុំចូលចិត្តរឿងទេវកថា ។
ខ្ញុំជារឿយទៅមើលការសម្តែងភាពយន្ ។
ខ្ញុំពេញចិត្តខ្សែភាពយន្តស្នេហារបស់អេសអែហ្វ ។
ខ្ញុំពេញចិត្តខ្សែភាពយន្តដែលធ្វើឱ្យខ្ញុំស្រក់ទឹកភ្នែក ។
តើអ្នកទៅមើលកុនជាញឹកញាប់ដែរទេ ?
ខ្ញុំស្មានថាអ្នកទៅមើលមួយខែម្តង ។
ខ្ញុំមិនដែលទៅជាញឹកញាប់នោះទេ ។
ខ្ញុំចូលចិត្តរឿងកំប្លែងណាស់ ។
ខ្ញុំជារឿយៗចូលចិត្តមើលខ្សែភាពរន្ធត់ ។
ខ្ញុំជាញឹកញាប់ចូលមើលរឿងស៊ើបអង្កេត ។
តើអ្នកធ្លាប់ទៅទស្សនាខ្សែភាពល្អយឺដែរទេ ?
នេះជាខ្សែភាពយន្តល្អបំផុតពេលថ្មីៗនេះ គឺរឿង "ក្បួនច្បាប់" ។
តើអ្នកមានតួសម្តែងផ្សេងទៀតដែលអ្នកពេញចិត្តទេ ?
តើខ្សែភាពយន្តមួយណាដែលអ្នកដើរតួពេលនេះ ?
តើមានអ្វីនៅលើវិមានពេលនេះ ?
ខ្សែភាពយន្តដែលគួរចាប់អារម្មណ៍នឹងបញ្ចាំងនៅពេលនេះ ។
តើនរណាជាតួសម្តែងនៅក្នុងរឿងនេះ ?
តួសម្តែងគឺលោក ថម ខ្យូរីស៍ ។
ខែ្សភាពយន្តនេះត្រូវបានទទួលពានរង្វាន់ ។
ទស្សនិកជនបានធ្វើការស្ងើចសរសើរនូវខ្សែភាពយន្តនេះខ្លំាងណាស់ ។
ជាខ្សែភាពយន្តដ៏ល្បីល្បាញ ។
ខ្សែភាពយន្តនេះបានធ្វើការចល័ត ។
ខ្ញុំសើចមិនបាន ពីព្រោះក្រពះខ្ញុំឈឺណាស់ ។
ខ្សែភាពយន្ដនេះមានភាពទាក់ទាញ ពីព្រោះមានសកម្មភាពច្រើន ។
សូមទោស ប៉ុន្តែខ្ញុំពិតជាអផ្សុកណាស់ ។
ខ្សែភាពយន្តនេះមានការទាក់ទាញណាស់ពេលនេះ ។
ជាខ្សែភាពយន្តដែលត្រូវបានគេចាត់ទុកជារឿងអស្ចារ្យ ។
ខ្ញុំមានភាពរីករាយណាស់ប៉ុន្តែក៏មានភាពកម្សោយដែរ ។
ខ្សែភាពយន្តត្រូវបានគេនិយាយមុនមកហើយនៅពេលដាក់បញ្ចាំង ។
ខ្សែភាពយន្តនេះនៅលំដាប់ប៊ី ។
តារាសម្តែងម្នាក់នេះកាយវិការគួរឱ្យសរសើរណាស់ ។
ការបង្ហាញពីចិត្តសាស្ត្រប្រាប់ពីរូបភាពបាន ។
ខ្ញុំពិតជាចូលចិត្តវីរនាទីនៅក្នុងភាពយន្តនេះណាស់ ។
ថ្ងៃមុនខ្ញុំបានដាក់បន្ថែមទម្ងន់បន្តិចកន្លែងនោះ ។ ខ្ញុំគិតថាប្រហែលលើសទម្លន់ហើយ ។
ខ្ញុំគិតថាអ្នកគួរតមអាហារ ។ អ្នកមិនសូវប្រាណបានរាល់ថ្ងៃ មែនទេ ?
ត្រឹមត្រូវណាស់ ។ ដូច្នេះហើយទើបខ្ញុំព្យាយាមរត់ហាត់ប្រាណ ។
ខ្ញុំត្រូវជាតិខ្លាញ់ឡើង ។
ខ្ញុំចង់ធ្វើការសម្រកទម្ងន់របស់ខ្ញុំជាប្រចាំ ។
ខ្ញុំទម្ងន់១០គីឡូក្រាមលើស ។
ខ្ញុំតមអាហារហើយខ្ញុំបានស្រកអស់ប្រាំគីឡូ ។
ខ្ញុំបានស្រកទម្ងន់ក្នុងមួយរយនេះ ។
ខ្ញុំបានកំណត់របបអាហារដើម្បីសម្រកទម្ងន់ខ្ញុំ ។
ខ្ញុំតមអាហារហើយស្រកអស់៦គីឡូ ។
ខ្ញុំគួរណែនំានូវដំបូន្មានរបស់អ្នកកុំហូបអាហារហួសកំណត់ ។
ខ្ញុំតែងតែទៅក្លឹបជារឿយៗ ។
អ្នកគួរជៀសវាងអាហារដែលគ្មានតុល្យភាព ។
ខ្ញុំព្យាយាមបរិភោគអាហារឱ្យមានតុល្យភាព ។
លោកគ្រូពេទ្យខ្ញុំបានណែនាំខ្ញុំឱ្យកំណត់នូវបបអាហារជាប្រចាំ ។
ខ្ញុំធ្វើការតមអាហារ ។
មនុស្សជាច្រើននិយាយពីប្រព័ន្ធផ្សព្វផ្សាយ ប៉ុន្តែអ៊ិនធឺណិតប្រពន្ធផ្សព្វផ្សាយដ៏ពិសេស មិនអញ្ចឹង ?
ខ្ញុំបានប្រើប្រាស់អ៊ីនធឺណិតអស់រយៈពេលពីរឆ្នំាហើយ ។
អរគុណខ្ញុំអាចភ្ជាប់ទំនាក់ទំនងនឹងរឿងចុងក្រោយនៅអាមេរិក ពេលខ្ញុំរស់នៅប្រទេសជប៉ុន ។
តើអ្នកប្រាប់ខ្ញុំពីរបៀបការប្រើប្រាស់បានទេ ?
ចុងក្រោយខ្ញុំប្រើប្រាស់នូវកុំព្យូទ័រផ្ទាល់ខ្លួនរបស់ខ្ញុំ ។
ខ្ញុំមានកុំព្យូទ័រដៃមួយគ្រឿង ។
ប៉ុន្មានថ្ងៃចុងក្រោយនេះខ្ញុំប្រើប្រាស់កុំព្យូទ័រធ្វើការជារឿយៗ ។
ខ្ញុំប្រើកុំព្យូទ័រដៃពេលខ្ញុំទៅធ្វើដំណើរទៅធ្វើអាជីវកម្ម ។
អ្នកពិតជាពូកែផ្នែកកុំព្យូទ័រណាស់ មែនដែរទេ ?
អត់ទេ មិនមែនទេ ។ ខ្ញុំព្យាយាមសិក្សាខ្លំាងណាស់ពេលនេះ ។
ខ្ញុំមិនអាចគូរប្លង់ម៉ូដដោយគ្មានកុំព្យូទ័របានទេ ។
ខ្ញុំមានកុំព្យូទ័រដៃជារបស់ផ្ទាល់ខ្លួនខ្ញុំ ។
ឌីធីភីស្រស់ស្អាតហើយជារឿងធម្មតាសម្រាប់ថ្ងៃនេះ ។
កម្មវិធីរបស់ខ្ញុំគឺងាយស្រួលក្នុងការប្រើប្រាស់ ។
ខ្ញុំបានទិញនូវសេរីចុងក្រោយបង្អស់នៃវិនដូនេះ ។
កុំព្យទ័រដេសស្ថបនេះ បានធ្វើទម្រង់ថ្មីយ៉ាងស្រស់ស្អាត ។
តើអ្នកអាចជួយប្រាប់ខ្ញុំពីរបៀបប្រើប្រាស់កុំព្យូទ័រនេះបានទេ ?
សូមចុកម៉ាវនោះ ។
សូមចុកត្រឡប់ទៅវិញ ។
រក្សាឯកសារទុកមុនពេលអ្នកឈប់ប្រើប្រាស់កម្មវិធីនេះ ។
សូមចម្លងឯកសារចេញ ។
សូមលុបទិន្នន័យនេះចេញ ។
តើអ្នកអាចទាញមកវិញបានទេ ?
ផែនស៊ីឌីនេះពេញហើយ ។
តើអ្នកបានហ្វមម៉ាតផែនស៊ីឌីនេះទេ ?
សូមចុចបញ្ចូលក្តាចុចនេះ ។
តើឌីសមួយណាដែលទិន្នន័យបានផ្ទុក ?
ខ្ញុំបាចចុក្តាចុចខុសហើយ ។
ខ្ញុំមិនអាចបើកឯកសារបានទេ ។
ខ្ញុំសង្ឃឹមថាមិនមានបញ្ហាជាមួយមេរោគក្នុងកុំព្យូទ័ររបស់ខ្ញុំ ។
ខ្ញុំហាក់ដូចជាបាត់បង់នូវទិន្នន័យទំាងអស់របស់ខ្ញុំ ។
តើអ្នកធ្វើការនៅផ្នែកអ៊ិនធឺណិត ?
ខ្ញុំចង់ធ្វើការស៊ីញ៉េនៅលើប្រព័ន្ធអិនធឺណិត ។
តើអ្នកអាចបង្រៀនខ្ញុំពីការភ្ជាប់អិនធឺណិនបានដែរទេ ?
ខ្ញុំដើររកផ្ទះល្វែងមួយសម្រាប់ដាក់ទីតំាងអិនធឺណិត ។
ខ្ញុំប្រើប្រាស់អ៊ិនធឺណិតគ្រប់ពេល សម្រាប់ការទំនាក់ទំនង និងដើរផ្សារជាដើម ។
ខ្ញុំផ្ញើឯកសាររាល់ថ្ងៃដោយប្រើប្រាស់អីម៉ែល ។
សូមផ្ញើអីម៉ែលជូនខ្ញុំ ។
ជម្រាបសួរ ។ តើនេះជាផ្ទះរបស់ខាតមែនទេ ? ខ្ញុំឈ្មោះយូមី ។
ជម្រាបសួរ ។ ខ្ញុំឮគេនិយាយពីអ្នកគ្រប់គ្នា ។ ខ្ញុំប្អូនស្រីរបស់ម៉ារី ។ អញ្ជើចូលមក ។
ខ្ញុំទូរសព្ទទៅខាត សូមអង្គុយចុះ ហើហចំាមួយភ្លេច ។
តើនេះជាផ្ទះខាត ?
ខ្ញុំឮគេនិយាយពីអ្នកគ្រប់គ្នា ។
សូមអញ្ជើញអង្គុយ ។
គ្មានកន្លែងណាដូចផ្ទះរបស់អ្នកទេ ។
អ្នកមើលទៅមានសុភមង្គល និងផ្ទះគួរស្រឡាញ់ ។
តើនេះជាផ្ទះរបស់លោក គ្រាហ៍ ?
តើនេះជាលំនៅដ្ឋានគ្រាហ៍ ?
តើនេះជាគេហដ្ឋានរបស់គ្រាហ៍មែនទេ ?
តើនេះជាផ្ទះរបស់លោក ចនមែនទេ ?
ខ្ញុំចង់ជួបលោក ជេក ។
ខ្ញុំគ្រាន់តែឆ្លងកាត់ ហើយខ្ញុំចង់ជួបគាត់បន្តិច ។
ខ្ញុំនៅទីនេះចំាងជួបមីល៍ ។
ខ្ញុំគ្រាន់តមកដើម្បីនិយាយសួស្តីទៅនាង ។
យើងបានរលឹកអ្នកជារឿយៗ ។
យើងទន្ទឹមរង់ចំាអ្នកមកលេងពួកយើង ។
អរគុណខ្លាំងណាស់ សម្រាប់ការអញ្ជើញមករបស់អ្នក ។
រីករាយណាស់ដែលអ្នកបានមក ។
ខ្ញុំរីករាយដែលអ្នកបានមកលេង ។
គួរឱ្យរីករាយមែនទែន ។
សូមស្វាគមន៍ដែលអ្នកអញ្ជើញមក ?
សូមអញ្ជើញចូលក្នុង ។
សូមអញ្ជើញអង្គុយ ។
សូមធ្វើខ្លួនដោយមានផាសុកភាព ។
សូមចាត់ទុកដូចផ្ទះរបស់អ្នក ។
សូមដាក់ជើងអ្នកចុះ ។
តើខ្ញុំអាចដាក់អាវនៅទីនេះបានទេ ?
តើខ្ញុំអាចដោះស្បែកជើងទីនេះបានទេ ?
នេះជាកាដូរបស់អ្នក ។
គួរឱ្យភ្ញាក់ផ្អើល ។ អរគុណច្រើន ។
នេះជាតែរបស់ជប៉ុន ។
អ្នកមានផ្ទះគួរឱ្យស្រឡាញ់ ។
ទេសភាពនេះស្រស់ស្អាតណាស់ ។
ផ្ទះរបស់អ្នកមានបរិយាកាសស្ងាត់ល្អ មែនទេ ?
អ្នកជិតខាងស្អប់ស្ងាត់ ហើយរស់នៅដោយសនិ្តភាព អញ្ចឹងមែនទេ ?
ផ្ទះនេះមានផាសុកភាពល្អណាស់គួររស់នៅ មែនទេ ?
បន្ទប់នេះស្រស់ស្អាតណាស់ ។
បន្ទប់ធំណាស់ ។
បន្ទប់នេះមានផាសុកភាពល្អណាស់ ។
អ្នកមានផ្ទះស្រស់ស្អាតមែនទែន ។
តើនឹងធ្វើពិធីជប់លៀងប្រភេទណា ?
តើអ្នកស្គាលចាធី ? ថ្ងៃខួបកំណើតរបស់នាង ។
ពិតឬ ? ល្អណាស់ខ្ញុំចង់ទៅ ។ តើនរណាខ្លះដែលបានអញ្ជើញទៅជប់លៀង ?
ប្រសើរណាស់ធ្វើឱ្យមានការភ្ញាក់ផ្អើល ។
ខ្ញុំពេញចិត្តនឹងមក ។
សូមអញ្ជើញចូលរួមថ្ងៃខួបកំណើតរបស់ខ្ញុំ នៅអាទិត្យក្រោយ ។
ខ្ញុំនឹងទៅលរួម ។
ពិតណាសខ្ញុំនឹងទៅ ។
ខ្ញុំច្បាស់ណាស់ខ្ញុំអាចមកបាន ។
ខ្ញុំមានពិធីជប់លៀងមួយថ្ងៃស្អែក ។ តើអ្នកចូលរួមបានទេ ?
សូមទោសខ្ញុំពិតជារវល់មែន ។ ប៉ុន្តែអរគុណច្រើនដែលបានសួរខ្ញុំ ។
ការរីករាយខ្ញុំនឹងកើតមាន ។
អរគុណច្រើនសម្រាប់ការអញ្ជើញខ្ញុំ ។
រីករាយណាស់ដែលអ្នកបានអញ្ជើញខ្ញុំ ។
ជាពិធីជប់លៀងមួយដ៏ល្អ មិនអញ្ចឹង ?
ពិធីជប់លៀងនឹងមានភាពរីករាយ ។
ម្ហូបនេះពិតជាឆ្ងាញ់មែនទែន ។
ខ្ញុំរីករាយដែលអ្នកចូលចិត្តវា ។
ពិធីជប់លៀងនៅល្ងាចមិញដំណើរការល្អណាស់ មែនទេ ?
តើអ្នកមានពេលវេលាដ៏ល្អទេ ?
បាទ នេះប្រសើរមែន ។
បាទ ពិធីជប់លៀងល្អប្រពៃណាស់ ។
តើមានផាសុកភាពគ្រប់គ្រាន់ទេ ?
តើអ្នកធ្លាប់ជួបចនទេ ?
តើខ្ញុំទទួលអ្នកនូវអ្វីៗបានដែរទេ ?
អត់ទេ ខ្ញុំមានគ្រប់គ្រាន់ ។
សូមយកខ្លួនឯងអ្វីដែលអ្នកចូលចិត្ត ។
ខ្ញុំរីករាយការជប់លៀង ។
ខ្ញុំរីករាយដែលមានអ្នក
ខ្ញុំមានពេលវេលាអស្ចារ្យនៅល្ងាចនេះ អរគុណ ។
ពិធីជប់លៀងនេះអស្ចារ្យណាស់ ។
សួស្តី នេះស្មីធនិយាយ ។
អូ រេ ខ្ញុំសុំទោស ជេនចេញក្រៅពេលនេះ ។
ខ្ញុំគិតថា នាងនឹងត្រឡប់មកវិញនៅ១ម៉ោងទៀត ។ តើអ្នកចង់ផ្តាំអ្វីតាមខ្ញុំទេ ?
ប្រសើរណាស់ អ្នកប្រាប់នាងខ្ញុំទូរសព្ទមក ? ខ្ញុំនឹងទូរសព្ទមកម្តងទៀត ។
ជម្រាបសួរ ។ នេះហុងដានិយាយ ។
ជម្រាបសួរ ។ តើនេះជាគេហដ្ឋានរបស់លោកហុងដាឬ ?
សូមមេត្តានិយាយមួយដងទៀត ។
ខ្ញុំនឹងទៅយកនាង ។ សូមចំាមួយភ្លេច ។
តើខ្ញុំអាចនិយាយជាមួយលោក ហ្វត ?
គាត់មិននៅទីនេះទេ ។
ខ្ញុំសុំទោស គាត់ចេញទៅក្រៅ ។
គាត់មិននៅតុទេ ។
គាត់ឈប់នៅថ្ងៃនេះ ។
ខ្ញុំសុំទោស ។ គាត់ចេញទៅសម្រាកថ្ងៃនេះ ។
ខ្ញុំខ្លាចក្រែងតែគាត់ទៅក្រៅបរិភោគអាហារថ្ងៃត្រង់ ។
គាត់ចេញពីការិយាល័យនៅថ្ងៃនេះ ។
នាងគួរតែត្រឡប់នៅម៉ោង៨ ។
នាងនៅក្នុងបណ្តាញផ្សេងទៀតពេលនេះ ។
នាងកំពុងជាប់សិក្ខាសាលា ។
នាងនៅជាមួយភ្ញៀវ ។
នាងជាប់បម្រើការចំាមួយភ្លេត ។
តើខ្ញុំអាចទទួលសារគាត់បានដែរទេ ?
តើខ្ញុំអាចផ្ញើសារទៅគាត់បានដែរទេ ?
តើខ្ញុំអាចសុំលេខទូរសព្ទអ្នកបានដែរទេ ?
តើខ្ញុំឱ្យគាត់ទូរសព្ទត្រឡប់វិញនៅពេល គាត់មក ?
ខ្ញុំប្រាប់គាត់ថាអ្នកទូរសព្ទមក ។
តើនេះជាគេហដ្ឋានរបស់លោក វីលស៊ុលឬ ?
តើខ្ញុំអាចនិយាយជាមួយ ជេនីបានទេ ?
ខ្ញុំសុំទោស នៅទីនេះគ្មានជេនីទេ ។
ជម្រាបសួរ ។ នេះជាគេហដ្ឋានរបស់លោកជេម ។
សុំទោស ខ្ញុំពិតជាច្រឡំលេខហើយ ។
ជម្រាបសួរ ។ នេះជាលោកប្រមុខរដ្ឋវ៉ាយ ?
ខ្ញុំចង់និយាយជាមួយលោក ស្ទេវើត ។
ខ្ញុំឈ្មោះ ណៃតូ នៃក្រុមហ៊ុនបោះពុម្ភអូហ្សិត ។
ខ្ញុំនិយាយជាមួយលោក ប្រោន នៅផ្នែកបណ្ណាធិការ ?
តើអ្នកចង់ណែនាំភ្នាក់ងារលក់មួយនេះមកឲ្យខ្ញុំដែរទេ ?
តើខ្ញុំអាចភ្ជាប់ទៅលេខ ២ ២ ៤ បានដែរទេ ?
កន្លែងណាខ្ញុំអាចទាក់ទងទៅប្រទេសជប៉ុនដោយផ្ទាល់បាន ?
សូមភ្ជាប់ទូរសព្ទផ្ទាល់មនុស្សម្នាក់ទៅមនុស្សម្នាក់ទៀត ។ ពិធីលៀងរបស់ខ្ញុំឈ្មោះសូហ្សូគិ ។
សូមភ្ជាប់ទូរសព្ទផ្ទាល់ស្ថានីយ៍មួយទៅស្ថានីយ៍មួយទៀត ។
អ្នកនៅលេខ១៦អេ ។ នៅច្រកផ្លូវនោះ ខាងស្តាំដៃរបស់អ្នក ។
សុំទោស ខ្ញុំគិតថាអ្នកអង្គុយកៅអីខ្ញុំ ។ កៅអីរបស់អ្នកលខប៉ុន្មានដែរ ?
លេខដប់ប្រាំពីរ អេ ។ អូ ខ្ញុំសុំទោស នេះជាកំហុសខ្ញុំ ។
តើកៅអីគ្មានការជក់បារីមែនទេ ?
តើមានកៅអីជក់បារីទំនេរដែរទេ ?
ខ្ញុំចង់ដូរទៅកៅអីដែលជក់បារីបាន ។
តើអ្នកអាចដូរកៅអីខ្ញុំនិងបានទេ ? មិត្ត និងខ្ញុំអង្គុយផ្សេងគ្នា ។
សូមអភ័យទោស ។ សូមអោយខ្ញុំឆ្លងកាត់ ។
សូមដាក់ខ្សែក្រវ៉ាត់របស់អ្នក ។
យើងមានកាហ្វេ តែ ទឹកផ្លែឈើ បៀរ៍ ស្រា វិស្កី និងស្រាក្រឡុក ។
សូមស្រាស្តក់ និងទឹកសុទ្ធ ។
អរគុណសម្រាប់អាហារដ៏ឆ្ងាញ់ ។
តើអ្នកយកវាចេញពិខ្ញុំបានទេ ?
ខ្ញុំចង់បានភួយ និងខ្នើយ ។
កាសទូរសព្ទខ្ញុំមិនឮទេ ។ តើអ្នកអាចដូរឱ្យខ្ញុំបានដែរទេ ?
សូមជួយបង្ហាញខ្ញុំការបើកភ្លើងនេះ ។
ខ្ញុំមានអារម្មណ៍ឈឺ ។ តើខ្ញុំអាចសុំថ្នំាខ្លះបានទេ ?
តើយូរបុណ្ណាសម្រាប់ដំណើរទៅរដ្ឋឡូអាន់ជេឡែស ?
តើអ្នកមានថ្នំាបាត់ផ្តាសសាយដែរទេ ?
ខ្ញុំស្នាក់នៅសណ្ឋាគារហ្សេរ៉ាតុន ។
ខ្ញុំមកទីនេះដើម្បីមើលទេសភាពទីក្រុង ។
ខ្ញុំជានិស្សិតបម្លាស់ប្ដូរ ។
ខ្ញុំនឹងនៅទីនេះរយៈពេលបីថ្ងៃ ។
ពីរខែនៅទីនេះ ។
សណ្ឋាគារហីលតុនកណ្តាលទីក្រុង ។
ខ្ញុំស្នាក់នៅផ្ទះរបស់មិត្តភក្តិក្នុងទីក្រុងញូវយ៉ក ។
ខ្ញុំនឹងស្នាក់ផ្ទះមិត្តភក្តិ ។
ខ្ញុំមានលុយ១០០០ដុល្លារសម្រាប់ធ្វើដំណើរ ហើយ១០០០ដុល្លារជាលុយសុទ្ធ ។
សូមបង្ហាញខ្ញុំនូវសំបុត្រត្រឡប់ ។
តើកន្លែងណាដែលកាបូបចេញសម្រាប់ជើងហោះហើរលេខ ៧ ០ ៣ ?
តើកាបូបប្រភេទណាដែរទេ ?
កាបូបពណ៌ត្នោត ។
ទំហំប៉ុន្មានដែរ ។
សូមបញ្ជូនកាបូបរបស់ខ្ញុំទៅសណ្ឋាគារហីលតុន ។
ខ្ញុំមាននាឡិកា និងតុក្កតា ។ ទំាងនោះកាដូសម្រាប់មិត្តខ្ញុំ ។
ប្រហែលជា១២០ដុល្លារ ។
អ្នកបានបង់ពន្ធរបស់នេះនៅ ។ សូមបញ្ជាក់នៅជិតបង្អចនៅទីនោះ ។
វត្ថុអនុស្សាវរីយ៍សម្រាប់មិត្តខ្ញុំ ។
វាសំរាប់ការប្រើប្រាស់ផ្ទាល់ខ្លួនរបស់ខ្ញុំ ។
នេះជាកញ្ចប់បារី ។
ខ្ញុំមានស្រាវិស្គីពីរដប ។
សុំទោស ។ អ្នកមិនឱ្យយកផ្លែឈើមកទេ ។
កាដូសម្រាប់មិត្តខ្ញុំ ។
ខ្ញុំចង់បាន ១០ ២០សម្លឹក ៥ ១០សន្លឹក ហើយនៅសល់ដូរជាលុយរាយ ។
ម្យ៉ាងទៀត តើថ្លៃប៉ុន្មានសម្រាប់បេសសកម្មរបស់អ្នក ?
ខ្ញុំចង់ដូរជាលុយយ៉េនជប៉ុន សម្រាប់លុយដុល្លារនេះ ។
អ្នកនឹងដូរជាលុយដុល្លារអាមេរិច ក្នុងអង់គ្លេសជាផោន ?
៥ ១០សន្លឹក ១០ ៥សន្លឹក ហើយសល់លុយរាយខ្លះ ។
ខ្ញុំចង់បានទំាងអស់២០ដុល្លារក្នុងវិក្ក័យបត្រ ។
តើខ្ញុំអាចចាយលុយសុទ្ធសម្រាប់ការធ្វើដំណើរបានទេ ?
ខ្ញុំចង់ចាយលុយធ្វើដំណើរជាលុយដុល្លារ ។
តើអ្នកចង់ដូរប៉ុន្មានដែរ ?
សូមដូរ១០០ដុល្លារសម្រាប់ការពិនិត្យ ។
តើអ្នកអាចទទួលលុយយ៉េនជប៉ុនបានដែរទេ ?
តើអ្នកយកលុយពិនិត្យ ហើយឱ្យខ្ញុំ១០ ២០ ដុល្លារក្នុងវិក្ក័យបត្រ ហើយនឹង២៥ក្នុងវិក្ក័យបត្រនេះមែនទេ ?
តើអ្នកត្រូវបង់ថ្លៃបេស សកម្មប៉ុន្មានដែរ ?
តើអ្នកអាចដូរវិក្ក័យបត្របានដែរទេ ?
ខ្ញុំចង់បានប្រាក់ដែលផ្ញើមកពីប្រទេសជប៉ុន ។
តើខ្ញុំទទួលលុយផ្ញើពីប្រទេសជប៉ុនយ៉ាងដូចម្តេច ?
ខ្ញុំចង់ផ្ទរលុយខ្លះៗ ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេ បើកបញ្ជីកគណនីយដូចម្តេចដែរ ?
តើបញ្ជីគណនីយប្រភេទណាដែលអ្នកចង់បើកប្រើប្រាស់ ?
ខ្ញុំចង់ធ្វើការកក់ ។
ខ្ញុំចង់ដកលុយចេញ៤០០ដុល្លារពីបញ្ជីគណនីយ ។
ខ្ញុំចង់ពិនិត្យចូល ។ ឈ្មោះ អូណូ ។ ខ្ញុំបានធ្វើការកក់ទុកនៅប្រទេសជប៉ុន ។
សូមចំាមួយភ្លេត ។ បាទ លោក តេត្យូអូ អូណូ បន្ទប់គ្រែមួយសម្រាប់បីយប់ ។ ត្រឹមត្រូវទេ ?
តើអ្នកចង់ចាយលុយសុទ្ធ ឬចាយកាតឥណទាន ?
ខ្ញុំចង់ស្នាក់នៅបីយប់ ។
ខ្ញុំចង់បានគ្រែពីរ ។
ខ្ញុំចង់បានគ្រែមួយ ជាមួយបន្ទប់ទឹកមួយ ។
ខ្ញុំចង់បានបន្ទប់គ្រែមួយ ជាមួយនិងទឹកផ្កាឈូកមួយ ។
ខ្ញុំចង់បានបន្ទប់មួយដែលមានទេសភាពស្អាត ។
ខ្ញុំចង់បានបន្ទប់ស្ងប់ស្ងាត់ ។
ខ្ញុំចំាច្បាស់ណាស់ ខ្ញុំបានកក់រួចហើយ ។ តើអ្នកសាកល្បងរកឈ្មោះម្តងទៀតបានទេ ?
ខ្ញុំចង់បានបន្ទប់គ្រែមួយសម្រាប់ពីរយប់ ។
សូមជួយបំពេញចុះឈ្មោះកាតនេះ ។
តើម៉ោងប៉ុន្មានពិនិត្យចេញ ?
ខ្ញុំចង់បានកូនសោបន្ទប់លេខ៥ ១៥ ។
នេះជាសេវាកម្មបន្ទប់ ។ តើខ្ញុំអាចជួយអ្វីអ្នកបានដែរ ?
បន្ទប់លេខ ៥ ០ ៥ ។ ខ្ញុំចង់កុម្ម៉ង់សំាងវិច ហើយនឹងកាហ្វេ ។
ខ្ញុំចង់បានសាប៊ូខ្លះ ។
ខ្ញុំចង់ក្រោកនៅម៉ោង៩.៣០នាទីពេលព្រឹក ។
ខ្ញុំមានការបោកអ៊ុត ។ តើអ្នកមានសេវាកម្មបោកអ៊ុតដែរទេ ?
ខ្ញុំចង់បានសាប៊ូខ្លះ ។
ខ្ញុំរៀបចំចេញនៅស្អែកពេលល្ងាច ។
តើអ្នកអាចសម្អាតកាបូបរបស់ខ្ញុំនៅថ្ងៃស្អែកពេលព្រឹកបានទេ ?
ខ្ញុំត្រូវការបោកអ៊ុតរួចដោយប្រញាប់បន្តិចបើអាចទៅរួច ។
អំពូលភ្លើងបន្ទប់នេះមិនភ្លឺទេ ។
ខ្ញុំមិនទាន់បានទឹកក្តៅ ជាមួយម៉ាស៊ីនត្រជាក់ទេ ។
ទឹកក្តៅត្រូវបានពេញហួសបាសាំង ។
នៅទីនេះគ្មានកន្លែងជូនខ្លួន ។
ទូរទស្សនក្នុងបន្ទប់មិនដំណើរការ ។
ខ្ញុំចាកចេញស្អែកពេលព្រឹក ។ សូមជូនវិក្ក័យខ្ញុំឱ្យរួចរាល់ ។
ខ្ញុំបានញ៉ាំបៀរ៍អស់ពីរដប ហើយកូកានៅក្នុងទូក្លាសេ ។
ខ្ញុំគិតថានេះជាកំហុសនៅក្នុងវិក្ក័យបត្រនេះ ។
តើអ្នកអាចចាយដោយកាតឥណទានបានទេ ?
បៀរ៍ សាច់អាំងជាមួយដំឡូងបំពង ហើយសុំសាលាដពិសេសមួយមក ។
បាទ ។ តើសម្លៀកបំពាក់ប្រភេទណាសម្រាប់ធ្វើសាលាដ ?
សូមឱ្យឆៅបន្តិច ។
តើអ្នកមានសំណើរអ្វីដែរ ?
តើអ្នកណែនំានូវភោជនីយដ្ឋានល្អនៅជិតបានដែរទេ ?
តើមានភោជនីយដ្ឋានអាហារសមុទ្រនៅជិតដែរទេ ?
ខ្ញុំចង់ល្បងហូបអាហារប្រចំាប្រទេសនេះម្តង ។
ខ្ញុំសុំទោស ខ្ញុំពេញម៉ោងទំាងអស់ ។ តើអ្នកនៅម៉ោង៨បានទេ ?
មិនអីទេ ។ យើងនឹងមកដល់នៅម៉ោង៨ ។
តើខ្ញុំត្រូវការពាក់ក្រវ៉ាត់កដែរទេ ?
ខ្ញុំឈ្មោះ អូកាដា ។ យើងបានកក់នៅម៉ោង៧ ។
យើងមិនបានកក់ទុកទេ ប៉ុន្តែអ្នកនៅតុលេខ៤ ?
តើយើងរង់ចំាយូរប៉ុណ្ណាដែរ ?
តើយើងអាចយកតុនៅជិតបង្អួចបានទេ ?
យើងចង់បានតុគ្មានការជក់បារី ។
តើអ្នកអាចបង្ហាញនូវបញ្ជីស្រាបានទេ ?
សុំទោស ។ ខ្ញុំកុម្ម៉ង់នៅពេលនេះ ។
សូមចំាមួយភ្លេត ។ ខ្ញុំមិនទាន់សម្រេចចិត្តទេ ។
សូមឱ្យខ្ញុំគិតបន្តិចបានទេ ។
ខ្ញុំចាប់ផ្តើមដោយបៀរ៍ ។
សូមយកស្រាក្រហមមួយដប ។
សូមស្រាក្រហមពីរកែវ ។
ខ្ញុំនឹងញ៉ាំមួយនេះ និងមួយនោះ ។
ខ្ញុំជាទុកថ្ងៃនេះជាថ្ងៃពិសេស ។
ខ្ញុំនឹងញ៉ាំសាច់អាំងក្រូចឆ្មាជាមួយប៉េងបោះ ។
សូមខ្នាតមធ្យម ។
ខ្ញុំចូលចិត្តសាលាដអាហារសមុទ្រ ។
តើសម្លៀកបំពាក់ប្រភេទណាដែលអ្នកស្លៀកសម្រាប់សាលាដ ?
ខ្ញុំញ៉ាំកាហ្វេបន្ទប់ពីបាយរួច ។
ខ្ញុំមិនញ៉ាំបង្អែទេ ។
ខ្ញុំធ្លាក់សម ។ តើខ្ញុំអាចសុំផ្សេងទៀតបានទេ ?
សូមចេញឱ្យឆ្ងាយ ។
ខ្ញុំចង់យកវាទៅផ្ទះបានទេ ?
តើខ្ញុំអាចសុំថង់រូបកូនឆ្កែបានទេ ?
ធ្វើម្ហូបអាឡឺម៉ង់ថ្ងៃនេះ ។
តើបូករួមទំាងសេវាកម្មផ្សេងៗដែរទេ ?
សូមហំាប័រហ្គឺពីរ ហើយកូកាដបតូចមួយ ។
ខ្ញុំនឹងរៀបចំទៅ ។
សូមយកអាក្រឡុក ។
ខ្ញុំចូលចិត្តប៉េកាហ្វេ ហើយចានគោះបារី ។
សុំការ៉េមក៏បានដែរ អរគុណ ។
ខ្ញុំយកទំាងពីរ ។
ខ្ញុំចូលចិត្តស្រាស្កត់នៅលើថ្ម ។
សូមសស្រាវិស្គពីរមក ។
តើម៉ាកអ្វីដែលអ្នកចង់បាន ?
ខ្ញុំចូលចិត្តម៉ាទីនី ។
ខ្ញុំចូលចិត្តមួយផ្សេងទៀត ។
ស្រាវិស្កីមួយដប ។
ពិតណាស់ យើងត្រូវការនូវអាវមួយពេលនេះ ។
ខ្ញុំពេញចិត្តមួយនេះ ប៉ុន្តែធំពេក ។ តើអ្នកមានតូចជាងនេះទេ ?
មួយនេះសមណាស់ ។ ខ្ញុំយកមួយនេះ ។
តើអ្នកប្រាប់ខ្ញុំបានទេ តើមានផ្សារនៅជិតនេះដែរទេ ?
តើមានហាងដែលគ្មានការបង់ពន្ធនៅជិតនេះដែរទេ ?
តើកន្លែងឱស្ថាននៅទីណា ?
តើកន្លែងលក់សម្លៀកបំពាក់ស្ត្រីនៅកន្លែងណាដែរ ?
ជម្រាបសួរ ។ តើខ្ញុំជួយអ្នកបានទេ ?
ខ្ញុំចូលចិត្តនាឡិកាដៃ ។
ខ្ញុំចង់ទិញក្រែមលាបមាត់ ។ តើអ្នកមានផលិតផលរ៉េវឡនទេ ?
ខ្ញុំចង់បានផ្សេងៗហើយមានពណ៌ខុសគ្នា ។
ខ្ញុំចង់បានកាបូប ។
តើអ្នកមានតូចជាងនេះបន្តិចទេ ?
ខ្ញុំខ្លាចដូរទៅមិនមានភាពត្រឹមត្រូវ ។
តើអ្នកអាចខ្ចប់ជូនខ្ញុំបានទេ ?
សូមខ្ចប់ដាក់ផ្សេងគ្នា ។
ខ្ញុំចង់បានអាវធំ ។
តើអ្នកអាចបង្ហាញខ្ញុំអាវចាក់នៅជិតបង្អួចបានទេ ?
ខ្ញុំមិនច្បាស់ទេ ។ តើអ្នកអាចវាស់ឱ្យខ្ញុំបានទេ ?
នៅត្រង់ចង្កេះដូចជាតូចបន្តិច ។
ដូចជាឆើតឆាយពេកសម្រាប់ខ្ញុំ ។ តើអ្នកមានមួយទៀតដែលសមជាងនេះទេ ?
តើអ្នកបង្ហាញខ្ញុំនូវពណ៌ភ្លឺមួយបានទេ ?
តើប្រសិនបើធ្លាក់ បោកដោយទឹកត្រជាក់មែនទេ ?
តើអ្នកបង្ហាញខ្ញុំនូចិញ្ចៀននោះបានទេ ?
ទីពីរបន្ទប់ពីមួយនោះនៅខាងស្តំាដៃ ។
ខ្ញុំទៅមើលចិញ្ចៀនដែលមានត្បូងទទឹម ។
តើមានប៉ុន្មានការ៉ាត់ដែរ ?
បាទ ។ ដប់ប្រាំបីការ៉ាត់មាស ។
តើអ្នកមានកក្រវិលដែរទេ ?
ខ្ញុំចង់បានស្បែកជើងស្បែកពណ៌ត្នោត ។
តើស្បែកនេះប្រយោជន៍អ្វីខ្លះដែរ ?
សូមវាស់ទំហំខ្ញុំផង ។
ដូចជាចង្អៀតបន្តិចសម្រាប់ខ្ញុំ ។
សូមយកជូនខ្ញុំនូវទំហំជាងនេះ ។
តើអ្នកមានដូចគ្នាទេ មួយដែលមានទំហំជាងនេះ ?
តើអ្នកមានទំហំដូចគ្នាពណ៌ខ្មៅ ?
តើទឹកអប់មួយណាដែលពេញនិយមជាងគេ ?
ខ្ញុំចង់បានកូលូនេ ។
ខ្ញុំសាកល្បងក្រែមពណ៌នេះមើល ។
តើអ្នកមានពណ៌ស្រស់ជាងនេះដែរទេ ?
តើអ្នកនឹងធ្វើអ្វីនៅរដូវក្តៅនេះ ?
ដូចជារលុងបន្តិចសម្រាប់ខ្ញុំ ។
សូមបង្ហាញទំហំតូចបន្តិច ។
តើយូរប៉ុណ្ណាសម្រាប់ការផ្ញើអីម៉ែល ?
ចំណាយពេលទៅបួនទៅប្រាំថ្ងៃយ៉ាងយូរ ហើយផ្ញើតាមជាពិសេសប្រហែលជាពីរ ទៅបីថ្ងៃយ៉ាងយូរ ។
ក្រោយមក សូមផ្តើជាលក្ខណៈពិសេស ។ ខ្ញុំយក២០តែម១៥សេន ។
សូម០ដុល្លារ និង៣០សេនបានហើយ ។
តើសេវាកម្មមួយដែលយើងផ្ញើអីម៉ែល ?
តើច្រកមួយណាដែលយើងផ្ញើកញ្ចប់នេះបាន ?
ខ្ញុំចង់ផ្ញើរបស់នេះតាមរយៈផ្លូវអាកាស ។
ខ្ញុំចង់ផ្ញើតាមបញ្ជីឆាប់រហ័ស ។
សូមផ្ញើមួយនេះជាលក្ខណៈពិសេស ។
សូមជួយចុះបញ្ជីសំបុត្រនេះផង ។
សូមផ្ញើសំបុត្រនេះដោយបញ្ជីឈ្មោះអីមែល ។
ខ្ញុំចង់ភផ្ញើអីម៉ែលទៅប្រទេសជប៉ុន ។
តើមួយណាដែលលឿនសម្រាប់ការផ្ញើនេះ ?
ខ្ញុំចង់ផ្ញើអីវ៉ាន់មួយកញ្ចប់ទៅប្រទេសជប៉ុន ។
គ្រាន់តែបោះពុម្ភប៉ុណ្ណោះ ។
គ្រប់គ្រាន់សម្លៀកបំពាក់ទំាងអស់ ។
តើថ្លៃប៉ុន្មានសម្រាប់ប្រអប់នេះទៅប្រទេសជប៉ុ ន ?
តើការចុះបញ្ជីថ្លៃប៉ុន្មានដែរ ?
តើពេលណាទទួលបាននៅតូក្យូ ?
តើយើងទទួលបាននៅថ្ងៃខានស្អែកពេលព្រឹក ?
តើថែមប៉ុន្មានខ្ញុំត្រូវការបិទនៅទីនេះ ?
ខ្ញុំចង់បានតែម៥ តម្លែ១៥សេន ហើយកាតផូស្តាល់២០ ។
១៥អេរ៉ូក្រាម ។
ខ្ញុំចង់បាន១៥អេរ៉ូក្រាម ។
ខ្ញុំចង់ឱ្យមានការធារ៉ាប់រងនូវកញ្ចប់នេះ ។
ខ្ញុំចង់ធ្វើការធានារ៉ាប់រងតម្លៃសម្រាប់៥០០ដុល្លារ ។
តើទម្ងន់កំណត់ប៉ុន្មានដែរ ?
សូមឱ្យខ្ញុំ១៥អេរ៉ូក្រាម ។
សុំទោស ។ ខ្ញុំចង់ទៅសួនសត្វប្រោន ។ តើទៅទីនោះដោយវិធីណាដែរ ?
ខ្ញុំសុំមើល ។ អ្នកអាចជិះឡានក្រុង មធ្យោបាយល្អបំផុតជិះរថភ្លើងក្រោមដី ។
អ្នកឃើញចំណតឡានមហាតាន់នៅទីនោះ ។
អ្នកជាអ្នកជំនួយពិសេស ។ សូមអរគុណចំពោះសន្តានចិត្តអ្នក ។
អ្នកអាចជិះឡានបាន ។
ទៅសណ្ឋាគារផ្លាហ្សា ។
តើអ្នកអាចដាក់វ៉ាលីនៅក្នុងឡានទ្រុងបានទេ ?
ខ្ញុំត្រូវទទួលបានប្រំាមួយ ។ តើអ្នកប្រញាប់បន្តិចបានដែរទេ ?
តើខ្ញុំអាចទៅចំណតឡានទំាងបីបានទេ ?
តើចំណាយពេលយូរប៉ុណ្ណាសម្រាប់ទៅទីនោះ ?
សូមឈប់នៅមុខសណ្ឋាគារនោះ ។
តើអ្នកអាចដូរឱ្យខ្ញុំចំនួន២០ដុលា្លរបានសម្រាប់វិក្ក័យបត្រនេះ ?
ខ្ញុំចង់ទៅកាន់តំបន់មហាតាន់ ។ តើឡានក្រុងមួយណាខ្ញុំគួរជិះ ?
តើឡានលេខមួយណាទៅហូលីវ៉ូដ ?
តើពេលណាឡានក្រុងបន្ទប់ទៅឆីកាកូ ?
តើម៉ោងប៉ុន្មានឡានជើងទីមួយចេញដំណើរ ?
សំបុត្រមួយទៅព្រលានយន្តហោះអន្តរជាតិ ។
តើថ្លៃប៉ុន្មានសម្រាប់ទៅឈីកាកូ ?
តើកន្លែងណាខ្ញុំធ្វើការផ្ទេរទៅសូហូ ?
តើខ្ញុំឡើងឡានត្រូវទៅឆាយណាថោនទេ ?
តើកន្លែងណាខ្ញុំឈប់នៅមជ្ឈមណ្ឌលផាក ?
ខ្ញុំចង់ចុះនៅមជ្ឈមណ្ឌលផាក ។
សូមដាក់ខ្ញុំចុះទីនេះ ។
តើកន្លែងសំបុត្រម៉ាស៊ីននៅទីណា ?
តើថ្លៃប៉ុន្មានសម្រាប់មួយដង ?
តើម៉ោងប៉ុន្មាននៅចុងក្រោយ ?
តើច្រកមួយណាដែលខ្ញុំជិះទៅទីក្រុងបាន ?
ខ្ញុំចង់មើលកាលវិភាគ ។
សូមអោយសំបុត្រតែទៅមួយសន្លឹកសំរាប់ទៅស៊ីកាកូ ។
សំបុត្រទៅមកពីរសម្រាប់ទៅប៊ូស្តុន ។
ខ្ញុំអាចទិញសំបុត្រពីរសម្រាប់ថ្នាក់ទី១ទៅញូវយ៉ក ?
សំបុត្រពីរសម្រាប់ទៅទីក្រុងឡុនដុន ។
សំបុត្រពីរសម្រាប់មនុស្សពីរនាក់ប្រញាប់ ។
តើថ្លៃប៉ុន្មានសម្រាប់ទៅឈីកាកូ ?
គ្មានដែលគ្មានជក់បារី ។
ខ្ញុំចង់កក់កៅអីទៅឈីកាកូ ។
តើផ្នែកមួយណាដែលរថភ្លើងទៅរដ្ឋឡូអាន់ជឺឡែស ?
តើទីស្នាក់មួយការណ៍ដែលរថភ្លើងអេចេញដំណើរ ?
តើមានស្តប់ប៉ុន្មានទៅសាន ដៃហ្គូ ?
នេះគឺជាការបង្ហាញពីមូលដ្ឋានឬ ?
តើម៉ោងប៉ុន្មានរថភ្លើងទៅដល់ប៊ូស្តុន ?
តើឯងណាកៅអីដែលខ្ញុំកក់ទុក ?
តើផ្លូវមួយណាទៅបន្ទប់ទឹក ?
ខ្ញុំជិះរថភ្លើងច្រឡំ ។ តើកន្លែងណាខ្ញុំគួរឈប់ ?
តើចំណតមួយណាខ្ញុំអាចដូររថភ្លើងបាន ?
ខ្ញុំចង់បានអ្វីមួយដែលមានទំហំជាមធ្យម និងសមរម្យបន្តិច ។
តើអ្នកចូលចិត្តឡានជប៉ុនដែរទេ ?
ពេលខ្លះស្រួលបើក ចង្កួតឆ្វេង ក្នុងផ្នែកទំាងពីរ ។
តើហេតុអ្វីអ្នកមិនព្យាយាមម៉ូដនៅទីនោះ ?
តើមានក្រុមហ៊ុនឡានជួលនៅជុំវិញទីនេះទេ ?
ខ្ញុំចង់ជួលឡាន ប៉ុន្តែតើខ្ញុំត្រូវធ្វើយ៉ាងណាដែរ ?
តើអ្នកមានឡានដែរទំនេរពេលនេះដែរទេ ?
សូមបង្ហាញខ្ញុំនូវបញ្ជីតម្លៃ ។
តើខ្ញុំអាចមើលបញ្ជីតម្លៃជួលឡានបានទេ ?
តើឡានប្រភេទណាដែលអ្នកចង់បាន ?
ខ្ញុំចង់បានឡានដែលទំហំមធ្យម ។
ខ្ញុំចង់បានឡានតូច ។
ខ្ញុំចង់បានឡានដែលមានមនុស្សនាក់ ។
ខ្ញុំចង់បានដែលមានទ្វាបួន ។
ខ្ញុំចូលចិត្តចំណតឡាន ។
ខ្ញុំពេញចិត្តឡានដែលចង្កឹះស្វ័យប្រវត្ត ។
តើរយៈពេលប៉ុន្មានថ្ងៃអ្នកចង់ជួលឡាន ?
តើបូករួមទាំងតម្លៃហ្គាសដែរទេ ?
តើការធានារ៉ាប់ត្រូវចាយលុយផ្សេងគ្នាមែរទេ ?
ខ្ញុំធ្វើការធានារ៉ាប់រង ។
ខ្ញុំចង់ដកចេញនូវការធានារ៉ាប់រងខ្លះ ។
តើតម្លៃប៉ុន្មានត្រូវបន្ថែម ប្រសិនបើខ្ញុំមកមិនទាន់ពេល ?
១០ដុល្លារការពិន័យ ។
សូមជួយលាងឡាន ។
ធ្វើឱ្យមានសំឡេងខ្លំាងណាស់ ។
សុំទោស ។ តើអ្នកជួយប្រាប់ផ្លូវទៅសណ្ឋាគារហីលតុន ?
ទៅត្រង់តាមផ្លូវនេះ ប្រហែលជាប្រំាប្លុក ហើយនៅជិតឱ្យស្ថានកាច់ជ្រុង ។ ពេលទៅដល់ទីនោះបត់ស្តាំ ។ អ្នកឃើញនៅខាងស្តំាដៃ ។
ខ្ញុំយល់ ។ អរគុណសម្រាប់ការប្រាប់ ។
តើអ្នកអាចប្រាប់ខ្ញុំបានទេផ្លូវទៅហ្សីដេផានមួយណា ?
សុំទោស ខ្ញុំវង្វេងផ្លូវហើយ ។
សុំទោស ខ្ញុំគិតថា ខ្ញុំវង្វេងផ្លូវ ។ តើខ្ញុំនៅកន្លែងណា ?
ខ្ញុំគ្មានសាច់ញាតិនៅជិតនេះទេ ។
តើនៅផ្នែកណានៃទីក្រុងនេះ ?
តើអ្នកមានគំនិតខ្លះទេ អំពីអាសយដ្ឋាននេះទេ ?
តើធនាគារកណ្តាលនៅទីណា ?
តើអ្នកបង្ហាញខ្ញុំផ្លូវទៅប្រៃយណីបានទេ ?
តើអ្នកដឹងផ្លូវទៅសណ្ឋាគារហីលតុនទេ ?
តើខ្ញុំទៅហ្សីដេផាកដូចម្តេច ?
តើផ្លូវទៅហ្សីដេផាកត្រឹមត្រូវទេ ?
តើមានផ្លូវកាត់ទៅហ្សីដេផាកទេ ?
តើអ្នកអាចប្រាប់ផ្លូវទៅប្រៃយណីបានដែរទេ ?
តើអ្នកអាចបង្ហាញផ្លូវទៅហ្សីដេផាកបានដែរទេ ?
តើអ្នកអាចប្រាប់ផ្លូវទៅសណ្ឋាគារផ្លាហ្សាបានដែរទេ ?
នៅជុំវិញកាច់ជ្រុងនោះ ។
ទៅត្រង់តាមផ្លូវនេះ ។
ទៅត្រង់តាមផ្លូវចម្ងាយប្រហែលជា១៥ម៉ែត្រ ។
សូមមេត្តាបត់ស្តាំ ។
សូមបត់ស្តាំនៅជិតភ្លើងចរាចរណ៍ ។
ខាងក្រោមកាច់ជ្រុង បត់ឆ្វេងជិតភ្លើងចរាចរណ៍ ។
អ្នកនឹងឃើញអគាពណ៌ស ? នៅទល់មុខអគារនោះ ។
វានៅក្រោយអគារ ។
វានៅបន្ទាប់ពីអគារនោះ ។
ត្រូវឆ្លងផ្លូវទល់មុខអគារនោះ ។
បត់ឆ្វេង នៅកាច់ជ្រុងមួយនោះ ។
ប្រហែលជា៥០០ម៉ែត្រ ។
វានៅឆ្ងាយបន្តិច ។
ប៉ុន្មានទីដើរពីនេះទៅ ?
អ្នកអាចដើរ ប៉ុន្តែប្រហែល៣០នាទី ។
ប្រហែលជាចំណាយពេលដប់នាទីជាង ។
អ្នកគួរតែទៅដោយឡានក្រុង ។
ល្អទេខ្ញុំទៅត្រង់ ?
សុំទោស ខ្ញុំចម្លែកណាស់នៅទីនេះ ។
ហេតុអ្វីមិនសួរប៉ូលិស ?
ខ្ញុំអាចទៅខ្លួនឯងបាន ។
ខ្ញុំនឹងទៅតាមផ្លួវនេះ ។
សុំទោស ខ្ញុំអាចរកបន្ទប់សម្រាក់ទីណា ?
តើមានបន្ទប់សម្រាកជិតទេ ?
ខ្ញុំសុំខ្ចីបន្ទប់សម្រាករបស់អ្នកបានទេ ?
នេះគឺកន្លែងធ្វើការ ។
យើងមានដំណើរកម្សាន្តកន្លះថ្ងៃ ពេញមួយថ្ងៃ និងពេលរាត្រីផង ។
ដំណើរក្សាន្តមួយណាល្អ ដែលអ្នកបានដឹង ?
ក្នុងករណីនេះខ្ញុំធ្វើដំណើរកម្សាន្តពេញមួយថ្ងៃ ។ នៅទឹកធ្លាក់ណៃហ្ការារួមទំាងនឹងដំណើរកម្សាន្តតាមដងផ្លូវ ។
ខ្ញុំមិនពេញដំណើរកម្សាន្តពេញថ្ងៃទេ ។
ខ្ញុំចង់បានផែនទីផ្លូវឡាន ។
កន្លែងណាខ្ញុំអាចទទួលបានផែនទីផ្លូវក្រោមនៅញ៉ូវយ៉ក ?
មានសៀវមគ្ខុទេសផ្សេងទៀតទេ ?
តើខ្ញុំអាចសុំក្រដាសស្តីអំពីដំណើរក្នុងទីក្រុងបានទេ ?
ខ្ញុំមិនចូលចិត្តទស្សនីយភាពទីក្រុងទេ ។
តើខ្ញុំអាចសុំលិខិតខ្លីស្តីពីទស្សនីយភាពទីក្រុងបានទេ ?
តើអ្នកចាំនូវដំណើរកម្សាន្តបានទេ ?
តើឡានប្រភេទណាសម្រាប់មើលទស្សនីយភាពទីក្រុង ?
អ្នកមានឡានដំណើតកម្សាន្តទស្សនីយភាពកន្លះថ្ងៃទេ ?
ខ្ញុំមិនចូលចិត្តដំណើរកម្សាន្តទឹកជ្រោះណៃហ្គារាទេ ។
តើដំណើរកម្សាន្តសារមន្ទីរដែលអ្នកបានឃើញ ?
អ្នកមានដំណើរកម្សាន្តមួយណាខ្ញុំអាចចូលរួមមើលការសម្តែង ?
តើអ្នកមានដំណើរកម្សាន្តតាមកោះទេ ?
អ្នកអាចប្រាប់ខ្ញុំលម្អិតអំពីដំណើរកម្សាន្តបានទេ ?
តើបូករួមទំាងទៅទស្សនានៅកោះឌីហ្ស៊ីនី ?
យើងចំណាយពេលយូរទេ ?
តើគិតរួមទំាងអាហារដែរទេ ?
ខ្ញុំមិនចំណាយច្រើនជាងដំណើរកម្សាន្តនេះ ។
កន្លែងណាខ្ញុំទទួលទានអាហារថ្ងៃត្រង់បាន ?
តើអ្នកមានពេលទំនេរក្រៅពីដំណើរកម្សាន្ត ?
ក្មេងជំទង់ពីរនាក់ និងក្មេងៗបីនាក់ ។
ខ្ញុំអាចថតរូបនៅក្នុងសារមន្ទីរបានទេ ?
សុំទោស ជួយថតរូបឱ្យបានទេ ?
សុំទោស អ្នកអាចឱ្យរូបថតខ្ញុំបានទេ ?
សុំថតយករូបយកអគារនោះជាផ្ទៃខាងក្រោយ ។
សូមចុះចំណុចខាងក្រោមបន្ទាប់ភ្លើងក្រហម ។
សុំទោស ខ្ញុំអាចថតរូបជាមួយអ្នកបានទេ ?
ខ្ញុំមានអារម្មណ៍មិនស្រួល ហើយដូចជាឈឺទ្រូងខាងស្តាំ ពេលខ្ញុំប៉ះ
កន្លែងហ្នឹងហើយ ខ្ញុំពិបាកដកដង្ហើមណាស់ ។
ខ្ញុំមិនសូវស្រួលខ្លួន ។
ខ្ញុំកំដៅឡើងសាមសិនប្រាំបីអង្សាសេ ។
ខ្ញុំមានអារម្មណ៍មានវិលមុខ ពេលក្រោកឈរ ។
ខ្ញុំឈឺក្បាលខ្ទកៗ ។
ខ្ញុំឈឺក្បាលស្ទើបែក ។
ខ្ញុំរោគប្រកាំង ។
ខ្ញុំឈឺត្រង់ក ។
មាត់របស់ខ្ញុំមានពងបែក និងឈឺ ។
ធ្មេញរបស់ខ្ញុំឈឺខ្ទកៗ ។
ខ្ញុំមានអារម្មណ៍ឈឺធ្មេញ ។
ភ្នែកខាងស្តាំខ្ញុំស្រវាំង ។
មានសំឡេងខ្លំាងនៅក្បែរត្រចៀកខ្ញុំ ។
ខ្ញុំអារម្មណ៍ថាឈឺទ្រូង ។
ខ្ញុំរលាក់ភ្លើង ។
ខ្ញុំឈឺក្រពះ ។
ខ្ញុំឈឺចង្កេះ ។
ខ្ញុំមានបញ្ហាចង្កេះ ។
ខ្ញុំមានជំងឺទល់លាមក ។
ស្មារបស់ខ្ញុំមានស្នាមជាំ ។
អ្នកមានបញ្ហាអ្វី ?
តើអ្នកមានរាគទេ ?
តើមានបន្ទរបង់ទេព្រឹកមិញនេះ ?
តើអ្នកដេកលក់ស្រួលទេ ?
ខ្ញុំនឹងចាក់ថ្នាំជូនអ្នក ?
ដកដង្ហើមចេញ ចូល ។
ខ្ញុំមានគ្មានអ្វីទេ ?
អ្នកកុំញ៉ាំអាហារធ្វើឱ្យធាត់ ។
យកវិជ្ជបញ្ជានេះទៅហ្វាម៉ាហ្ស៊ី ។ អ្នកអាចទទួលបានថ្នាំពិសា ។
នេះគឺលិខិតបញ្ជាក់របស់ខ្ញុំ ។
ចូរអ្នកបំពេញលិខិតនេះបានទេ ?
តើអ្នកមានថ្នាំក្រពះផ្សេងទៀតទេ ?
តើខ្ញុំញ៉ាំម្តងប៉ុន្មានគ្រប់គ្រាន់ ?
ខ្ញុំញ៉ាំពេលណា ?
ញ៉ាំនៅពេលអ្នកមានអារម្មណ៍ថាឈឺខ្លាំង ។
ញ៉ាំបីពេលក្នុងមួយថ្ងៃ ក្រោយពេលបាយ ។
ញ៉ាំម្តងមួយគ្រប់គ្រាន់ មុនចូលគេង ។
រទេះភ្លើងមួយណាអ្នកជិះ ?
រទេះភ្លើងមួយនោះទើបចេញទៅ ។ ខ្ញុំបើកឡាននៅមុខរថភ្លើង ។
តើកាបូបប្រភេទណា ?
កាបូបស្បែកពណ៌ត្នោត ។
តើមានអ្វីខ្លះ ?
កាបូបលុយ ទិដ្ឋការ លិខិតធ្វើដំណើរ និងសម្ភារៈមានតម្លៃមួយចំនួន ។
ខ្ញុំទុកកាបូបលុយកន្លែងមួយ ។
ខ្ញុំភ្លេចនៅក្នុងឡាន ?
កាបូបលុយរបស់ខ្ញុំកាបៅនៅលើរថភ្លើង ។
អ្នកណាមួយលួចកាបូបលុយខ្ញុំ ។
ម៉ាស៊ីនថតរូបខ្ញុំត្រូវគេលួច ពេលចេញពីបន្ទប់ ។
អ្នកគួរតែទូរសព្ទទៅប៉ូលិសឥឡូវនេះ ?
ខ្ញុំគិតថាមាននរណាចូលបន្ទប់ខ្ញុំ ។
គេបានយកអ្វីចេញខ្លះពីបន្ទប់របស់អ្នក ?
ចិញ្ចៀន និងលបមើល ។
ខ្ញុំបានបាត់កាបូបលុយចេញពីដៃខ្ញុំ ។
តើកាបូបភេទណាដែលបានបាត់ទៅ ?
គឺកាបូបដែពណ៌ខ្មៅ ។
លិខិតឆ្លងដែរ សំបុត្រធ្វើដំណើរ និងលុយសុទ្ធមួយចំនួន ។
មួយរយដូល្លារជាលុយសុទ្ធ និងកាតឥនទានរបស់ខ្ញុំ ។
ខ្ញុំមិនចង់ប្រាប់ពីការបាត់លិខិតឆ្លងដែនទេ ។
តើមានលិខិតសំខាន់ៗអ្វីខ្លះសម្រាប់ដំណើរការ ?
កន្លែងណាដែលខ្ញុំធ្វើម្តងទៀតបាន ?
សុំជួយលុបកាតឥនទានរបស់ខ្ញុំ ។
នេះជាកំហុសរបស់ខ្ញុំ ។
ខ្ញុំធ្វើបណ្ណធានារាប់រងអំពីហានិភ័យផ្សេងៗ ។
នាវាបានលិចបាត់ ។
ធូលីបានលិចចុះ ។
សួស្តី ។ ខ្ញុំចង់សួរអំពិការបន្ទប់ស្រគួរបស់ខ្ញុំ ។ ឈ្មោះរបស់ខ្ញុំ កៃកូ អូហ្គាដា ។
ខ្ញុំយល់ហើយ ។ ជើងហោះហើររបស់អ្នកលេខប៉ុន្មាន ?
ខ្ញុំធ្វើដំណើរជើងទីមួយភ័យ ទៅតូក្យូថ្ងៃទី១៥ ខែតុលា ។
ខ្ញុំចង់កក់កៅអីមួយទៅតូក្យូ ។
ខ្ញុំចង់ដឹងលេខកៅអីធើ្វដំណើរទៅតូក្យូ នៅថ្ងៃទី១៨ ខែសីហា ។
ខ្ញុំកក់សំបុត្រពីឡូអាន់ជីលែស ទៅតូក្យូ ។
ខ្ញុំធ្វើដំណើរនៅថ្ងៃទី១៥ ខែឧសភា ។
តើមានជើងហោះហើរដោយផ្ទាល់ទៅតូក្យូទេ ?
តើថ្លៃប៉ុន្មានពីឡូអាន់ជីលែសទៅតូក្យូ ?
ខ្ញុំនឹងបញ្ជាក់ពីការកក់ទុករបស់ខ្ញុំម្តងទៀត ។
សូមបញ្ជាក់ពីជើងហោះហើររបស់ខ្ញុំ ។
ខ្ញុំឈ្មោះ ហ្កែនជីហ្កាតូ ។ ជើងហើររបស់ខ្ញុំគឺ ប៊ីអេ បី អូ ប្រាំ ទៅតូក្យូ នៅថ្ងៃទី១៤ ខែមិថុនា ។
ខ្ញុំចង់ដឹងការកក់ទុករបស់ខ្ញុំតូក្យូ ។ អ្នកអាចពិនិត្យមើលម្តងទៀតបានទេ ?
ខ្ញុំចង់ប្ដូរជើងហោះហើរលេខ បី សូន្យ ប្រាំ នៅថ្ងៃទី១៨ ខែកក្កដា ។
ខ្ញុំចង់ប្ដូរទៅថ្ងៃទី១៩ ខែសីហា ។
ខ្ញុំធ្វើដំណើរនៅថ្ងៃទី១៩ ជើងហោះហើរដដែល ។
ខ្ញុំអាចប្ដូរការកក់ទុកទៅជើងហោះហើរផ្សេងទៀតបានទេ ?
តើជើងហោះហើរមួយណាដែលដំណើរការបាន ?
ខ្ញុំទៅដោយផ្ទាល់ ។
តើម៉ោងប៉ុន្មានចាប់ពិនិត្យជើងហោះហើរ ?
ខ្ញុំកន្លែងស្រគួរទៅតួក្យូ ។
មួយណាអ្នកចាប់អារម្មណ៍ កៅអីមានជក់បារី កៅអីមិនជក់បារី ?
សុំយកកៅអីគ្មានជក់បារី ។
ខ្ញុំអាចប្ដូជើងហោះហើរស្រគួររបស់ខ្ញុំបានទេ ?
សូមដាក់ខ្ញុំនៅកន្លែងអង្គុយជិតមិត្តរបស់ខ្ញុំ ។
សូមបង្ហាញខ្ញុំជួរកៅអីអង្គុយ ។
ហិបរបស់អ្នកធ្ងន់ណាស់ ។
ខ្ញុំបន្ថែមតម្លែប៉ុន្មាន ?
ច្រកលេខប៉ុន្មានសម្រាប់ហោះហើរទៅតូក្យូ ?
គឺផ្លូវប្រាំលេខប្រំានោះមែនទេ ?
កន្លែងណាដែលទុកអីវ៉ាន់មិនគិតលុយ ?
រីករាយបានស្គាល់អ្នក ។
សូមផ្តល់ទំនាក់ទំនងទៅគ្រួសាររបស់អ្នក ។
ខ្ញុំសុំទោស នូវទង្វើរបស់ខ្ញុំ ។
វាជាកំហុសរបស់ខ្ញុំ ។
អ្នកកុំនិយាយ ។
មិនមែនអញ្ចឹងទេ ។
ខ្ញុំអាចដាក់កាបូបកន្លែងណា ?
ខ្ញុំចង់បានទឹកខ្លះ ។
អាហារត្រៀមបម្រើនៅលើតុ ?
សូមបិតភ្លើងនេះ ។
តើអ្នកមានថ្នាំបន្ថយការឈឺចាប់ទេ ?
ខ្ញុំមានអារម្មណ៍គ្រាន់បើហើយ ។
ខ្ញុំសុំចូលរួមនិយាយជាមួយអ្នក ។
ខ្ញុំមិនចូលចិត្តបារីទេ ។
តើថ្លៃប៉ុន្មានគិតជាលុយជប៉ុន ?
ខ្ញុំគ្មានកាបូបអីវ៉ាន់សំរាប់ផ្ញើទេ ។
តើត្រូវបង់លុយប៉ុន្មានសម្រាប់កាបូបខ្ញុំ ?
តើហិបរបស់ខ្ញុំចេញកន្លែងណា ?
ពណ៌ត្នោតនោះជារបស់ខ្ញុំ ។
មិនអាចរកហិបខ្ញុំឃើញទេ ។
សុំជួករកហិបរបស់ខ្ញុំ ។
ខ្ញុំមកទីនេះគឺដើម្បីទេសចរណ៍ ។
ខ្ញុំស្នាក់នៅមួយអាទិត្យ ។
នៅសណ្ឋាគារផ្លាសា ក្នុងទីក្រុងញ៉ូវយ៉ក ។
ខ្ញុំមានធុរផ្ទាល់ខ្លួន ។
អ្នកជួបដូរលុយយ៉េនជប៉ុនបានទេ ?
សូមបង់ប្រាក់សុទ្ធសំបុត្រធ្វើដំណើរ ។
ប្រំា ម្ភៃ ដប់ ដប់ ហើយសុំលុយខ្លះៗ ។
កន្លែងណាខ្ញុំអាចស្វែងរកមជ្ឈមណ្ឌល់ព័ត៌មានទេសចរណ៍ ?
អ្នកអាចណែនាំសណ្ឋាគារល្អនៅក្បែរនេះបានទេ ?
មិនស្នាក់នៅទីស្នាក់ការទេសចរណ៍នោះទេ ។
សុំយកកាបូបនេះទៅឡានតាក់ស៊ីឈប់នោះ ។
ផុយណាស់ ។ សូមកាន់ទៅឡានពិសេស ។
នេះគឺជាលិខិតបញ្ជាក់ និងលិខិតឆ្លងដែនរបស់ខ្ញុំ ។
ខ្ញុំកក់នៅរយៈពេលបីថ្ងៃ ។
នេះគឺបន្ទប់គ្រែមួយ និងបន្ទប់ទឹក មិនអីញ្ចឹង ?
ខ្ញុំប្រហែលជាត្រូវយឺតបន្តិច ។
សុំកុំលុបការកក់ទុករបស់ខ្ញុំ ?
ខ្ញុំនៅទីនោះប្រហែលម៉ោង១០រាល់យប់ ។
តើសណ្ឋាគារបើករាល់យប់ដែរឬទេ ?
ខ្ញុំនឹងស្នាក់នៅពីរថ្ងៃ ។
ខ្ញុំទៅស្នាក់នៅមួយអាទិត្យ ។
ខ្ញុំចូលចិត្តស្នាក់នៅបន្ទប់បែរមុខទៅបឹង ។
ខ្ញុំសុំមើលសេវាកម្មបន្ទប់ផ្សេងៗ ។
សូមយកសាំងវ៉ិចពីរ ។
ខ្ញុំចង់អោយហៅទូរស័ព្ទដាស់ពេលព្រឹក ។
នេះគឺទូរសព្ទបន្ទប់លេខ១៥ ។ សូមដាស់ខ្ញុំនៅម៉ោងប្រាំពីរ ។
ខ្ញុំត្រូវអ៊ុតសម្លៀកបំពាក់របស់ខ្ញុំឱ្យរួចសិន ។
ខ្ញុំមិនឱ្យខោរបស់ខ្ញុំទក់ទេ ។
អ្នកអាចយកទៅរសៀលថ្ងៃស្អែកបានទេ ?
សម្លៀកបំពាក់ខ្ញុំត្រូវការប្រើច្រាសដុស ។
មានភាពមិនប្រក្រតីនៃម៉ាស៊ីនត្រជាក់នៅក្នុងបន្ទប់របស់ខ្ញុំ ។
ឈុតទូរទស្សន៍មិនដំណើរការ ។
ខ្ញុំចង់មើលទស្សនីយភាពទីក្រុងនៅក្នុងឡាន ។
ខ្ញុំចង់ស្តាប់តន្ត្រីនៅយប់នេះ ។ សូមរៀបចំជូនខ្ញុំ ។
សូមរៀបចំកៅអីពិសេស ។
សុំប្រាប់ខ្ញុំ ទៅមជ្ឈមណ្ឌលកីឡាដោយវិធីណា ។
សុំជួយកាត់សក់បានទេ ?
សូមកុំប្ដូរមូដសក់ ។
ខ្ញុំចង់ទុកសក់ខ្លី ។
ខ្ញុំចង់កកសក់ និងផ្លុំសក់ ។
សូមទុកសក់ម៉ូដធម្មជាតិ ។
សូមទុកម៉ូដនេះសម្រាប់ឆ្នាំនេះ ។
ខ្ញុំចាកចេញពីអ្នក ។
សូមផ្ញើសំបុត្រដោយអ៊ីម៉ែល ។
តើថ្ងៃប៉ុន្មានសម្រាប់ការបន្ទាន់ ?
សុំជូនខ្ញុំនូវតែម ប្រំា មួយដុល្លារ ។
អ្នកគួរទួរសព្ទមកខ្ញុំពីក្រុងឡុនដុន ?
តូក្យូ អូ បី បី មួយ មួយ ពីរ ប្រាំបី ប្រាំមួយ ប្រាំពីរ ប្រាំ ។
ទាក់ទងពីមនុស្សម្នាក់ទៅមនុស្សដោយផ្ទាល់ ។
ខ្ញុំចេញមុនមួយយប់ ។
នេះកូនសោបន្ទប់ខ្ញុំ ។
អ្នកទទួលបានសំបុត្រធ្វើឬនៅ ?
ខ្ញុំពេញចិត្តការស្នាក់នៅរបស់ខ្ញុំទីនេះ ។
ខ្ញុំចង់កក់សំបុត្រសម្រាប់ការហោះហើររបស់អ្នកទៅញ៉ូវយ៉កថ្ងៃទី១៥ ខែកញ្ញា ។
អ្នកមានជើងហោះហើរផ្សេងទៀតទេ ?
ខ្ញុំត្រូវការកន្លែងអង្គុយជក់បារី ។
ខ្ញុំចង់បញ្ជាក់ជើងហោះហើររបស់ខ្ញុំ ។
ខ្ញុំចង់ប្ដូរជើងហោះហើរខ្ញុំទៅ ពីរ សូន្យ ប្រំា នៅថ្ងៃទីពីរខែតុលា ។
ខ្ញុំធ្វើម៉េចដើម្បីឆ្លងបារាស់នោះបាន ?
កន្លែងណាប្ដូរកន្លែងត្រួតចូល ?
ខ្ញុំបានទាក់ទៅជើងហោះហើរ ធីដុបល្វេអេ មួយ មួយ អូ ។
ចំណាយពេលប៉ុន្មាននាទីទៅព្រលាយន្តហោះ បើជីះតាក់ស៊ី ?
អ្នកអាចនាំខ្ញុំទៅព្រលានយន្តហោះបានទេ ?
អ្នកអាចទុកលុយអាប់បាន ។
នេះគឺជាឡានក្រុងទៅចំណតកណ្តាល ?
តើមានឡានក្រុងទៅហ្ស៊ីហ្គាហ្គូដោយផ្ទាល់ទេ ?
កន្លែងណាខ្ញុំអាចទទួលបាននូវទីស្នាក់កណ្តាលប្រិសណីយ៍ ?
ជួយប្រាប់ខ្ញុំពេលទៅដល់ផ្លូវរុក្ខវិថីលេខ១៥ ។
សុំសំបុត្រមួយសម្រាប់ទៅ ដូវើ ។
ខ្ញុំអាចទិញសំបុត្រទៅហ្ស៊ីហ្គាហ្គូទីនេះបាន ?
សុំពិសេសប្រញាប់ ។
ខ្ញុំចង់កក់សំបុត្រទៅឡុនដុន ។
ខ្ញុំចង់បានគ្រៃមួយនៅក្នុងរថភ្លើង ។
តើអ្វីជាកន្លែងចាយលុយបន្ទាន់ទៅប៊ូស្តុន ?
តើម៉ោងប៉ុន្មានរថភ្លើងចេញទៅឡុនដុន ?
នេះគឺជារថភ្លើងទៅញ៉ូវយ៉កមែនទេ ?
ឈប់ប៉ុន្មានដងពីទីនេះដែលឆ្លងកាត់ទៅចំណត ?
អ្នកប្ដូរកៅអីមែនទេ ?
នេះគឺជាបន្ទប់ពេញលេញ ?
ខ្ញុំចង់ជួលឡានសម្រាប់រយៈពេលបីថ្ងៃ ។
ខ្ញុំត្រៀមដំណើរពី អេវ៉ីស ក្នុងតូក្យូ ។
ឡានតូចចង្អៀតពេក ។
ឡានដើរដោយស្វ័យប្រវត្ត ។
សុំឡានជាមួយនិងដូចលេខដោយស្វ័យប្រវត្ត ។
ខ្ញុំចង់យកដែលមានការធានារ៉ាប់រង ។
សុំបញ្ជីសាខារបស់អ្នកមកខ្ញុំ ។
សុំត្រួតពិនិត្យខ្យល់ចេញ ។
សូមអញ្ចើញមកពិនិត្យ ។
ណែនពេកមិនដំណើរការ ។
អាគុយរបស់ខ្ញុំខ្សោយ ។
ខ្ញុំបិទទ្វារភ្លេចកូនសោខាងក្នុង ។
សូមប្រាប់ខ្ញុំ ធ្វើម៉េចខ្ញុំទទួលបានស្នាក់នៅកណ្តាល ?
សូមបង្ហាញខ្ញុំលើផែនទីនេះ ។
ខ្ញុំរកផ្លូវទៅសារមន្ទីរឃើញទេ ។
សូមជួយណែនាំភោជនីយដា្ឋនជប៉ុនល្អដល់ខ្ញុំ ។
ខ្ញុំចូលចិត្តញ៉ាំអាហារចិន ។
ខ្ញុំសុំកក់កន្លែងសម្រាប់ មនុស្សបួននៅម៉ោងប្រាំបីសម្រាប់ល្ងាចនេះបានទេ ?
តើខ្ញុំធ្វើម៉េចដើម្បីបានសម្លៀកបំពាក់ ?
ពួកខ្ញុំចង់អង្គុយតុជាមួយគ្នា ។
ពួកខ្ញុំចង់អង្គុយក្បែរបង្អួច ។
តើមានតុទំនេរដែរទេ ?
សូមបង្ហាញបញ្ជីមុខម្ហូប ។
តើអ្នកមានអ្វីដែលរៀបចំយ៉ាងពិសេសជាងនេះទេ ?
តើអ្នកមានស្រាទំពាំងបាយជូរទេ ?
ខ្ញុំត្រូវការបញ្ជីស្រា ។
ខ្ញុំចង់កុម្ម៉ង់ឥឡូវនេះ ។
ខ្ញុំសុំរៀបចំតុជូន ។
ខ្ញុំសុំយកមួយនេះ និងមួយនេះ ។
ខ្ញុំចាកចេញពីអ្នក ។
ខ្ញុំត្រូវការនំប៉័ង ។
ខ្ញុំញ៉ាំដូចនេះបានទេ ?
នេះគឺសំរាប់ខ្ញុំ ។
ខ្ញុំមិនបានហៅទេ ។
សូមជួយខ្ចប់វត្ថុអនុស្សាវរីយ៍ខ្ញុំផង ?
ខ្ញុំចូលរួមញ៉ាំបាយគ្រប់ពេល ។
សូមអញ្ជើញមកទៀត ។
សូមអ្នកហុចបឺរខ្ញុំបន្តិច ?
មួយនេះសម្រាប់ខ្ញុំ ។
ខ្ញុំត្រូវការហាំបឺរហ្គឺពីរ និងកូកាកូឡា ។
ខ្ញុំត្រូវការហតដក ។
សុំដើមស្ពៃខៀវនិង ទឹកប៉េងបោះ ។
កន្លែងផ្ទុកទំនិញមិនគិតលុយ ?
កន្លែងណាផ្ទុកខោកីឡាល្អ ?
សុំទោស ។ សុំជួយខ្ញុំបន្តិច ?
បង្ហាញខ្ញុំមូយនោះ ។
សុំបង្ហាញខ្ញុំមួយនោះ ដែលមានតម្លៃទាប ។
អ្នកមានទំហំតូចជាងនេះបន្តិចទេ ?
អ្នកអាចធ្វើឱ្យខ្លីជាងនេះបន្តិចបានទេ ?
សុំជួយខ្ចប់កាដូមួយនេះ ។
អ្នកអាចផ្ញើមកសណ្ឋាគារខ្ញុំបានទេ ?
សូមផ្ញើតាមអាសយដ្ឋាននេះ ដោយអ៊ីម៉ែលផ្ទាល់ ។
នេះគឺជាអាស័យដ្ឋានខ្ញុំ ។
ខ្ញុំអាចបង់ជាលុយយ៉េនជប៉ុនបានទេ ?
សុំជួយជួសជុល ឬផ្ញើបន្តមកខ្ញុំ ។
ខ្ញុំដាក់លុយក្នុងម៉ាស៊ីននេះ ប៉ុន្តែសំបុត្រចេញក្រៅ ។
ខ្ញុំទទួលបានដបទឹកផ្លែឈឺ តែខ្ញុំមិនបានផ្លាស់ប្ដូរ ។
ខ្ញុំប្រើហ្វាសបានទេ ?
ខ្ញុំចង់ថតរូបរបស់អ្នក ។
សួមជួយថតរូបឱ្យខ្ញុំបន្តិចបានទេ ?
សូមថតពីកន្លែងនេះ ។
សូមបញ្ចូលហ្វីលទៅក្នុងម៉ាស៊ីនថតរូប ។
ខ្ញុំត្រូវដុំខ្មៅពីដុំ និងពណ៌ខ្មៅ ។
សូមហៅគ្រូពេទ្យជនជាតិជប៉ុនម្នាក់ ។
សូមឱ្យថ្នាំបាត់ឈឺក្បាល់ដល់ខ្ញុំ ។
តើប៉ុន្មានគ្រប់គ្រាន់អ្នកញ៉ាំមួយថ្ងៃ ?
ខ្ញុំមិនមានអារម្មណ៍ធូរស្រាលអ្វីបន្តិចសោះ ។
អ្នកកន្លែងណាខ្ញុំធ្វើលិខិតឆ្លងដែនបាន ?
អ្នកអាចចេញម្តងទៀតបានទេ ?
ប៉ុស្តិ៍នៅកន្លែងណា ?
ខ្ញុំចង់និយាយប្រែភាសាជប៉ុន ។
អ្នកចូលចិត្តសាច់គោ ឬសាច់ត្រីសម្រាប់អាហារពេលល្ងាច ?
ខ្ញុំកាញ៉ាំកាហ្វេជាមួយអ្នកបើមានឱកាស ?
ពួកយើងរង់ចំាំកាហ្វេប្រហែលបួននាទី ។
សុំទោស ។ ខ្ញុំសុំការហ្វេបន្តិចបានទេ ?
អរគុណ ។ យើងទៅដល់ឡូអាន់ជីលែលនៅម៉ោងប៉ុន្មាន ?
ប្រហែលម៉ោង បី ម៉ោងធម្មតា ។
សុំទោស ។ អ្នកនិយាយយឺតបានទេ ?
សុំសាច់គោអាំង ។
ខ្ញុំញ៉ាំសាច់ត្រី ។
ខ្ញុំកាញ៉ាំកាហ្វេជាមួយអ្នកបើមានឱកាស ?
ខ្ញុំសុំភួយបានទេ ?
ខ្ញុំសុំកាហ្វេបន្តិចបានទេ ?
ខ្ញុំសុំសណ្តែកដីបានទេ ?
នៅឡូអាន់ជីលែសម៉ោងប៉ុន្មាន ?
ខ្ញុំមានអារម្មណ៍មិនល្អ ។
ខ្ញុំសុំថង់ពល់អាកាសបានទេ ?
កន្លែងនេះគ្មានកន្លែងដាក់ហិប ។
ខ្ញុំមើលកុនមិនឃើញទេ ។ តើមានកៅអីណាទំនេរទេ ?
ខ្ញុំស្នើមិនត្រូវការកន្លែងជក់បារី ។ អ្នករកកន្លែងផ្សេងបានទេ ?
អ្នកលក់វត្ថុទំនេរបានទេ ?
ខ្ញុំអាចព្យូរកាបូបនេះឱ្យជិតបានទេ ?
ជួយប្រាប់ខ្ញុំតើធ្វើយ៉ាងការនេះយ៉ាងណា ?
ខ្ញុំមិនបានទទួលបណ្ណកំណត់ទេ ។
នៅសណ្ឋាគារហ្វឺមែន ។
លោកជួយបើកកាបូបបន្តិចបានទេ ?
អ្នកមានស្រានិងឬបារីដែរទេ ?
នេះគឺជាគ្រប់គ្រាន់អ្វី ?
ទំាងនេះជាបំពង់ខ្យល់រោហឺតរបស់ខ្ញុំ ។ គ្រូរបស់ខ្ញុំបានបញ្ញាតិ ។
ខ្ញុំទៅលេងសាចញាតិ ។
រហូតដល់ទី១៥ ថ្ងៃសៅរ៍ ។
ខ្ញុំមកដល់ទីនេះប្រហែលដប់ថ្ងៃទៀត ។
នៅសណ្ឋាគារ ។ ខ្ញុំមិនទាន់បានកក់អ្វីរួចរាល់ទេ ។
ខ្ញុំមានគម្រោងទៅស្នាក់នៅជាមួយមិត្តភក្តិ ។ គាត់រស់នៅផ្លូវ ពីរ ម្ភៃ មួយ ។
ស្រាវីស្គីពីរដប និងកញ្ចប់បារី ។
ខ្ញុំមានស្រាសាកេ ។
រោគសញ្ញាជំងឺហឺត ។ លោកគ្រូបានប្រាប់ខ្ញុំ ។
ថ្នាំ ។ សម្រាប់ជំងឺបេះដូង ។
ថ្មីៗនេះអ្នកទៅប្រទេសណាខ្លះ ?
ខ្ញុំមកជប៉ុនដោយត្រង់តែម្តង ។
ពេលថ្មីៗនេះអ្នកមានបញ្ហាថ្នាំអ្វីខ្លះ ?
ផ្លូវមួយណាសម្រាប់ជនអន្តោប្រវេសន៍ំ ?
ខ្សែផ្សេងទៀតល្អទេ ?
នេះជាលិខិតឆ្លងដែន ។ អ្នកត្រូវការអ្វីទៀតទេ ?
សុំទោសតើសសេរយ៉ាងម៉េច ?
សុំទោសខ្ញុំមិនយល់មានន័យថាម៉េច ?
ខ្ញុំធ្វើការផ្នែកក្រុមហ៊ុនពាណិជ្ជកម្ម ។
ខ្ញុំធ្វើការក្រុមហ៊ុនអ្នកនៅសាខាហ្ស៊ីហ្គាហ្គូ ។
យើងជាមួយទេសចរណ៍ ។
យើងមកទីនេះដើម្បីកម្សាន្ត ។ កូនប្រុសខ្ញុំរស់នៅសែតាល ។
ខ្ញុំមកនេះដើម្បីរៀនភាសាអង់គ្លេស ។
ខ្ញុំស្នាក់នៅសាន់ប្រាន់ស៊ីស្គូពីរថ្ងៃ បន្ទាប់មកខ្ញុំទៅញ៉ូវយ៉ក ។
ខ្ញុំមិនប្រញាប់ទេ ។
ខ្ញុំចាកចេញនៅថ្ងៃទី១៩ ថ្ងៃសៅរ៍ ។
ខ្ញុំសុំប្ដូរសំបុត្រ ។ នៅទីនេះ ។
ខ្ញុំសុំប្ដូរសំបុត្រ ប៉ុន្តែខ្ញុំមិនមានសំបុត្រស្រគួរ ។
ខ្ញុំមានពីរពាន់ដុល្លារជាមូលប្បទានប័ត្រអ្នកទេសចរណ៍ ។
តើផ្លូវមួយណា កន្លែងយកអីវ៉ាន់ ?
តើកាបូបមកពីយន្តហោះអាត្លង់តិចជើងហោះហើរលេខបួននៅឯណា ?
នេះគឺជាកាបួបមកពីយន្តហោះជើងហោះអាមេរិចជើងហោះហើរលេខដប់មែនទេ ?
កាបួបមួយរបស់ខ្ញុំត្រូវបានខូច ។ តើខ្ញុំត្រូវឡើងទៅកន្លែងណា ?
ប្រអប់មួយមិនទាន់បានមកដល់ទេ ។ ប្រអប់មកទំាងនោះមកទេ ?
តើហិបជើងហោះហើរលេខ១២ចេញមកហើយឬនៅ ?
កន្លែងណាខ្ញុំរាយការណ៍ពីការបាត់កាបូបរបស់ខ្ញុំ ?
អត់ទោស ។ តើផ្លូវមួយណាកាបួបចេញ ?
តើមានកន្លែងប្ដូរប្រាក់នៅជុំវិញទីនេះ ?
ទីនោះជាឡានក្រុង ឬផ្លូវក្រោយដីទៅទីក្រុងមែនទេ ?
ទីនេះឡានក្រុងចេញម្ភៃនាទីម្តងគ្រប់ពេល ?
ខ្ញុំយកនៅកន្លែងណា ?
ខាងស្តាំខាងមុខ ។ អ្នកនឹងឃើញសញ្ញានោះ ។
តើទីនោះគឺជាចតឡាននៃសណ្ឋាគារមេត្រូ ?
ហ៊ឺ ។ នោះនៅទិសខាងកើត ។ គឺបាកទៅជិតទីនោះណាស់ ។ អ្នកគួរតែជិះតាក់ស៊ីនេះ ។
តើខ្ញុំត្រូវចាយលុយសម្រាប់ជិះតាក់ស៊ី ?
អូ ប្រហែលដប់ប្រំាដុល្លារ ។
សុំជូនខ្ញុំទៅសណ្ឋាគារមេត្រូ ។
គឺដប់ប្រាំដុល្លារមែនទេ ?
បាទ គ្មានបញ្ហាទេ ។ សូមលោកថែមពីរដុល្លារទៀត ។
តើផ្លូវមួយណាល្អសម្រាប់ទៅផ្សារកណ្តាលក្រុង ?
តើមានឡានសាធារណៈសម្រាប់ទៅទីក្រុងទេ ?
កន្លែងខ្ញុំអាចរកសេវាកម្មឡានក្រុងប្រចាំព្រលានយន្តហោះ ?
សុំទោស ផ្លូវក្រោមដីនៅកន្លែងណា ?
អត់ទោស ឡានតាក់ចតនៅកន្លែងណា ?
ឡានក្រុងប្រចាំព្រលានយន្តចតនៅសណ្ឋាគារមេត្រូទេ ?
តើឡាននេះចតនៅជិតសណ្ឋាគារហីលឡែនទេ ?
តើអ្នកទៅស្នាក់នៅសណ្ឋាគារទេ ?
តើថ្លៃប៉ុន្មានសម្រាប់ថ្លៃឡានក្រុងប្រចាំព្រលានយន្តហោះ ?
តើផ្លូវមួយថោកជាងគេសម្រាប់ទៅទីកណ្តាលទីក្រុង ?
សុំជួយជូនខ្ញុំទៅសណ្ឋាគារមេត្រូ ។
សូមទៅសណ្ឋាគារមេត្រូ ។
សុំដាក់ខ្ញុំនៅសណ្ឋាគារមេត្រូ ។
កន្លែងណាខ្ញុំទទួលព័ត៌មានស្តីអំពីទេសចរណ៍បានទេ ?
នៅជុំវិញនេះមានកន្លែងទីស្នាក់ការទេសចរណ៍ទេ ?
អ្នកអាចយកកាបូបនេះឱ្យខ្ញុំផងបានទេ ?
សូមជួយយកទៅទុកនៅឡានឱ្យខ្ញុំផងបានទេ ?
តើផ្លូវមួយណាទៅដល់ទីក្រុងលឿនជាងគេ ?
តើចំណាយពេលប៉ុន្មានដើម្បីទៅដល់ទីក្រុង ?
តើនេះជាចំណតឡានទៅទីក្រុងមែនទេ ?
ឡានក្រុងព្រលានយន្តហោះឈប់នៅទីនោះមែនទេ ?
អ្នកអាចប្រាប់ខ្ញុំបានទេ ពេលណាទៅសណ្ឋាគារហីឡែន ?
អ្នកអាចប្រាប់ខ្ញុំបានទេ ពេលណាយើងចាកចេញ ?
សុំទោស លោកជា លោក សូហ្សូគិ មកពីក្រុមហ៊ុនអគ្គិសនីដៃអីឈិមែនទេ ?
លោកសុខសប្បាទេ ? ខ្ញុំឈ្មោះ ដេត ហូជីស ជាអ្នកគ្រប់គ្រងយានអាវកាស ។
ល្អណាស់ អរគុណដែលអញ្ជើញមកជួបខ្ញុំ ។
បាទ ។ សូមលោកជួយបំពេញលក្ខខណ្ឌនេះ ?
លោកនេះកូនសោបន្ទប់ ។ បន្ទប់លេខ១៦ ដប់១២ ។
តើជណ្តើយន្តនៅកន្លែងណា ?
នៅខាងស្តាំជណ្តើរហើយបត់ទៅឆ្វេងដែ ។
អរគុណ ។ អូភោជនីយដ្ឋានបើកដំណើរការ ?
ខ្ញុំបានកក់តុញ៉ាំអាហារទុកមួយ ។
អ្នកគួរត្រៀមតុមួយសម្រាប់ឈ្មោះអង់ដូ ។
ខ្ញុំឈ្មោះ សូហ្សុគិ ។ ខ្ញុំបានកក់តុមួយសម្រាប់យប់នេះ ។
ខ្ញុំឈ្មោះម៉ាហ្សូគិ ។ កាហ្សុគិ អង់ដូ ។
ខ្ញុំចេញនៅថ្ងៃសុក្រពេលល្ងាច ។
ខ្ញុំនៅទីនេះបីយប់ ។
ខ្ញុំចេញពិនិត្យចេញនៅមុនព្រឹកថ្ងៃពុធ ។
ផ្លូវមួយណាទៅភោជនីយដ្ឋាន ?
លេខទូរសព្ទផ្ទះនៅឯណា ?
តើភោជនីយដ្ឋាននៅបើកដំណើរកាទេ ?
តើហាងកាហ្វេបើកនៅម៉ោងប៉ុន្មាន ?
តើពេលណាសេវាកម្មបន្ទប់បិតឈប់បម្រើការ ?
ខ្ញុំចង់កក់បន្ទប់មួយសម្រាប់ថ្ងៃសុក្រ ។ ខ្ញុំឈ្មោះ អង់ដូ ។
ខ្ញុំចង់កក់ពីពេលសម្រាប់ថ្ងៃចុងសប្ដាហ៍ នៅថ្ងៃទីម្ភៃបី និងម្ភៃបួន ។
តើអ្នកមានបន្ទប់ពីរទំនេរសម្រាប់យប់ថ្ងៃស្អែក ?
ខ្ញុំត្រូវការបន្ទប់មួយសម្រាប់យប់នេះ ។ តើអ្នកមានបន្ទប់ទំនេរទេ ?
តើអ្នកមានបន្ទប់ពីរគ្រែពីរទំនេរទេ ?
យើងត្រូវការបន្ទប់គ្រែពីរសម្រាប់ពីរយប់ ។
ថ្លៃប៉ុន្មានចំពោះគ្រែមួយ ?
បន្ទប់ទំាងពីរមានម៉ាស៊ីត្រជាក់ទេ ?
បន្ទប់ទំាងពីរនោះមានទូរទស្សពណ៌ទេ ?
ខ្ញុំត្រូវការបន្ទប់ដែលអាចមើលទេសភាពសមុទ្រឃើញ ?
មួយយប់ថ្លៃហុកសឹបដុល្លារមែនទេ ?
សម្រាប់ពីរយប់ មែនទេ ?
បន្ទប់នេះទើលាបថ្នំាថ្មី មែនទេ ?
មាននរណាមិនបានទទួលសាររបស់លោក សូហ្សុគិទេ ?
ប្រសិនមាននរណារកខ្ញុំ ប្រាប់គេថាខ្ញុំទៅហាងកាហ្វេ ។
គម្រោងការរបស់ខ្ញុំប្រហែលប្ដូរ ។ ខ្ញុំចង់សម្រាកបួនយប់ បីថ្ងៃ ។
ខ្ញុំអាចប្ដូរបន្ទប់គ្រែពីរមកគ្រែមួយបានទេ ?
តើអ្នកប្រាកដថាមិននៅក្រោមកក់របស់លោក សូហ្សូគិ ? ចុះលោក តេស្យូអូ ?
ទំាងនោះគឺជាកំហុសមួយចំនួន ។ ត្រូវបានកក់ទុកទំាងពីខែមុនម្ល៉េះ ។
ខ្ញុំមានលិខិតបញ្ជាក់នៃការកក់នេះ ។
ខ្ញុំគិតថានេះជាកំហុសរបស់អ្នក ។ បន្ទប់នេះចាយលុយហើយ ។ ខ្ញុំមានវិក្ក័យបត្រ ។
នៅក្នុងបន្ទប់ទឹកគ្មានចានសម្រាប់លាងមុខទេ ។
យើងសុំបន្ទប់គ្រែពីរ មិនមែនបន្ទប់ពីរទេ ។
ខ្ញុំបានប្រាប់តាមទូរសព្ទថាបន្ទប់នេះតម្លៃម្ផៃពីរដុល្លារក្នុងមួយយប់ មិនមែនចិតសឹបពីរដុល្លារទេ ។
ខ្ញុំបាត់កូនសោបន្ទប់ខ្ញុំ ។
បាទ ។ អ្នកមានសេវាកម្មបោកអ៊ុតទេ ?
ទាក់ទងទៅលេខប្រាំបួន និងមានមនុស្សម្នាក់មកទទួលហើយ ។
តើខ្ញុំអាចសម្អាតឈុតនៅយប់នេះ ?
បាទ ។ សេវាកម្មរហ័សទាន់ចិត្ត ។
បាទ ។ នេះបន្ទប់លេខបី លេខដប់ពីរ ។ មិនចូលចិត្តញ៉ាំហាំបឺហ្គឺ ស៊ាំងវិច និងកាហ្វេ ។
តើអ្នកមានស៊ុបពោតទេ ?
អត់ទេ ។ ខ្ញុំមិនពេញចិត្តទេ ។ យើងមានយើងម្ហូបបួស និងប៉េងបោះ ។
ប្រហែលជាម្ភៃពីរនាទី ។
តើមានហាងលក់កាដូទេនៅក្នុងសណ្ឋាគារនេះ ?
តើមានហាងកាហ្វេនៅក្នុងជាន់ក្រោមទេ ?
ខ្ញុំអាចទទួលបានឈុតនៅពេលយប់នេះទេ ?
ខ្ញុំអាចទទួលរបាយការណ៍វាយបានទេ ?
តើស្បែកជើងរបស់ខ្ញុំសម្អាតរួចហើយឬនៅ ?
បាទ ។ នេះបន្ទប់លេខបី លេខដប់ពីរ ។ មិនចូលចិត្តញ៉ាំហាំបឺហ្គឺ ស៊ាំងវិច និងកាហ្វេ ។
សូមអ្នកយកកែវបី និងទឹកកទៅបន្ទប់ពីរ ប៉ែតសិបប្រាំពីរ ?
អ្នកមានអ្វីមធ្យោបាយអ្វីដែលខ្ញុំទទួលបានយ៉ាងឆាប់រហ័ស ?
អ្នកបម្រើជួយយកនំចាក់ចុលឱ្យខ្ញុំបានទេ ?
តើអ្នកមានស្រាទំពាំងបាយជូទេ ?
តើកន្លែងណាខ្ញុំអាចដូរលុយបាន ?
តើម៉ោងប៉ុន្មានទើបសេវាកម្មបន្ទប់ឈប់បម្រើការ ?
ខ្ញុំមិនចូលចិត្តការទូរសព្ទដាស់ទេ ?
ខ្ញុំអាចទុកវត្ថុមានតម្លែនៅក្នុងសណ្ឋាគារនេះមានសុវតិ្ថភាពទេ ?
នៅសណ្ឋាគារមានហាងកាត់សក់ទេ ?
តើអ្នកមានបន្ទប់ទទួលភ្ញៀវដ៏ស្រស់ស្អាតទេ ?
នៅសណ្ឋាគារមានអាងហែលទឹកទេ ?
សម្រាប់ភ្ញៀវគេគិតលុយដែរទេ ?
តើអ្នកមានសូណាទេ ?
តើនៅសណ្ឋាគារមានកន្លែងលក់ម៉ាស៊ីនថតទេ ?
តើអ្នកលក់ផ្កានៅសណ្ឋាគារដែរទេ ?
តើនៅជាន់នោះមានម៉ាស៊ីនទឹកកកទេ ?
តើម៉ោងប៉ុន្មានទើបហាងកាហ្វេបិត ?
នៅជិតនេះមានហាងទំនិញទេ ?
តើកន្លែងណាមានលក់វត្ថុអនុស្សាវរីយល្អៗ ?
ខ្ញុំមិនចូលចិត្តបោកអាវម៉ាស៊ីន ហើយទក់ ។
ខ្ញុំមិនចូលចិត្តយកអាវដោយចុចនោះទេ ។
ខ្ញុំមិនចូលចិត្តបោកកក់ខោអាវទេ ។
ខ្ញុំមិនចង់ឱ្យបត់អាវនោះទេ ។
សូមកុំព្យួរខោអាវបានទេ ។
សូមកុំដាក់ស្មៅ ។
យូរប៉ុណ្ណាខ្ញុំអាចចុចយកអាវខ្ញុំបាន ?
ខ្ញុំអាចទទួលបានល្ងាចនេះទេ ?
ខ្ញុំត្រូវការប្រញាប់ប្រសិនបើអាចទៅរួច ។
តើខ្ញុំមានការចាត់តំាងទេ ?
ខ្ញុំត្រូវការកាត់សក់របស់ខ្ញុំ ។
តើថ្ងៃប៉ុន្មានសម្រាប់កក់សក់ និងកាត់សក់ ?
តើថ្លៃប៉ុន្មានសម្រាប់កាត់ និងខាត់ ?
តើអ្នកអាចកាត់បន្ថយពេលវេលាឱ្យខ្លីបន្តិចបានទេ ?
សូមចាក់ចេញផ្នែកខាងវែងបន្តិច ។
ខ្ញុំចង់កោរពុកមាត់ ។
ខ្ញុំអាចទិញវីដេអូទីនេះបានទេ ?
សូមអ្នកជួយបង្ហាញខ្ញុំមួយបានទេ ?
តើអ្នកមានសៀវភៅមគ្គទេសតំបន់នេះទេ ?
បាទ ។ ខ្ញុំបង្ករឱ្យទូរសព្ទចេញទៅក្រៅប្រទេសជាសាកល ។
ចាំមួយភ្លេច ។ ខ្ញុំភ្ជាប់ទំនាក់ទំនងទៅផ្នែកអ្នកចាត់ការ ។
ពិតណាស់លោក ។ សូមព្យួរឡើង ហើយខ្ញុំនឹងឱ្យអ្នកដឹង ខ្ញុំនឹងឱ្យខ្សែឆ្លងកាត់ ។
គាត់ឈ្មោះ មូរិមូតូ ។
ចាំមួយភ្លេច ។ ខ្ញុំលោក អូកាវា ទៅពិសាបាយថ្ងៃត្រង់ ។ តើលោកមានអ្វីផ្តាំផ្ញើទេ ?
មិនអីទេ អរគុណ ។ ជួយប្រាប់គាត់ថាខ្ញុំទូរសព្ទមកម្តងទៀតនៅពេលរសៀលនេះ ។
ខ្ញុំចង់ទូរសព្ទលក្ខណៈជាសាកល ។
ខ្ញុំត្រូវការអ្នកទាក់ទងដោយផ្ទាល់ទូរសព្ទទៅលោក ហារួល ដាវីឌ ។
ខ្ញុំចង់ទូរស័ព្ទពីទីនេះទៅឈីហ្គាហ្គូ ។
លេខទូរសព្ទគឺ បួន ពីរ ពីរ បី មួយ ប្រាំពីរ ប្រំា ។
លេខទូរសព្ទគឺ បួន ពីរ ពីរ បី មួយ ប្រាំពីរ ប្រំា, ប៉ុន្តែខ្ញុំមិនដឹងលេខកូដតំបន់ ។
ខ្ញុំចង់និយាយជាមួយលោក អូកាវ៉ា ។
សូមអញ្ជើញកញ្ញារ៉ូសេ ។
ខ្ញុំចង់និយាយជាមួយ ការែន រ៉ួយសេ ។
ឈ្មោះរបស់ខ្ញុំគឺ យូអីឈិ មូរិមូតូ ។
ប្រាប់គាត់ខ្ញុំទូរសព្ទទៅគាត់នៅពេលរសៀលនេះ ។
អ្នកអាចផ្ញើសារទៅគាត់បានទេ ?
សូមប្រាប់នាងផងថា ទូរសព្ទមកខ្ញុំពេលនាងចូលមកក្នុង ។
ខ្ញុំទំនាក់ទំនងប្រជុំតាមទូរសព្ទ ។
សូមទូរសព្ទពីស្ងានីយមួយទៅស្ថានីយមួយទៀត ។
អ្នកអាចប្រាប់លេខកូដតំបន់ផ្លូវល្វីស ?
តើលេខកូដទីក្រុងប៉ារីសប៉ុន្មាន ?
អ្នកអាចឱ្យលេខទូរសព្ទសណ្ឋាគារហីលតុនខ្ញុំបានទេ ?
ជួយប្រាប់សខ្ញុំបានទេពេលនេះនៅតូក្យូម៉ោងបុន្មាហើយ ?
អ្នកជួយប្រាប់ខ្ញុំលេខរបស់ជឺរីហាត ហែស អេ អា ? គាត់រស់នៅផ្លូវលេខបួន ដប់ពីរ ។
ទូរសព្ទទៅទីឡុងដុនថ្លៃប៉ុន្មាន ?
អត្រាការផ្កាប្រាក់ធ្លាក់ចុះទាបបំផុតពេលណា ?
អ្នកចាត់ការទទួលខ្ញុំនៅប៉ុស្តិប៉ូលិស ។
លោកចាក់ការនាំខ្ញុំទៅទីស្កាក់ការអគ្គិភ័យ ។
អ្នកចាត់ការខ្ញុំត្រូវការឡានសង្គ្រោះបន្ទាន់ ។
តើអ្នកសង្ឃឹមថានាងនឹងត្រឡប់ថ្ងៃនេះទេ ?
តើម៉ោងប៉ុន្មានគាត់ចូលធ្វើការ ?
ថ្ងៃគាត់នៅការិយាល័យទេ ?
ខ្ញុំចង់ផ្ញើទូរលេខទៅតូក្យូ ។
ខ្ញុំចង់ផ្ញើសារតាមម៉ាស៊ីទូរលេខ ។
ខ្ញុំចង់ផ្ញើរបស់ទំាងនេះទៅប្រទេសជប៉ុន ។
ចុះថ្លៃប៉ុន្មានអេអូក្រាម ?
មួយថ្លៃសាបសិបប្រាំមួយ ។
សូមឱ្យខ្ញុំពីរ ។
ថ្លៃប៉ុន្មានខ្ញុំផ្ញើអ៊ីម៉ែលទៅជប៉ុន ?
ផ្លូវគោក ឬផ្លូវអាកាស ?
ខ្ញុំសុំមើលបន្តិច, គឺមួយសែសេបប្រាំ ។
ខ្ញុំមានការធានារ៉ាប់រងទេ ?
អាវការពាររងា និងស្បែកជើង ។ កាដូសម្រាប់គ្រួសារខ្ញុំ ។
អូខេ ។ ដំបូងសូមពេញលិខិតនេះ ។
ការពិពណ៌នាអំពីមាតិកា ។
សូមជួយឱ្យអេអូក្រាមខ្ញុំចំនូនពីរ ។
ខ្ញុំត្រូវតែមតម្លៃដប់ សែសិបសេន ។
តើម៉ាស៊ីនអេអូក្រាមមួយថ្លៃប៉ុន្មាន ?
តើថ្លៃប៉ុន្មានខ្ញុំប៉ុស្តិកាតទៅជប៉ុន ?
សូមជួយធានារ៉ាប់រងដល់ខ្ញុំបានទេ ?
ខ្ញុំចង់ផ្ញើទៅជាពិសេស ។
អាវការពាររងា និងស្បែកជើង ។
សៀវភៅមួយក្បាល ។
យើងត្រូវការគ្រឿងបន្លាស់កាម៉េរា ។ ទំាងនោះសួយខ្លំាងណាស់ ។
តើខ្ញុំគិតរួមទុកគ្រប់យ៉ាងម៉ែនទេ ?
ខ្ញុំនឹងផ្ញើទំាងអស់នេះទៅលើកដំបូង ។
ខ្ញុំចង់ផ្ញើរបស់ទំាងនេះដោយប្រិសណីយ៍ ។
ខ្ញុំចង់ផ្ញើតាមរយៈអ៊ីម៉ែល
ទីនោះសៀវភៅមានអត្រាតម្លៃពិសេសទេ ?
តើថ្លៃប៉ុន្មានសម្រាប់ជើងហោះហើរទីមួយនេះ ?
តើថ្លៃប៉ុន្មានសម្រាប់ការផ្ញើតាមជើងទឹកទៅជប៉ុន ?
តើវត្ថុនេះទៅដល់ជប៉ុនពេលណា ?
ប្រសិនផ្ញើទំនិញតាមបញ្ជីរហ័ស, ពេលណានឹងទៅដល់ ?
តើមានអ្វីដែលរហ័សជាងនេះទៀតទេ ?
ខ្ញុំចង់ប្រាប់ថាតម្លៃការធានារ៉ាប់រងមួយរយដុល្លារ ។
ខ្ញុំសុំវិក្ក័យប័ត្រ ។
ខ្ញុំចង់ទិញកាតប៉ុស្តាល ។
សូមអ្នកជួយថ្លឹងឱ្យខ្ញុំបានទេ ?
តើអ្វីដែលវែងបំផុតកញ្ចប់បញ្ញើរនេះ ?
តើតម្លន់ប៉ុន្មានសម្រាប់កញ្ចប់បញ្ញើរទៅជប៉ុន ?
ខ្ញុំអាចផ្ញើនំទៅជប៉ុនបានទេ ?
ខ្ញុំសុំមើលបន្តិច ។ មួយរយដុល្លារ ។ តើអ្នកមានអាឌីកាតទេ ?
តើមានលិខិតឆ្លងដែរទេ ?
មិនអីទេ ។ សូមជួយចុះហត្ថលេខាផងបានទេ ?
ម្ភៃដុល្លារ ។ ហើយនឹងវិក្ក័យមួយចំនួនទៀត ។
អូខេ ។ ម្ភៃ សែសិប ហុកសឹប កៅសបប កៅសិបប្រាំ ប្រាំពីរ ប្រាំបី ប្រាំបួន មួយរយ ។
ទំាងអស់ថ្លៃប៉ុន្មាន ?
លេខទី ។ មានតម្លៃពន្ធប្រាំពីរភាគរយនៃការលក់ ។
ខ្ញុំចង់ដូរដប់ដុល្លារ ។
អ្នកអាចដូរលុយយេនទៅជាដុល្លារបានទេ ?
ខ្ញុំចង់បានម្ភៃដុល្លារ ។ ហើយវិក្ក័យបត្រសន្លឹកតូចមួយ ។
ខ្ញុំចង់បានដប់បួនដុល្លារ និងនៅសល់ខ្លះៗ ។
ខ្ញុំសុំមួយដុល្លារបួនសន្លឹក និងដូរយកខ្លះ ។
ទំាងអស់ខ្ញុំជំនាក់ប៉ុន្មាន ?
តើមានតម្លៃពន្ធផ្សេងៗទៀតទេ ?
តើខ្ញុំត្រូវបង់ពន្ធប៉ុន្មាន ?
តើអ្នកលក់សំបុត្រឡានក្រុងដែរទេ ?
តើខ្ញុំអាចផ្ញើលុយទៅញ៉ូវយ៉កបានទេ ?
ខ្ញុំរាប់លុយសុទ្ធបានទេ ?
ខ្ញុំចង់ទិញកាតនេះដោយប្រើលុយសុទ្ធ ។
ខ្ញុំចង់ដូរមួយម្ភៃដុល្លារ ។
ខ្ញុំចង់ទិញលុយខ្មែរជាដុល្លារ ។
តើអ្វីជាអត្រាការប្រាក់លុយយេន និងលុយដុល្លារ ?
មួយម្ភៃយេនដូរលុយដុល្លារបានប៉ុន្មាន ?
តើខ្ញុំអាចធ្វើការទូទាក់លុយអតុល្យភាព និងបង់ស្មើនិងលុយឡើងបានទេ ?
តើកាតឥតទានអ្វីដែលអ្នកទទួល ?
តើខ្ញុំអាចទទួលវិក្ក័យបត្រផ្សេងពីនេះបានទេ ?
សុំទោស ។ ខ្ញុំគិតថាអ្នកដូរលុយខ្ញុំខុស ?
សុំទោស ។ ខ្ញុំគិតថាជាកំហុសរបស់អ្នក ?
សុទោស ។ ទីនេះមានហាងផ្ទុកទំនិញទេ ?
បូមមីងហ្គាល់ គឺស្រស់ស្អាត ។
ជាការពិតណាស់ អ្នកតើបត់ឆ្វេងពេលអ្នកចេញពីសណ្ឋាគារ ។ អ្នកដើរបីប្លុកហើយបត់ឆ្វេងម្តងទៀត និងបន្តដំណើរទៅត្រង់ ។ អ្នកដើរឆ្លងថ្នល់ហើយឃើញហាងទំនិញ ខាងស្តាំដៃអ្នក ។
ដើរបត់ឆ្វេង, ដើរឆ្លង់កាត់បីប្លុក, បន្ទប់មកបត់ឆ្វេងម្តងទៀត ?
ជាការពិតណាស់ អ្នកតើបត់ឆ្វេងពេលអ្នកចេញពីសណ្ឋាគារ ។ អ្នកដើរបីប្លុកហើយបត់ឆ្វេងម្តងទៀត និងបន្តដំណើរទៅត្រង់ ។ អ្នកដើរឆ្លងថ្នល់ហើយឃើញហាងទំនិញ ខាងស្តាំដៃអ្នក ។
តើអ្នកអាចជួយសរសេរឈ្មោះជូនខ្ញុំបានទេ ?
សុទោស ។ តើផ្លូវមួយណាទៅប្លូមមីហ្កាល ?
ដើរទៅត្រង់ ។ នៅខាងស្តាំដៃអ្នក ។
ប្រហែលជាពីរប្លុក, ខ្ញុំគិត ។
នៅនោះមានកន្លែងចតឡានទេ ?
នេះហៅថា ប្លូមមីងហ្កាលមែនទេ ?
ផ្លូវលេខសាបសិប ផ្លូវទីពីរមែនទេ ?
អ្នកអាចសរសេរអាសយដ្ឋាន និងលេខទូរសព្ទឱ្យខ្ញុំបានទេ ?
អ្នកអាចជួយគូរផែនដីឱ្យខ្ញុំបានទេ ?
សុំទោស ។ តើខ្ញុំអាចទៅសារមន្ទីរមេត្រូប៉ូលីតាន់យ៉ាងម៉េច ?
អត់ទោស ។ កន្លែងណាជិតចំណតរថយន្តក្រោមដី ?
តើមានសារមន្ទីរនៅជិតសណ្ឋាគារដែរឬទេ ?
តើនៅជិតនេះមានកន្លែងគួរចាប់អារម្មណ៍ទេ ?
តើមានអ្វីដែលណែនាំយើងទេ ?
តើប្លូមមីងហ្កាលអាចដើរទៅដល់ទេ ?
តើមានប៉ុន្មានប្លកដើរទៅដល់បឹង ?
តើចម្ងាយប៉ុន្មានដើរទៅកន្លែងសម្រាក ?
អ្នកប្រាប់ខ្ញុំបានទេថា ពេលនេះខ្ញុំនៅកន្លែងក្នុងផែនទី ?
តើអ្នកមានបន្ទប់សម្រាក់ទេ ?
សុំទោស ។ តើបន្ទប់បុរសនៅកន្លែងណា ?
អត់ទោស ។ តើផ្លូវមួយណាទៅបន្ទប់នារី ?
សុំទោស ។ តើចំណតរថភ្លើងនៅកន្លែងណា ?
តើអ្នកអាចប្រាប់ខ្ញុំបានទេ ធ្វើដំណើរទៅចំណតរថភ្លើងដោយវិធីណា ?
នេះគឺផ្លូវទៅត្រង់ដល់ចំណតរថភ្លើងមែនទេ ?
តើឡាននេះទៅកាន់ទីក្រុងវ៉ាស៊ីនតោនមែនទេ ?
ប្រហែលជាដប់ពីរប្លុក ។
តើដឹងថាមានប៉ុន្មានចំណតទេ ?
តើខ្ញុំធ្វើម៉េចដើម្បីទទួលបាន អីវានស្ទូន ?
ជិះរថភ្លើងទៅហាហ្វឺត ។ បន្ទប់មកប្ដូរទៅអីវ៉ានស្ទូនវារហ័សជាង ។
នោះគឺផ្លូវរថភ្លើងទៅផ្លូវហាហ្វឺត ?
តើអ្នកទៅមជ្ឈមណ្ឌលកេនេឌី ?
តើមានឈប់ប៉ុន្មានដងដែរ ?
តើរថភ្លើងមួយណាដែលខ្ញុំអាចជិះទៅកាន់កោះអៀដឡង់ ?
តើមួយណាល្អបំផុតទៅកាន់ភូមិគ្រីនវិច ?
តើតម្លៃសំបុត្រថ្លៃប៉ុន្មាន ?
តើថ្លៃប៉ុន្មានទៅវ៉ាស៊ិនតោហ្វូកទ័រ ?
តើគម្រោងមួយណាដែលរថភ្លើងទៅហាហ្វឺត ?
តើឡានទីប្រាំឈប់ អេវឺនុយចតនៅទីនោះមែនទេ ?
តើខ្ញុំអាចជិះឡានទៅវ៉ាស៊ិនតោនហ្វតទ័រកន្លែងណា ?
ខ្ញុំចង់ទៅអេវានស៊ិន ។
ខ្ញុំព្យាយាមដើម្បីយកផ្លូវនៅខាងជើងសាលាក្រុង ។
ខ្ញុំគួរធ្វើដំណើរឡានក្រុង ឬរថយន្តក្រោមដី ?
ខ្ញុំអាចជិះឡានក្រោមដីទីនេះបានទេ ?
តើផ្លូវមួយលឿនបំផុតទៅទីនោះ ?
តើធ្វើដំណើរដោយអ្វីដែលងាយស្រួលបំផុត ?
យើងធ្វើដំណើរទៅហ្គោដិនហ្គេតមិនអញ្ចឹង ?
អ្នកចុះទៅឡាន់ទីប្រំាពីរអេវឺនុយ មិនអញ្ចឹង ?
រថភ្លើងនេះចតនៅបឹងធម្មជាតិ មែនទេ ?
នេះគឺតម្លៃផ្ទះល្វែង ?
ខ្ញុំអាចដូរកន្លែងណាបាន ?
តើថ្លៃប៉ុន្មានសម្រាប់ធ្វើការផ្ទេរ ?
អ្នកអាចប្រាប់ខ្ញុំបានទេពេលយើងទទួលបានសួនសត្វនេះ ?
តើកន្លែងណាដែលខ្ញុំសម្រាប់បិទមជ្ឈមណ្ឌលធ្វើពាណិជកម្ម ?
នេះគឺជាចំណតដ៏ត្រឹមត្រូវសម្រាប់សាកលវិទ្យាល័យ កូលូមបៀ ?
ខាងជើងអាវកាស ។ តើខ្ញុំអាចជួយអ្នកបានទេ ?
បាទ ។ តើអ្នកហោះហើរទៅកាន់ទីក្រុងសែតថល ?
បាទ យើងយល់ ។ ពេលណាអ្នកធ្វើដំណើរ ?
ថ្ងៃចន្ទអាទិត្យក្រោយ ថ្ងៃទីមួយម្ភៃដល់ថ្ងៃទីប្រំាបី ។ អ្នកធ្វើដំណើរមុនពេលព្រឹកទេ ?
យើងហោះហើរនៅម៉ោងប្រំាពីរ និងម៉ោងប្រាំបួនដប់១៥នាទី ។
តើមានអ្វីដែលមានតម្លែថោកបំផុត ការធ្វើដំណើរតាមផ្លូវ ?
ល្អហើយ ។ ខ្ញុំសុំកៅអីពីរសម្រាប់ជើងហោះហើរម៉ោងប្រាំពីរ ។ ហាមជក់បារី ។
ម៉ោង ដប់បីនាទី ។ ច្រកទីប្រាំពីរ ។
បន្ទប់មកទៀតជានរណា ?
រៀងរាល់កន្លះម៉ោងម្តង ។
អូខេ ។ សូមឱ្យសំបុត្រធ្វើដំណើរខ្ញុំមួយ ។
តើធ្វើដំណើរទៅទីក្រុងសែតថល ?
តើអ្នកមានជើងហោះហើរពេលព្រឹកទេ ?
តើនេះជារថភ្លើងទៅទីក្រុងវ៉ាស៊ីនតោនមែនទេ ?
យើងខ្ញុំចេញដំណើរនៅថ្ងៃចន្ទ ថ្ងៃទីដប់ពីរ និងដប់ប្រាំបី ។
ខ្ញុំចង់ធ្វើដំណើទៅប្រទេសប៉ូឡែននៅថ្ងៃពុធ បន្ទប់មកហោះហើរទៅ សាន់ប្រាន់ស៊ីស្គ នៅថ្ងៃសុក្រ ។
ខ្ញុំនៅតាមផ្លូវល្វីស មុនល្ងាចថ្ងៃច៍ន្ទ ។
តើថ្លៃប៉ុន្មានសម្រាប់ជម្រើសទីមួយ ធ្វើដំណើរទៅទីក្រុងប៉ូស្តុន ?
តើរថភ្លើងទៅមែមហ្វីសថ្លៃប៉ុន្មាន ?
ឱ្យខ្ញុំកៅអីពីរសម្រាប់ជើងហោះហើរនៅម៉ោងប្រំាពីរ ។
ខ្ញុំចង់កក់សំបុត្រនៅម៉ោងដប់មួយប្រញាប់ទៅទីក្រុងវ៉ាស៊ីនតោន ។
ម៉ោងប៉ុន្មានជើងហោះហើរទីមួយទៅទីក្រុងសែតថល ?
មួយណាជារថភ្លើងចុងក្រោយទៅញ៉ូវយ៉ក ?
តើអ្នកមានផ្ទះជួលសម្រាប់មួយអាទិត្យទេ ?
តើយើងធ្វើដំណើរយ៉ាងណាដើម្បីសន្សំសំចៃថវិកា ?
តើអ្វីដែលមានតម្លៃថោកបំផុត ?
តើខ្ញុំអាចកក់កន្លែងនេះបានទេ ?
តើច្រកទីដប់ពីរនោះជើងហោះហើរទៅកាន់ទីក្រុងវ៉ាស៊ីតោនមែនទេ ?
តើច្រកខាងស្តាំនេះសម្រាប់រថយន្តក្រុងទៅ ?
តើនេះទីស្នាក់រថភ្លើងទៅកាន់ទីក្រុងដេនវឺមែនទេ ?
តើំពីវ៉ាស៊ីនតោន ទៅអាត្លង់ទិកមានចម្លាយប៉ុន្មាន ?
តើរវាងជម្រើសថ្នាក់ដំបូង និងគ្រូបង្វឹកខុសគ្នាដូចម្តេច ?
តើថ្លៃប៉ុន្មានសម្រាប់ឡានដែលប្រញាប់ ?
ខ្ញុំចង់ជួលឡានមួយសំរាប់ប្រាំថ្ងៃ ។
អូខេ ។ យើងមានអត្រាការប្រាក់ពិសេសសម្រាប់ឡានរបស់យើង ។
បញ្ហាសេដ្ឋកិច្ចយើងនឹងនៅធម្មតា ។
ខ្ញុំអាចជួនអ្នក វិសាល ឆេវី ចំនួនសែសឹបពីរដុល្លារ ក្នុងមួយសប្ដាហ៍ ដោយគ្មានការកំណត់ ។
ពិតទេ ? គិតរួមទាំងអស់មែនទេ ?
បន្ថែមប្រាំបួនដុល្លារសម្រាប់ការប្រើប្រាស់ហ្គាស និងការសម្រេចរបស់ស៊ីឌីដុបល្វេ ហើយនឹង១២ដុល្លារទៀតសម្រាប់ការធានារ៉ាប់រងប្រចាំថ្ងៃ ។
នេះជំនួសការខូចខាតទំាងអស់ ។ ប្រសិនជាអ្នកគ្មានទំនួយខុសត្រូវចំពោះរថយន្តនោះ ។
ខ្ញុំយល់ ។ តើអ្វីជាការធានារ៉ាប់រង ?
ខ្ញុំត្រូវការឡានសម្រាប់មួយអាទិត្យ ។
ខ្ញុំចង់ជួលឡានសម្រាប់មួយថ្ងៃ ។
ខ្ញុំចង់ដឹងទំហំឡាន ។
តើបូកបញ្ចូលអ្វីខ្លះ ?
តើអ្វីជា ភីអេអាយ ?
តើអ្វីជាការធានារ៉ាប់រង ?
តើមានតម្លៃចាយទេ ?
ចេញពីឡាននៅព្រលានយន្តហោះម៉ៃមីបានទេ ?
នោះគឺជាអត្រាការប្រាក់ប្រចាំខែ ?
មានទ្វាពីរ ឬទ្វាបួន ?
ចង្កិះលេខស្វ័យប្រវត្ត ?
តើវាមានហ្វ្រាំធម្មតាទេ ?
តើមួយថ្ងៃយើងកិនប៉ុន្មានតោន ?
នេះគឺជាគំរូចុងក្រោយបង្អស់ ?
តើខ្ញុំអាចទទួលកាតឥនទានដែរឬទេ ?
តើបូករួមទំាងតម្លៃធានារ៉ាប់រងមែនទេ ?
តើបូកបញ្ចូលការធានារ៉ាប់រងគ្រោះហានិភ័យដែរឬទេ ?
តើបូករួមទំាងតម្លៃធានារាប់រងគ្រោះថ្នាក់ផ្សេងៗដែរទេ ?
តើចំនួនប៉ុន្មានសម្រាប់ការកិនស្រូវ ?
តើអ្នកមានបញ្ជីឈ្មោះរបស់ការិយាល័យផ្សេងៗទេ ?
ប្រសិនបើខ្ញុំមានបញ្ហាផ្សេងៗ ហើយខ្ញុំគួរហៅនរណា ?
សូមជួយបំពេញ ។ អ្វីដែលគ្មានប្រយោជន៍ ។
សូមបំពេញចំណេះដឹងខ្ពស់ ។
លុយចំនួនប្រាំដុល្លារសម្រាប់លើកទឹកចិត្ត ។
តើផ្លូវមួយណាទៅបន្ទប់ទឹក ?
តើអ្នកមានផែនទីទីក្រុងម៉ៃមីទេ ?
តើផ្លូវមួយណាគឺ កុងហ្គូដ ?
តើខ្ញុំធ្វើយ៉ាងណាដើម្បីបានទៅចក្រភពឌីស្នី ?
តើផ្លូវណាដែលទៅដាលាស ?
កន្លែងណាសម្រាប់បត់ទៅសួនផ្ការីក ?
ផ្លូវនេះគឺផ្លូវលេខ១២មែនទេ ?
ផ្លូវនោះទៅដាលីលមែនទេ ?
ផ្លូវនេះខ្ញុំអាចទៅដល់អូដិនទេ ?
តើអ្នកអាចបង្ហាញពីផែនទី ពេលនេះខ្ញុំនៅទីណា ?
តើផ្លូវល្វីសគឺជាផ្លូវល្អបំផុតមែនទេ ?
តើចម្ងាយប៉ុន្មានពីរផ្លូវហៃវេ សែសិបប្រាំបួន ?
តើទៅប៉ូឡែនមានចម្លាយប៉ុន្មាន ?
តើត្រូវការរយៈពេលប៉ុន្មានដើម្បិទៅទីក្រុង វាងខ្យូវើ ?
ជីវីស្វ័យប្រវត្តិ ។ ខ្ញុំអាចជួយអ្នកបានទេ ?
បាទ ។ ឡានខ្ញុំខូចនៅរដ្ឋលេខកៅប្រាំ ។ អ្នកអាចមកជួយស្ទូចទៅបានទេ ?
បាទ ។ ច្បាស់ទេកន្លែងដែលអ្នកនៅ ?
ខ្ញុំនៅទិសខាងជើង, មុន ពេលចេញពីសែលបែត ។ ពេលប្ដូរភ្លើងក្រហម ។
ខ្សែក្រវ៉ាត់ខ្ញុំខូចហើយ ។
ខ្ញុំមិនអាចចាប់ផ្តើមបានទេ ។
វាមានសំឡេងរំខានពេលខ្ញុំបើកឡានចុះ ។
មានក្លិនស្អូយចេញពីក្រោមប្រអប់រថយន្យ ។
នរណាក៏ដោយសុំជួយទូរសព្ទហៅឡានសង្គ្រោះបន្ទាន់ផង ។
មាននរណាម្នាក់ទូរសព្ទហៅប៉ូលិស ។
ខ្ញុំមិនបានឃើញនាងមកសោះ ។
ខ្ញុំធ្វើដំណើរនៅប្រហែលសាបសិបប្រាំនាទីក្នុងរយៈពេលមួយម៉ោង ។
នាងមិនឈប់ឡានពេលភ្លើងក្រហម ។
ខ្ញុំចាប់ហ្រ្វាំងនៅពេលឡានរអិលព្រឹលធ្លាក់ចុះក្រោម ។
គាត់ខ្នងដាក់ខ្ញុំ ។
ខ្ញុំសុំមើលអាញ្ញាបណ្ណ និងការចុះឈ្មោះរបស់អ្នកបានទេ ?
នេះជាអាញ្ញាបណ្ណខ្ញុំ ។ នេះគឺជាឡានជួល ។
ខ្ញុំចាប់អារម្មណ៍ដំណើរកម្សាន្តនៃមហាតាន់ ។
តើដំណើរកម្សាន្តតាមទីក្រុង ឬជុំវិញកោះដោយទូក ?
ដោយទូក ? លោកនិងបានឃើញអ្វី ?
ច្រើនដងទេទៅនិងទស្សនាកំសាន្ដ ?
ពីរដងក្នុងមួយថ្ងៃ ។ ពេលព្រឹកនិងរសៀល ។ រថយន្ដក្រុងនាំទៅហើយនាំត្រឡប់មកវិញ ។
