សុំឱ្យសិក្ខាកាមរំលឹកឡើងវិញនូវអាហារទាំងបីក្រុម និងគោលបំណងនៃការបរិភោគអាហារទាំងបីក្រុមនេះ។
ប្រាប់សិក្ខាកាមថា៖ យើងនឹងមានបទបង្ហាញខ្លីមួយ ហើយបន្ទាប់មកលេងល្បែងសំណួរមួយ ដូច្នេះសូមព្យាយាមចងចាំអ្វីដែលអ្នកនឹងឃើញ និងបានស្តាប់ឮ។
សុំឱ្យសិក្ខាកាម មើលតារាងដែលបង្ហាញពីតម្រូវការកាឡូរីប្រចាំថ្ងៃសម្រាប់មនុស្ស រួមទាំងអ្នករស់នៅជាមួយមេរោគអេដស៍ក្នុងឯកសារមេរៀនទី២ (ក្នុងសៀវភៅសម្រាប់អ្នកចូលរួម)។
ក្មេងភាគច្រើន លើកលែងក្មេងអាយុ១៥–១៨ឆ្នាំ មានតម្រូវការថាមពលតិចជាង មនុស្សពេញវ័យ។ ប៉ុន្តែ បើនិយាយពីតម្រូវការថាមពលក្នុងទម្ងន់ខ្លួនមួយគីឡូក្រាមវិញ
កុមារដែលរស់នៅជាមួយមេរោគអេដស៍ (តែគ្មានជំងឺ) ក៏ត្រូវការថាមពល ២០% ថែមទៀតដែរ។ សរុប ៥២០ ទៅ ២៧៥៥កាឡូរី/ថ្ងៃ អាស្រ័យលើអាយុកុមារ។
ពន្យល់៖ នៅពេលមនុស្សម្នាក់បានឆ្លងមេរោគដូចជាមេរោគអេដស៍ រាងកាយរបស់គេ ត្រូវការប្រើប្រាស់ថាមពលច្រើន និងសារជាតិចិញ្ចឹមពីអាហារ ដើម្បីការពាររាងកាយ ប្រឆាំងមេរោគ និងថែទាំរាងកាយឱ្យមានសុខភាពល្អ។ ហេតុដូច្នេះ នៅពេលមានជំងឺ ពួកគេត្រូវការថាមពលកាន់តែច្រើន។
បង្កើនភាពញឹកញាប់ក្នុងការបរិភោគអាហារពេល និងអាហារសម្រន់៖ គេអាចបន្ថែមថាមពលតាមរយៈ ការបរិភោគអាហារបន្ថែមជាប្រចាំ ឬបរិភោគឱ្យបានញឹកញាប់ជាងមុន ដូចជាអាហារតិចៗ នៅចន្លោះបីទៅបួនម៉ោងម្តង។
បង្កើនភាពចម្រុះនៃអាហារផ្សេងៗ ដែលសំបូរទៅដោយសារជាតិចិញ្ចឹម និងសិ្ថតនៅក្នុងក្រុមអាហារទាំងបី។
ក្មេងដែលរស់នៅជាមួយមេរោគអេដស៍ (និងឈឺដោយសារជំងឺឆ្លង និងស្រកទម្ងន់) ត្រូវការថាមពលបន្ថែម ៥០–១០០%។ សង្ខេបខ្លឹមសារ៖
តើនរណាត្រូវការថាមពលច្រើនជាងរវាងបុរស និងស្ត្រីមានផ្ទៃពោះ និង/ឬស្ត្រីបំបៅដោះកូន?
តើនរណាត្រូវការថាមពលច្រើនជាងរវាង អ្នករស់នៅជាមួយមេរោគអេដស៍ ដែលមានជំងឺ និងអ្នករស់នៅជាមួយមេរោគអេដស៍ដែលគ្មានជំងឺ?
តើនរណាត្រូវការថាមពលច្រើនជាងរវាង ក្មេងដែលមានជំងឺ និងក្មេងគ្មានជំងឺ?
តើចំណីអាហារទាំងអស់សុទ្ធតែមានថាមពល ឬតែមួយចំនួនទេ?
តើអ្នកណាត្រូវការថាមពលច្រើនជាងរវាងអ្នករស់នៅជាមួយមេរោគអេដស៍ដែលមានជំងឺ និងអ្នករស់នៅជាមួយមេរោគអេដស៍ដែលគ្មានជំងឺ?
អ្នកសម្របសម្រួលអាចបន្ថែមសំណួរខ្លួនឯង ដើម្បីរម្លឹកខ្លឹមសារក្នុងមេរៀននេះ។
យើងត្រូវការចាំបាច់នូវអាហារូបត្ថម្ភល្អ ដើម្បីទ្រទ្រង់នៅក្នុងគ្រប់ដំណាក់កាលនៃវដ្តជីវិត មុនកំណើតទារកភាព កុមារភាព វ័យជំទង់ និងពេលពេញវ័យ។ នៅក្នុងមេរៀននេះ យើងនឹងរម្លឹកពីតម្រូវការនៃអាហារូបត្ថម្ភទៅតាមដំណាក់កាលនៃរដ្តជីវិត គឺនៅពេលស្ត្រីមានផ្ទៃពោះ(មុនកើត) ស្ត្រីក្រោយពេលកើតនិងបំបៅដោះ ទារក កុមារភាព (មុន ពេលចូលរៀន និងគ្រប់អាយុចូលរៀន) វ័យជំទង់ និងពេញវ័យ។ យើងអាចកែប្រែឱ្យ ស្ថានភាពអាហារូបត្ថម្ភបានប្រសើរឡើង នៅក្នុងគ្រប់ដំណាក់កាលនៃវដ្ដជីវិត និងបង្ការកង្វះអាហារូបត្ថម្ភបាន។
សំនួរ៖ ហេតុអ្វីបានជាអាហារូបត្ថម្ភល្អមានសារៈសំខាន់ចំពោះស្ត្រីមានផ្ទៃពោះ?
ការងារ និងសកម្មភាពផ្សេងៗ៖ បើស្ត្រីមានផ្ទៃពោះធ្វើការងារច្រើន ឧទាហរណ៍មើលថែក្មេងតូចៗ និងប្រមូលផលដំណាំ គាត់នឹងមានតម្រូវការថាមពលច្រើនជាងស្ត្រីមានផ្ទៃពោះម្នាក់មិនសូវធ្វើសកម្មភាពការងារច្រើន។
ពន្យល់៖ បន្តិចទៀតក្នុងពេល យើងនឹងសិក្សាលម្អិតទៅលើប័ណ្ណរស់នៅប្រកបដោយសុខភាពល្អលេខ២១ (ការបរិភោគត្រឹមត្រូវនៅពេលមានផ្ទៃពោះ ឬបំបៅដោះកូន)។
សាច់ត្រី ខ្ចៅខ្យង ស៊ុត បន្លែសន្លឹកពណ៌បៃតង។ ក្រៅពីនេះ ជាធម្មតាស្ត្រីត្រូវការជាតិដែកបន្ថែមដើម្បីចៀសវាងភាពស្លេកស្លាំង ជាពិសេសបើមិនបានបរិភោគសាច់ពណ៌ក្រហមទៀងទាត់
មានជាតិទឹកគ្រប់គ្រាន់ ទោះបីជាពេលអាកាសធាតុក្តៅក៏ដោយ
ប្រសិនបើម្តាយឈឺខ្លាំង អាចនឹងមានការលំបាកក្នុងការបំបៅដោះកូន។
រយៈពេលនៃការបំបៅដោះកូន៖ ម្តាយបំបៅដោះកូនកាន់តែយូរ គ្រោះថ្នាក់នៃ ការចម្លងមេរោគអេដស៍កាន់តែខ្ពស់។ ការស្រាវជ្រាវខ្លះបង្ហាញថាគ្រោះថ្នាក់នេះកើនឡើងខ្ពស់ក្រោយរយៈពេល៦ខែ។
បូសដោះ (ខ្ទុះកើតមានបណ្តាលមកពីមេរោគ) ក្បាលដោះដាច់រលាត់ (ប្រេះ) និងរោគរលាកដោះ (រលាកញឹកញាប់ បង្កឱ្យកើតរោគឆ្លង) សុទ្ធតែជាឱកាសនៃការបញ្ជូនឈាម និងផ្លាស់ស្មាដែលមានមេរោគអេដស៍កម្រិតខ្ពស់
ត្រូវធានាឱ្យមានទឹកស្អាតសម្រាប់ប្រើប្រាស់ក្នុងផ្ទះ និងក្នុងសហគមន៍ និង
បន្ទាប់មក ពន្យល់អំពីអនុសាសន៍របស់ “គោលការណ៍ណែនាំជាតិស្តីពី ការបង្ការការចម្លងមេរោគអេដស៍ពីម្តាយទៅកូន”៖
តម្រូវការជាតិដែកសម្រាប់ទារក និងកុមារតូចៗ៖
កុមារមានអាយុ១-៥ឆ្នាំ៖ ត្រូវការជាតិដែក៩-១០ មីលីក្រាមក្នុងមួយថ្ងៃ ដែលទទួលបានពីការបរិភោគ ថ្លើមមានបរិមាណស្មើនឹងពាក់កណ្តាលចានចង្កឹះ និងបន្លែបៃតងចំណុះមួយចានចង្កឹះ ឬក្រលៀនចម្អិនចំណុះ ២/៤ ចានចង្កឹះ ឬបន្លែបៃតងចម្អិន មានចំណុះ១ចានចង្កឹះ ឬតៅហ៊ូ២ចានចង្កឹះ។
រូបភាពនេះបង្ហាញពីគ្រឿងផ្សំមួយចំនួនសម្រាប់ចម្អិនបបរខាប់គ្រប់គ្រឿងដែលមានគ្រប់សារជាតិចិញ្ចឹម។ វានឹងជួយឱ្យកុមារដែលបរិភោគបបរនេះមានកម្ពស់ខ្ពស់ រឹងមាំ ឆ្លាត និងរៀនឆាប់ចេះ។
យុទ្ធសាស្ត្រសម្រាប់កុមារ និងទារក (អាយុពី ៦– ២៤ខែ)៖
ម្តាយឬអណាព្យាបាលគួរលើកទឹកចិត្តឱ្យកុមារបរិភោគអាហារឱ្យបានគ្រប់គ្រាន់ស្របទៅតាមវ័យរបស់ពួកគេ
សុំឱ្យក្រុមនិមួយៗធ្វើបទបង្ហាញពីប្រធានបទរបស់ខ្លួនទៅក្រុមដទៃ
ការបង្កើនការបរិភោគអាហារដើម្បីសម្រួលដល់ “សន្ទុះការលូតលាស់”
កុមារអាយុពី ៣-៥ឆ្នាំ(កុមារមត្តេយ្យ)
កុមារអាយុលើសពី៥ឆ្នាំ (កុមារគ្រប់អាយុចូលរៀន)
សំណួរ៖ តើអ្នកនៅចាំក្រុមអាហារទាំង៣ដែលយើងបានរៀនដែរទេ?
ចូលរួមតាមដានការលូតលាស់ឱ្យបានជាប្រចាំ និងមានកិច្ចពិភាក្សាដើម្បីធានា ឱ្យកុមារលូតលាស់បានល្អ និងអាចដឹងអំពីកង្វះអាហារូបត្ថម្ភដែលពួកគេអាចមាន (ឧ.
កាលណាក្មេងជំទង់មានការលូតលាស់កម្ពស់ល្អ វានឹងផ្តល់ប្រយោជន៍យ៉ាងច្រើននៅពេលពួកគេក្លាយទៅជាមនុស្សពេញវ័យ ដូចជាសមត្ថភាពបំពេញការងារខ្ពស់ ងាយស្រួលក្នុងការផ្តល់កំណើតកូន និងកាត់បន្ថយគ្រោះថ្នាក់ ចំពោះមាតានៅពេល សម្រាល និងជួយកាត់បន្ថយលទ្ធភាពក្នុងការបង្កើតកូនមិនគ្រប់ទម្ងន់។
មានសុខភាពល្អគ្រប់គ្រាន់ដើម្បីចូលសាលារៀន និងមានការវិវឌ្ឍន៍ការគិតបានប្រសើរបំផុត
សមត្ថភាពការងារ និងបញ្ញាអាចធ្លាក់ចុះ ដោយសារកង្វះអាហារូបត្ថម្ភរយៈពេលយូរ និងការលូតលាស់មិនល្អ
សុខភាពផ្លូវចិត្ត និងសុខភាពសង្គមអាចចុះខ្សោយ
ទទួលបានការអប់រំ និងថែទាំសុខភាព រួមមានការពន្យាកំណើត ឬការពន្យាការមានផ្ទៃពោះរហូតដល់ក្មេងស្រីជំទង់ជាម្តាយលូតលាស់បានពេញលេញ និងដល់កម្ពស់អតិបរមាសិន។
បើសិក្ខាកាមមានចំនួនច្រើនជាងសំណួរ អ្នកសម្របសម្រួលអាចប្រើសំណួរដដែលមួយ ចំនួន ឬបង្កើតសំណួរថ្មីដែលទាក់ទងនឹងមេរៀន។ សិក្ខាកាមនីមួយៗត្រូវឆ្លើយសំណួរឱ្យបានត្រឹមត្រូវ មុនពេលពួកគេអាចបិទលេខរបស់ពួកគេនៅលើជញ្ជាំង។ ប្រសិនបើ ពួកគេមិនដឹងចម្លើយត្រឹម ពួកគេអាចទទួលជំនួយពីអ្នកស្ម័គ្រចិត្តផ្សេងបាន ប៉ុន្តែអ្នក ដែលឆ្លើយមិនត្រូវ មិនអាចចូលរួមប្រកួតក្នុងការសន្ធឹងបិតក្រដាសទេ។ សិក្ខាកាមដែល អាចបិតលេខបានខ្ពស់ជាងគេនៅលើជញ្ជាំងគឺជាអ្នកឈ្នះ។ អបអរសាទរពួកគេ។
សុំឱ្យសិក្ខាកាមមើលឯកសារមេរៀនទីពីរ (សៀវភៅសម្រាប់សិក្ខាកាម) ហើយប្រាប់ពួកគេថា រាល់ព័ត៌មានទាំងអស់ដែលបានពិភាក្សាកន្លងមកក្នុងមេរៀនទីពីរគឺមាននៅក្នុងឯកសារមេរៀននេះ។
អ្នកសម្របសម្រួលបង្ហាញពីវត្ថុបំណងពីការសិក្សាដែលបានសរសេរលើក្រដាសផ្ទាំងធំ ហើយឱ្យសិក្ខាកាមម្នាក់អាននូវគោលបំណងទាំងនោះឱ្យឮដល់ក្រុម។
នៅចុងបញ្ចប់នៃមេរៀនសិក្ខាកាមនឹងអាច ធ្វើការអនុវត្តជំហ៊ានទាំងប្រាំនៃការផ្តល់ប្រឹក្សាអំពីអាហារូបត្ថម្ភ និងអាចបំពេញទម្រង់តាមដាន។
“ប័ណ្ណអាហារធំៗ” បង្ហាញពីរូបភាពចានសំប៉ែត និងចានគោមធំៗដែលមានបាយ សម្ល និង បង្អែម៘ ប័ណ្ណនេះអាចជួយអ្នកក្នុងការបង្ហាញដល់អ្នករស់នៅជា មួយមេរោគអេដស៍អំពីបរិមាណអាហារដែលពួកគេគួរបរិភោគ។
រូបភាព“កែវទឹក” ជារូបភាពដែលមានកែវទឹកបីប្រភេទផ្សេងគ្នា សម្រាប់ប៉ាន់ប្រមាណចំណុះទឹក និងសារធាតុរាវផ្សេងៗដែលអ្នករស់នៅជាមួយមេរោគ អេដស៍តែងទទួលទានក្នុងមួយថ្ងៃ និងចំណុះដែលគាត់គួរទទួលទានក្នុងមួយថ្ងៃ។
តារាងសន្ទស្សន៍ម៉ាស់រាងកាយ (BMI) សម្រាប់មនុស្សពេញវ័យ (ទាំងពីរភេទ និងស្ត្រីទើបសម្រាលកូនរួចក្រោយពី៦ខែ)៖ ឧបករណ៍នេះនឹងជួយអ្នក វាស់វែងសន្ទស្សន៍ម៉ាស់រាងកាយតាមវិធីធម្មតា ដោយមិនចាំបាច់គណនា ដោយប្រើរូបមន្ត។
តារាងសន្ទស្សន៍ម៉ាស់រាងកាយសម្រាប់កុមារ និងក្មេងជំទង់អាយុ៥-១៨ឆ្នាំ របស់ជំនួយបច្ចេកទេសអាហារូបត្ថម្ភ និងស្បៀងអាហារ៖ ជាឧបករណ៍ទាន់ចិត្តមួយសម្រាប់វាស់សន្ទស្សន៍ម៉ាស់រាងកាយ (ទម្ងន់ធៀបនឹងកម្ពស់) របស់កុមារ និងក្មេងជំទង់ដោយមិនចាំបាច់គណនាដោយប្រើរូបមន្ត។
សម្រាប់កុមារអាយុ៦–៥៩ខែ អ្នកនឹងចាំបាច់ត្រូវមានម៉ែត្ររង្វាស់ពាក់កណ្តាលដើមដៃ សម្រាប់កុមារ។ បើអតិថិជនរបស់អ្នកជាកុមារអាយុចាប់ពី៥ឆ្នាំងឡើងទៅ អ្នកនឹងត្រូវ មានតារាងសម្រាប់រកសន្ទស្សន៍ម៉ាស់រាងកាយ និងតារាងសន្ទស្សន៍ម៉ាស់រាងកាយតាម អាយុសម្រាប់កុមារ និងក្មេងវ័យជំទង់អាយុ៥–១៩ឆ្នាំ។ ក្មេងប្រុស និងក្មេងស្រីមាន សន្ទស្សន៍ម៉ាស់រាងកាយផ្សេងពីគ្នា។
សម្រាប់កុមារ និងក្មេងវ័យជំទង់អាយុពី០-១៩ឆ្នាំ (សំណួរទី៨)
ពន្យល់៖ យើងនឹងបន្តការវាតយតម្លៃដោយសួរអតិថិជននូវសំណួរខ្លះអំពីភាពញឹកញាប់ និងគុណភាពនៃរបបអាហាររបស់គាត់។ ការ បរិភោគអាហារ និង ទឹកក្នុងបរិមាណ មិនគ្រប់គ្រាន់ក្នុងមួយថ្ងៃៗ និងការបរិភោគអាហារមិនសូវមានជីវជាតិគ្រប់គ្រាន់គឺជាមូលហេតុចម្បងនៅក្នុងប្រទេសកម្ពុជា ដែលនាំឱ្យមានកង្វះអាហារូបត្ថម្ភ។ នេះគឺជា រឿងដែលងាយដោះស្រាយបំផុត ហេតុនេះហើយបានជាកញ្ចប់សម្ភារៈអាហារល្អផ្តោត ទៅលើចំណុចទាំង២នេះដើម្បីផ្តល់ប្រឹក្សា។
ភាពញឹកញាប់នៃអាហារពេល អាហារសម្រន់ និងភេសជ្ជៈសម្រាប់មនុស្សពេញវ័យទាំងពីរភេទ ស្ត្រីមានផ្ទៃពោះ និងស្ត្រីសម្រាលកូនរួចក្នុងអំឡុង៦ខែ (សំណួរទី១០)
ក.ជាធម្មតា តើអតិថិជនបរិភោគអ្វីខ្លះជាប្រចាំ?
ភាពញឹកញាប់នៃអាហារពេល អាហារសម្រន់ និងភេសជ្ជៈសម្រាប់កុមារ និងក្មេងជំទង់ អាយុ០–៩ឆ្នាំ (សំណួរទី១០ ក្នុងទម្រង់វាយតម្លៃសម្រាប់កុមារ និងក្មេងជំទង់– ទម្រង់សម្រាប់សហគមន៍)
គូសក្នុងប្រអប់ដែលសមរម្យដើម្បីបង្ហាញតើអាហារអ្វីដែលកុមារ បរិភោគសម្រាប់អាហារពេលព្រឹក ថ្ងៃត្រង់ ពេលល្ងាច និងអាហារសម្រន់
បន្ទាប់ពីទទួលបានចម្លើយពីពួកគាត់ សូមពន្យល់ពណ៌ទាំងនោះតំណាងឱ្យក្រុមអាហារ ដែលយើងបានសិក្សាក្នុងមេរៀនទី២គឺ អាហារស្ថាបនារាងកាយ អាហារការពារ និង អាហារថាមពល។
ស្វាយ៖ បណ្ណ័ពណ៌ស្វាយមិនមែនជាក្រុមអាហារទេ។ វារួមបញ្ចូលទាំង “គ្រឿងផ្សំបន្ថែមជីវជាតិ” ដែលអាចបង្កើនកាឡូរី និង/ឬតម្លៃនៃសារជាតិចិញ្ចឹមសម្រាប់សម្ល និងអាហារផ្សេងៗទៀត។ គ្រឿងផ្សំបន្ថែមជីវជាតិមានដូចជា ដូង ខ្ទិះដូង ប្រេងឆា/ខ្លាញ់ គ្រាប់ធុញ្ញជាតិ ទឹកដោះគោខាប់ សៀង និងណ្តែក ជាដើម។
នៅក្នុងប្រអប់នេះវាយតម្លៃក្រុមអាហារណាមួយដែលអតិថិជនតែងតែបរិភោគ ជា្របចាំ។ សម្រាប់សំណួរនេះ អ្នកផ្តល់ប្រឹក្សាត្រូវបង្ហាញប័ណ្ណអាហារតូចៗនៅ លើតុ។ ដោយមើលម្តងមួយពណ៌ ឬដោយមើលប័ណ្ណទាំងអស់ដាក់ចំរុះចូល គ្នានៅលើតុ ឱ្យអតិថិជនដកយកប័ណ្ណអាហារដែលពួកគាត់តែងតែបរិភោគ។ អ្នកអាចសួរសំណួរខ្លះអាចសួរដូចជា តើសម្លរបស់អ្នកដាក់អ្វីខ្លះ?
បើអតិថិជនបានបរិភោគក្រុមអាហារទាំងអស់ ចូរគូសប្រអប់ “មាន”។
ផ្តល់ឱកាសឱ្យសិក្ខាកាមបំពេញព័ត៌មាននៅលើទម្រង់តាមដាន។ ឱ្យសិក្ខាកាមពន្យល់ ប្រាប់អ្នកពីរបៀបបំពេញ (ប្រើប្រាស់ក្រដាសផ្ទាំងធំ ឬក្តារខៀន)។ ធ្វើការកែតម្រូវ សំខាន់ៗមួយចំនួនទៅលើឧទាហរណ៍របស់អ្នកស្រីប៉េង ហើយពន្យល់ពីវិធីត្រឹមត្រូវនៃ ការបំពេញទម្រង់។
បើអតិថិជន មានសន្ទស្សន៍ម៉ាស់រាងកាយក្រោម ១៨.៥ គេអាចសនិដ្ឋានបានថា អតិថិជនទទួលបានអាហារមិនគ្រប់គ្រាន់។ ក្រៅពីការប្រឹក្សាផ្នែកអាហារូបត្ថម្ភ ត្រូវបញ្ជូនអតិថិជនរូបនេះត្រូវទៅកាន់មណ្ឌលសុខភាព ឬមន្ទីរព្យាបាល OI/ART។
ផ្តល់យោបល់/អនុសាសន៍ជាក់ស្តែងដែលអាចអនុវត្តបាន។ វិធីសាស្ត្ររៀបចំ របបអាហារគួរធ្វើឱ្យសមស្របទៅតាមបរិបទក្នុងស្រុក ដោយគិតគូរទៅលើប្រវត្តិប្រើប្រាស់ឱសថរបស់អតិថិជន អាហារដែលអាចរកបានក្នុងមូលដ្ឋាន និងបញ្ហាគ្រួសារ វប្បធម៌ ហិរញ្ញវត្ថុ ព្រមទាំងជំនឿផ្ទាល់ខ្លួន អំពីអាហារ និងរបបអាហារ
Rollnick និង Masson (ឆ្នាំ ១៩៩៥) បានកំណត់នូវទស្សនៈខុសឆ្គងមួយចំនួន របស់អ្នកប្រឹក្សា ឬបុគ្គលិកផ្នែកសុខភាព។ ទស្សនៈទាំងនេះអាចបន្ថយប្រសិទ្ធិភាពនៃការប្រឹក្សា និងការអប់រំអំពីអាហារូបត្ថម្ភ៖
អតិថិជនរូបនេះចង់ផ្លាស់ប្តូរ
