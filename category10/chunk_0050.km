កិច្ចព្រមព្រៀងរវាង NMU និងជនអ្នកច្បាប់;
"អញ្ជើញ" អាចត្រូវបានផ្តល់ឱ្យ:
បុគ្គលអ្នកច្បាប់, ដែលមានកិច្ចព្រមព្រៀងមួយជាមួយនឹងមជ្ឈមណ្ឌលអប់រំរដ្ឋអ៊ុយក្រែនអន្ដរជាតិអំពីអង្គការនៃការចូលរៀនរបស់បរទេសសម្រាប់ការសិក្សានៅលើមូលដ្ឋាននៃកិច្ចព្រមព្រៀងជាមួយ NMU.
ជនបរទេសដែលទទួលបាន "អញ្ជើញ", បន្ទាប់ពីការប្រតិបត្តិនៃទិដ្ឋាការធាតុនៅអ៊ុយក្រែនកុងស៊ុលនៃ MFA, មានកាតព្វកិច្ចដើម្បីជូនដំណឹង NMU អំពីទីកន្លែងនិងកាលបរិច្ឆេទនៃច្រកចូលទៅអ៊ុយក្រែន.
ប្រសិនបើមានជនបរទេសទទួលបាន "អញ្ជើញ", មិនអាចផ្លូវចូលទៅកាន់អ៊ុយក្រែនសម្រាប់ការសិក្សា, "អញ្ជើញ" មានត្រូវបានវិលត្រឡប់ទៅ NMU នេះ.
បន្ទាប់ពីការមកដល់ដើម្បី NMU ជាជនបរទេសមួយដែលមានដើម្បីផ្តល់នូវ:
ជាមួយនឹងការមកដល់សម្រាប់ជនបរទេសសិក្សានៅ NMU នេះ, បទសម្ភាសមួយត្រូវបានធ្វើឡើងសម្រាប់ការប្តេជ្ញាចិត្តនៃកម្រិតការអប់រំ.
ជាមួយជនបរទេសបានផ្ដល់អនុសាសន៍សម្រាប់ការសិក្សានៅ NMU នេះ, កិច្ចព្រមព្រៀងមួយត្រូវបានបញ្ចូលទៅក្នុងកិច្ចសន្យា.
នៅលើការរៀបចំវគ្គសិក្សា;
លក្ខខណ្ឌសិក្សា ការរៀបចំវគ្គបណ្តុះបណ្តាល - 1 ឆ្នាំ.
ពលរដ្ឋបរទេស (លើកលែងតែនិស្សិត, និស្សិតក្រោយឧត្តមសិក្សានិងសិក្ខាកាម), ដែលមិនអាចនិយាយអ៊ុយក្រែនរឺរុស្ស៊ី, ត្រូវបានទទួលយកជាសិស្សរៀបចំវគ្គបណ្តុះបណ្តាល.
និស្សិតបរទេសមានការបណ្តុះបណ្តាលនៅអ៊ុយក្រែន / ភាសារុស្ស៊ី, ប្រវត្តិសាស្រ្តប្រទេសជាក់លាក់, គណិតវិទ្យា, រូបវិទ្យា, គីមីវិទ្យានិងមុខវិជ្ជាផ្សេងទៀត.
វគ្គបណ្ដុះបណ្ដាលស្ដីអំពីការរៀបចំនេះត្រូវបានអនុវត្តនៅក្នុងការអនុលោមជាមួយ "បទបញ្ជាអំពីការសិក្សារបស់ពលរដ្ឋបរទេសនៅឧត្តមសិក្សាស្ថាប័នរដ្ឋ" សាកលវិទ្យាល័យជាតិរ៉ែ»និងនៅលើមូលដ្ឋាននៃសៀវភៅសិក្សាវិធីសាស្ត្រនេះអង្គការ.
កម្មវិធីសិក្សាការរៀបចំជាការពិតណាស់សម្រាប់ប្រជាពលរដ្ឋបរទេសកំណត់ពីរដំណាក់កាលនៃការសិក្សា:
2ទី ឆាក (7 ខែ) ផ្តល់នូវវគ្គបណ្តុះបណ្តាលភាសាបន្ថែមទៀតផងដែរនិងការបណ្តុះបណ្តាលនៅក្នុងវិញ្ញាសាទូទៅដែលមានមូលដ្ឋាននៅក្នុងសាលារៀនបច្ចេកទេសខ្ពស់ជាងមុនជាមួយនឹងទិសដៅនៃការអប់រំ.
ថ្នាក់បណ្តុះបណ្តាលមាន 6-8 សិស្ស, ដែលផ្តល់នូវគុណភាពនៃការដំណើរការការអប់រំគ្រប់គ្រាន់.
ពួកគេអាចទស្សនាមជ្ឈមណ្ឌលវប្បធម៍ប្រវត្តិសាស្រ្ត, សារមន្ទីរភូគព្ភសាស្ត្រនេះ, ការតាំងពិព័រណ៍និងវិធានការវប្បធម៍ធំផ្សេងទៀតនៃ NMU.
បន្ទាប់ពីបានបញ្ចប់ការសិក្សាឆ្នាំ, ពិនិត្យចុងក្រោយត្រូវបានធ្វើឡើង.
វិញ្ញាបនបត្រស្តីពីបានបញ្ចប់ការសិក្សាពីការត្រៀមរៀបចំការពិតណាស់នេះគឺឯកសាររបស់រដ្ឋ, ដែលបានផ្តល់នូវសិទ្ធិសម្រាប់ជនបរទេសដែលបានបញ្ជូនឯកសារនេះសម្រាប់ច្រកចូលនៅសាកលវិទ្យាល័យបច្ចេកទេសណាមួយនៃអ៊ុយក្រែន.
