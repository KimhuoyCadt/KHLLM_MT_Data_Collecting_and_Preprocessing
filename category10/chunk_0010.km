មាត្រដ្ឋានប្រផេះខ្ពស់ក្រោមពន្លឺទាប.
ទោះយ៉ាងណាក៏ដោយ, នៅក្នុងបច្ចេកវិទ្យាបង្ហាញ LED បែបប្រពៃណី, ការកាត់បន្ថយពន្លឺនៃអេក្រង់នឹងបណ្តាលឱ្យបាត់បង់មាត្រដ្ឋានប្រផេះ, ហើយការបាត់បង់ជញ្ជីងពណ៌ប្រផេះនឹងជះឥទ្ធិពលដោយផ្ទាល់ទៅលើគុណភាពរូបភាព.
ជ្រើសរើសទីលានភីកសែល, យកចិត្តទុកដាក់ចំពោះតុល្យភាពនៃ “ផលប៉ះពាល់និងបច្ចេកវិទ្យា”.
នៅក្នុងការអនុវត្តជាក់ស្តែង, ទីលានចុចតូចជាង,ដង់ស៊ីតេរាងកាយខ្ពស់ជាង,និងសមត្ថភាពព័ត៌មានបន្ថែមដែលអាចត្រូវបានបង្ហាញក្នុងមួយឯកតាក្នុងមួយពេល, ចម្ងាយដែលល្អបំផុតគាត់មើលកាន់តែជិត,នៅលើផ្ទុយមកវិញ, ចម្ងាយឆ្ងាយគឺសមរម្យសម្រាប់ការមើល( t ).អ្នកប្រើប្រាស់ជាច្រើនគិតតាមធម្មជាតិថាការទិញអេក្រង់ដែលមានអេក្រង់តូចជាងមុនគឺល្អជាង.
ដូច្នេះ, នៅពេលដែលអ្នកទិញអេក្រង់ដឹកនាំ, អ្នកគួរតែពិចារណាពីតម្លៃរបស់វា, តំរូវការ, ជួរកម្មវិធីនិងកត្តាផ្សេងទៀត.
ជ្រើសរើសដំណោះស្រាយ, យកចិត្តទុកដាក់ទៅ “ឧបករណ៍បញ្ជូនសញ្ញានៅខាងមុខ”.
នៅក្នុងការអនុវត្ត, អ្នកប្រើប្រាស់ចង់បង្កើតប្រព័ន្ធបង្ហាញអំពូលតូចមួយដែលល្អប្រសើរបំផុត.
សញ្ញាវីដេអូនៃទ្រង់ទ្រាយ, ដូច្នេះ, ដើម្បីចៀសវាងការខ្ជះខ្ជាយធនធាន, អ្នកប្រើត្រូវជ្រើសរើសតម្រូវការនៅពេលទិញអេក្រង់ LED តូច, និងមិនគួរចាប់ដោយងងឹតងងល់ជាមួយនឹងនិន្នាការនេះ.
