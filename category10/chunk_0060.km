・ វិញ្ញាបនប័ត្រចុះបញ្ជីសាខាក្រុមហ៊ុនសាជីវកម្មបរទេស។ ល។ ឯកសារ ១ ដែលបញ្ជាក់ថាសាជីវកម្មបរទេសមានការិយាល័យនៅប្រទេសជប៉ុន
ជនបរទេសដែលចង់ទទួលបានទិដ្ឋាការអាពាហ៍ពិពាហ៍ / ទិដ្ឋាការគ្រួសារ
* លទ្ធផលនៃការធ្វើរោគវិនិច្ឆ័យនេះគឺជាការណែនាំហើយវាមិនត្រូវបានអនុញ្ញាតទេ។
តើអ្នកជា "ប្តីប្រពន្ធឬកូនពិតរបស់បុគ្គលដែលមានទិដ្ឋាការនៅប្រទេសជប៉ុន (រួមទាំងជនជាតិជប៉ុន)"?
ក្រុមហ៊ុន ជាដើម ត្រូវតែផ្តល់ការគាំទ្រដល់ជំនាញជាក់លាក់ការងារលេខ 1 ជនបរទេស (ច្បាប់ស្តីពីការគ្រប់គ្រងអន្តោប្រវេសន៍ និងច្បាប់ទទួលស្គាល់ជនភៀសខ្លួន មាត្រា 19-22 កថាខណ្ឌទី 1) ប៉ុន្តែការងារគាំទ្រត្រូវបានគេហៅថា អង្គការគាំទ្រការចុះឈ្មោះ។ ក៏អាចមានប្រភពខាងក្រៅទៅកាន់ ភាគីបី (កថាខ័ណ្ឌ 2 នៃមាត្រាដូចគ្នានៃច្បាប់ដូចគ្នា) ។
អង្គការដែលទទួលបានអាចផ្តល់ប្រភពការងារគាំទ្រទាំងអស់ទៅឱ្យអង្គការគាំទ្រការចុះឈ្មោះ ហើយក្រុមហ៊ុនដែលបំពេញលក្ខខណ្ឌមួយចំនួនអាចផ្តល់ប្រភពផ្នែកខាងក្រៅនៃផ្នែកខាងក្រៅជំនួសឱ្យការចេញទាំងអស់។
អង្គការគាំទ្រការចុះឈ្មោះមិនអាចផ្តល់ប្រភពនៃការអនុវត្តការងារគាំទ្រពីខាងក្រៅទៅស្ថាប័នមួយផ្សេងទៀតបានទេ។ម្យ៉ាងវិញទៀត ជាការពិត អង្គការគាំទ្រការចុះឈ្មោះដែលប្រគល់ឱ្យការងារគាំទ្រនឹងអនុវត្តការងារគាំទ្រ។
បន្ទាប់មក ខ្ញុំ នឹង ពន្យល់ ជាដំបូង ថា ការងារ ជំនួយ ប្រភេទ ណា ដែល ចាំបាច់ សម្រាប់ ជនបរទេស ដែលមាន ជំនាញ ជាក់លាក់។វាក្លាយជា ① ～ ⑩ ខាងក្រោម។
លើសពីនេះ នៅពេលដែលជនបរទេសដែលមានជំនាញជាក់លាក់ត្រឡប់ទៅប្រទេសជប៉ុនវិញ ត្រូវតែអមដំណើរគាត់ទៅខាងមុខប៉ុស្តិ៍ត្រួតពិនិត្យសន្តិសុខនៅព្រលានយន្តហោះដើម្បីមើលច្រកចូល។
ចាំបាច់ត្រូវផ្តល់ព័ត៌មានអំពីស្ថាប័នហិរញ្ញវត្ថុ/ស្ថាប័នវេជ្ជសាស្ត្រ ច្បាប់សង្គម។ល។ ដើម្បីឱ្យជនបរទេសដែលមានជំនាញជាក់លាក់មិនមានបញ្ហាក្នុងការរស់នៅក្នុងប្រទេសជប៉ុន។
វាចាំបាច់ដើម្បីអមដំណើរ និងជួយដល់នីតិវិធីផ្លូវការខាងក្រោម ដែលជនបរទេសដែលមានជំនាញជាក់លាក់ត្រូវធ្វើនៅប្រទេសជប៉ុនតាមការចាំបាច់។
យើងនឹងផ្តល់ព័ត៌មានអំពីសាលារៀនសម្រាប់ជនបរទេសដែលមានជំនាញជាក់លាក់ដើម្បីរៀនភាសាជប៉ុន។លើសពីនេះទៀត យើងនឹងជួយក្នុងការបញ្ចប់កិច្ចសន្យាតាមការចាំបាច់។
ព័ត៌មានអំពីព្រឹត្តិការណ៍ដែលរៀបចំដោយរដ្ឋាភិបាលក្នុងតំបន់នៅក្នុងតំបន់ដែលជនបរទេសដែលមានជំនាញជាក់លាក់រស់នៅ។
នៅពេលដែលក្រុមហ៊ុនទទួលយកជនបរទេសជំនាញជាក់លាក់មួយលុបចោលកិច្ចសន្យាការងារជំនាញជាក់លាក់ដោយសារហេតុផលអាជីវកម្ម ចាំបាច់ត្រូវគាំទ្រការស្វែងរកការងារថ្មីសម្រាប់ជនបរទេសជំនាញជាក់លាក់។
ចាំបាច់ត្រូវធ្វើការសម្ភាសន៍ជាមួយជនបរទេសដែលមានជំនាញជាក់លាក់ និងអ្នកគ្រប់គ្រងរបស់គាត់យ៉ាងហោចណាស់ម្តងរៀងរាល់បីខែម្តង។
តាមរបៀបនេះ ប្រសិនបើក្រុមហ៊ុនដែលមិនទាន់ទទួលយកធនធានមនុស្សពីបរទេសនាពេលថ្មីៗនេះ ហើយមិនមានប្រព័ន្ធគាំទ្រនៅនឹងកន្លែងទទួលយកជនបរទេសដែលមានជំនាញជាក់លាក់នោះ វានឹងផ្តល់ប្រភពជំនួយទាំងអស់ដល់អង្គការគាំទ្រការចុះឈ្មោះ។
មិនមែនក្នុងករណី 2-2 ទេ ប្រសិនបើក្រុមហ៊ុនដែលមានប្រវត្តិទទួលជនបរទេស តែងតាំងអ្នកគ្រប់គ្រងជំនួយ និងបុគ្គលិកគាំទ្រ និងមានប្រព័ន្ធអនុវត្តការគាំទ្រ ទទួលយកជនបរទេសដែលមានជំនាញជាក់លាក់។
① ប្រគល់ការងារគាំទ្រទាំងអស់ទៅអង្គការគាំទ្រការចុះឈ្មោះ
③ អនុវត្តការងារជំនួយក្នុងផ្ទះ
សាវតានៃការចែកចាយដោយផ្នែកអាចថា ទោះបីជាប្រព័ន្ធគាំទ្រមាននៅនឹងកន្លែងក៏ដោយ យើងចង់បញ្ចេញនូវផ្នែកនៃមាតិកាជំនួយដែលមិនគ្រប់គ្រាន់នៅក្នុងក្រុមហ៊ុនរបស់យើងទៅកាន់ស្ថាប័នគាំទ្រការចុះឈ្មោះ។
ដើម្បីជួលជនបរទេសដែលមានឋានៈជំនាញជាក់លាក់នៃលំនៅដ្ឋាន“ ផែនការគាំទ្រជនបរទេសដែលមានជំនាញជាក់លាក់” ត្រូវបានទាមទារនៅពេលដាក់ពាក្យសុំឋានៈស្នាក់នៅដែលមានលក្ខណៈខុសគ្នាបន្តិចពីករណីជួលជនបរទេសដែលមានឋានៈស្នាក់នៅផ្សេងទៀតកើនឡើង។
នេះគឺជាផែនការគាំទ្រមិនត្រឹមតែការគាំទ្រផ្នែកវិជ្ជាជីវៈប៉ុណ្ណោះទេថែមទាំងជីវិតប្រចាំថ្ងៃនិងជីវិតសង្គមសម្រាប់ជនបរទេសដែលមានជំនាញជាក់លាក់ដើម្បីធ្វើការនៅក្រុមហ៊ុន។
“ ការគាំទ្រជាកាតព្វកិច្ច” គឺជាបញ្ហាដែលត្រូវតែបញ្ជាក់និងអនុវត្តនៅក្នុងផែនការគាំទ្រ។
មុនពេលជនបរទេសដែលមានជំនាញជាក់លាក់មកប្រទេសជប៉ុនវាចាំបាច់ត្រូវផ្តល់ព័ត៌មានដូចខាងក្រោម។
・ ខ្លឹមសារនៃសកម្មភាពដែលជនបរទេសអាចអនុវត្តនៅក្នុងប្រទេសជប៉ុន
នៅពេលជនបរទេសចូលនិងចាកចេញពីប្រទេសយើងនឹងទៅយកអ្នកនៅកំពង់ផែឬព្រលានយន្តហោះ។
មូលហេតុគឺថាយើងទទួលបានកម្រៃពីក្រុមហ៊ុនដែលទទួលយកនៅពេលអនុវត្តផែនការគាំទ្រដូច្នេះប្រសិនបើអ្នកមកយកហើយចុះចតជាមួយឡានក្រុមហ៊ុនរបស់អង្គការគាំទ្រការចុះឈ្មោះអ្នកនឹងត្រូវដាក់ទណ្ឌកម្មជាទង្វើតាក់ស៊ីពណ៌ស (អាជីវកម្មតាក់ស៊ីគ្មានអាជ្ញាប័ណ្ណ) បំពានច្បាប់ស្តីពីការដឹកជញ្ជូនផ្លូវគោកព្រោះមានលទ្ធភាព
យើងនឹងផ្តល់ការគាំទ្រដូចខាងក្រោមដើម្បីឱ្យជនបរទេសអាចរស់នៅបានត្រឹមត្រូវនៅក្នុងប្រទេសជប៉ុន។
◆ការផ្តល់ព័ត៌មានបន្ទាប់ពីជនបរទេសចូលប្រទេសជប៉ុន
វាចាំបាច់ក្នុងការធ្វើវាជាភាសាដែលជនបរទេសអាចយល់បានពេញលេញ។
・ ការផ្តល់ចំណេះដឹងអំពីការជូនដំណឹងនិងនិតិវិធីដល់ទីភ្នាក់ងាររដ្ឋាភិបាលថ្នាក់ជាតិឬមូលដ្ឋានស្របតាមមាត្រា ១៩ កថាខណ្ឌទី ១៦ នៃការត្រួតពិនិត្យជនភៀសខ្លួននិងជនភៀសខ្លួន
・ ការផ្តល់ព័ត៌មានទំនាក់ទំនងសម្រាប់អង្គការនានារបស់រដ្ឋាភិបាលថ្នាក់ជាតិឬមូលដ្ឋានដែលគួរដាក់ពាក្យបណ្តឹង
