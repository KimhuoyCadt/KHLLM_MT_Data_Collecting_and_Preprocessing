ការ សម្ភាស ការងារ គឺជា បទពិសោធន៍ ដ៏ ភ័យខ្លាច មួយ សម្រាប់ មនុស្ស ជាច្រើន។ វា អាច នឹង មាន ភាព លំបាក មួយ កម្រិត ទៀត សម្រាប់ និស្សិត ដែល ទើប នឹង បញ្ចប់ ការសិក្សា។ ទោះបីជា យ៉ាងណាក៏ដោយ វា តែងតែ មាន រឿង ជាច្រើន ដែល ពួកគេ អាច រៀន និង រៀបចំ ដើម្បី ទាក់ទាញ ចំណាប់ អារម្មណ៍ ពី អ្នក សម្ភាសន៍ ការងារ បាន។
ចំណែកឯ ចំណុច ចុងក្រោយ ប្រហែលជា មិន មែន ជា អាទិភាព សម្រាប់ អ្នក សម្ភាសន៍ ផ្សេង ទៀត ក៏ ពិត មែន ប៉ុន្តែ ខ្ញុំ គិត ថា វា មិន គួរ មើល រំលង ដូចគ្នា ពី ការរៀបចំ ខ្លួន ក្នុង ការ ស្លៀកពាក់ សម្រាប់ ការ សម្ភាសន៍។ អ្នក គួរតែ ស្លៀកពាក់ ឱ្យ បាន ត្រឹមត្រូវ និង ប្រកបដោយ វិជ្ជាជីវៈ ពីព្រោះ ការ បង្ហាញ ចំណាប់ អារម្មណ៍ លើកដំបូង មាន សារសំខាន់ ណាស់។
កាលពី សប្តាហ៍ មុន យើង បាន ចុះផ្សាយ អត្ថបទ មួយ ដែល បង្ហាញ ពី សារសំខាន់ នៃ ជំនាញ ទន់ នៅ កន្លែង ធ្វើការ ជាពិសេស សម្រាប់ និស្សិត ដែល ទើប បញ្ចប់ ការសិក្សា។ អ្នក ដែល បាន បញ្ចប់ ការសិក្សា ពី សាកលវិទ្យាល័យ គ្រប់ៗ រូប គួរតែ មាន ជំនាញ រឹង ក្នុង ការ ស្វែងរក ការងារ ដែល ស័ក្តិសម ទៅ នឹង ចំណេះដឹង និង សមត្ថភាព របស់ ពួកគេ។ ទោះជាយ៉ាងណា ក៏ដោយ និស្សិត មួយចំនួន បាន មើល រំលង ពី សារសំខាន់ នៃ ជំនាញ ទន់ ដែល អ្នក មិន អាច រៀន ពី សៀវភៅ បាន។
ផ្អែក លើ បទពិសោធន៍ របស់ អ្នក ក្នុង ការ ជ្រើសរើស បុគ្គលិក តើ អ្វី ដែល អ្នក តែងតែ ផ្ដោត សំខាន់ ជាងគេ ក្នុង ការ ជ្រើសរើស បុគ្គលិក?
ទីពីរ យើង ជឿជាក់ ថា យើង ទទួល ជ័យជម្នះ ជា ក្រុម។ យើង បាន និយាយ ច្រើន អំពី ការ ធ្វើការ ជា ក្រុម ប៉ុន្តែ តើ អ្វី ទៅ ជា ការ ធ្វើការ ជា ក្រុម?
ចុងក្រោយ គឺ ត្រូវ យកចិត្ត ទុកដាក់ ចំពោះ ព័ត៌មាន លម្អិត ព្រោះ អតិថិជន របស់ យើង ចង់ បាន ភាព ច្បាស់លាស់ និង សេវាកម្ម ល្អ ពី យើង។ ដូច្នេះ ជា ការ តបស្នង យើង គួរតែ មាន ភាព ត្រឹមត្រូវ និង ច្បាស់លាស់ ជានិច្ច។
ជំនាញ ទន់ មាន សារសំខាន់ ខ្លាំង ណាស់ ពីព្រោះ ជំនាញ រឹង អាច បង្រៀន បាន ខណៈ ពេល ដែល ជំនាញ ទន់ វា ដូច ជា ឌីអិនអេ (DNA) របស់ អ្នក អ៊ីចឹង វា ត្រូវតែ ចេញ ពី ខ្លួន របស់ អ្នក។ លើសពីនេះ វា ក៏ បង្ហាញ ថា អ្នក មាន ផ្នត់គំនិត ត្រឹមត្រូវ ដើម្បី ធ្វើការ ជាមួយ មនុស្ស ផ្សេងទៀត នៅ កន្លែង ការងារ រួម ទាំង អតិថិជន របស់ យើង ផង ដែរ។ ហេតុនេះ វា ជា មូលហេតុ ដែល ជំនាញ ទន់ ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ពេល សម្ភាសន៍។
តើ អ្វី ជា វិធីសាស្ត្រ ចុងក្រោយ សម្រាប់ បេក្ខជន សម្ភាសន៍ ការងារ លើកដំបូង?
យោង តាម ការសិក្សា ពី មជ្ឈមណ្ឌល ជីវចម្រុះ ដែល ជា អង្គការ មិន រក ប្រាក់ចំណេញ ផ្ដោត ទៅលើ ការ ការពារ សត្វ ដែល ជិត ផុត ពូជ នៅ សហរដ្ឋ អាមេរិក បាន ឱ្យ ដឹង ថា ថង់ ប្លាស្ទិក ត្រូវ គេ ប្រើ រយៈពេល ជា មធ្យម ត្រឹមតែ ១២ នាទី តែ ប៉ុណ្ណោះ ខណៈ ដែល ថង់ ប្លាស្ទិក អាច ស្ថិត នៅ ក្នុង កន្លែង ចាក់ សំរាម រយៈពេល ៥០០ ឆ្នាំ ឬ ច្រើន ជាង នេះ រហូតដល់ វា អាច រលាយ បំបែក បាន។
គោលបំណង នៃ ការរស់នៅ បែបនេះ គឺ ដើម្បី លុបបំបាត់ ចោល ទាំងស្រុង នូវ កាកសំណល់ សំរាម មាន ដូចជា ប្លាស្ទិក ក្រដាស ឬ ប្លាស្ទិក រុំ ខ្ចប់ និង សម្ភារ ផ្សេង ទៀត ដែល អាច ប៉ះពាល់ ដល់ បរិស្ថាន។
ហេតុ អ្វី បាន ជា ចាំបាច់ ត្រូវ រស់នៅ ដោយ គ្មាន កាកសំណល់?
ការ បដិសេធ (Refuse)៖ ក្លាយ ខ្លួន ជា អ្នក ប្រើប្រាស់ ប្រកប ដោយ ក្រមសីលធម៌ ដោយ បដិសេធ ទិញ ទំនិញ ដែល មាន ការ វេច ខ្ចប់ ប្លាស្ទិក ច្រើន។ ប្លាស្ទិក អាច ផ្តល់ ភាព ងាយស្រួល សម្រាប់ អ្នក ក្នុង រយៈពេល ខ្លី ប៉ុន្តែ វា នឹង ជះឥទ្ធិពល អាក្រក់ ដល់ បរិស្ថាន ក្នុង រយៈពេល វែង។
ការកែច្នៃ (Recycle)៖ ការកែច្នៃ របស់របរ ប្រើប្រាស់ ឡើងវិញ អាច ចំណាយ ថាមពល និង ធនធាន មួយចំនួន ជាពិសេស នៅក្នុង ប្រទេស កំពុង អភិវឌ្ឍ ប៉ុន្តែ វា ប្រសើរ ជាង ការ បញ្ជូន សំរាម ទៅ កន្លែង ចាក់ សំរាម ហើយ ទុក វា ចោល យ៉ាងហោចណាស់ ក៏ ត្រូវការ រយៈពេល ៥០០ ឆ្នាំ ដើម្បី រំលាយ កាកសំណល់ ទាំងនោះ។ អ្នក អាច ចូលរួម ថែរក្សា បរិស្ថាន បាន ដោយ គ្រាន់តែ ជួយ គ្រប់គ្រង កាកសំណល់ ក្នុង ផ្ទះ អ្នក ដោយ បែងចែក ទៅតាម ប្រភេទ របស់ វា និង ជួយ គាំទ្រ ផលិតផល ដែល ត្រូវ បាន យក មក កែច្នៃ និង ប្រើប្រាស់ ឡើងវិញ៕
អ្នក ធ្វើការ ផ្នែក ប្រឆាំង អំពើ ហិង្សា ក្នុង គ្រួសារ ស្នើ ពលរដ្ឋ រាយការណ៍ ពី អំពើ ហិង្សា ក្នុង អំឡុង ពេល ជំងឺ កូវីដ ១៩
«បើសិន ខ្ញុំ មិន មាន បទពិសោធន៍ ក្នុង ការស្រាវជ្រាវ ពី មុន មក ទេ ខ្ញុំ គិតថា ខ្ញុំ អាច នឹង ប្រើប្រាស់ អារម្មណ៍ ច្រើន ក្នុង ការ ឆ្លើយតប ឬ បញ្ចេញ មតិ ទៅលើ បញ្ហា ដែល កើតឡើង នៅក្នុង សង្គម»។
ជា រួម តើ ជំនាញ ស្រាវជ្រាវ មាន សារសំខាន់ ដូចម្តេច ខ្លះ ដល់ ការ អភិវឌ្ឍ និង សេដ្ឋកិច្ច របស់ ប្រទេស មួយ?
ទីបី នៅក្នុង គ្រួសារ និង បុគ្គល ខ្លួនឯង។ ការដែល យើង និយាយ ជាមួយ កូន ដោយ ហេតុផល នេះ ហើយ គឺ ការ គិត បែប វិទ្យាសាស្ត្រ។ ការដែល និយាយ ពាសវាលពាសកាល ហើយ មិន ស្តាប់ ហេតុផល របស់ កូន គឺជា ការ កាច់ ត្រួយ គំនិត របស់ កូន។
គំនិត ទាំងអស់ នេះ ត្រូវ បាន ផ្ដួចផ្ដើម ឡើង បន្ទាប់ពី ក្រុម ការងារ ស៊ី អ៊ិនវេសមិន បាន រកឃើញ តាម ការស្រាវជ្រាវ មួយ ថា ក្នុង ៦៥% នៃ សហគ្រិន ទាំងអស់ នៅក្នុង ប្រទេស កម្ពុជា ត្រូវ បាន បង្កើត ឡើង ដោយ ស្ត្រី។ ប៉ុន្តែ អាជីវកម្ម ទាំងអស់ នោះ គឺជា អាជីវកម្ម ក្រៅ ផ្លូវការ ឬ អាជីវកម្ម គ្រួសារ។ ចំណែក អាជីវកម្ម ខ្នាត កណ្តាល និង ធំ ភាគច្រើន ត្រូវ បាន បង្កើត និង គ្រប់គ្រង ដោយ បុរស។ គំនិត ចង់ លុបបំបាត់ គម្លាត នេះ គឺជា ចំណុច ចាប់ផ្តើម ដំបូង របស់ ស៊ី អ៊ិនវេសមិន។
