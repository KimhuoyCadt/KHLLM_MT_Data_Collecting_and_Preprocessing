ហើយកំពែងក្រុងយេរូសាឡិមបានបាក់បែក, រីឯទ្វារក្រុងក៏ត្រូវភ្លើងឆេះអស់ដែរ»។
ខ្ញុំតមអាហារនិងអធិស្ឋាននៅចំពោះព្រះភ័ក្ត្រព្រះជាម្ចាស់នៃស្ថានបរមសុខ.
1:6 សូមអោយត្រចៀករបស់អ្នកយកចិត្តទុកដាក់, សូមអោយភ្នែកអ្នកបានភ្លឺផង, ដូច្នេះសូមព្រះ សណ្ដាប់ពាក្យទូល អង្វររបស់ទូលបង្គំដែលជាអ្នកបម្រើរបស់ព្រះ អង្គ, ដែលខ្ញុំកំពុងអធិស្ឋាននៅចំពោះអ្នកថ្ងៃនេះ, យប់និងថ្ងៃ, សំរាប់កូនចៅអ៊ីស្រាអែល, អ្នកបំរើរបស់អ្នក.
យើងបានធ្វើបាប, ខ្ញុំនិងផ្ទះឪពុកខ្ញុំ.
ហើយយើងមិនបានរក្សាបទបញ្ញត្តិពិធីនិងវិន័យរបស់អ្នកទេ, ដែលព្រះអង្គបានប្រាប់លោកម៉ូសេជាអ្នកបំរើរបស់ព្រះអង្គ.
1:9 ប៉ុន្តែប្រសិនបើអ្នកនឹងវិលត្រឡប់មកខ្ញុំវិញ, និងរក្សាបទបញ្ជារបស់ខ្ញុំ, ហើយធ្វើវា, ទោះបីអ្នកនឹងត្រូវដឹកនាំទៅឆ្ងាយបំផុតនៅលើមេឃក៏ដោយ, ខ្ញុំនឹងប្រមូលអ្នកពីទីនោះ, យើងនឹងនាំអ្នកត្រឡប់ទៅកន្លែងដែលយើងបានជ្រើសរើសដើម្បីអោយនាមយើងបានរស់នៅទីនោះ។ '
1:11 ខ្ញុំ សូម អង្វរ អ្នក, គាត់គឺជាម្ចាស់, សូមទ្រង់ព្រះសណ្តាប់ពាក្យអធិស្ឋានរបស់អ្នកបំរើព្រះអង្គផង, ទូលបង្គំសូមអង្វរដល់អ្នកបំរើរបស់ព្រះអង្គដែលចង់គោរពកោតខ្លាចព្រះនាមព្រះអង្គ.
ហើយខ្ញុំដូចជាមនុស្សម្នាក់កំពុងវង្វេងស្មារតីនៅចំពោះមុខគាត់.
នេះមិនមែនដោយគ្មានមូលហេតុទេ, ប៉ុន្តែអាក្រក់ខ្លះ, ខ្ញុំមិនដឹងអ្វី, គឺនៅក្នុងបេះដូងរបស់អ្នកហើយ។ ខ្ញុំមានការភ័យខ្លាចយ៉ាងខ្លាំង.
ហេតុអ្វីសំដីខ្ញុំមិនគួរកាន់ទុក្ខ, ចាប់តាំងពីទីក្រុងនៃផ្ទះរបស់ផ្នូរឪពុករបស់ខ្ញុំគឺត្រូវបានស្ងាត់ជ្រងំ, រីឯទ្វារក្រុងក៏ត្រូវភ្លើងឆេះអស់ដែរ?”
?ហើយខ្ញុំបានអធិស្ឋានដល់ព្រះនៃស្ថានបរមសុខ.
ហើយខ្ញុំនឹងសាងសង់វាឡើងវិញ។
ហើយខ្ញុំបានបង្កើតពេលវេលាសម្រាប់គាត់.
2:8 និងលិខិតទៅអេសាភ, អ្នកថែរក្សាព្រៃស្តេច, ដូច្នេះគាត់នឹង ឲ្យ ឈើមកខ្ញុំ, ដើម្បីឱ្យខ្ញុំអាចគ្របដណ្តប់លើទ្វារនៃប៉មនៃផ្ទះ, និងជញ្ជាំងនៃទីក្រុង, ហើយផ្ទះដែលខ្ញុំនឹងចូល” ព្រះរាជាបានប្រទានដល់ខ្ញុំស្របតាមព្រះហស្តដ៏ល្អរបស់ព្រះរបស់ខ្ញុំ, ដែលនៅជាមួយខ្ញុំ.
ឥឡូវនេះព្រះរាជាបានចាត់មេដឹកនាំនិងពលទាហានជាច្រើននាក់អោយមកជាមួយខ្ញុំ.
ហើយពួកគេមានការសោកសៅ, ជាមួយនឹងទុក្ខវេទនាយ៉ាងខ្លាំង, មានបុរសម្នាក់មកដល់ហើយដែលកំពុងតែស្វែងរកសុភមង្គលរបស់កូនចៅអ៊ីស្រាអែល.
ហើយគ្មានសត្វណានៅជាមួយខ្ញុំទេ, លើកលែងតែសត្វដែលខ្ញុំកំពុងអង្គុយ.
ហើយខ្ញុំបានពិចារណាលើកំពែងក្រុងយេរូសាឡិម, ដែលត្រូវបានបំបែកដាច់ពីគ្នា, និងទ្វាររបស់វា, ដែលត្រូវបានឆេះដោយភ្លើង.
ហើយគ្មានកន្លែងសម្រាប់សត្វដែលខ្ញុំកំពុងអង្គុយឆ្លងកាត់នោះទេ.
ហើយងាកក្រោយ, ខ្ញុំបានទៅដោយខ្លោងទ្វារជ្រលងភ្នំ, ហើយខ្ញុំបានត្រឡប់មកវិញ.
ខ្ញុំមិនបានប្រាប់អ្វីទាំងអស់, សូម្បីតែដល់ចំណុចនោះនៅក្នុងពេលវេលា, ដល់សាសន៍យូដា, ឬបូជាចារ្យ, ឬពួកអភិជន, ឬចំពោះចៅក្រម, ឬអ្នកផ្សេងទៀតដែលកំពុងធ្វើការ.
មក, ចូរនាំគ្នាសង់កំពែងក្រុងយេរូសាឡឹមឡើងវិញ, សូមកុំអោយយើងត្រូវអាម៉ាស់មុខទៀតឡើយ។
ហើយខ្ញុំបាននិយាយ: “ ចូរយើងក្រោកឡើង, និងកសាង។ ហើយដៃរបស់ពួកគេត្រូវបានពង្រឹងសម្រាប់ការល្អ.
ចូរយើងក្រោកឡើងហើយស្ថាបនា.
ពួកគេបានរាប់ជាបរិសុទ្ធ, ហើយពួកគេបានដំឡើងទ្វារទ្វេ, និងរហូតដល់ប៉មមួយរយហត្ថ, ពួកគេបានរាប់ជាបរិសុទ្ធ, សូម្បីតែប៉មហាណានាល.
3:12 ហើយនៅក្បែរគាត់, សាលូម, កូនប្រុសរបស់ហាឡូលសាស, មេដឹកនាំពាក់កណ្តាលនៃផ្លូវមួយនៃក្រុងយេរូសាឡិម, សាងសង់, គាត់និងកូនស្រីរបស់គាត់.
ពួកគេបានសាងសង់វា, ហើយពួកគេបានដំឡើងទ្វារទ្វេនិងសោរនិងរនាំង, ដោយមានជញ្ជាំងមួយពាន់ហត្ថ, ដូចជានៅឆ្ងាយពីទ្វារនៃលាមកសត្វ.
គាត់បានសាងសង់វា, ហើយគាត់បានគ្របដណ្តប់វា, ហើយគាត់បានដំឡើងទ្វារទ្វេនិងសោរនិងរនាំង, កំពែងនៃស្រះទឹកសេឡានៅសួនច្បារស្តេច, និងជាជំហានដែលចុះពីទីក្រុងដាវីឌ.
3:20 បន្ទាប់ពី គាត់, នៅឯម៉ោន, បារូក, កូនប្រុសរបស់លោកសាបបៃ, បានបង្កើតវិធានការមួយទៀត, ចាប់ពីជ្រុងរហូតដល់ទ្វារនៃផ្ទះរបស់អេលីយ៉ាស៊ីស, បូជាចារ្យដ៏អស្ចារ្យ.
ហើយបន្ទាប់ពីគាត់, អាហ្សា, កូនប្រុសរបស់ម៉ាសេ យ៉ា, កូនប្រុសរបស់អាណានាស, សាងសង់, ទល់មុខនឹងផ្ទះរបស់គាត់.
3:25 ផាលឡាល, កូនប្រុសរបស់លោកអ៊ូសាយ, សាងសង់, ទល់មុខនឹងពត់និងប៉មដែលគ្រោងពីដំណាក់ស្តេច, នោះគឺ, ចូលក្នុងតុលាការពន្ធនាគារ.
3:26 និងអ្នកបម្រើប្រាសាទ, ដែលកំពុងរស់នៅអូអូល, សង់ដល់ចំណុចទល់មុខខ្លោងទ្វារទឹក, ឆ្ពោះទៅខាងកើត, និងអគារដែលលេចធ្លោ.
3:28 បន្ទាប់មក, ឡើងពីលើខ្លោងទ្វារសេះ, បូជាចារ្យបានសាងសង់, ម្នាក់ៗនៅទល់មុខនឹងផ្ទះរៀងៗខ្លួន.
4:1 ឥឡូវនេះវាបានកើតឡើង, នៅពេលដែលសាន់បាឡាតបាន heard ថាយើងកំពុងសង់កំផែង, គាត់ខឹងខ្លាំងណាស់.
4:2 ហើយគាត់បាននិយាយ, មុនពេលបងប្អូនរបស់គាត់និងហ្វូងមនុស្សនៃសាសន៍សាម៉ារី: តើជនជាតិយូដាល្ងង់ធ្វើអ្វី??
តើពួកគេនឹងលះបង់ហើយបញ្ចប់នៅថ្ងៃណាមួយ?
4:5 សូមកុំលាក់អំពើទុច្ចរិតរបស់ពួកគេឡើយ, សូមកុំអោយអំពើបាបរបស់គេត្រូវវិនាសឡើយ, មុនមុខរបស់អ្នក, ពួកគេចំអកអោយអស់អ្នកដែលសង់ផ្ទះ.
4:8 ហើយពួកគេទាំងអស់បានប្រមូលផ្តុំគ្នា, ដូច្នេះពួកគេអាចចេញទៅច្បាំងនឹងក្រុងយេរូសាឡឹម, ហើយដូច្នេះពួកគេអាចរៀបចំការវាយឆ្មក់.
4:10 លោកយូដាមានប្រសាសន៍: កម្លាំងរបស់អ្នកដឹកទំនិញបានថយចុះ, ហើយចំនួនសម្ភារៈគឺអស្ចារ្យណាស់, ដូច្នេះយើងនឹងមិនអាចសង់ជញ្ជាំងបានទេ” ។
4:12 ឥឡូវនេះវាបានកើតឡើង, ដប់ដង, ជនជាតិយូដាខ្លះដែលបានទៅរស់នៅក្បែរពួកគេ, ពីកន្លែងទាំងអស់ដែលពួកគេបានមករកយើង, ហើយពួកគេបានប្រាប់យើងអំពីរឿងនេះ.
ចងចាំពីព្រះអម្ចាស់ដ៏អស្ចារ្យនិងគួរឱ្យខ្លាច, និងការប្រយុទ្ធនៅលើក្នុងនាមបងប្អូនរបស់អ្នក, កូនប្រុសកូនស្រីរបស់អ្នក, និងប្រពន្ធនិងគ្រួសាររបស់អ្នក។
ហើយយើងទាំងអស់គ្នាបានត្រលប់ទៅជញ្ជាំងវិញ, ម្នាក់ៗធ្វើការងាររៀងៗខ្លួន.
អ្នកដឹកនាំនៅខាងក្រោយផ្ទះទាំងអស់ក្នុងកុល សម្ព័ន្ធយូដា.
4:18 សម្រាប់អ្នកសាងសង់ម្នាក់ៗត្រូវបានគេបំពាក់ដោយដាវនៅចង្កេះ.
4:19 ហើយខ្ញុំបាននិយាយទៅកាន់ពួកអភិជន, និងចៅក្រម, និងមនុស្សសាមញ្ញផ្សេងទៀត: “ ការងារគឺធំធេងនិងធំទូលាយ, ហើយយើងបែកគ្នានៅលើជញ្ជាំងឆ្ងាយពីគ្នា.
ព្រះរបស់យើងនឹងប្រយុទ្ធប្រឆាំងនឹងការនៅលើក្នុងនាមរបស់យើង.
ហើយទុកឱ្យយើងមួយភាគបីកាន់លំពែង, ចាប់ពីពេលព្រលឹមឡើងរហូតដល់ផ្កាយលេចចេញមក។
ហើយអនុញ្ញាតឱ្យយើងងាក, ពេញមួយយប់និងពេលថ្ងៃ, ក្នុងការបំពេញការងារ។
5:2 ហើយមានអ្នកដែលកំពុងនិយាយ: “ កូនប្រុសស្រីរបស់យើងមានចំនួនច្រើនណាស់.
5:3 ហើយមានអ្នកដែលកំពុងនិយាយ: “ ចូរយើងផ្តល់ដីស្រែនិងចំការទំពាំងបាយជូររបស់យើង, និងផ្ទះរបស់យើង, បន្ទាប់មកយើងនឹងទទួលបានគ្រាប់ធញ្ញជាតិក្នុងពេលទុរ្ភិក្សនេះ។
5:6 ហើយនៅពេលដែលខ្ញុំបានលឺសំលេងស្រែករបស់ពួកគេ, ខ្ញុំខឹងខ្លាំងណាស់.
ហើយខ្ញុំបានស្តីបន្ទោសដល់ពួកអភិជននិងពួកចៅក្រម, ហើយខ្ញុំបាននិយាយទៅពួកគេ, “ តើអ្នករាល់គ្នាបានទារប្រាក់ពីបងប្អូនរបស់អ្នកហើយឬនៅ?
5:8 ហើយខ្ញុំបាននិយាយទៅកាន់ពួកគេ: “ ដូចដែលអ្នកបានដឹងហើយ, តាមអ្វីដែលអាចធ្វើទៅបានសម្រាប់យើង, យើងបានលោះបងប្អូនយើងហើយ, ជនជាតិយូដា, ដែលបានត្រូវលក់ទៅ ឲ្យ សាសន៍ដទៃ.
5:10 ទាំងខ្ញុំនិងបងប្អូនខ្ញុំ, ជាមួយអ្នកបំរើរបស់ខ្ញុំ, បានអោយខ្ចីប្រាក់និងធញ្ញជាតិដល់មនុស្សជាច្រើន.
សូមឱ្យយើងអត់ទោសឱ្យប្រាក់ផ្សេងទៀតដែលជំពាក់យើង.
បន្ទាប់មក, ផងដែរ, មួយភាគរយនៃប្រាក់, និងគ្រាប់ធញ្ញជាតិ, ស្រា, និងប្រេង, ដែលជាធម្មតាអ្នកពិតប្រាកដពីពួកគេ, ឱ្យវាទៅពួកគេ។
ហើយយើងនឹងធ្វើដូចអ្វីដែលអ្នកនិយាយ” ។ ហើយខ្ញុំបានហៅពួកសង្ឃ, ហើយខ្ញុំអោយពួកគេស្បថ, ដូច្នេះពួកគេនឹងប្រព្រឹត្តស្របតាមអ្វីដែលខ្ញុំបាននិយាយ.
ពីផ្ទះនិងពីការងាររបស់គាត់, ដូច្នេះសូម ឲ្យ គាត់ត្រូវរង្គោះរង្គើហើយនៅទទេចុះ»។ ហើយប្រជាជនទាំងមូលនិយាយ, “ អាម៉ែន” ហើយពួកគេបានសរសើរព្រះ.
5:14 ឥឡូវនេះចាប់ពីថ្ងៃនោះមក, ព្រះរាជាបានបញ្ជាអោយខ្ញុំធ្វើជាទេសាភិបាលនៅស្រុកយូដា, ចាប់ពីឆ្នាំទីម្ភៃរហូតដល់ឆ្នាំសាមសិបពីរនៃរជ្ជកាលព្រះចៅអើថាស៊ើកសេស, សម្រាប់ដប់ពីរឆ្នាំមកហើយ, ខ្ញុំនិងបងប្អូនរបស់ខ្ញុំមិនបានបរិភោគប្រាក់ឧបត្ថម្ភប្រចាំឆ្នាំដែលជំពាក់អភិបាល.
ហើយមន្ត្រីរបស់ពួកគេក៏បានគាបសង្កត់ប្រជាជនដែរ.
5:16 តាមពិត, ខ្ញុំចូលចិត្តសាងសង់នៅក្នុងជញ្ជាំង, ហើយខ្ញុំមិនបានទិញដីទេ, ហើយអ្នកបំរើរបស់ខ្ញុំទាំងអស់ត្រូវបានប្រមូលផ្តុំគ្នាដើម្បីបំពេញការងារ.
5:18 ឥឡូវនេះត្រូវបានរៀបចំសម្រាប់ខ្ញុំ, នៅថ្ងៃនីមួយៗ, គោមួយនិងចៀមឈ្មោលប្រាំមួយជម្រើស, រួមជាមួយបសុបក្សី.
ប៉ុន្តែខ្ញុំមិនបានទាមទារប្រាក់ឧបត្ថម្ភប្រចាំឆ្នាំជាអភិបាលទេ.
6:1 ឥឡូវនេះវាបានកើតឡើង, នៅពេលដែលសាន់បាលាត់, និងថូប៊ីយ៉ា, និងហ្គេម, អារ៉ាប់មួយ, និងសត្រូវផ្សេងទៀតរបស់យើង, បាន heard ថាខ្ញុំបានសង់ជញ្ជាំង, ហើយថាគ្មានការរំខានណាមួយដែលនៅសល់នៅក្នុងនោះទេ, (ទោះ បី ជា, នៅពេល នោះ, ខ្ញុំមិនបានដំឡើងទ្វារទ្វេនៅមាត់ទ្វារទេ,)
ហើយខ្ញុំបានឆ្លើយតបទៅពួកគេដោយពាក្យដដែលដូចពីមុន.
6:6 “ វាត្រូវបានគេ among ក្នុងចំណោមសាសន៍ដទៃ, ហើយហ្គេមបាននិយាយ, ដែលអ្នកនិងពួកយូដាមានគំរោងបះបោរ, ហើយដោយសារតែនេះ, អ្នកកំពុងសាងសង់ជញ្ជាំងហើយគិតដើម្បីលើកខ្លួនអ្នកធ្វើជាស្តេចលើពួកគេ.
6:7 អ្នករាល់គ្នាក៏ឈរជើងជាព្យាការីដែរ, គាត់ផ្សព្វផ្សាយអំពីអ្នកនៅក្រុងយេរូសាឡឹម, និយាយ: មានស្ដេចមួយនៅស្រុកយូដា!ប៉ុន្តែស្តេចនឹង about អំពីពាក្យទាំងនេះ.
6:8 ខ្ញុំបានចាត់គេ ឲ្យ ទៅ, និយាយ: “ មិនមានអ្វីដែលត្រូវបានធ្វើស្របតាមពាក្យទាំងនេះទេ, ដែលអ្នកបាននិយាយ.
6:9 សម្រាប់បុរសទាំងអស់នេះចង់បំភ័យយើង, គិតថាដៃយើងនឹងឈប់ពីការងារ, ហើយថាយើងនឹងបញ្ឈប់.
ហើយសូមឱ្យយើងបិទទ្វារព្រះវិហារ.
ខ្ញុំនឹងមិនចូលទេ។
6:13 សម្រាប់គាត់បានទទួលយកប្រាក់, ដូច្នេះខ្ញុំនឹងខ្លាច, ហើយនឹងធ្វើបាប, ហើយពួកគេនឹងមានអំពើអាក្រក់ដែលនឹងស្តីបន្ទោសខ្ញុំ.
បន្ទាប់មក, ផងដែរ, ណូដាយ៉ា, ព្យាការី, និងហោរាឯទៀតៗ, នឹងធ្វើឱ្យខ្ញុំភ័យខ្លាច.
6:16 បន្ទាប់មកវាបានកើតឡើង, នៅពេលដែលសត្រូវរបស់យើងបាន all អំពីរឿងនេះ, ប្រជាជាតិទាំងអស់ដែលនៅជុំវិញយើងភ័យខ្លាច, ហើយពួកគេមើលងាយខ្លួនឯង.
6:17 ប៉ុន្តែក៏, នៅក្នុង ថ្ងៃ ទាំងនោះ, សំបុត្រជាច្រើនត្រូវបានផ្ញើដោយពួកអភិជននៃជនជាតិយូដាទៅថូប៊ីយ៉ា, ហើយធ្វើដំណើរពីថូប៊ីយ៉ាមករកពួកគេ.
6:19 លើសពីនេះទៅទៀត, ពួកគេសរសើរគាត់នៅចំពោះមុខខ្ញុំ, ហើយពួកគេបានរាយការណ៍ពាក្យរបស់ខ្ញុំទៅគាត់.
7:2 ខ្ញុំបានណែនាំហាណានី, បងប្រុស ខ្ញុំ, និងហាណានាស, មេដឹកនាំក្រុមគ្រួសារនៅក្រុងយេរូសាឡឹម, (ដ្បិតគាត់ហាក់ដូចជាមនុស្សស្មោះត្រង់, ការកោតខ្លាចព្រះច្រើនជាងអ្នកឯទៀត,)
ខ្ញុំដាក់ទាហានការពារនៅក្រុងយេរូ សាឡឹម, ពួកគេម្នាក់ៗតាមវេនរបស់គាត់, ម្នាក់ៗនៅទល់មុខនឹងផ្ទះរៀងៗខ្លួន.
7:5 ប៉ុន្តែព្រះបានប្រទានដល់ដួងចិត្តខ្ញុំ, ហើយខ្ញុំបានប្រមូលពួកអភិជន, និងចៅក្រម, និងមនុស្សសាមញ្ញ, ដូច្នេះខ្ញុំអាចចុះឈ្មោះពួកគេ.
7:6 ទាំងនេះជាកូនប្រុសរបស់ខេត្ត, ដែលបានឡើងពីការជាប់ជាឈ្លើយនៃការឆ្លងទន្លេ, អ្នកដែលនេប៊ូក្នេសា, ស្តេចស្រុកបាប៊ីឡូន, បានយកទៅឆ្ងាយ, និងអ្នកដែលត្រឡប់ទៅក្រុងយេរូសាឡឹមនិងស្រុកយូដា, ម្នាក់ៗនៅក្រុងរបស់គេ.
ចំនួនបុរសនៃជនជាតិអ៊ីស្រាអែល:
7:11 កូនរបស់ផាផាហាំមាប់នៃកូនរបស់យេសួនិងយ៉ូអាប់, ពីរពាន់ប្រាំបីរយដប់ប្រាំបី.
7:39 ពួកសង្ឃ: កូនប្រុសរបស់លោកយេដាយ៉ានៅផ្ទះលោកយេសស៊ូ, ប្រាំបួនរយចិតសិបបី.
7:41 កូនប្រុសរបស់ផាសហួរ, មួយពាន់ពីររយសែសិបប្រាំពីរ.
7:43 ពួកលេវី: កូនរបស់លោកយេសួនិងកាឌៀល, កូនប្រុស
7:46 អ្នកការពារទ្វារ: កូនប្រុសរបស់សាលូម, កូនប្រុសរបស់ Ater, កូនប្រុសរបស់ Talmon, កូនប្រុសរបស់អាក់គូ, កូនប្រុសរបស់ហាតតា, កូនប្រុសរបស់លោកសូបាយ, មួយរយសាមសិបប្រាំបី.
7:60 អ្នកបម្រើព្រះវិហារទាំងអស់និងកូន ៗ របស់អ្នកបំរើសាឡូម៉ូន, បីរយកៅសិបពីរ.
7:64 ទាំងនេះបានស្វែងរកការសរសេររបស់ពួកគេនៅក្នុងជំរឿន, ហើយពួកគេមិនបានរកឃើញទេ, ដូច្នេះពួកគេត្រូវបានបណ្តេញចេញពីបព្វជិតភាព.
7:66 ហ្វូងមនុស្សទាំងមូល, ដែលដូចជាបុរសតែម្នាក់, គឺសែសិបពីរពាន់បីរយហុកសិប,
7:68 សេះរបស់ពួកគេមានប្រាំពីររយសាមសិបប្រាំមួយ; កូនលារបស់ពួកគេមានពីររយសែសិបប្រាំ.
7:70 ឥឡូវមេដឹកនាំមួយចំនួននៃក្រុមគ្រួសារបានប្រគល់ការងារនេះ.
7:71 មេដឹកនាំខ្លះនៃក្រុមគ្រួសារបានប្រគល់មាសចំនួនម្ភៃម៉ឺនដុងដល់ហិបនោះ, និងប្រាក់ពីរពាន់ពីររយមីលីលីត្រ.
7:73 ឥឡូវនេះបូជាចារ្យ, និងពួកលេវី, និងអ្នកយាមទ្វារ, និងបុរសច្រៀង, និងមនុស្សសាមញ្ញផ្សេងទៀត, និងអ្នកបម្រើព្រះវិហារបរិសុទ្ធ, ជនជាតិអ៊ីស្រាអែលទាំងអស់រស់នៅក្នុងក្រុងរបស់ខ្លួន.
8:1 ហើយខែទីប្រាំពីរបានមកដល់.
ហើយប្រជាជនទាំងអស់បានប្រមូលផ្តុំគ្នា, ដូចបុរសម្នាក់, នៅតាមផ្លូវដែលនៅមុខទ្វារទឹក.
8:2 ដូច្នេះ, លោកបូជាចារ្យអែសរ៉ាបាននាំក្រឹត្យវិន័យមកទាំងប្រុសទាំងស្រី, និងអស់អ្នកដែលអាចយល់បាន, នៅថ្ងៃទីមួយនៃខែទីប្រាំពីរ.
ហើយត្រចៀករបស់ប្រជាជនទាំងអស់បានយកចិត្តទុកដាក់ចំពោះសៀវភៅនេះ.
ឈរនៅក្បែរគាត់គឺម៉ាថាធី, និងសេម៉ាយ៉ា, និងអាណានា, និងអ៊ូរី, និងហ៊ីលគីយ៉ា, និងម៉ាសេយ៉ា, នៅខាងស្តាំគាត់.
8:5 លោកអែសរ៉ាបើកគម្ពីរនៅចំពោះមុខប្រជាជនទាំងមូល.
ហើយនៅពេលដែលគាត់បានបើកវា, ប្រជាជនទាំងអស់ក៏ក្រោកឈរឡើង.
ហើយប្រជាជនទាំងអស់បានឆ្លើយតប, “ អាម៉ែន, អាម៉ែន,លើកដៃឡើង.
8:8 ហើយពួកគេអានពីសៀវភៅក្រឹត្យវិន័យរបស់ព្រះ, ច្បាស់និងច្បាស់, ដូច្នេះត្រូវយល់.
8:9 បន្ទាប់មកនេហេមា (អ្នកកាន់ពែងក៏ដូច្នោះដែរ) និងអែសរ៉ា, បូជាចារ្យនិងអាចារ្យ, និងពួកលេវី, ដែលត្រូវបានបកប្រែសម្រាប់ប្រជាជនទាំងអស់, បាននិយាយ: ថ្ងៃនេះត្រូវបានញែកថ្វាយព្រះ អម្ចាស់ជាព្រះរបស់យើង.
8:10 ព្រះអង្គមានព្រះបន្ទូលទៅគេថា៖: “ ទៅ, បរិភោគអាហារមានជាតិខ្លាញ់និងផឹកភេសជ្ជៈផ្អែម, ហើយផ្ញើចំណែកទៅអ្នកដែលមិនបានរៀបចំខ្លួន.
ព្រោះពួកគេបានយល់ពាក្យដែលលោកបានបង្រៀនពួកគេ.
8:14 ហើយពួកគេបានរកឃើញថាមានសរសេរនៅក្នុងច្បាប់, ដែលព្រះអម្ចាស់បានណែនាំតាមរយៈលោកម៉ូសេ, នៅថ្ងៃទីប្រាំពីរនៃខែដ៏ឧត្តុង្គឧត្ដមជនជាតិអ៊ីស្រាអែលត្រូវរស់នៅតាមកន្លែងគោរពបូជា,
8:17 ដូច្នេះ, អង្គប្រជុំទាំងមូលរបស់អស់អ្នកដែលបានវិលត្រឡប់មកពីកន្លែងជាប់ជាឈ្លើយបានបង្កើតជារោងឧបោសថហើយរស់នៅក្នុងរោងឧបោសថ.
ហើយពួកគេបានរក្សាភាពឧឡារិកអស់រយៈពេលប្រាំពីរថ្ងៃ.
9:2 ហើយពូជពង្សរបស់កូនចៅអ៊ីស្រាអែលត្រូវបានញែកចេញពីកូនចៅរបស់ជនបរទេស.
ពួកគេគោរពកោតខ្លាចព្រះ អម្ចាស់ជាព្រះរបស់ពួកគេ.
សូមលើកតម្កើងព្រះអម្ចាស់ជាព្រះរបស់អ្នក, ពីអស់កល្បជានិច្ចរហូតដល់អស់កល្ប!
9:6 អ្នកតែម្នាក់ឯង, គាត់គឺជាម្ចាស់, បានធ្វើឱ្យស្ថានសួគ៌, និងមេឃនៃមេឃ, និងម៉ាស៊ីនរបស់ពួកគេទាំងអស់, ផែនដីនិងអ្វីៗទាំងអស់ដែលមាននៅក្នុងនោះ, សមុទ្រនិងអ្វីៗទាំងអស់ដែលមាននៅក្នុងនោះ.
9:9 អ្នកបានឃើញទុក្ខវេទនារបស់បុព្វបុរសរបស់យើងនៅស្រុកអេស៊ីប.
9:10 ហើយអ្នកបានអោយទីសំគាល់និងរូបសញ្ញាដល់ព្រះចៅផារ៉ោន, និងដល់អ្នកបំរើទាំងអស់របស់គាត់, និងប្រជាជននៅលើទឹកដីរបស់គាត់.
ហើយអ្នកបានបង្កើតឈ្មោះសម្រាប់ខ្លួនអ្នក, ដូចសព្វថ្ងៃនេះ.
ប៉ុន្តែអ្នកដេញតាមពួកគេដេញចូលទៅក្នុងជំរៅ, ដូចដុំថ្មចូលទៅក្នុងទឹកដ៏អស្ចារ្យ.
9:13 អ្នកក៏ចុះពីលើភ្នំស៊ីណៃដែរ, ហើយអ្នកបាននិយាយជាមួយពួកគេពីលើមេឃ.
9:14 អ្នកបានបង្ហាញដល់ពួកគេនូវថ្ងៃឈប់សម្រាកដ៏បរិសុទ្ធរបស់អ្នក, ហើយអ្នកបានណែនាំពួកគេនៅក្នុងបទបញ្ជា, និងពិធី, និងច្បាប់, ដោយដៃរបស់លោកម៉ូសេ, អ្នកបំរើរបស់អ្នក.
ហើយអ្នកបានប្រាប់ពួកគេថាពួកគេគួរតែចូលនិងកាន់កាប់ដីនេះ, អ្នកលើកដៃឡើងលើដើម្បីអោយអ្នកប្រគល់អោយគេ.
9:17 ហើយពួកគេមិនចង់ស្តាប់, ហើយពួកគេមិនបានចាំទេ, អព្ភូតហេតុរបស់អ្នកដែលអ្នកបានធ្វើសម្រាប់ពួកគេ.
ប៉ុន្តែ អ្នក, ព្រះសន្ដោស, មានភាពអត់ធ្មត់និងមេត្តាករុណា, អត់ធ្មត់និងពោរពេញដោយក្តីមេត្តា, មិនបានបោះបង់ចោលពួកគេទេ.
9:19 ទោះ អញ្ចឹង ក្ដី, ក្នុងសេចក្តីមេត្តាករុណារបស់អ្នក, ព្រះ អង្គពុំបានចាត់គេ ឲ្យ ទៅវាលរហោ ស្ថានឡើយ.
9:20 ហើយអ្នកបានផ្តល់ឱ្យពួកគេនូវវិញ្ញាណល្អរបស់អ្នក, ដូច្នេះគាត់អាចបង្រៀនពួកគេ, ហើយអ្នកមិនបានឃាត់នំម៉ាណារបស់អ្នកពីមាត់ពួកគេទេ, ព្រះអង្គបានប្រទានទឹកអោយពួកគេដោយអត់អាហារ.
9:22 ព្រះអង្គបានប្រគល់នគរនិងប្រជាជនអោយពួកគេ, ហើយអ្នកបានចែកចាយដល់ពួកគេជាច្រើន.
9:23 អ្នកបានធ្វើអោយកូនប្រុសរបស់គេកើនចំនួនច្រើនឡើងដូចផ្កាយនៅលើមេឃ.
9:24 ហើយកូនប្រុសបានមកដល់ហើយកាន់កាប់ដីនោះ.
ព្រះ អង្គប្រគល់ពួកគេទៅក្នុងកណ្ដាប់ដៃរបស់ពួកគេ, ជាមួយស្តេចរបស់ពួកគេ, និងប្រជាជននៅស្រុកនោះ, ដើម្បីអោយគេប្រព្រឹត្ដចំពោះពួកគេស្របតាមអំពើចិត្ដរបស់គេ.
ហើយពួកគេត្រូវបានគេបំប៉ន, ហើយពួកគេបានអរសប្បាយនឹងភាពល្អអស្ចារ្យរបស់អ្នក.
ហើយពួកគេបានសម្លាប់ព្យាការីរបស់អ្នក, ដែលបានបន្ទោសពួកគេដូច្នេះថាពួកគេអាចនឹងត្រឡប់មកវិញ.
9:27 ដូច្នេះព្រះអង្គបានប្រគល់ពួកគេទៅក្នុងកណ្តាប់ដៃរបស់ខ្មាំងសត្រូវរបស់ពួកគេ, ហើយពួកគេបានធ្វើបាបពួកគេ.
ព្រះ អង្គបោះបង់ចោលពួកគេទៅក្នុងកណ្ដាប់ដៃរបស់ខ្មាំងសត្រូវ, ហើយពួកគេបានកាន់កាប់ពួកគេ.
នៅឡើយទេ, ពួកគេប្រព្រឹត្តដោយក្រអឺតក្រទម, ពួកគេមិនស្តាប់តាមបទបញ្ជារបស់ព្រះអង្គទេ, ពួកគេបានប្រព្រឹត្តខុសនឹងវិន័យរបស់អ្នក, ដែល, ប្រសិនបើបុរសធ្វើពួកគេ, គាត់នឹងរស់នៅដោយពួកគេ.
9:30 ហើយអ្នកបានបន្តហាមឃាត់ពួកគេអស់រយៈពេលជាច្រើនឆ្នាំ.
ហើយពួកគេមិនបានស្តាប់, ដូច្នេះព្រះអង្គប្រគល់ពួកគេទៅក្នុងកណ្តាប់ដៃរបស់ប្រជាជាតិនានា.
9:33 សម្រាប់អ្នកគឺគ្រាន់តែ, ទាក់ទងនឹងអ្វីទាំងអស់ដែលបានគ្របដណ្តប់យើង.
9:34 ស្តេចរបស់យើង, មេដឹកនាំរបស់យើង, បូជាចារ្យរបស់យើង, បុព្វបុរសរបស់យើងមិនបានធ្វើតាមក្រឹត្យ វិន័យរបស់ព្រះ អង្គទេ, ហើយពួកគេមិនបានយកចិត្តទុកដាក់នឹងបទបញ្ជានិងទីបន្ទាល់របស់អ្នកឡើយ, ដែលអ្នកបានធ្វើជាបន្ទាល់អំពីរឿងទាំងនោះ.
9:37 ហើយផ្លែឈើរបស់វាត្រូវបានគេគុណសម្រាប់ស្តេច, ព្រះអង្គបានតែងតាំងយើងអោយរួចផុតពីបាបរបស់យើងខ្ញុំ.
10:31 នោះផងដែរ, ប្រសិនបើប្រជាជននៅលើដីដឹកទំនិញសម្រាប់លក់ឬរបស់ដែលមានប្រយោជន៍, ដូច្នេះពួកគេនឹងលក់ពួកគេនៅថ្ងៃឈប់សម្រាក, ថាយើងនឹងមិនទិញវានៅថ្ងៃឈប់សម្រាកទេ, ហើយក៏មិនមែននៅថ្ងៃបរិសុទ្ធដែរ, ហើយយើងនឹងដោះលែងឆ្នាំទី ៧ និងការប្រមូលបំណុលពីគ្រប់ដៃ.
10:33 សម្រាប់នំប៉័ងនៃវត្តមាន, និងសម្រាប់ការបូជាឥតឈប់ឈរ, និងសម្រាប់ការដុតបំផ្លាញជារៀងរហូតនៅថ្ងៃឈប់សម្រាក, នៅលើខែថ្មី, នៅលើភាពឧឡារិកនេះ, និងសម្រាប់អ្វីដែលបរិសុទ្ធ, និងសំរាប់យញ្ញបូជារំដោះបាប, ដូច្នេះដង្វាយធួននឹងត្រូវបានធ្វើឡើងសម្រាប់អ៊ីស្រាអែល, ហើយសំរាប់ប្រើប្រាស់នៅក្នុងព្រះដំណាក់នៃព្រះរបស់យើង.
10:35 ដូច្នេះយើងនឹងនាំភោគផលដំបូងពីទឹកដីរបស់យើង, និងផលដំបូងនៃផលទាំងអស់ពីដើមឈើទាំងអស់, ពីមួយឆ្នាំទៅមួយឆ្នាំ, នៅក្នុងដំណាក់របស់ព្រះ អម្ចាស់,
10:37 ហើយដូច្នេះយើងអាចនាំផលដំបូងនៃអាហាររបស់យើង, និងការផ្សាយរបស់យើង, និងផ្លែនៃដើមឈើទាំងអស់, ផងដែរនៃរសជាតិនិងប្រេង, ដល់បូជាចារ្យ, ទៅឃ្លាំងរបស់ព្រះនៃយើង, ដីរបស់យើងមួយភាគដប់សំរាប់ពួកលេវី.
10:38 ឥឡូវបូជាចារ្យ, កូនប្រុសរបស់លោកអើរ៉ុន, ត្រូវនៅជាមួយពួកលេវីក្នុងមួយភាគដប់នៃក្រុមលេវី, ពួកលេវីត្រូវថ្វាយមួយភាគដប់នៅក្នុងព្រះវិហារនៃព្រះរបស់យើង, ទៅបន្ទប់ផ្ទុកទំនិញក្នុងផ្ទះនៃរតនាគារ.
ហើយនៅទីនោះមានគ្រឿងប្រដាប់ដ៏វិសុទ្ធ, និងបូជាចារ្យ, និងបុរសច្រៀង, និងអ្នកយាមទ្វារ, និងរដ្ឋមន្រ្តី.
នៅឡើយទេ, ប្រជាជនដែលនៅសេសសល់នាំគ្នាបោះឆ្នោតជាច្រើន, ដូច្នេះពួកគេអាចជ្រើសរើសចំណែកមួយក្នុងចំណោមដប់នាក់ដែលត្រូវរស់នៅក្នុងក្រុងយេរូសាឡិម, ទីក្រុងបរិសុទ្ធ, និងប្រាំបួនផ្នែកសម្រាប់ទីក្រុងផ្សេងទៀត.
11:3 ដូច្នេះហើយទាំងនេះគឺជាអ្នកដឹកនាំខេត្ត, ដែលរស់នៅក្នុងក្រុងយេរូសាឡិម, នៅតាមក្រុងនានាក្នុងស្រុកយូដា.
11:4 ហើយនៅក្រុងយេរូសាឡិម, កូនប្រុសៗរបស់ជនជាតិយូដាខ្លះរស់នៅ, និងកូនប្រុសខ្លះរបស់បេនយ៉ាមីន: ក្នុងកុល សម្ព័ន្ធយូដា, អាថាលា, កូនប្រុសរបស់ Aziam, ជាកូនរបស់លោកសាការី, ជាកូនរបស់លោកអម៉ាម៉ារី, ជាកូនរបស់សេផាថា, កូនប្រុសរបស់ម៉ាហាឡាលល, នៃកូនប្រុសរបស់ Perez បាន;
11:6 កូនប្រុសទាំងអស់របស់ពេរេសរស់នៅក្នុងក្រុងយេរូសាឡិម, បុរសខ្លាំងចំនួនបួនរយហុកសិបប្រាំបីនាក់.
11:12 និងបងប្អូនរបស់ពួកគេ, ពួកគេជាអ្នកធ្វើកិច្ចការព្រះវិហារ: ប្រាំបីរយម្ភៃពីរ.
11:13 និងបងប្អូនរបស់គាត់, មេដឹកនាំក្នុងចំណោមឪពុក: ពីររយសែសិបពីរ.
11:14 និងបងប្អូនរបស់ពួកគេ, ដែលមានឥទ្ធិពលខ្លាំងណាស់: មួយរយម្ភៃប្រាំបី.
11:17 និងម៉ាធៀនា, កូនប្រុសរបស់មីកា, កូនប្រុសរបស់លោកហ្សាបឌី, កូនប្រុសរបស់អេសាភ, គឺជាអ្នកដឹកនាំនៃការសរសើរនិងការសារភាពនៅក្នុងការអធិស្ឋាន, ជាមួយ Bakbukiah, ទីពីរក្នុងចំណោមបងប្អូនរបស់គាត់, និងអាដា, កូនប្រុសរបស់សាម៉ា, កូនប្រុសរបស់កាលីឡេ, កូនប្រុសរបស់លោកយេឌូថុន.
11:21 ចំណែកឯអ្នកបម្រើព្រះវិហារកំពុងរស់នៅអូអូល, ជាមួយហ្សៃហានិងហ្គីសប៉ា, នៃអ្នកបម្រើព្រះវិហារបរិសុទ្ធ.
បុរសដែលច្រៀងនៅក្នុងកិច្ចការនៃព្រះដំណាក់របស់ព្រះជាម្ចាស់គឺមកពីកូនចៅរបស់អេសាភ.
11:24 និងភីថាហៃ, កូនប្រុសរបស់លោកមេសហ្សែល, ពីកូនរបស់សេរ៉ា, កូនប្រុសរបស់យូដា, ព្រះចៅផារ៉ោនស្ថិតនៅក្នុងកណ្ដាប់ដៃរបស់ព្រះរាជាទាក់ទងនឹងពាក្យរបស់ប្រជាជនទាំងអស់,
កូនប្រុសៗរបស់កុលសម្ព័ន្ធយូដាមួយចំនួនបានរស់នៅគីរីរីហាបានិងក្នុងភូមិកូនស្រីរបស់វា, និងនៅឌិបនិងក្នុងភូមិកូនស្រីរបស់វា, និងនៅ Jekabzeel និងនៅក្បែរនោះ,
11:36 ហើយក្រុមលេវីខ្លះត្រូវបានបែងចែកទៅជាកុលសម្ព័ន្ធយូដានិងបេនយ៉ាមីន.
12:1 នេះជាក្រុមបូជាចារ្យនិងក្រុមលេវីដែលឡើងជាមួយសេរូបបាបិល, កូនប្រុសរបស់សេលលែល, និងជេសួ: សេរ៉ាសៀ, យេរេមា, អេហ្សរ៉ា,
12:7 ទាំងនេះជាមេដឹកនាំសង្ឃនិងបងប្អូនរបស់ពួកគេ, នៅជំនាន់របស់ចាស.
12:11 លោកយ៉ូអាដាមានគភ៌យ៉ូណាថាន, សម្ដេចយ៉ូណាថានមានផ្ទៃពោះលោកយ៉ាដា.
12:23 កូនប្រុសរបស់លេវី, នេះបើយោងតាមមេក្រុមគ្រួសារ, បានត្រូវសរសេរក្នុងសៀវភៅនៃពាក្យនៅគ្រានោះ, សូម្បីដល់ជំនាន់យ៉ូហាណាន, កូនប្រុសរបស់អេលីយ៉ាស៊ីស.
ហើយពួកគេបានបម្រើស្មើៗគ្នានិងមានសណ្តាប់ធ្នាប់.
12:26 ទាំងនេះគឺនៅជំនាន់របស់យ៉ូយ៉ាគីម, កូនប្រុសរបស់លោកជេសួ, កូនប្រុសរបស់យ៉ូសដាដ, ហើយនៅសម័យនេហេមា, អភិបាល, និងរបស់អែសរ៉ា, បូជាចារ្យនិងអាចារ្យ.
12:28 ឥឡូវនេះកូនប្រុសរបស់បុរសច្រៀងបានមកប្រមូលផ្តុំគ្នានៅតំបន់វាលទំនាបជុំវិញក្រុងយេរូសាឡឹម, និងមកពីភូមិនានានៃ Netophati,
សម្រាប់បុរសច្រៀងបានកសាងភូមិសម្រាប់ខ្លួនគេនៅជុំវិញក្រុងយេរូសាឡឹម.
12:31 បន្ទាប់មកខ្ញុំអោយពួកមេដឹកនាំនៃស្រុកយូដាឡើងទៅកំពែងក្រុង, ហើយខ្ញុំបានតែងតាំងក្រុមចម្រៀងដ៏អស្ចារ្យពីរដើម្បីសរសើរ.
12:32 ហើយបន្ទាប់ពីពួកគេបានទៅហូសាយ៉ា, និងពាក់កណ្តាលនៃការដឹកនាំរបស់យូដា,
12:34 ហើយកូនប្រុសខ្លះរបស់បូជាចារ្យបានចេញមកជាមួយនឹងត្រែ: Zachariah, កូនប្រុសរបស់យ៉ូណាថាន, កូនប្រុសរបស់សេម៉ាយ៉ា, កូនប្រុសរបស់ម៉ាន់ទីយ៉ា, កូនប្រុសរបស់មីកាយ៉ា, កូនប្រុសរបស់លោកសាក្រូស, កូនប្រុសរបស់អេសាភ.
និងអេហ្សរ៉ា, អាចារ្យ, គឺនៅខាងមុខពួកគេនៅមាត់ទ្វារប្រភពទឹក.
12:37 ហើយក្រុមចម្រៀងទីពីរនៃអ្នកដែលបានថ្លែងអំណរគុណបានចេញទៅម្ខាងទៀត, ហើយខ្ញុំបានទៅតាមពួកគេ, និងពាក់កណ្តាលនៃប្រជាជនបាននៅលើជញ្ជាំង, ហើយនៅលើប៉មនៃចង្រ្កាន, ដូចជានៅឆ្ងាយដូចជាជញ្ជាំងធំបំផុត,
ពួកគេក៏ឈប់នៅមាត់ទ្វារ.
ហើយអ្នកច្រៀងបានច្រៀងយ៉ាងច្បាស់, ហើយយេសេរ៉ាជាមេដឹកនាំសំខាន់បំផុតរបស់ពួកគេ.
ហើយសំរែកក្រុងយេរូសាឡិមបាន was ពីចម្ងាយ.
ដ្បិតជនជាតិយូដាសប្បាយចិត្តនឹងក្រុមបូជាចារ្យនិងក្រុមលេវីដែលបានជួយ.
12:45 ដ្បិតនៅជំនាន់ដាវីឌនិងអេសាភ, តាំងពីដំបូង, មានមេដឹកនាំត្រូវបានតែងតាំងជាអ្នកចំរៀង, ដើម្បីផ្តល់ការសរសើរនៅក្នុងខ, និងដើម្បីសារភាពដល់ព្រះ.
ហើយនៅក្នុងវា, មានគេសរសេរថាជនជាតិអាំម៉ូននិងជនជាតិម៉ូអាប់មិនត្រូវចូលព្រះវិហាររបស់ព្រះជាម្ចាស់ឡើយ, សូម្បីតែសម្រាប់គ្រប់ពេលវេលា,
ប៉ុន្តែព្រះរបស់យើងបានប្រែក្លាយបណ្តាសាទៅជាព្រះពរ.
13:4 និងអេលីយ៉ាស៊ីស, បូជាចារ្យ, គឺនៅលើភារកិច្ចនេះ; គាត់បានទទួលមុខងារជារតនាគារនៃព្រះដំណាក់នៃព្រះរបស់យើង, គាត់ជាសាច់ញាតិជិតស្និទ្ធរបស់ថូប៊ីយ៉ា.
13:6 ប៉ុន្តែក្នុងអំឡុងពេលទាំងអស់នេះ, ខ្ញុំមិននៅក្រុងយេរូសាឡិមទេ, ពីព្រោះនៅឆ្នាំទីសាមសិបពីរនៃអាតាស៊ើរសេស, ស្តេចស្រុកបាប៊ីឡូន, ខ្ញុំបានទៅគាល់ព្រះរាជា, ហើយនៅចុងបញ្ចប់នៃថ្ងៃខ្លះ, ខ្ញុំបានដាក់ញត្តិទៅព្រះមហាក្សត្រ.
13:9 ហើយខ្ញុំបានផ្តល់ការណែនាំ, ហើយពួកគេបានសម្អាតបន្ទប់ដាក់ឥវ៉ាន់ម្ដងទៀត.
13:10 ហើយខ្ញុំដឹងថាចំណែករបស់ពួកលេវីមិនត្រូវបានគេផ្តល់ឱ្យទេ, ហើយម្នាក់ៗបានភៀសខ្លួនទៅតំបន់របស់ខ្លួន, ពីលេវី, និងពីបុរសច្រៀង, និងពីអ្នកដែលបំរើ.
?ហើយខ្ញុំបានប្រមូលពួកគេជាមួយគ្នា, ហើយខ្ញុំអោយពួកគេឈរនៅស្ថានីយ៍របស់ពួកគេ.
13:13 ហើយយើងបានតែងតាំងលើឃ្លាំង, សេឡៃឡៃ, បូជាចារ្យ, និងហ្សាដុក, អាចារ្យ, និងដាដាយ៉ាមកពីពួកលេវី, និងនៅជាប់នឹងពួកគេហាណាន, កូនប្រុសរបស់លោកសាក្រូស, កូនប្រុសរបស់ម៉ាន់ទីយ៉ា.
ដូច្នេះផ្នែកនៃបងប្អូនរបស់ពួកគេត្រូវបានប្រគល់ឱ្យពួកគេ.
13:16 ហើយជនជាតិទីរ៉ុខ្លះរស់នៅក្នុងនោះ, ដែលបាននាំយកត្រីនិងរបស់របរគ្រប់ប្រភេទមកលក់.
13:17 យើងបានតែងតាំងពួកអភិជននៃស្រុកយូដាអោយស្បថ, ហើយខ្ញុំបាននិយាយទៅពួកគេ: អ្វីដែលអ្នកកំពុងធ្វើគឺអាក្រក់ណាស់, បង្អាប់ថ្ងៃឈប់សំរាក?
ហើយអ្នកកំពុងបន្ថែមកំហឹងមកលើអ៊ីស្រាអែលដោយរំលោភលើថ្ងៃឈប់សម្រាក!”
ហើយខ្ញុំបានណែនាំថាពួកគេមិនគួរបើកទ្វារពួកគេរហូតដល់ថ្ងៃឈប់សម្រាក.
13:20 ដូច្នេះពួកឈ្មួញនិងពួកអ្នកលក់ទំនិញគ្រប់ប្រភេទនៅខាងក្រៅក្រុងយេរូសាឡឹម, ម្តងហើយម្តងទៀត.
ប្រសិនបើអ្នកធ្វើបែបនេះម្តងទៀត, ខ្ញុំនឹងបញ្ជូនអ្នកមកលើអ្នក” ។ ហើយ ដូច្នេះ, ចាប់ពីពេលនោះមក, ពួកគេឈប់សម្រាកនៅថ្ងៃឈប់សម្រាកទៀតហើយ.
ដោយសារតែនេះផងដែរ, អូ ព្រះ អើយ, ចងចាំខ្ញុំហើយទុកឱ្យខ្ញុំ, ត្រូវនឹងសេចក្តីមេត្តាករុណារបស់ព្រះអង្គ.
13:24 ហើយកូនប្រុសរបស់ពួកគេបាននិយាយមួយផ្នែកនៅក្នុងសុន្ទរកថារបស់អាសដូឌ, អ្នកទាំងនោះមិនចេះនិយាយភាសាយូដាទេ, ហើយពួកគេនិយាយភាសារបស់មនុស្សម្នាក់ឬមួយផ្សេងទៀត.
ហើយខ្ញុំបានវាយប្រហារបុរសមួយចំនួនរបស់ពួកគេ, ហើយខ្ញុំកោរសក់សក់របស់ពួកគេ, ហើយខ្ញុំបានអោយពួកគេស្បថនឹងព្រះថាពួកគេនឹងមិនផ្តល់កូនស្រីដល់កូនប្រុសរបស់ពួកគេឡើយ, ហើយក៏មិនត្រូវយកកូនស្រីរបស់ពួកគេសម្រាប់កូនប្រុសរបស់ពួកគេដែរ, ហើយក៏មិនមែនសម្រាប់ខ្លួនគេដែរ, និយាយ:
13:27 ដូច្នេះតើយើងអាចមិនស្តាប់បង្គាប់និងធ្វើអំពើអាក្រក់ដ៏អស្ចារ្យទាំងនេះយ៉ាងដូចម្តេច, ដូច្នេះយើងខ្ញុំនឹងក្បត់ព្រះរបស់យើង, ហើយយកប្រពន្ធបរទេស?”
13:29 គាត់គឺជាម្ចាស់, ព្រះជាម្ចាស់, ចូរចាំពីអស់អ្នកដែលបន្ថោកបព្វជិតភាពនិងក្រឹត្យវិន័យរបស់បូជាចារ្យនិងក្រុមលេវី!
13:31 អូ ព្រះ អើយ, ចាំខ្ញុំផង, សម្រាប់ការល្អ, ដោយសារតែការថ្វាយឈើ, នៅពេលកំណត់, ហើយដោយសារតែផលដំបូង.
2:5 សូម្បីតែនៅពេលដែលយើងបានស្លាប់នៅក្នុងអំពើបាបរបស់យើង, បានរួមជាមួយយើងក្នុងអង្គព្រះគ្រិស្ដ, ព្រះអង្គបានសង្គ្រោះបងប្អូនតាមរយៈព្រះគុណរបស់ព្រះអង្គ.
2:7 ដូច្នេះគាត់អាចបង្ហាញ, ក្នុងពេលឆាប់ៗនេះនឹងមកដល់, ទ្រព្យសម្បត្តិដ៏បរិបូណ៌នៃព្រះគុណរបស់ព្រះអង្គ, ដោយសារព្រះហឫទ័យសប្បុរសរបស់ព្រះអង្គចំពោះយើងក្នុងព្រះគ្រិស្ដយេស៊ូ.
ហើយនេះមិនមែនជាខ្លួនអ្នកទេ, វាជាអំណោយទានរបស់ព្រះជាម្ចាស់.
2:10 យើងជាស្នាដៃរបស់ព្រះអង្គ, បង្កើតក្នុងអង្គព្រះគ្រិស្ដយេស៊ូសំរាប់ប្រព្រឹត្ដអំពើល្អដែលព្រះអង្គបានរៀបចំទុកហើយយើងត្រូវរស់នៅ.
3:11 នេះបើយោងតាមគោលបំណងមិនចេះចប់នោះ, ដែលព្រះអង្គបានបង្កើតឡើងក្នុងអង្គព្រះគ្រិស្ដយេស៊ូជាព្រះអម្ចាស់នៃយើង.
3:15 ដែលជាប្រភពនៃបុព្វបុរសទាំងនៅស្ថានសួគ៌និងនៅលើផែនដី.
3:1 មានបុរសម្នាក់ខាងគណៈផារីស៊ី, ឈ្មោះនីកូដេម, មេដឹកនាំជនជាតិយូដា.
3:5 ព្រះយេស៊ូវបានឆ្លើយតប: “ អាម៉ែន, អាម៉ែន, ខ្ញុំនិយាយទៅកាន់អ្នក, លើកលែងតែមនុស្សម្នាក់បានកើតជាថ្មីដោយសារទឹកនិងព្រះវិញ្ញាណបរិសុទ្ធ, គាត់មិនអាចចូលទៅក្នុងនគរព្រះបានទេ.
ហើយអ្នកលឺសំលេងរបស់គាត់, ប៉ុន្ដែអ្នករាល់គ្នាមិនដឹងថាគាត់មកពីណាទេ, ឬកន្លែងដែលគាត់ត្រូវទៅ.
3:9 លោកនីកូដេមតបទៅព្រះអង្គវិញ, “ តើរឿងទាំងនេះអាចសំរេចបានដោយរបៀបណា?
3:10 ព្រះយេស៊ូមានព្រះបន្ទូលទៅគាត់ថា៖: អ្នកគឺជាគ្រូបង្រៀនម្នាក់នៅអ៊ីស្រាអែល, ហើយអ្នកល្ងង់ខ្លៅអំពីរឿងទាំងនេះ?
ប៉ុន្តែអ្នកមិនទទួលយកទីបន្ទាល់របស់យើងទេ.
3:13 ហើយគ្មាននរណាម្នាក់បានឡើងទៅស្ថានសួគ៌ទេ, លើកលែងតែអ្នកដែលចុះមកពីស្ថានបរមសុខ: កូនមនុស្សនៅស្ថានបរមសុខ.
3:15 ដូច្នេះអ្នកណាជឿលើព្រះអង្គមិនត្រូវវិនាសឡើយ, ប៉ុន្តែអាចមានជីវិតអស់កល្បជានិច្ច.
3:17 ព្រះជាម្ចាស់មិនបានចាត់ព្រះបុត្រារបស់ព្រះអង្គអោយយាងមកក្នុងលោកនេះទេ, ក្នុងគោលបំណងដើម្បីវិនិច្ឆ័យពិភពលោក, ប៉ុន្តែដើម្បីឱ្យពិភពលោកអាចត្រូវបានសង្គ្រោះតាមរយៈគាត់.
សម្រាប់ការប្រព្រឹត្ដរបស់ពួកគេគឺអាក្រក់.
3:21 អ្នកណាប្រព្រឹត្ដតាមសេចក្ដីពិតអ្នកនោះបែរទៅរកពន្លឺ, ដើម្បីអោយស្នាដៃរបស់ព្រះអង្គលេចចេញមក, ពីព្រោះពួកគេបានសម្រេចនៅក្នុងព្រះហើយ។
12:2 បុរសអ្នកមានមានចៀមនិងគោយ៉ាងច្រើន.
ហើយនាងបានធំឡើងនៅចំពោះមុខគាត់, រួមគ្នាជាមួយកូន ៗ របស់គាត់, បរិភោគពីនំប៉័ងរបស់គាត់, និងផឹកពីពែងរបស់គាត់, ហើយដេកនៅលើទ្រូងរបស់គាត់.
12:4 ប៉ុន្តែនៅពេលដែលអ្នកដំណើរម្នាក់បានមកដល់បុរសអ្នកមាន, ធ្វេសប្រហែសយកចៀមនិងគោរបស់គាត់ផ្ទាល់, គាត់អាចរៀបចំពិធីជប់លៀងជូនអ្នកធ្វើដំណើរ, ដែលបានមករកគាត់, គាត់បានយកចៀមរបស់បុរសក្រីក្រ, ហើយគាត់បានរៀបចំអាហារសម្រាប់បុរសដែលមករកគាត់»។
12:6 គាត់ត្រូវស្តារចៀមបួនជាបួន, ពីព្រោះគាត់បានធ្វើតាមពាក្យនេះ, ហើយគាត់ក៏មិនដែលអាណិតអាសូរដែរ” ។
នេះជាព្រះបន្ទូលរបស់ព្រះអម្ចាស់, ព្រះនៃអ៊ីស្រាអែល: យើងបានចាក់ប្រេងអភិសេកអ្នកអោយធ្វើជាស្តេចលើជនជាតិអ៊ីស្រាអែល, យើងបានរំដោះអ្នកអោយរួចពីកណ្តាប់ដៃរបស់សូល.
12:9 ដូច្នេះ, ហេតុអ្វីបានជាអ្នកមើលងាយព្រះបន្ទូលរបស់ព្រះអម្ចាស់?, ដូច្នេះអ្នកបានប្រព្រឹត្តអំពើអាក្រក់នៅចំពោះមុខយើង?
ហើយអ្នកបានយកប្រពន្ធរបស់គាត់ធ្វើជាប្រពន្ធសម្រាប់ខ្លួនអ្នក.
12:10 សម្រាប់ ហេតុផល នេះ, ដាវមិនត្រូវដកហូតចេញពីផ្ទះរបស់អ្នកឡើយ, សូម្បីតែរៀងរហូត, ព្រោះអ្នកបានមើលងាយខ្ញុំ, ហើយអ្នកបានយកប្រពន្ធរបស់លោកអ៊ូរីជាជនជាតិហេតមក, ដូច្នេះនាងអាចធ្វើជាប្រពន្ធរបស់អ្នក។ '
ហើយខ្ញុំនឹងនាំប្រពន្ធរបស់អ្នកទៅឆ្ងាយពីភ្នែករបស់អ្នក, ហើយខ្ញុំនឹងអោយពួកគេទៅអ្នកជិតខាងរបស់អ្នក.
12:13 លោកដាវីឌមានប្រសាសន៍ទៅលោកណាថាន, “ ខ្ញុំបានធ្វើបាបនឹងព្រះអម្ចាស់ហើយ” លោកណាថានទូលព្រះ បាទដាវីឌ: «ព្រះអម្ចាស់ក៏ដកអំពើបាបរបស់អ្នកចេញដែរ.
12:14 នៅឡើយទេ, ព្រោះអ្នកបានផ្តល់ឱកាសអោយខ្មាំងសត្រូវរបស់ព្រះអម្ចាស់ប្រមាថព្រះជាម្ចាស់, ដោយសារតែពាក្យនេះ, កូនប្រុសដែលកើតមកអ្នក: គាត់នឹងត្រូវស្លាប់” ។
ទំព័រ ដើម / ការសង្គ្រោះ / ការរស់ឡើងវិញ
ទំព័រ ដើម / ការអានប្រចាំថ្ងៃ / ចុះឈ្មោះសម្រាប់អ៊ីមែលប្រចាំថ្ងៃ
និងកូនប្រុសរបស់រ៉ាម៉ា: សេបានិងដាម៉ាន.
1:13 ពិត, ស្រុកកាណានមានផ្ទៃពោះស៊ីដូន, កូនច្បងរបស់គាត់, ក៏ដូចជាហ៊ីតធីត,
1:34 ឥឡូវនេះអ័ប្រាហាំមានផ្ទៃពោះអ៊ីសាក, កូនរបស់គាត់ឈ្មោះអេសាវនិងអ៊ីស្រាអែល.
កូន ៗ របស់ហ្សីប៊ីន: អេយ៉ានិងអាណា.
កូនប្រុសរបស់ឌីស្សាន: អ៊ូនិងអារ៉ាន.
1:48 បន្ទាប់មកសាលឡាក៏ទទួលមរណភាពដែរ, និងស៊ូលមកពីរេហូបូត, ដែលមានទីតាំងស្ថិតនៅក្បែរមាត់ទន្លេ, សោយរាជ្យជំនួសគាត់.
អ្នកទាំងបីនាក់នេះកើតមកគាត់មកពីកូនស្រីរបស់ Shua, ជនជាតិកាណាន.
2:7 កូនប្រុសរបស់កើមី: រក, ដែលបានធ្វើអោយសាសន៍អ៊ីស្រាអែលរំខាននិងធ្វើបាបដោយលួចរបស់ដែលមិនបរិសុទ្ធ.
2:12 ពិត, លោកបូអូសបង្កើតបានអូបេដ, គាត់ក៏មានគភ៌អ៊ីសាយដែរ.
2:16 បងប្អូនស្រីរបស់ពួកគេគឺសេរូយ៉ានិងអ័ប៊ីកែល.
2:17 ហើយអ័ប៊ីកែលមានផ្ទៃពោះអាម៉ាសា, ឪពុករបស់គាត់ឈ្មោះជេល, អ៊ីស្មាអែល.
2:21 ហើយក្រោយមកទៀត, ហេសរ៉ុនបានចូលកូនស្រីរបស់ម៉ាកៀរ, ឪពុករបស់កាឡាដ.
បន្ទាប់មកជេលីក៏ស្លាប់ដោយគ្មានកូនដែរ.
អ្នកទាំងនេះជាកូនរបស់លោកយេរ៉ាមែល.
2:39 អ័សារាមានគភ៌ហេសេសេ, និងហេលសេមានផ្ទៃពោះអេលសា.
2:41 សាលូមមានគភ៌យេសឃីម; បន្ទាប់មកលោកខាំគីមីមានគភ៌អេលីសាម៉ា.
2:50 អ្នកទាំងនេះជាកូនរបស់លោកកាលែប, កូនប្រុសរបស់ហ៊រ, កូនច្បងរបស់អេប្រាតា: ស៊ីល, ឪពុករបស់គីរីយ៉ាត - យារីម;
2:52 ឥឡូវមានកូនប្រុសសំរាប់ស៊ីល, ឪពុករបស់គីរីយ៉ាត - យារីម, ដែលបានឃើញកន្លែងសំរាកពាក់កណ្តាល.
ពីទាំងនេះ, ជនជាតិសូរ៉ាតនិងអេសតាថលក៏ចេញទៅ.
2:55 ព្រមទាំងក្រុមគ្រួសាររបស់ពួកអាចារ្យដែលរស់នៅក្រុងយ៉ាបេស, អ្នកដែលច្រៀងនិងបង្កើតតន្ត្រី, និងអ្នកដែលរស់នៅក្នុងតង់.
3:4 ដូច្នេះ, ប្រាំមួយនាក់បានកើតមកឱ្យគាត់នៅហេប្រុន, ជាកន្លែងដែលគាត់សោយរាជ្យបានប្រាំពីរឆ្នាំប្រាំមួយខែ.
3:5 ឥឡូវនៅក្នុងក្រុងយេរូសាឡិម, កូនប្រុសៗរបស់គាត់បានកើតមក: សាម៉ាម, និងសូបាប, និងណាថាន់, និងសាឡូម៉ូន, អ្នកទាំងបួនពីបាតសេបា, កូនស្រីរបស់អាំមេល;
3:9 អ្នកទាំងនេះសុទ្ធតែជាកូនចៅរបស់ដាវីឌ, ក្រៅពីកូនប្រុសរបស់ប្រពន្ធដើម.
3:10 កូនប្រុសរបស់ព្រះបាទសាឡូម៉ូនគឺរេហូបោម, លោកអប៊ីយ៉ាមានផ្ទៃពោះកូនប្រុសមួយ, ដូច្នេះ.
3:19 ពីពេដាយា, លោកសូរូបាបិលនិងលោកស៊ីម៉ីក្រោកឈរឡើង.
ហើយកូនប្រុសរបស់គាត់គឺអាណាន, លោកអូបា ឌាកើត, កូនប្រុសរបស់គាត់ឈ្មោះសេកានា.
4:4 ឥឡូវប៉េណួរជាឪពុករបស់ហ្គេឌរ, ហើយអេស៊ើរជាឪពុករបស់ហ៊ូសា.
អ្នកទាំងនេះជាកូនរបស់លោកណារ៉ា.
4:8 ឥឡូវកូហ្សបានបង្កើតអាណូប, និងហ្សូបាបា, និងពូជពង្សរបស់អហារ, កូនប្រុសរបស់ហាំម.
4:13 កូនរបស់លោកកេណាសគឺអូធ្នាលនិងសេរ៉ាយ៉ា.
4:14 មេម៉ូថុយមានផ្ទៃពោះអូផរ៉ា, ប៉ុន្តែសេរ៉ាយ៉ាមានគភ៌យ៉ូអាប់, ឪពុករបស់ជ្រលងភ្នំនៃសិប្បករ.
4:19 និងកូនប្រុសរបស់ប្រពន្ធរបស់គាត់ហូហូយ៉ា, បងស្រីរបស់ណាហាំ, ឪពុករបស់គាលីជាជនជាតិកាម៉ារី, និងរបស់ Eshtemoa, គាត់មកពីម៉ាកាធី.
និងកូនប្រុសរបស់អ៊ីស៊ី: ហ្សូហួតនិងប៊េនហ្សេត.
4:22 ហើយព្រះអង្គដែលធ្វើអោយព្រះអាទិត្យនៅស្ងៀម, និងបុរសនៃការនិយាយកុហក, និងសុវត្ថិភាព, និងការដុត, ពួកគេជាមេដឹកនាំនៅម៉ូអាប់, ហើយអ្នកណាបានវិលត្រឡប់ទៅលេម.
4:23 ទាំងនេះគឺជាអ្នកចិញ្ចឹមដែលរស់នៅក្នុងចម្ការនិងនៅតំបន់ហៃដិន, ជាមួយស្តេចនៅក្នុងការងាររបស់គាត់, ហើយពួកគេកំពុងរស់នៅទីនោះ.
4:27 កូនរបស់លោកស៊ីម៉ៃមានដប់ប្រាំមួយ, ហើយមានកូនស្រី ៦ នាក់.
4:38 ទាំងនេះគឺជាឈ្មោះរបស់មេដឹកនាំនៅក្នុងសាច់ញាតិរបស់ពួកគេ.
4:39 ហើយពួកគេបានកំណត់ចេញ, ដូច្នេះពួកគេអាចចូលទៅក្នុងហ្គេដor, ដូចជានៅលើជ្រលងភ្នំខាងកើត, និងដើម្បីឱ្យពួកគេស្វែងរកវាលស្មៅសម្រាប់ហ្វូងចៀមរបស់ពួកគេ.
4:41 អញ្ចឹងអញ្ចឹង, អ្នកដែលមានឈ្មោះត្រូវបានសរសេរខាងលើ, នៅជំនាន់ហេសេគា, ស្តេចស្រុកយូដា.
ហើយពួកគេបានលុបចោលពួកគេ, សូម្បីតែដល់ពេលបច្ចុប្បន្ននេះ.
4:42 ផងដែរ, កូនប្រុសខ្លះរបស់ស៊ីម្មាន, បុរសប្រាំរយនាក់, បានទៅនៅលើភ្នំសៀរ, គាត់មានមុខនាទីជាមេដឹកនាំភេលាលានិងជិតដល់ហើយរេបិលានិងអ៊ូសៀល, កូនប្រុសរបស់អ៊ីសៃ.
សម្រាប់ការពិត, គាត់ជាកូនច្បងរបស់គាត់, ប៉ុន្តែនៅពេលដែលគាត់បានរំលោភលើគ្រែរបស់ឪពុកគាត់, សិទ្ធិរបស់គាត់ជាកូនច្បងត្រូវបានប្រគល់អោយកូន ៗ របស់លោកយ៉ូសែប, កូនប្រុសរបស់អ៊ីស្រាអែល, ហើយគាត់មិនមានកេរ្តិ៍ឈ្មោះថាជាកូនច្បងទេ.
5:3 អញ្ចឹងអញ្ចឹង, កូនប្រុសរបស់រូបេន, កូនប្រុសច្បងរបស់អ៊ីស្រាអែល, គឺហុនឆនិងផលលូ, ហេសរ៉ុននិងខាមី.
5:7 ឥឡូវនេះបងប្អូននិងបងប្អូនរបស់គាត់, នៅពេលដែលពួកគេត្រូវបានគេរាប់ចំនួនតាមគ្រួសាររបស់ពួកគេ, មានមេដឹកនាំយេលៀនិងសាការី.
5:9 ហើយគាត់បានរស់នៅឆ្ពោះទៅតំបន់ភាគខាងកើត, ដូចជាផ្លូវចូលទៅកាន់ទីរហោស្ថាននិងទន្លេអឺប្រាត.
5:10 បន្ទាប់មក, នៅជំនាន់សូល, ពួកគេបានប្រយុទ្ធនឹងជនជាតិហាការហើយសម្លាប់ពួកគេ.
5:15 រួមជាមួយបងប្អូនរបស់ពួកគេ, កូនប្រុសរបស់ Abdiel, កូនប្រុសរបស់ហ្គីគី, មេដឹកនាំផ្ទះ, នៅក្នុងគ្រួសាររបស់ពួកគេ,
5:17 ទាំងអស់នេះត្រូវបានគេរាប់ចំនួននៅជំនាន់យ៉ូថាម, ស្តេចស្រុកយូដា, ហើយនៅជំនាន់យេរ៉ូបោម, ស្តេចអ៊ីស្រាអែល:
ដ្បិតពួកគេបានអំពាវនាវដល់ព្រះនៅពេលដែលពួកគេកំពុងប្រយុទ្ធ.
5:21 ហើយពួកគេបានរឹបអូសយកទ្រព្យសម្បត្តិទាំងអស់ដែលពួកគេមាន, នៃសត្វអូដ្ឋហាសិបពាន់, និងចៀមពីររយហាសិបពាន់, និងសត្វលាពីរពាន់, និងបុរសមួយរយពាន់នាក់រស់.
ដ្បិតវាជាសង្គ្រាមរបស់ព្រះអម្ចាស់.
5:24 ហើយទាំងនេះគឺជាមេដឹកនាំនៃក្រុមគ្រួសាររបស់ពួកគេ: អេភេ, និងអ៊ីស៊ី, និងអេលីល, និង Azriel, និងយេរេមា, និងហូដាវីយ៉ា, និង Jahdiel, បុរសខ្លាំងពូកែនិងខ្លាំងពូកែ, និងមេដឹកនាំដ៏ល្បីល្បាញនៅក្នុងគ្រួសាររបស់ពួកគេ.
6:4 អេឡាសារមានផ្ទៃពោះភីនេហាស, និងភីនេហាសមានផ្ទៃពោះអាប៊ីសួ.
6:6 អូសៀសមានផ្ទៃពោះសេរ៉ាយ៉ា, សេរ៉ា យ៉ាមានផ្ទៃពោះម៉្រា រ៉ូត.
6:10 យ៉ូហាណានមានផ្ទៃពោះអ័សារា.
6:11 ឥឡូវអ័សារាបានចាប់អាម៉ារីយ៉ា, អម៉ារីយ៉ាមានផ្ទៃពោះអ័ហ៊ីប៊ូត.
6:13 សាលូមមានផ្ទៃពោះហ៊ីលគីយ៉ា, ហើយហ៊ីលគីយ៉ាមានផ្ទៃពោះអ័សារា.
6:15 ឥឡូវយេហូសាដាកបានចាកចេញទៅ, ព្រះអម្ចាស់បានដកយកស្រុកយូដានិងក្រុងយេរូសាឡឹមចេញ, ដោយដៃនេប៊ូក្នេសា.
6:17 ហើយទាំងនេះជាឈ្មោះកូន ៗ របស់គើរសាំ: លីបនីនិងស៊ីមី.
6:31 អ្នកទាំងនេះជាអ្នកដែលព្រះបាទដាវីឌតែងតាំងអោយមានក្រុមចំរៀងដែលច្រៀងនៅក្នុងព្រះដំណាក់របស់ព្រះអម្ចាស់, នៅកន្លែងដែលទូកធំនោះមានទីតាំងនៅ.
ហើយពួកគេនឹងឈរតាមលំដាប់លំដោយក្នុងកិច្ចបំរើផ្សាយ.
6:48 ក៏មានបងប្អូនរបស់ពួកគេដែរ, ក្រុមលេវីដែលត្រូវតែងតាំងអោយបំពេញមុខងារបំរើព្រះពន្លានៃព្រះដំណាក់របស់ព្រះអម្ចាស់.
6:54 ហើយទាំងនេះគឺជាទំលាប់របស់ពួកគេយោងទៅតាមភូមិនិងកន្លែងរស់នៅ, ជាពិសេសគឺកូនប្រុសរបស់អើរ៉ុន, នេះបើយោងតាមពូជពង្សរបស់កូហៃ.
6:59 ព្រមទាំងអាសាននិងបេតសេម៉េសនៅជាយក្រុង.
ទីក្រុងទាំងអស់នៅទូទាំងគេមានចំនួនដប់បី.
6:62 និងកូនប្រុសរបស់ Gershom, នេះបើយោងតាមក្រុមគ្រួសាររបស់ពួកគេ, មកពីកុលសម្ព័ន្ធអ៊ីសាខារ, និងមកពីកុលសម្ព័ន្ធអេស៊ើរ, និងមកពីកុលសម្ព័ន្ធណាប៉ូធីលី, និងកុលសម្ព័ន្ធម៉ាណាសេនៅស្រុកបាសាន: ដប់បីទីក្រុង.
6:66 ហើយសំរាប់អ្នកដែលមកពីពូជពង្សរបស់កូនកេហាត់, ក្រុងនានាដែលមានព្រំប្រទល់ជាប់នឹងកុលសម្ព័ន្ធអេប្រាអ៊ីម.
6:70 អញ្ចឹងដែរ, ក្នុងចំណោមកុលសម្ព័ន្ធម៉ាណាសេចំនួនពាក់កណ្តាល: អានអាននិងជាយក្រុងរបស់វា, ស្រុកបាឡាមនិងតំបន់ជាយក្រុង; ជាពិសេសអ្នកទាំងនោះបានទៅរកអ្នកដែលនៅសេសសល់ពីអំបូររបស់កេហាត់.
6:72 មកពីកុលសម្ព័ន្ធអ៊ីសាខារ: កេដាសនិងតំបន់ជាយក្រុង, និងដាបេរ៉ាតជាយក្រុង,
6:76 លើសពីនេះទៅទៀត, មកពីកុលសម្ព័ន្ធណែបថាលី: កេដសនៅស្រុកកាលីឡេនិងតំបន់ជាយក្រុង, ហាំម៉ុនជាមួយនឹងតំបន់ជាយក្រុងរបស់វា, គីរីហិមនិងតំបន់ជាយក្រុង.
6:78 និង, ឆ្លងទន្លេយ័រដាន់ទល់មុខនឹងយេរីខូ, បែរមុខទៅខាងកើតទន្លេយ័រដាន់, ពីកុលសម្ព័ន្ធរូបេន: បេសេកនៅវាលរហោស្ថានជាមួយតំបន់ជាយក្រុង, Jahzah និងតំបន់ជាយក្រុង;
ហើយពួកគេមានប្រពន្ធនិងកូនជាច្រើន.
ហើយកូនប្រុសរបស់គាត់គឺអ៊ូឡាំនិងរ៉ាកែម.
ទាំងនេះជាកូន ៗ របស់កាឡាត, កូនប្រុសរបស់ម៉ាកៀរ, កូនប្រុសរបស់ម៉ាណាសេ.
7:22 ហើយដូច្នេះឪពុករបស់ពួកគេ, អេប្រាអ៊ីម, កាន់ទុក្ខអស់រយៈពេលជាច្រើនថ្ងៃ; និងបងប្អូនរបស់គាត់បានមកដល់, ដូច្នេះពួកគេនឹងលួងលោមគាត់.
ហើយគាត់បានដាក់ឈ្មោះគាត់ថាប៊្រីយ៉ា, ព្រោះគាត់បានក្រោកឡើងនៅគ្រាលំបាកសម្រាប់ផ្ទះរបស់គាត់.
7:28 ឥឡូវទ្រព្យសម្បត្តិនិងទំលាប់របស់ពួកគេគឺ: បេតអែលជាមួយកូនស្រី, និងឆ្ពោះទៅខាងកើត, ណារ៉ាម, និងឆ្ពោះទៅតំបន់ខាងលិច, Gezer និងកូនស្រីរបស់គាត់, ក៏ដូចជាស៊ីគែមជាមួយកូនស្រីរបស់នាងដែរ, ដូចជាអេយ៉ាជាមួយនឹងកូនស្រីរបស់គាត់;
នៅកន្លែងទាំងនេះ, កូន ៗ របស់លោកយ៉ូសែបរស់នៅ, កូនប្រុសរបស់អ៊ីស្រាអែល.
ហើយចំនួនអ្នកដែលមានអាយុសមស្របនឹងសង្គ្រាមមានចំនួនម្ភៃប្រាំបីពាន់នាក់.
8:7 និងណាម៉ាន, និងអ័ហ៊ីយ៉ា, និង Gera, ព្រះអង្គក៏ដកពួកគេចេញទៅ; ហើយនាងមានផ្ទៃពោះអ៊ូសានិងអ័ហ៊ីហ៊ូដ.
ទាំងនេះជាកូនប្រុសរបស់គាត់, មេដឹកនាំនៃគ្រួសាររបស់ពួកគេ.
8:28 អ្នកទាំងនោះជាបុព្វបុរសនិងជាមេដឹកនាំក្រុមគ្រួសារដែលរស់នៅក្នុងក្រុងយេរូសាឡឹម.
8:32 ហើយមីកឡូតមានផ្ទៃពោះស៊ីម៉ា.
8:34 កូនប្រុសរបស់យ៉ូណាថានគឺមេរីបាបា; និងមឺរីបាឡាមានផ្ទៃពោះមីកា.
8:38 ឥឡូវមានកូនប្រុស ៦ នាក់សំរាប់អាហ្សល, ឈ្មោះរបស់ពួកគេគឺអាសៀរីកាម, បូកូ, អ៊ីស្មាអែល, សេរ៉ាយា, អូបាឌា, និងហានណាន.
ហើយពួកគេមានកូនប្រុសនិងចៅជាច្រើន, សូម្បីតែមួយរយហាសិប.
គេយកប្រាក់ទាំងអស់មកទុកក្នុងសៀវភៅរបស់ស្តេចស្រុកអ៊ីស្រាអែលនិងស្តេចស្រុកយូដា.
9:2 អ្នកទីមួយដែលបានរស់នៅជាកម្មសិទ្ធិនិងក្នុងក្រុងរបស់គេគឺអ៊ីស្រាអែល, និងបូជាចារ្យ, និងពួកលេវី, និងអ្នកបម្រើព្រះវិហារបរិសុទ្ធ.
9:6 បន្ទាប់មកមកពីកូនចៅរបស់សេរ៉ា: ជូអែល, និងបងប្អូនរបស់ពួកគេ, ប្រាំមួយរយកៅសិប.
ទាំងអស់នេះគឺជាមេដឹកនាំនៃសាច់ញាតិរបស់ពួកគេ, នេះបើយោងតាមផ្ទះរបស់ឪពុកពួកគេ.
9:11 និងអាសស៊ាផងដែរ, កូនប្រុសរបស់ហ៊ីលគីយ៉ា, មស៊ូឡាមដែលជាកូនរបស់, កូនប្រុសរបស់លោកសាដុក, កូនប្រុសរបស់ម៉្រារ៉ារ័ត្ន, កូនប្រុសរបស់ Ahitub, សម្ដេចសង្ឃនៃវិហាររបស់ព្រះ;
9:13 និងបងប្អូនរបស់ពួកគេផងដែរ, មេដឹកនាំយោងទៅតាមក្រុមគ្រួសាររបស់ពួកគេ, មួយពាន់ប្រាំពីររយហុកសិប, បុរសមានបទពិសោធខ្លាំង, សំរាប់ការងារផ្សព្វផ្សាយនៅក្នុងព្រះដំណាក់របស់ព្រះជាម្ចាស់.
9:15 ហើយក៏ជាប្រាសាទបាកកាកាក់ជាងឈើផងដែរ; និង Galal; និងម៉ាធៀនា, កូនប្រុសរបស់មីកា, កូនប្រុសរបស់លោកហ្ស៊ីរី, កូនប្រុសរបស់អេសាភ;
9:19 ពិត, សាលូម, កូនប្រុសរបស់កូរ៉េ, កូនប្រុសរបស់អេបាសផា, កូនប្រុសរបស់កូរ៉ា, ជាមួយបងប្អូននិងផ្ទះឪពុកគាត់, កូរេទាំងនេះ, ពួកគេបានមើលការខុសត្រូវលើមុខងាររបស់ក្រសួងក្នុងការថែរក្សាបន្ទប់ទទួលភ្ញៀវ.
9:20 ឥឡូវភីនេហាស, កូនប្រុសរបស់អេឡាសារ, ជាមេដឹកនាំរបស់ពួកគេនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់.
9:22 ទាំង អស់ នេះ, ត្រូវបានជ្រើសរើសជាច្រកសម្រាប់ច្រកទ្វារ, បានពីររយដប់ពីរ.
9:23 ដូចជាមួយពួកគេដែរ, កូនប្រុសៗរបស់ពួកគេក៏ដូច្នោះដែរ, នៅមាត់ទ្វារចូលព្រះដំណាក់របស់ព្រះអម្ចាស់និងព្រះពន្លា, តាមវេនរបស់ពួកគេ.
9:25 ឥឡូវនេះបងប្អូនរបស់ពួកគេបានស្នាក់នៅក្នុងភូមិ, ហើយពួកគេបានទៅដល់ថ្ងៃឈប់សម្រាករបស់ពួកគេ, ពី ពេល មួយ ទៅ ពេល មួយ.
9:27 ហើយពួកគេបានស្ថិតនៅក្នុងនាឡិការបស់ពួកគេ, នៅសងខាងព្រះវិហារនៃព្រះអម្ចាស់, ដូច្នេះ, ពេលវេលាបានមកដល់, ពួកគេអាចបើកទ្វារនៅពេលព្រឹក.
សម្រាប់នាវាទាំងពីរត្រូវបានដឹកនិងអនុវត្តតាមចំនួន.
9:30 ឥឡូវនេះកូនប្រុសរបស់បូជាចារ្យបានផ្សំប្រេងក្រអូបពីគ្រឿងក្រអូប.
9:32 ឥឡូវមានកូនប្រុសខ្លះរបស់កូហេ, បងប្អូនរបស់ពួកគេ, បានលើសនំបុ័ងនៃវត្តមាននេះ, ដូច្នេះពួកគេនឹងរៀបចំវាជាថ្មីសម្រាប់ថ្ងៃឈប់សម្រាកនីមួយៗ.
9:34 ក្បាលរបស់ពួកលេវី, មេដឹកនាំយោងទៅតាមក្រុមគ្រួសាររបស់ពួកគេ, រស់នៅក្នុងក្រុងយេរូសាឡិម.
9:38 បន្ទាប់មកមីកឡូតមានផ្ទៃពោះស៊ីម៉ាម.
9:40 កូនប្រុសរបស់យ៉ូណាថានគឺមេរីបាបា.
10:1 ឥឡូវពួកភីលីស្ទីនកំពុងច្បាំងនឹងអ៊ីស្រាអែល, កងទ័ពអ៊ីស្រាអែលបាក់ទ័ពរត់នៅមុខពួកភីលីស្ទីន, ហើយពួកគេបានដួលនៅលើភ្នំគីលបោ.
10:3 ការប្រយុទ្ធក៏កាន់តែខ្លាំងឡើង ៗ ប្រឆាំងនឹងព្រះបាទសូល.
10:4 ព្រះបាទសូលមានរាជឱង្ការទៅកាន់អ្នកកាន់គ្រឿងសាស្ត្រាវុធរបស់ស្តេច: “ មិនស្គាល់ដាវរបស់អ្នកហើយសម្លាប់ខ្ញុំ.
ហើយ ដូច្នេះ, ព្រះបាទសូលកាន់ដាវរបស់ខ្លួន, ហើយគាត់បានធ្លាក់លើវា.
10:6 ដូច្នេះ, ព្រះបាទសូលបានសោយទិវង្គត, និងកូនប្រុសទាំងបីរបស់គាត់បានស្លាប់, ផ្ទះរបស់គាត់ក៏ដួលរលំទៅ, ជាមួយគ្នា.
ហើយចាប់តាំងពីសូលនិងកូនប្រុសរបស់គាត់បានស្លាប់, ពួកគេបានបោះបង់ចោលទីក្រុងរបស់ពួកគេហើយត្រូវខ្ចាត់ខ្ចាយ, ទីនេះ និង ទីនោះ.
10:8 បន្ទាប់មក, នៅថ្ងៃបន្ទាប់, នៅពេលដែលពួកភីលីស្ទីនដកហូតបានជយភ័ណ្ឌរបស់ខ្មាំង, ពួកគេបានរកឃើញព្រះបាទសូលនិងកូនប្រុសរបស់គាត់, និយាយកុហកនៅលើភ្នំគីលបោ.
10:10 ប៉ុន្តែពួកគេបានបំពាក់គ្រឿងសឹករបស់គាត់នៅក្នុងទីសក្ការៈរបស់ព្រះរបស់ពួកគេ, គេដាក់បញ្ចូលព្រះសិរសាលោកនៅក្នុងវិហាររបស់ព្រះដាកុន.
10:12 បុរសក្លាហានម្នាក់បានក្រោកឡើង, គេបានយកសាក សពរបស់ព្រះ បាទសូលនិងបុត្រាទាំងអស់.
ហើយពួកគេបានបញ្ចុះឆ្អឹងរបស់ពួកគេនៅក្រោមដើមឈើអុកដែលស្ថិតនៅក្នុងយ៉ាបេស.
10:13 ព្រះបាទសូលសោយទិវង្គតព្រោះតែកំហុសរបស់ខ្លួន, ព្រោះគាត់ក្បត់បទបញ្ជារបស់ព្រះអម្ចាស់ដែលព្រះអង្គបានណែនាំ, ហើយមិនបានរក្សាទុកវាទេ.
11:2 ផងដែរ, កាលពីម្សិលមិញនិងថ្ងៃមុន, នៅពេលព្រះបាទសូលនៅតែសោយរាជ្យ, អ្នកគឺជាអ្នកដែលបានដឹកនាំនិងនាំយកមកស្រុកអ៊ីស្រាអែល.
11:3 ដូច្នេះ, អស់អ្នកដែលកើតនៅស្រុកអ៊ីស្រាអែលឡើងទៅគាល់ព្រះរាជានៅក្រុងហេប្រូន.
គេបានចាក់ប្រេងអភិសេកស្តេចអោយគ្រប់គ្រងលើអ៊ីស្រាអែល, ស្របតាមព្រះបន្ទូលរបស់ព្រះអម្ចាស់, ដែលលោកមានប្រសាសន៍ដោយដៃលោកសាំយូអែល.
11:6 ហើយគាត់បាននិយាយ, អ្នកណាត្រូវវាយជនជាតិយេប៊ូសជាមុន, នឹងធ្វើជាអ្នកគ្រប់គ្រងនិងជាមេបញ្ជាការ។ ដូច្នេះយ៉ូអាប់, កូនរបស់សេរូយ៉ា, ឡើងដំបូង, ហើយគាត់ត្រូវបានតែងតាំងជាមេដឹកនាំ.
11:8 ហើយគាត់បានសង់ទីក្រុងនៅជុំវិញ, ពីមីណូសូម្បីតែនៅគ្រប់តំបន់.
11:9 ហើយដាវីឌបានបន្តជឿនលឿននិងកើនឡើង, ព្រះអម្ចាស់នៃពិភពទាំងមូលគង់នៅជាមួយ.
ឥឡូវវាលនៅតំបន់នោះពេញទៅដោយស្រូវ, ប៉ុន្តែប្រជាជនបានភៀសខ្លួនចេញពីមុខពួកភីលីស្ទីន.
ហើយនៅពេលដែលពួកគេបានវាយលុកពួកភីលីស្ទីន, ព្រះអម្ចាស់បានសង្គ្រោះយ៉ាងខ្លាំងដល់ប្រជារាស្ត្ររបស់ព្រះអង្គ.
11:16 ឥឡូវនេះដាវីឌស្ថិតនៅក្នុងបន្ទាយមួយ, កង ទ័ពភីលីស្ទីនមួយក្រុមស្ថិតនៅភូមិបេថ្លេហិម.
11:18 ដូច្នេះ, អ្នកទាំងបីនេះឆ្លងទៅកណ្តាលជំរំភីលីស្ទីន, គេដងទឹកពីអណ្ដូងនៅភូមិបេថ្លេហិម, ដែលនៅមាត់ទ្វារ.
ប៉ុន្តែគាត់មិនមានឆន្ទៈទេ; ហើយជំនួសវិញ, គាត់បានផ្តល់ជូនវាជាការរំដោះដល់ព្រះអម្ចាស់,
សម្រាប់គ្រោះថ្នាក់នៃជីវិតផ្ទាល់ខ្លួនរបស់ពួកគេ, គេយកទឹកមកអោយខ្ញុំ»។ ហើយសម្រាប់ហេតុផលនេះ, គាត់មិនចង់ផឹកទេ.
11:20 ផងដែរ, អាប៊ីសាយ, បងប្អូនរបស់យ៉ូអាប់, គឺជាមេដឹកនាំនៃអ្នកទាំងបី, ហើយគាត់បានដកលំពែងរបស់គាត់ប្រឆាំងនឹងបីរយ, ដែលត្រូវបានរងរបួស.
11:21 ហើយគាត់ល្បីល្បាញក្នុងចំណោមអ្នកទាំងបីនិងមេដឹកនាំរបស់ពួកគេ.
ហើយគាត់បានចុះមកហើយសំលាប់សត្វតោនៅកណ្តាលរណ្តៅ, ក្នុងពេលមានព្រិល.
ហើយគាត់បានសម្លាប់គាត់ដោយលំពែងផ្ទាល់របស់គាត់.
បន្ទាប់មកដាវីឌដាក់គាត់នៅក្បែរត្រចៀករបស់គាត់.
ហើយពួកគេជាអ្នកប្រយុទ្ធខ្លាំងនិងពូកែ,
ពីបងប្អូនរបស់សូល, ចេញពីបេនយ៉ាមីន:
12:8 អញ្ចឹងដែរ, ពីហ្គាដ, លោកដាវីឌចូលទៅគាល់ព្រះបាទដាវីឌ, ពេលគាត់ពួននៅវាលខ្សាច់, បុរសខ្លាំងណាស់, ដែលជាអ្នកប្រយុទ្ធដ៏ល្អបំផុត, កាន់ខែលនិងលំពែង; មុខរបស់ពួកគេគឺដូចមុខសិង្ហ, ហើយពួកគេលឿនដូចសត្វក្តាន់នៅលើភ្នំ.
12:15 ទាំងនេះគឺជាអ្នកដែលបានឆ្លងទន្លេយ័រដាន់ក្នុងខែដំបូង, នៅពេលដែលវាត្រូវបានទម្លាប់ធ្វើការកត់សំគាល់ដើម្បី overflow ធនាគាររបស់ខ្លួន.
12:16 បន្ទាប់មកមានអ្នកខ្លះមកពីបេនយ៉ាមីននិងពីស្រុកយូដាក៏បានទៅដល់បន្ទាយដែលស្តេចដាវីឌស្នាក់នៅ.
សន្តិភាព, សន្តិភាពដល់អ្នក, និងសន្តិភាពដល់អ្នកជួយរបស់អ្នក.
12:19 លើសពីនេះទៅទៀត, អ្នកខ្លះមកពីម៉ាណាសេបានឆ្លងទៅដាវីឌ, នៅពេលដែលគាត់ចេញដំណើរជាមួយពួកភីលីស្ទីនប្រឆាំងនឹងព្រះបាទសូល, ដូច្នេះគាត់អាចច្បាំងបាន.
សម្រាប់មេដឹកនាំភីលីស្ទីន, ទទួលយកការប្រឹក្សា, បញ្ជូនគាត់មកវិញ, និយាយ, “ គ្រោះថ្នាក់ដល់ក្បាលយើងផ្ទាល់, គាត់នឹងវិលត្រឡប់ទៅម្ចាស់របស់គាត់វិញ, សូល»។
12:21 ទាំងនេះបានផ្តល់ជំនួយដល់ដាវីឌប្រឆាំងនឹងចោរប្លន់.
12:22 បន្ទាប់មក, ផងដែរ, មានអ្នកខ្លះមកគាល់ព្រះបាទដាវីឌជារៀងរាល់ថ្ងៃ, ដើម្បីជួយគាត់, រហូតដល់ពួកគេក្លាយជាចំនួនដ៏ច្រើន, ដូចជាកងទ័ពរបស់ព្រះ.
12:24 កូនប្រុសៗរបស់យូដា, កាន់ខែលនិងលំពែង, ប្រាំមួយពាន់ប្រាំបីរយ, បំពាក់សម្រាប់ការប្រយុទ្ធ;
12:28 ហើយបន្ទាប់មកហ្សាដុក, យុវជនដែលមានគុណសម្បត្ដិប្លែកៗ, និងផ្ទះរបស់ឪពុកគាត់, មេដឹកនាំម្ភៃពីរ;
12:30 បន្ទាប់មកមកពីកូនចៅអេប្រាអ៊ីម, មានពីរម៉ឺនពីរពាន់ប្រាំបីរយ, បុរសខ្លាំងនិងរឹងមាំ, ល្បីល្បាញក្នុងចំណោមសមាជិកគ្រួសាររបស់ពួកគេ.
12:32 ផងដែរ, ពីកូនរបស់លោកអ៊ីសាខារ, មានបុរសដែលបានរៀន, ដែលបានដឹងរាល់ដង, ដើម្បីប្រមើលមើលនូវអ្វីដែលជនជាតិអ៊ីស្រាអែលត្រូវធ្វើ, មេដឹកនាំពីររយនាក់.
12:33 បន្ទាប់មក, ពីសាប់យូឡូន, មានអ្នកដែលចេញទៅច្បាំង, និងអ្នកដែលកំពុងឈរនៅក្នុងជួរសមរភូមិ, រៀបចំដោយអាវុធនៃសង្គ្រាម; ពួកហាសិបពាន់នាក់បានមកដល់ដើម្បីជួយ, ដោយគ្មានភាពជ្រាលជ្រៅនៃដួងចិត្ត.
12:35 ហើយបន្ទាប់មកមកពីដាន់, មានម្ភៃប្រាំបីពាន់ប្រាំមួយរយ, ត្រៀមខ្លួនសម្រាប់ការប្រយុទ្ធ.
12:37 បន្ទាប់មក, ឆ្លងកាត់ទន្លេយ័រដាន់, មាន, ពីកូនចៅរូបេន, និងមកពីកាដ, និងពីកុលសម្ព័ន្ធម៉ាណាសេចំនួនពាក់កណ្តាល, មួយរយម្ភៃពាន់, រៀបចំដោយអាវុធនៃសង្គ្រាម.
សម្រាប់បងប្អូនរបស់ពួកគេបានរៀបចំសម្រាប់ពួកគេ.
សម្រាប់ការពិត, នៅស្រុកអ៊ីស្រាអែលមានអំណរ.
13:1 បន្ទាប់មកដាវីឌបានប្រឹក្សាជាមួយក្រុមកុលសម្ព័ន្ធ, និងនាយទាហាន, និងមេដឹកនាំទាំងអស់.
13:4 ហើយហ្វូងមនុស្សទាំងមូលបានឆ្លើយតបថាគួរតែធ្វើ.
13:5 ដូច្នេះ, ដាវីឌបានប្រមូលជនជាតិអ៊ីស្រាអែលទាំងអស់, ចាប់ពីស៊ីហ័រស្រុកអេស៊ីបរហូតដល់ច្រកចូលហាម៉ាត់, ដើម្បីយកហិបរបស់ព្រះជាម្ចាស់ពីគារយ៉ាត់ - យារីម.
13:7 គេដាក់ហិបរបស់ព្រះជាម្ចាស់ដាក់លើរទេះថ្មីពីផ្ទះរបស់លោកអប៊ីណាដាប់.
13:8 ព្រះ បាទដាវីឌនិងប្រជា ជនអ៊ីស្រា អែលទាំងអស់នាំគ្នាលេងនៅចំពោះព្រះ ភ័ក្ត្រព្រះ ជាម្ចាស់, ជាមួយនឹងសមត្ថភាពទាំងអស់របស់ពួកគេ, ក្នុងចម្រៀង, និងជាមួយពិណ, និងទំនុកតម្កើង, និង timbrels, និងសៃសុល, និងត្រែ.
ហើយគាត់បានវាយគាត់ដោយសារតែគាត់បានប៉ះទូកធំ.
13:11 ព្រះ បាទដាវីឌព្រួយព្រះ ហឫទ័យយ៉ាងខ្លាំងព្រោះព្រះ អង្គបានចែកលោកអ៊ូសា.
13:14 ដូច្នេះ, ហិបរបស់ព្រះជាម្ចាស់ស្ថិតនៅក្នុងផ្ទះរបស់អូបេដ - ដុមអស់រយៈពេលបីខែ.
14:2 ព្រះ បាទដាវីឌជ្រាបថាព្រះ អម្ចាស់បានតែង តាំងលោក ឲ្យ ធ្វើជាស្ដេចលើជន ជាតិអ៊ីស្រា អែល, ហើយរាជ្យរបស់ព្រះអង្គបានឡើងគ្រងរាជ្យលើអ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់ព្រះអង្គ.
ហើយគាត់មានផ្ទៃពោះកូនប្រុសស្រី.
ប៉ុន្តែនៅពេលដែលដាវីឌបាន heard អំពីវា, គាត់ចេញទៅទទួលពួកគេ.
14:10 លោកដាវីឌទូលសួរព្រះ អម្ចាស់, និយាយ, ខ្ញុំនឹងឡើងទៅឯពួកភីលីស្ទីន, ហើយព្រះអង្គប្រគល់ពួកគេមកក្នុងកណ្តាប់ដៃរបស់ទូលបង្គំ?ព្រះអម្ចាស់មានព្រះបន្ទូលមកគាត់វិញ, “ ឡើង, យើងនឹងប្រគល់ពួកគេទៅក្នុងកណ្តាប់ដៃរបស់អ្នកហើយ។
14:12 ពួកគេបានទុកព្រះរបស់ពួកគេនៅកន្លែងនោះ, លោកដាវីឌបញ្ជាអោយគេដុតលោក.
14:15 ហើយនៅពេលដែលអ្នកលឺសំលេងលឺជិតដល់កំពូលភ្នំបាសាំ, ពេលនោះអ្នកនឹងចេញទៅច្បាំង.
14:16 ដូច្នេះ, ដាវីឌបានធ្វើដូចព្រះបានណែនាំគាត់.
14:17 គេក៏ស្គាល់ឈ្មោះដាវីឌនៅគ្រប់តំបន់ទាំងអស់.
និងបានសាងសង់កន្លែងសម្រាប់ហិបរបស់ព្រះ, ហើយគាត់បានដំឡើងតង់សម្រាប់វា.
15:3 លោកបានប្រមូលជនជាតិអ៊ីស្រាអែលទាំងអស់នៅក្រុងយេរូសាឡឹម, ដូច្នេះគេនឹងសែងហិបរបស់ព្រះជាម្ចាស់ចូលក្នុងទូក, ដែលគាត់បានរៀបចំសម្រាប់វា.
15:5 ពីកូន ៗ របស់កេហាត់, យូរីគឺជាមេដឹកនាំ, និងបងប្អូនរបស់គាត់មានមួយរយម្ភៃនាក់.
15:9 ពីកូន ៗ របស់ហេប្រុន: អេលីលគឺជាអ្នកដឹកនាំ, ប្អូនប្រុសរបស់គាត់មានប៉ែតសិប.
15:13 បើមិនដូច្នេះទេ, ដូចពីមុន, ពេលព្រះអម្ចាស់វាយយើងព្រោះតែអ្នកមិននៅទីនោះ, ដូច្នេះវាប្រហែលជាឥឡូវនេះ, ប្រសិនបើយើងធ្វើអ្វីដែលខុសច្បាប់” ។
15:15 ហើយកូនប្រុសរបស់លេវីបានយកហិបរបស់ព្រះ, ដូចលោកម៉ូសេបានណែនាំ, ស្របតាមព្រះបន្ទូលរបស់ព្រះអម្ចាស់, នៅលើស្មារបស់ពួកគេដោយបារ.
15:17 ពួកគេតែងតាំងពីក្រុមលេវី: ហេម៉ាន, កូនប្រុសរបស់យ៉ូអែល; និងពីបងប្អូនរបស់គាត់, អេសាភ, កូនប្រុសរបស់បេរេគា; និងពិតប្រាកដ, ពីបងប្អូនរបស់ពួកគេ, កូនប្រុសរបស់ម៉្រារី: អេថាន, កូនប្រុសរបស់ Kushaiah.
15:21 បន្ទាប់មកម៉ាធីធីយ៉ា, និងអេលីពលេលូ, មីកណេយ៉ានិងអូបេឌ - ដិម, លោកយេលែលនិងលោកអសារាបានច្រៀងចំរៀងជាមួយជ័យជំនះ, សម្រាប់រតីយាវហឺ.
សម្រាប់ការពិត, គាត់មានជំនាញណាស់.
15:25 ដូច្នេះ, ដាវីឌ, និងទាំងអស់ដែលធំជាងដោយកំណើតនៃជនជាតិអ៊ីស្រាអែល, និងសាលាក្តីនេះ, លោកបានទៅសែងហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់ពីដំណាក់របស់លោកអូបេដ - មេត្រីដោយអំណរ.
15:27 ព្រះបាទដាវីឌស្លៀកសម្លៀកបំពាក់ធ្វើពីក្រណាត់ទេសឯក, ដូចពួកលេវីទាំងអស់ដែលសែងហិបនោះដែរ, និងអ្នកចំរៀង, និង Chenaniah, អ្នកដឹកនាំទំនាយក្នុងចំណោមអ្នកចំរៀង.
15:28 ជនជាតិអ៊ីស្រាអែលទាំងអស់បាននាំគ្នាហែហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់ត្រឡប់វិញ, លឺសំលេងលឺស្នែង, និងត្រែ, និងសៃសុល, និងទំនុកតម្កើង, និងពិណ.
ពួកគេបានថ្វាយតង្វាយដុតទាំងមូលនិងតង្វាយសន្តិភាពនៅចំពោះព្រះ.
16:3 ហើយគាត់បានបែងចែកទៅមនុស្សគ្រប់គ្នា, ពីបុរសសូម្បីតែស្ត្រី, នំប៉័ងមួយដុំ, និងសាច់គោអាំងមួយដុំ, និងម្សៅស្រូវសាលីល្អចៀនជាមួយប្រេង.
16:5 អេសាភជាអ្នកដឹកនាំ, ហើយទីពីរគឺសាការី.
16:6 ពិត, បូជាចារ្យ, បេណាយ៉ានិងយ៉ាហាសៀល, ត្រូវផ្លុំត្រែជានិច្ចនៅមុខហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់.
សូមឱ្យដួងចិត្តរបស់អ្នកដែលស្វែងរកព្រះអម្ចាស់រីករាយ!
ស្វែងរកមុខគាត់ជានិច្ច.
16:15 ចងចាំជារៀងរហូតកិច្ចព្រមព្រៀងរបស់គាត់, ពាក្យដែលលោកបានណែនាំដល់មួយពាន់ជំនាន់,
16:17 ហើយគាត់បានតែងតាំងដូចគ្នាទៅនឹងយ៉ាកុបជាច្បាប់មួយ, ហើយដល់អ៊ីស្រាអែលជាកតិកាសញ្ញាដ៏នៅអស់កល្បជានិច្ច,
16:19 នៅពេល នោះ, ពួកគេមានចំនួនតិច, ពួកគេមានតិចតួចហើយជាអ្នកតាំងទីលំនៅនៅទីនោះ.
16:21 គាត់មិនអនុញ្ញាតឱ្យនរណាម្នាក់ចោទប្រកាន់ពួកគេដោយមិនពិតឡើយ.
16:24 ពណ៌នាពីសិរីរុងរឿងរបស់ព្រះអង្គនៅក្នុងចំណោមសាសន៍ដទៃ, អព្ភូតហេតុរបស់ព្រះអង្គក្នុងចំណោមប្រជាជាតិទាំងឡាយ.
ហើយគាត់គួរឱ្យខ្លាចណាស់, នៅពីលើព្រះទាំងអស់.
ប៉ុន្តែព្រះអម្ចាស់បានបង្កើតផ្ទៃមេឃ.
សម្រាប់គាត់បានបង្កើតពិភពលោកដែលមិនអាចផ្លាស់ប្តូរបាន.
សូមឱ្យវាលរីករាយ, ជាមួយអ្វីទាំងអស់ដែលមាននៅក្នុងពួកគេ.
ដ្បិតលោកបានមកដើម្បីវិនិច្ឆ័យពិភពលោក.
សម្រាប់មេត្តាករុណារបស់ទ្រង់គឺនៅអស់កល្បជានិច្ច.
ហើយប្រមូលយើងទាំងអស់គ្នា, ហើយសង្គ្រោះយើងពីប្រជាជាតិនានា, ដូច្នេះយើងខ្ញុំនឹងទទួលស្គាល់ព្រះនាមដ៏វិសុទ្ធរបស់ព្រះអង្គ, ហើយអាចមានអំណរនៅក្នុងបទចំរៀងរបស់អ្នក.
16:37 ហើយ ដូច្នេះ, នៅមុខហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់, គាត់បានចាកចេញពីអេសាភនិងបងប្អូនរបស់គាត់, ដូច្នេះពួកគេអាចបំពេញមុខងារនៅចំពោះមុខទូកធំជាបន្ដបន្ទាប់, ពេញមួយថ្ងៃ, ហើយនៅក្នុងវេនរបស់ពួកគេ.
16:40 ដូច្នេះពួកគេអាចថ្វាយតង្វាយដុតដល់ព្រះ អម្ចាស់នៅលើអាសនៈថ្វាយព្រះ អម្ចាស់ជារៀងរហូត, ពេលព្រឹកនិងពេលល្ងាច, យោងទៅតាមអ្វីៗទាំងអស់ដែលមានចែងទុកក្នុងក្រឹត្យវិន័យរបស់ព្រះអម្ចាស់, លោកបានប្រាប់ជនជាតិអ៊ីស្រាអែល.
16:42 ហេម៉ាននិងយ៉ាឌូថុនក៏ផ្លុំត្រែដែរ, ហើយពួកគេលេងនៅលើចង្វាក់ស្គរ, និងលើឧបករណ៍តន្រ្តីគ្រប់ប្រភេទ, ដើម្បីច្រៀងសរសើរដំកើងដល់ព្រះ.
16:43 ហើយប្រជាជនទាំងអស់បានត្រឡប់ទៅផ្ទះវិញ, និងដាវីឌផងដែរ, ដូច្នេះគាត់នឹងអោយពរដល់ផ្ទះរបស់គាត់ដែរ.
17:5 តាំងពីពេលដែលយើងនាំអ៊ីស្រាអែលចេញពីស្រុកនេះយើងមិននៅក្នុងផ្ទះទេ, រហូតមកដល់សព្វថ្ងៃនេះ.
17:7 ហើយ ដូច្នេះ, ឥឡូវនេះអ្នកត្រូវនិយាយប្រាប់ដាវីឌជាអ្នកបម្រើរបស់យើង: ព្រះអម្ចាស់នៃពិភពទាំងមូលមានព្រះបន្ទូលថា៖: ខ្ញុំបាននាំអ្នកនៅពេលអ្នកដើរតាមហ្វូងចៀមនៅវាលស្មៅ, ដូច្នេះអ្នកនឹងធ្វើជាមេដឹកនាំរបស់អ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់យើង.
យើងបានប្រហារខ្មាំងសត្រូវទាំងប៉ុន្មានរបស់អ្នកនៅចំពោះមុខអ្នក, យើងបានធ្វើអោយអ្នកមានកេរ្តិ៍ឈ្មោះល្បីល្បាញដូចអ្នកធំម្នាក់ដែលត្រូវគេប្រារព្ធនៅលើផែនដី.
17:10 តាំងពីថ្ងៃដែលយើងតែងតាំងចៅក្រមអោយអ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់យើង, ហើយយើងបានបន្ទាបសត្រូវរបស់អ្នកទាំងអស់.
17:11 ហើយនៅពេលដែលអ្នកនឹងបញ្ចប់ថ្ងៃរបស់អ្នក, ដូច្នេះអ្នកត្រូវទៅរកឪពុករបស់អ្នក, ខ្ញុំនឹងចិញ្ចឹមកូនចៅរបស់អ្នកបន្ទាប់ពីអ្នក, តើនរណាជាកូនរបស់អ្នក?.
ហើយខ្ញុំនឹងមិនដកសេចក្តីមេត្តាករុណាពីគាត់ឡើយ, ដូចខ្ញុំបានយកវាចេញពីអ្នកដែលនៅមុខអ្នក.
ហើយអ្នកបានធ្វើឱ្យខ្ញុំក្លាយជាទស្សនីយភាពខ្ពស់ជាងបុរសទាំងអស់, ឱព្រះអម្ចាស់ជាព្រះ.
17:19 គាត់គឺជាម្ចាស់, ព្រោះតែអ្នកបំរើរបស់ព្រះអង្គ, ស្របតាមបេះដូងផ្ទាល់ខ្លួនរបស់អ្នក, អ្នកបាននាំមកនូវភាពអស្ចារ្យទាំងអស់នេះ, ព្រះអង្គក៏ចង់អោយគេបានស្គាល់ការអស្ចារ្យទាំងអស់នេះដែរ.
17:22 ហើយព្រះអង្គបានតែងតាំងអ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់ព្រះអង្គអោយធ្វើជាប្រជារាស្ត្ររបស់ព្រះអង្គ, រហូតដល់អស់កល្បជានិច្ច.
17:23 ឥឡូវនេះ, គាត់គឺជាម្ចាស់, សូមអោយព្រះបន្ទូលដែលព្រះអង្គបានថ្លែងប្រាប់ទូលបង្គំជាអ្នកបំរើរបស់ព្រះអង្គ!, និងលើផ្ទះរបស់គាត់, ត្រូវបានបញ្ជាក់ជារៀងរហូត, និងធ្វើដូចដែលអ្នកបាននិយាយ.
17:25 សម្រាប់ អ្នក, ឱព្រះអម្ចាស់ជាព្រះនៃទូលបង្គំ!, ខ្ញុំបានប្រាប់អ្នកបំរើរបស់លោកអោយដឹងថាលោកនឹងសង់ផ្ទះមួយអោយលោក.
17:27 ហើយអ្នកបានចាប់ផ្តើមប្រទានពរដល់ផ្ទះរបស់អ្នកបំរើរបស់អ្នក, ដូច្នេះវាតែងតែនៅចំពោះអ្នកជានិច្ច.
18:3 នៅពេល នោះ, ដាវីឌក៏វាយដាវីឌហាដាដេស, ស្តេចស្រុកសូបា, នៅតំបន់ហាម៉ាត់, នៅពេលដែលគាត់ចេញទៅដូច្នេះគាត់អាចពង្រីកអំណាចរបស់គាត់រហូតដល់ទន្លេអឺប្រាត.
ហើយគាត់បង្ហាត់រទេះសេះទាំងអស់, លើកលែងតែរទេះសេះមួយរយបួនសេះ, ដែលគាត់បានបម្រុងទុកសម្រាប់ខ្លួនគាត់.
ហើយ ដូច្នេះ, បន្ទាប់មកដាវីឌវាយប្រហារពួកគេចំនួនពីរម៉ឺនពីរពាន់នាក់.
ហើយព្រះអម្ចាស់ជួយគាត់ក្នុងគ្រប់កិច្ចការទាំងអស់ដែលគាត់ចេញទៅ.
18:10 ព្រះ បាទដាវីឌបានចាត់បុត្ររបស់ព្រះ បាទហាដា រ៉ាម ឲ្យ ទៅគាល់ព្រះ បាទដាវីឌដើម្បីធ្វើ ឲ្យ ស្ដេចមានសន្តិ ភាព, ហើយដើម្បីឱ្យគាត់អបអរសាទរគាត់ដែលគាត់បានវាយប្រហារនិងកម្ចាត់ហាដាដេស.
18:11 លើសពីនេះទៅទៀត, គ្រឿងបរិក្ខារទាំងប៉ុន្មានដែលធ្វើពីមាសនិងប្រាក់ធ្វើពីលង្ហិនប្រគល់ជូនព្រះអម្ចាស់, ជាមួយនឹងប្រាក់និងមាសដែលគាត់បានយកពីប្រជាជាតិទាំងអស់, ជាច្រើនពីអ៊ីឌមេម៉ា, និងម៉ូអាប់, និងកូនប្រុសរបស់អាំម៉ូន, ដូចភីលីស្ទីននិងអាម៉ាលេក.
18:13 ហើយលោកបានដាក់ទីតាំងយោធភូមិនៅអេដុម, ដូច្នេះអ៊ីឌមេម៉ាណានឹងបម្រើដាវីឌ.
18:14 ដូច្នេះ, ព្រះបាទដាវីឌសោយរាជ្យលើជនជាតិអ៊ីស្រាអែលទាំងអស់, ព្រះ អង្គបានកាត់ទោសប្រជា ជនទាំងអស់.
18:17 ផងដែរ, បេនយ៉ា, កូនប្រុសរបស់យេហូយ៉ាដា, គឺនៅលើកងពលរបស់កូរេតធីតនិងភីលេត.
តើអ្នកមិនបានកត់សម្គាល់ថាអ្នកបំរើរបស់គាត់បានមករកអ្នកដើម្បីឱ្យពួកគេអាចរុករកបានទេ, និងស៊ើបអង្កេត, ហើយពិនិត្យមើលទឹកដីរបស់អ្នក?”
19:5 ហើយនៅពេលដែលពួកគេបានទៅ, លោកបានចាត់គេអោយទៅទូលព្រះបាទដាវីឌ, (ព្រោះពួកគេបានរងនូវភាពអាម៉ាស់យ៉ាងខ្លាំង,) គាត់បានចាត់អោយទៅជួបពួកគេ, ព្រះយេស៊ូបានបញ្ជាអោយគេស្នាក់នៅក្រុងយេរីខូររហូតទាល់តែពុកមាត់របស់គេធំឡើង, ហើយបន្ទាប់មកពួកគេគួរតែត្រឡប់មកវិញ.
19:7 ហើយពួកគេបានជួលរទេះចំនួន ៣ ម៉ឺនពីរពាន់គ្រឿង, និងស្ដេចនៃម៉ាកាជាមួយប្រជាជនរបស់គាត់.
ផងដែរ, កូនប្រុសរបស់អាំម៉ូន, ប្រមូលផ្តុំពីទីក្រុងរបស់ពួកគេ, បានទៅធ្វើសង្គ្រាម.
19:10 ដូច្នេះយ៉ូអាប់, ស្វែងយល់ពីសង្គ្រាមដែលនឹងត្រូវប្រឈមមុខនឹងគាត់និងនៅពីក្រោយខ្នងរបស់គាត់, ជ្រើសរើសបុរសខ្លាំងពូកែក្នុងចំណោមជនជាតិអ៊ីស្រាអែលទាំងអស់, ហើយគាត់បានចេញទៅប្រឆាំងនឹងជនជាតិស៊ីរី.
ពួកគេក៏ចេញទៅច្បាំងនឹងកូនរបស់អាំម៉ូន.
ប៉ុន្តែប្រសិនបើកូនប្រុសរបស់អាំម៉ូនឈ្នះអ្នក, ខ្ញុំនឹងធ្វើជាអ្នកការពារអ្នក.
ហើយគាត់បានដាក់ពួកគេឱ្យហោះហើរ.
ឥឡូវនេះលោកយ៉ូអាប់វិលត្រឡប់ទៅក្រុងយេរូសាឡឹមវិញ.
គាត់ក៏ស្ទុះទៅរកពួកគេ.
ហើយពួកគេបានប្រយុទ្ធប្រឆាំងនឹងគាត់.
ហើយប្រទេសស៊ីរីមិនមានឆន្ទៈផ្តល់ជំនួយដល់កូនប្រុសរបស់អាំម៉ូនទៀតទេ.
20:1 ឥឡូវនេះវាបានកើតឡើង, បន្ទាប់ពីមួយឆ្នាំ, នៅពេលដែលស្តេចចេញទៅធ្វើសង្គ្រាម, លោកយ៉ូអាប់ប្រមូលកងទ័ពដែលមានបទពិសោធន៍ច្រើន, ហើយគាត់បានបំផ្លាញទឹកដីរបស់កូនចៅអាំម៉ូន.
ពេលនោះលោកដាវីឌស្នាក់នៅក្រុងយេរូ សាឡឹមពេលលោកយ៉ូអាប់វាយយកក្រុងរ៉ាបាតហើយបំផ្លាញក្រុងនោះ.
ព្រះបាទដាវីឌប្រព្រឹត្តចំពោះក្រុងទាំងប៉ុន្មានរបស់កូនចៅអាំម៉ូន.
20:4 បន្ទាប់ពីរឿងទាំងនេះ, សង្គ្រាមបានចាប់ផ្ដើមនៅហ្គេស៊ើរប្រឆាំងនឹងពួកភីលីស្ទីន, ក្នុងនោះស៊ីបេប៊ីស្ហុបជាអ្នកស្រុកហ៊ូសាតបានវាយពីស៊ីបពីការប្រណាំងរបស់រេផែម, ហើយគាត់បានបន្ទាបខ្លួនពួកគេ.
20:6 អញ្ចឹងដែរ, សង្គ្រាមមួយទៀតបានកើតឡើងនៅ Gath, ដែលក្នុងនោះមានបុរសខ្ពស់ណាស់, មានប្រាំមួយខ្ទង់, នោះគឺ, ទាំងអស់រួមគ្នាម្ភៃបួន.
អ្នកទាំងនេះជាកូនរបស់រេផែមនៅក្រុងកាថ, ដែលធ្លាក់ក្នុងកណ្ដាប់ដៃរបស់ដាវីឌនិងអ្នកបំរើរបស់គាត់.
21:1 ឥឡូវនេះសាតាំងបានក្រោកឡើងប្រឆាំងនឹងអ៊ីស្រាអែល, ស្តេចបានញុះញង់ដាវីឌអោយធ្វើជាស្តេចអ៊ីស្រាអែល.
ហើយយកលេខមកខ្ញុំ, ដូច្នេះខ្ញុំអាចដឹង” ។
ប៉ុន្តែ, ព្រះករុណាជាអម្ចាស់, ពួកគេមិនមែនជាអ្នកបំរើរបស់អ្នកទាំងអស់ទេ?
21:4 ប៉ុន្តែពាក្យរបស់ស្តេចបានយកឈ្នះជំនួសវិញ.
បន្ទាប់មកលោកវិលត្រឡប់ទៅក្រុងយេរូសាឡឹមវិញ.
ជនជាតិអ៊ីស្រាអែលទាំងមូលត្រូវបានគេរកឃើញថាមានចំនួនមួយលានមួយសែននាក់ដែលអាចដាវបាន; តែមកពីស្រុកយូដា, នៅទីនោះមានទាហានបួនរយចិតសិបម៉ឺននាក់.
លោកយ៉ូអាប់ប្រតិបត្តិតាមបញ្ជារបស់ព្រះរាជាដោយពុំបានយល់ព្រម.
21:8 លោកដាវីឌទូលព្រះ ជាម្ចាស់: “ ខ្ញុំបានធ្វើបាបច្រើនណាស់ក្នុងការធ្វើបែបនេះ.
ដ្បិតខ្ញុំបានប្រព្រឹត្ដដោយមិនត្រឹមត្រូវ»។
ឥឡូវនេះ, សូមមើលអ្វីដែលខ្ញុំគួរតែឆ្លើយតបចំពោះព្រះអង្គដែលបានចាត់ខ្ញុំមក។
ប៉ុន្តែវាប្រសើរសម្រាប់ខ្ញុំដែលធ្លាក់ក្នុងកណ្តាប់ដៃរបស់ព្រះអម្ចាស់, ដ្បិតព្រះហឫទ័យមេត្ដាករុណារបស់ព្រះអង្គមានច្រើនណាស់, ជាជាងក្នុងកណ្តាប់ដៃរបស់មនុស្ស។
ហើយអ៊ីស្រាអែលបានធ្លាក់ពីលើជនជាតិអ៊ីស្រាអែលចំនួនប្រាំពីរម៉ឺននាក់.
ហើយខណៈពេលដែលគាត់កំពុងធ្វើកូដកម្ម, ព្រះអម្ចាស់ទតឃើញហើយអាណិតអាសូរក្រៃលែង.
ឥឡូវនេះសូមបញ្ឈប់ដៃរបស់អ្នកចុះ។ ទេវតារបស់ព្រះអម្ចាស់ឈរនៅក្បែរលានបោកបែនរបស់អ័រណានជាជនជាតិយេប៊ូស.
ហើយទាំងគាត់និងអ្នកធំ ៗ ដោយសារកំណើត, ស្លៀកពាក់ខោអាវ, ដួលលើដី.
ឱព្រះអម្ចាស់ជាព្រះនៃទូលបង្គំ!, ខ្ញុំសូមអង្វរអ្នកឱ្យដៃរបស់អ្នកប្រឆាំងនឹងខ្ញុំនិងប្រឆាំងនឹងផ្ទះរបស់ឪពុកខ្ញុំ.
21:18 ទេវតារបស់ព្រះអម្ចាស់ណែនាំលោកកាដអោយទូលព្រះបាទដាវីឌថាលោកត្រូវឡើងទៅលើអាសនៈថ្វាយព្រះអម្ចាស់ជាព្រះនៅលើលានបោកបែនរបស់អាន់អានជនជាតិយេប៊ូស។.
21:20 ឥឡូវនេះនៅពេលអ័រណានបានក្រឡេកមើលទៅឃើញទេវតា, គាត់និងកូនប្រុសបួននាក់របស់គាត់បានលាក់ខ្លួន.
21:21 បន្ទាប់មក, ពេលដាវីឌចូលទៅជិតអ័រណាន, អ័រណានបានឃើញគាត់, លោកក៏ចេញពីលានបោកបែនទៅជួបលោក.
21:22 លោកដាវីឌមានប្រសាសន៍ទៅគាត់: សូមប្រគល់កន្លែងជាន់ជាន់របស់អ្នកមកខ្ញុំ, ដូច្នេះខ្ញុំនឹងសង់អាសនៈមួយថ្វាយព្រះអម្ចាស់នៅលើអាសនៈនោះ.
ជំនួស, ខ្ញុំនឹងអោយលុយអ្នក, ជាច្រើនដូចជាវាមានតម្លៃ.
ហើយគាត់បានថ្វាយតង្វាយដុតនិងតង្វាយសន្តិភាព, គាត់ស្រែកអង្វរព្រះអម្ចាស់.
21:27 ហើយព្រះអម្ចាស់បានណែនាំទេវតា, ព្រះ អង្គក៏ប្រគល់ដាវរបស់លោកទៅក្នុងស្រោមវិញ.
21:29 ប៉ុន្តែត្រសាលរបស់ព្រះអម្ចាស់, ដែលលោកម៉ូសេបានធ្វើនៅវាលរហោស្ថាន, និងអាសនៈសក្ការៈ, នៅពេលនោះស្ថិតនៅលើទីខ្ពស់នៃគីបៀន.
ព្រោះគាត់ត្រូវគេធ្វើបាបយ៉ាងខ្លាំង, ឃើញដាវរបស់ទេវតារបស់ព្រះអម្ចាស់.
22:1 លោកដាវីឌមានប្រសាសន៍, នេះជាដំណាក់របស់ព្រះ, នេះជាអាសនៈសំរាប់ធ្វើយញ្ញបូជាអោយអ៊ីស្រាអែល។
ហើយគាត់បានតែងតាំងជាជាងចម្លាក់ថ្ម, វាយថ្មនិងដុសខាត់ពួកគេ, គាត់នឹងសង់ព្រះ ដំណាក់របស់ព្រះ ជាម្ចាស់.
22:4 ផងដែរ, ដើមតាត្រៅ, ដែលជនជាតិស៊ីដូននិងជនជាតិទីរ៉ុសបានដឹកទៅអោយដាវីឌ, មិនអាចរាប់បានទេ.
ប៉ុន្តែគេហដ្ឋានដែលខ្ញុំចង់សង់ថ្វាយព្រះអម្ចាស់គួរតែមានទំហំធំណាស់គួរអោយស្ញប់ស្ញែងនៅគ្រប់តំបន់ទាំងអស់.
អ្នកមិនអាចសង់ផ្ទះតាមឈ្មោះខ្ញុំទេ, ការបង្ហូរឈាមនៅមុខខ្ញុំពិតជាអស្ចារ្យណាស់.
យើងនឹងធ្វើ ឲ្យ គាត់សម្រាកពីខ្មាំងសត្រូវទាំងប៉ុន្មាននៅគ្រប់ទិសទី.
ក្នុងមួយជីវិតរបស់គាត់ខ្ញុំនឹងផ្ដល់សន្តិភាពនិងភាពសុខសាន្តដល់ប្រជាជនអ៊ីស្រាអែល.
22:11 ឥឡូវនេះ, កូនប្រុស របស់ខ្ញុំ, សូមព្រះអម្ចាស់គង់ជាមួយអ្នក, សូមអោយអ្នកបានចំរើននិងសង់ផ្ទះថ្វាយព្រះអម្ចាស់ជាព្រះរបស់អ្នក, ដូចគាត់បាននិយាយអំពីអ្នក.
22:13 សម្រាប់ពេលនោះអ្នកនឹងអាចឈានទៅមុខ, ប្រសិនបើអ្នកកាន់តាមបទបញ្ជានិងវិន័យដែលព្រះអម្ចាស់បង្គាប់អោយលោកម៉ូសេបង្រៀនជនជាតិអ៊ីស្រាអែល.
អ្នកមិនគួរភ័យខ្លាចទេ, ហើយអ្នកមិនគួរខ្លាចឡើយ.
ហើយខ្ញុំបានរៀបចំឈើនិងថ្មសម្រាប់គម្រោងទាំងមូល.
22:18 និយាយ: អ្នកត្រូវយល់ថាព្រះអម្ចាស់ជាព្រះរបស់អ្នកស្ថិតនៅជាមួយអ្នក, ហើយព្រះអង្គបានអោយអ្នកសំរាកនៅគ្រប់តំបន់, ហើយព្រះអង្គបានប្រគល់ខ្មាំងសត្រូវទាំងអស់របស់អ្នកមកក្នុងកណ្តាប់ដៃអ្នកហើយ, ហើយទឹកដីនោះត្រូវបានចុះក្រោមនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់និងនៅមុខប្រជារាស្ត្ររបស់ព្រះអង្គ.
ហើយក្រោកឡើងហើយសង់ទីសក្ការៈថ្វាយព្រះអម្ចាស់ជាព្រះ, ដូច្នេះហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់, គ្រឿងប្រដាប់ទាំងអស់ដែលត្រូវថ្វាយសំរាប់ព្រះអម្ចាស់, គេនឹងនាំចូលទៅក្នុងផ្ទះដែលសង់ថ្វាយព្រះនាមព្រះអម្ចាស់»។
23:1 បន្ទាប់មកដាវីឌ, ចាស់ហើយពេញមួយថ្ងៃ, បានតែងតាំងសាឡូម៉ូនជាបុត្រអោយធ្វើជាស្ដេចលើស្រុកអ៊ីស្រាអែល.
23:3 ក្រុមលេវីមានអាយុពីសាមសិបឆ្នាំឡើងទៅ.
23:4 ទាំងនេះ, មនុស្សពីរម៉ឺនបួនពាន់នាក់ត្រូវបានជ្រើសរើសនិងចែកចាយទៅក្នុងក្រសួងនៃព្រះដំណាក់របស់ព្រះអម្ចាស់.
23:5 លើសពីនេះទៅទៀត, បួនពាន់នាក់ជាអ្នកយកពត៌មាន.
ទាំងនេះគឺជាមេដឹកនាំក្រុមគ្រួសាររបស់ឡាឌិន.
អ្នកទាំងនេះជាកូនរបស់លោកស៊ីម៉ៃ, បួន.
ឥឡូវនេះអើរ៉ុនបានបែកបាក់គ្នាដូច្នេះគាត់អាចបម្រើក្នុងទីបរិសុទ្ធ, គាត់និងកូនប្រុសរបស់គាត់ជារៀងរហូត, លោកដុតគ្រឿងក្រអូបថ្វាយព្រះអម្ចាស់, នេះបើយោងតាមពិធីរបស់គាត់, និងដើម្បីគាត់អាចប្រទានពរដល់ឈ្មោះរបស់គាត់ជារៀងរហូត.
23:25 សម្រាប់ដាវីឌបាននិយាយ: "ព្រះជាម្ចាស់, ព្រះនៃអ៊ីស្រាអែល, ព្រះអង្គបានប្រទានអោយប្រជាជនរបស់ព្រះអង្គសំរាក, ហើយជាជំរកនៅក្នុងក្រុងយេរូសាឡិមរហូតដល់អស់កល្បជានិច្ច.
23:27 ផងដែរ, នេះបើយោងតាមវិន័យចុងក្រោយរបស់ដាវីឌ, កូនរបស់លេវីត្រូវរាប់តាមអាយុចាប់ពីម្ភៃឆ្នាំឡើងទៅ.
23:29 ប៉ុន្តែបូជាចារ្យត្រូវបរិភោគនំបុ័ងដែលមានវត្តមាន, និងការលះបង់ម្សៅស្រូវសាលីល្អ, នំឥតដំបែ, និងខ្ទះចៀន, និងអាំងនេះ, និងលើរាល់ទំងន់និងរង្វាស់.
23:31 ភាគច្រើននៃតង្វាយដុតរបស់ព្រះអម្ចាស់, ដូចនៅក្នុងថ្ងៃឈប់សម្រាកនិងខែថ្មីនិងឧឡារិកដទៃទៀត, យោងតាមចំនួននិងពិធីសម្រាប់បញ្ហានីមួយៗ, នៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់ជានិច្ច.
ដូច្នេះអេលាឡានិងអ៊ីថាម៉ាអនុវត្តមុខងារបូជាចារ្យ.
24:4 ហើយគេក៏បានរកឃើញកូន ៗ របស់អេឡាសារជាច្រើនទៀតក្នុងចំណោមបុរសដែលនាំមុខ, ជាងកូនប្រុសរបស់លោកអ៊ីថាម៉ា.
24:7 ឥឡូវនេះឆ្នោតទីមួយបានទៅដល់យេហូយ៉ាព, ទីពីរទៅយ៉ាដាយ៉ា,
24:13 ទីដប់បីដល់ហ៊ូប៉ា, ទីដប់បួនដល់អ៊ីសាយបេប,
កូនរបស់លោកអ៊ីស្សាសគឺសាការី.
កូនប្រុសរបស់អូសៀសគឺបេណូ.
24:31 ហើយពួកគេក៏បានបោះឆ្នោតទាក់ទងនឹងបងប្អូនរបស់ពួកគេផងដែរ, កូនប្រុសៗរបស់លោកអើរ៉ុន, នៅចំពោះព្រះភ័ក្ត្រស្តេចដាវីឌ, និងហ្សាដុក, និង Ahimelech, និងមេដឹកនាំនៃក្រុមបូជាចារ្យនិងក្រុមលេវី, ទាក់ទងនឹងមនុស្សចាស់ដូចក្មេងជាង.
25:7 ឥឡូវចំនួនទាំងនេះ, ជាមួយបងប្អូនរបស់ពួកគេ, ពួកគេបានទទួលការអប់រំអំពីចំរៀងរបស់ព្រះអម្ចាស់, គ្រូទាំងអស់, មានពីររយប៉ែតសិបប្រាំបី.
25:9 ហើយឆ្នោតទី ១ បានទៅដល់យ៉ូសែប, ដែលជារបស់អេសាភ; កូនទីពីរចេញទៅបេឌាលា, ដល់គាត់និងកូនប្រុសនិងបងប្អូនរបស់គាត់, ដប់ពីរ.
25:21 ទីដប់បួនបានទៅម៉ាធីធី, ទៅកូនប្រុសនិងបងប្អូនរបស់គាត់, ដប់ពីរ.
25:23 ទីដប់ប្រាំមួយបានទៅហាណានា, ទៅកូនប្រុសនិងបងប្អូនរបស់គាត់, ដប់ពីរ.
25:29 ម្ភៃវិនាទីបានទៅហ្គីដដាលី, ទៅកូនប្រុសនិងបងប្អូនរបស់គាត់, ដប់ពីរ.
25:31 អ្នកទីម្ភៃបួនបានទៅរ៉ូម៉ាំង, ទៅកូនប្រុសនិងបងប្អូនរបស់គាត់, ដប់ពីរ.
26:6 ឥឡូវដល់កូនប្រុសរបស់គាត់គឺសេម៉ាយ៉ា, មានកូនប្រុសកើតមក, មេដឹកនាំនៃគ្រួសាររបស់ពួកគេ.
26:7 កូនរបស់លោកសេម៉ាយ៉ាគឺអូធទីនី, និងរេបិដ, និងអូបេដ, អេលសាបបាតនិងបងប្អូនរបស់គាត់, បុរសខ្លាំងណាស់, ក៏ដូចជាអេលីហ៊ូវនិងសេចគា.
26:9 បន្ទាប់មកមានកូនប្រុសរបស់មសេលេមៀនិងបងប្អូនរបស់ពួកគេ, បុរសខ្លាំងណាស់, ដប់ប្រាំបី.
26:12 ទាំងនេះត្រូវបានចែកចាយជាផតថល, ដូច្នេះមេដឹកនាំនៃប្រកាសនេះ, ក៏ដូចជាបងប្អូនរបស់ពួកគេ, ពួកគេតែងតែបំរើព្រះដំណាក់របស់ព្រះអម្ចាស់ជានិច្ច.
26:15 ពិត, អូបេដ ដូមនិងកូន ៗ របស់គាត់បានទទួលដីនៅខាងត្បូង, នៅក្នុងផ្នែកមួយនៃផ្ទះដែលជាកន្លែងដែលក្រុមប្រឹក្សាចាស់.
26:17 ពិត, នៅខាងកើតមានពួកលេវីប្រាំមួយនាក់, ហើយនៅទិសខាងជើងមានមនុស្សបួននាក់ក្នុងមួយថ្ងៃ, ហើយបន្ទាប់មកឆ្ពោះទៅខាងត្បូងខាងត្បូងមានបួនក្នុងមួយថ្ងៃ.
26:18 ផងដែរ, នៅក្នុងកោសិកានៃច្រកនេះឆ្ពោះទៅភាគខាងលិច, នៅទីនោះមានបួន, និងពីរនៅគ្រប់កោសិកា.
26:20 លោកអហ៊ីយ៉ាបានត្រួតលើឃ្លាំងនៃព្រះដំណាក់របស់ព្រះជាម្ចាស់, និងវត្ថុសក្ការៈ.
26:22 កូន ៗ របស់យេហ៊ីលា: ហ្សេតហាមនិងយ៉ូអែល; បងប្អូនប្រុសៗរបស់គាត់បានត្រួតលើរតនសម្បត្តិនៃព្រះដំណាក់របស់ព្រះអម្ចាស់,
26:26 សូលឡូមនិងបងប្អូនរបស់គាត់បានត្រួតលើរតនៈសម្បត្តិ, ដែលស្តេចដាវីឌបានរាប់ជាបរិសុទ្ធ, ជាមួយមេគ្រួសារ, និងសាលាក្តីនេះ, និងនាយទាហាន, និងមេបញ្ជាការកងទ័ព.
26:29 នៅឡើយទេ, លោក Chenaniah និងកូនប្រុសរបស់លោកបានគ្រប់គ្រងលើជនជាតិអ៊ីសសារ, សម្រាប់ការងារខាងក្រៅទាក់ទងនឹងអ៊ីស្រាអែល, ដើម្បីបង្រៀននិងវិនិច្ឆ័យពួកគេ.
26:31 មេដឹកនាំរបស់ក្រុមហេប្រូនិតគឺយេរីយ៉ា, នេះបើយោងតាមក្រុមគ្រួសារនិងប្រភេទរបស់ពួកគេ.
26:32 ហើយបងប្អូនរបស់គាត់ដែលមានវ័យចំណាស់ជាមេដឹកនាំក្រុមគ្រួសារពីរពាន់ប្រាំពីររយនាក់.
27:2 ចាសាបូបាំ, កូនរបស់លោកសេបេដេល, ទទួលបន្ទុកក្រុមហ៊ុនដំបូងក្នុងខែដំបូង; ហើយនៅក្រោមគាត់មានម្ភៃបួនពាន់នាក់.
27:4 ក្រុមហ៊ុនខែទី ២ មានឌុយ, Ahohite; ហើយបន្ទាប់ពីគាត់មានមួយទៀត, ឈ្មោះមីលធូត, ដែលគ្រប់គ្រងលើមួយចំណែកនៃកងទ័ពពីរម៉ឺនបួនពាន់នាក់.
27:6 គឺលោកបេណាយ៉ាដែលខ្លាំងជាងគេក្នុងចំណោមពួកសាមសិបនាក់, ហើយគឺនៅខាងលើសាមសិប.
27:7 ទីបួន, សម្រាប់ខែទីបួន, គឺអេសាហេ, បងប្អូនរបស់យ៉ូអាប់, បន្ទាប់មកមានលោកសេបេ គាជាកូនរបស់លោក; ហើយនៅក្នុងក្រុមហ៊ុនរបស់គាត់មានម្ភៃបួនពាន់នាក់.
27:9 ទី ៦, សម្រាប់ខែទីប្រាំមួយ, គឺអ៊ីរ៉ា, កូនប្រុសរបស់លោកអាយកឃីស, Tekoite មួយ; ហើយនៅក្នុងក្រុមហ៊ុនរបស់គាត់មានម្ភៃបួនពាន់នាក់.
27:13 ភាគដប់, សម្រាប់ខែទីដប់, គឺម៉ាហារ៉ា, ហើយគាត់ជាណេតផាតពីស្តុករបស់ពួកសេរ៉ាស; ហើយនៅក្នុងក្រុមហ៊ុនរបស់គាត់មានម្ភៃបួនពាន់នាក់.
27:21 និងកុលសម្ព័ន្ធម៉ាណាសេចំនួនពាក់កណ្តាលនៅស្រុកកាឡាដ, ដល់គាត់, ជាកូនរបស់លោកសាការី; បន្ទាប់មកលើបេនយ៉ាមីន, Jaasiel, កូនប្រុសរបស់លោកអប៊ីនើរ;
អ្នកទាំងនោះជាមេដឹកនាំរបស់កូនចៅអ៊ីស្រាអែល.
ដ្បិតព្រះអម្ចាស់មានព្រះបន្ទូលថាព្រះអង្គនឹងធ្វើអោយជនជាតិអ៊ីស្រាអែលកើនចំនួនច្រើនដូចផ្កាយនៅលើមេឃ.
សម្រាប់ដោយសារតែនេះ, កំហឹងបានធ្លាក់លើជនជាតិអ៊ីស្រាអែល.
27:28 ឥឡូវនេះនៅលើដើមអូលីវនិងដើមល្វា, ដែលស្ថិតនៅតំបន់ទំនាប, គឺព្រះបាលហាហាន, Gederite; ហើយនៅពីលើកន្លែងស្តុកប្រេងគឺយ៉ូអាស.
ទាំងអស់នេះជាមេដឹកនាំលើទ្រព្យសម្បត្ដិរបស់ស្តេចដាវីឌ.
ប៉ុន្តែមេដឹកនាំកងទ័ពរបស់ស្តេចគឺយ៉ូអាប់.
28:1 លោកដាវីឌក៏ប្រមូលមេដឹកនាំអ៊ីស្រាអែលទាំងអស់អោយមកជួបជុំគ្នា, អ្នកគ្រប់គ្រងកុលសម្ព័ន្ធ, និងអ្នកទទួលបន្ទុកក្រុមហ៊ុន, ដែលកំពុងបម្រើព្រះរាជា, ហើយក៏មានវណ្ណៈនិងមេបញ្ជាការ, និងអ្នកទទួលខុសត្រូវលើទ្រព្យសម្បត្តិនិងទ្រព្យសម្បត្តិរបស់ស្តេច, និងកូនប្រុសរបស់គាត់, ជាមួយនឹងអាមាដនិងអ្នកមានអំណាចនិងអ្នកដែលមានបទពិសោធន៍បំផុតនៅក្នុងកងទ័ព, នៅឯក្រុងយេរូសាឡិម.
ខ្ញុំគិតថាខ្ញុំនឹងសង់ផ្ទះមួយ, ក្នុងហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់, គ្រឹះនៃព្រះរបស់យើង, អាចសម្រាក.
ដ្បិតគាត់ជ្រើសរើសមេដឹកនាំ; លោកបានជ្រើសរើសពូជពង្សរបស់ឪពុកខ្ញុំ; ហើយមកពីកូន ៗ ឪពុកខ្ញុំ, គាត់ពេញចិត្ដនឹងគាត់អោយតែងតាំងខ្ញុំអោយធ្វើជាស្ដេចលើជនជាតិអ៊ីស្រាអែលទាំងមូល.
28:7 យើងនឹងពង្រឹងរាជ្យរបស់គេអោយរឹងមាំ, រហូតដល់អស់កល្បជានិច្ច, ប្រសិនបើគាត់នឹងតស៊ូក្នុងការអនុវត្តច្បាប់និងការវិនិច្ឆ័យរបស់ខ្ញុំ, ដូចថ្ងៃនេះដែរ។ '
28:9 ហើយសម្រាប់អ្នក, កូនប្រុសរបស់ខ្ញុំឈ្មោះសាឡូម៉ូន, ស្គាល់ព្រះរបស់ឪពុកអ្នក, ហើយបម្រើលោកដោយអស់ពីចិត្តនិងដោយស្ម័គ្រពីចិត្ត.
ប្រសិនបើអ្នកស្វែងរកគាត់, អ្នកនឹងរកឃើញគាត់.
28:10 ឥឡូវនេះ, ដ្បិតព្រះអម្ចាស់បានជ្រើសរើសអ្នក, អ្នកនឹងសង់ដំណាក់របស់ព្រះ វិហារនេះ, ត្រូវបានពង្រឹងហើយសំរេចវា។
28:12 ហើយតុលាការទាំងអស់ដែលគាត់បានគ្រោងទុក, និងបន្ទប់ខាងក្រៅនៅសងខាង, ទ្រព្យសម្បត្ដិក្នុងព្រះដំណាក់របស់ព្រះអម្ចាស់, និងសម្រាប់រតនៈនៃវត្ថុបរិសុទ្ធ,
28:14 គេយកមាសសុទ្ធមកថ្លឹងសំរាប់នាវាទាំងអស់របស់ក្រសួង, និងប្រាក់ផងដែរដោយទម្ងន់សម្រាប់ភាពខុសគ្នានៃនាវានិងឧបករណ៍.
ស្រដៀងគ្នានេះដែរ, លោកបានចែកប្រាក់ជាទម្ងន់ដោយដាក់ជើងចង្កៀងធ្វើពីប្រាក់, នេះបើយោងតាមភាពចម្រុះនៃវិធានការរបស់ពួកគេ.
28:17 ផងដែរ, គាត់បានចែកមាសសុទ្ធសម្រាប់ឆ្នួតតូចនិងចានគោម, ក៏ដូចជាតោមាសតូចៗដែរ, ដោយអនុលោមតាមវិធានការច្បាស់លាស់នៃទម្ងន់, សម្រាប់សត្វតោបន្ទាប់ពីតោ.
អ្នកមិនគួរខ្លាចទេ, ហើយអ្នកមិនគួរស្រងាកចិត្តទេ.
28:21 មើល, ការបែងចែករបស់បូជាចារ្យនិងក្រុមលេវី, រាល់កិច្ចបំរើព្រះដំណាក់របស់ព្រះអម្ចាស់, កំពុងឈរនៅមុខអ្នក.
ហើយការងារនៅតែអស្ចារ្យ, សម្រាប់កន្លែងស្នាក់នៅកំពុងត្រូវបានរៀបចំ, មិនមែនសម្រាប់មនុស្សទេ, ប៉ុន្តែសម្រាប់ព្រះ.
29:3 បន្ថែមពីនេះទៀតខ្ញុំបានយកទៅថ្វាយក្នុងដំណាក់របស់ព្រះរបស់ខ្ញុំ, ខ្ញុំ អោយ, ពីរបស់របរផ្ទាល់ខ្លួនរបស់ខ្ញុំ, មាសប្រាក់សំរាប់ព្រះវិហាររបស់ព្រះរបស់ខ្ញុំ, ក្រៅពីវត្ថុដែលខ្ញុំបានរៀបចំទុកសំរាប់ទីសក្ការៈដ៏វិសុទ្ធ:
29:5 និងមាសសម្រាប់កន្លែងណាដែលត្រូវការមាស, និងប្រាក់សម្រាប់កន្លែងណាដែលត្រូវការប្រាក់, សម្រាប់ស្នាដៃដែលត្រូវធ្វើដោយដៃសិប្បករ.
29:6 ដូច្នេះហើយអ្នកដឹកនាំក្រុមគ្រួសារ, ពួកអភិជននៃកុលសម្ព័ន្ធអ៊ីស្រាអែល, ព្រមទាំងសួយសារអាករនិងមេបញ្ជាការនិងអ្នកត្រួតត្រាលើទ្រព្យសម្បត្តិរបស់ស្តេច, បានសន្យា
29:8 អស់អ្នកដែលរកឃើញត្បូងមានតម្លៃនៅក្នុងទ្រព្យរបស់គេក៏ប្រគល់អោយឃ្លាំងនៃព្រះដំណាក់របស់ព្រះអម្ចាស់ដែរ, ដោយលោកយេហ៊ីអែលជាអ្នកស្រុកគើសុន.
ដ្បិតគេថ្វាយតង្វាយទាំងនេះដល់ព្រះអម្ចាស់យ៉ាងអស់ពីចិត្ដ.
29:10 គាត់ក៏អរព្រះគុណព្រះអម្ចាស់នៅមុខប្រជាជនទាំងមូល, ហើយគាត់បាននិយាយ: មានពរហើយ, ឱព្រះអម្ចាស់ជាព្រះនៃអ៊ីស្រាអែលអើយ, ព្រះវរបិតារបស់យើងដែលគង់នៅអស់កល្បជានិច្ច.
អ្វីៗទាំងអស់ដែលនៅស្ថានបរមសុខនិងនៅលើផែនដីគឺជាកម្មសិទ្ធិរបស់អ្នកហើយ.
នៅក្នុងដៃរបស់អ្នកគឺគុណធម៌និងអំណាច.
29:15 សម្រាប់យើងជាជនបរទេសនិងអ្នកទេសចរថ្មីៗនៅចំពោះមុខអ្នក, ដូចបុព្វបុរសរបស់យើងដែរ.
29:16 ឱព្រះអម្ចាស់ជាព្រះនៃយើង, ភាពបរិបូរណ៍ទាំងអស់នេះ, ដែលយើងខ្ញុំបានរៀបចំទុកដើម្បីសង់ផ្ទះមួយថ្វាយព្រះនាមដ៏វិសុទ្ធរបស់ព្រះអង្គ, គឺមកពីដៃរបស់អ្នក, អ្វីៗទាំងអស់ជារបស់អ្នកហើយ.
ដូច្នេះ, ក្នុងចិត្តខ្ញុំ, ខ្ញុំក៏បានជូនរបស់ទាំងអស់នេះដោយអំណរ.
29:20 បន្ទាប់មកដាវីឌបញ្ជាដល់អង្គប្រជុំទាំងមូល: “ សូមលើកតម្កើងព្រះអម្ចាស់ជាព្រះរបស់យើង” អង្គប្រជុំទាំងមូលបានលើកតម្កើងព្រះអម្ចាស់, ព្រះនៃបុព្វបុរសរបស់គេ.
29:22 នៅថ្ងៃនោះពួកគេបរិភោគនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់, ដោយអរសប្បាយ.
គេបានចាក់ប្រេងអភិសេកលោកអោយធ្វើជាព្រះអម្ចាស់, និងសាដុកជាមហាបូជាចារ្យ.
ប្រជាជនអ៊ីស្រាអែលទាំងមូលក៏នាំគ្នាស្តាប់បង្គាប់គាត់ដែរ.
29:25 ព្រះអម្ចាស់លើកតម្កើងព្រះបាទសាឡូម៉ូនអោយគ្រប់គ្រងលើជនជាតិអ៊ីស្រាអែលទាំងមូល.
ស្តេចសោយរាជ្យបានប្រាំពីរឆ្នាំនៅក្រុងហេប្រុន, និងសាមសិបបីឆ្នាំនៅក្រុងយេរូសាឡឹម.
ព្រះបាទសាឡូម៉ូនជាបុត្របានឡើងស្នងរាជ្យ.
29:30 ទាក់ទងនឹងរជ្ជកាលនិងកម្លាំងទាំងមូលរបស់ព្រះអង្គ, និងពេលវេលាដែលបានឆ្លងកាត់គាត់, ទាំងនៅអ៊ីស្រាអែលទាំងនៅនគរទាំងប៉ុន្មាននៃដែនដី.
ទំព័រ ដើម / ព្រះគម្ពីរ / ដំណឹងល្អម៉ាកុស
ហើយភាពស្ងប់ស្ងាត់ដ៏អស្ចារ្យបានកើតឡើង.
5:1 បន្ទាប់ពីរឿងទាំងនេះ, ថ្ងៃនោះជាថ្ងៃជប់លៀងរបស់ជនជាតិយូដា, ព្រះយេស៊ូក៏យាងឡើងទៅក្រុងយេរូសាឡឹម.
5:3 នៅក្បែរនោះមានមនុស្សជាច្រើនដែលឈឺ, មនុស្សខ្វាក់, មនុស្សខ្វិន, និងក្រៀមស្វិត, រង់ចាំចលនាទឹក.
5:6 បន្ទាប់មក, ពេលព្រះយេស៊ូទតឃើញគាត់អង្គុយ, ហើយនៅពេលដែលគាត់ដឹងថាគាត់បានរងទុក្ខជាយូរមកហើយ, ព្រះអង្គមានព្រះបន្ទូលទៅគាត់, “ តើអ្នកចង់បានជាសះស្បើយទេ? ?”
សម្រាប់ដូចជាខ្ញុំនឹង, មួយទៀតចុះមកពីមុខខ្ញុំ។
5:9 ភ្លាមនោះបុរសនោះបានជា.
ថ្ងៃនេះជាថ្ងៃឈប់សម្រាក.
5:16 ព្រោះតែ រឿង នេះ, ជនជាតិយូដាកំពុងបៀតបៀនព្រះយេស៊ូ, ព្រោះគាត់ធ្វើការទាំងនេះនៅថ្ងៃឈប់សម្រាក.
5:18 ហើយ ដូច្នេះ, ព្រោះតែ រឿង នេះ, ជនជាតិយូដាចង់សម្លាប់លោករឹតតែខ្លាំងថែមទៀត.
5:19 ព្រះយេស៊ូក៏មានព្រះបន្ទូលទៅគេថា៖: “ អាម៉ែន, អាម៉ែន, ខ្ញុំនិយាយទៅកាន់អ្នក, ព្រះរាជបុត្រាមិនអាចធ្វើអ្វីដោយខ្លួនឯងបានទេ, មានតែអ្វីដែលលោកបានឃើញព្រះ បិតាធ្វើប៉ុណ្ណោះ.
5:20 ព្រះបិតាមានព្រះហឫទ័យស្រឡាញ់ព្រះបុត្រា, ហើយគាត់បង្ហាញដល់គាត់នូវអ្វីដែលគាត់បានធ្វើ.
5:21 ដូចព្រះបិតាប្រោសមនុស្សស្លាប់អោយរស់ឡើងវិញហើយផ្ដល់ជីវិត, ព្រះបុត្រាក៏ប្រទានជីវិតអោយអស់អ្នកដែលព្រះអង្គសព្វព្រះហឫទ័យដែរ.
អ្នកណាមិនគោរពព្រះបុត្រា, មិនគោរពព្រះបិតាដែលបានចាត់ព្រះអង្គអោយមកទេ.
5:25 អាម៉ែន, អាម៉ែន, ខ្ញុំនិយាយទៅកាន់អ្នក, គឺដល់ពេលកំណត់ហើយ, ហើយឥឡូវនេះវាមកដល់ហើយ, ពេលមនុស្សស្លាប់នឹង hear ព្រះសូរសៀងរបស់ព្រះបុត្រារបស់ព្រះជាម្ចាស់; ហើយអស់អ្នកដែល it នឹងមានជីវិត.
5:27 ហើយគាត់បានផ្តល់ឱ្យគាត់នូវសិទ្ធិអំណាចដើម្បីធ្វើការវិនិច្ឆ័យ.
5:29 អស់អ្នកដែលបានប្រព្រឹត្ដអំពើល្អនឹងត្រូវទទួលជីវិតរស់ឡើងវិញ.
ហើយការវិនិច្ឆ័យរបស់ខ្ញុំគឺត្រឹមត្រូវ.
5:31 ប្រសិនបើខ្ញុំផ្តល់សក្ខីកម្មអំពីខ្លួនខ្ញុំ, ទីបន្ទាល់របស់ខ្ញុំមិនពិតទេ.
5:33 អ្នកបានផ្ញើទៅចន, ហើយគាត់បានផ្តល់សក្ខីភាពអំពីសេចក្តីពិត.
ជំនួស, ខ្ញុំនិយាយរឿងទាំងនេះ, ដូច្នេះអ្នកនឹងត្រូវបានសង្គ្រោះ.
ដូច្នេះអ្នកមានឆន្ទៈ, នៅពេល នោះ, អរសប្បាយនឹងពន្លឺរបស់គាត់.
សម្រាប់អ្នកដែលគាត់បានចាត់, អ្នកមិនជឿដូចគ្នាទេ.
សម្រាប់អ្នកគិតថានៅក្នុងពួកគេអ្នកមានជីវិតអស់កល្បជានិច្ច.
5:40 ហើយអ្នកមិនមានបំណងមករកខ្ញុំទេ, ដើម្បីអោយអ្នករាល់គ្នាមានជីវិត.
ប្រសិនបើមានម្នាក់ទៀតមកដល់ឈ្មោះរបស់គាត់, អ្នកនឹងទទួលយកគាត់.
5:45 កុំនឹកស្មានថាខ្ញុំអាចចោទប្រកាន់អ្នករាល់គ្នាពីព្រះវរបិតាបានឡើយ.
5:46 ប្រសិនបើអ្នកជឿលើលោកម៉ូសេ, អ្នកប្រហែលជាជឿលើខ្ញុំដែរ.
5:47 តែបើអ្នកមិនជឿតាមសំណេររបស់គាត់ទេ, តើអោយអ្នករាល់គ្នាជឿពាក្យខ្ញុំយ៉ាងដូចម្ដេចបាន? ?”
7:41 ខ្លះទៀតនិយាយ, “ គាត់គឺជាព្រះគ្រីស្ទ” តែមានអ្នកខ្លះនិយាយ: តើព្រះគ្រិស្ដយាងមកពីស្រុកកាលីឡេឬ? ?
7:45 ដូច្នេះ, អ្នកយាមព្រះវិហារបានទៅជួបពួកនាយកបូជាចារ្យនិងពួកខាងគណៈផារីស៊ី.
7:46 អ្នកចូលរួមបានឆ្លើយតប, “ មិនដែលមានបុរសណានិយាយដូចបុរសនេះឡើយ”
7:52 ពួកគេឆ្លើយតបទៅលោកវិញ: តើអ្នកជាអ្នកស្រុកកាលីឡេដែរ?
7:53 ហើយម្នាក់ៗបានវិលត្រឡប់ទៅផ្ទះរៀងៗខ្លួនវិញ.
3:1 ឥឡូវនេះលោកម៉ូសេកំពុងឃ្វាលចៀមរបស់ឪពុកក្មេករបស់លោកយេត្រូ, បូជាចារ្យរបស់ជនជាតិម៉ាឌាន.
3:2 ពេលនោះព្រះអម្ចាស់បានបង្ហាញខ្លួនអោយគាត់ឃើញក្នុងអណ្ដាតភ្លើងដែលឆេះចេញពីគុម្ពោត.
3:3 ដូច្នេះ, លោកម៉ូសេបាននិយាយ, ខ្ញុំនឹងទៅមើលការអស្ចារ្យនេះ, ហេតុអ្វីបានជាព្រៃមិនឆេះ” ។
3:5 ហើយគាត់បាននិយាយ: “ ក្រែងលោអ្នកគួរតែមកទីនេះ, ដោះស្បែកជើងចេញពីប្រអប់ជើងរបស់អ្នក.
12:1 នៅពេល នោះ, ព្រះយេស៊ូយាងកាត់វាលស្រែនៅថ្ងៃសប្ប័ទ.
12:2 បន្ទាប់មកពួកផារិស៊ី, ឃើញនេះ, បាននិយាយទៅគាត់, «មើលចុះ, នៅថ្ងៃសប្ប័ទរបស់អ្នករាល់គ្នាកំពុងធ្វើការដែលគ្មានច្បាប់ធ្វើទេ»។
12:4 របៀបដែលគាត់ចូលក្នុងព្រះដំណាក់របស់ព្រះជាម្ចាស់និងបរិភោគនំបុ័ងដែលមានវត្តមាន, ដែលគ្មានច្បាប់អោយគាត់បរិភោគ, និងសម្រាប់អ្នកដែលនៅជាមួយគាត់, ប៉ុន្តែសម្រាប់តែបូជាចារ្យ?
12:6 ប៉ុន្តែខ្ញុំនិយាយទៅកាន់អ្នក, មានអ្វីមួយធំជាងព្រះវិហារនៅទីនេះ.
ដូច្នេះ, ពួកគេនឹងធ្វើជាចៅក្រមរបស់អ្នក.
តើយើងគួរថ្វាយបង្គំតាមរបៀបណា??
1លិខិតរបស់ពេត្រុស
ហេតុអ្វីបានជាស្ត្រីមិនអាចធ្វើជាបូជាចារ្យបាន?
តើវិហាររបស់ខ្ញុំពិតជាសំខាន់ទេ?
គឺជាព្រះវិហារកាតូលិកប្រឆាំងនឹងវិទ្យាសាស្ត្រ?
បើព្រះល្អ, ហេតុអ្វីត្រូវមានទុក្ខ?
តើយើងត្រូវបានសង្គ្រោះយ៉ាងដូចម្តេច?
2លិខិតរបស់ពេត្រុស
- បន្ទាត់ពេលវេលានៃគ្រីស្ទសាសនា
- តើគ្រីស្ទបរិស័ទមានសន្តិសុខអស់កល្បជានិច្ច?
- លិខិតរបស់ប៉ូលទៅកាន់ពួករ៉ូម
- លិខិតរបស់លោកប៉ូលទៅកាន់ប្រជាជនហេព្រើរ
- អ្នកចូលរួមរបស់យើង
1:2 អាប្រាហាំមានផ្ទៃពោះអ៊ីសាក.
1:16 ហើយលោកយ៉ាកុបមានផ្ទៃពោះលោកយ៉ូសែប, ប្តីរបស់ម៉ារី, អ្នកដែលបានប្រសូតមកគឺព្រះយេស៊ូ, ដែលហៅថាគ្រិស្ដ.
1:18 ឥឡូវនេះការបង្កើតកូនចៅរបស់ព្រះគ្រីស្ទបានកើតឡើងតាមរបៀបនេះ.
1:19 បន្ទាប់មកយ៉ូសែប, ប្តីរបស់នាង, ចាប់តាំងពីគាត់គឺគ្រាន់តែនិងមិនមានឆន្ទៈក្នុងការប្រគល់នាង, ចូលចិត្តបញ្ជូននាងទៅដោយសម្ងាត់.
សម្រាប់អ្វីដែលត្រូវបានបង្កើតឡើងនៅក្នុងនាងគឺមកពីព្រះវិញ្ញាណបរិសុទ្ធ.
អ្នកនឹងដាក់ឈ្មោះកូននោះថា "យេស៊ូ".
4:44 ដ្បិតព្រះយេស៊ូផ្ទាល់បានផ្ដល់សក្ខីភាពថាព្យាការីមិនមានកិត្ដិយសនៅក្នុងប្រទេសរបស់ខ្លួនឡើយ.
ព្រោះពួកគេក៏បានទៅចូលរួមបុណ្យដែរ.
ហើយមានអ្នកគ្រប់គ្រងម្នាក់, កូនប្រុសរបស់គាត់ឈឺនៅក្រុងកាពើណិម.
សម្រាប់គាត់ត្រូវបានគេចាប់ផ្តើមស្លាប់.
4:52 ដូច្នេះ, គាត់សួរពួកគេថាតើគាត់បានធូរស្បើយពីម៉ោងណាហើយ.
4:53 ឪពុកដឹងថាគឺនៅម៉ោងដែលព្រះយេស៊ូមានព្រះបន្ទូលមកគាត់, "កូនប្រុសរបស់អ្នករស់" ។ ហើយទាំងគាត់និងក្រុមគ្រួសារទាំងមូលរបស់គាត់បានជឿ.
ជាក់ស្តែង, គម្ពីរខុសគ្នាដោយសារការបកប្រែ, ប៉ុន្តែមានភាពខុសគ្នាជាមូលដ្ឋាន, ផងដែរ, ហើយនោះទាក់ទងនឹងការផ្សំនៃព្រះគម្ពីរ, ជាពិសេសសៀវភៅដែលទទួលយកនៅក្នុងគម្ពីរសញ្ញាចាស់.
Canon ដែលផលិតដោយពួកអាចារ្យចិតសិបនាក់ទាំងនេះមានកិត្តិយសរបស់ពួកគេដែលត្រូវបានគេស្គាល់ថាជាគម្ពីរ Septuagint ចិតសិប, ពាក្យឡាតាំងសម្រាប់“ ចិតសិប” ។
តាមពិត, ការដកស្រង់សញ្ញាចាស់ភាគច្រើនលើសលប់ដែលមាននៅក្នុងគម្ពីរសញ្ញាចាស់គឺមកពីគម្ពីរយូប៊ីនជីនទីន.
កាណុងនេះត្រូវបានបង្កើតឡើងដោយក្រុមបព្វជិតមួយក្រុមនៅក្នុងភូមិ Jamnia ឆ្ពោះទៅចុងសតវត្សរ៍ទីមួយ A.D., ពីរទៅបីរយឆ្នាំក្រោយមកជាងហ្គិនធូជីន.
ជាក់លាក់, ពួកគេបានជំទាស់នឹងព្រះ អម្ចាស់ សៀវភៅម៉ាក្សបាបាទី ២ 12:45-46, ដែលបង្ហាញថាជនជាតិយូដាពីបុរាណបានអធិស្ឋានសម្រាប់មនុស្សស្លាប់.
គាត់បានមើលងាយចំពោះព្រះគម្ពីរ លិខិតរបស់ជេម, ឧទាហរណ៍, សំរាប់ការបង្រៀនវា“ មនុស្សត្រូវបានរាប់ជាសុចរិតដោយសារការប្រព្រឹត្ដហើយមិនដោយសារជំនឿតែមួយទេ” (2:24).
ព្រះវិហារកាតូលិកទទួលស្គាល់អំណាចរបស់ព្រះគម្ពីរបរិសុទ្ធ, ទោះបីជានាងមិនបានចាត់ទុកថាជារបស់ តែមួយគត់ សិទ្ធិអំណាច, ដូចលូសើរបានធ្វើ.
ព្រះគម្ពីរត្រូវបានការពារតាមរយៈយុគសម័យកណ្តាលដោយព្រះសង្ឃកាតូលិក, ដែលបានផលិតវាឡើងវិញដោយដៃមួយសំបុត្រក្នុងពេលតែមួយ.
អ្នកច្រើនតែលឺថាម៉ាទីនលូសើរគឺជាអ្នកទីមួយដែលបានរំដោះព្រះគម្ពីរចេញពីការយល់របស់សាសនាចក្រហើយអោយវាទៅមនុស្សដែលអត់ឃ្លានព្រះគម្ពីរ។, ប៉ុន្តែវាមិនសមហេតុសមផលទេ.
ព្រះវិញ្ញាណដឹកនាំម៉ាញ៉េស្យូមរបស់សាសនាចក្រនៅ ដេលមិនចេះ ការបកស្រាយបទគម្ពីរ, ដូចជាទ្រង់បានណែនាំអ្នកសរសេរដ៏ពិសិដ្ឋក្នុងការតែងនិពន្ធបទគម្ពីរនេះ.
ដូច្នេះ, អំណាចនៃព្រះមិនអាចត្រូវបានបំបែកចេញពីអំណាចនៃសាសនាចក្ររបស់ទ្រង់.
ទោះបីជាមនុស្សជាច្រើនអះអាងថាធ្វើតាមសិទ្ធិអំណាចនៃព្រះគម្ពីរក៏ដោយ, ការពិតនៃបញ្ហាគឺ, ចំពោះអ្វីដែលព្រះគម្ពីរបានចែងអាស្រ័យលើការបកស្រាយផ្ទាល់ខ្លួនរបស់បុគ្គលម្នាក់ៗ.
ពេត្រុសក៏បាននិយាយដែរ, យោងទៅតាមសំបុត្ររបស់ប៉ូល, ថា“ មានរឿងខ្លះនៅក្នុងពួកគេដែលពិបាកយល់, ដែលជាមនុស្សល្ងង់ខ្លៅនិងមិនស្ថិតស្ថេរដើម្បីបំប្លែងខ្លួនគេ, ដូចជាពួកគេធ្វើបទគម្ពីរផ្សេងទៀត.
សម្រាប់ហេតុផលនោះ, អ្នកកាន់សាសនាកាតូលិកដឹងគុណអស់រយៈពេលជិត ២០០០ ឆ្នាំ, ប្រពៃណីនៃការបកស្រាយនិងការយល់ដឹង.
និងពួកសិស្សរបស់គាត់, និងហ្វូងមនុស្សច្រើនក្រៃលែង, ទៅជាមួយគាត់.
មានបណ្ដាជនជាច្រើនមកពីក្រុងនៅជាមួយនាង.
ហើយពួកគេបានលើកដំកើងព្រះ, និយាយ: «ដ្បិតហោរាដ៏ឆ្នើមម្នាក់បានរស់ឡើងវិញនៅក្នុងពួកយើង,” និង, «ត្បិតព្រះបានមកលេងប្រជារាស្ដ្ររបស់ទ្រង់»។
4:2 ពួកសិស្សព្រួយចិត្ដក្រៃលែងព្រោះគេបង្រៀនប្រជាជនព្រមទាំងប្រកាសអំពីព្រះយេស៊ូរស់ឡើងវិញ.
ហើយចំនួនបុរសបានក្លាយជាប្រាំពាន់នាក់.
4:6 រួមទាំងអាណា, សម្ដេចសង្ឃ, និងកៃផា, និងចននិងអាឡិចសាន់ឌឺ, រីឯក្រុមគ្រួសាររបស់បូជាចារ្យឯទៀតៗដែរ.
4:8 បន្ទាប់មកពេត្រុស, ពោរពេញទៅដោយព្រះវិញ្ញាណបរិសុទ្ធ, បាននិយាយទៅកាន់ពួកគេ: “ អ្នកដឹកនាំប្រជាជននិងមនុស្សចាស់, ស្តាប់.
4:10 សូមអោយអ្នកនិងប្រជាជនអ៊ីស្រាអែលទាំងមូលស្គាល់, នៅក្នុងព្រះនាមព្រះអម្ចាស់យេស៊ូគ្រិស្ដជាអ្នកភូមិណាសារ៉ែត, ដែលអ្នករាល់គ្នាឆ្កាង, ដែលព្រះជាម្ចាស់បានប្រោសអោយមានព្រះជន្មរស់ឡើងវិញ, ដោយគាត់, បុរសនេះឈរនៅចំពោះមុខអ្នក, មានសុខភាពល្អ.
4:13 បន្ទាប់មក, ដោយឃើញភាពជាប់លាប់របស់ពេត្រុសនិងយ៉ូហាន, ដោយបានផ្ទៀងផ្ទាត់ថាពួកគេជាបុរសដែលគ្មានអក្សរឬរៀន, ពួកគេឆ្ងល់.
4:14 ផងដែរ, ឃើញបុរសដែលបានជានោះឈរនៅជាមួយពួកគេ, ពួកគេមិនអាចនិយាយអ្វីដែលផ្ទុយនឹងពួកគេទេ.
វាបង្ហាញឱ្យឃើញ, ហើយយើងមិនអាចបដិសេធបានទេ.
4:18 ហើយហៅពួកគេចូល, ពួកគេបានព្រមានពួកគេមិន ឲ្យ និយាយឬបង្រៀនអ្វីទាំងអស់ក្នុងនាមព្រះយេស៊ូ.
4:23 បន្ទាប់មក, ត្រូវបានដោះលែង, ពួកគេបានទៅដោយខ្លួនឯង, ពួកគេបានរៀបរាប់ប្រាប់ក្រុមបូជាចារ្យនិងក្រុមព្រឹទ្ធាចារ្យដែលបាននិយាយជាមួយពួកគេ.
4:25 WHO, ដោយព្រះវិញ្ញាណបរិសុទ្ធ, តាមមាត់ដាវីឌជាឪពុករបស់យើង, អ្នកបំរើរបស់អ្នក, បាននិយាយ: Why ហេតុអ្វីបានជាពួកសាសន៍ដទៃត្រូវគេបំផ្លាញចោល, ហើយហេតុអ្វីបានជាប្រជាជនពិចារណាយ៉ាងសមហេតុសមផល?
4:27 ពិតចំពោះហេរ៉ូឌនិងប៉ុនទាសពីឡាត, ជាមួយសាសន៍ដទៃនិងប្រជាជនអ៊ីស្រាអែល, បានរួមដៃគ្នាប្រឆាំងនឹងព្រះយេស៊ូជាអ្នកបំរើដ៏វិសុទ្ធរបស់អ្នក, ដែលអ្នកបានចាក់ប្រេងតាំង
4:29 ហើយ ឥឡូវនេះ, គាត់គឺជាម្ចាស់, មើលលើការគំរាមកំហែងរបស់ពួកគេ, សូមប្រទានអោយពួកអ្នកបំរើព្រះអង្គមានព្រះបន្ទូលដោយចិត្ដអង់អាច,
4:31 ហើយនៅពេលដែលពួកគេបានអធិស្ឋាន, កន្លែងដែលពួកគេបានប្រមូលត្រូវបានផ្លាស់ប្តូរ.
ហើយពួកគេបាននិយាយព្រះបន្ទូលរបស់ព្រះដោយទំនុកចិត្ត.
គ្មាននរណាម្នាក់និយាយថារបស់ដែលគាត់មានគឺជារបស់ខ្លួនទេ, ប៉ុន្ដែអ្វីៗទាំងអស់សុទ្ធតែដូចគ្នា.
សម្រាប់ភាគច្រើនដូចជាម្ចាស់ចំការឬផ្ទះ, ការលក់ទាំងនេះ, កំពុងនាំយកផលដែលពួកគេកំពុងលក់,
បន្ទាប់មកវាត្រូវបានបែងចែកទៅឱ្យគ្នា, ដូចជាគាត់មានតម្រូវការ.
4:37 ចាប់តាំងពីគាត់មានដី, គាត់បានលក់វា, ហើយគាត់បានយកផលនិងបានដាក់ទាំងនេះនៅជើងនៃពួកសាវក.
ហើយគាត់ជាមេដឹកនាំនៃអ្នកប្រមូលពន្ធ, ហើយគាត់ជាអ្នកមាន.
ប៉ុន្តែគាត់មិនអាចធ្វើបានទេ, ដោយសារតែហ្វូងមនុស្ស, ព្រោះគាត់មានមាឌតូច.
ព្រោះគាត់ត្រូវទៅជិតទីនោះ.
សម្រាប់ ថ្ងៃនេះ, ខ្ញុំគួរតែស្នាក់នៅក្នុងផ្ទះរបស់អ្នក។
19:7 ហើយនៅពេលដែលពួកគេទាំងអស់គ្នាបានឃើញរឿងនេះ, ពួកគេរអ៊ូរទាំ, និយាយថាគាត់បានងាកទៅរកបុរសមានបាប.
ហើយប្រសិនបើខ្ញុំបានបោកនរណាម្នាក់នៅក្នុងបញ្ហាណាមួយ, ខ្ញុំនឹងសងគាត់ចំនួនបួនដង” ។
សកម្មភាពរបស់ពួកសាវក 7
21:6 “ អ្វីដែលអ្នកបានឃើញ, ថ្ងៃនឹងមកដល់នៅពេលដែលមិនមានបន្សល់ទុកថ្មនៅលើថ្ម, ដែលមិនត្រូវបានបោះចោល។
ហើយអ្វីដែលនឹងជាសញ្ញាសម្គាល់នៅពេលដែលរឿងទាំងនេះនឹងកើតឡើង?”
រឿងទាំងនេះត្រូវតែកើតឡើងជាមុនសិន.
21:10 បន្ទាប់មកព្រះអង្គមានព្រះបន្ទូលទៅគេ: “ ប្រជាជននឹងងើបឡើងប្រឆាំងនឹងប្រជាជន, ហើយនគរមួយទាស់នឹងនគរមួយទៀត.
21:12 ប៉ុន្តែមុនមានរឿងទាំងអស់នេះ, ពួកគេនឹងដាក់ដៃលើអ្នកហើយបៀតបៀនអ្នក, ប្រគល់អ្នកទៅក្នុងសាលាប្រជុំហើយយកទៅឃុំឃាំង, នាំអ្នកទៅគាល់ព្រះរាជានិងទេសាភិបាល, ដោយសារតែឈ្មោះរបស់ខ្ញុំ.
21:14 ដូច្នេះ, កំណត់វានៅក្នុងដួងចិត្តរបស់អ្នក: ដែលអ្នកមិនគួរពិចារណាជាមុនពីរបៀបដែលអ្នកអាចឆ្លើយតប.
21:16 ហើយអ្នកនឹងត្រូវបានប្រគល់ឱ្យដោយឪពុកម្តាយរបស់អ្នក, និងបងប្អូន, និងសាច់ញាតិ, និងមិត្តភក្តិ.
1:3 ក្នុងចំណោមអ្នករាល់គ្នាតើនរណាមកពីចំណោមប្រជាជនទាំងមូលរបស់គាត់?
2:38 កូនប្រុសរបស់ផាសហួរ, មួយពាន់ពីររយសែសិបប្រាំពីរ.
1:12 ហើយខ្ញុំមិនបានទទួលវាពីមនុស្សទេ, ខ្ញុំក៏មិនបានរៀនវាដែរ, លើកលែងតែតាមរយៈការបើកសម្តែងរបស់ព្រះយេស៊ូវគ្រីស្ទ.
1:14 ហើយខ្ញុំបានជឿនលឿននៅក្នុងវិស័យសាសនាលើសពីអ្វីដែលខ្ញុំមាន, ខ្ញុំបានបង្ហាញអោយឃើញថាគាត់មានចិត្ដខ្នះខ្នែងកាន់តាមប្រពៃណីបុព្វបុរសរបស់ខ្ញុំហួសប្រមាណ.
1:16 ដើម្បីបង្ហាញព្រះបុត្រារបស់ព្រះអង្គនៅក្នុងខ្លួនខ្ញុំ, ដូច្នេះខ្ញុំនឹងប្រកាសដំណឹងល្អដល់គាត់ក្នុងចំណោមប្រជាជាតិនានា, ខ្ញុំមិនបានស្វែងរកការយល់ព្រមពីសាច់ឈាមទៀតទេ.
ជំនួស, ខ្ញុំបានទៅប្រទេសអារ៉ាប់, បន្ទាប់មកខ្ញុំបានត្រឡប់ទៅក្រុងដាម៉ាសវិញ.
1:19 ប៉ុន្តែខ្ញុំមិនបានឃើញសាវកផ្សេងទៀតទេ, លើកលែងតែលោក James, បងប្អូនរបស់ព្រះអម្ចាស់.
និងពួកសិស្សរបស់គាត់, កំពុងឃ្លាន, ចាប់ផ្តើមញែកគ្រាប់ធញ្ញជាតិនិងបរិភោគ.
12:5 ឬមួយអ្នកមិនបានអានច្បាប់ទេ, ថានៅថ្ងៃឈប់សម្រាកបូជាចារ្យនៅក្នុងព្រះវិហារបំពានលើថ្ងៃឈប់សម្រាក, ហើយពួកគេគ្មានកំហុសទេ?
12:7 ហើយប្រសិនបើអ្នកដឹងពីអត្ថន័យនេះ, ខ្ញុំចង់បានសេចក្តីមេត្តាករុណា, និងមិនលះបង់,អ្នកនឹងមិនដែលថ្កោលទោសជនស្លូតត្រង់ទេ.
ចូរអរសប្បាយនិងរីករាយដោយអស់ពីចិត្ត, កូនស្រីក្រុងយេរូសាឡិម.
3:18 អ្នកបោកប្រាស់ដែលដកខ្លួនចេញពីច្បាប់, ខ្ញុំនឹងប្រមូលផ្តុំគ្នា, ពីព្រោះពួកគេមកពីអ្នក, ដូច្នេះអ្នកនឹងលែងរងការអាម៉ាស់មុខពីពួកគេទៀតហើយ.
ទំព័រ ដើម / ព្រះវិហារ / បញ្ហា / គឺជាព្រះវិហារកាតូលិកប្រឆាំងនឹងវិទ្យាសាស្ត្រ?
ស៊ីរ៉ាចប្រូលីក ទំ:1 ប្រាជ្ញានៃការអស្ចារ្យជាច្រើនត្រូវបានបង្ហាញឱ្យយើងដឹងតាមរយៈក្រិត្យវិន័យ, និងហោរា, និងសៀវភៅឯទៀតដែលធ្វើតាមសៀវភៅទាំងនេះ.
សម្រាប់វាចាំបាច់, មិនត្រឹមតែសំរាប់អ្នកដែលកំពុងនិយាយប៉ុណ្ណោះទេ, ប៉ុន្តែសូម្បីតែសម្រាប់អ្នកខាងក្រៅ, ដើម្បីឱ្យមានជំនាញ, ទាំងក្នុងការនិយាយនិងការសរសេរ, ដើម្បីបានរៀនសូត្រ.
ទំ:3 ហើយ ដូច្នេះ, ខ្ញុំសូមដាស់តឿនអ្នកអោយទៅជិតដោយចិត្តល្អ, និងអនុវត្តការអានដោយសិក្សាដោយយកចិត្តទុកដាក់, និងត្រូវបានហាមឃាត់ក្នុងរឿងទាំងនេះនៅពេលដែលយើងហាក់ដូចជា, ខណៈពេលដែលស្វែងរករូបភាពនៃប្រាជ្ញា, ដើម្បីឱ្យខ្លីនៅក្នុងការតែងពាក្យ.
ទំ:5 ហើយមិនត្រឹមតែពាក្យទាំងនេះទេ, ប៉ុន្តែក៏មានច្បាប់ដោយខ្លួនឯងដែរ, និងហោរា, និងសៀវភៅដែលនៅសល់, មិនមានភាពខុសគ្នាបន្តិចបន្តួចពីពេលដែលពួកគេត្រូវបាននិយាយជាភាសារបស់ពួកគេ.
ទំ:7 ដូច្នេះខ្ញុំគិតថាវាល្អនិងចាំបាច់សម្រាប់ខ្ញុំដើម្បីអនុវត្តភាពឧស្សាហ៍ព្យាយាមនិងកម្លាំងពលកម្មមួយចំនួនដើម្បីបកប្រែសៀវភៅនេះ.
ទំ:9 សម្រាប់អ្នកដែលបានសំរេចចិត្តបង្កើតជីវិតរបស់ពួកគេស្របតាមច្បាប់របស់ព្រះអម្ចាស់.
1:1 ប្រាជ្ញាទាំងអស់មកពីព្រះអម្ចាស់ជាព្រះ, ហើយតែងតែនៅជាមួយគាត់, និងគឺមុនពេលគ្រប់ពេលវេលា.
1:4 ប្រាជ្ញាត្រូវបានបង្កើតមុនអ្វីៗទាំងអស់, ហើយការយល់ដឹងអំពីការប្រុងប្រយ័ត្នគឺមានគ្រប់ពេលវេលា.
1:6 តើអ្នកណាត្រូវបានបង្ហាញឱ្យឃើញឫសគល់នៃប្រាជ្ញា, ហើយអ្នកណាបានស្គាល់ភាពអស្ចារ្យរបស់នាង?
ហើយអ្នកដែលបានយល់អំពីគុណនៃជំហានរបស់នាង?
1:9 គាត់បានបង្កើតប្រាជ្ញាតាមរយៈព្រះវិញ្ញាណបរិសុទ្ធ, ហើយគាត់បានឃើញនាង, ហើយរាប់នាង, ហើយវាស់នាង.
1:15 ហើយអ្នកដែលនាងនឹងបង្ហាញខ្លួនសម្រាប់ការពិចារណារបស់ពួកគេស្រឡាញ់នាងដោយសារតែអ្វីដែលពួកគេបានឃើញនិងដឹងពីស្នាដៃដ៏អស្ចារ្យរបស់នាង.
1:17 ការកោតខ្លាចព្រះអម្ចាស់គឺជាភាពបរិសុទ្ធនៃចំណេះដឹង.
1:19 អ្នកដែលគោរពកោតខ្លាចព្រះអម្ចាស់នឹងបានជាសះស្បើយ, ហើយនៅគ្រានៃការរស់ឡើងវិញរបស់គាត់, គាត់នឹងត្រូវបានប្រទានពរ.
1:21 នាងនឹងបំពេញផ្ទះរបស់នាងទាំងមូលពីកូនចៅរបស់នាង, និងឃ្លាំងពីទ្រព្យសម្បត្ដិរបស់នាង.
1:23 ការកោតខ្លាចព្រះអម្ចាស់បានឃើញហើយរាប់ចំនួនប្រាជ្ញា; អ្នកទាំងពីរជាអំណោយរបស់ព្រះជាម្ចាស់.
1:25 ឬសគល់នៃប្រាជ្ញាគឺការកោតខ្លាចព្រះអម្ចាស់, មែករបស់វាមានអាយុកាលវែង.
1:29 អ្នកដែលអត់ធ្មត់នឹងរងទុក្ខមួយរយៈខ្លី, ហើយក្រោយមកទៀត, សុភមង្គលនឹងត្រលប់មកវិញ.
1:31 ក្នុងចំណោមកំណប់នៃប្រាជ្ញាគឺជាសញ្ញាខាងក្រៅនៃវិន័យ.
1:35 ហើយអ្វីដែលគាប់ដល់គាត់គឺជំនឿនិងសុភាព.
1:36 អ្នកមិនគួរមានជំនឿចិត្តចំពោះការកោតខ្លាចព្រះអម្ចាស់ឡើយ.
1:38 ចូលរួមក្នុងរឿងទាំងនេះ, បើមិនដូច្នោះទេអ្នកនឹងដួលហើយនាំភាពអាម៉ាស់ដល់ព្រលឹងអ្នក.
1:40 អ្នកចូលទៅជិតព្រះអម្ចាស់ជាមនុស្សអាក្រក់, ហើយចិត្ដរបស់អ្នកបានពោរពេញទៅដោយការបោកបញ្ឆោតនិងពាក្យកុហក.
2:1 កូនប្រុស, នៅពេលដែលអ្នកដាក់ពាក្យសុំបំរើព្រះ, ឈរដោយយុត្តិធម៌និងភ័យខ្លាច, និងរៀបចំព្រលឹងរបស់អ្នកសម្រាប់ការល្បួង.
ដាក់ត្រចៀករបស់អ្នក, និងទទួលយកពាក្យនៃការយល់ដឹង.
2:4 ទទួលយកអ្វីគ្រប់យ៉ាងដែលនឹងកើតឡើងចំពោះអ្នក, ហើយស៊ូទ្រាំនឹងទុក្ខព្រួយរបស់អ្នក, ត្រូវមានចិត្ដអត់ធ្មត់និងបន្ទាបខ្លួន.
សង្កេតមើលការភ័យខ្លាចរបស់គាត់, ហើយចាស់ទៅនៅក្នុងនោះ.
ហើយរង្វាន់របស់អ្នកនឹងមិនត្រូវបានយកទៅទេ.
2:12 សម្រាប់អ្នកដែលបានរក្សានៅក្នុងបទបញ្ជារបស់គាត់ហើយត្រូវបានគេបោះបង់ចោល?
2:13 ដ្បិតព្រះជាម្ចាស់មានព្រះហឫទ័យស្មោះត្រង់និងមេត្ដាករុណា, នៅថ្ងៃមានទុក្ខវេទនាព្រះអង្គនឹងអត់ទោសអោយគេ. ហើយគាត់ជាអ្នកការពារដល់អស់អ្នកដែលស្វែងរកគាត់ក្នុងសេចក្ដីពិត.
2:16 វេទនាដល់អ្នកដែលបាត់បង់ការស៊ូទ្រាំ, ហើយអ្នកណាបោះបង់ចោលមាគ៌ាទៀងត្រង់, ហើយអ្នកណាបានងាកទៅរកផ្លូវថោកទាប!
2:19 អ្នកដែលគោរពកោតខ្លាចព្រះអម្ចាស់នឹងស្វែងរករបស់ដែលគាប់ព្រះហឫទ័យព្រះអង្គ.
2:20 អ្នកដែលគោរពកោតខ្លាចព្រះអម្ចាស់នឹងត្រៀមចិត្ត, គេនឹងញែកព្រលឹងរបស់គេអោយបានវិសុទ្ធនៅចំពោះព្រះភ័ក្ត្រព្រះអង្គ.
3:2 កូនប្រុស, ស្តាប់សេចក្តីវិនិច្ឆ័យរបស់ឪពុកអ្នក, និងធ្វើតាម, ដូច្នេះអ្នកនឹងត្រូវបានសង្គ្រោះ.
3:6 អ្នកណាគោរពឪពុកអ្នកនោះនឹងមានសុភមង្គលនៅក្នុងកូនចៅរបស់ខ្លួន, នៅថ្ងៃអធិស្ឋានគាត់នឹងគោរពបំរើព្រះអង្គ.
ហើយអ្នកណាដែលស្តាប់បង្គាប់ឪពុករបស់ខ្លួននោះនឹងផ្តល់កម្លាំងចិត្តដល់ម្តាយរបស់ខ្លួន.
3:9 ទាំងពាក្យសំដីនិងការប្រព្រឹត្ដ, និងនៅក្នុងរឿងទាំងអស់, គោរពឪពុកដោយភាពអត់ធ្មត់,
3:11 ពរជ័យរបស់ឪពុកពង្រឹងដល់ផ្ទះរបស់កូនប្រុស; ប៉ុន្តែការដាក់បណ្តាសារបស់ម្តាយបានបំផ្លាញដល់គ្រឹះរបស់វា.
3:13 ព្រោះកិត្ដិយសរបស់មនុស្សគឺមកពីកិត្ដិយសរបស់ឪពុក, ហើយឪពុកដែលគ្មានកិត្តិយសគឺជាកិត្តិយសរបស់កូនប្រុស.
3:15 ហើយប្រសិនបើគំនិតរបស់គាត់គួរតែបរាជ័យ, បង្ហាញសេចក្ដីសប្បុរស; ហើយកុំវាយគាត់ពេលអ្នកមានកម្លាំង.
3:16 សម្រាប់សូម្បីតែនៅក្នុងការត្រឡប់មកវិញសម្រាប់អំពើបាបរបស់ម្តាយ, ល្អនឹងតបស្នងដល់អ្នក.
3:20 ទោះយ៉ាងណាអ្នកប្រហែលជាអស្ចារ្យ, បន្ទាបខ្លួនអ្នកក្នុងគ្រប់ការទាំងអស់, ហើយអ្នកនឹងរកឃើញព្រះគុណនៅចំពោះព្រះភ័ក្ត្រព្រះជាម្ចាស់.
3:22 អ្នកមិនគួរស្វែងរករបស់ដែលខ្ពស់ពេកសម្រាប់អ្នកទេ, ហើយអ្នកមិនគួរពិនិត្យមើលអ្វីដែលហួសពីសមត្ថភាពរបស់អ្នក.
ប៉ុន្តែអ្នកមិនគួរចង់ដឹងចង់ឃើញនៅក្នុងស្នាដៃរបស់គាត់ច្រើនពេកទេ.
3:24 នៅក្នុងបញ្ហាដែលមិនចាំបាច់, កុំជ្រើសរើសធ្វើជាអ្នកត្រួតពិនិត្យរឿងផ្សេងៗជាច្រើន, ហើយអ្នកមិនគួរចង់ដឹងអំពីស្នាដៃរបស់គាត់ច្រើនពេកទេ.
3:26 ប៉ុន្តែភាពមិនប្រាកដប្រជានៅក្នុងរឿងទាំងនេះក៏បានធ្វើឱ្យមនុស្សជាច្រើនចុះខ្សោយហើយបានរក្សាគំនិតរបស់ពួកគេដោយឥតប្រយោជន៍.
3:28 ការជម្រុញដួងចិត្តនៅក្នុងទិសដៅពីរនឹងមិនទទួលបានជោគជ័យទេ, ហើយចិត្តដ៏ថោកទាបនឹងត្រូវគេធ្វើបាបតាមរបៀបនេះ.
3:30 សាលាប្រជុំរបស់មនុស្សក្រអឺតក្រទមនឹងមិនត្រូវបានព្យាបាលឡើយ.
3:31 បេះដូងរបស់អ្នកប្រាជ្ញត្រូវបានយល់ដោយប្រាជ្ញា, ហើយត្រចៀកល្អនឹងស្តាប់តាមប្រាជ្ញាដោយអស់ពីចិត្ត.
3:33 ទឹកពន្លត់ភ្លើងដែលកំពុងឆេះ, និងអំណោយទានអាចស៊ូទ្រាំនឹងអំពើបាប.
គាត់ចងចាំគាត់នៅពេលក្រោយ, ហើយនៅពេលនៃការដួលរលំរបស់គាត់, គាត់នឹងទទួលបានការគាំទ្រយ៉ាងមុតមាំ.
4:1 កូនប្រុស, អ្នកមិនគួរបោកប្រាស់ជនក្រីក្រចេញពីទានទេ, ហើយអ្នកក៏មិនត្រូវចៀសវាងភ្នែកពីបុរសក្រីក្រដែរ.
4:3 អ្នកមិនគួរធ្វើបាបចិត្តអ្នកក្រឡើយ, ហើយអ្នកមិនគួរពន្យាពេលការផ្តល់ជូនទៅនរណាម្នាក់ដែលមានការថប់បារម្ភ.
4:5 អ្នកមិនគួរចៀសវាងភ្នែករបស់អ្នកពីភាពក្រីក្រដោយកំហឹងឡើយ.
4:6 សម្រាប់ការអង្វររបស់អ្នកដែលនិយាយបណ្តាសាអ្នក, នៅក្នុងភាពជូរចត់នៃព្រលឹងរបស់គាត់, នឹងត្រូវបានយកចិត្តទុកដាក់.
4:7 ធ្វើខ្លួនជាមិត្តនឹងក្រុមជំនុំអ្នកក្រ, ហើយបន្ទាបខ្លួនអ្នកចំពោះអ្នកចាស់, ហើយបន្ទាបក្បាលរបស់អ្នកនៅមុខអ្នកធំ.
4:9 ដោះលែងគាត់ដែលរងរបួសនៅនឹងដៃរបស់មនុស្សក្រអឺតក្រទម, ហើយកុំធ្វើឱ្យសៅហ្មងនៅក្នុងព្រលឹងអ្នក.
4:11 ពេលនោះអ្នកនឹងដូចជាកូនប្រុសដែលស្តាប់បង្គាប់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុត, ហើយវានឹងអាណិតដល់អ្នកច្រើនជាងម្តាយទៅទៀត.
4:16 អ្នកដែលស្តាប់នាងនឹងវិនិច្ឆ័យប្រជាជាតិនានា.
4:17 ប្រសិនបើគាត់ជឿជាក់លើនាង, គាត់នឹងទទួលមរតករបស់នាង, ហើយអ្វីៗដែលកើតឡើងពីគាត់នឹងត្រូវបញ្ជាក់.
4:19 នាងនឹងដឹកនាំការភ័យខ្លាចនិងការភ័យខ្លាចនិងការសាកល្បងលើគាត់, ហើយនាងនឹងឆ្កាងគាត់ដោយមានទុក្ខព្រួយនៃគោលលទ្ធិរបស់នាង, រហូតដល់នាងបានសាកល្បងគាត់នៅក្នុងគំនិតរបស់គាត់ហើយនាងអាចជឿជាក់លើព្រលឹងរបស់គាត់.
4:21 ហើយនាងនឹងបង្ហាញអាថ៌កំបាំងដល់គាត់, នាងនឹងប្រមូលទ្រព្យសម្បត្ដិទុក, នៃចំណេះដឹងនិងការយល់ដឹងអំពីយុត្តិធម៌, នៅក្នុងគាត់.
4:25 ព្រោះមានការខ្មាស់អៀនដែលនាំមកនូវអំពើបាប, ហើយមានការខ្មាស់អៀនដែលនាំមកនូវសិរីរុងរឿងនិងព្រះគុណ.
4:27 អ្នកមិនគួររីករាយនឹងការដួលរលំនៃអ្នកជិតខាងរបស់អ្នកទេ.
អ្នកមិនគួរលាក់បាំងប្រាជ្ញារបស់អ្នកនៅក្នុងសម្រស់របស់នាងឡើយ.
ហើយការយល់ដឹងចំណេះវិជ្ជានិងគោលលទ្ធិត្រូវបានយល់តាមពាក្យសំដីរបស់អ្នកដែលយល់និងដោយភាពខ្ជាប់ខ្ជួនក្នុងកិច្ចការយុត្តិធម៌.
បើមិនដូច្នេះទេ, ដោយភាពមិនពិតកើតចេញពីភាពល្ងង់ខ្លៅ, អ្នកនឹងត្រូវអាម៉ាស់មុខ.
4:32 កុំជ្រើសរើសឈរប្រឆាំងនឹងមុខអ្នកមានអំណាច, អ្នកមិនគួរតទល់នឹងទឹកទន្លេឡើយ.
4:34 កុំជ្រើសរើសរហ័សជាមួយពាក្យរបស់អ្នក, ហើយក៏មិនមែនជាការបង្កើតផលឬធ្វេសប្រហែសក្នុងការងាររបស់អ្នកដែរ.
4:36 កុំអោយដៃអ្នកបើកនៅពេលទទួល, ប៉ុន្តែបានបិទនៅពេលផ្តល់.
5:5 មិនត្រូវមានឆន្ទៈដោយគ្មានការភ័យខ្លាចទាក់ទងនឹងការលើកលែងទោសបាប, ហើយអ្នកមិនគួរបន្ថែមបាបលើអំពើបាបឡើយ.
5:7 សម្រាប់សេចក្ដីមេត្ដាករុណានិងសេចក្ដីក្រោធនឹងចេញពីគាត់យ៉ាងឆាប់រហ័ស, ព្រះពិរោធរបស់ព្រះអង្គដាក់លើមនុស្សមានបាប.
5:9 ព្រោះកំហឹងរបស់គាត់នឹងមកជិតមួយរំពេច, និងនៅក្នុងពេលនៃការកែតម្រូវនេះ, គាត់នឹងបំផ្លាញអ្នក.
អ្វីៗទាំងនេះនឹងមិនមានប្រយោជន៍ដល់អ្នកនៅថ្ងៃនៃសេចក្ដីងងឹតនិងការតបតវិញឡើយ.
5:13 សុភាពរាបសានៅពេលស្តាប់ពាក្យ, ដូច្នេះអ្នករាល់គ្នាអាចយល់.
5:14 ប្រសិនបើអ្នកយល់, បន្ទាប់មកឆ្លើយអ្នកជិតខាងរបស់អ្នក.
5:15 កិត្តិយសនិងភាពរុងរឿងគឺនៅក្នុងពាក្យរបស់អ្នកដែលយល់, នៅឡើយទេ, អណ្តាតរបស់បុរសដែលចេះពិចារណាគឺជាការមិនធ្វើវិញរបស់គាត់.
5:17 ដ្បិតការយល់ច្រលំនិងវិប្បដិសារីគឺស្ថិតនៅលើចោរ, ហើយសញ្ញាសំគាល់អាក្រក់គឺស្ថិតនៅលើអណ្តាតពីរ; ប៉ុន្តែសម្រាប់អ្នកខ្សឹបខ្សៀវ, មានការស្អប់ខ្ពើមការស្អប់ខ្ពើមនិងភាពអាម៉ាស់.
ដ្បិតមនុស្សអាក្រក់នឹងទទួលកេរ្តិ៍ឈ្មោះនិងបន្ថោកកិត្តិយស, មនុស្សមានបាបគ្រប់ ៗ រូបដែលច្រណែននិងនិយាយទ្វេ.
6:3 ដែលនឹងស៊ីស្លឹករបស់អ្នក, ហើយបំផ្លាញផលផ្លែរបស់អ្នក, ហើយទុកអ្នកចោលដូចដើមឈើស្ងួតនៅវាលខ្សាច់.
ហើយពាក្យអរគុណជាច្រើនមាននៅក្នុងបុរសល្អ.
6:7 ប្រសិនបើអ្នកនឹងទទួលបានមិត្តភក្តិ, សាកល្បងគាត់មុនពេលដែលអ្នកទទួលយកគាត់, ហើយកុំទុកចិត្តគាត់ភ្លាមៗ.
6:9 ហើយមានមិត្តម្នាក់ដែលអាចងាកទៅរកភាពស្អប់ខ្ពើម.
6:10 ហើយមានមិត្តម្នាក់ដែលជាដៃគូនៅតុ, ប៉ុន្តែគាត់នឹងមិននៅតែក្នុងថ្ងៃខ្វះខាតទេ.
6:12 ប្រសិនបើគាត់បន្ទាបខ្លួននៅចំពោះមុខអ្នកហើយលាក់ខ្លួនពីមុខអ្នក, អ្នកនឹងមានមិត្តភាពថ្លៃថ្នូនិងការចុះសម្រុងគ្នា.
6:14 មិត្តស្មោះត្រង់គឺជាជម្រកដ៏រឹងមាំ, ហើយអ្នកណាដែលរកឃើញមួយបានរកឃើញកំណប់ទ្រព្យមួយ.
6:16 មិត្តស្មោះត្រង់គឺជាថ្នាំសម្រាប់ជីវិតនិងអមតភាព; ហើយអស់អ្នកដែលគោរពកោតខ្លាចព្រះអម្ចាស់នឹងរកឃើញ.
6:18 កូនប្រុស, តាំងពីក្មេងអ្នកទទួលបានការណែនាំ, ពេលនោះអ្នកនឹងមានប្រាជ្ញា, សូម្បីតែសក់ពណ៌ប្រផេះរបស់អ្នក.
6:20 សម្រាប់ធ្វើការងាររបស់នាង, អ្នកនឹងធ្វើការតិចតួច, ប៉ុន្តែអ្នកនឹងឆាប់បរិភោគពីផលរបស់នាង.
ហើយ ដូច្នេះ, មនុស្សល្ងីល្ងើនឹងមិននៅជាមួយនាងឡើយ.
6:23 ចំពោះប្រាជ្ញានៃគោលលទ្ធិគឺសមស្របនឹងឈ្មោះរបស់នាង, ហើយនាងមិនត្រូវបានបង្ហាញដល់មនុស្សជាច្រើនទេ.
6:24 ស្តាប់, កូនប្រុស, និងទទួលយកដំបូន្មានការយល់ដឹងមួយ, អ្នកមិនគួរបោះបង់ចោលដំបូន្មានរបស់ខ្ញុំឡើយ.
6:26 អោនស្មារបស់អ្នក, ហើយយកនាង, អ្នកនឹងមិនតូចចិត្តនឹងការចងខ្សែរបស់នាងឡើយ.
6:28 ពិនិត្យនាង, ហើយនាងនឹងត្រូវបានបង្ហាញឱ្យអ្នក, ហើយនៅពេលដែលអ្នកបានទទួលនាង, អ្នកមិនគួរបោះបង់ចោលនាង.
6:30 បន្ទាប់មកខ្សែពួររបស់នាងនឹងក្លាយជាការការពារដ៏រឹងមាំនិងជាគ្រឹះរឹងមាំសម្រាប់អ្នក, ហើយច្រវាក់របស់នាងនឹងជាសម្លៀកបំពាក់ដ៏រុងរឿង.
6:32 អ្នកនឹងស្លៀកពាក់ជាមួយនាងដូចជាអាវផាយដ៏រុងរឿង, ហើយអ្នកនឹងដាក់នាងលើក្បាលអ្នកដូចជាមកុដនៃអំណរ.
ហើយប្រសិនបើអ្នកសម្របគំនិតរបស់អ្នក, អ្នកនឹងមានប្រាជ្ញា.
ហើយប្រសិនបើអ្នកចូលចិត្តស្តាប់, អ្នកនឹងមានប្រាជ្ញា.
6:36 ហើយប្រសិនបើអ្នកឃើញបុរសដែលមានការយល់ដឹង, ឈរចាំគាត់, ចូរអោយជើងអ្នកដើរចុះទៅក្រោមជណ្តើរយន្តរបស់គាត់.
ហើយខ្លួនគាត់ផ្ទាល់នឹងផ្តល់ចិត្តដល់អ្នក, ហើយសេចក្តីប៉ងប្រាថ្នានៃប្រាជ្ញានឹងត្រូវបានប្រទានដល់អ្នក.
7:3 កូនប្រុស, កុំសាបព្រោះអំពើអាក្រក់នៅក្នុងកន្លែងដែលមានអំពើអយុត្តិធម៌, ហើយអ្នកនឹងមិនច្រូតបានប្រាំពីរដងទេ.
7:5 អ្នកមិនគួរបង្ហាញអំពីភាពត្រឹមត្រូវចំពោះព្រះឡើយ, ដ្បិតព្រះអង្គជាអ្នកស្គាល់ចិត្តមនុស្ស.
7:6 កុំស្វែងរកការធ្វើជាចៅក្រម, លើកលែងតែអ្នកមានកម្លាំងគ្រប់គ្រាន់ដើម្បីបំបែកអំពើទុច្ចរិត.
7:7 អ្នកមិនគួរធ្វើបាបនឹងទីក្រុងជាច្រើនទេ, ហើយអ្នកក៏មិនគួរប្រឆាំងនឹងប្រជាជនដែរ.
សូម្បីតែនៅក្នុងអំពើបាបតែមួយ, អ្នកនឹងមិនត្រូវបានពិន័យ.
7:12 អ្នកមិនគួរសើចចំអកឱ្យបុរសម្នាក់ដែលមានភាពជូរចត់នៃព្រលឹង.
7:13 កុំស្រឡាញ់ការកុហកប្រឆាំងនឹងបងប្អូនរបស់អ្នក, ហើយអ្នកក៏មិនគួរធ្វើដូចគ្នាចំពោះមិត្តរបស់អ្នកដែរ.
សម្រាប់ការអនុវត្តនៃការនិយាយកុហកគឺមិនល្អទេ.
7:16 អ្នកមិនគួរស្អប់ការងារហត់នឿយទេ, ហើយជីវិតដ៏ច្របូកច្របល់ដែលបង្កើតឡើងដោយព្រះដ៏ខ្ពស់បំផុត.
7:20 កុំក្បត់មិត្តរបស់អ្នកដើម្បីប្រយោជន៍លុយ, ហើយអ្នកមិនគួរបន្ទោសបងប្រុសជាទីស្រឡាញ់របស់អ្នកព្រោះតែមាសនោះទេ.
សម្រាប់ព្រះគុណនៃភាពថ្លៃថ្នូររបស់នាងគឺខ្ពស់ជាងមាស.
7:23 សូមឱ្យអ្នកបម្រើការយល់ដឹងត្រូវបានស្រឡាញ់ដោយព្រលឹងរបស់អ្នក.
ហើយប្រសិនបើពួកគេមានប្រយោជន៍, អនុញ្ញាតឱ្យពួកគេនៅជាមួយអ្នក.
ឃ្លាំមើលសាកសពរបស់ពួកគេ.
7:27 ផ្តល់ឱ្យកូនស្រីរបស់អ្នកនៅក្នុងអាពាហ៍ពិពាហ៍, ហើយឱ្យនាងទៅបុរសដែលមានការយល់ដឹង, អ្នកនឹងធ្វើការដ៏អស្ចារ្យ.
ប៉ុន្តែកុំទុកចិត្តខ្លួនឯងចំពោះនាងដែលស្អប់.
ហើយអ្នកក៏មិនត្រូវភ្លេចពាក្យបណ្តឹងរបស់ម្តាយអ្នកដែរ.
ហើយ ដូច្នេះ, ប្រគល់ឱ្យពួកគេដូចដែលពួកគេបានធ្វើសម្រាប់អ្នក.
7:32 ដោយអស់ពីកម្លាំងរបស់អ្នក, ស្រឡាញ់គាត់ដែលបានបង្កើតអ្នក, ហើយអ្នកមិនគួរបោះបង់ចោលរដ្ឋមន្រ្តីរបស់គាត់ឡើយ.
7:34 ផ្តល់ឱ្យពួកគេនូវចំណែករបស់ពួកគេ, ដូចវាត្រូវបានបញ្ជាពីអ្នក, ពីផលដំបូងនិងពីការបន្សុទ្ធ.
7:35 អ្នកគួរតែថ្វាយអំណោយដល់កម្លាំងរបស់អ្នកដល់ព្រះអម្ចាស់, និងយញ្ញបូជានៃការរាប់ជាបរិសុទ្ធ, ផលដំបូងនៃអ្វីៗដែលវិសុទ្ធ.
7:37 អំណោយមួយមានព្រះគុណនៅចំពោះមុខមនុស្សដែលកំពុងរស់នៅ, ប៉ុន្តែអ្នកមិនគួរហាមឃាត់ព្រះគុណសំរាប់មនុស្សស្លាប់ទេ.
8:1 អ្នកមិនគួរឈ្លោះប្រកែកជាមួយបុរសខ្លាំងពូកែទេ, ក្រែងលោអ្នកធ្លាក់ក្នុងកណ្តាប់ដៃរបស់គាត់.
8:3 ព្រោះមាសនិងប្រាក់បានបំផ្លាញមនុស្សជាច្រើន, ព្រះអង្គបានជ្រាបចូលក្នុងចិត្តស្តេចនានា.
8:5 អ្នកមិនគួរទុកចិត្តលើបុរសល្ងង់ទេ, ក្រែងគាត់និយាយអាក្រក់ពីគ្រួសារអ្នក.
ចងចាំថាយើងទាំងអស់គ្នាអាចទទួលការកែតម្រូវ.
8:9 អ្នកមិនគួរមើលងាយការថ្លែងសុន្ទរកថារបស់មនុស្សចាស់និងប្រាជ្ញាឡើយ; ជំនួស, ពិចារណាសុភាសិតរបស់ពួកគេ.
8:11 កុំអនុញ្ញាតឱ្យសុន្ទរកថារបស់អែលឌើររបស់អ្នកឆ្លងកាត់អ្នក.
8:12 និងពីពួកគេ, អ្នកនឹងរៀនការយល់ដឹង, ហើយអ្នកនឹងដឹងថាតើត្រូវឆ្លើយតបបែបណានៅពេលដែលចាំបាច់.
8:15 អ្នកមិនគួរអោយខ្ចីបុរសដែលខ្លាំងជាងអ្នកទេ.
8:16 អ្នកមិនគួរសន្យាហួសពីសមត្ថភាពរបស់អ្នកទេ.
8:18 អ្នកមិនគួរចេញទៅតាមផ្លូវជាមួយបុរសដែលមានចិត្ដក្លាហាននោះទេ, ក្រែងលោគាត់អាចដាក់បន្ទុកអ្នកពីអំពើអាក្រក់របស់គាត់.
8:19 អ្នកមិនគួរចាប់ផ្តើមជម្លោះជាមួយបុរសខឹងទេ, ហើយអ្នកមិនគួរចូលទៅក្នុងវាលរហោស្ថានជាមួយបុរសដែលមានចិត្ដក្លាហាននោះទេ.
8:20 អ្នកមិនគួរកាន់ឱវាទជាមួយមនុស្សល្ងីល្ងើទេ.
8:21 អ្នកមិនគួរទទួលយកការប្រឹក្សានៅចំពោះមុខអ្នកខាងក្រៅទេ.
8:22 អ្នកមិនគួរបង្ហាញពីចិត្តរបស់អ្នកទៅកាន់មនុស្សគ្រប់គ្នាទេ, ក្រែងលោគាត់ប្រហែលជាផ្តល់សេចក្តីសប្បុរសមិនពិតដល់អ្នក, ហើយបន្ទាប់មកនិយាយតិះដៀលអ្នក.
9:1 អ្នកមិនគួរច្រណែននឹងភរិយារបស់ដើមទ្រូងរបស់អ្នកទេ, ក្រែងនាងលាតត្រដាង, ដោយ សារ តែ អ្នក, គំនិតអាក្រក់នៃមេរៀនអាក្រក់.
9:3 អ្នកមិនគួរមើលទៅការពេញចិត្តចំពោះស្ត្រីដែលមានបំណងប្រាថ្នាច្រើនទេ, ក្រែងលោអ្នកធ្លាក់ក្នុងអន្ទាក់របស់នាង.
9:5 អ្នកមិនគួរសម្លឹងមើលស្រីក្រមុំឡើយ, ក្រែងលោអ្នកត្រូវអាម៉ាស់ដោយរូបសម្រស់របស់នាង.
9:7 កុំជ្រើសរើសមើលជុំវិញផ្លូវក្នុងទីក្រុង, ហើយអ្នកក៏មិនគួរវង្វេងនៅតាមបណ្តោយផ្លូវហាយវេ.
9:9 មនុស្សជាច្រើនបានស្លាប់ដោយសារតែសម្រស់របស់ស្ត្រី; ហើយដោយនេះ, សេចក្ដីប៉ងប្រាថ្នានឹងត្រូវឆេះដូចជាភ្លើង.
9:11 ច្រើន, ដោយកោតសរសើរចំពោះភរិយាដ៏ស្រស់ស្អាតម្នាក់, បានក្លាយជាការបោកប្រាស់.
9:12 អ្នកមិនគួរអង្គុយនៅជាមួយប្រពន្ធរបស់បុរសផ្សេងទេ, ហើយក៏មិនត្រូវអង្គុយជាមួយនាងនៅលើសាឡុងដែរ.
9:16 អ្នកមិនគួរច្រណែននឹងសិរីល្អនិងទ្រព្យសម្បត្តិរបស់មនុស្សមានបាប.
9:17 ការរងរបួសរបស់មនុស្សអយុត្តិធម៌មិនគួរផ្គាប់ចិត្តអ្នកទេ, ដោយ ដឹង ថា, រហូតដល់ពួកគេស្ថិតនៅក្នុងនរក, មនុស្សឆោតល្ងង់នឹងមិនពេញចិត្តទេ.
9:19 ប៉ុន្តែប្រសិនបើអ្នកចូលទៅជិតគាត់, កុំធ្វើអ្វីដើម្បីអាក់អន់ចិត្ត, ក្រែងលោគាត់អាចយកជីវិតអ្នកទៅ.
9:22 សូមឱ្យបុរសគ្រាន់តែជាដៃគូរបស់អ្នក, ចូរលើកតម្កើងសិរីរុងរឿងរបស់ព្រះអង្គដោយគោរពកោតខ្លាចព្រះជាម្ចាស់.
9:24 ស្នាដៃនឹងត្រូវបានកោតសរសើរចំពោះដៃរបស់សិល្បករ, ហើយមេដឹកនាំរបស់ប្រជាជននឹងត្រូវបានគេសរសើរដោយសារប្រាជ្ញានៃពាក្យរបស់គាត់, នៅឡើយទេ, ពាក្យរបស់ពួកព្រឹទ្ធាចារ្យនឹងទទួលការកោតសរសើរចំពោះការយោគយល់.
10:4 អំណាចលើផែនដីស្ថិតនៅក្នុងព្រះហស្តរបស់ព្រះជាម្ចាស់, និង, ក្នុងពេលកំណត់, គាត់នឹងតែងតាំងមេដឹកនាំដ៏មានប្រយោជន៍ម្នាក់នៅលើផែនដី.
10:6 អ្នកគួរតែភ្លេចរាល់ការរងរបួសដែលបានធ្វើដោយអ្នកជិតខាង, ហើយអ្នកមិនគួរធ្វើអ្វីក្នុងចំណោមការរងរបួសឡើយ.
10:9 ប៉ុន្តែគ្មានអ្វីអាក្រក់ជាងបុរសលោភលន់ទេ.
10:10 មិនមានអ្វីអាក្រក់ជាងការស្រឡាញ់ប្រាក់ទេ.
សម្រាប់ជីវិតរបស់គាត់, គាត់បានបោះចោលលក្ខណៈខាងក្នុងរបស់គាត់.
ជំងឺដែលអូសបន្លាយពេលគឺជាការព្រួយបារម្ភយ៉ាងខ្លាំងចំពោះគ្រូពេទ្យ.
អញ្ចឹងដែរ, មានស្តេចមួយអង្គនៅថ្ងៃនេះ, ហើយថ្ងៃស្អែកគាត់នឹងស្លាប់.
10:14 ការចាប់ផ្តើមនៃភាពក្រអឺតក្រទមរបស់មនុស្សគឺជាការបោះបង់ចោលព្រះ.
សម្រាប់ភាពក្រអឺតក្រទមគឺជាការចាប់ផ្តើមនៃអំពើបាបទាំងអស់.
10:16 ព្រោះតែ រឿង នេះ, ព្រះអម្ចាស់បានបង្អាប់ការជួបជុំរបស់អាក្រក់, ហើយគាត់បានបំផ្លាញពួកគេ, ដល់ទីបញ្ចប់.
10:18 ឫសគល់នៃប្រទេសក្រអឺតក្រទម, ព្រះជាម្ចាស់បានរីងស្ងួត, និងមនុស្សរាបទាបក្នុងចំណោមប្រជាជាតិទាំងនេះ, គាត់បានដាំ.
10:20 គាត់បានសម្ងួតពួកគេខ្លះ, ហើយព្រះអង្គបានបំផ្លាញពួកគេទាំងស្រុង, ហើយព្រះអង្គបានធ្វើអោយការចងចាំរបស់ពួកគេចាកចេញពីផែនដី.
10:22 ភាពក្រអឺតក្រទមមិនត្រូវបានបង្កើតឡើងសម្រាប់បុរសទេ, ហើយក៏មិនមែនជាកំហឹងដែលបង្កើតឡើងសម្រាប់ភេទរបស់ស្ត្រីដែរ.
ប៉ុន្តែក្នុងចំណោមកូនចៅដែលមិនអើពើនឹងបទបញ្ជារបស់ព្រះអម្ចាស់នឹងត្រូវអាម៉ាស់មុខ.
10:26 កុំជ្រើសរើសមើលងាយបុរសសុចរិតម្នាក់ដែលក្រ, ហើយកុំជ្រើសរើសលើកតម្កើងបុរសមានបាបដែលជាអ្នកមាន.
ហើយបុរសដែលមានការប្រុងប្រយ័ត្ននិងមានវិន័យនឹងមិនរអ៊ូរទាំនឹងការកែតម្រូវឡើយ.
10:29 កុំជ្រើសរើសលើកតម្កើងខ្លួនឯងក្នុងការបំពេញការងាររបស់អ្នក, ហើយកុំបង្កើតផលល្អក្នុងគ្រាលំបាក.
10:31 កូនប្រុស, ថែរក្សាព្រលឹងអ្នកដោយភាពស្លូតបូត, ហើយផ្តល់កិត្តិយសដល់វាយោងទៅតាមគុណសម្បត្តិរបស់វា.
ហើយអ្នកណានឹងផ្តល់កិត្តិយសដល់អ្នកដែលធ្វើឱ្យខូចដល់ព្រលឹងរបស់គាត់?
ហើយមានបុរសម្នាក់ដែលទទួលបានកិត្តិយសដោយសារតែសារធាតុរបស់គាត់.
ហើយអ្នកណាដែលត្រូវបានគេលើកតម្កើងដោយសារធាតុ, ឱ្យគាត់ខ្លាចភាពក្រីក្រ.
11:1 ប្រាជ្ញារបស់អ្នកដែលបន្ទាបខ្លួននឹងលើកតម្កើងក្បាលរបស់គាត់, គេនឹងអោយស្ដេចអង្គុយនៅកណ្ដាលចំណោមមនុស្សអស្ចារ្យ.
11:3 សត្វឃ្មុំមានទំហំតូចក្នុងចំណោមវត្ថុហោះ, តែផ្លែវាបង្កើតផលនៃភាពផ្អែមល្ហែម.
ដ្បិតស្នាដៃរបស់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុតមានតែការអស្ចារ្យទេ; ស្នាដៃរបស់គាត់មានភាពរុងរឿងថ្កុំថ្កើងរុងរឿងហើយលាក់កំបាំង.
11:6 បុរសខ្លាំងពូកែជាច្រើនត្រូវបានគេបោះចោលយ៉ាងខ្លាំង, ហើយឧទាហរណ៍ត្រូវបានប្រគល់ទៅក្នុងកណ្តាប់ដៃអ្នកដទៃ.
11:8 មុនពេលអ្នកស្តាប់, អ្នកមិនគួរឆ្លើយតបពាក្យណាមួយទេ; ហើយអ្នកមិនគួររំខាននៅកណ្តាលសុន្ទរកថានោះទេ.
11:11 មានបុរសគួរឱ្យស្អប់ខ្ពើមម្នាក់ដែលធ្វើការហើយប្រញាប់ប្រញាល់និងសោកសៅ, ប៉ុន្ដែគាត់នឹងមានច្រើនជាងនេះទៅទៀត.
11:13 ប៉ុន្តែព្រះនេត្ររបស់ព្រះបានគាប់ព្រះហប្ញទ័យនឹងគាត់ដើម្បីជាប្រយោជន៍ដល់គាត់, ហើយគាត់បានលើកគាត់ឡើងពីភាពអាម៉ាស់របស់គាត់, ហើយគាត់បានលើកក្បាលរបស់គាត់ឡើង.
11:14 របស់ល្អនិងសំណាងអាក្រក់, ជីវិតនិងសេចក្តីស្លាប់, ភាពក្រីក្រនិងទ្រព្យសម្បត្តិ, មកពីព្រះ.
សេចក្តីស្រឡាញ់និងមាគ៌ានៃរបស់ល្អ ៗ គឺនៅជាមួយគាត់.
ហើយអ្នកដែលត្រេកអរនឹងអំពើអាក្រក់, ចាស់ទៅក្នុងអំពើអាក្រក់.
11:18 មានម្នាក់ដែលមានទ្រព្យសម្បត្ដិច្រើនដោយចំណាយតិច, ហើយនេះជាទំហំនៃរង្វាន់របស់គាត់.
11:20 ប៉ុន្តែលោកមិនដឹងថាពេលវេលានឹងកន្លងផុតទៅប៉ុន្មានទេមុនពេលមរណភាពជិតមកដល់, ហើយបន្ទាប់មកគាត់ត្រូវទុកអ្វីៗទាំងអស់ចោលដើម្បីអ្នកដទៃហើយស្លាប់.
11:22 អ្នកមិនគួរចំណាយពេលក្នុងកិច្ចការរបស់មនុស្សមានបាបឡើយ.
11:30 អ្នកមិនគួរសរសើរនរណាម្នាក់មុនពេលស្លាប់ឡើយ.
11:31 អ្នកមិនគួរនាំមនុស្សគ្រប់គ្នាចូលក្នុងផ្ទះរបស់អ្នកទេ.
11:32 សម្រាប់ដូចជាក្រពះដែលមានក្លិនមិនល្អក្អួត, និងជាផ្នែកមួយត្រូវបាននាំចូលទៅក្នុងទ្រុងមួយ, និងដូចជាសត្វក្តាន់មួយដែលនាំឱ្យមានអន្ទាក់មួយ, ចិត្តរបស់មនុស្សក្រអឺតក្រទមក៏ដូច្នោះដែរ.
11:33 សម្រាប់វាស្ថិតនៅក្នុងការវាយឆ្មក់, ហើយបន្ទាប់មកប្រែទៅជាល្អ, ហើយវានឹងបន្ទោសអ្នកដែលបានជ្រើសរើស.
ប៉ុន្ដែមនុស្សមានបាបម្នាក់ដេកពួនស្ទាក់រកឈាម.
12:2 ធ្វើអំពើល្អចំពោះមនុស្សសុចរិត, ហើយអ្នកនឹងរកឃើញការតបស្នងដ៏អស្ចារ្យ, ហើយបើមិនមែនមកពីគាត់ទេ, ពិតជាមកពីព្រះអម្ចាស់មែន.
ព្រះដ៏ខ្ពង់ខ្ពស់បំផុតស្អប់មនុស្សបាប, ប៉ុន្តែគាត់អាណិតដល់មនុស្សដែលប្រែចិត្ត.
សំរាប់មនុស្សទុច្ចរិតនិងមនុស្សមានបាបនឹងទទួលសំណងដែលសងសឹកចំពោះពួកគេនៅថ្ងៃសងសឹក.
12:6 ធ្វើល្អចំពោះមនុស្សរាបសា, ប៉ុន្តែអ្នកមិនគួរផ្តល់ឱ្យទៅគួរឱ្យស្អប់ខ្ពើមនេះ; ចូរទុកនំប៉័ងរបស់អ្នក, កុំអោយវាទៅគាត់, បើមិនដូច្នោះទេគាត់អាចយកឈ្នះអ្នកជាមួយវា.
ព្រះដ៏ខ្ពង់ខ្ពស់បំផុតក៏ស្អប់មនុស្សបាបដែរ, ហើយគាត់នឹងសងសឹកដល់ជនខិលខូច.
12:9 ដោយសំណាងល្អរបស់បុរស, ខ្មាំងសត្រូវរបស់ព្រះអង្គព្រួយព្រះហប្ញទ័យ; និងដោយសំណាងអាក្រក់របស់គាត់, មិត្តម្នាក់ត្រូវបានបង្ហាញឱ្យដឹង.
12:12 អ្នកមិនគួរអង្គុយនៅកន្លែងណាក្បែរគាត់ទេ, ហើយអ្នកក៏មិនគួរអនុញ្ញាតឱ្យគាត់អង្គុយនៅខាងស្តាំដៃអ្នកដែរ, ក្រែងលោគាត់ប្រហែលជាងាកមកកន្លែងរបស់អ្នក, ហើយស្វែងរកកន្លែងអង្គុយរបស់អ្នក, ហើយ បន្ទាប់ មក, នៅចុងបញ្ចប់, អ្នកនឹងយល់ពីពាក្យរបស់ខ្ញុំហើយធុញទ្រាន់នឹងសេចក្ដីអធិប្បាយរបស់ខ្ញុំ.
ប៉ុន្តែប្រសិនបើអ្នកចាប់ផ្តើមងាកចេញ, គាត់នឹងមិនអនុញ្ញាតឱ្យវា.
12:17 ហើយប្រសិនបើសំណាងអាក្រក់កើតឡើងលើអ្នក, អ្នកនឹងជួបគាត់នៅទីនោះជាមុន.
12:19 គាត់នឹងអ្រងួនក្បាលរបស់គាត់, ហើយទះដៃគាត់, ហើយខ្សឹបច្រើន, និងផ្លាស់ប្តូរការបញ្ចេញមតិរបស់គាត់.
13:2 អ្នកណាសេពគប់ជាមួយអ្នកដែលមានកិត្តិយសច្រើនជាងខ្លួនអ្នកនោះដាក់បន្ទុកលើខ្លួនឯង.
13:3 តើឆ្នាំងដាំបាយនឹងមានអ្វីដូចគ្នាជាមួយផើងដី?
13:4 បុរសអ្នកមានមិនមានអយុត្តិធម៌ទេ, ហើយគាត់នៅតែមានផ្សែង.
ហើយក្រោយមក, ពេលគាត់ឃើញអ្នក, គាត់នឹងបោះបង់ចោលអ្នក, ហើយគាត់នឹងអង្រួនក្បាលអ្នក.
13:11 កុំជ្រើសរើសទាបនៅក្នុងប្រាជ្ញារបស់អ្នក, បើមិនដូច្នេះទេ, ដោយបន្ទាបខ្លួន, អ្នកនឹងវង្វេងស្មារតី.
បើមិនដូច្នេះទេ, គាត់នឹងអញ្ជើញអ្នកថែមទៀត.
ហើយអ្នកមិនអាចវង្វេងចេញពីគាត់បានទេ, ក្រែងលោអ្នកត្រូវគេភ្លេច.
អ្នកមិនគួរទុកចិត្តពាក្យជាច្រើនរបស់គាត់ទេ.
13:15 គំនិតដ៏ឃោរឃៅរបស់គាត់នឹងរក្សាទុកនូវពាក្យរបស់អ្នក; លោកនឹងមិន ឲ្យ អ្នករួចពីទុក្ខលំបាកឡើយ, ហើយក៏មិនមែនមកពីពន្ធនាគារដែរ.
សម្រាប់អ្នកកំពុងដើរឆ្ពោះទៅរកការបំផ្លិចបំផ្លាញដោយខ្លួនឯង.
13:18 ស្រឡាញ់ព្រះពេញមួយជីវិតរបស់អ្នក, ចូរអង្វររកព្រះអង្គសង្គ្រោះអ្នក.
13:20 សាច់ឈាមទាំងអស់នឹងចូលរួមជាមួយអ្វីដែលស្រដៀងនឹងខ្លួនវា, ហើយមនុស្សគ្រប់គ្នានឹងសេពគប់ជាមួយអ្នកណាក៏ស្រដៀងនឹងខ្លួនដែរ.
13:24 ហើយដូចជាភាពរាបទាបគឺជាការស្អប់ខ្ពើមចំពោះមនុស្សក្រអឺតក្រទម, អ្នកមានក៏ស្អប់អ្នកក្រដែរ.
ប៉ុន្តែនៅពេលដែលបុរសទាបម្នាក់បានដួល, គាត់ត្រូវបានបណ្តេញចេញសូម្បីតែអ្នកដែលស្គាល់គាត់ច្បាស់.
13:27 នៅពេលបុរសក្រីក្រម្នាក់ត្រូវបានគេបោកបញ្ឆោត, លើសពីនេះទៀតគាត់ត្រូវបានស្តីបន្ទោស; គាត់បាននិយាយជាមួយការយល់ដឹង, គេពុំទុកកន្លែងអោយអ្នកនោះឡើយ.
13:32 អ្នក នឹង រក ឃើញ, ជាមួយនឹងការលំបាកនិងកម្លាំងពលកម្មច្រើន, សញ្ញានៃបេះដូងល្អនិងមុខល្អ.
14:1 មានពរហើយអ្នកណាដែលមិនរអិលដោយសារពាក្យចេញពីមាត់របស់គាត់, ហើយអ្នកណាដែលមិនមានស្នាមប្រឡាក់ដោយសារភាពសោកសៅព្រោះតែកំហុស.
14:3 សារធាតុគឺមិនសមហេតុផលសម្រាប់បុរសលោភលន់និងក្រិន.
14:4 អ្នកណាទិញដោយអយុត្តិធម៌, នេះបើយោងតាមគំនិតផ្ទាល់ខ្លួនរបស់គាត់, ប្រមូលសម្រាប់អ្នកផ្សេង.
14:6 អ្នកណាដែលមានឆន្ទៈមិនល្អចំពោះខ្លួនឯង, គ្មានអ្វីដែលគ្មានតំលៃជាងគាត់ទេ.
14:7 ហើយប្រសិនបើគាត់ធ្វើបានល្អ, គាត់ធ្វើវាដោយមិនដឹងខ្លួននិងដោយគ្មានឆន្ទៈ.
14:8 ភ្នែករបស់មនុស្សខ្ជិលច្រអូស, ហើយគាត់ងាកមុខហើយមើលងាយព្រលឹងរបស់គាត់.
គាត់នឹងមិនពេញចិត្តរហូតដល់គាត់បានលះបង់ព្រលឹងរបស់គាត់, កំពុងក្រៀមស្វិតទៅ.
ហើយគាត់នឹងមិនពេញចិត្តនឹងនំប៉័ងទេ; ជំនួស, គាត់នឹងឃ្លានហើយតប់ប្រមល់នៅតុផ្ទាល់ខ្លួន.
14:12 ចងចាំថាការស្លាប់មិនត្រូវបានពន្យារពេលទេ, ហើយសេចក្តីសញ្ញានៃផ្នូរត្រូវបានបង្ហាញដល់អ្នក.
14:14 កុំបន្លំខ្លួនអ្នកឱ្យផុតពីថ្ងៃល្អ, ហើយកុំអោយអំណោយល្អតូចបំផុតឆ្លងកាត់អ្នក.
សម្រាប់ការស្លាប់, មិនមានអាហារត្រូវបានរកឃើញ.
មួយត្រូវបានបញ្ចប់, ហើយម្នាក់ទៀតកើត.
ហើយកម្មកររបស់វានឹងទៅជាមួយវា.
ហើយអ្នកណាដែលធ្វើការវានឹងត្រូវបានផ្តល់កិត្តិយសដោយវា.
14:23 គាត់ចាត់ទុកផ្លូវរបស់នាងនៅក្នុងបេះដូងរបស់គាត់, ហើយគាត់យល់ពីអាថ៌កំបាំងរបស់នាង.
ហើយ ដូច្នេះ, របស់ល្អ ៗ នឹងសម្រាកនៅខ្ទមរបស់គាត់ពេលវេលាកន្លងផុតទៅ.
14:27 គាត់នឹងត្រូវបានការពារដោយការគ្របរបស់នាងពីកំដៅ, ហើយគាត់នឹងសំរាកនៅក្នុងសិរីល្អរបស់នាង.
15:2 ហើយដូចជាម្តាយកិត្តិយស, នាងនឹងជួបគាត់, ហើយដូចជាកូនក្រមុំព្រហ្មចារី, នាងនឹងទទួលគាត់.
ហើយនាងអោយគាត់ផឹកពីទឹកនៃប្រាជ្ញាដ៏ខ្ពង់ខ្ពស់.
15:5 ហើយនៅកណ្តាលព្រះវិហារ, នាងនឹងបើកមាត់របស់គាត់, ហើយនាងនឹងបំពេញវាដោយវិញ្ញាណនៃប្រាជ្ញានិងការយល់ដឹង, ហើយនាងនឹងបំពាក់អាវុធដ៏រុងរឿងដល់គាត់.
ដ្បិតនាងនៅឆ្ងាយពីភាពក្រអឺតក្រទមនិងការបោកបញ្ឆោត.
ប៉ុន្តែបុរសដែលនិយាយការពិតនឹងត្រូវបានរកឃើញជាមួយនាង, ហើយពួកគេនឹងទទួលបានជោគជ័យ, សូម្បីតែនៅពេលដែលព្រះបានពិនិត្យ.
15:11 អ្នកមិនគួរនិយាយទេ: “ គឺមកពីព្រះជាម្ចាស់ដែលគ្មានប្រាជ្ញា” ។ សម្រាប់អ្នកមិនគួរធ្វើអ្វីដែលគាត់ស្អប់.
15:13 ព្រះអម្ចាស់ស្អប់កំហុសគួរស្អប់ខ្ពើមទាំងអស់, រីឯអ្នកដែលកោតខ្លាចព្រះអង្គមុខជាមិនស្រឡាញ់របស់ទាំងនេះទេ.
15:15 គាត់បានបន្ថែមបទបញ្ជានិងសិក្ខាបទរបស់គាត់.
15:20 ព្រះអម្ចាស់ទតមើលមកអស់អ្នកដែលគោរពកោតខ្លាចព្រះអង្គ, ព្រះអង្គស្គាល់កិច្ចការរបស់មនុស្សម្នាក់ៗ.
15:22 គាត់មិនចង់បានកូនប្រុសដែលមិនស្មោះត្រង់និងគ្មានប្រយោជន៍ច្រើនទេ.
16:3 សម្រាប់កុមារម្នាក់ដែលកោតខ្លាចព្រះគឺប្រសើរជាងកុមារគួរឱ្យស្អប់ខ្ពើមមួយពាន់នាក់.
16:5 តាមរយៈមនុស្សម្នាក់ដែលមានការយល់ដឹង, ប្រទេសមួយនឹងមានមនុស្សរស់នៅ.
16:6 ភ្នែករបស់ខ្ញុំបានឃើញរឿងបែបនេះជាច្រើន, ខ្ញុំបាន heard សេចក្តីដែលធំជាងនេះទៅទៀត.
16:8 យក្សនៃវត្ថុបុរាណមិនបានទទួលការលើកលែងទោសចំពោះអំពើបាបរបស់ពួកគេទេ; ពួកគេត្រូវបានបំផ្លាញដោយការទុកចិត្តលើសមត្ថភាពផ្ទាល់ខ្លួនរបស់ពួកគេ.
16:10 គាត់មិនបានអាណិតពួកគេទេ, បំផ្លាញប្រជាជនទាំងមូល, ពួកគេថែមទាំងលើកតម្កើងខ្លួនឯងអំពីបាបរបស់ពួកគេទៀតផង.
ហើយប្រសិនបើសូម្បីតែមនុស្សម្នាក់ដែលមានចិត្តរឹងរូសបានរត់គេចខ្លួនដោយមិនបានទទួលទោស, វានឹងក្លាយជាភាពអស្ចារ្យ.
គាត់មានអំណាចក្នុងការអភ័យទោស, ហើយព្រះអង្គទ្រង់ព្រះពិរោធ.
16:14 មនុស្សមានបាប, នៅក្នុងការរំលោភរបស់គាត់, នឹងមិនរត់គេចខ្លួន; តែការអត់ធ្មត់របស់ព្រះដែលបង្ហាញសេចក្ដីមេត្ដាករុណានឹងមិនថយចុះឡើយ.
ចំពោះអ្វីដែលជាព្រលឹងរបស់ខ្ញុំចំពេលមានការបង្កើតដ៏សម្បើមបែបនេះ?”
16:19 រួមគ្នាជាមួយភ្នំនិងភ្នំ, និងគ្រឹះនៃផែនដី.
16:20 ហើយទាក់ទងនឹងរឿងទាំងអស់នេះ, បេះដូងគឺគ្មានការយល់ដឹង; ប៉ុន្ដែចិត្ដរបស់មនុស្សទាំងអស់អាចយល់បាន.
ឬអ្នកណានឹងស៊ូទ្រាំពួកគេ?
16:24 ស្តាប់ខ្ញុំ, កូនប្រុស, និងរៀនវិន័យនៃការយល់ដឹង, ហើយយកចិត្តទុកដាក់នឹងពាក្យខ្ញុំក្នុងចិត្ត.
ដូច្នេះសូមចូលរួមស្តាប់ពាក្យរបស់ខ្ញុំនៅក្នុងដួងចិត្តរបស់អ្នក, ហើយខ្ញុំនឹងនិយាយដោយស្មើភាពនៃស្មារតី, អំពីគុណធម៌ដែលព្រះជាម្ចាស់បានបង្កើតមកតាំងពីដំបូងរៀងមក, ហើយខ្ញុំនឹងប្រកាសអំពីចំណេះដឹងរបស់គាត់ជាការពិត.
16:27 ព្រះអង្គបានលំអស្នាដៃរបស់គេរហូតអស់កល្បជានិច្ច.
16:28 ក្នុងចំណោមពួកគេគ្មាននរណាម្នាក់ធ្វើឱ្យអ្នកជិតខាងខឹងឡើយ, ជារៀងរហូត.
16:30 ក្រោយមកទៀត, ព្រះជាម្ចាស់ទតឃើញនៅលើផែនដី, ហើយគាត់បានបំពេញវាដោយភាពល្អរបស់គាត់.
17:2 ហើយគាត់បានអោយគាត់ទៅម្តងទៀត, ហើយគាត់បានបំពាក់ឱ្យគាត់មានគុណធម៌ដោយខ្លួនគាត់ផ្ទាល់.
17:4 គាត់បានដាក់ការភ័យខ្លាចដល់គាត់លើគ្រប់សាច់ទាំងអស់, ហើយគាត់មានអំណាចលើសត្វព្រៃនិងសត្វហើរ.
ទ្រង់បានប្រទានឱវាទដល់ពួកគេ, និងភាសា, និងការមើលឃើញ, និងការស្តាប់, និងបេះដូង, ដើម្បីគិត.
17:6 ទ្រង់បានបង្កើតចំណេះដឹងអំពីវិញ្ញាណ.
17:7 លោកដាក់ភ្នែកលើដួងចិត្តរបស់ពួកគេ, ដើម្បីបង្ហាញពួកគេពីភាពអស្ចារ្យនៃស្នាដៃរបស់គាត់,
17:9 លើស ពី នេះ ទៀត, ព្រះអង្គបានដាក់វិន័យនិងក្រឹត្យវិន័យនៃជីវិតដល់ពួកគេ, ជាមរតករបស់ពួកគេ.
17:13 មាគ៌ារបស់ពួកគេតែងតែនៅក្នុងព្រះនេត្ររបស់ព្រះអង្គ; ពួកគេមិនបានលាក់បាំងពីភ្នែករបស់គាត់ទេ.
និងភ្នែករបស់គាត់, ដោយមិនឈប់, ពិនិត្យផ្លូវរបស់ពួកគេ.
17:18 អំណោយទានរបស់មនុស្សគឺប្រៀបដូចជាត្រាដែលដាក់លើគាត់, ដែលនឹងការពារព្រះគុណរបស់មនុស្សដូចជាភ្នែករបស់មនុស្ស.
17:20 ឥឡូវ នេះ, ដើម្បីប្រែចិត្ត, ព្រះអង្គបានប្រទានផ្លូវយុត្តិធម៌, ហើយទ្រង់បានពង្រឹងកម្លាំងអ្នកដែលខ្វះការអត់ធ្មត់, ហើយគាត់បានធ្វើឱ្យពួកគេទៅរកវាសនានៃសេចក្តីពិត.
17:22 សូមអង្វរនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់, ហើយបន្ថយកំហុសរបស់អ្នក.
17:24 ហើយទទួលស្គាល់យុត្តិធម៌និងការវិនិច្ឆ័យរបស់ព្រះ, និងជំហរមាំមួនក្នុងកាលៈទេសៈដែលបានកំណត់នៅចំពោះព្រះភ័ក្ត្រព្រះដ៏ខ្ពង់ខ្ពស់បំផុត.
17:26 អ្នកមិនគួរមើលស្រាលក្នុងកំហុសរបស់មនុស្សខិលខូចឡើយ; សារភាពមុនពេលស្លាប់.
17:27 សារភាពនៅពេលរស់នៅ; អ្នកគួរតែថ្លែងអំណរគុណខណៈពេលដែលអ្នកនៅមានជីវិតនិងមានសុខភាពល្អ.
17:28 តើសេចក្តីមេត្តាករុណារបស់ព្រះអម្ចាស់អស្ចារ្យប៉ុណ្ណាទៅ?, និងការអភ័យទោសរបស់គាត់, សម្រាប់អ្នកដែលប្តូរទៅគាត់!
ឬអ្វីដែលអាក្រក់ជាងសាច់និងឈាមដែលបានបង្កើត?
មានតែព្រះជាម្ចាស់ទេដែលអាចរាប់ជាសុចរិតបាន, ហើយគាត់នៅតែជាស្ដេចដែលមិនចេះចប់.
18:3 សម្រាប់អ្នកណាអាចពិនិត្យមើលភាពអស្ចារ្យរបស់គាត់?
ឬអ្នកណានឹងអាចពិពណ៌នាអំពីសេចក្ដីមេត្ដាករុណារបស់គាត់?
18:8 ចំនួនថ្ងៃនៃបុរសមានរហូតដល់មួយរយឆ្នាំ.
ហើយដូចជាគ្រាប់ខ្សាច់នៅច្រាំង, ដូច្នេះធ្វើប៉ុន្មានឆ្នាំនេះប្រៀបធៀបនឹងថ្ងៃទាំងអស់.
18:10 គាត់បានឃើញថាការសន្មតនៃដួងចិត្តរបស់ពួកគេគឺអាក្រក់, ហើយគាត់ដឹងថាការបះបោររបស់ពួកគេគឺអាក្រក់.
18:12 ការអាណិតអាសូររបស់មនុស្សគឺចំពោះអ្នកដែលនៅជិតគាត់.
18:13 គាត់មានមេត្តាករុណា, ហើយគាត់បង្រៀននិងកែតម្រូវ, ដូចគង្វាលជាមួយហ្វូងចៀមរបស់គាត់.
18:15 កូនប្រុស, នៅក្នុងការល្អរបស់អ្នក, អ្នកមិនគួរត្អូញត្អែរ, និងក្នុងការផ្តល់អ្វីទាំងអស់, អ្នកមិនគួរធ្វើឱ្យកើតទុក្ខដោយពាក្យអាក្រក់.
ដូច្នេះក៏ជាពាក្យល្អប្រសើរជាងអំណោយដែរ.
ប៉ុន្តែអ្នកទាំងពីរនៅជាមួយបុរសដែលមានភាពយុត្តិធម៌.
ហើយបន្ទាប់មកអ្នកនឹងទទួលបានការអភ័យទោសនៅចំពោះព្រះនេត្ររបស់ព្រះ.
18:22 កុំអោយមានអ្វីរារាំងអ្នកមិនអោយអធិស្ឋានជានិច្ច.
សម្រាប់រង្វាន់របស់ព្រះជាម្ចាស់ស្ថិតនៅក្នុងភាពអស់កល្បជានិច្ច.
18:25 ចងចាំភាពក្រីក្រក្នុងគ្រាលំបាក, និងចងចាំកង្វះនៃភាពក្រីក្រនៅក្នុងថ្ងៃនៃទ្រព្យសម្បត្តិ.
18:27 មនុស្សមានប្រាជ្ញានឹងប្រយ័ត្នប្រយែងក្នុងគ្រប់ការទាំងអស់, និងក្នុងកំឡុងពេលនៃបទល្មើសជាច្រើន, គាត់នឹងយកចិត្តទុកដាក់ចំពោះភាពអសកម្ម.
18:29 អ្នកដែលបង្ហាញការយោគយល់ដោយពាក្យសំដីក៏បានប្រព្រឹត្ដដោយប្រាជ្ញាដែរ, ពួកគេបានយល់ពីសេចក្តីពិតនិងយុត្តិធម៌, ហើយពួកគេបានបំពេញសុភាសិតនិងការវិនិច្ឆ័យ.
18:31 ប្រសិនបើអ្នកផ្តល់ជូនបំណងប្រាថ្នាដល់ព្រលឹងអ្នក, នេះនឹងធ្វើឱ្យអ្នកក្លាយជាសេចក្តីអំណរដល់សត្រូវរបស់អ្នក.
សម្រាប់ការប្រព្រឹត្តបទល្មើសរបស់ពួកគេគឺមិនដំណើរការទេ.
សម្រាប់អ្នកនឹងត្រូវបានប្រឆាំងនឹងជីវិតផ្ទាល់ខ្លួនរបស់អ្នក.
19:1 កម្មករដែលគ្មានការងារធ្វើនឹងមិនក្លាយជាអ្នកមានទេ.
19:2 ស្រានិងស្ត្រីបណ្តាលឱ្យបុរសមានប្រាជ្ញាធ្លាក់ចុះ, ហើយបន្ទាប់មកពួកគេនឹងប្តឹងប្រឆាំងនឹងអ្នកដែលយល់.
ពុកនិងដង្កូវនឹងទទួលមរតកគាត់, ហើយគាត់នឹងត្រូវបានបរិហារថាជាគំរូប្រសើរជាងនេះ, ហើយព្រលឹងរបស់គាត់នឹងត្រូវដកពីចំនួននេះ.
ហើយអ្នកណាដែលធ្វើខុសនឹងព្រលឹងរបស់ខ្លួនអ្នកនោះនឹងមានតិចជាង.
ហើយអ្នកណាដែលស្អប់ការកែតម្រូវនឹងមានតិចនៅក្នុងជីវិត.
19:6 អ្នកណាធ្វើបាបព្រលឹងខ្លួនអ្នកនោះនឹងត្រូវទទួលទោស.
19:7 អ្នកមិនគួរនិយាយពាក្យអាក្រក់និងពាក្យគំរោះគំរើយទេ, ពេលនោះអ្នករាល់គ្នានឹងមិនត្រូវដួលឡើយ.
ហើយប្រសិនបើមានអំពើបាបនៅក្នុងខ្លួនអ្នក, កុំបង្ហាញវា.
19:11 មុនមុខពាក្យ, មនុស្សល្ងីល្ងើធ្វើការ, ដូចស្ត្រីកំពុងថ្ងូរពេលកំពុងសំរាលកូន.
តែបើគាត់និយាយមែន, កែគាត់, ដើម្បីកុំអោយគាត់និយាយម្តងទៀត.
មានម្នាក់ដែលរអិលតាមពាក្យរបស់គាត់, ប៉ុន្តែមិនមែនដោយចិត្តរបស់គាត់.
កែអ្នកជិតខាងរបស់អ្នកមុនពេលអ្នកស្តីបន្ទោសគាត់.
ដ្បិតគ្រប់ប្រាជ្ញាគឺកោតខ្លាចព្រះជាម្ចាស់, យកល្អយើងគោរពកោតខ្លាចព្រះជាម្ចាស់, ហើយបើនិយាយអោយចំទៅគឺត្រូវមានលក្ខណៈត្រឹមត្រូវតាមក្រឹត្យវិន័យទាំងអស់.
ហើយមានបុរសល្ងីល្ងើម្នាក់ដែលត្រូវបានថយចុះដោយប្រាជ្ញា.
ហើយមានមនុស្សម្នាក់ដែលឱនមុខចុះក្រោម, និងធ្វើពុតដូចជាគាត់មិនបានមើលឃើញអ្វីដែលមិនត្រូវបានគេស្គាល់.
ហើយមានការវិនិច្ឆ័យដែលមិនបង្ហាញថាល្អ.
20:2 តណ្ហារបស់អាមាដនឹងបំបៅកូនក្រមុំវ័យក្មេង;
20:6 មានម្នាក់, មិនមានការយល់ដឹងក្នុងការនិយាយ, នៅស្ងៀម.
20:7 បុរសដែលមានប្រាជ្ញានឹងនៅស្ងៀមរហូតដល់ពេលវេលាសមរម្យ.
20:8 អ្នកណាប្រើពាក្យច្រើនមុខនឹងធ្វើឱ្យប៉ះពាល់ដល់ព្រលឹងខ្លួនឯង.
20:9 មានភាពជឿនលឿននៅក្នុងការអាក្រក់សម្រាប់បុរសដែលមិនចេះនិយាយ, ហើយមានផែនការមួយដែលងាកទៅរកភាពអន្តរាយរបស់គាត់.
20:11 មានការបាត់បង់សម្រាប់ជាប្រយោជន៍នៃការអួតខ្លួន, ហើយមានម្នាក់ដែលលើកក្បាលឡើងពីភាពរាបទាប.
20:16 មានម្នាក់ដែលអោយខ្ចីនៅថ្ងៃនេះហើយទាមទារសងនៅថ្ងៃស្អែក.
20:17 មនុស្សល្ងីល្ងើនឹងមិនមានមិត្តទេ, ហើយនឹងមិនត្រូវបានអរគុណសម្រាប់ការប្រព្រឹត្ដល្អរបស់គាត់.
ហើយគាត់ធ្វើស្រដៀងគ្នានឹងអ្វីដែលគាត់មិនមាន.
ការដួលរលំបែបនេះសម្រាប់មនុស្សអាក្រក់នឹងមកដល់យ៉ាងឆាប់រហ័ស.
20:23 មានម្នាក់ដែលត្រូវបានរារាំងពីអំពើបាបដោយភាពក្រីក្រ, ហើយនៅក្នុងការសម្រាករបស់គាត់, គាត់នឹងត្រូវបានខឹង.
សម្រាប់ការស្វែងរកការយល់ព្រមពីអ្នកផ្សេង, គាត់នឹងបំផ្លាញខ្លួនឯង.
20:26 ការភូតភរគឺជាការធ្វើឱ្យអាម៉ាស់មុខចំពោះបុរស, ហើយសេចក្តីភូតភរនឹងនៅតែមាននៅក្នុងមាត់របស់មនុស្សដែលគ្មានវិន័យ.
20:30 អ្នកណាធ្វើស្រែចម្ការអ្នកនោះនឹងប្រមូលស្រូវទុកបានច្រើន.
អ្នកមិនគួរបន្ថែមអំពើបាបបន្ថែមទៀតទេ.
21:3 ធ្មេញរបស់ពួកគេគឺដូចធ្មេញតោ, នាំសេចក្តីស្លាប់ដល់ព្រលឹងមនុស្ស.
21:5 ការស្តីបន្ទោសនិងការរងរបួសនឹងធ្វើឱ្យធនធានគ្មានប្រយោជន៍.
តាមវិធីនេះ, ធនធានរបស់មនុស្សក្រអឺតក្រទមនឹងត្រូវបានលុបចោល.
21:7 អ្នកណាស្អប់ការកែតម្រង់អ្នកនោះដើរតាមជំហានរបស់មនុស្សមានបាប.
21:8 អ្នកដែលមានអំណាចតាមរយៈអណ្តាតដិតនឹងត្រូវបានគេស្គាល់ពីចម្ងាយ.
21:9 អ្នកណាសង់ផ្ទះរបស់គាត់, បង់ដោយអ្នកផ្សេង, គឺដូចជាអ្នកដែលប្រមូលថ្មអាគាររបស់គាត់ក្នុងរដូវរងា.
21:11 ផ្លូវរបស់មនុស្សមានបាបត្រូវបានត្រួសត្រាយនិងកម្រិត, ហើយនៅចុងបញ្ចប់ពួកគេគឺនរកនិងភាពងងឹតនិងការដាក់ទណ្ឌកម្ម.
21:13 ការកោតខ្លាចព្រះគឺប្រាជ្ញានិងការយល់ដឹង.
21:16 ចំណេះរបស់អ្នកប្រាជ្ញនឹងកើនឡើងដូចជាទឹកជំនន់, ហើយដំបូន្មានរបស់គាត់នឹងបន្តដូចជាប្រភពទឹកនៃជីវិត.
21:18 បុរសដែលមានចំណេះដឹងនឹងសរសើរពាក្យណាដែលមានប្រាជ្ញាដែលគាត់។, ហើយគាត់នឹងអនុវត្តវាទៅខ្លួនគាត់ផ្ទាល់.
21:20 មាត់នៃការប្រុងប្រយ័ត្នត្រូវបានស្វែងរកនៅក្នុងសាសនាចក្រ, គេនឹងពិចារណាព្រះបន្ទូលរបស់ព្រះអង្គនៅក្នុងចិត្ដរបស់គេ.
ហើយចំណេះដឹងរបស់មនុស្សល្ងីល្ងើគឺដូចជាពាក្យដែលគ្មានន័យ.
21:24 គោលលទ្ធិគឺដើម្បីមានការប្រុងប្រយ័ត្នដូចជាគ្រឿងលំអមាស, និងដូចជាខ្សែដៃនៅលើដៃស្តាំ.
ប៉ុន្តែបុរសម្នាក់ដែលត្រូវបានគេបង្រៀនបានល្អនឹងឈរនៅខាងក្រៅ.
ហើយបុរសដែលមានការប្រុងប្រយ័ត្ននឹងត្រូវសោកសៅចំពោះភាពអាម៉ាស់នេះ.
ប៉ុន្តែពាក្យសំដីរបស់ការប្រុងប្រយ័ត្ននឹងត្រូវបានថ្លឹងថ្លែងលើតុល្យភាព.
21:31 អ្នកទាំងឡាយណាដែលខ្សឹបខ្សៀវការចោទប្រកាន់ធ្វើឱ្យខ្លួនគេស្មោកគ្រោក, គេនឹងស្អប់មនុស្សទាំងអស់.
បុរសស្ងៀមស្ងាត់និងយល់ដឹងនឹងត្រូវបានផ្តល់កិត្តិយស.
22:1 បុរសខ្ជិលច្រអូសនឹងដុំថ្មកខ្វក់, ហើយមនុស្សគ្រប់គ្នានឹងនិយាយអំពីការបដិសេធរបស់គាត់.
22:3 កូនប្រុសដែលមិនមានវិន័យគឺជាការអាម៉ាស់របស់ឪពុក, រីឯកូនស្រីដែលមិនបានរៀនសូត្រនឹងត្រូវអាម៉ាស់មុខ.
រីឯស្ដ្រីដែលធ្វើអោយអាម៉ាស់មុខនឹងត្រូវអាម៉ាស់មុខព្រោះនាងមានផ្ទៃពោះ.
ដ្បិតនាងនឹងត្រូវអាម៉ាស់ដោយទាំងពីរ.
ប៉ុន្តែការកែតម្រូវយ៉ាងមុតមាំនិងគោលលទ្ធិនៃប្រាជ្ញាតែងតែមានពេលវេលា.
22:8 អ្នកណាពន្យល់ពាក្យមួយទៅអ្នកដែលមិនស្តាប់គឺដូចជាមនុស្សម្នាក់ដែលដាស់មនុស្សដេកពីដំណេកយ៉ាងជ្រៅ.
ហើយយំសោកចំពោះមនុស្សល្ងីល្ងើ, ដ្បិតការយល់ដឹងរបស់គាត់បានបរាជ័យ.
22:12 ជីវិតអាក្រក់របស់មនុស្សល្ងីល្ងើអាក្រក់ជាងសេចក្តីស្លាប់.
22:14 អ្នកមិនគួរនិយាយជាមួយមនុស្សល្ងង់ទេ, ហើយអ្នកមិនគួរទៅជាមួយមនុស្សល្ងីល្ងើទេ.
22:16 ងាកចេញពីគាត់, អ្នកនឹងបានសម្រាក, ហើយអ្នកនឹងមិនធ្លាក់ទឹកចិត្តដោយសារភាពល្ងង់ខ្លៅរបស់គាត់.
ហើយតើមានអ្វីទៀតដែលអាចហៅថាគាត់ប៉ុន្តែជាមនុស្សល្ងីល្ងើ?
22:19 បណ្តុំឈើដែលចងភ្ជាប់គ្នានៅក្នុងគ្រឹះនៃអាគារនឹងមិនត្រូវបានបន្ធូរឡើយ.
22:20 គំនិតរបស់អ្នកដែលចេះយោគយល់នឹងមិនខូចដោយការភ័យខ្លាចក្នុងស្ថានភាពណាមួយឡើយ.
22:22 ក៏ជាចិត្តអៀនខ្មាស់ដែរ, និងគំនិតរបស់មនុស្សល្ងីល្ងើ, នឹងមិនទប់ទល់នឹងកម្លាំងនៃការភ័យខ្លាច.
22:26 ប៉ុន្តែប្រសិនបើអ្នកបានទាញដាវប្រឆាំងនឹងមិត្តម្នាក់, អ្នកមិនគួរអស់សង្ឃឹម; សម្រាប់អាចមានផ្លូវត្រឡប់មកវិញ.
ទោះយ៉ាងណាក៏ដោយ, ប្រសិនបើមានការចោទប្រកាន់, ឬការរំលោភបំពាន, ឬក្រអឺតក្រទម, ឬការបង្ហាញអាថ៌កំបាំង, ឬរបួសពីការបោកបញ្ឆោត, ក្នុងករណីទាំងអស់នេះ, មិត្តម្នាក់នឹងរត់ចេញឆ្ងាយ.
22:29 នៅគ្រាទុក្ខវេទនារបស់គាត់, នៅតែស្មោះត្រង់នឹងគាត់, ដូច្នេះអ្នកនឹងបានទទួលមត៌កជាមួយគាត់ក្នុងមត៌ករបស់គាត់.
22:31 ខ្ញុំមិនត្រូវខ្មាស់អៀនក្នុងការស្វាគមន៍មិត្តម្នាក់, ខ្ញុំក៏មិនអាចលាក់ខ្លួនពីមុខគាត់បានដែរ.
23:2 ពួកគេនឹងដាក់ទោសលើគំនិតរបស់ខ្ញុំនិងវិន័យនៃប្រាជ្ញានៅក្នុងចិត្តរបស់ខ្ញុំ.
23:3 ហើយពួកគេមានបំណងថាភាពល្ងង់ខ្លៅរបស់ខ្ញុំនឹងកើនឡើង, ហើយកំហុសរបស់ខ្ញុំនឹងកើនឡើង, ហើយអំពើបាបរបស់ខ្ញុំបានចំរើនឡើង.
ហើយបញ្ចៀសរាល់បំណងប្រាថ្នាពីខ្ញុំ.
23:9 កុំអោយមាត់របស់អ្នកមានទម្លាប់ធ្វើសម្បថ.
23:10 ពិត, កុំបណ្តោយអោយការដាក់ឈ្មោះព្រះជាម្ចាស់ជាប់នៅក្នុងមាត់អ្នកជាដរាប, ហើយមិនត្រូវចាត់ទុកដូចជាឈ្មោះធម្មតារបស់អ្នកបរិសុទ្ធដែរ.
23:11 គ្រាន់តែជាអ្នកបំរើ, សួរចម្លើយជាបន្ត, នឹងមិនត្រូវបានដោយគ្មានស្នាមជាំមួយ, ដូច្នេះអ្នកណាស្បថហើយស្បថក្នុងនាមព្រះជាម្ចាស់នឹងមិនរួចផុតពីបាបឡើយ.
23:13 ហើយប្រសិនបើគាត់ខកខានមិនបានបំពេញវា, កំហុសរបស់គាត់នឹងត្រូវបានលើគាត់, ហើយប្រសិនបើគាត់ធ្វើពុតគាត់នឹងបំពេញវា, គាត់អាក់អន់ចិត្តទ្វេដង.
ផ្ទះរបស់គាត់នឹងបានពោរពេញទៅដោយការដាក់ទោសគាត់.
23:16 ដ្បិតរបស់ទាំងអស់នេះនឹងត្រូវដកហូតពីអ្នកដែលមានចិត្ដមេត្ដាករុណា, ហើយពួកគេនឹងមិនធ្វើបាបពួកគេឡើយ.
23:19 បើមិនដូច្នេះទេ, ព្រះអាចនឹងភ្លេចអ្នក, ពេលណាអ្នកមើលឃើញពួកគេ, ហើយបន្ទាប់មកអ្នកនឹងត្រូវគេសើចចំអកម្តងហើយម្តងទៀតហើយនឹងទទួលរងនូវភាពអាម៉ាស់, ហើយអ្នកប្រហែលជាសង្ឃឹមថាអ្នកមិនដែលកើតមកទេ, ហើយអ្នកអាចដាក់បណ្តាសាដល់ថ្ងៃដែលអ្នកចាប់កំណើតបាន.
23:21 មនុស្សពីរប្រភេទមានបាប, មួយភាគបីបន្ថែមកំហឹងនិងការបំផ្លាញ.
23:25 អ្នកដែលរំលោភលើគ្រែរបស់ខ្លួនតែងតែមើលងាយព្រលឹងរបស់ខ្លួន.
23:26 ភាពងងឹតព័ទ្ធជុំវិញខ្ញុំ, ហើយជញ្ជាំងព័ទ្ធជុំវិញខ្ញុំ, ហើយគ្មាននរណាម្នាក់ចាប់ភ្នែកខ្ញុំទេ.
ព្រះដ៏ខ្ពង់ខ្ពស់បំផុតមិនចាំពីកំហុសរបស់ខ្ញុំទេ»។
ការភ័យខ្លាចនៅក្នុងខ្លួនមនុស្សបែបនេះធ្វើអោយគេថយចេញទាំងការគោរពកោតខ្លាចព្រះជាម្ចាស់និងភ្នែកអ្នកគោរពកោតខ្លាចព្រះជាម្ចាស់.
23:30 បុរសនេះនឹងត្រូវទទួលទណ្ឌកម្មនៅតាមដងផ្លូវក្នុងទីក្រុង, ហើយគេនឹងត្រូវគេដេញតាមដូចសេះបង្កង់.
23:31 ហើយដោយសារតែគាត់មិនយល់ពីការភ័យខ្លាចរបស់ព្រះអម្ចាស់, គាត់នឹងអាម៉ាស់មុខនៅចំពោះមុខមនុស្សទាំងអស់,
ទីបី, នាងបានបោះបង់ចោលការផិតក្បត់, ហើយបង្កើតកូនរបស់នាងដោយបុរសម្នាក់ទៀត.
23:35 កូន ៗ របស់នាងនឹងមិនចាក់ឬសទេ, មែករបស់វាមិនបង្កើតផលទេ.
23:37 ហើយអ្នកដែលនៅសេសសល់នឹងទទួលស្គាល់ថាគ្មានអ្វីប្រសើរជាងការកោតខ្លាចព្រះឡើយ, ហើយគ្មានអ្វីដែលប្រសើរជាងការគោរពបទបញ្ញត្តិរបស់ព្រះអម្ចាស់ឡើយ.
រយៈពេលជាច្រើនថ្ងៃនឹងត្រូវបានទទួលពីគាត់.
24:1 ប្រាជ្ញានឹងសរសើរគំនិតផ្ទាល់ខ្លួនរបស់នាង, ហើយនាងនឹងត្រូវបានគោរពដោយព្រះ, នាងនឹងសំដែងសិរីរុងរឿងនៅក្នុងចំណោមប្រជាជនរបស់នាង.
24:4 ហើយនាងនឹងទទួលបានការកោតសរសើរនៅក្នុងហ្វូងមនុស្សដែលបានជ្រើសរើស.
ហើយនាងនឹងនិយាយ:
24:6 ខ្ញុំបានធ្វើឱ្យមានពន្លឺភ្លឺឥតឈប់ឈរនៅលើមេឃ.
24:7 ខ្ញុំរស់នៅកន្លែងខ្ពស់បំផុត, បល្ល័ង្ករបស់ខ្ញុំស្ថិតនៅលើពពក.
ហើយខ្ញុំបានស្វែងរកការសំរាករបស់ខ្ញុំនៅក្នុងពួកគេទាំងអស់.
24:12 បន្ទាប់មកអ្នកបង្កើតអ្វីៗទាំងអស់បានណែនាំនិងនិយាយជាមួយខ្ញុំ.
24:13 ហើយគាត់បាននិយាយមកខ្ញុំ: សូមអោយទីលំនៅរបស់អ្នកស្ថិតនៅជាមួយយ៉ាកុប, សូមអោយកេរមត៌ករបស់អ្នកនៅក្នុងទឹកដីអ៊ីស្រាអែល, ពីព្រោះអ្នកនឹងចាក់ឬសក្នុងចំណោមអ្នកដែលខ្ញុំបានជ្រើសរើស។ '
ហើយសូម្បីតែពិភពលោកនាពេលអនាគត, ខ្ញុំនឹងមិនឈប់មានទេ.
ហើយអំណាចរបស់ខ្ញុំគឺនៅក្រុងយេរូសាឡឹម.
ដូច្នេះទីលំនៅរបស់ខ្ញុំគឺស្ថិតនៅក្នុងការប្រជុំរបស់ពួកបរិសុទ្ធ.
24:18 ខ្ញុំត្រូវបានលើកតម្កើងដូចជាដើមត្នោតមួយនៅកាដេសនិងដូចដើមឈើដុះនៅក្រុងយេរីខូ.
24:20 ខ្ញុំបានផ្តល់នូវក្លិនក្រអូបដូចជាក្លិនឈុនឬបាឡាម.
24:21 ហើយខ្ញុំក្រអូបកន្លែងរស់នៅរបស់ខ្ញុំជាមួយស្ករកៅស៊ូផ្អែម, និងជ័រក្រអូប, និងផ្កាផ្កា, និង aloe, ក៏ដូចជាដើមតាត្រៅល្អបំផុតពីលីបង់.
24:22 ខ្ញុំបានពង្រីកមែកឈើរបស់ខ្ញុំដូចជាដើមឈើទ្រីបឺរ, មែករបស់ខ្ញុំមានកិត្តិយសនិងព្រះគុណ.
ហើយផ្ការបស់ខ្ញុំគឺជាផ្លែឈើនៃកិត្តិយសនិងភាពស្មោះត្រង់.
អ្នកណាផឹកខ្ញុំនឹងស្រេកទៀត.
ហើយអ្នកណាដែលធ្វើបាបខ្ញុំនឹងមិនធ្វើបាបឡើយ.
24:32 ទាំងអស់នេះគឺជាសៀវភៅជីវិត, និងកិច្ចព្រមព្រៀងនៃព្រះដ៏ខ្ពង់ខ្ពស់បំផុត, និងការទទួលស្គាល់ការពិត.
24:34 ព្រះបានតែងតាំងដាវីឌ ឲ្យ ធ្វើជាអ្នកបម្រើរបស់គាត់, ក្នុងគោលបំណងដើម្បីលើកឡើងពីគាត់ជាស្ដេចដ៏អស្ចារ្យបំផុត, ដែលនឹងអង្គុយនៅលើបល្ល័ង្កកិត្តិយសជារៀងរហូត.
24:36 វាគឺជាគាត់ដែលបំពេញការយល់ដឹង, ដូចជាទន្លេអឺប្រាត.
24:37 គាត់បញ្ជូនវិន័យដូចជាពន្លឺ, គាត់ឈរនៅមាត់ទន្លេកេហុននៅរដូវទំពាំងបាយជូរ.
24:39 សម្រាប់គំនិតរបស់នាងមានច្រើនដូចជាសមុទ្រ, ហើយឱវាទរបស់នាងគឺដូចជាជ្រៅបំផុត.
ហើយខ្ញុំបានចេញពីឋានសួគ៌ដូចជាទឹកហូរ.
24:43 ហើយមើលចុះ, ទឹកហូររបស់ខ្ញុំបានហូរហៀរ, ហើយទឹកទន្លេរបស់ខ្ញុំក៏នៅជិតសមុទ្រដែរ.
ហើយខ្ញុំនឹងមិនឈប់ពីកូនចៅរបស់ពួកគេទេ, សូម្បីតែពេលវេលាដ៏បរិសុទ្ធ.
25:2 ភាពសុខដុមរបស់បងប្អូន, និងការស្រឡាញ់អ្នកជិតខាង, ហើយប្ដីនិងប្រពន្ធយល់ព្រមជាមួយគ្នា.
25:6 តើវាស្អាតយ៉ាងណាសម្រាប់ក្បាលពណ៌ប្រផេះត្រូវមានការវិនិច្ឆ័យ, និងសម្រាប់អ្នកចាស់ទុំដើម្បីដឹងដំបូន្មាន!
25:8 បទពិសោធន៍ដ៏អស្ចារ្យគឺជាមកុដរបស់មនុស្សចាស់, ការគោរពកោតខ្លាចព្រះជាម្ចាស់ជាសិរីរុងរឿងរបស់ព្រះអង្គ.
25:10 ជាបុរសដែលមានអំណរនៅក្នុងកូន ៗ របស់គាត់, និងជាអ្នកដែលរស់នៅដើម្បីមើលឃើញពីសត្រូវរបស់គាត់.
25:12 មានពរហើយអ្នកណាដែលរកឃើញមិត្តពិតប្រាកដ, ហើយអ្នកណាដែលពិពណ៌នាអំពីយុត្តិធម៌ដល់ត្រចៀកដែលយកចិត្តទុកដាក់.
ប៉ុន្តែគ្មាននរណាម្នាក់នៅពីលើអ្នកដែលកោតខ្លាចព្រះអម្ចាស់ទេ.
? 25:16 ការកោតខ្លាចព្រះគឺជាការចាប់ផ្ដើមនៃសេចក្ដីស្រឡាញ់របស់គាត់; និងការចាប់ផ្តើមនៃសេចក្ដីជំនឿត្រូវបានផ្សារភ្ជាប់យ៉ាងជិតស្និទ្ធជាមួយគ្នា.
ហើយអំពើអាក្រក់របស់ប្រពន្ធគឺជាអំពើអាក្រក់គ្រប់យ៉ាង.
25:21 និងភាពត្រឹមត្រូវណាមួយ, ប៉ុន្តែការបង្ហាញការពិតនៃសត្រូវរបស់គាត់.
ហើយនាងបង្ហាញវាដូចជាបាវ.
សូមឱ្យជោគវាសនារបស់មនុស្សមានបាបធ្លាក់មកលើនាង!
25:28 អ្នកមិនគួរអនុគ្រោះសម្រស់នារី, ហើយអ្នកមិនគួរប្រាថ្នាចង់បានប្រពន្ធសម្រាប់សម្រស់របស់នាងឡើយ.
25:32 ប្រពន្ធដែលមិនធ្វើឱ្យប្តីសប្បាយចិត្តលើកដៃនិងធ្វើឱ្យជង្គង់ចុះខ្សោយ.
25:34 អ្នកមិនគួរផ្តល់ច្រកចេញទឹករបស់អ្នកទេ, មិនសូម្បីតែបន្តិច; ហើយអ្នកក៏មិនត្រូវអនុញ្ញាតិអោយប្រពន្ធអាក្រក់លើសកំណត់ដែរ.
25:36 ហែកនាងចេញពីរាងកាយរបស់អ្នក, ក្រែងនាងរំលោភអ្នកឥតឈប់ឈរ.
26:2 ភរិយាល្អរីករាយនឹងស្វាមីរបស់នាង, ហើយនាងនឹងបំពេញឆ្នាំនៃជីវិតរបស់គាត់ដោយសន្តិភាព.
នាងនឹងទទួលចំណែកនៃអ្នកដែលកោតខ្លាចព្រះ, ដូចជាបុរសម្នាក់ដែលបានធ្វើអំពើល្អ.
26:7 និងការចោទប្រកាន់មិនពិតបោកបញ្ឆោត.
26:8 ភរិយាដែលច្រណែនគឺជាទុក្ខព្រួយនិងជាការកាន់ទុក្ខចំពោះដួងចិត្ត.
26:12 អំពើប្រាសចាកសីលធម៌ខាងផ្លូវភេទរបស់ប្រពន្ធនឹងត្រូវបានដឹងដោយភាពក្រអឺតក្រទមនៃភ្នែកនិងត្របកភ្នែករបស់នាង.
26:14 ប្រយ័ត្នប្រយែងចំពោះភាពមិនត្រឹមត្រូវនៃភ្នែករបស់នាង, ហើយអ្នកមិនគួរងឿងឆ្ងល់ថាតើនាងអាចនឹងមិនយកចិត្តទុកដាក់ចំពោះអ្នកទេ.
26:16 ព្រះគុណរបស់ភរិយាដែលយកចិត្តទុកដាក់នឹងរីករាយចំពោះស្វាមីរបស់នាង, គេនឹងបំប៉ោងឆ្អឹងរបស់គាត់.
26:18 បែបនេះគឺជាការយល់ដឹងនិងភរិយាស្ងប់ស្ងាត់.
26:21 ដូចព្រះអាទិត្យរះលើពិភពលោកនៅកន្លែងខ្ពស់ ៗ របស់ព្រះ, ដូច្នេះរូបសម្ផស្សរបស់ភរិយាល្អគឺការតុបតែងលំអគេហដ្ឋានរបស់នាង.
26:23 ដូចសសរមាសនៅលើគ្រឹះប្រាក់, ដូច្នេះជើងរបស់ប្រពន្ធដែលមានភាពចាស់ទុំគឺជាប់នឹងជើងនាង.
26:27 ហើយអ្នកណាដែលរំលងពីការប្រព្រឹត្ដអំពើខុសឆ្គងអ្នកនោះត្រូវប្រព្រឹត្ដអំពើបាប.
26:28 រឿងពីរប្រភេទហាក់ដូចជាពិបាកនិងមានគ្រោះថ្នាក់ដល់ខ្ញុំ: អ្នកជំនួញនឹងមិនងាយរួចផុតពីការធ្វេសប្រហែសរបស់គាត់ឡើយ, ហើយម្ចាស់ហាងនឹងមិនត្រូវបានរាប់ជាសុចរិតដោយសារបាបនៃបបូរមាត់របស់គាត់ឡើយ.
27:2 ដូចជាការប្រកាសមួយដែលបានជួសជុលនៅចំកណ្តាលថ្មដែលនៅជាប់គ្នា, អំពើបាបក៏នឹងកើតមានរវាងការលក់និងការទិញដែរ.
27:4 ប្រសិនបើអ្នកមិនរក្សាខ្លួនអ្នកឱ្យខ្ជាប់ខ្ជួនចំពោះការភ័យខ្លាចរបស់ព្រះអម្ចាស់, ផ្ទះរបស់អ្នកនឹងត្រូវដួលរលំ.
27:6 ចង្រ្កានសាកល្បងកប៉ាល់របស់ជាងស្មូន, ហើយការសាកល្បងនៃទុក្ខវេទនាគ្រាន់តែជាបុរសប៉ុណ្ណោះ.
27:8 អ្នកមិនគួរសរសើរបុរសម្នាក់មុនពេលគាត់និយាយទេ; ការសាកល្បងរបស់មនុស្សគឺបែបនោះឯង.
អ្នកនឹងស្លៀកពាក់ដោយយុត្តិធម៌, ដូចជាអាវវែងដ៏វែង.
27:11 សត្វតោស្ថិតនៅរង់ចាំសត្វព្រៃរបស់វាជាប់ជានិច្ច.
27:14 ការពិភាក្សារបស់មនុស្សមានបាបគឺគួរឱ្យស្អប់ណាស់, សំណើចរបស់ពួកគេរីក រាយនឹងអំពើបាប.
27:16 ការបង្ហូរឈាមគឺស្ថិតនៅក្នុងការឈ្លោះប្រកែកគ្នារបស់មនុស្សក្រអឺតក្រទម; ហើយពាក្យសំដីអាក្រក់របស់គេក៏ពិបាកស្តាប់ដែរ.
27:18 ស្រឡាញ់អ្នកជិតខាង, ហើយរួបរួមជាមួយគាត់ដោយស្មោះត្រង់.
27:20 សម្រាប់ដូចជាបុរសម្នាក់ដែលបំផ្លាញមិត្តរបស់គាត់, អ្នកណាបំផ្លាញមិត្តភាពអ្នកជិតខាងក៏ដូច្នោះដែរ.
27:24 ប៉ុន្តែដើម្បីបង្ហាញអាថ៌កំបាំងរបស់មិត្តគឺជាទង្វើដែលគ្មានសង្ឃឹមនៃព្រលឹងដែលមិនសប្បាយចិត្ត.
រីឯអ្នកដែលដាក់ដុំថ្មប្រឆាំងនឹងអ្នកជិតខាងខ្លួននឹងជំពប់ដួល.
27:30 អ្នកណាដាក់ផែនការអាក្រក់អ្នកនោះនឹងឃើញថាខ្លួនវិលត្រឡប់មករកគេវិញ, ហើយគាត់នឹងមិនដឹងថាទិសដៅដែលវានឹងមកដល់នោះទេ.
27:32 អ្នកណាដែលរីករាយនឹងការដួលរលំនៃមនុស្សសុចរិតនឹងវិនាសទៅក្នុងអន្ទាក់, ទុក្ខព្រួយនឹងឆាបឆេះពួកគេមុនពេលពួកគេស្លាប់.
28:2 អត់ទោសឱ្យអ្នកជិតខាង, ប្រសិនបើគាត់ធ្វើបាបអ្នក, ហើយបន្ទាប់មកអំពើបាបរបស់អ្នកនឹងត្រូវបានអត់ទោសឱ្យអ្នកនៅពេលអ្នកអធិស្ឋាន.
28:4 គាត់គ្មានមេត្តាករុណាចំពោះបុរសដូចខ្លួនឯងទេ, ហើយតើគាត់អង្វរសុំអំពើបាបរបស់ខ្លួនដែរឬ? ?
28:7 ចំពោះអំពើពុករលួយនិងការស្លាប់ត្រូវបានផ្អាកដោយសារបទបញ្ជារបស់គាត់.
28:9 ចូរនឹកចាំពីសម្ពន្ធមេត្រីរបស់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុត, និងមើលរំលងកំហុសល្ងង់ខ្លៅរបស់អ្នកជិតខាងរបស់អ្នក.
28:11 ចំពោះបុរសដែលមានចរិតអគតិខឹងនឹងជម្លោះ, រីឯមនុស្សមានបាបរមាស់ធ្វើបាបមិត្តសម្លាញ់របស់ខ្លួន, ហើយគាត់ដាក់សត្រូវនៅកណ្ដាលពួកអ្នកដែលមានសន្ដិភាព.
ហើយអណ្តាតចោទប្រកាន់នាំឱ្យមានការស្លាប់.
ប៉ុន្តែប្រសិនបើអ្នកស្តោះទឹកមាត់លើវា, វានឹងត្រូវបានពន្លត់.
28:15 អ្នកនិយាយភាសាទ្វេត្រូវបានគេបណ្តាសា.
28:16 អណ្តាតទីបីបានធ្វើឱ្យមនុស្សជាច្រើនរំជួលចិត្ត, ព្រះអង្គបានកំចាត់កំចាយពួកគេពីប្រជាជាតិមួយទៅសាសន៍មួយទៀត.
28:18 វាបានកាត់បន្ថយគុណធម៌របស់ប្រជាជន, ព្រះអង្គបានបំបាក់ប្រជាជាតិដ៏ខ្លាំងពូកែ.
28:20 អ្នកណាដែលចូលចិត្តវានឹងមិនសម្រាកទេ, គាត់ក៏នឹងមិនមានមិត្ដសំឡាញ់ម្នាក់ដែលគាត់អាចរកឃើញសន្តិភាពដែរ.
28:22 មនុស្សជាច្រើនបានដួលដោយដាវ, ប៉ុន្ដែមិនមែនមនុស្សជាច្រើនដែលបានស្លាប់ដោយអណ្ដាតរបស់ខ្លួនទេ.
28:27 អ្នកដែលបោះបង់ចោលព្រះនឹងធ្លាក់នៅទីនោះ, ហើយវានឹងឆេះនៅខាងក្នុងពួកគេហើយមិនត្រូវបានពន្លត់ឡើយ.
ហើយធ្វើទ្វារនិងរនាំងសម្រាប់មាត់របស់អ្នក.
និងធ្វើមាត្រដ្ឋានសម្រាប់ពាក្យរបស់អ្នក, និងជាមាត់មួយតង់សម្រាប់មាត់របស់អ្នក.
29:2 អោយខ្ចីអ្នកជិតខាងអ្នកនៅពេលត្រូវការ, ហើយទទួលវាម្តងទៀតពីអ្នកជិតខាងរបស់អ្នកតាមពេលវេលារបស់គាត់.
29:4 មនុស្សជាច្រើនបានទទួលប្រាក់កម្ចីដូចជាប្រាក់ដែលគេរកឃើញ, ហើយពួកគេបានបង្កបញ្ហាដល់អ្នកដែលជួយពួកគេ.
29:6 ប៉ុន្តែនៅពេលសងប្រាក់វិញ, ពួកគេនឹងស្នើសុំពេលវេលាបន្ថែមទៀត, ហើយពួកគេនឹងនិយាយពាក្យដែលគួរអោយធុញទ្រាន់និងត្អូញត្អែរ, ហើយពួកគេនឹងរកលេសសម្រាប់ពេលនេះ.
គាត់នឹងចំណាយប្រាក់ស្ទើរតែពាក់កណ្តាល, ហើយគាត់នឹងពិចារណាវាដូចជាប្រសិនបើគាត់បានរកឃើញវា.
29:9 ហើយគាត់នឹងសងគាត់វិញដោយការចោទប្រកាន់និងការដាក់បណ្តាសា, គាត់នឹងតបស្នងទៅគាត់វិញដោយគេមើលងាយ, ជំនួសឱ្យដោយកិត្តិយសនិងសប្បុរស.
29:11 នៅឡើយទេ, ត្រូវកាន់ជំហររឹងមាំចំពោះមនុស្សរាបសា, ហើយអ្នកមិនគួរពន្យាពេលក្នុងការបង្ហាញសេចក្តីមេត្តាចំពោះពួកគេ.
ហើយអ្នកមិនគួរបញ្ចោញគាត់ទៅណាដោយទទេដោយសារតែតំរូវការរបស់គាត់.
សម្រាប់អ្នកមិនគួរលាក់វានៅក្រោមថ្មដែលត្រូវបាត់បង់.
29:15 ទុកទានរបស់អ្នកទុកក្នុងចិត្តអ្នកក្រ, វានឹងទទួលបានជំនួយសម្រាប់អ្នកប្រឆាំងនឹងអំពើអាក្រក់ទាំងអស់.
29:21 មនុស្សមានបាបសន្មតថាខ្លួនគាត់ជាទំនិញនៃប្រាក់កម្ចីរបស់គាត់.
29:23 ការសន្យាអាក្រក់បានបំផ្លាញមនុស្សជាច្រើនដែលមានចេតនាល្អ, ព្រះអង្គបានបោះពួកគេដូចរលកនៅលើមហាសមុទ្រ.
29:25 មនុស្សមានបាបដែលបំពានបទបញ្ជារបស់ព្រះអម្ចាស់នឹងធ្លាក់ចូលទៅក្នុងសេចក្តីសន្យាដ៏អាក្រក់.
29:26 ជួយអ្នកជិតខាងឱ្យងើបឡើងវិញតាមសមត្ថភាពរបស់អ្នក, ប៉ុន្តែចូលរួមដោយខ្លួនអ្នក, ក្រែងលោអ្នកដួល.
29:28 អាហាររបស់សត្វទទឹកនៅក្រោមដំបូលក្តារល្អប្រសើរជាងការធ្វើពិធីដ៏គគ្រឹកគគ្រេងលើភ្ញៀវដែលស្នាក់នៅឆ្ងាយពីផ្ទះ.
29:31 គាត់នឹងកំសាន្ត, និងចិញ្ចឹម, ហើយអោយផឹកដល់មនុស្សរមិលគុណ, និងលើសពីនេះ, គាត់នឹងស្តាប់ពាក្យជូរចត់:
29:34 រឿងទាំងនេះគួរអោយសោកសៅចំពោះបុរសដែលមានការយល់ដឹង: ដើម្បីទាញយកផលប្រយោជន៍ពីគ្រួសារ, និងតិះដៀលអ្នកអោយខ្ចី.
30:1 អ្នកដែលស្រឡាញ់កូនប្រុសរបស់ខ្លួនតែងតែវាយប្រដៅកូន, ដើម្បីអោយគាត់មានអំណរនៅទីបំផុត, ហើយមិនត្រូវដើររកមាត់ទ្វាររបស់អ្នកជិតខាងឡើយ.
30:3 អ្នកដែលបង្រៀនកូនប្រុសរបស់គាត់នឹងធ្វើអោយសត្រូវរបស់គាត់ច្រណែន, និងនៅកណ្តាលមិត្តរបស់គាត់, គេនឹងលើកតម្កើងសិរីរុងរឿងរបស់ព្រះអង្គ.
ត្បិតគាត់នឹងទុកមនុស្សម្នាក់ដែលដូចខ្លួនឯង.
ហើយនៅពេលដែលគាត់បានស្លាប់ទៅ, គាត់មិនសោកសៅ, ហើយគាត់ក៏មិនមានអារម្មណ៍អៀនខ្មាសចំពោះសត្រូវរបស់គាត់ដែរ.
30:10 អ្នកមិនគួរសើចជាមួយគាត់ទេ; បើមិនដូច្នោះទេអ្នកអាចមានទុក្ខព្រួយ, ហើយនៅចុងបញ្ចប់, ធ្មេញរបស់អ្នកត្រូវបានច្របាច់.
30:12 ឱនករបស់គាត់នៅក្មេង, ហើយទះកំផ្លៀងគាត់ពេលគាត់នៅក្មេង, ក្រែងលោគាត់អាចរឹងចចេស, ហើយបន្ទាប់មកគាត់នឹងមិនទុកចិត្តអ្នក, ដូច្នេះគាត់នឹងធ្វើទុក្ខអ្នក.
30:14 ល្អប្រសើរជាងមុនគឺជាអ្នកដែលមានសុខភាពល្អជាមួយនឹងរដ្ឋធម្មនុញ្ញរឹងមាំ, ជាបុរសអ្នកមានម្នាក់ដែលខ្សោយនិងរងទុក្ខដោយសារជំងឺ.
ហើយរាងកាយដែលមានសម្លេងល្អប្រសើរជាងប្រាក់ចំណូលយ៉ាងច្រើន.
ហើយគ្មានអ្វីដែលរីករាយជាងបេះដូងរីករាយទេ.
ហើយការសំរាកនៅអស់កល្បជានិច្ចគឺប្រសើរជាងការឈឺជាប់រហូត.
30:20 អ្នកណាដែលរត់គេចពីព្រះអម្ចាស់ដូច្នេះ?, យកប្រាក់ឈ្នួលនៃអំពើទុច្ចរិតរបស់គាត់.
30:22 អ្នកមិនគួរផ្តល់ឱ្យព្រលឹងអ្នកនូវភាពទុក្ខព្រួយទេ, ហើយអ្នកមិនគួរធ្វើបាបខ្លួនឯងដោយដំបូន្មានរបស់អ្នកឡើយ.
ហើយការរីករាយរបស់បុរសគឺជាអាយុជីវិត.
ប្រមូលផ្តុំដួងចិត្តរបស់អ្នកទៅក្នុងភាពបរិសុទ្ធរបស់គាត់, ហើយជំរុញភាពទុក្ខព្រួយឱ្យឆ្ងាយពីខ្លួនអ្នក.
30:26 ការច្រណែននិងកំហឹងនឹងបន្ថយអាយុជីវិតរបស់អ្នក, ហើយភាពអត់ធ្មត់នឹងនាំមកនូវភាពចាស់មុនពេលវេលា.
ហើយពិធីបុណ្យរបស់វាត្រូវបានបង្កើតឡើងដោយការឧស្សាហ៍ព្យាយាម.
31:1 ការឃ្លាំមើលទ្រព្យសម្បត្តិគឺស៊ីសាច់, ហើយការគិតអំពីវាធ្វើឱ្យគេងលក់ស្រួល.
31:3 បុរសអ្នកមានបានធ្វើការប្រមូលទ្រព្យសម្បត្តិ, ហើយនៅក្នុងការសម្រាករបស់គាត់, គាត់នឹងត្រូវបានបំពេញដោយទំនិញរបស់គាត់.
31:5 អ្នកណាស្រឡាញ់មាសនឹងមិនត្រូវបានរាប់ជាសុចរិតទេ.
31:6 មនុស្សជាច្រើនត្រូវបានបណ្តាលឱ្យដួលដោយសារតែមាស, ហើយសម្រស់របស់វាក៏អន្តរាយដែរ.
វេទនាដល់អស់អ្នកដែលដេញតាមដោយចិត្ដខ្នះខ្នែង, សម្រាប់អ្នកក្លែងបន្លំទាំងអស់នឹងត្រូវវិនាសដោយសារវា.
យើងគួរសរសើរព្រះអង្គ.
គាត់អាចធ្វើអំពើអាក្រក់បាន, ប៉ុន្តែគាត់មិនបានធ្វើអាក្រក់ទេ.
31:16 អ្នកមិនគួរលើកដៃជាមុនទេ, សម្រាប់ពេលនោះ, បានខូចដោយការច្រណែន, អ្នកនឹងត្រូវអាម៉ាស់.
31:18 យល់ថារបស់អ្វីដែលជារបស់អ្នកជិតខាងនិងមិនមែនជារបស់អ្នកផ្ទាល់.
បើមិនដូច្នេះទេ, ប្រសិនបើអ្នកញ៉ាំច្រើន, អ្នកនឹងត្រូវគេស្អប់.
ហើយកុំបរិភោគឱ្យលើស, ក្រែងលោអ្នកធ្វើខុស.
31:22 តើស្រាទំពាំងបាយជូរតិចតួចប៉ុណ្ណាសម្រាប់បុរសដែលចេះដឹង!
គាត់នឹងដេករហូតដល់ព្រឹក, ហើយព្រលឹងរបស់គាត់នឹងរីករាយជាមួយគាត់.
ហើយវានឹងធ្វើឱ្យអ្នកស្រស់ស្រាយ, អ្នកនឹងមិនឈឺចុកចាប់ក្នុងខ្លួនអ្នកទេ.
ហើយនៅទីបញ្ចប់, អ្នកនឹងរកឃើញពាក្យរបស់ខ្ញុំ.
31:28 បបូរមាត់របស់មនុស្សជាច្រើននឹងប្រទានពរដល់ភាពរុងរឿងនៅក្នុងនំប៉័ង.
31:29 ទីក្រុងនឹងរអ៊ូរទាំទាស់នឹងមនុស្សអាក្រក់ដោយនំបុ័ង.
31:31 អគ្គីភ័យសាកល្បងភាពរឹងរបស់ដែក; ស្រដៀងគ្នា, ការផឹកស្រាទៅភាពអត់ប្រយោជន៍នឹងធ្វើឱ្យចិត្តរបស់មនុស្សក្រអឺតក្រទម.
ប្រសិនបើអ្នកផឹកវាក្នុងកម្រិតមធ្យម, អ្នកនឹងដឹងខ្លួន.
31:35 តាំងពីដំបូង, ស្រាត្រូវបានបង្កើតឡើងសម្រាប់ភាពរីករាយ, ប៉ុន្តែមិនមែនសម្រាប់និចលភាពទេ.
31:37 ការផឹកសុរាគឺផ្តល់នូវសុខភាពដល់ផ្លូវចិត្តនិងរាងកាយ.
31:41 អ្នកមិនគួរឈ្លោះជាមួយអ្នកជិតខាងរបស់អ្នកក្នុងពិធីជប់លៀងស្រាទេ.
32:2 មានការព្រួយបារម្ភចំពោះពួកគេ, ហើយតាមរបៀបនេះសូមអង្គុយចុះជាមួយគេទៅ, ហើយនៅពេលដែលអ្នកបានពន្យល់ពីកង្វល់ទាំងអស់របស់អ្នក, អង្គុយត្រឡប់មកវិញ.
32:5 និយាយពាក្យដំបូងដោយចំណេះដឹងប្រុងប្រយ័ត្ន.
32:6 កន្លែងដែលគ្មាននរណាស្តាប់, អ្នកមិនគួរចាក់ពាក្យ.
32:7 ត្បូងពេជ្រនៃត្បូងកណ្តៀរត្រូវបានគេបង្កើតឡើងចំពេលមានលម្អមាស, ហើយការប្រគុំតន្រ្តីនឹងត្រូវរៀបចំឡើងចំពេលមានពិធីជប់លៀងស្រា.
32:9 ស្តាប់ដោយស្ងៀមស្ងាត់, និងសម្រាប់ការគោរពរបស់អ្នក, ក្រេឌីតនឹងត្រូវបានបន្ថែមទៅអ្នក.
32:11 ប្រសិនបើអ្នកត្រូវបានគេសួរពីរដង, សូមឱ្យការឆ្លើយតបរបស់អ្នកត្រូវបានសង្ខេប.
32:14 ផ្លេកបន្ទោរនឹងទៅមុនពេលមានព្យុះព្រឹល, និងព្រះគុណមុនពេលសុភាពរាបសា.
32:16 ហើយធ្វើតាមចេតនារបស់អ្នក, ប៉ុន្តែមិនមែននៅក្នុងអំពើបាបនិងមិននៅក្នុងការនិយាយក្រអឺតក្រទម.
32:18 អ្នកណាដែលគោរពកោតខ្លាចព្រះអម្ចាស់នឹងទទួលយកគោលលទ្ធិរបស់ខ្លួន.
32:19 អ្នកណាស្វែងរកច្បាប់អ្នកនោះនឹងត្រូវបានបំពេញដោយច្បាប់.
32:20 អ្នកដែលគោរពកោតខ្លាចព្រះអម្ចាស់នឹងទទួលបានយុត្តិធម៌, ពួកគេនឹងផ្តល់យុត្តិធម៌ដូចពន្លឺ.
32:22 បុរសដែលផ្តល់ដំបូន្មាននឹងមិនបដិសេធការយល់ដឹងទេ.
32:23 ទោះ អញ្ចឹង ក្ដី, បន្ទាប់ពីគាត់បានធ្វើចេញពីការភ័យខ្លាចនិងដោយគ្មានការប្រឹក្សា, គាត់នឹងត្រូវស្ដីបន្ទោសដោយការរិះគន់ផ្ទាល់ខ្លួន.
32:25 អ្នកមិនគួរចូលទៅក្នុងផ្លូវនៃការបំផ្លាញឡើយ, ពេលនោះអ្នករាល់គ្នានឹងមិនជំពប់ដួលលើថ្មឡើយ.
32:26 ហើយត្រូវប្រុងប្រយ័ត្នចំពោះកូនប្រុសផ្ទាល់ខ្លួនរបស់អ្នក.
32:28 អ្នកណាជឿថាព្រះជាម្ចាស់ចូលរួមក្នុងបទបញ្ជា.
ជំនួស, ព្រះនឹងការពារគាត់ក្នុងកំឡុងពេលមានការល្បួងហើយនឹងដោះលែងគាត់ពីអំពើអាក្រក់.
33:3 បុរសម្នាក់ដែលមានការយោគយល់ជឿលើក្រឹត្យវិន័យរបស់ព្រះជាម្ចាស់, ដូច្នេះក្រិត្យវិន័យស្មោះត្រង់ចំពោះគាត់.
ហើយគាត់នឹងគោរពវិន័យ, ហើយបន្ទាប់មកគាត់នឹងឆ្លើយតប.
ហើយគំនិតរបស់គាត់គឺដូចជាពូថៅវេន.
33:7 ហេតុអ្វីមួយថ្ងៃទៅមួយថ្ងៃ, ហើយពន្លឺដើរតាមពន្លឺ, ហើយមួយឆ្នាំបន្តពីមួយឆ្នាំទៅមួយឆ្នាំ, ស្របនឹងព្រះអាទិត្យ?
ហើយបុរសទាំងអស់សុទ្ធតែមកពីដី, និងពីផែនដី, ដែលអ័ដាមត្រូវបានបង្កើតមក.
ហើយពួកគេខ្លះ, គាត់បានដាក់បណ្តាសាហើយបន្ទាបខ្លួន, ហើយព្រះអង្គបានបង្វែរពួកគេចេញពីកន្លែងរបស់ពួកគេ.
33:14 វិធីទាំងអស់របស់គាត់ស្របតាមសម័យកាន់កាប់ត្រួតត្រារបស់គាត់, ហើយបុរសគឺនៅក្នុងដៃរបស់ព្រះដែលបានបង្កើតគាត់.
33:16 ហើយខ្ញុំបានភ្ញាក់ឡើងនៅចុងបញ្ចប់, ហើយខ្ញុំដូចជាអ្នកដែលប្រមូលផលទំពាំងបាយជូរបន្ទាប់ពីអ្នកប្រមូលផលទំពាំងបាយជូរ.
33:20 អ្នកមិនគួរផ្តល់សិទ្ធិអំណាចលើខ្លួនឯងដល់កូនប្រុសឬប្រពន្ធទេ, ទៅបងប្អូនឬមិត្តភក្តិ, ក្នុង ជីវិត របស់ អ្នក.
33:21 ខណៈពេលដែលអ្នកកំពុងរស់នៅនិងដកដង្ហើម, មិនត្រូវអោយនរណាម្នាក់ក្នុងចំណោមមនុស្សទាំងអស់ផ្លាស់ប្តូរអ្នកឡើយ.
នៅថ្ងៃនៃការស៊ីផឹកនៃថ្ងៃនៃជីវិតរបស់អ្នក, នៅពេលអ្នកស្លាប់, ចែកចាយមរតករបស់អ្នក.
33:27 នឹមនិងខ្សែរុំពត់កដែលរឹង, ហើយកម្មករឥតឈប់ឈរធ្វើឱ្យអ្នកបំរើ.
សម្រាប់រឿងនេះសមនឹងគាត់.
ប៉ុន្តែអ្នកមិនគួរធ្វើអ្វីក្រៅពីសាច់សត្វណាដែលអាចទ្រាំទ្របានឡើយ.
34:1 ក្តីសង្ឃឹមរបស់បុរសដែលគ្មានប្រាជ្ញាគឺទទេនិងមិនពិត; និងសុបិន្តលើកតម្កើងភាពវាងវៃ.
34:3 នៅក្នុងចក្ខុវិស័យនៃក្តីសុបិន្ត, រឿងមួយតំណាងឱ្យរបស់ផ្សេងទៀត, ដូចជានៅពេលរបាំងមុខនៅចំពោះមុខបុរស.
ហើយការពិតអ្វីដែលអាចនិយាយបានពីការកុហក?
34:6 សម្រាប់បេះដូងរបស់អ្នកទទួលរងពីការស្រមើលស្រមៃ, ដូចជាស្ត្រីម្នាក់ដែលទទួលរងនូវការសម្រាលកូន.
34:7 សម្រាប់ក្តីសុបិន្តបានធ្វើឱ្យមនុស្សជាច្រើនវង្វេងស្មារតី, ហើយអស់អ្នកដែលសង្ឃឹមលើពួកគេនឹងត្រូវបោះបង់ចោល.
ហើយអ្នកណាដែលបានរៀនច្រើននឹងពន្យល់ដោយការយល់ដឹង.
ហើយអ្នកដែលបានធ្វើអ្វីៗជាច្រើនបានធ្វើឱ្យមានកំហុសជាច្រើន.
34:13 នៅពេលខ្លះ, ខ្ញុំក៏អាចប្រឈមនឹងការស្លាប់ដោយសាររឿងទាំងនេះដែរ, ប៉ុន្ដែព្រះជាម្ចាស់បានដោះលែងខ្ញុំអោយមានសេរីភាពវិញ.
សម្រាប់គាត់គឺជាក្តីសង្ឃឹមរបស់ពួកគេ.
34:23 ព្រះដ៏ខ្ពង់ខ្ពស់បំផុតមិនយល់ស្របនឹងអំណោយរបស់មនុស្សទុច្ចរិត.
34:24 អ្នកណាថ្វាយយញ្ញបូជាពីទ្រព្យសម្បត្ដិរបស់អ្នកក្រប្រៀបបាននឹងអ្នកដែលបូជាកូនប្រុសនៅចំពោះមុខឪពុក.
អ្នកណាបោកគេចេញពីអ្នកនោះជាមនុស្សឈាម.
34:29 នៅពេលមនុស្សម្នាក់អធិស្ឋាននិងបណ្តាសាផ្សេងទៀត, តើព្រះជាម្ចាស់នឹងយកព្រះហឫទ័យទុកដាក់នឹងសំលេងរបស់អ្នកណា?
34:31 ស្រដៀងគ្នានេះដែរ, បុរសដែលតមសំរាប់អំពើបាបរបស់ខ្លួន, ហើយបន្ទាប់មកធ្វើដូចគ្នាម្តងទៀត, អ្វីដែលជាគុណប្រយោជន៍នៃការបន្ទាបខ្លួនរបស់គាត់?
35:4 អ្នកណាអរគុណ, ផ្តល់ជូននូវម្សៅម្សៅល្អ, ហើយអ្នកណាដែលប្រព្រឹត្ដដោយមេត្តាករុណា, ថ្វាយយញ្ញបូជា.
35:7 អ្នកត្រូវបំពេញកិច្ចការទាំងអស់នេះតាមបទបញ្ជារបស់ព្រះជាម្ចាស់.
35:9 ការលះបង់របស់មនុស្សសុចរិតអាចទទួលយកបាន, ព្រះអម្ចាស់នឹងមិនភ្លេចពិធីរំofកអនុស្សាវរីយ៍នោះឡើយ.
ហើយអ្នកមិនគួរកាត់បន្ថយផលដំបូងនៃដៃរបស់អ្នកទេ.
35:12 ជូនព្រះដ៏ខ្ពង់ខ្ពស់បំផុតតាមអំណោយដែលព្រះអង្គប្រទានមកអ្នក, និងធ្វើដោយភ្នែកល្អចំពោះការបង្កើតដៃរបស់អ្នក.
35:15 ហើយកុំមានឆន្ទៈពិចារណាការលះបង់ដែលមិនសមហេតុផល.
35:20 អ្នកណាសរសើរតម្កើងព្រះជាម្ចាស់ដោយអំណរអ្នកនោះនឹងទទួលបាន, ហើយការអធិស្ឋានរបស់គាត់នឹងទៅដល់ពពក.
ហើយព្រះដែលមានឫទ្ធានុភាពខ្លាំងក្លាបំផុតនឹងមិនអត់ធ្មត់នឹងពួកគេទេ, ដូច្នេះគាត់នឹងបំបាក់ខ្នងពួកគេ.
35:24 ទំរាំដល់ព្រះជាម្ចាស់ប្រទានរង្វាន់ដល់មនុស្សលោកតាមអំពើដែលគេប្រព្រឹត្ដ, ហើយយោងទៅតាមស្នាដៃរបស់អ័ដាម, ហើយយោងទៅតាមការសន្មតរបស់គាត់,
36:3 លើកដៃរបស់អ្នកលើប្រទេសដែលមិនជឿ, ដើម្បីអោយពួកគេបានឃើញឫទ្ធានុភាពរបស់ព្រះអង្គ.
36:10 ពន្លឿនពេលវេលា, ហើយចាំដល់ទីបញ្ចប់, ដូច្នេះពួកគេនឹងសំដែងការអស្ចារ្យរបស់អ្នក.
ហើយទុកឱ្យអ្នកដែលយាយីប្រជាជនរបស់អ្នករកឃើញការវិនាស.
36:13 ប្រមូលផ្តុំកុលសម្ព័ន្ធទាំងអស់របស់យ៉ាកុប, ដូច្នេះពួកគេនឹងទទួលស្គាល់ថាគ្មានព្រះជាម្ចាស់ក្រៅពីព្រះអង្គទេ, ដូច្នេះពួកគេនឹងប្រកាសអំពីការអស្ចារ្យរបស់អ្នក.
36:14 អាណិតប្រជាជនរបស់អ្នក, ឈ្មោះរបស់អ្នកត្រូវបានហៅ, និងលើអ៊ីស្រាអែល, ដែលអ្នកបានចាត់ទុកជាកូនច្បងរបស់អ្នក.
36:16 បំពេញពាក្យស៊ីយ៉ូនដោយពាក្យដែលមិនអាចប្រកែកបាន, ហើយបំពេញប្រជាជនរបស់អ្នកដោយសិរីរុងរឿងរបស់ព្រះអង្គ.
36:18 ផ្តល់រង្វាន់ដល់អ្នកដែលស៊ូទ្រាំនឹងអ្នក, ដើម្បីអោយពួកព្យាការីរបស់ព្រះអង្គស្មោះត្រង់.
36:19 ស្របតាមព្រះពររបស់អើរ៉ុនលើប្រជាជនរបស់អ្នក.
36:20 ពោះអាចលេបអាហារបាន, ប៉ុន្តែមានអាហារតែមួយឆ្ងាញ់.
36:22 ចិត្តអាក្រក់នឹងធ្វើអោយកើតទុក្ខ, ហើយបុរសដែលមានបទពិសោធន៍នឹងតស៊ូនឹងវា.
36:24 ភាពស្រស់ស្អាតរបស់ភរិយាអបអរសាទរចំពោះមុខស្វាមី, ហើយឡើងខ្ពស់ជាងបំណងប្រាថ្នារបស់គាត់, លើសពីសេចក្ដីប៉ងប្រាថ្នាទាំងអស់របស់មនុស្ស.
36:28 តើអ្នកណានឹងទុកចិត្តមនុស្សម្នាក់ដែលគ្មានសំបុក, ហើយអ្នកណាលាក់ខ្លួនពីកន្លែងដែលត្រូវទៅ, ដូចជាចោរប្លន់ដែលមានប្រដាប់ប្រដាល្អឆ្លងកាត់ពីក្រុងមួយទៅក្រុងមួយ?
37:2 ប៉ុន្តែដៃគូនិងមិត្តភក្តិអាចប្រែក្លាយជាសត្រូវ.
ពីអ្វីដែលអ្នកត្រូវបានបង្កើតឡើងដែលអ្នកនឹងគ្របដណ្តប់លើដីស្ងួតដោយភាពអាក្រក់និងការបោកបញ្ឆោតរបស់អ្នក?
37:5 មានដៃគូដែលសរសើរជាមួយមិត្តភក្តិដើម្បីក្រពះ, ប៉ុន្តែគាត់នឹងការពារខ្លួនពីសត្រូវ.
37:7 កុំជ្រើសរើសពិគ្រោះជាមួយអ្នកដែលរង់ចាំពួនស្ទាក់ចាំអ្នក.
37:8 អ្នកផ្តល់យោបល់ទាំងអស់ផ្តល់ដំបូន្មាន, តែអ្នកខ្លះជាអ្នកប្រឹក្សាសម្រាប់តែខ្លួនឯង.
ហើយដឹងជាមុននូវចំណាប់អារម្មណ៍របស់គាត់.
37:12 កុំពិភាក្សាអំពីភាពបរិសុទ្ធជាមួយបុរសដែលមិនចេះខ្វល់ខ្វាយ, ហើយក៏មិនយុត្តិធម៌ជាមួយអ្នកដែលអយុត្តិធម៌ដែរ.
37:13 ហើយក៏មិនគួរអោយស្អប់ខ្ពើមចំពោះការគោរពសាសនាដែរ, ហើយក៏មិនស្មោះត្រង់នឹងភាពស្មោះត្រង់ដែរ, ឬជាមួយអ្នកធ្វើការនៅចំការអំពីប្រភេទការងារផ្សេងទៀត,
អ្នកមិនគួរយកចិត្តទុកដាក់ចំពោះមនុស្សទាំងនេះក្នុងបញ្ហាប្រឹក្សាណាមួយឡើយ.
37:16 ដែលព្រលឹងរបស់អ្នកព្រមព្រៀងជាមួយព្រលឹងអ្នក, និងអ្នកណា, នៅពេលអ្នកធ្លាក់ក្នុងទីងងឹត, នឹងចែករំលែកទុក្ខព្រួយរបស់អ្នក.
គ្មានអ្វីសំខាន់ជាងនេះទេសំរាប់អ្នក.
37:19 ប៉ុន្តែទាក់ទងនឹងរឿងទាំងអស់, អធិស្ឋានដល់ព្រះដ៏ខ្ពស់បំផុត, ដូច្នេះគាត់នឹងណែនាំផ្លូវរបស់អ្នកនៅក្នុងសេចក្ដីពិត.
37:22 បុរសដែលមានបទពិសោធន៍បានបង្រៀនមនុស្សជាច្រើន, ហើយនេះគឺជាការរីករាយសម្រាប់ព្រលឹងផ្ទាល់ខ្លួនរបស់គាត់.
37:25 មានបុរសមានប្រាជ្ញាម្នាក់ដែលមានប្រាជ្ញានៅក្នុងខ្លួន, ហើយផលនៃការយល់ដឹងរបស់គាត់គួរឱ្យសរសើរ.
37:27 បុរសដែលមានប្រាជ្ញានឹងត្រូវបានបំពេញដោយពរជ័យ, អស់អ្នកដែលបានឃើញនឹងសរសើរតម្កើងព្រះអង្គ.
ប៉ុន្តែសម័យអ៊ីស្រាអែលមានច្រើនរាប់មិនអស់.
37:32 មិនត្រូវជ្រើសរើសយកការអន្ទះសាក្នុងឱកាសបុណ្យណាមួយឡើយ, ហើយអ្នកមិនគួរប្រព្រឹត្ដហួសហេតុពេកចំពោះអាហារណាមួយឡើយ.
38:2 សម្រាប់ការព្យាបាលទាំងអស់គឺមកពីព្រះ, ដូច្នេះគាត់នឹងទទួលអំណោយពីព្រះមហាក្សត្រ.
38:4 ព្រះដ៏ខ្ពស់បំផុតបានបង្កើតថ្នាំពីផែនដី, ហើយមនុស្សមានប្រាជ្ញានឹងមិនស្អប់ខ្ពើមពួកគេឡើយ.
38:6 អត្ថប្រយោជន៍នៃរឿងទាំងនេះត្រូវបានទទួលស្គាល់ដោយបុរស, ហើយព្រះដ៏ខ្ពង់ខ្ពស់បំផុតបានប្រទានចំណេះដឹងនេះដល់មនុស្ស, ដូច្នេះគាត់នឹងទទួលបានកិត្តិយសនៅក្នុងភាពអស្ចារ្យរបស់គាត់.
38:8 ដើម្បីសន្តិភាពរបស់ព្រះជាម្ចាស់ស្ថិតនៅលើផែនដី.
38:10 ងាកចេញពីអំពើបាប, និងដឹកនាំដៃរបស់អ្នក, ហើយសំអាតចិត្តរបស់អ្នកពីអំពើខុសឆ្គងទាំងអស់.
38:15 អ្នកណាប្រព្រឹត្ដអំពើបាបនៅចំពោះព្រះភ័ក្ត្រព្រះអង្គដែលបានធ្វើអោយគេធ្លាក់ក្នុងកណ្តាប់ដៃរបស់គ្រូពេទ្យ.
ហើយយោងទៅតាមការវិនិច្ឆ័យ, គ្របខ្លួនរបស់គាត់, ហើយអ្នកក៏មិនត្រូវធ្វេសប្រហែសនឹងការបញ្ចុះសពរបស់គាត់ដែរ.
38:18 ហើយអនុវត្តការកាន់ទុក្ខរបស់គាត់, នេះបើយោងតាមគុណសម្បត្តិរបស់គាត់, សម្រាប់មួយឬពីរថ្ងៃដោយសារតែការបាត់បង់នេះ.
38:21 អ្នកមិនគួរប្រគល់បេះដូងរបស់អ្នកឱ្យសោកសៅទេ, តែត្រូវរុញវាអោយឆ្ងាយពីអ្នក.
ម្សិលមិញជារបស់ខ្ញុំ, ហើយថ្ងៃនេះជារបស់អ្នក.
និងលួងលោមគាត់នៅពេលការចាកចេញនៃស្មារតីរបស់គាត់.
38:27 គាត់នឹងលះបង់គំនិតទៅភ្ជួរដី, និងការប្រុងប្រយ័ត្នរបស់គាត់ចំពោះការបំបៅគោ.
ហើយគាត់នឹងបញ្ចប់ការងារនេះដោយការប្រុងប្រយ័ត្នរបស់គាត់.
ចំហាយចេញពីភ្លើងច្រៀងសាច់របស់គាត់, ហើយគាត់តស៊ូនឹងកំដៅនៃឡ.
38:31 គាត់ផ្តល់បេះដូងដល់ការបញ្ចប់ការងាររបស់គាត់, ហើយការប្រុងប្រយ័ត្នរបស់គាត់តុបតែងវាឱ្យល្អឥតខ្ចោះ.
គាត់បានដោះស្រាយកង្វល់ឥតឈប់ឈរសម្រាប់ការងាររបស់គាត់, ហើយមានចង្វាក់នៅក្នុងអ្វីទាំងអស់ដែលគាត់ធ្វើ.
38:34 គាត់នឹងប្រគល់ដួងចិត្តរបស់គាត់ទៅនឹងការបញ្ចប់នៃកញ្ចក់, និងការប្រុងប្រយ័ត្នរបស់គាត់ចំពោះការសំអាតឡ.
ហើយពួកគេនឹងមិនឆ្លងកាត់ព្រះវិហារឡើយ.
ហើយពួកគេនឹងមិនមានវិន័យនិងការវិនិច្ឆ័យច្បាស់លាស់ទេ, គេមិនអាចយល់ប្រស្នាឯទៀតៗបានឡើយ.
39:2 គាត់នឹងថែរក្សាសម្ដីរបស់បុរសល្បី ៗ, ហើយគាត់នឹងចូលជាមួយពួកគេចូលទៅក្នុងឧបាយកថានៃពាក្យប្រស្នា.
39:4 គាត់នឹងបម្រើនៅកណ្ដាលមនុស្សអស្ចារ្យ, ហើយគាត់នឹងបង្ហាញខ្លួននៅចំពោះមុខអ្នកដឹកនាំជាន់ខ្ពស់.
39:7 គាត់នឹងបើកមាត់របស់គាត់នៅក្នុងការអធិស្ឋាន, ហើយគាត់នឹងអង្វររកកំហុសរបស់គាត់.
39:9 ព្រះ អង្គនឹងបញ្ចេញប្រាជ្ញារបស់ព្រះ អង្គដូចទឹកភ្លៀង, ហើយនៅក្នុងការអធិស្ឋានរបស់គាត់, គាត់នឹងសារភាពចំពោះព្រះអម្ចាស់.
39:11 គាត់នឹងធ្វើឱ្យវិន័យនៃគោលលទ្ធិរបស់គាត់ច្បាស់, គាត់នឹងលើកតម្កើងសិរីរុងរឿងនៃក្រឹត្យវិន័យរបស់ព្រះអម្ចាស់.
39:13 ការចងចាំរបស់គាត់នឹងមិនរលាយបាត់ឡើយ, គេនឹងស្វែងរកព្រះនាមរបស់ព្រះអង្គពីមួយជំនាន់ទៅមួយជំនាន់.
39:15 ខណៈពេលដែលគាត់នៅសល់, គាត់ទុកឈ្មោះមួយធំជាងមួយពាន់, ហើយនៅពេលដែលគាត់នឹងសម្រាក, វានឹងមានប្រយោជន៍ដល់គាត់.
ត្បិតខ្ញុំបានពេញដោយតណ្ហា.
អ្នកនឹងបង្កើតផល, ដូចជាផ្កាកុលាបដែលដុះនៅក្បែរទឹកហូរ.
39:19 ផ្កាជាមួយផ្កា, ដូចជាផ្កាលីលី, និងសាយភាយក្លិនក្រអូប, និងពន្លកស្លឹកនៅក្នុងព្រះគុណ, និងការសរសើរជាមួយ canticles, ហើយលើកតម្កើងព្រះអម្ចាស់នៅក្នុងស្នាដៃរបស់គាត់.
ហើយនៅក្នុងការសរសើរគាត់, អ្នកនឹងសារភាព:
39:23 ព្រោះច្បាប់នេះបាន ធ្វើឲ្យ គាប់ព្រះហឫទ័យព្រះ, ហើយសេចក្ដីសង្គ្រោះរបស់គាត់ក៏មិនដែលធ្លាក់ចុះដែរ.
39:25 ការក្រឡេកមើលរបស់គាត់គឺពីអស់កល្បជានិច្ច, គ្មានអ្វីដែលគួរអោយឆ្ងល់ឡើយចំពោះព្រះនេត្ររបស់ព្រះអង្គ.
39:29 តាមរបៀបដែលគាត់បានប្រែក្លាយទឹកទៅជាដីស្ងួត, ហើយធ្វើអោយផែនដីស្ងួត, ហើយដូចជាផ្លូវរបស់គាត់ត្រូវបានដឹកនាំសម្រាប់ការធ្វើដំណើររបស់ពួកគេ, មនុស្សមានបាបក៏នឹងជំពប់ដួលនៅចំពោះព្រះពិរោធរបស់ព្រះអង្គដែរ.
39:33 មានវិញ្ញាណដែលត្រូវបានបង្កើតឡើងសម្រាប់ការសងសឹក, ហើយពួកគេពង្រឹងការធ្វើទារុណកម្មដោយកំហឹងរបស់ពួកគេ.
39:36 ធ្មេញរបស់សត្វព្រៃ, និងខ្យាដំរី, និងពស់, លំពែង: ទាំងអស់នេះសងសឹកនឹងមនុស្សខ្ជិលច្រអូស, ការបំផ្លាញទាំងស្រុង.
ហើយពួកគេនឹងត្រូវបានរៀបចំនៅលើផែនដីរហូតដល់ពួកគេត្រូវការ.
39:38 សម្រាប់ ហេតុផល នេះ, តាំងពីដំបូង, ខ្ញុំត្រូវបានពង្រឹង, ហើយខ្ញុំបានធ្វើសមាធិ, ហើយខ្ញុំបានពិចារណា, ហើយខ្ញុំបានសរសេររឿងទាំងនេះជាលាយលក្ខណ៍អក្សរ.
40:2 គំនិតរបស់ពួកគេ, និងការភ័យខ្លាចនៃចិត្តរបស់ពួកគេ, ការរំពឹងទុករបស់ពួកគេ, និងថ្ងៃនៃការបញ្ចប់របស់ពួកគេ,
40:4 ពីព្រះអង្គដែលស្លៀកពាក់ហឹបនិងគ្រងមកុដ, សូម្បីតែគាត់ដែលត្រូវបានគ្របដោយក្រណាត់ទេសឯក: កំហឹង, ការច្រណែន, ច្របូកច្របល់, ភាពមិនស្រួល, និងការភ័យខ្លាចនៃការស្លាប់, កំហឹងនិងការឈ្លោះប្រកែកឥតឈប់ឈរ.
នៅក្នុងពេលវេលានៃការសង្គ្រោះរបស់គាត់, គាត់ក្រោកឡើងងឿងឆ្ងល់ដោយគ្មានភ័យខ្លាច.
40:11 អ្វីៗទាំងអស់នៅលើផែនដីនឹងវិលត្រឡប់មកផែនដីវិញ, ហើយទឹកទាំងអស់នឹងត្រលប់ទៅសមុទ្រវិញ.
40:13 ខ្លឹមសាររបស់មនុស្សទុច្ចរិតនឹងរីងស្ងួតដូចទឹកទន្លេ, គេនឹងលាន់ noise ដូចរន្ទះយ៉ាងខ្លាំងដូចព្យុះផ្គរ.
40:16 ស្មៅ, ដែលដុះនៅខាងលើទឹកនិងនៅក្បែរច្រាំងទន្លេ, នឹងត្រូវដកចេញពីលើស្មៅទាំងអស់.
40:18 ជីវិតកម្មករ, នៅពេលមាតិកាជាមួយអ្វីដែលគ្រប់គ្រាន់, នឹងក្លាយជាផ្អែម, ហើយនៅក្នុងនោះអ្នកនឹងរកឃើញកំណប់ទ្រព្យមួយ.
40:20 ស្រានិងតន្ត្រីរីករាយដល់បេះដូង, រីឯការស្រឡាញ់ប្រាជ្ញាស្ថិតនៅលើគេទាំងពីរ.
40:22 ភ្នែករបស់អ្នកចង់បានភាពឆើតឆាយនិងសម្រស់, ប៉ុន្តែវាលស្រែគឺខ្ពស់ជាងរបស់ទាំងនេះ.
40:24 បងប្អូនគឺជាជំនួយនៅពេលមានទុក្ខលំបាក, ប៉ុន្តែសេចក្តីមេត្តាករុណានឹងរំដោះ, ច្រើនជាងអ្វីដែលពួកគេចង់បាន.
40:26 សមត្ថភាពនិងកម្លាំងលើកបេះដូងឡើង, ការកោតខ្លាចព្រះអម្ចាស់ស្ថិតនៅលើអ្វីៗទាំងអស់នេះ.
40:28 ការកោតខ្លាចព្រះអម្ចាស់ប្រៀបដូចជាឋានសួគ៌នៃព្រះពរ, ពួកគេបានគ្របបាំងពីលើសិរីរុងរឿងរបស់ព្រះអង្គ.
40:30 ជីវិតរបស់គាត់ដែលមើលទៅតុរបស់បុរសម្នាក់ផ្សេងទៀតមិនគួរត្រូវបានគិតថាជាផ្លូវជីវិតទេ.
40:31 ប៉ុន្តែបុរសដែលមានវិន័យនិងចេះដឹងខ្ពស់នឹងថែរក្សាខ្លួនឯង.
: ចំពោះបុរសដែលមានសន្ដិភាពនៅក្នុងខ្លួន, 41:2 ទៅបុរសស្ងាត់, ហើយចំពោះអ្នកណាដែលមានមាគ៌ាត្រឹមត្រូវក្នុងគ្រប់ការទាំងអស់, ហើយអ្នកណានៅតែមានកម្លាំងដើម្បីទទួលបានជីវជាតិ.
41:4 ដែលបរាជ័យដោយសារអាយុចាស់, ហើយអ្នកណាខ្វល់ខ្វាយអំពីរឿងទាំងអស់, ហើយចំពោះបុរសដែលមិនជឿដែលបាត់បង់ការអត់ធ្មត់.
ចងចាំរឿងដែលបានកើតឡើងមុនអ្នក, និងរឿងដែលនឹងកើតឡើងបន្ទាប់ពីអ្នក.
41:6 ហើយអ្វីដែលនឹងកើតឡើងចំពោះអ្នកគឺគាប់ព្រះហឫទ័យព្រះដ៏ខ្ពង់ខ្ពស់បំផុត, ថាតើនៅក្នុងដប់, ឬមួយរយ, ឬមួយពាន់ឆ្នាំ.
41:10 កូនប្រុសរបស់ឪពុកដែលមិនចេះអត់ធ្មត់នឹងត្អូញត្អែរ, ព្រោះពួកគេអាម៉ាស់មុខព្រោះតែព្រះអង្គ.
41:16 ជីវិតល្អមានចំនួនថ្ងៃ, តែឈ្មោះល្អនឹងនៅស្ថិតស្ថេរជារៀងរហូត.
ចំពោះការប្រើអ្វីដែលមាននៅក្នុងប្រាជ្ញាទាំងលាក់កំបាំង, ឬកំណប់ទ្រព្យដែលមិនបានរកឃើញ?
ហើយអ្វីៗទាំងអស់មិនផ្គាប់ចិត្តមនុស្សទាំងអស់តាមជំនឿរបស់ពួកគេទេ.
41:22 អំពីឧក្រិដ្ឋកម្មនៅចំពោះមុខអ្នកគ្រប់គ្រងឬចៅក្រម, នៃអំពើទុច្ចរិតនៅមុខក្រុមជំនុំឬប្រជាជន,
41:26 អ្នកមិនគួរចៀសវាងមុខរបស់អ្នកពីអ្នកជិតខាងឡើយ, អ្នកក៏មិនត្រូវយកចំណែករបស់អ្នកដែរហើយកុំយកវាមកវិញ.
41:28 ជៀសវាងការនិយាយស្តីបន្ទោសចំពោះមិត្តភក្តិ, ហើយពេលណាអ្នកអោយ, អ្នកមិនគួរស្តីបន្ទោស.
42:1 អ្នកមិនគួរធ្វើម្តងទៀតនូវពាក្យបណ្តឹងដែលបាន heard ពីការបង្ហាញពាក្យដែលលាក់.
អ្នកមិនគួរទទួលយកកេរ្តិ៍ឈ្មោះរបស់នរណាម្នាក់ឡើយ, ដូច្នេះអ្នកនឹងធ្វើបាប, ហើយអ្នកក៏មិនគួរត្រូវបានបំភាន់នៅក្នុងរឿងណាមួយដូចខាងក្រោមដែរ:
42:3 នៅក្នុងពាក្យមួយក្នុងចំណោមដៃគូនិងអ្នករួមដំណើរជាមួយ, ឬដោយចែកចាយមរតករបស់មិត្តភក្តិ;
42:5 ដោយអំពើពុករលួយនៃការទិញនិងចរចា, ឬនៅក្នុងវិន័យគ្រប់គ្រាន់របស់កុមារ, ឬក្នុងការធ្វើឱ្យអ្នកបំរើអាក្រក់ត្រូវបង្ហូរឈាម.
42:7 កន្លែងដែលមានដៃច្រើន, បិទត្រានិងប្រគល់របស់ទាំងអស់តាមលេខនិងទម្ងន់; និងពិតប្រាកដ, ផ្តល់ឱ្យនិងទទួលបានអ្វីគ្រប់យ៉ាងនៅក្នុងការសរសេរ.
សម្រាប់ប្រហែលជា, ក្នុងវ័យជំទង់របស់នាង, នាងអាចនឹងត្រូវគេនាំចូលពេញវ័យ.
42:10 នៅក្នុងព្រហ្មចារីរបស់នាង, នាងអាចនឹងត្រូវស្មោកគ្រោក, ហើយបន្ទាប់មកនាងអាចត្រូវបានគេរកឃើញថាកំពុងមានផ្ទៃពោះនៅក្នុងផ្ទះឪពុករបស់នាង.
42:11 រក្សាការឃ្លាំមើលយ៉ាងដិតដល់លើកូនស្រីដែលចេះរកស៊ីដោយខ្លួនឯង.
42:12 នាងមិនគួរជ្រើសរើសសំលឹងមើលសម្រស់បុរសគ្រប់រូបនោះទេ, ហើយនាងមិនគួរជ្រើសរើសចំណាយពេលវេលារបស់នាងនៅកណ្តាលស្ត្រីដែលរៀបការនោះទេ.
42:14 អំពើទុច្ចរិតចំពោះបុរសគឺប្រសើរសម្រាប់នាងជាងស្ត្រីដែលរៀបការហើយ, ស្វែងរកប្រយោជន៍ដល់នាង, ផ្ទុយទៅវិញនាំនាងអោយវង្វេងស្មារតីនិងអាម៉ាស់មុខ.
ព្រះបន្ទូលរបស់ព្រះអម្ចាស់ស្ថិតនៅក្នុងកិច្ចការរបស់ព្រះអង្គ.
42:17 តើព្រះអម្ចាស់មិនបានធ្វើឱ្យពួកបរិសុទ្ធពិពណ៌នាអំពីអព្ភូតហេតុទាំងអស់របស់គាត់ទេ, ដែលព្រះអម្ចាស់ដ៏មានឫទ្ធានុភាពខ្លាំងក្លាបំផុតបានសំដែងសិរីរុងរឿងនិងសិរីរុងរឿងរបស់ព្រះអង្គ?
42:20 គ្មានគំនិតណាមួយឆ្លងកាត់គាត់ដោយមិនកត់សម្គាល់ទេ, ហើយគ្មានពាក្យណាអាចលាក់បាំងខ្លួនពីគាត់បានទេ.
គាត់គឺនៅមុនភាពអស់កល្បនិងសូម្បីតែអស់កល្បជានិច្ច.
42:24 ស្នាដៃទាំងអស់នេះមាន, ហើយពួកគេស្ថិតនៅក្នុងសម័យបច្ចុប្បន្ន, ហើយពួកគេទាំងអស់គ្នាស្ដាប់បង្គាប់លោកក្នុងគ្រប់គោលបំណង.
43:2 ព្រះអាទិត្យ, នៅរូបរាងរបស់វា, ប្រកាសដំណើររបស់វា; វាគឺជាឧបករណ៍នៃភាពអស្ចារ្យ, ជាស្នាដៃរបស់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុត.
ហើយនៅក្នុងវត្តមាននៃកំដៅរបស់វា, ដែលនឹងអាចស៊ូទ្រាំបាន?
43:4 តាមបីវិធី, ព្រះអាទិត្យដើរតួ: ឡើងភ្នំ, បញ្ចេញកាំរស្មីដ៏កាចសាហាវ, និងចាំងដោយធ្នឹមរបស់វាដែលអាចធ្វើឱ្យភ្នែកខ្វាក់.
43:8 មួយខែត្រូវបានដាក់ឈ្មោះតាមដំណាក់កាលរបស់វា, កាន់តែអស្ចារ្យឡើង ៗ នៅចំណុចកំពូលរបស់វា.
43:10 សិរីរុងរឿងរបស់ផ្កាយគឺសម្រស់នៅលើមេឃ; ព្រះអម្ចាស់បំភ្លឺពិភពលោកពីស្ថានលើ.
43:12 ពិចារណាឥន្ធនូ, ហើយជូនពរដល់អ្នកដែលបង្កើតវា; វាគឺស្រស់ស្អាតខ្លាំងណាស់នៅក្នុងភាពរុងរឿងរបស់វា.
43:14 តាមបញ្ជារបស់គាត់, គាត់ពន្លឿនព្រិល, ហើយគាត់ផ្លេកបន្ទោរដើម្បីសំដែងការវិនិច្ឆ័យរបស់គាត់.
43:16 ដោយភាពអស្ចារ្យរបស់គាត់, គាត់បានដាក់ពពក, ហើយព្យុះព្រឹលបានបាក់ហើយ.
43:18 សំឡេងផ្គរលាន់របស់លោកនឹងverសូរពេញផែនដី, ដោយព្យុះពីភាគខាងជើង, និងដោយការប្រមូលផ្តុំនៃខ្យល់កួច.
43:20 ភ្នែកគឺឆ្ងល់ពីភាពស្រស់ស្អាតនៃពណ៌សរបស់វា, ហើយចិត្តក៏ស្រឡាំងកាំងពេលធ្លាក់.
ហើយនៅពេលវាបង្កក, វានឹងក្លាយទៅជាកំពូលនៃបន្លា.
43:23 ហើយវានឹងលេបត្របាក់ភ្នំ, និងដុតវាលរហោស្ថាន, និងពន្លត់បៃតង, ដូចជាភ្លើង.
ហើយទឹកសន្សើមទាបនឹងមកដល់ដើម្បីទទួលបានកំដៅហើយយកឈ្នះវា.
43:26 សូមឱ្យអ្នកដែលធ្វើដំណើរតាមសមុទ្រពិពណ៌នាអំពីគ្រោះថ្នាក់របស់វា.
43:27 មានស្នាដៃអស្ចារ្យនិងអស្ចារ្យ: សត្វព្រៃជាច្រើនប្រភេទ, និងសត្វគោគ្រប់ប្រភេទ, និងសត្វដ៏អស្ចារ្យនៃសមុទ្រ.
43:31 ព្រះអម្ចាស់គួរអោយខ្លាចណាស់, និងអស្ចារ្យណាស់, និងអំណាចរបស់គាត់គឺអស្ចារ្យ.
ប៉ុន្តែគាត់គឺលើសពីការសរសើរទាំងអស់.
43:37 ប៉ុន្តែព្រះអម្ចាស់បានបង្កើតអ្វីៗទាំងអស់, ព្រះអង្គបានប្រទានប្រាជ្ញាដល់អស់អ្នកដែលប្រព្រឹត្ដដោយការគោរព.
44:2 ព្រះអម្ចាស់បានសំដែងសិរីរុងរឿងដ៏អស្ចារ្យ, ដោយភាពអស្ចារ្យផ្ទាល់ខ្លួនរបស់គាត់, ពីសម័យបុរាណ.
មានអ្នកដែលប្រកាសក្នុងចំណោមព្យាការី, ដោយសេចក្តីថ្លៃថ្នូររបស់ពួកហោរា.
44:5 មានអ្នកដែល, ដោយជំនាញរបស់ពួកគេ, តែងបទភ្លេងតន្រ្តី, ដើម្បីកំណត់ខគម្ពីរបទចំរៀង.
44:7 ទាំងអស់នេះបានទទួលសិរីរុងរឿងនៅជំនាន់របស់ពួកគេ, ហើយពួកគេបានសរសើរនៅសម័យរបស់ពួកគេ.
44:10 ប៉ុន្តែបុរសទាំងនេះគឺជាបុរសដែលមានមេត្តាករុណា, ការប្រព្រឹត្ដដ៏ថោកទាបរបស់គេមិនដែលខកខានឡើយ.
44:12 កូនចៅរបស់ពួកគេគឺជាមរតកដ៏បរិសុទ្ធ, ហើយកូនចៅរបស់ពួកគេឈរយ៉ាងរឹងមាំនៅក្នុងសេចក្ដីសញ្ញា.
កូនចៅនិងសិរីរុងរឿងរបស់ពួកគេនឹងមិនត្រូវបោះបង់ចោលឡើយ.
44:15 សូមឱ្យប្រជាជនប្រកាសពីប្រាជ្ញារបស់ពួកគេ, ហើយអនុញ្ញាតឱ្យសាសនាចក្រប្រកាសការសរសើររបស់ពួកគេ.
44:19 សេចក្ដីសញ្ញានៃពិភពលោកត្រូវបានដាក់ជាមួយគាត់, ដូច្នេះមនុស្សទាំងអស់នឹងមិនត្រូវបំផ្លាញដោយទឹកជំនន់ដ៏ធំឡើយ.
44:22 ដូច្នេះ, ដោយសម្បថ, ព្រះអង្គលើកតម្កើងសិរីរុងរឿងរបស់ព្រះអង្គក្នុងចំណោមប្រជាជន, ដើម្បីធ្វើឱ្យគាត់កើនឡើងដូចធូលីដី,
44:26 គាត់បានទទួលស្គាល់គាត់នៅក្នុងពរជ័យរបស់គាត់, គាត់បានចែកមត៌កអោយគាត់, ហើយគាត់ចែកកុលសម្ព័ន្ធទាំងដប់ពីរអោយគាត់.
45:3 ព្រះអង្គលើកតម្កើងព្រះអង្គនៅចំពោះមុខស្តេចនានា, ហើយគាត់បានចេញបទបញ្ជាដល់គាត់នៅចំពោះមុខប្រជាជនរបស់គាត់, ព្រះអង្គសំដែងសិរីរុងរឿងរបស់ព្រះអង្គអោយគេឃើញ.
45:7 លោកលើកតម្កើងលោកអើរ៉ុនជាបងនិងអ្នកដែលស្រដៀងនឹងគាត់ក្នុងកុល សម្ព័ន្ធលេវី.
45:9 ហើយគាត់បានព័ទ្ធជុំវិញគាត់ដោយខ្សែក្រវាត់ដ៏រុងរឿង, លោកពាក់អាវវែងប្រកបដោយសិរីរុងរឿងរបស់លោក, ហើយគាត់បានបំពាក់មកុដដ៏ថ្លៃថ្នូដល់គាត់.
45:11 ដូច្នេះវានឹងមានសម្លេងនៅពេលមកដល់, និងដើម្បីធ្វើឱ្យសំលេងរំខានដែលនឹងត្រូវបានឮនៅក្នុងព្រះវិហារមួយ, ទុកជាអនុស្សាវរីយ៍សំរាប់កូន ៗ របស់ប្រជារាស្ត្ររបស់ព្រះអង្គ.
45:13 ការងាររបស់កន្ត្រាក់រមួល, ការងាររបស់សិល្បករម្នាក់, ជាមួយត្បូងដ៏មានតម្លៃ, កាត់និងកំណត់ជាមាស, និងឆ្លាក់ដោយស្នាដៃគ្រឿងអលង្ការមួយ, ទុកជាអនុស្សាវរីយ៍ស្របតាមចំនួនកុលសម្ព័ន្ធរបស់អ៊ីស្រាអែល.
នេះគឺជាការងារប្រកបដោយគុណធម៌និងជាទីរីករាយចំពោះភ្នែកនៅក្នុងសម្រស់.
45:16 មិនមានជនបរទេសណាម្នាក់ស្លៀកសម្លៀកបំពាក់ទាំងនេះទេ, មានតែកូនប្រុសនិងកូនចៅរបស់គាត់ប៉ុណ្ណោះ, សម្រាប់គ្រប់ពេលវេលា.
45:18 លោកម៉ូសេបានដាក់ដៃលើលោកហើយចាក់ប្រេងអភិសេកគាត់.
45:20 គាត់បានជ្រើសរើសគាត់ពីក្នុងចំណោមបុរសដែលមានជីវិតដើម្បីថ្វាយយញ្ញបូជាដល់ព្រះជាម្ចាស់, ធូប, និងក្លិនក្រអូបគួរឱ្យចង់សើច, ជាអនុស្សាវរីយ៍នៃការអំពាវនាវជំនួសប្រជាជនរបស់លោក.
45:22 ពេលនោះមានជនចម្លែកមកគាល់ព្រះអង្គ, និង, ដោយសារតែការច្រណែន, ពួកបុរសដែលនៅជាមួយលោកដាថាននិងលោកអប៊ីរ៉ាមឡោមព័ទ្ធគាត់នៅវាលរហោស្ថាន, រួមជាមួយក្រុមជំនុំកូរេ, នៅក្នុងកំហឹងរបស់ពួកគេ.
45:24 គាត់បានធ្វើកិច្ចការដ៏អស្ចារ្យក្នុងចំណោមពួកគេ, ព្រះអង្គបានដុតពួកគេដោយអណ្តាតភ្លើង.
45:26 គាត់បានរៀបចំនំប៉័ងល្អបំផុតដល់ពួកគេ.
45:27 ប៉ុន្តែគាត់នឹងមិនទទួលមត៌កក្នុងចំណោមប្រជាជនក្នុងស្រុកទេ, ហើយគាត់មិនមានចំណែកនៅក្នុងចំណោមប្រជាជន.
ដោយភាពល្អនិងការឆ្លើយតបនៃព្រលឹងរបស់គាត់, គាត់បានគាប់ព្រះហឫទ័យព្រះជាម្ចាស់ជំនួសជនជាតិអ៊ីស្រាអែល.
45:31 ហើយគាត់បានធ្វើកិច្ចព្រមព្រៀងជាមួយស្តេចដាវីឌ, ជាកូនរបស់អ៊ីសាយមកពីកុលសម្ព័ន្ធយូដា, មរតកសម្រាប់គាត់និងកូនចៅរបស់គាត់, ដូច្នេះព្រះអង្គនឹងប្រទានអោយយើងមានប្រាជ្ញា, ដើម្បីវិនិច្ឆ័យទោសប្រជារាស្ត្ររបស់ព្រះអង្គដោយយុត្តិធម៌, ក្រែងលោអ្វីៗល្អ ៗ របស់គេត្រូវរលាយសូន្យទៅ.
គាត់ពូកែសមនឹងឈ្មោះរបស់គាត់,
គាត់បានប្រយុទ្ធប្រឆាំងនឹងសត្រូវបះបោរ, ដូច្នេះគាត់នឹងទទួលមត៌កអ៊ីស្រាអែល.
ព្រះដ៏ឧត្តុង្គឧត្ដមនិងព្រះដ៏វិសុទ្ធបានឆ្លើយតបមកលោកដោយមានព្រឹលខ្លាំង.
46:8 ដូច្នេះប្រជាជាតិនានានឹងទទួលស្គាល់អំណាចរបស់ព្រះអង្គ: វាមិនមែនជាការងាយស្រួលទេក្នុងការប្រយុទ្ធប្រឆាំងនឹងព្រះ.
46:10 ហើយទាំងពីរនេះ, ត្រូវបានតែងតាំង, ត្រូវបានដោះលែងពីគ្រោះថ្នាក់, ពីទាហានជើងមានចំនួនប្រាំមួយរយពាន់នាក់, ដើម្បីនាំពួកគេចូលទៅកាន់មត៌ករបស់គេ, ចូលទៅក្នុងដែនដីដែលមានទឹកដោះគោនិងទឹកឃ្មុំ.
46:12 នេះគឺដើម្បី ឲ្យ ជនជាតិអ៊ីស្រាអែលទាំងអស់យល់ថាការស្តាប់បង្គាប់ព្រះដ៏បរិសុទ្ធជាការប្រសើរ.
ពួកគេមិនបានងាកចេញពីព្រះអម្ចាស់ទេ,
46:15 ហើយឈ្មោះរបស់ពួកគេនឹងនៅស្ថិតស្ថេរជារៀងរហូត, បន្តនៅក្នុងកូនប្រុសរបស់ពួកគេ, បុរសដ៏រុងរឿងនៃសិរីល្អ.
ដ្បិតគាត់បានឃើញព្រះជាម្ចាស់នៃពន្លឺ.
46:20 ហើយព្រះអម្ចាស់ផ្គរលាន់ពីលើមេឃ, ហើយជាមួយនឹងសំលេងខ្លាំង, គាត់បានបង្កើតសំលេងរបស់គាត់.
46:22 ហើយមុនពេលចុងបញ្ចប់នៃជីវិតរបស់គាត់នៅលើពិភពលោក, លោកបានផ្ដល់សក្ខីភាពនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់និងអំពីព្រះគ្រិស្ដរបស់ព្រះអង្គ, គាត់មិនបានយកសំណូកពីសាច់ណាមួយទេ, មិនមែនសូម្បីតែស្បែកជើងទេ, ហើយគ្មាននរណាម្នាក់ចោទប្រកាន់គាត់ឡើយ.
ព្រះ រាជាបានធ្វើ ឲ្យ ព្រះ មហា ក្សត្រដឹងហើយសម្តែង ឲ្យ លោកដឹងអំពីទីបញ្ចប់នៃជីវិត.
សៀរ៉ា 47 47:1 បន្ទាប់ពីរឿងទាំងនេះ, ព្យាការីណាថានបានក្រោកឡើង, នៅជំនាន់ដាវីឌ.
47:3 គាត់លេងជាមួយតោ, ដូចជាប្រសិនបើជាមួយសាច់ចៀម, ហើយគាត់បានធ្វើស្រដៀងនឹងខ្លាឃ្មុំ, ដូចជាពួកគេគឺជាកូនចៀមនៃហ្វូងចៀម, ក្នុងយុវវ័យរបស់គាត់.
47:7 ដូច្នេះគាត់លើកតម្កើងគាត់ក្នុងចំណោមមនុស្សមួយម៉ឺននាក់, ហើយគាត់បានសរសើរគាត់ជាមួយនឹងពរជ័យរបស់ព្រះអម្ចាស់, ដោយជូនមកុដនៃសិរីរុងរឿងរបស់ព្រះអង្គ.
លោកបានបំបាក់ស្នែងរបស់ពួកគេ, សូម្បីតែសម្រាប់គ្រប់ពេលវេលា.
47:10 ដោយអស់ពីដួងចិត្តរបស់គាត់, គាត់សរសើរតម្កើងព្រះអម្ចាស់ហើយគាត់ស្រឡាញ់ព្រះជាម្ចាស់, ដែលបានធ្វើឱ្យគាត់និងដែលបានផ្ដល់ឱ្យគាត់នូវអំណាចប្រឆាំងនឹងសត្រូវរបស់គាត់.
47:12 ហើយគាត់បានផ្តល់ភាពស្រស់ស្អាតសម្រាប់ការប្រារព្ធពិធី, លោកក៏បញ្ជាអោយគេធ្វើតាមពេលកំណត់, សូម្បីតែរហូតដល់ចុងបញ្ចប់នៃជីវិតរបស់គាត់, ដូច្នេះពួកគេនឹងលើកតម្កើងព្រះនាមដ៏វិសុទ្ធរបស់ព្រះអម្ចាស់, ហើយលើកតម្កើងភាពបរិសុទ្ធរបស់ព្រះជាម្ចាស់, តាំងពីព្រឹកព្រលឹម.
ហើយគាត់បានធ្វើឱ្យគាត់នូវកិច្ចព្រមព្រៀងនៃនគរ, និងបល្ល័ង្កនៃសិរីរុងរឿងនៅស្រុកអ៊ីស្រាអែល.
47:17 ហើយអ្នកបានពន្យល់អាថ៌កំបាំងដោយប្រើឧទាហរណ៍.
47:18 ផែនដីបានងឿងឆ្ងល់ខ្លាំងណាស់ចំពោះអណ្ដាតរបស់អ្នក, សុភាសិត, និងប្រើប្រស្នា, និងការបកស្រាយ,
47:20 អ្នកប្រមូលមាសដូចជាស្ពាន់, ហើយអ្នកបានកើនប្រាក់ដូចសំណ.
47:22 អ្នកបាននាំមកនូវស្នាមប្រឡាក់លើសិរីរុងរឿងរបស់អ្នក, ហើយអ្នកបានបំបាក់ពូជអ្នក, ដើម្បីធ្វើឱ្យកូនរបស់អ្នកខឹង, និងដើម្បីញុះញង់ភាពល្ងីល្ងើរបស់អ្នក,
គេនឹងមិនបំផ្លាញពូជពង្សរបស់អ្នកដែលស្រឡាញ់ព្រះអម្ចាស់ឡើយ.
47:28 ទាំងរេហូបោម, ដែលមានការប្រុងប្រយ័ត្នតិចតួច, ហើយអ្នកណាបានបំបាក់មុខប្រជាជនដោយការប្រឹក្សារបស់គាត់,
47:31 ហើយពួកគេបានស្វែងរកអំពើអាក្រក់គ្រប់ប្រភេទ, សូម្បីតែរហូតដល់ការដាក់ទណ្ឌកម្មលើពួកគេ, និងដោះលែងពួកគេពីអំពើបាបគ្រប់ប្រភេទ.
48:1 ហើយព្យាការីអេលីយ៉ាបានក្រោកឡើងដូចជាភ្លើង, ហើយពាក្យរបស់គាត់បានឆេះដូចជាពិល.
ព្រោះពួកគេមិនអាចកាន់តាមក្រិត្យវិន័យរបស់ព្រះអម្ចាស់បានឡើយ.
48:4 តាមវិធីនេះ, អេលីយ៉ាត្រូវបានលើកតម្កើងដោយស្នាដៃអស្ចារ្យរបស់គាត់.
48:7 គាត់បានស្តាប់ការវិនិច្ឆ័យនៅស៊ីណៃ, និងសាលក្រមនៃការដាក់ទណ្ឌកម្មនៅហូរេប.
48:9 គាត់ត្រូវបានគេទទួលចូលទៅក្នុងខ្យល់គួច, ចូលទៅក្នុងរទេះសេះយ៉ាងលឿនដោយមានសេះយ៉ាងខ្លាំង.
48:11 មានពរហើយអស់អ្នកដែលបានឃើញអ្នក, និងអ្នកដែលត្រូវបានតុបតែងដោយមិត្តភាពរបស់អ្នក.
48:13 ពិតប្រាកដណាស់, អេលីយ៉ាត្រូវបានគ្របដណ្ដប់ដោយខ្យល់កួច, វិញ្ញាណរបស់លោកបានសំរេចសព្វគ្រប់នៅអេលីសេ.
48:14 គ្មានពាក្យអ្វីមករំខានគាត់ឡើយ, ហើយបន្ទាប់ពីការស្លាប់, រាងកាយរបស់គាត់បានព្យាករណ៍.
48:16 នៅក្នុងរបស់ទាំងអស់នេះ, ប្រជាជនមិនបានប្រែចិត្ត, ហើយពួកគេមិនបានដកខ្លួនចេញពីអំពើបាបរបស់ពួកគេឡើយ, រហូតដល់ពួកគេត្រូវបានគេបណ្តេញចេញពីទឹកដីរបស់ពួកគេ, ហើយគេខ្ចាត់ខ្ចាយពាសពេញលើផែនដី.
48:19 ហេសេគាពង្រឹងទីក្រុងរបស់គាត់, ហើយលោកបាននាំទឹកចូលទៅក្នុងនោះ, ហើយគាត់បានជីកថ្មដោយដែក, ហើយគាត់បានសង់អណ្តូងទឹក.
ហើយព្រះដ៏បរិសុទ្ធជាព្រះបានស្តាប់តាមសំលេងរបស់ពួកគេភ្លាមៗ.
ជំនួស, ព្រះអង្គបានជំរះពួកគេដោយដៃរបស់លោកអេសាយ, ជាហោរាដ៏បរិសុទ្ធ.
48:25 ព្រោះហេសេគាបានធ្វើអ្វីដែលគាប់ព្រះហឫទ័យព្រះ, ព្រះ បាទដាវីឌមានជ័យ ជំនះដូចព្រះ បាទដាវីឌជាបិតា, ដូចលោកអេសាយបានបង្គាប់, ព្យាការីដ៏អស្ចារ្យនិងស្មោះត្រង់នៅចំពោះព្រះភ័ក្ត្រព្រះជាម្ចាស់.
48:28 គាត់បានបង្ហាញពីអនាគត, សូម្បីតែអនាគតឆ្ងាយ, និងការលាក់បាំងមុនពេលដែលពួកគេបានកើតឡើង.
49:1 ការចងចាំរបស់យ៉ូសៀសគឺដូចជាការលាយបញ្ចូលគ្នានៃក្លិនក្រអូបដែលផ្សំដោយស្នាដៃរបស់ទឹកអប់.
49:3 គាត់ត្រូវបានដឹកនាំដោយព្រះសម្រាប់ការប្រែចិត្តរបស់ជាតិ, ហើយគាត់បានយកចេញពីភាពគួរស្អប់ខ្ពើមនៃការមិនសប្បាយចិត្ត.
49:6 ស្តេចស្រុកយូដាបោះបង់ចោលក្រឹត្យវិន័យរបស់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុត, ហើយពួកគេបានមើលងាយចំពោះការកោតខ្លាចដល់ព្រះ.
49:8 ពួកគេបានដុតបំផ្លាញទីក្រុងដែលបានជ្រើសរើស, ហើយពួកគេបានធ្វើឱ្យផ្លូវរបស់ពួកគេក្លាយទៅជាទីស្ងាត់ជ្រងំ, ស្របតាមដៃរបស់យេរេមា.
49:10 វាគឺជាអេសេគាលដែលបានឃើញចក្ខុវិស័យនៃសិរីរុងរឿង, ព្រះអង្គបានបង្ហាញអោយគាត់ឃើញរទេះសេះជាមួយរទេះរបស់ចេរូប៊ីម.
49:12 ហើយសូមអោយឆ្អឹងរបស់ព្យាការីទាំងដប់ពីររូបឡើងពីកន្លែងរបស់គេទៅ.
49:14 លោកយេស៊ូក៏ដូច្នោះដែរ, កូនប្រុសរបស់យ៉ូសដាដ, ពួកគេបានសង់ផ្ទះនៅជំនាន់របស់ពួកគេ, ហើយដំឡើងព្រះវិហារដ៏វិសុទ្ធថ្វាយព្រះអម្ចាស់, ជាការរៀបចំសំរាប់សិរីល្អអស់កល្បជានិច្ច.
គាត់បានលើកផ្ទះរបស់យើងឡើង.
ហើយគាត់ក៏ត្រូវបានយកចេញពីផែនដីដែរ.
49:18 ហើយឆ្អឹងរបស់គាត់ត្រូវបានទៅលេង, ហើយបន្ទាប់ពីការស្លាប់, ពួកគេបានទាយ.
ហើយលើសពីព្រលឹងទាំងអស់, តាំងពីដំបូងមក, គឺអាដាម.
50:3 នៅជំនាន់របស់គាត់, ទឹកបានហូរចេញពីអណ្តូង, ហើយអ្វីៗទាំងអស់នេះមានលើសពីរង្វាស់, ដូចជាសមុទ្រ.
50:7 ហើយគាត់បានចាំងចេញនៅក្នុងព្រះវិហារនៃព្រះតាមរបៀបនេះ: ដូចព្រះអាទិត្យពេលវារះចែងចាំង,
50:9 ដូចជាពន្លឺចាំងភ្លឺចាំង, និងដូចជាកំញើញនៅក្នុងភ្លើង,
50:11 គឺដូចជាដើមអូលីវដែលបង្កើតជាពន្លក, ហើយដូចដើមឈើស៊ីបភីដែលលើកខ្លួនវានៅលើខ្ពស់, នៅពេលដែលគាត់បានទទួលអាវផាយនៃសិរីរុងរឿងហើយត្រូវបានបំពាក់ដោយការបំពេញគុណធម៌.
50:13 បន្ទាប់មក, ពេលគាត់ទទួលចំណែកពីក្រុមបូជាចារ្យ, គាត់ឈរនៅក្បែរអាសនៈ.
50:14 ហើយពួកគេឈរនៅជុំវិញគាត់ដូចជាមែកដូង, អ្នកទាំងនោះសុទ្ធតែជាកូនរបស់លោកអើរ៉ុន.
50:17 នៅមូលដ្ឋានអាសនៈ, លោកបានចាក់ប្រេងក្រអូបថ្វាយព្រះដ៏ខ្ពង់ខ្ពស់បំផុត.
50:19 ប្រជាជនទាំងអស់ក៏ប្រញាប់ទៅមុខ, ពួកគេក្រាបចុះដល់ដី, គោរពកោតខ្លាចព្រះអម្ចាស់ជាព្រះរបស់គេ, និងដើម្បីអធិស្ឋានដល់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុត.
50:21 ប្រជាជនបាននាំគ្នាទូលអង្វរព្រះជាម្ចាស់ដ៏ខ្ពង់ខ្ពស់បំផុត, សូម្បីតែកិត្តិយសរបស់ព្រះអម្ចាស់ត្រូវបានបញ្ចប់, ហើយពួកគេបានបញ្ចប់ការផ្តល់អំណោយរបស់ពួកគេ.
50:23 ហើយគាត់បានអធិស្ឋានម្តងហើយម្តងទៀត, ចង់បង្ហាញពីគុណធម៌របស់ព្រះជាម្ចាស់.
50:25 សូមឱ្យគាត់ផ្តល់ឱ្យយើងនូវអំណរនៅក្នុងដួងចិត្ត, សូមអោយមានសេចក្តីសុខសាន្តនៅជំនាន់យើងនេះផង, នៅអ៊ីស្រាអែលសំរាប់ថ្ងៃដែលមិនចេះចប់,
50:29 ព្រះយេស៊ូវ, កូនប្រុសរបស់លោកស្រ៊ីច, នៃក្រុងយេរូសាឡឹម, ជាអ្នកដែលមានប្រាជ្ញាឡើងវិញ, បានសរសេរគោលលទ្ធិនៃប្រាជ្ញានិងវិន័យនៅក្នុងសៀវភៅនេះ.
អ្នកណាដាក់របស់ទាំងនេះក្នុងចិត្តគេនឹងមានប្រាជ្ញាជានិច្ច.
ហើយអ្នកគឺជាអ្នកជួយខ្ញុំនៅចំពោះមុខអ្នកដែលឈរក្បែរនោះ.
51:5 ពីកណ្តាប់ដៃរបស់អស់អ្នកដែលស្វែងរកជីវិតរបស់ខ្ញុំ, ហើយពីទ្វារនៃទុក្ខវេទនាដែលព័ទ្ធជុំវិញខ្ញុំ,
51:7 ពីជម្រៅនៃពោះវៀននរក, ហើយចេញពីអណ្តាតដែលស្មោកគ្រោក, ហើយមកពីពាក្យកុហក, ពីស្តេចទុច្ចរិតមួយ, និងមកពីអណ្តាតអយុត្តិធម៌.
ហើយគ្មាននរណាម្នាក់អាចជួយខ្ញុំបានទេ.
51:11 បន្ទាប់មកខ្ញុំបាននឹកចាំពីសេចក្តីមេត្តាករុណារបស់អ្នក, គាត់គឺជាម្ចាស់, និងស្នាដៃរបស់អ្នក, ដែលមានតាំងពីដំបូងមក.
51:13 ព្រះអង្គបានលើកតម្កើងទីលំនៅរបស់ទូលបង្គំនៅលើផែនដី, ហើយខ្ញុំបានអង្វរថាមរណភាពនឹងកន្លងផុតទៅ.
51:15 ទូលបង្គំនឹងលើកតម្កើងព្រះនាមរបស់ព្រះអង្គឥតឈប់ឈរ, ខ្ញុំនឹងអរព្រះគុណព្រះអង្គដោយអរព្រះគុណ, ព្រោះការអធិស្ឋានរបស់ខ្ញុំត្រូវបានគេយកចិត្តទុកដាក់.
ពីយុវវ័យរបស់ខ្ញុំ, ខ្ញុំដេញតាមនាង.
51:22 ខ្ញុំបានរកឃើញប្រាជ្ញាជាច្រើននៅក្នុងខ្លួនខ្ញុំ, ហើយខ្ញុំទទួលបានអត្ថប្រយោជន៍ច្រើនពីនាង.
51:24 ដ្បិតខ្ញុំសំរេចថាខ្ញុំត្រូវប្រព្រឹត្ដតាមប្រាជ្ញា.
51:27 ខ្ញុំបានដឹកនាំព្រលឹងខ្ញុំឆ្ពោះទៅរកនាង, ហើយខ្ញុំបានរកឃើញនាងនៅក្នុងចំនេះដឹង.
ព្រោះតែ រឿង នេះ, ខ្ញុំនឹងមិនត្រូវបោះបង់ចោលទេ.
ដោយសារតែនាង, ខ្ញុំនឹងកាន់កាប់កម្មសិទ្ធិល្អ.
51:31 ចូលមកជិតខ្ញុំ, អ្នកដែលមិនចេះពិចារណា, ហើយប្រមូលផ្តុំគ្នានៅឯសាលាវិន័យ.
ហើយអ្នកត្រូវនិយាយអ្វីខ្លះអំពីរឿងទាំងនេះ?
51:34 ហើយដាក់ករបស់អ្នកអោយនឹមនាង, និងអនុញ្ញាតឱ្យព្រលឹងរបស់អ្នកទទួលយកវិន័យរបស់នាង.
51:35 មើលដោយផ្ទាល់ភ្នែកពីរបៀបដែលខ្ញុំបានធ្វើការតិចតួច, ហើយបានសម្រាកច្រើនសំរាប់ខ្លួនខ្ញុំផ្ទាល់.
51:38 សំរេចការងាររបស់អ្នកមុនពេលវេលា.
នាងមានផ្ទៃពោះហើយសំរាលបានកូនប្រុសមួយ.
6:1 នៅក្នុងទុក្ខវេទនារបស់ពួកគេ, ពួកគេនឹងក្រោកពីព្រលឹម.
6:3 គាត់នឹងរស់ឡើងវិញបន្ទាប់ពីពីរថ្ងៃ; នៅថ្ងៃទីបីលោកនឹងប្រោសយើងអោយរស់ឡើងវិញ, យើងនឹងរស់នៅចំពោះព្រះភ័ក្ត្រព្រះអង្គ.
កន្លែងចុះចតរបស់គាត់ត្រូវបានរៀបចំដូចជាពន្លឺពេលព្រឹក, ព្រះអង្គនឹងយាងមករកយើងដូចទឹកភ្លៀងនៅចុងរដូវនិងចុងផែនដី.
6:5 ព្រោះតែ រឿង នេះ, ខ្ញុំបានកាត់វាជាមួយពួកហោរា, ខ្ញុំបានសម្លាប់ពួកគេដោយពាក្យសំដីរបស់ខ្ញុំ; ហើយយោបល់របស់អ្នកនឹងបាត់ទៅដូចជាពន្លឺ.
ហើយនិយាយទៅគាត់, “ ដកអំពើទុច្ចរិតទាំងអស់ចេញហើយទទួលយករបស់ល្អ.
14:5 ខ្ញុំនឹងជាសះស្បើយភាពខ្វះខាតរបស់ពួកគេ; ខ្ញុំនឹងស្រឡាញ់ពួកគេដោយឯកឯង.
14:6 ខ្ញុំនឹងដូចជាទឹកសន្សើម; អ៊ីស្រាអែលនឹងរីកដុះដាលដូចផ្កាលីលី, ហើយឫសរបស់វានឹងរីកដូចជាដើមតាត្រៅនៅស្រុកលីបង់.
អនុស្សាវរីយ៍របស់គាត់នឹងដូចជាស្រានៃដើមតាត្រៅនៅស្រុកលីបង់.
?ខ្ញុំនឹងស្តាប់គាត់, ហើយខ្ញុំនឹងធ្វើឱ្យគាត់ត្រង់ដូចជាដើមឈើដែលមានសុខភាពល្អ.
សកម្មភាពរបស់ពួកសាវក 6
3:1 បន្ទាប់មកថូប៊ីសបានដកដង្ហើមធំ, ហើយគាត់បានចាប់ផ្តើមអធិស្ឋានដោយទឹកភ្នែក,
3:3 ហើយ ឥឡូវនេះ, គាត់គឺជាម្ចាស់, ចាំខ្ញុំ, ហើយកុំសងសឹកចំពោះអំពើបាបរបស់ខ្ញុំ, ហើយកុំហៅអោយគិតពីកំហុសរបស់ខ្ញុំ, ហើយឪពុកម្តាយរបស់ខ្ញុំក៏មិនមានដែរ.
ហើយសូមឱ្យគាត់ចូលរួមជាមួយអ្នកទាំងអស់គ្នានៅក្នុងអាពាហ៍ពិពាហ៍និងបំពេញព្រះពររបស់គាត់នៅក្នុងអ្នក” ។
8:4 បន្ទាប់មកថូប៊ីយ៉ាបានដាស់តឿនព្រហ្មចារី, ព្រះយេស៊ូមានព្រះបន្ទូលទៅនាង: “ សារ៉ា, ចូរក្រោកឡើងយើងនាំគ្នាទូលអង្វរព្រះជាម្ចាស់នៅថ្ងៃនេះ, និងថ្ងៃស្អែក, និងនៅថ្ងៃបន្ទាប់.
ហើយ បន្ទាប់ មក, នៅយប់ទីបីបានកន្លងផុតទៅ, យើងនឹងចូលរួមជាមួយគ្នា.
ទំព័រ ដើម / ព្រះគម្ពីរ / ដំណឹងល្អរបស់ម៉ាថាយ
20:27 ឥឡូវសាឌូស៊ីខ្លះ, អ្នកណាបដិសេធមិនទទួលស្គាល់ថាមនុស្សស្លាប់នឹងរស់ឡើងវិញទេ, ចូលទៅជិតគាត់. គេនាំគ្នាទូលសួរព្រះយេស៊ូ,
ប្រាកដណាស់អ្នកទាំង ៧ នាក់មាននាងជាប្រពន្ធ” ។
20:35 នៅឡើយទេ, អ្នកដែលនឹងត្រូវបានសមនឹងអាយុនោះ, និងអំពីការរស់ពីស្លាប់ឡើងវិញ, នឹងមិនត្រូវបានរៀបការ, កុំយកប្រពន្ធ.
សម្រាប់ពួកគេគឺស្មើនឹងទេវតា, ពួកគេជាកូនរបស់ព្រះ, ចាប់តាំងពីពួកគេគឺជាកូនចៅនៃការរស់ឡើងវិញ.
ដំណឹងល្អរបស់លូកា – 2ត្រី
10:25 ហើយវាបានកើតឡើង, នៅពេលដែលពេត្រុសបានចូល, កូនេលាសបានទៅជួបគាត់.
10:35 ប៉ុន្តែនៅក្នុងប្រទេសទាំងអស់, អ្នកណាកោតខ្លាចព្រះអង្គហើយប្រព្រឹត្ដអំពើយុត្ដិធម៌ក៏គាប់ព្រះហឫទ័យព្រះអង្គដែរ.
10:44 ខណៈពេលដែលពេត្រុសកំពុងនិយាយពាក្យទាំងនេះ, ព្រះវិញ្ញាណបរិសុទ្ធបានយាងមកសណ្ឋិតលើអស់អ្នកដែលបានស្តាប់ព្រះបន្ទូល.
10:48 លោកក៏បញ្ជាអោយគេធ្វើពិធីជ្រមុជទឹកក្នុងព្រះនាមព្រះអម្ចាស់យេស៊ូគ្រិស្ដ.
សូមឱ្យដៃរបស់អ្នករឹងមាំ.
ដំណឹងល្អរបស់ម៉ាថាយ
1:2 បន្ទាប់មក, នៅថ្ងៃទីបី, បុរសម្នាក់បានបង្ហាញខ្លួន, មកដល់ជំរំរបស់ព្រះបាទសូល, លោកមានសម្លៀកបំពាក់ហែកហើយធូលីដីប្រោះលើក្បាលលោក.
1:5 លោកដាវីឌមានប្រសាសន៍ទៅកាន់យុវជនដែលនាំដំណឹងមកលោក, ហេតុអ្វីបានជាអ្នកដឹងថាព្រះបាទសូលនិងសម្តេចយ៉ូណាថានបានសោយទិវង្គតទៅ?”
1:7 ហើយងាកក្រោយខ្នងគាត់ហើយឃើញខ្ញុំ, គាត់បានហៅមកខ្ញុំ.
ត្បិតការថប់បារម្ភបានចាប់ខ្ញុំ, ហើយជីវិតរបស់ខ្ញុំទាំងមូលក៏ស្ថិតនៅក្នុងខ្ញុំដែរ។
ព្រោះខ្ញុំដឹងថាគាត់មិនអាចរស់បានទេបន្ទាប់ពីការដួលរលំ.
1:11 បន្ទាប់មកដាវីឌ, ចាប់យកសម្លៀកបំពាក់របស់គាត់, ហែកពួកគេ, ជាមួយបុរសទាំងអស់ដែលនៅជាមួយគាត់.
1:13 លោកដាវីឌមានប្រសាសន៍ទៅកាន់យុវជនដែលបាននាំដំណឹងនេះមកប្រាប់លោក, "តើ អ្នក មកពីណា?ហើយគាត់បានឆ្លើយតប, «ខ្ញុំជាកូនរបស់បុរសម្នាក់ដែលទើបមកដល់ថ្មីពីជនជាតិអាម៉ាលេក»។
1:15 ហើយហៅអ្នកបំរើម្នាក់របស់គាត់មក, ដាវីឌបាននិយាយ, គាត់ចូលមកជិតហើយវាយគាត់, ហើយគាត់បានស្លាប់.
ដ្បិតមាត់របស់អ្នកផ្ទាល់បានទាស់នឹងអ្នក, និយាយ: I ខ្ញុំបានសម្លាប់គ្រិស្ដរបស់ព្រះអម្ចាស់› ។
1:18 (ហើយគាត់បានណែនាំថាពួកគេគួរតែបង្រៀនកូន ៗ របស់ជនជាតិយូដា, ដូចមានចែងទុកក្នុងគម្ពីររបស់មនុស្សសុចរិត។) ហើយគាត់បាននិយាយ: “ ពិចារណា, ឬអ៊ីស្រាអែល, ជំនួសឱ្យអ្នកដែលបានស្លាប់, រងរបួសនៅលើកំពស់របស់អ្នក:
តើអ្នកក្លាហានអាចធ្លាក់ចុះយ៉ាងដូចម្តេច?
បើមិនដូច្នេះទេ, កូនស្រីរបស់ជនជាតិភីលីស្ទីនសប្បាយចិត្ត; បើមិនដូច្នេះទេ, កូនស្រីរបស់អ្នកមិនកាត់ស្បែកអាចមានអំណរ.
សម្រាប់កន្លែងនោះ, ខែលរបស់អ្នកក្លាហានត្រូវបានគេបោះចោល, ខែលរបស់សូល, ដូចជាគាត់មិនបានត្រូវចាក់ប្រេងដោយប្រេង.
1:23 សូលនិងយ៉ូណាថាន, សមនឹងទទួលបានការស្រឡាញ់, និងស្អាតស្អំនៅក្នុងជីវិតរបស់ពួកគេ: សូម្បីតែនៅក្នុងការស្លាប់ពួកគេមិនត្រូវបានចែកចេញ.
1:24 បុត្រីអ៊ីស្រាអែលអើយ, យំជំនួសសូល, អ្នកណាស្លៀកសម្លៀកបំពាក់ពណ៌ក្រហម, ដែលបានផ្តល់គ្រឿងអលង្ការមាសសម្រាប់តុបតែងលម្អរបស់អ្នក.
តើយ៉ូណាថានអាចត្រូវគេសម្លាប់នៅលើកំពស់?
ក្នុងនាមជាម្តាយស្រឡាញ់កូនប្រុសតែម្នាក់គត់, ខ្ញុំក៏ស្រឡាញ់អ្នកដែរ.
?គាត់ឆ្លើយទៅគាត់វិញ, “ ទៅហេប្រុន” 2:2 ដូច្នេះ, ដាវីឌបានឡើងទៅជាមួយភរិយាទាំងពីររបស់គាត់, អាហ្នឹង, យេហ្សេលែល, និងអ័ប៊ីកែល, ភរិយារបស់ណាបាលជាអ្នកស្រុកកើមែល.
មានគេរាយការណ៍មកលោកដាវីឌថាអ្នកស្រុកយ៉ាបេសកាឡាដបានបញ្ចុះសពព្រះបាទសូល.
2:6 ហើយ ឥឡូវនេះ, ពិតជា, ព្រះអម្ចាស់នឹងតបស្នងសងគុណនិងសេចក្តីពិត.
2:7 សូមឱ្យដៃរបស់អ្នករឹងមាំ, និងត្រូវបានកូនប្រុសនៃកម្លាំង.
2:8 បន្ទាប់មកលោកអប៊ីនើរ, កូនប្រុសរបស់នើរ, អ្នកដឹកនាំកងទ័ពរបស់ព្រះបាទសូល, យកអ៊ីសបូសែត, ជាកូនរបស់សូល, ហើយគាត់បាននាំគាត់នៅជុំវិញ, នៅទូទាំងជំរំនេះ.
2:10 អ៊ីសបូសែត, ជាកូនរបស់សូល, គាត់មានអាយុសែសិបឆ្នាំហើយនៅពេលដែលគាត់បានចាប់ផ្តើមគ្រប់គ្រងប្រទេសអ៊ីស្រាអែល.
ព្រោះមានតែកុល សម្ព័ន្ធយូដាប៉ុណ្ណោះដែលមកតាមព្រះ បាទដាវីឌ.
2:12 និងលោកអប៊ីនើរ, កូនប្រុសរបស់នើរ, និងយុវជនអ៊ីស្មាស់, ជាកូនរបស់សូល, ចេញពីជំរំទៅគីបៀន.
2:15 ដូច្នេះ, ពួកគេក្រោកឡើងហើយឆ្លងទៅ, ដប់ពីរនាក់ក្នុងចំនួនបេនយ៉ាមីន, ពីខាងអ៊ីសបូសែត, ជាកូនរបស់សូល, និងយុវជនដប់ពីរនាក់របស់ដាវីឌ.
ហើយឈ្មោះនៃកន្លែងនោះត្រូវបានគេហៅថា: វាលអ្នកក្លាហាននៅគីបៀន.
និងលោកអប៊ីនើរ, ជាមួយបុរសអ៊ីស្រាអែល, យុវជនដាវីឌបានរត់គេច.
ហើយអេសាហ៊លជាអ្នករត់យ៉ាងលឿន, ដូចជាសត្វក្តាន់មួយដែលរស់នៅក្នុងព្រៃ.
2:22 ហើយម្តងទៀត, លោកអប៊ីនើនមានប្រសាសន៍ទៅកាន់លោកអេសាហ៍: “ ដកប្រាក់, ហើយកុំជ្រើសរើសដើរតាមខ្ញុំ.
2:23 ប៉ុន្តែគាត់បានមើលងាយគាត់, ហើយគាត់មិនមានឆន្ទៈក្នុងការងាកចេញ.
ហើយអស់អ្នកដែលនឹងត្រូវឆ្លងកាត់កន្លែងនោះ, ដែលក្នុងនោះព្រះបាទអេសាហេបានដួលហើយស្លាប់, នឹងឈរនៅតែមាន.
ហើយពួកគេបានធ្វើដំណើររហូតដល់ភ្នំនៃជលផល, ដែលនៅទល់មុខនឹងជ្រលងភ្នំនៃផ្លូវវាលខ្សាច់នៅគីបៀន.
ហើយត្រូវបានចូលរួមនៅក្នុងសមរភូមិតែមួយ, ពួកគេឈរនៅលើកំពូលភ្នំ.
តើអ្នកល្ងង់ខ្លៅដែលវាមានគ្រោះថ្នាក់ក្នុងការធ្វើសកម្មភាពដោយអស់សង្ឃឹម?
?” 2:27 លោកយ៉ូអាប់មានប្រសាសន៍ថា៖: “ ដូចជាព្រះអម្ចាស់មានព្រះជន្មរស់, ប្រសិនបើអ្នកបាននិយាយនៅពេលព្រឹក, ប្រជាជននឹងដកខ្លួនពីការតាមរកបងប្អូនរបស់ពួកគេ” ។
2:29 បន្ទាប់មកលោកអប៊ីនើរនិងកងទ័ពរបស់លោកនាំគ្នាចេញទៅ, ពេញមួយយប់នោះ, ឆ្លងកាត់វាលទំនាប.
2:30 ប៉ុន្តែយ៉ូអាប់, ត្រឡប់មកវិញបន្ទាប់ពីគាត់បានដោះលែងលោកអប៊ីនើរ, ប្រមូលផ្តុំប្រជាជនទាំងអស់.
2:31 រីឯកុលសម្ព័ន្ធបេនយ៉ាមីននិងបុរសដែលនៅជាមួយលោកអប៊ីនើរ, ពួកអ្នកបម្រើរបស់ព្រះ បាទដាវីឌវាយបានបីរយហុក សិបនាក់, ដែលបានស្លាប់.
និងយ៉ូអាប់, និងបុរសដែលនៅជាមួយគាត់, ដើរពេញមួយយប់, ហើយពួកគេបានទៅដល់ក្រុងហេប្រុននៅពេលសំរាក.
3:1 បន្ទាប់មកការតស៊ូដ៏យូរមួយបានកើតឡើងរវាងក្រុមគ្រួសារសូលនិងវង្សដាវីឌ, ជាមួយដាវីឌរីកចំរើននិងកាន់តែខ្លាំងឡើង, រីឯដំណាក់របស់ព្រះបាទសូលថយចុះរាល់ថ្ងៃ.
ហើយកូនប្រុសច្បងរបស់គាត់គឺអាំណូន, ពីអ័ហ៊ីណូមជាជនជាតិយេសរាល.
បន្ទាប់មកទីបីគឺអាប់សាឡំម, កូនប្រុសរបស់ម៉ាកា, កូនស្រីរបស់តាលម៉ៃ, ស្តេច Geshur.
និងទីប្រាំគឺសេផាថា, កូនប្រុសរបស់អាប៊ែត.
អ្នកទាំងនេះកើតមកនៅដាវីឌនៅហេប្រុន.
3:7 ព្រះបាទសូលមានប្រពន្ធដើមម្នាក់ឈ្មោះរីសប៉ា, កូនស្រីរបស់អៃយ៉ា.
3:8 ហេតុអ្វីបានជាអ្នកចូលទៅក្នុងស្នូករបស់ឪពុកខ្ញុំ?" ប៉ុន្តែ គាត់, ខឹងនឹងសម្តីរបស់អ៊ីសបូសែតខ្លាំងណាស់, បាននិយាយ: ថ្ងៃនេះខ្ញុំជាក្បាលឆ្កែប្រឆាំងនឹងទឹកដីយូដា?
យើងមិនបានប្រគល់អ្នកទៅក្នុងកណ្តាប់ដៃរបស់ដាវីឌទេ.
3:9 សូមអោយព្រះជាម្ចាស់ធ្វើការទាំងនេះចំពោះលោកអប៊ីនើរ, ហើយគាត់អាចបន្ថែមរបស់ផ្សេងទៀត, ប្រសិនបើ, ដូចព្រះអម្ចាស់បានសន្យាយ៉ាងម៉ឺងម៉ាត់ដល់ដាវីឌ, ខ្ញុំមិនធ្វើដូច្នេះជាមួយគាត់ទេ:
3:11 ហើយគាត់មិនអាចឆ្លើយតបអ្វីទាំងអស់ចំពោះគាត់ទេ, ព្រោះគាត់ខ្លាចគាត់.
ប៉ុន្តែមានរឿងមួយដែលខ្ញុំសុំពីអ្នក, និយាយ: អ្នកនឹងមិនឃើញមុខខ្ញុំមុនពេលអ្នកនាំមីល័រ, កូនស្រីរបស់ព្រះបាទសូល.
3:14 បន្ទាប់មកដាវីឌចាត់អ្នកនាំសារ ឲ្យ ទៅក្រុងអ៊ីសបូសែត, ជាកូនរបស់សូល, និយាយ, “ ស្តារប្រពន្ធខ្ញុំមីហារឡើងវិញ, ដែលខ្ញុំបានទុកអោយខ្លួនខ្ញុំផ្ទាល់សំរាប់ចំនួនមួយរយគ្រាប់របស់ពួកភីលីស្ទីន»។
3:17 ដូចគ្នា, លោកអប៊ីនើរបានផ្ញើរពាក្យទៅព្រឹទ្ធាចារ្យនៃជនជាតិអ៊ីស្រាអែល, និយាយ: កាលពីម្សិលមិញដូចជាថ្ងៃមុន, អ្នកកំពុងតាមរកលោកដាវីឌ, ដើម្បីអោយគាត់ឡើងគ្រងរាជ្យលើអ្នក.
ដ្បិតព្រះអម្ចាស់មានព្រះបន្ទូលមកកាន់លោកដាវីឌ, និយាយ: By ដោយដាវីឌដាវីឌជាអ្នកបំរើរបស់ខ្ញុំ, យើងនឹងសង្គ្រោះអ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់យើងអោយរួចផុតពីកណ្តាប់ដៃរបស់ជនជាតិភីលីស្ទីននិងខ្មាំងសត្រូវទាំងអស់។
គាត់ក៏ចេញទៅ, ដូច្នេះគាត់អាចទូលព្រះ បាទដាវីឌនៅក្រុងហេប្រុននូវអ្វីៗទាំងប៉ុន្មានដែលគាប់ព្រះ ហឫទ័យដល់អ៊ីស្រា អែលនិងបេន យ៉ាមីនទាំងអស់.
ព្រះបាទដាវីឌបានរៀបចំពិធីជប់លៀងមួយសំរាប់លោកអប៊ីនើរ, និងសម្រាប់បុរសរបស់គាត់ដែលបានមកជាមួយគាត់.
3:22 ពួកអ្នកបម្រើរបស់លោកដាវីឌនិងលោកយ៉ូអាប់ក៏មកដល់, បន្ទាប់ពីបានសម្លាប់ចោរប្លន់, ជាមួយនឹងទ្រព្យដ៏អស្ចារ្យ.
ដោយបន្ទាប់មកគាត់បានបញ្ជូនគាត់ទៅឆ្ងាយ, ហើយគាត់បានចេញទៅដោយសុខសាន្ដ.
ហើយ ដូច្នេះ, មានគេរាយការណ៍មកលោកយ៉ូអាប់, ពន្យល់ថាអប៊ីនើរ, កូនប្រុសរបស់នើរ, បានទៅគាល់ព្រះរាជា, ហើយគាត់បានបណ្តេញគាត់ចេញ, គាត់ក៏ចេញទៅដោយសុខសាន្ត.
មើល, អប៊ីនើរបានមករកអ្នក.
3:27 ហើយនៅពេលដែលលោកអប៊ីនើរបានវិលត្រឡប់មកហេប្រុនវិញ, លោកយ៉ូអាប់បាននាំគាត់ម្នាក់ឯងឆ្ពោះទៅកណ្តាលទ្វារ, ដូច្នេះគាត់អាចនិយាយជាមួយគាត់បាន, ប៉ុន្តែដោយការបោកបញ្ឆោត.
3:28 ហើយនៅពេលដែលដាវីឌបាន heard ពីវា, ឥឡូវរឿងនេះត្រូវបានធ្វើ, គាត់ បាន និយាយ ថា: “ ខ្ញុំនិងរាជាណាចក្ររបស់ខ្ញុំស្អាតនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់, សូម្បីតែជារៀងរហូត, នៃឈាមរបស់លោកអប៊ីនើរ, កូនប្រុសរបស់នើរ.
ហើយប្រហែលជាមិនដែលបរាជ័យឡើយ, នៅក្នុងផ្ទះរបស់យ៉ូអាប់, មួយដែលទទួលរងពីលំហូរនៃគ្រាប់, ឬអ្នកកើតឃ្លង់, ឬមួយដែលកំពុងបន្ទោស, ឬអ្នកដែលដួលដោយដាវ, ឬអ្នកដែលត្រូវការនំប៉័ង»។
3:31 លោកដាវីឌមានប្រសាសន៍ទៅកាន់លោកយ៉ូអាប់, និងប្រជាជនទាំងអស់ដែលនៅជាមួយគាត់, ចូរហែកសម្លៀកបំពាក់របស់អ្នក, ចូរស្លៀកបាវកាន់ទុក្ខ, ហើយកាន់ទុក្ខនៅមុនពេលដង្ហែសពរបស់លោកអប៊ីនើរ។ លើសពីនេះទៅទៀត, ព្រះ បាទដាវីឌផ្ទាល់បានដើរតាមមឈូស.
ហើយប្រជាជនទាំងអស់ក៏យំដែរ.
3:34 ដៃរបស់អ្នកមិនជាប់ទេ, ហើយជើងរបស់អ្នកក៏មិនចុះខ្សោយដែរ.
3:35 ហើយពលទាហានទាំងមូលបានមកដល់ដើម្បីបរិភោគជាមួយដាវីឌ, ខណៈពេលដែលវានៅតែមានពន្លឺថ្ងៃទូលំទូលាយ, ដាវីឌបានស្បថ, និយាយ, “ សូមអោយព្រះជាម្ចាស់ធ្វើការទាំងនេះចំពោះខ្ញុំ, ហើយគាត់អាចបន្ថែមរបស់ផ្សេងទៀត, ប្រសិនបើខ្ញុំភ្លក្សនំប៉័ងឬអ្វីផ្សេងទៀតមុនពេលថ្ងៃលិច។
3:37 ហើយមនុស្សសាមញ្ញគ្រប់រូប, និងជនជាតិអ៊ីស្រាអែលទាំងអស់, បានដឹងនៅថ្ងៃនោះថាការសម្លាប់អប៊ីនើរ, កូនប្រុសរបស់នើរ, ស្តេចមិនបានធ្វើទេ.
3:39 ប៉ុន្តែខ្ញុំនៅតែទន់ភ្លន់, និងការចាក់ប្រេងតាំងស្តេច.
4:2 កូនប្រុសរបស់ព្រះបាទសូលមានបុរសពីរនាក់, មេដឹកនាំក្នុងចំណោមចោរប្លន់.
សម្រាប់ការពិត, ស្រាបៀរ, ផងដែរ, មានកេរ្តិ៍ឈ្មោះជាមួយបេនយ៉ាមីន.
ហើយពួកគេជាជនបរទេសនៅទីនោះ, រហូតដល់ពេលនោះ.
លោកមានអាយុប្រាំឆ្នាំពេលtheដំណឹងអំពីព្រះបាទសូលនិងសម្ដេចយ៉ូណាថានមកពីក្រុងយេសរាល.
ហើយខណៈពេលដែលនាងកំពុងប្រញាប់, ដូច្នេះនាងនឹងរត់គេចខ្លួន, គាត់ដួលហើយធ្លាក់ខ្លួនពិការ.
4:5 ហើយ ដូច្នេះ, កូនប្រុសរបស់រីមម៉ុនជាអ្នកក្រុងបៀថោត, រេកាបនិងបាណា, មកដល់ផ្ទះរបស់លោកអ៊ីសបូសែត, ក្នុងកំដៅថ្ងៃ.
និងអ្នកយាមទ្វារផ្ទះ, ដែលកំពុងសំអាតស្រូវសាលី, ដេកលក់ស្រួល.
ហើយរេកាបនិងប្អូនរបស់គាត់បាណាបានចាក់គាត់នៅលៀន, ហើយពួកគេបានភៀសខ្លួនចេញ.
ហើយធ្វើកូដកម្មគាត់, ពួកគេបានសម្លាប់គាត់.
4:8 ពួកគេនាំយកក្បាលអ៊ីសបូសែតមករកដាវីឌនៅក្រុងហេប្រូន.
4:10 អ្នកដែលបានរាយការណ៍មកខ្ញុំហើយនិយាយ, Saul សូលបានស្លាប់ហើយ,ដែលកំពុងគិតថាគាត់ប្រកាសដំណឹងល្អ, ខ្ញុំចាប់បាន.
4:11 តើមានច្រើនប៉ុណ្ណាឥឡូវនេះ, នៅពេលដែលមនុស្សទុច្ចរិតបានសម្លាប់បុរសស្លូតត្រង់នៅក្នុងផ្ទះរបស់គាត់, នៅលើគ្រែរបស់គាត់, ខ្ញុំមិនត្រូវការឈាមរបស់គាត់ពីដៃរបស់អ្នកទេ, ហើយយកអ្នកចេញពីផែនដី?”
ហើយកាត់ដៃនិងជើង, ពួកគេបានព្យួរពួកគេនៅលើអាងទឹកក្នុងហេប្រុន.
5:2 លើសពីនេះទៅទៀត, កាលពីម្សិលមិញនិងថ្ងៃមុន, ពេលព្រះបាទសូលសោយរាជ្យលើយើង, អ្នកគឺជាអ្នកនាំមុខនិងនាំអ៊ីស្រាអែលវិញ.
5:3 ផងដែរ, ពួកព្រឹទ្ធាចារ្យនៃជនជាតិអ៊ីស្រាអែលនាំគ្នាទៅគាល់ស្តេចនៅក្រុងហេប្រូន, ព្រះ បាទដាវីឌបានចងសម្ពន្ធ មេត្រីជាមួយពួកគេនៅក្រុងហេប្រូននៅចំពោះព្រះ ភ័ក្ត្រព្រះ អម្ចាស់.
5:4 ដាវីឌជាកូនប្រុសអាយុសាមសិបឆ្នាំ, នៅពេលដែលគាត់បានចាប់ផ្តើមសោយរាជ្យ, ហើយសោយរាជ្យបានសែសិបឆ្នាំ.
បន្ទាប់មកនៅក្រុងយេរូសាឡិម, ស្តេចសោយរាជ្យអស់រយៈពេលសាមសិបបីឆ្នាំលើទឹកដីអ៊ីស្រាអែលនិងស្រុកយូដាទាំងមូល.
មានគេមកទូលដាវីឌអំពីរឿងទាំងនោះ, អ្នកមិនត្រូវចូលទីនេះទេ, លើកលែងតែអ្នកយកខ្វាក់និងមនុស្សខ្វិនពីគេ, អ្នកណា និយាយ, ដាវីឌនឹងមិនចូលទីនេះទេ។ '
5:8 ចំពោះដាវីឌបានស្នើសុំ, នៅ ថ្ងៃ នោះ, រង្វាន់ដល់អ្នកដែលបានវាយប្រហារជនជាតិយេប៊ូសហើយដែលបានឈានដល់ជណ្តើរលើដំបូល, ហើយបានយកមនុស្សខ្វាក់និងមនុស្សខ្វិនដែលស្អប់ព្រលឹងរបស់ដាវីឌចេញ.
5:9 បន្ទាប់មកដាវីឌរស់នៅក្នុងបន្ទាយ, ហើយគាត់បានហៅវា: ទីក្រុងដាវីឌ.
5:10 ហើយគាត់បានជឿនលឿន, រីកចម្រើននិងកើនឡើង, និងព្រះអម្ចាស់, ព្រះនៃពិភពទាំងមូល, នៅជាមួយគាត់.
ហើយពួកគេបានសង់ផ្ទះសម្រាប់ដាវីឌ.
5:13 ព្រះ បាទដាវីឌក៏បាននាំស្ត្រីពៅនិងស្ត្រីជាច្រើនទៀតចេញពីក្រុងយេរូ សាឡឹម, បន្ទាប់ពីគាត់បានមកដល់ Hebron.
ហើយពួកគេទាំងអស់បានឡើងទៅ, ដូច្នេះពួកគេនឹងតាមរកដាវីឌ.
5:18 ឥឡូវនេះពួកភីលីស្ទីន, មកដល់, បានផ្សព្វផ្សាយខ្លួននៅជ្រលងភ្នំរេផែម.
ដ្បិតពេលនោះព្រះអម្ចាស់នឹងយាងមក, មុនមុខរបស់អ្នក, ដូច្នេះគាត់នឹងវាយប្រហារកងទ័ពភីលីស្ទីន»។
ហើយគាត់បានវាយប្រហារជនជាតិភីលីស្ទីន, ពីគីបៀនរហូតដល់អ្នកទៅដល់កេស៊ើរ.
6:7 ព្រះអម្ចាស់ទ្រង់ព្រះពិរោធនឹងអ៊ូសា.
ហើយនៅទីនោះគាត់បានស្លាប់, នៅក្បែរហិបរបស់ព្រះ.
ហើយឈ្មោះនៃកន្លែងនោះត្រូវបានគេហៅថា: ការធ្វើកូដកម្មរបស់អូសា, រហូតមកដល់សព្វថ្ងៃនេះ.
6:10 គាត់មិនហ៊ានផ្ញើហិបរបស់ព្រះអម្ចាស់ទៅទីក្រុងដាវីឌផ្ទាល់ទេ.
6:11 ហិបរបស់ព្រះអម្ចាស់ស្ថិតនៅក្នុងផ្ទះរបស់លោកអូបេដ - មេឌីត, អស់រយៈពេលបីខែ.
6:12 មានគេទូលស្តេចដាវីឌថាព្រះអម្ចាស់បានប្រទានពរដល់អូបេឌ - អេម, ហើយទាំងអស់នោះគឺជារបស់គាត់, ដោយសារតែហិបរបស់ព្រះ.
6:15 ហើយដាវីឌ, និងពូជពង្សអ៊ីស្រាអែលទាំងមូល, គេដឹកហិបនៃសក្ខីភាពរបស់ព្រះអម្ចាស់, ជាមួយនឹងការត្រេកត្រអាលនិងសំឡេងត្រែ.
6:18 ហើយនៅពេលដែលគាត់បានថ្វាយតង្វាយដុតទាំងមូលនិងតង្វាយសន្តិភាព, ស្តេចបានប្រទានពរដល់ប្រជាជនក្នុងនាមព្រះអម្ចាស់នៃពិភពទាំងមូល.
ហើយប្រជាជនទាំងអស់ក៏ចេញទៅ, ម្នាក់ៗទៅផ្ទះរៀងៗខ្លួន.
និងមីល, កូនស្រីរបស់ព្រះបាទសូល, ចេញទៅជួបដាវីឌ, បាននិយាយ: សព្វថ្ងៃនេះស្តេចស្រុកអ៊ីស្រាអែលមានសិរីរុងរឿងហើយ, បង្ហាញខ្លួននៅចំពោះមុខអ្នកបំរើរបស់អ្នកបំរើ, និងត្រូវបានគេបិទ, ដូចជាប្រសិនបើអ្នកសំដែងម្នាក់មិនបានស្លៀកពាក់។
6:22 ខ្ញុំនឹងលេងនិងប្រមាថខ្លួនឯង, ច្រើនជាងអ្វីដែលខ្ញុំបានធ្វើ.
ហើយជាមួយអ្នកបម្រើ, អំពីអ្នកដែលអ្នកកំពុងនិយាយ, ខ្ញុំនឹងលេចមុខកាន់តែរុងរឿង។
7:2 គាត់បាននិយាយទៅកាន់ព្យាការីណាថាន់, អ្នករាល់គ្នាមិនដែលឃើញខ្ញុំកំពុងរស់នៅក្នុងផ្ទះតាត្រៅទេ, ហើយហិបរបស់ព្រះត្រូវបានគេដាក់នៅកណ្ដាលស្បែក?”
7:5 “ ទៅ, ហើយប្រាប់ដាវីឌជាអ្នកបំរើរបស់យើង: ព្រះអម្ចាស់មានព្រះបន្ទូលដូច្នេះ: តើអ្នកគួរសង់ផ្ទះសម្រាប់ខ្ញុំជាកន្លែងរស់នៅ?
ជំនួស, ខ្ញុំបានដើរក្នុងរោងឧបោសថ, ហើយនៅក្នុងតង់មួយ.
7:8 ហើយ ឥឡូវនេះ, ដូច្នេះអ្នកត្រូវនិយាយជាមួយដាវីឌជាអ្នកបំរើរបស់យើង: ព្រះអម្ចាស់នៃពិភពទាំងមូលមានព្រះបន្ទូលថា៖: ខ្ញុំបានយកអ្នកចេញពីវាលស្មៅ, ពីការដើរតាមចៀម, ដូច្នេះអ្នកនឹងធ្វើជាមេដឹកនាំលើអ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់យើង.
យើងបានប្រហារខ្មាំងសត្រូវទាំងអស់របស់អ្នកនៅចំពោះមុខអ្នក.
7:10 យើងនឹងតែងតាំងកន្លែងមួយអោយអ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់យើង, ហើយខ្ញុំនឹងដាំពួកគេ, ពួកគេនឹងរស់នៅទីនោះ, ហើយពួកគេនឹងមិនត្រូវបានរំខានទៀតទេ.
7:11 ចាប់តាំងពីថ្ងៃដែលយើងតែងតាំងចៅក្រមអោយគ្រប់គ្រងលើអ៊ីស្រាអែលជាប្រជារាស្ត្ររបស់យើង.
ហើយព្រះអម្ចាស់បានទាយប្រាប់អ្នកថាព្រះអម្ចាស់ផ្ទាល់នឹងសង់ផ្ទះមួយសម្រាប់អ្នក.
7:13 គាត់នឹងសង់ផ្ទះមួយសំរាប់នាមខ្ញុំ.
7:17 នេះបើយោងតាមពាក្យទាំងអស់នេះ, ហើយយោងទៅតាមចក្ខុវិស័យទាំងមូល, លោកណាថាននិយាយជាមួយដាវីឌដូច្នេះ.
7:19 លើសពីនេះទៅទៀត, រឿងនេះមើលទៅហាក់ដូចជាមិនសូវល្អទេ, ឱព្រះអម្ចាស់ជាព្រះ, ប្រសិនបើអ្នកនឹងមិននិយាយអំពីផ្ទះរបស់អ្នកបំរើរបស់អ្នកក្នុងរយៈពេលយូរទេនោះ.
7:20 ដូច្នេះ, តើមានអ្វីទៀតដែលដាវីឌអាចនិយាយទៅកាន់អ្នកបាន??
7:21 ដោយសារតែពាក្យរបស់អ្នក, ហើយស្របតាមចិត្តរបស់អ្នក, អ្នកបានធ្វើការអស្ចារ្យទាំងអស់នេះ, ដូច្នេះសូមអោយទូលបង្គំជាអ្នកបំរើរបស់ព្រះអង្គបានដឹងផង.
សម្រាប់គ្មាននរណាម្នាក់ដូចអ្នកទេ.
7:23 ប៉ុន្តែតើមានប្រជាជាតិណានៅលើផែនដីដូចប្រជាជាតិអ៊ីស្រាអែលរបស់អ្នក, ព្រោះតែព្រះជាម្ចាស់ដែលបានយាងទៅ, ដូច្នេះព្រះអង្គនឹងលោះប្រជារាស្ដ្រមួយរបស់ព្រះអង្គ, និងបង្កើតឈ្មោះសម្រាប់ខ្លួនគាត់, និងសម្រេចបានសម្រាប់រឿងដ៏អស្ចារ្យនិងគួរឱ្យភ័យខ្លាចនៅលើផែនដី, មុនមុខប្រជាជនរបស់អ្នក, គឺព្រះអង្គដែលព្រះអង្គបានលោះអោយនៅស្រុកអេស៊ីប, ប្រជាជាតិនិងព្រះរបស់ពួកគេ.
ហើយធ្វើដូចអ្វីដែលអ្នកបាននិយាយ,
សម្រាប់ អ្នក, ឱព្រះអម្ចាស់ជាព្រះ, បាននិយាយ.
ឥឡូវនេះគាត់បានវាស់ជាមួយខ្សែពីរ, សម្លាប់មួយ, និងមួយដើម្បីរក្សាជីវិត.
8:3 ព្រះ បាទដាវីឌវាយលោកហាដា ស៊ើរ, កូនប្រុសរបស់រេហូប, ស្តេចស្រុកសូបា, នៅពេលដែលគាត់បានកំណត់ដើម្បីគ្រប់គ្រងលើទន្លេអឺប្រាត.
8:5 ជនជាតិស៊ីរីនៅក្រុងដាម៉ាសមកដល់, ដូច្នេះពួកគេអាចយកកម្លាំងទៅហាដាដេស, ស្តេចស្រុកសូបា.
8:6 ហើយដាវីឌបានដាក់ទីតាំងទ័ពនៅស៊ីរីនៃក្រុងដាម៉ាស.
ព្រះអម្ចាស់បានជួយដល់ដាវីឌក្នុងគ្រប់កិច្ចការទាំងអស់ដែលទ្រង់បានសំរេច.
8:12 មកពីប្រទេសស៊ីរី, និងម៉ូអាប់, និងកូនប្រុសអាំម៉ូន, និងពួកភីលីស្ទីន, និងអាម៉ាលេក, និងបានពីលេខមួយដ៏ល្អបំផុតនៃការ Hadadezer, កូនប្រុសរបស់រេហូប, ស្តេចស្រុកសូបា.
8:14 ហើយគាត់ដាក់អ្នកយាមនៅអេដុម, ហើយគាត់បានដាក់យោធភូមិ.
ព្រះបាទដាវីឌបានសំរេចជោគជ័យក្នុងការកាត់ក្តីនិងប្រកបដោយយុត្ដិធម៌ជាមួយប្រជាជនរបស់ព្រះអង្គ.
8:18 និងបេណាយ៉ា, កូនប្រុសរបស់យេហូយ៉ាដា, គឺនៅលើជ្រលងភ្នំនិងភីលេត.
9:2 ឥឡូវមាន, ពីដំណាក់របស់សូល, អ្នកបំរើម្នាក់ឈ្មោះហ្ស៊ីបា.
9:3 ហើយព្រះរាជាមានបន្ទូល, តើមាននរណាអាចរស់ពីពូជពង្សរបស់ព្រះបាទសូលបានដែរឬទេ?, ដូច្នេះខ្ញុំនឹងបង្ហាញព្រះហឫទ័យមេត្ដាករុណាដល់ព្រះជាម្ចាស់?ស៊ីបាទូលព្រះរាជា, កូនរបស់យ៉ូណាថាននៅរស់នៅឡើយ, ជាមួយនឹងជើងពិការ” ។
9:6 ហើយនៅពេលដែលមភីបូសែត, កូនប្រុសរបស់យ៉ូណាថាន, ជាកូនរបស់សូល, បានមកជួបដាវីឌ, គាត់ក្រាបចុះអោនមុខដល់ដី, ហើយគាត់បានគោរព.
យើងនឹងប្រគល់ដីស្រែចំការរបស់សូលជាឪពុករបស់អ្នកអោយអ្នកវិញ.
9:8 និងគោរពគាត់, គាត់ បាន និយាយ ថា, "តើ ខ្ញុំ ជា អ្នកណា, អ្នកបំរើរបស់អ្នក, ថាអ្នកគួរតែមើលទៅការពេញចិត្តលើឆ្កែងាប់ដូចខ្ញុំ?”
9:10 ហើយ ដូច្នេះ, ធ្វើដីសម្រាប់គាត់, អ្នកនិងកូនប្រុសនិងអ្នកបំរើរបស់អ្នក.
មភីបូសែតនឹងបរិភោគនៅតុខ្ញុំ, ដូចជាបុត្រាមួយអង្គរបស់ស្តេច។
ពិត, កុល សម្ព័ន្ធទាំងប៉ុន្មាននៃផ្ទះរបស់ស៊ី បាបម្រើលោកមេភីបូសែត.
ព្រោះគាត់តែងតែបរិភោគពីតុស្តេច.
10:2 លោកដាវីឌមានប្រសាសន៍, “ ខ្ញុំនឹងបង្ហាញសេចក្តីមេត្តាករុណាដល់ហាន់ណុន, កូនប្រុសរបស់ណាហាស, ដូចឪពុករបស់គាត់បានបង្ហាញសេចក្ដីមេត្ដាករុណាដល់ខ្ញុំ»។ ដូច្នេះ, ដាវីឌបានជួយសំរាលទុក្ខគាត់, ដោយអ្នកបម្រើរបស់គាត់, ជុំវិញការស្លាប់របស់ឪពុកគាត់.
10:4 ហើយ ដូច្នេះ, ហាណូនបានយកអ្នកបំរើរបស់ដាវីឌ, ហើយគាត់បានកោរពុកមាត់ពាក់កណ្តាលរបស់ពួកគេ, ហើយគាត់បានកាត់សម្លៀកបំពាក់របស់ពួកគេនៅកណ្តាល, ដូចជានៅឆ្ងាយគូទ, លោកក៏អោយគេចេញទៅ.
ហើយបុរសទាំងនោះមានការខ្មាស់អៀនយ៉ាងខ្លាំង.
10:6 ឥឡូវនេះជាកូនរបស់អាំម៉ូន, ដោយឃើញថាពួកគេបានធ្វើបាបដាវីឌ, បានផ្ញើសម្រាប់, ហើយបានបើកប្រាក់ឈ្នួលអោយ, ជនជាតិស៊ីរីរេដប, និងស៊ីរីនៅសូបា, ទាហានជើងពីរម៉ឺននាក់, និងពីស្ដេចម៉ាកា, បុរសមួយពាន់នាក់, និងពីថូប, បុរសដប់ពីរពាន់នាក់.
10:8 បន្ទាប់មកកូន ៗ របស់អាំម៉ូនក៏ចេញទៅ, ពួកគេបានដាក់ទីតាំងជួរមុខនៅមុខខ្លោងទ្វារ.
10:9 ហើយ ដូច្នេះ, ដោយឃើញថាការប្រយុទ្ធបានរៀបចំឡើងប្រឆាំងនឹងគាត់, ទាំងមុខនិងក្រោយគាត់, លោកយ៉ូអាប់បានជ្រើសរើសអ្នកខ្លះក្នុងចំណោមជនជាតិអ៊ីស្រាអែលដែលបានជ្រើសរើស, ហើយគាត់បានតំឡើងសមរភូមិទល់មុខនឹងពួកស៊ីរី.
10:11 លោកយ៉ូអាប់មានប្រសាសន៍ថា៖: ប្រសិនបើជនជាតិស៊ីរីឈ្នះខ្ញុំ, បន្ទាប់មកអ្នកនឹងជួយខ្ញុំ.
10:14 បន្ទាប់មក, ឃើញជនជាតិស៊ីរីរត់គេចខ្លួនបាត់, កូនប្រុសរបស់អាំម៉ូនបានរត់ចេញពីមុខលោកអប៊ីសាយ, គេចូលទៅក្នុងទីក្រុង.
10:15 ហើយ ដូច្នេះ, ជនជាតិស៊ីរី, ដោយឃើញថាពួកគេបានដួលនៅមុខជនជាតិអ៊ីស្រាអែល, បានប្រមូលផ្តុំគ្នា.
លោកបានឆ្លងទន្លេយ័រដាន់, ហើយគាត់បានទៅហេឡាម.
10:18 ជនជាតិស៊ីរីរត់គេចនៅចំពោះមុខកងទ័ពអ៊ីស្រាអែល.
ប៉ុន្តែដាវីឌស្នាក់នៅក្រុងយេរូសាឡិម.
ហើយគាត់បានឃើញ, ពីលើរាបស្មើររបស់គាត់, ស្ត្រីម្នាក់លាងសំអាតខ្លួនរបស់នាង.
11:3 ដូច្នេះ, ព្រះរាជាចាត់គេអោយទៅសួរនាងថានាងជានរណា.
ហើយបច្ចុប្បន្ន, នាងត្រូវបានសំអាតពីភាពស្មោកគ្រោករបស់នាង.
11:8 លោកដាវីឌមានប្រសាសន៍ទៅលោកអ៊ូរី, “ ចូលទៅក្នុងផ្ទះរបស់អ្នក, ហើយលាងជើងរបស់អ្នក។ លោកអ៊ូរីចាកចេញពីរាជវាំង.
ហេតុអ្វីបានជាអ្នកមិនចុះទៅផ្ទះរបស់អ្នក?”
ហើយបន្ទាប់មកខ្ញុំគួរតែចូលក្នុងផ្ទះរបស់ខ្ញុំ, ដូច្នេះខ្ញុំអាចស៊ីផឹកបាន, ហើយដេកជាមួយប្រពន្ធខ្ញុំ?
11:12 ដូច្នេះ, ដាវីឌបាននិយាយទៅកាន់អ៊ូរី, "ទោះ អញ្ចឹង ក្ដី, នៅទីនេះនៅថ្ងៃនេះ, ហើយថ្ងៃស្អែកខ្ញុំនឹងបញ្ជូនអ្នកទៅ»។ ដូច្នេះលោកអ៊ូរីនៅក្រុងយេរូសាឡឹម, នៅថ្ងៃនោះនិងថ្ងៃបន្ទាប់.
ហើយគាត់បានផ្ញើវាដោយដៃរបស់អ៊ូរី,
11:16 ហើយ ដូច្នេះ, ពេលលោកយ៉ូអាប់ឡោមព័ទ្ធទីក្រុង, គាត់ដាក់អ៊ូរីនៅកន្លែងដែលគាត់ស្គាល់បុរសខ្លាំងបំផុត.
ហើយប្រជាជនខ្លះក្នុងចំណោមអ្នកបំរើរបស់ដាវីឌបានដួល, រីឯលោកអ៊ូរីជាជនជាតិហេតក៏ទទួលមរណភាពដែរ.
11:19 ហើយគាត់បានណែនាំអ្នកនាំសារ, និយាយ: “ នៅពេលដែលអ្នកបានបញ្ចប់ពាក្យទាំងអស់អំពីសង្គ្រាមដល់ព្រះរាជា,
តើអ្នកមិនដឹងទេថាព្រួញជាច្រើនត្រូវបានគេបោះចោលពីលើជញ្ជាំង?
តើស្ត្រីមិនបានបោះដុំថ្មមួយដុំមកលើគាត់ពីលើជញ្ជាំងទេ, ដូច្នេះត្រូវសំលាប់គាត់នៅថេបេ?
11:23 អ្នកនាំសារប្រាប់ដាវីឌ: បុរសទាំងនោះបានយកឈ្នះយើង, ពួកគេក៏ចេញទៅជួបយើងនៅឯចម្ការ.
11:24 អ្នកបាញ់ព្រួញតម្រង់ទៅរកអ្នកបំរើរបស់អ្នកពីកំពែងខាងលើ.
ឥឡូវនេះមួយ, ហើយឥឡូវមួយនោះ, ត្រូវបានបំផ្លាញដោយដាវ.
11:26 ភរិយារបស់លោកអ៊ូរីបានទទួលដំណឹងថាប្ដីរបស់នាងអ៊ូរីបានស្លាប់, ហើយនាងបានកាន់ទុក្ខសម្រាប់គាត់.
ហើយពាក្យនេះ, ដែលដាវីឌបានធ្វើ, ព្រះអម្ចាស់មិនគាប់ព្រះហឫទ័យនឹងព្រះអម្ចាស់ទេ.
12:1 ពេលនោះព្រះអម្ចាស់បានចាត់ណាថាន់អោយទៅដាវីឌ.
12:2 បុរសអ្នកមានមានចៀមនិងគោយ៉ាងច្រើន.
ហើយនាងបានធំឡើងនៅចំពោះមុខគាត់, រួមគ្នាជាមួយកូន ៗ របស់គាត់, បរិភោគពីនំប៉័ងរបស់គាត់, និងផឹកពីពែងរបស់គាត់, ហើយដេកនៅលើទ្រូងរបស់គាត់.
12:4 ប៉ុន្តែនៅពេលដែលអ្នកដំណើរម្នាក់បានមកដល់បុរសអ្នកមាន, ធ្វេសប្រហែសយកចៀមនិងគោរបស់គាត់ផ្ទាល់, គាត់អាចរៀបចំពិធីជប់លៀងជូនអ្នកធ្វើដំណើរ, ដែលបានមករកគាត់, គាត់បានយកចៀមរបស់បុរសក្រីក្រ, ហើយគាត់បានរៀបចំអាហារសម្រាប់បុរសដែលមករកគាត់»។
12:6 គាត់ត្រូវស្តារចៀមបួនជាបួន, ពីព្រោះគាត់បានធ្វើតាមពាក្យនេះ, ហើយគាត់ក៏មិនដែលអាណិតអាសូរដែរ” ។
នេះជាព្រះបន្ទូលរបស់ព្រះអម្ចាស់, ព្រះនៃអ៊ីស្រាអែល: យើងបានចាក់ប្រេងអភិសេកអ្នកអោយធ្វើជាស្តេចលើជនជាតិអ៊ីស្រាអែល, យើងបានរំដោះអ្នកអោយរួចពីកណ្តាប់ដៃរបស់សូល.
ហើយអ្នកបានយកប្រពន្ធរបស់គាត់ធ្វើជាប្រពន្ធសម្រាប់ខ្លួនអ្នក.
12:10 សម្រាប់ ហេតុផល នេះ, ដាវមិនត្រូវដកហូតចេញពីផ្ទះរបស់អ្នកឡើយ, សូម្បីតែរៀងរហូត, ព្រោះអ្នកបានមើលងាយខ្ញុំ, ហើយអ្នកបានយកប្រពន្ធរបស់លោកអ៊ូរីជាជនជាតិហេតមក, ដូច្នេះនាងអាចធ្វើជាប្រពន្ធរបស់អ្នក។ '
ហើយខ្ញុំនឹងនាំប្រពន្ធរបស់អ្នកទៅឆ្ងាយពីភ្នែករបស់អ្នក, ហើយខ្ញុំនឹងអោយពួកគេទៅអ្នកជិតខាងរបស់អ្នក.
12:13 លោកដាវីឌមានប្រសាសន៍ទៅលោកណាថាន, “ ខ្ញុំបានធ្វើបាបនឹងព្រះអម្ចាស់ហើយ” លោកណាថានទូលព្រះ បាទដាវីឌ: «ព្រះអម្ចាស់ក៏ដកអំពើបាបរបស់អ្នកចេញដែរ.
12:14 នៅឡើយទេ, ព្រោះអ្នកបានផ្តល់ឱកាសអោយខ្មាំងសត្រូវរបស់ព្រះអម្ចាស់ប្រមាថព្រះជាម្ចាស់, ដោយសារតែពាក្យនេះ, កូនប្រុសដែលកើតមកអ្នក: គាត់នឹងត្រូវស្លាប់” ។
ហើយដាវីឌបានតមយ៉ាងតឹងរ៉ឹង, ហើយចូលតែម្នាក់ឯង, គាត់បានដាក់នៅលើដី.
ពួកអ្នកបំរើរបស់ដាវីឌភ័យខ្លាចមិនហ៊ានរាយការណ៍ប្រាប់គាត់ថាក្មេងតូចនោះបានស្លាប់.
តើគាត់នឹងធ្វើបាបខ្លួនឯងដល់កម្រិតណាទៀត?, បើយើងប្រាប់គាត់ថាក្មេងនោះស្លាប់ហើយ?”
អ្នកបានតមហើយយំ, ជំនួសឱ្យទារក, ពេលគាត់នៅរស់.
ជំនួស, ខ្ញុំនឹងទៅរកគាត់.
12:24 ហើយដាវីឌបានលួងលោមភរិយារបស់គាត់ឈ្មោះបាតសេបា.
នាងមានផ្ទៃពោះបង្កើតបានកូនប្រុសមួយ, គាត់ដាក់ឈ្មោះថាសាឡូម៉ូន, ព្រះអម្ចាស់ស្រឡាញ់គាត់.
12:26 បន្ទាប់មកលោកយ៉ូអាប់វាយតទល់នឹងរ៉ាបាតរបស់កូនចៅអាំម៉ូន, ហើយគាត់បានប្រយុទ្ធនៅខាងក្រៅទីក្រុងរាជវាំង.
12:28 ឥឡូវនេះ, ប្រមូលផ្នែកដែលនៅសេសសល់របស់ប្រជាជនទាំងអស់គ្នា, ឡោមព័ទ្ធទីក្រុងហើយដណ្តើមយកក្រុងនោះ.
12:29 លោកដាវីឌក៏ប្រមូលប្រជាជនទាំងមូល, ហើយគាត់បានចេញទៅប្រឆាំងនឹងរ៉ាបា.
ហើយដាក់នៅលើក្បាលដាវីឌ.
12:31 ផងដែរ, នាំប្រជាជនរបស់ខ្លួនចេញ, គាត់បានឃើញពួកគេ, ហើយគាត់បានទម្លាក់លើពួកគេដោយរទេះដែក, ហើយគាត់បានចែកឱ្យពួកគេជាមួយកាំបិត, ហើយគាត់បានអូសពួកគេឆ្លងកាត់ឡឥដ្ឋ.
លោកដាវីឌវិលត្រឡប់មកវិញ, ជាមួយកងទ័ពទាំងមូល, ទៅក្រុងយេរូសាឡឹម.
13:1 ឥឡូវនេះបន្ទាប់ពីការទាំងនេះ, វាបានកើតឡើងដែលអាំណូន, ជាកូនរបស់ដាវីឌ, មានស្នេហាជាមួយប្អូនស្រីអាប់សាឡំម, ជាកូនរបស់ដាវីឌ, ហើយនាងត្រូវបានគេហៅថាតាម៉ា.
13:3 ឥឡូវនេះអាំណូនមានមិត្តម្នាក់ឈ្មោះយ៉ូណាដាប់, កូនរបស់លោកស៊ីម៉ា, បងប្អូនរបស់ដាវីឌ: ជាបុរសដែលមានការប្រុងប្រយ័ត្នខ្ពស់.
ហេតុអ្វីបានជាអ្នកមិនប្រាប់ខ្ញុំ?លោកអាំណូនឆ្លើយថា៖, “ ខ្ញុំស្រឡាញ់តាម៉ារ, បងស្រីរបស់អាប់សាឡំមជាប្អូនស្រីខ្ញុំ»។
13:7 ដូច្នេះ, ដាវីឌបានផ្ញើទៅផ្ទះតាម៉ារ, និយាយ, «មកផ្ទះរបស់អាំណូនជាបងរបស់អ្នក, ហើយធ្វើអាហារតូចមួយសម្រាប់គាត់” ។
ប៉ុន្តែគាត់បានដេកលក់.
ប៉ុន្តែគាត់បានបដិសេធមិនបរិភោគ.
13:10 អាំណូននិយាយទៅកាន់តាម៉ារ, “ យកម្ហូបចូលបន្ទប់គេង, ដូច្នេះខ្ញុំនឹងបរិភោគពីដៃរបស់អ្នកហើយ” ។ ដូច្នេះ, នាងតាម៉ារបានយកចំណែកអាហារបន្តិចបន្តួចដែលនាងបានធ្វើ, ហើយនាងបាននាំពួកគេទៅឯអាំណូនបងប្រុសរបស់នាងនៅក្នុងបន្ទប់គេង.
នៅអ៊ីស្រាអែលមិនគួរធ្វើបែបនេះឡើយ.
ជំនួស, ទូទៅដោយកម្លាំង, គាត់បានបង្ខំនាង, ហើយគាត់បានដេកជាមួយនាង.
13:17 ជំនួស, ហៅពួកអ្នកបំរើដែលបានមកបំរើលោក, គាត់ បាន និយាយ ថា, “ ដេញស្ត្រីនេះចេញពីខ្ញុំ, ហើយបិទទ្វារនៅខាងក្រោយនាង។
សម្រាប់បុត្រីព្រហ្មចារីរបស់ស្តេចបានប្រើសម្លៀកបំពាក់បែបនេះ.
13:19 ហើយនាងបានប្រោះផេះលើក្បាលរបស់នាង, ហើយនាងបានហែកអាវវែងរបស់នាង.
13:20 ពេលនោះអាប់សាឡំមជាបងស្រីរបស់នាងនិយាយទៅកាន់នាង: សូមអោយប្អូនប្រុសអាំណូននៅជាមួយអ្នក?
ព្រោះគាត់ជាបងប្អូនរបស់អ្នក.
13:21 ហើយនៅពេលដែលស្តេចដាវីឌបាន heard អំពីរឿងទាំងនេះ, គាត់មានទុក្ខព្រួយយ៉ាងខ្លាំង.
ព្រោះគាត់ស្រឡាញ់គាត់, ចាប់តាំងពីគាត់ជាកូនច្បងរបស់គាត់.
ចំពោះអាប់សាឡំមស្អប់អាំណូនដោយសារគាត់បានរំលោភប្អូនស្រីរបស់គាត់ឈ្មោះតាម៉ារ.
ហើយអាប់សាឡំមបានអញ្ជើញបុត្រាទាំងអស់របស់ស្តេច.
ខ្ញុំស្នើសុំថាស្តេច, ជាមួយអ្នកបំរើរបស់គាត់, ប្រហែលជាមករកអ្នកបំរើរបស់គាត់” ។
13:26 ហើយអាប់សាឡំមបាននិយាយ, ប្រសិនបើអ្នកមិនចង់មកទេ, ខ្ញុំ សូម អង្វរ អ្នក, យ៉ាងហោចណាស់ត្រូវអោយបងប្រុសខ្ញុំអាំណូនមកជាមួយពួកយើង” ។ ព្រះរាជាមានរាជឱង្ការទៅកាន់លោក, គាត់មិនចាំបាច់ទៅជាមួយអ្នកទេ” ។
អាប់សាឡំមបានធ្វើពិធីជប់លៀងមួយ, ដូចជាបុណ្យរបស់ស្តេច.
ហើយនៅពេលខ្ញុំនិយាយទៅកាន់អ្នក, Stri វាយហើយសម្លាប់ចោល!' កុំ ខ្លាច.
ចូរមានកម្លាំងនិងក្លាហានឡើង។
ហើយកូនប្រុសទាំងអស់របស់ស្តេចបានក្រោកឡើង, ហើយម្នាក់ៗបានឡើងលើលារបស់វាហើយរត់គេចខ្លួន.
13:31 ហើយដូច្នេះស្តេចបានក្រោកឡើង, ហើយគាត់បានហែកសម្លៀកបំពាក់របស់គាត់, ហើយគាត់ក៏ក្រាបចុះដល់ដី.
ចាប់តាំងពីថ្ងៃដែលគាត់រំលោភនាងតាម៉ារជាប្អូនស្រីរបស់គាត់គាត់បានតទល់នឹងមាត់របស់អាប់សាឡំម.
ហើយមើលចុះ, មានមនុស្សជាច្រើនបានធ្វើដំណើរតាមផ្លូវដាច់ស្រយាលមួយនៅចំហៀងភ្នំ.
13:38 ឥឡូវនេះបន្ទាប់ពីគាត់បានភៀសខ្លួនហើយបានទៅដល់ហ្គេសស៊ូ, អាប់សាឡំមបាននៅកន្លែងនោះអស់រយៈពេលបីឆ្នាំ.
14:2 ដូច្នេះគាត់ក៏បញ្ជូនទៅធីកូ, ហើយគាត់បាននាំស្ត្រីម្នាក់ដែលមានប្រាជ្ញាពីទីនោះ.
14:4 ហើយ ដូច្នេះ, នៅពេលដែលស្ត្រីឈ្មោះធីកូបានចូលគាល់ស្តេច, នាងដួលនៅចំពោះមុខលោក, ហើយនាងបានគោរព, ហើយនាងបាននិយាយថា, “ សង្គ្រោះខ្ញុំ, បពិត្រព្រះរាជា។
សម្រាប់ប្តីរបស់ខ្ញុំបានស្លាប់.
14:8 ព្រះរាជាមានរាជឱង្ការទៅកាន់ស្ត្រីនោះ, “ ទៅផ្ទះរបស់អ្នក, ហើយខ្ញុំនឹងចេញក្រឹត្យជំនួសអ្នក»។
ប៉ុន្តែសូមអោយព្រះមហាក្សត្រនិងបល្ល័ង្ករបស់ព្រះអង្គគ្មានទោសពៃរ៍ឡើយ។
14:15 ដូច្នេះ, ឥឡូវនេះខ្ញុំបានមកនិយាយពាក្យនេះជាមួយនឹងព្រះករុណាជាអម្ចាស់, នៅចំពោះមុខប្រជាជន.
14:16 ព្រះរាជាក៏ស្តាប់តាម, ហើយគាត់បានដោះលែងអ្នកបំរើរបស់គាត់ពីកណ្តាប់ដៃរបស់អស់អ្នកដែលចង់យកខ្ញុំនិងកូនប្រុសរបស់ខ្ញុំជាមួយគ្នា, ពីមរតករបស់ព្រះជាម្ចាស់.
លោកយ៉ូអាប់ជាអ្នកបំរើរបស់លោកបានណែនាំខ្ញុំ, ហើយខ្លួនគាត់ផ្ទាល់បានដាក់ពាក្យទាំងអស់នេះនៅក្នុងមាត់ស្រីរបស់អ្នក.
ដូច្នេះ, ចូរទៅហៅអាប់សាឡំមមកវិញ»។
ពីតែមួយគត់នៃជើងរហូតដល់កំពូលនៃក្បាល, នៅក្នុងខ្លួនគាត់គ្មានស្នាមជាំទេ.
14:27 បន្ទាប់មកកូនប្រុសបីនាក់បានកើតមកអាប់សាឡំម, និងកូនស្រីម្នាក់, នៃសំណុំបែបបទឆើតឆាយ, ឈ្មោះរបស់គាត់គឺតាម៉ា.
ដូច្នេះ, ចូរចេញទៅដុតវាចោលទៅ” ។ ហើយ ដូច្នេះ, ពួកអ្នកបម្រើរបស់អាប់សាឡំមបានដុតចោលស្រែចម្ការ.
14:31 លោកយ៉ូអាប់ក៏ក្រោកឡើង, លោកចូលទៅអាប់សាឡុមនៅផ្ទះរបស់លោក, ហើយគាត់បាននិយាយ, ហេតុអ្វីបានជាពួកបាវរបស់លោកយកភ្លើងទៅស្រែខ្ញុំ?”
វាជាការប្រសើរសម្រាប់ខ្ញុំដែលបាននៅទីនោះ។ ខ្ញុំសូមអង្វរអ្នក, ដូច្នេះ, ដើម្បីអោយខ្ញុំបានឃើញមុខព្រះមហាក្សត្រ.
14:33 ហើយ ដូច្នេះ, យ៉ូអាប់, ចូលគាល់ព្រះរាជា, បានរាយការណ៍ប្រាប់គាត់អំពីរឿងទាំងអស់.
គាត់ចូលគាល់ព្រះរាជា, ព្រះអង្គក៏ក្រាបថ្វាយបង្គំនៅលើផែនដី.
15:2 ហើយក្រោកឡើងនៅពេលព្រឹក, អាប់សាឡំមឈរក្បែរទ្វារចូលខ្លោងទ្វារ.
15:3 អាប់សាឡំមនឹងឆ្លើយទៅគាត់: “ សំដីរបស់អ្នកមើលទៅល្អហើយសំរាប់ខ្ញុំ.
15:7 បន្ទាប់មក, បន្ទាប់ពីសែសិបឆ្នាំ, អាប់សាឡំមទូលស្ដេចដាវីឌ: ខ្ញុំគួរតែទៅហើយស្បថ ឲ្យ ខ្ញុំ, ដែលខ្ញុំបានស្បថនឹងព្រះអម្ចាស់នៅក្រុងហេប្រុន.
15:11 ឥឡូវនេះត្រូវបានគេហៅ, មានបុរសពីររយនាក់មកពីក្រុងយេរូសាឡឹមចេញទៅអាប់សាឡំម, ទៅដោយភាពសាមញ្ញនៃបេះដូងនិងត្រូវបានល្ងង់ខ្លៅទាំងស្រុងនៃផែនការ.
15:14 លោកដាវីឌមានប្រសាសន៍ទៅកាន់អ្នកបម្រើរបស់លោក, ដែលនៅជាមួយគាត់នៅក្រុងយេរូសាឡឹម: "លេចឡើង, ចូរនាំគ្នារត់គេចខ្លួនទៅ!
ប្រញាប់ចាកចេញ, ក្រែងលោប្រហែលជា, ពេលមកដល់, គាត់អាចចាប់យើង, ហើយបង្ខំឱ្យបំផ្លាញយើង, ហើយវាយយកទីក្រុងដោយដាវ»។
15:16 ដូច្នេះ, ស្តេចចេញទៅ, ជាមួយគ្រួសាររបស់គាត់ទាំងមូល.
15:17 និងចេញទៅនៅលើជើង, ព្រះរាជានិងជនជាតិអ៊ីស្រាអែលទាំងមូលនៅឆ្ងាយពីផ្ទះ.
និងកងពលរបស់សេរេតនិងផាលេត, និងហ្គីតទាំងអស់, អ្នកប្រយុទ្ធដ៏មានឥទ្ធិពល, មានបុរសប្រាំមួយរយនាក់ដែលបានដើរតាមព្រះអង្គពីកាថដោយថ្មើរជើង, មុនស្តេច.
វិលត្រឡប់មករស់នៅជាមួយស្តេចវិញ.
សម្រាប់ខ្ញុំគួរតែទៅកន្លែងដែលខ្ញុំនឹងទៅ.
ហើយព្រះអម្ចាស់នឹងបង្ហាញសេចក្តីមេត្តាករុណានិងសេចក្តីពិតដល់អ្នក, ពីព្រោះអ្នកបានបង្ហាញព្រះគុណនិងជំនឿ។
ស្តេចក៏បានឆ្លងកាត់ជ្រលងភ្នំឃីដរ៉ុន.
15:24 ឥឡូវបូជាចារ្យសាដុកក៏ទៅ, ក្រុមលេវីទាំងអស់ក៏ទៅជាមួយដែរ, ដឹកហិបនៃសេចក្ដីសញ្ញារបស់ព្រះ.
លោកអបៀថើរក៏ឡើងទៅ, ទាល់តែប្រជា ជនទាំងប៉ុន្មានដែលចាកចេញពីទីក្រុងមក.
ប្រសិនបើខ្ញុំនឹងរកឃើញព្រះគុណនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់, គាត់នឹងនាំខ្ញុំត្រឡប់មកវិញ.
15:27 ព្រះរាជាមានរាជឱង្ការទៅកាន់លោកបូជាចារ្យសាដុក: «អ្នកមើលឆុត, ត្រឡប់ចូលទីក្រុងវិញដោយសុខសាន្ត.
15:28 មើល, ខ្ញុំនឹងពួននៅតាមវាលទំនាបវាលខ្សាច់, ទាល់តែមានដំណឹងពីអ្នកមកដល់ដើម្បីជូនដំណឹងដល់ខ្ញុំ” ។
15:30 ប៉ុន្តែដាវីឌបានឡើងទៅលើភ្នំដើមអូលីវ, ឡើងហើយយំ, ទៅមុខដោយជើងទទេរនិងក្បាលរបស់គាត់គ្របបាំង.
15:31 មានគេរាយការណ៍មកលោកដាវីឌថាលោកអហ៊ីថូផែលក៏បានស្បថជាមួយអាប់សាឡំមដែរ.
15:32 ហើយនៅពេលដែលដាវីឌបានឡើងទៅលើកំពូលភ្នំ, កន្លែងដែលគាត់ត្រូវគោរពកោតខ្លាចព្រះអម្ចាស់, លោកហ៊ូសាយជាអ្នកស្រុក Archite បានជួបលោក, គាត់ស្លៀកសម្លៀកបំពាក់រហែកហើយក្បាលរបស់គាត់គ្របលើដី.
15:34 ប៉ុន្តែប្រសិនបើអ្នកត្រឡប់ទៅទីក្រុងវិញ, ហើយអ្នកនិយាយនឹងអាប់សាឡំម, ខ្ញុំជាអ្នកបំរើរបស់អ្នក, បពិត្រព្រះរាជា; ដូចខ្ញុំធ្លាប់ធ្វើជាឪពុករបស់ឪពុកអ្នកដែរ, យើងនឹងធ្វើជាអ្នកបំរើរបស់អ្នកដែរ,អ្នកនឹងបំផ្លាញដំបូន្មានរបស់អ័ហ៊ីថូផែល
ហើយពាក្យអ្វីក៏ដោយដែលអ្នកនឹង from ពីព្រះបរមរាជវាំង, អ្នកនឹងបង្ហាញវាដល់សាដុកនិងអបៀថើរ, បូជាចារ្យ.
ហើយអ្នកនឹងចាត់ខ្ញុំមកពួកគេនូវរាល់ពាក្យទាំងប៉ុន្មានដែលអ្នកបាន។ ” ។
អាប់សាឡំមក៏ចូលដល់ក្រុងយេរូសាឡិមដែរ.
16:1 ហើយនៅពេលដែលដាវីឌបានដើរកាត់បន្តិចពីលើកំពូលភ្នំ, ហ្សីបា, អ្នកបំរើរបស់មភីបូសែត, បានលេចមកជួបគាត់, ជាមួយសត្វលាពីរ, គេបានដាក់នំបុ័ងពីររយដុំ, និងទំពាំងបាយជូរស្ងួតមួយរយបាច់, និងមួយរយម៉ាស់ផ្លែល្វាស្ងួត, និងស្បែកស្រា.
16:3 ហើយព្រះរាជាមានបន្ទូល, តើកូនរបស់លោកម្ចាស់នៅឯណា? ?លោកស៊ីបាទូលព្រះរាជា: លោកបានស្នាក់នៅក្រុងយេរូសាឡឹម, និយាយ, ‘ថ្ងៃនេះ, កូនចៅអ៊ីស្រាអែលនឹងប្រគល់នគររបស់ឪពុកខ្ញុំមកអោយខ្ញុំវិញ” ។
16:5 បន្ទាប់មកព្រះ បាទដាវីឌក៏យាងទៅដល់ស្រុកបាហ៊ូរីម.
ហើយចេញទៅក្រៅ, គាត់បានបន្ត, ហើយគាត់កំពុងដាក់បណ្តាសា,
ហើយប្រជាជននិងអ្នកចម្បាំងទាំងអស់បានធ្វើដំណើរទៅខាងស្តាំនិងខាងឆ្វេងនៃព្រះរាជា.
16:8 ព្រះអម្ចាស់បានតបស្នងដល់អ្នករាល់គ្នាវិញចំពោះឈាមទាំងប៉ុន្មានរបស់ក្រុមគ្រួសារសូល.
ហើយ ដូច្នេះ, ព្រះ អម្ចាស់ប្រគល់ព្រះ រាជាទៅក្នុងកណ្ដាប់ដៃរបស់សម្ដេចអាប់ សា ឡុម, កូនប្រុស របស់ អ្នក.
16:9 បន្ទាប់មកអ័ប៊ីសាយ, កូនរបស់សេរូយ៉ា, បាននិយាយទៅកាន់ព្រះរាជា: ហេតុអ្វីបានជាឆ្កែងាប់នេះគួរតែជេរប្រមាថម្ចាស់របស់ខ្ញុំ?
ព្រះអម្ចាស់បានបញ្ជាអោយគេដាក់បណ្ដាសាដាវីឌ.
16:11 ព្រះរាជាមានរាជឱង្ការទៅកាន់លោកអប៊ីសាយនិងអ្នកបំរើទាំងអស់: «មើលចុះ, កូនប្រុស របស់ខ្ញុំ, ដែលចេញពីចង្កេះរបស់ខ្ញុំ, កំពុងស្វែងរកជីវិតរបស់ខ្ញុំ.
16:13 ហើយ ដូច្នេះ, ដាវីឌបន្តដើរទៅមុខទៀត, និងសហការីរបស់គាត់ជាមួយគាត់.
16:14 ហើយស្តេចនិងប្រជាជនទាំងមូលនៅជាមួយគាត់, ហត់នឿយ, បានទៅនិងធ្វើឱ្យស្រស់នៅទីនោះ.
លើសពីនេះទៅទៀត, អ័ហ៊ីថូផែលបាននៅជាមួយគាត់.
ហេតុអ្វីបានជាអ្នកមិនទៅជាមួយមិត្តរបស់អ្នក?”
ត្បិតខ្ញុំនឹងធ្វើជារបស់គាត់, ដែលព្រះអម្ចាស់បានជ្រើសរើស.
ដូចខ្ញុំបានចុះចូលនឹងឪពុករបស់អ្នកដែរ, ខ្ញុំក៏នឹងចុះចូលចំពោះអ្នកដែរ»។
16:21 លោកអហ៊ីថូផែលមានប្រសាសន៍ទៅកាន់អាប់សាឡំម: “ ចូរចូលទៅកាន់ប្រពន្ធចុងរបស់ឪពុកអ្នកចុះ, ដែលគាត់បានទុកចោលដើម្បីមើលថែរក្សាផ្ទះ.
16:22 ដូច្នេះ, ពួកគេបានបោះតង់សំរាប់អាប់សាឡំមនៅលើដំបូល.
16:23 ឥឡូវឱវាទរបស់អាហ៊ីថូផែល, ដែលលោកបានអោយនៅគ្រានោះ, ត្រូវបានគេចាត់ទុកដូចជាមនុស្សម្នាក់កំពុងតែពិគ្រោះជាមួយព្រះ.
17:2 ហើយប្រញាប់ប្រញាល់ទាស់នឹងគាត់, ដ្បិតគាត់នឿយហត់ហើយទន់ខ្សោយ, ខ្ញុំនឹងវាយគាត់.
17:3 ហើយខ្ញុំនឹងនាំប្រជាជនទាំងមូលមកវិញ, វិលត្រឡប់មកវិញតាមរបៀបរបស់បុរសតែម្នាក់.
ហើយប្រជាជនទាំងអស់នឹងមានសន្តិភាព” ។
17:5 ប៉ុន្តែអាប់សាឡំមបាននិយាយ, “ កោះហៅលោកហ៊ូសាយជាអ្នកស្រុក, ហើយសូមយើងស្តាប់នូវអ្វីដែលគាត់នឹងនិយាយផង” ។
17:7 លោកហ៊ូសាយមានប្រសាសន៍ទៅកាន់អាប់សាឡំម, “ ឱវាទដែលអាហ៊ីថូផែលបានផ្តល់នៅពេលនេះគឺមិនល្អទេ” ។
លើសពីនេះទៅទៀត, ឪពុករបស់អ្នកគឺជាអ្នកចំបាំងម្នាក់, ដូច្នេះគាត់នឹងមិនរស់នៅក្នុងចំណោមប្រជាជនទេ.
ហើយប្រសិនបើចៃដន្យ, ពេល ចាប់ផ្តើម, នរណាម្នាក់អាចនឹងធ្លាក់ចុះ, អ្នកដែលលឺអំពីវា, មិនថាគាត់បាន heard អ្វីក៏ដោយ, នឹងនិយាយ, ក្នុងចំណោមប្រជាជនដែលដេញតាមអាប់សាឡំមមានការកាប់សម្លាប់មនុស្សជាច្រើន។
សម្រាប់ជនជាតិអ៊ីស្រាអែលទាំងអស់ដឹងថាឪពុករបស់អ្នកជាមនុស្សក្លាហាន, ហើយថាមនុស្សទាំងអស់ដែលនៅជាមួយគាត់រឹងមាំ.
ហើយអ្នកនឹងស្ថិតនៅក្នុងចំណោមពួកគេ.
ហើយយើងនឹងគ្របដណ្តប់គាត់, ទឹកសន្សើមធ្លាក់លើដី.
17:13 ហើយប្រសិនបើគាត់នឹងចូលទៅក្នុងទីក្រុងណាមួយ, ជនជាតិអ៊ីស្រាអែលទាំងអស់នឹងព័ទ្ធជុំវិញទីក្រុងដោយខ្សែពួរ.
17:14 និងអាប់សាឡំម, ជាមួយបុរសអ៊ីស្រាអែលទាំងអស់, បាននិយាយ: “ ឱវាទរបស់ហ៊ូសាយ Archite គឺប្រសើរជាងដំបូន្មានរបស់ Ahithophel” ។ ដូច្នេះ, ដោយទង្វើរបស់ព្រះអម្ចាស់, ឱវាទដែលមានប្រយោជន៍របស់អ័ហ៊ីថូផែលបានបរាជ័យ, ដើម្បីអោយព្រះអម្ចាស់ដឹកនាំអំពើអាក្រក់លើអាប់សាឡំម.
ហើយខ្ញុំបានផ្តល់ដំបូន្មានតាមរបៀបបែបនេះ.
17:17 ប៉ុន្តែសម្តេចយ៉ូណាថាននិងលោកអហ៊ីម៉ាហ្សានៅតែនៅក្បែរប្រភពទឹកនៃហ្គែល.
17:18 ប៉ុន្តែមានបុរសវ័យក្មេងម្នាក់បានឃើញពួកគេ, ហើយគាត់បានបង្ហាញវាទៅអាប់សាឡំម.
17:20 នៅពេលដែលអ្នកបំរើរបស់អាប់សាឡំមបានចូលទៅក្នុងផ្ទះ, ពួកគេបាននិយាយទៅកាន់ស្ត្រីនោះ, អាហ៊ីម៉ាហ្សានិងយ៉ូណាថាននៅឯណា?ស្ត្រីនោះឆ្លើយទៅពួកគេ, ពួកគេឆ្លងកាត់យ៉ាងលឿន, បន្ទាប់ពីពួកគេបានយកទឹកបន្តិច។ ប៉ុន្តែអ្នកដែលកំពុងស្វែងរកពួកគេ, នៅពេលដែលពួកគេរកមិនឃើញ, ត្រឡប់ទៅក្រុងយេរូសាឡឹមវិញ.
និងការធ្វើដំណើរ, ពួកគេនាំដំណឹងទៅទូលព្រះ បាទដាវីឌ, ហើយពួកគេនិយាយ: "លេចឡើង, ហើយឆ្លងកាត់ទន្លេយ៉ាងលឿន.
17:22 ដូច្នេះ, ដាវីឌក្រោកឡើង, និងមនុស្សទាំងអស់ដែលនៅជាមួយគាត់, ពួកគេឆ្លងទន្លេយ័រដាន់, រហូតដល់ពន្លឺដំបូង.
17:23 បន្ទាប់មកអ័ហ៊ីថូផែល, គេឃើញថាដំបូន្មានរបស់គាត់មិនទាន់បានសំរេចទេ, ក្រាលលាលារបស់គាត់, អ្នកខ្វិនក៏ក្រោកឡើងដើរត្រឡប់ទៅផ្ទះវិញនិងនៅក្រុងរបស់ខ្លួន.
ហើយគាត់ត្រូវបានគេបញ្ចុះនៅក្នុងផ្នូររបស់ឪពុកគាត់.
18:2 លោកដាក់ប្រជាជនមួយភាគបីនៅក្រោមកណ្ដាប់ដៃរបស់លោកយ៉ូអាប់, និងមួយភាគបីស្ថិតនៅក្រោមដៃរបស់អ័ប៊ីសាយ, កូនរបស់សេរូយ៉ា, បងប្អូនរបស់យ៉ូអាប់, និងមួយភាគបីស្ថិតនៅក្រោមដៃរបស់ Ittai, គាត់មកពី Gath.
ឬប្រសិនបើយើងពាក់កណ្តាលនឹងធ្លាក់ចុះ, ពួកគេនឹងមិនខ្វល់ច្រើនទេ.
ហើយប្រជាជនបានចេញទៅដោយកងទ័ពរបស់ពួកគេ, ដោយរាប់រយនិងរាប់ពាន់នាក់.
18:6 ហើយ ដូច្នេះ, ប្រជា ជននាំគ្នាចេញទៅប្រយុទ្ធនៅវាលស្រែ.
18:7 កង ទ័ពអ៊ីស្រា អែលត្រូវគេកម្ទេចនៅកន្លែងនោះ.
18:8 ឥឡូវនេះសមរភូមិនៅកន្លែងនោះបានខ្ចាត់ខ្ចាយពាសពេញលើទឹកដីទាំងមូល.
18:9 បន្ទាប់មកវាបានកើតឡើងដែលអាប់សាឡំម, ជិះលើសេហ, បានជួបអ្នកបំរើរបស់ដាវីឌ.
18:11 លោកយ៉ូអាប់មានប្រសាសន៍ទៅកាន់បុរសដែលបានរាយការណ៍មកលោក, “ ប្រសិនបើអ្នកបានឃើញគាត់, ហេតុអ្វីបានជាអ្នកមិនចាក់គាត់ទៅនឹងដី, ខ្ញុំនឹងអោយប្រាក់ដប់តម្លឹងនិងខ្សែក្រវ៉ាត់មួយដល់អ្នក?”
18:15 បុរសវ័យក្មេងដប់នាក់, អ្នកកាន់គ្រឿងសាស្ត្រាវុធរបស់យ៉ូអាប់, រត់ឡើង, ហើយធ្វើកូដកម្មគាត់, ពួកគេបានសម្លាប់គាត់.
18:17 ហើយពួកគេបានយកអាប់សាឡំម, ហើយពួកគេបានបោះគាត់ទៅក្នុងរណ្ដៅមួយដ៏ធំនៅក្នុងព្រៃ.
18:19 បន្ទាប់មកអាម៉ាម៉ាសា, កូនប្រុសរបស់លោកសាដុក, បាននិយាយ, ខ្ញុំនឹងរត់ទៅទូលស្ដេចថាព្រះអម្ចាស់បានសំរេចតាមការវិនិច្ឆ័យរបស់ព្រះអង្គ, ពីកណ្តាប់ដៃរបស់ខ្មាំងសត្រូវរបស់គាត់។
ជំនួស, អ្នកត្រូវរាយការណ៍នៅថ្ងៃមួយទៀត.
18:21 លោកយ៉ូអាប់មានប្រសាសន៍ទៅកាន់លោកហូសៃ, “ ទៅ, ហើយរាយការណ៍ប្រាប់ស្ដេចនូវអ្វីដែលអ្នកបានឃើញ»។ ហ៊ូសាយគោរពបូជាដល់យ៉ូអាប់, ហើយគាត់បានរត់.
18:23 ហើយគាត់បានឆ្លើយតប, ប៉ុន្តែចុះបើខ្ញុំរត់?លោកឆ្លើយថា៖, រត់។ បន្ទាប់មកអាម៉ាម៉ាសា, រត់តាមផ្លូវខ្លីជាង, ហាសហាស.
ពិត, អ្នកយាម, គេឈរនៅលើកំពូលភ្នំនៃខ្លោងទ្វារ, ងើបភ្នែកឡើង, ឃើញបុរសម្នាក់រត់តែម្នាក់ឯង.
18:28 បន្ទាប់មក, អាម៉ាម៉ាហ្សា, ស្រែកចេញ, បាននិយាយទៅកាន់ព្រះរាជា, “ សុខសប្បាយជាទេ, បពិត្រព្រះរាជា។ ហើយក្រាបថ្វាយបង្គំព្រះរាជាក្រាបនៅនឹងដី, គាត់ បាន និយាយ ថា, «សូមលើកតម្កើងព្រះអម្ចាស់ជាព្រះរបស់អ្នក, ដែលបានព័ទ្ធជុំវិញពួកអ្នកដែលបានលើកដៃប្រឆាំងនឹងព្រះករុណាជាអម្ចាស់»។
ខ្ញុំមិនដឹងអ្វីផ្សេងទេ។
ថ្ងៃនេះព្រះអម្ចាស់វិនិច្ឆ័យទោសអ្នករាល់គ្នាហើយ, ពីកណ្តាប់ដៃរបស់អស់អ្នកដែលបានបះបោរប្រឆាំងនឹងអ្នក»។
18:33 ហើយដូច្នេះស្តេច, កំពុងមានទុក្ខព្រួយយ៉ាងខ្លាំង, ឡើងទៅបន្ទប់ខាងលើនៃខ្លោងទ្វារ, ហើយគាត់យំ.
អាប់សាឡំមកូនប្រុសខ្ញុំ!
អាប់សាឡំម, កូនប្រុស របស់ខ្ញុំ!
19:2 ដូច្នេះជ័យជំនះនៅថ្ងៃនោះបានប្រែក្លាយជាការកាន់ទុក្ខសម្រាប់ប្រជាជនទាំងអស់.
19:3 នៅថ្ងៃនោះប្រជាជនបានបដិសេធមិនព្រមចូលក្រុងឡើយ, នៅក្នុងរបៀបដែលប្រជាជនត្រូវបានគេទម្លាប់ធ្វើការកត់សំគាល់ធ្លាក់ចុះប្រសិនបើពួកគេបានងាកនិងភៀសខ្លួនពីសមរភូមិ.
19:6 អ្នកស្រឡាញ់អ្នកដែលស្អប់អ្នក, ហើយអ្នកស្អប់អ្នកដែលស្រឡាញ់អ្នក.
ហើយពិត, ឥឡូវខ្ញុំដឹងថាបើអាប់សាឡំមរស់នៅ, ហើយប្រសិនបើយើងទាំងអស់គ្នាត្រូវបានសម្លាប់, ពេលនោះអ្នកនឹងពេញចិត្ដ.
ដ្បិតខ្ញុំសូមស្បថក្នុងនាមព្រះអម្ចាស់ថាប្រសិនបើអ្នកមិនចាកចេញទៅទេនោះ, នៅយប់នេះសូម្បីតែម្នាក់ក៏គ្មានសល់ម្នាក់ដែរ.
19:9 ហើយប្រជាជនទាំងអស់មានទំនាស់គ្នា, នៅគ្រប់កុលសម្ព័ន្ធអ៊ីស្រាអែល, និយាយ: ស្តេចបានដោះលែងយើងពីកណ្តាប់ដៃរបស់ខ្មាំងសត្រូវ.
តែឥឡូវនេះគាត់បានរត់គេចពីស្រុកដើម្បីជាប្រយោជន៍ដល់អាប់សាឡំម.
តើអ្នកនឹងនៅស្ងៀមដល់ពេលណា?, ហើយមិននាំស្តេចត្រឡប់មកវិញ?”
(ព្រោះសុន្ទរកថានៅស្រុកអ៊ីស្រាអែលទាំងមូលបានទៅដល់ព្រះរាជានៅក្នុងផ្ទះ។)
ហេតុអ្វីបានជាអ្នកជាមនុស្សចុងក្រោយដែលនាំស្តេចត្រឡប់មកវិញ?'
ព្រះអាចធ្វើរឿងទាំងនេះបាន, ហើយគាត់អាចបន្ថែមរបស់ផ្សេងទៀត, ប្រសិនបើអ្នកមិនមែនជាមេដឹកនាំយោធានៅចំពោះមុខខ្ញុំទេនោះ, សម្រាប់គ្រប់ពេលវេលា, ជំនួសយ៉ូអាប់។ '
ពួកគេបានចាត់គេអោយទៅទូលស្តេច, និយាយ, “ ត្រឡប់មកវិញ, អ្នកនិងបាវបំរើទាំងអស់” ។
ហើយលោកបានទៅដល់ទន្លេយ័រដាន់, អ្នកស្រុកយូដាទាំងមូលធ្វើដំណើររហូតដល់គីលកាល់, ដូច្នេះដើម្បីជួបស្តេច, និងដើម្បីដឹកនាំគាត់ឆ្លងកាត់ទន្លេយ័រដាន់.
19:17 ជាមួយបុរសមួយពាន់នាក់មកពីបេនយ៉ាមីន, និងជាមួយហ្សីបា, ខ្ញុំបម្រើដែលជាអ្នករាជការនៅក្នុងផ្ទះរបស់សូល.
ហើយធ្វើដំណើរឆ្ពោះទៅទន្លេយ័រដាន់,
បន្ទាប់មក, ស៊ីមី, កូនប្រុសរបស់កេរ៉ា, ក្រាបថ្វាយបង្គំនៅចំពោះព្រះភក្ត្រស្តេចក្រោយពេលដែលព្រះអង្គឆ្លងទន្លេយ័រដាន់មក,
ហើយសូមកុំទុកវានៅក្នុងចិត្តរបស់អ្នក, បពិត្រព្រះរាជា.
ហេតុអ្វីបានជាមាននរណាម្នាក់ត្រូវគេសម្លាប់នៅថ្ងៃនេះនៅស្រុកអ៊ីស្រាអែល??
សម្រាប់ខ្ញុំ, អ្នកបំរើរបស់អ្នក, ខ្ញុំជាមនុស្សខ្វិន.
ប៉ុន្តែ អ្នក, ព្រះករុណាជាអម្ចាស់, គឺដូចជាទេវតារបស់ព្រះជាម្ចាស់.
19:28 ព្រោះផ្ទះឪពុកខ្ញុំស័ក្តិសមនឹងគ្មានអ្វីក្រៅពីការសោយទិវង្គតនៅចំពោះមុខព្រះករុណាជាអម្ចាស់.
ដូច្នេះ, អ្វីដែលខ្ញុំអាចមានពាក្យបណ្តឹង?
19:31 ដូចគ្នា, បាស៊ីឡៃពីស្រុកកាឡាត, ចុះពី Rogelim, នាំស្តេចឆ្លងទន្លេយ័រដាន់, គាត់បានរៀបចំខ្លួនដើរតាមព្រះយេស៊ូនៅត្រើយខាងនាយទន្លេ.
19:33 ដូច្នេះព្រះរាជាមានរាជឱង្ការទៅកាន់លោកបាស៊ីឡៃ, "មក ជាមួយ ខ្ញុំ, ដូច្នេះអ្នករាល់គ្នានឹងបាននៅជាមួយខ្ញុំនៅក្រុងយេរូសាឡឹមប្រកបដោយសុវត្ថិភាព»។
ឬម្ហូបអាហារនិងភេសជ្ជៈអាចរីករាយដល់អ្នកបំរើរបស់អ្នក?
ហេតុអ្វីបានជាបាវបម្រើរបស់លោកគួរធ្វើជាបន្ទុកដល់ព្រះ ករុណាជាអម្ចាស់!
ខ្ញុំមិនត្រូវការការតបស្នងសងគុណនេះទេ.
19:38 ដូច្នេះព្រះរាជាមានរាជឱង្ការទៅកាន់លោក: “ សូមឱ្យជឹមហាំឆ្លងកាត់ជាមួយខ្ញុំ, ហើយខ្ញុំនឹងធ្វើអ្វីដែលគាត់ចង់អោយអ្នក.
19:39 នៅពេលប្រជាជនទាំងមូលនិងស្តេចបានឆ្លងទន្លេយ័រដាន់, ស្តេចថើបលោកបាស៊ីឡៃ, ព្រះអង្គក៏ប្រទានពរដល់គាត់.
19:40 ព្រះរាជាយាងបន្តទៅគីលកាល់, ហើយជឹមမ်បានទៅជាមួយគាត់.
19:41 ហើយ ដូច្នេះ, បុរសទាំងអស់របស់ជនជាតិអ៊ីស្រាអែល, រត់ទៅស្តេច, បាននិយាយទៅគាត់: ហេតុអ្វីបានជាបងប្អូនរបស់យើង, បុរសជនជាតិយូដា, លួចអ្នកចេញ.
19:42 ហើយប្រជាជនយូដាទាំងអស់ឆ្លើយតបនឹងជនជាតិអ៊ីស្រាអែល: “ ពីព្រោះស្តេចនៅជិតខ្ញុំ.
ហេតុអ្វីបានជាអ្នកធ្វើឱ្យខ្ញុំរងរបួស, ហេតុអ្វីបានជាខ្ញុំមិនប្រាប់ខ្ញុំមុន?, ដូច្នេះខ្ញុំនឹងនាំស្តេចរបស់ខ្ញុំមកវិញ?ប៉ុន្តែជនជាតិយូដាឆ្លើយយ៉ាងមុតមាំជាងជនជាតិអ៊ីស្រាអែលទៅទៀត.
20:2 ហើយជនជាតិអ៊ីស្រាអែលទាំងអស់បានញែកខ្លួនចេញពីដាវីឌ, ពួកគេដើរតាមសេបា, កូនប្រុសរបស់ Bichri.
20:3 ពេលព្រះរាជាយាងចូលក្នុងក្រុងយេរូសាឡិម, លោកបានយកស្ត្រីពីរនាក់ជាប្រពន្ធចុង, ដែលគាត់បានទុកចោលដើម្បីមើលថែរក្សាផ្ទះ, ហើយគាត់បានឃុំឃាំងពួកគេ, អនុញ្ញាតឱ្យពួកគេបទប្បញ្ញត្តិ.
ជំនួស, ពួកគេត្រូវបានរុំព័ទ្ធ, សូម្បីតែថ្ងៃនៃការស្លាប់របស់ពួកគេ, រស់នៅជាស្ត្រីមេម៉ាយ.
20:5 ដូច្នេះ, អាម៉ាសាបានចេញទៅ, ដូច្នេះគាត់នឹងកោះហៅអ្នកស្រុកយូដា.
20:6 លោកដាវីឌមានប្រសាសន៍ទៅលោកអប៊ីសាយ: “ ឥឡូវសេបា, កូនប្រុសរបស់ Bichri, នឹងធ្វើបាបយើងច្រើនជាងអាប់សាឡំមទៅទៀត.
20:8 ហើយនៅពេលពួកគេនៅក្បែរថ្មដ៏ធំ, ដែលនៅគីបៀន, អាម៉ាសាបានមកជួបពួកគេ.
ហើយលើទាំងនេះ, គេយកដាវចងជាប់នឹងភ្លៅ, នៅក្នុងដាវមួយដែលត្រូវបានបង្កើតឡើងដូច្នេះដាវអាចត្រូវបានយកចេញដោយចលនាតិចបំផុត, ហើយបន្ទាប់មកធ្វើកូដកម្ម.
20:10 ប៉ុន្តែអាម៉ាសាមិនបានកត់សម្គាល់នូវដាវដែលយ៉ូអាប់មានទេ.
20:11 ទន្ទឹមនឹងនេះ, បុរសជាក់លាក់, មកពីក្រុមហ៊ុនយ៉ូអាប់, នៅពេលដែលពួកគេបានឈប់នៅក្បែរសាកសពរបស់អាម៉ាសា, បាននិយាយ: «មើលចុះ, អ្នកដែលចង់នៅជំនួសយ៉ូអាប់, ដៃគូរបស់ដាវីឌ
បុរសម្នាក់បានឃើញរឿងនេះ, ជាមួយមនុស្សទាំងអស់ដែលឈរក្បែរនោះដើម្បីមើលគាត់, ហើយគាត់បានយកអាម៉ាសាចេញពីផ្លូវចូលទៅក្នុងចំការមួយ.
20:13 បន្ទាប់មក, នៅពេលដែលគាត់ត្រូវបានគេយកចេញពីផ្លូវ, បុរសទាំងអស់បានបន្តដំណើរទៅមុខទៀត, ដេញតាមលោកយ៉ូអាប់ក្នុងការតាមសេបា, កូនប្រុសរបស់ Bichri.
ហើយបុរសដែលបានជ្រើសរើសទាំងអស់បានប្រមូលផ្តុំគ្នានៅឯគាត់.
20:16 ហើយស្ត្រីមានប្រាជ្ញាម្នាក់បានស្រែកចេញពីទីក្រុង: “ ស្តាប់, ស្តាប់, ហើយនិយាយទៅកាន់លោកយ៉ូអាប់: គូរជិត, ហើយខ្ញុំនឹងនិយាយជាមួយអ្នក។
20:18 ហើយម្តងទៀតនាងបាននិយាយ: “ មានពាក្យមួយបាននិយាយនៅក្នុងសុភាសិតចាស់, អ្នកដែលចង់សាកសួរ, អនុញ្ញាតឱ្យពួកគេសាកសួរអេបិល។ ដូច្នេះពួកគេនឹងឈានដល់ការសន្និដ្ឋាន.
ហើយអ្នករាល់គ្នាកំពុងតែចង់ដណ្តើមយកទីក្រុង, និងបំបាក់ម្តាយនៅអ៊ីស្រាអែល!
ហើយពួកគេបានកាត់ក្បាលសេបា, កូនប្រុសរបស់ Bichri, គេក៏បោះវាទៅ ឲ្យ លោកយ៉ូអាប់.
ប៉ុន្តែលោកយ៉ូអាប់វិលត្រឡប់ទៅក្រុងយេរូសាឡឹមវិញដើម្បីទូលស្តេច.
និងបេណាយ៉ា, កូនប្រុសរបស់យេហូយ៉ាដា, គឺនៅលើសេរេធីតនិងសេលេត.
ហើយពិតប្រាកដណាស់លោកសាដុកនិងអបៀថើរជាបូជាចារ្យ.
ព្រះ បាទដាវីឌទូលសួរព្រះ បន្ទូលរបស់ព្រះ អម្ចាស់.
លោកបានសម្លាប់អ្នកស្រុកគីបៀន»។
ឥឡូវគីបៀនមិនមែនជាកូនចៅអ៊ីស្រាអែលទេ, ប៉ុន្តែនៅសល់នៃជនជាតិអាម៉ូរី.
21:3 ដូច្នេះ, ដាវីឌបាននិយាយទៅកាន់ពួកគីបៀន: “ តើខ្ញុំត្រូវធ្វើអ្វីសំរាប់អ្នក?
21:4 អ្នកស្រុកគីបៀនឆ្លើយថា៖: “ គ្មានការទាស់ទែងគ្នានឹងយើងអំពីប្រាក់ឬមាសទេ, ប៉ុន្តែប្រឆាំងនឹងសូលនិងក្រុមគ្រួសាររបស់គាត់.
21:5 ពួកគេទូលស្ដេច: “ បុរសដែលធ្វើទុក្ខនិងជិះជាន់យើងដោយអយុត្តិធម៌, យើងត្រូវកម្ទេចចោលតាមរបៀបមួយដែលមិនត្រូវទុកអោយនៅសល់មួយចំណែករបស់ស្តេចនៅក្នុងទឹកដីអ៊ីស្រាអែលទាំងមូលឡើយ.
21:7 ប៉ុន្តែព្រះរាជាបានទុកព្រះភ័ក្ត្រមភីបូសែត, កូនប្រុសរបស់យ៉ូណាថាន, ជាកូនរបស់សូល, ព្រោះតែពាក្យសម្បថរបស់ព្រះអម្ចាស់ដែលលោកដាវីឌនិងយ៉ូណាថានបានស្បថ, ជាកូនរបស់សូល.
21:9 លោកប្រគល់ពួកគេទៅក្នុងកណ្ដាប់ដៃរបស់ជនជាតិគីបៀន.
ហើយស្រូវទាំងប្រាំពីរនេះបានធ្លាក់ជាមួយគ្នានៅថ្ងៃដំបូងនៃរដូវច្រូតកាត់, នៅពេលស្រូវកំពុងចាប់ផ្តើមប្រមូលផល.
21:12 ដាវីឌក៏ទៅយកឆ្អឹងរបស់សូល, និងឆ្អឹងរបស់សម្ដេចយ៉ូណាថានជាបុត្រ, ពីបុរសយ៉ាបេសកាឡាដ, ដែលបានលួចពួកគេពីផ្លូវបេតសាន, ជាកន្លែងដែលពួកភីលីស្ទីនបញ្ឈប់ពួកគេបន្ទាប់ពីពួកគេបានសម្លាប់សូលនៅគីលបោ.
ពួកគេធ្វើអ្វីៗទាំងអស់ដែលស្ដេចបានបញ្ជា.
21:15 បន្ទាប់មកជនជាតិភីលីស្ទីនបានច្បាំងនឹងអ៊ីស្រាអែលម្ដងទៀត.
ប៉ុន្ដែពេលដាវីឌមានកម្លាំងខ្សោយ,
21:17 និងអប៊ីសាយ, កូនរបស់សេរូយ៉ា, ការពារគាត់, ហើយវាយជនជាតិភីលីស្ទីននោះ, គាត់បានសម្លាប់គាត់.
21:18 ផងដែរ, សង្គ្រាមលោកលើកទី ២ បានកើតឡើងនៅកូបប្រឆាំងនឹងពួកភីលីស្ទីន.
21:19 បន្ទាប់មកមានសង្គ្រាមលើកទីបីនៅកូបប្រឆាំងនឹងពួកភីលីស្ទីន, ដែលក្នុងនោះ Adeodatus, កូនប្រុសរបស់ព្រៃមួយ, តម្បាញម្នាក់មកពីភូមិបេថ្លេហិម, បានវាយសម្លាប់កូលីយ៉ាតជាអ្នកស្រុកកាថ, លំពែងដែលលំពែងរបស់គេប្រៀបដូចជាធ្នឹមដែលប្រើដោយអ្នកផលិតក្រណាត់.
នៅកន្លែងនោះ, មានបុរសខ្ពង់ខ្ពស់ម្នាក់, ដែលមានលេខប្រាំមួយនៅលើដៃនិងជើងនីមួយៗ, នោះគឺ, ម្ភៃបួននៅក្នុងទាំងអស់, ហើយគាត់មកពីដើមកំណើតអារ៉ាផា.
ដូច្នេះយ៉ូណាថាន, កូនប្រុសរបស់ស៊ីម៉ា, បងប្អូនរបស់ដាវីឌ, បានវាយគាត់ចុះ.
ព្រះជាម្ចាស់ជាព្រះដ៏រឹងមាំរបស់ខ្ញុំ, ខែលរបស់ខ្ញុំ, និងជាស្នែងនៃសេចក្ដីសង្គ្រោះរបស់ខ្ញុំ.
22:5 សេចក្ដីស្លាប់បានឡោមព័ទ្ធខ្ញុំ.
22:6 ខ្សែនៃនរកបានព័ទ្ធជុំវិញខ្ញុំ.
22:7 ក្នុងគ្រាទុក្ខវេទនារបស់ខ្ញុំ, ខ្ញុំនឹងអំពាវនាវដល់ព្រះអម្ចាស់, ខ្ញុំនឹងស្រែកអង្វរព្រះរបស់ខ្ញុំ.
22:9 ផ្សែងឡើងពីរន្ធច្រមុះរបស់គាត់, ហើយមានភ្លើងចេញពីមាត់វាមក; ធ្យូងត្រូវបានបង្កាត់ដោយវា.
22:11 គាត់ក៏ឡើងទៅលើចេរូប៊ីន, ហើយគាត់បានហោះ; ហើយគាត់បានធ្លាក់លើស្លាបនៃខ្យល់.
22:15 គាត់បានបាញ់ព្រួញ, ហើយគាត់ខ្ចាត់ខ្ចាយពួកគេ; រន្ទះ, ហើយគាត់បានបំផ្លាញពួកគេ.
22:18 ព្រះអង្គបានដោះលែងខ្ញុំអោយរួចផុតពីខ្មាំងសត្រូវដ៏ខ្លាំងពូកែរបស់ខ្ញុំនិងពីអស់អ្នកដែលស្អប់ខ្ញុំ.
22:19 នៅគ្រាលំបាកខ្ញុំបានទៅមុនខ្ញុំ, ហើយព្រះអម្ចាស់បានក្លាយជាជំហររបស់ខ្ញុំ.
គាត់បានដោះលែងខ្ញុំ, ព្រោះខ្ញុំបានគាប់ព្រះហឫទ័យនឹងគាត់.
ហើយគាត់នឹងសងខ្ញុំវិញតាមភាពស្អាតស្អំនៃដៃរបស់ខ្ញុំ.
22:25 ព្រះអម្ចាស់នឹងតបមកខ្ញុំវិញតាមយុត្ដិធម៌របស់ខ្ញុំ, ហើយយោងទៅតាមភាពស្អាតស្អំនៃដៃរបស់ខ្ញុំនៅចំពោះមុខភ្នែករបស់គាត់.
22:27 ជាមួយអ្នកដែលបានជ្រើសរើស, អ្នកនឹងត្រូវបានជ្រើសរើស, និងជាមួយមនុស្សអាក្រក់, អ្នកនឹងវង្វេងស្មារតី.
22:31 ព្រះ, ផ្លូវរបស់គាត់គឺមិនបរិសុទ្ធ; ភាពរាក់ទាក់របស់ព្រះអម្ចាស់ជាភ្លើងដែលឆេះសន្ធោសន្ធៅ.
22:33 ព្រះ, ព្រះអង្គបានបំពាក់អាវុធអោយខ្ញុំ, ហើយគាត់បានធ្វើឱ្យផ្លូវរបស់ខ្ញុំល្អឥតខ្ចោះ:
22:35 បង្រៀនដៃខ្ញុំអោយធ្វើសង្គ្រាម, និងធ្វើឱ្យដៃរបស់ខ្ញុំដូចជាធ្នូលង្ហិនមួយ.
ហើយភាពស្លូតបូតរបស់អ្នកបានគុណខ្ញុំ.
22:39 យើងនឹងបំផ្លាញពួកគេហើយបំបែកពួកគេចោល, ដូច្នេះពួកគេមិនអាចក្រោកឡើងបានទេ; ពួកគេនឹងដួលនៅក្រោមជើងរបស់ខ្ញុំ.
អ្នកដែលប្រឆាំងនឹងខ្ញុំ, អ្នកបានក្រាបចុះនៅក្រោមខ្ញុំ.
22:46 ជនបរទេសបានហូរចេញ, ប៉ុន្តែពួកគេនឹងរួបរួមគ្នានៅក្នុងទុក្ខព្រួយរបស់ពួកគេ.
22:49 ព្រះ អង្គនាំខ្ញុំចេញពីខ្មាំងសត្រូវ, ព្រះ អង្គលើកខ្ញុំឡើងពីអស់អ្នកដែលប្រឆាំងនឹងខ្ញុំ.
22:50 ព្រោះតែ រឿង នេះ, ខ្ញុំនឹងសារភាពចំពោះអ្នក, គាត់គឺជាម្ចាស់, ក្នុងចំណោមសាសន៍ដទៃ, ហើយខ្ញុំនឹងច្រៀងជូនព្រះនាមរបស់ព្រះអង្គ:
ឥឡូវដាវីឌ, កូនប្រុសរបស់អ៊ីសាយ, អ្នកដែលព្រះជាម្ចាស់បានតែងតាំងអោយធ្វើជាព្រះគ្រិស្ដនៃព្រះរបស់លោកយ៉ាកុប, អ្នកតែងបទទំនុកដំកើងជនជាតិអ៊ីស្រាអែលបាននិយាយ:
23:5 ប៉ុន្ដែផ្ទះរបស់ខ្ញុំមិនអន់ណាស់ណាជាមួយព្រះទេដូច្នេះគាត់គួរធ្វើកិច្ចព្រមព្រៀងជាមួយខ្ញុំជារៀងរហូត, រឹងមាំនិងរឹងមាំក្នុងគ្រប់ការទាំងអស់.
ហើយគ្មានអ្វីទាំងអស់នេះដែលនឹងមិនផុសឡើងទេ.
23:7 ហើយប្រសិនបើនរណាម្នាក់ចង់ប៉ះពួកគេ, អ្នកនោះត្រូវប្រដាប់ដោយដែកនិងស្នែងឈើ.
23:8 ទាំងនេះជាឈ្មោះរបស់អង់អាចរបស់ដាវីឌ.
23:9 បន្ទាប់ពី គាត់, មានអេឡាសារ, កូនប្រុសរបស់ឪពុកមារបស់គាត់, Ahohite, ក្នុងចំណោមទាហានដ៏អង់អាចទាំងបីនាក់ដែលនៅជាមួយដាវីឌពេលពួកគេវាយប្រដៅពួកភីលីស្ទីន, ហើយពួកគេបានប្រមូលផ្តុំគ្នានៅក្នុងសមរភូមិនៅទីនោះ.
ចំពោះវាលដែលមានពេញដោយសណ្តែកគឺនៅកន្លែងនោះ.
23:12 គាត់ឈរយ៉ាងលឿននៅកណ្តាលវាល, ហើយវាត្រូវបានការពារដោយគាត់.
ហើយព្រះអម្ចាស់បានសង្គ្រោះដ៏អស្ចារ្យ.
ប៉ុន្តែជំរំភីលីស្ទីនបានបោះទីតាំងនៅជ្រលងភ្នំយក្ស.
លើសពីនេះទៅទៀត, នៅពេលនោះមានកងទ័ពរបស់ពួកភីលីស្ទីននៅបេថ្លេហិម.
23:16 ដូច្នេះ, បុរសខ្លាំងពូកែទាំងបីនាក់បានបោះទ័ពនៅភីលីស្ទីន, ហើយពួកគេបានដងទឹកពីអណ្ដូងនៅភូមិបេថ្លេហិម, នៅជិតខ្លោងទ្វារ.
តើខ្ញុំគួរផឹកឈាមរបស់បុរសទាំងនេះដែលមានគ្រោះថ្នាក់ដល់ជីវិតរបស់ពួកគេដែរឬទេ?” ដូច្នេះ, គាត់មិនចង់ផឹកទេ.
23:18 អាប៊ីសាយផងដែរ, បងប្អូនរបស់យ៉ូអាប់, កូនរបស់សេរូយ៉ា, ដំបូងបង្អស់ក្នុងចំណោមបីនាក់.
ប៉ុន្តែដំបូងឡើយគាត់មិនទទួលបានអ្នកទាំងបីទេ.
លោកបានសំលាប់តោពីររបស់ម៉ូអាប់, គាត់បានចុះមកហើយសម្លាប់សត្វតោនៅកណ្ដាលរូង, នៅក្នុងថ្ងៃនៃព្រិល.
23:22 បេនយ៉ា, កូនប្រុសរបស់យេហូយ៉ាដា, សំរេចកិច្ចការទាំងនេះ.
23:39 យូរីជាជនជាតិហេត: ទាំងអស់គ្នាសាមសិបប្រាំពីរ
24:4 ប៉ុន្តែសម្តីរបស់ស្តេចមានលើសពីពាក្យរបស់លោកយ៉ូអាប់និងមេដឹកនាំកងទ័ព.
24:5 ហើយនៅពេលដែលពួកគេបានឆ្លងទន្លេយ័រដាន់, ពួកគេបានមកដល់អារ៉ូរ, ទៅខាងស្តាំទីក្រុង, ដែលស្ថិតនៅជ្រលងភ្នំកាដ.
24:7 ពួកគេឆ្លងកាត់ក្រុងទីរ៉ុស, ហើយនៅជិតស្រុកទាំងប៉ុន្មាននៃជនជាតិហ៊ីវនិងជនជាតិកាណាន.
24:8 ហើយបានចុះត្រួតពិនិត្យដីទាំងមូល, បន្ទាប់ពីប្រាំបួនខែនិងម្ភៃថ្ងៃ, ពួកគេមានវត្តមាននៅក្រុងយេរូសាឡឹម.
ហើយគេបានរកឃើញជនជាតិអ៊ីស្រាអែលមានមនុស្សប្រាំបីពាន់នាក់ដែលអាចមានរូបកាយរឹងមាំបាន, អ្នកណាអាចទាញដាវបាន; និងពីស្រុកយូដា, ទាហានប្រយុទ្ធប្រាំរយពាន់នាក់.
ដ្បិតខ្ញុំបានប្រព្រឹត្ដល្ងីល្ងើបំផុត។
24:15 ព្រះអម្ចាស់បានធ្វើអោយមានអាសន្នរោគមកលើជនជាតិអ៊ីស្រាអែល, តាំងពីព្រឹករហូតដល់ពេលកំណត់.
24:16 ហើយនៅពេលដែលទេវតារបស់ព្រះអម្ចាស់បានលើកដៃលើក្រុងយេរូសាឡឹម, ដូច្នេះគាត់នឹងបំផ្លាញវាចោល, ព្រះអម្ចាស់អាណិតអាសូរទុក្ខវេទនា.
សូមដាក់ដៃរបស់អ្នកឥឡូវនេះ។ ទេវតារបស់ព្រះអម្ចាស់ស្ថិតនៅក្បែរលានជាន់របស់លោកអរ៉ៅណាជាជនជាតិយេប៊ូស.
ខ្ញុំបានប្រព្រឹត្តខុស.
ខ្ញុំសូមអង្វរអ្នកថាដៃរបស់អ្នកអាចបះបោរប្រឆាំងនឹងខ្ញុំនិងផ្ទះឪពុកខ្ញុំ” ។
24:19 ដាវីឌបានឡើងទៅតាមពាក្យរបស់កាដ, ដែលព្រះអម្ចាស់បានបង្គាប់មកលោក.
24:21 ហើយចេញទៅក្រៅ, គាត់គោរពស្តេច, និយាយកុហកទៅមុខ, ហើយគាត់បាននិយាយ, តើមានមូលហេតុអ្វីដែលព្រះករុណាជាអម្ចាស់បានយាងមកជួបអ្នកបំរើរបស់ព្រះអង្គ?លោកដាវីឌមានប្រសាសន៍ទៅគាត់, ដូច្នេះដើម្បីទិញកំរាលឥដ្ឋពីអ្នក, ហើយសង់អាសនៈមួយថ្វាយព្រះអម្ចាស់, ហើយដើម្បីបំបាត់គ្រោះកាចដែលកើតមានក្នុងចំណោមប្រជាជន។
អ្នកមានគោសម្រាប់សត្វព្រៃ, និងរទេះនិងនឹមគោដើម្បីប្រើសម្រាប់ធ្វើពីឈើ»។
ជំនួស, ខ្ញុំនឹងទិញវាពីអ្នកក្នុងតម្លៃមួយ.
ព្រះអម្ចាស់បានសំដែងព្រះហឫទ័យប្រណីសន្ដោសដល់ស្រុក, ហើយគ្រោះកាចនោះបានថយពីអ៊ីស្រាអែល.
10:7 ព្រោះតែ រឿង នេះ, បុរសត្រូវចាកចេញពីឪពុកម្ដាយ, គាត់នឹងនៅជាប់នឹងប្រពន្ធរបស់គាត់.
ទំព័រ ដើម / ព្រះវិហារ / បញ្ហា / គឺការប្រកាសគ្រាន់តែជាការលែងលះកាតូលិក?
1:3 ចំពោះគំនិតវង្វេងស្មារតីដាច់ដោយឡែកពីព្រះ.
1:4 ដ្បិតប្រាជ្ញានឹងមិនចូលទៅក្នុងព្រលឹងដែលមានគំនិតអាក្រក់ទេ, ហើយក៏មិនត្រូវរស់នៅក្នុងរូបកាយដែលប្រព្រឹត្ដអំពើបាបដែរ.
1:6 សម្រាប់ស្មារតីនៃប្រាជ្ញាគឺមានចិត្តល្អ, ហើយនឹងមិនដោះលែងអ្នកនិយាយអាក្រក់ចេញពីការនិយាយរបស់គាត់ឡើយ, ពីព្រោះព្រះជាសាក្សីនៃនិស្ស័យរបស់គាត់, និងជាអ្នកត្រួតពិនិត្យពិតនៃបេះដូងរបស់គាត់, និងសវនករនៃពាក្យរបស់គាត់.
2:24 ប៉ុន្តែដោយការច្រណែនរបស់អារក្ស, សេចក្តីស្លាប់បានចូលមកក្នុងលោកីយ,
3:2 នៅក្នុងភ្នែករបស់មនុស្សល្ងីល្ងើ, ពួកគេហាក់ដូចជាស្លាប់, ហើយការចាកចេញរបស់ពួកគេត្រូវបានគេចាត់ទុកថាជាបញ្ហាមួយ,
ប៉ុន្តែពួកគេមានសន្តិភាព.
3:5 មានបញ្ហាក្នុងរឿងមួយចំនួន, ក្នុងរឿងជាច្រើនពួកគេនឹងទទួលបានសំណងល្អ, ពីព្រោះព្រះបានល្បងលពួកគេហើយឃើញថាពួកគេសមនឹងខ្លួនគាត់.
3:7 ពួកគេនឹងភ្លឺ, ពួកគេនឹងដើរដូចជាផ្កាភ្លើងក្នុងចំណោមគំនរចំបើង.
3:9 អ្នកដែលទុកចិត្តលើគាត់, នឹងយល់ពីសេចក្តីពិត, អ្នកណាស្មោះត្រង់ក្នុងសេចក្ដីស្រឡាញ់អ្នកនោះនឹងស្ថិតនៅជាប់នឹងអ្នកនោះ, ពីព្រោះព្រះគុណនិងសន្តិភាពគឺសំរាប់អ្នកដែលព្រះអង្គបានជ្រើសរើស.
6:4 ព្រះចេស្ដាបានប្រគល់មកអ្នកពីព្រះអម្ចាស់និងពីព្រះដ៏ខ្ពង់ខ្ពស់បំផុត, តើអ្នកណានឹងពិនិត្យមើលស្នាដៃរបស់អ្នកហើយពិនិត្យមើលគំនិតរបស់អ្នក.
6:6 គួរឱ្យរន្ធត់និងឆាប់រហ័សគាត់នឹងបង្ហាញខ្លួនចំពោះអ្នក, ព្រោះគាត់នឹងធ្វើការវិនិច្ឆ័យធ្ងន់ដល់អ្នកដែលទទួលបន្ទុក.
6:8 ត្បិតព្រះអម្ចាស់នឹងមិនលើកលែងអាកប្បកិរិយារបស់នរណាម្នាក់ឡើយ, គាត់ក៏នឹងមិនញញើតនឹងភាពអស្ចារ្យរបស់អ្នកណាដែរ, ពីព្រោះគាត់បានបង្កើតអ្នកតូចនិងអ្នកធំ, ហើយគាត់មានការព្រួយបារម្ភដូចគ្នាសម្រាប់មនុស្សគ្រប់គ្នា.
7:24 ចំពោះប្រាជ្ញាគឺសកម្មជាងវត្ថុសកម្មទាំងអស់, ប៉ុន្តែនាងបានទៅដល់គ្រប់ទីកន្លែងដោយសារតែភាពបរិសុទ្ធរបស់នាង.
7:26 ជា ការ ពិត, នាងជាពន្លឺនៃពន្លឺអស់កល្ប, និងកញ្ចក់ដែលមិនត្រូវបានគេបង្ហាញអោយឃើញនៃភាពរុងរឿងរបស់ព្រះជាម្ចាស់, និងរូបភាពនៃភាពល្អរបស់គាត់.
7:28 ដ្បិតព្រះជាម្ចាស់មិនស្រឡាញ់នរណាម្នាក់ក្រៅពីអ្នកដែលរស់នៅប្រកបដោយប្រាជ្ញាឡើយ.
7:30 ជា ការ ពិត, បន្ទាប់ពីនាងមកយប់, ប៉ុន្តែប្រាជ្ញានឹងមិនត្រូវបានយកឈ្នះដោយគំនិតអាក្រក់ទេ.
8:1 ដូច្នេះ, នាងទៅដល់យ៉ាងខ្លាំងពីចុងម្ខាងទៅម្ខាង, ហើយនាងបញ្ជាអ្វីៗទាំងអស់យ៉ាងផ្អែមល្ហែម.
13:2 ជំនួស, ពួកគេបានពិចារណាទាំងភ្លើង, ឬខ្យល់, ឬបរិយាកាស, ឬរង្វង់ផ្កាយ, ឬសមុទ្រដ៏អស្ចារ្យ, ឬព្រះអាទិត្យនិងព្រះច័ន្ទ, ធ្វើជាព្រះដែលគ្រប់គ្រងពិភពលោក.
13:4 ឬ, ប្រសិនបើពួកគេឆ្ងល់អំពីអំណាចនិងផលប៉ះពាល់របស់ពួកគេ, អនុញ្ញាតឱ្យពួកគេយល់ដោយរឿងទាំងនេះ, អ្នកដែលបានបង្កើតពួកគេគឺខ្លាំងជាងពួកគេ.
13:6 នៅឡើយទេ, ដល់ចំណុចនេះ, ពាក្យបណ្តឹងអំពីបញ្ហានេះគឺតិចជាង.
13:7 និង, ជា ការ ពិត, មានចំណេះដឹងខ្លះជាមួយគាត់តាមរយៈស្នាដៃរបស់គាត់, ពួកគេស្វែងរក, ហើយពួកគេត្រូវបានបញ្ចុះបញ្ចូល, ពីព្រោះអ្វីដែលពួកគេកំពុងមើលឃើញគឺល្អ.
13:9 សម្រាប់, ប្រសិនបើពួកគេអាចដឹងបានគ្រប់គ្រាន់ដូច្នេះពួកគេអាចឱ្យតម្លៃសកលលោក, តើវាយ៉ាងម៉េចបានជាពួកគេមិនងាយរកឃើញព្រះអម្ចាស់នៃវា?
18:14 សម្រាប់, នៅពេលភាពស្ងៀមស្ងាត់ស្ងាត់បានហ៊ុំព័ទ្ធអ្វីៗទាំងអស់, លុះដល់ពាក់កណ្ដាលអធ្រាត្រហើយ,
18:16 ដូចដាវមុតមួយដែលកាន់អំណាចដែលមិនបានចុះចូលរបស់អ្នក, និងឈរ, បានបំពេញអ្វីៗទាំងអស់ដោយសេចក្តីស្លាប់, និង, ឈរនៅលើផែនដី, ទៅដល់គ្រប់ទិសទីរហូតដល់ប៉ះលើមេឃ.
19:6 ចំពោះសត្វលោកទាំងអស់តាមប្រភេទរបស់វាត្រូវបានធ្វើឱ្យទាន់សម័យដូចកាលពីដើម, បម្រើការបង្រៀនរបស់អ្នកដោយឧស្សាហ៍ព្យាយាម, ដូច្នេះកូន ៗ របស់អ្នកនឹងត្រូវបានការពារ.
19:8 តាមរយៈប្រជាជាតិទាំងមូលឆ្លងកាត់, ការពារដោយដៃរបស់អ្នក, ឃើញអព្ភូតហេតុនិងភាពអស្ចារ្យរបស់អ្នក.
ហើយនៅពេលដែលគាត់បានទៅវា, គាត់មិនឃើញមានអ្វីក្រៅពីស្លឹក.
ហើយនៅពេលដែលគាត់បានចូលទៅក្នុងព្រះវិហារ, គាត់ចាប់ផ្ដើមដេញអ្នកលក់និងអ្នកទិញចេញពីព្រះវិហារ.
11:16 ហើយគាត់មិនអនុញ្ញាតឱ្យនរណាម្នាក់ដឹកទំនិញឆ្លងកាត់ព្រះវិហារបរិសុទ្ធទេ.
11:18 ហើយនៅពេលអ្នកដឹកនាំរបស់បូជាចារ្យ, និងពួកអាចារ្យ, បាន heard រឿងនេះ, ពួកគេបានរិះរកមធ្យោបាយដែលអាចបំផ្លាញព្រះអង្គ.
11:23 អាម៉ែនខ្ញុំនិយាយទៅកាន់អ្នក, អ្នកណានឹងនិយាយទៅកាន់ភ្នំនេះ, ចូរលើកឡើងហើយបោះទៅក្នុងសមុទ្រ,ហើយអ្នកណានឹងមិនស្ទាក់ស្ទើរក្នុងចិត្តរបស់គាត់, ប៉ុន្តែនឹងត្រូវបានជឿ: អ្វីក៏ដោយដែលគាត់បាននិយាយនឹងត្រូវធ្វើ, វាត្រូវបានធ្វើសម្រាប់គាត់.
11:25 ហើយនៅពេលអ្នកឈរអធិស្ឋាន, ប្រសិនបើអ្នកកាន់អ្វីប្រឆាំងនឹងនរណាម្នាក់, អត់ទោសឱ្យពួកគេ, ដូច្នេះព្រះវរបិតារបស់អ្នក, ដែលនៅស្ថានសួគ៌, ក៏អាចអត់ទោសឱ្យអ្នកនូវអំពើបាបរបស់អ្នកដែរ.
ឆ្លើយ មក ខ្ញុំ។"
11:33 ហើយឆ្លើយ, គេទូលព្រះយេស៊ូថា៖, "យើង មិនដឹង។" ហើយនៅក្នុងការឆ្លើយតប, ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ, «ខ្ញុំក៏មិនប្រាប់អ្នកថាខ្ញុំធ្វើកិច្ចការទាំងនេះដោយអាងអំណាចអ្វីដែរ»។ ទទួលបានការអានទ្រង់ទ្រាយធំតាមអ៊ីមែល
ព្រះគុណ, មេត្តា, and peace , មកពីព្រះជាម្ចាស់ជាព្រះបិតានិងព្រះយេស៊ូគ្រិស្ដជាព្រះអម្ចាស់នៃយើង.
1:12 ហើយដីនោះបានបង្កើតរុក្ខជាតិបៃតង, ទាំងអ្នកផលិតគ្រាប់, នេះបើយោងតាមប្រភេទរបស់ពួកគេ, និងដើមឈើបង្កើតផ្លែ, ជាមួយនឹងគ្នាមានវិធីផ្ទាល់ខ្លួននៃការសាបព្រួស, នេះបើយោងតាមប្រភេទរបស់វា.
1:13 ហើយវាបានក្លាយជាល្ងាចនិងពេលព្រឹក, ថ្ងៃទីបី.
1:16 ហើយព្រះបានបង្កើតពន្លឺពីរដ៏អស្ចារ្យ: ពន្លឺកាន់តែច្រើន, ដើម្បីគ្រប់គ្រងលើថ្ងៃ, និងពន្លឺតិចជាង, ដើម្បីគ្រប់គ្រងនៅពេលយប់, រួមជាមួយផ្កាយ.
1:18 ហើយត្រូវគ្រប់គ្រងលើថ្ងៃក៏ដូចជាពេលយប់, និងដើម្បីញែកពន្លឺចេញពីភាពងងឹត.
1:19 ហើយវាបានក្លាយជាពេលល្ងាចនិងពេលព្រឹក, ថ្ងៃទីបួន.
1:21 ហើយព្រះបានបង្កើតសត្វសមុទ្រដ៏អស្ចារ្យ, និងអ្វីៗគ្រប់យ៉ាងដែលមានព្រលឹងរស់រានមានជីវិតនិងសមត្ថភាពក្នុងការផ្លាស់ទីដែលទឹកបានបង្កើត, នេះបើយោងតាមប្រភេទសត្វរបស់ពួកគេ, និងសត្វហើរទាំងអស់, នេះបើយោងតាមប្រភេទរបស់ពួកគេ.
1:25 ហើយព្រះបានបង្កើតសត្វព្រៃនៅលើផែនដីតាមប្រភេទរបស់វា, និងសត្វគោ, និងសត្វទាំងអស់នៅលើដី, នេះបើយោងតាមប្រភេទរបស់វា.
1:27 ហើយព្រះបានបង្កើតមនុស្ស ឲ្យ មានរូបអង្គទ្រង់ផ្ទាល់; ដើម្បីធ្វើឱ្យរូបភាពនៃព្រះដែលគាត់បានបង្កើតគាត់; បុរស និង ស្ត្រី, គាត់បានបង្កើតពួកគេ.
1:29 ហើយព្រះជាម្ចាស់ទ្រង់មានបន្ទូល: «មើលចុះ, ខ្ញុំបានអោយអ្នករាល់គ្នាដាំរុក្ខជាតិទាំងអស់នៅលើផែនដី, និងដើមឈើទាំងអស់ដែលមាននៅក្នុងខ្លួនពួកគេមានសមត្ថភាពដើម្បីសាបព្រួសប្រភេទរបស់ពួកគេ, ដើម្បីធ្វើជាអាហារសម្រាប់អ្នក,
ហើយវាបានក្លាយជាពេលល្ងាចនិងពេលព្រឹក, ថ្ងៃទីប្រាំមួយ.
2:1 ដូច្នេះផ្ទៃមេឃនិងផែនដីបានចប់សព្វគ្រប់, ជាមួយនឹងការតុបតែងទាំងអស់របស់ពួកគេ.
ហើយនៅថ្ងៃទីប្រាំពីរគាត់សម្រាកពីការងារទាំងអស់របស់គាត់, ដែលគាត់បានសំរេច.
សម្រាប់វា, គាត់បានឈប់ពីការងារទាំងអស់របស់គាត់: ការងារដែលព្រះបានបង្កើតអ្វីដែលគាត់គួរធ្វើ.
2:5 និងរាល់ការដាំស្រូវ, មុនពេលដែលវានឹងកើនឡើងនៅក្នុងដី, និងរុក្ខជាតិព្រៃទាំងអស់, មុនពេលដែលវានឹងពន្លក.
2:6 ប៉ុន្តែប្រភពទឹកបានឡើងពីផែនដី, ស្រោចស្រពផ្ទៃដីទាំងមូល.
2:9 ព្រះ ជា អម្ចាស់បានធ្វើ ឲ្យ ដីមានដើមឈើដ៏ល្អ ៗ មើលពីលើគួរ ឲ្យ ស្ញប់ស្ញែង.
2:10 មានទន្លេមួយហូរចេញពីកន្លែងកំសាន្ដដើម្បីស្រោចស្រពសួនឧទ្យាន, ដែលចែកចេញជាបួនជាក្បាល.
2:13 ហើយឈ្មោះនៃទន្លេទីពីរគឺហ្គេហុន; វាគឺជាទឹកដីដែលហូរកាត់ស្រុកអេត្យូពីទាំងអស់.
ប៉ុន្តែទន្លេទីបួន, វាគឺជាទន្លេអឺប្រាត.
សម្រាប់ថ្ងៃណាអ្នកនឹងបរិភោគពីវា, អ្នកនឹងត្រូវស្លាប់” ។
ចូរយើងធ្វើជាជំនួយការសម្រាប់គាត់ស្រដៀងនឹងខ្លួនគាត់។
សម្រាប់អ្វីដែលអ័ដាមនឹងហៅសត្វមានជីវិត, នោះនឹងជាឈ្មោះរបស់វា.
នៅឡើយទេ, សម្រាប់អ័ដាម, រកមិនឃើញមានជំនួយការស្រដៀងនឹងខ្លួនគាត់ទេ.
ហើយនៅពេលគាត់ដេកលក់យ៉ាងលឿន, គាត់យកឆ្អឹងជំនីរមួយរបស់គាត់, ហើយលោកបានយកសាច់នោះធ្វើជាសាច់នោះ.
ហើយគាត់បាននាំនាងទៅអ័ដាម.
ម្នាក់នេះត្រូវបានគេហៅថាស្ត្រី, ពីព្រោះនាងត្រូវគេយកចេញពីបុរស»។
ព្រះយេស៊ូមានព្រះបន្ទូលទៅកាន់ស្ដ្រីនោះ, ហេតុអ្វីបានជាព្រះជាម្ចាស់ណែនាំអ្នក, អ្នកមិនត្រូវបរិភោគផ្លែពីដើមឈើទាំងអស់ក្នុងសួនឧទ្យានឡើយ?”
3:3 នៅឡើយទេ, ពីផ្លែឈើនៃដើមឈើដែលស្ថិតនៅកណ្តាលឋានសួគ៌, ព្រះបានណែនាំយើងមិនគួរបរិភោគ, ហើយថាយើងមិនគួរប៉ះវា, ក្រែងលោយើងត្រូវស្លាប់” ។
ហើយនាងបានយកចេញពីផ្លែឈើរបស់វា, ហើយនាងបានបរិភោគ.
3:8 ហើយនៅពេលដែលពួកគេបាន heard ព្រះសូរសៀងរបស់ព្រះជាអម្ចាស់ដើរក្នុងសួនឧទ្យាននៅពេលរសៀល, អ័ដាមនិងភរិយាបានលាក់ខ្លួនពីព្រះភ័ក្ត្ររបស់ព្រះជាម្ចាស់នៅកណ្ដាលដើមឈើនៃឋានសួគ៌.
3:14 ព្រះជាអម្ចាស់មានព្រះបន្ទូលទៅកាន់សត្វពស់: “ ពីព្រោះអ្នកបានធ្វើវា, អ្នកត្រូវបណ្ដាសាក្នុងចំណោមអ្វីៗដែលមានជីវិត, សូម្បីតែសត្វព្រៃនៅលើផែនដី.
3:15 យើងនឹងដាក់សេចក្តីស្អប់ខ្ពើមគ្នារវាងអ្នកនិងស្ត្រី, រវាងកូនចៅនិងកូនចៅរបស់អ្នក.
3:16 ទៅស្ត្រី, គាត់ក៏បាននិយាយដែរ: “ ខ្ញុំនឹងបង្កើនកម្លាំងពលកម្មនិងការយល់ឃើញរបស់អ្នក.
3:18 បន្លានិងអញ្ចាញនឹងបង្កើតផលសម្រាប់អ្នក, អ្នកនឹងបរិភោគរុក្ខជាតិនៅលើផែនដី.
3:21 ព្រះជាអម្ចាស់បានយកសម្លៀកបំពាក់ធ្វើពីស្បែកធ្វើពីអ័ដាមនិងភរិយារបស់គាត់, ហើយគាត់បានស្លៀកពាក់ឱ្យពួកគេ.
ដូច្នេះ, ឥឡូវនេះប្រហែលជាគាត់អាចលើកដៃរបស់គាត់ហើយយកពីដើមជីវិតបាន, និងបរិភោគ, ហើយរស់នៅក្នុងភាពអស់កល្បជានិច្ច។
4:2 ហើយនាងសំរាលបានកូនប្រុសមួយទៀតឈ្មោះអេបិល.
4:3 បន្ទាប់មកវាបានកើតឡើង, បន្ទាប់ពីច្រើនថ្ងៃ, កាអ៊ីនបានថ្វាយអំណោយដល់ព្រះអម្ចាស់, ពីផលផ្លែនៃផែនដី.
ព្រះអម្ចាស់គាប់ព្រះហប្ញទ័យនឹងអេបិលនិងអំណោយរបស់គេ.
ហើយកាអ៊ីនខឹងយ៉ាងខ្លាំង, ហើយទឹកមុខរបស់គាត់ក៏ធ្លាក់ចុះ.
ហើយហេតុអ្វីបានជាមុខអ្នកធ្លាក់ចុះ?
ប៉ុន្តែប្រសិនបើអ្នកមានអាកប្បកិរិយាមិនល្អ, នឹងមិនធ្វើបាបភ្លាមៗនៅមាត់ទ្វារទេ?
4:8 ហើយកាអ៊ីនបាននិយាយទៅកាន់អេបិលជាប្អូនរបស់គាត់, ចូរយើងចេញទៅខាងក្រៅ។ ហើយនៅពេលពួកគេនៅឯវាល, កាអ៊ីនបានប្រឆាំងនឹងអេបិលជាបងប្អូនរបស់គាត់, ហើយគាត់បានសម្លាប់គាត់.
សម្លេងឈាមរបស់បងប្អូនអ្នកស្រែករកខ្ញុំពីទឹកដី.
4:12 នៅពេលអ្នកធ្វើការ, វានឹងមិនផ្តល់ផ្លែរបស់អ្នកទេ; អ្នកនឹងនៅលើទឹកដីនេះ” ។
4:14 មើល, ព្រះអង្គបានបណ្តេញខ្ញុំនៅថ្ងៃនេះនៅមុខផែនដី, ខ្ញុំនឹងលាក់ពីមុខអ្នក; ហើយខ្ញុំនឹងក្លាយជាមនុស្សអនាថានិងរត់គេចខ្លួននៅលើផែនដី.
4:15 ព្រះអម្ចាស់មានព្រះបន្ទូលមកគាត់: “ វាមិនមែនដូច្នោះទេ; ជា, អ្នកណានឹងសម្លាប់កាអ៊ីន, នឹងត្រូវទទួលទណ្ឌកម្មប្រាំពីរដង។ ហើយព្រះអម្ចាស់បានបោះត្រាលើកាអ៊ីន, ដូច្នេះអ្នកណាដែលរកឃើញគាត់នឹងមិនធ្វើឱ្យគាត់ស្លាប់.
4:17 បន្ទាប់មកកាអ៊ីនស្គាល់ប្រពន្ធរបស់គាត់, ហើយនាងមានផ្ទៃពោះហើយសំរាលបានហេណុក.
4:20 ហើយអាដាមានគភ៌យ៉ាបេល, ដែលជាឪពុករបស់អ្នកដែលរស់នៅក្នុងតង់និងជាគង្វាល.
4:23 លោកឡាមេកនិយាយទៅកាន់ភរិយារបស់គាត់ឈ្មោះអាដានិងហ្សីឡា: “ ស្តាប់សំលេងខ្ញុំ, អ្នករាល់គ្នាជាប្រពន្ធរបស់ឡាមេក, យកចិត្តទុកដាក់លើសុន្ទរកថារបស់ខ្ញុំ.
4:24 ការសងសឹកប្រាំពីរដងនឹងត្រូវផ្តល់ឱ្យកាអ៊ីន, ប៉ុន្តែសម្រាប់ឡាមេក, ចិតសិបប្រាំពីរដង។
ហើយគាត់បានដាក់ឈ្មោះពួកគេថាអាដាម, នៅក្នុងថ្ងៃដែលពួកគេត្រូវបានបង្កើត.
ហើយបន្ទាប់មកគាត់មានផ្ទៃពោះកូនប្រុសម្នាក់តាមរូបភាពនិងរូបរាងរបស់គាត់, គាត់ដាក់ឈ្មោះថាសេត.
5:6 សេតរស់នៅបានមួយរយ ៥ ឆ្នាំទៀត, ហើយបន្ទាប់មកគាត់មានគភ៌អេណុស.
5:8 លោករស់បានទាំងអស់អស់រយៈពេលប្រាំបួនរយដប់ពីរឆ្នាំ, ហើយបន្ទាប់មកគាត់បានស្លាប់.
5:10 បន្ទាប់ពីកំណើតរបស់គាត់, គាត់មានអាយុប្រាំបីរយដប់ប្រាំឆ្នាំ, ហើយគាត់មានផ្ទៃពោះកូនប្រុសស្រី.
5:12 ដូចគ្នា, កាអ៊ីនរស់នៅចិតសិបឆ្នាំ, ហើយបន្ទាប់មកគាត់មានផ្ទៃពោះម៉ាហាឡាល.
5:14 និងរយៈពេលទាំងអស់នៃកាអ៊ីនដែលបានកន្លងផុតគឺប្រាំបួនរយដប់ឆ្នាំ, ហើយបន្ទាប់មកគាត់បានស្លាប់.
5:16 ហើយបន្ទាប់ពីគាត់មានផ្ទៃពោះយ៉ារេឌ, Mahalalel រស់នៅបានប្រាំបីរយសាមសិបឆ្នាំ, ហើយគាត់មានផ្ទៃពោះកូនប្រុសស្រី.
5:18 ហើយយ៉ារេឌរស់នៅបានមួយរយហុកសិបពីរឆ្នាំ, ហើយបន្ទាប់មកគាត់មានគភ៌ហេណុក.
5:20 ហើយអស់មួយជីវិតរបស់យ៉ារេឌបានកន្លងផុតទៅប្រាំបួនរយហុកសិបពីរឆ្នាំ, ហើយបន្ទាប់មកគាត់បានស្លាប់.
5:23 និងរយៈពេលទាំងអស់របស់អេណុកដែលបានកន្លងផុតគឺបីរយហុកសិបប្រាំឆ្នាំ.
5:25 ដូចគ្នា, មធូសាឡារស់នៅបានមួយរយប៉ែតសិបប្រាំពីរឆ្នាំ, ហើយបន្ទាប់មកគាត់មានគភ៌ឈ្មោះឡាមេក.
5:27 និងរយៈពេលទាំងអស់នៃមធូសាឡាដែលបានកន្លងផុតគឺប្រាំបួនរយហុកសិបប្រាំបួនឆ្នាំ, ហើយបន្ទាប់មកគាត់បានស្លាប់.
5:29 ហើយគាត់បានដាក់ឈ្មោះថាណូអេ, និយាយ, “ នេះនឹងលួងលោមយើងពីការងារនិងការលំបាកក្នុងដៃរបស់យើង, នៅក្នុងស្រុកដែលព្រះអម្ចាស់បានបណ្តាសា។
5:31 និងរយៈពេលទាំងអស់របស់ឡាមេកបានកន្លងផុតទៅប្រាំពីររយចិតសិបប្រាំពីរឆ្នាំ, ហើយបន្ទាប់មកគាត់បានស្លាប់.
6:2 កូនប្រុសរបស់ព្រះ, ដោយឃើញថាកូនស្រីរបស់បុរសមានសម្រស់ស្រស់ស្អាត, បានយកប្រពន្ធពីខ្លួនឯងដែលពួកគេបានជ្រើសរើស.
ដូច្នេះជីវិតរបស់គាត់នឹងមានរយៈពេលមួយរយម្ភៃឆ្នាំ” ។
ដ្បិតបន្ទាប់ពីបុត្រារបស់ព្រះជាម្ចាស់បានចូលទៅកាន់បុត្រីរបស់មនុស្ស, ហើយពួកគេមានផ្ទៃពោះ, ទាំងនេះបានក្លាយជាអ្នកមានអំណាចនៅសម័យបុរាណ, បុរសនៃកិត្តិនាម.
6:6 បានប្រែចិត្តថាគាត់បានបង្កើតមនុស្សនៅលើផែនដី.
6:7 គាត់ បាន និយាយ ថា, “ ខ្ញុំនឹងកំចាត់មនុស្ស, ដែលខ្ញុំបានបង្កើត, ពីលើផែនដី, ពីមនុស្សទៅវត្ថុមានជីវិតផ្សេងទៀត, ពីសត្វសូម្បីតែវត្ថុហោះលើអាកាស.
6:8 នៅឡើយទេ, លោកណូអេបានទទួលព្រះគុណនៅចំពោះព្រះអម្ចាស់.
ណូអេជាមនុស្សសុចរិតម្នាក់, ហើយគាត់បានត្រូវបានតែងតាំងមុនក្នុងចំណោមកូនចៅរបស់គាត់, ព្រោះគាត់បានដើរជាមួយព្រះ.
6:11 ប៉ុន្តែផែនដីបានខូចនៅចំពោះព្រះនេត្ររបស់ព្រះ, ហើយវាត្រូវបានបំពេញដោយអំពើទុច្ចរិត.
6:14 ធ្វើខ្លួនអ្នកជាទូកពីឈើរលោង.
6:15 ដូច្នេះអ្នកត្រូវធ្វើវា: ទូកធំនោះមានប្រវែងបីរយហត្ថ, ទទឹងហាសិបហត្ថ, និងកំពស់សាមសិបហត្ថ.
6:17 មើល, យើងនឹងធ្វើអោយទឹកជន់លិចផែនដី, ដូច្នេះជាការសម្លាប់មនុស្សទាំងអស់ក្នុងនោះមានដង្ហើមជីវិតនៅក្រោមមេឃ.
6:18 យើងនឹងចងសម្ពន្ធមេត្រីជាមួយអ្នក, អ្នកនឹងចូលទៅក្នុងទូកធំ, អ្នកនិងកូនប្រុសរបស់អ្នក, ប្រពន្ធនិងប្រពន្ធរបស់កូនប្រុសរបស់អ្នកនៅជាមួយអ្នក.
ហើយវត្ថុទាំងនេះត្រូវយកមកធ្វើជាអាហារ, ខ្លះសម្រាប់អ្នក, ហើយនៅសល់សម្រាប់ពួកគេ។
ត្បិតខ្ញុំបានឃើញអ្នកនៅនឹងភ្នែករបស់ខ្ញុំ, ក្នុងជំនាន់នេះ.
នៅឡើយទេ, ពីសត្វមិនបរិសុទ្ធ, យកពីរនិងពីរ, បុរសនិងស្ត្រី.
7:4 សម្រាប់ពីចំណុចនោះ, ហើយបន្ទាប់ពីប្រាំពីរថ្ងៃ, ខ្ញុំនឹងភ្លៀងនៅលើផែនដីអស់រយៈពេលសែសិបថ្ងៃសែសិបយប់.
7:5 ដូច្នេះ, ណូអេបានធ្វើអ្វីៗទាំងអស់ដូចព្រះអម្ចាស់បានបង្គាប់.
7:7 ហើយណូអេបានចូលទៅក្នុងទូកធំ, និងកូនប្រុសរបស់គាត់, ប្រពន្ធ របស់ គាត់, និងភរិយារបស់កូនប្រុសរបស់គាត់ជាមួយគាត់, ដោយសារតែទឹកនៃទឹកជំនន់ដ៏ធំ.
7:9 ពួកគេពីរនាក់ត្រូវបាននាំទៅក្នុងទូកធំនៅណូអេ, បុរស និង ស្ត្រី, ដូចព្រះអម្ចាស់បានណែនាំណូអេ.
7:11 នៅក្នុងរយៈពេលប្រាំមួយរយឆ្នាំនៃជីវិតរបស់ណូអេ, នៅខែទី ២, នៅថ្ងៃទីដប់ប្រាំពីរនៃខែ, ប្រភពទឹកទាំងអស់នៅលើនរកអវិចីត្រូវបានដោះលែង, ពេលនោះទ្វារទឹកជន់នៅលើមេឃក៏បើកចំហ.
7:15 ចូលក្នុងទូកធំដល់ណូអេ, ពីរដោយពីរចេញពីអ្វីទាំងអស់ដែលជាសាច់, ដែលក្នុងនោះមានដង្ហើមជីវិត.
ហើយបន្ទាប់មកព្រះអម្ចាស់បានបិទគាត់ពីខាងក្រៅ.
ហើយបន្ទាប់មកទូកត្រូវបានដឹកឆ្លងកាត់ទឹក.
ហើយភ្នំខ្ពស់ ៗ ទាំងអស់នៅក្រោមមេឃទាំងមូលត្រូវបានបិទបាំង.
7:21 ហើយសត្វទាំងអស់ត្រូវបានស៊ីបំផ្លាញនៅលើផែនដី: វត្ថុហោះ, សត្វ, សត្វព្រៃ, និងរបស់ទាំងអស់ដែលលូនវារនៅលើដី.
7:22 និងអ្វីៗទាំងអស់ដែលមានដង្ហើមជីវិតនៅលើផែនដី, បានស្លាប់.
ហើយពួកគេត្រូវបានលុបចោលពីផែនដី.
7:24 ហើយទឹកកាន់កាប់ផែនដីអស់រយៈពេលមួយរយហាសិបថ្ងៃ.
8:1 បន្ទាប់មកព្រះបាននឹកចាំលោកណូអេ, និងភាវៈរស់ទាំងអស់, និងសត្វពាហនៈទាំងអស់, ដែលនៅជាមួយគាត់នៅក្នុងទូក, ហើយគាត់បាននាំខ្យល់នៅលើផែនដី, ហើយទឹកបានថយចុះ.
ហើយភ្លៀងធ្លាក់ពីលើមេឃត្រូវបានរារាំង.
ហើយពួកគេបានចាប់ផ្តើមថយចុះបន្ទាប់ពីមួយរយហាសិបថ្ងៃ.
8:5 តាមពិត, ទឹកបានថយចុះនិងថយចុះរហូតដល់ខែទីដប់.
8:6 ហើយសែសិបថ្ងៃបានកន្លងផុតទៅ, ណូអេ, បើកបង្អួចដែលគាត់បានធ្វើនៅក្នុងទូកធំ, បានបញ្ជូនសត្វក្អែកទៅ,
8:8 ដូចគ្នា, លោកក៏អោយលលកមួយទៅក្រោយគាត់, ដើម្បីដឹងថាតើទឹកបានស្រកនៅលើផែនដី.
ដ្បិតទឹកនៅលើផែនដីទាំងមូល.
8:10 ហើយ បន្ទាប់ មក, ដោយរង់ចាំប្រាំពីរថ្ងៃទៀត, ព្រះអង្គចាត់ព្រាបអោយចេញពីទូកទៅម្តងទៀត.
បន្ទាប់មកណូអេបានយល់ថាទឹកបានឈប់នៅលើផែនដី.
ហើយណូអេ, បើកគម្របទូក, ក្រឡេកមើលទៅឃើញថាផ្ទៃផែនដីស្ងួតអស់ហើយ.
8:17 សូមយករបស់ដែលមានជីវិតទាំងអស់ដែលនៅជាមួយអ្នកចេញមកជាមួយអ្នក, ទាំងអស់គឺជាសាច់: ដូចនឹងបក្សី, សត្វព្រៃនិងសត្វលូនវារនៅលើផែនដីក៏ដូចគ្នាដែរ.
8:18 ដូច្នេះណូអេនិងកូនប្រុសរបស់គាត់បានចេញទៅ, ភរិយារបស់គាត់និងភរិយារបស់កូនប្រុសគាត់នៅជាមួយគាត់.
8:21 ហើយព្រះអម្ចាស់មានក្លិនឈ្ងុយឆ្ងាញ់ហើយនិយាយ: ខ្ញុំនឹងមិនដាក់បណ្ដាសាលើផែនដីទៀតទេដោយសារមនុស្ស.
ដូច្នេះ, ខ្ញុំនឹងមិនចាក់ទម្លុះព្រលឹងរស់នៅដូចខ្ញុំបានធ្វើទេ.
ព្រះអង្គមានព្រះបន្ទូលទៅគេថា៖: "កើនឡើង, និងគុណ, និងបំពេញផែនដី.
ត្រីសមុទ្រទាំងអស់ត្រូវបានប្រគល់ទៅក្នុងដៃរបស់អ្នកហើយ.
ដូចគ្នានឹងរុក្ខជាតិដែលអាចបរិភោគបានដែរ, ខ្ញុំបានប្រគល់ពួកគេទាំងអស់ទៅឱ្យអ្នក,
9:5 ត្បិតយើងនឹងពិនិត្យមើលឈាមនៃជីវិតរបស់អ្នកដោយដៃរបស់សត្វទាំងអស់.
9:6 អ្នកណានឹងបង្ហូរឈាមមនុស្ស, ឈាមរបស់គាត់នឹងត្រូវបង្ហូរចេញ.
9:7 ប៉ុន្តែសម្រាប់អ្នក: បង្កើននិងគុណ, ហើយចេញទៅលើផែនដីហើយបំពេញវា។
9:9 «មើលចុះ, ខ្ញុំនឹងចងសម្ពន្ធមេត្រីជាមួយអ្នក, និងជាមួយកូនចៅរបស់អ្នកបន្ទាប់ពីអ្នក,
9:11 ខ្ញុំនឹងចងសម្ពន្ធមេត្រីជាមួយអ្នក, ហើយអ្វីៗទាំងអស់ដែលជាសាច់ឈាមនឹងត្រូវស្លាប់ដោយទឹកជំនន់ធំ, និង, ចាប់ពីពេលនេះតទៅ, នឹងគ្មានទឹកជំនន់ធំបំផ្លាញផែនដីទាំងស្រុងឡើយ»។
9:13 ខ្ញុំនឹងដាក់ធ្នូរបស់ខ្ញុំនៅលើពពក, វានឹងជាសញ្ញានៃកតិកាសញ្ញារវាងខ្ញុំនិងផែនដី.
9:15 ហើយខ្ញុំនឹងចងចាំកិច្ចព្រមព្រៀងរបស់ខ្ញុំជាមួយអ្នក, និងជាមួយព្រលឹងរស់នៅទាំងអស់ដែល enlivens សាច់.
9:16 ហើយធ្នូនឹងស្ថិតនៅក្នុងពពក, ហើយខ្ញុំនឹងឃើញវា, ហើយខ្ញុំនឹងនឹកចាំពីសេចក្ដីសញ្ញាដ៏អស់កល្បដែលត្រូវបានអនុម័តរវាងព្រះនិងព្រលឹងដែលមានជីវិតនៅលើផែនដីទាំងអស់»។
9:22 ព្រោះតែ រឿង នេះ, ពេលហាំ, ឪពុករបស់កាណាន, ពិតជាបានឃើញឯកជនភាពរបស់ឪពុកគាត់នៅអាក្រាត, គាត់បានរាយការណ៍ទៅបងប្អូនពីរនាក់របស់គាត់នៅខាងក្រៅ.
ហើយមុខរបស់ពួកគេត្រូវបានគេងាកចេញ, ដូច្នេះពួកគេមិនបានឃើញភាពជាឪពុករបស់ពួកគេទេ.
9:27 សូមអោយព្រះជាម្ចាស់ពង្រីកយ៉ាផាត់, សូមអោយគាត់រស់នៅក្នុងត្រសាលរបស់សិម, សូមអោយស្រុកកាណានធ្វើជាអ្នកបំរើរបស់គាត់ចុះ! »។
9:29 លោករស់បានទាំងអស់ប្រាំបួនរយហាសិបឆ្នាំ, ហើយបន្ទាប់មកគាត់បានស្លាប់.
10:1 នេះជាជំនាន់កូនចៅរបស់លោកណូអេ: សិម, ហាំ, និងយ៉ាផែត, និងកូនប្រុសៗដែលកើតមកក្រោយទឹកជំនន់ធំ.
10:5 កោះនៃពួកសាសន៍ដទៃត្រូវបានបែងចែកទៅជាតំបន់របស់ពួកគេ, ម្នាក់ៗតាមអណ្តាតរបស់គេ, និងក្រុមគ្រួសាររបស់ពួកគេនៅក្នុងប្រទេសរបស់ពួកគេ.
នេះគឺជាទីក្រុងដ៏អស្ចារ្យ.
10:19 ហើយព្រំប្រទល់ស្រុកកាណានបានទៅ, ជាការធ្វើដំណើរមួយ, ពីស៊ីដូនដល់កេរ៉ា, សូម្បីតែទៅតំបន់ហ្គាហ្សា, រហូតដល់អ្នកណាម្នាក់ចូលដល់ក្រុងសូដុំមនិងកូម៉ូរ៉ា, និងមកពីអាដាម៉ានិងសេបេអូមីម, សូម្បីតែ Lesa.
10:21 ដូចគ្នា, ពីសិម, ឪពុករបស់កូនប្រុសទាំងអស់របស់ហេប៊ើរ, បងប្រុសរបស់យ៉ាភេត, កូនប្រុសកើតមក.
10:25 និងអ៊ើរបានកើតកូនប្រុសពីរនាក់: ឈ្មោះរបស់មួយគឺភីលេក, ដ្បិតនៅជំនាន់របស់លោកផែនដីបានបែកខ្ញែកគ្នាហើយ, និងឈ្មោះបងប្រុសរបស់គាត់គឺចូខេន.
10:32 ទាំងនេះជាក្រុមគ្រួសាររបស់លោកណូអេ, នេះបើយោងតាមប្រជាជននិងប្រជាជាតិរបស់ពួកគេ.
11:2 ហើយនៅពេលដែលពួកគេបានធ្វើដំណើរទៅមុខពីខាងកើត, ពួកគេបានរកឃើញវាលទំនាបមួយនៅស្រុកស៊ីណាន, ហើយពួកគេបានរស់នៅក្នុងនោះ.
11:5 ពេលនោះព្រះអម្ចាស់យាងចុះទតឃើញក្រុងនិងប៉ម, ដែលកូនប្រុសរបស់អ័ដាមកំពុងតែសាងសង់.
11:8 ដូច្នេះព្រះអម្ចាស់បានញែកពួកគេចេញពីកន្លែងនោះទៅជាដែនដីទាំងអស់, ហើយពួកគេបានបញ្ឈប់ការសាងសង់ទីក្រុង.
ហើយចាប់ពីពេលនោះមក, ព្រះអម្ចាស់បានកំចាត់កំចាយពួកគេអោយនៅពាសពេញតំបន់.
សិមមានអាយុមួយរយឆ្នាំនៅពេលគាត់មានគភ៌អ័ផាក់សាដ, ពីរឆ្នាំបន្ទាប់ពីទឹកជំនន់ដ៏អស្ចារ្យ.
11:12 បន្ទាប់, លោកអាផាក់ស៊ីដរស់នៅសាមសិបប្រាំឆ្នាំ, ហើយបន្ទាប់មកគាត់មានគភ៌សេឡា.
11:14 ដូចគ្នា, សេឡារស់នៅបានសាមសិបឆ្នាំ, ហើយបន្ទាប់មកគាត់មានគភ៌អេប៊ឺរ.
11:20 បន្ទាប់មករេហរស់នៅបានសាមសិបពីរឆ្នាំ, ហើយបន្ទាប់មកគាត់មានគភ៌សេហ្គក.
11:22 ជាការពិត, សេហ្គររស់នៅបានសាមសិបឆ្នាំ, ហើយបន្ទាប់មកគាត់មានគភ៌ណាឃរ.
11:24 ដូច្នេះណាហ័របានរស់នៅអស់រយៈពេល ២៥ ឆ្នាំ, ហើយបន្ទាប់មកគាត់បានមានផ្ទៃពោះធីរ៉ា.
11:26 ហើយថេរ៉ារស់នៅបានចិតសិបឆ្នាំ, បន្ទាប់មកគាត់មានគភ៌អាប់រ៉ាម, និងណាឃរ, និងហារ៉ាន.
ថេរ៉ាបង្កើតបានអាប់រ៉ាម, ណាហ័រ, និងហារ៉ាន.
11:28 ហើយហារ៉ានបានស្លាប់មុនឪពុកថេរ៉ា, នៅក្នុងដែនដីកំណើតរបស់គាត់, នៅទីក្រុងអ៊ើរនៃជនជាតិខាល់ដេ.
ប្រពន្ធរបស់អាប់រ៉ាមគឺសារ៉ាយ.
ហើយពួកគេបានទៅដល់ជិតស្រុកខារ៉ាន, ហើយពួកគេបានរស់នៅទីនោះ.
12:2 យើងនឹងធ្វើអោយអ្នកក្លាយជាប្រជាជាតិមួយដ៏អស្ចារ្យ, យើងនឹងអោយពរអ្នកហើយលើកតម្កើងព្រះនាមរបស់អ្នក, ហើយអ្នកនឹងត្រូវបានប្រទានពរ.
12:4 លោកអាប់រ៉ាមក៏ចាកចេញទៅស្របតាមព្រះបន្ទូលដែលព្រះអម្ចាស់បានបង្គាប់, ហើយឡុតបានទៅជាមួយគាត់.
12:5 ហើយគាត់បានយកប្រពន្ធរបស់គាត់ឈ្មោះសារ៉ាយ, និងឡុត, កូនប្រុសរបស់បងប្រុសរបស់គាត់, និងសារធាតុទាំងអស់ដែលពួកគេបានកាន់កាប់, និងជីវិតដែលពួកគេបានទទួលនៅស្រុកខារ៉ាន, ពួកគេក៏ចាកចេញទៅដើម្បីទៅស្រុកកាណាន.
12:6 លោកអាប់រ៉ាមឆ្លងកាត់ស្រុករហូតដល់កន្លែងស៊ីគែម, ដូចជានៅលើជ្រលងភ្នំដ៏ល្បីល្បាញ.
គាត់ក៏បានសង់អាសនៈមួយនៅទីនោះថ្វាយព្រះអម្ចាស់ដែរ, ហើយគាត់បានហៅឈ្មោះរបស់គាត់.
12:14 ហើយ ដូច្នេះ, ពេលអាប់រ៉ាមមកដល់ស្រុកអេស៊ីប, ជនជាតិអេស៊ីបឃើញស្ត្រីនោះមានរូបឆោមស្រស់ស្អាតគួរអោយស្រឡាញ់.
ស្ត្រីនោះត្រូវគេនាំទៅក្នុងដំណាក់របស់ព្រះចៅផារ៉ោន.
គាត់មានចៀមមានគោនិងលាញីឈ្មោល, និងបុរសបម្រើ, និងស្ត្រីបម្រើ, និងសត្វលា, និងអូដ្ឋ.
12:20 ព្រះចៅផារ៉ោនបានបញ្ជាទាហានរបស់លោកអំពីអាប់រ៉ាម.
13:2 ប៉ុន្តែគាត់ជាអ្នកមានណាស់ដោយមានមាសនិងប្រាក់.
13:4 នៅទីនោះ, នៅកន្លែងរបស់អាសនៈដែលគាត់បានធ្វើពីមុន, លោកបានអំពាវនាវដល់ព្រះនាមព្រះអម្ចាស់ម្តងទៀត.
13:6 ហើយក៏គ្មានដីអាចផ្ទុកដីទាំងនោះបានដែរ, ដូច្នេះពួកគេអាចរស់នៅជាមួយគ្នា.
13:7 ហើយក្រោយមកក៏មានជម្លោះរវាងពួកគង្វាលរបស់អាប់រ៉ាមនិងឡុត.
13:8 ដូច្នេះ, អាប់រ៉ាមបាននិយាយទៅកាន់ឡុត: ខ្ញុំសួរអ្នក, កុំអោយមានជម្លោះរវាងខ្ញុំនិងអ្នក, និងរវាងគង្វាលរបស់ខ្ញុំនិងគង្វាលរបស់អ្នក.
ប្រសិនបើអ្នកនឹងទៅខាងឆ្វេង, ខ្ញុំនឹងយកសិទ្ធិ.
13:10 ដូច្នេះហើយឡុត, ងើបភ្នែកឡើង, បានឃើញតំបន់នៅជុំវិញទន្លេយ័រដាន់, ដែលត្រូវបានស្រោចស្រពយ៉ាងហ្មត់ចត់, មុនពេលដែលព្រះអម្ចាស់ផ្ដួលរំលំក្រុងសូដុមនិងកូម៉ូរ៉ា.
13:11 ហើយឡុតបានជ្រើសរើសតំបន់នៅជុំវិញទន្លេយ័រដាន់សម្រាប់ខ្លួនគាត់ផ្ទាល់, ហើយលោកបានចាកចេញទៅខាងកើត.
13:13 ប៉ុន្ដែបុរសនៅក្រុងសូដុមគឺអាក្រក់ណាស់, ពួកគេជាមនុស្សមានបាបនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់.
បើអ្នកណាអាចរាប់ធូលីដីបាន, គាត់ក៏អាចរាប់ចំនួនកូនចៅរបស់អ្នកដែរ.
ព្រោះខ្ញុំនឹង ឲ្យ វាដល់អ្នក»។
គាត់បានសង់អាសនៈមួយនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់.
14:3 ទាំងអស់នេះបានមកជាមួយគ្នានៅជ្រលងភ្នំដែលមានព្រៃ, ដែលឥឡូវនេះជាសមុទ្រអំបិល.
14:6 និងឆ័ររ៉េននៅលើភ្នំសៀរ, សូម្បីតែនៅតំបន់ទំនាបប៉ារ៉ាន, ដែលនៅក្នុងទីរហោស្ថាន.
ពួកគេវាយលុកតំបន់អាម៉ាលេកទាំងមូល, និងជនជាតិអាម៉ូរីដែលរស់នៅក្នុងហាហ្សាហ្សានតាម៉ា.
ហើយអ្នកដែលនៅសល់, ភៀសខ្លួនទៅភ្នំ.
សម្រាប់អ្នកទាំងនេះបានបង្កើតកិច្ចព្រមព្រៀងជាមួយអាប់រ៉ាម.
14:15 និងបែងចែកក្រុមហ៊ុនរបស់គាត់, យប់នោះគាត់ក៏ជិះមកលើពួកគេ.
14:16 ហើយគាត់បានយកមកវិញនូវវត្ថុទាំងអស់, និងឡុតបងប្រុសរបស់គាត់, ជាមួយសារធាតុរបស់គាត់, ដូចគ្នានេះដែរស្ត្រីនិងប្រជាជន.
14:18 បន្ទាប់មកនៅក្នុងសេចក្តីពិត, មិលគីស្សាដែក, ស្តេចនៃសាឡឹម, នាំយកនំបុ័ងនិងស្រាមកជូន, លោកជាបូជាចារ្យរបស់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុត;
14:20 សូមព្រះជាម្ចាស់ប្រទានពរដល់ព្រះដ៏ខ្ពង់ខ្ពស់បំផុត, ខ្មាំងសត្រូវស្ថិតនៅក្នុងកណ្តាប់ដៃអ្នកហើយការពារពួកគេ” ។ ហើយគាត់បានថ្វាយមួយភាគដប់ពីអ្វីទាំងអស់.
កូនប្រុសរបស់អ្នកបម្រើនៃផ្ទះរបស់ខ្ញុំគឺអេលាស៊ើរនៅក្រុងដាម៉ាស»។
ប៉ុន្តែអ្នកណាដែលចេញពីចង្កេះរបស់អ្នក, អ្នកក៏នឹងទទួលមត៌កដូចអ្នកដែរ»។
15:6 អាប់រ៉ាមជឿលើព្រះជាម្ចាស់, ហើយគាត់ត្រូវបានគេស្គាល់ថាជាអ្នករកយុត្តិធម៌.
15:10 យករបស់ទាំងអស់នេះ, គាត់បានបែងចែកពួកគេនៅកណ្តាល, ហើយដាក់ផ្នែកទាំងពីរនៅទល់មុខគ្នា.
15:11 ហើយសត្វបក្សីបានចុះមកលើគ្រោងឆ្អឹង, ប៉ុន្តែអាប់រ៉ាមបានបណ្តេញពួកគេចេញ.
15:13 ហើយវាត្រូវបានគេនិយាយទៅគាត់: “ ត្រូវដឹងជាមុនថាកូនចៅអនាគតរបស់អ្នកនឹងត្រូវស្នាក់នៅក្នុងទឹកដីដែលមិនមែនជាកម្មសិទ្ធិរបស់ពួកគេ, ពួកគេនឹងបង្ខំពួកគេអោយធ្វើជាខ្ញុំកញ្ជះហើយធ្វើបាបពួកគេអស់រយៈពេលបួនរយឆ្នាំ.
15:15 អ្នកនឹងទៅជួបឪពុករបស់អ្នកដោយសុខក្សេមក្សាន្តហើយត្រូវគេបញ្ចុះនៅយុគសម័យចាស់.
ព្រោះអំពើទុច្ចរិតរបស់ជនជាតិអាម៉ូរីមិនទាន់ត្រូវបានបញ្ចប់នៅឡើយទេ, រហូតមកដល់បច្ចុប្បន្ននេះ»។
15:18 នៅ ថ្ងៃ នោះ, ព្រះបានធ្វើកិច្ចព្រមព្រៀងជាមួយអាប់រ៉ាម, និយាយ: យើងនឹងប្រគល់ទឹកដីនេះដល់កូនចៅរបស់អ្នក, ពីទន្លេអេស៊ីព្ទ, សូម្បីតែទន្លេអឺប្រាត:
ប៉ុន្តែ, មានស្ដ្រីបំរើជនជាតិអេស៊ីបម្នាក់ឈ្មោះហាការ,
16:5 ហើយសារ៉ាយនិយាយទៅកាន់អាប់រ៉ាម: អ្នកបានធ្វើអយុត្តិធម៌មកលើខ្ញុំ.
16:7 ហើយនៅពេលដែលទេវតារបស់ព្រះអម្ចាស់បានរកឃើញនាង, នៅជិតប្រភពទឹកនៅវាលរហោស្ថាន, ដែលនៅតាមផ្លូវទៅសូរ៉ានៅវាលខ្សាច់,
ហើយតើអ្នកនឹងទៅទីណា?
16:9 ទេវតារបស់ព្រះអម្ចាស់ពោលមកកាន់នាង, “ ត្រឡប់ទៅម្ចាស់ស្រីរបស់អ្នក, ហើយបន្ទាបខ្លួនអ្នកនៅក្រោមដៃរបស់នាង។
16:14 ព្រោះតែ រឿង នេះ, នាងបានហៅថាល្អ: “ អណ្តូងរបស់អ្នកដែលរស់នៅហើយដែលបានឃើញខ្ញុំ។ ” គឺដូចគ្នារវាងកាដេសនិងបេត.
16:16 អាប់រ៉ាមមានអាយុប៉ែតសិបប្រាំមួយឆ្នាំនៅពេលដែលហាការបានបង្កើតអ៊ីស្មាអែលសម្រាប់គាត់.
17:1 ជាការពិត, បន្ទាប់ពីគាត់ចាប់ផ្តើមមានអាយុកៅសិបប្រាំបួនឆ្នាំ, ព្រះអម្ចាស់បានបង្ហាញខ្លួនអោយគាត់ឃើញ.
ដើរនៅមុខខ្ញុំហើយក្លាយជាពេញលេញ.
17:9 ព្រះជាម្ចាស់មានព្រះបន្ទូលទៅកាន់លោកអប្រាហាំម្តងទៀត: «ដូច្នេះអ្នកត្រូវរក្សាសេចក្ដីសញ្ញារបស់យើង, និងកូនចៅរបស់អ្នកបន្ទាប់ពីអ្នកនៅជំនាន់របស់ពួកគេ.
17:11 ហើយអ្នកត្រូវកាត់ស្បែកខាងស្បែក, ដូច្នេះវាជាសញ្ញានៃសម្ពន្ធមេត្រីរវាងខ្ញុំនិងអ្នក.
ដូចគ្នានេះផងដែរអ្នកបំរើដែលកើតមកអ្នក, ក៏ដូចជាអ្នកដែលបានទិញ, ត្រូវកាត់ស្បែក, សូម្បីតែអ្នកដែលមិនមែនជាភាគហ៊ុនរបស់អ្នក.
17:14 បុរស, សាច់របស់ស្បែកគ្របក្បាលលិង្គមិនកាត់ស្បែកទេ, ព្រលឹងនោះនឹងត្រូវដកចេញពីប្រជារាស្ត្ររបស់ព្រះអង្គ.
គាត់នឹងផលិតអ្នកដឹកនាំដប់ពីរនាក់, យើងនឹងធ្វើអោយគេក្លាយទៅជាប្រជាជាតិដ៏ប្រសើរបំផុត.
17:24 អ័ប្រាហាំមានអាយុកៅសិបប្រាំបួនឆ្នាំនៅពេលដែលគាត់បានកាត់ស្បែករបស់ស្បែកគ្របក្បាលលិង្គ.
18:2 ហើយនៅពេលដែលគាត់បានងើបភ្នែកឡើង, ព្រះអង្គបានបង្ហាញខ្លួនអោយបុរសបីនាក់ឃើញ, ឈរក្បែរគាត់.
18:5 ហើយខ្ញុំនឹងរៀបចំនំប៉័ងមួយដុំ, ដូច្នេះអ្នកអាចពង្រឹងចិត្តអ្នកបាន; បន្ទាប់ពីនេះអ្នកនឹងឆ្លងកាត់.
18:6 លោកអប្រាហាំប្រញាប់ប្រញាល់ចូលក្នុងតង់ទៅសារ៉ា, ព្រះយេស៊ូមានព្រះបន្ទូលទៅនាង, “ យ៉ាងឆាប់រហ័ស, លាយម្សៅស្រូវសាលីល្អបំផុតបីរង្វាស់និងធ្វើនំប៉័ងដុតនៅក្រោមផេះ។
18:8 ដូចគ្នា, គាត់យកប៊ឺនិងទឹកដោះគោ, និងកំភួនជើងដែលគាត់បានដាំឱ្យពុះ, ហើយគាត់ដាក់វានៅមុខពួកគេ.
18:10 គាត់ឆ្លើយទៅគាត់វិញ, ពេលត្រឡប់មកវិញ, ខ្ញុំនឹងមករកអ្នកនៅពេលនេះ, ជាមួយជីវិតជាដៃគូ, ហើយប្រពន្ធរបស់អ្នកឈ្មោះសារ៉ានឹងមានកូនប្រុសមួយ។ this នេះ, សារ៉ាសើចនៅខាងក្រោយទ្វារតង់.
18:16 ដូច្នេះ, នៅពេលដែលបុរសបានក្រោកពីទីនោះ, ពួកគេតម្រង់ភ្នែកឆ្ពោះទៅក្រុងសូដុម.
18:21 ខ្ញុំនឹងចុះមកហើយមើលថាតើពួកគេបានបំពេញកិច្ចការនៃការស្រែកដែលបានមកដល់ខ្ញុំដែរឬទេ, ឬថាតើវាមិនមែនដូច្នោះទេ, ដើម្បីខ្ញុំអាចដឹងបាន”
តាមពិត, លោកអប្រាហាំនៅតែឈរនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់.
18:24 ប្រសិនបើមានហាសិបក្នុងចំណោមមនុស្សសុចរិតនៅក្នុងទីក្រុង, ពួកគេនឹងត្រូវស្លាប់ជាមួយអ្នកដែលនៅសល់?
អ្នកថ្កោលទោសផែនដីទាំងមូល; អ្នកនឹងមិនធ្វើការវិនិច្ឆ័យបែបនេះទេ។
តើអ្នក, ទោះបីជាសែសិបប្រាំ, លុបបំបាត់ទីក្រុងទាំងមូល?ហើយគាត់បាននិយាយ, ខ្ញុំនឹងមិនលុបបំបាត់វាចោលឡើយ, ប្រសិនបើខ្ញុំរកឃើញសែសិបប្រាំនៅទីនោះ។
តើមានអ្វីកើតឡើងប្រសិនបើសាមសិបត្រូវបានគេរកឃើញនៅទីនោះ?គាត់ឆ្លើយ, ខ្ញុំនឹងមិនធ្វើទេ, ប្រសិនបើខ្ញុំរកឃើញសាមសិបនៅទីនោះ។
តើមានអ្វីកើតឡើងប្រសិនបើម្ភៃត្រូវបានគេរកឃើញនៅទីនោះ?"
18:33 ព្រះអម្ចាស់ចាកចេញទៅ, ក្រោយពីគាត់បានឈប់និយាយជាមួយអាប្រាហាំ, ដែលបន្ទាប់មកបានត្រឡប់ទៅកន្លែងរបស់គាត់.
19:1 ហើយទេវតាទាំងពីរបានទៅដល់សូដុមនៅពេលល្ងាច, ហើយឡុតកំពុងអង្គុយនៅមាត់ទ្វារក្រុង.
លាងជើងរបស់អ្នក, ហើយនៅពេលព្រឹកអ្នកនឹងជឿនទៅមុខ” ។ ហើយពួកគេនិយាយ, “ មិនមែនទេ.
19:4 ប៉ុន្តែមុនពេលពួកគេចូលគេង, បុរសនៃទីក្រុងបានព័ទ្ធជុំវិញផ្ទះ, ពីក្មេងប្រុសទៅបុរសចំណាស់, ប្រជាជនទាំងអស់រួមគ្នា.
នាំពួកគេចេញពីទីនេះ, ដូច្នេះយើងអាចស្គាល់ពួកគេ” ។
ខ្ញុំនឹងនាំវាចេញមករកអ្នក; ធ្វើបាបពួកគេដូចដែលវាពេញចិត្តអ្នក, បានផ្តល់ថាអ្នកមិនបានធ្វើអាក្រក់ដល់បុរសទាំងនេះ, ពីព្រោះពួកគេចូលជ្រកក្រោមដំបូលផ្ទះរបស់ខ្ញុំ។
ដូច្នេះ, យើងនឹងធ្វើបាបអ្នកច្រើនជាងពួកគេទៅទៀត។ ពួកគេបានប្រព្រឹត្ដយ៉ាងសាហាវទៅលើឡុត.
19:13 សម្រាប់យើងនឹងលុបបំបាត់កន្លែងនេះ, ពីព្រោះការស្រែកយំក្នុងចំណោមពួកគេបានកើនឡើងនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់, ព្រះអង្គបានចាត់យើងអោយមកបំផ្លាញពួកគេ។
ចាកចេញពីកន្លែងនេះ.
19:15 ហើយនៅពេលព្រឹក, ពួកទេវតាបានបង្ខំគាត់, និយាយ, ចូរក្រោកឡើង, យកប្រពន្ធរបស់អ្នក, និងកូនស្រីទាំងពីរដែលអ្នកមាន, ក្រែងលោអ្នកត្រូវវិនាសអន្ដរាយពេលមានអំពើអាក្រក់នៅក្នុងទីក្រុងផង។
ប៉ុន្តែជួយសង្រ្គោះខ្លួនអ្នកនៅលើភ្នំ, ក្រែងលោអ្នកនឹងត្រូវវិនាសដែរ” ។
19:19 ទោះបីទូលបង្គំជាអ្នកបំរើរបស់ព្រះអង្គបានគាប់ព្រះហឫទ័យព្រះអង្គក៏ដោយ, ហើយអ្នកបានលើកតម្កើងសេចក្តីមេត្តាករុណារបស់អ្នក, ដែលអ្នកបានបង្ហាញដល់ខ្ញុំក្នុងការសង្គ្រោះជីវិតរបស់ខ្ញុំ, ខ្ញុំមិនអាចសង្រ្គោះនៅលើភ្នំបានទេ, ក្រែងលោមានសំណាងអាក្រក់ខ្លះចាប់ខ្ញុំហើយខ្ញុំស្លាប់.
តើវាមិនមែនជារឿងសាមញ្ញទេ, ហើយព្រលឹងខ្ញុំនឹងមិនរស់ទេ?”
19:25 ហើយគាត់បានផ្តួលរំលំទីក្រុងទាំងនេះ, និងតំបន់ជុំវិញទាំងអស់: អ្នកស្រុកទាំងអស់នៃទីក្រុង, និងអ្វីៗទាំងអស់ដែលហូរចេញពីដី.
19:27 បន្ទាប់មកអាប្រាហាំ, ក្រោកឡើងនៅពេលព្រឹក, នៅកន្លែងដែលគាត់បានឈរនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់,
ហើយគាត់ឃើញអណ្តាតភ្លើងកំពុងរះចេញពីដីដូចជាផ្សែងចេញពីឡ.
19:30 ហើយឡុតបានឡើងពីហ្សារ៉ូ, ព្រះអង្គគង់នៅលើភ្នំ, ហើយកូនស្រីទាំងពីររបស់គាត់ក៏នៅជាមួយដែរ, (ព្រោះគាត់ខ្លាចរស់នៅក្នុងក្រុងសូអារ) ហើយគាត់បានរស់នៅក្នុងរូងភ្នំ, គាត់និងកូនស្រីពីរនាក់នៅជាមួយគាត់.
19:32 មក, ចូរយើងផឹកស្រាជាមួយស្រារបស់យើង!, ហើយអោយយើងដេកជាមួយគាត់, ដូច្នេះយើងអាចការពារកូនចៅរបស់ឪពុកយើងបាន។
ហើយអែលឌើរបានចូលទៅ, ហើយនាងបានដេកជាមួយឪពុករបស់នាង.
19:34 ដូចគ្នា, នៅ ថ្ងៃ បន្ទាប់, អែលឌើរបាននិយាយទៅកាន់ក្មេងជាង: «មើលចុះ, ម្សិលមិញខ្ញុំបានដេកជាមួយឪពុកខ្ញុំ, សូមឱ្យយើងផឹកស្រាឱ្យគាត់ផឹកម្តងទៀតនៅយប់នេះ, ហើយអ្នកនឹងដេកជាមួយគាត់, ដូច្នេះយើងនឹងសង្គ្រោះកូនចៅរបស់ឪពុកយើង។
ហើយសូម្បីតែគាត់មិនបានដឹងខ្លួននៅពេលនាងដេក, ឬពេលនាងក្រោកឡើង.
20:1 លោកអប្រាហាំបានធ្វើដំណើរពីទីនោះឆ្ពោះទៅស្រុកខាងត្បូង, ហើយគាត់រស់នៅចន្លោះកាដេសនិងស៊ើរ.
ហេតុនេះហើយបានជាខ្ញុំឃាត់អ្នកមិនអោយធ្វើបាបខ្ញុំ, ហើយខ្ញុំមិនបានដោះលែងអ្នកឱ្យប៉ះនាងទេ.
ហើយគាត់នឹងអធិស្ឋានឱ្យអ្នក, ហើយអ្នកនឹងរស់នៅ.
20:8 ហើយភ្លាមៗនោះអប៊ីម៉ាឡេក, ក្រោកឡើងនៅពេលយប់, បានហៅអ្នកបម្រើទាំងអស់របស់គាត់.
20:9 បន្ទាប់មកអ័ប៊ីម៉ា ឡេកក៏បានហៅលោកអប្រាហាំដែរ, ព្រះយេស៊ូមានព្រះបន្ទូលទៅគាត់: តើអ្នកបានធ្វើអ្វីដល់ពួកយើង?
អ្នកបានធ្វើចំពោះយើងនូវអ្វីដែលអ្នកមិនគួរធ្វើ។
20:11 អ័ប្រាហាំបានឆ្លើយតប: “ ខ្ញុំបានគិតដោយខ្លួនឯង, និយាយ: ប្រហែលជាគ្មានការកោតខ្លាចព្រះនៅកន្លែងនេះទេ.
នៅគ្រប់ទីកន្លែង, ដែលយើងនឹងធ្វើដំណើរ, អ្នកនឹងនិយាយថាខ្ញុំជាបងប្អូនរបស់អ្នក› ។
ហើយគាត់បានប្រគល់ប្រពន្ធរបស់គាត់សារ៉ាឱ្យគាត់.
នេះនឹងសម្រាប់អ្នកជាស្បៃមុខសម្រាប់ភ្នែករបស់អ្នក, ដល់អ្នកទាំងអស់ដែលនៅជាមួយអ្នកនិងកន្លែងដែលអ្នកនឹងធ្វើដំណើរ.
20:17 បន្ទាប់មកនៅពេលអ័ប្រាហាំបានអធិស្ឋាន, ព្រះបានព្យាបាលអ័ប៊ីម៉ាឡេកនិងភរិយារបស់គាត់, និងអ្នកបំរើរបស់គាត់, ហើយពួកគេបានផ្តល់កំណើតឱ្យ.
21:2 នាងមានផ្ទៃពោះហើយសំរាលបានកូនប្រុសមួយពេលនាងមានអាយុចាស់ជរា, នៅពេលដែលព្រះបានទាយប្រាប់នាង.
21:4 នៅថ្ងៃទីប្រាំបីលោកបានធ្វើពិធីកាត់ស្បែកអោយ, ដូចព្រះបានណែនាំគាត់,
ជា ការ ពិត, នៅដំណាក់កាលនៃជីវិតរបស់ឪពុកគាត់, អ៊ីសាកបានកើតមក.
21:9 ហើយនៅពេលដែលសារ៉ាបានឃើញកូនប្រុសរបស់ហាកាយជនជាតិអេស៊ីបកំពុងតែលេងជាមួយអ៊ីសាកជាកូនប្រុសរបស់គាត់, នាងបាននិយាយទៅកាន់អ័ប្រាហាំ:
កូនប្រុសរបស់ស្ត្រីអ្នកបម្រើនឹងមិនទទួលមរតកជាមួយអ៊ីសាកជាកូនប្រុសរបស់ខ្ញុំឡើយ»។
21:12 ព្រះជាម្ចាស់មានព្រះបន្ទូលមកគាត់: កុំធ្វើឱ្យអ្នកពិបាកចិត្តចំពោះក្មេងប្រុសនិងស្រីរបស់អ្នក.
21:15 ហើយនៅពេលដែលទឹកនៅក្នុងស្បែកត្រូវបានគេប្រើប្រាស់, នាងបានទុកក្មេងប្រុសនោះចោល, នៅក្រោមដើមឈើមួយដែលនៅទីនោះ.
សម្រាប់នាងបាននិយាយ, ខ្ញុំនឹងមិនឃើញក្មេងនោះស្លាប់ទេ។ ហើយ ដូច្នេះ, អង្គុយទល់មុខនាង, គាត់បន្លឺសំឡេងឡើងយំ.
ត្បិតព្រះទ្រង់បានស្តាប់តាមសំលេងរបស់ក្មេងប្រុស, ពីកន្លែងដែលគាត់នៅ.
យកក្មេងហើយឱបគាត់ដោយដៃ.
21:21 ហើយគាត់បានរស់នៅវាលខ្សាច់ប៉ារ៉ាន, ម្ដាយរបស់គាត់បានយកប្រពន្ធមួយសំរាប់គាត់ពីស្រុកអេស៊ីប.
ហើយពួកគេទាំងពីរនាក់បានវាយប្រហារកតិកាសញ្ញាមួយ.
21:29 លោកអប៊ីម៉ាឡេកមានប្រសាសន៍ទៅកាន់គាត់, “ តើកូនចៀមញីទាំងប្រាំពីរនេះមានគោលបំណងអ្វី?, ដែលអ្នកបណ្តាលឱ្យឈរដោយឡែកពីគ្នា?”
21:31 សម្រាប់ ហេតុផល នេះ, កន្លែងនោះមានឈ្មោះថាបៀរសេបា, ពីព្រោះនៅទីនោះពួកគេទាំងពីរនាក់បានស្បថ.
21:33 បន្ទាប់មកអាប៊ីម៉ាឡេកនិងភីល, មេដឹកនាំនៃកងទ័ពរបស់គាត់, បានក្រោកឡើង, ហើយពួកគេបានវិលត្រឡប់មកទឹកដីប៉ាឡេស្ទីនវិញ.
21:34 ហើយគាត់ជាអ្នកតាំងលំនៅនៅលើទឹកដីប៉ាឡេស្ទីនអស់រយៈពេលជាច្រើនថ្ងៃ.
នៅទីនោះអ្នកនឹងយកវាទៅធ្វើយញ្ញ បូជានៅលើភ្នំមួយ, ដែលខ្ញុំនឹងបង្ហាញដល់អ្នក»។
ឥឡូវនេះខ្ញុំដឹងថាអ្នកកោតខ្លាចព្រះជាម្ចាស់, ពីព្រោះអ្នកមិនបានទុកកូនប្រុសតែមួយរបស់អ្នកអោយខ្ញុំឡើយ។
22:17 ខ្ញុំនឹងប្រទានពរដល់អ្នក, យើងនឹងធ្វើអោយពូជពង្សរបស់អ្នកកើនចំនួនច្រើនឡើងដូចផ្កាយនៅលើមេឃ, ហើយដូចខ្សាច់នៅឆ្នេរសមុទ្រ.
22:18 ហើយនៅក្នុងកូនចៅរបស់អ្នក, ជាតិសាសន៍ទាំងអស់នៅលើផែនដីនឹងទទួលពរ, ពីព្រោះអ្នកបានស្តាប់តាមសំឡេងរបស់ខ្ញុំ”
មីលខាទាំង ៨ នេះបង្កើតសំរាប់ណាឃរ, បងប្អូនរបស់អ័ប្រាហាំ.
23:3 ហើយនៅពេលគាត់បានក្រោកពីកាតព្វកិច្ចបុណ្យសព, គាត់បាននិយាយជាមួយកូន ៗ របស់ហេត, និយាយ:
ហើយគ្មាននរណាម្នាក់អាចហាមឃាត់អ្នកមិនឱ្យបញ្ចុះសពអ្នកដែលបានស្លាប់ទៅក្នុងអនុស្សាវរីយ៍របស់គាត់បានឡើយ។
23:8 ព្រះអង្គមានព្រះបន្ទូលទៅគេថា៖: “ ប្រសិនបើវាផ្គាប់ចិត្តព្រលឹងអ្នកខ្ញុំគួរតែបញ្ចុះសពរបស់ខ្ញុំ, ស្តាប់ខ្ញុំ, និងអង្វរជំនួសខ្ញុំជាមួយអេភ្រូន, កូនរបស់លោកសូហារ,
គាត់អាចផ្ទេរប្រាក់មកខ្ញុំបានប្រាក់ច្រើនតាមដែលអ្នកអាចមើលឃើញ, ដើម្បីជាកន្លែងបញ្ចុះសព” ។
វាលដែលខ្ញុំនឹងផ្ទេរទៅអ្នក, និងរូងភ្នំដែលស្ថិតនៅក្នុងនោះ.
23:12 អាប្រាហាំគោរពនៅចំពោះមុខប្រជាជននៅស្រុកនោះ.
នេះជាតំលៃរវាងខ្ញុំនិងអ្នក.
កប់អ្នកស្លាប់របស់អ្នក។
23:17 ហើយដោយបានបញ្ជាក់ថាវាលស្រែ, ដែលក្នុងនោះមានរូងពីរជាន់មើលពីលើលោកម៉ាមឺរ, ពីមុនជាកម្មសិទ្ធិរបស់អេភូន, ទាំងវានិងផ្នូរ, និងដើមឈើទាំងអស់, ជាមួយដែនកំណត់ជុំវិញទាំងអស់,
23:19 អញ្ចឹងអញ្ចឹង, អ័ប្រាហាំបានបញ្ចុះប្រពន្ធរបស់គាត់ឈ្មោះសារ៉ានៅក្នុងរូងភ្នំពីរដងនៃវាលដែលបានមើលរំលងម៉ាមេរ.
23:20 ហើយវាលត្រូវបានបញ្ជាក់ដល់អាប្រាហាំ, ជាមួយរូងភ្នំដែលស្ថិតនៅក្នុងនោះ, ទុកជាអនុស្សាវរីយនៅចំពោះមុខកូនចៅហេត.
24:2 ហើយគាត់បាននិយាយទៅអ្នកបំរើចាស់នៃផ្ទះរបស់គាត់, គាត់ជាអ្នកទទួលខុសត្រូវលើអ្វីៗទាំងអស់ដែលគាត់មាន: ដាក់ដៃរបស់អ្នកនៅក្រោមភ្លៅរបស់ខ្ញុំ,
24:4 ប៉ុន្តែថាអ្នកនឹងបន្តទៅដីរបស់ខ្ញុំនិងប្រភេទ, ហើយនៅទីនោះយកប្រពន្ធ ឲ្យ អ៊ីសាកកូនប្រុសខ្ញុំ»។
24:6 ហើយអ័ប្រាហាំបាននិយាយ: “ ប្រយ័ត្នកុំនាំកូនខ្ញុំត្រឡប់ទៅកន្លែងនោះវិញ.
24:8 ប៉ុន្តែប្រសិនបើស្ត្រីមិនមានឆន្ទៈធ្វើតាមអ្នកទេ, អ្នកនឹងមិនត្រូវបានស្បថដោយសម្បថឡើយ.
24:9 ដូច្នេះ, អ្នកបម្រើបានដាក់ដៃក្រោមភ្លៅរបស់លោកអប្រាហាំ, ម្ចាស់របស់គាត់, ហើយគាត់បានស្បថនឹងគាត់តាមពាក្យរបស់គាត់.
ហើយដោយនេះ, ខ្ញុំនឹងយល់ថាព្រះអង្គបានសំដែងព្រះហប្ញទ័យមេត្តាករុណាចំពោះលោកម្ចាស់របស់ខ្ញុំ»។
24:16 នាងជាក្មេងស្រីដែលឆើតឆាយខ្លាំងណាស់, និងព្រហ្មចារីដ៏ស្រស់ស្អាតបំផុត, និងមិនស្គាល់ដោយបុរស.
24:17 ហើយអ្នកបំរើបានរត់ទៅជួបនាង, ហើយគាត់បាននិយាយ, សូមផ្តល់ទឹកបន្តិចអោយខ្ញុំផឹកពីក្អមរបស់អ្នក។
24:21 ប៉ុន្តែគាត់កំពុងគិតពិចារណាពីនាងដោយស្ងៀមស្ងាត់, ដោយចង់ដឹងថាតើព្រះអម្ចាស់បានធ្វើអោយដំណើររបស់គាត់រីកចំរើនរឺអត់
24:28 ដូច្នេះក្មេងស្រីបានរត់, ហើយនាងបានរាយការណ៍អំពីអ្វីៗទាំងអស់ដែលនាងបាន heard នៅក្នុងផ្ទះរបស់ម្ដាយនាង.
24:30 ហើយនៅពេលដែលគាត់បានឃើញក្រវិលនិងខ្សែដៃនៅក្នុងដៃបងស្រីរបស់គាត់, ហើយគាត់បាន heard ពាក្យទាំងអស់ត្រូវបានធ្វើម្តងទៀត, បុរសនេះនិយាយមកខ្ញុំ,គាត់បានមកជួបបុរសដែលឈរក្បែរអូដ្ឋនិងជិតប្រភពទឹក,
ហេតុអ្វីបានជាអ្នកឈរនៅខាងក្រៅ?
24:32 គាត់ក៏នាំវាចូលទៅក្នុងបន្ទប់ភ្ញៀវ.
ហើយគាត់បានផ្តល់ឱ្យគាត់នូវចៀមនិងគោ, ប្រាក់និងមាស, អ្នកបម្រើបុរសនិងអ្នកបំរើស្រី, អូដ្ឋនិងសត្វលា.
ហើយអ្នកនឹងយកប្រពន្ធសម្រាប់កូនប្រុសរបស់ខ្ញុំពីសាច់ញាតិរបស់ខ្ញុំនិងពីផ្ទះឪពុកខ្ញុំ.
ហើយនាងបានចុះទៅនិទាឃរដូវហើយគូរទឹក.
24:46 ហើយនាងក៏ទម្លាក់រណ្តៅចេញពីដៃរបស់នាង, ហើយបាននិយាយមកខ្ញុំ, 'អ្នក ផឹក, ហើយខ្ញុំនឹងចែកចាយទឹកផឹកដល់អូដ្ឋរបស់អ្នកផង, ហើយនាងបានស្រោចអូដ្ឋ.
24:48 និងការធ្លាក់ចុះក្រលៀន, ខ្ញុំគោរពព្រះអម្ចាស់, ប្រទានពរដល់ព្រះអម្ចាស់, ព្រះរបស់លោកអប្រាហាំជាម្ចាស់របស់ខ្ញុំ, ដែលនាំខ្ញុំទៅផ្លូវត្រង់ដើម្បីនាំកូនស្រីរបស់លោកម្ចាស់ខ្ញុំទៅកូនប្រុសរបស់គាត់.
ប៉ុន្តែប្រសិនបើវាពេញចិត្តអ្នកបើមិនដូច្នេះទេ, និយាយមកខ្ញុំផងដែរ, ដូច្នេះខ្ញុំនឹងទៅខាងស្ដាំ, ឬទៅខាងឆ្វេង” ។
យើងមិនអាចនិយាយអ្វីផ្សេងទៅកាន់អ្នកបានទេ, លើសពីអ្វីដែលគាប់ព្រះហឫទ័យព្រះអង្គ.
24:53 ព្រមទាំងនាំយកវត្ថុធ្វើពីមាសនិងប្រាក់មកផង, ក៏ដូចជាសម្លៀកបំពាក់, លោកបានប្រគល់ប្រាក់ទាំងនោះអោយនាងរេបិកាទុកជាសួយសារអាករ.
24:54 ហើយពិធីជប់លៀងមួយបានចាប់ផ្តើម, ពួកគេបានបរិភោគនិងផឹកជាមួយគ្នា, ហើយពួកគេបានស្នាក់នៅទីនោះ.
24:55 ហើយបងប្អូនប្រុសស្រីរបស់នាងបានឆ្លើយតប, “ សូមអោយក្មេងស្រីនេះស្នាក់នៅជាមួយយើងយ៉ាងហោចណាស់ដប់ថ្ងៃ, ហើយបន្ទាប់ពីនោះ, នាងនឹងបន្ដ។
ដោះលែង ខ្ញុំ, ដូច្នេះខ្ញុំត្រូវធ្វើដំណើរទៅរកម្ចាស់របស់ខ្ញុំ»។
24:60 ជូនពរភាពរុងរឿងសំរាប់ប្អូនស្រី, ដោយនិយាយ: អ្នកគឺជាបងស្រីរបស់យើង.
24:62 បន្ទាប់មក, ក្នុង ពេល ដំណាលគ្នា, អ៊ីសាកកំពុងតែដើរតាមផ្លូវដែលនាំទៅដល់អណ្តូងទឹក, ឈ្មោះរបស់គាត់គឺ: of ក្នុងចំណោមអ្នកដែលរស់នៅហើយដែលបានឃើញ។ ដ្បិតគាត់រស់នៅក្នុងទឹកដីខាងត្បូង.
ហើយនៅពេលដែលគាត់បានងើបភ្នែកឡើង, គាត់បានឃើញសត្វអូដ្ឋកំពុងតែធ្វើដំណើរពីចម្ងាយ.
អ្នកទាំងនេះសុទ្ធតែជាកូនរបស់លោកកេត្តា.
25:6 ប៉ុន្តែដល់កូនប្រុសរបស់ប្រពន្ធដើមគាត់បានផ្តល់អំណោយដ៏សប្បុរស, ហើយលោកបានបំបែកពួកគេចេញពីអ៊ីសាកជាកូនប្រុសរបស់គាត់, ខណៈពេលដែលគាត់នៅរស់, ឆ្ពោះទៅតំបន់ភាគខាងកើត.
25:9 ហើយអ៊ីសាកនិងអ៊ីស្មាអែលកូនប្រុសរបស់គាត់បានបញ្ចុះគាត់នៅក្នុងរូងភ្នំពីរ, ដែលស្ថិតនៅក្នុងចម្ការអេភូន, នៃកូនប្រុសរបស់លោកសូហារជនជាតិហេត, នៅទូទាំងពីតំបន់នៃ Mamre នេះ,
នៅទីនោះគាត់ត្រូវបានគេបញ្ចុះ, ជាមួយប្រពន្ធសារ៉ា.
ហើយទាំងនេះជាឈ្មោះរបស់ពួកគេពាសពេញបន្ទាយនិងទីប្រជុំជនរបស់ពួកគេ: មេដឹកនាំទាំងដប់ពីរនៃកុលសម្ព័ន្ធរបស់ពួកគេ.
និងថយចុះ, គាត់បានស្លាប់ហើយត្រូវបានដាក់នៅជាមួយប្រជាជនរបស់គាត់.
អាប្រាហាំមានផ្ទៃពោះអ៊ីសាក, 25:20 WHO, ពេលគាត់មានអាយុសែសិបឆ្នាំ, យករេបិកា, បងស្រីរបស់ឡាបាន់, កូនស្រីរបស់លោកបេធូអែលជនជាតិស៊ីរីមកពីស្រុកមេសូប៉ូតាមៀ, ជាប្រពន្ធ.
ហើយគាត់បាន heard គាត់, គាត់ក៏បង្កើតអោយមានគភ៌ជាមួយនាងរេបិកា.
ដូច្នេះនាងបាននិយាយ, ប្រសិនបើវាដូចខ្ញុំ, អ្វីដែលត្រូវការនៅទីនោះដើម្បីមានគភ៌?ហើយនាងបានទៅពិគ្រោះជាមួយព្រះអម្ចាស់.
25:24 ឥឡូវនេះដល់ពេលសំរាលកូនហើយ, ហើយមើលចុះ, កូនភ្លោះត្រូវបានគេរកឃើញនៅក្នុងស្បូនរបស់នាង.
នៅពេលមួយផ្សេងទៀតបានចាកចេញហើយគាត់បានកាន់ជើងបងប្រុសរបស់គាត់នៅក្នុងដៃរបស់គាត់; ហេតុនេះហើយបានជាគាត់មានឈ្មោះថា "យ៉ាកុប".
25:27 និងជាមនុស្សពេញវ័យ, អេសាវបានក្លាយជាអ្នកប្រមាញ់ដែលមានចំណេះដឹងនិងជាបុរសកសិកម្ម, ប៉ុន្តែយ៉ាកុប, បុរសសាមញ្ញម្នាក់, រស់នៅក្នុងតង់.
ហើយខ្ញុំនឹងផ្តល់ដល់កូនចៅរបស់អ្នកនៅគ្រប់តំបន់ទាំងអស់នេះ.
26:5 ព្រោះលោកអ័ប្រាហាំបានស្តាប់តាមសំលេងរបស់ខ្ញុំ, ហើយកាន់តាមបទបញ្ជានិងបទបញ្ជារបស់ខ្ញុំ, ហើយបានគោរពពិធីនិងច្បាប់។
26:7 ហើយនៅពេលដែលបុរសនៅកន្លែងនោះសាកសួរអំពីប្រពន្ធរបស់គាត់, គាត់ឆ្លើយ, នាងគឺជាប្អូនស្រីរបស់ខ្ញុំ” ។ ព្រោះគាត់ខ្លាចហ៊ានសារភាពថានាងជាគូរបស់គាត់, ដោយគិតថាប្រហែលជាគេនឹងធ្វើគុតព្រះអង្គព្រោះតែសម្រស់របស់នាង.
ព្រះអម្ចាស់ប្រទានពរដល់គាត់.
26:14 ដូចគ្នា, គាត់មានទ្រព្យសម្បត្ដិជាច្រើនរបស់ចៀមនិងគោ, និងគ្រួសារធំមួយ.
26:16 វាឈានដល់ចំនុចមួយដែលអ័ប៊ីម៉ាឡិចបាននិយាយទៅកាន់អ៊ីសាក, “ ចូរឃ្លាតឆ្ងាយពីយើងទៅ, ព្រោះឯងមានអំណាចជាងយើងទៅទៀត»។
26:18 ម្តងទៀត, គាត់ជីកអណ្តូងផ្សេងទៀត, ដែលពួកអ្នកបំរើរបស់លោកអប្រាហាំជាឪពុកបានជីក, និងមួយណា, បន្ទាប់ពីការស្លាប់របស់គាត់, ពួកភីលីស្ទីនធ្លាប់បានរារាំង.
26:22 ដំណើរទៅមុខពីទីនោះ, គាត់ជីកអណ្តូងមួយទៀត, ដែលពួកគេមិនបានឈ្លោះប្រកែកគ្នា.
26:23 បន្ទាប់មកគាត់ឡើងពីកន្លែងនោះទៅបៀរសេបា,
26:29 ដើម្បីកុំអោយយើងធ្វើបាបយើង, យើងមិនបានប៉ះពាល់អ្វីពីអ្នកទេ, ហើយមិនបានបណ្តាលឱ្យមានរបួសដល់អ្នកទេ, ប៉ុន្តែដោយមានសន្តិភាពយើងបានដោះលែងអ្នក, បានកើនឡើងដោយព្រះពររបស់ព្រះអម្ចាស់។
27:6 នាងមានប្រសាសន៍ទៅកូនប្រុសរបស់លោកយ៉ាកុប: “ ខ្ញុំ heard ឪពុកអ្នកនិយាយជាមួយអេសាវជាបងរបស់អ្នក, ហើយនិយាយទៅកាន់គាត់,
27:12 ប្រសិនបើឪពុកខ្ញុំដាក់ដៃលើខ្ញុំហើយយល់ពីវា, ខ្ញុំខ្លាចក្រែងគាត់គិតថាខ្ញុំសុខចិត្តមើលងាយគាត់, ខ្ញុំនឹងដាក់បណ្តាសាដល់ខ្លួនខ្ញុំ, ជំនួសឱ្យពរជ័យមួយ។
តែស្តាប់សំលេងខ្ញុំ, ហើយទៅដោយផ្ទាល់ដើម្បីនាំនូវអ្វីដែលខ្ញុំបាននិយាយ។
នាងបានរៀបចំសាច់, ដូចជានាងដឹងថាឪពុករបស់គាត់ចូលចិត្ត.
27:16 ហើយនាងបានគ្រវីដៃរបស់គាត់ដោយសត្វលលកតូចៗពីពពែវ័យក្មេង, ហើយនាងបានគ្របកញ្ចឹងករបស់គាត់.
ប៉ុន្តែដៃជាដៃរបស់អេសាវ” ។
ដូច្នេះ, ប្រទានពរដល់គាត់,
27:25 បន្ទាប់មកគាត់បាននិយាយ, “ នាំយកអាហារពីការបរបាញ់របស់អ្នកមកខ្ញុំ, កូនប្រុស របស់ខ្ញុំ, ដូច្នេះព្រលឹងរបស់ខ្ញុំអាចប្រទានពរដល់អ្នក” ហើយនៅពេលដែលគាត់បានបរិភោគអ្វីដែលត្រូវបានផ្តល់ជូន, គាត់ក៏នាំស្រាមកជូនគាត់.
ហើយភ្លាមៗនោះគាត់បានដឹងពីក្លិនក្រអូបនៃសម្លៀកបំពាក់របស់គាត់.
27:28 សូមព្រះប្រទានដល់អ្នក, ពីទឹកសន្សើមនៅលើមេឃនិងពីផែនដីដែលគ្មានខ្លាញ់, ស្រូវនិងស្រាមានច្រើន.
សូមឱ្យអ្នកក្លាយជាម្ចាស់នៃបងប្អូនរបស់អ្នក, ហើយសូមអោយកូនរបស់ម្ដាយអ្នកក្រាបនៅមុខអ្នក.
27:30 មិនយូរប៉ុន្មានអ៊ីសាកបានបំពេញពាក្យរបស់គាត់, លោកយ៉ាកុបក៏ចាកចេញទៅ, ពេលអេសាវមកដល់.
ហើយឆ្ងល់លើសពីអ្វីដែលអាចជឿបាន, គាត់ បាន និយាយ ថា: “ តើគាត់ជានរណាដែលកាលពីមុនបាននាំខ្ញុំពីការបរបាញ់របស់គាត់, ដែលខ្ញុំបានបរិភោគ, មុនពេលអ្នកមកដល់?
27:41 ដូច្នេះ, អេសាវតែងតែស្អប់យ៉ាកុប, សម្រាប់ពរដែលឪពុកបានប្រទានពរដល់គាត់.
27:42 រឿងទាំងនេះបានត្រូវរាយការណ៍ដល់រេបិកា.
27:44 ហើយអ្នកនឹងនៅជាមួយគាត់ពីរបីថ្ងៃទៀត, រហូតដល់កំហឹងរបស់បងប្អូនអ្នកបានធូរស្បើយ,
បន្ទាប់ពី នេះ, ខ្ញុំនឹងទៅរកអ្នកហើយនាំអ្នកពីទីនោះទៅទីនេះ.
27:46 រេបិកានិយាយទៅកាន់អ៊ីសាក, “ ខ្ញុំនឿយហត់នឹងជីវិតរបស់ខ្ញុំដោយសារតែកូនស្រីហេត.
28:2 តែទៅ, និងធ្វើដំណើរទៅតំបន់មេសូប៉ូតាមៀនៃប្រទេសស៊ីរី, ដល់ផ្ទះរបស់បេធូអែល, ឪពុកម្តាយរបស់អ្នក, ហើយនៅទីនោះទទួលយកប្រពន្ធពីកូនស្រីរបស់ឡាបាន, ឪពុកម្តាយរបស់អ្នក.
28:6 ប៉ុន្តែអេសាវ, ដោយឃើញថាឪពុករបស់គាត់បានអោយពរដល់លោកយ៉ាកុបហើយបានបញ្ជូនគាត់អោយទៅស្រុកមេសូប៉ូតាមៀនៅស្រុកស៊ីរី, ដើម្បីយកប្រពន្ធពីទីនោះ, ហើយនោះ, បន្ទាប់ពីការប្រសិទ្ធពរ, គាត់បានណែនាំគាត់, និយាយ: អ្នកមិនត្រូវទទួលយកប្រពន្ធពីកូនស្រីនៅស្រុកកាណានឡើយ,'
28:8 មានភស្ដុតាងមួយទៀតថាឪពុករបស់គាត់មិនគាប់ព្រះហឫទ័យនឹងបុត្រីស្រុកកាណានឡើយ,
28:10 ទន្ទឹមនឹងនេះដែរលោកយ៉ាកុប, បានចាកចេញពីបៀរសេបា, បន្តទៅហារ៉ាន.
28:12 ហើយគាត់បានឃើញនៅក្នុងដំណេករបស់គាត់: ជណ្តើរឈរនៅលើផែនដី, ជាមួយនឹងកំពូលប៉ះមេឃ, ផងដែរ, ពួកទេវតានៃព្រះឡើងនិងចុះតាមវា,
ដី, ដែលអ្នកដេក, យើងនឹងអោយអ្នកនិងកូនចៅរបស់អ្នក.
28:15 ហើយខ្ញុំនឹងធ្វើជាអាណាព្យាបាលរបស់អ្នកគ្រប់ទីកន្លែងដែលអ្នកនឹងធ្វើដំណើរ, យើងនឹងនាំអ្នករាល់គ្នាវិលត្រឡប់មកស្រុកនេះវិញ.
នេះមិនមែនក្រៅពីព្រះដំណាក់របស់ព្រះជាម្ចាស់និងជាខ្លោងទ្វារនៃស្ថានបរមសុខនោះទេ។
28:21 ហើយប្រសិនបើខ្ញុំនឹងវិលត្រឡប់ទៅផ្ទះឪពុកខ្ញុំវិញ, ពេលនោះព្រះអម្ចាស់នឹងធ្វើជាព្រះរបស់ខ្ញុំ,
29:2 ហើយគាត់បានឃើញអណ្តូងមួយនៅក្នុងវាលមួយ, ហើយមានហ្វូងចៀមបីនៅក្បែរនោះដែរ.
29:3 ហើយទំនៀមទម្លាប់គឺ, នៅពេលដែលចៀមទាំងអស់បានប្រមូលផ្តុំគ្នា, រមៀលថ្មចេញ.
29:7 លោកយ៉ាកុបមានប្រសាសន៍, “ នៅតែមានពន្លឺថ្ងៃច្រើន, ហើយវាមិនមែនជាពេលវេលាដើម្បីប្រគល់ហ្វូងសត្វទៅហ្វូងចៀមវិញទេ.
29:8 ពួកគេបានឆ្លើយតប, "យើង មិនអាច, រហូតដល់សត្វទាំងអស់បានប្រមូលផ្តុំគ្នាហើយយើងយកថ្មចេញពីមាត់អណ្តូង, ដូច្នេះយើងអាចស្រោចទឹកហ្វូងសត្វ។
29:10 នៅពេលដែលយ៉ាកុបបានឃើញនាង, ហើយគាត់ដឹងថាគាត់ជាបងប្អូនជីដូនមួយដំបូងរបស់ម្តាយគាត់, ហើយចៀមទាំងនោះជាចៀមរបស់លោកឡាបាន់ដែលជាពូរបស់គាត់, គាត់បានយកថ្មដែលបិទអណ្តូង.
ហើយលើកសំលេងឡើង, គាត់យំ.
ហើយ ដូច្នេះ, ប្រញាប់, នាងបានប្រកាសប្រាប់ឪពុករបស់នាង.
ហើយឱបគាត់, ហើយថើបគាត់យ៉ាងរាក់ទាក់, គាត់បាននាំគាត់ចូលទៅក្នុងផ្ទះរបស់គាត់.
29:14 គាត់បានឆ្លើយតប, “ អ្នកគឺជាឆ្អឹងនិងសាច់របស់ខ្ញុំ” ហើយបន្ទាប់ពីរយៈពេលមួយខែត្រូវបានបញ្ចប់,
ប្រាប់ខ្ញុំពីប្រាក់ឈ្នួលដែលអ្នកនឹងទទួលយក”
29:17 តែកាលដែលលេអាមានភ្នែកក្រៀមក្រំ, រ៉ាជែលមានរូបរាងឆើតឆាយហើយមានភាពទាក់ទាញក្នុងការមើល.
ហើយរឿងទាំងនេះហាក់ដូចជាគ្រាន់តែពីរបីថ្ងៃប៉ុណ្ណោះ, ដោយសារតែភាពអស្ចារ្យនៃសេចក្ដីស្រឡាញ់.
សម្រាប់ពេលនេះពេលវេលាត្រូវបានបំពេញហើយ, ដូច្នេះខ្ញុំនឹងចូលទៅឯនាង” ។
បន្ទាប់ពីយ៉ាកុបបានចូលទៅក្នុងនាង, នេះបើយោងតាមទម្លាប់, ពេលព្រឹកបានមកដល់, គាត់បានឃើញលេអា.
តើខ្ញុំមិនបានបម្រើអ្នកសម្រាប់រ៉ាជែលទេ?
29:26 ឡាបាន់ឆ្លើយ, “ វាមិនមែនជាការអនុវត្តនៅក្នុងកន្លែងនេះដើម្បីផ្តល់ឱ្យក្មេងជាងវ័យនៅក្នុងអាពាហ៍ពិពាហ៍ជាមុន.
ហើយខ្ញុំនឹង ឲ្យ មួយនេះដល់អ្នកដែរ, សម្រាប់សេវាកម្មដែលអ្នកនឹងផ្តល់ឱ្យខ្ញុំសម្រាប់រយៈពេល ៧ ឆ្នាំទៀត” ។
ហើយបន្ទាប់ពីមួយសប្តាហ៍បានកន្លងផុតទៅ, លោកយករ៉ាជែលធ្វើជាប្រពន្ធ.
29:30 និង, បន្ទាប់ពីរៀបការរួចគាត់បានរៀបការ, គាត់ពេញចិត្ដនឹងសេចក្ដីស្រឡាញ់របស់មនុស្សមុនចំពោះអតីត, ហើយគាត់បានបម្រើនៅជាមួយគាត់ប្រាំពីរឆ្នាំទៀត.
29:32 មានគភ៌, នាងសំរាលបានកូនប្រុសមួយ, ហើយនាងដាក់ឈ្មោះថារូបេន, និយាយ: «ព្រះអម្ចាស់ទតឃើញភាពអាម៉ាស់របស់ខ្ញុំ; ឥឡូវប្ដីរបស់ខ្ញុំនឹងស្រឡាញ់ខ្ញុំ។
29:34 ហើយនាងមានផ្ទៃពោះជាលើកទីបី, នាងសំរាលបានកូនប្រុសមួយទៀត, ហើយនាងបាននិយាយថា: ឥឡូវប្តីរបស់ខ្ញុំនឹងរួបរួមជាមួយខ្ញុំ, ព្រោះខ្ញុំបានបង្កើតកូនប្រុសដល់គាត់បីនាក់។ ហើយដោយសារតែរឿងនេះ, នាងដាក់ឈ្មោះថាលេវី.
ហើយនាងបានឈប់ពីការបង្កើតកូន.
30:1 បន្ទាប់មករ៉ាជែល, ដោយដឹងថានាងជាមនុស្សគ្មានកូន, ច្រណែននឹងបងស្រីរបស់នាង, ដូច្នេះនាងនិយាយទៅកាន់ប្តីរបស់នាង, “ ផ្តល់ឱ្យខ្ញុំនូវកុមារ, បើមិនដូច្នោះទេខ្ញុំនឹងស្លាប់” ។
30:8 អំពីនរណាដែលរ៉ាជែលបាននិយាយ, ព្រះបានប្រៀបធៀបខ្ញុំជាមួយប្អូនស្រីរបស់ខ្ញុំ, ហើយខ្ញុំបានឈ្នះហើយ»។ ហើយនាងបានហៅគាត់ថាណាបថាលី.
ជា ការ ពិត, ស្ត្រីនឹងហៅខ្ញុំថាមានពរហើយ” ព្រោះតែ រឿង នេះ, នាងបានហៅគាត់ថាអេស៊ើរ.
គាត់យករបស់ទាំងនេះទៅជូនម្ដាយគាត់ឈ្មោះលេអា.
30:15 នាងបានឆ្លើយតប, “ វាហាក់ដូចជារឿងតូចតាចសំរាប់អ្នក, ដែលអ្នកបានដណ្តើមយកខ្ញុំពីប្តីរបស់ខ្ញុំ, លើកលែងតែអ្នកនឹងយកផ្លែឈើរបស់កូនខ្ញុំផង?រ៉ាក់និយាយ, គាត់នឹងរួមដំណេកជាមួយអ្នកយប់នេះដោយសារតែការបង្ខំរបស់កូនអ្នក” ។
30:18 ហើយនាងបាននិយាយ, “ ព្រះជាម្ចាស់បានប្រទានរង្វាន់ដល់ខ្ញុំ, ពីព្រោះខ្ញុំបានអោយអ្នកបំរើរបស់ខ្ញុំទៅប្តីរបស់ខ្ញុំ។ ហើយនាងបានដាក់ឈ្មោះថាអ៊ីសាកា.
30:25 ប៉ុន្តែនៅពេលយ៉ូសែបបានកើតមក, លោកយ៉ាកុបមានប្រសាសន៍ទៅកាន់ឪពុកក្មេក: "ដោះលែង ខ្ញុំ, ដូច្នេះខ្ញុំនឹងវិលត្រឡប់ទៅស្រុកកំណើតនិងទឹកដីរបស់ខ្ញុំវិញ.
ខ្ញុំបានរៀនដោយបទពិសោធន៍ថាព្រះបានប្រទានពរដល់ខ្ញុំដោយសារអ្នក.
30:29 ប៉ុន្តែគាត់បានឆ្លើយតបវិញ: អ្នកដឹងពីរបៀបដែលខ្ញុំបានបម្រើអ្នក, តើទ្រព្យសម្បត្តិរបស់អ្នកបានជាដៃខ្ញុំដល់កំរិតណាហើយ.
ហើយព្រះអម្ចាស់បានប្រទានពរដល់អ្នកចាប់តាំងពីខ្ញុំមកដល់.
30:32 ធ្វើដំណើរឆ្លងកាត់ហ្វូងសត្វរបស់អ្នកហើយញែកចៀមទាំងអស់ដែលមានរោមឬរោមចៀមប្លែកៗ; ហើយអ្វីដែលនឹងងងឹតឬអាប់សឬប្រែប្រួល, ចៀមជាច្រើនដូចពពែ, នឹងជាប្រាក់ឈ្នួលរបស់ខ្ញុំ.
ហើយអ្វីទាំងអស់ដែលមិនមានភាពច្របូកច្របល់ឬធ្វើឱ្យខូចឬធ្វើឱ្យងងឹត, ចៀមជាច្រើនដូចពពែ, អ្នកទាំងនេះនឹងបង្ហាញថាខ្ញុំជាចោរ” ។
30:35 ហើយនៅថ្ងៃនោះគាត់បានបំបែកពពែឈ្មោល, និងចៀម, និងពពែ, រីឯចៀមឈ្មោលដែលមានរូបរាងប្លែកៗនិងមានស្នាមជាំ.
30:36 ហើយគាត់បានបង្កើតការធ្វើដំណើរចម្ងាយបីថ្ងៃរវាងខ្លួនគាត់និងកូនប្រសាររបស់គាត់, ដែលឃ្វាលហ្វូងចៀមរបស់គាត់ដែលនៅសល់.
ហើយនៅពេលដែលសំបកត្រូវបានទាញចេញ, នៅក្នុងផ្នែកដែលត្រូវបានគេដោះចេញ, មានលេចចេញពណ៌ស, ប៉ុន្តែផ្នែកដែលនៅសល់, នៅតែមានពណ៌បៃតង.
30:38 ហើយគាត់បានដាក់ពួកគេនៅក្នុងវាលស្មៅ, កន្លែងដែលទឹកត្រូវបានបង្ហូរ, ដូច្នេះនៅពេលដែលហ្វូងសត្វបានមកដល់ដើម្បីផឹក, គេនឹងមានមែកនៅមុខភ្នែករបស់គេ, ហើយពួកគេអាចនឹងមានគភ៌.
30:40 លោកយ៉ាកុបចែកហ្វូងចៀម, ហើយគាត់ដាក់មែកឈើនៅតាមចង្អូរនៅចំពោះមុខចៀមឈ្មោល.
30:41 ដូច្នេះ, នៅពេលដែលអ្នកមកដល់ដំបូងគឺកំពុងឡើងលើអេពី, លោកយ៉ាកុបដាក់មែកឈើនៅលើចង្អូរទឹកនៅចំពោះមុខហ្វូងចៀមនិងចៀម, ដើម្បីអោយពួកគេមានគភ៌នៅពេលពួកគេកំពុងសំឡឹងមើលពួកគេ.
ដូច្នេះអ្នកដែលមកដល់យឺតបានក្លាយជារបស់ឡាបាន់, ហើយអ្នកដែលទៅដល់ដំបូងបានទៅជាយ៉ាកុប.
31:2 ដូចគ្នា, គាត់សង្កេតឃើញថាផ្ទៃមុខរបស់ឡាបាន់មិនដូចគាត់ទេកាលពីម្សិលមិញនិងកាលពីថ្ងៃមុន.
31:4 គាត់បានហៅហើយហៅរ៉ាជែលនិងលេអា, នៅទីវាលដែលគាត់ឃ្វាលហ្វូងចៀម,
ប៉ុន្តែព្រះនៃឪពុកខ្ញុំបាននៅជាមួយខ្ញុំ.
31:7 ទោះ អញ្ចឹង ក្ដី, ឪពុករបស់អ្នកបាននាំខ្ញុំអោយវង្វេង, ហើយគាត់បានផ្លាស់ប្តូរប្រាក់ឈ្នួលរបស់ខ្ញុំ ១០ ដង.
31:8 ពេលណាគាត់និយាយ, ប្រាក់ឈ្នួលដែលត្រូវបានចាត់ទុកជាប្រាក់ឈ្នួលរបស់អ្នក,ចៀមទាំងអស់បានផ្តល់កំណើតដល់ទារកទើបនឹងកើត.
31:9 ហើយវាគឺជាព្រះដែលបានយករបស់ឪពុកអ្នកហើយប្រគល់ឱ្យខ្ញុំ.
ត្បិតខ្ញុំបានឃើញអ្វីៗទាំងអស់ដែលឡាបាន់បានធ្វើចំពោះអ្នក.
ឥឡូវនេះក្រោកឡើង, ហើយចាកចេញពីទឹកដីនេះ, ត្រឡប់ទៅស្រុកកំណើតរបស់អ្នកវិញ។ '”
31:15 តើព្រះអង្គមិនបានចាត់ទុកយើងជាជនបរទេសទេឬ?, និងបានលក់ពួកយើង, និងប្រើប្រាស់តម្លៃរបស់យើង?
ដូច្នេះ, ធ្វើអ្វីៗទាំងអស់ដែលព្រះបានណែនាំអ្នក»។
31:18 ហើយគាត់បានយកទ្រព្យសម្បត្តិនិងហ្វូងចៀមរបស់គាត់ទាំងអស់, និងរបស់អ្វីដែលគាត់បានទិញនៅមេសូប៉ូតាមៀ, លោកបានធ្វើដំណើរទៅអ៊ីសាកជាឪពុក, នៅស្រុកកាណាន.
31:20 ហើយយ៉ាកុបមិនព្រមសារភាពប្រាប់ឪពុកក្មេកថាខ្លួនកំពុងរត់គេចទេ.
31:22 មានគេរាយការណ៍មកលោកឡាបាន់នៅថ្ងៃទីបីថាលោកយ៉ាកុបបានរត់គេចខ្លួន.
ហើយគាត់បានដេញតាមគាត់នៅលើភ្នំកាឡាត.
31:25 ហើយឥឡូវនេះយ៉ាកុបបានបោះជំរំនៅលើភ្នំ.
31:26 លោកមានប្រសាសន៍ទៅលោកយ៉ាកុប: ហេតុអ្វីបានជាអ្នកធ្វើដូចនេះ, ចាកចេញពីខ្ញុំដោយសម្ងាត់, ជាមួយកូនស្រីរបស់ខ្ញុំដូចជាឈ្លើយសឹក?
31:28 អ្នកមិនបានអនុញ្ញាតឱ្យខ្ញុំថើបកូនប្រុសស្រីរបស់ខ្ញុំទេ.
ប៉ុន្តែព្រះនៃឪពុករបស់អ្នកបាននិយាយមកខ្ញុំកាលពីម្សិលមិញ, Be សូមប្រយ័ត្នកុំនិយាយអ្វីដែលទាស់នឹងយ៉ាកុប› ។
ប៉ុន្តែហេតុអ្វីបានជាអ្នកលួចព្រះរបស់ខ្ញុំ?”
31:32 ប៉ុន្តែ, ចាប់តាំងពីអ្នកចោទប្រកាន់ខ្ញុំពីការលួច, ជាមួយអ្នកណាអ្នកនឹងឃើញព្រះរបស់អ្នក, ចូរអោយគេសម្លាប់គាត់នៅចំពោះមុខបងប្អូនរបស់យើង.
31:34 នាងបានលាក់រូបព្រះនៅក្រោមគ្រែរបស់អូដ្ឋយ៉ាងឆាប់រហ័ស, ហើយនាងបានអង្គុយលើពួកគេ.
31:35 នាង បាន និយាយ ថា: "កុំ ខឹង, ម្ចាស់របស់ខ្ញុំ, ខ្ញុំមិនអាចក្រោកឈរនៅមុខអ្នកបានឡើយ, ពីព្រោះវាបានកើតឡើងចំពោះខ្ញុំតាមទំនៀមទម្លាប់របស់ស្ត្រី។ ដូច្នេះការស្វែងរកដោយប្រុងប្រយ័ត្នរបស់គាត់ត្រូវបានរារាំង.
ដាក់វានៅទីនេះមុនពេលបងប្អូនរបស់ខ្ញុំ, និងបងប្អូនរបស់អ្នក, ហើយអោយពួកគេវិនិច្ឆ័យរវាងខ្ញុំនិងអ្នក.
កូនចៀមនិងពពែរបស់អ្នកមិនមែនជាស្ត្រីអារទេ; ខ្ញុំមិនបានបរិភោគចៀមឈ្មោលរបស់ចៀមរបស់អ្នកទេ.
ខ្ញុំជំនួសអ្វីៗទាំងអស់ដែលខូច.
អ្នកក៏បានផ្លាស់ប្តូរប្រាក់ឈ្នួលរបស់ខ្ញុំ ១០ ដងដែរ.
ប៉ុន្ដែព្រះជាម្ចាស់ទតមើលមកខ្ញុំដោយរងទុក្ខវេទនានិងការនឿយហត់ដែលខ្ញុំបានធ្វើ, ហើយគាត់បានស្តីបន្ទោសអ្នកកាលពីម្សិលមិញ” ។
តើខ្ញុំអាចធ្វើអ្វីបានចំពោះកូនប្រុសនិងចៅ ៗ របស់ខ្ញុំ?
31:49 «សូមព្រះអម្ចាស់ពិចារណានិងវិនិច្ឆ័យរវាងពួកយើង, នៅពេលដែលយើងនឹងដកខ្លួនចេញពីគ្នា.
ហើយគាត់បានត្រឡប់ទៅកន្លែងរបស់គាត់វិញ.
32:1 ដូចគ្នា, យ៉ាកុបបានបន្ដដំណើរដែលគាត់បានចាប់ផ្តើម.
32:2 នៅពេលដែលគាត់បានឃើញពួកគេ, គាត់ បាន និយាយ ថា, ទាំងនេះគឺជាការតាំងចិត្តរបស់ព្រះជាម្ចាស់។ ហើយគាត់បានដាក់ឈ្មោះកន្លែងនោះថា Mahanaim, នោះគឺ, 'បំផុសគំនិត។ '
32:10 ខ្ញុំគឺទាបជាងអ្វីទាំងអស់នៃការចង្អុលបង្ហាញនិងការពិតរបស់អ្នក, ដែលព្រះអង្គបានបំពេញចំពោះទូលបង្គំជាអ្នកបំរើរបស់ព្រះអង្គ.
ហើយឥឡូវខ្ញុំត្រលប់ទៅក្រុមហ៊ុនពីរវិញ.
32:12 អ្នកបាននិយាយថាអ្នកនឹងធ្វើបានល្អដោយខ្ញុំ, ហើយអ្នកនឹងពង្រីកកូនចៅរបស់ខ្ញុំដូចជាខ្សាច់នៅសមុទ្រ, ដែល, ដោយសារតែចំនួនប្រជាជនរបស់វា, មិនអាចរាប់បានទេ។
32:16 ហើយគាត់បានចាត់ពួកគេដោយដៃរបស់ពួកអ្នកបំរើរបស់គាត់, ហ្វូងនីមួយៗដាច់ដោយឡែកពីគ្នា, ហើយគាត់បាននិយាយទៅកាន់អ្នកបំរើរបស់គាត់: “ ដើរនៅមុខខ្ញុំ, ហើយទុកកន្លែងទំនេររវាងហ្វូងចៀមនិងហ្វូងចៀម។
32:20 ហើយអ្នកនឹងបន្ថែម: លោកយ៉ាកុបជាអ្នកបំរើរបស់លោកក៏បានដើរតាមក្រោយយើងដែរ, សម្រាប់គាត់បាននិយាយថា: “ ខ្ញុំនឹងធ្វើឱ្យគាត់ពេញចិត្តជាមួយនឹងអំណោយដែលត្រូវបានផ្តល់ជូននៅពេលខាងមុខ, ហើយបន្ទាប់ពីនេះ, ខ្ញុំនឹងជួបគាត់; ប្រហែលជាគាត់នឹងប្រណីដល់ខ្ញុំ»។ '"
32:22 ហើយនៅពេលដែលគាត់បានក្រោកឡើងពីព្រលឹម, គាត់បានយកប្រពន្ធពីររបស់គាត់, និងចំនួនស្ដ្រីដូចគ្នា, មានកូនប្រុស ១១ នាក់, លោកបានឆ្លងកាត់កំពង់ផែយ៉ាបុក.
32:25 ហើយនៅពេលដែលឃើញថាគាត់មិនអាចយកឈ្នះគាត់បាន, គាត់បានប៉ះសរសៃប្រសាទនៃភ្លៅរបស់គាត់, ហើយភ្លាមៗនោះក្រៀមស្វិតទៅ.
32:30 លោកយ៉ាកុបបានដាក់ឈ្មោះកន្លែងនោះថា«ផែលែល», និយាយ, “ ខ្ញុំបានឃើញព្រះទល់មុខគ្នា, ហើយព្រលឹងខ្ញុំបានសង្គ្រោះហើយ” ។
តាមពិត, គាត់បានក្រាបនៅលើជើងរបស់គាត់.
គាត់ចែកកូន ៗ របស់លេអានិងរ៉ាជែល, និងទាំងពីរនាក់.
ពិត, លេអានិងកូន ៗ របស់គាត់ស្ថិតក្នុងលំដាប់ទី ២.
33:3 និងជឿនលឿន, គាត់បានក្រាបថ្វាយបង្គំនៅលើដីចំនួនប្រាំពីរដង, រហូតដល់បងប្រុសរបស់គាត់បានមកជិត.
ហើយគូរគាត់ដោយករបស់គាត់ហើយថើបគាត់, គាត់យំ.
ហើយនៅពេលដែលពួកគេបានគោរពបូជាស្រដៀងគ្នា, ចុងក្រោយនៃការទាំងអស់, យ៉ូសែបនិងរ៉ាជែលគោរព.
ប៉ុន្តែប្រសិនបើខ្ញុំពេញចិត្តនឹងអ្នក, សូមទទួលអំណោយតូចមួយពីដៃខ្ញុំ.
សូមមេត្តាប្រណីដល់ខ្ញុំ,
ប្រសិនបើខ្ញុំបណ្តាលឱ្យទាំងនេះឈឺពោះច្រើនពេកក្នុងការដើរ, ចៀមទាំងអស់នឹងត្រូវស្លាប់នៅថ្ងៃតែមួយ.
ហើយខ្ញុំនឹងដើរតាមជំហានរបស់គាត់បន្តិចម្តង ៗ, ដូចខ្ញុំឃើញកូនតូចរបស់ខ្ញុំអាចធ្វើបាន, រហូតដល់ខ្ញុំមកដល់ម្ចាស់របស់ខ្ញុំនៅសៀរ” ។
33:17 ហើយលោកយ៉ាកុបបានធ្វើដំណើរទៅស៊ូកូត, កន្លែងណា, ដោយបានសង់ផ្ទះមួយនិងបោះជំរំតង់, គាត់បានដាក់ឈ្មោះកន្លែងនោះថាស៊ូកូត, នោះគឺ, T តង់› ។
ហើយគាត់រស់នៅក្បែរទីក្រុង.
33:20 និងការដំឡើងអាសនៈនៅទីនោះ, គាត់បានអំពាវនាវដល់ព្រះដ៏រឹងមាំបំផុតនៃអ៊ីស្រាអែល.
ដូច្នេះគាត់ក៏ចាប់នាងហើយដេកជាមួយនាង, លើសលប់ព្រហ្មចារីដោយកម្លាំង.
ហើយបាន hearing អ្វីដែលបានកើតឡើង, ពួកគេខឹងខ្លាំងណាស់, ព្រោះគាត់បានធ្វើរឿងដ៏កខ្វក់នៅស្រុកអ៊ីស្រាអែលនិង, រំលោភកូនស្រីរបស់យ៉ាកុប, បានប្រព្រឹត្តអំពើខុសច្បាប់.
ឱ្យនាងទៅគាត់ជាប្រពន្ធ.
ផ្តល់ឱ្យកូនស្រីរបស់អ្នក, និងទទួលបានកូនស្រីរបស់យើង.
ដីស្ថិតនៅក្នុងអំណាចរបស់អ្នក: ដាំដុះ, ពាណិជ្ជកម្ម, ហើយកាន់កាប់វា” ។
34:12 បង្កើនថ្លៃបណ្ណាការ, និងស្នើសុំអំណោយ, ហើយខ្ញុំនឹងផ្តល់អ្វីដែលអ្នកនឹងសួរដោយសេរី.
34:13 កូន ៗ របស់លោកយ៉ាកុបឆ្លើយនឹងស៊ីគែមនិងឪពុករបស់គាត់ដោយបោកបញ្ឆោត, ខឹងនឹងការចាប់រំលោភប្អូនស្រីរបស់ពួកគេ:
សម្រាប់ យើង, នេះគឺខុសច្បាប់និងគួរស្អប់ខ្ពើម.
34:16 បន្ទាប់មកយើងនឹងផ្តល់ឱ្យនិងទទួលបានកូនស្រីរបស់អ្នកក៏ដូចជាកូនស្រីរបស់យើងផងដែរ; ហើយយើងនឹងរស់នៅជាមួយអ្នក, ហើយយើងនឹងក្លាយជាមនុស្សតែមួយ.
34:18 សំណើរបស់ពួកគេពេញចិត្ដនឹងលោកហាម៉ោរនិងកូនប្រុសរបស់គាត់គឺស៊ីគែម.
ព្រោះគាត់ស្រឡាញ់ក្មេងស្រីខ្លាំងណាស់, ហើយគាត់ត្រូវបានគេស្គាល់ទូទាំងផ្ទះរបស់ឪពុកគាត់.
យើងនឹងទទួលបានកូនស្រីរបស់ពួកគេជាប្រពន្ធ, ហើយយើងនឹងផ្តល់ឱ្យពួកគេនូវរបស់យើង.
34:23 និងសារធាតុរបស់ពួកគេ, និងគោ, និងរបស់ទាំងអស់ដែលពួកគេមាន, នឹងក្លាយជារបស់យើង, ប្រសិនបើមានតែយើងទេយើងអាចទទួលយកបាន, ហើយ ដូច្នេះ, ក្នុងការរស់នៅជាមួយគ្នា, នឹងបង្កើតបានជាមនុស្សម្នាក់” ។
34:25 ហើយមើលចុះ, នៅថ្ងៃទីបី, នៅពេលការឈឺចាប់នៃមុខរបួសធំបំផុត, កូនប្រុសពីរនាក់របស់លោកយ៉ាកុប, ស៊ីម្មាននិងលេវី, បងប្អូនរបស់ឌីណា, ដាវបានចូលទៅក្នុងទីក្រុងដោយដាវយ៉ាងក្លាហាន.
34:26 ពួកគេបានសម្លាប់ហាម៉ោរនិងស៊ីគែមជាមួយគ្នា, យកប្អូនស្រីរបស់នាងឌីណាចេញពីផ្ទះនៅស៊ីគែម.
34:28 យកចៀមរបស់ពួកគេ, និងហ្វូង, និងសត្វលា, ហើយចាក់សំរាមអ្វីៗផ្សេងទៀតដែលមាននៅក្នុងផ្ទះនិងនៅចំការរបស់គេ,
34:30 នៅពេលដែលពួកគេបានបំពេញសកម្មភាពទាំងនេះយ៉ាងអង់អាច, លោកយ៉ាកុបមានប្រសាសន៍ទៅកាន់ស៊ីម្មាននិងលេវី: អ្នកបានធ្វើអោយខ្ញុំមានកង្វល់, អ្នកបានធ្វើអោយខ្ញុំស្អប់ជនជាតិកាណាននិងជនជាតិពេរិស៊ីត, ប្រជាជននៅលើទឹកដីនេះ.
ពួកគេ, ប្រមូលផ្តុំគ្នា, អាចវាយខ្ញុំចុះ, បន្ទាប់មកខ្ញុំនិងផ្ទះរបស់ខ្ញុំនឹងត្រូវបំផ្លាញចោល។
35:4 ដូច្នេះ, ពួកគេបានថ្វាយព្រះដទៃទាំងអស់ដែលពួកគេមាន, ក្រវិលដែលស្ថិតនៅត្រចៀករបស់ពួកគេ.
35:5 ហើយនៅពេលដែលពួកគេបានចាកចេញ, ការភ័យខ្លាចរបស់ព្រះជាម្ចាស់បានឡោមព័ទ្ធទីក្រុងជុំវិញទាំងអស់, ពួកគេមិនហ៊ានដេញតាមពួកគេទេនៅពេលដែលពួកគេចាកចេញទៅ.
35:7 ហើយគាត់បានសង់អាសនៈមួយនៅទីនោះ, ហើយគាត់បានដាក់ឈ្មោះកន្លែងនោះ, House ដំណាក់របស់ព្រះ› ។ ដ្បិតនៅទីនោះព្រះបានលេចមកឯគាត់ពេលគាត់រត់គេចពីបងប្អូនរបស់គាត់.
ហើយឈ្មោះនៃកន្លែងនោះត្រូវបានគេហៅថា, O អូកនៃការយំ› ។
35:10 និយាយ: គេនឹងលែងហៅអ្នកថាយ៉ាកុបទៀតហើយ, ឈ្មោះរបស់អ្នកនឹងត្រូវបានអ៊ីស្រាអែល។ ហើយគាត់ហៅគាត់ថាអ៊ីស្រាអែល,
ហើយនៅទីនោះ, នៅពេលដែលរ៉ាជែលកំពុងតែសំរាលកូន,
នៅឡើយទេ, ឪពុករបស់គាត់បានហៅគាត់ថាបេនយ៉ាមីន, នោះគឺ, កូនប្រុសរបស់ដៃស្តាំ.
35:20 លោកយ៉ាកុបបានសង់ស្តូបមួយនៅពីលើផ្នូររបស់នាង.
35:21 ចាកចេញពីទីនោះ, គាត់បោះតង់របស់គាត់នៅខាងនាយប៉មហ្វុប.
កូនប្រុសៗរបស់លោកយ៉ាកុបមានចំនួនដប់ពីរនាក់.
35:27 ហើយបន្ទាប់មកគាត់បានទៅអ៊ីសាកឪពុករបស់គាត់នៅម៉មរ៉េម, ទីក្រុងអាបា: កន្លែងនេះគឺហេប្រុន, ជាកន្លែងដែលអ័ប្រាហាំនិងអ៊ីសាកស្នាក់នៅ.
និងកូនប្រុសរបស់គាត់, អេសាវនិងយ៉ាកុប, កប់គាត់.
ទាំងនេះជាកូនរបស់អេសាវ, ព្រះអង្គបានប្រសូតមកនៅក្នុងទឹកដីកាណាន.
36:7 ព្រោះពួកគេមានទ្រព្យស្តុកស្តម្ភណាស់ហើយមិនអាចរស់នៅជាមួយគ្នាបានទេ.
ទាំងនេះជាកូនរបស់អាដា, ភរិយារបស់អេសាវ.
ទាំងនេះជាកូន ៗ របស់លោកបាសិត, ភរិយារបស់អេសាវ.
ទាំងនេះជាកូនរបស់អេលីផា, នៅស្រុកអេដុម, កូនទាំងនេះរបស់អាដា.
ហើយអ្នកទាំងនេះជាមេដឹកនាំរបស់រេហូ, នៅស្រុកអេដុម.
36:18 ឥឡូវនេះជាកូនប្រុសរបស់អូហូលីម៉ា, ភរិយារបស់អេសាវ: មេដឹកនាំជេស៊ូ, មេដឹកនាំចាឡាំ, មេដឹកនាំកូរេ.
នេះគឺជាអាណាដែលបានរកឃើញប្រភពទឹកក្តៅនៅទីរហោស្ថាន, នៅពេលគាត់ឃ្វាលសត្វលារបស់ឪពុកគាត់គឺហ្សីប៊ីន.
36:31 ឥឡូវនេះមុនពេលកូនចៅអ៊ីស្រាអែលមានស្តេច, ស្តេចដែលគ្រប់គ្រងស្រុកអេដុមគឺជាស្តេចទាំងនេះ:
36:35 ដូចគ្នា, ម្នាក់នេះបានស្លាប់, ព្រះបាទហាដាដជាបុត្ររបស់ព្រះបាទបាដាប់ឡើងស្នងរាជ្យ.
36:40 ដូច្នេះ, ទាំងនេះជាឈ្មោះរបស់មេដឹកនាំអេសាវ, ដោយក្រុមគ្រួសាររបស់ពួកគេ, និងកន្លែង, និងនៅក្នុងវាក្យសព្ទរបស់ពួកគេ: មេដឹកនាំទីមណា, មេដឹកនាំអាល់វ៉ា, មេដឹកនាំជេហេត,
អ្នកទាំងនោះជាមេដឹកនាំរបស់ជន ជាតិអេដុមដែលរស់នៅលើទឹកដីរបស់ពួកគេ: នេះគឺជាអេសាវ, ឪពុករបស់អ៊ីឌមេម៉ា.
37:1 ឥឡូវនេះលោកយ៉ាកុបរស់នៅក្នុងស្រុកកាណាន, ជាកន្លែងដែលឪពុករបស់គាត់បានស្នាក់នៅ.
យ៉ូសែប, ពេលគាត់មានអាយុ ១៦ ឆ្នាំ, កំពុងឃ្វាលហ្វូងចៀមជាមួយបងប្អូនរបស់គាត់, ពេលគាត់នៅក្មេង.
ហើយគាត់បានចោទប្រកាន់បងប្អូនរបស់គាត់ទៅឪពុករបស់ពួកគេពីបទឧក្រិដ្ឋដែលមានបាបបំផុត.
37:5 បន្ទាប់មកវាក៏បានកើតឡើងផងដែរដែលគាត់បានរៀបរាប់ពីចក្ខុវិស័យនៃសុបិនដល់បងប្អូនរបស់គាត់, សម្រាប់ហេតុផលដែលការស្អប់កាន់តែច្រើនត្រូវបានចិញ្ចឹមបីបាច់.
37:7 ខ្ញុំគិតថាយើងកំពុងត្បាញនៅវាលស្រែ.
37:9 ដូចគ្នា, គាត់បានឃើញសុបិនមួយទៀត, ដែលគាត់បានពន្យល់ដល់បងប្អូនរបស់គាត់, និយាយ, “ ខ្ញុំបានឃើញសុបិនមួយ, ដូចជាប្រសិនបើព្រះអាទិត្យ, និងព្រះច័ន្ទ, ហើយមានផ្កាយដប់មួយបានបង្ហាញការគោរពចំពោះខ្ញុំ។
តើខ្ញុំគួរ, និងម្តាយរបស់អ្នក, និងបងប្អូនរបស់អ្នកគោរពអ្នកនៅលើផែនដី?”
នៅឡើយទេ, ឪពុករបស់គាត់បានពិចារណារឿងនេះដោយស្ងៀមស្ងាត់.
37:13 លោកអ៊ីស្រាអែលមានប្រសាសន៍ទៅកាន់គាត់: បងប្អូនរបស់អ្នករាល់គ្នាកំពុងតែឃ្វាលចៀមនៅស៊ីគែម.
37:14 "ខ្ញុំ រួចរាល់ ហើយ,គាត់ឆ្លើយទៅគាត់វិញ, “ ទៅ, ហើយមើលថាតើអ្វីៗទាំងអស់កំពុងរីកចម្រើនជាមួយបងប្អូននិងគោក្របីរបស់អ្នកដែរឬទេ, ហើយរាយការណ៍មកខ្ញុំនូវអ្វីដែលកំពុងកើតឡើង។ ដូច្នេះ, ត្រូវគេបញ្ជូនពីជ្រលងភ្នំហេប្រុន, គាត់បានទៅដល់ស៊ីគែម.
37:18 និង, ពួកគេបានឃើញលោកពីចម្ងាយ, មុនពេលដែលគាត់ទៅជិតពួកគេ, ពួកគេបានសំរេចចិត្តសំលាប់គាត់.
តែបោះគាត់ចូលក្នុងអណ្តូងនេះ, ដែលនៅទីរហោស្ថាន, ដូច្នេះត្រូវរក្សាដៃរបស់អ្នកដោយគ្មានគ្រោះថ្នាក់»។ ប៉ុន្តែគាត់បាននិយាយបែបនេះ, ចង់ជួយសង្គ្រោះគាត់ពីដៃរបស់ពួកគេ, ដូច្នេះគាត់នឹងវិលត្រឡប់ទៅឪពុករបស់គាត់វិញ.
37:26 ដូច្នេះ, លោកយូដានិយាយទៅកាន់បងប្អូនរបស់គាត់: តើវាផ្តល់ផលចំណេញអ្វីដល់យើង, បើយើងសម្លាប់បងប្អូនយើងហើយលាក់ឈាមរបស់គាត់?
ដ្បិតគាត់ជាបងប្អូនប្រុសស្រីរបស់យើងហើយ” ។ បងប្អូនរបស់គាត់បានយល់ព្រមនឹងពាក្យរបស់គាត់.
ពួកគេបាននាំគាត់ទៅស្រុកអេស៊ីប.
37:31 បន្ទាប់មកពួកគេបានដោះអាវរបស់គាត់, ហើយពួកគេបានជ្រលក់វានៅក្នុងឈាមពពែវ័យក្មេង, ដែលពួកគេបានសម្លាប់,
មើលថាតើវាជាអាវរបស់កូនប្រុសអ្នកឬអត់។
37:35 បន្ទាប់មក, នៅពេលកូនប្រុសទាំងអស់របស់គាត់បានជួបជុំគ្នាដើម្បីបន្ធូរបន្ថយភាពទុក្ខព្រួយរបស់ឪពុក, គាត់មិនមានឆន្ទៈក្នុងការទទួលយកការលួងលោមទេ, ប៉ុន្តែគាត់បាននិយាយ: “ ខ្ញុំនឹងចុះមកកាន់មរណទុក្ខកូនប្រុសរបស់ខ្ញុំនៅឯផ្នូរ” ។ ហើយខណៈពេលដែលគាត់ព្យាយាមតស៊ូយំ,
38:5 ដូចគ្នា, នាងសំរាលកូនទីបី, ដែលនាងហៅថាសាឡា, បន្ទាប់ពីកំណើតរបស់គាត់, នាងឈប់មានទៀតហើយ.
38:7 ហើយវាក៏បានកើតឡើងផងដែរដែលអេ, កូនច្បងរបស់ជនជាតិយូដា, មនុស្សអាក្រក់នៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់ហើយត្រូវគេសម្លាប់.
38:9 គាត់, ដោយដឹងថាកូនប្រុសដែលនឹងកើតមកមិនមែនជាកូនរបស់គាត់ទេ, នៅពេលដែលគាត់បានចូលទៅប្រពន្ធរបស់បងប្រុសរបស់គាត់, គាត់បានសាបព្រោះគ្រាប់ពូជនៅលើដី, ក្រែងកូន ៗ កើតមកក្នុងនាមជាបងប្រុសរបស់គាត់.
38:11 ដោយសារតែបញ្ហានេះ, យូដានិយាយទៅកាន់កូនប្រសាររបស់គាត់ថាតាម៉ារ, “ ធ្វើជាស្ត្រីមេម៉ាយនៅក្នុងផ្ទះឪពុករបស់អ្នក, រហូតដល់កូនប្រុសខ្ញុំឈ្មោះលឡាធំឡើង” ។ ព្រោះគាត់ខ្លាច, ក្រែងលោកអាចនឹងត្រូវស្លាប់, ដូចបងប្អូនរបស់គាត់ដែរ.
38:13 មានគេរាយការណ៍មកនាងតាម៉ារថាឪពុកក្មេករបស់នាងបានឡើងទៅធីមណាដើម្បីកាត់ចៀម.
និងផ្លាស់ប្តូរសម្លៀកបំពាក់របស់នាង, នាងអង្គុយនៅផ្លូវបំបែកដែលនាំទៅដល់ធីមណា, ពីព្រោះសេឡាបានធំឡើង, ហើយនាងមិនបានទទួលគាត់ជាប្តីទេ.
សម្រាប់នាងបានគ្របមុខរបស់នាង, ក្រែងលោនាងត្រូវគេស្គាល់.
ហើយនាងបានឆ្លើយតប, តើអ្នកនឹងអោយអ្វីដល់ខ្ញុំ, រីករាយនឹងខ្ញុំជាប្រពន្ធចុង?”
38:18 យូដានិយាយ, តើអ្នកចង់បានអ្វីសម្រាប់ការសន្យា?នាងបានឆ្លើយតប, “ ចិញ្ចៀននិងខ្សែដៃរបស់អ្នក, និងបុគ្គលិកដែលអ្នកកាន់នៅក្នុងដៃរបស់អ្នក។ អញ្ចឹង, ស្ត្រី, ពីការរួមភេទតែមួយ, មានផ្ទៃពោះ.
រួចទុកសម្លៀកបំពាក់ដែលនាងបានយកទៅទុក, នាងស្លៀកពាក់ជាស្ត្រីមេម៉ាយ.
?ហើយពួកគេទាំងអស់បានឆ្លើយតប, នៅទីនេះគ្មានស្រីពេស្យាទេ” ។
លើសពីនេះទៅទៀត, បុរសនៅកន្លែងនោះប្រាប់ខ្ញុំថាស្រីពេស្យាមិនដែលអង្គុយនៅទីនោះទេ។
ពិតប្រាកដណាស់, នាងមិនអាចចោទប្រកាន់យើងពីការកុហកទេ.
38:24 ហើយមើលចុះ, បន្ទាប់ពីបីខែ, ពួកគេបានរាយការណ៍ប្រាប់ពួកយូដា, និយាយ, “ តាម៉ារ, កូនប្រសាររបស់អ្នក, បានប្រព្រឹត្ដអំពើប្រាសចាកសីលធម៌ខាងផ្លូវភេទហើយពោះរបស់នាងមើលទៅដូចជារីកចំរើនឡើង។ លោកយូដាមានប្រសាសន៍, “ ផលិតនាង, ដូច្នេះនាងនឹងត្រូវគេដុតចោល។
ត្បិតខ្ញុំមិនបានយកនាងទៅ ឲ្យ សេឡាជាកូនប្រុសខ្ញុំទេ»។ ទោះយ៉ាងណាក៏ដោយ, គាត់មិនស្គាល់នាងទៀតទេ.
38:30 បន្ទាប់ពី នេះ, ប្អូនប្រុសរបស់គាត់បានចេញមក, នៅលើដៃដែលជាខ្សែស្រឡាយពណ៌ក្រហម.
និងពុទ្ធពៅ, អាមាដរបស់ស្តេចផារ៉ោន, មេដឹកនាំកងទ័ព, បុរសអេហ្ស៊ីប, បានទិញគាត់ពីដៃរបស់ពួកអ៊ីស្មាអែល, គាត់ត្រូវគេនាំទៅ.
39:5 ព្រះអម្ចាស់ប្រទានពរដល់ជនជាតិអេស៊ីប, ដោយសារតែយ៉ូសែប, ហើយគាត់បានទ្រព្យសម្បត្តិទាំងអស់របស់គាត់, ដូចជាច្រើននៅក្នុងអគារ, ដូចក្នុងចម្ការ.
ឥឡូវនេះយ៉ូសែបគឺស្រស់ស្អាតនៅក្នុងសំណុំបែបបទ, និងស្រស់ស្អាតនៅក្នុងរូបរាង.
39:8 ហើយដោយមិនយល់ព្រមទាល់តែសោះចំពោះអំពើអាក្រក់, ព្រះអង្គមានព្រះបន្ទូលទៅនាង: «មើលចុះ, លោកម្ចាស់បានប្រគល់អ្វីៗទាំងអស់អោយខ្ញុំ, ហើយគាត់មិនដឹងថាគាត់មានអ្វីនៅក្នុងផ្ទះរបស់គាត់ទេ.
តើធ្វើដូចម្តេចអោយខ្ញុំប្រព្រឹត្ដអំពើអាក្រក់និងអំពើបាបចំពោះព្រះរបស់ខ្ញុំ?
39:10 ជាមួយនឹងពាក្យបែបនេះ, ពេញមួយថ្ងៃ, ស្ត្រីនោះកំពុងតែស្រែកថ្ងូរចំពោះបុរសវ័យក្មេងនេះ, ហើយគាត់បានបដិសេធមិនផិតក្បត់.
39:19 ម្ចាស់របស់គាត់, ពេលបាន hearing សេចក្តីទាំងនេះ, និងមានការជឿទុកចិត្តខ្លាំងពេកលើសំដីរបស់គូគាត់, ខឹងខ្លាំងណាស់.
39:21 ប៉ុន្តែព្រះអម្ចាស់គង់នៅជាមួយយ៉ូសែប, និង, មានមេត្តាករុណាលើគាត់, គាត់បានអោយគាត់ទៅគាល់មើលមេដឹកនាំពន្ធនាគារ,
និងអ្វីដែលត្រូវបានធ្វើ, គឺនៅក្រោមគាត់.
ដ្បិតព្រះអម្ចាស់គង់នៅជាមួយគាត់, ហើយគាត់បានដឹកនាំអ្វីៗទាំងអស់ដែលគាត់បានធ្វើ.
40:1 ខណៈពេលដែលរឿងទាំងនេះបានកើតឡើង, វាបានកើតឡើងដែលថាអាមាដពីរ, ម្ចាស់ពែងរបស់ស្តេចស្រុកអេស៊ីប, និងរោងម៉ាស៊ីនកិនស្រូវ, អាក់អន់ចិត្តម្ចាស់របស់ពួកគេ.
40:3 បានបញ្ជូនពួកគេទៅពន្ធនាគាររបស់មេដឹកនាំយោធា, លោកយ៉ូសែបក៏ជាប់ឃុំឃាំង.
ពេលវេលាតិចតួចបានកន្លងផុតទៅ, ខណៈពេលដែលពួកគេត្រូវបានឃុំឃាំង.
40:8 ពួកគេបានឆ្លើយតប, យើងបានឃើញសុបិនមួយ, ហើយគ្មានអ្នកណាអាចបកស្រាយបានសម្រាប់យើងឡើយ។ លោកយ៉ូសែបមានប្រសាសន៍ទៅពួកគេ, “ ការបកស្រាយមិនមែនជារបស់ព្រះទេ?
40:10 នៅលើដែលមានបីពន្លក, ដែលដុះលូតលាស់បន្តិចម្តង ៗ ទៅជាពន្លក, និង, បន្ទាប់ពីផ្កា, វាធំធាត់ទៅជាទំពាំងបាយជូរ.
ដូច្នេះ, ខ្ញុំបានយកទំពាំងបាយជូរ, ខ្ញុំបានយកពែងទាំងនោះទៅក្នុងពែងដែលខ្ញុំកាន់, ខ្ញុំក៏ចែកពែងទៅជូនផារ៉ោន»។
ពន្លកទាំងបីគឺជាបីថ្ងៃបន្ទាប់,
ហើយអ្នកនឹងឱ្យពែងដល់គាត់យោងទៅតាមការិយាល័យរបស់អ្នក, ដូចដែលអ្នកធ្លាប់មានទម្លាប់ធ្វើពីមុន.
40:17 ហើយក្នុងមួយកន្ត្រក, ដែលខ្ពស់បំផុត, ខ្ញុំបានយកអាហារទាំងអស់ដែលផលិតដោយសិល្បៈនៃការដុតនំ, ហើយសត្វស្លាបបានស៊ីវា។
40:20 ថ្ងៃទីបីបន្ទាប់មកទៀតជាថ្ងៃកំណើតរបស់ព្រះចៅផារ៉ោន.
40:23 ហើយទោះបីជាគាត់ជឿនលឿនជាមួយនឹងភាពរុងរឿងច្រើនក៏ដោយ, នាយទាហានកាន់ពែងភ្លេចអ្នកបកប្រែសុបិន្តរបស់គាត់.
41:2 ពីនោះឡើងគោប្រាំពីរ, ពិតជាស្អាតនិងពូកែ.
41:3 ដូចគ្នា, ៧ នាក់ទៀតចេញពីទន្លេ, កខ្វក់និងបញ្ចេញពន្លឺយ៉ាងហ្មត់ចត់.
41:4 ហើយពួកគេបានលេបត្របាក់អ្នកដែលមានរូបរាងនិងស្ថានភាពរាងកាយអស្ចារ្យ.
41:10 ស្តេច, ខឹងនឹងអ្នកបំរើរបស់គាត់, បានបញ្ជាឱ្យខ្ញុំនិងប្រធានរោងម៉ាស៊ីនកិនស្រូវត្រូវ បង្ខំឲ្យ ចូលគុកមេដឹកនាំយោធា.
41:12 នៅកន្លែងនោះ, មានភាសាហេព្រើរ, អ្នកបំរើនៃមេបញ្ជាការយោធាដូចគ្នា, ដល់អ្នកណាដែលយើងបានពន្យល់ក្តីសុបិន្តរបស់យើង.
សម្រាប់ខ្ញុំត្រូវបានគេយកទៅការិយាល័យរបស់ខ្ញុំវិញ, ហើយគាត់ត្រូវបានគេព្យួរនៅលើឈើឆ្កាង។
ខ្ញុំបាន heard ថាអ្នកពិតជាឆ្លាតណាស់ក្នុងការបកប្រែភាសាទាំងនេះ។
41:17 ដូច្នេះ, ផារ៉ោនបានពន្យល់ពីអ្វីដែលគាត់បានឃើញ: “ ខ្ញុំគិតថាខ្លួនឯងកំពុងឈរនៅមាត់ទន្លេ,
ប៉ុន្តែពួកគេនៅតែស្ថិតក្នុងស្ថានភាពដដែលនៃភាពរំជើបរំជួលនិងក្រអឺតក្រទម.
ខ្ញុំបានពន្យល់សុបិននេះដល់អ្នកបកប្រែ, ហើយគ្មានអ្នកណាអាចបើកវាបានទេ។
អ្វីដែលព្រះនឹងធ្វើ, ព្រះអង្គបានបង្ហាញអោយផារ៉ោនស្គាល់.
ដូច្នេះកម្លាំងនៃក្តីសុបិន្តត្រូវបានគេយល់ថាដូចគ្នា.
41:30 បន្ទាប់ពី នេះ, វានឹងមានរយៈពេល ៧ ឆ្នាំទៀត, នៃភាពគ្មានកូនដ៏អស្ចារ្យដែលអតីតភាពបរិបូរណ៍ទាំងអស់នឹងត្រូវគេបញ្ជូនទៅក្នុងភាពខ្វះចន្លោះ.
41:31 ហើយភាពខ្ពង់ខ្ពស់នៃភាពទុច្ចរិតនេះនឹងធ្វើឱ្យបាត់បង់ភាពសម្បូរបែប.
41:34 ដូច្នេះគាត់តែងតាំងអ្នកត្រួតពិនិត្យនៅគ្រប់តំបន់ទាំងអស់.
41:35 ដែលឥឡូវនេះបានចាប់ផ្តើមកើតឡើងរួចទៅហើយ, ត្រូវបានប្រមូលចូលទៅក្នុងឃ្លាំង.
41:36 ហើយទុកឱ្យវាត្រូវបានរៀបចំសម្រាប់ភាពអត់ឃ្លាននាពេលអនាគតនៃប្រាំពីរឆ្នាំ, ដែលនឹងគាបសង្កត់អេស៊ីប, ហើយដីនឹងមិនត្រូវបានបំផ្លាញដោយទុរ្ភិក្សទេ។
41:40 អ្នកនឹងនៅលើផ្ទះរបស់ខ្ញុំ, និងអំណាចនៃមាត់របស់អ្នក, ប្រជាជនទាំងអស់នឹងបង្ហាញការគោរពប្រតិបត្តិ.
41:41 ហើយម្តងទៀត, ព្រះចៅផារ៉ោនមានរាជឱង្ការទៅកាន់លោកយ៉ូសែប, «មើលចុះ, យើងបានតែងតាំងអ្នកអោយគ្រប់គ្រងស្រុកអេស៊ីបទាំងមូល»។
41:44 ដូចគ្នា, ព្រះរាជាមានរាជឱង្ការទៅកាន់លោកយ៉ូសែប: “ ខ្ញុំជាផារ៉ោន: ក្រៅពីសិទ្ធិអំណាចរបស់អ្នក, ក្នុងស្រុកអេស៊ីបគ្មាននរណាម្នាក់អាចលើកដៃឬជើងបានឡើយ។
លោកយ៉ូសែបក៏ចេញទៅស្រុកអេស៊ីប.
41:47 ហើយការមានកូនរបស់ប្រាំពីរឆ្នាំបានមកដល់.
41:48 ហើយឥឡូវនេះស្រូវបរិបូណ៌ទាំងអស់ត្រូវបានទុកនៅគ្រប់ទីក្រុងទាំងអស់.
41:52 ដូចគ្នា, គាត់ដាក់ឈ្មោះអេប្រាអ៊ីមទីពីរ, និយាយ, ព្រះបាន បណ្ដាលឲ្យ ខ្ញុំរីកចម្រើននៅលើទឹកដីនៃភាពក្រីក្ររបស់ខ្ញុំ។
41:54 ទុរ្ភិក្សប្រាំពីរឆ្នាំ, ដែលយ៉ូសែបបានទស្សន៍ទាយ, បានចាប់ផ្តើមមកដល់.
41:55 ហើយកំពុងឃ្លាន, ប្រជាជននាំគ្នាស្រែកទូលព្រះចៅផារ៉ោន, ស្នើសុំសំវិធានការ.
និងធ្វើអ្វីដែលគាត់នឹងប្រាប់អ្នក” ។
ហើយយ៉ូសែបបានបើកឃ្លាំងទាំងអស់ហើយបានលក់ទៅឱ្យជនជាតិអេស៊ីប.
41:57 ហើយគ្រប់ខេត្តទាំងអស់បានទៅដល់ស្រុកអេស៊ីប, ដើម្បីទិញម្ហូបអាហារនិងបន្ទាបបន្ថោកនូវសំណាងអាក្រក់របស់ពួកគេ.
42:1 បន្ទាប់មកយ៉ាកុប, hearingគេនិយាយថាស្បៀងអាហារត្រូវគេលក់នៅស្រុកអេស៊ីប, បាននិយាយទៅកាន់កូនប្រុសរបស់គាត់: ហេតុអ្វីបានជាអ្នកធ្វេសប្រហែស?
ទៅចុះហើយទិញរបស់ចាំបាច់សម្រាប់យើង, ដូច្នេះយើងអាចរស់នៅបាន, ហើយមិនត្រូវបំផ្លាញដោយទុរ្ភិក្សឡើយ។
42:4 បេនយ៉ាមីនត្រូវបានរក្សាទុកនៅផ្ទះដោយយ៉ាកុប, ដែលបាននិយាយទៅកាន់បងប្អូនរបស់គាត់, “ ក្រែងលោគាត់ប្រហែលជារងគ្រោះថ្នាក់នៅពេលធ្វើដំណើរ” ។
ដ្បិតទុរ្ភិក្សកើតមាននៅក្នុងស្រុកកាណាន.
42:8 ហើយទោះបីជាគាត់ស្គាល់បងប្អូនរបស់គាត់ក៏ដោយ, ពួកគេមិនស្គាល់គាត់ទេ.
អ្នកមកដើម្បីមើលថាតើផ្នែកណានៃដីខ្សោយជាងនេះ។
ប៉ុន្តែអ្នកបំរើរបស់ព្រះអង្គបានមកដល់ដើម្បីទិញអាហារ.
អ្នកបានមកពិនិត្យមើលផ្នែកដែលមិនមានការគាំទ្រពីទឹកដីនេះ។
កូនពៅនៅជាមួយឪពុករបស់យើង; ម្នាក់ទៀតមិនរស់ទេ។
អ្នកគឺជាអ្នកកាយរិទ្ធ.
ដោយសុខភាពផារ៉ូ, អ្នកនឹងមិនចាកចេញពីទីនេះទេ, រហូតដល់ប្អូនពៅរបស់អ្នកមកដល់.
ប៉ុន្តែអ្នកនឹងជាប់ច្រវាក់, រហូតដល់អ្វីដែលអ្នកបាននិយាយត្រូវបានបង្ហាញថាជាការពិតឬមិនពិត.
42:17 ដូច្នេះ, លោកបានបញ្ជូនពួកគេទៅឃុំឃាំងអស់រយៈពេលបីថ្ងៃ.
បន្ទាប់មកអ្នកអាចចាកចេញទៅហើយយកស្រូវដែលអ្នកបានទិញមកផ្ទះរបស់អ្នក.
42:21 ហើយពួកគេនិយាយគ្នា: យើងសមនឹងទទួលរងនូវរឿងទាំងនេះ, ព្រោះយើងបានធ្វើបាបនឹងបងប្អូនយើង, ឃើញទុក្ខព្រួយនៃព្រលឹងគាត់, នៅពេលដែលគាត់បានអង្វរយើងហើយយើងនឹងមិនស្តាប់.
42:23 ប៉ុន្តែពួកគេមិនដឹងថាយ៉ូសែបបានយល់ទេ, ពីព្រោះគាត់កំពុងនិយាយជាមួយពួកគេតាមរយៈអ្នកបកប្រែផ្ទាល់មាត់.
ហើយត្រឡប់មកវិញ, គាត់បាននិយាយជាមួយពួកគេ.
42:27 ហើយម្នាក់ក្នុងចំណោមពួកគេ, បើកបាវមួយដើម្បីផ្តល់សត្វចិញ្ចឹមបន្ទុកនៅឯផ្ទះសំណាក់, ក្រឡេកមើលប្រាក់នៅមាត់បាវ,
42:29 ហើយពួកគេបានទៅជួបយ៉ាកុបជាឪពុកនៅស្រុកកាណាន, ពួកគេបានពន្យល់ប្រាប់លោកអំពីហេតុការណ៍ទាំងប៉ុន្មានដែលកើតមានដល់ពួកគេ, និយាយ:
ម្នាក់មិនរស់នៅ; កូនពៅនៅជាមួយឪពុកយើងនៅស្រុកកាណាន។
ដោះលែងបងប្អូនម្នាក់អោយខ្ញុំ, និងយកសំភារៈចាំបាច់សំរាប់គេហដ្ឋានរបស់អ្នក, ហើយទៅឆ្ងាយ,
ហើយមួយនេះ, ដែលត្រូវបានគេដាក់នៅក្នុងច្រវាក់, អ្នកប្រហែលជាអាចទទួលម្តងទៀត.
42:35 ដោយបាននិយាយបែបនេះ, នៅពេលដែលពួកគេចាក់គ្រាប់របស់ពួកគេ, ម្នាក់ៗបានឃើញប្រាក់របស់គាត់ជាប់នឹងបាវរបស់គាត់.
42:36 ឪពុករបស់ពួកគេឈ្មោះយ៉ាកុបបាននិយាយ, អ្នកធ្វើឱ្យខ្ញុំគ្មានកូន.
អំពើអាក្រក់ទាំងអស់នេះបានធ្លាក់មកលើខ្ញុំហើយ។
ប្រគល់គាត់ទៅក្នុងដៃខ្ញុំ, យើងនឹងប្រគល់វាមកអ្នកវិញ»។
បងប្រុសរបស់គាត់បានស្លាប់ហើយ, ហើយគាត់ត្រូវបានទុកឱ្យនៅម្នាក់ឯង.
43:2 ពួកគេបានបរិភោគស្បៀងអាហារដែលគេបានយកចេញពីស្រុកអេស៊ីប, លោកយ៉ាកុបមានប្រសាសន៍ទៅកាន់កូនប្រុសរបស់គាត់, "ចូរត្រឡប់មកវិញហើយទិញម្ហូបបន្តិចបន្តួចអោយយើង" ។
43:4 បើអ្នកចង់អោយគាត់ទៅជាមួយយើង, យើងនឹងធ្វើដំណើរជាមួយគ្នា, ហើយយើងនឹងទិញរបស់ចាំបាច់សម្រាប់អ្នក.
សម្រាប់បុរស, ដូចដែលយើងបាននិយាយជាញឹកញាប់, បានប្រកាសដល់ពួកយើង, និយាយ: You អ្នកនឹងមិនឃើញមុខខ្ញុំដោយគ្មានប្អូនពៅឡើយ› ។
43:7 ប៉ុន្តែពួកគេបានឆ្លើយតបវិញ: បុរសនោះបានសាកសួរយើងតាមលំដាប់លំដោយ, ទាក់ទងនឹងក្រុមគ្រួសាររបស់យើង: ថាតើឪពុករបស់យើងរស់នៅ, ប្រសិនបើយើងមានបងប្រុស.
តើយើងអាចដឹងថាគាត់នឹងនិយាយយ៉ាងម៉េច?, Bring នាំប្អូនរបស់អ្នកទៅជាមួយអ្នក?'"
43:10 ប្រសិនបើការពន្យាពេលមិនបានធ្វើអន្តរាគមន៍, ឥឡូវនេះយើងនឹងត្រលប់មកទីនេះជាលើកទី ២ ហើយ។
ហើយបញ្ជូនប្អូនរបស់អ្នក, ដែលគាត់កាន់, ត្រឡប់មកវិញជាមួយអ្នក, រួមជាមួយមួយនេះ, បេនយ៉ាមីន.
43:16 ហើយនៅពេលដែលគាត់បានឃើញពួកគេនិងបេនយ៉ាមីនជាមួយគ្នា, គាត់បានណែនាំអ្នកបម្រើក្នុងផ្ទះរបស់គាត់, និយាយ: “ នាំបុរសទាំងនោះចូលទៅក្នុងផ្ទះ, និងសម្លាប់ជនរងគ្រោះ, ហើយរៀបចំពិធីជប់លៀង, ពីព្រោះពួកគេនឹងបរិភោគជាមួយខ្ញុំនៅពេលថ្ងៃត្រង់” ។
43:18 ហើយនៅទីនោះ, កំពុងភ័យរន្ធត់, ពួកគេនិយាយគ្នាទៅវិញទៅមក: “ ដោយសារតែលុយ, ដែលយើងបានដឹកមកវិញក្នុងបាវរបស់យើង, យើងត្រូវបានគេនាំចូល, ដើម្បី ឲ្យ គាត់ចោទប្រកាន់ខុសពីយើង, ហើយដោយអំពើហឹង្សាធ្វើអោយយើងនិងលារបស់យើងចុះខ្សោយជាទាសករ” ។
43:21 ហើយបានទិញវា, ពេលយើងទៅដល់ផ្ទះសំណាក់, យើងបើកបាវរបស់យើងហើយរកឃើញប្រាក់នៅក្នុងមាត់បាវ, ដែលឥឡូវនេះយើងបានយកមកវិញក្នុងចំនួនដូចគ្នា.
វាមិនស្ថិតនៅលើមនសិការរបស់យើងដែលបានដាក់វានៅក្នុងកាបូបរបស់យើងនោះទេ។
ដូចជាប្រាក់ដែលអ្នកអោយខ្ញុំ, ខ្ញុំបានធ្វើតេស្តនេះជាការធ្វើតេស្តមួយ។ ហើយគាត់បាននាំស៊ីម្មានចេញទៅឯពួកគេ.
43:25 ប៉ុន្តែពួកគេក៏បានរៀបចំអំណោយ, រហូតដល់យ៉ូសែបបានចូលនៅពាក់កណ្តាលអធ្រាត្រ.
43:26 ដូច្នេះយ៉ូសែបបានចូលទៅក្នុងផ្ទះរបស់គាត់, គេក៏អោយអំណោយដល់គាត់, កាន់ពួកគេនៅក្នុងដៃរបស់ពួកគេ.
43:30 ហើយគាត់ក៏ប្រញាប់ចេញទៅ, ពីព្រោះគាត់មានទឹកចិត្តលើប្អូនគាត់ណាស់, ហើយស្រក់ទឹកភ្នែក.
43:33 ពួកគេអង្គុយនៅមុខលោក, កូនច្បងយោងទៅតាមច្បាប់បងប្អូនច្បងរបស់ខ្លួន, និងក្មេងជាងគេយោងទៅតាមស្ថានភាពនៃជីវិតរបស់គាត់.
43:34 លោកទទួលយកចំណែកដែលលោកបានទទួលពីលោក.
ហើយពួកគេបានផឹកហើយក្លាយជាមនុស្សមានបាបជាមួយគាត់.
44:1 បន្ទាប់មកយ៉ូសែបបានណែនាំអ្នកមើលខុសត្រូវលើផ្ទះរបស់គាត់, និយាយ: “ បំពេញបាវរបស់ពួកគេជាមួយគ្រាប់ធញ្ញជាតិ, ជាច្រើនដូចជាពួកគេអាចកាន់បាន.
44:2 ប៉ុន្តែដាក់ចានប្រាក់របស់ខ្ញុំ, និងតម្លៃដែលលោកបាន ឲ្យ ស្រូវសាលី, ក្នុងមាត់បាវរបស់ក្មេងពៅ»។ ដូច្នេះហើយវាត្រូវបានធ្វើរួច.
44:4 ហើយឥឡូវនេះពួកគេបានចាកចេញពីទីក្រុងហើយបានចេញដំណើរឆ្ងាយ.
ហើយនៅពេលដែលអ្នកបានយកឈ្នះពួកគេ, និយាយ: ហេតុអ្វីបានជាអ្នកធ្វើអំពើអាក្រក់ដើម្បីផលល្អ?
ហើយបានយកឈ្នះលើពួកគេ, ព្រះអង្គមានព្រះបន្ទូលទៅគេតាមបញ្ជា.
44:8 លុយ, ដែលយើងបានរកឃើញនៅខាងលើបាវរបស់យើង, យើងបាននាំអ្នកពីស្រុកកាណានត្រឡប់មកវិញ.
ជាមួយអ្នកណាវានឹងត្រូវបានរកឃើញ, សូមអោយគាត់ធ្វើជាអ្នកបំរើរបស់ខ្ញុំ, ប៉ុន្តែអ្នកនឹងគ្មានគ្រោះថ្នាក់ឡើយ” ។
44:12 ហើយនៅពេលដែលគាត់បានស្វែងរក, ចាប់ផ្តើមជាមួយនឹងចាស់បំផុត, វិធីទាំងអស់ដល់កូនពៅ, គាត់បានរកឃើញពែងនៅក្នុងបាវរបស់បេនយ៉ាមីន.
44:14 និងយូដា, ក្នុងចំណោមបងប្អូនប្រុសៗរបស់គាត់, បានចូលទៅយ៉ូសែប (លោកពុំទាន់បានចេញពីកន្លែងនោះនៅឡើយទេ) ពួកគេទាំងអស់គ្នាក្រាបចុះនៅមុខលោក.
អ្នកអាចល្ងង់ខ្លៅថាគ្មាននរណាម្នាក់ដូចខ្ញុំដែលមានចំណេះដឹងអំពីទីសំគាល់ដែលចេះពិចារណានោះទេ?”
ហើយអ្វីដែលយើងអាចនិយាយបាន, ឬដើម្បីទាមទារដោយយុត្តិធម៌?
សូមមើល, យើងទាំងអស់គ្នាបានធ្វើជាទាសកររបស់ម្ចាស់ខ្ញុំ, យើងទាំងពីរនាក់, ព្រះអង្គដែលបានរកឃើញពែងនោះ។
អ្នកដែលលួចពែង, គាត់នឹងធ្វើជាអ្នកបំរើរបស់ខ្ញុំ.
44:18 បន្ទាប់មកយូដា, ខិតជិតកាន់តែជិត, បាននិយាយដោយទំនុកចិត្ត: "ខ្ញុំ សូម អង្វរ អ្នក, ម្ចាស់របស់ខ្ញុំ, ទុកអោយអ្នកបំរើរបស់អ្នកពោលពាក្យមួយនៅក្នុងត្រចៀករបស់អ្នក, កុំខឹងនឹងអ្នកបំរើរបស់អ្នកឡើយ.
44:19 លោកម្ចាស់របស់ខ្ញុំ, អ្នកបានសាកសួរអ្នកបំរើរបស់អ្នកពីមុន: 'តើអ្នកមានឪពុកឬបងប្អូនប្រុស?'
ប្អូនប្រុសបង្កើតរបស់គាត់បានស្លាប់ទៅហើយ, ហើយមានតែគាត់ប៉ុណ្ណោះដែលត្រូវបានទុកឱ្យម្តាយនិងឪពុករបស់គាត់, ដែលពិតជាស្រឡាញ់គាត់យ៉ាងទន់ភ្លន់។ '
44:23 ហើយអ្នកបាននិយាយទៅកាន់អ្នកបំរើរបស់អ្នក: “ លុះត្រាតែប្អូនពៅរបស់អ្នកមកដល់ជាមួយអ្នក, អ្នកនឹងលែងឃើញមុខខ្ញុំទៀតហើយ។ '
បើប្អូនពៅយើងចុះមកជាមួយយើង, យើងនឹងដាក់ចេញជាមួយគ្នា.
44:29 ប្រសិនបើអ្នកយកមួយនេះ, ហើយមានអ្វីកើតឡើងចំពោះគាត់នៅតាមផ្លូវ, អ្នកនឹងនាំសក់ស្កូវរបស់ខ្ញុំដោយទុក្ខព្រួយទៅផ្នូរ។ '
44:31 ហើយប្រសិនបើគាត់ចង់ដឹងថាគាត់មិននៅជាមួយយើងទេ, គាត់នឹងស្លាប់, ពួកអ្នកបំរើរបស់ព្រះអង្គនឹងនាំសក់ស្កូវរបស់ព្រះអង្គមកទាំងសោកសៅ.
ដូច្នេះ, គាត់បានណែនាំថាមនុស្សទាំងអស់គួរតែចេញទៅក្រៅ, ហើយកុំអោយមាននរណាប្លែកពីគេនៅក្នុងចំណោមពួកគេនៅពេលដែលគេស្គាល់គ្នាទៅវិញទៅមក.
?បងប្អូនប្រុសរបស់គាត់មិនអាចឆ្លើយតបបានទេ, មានការភ័យខ្លាចយ៉ាងខ្លាំង.
45:5 កុំ ខ្លាច, ហើយកុំគិតថាអ្នកជាការលំបាកដែលអ្នកបានលក់ខ្ញុំទៅក្នុងតំបន់ទាំងនេះ.
45:6 អស់រយៈពេលពីរឆ្នាំហើយចាប់តាំងពីទុរ្ភិក្សចាប់ផ្ដើមកើតមាននៅលើទឹកដី, ហើយនៅសល់ ៥ ឆ្នាំទៀត, ដែលក្នុងនោះគេមិនអាចភ្ជួររាស់បានទេ, ហើយក៏មិនច្រូតបានដែរ.
45:11 ហើយនៅទីនោះខ្ញុំនឹងឃ្វាលអ្នក, (ព្រោះនៅសល់ទុរ្ភិក្សប្រាំឆ្នាំទៀត) ក្រែងលោអ្នកនិងផ្ទះរបស់អ្នកត្រូវវិនាសសូន្យ, រួមជាមួយរបស់ទាំងអស់ដែលអ្នកមាន។ '
45:13 អ្នកនឹងរាយការណ៍ទៅឪពុកខ្ញុំអំពីភាពរុងរឿងរបស់ខ្ញុំ, និងអំពីអ្វីដែលអ្នកបានឃើញនៅស្រុកអេស៊ីប.
45:14 ហើយបន្ទាប់មកធ្លាក់លើកញ្ចឹងកបងប្រុសបេនយ៉ាមីន, គាត់ឱបគាត់ហើយយំ.
45:15 លោកយ៉ូសែបថើបបងប្អូនទាំងអស់របស់លោក, គាត់យំជំនួសម្នាក់.
45:17 ហើយគាត់បានប្រាប់យ៉ូសែបថាគាត់គួរតែបញ្ជាបងប្អូនរបស់គាត់, និយាយ: “ ត្រូវទំលាក់សត្វរបស់អ្នក, ហើយទៅស្រុកកាណាន,
យើងនឹងប្រគល់របស់ល្អ ៗ ទាំងអស់នៅស្រុកអេស៊ីបដល់អ្នក, ដូច្នេះអ្នកអាចបរិភោគពីខួរឆ្អឹងដី។
និង និយាយ: យកឪពុករបស់អ្នក, ហើយមកយ៉ាងលឿន, ឱ្យបានឆាប់តាមដែលអាចធ្វើទៅបាន.
45:21 ជនជាតិអ៊ីស្រាអែលធ្វើតាមពាក្យដែលលោកបង្គាប់.
45:22 ដូចគ្នា, គាត់បានបញ្ជា ឲ្យ គេយកអាវពីរសំរាប់ពួកគេម្នាក់ៗ.
45:23 ហើយគាត់បានផ្ញើប្រាក់និងសម្លៀកបំពាក់ជាច្រើនទៅឪពុករបស់គាត់, បន្ថែមសត្វលាញី ១០ ក្បាល, ដើម្បីដឹកជញ្ជូនទ្រព្យសម្បត្តិទាំងប៉ុន្មាននៅស្រុកអេស៊ីប, និងសត្វលាញីជាច្រើន, ដឹកស្រូវសាលីនិងនំប៉័ងសំរាប់ធ្វើដំណើរ.
45:25 ហើយពួកគេបានឡើងចេញពីស្រុកអេស៊ីប, ពេលទៅដល់ស្រុកកាណាន, ដល់លោកយ៉ាកុបជាឪពុករបស់ពួកគេ.
ហើយនៅពេលដែលគាត់បានឃើញរទេះ, និងអ្វីទាំងអស់ដែលគាត់បានផ្ញើ, ស្មារតីរបស់គាត់បានរស់ឡើងវិញ,
ខ្ញុំនឹងទៅជួបគាត់មុនពេលខ្ញុំស្លាប់” ។
46:4 ខ្ញុំនឹងចុះមកជាមួយអ្នកទៅកន្លែងនោះ, យើងនឹងនាំអ្នកវិលត្រឡប់ពីទីនោះវិញ, ត្រឡប់មកវិញ.
46:6 រួមនឹងរបស់ទាំងអស់ដែលគាត់មាននៅស្រុកកាណាន.
46:7 កូនប្រុសនិងចៅរបស់គាត់, កូនស្រីរបស់គាត់និងកូនចៅរបស់គាត់ទាំងអស់រួមគ្នា.
ព្រលឹងកូនប្រុសស្រីទាំងអស់មានអាយុសាមសិបបីឆ្នាំ.
46:17 កូន ៗ របស់អេស៊ើរ: អ៊ីនណានិងចាសា, និងជេសួយនិងប៊្រីយ៉ា, និងសារ៉ាប្អូនស្រីរបស់ពួកគេដែរ.
46:18 ទាំងនេះជាកូនរបស់ស៊ីលប៉ា, ដែលឡាបាន់អោយកូនស្រីគាត់ឈ្មោះលេអា.
46:25 អ្នកទាំងនេះជាកូនប្រុសរបស់ប៊ីលហា, ដែលឡាបាន់អោយកូនស្រីគាត់ឈ្មោះរ៉ាជែល, ហើយនាងបានបង្កើតកូនទាំងនេះដល់យ៉ាកុប: ព្រលឹងទាំងអស់នេះមាន ៧ នាក់.
46:28 បន្ទាប់មកលោកចាត់ពួកយូដា ឲ្យ ទៅមុន, ទៅយ៉ូសែប, ដើម្បីរាយការណ៍ជូនគាត់, ហើយដូច្នេះគាត់នឹងជួបគាត់នៅកូសែន.
គោក្របីរបស់ពួកគេ, និងហ្វូង, និងអ្វីទាំងអស់ដែលពួកគេអាចកាន់បាន, ពួកគេបានយកមកជាមួយពួកគេ។ '
46:34 អ្នកនឹងឆ្លើយតប, អ្នកបំរើរបស់ព្រះអង្គជាគ្រូគង្វាលកិត្តិយស, តាំងពីយើងនៅក្មេងរហូតដល់បច្ចុប្បន្ន, យើងនិងឪពុករបស់យើង។ ឥឡូវនេះអ្នកនឹងនិយាយដូច្នេះដើម្បី ឲ្យ អ្នកអាចរស់នៅក្នុងតំបន់កូសែន, ពីព្រោះជនជាតិអេស៊ីបស្អប់គ្រូគង្វាលចៀមទាំងអស់»។
47:1 លោកយ៉ូសែបក៏ចូលទៅទូលព្រះចៅផារ៉ោន, និយាយ: “ ឪពុកនិងបងប្អូនរបស់ខ្ញុំ, ចៀមនិងគោរបស់ពួកគេ, និងអ្វីៗដែលពួកគេមាន, បានមកពីស្រុកកាណាន.
47:2 ដូចគ្នា, គាត់ឈរនៅចំពោះព្រះភក្ត្រស្តេចប្រាំនាក់, បងប្អូនចុងក្រោយរបស់គាត់.
47:4 យើងបានមករស់នៅក្នុងទឹកដីរបស់អ្នក, ព្រោះតែគ្មានស្មៅសម្រាប់ហ្វូងចៀមរបស់ព្រះអង្គ, ទុរ្ភិក្សកើតមានយ៉ាងខ្លាំងនៅក្នុងស្រុកកាណាន.
ធ្វើឱ្យពួកគេរស់នៅកន្លែងដែលល្អបំផុត, ហើយប្រគល់ស្រុកកូសែន.
47:7 បន្ទាប់ពី នេះ, យ៉ូសែបបាននាំឪពុករបស់គាត់ទៅគាល់ស្តេច, គាត់ឈរនៅមុខលោក.
47:12 ព្រះអង្គក៏ប្រទានចំណីអោយគេ, រួមជាមួយផ្ទះឪពុកទាំងអស់, ការផ្តល់ចំណែកនៃអាហារដល់ពួកគេម្នាក់ៗ.
47:14 ពីនោះគាត់ប្រមូលប្រាក់ទាំងអស់សម្រាប់ស្រូវដែលពួកគេបានទិញ, ហើយគាត់បានយកវាទៅក្នុងរតនសម្បត្តិរបស់ស្តេច.
ហេតុអ្វីយើងត្រូវស្លាប់នៅចំពោះព្រះភ័ក្ត្ររបស់អ្នក?, ខ្វះលុយ?”
47:18 ដូចគ្នា, ពួកគេបានមកនៅឆ្នាំទី ២, ពួកគេឆ្លើយថា៖: “ យើងនឹងមិនលាក់បាំងពីម្ចាស់របស់យើងថាប្រាក់របស់យើងត្រូវបានបាត់បង់នោះទេ; សត្វគោរបស់យើងក៏បាត់អស់ដែរ.
ទិញយើងឱ្យទៅជាខ្ញុំកញ្ជះរាជវង្ស, ប៉ុន្តែផ្តល់គ្រាប់ពូជ, ក្រែងលោអ្នកស្លាប់ដោយសារការដាំដុះនឹងត្រូវបំផ្លាញទៅជាទីរហោឋាន” ។
ហើយគាត់បានដាក់វាទៅព្រះចៅផារ៉ោន,
47:22 លើកលែងតែដីរបស់បូជាចារ្យ, ដែលបានប្រគល់ឱ្យពួកគេដោយស្តេច.
47:25 ហើយពួកគេបានឆ្លើយតប: សុខភាពរបស់យើងស្ថិតនៅក្នុងដៃរបស់អ្នកហើយ; សូមលោកម្ចាស់មេត្តាប្រណីនឹងយើងខ្ញុំផង, យើងនឹងគោរពថ្វាយព្រះរាជាដោយអំណរ»។
47:29 ហើយនៅពេលដែលគាត់បានដឹងថាថ្ងៃនៃមរណភាពរបស់គាត់ជិតដល់ហើយ, គាត់ហៅកូនប្រុសរបស់គាត់ថាយ៉ូសែប, ព្រះយេស៊ូមានព្រះបន្ទូលទៅគាត់: “ ប្រសិនបើខ្ញុំពេញចិត្តនឹងអ្នក, ដាក់ដៃរបស់អ្នកនៅក្រោមភ្លៅរបស់ខ្ញុំ.
ហើយយកកូនប្រុសពីរនាក់របស់គាត់គឺម៉ាណាសេនិងអេប្រាអ៊ីម, គាត់បានទៅរកគាត់ដោយផ្ទាល់.
អេប្រាអ៊ីមនិងម៉ាណាសេនឹងទទួលការប្រព្រឹត្តមកយើងដូចរូបេននិងស៊ីម្មានដែរ.
48:7 ដូចខ្ញុំដែរ, ពេលខ្ញុំមកពីស្រុកមេសូប៉ូតាមៀ, រ៉ាជែលបានស្លាប់នៅស្រុកកាណានពេលធ្វើដំណើរ, ហើយវាជារដូវផ្ការីក.
48:10 ដ្បិតភ្នែករបស់ជនជាតិអ៊ីស្រាអែលបានរសាត់បាត់ដោយព្រោះអាយុរបស់គាត់, ហើយគាត់មិនអាចមើលឃើញយ៉ាងច្បាស់.
48:12 ហើយនៅពេលដែលយ៉ូសែបបានយកពួកគេចេញពីភ្លៅឪពុករបស់គាត់, គាត់គោរពបូជានៅលើដី.
តែម៉ាណាសេនៅខាងឆ្វេង, គឺ, ឆ្ពោះទៅដៃស្តាំរបស់ឪពុកគាត់.
48:14 ហើយ គាត់, លើកដៃស្ដាំរបស់គាត់, ដាក់លើក្បាលអេប្រាអ៊ីម, ប្អូនប្រុស, រីឯដៃឆ្វេងស្ថិតនៅលើក្បាលម៉ាណាសេ, ដែលជាអែលឌើរ, ដូច្នេះដៃរបស់គាត់ត្រូវបានគេឆ្លងកាត់.
ហើយសូម ឲ្យ ពួកគេបានកើនដល់ទៅច្រើននៅពាសពេញផែនដី»។
ហើយចាប់ដៃឪពុកគាត់, លោកព្យាយាមលើកវាពីក្បាលអេប្រាអ៊ីមហើយផ្ទេរទៅក្នុងក្បាលម៉ាណាសេ.
ប៉ុន្តែប្អូនប្រុសរបស់គាត់នឹងធំជាងគាត់.
48:20 ហើយទ្រង់បានប្រទានពរដល់ពួកគេនៅពេលនោះ, និយាយ: "នៅក្នុង អ្នក, អ៊ីស្រាអែលនឹងទទួលពរ, ហើយវានឹងត្រូវនិយាយ: ព្រះអាចប្រព្រឹត្ដនឹងអ្នករាល់គ្នាដូចអេប្រាអ៊ីម, លោកបានបង្កើតអេប្រាអ៊ីមមុនម៉ាណាសេ.
48:22 ខ្ញុំផ្តល់ឱ្យអ្នកនូវចំណែកមួយលើសពីបងប្អូនរបស់អ្នក, ដែលខ្ញុំបានយកពីដៃរបស់ជនជាតិអាម៉ូរីដោយដាវនិងធ្នូរបស់ខ្ញុំ។
49:1 បន្ទាប់មកយ៉ាកុបបានហៅកូនប្រុសរបស់គាត់, ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេថា៖: “ ប្រមូលផ្តុំគ្នា, ដូច្នេះខ្ញុំនឹងប្រកាសអំពីព្រឹត្តិការណ៍ដែលនឹងកើតមានដល់អ្នកនៅថ្ងៃចុងក្រោយ.
49:4 អ្នកកំពុងត្រូវបានបង្ហូរចេញដូចជាទឹក, សូមកុំឱ្យអ្នកកើនឡើង.
49:5 បងប្អូនស៊ីម្មាននិងលេវី: នាវានៃអំពើទុច្ចរិតធ្វើសង្គ្រាម.
ខ្ញុំនឹងចែកពួកគេនៅក្នុងយ៉ាកុប, យើងនឹងកំចាត់ពួកគេនៅស្រុកអ៊ីស្រាអែល.
ដៃរបស់អ្នកនឹងស្ថិតនៅកនៃសត្រូវរបស់អ្នក; កូនប្រុសៗរបស់ឪពុកអ្នកនឹងគោរពអ្នក.
ហើយគ្រាន់តែដូចជាសត្វតោ, តើអ្នកណានឹងដៀលគាត់?
49:13 សេប៊ុលហ្សុននឹងរស់នៅតាមឆ្នេរសមុទ្រនិងតាមទីតាំងឆ្ងាយពីនាវា, ទៅដល់ស៊ីដូន.
49:16 ដាន់នឹងវិនិច្ឆ័យប្រជាជនរបស់គាត់ដូចកុលសម្ព័ន្ធឯទៀតៗនៅអ៊ីស្រាអែលដែរ.
ហើយខ្លួនគាត់ផ្ទាល់នឹងត្រូវក្រវាត់ត្រឡប់មកវិញ.
49:21 ណាប៉ូតលីគឺជាច្រកដែលត្រូវបានបញ្ជូនទៅ, ផ្តល់ជូននូវសម្ដីដ៏ស្រស់ស្អាត.
49:23 ប៉ុន្តែអ្នកដែលកាន់ព្រួញ, ធ្វើអោយគាត់ខឹង, ហើយពួកគេឈ្លោះជាមួយគាត់, ហើយពួកគេបានច្រណែននឹងគាត់.
ពីទីនោះគាត់បានចេញទៅជាគ្រូគង្វាល, ថ្មរបស់អ៊ីស្រាអែល.
49:26 ពរជ័យរបស់ឪពុកអ្នកត្រូវបានពង្រឹងដោយពរជ័យរបស់ឪពុកអ្នក, រហូតដល់សេចក្តីប៉ងប្រាថ្នានៃភ្នំអស់កល្បជានិច្ចនឹងមកដល់.
49:27 បេនយ៉ាមីនគឺជាសត្វចចកដ៏សាហាវ, នៅពេលព្រឹកគាត់នឹងស៊ីចំណី, ហើយនៅល្ងាចនោះគាត់នឹងចែកទ្រព្យសម្បត្ដិ»។
កប់ខ្ញុំជាមួយឪពុកខ្ញុំនៅក្នុងរូងពីរ, ដែលស្ថិតក្នុងចម្ការអេភូនជាជនជាតិហេត,
49:31 នៅទីនោះពួកគេបានបញ្ចុះគាត់, ជាមួយប្រពន្ធរបស់គាត់សារ៉ា។ ហើយនៅទីនោះអ៊ីសាកបានបញ្ចុះជាមួយប្រពន្ធរបស់គាត់ឈ្មោះរេបិកា.
49:32 ហើយលោកបានបញ្ចប់បទបញ្ជាទាំងនេះដែលលោកបានណែនាំកូន ៗ របស់លោក, គាត់បានទាញជើងរបស់គាត់ដាក់លើគ្រែ, ហើយគាត់បានស្លាប់.
50:2 ហើយគាត់បានណែនាំគ្រូពេទ្យដែលជាអ្នកបម្រើរបស់គាត់ឱ្យក្រអូបនឹងឪពុករបស់គាត់.
50:4 ហើយនៅពេលដែលពេលវេលានៃការកាន់ទុក្ខត្រូវបានបំពេញ, យ៉ូសែបបាននិយាយទៅកាន់ក្រុមគ្រួសារផារ៉ោន: “ ប្រសិនបើខ្ញុំពេញចិត្តនឹងអ្នក, ចូរនិយាយទៅកាន់ព្រះចៅផារ៉ោន.
50:7 ដូច្នេះនៅពេលគាត់ឡើងទៅ, ពួកព្រឹទ្ធា ចារ្យទាំងអស់នៃព្រះចៅផារ៉ោនក៏ទៅជាមួយដែរ, រួមជាមួយបុព្វបុរសទាំងអស់នៅស្រុកអេស៊ីប,
50:10 លុះមកដល់កន្លែងមួយឈ្មោះអថាត់, ដែលស្ថិតនៅខាងនាយទន្លេយ័រដាន់.
50:11 ហើយនៅពេលដែលប្រជាជននៅស្រុកកាណានបានឃើញរឿងនេះ, ពួកគេ ថា, នេះគឺជាការសោកសៅដ៏អស្ចារ្យសម្រាប់ជនជាតិអេស៊ីប។ ហើយសម្រាប់ហេតុផលនេះ, ឈ្មោះនៃកន្លែងនោះត្រូវបានគេហៅថា, “ បរិទេវនៃស្រុកអេស៊ីប”
50:13 ហើយដឹកគាត់ចូលស្រុកកាណាន, ពួកគេបានបញ្ចុះគាត់នៅក្នុងរូងភ្នំពីរ, ដែលលោកអប្រាហាំបានទិញជាមួយដីស្រែនោះ, ពីអេភូថនជាជនជាតិហេត, ជាកម្មសិទ្ធិសម្រាប់ការបញ្ចុះ, ទល់មុខ Mamre.
50:17 ដែលយើងគួរនិយាយពាក្យទាំងនេះទៅកាន់អ្នកពីគាត់: I ខ្ញុំសូមអង្វរអ្នកអោយភ្លេចអំពើអាក្រក់របស់បងប្អូនអ្នក, និងអំពើបាបនិងអំពើអាក្រក់ដែលពួកគេបានអនុវត្តទាស់នឹងអ្នក, យើងខ្ញុំសូមអង្វរលោកអោយដោះលែងអ្នកបំរើរបស់ព្រះជាម្ចាស់នៃព្រះនៃឪពុករបស់លោក។ this នេះ, យ៉ូសែបបានយំ.
តើយើងអាចទប់ទល់នឹងឆន្ទៈរបស់ព្រះបានទេ?
ប៉ុន្តែព្រះបានប្រែក្លាយវាទៅជាល្អ, ដូច្នេះលោកនឹងលើកតម្កើងខ្ញុំ, ដូចអ្នកដឹងស្រាប់ហើយ, ដូច្នេះលោកនឹងនាំសេចក្ដីសង្គ្រោះរបស់មនុស្សជាច្រើន.
ខ្ញុំនឹងឃ្វាលអ្នកនិងកូនតូចៗរបស់អ្នក»។ ហើយគាត់បានលួងលោមពួកគេ, ហើយគាត់និយាយទន់ភ្លន់និងទន់ភ្លន់.
ហើយគាត់បានឃើញកូនចៅអេប្រាអ៊ីមដល់ជំនាន់ទីបី.
50:23 បន្ទាប់ពីរឿងទាំងនេះបានកើតឡើង, គាត់បាននិយាយទៅកាន់បងប្អូនរបស់គាត់: “ ព្រះនឹងយាងមកជួបអ្នកបន្ទាប់ពីខ្ញុំស្លាប់, ព្រះ អង្គនឹងធ្វើ ឲ្យ អ្នកឡើងពីទឹកដីនេះទៅក្នុងស្រុកដែលលោកបានសន្យាជាមួយលោកអប្រាហាំ, អ៊ីសាក, និងយ៉ាកុប»។
50:25 គាត់ ស្លាប់ ហើយ, គាត់បានបញ្ចប់មួយរយដប់ឆ្នាំនៃជីវិតរបស់គាត់.
ម្តាយរបស់ព្រះ – 2ត្រី
ទំព័រ ដើម / ព្រះវិហារ / បញ្ហា / រឿងអាស្រូវនៅក្នុងសាសនាចក្រ
ទំព័រ ដើម / ព្រះគម្ពីរ / សំបុត្រ / សំបុត្រទី ២ របស់ប៉ូលជូនចំពោះគ្រិស្ដសាសនិកនៅក្រុងថែស្សាឡូនិច
3:2 ដើម្បីអោយយើងបានរួចផុតពីមនុស្សពេស្យានិងមនុស្សអាក្រក់.
3:4 ហើយយើងជឿជាក់លើអ្នកលើព្រះអម្ចាស់, ដែលអ្នកកំពុងធ្វើ, ហើយនឹងបន្តធ្វើ, ដូចយើងបានណែនាំ.
3:9 វាមិនដូចជាយើងគ្មានសិទ្ធិអំណាចនោះទេ, ប៉ុន្តែនេះគឺដើម្បីឱ្យយើងអាចធ្វើបទបង្ហាញពីខ្លួនយើងជាឧទាហរណ៍ដើម្បីឱ្យអ្នកមួយ, ដើម្បីធ្វើត្រាប់តាមយើង.
3:11 យើងបាន heard ថាមានអ្នកខ្លះក្នុងចំណោមអ្នកប្រព្រឹត្ដអំពើអាក្រក់, មិនដំណើរការទាល់តែសោះ, ផ្ទុយទៅវិញត្រូវប្រយ័ត្នប្រយែង.
វាលនេះគឺសម្រាប់គោលបំណងសុពលភាពហើយគួរតែទុកឱ្យនៅដដែល.
13:2 និងការឆ្លើយតប, ព្រះអង្គមានព្រះបន្ទូលទៅគេ: “ តើអ្នកគិតថាអ្នកស្រុកកាលីឡេទាំងនេះបានធ្វើបាបច្រើនជាងពួកកាលីឡេឯទៀត, ដោយសារតែពួកគេបានរងទុក្ខយ៉ាងខ្លាំង?
ប៉ុន្តែលុះត្រាតែអ្នកប្រែចិត្ត, អ្នកទាំងអស់គ្នានឹងត្រូវវិនាសដូចគ្នា.
13:6 ហើយគាត់ក៏បានប្រាប់រឿងប្រៀបប្រដូចនេះដែរ: បុរសម្នាក់មានដើមល្វា, ដែលត្រូវបានគេដាំនៅក្នុងចម្ការរបស់គាត់.
13:7 បន្ទាប់មកគាត់បាននិយាយទៅកាន់អ្នកដាំដុះចម្ការទំពាំងបាយជូរ: Behold មើលចុះ, អស់រយៈពេលបីឆ្នាំមកហើយដែលខ្ញុំបានរកផ្លែឈើនៅលើដើមល្វានេះ, ហើយខ្ញុំរកមិនឃើញ.
តើហេតុអ្វីបានជាវាអាចកាន់កាប់ដីបាន??'
28:9 ហើយមើលចុះ, ព្រះយេស៊ូវបានជួបពួកគេ, និយាយ, “ លាហើយ” គេចូលមកជិតទាញព្រះ បាទារបស់ព្រះ អង្គ, ហើយពួកគេបានគោរពគាត់.
ទៅ, ប្រកាសប្រាប់បងប្អូនខ្ញុំ, ដូច្នេះពួកគេនឹងទៅស្រុកកាលីឡេ.
28:11 ហើយនៅពេលដែលពួកគេបានចាកចេញ, មើលចុះ, ឆ្មាំមួយចំនួនបានចូលទៅក្នុងទីក្រុង, ពួកគេបានរាយការណ៍ប្រាប់ពួកនាយកបូជាចារ្យអំពីហេតុការណ៍ទាំងអស់ដែលកើតមាន.
28:13 និយាយ: “ និយាយថាសិស្សរបស់គាត់បានមកដល់ពេលយប់ហើយបានលួចយកគាត់ទៅ, ខណៈពេលដែលយើងកំពុងដេក.
28:15 បន្ទាប់មក, ដោយបានទទួលយកប្រាក់, ពួកគេបានធ្វើដូចដែលពួកគេត្រូវបានណែនាំ.
8:1 ហើយនៅពេលដែលគាត់បានចុះពីភ្នំមក, មានបណ្ដាជនជាច្រើនកុះករតាមព្រះអង្គ.
8:5 ហើយនៅពេលដែលគាត់បានចូលទៅក្រុងកាពើណិម, នាយទាហានម្នាក់ចូលមកជិត, ដាក់ញត្តិគាត់,
8:11 ត្បិតខ្ញុំនិយាយទៅកាន់អ្នក, នឹងមានមនុស្សជាច្រើនមកពីទិសខាងកើតនិងទិសខាងលិច, ពួកគេនឹងអង្គុយនៅតុជាមួយអាប្រាហាំ, និងអ៊ីសាក, និងយ៉ាកុបនៅក្នុងនគរស្ថានសួគ៌.
8:13 ព្រះយេស៊ូមានព្រះបន្ទូលទៅនាយទាហាន, “ ទៅ, ដូចអ្នកបានជឿ, ដូច្នេះសូមសំរេចវាសំរាប់អ្នកចុះ! »។ ហើយអ្នកបំរើបានជាសះស្បើយនៅម៉ោងនោះ.
8:15 ព្រះអង្គក៏ពាល់ដៃនាង, ពេលនោះគ្រុនក្តៅក៏បាត់ពីនាង, នាងក្រោកឡើងបំរើគេ.
8:18 បន្ទាប់មកព្រះយេស៊ូវ, ឃើញហ្វូងមនុស្សដ៏ធំកំពុងឡោមព័ទ្ធគាត់, បានចេញបញ្ជាឱ្យឆ្លងកាត់សមុទ្រ.
8:20 ព្រះយេស៊ូមានព្រះបន្ទូលទៅគាត់, “ កញ្ជ្រោងមានច្រើន, ហើយបក្សីនៃខ្យល់មានសំបុក, រីឯបុត្រមនុស្សវិញគ្មានទីជំរកសំរាកសោះឡើយ»។
8:24 ហើយមើលចុះ, ខ្យល់ព្យុះបក់បោកយ៉ាងខ្លាំងនៅសមុទ្រ, ដូច្នេះទូកបានគ្របដោយរលក; នៅឡើយទេ, គាត់កំពុងដេក.
8:28 ហើយនៅពេលដែលគាត់បានទៅដល់សមុទ្រ, ចូលទៅក្នុងតំបន់នៃ Gerasenes នេះ, គាត់ត្រូវបានជួបដោយមនុស្សពីរនាក់ដែលមានអារក្សចូល, ដែលជាសាហាវបំផុត, ពេលចេញពីផ្នូរ, ថាគ្មាននរណាម្នាក់អាចឆ្លងកាត់ដោយវិធីនោះ.
តើអ្នកបានមកទីនេះដើម្បីធ្វើទារុណកម្មយើងមុនពេលនោះទេ?”
8:31 ពេលនោះពួកអារក្សបានអង្វរព្រះអង្គ, និយាយ: “ ប្រសិនបើអ្នកដេញយើងចេញពីទីនេះ, សូមបញ្ជូនពួកយើងទៅក្នុងហ្វូងជ្រូក។
ហើយមើលចុះ, ហ្វូងសត្វទាំងប៉ុន្មានក៏ប្រញាប់ប្រញាល់ចូលតាមកន្លែងមួយឆ្ពោះទៅកាន់សមុទ្រ.
8:33 បន្ទាប់មកពួកគង្វាលបានរត់គេចខ្លួន, និងមកដល់ទីក្រុង, ពួកគេបានរាយការណ៍អំពីរឿងទាំងអស់នេះ, និងលើអ្នកដែលមានអារក្សចូល.
18:1 ឥឡូវគាត់ក៏បានប្រាប់រឿងប្រៀបប្រដូចដល់ពួកគេ, យើងត្រូវអធិស្ឋានឥតឈប់ឈរ,
18:3 ប៉ុន្ដែនៅក្រុងនោះមានស្ដ្រីមេម៉ាយម្នាក់, ហើយនាងបានទៅរកគាត់, និយាយ, V សងសឹកខ្ញុំពីសត្រូវរបស់ខ្ញុំ។ '
ឬតើគាត់នឹងនៅតែស៊ូទ្រាំនឹងពួកគេ?
18:11 ឈរ, អ្នកខាងគណៈផារីស៊ីនោះបានអធិស្ឋានដោយខ្លួនឯង: O ឱព្រះអង្គអើយ!, ខ្ញុំសូមថ្លែងអំណរគុណដល់អ្នកដែលខ្ញុំមិនដូចបុរសដទៃទៀត: ចោរប្លន់, អយុត្តិធម៌, អ្នកផិតក្បត់, ទោះជាអ្នកយកពន្ធនេះជ្រើសរើសធ្វើក៏ដោយ.
សម្រាប់មនុស្សគ្រប់រូបដែលលើកខ្លួនឯងនឹងត្រូវបានបន្ទាបខ្លួន; អ្នកណាលើកតម្កើងខ្លួនអ្នកនោះនឹងត្រូវគេលើកតម្កើង»។
18:35 ឥឡូវនេះវាបានកើតឡើង, កាលដែលលោកកំពុងធ្វើដំណើរជិតដល់ក្រុងយេរីខូ, មានបុរសខ្វាក់ម្នាក់អង្គុយនៅក្បែរផ្លូវ, សុំទាន.
18:37 គេប្រាប់គាត់ថាព្រះយេស៊ូជាអ្នកភូមិណាសារ៉ែតយាងមកតាមផ្លូវនោះ.
18:40 បន្ទាប់មកព្រះយេស៊ូវ, ឈរនៅតែ, បង្គាប់អោយគេនាំលោកមក.
ជំនឿរបស់អ្នកបានសង្គ្រោះអ្នកហើយ” ។
ទំព័រ ដើម / ព្រះវិហារ / តើយើងគួរថ្វាយបង្គំតាមរបៀបណា??
ទំព័រ ដើម / ព្រះគម្ពីរ / សំបុត្រ / សំបុត្រទី ១ របស់ប៉ូលជូនចំពោះគ្រិស្ដសាសនិកនៅក្រុងថែស្សាឡូនិច
ដ្បិតបងប្អូនផ្ទាល់ធ្លាប់បានរៀនពីព្រះជាម្ចាស់មកហើយថាត្រូវស្រឡាញ់គ្នាទៅវិញទៅមក.
1:24 ហើយបន្ទាប់ពីនាងផ្ដាច់ដោះកូន, នាងបាននាំគាត់ជាមួយនាង, រួមជាមួយនឹងកូនទាំងបី, និងបីវិធានការនៃម្សៅ, និងស្រាដបតូច, ហើយនាងបាននាំគាត់ទៅផ្ទះរបស់ព្រះអម្ចាស់នៅស៊ីឡូ.
1:28 ដោយ សារ តែ នេះ, ខ្ញុំបានផ្តល់ប្រាក់កម្ចីគាត់ទៅព្រះអម្ចាស់, សម្រាប់ថ្ងៃទាំងអស់នៅពេលដែលគាត់នឹងត្រូវបានផ្តល់ប្រាក់កម្ចីដល់ព្រះអម្ចាស់។ "ហើយពួកគេគោរពស្រឡាញ់ព្រះអម្ចាស់នៅកន្លែងនោះ.
ហើយចាប់តាំងពីគាត់មានតែងតែស្រឡាញ់សិស្សរបស់ព្រះអង្គដែលរស់នៅក្នុងលោកនេះ, គាត់ស្រឡាញ់គេរហូតដល់ទីបំផុត.
និងលោកពេត្រុសទូលព្រះអង្គ, « ព្រះ អម្ចាស់, តើអ្នកនឹងត្រូវលាងជើងទូលបង្គំ?"
ប៉ុន្តែអ្នកនឹងយល់ពីវាក្រោយមកទៀត "។
អ្នករាល់គ្នាបានស្អាតបរិសុទ្ធ, ប៉ុន្តែមិនមែនទាំងអស់»។
20:28 និយាយ ថា :: « លោក គ្រូ, លោកម៉ូសេបានចែងច្បាប់ទុកអោយយើង: ប្រសិនបើបងប្អូននរណាម្នាក់នឹងបានស្លាប់, មានប្រពន្ធ, ហើយប្រសិនបើគាត់មិនមានកូនទេ, បន្ទាប់មកបងប្អូនរបស់ខ្លួនគួរតែយកនាងធ្វើជាភរិយា, ហើយគាត់គួរតែបង្កើនឡើងន្ដពូជអោយបងប្រុសរបស់ខ្លួន.
និងជាលើកដំបូងបានរៀបការ, ហើយគាត់បានស្លាប់ទៅតែគ្មានកូនចៅ.
20:31 និងទីបីដែលបានរៀបការជាមួយនាង, ដូចគ្នានេះដែរទាំងប្រាំពីរហើយ, ហើយគ្មាននរណាបន្សល់ទុកពូជពង្សណាមួយ, ហើយពួកគេជារៀងរាល់បានស្លាប់.
20:34 ដូច្នេះ ហើយ, ព្រះយេស៊ូ មាន ព្រះបន្ទូល ទៅ ពួក គេ: "កុមារដែលមានអាយុនេះបានរៀបការហើយត្រូវបានគេផ្ដល់ឱ្យក្នុងអាពាហ៍ពិពាហ៍.
20:37 សម្រាប់នៅក្នុងសេចក្តីពិត, អ្នកស្លាប់កើនឡើងជាថ្មីម្តងទៀត, ដូចលោកម៉ូសេបានបង្ហាញថានៅក្បែរព្រៃ, នៅពេលដែលលោកបានហៅថាព្រះអម្ចាស់: "ព្រះនៃអ័ប្រាហាំ, និងជាព្រះរបស់អ៊ីសាក, និងជាព្រះរបស់យ៉ាកុប "។
សម្រាប់ទាំងអស់សុទ្ធតែនៅរស់ទៅគាត់»។
ចំពោះ អ្វី ដែល ត្រូវ បាន គេ បង្កើត ឡើង នៅ ក្នុង របស់ នាង គឺ នៃ ព្រះវិញ្ញាណ បរិសុទ្ធ.
នៅឡើយទេវាមិនមែនជាខ្ញុំ, ប៉ុន្តែព្រះគុណរបស់ព្រះជាម្ចាស់នៅក្នុងខ្លួនខ្ញុំ.
លុតជង្គង់, ពួកគេគោរពគាត់.
16:2 គេនឹងបណ្ដេញអ្នករាល់គ្នាចេញពីសាលាប្រជុំ *.
16:13 ប៉ុន្តែនៅពេលដែលព្រះវិញ្ញាណនៃសេចក្តីពិតបានមកដល់, នឹងបង្រៀនការពិតទាំងអស់ដល់អ្នក.
ផ្ទុយ ទៅ វិញ, អ្វីដែលគាត់នឹងឮ, គាត់នឹងនិយាយ.
16:15 តាមសេចក្ដីទាំងប៉ុន្មានដែលព្រះបិតាមានទាំងប៉ុន្មានសុទ្ធតែជារបស់ខ្ញុំ.
16:21 ស្រ្តី ម្នាក់, នៅពេលដែលនាងត្រូវបានផ្តល់កំណើត, មានទុក្ខព្រួយ, ព្រោះពេលកំណត់របស់នាងបានមកដល់.
ហើយគ្មាននរណាដកយកអំណរសប្បាយចេញពីចិត្ដអ្នករាល់គ្នា.
អា ម៉ែ ន !, អា ម៉ែ ន, ខ្ញុំ និយាយ ទៅ អ្ន ក, ប្រសិនបើអ្នកសួរព្រះបិតាសម្រាប់អ្វីក្នុងនាមខ្ញុំ, គាត់នឹងផ្ដល់ឱ្យវាទៅកាន់អ្នក.
ម៉ោងនេះត្រូវបានចូលមកនៅពេលដែលខ្ញុំនឹងលែងនិយាយរកអ្នកនៅក្នុងសុភាសិត; ជំនួស, ខ្ញុំនឹងប្រកាសដល់អ្នកយ៉ាងច្បាស់ពីព្រះបិតា.
បន្ទាប់ដែលខ្ញុំចាកចេញពីពិភពលោក, ហើយខ្ញុំទៅឯព្រះបិតា "។
16:30 ឥឡូវនេះយើងដឹងថាអ្នកចេះដឹងទាំងអស់, ហើយថាអ្នកមិនបាច់មាននរណាទូលសួរព្រះអង្គ.
និងនៅឡើយទេខ្ញុំមិននៅម្នាក់ឯង, ដ្បិតព្រះបិតាគង់នៅជាមួយខ្ញុំ.
