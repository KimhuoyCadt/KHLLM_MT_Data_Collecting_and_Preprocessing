45:13 អ្នកនឹងរាយការណ៍ទៅឪពុករបស់ខ្ញុំអំពីសិរីរុងរឿងរបស់ខ្ញុំទាំងអស់, និងអំពីការទាំងអស់ដែលអ្នកបានឃើញនៅក្នុងប្រទេសអេហ្ស៊ីប.
45:14 ហើយបន្ទាប់មកបានធ្លាក់ចុះនៅលើស្មារបស់បងប្រុសរបស់លោកបេនយ៉ាមីន, គាត់បានឱបគាត់ហើយយំសោក.
45:15 ហើយយ៉ូសែបបានថើបបងរបស់លោកទាំងអស់, ហើយគាត់បានស្រែកជាងមួយគ្នា.
45:16 ហើយវាត្រូវបានឮ, និងបានរីករាលដាលដោយដំណឹងពាក្យទូទាំងតុលាការរបស់ស្តេច.
45:17 លោកបានប្រាប់លោកយ៉ូសែបនិងថាគាត់គួរតែបានបង្គាប់បងប្អូនរបស់គាត់, និយាយ ថា :: "" បន្ទុកសត្វរបស់អ្នក, ហើយចូលទៅក្នុងស្រុកកាណាន,
ហើយខ្ញុំនឹងផ្តល់ឱ្យអ្នកនូវអ្វីដែលល្អទាំងអស់នៃស្រុកអេស៊ីប, ដូច្នេះអ្នកអាចបរិភោគពីខួរស្រុកនោះ "»។
45:21 និងកូនប្រុសរបស់អ៊ីស្រាអែលបានធ្វើការគ្រាន់តែជាពួកគេត្រូវបានបង្គាប់.
45:22 ដូចគ្នា នេះ ដែរ, លោកបានបញ្ជាឱ្យអាវពីរសម្រាប់គ្នានៃពួកគេត្រូវបាននាំយក.
45:23 គាត់បានផ្ញើលុយនិងគ្រាន់តែជាច្រើនដូចជាសម្លៀកបំពាក់ទៅនិងឪពុករបស់គាត់, លោកបានបន្ថែមផងដែរថាចំនួនដប់លាញីឈ្មោល, ជាមួយនឹងការដែលការដឹកជញ្ជូនទ្រព្យសម្បត្ដិទាំងអស់របស់ប្រទេសអេស៊ីប, ស្ត្រីនិងសត្វលាជាច្រើនដូចជា, ដឹកស្រូវសាលីនិងនំបុ័ងសម្រាប់ការធ្វើដំណើរ.
45:25 ហើយពួកគេបានឡើងចេញពីស្រុកអេស៊ី, ហើយពួកគេបានមកដល់នៅក្នុងស្រុកកាណាន, លោកយ៉ាកុបជាឪពុករបស់ពួកគេទៅ.
ហើយនៅពេលដែលលោកបានឃើញរទេះ, និងអ្វីទាំងអស់ដែលលោកបានបញ្ជូន, វិញ្ញាណរបស់ទ្រង់បានរស់ឡើងវិញ,
ខ្ញុំនឹងទៅមើលគាត់មុនពេលដែលខ្ញុំស្លាប់»។
46:4 ខ្ញុំនឹងចុះមកជាមួយអ្នកទៅកន្លែងនោះ, ហើយខ្ញុំនឹងនាំអ្នកត្រឡប់មកវិញពីទីនោះ, ការវិលត្រឡប់.
46:6 រួមជាមួយទាំងអស់ដែលគាត់កាន់កាប់ស្រុកកាណាន.
46:7 កូននិងចៅរបស់គាត់, កូនស្រីទាំងអស់របស់គាត់និងកូនចៅរបស់គាត់ដែលបានរួមគ្នា.
និងកូនប្រុសត្រូវបានកើតទៅ Perez បាន: ហេស្រុននិងហាមុល.
ព្រលឹងទាំងអស់របស់កូនប្រុសរបស់នាងនិងកូនស្រីសាមសិបបីមាន.
46:18 កូនចៅរបស់នាងស៊ីលផាបាន, ការដែលលោកឡាបាន់ប្រគល់ទៅឱ្យកូនស្រីរបស់គាត់លេអា.
46:25 កូនចៅរបស់នាងប៊ីលហានេះ, ការដែលលោកឡាបាន់ប្រគល់ទៅឱ្យកូនស្រីរបស់លោកស្រីរ៉ាជែល, ហើយនាងទាំងនេះបង្កើតជូនលោកយ៉ាកុប: ព្រលឹងទាំងអស់នេះគឺមានចំនួនប្រាំពីរ.
46:28 បន្ទាប់មកលោកបានបញ្ជូនជនជាតិយូដានាំមុខនៃខ្លួនរបស់គាត់, លោកយ៉ូសែប, នៅក្នុងគោលបំណងដើម្បីរាយការណ៍ទៅឱ្យគាត់, ហើយដូច្នេះគាត់នឹងជួបគាត់នៅក្នុងតំបន់កូសែន.
46:34 អ្នកនឹងឆ្លើយតប, "ពួកខ្ញុំបម្រើរបស់អ្នកគឺគ្រូគង្វាលនៃកិត្តិយស, ពីទារករបស់យើងសូម្បីតែដល់ពេលបច្ចុប្បន្ននេះ, ទាំងពីរយើងនិងបុព្វបុរសរបស់យើង "។ ឥឡូវនេះអ្នកនឹងនិយាយថានេះដូច្នេះអ្នកប្រហែលជាអាចរស់នៅក្នុងតំបន់កូសែន, ដោយសារតែជនជាតិអេស៊ីបស្អប់គ្រូគង្វាលទាំងអស់របស់ចៀម»។
47:1 ដូច្នេះហើយយ៉ូសែបបានចូលទៅក្នុងនិងបានរាយការណ៍ទៅឱ្យព្រះចៅផារ៉ោន, និយាយ ថា :: «ឪពុកនិងបងប្អូនរបស់ខ្ញុំ, ហ្វូងចៀមនិងហ្វូងគោរបស់ពួកគេ, និងអ្វីគ្រប់យ៉ាងដែលពួកគេជាអ្នកគ្រប់គ្រង, មកពីស្រុកកាណាន.
47:2 ដូចគ្នា នេះ ដែរ, គាត់បានឈរនៅចំពោះមុខបុរសស្តេចប្រាំ, ចុងក្រោយរបស់បងប្អូនប្រុសរបស់គាត់.
47:4 យើងបានចូលមកដល់ទឹកដីរបស់អ្នកនឹងអាស្រ័យនៅ, ព្រោះគ្មានស្មៅសំរាប់ហ្វូងចៀមរបស់អ្នកបំរើរបស់អ្នកទេ, ទុរ្ភិក្សយ៉ាងខ្លាំងនៅក្នុងការធ្វើជាធ្ងន់ធ្ងរស្រុកកាណាន.
47:7 បន្ទាប់ ពី នេះ, លោកយ៉ូសែបនាំយកឪពុករបស់គាត់ទៅព្រះមហាក្សត្រ, ហើយគាត់បានឈរនៅចំពោះព្រះភ័ក្ត្ររបស់គាត់គាត់.
47:12 ហើយគាត់បានចិញ្ចឹមពួកគេ, រួមជាមួយនឹងក្រុមគ្រួសាររបស់លោកទាំងអស់, ការផ្តល់ផ្នែកនៃអាហារដល់ទៅមួយគ្នា.
47:14 ពីការដែលលោកបានប្រមូលផ្តុំគ្នាលុយទាំងអស់សម្រាប់ការដែលពួកគេបានទិញស្រូវនេះ, ហើយគាត់បានយកវាចូលទៅក្នុងហិបតង្វាយរបស់ស្ដេច.
ហេតុអ្វីបានជាយើងគួរតែបានស្លាប់នៅក្នុងការមើលឃើញរបស់អ្នក, ការខ្វះខាតប្រាក់?"
47:18 ដូចគ្នា នេះ ដែរ, ពួកគេបានមកឆ្នាំទីពីរ, ហើយ ពួក គេ ពោល ទៅ គាត់ ថា: «យើងនឹងមិនលាក់បាំងពីម្ចាស់របស់យើងថាលុយរបស់យើងគឺបានយាងចាកចេញទៅ; ដូចគ្នានេះដែរសត្វពាហនៈរបស់យើងត្រូវបានបាត់.
ទិញយើងចូលទៅក្នុងភាពជាខ្ញុំបម្រើរាជ, ប៉ុន្តែការផ្តល់នូវគ្រាប់ពូជ, ក្រែងលោដោយការស្លាប់បិទនៃការដាំដុះដីនេះត្រូវបានកាត់បន្ថយទៅវាលរហោស្ថានមួយ "។
ហើយគាត់បានទទួលរងវាទៅព្រះចៅផារ៉ោន,
47:22 លើកលែងតែដីរបស់បូជាចារ្យ, ដែលត្រូវបានគេប្រគល់ទៅឱ្យពួកគេដោយស្តេច.
47:29 ហើយនៅពេលដែលគាត់បានដឹងថាថ្ងៃស្លាប់បានខិតជិត, លោកបានហៅលោកយ៉ូសែបជាកូន, ហើយ គាត់ បាន និយាយ ទៅ គាត់ ថា: «ប្រសិនបើខ្ញុំបានរកឃើញការពេញចិត្តក្នុងការមើលឃើញរបស់អ្នក, ដាក់ដៃរបស់អ្នកនៅក្រោមភ្លៅរបស់ខ្ញុំ.
និងយកកូនប្រុសរបស់គាត់ពីរនាក់គឺម៉ាណាសេនិងអេប្រាអ៊ី, គាត់បានទៅដោយផ្ទាល់ទៅគាត់.
អេប្រាអ៊ីមនិងម៉ាណាសេនឹងត្រូវបានព្យាបាលដោយឱ្យខ្ញុំគ្រាន់តែដូចរូបេននិងស៊ីម្មាន.
48:7 ក្នុងនាមជាសម្រាប់ខ្ញុំ, នៅពេលដែលខ្ញុំបានមកពីនាយទន្លេអឺប្រា, លោកស្រីរ៉ាជែលបានស្លាប់នៅស្រុកកាណាននៅលើការធ្វើដំណើរខ្លាំងណាស់, ហើយវាគឺជានិទាឃរដូវ.
48:10 សម្រាប់ភ្នែករបស់អ៊ីស្រាអែលត្រូវបានបាំងដោយហេតុផលនៃការមានអាយុយ៉ាងខ្លាំងរបស់គាត់, ហើយគាត់មិនអាចមើលឃើញយ៉ាងច្បាស់.
48:12 ហើយនៅពេលដែលលោកយ៉ូសែបបានយកពួកវាចេញពីភ្លៅរបស់ឪពុករបស់គាត់, លោកបានគោរពងាយនៅលើដី.
ប៉ុន្ដែការពិតជាម៉ាណាសេគឺនៅខាងឆ្វេងរបស់គាត់, គឺ, ឆ្ពោះទៅរកដៃខាងស្តាំរបស់ឪពុករបស់គាត់.
48:14 ហើយ គាត់, ការពង្រីកដៃខាងស្តាំរបស់គាត់, ដាក់វានៅលើក្បាលអេប្រាអ៊ីម, ប្អូនប្រុសនេះ, ប៉ុន្តែដៃបានចាកចេញនេះគឺនៅលើក្បាលម៉ាណាសេ, អែលឌើរដែលជា, ដូច្នេះដៃរបស់គាត់ត្រូវបានឆ្លងកាត់.
ហើយអាចពួកគេបានបង្កើនទៅជាច្រើននៅទូទាំងផែនដី»។ 48:17 លោកយ៉ូសែប, មើលឃើញថាឪពុករបស់គាត់បានដាក់ដៃខាងស្តាំរបស់គាត់លើក្បាលអេប្រាអ៊ីម, បានយកវាធ្ងន់ធ្ងរ.
ដាក់ដៃស្ដាំរបស់អ្នកនៅលើក្បាលរបស់គាត់ "។
និងមួយនេះ, ជា ការ ពិត, នឹងមានក្នុងចំណោមប្រជាជនហើយនឹងត្រូវបានគុណ.
និងពូជពង្សរបស់លោកនឹងកើនឡើងក្នុងចំណោមប្រជាជាតិនានា»។
49:3 រូបេន, កូនច្បងរបស់ខ្ញុំ, អ្នកគឺជាកម្លាំងនិងការចាប់ផ្តើមនៃទុក្ខព្រួយរបស់ខ្ញុំខ្ញុំ: លើកដំបូងនៅក្នុងអំណោយ, កាន់តែច្រើននៅក្នុងអំណាចគ្រប់គ្រង.
សម្រាប់អ្នកឡើងលើគ្រែឪពុករបស់អ្នក, ហើយអ្នកបង្អាប់បង្អោនទីកន្លែងសំរាករបស់គាត់.
49:6 សូមឱ្យព្រលឹងខ្ញុំទៅមិនដោយដំបូន្មានរបស់ពួកគាត់, ឬសិរីរុងរឿងរបស់យើងមាននៅក្នុងកិច្ចប្រជុំរបស់ពួក.
49:7 កំហឹងត្រូវបណ្ដាសារបស់ពួកគេ, ដោយសារតែវាជាការរឹងចចេស, និងកំហឹងរបស់ពួកគេ, ដោយសារតែវាជាការអាក្រក់.
49:12 ភ្នែករបស់គាត់ស្រស់ស្អាតជាងស្រាទំពាំងបាយជូរ, និងធ្មេញសជាងទឹកដោះគោ.
49:14 អ៊ីសាខារនឹងក្លាយជាសត្វលាខ្លាំង, អង្គុយនៅចន្លោះព្រំដែន.
49:22 លោកយ៉ូសែបជាកូនប្រុសកើនឡើង, ជាកូនរីកលូតលាស់និងរដ្ឋដើម្បីឃើញ; កូនស្រីនេះរត់ទៅមកនៅលើជញ្ជាំង.
49:24 ក្បាលរបស់គាត់អង្គុយនៅក្នុងកម្លាំង, និងក្រុមតន្រ្តីនៃអាវុធនិងដៃរបស់គាត់ត្រូវបានដោះលែងដោយដៃរបស់អ្នកខ្លាំងពូកែមួយរបស់យ៉ាកុប.
49:25 ព្រះនៃឪពុករបស់អ្នកនឹងត្រូវបានជំនួយរបស់អ្នក, និងពិភពទាំងមូលនឹងប្រទានពរដល់អ្នកជាមួយនឹងពរជ័យនៃស្ថានបរមសុខខាងលើ, ជាមួយនឹងពរជ័យនៃទីជ្រៅបំផុតដែលស្ថិតនៅក្រោម, ជាមួយនឹងពរជ័យនៃសុដន់និងស្បូន.
សូមឱ្យពួកគេនៅក្បាលរបស់លោកយ៉ូសែប, និងនៅកិច្ចប្រជុំកំពូលនៃ Nazarite មួយនេះ, ក្នុងចំណោមបងប្អូនប្រុសរបស់គាត់.
49:30 ផ្ទុយម៉ាមរ៉េ, នៅស្រុកកាណាន, លោកអប្រាហាំបានទិញដែលមាន, រួមជាមួយនឹងវាលរបស់ខ្លួន, ពីលោកអេប្រូនជនជាតិហេត, សម្រាប់ការបញ្ចុះសពជាកម្មសិទ្ធិមួយ.
នៅទីនោះផងដែរលោកស្រីលេអាពាក្យកុហកដែលបានបម្រុងទុក.
50:1 លោកយ៉ូសែប, ការសំរេចនេះ, ធ្លាក់មកលើមុខរបស់ឪពុករបស់គាត់, យំនិងថើបគាត់.
50:3 ហើយខណៈពេលដែលពួកគេត្រូវបានបំពេញការបញ្ជាទិញរបស់គាត់, កន្លងផុតទៅអស់រយៈពេលសែសិបថ្ងៃ.
និងអេហ្ស៊ីបបានយំសម្រាប់គាត់អស់រយៈពេលចិតសិបថ្ងៃ.
50:8 ហើយផ្ទះរបស់លោកយ៉ូសែបនៅជាមួយបងប្អូនរបស់គាត់, លើកលែងតែអ្នកតូចតាចរបស់ពួកគេនិងហ្វូងចៀមនិងហ្វូងគោនេះផងដែរ, ដែលពួកគេបានបន្សល់ទុកនៅស្រុកកូសែន.
ហើយវាបានក្លាយជាហ្វូងមនុស្សដោយគ្មានការអត់ធ្មត់មួយ.
នៅទីនោះពួកគេបានចំណាយពេលប្រាំពីរថ្ងៃពេញលេញប្រារព្វពិធីបុណ្យសពជាមួយនឹងការយំសោកយ៉ាងខ្លាំងនិងខ្លាំងក្លា.
50:14 ហើយយ៉ូសែបបានវិលត្រឡប់ចូលទៅក្នុងប្រទេសអេស៊ីបជាមួយនឹងបងប្អូនរបស់គាត់និងអស់អ្នកដែលក្រុមហ៊ុនរបស់លោក, ដោយបានបញ្ចុះសពឪពុករបស់គាត់.
50:22 ហើយគាត់បានរស់នៅក្នុងស្រុកអេស៊ីបជាមួយនឹងផ្ទះឪពុករបស់លោកទាំងអស់; ហើយគាត់បានរួចរស់ជីវិតសម្រាប់មួយរយដប់ឆ្នាំ.
ដូចគ្នា នេះ ដែរ, កូនចៅរបស់លោកម៉ាកៀរជា, កូនរបស់លោកម៉ាណាសេ, បានកើតទៅលើជង្គង់របស់លោកយ៉ូសែប.
ហើយត្រូវបានអប់សពជាមួយក្រអូប, គាត់ត្រូវបានដាក់ទៅសល់ក្នុងក្តារមឈូសមួយនៅស្រុកអេស៊ីប.
ដ្បិត គេ បៀតបៀន ពួក ព្យាការី ដែល រស់នៅ មុន អ្នករាល់គ្នា.
ប៉ុន្តែបើអំបិលបាត់ជាតិប្រៃ, ជាមួយនឹងអ្វីដែលវានឹងមានជាតិប្រៃ?
5:15 ហើយពួកគេមិនអុជចង្កៀងហើយដាក់វានៅក្រោមកញ្ចប់មួយ, ប៉ុន្តែនៅលើជើងចង្កៀងវិញ, ដូច្នេះវាអាចបំភ្លឺអស់អ្នកដែលនៅក្នុងផ្ទះ.
5:17 កុំនឹកស្មានថាខ្ញុំមកដើម្បីបន្ធូរបន្ថយច្បាប់ឬគម្ពីរព្យាការី.
5:18 ខ្ញុំ សុំ ប្រាប់ អោយ អ្នក រាល់ គ្នា, ជា ការ ពិត, ដរាបណាផ្ទៃមេឃនិងផែនដីរលាយបាត់, មិនមួយ iota, មិនបានមួយចំណុចរលាយបាត់ពីច្បាប់, រហូតដល់ទាំងអស់ត្រូវបានធ្វើរួច.
រីឯអ្នកដែលនឹងត្រូវបានគេហៅថាជាប្អូនរបស់គាត់, "Idiot,"នឹងត្រូវបានផ្ដន្ទាទោសក្រុមប្រឹក្សានេះ.
5:23 ហេតុនេះ ហើយ បាន ជា, ប្រសិនបើអ្នកថ្វាយតង្វាយរបស់អ្នកនៅអាសនៈ, ហើយនៅទីនោះអ្នកនឹកឃើញថាបងប្អូនរបស់អ្នកមានទំនាស់នឹងអ្នក,
5:25 ត្រូវសំរុះសំរួលជាមួយបច្ចាមិត្ររបស់អ្នកបានយ៉ាងឆាប់រហ័ស, ខណៈពេលដែលអ្នកនៅតែមាននៅលើវិធីជាមួយគាត់, ក្រែងលោមារសត្រូវអាចបញ្ជូនអ្នកទៅចៅក្រម, ចៅក្រមបញ្ជូនអ្នកទៅនគរបាល, ហើយអ្នកនឹងត្រូវបានបដិសេធចោលនៅក្នុងគុក.
5:40 និងនរណាម្នាក់ដែលចង់ឈ្លោះជាមួយអ្នកនៅក្នុងការវិនិច្ឆ័យ, ហើយដើម្បីយកទៅឆ្ងាយអាវរបស់អ្នក, ដោះលែងលោកអាវធំរបស់អ្នកផងដែរ.
5:43 អ្នកបានឮថាវាត្រូវបានគេនិយាយថា:, "ចូរស្រឡាញ់អ្នកជិតខាងរបស់អ្នក, ហើយអ្នកនឹងមានការស្អប់សត្រូវរបស់អ្នក "។
5:47 ហើយបើអ្នករាល់គ្នាគំនាប់តែបងប្អូនរបស់អ្នក, អ្វីដែលអ្នកបានធ្វើរួចបានច្រើន?
5:48 ហេតុនេះ ហើយ បាន ជា, ជាការល្អឥតខ្ចោះ, ដូចព្រះបិតាដែលគង់នៅស្ថានបរមសុខគឺល្អឥតខ្ចោះ»។
យើង មិន បាន ស្ដាប់ សំឡេង គាត់.
វេទនា ដល់ អ្នករាល់គ្នា, បេតសៃដា!
10:14 ប៉ុ ន្ដែ ជា ការ ពិត, ក្រុងទីរ៉ុសនិងក្រុងស៊ីដូននឹងលើកលែងទោសអោយបានកាន់តែច្រើននៅក្នុងការវិនិច្ឆ័យជាងអ្នកនឹងត្រូវបាន.
រីឯអ្នកដែលស្អប់ខ្ញុំអ្នក, ចំអកមើលងាយព្រះអង្គដែលបានចាត់ខ្ញុំអោយមក»។
1:1 ព្រះបន្ទូលរបស់ព្រះអម្ចាស់ដែលបានយាងមកជាកូនរបស់ជនជាតិអេត្យូសេផានានេះ, កូនរបស់លោកកេដាលាបាន, កូនរបស់លោកដែលម៉ារា, កូនរបស់លោកហេសេគា, នៅក្នុងថ្ងៃនៃព្រះបាទយ៉ូសៀសជាបុត្ររបស់ព្រះបាទអាំម៉ូននេះ, ស្តេចស្រុកយូដា.
1:3 យើងនឹងប្រមូលមនុស្សនិងសត្វគោ; យើងនឹងប្រមូលរឿងហោះនៃខ្យល់និងត្រីសមុទ្រ.
ហើយខ្ញុំនឹងបំបែកបុរសមុខនៃផែនដី, ជា ព្រះបន្ទូល របស់ ព្រះអម្ចាស់.
ហើយខ្ញុំនឹងបំបែកចេញពីកន្លែងនេះសំណល់របស់ព្រះបាល, និងឈ្មោះនៃការគ្រប់គ្រងរួមជាមួយពួកបូជាចារ្យ,
1:6 អស់អ្នកដែលងាកចេញពីការតាមក្រោយពីព្រះអម្ចាស់, និងអ្នកដែលមិនបានស្វែងរកព្រះអម្ចាស់, ឬសាកសួរអំពីគាត់.
ដ្បិតថ្ងៃរបស់ព្រះអម្ចាស់គឺនៅជិត; ដ្បិតព្រះអម្ចាស់បានរៀបចំជនរងគ្រោះ, គាត់បានរាប់ជាបរិសុទ្ធអ្នកដែលលោកបានហៅ.
1:9 ហើយខ្ញុំនឹងទស្សនាលើអស់អ្នកដែលចូលក្រអឺតក្រទមជាងកម្រិតចាប់ផ្ដើមនៅថ្ងៃនោះ, អស់អ្នកដែលបំពេញព្រះដំណាក់របស់ព្រះអម្ចាស់ជាព្រះរបស់ខ្លួនជាមួយនឹងការប្រព្រឹត្តអំពើទុច្ចរិតនិងការបោកបញ្ឆោត.
ទាំងអស់ត្រូវបានបំផ្លាញដែលត្រូវបានរុំនៅក្នុងការប្រាក់.
1:13 និងកម្លាំងរបស់ពួកគេនឹងមាននៅក្នុងការឆក់ប្លន់, និងផ្ទះរបស់ពួកគេនៅវាលរហោស្ថាន.
1:14 ថ្ងៃធំរបស់ព្រះអម្ចាស់គឺនៅជិត; វាគឺជាការនៅជិតនិងលឿនរហ័សខ្លាំង.
1:15 ថ្ងៃនោះជាថ្ងៃនៃសេចក្ដីក្រោធមួយ, មួយថ្ងៃនៃសេចក្តីទុក្ខព្រួយនិងការឈឺចាប់, មួយថ្ងៃមហន្តរាយនិងទុក្ខវេទនា, ថ្ងៃ នៃ ភាព ងងឹត និង ភាព ខ្មៅ ងងឹត មួយ, ថ្ងៃ នៃ ពពក និង ខ្យល់ កួច,
1:17 ហើយខ្ញុំនឹងបុរសមានបញ្ហា, ហើយពួកគេនឹងដើរដូចមនុស្សខ្វាក់, ព្រោះពួកគេបានប្រព្រឹត្តអំពើបាបប្រឆាំងនឹងព្រះអម្ចាស់.
1:18 មិនមានប្រាក់របស់ខ្លួន, ឬមាសរបស់ខ្លួន, នឹងអាចរំដោះពួកគេនៅក្នុងថ្ងៃនៃព្រះពិរោធរបស់ព្រះអម្ចាស់.
2:2 រហូតមកដល់ក្រឹត្យដោះស្រាយគណនី, ថ្ងៃដូចធូលីដីដែលត្រូវបានរសាត់បាត់ទៅ, មុនពេលដែលព្រះពិរោធរបស់កំហឹងរបស់ព្រះអម្ចាស់អាចឈ្នះអ្នកបាន, មុនពេលដែលថ្ងៃនៃព្រះពិរោធរបស់ព្រះអម្ចាស់អាចឈ្នះអ្នកបាន.
2:4 ចំពោះតំបន់ហ្គាហ្សានឹងត្រូវបំផ្លាញចោល, ហើយក្រុងអាសកាឡូននឹងមាននៅក្នុងវាលរហោស្ថាន; ពួកគេនឹងបណ្តេញអាសនៅថ្ងៃត្រង់, និងក្រុងអេក្រូននឹងត្រូវបានបំបាត់.
ព្រះបន្ទូលរបស់ព្រះអម្ចាស់នេះគឺលើអ្នក, ស្រុកកាណាន, ដីភីលីស្ទីន, ហើយខ្ញុំនឹងបំបែកអ្នក, ដូច្នេះមិនមែនជាមួយប្រជាជនរស់នឹងត្រូវចាកចេញ.
2:7 ហើយវានឹងក្លាយជាបន្ទាត់របស់ព្រះអង្គដែលនឹងនៅតែពីផ្ទះរបស់ជនជាតិយូដា.
នៅក្នុងផ្ទះនៃក្រុងអាសកាឡូន, ពួកគេនឹងសម្រាកឆ្ពោះទៅរកល្ងាច.
2:8 ខ្ញុំបានឮអំពីភាពអាម៉ាស់នៃស្រុកម៉ូអាប់និងពោលពាក្យប្រមាថព្រះជាម្ចាស់កូនរបស់អាំម៉ូន, ដោយពួកគេបានបរិហារកេរ្តិ៍ដែលប្រជាជនរបស់យើងហើយត្រូវបានគេបានពង្រីកហួសពីព្រំដែនរបស់ខ្លួន.
សំណល់នៃប្រជាជនរបស់យើងនឹងបំផ្លាញពួកគេ, និងកាកសំណល់របស់ប្រទេសជាតិរបស់ខ្ញុំនឹងមានពួកគេ.
2:11 ព្រះអម្ចាស់នឹងមានលើពួកគេមួយភ័យរន្ធត់, ហើយគាត់នឹងកាត់បន្ថយព្រះទាំងអស់នៅលើផែនដី.
2:12 ទោះ អញ្ចឹង ក្ដី, អ្នកអេត្យូពី, អ្នកនឹងត្រូវបានប្រតិបត្តិដោយមុខដាវរបស់ខ្ញុំ.
ហើយគាត់នឹងកំណត់ស្រស់ស្អាតនៅវាលរហោស្ថាន, ហើយនៅក្នុងកន្លែងឥតដំនើ, និងដូចជាវាលខ្សាច់មួយ.
អស់អ្នកដែលបានឆ្លងតាមរយៈការរបស់នាងនឹងអារម្មណ៍និងនាំគ្នាគ្រវីដៃរបស់ពួកគេ.
ចៅក្រមរបស់នាងគឺជាសត្វចចកល្ងាច; ពួកគេបានចាកចេញពីអ្វីសោះសម្រាប់ពេលព្រឹក.
ពួកបូជាចារ្យរបស់នាងបានបំពុលអ្វីដែលបរិសុទ្ធ; ពួកគេបានប្រព្រឹត្ដអំពើទុច្ចរិតប្រឆាំងនឹងច្បាប់នេះ.
នៅ ពេលព្រឹក, នៅ ពេលព្រឹក, លោកនឹងនាំមកនូវការវិនិច្ឆ័យរបស់គាត់ចូលទៅក្នុងពន្លឺ, ហើយវានឹងមិនត្រូវបានលាក់.
3:6 ខ្ញុំបានបំបែកប្រជាជាតិនានា, និងប៉មរបស់ពួកគេត្រូវរំលំ.
និងស្ថានរបស់នាងនឹងមិនវិនាសអន្ដរាយ, ទោះបីជាមានអ្វីទាំងអស់អំពីការដែលខ្ញុំបានជួបនាង.
3:8 ដោយ សារ តែ នេះ, សង្ឃឹមថាខ្ញុំ, ជា ព្រះបន្ទូល របស់ ព្រះអម្ចាស់, នៅថ្ងៃនៃការរស់ឡើងវិញរបស់ខ្ញុំនៅក្នុងពេលអនាគត, សម្រាប់ការវិនិច្ឆ័យរបស់ខ្ញុំគឺដើម្បីប្រមូលផ្តុំគ្នាពួកសាសន៍ដទៃ, និងដើម្បីប្រមូលនគរ, និងដើម្បីចាក់លើពួកគេកំហឹងរបស់ខ្ញុំ, កំហឹងកំហឹងទាំងអស់របស់ខ្ញុំ.
3:20 នៅក្នុងពេលវេលាដែលបាន, នៅពេលដែលខ្ញុំនឹងនាំឱ្យអ្នក, ហើយនៅក្នុងពេលវេលានៅពេលដែលខ្ញុំនឹងប្រមូលផ្តុំសម្រាប់អ្នក.
1:67 និងលោកសាការីជាឪពុករបស់គាត់ត្រូវបានពោរពេញទៅដោយព្រះវិញ្ញាណបរិសុទ្ធ.
1:69 ហើយគាត់បានលើកឡើងស្នែងនៃការសង្គ្រោះមួយសម្រាប់យើង, នៅក្នុងផ្ទះរបស់ព្រះបាទដាវីឌជាអ្នកបំរើរបស់ព្រះអង្គ,
1:71 ការសង្គ្រោះពីសត្រូវរបស់យើង, និងពីកណ្ដាប់ដៃរបស់អស់អ្នកដែលស្អប់យើង,
1:75 ភាពបរិសុទ្ធនៅក្នុងនិងនៅតុលាការមុនពេលគាត់, គ្រប់ថ្ងៃរបស់យើង.
សម្រាប់អ្នកនឹងទៅពីមុខរបស់ព្រះអម្ចាស់: ដើម្បីរៀបចំផ្លូវរបស់ព្រះអង្គ,
1:78 តាមរយៈបេះដូងនៃសេចក្ដីមេត្ដាករុណារបស់ព្រះនៃយើងបាន, ដែល, ចុះមកពីស្ថានខ្ពស់, គាត់បានមកលេងយើង,
10:10 ឬបទប្បញ្ញត្តិសម្រាប់ការធ្វើដំណើរនេះ, ឬយកអាវពីរ, ឬ ពាក់ ស្បែក ជើង, ឬបុគ្គលិក.
10:11 ឥឡូវ នេះ, ចូលទៅក្នុងក្រុងឬក្រុងណាដែលអ្នកនឹងបញ្ចូល, សួរដូចជាអ្នកដែលសមនឹងក្នុងវា.
ប៉ុន្តែប្រសិនបើគេមិនសមនឹងទទួល, សន្តិភាពរបស់អ្នកនឹងវិលមករកអ្នក.
10:19 ប៉ុន្តែនៅពេលដែលពួកគេបានបញ្ជូនអ្នក, មិនបានជ្រើសដើម្បីគិតអំពីរបៀបឬអ្វីដើម្បីនិយាយ.
និងកុមារលើកគ្នាប្រឆាំងនឹងឪពុកម្តាយនិងនាំមកនូវការស្តីពីការស្លាប់របស់ពួកគេ.
10:25 វាគឺជាការគ្រប់គ្រាន់សម្រាប់សិស្សចេះបានដូចគ្រូរបស់គាត់, និងអ្នកបំរើនោះបាន, ដូចគ្រូរបស់គាត់.
10:28 កុំខ្លាចអស់អ្នកដែលសម្លាប់បានត្រឹមតែរូបកាយ, ប៉ុន្តែមិនអាចសម្លាប់ព្រលឹងបាននោះ.
10:29 ត្រូវបានគេមិនលក់ចាបពីរកាក់តូចមួយសម្រាប់?
ខ្ញុំ បាន មក, មិនមែនដើម្បីសន្ដិភាព, ប៉ុន្តែដាវនេះ.
រីឯអ្នកដែលស្រឡាញ់កូនប្រុសឬកូនស្រីនៅពីលើខ្ញុំអ្នកនោះមិនសមនឹងធ្វើជាសិស្សរបស់ខ្ញុំ.
10:41 អ្នកណាទទួលព្យាការីម្នាក់, ក្នុងនាមលោកជាព្យាការីមួយ, នឹងទទួលរង្វាន់របស់ហោរា.
10:42 អ្នកណាអោយ, សូម្បីតែមួយនៃការយ៉ាងហោចណាស់ទាំងនេះ, ពែងនៃទឹកត្រជាក់ដើម្បីផឹក, ផ្អែកតែនៅក្នុងឈ្មោះរបស់សិស្ស: ខ្ញុំ សុំ ប្រាប់ អោយ អ្នក រាល់ គ្នា, លោកនឹងមិនត្រូវបានទទួលរង្វាន់ជាមិនខាន»។
ដ្បិត ព្រះអម្ចាស់ បាន និយាយ វា.
យើង បាន រង់ចាំ សម្រាប់ គាត់, ហើយ ព្រះអង្គ សង្គ្រោះ យើង.
ជួយសង្ស័យជឿ (ជាផ្នែកមួយ 1)
20:8 ហើយនៅពេលល្ងាចបានមកដល់, ម្ចាស់ចំការប្រាប់ទៅអ្នកកាន់, "ចូរហៅកម្មករនិងអ្នកបើកប្រាក់អោយគេ, ចាប់ពីចុងក្រោយនេះ, សូម្បីតែជាលើកដំបូង "។
20:10 បន្ទាប់មកនៅពេលមនុស្សដំបូងដែលបានចូលមកមុខ, ពួកគេបានចាត់ទុកថាពួកគេនឹងទទួលបានកាន់តែច្រើន.
ប៉ុន្តែដើម្បីអង្គុយនៅខាងស្ដាំខ្ញុំឬខាងឆ្វេងរបស់ខ្ញុំគឺជាការមិនអណ្តូងរ៉ែដើម្បីផ្តល់ដល់អ្នក, ប៉ុន្តែវាគឺសម្រាប់អ្នកដែលវាត្រូវបានរៀបចំដោយព្រះបិតារបស់ខ្ញុំ "។
20:25 ព្រះយេស៊ូត្រាស់ហៅពួកគេដើម្បីខ្លួនឯងនិងបាននិយាយថា:: "អ្នកដឹងថាជាលើកដំបូងនៅក្នុងចំណោមពួកសាសន៍ដទៃដែលជាអ្នកគ្រប់គ្រងរបស់ពួកគេ, ហើយថាអ្នកដែលមានអំណាចធ្វើលំហាត់ប្រាណកាន់តែច្រើនក្នុងចំណោមពួកគេ.
ប៉ុន្តែអ្នកណានឹងចង់ឱ្យមានកាន់តែច្រើននៅក្នុងចំណោមអ្នក, អនុញ្ញាតឱ្យគាត់ក្លាយជារដ្ឋមន្រ្តីរបស់អ្នក.
1:1 លោក ប៉ូល, ជាសាវ័ករបស់ព្រះគ្រិស្ដយេស៊ូស្របតាមព្រះហឫទ័យរបស់ព្រះជាម្ចាស់ដែរ, ទៅពួកបរិសុទ្ធទាំងអស់ដែលនៅក្រុងអេភេសូរនិងការជឿលើព្រះគ្រិស្ដយេស៊ូដែលជា.
1:3 សូម លើកតម្កើង ព្រះជាម្ចាស់ ជា ព្រះបិតា របស់ ព្រះយេស៊ូ គ្រិស្ដ ជា ព្រះអម្ចាស់ របស់ យើង, អ្នក ដែល បាន ប្រទាន ព្រះពរ គ្រប់យ៉ាង ផ្នែក ខាងវិញ្ញាណ ពី ស្ថាន បរមសុខ ជា ស្ថាន, នៅ ក្នុង ព្រះ គ្រិស្ដ,
1:9 ដូច្នេះតើលោកបានធ្វើឱ្យគេដឹងថាយើងអាថ៍កំបាំងនៃព្រះហឫទ័យរបស់ព្រះអង្គ, ដែលព្រះអង្គបានចែងទុកមកក្នុងអង្គព្រះគ្រិស្ដ, នៅក្នុងលក្ខណៈមួយដែលគាប់ព្រះហឫទ័យគាត់,
1:13 ក្នុង ព្រះអង្គ, អ្នក ផង ដែរ, បន្ទាប់ពីអ្នកបានឮនិងបានជឿថាព្រះបន្ទូលនៃសេចក្ដីពិត, ដែលជាដំណឹងល្អដែលសង្គ្រោះបងប្អូន, ត្រូវបានផ្សាភ្ជាប់ដោយព្រះវិញ្ញាណបរិសុទ្ធនៃការសន្យានេះ.
2:3 ហើយយើងផងដែរទាំងអស់នៅក្នុងការសន្ទនារឿងទាំងនេះ, នៅ ក្នុង ពេល កន្លង មក, ដោយសេចក្ដីប៉ងប្រាថ្នារបស់និស្ស័យលោកីយ៍របស់យើង, ការសម្ដែងតាមឆន្ទៈនៃនិស្ស័យលោកីយ៍នេះនិងបើយោងតាមគំនិតផ្ទាល់ខ្លួនរបស់យើង.
2:4 ប៉ុន្តែនៅតែ, ព្រះ ជា ម្ចាស់, ដែលជាសម្បូរទៅដោយសេចក្ដីមេត្ដាករុណា, សម្រាប់ជាប្រយោជន៍នៃសេចក្ដីសប្បុរសជាអតិបរមារបស់គាត់ជាមួយនឹងការដែលទ្រង់បានស្រឡាញ់យើង,
2:8 ដ្បិតគឺដោយព្រះគុណ, អ្នកបានត្រូវសង្គ្រោះតាមរយៈជំនឿ.
គាត់បានធ្វើពីរចូលទៅក្នុងនោះ, ដោយរំលាយជញ្ជាំងមធ្យមនៃការបំបែក, គណបក្សប្រឆាំង, ដោយសាច់គាត់,
ផ្ទុយ ទៅ វិញ, ប្រជា ពលរដ្ឋ នៅ ក្នុង ចំណោម អ្នក រាល់ គ្នា ជា ពួក អ្នក បរិសុទ្ធ នៅក្នុង គ្រួសារ របស់ ព្រះ ជា ម្ចាស់,
3:2 ឥឡូវនេះពិតណាស់, អ្នកបានឮគេនិយាយអំពីមុខងារនៃព្រះគុណរបស់ព្រះជាម្ចាស់, ដែលត្រូវបានប្រទានដល់ខ្ញុំក្នុងចំណោមអ្នក:
3:4 ប៉ុ ន្ដែ, ដោយការអាននេះយ៉ាងជិតស្និទ្ធ, អ្នកប្រហែលជាអាចយល់ពីការប្រុងប្រយ័ត្នរបស់ខ្ញុំនៅក្នុងលាក់កំបាំងរបស់ព្រះគ្រិស្ដ.
3:8 ទោះបីជាខ្ញុំជាអ្នកតូចជាងគេនៃពួកបរិសុទ្ធទាំងអស់, ខ្ញុំបានផ្ដល់ព្រះគុណនេះ: ការចេញទៅផ្សាយដំណឹងល្អនៅក្នុងចំណោមសាសន៍ដទៃទ្រព្យសម្បត្ដិប្រមាណមិនបានរបស់ព្រះគ្រិស្ដ,
4:32 និងសប្បុរសនិងអាណិតមេត្តាដល់គ្នាទៅវិញទៅមក, អភ័យទោសឱ្យគ្នាទៅវិញទៅមក, ដូចព្រះបានអភ័យទោសឱ្យអ្នកនៅក្នុងព្រះគ្រិស្ដ.
5:1 ហេតុនេះ ហើយ បាន ជា, ជាកូនជាទីស្រឡាញ់បំផុត, យកតំរាប់តាមព្រះជាម្ចាស់.
សម្រាប់រឿងទេព្រោះរបស់ទាំងនេះ, កំហឹងរបស់ព្រះត្រូវបានបញ្ជូនកូនចៅរបស់លោកគ្មានជំនឿលើការ.
5:8 ចំពោះអ្នកត្រូវបានគេទីងងឹត, នៅ ក្នុង ពេល កន្លង មក, តែឥឡូវនេះបងប្អូនជាពន្លឺ, នៅក្នុងព្រះអម្ចាស់.
5:13 ប៉ុន្តែអ្វីទាំងអស់ដែលត្រូវបានគេបានឃើញច្បាស់ជម្លោះដោយពន្លឺ.
ផ្ទុយ ទៅ វិញ, យល់ពីអ្វីដែលជាបំណងព្រះហឫទ័យនៃព្រះ.
ផ្ទុយ ទៅ វិញ, បានពោរពេញទៅដោយព្រះវិញ្ញាណបរិសុទ្ធ,
5:20 អរព្រះគុណតែងតែសម្រាប់អ្វីគ្រប់យ៉ាង, ក្នុងព្រះនាមនៃព្រះយេស៊ូវគ្រីស្ទជាព្រះអម្ចាស់របស់យើង, ព្រះជាម្ចាស់ជាព្រះបិតា.
គាត់គឺជាព្រះអង្គសង្គ្រោះនៃរាងកាយរបស់គាត់.
អ្នកណាស្រឡាញ់ភរិយាអ្នកនោះស្រឡាញ់ខ្លួនឯង.
5:33 ប៉ុ ន្ដែ ជា ការ ពិត, រាល់មួយនៃអ្នកគួរតែស្រឡាញ់ប្រពន្ធខ្លួនដូចជាខ្លួនឯងបាន.
6:9 ហើយ អ្នក, ស្ដេចត្រាញ់, ធ្វើសកម្មភាពដូចគ្នានេះដែរចំពោះពួកគេ, ការកំណត់ឡែកការគំរាម, ដោយដឹងថាព្រះអម្ចាស់នៃទាំងអ្នកនិងឱ្យពួកគេនៅស្ថានបរមសុខ.
6:10 ទាក់ទងនឹងការសល់, បង ប្អូន ប្រុស, ត្រូវបានពង្រឹងនៅក្នុងព្រះអម្ចាស់, ដោយអំណាចនៃដោយសារព្រះបារមីរបស់ព្រះអង្គ.
6:20 បែបនេះនៅក្នុងលក្ខណៈមួយដែលខ្ញុំអាចហ៊ាននិយាយការពិតប្រាកដដូចដែលខ្ញុំត្រូវនិយាយ.
6:21 ឥឡូវ នេះ, ដូច្នេះអ្នកអាចដឹងនូវអ្វីដែលទាក់ទងនឹងខ្ញុំនិងអ្វីដែលខ្ញុំកំពុងធ្វើ, លោកទីឃីកុស, បងប្រុសជាទីស្រឡាញ់បំផុតនិងជារដ្ឋមន្រ្តីក្រសួងស្មោះត្រង់ក្នុងព្រះអម្ចាស់, នឹងធ្វើឱ្យគេស្គាល់ថាអ្វីគ្រប់យ៉ាងដើម្បីអ្នក.
វាគឺជាការប្រហែលម៉ោងទីប្រាំមួយ.
ព្រះយេស៊ូមានព្រះបន្ទូលទៅនាងថា, «សូមឱ្យខ្ញុំផឹក "។
4:12 ច្បាស់ ណាស់, អ្នកគឺជាអ្នកមិនមែនជាធំជាងលោកយ៉ាកុបជាដូនតារបស់យើង, ដែលបានផ្ដល់ឱ្យយើងបានយ៉ាងល្អនិងអ្នកដែលផឹកពីវា, ជាមួយកូនប្រុសរបស់គាត់និងហ្វូងសត្វរបស់គាត់?"
រីឯអ្នកដែលផឹកពីទឹកដែលខ្ញុំនឹងអោយនោះនឹងមិនស្រេកទៀតសម្រាប់ភាពអស់កល្បជានិច្ច.
អ្នកបាននិយាយនៅក្នុងសេចក្ដីពិតនេះ»។
4:23 ប៉ុន្ដែដល់ពេលកំណត់ត្រូវបានយាងមក, ហើយឥឡូវនេះវាគឺ, ពេលដែលអ្នកថ្វាយបង្គំពិតជាព្រះបិតានឹងថ្វាយបង្គំតាមវិញ្ញាណនិងតាមសេចក្ដីពិត.
4:25 ស្ត្រីម្នាក់នេះបាននិយាយទៅគាត់ថា: «ខ្ញុំដឹងថាព្រះមេស្ស៊ីត្រូវបានយាងមក (ដែលត្រូវបានគេហៅថាជាព្រះគ្រិស្ដ).
ហើយពួកគេឆ្ងល់ថាគាត់កំពុងនិយាយជាមួយស្ដ្រីនេះ.
4:28 ដូច្នេះហើយស្ត្រីម្នាក់ដែលបានចាកចេញពីក្រោយរបស់នាងនិងទឹកពាងនាំគ្នាចូលទៅទីក្រុង.
4:36 ចំពោះអ្នកច្រូតកាត់, ទទួលបានប្រាក់ឈ្នួលនិងប្រមូលផលទៅរកជីវិតអស់កល្បជានិច្ច, ដូច្នេះទាំងលោកអ្នកសាបព្រោះនិងអ្នកច្រូតកាត់បានសប្បាយរួមជាមួយគ្នា.
4:38 ខ្ញុំបានចាត់អ្នករាល់គ្នាអោយទៅច្រូតដែលអ្នកមិនបានធ្វើការងារ.
ហើយស្នាក់នៅទីនោះអស់រយៈពេលពីរថ្ងៃ.
17:1 ហើយ គាត់ បាន និយាយ ទៅ កាន់ ពួក សិស្ស: "វាគឺជាការមិនអាចទៅរួចទេដើម្បីកុំឱ្យកើតមានរឿងអាស្រូវ.
17:2 វានឹងជាការល្អប្រសើរជាងមុនសម្រាប់គាត់បើសិនជាត្បាល់កិនមួយត្រូវបានដាក់នៅជុំវិញករបស់គាត់ហើយគាត់ត្រូវបានគេទម្លាក់ទៅក្នុងសមុទ្រ, ជាងការនាំអោយវង្វេងនរណាម្នាក់ក្នុងចំណោមអ្នកតូចតាចនេះ.
សម្រាប់ មនុស្ស ជា ច្រើន, ខ្ញុំ បាន ប្រាប់ អ្នក, ខំចូលហើយមិនអាច.
13:26 បន្ទាប់មកអ្នកនឹងចាប់ផ្តើមក្នុងការនិយាយ, "យើងធ្លាប់បរិភោគក្នុងវត្តមានរបស់អ្នក, ហើយអ្នកបង្រៀននៅតាមផ្លូវរបស់យើង។
ឆ្ងាយពីទូលបង្គំទៅ, កម្មករអ្នកទាំងអស់នៃអំពើទុច្ចរិត!"
13:29 ហើយពួកគេនឹងមកដល់ពីខាងកើត, និងខាងលិច, និងខាងជើង, និងខាងត្បូង; ហើយពួកគេនឹងអង្គុយនៅក្នុងនគរនៃព្រះជាម្ចាស់.
4:12 កាលព្រះយេស៊ូជ្រាបដំណឹងថាលោកយ៉ូហានបានប្រគល់, លោកបានដកចូលទៅក្នុងស្រុកកាលីឡេ.
4:16 មនុស្សដែលត្រូវបានគេអង្គុយនៅក្នុងភាពងងឹតបានឃើញពន្លឺមួយយ៉ាងធំ.
ហើយទ្រង់ប្រោសពួកគេ.
លេចឡើង, និងការឆ្លងទន្លេយ័រដាន់នេះ, អ្នកនិងប្រជាជនទាំងអស់ជាមួយអ្នក, ចូលទៅក្នុងស្រុកដែលយើងនឹងឱ្យកូនចៅអ៊ីស្រាអែល.
1:4 មកពីវាលខ្សាច់និងពីប្រទេសលីបង់, សូម្បីតែទៅទន្លេអឺប្រាតធំ, ដីទាំងអស់នៃជនជាតិហេត, ដូចជានៅឆ្ងាយជាសមុទ្រផ្ទុយការកំណត់នៃព្រះអាទិត្យនេះ, នឹងត្រូវព្រំដែនរបស់អ្នក.
គ្រាន់តែជាខ្ញុំនៅជាមួយលោកម៉ូសេ, ដូច្នេះខ្ញុំនឹងនៅជាមួយអ្នក.
1:6 ត្រូវបានពង្រឹងនិងខ្ជាប់ខ្ជួន.
ដូច្នេះអ្នកអាចយល់បានទាំងអស់ដែលអ្នកគួរធ្វើ.
1:10 មេដឹកនាំលោកយ៉ូស្វេបានណែនាំប្រជាជនដែលនៅ, និយាយ ថា :: «ឆ្លងតាមរយៈការកណ្ដាលជំរំ, និងបង្គាប់ប្រជាជន, និង បាន និយាយ ថា:
សម្រាប់ថ្ងៃទីបីបន្ទាប់ពី, អ្នករាល់គ្នាត្រូវឆ្លងទន្លេយ័រដាន់, ហើយអ្នកនឹងចូលដូច្នេះជាការទៅវាយយកស្រុក, ដែលព្រះអម្ចាស់ជាព្រះរបស់អ្នកនឹងប្រទានអោយអ្នករាល់គ្នា "»។
ប៉ុន្ដែដូចជាសម្រាប់អ្នក, ឆ្លងដោយអាវុធ, មុនពេលដែលបងប្អូនរបស់អ្នក, អ្នកទាំងអស់គ្នាដែលមានកម្លាំងដៃ, និងការប្រយុទ្ធនៅលើក្នុងនាមរបស់ខ្លួន,
ដូច្នេះហើយអ្នកនឹងត្រូវបានត្រឡប់ទៅស្រុកកម្មសិទ្ធិរបស់អ្នក.
1:16 ពួកគេឆ្លើយទៅលោកយ៉ូស្វេ, ហើយ ពួក គេ បាន និយាយ ថា :: "ទាំងអស់ដែលអ្នកបានណែនាំដល់ពួកយើង, យើងត្រូវធ្វើ.
1:17 យើងគ្រាន់តែជាស្ដាប់តាមលោកម៉ូសេក្នុងគ្រប់ការទាំងអស់, ដូច្នេះយើងនឹងស្ដាប់បង្គាប់អ្នកផងដែរ.
1:18 អ្នកណានឹងផ្ទុយមាត់របស់អ្នក, ហើយអ្នកណានឹងមិនគោរពតាមទាំងអស់នៃពាក្យរបស់អ្នក, ដែលអ្នកនឹងបង្រៀនទៅគាត់, អនុញ្ញាតឱ្យគាត់ស្លាប់.
2:3 ស្ដេចក្រុងយេរីខូចាត់គេអោយទៅនាងរ៉ាហាប, និយាយ ថា :: «ចូរនាំពួកដែលបានចូលមកដល់អ្នករាល់គ្នា, និងអ្នកដែលបានចូលទៅក្នុងផ្ទះរបស់អ្នក.
2:5 ហើយនៅពេលដែលទ្វារត្រូវបានបិទ, ពួកគេបានចេញទៅក្រៅជាមួយគ្នានៅក្នុងភាពងងឹត.
2:7 ប៉ុន្ដែអ្នកដែលគេបានចាត់ឱ្យដេញតាមពួកគេនៅតាមផ្លូវដែលនាំឱ្យក្រុមហ៊ុន Ford ទន្លេយ័រដាន់នេះ.
2:8 អ្នកដែលត្រូវបានលាក់ខ្លួនមិនបានធ្លាក់ចុះនៅឡើយទេដេកលក់, ហើយ មើល ចុះ, ស្ត្រីម្នាក់នេះបានឡើងទៅកាន់ពួកគេ, ហើយ នាង បាន និយាយ ថា ::
2:11 ហើយនៅពេលឮសេចក្ដីទាំងនេះ, យើងភ័យខ្លាចជាខ្លាំង, និងបេះដូងរបស់យើងចុះខ្សោយ.
ដ្បិតព្រះអម្ចាស់ជាព្រះរបស់អ្នកគឺជាព្រះខ្លាំងណាស់នៅក្នុងលើមេឃនិងនៅលើផែនដីដូចខាងក្រោម.
និងអាចជាអ្នកផ្តល់ឱ្យខ្ញុំជាសញ្ញាពិត
2:15 ហេតុនេះ ហើយ បាន ជា, នាងបានចាត់គេអោយចុះពីបង្អួចមួយជាមួយនឹងខ្សែ.
ហើយបន្ទាប់មកអ្នកនឹងទៅនៅលើផ្លូវរបស់អ្នក "។
2:18 ប្រសិន បើ មាន, នៅពេលដែលយើងចូលទៅក្នុងស្រុកនេះ, ខ្សែនេះសម្បុរត្រូវបានដាក់ជាសញ្ញាមួយ, ហើយអ្នកបានចងវានៅក្នុងបង្អួចដែលអ្នកអនុញ្ញាតឱ្យយើងចុះ.
2:19 អ្នកណានឹងបានចេញពីមាត់ទ្វារផ្ទះរបស់អ្នក, ឈាមរបស់គាត់នឹងត្រូវនៅលើក្បាលរបស់គាត់ផ្ទាល់, ហើយយើងនឹង uninvolved.
2:22 និង ការ ពិត ប្រាកដ, ដើរលើ, ពួកគេបានមកដល់នៅលើភ្នំ, ហើយស្នាក់នៅទីនោះចំនួនបីថ្ងៃ, រហូតដល់អស់អ្នកដែលត្រូវបានគេដេញតាមពួកគេត្រឡប់មកវិញ.
2:23 ហើយនៅពេលដែលពួកគេបានវិលត្រឡប់ចូលទៅក្នុងក្រុងនេះ, ការរុករករ៉ែនេះបានចុះពីភ្នំ.
3:1 ដូច្នេះ ហើយ, លោកយ៉ូស្វេក្រោកនៅពេលយប់, ហើយគាត់បានផ្លាស់ប្តូរជំរំ.
3:7 ព្រះអម្ចាស់មានព្រះបន្ទូលមកកាន់លោកយ៉ូស្វេ: «ថ្ងៃនេះខ្ញុំនឹងចាប់ផ្តើមដើម្បីលើកតម្កើងអ្នកនៅចំពោះមុខជនជាតិអ៊ីស្រាអែលទាំងអស់, ដូច្នេះពួកគេអាចដឹងថា, គ្រាន់តែជាខ្ញុំនៅជាមួយលោកម៉ូសេ, ដូច្នេះផងដែរថាខ្ញុំនៅជាមួយអ្នករាល់គ្នា.
3:9 លោកយ៉ូស្វេបញ្ជាទៅអ៊ីស្រាអែល, «វិធីសាស្រ្តក្នុងការនៅទីនេះ, និងស្តាប់ព្រះបន្ទូលរបស់ព្រះអម្ចាស់ជាព្រះរបស់អ្នក»។
3:11 មើល ចុះ !, ហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់នៃផែនដីទាំងមូលនឹងទៅមុនពេលដែលអ្នកបានតាមរយៈទន្លេយ័រដាន់.
3:13 ហើយនៅពេលដែលពួកបូជាចារ្យដែលត្រូវបានគេសែងហិបរបស់ព្រះអម្ចាស់, ជាព្រះនៃផែនដីទាំងមូល, នឹងបានដាក់ជំហានជើងរបស់ពួកគេនៅក្នុងទឹកនៃទន្លេយ័រដាន់, ដែនទឹកដែលមានទាបជាងនឹងរត់ចុះហើយរលាយបាត់, ហើយអស់អ្នកដែលកំពុងខិតជិតខាងលើនេះនឹងឈរនៅជាមួយគ្នានៅក្នុងទ្រង់ទ្រាយធំមួយ "។
3:16 ដែនទឹកចុះនៅតែឈរនៅមួយកន្លែង, និង, ការហើមឡើងដូចភ្នំ, ពួកគេត្រូវបានគេមើលឃើញពីឆ្ងាយ, ពីទីក្រុងដែលត្រូវបានគេហៅថាអាដាម, ទោះជានៅឆ្ងាយដូចជាកន្លែងនៃ Zarethan នេះ.
3:17 បន្ទាប់មកប្រជាជនបានកើនទល់មុខក្រុងយេរីខូ.
4:4 និងលោកយ៉ូស្វេហៅបុរសដប់ពីរនាក់, ដែលព្រះអង្គបានជ្រើសរើសពីអ៊ីស្រាអែល, មួយពីកុលសម្ព័ន្ធគ្នា,
4:8 ហេតុនេះ ហើយ បាន ជា, អ៊ីស្រាអែលបានធ្វើសេចក្តីដែលលោកយ៉ូស្វេបង្គាប់ពួកគេ, ថ្មដប់ពីរដុំពីការដឹកកណ្ដាលទន្លេយ័រដាន់ឆានែលនេះ, គ្រាន់តែដូចព្រះអម្ចាស់បានបញ្ជាឱ្យគាត់, នេះបើយោងតាមចំនួនកូនចៅអ៊ីស្រាអែល, ដូចជានៅឆ្ងាយជាកន្លែងដែលពួកគេបានធ្វើការបោះជំរុំនេះ, ហើយនៅទីនោះពួកគេបានឈរជើងពួកគេ.
4:10 ឥឡូវនេះក្រុមបូជាចារ្យដែលសែងហិបនាំគ្នាឈប់នៅកណ្ដាលទន្លេយ័រដាន់, អ្វីគ្រប់យ៉ាងត្រូវបានសម្រេចរហូតដល់ថ្ងៃដែលព្រះអម្ចាស់បានណែនាំលោកយ៉ូស្វេក្នុងការនិយាយទៅកាន់មនុស្សនិងការដែលលោកម៉ូសេបាននិយាយទៅគាត់ថា.
4:11 ហើយនៅពេលដែលពួកគេបានឆ្លងកាត់ទាំងអស់, ហិបរបស់ព្រះអម្ចាស់ផងដែរបានឆ្លងកាត់, ពួកបូជាចារ្យបានកើនឡើងមុនពេលដែលប្រជាជន.
4:23 ដ្បិតព្រះអម្ចាស់ជាព្រះរបស់អ្នកបានរីងស្ងួតដែនទឹករបស់ខ្លួននៅក្នុងការមើលឃើញរបស់អ្នក, រហូតដល់អ្នកឆ្លង,
4:25 ដូច្នេះប្រជាជនទាំងអស់នៅលើផែនដីអាចរៀនពីដៃមានអនុភាពខ្លាំងណាស់របស់ព្រះអម្ចាស់.
ប៉ុន្តែមនុស្សដែលបានកើតនៅវាលរហោស្ថាន,
ពួកគេជាសាសន៍មិនកាត់ស្បែកសម្រាប់, គ្រាន់តែជាពួកគេត្រូវបានកើត, និងគ្មាននរណាម្នាក់បានទទួលពិធីកាត់ស្បែកឱ្យពួកគេតាមផ្លូវ.
5:13 ហើយនៅពេលដែលលោកយ៉ូស្វេនៅក្នុងវាលនៃក្រុងយេរីខូនេះ, លោកបានលើកឡើងភ្នែករបស់គាត់, ព្រះអង្គទតឃើញបុរសម្នាក់ឈរនៅទល់មុខលោក, កាន់ដាវគូរ.
5:15 លោកយ៉ូស្វេក្រាបនៅលើដីដែលងាយ.
6:2 ព្រះអម្ចាស់មានព្រះបន្ទូលមកកាន់លោកយ៉ូស្វេ: « មើល !, យើងបានប្រគល់ក្រុងយេរីខូចូលទៅក្នុងកណ្ដាប់ដៃរបស់អ្នក, ជាមួយស្តេចនិងបុរសខ្លាំងរបស់ខ្លួនទាំងអស់.
6:4 បន្ទាប់ មក, នៅថ្ងៃទីប្រាំពីរ, ពួកបូជាចារ្យត្រូវយកត្រែទាំងប្រាំពីរ, ដែលត្រូវបានប្រើនៅលើមេត្តាករុណា, ហើយពួកគេនឹងត្រូវដើរមុនហិបនៃសម្ពន្ធមេត្រីនេះ.
6:5 ហើយនៅពេលដែលសំឡេងត្រែសំឡេងយូរជាងហើយជាមួយនឹងការរំខាន, ហើយវាបានបង្កើនក្នុងត្រចៀករបស់អ្នក, បន្ទាប់មកប្រជាជនទាំងអស់នឹងស្រែកអង្វររួមគ្នាជាមួយនឹងការស្រែកខ្លាំងណាស់, និងជញ្ជាំងនៃទីក្រុងនេះនឹងត្រូវធ្លាក់ទៅក្នុងគ្រឹះ, ហើយពួកគេនឹងបញ្ចូលវា, ផ្ទុយគ្នាពីកន្លែងមួយជាកន្លែងដែលពួកគេកំពុងឈរ "។
6:7 លោកបានមានប្រសាសន៍ទៅកាន់ប្រជាជន, « ចូរ ទៅ, និងគូសទីក្រុង, ប្រដាប់អាវុធ, មុនហិបរបស់ព្រះអម្ចាស់បាន»។
6:13 និងពួកគេបានយកទាំងប្រាំពីរនេះត្រែប្រាំពីរ, ដែលត្រូវបានប្រើនៅក្នុងការមេត្តាករុណា, ហើយពួកគេបានបន្តដង្ហែហិបរបស់ព្រះអម្ចាស់, ការដើរនិងការផ្លុំស្នែង.
6:14 ហើយពួកគេបានគូសរង្វង់ទីក្រុងនៅថ្ងៃទីពីរនេះ, ម្តង, ហើយពួកគេបានវិលត្រឡប់ទៅជំរំ.
6:15 បន្ទាប់ មក, នៅថ្ងៃទីប្រាំពីរ, ការកើនឡើងនៅក្នុងពន្លឺដំបូង, ពួកគេបានគូសរង្វង់ទីក្រុង, គ្រាន់តែជាការត្រូវបានគេបញ្ជាឱ្យ, ប្រាំពីរដង.
ដ្បិតព្រះអម្ចាស់បានប្រគល់ទីក្រុងដែលមានដល់អ្នក.
នាងរ៉ាហាបជាស្រីពេស្យាតែអាចរស់នៅ, ជាមួយអស់អ្នកដែលនៅជាមួយនាងនៅក្នុងផ្ទះ.
6:20 ហេតុនេះ ហើយ បាន ជា, ជាមួយនឹងមនុស្សទាំងអស់ស្រែក, ត្រែ blaring, បន្ទាប់ពីសំឡេងនិងសំឡេងកើនឡើងនៅក្នុងត្រចៀករបស់បណ្ដាជន, ជញ្ជាំងភ្លាមបានធ្លាក់ទៅអន្ដរាយ.
ដូចគ្នា នេះ ដែរ, គោនិងចៀមនិងលា, ពួកគេប្រហារដោយមុខដាវនេះ.
6:25 ប៉ុ ន្ដែ ជា ការ ពិត, នាងរ៉ាហាបជាស្ដ្រីពេស្យាលោកយ៉ូស្វេបានបណ្តាលឱ្យការ, និងក្រុមគ្រួសាររបស់ឪពុកនាង, ហើយនាងទាំងអស់មាន, ដើម្បីរស់.
ដ្បិតនាងបានលាក់ទុកអ្នកនាំសារ, ដែលព្រះអង្គបានចាត់អោយមកដើម្បីស្វែងរកក្រុងយេរីខូ.
6:26 "បណ្តាសានៅចំពោះព្រះអម្ចាស់គឺបុរសដែលនឹងបង្កើនឡើងនិងបានកសាងឡើងវិញក្រុងយេរីខូ!
7:1 ប៉ុន្តែអ៊ីស្រាអែលធ្វើខុសនឹងបទបញ្ជានេះ, ហើយពួកគេអំណាចអ្វីដែលជាត្រូវបណ្ដាសាបែក.
ហេតុអ្វីបានជាមនុស្សទាំងអស់គួរត្រូវតប់ប្រមល់ដោយគ្មានមូលហេតុអ្វីប្រឆាំងនឹងសត្រូវដែលមានដូច្នេះតិចតួចណាស់?"
និងសាមសិបប្រាំមួយនៃពួកគេបានធ្លាក់ចុះបុរស.
ហើយពួកគេបានកាប់ពួកគេខណៈដែលពួកគេត្រូវបានភៀសខ្លួនចេញពីការធ្លាក់ចុះ.
7:6 និង ការ ពិត ប្រាកដ, លោកយ៉ូស្វេបានហែកសម្លៀកបំពាក់របស់គាត់, ហើយគាត់បានធ្លាក់ចុះនៅលើដីដែលងាយខាងមុខហិបរបស់ព្រះអម្ចាស់, សូម្បីតែរហូតដល់ល្ងាច, ទាំងលោកនិងពួកព្រឹទ្ធាចារ្យទាំងអស់របស់ជនជាតិអ៊ីស្រាអែល.
ខ្ញុំចង់បញ្ជាក់ថាយើងនៅតែលើសពីទន្លេយ័រដាន់, នៅពេលដែលយើងចាប់ផ្តើមជាការ.
7:9 ជនជាតិកាណាននិងប្រជាជនទាំងអស់នៅស្រុកនេះនឹងឮពីវា, និងបានចូលមករួមគ្នាជាមួយ, ពួកគេនឹងឡោមព័ទ្ធយើង, ហើយពួកគេនឹងលុបឈ្មោះរបស់យើងពីផែនដី.
ហើយអ្នកនឹងនិយាយទៅកាន់ពួកគេ: <ចូរថ្ងៃស្អែកញែកជាបរិសុទ្ធ.
អ្នកគឺជាអ្នកមិនអាចឈរនៅចំពោះមុខខ្មាំងសត្រូវរបស់អ្នក, រហូតដល់គាត់ដែលត្រូវបានគេកខ្វក់ដោយអំពើអាក្រក់នេះត្រូវបាននាំយកទៅឆ្ងាយពីអ្នក។ "
7:17 ហើយនៅពេលដែលក្រុមគ្រួសាររបស់ខ្លួនត្រូវបានធ្វើបទបង្ហាញ, ក្រុមគ្រួសាររបស់លោកសេរ៉ាសត្រូវបានរកឃើញ.
7:18 និងបែងចែកផ្ទះរបស់គាត់ដោយបុរសម្នាក់គ្នា, គាត់បានរកឃើញលោកអេកាន, កូនរបស់លោកកើមីនេះ, កូនរបស់លោកសាបឌីចូលបាន, កូនរបស់លោកសេរ៉ាសបាន, ពីកុលសម្ព័ន្ធយូដា.
អ្នកមិនអាចលាក់វា "។
7:21 ខ្ញុំបានឃើញក្នុងចំណោមរង្វាន់អាវធំមួយល្អខ្លាំងណាស់ក្រហម, និងពីររយតម្លឹង, និងរបារមាសហាសិបតម្លឹង.
និងអ្វីទាំងអស់ដែលត្រូវបានប្រើប្រាស់ដោយរបស់គាត់ត្រូវបានភ្លើងឆេះ.
និងកំហឹងរបស់ព្រះអម្ចាស់ត្រូវបានដោះស្រាយពីពួកគេ.
សូមបណ្ដាជនទាំងមូលនៃយុទ្ធជន, ហើយក្រោកឡើង, ឡើងទៅក្រុងអៃ.
8:2 ហើយអ្នកត្រូវប្រព្រឹត្តចំពោះក្រុងអៃយ, និងដើម្បីស្ដេចរបស់ខ្លួន, គ្រាន់តែជាអ្នកបានប្រព្រឹត្តចំពោះក្រុងយេរីខូ, និងដើម្បីស្ដេចរបស់ខ្លួន.
កំណត់ការវាយឆ្មក់ប្រឆាំងនឹងទីក្រុងដែលនៅពីក្រោយវាមួយ "។
អ្នកនឹងដកមិនឆ្ងាយ, និងអនុញ្ញាតឱ្យមនុស្សគ្រប់រូបត្រូវបានរៀបចំ.
ហើយនៅពេលដែលពួកគេចេញមកវាយយើង, យើងនឹងរត់និងបើកត្រឡប់មកវិញរបស់យើង, គ្រាន់តែជាការដែលយើងបានធ្វើពីមុន,
សម្រាប់ពួកគេនឹងគិតថាយើងកំពុងភៀសខ្លួនដូចមុន.
និងព្រះអម្ចាស់ជាព្រះរបស់នឹងប្រគល់វាទៅក្នុងដៃរបស់អ្នក.
ហើយអ្នកនឹងធ្វើការទាំងអស់ដែលខ្ញុំបានបញ្ជាឱ្យ "។
ប៉ុន្តែលោកយ៉ូស្វេនៅតែសម្រាប់យប់នោះនៅកណ្ដាលរបស់ប្រជាជន.
8:11 ហើយនៅពេលដែលពួកគេបានមកដល់, និងបានឡើងពីជ្រុងម្ខាងនៃទីក្រុង, ពួកគេបានឈរឆ្ពោះទៅរកការតំបន់ភាគខាងជើងនៃទីក្រុង.
8:12 ឥឡូវនេះគាត់បានជ្រើសរើសប្រាំពាន់នាក់, ហើយគាត់បានបានដាក់ពួកគេនៅក្នុងការវាយឆ្មក់នៅចន្លោះបេតអែលនិងក្រុងអៃ, នៅភាគខាងលិចនៃទីក្រុងមួយផ្នែកដូចគ្នានេះដែរ.
បន្ទាប់មកលោកយ៉ូស្វេបានចេញទៅក្រៅនៅយប់នោះ, ហើយគាត់បានឈរនៅពាក់កណ្តាលជ្រលងភ្នំ.
ហើយគាត់បានរៀបចំឱ្យពួកគេនៅក្នុងបន្ទាត់ផ្ទុយវាលខ្សាច់មួយ, មិនដឹងថាវាយឆ្មក់មួយដាក់លាក់នៅពីក្រោយត្រឡប់មកវិញរបស់គាត់.
8:16 ហើយពួកគេបានដេញតាម, ស្រែកជាមួយគ្នានិងលើកទឹកចិត្ដគ្នាទៅវិញទៅមក.
យើងនឹងប្រគល់វាទៅអ្នក "។
ហេតុនេះ ហើយ បាន ជា, ចាប់តាំងពីការប្រឆាំងត្រូវបានកាត់ផ្តាច់ពីភាគីទាំងពីរ, គ្មាននរណាម្នាក់ក្នុងចំណោមបណ្ដាជនយ៉ាងខ្លាំងបានសង្រ្គោះ.
8:26 ដឹងច្បាស់លោកយ៉ូស្វេឥតទម្លាក់ដៃរបស់គាត់, ដែលលោកបានលាតសន្ធឹងនៅលើខ្ពស់, ការរក្សាបានកាន់ខែលនេះរហូតដល់ប្រជាជនទាំងអស់នៅក្រុងអៃត្រូវបានគេដាក់ឱ្យស្លាប់.
8:28 ហើយគាត់បានដុតទីក្រុង, ហើយគាត់បណ្តាលឱ្យវាទៅជាផ្នូរងូត.
និងយ៉ូស្វេបានណែនាំ, ហើយពួកគេបានយកសាកសពចុះពីដើមឈើស្លាប់របស់គាត់ព្យួរនេះ.
8:30 លោកយ៉ូស្វេសង់អាសនៈថ្វាយព្រះអម្ចាស់, ព្រះ របស់ ជនជាតិ អ៊ីស្រាអែល, នៅលើភ្នំអេបាល,
8:33 បន្ទាប់មកប្រជាជនទាំងអស់, និងអ្នកកាន់តែច្រើនពីកំណើត, និងមេបញ្ជាការនិងចៅក្រមត្រូវបានគេឈរនៅលើភាគីទាំងពីរនៃទូកធំ, នៅចំពោះមុខក្រុមបូជាចារ្យដែលសែងហិបនៃសម្ពន្ធមេត្រីរបស់ព្រះអម្ចាស់នេះ, ជាមួយនឹងការមកដល់ថ្មីទាំងនោះបានកើតនិងមានដើមកំណើត, ផ្នែកពាក់កណ្តាលនៃពួកគេនៅក្បែរមួយនៅលើភ្នំកេរិស៊ីម, និងមួយពាក់កណ្តាលនៅក្បែរភ្នំអេបាល, ដូចលោកម៉ូសេ, ជាអ្នកបម្រើរបស់ព្រះអម្ចាស់, បានណែនាំ.
9:6 ហើយពួកគេបានធ្វើដំណើរទៅជួបលោកយ៉ូស្វេ, ដែលនៅពេលនោះត្រូវបានគេស្នាក់នៅក្នុងជំរំនៅគីលកាល់.
ដ្បិតយើងបានឮអំពីកិត្តិនាមនៃអំណាចរបស់គាត់, អ្វីទាំងអស់ដែលគាត់បានធ្វើនៅក្នុងប្រទេសអេហ្ស៊ីប,
ឥឡូវនេះពួកគេបានក្លាយទៅជាស្ងួតនិងការខូច, ដោយសារតែដល់អាយុ.
សម្លៀកបំពាក់ដែលយើងកំពុងពាក់, និងស្បែកជើងដែលយើងមាននៅលើជើងរបស់យើង, ដោយសារតែប្រវែងអស្ចារ្យនៃចម្ងាយ, មានក្លាយទៅជាពាក់និងត្រូវបានប្រើប្រាស់ជិត "។
9:15 និងបានធ្វើឱ្យមានសន្ដិភាពជាមួយលោកយ៉ូស្វេពួកគេ, និងការចូលក្នុងកិច្ចព្រមព្រៀងមួយ, លោកបានសន្យាថាពួកគេនឹងមិនត្រូវបានដាក់ឱ្យស្លាប់.
9:18 ហើយពួកគេមិនបានធ្វើកូដកម្មពួកគេ, ដោយសារតែមេដឹកនាំរបស់បណ្ដាជនបានសន្យាជាមួយពួកគេក្នុងព្រះនាមនៃព្រះអម្ចាស់នោះ, ព្រះ របស់ ជនជាតិ អ៊ីស្រាអែល.
9:19 ហើយពួកគេបានឆ្លើយតបទៅពួកគេ: «យើងបានសច្ចាជាមួយគេក្នុងព្រះនាមរបស់ព្រះអម្ចាស់, ព្រះ របស់ ជនជាតិ អ៊ីស្រាអែល, និងសម្រាប់ហេតុផលថា, យើងមិនអាចប៉ះពាល់ពួកគេ.
9:21 ប៉ុន្តែបើទោះបីជាពួកគេបានរស់, អនុញ្ញាតឱ្យពួកគេបម្រើបណ្ដាជនទាំងមូលដោយកាត់ឈើនិងដឹកទឹក។ "នៅខណៈពេលដែលពួកគេត្រូវបានពិភាក្សាអំពីហេតុការណ៍ទាំងនេះ,
ប្រព្រឹត្ដចំពោះពួកយើងដូចដែលវាហាក់ដូចជាល្អនិងត្រឹមត្រូវដល់អ្នក»។
ចំពោះក្រុងគីបៀនជាក្រុងធំ, និងជាផ្នែកមួយនៃទីក្រុងរាជវង្ស, និងជាធំជាងក្រុងអៃ, និងអ្នកចម្បាំងរបស់ខ្លួនទាំងអស់ត្រូវបានគេខ្លាំងណាស់.
10:4 "ឡើងចំពោះខ្ញុំ, និងនាំយកមកកងទ័ព, ដូច្នេះយើងអាចប្រយុទ្ធប្រឆាំងនឹងក្រុងគីបៀន.
10:5 ដូច្នេះ ហើយ, បានជួបប្រជុំគ្នានៅ, ស្ដេចទាំងប្រាំនៃជនជាតិអាម៉ូរី, ស្តេចក្រុងយេរូសាឡឹម, ស្តេចក្រុងហេប្រូន, ស្ដេចនៃ Jarmuth នេះ, ស្ដេចនៃក្រុងឡាគីស, ស្តេចក្រុងអេក្លូននេះ, រួមគ្នាជាមួយនឹងកងទ័ពរបស់គេ, បានកើនឡើងនៅជុំវិញក្រុងគីបៀនហើយបោះទ័ព, ដាក់ឡោមព័ទ្ធទៅវា.
ហើយពួកគេពោលទៅគាត់ថា: «សូមឱ្យអ្នកមិនគូរត្រឡប់មកវិញដៃរបស់អ្នកពីការជួយអ្នកបំរើរបស់ព្រះអង្គ.
ចំពោះស្តេចទាំងប៉ុន្មាននៃជនជាតិអាម៉ូរី, ដែលរស់នៅលើភ្នំ, បានប្រមូលផ្តុំគ្នាប្រឆាំងនឹងយើង»។
10:8 ព្រះអម្ចាស់មានព្រះបន្ទូលមកកាន់លោកយ៉ូស្វេ: "អ្នកមិនគួរខ្លាចពួកគេ.
គ្មានពួកគេនឹងអាចទប់ទល់នឹងអ្នក "។
10:10 ព្រះអម្ចាស់បានកំណត់ពួកវានៅក្នុងភាពច្របូកច្របល់មុខអ៊ីស្រាអែល.
10:13 និងព្រះអាទិត្យនិងព្រះច័ន្ទឈរនៅតែមាន, រហូតដល់ប្រជាជនបានសងសឹកដោយខ្លួនឯងនៃសត្រូវរបស់គេ.
ដូច្នេះហើយព្រះអាទិត្យនៅតែឈរនៅកណ្តាលនៃស្ថានបរមសុខ, ហើយវាមិនប្រញាប់ទៅនៅសល់របស់ខ្លួនសម្រាប់ទំហំនៃការមួយថ្ងៃ.
10:15 លោកយ៉ូស្វេ, ជាមួយនឹងការទាំងអស់នៃជនជាតិអ៊ីស្រាអែល, ចូលទៅក្នុងជំរំគីលកាល់.
10:17 ហើយវាត្រូវបានគេរាយការណ៍ជូនលោកយ៉ូស្វេថាស្តេចទាំងប្រាំត្រូវបានគេរកឃើញថាបានលាក់នៅក្នុងគុហាមួយ, ជិតក្រុងម៉ាកេដា.
10:23 និងរដ្ឋមន្រ្តីបានធ្វើគ្រាន់តែជាការដែលពួកគេត្រូវបានគេបញ្ជាឱ្យ.
10:26 លោកយ៉ូស្វេបានវាយប្រហារពួកគេចុះនិងបានសម្លាប់ពួកគេ, ហើយគាត់បានផ្អាកពួកវានៅលើបង្គោលប្រាំ.
10:27 ហើយនៅពេលដែលព្រះអាទិត្យបានកំណត់, លោកបានណែនាំជំនួយការរបស់គាត់ថាពួកគេគួរតែទទួលយកពួកគេចុះពីបង្គោលនេះ.
10:28 ដូចគ្នានេះផងដែរនៅថ្ងៃដដែលនោះ, លោកយ៉ូស្វេបានរឹបអូសម៉ាកេដា, ហើយគាត់បានវាយប្រហារវាដោយមុខដាវនេះ, ហើយគាត់បានដាក់ឱ្យស្លាប់ស្ដេចនិងប្រជាជនទាំងអស់របស់ខ្លួន.
ហើយគាត់បានធ្វើចំពោះស្តេចក្រុងម៉ាកេដា, គ្រាន់តែជាការដែលគាត់បានធ្វើចំពោះស្តេចក្រុងយេរីខូ.
10:30 ហើយព្រះអម្ចាស់បានប្រគល់, ជាមួយស្តេចរបស់ខ្លួន, ទៅក្នុងកណ្ដាប់ដៃរបស់ជនជាតិអ៊ីស្រាអែល.
ពួកគេមិនចាកចេញនៅក្នុងវានៅសល់ណាមួយ.
10:32 និងបានប្រគល់ក្រុងឡាគីសព្រះអម្ចាស់ចូលទៅក្នុងកណ្ដាប់ដៃរបស់ជនជាតិអ៊ីស្រាអែល, ហើយគាត់បានរឹបអូសវានៅលើថ្ងៃដូចខាងក្រោម, ហើយគាត់បានវាយប្រហារវាដោយមុខដាវនេះ, និងព្រលឹងជារៀងរាល់ដែលមាននៅក្នុងនោះ, គ្រាន់តែជាការដែលគាត់បានធ្វើទៅក្រុងលីបណា.
លោកមិនបានចាកចេញពីនៅសល់ណាមួយនៅក្នុងវា.
និងការទាំងអស់ទីប្រជុំជនជុំវិញនោះ, លោកបានវាយប្រហារដោយមុខដាវនេះ.
គ្រាន់តែជាការដែលគាត់បានធ្វើទៅក្រុងហេប្រូននិងក្រុងលីបណា, និងដើម្បីស្ដេចរបស់ពួកគេ, ដូច្នេះតើគាត់បានធ្វើអ្វីដល់ក្រុងដេបៀរព្រមទាំងស្តេចរបស់ខ្លួន.
គាត់មិនបានទុកនៅក្នុងវានៅសល់ណាមួយ, ប៉ុន្តែលោកបានដាក់ឱ្យស្លាប់ទាំងអស់នោះគឺអាចដកដង្ហើម, គ្រាន់តែជាព្រះអម្ចាស់, ព្រះ របស់ ជនជាតិ អ៊ីស្រាអែល, បានណែនាំគាត់,
10:42 ស្ដេចរបស់ពួកគេទាំងអស់គ្នានិងតំបន់របស់ពួកគេ, លោកបានរឹបអូសនិងបំផ្លាញចោលនឹងការវាយប្រហារតែមួយ.
10:43 ហើយគាត់បានត្រឡប់មកវិញ, ជាមួយនឹងការទាំងអស់នៃជនជាតិអ៊ីស្រាអែល, ទៅកន្លែងជំរំនៅគីលកាល់ពីនោះ.
11:3 ផងដែរទៅស្រុកកាណាន, ពីខាងកើតទៅខាងលិច, និងដើម្បីជាតិអាម៉ូរី, និងជនជាតិហេត, និងពេរិស៊ីតបាន, និងជនជាតិយេប៊ូសនៅលើភ្នំ, ជនជាតិហេវីផងដែរក្នុងការធ្លាប់រស់នៅដែលមានមូលដ្ឋាននៃហ៊ើរម៉ូន, នៅស្រុកមីសប៉ា.
11:6 ព្រះអម្ចាស់មានព្រះបន្ទូលមកកាន់លោកយ៉ូស្វេ: "អ្នកមិនគួរខ្លាចពួកគេ.
អ្នកនឹងកាត់សរសៃជើងសេះ, ហើយអ្នកនឹងដុតរទេះចំបាំងរបស់គេចោលទៅ»។
11:8 ហើយព្រះអម្ចាស់បានប្រគល់ពួកគេទៅក្នុងកណ្ដាប់ដៃរបស់ជនជាតិអ៊ីស្រាអែល.
លោកបានវាយប្រហារពួកគេទាំងអស់, ដូច្នេះគ្មានអ្វីដែលត្រូវបានចាកចេញនៃពួកគេនឹងនៅតែមាន.
លោកកាប់សរសៃជើងសេះ, ហើយគាត់បានដុតរទេះចំបាំងរបស់គេភ្លើង.
ហើយគាត់បានប្រហារស្តេចរបស់ខ្លួនដោយមុខដាវ.
11:11 ហើយគាត់បានវាយប្រហារចុះព្រលឹងទាំងអស់ដែលត្រូវបានស្នាក់នៅទីនោះ.
11:12 ហើយគាត់បានរឹបអូស, វាយប្រហារ, និងបានបំផ្លាញទីក្រុងនៅជុំវិញទាំងអស់និងស្តេចរបស់ពួកគេ, ដូចលោកម៉ូសេ, អ្នកបំរើរបស់ព្រះជាម្ចាស់, បានណែនាំគាត់.
11:15 គ្រាន់តែដូចព្រះអម្ចាស់បានបង្គាប់ម៉ូសេជាអ្នកបំរើរបស់ព្រះអង្គ, ដូច្នេះបានជាលោកម៉ូសេបង្គាប់លោកយ៉ូស្វេ, ហើយគាត់បានបំពេញអ្វីគ្រប់យ៉ាង. លោកមិនបានលុបសូម្បីតែពាក្យមួយចេញពីបទបញ្ជា, លោកម៉ូសេដែលព្រះអម្ចាស់បានបង្គាប់មក.
11:19 គ្មានក្រុងដែលបានបញ្ជូនខ្លួនវាទៅកូនប្រុសរបស់អ៊ីស្រាអែល, លើកលែងតែជនជាតិហេវីដែលរស់នៅក្រុងគីបៀនបាន.
11:20 សម្រាប់វាជាទោសរបស់ព្រះអម្ចាស់ថាចិត្តរបស់ពួកគេនឹងត្រូវបាន hardened, ហើយថាពួកគេនឹងប្រយុទ្ធប្រឆាំងនឹងអ៊ីស្រាអែលនិងការដួលរលំ, ហើយថាពួកគេមិនសមនឹងទទួលបានវីធីណា, ហើយថាពួកគេត្រូវវិនាស, គ្រាន់តែជាការដែលព្រះអម្ចាស់បានបង្គាប់មកលោកម៉ូសេ.
11:22 លោកមិនបានចាកចេញពីណាមួយពីភាគហ៊ុនអណាក់នៅក្នុងទឹកដីរបស់កូនចៅអ៊ីស្រាអែល, លើកលែងតែក្រុងនានានៃតំបន់ហ្គាហ្សា, និងក្រុងកាថ, និងក្រុងអាសដូឌ, ដែលមានតែម្នាក់ឯងត្រូវបានចាកចេញពីក្រោយ.
12:1 ទាំងនេះគឺជាស្ដេចនានាដែលអ៊ីស្រាអែលបានវាយប្រហារចុះ, ហើយពួកគេបានកាន់កាប់ស្រុកដែលនៅខាងនាយទន្លេយ័រដាន់, ឆ្ពោះទៅរកការកើនឡើងនៃព្រះអាទិត្យ, ពីជ្រោះស្ទឹងអើណូនជានៅឆ្ងាយដូចភ្នំហ៊ើរម៉ូន, ជាមួយតំបន់ភាគខាងកើតទាំងមូលដែលមើលទៅចេញទៅវាលរហោស្ថាន:
លោកម៉ូសេបានប្រគល់ស្រុករបស់គេចូលទៅក្នុងការកាន់កាប់របស់កុលសម្ព័ន្ធរូបេននេះ, និងកុលសម្ព័ន្ធកាដ, និងកុលសម្ព័ន្ធម៉ាណាសេចំនួនពាក់កណ្ដាលមួយ.
និងលោកយ៉ូស្វេប្រគល់វាជាកម្មសិទ្ធិកុលសម្ព័ន្ធនៃអ៊ីស្រាអែល, ទៅមួយគ្នានៅក្នុងក្រុមរបស់ខ្លួន,
នៅជម្រាលចុះនេះ, និងនៅវាលរហោស្ថាន, ហើយនៅក្នុងភាគខាងត្បូង, នៅទីនោះផងដែរជាជនជាតិហេតនិងជាតិអាម៉ូរី, កាណានហើយពេរិស៊ីតបាន, ជនជាតិហេវីនិងជនជាតិយេប៊ូសដែលបាន.
13:4 យ៉ាងពិតប្រាកដ, ទៅភាគខាងត្បូងគឺជាជនជាតិហេវី, ដីកាណានទាំងអស់, និង Mearah អ្នកស្រុកស៊ីដូននៃ, ដូចជានៅឆ្ងាយដូចជាការអាផេកនិងព្រំដែននៃជនជាតិអាម៉ូរី
13:6 អស់អ្នកដែលរស់នៅលើភ្នំដែលបានមកពីប្រទេសលីបង់, ដូចជានៅឆ្ងាយដូចជាទឹកនៃ Misrephoth នេះ, និងអ្នកស្រុកស៊ីដូនទាំងអស់.
ហេតុនេះ ហើយ បាន ជា, អនុញ្ញាតឱ្យដីរបស់ពួកគេក្លាយជាផ្នែកមួយនៃមរតកអ៊ីស្រាអែល, ដូចខ្ញុំបានណែនាំអ្នក.
13:8 ជាមួយ ពូក គេ, រូបេននិងកុលសម្ព័ន្ធកាដបានកាន់កាប់, ដែលលោកម៉ូសេ, ជាអ្នកបម្រើរបស់ព្រះអម្ចាស់, បានបញ្ជូនទៅឱ្យពួកគេលើសពីទន្លេយ័រដាន់, នៅលើផ្នែកខាងភាគខាងកើត:
13:10 និងក្រុងទាំងប៉ុន្មានរបស់ស្ដេចស៊ីហុន, ស្ដេចរបស់ជនជាតិអាម៉ូរី, ដែលបានសោយរាជ្យនៅក្រុងហេសបូ, សូម្បីតែកូនចៅរបស់ព្រំដែនអាំម៉ូននេះ;
ផ្ទុយ ទៅ វិញ, ការលះបង់និងជនរងគ្រោះរបស់ព្រះអម្ចាស់, ព្រះ របស់ ជនជាតិ អ៊ីស្រាអែល, ទាំងនេះគឺជាមរតករបស់គាត់, គ្រាន់តែជាការដែលគាត់បាននិយាយទៅគាត់.
13:22 នោះពួកកូនចៅអ៊ីស្រាអែលបានសម្លាប់លោកបាឡាម, កូន របស់ លោក បេ អ៊ រ, គ្រូទាយ, ដោយមុខដាវ, រួមជាមួយនឹងអ្នកដទៃទៀតដែលត្រូវបានគេសម្លាប់.
13:30 ការចាប់ផ្តើមនៃការដែលនេះ: ពីក្រុងម៉ាហាណែម, ទាំងអស់នៃស្រុកបាសាន, ហើយទាំងអស់សាលក្រមស្ដេចនៃហើយ, ស្ដេចស្រុកបាសាន, និងភូមិទាំងអស់របស់លោកយ៉ាអៀរ, ដែលមាននៅស្រុកបាសាន, ទីប្រជុំជនហុកសិប;
13:32 លោកម៉ូសេបានចែកកម្មសិទ្ធិនេះ, នៅវាលទំនាបស្រុកម៉ូអាប់, លើសពីទន្លេយ័រដាន់, ទល់មុខក្រុងយេរីខូនៅលើផ្នែកខាងភាគខាងកើត.
ដ្បិតព្រះអម្ចាស់, ព្រះ របស់ ជនជាតិ អ៊ីស្រាអែល, គឺខ្លួនគាត់ផ្ទាល់កម្មសិទ្ធិរបស់ពួកគេ, គ្រាន់តែជាការដែលគាត់បាននិយាយទៅគាត់.
14:1 នេះគឺជាអ្វីដែលអ៊ីស្រាអែលបានកាន់កាប់នៅស្រុកកាណាន, ដែលមានលោកអេឡាសារ, លោកបូជាចារ្យ, និងយ៉ូស្វេ, កូនរបស់លោកនូន, និងមេដឹកនាំនៃក្រុមគ្រួសារនេះ, ដោយកុលសម្ព័ន្ធនៃជនជាតិអ៊ីស្រាអែល, ប្រទានអោយគេ,
14:6 ដូច្នេះ ហើយ, កូនរបស់លោកយូដាបានចូលទៅជិតលោកយ៉ូស្វេនៅគីលកាល់.
14:7 ខ្ញុំមានអាយុសែសិបឆ្នាំលោកម៉ូសេ, ជាអ្នកបម្រើរបស់ព្រះអម្ចាស់, បានចាត់ខ្ញុំពីកាដេស-បារនា, ដូច្នេះខ្ញុំអាចពិចារណាដីនេះ.
14:8 ប៉ុន្តែបងប្អូនរបស់ខ្ញុំ, អ្នកដែលឡើងជាមួយខ្ញុំ, បានបំបែកបេះដូងរបស់ប្រជាជន.
14:10 ហេតុនេះ ហើយ បាន ជា, ព្រះអម្ចាស់បានប្រទានជីវិតដល់ខ្ញុំ, ដូចលោកបានសន្យា, សូម្បីតែសព្វថ្ងៃ.
ថ្ងៃនេះ, ខ្ញុំមានអាយុប៉ែតសិបប្រាំឆ្នាំ,
ចិត្តរឹងប៉ឹងក្នុងខ្ញុំនៅពេលនោះសូម្បីតែរហូតដល់ថ្ងៃនេះបន្ត, ជាច្រើនដើម្បីប្រយុទ្ធប្រឆាំងនឹងជាការហែក្បួន.
ប្រហែលជាវាអាចនឹងមានថាព្រះអម្ចាស់នឹងគង់ជាមួយខ្ញុំ, ហើយខ្ញុំនឹងអាចបំផ្លាញពួកគេ, ដូចលោកបានសន្យាចំពោះខ្ញុំ»។
14:15 កាលពីមុន, ឈ្មោះក្រុងហេប្រូនត្រូវបានគេហៅថាគារយ៉ាត-អើបា.
និងដីនេះបានឈប់ពីការប្រយុទ្ធ.
15:5 ប៉ុ ន្ដែ ជា ការ ពិត, ខាង កើត, ចាប់ផ្តើមនេះនឹងក្លាយជាសមុទ្រប្រៃខ្លាំងណាស់, សូម្បីតែដែនកំណត់នៃទន្លេយ័រដាន់, អ្នកដែលមើលទៅឆ្ពោះទៅកាន់ភាគខាងជើង, ពីឈូងសមុទ្រ, សូម្បីតែទន្លេដូចគ្នានៅទន្លេយ័រដាន់.
15:7 ហើយវាបានឈានដល់ដូចជានៅឆ្ងាយដូចជាព្រំដែននៃ Debara នេះ, ពីជ្រលងភ្នំអាគ័រ, នៅភាគខាងជើង, សម្លឹងមើលឆ្ពោះទៅគីលកាល់, ដែលជាការផ្ទុយឡើងនៃ Adummim នេះ, នៅលើផ្នែកខាងត្បូងនៃជ្រោះ.
និងពីទីនោះ, វាបង្កើនដោយខ្លួនឯងទៅដល់កំពូលភ្នំ, ដែលជាផ្ទុយ Geennom ទៅភាគខាងលិច, នៅកំពូលនៃជ្រលងភ្នំរេផែមនេះ, នៅភាគខាងជើង.
ហើយវាឆ្លងកាត់តាមផ្នែកម្ខាងនៃភ្នំយារីម, នៅភាគខាងជើង, ចូលទៅក្នុង Chesalon.
15:11 ហើយវានៅតែបន្តនៅលើ, ឆ្ពោះទៅទិសខាងជើង, ទៅតំបន់មួយក្បែរក្រុងអេក្រូន.
15:13 ប៉ុ ន្ដែ ជា ការ ពិត, លោកកាលែប, កូនរបស់លោកយេភូនេ, គាត់បានផ្ដល់ឱ្យជាផ្នែកមួយនៅក្នុងការពួកកូនចៅយូដា, គ្រាន់តែដូចព្រះអម្ចាស់បានណែនាំគាត់: ទីក្រុងរបស់អើបានោះ, ឪពុករបស់លោកអណាក់, ដែលជាក្រុងហេប្រូន.
15:15 និងការឡើងបន្ថែមទៀតពីទីនោះ, គាត់បានចូលមកដល់ប្រជាជននៅក្រុងដេបៀរនេះ, ដែលពីមុនត្រូវបានគេហៅក្រុងគារយ៉ាត-សេភើរ, នោះ គឺ ជា ការ, ទីក្រុងនៃលិខិត.
15:17 និងលោកអូធ្នាល, កូនរបស់លោកកេណាសដែលមាន, ប្អូនប្រុសរបស់លោកកាលែប, រឹបអូសយកវា.
15:18 ពេលគេធ្វើដំណើររួមគ្នា, នាងត្រូវបានគេជម្រុញឱ្យប្ដីរបស់នាងថានាងបានសុំឱ្យឪពុករបស់នាងសម្រាប់វាលមួយ.
ទីក្រុងទាំងអស់នេះត្រូវបានគេម្ភៃប្រាំបួន, និងភូមិរបស់ពួកគេ.
15:44 និងក្រុងកៃឡានិងម៉ារីសាអាកស៊ីបនិង: បណ្តាទីក្រុងចំនួនប្រាំបួន, និងភូមិរបស់ពួកគេ.
តំបន់ហ្គាហ្សា, ដោយមានទីប្រជុំជននិងភូមិរបស់ខ្លួន, ដូចជានៅឆ្ងាយដូចជា torrent & # ស្រុកអេស៊ីប, ជាមួយនឹងមហាសមុទ្រដែលជាព្រំដែនរបស់ខ្លួន.
15:63 ប៉ុន្តែកូនរបស់លោកយូដាពុំអាចដើម្បីបំផ្លាញប្រជាជនជនជាតិយេប៊ូយេរូសាឡឹម.
16:3 ហើយវាបានចុះចតនៅភាគខាងលិច, នៅក្បែរព្រំដែននៃ Japhleti នេះ, ដូចជានៅឆ្ងាយដូចជាព្រំដែននៃទាបបេតហូរ៉ូនេះ, និងដើម្បីក្រុងកេស៊ើរ.
16:4 អេប្រាអ៊ីមនិងម៉ាណាសេនិង, កូនចៅរបស់លោកយ៉ូសែប, កាន់កាប់វា.
និងកម្មសិទ្ធិរបស់ពួកគេឆ្ពោះទៅកាន់ភាគខាងកើតនេះគឺបានមកពីអាថារ៉ូត-addar, ដូចជានៅឆ្ងាយដូចជាការបេតហូរ៉ូផ្នែកខាងលើ,
នេះជាកម្មសិទ្ធិរបស់កុលសម្ព័ន្ធអេប្រាអ៊ីមកូនចៅរបស់នេះ, ដោយក្រុមគ្រួសាររបស់ពួកគេ.
16:10 កូនចៅរបស់លោកអេប្រាអ៊ីមនិងដែលមិនបានដាក់ឱ្យស្លាប់ជនជាតិកាណានដែលត្រូវបានរស់នៅក្នុងក្រុងកេស៊ើរ.
17:4 ហើយពួកគេបានទៅមុនពេលការមើលឃើញនៃលោកអេឡាសារ, លោកបូជាចារ្យ, និងយ៉ូស្វេ, កូនរបស់លោកនូន, និងមេដឹកនាំ, និយាយ ថា :: «ព្រះអម្ចាស់ណែនាំដោយដៃរបស់លោកម៉ូសេដែលជាកម្មសិទ្ធិមួយគួរតែត្រូវបានផ្តល់ទៅឱ្យពួកយើង, នៅក្នុងចំណោមបងប្អូនរបស់យើងនេះ "។ ដូច្នេះហើយ, គាត់បានផ្ដល់ឱ្យទៅពួកគេ, តាមការបញ្ជារបស់ព្រះអម្ចាស់, កម្មសិទ្ធិនៅកណ្ដាលបងប្អូនរបស់ឪពុករបស់ពួកគេ.
17:6 ដូច្នេះហើយកូនស្រីរបស់ម៉ាណាសេដែលកាន់កាប់មរតកនៅកណ្តាលកូនប្រុសរបស់លោក.
17:8 សម្រាប់ការដោយច្រើន, នៅទីនោះផងដែរបានធ្លាក់ចុះដល់ព្រះបាទម៉ាណាសេដែលជាទឹកដីរបស់តាពួរ, ដែលនៅជិតព្រំដែនម៉ាណាសេ, និងដែលជាកម្មសិទ្ធិរបស់កូនចៅអេប្រាអ៊ីម.
ព្រំដែនរបស់ម៉ាណាសេគឺដើម្បីភាគខាងជើងនៃជ្រោះនេះ, ការចាកចេញរបស់ខ្លួនបានពង្រីកនិងសមុទ្រ.
17:15 លោកយ៉ូស្វេមានប្រសាសន៍ទៅពួកគេ, "ប្រសិនបើអ្នកជាប្រជាជនជាច្រើន, ឡើងទៅព្រៃ, និងកាត់ចេញកន្លែងសម្រាប់ខ្លួនអ្នកនៅក្នុងទឹកដីពេរីស៊ីតនិងស្រុករេផែនេះ, ចាប់តាំងពីការកាន់កាប់នៃភ្នំអេប្រាអ៊ីនេះគឺតូចចង្អៀតពេកសម្រាប់អ្នក "។
17:17 លោកយ៉ូស្វេបញ្ជាទៅផ្ទះរបស់លោកយ៉ូសែប, អេប្រាអ៊ីមនិងម៉ាណាសេ: "អ្នកជាមនុស្សជាច្រើន, ហើយអ្នកមានកម្លាំងខ្លាំង.
17:18 ផ្ទុយ ទៅ វិញ, អ្នករាល់គ្នានឹងឆ្លងទៅភ្នំនោះ, ហើយអ្នកនឹងកាត់បន្ថយនិងជម្រះសម្រាប់ទំហំដែលខ្លួនដែលនៅក្នុងការរស់នៅ.
18:2 ប៉ុន្តែមានកុលសម្ព័ន្ធប្រាំពីរនៃជនជាតិអ៊ីស្រាអែលដែលមិនទាន់បានទទួលនៅឡើយទេនៅតែទ្រព្យសម្បត្ដិរបស់ពួកគេ.
18:4 ជ្រើសបុរសបីនាក់ពីកុលសម្ព័ន្ធគ្នា, ដូច្នេះខ្ញុំអាចបញ្ជូនពួកគេ, ហើយពួកគេអាចទៅហើយរង្វង់កាត់ស្រុក, និងអាចរៀបរាប់អំពីវាតាមចំនួនបណ្ដាជនគ្នា, ហើយអាចនាំយកត្រឡប់មកវិញដើម្បីឱ្យខ្ញុំបានសរសេរអ្វីដែលពួកគេបានធ្លាក់ចុះ.
សូមអោយអ្នកស្រុកយូដានឹងមានព្រំដែនរបស់ខ្លួននៅលើផ្នែកខាងភាគខាងត្បូង, ហើយផ្ទះរបស់លោកយ៉ូសែបនៅភាគខាងជើង.
ផ្ទុយ ទៅ វិញ, បព្វជិតភាពនៃព្រះអម្ចាស់គឺមរតករបស់ខ្លួន.
18:8 ហើយនៅពេលដែលបុរសបានកើនឡើងឡើង, ដូច្នេះពួកគេអាចចេញទៅក្រៅដើម្បីរៀបរាប់អំពីស្រុកនេះ, លោកយ៉ូស្វេបង្គាប់ពួកគេ, និយាយ ថា :, "រង្វង់កាត់ស្រុក, និងរៀបរាប់អំពីវា, និងត្រឡប់ទៅឱ្យខ្ញុំ, ដូច្នេះខ្ញុំអាចចាប់ឆ្នោតសម្រាប់អ្នកអំពីបញ្ហានេះ, មុនពេលដែលព្រះអម្ចាស់, នៅស៊ីឡូ»។
18:10 ហើយគាត់បានចាប់ឆ្នោតមុនពេលដែលព្រះអម្ចាស់, នៅស៊ីឡូ, ហើយគាត់បានបែងចែកដីឱ្យអ៊ីស្រាអែល, នៅក្នុងប្រាំពីរផ្នែក.
18:12 និងដីរបស់ខ្លួនឆ្ពោះទៅកាន់ភាគខាងជើងនេះគឺបានមកពីទន្លេយ័រដាន់, បន្ត, នៅជិតផ្នែកម្ខាងនៃក្រុងយេរីខូនៅតំបន់ភាគខាងជើង, និងពីទីនោះ, ឡើងទៅទិសខាងលិចទៅកាន់ភ្នំ, និងពង្រីកទៅវាលរហោស្ថាន Bethaven នេះ.
ហើយវាចុះចូលទៅក្នុងអាថារ៉ូត-addar, នៅលើភ្នំដែលមានទៅភាគខាងត្បូងនៃបេតហូរ៉ូទាបជាងនេះ.
ហើយវាជាការផ្ទុយតំបន់ភាគខាងជើង, នៅក្នុងផ្នែកឆ្ងាយនៃជ្រលងភ្នំរេផែម.
18:21 និងទីក្រុងរបស់ពួកគេមាន: ក្រុងយេរីខូនិងក្រុងបេតហុកឡានិងជ្រលងរំខាន,
នេះជាកម្មសិទ្ធិរបស់កូនចៅបេនយ៉ាមីន, នេះបើយោងតាមក្រុមគ្រួសាររបស់ពួកគេ.
19:1 និងលើកទីពីរបានចេញទៅក្រៅបានយ៉ាងច្រើន, សម្រាប់កូនចៅស៊ីម្មានតាមអំបូររបស់ពួកគេ.
19:8 ភូមិនៅជុំវិញក្រុងទាំងនេះ, ដូចជានៅឆ្ងាយដូចជាការ Baalath ស្រាបៀរ, កន្លែងខ្ពស់ប្រឈមមុខនឹងតំបន់ភាគខាងត្បូង.
19:9 នៅក្នុងការកាន់កាប់និងការជាច្រើននៃពួកកូនចៅយូដា, ដែលមានកាន់តែច្រើន.
19:10 និងទីបីធ្លាក់ចុះដល់ច្រើនកូនចៅសាប់យូឡូន, ដោយក្រុមគ្រួសាររបស់ពួកគេ; និងដែនកំណត់នៃកម្មសិទ្ធិរបស់ពួកគេត្រូវបានកំណត់ជានៅឆ្ងាយដូចជា Sarid.
19:29 ហើយវាប្រែត្រឡប់មកវិញនៅភូមិរ៉ាម៉ា, សូម្បីតែទីក្រុងមាំមួនណាស់ទីរ៉ុស, និងសូម្បីតែហូសា.
19:32 នេះបានធ្លាក់ចុះដល់ទីច្រើនកូនចៅរបស់លោកណែបថាលី, ដោយក្រុមគ្រួសាររបស់ពួកគេ.
ហើយការចេញរបស់ខ្លួនគឺដូចជានៅឆ្ងាយដូចជាការទន្លេយ័រដាន់.
និងបន្តនៅលើសាប់យូឡូន, នៅ ភាគ ខាងត្បូង, និងដើម្បីកុលសម្ព័ន្ធអេស៊ើរ, នៅភាគខាងលិច, និងស្រុកយូដា, នៅឯទន្លេយ័រដាន់, ឆ្ពោះទៅរកការកើនឡើងនៃព្រះអាទិត្យ.
កូនចៅដាន់និងការឡើងទៅច្បាំងនឹង Leshem, ហើយពួកគេបានរឹបអូសយក. ហើយពួកគេបានវាយប្រហារវាជាមួយនឹងមុខដាវនេះ, ហើយពួកគេបានកាន់កាប់វា, ហើយពួកគេរស់នៅក្នុងវា, ហៅវាដោយឈ្មោះនៃ Leshem-ដាន, បើយោងទៅតាមឈ្មោះរបស់ឪពុកដាន់.
19:49 ហើយនៅពេលដែលលោកបានបញ្ចប់ការចែកទឹកដីដោយមានច្រើនដល់ទៅមួយគ្នាតាមកុលសម្ព័ន្ធរបស់ខ្លួន, អ៊ីស្រាអែលបានប្រគល់កម្មសិទ្ធិទៅឱ្យលោកយ៉ូស្វេ, កូនរបស់លោកនូន, នៅកណ្ដាលចំណោមពួកគេ,
19:51 ទាំងនេះគឺជាទ្រព្យសម្បត្ដិដែលលោកអេឡាសារ, លោកបូជាចារ្យ, និងយ៉ូស្វេ, កូនរបស់លោកនូន, និងមេដឹកនាំនៃក្រុមគ្រួសារនិងកុលសម្ព័ន្ធនៃកូនចៅអ៊ីស្រាអែលដែលបានបែងចែកដោយច្រើននៅស៊ីឡូ, មុនពេលដែលព្រះអម្ចាស់, នៅមាត់ទ្វារនៃព្រះពន្លានៃសក្ខីភាពនេះ.
ដូច្នេះ ហើយ, លោកប្រហែលជាអាចគេចផុតពីព្រះពិរោធរបស់សាច់ញាតិជិតស្និទ្ធ, ដែលជាអ្នកដែលត្រូវសងសឹកមួយ.
ដូច្នេះហើយពួកគេនឹងបានទទួលព្រះអង្គ, និងឱ្យគាត់កន្លែងដែលនៅក្នុងដើម្បីរស់.
ដ្បិតព្រះអង្គបានប្រហារអ្នកជិតខាងរបស់គាត់មិនដឹង, នរណាម្នាក់ដែលមិនត្រូវបានគេបង្ហាញឱ្យឃើញដើម្បីបានសត្រូវរបស់គាត់ពីរឬបីថ្ងៃមុនពេល.
20:8 និងលើសពីទន្លេយ័រដាន់, ផ្ទុយភាគខាងកើតនៃក្រុងយេរីខូម្ខាង, ពួកគេបានតែងតាំង Bezer, ដែលមានទីតាំងនៅវាលរហោស្ថាននៃកុលសម្ព័ន្ធរូបេននេះ, និងក្រុងរ៉ាម៉ូតនៅស្រុកកាឡាដរបស់កុលសម្ព័ន្ធកាដ, និងក្រុងកូឡាននៅស្រុកបាសានរបស់កុលសម្ព័ន្ធម៉ាណាសេ.
21:4 និងជាច្រើនបានទៅរកក្រុមគ្រួសារកេហាត់, កូនចៅរបស់អើរ៉ុន, លោកបូជាចារ្យ, ពីកុលសម្ព័ន្ធយូដានិងកុលសម្ព័ន្ធស៊ីម្មាននិងបេនយ៉ាមីន: ក្រុងចំនួនដប់បី.
21:6 ហើយនៅក្រោយជាច្រើនបានចេញទៅកូនចៅរបស់លោកគើរសុនបាន, ដូច្នេះពួកគេនឹងទទួលបាន, ពីកុលសម្ព័ន្ធអ៊ីសាខារនិងអេស៊ើរនិងណែបថាលី, និងពីកុលសម្ព័ន្ធពាក់កណ្តាលមួយដែលម៉ាណាសេនៅស្រុកបាសាននៃ: ចំនួននៃក្រុងចំនួនដប់បីនេះ.
21:8 ដូច្នេះហើយកូនចៅអ៊ីស្រាអែលបានចែកក្រុងនិងតំបន់ជាយក្រុងរបស់ខ្លួនដើម្បីក្រុមលេវី, ដូចជាព្រះអម្ចាស់បានណែនាំដោយដៃរបស់លោកម៉ូសេ, ចែកចាយទៅគ្នាដោយច្រើន.
21:12 ប៉ុ ន្ដែ ជា ការ ពិត, វាលនិងភូមិរបស់ខ្លួនលោកបានឱ្យទៅលោកកាលែប, កូនរបស់លោកយេភូនេ, ទុកជាមរដក.
21:17 បន្ទាប់ មក, កុលសម្ព័ន្ធនៃកូនប្រុសពីការបេនយ៉ាមីន, គាត់បានផ្ដល់ឱ្យក្រុងគីបៀន, និងកេបា,
21:33 ក្រុងទាំងប៉ុន្មានរបស់គ្រួសារគើសូនត្រូវបានគេដប់បី, ជាមួយនឹងតំបន់ជាយក្រុងរបស់ខ្លួន.
21:37 ពីកុលសម្ព័ន្ធកាដ, ក្រុងរ៉ាម៉ូតក្នុងស្រុកកាឡាដ, ក្រុងមួយក្នុងចំណោមទីក្រុងពំនាក់, និងម៉ាហាណែមនិងក្រុងហេសបូនិងក្រុងយ៉ាស៊ើរ, ទីក្រុងមួយចំនួនជាមួយនឹងតំបន់ជាយក្រុងរបស់ខ្លួន.
21:41 ព្រះជាអម្ចាស់បានប្រទានដល់អ៊ីស្រាអែលទឹកដីទាំងប៉ុន្មានដែលលោកបានសន្យាថាលោកនឹងផ្តល់ទៅឱ្យដូនតារបស់ពួកគេ.
21:42 ហើយគាត់បានផ្ដល់ឱ្យពួកគេមានសេចក្ដីសុខសាន្ដជាមួយអស់ទាំងសាសន៍ដែលនៅជុំវិញ.
22:1 ក្នុងពេលជាមួយគ្នា, លោកយ៉ូស្វេបានហៅកុលសម្ព័ន្ធរូបេន, និងកុលសម្ព័ន្ធកាដ, និងកុលសម្ព័ន្ធម៉ាណាសេចំនួនពាក់កណ្ដាលមួយ.
អ្នកបានស្ដាប់បង្គាប់យើងក្នុងគ្រប់កិច្ចការទាំងអស់.
22:4 ហេតុនេះ ហើយ បាន ជា, ចាប់តាំងពីព្រះអម្ចាស់ជាព្រះរបស់អ្នកប្រទានបងប្អូនមានសន្តិភាពនិងសុខសាន្តត្រាណរបស់អ្នក, ដូចលោកបានសន្យា: ត្រឡប់មកវិញ, ហើយចូលទៅក្នុងតង់ត៍របស់អ្នកនិងចូលទៅក្នុងដីដែលជាកម្មសិទ្ធិរបស់អ្នក, ដែលលោកម៉ូសេ, ជាអ្នកបម្រើរបស់ព្រះអម្ចាស់, បានបញ្ជូនទៅខាងនាយទន្លេយ័រដាន់.
22:6 លោកយ៉ូស្វេបានប្រទានពរដល់ពួកគេ, ហើយគាត់បានបញ្ជូនពួកគេចេញឆ្ងាយ.
22:7 ឥឡូវកុលសម្ព័ន្ធម៉ាណាសេចំនួនពាក់កណ្ដាលមួយ, លោកម៉ូសេបានប្រគល់កម្មសិទ្ធិនៅស្រុកបាសានជា.
ហើយនៅពេលដែលលោកបានប្រទានពរដល់ពួកគេនិងបណ្តេញពួកគេទៅកាន់លំនៅរបស់ខ្លួនវិញ,
ចែករង្វាន់នៃសត្រូវរបស់អ្នកជាមួយនឹងបងប្អូនរបស់អ្នក "។
22:10 ហើយនៅពេលដែលពួកគេបានមកដល់នៅភ្នំនៃទន្លេយ័រដាន់ក្នុងស្រុកកាណាន, ពួកគេបានសង់អាសនៈរ៉ិចទ័រសម្បើមមួយក្បែរទន្លេយ័រដាន់.
22:16 «ប្រជាជនទាំងអស់របស់ព្រះអម្ចាស់ប្រកាសនេះ: តើអ្វីជាការរំលងនេះគឺ?
22:17 តើវាជារឿងតូចមួយដល់អ្នកថាអ្នកបានប្រព្រឹត្តអំពើបាបជាមួយព្រះបាលពេអរ, ហើយថាស្នាមប្រឡាក់នៃឧក្រិដ្ឋកម្មដែលនៅតែបន្តក្នុងចំណោមពួកយើង, សូម្បីតែសព្វថ្ងៃ?
ប៉ុន្ដែមិនបានដកខ្លួនចេញពីព្រះអម្ចាស់, និងពីការប្រកបរបស់យើង, ដោយសង់អាសនៈផ្ទុយទៅនឹងអាសនៈរបស់ព្រះអម្ចាស់ជាព្រះរបស់យើង.
ហើយគាត់ជាបុរសតែមួយគត់.
22:21 និងកូនចៅរូបេន, និងកាដ, និងកុលសម្ព័ន្ធម៉ាណាសេចំនួនពាក់កណ្ដាលមួយបានឆ្លើយតបទៅនឹងមេដឹកនាំនៃគណៈប្រតិភូមកពីអ៊ីស្រាអែល:
22:25 ព្រះអម្ចាស់បានឈរជើងទន្លេយ័រដាន់ជាព្រំប្រទល់រវាងពួកយើងនិងអ្នករាល់គ្នា, កូនចៅរូបេនអើយ, កូនចៅកាដអើយ!.
ដូច្នេះហើយយើងបានស្វែងរកអ្វីដែលប្រសើរជាង,
22:32 ហើយគាត់បានត្រឡប់មកវិញជាមួយនឹងមេដឹកនាំ, ពីកូនចៅរូបេននិងកាដ, ចេញពីស្រុកកាឡាដ, ចូលទៅក្នុងផ្នែកខ្លះនៃស្រុកកាណាន, កូនចៅអ៊ីស្រាអែល.
22:34 កូនរបស់លោករូបេននិងកូនចៅកាដបានហៅអាសនៈដែលពួកគេបានសង់: ទីបន្ទាល់របស់យើងថាព្រះអម្ចាស់ផ្ទាល់ជាព្រះជាម្ចាស់.
23:1 ឥឡូវនេះពេលយូរកន្លងផុតទៅ, ក្រោយពីព្រះអម្ចាស់បានផ្ដល់ឱ្យអ៊ីស្រាអែលដោយសេចក្ដីសុខសាន្តដល់គ្រប់ទាំងសាសន៍ចុះចូលជុំវិញ.
23:8 ផ្ទុយ ទៅ វិញ, ប្រកាន់ភ្ជាប់ទៅនឹងព្រះអម្ចាស់ជាព្រះរបស់, គ្រាន់តែជាអ្នកបានធ្វើរហូតមកដល់ថ្ងៃនេះ.
23:10 មួយនៃអ្នកនឹងបន្តជាមួយពាន់នាក់នៃសត្រូវ.
23:11 ទោះ អញ្ចឹង ក្ដី, ត្រូវណាស់ឧស្សាហ៍ព្យាយាមនិងប្រុងប្រយ័ត្នក្នុងការនេះ: ថាអ្នកស្រឡាញ់ព្រះអម្ចាស់ជាព្រះរបស់.
23:13 សូម្បីតែឥឡូវនេះ, ដឹងថានេះ: ដែលព្រះអម្ចាស់ជាព្រះរបស់អ្នកនឹងមិនត្រូវបានលុបពួកគេចេញពីមុខអ្នក.
23:14 វា, សព្វថ្ងៃនេះខ្ញុំបានចូលទៅក្នុងវិធីនៃផែនដីទាំងមូល, ហើយអ្នកនឹងដឹងអស់អំពីគំនិតរបស់អ្នកដែល, ចេញពីសេចក្ដីទាំងប៉ុន្មានដែលព្រះអម្ចាស់បានសន្យាដើម្បីបំពេញសម្រាប់អ្នក, មិនមួយនឹងឆ្លងដោយការបំពេញសេចក្តីត្រូវការ.
ហើយគោរពបំរើព្រះចម្លែក. 24:3 បន្ទាប់មកខ្ញុំបាននាំអប្រាហាំជាឪពុករបស់អ្នកពីផ្នែកខ្លះនៃនាយទន្លេអឺប្រានេះ, ហើយខ្ញុំបាននាំគាត់ចូលទៅក្នុងស្រុកកាណាន.
ហើយខ្ញុំបានប្រគល់តំបន់ភ្នំសៀរអោយអេសាវដែលជាកម្មសិទ្ធិ.
24:5 ហើយខ្ញុំបានចាត់លោកម៉ូសេនិងលោកអើរ៉ុន, យើងប្រហារស្រុកអេស៊ីបនិងទីសំគាល់ជាច្រើននិងជាមួយអស្ចារ្យ.
ជនជាតិអេស៊ីបដេញតាមរទេះចំបាំងជាមួយបុព្វបុរសរបស់អ្នកនិងទ័ពសេះ, ដូចជានៅឆ្ងាយដូចជាសមុទ្រក្រហម.
24:8 ហើយខ្ញុំបានដឹកនាំអ្នកចូលទៅក្នុងទឹកដីរបស់ជនជាតិអាម៉ូរី, ដែលត្រូវបានគេរស់នៅលើសពីទន្លេយ័រដាន់.
24:9 ស្ដេចបាឡាក់, កូនរបស់បាទស៊ីបព័រនេះ, ស្ដេចស្រុកម៉ូអាប់, ក្រោកឡើងប្រយុទ្ធប្រឆាំងនឹងអ៊ីស្រាអែល.
និងយកទៅឆ្ងាយព្រះដែលបុព្វបុរសរបស់អ្នកបំរើការនៅក្នុងស្រុកអេស៊ីបនិង Mesopotamia, ហើយបម្រើព្រះអម្ចាស់.
24:17 ព្រះអម្ចាស់ជាព្រះរបស់យើងបានដោយខ្លួនឯងដែលដឹកនាំយើងខ្ញុំនិងបុព្វបុរសរបស់យើងនៅឆ្ងាយពីស្រុកអេស៊ីប, ពីផ្ទះនៃទាសភាពនេះ.
24:18 ហើយគាត់បានដេញប្រជាជាតិទាំងអស់, ជាតិអាម៉ូរី, អ្នកដែលរស់នៅស្រុកដែលយើងបានបញ្ចូល.
24:19 លោកយ៉ូស្វេមានប្រសាសន៍ទៅកាន់ប្រជាជន: "អ្នកនឹងមិនអាចដើម្បីបម្រើព្រះអម្ចាស់.
24:20 ប្រសិនបើអ្នកទុកនៅពីក្រោយព្រះអម្ចាស់, ហើយអ្នកគោរពបំរើព្រះដទៃ, គាត់នឹងបង្វែរខ្លួនគាត់, ហើយគាត់នឹងមិនបន្ទាបអ្នក, ហើយគាត់នឹងផ្តួលរំលំអ្នក, បន្ទាប់ពីបានទាំងអស់ល្អដែលលោកបានផ្ដល់ឱ្យអ្នក»។
24:26 លោកបានសរសេររឿងទាំងអស់ទាំងនេះនៅក្នុងបរិមាណនៃច្បាប់របស់ព្រះអម្ចាស់.
24:27 ហើយគាត់បាននិយាយទៅកាន់ប្រជាជនទាំងអស់, «អ្វីដែល, ថ្មនេះនឹងទៅជាអ្នកជាទីបន្ទាល់មួយ, ដែលបានឮពាក្យទាំងអស់នៃព្រះអម្ចាស់ដែលគាត់បាននិយាយទៅកាន់អ្នក, ក្រែងលោ, ក្រោយមក, អ្នកអាចជ្រើសដើម្បីបដិសេធវា, និងដើម្បីកុហកព្រះអម្ចាស់ជាព្រះរបស់»។
24:31 និងអ៊ីស្រាអែលបានបម្រើព្រះអម្ចាស់ក្នុងអំឡុងពេលថ្ងៃរបស់លោកយ៉ូស្វេទាំងអស់, ពួកព្រឹទ្ធាចារ្យនិងរបស់ដែលបានរស់នៅជាយូរមកហើយបន្ទាប់ពីលោកយ៉ូស្វេ, ហើយជាអ្នកដែលបានស្គាល់អស់ទាំងការរបស់ព្រះអម្ចាស់ថាលោកបានសម្រេចនៅស្រុកអ៊ីស្រាអែល.
1:1 វិវរណៈនៃព្រះយេស៊ូវគ្រីស្ទ, ដែលព្រះជាម្ចាស់ប្រទានអោយព្រះអង្គ, ក្នុងគោលបំណងដើម្បីធ្វើឱ្យគេស្គាល់ដល់អ្នកបម្រើរបស់លោកអ្វីដែលត្រូវកើតមានឡើងក្នុងពេលឆាប់, ហើយការដែលលោកបានចុះហត្ថលេខាដោយផ្ញើទេវតារបស់លោកក្នុងការបម្រើរបស់លោកយ៉ូហាន;
1:3 មានពរហើយអ្នកណាដែលបានអានឬស្តាប់ឮពាក្យរបស់ទំនាយនេះ, និងអ្នកដែលរក្សាអ្វីដែលត្រូវបានសរសេរនៅក្នុងវា.
សូម លើកតម្កើង សិរីរុងរឿង និង ព្រះចេស្ដា របស់ ព្រះអង្គ អស់ កល្ប ជា អង្វែង.
1:12 ហើយខ្ញុំបានងាក, ដូច្នេះដើម្បីជាការមើលឃើញសំឡេងដែលត្រូវបានគេនិយាយជាមួយខ្ញុំ.
1:13 និងនៅកណ្ដាលជើងចង្កៀងមាសទាំងប្រាំពីរគឺជាផ្នែកមួយ resembling បុត្រមនុស្ស, ស្លៀកពាក់ទៅជើងដោយមានសម្លៀកបំពាក់មួយ, និងបានរុំក្នុងការដោះនឹងខ្សែក្រវ៉ាត់ធំទូលាយនៃមាស.
1:15 និងជើងរបស់គាត់លង្ហិនចាំងលក្ខណៈស្រដៀង, គ្រាន់តែជាការដុតមួយក្នុងភ្លើង; ហើយសំឡេងលោកមានដូចជាសំឡេងនៃទឹកជាច្រើនដែលបាន.
ខ្ញុំជាដំបូងនិងចុងក្រោយនេះ.
1:19 ហេតុនេះ ហើយ បាន ជា, សរសេរអ្វីដែលអ្នកបានឃើញ, និងដែលមាន, ហើយដែលត្រូវបានកើតមានឡើងបន្ទាប់មកទៀត:
ផ្កាយទាំងប្រាំពីរគឺជាទេវតារបស់ក្រុមជំនុំទាំងប្រាំពីរ, ហើយជើងចង្កៀងទាំងប្រាំពីរគឺជាក្រុមជំនុំទាំងប្រាំពីរ "។
2:1 «ហើយទៅទេវតារបស់ក្រុមជំនុំ Ephesus សរសេរ: ដូច្នេះមួយដែលកាន់ផ្កាយប្រាំពីរនៅដៃខាងស្តាំរបស់គាត់បាននិយាយថា, ដែលយាងនៅកណ្ដាលជើងចង្កៀងមាសទាំងប្រាំពីរនេះ:
ដូច្នេះ ហើយ, អ្នកបានល្បងលមើលពួកដែលបានប្រកាសខ្លួនជាពួកសាវកនិងមិន, ហើយអ្នកបានរកឃើញពួកគេក្លាយជាអ្នកកុហក.
2:4 ប៉ុន្តែខ្ញុំប្រកាន់អ្នក: ថាអ្នកបានបោះបង់ចោលសេចក្ដីស្រឡាញ់ដំបូងរបស់អ្នក.
បើ មិន ដូច្នោះ ទេ, ខ្ញុំនឹងមករកអ្នកហើយយកជើងចង្កៀងរបស់អ្នកចេញពីកន្លែងវា, លុះត្រាតែអ្នកប្រែចិត្ត.
2:7 អ្នកណាមានត្រចៀក, ចូរផ្ទៀងត្រចៀកស្ដាប់សេចក្ដីដែលព្រះវិញ្ញាណមានព្រះបន្ទូលមកកាន់ក្រុមជំនុំ.
2:8 និងដើម្បីទេវតានៃសាសនាចក្រនៃ Smyrna សរសេរ: ដូច្នេះដំបូងនិងចុងក្រោយនេះបាននិយាយថា, លោកបានដែលបានស្លាប់ទៅហើយឥឡូវនេះរស់:
2:10 អ្នកគួរតែខ្លាចអ្វីគ្រាដែលមានសេចក្ដីដែលអ្នកនឹងទទួលរងនូវ.
2:11 អ្នកណាមានត្រចៀក, ចូរផ្ទៀងត្រចៀកស្ដាប់សេចក្ដីដែលព្រះវិញ្ញាណមានព្រះបន្ទូលមកកាន់ក្រុមជំនុំ.
ប្រសិនបើអ្នកធ្វើបានតិច, ខ្ញុំនឹងមកឯអ្នកយ៉ាងរហ័សហើយខ្ញុំនឹងប្រយុទ្ធប្រឆាំងនឹងពួកអ្នកទាំងនេះដោយដាវដែលចេញពីមាត់យើង.
ឯព្រះអង្គដែលបានឈ្នះ, ខ្ញុំនឹងឱ្យនំម៉ាណាដែលបានលាក់.
2:18 និងដើម្បីទេវតានៃសាសនាចក្រនៃការសរសេរក្រុងធាទេរ៉ា: ដូច្នេះព្រះបុត្រារបស់ព្រះជាម្ចាស់មានព្រះបន្ទូលថា, អ្នកដែលមានភ្នែកដូចអណ្ដាតភ្លើង, និងព្រះបាទាដូចលង្ហិនចាំង.
2:21 ហើយខ្ញុំបានផ្ដល់ឱ្យនាងពេលវេលាមួយ, ដូច្នេះនាងអាចធ្វើបូជា, ប៉ុន្តែនាងមិនចង់ប្រែចិត្តពីការសហាយស្មន់របស់នាង.
2:23 យើងនឹងដាក់កូនប្រុសរបស់គាត់ដល់ស្លាប់, ពេលនោះក្រុមជំនុំទាំងអស់នឹងដឹងថាខ្ញុំជាម្នាក់ដែលពិនិត្យនិងចិត្តភាព.
2:27 ហើយគាត់នឹងសម្រេចឱ្យពួកគេដោយដំបងដែក, ហើយពួកគេនឹងត្រូវបាក់បែកអស់ជាងស្មូនដូចដីមួយរបស់.
ហើយខ្ញុំនឹងអោយផ្កាយព្រឹក.
3:2 មានការប្រុងប្រយ័ត្ន, និងបញ្ជាក់អ្វីដែលនៅតែមាន, ក្រែងលោឆាប់ពួកគេបានស្លាប់ទៅ.
3:3 ហេតុនេះ ហើយ បាន ជា, រក្សាទុកក្នុងចិត្តវិធីដែលអ្នកបានទទួលនិងបានឮព្រះបន្ទូលនេះ, ហើយបន្ទាប់មកសង្កេតមើលវាហើយប្រែចិត្ត.
3:4 ប៉ុន្ដែអ្នកមានឈ្មោះមួយចំនួននៅក្នុងក្រុងសើដេសដែលមិនបានធ្វើអោយសម្លៀកបំពាក់ខ្លួន.
3:5 អ្នកណារៀល, ដូច្នេះគេត្រូវមានសម្លៀកបំពាក់ក្នុងសម្លៀកបំពាក់ស.
ហើយខ្ញុំនឹងសារភាពឈ្មោះរបស់គាត់នៅក្នុងវត្តមាននៃព្រះវរបិតារបស់យើងនិងនៅចំពោះមុខពួកទេវតារបស់លោក.
លោកបានបិទគ្មាននរណាបើកបាន.
មើល ចុះ !, ខ្ញុំបានបើកទ្វារចំហរមុនពេលអ្នក, ដែលគ្មាននរណាអាចបិទ.
3:9 មើល ចុះ !, ខ្ញុំនឹងទទួលយកបានពីសាលាប្រជុំរបស់មារសាតាំងអស់អ្នកដែលប្រកាសថាបានក្លាយទៅជាពួកសាសន៍យូដានិងមិន, សម្រាប់ពួកគេកំពុងនិយាយកុហក.
ហើយពួកគេនឹងទទួលស្គាល់ថាខ្ញុំបានស្រឡាញ់អ្នករាល់គ្នា.
3:12 អ្នកណារៀល, ខ្ញុំនឹងកំណត់គាត់ជាជួរឈរនៅក្នុងព្រះវិហារនៃព្រះរបស់យើងមួយ, ហើយគាត់នឹងមិនចាកចេញពីវាទៀតទេ.
3:13 អ្នកណាមានត្រចៀក, ចូរផ្ទៀងត្រចៀកស្ដាប់សេចក្ដីដែលព្រះវិញ្ញាណមានព្រះបន្ទូលមកកាន់ក្រុមជំនុំ.
3:16 ប៉ុន្តែដោយសារតែអ្នកគឺជាអ្នកមិនក្តៅមិនត្រជាក់និងមានការមិនត្រជាក់មិនក្តៅ, ខ្ញុំនឹងចាប់ផ្តើមដើម្បីខ្ជាក់អ្នកចេញពីមាត់ខ្ញុំ.
3:18 ខ្ញុំសូមអង្វរអ្នកឱ្យទិញពីខ្ញុំមាស, បានសាកល្បងដោយភ្លើងឆេះ, ដូច្នេះអ្នកអាចនឹងត្រូវបានបង្កើននិងអាចត្រូវបានមានសម្លៀកបំពាក់ក្នុងសម្លៀកបំពាក់ស, ហើយដូច្នេះការអាម៉ាស់នៃការគ្មានសម្លៀកបំពាក់របស់អ្នកអាចបាត់.
3:21 អ្នកណារៀល, ខ្ញុំនឹងផ្តល់ទៅឱ្យគាត់ទៅអង្គុយជាមួយខ្ញុំនៅលើបល្ល័ង្ករបស់យើង, គ្រាន់តែដូចខ្ញុំបានឈ្នះហើយបានអង្គុយជាមួយព្រះវរបិតារបស់ខ្ញុំនៅលើបល្ល័ង្ករបស់គាត់.
4:2 ភ្លាមខ្ញុំបាននៅក្នុងព្រះវិញ្ញាណ.
4:4 និងនៅជុំវិញបល្ល័ង្កមានបល្ល័ង្កម្ភៃបួនបល្ល័ង្កទំហំតូច.
4:5 និងពីបល្ល័ង្ក, ផ្លេកបន្ទោរមានសំឡេងព្រមទាំងផ្គរលាន់បានចេញទៅ.
4:6 ហើយនៅក្នុងទិដ្ឋភាពនៃបល្ល័ង្ក, មានអ្វីមួយដែលហាក់ដូចជាដូចសមុទ្រនៃកញ្ចក់មួយ, ស្រដៀងគ្នាទៅនឹងគ្រីស្តាល់.
4:7 សត្វមានជីវិតមួយជាលើកដំបូងមានលក្ខណៈស្រដៀងសត្វតោ, និងសត្វមានជីវិតទីពីរមានលក្ខណៈស្រដៀងកំភួនជើង, និងសត្វមានជីវិតទីបីមានមុខដូចមនុស្ស, និងសត្វទីបួនស្រដៀងនឹងឥន្ទ្រីដែលកំពុងតែហើរ.
4:10 ពួកព្រឹទ្ធាចារ្យទាំងម្ភៃបួននាក់នាំគ្នាក្រាបថ្វាបង្គំមុនពេលដែលគង់នៅលើបល្ល័ង្កនោះ, ហើយពួកគេគោរពស្រឡាញ់ព្រះអង្គដែលមានព្រះជន្មជារៀងរហូតនិងមិនធ្លាប់មាន, ហើយពួកគេបានដេញភ្នំពេញក្រោនរបស់ពួកគេមុនពេលដែលបល្ល័ង្ក, និយាយ ថា ::
សម្រាប់អ្នកបានបង្កើតអ្វីទាំងអស់, ហើយពួកគេបានក្លាយជានិងត្រូវបានបង្កើតឡើងដោយសារតែឆន្ទៈរបស់អ្នក "។
5:1 ហើយនៅក្នុងដៃខាងស្តាំរបស់លោកដែលអង្គុយលើបល្ល័ង្កនោះ, ខ្ញុំបានឃើញសៀវភៅមួយ, បានសរសេរនៅខាងក្នុងនិងក្រៅ, បោះត្រាប្រាំពីរបិទភ្ជាប់.
5:8 ហើយនៅពេលដែលគាត់បានបើកសៀវភៅនោះ, សត្វមានជីវិតទាំងបួននិងពួកព្រឹទ្ធាចារ្យទាំងម្ភៃបួននាក់នាំគ្នាក្រាបចុះនៅមុខកូនចៀម, មានឧបករណ៍ខ្សែអក្សរនីមួយ, ព្រមទាំងកាន់ពែងមាសពេញលេញនៃទឹកអប់, ដែលជាពាក្យអធិស្ឋានរបស់ពួកបរិសុទ្ធ.
5:10 ហើយអ្នកបានធ្វើឱ្យយើងចូលទៅក្នុងព្រះរាជ្យ * មួយហើយចូលទៅក្នុងព្រះរបស់យើងពួកបូជាចារ្យសំរាប់, ហើយយើងនឹងគ្រងរាជ្យលើផែនដី»។
5:12 នាំគ្នាបន្លឺសំឡេងឡើងយ៉ាងខ្លាំង: «កូនចៀមដែលត្រូវបានគេសម្លាប់នេះគឺមានភាពសក្ដិសមដើម្បីទទួលបានអំណាច, និងទេវភាព, និង ប្រាជ្ញា, និងកម្លាំង, កិ ត្ដិ យ ស, និងសិរីរុងរឿង, និងព្រះពរ»។
5:14 និងសត្វមានជីវិតទាំងបួនបាននិយាយថា:, "អាម៉ែន" ។ ពួកព្រឹទ្ធាចារ្យទាំងម្ភៃបួននាក់នាំគ្នាក្រាបចុះអោនមុខដល់ដី, ហើយពួកគេគោរពស្រឡាញ់មួយដែលគង់នៅអស់កល្បជាអង្វែងតរៀងទៅ.
6:1 ហើយខ្ញុំឃើញថាកូនចៀមបានបើកមួយនៃត្រាទាំងប្រាំពីរ.
6:3 ហើយនៅពេលដែលគាត់បានបើកបកត្រាទីពីរ, ខ្ញុំឮសូរសត្វរស់នៅទីពីរនិយាយថា:: «ចូរចូលទៅជិតហើយឃើញ»។
6:5 ហើយនៅពេលដែលគាត់បានបើកបកត្រាទីបី, ខ្ញុំឮសូរសត្វរស់នៅទីបីពោលថា:: «ចូរចូលទៅជិតហើយឃើញ»។ ពេលនោះ, សេះខ្មៅមួយ.
6:6 ខ្ញុំឮអ្វីមួយដូចជាសំឡេងនៅកណ្ដាលសត្វមានជីវិតទាំងបួននេះនិយាយថា:, «វិធានស្រូវសាលីទ្វេដងប្រាក់មួយកាក់, និងវិធានការពីរដងបីនៃ barley សម្រាប់មួយដួងក្នុងមួយថ្ងៃ, ប៉ុន្តែការធ្វើឱ្យគ្រោះថ្នាក់ទៅនឹងស្រានិងប្រេងទេ "។
និងអំណាចត្រូវបានផ្តល់ទៅឱ្យគាត់នៅលើបួនផ្នែកនៃផែនដី, ដើម្បីបំផ្លាញដោយមុខដាវ, ដោយទុរ្ភិក្ស, និងដោយការស្លាប់, និងដោយសត្វនៃផែនដី.
6:10 ហើយពួកគេបានស្រែកយ៉ាងខ្លាំង, និយាយ ថា :: «តើ, ឱព្រះអម្ចាស់មានព្រះពិតនិងបរិសុទ្ធ, នឹងអ្នកមិនវិនិច្ឆ័យនិងមិនយុត្ដិកម្មឈាមរបស់យើងប្រឆាំងនឹងអស់អ្នកដែលរស់នៅលើផែនដីនេះ?"
និងព្រះអាទិត្យក្លាយជាខ្មៅ, ដូចបាវ haircloth មួយ, និងព្រះច័ន្ទទាំងមូលក្លាយទៅជាឈាមដូចឈាម.
6:15 និងស្ដេចនៃផែនដី, និងមេដឹកនាំ, និងមេដឹកនាំយោធា, និងទ្រព្យសម្បត្តិ, និងរឹងមាំនេះ, និងមនុស្សគ្រប់គ្នា, ជាអ្នកបម្រើនិងឥតគិតថ្លៃ, ពួនក្នុងគុហានិងក្នុងចំណោមថ្មភ្នំ.
6:17 សម្រាប់ថ្ងៃនៃកំហឹងរបស់ពួកគេយ៉ាងខ្លាំងបានមកដល់.
7:5 ពីកុលសម្ព័ន្ធយូដា, ម៉ឺនពីរពាន់នាក់ត្រូវបានផ្សាភ្ជាប់.
ពីកុលសម្ព័ន្ធកាដ, ម៉ឺនពីរពាន់នាក់ត្រូវបានផ្សាភ្ជាប់.
7:7 ពីកុលសម្ព័ន្ធស៊ីម្មាន, ម៉ឺនពីរពាន់នាក់ត្រូវបានផ្សាភ្ជាប់.
កុលសម្ព័ន្ធអ៊ីសាខារ, ម៉ឺនពីរពាន់នាក់ត្រូវបានផ្សាភ្ជាប់.
ពីកុលសម្ព័ន្ធយ៉ូសែបនិង, ម៉ឺនពីរពាន់នាក់ត្រូវបានផ្សាភ្ជាប់.
8:2 ហើយខ្ញុំបានឃើញពួកទេវតាទាំងប្រាំពីរដែលឈរនៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះជាម្ចាស់.
8:3 ទេវតាមួយរូបទៀតបានចូលទៅជិត, ហើយគាត់បានឈរពីមុខអាសនៈ, កាន់កាន់ពានមាសមួយផង.
8:4 ផ្សែងគ្រឿងក្រអូបនិងពាក្យអធិស្ឋានរបស់ពួកបរិសុទ្ធនៃការដែលបានយាងឡើងទៅស្ថាន, នៅក្នុងវត្តមានរបស់ព្រះជាម្ចាស់, ពីដៃរបស់ទេវតានោះ.
8:8 និងទេវតាទីពីរផ្លុំត្រែឡើង.
និងជាផ្នែកមួយភាគបីនៃសមុទ្រក្លាយទៅជាឈាមដូចឈាម.
និងជាផ្នែកមួយភាគបីនៃនាវានេះត្រូវបានបំផ្លាញ.
និងផ្កាយមួយយ៉ាងធំបានធ្លាក់ចុះពីលើមេឃ, ដូចចន្លុះដុត.
មនុស្សជាច្រើនស្លាប់ពីទឹក, ដោយសារតែពួកគេត្រូវបានធ្វើឡើងជូរចត់.
និងជាផ្នែកមួយភាគបីនៃព្រះអាទិត្យ, និងជាផ្នែកមួយភាគបីនៃព្រះច័ន្ទ, និងជាផ្នែកមួយភាគបីនៃផ្កាយនេះត្រូវបានគេវាយប្រហារ, ក្នុងរបៀបមួយដែលជាផ្នែកមួយភាគបីនៃពួកគេត្រូវបានបាំងមួយ.
8:13 ហើយខ្ញុំបានឃើញ, ហើយខ្ញុំបានឮសំឡេងនៃការបើកយន្តហោះឥន្ទ្រីមួយតែតាមរយៈការពាក់កណ្តាលនៃស្ថានបរមសុខ, ការហៅទូរស័ព្ទដោយសំឡេងខ្លាំង: «វេទនា, វេទនា, វេទនា, ដល់ប្រជាជននៃផែនដី, ពីសំឡេងនៅសល់នៃពួកទេវតាទាំងបី, ដែលឆាប់នឹងផ្លុំត្រែ!"
9:1 និងទីប្រាំទេវតាផ្លុំត្រែឡើង.
9:4 ហើយវាត្រូវបានបង្គាប់ពួកគេថាពួកគេមិនត្រូវប៉ះពាល់ដល់រុក្ខជាតិនៃផែនដី, ឬអ្វីនោះទេបៃតង, ឬដើមឈើណាមួយឡើយ, តែមនុស្សណាដែលមិនមានត្រារបស់ព្រះជាម្ចាស់នៅលើថ្ងាសរបស់ពួកគេ.
និងការធ្វើទារុណកម្មរបស់ពួកគេគឺដូចជាការធ្វើទារុណកម្មរបស់ខ្យាដំរីមួយ, នៅពេលដែលគាត់បានវាយបុរសម្នាក់.
ហើយពួកគេនឹងចង់ស្លាប់, និងការស្លាប់នឹងរត់ពីពួកគេ.
ហើយនៅលើក្បាលរបស់ពួកគេមានអ្វីមួយដូចជាពាក់មកុដស្រដៀងទៅនឹងមាស.
9:9 ហើយពួកគេមានក្រោះដូចអាវក្រោះធ្វើពីដែក.
9:10 ហើយពួកគេមានកន្ទុយស្រដៀងទៅនឹងខ្យាដំរី.
9:11 ហើយពួកគេមានស្ដេចមួយលើពួកគេ, ទេវតានៃទីជ្រៅបំផុត, ឈ្មោះជាភាសាហេប្រឺជាការដែលសេចក្ដីវិនាស; ភាសាក្រិច, នាវាពិឃាត; នៅឡាទីន, ការសម្លាប់រង្គាល.
9:13 ទេវតាទីប្រាំមួយនិងផ្លុំត្រែឡើង.
9:14 និយាយទៅទេវតាទីប្រាំមួយដែលមានត្រែនៅ: «ចូរស្រាយទេវតាទាំងបួនរូបដែលត្រូវបានគេចងនៅទន្លេអឺប្រាទន្លេធំ»។
9:16 ហើយចំនួនទាហានទ័ពសេះនោះគឺពីររយលាននាក់.
រីឯក្បាលសេះទាំងនោះគឺដូចជាក្បាលតោ.
9:18 និងជាផ្នែកមួយភាគបីនៃបុរសដែលត្រូវបានគេម្នាក់បានស្លាប់ដោយទុក្ខវេទនាទាំងបី: ដោយភ្លើងនិងដោយផ្សែងនិងដោយស្ពាន់ធ័រដែលនេះ, ដែលហូរចេញពីមាត់របស់ពួកគេ.
9:21 ហើយពួកគេមិនប្រែចិត្តពីការសម្លាប់របស់ពួកគេ, ឬពីការប្រើថ្នាំរបស់ពួកគេ, ឬពីការសហាយស្មន់របស់ខ្លួន, ឬពីការលួចរបស់ពួកគេ.
10:1 បន្ទាប់មកខ្ញុំឃើញទេវតារឹងមាំមួយផ្សេងទៀត, យាងចុះពីស្ថានបរមសុខ, ស្លៀកពាក់ជាមួយពពកមួយ.
10:4 ហើយនៅពេលដែលផ្គរលាន់ទាំងប្រាំពីរបានថ្លែងសំឡេងរបស់ពួកគេ, ខ្ញុំមានអាយុប្រហែលដើម្បីសរសេរ.
10:5 ទេវតាបាន, ដែលខ្ញុំបានឃើញឈរលើសមុទ្រនិងលើដី, លើកដៃរបស់គាត់ទៅលើមេឃ.
ហើយវានឹងបណ្តាលឱ្យមានជូរចត់នៅក្នុងក្រពះរបស់អ្នក, ប៉ុន្តែនៅក្នុងមាត់របស់អ្នកវាផ្អែមដូចទឹកឃ្មុំ»។
ហើយវាគឺជាផ្អែមដូចទឹកឃ្មុំនៅក្នុងមាត់ខ្ញុំ.
10:11 ហើយ គាត់ បាន និយាយ ថា ឱ្យ ខ្ញុំ, «វាគឺជាការចាំបាច់សម្រាប់អ្នកដើម្បីថ្លែងព្រះបន្ទូលសាជាថ្មីទៀតអំពីជាតិសាសន៍ជាច្រើនជាតិសាសន៍និងភាសានិងស្ដេច»។
11:2 ប៉ុន្តែ atrium នេះ, ដែលជាខាងក្រៅនៃប្រាសាទព្រះវិហារ, កំណត់វាមួយឡែកនិងមិនវាស់វា, ដោយសារតែវាត្រូវបានគេប្រគល់ទៅឱ្យពួកសាសន៍ដទៃ.
11:3 ហើយខ្ញុំនឹងបង្ហាញជូននូវបន្ទាល់របស់យើងទាំងពីរ, ហើយពួកគេនឹងថ្លែងព្រះបន្ទូលអស់មួយពាន់ពីររយហុកសិបថ្ងៃ, ស្លៀកបាវ.
11:5 ហើយប្រសិនបើនរណាម្នាក់ចង់ធ្វើទុក្ខអ្នកទាំងពីរ, ភ្លើងត្រូវចេញពីមាត់របស់ពួកគេ, ហើយវានឹងត្របាក់លេបសត្រូវរបស់គេ.
11:6 ទាំងនេះមានអំណាចដើម្បីបិទឡើងលើមេឃ, ដូច្នេះវាអាចនឹងមិនមានភ្លៀងធ្លាក់ក្នុងអំឡុងពេលថ្ងៃនៃការទាយរបស់ពួកគេ.
11:7 ហើយនៅពេលដែលពួកគេនឹងបានបញ្ចប់ទីបន្ទាល់របស់ពួកគេ, សត្វដែលឡើងពីជង្ហុកធំនឹងច្បាំងនឹងគេវា, ហើយនឹងយកឈ្នះពួកគេ, ហើយនឹងសម្លាប់ពួកគេ.
11:9 ហើយអ្នកដែលមកពីកុលសម្ព័ន្ធជាតិសាសន៍និងភាសានិងប្រទេសនឹងត្រូវបានមើលសាកសពរបស់ពួកគេអស់រយៈពេលបីថ្ងៃកន្លះនិងមួយ.
11:10 និងប្រជាជននៃផែនដីនឹងអរសប្បាយលើពួកគេ, ហើយពួកគេនឹងប្រារព្ធពិធី, ហើយពួកគេនឹងផ្ញើជំនូនអោយគ្នាទៅវិញទៅមក, ព្រោះព្យាការីទាំងពីរត្រូវបានគេធ្វើទារុណកម្មអ្នកដែលរស់នៅលើផែនដីនេះ.
ហើយពួកគេបានឈរនៅលើជើងរបស់ពួកគេទៀងត្រង់.
និងឈ្មោះរបស់បុរសដែលត្រូវគេសម្លាប់នៅក្នុងការរញ្ជួយដីនេះត្រូវបានគេប្រាំពីរពាន់នាក់.
11:14 ទុក្ខវេទនាទីពីរនេះបានចេញទៅ, ប៉ុន្តែការឃើញ, ទុក្ខវេទនាទីបីជិតយ៉ាងលឿន.
"។ 11:16 ពួកព្រឹទ្ធាចារ្យទាំងម្ភៃបួននាក់, ដែលអង្គុយលើបល្ល័ង្ករបស់ខ្លួននៅក្នុងព្រះនេត្រនៃព្រះ, ក្រាបចុះអោនមុខរបស់ពួកគេ, ហើយ ពួក គេ គោរព ស្រឡាញ់ ព្រះ ជា ម្ចាស់, និយាយ ថា ::
និង កូន របស់ នាង ត្រូវ បាន គេ នាំ ឡើង ទៅ ដល់ ព្រះជាម្ចាស់ និង បល្ល័ង្ក របស់ ព្រះអង្គ.
12:8 ប៉ុន្តែពួកគេមិនយកជាគោល, និងជាកន្លែងសម្រាប់ពួកគេត្រូវបានគេរកឃើញថាមិនមានទៀតទេនៅស្ថានបរមសុខ.
ហើយលោកត្រូវបានគេទម្លាក់ចុះមកលើផែនដី, និងពួកទេវតារបស់លោកត្រូវបានគេបោះចុះជាមួយគាត់.
សម្រាប់ការចោទប្រកាន់របស់បងប្អូនរបស់យើងបានត្រូវទម្លាក់, លោក ដែល បាន ចោទ ប្រកាន់ ថា ពួក គេ មុន ពេល របស់ យើង ថ្ងៃ ព្រះ និង យប់.
ហើយពួកគេស្រឡាញ់មិនជីវិតផ្ទាល់ខ្លួនរបស់ពួកគេ, រហូតដល់ស្លាប់.
ដ្បិតមារបានចុះមកដល់អ្នករាល់គ្នា, កាន់កំហឹងយ៉ាងខ្លាំង, ដោយដឹងថាគាត់មានពេលវេលាតិចតួច "។
12:14 និងស្លាបទាំងពីររបស់ឥន្ទ្រីមួយយ៉ាងធំត្រូវបានផ្តល់ទៅឱ្យស្ត្រីម្នាក់នេះ, ដូច្នេះនាងអាចហោះហើរទៅឆ្ងាយ, ចូលទៅក្នុងវាលរហោស្ថាន, ទៅកន្លែងរបស់នាង, ដែលជាកន្លែងដែលនាងត្រូវបានចិញ្ចឹមសម្រាប់ពេលវេលាមួយ, និង ពេលវេលា, ពាក់ ក ណ្តា ល ពេល វេលា មួយ, ពីការប្រឈមមុខនឹងពស់.
13:1 បន្ទាប់មកទៀតខ្ញុំឃើញសត្វតិរច្ឆានឡើងពីសមុទ្រមួយ, មាន ក្បាល ប្រាំពីរ និង មាន ស្នែង ដប់, នៅលើស្នែងទាំងដប់របស់វាវាមានមកុដ, ហើយនៅលើក្បាលរបស់វាត្រូវបានគេឈ្មោះនៃការពោលពាក្យប្រមាថ.
និងនាគបានប្រគល់ឫទ្ធានុភាពរបស់គាត់និងអំណាចយ៉ាងធំទៅវា.
និងពិភពលោកទាំងមូលមាននៅក្នុងការចម្លែកអ្វីដូចខាងក្រោមសត្វនោះ.
13:5 ហើយនៅទីនោះត្រូវបានគេដែលបានផ្ដល់ឱ្យទៅវាមាត់មួយ, ការនិយាយអ្វីដែលអស្ចារ្យនិងពោលពាក្យប្រមាថព្រះជាម្ចាស់.
13:6 ហើយគាត់បានបើកមាត់របស់គាត់នៅក្នុងការប្រមាថព្រះជាម្ចាស់, ដើម្បីប្រមាថឈ្មោះព្រះពន្លារបស់គាត់និងអ្នកដែលរស់នៅក្នុងស្ថានបរមសុខ.
និងអំណាចត្រូវបានផ្តល់ទៅឱ្យគាត់នៅលើគ្រប់កុលសម្ព័ន្ធនិងប្រជាជននិងប្រទេសជាតិនិងភាសា.
អ្នកណានឹងសម្លាប់ដោយមុខដាវ, ដោយមុខដាវនោះពិតជាត្រូវស្លាប់.
13:11 បន្ទាប់មកខ្ញុំឃើញសត្វតិរច្ឆានមួយទៀតឡើងពីដី.
13:12 ហើយនាងបានប្រព្រឹត្ដដោយសិទ្ធិអំណាចទាំងអស់របស់សត្វទីមួយនៅក្នុងការមើលឃើញរបស់គាត់.
13:13 ហើយនាងបានសម្រេចទីសំគាល់អស្ចារ្យ, ទោះបីជាដូច្នេះថានាងនឹងបណ្តាលឱ្យភ្លើងចុះពីលើមេឃទៅដើម្បីផែនដីអោយមនុស្សលោកឃើញ.
13:15 ហើយវាត្រូវបានផ្តល់ឱ្យទៅនាងដើម្បីផ្តល់នូវវិញ្ញាណមួយទៅរូបភាពនៃសត្វនេះ, ដូច្នេះរូបភាពនៃសត្វនេះនឹងនិយាយ.
13:16 ហើយនាងបានបណ្តាលឱ្យមនុស្សគ្រប់រូបនឹង, តូចទាំងធំ, អ្នកមាននិងអ្នកក្រ, ដោយសេរីនិងជាអ្នកបម្រើ, ដើម្បីឱ្យមានតួអក្សរមួយនៅលើដៃខាងស្តាំរបស់ពួកគេឬនៅលើថ្ងាសរបស់ពួកគេ,
សម្រាប់វាគឺជាចំនួនរបស់បុរសម្នាក់នេះ, និងលេខរបស់គាត់គឺប្រាំមួយរយហុកសិបប្រាំមួយ.
14:1 ហើយខ្ញុំបានឃើញ, ហើយ មើល ចុះ, កូនចៀមបានឈរនៅពីលើភ្នំស៊ីយ៉ូន, និងបានមួយរយសែសិបបួនពាន់នាក់នៅជាមួយព្រះអង្គ, មានឈ្មោះនិងឈ្មោះរបស់ព្រះវរបិតាទ្រង់កត់លើថ្ងាស.
បន្ទាប់មកសំឡេងដែលខ្ញុំឮគឺដូចតារាចម្រៀង, ខណៈពេលដែលការលេងនៅលើឧបករណ៍ stringed របស់ខ្លួន.
ហើយគ្មាននរណាម្នាក់អាចសូត្រ canticle របស់, លើកលែងតែអ្នកដែលមានមួយរយសែសិបបួនពាន់នាក់, ដែលត្រូវបានលោះពីផែនដីមក.
ទាំងនេះតាមកូនចៀមគ្រប់ទីកន្លែងដែលលោកនឹងទៅ.
14:5 ហើយនៅក្នុងមាត់របស់ពួកគេ, គ្មានពាក្យកុហកណាត្រូវបានរកឃើញ, សម្រាប់ពួកគេគឺដោយគ្មានកំហុសមុនពេលបល្ល័ង្ករបស់ព្រះជាម្ចាស់.
14:7 នាំគ្នាបន្លឺសំឡេងឡើងយ៉ាងខ្លាំង: «ចូរកោតខ្លាចព្រះអម្ចាស់, និងផ្តល់កិត្តិយសដល់គាត់, សម្រាប់ដល់ពេលព្រះអង្គវិនិច្ឆ័យទោសបានមកដល់.
14:8 ទេវតាមួយទៀតអនុវត្តតាមនិងការ, និយាយ ថា :: "ធ្លាក់ចុះ, បាប៊ីឡូនធ្លាក់ចុះយ៉ាងខ្លាំងនេះ, ដែល inebriated ជាតិសាសន៍ទាំងអស់ស្រានៃកំហឹងរបស់នាងនិងការសហាយស្មន់»។
14:13 ខ្ញុំឮព្រះសូរសៀងពីលើមេឃ, និយាយមកខ្ញុំ: "សរសេរ: មនុស្សស្លាប់នឹងមានសុភមង្គល, អ្នកដែលបានស្លាប់នៅក្នុងព្រះអម្ចាស់, ឥឡូវនេះនិងបរលោកនាយ, ព្រះវិញ្ញាណមានព្រះបន្ទូល, ដូច្នេះពួកគេអាចស្វែងរកការសម្រាកពីការងាររបស់ពួកគេ.
14:15 ទេវតាមួយរូបទៀតចេញពីព្រះវិហារ, ស្រែកដោយសំឡេងខ្លាំងទៅមួយអង្គុយលើពពក: "ផ្ញើចេញកណ្ដៀវរបស់អ្នកនិងច្រូត!
14:16 និងមួយដែលត្រូវបានគេអង្គុយលើពពកបានផ្ញើចេញកណ្ដៀវមកផែនដីនេះ, និងផែនដីត្រូវបាន reaped.
14:18 ទេវតាមួយរូបទៀតចេញពីអាសនៈ, ដែលបានប្រារព្ធឡើងមានអំណាចលើភ្លើង.
14:19 ទេវតាបានផ្ញើចេញ sickle មុតស្រួចរបស់គាត់នៅលើផែនដីនេះ, លោកបានប្រមូលផលទំពាំងបាយជូរនិងនៅផែនដីនេះ, ហើយគាត់បានបោះវាចូលទៅក្នុងអាងធំនៃកំហឹងរបស់ព្រះ.
សម្រាប់ការជាមួយពួកគេ, កំហឹងរបស់ព្រះត្រូវបានបញ្ចប់.
និងអស់អ្នកដែលបានយកឈ្នះលើសត្វនិងរូបភាពរបស់លោកនិងចំនួននៃឈ្មោះរបស់គាត់, ត្រូវបានគេឈរនៅលើសមុទ្រនៃកញ្ចក់, កាន់ពិណរបស់ព្រះជាម្ចាស់,
គ្រាន់តែនិងការពិតគឺជាវិធីរបស់អ្នក, ស្ដេចនៃគ្រប់វ័យ.
សម្រាប់អ្នកតែម្នាក់ឯងមានសុភមង្គលហើយ.
15:5 បន្ទាប់ពីហេតុការណ៍ទាំងនេះ, ខ្ញុំ បាន ឃើញ, ហើយ មើល ចុះ, ប្រាសាទនៃព្រះពន្លានៃសក្ខីភាពនៅស្ថានបរមសុខដែលត្រូវបានបើក.
15:7 និងមួយក្នុងចំណោមសត្វមានជីវិតទាំងបួនបានប្រគល់ពួកទេវតាពែងមាសប្រាំពីរប្រាំពីរនាក់, ពោរពេញទៅដោយព្រះពិរោធរបស់ព្រះជាម្ចាស់, របស់មួយដែលគង់នៅអស់កល្បជាអង្វែងតរៀងទៅ.
គ្មាននរណាម្នាក់អាចចូលទៅក្នុងព្រះវិហារ, រហូតដល់ទុក្ខលំបាកទាំងប្រាំពីររបស់ទេវតាប្រាំពីរបានចប់សព្វគ្រប់.
16:1 ខ្ញុំឮសំឡេងមួយយ៉ាងខ្លាំងចេញពីព្រះវិហារ, និយាយថាទៅកាន់ទេវតាទាំងប្រាំពីរ: "ចូរទៅយកពែងទាំងប្រាំពីរនៃព្រះពិរោធរបស់ព្រះជាម្ចាស់ចាក់លើផែនដីនេះ»។
និងរបួសធ្ងន់ធ្ងរយ៉ាងខ្លាំងភាគច្រើនកើតឡើងលើបុរសដែលមានតួអក្សរនៃសត្វនេះ, និងអស់អ្នកដែលគោរពស្រឡាញ់លើសត្វឬរូបភាពរបស់ខ្លួន.
ហើយវាក្លាយទៅជាឈាមដូចឈាមនៃការស្លាប់នេះ, ហើយគ្រប់មនុស្សទាំងអស់ដែលរស់នៅក្នុងសមុទ្រស្លាប់.
ដ្បិតពួកគេសមនឹងទទួលបាននេះ។ "
16:8 និងទេវតាទីបួនចាក់ចេញពីចានរបស់គាត់នៅលើព្រះអាទិត្យ.
16:9 មនុស្សម្នាត្រូវរលាកដោយកំដៅយ៉ាងខ្លាំង, ហើយពួកគេបានប្រមាថព្រះនាមរបស់ព្រះជាម្ចាស់, ដែលកាន់អំណាចជាងទុក្ខលំបាកទាំងនេះ, ប៉ុន្តែពួកគេមិនប្រែចិត្ត, ដូច្នេះដើម្បីលើកតម្កើងសិរីរុងរឿងរបស់ព្រះអង្គ.
16:12 និងទេវតាទីប្រាំមួយចាក់ចេញពីចានរបស់គាត់នៅលើថាទន្លេអឺប្រាតធំ.
16:13 ហើយខ្ញុំបានឃើញ, ពីមាត់នាគ, និងពីមាត់របស់សត្វនោះ, និងពីមាត់អ្នកប្រកាសទំនាយមិនពិតនោះទេ, វិញ្ញាណអាក្រក់បីចេញទៅក្រៅក្នុងលក្ខណៈនៃកង្កែប.
ហើយពួកគេបានឈានទៅស្ដេចនៃផែនដីទាំងមូល, ដើម្បីប្រមូលពួកគេសម្រាប់ការប្រយុទ្ធនៅថ្ងៃអស្ចារ្យរបស់ព្រះ.
ព្រះជាម្ចាស់ប្រទានពរដល់ព្រះអង្គដែលជាការប្រុងប្រយ័ត្ននិងសម្លៀកបំពាក់របស់គាត់ដែលបានរក្សា, ក្រែងលោគាត់បានដើរអាក្រាតនិងអាម៉ាស់ពួកគេមើលឃើញរបស់គាត់ "។
16:17 និងទេវតាទីប្រាំពីរចាក់ចេញពីចានរបស់គាត់នៅលើអាកាស.
16:19 និងទីក្រុងធំក្លាយជាបែងចែកជាបីផ្នែក.
និងបាប៊ីឡូមួយយ៉ាងធំបានមកចាំនៅចំពោះព្រះ, ដើម្បីផ្តល់នូវពែងស្រានៃកំហឹងនៃសេចក្ដីក្រោធរបស់គាត់បានរបស់នាង.
16:21 និងគោរពធ្ងន់ដូចជាទេពកោសល្យមួយដែលចុះពីលើមេឃមកលើមនុស្សលោក.
17:4 ហើយស្ត្រីនោះបានស្លៀកពាក់នៅជុំវិញទាំងអស់ជាមួយនឹងស្វាយនិងក្រហម, និងការតុបតែងដោយមាសត្បូងនិងពេជ្រ, កាន់ពែងមាសមួយនៅដៃរបស់នាង, ពោរពេញទៅដោយការស្អប់ខ្ពើមនិងជាមួយកខ្វក់ថោកទាបបំផុតរបស់វា.
17:6 ហើយខ្ញុំឃើញថាស្ត្រីម្នាក់នេះត្រូវបានគេ inebriated ពីឈាមរបស់ពួកបរិសុទ្ធនិងពីឈាមរបស់ពួកសាក្សីរបស់ព្រះយេស៊ូ.
17:13 ទាំងនេះកាន់ផែនការមួយ, ពួកគេនឹងប្រគល់ឫទ្ធានុភាពនិងអំណាចខ្លួនទៅអោយសត្វតិរច្ឆាន.
ដ្បិតព្រះអង្គជាព្រះអម្ចាស់លើអម្ចាស់នានានិងជាស្ដេចនៃស្ដេច.
17:15 ហើយ គាត់ បាន និយាយ ថា ឱ្យ ខ្ញុំ: «ទឹកដែលអ្នកបានឃើញ, ដែលជាកន្លែងដែលស្ដ្រីពេស្យាអង្គុយ, មានប្រជាជននិងប្រទេសនិងភាសា.
17:17 ដ្បិតព្រះជាម្ចាស់បានផ្តល់ទៅឱ្យចិត្តរបស់ពួកគេថាពួកគេអាចធ្វើបានដើម្បីអ្វីជាគាប់ព្រះហឫទ័យរបស់នាង, ដូច្នេះពួកគេអាចផ្តល់ឱ្យនគររបស់ខ្លួនទៅអោយសត្វតិរច្ឆាន, រហូតដល់ព្រះបន្ទូលរបស់ព្រះជាម្ចាស់នេះអាចនឹងត្រូវបានបញ្ចប់.
និងផែនដីភ្លឺដោយសិរីរុងរឿងរបស់ព្រះអង្គ.
ហើយនាងបានក្លាយទៅជាជំរកនៃអារក្សបាន, keepsake នៃរាល់ហើយវិញ្ញាណអាក្រក់នេះ, និងកាន់កាប់គ្រប់រឿងហោះនិងការស្អប់មិនបាន.
18:4 ខ្ញុំឮសំឡេងមួយទៀតពីលើមេឃ, និយាយ ថា :: «ចូរទៅឆ្ងាយពីនាង, ប្រជាជនរបស់យើង, ដូច្នេះអ្នកអាចនឹងមិនចូលរួមនៅក្នុងការសប្បាយរបស់នាង, ហើយដូច្នេះអ្នកមិនអាចជាអ្នកទទួលការរងទុក្ខរបស់នាង.
លាយសម្រាប់នាងមួយទ្វេជាពីរ, ក្នុងពែងដែលនាងបានលាយបញ្ចូលគ្នាជាមួយនេះ.
ហើយនាងនឹងត្រូវដុតចោល.
18:9 និងស្ដេចនៃផែនដី, ដែលបាន fornicated ជាមួយនាងនិងបានរស់នៅក្នុងប្រណីត, នាំគ្នាយំសោកនិងកាន់ទុក្ខសម្រាប់ខ្លួនគេលើនាង, នៅពេលដែលពួកគេបានមើលឃើញផ្សែងចម្បាំងរបស់នាង,
សម្រាប់នៅក្នុងមួយម៉ោង, ការវិនិច្ឆ័យរបស់អ្នកបានមកដល់ "។
18:12 ទំនិញទាំងនោះគឺមាសនិងប្រាក់និងត្បូងនិងពេជ្រតុបតែង, និងអំពីស្វាយក្រណាត់ទេសឯកក្រណាត់និងក្រហមទុំនិងសូត្រ, ហើយជាការគ្រប់ឈើដើមក្រូចឆ្មារ, រាល់ឧបករណ៍និងពីភ្លុកដំរី, ជារៀងរាល់ឧបករណ៍និងត្បូងនិងពីលង្ហិននិងជាតិដែកនិងថ្មម៉ាប,
18:14 និងផ្លែឈើរបស់បំណងប្រាថ្នានៃព្រលឹងរបស់អ្នកដែលបានទៅឆ្ងាយពីអ្នក.
ហើយពួកគេមិនត្រូវបានរកឃើញរឿងទាំងនេះជាថ្មីម្តងទៀត.
ដើម្បីមហានគរដែល, ដែលមានសម្លៀកបំពាក់ក្រណាត់ទេសឯកក្រណាត់និងស្វាយនិងក្រហម, និងដែលត្រូវបានគេតុបតែងដោយមាសត្បូងនិងពេជ្រ។
សម្រាប់នាងត្រូវបានធ្វើឡើងនៅស្ងាត់ជ្រងំនៅក្នុងមួយម៉ោង.
ដ្បិតព្រះជាម្ចាស់បានវិនិច្ឆ័យទោសការវិនិច្ឆ័យរបស់អ្នកលើរបស់នាង។ "
ហើយនាងនឹងមិនត្រូវបានរកឃើញជាថ្មីម្តងទៀត.
ហើយជារៀងរាល់សិប្បករសិល្បៈជារៀងរាល់នឹងមិនត្រូវបានរកឃើញនៅក្នុងអ្នករាល់គ្នាជាថ្មីម្តងទៀត.
ចំពោះអ្នកត្រូវបានគេដឹកនាំឈ្មួញនៅលើផែនដីនេះ.
18:24 ហើយនៅក្នុងរបស់នាងត្រូវបានរកឃើញឈាមរបស់ពួកព្យាការីនិងពួកបរិសុទ្ធនេះ, និងអស់អ្នកដែលត្រូវនៃការសម្លាប់នៅលើផែនដីនេះ»។
19:1 បន្ទាប់ពី ហេតុការណ៍ ទាំង នេះ, ខ្ញុំបានឮអ្វីមួយដូចព្រះសូរសៀងរបស់មហាជនជាច្រើននៅក្នុងស្ថានបរមសុខ *, និយាយ ថា :: «ហាលេលូយ៉ា!
19:2 ចំពោះការពិតនិងគ្រាន់តែជាការវិនិច្ឆ័យរបស់គាត់, លោកបានវិនិច្ឆ័យទោសស្ដ្រីពេស្យាដែលបានអស្ចារ្យដែលបង្ខូចផែនដីដោយអំពើពេស្យាចាររបស់នាង.
ដ្បិតព្រះជាអម្ចាស់របស់យើង, មាន គ្រប់ ព្រះចេស្ដា, បានសោយរាជ្យ.
ហើយអនុញ្ញាតឱ្យយើងលើកតម្កើងសិរីរុងរឿងរបស់គាត់.
19:8 ហើយវាត្រូវបានគេផ្តល់ទៅឱ្យនាងថានាងគួរតែគ្របដណ្តប់ខ្លួនរបស់នាងជាមួយនឹងក្រណាត់ទេសឯកក្រណាត់, ស្អាតអស្ចារ្យនិងស.
19:9 ហើយ គាត់ បាន និយាយ ថា ឱ្យ ខ្ញុំ: "សរសេរ: មានពរហើយអស់អ្នកដែលត្រូវបានហៅទៅពិធីមង្គលការរបស់កូនចៀម»។ ហើយគាត់បាននិយាយមកខ្ញុំ, «ពាក្យទាំងនេះរបស់ព្រះគឺជាការពិត»។
19:12 និងភ្នែករបស់គាត់មានដូចអណ្ដាតភ្លើងមួយ, និងនៅលើក្បាលរបស់គាត់មានមកុដជាច្រើន, បានសរសេរឈ្មោះមួយ, ដែលគ្មាននរណាម្នាក់ដឹងឡើយលើកលែងតែដោយខ្លួនឯង.
ហើយឈ្មោះរបស់គាត់ត្រូវបានគេហៅថា: ព្រះបន្ទូលនៃព្រះ.
19:15 និងពីមាត់របស់គាត់បានចាត់ចែងដាវមុខពីរមុត, ដូច្នេះជាមួយវាគាត់អាចប្រហារប្រជាជាតិនានា.
19:18 ដូច្នេះអ្នកអាចបរិភោគសាច់របស់ស្ដេច, និងសាច់សាលាក្តី, និងសាច់ខ្លាំង, សាច់សេះនិងអ្នកដែលអង្គុយនៅលើពួកវា, និងសាច់នៃការទាំងអស់: ដោយសេរីនិងជាអ្នកបម្រើ, តូចទាំងអ្នកធំ»។
19:20 ហើយសត្វនេះត្រូវបានចាប់ខ្លួន, ហើយគាត់បានព្យាជាមួយមិនពិត, ដែលនៅក្នុងវត្តមានរបស់លោកបណ្តាលឱ្យមានគស្ញ, ដោយការដែលនាងគ្រោងតួអក្សរអស់អ្នកដែលបានទទួលយកនៃសត្វនិងអ្នកដែលក្រាបថ្វាយបង្គំរូបចម្លាក់របស់.
19:21 និងអ្នកដទៃទៀតត្រូវបានស្លាប់ដោយដាវដែលចេញពីព្រះឱស្ឋរបស់ព្រះអង្គដែលគង់នៅលើសេះនោះ.
20:2 ហើយគាត់បានចាប់នាគ, ពស់ពីបុរាណ, ដែលជាអារក្សហើយសាតាំង, ហើយគាត់បានចងគាត់សម្រាប់មួយពាន់ឆ្នាំ.
បន្ទាប់ពីហេតុការណ៍ទាំងនេះ, គាត់ត្រូវតែត្រូវបានចេញផ្សាយសម្រាប់ពេលវេលាខ្លីមួយ.
ហើយពួកគេបានអង្គុយនៅលើពួកគេ.
និងព្រលឹងនៃអ្នកដែលបានកាត់ក្បាលដោយសារតែការផ្ដល់សក្ខីភាពអំពីព្រះយេស៊ូនិងដោយសារតែព្រះបន្ទូលរបស់ព្រះ, និងអ្នកដែលមិនស្រឡាញ់សត្វនោះ, ឬរូបភាពរបស់គាត់, ឬទទួលយកតួអក្សររបស់គាត់នៅលើថ្ងាសរបស់គេឬនៅលើដៃរបស់ពួកគេ: ពួកគេបានរស់ហើយពួកគេបានសោយរាជ្យជាមួយព្រះគ្រិស្ដក្នុងរយៈពេលមួយពាន់ឆ្នាំ.
នេះគឺជាការរស់ឡើងវិញជាលើកទីមួយ.
នៅលើទាំងនេះសេចក្ដីស្លាប់ទីពីរគ្មានអំណាចទេ.
20:7 ហើយនៅពេលដែលពាន់ឆ្នាំនឹងត្រូវបានបញ្ចប់, សាតាំងនឹងត្រូវដោះលែងពីពន្ធនាគាររបស់គាត់, ហើយគាត់នឹងចេញទៅក្រៅនិងរបលោមប្រជាជាតិនានាដែលនៅពីលើទិសទាំងបួននៃផែនដី, កុកនិងម៉ាកូ.
20:8 ហើយពួកគេបានកើនឡើងនៅទូទាំងទទឹងនៃផែនដី, ហើយពួកគេហ៊ុំព័ទ្ធជំរំរបស់ពួកបរិសុទ្ធនិងទីក្រុងជាទីស្រឡាញ់.
មារ, ដែលបានគ្រោងឱ្យពួកគេ, ត្រូវបោះទៅក្នុងអាងទឹកនៃភ្លើងនិងស្ពាន់ធ័រដែលមាន,
និងសៀវភៅត្រូវបានបើក.
និងមនុស្សស្លាប់ត្រូវបានគេវិនិច្ឆ័យដោយរឿងទាំងនោះដែលត្រូវបានសរសេរនៅក្នុងសៀវភៅនេះ, នេះបើយោងតាមការប្រព្រឹត្ដរបស់ខ្លួន.
សេចក្ដីស្លាប់និងស្ថានមច្ចុរាជប្រគល់មនុស្សស្លាប់របស់ពួកគេដែលនៅក្នុងពួកគេ.
21:2 ហើយខ្ញុំ, លោក យ៉ូហាន, ឃើញទីក្រុងបរិសុទ្ធ, ក្រុងយេរូសាឡឹមថ្មី, ចុះពីស្ថានបរមសុខមកពីព្រះជាម្ចាស់, រៀបចំដូចកូនក្រមុំតាក់តែងសម្រាប់ប្តីរបស់នាង.
ហើយគាត់នឹងស្ថិតនៅជាមួយពួកគេ, ហើយពួកគេនឹងក្លាយជាប្រជារាស្ត្ររបស់ព្រះអង្គ.
21:4 ហើយព្រះទ្រង់នឹងជូតទឹកភ្នែកចេញអស់ពីភ្នែករបស់គេ.
និងកាន់ទុក្ខមិនមាន, ឬស្រែក, ឬទុក្ខព្រួយនឹងត្រូវបានទៀតទេ.
21:5 និងមួយដែលត្រូវបានគេអង្គុយនៅលើបល្ល័ង្ក, បាន និយាយ ថា :, « មើល !, ខ្ញុំបានធ្វើឱ្យអ្វីទាំងអស់ដែលថ្មី "។ ហើយគាត់បាននិយាយមកខ្ញុំ, "សរសេរ, សម្រាប់ពាក្យទាំងនេះគឺស្មោះត្រង់និងពិតទាំងស្រុង»។
ខ្ញុំជាអាល់ផានិងជាអូមេនេះ, ដើមដំបូង និង ជា ចុង បំផុត.
21:7 អ្នកណារៀលនឹងគ្រប់គ្រងលើរឿងទាំងនេះ.
21:8 ប៉ុន្តែការភ័យខ្លាច, និងការមិនជឿ, អំពើគួរស្អប់ខ្ពើម, សម្លាប់, និងការកំផិត, និងអ្នកប្រើថ្នាំ, ពួកថ្វាយបង្គំព្រះក្លែងក្លាយ, និងពួកកុហកទាំងប៉ុន្មាន, ទាំងនេះនឹងជាផ្នែកមួយនៃអាងទឹកមួយដែលដុតជាមួយភ្លើងនិងស្ពាន់ធ័រ, ដែលជាសេចក្ដីស្លាប់ទីពីរ "។
និងឈ្មោះត្រូវបានសរសេរលើគេ, ដែលជាឈ្មោះនៃកុលសម្ព័ន្ធទាំងដប់ពីររបស់ជនជាតិអ៊ីស្រាអែលដែរ.
21:14 កំពែងរបស់ក្រុងមានគ្រឹះដប់ពីររូប.
21:15 ហើយគាត់ដែលត្រូវបានគេនិយាយជាមួយខ្ញុំកាន់ឈើរង្វាស់ដែលមានមាស, នៅក្នុងគោលបំណងដើម្បីវាស់ក្រុង, ហើយទ្វារនិងកំពែងក្រុង.
21:18 និងរចនាសម្ព័ន្ធនៃជញ្ជាំងរបស់វាធ្វើពីត្បូងមណីជោតិរស.
21:19 គ្រឹះរបស់កំពែងនៃទីក្រុងនេះត្រូវបានគេតុបតែងដោយគ្រប់ប្រភេទនៃដុំថ្មមានតម្លៃ.
ហើយនៅលើផ្លូវធំនៃក្រុងនោះធ្វើពីមាសសុទ្ធ, ស្រដៀងគ្នាទៅនឹងកញ្ចក់ថ្លា.
ដ្បិតព្រះជាអម្ចាស់នៃពិភពទាំងមូលជាព្រះវិហាររបស់ខ្លួន, និងកូនចៀម.
និងស្ដេចនៃផែនដីនឹងនាំយកមកនូវសិរីរុងរឿងនិងកិត្តិយសរបស់ពួកគេចូលទៅក្នុងវា.
22:2 នៅកណ្តាលផ្លូវធំរបស់ខ្លួន, និងនៅលើភាគីទាំងពីរនៃទន្លេនេះ, ជាដើមឈើនៃជីវិត, ផ្លែដប់ពីរផ្លែឈើ, ផ្តល់ជូននូវផ្លែឈើមួយសម្រាប់ខែនីមួយ, និងស្លឹកនៃមែកធាងនេះគឺសម្រាប់សុខភាពរបស់ប្រជាជាតិទាំងឡាយ.
ប៉ុន្តែបល្ល័ង្ករបស់ព្រះជាម្ចាស់និងរបស់កូនចៀមនេះនឹងមាននៅក្នុងវា, និងពួកអ្នកបំរើរបស់ព្រះអង្គនាំគ្នាគោរពថ្វាយបង្គំព្រះអង្គ.
ហើយឈ្មោះរបស់គាត់នឹងត្រូវនៅលើថ្ងាសរបស់ពួកគេ.
ហើយពួកគេនឹងមិនត្រូវការពន្លឺចង្កៀងមួយ, ឬពន្លឺនៃព្រះអាទិត្យនេះ, ដោយសារតែព្រះជាអម្ចាស់នឹងបំភ្លឺពួកគេ.
22:6 ហើយ គាត់ បាន និយាយ ថា ឱ្យ ខ្ញុំ: «ពាក្យទាំងនេះគឺពិតនិងស្មោះត្រង់ទាំងស្រុងហើយ»។ ព្រះអម្ចាស់, ជាព្រះនៃវិញ្ញាណរបស់ពួកព្យាការី, ចាត់ទេវតារបស់ព្រះអង្គបើកបង្ហាញដល់អ្នកបំរើរបស់គាត់ពីអ្វីដែលត្រូវកើតមានឡើងក្នុងពេលឆាប់:
ហើយ ការ, បន្ទាប់ពីខ្ញុំបានឮនិងបានឃើញ, ខ្ញុំធ្លាក់ចុះ, ដូច្នេះដើម្បីជាការស្រលាញ់នៅទៀបជើងទេវតានោះ, ដែលត្រូវបានគេបង្ហាញរឿងទាំងនេះមកឱ្យខ្ញុំ.
ដ្បិតទូលបង្គំជាអ្នកបំរើបងប្អូនរបស់អ្នក, ហើយខ្ញុំនៅក្នុងចំណោមបងប្អូនរបស់ពួកព្យាការី, និងអស់អ្នកដែលរក្សាក្នុងចំណោមពាក្យថ្លែងទុកក្នុងសៀវភៅនេះ.
ហើយអ្នកណាគឺគ្រាន់តែជា, គាត់នៅតែអាចមានគ្រាន់តែជាការ.
22:18 ដ្បិតយើងបានហៅអ្នកស្តាប់ទាំងអស់គ្នាជាសាក្សីនៃពាក្យដែលមានថ្លែងទុកក្នុងសៀវភៅនេះ.
22:19 ហើយប្រសិនបើនរណាម្នាក់នឹងបានយកទៅឆ្ងាយពីពាក្យនៃសៀវភៅនៃទំនាយនេះ, ព្រះទ្រង់នឹងដកចំណែករបស់គាត់ពីសៀវភៅជីវិត, និងពីទីក្រុងបរិសុទ្ធ, និងពីរឿងទាំងនេះដែលត្រូវបានសរសេរក្នុងសៀវភៅនេះ.
1:1 លោក ប៉ូល, ជាសាវ័ករបស់ព្រះគ្រិស្ដយេស៊ូតាមព្រះហឫទ័យរបស់ព្រះជាម្ចាស់, និងធីម៉ូថេ, បងប្រុសម្នាក់បាន,
1:16 ដ្បិតត្រូវបានបង្កើតអ្វីគ្រប់យ៉ាងនៅក្នុងស្ថានបរមសុខនិងនៅលើផែនដី, ដែលអាចមើលឃើញនិងមើលមិនឃើញ, ថាតើបល្ល័ង្ក, ឬការត្រួតត្រា, ឬក្សត្រ, ឬមហាអំណាច.
1:17 ហើយគាត់គឺមុនពេលទាំងអស់, ហើយនៅក្នុងការគាត់គ្រប់ទាំងអស់បន្ត.
គាត់គឺជាការចាប់ផ្តើម, នេះជាលើកដំបូងដែលកើតពីស្លាប់ឡើងវិញ, ដូច្នេះក្នុងគ្រប់កិច្ចការទាំងអស់ដែលគាត់អាចកាន់ការ primacy.
2:7 ចូរមានឫសគល់និងបានសាងសង់ឡើងនៅក្នុងព្រះគ្រិស្ដបន្ត.
2:12 អ្នកត្រូវបានគេកប់ជាមួយគាត់នៅក្នុងការទទួលបុណ្យជ្រមុជទឹក.
ហើយគាត់បានយកវាចេញឆ្ងាយពីពាក់កណ្តាលរបស់អ្នក, affixing វាទៅឈើឆ្កាង.
ព្រោះដូចព្រះអម្ចាស់បានលើកលែងទោសអ្នក, ដូច្នេះអ្នកត្រូវតែធ្វើ.
3:15 និងអនុញ្ញាតឱ្យសេចក្ដីសុខសាន្ដរបស់ព្រះគ្រីស្ទលើកដួងចិត្តអ្នក.
ត្រូវអរព្រះគុណព្រះអង្គ.
សម្រាប់ការនេះគឺជាការល្អគាប់ព្រះហឫទ័យព្រះអម្ចាស់.
18:6 រីឯអ្នកដែលនឹងត្រូវបានវង្វេងមួយក្នុងចំណោមអ្នកតូចតាចនេះ, អ្នកដែលទុកចិត្តនៅក្នុងខ្ញុំ, វានឹងជាការប្រសើរសម្រាប់គាត់ដើម្បីឱ្យមានត្បាល់កិនចងករបស់គាត់, និងត្រូវបានលិចទឹកក្នុងជម្រៅនៃសមុទ្រ.
ទោះបីជាវាគឺជាការចាំបាច់សម្រាប់ការល្បួងកើតឡើង, ទោះជាយ៉ាងណា: វេទនាដល់មនុស្សម្នាក់តាមរយៈការដែលកើតឡើងថាការល្បួង!
វាជាការល្អប្រសើរជាងមុនសម្រាប់អ្នកចូលទៅក្នុងជីវិតមានតែភ្នែកម្ខាង, ជាជាងការត្រូវបានផ្ញើទៅក្នុងភ្លើងនរកមានភ្នែកពីរនេះ.
14:1 បុណ្យចម្លងនិងបុណ្យនំបុ័ងឥតមេនេះគឺពីរថ្ងៃទៅឆ្ងាយ.
និងការបំបែកបើកចំហធុងថ្មកែវនេះ, នាងបានចាក់វានៅលើក្បាលរបស់គាត់.
14:5 បើយកប្រេងនេះអាចលក់បានជាងបីរយដួងហើយត្រូវបានផ្តល់ដល់ជនក្រីក្រវិញ»។ អ្នកទាំងនោះខឹងនឹងនាង.
តើអ្វីជាហេតុផលដែលគឺថាអ្នកមានបញ្ហារបស់នាង?
ប៉ុន្តែអ្នកមិនមានខ្ញុំជានិច្ច.
នាងបានមកដល់នៅក្នុងការជាមុនដើម្បីអប់ព្រះសពរបស់ខ្ញុំសម្រាប់ការបញ្ចុះសព.
14:10 យូដាសអ៊ីស្ការីយ៉ុនិង, មួយក្នុងចំណោមសិស្សទាំងដប់ពីររូប, ទៅឆ្ងាយ, ទៅពួកសម្ដេចសង្ឃនេះ, ក្នុងគោលបំណងដើម្បីប្រគល់ព្រះអង្គទៅឱ្យពួកគេ.
ហើយពួកគេបានសន្យាថាលោកថាពួកគេនឹងអោយប្រាក់គាត់.
14:12 នៅថ្ងៃដំបូងនៃបុណ្យនំបុ័ងឥតមេ, នៅពេលដែលពួកគេ immolate បុណ្យចម្លង *, ពួកសិស្សទូលទៅព្រះអង្គ, «តើអ្នកចង់ឱ្យយើងទៅរៀបចំសម្រាប់អ្នកដើម្បីបរិភោគក្នុងឱកាសបុណ្យចម្លងនៅកន្លែងណា?"
ហើយអ្នកនឹងជួបបុរសម្នាក់លីក្អមទឹក; ដើរតាម គាត់.
14:16 ពួកសិស្សរបស់លោកបានចាកចេញហើយចូលទៅក្នុងទីក្រុង.
14:22 ហើយខណៈពេលដែលពួកគេបានបរិភោគជាមួយ, ព្រះយេស៊ូយកនំបុ័ង.
ហើយពួកគេទាំងអស់គ្នាបានផឹកពីវា.
14:25 ខ្ញុំ សុំ ប្រាប់ អោយ អ្នក រាល់ គ្នា, ខ្ញុំនឹងផឹកដែលបានទៀតទេពីទំពាំងបាយជូរនេះ, រហូតដល់ថ្ងៃដែលខ្ញុំនឹងពិសាស្រាទំពាំងបាយជូរថ្មីនៅក្នុងនគរនៃព្រះ»។
14:35 ហើយនៅពេលដែលគាត់បានបន្តនៅលើវិធីតិចតួច, គាត់បានធ្លាក់ចុះក្រាបថ្វាយបង្គំលើដី.
ហើយគាត់បាននិយាយទៅលោកពេត្រុស: «ស៊ីម៉ូន, តើអ្នកកំពុងដេកលក់?
14:38 ចូរប្រុងស្មារតីហើយអធិស្ឋាន, ដូច្នេះអ្នកអាចនឹងមិនចាញ់ការល្បួងឡើយ.
14:39 ព្រះអង្គយាងចេញទៅឆ្ងាយជាថ្មីម្តងទៀត, គាត់បានអធិស្ឋាន, ប្រើពាក្យដដែល.
ម៉ោងនេះបានមកដល់.
14:43 ហើយខណៈពេលដែលគាត់នៅតែត្រូវបានគេនិយាយ, យូដាសអ៊ីស្ការីយ៉ុ, មួយក្នុងចំណោមសិស្សទាំងដប់ពីររូប, មកដល់, ហើយជាមួយនឹងគាត់គឺជាមនុស្សមួយក្រុមធំកាន់ដាវកាន់ដំបង, ផ្ញើពីមេដឹកនាំរបស់ក្រុមបូជាចារ្យ, និង ពួក អាចារ្យ *, និងពួកព្រឹទ្ធាចារ្យ *.
14:48 ហើយ នៅ ក្នុង ការ ឆ្លើយ តប, ព្រះយេស៊ូ មាន ព្រះបន្ទូល ទៅ ពួក គេ: "អ្នកបានកំណត់ឱ្យខ្ញុំចេញទៅចាប់បាន, គ្រាន់តែដូចជាប្រសិនបើដើម្បីចោរប្លន់, កាន់ដាវកាន់ដំបង?
14:51 ឥឡូវនេះបុរសវ័យក្មេងម្នាក់ដែលបានដើរតាមព្រះអង្គ, មានអ្វីទេមានតែសំពត់ទេសឯកនៅលើខ្លួនគាត់ផ្ទាល់.
14:52 ប៉ុន្តែ គាត់, បដិសេធការផាកពិន័យសំពត់, រត់គេចខ្លួនពីពួកគេអាក្រាត.
ពួកបូជាចារ្យទាំងអស់និងពួកអាចារ្យ * និងពួកព្រឹទ្ធាចារ្យបានមកជាមួយគ្នា.
ហើយគាត់បានអង្គុយជាមួយកងនៅភ្លើងនិងកំដៅដោយខ្លួនឯង.
14:56 សម្រាប់មនុស្សជាច្រើនបាននិយាយទីបន្ទាល់ក្លែងក្លាយចោទប្រកាន់ព្រះអង្គ, ប៉ុន្តែទីបន្ទាល់របស់ពួកគេមិនបានយល់ព្រម.
14:58 "ដ្បិតយើងបានឮគាត់និយាយ, "ខ្ញុំនឹងរុះព្រះវិហារនេះ, ធ្វើដោយដៃ, ហើយក្នុងរវាងបីថ្ងៃខ្ញុំនឹងសង់ព្រះវិហារមួយផ្សេងទៀត, មិនមែនសង់ដោយដៃ»។
14:60 មហាបូជាចារ្យ, ការកើនឡើងការកើនឡើងនៅក្នុងចំណោមពួកគេ, សួរព្រះយេស៊ូ, និយាយ ថា :, «តើអ្នកមានអ្វីដែលត្រូវនិយាយថានៅក្នុងចម្លើយទៅនឹងអ្វីដែលត្រូវបានគេនាំយកមកប្រឆាំងនឹងអ្នកដោយពួកអ្នកទាំងនេះ?"
ជា ថ្មី ម្តង ទៀត, មហាបូជាចារ្យសួរព្រះអង្គ, ហើយ គាត់ បាន និយាយ ទៅ គាត់ ថា, «តើអ្នកជាព្រះគ្រិស្ដ, ជាព្រះរាជបុត្រានៃព្រះដែលយើងសរសើរតម្កើង?"
ហើយអ្នកនឹងឃើញបុត្រមនុស្សគង់នៅនៅខាងស្ដាំនៃអំណាចរបស់ព្រះជាម្ចាស់និងមកដល់ជាមួយពពកនៅលើមេឃ»។
14:65 អ្នកខ្លះនាំគ្នាស្ដោះទឹកមាត់ដាក់ព្រះអង្គ, និងដើម្បីគ្របដណ្តប់មុខរបស់គាត់និងដើម្បីប្រហារគាត់ដោយវាយតប់, និងដើម្បីនិយាយទៅគាត់, «ទាយមើល៍»។ ហើយពួកអ្នកបំរើដែលបានវាយប្រហារគាត់ដោយដើមត្នោតដៃរបស់ពួកគេ.
14:67 ហើយនៅពេលដែលនាងបានឃើញលោកពេត្រុសកំពុងអាំងភ្លើង, នាងបានសម្លឹងមើលគាត់, ហើយ នាង បាន និយាយ ថា :: «អ្នកផងដែរពួករបស់យេស៊ូជាអ្នកភូមិណាសារ៉ែត»។
14:69 បន្ទាប់មកជាថ្មីម្តងទៀត, នៅពេលដែលស្រីបានឃើញគាត់, នាងចាប់ផ្តើមនិយាយទៅកាន់ទីនោះ, "សម្រាប់ការនេះគឺជាការមួយនៃពួកគេ»។
ហើយបន្ទាប់ពីមួយខណៈពេលតិចតួច, ជាថ្មីម្តងទៀតអ្នកដែលឈរនៅក្បែរនិយាយទៅលោកពេត្រុស: «នៅក្នុងការពិត, អ្នកគឺជាផ្នែកមួយនៃពួកគេ.
14:71 បន្ទាប់មកគាត់បានចាប់ផ្តើមដាក់បណ្តាសានិងដើម្បីស្បថ, និយាយ ថា :, "សម្រាប់ខ្ញុំមិនដឹងថាបុរសម្នាក់នេះ, អំពីដែលអ្នកកំពុងនិយាយ»។
លោកពេត្រុសនឹកឃើញពាក្យដែលព្រះយេស៊ូបានមានបន្ទូលទៅគាត់, "មុនមាន់រងាវពីរដង, អ្នកនឹងបដិសេធខ្ញុំបីដង។ "ហើយគាត់បានចាប់ផ្តើមយំ. ទទួល បាន អភិបូជា តួលេខ ដោយ អ៊ី ម៉ែ ល
1:2 និងជីវិតដែលត្រូវបានធ្វើឡើងសម្ដែង.
1:3 លោកដែលយើងបានឃើញនិងបានឮ, យើងបានប្រកាសដល់អ្នក, ដូច្នេះអ្នក, ពេក, បានចូលរួមរស់ជាមួយយើង, ហើយដូច្នេះរបស់យើងប្រកបអាចមានជាមួយព្រះបិតានិងជាមួយព្រះយេស៊ូគ្រិស្ដជាព្រះបុត្រារបស់ព្រះអង្គ.
1:7 ប៉ុន្ដែប្រសិនបើយើងរស់ក្នុងពន្លឺ, គ្រាន់តែជាការដែលគាត់ផងដែរដែលគង់នៅក្នុងពន្លឺ, បន្ទាប់មកយើងមានប្រកបជាមួយនរណាម្នាក់ផ្សេងទៀត, ហើយព្រះលោហិតរបស់ព្រះយេស៊ូគ្រិស្ដ, កូនប្រុស របស់ គាត់, សំអាតយើងរាល់គ្នាពីគ្រប់អំពើបាបទាំងអស់.
1:9 ប្រសិនបើយើងទទួលសារភាពអំពើបាបរបស់យើង, បន្ទាប់មកគាត់គ្រាន់តែមានចិត្តស្មោះត្រង់ហើយ, ដូច្នេះជានឹងអត់ទោសយើងអោយរួចពីបាបរបស់យើងហើយនឹងសំអាតយើងពីអំពើទុច្ចរិតគ្រប់យ៉ាង.
ប៉ុន្តែប្រសិនបើមាននរណាម្នាក់បានប្រព្រឹត្តអំពើបាប, យើងមានអ្នកតស៊ូមតិជាមួយព្រះបិតាមួយ, ព្រះ យេស៊ូ វ គ្រី ស្ទ បាន, នេះគ្រាន់តែមួយ.
និងមិនត្រឹមតែសម្រាប់អំពើបាបរបស់យើង, ប៉ុន្តែថែមទាំងសម្រាប់អ្នកដែលពិភពលោកទាំងមូល.
2:4 អ្នកណាអះអាងថាគាត់ដឹងថាគាត់, តែមិនកាន់តាមបទបញ្ជារបស់ព្រះអង្គ, និយាយកុហក, ហើយការពិតគឺមិនមែននៅក្នុងលោក.
និងដោយនេះយើងដឹងថាយើងពិតជាស្ថិតនៅក្នុងព្រះអង្គ.
2:7 ស្រឡាញ់ បំផុត, ខ្ញុំមិនសរសេរទៅបញ្ញត្ដិថ្មី, ប៉ុន្តែញ្ញត្ដិចាស់, ដែលអ្នកបានមកពីការចាប់ផ្តើម.
2:8 បន្ទាប់មកផងដែរ, ខ្ញុំសរសេរមកបញ្ញត្ដិថ្មី, ដែលជាសេចក្តីពិតនៅក្នុងព្រះអង្គនិងនៅក្នុងអ្នក.
2:9 អ្នកណាប្រកាសថាខ្លួនជាអ្នកនៅក្នុងពន្លឺ, និងនៅឡើយទេស្អប់បងប្អូនរបស់ខ្លួន, ស្ថិតនៅក្នុងសេចក្ដីងងឹតសូម្បីតែឥឡូវនេះ.
2:11 រីឯអ្នកណាស្អប់បងប្អូនរបស់គាត់គឺនៅក្នុងសេចក្ដីងងឹត, ហើយនៅក្នុងភាពងងឹតដែលគាត់ដើរ, ហើយគាត់មិនបានដឹងថាកន្លែងដែលលោកនឹង.
ដោយនេះ, យើងដឹងថាវាគឺជាពេលចុងក្រោយបំផុត.
ចំពោះ, ប្រសិនបើពួកគេបានយើង, ពិតណាស់ពួកគេនឹងនៅជាមួយយើង.
2:20 ប៉ុន្តែអ្នកមានចាក់ប្រេងតាំងរបស់បរិសុទ្ធមួយនេះ, ហើយអ្នកដឹងថាអ្វីគ្រប់.
ចំពោះការគ្មានពាក្យកុហកណាកើតមកពីសេចក្ដីពិតទាល់តែសោះ.
មួយនេះគឺមេប្រឆាំងព្រះគ្រិស្ដ, អ្នកដែលបានបដិសេធព្រះវរបិតានិងព្រះរាជបុត្រា.
អ្នកណាទទួលស្គាល់ព្រះបុត្រា, មានព្រះបិតា.
ប្រសិនបើអ្វីដែលអ្នកបានឮពីការចាប់ផ្តើមនៅតែមាននៅក្នុងអ្នក, បន្ទាប់មក អ្នក, ពេក, នឹងស្ថិតនៅជាប់នឹងព្រះបុត្រានិងព្រះបិតាដែរ.
2:26 ខ្ញុំសរសេរសេចក្ដីទាំងនេះប្រាប់អ្នករាល់គ្នា, ដោយសារតែពួកអ្នកដែលនឹងរបលោមអ្នក.
ដូច្នេះ ហើយ, អ្នកមានមិនត្រូវការអោយនរណាមកបង្រៀនអ្នក.
3:7 កូនប្រុសតិចតួច, សូមឱ្យនរណាម្នាក់មកបញ្ឆោតអ្នក.
3:8 អ្នកណាប្រព្រឹត្តអំពើបាបជារបស់អារក្ស.
សម្រាប់ ហេតុផល នេះ, ព្រះបុត្រារបស់ព្រះជាម្ចាស់បានយាង, ដូច្នេះគាត់អាចលុបបំបាត់ការប្រព្រឹត្ដរបស់មារ.
ចំពោះពូជរបស់ព្រះជាម្ចាស់អ្នកនោះស្ថិតនៅក្នុងពួកគេ, ហើយគាត់គឺមិនអាចប្រព្រឹត្តអំពើបាប, ដោយសារតែគាត់ត្រូវបានគេកើតមកពីព្រះជាម្ចាស់.
គ្រប់គ្នាដែលមិនមែនគ្រាន់តែ, មិនមែនជារបស់ព្រះជាម្ចាស់, ដូចមាននរណាម្នាក់ដែលមិនស្រឡាញ់បងប្អូនរបស់គាត់.
ដោយសារតែការប្រព្រឹត្ដរបស់គាត់សុទ្ធតែអាក្រក់, ប៉ុន្តែការប្រព្រឹត្ដបងប្រុសរបស់គាត់ត្រូវបានគេគ្រាន់តែជាការ.
3:14 យើងដឹងហើយថាយើងបានឆ្លងផុតពីសេចក្ដីស្លាប់មកកាន់ជីវិត.
អ្នកណាមិនស្រឡាញ់, ស្ថិតនៅក្នុងសេចក្ដីស្លាប់.
ហើយអ្នកបានដឹងហើយថាឃាតកគ្មានជីវិតអស់កល្បជានិច្ចស្ថិតនៅក្នុងខ្លួនគេនោះ.
3:17 អ្នកណាមានទំនិញរបស់ពិភពលោកនេះ, ហើយឃើញបងប្អូនរបស់ខ្លួនដើម្បីឱ្យមាននៅក្នុងតម្រូវការ, និងនៅឡើយទេបិទបេះដូងរបស់គាត់ទៅគាត់: នៅក្នុងអ្វីដែលជាវិធីធ្វើសេចក្ដីស្រឡាញ់របស់ព្រះជាម្ចាស់ស្ថិតនៅក្នុងលោក?
3:19 នៅក្នុងវិធីនេះ, យើងនឹងដឹងថាយើងកើតមកពីសេចក្ដីពិត, ហើយយើងនឹងសរសើរដល់ដួងចិត្តរបស់យើងនៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអង្គ.
3:21 ស្រឡាញ់ បំផុត, ប្រសិនបើចិត្ដគំនិតរបស់យើងមិនប្រមាថមើលងាយយើង, យើងអាចមានចិត្ដរឹងប៉ឹងនៅចំពោះព្រះជាម្ចាស់;
ព្រោះយើងកាន់តាមបទបញ្ជារបស់ព្រះអង្គ, ហើយយើងធ្វើអ្វីដែលត្រូវបានគេចំពោះព្រះភ័ក្ដ្រព្រះអង្គសព្វព្រះហឫទ័យ.
3:24 ហើយអស់អ្នកដែលកាន់តាមបទបញ្ជារបស់ព្រះអង្គស្ថិតនៅជាប់នឹងគាត់, ហើយគាត់នៅក្នុងពួកគេ.
ចំពោះព្យាការីក្លែងក្លាយជាច្រើនបានមកក្នុងលោកនេះ.
ជារៀងរាល់ស្មារតីអ្នកដែលទទួលស្គាល់ថាព្រះយេស៊ូគ្រិស្ដបានមកដល់នៅក្នុងសាច់ឈាមជាព្រះ;
និងមួយនេះគឺជាមេប្រឆាំងព្រះគ្រិស្ដ, មួយដែលអ្នកបានឮត្រូវបានយាងមក, និងសូម្បីតែឥឡូវនេះគាត់នៅលើពិភពលោក.
ហេតុនេះ ហើយ បាន ជា, ពួកគេបាននិយាយអំពីពិភពលោក, ហើយមនុស្សលោកស្ដាប់ដល់ពួកគេ.
អ្នកណាស្គាល់ព្រះជាម្ចាស់, សណ្ដាប់យើង.
នៅក្នុងវិធីនេះ, យើងដឹងថាព្រះវិញ្ញាណដែលសំដែងសេចក្ដីពិតពីស្មារតីនៃកំហុស.
ព្រោះសេចក្ដីស្រឡាញ់របស់ព្រះជាម្ចាស់.
4:8 អ្នកណាមិនស្រឡាញ់, មិនស្គាល់ព្រះជាម្ចាស់.
4:9 សេចក្ដីស្រឡាញ់របស់ព្រះត្រូវបានធ្វើឡើងច្បាស់ដល់ពួកយើងនៅក្នុងវិធីនេះ: ថាព្រះបានចាត់បុត្រតែមួយរបស់លោកចូលទៅក្នុងពិភពលោក, ដូច្នេះយើងមានជីវិតដោយសារព្រះបុត្រា.
4:11 ស្រឡាញ់ បំផុត, ប្រសិនបើព្រះជាម្ចាស់បានស្រឡាញ់យើងដូច្នេះ, យើងគួរតែស្រឡាញ់គ្នាទៅវិញទៅមក.
ប៉ុន្តែប្រសិនបើយើងស្រឡាញ់គ្នាទៅវិញទៅមក, ព្រះជាម្ចាស់ស្ថិតនៅជាប់នឹងយើង, ហើយសេចក្ដីស្រឡាញ់របស់ព្រះអង្គបានគ្រប់លក្ខណៈនៅក្នុងយើង.
4:14 ហើយយើងបានឃើញ, ហើយយើងធ្វើជាបន្ទាល់បញ្ជាក់, ថាព្រះបិតាបានចាត់ព្រះបុត្រារបស់ព្រះអង្គដើម្បីជាព្រះអង្គសង្គ្រោះនៃពិភពលោក.
4:16 រីឯយើងវិញយើងបានស្គាល់ព្រះហឫទ័យស្រឡាញ់របស់ព្រះជាម្ចាស់សំរាប់យើងជឿ.
ចំពោះព្រះអង្គដូចគាត់ដែរ, ដូច្នេះយើងមានផងដែរ, ក្នុងពិភពលោកនេះ.
ផ្ទុយ ទៅ វិញ, សេចក្ដីស្រឡាញ់ការល្អឥតខ្ចោះបណ្ដេញការភ័យខ្លាច, សម្រាប់ការភ័យខ្លាចជាប់ទាក់ទងទៅនឹងការផ្តន្ទាទោស.
អ្នកណាមិនស្រឡាញ់បងប្អូនរបស់គាត់, អ្នកដែលគាត់មិនឃើញ, នៅក្នុងអ្វីដែលជាវិធីដែលគាត់អាចស្រឡាញ់ព្រះជាម្ចាស់, អ្នកដែលគាត់មិនបានមើលឃើញ?
អ្នកណាមានចិត្ដស្រឡាញ់របស់ព្រះ, ដែលជាអ្នកផ្តល់កំណើតដែល, ផងដែរស្រឡាញ់គាត់ដែលត្រូវបានគេកើតមកពីព្រះជាម្ចាស់.
5:3 យើងមានសេចក្ដីស្រឡាញ់របស់ព្រះជាម្ចាស់: ដែលយើងកាន់តាមបទបញ្ជារបស់ព្រះអង្គ.
5:4 សម្រាប់ទាំងអស់អ្នកដែលកើតមកពីព្រះជាម្ចាស់សុទ្ធតែឈ្នះលោកីយ៍.
5:5 គឺវាតើអ្នកណាដែលឈ្នះលោកី?
5:6 នេះគឺជាការមួយដែលបានមកដោយទឹកនិងឈាម: ព្រះ យេស៊ូ វ គ្រី ស្ទ បាន.
ហើយព្រះវិញ្ញាណនោះគឺមានម្នាក់ធ្វើជាបន្ទាល់បញ្ជាក់ថាព្រះគ្រិស្ដជាសេចក្តីពិតនេះ.
ហើយទាំងនេះបីគឺមួយ.
ហើយការទាំងបីនេះមានមួយ.
សម្រាប់នេះគឺជាទីបន្ទាល់របស់ព្រះជាម្ចាស់, ដែលជាធំ: ថាលោកបានផ្ដល់សក្ខីភាពអំពីព្រះបុត្រារបស់ព្រះអង្គ.
អ្នកណាមិនជឿលើព្រះបុត្រា, ធ្វើឱ្យគាត់ជាអ្នកកុហក, ដោយសារតែគាត់មិនជឿលើសក្ខីភាពដែលព្រះជាម្ចាស់បានផ្ដល់សក្ខីភាពអំពីព្រះបុត្រារបស់ព្រះអង្គ.
ហើយជីវិតនេះស្ថិតនៅក្នុងព្រះបុត្រារបស់ព្រះអង្គ.
អ្នកណាមិនមានព្រះបុត្រាអ្នកនោះ, មិនមានជីវិត.
5:14 ហើយនេះគឺជាទំនុកចិត្តដែលយើងមានចំពោះព្រះ: ថាបញ្ហាអ្វីដែលយើងត្រូវស្នើទេ, សមស្របនឹងបំណងប្រាថ្នារបស់លោក, ព្រះអង្គទ្រង់ព្រះសណ្ដាប់យើង.
5:16 នរណាម្នាក់ដែលបានដឹងថាបងប្រុសរបស់លោកបានប្រព្រឹត្តអំពើបាប, ជាមួយនឹងការប្រព្រឹត្ដអំពើបាបដែលមិនបណ្ដាលអោយស្លាប់មួយ, អនុញ្ញាតឱ្យគាត់អធិស្ឋាន, និងជីវិតនឹងត្រូវបានផ្តល់ទៅឱ្យគាត់ដែលបានធ្វើបាបរហូតដល់ស្លាប់មិន.
ខ្ញុំមិននិយាយថាមាននរណាម្នាក់គួរតែស្នើសុំក្នុងនាមនៃអំពើបាបនោះ.
ប៉ុន្តែមានគឺជាអំពើបាបអោយស្លាប់.
5:20 ហើយយើងដឹងថាព្រះបុត្រារបស់ព្រះជាម្ចាស់បានមកដល់, ហើយថាលោកបានផ្ដល់ឱ្យយើងនូវការយល់ដឹង, ដូច្នេះយើងអាចដឹងថាព្រះពិត, ហើយដូច្នេះយើងអាចនៅតែក្នុងព្រះបុត្រាពិតរបស់គាត់.
5:21 កូនប្រុសតិចតួច, ចូររក្សាខ្លួនចេញពីការថ្វាយបង្គំមិនពិត.
ចម្លើយយ៉ាងខ្លីគឺដោយព្រះគុណរបស់ព្រះជាម្ចាស់, ប៉ុន្តែមិនមានការបន្ថែមទៀតដើម្បីវា, ជា ការ ពិត ណាស់, រួមទាំងព្រះយេស៊ូវ’ ការលះបង់, សេចក្ដីជំនឿរបស់យើង, និងសកម្មភាពរបស់យើង.
នៅក្នុងន័យមួយចំនួន, ការពិភាក្សានេះមានន័យគឺដោយសារនៅជុំវិញថាតើវាគឺអាចធ្វើបានដើម្បីឱ្យមានជំនឿដោយមិនបង្ហាញវា (ក្នុងការប្រព្រឹត្ដដែលឆ្លុះបញ្ចាំងពីសេចក្ដីស្រឡាញ់របស់ព្រះនិងអ្នកដទៃទៀត).
“យើងបានសុចរិតមកពីព្រះគុណរបស់ព្រះជាម្ចាស់.
ពួកកាតូលិកជឿថាព្រះគុណរបស់ព្រះគឺមានប្រសិទ្ធិភាព.
លើស ពី នេះ ទៀត, ពួកកាតូលិកជឿថាដោយការទទួលយកអំណោយទាននៃព្រះគុណរបស់ព្រះ, យើងត្រូវបានហៅឱ្យធ្វើកិច្ចសហប្រតិបត្តិការជាមួយវា.
ពួកកាតូលិកជឿផងដែរថាការសង្គ្រោះគឺមិនមែនជាព្រឹត្តិការណ៍មួយម៉ោង, ប៉ុន្តែជាដំណើរការដែលជាធម្មតាកើតឡើងអំឡុងពេលមួយជីវិតរបស់មនុស្សម្នាក់.
ដើម្បីយល់ហេតុអ្វីបានជាយើងចាំបាច់ត្រូវបានរក្សាទុក, យើងត្រូវយល់អំពីឫសគល់នៃធម្មជាតិដែលស្រុតរលំរបស់យើង, ឧ, ស៊ិដើម.
មួយអាចមើលវាជាអំពើបាបនៃមោទនភាពមួយ–បំណងប្រាថ្នានេះមិនបំរើអ្នកបង្កើតទេប៉ុន្តែដើម្បីក្លាយដូចជាទ្រង់, ស្មើរបស់គាត់ (សូមមើលសៀវភៅលោកុប្បត្ដិ, 3:5).
ក្នុងនាមជាពួកបរិសុទ្ធប៉ុលបានសរសេរថា, “អំពើបាបបានចូលមកក្នុងពិភពលោកតាមរយៈបុរសម្នាក់ហើយតាមរយៈបាបសេចក្ដីស្លាប់និងសេចក្ដីស្លាប់រាលដាលដល់ដូច្នេះបុរសទាំងអស់ពីព្រោះមនុស្សទាំងអស់បានប្រព្រឹត្តអំពើបាប។” (សូមមើលរបស់គាត់ លិខិត ដើម្បី រ៉ូម 5:12, របស់គាត់និង លិខិត ជា លើក ដំបូង ដើម្បី កូរិនថូស, 15:21-23).
ការស្លាប់របស់គាត់គឺការស្លាប់របស់អ្នកបង្កើតនៃជីវិតនេះ, ការស្លាប់របស់ព្រះជាម្ចាស់.1 (ចំពោះការបន្ថែមទៀតលើការឆ្កាង, សូមទស្សនា ទំព័រ.)
“យើងប្រកាសអំពីព្រះគ្រិស្ដជាប់ឆ្កាង,” បានប្រកាសនៅក្នុងលិខិតសន្តប៉ូលលើកដំបូងរបស់លោកទៅកាន់ក្រុងកូរិនថូស (1:23), “ប្លុកជំពប់ជើងដួលទៅពួកសាសន៍យូដានិងភាពល្ងីល្ងើរបស់សាសន៍ដទៃ។”
ចំណាំ, ពេក, ថាការឆ្កាងនេះត្រូវបានគេព្យាករណ៍និងតំណាងនៅក្នុងទំព័រនៃគម្ពីរសញ្ញាចាស់, ដែលជាកន្លែងដែលព្យាការីអេសាយបានសរសេរ, «ទ្រង់បានធ្វើជាទុក្ខព្រួយរបស់យើងនិងការអនុវត្តទុក្ខព្រួយរបស់យើង; នៅឡើយទេយើងមិនបានរាប់អានទ្រង់ច្រងោ, គេវាយដំដោយព្រះ, និងការរងទុក្ខ.
នៅ ក្នុង ការ ពិត, ព្រះយេស៊ូវបានដកស្រង់នេះ 22ទី ទំនុកតម្កើងពីឈើឆ្កាង, ការបើកសូត្របន្ទាត់, « ព្រះ នៃ ទូលបង្គំ, ជា ព្រះ របស់ ខ្ញុំ, ហេតុអ្វីបានជាព្រះអង្គបោះបង់ទូលបង្គំចោល?
ការទំនុកដំកើងរបស់ 18ទី ខ, «ពួកគេបានចែកសម្លៀកបំពាក់របស់ខ្ញុំក្នុងចំណោមពួកគេ, និងសម្រាប់សម្លៀកបំពាក់របស់ខ្ញុំពួកគេបានចាប់ឆ្នោត,"ទាក់ទងដោយផ្ទាល់ទៅព្រឹត្តិការណ៍នៃការឆ្កាងហើយត្រូវបានលើកឡើងនៅក្នុង ដំណឹងល្អ យ៉ូហាន 19:23-24.
យើងមើលឃើញថាការលះបង់របស់ព្រះគ្រីស្ទបង្ហាញឱ្យឃើញទុកជាមុនក្នុងរូបភាពរបស់អ៊ីសាក trudging រួមជាមួយឈើបានលះបង់តង្វាយរបស់លោកលើខ្នងរបស់គាត់ (មើល ឃើញ លោ កុ ប្ប ត្តិ 22:6; សូមមើលផងដែរពួកបរិសុទ្ធនៃអាឡិចសាន់ Clement បាន, គ្រូបង្រៀនរបស់កុមារ 1:5:23:1).
ការរស់ឡើងវិញ បង្ហាញអំណាចគ្រប់គ្រងលើការស្លាប់របស់គាត់សរុប, ព្រះគ្រិស្ដយេស៊ូបានវិលត្រឡប់មកពីផ្នូរនៅថ្ងៃទីបី.
3:2 មានបុរសម្នាក់, អ្នកពិការជើងពីផ្ទៃម្ដាយ, កំពុងត្រូវបានអនុវត្តនៅ.
3:3 ហើយបុរសម្នាក់នេះ, នៅពេលដែលគាត់បានឃើញពេត្រុសនិងលោកយ៉ូហានបានចាប់ផ្តើមចូលព្រះវិហារបរិសុទ្ធ, ត្រូវបានគេសុំទាន, ដូច្នេះគាត់អាចទទួលទាន.
3:5 ហើយគាត់សម្លឹងចំលើពួកគេ, សង្ឃឹមថាគាត់អាចទទួលបានអ្វីមួយពីពួកគេ.
ប៉ុន្តែអ្វីដែលខ្ញុំមាន, ខ្ញុំបានផ្តល់ឱ្យដល់អ្នក.
3:7 និងការទទួលយកគាត់ដោយដៃខាងស្ដាំ, លោកបានលើកគាត់ឡើង.
3:8 និងសន្ធោសន្ធៅ, គាត់ឈរហើយដើរនៅជុំវិញ.
3:9 និងប្រជាជនទាំងអស់បានឃើញគាត់ដើរនិងឮគាត់សរសើរតម្កើងព្រះជាម្ចាស់.
ហើយពួកគេបានភ័យខ្លាចជាខ្លាំងហើយងឿងឆ្ងល់អំពីហេតុការណ៍ដែលកើតមានដល់គាត់.
3:12 ប៉ុន្ដែលោកពេត្រុស, មើល ឃើញ នេះ, ឆ្លើយតបទៅនឹងប្រជាជន: «បងប្អូនជនជាតិអ៊ីស្រាអែល, ហេតុអ្វីបានជាអ្នកឆ្ងល់ថានៅនេះ?
3:13 ជាព្រះរបស់អាប្រាហាំនិងជាព្រះរបស់អ៊ីសាកនិងជាព្រះរបស់យ៉ាកុប, ជាព្រះនៃបុព្វបុរសរបស់យើង, ទ្រង់បានប្រទានសិរីរុងរឿងមកព្រះយេស៊ូជាអ្នកបំរើ, ដែលអ្នក, ជា ការ ពិត, ប្រគល់និងបានបដិសេធមុខលោកពីឡាត, នៅពេលដែលគាត់ត្រូវបានគេផ្តល់ឱ្យការវិនិច្ឆ័យឱ្យដោះលែងគាត់.
តាមរយៈលោកនិងមានជំនឿថាបុរសម្នាក់នេះបានផ្ដល់ឱ្យសុខភាពពេញលេញនៅចំពោះមុខអ្នកទាំងអស់.
3:18 ប៉ុន្តែនៅក្នុងវិធីនេះព្រះអង្គបានធ្វើតាមអ្វីដែលលោកបានប្រកាសទុកជាមុនតាមរយៈព្យាការីទាំងអស់នេះ: ថាព្រះគ្រិស្ដរបស់លោកនឹងរងទុក្ខ.
3:24 និងពួកព្យាការីទាំងអស់ដែលបាននិយាយ, សាំយូអែលហើយបន្ទាប់មកពី, បានប្រកាសថ្ងៃនេះ.
1:1 បន្ទាប់មកព្រះអម្ចាស់មានព្រះបន្ទូលហៅលោកម៉ូសេនិងលោកបាននិយាយទៅកាន់គាត់ពីព្រះពន្លានៃសក្ខីភាពនេះ, និយាយ ថា ::
1:3 ប្រសិនបើតង្វាយរបស់គាត់នឹងក្លាយជាការសម្លាប់រង្គាលមួយ, ដូចគោ, លោកនឹងផ្តល់ជូននូវបុរសថ្ផីចេសនៅមាត់ទ្វារព្រះពន្លានៃសក្ខីភាពនេះ, ដើម្បីធ្វើឱ្យខ្លួនឯងបានគាប់ព្រះហឫទ័យព្រះអម្ចាស់.
1:6 និងបានទាញចេញស្បែករបស់ជនរងគ្រោះនេះ, ពួកគេនឹងកាត់បន្ថយការចូលទៅក្នុងបំណែកឡើងសន្លាក់នេះ,
1:8 ហើយពួកគេនឹងដាក់ផ្នែកដែលត្រូវបានកាត់បន្ថយនៅក្នុងលំដាប់លើឡើងវា: គឺ, ក្បាល, និងអ្វីទាំងអស់ដែលជាប់ថ្លើម,
បូជាចារ្យត្រូវដុតនៅលើអាសនៈដែលជាតង្វាយដុតទាំងមូលមួយនិងជាការមានក្លិនឈ្ងុយដល់ព្រះអម្ចាស់.
1:11 ហើយគាត់នឹង immolate វានៅផ្នែកម្ខាងនៃអាសនៈដែលមើលទៅចេញទៅទិសខាងជើង, នៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់.
1:12 ពួកគេនឹងចែកអវយវៈ, ក្បាល, និងអ្វីគ្រប់យ៉ាងដែលមានព្រំប្រទល់ថ្លើម.
1:13 ប៉ុ ន្ដែ ជា ការ ពិត, ពោះវៀននិងជើងត្រូវលាងជាមួយពួកគេទឹក.
1:14 ប៉ុន្តែប្រសិនបើតង្វាយរបស់តង្វាយដុតទាំងមូលចំពោះព្រះអម្ចាស់គឺមានសត្វបក្សី, លលកទាំង, ឬព្រាបជំទើរ,
1:16 ប៉ុ ន្ដែ ជា ការ ពិត, craw របស់បំពង់កនិងស្លាបគាត់ត្រូវបោះនៅក្បែរអាសនៈនៅផ្នែកភាគខាងកើត, នៅកន្លែងដែលជាធម្មតាត្រូវបានគេចាក់ផេះចេញ.
វាជាតង្វាយដុតទាំងមូលនិងជាតង្វាយនៃការមានក្លិនឈ្ងុយបំផុតដើម្បីព្រះអម្ចាស់.
2:1 នៅពេលដែលព្រលឹងនឹងផ្តល់ជូននូវតង្វាយនៃយញ្ញបូជាដល់ព្រះអម្ចាស់, តង្វាយរបស់គាត់នឹងត្រូវផាកពិន័យពីម្សៅស្រូវសាលី, ហើយលោកនឹងចាក់ប្រេងលើវា, ហើយគាត់នឹងអង្គុយចុះកំញាន,
ម្នាក់ក្នុងចំណោមពួកគេត្រូវយកម្សៅមួយក្តាប់តូចជាមួយនឹងប្រេងនេះ, ព្រមទាំងគ្រឿងក្រអូបនេះ, ហើយលោកនឹងដាក់វាជាការរំលឹកមួយនៅលើអាសនៈ, ជាមួយក្លិនឈ្ងុយបំផុតដើម្បីព្រះអម្ចាស់.
2:8 នៅពេលដែលអ្នកត្រូវបានផ្តល់ជូនវាទៅព្រះអម្ចាស់, អ្នកនឹងប្រគល់វាទៅក្នុងកណ្ដាប់ដៃរបស់បូជាចារ្យ.
2:10 ប៉ុន្តែអ្វីដែលត្រូវបានចាកចេញនឹងត្រូវបានសម្រាប់អើរ៉ុននិងកូនប្រុសរបស់គាត់, ទីសក្ការៈបំផុតពីតង្វាយរបស់ព្រះអម្ចាស់.
2:12 អ្នកនឹងផ្តល់ជូននូវគ្រាន់តែជាផលដំបូងនៃការទាំងនេះរួមជាមួយនឹងអំណោយទាន.
2:13 អ្វីដែលអ្នកនឹងផ្តល់ជូននូវការលះបង់, អ្នកនឹងរដូវកាលវាជាមួយអំបិល; ទាំងអ្នកត្រូវយកអំបិលនៃសម្ពន្ធមេត្រីជាព្រះរបស់អ្នកដែលបានមកពីការលះបង់របស់អ្នក.
2:14 ប៉ុន្តែប្រសិនបើអ្នកនឹងផ្តល់ជូននូវអំណោយទានដែលជាផលដំបូងនៃស្រូវថ្វាយព្រះអម្ចាស់, ពីស្រូវនៅតែត្រចៀកបៃតង, អ្នកនឹងលីងវានៅភ្លើងឆេះ, និងបំបែកវាបើកចំហនៅក្នុងលក្ខណៈនៃការបរិភោគអាហារ.
2:15 ចាក់ប្រេងលើវា, និងគ្រឿងក្រអូបសម្បើម, ព្រោះវាជាតង្វាយរបស់ព្រះអម្ចាស់.
3:2 ហើយគេនឹងដាក់ដៃលើក្បាលរបស់ជនរងគ្រោះរបស់គាត់, ដុតខ្លូនដែលនឹងត្រូវបាននៅជិតទ្វារចូលព្រះពន្លានៃសក្ខីភាពនេះ.
3:3 ពួកគេនឹងផ្តល់ជូនពីយញ្ញបូជាមេត្រីភាពនេះ, ដែលជាតង្វាយព្រះអម្ចាស់: ជាតិខ្លាញ់ដែលគ្របដណ្តប់សរីរាង្គនេះ, និងជាតិខ្លាញ់អ្វីដែលផ្ទៃខាងក្នុង,
3:5 ពួកគេនឹងដុតវានៅលើអាសនៈដែលជាការសម្លាប់រង្គាលមួយ, ការដាក់ភ្លើងនៅក្រោមឈើ, ដែលជាតង្វាយនៃការមានក្លិនឈ្ងុយបំផុតដើម្បីព្រះអម្ចាស់.
ហើយវានឹងត្រូវបាននៅក្នុងបន្ទប់ល្វែងនៃការដុតខ្លូព្រះពន្លានៃសក្ខីភាពនេះ.
3:9 ពួកគេនឹងផ្តល់ជូនពីជនរងគ្រោះនៃយញ្ញបូជាមេត្រីភាព, ជាយញ្ញបូជាថ្វាយព្រះអម្ចាស់: ជាតិខ្លាញ់, និងគូទទាំងមូល
3:11 បូជាចារ្យត្រូវដុតវានៅលើអាសនៈ, ដែលជាចំណីភ្លើងនិងជាតង្វាយរបស់ព្រះអម្ចាស់.
3:13 លោកនឹងដាក់ដៃលើក្បាលរបស់ខ្លួន, ហើយគាត់នឹង immolate វានៅទ្វារចូលព្រះពន្លានៃសក្ខីភាពនេះ.
3:14 ពួកគេត្រូវយកពីវា, ដើម្បីចិញ្ចឹមភ្លើងរបស់ព្រះអម្ចាស់: ជាតិខ្លាញ់ដែលគ្របដណ្តប់ពោះ, អ្នកដែលគ្របដណ្តប់សរីរាង្គសំខាន់ទាំងអស់,
3:16 បូជាចារ្យត្រូវដុតវានៅលើអាសនៈ, ជាការចិញ្ចឹមបីបាច់ភ្លើងនិងជាក្លិនផ្អែមច្រើនបំផុត.
3:17 ដោយច្បាប់ងូតមួយ, ក្នុងជំនាន់របស់អ្នកនិងក្នុងការទាំងអស់នៃទម្លាប់របស់អ្នក, ជាតិខ្លាញ់ក្នុងឈាមឬមិនត្រូវបរិភោគនៅអ្នកទាំងអស់.
4:3 ប្រសិនបើបូជាចារ្យ, អ្នកដែលត្រូវបានចាក់ប្រេងអភិសេក, នឹងបានប្រព្រឹត្តអំពើបាប, បណ្តាលឱ្យប្រជាជនដើម្បីប្រព្រឹត្តអំពើរំលងមួយ, លោកនឹងផ្តល់ជូនទៅព្រះអម្ចាស់សម្រាប់អំពើបាបរបស់គាត់កូនគោថ្ផីចេស.
ហើយគេនឹងដាក់ដៃលើក្បាលរបស់ខ្លួន, ហើយលោកនឹង immolate វាទៅព្រះអម្ចាស់.
4:6 ហើយជ្រលក់ម្រាមដៃទៅក្នុងឈាម, លោកនឹងប្រោះចំនួនប្រាំពីរដងនៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់, ផ្ទុយវាំងនននៃដែនជម្រកនេះ.
បន្ទាប់មកលោកនឹងចាក់ចេញនៅសល់នៃឈាមនៅជើងអាសនៈនៃការសម្លាប់រង្គាលនៅជិតទ្វារចូលព្រះពន្លា.
4:9 ក្រលៀនតិចតួចពីរ, និងសំណាញ់នោះគឺនៅលើពួកគេនៅជិតជ្រុងនេះ, និងជាតិខ្លាញ់ថ្លើមមួយក្រលៀនតិចតួច,
4:12 និងនៅសល់នៃរាងកាយ, លោកនឹងអនុវត្តទៅឆ្ងាយ, លើសពីជំរំ, ទៅកន្លែងដែលជាកន្លែងដែលជាធម្មតាជាស្អាតផេះត្រូវបានចាក់ចេញ.
មាន, នៅក្នុងកន្លែងដែលជាកន្លែងដែលផេះត្រូវបានចាក់ចេញ, ពួកគេនឹងត្រូវបានដុត.
4:17 ហើយគាត់បានយកម្រាមដៃជ្រលក់ក្នុងវា, ប្រោះចំនួនប្រាំពីរដងផ្ទុយស្បៃមុខនេះ.
ប៉ុន្តែនៅសល់នៃឈាមដែលគាត់នឹងចាក់ត្រង់ជើងអាសនៈនៃការសម្លាប់រង្គាលនេះ, ដែលគឺនៅទ្វារព្រះពន្លានៃសក្ខីភាពនេះ.
4:20 ការធ្វើដូច្នេះដោយមានរូបកូនគោនេះក្នុងលក្ខណៈដូចគ្នាដូចដែលគាត់បានធ្វើពីមុន.
4:21 ប៉ុន្តែកូនគោខ្លួនវាលោកយកទៅឆ្ងាយ, លើសពីជំរំ, ហើយគាត់នឹងដុត, គ្រាន់តែដូចជាជាមួយនឹងកូនគោមុន, ដោយសារតែវាគឺសម្រាប់អំពើបាបរបស់បណ្ដាជន.
ហើយនៅពេលដែលគាត់នឹងដុតខ្លូនវាបាន, នៅកន្លែងដែលជាធម្មតាតង្វាយដុតទាំងនោះត្រូវបានសម្លាប់, នៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់, ដោយសារតែវាគឺសម្រាប់អំពើបាប,
4:26 ប៉ុ ន្ដែ ជា ការ ពិត, គាត់ត្រូវដុតខ្លាញ់នៅលើវា, គ្រាន់តែជាការជាធម្មតាត្រូវបានធ្វើជាមួយនឹងជនរងគ្រោះនៃយញ្ញបូជាមេត្រីភាព.
4:27 ប៉ុន្តែប្រសិនបើព្រលឹងពីប្រជាជននៅស្រុកនោះនឹងបានប្រព្រឹត្តអំពើបាបតាមរយៈការល្ងង់ខ្លៅ, ដូច្នេះដើម្បីបានធ្វើការណាមួយនៃអ្វីដែលក្រឹត្យវិន័យរបស់ព្រះអម្ចាស់ដែលបានហាមឃាត់, ដូច្នេះហើយប្រព្រឹត្តអំពើរំលងមួយ,
4:29 ហើយគេនឹងដាក់ដៃលើក្បាលរបស់ជនរងគ្រោះដែលមានសម្រាប់អំពើបាប.
4:30 បូជាចារ្យត្រូវយកឈាមនេះជាមួយនឹងម្រាមដៃរបស់គាត់, និងប៉ះស្នែងអាសនៈសំរាប់តង្វាយដុតទាំងមូលនេះ, លោកនឹងចាក់សំណល់នៅមូលដ្ឋានរបស់ខ្លួន.
ហើយគាត់នឹងអធិស្ឋានសម្រាប់គាត់, ហើយគាត់នឹងត្រូវបានដោះលែងពីវា.
4:33 លោកនឹងដាក់ដៃលើក្បាលរបស់ខ្លួន, ហើយលោកនឹង immolate វានៅក្នុងកន្លែងដែលជាកន្លែងដែលជនរងគ្រោះនៃការសម្លាប់រង្គាលជាធម្មតានេះត្រូវបានគេសម្លាប់.
4:35 ដូចគ្នា នេះ ដែរ, ទាំងអស់នៃជាតិខ្លាញ់ដែលនឹងត្រូវនាំយកទៅឆ្ងាយ, គ្រាន់តែជាជាតិខ្លាញ់ចៀមនោះ, ដុតខ្លូនសម្រាប់ការដែលត្រូវយញ្ញបូជាមេត្រីភាព, ជាធម្មតាត្រូវបាននាំយកទៅឆ្ងាយ.
ហើយគាត់នឹងអធិស្ឋានសម្រាប់គាត់និងសម្រាប់អំពើបាបរបស់គាត់, ហើយគាត់នឹងត្រូវបានដោះលែងពីវា.
5:7 ប៉ុន្តែប្រសិនបើគាត់មិនអាចផ្តល់ជូននូវសត្វមួយ, អនុញ្ញាតឱ្យគាត់ជូនលលកពីរឬព្រាបជំទើរពីរទៅព្រះអម្ចាស់, មួយសម្រាប់អំពើបាប, និងផ្សេងទៀតសម្រាប់ការសម្លាប់រង្គាលមួយ.
5:9 ហើយគាត់ត្រូវប្រោះឈាមខ្លះនៅក្បែរអាសនៈ.
5:11 ប៉ុន្តែប្រសិនបើដៃរបស់គាត់មិនអាចជូនលលកពីរឬព្រាបជំទើរពីរ, លោកនឹងផ្តល់ជូន, សម្រាប់អំពើបាបរបស់គាត់, ភាគដប់នៃអេផាម្សៅស្រូវសាលីល្អប្រសើរមួយ.
5:12 ហើយគាត់នឹងប្រគល់វាទៅលោកបូជាចារ្យ, អ្នកដែលនឹងត្រូវយកដៃរបស់វា, និងត្រូវដុតនៅលើអាសនៈជាការរំលឹកសម្រាប់គាត់ដែលបានផ្តល់ជូនវា,
ប៉ុ ន្ដែ ជា ការ ពិត, ផ្នែកដែលនៅសល់ខ្លួនគាត់ផ្ទាល់ត្រូវមានជាអំណោយមួយ.
5:15 ប្រសិនបើមានព្រលឹងមួយ, ដោយ កំហុស, នឹងបានបះបោរពិធីនេះនៅក្នុងអ្វីដែលត្រូវបានញែកជាបរិសុទ្ធដល់ព្រះអម្ចាស់, លោកនឹងផ្តល់ជូនសម្រាប់បទល្មើសរបស់គាត់ចៀមឈ្មោលថ្ផីចេសពីហ្វូងចៀម, ដូចជាអាចត្រូវបានទិញសម្រាប់រយៈពេលពីរតម្លឹង, នេះបើយោងតាមទម្ងន់របស់ទីសក្ការៈ.
6:3 ឬអ្នកដែលនឹងបានរកឃើញជារឿងដែលបាត់បង់ហើយបន្ទាប់មកផងដែរបានកាត់ទុកវាដោយការស្បថមិនពិត, ឬអ្នកដែលនឹងបានធ្វើការណាមួយផ្សេងទៀតនៃរឿងជាច្រើនដែលបុរសនេះបានប្រព្រឹត្ដអំពើបាបជាធម្មតា:
6:5 ទាំងអស់ដែលគាត់ចង់ទទួលបានដោយការលួចបន្លំ, ទាំងមូលបូកជាផ្នែកមួយភាគប្រាំបន្ថែមទៀត, ទៅម្ចាស់ប្រឆាំងនឹងការដែលលោកបាននាំយកការខូចខាត.
6:7 ហើយគាត់នឹងអធិស្ឋានសម្រាប់គាត់នៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់, ហើយគាត់នឹងត្រូវបានដោះលែងពីអ្វីដែលគាត់បានធ្វើនៅពេលដែលគាត់បានប្រព្រឹត្តអំពើបាបណាមួយឡើយ.
6:9 ណែនាំលោកអើរ៉ុននិងកូនប្រុសរបស់គាត់: នេះជាច្បាប់នៃការសម្លាប់រង្គាលមួយ.
ភ្លើងនឹងត្រូវបានពីអាសនៈដូចគ្នានេះ.
6:12 ប៉ុន្តែភ្លើងនៅលើអាសនៈនោះនឹងដុតតែងតែ, សម្រាប់បូជាចារ្យត្រូវចិញ្ចឹមវាដោយដាក់ឈើពីក្រោមវាជារៀងរាល់ថ្ងៃនៅពេលព្រឹក.
6:13 នេះជាភ្លើងងូតដែលនឹងមិនដែលបរាជ័យនៅលើអាសនៈ.
6:15 បូជាចារ្យយកម្សៅស្រូវសាលីមួយក្តាប់តូចពិន័យជា, ដែលត្រូវបាន sprinkled ជាមួយប្រេង, និងការទាំងអស់កំញាន, ដែលត្រូវបានគេដាក់លើម្សៅ, ហើយលោកដុតខ្លាញ់នៅលើអាសនៈជាការរំលឹកមួយនៃក្លិនផ្អែមច្រើនបំផុតដល់ព្រះអម្ចាស់.
ហើយគាត់ត្រូវបរិភោគវាក្នុងទីសក្ការៈ, ក្នុង atrium នៃព្រះពន្លា.
ទីសក្ការៈបំផុតវានឹងត្រូវបាន, គ្រាន់តែជាអ្វីដែលត្រូវបានផ្តល់ជូននៅលើក្នុងនាមនៃអំពើបាបនិងកំហុស.
នេះនឹងទៅជាច្បាប់ដែលគ្មានទីបញ្ចប់នៅជំនាន់របស់អ្នកទាក់ទងនឹងការលះបង់របស់ព្រះអម្ចាស់.
ពួកគេនឹងផ្តល់ជូននូវភាគដប់នៃអេផាម្សៅស្រូវសាលីល្អប្រសើរមួយដែលជាការលះបង់ងូត, ពាក់កណ្តាលនៃការវានៅក្នុងពេលព្រឹក, និងពាក់កណ្តាលរបស់វានៅពេលល្ងាច.
ហើយវានឹងត្រូវបានដុតទាំងមូលនៅលើអាសនៈ.
នៅក្នុងកន្លែងដែលជាកន្លែងដែលត្រូវបានផ្តល់ជូនតង្វាយដុតទាំងមូលនេះ, វានឹងត្រូវនៅចំពោះព្រះភ័ក្ដ្រដុតខ្លូនព្រះអម្ចាស់បាន.
ប្រសិនបើមានសម្លៀកបំពាក់មួយនឹងត្រូវប្រោះឈាមរបស់ខ្លួន, វានឹងត្រូវបានទឹកនាំទៅក្នុងទីសក្ការៈ.
ប៉ុន្តែប្រសិនបើនាវានេះនឹងត្រូវបានធ្វើពីលង្ហិន, វានឹងត្រូវបានលាងស្អាតនិងលាងជាមួយទឹក.
6:30 ចំពោះជនរងគ្រោះដែលត្រូវបានសម្លាប់សម្រាប់អំពើបាប, ឈាមដែលត្រូវបានអនុវត្តចូលទៅក្នុងព្រះពន្លានៃសន្ធិសញ្ញា, សម្រាប់ expiation នៅក្នុងដែនជម្រកនេះ, មិនត្រូវបរិភោគ, ប៉ុន្តែវានឹងត្រូវវិនាសដោយភ្លើងឆេះ.
7:1 ដូចគ្នា នេះ ដែរ, នេះគឺជាច្បាប់នៃគ្រឿងបូជាសម្រាប់អំពើរំលងមួយ.
7:2 ហេតុនេះ ហើយ បាន ជា, ដែលជាកន្លែងដែលដុតខ្លូនត្រូវបានហាយនភាព, ជនរងគ្រោះសម្រាប់ការរំលងមួយគេនឹងសម្លាប់ផងដែរ.
7:3 ពួកគេនឹងផ្តល់ជូនពីវា: គូទ, និងជាតិខ្លាញ់ដែលគ្របដណ្តប់សរីរាង្គសំខាន់,
7:5 បូជាចារ្យត្រូវដុតវានៅលើអាសនៈ.
7:6 បុរសជនជាតិសង្ឃជារៀងរាល់នឹងចិញ្ចឹមនៅលើសាច់នេះនៅក្នុងទីសក្ការៈ, ព្រោះវាជាទីសក្ការៈបំផុត.
វានឹងជាកម្មសិទ្ធិរបស់បូជាចារ្យដែលវា.
7:9 ហើយជារៀងរាល់ការបូជានៃម្សៅស្រូវសាលីការផាកពិន័យដែលត្រូវបានដុតនំនៅក្នុង oven នេះ, ហើយអ្វីដែលត្រូវបានរៀបចំនៅលើសូមថ្លែងអំណរគុណយ៉ាងជ្រាលជ្រៅ oven ឬនៅក្នុង Pan frying នេះ, នឹងត្រូវបានសម្រាប់បូជាចារ្យដែលវា.
7:11 នេះជាច្បាប់នៃជនរងគ្រោះនៃយញ្ញបូជាមេត្រីភាពដែរ, ដែលត្រូវថ្វាយព្រះអម្ចាស់.
7:13 និងការផងដែរ, នំបុ័ងមានមេយញ្ញបូជាអរព្រះគុណព្រះ, ដុតខ្លូនសម្រាប់ការដែលត្រូវយញ្ញបូជាមេត្រីភាព.
7:15 សាច់របស់វានឹងត្រូវបានបរិភោគនៅថ្ងៃដដែលនោះ; ណាមួយរបស់វានឹងត្រូវបានរក្សារហូតដល់មិនព្រឹក.
ប៉ុន្តែបន្ទាប់មកប្រសិនបើមានវានឹងនៅតែមានរហូតដល់ថ្ងៃស្អែក, វាជាសិទ្ធិបរិភោគវា.
7:18 ប្រសិនបើនរណាម្នាក់នឹងបានបរិភោគសាច់របស់ជនរងគ្រោះជាយញ្ញបូជាមេត្រីភាពនៅលើថ្ងៃទីបី, តង្វាយនេះនឹងត្រូវបានចាត់ទុកជាមោឃៈ; មិនថាវានឹងផ្តល់ប្រយោជន៍ដល់អ្នកដែលបានផ្តល់ជូនវា.
7:19 សាច់ដែលបានប៉ះពាល់អ្វីនោះទេមិនបរិសុទ្ធមិនត្រូវបរិភោគ, ប៉ុន្តែវានឹងត្រូវបានដុត.
7:20 ប្រសិនបើព្រលឹងដែលត្រូវបានបំពុលមួយនឹងបរិភោគសាច់ថ្វាយជាយញ្ញបូជាមេត្រីភាពដែរ, ដែលត្រូវថ្វាយព្រះអម្ចាស់, លោកមុខជាត្រូវវិនាសចេញពីប្រជាជនរបស់ព្រះអង្គ.
7:24 ជាតិខ្លាញ់នៃសាកសពមួយដែលបានស្លាប់នៅលើខ្លួនរបស់វាផ្ទាល់, ឬជាសត្វដែលត្រូវបានរឹបអូសដោយសត្វសាហាវមួយ, អ្នកនឹងមានសម្រាប់ការប្រើប្រាស់នានា.
7:26 ដូចគ្នា នេះ ដែរ, អ្នកមិនត្រូវយកជាអាហារឈាមសត្វណាមួយទាំងអស់, ថាតើសត្វស្លាបឬមានសត្វព្រៃ.
7:32 ដូចគ្នានេះផងដែរ, ស្មាខាងស្ដាំនៃជនរងគ្រោះនៃយញ្ញបូជាមេត្រីភាពនឹងធ្លាក់ទៅបូជាចារ្យដែលជាផលដំបូងនេះ.
7:34 ដូច្នេះ អ្នក, សុដន់ដែលត្រូវបានលើកឡើង, និងស្មាដែលត្រូវបានបំបែក, ខ្ញុំបានយកពីអ៊ីស្រាអែល, ពីជនរងគ្រោះរបស់ពួកគេជាយញ្ញបូជាមេត្រីភាព, ហើយខ្ញុំបានផ្តល់ឱ្យទាំងនេះទៅលោកអើរ៉ុនបូជាចារ្យនិងកូនប្រុសរបស់គាត់, ច្បាប់ជានិច្ចមួយ, ពីប្រជាជនអ៊ីស្រាអែលទាំងអស់.
7:36 ហើយនេះគឺជាអ្វីដែលព្រះអម្ចាស់បានណែនាំឱ្យត្រូវបានផ្តល់ឱ្យពួកគេដោយអ៊ីស្រាអែល, ក្នុងនាមជាពិធីងូតនៅក្នុងជំនាន់របស់ពួកគេ.
7:38 ដែលព្រះអម្ចាស់បង្គាប់មកលោកម៉ូសេនៅលើភ្នំស៊ីណៃ, នៅពេលដែលគាត់បង្គាប់អ៊ីស្រាអែលយកតង្វាយទៅព្រះអម្ចាស់នៅវាលរហោស្ថានស៊ីណៃ.
ហើយនៅពេលដែលទាំងអស់ហ្វូងមនុស្សនោះត្រូវបានប្រមូលផ្តុំគ្នានៅមុនពេលទ្វារចូលព្រះពន្លា,
8:6 និង បាន ភ្លាម, លោកបាននាំមុខលោកអើរ៉ុននិងកូនប្រុសរបស់គាត់.
8:7 លោកមហាបូជាចារ្យដែលបានផ្ទេរអាវទេសឯកសុទ្ធនោះជាមួយ, រុំគាត់ដោយខ្សែក្រវ៉ាត់ធំទូលាយនេះ, សម្លៀកបំពាក់អាវដែល hyacinth គាត់ជាមួយនឹងនេះ, និងជាងវាគាត់បានដាក់អាវអេផូដ.
8:9 ដូចគ្នានេះផងដែរ, លោករុំ headdress នៅលើក្បាលរបស់គាត់, និងលើវា, ផ្ទុយថ្ងាស, លោកបានដាក់ចានមាស, ញែកជាមួយនឹងការរាប់ជាបរិសុទ្ធ, គ្រាន់តែដូចព្រះអម្ចាស់បានណែនាំគាត់.
8:11 ហើយនៅពេលដែលគាត់បានប្រោះចំនួនប្រាំពីរដងអាសនៈដើម្បីញែកវា, លោកបានរើសតាំងវានិងនាវារបស់ខ្លួនទាំងអស់.
8:12 ហើយការចាក់ប្រេងលើក្បាលលោកអើរ៉ុរបស់, លោកបានរើសតាំងនិងឧទ្ទិសគាត់.
ហើយនៅពេលដែលវាត្រូវបានគេ expiated និងបរិសុទ្ធ, លោកបានចាក់បង្ហូរឈាមដែលនៅសល់នៅមូលដ្ឋានរបស់ខ្លួន.
8:17 និងកំភួនជើងជាមួយនឹងស្បែក, ហើយសាច់, និងសំរាម, គាត់បានដុតលើសពីជំរំ, គ្រាន់តែដូចព្រះអម្ចាស់បានណែនាំ.
ហើយបន្ទាប់មកគាត់បានដុតទាំងមូលចៀមនោះនៅលើអាសនៈ, ដោយសារតែវាគឺជាការសម្លាប់រង្គាលមួយរបស់ក្លិនផ្អែមច្រើនបំផុតដល់ព្រះអម្ចាស់, គ្រាន់តែជាការដែលគាត់បានណែនាំគាត់.
8:25 ប៉ុ ន្ដែ ជា ការ ពិត, ជាតិខ្លាញ់, និងគូទ, និងខ្លាញ់ទាំងអស់ដែលគ្របដណ្តប់ពោះវៀន, និងសំណាញ់ថ្លើម, ក្រលៀនទាំងពីរនិងខ្លាញ់របស់ពួកគេ, និងស្មាខាងស្ដាំ, លោកបានបំបែក.
8:28 គាត់បានទទួលពួកគេជាថ្មីម្តងទៀតពីដៃរបស់ពួកគេ, ហើយលោកដុតវានៅលើអាសនៈនៃការសម្លាប់រង្គាល, ព្រោះវាជាតង្វាយនៃការថ្វាយមួយ, ដូចដែលមានក្លិនឈ្ងុយនៃយញ្ញបូជាដល់ព្រះអម្ចាស់.
8:30 និងការទទួលយកឡើងមួននេះ, និងឈាមដែលនៅលើអាសនៈ, លោកប្រោះលើអើរ៉ុននិងសម្លៀកបំពាក់របស់គាត់, និងជាងកូននិងសម្លៀកបំពាក់របស់ពួកគេដែរ.
ដូចគ្នា នេះ ដែរ, បរិភោគនំបុ័ងនៃការថ្វាយ, ដែលត្រូវបានដាក់នៅក្នុងកញ្ចប់, ដូចជាព្រះអម្ចាស់បានហាមខ្ញុំ, និយាយ ថា :: "អើរ៉ុននិងកូនប្រុសរបស់គាត់ត្រូវបរិភោគឱ្យពួកគេ" ។
8:33 ដូចគ្នានេះផងដែរ, អ្នកនឹងមិនចាកចេញពីទ្វារពន្លាប្រាំពីរថ្ងៃ, រហូតដល់ថ្ងៃដែលពេលនៃការថ្វាយរបស់អ្នកនឹងត្រូវបានបញ្ចប់.
8:34 ទោះបីជាវាបានចាប់ផ្តើមនៅពេលបច្ចុប្បន្ននេះ, ដូច្នេះពិធីនៃការថ្វាយយញ្ញបូជានេះអាចត្រូវបានសម្រេច.
9:2 «ចូរយកកូនគោមួយសម្រាប់អំពើបាបគោ, ចៀមឈ្មោលដែលជាតង្វាយដុតទាំងមូលនិងមួយ, ថ្ផីចេសទាំងពីរ, និងផ្តល់ឱ្យពួកគេនៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់.
9:4 ចូរយកគោនិងចៀមឈ្មោលមួយសំរាប់ថ្វាយជាតង្វាយសន្តិភាពមួយផងដែរ.
9:7 ហើយគាត់បាននិយាយទៅកាន់លោកអើរ៉ុន: "វិធីសាស្រ្តឆ្ពោះទៅកាន់អាសនៈ, និង immolate ក្នុងនាមនៃអំពើបាបរបស់អ្នក.
ហើយនៅពេលដែលអ្នកសម្លាប់ជនរងគ្រោះបានសម្រាប់មនុស្សនេះ, អធិស្ឋានសម្រាប់ពួកគេ, គ្រាន់តែជាព្រះអម្ចាស់បានណែនាំ»។
9:9 កូនប្រុសរបស់គាត់បាននាំនិងឈាមរបស់ខ្លួនដើម្បីគាត់, ហើយជ្រលក់ម្រាមដៃរបស់គាត់នៅក្នុងវា, លោកពាល់ស្នែងរបស់អាសនៈ, ហើយគាត់បានចាក់ចេញនៅសល់នៅក្នុងមូលដ្ឋានរបស់ខ្លួន.
9:11 ប៉ុ ន្ដែ ជា ការ ពិត, សាច់និងស្បែករបស់ខ្លួនលោកយកទៅដុតលើសពីជំរំ.
កូនប្រុសរបស់គាត់បាននាំនិងឈាមរបស់ខ្លួនដើម្បីគាត់, ដែលគាត់បានចាក់បង្ហូរនៅជុំវិញអាសនៈ.
9:17 បន្ថែមទៅវាជាការលះបង់របស់សក្ការបូជាបន្ថែមពីនេះ, ដែលត្រូវបានផ្តល់ជូនជាមួយគ្នា, ហើយដុតវានៅលើអាសនៈ, ដាច់ដោយឡែកពីពិធីនៃតង្វាយដុតទាំងមូលនៅពេលព្រឹកនេះ.
និងកូនប្រុសរបស់គាត់បាននាំគាត់ឈាម, ដែលគាត់បានចាក់មកលើអាសនៈនៅជុំវិញទាំងអស់.
9:21 លោកអើរ៉ុនបានបំបែកសុដន់និងស្មាខាងស្តាំរបស់គេ, លើកពួកគេឡើងនៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់, បានណែនាំលោកម៉ូសេ.
ដូច្នេះ ហើយ, ជនរងគ្រោះសម្រាប់អំពើបាប, និងតង្វាយដុតទាំងមូលនេះ, និងយញ្ញបូជាមេត្រីភាពដែលកំពុងត្រូវបានបានបញ្ចប់, គាត់បានចុះមក.
សិរីរុងរឿងរបស់ព្រះអម្ចាស់លេចមកឱ្យបណ្ដាជនទាំងមូល.
10:1 និងកូនប្រុសរបស់អើរ៉ុន, លោកណាដាប់និងអប៊ីហ៊ូវ, រើសភាជន៍របស់ខ្លួន, ភ្លើងត្រូវបានដាក់នៅក្នុងពួកគេនិងគ្រឿងក្រអូបមកលើពួកគេ, ការផ្តល់ជូននៅក្នុងការមើលឃើញនៃព្រះអម្ចាស់ភ្លើងចម្លែក, ដូចជាមិនត្រូវបានគេណែនាំរបស់ពួកគេ.
10:3 លោកម៉ូសេលោកអើរ៉ុន: "នេះគឺជាអ្វីដែលព្រះអម្ចាស់បាននិយាយ: "ខ្ញុំនឹងត្រូវបានញែកជាបរិសុទ្ធចំពោះអ្នកដែលនៅជិតខ្ញុំ, ហើយយើងនឹងទទួលសិរីរុងរឿងនៅចំពោះមុខមនុស្សទាំងអស់ដែរ»។ ពេលឮនេះហើយ, លោកអើរ៉ុននៅស្ងៀម.
10:5 ការផ្លាស់ប្តូរយ៉ាងលឿននិង, ពួកគេបានយកពួកគេដូចជាពួកគេដេក, ជាមួយអាវធ្វើពីក្រណាត់ទេសឯកផ្ទេរ, និងដេញពួកគេនៅក្រៅ, គ្រាន់តែជាការត្រូវបានគេបង្គាប់ឱ្យពួកគេ.
សូមឱ្យបងប្អូនរបស់អ្នក, ហើយទាំងអស់ពូជពង្សអ៊ីស្រាអែល, bewail ការដុតដែលព្រះអម្ចាស់បានបង្កាត់ភ្លើងនេះ.
ចំពោះការពិតជាប្រេងនៃការចាក់ប្រេងតាំងបរិសុទ្ធមកលើអ្នក។ "ហើយពួកគេបានគ្រប់ការទាំងអស់តាមបទបញ្ជារបស់លោកម៉ូសេ.
10:9 «អ្នកមិនត្រូវផឹកស្រា, ឬអ្វីដែលអាច inebriate អ្នកឬកូនចៅរបស់អ្នក, នៅពេលដែលអ្នកចូលទៅក្នុងព្រះពន្លានៃសន្ធិសញ្ញា, ក្រែងអ្នកស្លាប់.
10:10 ដូច្នេះហើយប្រហែលជាអ្នកមានចំណេះដឹងក្នុងការយល់គ្នារវាងបរិសុទ្ធនិងអាសគ្រាមនេះ, រវាងការបំពុលនិងស្អាត.
10:12 លោកម៉ូសេមានប្រសាសន៍ទៅកាន់លោកអើរ៉ុន, និងកូនចៅរបស់គាត់, លោកអេឡាសារនិងអ៊ីថាម៉ារ, ដែលត្រូវបានគេដែលនៅសល់: «ចូរទទួលយកការបូជាដែលនៅតែពីតង្វាយរបស់ព្រះអម្ចាស់, និងបរិភោគវាដោយគ្មានដំបែជាប់នឹងអាសនៈ, ព្រោះវាជាទីសក្ការៈបំផុត.
10:14 ដូចគ្នា នេះ ដែរ, សុដន់ដែលត្រូវបានផ្តល់ជូន, និងស្មាដែលត្រូវបានបំបែក, អ្នកត្រូវបរិភោគនៅក្នុងកន្លែងស្អាតបំផុត, អ្នកនិងកូនចៅរបស់អ្នក, និងកូនស្រីរបស់អ្នកជាមួយអ្នក.
និងខឹងប្រឆាំងនឹងលោកអេឡាសារនិងអ៊ីថាម៉ារ, កូនចៅរបស់លោកអើរ៉ុនដែលត្រូវបានគេដែលនៅសេសសល់, លោក ថ្លែង ថា ::
10:18 ពិសេសចាប់តាំងពីគ្មាននរណាម្នាក់នៃឈាមរបស់ខ្លួនត្រូវបានគេនាំចូលទៅក្នុងទីបរិសុទ្ធនេះ, ហើយចាប់តាំងពីអ្នកគួរតែបរិភោគវានៅក្នុងទីសក្ការៈ, ដូចដែលត្រូវបានណែនាំឱ្យខ្ញុំ?"
ប៉ុន្តែអ្នកឃើញអ្វីដែលបានកើតឡើងចំពោះខ្ញុំ.
11:9 ទាំងនេះគឺជាអ្វីដែលពូជនៅក្នុងទឹក, និងដែលមានសិទ្ធិបរិភោគ.
11:10 ប៉ុន្តែអ្វីដែលមិនមានព្រុយនិងមានស្រកា, នៃអ្វីដែលរស់នៅនិងការផ្លាស់ប្តូរនៅក្នុងទឹក, នឹងត្រូវឱ្យអ្នករាល់គ្នាគួរឱ្យស្អប់ខ្ពើម,
11:20 របស់អស់អ្នកដែលរុយ, ជំហានអ្វីលើជើងបួននឹងត្រូវបានគួរឱ្យស្អប់ខ្ពើមដល់អ្នក.
11:22 អ្នកត្រូវបរិភោគ, ដូចជាការ beetle នៅក្នុងប្រភេទរបស់ខ្លួន, និងចង្រិត, និងកណ្ដូប, និងកណ្ដូប, មួយគ្នានេះបើយោងតាមប្រភេទរបស់ខ្លួន.
11:24 ហើយអ្នកណានឹងបានប៉ះសាកសពរបស់គេនឹងត្រូវសៅហ្មង, ហើយគាត់នឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
11:26 សត្វគ្រប់រូបដែលពិតជាមានរកចកមួយ, ប៉ុន្តែការដែលមិនត្រូវបានបែងចែក, ឬតើវាទំពារម្តងទៀត, នឹងទៅជាមិនបរិសុទ្ធ.
11:27 អ្វីដែលដើរនៅលើដៃរបស់ខ្លួន, ចេញពីសត្វទាំងអស់ដែលជំរុញបួន, នឹងទៅជាមិនបរិសុទ្ធ.
11:28 ហើយអ្នកណានឹងបានអនុវត្តប្រភេទនៃគ្រោងឆ្អឹងនេះត្រូវបោកសម្លៀកបំពាក់របស់ខ្លួន, ហើយគាត់នឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
11:29 ដូចគ្នា នេះ ដែរ, ទាំងនេះនឹងត្រូវបានចាត់ទុកនៅក្នុងចំណោមរឿងបំពុលនេះ, ចេញពីការទាំងអស់ដែលធ្វើចលនានៅលើផែនដីនេះ: ភាសាដោះដៃបាន, និងកណ្តុរ, និងក្រពើ, មួយគ្នានេះបើយោងតាមប្រភេទរបស់ខ្លួន,
11:32 និងអ្វីដែលអ្វីមួយពីសាកសពរបស់ពួកគេនឹងបានធ្លាក់ចុះនោះនឹងត្រូវសៅហ្មង, ថាតើវាជានាវាឈើ, ឬសម្លៀកបំពាក់មួយ, ឬស្បែក, ឬ haircloths, ឬអ្វីដោយការងារដែលត្រូវបានធ្វើរួច.
11:33 ប៉ុន្តែភាជនៈដីមួយ, ចូលទៅក្នុងដែលបានអ្វីមួយពីការទាំងនេះនឹងធ្លាក់ចុះ, នឹងត្រូវសៅហ្មង; ហើយដូច្នេះវានឹងត្រូវបានខូច.
11:39 ប្រសិនបើមានសត្វណាមួយនឹងត្រូវបានស្លាប់, ពីការដែលវាគឺជាច្បាប់សម្រាប់អ្នកដើម្បីបរិភោគ, អ្នកណាបានប៉ះគ្រោងឆ្អឹងរបស់ខ្លួននឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
11:41 ទាំងអស់ដែលមមកលើផែនដីនឹងត្រូវគួរឱ្យស្អប់ខ្ពើម, វាមិននឹងយកឡើងជាម្ហូបអាហារ.
11:43 មិនមានឆន្ទៈក្នុងការបំពុលព្រលឹងរបស់អ្នក, អ្នកនឹងប៉ះណាមួយឡើយទាំងនេះនៃ, ក្រែងលោអ្នកក្លាយជាមនុស្សមិនបរិសុទ្ធ.
11:47 ដូច្នេះអ្នកអាចដឹងពីភាពខុសគ្នារវាងអ្នកដែលមិនបរិសុទ្ធស្អាតនិង, ហើយដើម្បីឱ្យអ្នកអាចដឹងនូវអ្វីដែលអ្នកគួរតែបរិភោគ, និងអ្វីដែលអ្នកគួរតែមិនព្រម.
12:3 នៅថ្ងៃទីប្រាំបី, ទារកតូចនេះនឹងត្រូវបានធ្វើពិធីកាត់ស្បែក.
នាងមិនត្រូវប៉ះពាល់អ្វីនោះទេបរិសុទ្ធ, នាងនឹងចូលទៅក្នុងឬដែនជម្រកនេះ, រហូតដល់ថ្ងៃនៃការបន្សុតរបស់នាងត្រូវបានបញ្ចប់.
12:6 ហើយនៅពេលដែលថ្ងៃនៃការបន្សុតរបស់នាងត្រូវបានបញ្ចប់, សម្រាប់កូនប្រុសឬកូនស្រីមួយសម្រាប់, នាងនឹងមាត់ទ្វារព្រះពន្លានៃសក្ខីភាពនេះ, សាច់ចៀមមួយឆ្នាំដែលជាវ័យមួយដែលហាយនភាព, និងព្រាបជំទើរមកថ្វាយឬលលកសម្រាប់អំពើបាបមួយ, ហើយនាងនឹងប្រគល់ពួកគេទៅកាន់លោកបូជាចារ្យ.
ដូច្នេះហើយនាងនឹងត្រូវបានជាស្អាតបរិសុទ្ធពីបញ្ហានៃការឈាមរបស់នាង.
12:8 ហើយប្រសិនបើដៃរបស់នាងមិនបានទទួលបានឬអាចត្រូវថ្វាយកូនចៀម, នាងត្រូវយកលលកពីរឬព្រាបជំទើរពីរ: មួយជាតង្វាយដុតទាំងមូលដែលមាន, និងផ្សេងទៀតសម្រាប់អំពើបាប.
13:2 មាននរណាម្នាក់ស្បែកឬសាច់នឹងមានលេចណ៍ចម្រុះ, ឬមួយ pustules, ឬអ្វីមួយដែលហាក់ដូចជាការបញ្ចាំង, ដែលជាសញ្ញានៃរោគឃ្លង់, នឹងត្រូវបាននាំយកទៅបូជាចារ្យអើរ៉ុន, ឬទៅកាន់នរណាម្នាក់ដែលអ្នកចង់បានក្នុងចំណោមកូនចៅរបស់គាត់.
13:4 ប៉ុន្តែប្រសិនបើនឹងមានស្បែកសភ្លឺក្នុងស្បែក, ប៉ុន្តែវាគឺមិនទាបជាងនៅសល់នៃនិស្ស័យលោកីយ៍, និងសក់គឺជាការណ៍គ្មានឥតទ្ធិពល, បូជាចារ្យត្រូវ seclude គាត់សម្រាប់ប្រាំពីរថ្ងៃ.
បុរសនោះត្រូវបោកសម្លៀកបំពាក់របស់ខ្លួន, ហើយគាត់បានបរិសុទ្ធ.
13:11 វានឹងត្រូវបានវិនិច្ឆ័យកើតឃ្លង់រ៉ាំរ៉ៃមួយ, ដែលបានកើនឡើងចូលទៅក្នុងស្បែក.
13:12 ប៉ុន្តែប្រសិនបើរោគឃ្លង់នេះនឹងបានរីកចំរើន, coursing តាមរយៈស្បែក, ហើយនឹងបានគ្របដណ្តប់ស្បែកទាំងអស់ដែលបានមកពីក្បាលដល់ជើង, អ្វីដែលស្ថិតនៅក្រោមការមើលឃើញរបស់ភ្នែក,
13:17 បូជាចារ្យត្រូវពិនិត្យមើលគាត់, ហើយលោកនឹងយល់គាត់ត្រូវស្អាតស្អំ.
13:19 ហើយនៅក្នុងកន្លែងនៃដំបៅនេះ, នៅទីនោះហាក់ដូចជាស្នាមសឬក្រហម, បុរសម្នាក់នេះនឹងត្រូវបាននាំទៅបូជាចារ្យ.
13:26 ប៉ុន្តែប្រសិនបើណ៍នៃសក់នេះមិនត្រូវបានផ្លាស់ប្តូរ, មិនមែនជាការសញ្ញានេះទាបជាងនៅសល់នៃនិស្ស័យលោកីយ៍, និងរោគឃ្លង់ខ្លួនវាហាក់ដូចជាមិនច្បាស់លាស់បន្តិច, គាត់នឹង seclude គាត់សម្រាប់ប្រាំពីរថ្ងៃ,
13:29 ប្រសិនបើមានរោគឃ្លង់នឹងត្រូវបានបង្កើតឡើងនៅក្នុងក្បាលឬពុកចង្ការរបស់បុរសម្នាក់ឬស្ត្រី, បូជាចារ្យត្រូវមើលទៅលើពួកគេ,
13:31 ប៉ុន្តែប្រសិនបើគាត់មើលឃើញថាកន្លែងនៃកន្លែងនេះគឺស្មើគ្នាជាមួយនឹងសាច់ដែលនៅក្បែរនោះ, ហើយថាសក់គឺខ្មៅ, គាត់នឹង seclude គាត់សម្រាប់ប្រាំពីរថ្ងៃ,
ប្រសិនបើមានកន្លែងមិនបានកើនឡើងបាន, និងសក់បានរក្សាការណ៍របស់ខ្លួន, និងទីកន្លែងនៃសញ្ញានេះគឺស្មើគ្នាជាមួយនឹងការនៅសល់នៃនិស្ស័យលោកីយ៍,
13:34 នៅថ្ងៃទីប្រាំពីរ, ប្រសិនបើមានសញ្ញានេះហាក់ដូចជាបានស្នាក់នៅក្នុងកន្លែងរបស់ខ្លួន, ហើយវាគឺមិនទាបជាងនៅសល់នៃនិស្ស័យលោកីយ៍, លោកនឹងប្រកាសថាគាត់បានជាស្អាតបរិសុទ្ធ, និង, សម្លៀកបំពាក់របស់គាត់ត្រូវបានលាង, គាត់បានបរិសុទ្ធ.
13:36 លោកនឹងលែងសួរថាតើរោមប្រែជាលឿង, ដោយសារតែគាត់ជាមនុស្សមិនបរិសុទ្ធច្បាស់.
ប្រសិនបើគាត់រកឃើញលាក់មួយ White នៅលើស្បែកចាំង, គេអាចដឹងថាវាមិនមែនជារោគឃ្លង់, ប៉ុន្តែមួយសៅហ្មងសខ្មៅ, ហើយថាបុរសម្នាក់នេះគឺស្អាត.
13:43 បូជាចារ្យបានឃើញនេះ, លោកនឹងកាត់ទោសដោយគ្មានការសង្ស័យឃ្លង់, ដែលបានលេចឡើងនៅទំពែកនេះ.
13:45 នឹងមានសម្លៀកបំពាក់របស់គាត់ unstitched, ក្បាលរបស់គាត់ទទេ, មាត់របស់គាត់គ្របដណ្តប់ជាមួយកណាត់មួយ, ហើយព្រះអង្គផ្ទាល់នឹងស្រែកអង្វរថាគាត់ត្រូវបានកខ្វក់និងកខ្វក់.
13:49 ប្រសិនបើវាត្រូវបានឆ្លងមេរោគមួយដែលមានកន្លែងសឬក្រហម, វានឹងត្រូវបានចាត់ទុកថាជាឃ្លង់, ហើយវានឹងត្រូវបានបង្ហាញទៅលោកបូជាចារ្យ.
13:51 នៅថ្ងៃទីប្រាំពីរ, សំឡឹងមើលមុខវាម្តងទៀត, ប្រសិនបើគាត់បានរកឃើញមានការកើនឡើង, វាជាឃ្លង់ការតស៊ូ; ព្រះអង្គនឹងវិនិច្ឆ័យសម្លៀកបំពាក់ដែលត្រូវបានបំពុល, រួមជាមួយនឹងអ្វីគ្រប់យ៉ាងដែលវាត្រូវបានគេរកឃើញ.
13:55 ហើយនៅពេលដែលគាត់នឹងបានមើលឃើញថាអតីតរូបរាងមិនបានត្រឡប់មកវិញ, បើទោះបីជារោគឃ្លង់បានជាមិនកើនឡើង, ព្រះអង្គនឹងវិនិច្ឆ័យទោសវាឱ្យទៅជាមិនបរិសុទ្ធ, ហើយទ្រង់នឹងដុតជាមួយភ្លើង, សម្រាប់រោគឃ្លង់ត្រូវបានបញ្ចូលនៅផ្នែកខាងក្រៅនៃសម្លៀកបំពាក់នេះ, ឬពេញ.
13:57 ប៉ុន្តែ ប្រសិន បើ មាន, បន្ទាប់ពី នេះ, នៅទីនោះនឹងបង្ហាញនៅក្នុងកន្លែងទាំងនោះដែលពីមុនមកថ្ផីចេស, ជារោគឃ្លង់ហោះនិងវង្វេង, វាត្រូវតែត្រូវបានដុតជាមួយភ្លើង.
13:59 នេះជាច្បាប់អំពីរោគឃ្លង់សម្រាប់ណាមួយឬក្រណាត់ទេសឯកវិស័យកាត់ដេរ woolen, ក្នុងការត្បាញនិងនៅក្នុងខ្សែស្រឡាយ, និងសម្រាប់ធាតុទាំងអស់ដែលធ្វើពីស្បែក, អំពីរបៀបដែលវាត្រូវតែត្រូវបានប្រកាសថាស្អាតឬកខ្វក់ទាំង.
លោកនឹងត្រូវបូជាចារ្យបាននាំយកទៅ,
14:4 នឹងណែនាំលោកអ្នកដែលត្រូវបានបន្សុតក្នុងការផ្តល់ជូនសម្រាប់ខ្លួនគាត់ចាបពីរនាក់, ដែលមានសិទ្ធិបរិភោគ, ឈើតាត្រៅ, និង vermillion, និងមែកហ៊ីសុប.
14:6 ប៉ុន្តែដែលនៅរស់ផ្សេងទៀត, ជាមួយឈើតាត្រៅ, និងក្រហម, និងមែកហ៊ីសុបនេះ, លោកបានជ្រលក់ក្នុងឈាមដុតខ្លូននោះសត្វចាប.
ហើយគាត់នឹងចេញផ្សាយការរស់នៅសត្វ, ដូច្នេះវាអាចហោះហើរទៅឆ្ងាយចូលទៅក្នុងវាល.
ហើយត្រូវបានបន្សុត, លោកនឹងចូលទៅក្នុងជំរំ, តែមួយគត់ដើម្បីវិសាលភាពនេះ: ថាគាត់អាចនៅតែមាននៅខាងក្រៅតង់ត៍របស់ខ្លួនអស់រយៈពេលប្រាំពីរថ្ងៃ.
និងបានបោកសម្លៀកបំពាក់របស់ខ្លួនជាថ្មីម្តងទៀត, និងរាងកាយរបស់គាត់,
14:11 ហើយនៅពេលដែលលោកបូជាចារ្យសម្អាតបុរសម្នាក់នេះបានបង្ហាញគាត់និងរឿងទាំងអស់នេះនៅចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់នៅមាត់ទ្វារពន្លានៃសន្ធិសញ្ញានេះ,
សម្រាប់គ្រាន់តែដូចជាជាមួយនឹងមួយសម្រាប់អំពើបាប, ដូច្នេះជនរងគ្រោះសម្រាប់អំពើរំលងនោះជាកម្មសិទ្ធិរបស់បូជាចារ្យ.
14:14 និងទទួលយកឈាមខ្លះនៃជនរងគ្រោះនេះ, ដុតខ្លូនសម្រាប់ការដែលត្រូវបានរំលង, បូជាចារ្យត្រូវដាក់វានៅលើចុងត្រចៀកស្ដាំរបស់ព្រះអង្គដែលបានប្រោសអោយបរិសុទ្ធ, និងលើមេដៃស្ដាំរបស់គាត់, ដូចគ្នាដែរជើងនិង.
14:16 ហើយលោកនឹងម្រាមដៃស្ដាំរបស់លោកជ្រលក់ក្នុងវា, ហើយគាត់ត្រូវប្រោះវានៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់ចំនួនប្រាំពីរដង.
14:21 ប៉ុន្តែប្រសិនបើគាត់គឺជាជនក្រីក្រ, ហើយដៃរបស់គាត់គឺជាការមិនអាចរកឃើញនូវអ្វីដែលត្រូវបានគេនិយាយថា:, គាត់ត្រូវយកកូនចៀមជាតង្វាយសម្រាប់អំពើរំលងមួយ, ដូច្នេះបូជាចារ្យអាចអធិស្ឋានសម្រាប់គាត់, និងជាផ្នែកមួយភាគដប់នៃម្សៅស្រូវសាលីផាកពិន័យ sprinkled ជាមួយប្រេង, ជាយញ្ញបូជា, និងប្រេងហ៊ីទីដប់ពីរ,
14:25 ហើយនៅពេលដែលសាច់ចៀមដុតខ្លូនត្រូវបាន, លោកនឹងដាក់ឈាមខ្លះនៅលើចុងត្រចៀកស្ដាំរបស់ព្រះអង្គដែលបានប្រោសអោយបរិសុទ្ធ, និងលើមេដៃស្ដាំរបស់គាត់, ព្រមទាំងជើង.
14:27 ហើយជ្រលក់ម្រាមដៃស្ដាំរបស់គាត់នៅក្នុងវា, លោកនឹងប្រោះចំនួនប្រាំពីរដងនៅចំពោះព្រះអម្ចាស់.
14:29 ប៉ុន្តែផ្នែកដែលនៅសល់នៃប្រេងដែលមាននៅក្នុងដៃឆ្វេងរបស់គាត់, លោកនឹងចាត់លើក្បាលមួយដែលកំពុងត្រូវបានបន្សុត, ដើម្បីបង្ហាញព្រះអម្ចាស់នៅលើក្នុងនាមរបស់គាត់.
14:31 មួយសម្រាប់អំពើរំលង, និងផ្សេងទៀតដូចជាការសម្លាប់រង្គាលមួយ, ជាមួយសក្ការបូជាបន្ថែមរបស់ខ្លួន.
14:35 លោកបានដែលមានផ្ទះវាជាការត្រូវទៅនិងរាយការណ៍ទៅលោកបូជាចារ្យ, និយាយ ថា :: «វាហាក់ដូចជាខ្ញុំថាសញ្ញានៃរោគឃ្លង់នេះគឺមាននៅក្នុងផ្ទះរបស់ខ្ញុំ»។
ហើយបន្ទាប់ពីនេះ, គាត់នឹងចូលទៅពិនិត្យរោគឃ្លង់នៃផ្ទះ.
14:38 លោកនឹងចាកចេញតាមទ្វារផ្ទះនោះ, ភ្លាមបិទវាឡើងសម្រាប់ប្រាំពីរថ្ងៃ.
ប្រសិនបើគាត់រកឃើញថារោគឃ្លង់បានរាលដាល,
14:43 ប៉ុន្តែ ប្រសិន បើ មាន, បន្ទាប់ពីដុំថ្មត្រូវបានជីកចេញ, ហើយធូលីដីលុបចោលឆ្ងាយ, ហើយវាត្រូវបានបិទជាមួយដីឥដ្ឋផ្សេងទៀត,
14:45 ហើយដូច្នេះពួកគេនឹងបំផ្លាញវាភ្លាម, បោះដុំថ្មនិងឈើរបស់ខ្លួន, និងការផងដែរទាំងអស់ធូលីដី, នៅខាងក្រៅទីក្រុងនៅកន្លែងមិនបរិសុទ្ធ.
14:47 ហើយអ្នកណានឹងបានដេកនៅក្នុងវា, ឬបរិភោគអ្វីនោះទេ, ត្រូវបោកសម្លៀកបំពាក់របស់ខ្លួន.
14:51 លោកយកឈើតាត្រៅ, និងមែកហ៊ីសុបនេះ, និងក្រហម, ការរស់នៅនិងការចាប, ហើយលោកនឹងជ្រលក់ក្នុងឈាមទាំងអស់នេះបានដុតខ្លូននៃចាបនេះ, និងការផងដែរនៅក្នុងទឹកផ្ដល់ជីវិត, ហើយគាត់នឹងប្រោះចំនួនប្រាំពីរដងនៅផ្ទះ.
14:53 ហើយនៅពេលដែលគាត់បានចេញផ្សាយកូនចាបហោះហើរដោយសេរីចូលទៅក្នុងវាល, គាត់នឹងអធិស្ឋានសម្រាប់ផ្ទះ, ហើយវានឹងត្រូវបានលាងសំអាតត្រឹមត្រូវ.
15:3 ហើយបន្ទាប់មកគាត់នឹងត្រូវបានវិនិច្ឆ័យប្រធានបទកំហុសនេះ, ប្រសិនបើសារធាតុរាវកខ្វក់, នៅពេលគ្នា, ប្រកាន់ខ្ជាប់សាច់ឈាមរបស់ខ្លួនហើយកំពុងប្រមូលទីនោះ.
15:5 ប្រសិនបើនរណាម្នាក់ប៉ះនឹងគ្រែរបស់គាត់, លោកបានត្រូវបោកសម្លៀកបំពាក់របស់ខ្លួន, ហើយលាងដោយទឹក, គាត់នឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
15:7 អ្នកណាបានប៉ះសាច់របស់គាត់ត្រូវបោកសម្លៀកបំពាក់របស់ខ្លួន, ហើយលាងដោយទឹក, គាត់នឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
15:13 ប្រសិនបើលោកអ្នកដែលបានទទួលរងពីទុក្ខវេទនានេះនឹងត្រូវបានប្រោសឱ្យ, លោកនឹងចំនួនប្រាំពីរថ្ងៃបន្ទាប់ពីការលាងសម្អាតរបស់គាត់, ហើយបោកសម្លៀកបំពាក់និងរាងកាយទាំងមូលរបស់គាត់នៅក្នុងទឹកដែលរស់នៅ, គាត់បានបរិសុទ្ធ.
15:16 បុរសដែលរួមភេទគ្រាប់ពូជនៃអ្នកចេញទៅត្រូវបោករាងកាយទាំងមូលរបស់គាត់ជាមួយនឹងទឹក, ហើយគាត់នឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
15:18 ស្ត្រីម្នាក់ជាមួយនឹងការរួមភេទដែលលោកបានធ្លាប់មាននឹងត្រូវបានលាងសម្អាតដោយទឹក, ហើយនាងនឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
15:22 អ្នកណានឹងបានទៅប៉ះនឹងគ្រែនោះត្រូវបោកសម្លៀកបំពាក់របស់ខ្លួន, ហើយលាងជម្រះខ្លួនជាមួយទឹក, គាត់នឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច.
15:24 ប្រសិនបើបុរសម្នាក់មានការរួមភេទជាមួយនាងនៅក្នុងពេលវេលានៃលំហូរប្រចាំខែរបស់នាងឈាម, គាត់នឹងទៅជាមិនបរិសុទ្ធអស់រយៈពេលប្រាំពីរថ្ងៃ, ហើយគ្រែដែលគេដេកជារៀងរាល់នឹងត្រូវបានបំពុល.
15:26 ជារៀងរាល់គ្រែដែលនាងដេកនៅលើ, និងធាតុទាំងអស់នៅលើដែលនាងអង្គុយ, នឹងត្រូវបានបំពុល.
15:28 ប្រសិនបើមានឈាមបានឈប់ហើយបានឈប់ហូរ, នាងនឹងចំនួនប្រាំពីរថ្ងៃសម្រាប់ពិធីជម្រះកាយរបស់នាង,
15:30 ហើយលោកនឹងផ្តល់ជូនមួយសម្រាប់អំពើបាប, និងផ្សេងទៀតដូចជាការសម្លាប់រង្គាលមួយ, ហើយលោកនឹងអធិស្ឋានសម្រាប់នាងចំពោះព្រះភ័ក្ត្រព្រះអម្ចាស់, និងសម្រាប់លំហូរនៃអំពើសៅហ្មងរបស់នាង.
15:32 នេះជាច្បាប់របស់ព្រះអង្គដែលកំពុងមានលំហូរនៃគ្រាប់ពូជមួយ, ឬអ្នកដែលត្រូវបានបំពុលដោយការរួមភេទ,
16:2 ហើយគាត់បានណែនាំគាត់, និយាយ ថា :: ចូរប្រាប់អើរ៉ុនជាបងរបស់អ្នក, ដូច្នេះលោកអាចមិន, នៅពេលណាមួយ, ចូលទៅក្នុងទីសក្ការៈ, ដែលមាននៅក្នុងស្បៃមុខនេះ, មុនពេលដែលធួននឹងបាបដែលហិបនេះត្រូវបានគ្របដណ្តប់, ដូច្នេះថាលោកមិនអាចស្លាប់បាន, (ដ្បិតយើងនឹងលេចមកក្នុងពពកនៅខាងលើសក្ការៈមួយ)
លោកនឹងផ្តល់ជូននូវកូនគោសម្រាប់អំពើបាបមួយ, ចៀមឈ្មោលដែលជាតង្វាយដុតទាំងមូលនិងមួយ.
16:5 ហើយគាត់នឹងបានទទួល, ពីបណ្ដាជនទាំងមូលនៃអ៊ីស្រាអែល, ពពែឈ្មោលពីរសម្រាប់អំពើបាប, និងចៀមឈ្មោលមួយជាតង្វាយដុតទាំងមូលដែលមាន.
16:9 នរណាម្នាក់ដែលបានធ្លាក់ចេញច្រើនដែលត្រូវបានផ្តល់ជូននេះទៅឱ្យព្រះអម្ចាស់, លោកនឹងផ្តល់ជូនសម្រាប់អំពើបាប.
16:11 បន្ទាប់ពីហេតុការណ៍ទាំងនេះត្រូវបានគេប្រារព្ធត្រឹមត្រូវ, លោកនឹងផ្តល់ជូននូវរូបកូនគោ, និងអធិស្ឋានសម្រាប់ខ្លួនគាត់និងសំរាប់គ្រួសាររបស់ខ្លួនផ្ទាល់, លោកនឹង immolate វា.
16:13 ដូច្នេះថានៅពេលក្រអូបត្រូវបានដាក់នៅលើភ្លើងឆេះ, ពពកនិងចំហាយរបស់ខ្លួនអាចគ្របដណ្តប់សក្ការៈ, ដែលមានខាងលើទីបន្ទាល់, ហើយគាត់មិនអាចស្លាប់បាន.
16:15 ហើយនៅពេលដែលគាត់បានសម្លាប់ពពែឈ្មោលមួយសម្រាប់អំពើបាបរបស់ប្រជាជន, លោកយកឈាមរបស់វាក្នុងស្បៃមុខនេះ, គ្រាន់តែជាការដែលគាត់ត្រូវបានណែនាំឱ្យធ្វើដោយឈាមនៃកំភួនជើងនេះ, ដូច្នេះគាត់អាចប្រោះឆ្ងាយពីតំបន់នៃសក្ការៈនេះ,
បើយោងទៅតាមពិធីនេះ, គាត់នឹងប្រព្រឹត្ដចំពោះព្រះពន្លានៃសក្ខីភាពនេះ, ដែលត្រូវបានជួសជុលនៅក្នុងចំណោមពួកគេនៅក្នុងពាក់កណ្តាលកខ្វក់របស់រស់នៅនេះ.
16:18 ហើយនៅពេលដែលគាត់បានចេញទៅមុនពេលដែលមានអាសនៈព្រះអម្ចាស់បាន, អនុញ្ញាតឱ្យគាត់អធិស្ឋានសម្រាប់ខ្លួនគាត់, និងទទួលយកឈាមរបស់កូនគោនេះ, និងពពែឈ្មោល, អនុញ្ញាតឱ្យគាត់ចាក់វានៅលើស្នែងទាំងរបស់ខ្លួននៅជុំវិញទាំងអស់.
16:20 បន្ទាប់ពីលោកបានសម្អាតទីសក្ការៈ, និងព្រះពន្លា, និងអាសនៈ, បន្ទាប់មកអនុញ្ញាតឱ្យគាត់ថ្វាយពពែរស់នៅនេះ.
និងការហៅទូរស័ព្ទទាំងនេះមកលើក្បាលរបស់វា, លោកនឹងផ្ញើវាទៅឆ្ងាយ, ដោយមធ្យោបាយនៃបុរសម្នាក់ដែលបានរៀបចំដើម្បីធ្វើដូច្នេះបាន, ចូលទៅក្នុងវាលរហោស្ថាន.
16:23 លោកអើរ៉ុនវិលត្រឡប់ទៅព្រះពន្លានៃសក្ខីភាពនេះ.
16:24 លោកនឹងលាងសាច់របស់លោកនៅក្នុងទីសក្ការៈ, ហើយគាត់នឹងត្រូវបានស្លៀកពាក់ផ្ទាល់ខ្លួនរបស់គាត់.
16:27 ប៉ុន្តែកូនគោនិងពពែឈ្មោល, ដុតខ្លូនសម្រាប់ការដែលត្រូវបានគេប្រព្រឹត្តអំពើបាប, និងដែលមានឈាមត្រូវបានគេនាំចូលទៅក្នុងទីសក្ការៈដើម្បីបញ្ចប់ expiation នេះ, ទាំងនេះនឹងត្រូវបានអនុវត្តនៅខាងក្រៅជំរំហើយដុតចោលក្នុងភ្លើង: ដូចជាជាមួយនឹងស្បែករបស់ពួកគេ, ដូច្នេះផងដែរជាមួយសាច់និងលាមករបស់ខ្លួន.
16:29 ហើយនេះនឹងត្រូវទៅឱ្យអ្នកជាពិធីបរិសុទ្ធអស់កល្បជានិច្ច.
16:30 នៅ ថ្ងៃនេះ, នឹងមានដង្វាយធួនសម្រាប់អ្នក, និងជាស្អាតបរិសុទ្ធពីអំពើបាបរបស់អ្នកទាំងអស់.
16:31 វាជាថ្ងៃសប្ប័ទសំរាប់ការសំរាកមួយ, ហើយអ្នកត្រូវតមអាហាររបស់អ្នកជាពិធីងូត.
ហើយគាត់នឹងត្រូវបានបំពាក់ជាមួយអាវទេសឯកសុទ្ធនិងសម្លៀកបំពាក់សក្ការៈជា.
16:34 ហើយនេះនឹងទៅជាអ្នកច្បាប់ងូត, ដែលអ្នកបានអធិស្ឋានសម្រាប់អ៊ីស្រាអែល, និងសម្រាប់អំពើបាបរបស់ពួកទាំងអស់មួយឆ្នាំម្តង.
17:2 ចូរប្រាប់អើរ៉ុននិងកូនចៅរបស់គាត់, និងកូនចៅទាំងអស់នៃជនជាតិអ៊ីស្រាអែល, បាន និយាយ ថា ដើម្បី ឱ្យ ពួក គេ: នេះគឺជាពាក្យដែល, ដែលព្រះអម្ចាស់បានបង្គាប់មក, និយាយ ថា ::
17:4 និងមិនបានធ្វើបទបង្ហាញវាជាតង្វាយទៅព្រះអម្ចាស់នៅមាត់ទ្វារពន្លានេះ, លោកនឹងត្រូវមានទោសពីឈាម.
17:5 ហេតុនេះ ហើយ បាន ជា, អ៊ីស្រាអែលត្រូវតែផ្តល់ជូនទៅបូជាចារ្យរបស់ពួកគេជាជនរងគ្រោះ, ដែលពួកគេបានសម្លាប់នៅក្នុងវាល, ដូច្នេះពួកគេអាចត្រូវបានរាប់ជាបរិសុទ្ធដល់ព្រះអម្ចាស់មុនពេលទ្វារនៃព្រះពន្លានៃសក្ខីភាពនេះ, ហើយដូច្នេះពួកគេអាច immolate ពួកគេជាយញ្ញបូជាមេត្រីភាពដល់ព្រះអម្ចាស់.
17:7 ពួកគេនឹង immolate ជនរងគ្រោះរបស់ពួកគេទៅអារក្សបានទៀតទេ, ជាមួយនឹងការដែលពួកគេបានប្រព្រឹត្តអំពើសហាយស្មន់.
17:8 ហើយអ្នកនឹងនិយាយទៅកាន់ពួកគេ: បុរសម្នាក់នៃផ្ទះរបស់អ៊ីស្រាអែល, ឬចំណូលថ្មីដែលបានរស់នៅជាមួយអ្នក, ដែលបានផ្តល់នូវការសម្លាប់រង្គាលមួយឬជនរងគ្រោះ,
17:10 បុរសម្នាក់ណាមួយនៅក្នុងទាំងអស់នៃពូជពង្សអ៊ីស្រាអែល, ឬចំណូលថ្មីដែលរស់នៅក្នុងចំណោមពួកគេ, ប្រសិនបើគាត់បានបរិភោគឈាម, ខ្ញុំនឹងរឹងមុខខ្ញុំប្រឆាំងនឹងព្រលឹងរបស់គាត់, ហើយខ្ញុំនឹងបណ្តេញគាត់ចេញពីប្រជាជនរបស់ព្រះអង្គ.
17:12 សម្រាប់ ហេតុផល នេះ, ខ្ញុំបាននិយាយទៅកាន់អ៊ីស្រាអែល: គ្មានព្រលឹងនៅក្នុងចំណោមអ្នករាល់គ្នាត្រូវបរិភោគឈាម, ឬក្នុងចំណោមអ្នកដែលរស់នៅចំណូលថ្មីជាមួយអ្នក.
17:15 អ្នកដែលបរិភោគអ្វីដែលព្រលឹងបានស្លាប់នៅលើខ្លួនវាបាន, ឬអ្វីដែលត្រូវបានគេចាប់បានដោយសត្វមួយ, ថាតើគាត់ត្រូវមានដើមកំណើតកើតឬថ្មីមួយ, ត្រូវបោកសម្លៀកបំពាក់គាត់និងខ្លួនគាត់ជាមួយទឹក, ហើយគាត់នឹងត្រូវបានកខ្វក់រហូតដល់ល្ងាច.
17:16 ប៉ុន្តែប្រសិនបើលោកនឹងមិនបោកសម្លៀកបំពាក់និងរាងកាយរបស់គាត់, គេមានកំហុសរបស់គាត់.
18:3 អ្នកមិនត្រូវធ្វើសកម្មភាពតាមទំនៀមទម្លាប់របស់ស្រុកអេស៊ីប, នៅក្នុងការដែលអ្នកបានរស់; អ្នកមិនដែលនឹងមានឥរិយាបថដោយយោងទៅនឹងទំលាប់នៃតំបន់កាណាន, ចូលទៅក្នុងការដែលខ្ញុំនឹងនាំអ្នករាល់គ្នា; អ្នកមិនដើរក្នុងពិធីបរិសុទ្ធនឹងពួកគេ.
គាត់ជាម្ដាយរបស់អ្នក; អ្នកមិនត្រូវរួមរ័ករបស់នាង.
18:9 អ្នកមិនត្រូវបន្ថោកប្អូនស្រីរបស់អ្នក, តើមកពីឪពុកឬពីម្តាយ, ថាតើនាងបានកើតនៅផ្ទះឬនៅបរទេស.
18:11 អ្នកមិនត្រូវបន្ថោកកូនស្រីរបស់ប្រពន្ធចុងឪពុករបស់អ្នកនោះ, ដែលនាងបានបង្កើតជូនឪពុករបស់អ្នក, និងអ្នកដែលជាប្អូនស្រីរបស់អ្នក.
18:13 អ្នកមិនត្រូវបន្ថោកប្អូនស្រីរបស់ម្ដាយអ្នក, ដោយសារតែនាងគឺជារូបសាច់របស់ម្ដាយឯង.
18:15 អ្នកមិនត្រូវបន្ថោកកូនស្រីនៅក្នុងច្បាប់របស់អ្នក, សម្រាប់នាងជាប្រពន្ធរបស់កូនប្រុសរបស់អ្នក; មិនត្រូវបង្ហាញការមើលងាយរបស់នាង.
18:17 អ្នកមិនត្រូវបន្ថោកប្រពន្ធនិងកូនស្រីរបស់នាងរបស់អ្នក.
18:18 អ្នកមិនត្រូវយកប្អូនស្រីប្រពន្ធរបស់អ្នកជាមួយម្ចាស់គូប្រជែង; ឬអ្នកត្រូវរួមរ័ករបស់នាង, ខណៈពេលប្រពន្ធរបស់អ្នកគឺនៅតែរស់នៅ.
18:20 អ្នកមិនត្រូវមានការរួមភេទជាមួយប្រពន្ធរបស់អ្នកដទៃ, ឬនឹងអ្នកជាមិនបរិសុទ្ធដោយការ mingling នៃពូជនេះ.
18:23 អ្នកមិនត្រូវប្រព្រឹត្តអំពើរួមភេទជាមួយសត្វណាមួយ, ឬនឹងអ្នកជាមិនបរិសុទ្ធដោយវា.
18:24 មិនបំពុលខ្លួនជាមួយវត្ថុនេះ, ដែលទាំងអស់នៃប្រជាជាតិនានា, ដែលខ្ញុំនឹងដេញចេញនៅក្នុងការមើលឃើញរបស់អ្នក, ត្រូវបានគេកខ្វក់
ខ្ញុំនឹងទៅទស្សនាអំពើអាក្រក់របស់ស្រុកនេះ, ដូច្នេះវាអាចក្អួតចេញពីប្រជាជនរបស់ខ្លួន.
18:27 សម្រាប់រឿងគួរឱ្យស្អប់ខ្ពើមទាំងអស់នេះត្រូវបានធ្វើឡើងដោយប្រជាជននៅស្រុកនោះដែលមាននៅទីនេះមុនពេលដែលអ្នក, ហើយពួកគេបានបំពុលវា.
18:29 ព្រលឹងអ្នកដែលបានប្រព្រឹត្តការណាមួយនៃអំពើគួរស្អប់ខ្ពើមទាំងនេះនឹងត្រូវវិនាសសូន្យពីគ្រប់កណ្ដាលនៃប្រជាជនរបស់គាត់.
មិនមានឆន្ទៈក្នុងការធ្វើអ្វីដែលបានធ្វើដោយអ្នកដែលរស់នៅមុនអ្នករាល់គ្នា, និងមិនត្រូវបានបំពុលដោយរឿងទាំងនេះ.
19:4 មិនមានឆន្ទៈដើម្បីបម្លែងទៅគោរពព្រះក្លែងក្លាយ, ទាំងអ្នកគួរតែធ្វើឱ្យព្រះដែលធ្វើពីលង្ហិនសំរាប់ខ្លួន.
19:5 ប្រសិនបើអ្នក immolate ជនរងគ្រោះនៃយញ្ញបូជាមេត្រីភាពថ្វាយព្រះអម្ចាស់, ដូច្នេះគាត់អាចត្រូវបានស្ងប់,
បន្ទាប់មកអ្វីដែលនឹងនៅតែនៅថ្ងៃទីបីអ្នកនឹងដុតជាមួយភ្លើង.
19:8 ហើយគាត់ត្រូវទទួលទោសជំនួសរបស់គាត់, ដ្បិតគាត់បានបំពុលអ្វីដែលជាសក្ការៈថ្វាយព្រះអម្ចាស់.
19:9 នៅពេលដែលអ្នកនឹងត្រូវបានប្រមូលផលស្រូវវាលនៃស្រុករបស់អ្នក, អ្នកនឹងមិនអាចកាត់បន្ថយវាបានធ្លាក់ចុះទៅលើផ្ទៃនៃដីនេះ, សូម្បី តែ ដល់ ដី, ឬអ្នកនឹងប្រមូលត្រចៀកស្រូវនៅសល់.
អ្នកមិនត្រូវកុហក.
19:12 កុំប្រព្រឹត្តសម្បថក្នុងនាមខ្ញុំ, ឬអ្នកនឹងបំពុលព្រះនាមនៃព្រះរបស់អ្នក.
19:13 អ្នកមិនត្រូវបង្កាច់បង្ខូចជិតខាងរបស់អ្នក, ឬអ្នកនឹងជិះជាន់គេដោយអំពើហិង្សា.
19:14 អ្នកមិនត្រូវនិយាយអាក្រក់ពីថ្លង់, ឬអ្នកនឹងដាក់ជំពប់ជើងដួលមនុស្សខ្វាក់, ប៉ុន្តែអ្នកត្រូវគោរពកោតខ្លាចព្រះអម្ចាស់ជាព្រះរបស់, សម្រាប់យើងជាព្រះអម្ចាស់.
19:18 កុំសងសឹក, មិនគួរមានការគិតអ្នករងរបួសនៃការមិត្តរួមរបស់អ្នកពលរដ្ឋ.
អ្នកមិនត្រូវបង្កឱ្យមានហ្វូងសត្វរបស់អ្នកក្នុងការបង្កាត់ពូជជាមួយនឹងប្រភេទដទៃទៀតនៃសត្វ.
អ្នកនឹងមិនត្រូវស្លៀកពាក់សម្លៀកបំពាក់ដែលត្រូវបានត្បាញពីរឿងពីរ.
19:21 ប៉ុន្តែ, សម្រាប់បទល្មើសរបស់គាត់, លោកនឹងផ្តល់ជូននូវចៀមឈ្មោលមួយថ្វាយព្រះអម្ចាស់នៅមាត់ទ្វារព្រះពន្លានៃសក្ខីភាពនេះ.
19:23 នៅពេលដែលអ្នកនឹងបញ្ចូលទៅក្នុងដីនេះ, ហើយនឹងត្រូវបានដាំក្នុងដើមឈើហូបផ្លែវា, អ្នកត្រូវយកផលដំបូងរបស់ពួកគេ; ផ្លែឈើដែលដុះពន្លកទៅជាមិនបរិសុទ្ធដល់អ្នក, អ្នកមិនត្រូវបរិភោគពីការទាំងនេះ.
19:25 ហើយនៅក្នុងឆ្នាំទីប្រាំអ្នកត្រូវបរិភោគផលពីដំណាំនោះ, ការប្រមូលផ្លែឈើដែលត្រូវបាននាំចេញទៅ.
19:30 សង្កេតប្ប័ទរបស់យើង, ហើយបារម្ភឆ្ពោះទៅរកជម្រករបស់ខ្ញុំ.
19:31 កុំបែរទៅហោរ, ឬពិគ្រោះយោបល់ជាមួយគ្រូទាយ, ដើម្បីបានបំពុលតាមរយៈពួកគេ.
19:32 ក្រោកឡើងនៅក្នុងវត្តមាននៃក្បាលប្រផេះសក់នេះ, ហើយគោរពដល់កេរ្តិ៍ឈ្មោះរបស់អែលឌើរមួយ, និងគោរពកោតខ្លាចព្រះអម្ចាស់ជាព្រះរបស់.
19:33 ប្រសិនបើមានអ្នកចំណូលថ្មីនៅក្នុងស្រុកមួយដែលបានរស់នៅរបស់អ្នកនិងស្ថិតនៅក្នុងចំណោមអ្នក, ធ្វើមិនតិះដៀលគាត់,
ហើយអ្នកនឹងស្រឡាញ់គាត់ជាខ្លួនអ្នក.
19:36 សូមឱ្យការធ្វើមាត្រដ្ឋានត្រូវបានគ្រាន់តែនិងទម្ងន់ស្មើ, អនុញ្ញាតឱ្យវិធានការស្ងួតត្រូវបានគ្រាន់តែនិងវិធានការរាវស្មើ.
20:2 អ្នកនឹងនិយាយសេចក្ដីនេះប្រាប់កូនចៅអ៊ីស្រាអែល: បុរសម្នាក់ក្នុងចំណោមកូនចៅអ៊ីស្រាអែលបាន, ឬក្នុងចំណោមអ្នកចំណូលថ្មីដែលរស់នៅក្នុងអ៊ីស្រាអែល, ប្រសិនបើគាត់នឹងបានផ្តល់ពីគ្រាប់ពូជរបស់គាត់ទៅ Moloch តារា, លោកនឹងត្រូវទទួលទោសដល់ស្លាប់: ប្រជាជននៅស្រុកគប់សម្លាប់ព្រះអង្គនឹងបាន.
ហើយខ្ញុំនឹងធ្វើទោសគាត់ចុះពីពាក់កណ្តាលនៃប្រជាជនរបស់គាត់, ដោយសារតែគាត់បានផ្ដល់ឱ្យពីគ្រាប់ពូជរបស់គាត់ទៅ Moloch, ហើយលោកបានកខ្វក់ជម្រករបស់ខ្ញុំ, ហើយនាមរបស់យើងទៅជាសៅហ្មង.
20:5 ខ្ញុំនឹងកំណត់មុខខ្ញុំនៅលើបុរសម្នាក់ដែលសាច់ញាតិរបស់គាត់និងជាង, ហើយខ្ញុំនឹងកាត់បន្ថយការធ្លាក់ចុះទាំងពីរគាត់និងអស់អ្នកដែលយល់ព្រមជាមួយគាត់ដើម្បី fornicate ជាមួយ Moloch, ពីពាក់កណ្តាលនៃប្រជាជនរបស់ខ្លួន.
យើង ជា ព្រះអម្ចាស់, អ្នកដែលបានធ្វើឱ្យអ្នក.
ដូច្នេះសូមឱ្យឈាមរបស់លោកត្រូវបានលើព្រះអង្គ.
20:11 អ្នកណានឹងបានដេកជាមួយម្តាយចុងបាន, ឬនឹងបានរកឃើញអាម៉ាស់របស់ឪពុករបស់គាត់, ពួកគេទាំងពីរនឹងត្រូវស្លាប់ជាមួយ.
20:12 បើអ្នកណាធ្លាប់បានដេកជាមួយកូនស្រីក្មេករបស់គាត់, ទាំងពីរនេះនឹងត្រូវស្លាប់, ដ្បិតពួកគេបានប្រព្រឹត្ដអំពើទុច្ចរិតនេះបើយោងតាម.
20:13 ប្រសិនបើនរណាម្នាក់បានដេកជាមួយប្រុសម្នាក់នៅក្នុងកន្លែងនៃការរួមភេទជាមួយស្រីមួយ, អ្នកទាំងពីរបានប្រព្រឹត្តទង្វើ nefarious, ពួកគេនឹងត្រូវស្លាប់ជាមួយ.
20:14 ប្រសិនបើនរណាម្នាក់, យកកូនស្រីដែលជាប្រពន្ធ, នឹងបានរៀបការជាមួយម្តាយរបស់នាង, គាត់បានប្រព្រឹត្ដអំពើទុច្ចរិតនេះបើយោងតាម.
គ្មាននរណាអស្ចារ្យណាស់ដូច្នេះទង្វើ nefarious តស៊ូនៅកណ្ដាលរបស់អ្នក.
ដូចគ្នា នេះ ដែរ, អ្នកនឹងសម្លាប់សត្វនេះ.
ពួកគេនឹងត្រូវបានសម្លាប់នៅក្នុងការមើលឃើញនៃប្រជាជនរបស់ខ្លួន, ដោយសារពួកគេបានរកឃើញគ្នាគ្មានសម្លៀកបំពាក់.
20:18 អ្នកណាមានការរួមភេទជាមួយស្ត្រីម្នាក់នៅក្នុងលំហូររដូវរបស់នាង, និងបានរកឃើញគ្មានសម្លៀកបំពាក់របស់នាង, ហើយនាងបានបើកប្រភពនៃឈាមរបស់នាង, ទាំងពីរនេះនឹងត្រូវដកចេញពីពាក់កណ្តាលនៃប្រជាជនរបស់ខ្លួន.
ពួកគេនឹងត្រូវស្លាប់ទៅតែគ្មានកូន.
ពួកគេនឹងគ្មានកូន.
20:23 មិនមានឆន្ទៈក្នុងការដើរដោយពិធីបរិសុទ្ធនៃសាសន៍ទាំងឡាយ, ខ្ញុំនឹងបណ្តេញដែលបានមុនពេលដែលអ្នក.
20:24 រីឯ ខ្ញុំ វិញ ខ្ញុំ សុំ បញ្ជាក់ ប្រាប់ អ្នករាល់គ្នា: កាប់ដីរបស់ពួកគេ, ដែលខ្ញុំនឹងឱ្យដល់អ្នកដែលជាមរតកមួយ, ដីហូរដោយទឹកដោះគោនិងទឹកឃ្មុំមួយ.
20:25 ហេតុនេះ ហើយ បាន ជា, អ្នកត្រូវតែបំបែកសត្វដែលស្អាតពីមនុស្សមិនបរិសុទ្ធ, សត្វស្លាបនិងមិនបរិសុទ្ធស្អាតពី.
ពួកគេនឹងយកដុំថ្មគប់.
21:2 លើកលែងតែបានតែដោយឈាមសាច់ញាតិរបស់គាត់និងសាច់ញាតិជិត, នោះ គឺ ជា ការ, ដោយឪពុកឬម្តាយ, ឬដោយកូនប្រុសឬកូនស្រី, ឬមួយផងដែរប្អូនប្រុស,
21:6 គេនឹងទៅជាបរិសុទ្ធដល់ព្រះរបស់ពួកគេ, ហើយពួកគេនឹងមិនបំពុលឈ្មោះរបស់គាត់.
21:7 ពួកគេនឹងមិនត្រូវបានយកធ្វើជាប្រពន្ធជាស្ត្រីរើសមុខ, ឬស្ត្រីពេស្យា, ឬរបស់នាងដែលត្រូវបាន repudiated ដោយប្តីរបស់នាង.
21:8 ហើយពួកគេបានផ្តល់ជូននូវនំប៉័ងនៃវត្តមាននេះ.
21:9 ប្រសិនបើកូនស្រីរបស់បូជាចារ្យដែលនឹងត្រូវបានគេយកចូលទៅក្នុងអំពើពេស្យាចារ, ហើយនឹងបានរំលោភលើឈ្មោះរបស់ឪពុកនាង, នាងនឹងត្រូវវិនាសដោយភ្លើងឆេះ.
21:11 គេនឹងមិនចូលទៅក្នុងរាងកាយបានស្លាប់ណាមួយ; ដូចគ្នាដែរ, មិនបានសូម្បីតែដោយឪពុកម្ដាយគេត្រូវកខ្វក់.
ប្រេងនៃការចាក់ប្រេងតាំងបរិសុទ្ធនៃព្រះរបស់គាត់គឺលើគាត់.
21:15 លោកមិនត្រូវលាយភាគហ៊ុននៃក្រុមគ្រួសាររបស់គាត់ជាមួយនឹងមនុស្សទូទៅនៃប្រទេសជាតិរបស់គាត់.
21:22 ទោះ យ៉ាង នេះ, លោកនឹងបរិភោគនំបុ័ងដែលត្រូវបានផ្តល់ជូននៅក្នុងទីសក្ការៈ.
21:24 ហេតុនេះ ហើយ បាន ជា, លោកម៉ូសេមានប្រសាសន៍ទៅកាន់លោកអើរ៉ុន, និងកូនចៅរបស់គាត់, និងដើម្បីទាំងអស់របស់ជនជាតិអ៊ីស្រាអែល, អ្វីគ្រប់យ៉ាងដែលត្រូវបានបង្គាប់ឱ្យលោក.
អ្នកណានឹងបានប៉ះអ្វីដែលបរិសុទ្ធដោយសារតែការស្លាប់នេះ, ហើយគាត់ដែលមានគ្រាប់ពូជទៅចេញពីព្រះអង្គ, ដូចជាប្រសិនបើពីការរួមភេទ,
22:6 នឹងទៅជាមិនបរិសុទ្ធរហូតដល់ល្ងាច, ហើយនឹងមិនបរិភោគសាច់ដែលគេបានញែកជាបរិសុទ្ធមាន.
22:7 និងព្រះអាទិត្យបានកំណត់, បន្ទាប់ មក, ដែលត្រូវបានបន្សុត, លោកនឹងបរិភោគពីអ្វីដែលត្រូវបានគេញែកជាបរិសុទ្ធ, ដោយសារតែវាជាអាហាររបស់គាត់.
22:11 ប៉ុន្តែអ្នកណាដែលបូជាចារ្យបានទិញ, អស់អ្នកដែលបានកើតមកក្នុងផ្ទះរបស់គាត់, ទាំងនេះត្រូវបរិភោគពីពួកគេ.
22:13 ប៉ុន្តែប្រសិនបើគាត់ជាស្ត្រីមេម៉ាយឬលែងលះគ្នា, និង, ត្រូវបានទៅតែគ្មានកូន, នាងបានត្រឡប់ទៅផ្ទះរបស់ឪពុកនាង, នាងនឹងត្រូវបានចិញ្ចឹមបីបាច់ដោយអាហាររបស់ឪពុកនាង, គ្រាន់តែជាការដែលនាងត្រូវបានទម្លាប់ធ្វើការកត់សំគាល់ធ្វើដូចក្មេងស្រីម្នាក់.
22:14 អ្នក ណា, តាមរយៈការល្ងង់ខ្លៅ, បរិភោគពីអ្វីដែលត្រូវបានគេញែកជាបរិសុទ្ធត្រូវបន្ថែមមួយភាគប្រាំទៅនឹងអ្វីដែលគាត់បានបរិភោគ, ហើយគាត់នឹងផ្ដល់ឱ្យវាទៅជាបូជាចារ្យនៅជម្រកនេះ.
22:16 ក្រែងលោពួកគេអាចទទួលរងកំហុសរបស់ខ្លួនខុសនេះ, នៅពេលដែលពួកគេនឹងមានអាហារបរិភោគបានត្រូវញែកជាបរិសុទ្ធជាអ្វីដែល.
22:19 ក្នុងគោលបំណងដើម្បីត្រូវបានផ្តល់ជូនតាមរយៈអ្នក, ត្រូវថ្វាយជាមួយបុរសថ្ផីចេសពីគោ, ឬពីចៀម, ឬពីពពែ.
22:21 បុរសម្នាក់ដែលបានផ្តល់ជាជនរងគ្រោះនឹងតង្វាយសន្តិភាពមួយនៃការទៅកាន់ព្រះអម្ចាស់, ទាំងការបំពេញអធិដ្ឋានរបស់គាត់ឬការផ្តល់ជូនដោយឯកឯង, ថាតើគោ, ឬចៀម, នឹងផ្តល់ជូននូវអ្វីដែលជាថ្ផីចេស, ដូច្នេះវាអាចជាការទទួលយកបាន.
22:24 អ្នកមិនត្រូវថ្វាយព្រះអម្ចាស់សត្វណាមួយដែលមានពងស្វាសស្នាមជាំ, ឬកំទេច, ឬកាត់និងនាំយកទៅឆ្ងាយ, ហើយអ្នកមិនត្រូវបង្កឱ្យមានណាមួយនៃរឿងទាំងនេះនៅក្នុងទឹកដីរបស់អ្នក.
អ្នកមិនត្រូវទទួលយកពួកគេ.
22:28 ថាតើវាជាគោមួយ, ឬចៀម, ពួកគេបានដុតខ្លូននឹងមិនត្រូវបាននៅថ្ងៃដដែលនោះដោយមានទារកទើបកើតរបស់ខ្លួន.
22:30 អ្នកត្រូវបរិភោគនៅថ្ងៃដដែលនោះ; គ្មានវានឹងត្រូវបានរក្សារហូតដល់ព្រឹកនៅថ្ងៃបន្ទាប់.
22:32 មិនបំពុលឈ្មោះបរិសុទ្ធរបស់ខ្ញុំ, ដូច្នេះថាខ្ញុំអាចត្រូវបានញែកជាបរិសុទ្ធនៅក្នុងចំណោមកូនចៅអ៊ីស្រាអែល.
23:2 ចូរប្រាប់កូនចៅអ៊ីស្រាអែល, ហើយអ្នកនឹងនិយាយទៅកាន់ពួកគេ: ទាំងនេះគឺជាបុណ្យរបស់ព្រះអម្ចាស់, ដែលអ្នកនឹងហៅបរិសុទ្ធ.
អ្នកត្រូវធ្វើកិច្ចការអ្វីនៅថ្ងៃនោះ; វាគឺជាថ្ងៃសប្ប័ទរបស់ព្រះអម្ចាស់នៅកន្លែងលំនៅដ្ឋានទាំងអស់របស់អ្នក.
23:5 ខែដំបូង, ថ្ងៃទីដប់បួននៃខែនេះ, នៅល្ងាច, នេះគឺជាពិធីបុណ្យចម្លង * របស់ព្រះអម្ចាស់.
ប្រាំពីរថ្ងៃអ្នករាល់គ្នាត្រូវបរិភោគនំបុ័ងឥតមេ.
23:11 ទ្រង់នឹងលើកកណ្ដាប់ស្រូវថ្វាយព្រះអម្ចាស់, នៅថ្ងៃបន្ទាប់ពីថ្ងៃសប្ប័ទនោះ, ដូច្នេះវាអាចជាការទទួលយកបានសម្រាប់អ្នក, ហើយលោកនឹងញែកវា.
23:13 និងសក្ការបូជាបន្ថែមនឹងត្រូវផ្តល់ជូនជាមួយនឹងវា: ភាគដប់ពីរនៃម្សៅស្រូវសាលីផាកពិន័យ sprinkled ជាមួយប្រេង, ដូចជាគ្រឿងក្រអូបមួយនិងមានក្លិនឈ្ងុយបំផុតសម្រាប់ព្រះអម្ចាស់; ដូចគ្នាដែរ, សក្ការបូជាបន្ថែមស្រា, មួយភាគបួននៃហ៊ីនមួយ.
វាគឺជាការសមាទានសីលគ្មានទីបញ្ចប់ក្នុងជំនាន់របស់អ្នកនិងនៅក្នុងការទាំងអស់នៃកន្លែងរស់នៅរបស់អ្នក.
23:16 វិធីទាំងអស់ដល់ថ្ងៃនេះបន្ទាប់ពីការបញ្ចប់នៃសប្តាហ៍ទីប្រាំពីរ, នោះ គឺ ជា ការ, ហាសិបថ្ងៃ, ហើយបន្ទាប់មកអ្នកត្រូវថ្វាយយញ្ញបូជាថ្មីទៅព្រះអម្ចាស់,
23:18 ហើយអ្នកត្រូវថ្វាយជាមួយនំបុ័ងនោះ: កូនចៀមមួយឆ្នាំចាស់ថ្ផីចេសចំនួនប្រាំពីរ, និងកំភួនជើងគោមួយ, និងចៀមឈ្មោលពីរ, ហើយទាំងនេះនឹងត្រូវការសម្លាប់រង្គាលមួយ, ជាមួយសក្ការបូជាបន្ថែមរបស់ខ្លួន, ជាមួយក្លិនឈ្ងុយបំផុតដើម្បីព្រះអម្ចាស់.
23:20 ហើយនៅពេលដែលបូជាចារ្យបានលើកពួកគេឡើងជាមួយនឹងនំបុ័ងដែលជាផលដំបូងនេះ, នៅចំពោះព្រះភ័ក្ត្ររបស់ព្រះអម្ចាស់, ពួកគេនឹងធ្លាក់ចុះការប្រើប្រាស់របស់ខ្លួន.
វានឹងក្លាយជាច្បាប់ដែលគ្មានទីបញ្ចប់នៅទីអាស្រ័យរបស់អ្នកទាំងអស់និងមនុស្សជំនាន់.
23:24 ចូរប្រាប់កូនចៅអ៊ីស្រាអែល: ខែទីប្រាំពីរ, នៅថ្ងៃដំបូងនៃខែ, នឹងទៅជាថ្ងៃសប្ប័ទសម្រាប់អ្នក, រំលឹក, ដោយមានសំឡេងត្រែ, ហើយវានឹងត្រូវហៅថាជាបរិសុទ្ធ.
ហើយអ្នកត្រូវតមអាហារនៅថ្ងៃនោះ, ហើយអ្នកត្រូវថ្វាយតង្វាយដុតទាំងមូលថ្វាយព្រះអម្ចាស់.
23:29 ព្រលឹងដែលមិនត្រូវបានរងទុក្ខនៅថ្ងៃនេះនឹងត្រូវវិនាសសូន្យពីគ្រប់ប្រជាជនរបស់ព្រះអង្គ,
23:32 វាគឺជាថ្ងៃសប្ប័ទនៃការឈប់សំរាកមួយ, ហើយអ្នកត្រូវតមអាហារចាប់ផ្តើមនៅថ្ងៃទីប្រាំបួននៃខែ: ពីល្ងាចរហូតដល់ល្ងាចអ្នកនឹងប្រារព្ធពិធីបុណ្យសប្ប័ទរបស់អ្នក.
23:34 ចូរប្រាប់កូនចៅអ៊ីស្រាអែល: ចាប់តាំងពីថ្ងៃទីដប់ប្រាំក្នុងខែទីប្រាំពីរនេះ, នោះនឹងមានបុណ្យបារាំ: ប្រាំពីរថ្ងៃសម្រាប់ព្រះអម្ចាស់.
23:36 និងសម្រាប់ប្រាំពីរថ្ងៃត្រូវថ្វាយតង្វាយដុតទាំងមូលដែលអ្នកបានទៅរកព្រះអម្ចាស់.
សម្រាប់វាគឺជាថ្ងៃនៃការជួបប្រជុំគ្នានិងការប្រមូលផ្តុំ.
23:37 ទាំងនេះគឺជាបុណ្យរបស់ព្រះអម្ចាស់, ដែលអ្នកនឹងហៅមានកិត្តិយសបំផុតនិងសក្ការៈបំផុត, ហើយនៅក្នុងការពួកវាអ្នកនឹងតង្វាយទៅព្រះអម្ចាស់: តង្វាយដុតទាំងមូលនិងសក្ការបូជាបន្ថែមពីនេះបើយោងតាមពិធីនៃថ្ងៃពិសេសនីមួយ,
23:39 ហេតុនេះ ហើយ បាន ជា, ពីថ្ងៃទីដប់ប្រាំនៃខែទីប្រាំពីរ, នៅពេលដែលអ្នកនឹងបានប្រមូលផ្តុំគ្នាផ្លែឈើទាំងអស់ក្នុងស្រុករបស់អ្នក, អ្នករាល់គ្នាត្រូវប្រារព្ធពិធីបុណ្យរបស់ព្រះអម្ចាស់ចំនួនប្រាំពីរថ្ងៃ.
23:41 ហើយអ្នកនឹងប្រារព្ធពិធីឧឡារិករបស់ខ្លួនអស់រយៈពេលប្រាំពីរថ្ងៃក្នុងមួយឆ្នាំ.
នៅខែទីប្រាំពីរ, អ្នករាល់គ្នាត្រូវប្រារព្ធពិធីបុណ្យនេះ,
24:2 ណែនាំកូនចៅរបស់អ៊ីស្រាអែល, ដូច្នេះពួកគេអាចនាំយកទៅប្រេងអូលីវសុទ្ធនេះ, នៅក្នុងគោលបំណងដើម្បីផ្គត់ផ្គង់ចង្កៀងបន្ត
24:5 អ្នកនឹងទទួលបានម្សៅស្រូវសាលីផាកពិន័យ, ហើយអ្នកនឹងដុត * ទាំងដប់ពីរនំបុ័ងពីវា, នំប៉័ងគ្នានៃការដែលត្រូវមានភាគដប់ពីរ.
24:7 ហើយអ្នកត្រូវដាក់លើគេនោះកំញានច្បាស់, ដូច្នេះនំបុ័ងនោះអាចជាការរំលឹកមួយថ្វាយតង្វាយចំពោះព្រះអម្ចាស់.
24:9 ហើយពួកគេនឹងត្រូវបានសម្រាប់អើរ៉ុននិងកូនប្រុសរបស់គាត់, ដូច្នេះពួកគេអាចបរិភោគទាំងនេះនៅក្នុងទីសក្ការៈ; សម្រាប់វាគឺជាទីសក្ការៈបំផុតពីការលះបង់របស់ព្រះអម្ចាស់, ដូចជានៅខាងស្ដាំរហូត.
24:12 ហើយពួកគេបានបញ្ជូនគាត់ទៅពន្ធនាគារ, រហូតដល់ពួកគេអាចដឹងពីអ្វីដែលព្រះអម្ចាស់នឹងបង្គាប់,
24:14 និយាយ ថា :: នាំទៅឆ្ងាយប្រមាថលើសពីជំរំ, និងអនុញ្ញាតឱ្យអស់អ្នកដែលបានឮគាត់ដាក់ដៃលើក្បាលរបស់គាត់, និងអនុញ្ញាតឱ្យប្រជាជនទាំងមូលគប់សម្លាប់ព្រះអង្គ.
24:16 ហើយអ្នកណានឹងបានប្រមាថព្រះនាមព្រះអម្ចាស់អ្នកនោះនឹងត្រូវទទួលទោសដល់ស្លាប់.
អ្នកណាប្រមាថព្រះនាមព្រះអម្ចាស់អ្នកនោះនឹងត្រូវទទួលទោសដល់ស្លាប់.
24:18 អ្នកណានឹងបានប្រហារសត្វនឹងសងដែលមានតំលៃស្មើរបស់ខ្លួន, នោះ គឺ ជា ការ, ជីវិតសម្រាប់ជីវិតមួយ.
24:22 សូមឱ្យមានការវិនិច្ឆ័យស្មើក្នុងចំណោមអ្នក, ថាតើវាជាជនបរទេសក្មេងឬពលរដ្ឋដែលនឹងបានប្រព្រឹត្ត.
និងកូនប្រុសរបស់អ៊ីស្រាអែលបានធ្វើគ្រាន់តែជាការដែលព្រះអម្ចាស់បានបង្គាប់ម៉ូសេ.
25:3 សម្រាប់ប្រាំមួយឆ្នាំអ្នកនឹងសាបព្រោះនៅវាលរបស់អ្នក, និងសម្រាប់ប្រាំមួយឆ្នាំអ្នកនឹងមើលថែរក្សាចំការទំពាំងបាយជូររបស់អ្នក, ហើយអ្នកនឹងប្រមូលផ្លែឈើ.
អ្នកមិនត្រូវសាបព្រោះនៅវាលរបស់អ្នក, ហើយអ្នកមិនត្រូវខ្វល់ចំការទំពាំងបាយជូររបស់អ្នក.
25:6 ប៉ុន្តែទាំងនេះនឹងទៅជារបស់អ្នកសម្រាប់ម្ហូបអាហារ, សម្រាប់អ្នកនិងសម្រាប់បុរសនិងអ្នកបំរើស្ត្រីរបស់អ្នក, និងសម្រាប់ដៃជួលរបស់អ្នក, ហើយសម្រាប់អ្នកដែលរស់នៅចំណូលថ្មីជាមួយអ្នក:
25:8 អ្នកត្រូវជំរឿនសម្រាប់ខ្លួនចំនួនប្រាំពីរសប្តាហ៍នៃឆ្នាំ, នោះ គឺ ជា ការ, ចំនួនប្រាំពីរដងប្រាំពីរដង, ដែលបានរួមគ្នាធ្វើឱ្យសែសិបប្រាំបួនឆ្នាំ.
25:10 ហើយអ្នកនឹងញែកឆ្នាំទីហាសិបនេះ, ហើយអ្នកនឹងប្រកាសអំពីការផ្ដាច់មួយសម្រាប់ប្រជាជនទាំងអស់នៃដីរបស់អ្នក: សម្រាប់ការដូចគ្នានេះគឺមានមេត្តាករុណាបាន.
25:12 ដោយសារតែការរាប់ជាបរិសុទ្ធមេត្តាករុណានេះ.
25:13 នៅឆ្នាំមេត្តាករុណានេះ, ទាំងអស់នឹងត្រឡប់ទៅទ្រព្យសម្បត្ដិរបស់ខ្លួន.
ដ្បិតព្រះអង្គនឹងលក់ទៅឱ្យអ្នកនូវពេលវេលាសម្រាប់ការផលិត.
25:19 ហើយដូច្នេះថាដីនេះអាចផលិតផ្លែឈើរបស់ខ្លួនសម្រាប់អ្នក, ដែលអ្នកអាចបរិភោគបាន, សូម្បីតែពេញលេញ, dreading អំពើហិង្សាដោយគ្មាននរណាម្នាក់.
25:21 ខ្ញុំនឹងឱ្យពររបស់ខ្ញុំចំពោះអ្នកនៅឆ្នាំទីប្រាំ, ហើយវានឹងផ្ដល់ផលនៅក្នុងរយៈពេលបីឆ្នាំនេះ.
25:23 ដូចគ្នានេះផងដែរ, ដីនេះនឹងមិនត្រូវបានដាក់លក់ជារៀងរហូត, សម្រាប់វាគឺជាអណ្តូងរ៉ែ, ហើយអ្នកគឺជាអ្នកចំណូលថ្មីនិងការតាំងលំនៅមកខ្ញុំ.
25:25 ប្រសិនបើបងប្អូនរបស់អ្នក, ត្រូវបាននៅក្នុងតម្រូវការ, នឹងត្រូវបានលក់ដីតូចរបស់គាត់និងសាច់ញាតិជិតស្និទ្ធរបស់គាត់គឺមានឆន្ទៈ, គាត់អាចប្តូរយកនូវអ្វីដែលគាត់បានលក់.
25:27 ផលិតផលនេះនឹងត្រូវបានគណនាពីពេលនោះនៅពេលដែលគាត់បានលក់វា.
25:28 ប៉ុន្តែប្រសិនបើដៃរបស់គាត់នឹងមិនត្រូវបានរកឃើញវិធីមួយដើម្បីសងតម្លៃនេះ, អ្នកទិញត្រូវមានអ្វីដែលគាត់បានទិញ, រហូតដល់ឆ្នាំមេត្តាករុណានេះ.
25:29 អ្នកណានឹងបានលក់ផ្ទះមួយនៅក្នុងរង្វង់ជញ្ជាំងនៃទីក្រុងមួយដែលនឹងមានសេរីភាពក្នុងការប្រោសលោះវា, រហូតដល់មួយឆ្នាំត្រូវបានបញ្ចប់.
25:32 អគាររបស់ពួកលេវី, ដែលមាននៅក្នុងទីក្រុង, តែងតែអាចត្រូវបានប្រោសលោះ.
25:34 ប៉ុន្តែអនុញ្ញាតឱ្យពួកគេមិនត្រូវបានដាក់លក់តំបន់ជាយក្រុង, សម្រាប់វាគឺជាកម្មសិទ្ធិរហូត.
25:36 មិនទទួលយកប្រាក់ពីគាត់, ឬមានអ្វីច្រើនជាងអ្វីដែលអ្នកបានផ្ដល់ឱ្យ.
25:39 ប្រសិនបើបងប្អូនរបស់អ្នក, ដែលត្រូវបានបង្ខំដោយភាពក្រីក្រ, នឹងបានលក់ខ្លួនបំរើអ្នក, អ្នកមិនត្រូវជិះជាន់គាត់ដោយធ្វើជាខ្ញុំបំរើនៃអ្នកបម្រើកិច្ចសន្យានេះ.
25:41 ហើយបន្ទាប់ពីនោះ, លោកនឹងចាកចេញជាមួយកូនរបស់គាត់, ហើយលោកនឹងវិលត្រឡប់ទៅសាច់ញាតិរបស់គាត់, ដើម្បីកម្មសិទ្ធិរបស់ឪពុករបស់គាត់.
25:45 និងពីចំណូលថ្មីដែលបានរស់នៅជាមួយអ្នក, ឬអ្នកដែលបានកើតឡើងនៅក្នុងស្រុកពីពួកគេអ្នក.
25:46 និង, ដោយខាងស្ដាំនៃមរតកនេះ, អ្នកនឹងបញ្ជូនពួកគេទៅកូនចៅជំនាន់ក្រោយរបស់អ្នក, ហើយអ្នកនឹងគ្រប់គ្រងលើពួកគេជារៀងរហូត.
25:47 ប្រសិនបើដៃរបស់អ្នកចំណូលថ្មីមួយឬជនបរទេសក្មេងមួយដែលនឹងរីកចម្រើនយ៉ាងខ្លាំងក្នុងចំណោមត្រូវបានអ្នក, និងបងប្រុសរបស់អ្នក, ដោយបានក្លាយជាអ្នកក្រីក្រ, នឹងបានលក់ទៅឱ្យគាត់ដោយខ្លួនឯង, ឬទៅណាមួយនៃភាគហ៊ុនរបស់ខ្លួន,
25:51 ប្រសិនបើមាននឹងត្រូវបានច្រើនឆ្នាំមកហើយដែលនៅតែមានមេត្តាករុណាបានរហូតដល់, នេះបើយោងតាមលោកទាំងនេះនឹងត្រូវសងតម្លៃនោះដែរ.
25:53 ប្រាក់ឈ្នួលរបស់គាត់ត្រូវបានចោទប្រកាន់ដោយអ្វីដែលបានបម្រើមុនពេល.
25:54 ប៉ុន្តែ ប្រសិន បើ មាន, ដោយមធ្យោបាយទាំងនេះ, គាត់នឹងមិនអាចត្រូវបានប្រោសលោះ, បន្ទាប់មកនៅក្នុងឆ្នាំមេត្តាករុណានោះលោកនឹងចាកចេញជាមួយកូនរបស់គាត់.
26:4 ហើយដីនឹងសំរាលបានសំណាបរបស់ខ្លួន, និងដើមឈើនឹងត្រូវបានបំពេញម្ដងទៀតជាមួយនឹងផ្លែឈើ.
ហើយអ្នកនឹងបរិភោគអាហាររបស់អ្នកដើម្បីឱ្យពេញលេញ, ហើយអ្នកនឹងរស់នៅក្នុងស្រុករបស់អ្នកដោយគ្មានការភ័យខ្លាច.
26:7 អ្នកនឹងដេញតាមសត្រូវរបស់អ្នក, ហើយពួកគេនឹងធ្លាក់ចុះនៅមើលឃើញនៃអ្នកដែល.
ខ្មាំងសត្រូវរបស់អ្នកនឹងស្លាប់ដោយមុខដាវនៅក្នុងការមើលឃើញរបស់អ្នក.
26:14 ប៉ុន្តែប្រសិនបើអ្នកនឹងមិនស្ដាប់ខ្ញុំ, ឬសម្រេចបានទាំងអស់នៃបទបញ្ជារបស់ខ្ញុំ,
នៅក្នុងការឥតប្រយោជន៍អ្នកនឹងសាបព្រោះគ្រាប់ពូជរបស់អ្នក, ដែលនឹងត្រូវបានលេបត្របាក់ដោយខ្មាំងសត្រូវរបស់អ្នក.
អ្នកនឹងរត់, ទោះបីគ្មាននរណាម្នាក់ដេញតាម.
26:19 ហើយខ្ញុំនឹងកំទេចមោទនភាពក្នុងការរឹងរបស់អ្នក, ហើយខ្ញុំនឹងឱ្យទៅស្ថានបរមសុខអ្នកខាងលើដូចដែក, និងផែនដីដូចខាងក្រោមលង្ហិន.
26:21 ប្រសិនបើអ្នកដើរដែលជាបច្ចាមិត្រដល់ខ្ញុំ, ហើយប្រសិនបើអ្នកគឺជាអ្នកមិនចង់ស្តាប់ខ្ញុំ, ខ្ញុំនឹងបន្ថែមមួយជាប្រាំពីរទៅប៉េស្តរបស់អ្នក, ព្រោះតែអំពើបាបរបស់អ្នក.
26:23 ប៉ុន្តែប្រសិនបើអ្នកគឺជាអ្នកមិនមានឆន្ទៈក្នុងការទទួលវិន័យនៅក្នុងវិធីនេះ, ហើយអ្នកនៅតែដើរដែលជាបច្ចាមិត្រដល់ខ្ញុំ,
26:25 ហើយខ្ញុំនឹងនាំមកលើអ្នកដែលនឹងសងសឹកដាវសម្ពន្ធមេត្រីរបស់ខ្ញុំ.
26:26 បន្ទាប់ ពី នេះ, ខ្ញុំនឹងបានបំបែកបុគ្គលិកនៃនំបុ័ងរបស់អ្នក, ដូច្នេះស្ត្រីដប់នាក់ដុតនំនៅក្នុង oven មួយនំបុ័ង, និងចែកចាយវាដោយទម្ងន់.
26:27 បន្ទាប់ មក, ប្រសិនបើអ្នកមិនចង់ស្តាប់ខ្ញុំតាមរយៈរឿងទាំងនេះ, ហើយអ្នកនៅតែដើរប្រឆាំងនឹងខ្ញុំ,
អ្នកនឹងធ្លាក់ចុះនៅក្នុងចំណោមប្រាសាទព្រះក្លែងក្លាយរបស់អ្នក, និងព្រលឹងរបស់ខ្ញុំនឹងស្អប់ខ្ពើមអ្នក:
26:32 ហើយខ្ញុំនឹងថ្វាយផ្ដាច់បំផ្លាញដីរបស់អ្នក, និងសត្រូវរបស់អ្នកនឹងត្រូវបាន stupefied នៅវា, នៅពេលដែលពួកគេនឹងបានក្លាយទៅជាប្រជាជនរបស់ខ្លួន.
និងដីរបស់អ្នកនឹងត្រូវបានបោះបង់ចោល, និងទីក្រុងនឹងត្រូវបានវាយកម្ទេចចោលរបស់អ្នក.
ដូច្នេះ, ខណៈពេលដែលអ្នកនឹងត្រូវបាន
26:36 ហើយអ្នកណារបស់អ្នកនឹងនៅតែ, ខ្ញុំនឹងចាត់ភេរវកម្មក្នុងចិត្ដរបស់ពួកគេនៅក្នុងតំបន់របស់ពួកខ្មាំងសត្រូវ.
ពួកគេនឹងធ្លាក់ចុះ, ទោះបីគ្មាននរណាម្នាក់ដេញតាម.
26:38 អ្នកនឹងវិនាសនៅក្នុងចំណោមពួកសាសន៍ដទៃ, និងដីរបស់ខ្មាំងសត្រូវនឹងប្រើប្រាស់អ្នក.
26:43 ដែល, នៅពេលដែលនាងនឹងត្រូវបានបន្សល់ទុកដោយពួកគេ, នឹងត្រូវបានរីករាយដោយថ្ងៃសប្ប័ទរបស់នាង, ស៊ូទ្រាំដោយសារតែពួកគេស្ងាត់.
26:44 និងសូម្បីតែបន្ទាប់ពីច្រើនដូច្នេះ, នៅពេលដែលពួកគេមាននៅក្នុងទឹកដីរបស់សត្រូវរបស់ពួកគេ, ខ្ញុំមិនបានបោះបង់ចោលទាំងស្រុង, ហើយខ្ញុំមិនបានដូច្នេះមើលងាយពួកគេថាពួកគេនឹងត្រូវវិនាស, ឬដូច្នេះខ្ញុំនឹងលុបបំបាត់កិច្ចព្រមព្រៀងរបស់ខ្ញុំជាមួយនឹងពួកគេ.
26:45 ហើយខ្ញុំនឹងចងចាំសេចក្ដីសញ្ញារបស់ខ្ញុំដើម, ពេលដែលខ្ញុំបាននាំពួកគេចេញឆ្ងាយពីស្រុកអេស៊ីប, នៅចំពោះមុខសាសន៍ដទៃ, ដូច្នេះដើម្បីធ្វើជាព្រះរបស់គេ.
27:3 ប្រសិនបើវាគឺជាបុរសពីម្ភៃឆ្នាំទៅហុកសិបឆ្នាំមកហើយ, លោកនឹងផ្តល់ឱ្យហាសិបតម្លឹង, ដោយរង្វាស់នៃដែនជម្រកនេះ;
27:9 ប៉ុន្តែសត្វដែលអាចត្រូវបានទៅរកព្រះអម្ចាស់ដុតខ្លូនជាមួយ, ប្រសិនបើមាននរណាម្នាក់បានប្តេជ្ញាថាវា, នឹងបានវិសុទ្ធ,
ហើយប្រសិនបើគាត់បានផ្លាស់ប្តូរវា, ទាំងពីរដែលត្រូវបានគេផ្លាស់ប្តូរ, ហើយថាដែលវាត្រូវបានផ្លាស់ប្តូរនឹងត្រូវញែកថ្វាយព្រះអម្ចាស់.
27:14 ប្រសិនបើបុរសម្នាក់បានប្តេជ្ញាថាផ្ទះរបស់គាត់, ហើយគាត់បានបរិសុទ្ធវាទៅព្រះអម្ចាស់, បូជាចារ្យត្រូវពិនិត្យមើលវា, ថាតើវាគឺជាការល្អឬអាក្រក់, ហើយវានឹងត្រូវបានដាក់លក់ក្នុងតម្លៃដែលបើយោងតាមលោកនឹងបានបង្កើត.
27:16 ប៉ុន្តែប្រសិនបើគាត់បានប្តេជ្ញាថាក្នុងវាលនៃការកាន់កាប់របស់គាត់, និងបានញែកវាទៅព្រះអម្ចាស់, តម្លៃនេះនឹងត្រូវបានប៉ាន់ប្រមាណថាបើយោងតាមរង្វាស់នៃគ្រាប់ពូជនេះ.
27:17 ប្រសិនបើគាត់បានប្តេជ្ញាថាស្រែរបស់គាត់ចាប់ផ្តើមពីឆ្នាំមេត្តាករុណាបច្ចុប្បន្ន, ជាច្រើនដូចជាវាអាចមានតម្លៃ, ដូច្នេះវានឹងត្រូវបានគេប៉ាន់ប្រមាណ.
27:19 ប៉ុន្តែប្រសិនបើអ្នកណាដែលបានប្តេជ្ញាថាវា, មានឆន្ទៈក្នុងការប្តូរយកដីរបស់គាត់, គាត់នឹងបន្ថែមមួយភាគប្រាំនៃប្រាក់ដើម្បីប៉ាន់ស្មាននេះ, ហើយបន្ទាប់មកលោកនឹងកាប់.
27:21 សម្រាប់ពេលថ្ងៃមេត្តាករុណាមកដល់, វានឹងត្រូវបានញែកជាបរិសុទ្ធដល់ព្រះអម្ចាស់.
27:22 ប្រសិនបើវាលមួយត្រូវបានទិញ, ហើយវាមិនមែនជាដីរបស់ដូនតានេះ, វានឹងត្រូវបានញែកជាបរិសុទ្ធដល់ព្រះអម្ចាស់.
27:24 បន្ទាប់ មក, នៅមេត្តាករុណានេះ, វានឹងត្រូវបានត្រឡប់ទៅអតីតម្ចាស់, នរណាម្នាក់ដែលបានលក់វាហើយដែលបានប្រារព្ធធ្វើវានៅក្នុងការជាច្រើននៃការកាន់កាប់របស់គាត់.
27:27 ប៉ុន្តែប្រសិនបើវាជាសត្វមិនបរិសុទ្ធគឺ, អស់អ្នកដែលបានផ្តល់នូវការវានឹងលោះ, នេះបើយោងតាមការប៉ាន់ស្មានរបស់អ្នក, ហើយគាត់នឹងបន្ថែមមួយភាគប្រាំទៅតម្លៃនេះ.
27:29 និងអ្វីទាំងអស់ដែលត្រូវបានញែក, ដែលត្រូវបានផ្ដល់ដោយមនុស្សម្នាក់, នឹងមិនត្រូវបានប្រោសលោះ, ប៉ុន្តែច្បាស់ណាស់នឹងត្រូវស្លាប់.
27:31 ប៉ុន្តែប្រសិនបើអ្នកណាម្នាក់មានឆន្ទៈក្នុងការប្តូរយកតង្វាយមួយភាគដប់របស់គាត់, គាត់នឹងបន្ថែមមួយភាគប្រាំដើម្បីឱ្យពួកគេ.
27:33 វានឹងមិនត្រូវបានជ្រើសរើសដោយអ្វីដែលជាការល្អឬអាក្រក់; គ្មាននរណាវាត្រូវបានផ្លាស់ប្តូរសម្រាប់មួយផ្សេងទៀត.
27:34 ទាំងនេះគឺជាការសមាទានសីល, ដែលព្រះអម្ចាស់បង្គាប់មកលោកម៉ូសេសំរាប់ជនជាតិអ៊ីស្រាអែលនៅលើភ្នំស៊ីណៃ.
15:37 និងអ្វីដែលអ្នកសាបព្រោះមិនមែនជារាងកាយដែលនឹងមាននាពេលអនាគត, ប៉ុន្តែជាមួយស្រូវទទេ, ដូចជាការស្រូវសាលី, ឬគ្រាប់អ្វីមួយផ្សេងទៀត.
អ្វីដែលត្រូវបានសាបព្រោះក្នុងភាពទន់ខ្សោយនឹងក្រោកឡើងដើម្បីអំណាច.
ប្រសិនបើមានរាងកាយសត្វមួយ, នៅទីនោះគឺជាវិញ្ញាណដែរ.
26:14 ពេលនោះសិស្សម្នាក់ក្នុងក្រុមទាំងដប់ពីររូប, ឈ្មោះយូដាសអ៊ីស្ការីយ៉ុ, បានទៅមេដឹកនាំរបស់បូជាចារ្យ,
26:19 ពួកសិស្សបានធ្វើដូចដែលព្រះអង្គបានតែងតាំងដើម្បីឱ្យពួកគេ.
