ដូច្នេះរីករាយដែលអ្នកបានបង្ហោះនេះ. ជាផលិតផលនៃការអាពាហ៍ពិពាហ៍ឆមាសពូជសាសន៍និងប្រពន្ធរបស់បុរសម្នាក់ដែលមិនឆ្លុះបញ្ចាំងពីពួកគេទាំង:) ប្រធានបទនេះគឺជាការពិតណាស់ដើម្បីឱ្យខ្ញុំ. ព្រះជាម្ចាស់បានប្រទានពរដល់ខ្ញុំលើសពីវិធានការជាមួយប្តីរបស់ខ្ញុំ, ហើយវាខ្ញុំឈឺចាប់ក្នុងការគិតថាមានអ្នកនៅទីនោះដែលនឹងបដិសេធនូវអ្វីដែលព្រះទ្រង់មានសម្រាប់ពួកគេដោយសារតែភាពល្ងង់ខ្លៅរបស់ខ្លួន / ការរើសអើងជាតិសាសន៍របស់ខ្លួន.
ដូច្នេះរីករាយដែលអ្នកបានបង្ហោះនេះ. ជាផលិតផលនៃការអាពាហ៍ពិពាហ៍ឆមាសពូជសាសន៍និងប្រពន្ធរបស់បុរសម្នាក់ដែលមិនឆ្លុះបញ្ចាំងពីពួកគេទាំង:) ប្រធានបទនេះគឺជាការពិតណាស់ដើម្បីឱ្យខ្ញុំ. ព្រះជាម្ចាស់បានប្រទានពរដល់ខ្ញុំលើសពីវិធានការជាមួយប្តីរបស់ខ្ញុំ, ហើយវាខ្ញុំឈឺចាប់ក្នុងការគិតថាមានអ្នកនៅទីនោះដែលនឹងបដិសេធនូវអ្វីដែលព្រះទ្រង់មានសម្រាប់ពួកគេដោយសារតែភាពល្ងង់ខ្លៅរបស់ខ្លួន / ការរើសអើងជាតិសាសន៍របស់ខ្លួន.
