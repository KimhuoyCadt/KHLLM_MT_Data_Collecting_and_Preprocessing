តើការហូរឈាម និងរមួលប៉ុណ្នាដែលជារឿងធម្មតា បន្ទាប់ពីបានប្រើថ្នាំ មីសូប្រូស្តូល (misoprostol)?
ចុះប្រសិនបើខ្ញុំហូរឈាមខ្លាំងពេក បន្ទាប់ពីលេបថ្នាំរំលូតកូនរួច?
តើខ្ញុំអាចធ្វើអ្វីបាន ដើម្បីគ្រប់គ្រងការឈឺចាប់ក្រោយពីលេបថ្នាំរំលូតកូន?
តើពេលណាខ្ញុំអាចមានផ្ទៃពោះបានម្តងទៀត បន្ទាប់ពីការពន្លូតកូនដោយប្រើថ្នាំ?
តើខ្ញុំអាចផឹកគ្រឿងទឹកដូចធម្មតាបានទេ បន្ទាប់ពីខ្ញុំបានទទួលថ្នាំរំលូតកូន?
តើត្រូវការរយៈពេលប៉ុន្មាន ទើបបាត់ផលប៉ះពាល់នៃថ្នាំរំលូតកូននេះ?
តើវាធម្មតាទេដែលមានអារម្មណ៍ថាឈឺ ឬមិនធម្មតាក្រោយពីប្រើថ្នាំ មីសូប្រូស្តូល (misoprostol)?
តើខ្ញុំគួរធ្វើដូចម្តេចប្រសិនបើខ្ញុំនៅតែមានផ្ទៃពោះ បន្ទាប់ពីប្រើថ្នាំរំលូតកូនរួច?
ការព្យាបាលការរំលូតកូនមិនពេញលេញ អាចរកបានយ៉ាងទូលំទូលាយនៅទូទាំងពិភពលោក។ អ្នកមានសិទ្ធិទទួលបានសេវាកម្មនេះ ទោះបីជាការរំលូតកូនមិនស្របច្បាប់ នៅក្នុងប្រទេសរបស់អ្នក។
ចំពោះស្ត្រីមួយចំនួនរមួលខ្លាំង ខ្លាំងជាងការឈឺចាប់ពេលមានរដូវ (ប្រសិនបើអ្នកមានការឈឺរមួលពេលមកឈាមរដូវ) ហើយមានការហូរឈាមធ្ងន់ធ្ងរ ជាងអំឡុងពេលមកឈាមរដូវ។ អ្នកប្រហែលហូរឈាមកក រហូតដល់ទំហំប៉ុនក្រូចឆ្មារ ក្នុងកំឡុងពេលពីរទៅបីម៉ោងដំបូង ក្រោយពីប្រើថ្នាំ មីសូប្រូស្តូល (misoprostol)។ ចំពោះស្ត្រីដទៃទៀត ការរមួលគឺស្រាល និងហូរឈាមគឺដូចជាពេលមករដូវធម្មតា។
សូមស្វែងរកមណ្ឌលថែទាំវេជ្ជសាស្ត្រ ប្រសិនបើសំឡីអនាម័យ 2 ជោគដោយឈាមក្នុងរយៈពល 2ម៉ោង បន្ទាប់ពីអ្នកគិតថា អ្នកបានឆ្លងផុតការមានផ្ទៃពោះ។ ជោគ មានន័យថាសំឡីអនាម័យ ត្រូវបានពោរពេញទៅដោយឈាម នៅពីមុខនិងក្រោយ ចុងម្ខាងទៅម្ខាងទៀត និងពេញទាំងអស់។
អ្នកអាចមានផ្ទៃពោះជាថ្មីម្តងទៀត ក្នុងរយៈពេល 8ថ្ងៃ បន្ទាប់ពីការរំលូតកូនដោយប្រើថ្នាំ។ ប្រសិនបើអ្នករួមភេទ អ្នកគួរតែពិចារណាប្រើវិធីពន្យារកំណើត ដើម្បីការពារកុំឱ្យមានផ្ទៃពោះដោយមិនបានគ្រោងទុក។
ទេ ការរំលូតកូនដោយថ្នាំគ្រាប់ នឹងមិនធ្វើឱ្យពិបាកក្នុងការមានគភ៌នាពេលអនាគតទេ។
អ្នកអាចអានលក្ ខខណ្ឌនិងគោល កា រណ៍ឯកជនភាពរបស់យើង។ ដោយបន្តប្រើគេហទំព័រនេះអ្នកកំពុងផ្តល់ការយល់ព្រមរបស់អ្នកដើម្បីធ្វើវា។'
ចុះបើខ្ញុំដឹងថាខ្ញុំមានផ្ទៃពោះជាមួយកូនភ្លោះ?
តើខ្ញុំអាចប្រើថ្នាំរំលូតកូនបានឬទេ ប្រសិនបើខ្ញុំមានផ្ទុកមេរោគអេដស៍?
តើថ្នាំរំលូតកូននេះ អាចគ្មានសុវត្ថិភាព ប្រសិនបើខ្ញុំបានសម្រាលកូនដោយវះ (C-section)?
តើថ្នាំរំលូតកូន ធ្វើឱ្យខ្ញុំពិបាកមានគភ៌នាពេលអនាគតដែរឬទេ?
ប្រសិនបើខ្ញុំជាស្ត្រីមាឌធំខ្លាំង (ឬលើសទម្ងន់ខ្លាំង) តើខ្ញុំត្រូវការលេបថ្នាំគ្រាប់បន្ថែមដែរឬទេ?
តើថ្នាំគ្រាប់រំលូតកូននេះ អាចមានប្រសិទ្ធភាពខ្សោយ ប្រសិនបើខ្ញុំធ្លាប់ប្រើវាពីមុន?
ការរំលូតកូនតាមវេជ្ជសាស្ត្រ គឺដូចគ្នានឹងការប្រើថ្នាំរំលូតកូនដែរឬទេ?
ថ្នាំរំលូតកូនមានពីរប្រភេទ ហើយថ្នាំនីមួយៗមានសកម្មភាពផ្សេងៗគ្នា។ មីហ្វេប្រីស្តូន (Mifepristone) ទប់ស្កាត់អរម៉ូនដែលជាតម្រូវការអោយមានផ្ទៃពោះដើម្បីលូតលាស់ ខណៈពេលដែលគ្រឿងផ្សំ ដែលប្រើក្នុង មីសូប្រូស្តូល (misoprostol) ធ្វើការដោយសម្រាក និងបើកមាត់ស្បូន (បើកចំហទៅស្បូន) និងធ្វើឱ្យស្បូនបង្រួម ដែលជំរុញមិនឱ្យមានផ្ទៃពោះ។
បាទ/ចាស អ្នកអាចប្រើ មីសូប្រូស្តូល (misoprostol) ដោយមានសុវត្ថិភាពនៅផ្ទះ។ នៅពេលដែលអ្នកប្រើថ្នាំ មីសូប្រូស្តូល (misoprostol) សូមប្រាកដថាអ្នកស្ថិតនៅក្នុងតំបន់មួយ (ដូចជាផ្ទះរបស់អ្នក) ដែលជាកន្លែងដែលអ្នកមានភាពស្ងាត់ ហើយអ្នកអាចសម្រាកបាន ពីរទៅបីម៉ោង បន្ទាប់ពីអ្នកលេបថ្នាំរួច។ ការមាននរណាម្នាក់ជាមួយអ្នក ដែលអាចមើលថែរក្សាអ្នក និងយកទឹកតែក្តៅ ឬអាហារឱ្យអ្នក ក៏អាចមានប្រយោជន៍ណាស់ដែរ។
សូមកុំបរិភោគ ឬផឹកអ្វី ក្នុងរយៈពេល 30នាទី ខណៈពេលដែលចាំឱ្យ មីសូប្រូស្តូល (misoprostol) រំលាយ។ បន្ទាប់ពី 30នាទី កន្លងផុតទៅ អ្នកអាចផឹកទឹកដើម្បីលេបសំណល់ថ្នាំ និងជាទូទៅផឹកទឹកអោយច្រើន តាមដែលអ្នកត្រូវការ ជាតិទឹក។
ទេ សូមប្រើចំនួនថ្នាំគ្រាប់ដូចគ្នា ដែលយើងណែនាំអោយអ្នកដទៃគ្រប់គ្នា។ ការសិក្សាបានបង្ហាញថា ជោគជ័យនៃការប្រើថ្នាំ មិនកាត់បន្ថយចំពោះស្ត្រីដែលមានមាឌធំ ឬមានទម្ងន់ធ្ងន់នោះទេ។ អ្នកមិនចាំបាច់លេបថ្នាំតាមកម្រិតផ្សេង ឬលេបថ្នាំបន្ថែមនោះទេ។
អ្នកមិនចាំបាច់ផ្លាស់ប្តូរកំរិតថ្នាំ ឬចំនួនថ្នាំគ្រាប់នោះទេ ប្រសិនបើអ្នករកឃើញថាអ្នកមានកូនភ្លោះក្នុងផ្ទៃ។ វិធីប្រើប្រាស់គឺដូចគ្នា សម្រាប់អ្នកមានកូនភ្លោះក្នុងផ្ទៃ។
ប្រសិនបើអ្នកប្រើឧបករណ៍ពន្យាកំណើតនៅក្នុងស្បូន (ឧ.
តើខ្ញុំអាចលេបថ្នាំរំលូតកូនឬទេ ប្រសិនបើខ្ញុំខ្វះឈាមក្រហម?
ប្រសិនបើខ្ញុំបានប្រើថ្នាំរំលូតកូនហើយ ប៉ុន្តែខ្ញុំនៅតែមានផ្ទៃពោះទៀត តើទារកកើតមក នឹងមានពិការភាពពីកំណើតទេ?
ប្រសិនបើអ្នកកំពុងបំបៅកូនដោយទឹកដោះ ថ្នាំគ្រាប់ មីសូប្រូស្តូល (misoprostol) អាចបណ្តាលឱ្យទារករាគ។ ដើម្បីជៀសវាងបញ្ហានេះ សូមបំបៅកូនរបស់អ្នក បន្ទាប់មកលេបថ្នាំមីសូប្រូស្តូល (misoprostol) ហើយរង់ចាំអោយបាន 4ម៉ោង មុនពេលបំបៅកូនម្តងទៀត។
ប្រសិនបើអ្នកមានផ្ទុកមេរោគអេដស៍ អ្នកគ្រាន់តែត្រូវប្រាកដថាអ្នករឹងមាំ ហើយអ្នកកំពុងប្រើឱសថប្រឆាំងនឹងមេរោគ និងអ្នកមានសុខភាពល្អ។
ប្រសិនបើអ្នកខ្វះឈាមក្រហម (មានកំរិតជាតិដែកទាប នៅក្នុងឈាមរបស់អ្នក) សូមកំណត់ចំណាំមណ្ឌលថែទាំសុខភាពដែលស្ថិតនៅមិនឆ្ងាយពី 30នាទី ដែលអាចជួយសង្រ្គោះបាន ប្រសិនបើអ្នកត្រូវការ។ ប្រសិនបើអ្នកខ្វះឈាមក្រហមខ្លាំង សូមប្រឹក្សាយោបល់ជាមួយវេជ្ជបណ្ឌិត មុនពេលប្រើថ្នាំរំលូតកូន។
ទេ ការប្រើថ្នាំរំលូតកូននៅដើមដំបូងនៃការមានផ្ទៃពោះគឺមានសុវត្ថិភាព បើទោះបីជាអ្នកបានសម្រាលកូនដោយវះ (C-section) ក៏ដោយ។
មិនមានទំនាក់ទំនងរកឃើញរវាងមីហ្វេប្រីស្តូន (Mifepristone) និងពិការភាពពីកំណើតនោះទេ។ ទោះជាយ៉ាងណាក៏ដោយ មីសូប្រូស្តូល (misoprostol) អាចកើនឡើងបន្តិចបន្តួចលើអត្រា ពិការភាពពីកំណើត។ ប្រសិនបើអ្នកប្រើ មីសូប្រូស្តូល (misoprostol) ហើយអ្នកនៅតែមានផ្ទៃពោះក្រោយពីទទួលទានថ្នាំនេះ អ្នកប្រហែលជារលូតកូនតាមធម្មជាតិនៅពេលក្រោយ។ ប្រសិនបើកូនអ្នកមិនរលូត ហើយអ្នកពរពោះ ពេញខែ នោះកម្រិតពិការភាពអាចកើនឡើងដល់ 1% (ទារកម្នាក់ក្នុងចំណោម 100)។
ដំបូងអ្នកត្រូវតែដឹងថា ស្ត្រីភាគច្រើននឹងមិនដឹងអំពីស្ថានភាពនេះទេ លុះត្រាតែពួកគេមើលអេកូ។ ការមានកូននៅក្រៅស្បូន គឺមិនអាចសំរេចបានទេ ទោះបីនៅក្នុងប្រទេសដែលការពន្លូតកូន គឺជារឿងមិនស្របច្បាប់ ក៏អាចមានលទ្ធភាពទទួលបាននីតិវិធីស្របច្បាប់ ដើម្បីបញ្ចប់ការមានផ្ទៃពោះនេះដែរ។
ត្រូវប្រាកដថាអ្នកមានអារម្មណ៍ដឹងជាមុន និងត្រៀមខ្លួនឱ្យរួចរាល់មុនពេលរំលូតកូនដោយប្រើថ្នាំគ្រាប់។
យើងរក្សាសិទ្ធិក្នុងការដកចេញ ឬកែប្រែសេវាកម្មដោយមិនចាំបាច់ជូនដំណឹងនោះទេ។ យើងនឹងមិនទទួលខុសត្រូវនោះទេ ប្រសិនបើមានហេតុផលណាមួយ ដែលគេហទំព័រនេះមិនអាចប្រើបាននៅពេលណាមួយ ឬក្នុងរយៈពេលណាមួយ។ ម្ដងម្កាល យើងអាចនឹងរឹតបន្តឹងការចូលប្រើផ្នែកខ្លះ ឬគេហទំព័រទាំងមូលនេះ។
។ តាមរយៈការប្រើប្រាស់គេហទំព័រនេះ អ្នកយល់ព្រមចំពោះការដំណើរការដែលបានពណ៌នានៅទីនោះ ហើយធានាថារាល់ទិន្នន័យដែលផ្ដល់ដោយអ្នកគឺត្រឹមត្រូវ។
