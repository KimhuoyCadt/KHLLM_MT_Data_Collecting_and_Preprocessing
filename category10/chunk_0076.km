យើងខ្ញុំ ជាអង្គការសង្គមស៊ីវិលមានរាយនាមដូចខាងក្រោម សូមអំពាវនាវដល់រាជរដ្ឋាភិបាល សូមលោកមេត្តា ចាត់ វិធានការជាក់លាក់ក្នុងការធានាឲ្យមានប្រព័ន្ធផ្សព្វផ្សាយព័ត៌មានដោយសេរី និងយុត្តិធម៌នៅក្នុងរយៈពេលមុនការបោះ
អង្គការសង្គមស៊ីវិល ដែលគាំទ្រសេចក្តីថ្លែងការណ៍នេះ មានរាយនាមដូចខាងក្រោមនេះ៖
- សកម្មភាពប្រជាជនដើម្បីការផ្លាស់ប្តូរ (PAC)
នៅ ក្រៅ តុលាការ អ្នក គាំទ្រ អហិង្សា ចំនួន ៣០០នាក់ បាន ប្រមូល ផ្តុំ គ្នា ដោយ សាមគ្គី ភាព ដែល រួម មាន ប្រធាន វិទ្យុ សំបុក ឃ្មុំ លោក ម៉ម សូណង់ ដូផង ដែរ។
នាព្រឹកនេះ អតីត អ្នកសារព័ត៌មាន វិទ្យុអាស៊ីសេរី លោក យាង សុធារិន និងលោក អ៊ួន ឈិន ត្រូវបាន នាំខ្លួន មកសាកសួរ នៅសាលាដំបូង រាជធានីភ្នំពេញ លើបទចោទ ផ្សេងទៀត ដោយយោង តាមច្បាប់ ស្ដីពីការ បង្ក្រាបអំពើ ជួញដូរ មនុស្ស និងអំពើ ធ្វើអាជីវកម្ម ផ្លូវភេទ។
អ្នកទាំងពីរ ត្រូវបាន អាជ្ញាធរ ចាប់ខ្លួន និងឃុំខ្លួន កាលពី ថ្ងៃទី១៤ ខែវិច្ឆិកា ឆ្នាំ២០១៧។ រយៈពេល ៤ថ្ងៃក្រោយមក អ្នកទាំងពីរ ត្រូវបាន ចោទប្រកាន់ និង បញ្ជូនទៅ ឃុំខ្លួន បណ្ដោះអាសន្ន រង់ចាំ សវនាការ នៅក្នុង មណ្ឌលអប់រំ កែប្រែទី១ (ម.១) ដែល មានសភាព ចង្អៀតខ្លាំង។ បន្ទាប់ មកទៀត អ្នកទាំងពីរ ក៏ត្រូវបាន ចោទប្រកាន់ពី អំពើជួញដូរ មនុស្ស ផងដែរ ដែលជា បទចោទ ក្នុងករណី ផ្សេងមួយទៀត ទោះបីជា មិន ទាន់ មានការ បង្ហាញ ភ័ស្ដុតាង ជាសាធារណៈ ដើម្បី គាំទ្រ បទចោទ ទាំងនោះ ក៏ដោយ។
អ្នកទាំងពីរ ត្រូវបាន ចោទប្រកាន់ ដោយ យោង តាមមាត្រា ៤៤៥ នៃក្រម ព្រហ្មទណ្ឌ ពាក់ព័ន្ធ នឹងការ ផ្តល់ព័ត៌មាន ដល់រដ្ឋ ឬភ្នាក់ងារ បរទេស ដែលអាច “អន្តរាយ ដល់ការ ការពារជាតិ” ព្រមទាំង មាត្រា៣៨ និង មាត្រា៣៩ នៃច្បាប់ ស្ដីពី ការ បង្ក្រាប អំពើ ជួញដូរ មនុស្ស និង អំពើ ធ្វើអាជីវកម្ម ផ្លូវភេទ។ ប្រសិនបើ ត្រូវបាន ផ្ដន្ទាទោស អ្នកទាំងពីរ អាច ប្រឈមនឹង ការ ជាប់ ពន្ធនាគារ រហូត ដល់ ១៦ឆ្នាំ៕
សេចក្តីថ្លែងការណ៍៖ អង្គការលីកាដូ ថ្កោល ទោស អំពើ ហិង្សា ក្នុង ខេត្ត កំពង់ស្ពឺ | កម្ពុជា | លីកាដូ
កញ្ញា ណាលី ពីឡូក នាយិកាអង្គការ លីកាដូ បានមានប្រសាសន៍ថា “ជាថ្មីម្តងទៀត យើងមើលឃើញថា កងកម្លាំងប្រដាប់អាវុធត្រូវបានគេកេណ្ឌអោយមកការពារផលប្រយោជន៍ឯកជន ជាជាងផលប្រយោជន៍សាធារណៈ។” “កិច្ចព្រមព្រៀងជំនួញដ៍បន្តិចបន្តួចរបស់អ្នកមានម្នាក់ មានតម្លៃខ្លាំងជាងផ្ទះ ជីវភាពរស់នៅ និងជីវិតរបស់អ្នកភូមិក្រីក្ររាប់រយនាក់។ នេះគឺជារឿងពិតនៃប្រទេសកម្ពុជាបច្ចុប្បន្ន។”
អ្នកភូមិបានចាប់ផ្តើមបិទផ្លូវជាតិលេខ៥១ នាព្រឹកព្រលឹម ក្នុងក្តីរង់ចាំថា មុខជានឹងបានជួបជាមួយអាជ្ញាធរ។ ផ្លូវនេះឆ្លងកាត់ជិតភូមិរបស់អ្នកស្រុក។ ការធ្វើដំណើរទៅមុខរបស់កងកម្លាំងនគរបាល បានបញ្ជៀសពីការប្រើផ្លូវត្រង់ទៅកាន់ភូមិអ្នកស្រុក។ កងកម្លាំងនេះ បានធ្វើដំណើរទៅមុខដោយយឺតៗតាមផ្លុវខាងក្រោយ ហើយឆ្លងកាត់តាមវាលស្រែនិងព្រៃគុម្ពោត។
សេចក្តីអស់សង្ឃឹមរបស់អ្នកភូមិ ក៍បានបង្ហាញអោយឃើញផងដែរ អំពីបញ្ហាដ៍ជ្រៅនៅក្នុងប្រទេសកម្ពុជា។ ការខ្វះខាតទាំងស្រុងនូវដំណោះស្រាយតាមផ្លូវច្បាប់សម្រាប់អ្នកទាំងឡាយណា ដែលមិនស្ថិតក្នុងឋានៈនៃសិទ្ធិអំណាច។ តាមការពិត អ្នកភូមិបានព្យាយាមប្រើប្រាស់មធ្យោបាយខាងផ្លូវច្បាប់គ្រប់សព្វ រួមទាំងតុលាការផង ដើម្បីដោះស្រាយទំនាស់ដីធ្លី និងការពារសិទ្ធិរបស់ពួកគេ។ ក៍ប៉ុន្តែអ្នកភូមិទាំងអស់នោះ បានត្រឹមតែត្រូវគេផាត់ចេញ។
អង្គការ លីកាដូ សូមសំណូមពរយ៉ាងទទួចដល់អាជ្ញាធរ សូមមេត្តាអោយមានការទប់ចិត្តពីការប៉ុនប៉ងដោះស្រាយទំនាស់ដីធ្លីនេះ តាមរយៈការប្រើអំពើហិង្សាបន្តទៅទៀត។ ផ្ទុយទៅវិញ អង្គការ លីកាដូ សូមលើកទឹកចិត្ត ហើយសូមគាំទ្រដល់ការចរចារទាំងឡាយណា ដែលប្រកបដោយសន្តិវិធីជាមួយនឹងប្រជាពលរដ្ឋទាំង៨៨គ្រួសារនេះ។
អ្នក ស្រី ឡុង សុគន្ធី ត្រូវ បាន ចាប់ ខ្លួន និង បញ្ជូន ទៅ ឃុំ ខ្លួន នៅ ពន្ធនាគារ ខេត្ត បន្ទាយមានជ័យ នៅពេល ដែល អាជ្ញាធរ អនុវត្ត សាលក្រម ចុះថ្ងៃទី១៥ ខែមីនា ឆ្នាំ២០១៨ ដែល បាន សម្រេច ផ្ដន្ទាទោស អ្នកស្រី ពី “បទ ប៉ះពាល់ កម្មសិទ្ធិ ឯកជន ” និង “បទ ធ្វើឱ្យ ខូចខាត ដោយ ចេតនា” ។
បញ្ហាស្ត្រី បញ្ហាកុមារ តុលាការ និង នីតិរដ្ឋ រំលោភសេពសន្ថវៈ វាយប្រហារ ទឹកអាស៊ីត និងទារុណកម្ម
ខ្សែអាត់ សំឡេង៖ ការវាយប្រហារ និងការគំរាមកំហែងអ្នកការពារសិទ្ធិមនុស្សនៅកម្ពុជា ឆ្នាំ២០០៧: តំណាងសហជីពកម្មករ | កម្ពុជា | លីកាដូ
អង្គការ សង្គម ស៊ីវិលសូម អំពាវនាវ ឲ្យ រដ្ឋាភិបាល និង គណបក្ស នយោបាយ គោរព សេរីភាព ខាងការបញ្ចេញ មតិ
ក្នុង អំឡុង ពេល ការ ចរចា អំពី កំណែទម្រង់ ប្រព័ន្ធបោះឆ្នោត នាពេលថ្មីៗ នេះ ឧបនាយករដ្ឋ មន្រ្តី ប៊ិន ឈិន មក ពី គណបក្ស ប្រជាជន កម្ពុជា (ប្រ.ជ) និង លោក គួយ ប៊ុន រឿន មក ពី គណបក្ស សង្រ្គោះ ជាតិ កម្ពុជា (គ.ស.ជ) ត្រូវបាន លើក ឡើង ថា វិធានការ បែប នេះ នឹង ត្រូវ យក មក ពិចារណា ដើម្បីធានា នូវ ឯករាជ្យភាព របស់ អង្គការ មិនមែនរដ្ឋាភិបាល។
ការ ហាម ឃាត់ ក្នុងការ ផ្ដល់ បទ សម្ភាសន៍ ជាមួយប្រព័ន្ធផ្សព្វផ្សាយ បែប នេះ ហាក់ដូចជា មាន បំណង ការពារ រដ្ឋាភិបាល និង សមាជិក គណបក្ស នយោ បាយ ពី ការ រិះគន់នានា
ក្នុងរយៈពេលពីរថ្ងៃ សមាជិកទីពីររបស់គណបក្សសង្រ្គោះជាតិត្រូវបានចាប់ខ្លួន
