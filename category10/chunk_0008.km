អ្នកបានបុរសម្នាក់ដែលកើតនៅស្រុកកាលីឡេរបស់សាសន៍យូដា, ការបង្រៀនដោយមានប្រភេទថ្មីនៃសិទ្ធិអំណាច.
ត្រូវបានបោះបង់ចោលដោយមិត្តភក្តិរបស់គាត់.
ហើយបន្ទាប់មកផ្នូររបស់គាត់ត្រូវបានរកឃើញទទេ.
ពួកសិស្សបានបោះបង់គាត់ចោល.
ប៉ុន្តែបន្ទាប់មកនៅពេលដែលយើងអានសៀវភៅកិច្ចការ, យើងឃើញថាពួកគេទាំងអស់នៃការលើកទឹកចិត្តរំពេចនិងដិត.
ពួកគេបានបង្រៀនថាគាត់គឺជាព្រះ, ទៅជាវប្បធម៍របស់សាសន៍យូដា, អ្នកដែលបានទទួលស្គាល់ថាព្រះជាម្ចាស់មានតែមួយ.
ដូច្នេះមនុស្សគឺនៅតែមាននៅជុំវិញ.
អាជ្ញាធរនេះអាចបានបិទស្ថានភាពទាំងមូល, ដែលជាការគំរាមកំហែងដល់ពួកគេ, ដោយគ្រាន់តែបង្ហាញមនុស្សដែលរាងកាយរបស់គាត់.
មនុស្សរាប់ពាន់នាក់បន្ទាប់ពី.
បុរសម្នាក់នេះបានសម្លាប់សម្រាប់.
ខ្ញុំដឹងថាខ្ញុំនឹងមិនស្លាប់សម្រាប់រឿងព្រេងដែលខ្ញុំបានធ្វើឡើង.
ដូច្នេះជាមួយនឹងថានៅក្នុងចិត្ត, ខ្ញុំចង់និយាយតាមរយៈការខ្លះនៃផលប៉ះពាល់នៃការរស់ឡើងវិញបាន.
ដូច្នេះសម្រាប់នៅសល់នៃពេលវេលា, យើងនឹងនិយាយអំពីសំណួរថាបន្ទាប់មក.
ខ្ញុំនឹងប្រាប់អ្នកថាហេតុអ្វីបានជាខ្ញុំគិតថាវាជាបញ្ហា.
និងពីការអនុម័តដែល, ខ្ញុំនឹងបង្ហាញអ្នកពីផលប៉ះពាល់នៃការរស់ឡើងវិញបី.
ហេតុផលទាំងបីនេះមានសារៈសំខាន់ខ្លាំងណាស់សម្រាប់រាល់តែមួយយើងនៅក្នុងបន្ទប់នេះ.
ហើយអ្នកនឹងមើលឃើញហេតុអ្វីបានជាខ្ញុំជឿថានៅក្នុងពេលមួយ.
ប៉ុន្តែប្រសិនបើមានគឺជាការរស់ឡើងវិញនៃការស្លាប់នោះទេ, បន្ទាប់មកមិនបានសូម្បីតែព្រះគ្រិស្ដមានព្រះជន្មរស់.
យើងត្រូវបានគេរកឃើញនឹងត្រូវបាន misrepresenting ព្រះជាម្ចាស់, ដោយសារតែយើងបានផ្ដល់សក្ខីភាពអំពីព្រះថាព្រះអង្គបានប្រោសព្រះគ្រិស្ដ, ដែលលោកមិនបានលើកឡើងប្រសិនបើវាគឺជាការពិតដែលថាមនុស្សស្លាប់មិនរស់ឡើងវិញ.
ហើយបើព្រះគ្រិស្ដមិនបានរស់ឡើងវិញទេ, សេចក្ដីជំនឿរបស់អ្នកគឺគ្មានប្រយោជន៍ហើយអ្នកនៅតែមាននៅក្នុងអំពើបាបរបស់អ្នក.
ប្រសិនបើនៅក្នុងព្រះគ្រីស្ទយើងមានក្ដីសង្ឃឹមក្នុងជីវិតនេះប៉ុណ្ណោះ, យើងមានមនុស្សទាំងអស់គួរឱ្យអាណិតជាងគេ.
ប៉ុន្តែខ្ញុំមានន័យថាជាដំណឹងល្អចុងក្រោយ, អ្វីដែលគម្ពីរហៅថាដំណឹងល្អ.
ការពិនិត្យបង្វិលប្រាក់ពន្ធដែលមិនអាចផ្តល់ឱ្យយើងនូវក្ដីសង្ឃឹមយូរអង្វែង.
ភ្ជាប់ពាក្យឬអាពាហ៍ពិពាហ៍, មិនអាចផ្តល់ឱ្យយើងនូវក្ដីសង្ឃឹមយូរអង្វែង.
តើមានក្តីសង្ឃឹមថាជាសកលនិងធំណាមួយឡើយ?
យើងត្រូវបានខូច, ពិភពលោករបស់យើងត្រូវបានខូច, និងការទាំងអស់នៃការបង្កើតដែលត្រូវការឱ្យត្រូវបានស្ដារឡើងវិញ.
វាហាក់ដូចជាមានសេចក្តីម៉ាស់ថ្មីបាញ់រាល់ថ្ងៃឥឡូវនេះ.
យើងទាំងអស់គ្នាត្រូវបានខូចផងដែរ.
តើអ្នកធ្លាប់បានគិតអំពីហេតុអ្វីបានជាយើងមានវិធីដែលយើងមាន?
ហេតុអ្វីបានជាយើងធ្វើអ្វីដែលយើងធ្វើ?
ហេតុអ្វីបានជាយើងធ្វើការសម្រេចចិត្តការបំផ្លិចបំផ្លាញ?
ព្រះយេស៊ូវគឺជាការដែលព្រះបានចាត់ដើម្បីស្តារ, និងជាពិសេសដើម្បីស្តារពួកយើងដើម្បីអ្នកបង្កើតរបស់យើង.
រឿងមួយតែមួយគត់អំពីគ្រីស្ទសាសនាគឺថាវាមានមូលដ្ឋានលើព្រឹត្តិការណ៍ប្រវត្តិសាស្ត្រនៅក្នុងវិធីតែមួយគត់.
យើងទុកចិត្ដលើបុរសម្នាក់ដែលពិតប្រាកដ, ដែលត្រូវបានសម្លាប់ជាការពិត, និងអ្នកដែលពិតជាបានរស់ពីសុគតឡើងវិញ.
លោក Muhammad ជាព្យាការីនៅក្នុងសេចក្ដីជំនឿអ៊ីស្លាមនេះ, គឺជាការស្លាប់.
ហើយនៅក្នុងវិធីដែលមិនប៉ះពាល់ដល់ជំនឿនេះមូស្លីមមួយ.
ដូច្នេះយើងដឹងថាកន្លែងដែលរាងកាយរបស់ព្រះពុទ្ធ.
រាងកាយខុងជឺ 'ត្រូវបានកប់នៅស្រុកកំណើតរបស់លោកនៅប្រទេសចិន.
និងការពិតដែលថាមនុស្សទាំងនេះបានស្លាប់នៅក្នុងវិធីនោះទេបង្កអន្តរាយដល់ជំនឿរបស់អ្នកកាន់តាមរបស់ពួកគេ.
និងកាន់តាមព្រះគ្រីស្ទគឺជាអ្នកអស់សង្ឃឹម.
ប៉ុន្តែចំណុចដែលខ្ញុំធ្វើនោះគឺថាវាសំខាន់.
សូមស្ដាប់អ្វីដែលលោកប៉ូលបាននិយាយថានៅទីនេះក្នុង 1 កូរិនថូសទី 15.
«ហើយបើព្រះគ្រិស្ដមិនបានរស់ឡើងវិញទេ, បន្ទាប់មកការផ្សព្វផ្សាយរបស់យើងនៅក្នុងការឥតប្រយោជន៍ហើយជំនឿរបស់អ្នកគឺនៅក្នុងការឥតប្រយោជន៍.
លោកប៉ូលមិនគិតថាការរស់ឡើងវិញនេះគឺជារឿងរ៉ាវបំផុសគំនិតមួយចំនួន.
ដូច្នេះពេលយើងព្យាបាលវាដូចជារឿងបំផុសគំនិតមួយចំនួន, យើងអាចផងដែរបញ្ឈប់ការធ្វើពុតថានោះជាគ្រីស្ទសាសនា.
នោះមិនមែនជាអ្វីដែលលោកប៉ូលមានន័យឬមានបំណង.
សាសនាពួកគ្រីស្ទានត្រូវបានផ្អែកលើព័ត៍មាន.
ប្រសិនបើនោះជាការមិនពិត, បន្ទាប់មកការផ្សព្វផ្សាយរបស់ប៉ុលគឺនៅក្នុងឥតប្រយោជន៍.
តើខ្ញុំជឿលើ, ប្រសិនបើរឿងរ៉ាវនៃព្រះយេស៊ូវមិនមានការបញ្ចប់ល្អ?
ខ្ញុំជាមនុស្សមានបាប, លោកយេស៊ូបានព្យាយាមធ្វើអ្វីមួយអំពីថា, ប៉ុន្តែនៅក្នុងការស្លាប់ចុងបញ្ចប់បានទទួលគាត់
ប៉ុន្តែចាប់តាំងពីលោកបានលើកឡើង, មានដំណឹងល្អ
ដំណឹងនេះគឺជាការពិត.
ខ្ញុំចង់អានអ្នកខពីរបីដំបូងនៃ 1 កូរិនថូសទី 15.
ខ្ញុំជំរាបជូនដល់អ្នកជាការសំខាន់ជាលើកដំបូងអ្វីដែលខ្ញុំបានទទួល: ថាព្រះគ្រីស្ទបានសុគតចំពោះអំពើបាបរបស់យើងនៅក្នុងការអនុលោមតាមបទគម្ពីរ, គេបានបញ្ចុះ, ថាគាត់ត្រូវបានលើកឡើងនៅថ្ងៃទីបីនៅក្នុងការអនុលោមតាមបទគម្ពីរ, ហើយថា qព្រះអង្គបានបង្ហាញខ្លួនអោយលោកកេផាស, ទាំងដប់ពីររូបបន្ទាប់មកទៅ.
ព្រះយេស៊ូវបានសុគតសម្រាប់អំពើបាបរបស់យើង.
នោះជាផ្នែកមួយនៃរឿងដំណឹងល្អ.
ការពិតដែលថាព្រះយេស៊ូវបានកើនឡើងពីការស្លាប់នេះបញ្ជាក់អ្វីគ្រប់យ៉ាងដែលគាត់បាននិយាយថាអំពីព្រះនិងអំពីខ្លួនគាត់.
នោះហើយជាការអះអាងដែលគ្មានមេដឹកនាំផ្សេងទៀតនៃសេចក្តីជំនឿណាមួយដែលអាចឬនឹងធ្វើឱ្យ.
ចូរគិតអំពីសាសនាចក្រដែលអ្នកចូលទៅនៅថ្ងៃអាទិត្យ.
តើអ្នកឮអំពីការសុគតនិងការរស់ឡើងវិញនៃព្រះគ្រីស្ទនិងរបៀបដែលវាត្រូវបានអនុវត្តក្នុងជីវិតរបស់យើង?
វាសំខាន់សម្រាប់អ្នកដោយសារតែជីវិតគឺជាការលំបាក.
ជំងឺគឺមានពិតប្រាកដ.
ហើយគាត់នឹងធ្វើឱ្យអ្វីទាំងអស់ដែលថ្មី.
សូមបន្តដើម្បីនិយាយអំពីផលប៉ះពាល់
បើព្រះគ្រិស្ដមិនបានលើកឡើងពីស្លាប់ឡើងវិញ, មិនមានការលើកលែងទោសអោយឡើយ
«បពិត្រព្រះអម្ចាស់អត់ទោសអោយគេ, លោកបានទទួលពួកគេកងកម្លាំងខ្មៅងងឹតនៅក្នុងគាត់ / ទេប៉ុន្តែគាត់បានទទួលបានបណ្តាលឱ្យមនុស្សសុចរិតមួយសម្រាប់ប្រព្រឹត្ដអំពើបាប»។
«បពិត្រព្រះអម្ចាស់សូមអភ័យទោសដល់ខ្ញុំសម្រាប់ sinnin របស់ខ្ញុំ '/ ខ្ញុំមិននិយាយថាខ្ញុំបានបញ្ចប់ / ប៉ុន្តែខ្ញុំបានអធិស្ឋាននៅក្នុងការជាមុន / បណ្តាលឱ្យផ្លូវនេះ glance ភ្នែករបស់នាងដូចជាពួកគេកំពុងលេងនៅក្នុងខោរបស់ខ្ញុំ "។
«ខ្ញុំព្យាយាមធ្វើពុតថាខ្ញុំពិតជាខុសគ្នាប៉ុន្តែនៅទីបញ្ចប់យើងទាំងអស់គ្នាបានដូចគ្នា / យើងទូលអង្វរព្រះជាម្ចាស់, ឪពុកអត់ទោសអោយ **** n មួយនាងមានការផ្លាស់ប្តូរនឹងមិន "។
"ខ្ញុំជាមនុស្សមានបាបម្នាក់, អ្នកដែលបានប្រព្រឹត្ដអំពើបាបនឹងជាថ្មីម្តងទៀតប្រហែលជា / ជាព្រះអម្ចាស់អភ័យទោសអោយខ្ញុំ, ព្រះអម្ចាស់មានព្រះអត់ទោសឱ្យខ្ញុំ / សម្រាប់អ្វីដែលខ្ញុំមិនយល់»។
មនុស្សគ្រប់គ្នាឱ្យតម្លៃការអភ័យទោស.
មនុស្សគ្រប់គ្នាចង់ទទួលបានការអភ័យទោស.
មិនមានមនុស្សម្នាក់ក្នុងទីនេះដែលជាការល្អឥតខ្ចោះ.
នៅពេលដែលព្រះគម្ពីរបាននិយាយអំពីការប្រព្រឹត្ដអំពើបាបវាមានន័យថា ការមិនគោរពព្រះដោយសកម្មភាពរបស់អ្នក, ពាក្យរបស់អ្នក, ឬគំនិតរបស់អ្នក.
ព្រះគម្ពីរបាននិយាយថាបាបគឺមិនមែនគ្រាន់តែបែកបាក់ចៃដន្យច្បាប់, ប៉ុន្តែអំពើបាបដែលមិនគោរពប្រតិបត្តិមានគោលបំណងដោយផ្ទាល់នៅឯព្រះផ្ទាល់.
នៅក្នុងវិធីដូចគ្នាដែលអ្នកចង់យកនរណាម្នាក់បានដុតផ្ទះរបស់អ្នកចុះ, មិនត្រឹមតែជាការវាយប្រហារមួយនៅលើផ្ទះរបស់អ្នក, ប៉ុន្តែនៅលើអ្នកដោយខ្លួនឯង, ព្រះយកការមិនស្ដាប់បង្គាប់ណាមួយដោយការបង្កើតរបស់គាត់ជាការវាយប្រហារទៅលើលោក.
នេះជាសំណួររបស់ខ្ញុំសម្រាប់អ្នក: តើអ្នករំពឹងថានឹងត្រូវបានអភ័យទោសពីអំពើបាបទាំងនោះ?
ហេតុអ្វីបានជាចៅក្រមធ្លាប់បានអនុញ្ញាតឱ្យមនុស្សមានបាបល្អបិទ hook សម្រាប់មួយដែលឧក្រិដ្ឋកម្ម heinous បែបនេះបាប?
ហើយមានតែមួយគត់ដែលធ្លាប់បានអះអាងថាការបង់ប្រាក់សម្រាប់អំពើបាប, ព្រះយេស៊ូវ.
នៅក្នុងអំពើបាបរបស់អ្នក
អ្វីដែលវាមានន័យថាដើម្បីឱ្យមាននៅក្នុងអំពើបាបរបស់អ្នក, គឺថាអ្នកត្រូវបង់ប្រាក់សម្រាប់ពួកគេ.
វាមានន័យថាអ្នកមាននៅតែជាខ្ញុំបម្រើរបស់ពួកគេ.
វាមានន័យថាអ្នកនឹងមិនត្រូវបានការអភ័យទោសចំពោះពួកគេ.
ឈើឆ្កាងគឺជាកន្លែងដែលព្រះយេស៊ូវបានឈ្នះលើអំពើបាប.
ហើយបើព្រះយេស៊ូវមិនបានទទួលឡើង, នោះមានន័យថាអំពើបាបវ៉ុន.
មានការពន្យល់មួយសម្រាប់ហេតុអ្វីបានជាចៅក្រមល្អនឹងមើលរំលងពួកគេទេ.
គ្មានយើងណាម្នាក់នឹងសរសើរចៅក្រមដែលអនុញ្ញាតឱ្យឃាតកបានរួចខ្លួនដោយសារតែពួកគេបានជួយជាស្រ្តីដែលមានអាយុនៅទូទាំងផ្លូវនៅថ្ងៃបន្ទាប់.
អ្នកមិនចង់ឈរនៅចំពោះព្រះនៅក្នុងអំពើបាបរបស់អ្នក.
ហើយប្រសិនបើព្រះយេស៊ូវមិនលើកឡើង, មិនមានការលើកលែងទោសអោយឡើយ.
ព្រះយេស៊ូវបានធ្វើការជាច្រើននៃប្រភេទសាសនាឆ្កួតដោយសារតែ, មិនត្រឹមតែប៉ុណ្ណោះលោកត្រូវបានប្រោសមនុស្ស, ប៉ុន្តែគាត់ត្រូវបានគេប្រាប់ពួកគេបានលើកលែងទោសបាបរបស់ពួកគេ.
សម្តេចប៉ាមិនមានអាជ្ញាធរដែល, គ្រូគង្វាលមិនមានសិទ្ធិអំណាចថា, ពួកបូជាចារ្យមិនមាន authority- ថាព្រះប៉ុណ្ណោះ.
ចូរធ្វើឱ្យន័យនៃពាក្យអភ័យទោស.
វានឹងមិនមានការអភ័យទោសប្រសិនបើខ្ញុំនិយាយថាវាជាការយល់ព្រម, ប៉ុន្តែការដែលបានគ្រោងទុកទះគាត់ត្រឡប់មកវិញសម្រាប់វានៅពេលក្រោយ.
ឥឡូវនេះខ្ញុំអាចនឹងត្រូវបានបាត់បង់ស្មារតីនិងទានៅពេលណាដែលគាត់បានទៅសម្រាប់រយៈពេលប្រាំខ្ពស់.
ខ្ញុំនឹងមិនព្យាយាមដើម្បីទទួលបានមកវិញនៅចំពោះទ្រង់, ឬជូរចត់ឆ្ពោះទៅរកគាត់.
អំពើបាបគឺជាបទល្មើសធ្ងន់ធ្ងរប្រឆាំងនឹងព្រះ.
គាត់បានដឹងថាវាត្រូវបានផ្តន្ទាទោស.
និងលោកយេស៊ូស្រឡាញ់យើងខ្លាំងដល់ម៉្លេះបានជាលោកសុខក្នុងការទទួលយកការផ្តន្ទាទោសដែលនៅលើឈើឆ្កាងសម្រាប់យើង.
វាជាព្រះយេស៊ូវបោះជំហានទៅមុខនៅក្នុងនិងទទួលយកការផ្តន្ទាទោសដែលថាមនុស្សមានបាបសមនឹងទទួលបាន.
គាត់នឹងលុបកំណត់ត្រារបស់យើងបានជាស្អាតបរិសុទ្ធ.
លោកនឹងទទួលយកយើងចូលទៅក្នុងទំនាក់ទំនងជាមួយគាត់.
រ៉ូម 4:7-8 បាននិយាយថា, «មានពរហើយអស់អ្នកដែលប្រព្រឹត្ដអំពើដែលមានគ្មានច្បាប់ត្រូវបានលើកលែងទោស, និងលុបបំបាត់អំពើបាបដែលត្រូវបានគ្របដណ្តប់; អ្នកមានសុភមង្គលគឺជាបុរសម្នាក់ដែលប្រឆាំងនឹងហើយព្រះអម្ចាស់យេស៊ូនឹងមិនរាប់អំពើបាបរបស់ខ្លួន»។
ប៉ុន្តែមិនមានមិនមានកាន់តែច្រើននៅក្នុងប្រទានពរសកលលោកនេះទាំងអស់, ជាជាងការត្រូវបានលើកលែងទោសដោយព្រះ.
ហើយខ្ញុំគិតថានោះជាសោកនាដកម្ម.
វាត្រូវបានគេទទួលស្គាល់ថាយើងមានសេចក្ដីសុចរិតទេ.
ដូច្នេះប្រសិនបើពួកគ្រីស្ទានបានយល់ខុសដោយសេចក្តីជំនឿដល់អ្នក, ត្រូវប្រណីសន្ដោសជាមួយពួកគេ.
តើអ្នកជាយូរមកហើយដើម្បីទទួលការអភ័យទោសពីអំពើបាបរបស់អ្នក?
មានរឿងជាច្រើនដែលយើងបានធ្វើដែលមិនត្រឹមត្រូវគឺ.
