លោកគិតថាសេចក្ដីជំនឿពឹងផ្អែកនៅលើវា.
យើងអាចផងដែរទោះបីជាមិនប្រើគម្ពីរសម្រាប់ការថា.
ហើយវាជាការរំលោភបំពានមួយនៃអត្ថបទពិសិដ្ឋដើម្បីព្យាបាលវាតាមវិធីនោះ.
វាត្រូវបានផ្អែកលើសេចក្តីប្រកាសនៃដំណឹងអំពីជីវិត, ការស្លាប់, និងការរស់ឡើងវិញរបស់ព្រះគ្រីស្ទ.
មិន មែន ត្រឹម តែ ថា, ប៉ុន្តែជំនឿពួកគ្រីស្ទាននេះគឺនៅក្នុងឥតប្រយោជន៍.
ដូច្នេះប្រសិនបើលោកមិនបានលើកឡើង, មិនមានដំណឹងល្អ.
យើងអាចត្រូវបានស្ដារឡើងវិញដល់ព្រះ.
ឥឡូវនេះខ្ញុំនឹងរំលឹកអ្នក, បងប្អូន, ខ្ញុំបានអធិប្បាយនៃដំណឹងល្អដល់អ្នកដែលមាន, ដែលអ្នកបានទទួល, នៅក្នុងការដែលអ្នកឈរ, និងដោយដែលអ្នកកំពុងតែបានសង្គ្រោះ, ប្រសិនបើអ្នកសង្កត់យ៉ាងលឿនទៅពាក្យដែលខ្ញុំបានអធិប្បាយចំពោះអ្នកលុះត្រាតែអ្នកបានជឿថានៅក្នុងការឥតប្រយោជន៍.
បន្ទាប់មកព្រះអង្គបានបង្ហាញខ្លួនអោយបងប្អូនជាងប្រាំរយនាក់ក្នុងពេលតែមួយ, ភាគច្រើននៃពួកគេគឺនៅមានជីវិត, មានអ្នកខ្លះបានទទួលមរណភាពផុតទៅហើយ. បន្ទាប់មកព្រះអង្គបានបង្ហាញខ្លួនអោយលោកយ៉ាកុប, បន្ទាប់មកអោយសាវ័កទាំងអស់ឃើញ.
ហើយគាត់បានកើនឡើងសម្រាប់អំពើបាបរបស់យើង.
នោះជាដំណឹងល្អមួយសម្រាប់មនុស្សមានបាប.
នោះហើយជាអ្វីតែមសាររបស់គាត់.
អ្នកបានឃើញថាដំណឹងនេះគឺមានសារៈសំខាន់ណាស់ក្នុងការដែលលោកបាននិយាយថាលោក Paul បើទោះជាផ្នែកមួយរបស់វានោះគឺជាការមិនពិត, បន្ទាប់មកការផ្សព្វផ្សាយរបស់គាត់គឺនៅក្នុងឥតប្រយោជន៍.
ប្រសិនបើមានការរស់ឡើងវិញនេះគឺជាការមិនពិតដែលនឹងមានឥទ្ធិពលរបស់ខ្លួនការផ្សព្វផ្សាយទាំងអស់?
ការរស់ឡើងវិញនេះមិនអនុវត្តចំពោះជីវិតរបស់អ្នក.
ការស្លាប់គឺជាការពិត.
តើនរណាជាអ្នកឈ្នះនៅទីបញ្ចប់?
ព្រះយេស៊ូមានព្រះជន្មរស់ពីស្លាប់ឡើងវិញ.
ផ្នូរទទេបង្ហាញថាការសន្យារបស់លោកគឺជាការពិត.
ខ្ញុំនឹងអានអត្ថបទចម្រៀងចៃដន្យមួយចំនួនអំពីការអភ័យទោស.
សូម្បីតែបុរសដែលយ៉ាងច្បាស់ថាពួកគេមិនមានបំណងផ្លាស់ប្តូរពិតប្រាកដ.
ពេលខ្លះយើងចូលចិត្តពាក្យសភាពទន់ដូចគុណវិបត្តិ, ឬមិនឥតខ្ចោះ, ឬកំហុស, ប៉ុន្តែពាក្យថា«បាប»ទំនាក់ទំនងអ្វីមួយជាក់លាក់ជាងពាក្យផ្សេងទៀតអ្នកដែល.
វាបានបាត់សញ្ញានេះ, ការធ្លាក់ចុះខ្លីនៃអ្វីដែលព្រះតម្រូវ, ក្នុងគោលបំណងសញ្ញាខុស, បះបោរប្រឆាំងនឹងព្រះ.
ព្រះយកអំពើបាបផ្ទាល់, ការវាយប្រហារផ្ទាល់ខ្លួននៅលើគាត់និងសេចក្ដីល្អរបស់គាត់, ប្រាជ្ញា, និងសិរីរុងរឿង.
មិនមានអ្វីដែលគាត់មិនមែនជាម្ចាស់ជា.
ហើយថាព្រះតែមួយជាចៅក្រមដែលយើងនឹងឈរនៅមុខ.
ជាការប្រសើរណាស់វិធីតែមួយគត់ដែលព្រះអត់ទោសអំពើបាបជាប្រសិនបើវាត្រូវបានបង់រួចហើយសម្រាប់.
និងការរស់ឡើងវិញរបស់ព្រះយេស៊ូវគឺជាភស្តុតាងដែលថាការបង់ប្រាក់ដែលត្រូវបានទទួលយក.
រឿងមួយដែលលោកប៉ូលបានលើកឡើងអំពីប្រសិនបើព្រះយេស៊ូវមិនត្រូវបានលើកឡើងជាការ: «ជំនឿរបស់អ្នកគឺគ្មានប្រយោជន៍ហើយអ្នកនៅតែមាននៅក្នុងអំពើបាបរបស់អ្នក "។
វាមានន័យថាពួកគេនៅតែនៅលើកំណត់ត្រារបស់អ្នក.
វាមានន័យថាអ្នកមិនត្រូវបានបញ្ជូនពីពួកគេ.
បានរួចពីបាបគឺអាស្រ័យលើការរស់ឡើងវិញកាយព្យញ្ជនៈនៃព្រះយេស៊ូវគ្រីស្ទ.
នោះហើយជាដូចជាការប្រកួតចំបាប់ជាមួយនឹងការប្រព្រឹត្ដអំពើបាបនិងអាក្រក់.
ការចូលទៅក្នុងមេឃកំពុងធ្វើបន្ថែមទៀតល្អជាងអាក្រក់, ប៉ុន្តែអ្វីដែលអំពីមិនល្អ?
មានកន្លែងពីរដែលអ្នកអាចមាន, នៅក្នុងព្រះគ្រិស្ដឬនៅក្នុងអំពើបាបរបស់អ្នក.
ប៉ុន្តែចាប់តាំងពីលោកបានលើកឡើង, ទីនោះគឺជាលើកលែងទោសអោយរួចពីបាប!
ព្រះយេស៊ូមានមានអំណាចនឹងអត់ទោសអោយមនុស្សរួចពីបាប.
និងព្រះយេស៊ូវគឺជាព្រះនៅក្នុងសាច់ឈាម.
បាននិយាយថាមិត្តភក្តិរបស់ខ្ញុំទះកំផ្លៀងខ្ញុំក្នុងមុខ.
ការអភ័យទោសមិនគ្រាន់តែមានន័យថាខ្ញុំទទួលយកការសុំទោសរបស់គាត់, វាមានន័យថាខ្ញុំបានព្យាបាលគាត់ដូចជាប្រសិនបើគាត់មិនបានប្រព្រឹត្តអំពើបាបប្រឆាំងនឹងយើង.
ខ្ញុំមិនអាចជឿទុកចិត្តគាត់ដូចគ្នានេះ, ប៉ុន្តែខ្ញុំនឹងមិនកាន់ប្រព្រឹត្ដអំពើបាបប្រឆាំងនឹងគាត់ថា.
ទំនាក់ទំនងរបស់យើងអាចនឹងត្រូវបានស្ដារឡើងវិញ.
ដូច្នេះវាជាការធ្ងន់ធ្ងរទៅឱ្យគាត់, ថាលោកនឹងមិនមែនគ្រាន់តែមើលរំលងវា.
ហើយព្រះបានស្រឡាញ់យើងខ្លាំងដល់ម៉្លេះបានជាលោកចាត់ព្រះយេស៊ូវ.
នោះជាអ្វីដែលឈើឆ្កាងគឺ.
វាដូចជាខ្ញុំនៅក្នុងបន្ទប់សវនាការហើយខ្ញុំយ៉ាងច្បាស់ថាមានកំហុស, ប៉ុន្តែជំនួសឱ្យការត្រូវបានផ្តន្ទាទោសនរណាម្នាក់ត្រូវចំណាយពេលការដាក់ទណ្ឌកម្មថាសម្រាប់ខ្ញុំ.
ពេលដែលយើងបានជឿទុកចិត្តលើព្រះគ្រីស្ទជាព្រះស្ដារទំនាក់ទំនងរបស់លោកជាមួយយើង.
វាជាសាលក្រមរបស់មិនមានទោសពីចៅក្រមនៃសកលលោកទាំងមូល.
មានរឿងគួរឱ្យភ័យខ្លាចបន្ថែមទៀតនៅក្នុងគ្មានការទាំងអស់នៃសាកលជាងការឈរនៅចំពោះព្រះនៅក្នុងអំពើបាបរបស់អ្នកគឺ.
ជាញឹកញាប់, ពួកគ្រីស្ទានមានកេរ្តិ៍ឈ្មោះជាមួយអ្នកដទៃទៀតនៃការបានដោយខ្លួនឯងសុចរិត.
ដោយសារតែនិយមន័យនៃការជឿទុកចិត្ដព្រះគ្រិស្ដជាផ្ទុយគ្នាពិតប្រាកដនៃសេចក្តីសុចរិតបានដោយខ្លួនឯង.
ហើយមកដល់ព្រះនៅក្នុងសេចក្ដីជំនឿ, ថាទ្រង់នឹងអត់ទោសយើងអោយប្រព្រឹត្ដអំពើទុច្ចរិតរបស់យើង.
នោះមិនមែនជាអ្វីដែលព្រះគ្រីស្ទបានបង្រៀន
ខ្ញុំចង់ឱ្យអ្នកគិតអំពីជីវិតរបស់អ្នក.
យើងបាននិយាយកុហក, ហើយយើងបានបុព្វបុរសឡើយ.
យើងជាច្រើននាក់បានលួចនិងចាញ់បោក.
យើងទាំងអស់គ្នា.
ហើយខ្ញុំឆ្ងល់ប្រសិនបើអ្នកជាយូរមកហើយដែលនឹងត្រូវបានអភ័យទោសពីអំពើបាបទាំងនោះ.
ប៉ុន្តែបានតែប្រសិនបើគាត់ពិតជាបានរស់ពីស្លាប់ឡើងវិញ.
បើព្រះគ្រិស្ដមិនបានលើកឡើង, មិនមានជីវិតអស់កល្បជានិច្ច
នៅពេលដែលយើងចូលទៅកាន់បុណ្យសព, មានការមិនpiñatasនិងផ្កាក្រដាស.
មានទឹកភ្នែកគឺមាន.
ប៉ុន្តែនៅពេលដែលយើងគិតអំពីការស្លាប់ដោយខ្លួនវាផ្ទាល់, មានជាច្រើននៃភាពទុក្ខព្រួយជាប់ពាក់ព័ន្ធ.
វាជាការខុសពីធម្មជាតិ.
ប៉ុន្តែនេះផងដែរគឺជាអ្វីដែលកើតឡើងបន្ទាប់ពីបាបបានចូលពិភពលោក.
វាមិនត្រឹមត្រូវ.
មនុស្សជាច្រើននៃពួកយើងគិតថានៃស្ថានមួយដែលជាកន្លែងដែលស្រស់ស្អាត, ដែលជាកន្លែងដែលសាច់ញាតិរបស់យើងទៅពេលអស់ជីវិតទៅ.
ហើយនោះហើយសន្មត់ថា, ថាបន្ទាប់ពីយើងស្លាប់, នោះមិនមែនជាចុងបញ្ចប់.
"បន្ទាប់មកអ្នកដែលបានដេកលក់នៅក្នុងព្រះគ្រិស្ដបានវិនាសសាបសូន្យ.
មានមនុស្សដែលពួកគេស្រឡាញ់ដែលបានកន្លងផុតទៅឆ្ងាយនាក់, ស្រដៀងគ្នាទៅនឹងពួកយើង.
ហើយលោកប៉ុលបាននិយាយថាបើលោកយេស៊ូមិនកើនឡើង, បន្ទាប់មកពួកគេគ្រាន់តែស្លាប់បាត់បង់ជីវិត.
ឥឡូវនេះមនុស្សភាគច្រើនដែលគិតថាជារឿងនៃគ្រីស្ទសាសនាមួយដែលជាកន្លែងដែលអ្នកគ្រាន់តែចូលទៅកាន់ព្រះវិហារពេលខ្លះដោយចៃដន្យ, ហើយប្រហែលជាអ្នកចាំសេចក្ដីអធិស្ឋានរបស់ព្រះអម្ចាស់, មិនយល់ថាហេតុអ្វីបានជាលោកប៉ុលនិយាយនេះ.
ប៉ុន្តែបន្ទាប់ពីមានព្រះគ្រីស្ទជាច្រើន.
លោកបានសួរសម្រាប់អ្វីគ្រប់យ៉ាង.
ថាយើងត្រូវលីឈើឆ្កាងរបស់យើង.
ហើយប្រសិនបើគាត់មិនបានពិតជាទទួលបានរហូត, យើងមានការឆោតល្ងង់.
ដោយសារតែទាំងអស់ដែលយើងបានធ្វើគឺបោះជីវិតរបស់យើងទៅឆ្ងាយដោយគ្មានហេតុផល.
ប៉ុន្តែចាប់តាំងពីលោកបានលើកឡើង, មានគឺជាជីវិតអស់កល្បជានិច្ច!
អ្នកអាចត្រូវបានលើកឡើង.
ពួកគ្រីស្ទានត្រូវបានគេមិនត្រូវអាណិត.
តើមានអ្វីដែលអ្នកអាចធ្វើទៅបុរសម្នាក់ដែលមិនខ្លាចស្លាប់?
គាត់ជាការផាកពិន័យជាមួយនឹងការស្លាប់ដោយសារតែវាមានន័យថាគាត់ទទួលបានការចូលទៅនៅជាមួយព្រះយេស៊ូវ.
ថាមានតែមកពីមនុស្សម្នាក់ដែលជឿទុកចិត្តនៅក្នុងការពិតនៃការស្លាប់និងការរស់ឡើងវិញរបស់ព្រះយេស៊ូ.
វាសំខាន់បើលោកយេស៊ូបានក្រោកឡើង.
រឿងរ៉ាវរបស់គាត់គឺស្រដៀងគ្នាទៅនឹងអ្នកផ្សេងទៀតនៅក្នុងនោះគាត់ស្លាប់.
ប៉ុន្តែមិនមែនមនុស្សគ្រប់គ្នាបានក្រោកឡើង.
ហើយគាត់បានសន្យាថាប្រសិនបើយើងមាននៅក្នុងទ្រង់យើងនឹងទទួលបានការកើនឡើងនិងការចំណាយពេលអស់កល្បជានិច្ចរបស់យើងជាមួយគាត់.
“ព្រះយេស៊ូវគឺជាការដែលព្រះបានចាត់ដើម្បីស្តារ, និងជាពិសេសដើម្បីស្តារពួកយើងដើម្បីអ្នកបង្កើតរបស់យើង.
នៅក្នុងចិត្តរបស់គាត់, គាត់នឹងមិនអាចដោះស្រាយសម្រាប់ការអ្វីនោះទេតិចជាងធំបំផុតនៃពេលវេលាទាំងអស់.
ដោយសារតែគាត់បានជំរុញយ៉ាងខ្លាំងដោយបំណងចង់ក្លាយជាការល្អបំផុត.
ពួកគេកំពុងសំដៅទៅមនុស្សដែលមានអាជីពតម្រង់ទិស, ឬបានកំណត់ដើម្បីទទួលបានជោគជ័យនៅក្នុងវិស័យរបស់ខ្លួន.
តើអ្វីដែលយើងនឹងត្រូវបានជំរុញទៅនិងជំរុញដោយ?
បានយ៉ាងល្អខ្ញុំគិតថាយើងអាចរកចម្លើយទៅនឹងសំណួរនេះនៅរ៉ូម 12.
បន្ទាប់ពីការដាក់ចេញគោលលទ្ធិទូលំទូលាយនៃដំណឹងល្អនេះនៅរ៉ូម 1-11, ប៉ុលបានប្រែទៅប្រាប់យើងពីរបៀបឥឡូវនេះយើងគួរតែរស់នៅ.
ឥឡូវនៅក្នុងជំពូក 12, ប៉ុលបានធ្វើឱ្យការផ្លាស់ប្តូរមានចំនួនសរុបប្រាប់យើងនូវអ្វីដែលយើងគួរធ្វើ.
ដូច្នេះខ្ញុំចង់ឱ្យយើងទៅរកមើលនៅវគ្គនេះ, និងមើលបីយ៉ាងដែលយើងគួរធ្វើនៅក្នុងពន្លឺនៃអ្វីដែលព្រះបានបង្ហាញនៅទីនេះ.
ដូច្នេះនៅពេលដែលលោកប៉ូលបានធ្វើឱ្យមានការផ្លាស់ប្តូរនេះ, លោកអំពាវនាវដល់ពួកយើង.
ប៉ុន្តែមុនពេលដែលយើងមើលពីអ្វីដែលគាត់គឺជាការដាស់តឿនឱ្យយើងធ្វើ, ខ្ញុំចង់ទៅមើលនៅវិធីដែលគាត់អំពាវនាវដល់យើង.
ដើម្បីប្រាប់យើងអំពីរបៀបដែលយើងគួរតែរស់នៅប៉ូលមិននិយាយថាយើងគួរតែរស់នៅវិធីជាក់លាក់មួយដោយសារតែ«យើងចង់ក្លាយជាធំបំផុតឬពិសិដ្ឋបំផុត,"ឬដោយសារតែ«នេះជារបៀបដែលសមាជិក upstanding នៃសង្គមគួរតែរស់នៅ,"ឬ, "ម្តាយរបស់យើងបានបង្រៀនយើងល្អប្រសើរជាងថា,"ឬសូម្បីតែ, "ដូច្នេះថាព្រះនឹងចូលចិត្តអ្នក។ " គ្មាន, គាត់បានផ្តល់ឱ្យយើងនូវប្រភេទផ្សេងគ្នានៃការលើកទឹកចិត្ត.
ពេលនេះខ្ញុំបាននិយាយជាមួយស្ត្រីម្នាក់ដែលជាម្ចាស់ផ្នែកមួយនៃអាជីវកម្មដែលនាងនិងដៃគូរបស់នាងបានចាប់ផ្តើមជាច្រើនឆ្នាំមកហើយ.
បន្ទាប់មកនាងបានប្រាប់ខ្ញុំអំពីកុមារទាំងអស់ដែលនាងមាននិងរបៀបដែលនាងស្រឡាញ់គេ.
ហើយនាងបានចង្អុលទៅដូចជាសេចក្ដីស្រឡាញ់បឋមរបស់នាង, និងការលើកទឹកចិត្តរបស់នាងសម្រាប់ការធ្វើអ្វីគ្រប់យ៉ាងដែលនាងបានធ្វើ.
នាងស្រឡាញ់កុមារនិងការងាររបស់នាង.
សម្រាប់ពួកគ្រីស្ទានការលើកទឹកចិត្តរបស់យើងមិនដែលឈប់ដោយមានអ្វីនៅក្នុងពិភពលោកនេះ.
ប៉ុន្តែគ្មាននរណាម្នាក់នៃអ្នកដែលគួរមានការលើកទឹកចិត្តចុងក្រោយរបស់យើង.
នៅទីនេះលោកប៉ុលបានចង្អុលទៅអ្វីមួយនៅខាងក្រៅខ្លួនយើងនិងនៅលើផែនដីរបស់យើងមានព្រះជន្មរស់សម្រាប់ការលើកទឹកចិត្ត.
លោកបានអំពាវនាវដល់យើងដោយចិត្ដមេត្ដាករុណារបស់ព្រះជាម្ចាស់.
លោកប៉ូលអាចនឹងត្រូវបានគិតពីដំណឹងល្អដែលព្រះបានប្រទានដល់យើងរុងរឿង.
ឬគាត់អាចនឹងត្រូវបានគិតពីជំពូកទីបួន, ដែលជាកន្លែងដែលគាត់បាននិយាយថា, «មានពរហើយអស់អ្នកដែលប្រព្រឹត្ដអំពើដែលមានគ្មានច្បាប់ត្រូវបានលើកលែងទោស, និងលុបបំបាត់អំពើបាបដែលត្រូវបានគ្របដណ្តប់; អ្នកមានសុភមង្គលគឺជាបុរសម្នាក់ដែលប្រឆាំងនឹងហើយព្រះអម្ចាស់យេស៊ូនឹងមិនរាប់អំពើបាបរបស់ខ្លួន»។
ឬគាត់អាចនឹងត្រូវបានគិតពីជំពូកចំនួនប្រាំបីកន្លែងដែលគាត់បានប្រាប់យើងថា, «ព្រះបានធ្វើអ្វីដែលច្បាប់បានចុះខ្សោយដោយនិស្ស័យលោកីយ៍ពុំអាចធ្វើបាន.
ឬមួយខ្ញុំគិតថាគាត់អាចនឹងត្រូវបានគិតពីជំពូកចំនួនប្រាំបួន, ដែលជាកន្លែងដែលគាត់បានប្រាប់ពួកយើង "សេចក្ដីសង្គ្រោះដែលមិនអាស្រ័យលើខំប្រឹងរបស់មនុស្ស, ប៉ុន្តែនៅលើព្រះជាម្ចាស់ដែលមានសេចក្ដីមេត្ដាករុណា»
និង Paul ត្រូវបានគេនិយាយនៅក្នុងពន្លឺនៃសេចក្ដីមេត្ដាករុណាដែល, នៅទីនេះគឺជារបៀបដែលអ្នករស់.
ដូច្នេះយើងត្រូវបានជំរុញដោយការស្រេកឃ្លានក្នុងការបរិភោគ, និងមួយចំនួនត្រូវបានជំរុញដោយសេចក្តីប្រាថ្នាដែលចង់បានជាធំក្នុងការធ្វើការពិបាកជាងនរណាម្នាក់ផ្សេងទៀត.
ប្រគល់រូបកាយរបស់ខ្លួនជាគ្រឿងបូជាដែលរស់នៅ, បរិសុទ្ធហើយគាប់ព្រះហឫ ទ័យដល់ព្រះជាម្ចាស់, ដែលជាការគោរពបូជាខាងវិញ្ញាណរបស់អ្នក។ (រ៉ូម 12:1ខ-D)
ដូច្នេះសូមនិយាយអំពីយ៉ាងខ្លីថា
បុរសម្នាក់គឺជាការមិន.
ប៉ុន្តែដោយសារតែគាត់ជាបរិសុទ្ធហើយពួកគេមានបាប, ពួកគេមិនអាចត្រូវបានអនុញ្ញាតឱ្យគ្រាន់តែចូលទៅជិតទ្រង់តាមរបៀបចាស់ណាមួយឡើយ.
ប្រសិនបើពួកគេត្រូវបានចូលទៅថ្វាយបង្គំព្រះជាម្ចាស់វាមានដើម្បីឱ្យមាននៅលើលក្ខខណ្ឌរបស់គាត់.
ទាំងអស់នៃរាស្ដ្ររបស់ព្រះបានត្រូវបញ្ជាដើម្បីអនុវត្តការលះបង់ទាំងនេះនៅក្នុងគោលបំណងដើម្បីចូលទៅជិតព្រះ.
សត្វទាំងនេះត្រូវបានន័យដើម្បីបង្ហាញប្រជាជនថានៅពេលដែលពួកគេបានប្រព្រឹត្ដអំពើបាប, ការស្លាប់គឺជាការដាក់ទណ្ឌកម្មនេះ.
ជាការពិតណាស់ព្រះជាម្ចាស់គឺមាននៅគ្រប់ទីកន្លែង, ប៉ុន្តែនេះគឺជាអ្វីដែលទ្រង់បានបង្កើត.
ដូច្នេះនៅពេលដែលលោកប៉ូលបាននិយាយថាយើងមានដើម្បីបង្ហាញជូនរូបកាយរបស់យើងដល់ព្រះជាយញ្ញបូជារស់នៅ, វាគួរតែរំលឹកឡើងវិញការលះបង់នេះប្រព័ន្ធ.
ពួកគេត្រូវបានន័យដើម្បីចង្អុលទៅការបូជាចុងក្រោយ, ព្រះយេស៊ូវ.
ហេព្រើរប្រាប់យើងថាការលះបង់ចុងក្រោយនេះគឺនៅពេលដែលសម្រាប់ទាំងអស់គ្នា.
គាត់បានឈរនៅកន្លែងរបស់យើង, ហើយទ្រង់បានស្លាប់ជំនួសឱ្យពួកយើង.
ដូច្នេះដោយមានការយាងមករបស់ព្រះយេស៊ូវ, ការលះបង់នេះមានអាយុជាប្រព័ន្ធត្រូវបានបាត់បង់.
ជាឧទាហរណ៍មួយនៃសំណព្វរបស់ខ្ញុំនេះគឺនៅយ៉ូហានជំពូកទីបួនជាមួយនឹងស្ត្រីម្នាក់នៅក្នុងផងដែរដែល.
បុព្វបុរសរបស់យើងនាំគ្នាថ្វាយបង្គំព្រះជាម្ចាស់នៅលើភ្នំនេះ, ប៉ុន្តែអ្នកនិយាយថានៅក្នុងក្រុងយេរូសាឡឹមជាកន្លែងដែលមនុស្សគួរតែថ្វាយបង្គំទេ។ »ព្រះយេស៊ូមានព្រះបន្ទូលទៅនាងថា, «នាង, ជឿ ខ្ញុំ, ម៉ោងខាងមុខមិនមែននៅលើភ្នំនេះឬនៅក្រុងយេរូសាឡឹមអ្នកនឹងថ្វាយបង្គំព្រះបិតា.
ប៉ុន្ដែដល់ពេលកំណត់ត្រូវបានយាងមក, ហើយឥឡូវនេះគឺនៅទីនេះ, នៅពេលដែលពួកអ្នកថ្វាយបង្គំពិតនឹងថ្វាយបង្គំព្រះបិតាតាមវិញ្ញាណនិងតាមសេចក្ដីពិត, ដ្បិតព្រះបិតាកំពុងស្វែងរកមនុស្សបែបនេះដើម្បីគោរពប្រណិប័តន៍លោក.
ស្ត្រីម្នាក់នេះបានសន្មត់ថាដោយសារតែព្រះយេស៊ូវគឺជាជនជាតិយូដា, លោកចង់ឱ្យនាងទៅថ្វាយបង្គំនៅក្រុងយេរូសាឡឹមនៅព្រះវិហារ.
ជាការប្រសើរណាស់ដែលព្រះយេស៊ូវបានធ្វើឱ្យយ៉ាងច្បាស់ថាជាមួយនឹងការស្លាប់របស់គាត់, ពេលវេលាថ្មីត្រូវបានយាងមក.
ព្រះយេស៊ូវគឺមិនត្រឹមតែការបូជានេះ, ប៉ុន្តែទ្រង់ជាព្រះវិហារថ្មីដែលជាកន្លែងដែលបូជានេះបានកើតមានឡើង.
លើសពីនេះទៀតការក្លាយជាបូជានេះ, ហើយប្រាសាទព្រះវិហារ, លោកយេស៊ូជាមហាបូជាចារ្យរបស់យើង.
ដូច្នេះអ្នកមិនត្រូវការបូជាចារ្យមួយ, ឬសត្វមួយ, ឬអគារមួយដើម្បីថ្វាយបង្គំព្រះ.
បើអ្នកមកទីនេះនៅថ្ងៃនេះហើយអ្នកមិនដឹងថាព្រះយេស៊ូវ, ខ្ញុំចង់លើកទឹកចិត្តអ្នកឱ្យប្រែចិត្តហើយជឿ.
ឥឡូវនេះខ្ញុំមិនគិតថាមានន័យថាយើងគ្រាន់តែជាអ្នកគោរពថ្វាយបង្គំព្រះជាម្ចាស់ដោយមានរូបកាយរបស់យើង.
ដោយខ្លួនឯងទាំងមូលរបស់យើងគឺការលះបង់ដែលយើងអាចផ្តល់ជូន.
មានប្រភេទផ្សេងគ្នានៃអំណោយទានគឺមាន.
ពួកគេគឺជាអំណោយទានមួយចំនួនដែលត្រូវបានផ្តល់ឱ្យជាការបញ្ចប់នៅក្នុងខ្លួនគេ, ដូចជាប្រដាប់ក្មេងលេង.
បន្ទាប់មកមានជាប្រភេទទីពី រនៃអំណោយទាន.
ដូច្នេះមានចំនួននៃអ្នកនៅទីនេះដែលទើបតែបានបញ្ចប់ការសិក្សានិងទទួលបានការប្រាក់ច្រើនជាអំណោយ.
តើមានអ្វីប្រសិនបើអ្នកបានប្រើការត្រួតពិនិត្យនិងសាច់ប្រាក់ជាផ្ទាំងរូបភាព?
ជីវិតរបស់អ្នកគឺថាប្រភេទទីពី រនៃអំណោយទាន.
ក្នុងនាមជាពួកគ្រីស្ទានម្នាក់, អ្នកនឹងមិនត្រូវបានផ្ដល់អំណោយទានដំបូងរបស់ប្រភេទ.
ចុងបញ្ចប់នោះគឺថាអ្នកនឹងគោរពប្រណិប័តន៍ព្រះដោយជីវិតរបស់អ្នក. ខ.
ប៉ុលបាននិយាយថាការលះបង់ដែលរស់នៅទាំងនេះគឺដើម្បីជាបរិសុទ្ធហើយគាប់ព្រះហឫ ទ័យដល់ព្រះជាម្ចាស់.
ដូច្នេះសម្រាប់យើង, យើងកំពុងផ្តល់ជូននូវការថ្វាយយញ្ញបូជារស់នៅរបស់យើងជា.
ព្រះបានប្រទានគោលការណ៍ណែនាំអំពីរបៀបគ្រិស្ដសាសនិកដែលនៅពេលនេះគឺដើម្បីរស់.
ប្រសិនបើយើងមើលទៅនៅសល់នៃជំពូកណាស់នេះ, យើងមើលឃើញលោកប៉ូលចាប់ផ្តើមដាក់ចេញថាអ្វីដែលមើលទៅដូចជា.
