នេះពិតជាមានផលប៉ះពាល់យ៉ាងខ្លាំងលើលោក, ដោយសារតែគាត់តែងតែមានអារម្មណ៍ថាបានបោះបង់ចោល, ហើយក្រោយមកលោកបានបោះបង់ចោលកូនផ្ទាល់ខ្លួនរបស់គាត់.
ហើយពួកគេពិតជាបានយកគាត់នៅក្នុងនិងចាត់ទុកគាត់ដូចជាកូនផ្ទាល់ខ្លួនរបស់ពួកគេ.
និងឪពុកម្តាយរបស់លោកបានធ្វើលះបង់ជាច្រើនដើម្បីឱ្យគាត់ជាឱកាសដើម្បីទទួលបានជោគជ័យជារៀងរាល់.
ពួកគេបានរាងគាត់.
អ្វីដែលស្រស់ស្អាតអំពីការអនុម័តនោះគឺថាអ្នកដែលមានការទទួលខុសត្រូវទៅនរណាម្នាក់នោះទេបានសម្រេចចិត្តទៅយកនៅលើការទទួលខុសត្រូវ.
កុមារគឺជាជនក្រីក្រហើយពួកគេបានយល់ព្រមដើម្បីបំព េញតម្រូវការទាំងនោះ.
ព្រះទ្រង់មិនត្រូវបានកាតព្វកិច្ច.
យើងមានជនក្រីក្រយ៉ាងខ្លាំង, ហើយព្រះបានសន្យាថានឹងជួបតម្រូវការទាំងនោះ.
ព្រះត្រូវបានទទួលយកពួកឧទ្ទាមដែលបានអាក់អន់ចិត្តគាត់.
ព្រះត្រូវបានទទួលយកមនុស្សមានបាបស្រស់ស្អាតនោះទេប៉ុន្តែខូច.
សូមមើលនៅយ៉ូហាន 1:10 ការចាប់ផ្តើមពេលវេលារបស់យើងរួមគ្នា.
ទ្រង់បានយាងមកផ្ទាល់ខ្លួនរបស់គាត់, និងប្រជាជនរបស់ព្រះអង្គផ្ទាល់នោះពុំបានទទួលព្រះអង្គ.
មួយនៃការសន្មត់ជាទូទៅបំផុតនៅក្នុងប្រទេសកម្ពុជាដូចយើងដែរនោះគឺថាអ្នកគ្រប់គ្នាគឺកូនរបស់ព្រះ.
ព្រះគម្ពីរបង្រៀនថានៅពេលដែលយើងកំពុងកើត, យើងមិនបុត្ររបស់ព្រះជាម្ចាស់, ប៉ុន្តែសត្រូវរបស់ព្រះ.
នេះមិនមែនមានន័យថាយើងមានស្នែង, ប៉ុន្តែថាយើងកំពុងខាងក្រោមអារក្សហើយថាសកម្មភាពរបស់យើងមើលទៅកាន់តែច្រើនដូចជាជាងដូចរបស់ព្រះ.
«ជាការពិតណាស់យើងមានកូនរបស់ព្រះ,«ពួកគេអាចនិយាយបានថា.
វាជាការស្រដៀងគ្នាទៅនឹងភាពខុសគ្នារវាងឪពុកបង្កើតរបស់កុមារ, ប៉ុន្តែមិនពិតជាត្រូវបាននៅក្នុងជីវិតរបស់ពួកគេ, បើធៀបទៅនឹងការក្លាយជាឪពុករបស់នរណាម្នាក់, ការស្រឡាញ់ពួកគេ, ការលេងជាមួយនឹងពួកគេ, និងការថែរក្សានូវតម្រូវការរបស់ពួកគេ.
មានត្រូវតែមានការផ្លាស់ប្តូរ, កើតជាថ្មី, ការបម្លែងជាមួយ.
ប្រសិនបើយើងនឹងក្លាយទៅជាកូនប្រុសមួយឬបុត្រីនៃព្រះ, យើងបាននឹងត្រូវបានអនុម័តឱ្យទៅក្រុមគ្រួសាររបស់គាត់.
ប្រសិនបើអ្នកពិចារណាដោយខ្លួនឯងក្លាយទៅជាពួកគ្រីស្ទានម្នាក់, ខ្ញុំចង់ឱ្យអ្នកសួរខ្លួនឯងហេតុអ្វីបានជា.
ហើយពួកគេបាននិយាយថាបាទជាធម្មតា, ហើយខ្ញុំនឹងសុំឱ្យពួកគេហេតុអ្វីបានជា.
ហើយតើអ្នកបានទទួលព្រះយេស៊ូវពីរបៀប?
ដូច្នេះស្រមៃរបស់ព្រះជាសប្បុរសជនជាតិមានទ្រព្យសម្បត្តិនេះដែលផ្តល់នូវការទទួលយកមនុស្សតែមួយគត់នៅលើផែនដីដែលជាកូនរបស់គាត់.
ហើយអ្នកមាននៅក្នុងគ្រួសារ.
ឥឡូវនេះយើងបានកត់សម្គាល់ឃើញគាត់មិនគ្រាន់តែនិយាយថា "ការជឿក្នុងការបង្រៀនរបស់គាត់." គាត់ និយាយ "ជឿលើឈ្មោះរបស់គាត់."មានភាពខុសគ្នារវាងការជឿយ៉ាងខ្លាំងក្នុងការបង្រៀនរបស់នរណាម្នាក់និងទុកចិត្ដលើបុគ្គលពិតប្រាកដគឺ.
ដូច្នេះមិត្តភក្តិ, ខ្ញុំចង់ឱ្យអ្នកដឹងថាវាគឺមិនគ្រប់គ្រាន់សម្រាប់អ្នកក្នុងការនិយាយ, «ខ្ញុំជឿថានៅក្នុងមួយចំនួននៃការបង្រៀនរបស់ព្រះយេស៊ូ, ខ្ញុំជឿថាយើងត្រូវស្រឡាញ់គ្នាទៅវិញទៅមក, ខ្ញុំជឿថាយើងគួរតែទៅព្រះវិហារ "។ លោក John ត្រូវបាននិយាយថាបានទទួលការកាត់មានន័យថាការជឿលើព្រះនាមព្រះអង្គ!
ទាំងអស់នៃព្រះយេស៊ូវ.
ពេលខ្លះយើងគិតថាជំនឿយល់ព្រមជាមួយនឹងការពិតមួយចំនួនអំពីព្រះយេស៊ូវ.
ប៉ុន្តែជំនឿពិតជាជឿទុកចិត្ដលើលោក.
មានអ្នកភ្នាល់ជីវិតរបស់អ្នកនៅលើនេះ?
កំណើតថ្មី អ្នកសម្គាល់ឃើញលោកប្រាប់យើងបន្តិចអំពីអ្វីដែលវាមានន័យថាដើម្បីឱ្យកូនរបស់ព្រះ, ពួកគេជាអ្នកដែលបានរៀបរាប់អំពី "ដែលត្រូវបានកើត, មិនមែនជារបស់ឈាមឬពីបំណងនៃសាច់ឬពីបំណងមនុស្ស, ប៉ុន្តែនៃព្រះ»។
នោះមានន័យថាយើងកំពុងតែបានធ្វើឱ្យថ្មី.
នេះជាលើកដំបូងដែលយើងបានកើតដែលយើងមិនត្រឹមត្រូវ, ដូច្នេះយើងត្រូវការដើម្បីត្រូវកើតជាថ្មីម្តងទៀត.
គាត់បានផ្តល់នូវការប្រកួតជម្រុះជាច្រើនដើម្បីធ្វើឱ្យប្រាកដថាយើងយល់ថា.
"មិនមែនមនុស្ស» -he ចង់ឱ្យយើងដឹងថាវាមិនមកពីចំណង់ផ្លូវភេទរបស់មនុស្ស.
នេះកំណើតថ្មីគឺរបស់ព្រះជាម្ចាស់!
វាជាការពិតមួយសម្រាប់អ្នកដែលបានទុកចិត្ដលើព្រះគ្រិស្ដ.
ការសន្មត់ថាអ្នកនឹងមិនអាចទទួលបានកន្លងមកជាអំពើបាបនោះគឺជាការសន្មត់មានកំហុស.
អ្វីដែលថ្មីបានកើតឡើង.
អ្នកបានចូលរួមជាមួយក្រុមថ្មីមួយគោលដៅថ្មី.
ដូច្នេះអ្នកមានសមាជិកក្រុមគ្រួសារ, បងប្អូនប្រុសស្រីក្នុងជំនឿ.
លើកទឹកចិត្តដល់ពួកគេ.
នៅពេលដែលក្រុមគ្រួសារមួយប្រកាន់ខ្ជាប់នរណាម្នាក់, ពួកគេបានចូលទៅកាន់ខិតខំយ៉ាងខ្លាំងដើម្បីធ្វើឱ្យប្រាកដថាកុមារដែលបានអនុម័តមិនមានអារម្មណ៍ថាដូចជាពួកគេមានកូនបានអនុម័ត.
ផ្ទុយទៅវិញពួកគេចង់ដើម្បីព្យាបាលពួកគេដូចក្មេងដទៃទៀតរបស់ពួកគេ.
តើអ្នកធ្លាប់បានឮនរណាម្នាក់និយាយអំពីទារកមូលនិធិ?
ដូច្នេះមនុស្សមិនពេញចិត្តចំពោះពួកគេ, ដោយសារតែមនុស្សគ្រប់រូបផ្សេងទៀតបានធ្វើការលំបាកសម្រាប់អ្វីដែលពួកគេមាន.
ម្យ៉ាង វិញទៀត, ក្មេងសម្បូរបែបនេះមិនដែលមានទៅធ្វើការក្នុងមួយថ្ងៃនៅក្នុងជីវិតរបស់គាត់ទេប៉ុន្តែគាត់បានធ្វើល្អប្រសើរជាងមនុស្សគ្រប់រូបផ្សេងទៀត.
យើងបានរស់នៅផ្ទុយទៅនឹងច្បាប់របស់គាត់, ហើយយើងបានមិនស្ដាប់បង្គាប់លោក, ប៉ុន្តែនៅពេលដែលយើងបានដាក់សេចក្ដីជំនឿរបស់យើងក្នុងអង្គព្រះគ្រិស្ដយើងទទួលបានអត្ថប្រយោជន៍ទាំងអស់ដែលព្រះយេស៊ូបានទទួល.
ចូរនិយាយអំពីការមួយចំនួននៃរឿងទាំងនោះ.
"សម្រាប់ជាប្រយោជន៍របស់យើងគាត់បានធ្វើឱ្យគាត់ក្លាយទៅជាអំពើបាបដែលបានដឹងថាបាបឡើយ, ដូច្នេះនៅក្នុងលោកយើងអោយបានសុចរិតនៃព្រះ»។ (2 កូរិនថូសទី 5:21)
លោកត្រូវបានគេចាត់ទុកដូចពួកយើង, ហើយយើងបានទទួលការព្យាបាលដូចគាត់.
នៅពេលដែលអ្នកកំពុងអនុម័តដោយព្រះ, អ្នកកំពុងមើលឃើញថាជាសុចរិតក្នុងព្រះអង្គមិនគ្រាន់តែជាការកខ្វក់, ជាមនុស្សមានបាបគ្មានតម្លៃ, រីឯអ្នកសុចរិតជាការ.
យើងទទួលបានការបូកទោះបីជាយើងបានបរាជ័យ, និងព្រះយេស៊ូវទទួលរងការផ្តន្ទាទោសសម្រាប់ការបរាជ័យនេះ.
ហើយបន្ទាប់មករក្សាខ្ញុំពីការអធិស្ឋាន, ដោយសារតែខ្ញុំមានអារម្មណ៍ថាគាត់មិនចង់ឮពីខ្ញុំ.
ដូច្នេះគាត់ជាមិនខឹងខ្ញុំទៀតទេ; គាត់បានរីករាយជាមួយខ្ញុំនៅក្នុងព្រះគ្រីស្ទ.
ខ្ញុំមិនបានធ្វើអ្វីដែលវាត្រូវការដើម្បីទទួលបាននៅទីនោះ, និងមិនមានអ្វីដែលខ្ញុំអាចធ្វើបាននោះនឹងយកមកខ្ញុំជា.
នេះផងដែររំដោះទូលបង្គំអោយរួចផុតពីទាសភាពនៃការព្យាយាមដើម្បីផ្គាប់ចិត្តមនុស្សផ្សេងទៀតគ្រប់ពេលវេលា.
ហើយរឿងមួយដែលជួយខ្ញុំច្រើនបំផុតនេះគឺដើម្បីចងចាំថាខ្ញុំមិនត្រូវការការអនុម័តរបស់ពួកគេ, ដោយសារតែខ្ញុំមានរួចទៅហើយរបស់ព្រះ.
ព្រះគិតខ្ពស់ក្នុងព្រះគ្រិស្ដ, ដូច្នេះសូមឱ្យថាត្រូវបានគ្រប់គ្រាន់.
យើងបានទទួលបានស្លាប់អស់កល្បជានិច្ច, ប៉ុន្តែនៅក្នុងព្រះគ្រីស្ទយើងទទួលបានដើម្បីរស់នៅជារៀងរហូតជាមួយព្រះ.
យើងទទួលបានការរស់នៅក្នុងការគោរពបូជារបស់ស្ដេចល្អឥតខ្ចោះជារៀងរហូត.
ហេតុអ្វីបានជាយើងរស់នៅដូចជាថា?
នេះគឺជាពេលវេលាដែលយើងមាននៅលើផែនដីដើម្បីលើកតម្កើងសិរីរុងរឿងរបស់ព្រះជាម្ចាស់នេះរហូតដល់យើងមានជាមួយគាត់នៅក្នុងស្ថានបរមសុខ.
ប៉ុន្តែនៅពេលដែលយើងដឹងថានេះគឺគ្រាន់តែជាការមើលជាមុនដែលយើងអាចចំណាយពេលវេលារបស់យើងអស់កល្បរបស់យើងក្នុងការវិនិយោគ.
សេចក្ដីស្រឡាញ់ដូចបិតា & ការថែរក្សា
ហើយខ្ញុំនឹងធ្វើអ្វីបានទេសម្រាប់គាត់.
ភស្តុតាងបន្ថែមដែលបង្ហាញពីការពិតដែលថាយើងត្រូវបានចាត់ទុកជាកូនពិតរបស់ព្រះគឺជាការពិតដែលថាយើងមិនអាចត្រូវបានបំបែកពីសេចក្ដីស្រឡាញ់របស់ទ្រង់.
ពីព្រោះយើងកំពុងនៅក្នុងព្រះយេស៊ូដែលយើងអាចមិនត្រូវបានបំបែកចេញពីព្រះជាម្ចាស់.
ចម្លើយ: គ្មាននរណាម្នាក់អាចបំបែកកូនរបស់ព្រះពីសេចក្ដីស្រឡាញ់របស់ទ្រង់.
មិនមានអ្វីនៅក្នុងការទាំងអស់នៃការបង្កើតដែលអាចបំបែកយើងចេញពីសេចក្ដីស្រឡាញ់របស់ព្រះនៅក្នុងព្រះគ្រីស្ទគឺ.
នៅពេលដែលអ្នកត្រូវបានក្មេង, តើអ្នកធ្លាប់មាននរណាម្នាក់ផ្តល់ឱ្យអ្នកនូវអ្វីមួយ, បន្ទាប់មកព្យាយាមយកវាមកវិញ?
នាងនឹងមានអ្វីមួយថានាងពិតជាមិនចូលចិត្ត, ហើយបន្ទាប់មកនាងនឹងផ្តល់ឱ្យវាមកខ្ញុំ.
វាជាការស្រដៀងគ្នាជាមួយព្រះ.
គាត់ និយាយ, "របស់ខ្ញុំ! "គ្មាននរណាអាចឆក់យកយើងចេញឆ្ងាយពីគាត់និងសេចក្ដីស្រឡាញ់របស់.
គ្មាននរណាម្នាក់នៃគ្រាលំបាករបស់យើងអាចបំបែកយើងចេញពីសេចក្ដីស្រឡាញ់របស់ព្រះ.
នៅពេលដែលយើងចាកចេញពីគាត់ទៅបន្ទាប់ពីការបំពេញផ្លូវភេទ, យើងកំពុងតែចាកចេញពីរឿងពិតប្រាកដនៅក្នុងការស្វែងរករបស់ក្លែងក្លាយមួយ.
គាត់នឹងស្តាប់ពាក្យអធិស្ឋានរបស់អ្នកហើយឆ្លើយទៅពួកគេ.
គាត់មិនចាកចេញពីពួកយើងដែលជាកន្លែងដែលយើងមាន.
ដូច្នេះមិនត្រឹមតែតើគាត់ប្រព្រឹត្ដចំពោះយើងដូចព្រះយេស៊ូវ, ប៉ុន្តែលោកបានធ្វើឱ្យពួកយើងដូចលោកយេស៊ូ.
ជាការប្រសើរណាស់ព្រះយេស៊ូជារូបភាពល្អឥតខ្ចោះនៃព្រះ, ហើយព្រះបានអនុលោមទៅរូបភាពផ្ទាល់របស់យើងគាត់បានដោយធ្វើឱ្យពួកយើងដូចដែលព្រះយេស៊ូវ.
យើងបាននិយាយអំពីប្រភេទនៃសេចក្តីជំនឿដែលមានឆន្ទៈក្នុងការចាកចេញទាំងអស់ហើយអ្វីគ្រប់យ៉ាងនៅលើព្រះយេស៊ូវបានភ្នាល់.
ខ្ញុំបាននិយាយទៅកាន់សិស្សមួយចំនួននៅថ្ងៃផ្សេងទៀតអំពីការជឿលើព្រះយេស៊ូ, និងជាមនុស្សម្នាក់បាននិយាយថា, "ខ្ញុំ ជឿជាក់, ប៉ុន្តែខ្ញុំនៅតែចង់ឱ្យមានភាពសប្បាយរីករាយពេលខ្លះ.
វាផ្លាស់ប្តូរវិធីដែលអ្នកសម្លឹងមើលទៅលើអំពើបាបរបស់អ្នក.
សូមស្ដាប់អ្វីដែលលោកប៉ុលបាននិយាយថា:
តើមិនត្រូវបានបញ្ឆោត; មិនប្រាសចាកផ្លូវភេទ, ថ្វាយបង្គំព្រះក្លែងក្លាយឡើយ, ផិតក្បត់ឬ, មនុស្សលោកឬដែលបានអនុវត្តស្រឡាញ់ភេទដូចគ្នា, ចោរឬ, ឬលោភលន់នេះ, មនុស្សប្រមឹកឬ, ត្មះតិះដៀលឬ, ឬនឹងគ្រងនគរបោករបស់ព្រះជាម្ចាស់. និងដូចបុព្វបុរសខ្លះដែលអ្នក.
តើអ្នកនឹងធ្វើបានប្រសិនបើអ្នកបានឃើញទារកប្រាប់ឪពុកម្តាយរបស់នាងអ្វីដែលត្រូវធ្វើ?
អ្នកនឹងគិតថានាងជាឆ្កួត!
ដោយសារតែពួកគេគឺជាឪពុកម្តាយ, ប៉ុន្តែពួកគេកំពុងធ្វើសកម្មភាពដូចក្មេងនេះ.
សូម្បីតែវាគឺ Crazier សម្រាប់ពួកគ្រីស្ទានម្នាក់រស់នៅក្នុងអំពើបាប.
ហេតុអ្វីបានជាអ្នកអាចនឹងមិនអើពើនឹងអំណាចនោះហើយដើរនៅក្នុងទាសភាព?
ឥឡូវនេះយើងកំពុងព្យាយាមដើម្បីធ្វើឱ្យជីវិតរបស់យើងដើម្បីឆ្លុះបញ្ចាំងពីយើងជានរណានៅក្នុងព្រះគ្រិស្ដជារៀងរាល់ថ្ងៃ.
អ្នកគឺជាអ្នកមិនមែនជាអ្នកស្រឡាញ់ភេទដូចគ្នាមួយ.
អ្នកគឺជាពួកបរិសុទ្ធមួយ.
