បើពិធីសម្ពោធលើកនេះមិនដំណើរការល្អ... យប់នេះនឹងពិបាកសម្រាប់យើងទាំងអស់គ្នា។
មនុស្សគ្រប់គ្នាកំពុងស្វែងរកខ្ញុំ។
ខ្ញុំមិនចាំបាច់បារម្ភទេ។
ខ្ញុំនឹងមានអំណាច ហើយបើកទ្វារនោះ... ហើយមើលទៅពិតជាឡូយណាស់។
ចុះបើគ្មានអ្វីកើតឡើង?
មែនហើយនៅក្នុងសេណារីយ៉ូដែលមិនអាចទៅរួចនោះ ... ខ្ញុំនឹងនៅមត្តេយ្យជាមួយអ្នក។
ខ្ញុំនឹងធ្វើអ្វីគ្រប់យ៉ាងសម្រាប់អ្នក។
ខ្ញុំសូមជូនពរឱ្យអ្នកមានទ្វារផងដែរ។
តើអ្នកដឹងអ្វីខ្លះ?
ខ្ញុំមិនបាច់បារម្ភពីអ្នកទេ... ព្រោះអ្នកមានគ្រួសារដ៏អស្ចារ្យ... និងផ្ទះដ៏អស្ចារ្យមួយ។
និងបងប្រុសដ៏អស្ចារ្យម្នាក់។
មើលអ្នកទទួលថាមពលរបស់អ្នក និងទ្វាររបស់អ្នក... នោះហើយជារបៀបធ្វើឱ្យនាងសប្បាយចិត្តជាងអ្វីទាំងអស់។
ប៉ុន្តែគួរឲ្យស្តាយ អ្នកនឹងនឹកមិត្តរួមបន្ទប់ដ៏ល្អបំផុតរបស់ពិភពលោក។
ខ្ញុំដឹងថាអ្នកស្រលាញ់សត្វ... ដូច្នេះខ្ញុំធ្វើបែបនេះ ពេលអ្នកផ្លាស់ទៅកន្លែងថ្មី បន្ទប់ថ្មី... ខ្ញុំតែងតែមានអ្វីដែលត្រូវកាន់។
មិនអីទេ សម្លាញ់តូច ត្រៀមខ្លួនហើយឬនៅ?
សុំទោស ខ្ញុំចង់ឱបអ្នក។
ខ្ញុំនៅទីនេះ។
ខ្ញុំនឹងធ្វើឱ្យឪពុកខ្ញុំមានមោទនភាព។
ស្តាប់ទៅមិនដូចឪពុកទាល់តែសោះ។
ស្តាប់ទៅមិនដូចខ្ញុំទាល់តែសោះ។
យើងនឹងរង់ចាំអ្នកនៅមាត់ទ្វារ។
៥០ឆ្នាំមុន... ក្នុងពេលងងឹតបំផុត... ទៀននេះបានផ្តល់ឱ្យយើងនូវអព្ភូតហេតុមួយ។
ជាកិត្តិយសដ៏ធំធេងសម្រាប់គ្រួសារយើង... គឺប្រើអព្ភូតហេតុដើម្បីបម្រើសហគមន៍ជាទីស្រឡាញ់។
យប់នេះជួបគ្នាទៀតហើយ... ដូចជាជំហានមួយទៀតចូលទៅក្នុងពន្លឺ ... ធ្វើឱ្យយើងមានមោទនភាព។
ប្រញាប់ឡើង ទៅមាត់ទ្វារខ្ញុំ។
តើអ្នកនឹងប្រើអំណាចរបស់អ្នកដើម្បីគោរពអព្ភូតហេតុរបស់យើងទេ?
ខ្ញុំនឹងបម្រើសហគមន៍នេះ... និងពង្រឹងគ្រួសាររបស់យើង?
ខ្ញុំយល់ពីអ្នក។
ជាការពិតពួកគេអាចមក!
យើងមានថាមពលថ្មី!
តើខាងក្នុងធំជាងនេះទេ?
- អស្ចារ្យណាស់!
នាងដឹងថាអ្នកអាចធ្វើបាន!
សមត្ថភាពគឺពិសេសដូចអ្នកដែរ។
មកទីនេះ មកទីនេះ!
រាត្រីដ៏ល្អឥតខ្ចោះ!
កុំសោកសៅ កុំគិតច្រើនពេក
កុំខំប្រឹង កុំសោកសៅជារៀងរហូត
ប៉ុន្តែទោះជាខ្ញុំព្យាយាមប៉ុន្មានដងក៏ដោយ ក៏ខ្ញុំមិនដែលស្មើអ្នកណាដែរ។
តើខ្ញុំជាអ្នកណា គ្មាននរណាម្នាក់
កុំផ្លាស់ទីភ្នំដោយដៃ
មិនអាចរាប់បានប៉ុន្មានយប់ក្នុងភាពងងឹត
ខ្ញុំប្រាថ្នាថាមានវេទមន្តខ្លះ
មិនអាចធ្វើឱ្យរបួសជាសះស្បើយបានទេ។
កុំហៅខ្យល់ ហៅភ្លៀង ពន្លត់ព្រះអាទិត្យ ផ្តល់មេឃពណ៌ខៀវ និងពពកស
មិនអាចលាក់ការចង់បានដែលខ្ញុំបានព្យាយាមអស់មួយជីវិត
ជារៀងរាល់ថ្ងៃខ្ញុំសូមជូនពរឱ្យមានអព្ភូតហេតុតូចមួយតែងតែនៅជាមួយខ្ញុំ
ដើរយូរតែម្នាក់ឯង
វាជាយូរណាស់មកហើយចាប់តាំងពីសុបិនបានហោះហើរ
រង់ចាំថ្ងៃណាមួយ ខ្ញុំនឹងនាំផ្លូវទៅកាន់កន្លែងភ្លឺនោះ។
សូមអនុញ្ញាតឱ្យខ្ញុំផ្លាស់ប្តូរ
គ្មានការព្រួយបារម្ភដូចមុន
ខ្ញុំមើលពេលព្រឹក ខ្ញុំមើលទៅពេលព្រឹក
តើភ្នំខ្ពស់ប៉ុន្មានសង់?
ស្លឹក និងផ្កាចម្រុះពណ៌កាន់តែច្រើន
ប្រាប់ខ្ញុំពីកន្លែងដែលខ្ញុំចាប់ផ្តើមព្រោះខ្ញុំរកមិនឃើញ
នៅតែសុបិន្តជីវិតផ្តល់ឱ្យខ្ញុំនូវអព្ភូតហេតុតូចមួយ អព្ភូតហេតុតិចតួច
វាយដៃរបស់អ្នក របួសបានជាសះស្បើយ
ខ្ញុំសង្ឃឹមថាគ្រួសាររបស់ខ្ញុំនឹងឃើញ
ខ្ញុំមិនខុសពីអ្នកណា ក្រឡេកមើលពេលវេលាកន្លងផុតទៅ?
អ្នកណាយល់បំណងដែលខ្ញុំលាក់ក្នុងចិត្តពេលនេះបានពន្លកហើយ។
ខ្ញុំចង់ឈរនៅទីនេះ ចង់ឈរនៅទីនេះ
ស្តាប់ខ្ញុំសូមផ្តល់វេទមន្តដូចថ្ងៃចាស់
ថ្ងៃដែលអ្នកបានផ្តល់អព្ភូតហេតុ
ប្រសិនបើខ្ញុំសមនឹងទទួលបានអព្ភូតហេតុតិចតួច
ប្រញាប់ឡើងលោកយាយ!
ផ្ទះជួបគ្រោះថ្នាក់!
ឥដ្ឋបានដួលរលំ ហើយមានស្នាមប្រេះនៅគ្រប់ទីកន្លែង។
ហើយទៀនស្ទើរតែបាត់។
ស្នាមប្រេះនៅទីនោះ។
ពួកវាលេចឡើងនៅគ្រប់ទីកន្លែង។
យាយខ្ញុំសន្យា...
វេទមន្តនៅតែខ្លាំង។
សូម្បីតែគ្រឿងស្រវឹង។
តើនោះពិតជាអ្វីដែលអ្នកគិតមែនទេ?
ខ្ញុំកំពុងមើលថែគ្រួសាររបស់ខ្ញុំ។
ខ្ញុំសូមជូនពរឱ្យអ្នកឃើញខ្លួនឯងនូវវិធីដែលខ្ញុំធ្វើ។
អ្នកតែងតែល្អឥតខ្ចោះនេះ។
អ្នកគឺពិសេសដូចអ្នករាល់គ្នាក្នុងគ្រួសារដែរ។
ខ្ញុំទើបតែបានព្យាបាលដៃរបស់អ្នកជាមួយនឹងឈីសប៊ឺហ្គឺ។
ម្ដាយព្យាបាលដៃកូនដោយក្ដីស្រឡាញ់របស់ម្ដាយចំពោះកូន... ជាមួយនឹងគំនិតដ៏អស្ចារ្យរបស់អ្នក ...
-ចិត្តសប្បុរស កែវត្រជាក់...
ខ្ញុំដឹងពីអ្វីដែលខ្ញុំបានឃើញ។
ខ្ញុំក៏មិនចង់ឱ្យអ្នកដែរ។
គេងបន្តិចសិន។
ថ្ងៃស្អែកអ្នកនឹងមានអារម្មណ៍ធូរស្រាល។
ស្នាមប្រេះនៅក្នុងផ្ទះរបស់យើង។
បើគ្រប់គ្នាដឹងថាយើងខ្សោយប៉ុណ្ណា...
ប្រសិនបើអព្ភូតហេតុរបស់យើងជិតដល់ទីបញ្ចប់ ...
យើងមិនអាចបាត់បង់ផ្ទះរបស់យើងទៀតទេ។
ហេតុអ្វីបានជារឿងនេះកើតឡើង?
សូមបំភ្លឺខ្ញុំផង។
ប្រសិនបើចម្លើយគឺនៅទីនេះ ជួយខ្ញុំរកវា។
ជួយការពារគ្រួសារយើងផង។
ជួយខ្ញុំសង្រ្គោះអព្ភូតហេតុរបស់យើង។
ខ្ញុំនឹងជួយសង្គ្រោះអព្ភូតហេតុ។
ប៉ុន្តែខួង។ រក្សាទុកដោយរបៀបណា?
ខ្ញុំត្រូវតែស្វែងរកអ្វីដែលបានកើតឡើងចំពោះអព្ភូតហេតុ។
ប៉ុន្តែមានមនុស្សម្នាក់នៅក្នុងផ្ទះដែលអាចស្តាប់អ្វីទាំងអស់។
អ្នកដឹងទេ ក្នុងចំណោមសាច់ញាតិទាំងអស់ អ្នកគឺជាមនុស្សដែលខ្ញុំចូលចិត្តជាងគេ... ដូច្នេះខ្ញុំមានអារម្មណ៍ថាខ្ញុំអាចនិយាយជាមួយអ្នកអំពីអ្វីមួយ... ដូច្នេះអ្នកអាចប្រាប់ខ្ញុំអ្វីទាំងអស់។
