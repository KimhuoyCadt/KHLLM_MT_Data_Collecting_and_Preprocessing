ហេតុអ្វីបានជាគាត់ត្រូវការប្លន់យើង?
ទឹកដីនៃបេះដូងមានអ្វីៗគ្រប់យ៉ាងរួចហើយ។
អូវាងាយស្រួលក្នុងការធ្វើប័ណ្ណកម្មសិទ្ធិលើគូម៉ាដ្រា នៅពេលដែលអ្នកកាន់អាវុធខ្លាំងបំផុតនៅគ្រប់តំបន់ទាំងអស់។
ត្បូងមិនមែនជាអាវុធទេ។ វាជាវត្ថុបុរាណដ៏ពិសិដ្ឋ។
រឿងកំប្លែងរបស់គូម៉ាដារ៉ា!
គាត់បាននាំយើងតាមវិធីនេះ ដើម្បីនិយាយអំពីរឿងនិទាន។
ខ្ញុំមានអ្វីត្រូវនិយាយ។
ខ្ញុំប្រហែលជានាគតូចមួយ។
ហេខ្ញុំជាអ្នកពាក់ខ្សែកកង្ហារស៊ីស៊ូ។
តើអ្នកបានញ៉ាំហើយឬនៅ?
ម៉ាក់អ្នកនិយាយអញ្ចឹងមែនទេ?
ឆ្គង។ មិនអីទេសំណួរបន្ទាប់។
មិនអីទេស្លៀកពាក់ស្អាតឬធម្មតា?
មានតែសត្វចម្លែកទេដែលអាចជ្រើសរើសបាន ស្លៀកសំលៀកបំពាក់នេះជាប្រចាំ។
ខ្ញុំមិនបានគិតថានឹងធ្វើឱ្យអ្នកឈឺចិត្តទេ។
ខ្ញុំមានបាយមួយភ្លែត។
ហ្វាងអាចមើលទៅស្រស់ស្អាតនៅខាងក្រៅ ប៉ុន្តែយើងមានប្រហោងធំស្អាតខ្លះនៅខាងក្នុង។
សុំទោស។ មិនមានន័យថាធ្វើឱ្យវាចុះ។
ដូច្នេះតើយើងនៅឯណា?
យើងទាំងពីរមានឪពុកម្តាយតែមួយ ដែលគួរឱ្យខ្លាចនៅនិយាយរឿងកំប្លែង។
យើងទាំងពីរជាស្ត្រីអ្នកចម្បាំង ដែលមើលងាយការស្លៀកពាក់ផ្លូវការដែលមិនស្រួល។
ហើយយើងទាំងពីរជាស៊ុបភើរស៊ុស។
អ្នកដឹងទេរឿងព្រេងហ្វាងនិយាយថានាងនៅតែនៅទីនោះ។
អ្នកនិយាយលេងទេ?
តើអ្នកសន្មត់ថាមានវាទេ?
នេះបើយោងតាមនេះ។ បន្ទាប់ពីព្រះចៅស៊ីសស៊ូបានបំផ្ទុះគ្រាប់បែកឌុុនទាំងអស់។ នាងបានធ្លាក់ចូលទៅក្នុងទឹកហើយអណ្តែតលើខ្សែទឹកខាងក្រោម។
រឿងព្រេងនិទាននិយាយថាឥឡូវនេះនាងកំពុងដេកនៅចុងទន្លេ។
ប៉ុន្តែទន្លេមួយណា?
មានដូចជារាប់រយ។
ប៉ុន្តែប្រសិនបើយើងអាចរកវាឃើញតើអ្នកអាចស្រមៃបានទេ?
នាគត្រឡប់មកវិញនៅក្នុងពិភពលោក។
អ្វីៗអាចល្អប្រសើរជាងនេះ។
ប្រហែលជាយើងពិតជាអាចជាគូម៉ាដារ៉ាម្តងទៀត។
ពីនាគមួយទៅមួយទៀត។
មកជាមួយខ្ញុំឌីឡា។ ខ្ញុំចង់បង្ហាញអ្វីមួយដល់អ្នក។
ស្មារតីរបស់ស៊ីស៊ូ។ ខ្ញុំអាចមានអារម្មណ៍។
វាជាប៊ីចេងចុងក្រោយនៃមន្តអាគមនាគ បានចាកចេញពីពិភពលោកទាំងមូល។
ខ្ញុំយល់ពីមូលហេតុដែលបេះដូងការពារវាយ៉ាងជិតស្និទ្ធ។
សូមអរគុណឌីឡា។ អ្នកបានជួយច្រើនណាស់។
នៅក្នុងពិភពខុសគ្នាប្រហែលជាយើងអាចធ្វើជាមិត្ត ប៉ុន្តែខ្ញុំត្រូវតែធ្វើអ្វីដែលត្រឹមត្រូវសំរាប់ហ្វាង។
ប្រធានវីរ៉ារ៉ាខ្ញុំពិតជារីករាយណាស់ដែលហ្វាងបានទទួលយកការអញ្ជើញរបស់យើង។
មិនមានវិធីណាដែលអ្នកកំពុងយកត្បូងរបស់ស៊ីស៊ូទេ។
អ្នកនឹងមិនឈរជើងនៅរង្វង់ខាងក្នុងរបស់នាគហ្គីតាទេ។
ហ្វាងកំពុងលេងសម្រាប់ត្បូង!
ឆ្អឹងខ្នងគួរតែមានត្បូងពេជ្រ!
មិនមែនទេប្រសិនបើយើងទៅដល់វាជាមុន!
យើងអាចបង្ហូរទឹកភ្នែកគ្នាបាន ឬយើងអាចរួមគ្នានិងកសាងពិភពលោកមួយដែលល្អប្រសើរ។
ខ្ញុំនៅតែជឿជាក់ថាយើងអាចជាគូម៉ាដារ៉ាម្តងទៀត។
ត្បូងជាកម្មសិទ្ធិរបស់ឆ្អឹងខ្នង!
ឱ្យត្បូងមកខ្ញុំ!
នៅតែមានវេទមន្តនៅក្នុងពួកគេ!
ពួកវាត្រូវបានជះទឹកដោយទឹក។
សូមយើងត្រូវបន្តដំណើរទៅមុខទៀត។
យើងមិនមានពេលវេលាទេ!
រ៉ាយ៉ាអ្នកត្រូវស្តាប់។
អ្នកគឺជាអាណាព្យាបាលរបស់នាគមាស។
បា, ហេតុអ្វីបានជាអ្នកនិយាយបែបនេះ?
វានៅតែមានពន្លឺនៅក្នុងរឿងនេះ។ នៅតែមានសង្ឃឹម។
យើងអាចបង្កើតវាជាមួយគ្នា។
រ៉ាយ៉ា។ កុំបោះបង់វាចោល។
ខ្ញុំស្រឡាញ់អ្នកទឹកសន្សើមរបស់ខ្ញុំ។
សូមឱ្យវាក្លាយជាវា។
តើអ្នកកំពុងធ្វើអ្វី?
ហេ, សម្លាញ់, ការផ្តោតអារម្មណ៍។
ភ្នែកទៅមុខតុកកែ។
អ្នកងាយនឹងបង្វែរអារម្មណ៍។
អ្នកកំពុងធំបន្តិចហើយសម្រាប់បញ្ហានេះ។
រយៈពេលប្រាំមួយឆ្នាំនៃការស្រាវជ្រាវ ហើយយើងបញ្ចប់នៅឯកប៉ាល់លិច។
ខ្ញុំមិនដឹងថាតើអ្នកកំពុងស្តាប់ទេ។
ខ្ញុំបានស្វែងរកគ្រប់ទន្លេទាំងអស់ដើម្បីស្វែងរកអ្នក ហើយឥឡូវនេះខ្ញុំមកដល់ទីនេះហើយ។
ប្រសិនបើខ្ញុំអាចស្មោះត្រង់
ខ្ញុំពិតជាត្រូវការជំនួយពីអ្នក។
ខ្ញុំជឿទុកចិត្តលើនរណាម្នាក់ដែលខ្ញុំមិនគួរមាននិង ... ... ឥឡូវនេះពិភពលោកបែកបាក់។
ខ្ញុំពិតជាចង់អោយបារបស់ខ្ញុំត្រឡប់មកវិញ។
នៅទីនេះទៅអ្វីគ្រប់យ៉ាង។
អូអស្ចារ្យស៊ីស៊ូ។
អ្នកណានិយាយដូច្នេះ?
មិនអាក្រក់ពេកទេ។ គ្រាន់តែធូលីបន្តិច។
អនុញ្ញាតឱ្យខ្ញុំទទួលបានសម្រាប់អ្នក។
ហើយអ្នកជាមនុស្ស។
ហើយអ្នកមិនត្រូវបានធ្វើពីថ្មដែលមានន័យថា ...
ខ្ញុំមិនរញ៉េរញ៉ៃទេ!
ខ្ញុំផ្តោតការយកចិត្តទុកដាក់ខ្លាំងណាស់លើការជួយសង្គ្រោះពិភពលោក
ខ្ញុំភ្លេចញ៉ាំអាហារពេលព្រឹកនៅថ្ងៃនេះ។
តើអ្នកគិតថាថ្ងៃនេះជាពេលណា?
តើអ្វីទៅជាវិធីធ្វើម្ហូបដ៏រីករាយនេះ?
វាជាផ្លែខ្នុរជឺជឺ។ ខ្ញុំស្ងួតវាដោយខ្លួនឯង។
ជាការប្រសើរណាស់សូមសរសើរដល់មេចុងភៅ។
Sisu មានរឿងមួយចំនួនដែលខ្ញុំត្រូវការដើម្បីចាប់អ្នក។
អ្នកបានបំបែកវា?
ខ្ញុំបានដេកលក់អស់រយៈពេល ៥០០ ឆ្នាំហើយ អ្នកបាននាំយកមកវិញនូវដុន ហើយគ្មានបងប្អូនប្រុសស្រីរបស់ខ្ញុំត្រឡប់មកវិញទេ។
ហេតុអ្វីបានជាពួកគេមិនត្រឡប់មកវិញ?
អ្នកក៏បែកត្បូងដែរ!
ប៉ុន្តែខ្ញុំនៅតែមានកំណាត់ធំ ៗ ដដែល។
តើសន្មត់ថាធ្វើអោយខ្ញុំមានអារម្មណ៍ធូរស្បើយទេ?
"អញ្ចឹងយើងនៅតែមានកំណាត់ធំ ៗ ដដែល!"
តើរឿងនោះធ្វើឱ្យអ្នកធូរស្បើយទេ?
តើអ្នកមិនអាចបង្កើតមួយផ្សេងទៀតបានទេ?
ប៉ុន្តែអ្នកជានាគ។
ខ្ញុំនឹងពិតជាមួយអ្នកមែនទេ?
ខ្ញុំមិនមែនដូចជានាគល្អបំផុតមែនទេ?
ប៉ុន្តែអ្នកបានសង្គ្រោះពិភពលោក។
ខ្ញុំបានធ្វើដូច្នេះ។ វាជាការពិត។
ប៉ុន្តែតើអ្នកធ្លាប់ធ្វើគំរោងក្រុមទេ ប៉ុន្តែមានដូចជាក្មេងម្នាក់នោះ ដែលមិនមានសំលេងច្រើនដូច
មែនខ្ញុំមិនមែនជាអ្នកបង្កើតត្បូងនោះទេ។
ខ្ញុំទើបតែបើកវា។
