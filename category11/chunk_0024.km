ខ្ញុំមិនយល់ពីតម្រូវការសម្រាប់វិធានការសន្តិសុខដ៏ល្អិតល្អន់បែបនេះទេ។
ពូស្កតត្រូវបានស្តេចជិះសេះ។
គាត់នឹងត្រលប់មកពីទីក្រុងឡុងដ៍ក្នុងរយៈពេលពីរថ្ងៃ។
អ្វីគ្រប់យ៉ាងត្រូវបានពិនិត្យ, លោក។
តើអ្នកបានពិនិត្យទ្វារនីមួយៗទេ?
មនុស្សរាប់រយនាក់កំពុងធ្វើការពេញមួយម៉ោងដើម្បីធ្វើឱ្យប្រាកដថាអ្វីៗមានភាពរលូន
ឃើញពន្លឺទាំងនេះទេ?
ពួកគេត្រូវបានតែងតាំង
- តើអ្នកកំពុងធ្វើអ្វីនៅទីនេះ?
គាត់នៅជាមួយខ្ញុំ។
គាត់នៅទីនេះតាមការអញ្ជើញរបស់ខ្ញុំ។ ឱ្យគាត់ទៅ។
អ្នកបម្រើមិនអាចប្រើច្រកចូលធំបានទេ លោកស្រី។
ខ្ញុំនឹងបង្ហាញផ្លូវចូលខាងក្រោយគាត់។
គាត់មិនមែនជាអ្នកបំរើទេ។
គាត់គឺជាមិត្តរបស់ខ្ញុំ។ ឱ្យគាត់ទៅ។
នោះជាអាកប្បកិរិយាគួរឲ្យរន្ធត់។ ខ្ញុំសុំទោស។
អ្នកសុខសប្បាយទេ មែនទេ?
ខ្ញុំពិតជាទន្ទឹងរង់ចាំរឿងនេះ។
ខ្ញុំមានច្រើនណាស់ដែលខ្ញុំចង់បង្ហាញអ្នក។
សូម។ មកអង្គុយចុះ។
នេះជាបន្ទប់របស់ខ្ញុំ... ... ហើយទាំងនេះគឺជាគំនូររបស់ខ្ញុំ។ តើអ្នកគិតអ្វី?
សូម។ អង្គុយចុះ។
ការរាំរបស់អ្នកនៅឯពិធីជប់លៀងធ្វើឱ្យខ្ញុំដកដង្ហើមចេញ។
វាអស្ចារ្យណាស់។
សូមអរគុណលោកស្រី។
Akhtar... ... ភ្នែកបង្ហាញយ៉ាងជ្រាលជ្រៅរបស់អ្នក តែងតែហាក់ដូចជាពួកគេកំពុងស្វែងរកអ្វីមួយ។
ជេននី ខ្ញុំមិនអាចយល់ពីអ្វីដែលអ្នកកំពុងនិយាយទេ។
"អូមីណា ខ្ញុំនឹងមិនលាបស្លាបរបស់អ្នកទេ មករកខ្ញុំ"
"ព្រះច័ន្ទអឌ្ឍចន្ទអើយ ខ្ញុំមិនតុបតែងអ្នកដោយរោមក្ងោកទេ សូមមករកខ្ញុំ"
ខ្ញុំនឹងអោយអ្នកញ៉ាំ។
"ទន្សាយវង្វេង មករកខ្ញុំ"
"ហែលកាត់មែកឈើលេងនៅជ្រលងភ្នំ"
ស្តាប់ ខ្ញុំនឹងត្រលប់មកយកអ្នកពីទីនេះ។
គ្មានផ្លូវផ្សេងទេ ម៉ាលី
ខ្ញុំចង់ទៅផ្ទះ។ យកខ្ញុំទៅឥឡូវនេះ!
ខ្ញុំនឹងមិននៅទីនេះមួយភ្លែតទៀតទេ។
តើអ្នកមិនស្តាប់ខ្ញុំទេ?
ស្តាប់ខ្ញុំ ម៉ាលី-
- កុំបង្កើតសំលេងរំខាន។
ខ្ញុំមិនដឹងទាំងអស់នោះទេ។
បងប្រុស។ បងប្រុស។
សូមកុំទុកខ្ញុំនៅទីនេះ។
ខ្ញុំចង់ត្រលប់ទៅម្តាយរបស់ខ្ញុំវិញ។
សូមនាំខ្ញុំទៅផ្ទះ។
"អ្វីៗនឹងនៅចំពោះមុខអ្នក ប្រសិនបើអ្នកបិទវា"
"រាត្រីច្រៀងនៅខាងក្រោយដើមឈើ" ... "នឹងលេចឡើងក្នុងបេះដូងរបស់អ្នករាល់ពេលដែលអ្នកបិទភ្នែករបស់អ្នក"
"ដើមឈើ និងស្លឹកខ្ចីនឹងឃើញនៅថ្ងៃនេះ ពីជញ្ជាំងថ្មជុំវិញពួកវា"
"បើអ្នកអត់ធ្មត់ បិទភ្នែកមួយភ្លែត..."
"ថ្ងៃនឹងមកដល់ឆាប់ៗនេះ ដែលអ្នកនឹងមានសេរីភាព"
ស្ត្រីស្បែកសទាំងនេះមិនបង្កើតកូនទេ?
គេមិនដឹងថាឈឺអ្វី?
ពួកគេបានយកក្មេងម្នាក់ទៅឃុំឃាំងក្នុងទ្រុង។
យើងមិនគួរភ័យខ្លាចទៀតទេ។
យើងគួរតែដើរទៅមុខ។
អ្នកណាមកតាមផ្លូវយើងត្រូវកំចាត់ចោល។
តើបងប្រុសរបស់អ្នកនៅឯណា?
ប្អូនប្រុសរបស់ខ្ញុំកំពុងបំពេញបេសកកម្ម ហើយគាត់នឹងមិនត្រូវបានគេចាប់ខ្លួនឡើយ។
ជាពិសេសមិនមែនដោយជនក្បត់ដូចអ្នកទេ។
ឆ្កែមិនអាចដេញតាមខ្លាបានទេ។
គ្មានអ្នកណាមកទេបងស្រី
- យ៉ាងហោចណាស់គាត់បានសរសេរសំបុត្រមួយ?
វាមានរយៈពេល 4 ឆ្នាំហើយចាប់តាំងពីគាត់បានចាកចេញ។
តើយើងត្រូវរង់ចាំគាត់យូរប៉ុណ្ណា?
តើគាត់ចងចាំយើងទេ?
យ៉ាងហោចណាស់គាត់ចងចាំអ្នកទេ?
អ្នកនឹងបន្តជួបប្រទះការឈឺចាប់នេះ រហូតដល់ខ្ញុំទទួលបានចម្លើយ។
ប្រាប់ខ្ញុំផង... តើបងប្រុសរបស់អ្នកនៅឯណា?
សូម្បីតែជនជាតិអង់គ្លេសក៏មិនមានថ្នាំព្យាបាលពិសរបស់វាដែរ។
អ្នកនឹងស្លាប់ក្នុងរយៈពេលមួយម៉ោង។
វានឹងចំណាយពេលមួយថ្ងៃដើម្បីស្រាយចំណងទាំងនេះ។
រស់នៅក្នុងជីវិតរបស់អ្នក។
យើងគួរតែអនុវត្តផែនការរបស់យើងនៅយប់នេះដោយតម្លៃណាមួយ។
ប្រសិនបើយើងខកខានឱកាសនេះ យើងប្រហែលជាមិនទទួលបានមួយផ្សេងទៀតទេ។
ឡានកំពុងដំណើរការត្រឹមត្រូវមែនទេ?
ខ្ញុំបានសាកល្បងវាម្តងទៀត។ វាស្ថិតក្នុងស្ថានភាពល្អ។
យើងគួរសម្រុកចូលភ្លាមៗតាមការរៀបចំរួចរាល់។
ចាងហ៊ួ អ្នកចាំបានទាំងអស់មែនទេ?
ខ្ញុំបានទន្ទេញគ្រប់យ៉ាងហើយបងប្រុស។
បងប្រុសតើពេលណាទៅបឹងហ្គាឡូ?
ចាងហ្គូ ចូរទៅឥឡូវនេះ ហើយទន្ទេញសំឡេងនៃច្រកទ្វារ។
បងប្រុស តើមានអ្វីកើតឡើង?
"ខាងកើតនិងខាងលិចជាប់ពាក់ព័ន្ធនឹងសង្គ្រាម"
"អ្នកដ៏ទៃជាអ្នកនាំសេចក្តីស្លាប់..."
ហេតុអ្វីបានជាអ្នកដកខ្សែបរិសុទ្ធចេញ?
កុំធ្វើអីបងប្អូន។
ការដកវាចេញនឹងនាំឱ្យអ្នកមានបញ្ហា។
បងប្រុសត្រូវការវាច្រើនជាងខ្ញុំ។
កុំបិទភ្នែកបងប្អូន។ ខ្ញុំនៅទីនេះជាមួយអ្នក។
អ្នកនឹងមិនអីទេ។ ខ្ញុំនៅទីនេះជាមួយអ្នក។
អ្នករួចផុតពីគ្រោះថ្នាក់ហើយ។ អង់ទីករមានប្រសិទ្ធភាពប្រឆាំងនឹងជាតិពុល។
អ្នកនឹងបានជាសះស្បើយទាំងស្រុងនៅថ្ងៃស្អែក។
ខ្ញុំមានការងារខ្លះ។ ខ្ញុំនឹងត្រឡប់មកវិញ។
ប្រសិនបើខ្ញុំមានជម្រើស ខ្ញុំនឹងនៅជាមួយអ្នក។
ប៉ុន្តែខ្ញុំត្រូវទៅ។
...ខ្ញុំបានលាក់ការពិតមួយពីអ្នក។
ខ្ញុំគឺ ប៊េម។ បុត្រានៃព្រះ។
ពួកគេបានយកក្មេងស្រីតូចម្នាក់ចេញពីភូមិរបស់យើង។
យើងមិនដឹងថាត្រូវធ្វើអ្វីទេ។
យើងមិនដឹងពីរបៀបជួយសង្គ្រោះនាងទេ។
យើងមិនដឹងថាត្រូវទុកចិត្តអ្នកណាទេ។
នោះហើយជាមូលហេតុដែលខ្ញុំស្លៀកពាក់ក្លែងក្លាយនេះ។
ខ្ញុំចង់ស្វែងរកជំនួយពីអ្នកជាច្រើនដង។
ប៉ុន្តែខ្ញុំមិនបានធ្វើដូច្នេះទេ ព្រោះខ្ញុំមិនចង់ធ្វើឲ្យជីវិតអ្នកជួបគ្រោះថ្នាក់។
បើយើងចេញទៅដោយសុវត្ថិភាព ខ្ញុំនឹងមកជួបអ្នកម្តងទៀត។
ខ្ញុំមានមិត្តភាពរបស់អ្នក ដែលមានតម្លៃជាងជីវិតរបស់ខ្ញុំទៅទៀត។
ខ្ញុំនឹងស្លាប់ដោយមោទនភាព។
ដល់ពេលក្រោយទៀតបង។
"ខ្ញុំមានមិត្តភាពរបស់អ្នកដែលមានតម្លៃជាងជីវិតរបស់ខ្ញុំ" ។
"បងប្រុសត្រូវការវាច្រើនជាងខ្ញុំ"
