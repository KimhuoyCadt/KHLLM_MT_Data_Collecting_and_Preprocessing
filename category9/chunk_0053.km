- ការឈឺចាប់ យូរ នៅក្នុង ពោះ ខាងលើ ។
ពួកគេ ភាគ ច្រើន នឹង និយាយ អ្វី ដែល អ្នក ចង់ និយាយ ។
១១: ៥) ដូចជាអ្នកមិនដឹងថាអ្វីទៅជាផ្លូវនៃខ្យល់ ឬដោយរបៀប ណាដែលឆ្អឹងលូតលាស់ក្នុងផ្ទៃរបស់នាងដែលមានកូន ដូច្នេះអ្នកមិនដឹងពីកិច្ចការរបស់ព្រះ ដែលបង្កើតអ្វី ៗទាំងអស់ឡើយ ។
នោះជា សពគ្មានវិញ្ញាណ ។
ការច្រូត កាត់ របស់ មនុស្ស ទុច្ចរិត ។
ខ្ញុំ ជា ទីក្រុង ថ្មី ។
មុខងារ បណ្ណាល័យ ។
“ បងប្រុស ជាទី ស្រឡាញ់របស់ខ្ញុំតើអ្នកដឹងថាអ្វីដែលតម្លៃនៃមួយ
ឪពុក ម្តាយ របស់ ពួកគេ បាន នាំ ពួកគេ ទៅ មន្ទីរពេទ្យ ។
អ័ដាម ចាប់តាំងពីថ្ងៃដែលគេចេញពីផ្ទៃម្ដាយរហូតដល់ថ្ងៃនោះ ។
ដូច្នេះ ស្នៀតដែលមិនត្រូវបានគេទម្លាក់ចោលនៅពេល បញ្ចប់សង្គ្រាមនេះ
គាត់បានចូលទៅក្នុងព្រះវិហារ ជាមួយនឹងពួកគេ ដើរលោតសរសើរ ត ម្កើងព្រះជាម្ចាស់ ។
ហើយ ជឿ ខ្ញុំ ខ្ញុំ ដឹង ពី ការឈឺចាប់ របស់ អ្នក ។
ពិភពលោកនេះជារបស់យើង - ចូរធ្វើឱ្យវាស្រស់ស្អាត៖ ខែ កញ្ញា ឆ្នាំ ២០០៩
គាត់ បាន បង្វែរ ចំណាប់អារម្មណ៍ របស់ គាត់ ទៅ បុរស ថ្មី ។
ខែមិថុនា គឺជា តារា បាក់បែក ។
ប៉ុន្តែ ពេលលោកអ៊ូរីយ៉ាបានឮដូច្នេះ គាត់ក៏ភ័យខ្លាច ហើយ រត់ទៅស្រុកអេស៊ីប ។
វាត្រូវបានគេឲ្យតម្លៃដោយឥសី គឺជាវិញ្ញាណដែលគ្មានពន្លឺ ( នៃអត្មា ) នៃ ចិត្ត ( នៃសុបិន ) និងនៃបញ្ញា ( ក្នុងដំណេកជ្រៅ ) ។
ហើយយើងមានចៅហ្វាយម្នាក់ដែលអាចត្រូវបានគេទាញ យកមួយចំនួនដើម្បីពង្រីកចំនួនដែលបានចំណាយលើការ ញ៉ាំស្រាហើយមិនចូលរួម ។
ដូច្នេះយើងត្រូវយកប្រជាជនចេញ
ខ្ញុំគិតថាខ្ញុំគ្រាន់ តែធ្វើឱ្យនេះ កាន់តែលំបាក !
អត្ថិភាព របស់ មនុស្ស ឯក វចនៈ នៃ ព្រះរាជ បុត្រា នៃ ព្រះគឺ អម ដោយ មាតា ដ៏ មាន ព្រះពរ របស់ ទ្រង់ ដែល មាន តែ យើង ម្នាក់ គត់ ក្នុង ចំណោម សត្វ ទាំងអស់ ដែល យើង ថ្វាយបង្គំ ព្រះដ៏ បរិសុទ្ធ និង ពោរពេញ ដោយ ព្រះគុណ ។
អារ៉ាប៊ី សាអូឌីត បាន អញ្ជើញ មេដឹកនាំ និង តំណាង ប្រទេស ចំនួន ៥៥ សម្រាប់ ដំណើរទស្សនកិច្ច .. .
• ពន្លឺ ព្រះអាទិត្យ ដោយ ផ្ទាល់ មិន អាច ចូលទៅ ខាងក្នុង បាន ទេ ។
« ចូរថែរក្សាកន្លែងដ៏ល្អដែលបានប្រគល់ឲ្យអ្នក ថែរក្សាវាដោយជំនួយពីព្រះវិញ្ញាណបរិសុទ្ធ ដែលគង់នៅក្នុងយើង » ។
តើអ្នកមានសម្រាប់ពីរឆ្នាំខាងមុខទេ ? » ហើយម្នាក់ក្នុងចំណោមពួកគេគឺ : " តើអ្នកដឹងពីរបៀបជិះទូក?
មន្ត្រីរដ្ឋបាលព្រៃឈើបានព្រមានពួកគេថា បើមិនឈប់ទេនឹងរឹបអូសឧបករណ៍ និងគ្រឿងចក្រ » ។
ពេលអ្នកអង្គុយសម្លឹងមើលភ្លើង អ្វី ៗនៅតាមបរិវេណនោះ រលត់ទៅជាខ្មៅ ។
អាលី និយាយ ថា គាត់ និង បង ប្រុស របស់ គាត់ មាន ត្រឹមតែ 15 ដុល្លារ ប៉ុណ្ណោះ រវាង ពួកគេ - ស្ទើរតែ គ្រប់គ្រាន់ ដើម្បី ទិញ អាហារ ប្រហែល មួយ សប្តាហ៍ ។
កាលពីឆ្នាំមុន យើងពិការ ភ្នែក » ។
កិច្ចការដែលខ្ញុំធ្វើក្នុងព្រះនាមព្រះវរ បិតាខ្ញុំថ្លែង ទី បន្ទាល់ដល់ខ្ញុំ ។
ខ្ញុំប្រាប់អ្នក រាល់គ្នាជាប្រាកដថា បើអ្នក ណា កាន់តាមពាក្យខ្ញុំ អ្នក នោះនឹងមិនឃើញសេចក្ដី ស្លាប់ឡើយ ។
អ្វីដែលខ្ញុំធ្វើនៅផ្ទះជាមួយនឹងទ្រព្យ សម្បត្តិរបស់ខ្ញុំគឺជាអាជីវកម្មរបស់ខ្ញុំ ។
ដូច្នេះ យើងត្រូវទទួល យកការ កំណត់របស់យើង និងអសមត្ថភាពក្នុងការ យល់ដឹងនូវអាថ៌កំបាំងទាំងអស់របស់ព្រះ។
ពេលរកឃើញបែបនេះ ពួកគេគ្មានហេតុ ផលត្រូវវង្វេងឡើយ ។
ចំណែក ឯអ្នកនឹងពិភាក្សាជាមួយមនុស្ស ត្រង់ ដោយបង្ហាញថាគេត្រង់ ។
គាត់ នៅ គ្រប់ ជំហាន ហើយ បាន ទៅដល់ ទីក្រុង ក្នុង ស្ថានភាព ដ៏ អស្ចារ្យ មួយ ។
« គេនិយាយថា បើយើងចង់ផ្លាស់ប្តូរការ ដឹកនាំ យើងមិនអាច ត ទល់នឹងកំពូលបានទេ ។
១៤ មានកូនប្រុសប្រាំពីរនាក់របស់លោកស្សេវ៉ា ជាបូជាចារ្យជនជាតិយូដា ដែលធ្វើការ នេះ ។
កុំ ច្រឡំ ការ ពិត ជាមួយ ការផ្សព្វផ្សាយ របស់ អ្នក ។
ពួកគេបានចេញមក ហើយផ្សងព្រេងដោយមិនបង្ហាញខ្លួនយើងចំពោះការ មិនសប្បុរសនោះទេ ។
បន្ទាប់មក គាត់ បាន បង្កើត ត្របកភ្នែក ខាងលើ ឡើងវិញ ។
មាន ស្រី បំរើ របស់ សម្ដេច សង្ឃ ម្នាក់ នៅក្បែរ គាត់ ។
ខ្ញុំ មានអារម្មណ៍ ដូចជា មនុស្ស ពឹងផ្អែក លើ ខ្ញុំ ។
ដោយការ លំបាកនិងការ លំបាកយ៉ាងខ្លាំង ខ្ញុំបានចេញទៅក្រុង តេហេរ៉ង់ ។
' ព្រះអម្ចាស់ អើយ ទូលបង្គំ ចង់ឱ្យ ព្រះនាម ទ្រង់ មាន កិត្តិយស ។
ខ្ញុំ នឹង ពិគ្រោះ ជាមួយ អាជ្ញាធរ របស់ ខ្ញុំ ។
អ្នក មិន សប្បាយ ចិត្ត និង ចែចង់ ជាមួយ បុរស ផ្សេង ទៀត ។
បែរត្រចៀកចេញពីសេចក្ដី ពិត ហើយបែរទៅរករឿងព្រេង និទាន ។
« តើខ្ញុំបានចំណេញពីអ្នកដោយអ្នក ណាម្នាក់ដែលខ្ញុំចាត់ឲ្យទៅអ្នកឬ ? »
គាត់មិនខ្វល់ពីអ្វីដែលសម្លៀក បំពាក់ស្ថិតនៅ ចន្លោះពួកគេបន្តិចឡើយ ។
ប្រធានបទ សម្រាប់ ព្រឹត្តិការណ៍ ឆ្នាំ នេះ គឺ " ពិភពលោក តែ មួយ ។
ដូច្នេះខ្ញុំនៅ តែមិន ស៊ាំនឹងការ ពិតដែលថាគេកំពុងតែទទួលស្គាល់ខ្ញុំម្តងទៀត។
ខ្ញុំ ចង់ឱ្យ នាង ចូល ក្រុម របស់ ខ្ញុំ ។
វា ហាក់បីដូចជា បំណងប្រាថ្នា និង ភាពអសន្តិសុខ ទាំងអស់ របស់ ខ្ញុំ កំពុង ប្រយុទ្ធ ជាមួយ គ្នា៖
ប៉ុន្តែ បើ គ្មាន ជំនឿ នោះ មិន អាច ផ្គាប់ ព្រះហឫទ័យ ទ្រង់ បាន ឡើយ ត្បិត អ្នក ដែល មក រក ព្រះជាម្ចាស់ ត្រូវតែ ជឿ ថា ទ្រង់ មាន ហើយ ថា ទ្រង់ ជា រង្វាន់ ដល់ អ្នក ដែល ស្វែងរក ទ្រង់ ដោយ ឧស្សាហ៍ ព្យាយាម ។ — ហេព្រើរ ១១:៦
« យើងប្រាកដថាវាស្ថិតនៅក្នុងតំបន់ដែលអាចរស់ នៅបាន ហើយប្រសិនបើវាមានផ្ទៃខាងក្រៅ វាគួរតែមានសីតុណ្ហភាពល្អ » ។
ថា ជីវិត របស់ អ្នក ពោរពេញ ទៅ ដោយ ការសរសើរ និង ការអរ ព្រះគុណ ។
២ រួចខ្ញុំសួរថា តើអ្នកទៅណា ?
វា គ្រាន់តែ មិន ឆ្លើយតប សូម្បីតែ នៅ ពេល ដំណើរការជា អ្នកគ្រប់គ្រង ក៏ដោយ ។
បាន និយាយ ថា ពួកគេ មកពី ធនាគារ ឥណទាន ។
ខ្ញុំ មិន ចង់ លើ អ្នកទេ ។
សេវា ពន្ធនាគារ របស់ នាង ។
ឬ តាម ឈ្មោះ គម្រោ ង៖ បញ្ចូល ឈ្មោះ គម្រោង ។
ខាងលើ ពន្យល់ ពី អត្ថន័យ នៃ ពាក្យសម្បថ និង ភាពខុសគ្នា របស់ វា ។
ស្ត្រីនៅសម័យនោះត្រូវគេរំពឹងថានឹងរៀបការ ដើម្បីតំណែង អំណាច និងទ្រព្យសម្បត្តិ ។
" អ្វី ដែល ខ្ញុំ ចង់បាន គឺ ជីវិត ក្នុង ក្តីស្រមៃ ជាមួយ មនុស្ស ដែល ខ្ញុំ ស្រលាញ់ "
បើមិនដូច្នេះទេ ខ្ញុំមិនអាចចេញពីកន្លែងនោះទេ ។
កម្លាំង ដែល ព្រះដ៏ វិសុទ្ធ ប្រទាន ពរ ដល់ ទ្រង់
ហើយខ្ញុំគិតថាវាអស្ចារ្យណាស់ដែលអក្សរសិល្ប៍ល្អបង្ហាញរឿងនេះ ។
តើនេះជាអ្នក ណាដែលខ្យល់និងសមុទ្រស្តាប់បង្គាប់ ?
« ខ្ញុំគ្មានអ្វីនៅផ្ទះខ្ញុំទាល់ តែសោះ ក្រៅពីប្រេងបន្តិច » ។
« ខ្ញុំប្រាប់អ្នក ជាប្រាកដថា ប្រសិនបើអ្នក រាល់គ្នាមិនបរិភោគសាច់របស់កូនមនុស្ស ហើយមិនពិសាឈាមរបស់លោកទេ នោះអ្នកគ្មានជីវិតឡើយ ។
ទីបំផុតគាត់ឃ្លាន ហើយខ្ញុំក៏ឲ្យគាត់ចាកចេញទៅ ។
បើគាត់មិនបានលើកឡើង គាត់កំពុង តែយំ ។
វា គ្រាន់តែ ជា បញ្ហា ប្រសិនបើ អ្នក កត់សម្គាល់ វា ។
ដូច្នេះដើម្បីកុំឲ្យមានអ្នក ណាមករំខានខ្លួនឯងក្នុងទុក្ខ វេទនាទាំងនេះ ដែលដូចជាអ្នកដឹងហើយថា យើងត្រូវបានកំណត់ ។
នេះ គឺជា ការវាយប្រហារ ចុងក្រោយ បំផុត នៃ ការវាយប្រហារ ជាច្រើន នៅក្នុង តំបន់ ដែល សហរដ្ឋ អាមេរិក បាន ចោទប្រកាន់ ទីក្រុង តេអេរ៉ង់ ថា បាន ធ្វើ ប៉ុន្តែ មិន ទាន់ បាន បែងចែក ភស្តុតាង ដែល គួរឱ្យ ស្អប់ខ្ពើម ណាមួយ ឡើយ ។
« ប៉ុន្តែ ប្រជាជននៅ ទីនោះមិនព្រមទទួលទ្រង់ទេ ព្រោះទ្រង់កំពុង តែធ្វើដំណើរទៅក្រុងយេរូសាឡិម ។
ដែល គាត់ កំពុង ស្វែងរក ការព្យាបាល ។
តាម មើល ទៅ អ្នកវិទ្យាសាស្ត្រ បាន ដឹង រឿង នេះ យូរ ហើយ ប៉ុន្តែ ខ្ញុំ មិន បាន យល់ ទេ ។
« បើឯងសុខ ចិត្តយកពែងនេះពីខ្ញុំ » ។
គាត់បានឆ្លើយ ថា៖ « ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា ប្រសិនបើប្រជាជនទាំងនេះនៅស្ងៀម នោះថ្មនឹងស្រែកឡើង » ។
ឬ តើ អ្នក ចង់ឱ្យ ខ្ញុំ ពិនិត្យមើល ផលិតផល ជាក់លាក់ មួយ ?
ខ្ញុំកំពុងតែគិតអំពី ក តើវានឹងប៉ះពាល់ដល់សម្លេងដែរឬទេ ?
អ្នក ឧកញ៉ា បាន ទទួល
« ហើយបើឯងសម្លាប់វា នោះឯងនឹងតាំងក្រុងទាស់នឹងយើង ។
18 ហើយបងប្អូនរបស់គាត់ក៏ទៅក្រាបនៅចំពោះមុខគាត់ ហើយនិយាយថា៖ « យើងខ្ញុំនៅ ទីនេះក្នុងនាមជាអ្នក បម្រើរបស់អ្នក » ។
ហើយគំនិតដែលស្ថិតក្នុង ចិត្តខ្ញុំជានិច្ចគឺ៖
ខ្ញុំក៏ស្ទើរ តែបង្កើតក្រុមក្នុងវ័យ ១៦ឆ្នាំផងដែរ ។
វា មាន អារម្មណ៍ ប៉ុន្តែ មិន បាន ឃើញ ។
មហាវិទ្យាល័យ មាន បរិវេណ ធំ ណាស់ ។
វាជាដោតដែលខ្ញុំប្រហែលមិនអាចប្រើបាន ។
ហើយ អ្នក បន្ត សង្រ្គាម លើ ស្ត្រី ជាមួយនឹង យោបល់ របស់ អ្នក ។
ការពន្យល់ ដោយ ប្រកាស ។
គាត់ បាន អង្វរ ដៃគូ របស់ គាត់ កុំ ឱ្យ បង្ខំ គាត់ ។
ជំនួយ របស់ អ្នក នឹង មិន ត្រូវបាន បំភ្លេច ឡើយ ។
នៅ តែនៅជាប់នឹងវា ហើយទាញ យកអាហារដែលគួរឲ្យស្អប់ពីវា បន្ទាប់ពីគាត់
ប៉ុន្តែប្រសិនបើមានអ្នកផ្សេង មកក្នុងនាមរបស់ខ្លួន អ្នកនឹងទទួល យកគាត់ ។
តើមនុស្សមួយចំនួនអាចមានទំនួលខុសត្រូវកម្រិតណា ?
« បញ្ញត្តិទាំងអស់របស់អ្នកគឺជាសេចក្ដី សុចរិត » ។
8 ក្នុងចំណោមអ្នកគ្រប់គ្រងពិភពលោកនេះ គ្មាននរណាម្នាក់មានចំណេះទេ ដ្បិតប្រសិនបើគេមាន នោះគេនឹងមិនដាក់ព្រះ‌ អម្ចាស់នៃសិរី ‌ ល្អនៅលើឈើឆ្កាងឡើយ ។
គាត់បាននិយាយម្តងហើយម្តងទៀតថាគាត់ចូល ចិត្តរូប កាយរបស់ខ្ញុំដូចជា ។
សរសេរ វា សម្រាប់ គ្រួសារ របស់ អ្នក ។
មួយ រយៈហើយដែលយើងមិនបានជួប ។
ជិតដល់ថ្ងៃត្រង់ ពេលគាត់ត្រឡប់មកវិញ គាត់មិនត្រឡប់មកវិញទេ
ខ្ញុំចង់បានដីរបស់ខ្ញុំ » ។
ពេលវេលា តែ មួយ គត់ ដែល គាត់ អាច គេង បាន ហាក់ដូចជា
អ្នក ដាក់វាតាម វិធី នេះ៖ « នៅឃ្លានហើយនៅល្ងង់ » ។
អិមម៉ា បូនី ណូ៖ អាណត្តិ ទី៦
(v33) « ពេលនោះ អ្នកដែលនៅក្នុងទូកបាន មកថ្វាយបង្គំទ្រង់ ដោយពោលថា ទ្រង់ពិតជាព្រះរាជ បុត្រានៃព្រះ» ។
តើអ្នកដឹងទេថាខ្ញុំដឹងថានាងមិនបានរស់នៅ ទីនេះរយៈពេលប្រាំឆ្នាំ មកហើយឬ ?
ខ្ញុំ ចង់ឱ្យ អ្នក ជួប អ្នកគាំទ្រ នៅ កូរ៉េ ។
" ខ្ញុំ មាន កូនប្រុស បី នាក់ ដូច្នេះ ពួកគេ ពឹងផ្អែក លើ ខ្ញុំ ។
២៧ រួចគាត់មាន ប្រសាសន៍ទៅថូ ម៉ាសថា ( ក) ចូរដាក់ម្រាមដៃរបស់អ្នកនៅ ទីនេះ ហើយមើលដៃខ្ញុំ ហើយដកដៃចេញ ហើយដាក់នៅខាងខ្ញុំ ។
ហើយអ្នក ជាកូនស្រីរបស់សារ៉ា ប្រសិនបើអ្នកធ្វើអ្វីដែលត្រឹមត្រូវ ហើយមិនរស់នៅដោយ ភាព ភ័យខ្លាច ។
ពួកគេគឺជាមនុស្សស្លាប់ ហើយពួកគេត្រូវការ បំផ្លាញ » ។
នាង បាន ទៅ ទីនោះ ដើម្បី បង្រៀន ក្មេង ៗ ។
២៣ ពេលម៉ូសេ មានអាយុសែសិបឆ្នាំ គាត់បានសម្រេច ចិត្តទៅសួរសុខទុក្ខប្រជារាស្ត្ររបស់គាត់ គឺជន ជាតិអ៊ីស្រាអែល ។
ការអនុលោម តាម ច្បាប់ និង បទប្បញ្ញត្តិ ជាធរមាន ដែល គ្រប់គ្រង ការផ្សព្វផ្សាយ និង រង្វាន់ ទាំងអស់ ដែល បាន ផ្តល់ ជូន ( ឧទាហរណ៍៖ ការចុះឈ្មោះ និង ការទទួលបាន ការយល់ព្រម ពី ច្បាប់ ចាំបាច់ )
គាត់បាននិយាយថា៖ « មានផ្សាភ្ជាប់ជាច្រើនដែលលិចចូលច្រាំងនៅ ទីនេះ ។
អង្វរ ឱ្យ ពួកគេ ប្រែចិត្ត ហើយ បាន សង្រ្គោះ ។
ប៉ុន្តែមុននឹងខ្ញុំធ្វើ ខ្ញុំត្រូវព្រមានអ្នក។
បន្ទាប់មក លេង ជុំវិញ ជាមួយនឹង ការដាក់ រាង ។
ក្រុមហ៊ុន ហុងកុង តាមពិតជា អ្នក ផ្សព្វផ្សាយ !
កម្ពុជាបានបង្ហាញការ តែងតាំងខ្លួនសម្រាប់ពាន រង្វាន់ដ៏គួរឲ្យចង់បានក្រោមប្រធាន បទ " កម្ពុជា៖ ទឹកដីនៃវេទមន្ត ទីកន្លែងដែលព្រះ និងស្តេចបានសាងពិភពលោក !"
ដូច្នេះ វាគឺជាការ ចាប់ផ្តើ ម ហើយវានឹងមានម្តងទៀត។
ខ្ញុំមិនចង់ឈប់ព្យាយាមទេ ដូច្នេះពេលខ្ញុំ មកដល់ផ្ទះ ខ្ញុំចាប់ផ្ដើម រកជម្រើស ។
ដើម្បី ជំនួស ទ្វារ ដែល នៅ ទីនោះ ។
