( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឱ្យដឹង ថា នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៣លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១០នាក់ របួស ធ្ងន់ ១៤នាក់ និង របួស ស្រាល ៣នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា ក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១៣លើក នេះ បណ្ដាលឱ្យ ខូត ខាត ម៉ូតូ ចំនួន ១៦ គ្រឿង . រថយន្ដ ធុន តូច ៦គ្រឿង . រថយន្ដ ធុន ធំ២ គ្រឿង អ្នក ថ្មើរជើង ២នាក់ ហើយ មូលហេតុ ដែល បណ្ដាលឱ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ និង ស្រវឹង ។
សូម បញ្ជាក់ ថា រយៈពេល ០៧ ថ្ងៃ ចាប់ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ៧៣ លើក បណ្ដាលឱ្យ មនុស្ស សា្លប់ ៤៤ នាក់ . របួស ធ្ងន់ ៦៦ នាក់ និង របួស ស្រាល ២៨ នាក់ ៕ មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង ចេញ លិខិត ឲ្យ គ្លីនិក ឯកជន មួយ មក បង់ប្រាក់ ពិន័យ និង បញ្ឈប់ ការផ្តល់ សេវា សិន រហូតដល់ មាន ការអនុញ្ញាត ច្បាប់ ពី ក្រសួង សុខាភិបាល
( ស្វាយរៀង ) ៖ លោក កែរ រដ្ឋា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង ថា កាលពី ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៨ មន្ទីរ សុខាភិបាល ខេត្ត ស្វាយរៀង បាន ចេញ លិខិត អញ្ជើញ មួយ ទៀត ដើម្បីឲ្យ ម្ចាស់ សេវា ខុស ច្បាប់ មួយ កន្លែង ឈ្មោះ មន្ទីរ សម្រាក ព្យាបាល សោភ័ណ អូវ៉ាង មក បង់ប្រាក់ ពិន័យ និង ទទួល ការណែនាំ ជា លើក ចុងក្រោយ ក្នុង ការស្នើសុំ ច្បាប់ បើក សេវា ឯកជន មួយ នេះ ទៅ ក្រសួង សុខាភិបាល និង បញ្ឈប់ ការផ្តល់ សេវា សិន រហូតដល់ មាន ការអនុញ្ញាត ច្បាប់ ពី ក្រសួង សុខាភិបាល ។
លោក វេជ្ជបណ្ឌិត កែរ រដ្ឋា បាន ប្តេជ្ញាចិត្ត ថា លោក នឹង លុបបំបាត់ ឱ្យ អស់ សេវា ឯកជន ខុស ច្បាប់ នៅក្នុង ខេត្ត ស្វាយរៀង ។ លោក ថា ដើម្បី លុបបំបាត់ សេវា សុខាភិបាល ខុស ច្បាប់ នេះ ឱ្យ មាន ប្រសិទ្ធភាព ត្រូវតែ មាន ការចូលរួម សហការ ពី ព្រះរាជអាជ្ញា អាជ្ញាធរ ខេត្ត សមត្ថកិច្ច មូលដ្ឋាន និង ភាគី ពាក់ព័ន្ធ ដោយ អនុវត្ត តាម គោលការណ៍ ច្បាប់ ជា ធំ ។
រដ្ឋមន្ត្រី ការបរទេស អាមេរិក៖ ទស្សនកិច្ច នៅ កូរ៉េ ខាងជើង បញ្ចប់ ទៅ ដោយ ផ្លែផ្កា ខណៈ ជំនួប ត្រាំ - គីម លើក ទី ពីរ នឹង កើតឡើង ឆាប់ ៗ !
គួរ បញ្ជាក់ ថា ការបំពេញ ទស្សនកិច្ច របស់ លោក Pompeo ទៅ កូរ៉េ ខាងជើង គឺជា លើក ទី បី ហើយ ដោយ ស្ថិត នៅក្នុង ន័យ ផ្សាភ្ជាប់ ទំនាក់ទំនង ជាមួយ កូរ៉េ ខាងជើង ឲ្យ កាន់តែ ប្រសើរ និង ជា ការត្រៀម រៀបចំ ជំនួប លើក ទី ពីរ រវាង លោក ដូណាល់ ត្រាំ ប្រធានាធិបតី អាមេរិក និង លោក គីម ជុង អ៊ុន ប្រមុខ ដឹកនាំ កំពូល កូរ៉េ ខាងជើង ដែល នឹង កើតឡើង នា ពេល ឆាប់ ៗ ខាងមុខ ផងដែរ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
ការ ដែល គណៈកម្មការ អឺរ៉ុប សម្រេច បន្ត នីតិវិធី ដក ការអនុគ្រោះ ពន្ធ សម្រាប់ ទំនិញ របស់ កម្ពុជា ដោយ ពួកគេ សំអាង លើ ហេតុផល ថា រាជ រដ្ឋាភិបាល កម្ពុជា បច្ចុប្បន្ន កំពុង រំលោភ លើ សិទ្ធិ មនុស្ស ។ ត្រង់ ចំណុច នេះ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ប្រធានបទ សិទ្ធិ មនុស្ស និង ប្រជាធិបតេយ្យ វា ពេញនិយម សម្រាប់ ការជ្រៀត ជ្រែក របស់ ប្រទេស ធំ ប្រទេស មាន លុយ ទៅ លើ ប្រទេស ក្រីក្រ តែ ប៉ុណ្ណោះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ចោទសួរ ទៅ វិញ ថា បញ្ហា នៅ លីប៊ី នៅ អ៉ីរ៉ាក់ នៅ យ៉េមែន ក៏ ដូចជា អតីតកាល របស់ កម្ពុជា ដែល មាន ការសម្លាប់ រង្គាល តើ ឯណា ទៅ បញ្ហា សិទ្ធិ មនុស្ស និង ប្រជាធិបតេយ្យ នោះ ? សម្តេច តេជោ បាន គូសបញ្ជាក់ ថា ចំណាត់ របស់ កម្ពុជា លើ ក្រុម អតីត បក្ស ប្រឆាំង គ្រាន់តែ ជា វិធានការ ច្បាប់ ដើម្បី ទប់ស្កាត់ ទង្វើ ទុច្ចរិត និង រក្សា បាន នូវ សុខ សន្តិភាព ព្រមទាំង ការរស់រៀន របស់ កម្ពុជា ប៉ុណ្ណោះ ។
សម្តេច នាយក រដ្ឋមន្ត្រី បាន អះអាង ថា បើ អឺរ៉ុប តម្រូវឲ្យ កម្ពុជា បង់ ពន្ធ គឺ កម្ពុជា នឹង បង់ ដោយ មិន ឱន ក្បាល ចំពោះ ការគំរាម របស់ ពួកគេ នោះ ឡើយ ហើយ កម្ពុជា នឹង ប្រឹង រស់ ដោយ ខ្លួន ឯង ។ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ « ចង់ឲ្យ បង់ ពន្ធ បង់ ពន្ធ ។ សូម ផ្តាំ ឱន ក្បាល ម្តង ត្រូវ ជំពាក់ ឱន ពីរ ដង ជំពាក់ ពីរ ដង ឱន ជំពាក់ បី ដង ឱន ឱន មួយ ជីវិត ខ្មែរ អត់ ឯករាជ្យ បាន ទេ ។ ប្រឹង រស់ ងើប ឈរ ឡើង ដើម្បី ការពារ ឯករាជ្យ អធិបតេយ្យ របស់ ប្រទេស ដើម្បី ការពារ សន្តិភាព របស់ ប្រទេស » ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការអភិវឌ្ឍ តំបន់ ត្រីកោណ ជា គំនិត ផ្តួចផ្តើម ដោយ ផ្ទាល់ របស់ សម្តេច ដោយសារ សម្តេច ឃើញ ខេត្ត កម្ពុជា ចំនួន ៤ជា ខេត្ត ក្រីក្រ និង ខេត្ត របស់ វៀតណាម ឡាវ ក៏ ក្រីក្រ គឺ មិន គំនិត ណាមួយ ក្នុង ការកាត់ ទឹកដី ឲ្យ វៀតណាម នោះ ទេ ។
* សម្តេច តេជោ បាន ថ្លែង ថា ដើម្បី ធ្វើដំណើរ ទៅដល់ តំបន់ មួយចំនួន ក្នុង ខេត្ត រតនគិរី ត្រូវ ខ្ចី ដី របស់ វៀតណាម ដើរ នោះ ទេ ព្រោះ ខេត្ត យើង អត់ ទាន់ មាន ផ្លូវ ។ ដូច្នេះ គំនិត អភិវឌ្ឍន៍ តំបន់ ត្រីកោណ គឺ មាន គោលដៅ អភិវឌ្ឍន៍ ខេត្ត ក្រីក្រ ទាំង៤ របស់ កម្ពុជា ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន អះអាង ថា រដ្ឋាភិបាល ជប៉ុន បាន គាំទ្រ ការអភិវឌ្ឍ នេះ តំបន់ ត្រីកោណ នេះ ហើយ គម្រោង នេះ ហើយ ជា ការផ្តួចផ្តើម ឲ្យ មាន កិច្ចសហប្រតិបត្តិការ មេគង្គ - ជប៉ុន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កិច្ចសហប្រតិបត្តិការ មេគង្គ - ជប៉ុន គឺជា កិច្ចសហប្រតិបត្តិការ មួយ ក្នុង ការកាត់បន្ថយ គម្លាត អភិវឌ្ឍន៍ របស់ ប្រទេស សមាជិក អាស៊ាន ថ្មី និង ចាស់ ។
* សម្តេច តេជោ បាន ថ្លែង ថា ថៅកែ រថយន្ត ដឹកជញ្ជូន និយាយ ស្តាប់ គ្នា មិន បាន តែងតែ ដំឡើង ថ្លៃ រាល់ ពេល បុណ្យ ទាន ធំ ៗ ។ សម្តេច តេជោ ថា បើ ថៅកែ រថយន្ត នៅតែ ដំឡើង ថ្លៃ ទៀត ពិធី បុណ្យ ក្រោយ ៗ ទៀត នឹង ទិញ រថយន្ត បន្ថែម ដាក់ពង្រាយ ពេញ ផ្លូវ តែម្តង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ឆ្នាំ នេះ កម្ពុជា ជួប គ្រោះមហន្តរាយ តែ មិន ធ្ងន់ធ្ងរ ដូច ប្រទេស ដទៃ នោះ ទេ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ក្រុម អ្នក ដែល តែងតែ រិះគន់ រឿង ទឹក លិច ផ្លូវ ក្នុង រាជធានី ភ្នំពេញ ពេល មាន ភ្លៀង ធ្លាក់ ជា មនុស្ស ខូច ។ សម្តេច តេជោ ថា ការលិច ក្រុង នេះ មិន មែន មាន តែ កម្ពុជា ទេ សូម្បីតែ ជប៉ុន ក៏ ជួប ការលិចលង់ ដែរ ព្រោះ ជា គ្រោះ ធម្មជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា ពេល សម្តេច ផ្តួចផ្តើម ឡើង គ្មាន ភាគី ខ្មែរ ណា ឯកភាព នោះ ទេ តែ ក្រោយមក សម្តេច លួច ធ្វើការ ជាមួយ មន្រ្តី ជាន់ ខ្ពស់ របស់ ថៃ ទើប ឈាន ទៅ បង្កើត ស្ថាប័ន នេះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ត្រូវការពេល១ ពាន់ យប់ ទើប អាច និយាយ រៀបរាប់ ពី ដំណើរ ដ៏ ជូរចត់ របស់ កម្ពុជា ពី អតីតកាល ចប់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច បាន ជួប ពិភាក្សា ជាមួយ ទីប្រឹក្សា របស់ នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក ស៊ីន ហ្ស៊ូ អាបេ លើ បញ្ហា អន្តរជាតិ រាប់ ទាំង សង្គ្រាម ពាណិជ្ជកម្ម ផងដែរ ។
* សម្តេច តេជោ ថ្លែង ថា កម្ពុជា ដើរ ក្រោយ គេ ដូច្នេះ ត្រូវ គិតគូរ ឲ្យបាន ម៉ត់ចត់ និង ល្អិតល្អន់ បំផុត កុំ ឲ្យ ប្រទេស ធ្លាក់ ក្នុង អន្លង់ ភ្លើង សង្គ្រាម ដូច អតីតកាល ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា សម្តេច អត់ ខ្លាច នឹង កម្ចាត់ មនុស្ស ពីរ បី នាក់ ដើម្បី សេចក្តីសុខ របស់ ប្រជាពលរដ្ឋ មួយ ប្រទេស នោះ ទេ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្លាប់ មនុស្ស រាប់ លាន នាក់ ម្តេច មិន និយាយ រឿង សិទ្ធិ មនុស្ស ចុះ សម្តេច កម្ចាត់ មនុស្ស ពីរ បី នាក់ ដើម្បី ការពារ ជីវិត មនុស្ស មួយ ប្រទេស ហេតុ អ្វី ធ្វើ មិន បាន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កុំ យក អធិបតេយ្យភាព ជាតិ និង សុខ សន្តិភាព របស់ កម្ពុជា ទៅ ប្តូរ ជាមួយ ជំនួយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កម្ពុជា នៅ មាន លទ្ធភាព ខ្ចី បរទេស បាន ច្រើន ទៀត តែ សម្តេច មិន ឯកភាព ឲ្យ ខ្ចី បរទេស លើស ផែនការ នោះ ឡើយ ហើយ ត្រូវ ប្រឹង សន្សំ ប្រាក់ ខ្លួន ឯង សម្រាប់ តម្រូវការ របស់ ខ្លួន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ក្រុមហ៊ុន ជប៉ុន កាន់តែ ច្រើន បាន មក វិនិយោគ នៅក្នុង ប្រទេស កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច មិន ដែល មាន បំណង ធ្វើជា នាយក រដ្ឋមន្ត្រី នោះ ទេ តែ ពេលនេះ ធ្វើ រហូត យូរ ជាង គេ ។ សម្តេច ថា សម្តេច នឹង ធ្វើ រហូតដល់ ក្រុម ប៉ុនប៉ង បំផ្លាញ កម្ពុជា ត្រូវ វិនាស ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តាំ ដល់ និស្សិត កំពុង សិក្សា នៅ ជប៉ុន ថា ជប៉ុន ជា ប្រទេស មាន ការអប់រំ ខ្ពស់ ដូច្នេះ ត្រូវ ប្រឹងប្រែង រៀនសូត្រ ហើយ ពលរដ្ឋ ទៅ រស់ នៅ ជប៉ុន ក៏ ត្រូវ ជំរុញ ឲ្យបាន រៀនសូត្រ ខ្ពស់ ផងដែរ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី ថា រាជ រដ្ឋាភិបាល ខិតខំ ណាស់ ក្នុង ការបណ្តុះបណ្តាល ធនធាន មនុស្ស ទាំង ក្នុង ប្រទេស ហើយក៏ ខិតខំ សុំ អាហារូបករណ៍ ក្រៅ ប្រទេស បន្ថែម ទៀត ។ សម្តេច តេជោ បាន ថ្លែង ថា បច្ចុប្បន្ន កម្ពុជា មិន ទាន់ អាច ផ្គត់ផ្គង់ ធនធាន មនុស្ស គ្រប់គ្រាន់ ឆ្លើយតប តម្រូវការវិនិយោគ នៅឡើយ ទេ ។
* សម្តេច តេជោ បាន ថ្លែង ថា ដើម្បី ដំឡើង ប្រាក់ ឈ្នួល ទាប បំផុត របស់ កម្មករ បាន ដល់ ១៨២ ដុល្លារ នៅ ឆ្នាំ ២០១៩ តម្រូវឲ្យ មាន ការបញ្ចុះ ថ្លៃ អគ្គិសនី សម្រាប់ រោងចក្រ ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ស្នើឲ្យ និស្សិត និង ពលរដ្ឋ កម្ពុជា នៅ ជប៉ុន ត្រូវ ប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ ចំពោះ ព័ត៌មាន ក្លែងក្លាយ នានា ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន យក សៀវភៅ ច្បាប់ អប់រំ ទូន្មាន ក្រុម ង៉ុយ និង អ៊ូ ចុង ទៅ ចែកជូន និស្សិត និង ប្រជាពលរដ្ឋ នៅ ជប៉ុន ផងដែរ ។ សម្តេច តេជោ ក៏ បាន ឧបត្ថម្ភ និស្សិត នៅ ជប៉ុន ម្នាក់ ៗ ៥០០ ដុល្លារ ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ដល់ ពលរដ្ឋ នៅ ជប៉ុន ដែល បាន ចូលរួម រក្សា ដំណើរ លទ្ធិ ប្រជាធិបតេយ្យ តាមរយៈ ការអំពាវនាវ ឲ្យ ពលរដ្ឋ ក្នុង ស្រុក ទៅ បោះឆ្នោត កាលពី ថ្ងៃទី ២៩ ខែកក្កដា កន្លងទៅ ។
* សម្តេច តេជោ បាន ថ្លែង ថា សម្តេច បាន ធ្វើឲ្យ ឯកភាព ជាតិ ទាំងមូល នៅ ចុង ឆ្នាំ ១៩៩៨ តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ ដែល មិន ធ្លាប់ មាន ក្នុង ប្រវត្តិសាស្ត្រ ខ្មែរ រយៈពេល យ៉ាងតិច ប្រមាណ ៥០០ ឆ្នាំ ។ សម្តេច តេជោ ថា ចង់ នរណា ថា សម្តេច ជា មនុស្ស យ៉ាងម៉េច ក៏ ថា ទៅ សំខាន់ សម្តេច មាន ជំហរ ច្បាស់លាស់ សម្រាប់ ជាតិ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ថ្លែង ថា អ្នកនយោបាយ ស្មោក គ្រោក អត់ ហ៊ាន ស្បថ ទេ ព្រោះ ពួកគេ ធ្វើ ខុស ហើយ ខ្លាច ស្លាប់ ។
* សម្តេច តេជោ ហ៊ុន សែន ប្រទេស ដែល ធ្វើ បដិវត្តន៍ បាន ព្រោះ គេ ធ្វើអព្យាក្រឹត កងទ័ព . តែ សម្រាប់ កម្ពុជា កងទ័ព អព្យាក្រឹត សម្រាប់ បក្ស នយោបាយ ប៉ុន្តែ មិន មែន អព្យាក្រឹត ជាមួយ រាជ រដ្ឋាភិបាល នោះ ទេ ពោល ត្រូវ ការពារ រាជ រដ្ឋាភិបាល ។
* សម្តេច តេជោ ហ៊ុន សែន បញ្ចប់ កិច្ច សំណេះសំណាល នៅ វេលា ម៉ោង ១៧៖ ២០ នាទី ម៉ោង នៅក្នុង ប្រទេស កម្ពុជា ត្រូវ នឹង ១៩៖ ២០ នាទី ម៉ោង នៅ ទីក្រុង តូក្យូ ប្រទេស ជប៉ុន ៕ រដ្ឋមន្ត្រី វង សូត ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ជាង ៦៧៥ គ្រួសារ និង ចូលរួម ពិធីកាន់ បិណ្ឌ នៅ វត្ត ជោតិ វ័ន្ត ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង
( ព្រៃវែង ) ៖ លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទា និង លោកស្រី នៅ ព្រឹក ថ្ងៃ ០៧ ខែតុលា ឆ្នាំ ២០១៨ បាន អញ្ជើញ សំណេះសំណាល់ នឹង ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ប្រមាណ ជាង ៦៧៥ គ្រួសារ នឹង ចូលរួម ពិធីកាន់ បិណ្ឌ វេន ទី ១៣ នៅ វត្ត ជោតិ វ័ន្ត ( វត្ត ជាច ) ស្ថិត នៅ ឃុំ ជា ច ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង ។
នា ឱកាស នោះ រដ្ឋមន្ត្រី វង សូត បាន នាំយក អំណោមក ចែកជូន ប្រជាពលរដ្ឋ ក្រីក្រ និង គ្រួសារ ងាយ រងគ្រោះ ចំនួន ៦៧៥ គ្រួសារ ក្នុង នោះ ១គ្រួសារ ៗ ទទួលបាន ៖ អង្ករ ២៥គី ឡួ មី១កេះ ទឹង ស៊ីអ៊ីវ ១យួ អំបិល អ៊ីយ៉ុត១ គីឡូក្រាម មុង១ ភួយ១ កន្ទេល១ ថវិការ ចំនួន ៥ម៉ុន រៀល ។
ថ្លែង ក្នុង ឱកាស អញ្ជើញ ចូលរួម ពិធីកាន់ បិណ្ឌ នេះ លោក វង សូត បាន លើកឡើង ថា រដូវ ភ្ជុំ បិណ្ឌ ជា ប្រពៃណី ជាតិ ខ្មែរ ដែល ប្រជាពលរដ្ឋ កម្ពុជា តែងតែ ប្រារព្ធ ឡើង ជារៀងរាល់ ឆ្នាំ ដើម្បី ឧទ្ទីស កុសល ជូន ជីដូន ជីតា ដែល បាន ចែក ឋាន ទៅ ស្រប ពេល ដែល ប្រទេសជាតិ មាន សុខ សន្តិភាព និង n មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ក្រោម ដឹកនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក បាន បន្ត ថា វិស័យ ព្រះពុទ្ធ សាសនា ជា សាសនា របស់ រដ្ឋ និង បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការអប់រំ ប្រៀន ប្រដៅ បរិស័ទ ឱ្យ ចេះ ស្រឡាញ់ គ្នា ប្រព្រឹត្ត តែ អំពើ ល្អ និង រស់ នៅ ជាមួយគ្នា ដោយ សុខ សន្តិភាព ។
ក្នុង ឪកាស នោះ លោក រដ្ឋមន្ត្រី និង លោកស្រី ក៏ បាន នាំយក បច្ច័យ ចំនួន រួម ជាមួយ ទេយ្យ វត្ថុ គ្រឿង ឧបភោគ បរិភោគ ភេសជ្ជៈ ផ្លែ ឈើ ជាច្រើន មុខ ប្រគេន ដល់ ព្រះសង្ឃ រាប់ បាត បង្សុកូល ឧទ្ទិស ផល្លា អានិសង្ឃ ជូន ដល់ វិញ្ញាណក្ខន្ធ បុព្វការី ជន និង វិញ្ញាណក្ខន្ធ ឥស្សរជន វីរៈ យុទ្ធជន ដែល បាន លះបង់ ជីវិត ដើម្បី បុព្វហេតុ រំដោះ ជាតិ មាតុភូមិ ៕
រាជ រដ្ឋាភិបាល ផ្តល់ ស្រូវ ពូជ ជាង ២០០តោន ជូន ប្រជាកសិករ ៤ស្រុក នៅ ខេត្ត ក្រចេះ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់
( ក្រចេះ ) ៖ លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ នៅ ព្រឹក ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ បាន ដឹកនាំ មន្ត្រី និង មន្ទីរ ពាក់ព័ន្ធ នាំយក ស្រូវ ពូជ ជាង ២០០តោន និង គ្រាប់ ពូជ ដំណាំ មួយចំនួន ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រមុខ ដឹកនាំ រាជ រដ្ឋាភិបាល និង ជា នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បន្ត ចែកជូន ដល់ ប្រជាកសិករ ចំនួន ៤ស្រុក / ក្រុង ដែល រងគ្រោះ ខូចខាត ផល ដំណាំ ដោយសារ ទឹក ជំនន់ ទន្លេ មេគង្គ នា ពេល កន្លងមក ។
លោក អភិបាល ខេត្ត បាន ឲ្យដឹង ថា ការចែក ពូជ ស្រូវ ជូន ប្រជាកសិការ ចំនួន ៤ស្រុក ថ្ងៃ នេះ រួម មាន៖ ស្រុក សំបូរ . ស្រុក ឆ្លូង . ស្រុក ព្រែក ប្រសព្វ . និង ក្រុង ក្រចេះ ។ លោក បន្ត ថា ស្ថានភាព ទឹក ជំនន់ ទន្លេរ មេគង្គ កន្លងមក នេះ ធ្វើឲ្យ ខេត្ត ក្រចេះ រង ផល ប៉ះពាល់ និង ខូចខាត ទៅ លើ វីស័យ កសិកម្ម ហេដ្ឋារចនាសម្ព័ន្ធ និង សង្គមកិច្ច ជាច្រើន ហើយ ក្នុង អំឡុង ពេល ទឹក ជំនន់ ប្រជាពលរដ្ឋ រងគ្រោះ ក៏ បាន ទទួល អំណោយ ជា ស្បៀងអាហារ និង សម្ភារ ប្រើប្រាស់ ផ្សេង ៗ ទៀត ផងដែរ ។
លោក វ៉ា ថន បាន នាំ សារ សួរសុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន ដែល ជានិច្ចកាល សម្ដេច តែងតែ យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ បងប្អូន ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ទីទ័ល ក្រ មាន ជំងឺ ជន ងាយ រងគ្រោះ និង ជនរងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ផ្សេង ៗ និង ចូល ស្ដោក ស្ដាយ ដល់ ជនរងគ្រោះ ដោយសារ ទឹក ជំនន់ ដែល បង្ក ខូចខាត ដល់ ផល ដំណាំ និង ទ្រព សម្បត្តិ កន្លងមក ។
លោក អភិបាល ខេត្ត ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ដោះស្រាយ បន្ទាន់ ភ្លាម ៗ ចំពោះ ពូជ ស្រូវ សម្រាប់ ចែកជូន ប្រជាកសិករ តាមរយៈ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ចំនួន ៣០០តោន ។ ហើយ អាជ្ញាធរ ខេត្ត ក្រចេះ នឹង បន្ត ផ្ដល់ជូន ដល់ ប្រជាពលរដ្ឋ នៅ តាម បណ្តា ស្រុក ផ្សេង ទៀត ដែល ទទួលរង ផល ខូចខាត ដូចគ្នា ។
របាយការណ៍ ដែល អង្គការ ភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន បង្ហាញ ថា នៅ ថ្ងៃទី ០៦ ខែតុលា ដែល ជា ថ្ងៃ ដំបូង នៃ ការចាប់ផ្តើម ដឹកជញ្ជូន ប្រជាពលរដ្ឋ សាលា រាជធានី ភ្នំពេញ បាន បញ្ចេញ រថយន្ត ចំនួន ៨៧ គ្រឿង សម្រាប់ ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ដោយ មាន ប្រជាពលរដ្ឋ ជិះ សរុប ៣២០០ នាក់ ។ សម្រាប់ ថ្ងៃទី ០៧ ខែតុលា វិញ សាលា រាជធានី ភ្នំពេញ បាន បញ្ចេញ រថយន្ត ចំនួន ១០១ គ្រឿង ដោយ ដឹក ប្រជាពលរដ្ឋ សរុប ប្រមាណ ៤.៣៣៧ នាក់ ។
ដើម្បី ជួយ កាត់បន្ថយ ការចំណាយ របស់ ប្រជាពលរដ្ឋ ពេល ទៅ លេង ស្រុក កំណើត ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បញ្ជា ឲ្យ សាលា រាជធានី ភ្នំពេញ បញ្ចេញ រថយន្តក្រុង ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ទៅ ស្រុក កំណើត ដោយ មិន គិត ថ្លៃ ។ សាលា រាជធានី ភ្នំពេញ បាន ចាត់ចែង រថយន្ត រហូតដល់ទៅ ១២០ គ្រឿង ពង្រាយ នៅ តាម គោលដៅ នានា ក្នុង រាជធានី ភ្នំពេញ ដើម្បី ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ទៅ តាម បណ្តា ខេត្ត នៅ ជាប់ ផ្លូវ ជាតិ ទាំងអស់ ចាប់ពី ថ្ងៃទី ០៦ រហូតដល់ ថ្ងៃទី ១១ ខែតុលា ។
តាមរយៈ រថយន្តក្រុង របស់ សាលា រាជធានី ភ្នំពេញ នេះ គេ បាន សង្កេតឃើញ ថា មាន ប្រជាពលរដ្ឋ ជាច្រើន បាន ស្កាត់ មក ជិះ រថយន្ត ទាំងនេះ ទៅ លេង ស្រុក កំណើត របស់ ពួកគេ ។ ការស្កាត់ មក ប្រើប្រាស់ រថយន្ត នេះ ព្រោះ វា បាន ជួយ ឲ្យ ពួកគាត់ កាត់បន្ថយ ការចំណាយ ថ្លៃ សំបុត្រ រថយន្ត បាន យ៉ាង ច្រើន សម្រាប់ យក ទៅ ចំណាយ ផ្សេង ៗ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។
ប្រជាពលរដ្ឋ ដែល នៅ ខេត្ត ឆ្ងាយ ៗ ដូចជា បាត់ដំបង និង បន្ទាយមានជ័យ ជាដើម ពួកគេ ត្រូវ ចំណាយ ថ្លៃ សំបុត្រ រថយន្ត យ៉ាងតិច ៣ម៉ឺន ទៅ ៥ម៉ឺន រៀល សម្រាប់ ម្នាក់ ហើយ បើ គេ មាន គ្នា ៣ទៅ ៤នាក់ គឺ ត្រូវ ចំណាយ រហូតដល់ទៅ ជាង ១០ម៉ឺន រៀល ។ ដូច្នេះ ការបញ្ចេញ រថយន្ត របស់ សាលា រាជធានី ភ្នំពេញ ដឹកជញ្ជូន ពួកគេ ទៅកាន់ ស្រុក កំណើត បាន ជួយ សន្សំ លុយ ពួកគេ យ៉ាង ច្រើន ផងដែរ ។
ប្រជាពលរដ្ឋ ដែល មក ប្រើប្រាស់ រថយន្ត សាលា រាជធានី ភ្នំពេញ ទៅកាន់ ស្រុក កំណើត សុទ្ធតែ បាន បង្ហាញ ភាពសប្បាយរីករាយ និង បាន ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ចំពោះ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ផ្តួចផ្តើម កម្មវិធី ដឹកជញ្ជូន មិន គិត ថ្លៃ នេះ ឡើង ។ ប្រជាពលរដ្ឋ បាន ចាត់ទុក កាយវិការ នេះ ជា ការយកចិត្តទុកដាក់ ខ្ពស់ មួយ លើ ជីវភាព របស់ ប្រជាពលរដ្ឋ ពីសំណាក់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ជាមួយគ្នា នោះ លោក ប្រធាន មន្ទីរ ក៏ បាន ចុះ ណែនាំ ដល់ គណៈ គ្រប់គ្រង វត្ត ទាំងមូល រួម ជាមួយ អាជីវករ ដែល លក់ដូរ នៅក្នុង វត្ត ត្រឡែង កែង ឱ្យ យកចិត្តទុកដាក់ ចំពោះ បញ្ហា សំរាម កាក់ សំណល់ ផ្សេង ៗ ផងដែរ ។
បើ តាម លោក សេង សាលី ក្រៅពី រមណីយដ្ឋាន វត្ត ត្រឡែង កែង ខេត្ត កំពង់ឆ្នាំ ក៏ មាន តំបន់ ទេសចរណ៍ ជាច្រើន ទៀត ផងដែរ ៕
គួរ រំលឹក ថា ភាពឈឺចាប់ បំផុត នៃ មហន្តរាយ បង្កឡើង ដោយ គ្រោះ រញ្ជួយ ដី កម្រិត ធ្ងន់ នៅ ហៃ ទី កាលពី ឆ្នាំ ២០១០ នោះ គឺ បាន កើត មាន ឡើង លើ រដ្ឋធានី ព័រ អូព្រីន តែ ម្តង ដោយ បាន សម្លាប់ មនុស្ស ជិត ២៣០.០០០ នាក់ និង ទីក្រុង ស្ទើរ ទាំងមូល រង ការបំផ្លិចបំផ្លាញ ដែល មិន ធ្លាប់ មាន ក្នុង រយៈពេល ២០០ ឆ្នាំ ចុងក្រោយ នេះ ៕
សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ទស្សនា កំពង់ផែ អន្តរជាតិ យូកូហា ម៉ា
( ជប៉ុន ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង គណៈប្រតិភូ ក្នុង ពេល បំពេញ ទស្សនកិច្ច នៅក្នុង ប្រទេស ជប៉ុន នៅ ព្រឹក ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ ត្រូវបាន អញ្ជើញ ទស្សនា កំពង់ផែ អន្តរជាតិ យូកូហាម៉ា ក្នុង ទីក្រុង យូកូហាម៉ា ខេត្ត កាណាហ្កាវ៉ា ដែល ជា កំពង់ផែន ក្នុង តឺន័រ ទឹក ជ្រៅ មួយ របស់ ប្រទេស ជប៉ុន ។ ក្នុង កិច្ចសហប្រតិបត្តិការ ជាមួយ កម្ពុជា ប្រទេស ជប៉ុន កំពុង ចូលរួម ជួយ រៀបចំ ការ អភិវឌ្ឍ កំពង់ផែ ស្វយ័ត ព្រះសីហនុ តាមរយៈ ការរៀបចំ ប្រព័ន្ធ គយ និង ហេដ្ឋារចនាស ម្ប័ន្ធ ដទៃ ទៀត ។
ក្នុង ដំណើរទស្សនកិច្ច កំពង់ផែ យូកូហាម៉ា សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បាន តាមដាន យ៉ាង យកចិត្តទុកដាក់ ពី ការ ឧទ្ទេសនាម ពី ខ្សែ សង្វាក់ និង ហេដ្ឋារចនាសម្ព័ន្ធ ក្នុង កំពង់ផែ ពិសេស ការលើកឡើង ពី កិច្ចសហប្រតិបត្តិការ រវាង មន្រ្តី ថ្នាក់ដឹកនាំ កំពង់ផែ អន្តរជាតិ យូកូហាម៉ា ជាមួយ កំពង់ផែ ស្វយ័ត ខេត្ត ព្រះសីហនុ ។ ដោយសារតែ ប្រទេស ជប៉ុន គឺជា ប្រទេស ដែន កោះ ទំនិញ គ្រប់ សារពើ ត្រូវបាន ធ្វើការនាំចេញ និង នាំចូល ស្ទើរ ៩៩% ។
កំពង់ផែន អន្តរជាតិ យូកូហាម៉ា គឺជា កំពង់ផែ យុទ្ធសាស្រ្ត ដ៏ សំខាន់ នៅ ជប៉ុន ដែល មាន ការទុកដាក់ ទំនិញ កុងតឺន័រ រថយន្ត លំដាប់ ទី២ក្នុង ប្រទេស ជប៉ុន ពិសេស ជា កន្លែង សម្រាប់ នាវាចរណ៍ ផងដែរ ។ ទីក្រុង យូកូហាម៉ា មាន កំពង់ផែ អន្តរជាតិ ចំនួន ៣ ក្នុង នោះ មាន កំពុង ផែ ទឹក ជ្រៅ បំផុត ចំនួន ១ ។ កំពង់ផែន កុងតឺន័រ យូកូហាម៉ា ត្រូវបាន បង្កើតឡើង នៅ ឆ្នាំ ១៩៩៥ ដែល មាន ផ្ទៃដី ទំហំ ជាង ៣២ម៉ឺន ហិចតា ដែល មាន ភារកិច្ចទុកដាក់ និង នាំចេញ នាំចូល ដ៏ សំខាន់ របស់ ប្រទេស ជប៉ុន ។
សម្តេច តេជោ ហ៊ុន សែន បាន សំដែង ការវាយតម្លៃ ខ្ពស់ ចំពោះ ថ្នាក់ដឹកនាំ កំពង់ផែ អន្តរជាតិ យូកូហាម៉ា ដែល បាន អនុញ្ញាតឲ្យ រូប សម្តេច និង គណៈប្រតិភូ អញ្ជើញ ធ្វើ ទស្សនកិច្ច ។
សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ក៏ បាន ស្នើ ដល់ ថ្នាក់ដឹកនាំ កំពង់ផែ អន្តរជាតិ យូកូហាម៉ា បន្ត ការ យកចិត្តទុកដាក់ និង បង្កើន កិច្ចសហប្រតិបត្តិការ ជាមួយ ថ្នាក់ដឹកនាំ កំពង់ផែ ស្វយ័ត ខេត្ត ព្រះសីហនុ សំដៅ ធ្វើ យ៉ាងណា ប្រែក្លាយ កំពង់ផែ ស្វយ័ត ខេត្ត ព្រះសីហនុ ក្លាយទៅជា កំពង់ផែ ដែល មាន លក្ខណះ ស្តង់ដារ អន្តរជាតិ និង មាន ការប្រកួតប្រជែង ជាមួយនិង បណ្តា កំពង់ផែ នៃ ប្រទេស ក្នុង តំបន់ និង អន្តរជាតិ ៕
សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ទស្សនា មជ្ឈមណ្ឌល សំអាត ទឹក លូ ក្នុង ទីក្រុង តូក្យូ
នៅ មជ្ឈមណ្ឌល សំអាត ទឹក លូ ក្នុង ទីក្រុង តូក្យូ វត្តមាន នៃ ការអញ្ជើញ ដល់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ត្រូវបាន ការធ្វើ គារវកិច្ច ស្វាគមន៍ យ៉ាង កក់ក្តៅ បំផុត ពីសំណាក់ ថ្នាក់ដឹកនាំ នៃ មជ្ឈមណ្ឌល សំអាត ទឹក លូ ។
សម្តេច តេជោ និង គណៈប្រតិភូ បាន តាមដាន ស្តាប់ យក ចយកចិត្តទុកដាក់ ពី ការធ្វើ បទបង្ហាញ ពីសំណាក់ ថ្នាក់ដឹកនាំ មជ្ឈមណ្ឌល ស្តីពី គម្រោង នៃ ការផលិត ទឹក ស្អាត ក្នុង ទីក្រុង តូក្យូ ពិសេស ការធ្វើ ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ សម្រាប់ បម្រើ ឲ្យ សេចក្តីត្រូវការប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ ក្នុង ទីក្រុង តូក្យូ ។
ជាមួយនិង ការធ្វើ បទបង្ហាញ នោះ ដែរ ថ្នាក់ដឹកនាំ មជ្ឈមណ្ឌល ក៏ បាន ជំរាប ជូន សម្តេច តេជោ ដែរ ថា មជ្ឈមណ្ឌល កំពុង ធ្វើ កិច្ចសហប្រតិបត្តិការ ជាមួយនិង ប្រទេស កម្ពុជា ក្នុង ការនាំយក នូវ បច្ចេកវិទ្យា ដ៏ ទំនើប នេះ ទៅកាន់ ប្រទេស កម្ពុជា ដើម្បី ធ្វើ ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ មួយចំនួន ដើម្បី ម ប្រើ ឲ្យ សេចក្តីត្រូវការ និង ការប្រើប្រាស់ របស់ ប្រជាជន កម្ពុជា ពិសេស ការកាត់បន្ថយ លើ ហានិភ័យ នៃ សុខភាព របស់ ប្រជាជន កម្ពុជា ៕
បទល្មើស « ប្លន់ » ធ្លាប់ ត្រូវបាន បញ្ញត្តិ ក្នុង មាត្រា ៣៤ នៃ បទបញ្ញត្តិ ស្តីពី ប្រព័ន្ធ តុលាការ ច្បាប់ ព្រហ្មទណ្ឌ និង នីតិវិធី ព្រហ្មទណ្ឌ សម្រាប់ អនុវត្ត នៅ ប្រទេស កម្ពុជា ក្នុង សម័យ អន្តរកាល គឺ សម័យកាល ក្រោយ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារី ឬ សម័យ អ៊ុន តាក់ ជាទូទៅ ត្រូវបាន ហៅ ថា « ច្បាប់ ព្រហ្មទណ្ឌ អន្តរកាល » ដែល ត្រូវបាន ដាក់ ឲ្យ អនុវត្ត តាំងពី ១៩៩២ មក និយមន័យ នៃ បទល្មើស ប្លន់ ដែល មាន ចែង ក្នុង ច្បាប់ ព្រហ្មទណ្ឌ អន្តរកាល ខាងលើ បាន កំណត់ និយមន័យ ថា៖
១៖ អំពើ លួច នេះ ប្រព្រឹត្តទៅ មុនពេល ក្នុង ពេល ឬ ក្រោយពេល ប្រើ ហិង្សា ។ ២៖ អំពើ លួច នេះ ប្រព្រឹត្ត ដោយ ការ កាប់ គាស់ ទម្លុះ ទម្លាយ ។
សរុប មកវិញ ចាប់តាំងពី ក្រម ព្រហ្មទណ្ឌ ឆ្នាំ ២០០៩ ចូល ជាធរមាន រហូតមកដល់ ពេល បច្ចុប្បន្ន នេះ គឺ មិន មាន ទៀត ឡើយ នូវ បទល្មើស « ប្លន់ » គឺ មាន តែ បទល្មើស « លួច » ដែល ដូច មាន រៀបរាប់ ខាងលើ ហេតុ ដូច្នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ឈប់ មាន ការយល់ ច្រឡំ និង ប្រើប្រាស់ ខុស នូវ ឈ្មោះ បទល្មើស ខាងលើ តទៅទៀត ។
យោង ទៅតាម ក្បួន ច្បាប់ ដីកា របស់ ព្រះសម្មាសម្ពុទ្ធ ប្រជាពលរដ្ឋ មាន ជំនឿ ថា អ្នក មាន គុណ បុព្វការី ជន ឬ សាច់ញាតិ របស់ ពួកគេ ទាំងអស់ ដែល បាន សាងបាប ពេល នៅ មាន ជីវិត រស់ នៅ នោះ ពេល ចែក ឋាន ទៅ មិន ដឹង ចាប់ ជាតិ ជា អ្វី ឬ មាន បាប ទៅ កើត ជា ប្រេត នោះ នឹង ឡើង មក ទទួល កុសល ផល បុណ្យ នេះ ពី ពួកគេ នៅ ពេល ពពួក ប្រេត ទាំងនេះ ត្រូវបាន គេ ដោះលែង ឲ្យ មាន សេរីភាព រយៈពេល ១៥ ថ្ងៃ ។
រយៈពេល ១៥ ថ្ងៃ នេះ ពពួក ប្រែត ទាំងអស់ បាន ស្វែងរក ការឧទ្ទិស មគ្គផល ឲ្យ ពី សាច់ញាតិ នៅ គ្រប់ វត្ត ទាំងអស់ ។ ប្រសិនបើ អំឡុង ពេល ៧ ថ្ងៃ ប្រែត ដើរ រក គម្រប់ ៧វត្ត ហើយ នៅតែ មិន ឃើញ សាច់ញាតិ ឬ កូន ចៅ ណា ធ្វើ បាយ សម្ល ទៅ ប្រគេន ព្រះសង្ឃ នៅ វត្ត ដើម្បី ឧទ្ទិស កុសល ដល់ ពួកគេ ទេ ប្រេត ទាំងនេះ នឹង ដាក់ បណ្តាសារ នូវ ទំនាយ ផ្សេង ៗ ។
គេ ជឿ ទៀត ថា ពពួក ប្រេត ទាំងអស់ សុទ្ធតែ ខ្លាច ពន្លឺ ថ្ងៃ និង ប្រេត ក្រីក្រ ខ្លះ គ្មាន សម្លៀកបំពាក់ នឹង មិន ហ៊ាន ចេញមក ទទួល មគ្គផល ពី កូន ចៅ ដោយ ចំហរ ឡើយ ដូច្នេះហើយ ទើប ដូនតា តម្រូវឲ្យ កូន ចៅ ទាំងអស់ ត្រូវ ទៅ បោះ បាយ បិណ្ឌ នៅ រៀងរាល់ វេលា យប់ ចាប់ពី ម៉ោង ២ រំលង អាធ្រាត្រ រហូតដល់ ម៉ោង ៥ ទាប ភ្លឺ ។ ក្រៅពី នេះ ប្រជាពលរដ្ឋ កម្ពុជា ដែល កាន់ ព្រះពុទ្ធ សាសនា ទាំងអស់ ត្រូវតែ ធ្វើ ម្ហូប អាហារ នំ ចំណី យក ទៅ ប្រគេន ព្រះសង្ឃ ដែល គង់ ចាំ ត្រីមាស ក្នុង វត្ត ដើម្បី ជូន មគ្គផល ដល់ អ្នកស្លាប់ ផងដែរ ។
ដើម្បី បាន ពរ ជ័យ ពី អ្នកស្លាប់ ទៅ ដូចជា ឪពុក ម្តាយ ឬ អ្នកមាន គុណ ទាំងឡាយ ដទៃ ទៀត កូន ចៅ ទាំងអស់ នៃ បុព្វការី ជន យ៉ាងហោចណាស់ រយៈពេល មួយ ឆ្នាំ នៃ ពិធី បុពណ្យ នេះ ត្រូវ ទៅ វត្ត ឲ្យបាន មួយ ដង ឬ ទៅ បោះ បាយ បិណ្ឌ ឲ្យបាន មួយ វត្ត ជាកំហិត ។
បើ ទោះបី ខ្មែរ មាន ជំនឿ ថា ការធ្វើ បុណ្យ ភ្ជុំ បិណ្ឌ ដើម្បី ឧទ្ទិស កុសល ដល់ បុព្វការី ជន របស់ ខ្លួន ដែល បាន ចែក ឋាន ទៅ យ៉ាងណា ក្តី តែ ពិធី បុណ្យ មួយ នេះ បាន ឆ្លុះបង្ហាញ ឲ្យ ឃើញ ពី ទង្វើ ជា គុណធម៌ ដ៏ ធំ មួយ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ចំពោះ ជន ទាំងឡាយ ដែល បាន តប គុណ ចំពោះ ខ្លួន ជាពិសេស ជីដូន ជីតា និង ឪពុក ម្តាយ ដែល ជា អ្នកមាន គុណ បំណាច់ ដ៏ ធំធេង សម្រាប់ ជីវិត របស់ ពួកគេ ។
ពិធី បុណ្យ នេះ បាន បង្កប់ នូវ ខ្លឹមសារ អប់រំ មួយ ទៀត ឲ្យ ប្រជាពលរដ្ឋ ខ្មែរ យើង បាន នឹករលឹក ដល់ គុណូបការៈ របស់ ជីដូន ជីតា ឪពុក ម្តាយ ដែល ពួកគាត់ ពេល នៅ មាន ជីវិត សុទ្ធតែ បាន ធ្វើ ការលះបង់ និង ពលីកម្ម សព្វ បែប យ៉ាង ទាំងអស់ ដើម្បី ការរស់ រៀន ដ៏ គាប់ ប្រសើរ របស់ កូន ចៅ ។ ការចងចាំ និង នឹករលឹក ដល់ គុណ របស់ ជន ទាំងឡាយ ដែល បាន ធ្វើ មក លើ ខ្លួន របស់ យើង ម្នាក់ ៗ គឺជា កាយវិការ ដ៏ ថ្លៃថ្លា បំផុត ។
បុណ្យ ភ្ជុំ បិណ្ឌ មិន ត្រឹមតែ ជា ឱកាស តបគុណ ដល់ អ្នក ដែល បាន ធ្វើ មរណកាល ប៉ុណ្ណោះ ទេ តែ ក៏ ជា ពេលវេលា ដ៏ ប្រពៃ ថ្លៃថ្លា ផងដែរ សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ របស់ យើង បាន ធ្វើ ទង្វើ តប គុណ ចំពោះ ជន នៅ មាន ជីវិត ជា ជីដូន ជីតា ឪពុក ម្តាយ ចាស់ ព្រឹទ្ធាចារ្យ និង ជន មាន ឧបការគុណ ដទៃ ទៀត ផងដែរ ។
ខ្ញុំបាទ ក៏ សូម លើក ដៃ ប្រណម បួងសួង ដល់ បុណ្យ គុណ ព្រះរតនត្រ័យ វត្ថុ ស័ក្តិសិទ្ធ ក្នុង លោក ទេវតា ថែរក្សា ចក្រវាឡ យើង នេះ តាម ជួយ អភិបាល ប្រោស ព្រំ ដល់ ថ្នាក់ដឹកនាំ ជាតិ កម្ពុជា ដៃគូ ពាណិជ្ជកម្ម និង ជន រួម ជាតិ ខ្មែរ ទាំងអស់ បាន ជួប តែ សេចក្តីសុខ សេចក្តី ចម្រើន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង កាយ មាំ មួន សម្រេច រាល់ ភារកិច្ច ដែល ប៉ងប្រាថ្នា ជាពិសេស គ្រប់ ដំណើរ ទៅកាន់ ទីកន្លែង នានា បាន ជួប តែ សុខ សុវត្ថិភាព និង ពោរពេញ ដោយ ភាពសប្បាយរីករាយ ៕
( ភ្នំពេញ ) ៖ លោក ថោង ខុន រដ្ឋមន្ត្រី ទេសចរណ៍ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ សូម ចេញមក ប្រកាស ថ្លែង កោតសរសើរ ដោយ ស្មោះ ចំពោះ លោក សាន ស៊ាន ហូ អភិបាល ក្រុង ប៉ោយប៉ែត ដែល មាន ទស្សនៈ គោលជំហរ ច្បាស់លាស់ ក្នង ការយល់ ដឺង ពី បរិស្ថាន មាន ឆន្ទៈ ស្មារតី សកម្មភាព មោះ មុត ចង់ឲ្យ ទីក្រុង ស្អាត មាន អនាម័យ ល្អ ផ្តល់ នូវ ផាសុខភាព ជូន ប្រជាពលរដ្ឋ ផ្តល់ នូវ ភាពទាក់ទាញ ដល់ ទេសចរ សក្តិសម ជា ទីក្រុង ច្រកទ្វារ អន្តរជាតិ ទីក្រុង មុខមាត់ របស់ ប្រទេសជាតិ ។
លោក រដ្ឋមន្រ្តី ថោង ខុន បាន ថ្លែង ឲ្យដឹង ថា លោក សាន ស៊ាន ហូ អភិបាល ក្រុង ប៉ោយ ប៉ែត សកម្ម ណាស់ ក្នុង ការចូលរួម ចលនា ប្រលងប្រណាំង ទីក្រុង ស្អាត ។ សូម អរគុណ និង សូម កោតសរសើរ ដោយ ស្មោះ ។
តាម សេចក្តីរាយការណ៍ ពី អ្នកសារព័ត៌មាន នៅ កន្លែង កើត ហេតុ ស្ថិត ក្នុង ស្រុក Plaisance នោះ ឲ្យដឹង ទៀត ថា អគារ ព្រះវិហារ សាសនា គ្រិស្ត មួយ ខ្នង បាន ដួលរលំ និង លំនៅដ្ឋាន ប្រជាជាន ជាច្រើន ខ្នង ទៀត រង ការបំផ្លិចបំផ្លាញ ប៉ុន្តែ ពុំ មាន ការបញ្ជាក់ ថា មាន មនុស្ស ស្លាប់ និង រងរបួស ឬក៏ អត់ នោះ ឡើយ ។
គួរ រំលឹក ថា ភាពឈឺចាប់ បំផុត នៃ មហន្តរាយ បង្កឡើង ដោយ គ្រោះ រញ្ជួយ ដី កម្រិត ធ្ងន់ នៅ ហៃ ទី កាលពី ឆ្នាំ ២០១០ នោះ គឺ បាន កើត មាន ឡើង លើ រដ្ឋធានី ព័រ អូព្រីន តែ ម្តង ដោយ បាន សម្លាប់ មនុស្ស ជិត ២៣០.០០០ នាក់ និង ទីក្រុង ស្ទើរ ទាំងមូល រង ការបំផ្លិចបំផ្លាញ ៕
ជក់ គ្រឿងញៀន ចិត្ត ក្លាហាន លួច ម៉ូតូ កង់ បី ត្រូវ អាវុធហត្ថ រាជធានី ភ្នំពេញ ក្របួច ចូល គុគ !
( ភ្នំពេញ ) ៖ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ បាន បញ្ជូន ជនសង្ស័យ ០២ នាក់ ទៅ តុលាការ ដើម្បី ផ្តន្ទាទោស តាម ច្បាប់ ពាក់ព័ន្ធ ករណី លួច ម៉ូតូ កង់ បី ។
ករណី លួច ម៉ូតូ នេះ កើតឡើង កាលពី ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៨ វេលា ម៉ោង ប្រហែល០១៖ ០០ នាទី រំលង អាធ្រាត្រ ស្ថិត នៅ ភូមិ ដើម ចាន់ សង្កាត់ ច្បារអំពៅ២ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ បង្កឡើង ដោយ ជនសង្ស័យ ទាំង ០២ នាក់ ។ ជនសង្ស័យ បាន ធ្វើ សកម្មភាព លួច ម៉ូតូ កង់ បី ០១ គ្រឿង គ្មាន ស្លាកលេខ ជា របស់ ជនរងគ្រោះ មាន ឈ្មោះ ខាន់ វុទ្ធី ភេទ ប្រុស អាយុ ៣៨ ឆ្នាំ ដែល បាន ចត ទុក នៅមុខ នៅមុខ ផ្ទះ ជួល របស់ ខ្លួន ហើយ បាន ចាក់សោរ - ក យ៉ាង ត្រឹមត្រូវ ដូច សព្វ ដង ហើយ បាន ចូលទៅ ដេក ជាធម្មតា ។
ក្រោយ ភ្ញាក់ ពី ដំណេក ជនរងគ្រោះ បាន ចេញ ទៅ មើល ម៉ូតូ កង់ បី របស់ ខ្លួន ដើម្បី យក ទៅ ជួយ ដឹក សម្ភារ របស់ ប្រពន្ធ ទៅ លក់ នៅ ផ្សារ ច្បារអំពៅ តែ មិន ឃើញ ម៉ូតូ កង់ បី របស់ ខ្លួន ហើយ បាន ដឹង ថា ត្រូវ ចោរ លួច យក ទៅ បាត់ ក៏ បាន ទៅ ដាក់ ពាក្យ បណ្តឹង នៅ មូលដ្ឋាន អាវុធហត្ថ ខណ្ឌ ច្បារអំពៅ ដើម្ប ឲ្យ ជួយ ស្រាវជ្រាវ រក ។
ជនសង្ស័យ បាន បន្ត ថា បន្ទាប់មក ឈ្មោះ ចាន់ សុធី បាន ត្រឡប់ ទៅ ដេក នៅ ផ្ទះ របស់ គេ វិញ ចំណែក ឈ្មោះ គង់ សុថៃ នៅ អង្គុយ ចាំ ម៉ូយ មក ទិញ កង់ បី នោះ ។ លុះ ដល់ ម៉ោង ០៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ២៤ ខែតុលា ឆ្នាំ ២០១៨ ស្រាប់តែ មាន សមត្ថកិច្ច អាវុធហត្ថ មក ឃាត់ ពួក ខ្លួន តែម្តង ៕ មេ ស្ថាប័ន ប៉ូលិស អន្តរជាតិ Interpol បាត់ខ្លួន យ៉ាង អាថ៌កំបាំង ខណៈ ការស៉ើប អង្កេត កំពុង ប្រព្រឹត្តទៅ
បើ តាម ការរាយការណ៍ ពី ភរិយា របស់ លោក មេ ប៉ូលិស អន្តរជាតិ វ័យ ៦៤ ឆ្នាំ រូប នេះ បាន បាត់ខ្លួន ក៏ដូចជា ដំណឹង ចាប់តាំងតែពី រូប លោក បាន ធ្វើដំណើរ ទៅកាន់ ប្រទេស ចិន ដែល ជា ប្រទេស កំណើត របស់ លោក កាលពី សប្តាហ៍ មុន ។ បច្ចុប្បន្ន លោក Meng មាន ទីលំនៅ ជាមួយ ភរិយា និង កូន នៅក្នុង ទីក្រុង លីយ៉ុង នៃ ប្រទេស បារាំង ។
( ភ្នំពេញ ) ៖ ចាប់ពី ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ សាលា រាជធានី ភ្នំពេញ ចាប់ផ្តើម បញ្ចេញ រថយន្តក្រុង សាធារណៈ ចំនួន ១២០ គ្រឿង ដើម្បី ដឹក ប្រជាពលរដ្ឋ ទៅ លេង ស្រុក កំណើត ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។
ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ពី រាជធានី ភ្នំពេញ ទៅ ខេត្ត នានា ក៏ ដូចជា ត្រឡប់ ពី ខេត្ត នានា ត្រឡប់មក រាជធានី ភ្នំពេញ វិញ ឱ្យ មាន លក្ខណៈ ល្អ ប្រសើរ នោះ នៅក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន សម្រេច ផ្តល់ កាដូ មួយ ថ្មី ទៀត ជូន ដល់ ប្រជាពលរដ្ឋ ដោយ បញ្ជា ឱ្យ សាលា រាជធានី ភ្នំពេញ បញ្ចេញ រថយន្តក្រុង សាធារណៈ ១២០ គ្រឿង ដើម្បី ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ទៅ មក មិន គិត ថ្លៃ រយៈពេល ៦ ថ្ងៃ នៅក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។
ដើម្បី ជ្រាប ច្បាស់ អំពី ទីតាំង និង ពេលវេលា នៃ ការជិះ រថយន្តក្រុង ដោយ ឥត គិត ថ្លៃ នេះ សូម អាន សេចក្តីជូនដំណឹង ខាងក្រោម៖
សូម កុំ បើកបរ ស្ថិត ក្រោម ឥទ្ធិពល គ្រឿងស្រវឹង ! ស្លាប់ ៣នាក់ និង រងរបួស ៩នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៦ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ របួស ធ្ងន់ ៦នាក់ និង របួស ស្រាល ៣នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា ក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៤លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៦គ្រឿង . រថយន្ដ ធុន តូច ៤គ្រឿង . រថយន្ដ ធុន ធំ១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ និង ស្រវឹង ។
ទឹកប្រាក់ ១. ៥០០០ ដុល្លារ ត្រូវបាន ប្រគល់ ជូន គ្រូបង្ហាត់ ឆ្កែ ល្បី ប្រចាំ កម្ពុជា បន្ទាប់ពី ក្រុមហ៊ុន ២រួមគ្នា ធ្វើ យុទ្ធនាការ ប្រមូល ថវិកា សប្បុរសធម៌
លោកស្រី តែ មុយនី នាយិការ នាយកដ្ឋាន ទំនាក់ទំនង អាជីវកម្ម ធនាគារ ព្រីនស៍ ឲ្យដឹង ថា ធនាគារ មាន គោលការណ៍ រួមចំណែក ជួយ ដល់ សង្គម តាមរយៈ មធ្យោបាយ ផ្សេង ៗ ។ លោកស្រី ថា « ជាក់ស្ដែង ដូច ករណី លោកគ្រូ ហ៊ិន រតនា អឹចឹង បើ មាន តម្រូវការជួយ យើង នឹង ជួយ ទៅ តាម លទ្ធភាព ហើយ ការជួយ នេះ នឹង ធ្វើឲ្យ មាន វប្បធម៌ ក្នុង ការជួយគ្នា ឲ្យ កាន់តែ ប្រសើរឡើង » ។
សូម បញ្ជាក់ ថា លោក ហ៊ិន រតនា ជា បុគ្គល មួយ ទទួល ការបណ្តុះបណ្តាល ជំនាញ បង្ហាត់ ឆ្កែ នៅ សហរដ្ឋ អាមេរិក មិន ត្រឹមតែ ឈ្មោះ ល្បី នៅ កម្ពុជា ប៉ុណ្ណោះ ទេ តែ ថែមទាំង មាន ការទទួលស្គាល់ ពី អន្តរជាតិ ថែម ទៀត ផង ប៉ុន្ដែ កាលពី មួយ រយៈ មុន លោក បាន ជួប គ្រោះថ្នាក់ ចរាចរណ៍ យ៉ាង ធ្ងន់ធ្ងរ និង ត្រូវការ ថវិកា ជាបន្ទាន់ សម្រាប់ ព្យាបាល ជំងឺ ៕ ជន ចាស់ជរា គ្មាន ទីពឹង ពលរដ្ឋ កូន ច្រើន ជួប ការលំបាក និង រងគ្រោះ ដោយសា ទឹក ជំនន់ ៣៧គ្រួសារ ក្នុង ក្រុង កំពង់ឆ្នាំង ទទួលបាន អំណោយ ពី លោកស្រី សឿ សុជាតា
( កំពង់ឆ្នាំង ) ៖ លោកស្រី បណ្ឌិត សឿ សុជាតា អនុ រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា រួម ជាមួយ សហការី នៅ ថ្ងៃសៅរ៍ ទី៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ជួប សំណេះសំណាល សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ មួយចំនួន ជូន ជន ចាស់ជរា គ្មាន ទីពឹង និង ប្រជាពលរដ្ឋ កូន ច្រើន ជួប ការលំបាក ចំនួន ៣៧ គ្រួសារ នៅក្នុង ក្រុង កំពង់ឆ្នាំង ។
លោកស្រី ក៏ បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ទាំង ៣៧ គ្រួសារ ឲ្យ ខិតខំ ថែទាំ សុខភាព ឲ្យបាន ល្អ ដោយ រស់ នៅ ស្អាត ហូប ស្អាត បើ ស្ថានភាព សុខភាព មិន ស្រួល ត្រូវ អញ្ជើញ ទៅ មន្ទីរពេទ្យ ឬ មណ្ឌល សុខភាព ឲ្យបាន ទាន់ ពេល វេលា ។
( កណ្តាល ) ៖ ឧកញ៉ា ទ្រី ភាព ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា បាន ចំណាយ ថវិកា ផ្ទាល់ខ្លួន សរុប ២០០ លាន រៀល ស្មើ ប្រមាណ ៥ម៉ឺន ដុល្លារ អាមេរិក ជា រង្វាន់ លើកទឹកចិត្ត សិស្ស ជាប់ និង ធ្លាក់ បាក់ឌុប ឆ្នាំ ២០១៨ នេះ ។ ពិធី ប្រគល់ រង្វាន់ លើកទឹកចិត្ត សិស្ស ដែល បាន ចូលរួម ប្រលង បាក់ឌុប ឆ្នាំ ២០១៨ នៅ ទូទាំង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ ។
ក្នុង ឱកាស អញ្ជើញ ប្រគល់ រង្វាន់ លើកទឹកចិត្ត សិស្ស ប្រលង ជាប់ ក៏ ដូចជា ប្រលង ធ្លាក់ បាក់ឌុប នេះ ឧកញ៉ា ទ្រី ភាព បាន បង្ហាញ ភាពសប្បាយរីករាយ និង មោទនភាព ខ្លាំង ចំពោះ កូន ចៅ ប្រជាពលរដ្ឋ ស្រុក កណ្តាល ស្ទឹង ដែល បាន ប្រឹងប្រែង សិក្សា រៀនសូត្រ រហូត ប្រលង ជាប់ ក្នុង អត្រា មួយ ខ្ពស់ ។ តែ ទោះជា យ៉ាងណា លោក ឧកញ៉ា ក៏ សោកស្តាយ ដែល សិស្ស ក្នុង ស្រុក កណ្តាល ស្ទឹង មិន អាច ដណ្តើម បាន និទ្ទេស A នៅក្នុង ឆ្នាំ នេះ ។
ឧកញ៉ា ទ្រី ភាព ក៏ បាន ក្រើន រំលឹក សិស្ស ប្រលង ជាប់ បាក់ឌុប ទាំងអស់ ត្រូវ បន្ត ប្រឹងប្រែង បន្ថែម ទៀត ក្នុង ការសិក្សា នៅ ថ្នាក់ ឧត្តម សិក្សា ដើម្បី ក្រេប ជញ្ជក់ យក ចំណេះ វិជ្ជា ធ្វើជា ដើមទុន សម្រាប់ ជីវិត រួមចំណែក កសាង អភិវឌ្ឍន៍ ស្រុក កំណើត របស់ ខ្លួន ក៏ ដូចជា រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល អភិវឌ្ឍន៍ ជាតិ កម្ពុជា ឲ្យកាន់តែ រីកចម្រើន ថែម ទៀត ។
គ្រឿងញៀន ជា ថ្នាំ បំពុល សង្គម និង បំផ្លាញ ធនធាន មនុស្ស ដ៏ គួរឲ្យ បារម្ភ មួយ ក្នុង សង្គម កម្ពុជា នា ពេល បច្ចុប្បន្ន ។ ឧកញ៉ា ទ្រី ភាព បាន រំលឹក ដល់ សិស្ស ប្រលង ជាប់ បាក់ឌុប ហើយ ត្រូវ បន្ត ការសិក្សា នៅ រាជធានី ភ្នំពេញ ត្រូវ ប្រុងប្រយ័ត្ន ខ្លួន ឲ្យបាន ខ្ពស់ មិន ត្រូវ បណ្តែត បណ្តោយ ខ្លួន ឲ្យ មិត្តភក្តិ អូសទាញ ទៅ ប្រើប្រាស់ គ្រឿងញៀន បំផ្លាញ អនាគត របស់ ខ្លួន នោះ ឡើយ ។
សម្រាប់ អ្នកប្រលង ធ្លាក់ បាក់ឌុប លោក ឧកញ៉ា បាន លើកទឹកចិត្ត ឲ្យ ពួកគេ ប្រឹងប្រែង បន្ត ទៀត មិន ត្រូវបាក់ទឹកចិត្ត ហើយ បោះបង់ ការសិក្សា ឡើយ ។ លោក ឧកញ៉ា បាន រំលឹក ពួកគេ ថា ការបរាជ័យ ជា រឿង ធម្មតា សម្រាប់ ជីវិត របស់ មនុស្ស មិន ថា អ្នកសិក្សា ឬ អ្នក ប្រកបរបរ រកស៊ី នោះ ឡើយ ប៉ុន្តែ អ្វី ដែល សំខាន់ គឺ ត្រូវ ចេះ សាង ភាពបរាជ័យ របស់ ខ្លួន ឲ្យ ឈាន ទៅ រក ពន្លឺ ជោគជ័យ វិញ ។
ក្នុង ន័យ នេះ ឧកញ៉ា ទ្រី ភាព បាន ដាស់តឿន សិស្ស ប្រលង ធ្លាក់ បាក់ឌុប នៅ ឆ្នាំ នេះ ថា ប្រសិនបើ មិន ទៅ រៀន ថ្នាក់ បរិញ្ញាបត្រ រង ឬ រៀន ជំនាញ បច្ចេកទេស អ្វី ផ្សេង ទេ ហើយ ត្រូវ បន្ត រៀន ថ្នាក់ ទី ១២ត្រៀម ប្រលង នៅ ឆ្នាំ ២០១៩ នោះ ត្រូវ ប្រឹងប្រែង សិក្សា ចាប់ពី ដើម ឆ្នាំ ទៅ ។ លោក ឧកញ៉ា បាន បង្ហាញ ការជឿជាក់ ថា បើ ពួកគេ ប្រឹងប្រែង រៀនសូត្រ គឺ នឹង ទទួលបាន ជោគជ័យ ជាពិសេស កុំ ចំណាយ ពេល ជាមួយ បណ្តាញ សង្គម Facebook ច្រើន ពេក ។
លោក ឧកញ៉ា ក៏ បាន ក្រើន រំលឹក ដល់ លោកគ្រូ អ្នកគ្រូ ឲ្យ ប្រឹងប្រែង បណ្តុះបណ្តាល សិស្ស ឲ្យ រៀន ពូកែ យក និទ្ទេស A ឲ្យបាន ដើម្បី លើក កិត្តិយស គ្រូ ៗ ក៏ ដូចជា ពលរដ្ឋ ក្នុង ស្រុក កណ្តាល ស្ទឹង ទាំងមូល ។
ក្នុង ឱកាស នោះ លោក ឧកញ៉ា ក៏ បាន រំលឹក ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ការអភិវឌ្ឍ លើ វិស័យ អប់រំ តាមរយៈ បង្កើន ប្រាក់ បៀវត្សរ៍ គ្រូ បង្រៀន និង ការសាងសង់ សាលារៀន ជាដើម ។ លោក ឧកញ៉ា បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី នេះ សម្តេច តេជោ ហ៊ុន សែន នៅតែ បន្ត ចាត់ទុក ការបណ្តុះបណ្តាល ជា ការងារ ចម្បង សម្រាប់ កសាង ធនធាន មនុស្ស ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន ។
សិស្ស ទាំង ជាប់ និង ធ្លាក់ បាក់ឌុប បាន បង្ហាញ ក្តី សប្បាយរីករាយ និង ពេញចិត្ត ជាខ្លាំង ចំពោះ កាយវិការ របស់ ឧកញ៉ា ទ្រី ភាព ។ ពួកគេ បាន លើកឡើង ថា រង្វាន់ ឧកញ៉ា ទ្រី ភាព ជា ការលើកទឹកចិត្ត មួយ បន្ថែម ទៀត សម្រាប់ ការសិក្សា របស់ ពួកគេ ។
ក្រៅពី ឧបត្ថម្ភ ដល់ សិស្ស ហើយ លោក ឧកញ៉ា ក៏ បាន ផ្តល់ ថវិកា លើកទឹកចិត្ត ដល់ លោកគ្រូ - អ្នកគ្រូ ៩២ នាក់ នូវ ថវិកា ម្នាក់ ៗ ២០០.០០០ រៀល ផងដែរ ។
នៅ ចំពោះមុខ សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ និង ប្រជាពលរដ្ឋ ក្នុង ស្រុក កណ្តាល ស្ទឹង លោក ឧកញ៉ា បាន សន្យា ថា នឹង នាំយក រង្វាន់ មក ចែកជូនសិស្ស ៗ នៅ ស្រុក កណ្តាល ស្ទឹង ជារៀងរាល់ ឆ្នាំ ហើយ បើ ជាប់ និទ្ទេស A នឹង ចែក ម៉ូតូ ជូន ថែម ទៀត ផង ។ លោក ថា អំណោយ ទាំងនេះ គឺជា ចំណែក មួយ សម្រាប់ លើកទឹចិត្ត ផង និង សម្រាប់ ពួកគេ យក ទៅ ប្រើប្រាស់ ក្នុង ការសិក្សា បន្ត ទៀត ផងដែរ ៕
អភិបាល ខេត្ត ព្រះវិហារ ចុះ សួរសុខទុក្ខ ទាហាន ឈរជើង តាម បណ្តោយ ព្រំដែន ថៃ និង ឡាវ
( ព្រះវិហារ ) ៖ ប្រតិភូ រដ្ឋបាល ខេត្ត ព្រះវិហារ ដឹកនាំ ដោយ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ចុះ សួរសុខទុក្ខ និង សំណេះសំណាល ជាមួយ នាយ ទាហាន និង ពល ទាហាន ឈរជើង ជួរ មុខ តាម បណ្តោយ ព្រំដែន កម្ពុជា - ថៃ និង ឡាវ របស់ តំបន់ ប្រតិបត្តិការ សឹង រង ព្រះវិហារ នៅ ទីបញ្ជាការវរះ សេនា តូច លេខ ១ ក្នុង ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល នៃ គណៈអភិបាល ខេត្ត ពោធិ៍សាត់ បាន ជំរុញ ឲ្យ អាជ្ញាធរ ក្រុង និង មន្ទីរ សាធារណៈ ការ ខេត្ត ក្រោយ ដាច់ ទឹកភ្លៀង ត្រូវ ចូលរួម សហការ រៀបចំ ប្រព័ន្ធ លូរំដោះ ទឹក និង ស្ថាបនា ចាក់ កៅស៊ូ ផ្លូវ ចូល វត្ត ពាល ញែក ឡើងវិញ ដើម្បីឲ្យ ក្រុង ពោធិ៍សាត់ លេចចេញ សោភណ្ឌភាព ផាសុកភាព និង ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ចូលរួម ក្នុង ពិធី បុណ្យ អុំ ទូក លើក ដំបូង ក្នុង ទឹកដី ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ១៩ ដល់ ២០ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ខាងមុខ ។
លោក អភិបាល ខេត្ត បាន ជំរុញ បែប នេះ ក្នុង ឱកាស ចុះ សួរសុខទុក្ខ អាជីវករ ផ្សារ ពោធិ៍សាត់ និង ពិនិត្យ ហេដ្ឋារចនាសម្ព័ន្ធ បណ្តាញ លូ ផ្លូវ និង វេទិកា អុំ ទូក ក្នុង ក្រុង ពោធិ៍សាត់ នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ ។ ពិធី នោះ ក៏ មាន ការចូលរួម ពី លោក ម៉ក់ រ៉ា ទីប្រឹក្សា ក្រសួង មហាផ្ទៃ លោក អភិបាល រង ខេត្ត លោក នាយក រដ្ឋបាល សាលា ខេត្ត មន្ទីរ ជំនាញ និង អាជ្ញាធរ ក្រុង ។
លោក ម៉ៅ ធ និន បាន ថ្លែង ថា ដោយ មើលឃើញ ការលំបាក ក្នុង ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ក្នុង រដូវ វស្សា នេះ លោក បាន ចាត់ ឲ្យ អាជ្ញាធរ ក្រុង និង មន្ទីរ សាធារណៈ ការ ខេត្ត ក្រោយ ដាច់ ទឹកភ្លៀង ត្រូវ ចូលរួម សហការ ដាក់ គ្រឿងចក្រ រៀបចំ ប្រព័ន្ធ លូ និង ស្ថាបផ្លូវ កៅស៊ូ ចូល វត្ត ពាល ញែក មួយ ខ្សែ នេះ ឡើងវិញ ។ ក្រោយ ចាក់ កៅស៊ូ រួចរាល់ ក្រុមហ៊ុន រៀបចំ បង្គោល ភ្លើង ត្រូវ ចាប់ផ្តើម តម្លើង ភ្លើង បំភ្លឺ ផ្លូវ ដើម្បីឲ្យ មាន សោភណ្ឌភាព និង ភ្លឺ ព្រោងព្រាត ។
លោក អភិបាល ខេត្ត ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ ចូលរួម សហការ ជាមួយ អាជ្ញារ មាន សមត្ថកិច្ច និង មន្ទីរ ជំនាញ ដើម្បីឲ្យ កិច្ច ដំណើរការ ស្ថាបនា ទៅ បាន ដោយ រលូន និង មាន ភាពងាយស្រួល ។ លោក បន្ថែម ថា រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ បាន យកចិត្តទុកដាក់ កសាង និង អភិវឌ្ឍន៍ ប្រទេស នាំមក នូវ សុខ សន្តិភាព ដែល រកបាន ដោយ លំបាក ឈាន ទៅ កាត់បន្ថយ ភាពក្រីក្រី ជូន ប្រជាពលរដ្ឋ ។
ទន្ទឹមនឹង នេះ លោក ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ចូលរួម ថែទាំ សម្អាត អនាម័យ ជុំវិញ ផ្លូវ ក្នុង ទីប្រជុំជន និង តាម ដងស្ទឹង ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ចូលរួម ទស្សនា ឲ្យបាន ច្រើន កុះករ ក្នុង ពិធី បុណ្យ អុំ ទូក លើក ដំបូង ក្នុង ទឹកដី ខេត្ត ពោធិ៍សាត់ ដើម្បី អបអរ ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ដែល នឹង ប្រព្រឹទ្ធ ទៅ ចាប់ពី ថ្ងៃទី ១៩ ដល់ ២០ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ខាងមុខ ៕
សិស្សសាលារៀន អន្តរជាតិ អេស អាយ អេស (SIS) ទទួលបាន ការបណ្តុះបណ្តាល អំពី សុវត្ថិភាព ម្ហូប អាហារ ពី មន្ត្រី ជំនាញ
( ភ្នំពេញ ) ៖ ព្រឹក ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ សិស្សសាលា អន្តរជាតិ អេស អាយ អេស (SIS) ចំនួន ១៥៥ នាក់ បាន ទទួល ការបណ្តុះបណ្តាល ចំណេះដឹង មូលដ្ឋាន អំពី សុវត្ថិភាព ម្ហូប អាហារ ពី មន្ត្រី ជំនាញ កាំ កុងត្រូល សាខា ផែ ស្ងួត ចុង ទី - ភ្នំពេញ ។ មន្ត្រី កាំ កុងត្រូល ចុះ ផ្សព្វផ្សាយ អប់រំ ស្តីពី សុវត្ថិភាព ចំណីអាហារ ដល់ សិស្សសាលា ក្នុង ខណៈពេល ដែល ប្រជាពលរដ្ឋ ច្រើន ជាង ៦០០ លាន នាក់ ឈឺ និង ច្រើន ជាង ៤២ ម៉ឺន នាក់ ស្លាប់ ដោយសារ អាហារ មិន មាន សុវត្ថិភាព ក្នុង មួយ ឆ្នាំ ៗ នៅលើ ពិភពលោក នេះ ។
អគ្គ នាយកដ្ឋាន កាំកុងត្រូល បាន និង កំពុង ធ្វើ សកម្មភាព យ៉ាង ពុះកញ្ជ្រោល ក្នុង រយៈកាល រដូវ បុណ្យ ភ្ជុំ បិណ្ឌ នេះ នៅលើ ទីផ្សារ រទូរ ទាំង ប្រទេស ដែល ម្ហូប អាហារ ត្រូវបាន ប្រើប្រាស់ យ៉ាង គំហុគ ដើម្បី ធានា បាន នូវ សុខភាព និង សុខភាព ជូន ប្រជាពលរដ្ឋ ៕
សម្តេច ពញា ចក្រី ហេង សំរិន បាន កសាង សមិទ្ធផល ជាច្រើន ជូន វត្ត គីរី សុវណ្ណ រាម ខេត្ត ត្បូងឃ្មុំ ដើម្បី បម្រើ ព្រះពុទ្ធ សាសនា
( ត្បូងឃ្មុំ ) ៖ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា កម្ពុជា នា ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ បាន ទៅ អញ្ជើញ ចូលរួម ក្នុង ពិធី កាន់ បិណ្ឌ ទី ១២ នៅ វត្ត គីរី សុវណ្ណ រាម ហៅ វត្ត ថ្កូវ ស្ថិត ក្នុង ភូមិ អន្លង់ ជ្រៃ ឃុំ កក់ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ ជា វត្តមាន វ័យ ចំណាស់ ជាង គេ មួយ ក្នុង តំបន់ ទឹកដី ខេត្ត ត្បូងឃ្មុំ នេះ ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន និង ក្រុមគ្រួសារ បាន កសាង សមិទ្ធផល ជាច្រើន ជូន វត្ត ដ៏ មាន វ័យ ចំណាស់ នេះ ហើយ នា ពេល សព្វ ថ្ងៃ នេះ វត្ត ថ្កូវ ដែល មាន ការជូន ជ្រោមជ្រែង ពី សម្តេច ពញា ចក្រី មាន ការលូតលាស់ និង រីកចម្រើន ជាខ្លាំង ផងដែរ ។
ក្រៅពី ការកសាង សមិទ្ធផល យ៉ាង ធំធេង នេះ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា កម្ពុជា និង ក្រុមគ្រួសារ ក៏ បាន ប្រគេន បច្ច័យ សម្រាប់ កសាង វត្ត ដ៏ ចាស់ បុរាណ មួយ នេះ បន្ត ទៀត ដោយ ទឹកប្រាក់ ចំនួន ១០លាន រៀល ផងដែរ ៕
គម្រោង មិង ហួរ ខុនដូ មីនៀម ក្នុង ទឹកប្រាក់ វិនិយោគ ជាង ១១លាន ដុល្លារ សម្ពោធ បើក លក់ ជា ផ្លូវការ !
ថ្លែង ក្នុង ពិធី នោះ លោក ឈួរ ឈុន ហួរ អគ្គ នាយក ក្រុមហ៊ុន មិង ហួរ គ្រុប ខូអិលធីឌី បាន ថ្លែង ថា បច្ចុប្បន្ន នេះ ទីក្រុង ភ្នំពេញ ជា បេះដូង និង ជា សរសៃ ឈាម សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង ទេសចរ ដ៏ សំបូរ បែប ដែល នាំឲ្យ មាន កំណើន នៃ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង ទីក្រុង ភ្នំពេញ ពិសេស កំណើន នៃ តម្រូវការ លំនៅឋាន ស្រប ពេល ដែល ដី មិន កើន ។
លោក ឈួរ ឈុន ហួរ បន្ដ ថា ហេតុ ដូចនេះ ទើប ក្រុមហ៊ុន មិង ហួរ ខុនដូ មីនៀម បាន សាងសង់ ជា អគារ ស្នាក់ នៅ រួម ( ខុនដូ ) ដើម្បី ចូលរួម សម្រួល ដល់ ការរស់នៅ ដោយ ប្រើប្រាស់ ដី ទំហំ ដដែល ប៉ុន្តែ សង់ ឡើង ខ្ពស់ អាច ឲ្យ មនុស្ស រស់ នៅ បាន ច្រើន គ្រួសារ ប្រកបដោយ ផាសុកភាព សុវត្ថិភាព និង ភាពងាយស្រួល ។
ទី១៖ ផ្សព្វផ្សាយ អំពី គុណភាព និង សេវា អំពី គម្រោង មិង ហួរ ខុនដូ មីនៀម ដល់ ភ្ញៀវ កិត្តិយស ជា បុគ្គលិក មន្រ្តី រាជការ អាជីវករ ពាណិជ្ជករ និង បងប្អូន ប្រជាពលរដ្ឋ ទូទៅ ដែល មាន បំណង ចង់ មាន ផ្ទះ ជា កម្មសិទ្ធិ ផ្ទាល់ខ្លួន ស្ថិត នៅ ចំ កណ្តាល ទីក្រុង ភ្នំពេញ ។
ទី ២៖ បង្ហាញ អំពី ការចូលរួម លើកកម្ពស់ វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា និង ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ចំពោះ ការអភិវឌ្ឍ វិស័យ អចលន ទ្រព្យ ស្រប តាម ក្របខណ្ឌ យុទ្ធសាស្រ្ត ជាតិ ស្តីពី ការអភិវឌ្ឍ ទីក្រុង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា ក្របខណ្ឌ គោល នយោបាយ និង ក្របខណ្ឌ គតិយុត្ត នានា របស់ ក្រសួង រៀបចំ ដែនដី ដែល បាន រៀបចំ និង ដាក់ ចេញ ជា បន្តបន្ទាប់ ក្នុង គោលបំណង ជំរុញ និង ពង្រឹង ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង និង អភិវឌ្ឍន៍ ប្រកបដោយ ចេរភាព ។
លោក ឈួរ ឈុន ហួរ បាន បញ្ជាក់ ទៀត ថា រហូតមកដល់ ពេលនេះ ក្រុមហ៊ុន បាន សាងសង់ ចប់ ជាន់ ទី២ និង កំពុង បន្ត សាងសង់ ទៅ ជាន់ ទី៣ និង ជាន់ បន្តបន្ទាប់ ទាំង ពីរ ប្រភេទ អគារ ដំណាល គ្នា តែម្តង ។
ជាមួយគ្នា នោះ អគ្គ នាយក ក្រុមហ៊ុន មិង ហួរ គ្រុប ខូអិលធីឌី បាន គូសបញ្ជាក់ ថា ក្រុមហ៊ុន នឹង សាងសង់ អគារ ស្នាក់ នៅ ដែល មាន តំលៃ ចាប់ពី ២ម៉ឺន ដុល្លារ ឡើង ទៅ អាច បង់ រំលួស ត្រឹម ២០០ ដុល្លារ ក្នុង មួយ ខែ មាន ទីតាំង ស្ថិត នៅក្នុង រាជធានី ភ្នំពេញ ជា សំណង់ ដែល មាន គុណភាព សុវត្ថិភាព និង ផាសុកភាព ជួយ សម្រួល ដល់ អតិថិជន ដែល មាន កម្រិត ជីវភាព រស់ នៅ មធ្យម និង បង្គួរ ៕
ទេសរដ្ឋមន្រ្តី ឆាយ ថន ដឹកនាំ គណៈប្រតិភូ ក្រសួង ផែនការ ចុះ សួរសុខទុក្ខ និង ជូន អំណោយ ដល់ កងកម្លាំង នគរបាល ជាតិ សម្ព័ន្ធ មេត្រីភាព វរៈ សេនា តូច លេខ ៣១០ និង លេខ ៨២៣ នៅ តំបន់ សំឡូត
( បាត់ដំបង ) ៖ នា ព្រឹក ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ គណៈប្រតិភូ ក្រសួង ផែនការ ដឹកនាំ ដោយ លោក ឆាយ ថន ទេសរដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ផែនការ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ និង ជូន អំណោយ ដល់ កងកម្លាំង នគរបាល ជាតិ សម្ព័ន្ធ មេត្រីភាព វរៈ សេនា តូច លេខ ៣១០ និង លេខ ៨២៣ នៅ តំបន់ សំឡូត ខេត្ត បាត់ដំបង ដោយ មាន ការទទូល ស្វាគមន៍ ពី លោក ឧត្តមសេនីយ៍ ទោ អ៊ុច សុខុន ស្នងការ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត បាត់ដំបង ផងដែរ ។
ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ប្រទេសជាតិ យើង បាន កំពុងតែ រីកចំរើន លូតលាស់ អភិវឌ្ឍន៍ យ៉ាង ឆាប់រហ័ស អាស្រ័យ ដោយ កត្តា សុខ សន្តិភាព ការដាក់ចេញ នូវ នយោបាយ ឈ្នះ ៗ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង រាជ រដ្ឋាភិបាល កម្ពុជា ក៍ បាន ដាក់ចេញ នូវ កម្មវិធី នយោបាយ កែទម្រង់ ស៊ីជម្រៅ បាន ធ្វើអោយ ព្រះរាជាណាចក្រ កម្ពុជា យើង ដើរ លើ ផ្លូវ ត្រូវ មិន ដូច ជន បុគ្គល និង ក្រុម អគតិ មួយចំនួន និយាយ ឃោសនា ភូត កុហក នោះ ទេ ។ កម្ពុជា ជា ប្រទេស ឯករាជ្យ បូរណភាព ទឹកដី និង មាន និតិរដ្ឋ គ្មាន បរទេស ណា អាច មក បង្គាប់ បញ្ជារ បាន នោះ ទេ ។
លោក ទេសរដ្ឋមន្ត្រី ក៍ បាន ពាំនាំ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង សម្តេច កតិ ព្រឹទ្ធបណ្ឌិត តែងតែ គិតគូរ ជានិច្ច ដល់ សុខ ទុក្ខ ប្រជាពលរដ្ឋ ជាពិសេស កងទ័ព នគរបាល ដែល កំពុង ឈរជើង ការពារ ព្រំដែន យើង ។
លោក ឆាយ ថន ក៍ បាន ឧបត្ថម្ភ ថវិកា ដល់ ២ អង្គភាព ដោយ ១ អង្គភាព ចំនួន ៤លាន រៀល នគរបាល ចំនួន ៣១០ នាក់ មួយ នាក់ ៣ ម៉ឹន រៀល ត្រី ងៀត ៣៦០ គីឡូក្រាម មី ៣៦០ កេស តូច និង ឧបត្ថម្ភ អធិការ នគរបាល ស្រុក សំឡូត ចំនួន ១លាន រៀល ផងដែរ ។
គួរ បញ្ជាក់ ថា នេះ ជា លើក ទី ២១ ហើយ ដែល គណៈប្រតិភូ ក្រសួង ផែនការ បាន នាំយក អំណោយ ជូន អង្គភាព ទាំង ពីរ ។
អ៊ីអន ប្រកាស សាងសង់ ផ្សារ ទំនើប ទី បី របស់ ខ្លួន នៅក្នុង ទីក្រុង អាយ អិន ជី
ការប្រកាស អំពី ទីតាំង ផ្សារ ទំនើប ទី បី នេះ កើតមាន បន្ទាប់ពី ក្រុមហ៊ុន បាន ទទួល ជោគជ័យ ក្នុង ការបើកឲ្យ ដំណើរការ នូវ ផ្សារ ទំនើប អ៊ីអន ម៉ល សែន សុខ ស៊ីធី កាលពី ខែមិថុនា កន្លងទៅ ហើយ ផ្សារ ទំនើប អ៊ីអន ម៉ល ទី បី គ្រោង នឹង បើក ទ្វារ ដំណើរការ នៅ ឆ្នាំ ២០២៣ ខាងមុខ នេះ ។
គម្រោង ផ្សារ ទំនើប អ៊ីអន ម៉ល ទី បី នឹង គ្របដណ្ដប់ លើ ផ្ទៃដី ទំហំ ១៨ ហិកតា ហើយ គម្រោង នេះ ត្រូវបាន ដាក់ចេញ បន្ទាប់ពី អ៊ីអន បាន សម្ពោធ បើក ឲ្យ ដំណើរការ ផ្សារ ទំនើប ដំបូង គេ របស់ ខ្លួន កាលពី ឆ្នាំ ២០១៤ ដែល កាល នោះ ជា ផ្សារ ទំនើប ធំ ជាង គេ បំផុត នៅ កម្ពុជា ។
ក្នុង នោះ ហាង ទំនិញ និង ភោជនីយដ្ឋាន ផ្សេង ៗ កន្លែង បោះ ប៊ូលីង រោង ភាពយន្ត ក៏ ដូចជា លាន លេង ស្គី ទឹកកក របស់ ផ្សារ អ៊ីអន ម៉ល ទី មួយ សុទ្ធតែ បាន នាំមក នូវ ប្រណីតភាព និង ផាសុកភាព សម្រាប់ ប្រជាជន កម្ពុជា ដូចគ្នា នឹង ផ្សារ ទំនើប ដែល មាន នៅ ទីក្រុង បាងកក សិង្ហបុរី ឬ ប្រទេស លោក ខាងលិច ផងដែរ ។
ក្រុមហ៊ុន អ៊ីអន មាន បំណង សាងសង់ ផ្សារ ទំនើប ថ្មី នៅលើ ទីតាំង ទី បី របស់ ខ្លួន ក្នុង រាជធានី ភ្នំពេញ ឲ្យ មាន ភាពជោគជ័យ ដូច ផ្សារ ទំនើប របស់ ខ្លួន មុន ៗ ដែរ ដោយ ប្រើប្រាស់ បទពិសោធន៍ របស់ ខ្លួន ក្នុង ការប្រមូលផ្ដុំ នូវ ហាង ទំនិញ លក់ រាយ ផ្សេង ៗ នៅក្នុង ប្រទេស កម្ពុជា ។
ទន្ទឹមនឹង នេះ ក្រុមហ៊ុន បាន មើលឃើញ ថា ការលូតលាស់ នៅ ភាគ ខាងត្បូង រាជធានី ភ្នំពេញ នេះ ហើយ ដែល ជា កត្តា ជំរុញ ទឹកចិត្ត ពិសេស ឲ្យ មាន ការសាងសង់ ផ្សារ ទំនើប នេះ ឡើង ។
ការអភិវឌ្ឍន៍ ទីក្រុង អាយ អិន ជី (ING City) មាន បួន ដំណាក់កាល ដែល ស្រប តាម ប្លង់ គោល អភិវឌ្ឍន៍ រាជធានី ភ្នំពេញ ឆ្នាំ ២០៣៥ ជា ប្លង់ គោល មាន ភាពស៊ីសង្វាក់ គ្នា ជាមួយនឹង គោលបំណង របស់ ក្រុមហ៊ុន អាយ អិន ជី ដែល តែង ចង់ លើកកម្ពស់ ស្ថានភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ ខណៈ ដែល រាជធានី មួយ នេះ បន្ត ពង្រីក និង អភិវឌ្ឍ ខ្លួន ជាលំដាប់ ។
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ បាន រៀបចំ ការប្រកួត អង្ករ ដែល មាន គុណភាព ល្អ ជាង គេ ប្រចាំ ឆ្នាំ ២០១៨ តាម ប្រភេទ អង្ករ ស អង្ករ ក្រអូប និង អង្ករ ក្រអូប ប្រណីត ក្រោម អធិបតីភាព របស់ លោក ឧកញ៉ា វង្ស ប៊ុនហេង អនុប្រធាន សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា តំណាង លោក សុខ ពុទ្ធី វុធ ប្រធាន សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ។
ការប្រកួត នេះ មាន ការដាក់ សំណាក អង្ករ ចូលរួម ប្រកួត ពី វិទ្យាស្ថាន កាឌី និង សមាជិក សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ដែល ជា សហគមន៍ កសិកម្ម រោង ម៉ាស៊ីន កិន ស្រូវ និង អ្នកនាំចេញ ចំនួន ២២ និង មាន សំណាក អង្ករ សរុប ចំនួន ២៨ ។ សម្រាប់ ការវាយតម្លៃ ផ្តោត លើ លក្ខណៈ សម្បត្តិ អង្ករ នៅ មុនពេល ចម្អិន ( សពោះ ភាព បាក់ ទំហំ ពណ៌ ) និង ក្រោយ ចម្អិន ( ភាពភ្លឺ រលោង ភាព ស្អិត រមួត រសជាតិ ក្លិន ភាពងាយ ក្នុង ការបរិភោគ ) ។
ជា លទ្ធផល នៃ ការប្រកួត អង្ករ ដែល បាន ជាប់ ចំណាត់ថ្នាក់ លេខ ១ សម្រាប់៖
ក្នុង ឱកាស អញ្ជើញ កាន់ បិណ្ឌ នេះ លោក លឹម ជា វុត្ថា បាន នាំយក ចង្ហាន់ និង ទេយ្យ ទាន មួយចំនួន ទៅ ប្រគេន ព្រះសង្ឃ ដើម្បី ឧទ្ទិស ទៅដល់ វិញ្ញាណក្ខន្ធ ជីដូន ជីតា និង បុព្វការី ជន ដែល បាន ចែក ឋាន ទៅ តាម ប្រពៃណី សាសនា ខ្មែរ ។
ខ្ញុំបាទ លឹម ជា វុត្ថា ក៏ សូម លើក ដៃ ប្រណម បួងសួង ដល់ បុណ្យ គុណ ព្រះរតនត្រ័យ វត្ថុ ស័ក្តិសិទ្ធ ក្នុង លោក ទេវតា ថែរក្សា ចក្រវាឡ យើង នេះ តាម ជួយ អភិបាល ប្រោស ព្រំ ដល់ ថ្នាក់ដឹកនាំ ជាតិ កម្ពុជា ដៃគូ ពាណិជ្ជកម្ម និង ជន រួម ជាតិ ខ្មែរ ទាំងអស់ បាន ជួប តែ សេចក្តីសុខ សេចក្តី ចម្រើន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង កាយ មាំ មួន សម្រេច រាល់ ភារកិច្ច ដែល ប៉ងប្រាថ្នា ជាពិសេស គ្រប់ ដំណើរ ទៅកាន់ ទីកន្លែង នានា បាន ជួប តែ សុខ សុវត្ថិភាព និង ពោរពេញ ដោយ ភាពសប្បាយរីករាយ ៕
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ សិស្សសាលា អន្តរជាតិ អេស អាយ អេស (SIS) ចំនួន ១៥៥ នាក់ បាន ទទួល ការបណ្តុះបណ្តាល ចំណេះដឹង មូលដ្ឋាន អំពី សុវត្ថិភាព ម្ហូប អាហារ ពី មន្ត្រី ជំនាញ កាំ កុងត្រូល សាខា ផែ ស្ងួត ចុង ទី - ភ្នំពេញ ។ មន្ត្រី កាំ កុងត្រូល ចុះ ផ្សព្វផ្សាយ អប់រំ ស្តីពី សុវត្ថិភាព ចំណីអាហារ ដល់ សិស្សសាលា ក្នុង ខណៈពេល ដែល ប្រជាពលរដ្ឋ ច្រើន ជាង ៦០០ លាន នាក់ ឈឺ និង ច្រើន ជាង ៤២ ម៉ឺន នាក់ បាន ស្លាប់ ដោយសារ អាហារ មិន មាន សុវត្ថិភាព ក្នុង មួយ ឆ្នាំ ៗ នៅលើ ពិភពលោក នេះ ។
លោក ខៀវ បញ្ញា វឌ្ឍន៍ គ្រូបង្គោល សុវត្ថិភាព ចំណីអាហារ នៃ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល ក្រសួង ពាណិជ្ជកម្ម បាន ឲ្យដឹង ថា ក្រុមការងារ របស់ លោក តែងតែ ចុះ អប់រំ ដល់ ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន សិស្សសាលា តាម គ្រឹះស្ថាន សាធារណៈ អាជីវករ តាម ទីផ្សារ នានា ដើម្បី ណែនាំ ពួកគាត់ ឲ្យ យល់ដឹង អំពី របៀប នៃ កាជ្រើសរើស ម្ហូប អាហារ ការថែរក្សាទុក ការចម្អិន និង ពន្យល់ ពួកគាត់ អំពី ការប្រើប្រាស់ សារធាតុ គីមី ហាមឃាត់ លើ ម្ហូប អាហារ ដែល ជះឥទ្ធិពល អាក្រក់ ដល់ សុខភាព អ្នកប្រើប្រាស់ ។
អគ្គ នាយកដ្ឋាន កាំកុងត្រូល បាន និង កំពុង ធ្វើ សកម្មភាព យ៉ាង ពុះកញ្ជ្រោល ក្នុង រយៈកាល រដូវ បុណ្យ ភ្ជុំ បិណ្ឌ នេះ នៅលើ ទីផ្សារ ទូទាំង ប្រទេស ដែល ម្ហូប អាហារ ត្រូវបាន ប្រើប្រាស់ យ៉ាង គំហុក ដើម្បី ធានា បាន នូវ សុខភាព និង សុខភាព ជូន ប្រជាពលរដ្ឋ ។
ក្រុមហ៊ុន « ឃ្យុង ធាវី សម្អាត ប៉ោយប៉ែត » ចេញ សេចក្តី បំភ្លឺ ពាក់ព័ន្ធ នឹង ការប្រមូល សំរាម នៅ ក្រុង ប៉ោយប៉ែត
( ភ្នំពេញ ) ៖ នាយក គ្រប់គ្រង ក្រុមហ៊ុន « ឃ្យុង ធាវី សម្អាត ប៉ោយប៉ែត » លោកស្រី សារឿន សោភា នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ ចេញ សេចក្តី បំភ្លឺ ពាក់ព័ន្ធ នឹង ការប្រមូល សំរាម នៅ ក្រុង ប៉ោយប៉ែត ។
លោក អុិត សំហេង សំណេះសំណាល និង រៀបចំ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ជូន ពលករ កម្ពុជា នៅ ថៃ
( ថៃ )៖ លោក អុិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង គណៈប្រតិភូ រួម ជាមួយនិង មន្រ្តី ស្ថានទូត កម្ពុជា ប្រចាំ នៅ ប្រទេស ថៃ និង អាជ្ញាធរដែនដី របស់ ប្រទេស ថៃ នា ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន រៀបចំ ពិធី បុណ្យ ភ្ជុំ បិណ្យ ជូន ដល់ ពលករ ពាណិជ្ជករ និស្សិត កម្ពុជា ជាង ៧ពាន់ នាក់ ដែល ប្រព្រឹត្តទៅ នៅ វត្ត ស៊ីសុដា រាម សង្កាត់ បាឃុននន្ទ ខណ្ឌ បាងកក ប្រទេស ថៃ ។
ក្នុង ឱកាស នេះ លោក រដ្ឋមន្រ្តី បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ព្រមទាំង ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ជានិច្ចកាល បាន គិតគូរ ចំពោះ សុខ ទុក្ខ និង ការរស់នៅ របស់ ពលករ ពាណិជ្ជករ និង និស្សិត ដែល កំពុង ស្នាក់ នៅ និង ធ្វើការ នៅក្នុង ប្រទេស ថៃ ទាំងអស់ ជាដារាប រៀង មក ។
លោក អុិត សំហេង បាន ថ្លែងអំណរ អរ ព្រះគុណ និង អរគុណ គណៈកម្មការ វត្ត សមាគម ខេមរនិស្សិត សមាគម មិត្តភាព កម្ពុជា ថៃ អាជ្ញាធរ ថៃ ដែល បាន បង្ក លក្ខណៈ ជូន បងប្អូន ខ្មែរ រៀបចំ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ តាម គន្លង ប្រពៃណី ហើយ ដែល ពិធី បុណ្យ នេះ ជា បុណ្យ ប្រពៃណី ខ្មែរ ដែល តែងតែ ជួបជុំ គ្រួសារ ធ្វើ ពិធី ដាក់ បិណ្ឌ ឧទ្ទិស កុសល ជូន ដល់ បុព្វការី ជន ដែល បាន ចែក ឋាន ទៅកាន់ សុគតិភព ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ដល់ ជា ពលករ ពាណិជ្ជករ និង និសិស្សិត ដែល កំពុង ស្នាក់ នៅ និង ធ្វើការ នៅក្នុង ប្រទេស ថៃ ថា ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ នេះ ប្រព្រឹត្តទៅ ក្នុង បរិយាកាស ល្អ ដោយ រាជ រដ្ឋាភិបាល បាន សម្រួល ដល់ ប្រជាពលរដ្ឋ ទៅ ធ្វើ បុណ្យ បាន ឈប់ បី ថ្ងៃ បើក ប្រាក់ខែ មុន ពិធី បុណ្យ និង ផ្ដល់ ឡានក្រុង រថភ្លើង ជិះ មិន បង់ប្រាក់ ក្នុង ឱកាស ទៅ លេង ស្រុក កំណើត ផង ។
រាជ រដ្ឋាភិបាល បាន បន្ត អនុវត្ត គោល នយោបាយ ផ្ដល់ ឱកាស ជូន បងប្អូន ប្រជាពលរដ្ឋ រក ការងារ ដែល ពេញចិត្ត នៅ ក្រៅ ប្រទេស ជាពិសេស បងប្អូន ពលករ ខ្មែរ នៅ ថៃ ដែល បាន រក បាន ការងារ ស្រប ច្បាប់ ត ស៊ូ រក ចំណូល ផ្ដល់ជូន គ្រួសារ ជា ពលរដ្ឋ ខ្មែរ ដ៏ ឆ្នើម ដែល មាន ទឹកចិត្ត ស្នេហាជាតិ មាតុភូមិ តាមរយៈ ការងារ បងប្អូន បាន ផ្ញើ ប្រាក់ គ្រួសារ វិញ សរុប ប្រមាណ ជា២ ពាន់ លាន ដុល្លារ ក្នុង មួយ ឆ្នាំ ដែល នេះ ក៏ បាន រួមចំនែក មួយ យ៉ាង សំខាន់ ក្នុង ការចូលរួម អភិវឌ្ឍន៍ សេដ្ឋកិច្ច ជាតិ ផងដែរ ។
លោក បាន បញ្ជាក់ បន្ត ថា ដើម្បី ការពារ រក្សា ការងារ និង ប្រាក់ ចំណូល របស់ កម្ពុជា នឹង បន្ត កិច្ចសហប្រតិបត្តិការ លើ វិសយ័ការងារ និង ពលកម្ម រវាង ប្រទេស ទាំង ពីរ គឺ ៤ឆ្នាំ កន្លងទៅ កម្ពុជា - ថៃ បាន សម្រេច ជោគជ័យ ក្នុង ការដោះស្រាយ បញ្ហា ពលករ ពិសេស ការផ្ដល់ ភាពស្រប ច្បាប់ ជូន បងប្អូន ជាង កន្លះ លាន នាក់ មកទល់ ពេលនេះ បងប្អូន នៅ ថៃ មាន ១លាន ៨ម៉ឺន នាក់ សុទ្ធតែ ស្រប ច្បាប់ ទាំងអស់ ។
នៅក្នុង ឱកាស នេះ ដែរ លោក អុិត សំហេង រដ្ឋមន្រ្តី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជា ជិវៈ ក៏ បាន អំពាវនាវ ដល់ បងប្អូន រស់ នៅ និង ធ្វើ ការ ដោយ គោរព ច្បាប់ រក្សា សាមគ្គីភាព រវាង ខ្មែរ និង ខ្មែរ រវាង ខ្មែរ និង ថៃ រស់ នៅក្នុង ភាពសប្បាយរីករាយ ក្នុង សហគមន៍ និង តាម កន្លែង ធ្វើការ គិតគូរ ពី បញ្ហា សុខភាព ជា ចម្បង និង ឆ្លៀត ពេល ទៅ លេង ស្រុក កំណើត នៅក្នុង ឱកាស បុណ្យ ទាន និង ថ្ងៃ ឈប់ម្រាក ផងដែរ ។
រៀងរាល់ ពេលព្រឹក ព្រលឹម ថ្ងៃ កាន់ បិណ្ឌ ទី១ រហូតដល់ ថ្ងៃ ភ្ជុំ បិណ្ឌ ឬ ភ្ជុំ ធំ ( ចាប់ផ្តើម ពី ថ្ងៃ ១រោច ដល់ ១៥រោច ខែ ភទ្របទ ) គេ តែង បាន ឮ ព្រះសង្ឃ សូត្រ ធម៌ ដែល គេ ហៅ ថា បរាភវ សូត្រ ។ បរាភវ សូត្រ គឺជាធម៌ របស់ សម្មាសម្ពុទ្ធ ដាស់តឿន ដល់ ប្រជាពុទ្ធ បរិស័ទ នូវ មូលហេតុ ១២ ប្រការនាំ ដល់ ក្តី វិនាស ក្នុង ជីវិត រស់ នៅ ប្រចាំ ថ្ងៃ ។
ធម៌ បង្ហាញ ក្តី វិនាស ទាំង ១២ប្រការ នេះ ត្រូវបាន ព្រះសង្ឃ ជា សាវ័ក របស់ សម្មាសម្ពុទ្ធ មាន សង្ឃ ដីកា ថា ប្រសិនបើ ប្រជាពុទ្ធ បរិស័ទ ស្តាប់ ហើយ ពិចារណា នឹង ធ្វើឲ្យ ជីវិត កាន់តែ ប្រសើរ និង ចៀស ផុត ពី ក្តី វិនាស ទាំងឡាយ ទទួលបាន នូវ សេចក្តីសុខ កិត្តិយស និង កេរ្តិ៍ឈ្មោះ ល្អ ក្នុង សង្គម … ។
សេចក្តីស្រឡាញ់ ពេញចិត្ត គំនិត ហើយ ទៅ គប់ ពិត អសប្បុរស
អ្នក ខ្ជិលច្រអូស មិន មាន ខ្នះ ខ្នែង ខឹង ច្រើន សម្តែង ឱ្យ គេ ឃើញ បាន ។
ក្តី វិនាស នេះ បើ រាប់ សង្គ្រោះ វិនាស នោះ ឈ្មោះ ទី៦ ទាន់ហន់ ។
វិនាស ទី ៩អ្វី ជា ប្រធាន នាំ សត្វ ឱ្យ មាន សេចក្តីវិនាស ។
ប្រុស មិន ត្រេកអរ នឹង ប្រពន្ធ ខ្លួន ហើយ ទៅជាប់ ចួន នឹង ស្រី ពេស្យា
ជន ណា កើត ក្នុង ត្រកូល ជាក្សត្រ អ្នកក្សត់ សម្បត្តិ ហើយ ប្រាថ្នា ធំ
ឯ តេ បរាភ វេ លោកេ បណ្ឌិតោ សម វេក្ខិយ អរិយ ទស្សន សម្បន្នោ ស លោកំ ភជតេ សិវំ ៕
តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក មាន ទីតាំង ស្ថិត នៅក្នុង ភូមិ សំបូរ ឃុំ សំបូរ ស្រុក ប្រាសាទ សំបូរ ខេត្ត កំពង់ធំ ។ អាច និយាយ បាន ថា តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក នេះ មាន ទីតាំង ស្ថិត នៅ ចំ កណ្ដាល ប្រទេស កម្ពុជា តែម្ដង ។
រមណីយដ្ឋាន តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក ជា រាជធានី ខ្មែរ សម័យ ចេនឡា មាន ឈ្មោះ ថា « ឥសាន បុរៈ គឺ មាន ន័យ ថា ទីក្រុង របស់ ព្រះឥសូរ ឬ ព្រះសិវៈ » ដែល ត្រូវបាន កសាងឡើង នៅ ចុង សតវត្ស ទី៦ និង ដើម សតវត្ស ទី ៧ នៃ គ្រិស្ត សករាជ ពោលគឺ នៅ អំឡុង រជ្ជកាល ព្រះបាទ ឥសាន វរ្ម័នទី១ ដើម្បី ឧទ្ទិស ថ្វាយ ដល់ ព្រះសិវៈ ឬ ព្រះឥសូរ ពីព្រោះ សម័យ នោះ រាជធានី ឥសាន បុរៈ នេះ ក៏ ជា មជ្ឈមណ្ឌល នៃ ព្រហ្មញ្ញ សាសនា ដ៏ ធំ មួយ នៅក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ ផងដែរ ។
រមណីយដ្ឋាន តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក ត្រូវបាន ចែកចេញ ជា ៤ក្រុម ធំ ៗ គឺ ក្រុម ប្រាសាទ ខាងជើង ក្រុម ប្រាសាទ កណ្តាល ក្រុម ប្រាសាទ ខាងត្បូង និង ក្រុម ប្រាសាទ ក្រោល រមាស ដែល ក្រុម ប្រាសាទ នីមួយ ៗ សុទ្ធតែ សាងសង់ ឡើង អំពី ឥដ្ឋ តាន់ និង ថ្ម បាយ ក្រៀម ក្នុង ទម្រង់ ជា រចនាសម្ពន្ធ ។
បន្ទាប់ពី ត្រូវបាន ចុះ ក្នុង បញ្ជីសម្បត្តិ បេតិកភណ្ឌ ពិភពលោក រួច មក រមណីយដ្ឋាន វប្បធម៌ ប្រវត្តិសាស្ត្រ មួយ នេះ បាន រីក មុខ រីក មាត់ ថ្មី ជាមួយនឹង ការទទួលបាន ភ្ញៀវ ទេសចរ ជាច្រើន ម៉ឺន នាក់ ។ ក្នុង នោះ លោក សេង អាន ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត កំពង់ធំ បាន ឱ្យដឹង ថា តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក កាន់តែ ត្រូវបាន គេ ស្គាល់ និង មក ទស្សនា កាន់តែ ច្រើន ឡើង ៗ ៕ មេ ប៉ូលិស អន្តរជាតិ Interpol ត្រូវ អាជ្ញាធរ ចិន ចាប់ខ្លួន និង សួរចម្លើយ ខណៈ មិន ទាន់ មាន ព័ត៌មាន ពី ការដោះលែង !
ទីបំផុត មនុស្ស ដែល លោក ដូណាល់ ត្រាំ លើកស្ទួ យ ស្បថ ឡើង កាន់ តំណែង ប្រធាន តុលាការ កំពូល អាមេរិក ជា ផ្លូវការ ហើយ !
យប់ មិញ មិន មាន អ្នក ជិះ បញ្ច្រាស នៅ ជុំវិញ វិមាន ឯករាជ្យ នោះ ទេ
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ មិន មាន នោះ ទេ នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ ខណៈ ដែល សមត្ថកិច្ច បាន ឃាត់ យានយន្ត ជា បន្តបន្ទាប់ រាល់ ថ្ងៃ តែម្តង ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា ចាប់ពី ម៉ោង ០៧: ០០នាទី ដល់ ម៉ោង ២២:០០ នាទី ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្រ្ចាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ។
ជា លទ្ធផល សមត្ថកិច្ច មិន បាន ធ្វើ ការឃាត់ យានយន្ត នោះ ទេ ៕
ហាង នំបុ័ង ប្រ៊េ ដថក ប្រារព្ធ ខួប៤ ឆ្នាំ ដោយ ផ្តល់ កម្មវិធី ពិសេស និង រក្សា ការបរិច្ចាគ ថវិកា ៣% ពី ការលក់ ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា
( ភ្នំពេញ ) ៖ ហាង នំបុ័ង ប្រ៊េ ដថក បាន ប្រារព្ធ ធ្វើ ខួប៤ឆ្នាំ នៃ ការបង្កើត ហាង នំប៉័ង ស្តង់ដារ សុង្ហបុរី របស់ ខ្លួន នៅ ផ្សារ ទំនើប អ៊ីអន ម៉ល សែន សុខ ។
ជាមួយនឹង ខួប ៤ឆ្នាំ នេះ ប្រ៊េ ដថក នៅ ថ្ងៃទី ៥ខែតុលា ឆ្នាំ ២០១៨ ដោយ មាន កម្មវិធី ប្រូម៉ូសិន ជាច្រើន ដូចជា ទិញ ៥ថែម ប្រាំ និង នំ ថ្មី ខាប់ ខេក ព្រមទាំង មាន ការប្រកួត ហូប នំប៉័ង យក រង្វាន់ និង ការសម្តែង ពី ក្រុម ក្មេង ខ្មែរ ដែល ញាំង អោយ បរុយាកាស កាន់តែ រីករាយ ។
លើស ពី នោះ ប្រ៊េ ដថក នៅតែ រក្សា ការបរិច្ចាគ ថវិកា ៣% ពី ការលក់ ភេសជ្ជៈ ប្រភេទ ២២អោន របស់ ខ្លួន ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ក្នុង ការបន្ត កិច្ច ប្រតិបត្តិការ ដើម្បី ជួយសង្គ្រោះ ជីវិត កុមារ កម្ពុជា រាប់ លាន នាក់ ។ ការបរិច្ចាក នេះ បាន បង្ហាញ ឲ្យ ឃើញ ពី ទឹកចិត្ត របស់ ប្រេត ថក ក្នុង ការជួយគាំទ្រ ដល់ ការលើកកម្ពស់ សុខភាព របស់ កុមារ ។
លោក ប៊ុន យី ប្រធាន ចាត់ការ ទូទៅ នៃ ហាង នំបុ័ង ប្រ៊េ ដថក បាន ថ្លែង ថា រហូតមកដល់ ពេលនេះ ប្រ៊េ ដថក បាន បង្កើត បាន ៩ ហាង ហើយ ក្នុង នោះ ឆ្នាំ ២០១៨ នេះ បង្កើត បាន ២ហាង ។ ការកើនឡើង យ៉ាង ឆាប់រហ័ស នូវ ចំនួន ហាង នំប៉័ង ប្រ៊េត ថក នេះ ដោយសារ តម្រូវការ ទីផ្សារ ខ្ពស់ ការកើនឡើង នូវ ទម្លាប់ ពិសារ នំប៉័ង របស់ ប្រជាពលរដ្ឋ ខ្មែរ និង ការកើនឡើង នូវ ជីវភាព ធូរធារ ជាពិសេស ការរីកលូតលាស់ ផ្នែក សេដ្ឋកិច្ច ។
លោក បាន បញ្ជាក់ ថា នៅ ឆ្នាំ ក្រោយ និង នៅពេល អនាគត ឆាប់ ៗ ប្រ៊េ ដថ ក នឹង បន្ត ពង្រីក ហាង ជាច្រើន ទៀត ដើម្បី បំពេញ សេចក្តីការ របស់ ប្រជាពលរដ្ឋ ជាពិសេស នៅតែ បន្ត ការបរិច្ចាគ ថវិកា ៣% ពី ការលក់ ភេសជ្ជៈ ប្រភេទ ២២អោន របស់ ខ្លួន ដល់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ដើម្បី អាច ឱ្យ មន្ទីរពេទ្យ ទេវតា នេះ ជួយ សង្រ្គោះ កុមារ កម្ពុជា មាន ជំងឺ រាប់ លាន នាក់ ដែល កំពុង រង់ចាំ ការព្យាបាល ។
លោក ប៊ុន យី សង្ឃឹម ថា « ខ្មែរ យើង នឹង រួមគ្នា ចែករំលែក ក្ដី ស្រលាញ់ និង ការជួយគ្នា ទៅ វិញ ទៅវិញ មក ដើម្បី ការបង្កើត បរិយាកាស ការរស់នៅ ជាមួយ ប្រជាជន កម្ពុជា យើង កាន់តែ ប្រសើរ ពិសេស ជួយសង្គ្រោះ ជីវិត កុមារ កម្ពុជា តែម្ដង » ។
( ភ្នំពេញ ) ៖ លោក ម៉េត មាស ភក្តី អ្នកនាំពាក្យ សាលា រាជធានី ភ្នំពេញ បាន ប្រាប់ Fresh News ឲ្យដឹង ថា នៅ ព្រឹក ព្រលឹម ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០១៨ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ រួមទាំង មន្ត្រី ក្រោម ឱវាទ បាន ចុះ ទៅ ពិនិត្យ ផ្ទាល់ និង ជូន ដំណើរ ចំពោះ ប្រជាពលរដ្ឋ ដែល ជិះ រថយន្តក្រុង សាធារណៈ ទៅ លេង ស្រុក កំណើត នៅ ចំណត សួនច្បារ ឬស្សីកែវ ដែល មាន ទីតាំង ស្ថិត នៅ ភូមិ ដើម គរ សង្កាត់ ជ្រោយចង្វារ ខណ្ឌ ឬស្សីកែវ ។
អ្នកនាំពាក្យ រូប នេះ បាន ឲ្យដឹង ទៀត ថា មាន ប្រជាពលរដ្ឋ កម្មករ - កម្ម ការិនី និង អ្នកដំណើរ យ៉ាង ច្រើន បាន មក ជិះ រថយន្តក្រុង សាធារណៈ ដោយ ឥត បង់ ប្រាក់ នៅ ចំណត មួយ នេះ ។ លោក បន្ត ថា ពួកគាត់ ទាំងអស់ គ្នា បាន បង្ហាញ ទឹកមុខ សប្បាយរីករាយ និង សម្តែង ការថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន ផ្តល់ កាដូ ដ៏ មាន តម្លៃ នេះ ផងដែរ ។
សូម ជម្រាប ថា ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ពី រាជធានី ភ្នំពេញ ទៅ ខេត្ត នានា ក៏ ដូចជា ត្រឡប់ ពី ខេត្ត នានា ត្រឡប់មក រាជធានី ភ្នំពេញ វិញ ឱ្យ មាន លក្ខណៈ ល្អ ប្រសើរ នោះ នៅក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជា ឱ្យ សាលា រាជធានី ភ្នំពេញ បញ្ចេញ រថយន្តក្រុង សាធារណៈ ១២០ គ្រឿង ដើម្បី ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ទៅ មក មិន គិត ថ្លៃ រយៈពេល ៦ ថ្ងៃ នៅក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។
