( ភ្នំពេញ ) ៖ មន្រ្តី នគរបាល ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ នៅ រសៀល ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ថា មេ ខ្លោង ២នាក់ ទៀត ដែល ពាក់ព័ន្ធ ជួញដូរ អាវុធ ខុស ច្បាប់ ចង់ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ត្រូវបាន កម្លាំង នគរបាល នាយកដ្ឋាន ប្រឆាំង ភេរវកម្ម និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន សហការ ជាមួយ នគរបាល ខេត្ត ប៉ៃលិន ចាប់ខ្លួន នៅ ខេត្ត ប៉ៃលិន ។
មន្រ្តី នគរបាល រូប នេះ បាន បញ្ជាក់ ទៀត ថា ជនសង្ស័យ ទាំង ២នាក់ ដែល ជា មនុស្ស សំខាន់ ផងដែរ នោះ ត្រូវបាន ចាប់ខ្លួន នៅ ខេត្ត ប៉ៃលិន កាលពី ថ្ងៃ ម្សិលមិញ រួច ត្រូវបាន បញ្ជូន មកកាន់ ក្រសួង មហាផ្ទៃ នា យប់ មិញ នេះ ។ នៅ រសៀល ថ្ងៃ នេះ ជនសង្ស័យ ទាំង ២នាក់ នឹង ត្រូវបាន បញ្ជូន ទៅកាន់ តុលាការ ដើម្បី ចាត់ការ តាម ច្បាប់ ។ ដូច្នេះ មនុស្ស ចំនួន ១១នាក់ ហើយ ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន ពាក់ព័ន្ធ ការជួញដូរ អាវុធ ខុស ច្បាប់ មាន បំណង ចង់ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ។
គួរ ជម្រាប ថា យ៉ាងណាមិញ ជន ត្រូវ ចោទ ទាំងអស់ សុទ្ធ មាន លំនៅឋាន ក្នុង ប្រទេស រុស្ស៉ី ដូច្នេះហើយ វា មាន លទ្ធភាព តិចតួច ប៉ុណ្ណោះ ដែល ថា សហរដ្ឋ អាមេរិក នឹង មាន ឱកាស ចាប់ខ្លួន ក្រុម ជន ទាំងនោះ ៕ អ្នកកាសែត និង អ្នក រត់ ម៉ូតូ ឌុប សរុប ២នាក់ យក ឈ្មោះ ថ្នាក់ដឹកនាំ ខេត្ត សៀមរាប ដើរ ទារ លុយ តាម អាជីវកម្ម ក្នុង ខេត្ត ទីបំផុត ត្រូវ ជាប់ ក្នុង ដៃ កម្លាំង សមត្ថកិច្ច (Video inside)
( សៀមរាប ) ៖ កម្លាំង សមត្ថកិច្ច ផែនការងារ សន្តិសុខ នគរបាល ខេត្ត សៀមរាប បាន ឃាត់ខ្លួន ជនសង្ស័យ ជា អ្នកកាសែត និង អ្នក រត់ ម៉ូតូ ឌុប ចំនួន ២នាក់ ដែល យក ឈ្មោះ ថ្នាក់ដឹកនាំ រដ្ឋបាល ខេត្ត សៀមរាប ដើរ ទារ លុយ តាម អាជីវកម្ម ក្នុង ខេត្ត ។
លោក ស្នងការ រង បាន បញ្ជាក់ ប្រាប់ បណ្ដាញ អង្គភាព Fresh News ថា ដែល កំពុង ធ្វើ សកម្មភាព យក ឈ្មោះ លោក ធូ ចន្តុល ជា មន្ត្រី នៃ ការិអន្តរ វិស័យ របស់ សាលា ខេត្ត សៀមរាប បាន កុហក បោកប្រាស់ ប្រជាពលរដ្ឋ ដែល ជា ម្ចាស់ អាជីវកម្ម ជាច្រើន ក្នុង ខេត្ត សៀមរាប ថា លោក ធូ ចន្តុល ឱ្យ យមក យក ស្រាបៀរ ដើម្បី យក ទៅ ជប់លៀង នៅ សាលា ខេត្ត សៀមរាប ពេល នោះ អាជីវករ ដែល បើក អាជីវកម្ម ផ្សេង ៗ បាន ប្រគល់ ស្រាបៀរ សរុប ចំនួន ៤កន្លែង បាន ចំនួន ៧កេះ ទៅ ជនសង្ស័យ ខាងលើ ។
លោក បន្ថែម ថា ក្រោយពី ធ្វើ សកម្មភាព លើក ចុងក្រោយ ក៏ ត្រូវ ប្រជាពលរដ្ឋ រាយ ការ ណ៏ ប្តឹង មក សមត្ថកិច្ច ហើយក៏ ចុះ ទៅ ស្រាវជ្រាវ ភ្លាម លុះ រហូតដល់ ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៨ វេលា ម៉ោង ១៦៖៣០ នាទី ត្រូវបាន កម្លាំង នគរបាល ខេត្ត សៀមរាប ដែល ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ហួត សុធី ស្នងការ រង ទទួល ផែនការងារ សន្តិសុខ ឃាត់ខ្លួន ជនសង្ស័យ ទាំង ពីរ យកមក ធ្វើ ការសាកសួរ ។
ក្រោយពី សមត្ថកិច្ច ធ្វើ ការសួរនាំសង្ស័យ ទាំង ពីរ បាន ឆ្លើយ សារភាព ថា រូប គេ ទាំង ពីរ ពិតជា បាន យក ឈ្មោះ លោក ធូ ចន្តុល ជា មន្ត្រី សាលា ខេត្ត សៀមរាប ទៅ កុហក អាជីវករ លក់ដូរ ដើម្បី យក ស្រាបៀរ ចំនួន ៧កេះ ពិតប្រាកដ មែន ។
ដោយ ជនសង្ស័យ ទំាង ២នាក់ បាន ទទួល សារភាព កំហុស និង បាន សន្សា ថា នឹង ឈប់ ប្រព្រឹត្ត អំពើ ផ្តេសផ្តាស នេះ បន្ត ទៀត ហើយ ដោយ បាន សុំ ការអនុញ្ញាត ពី អភិបាល ខេត្ត កម្លាំង សមត្ថកិច្ច បាន ធ្វើ ការសន្យា និង ព្រមាន ជា លើក ទី១ ហើយ មាន ការធានា ពី ក្រុមគ្រួសារ បាន អោយ ត្រឡាប់ ទៅ ផ្ទះ ៕ មន្រ្តី កាំ កុងត្រូល កំពង់ផែ អន្តរជាតិ ភ្នំពេញ ចុះ រក ទំនិញ ខូច គុណភាព នៅ ផ្សារ ច្បារអំពៅ ផ្សារ បន្លែ ច្បារអំពៅ និង ផ្សារ ព្រែក ឯង . រកឃើញ នំ ស្លឹក ស្រស់ ២គីឡូ នៅ ផ្សារ ព្រែក ឯង និង នំ ម្សៅ ជ្រេ២ គីឡូ នៅ ផ្សារ បន្លែ ច្បា អំពៅ
( ភ្នំពេញ ) ៖ ដើម្បី ការពារ សុវត្ថិភាព ម្ហូប អាហារ ក៏ ដូចជា សុខភាព ប្រជាពលរដ្ឋ និង ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ផង នោះ នៅ ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ មន្ត្រី សាខា កាំ កុងត្រូល កំពង់ផែ អន្តរជាតិ ភ្នំពេញ បាន សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង អាជ្ញាធរដែនដី បាន បន្ត ចុះ ពិនិត្យ ផ្សព្វផ្សាយ អំពី គុណភាព និង សុវត្ថិភាព ម្ហូប អាហារ តាម ផ្ទះ ម៉ាត ផ្សារ ច្បារអំពៅ ផ្សារ បន្លែ ច្បារអំពៅ ផ្សារ ព្រែក ឯង និង ផ្សារ ព្រែក ប្រា ក្នុង ខណ្ឌ ច្បារអំពៅ ។
លោក ប៊ុន ចំរើន ប្រធាន សាខា កាំ កុងត្រូល កំពង់ផែ អន្តរជាតិ ភ្នំពេញ បាន ឲ្យដឹង ថា ដើម្បី ចូលរួម កិច្ចការពារ សុខុមាភាព ប្រជាពលរដ្ឋ ក្នុង ការជួយ ទប់ស្កាត់ ការក្លែងបន្លំ និង ទុច្ចរិតភាព របស់ អ្នកលក់ដូរ ដែល អាជីវករ តែងតែ បន្លំ អីចឹង មន្រ្តី ជំនាញ កាំ កុងត្រូល ដែល ចុះ ពិនិត្យ ឆែក នេះ ក៏ ដូចជា ការដាស់តឿន និង ជំរុញ ឲ្យ មាន ការកែប្រែ ។
លោក បាន បន្ត ថា ឥឡូវនេះ មន្រ្តី ជំនាញ កាំ កុងត្រូល បាន ដាក់ ប្រចាំ ការ នៅ ទីផ្សារ ជារៀងរាល់ ថ្ងៃ ដើម្បី ផ្តល់ ជូន សេវា ត្រួត ពិនិត្យ គុណភាព សុវត្ថិភាព ម្ហូប អាហារ និង បង្ក្រាប ការក្លែងបន្លំ ។ នៅក្នុង ការអង្កេត ទំនិញ នៅលើ ទីផ្សារ ខាងលើ មន្រ្តី សាខា កាំ កុងត្រូល កំពង់ផែ អន្តរជាតិ ភ្នំពេញ បាន ផ្តោត ទៅ លើ ផលិតផល វេចខ្ចប់ ដូចជា ស្លា ដក់ ដែល រដូវ ភ្ជុំ បិណ្ឌ ក្រែង មាន អាជីវករ ខ្លះ មាន គំនិត ខិល ខូច ដាក់ របស់របរ ហួស កាលបរិច្ឆេទ ចូល និង គ្រឿង ភេស្ជ ជៈ ដែល បាន និង កំពុង ដាក់ តាំង លក់ ។
គេ សង្កេតឃើញ ថា ក្នុង ប្រតិបត្តិការ ខាងលើ នេះ គឺ បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា អាជីវករ ផ្សារ បាន សម្តែង នៅ ទឹកចិត្ត រីករាយ នឹង គាំទ្រ ចំពោះ សកម្មភាព របស់ មន្ត្រី កាំ កុងត្រូល ដែល តែង តែ ចុះ ពិនិត្យ ទំនិញ ផ្សេង ៗ រក សារធាត គីមី ដើម្បី ការពារ សុវត្ថិភាព ម្ហូប អាហារ ក៏ ដូចជា ការពារ សុខភាព របស់ ពួកគាត់ ផងដែរ ៕
ក្រុមគ្រួសារ សព លោក នៃ ប៉េណា ថ្លែងអំណរគុណ ដល់ ថ្នាក់ដឹកនាំ និង ញាតិមិត្ត ទាំងអស់ ដែល បាន ចូលរួម ពិធី បុណ្យ សព
( ភ្នំពេញ ) ៖ លោក នៃ គង់ ដែល ត្រូវ ជា កូន ជំនួស មុខ ឲ្យ អ្នកម្តាយ បងប្អូន ក្រុមគ្រួសារ នៃ សព លោក នៃ ប៉េណា បាន ថ្លែងអំណរ អរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ជូន ចំពោះ ថ្នាក់ដឹកនាំ កំពូល ៗ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា លោក លោកស្រី អ្នកនាង កញ្ញា និង ញាតិមិត្ត ទាំងអស់ ដែល បាន ចំណាយ ពេលវេលា អញ្ជើញ ចូលរួម រំលែក ទុក្ខ គ្រួសារ លោក ។
លោក នៃ គង់ និង ក្រុម គួសារ សូម ជូនពរ ថ្នាក់ដឹកនាំ កំពូល ៗ នៃ រាជ រដ្ឋាភិបាល លោក លោកស្រី អ្នកនាង កញ្ញា និង ញាតិមិត្ត ទាំងអស់ ជួប តែ សេចក្តីសុខ និង ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លៀត ឡើយ ។
សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៨ ក៏ បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី បូជា សព លោក នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា ផងដែរ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង មន្ត្រី នៃ រាជ រដ្ឋាភិបាល ទាំងអស់ បាន សម្តែង នូវ សមាន ទុក្ខ ដ៏ ក្តុកក្តួល សោកស្តាយ អាឡោះអាល័យ ជា ទីបំផុត និង សូម ចូលរួម រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ នៃ សព ។ សម្តេច តេជោ ហ៊ុន សែន ចាត់ទុក ថា មរណភាព របស់ លោក នៃ ប៉េណា គឺជា ការបាត់បង់ កុលបុត្រ ខ្មែរ ដ៏ ឆ្នើម មួយ រូប ពោរពេញ ដោយ ឆន្ទៈ មនសិការ ក្នុង ការបម្រើ បុព្វហេតុ ជាតិ សាសនា ព្រះមហាក្សត្រ គ្រប់ កាលៈទេសៈ ៕
សម្តេច ពញា ចក្រី ហេង សំរិន អញ្ជើញ កាន់ បិណ្ឌ វេន ទី ១១ នៅ វត្ត ត្រពាំង ព្រីង ក្នុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ
សូម រំលឹក ផងដែរ ថា បុណ្យ ភ្ជុំ បិណ្ឌ ត្រូវបាន ពុទ្ធ សាសនិក ខ្មែរ ធ្វើឡើង រៀងរាល់ ឆ្នាំ ចាប់ពី ថៃ្ង ១រោច ដល់ ថៃ្ង ១៥ រោច ខែ ភទ្របទ ។ ប្រជាពុទ្ធ សាសនិក ខ្មែរ ធ្វើ បុណ្យ នេះ ដោយ ការយក ទេយ្យ ទាន ផ្សេង ៗ មាន អាហារ ជាដើម ទៅ ផ្គត់ផ្គង់ ព្រះសង្ឃ នៅក្នុង វត្ត ដែល កំពុង គង់ ចាំ វស្សា រយៈពេល ១៥ ថៃ្ង គត់ ។
ក្រុមហ៊ុន ឈាន មុខ ផ្នែក បច្ចេកវិទ្យា រួមគ្នា ចែករំលែក បទពិសោធន៍ និង ផ្តល់ ដំណោះស្រាយ លើ ការគ្រប់គ្រង ប្រព័ន្ធ ហិរញ្ញវត្ថុ
លោក ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ អតិថិជន ដែល បាន អព្ជើាញ ចូលរួម ក្នុង សិក្ខាសាលា នេះ ហើយ អតិថិជន និង ទទួលបាន នូវ ចំនេះ ដឹង ក្នុង ការផ្គត់ផ្គង់ បច្ចេកវិទ្យា របស់ ផលិតផល SAP ពីព្រោះ វា ជា ផ្នែក បច្ចេកវិទ្យា មួយ ជួយ សម្រួល ក្នុង ការ បញ្ចូល រក្សាទុក ទិន្នន័យ និង ទាញយក របាយការណ៍ ហិរញ្ញវត្ថុ យ៉ាង សុក្រឹត នឹង ជួយ ជំរុញ អាជីវកម្ម អោយ កាន់តែ រីកចំរើន ៕ ក្រសួង សាធារណការ បង្ហាញ តារាង ពេលវេលា នៃ ការជិះ រថភ្លើង ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ
( ភ្នំពេញ ) ៖ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នៅ ព្រឹក ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ បង្ហាញ ពី តារាងកាលវិភាគ នៃ ការធ្វើដំណើរ តាម រថភ្លើង ពី រាជធានី ភ្នំពេញ ទៅ តាម បណ្ដា ខេត្ត និង ពី បណ្ដា ខេត្ត មក រាជធានី ភ្នំពេញ វិញ ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។
ក្រសួង សាធារណការ បាន បញ្ជាក់ ថា ចំពោះ សំបុត្រ ជិះ រថភ្លើង មិន យក សោ ហ៊ុយ នេះ មាន ចែកជូន នៅ ស្ថានីយ ភ្នំពេញ មុនពេល ឡើង រថភ្លើង ពីរ ថ្ងៃ ហើយ មិន អនុញ្ញាតឲ្យ យក ជំនួស ឡើយ គឺ អ្នក មាន មុខ ម្នាក់ ប្រគល់ឲ្យ ម្នាក់ ។
សូម ជម្រាប ថា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ផ្ដល់ កាដូរ ជូន ប្រជាពលរដ្ឋ ជា បន្ដ បន្ទាប់ ដើម្បី សម្រួល ដល់ ការចំណាយ សម្រាប់ ការធ្វើដំណើរ ក្នុង ឱកាស បុណ្យ ភ្ជុំ ដោយ អនុញ្ញាតឲ្យ ជិះ រថភ្លើង ដោយ ឥត គិត ថ្លៃ និង ជិះ រថយន្ដក្រុង សាធារណ ដោយ ឥត គិត ថ្លៃ ដូចគ្នា ផងដែរ ៕
សូម អាន ខ្លឹមសារ លម្អិត នៃ តារាង ពេលវេលា សម្រាប់ ការជិះ រថយន្ដ ដែល មាន នៅ ខាងក្រោម នេះ៖ សាលា អន្តរជាតិ កម្ពុជា - អាមេរិកាំង ជា ថ្នាល បណ្ដុះបណ្ដាល បុត្រធីតា របស់ លោក អ្នក ស្រប តាម បរិបទ អប់រំ ពិភពលោក យ៉ាង មាន ប្រសិទ្ធភាព
កម្មវិធី CMA Mental Arithmetic ជា កម្មវិធី មួយ ដែល ត្រូវបាន បង្កើតឡើង បណ្តុះបណ្តា្តល ស្រាវជ្រាវ និង អភិវឌ្ឍ រយៈពេល ជាង ៣៥ ឆ្នាំ នៅ តៃវ៉ាន់ បណ្តុះ បណ្តាល នៅក្នុង ប្រទេស ចំនួន ៣០ ប្រទេស ដោយ ប្រើប្រាស់ បច្ចេកវិជ្ជា ទំនើប ក្នុង ការបង្រៀន និង សិក្សា ជាពិសេស មាន ការទទួលស្គាល់ និង គាំទ្រ បំផុត ពី សំណាក់ មាតា - បិតា អាណាព្យាបាល និង សិស្សានុសិស្ស នៅ ប្រទេស សិង្ហបុរី ។
