( កណ្ដាល ) ៖ នៅ ថ្ងៃអាទិត្យ ៦រោច ខែ ភទ្រប ទ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស ២៥៦២ ត្រូវនឹង ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោកស្រី ឃួន សុដារី អនុប្រធាន ទី២ រដ្ឋសភា . មន្ដ្រីរាជការ ក្រោម ឱវាទ និង ពុទ្ធ បរិស័ទ ជាច្រើន នាក់ ទៀត បាន អញ្ជើញ បូជា ទៀន ធូប ផ្កា ភ្ញី ថ្វាយ ព្រះពុទ្ធរូប និង នាំយក នូវ គ្រឿង ឧបភោគ - បរិភោគ ចង្ហាន់ បិណ្ឌ បាត្រ និង បច្ច័យ មួយចំនួន ចូលរួម ពិធីកាន់ បិណ្ឌ ទី៦ នៅ វត្ត រតណា រាម ហៅ ( វត្ត កំពង់ភ្នំ ក្នុង ) ស្ថិត នៅក្នុង ឃុំ កំពង់ភ្នំ ស្រុក លើក ដែក ខេត្ត កណ្តាល ។
ក្នុង ឱកាស អញ្ជើញ ទៅ ដាក់ បិណ្ឌ នេះ លោកស្រី ឃួន សុដារី បាន នាំយក ចង្ហាន់ និង ទេយ្យ ទាន មួយចំនួន ទៀត ទៅ ប្រគេន ព្រះសង្ឃ ដើម្បី ឧទ្ទិស ទៅដល់ វិញ្ញាណក្ខន្ធ ជីដូន ជីតា និង បុព្វការី ជន ដែល បាន ចែក ឋាន ទៅ តាម ប្រពៃណី សាសនា ខ្មែរ ។ បន្ទាប់ពី ប្រគេន ចង្ហាន់ ហើយ នោះ លោកស្រី ក៏ បាន សុំឲ្យ មគ្គផល កើត ចេញ ពី ការធ្វើ បុណ្យ នេះ សូមឲ្យ ជាតិ ខ្មែរ ទាំងមូល បាន ជួប ក្តីសុខ ក្សេមក្សាន្ត ជានិច្ច និរន្ត ។
សូម ជម្រាប ថា ជារៀងរាល់ ឆ្នាំ លោកស្រី ឃួន សុដារី បាន ដឹកនាំ ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ មក ប្រារព្ធ ពិធី ប្រពៃណី ជាតិ នេះ ជារៀងរាល់ ឆ្នាំ នៅ តាម វត្ត អារាម នានា យ៉ាង ខ្ជាប់ខ្ជួន ដើម្បី រួមចំណែក ថែរក្សា ប្រពៃណី ជាតិ ខ្មែរ បែប ព្រះពុទ្ធ សាសនា ។
( រតនគិរី ) ៖ មន្ទីរ និង ស្ថាប័ន ជាច្រើន នៅក្នុង ខេត្ត រតនគិរី មិន បាន បង់លុយ ថ្លៃ ប្រមូល សំរាម តម្លៃ ប្រមាណ ៤ម៉ឺន រៀល ក្នុង មួយ ខែ ជូន ទៅ ក្រុមហ៊ុន ប្រមូល សំរាម នោះ ឡើយ ។
យោង តាម លិខិត សុំ កិច្ចអន្តរាគមន៍ របស់ ក្រុមហ៊ុន ប្រមូល សំរាម ពី អភិបាល ក្រុង បាន លុង ខេត្ត រតនគិរី ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន បង្ហាញ ថា មន្ទីរ និង ស្ថាប័ន ទាំងអស់ នោះ មិន បាន បង់ ថ្លៃ ប្រមូល សំរាម នេះ ជាច្រើន ឆ្នាំ មកហើយ ។ មកដល់ ពេល បច្ចុប្បន្ន មន្ទីរ និង ស្ថាប័ន ទាំងនោះ ជំពាក់ លុយ ថ្លៃ សំរាម រាប់ លាន រៀល ។
ក្នុង លិខិត សុំ អន្តរាគមន៍ នោះ ក្រុមហ៊ុន ប្រមូល សំរាម បាន ស្នើឲ្យ អភិបាល ក្រុង បាន លុង ជួយ ជំរុញ និង មាន វិធានការដោះស្រាយ ឲ្យបាន ឆាប់ ដើម្បីឲ្យ បណ្តា មន្ទីរ ស្ថាប័ន ក្នុង ក្រុង បាន លុង ខេត្ត រតនគិរី បង់ ថ្លៃ ប្រាក់ ជំពាក់ សេវា ដឹកជញ្ជូន សំរាម ចេញ ពី ក្រុង បាន លុង ឲ្យបាន គ្រប់ ចំនួន ទៅ តាម សៀវភៅ បន្ទុក ចៀសវាង ការកកស្ទះ សំរាម ធ្វើឲ្យ បាត់បង់ សោភណភាព ទីក្រុង បាន លុង និង ប៉ះពាល់ សណ្តាប់ធ្នាប់ បរិស្ថាន ស្រប ទៅតាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។
យោង តាម ប្រភព ព័ត៌មាន បាន បញ្ជាក់ ថា ថវិកា សម្រាប់ បង់ ថ្លៃ សំរាម នេះ ត្រូវបាន ក្រសួង សេដ្ឋកិច្ច ទម្លាក់ ជារៀងរាល់ ឆ្នាំ តែ បែរជា មន្ទីរ និង ស្ថាប័ន ទាំងនោះ មិន បង់ ថ្លៃ សំរាម និង ចូលរួម អនុវត្តន៍ កាតព្វកិច្ច អនាម័យ ទៅវិញ ៕ អាជ្ញាធរ រង ការការចោទប្រកាន់ ថា អសមត្ថភាព ក្នុង ការដោះស្រាយ ជម្លោះ រ៉ាំរ៉ៃ រវាង ក្រុមហ៊ុន ដឹក សំរាម និង ថៅកែ ផ្សារ បាន លុង
( រតនគិរី ) ៖ ទាំង អាជ្ញាធរ ថ្នាក់ ជាតិ និង ថ្នាក់ ខេត្ត បាន រង ការរិះគន់ ថា អសមត្ថភាព ក្នុង ការដោះស្រាយ ជម្លោះ ដ៏ រ៉ាំរ៉ៃ រវាង ក្រុមហ៊ុន ដឹក សំរាម របស់ លោក ជា គួង និង ថៅកែ វិនិយោគ ផ្សារ បាន លុង ឧកញ៉ា សា លាង បណ្តោយ ឲ្យ ការប្រមូល និង ការទុកដាក់ សំរាម នៅមុខ ផ្សារ បាន លុង ជួប បញ្ហា រហូតដល់ ពេល បច្ចុប្បន្ន ។
ជម្លោះ រវាង ក្រុមហ៊ុន ទទួលបាន សិទ្ធិ ប្រមូល សំរាម នៅក្នុង ខេត្ត រតនគិរី របស់ លោក ជា គួង និង លោក ឧកញ៉ា សា លាង បាន កើតមាន ជាច្រើន ឆ្នាំ មកហើយ ហើយក៏ បាន ប្តឹង ទៅកាន់ តុលាការ ព្រមទាំង អាជ្ញាធរ ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ខេត្ត ជាញឹកញាប់ ផងដែរ តែ នៅតែ មិន អាច រក ដំណោះស្រាយ ចេញ នោះ ឡើយ ។
ជម្លោះ នោះ ក៏ ធ្លាប់ បាន ប្តឹង ដល់ អាជ្ញាធរ នៅ ថ្នាក់ ជាតិ និង ថ្នាក់ ខេត្ត ជាច្រើន ដង មក ហើយ តែ មិន មាន ដំណោះស្រាយ ណាមួយ ឲ្យ សមស្រប នោះ ឡើយ ។ បច្ចុប្បន្ន តុលាការ ខេត្ត រតនគិរី បាន អនុញ្ញាតឲ្យ ក្រុមហ៊ុន វិនិយោគ ផ្សារ បាន លុង ប្រមូល និង ដឹក សំរាម ទៅ ចាក់ ដោយ ខ្លួន ឯង ដែល ជា ការរំលោភ ទៅ លើ សិទ្ធិ របស់ ក្រុមហ៊ុន ដែល ទទួលបាន សិទ្ធិ វិនិយោគ លើ ការប្រមូល សំរាម នេះ ។
មិន តែ ប៉ុណ្ណោះ ក្រុមហ៊ុន វិនិយោគ ផ្សារ បាន លុង នេះ មិន មាន កន្លែង ចាក សំរាម នោះ ទេ បែរជា យក សំរាម ទៅ ចាក់ លើ ដី ក្រុមហ៊ុន ប្រមូល សំរាម របស់ លោក ជា គួង ទៅ វិញ ។ បញ្ហា វិវាទ នេះ កំពុង បង្ក ជា បញ្ហា អសកម្ម ក្នុង ការប្រមូល សំរាម នៅក្នុង ក្រុង បាន លុង ដែល ជា ការប៉ះពាល់ ខ្លាំង ដល់ បញ្ហា សោភណភាព និង អនាម័យ នៅក្នុង ក្រុង នៃ ខេត្ត តំបន់ ទេសចរណ៍ ធម្មជាតិ ភាគ ឦសាន មួយ នេះ ។
បញ្ហា នេះ បាន ធ្វើឲ្យ ពលរដ្ឋ ក្នុង ខេត្ត រតនគិរី បន្ទោស អាជ្ញាធរ ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ខេត្ត ថា អសមត្ថភាព ក្នុង ការគ្រប់គ្រង អ្នក វិនិយោគ នៅក្នុង ខេត្ត ទើប ឲ្យ ពួកគេ ធ្វើ អ្វី ទៅ តាម ចិត្ត តាម អំណាច លុយ កាក់ របស់ ពួកគេ ។ ក្រុម ប្រជាពលរដ្ឋ ក៏ បាន ស្នើឲ្យ អាជ្ញាធរ ទាំង ថ្នាក់ ជាតិ និង ថ្នាក់ ខេត្ត ចាត់ ក្រុមការងារ សិក្សា លើ បញ្ហា នេះ ឲ្យបាន ហ្មត់ចត់ ដើម្បី ដោះស្រាយ បញ្ហា សំរាម បរិវេណ ផ្សារ បាន លុង ៕
( ភ្នំពេញ ) ៖ អង្គភាព ព័ត៌មាន Fresh News សូម លើក យក គតិបណ្ឌិត ចំនួន ១០ ថ្មី ទៀត មក បង្ហាញ ជូន មិត្ត អ្នកអាន សម្រាប់ សប្ដាហ៍ ថ្មី ក្រោយពី សប្ដាហ៍ ចាស់ ៗ និង គិត បណ្ឌិត ល្អ ៗ បាន កន្លងផុត ទៅជា បន្តបន្ទាប់ ពិសេស ក្នុង សប្ដាហ៍ ថ្មី នេះ យើងខ្ញុំ ក៏ បង្ហាញ នូវ សុភាសិត ខ្មែរ មួយ ឃ្លា ដ៏ មាន អត្ថន័យ ផងដែរ ដែល ផ្ដល់ នូវ ការលើកទឹកចិត្ត ដល់ អ្នក ដែល ជួប បញ្ហា ពិបាក អស់សង្ឃឹម ឱ្យ ចេះ ផ្លាស់ប្ដូរ ខ្លួន ឯង ប្រើប្រាជ្ញា ដោះស្រាយ បញ្ហា និង បង្កើត រឿង ល្អ ៗ ឡើងវិញ ។
គតិបណ្ឌិត ទាំងនោះ រួម មាន៖
១៖ ការដឹកនាំ ប្រជាពលរដ្ឋ ប្រកបដោយ គុណធម៌ គឺជា ការដឹកនាំ ប្រកបដោយ សុភមង្គល ។ ព្រះសម្មាសម្ពុទ្ធ
២៖ វាសនា ស្ថិត លើ ទេវតា ប្រាជ្ញា ស្ថិត លើ មនុស្ស ។ នេះ ហើយ ជា សុភាសិត ខ្មែរ ដែល យើង ចង់ បង្ហាញ ។
៦៖ រដ្ឋាភិបាល ភិបាល ប្រៀប ដូចជា ទូក ប្រជារាស្ត្រ ប្រៀប ដូចជា ទឹក ទឹក អាច បណ្ដែត ទូក ហើយក៏ អាច ពន្លិច ទូក បាន ដែរ ។ ខុង ជឺ
ជាក់ស្ដែង បើ យើង និយាយ អំពី សាវតារ ខ្មែរ យើង ក្រោយពី ចប់ សង្រ្គាម លោក លើក ទី២ និង បន្ទាប់ពី ការបង្កើត អង្គការ សហ ប្រជាជាតិ ឆ្នាំ ១៩៤៥មក មុននឹង ប្រទេស យើង បាន ទទួល សន្ដិភាព ដូច សព្វ ថ្ងៃ នេះ គឺ ប្រទេស យើង បាន ជួបប្រទះ នូវ វាសនា អាក្រក់ ក្នុង ការបែកបាក់ ជាតិ និង សង្រ្គាម រុំារ៉ៃ យ៉ាង ខ្លោចផ្សា ជា ទីបំផុត ចាប់ពី ឆ្នាំ ១៩៧០ រហូតដល់ មាន កិច្ចព្រមព្រៀង ទីក្រុង ប៉ារីស ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ១៩៩១ ដូច យើង ទំាង អស់ គ្នា បាន ឆ្លងកាត់ និង ជួបប្រទះ ជា ភស្ដុតាង ។
ស្ថិត ត្រង់ ចំណុច នេះ លោក រត្ន័ សណ្ដាប់ បន្ដ ថា បើ ដូច្នេះ បើ និយាយ អំពីមុខងា របស់ អង្គការ សហ ប្រជាជាតិ ក្នុង ការបំពេញ បេសកកម្ម បញ្ចប់ សង្រ្គាម ដើម្បី នំាមក នូវ « សន្ដិភាព » នៅ តាម បណ្ដា ប្រទេស នានា ជុំវិញ ពិភពលោក នេះ គឺ អង្គការ សហ ប្រជាជាតិ បរាជ័យ ទំាង អស់ គឺ លើកលែងតែ កម្ពុជា យើង មួយ ប៉ុណ្ណោះ ។ ដែល កម្មវត្ថុ « សន្ដិភាព »របស់ អង្គការ សហ ប្រជាជាតិ សម្រេចបាន ១០០ ភាគរយ ។
បុគ្គលិក ក្រុមហ៊ុន វេរ លុយ ធំ មួយ នៅ កម្ពុជា ជាង ២០០ នាក់ ចូលរួម ពិធីកាន់ បិណ្ឌ ទី៥
គណៈកម្មាធិការ ចំណុះ ជើង វត្ត និង អ្នកកាន់ វេន្ត បិណ្ឌ ពុទ្ធិ បរិស័ទ ក្នុង ភូមិ ព្រមទាំង ព្រះសង្ឃ មាន សេចក្តីត្រេកអរ ជាខ្លាំង ចំពោះ ទឹកចិត្ត ជ្រះថ្លា របស់ បុគ្គលិក ក្រមហ៊ុន ទ្រូម៉ាន់ នី ដែល បាន ចូលរួម កាន់ បិណ្ឌ ទី៥ នៅ វត្ត ពោធិ អណ្តែត នេះ ហើយក៏ សំណូមពរ ឲ្យ ក្រុមហ៊ុន ផ្សេង ទៀត ចូលរួម ចែករំលែក បុណ្យ កុសល រួមគ្នា ដូច ក្រុមហ៊ុន ទ្រូម៉ាន់ នី ផងដែរ ៕ ថ្នាក់ដឹកនាំ កងទ័ព ជួប សំណេះសំណាល ជាមួយ យោធិន ពិការ នៅ មជ្ឈមណ្ឌល អភិវឌ្ឍ យោធិន ពិការ សម្ដេច តេជោ ហ៊ុន សែន គូលែន ៣១៧
( សៀមរាប ) ៖ ថ្នាក់ដឹកនាំ កងទ័ព នៅ រសៀល ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន ជួប សំណេះសំណាល និង ប្រគល់ ជូន ថវិកា និង គ្រឿង បរិភោគ ជូន ដល់ យោធិន ពិការ នៃ មជ្ឈមណ្ឌល អភិវឌ្ឍ យោធិន ពិការ សម្ដេច តេជោ ហ៊ុន សែន គូលែន ៣១៧ ខេត្ត សៀមរាប ចំនួន ២៤៥ គ្រួសារ នា រដូវ បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ។
តាម របាយការណ៍ របស់ ឧត្តមសេនីយ៍ ឯក ពៅ សែន នាយក មជ្ឈមណ្ឌល អភិវឌ្ឍ យោធិន ពិការ សម្ដេច តេជោ ហ៊ុន សែន គូលែន ៣១៧ សៀមរាប បាន ឲ្យដឹង ថា មជ្ឈមណ្ឌល អភិវឌ្ឍ យោធិន ពិការ នេះ បាន ចាប់ផ្ដើម ការ ពី ថ្ងៃទី ៩ ខែកក្កដា ឆ្នាំ ២០១០ រហូតដល់ បច្ចុប្បន្ន មាន ២៧០ គ្រួសារ ក្នុង នោះ យោធិន ពិការ សរុប ចំនួន ២៤៥ គ្រួសារ និង មាន សមាជិក សរុប ១. ២៧០ នាក់ ស្ត្រី ៦១៤ នាក់ ។ ក្រៅពី នេះ មាន គ្រូបង្រៀន ស្ម័គ ចិត្ត ចំនួន ២៣ គ្រួសារ . ពេទ្យ ឆ្មប ស្ម័គ្រចិត្ត ២គ្រួសារ . និង ព្រះសង្ឃ គង់ នៅ វត្ត ព្រះខ័ន សែន ជ័ន ចំនួន ៥អង្គ ។
លោក បាន គូសបញ្ជាក់ ថា ដោយ មាន ការយកចិត្តទុកដាក់ ឧត្ថម្ភ គាំទ្រ ជា បន្តបន្ទាប់ពី សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ និង សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធប ណ្ឌីត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ធ្វើឲ្យ យោធិន ពិការ និង គ្រួសារ មាន លំនឹង លើ ផ្នែក ជីវភាព រស់ នៅ ល្អ ប្រសើរ ។ លោក បន្ត ថា សម្ដេច បាន ជួយ កសាង ទាំង ហេដ្ឋារចនាសម្ព័ន្ធ ដែល មាន ផ្លូវថ្នល់ . ផ្ទះសម្បែង . វត្ត អារ៉ាម . សាលារៀន . មណ្ឌល សុខភាព . អាគារ បំពេញ ការងារ ជាដើម ។
បង្រ្កាប ទីតាំង លក់ កន្ទុយ លេខ ៤កន្លែង នៅ ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ កម្លាំង ក្រុម អន្តរាគមន៍ បង្ការ បង្ក្រាប នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត បាត់ដំបង វេលា ម៉ោង ១៥៖០០ នាទី ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន បង្រ្កាប ទីតាំង ល្បែង ស៉ី សង លក់ កន្ទុយ លេខ ៤កន្លែង នៅក្នុង ស្រុក សំឡូត ខេត្ត បាត់ដំបង និង បញ្ជូន មក ស្នងការ ខេត្ត ដើម្បី ចាត់ការ តាម ច្បាប់ ។
លោក ឈឿង គឹម សុង នាយ ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល និង ជា ប្រធាន ក្រុម អន្តរាគមន៍ បង្ការ បង្ក្រាប នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត បាត់ដំបង បាន ឲ្យដឹង ថា ក្រុម អន្តរាគមន៍ បង្ការ បង្ក្រាប បាន ចុះ ប្រត្តិបត្តិការ បង្ក្រាប ករណី ល្បែង ស៉ី សង លក់ កន្ទុយ លេខ បាន ចំនួន ៤ គោលដៅ ផ្សេង គ្នា នៅក្នុង ស្រុក សំឡូត ។
( ព្រៃវែង ) ៖ លោក ស្តើង សុខុម រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក កំចាយ មារ បាន ថ្លែង ប្រាប់ ប្រជាពលរដ្ឋ នៅ ស្រុក កំចាយ មារ ថា រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ នឹង ខិតខំ លើកកម្ពស់ ជីវភាព ប្រជាជន តាមរយៈ ការជំរុញ ការវិនិយោគ សាធារណៈ និង ឯកជន ទៅកាន់ មូលដ្ឋាន ជនបទ និង ការបង្ខិត សេវា សាធារណៈ ឲ្យ ខិត ជិត ប្រជាជន និង ទម្លាក់ ធនធាន កាន់តែ ច្រើន ទៅកាន់ មូលដ្ឋាន ។
លោក ប្រធាន ក្រុមការងារ បាន ប្រាប់ ប្រជាពលរដ្ឋ អំពី ការដាក់ចេញ នូវ ឤទិភាព គោល នយោបាយ សំខាន់ ៗ និង ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ ឥត ងាក រេ របស់ រាជ រដ្ឋាភិបាល ថ្មី ក្នុង ការបន្ត អនុវត្ត កម្មវិធី កែទម្រង់ សំខាន់ ៗ ក្នុង គោលដៅ បម្រើ នូវ ឧត្តម ប្រយោជន៍ របស់ ជាតិ និង ឆ្លើយតប សំណូមពរ និង សេចក្តីត្រូវការ របស់ ប្រជាជន ។
លោក ស្តើង សុខុម បាន គូសបញ្ជាក់ ថា គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៦ ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តោត ជា សំខាន់ ទៅ លើ ការយកចិត្តទុកដាក់ ទៅ លើ ជីវភាព របស់ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន ។ គោល នយោបាយ មួយ បង្ហាញ ពី ការយកចិត្តទុកដាក់ ចំពោះ ជីវភាព របស់ ប្រជាពលរដ្ឋ នោះ គឺ គោល នយោបាយ វិមជ្ឈការ និង សហវិមជ្ឈការ ការប្រគល់ អំណាច ទៅ មូលដ្ឋាន គឺ ក្នុង គោលបំណង ជំរុញ ឲ្យ មាន ការអភិវឌ្ឍ នៅ មូលដ្ឋាន ។
( សៀមរាប ) ៖ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន គណៈកម្មការ សាងសង់ វិមាន ឈ្នះ - ឈ្នះ នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន ដឹកនាំ ក្រុមការងារ បច្ចេកទេស ចុះ ពិនិត្យ និង ពន្លឿន ការធ្វើ រូបចម្លាក់ នៅក្នុង ខេត្ដ សៀមរាប ដើម្បី រៀបចំ យកមក ដាក់ តាំង បង្ហាញ នៅ វិមាន ឈ្នះ - ឈ្នះ នា ពេល ខាងមុខ ឲ្យបាន កាន់តែ ឆាប់រហ័ស ។
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន នយោបាយ និង កិច្ចការ បរទេស ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមការងារ សាងសង់ វិមាន ឈ្នះ ឈ្នះ បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ថា ក្នុង ពេល ចុះ ពិនិត្យ នោះ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ បាន ណែនាំ ក្រុមការងារ ជំនាញ ត្រូវ ពន្លឿន ការធ្វើ រូបចម្លាក់ ដើម្បី យកមក ដាក់ នៅ វិមាន ឈ្នះ ឈ្នះ ដែល កំពុង ដំណើរការ សាងសង់ ជិត ឈានដល់ ពេល បញ្ចប់ ជាស្ថាពរ ហើយ នោះ ។
នាយ ឧត្តមសេនីយ៍ ណឹម សុវត្ថិ ដែល បាន អម ដំណើរ ជាមួយ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន គូសបញ្ជាក់ ថា ក្រុមការងារ ធ្វើ រូបចម្លាក់ នៅ ខេត្ត សៀមរាប បាន និង កំពុង ខិតខំ ប្រឹងប្រែង យ៉ាង ខ្លាំង ដើម្បីឲ្យ បាន រួចរាល់ យកមក ដាក់ នៅ វិមាន ឈ្នះ - ឈ្នះ ដែល គ្រោង បញ្ចប់ ការសាងសង់ និង សម្ពោធ ជា ផ្លូវការ នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៨ ដែល ជា ឆ្នាំ ទី២០ នៃ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
វិមាន ឈ្នះ ឈ្នះ នេះ បាន ចាប់ផ្តើម សាងសង់ ឡើង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០១៦ ដោយ ទំហំ ដី ៨ហិចតា ស្ថិត នៅ ខណ្ឌ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ។ ថវិកា ដែល យកមក សាងសង់ គឺជា ថវិកា បដិភាគ របស់ រាជ រដ្ឋាភិបាល យ៉ាងណា ក៏ដោយ គេ មិន បាន បញ្ជាក់ ថា ការចំណាយ នូវ ការសាងសង់ អស់ ថវិកា ប៉ុន្មាន នោះ ឡើយ ។
លោក សោម អូន៖ សហជីព ក៏ ត្រូវ មាន តួនាទី ក្នុង ការរួមចំណែក ជួយ កិច្ចការ សង្គម សេដ្ឋកិច្ច វប្បធម៌ និង ប្រវត្តិសាស្ត្រ ដែរ
( កំពង់ធំ )៖ លោក សោម អូន ប្រធាន សភា សម្ព័ន្ធ សហជីព ជាតិ កម្ពុជា (NACC) បាន ដឹកនាំ សមាជិក ក្រុមប្រឹក្សាភិបាល និង សកម្មជន សហជីព ចំនួន ៩១ នាក់ ទៅ ទស្សនកិច្ច សិក្សា ស្វែងយល់ បន្ថែម អំពី វប្បធម៌ និង ប្រវត្តិសាស្ត្រ នៅ ប្រាសាទ សម្បូរ ព្រៃ គុក ខេត្ត កំពង់ធំ ។ ទស្សនកិច្ច ដែល បាន ធ្វើ កាលពី ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ក៏ មាន កិច្ចសហការ ពីសំណាក់ អាជ្ញាធរ សម្បូរ ព្រៃ គុក មន្ទីរ វប្បធម៌ និង សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត កំពង់ធំ ធ្វើឲ្យ ដំណើរ នេះ ទទួលបាន លទ្ធផល ជា វិជ្ជមាន ទាំង រូបភាព និង ខ្លឹមសារ ។
លោក សោម អូន បាន ឲ្យដឹង ថា សហជីព មិន មែន មាន តួនាទី ត្រឹមតែ ជា អ្នកការពារ សិទ្ធិ និង ផលប្រយោជន៏ កម្មករ នោះ ទេ សហជីព ក៏ ត្រូវ មាន តួនាទី ផងដែរ ក្នុង ការរួមចំណែក ជួយ កិច្ចការ សង្គម សេដ្ឋកិច្ច វប្បធម៌ និង ប្រវត្តិសាស្ត្រ ។ លោក បាន បន្ថែម ថា គោលបំណង សំខាន់ នៃ ដំណើរទស្សនកិច្ច នេះ គឺ ដើម្បី បំផុស ដល់ ចលនា សហជីព កម្មករ ស្វែងយល់ ឲ្យបាន ស៉ី ជម្រៅ បន្ថែម ទៀត នៅ ទីក្រុង បុរាណ នៃ ប្រាសាទ សម្បូរ ព្រៃ គុក ដែល ត្រូវបាន ស្គាល់ ថា ជា « អតីត រាជធានី ឥសាន បុរៈ » របស់ កម្ពុជា នៅ សម័យ ចេនឡា ក្នុង ស. វទី៧ នៃ គ.ស ។
លោក សោម អូន ក៏ បាន បង្ហើប ឲ្យដឹង ពី គម្រោង រៀបចំ កម្មវិធី ដំណើរទស្សនកិច្ច សិក្សា របស់ ចលនា សហជីព កម្មករ នៅ តាម តំបន់ ប្រវត្តិសាស្ត្រ ផ្សេង ៗ ទៀត ដូចជា ប្រាសាទ ភ្នំ ដា ក សាង នៅ សតវត្ស ទី៦ នា សម័យ នគរ ភ្នំ បច្ចុប្បន្ន នៅ ស្រុក អង្គ បុរី ខេត្ត តាកែវ និង បន្ទាយ លង្វែក ក សាង នា សតវត្ស ទី ១៥ បច្ចុប្បន្ន នៅ ស្រុក កំពង់ត្រឡាច ខេត្ត កំពង់ឆ្នាំង បន្ត ទៀត ផងដែរ ៕
នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន៖ កម្ពុជា មាន សុខ សន្ដិភាព និង ការអភិវឌ្ឍ អាច បើក ឱកាស ឲ្យ ប្រជាពលរដ្ឋ ជួបជុំគ្នា ធ្វើ បុណ្យ យ៉ាង សប្បាយរីករាយ
( បន្ទាយមានជ័យ ) ៖ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ឧប នាយក រដ្ឋមន្រ្តី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង ក្រុមគ្រួសារ អម ដំណើរ ដោយ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង ពុទ្ធ បរិស័ទ ជាច្រើន នាក់ បាន អញ្ជើញ បូជា ទៀន ធូប ផ្កា ភ្ញី ថ្វាយ ព្រះពុទ្ធរូប និង នាំយក នូវ គ្រឿង ឧបភោគ - បរិភោគ ចង្ហាន់ បិណ្ឌ បាត្រ និង បច្ច័យ មួយចំនួន ចូលរួម ពិធីកាន់ បិណ្ឌ ទី៦ នៅ វត្ត សេនា ប្រជុំ ពល ភ្នៀត ក្នុង សង្កាត់ ភ្នៀត ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។
ថ្លែង ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន មាន មតិ សំណេះសំណាល និង នាំ ការផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា . សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា ។
នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន គូសបញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដឹកនាំ ប្រទេស កម្ពុជា ដើរ លើ ផ្លូវ ត្រូវ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ទាំង ពុទ្ធ ចក្រ និង អាណាចក្រ ជំនឿ សាសនា ត្រូវបាន បើក ទូលាយ ប្រជាពលរដ្ឋ មក ពី គ្រប់ ទិសទី បាន មក ជួបជុំគ្នា ធ្វើ បុណ្យ យ៉ាង សប្បាយរីករាយ ហើយ ពុទ្ធ ចក្រ អាច រីកលូតលាស់ បាន តែ ក្នុង ប្រទេស មាន សុខ សន្តិភាព ទេ ។
បន្ថែម ពី នេះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន ថ្លែងអំណរគុណ ដល់ មហា គ្រួសារ អ្នក បន្ទាយមានជ័យ ដែល បាន ចូលរួម ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ថែរក្សា បាន នូវ សុខ សន្តិភាព គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ភាពរីកចម្រើន រុងរឿង សម្បូរសប្បាយ ទាំងអស់ គ្នា ។
( ភ្នំពេញ ) ៖ ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ លោក អ៉ឹម ឈុន លឹម បាន ចាត់ទុក មរណភាព របស់ លោក នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា គឺជា ការបាត់បង់ វីរកុលបុត្រ ខ្មែរ ដ៏ ឆ្នើម មួយ រូប ដែល ពោរពេញ ដោយ ឆន្ទៈ មនសិការ ក្នុង ការបម្រើ បុព្វហេតុ ជាតិ សាសនា ព្រះមហាក្សត្រ គ្រប់ កាលៈទេសៈ ។
ក្នុង សារលិខិត ចូលរួម រំលែក ទុក្ខ ផ្ញើ ជូន ភរិយា សព លោក នៃ ប៉េណា នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ លោក អ៉ឹម ឈុន លឹម បាន គូសបញ្ជាក់ ថា « មរណភាព របស់ ឯកឧត្តម នៃ ប៉េណា គឺជា ការបាត់បង់ នូវ ស្វាមី ប្រកបដោយ សង្គធម៌ ដ៏ ល្អ ពិសេស និង ការបាត់បង់ ឪពុក ជីតា ប្រកបដោយ ព្រហ្មវិហាធម៌ មិន ចេះ រីងស្ងួត ព្រមទាំង ការបាត់បង់ នូវ វីរកុលបុត្រ ខ្មែរ ដ៏ ឆ្នើម មួយ រូប ដែល ពោរពេញ ដោយ ឆន្ទៈ មនសិការ ក្នុង ការបម្រើ បុព្វហេតុ ជាតិ សាសនា ព្រះមហាក្សត្រ គ្រប់ កាលៈទេសៈ » ។
សូម បញ្ជាក់ ថា លោក នៃ ប៉េណា បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ម្សិលមិញ នេះ ក្នុង ជន្មាយុ ៧៤ ឆ្នាំ ដោយ រោគា ពាធ ៕
( ម៉ាសេដូន ) ៖ ប្រជាជន ម៉ាសេដូន នា ថ្ងៃអាទិត្យ នេះ បាន នាំគ្នា ទៅ បោះឆ្នោត ដើម្បី សម្រេច ជោគវាសនា ថា តើ ឈ្មោះ នៃ ប្រទេស របស់ ខ្លួន នឹង ត្រូវបាន ផ្លាស់ប្តូរ ទៅជា សាធារណរដ្ឋ ម៉ាសេដូន ខាងជើង ដែរ ឬ យ៉ាងណា ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
គួរ ជម្រាប ថា លទ្ធផល នៃ ការធ្វើ ប្រជាមតិ ខាងលើ ពុំ មែន ត្រូវតែ គោរព តាម មួយ រយ ភាគរយ នោះ ឡើយ ដោយ វា គ្រាន់តែ ជា ការស្ទង់ មតិ របស់ ប្រជាជន ប៉ុណ្ណោះ ប៉ុន្តែ សមាជិក សភា ម៉ាសេដូន បាន បញ្ជាក់ ថា នឹង គោរព តាម លទ្ធផល នៃ ការបោះឆ្នោត ខណៈ ការប្តូរ ឈ្មោះ ត្រូវការ សំឡេង ភាគ ច្រើន ០២ ភាគ ០៣ នៅក្នុង សភា ៕
ទេសរដ្ឋមន្ត្រី គន់ គីម ទៅកាន់ បិណ្ឌ នៅ វត្ត ក្នុង ស្រុក អន្លង់ វែង ធ្វើ បុណ្យ ឧទ្ទិស កុសល ជូន វិញ្ញាណក្ខន្ធ វីរជន ខ្មែរ ដែល ពលី ដើម្បី ជាតិ
( ឧត្តរមានជ័យ )៖ ទេសរដ្ឋមន្ត្រី គន់ គីម ប្រធាន ក្រុមការងារ ចុះ ជួយ ខេត្ត ឧត្តរមានជ័យ រួម និង អភិបាល ខេត្ត ឧត្តរមានជ័យ លោក ស ថា វី និង លោក ឧកញ៉ា លឹម ហេង នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន រួមគ្នា ទៅកាន់ បិណ្ឌ នៅ វត្ត ចំនួន ពីរ ក្នុង ស្រុក អន្លង់ វែង គឺ វត្ត ធម្មា រាម ស្រះ ឈូក និង វត្ត ជ័យ ទឹក ជុំ ។
ក្នុង ពេល អញ្ជើញ កាន់ បិណ្ឌ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ប្រគេន បច្ច័យ និង ចង្ហាន់ ដល់ ព្រះសង្ឃ ដើម្បី ឧទ្ទិស កុសល ផល បុណ្យ ជូន ដល់ វិញ្ញាណក្ខន្ធ ដល់ ជីដូន ជីតា និង បុព្វការី ជន ជាពិសេស ឧទ្ទិស ជូន ដល់ វិញ្ញាណក្ខន្ធ របស់ វីរ ជន ខ្មែរ ដែល បាន ពលី ជីវិត ក្នុង បុព្វហេតុ ជា មាតុភូមិ ក្នុង ពេល ជាតិ ធ្លាក់ ក្នុង អន្លង់ ភ្លើង សង្គ្រាម ។
ស្រប ពេល ដែល មាន វិបត្តិ សេដ្ឋកិច្ច នេះ ដែរ ក្រុមហ៊ុន ផលិត រថយន្ត ដ៏ ធំ មួយ ឈ្មោះ ថា Tofas នឹង ផ្អាក ដំណើរការ រោងចក្រ របស់ ខ្លួន នៅឯ ខេត្ត Bursa ភាគ ពាយព្យ ប្រទេស តួកគី រយៈពេល ០៩ ថ្ងៃ ដោយ គិត ចាប់ពី ខែតុលា ខាងមុខ ដោយសារ មាន ការធ្លាក់ចុះ តម្រូវការ ទីផ្សារ ក៏ ដូចជា ការបាត់បង់ ភាគហ៊ុន ចំនួន ៥ភាគរយ ដែរ នោះ ។
នេះ គឺ ការធ្លាក់ចុះ ខ្ពស់ បំផុត នៅក្នុង ប្រវត្តិសាស្ត្រ តួកគី តាំងពី ឆ្នាំ ២០០៩មក ។ សន្ទស្សន៍ ភាព ទំនុកចិត្ត លើ សេដ្ឋកិច្ច ចង្អុលបង្ហាញ ពី ការព្យាករ សេដ្ឋកិច្ច ដែល មាន ភាពវិជ្ជមាន របស់ សេដ្ឋកិច្ច សម្រាប់ ពិន្ទុ ១០០ ឡើង និង អវិជ្ជមាន សម្រាប់ ពិន្ទុ តិច ជាង ១០០ ។
រូបិយប័ណ្ណ លីរ៉ា របស់ តួកគី បាន ទទួលរង អតិផរណា ដែល បណ្តាលឲ្យ តម្លៃ ធ្លាក់ចុះ រហូតដល់ ៤០ ភាគរយ ក្នុង ឆ្នាំ នេះ ដោយសារ ក្តីបារម្ភ ពី ការជ្រៀត ជ្រែក និង ក៏ ដូចជា ឥទ្ធិពល របស់ លោក Erdogan ទៅ លើ គោល នយោបាយ ហិរញ្ញវត្ថុ រួមទាំង ការ មិន ចុះសម្រុង ជាមួយនឹង មហា យក្ស អាមេរិក ហើយ ទាំងនេះ បាន បណ្តាលឲ្យ ក្រុមហ៊ុន ផលិត ធំ ៗ បាត់បង់ ទំនុកចិត្ត ។
Tofas គឺជា ក្រុមហ៊ុន ធំ មួយ ក្នុង ចំណោម ក្រុមហ៊ុន សំខាន់ ទាំង ៥ ក្នុង ការផលិក គ្រឿងយន្ត ទៅ តួកគី ហើយក៏ ជា អ្នកនាំចេញ ប្រមាណ ២០ ភាគរយ នៃ បរិមាណ នាំចេញ ទាំងអស់ និង ៨០ ភាគរយ នៃ បរិមាណ ផលិត សរុប សម្រាប់ ការផ្គត់ផ្គង់ ។ ការនាំចេញ របស់ ក្រុមហ៊ុន នេះ បាន ឡើង ដល់ ១.៣លាន គ្រឿង នៅក្នុង ឆ្នាំ មុន តែ ធ្លាក់ចុះ ប្រមាណ ៥. ៥ភាគរយ គិត ត្រឹម ខែសីហា ឆ្នាំ ២០១៨ នេះ ។
នៅក្នុង ស្រុក វិញ ផ្នែក ផលិត គ្រឿងយន្ត នេះ បាន ធ្លាក់ចុះ កម្រិត ការលក់ របស់ ខ្លួន រហូតដល់ ២១ ភាគរយ ក្នុង រយៈពេល ០៨ ខែ ដំបូង ក្នុង ឆ្នាំ ២០១៨ ហើយ ការធ្លាក់ចុះ នេះ កាន់តែ កើនឡើង ក្នុង ខែសីហា តែ ម្តង ស្រប ពេល ដែល ទីផ្សារ របស់ ខ្លួន បាន បាត់បង់ អស់ ៥៣ ភាគរយ ។ ទន្ទឹមនឹង នេះ ការផលិត ក៏ ថយចុះ ជាង ៣៤ ភាគរយ ដែរ ។
ទិន្នន័យ សេដ្ឋកិច្ច ប្រចាំ ខែ នេះ គឺ មាន សភាព ធ្លាក់ចុះ ខ្លាំង បំផុត ក្នុង រយៈពេល ០៩ ឆ្នាំ ចុងក្រោយ នេះ ។ ស្រប ពេលនេះ ដែរ អតិផរណា ក៏ បាន កើនឡើង ខ្ពស់ បំផុត ក្នុង រយៈពេល ១៥ ឆ្នាំ ហើយ នឹង អាច ឡើង ដល់ ២០ ភាគរយ ក្នុង ឆ្នាំ ២០១៨ នេះ ។ ធនាគារ កណ្តាល បាន ធ្វើ ការឆ្លើយតប ដោយ កាត់បន្ថយ អត្រា ការប្រាក់ ទៅដល់ ៦.២៥ ភាគរយ និង អនុវត្ត កម្មវិធី សេដ្ឋកិច្ច ដើម្បី ស្ដារ ស្ថានភាព ឡើងវិញ ។
នៅក្នុង គម្រោង នេះ តួកគី សម្រេចបាន ច្រើន ជាង ការព្យាករណ៍ សម្រាប់ ឆ្នាំ ២០១៨ និង ឆ្នាំ ក្រោយ ទៀត តែ មិន អាច ផ្តល់ ទំនុកចិត្ត ឲ្យ បណ្តា អ្នក បណ្ដាក់ទុន ដែល ចង់ ទទួល ការវិភាគ ច្បាស់ ពី សេដ្ឋកិច្ច និង គម្រោង ក្នុង ការផ្តល់ ជំនួយ ដល់ ធនាគារ បាន ដោយសារ សេដ្ឋកិច្ច មិន នឹង នរ បែប នេះ ។
ធនាគារ Akbank ដែល ជា ធនាគារ ធំ ជាង គេ លេខ ០៥ នៅ តួកគី បាន តម្កល់ ទុក ទឹកប្រាក់ ចំនួន ៩៨០ លាន ដុល្លារ កាលពី ហើយ ឯកភាព នឹង បង្កើត បរិមាណ បុព្វលាភ ក្នុង ការផ្តល់ ឥណទាន នៅ ខែមីនា ដើម្បី ទប់ នឹង ហានិភ័យ ដែល ធនាគារ កំពុង ប្រឈមមុខ ។ រូបិយប័ណ្ណ តួកគី ទើប ទទួលបាន ស្ថិរភាព តម្លៃ នា ពេល ប៉ុន្មាន សប្តាហ៍ ចុងក្រោយ នេះ ដែល ក្នុង នោះ ៦. ០៨៧លីរ៉ា ស្មើនឹង ១ដុល្លារ អាមេរិក ។ នេះ អាច ចាត់ទុក ថា ជា ភាព ប្រសើរ ឡើងវិញ បើ ធៀប នឹង តម្លៃ ៧.២៤ លីរ៉ា ស្មើ១ ដុល្លារ កាលពី ខែ កន្លងទៅ ។
( ភ្នំពេញ ) ៖ រំលូត កូន បើ ស្តាប់ ភ្លាម អាច គិត ថា ជា អំពើ មិន សមរម្យ និង មិន គប្បី ដែល សង្គម ជាទូទៅ មិន អាច ទទួលយក បាន ឬ ជា អំពើ ខុស ច្បាប់ ។ ប៉ុន្តែ បើ ពិនិត្យ ឲ្យបាន ត្រឹមត្រូវ សកម្មភាព រំលូត កូន មួយ មិន អាច កំណត់ ថា ជា អំពើ ត្រឹមត្រូវ ឬ ខុស ច្បាប់ នោះ ទេ គឺ ត្រូវ ពិចារណា ឲ្យ ល្អិតល្អន់ អំពី មូលហេតុ ពិតប្រាកដ អំពី សកម្មភាព នោះ ។
ដើម្បី កុំ ឲ្យ មាន ការភ័ន្តច្រឡំ លើ ពាក្យ « ការរលូត » និង « ការរំលូត កូន » យើងខ្ញុំ សូម ធ្វើ ការគូសបញ្ជាក់ នូវ និយមន័យ នៃ ពាក្យ ខាងលើ ដូចតទៅ៖ ការរលូត កូន គឺជា ការខ្ជាក់ ចេញ ដោយ ឯកឯង នូវ ធាតុ បង្ក កូន ហើយ កូន ដែល ធ្លាក់ នោះ មិន អាច រស់ បាន ទេ ទោះបី មាន ការសង្គ្រោះ ល្អ យ៉ាងណា ក៏ដោយ ។ រីឯ ការរំលូត កូន គឺជា ការធ្វើឲ្យ ធ្លាក់ ធាតុ បង្ក កូន ដោយ កោស ឬ កាយ ឬ ដាក់ ថ្នាំ ឬ ជា ការបញ្ចប់ ជីវិត ទារក ដែល នៅក្នុង ផ្ទៃ ខណៈពេល ដែល ស្ត្រី កំពុង មាន ផ្ទៃពោះ ។
ជាពិសេស វេជ្ជបណ្ឌិត ឬ គ្រូពេទ្យ / ឆ្មប មធ្យម ដែល មាន ភារកិច្ច ធ្វើ ការរំលូត កូន ត្រូវតែ ពន្យល់ ណែនាំ ដល់ ស្ត្រី ដែល មាន គភ៌ មក សុំ ធ្វើ ការរំលូត កូន ពី គ្រោះថ្នាក់ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ បណ្តាល មកពី ការរំលូត កូន នេះ និង ពី ផលប្រយោជន៍ នៃ កិច្ច ពន្យារ កំណើត មុននឹង ធ្វើ ការរំលូត កូន ។ ប៉ុន្តែ ប្រសិនបើ សាមីខ្លួន នៅតែ ទទូច សុំ ធ្វើ ការរំលូត កូន វេជ្ជបណ្ឌិត ឬ គ្រូពេទ្យ / ឆ្មប មធ្យម អាច ធ្វើ ការរំលូត កូន បាន តែ ត្រូវ ស្ថិត ក្នុង លក្ខខណ្ឌ ដូច មាន រៀបរាប់ ខាងលើ ។
រៀបរៀង ដោយ៖ លោក មេធាវី លឹម សុវណ្ណា រ៉ុង និង កញ្ញា សាវី លីដា ជំនួយការច្បាប់ និង ជា សមាជិកា ក្រុមការងារ រៀបចំ និង ផ្សព្វផ្សាយ អត្ថបទ ច្បាប់ នៃ ក្រុម មេធាវី កម្ពុជា សហប្រតិបត្តិការ អន្តរជាតិ ។
បើកបរ មិន ត្រូវ ល្មើស ល្បឿន កំណត់ ជាដាច់ខាត ! ស្លាប់ ១១នាក់ និង រងរបួស ១៨ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៩ ខែកញ្ញា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១៧លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១១នាក់ . របួស ស្រាល ៥នាក់ និង របួស ធ្ងន់ ១៣នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា ក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១១លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១៨ គ្រឿង . រថយន្ដ ធុន តូច ១០គ្រឿង . រថយន្ត ធំ១ គ្រឿង និង យាន ផ្សេង ៗ ៥ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . បត់ គ្រោះថ្នាក់ . មិន ប្រកាន់ ស្ដាំ និង ស្រវឹង ។
ទស្សនា រូបភាព ពី សកម្មភាព បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ រស់ នៅ អាមេរិក ជាង ៧០០ នាក់ សំដែង មតិ គាំទ្រ ស្វាគមន៍ វត្តមាន សម្តេច តេជោ ហ៊ុន សែន នៅ ទីស្នាក់ការ អង្គការ សហ ប្រជាជាតិ (UN) នា បុរី ញូវយ៉ក
ក្រុមហ៊ុន ផ្សារ មូលបត្រ កម្ពុជា ប្រឹងប្រែង ញាបញ្ចៀប ចំណេះដឹង លើ វិស័យ មូលបត្រ ដល់ អ្នកសារព័ត៌មាន កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ផ្សារ មូលបត្រ កម្ពុជា (CSX) បាន រៀបចំ សិក្ខាសាលា មួយ ស្ដីពី « ការយល់ដឹង ពី ទីផ្សារ មូលបត្រ នៅ កម្ពុជា » សិក្ខាសាលា នេះ រៀបចំឡើង ផ្ដោត សំខាន់ លើ ការផ្ដល់ ចំណេះដឹង ផ្នែក មូលបត្រ ដល់ អ្នកសារព័ត៌មាន កម្ពុជា និង រួមចំណែក ធ្វើ យ៉ាងណា ចែករំលែក នូវ ចំណេះដឹង នេះ ឲ្យ កាន់តែ ទូលំទូលាយ បន្ថែម ទៀត ។
សិក្សា សាលា នេះ រៀបចំឡើង ក្រោម ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក ហុង សុខ ហួរ អគ្គ នាយកដ្ឋាន ក្រុមហ៊ុន ផ្សារ មូលបត្រ កម្ពុជា លោក ស៊ូ សុជាតិ អគ្គ នាយក នៃ គណៈកម្មការ មូលបត្រ កម្ពុជា ព្រមទាំង អ្នក ព័ត៌មាន ជាច្រើន រូប ថែម ទៀត ផង ។
សូម ជម្រាប ថា ផ្សារ មូលបត្រ កម្ពុជា ជា កន្លែង ដែល មូលបត្រ ត្រូវបាន ទិញ និង លក់ ។ ចំណែក មូលបត្រ ជា កិច្ចសន្យា ហិរញ្ញវត្ថុ ដែល អាច ជួញដូរ បាន ។
លោក ហុង សុខ ហួរ បាន ថ្លែង ឲ្យដឹង ថា សិក្ខាសាលា នេះ ត្រូវបាន រៀបចំឡើង ដើម្បី លើ កម្ពស់ ការយល់ដឹង អំពី វិស័យ មូលត្រ ចំពោះ បងប្អូន អ្នកសារព័ត៌មាន ដែល អ្នក ទាំងអស់ គ្នា ជា តួអង្គ សំខាន់ ក្នុង ការចូលរួម អភិវឌ្ឍន៍ វិស័យ មូលបត្រ នៅ កម្ពុជា តាមរយៈ តួនាទី របស់ ក្នុង ផ្សព្វផ្សាយ ទៅដល់ សាធារណជន ។
លោក ស៊ូ សុជាតិ បាន ឲ្យដឹង ថា ការជំរុញ ការអប់រំ និង ការយល់ដឹង ពី វិស័យ មូលបត្រ ដល់ អ្នកសារព័ត៌មាន ត្រូវបាន កំណត់ ក្នុង ផែនការ យុទ្ធសាស្រ្ដ អាទិភាព រយៈពេល ខ្លី វែង និង មធ្យម សម្រាប់ ការអភិវឌ្ឍន៍ ទីផ្សារ នេះ ព្រោះ ដំណើរការអភិវឌ្ឍន៍ ទីផ្សារ មិន អាច ប្រព្រឹត្តិ ទៅ ដោយ រលូន ឡើយ ប្រសិនបើ គ្មាន ការចូលរួម ពី វិស័យ សារព័ត៌មាន ។
លោក បញ្ជាក់ ទៀត ថា សារព័ត៌មាន ជា ច្រក ដ៏ សំខាន់ មួយ ក្នុង ការជំរុញ ការយល់ដឹង លើ វិស័យ មូលបត្រ និង ការកសាង ទំនុកចិត្ត ពី វិនិយោគិន ជាតិ និង អន្ដរជាតិ ក្រុមហ៊ុន សក្ដានុពល និង ដៃគូ អភិវឌ្ឍន៍ នានា ចំពោះ ទីផ្សារ មូលបត្រ នៅ កម្ពុជា ក៏ ដូចជា វិស័យ ផ្សេង ៗ ទៀត ក្នុង សេដ្ឋកិច្ច កម្ពុជា ។
លោក បាន បន្ដ ទៀត ថា « ខ្ញុំ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ អ្នកសារព័ត៌មាន ទាំងអស់ ដែល តែងតែ ជួយ គាំទ្រ យ៉ាង សកម្ម ក្នុង ផ្សព្វផ្សាយ ដំណើរការអភិវឌ្ឍន៍ ទីផ្សារ មូលបត្រ និង ព្រឹត្តិការណ៍ នានា ពាក់ព័ន្ធ និង វិស័យ មូលបត្រ នៅ កម្ពុជា ក្នុង នោះ មាន ប្រព័ន្ធ ផ្សព្វផ្សាយ មួយចំនួន បាន ស្ម័គ្រចិត្ត ដោយ មិន យក កម្រៃ ថែម ទៀត ផង ។ ទាំង នេះ ជា ការលះបង់ និង ជួយ រួមចំណែក យ៉ាង ធំធេង ដល់ ការអភិវឌ្ឍន៍ វិស័យ មូលបត្រ ក៏ ដូចជា សេដ្ឋកិច្ច ជាតិ ទាំងមូល » ។
សូម បញ្ជាក់ ថា ក្រុមហ៊ុន ផ្សារ មូលបត្រ កម្ពុជា បាន បើក ដំណើរការ ប្រមាណ ជា៦ ឆ្នាំ មកហើយ ដោយ បច្ចុប្បន្ន នេះ មាន ក្រុមហ៊ុន ចំនួន ៥ កំពុង ចុះបញ្ជី ហើយ ផ្សារ មូលបត្រ កម្ពុជា រំពឹង ថា នឹង មាន ក្រុមហ៊ុន ចុះបញ្ជី ចំនួន ២បន្ថែម ទៀត នៅ ចុង ឆ្នាំ នេះ និង ក្រុមហ៊ុន ១ចំនួន ទៀត នៅ ដើម ឆ្នាំ ក្រោយ ៕ កូន ឈើ ប្រណីត ជិត ៥០០ ដើម ត្រូវបាន ក្រុម ជំនួយការ លោក ហ៊ុន ម៉ាណែត និង អាជ្ញាធរ មូលដ្ឋាន ដាំ នៅ សាលា បឋមសិក្សា អង្គ ខ្នារ និង វត្ត អង្គ ខ្នារ ស្រុក ត្រាំ កក់
( តាកែវ )៖ នៅ រសៀល ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ក្រុម ជំនួយការ របស់ ហ៊ុន ម៉ាណែត បាន នាំយក ថវិកា ចំនួន ១៩ លាន រៀល ស៊ីម៉ង់តិ៍១០តោន ឥដ្ឋ១០.០០០ ដុំ ប្រគល់ជូន សាលា បឋមសិក្សា អង្គ ខ្នារ ដើម្បី ជួសជុល អគារ សិក្សា និង របង សាលា រួម ជាមួយ ថវិកា ២លាន រៀល និង ស៊ីម៉ង់តិ៍ ចំនួន ២០តោន ដែល ជា អំណោយ របស់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ន មុន្នី ប្រគេន ដល់ វត្ត អង្គ ខ្នារ សម្រាប់ ការកសាង ក្នុង ទី អារាម នេះ ។
ក្រៅពី អំណោយ ទាំងនេះ ក្រុមការងារ រួម ជាមួយ ប្រជាពលរដ្ឋ អាជ្ញាធរ មូលដ្ឋាន និង សិស្សានុសិស្ស បាន នាំគ្នា ដាំដុះ កូន ឈើ ជិត ៥០០ ដើម ក្នុង ទី អារាម សម្រាប់ ជា ម្លប់ និង រួមចំណែក គាំពារ ដល់ បរិស្ថាន ។
នៅក្នុង ឱកាស សំណេះសំណាល លោក មែ ស៊ីថន បាន នាំ ការផ្តាំ សាកសួរ សុខទុក្ខ ពីសំណាក់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ទូល ប្រគេន ព្រះសង្ឃ គ្រប់ ព្រះអង្គ ជូន លោកយាយ លោកតា និង ប្រជាពលរដ្ឋ ទាំងអស់ ។ លោក បន្ត ថា លោក ហ៊ុន ម៉ាណែត កំពុង បំពេញ បេសកកម្ម នៅ ក្រៅ ប្រទេស ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា កំពុង ចូលរួម កិច្ចប្រជុំ កំពូល នៅឯ អង្គការ សហ ប្រជាជាតិ សហរដ្ឋ អាមេរិក ដើម្បី កិត្យានុភាព កិត្តិយស និង ផលប្រយោជន៍ ជាតិ នៅលើ ឆាក អន្តរជាតិ ។
លោក បាន បង្ហាញ អំពី គម្រូ វីរភាព និង ការលះបង់ ដ៏ ធំធេង របស់ ថ្នាក់ដឹកនាំ និង យុវជន ជំនាន់ មុន ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន ដែល បាន លះបង់ អ្វី ៗ គ្រប់ យ៉ាង និង យក ជីវិត ធ្វើជា ដើមទុន ដើម្បី ស្វែងរក សុខ សន្តិភាព ជូន ប្រជាជន និង ប្រទេសជាតិ ដែល ធ្វើឲ្យ យើង បាន រស់ នៅ សុខសាន្ត និង មាន ឱកាស គ្រប់ បែបយ៉ាង ដូច សព្វ ថ្ងៃ នេះ ។ សម្រាប់ ការដាំដុះ កូន ឈើ លោក បាន បន្ត ថា នេះ ជា ពេលវេលា ដ៏ ល្អ ដែល យើង ទាំងអស់ គ្នា មាន ឱកាស ចូលរួម ដាំ ដើមឈើ ដើម្បី ទុក ជា គុណ ប្រយោជន៍ សម្រាប់ សង្គម និង មនុស្ស ជំនាន់ ក្រោយ ។
លោក អភិបាល រង ស្រុក ត្រាំ កក់ និង លោក អ៊ុន វណ្ណា ក្នុង នាម តំណាង អាជ្ញាធរ ខេត្ត តាកែវ និង ជំនួស មុខ ជូន ប្រជាពលរដ្ឋ អ្នកស្រុក ត្រាំ កក់ សូម ថ្លែងអំណរគុណ ក្រុមការងារ និង គោរព ថ្លែងអំណរគុណ ចំពោះ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ដែល បាន គិតគូរ សុខទុក្ខ ប្រជាពលរដ្ឋ ដោយ បាន ចូលរួម ផ្តល់ អំណោយ ដ៏ ថ្លៃថ្លា នេះ ។
សូម បញ្ជាក់ ថា ក្រៅពី អំណោយ របស់ ខាងលើ ក្រុមការងារ បាន នាំយក អំណោយ អនុស្សាវរីយ៍ របស់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ន មុន្នី រួម មាន សម្ភារ សិក្សា ជូន សិស្សានុសិស្ស ក្រមា ក្រណាត់ សរ និង ថវិកា ជូន លោកយាយ លោកតា និង ប្រជាពលរដ្ឋ ផងដែរ ៕ អភិបាល ខេត្ត កំពង់ស្ពឺ ទស្សនកិច្ច នៅ ប្រទេស ចិន . វិនិយោគិន ចិន ជាច្រើន នៅ ស្រុក ភូឌូ នឹង មក វិនិយោគ នៅក្នុង ខេត្ត កំពង់ស្ពឺ
( ក្វាង ចូវ . ចិន ) ៖ អភិបាល ខេត្ត កំពង់ស្ពឺ លោក វ៉ី សំណាង នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន ដឹកនាំ ប្រតិភូ ដែល មាន អភិបាល ស្រុក ទូទាំង ខេត្ត ដើម្បី ទៅ ទស្សនកិច្ច នៅ ស្រុក ភូឌូ ខេត្ត ក្វាង ចូវ ប្រទេស ចិន រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៩ ខែកញ្ញា រហូតដល់ ថ្ងៃទី ១ ខែតុលា ឆ្នាំ ២០១៨ ។
មន្ត្រី សាលា ខេត្ត កំពង់ស្ពឺ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « នៅ ថ្ងៃ ហ្នឹង លោក អភិបាល ជួប ពិភាក្សា ជាមួយ អភិបាល ស្រុក ភូឌូ ខេត្ត ក្វាង ចូវ ប្រទេស ចិន ។ ខ្លឹមសារ នៃ ជំនួប ហ្នឹង គឺ ថា លោក អភិបាល ខេត្ត បាន អញ្ជើញ អ្នកវិនិយោគិន ស្រុក ភូឌូ មក វិនិយោគ នៅ ខេត្ត កំពង់ស្ពឺ យើង ។ អ្នកភូ ឌូ ជំនាញ គេ ខ្លាំង ហ្នឹង គឺ ពាក់ព័ន្ធ នឹង ការធ្វើ កាបូប គ្រឿង សម្អាង របស់ នារី ។ គេ ( វិនិយោគិន ស្រុក ភូឌូ ) ចាប់អារម្មណ៍ ទៅ វិនិយោគ នៅ ខេត្ត កំពង់ស្ពឺ យើង » ។
លោក បន្ត ថា « ខាង ភូឌូ បាន យល់ ពី សក្តានុពល របស់ ខេត្ត កំពង់ស្ពឺ យ៉ាង ខ្លាំង ហើយ គាត់ ( អភិបាល ស្រុក ភូឌូ ) យល់ព្រម ថា នឹង ជំរុញ អ្នកវិនិយោគិន ស្រុក ភូឌូ ឲ្យ ទៅ វិនិយោគ នៅ ខេត្ត កំពង់ស្ពឺ យើង ហើយ ស្នើឲ្យ អាជ្ញាធ របស់ យើង ជួយ មើល ថែ វិនិយោគិន ភូ ឌូង ហ្នឹង ផង »៕ គណបក្ស ប្រជាជន កម្ពុជា ផ្ញើ សារ រំលែក ទុក្ខ ចំពោះ មរណភាព ឯកឧត្តម នៃ ប៉េណា
( ភ្នំពេញ )៖ គណៈ អចិន្ដ្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា បាន ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន លោកជំទាវ មាឃ ឡាញ់ នៃ ប៉េណា ដោយ បាន ទទួល ដំណឹង ថា « ឯកឧត្តម នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា » បាន ទទួលមរណភាព នៅ ជន្មាយុ ៧៤ ឆ្នាំ នា វេលា ម៉ោង ១រសៀល ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ដោយ រោគា ពាធ ។
គណបក្ស ប្រជាជន កម្ពុជា ទាំងមូល សូម សម្ដែង នូវ ការសោកស្ដាយ គ្មាន អ្វី ប្រៀបផ្ទឹម បាន ឡើង ចំពោះ មរណភាព នេះ និង សូម កត់ត្រា ទុក នូវ រាល់ ស្នាដៃ ឧត្តម គតិ វីរភាព និង គុណ បំណាច់ របស់ ឯកឧត្ដម នៃ ប៉េណា ដែល ជា កុលបុត្រ ដ៏ ប្រពៃ ជា ថ្នាក់ដឹកនាំ និង ជា សកម្ម ដ៏ ឆ្នើម របស់ គណបក្ស ដែល ធ្លាប់ បាន ធ្វើ ពលីកម្ម គ្រប់ បែបយ៉ាង ដើម្បី ផលប្រយោជន៍ របស់ ប្រទេសជាតិ ប្រជាជន កម្ពុជា និង គណបក្ស ប្រជាជន កម្ពុជា កន្លងមក ។
សព របស់ លោក នៃ ប៉េណា តម្កល់ ធ្វើ បុណ្យ នៅ ផ្ទះ លេខ ៣៩១ ផ្លូវ ប៉ូឡាវីស ច្រកទ្វារ ទី២ បុរី ប៉េង ហួត ( បឹង ស្នោរ ) សង្កាត់ និរោធន៍ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។ ពិធី ដង្ហែរសព នឹង ប្រពឹត្ត ទៅ នៅ ព្រឹក ថ្ងៃពុធ ទី ០៣ ខែតុលា ឆ្នាំ ២០១៨ ឆ្ពោះ ទៅកាន់ ឈាប នដ្ឋាន នៅ ទីលាន មុខ វត្ត បុទុមវត្តី ៕
រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន សាយ សំអាល់ ជួប សួរ សុខទុក្ខ កងទ័ព នៅ បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ទី១ ក្នុង ខេត្ត ស្ទឹងត្រែង
( ស្ទឹងត្រែង ) ៖ នៅក្នុង រដូវកាន់ បិណ្ឌ - ភ្ជុំ បិណ្ឌ បុណ្យ ប្រពៃណី ជាតិ ខ្មែរ លោក សាយ សំអាល់ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ជួប សំណេះសំណាល និង សួរសុខទុក្ខ នាយ ទាហាន និង ពល ទាហាន នៅ បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ទី១ ដែល មាន មូលដ្ឋាន នៅ ខេត្ត ស្ទឹងត្រែង នា រសៀល ថ្ងៃទី ២៩ ខែ កញ្ញា ឆ្នាំ ២០១៨ ។
លោក សាយ សំអាល់ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន បាន ថ្លែងអំណរគុណ ដល់ នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន ទាំងអស់ ដែល បាន លះបង់ គ្រប់ បែបយ៉ាង ដើម្បី ការពារ បូរណភាព ទឹកដី របស់ យើង ឲ្យបាន គង់វង្ស និង ផ្តល់ នូវ សុខ សន្តិភាព ជូន ប្រទេសជាតិ មាតុភូមិ ។
លោក រដ្ឋមន្រ្តី បាន បន្ត ថា នៅក្នុង រដូវ ភ្ជុំ បិណ្ឌ បុណ្យ ប្រពៃណី ជាតិ ខ្មែរ ប្រជាពលរដ្ឋ តែងតែ រៀបចំ ពិធី បុណ្យ ឧទ្ទិស កុសល ដល់ ញាតិការ ដែល បាន ចែក ឋាន ទៅ លោក ខាងមុខ នៅ តាម វត្ត អារាម ហើយ នាំយក ថវិកា និង គ្រឿង ឧបភោគ បរិភោគ ជូន អ្នកមាន គុណ ផងដែរ ។ លោក បាន ចាត់ទុក ថា ការជួប សំណេះសំណាល និង សួរសុខទុក្ខ កងទ័ព នៅ ពេល នេះ គឺជា ការរំលឹក គុណ ដល់ អ្នកមាន គុណ ក្នុង នោះ មាន កង ខេមរភូមិន្ទ ដែល បាន លះបង់ សាច់ ស្រស់ ឈាម ស្រស់ ឈរ ជើង ការពារ បូរណភាព ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក សាយ សំអាល់ បាន ថ្លែង ថា នេះ គឺជា ប្រពៃណី ដ៏ ល្អ មួយ រវាង សម ភូមិ ក្រោយ ជួយ ឧបត្ថម្ភ ដល់ សមរភូមិ មុខ ហើយ វា ក៏ ជា វប្បធម៌ ចែករំលែក ផងដែរ ដែល ក្រសួង បរិស្ថាន រួម ជាមួយ វិស័យ ឯកជន បាន ចង សម្ព័ន្ធ មេត្រីភាពរ ជាមួយ កងកម្លាំង បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ទី១ ។
( កំពង់ចាម ) ៖ កម្លាំង នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ឃាត់ខ្លួន ជនសង្ស័យ ប្រុស ស្រី ចំនួន ១០នាក់ ដែល ពាក់ព័ន្ធ ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន ។
ស្នងការ នគរបាល ខេត្ត កំពង់ចាម លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ឲ្យដឹង ថា ប្រតិបត្តិការ នេះ ធ្វើ នៅ ចំណុច ភូមិ ទី ១១ សង្កាត់ កំពង់ចាម ក្រុង កំពង់ចាម ដោយ កម្លាំង ជំនាញ ខេត្ត សហការ ជាមួយ ជំនាញ ស្រុក ស្ទឹងត្រង់ ក្រុង កំពង់ចាម និង ស្រុក កំពង់សៀម ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ ក្រោយ ស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ ទើប កម្លាំង ជំនាញ បាន បង្ក្រាប ករណី ជួញដូរ និង ប្រេី ប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ដោយ ប្រេី វិធាន ញុះញង់ ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ១០នាក់ ស្រី ០២ នាក់ ។
ក្នុង ប្រតិបត្តិការ នេះ ដកហូត បាន ម្សៅ ក្រាម ពណ៌ ស ចំនួន ១៨ កញ្ចប់ ( ធំ ០៤ កញ្ចប់ និង តូច ១៤ កញ្ចប់ ). ទូរស័ព្ទ ដៃ ០៦ គ្រឿង . ម៉ូតូ ០៣ គ្រឿង និង ឡាន ០១ គ្រឿង ។ បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាម កម្លាំង ការិយាល័យ ជំនាញ កំពុង កសាង សំណុំរឿង ដើម្បី ចាត់ការបន្ដ តាម ច្បាប់ ៕ លោក អគ្គ ទេសាភិបាល ជា ចាន់ តូ ៖ ការរីកចម្រើន នៃ វិស័យ ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ នា ពេល បច្ចុប្បន្ន បាន ផ្ដល់ ការងារ ដល់ ពលរដ្ឋ ជាង ៦ម៉ឺន នាក់
( ភ្នំពេញ ) ៖ លោក ជា ចាន់តូ អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា បាន បង្ហាញ ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច និង សង្គម ឲ្យ រីកចម្រើន ទៅ មុខ ។ ការប្រឹងប្រែង ឥត ឈប់ឈរ របស់ រាជ រដ្ឋាភិបាល នេះ បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា ក្លាយជា ប្រទេស មួយ ដែល មាន ការអភិវឌ្ឍន៍ ស្ទើរ គ្រប់ វិស័យ ។
លោក បន្ដ ទៀត ថា ជាក់ស្ដែង វិស័យ ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ បាន រីកចម្រើន ឥត ឈប់ឈរ ។ ការរីកចម្រើន នេះ បាន ផ្ដល់ ការងារ ដល់ ពលរដ្ឋ ជាច្រើន ខណៈ បច្ចុប្បន្ន នេះ ប្រជាពលរដ្ឋ ជាង ៦ម៉ឺន នាក់ បាន ចូល បម្រើ ការងារ ក្នុង វិស័យ ធនាគារ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ។
ការលើកឡើង បែប នេះ របស់ លោក ជា ចាន់តូ ធ្វើឡើង នា ឱកាស ដែល លោក អញ្ជើញ ចូលរួម ក្នុង វេទិកា ស្តីពី « អាជីព ការងារ ក្នុង វិស័យ ធនាគារ និង ការធានារ៉ាប់រង » ដែល កម្មវិធី នេះ រៀបចំឡើង ដោយ វិទ្យាស្ថាន CamEd នា ព្រឹក ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។
លោក បន្ដ ទៀត ថា ក្រៅពី ការរីកចម្រើន លើ វិស័យ ហិរញ្ញវត្ថុ ក៏ មាន វិស័យ មិន មែន ជា ធនាគារ មាន ការរីកចម្រើ ជាច្រើន ដូច ជា៖ វិស័យ មូលប័ត្រ . វិស័យ ធានារ៉ាប់រង និង សោធន វិស័យ ទាំងនេះ បាន រួមចំណែក ផ្តល់ សេវា ហិរញ្ញវត្ថុ ព្រមទាំង ពង្រឹង ការជឿជាក់ និង ភាពច្បាស់លាស់ ចំពោះ អនាគត របស់ ប្រជាជន ដែល ជា មូលដ្ឋានគ្រឹះ ក្នុង ការពង្រឹង សិទ្ធិ សេរីភាព និង លទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ។
លោក ជា ចាន់តូ បាន បន្ថែម ថា ការរីកចម្រើន លើ វិស័យ ធនាគារ នា រយៈពេល ២ទសវត្សរ៍ នេះ បាន រួមចំណែក បង្កើត ការងារ ដោយ ផ្ទាល់ និង ប្រយោល សម្រាប់ សេដ្ឋកិច្ច នៅ ទូទាំង ប្រទេស ។ លោក ថា « ការផ្ដល់ ការងារ ដោយ ផ្ទាល់ មាន ដូច ជា៖ គ្រឹះស្ថាន ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ បាន ផ្ដល់ ការងារ ដល់ ពលរដ្ឋ ចំនួន ៦១.០០០ នាក់ កើនឡើង ៨ដង បើ ធៀប នឹង រយៈពេល កាលពី ១០ឆ្នាំ មុន មាន ន័យ ថា ជា មធ្យម ផ្តល់ ការងារ ថ្មី ក្នុង ១ឆ្នាំ ចំនួន ៥ពាន់ នាក់ ក្នុង អត្រា ២០% » ។
លោក បាន បន្ដ ទៀត ថា ចំណែកឯ ការបង្កើត ការងារ ដោយ ប្រយោល នោះ គឺ ផ្អែក ទៅ លើ វិស័យ ធនាគារ តាមរយៈ ការគាំទ្រ របស់ ធនាគារ ក្នុង ការបង្កើត ឬ ពង្រីក អាជីវកម្ម លើ វិស័យ នានា នៃ សេដ្ឋកិច្ច ។
នា ឱកាស នោះ លោក ជា ចាន់តូ បាន ផ្តាំផ្ញើ ដល់ និស្សិត ដែល នឹង ឈានជើង ចូល ទីផ្សារ ការងារ នា ពេល អនាគត ថា « ដើម្បី ចាប់ ឱកាស ទាំងនេះ បាន សូម ក្មួយ ៗ ត្រូវ បន្ត ខិតខំ ប្រឹងប្រែង ជាប្រចាំ ក្នុង ការដុសខាត់ ពង្រឹង ចំណេះដឹង គុណ វុឌ្ឍិ និង គុណធម៌ សំដៅ ត្រៀមខ្លួន រួមចំណែក បំពេញ ការងារ ក៏ ដូចជា អភិវឌ្ឍន៍ លើ វិស័យ ធនាគារ នា ពេល ខាងមុខ »៕
សាកលវិទ្យាល័យ ប៊ែល ធី នឹង បើក បវេសនកាល ថ្មី ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ លើ មុខជំនាញ ជាច្រើន មុខ ចូលរៀន ថ្ងៃទី ១៦ ខែតុលា
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៧គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
លោក ស សុខា ដឹកនាំ ប្រារព្ធ ទិវា កីឡា អាស៊ាន និង អាស៊ាន ហាត់ប្រាណ ដើម្បី សុខភាព ក្រោម ប្រធានបទ « ជិះ កង់ ដើម្បី សុខភាព »
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ជា តំណាង របស់ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួនណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា . លោក ស សុខា ដែល ជា រដ្ឋលេខាធិការ ចូលរួម ដឹកនាំ ប្រារព្ធ ទិវា កីឡា អាស៊ាន និង អាស៊ាន ហាត់ប្រាណ ដើម្បី សុខភាព ក្រោម ប្រធានបទ « ជិះ កង់ ដើម្បី សុខភាព » ជាមួយ អនុវិស័យ កីឡា និង កីឡាករ - កីឡាការិនី ព្រមទាំង បងប្អូន ប្រជាពលរដ្ឋ ជាច្រើន កុះករ ប្រកបដោយ បរិយាកាស សប្បាយរីករាយ ។
( ហ្សាការតា ) ៖ ចំនួន មនុស្ស បាត់បង់ជីវិត ដោយសារតែ ការវាយប្រហារ ដោយ គ្រោះ រញ្ជួយ ដី ដ៏ មាន ឥទ្ធិពល បូករួម ជាមួយ រលក យក្ស នៅលើ កោះ Sulawesi នៃ ប្រទេស ឥណ្ឌូណេស៊ី បាន កើន ដល់ ៨៣២ នាក់ ហើយ ខណៈ ក្រុម ជួយ សង្រ្គោះ កំពុង ខ្នះ ខ្នែង ជា ទីបំផុត ដើម្បី តាម ស្វែងរក ជន ដែល អាច នៅរស់រាន មាន ជីវិត ព្រមទាំង សាកសព អ្នក ដែល ស្លាប់ នៅ តាម តំបន់ នានា ដែល រង ការវាយប្រហារ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃអាទិត្យ ទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
កាំ កុងត្រូល ខេត្ត បន្ទាយមានជ័យ ទុក ពេល១ ខែ ឲ្យ ម្ចាស់ ហាង ក្រុង ប៉ោយប៉ែត ត្រូវ បញ្ឈប់ ការបិទ តម្លៃ ទំនិញ ជា ភាសា បរទេស បើ មិន បញ្ឈប់ ទេ នឹង ត្រូវ ប្រឈមមុខ នឹង ច្បាប់
( បន្ទាយមានជ័យ )៖ លោក សាន វិជ្ជា សារ៉ា វុធ ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត បន្ទាយមានជ័យ បាន ព្រមាន ថា គ្រប់ បណ្តា ហាង លក់ ទំនិញ ទាំងអស់ ត្រូវតែ បិទ តម្លៃ លើ មុខ ទំនិញ តម្លៃ ជា លុយ រៀល មិន មែន ជា លុយ បរទេស នោះ ទេ បើ មិន បិទ តម្លៃ ទំនិញ ជា ភាសា ខ្មែរ នឹង ត្រូវ ប្រឈមមុខ ចំពោះ ច្បាប់ ។
លោក លើកឡើង យ៉ាង ដូច្នេះ ក្នុង ឱកាស ដឹកនាំ មន្ត្រី កាំ កុងត្រូល សហការ មួយ មន្ត្រី នៃ មន្ទីរ ពាណិជ្ជកម្ម ចុះ ត្រួតពិនិត្យ ទំនិញ ហួស កាលបរិច្ឆេទ ការប្រើប្រាស់ និង ទំនិញ ខូច គុណភាព កាលពី ល្ងាច ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
លោក សាន វិជ្ជា សារ៉ា វុធ បាន គូសបញ្ជក់ ថា មូលហេតុ ដែល លោក ព្រមាន យ៉ាង ដូច្នេះ ដោយ មើលឃើញ ថា រូបិយ បណ្ណ ខ្មែរ មិន សូវ បាន គេ យកមក ប្រើប្រាស់ ក្នុង ការទូទាត់ ទំនិញ នោះ ទេ គឺ គេ យក តែ ប្រាក់ បរទេស ដូចជា ប្រាក់ បាត និង ប្រាក់ ដុល្លារ មក ទូទាត រាល់ ការទិញ ទំនិញ ផ្សេង ៗ ។ ការទូទាត់ ទំនិញ ជា ប្រាក់ បរទេស បណ្តាល មកពី អ្នកលក់ បិទ តារាង តម្លៃ តែ ប្រាក់ បរទេស ។
លោក បញ្ជាក់ បន្ត ថា ដើម្បី លើកកម្ពស់ ប្រាក់ រៀល ទើប លោក ចុះ ធ្វើ ការណែនាំឲ្យ អ្នកលក់ ត្រូវតែ បិទ តម្លៃ ប្រាក់ រៀល លើ មុខ ទំនិញ ឬ អាច បិទ រួមគ្នា ក៏ បាន ។ បើ មិន ព្រម អនុវត្តន៍ តាម ការណែនាំ នេះ មន្ត្រី កាំ កុងត្រូល របស់ លោក នឹង អនុវត្តន៍ តាម ច្បាប់ ដោយ ពិន័យ ជា ប្រាក់ ពី ២លាន រៀល ទៅ៦ លាន រៀល ។
សូម បញ្ជាក់ ថា ចំពោះ ករណី ប្រាក់ រៀល នេះ មិន ដែល មាន អាជ្ញាធរ ឬ សមត្ថកិច្ច ណា លើក មក អនុវត្តន៍ ឬ ឈឺឆ្អាល ឡើយ នេះ ជា លើក ទី១ ហើយ ដែល មាន កាំ កុងត្រូល មន្ត្រី ពាណិជ្ជកម្ម ខេត្ត លើក មក អនុវត្តន៍ ដើម្បី លើកតម្លៃ ប្រាក់ រៀល ខ្មែរ ៕ ឃាត់ខ្លួន មេក្លោង ២នាក់ យក ទៅ ធ្វើ កិច្ចសន្យា អប់រំ រឿង ទិញ ទឹកចិត្ត ប្រជាពលរដ្ឋ ប្រមូល អត្ដសញ្ញាណប័ណ្ណ ចុះ កិច្ចសន្យា ទិញ លក់ ដី ខ្យល់ នៅ ស្រុក លើក ដែក ខេត្ត កណ្តាល
( កណ្តាល ) ៖ មេក្លោង ចំនួន ២នាក់ ដែល បាន និង កំពុង ប្រើ រូបភាព ដើរ ទិញ ទឹកចិត្ត ប្រជាពលរដ្ឋ ដើម្បី ប្រមូល អត្ដសញ្ញាណប័ណ្ណ ចុះ កិច្ចសន្យា ទិញ លក់ ដី ខ្យល់ នៅ ស្រុក លើក ដែក ខេត្ត កណ្តាល កាលពី ពេល ថ្មី ៗ នេះ ត្រូវបាន អាជ្ញាធរ ឃាត់ខ្លួន និង ហៅ ទៅ ធ្វើ កិច្ចសន្យា អប់រំ ឲ្យ បញ្ឈប់ សកម្មភាព ទាំងនេះ ជាបន្ទាន់ ។
យ៉ាងណា ក៏ដោយ សម្រាប់ មេក្លោង ទាំង ២នាក់ ក្រោយ អាជ្ញាធរ ធ្វើ កិច្ចសន្យា អប់រំ រួច មក ក៏ បាន អនុញ្ញាតឲ្យ ត្រឡប់ ទៅវិញ តែ បើ នៅ បន្ត ធ្វើ សកម្មភាព បែប នេះ ទៀត នោះ អាជ្ញាធរ នឹង ចាត់ វិធានការ តាម ច្បាប់ ជាក់ ជា មិន ខាន ឡើយ ។ នេះ បើ យោង តាម សេចក្តីរាយការណ៍ ពី សមត្ថកិច្ច មូលដ្ឋាន ដែល បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។
សូម បញ្ជាក់ ថា ក្នុង រយៈពេល ថ្មី ៗ នេះ មាន ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ដែល រស់ នៅ ឃុំ ព្រែក ដាច់ ឃុំ ព្រែក ទម្លាប់ និង ឃុំ កំពង់ភ្នំ ជាដើម ក្នុង ស្រុក លើក ដែក ខេត្ត កណ្ដាល ត្រូវបាន ក្រុម ឈ្មួញ ដី ទៅ បោក បញ្ឆោត និង ទិញ ទឹកចិត្ត តាមរយៈ ការផ្ដល់ ថវិកា សារ៉ុង និង អង្ករ ជាដើម ដើម្បី ប្រមូល អត្តសញ្ញាណប័ណ្ណ របស់ ពួកគាត់ យក ទៅ ធ្វើ កិច្ចសន្យា ទិញ និង លក់ ដី ប៉ុន្ដែ ធាតុ ពិត ដី ទាំងនោះ មាន ម្ចាស់ ពិតប្រាកដ ដោយ ម្ចាស់ ខ្លះ រស់ នៅ ភ្នំពេញ និង ម្ចាស់ ផ្សេង ទៀត រស់ នៅក្នុង មូលដ្ឋាន តែម្ដង ។
មូលហេតុ ដែល ក្រុម ឈ្មួញ បាន បង្កើត ចលនា អនាធិបតេយ្យ បែប នេះ ដោយសារតែ ពួកគេ បាន ចុះ កិច្ចសន្យា ជាមួយ ក្រុមហ៊ុន ចិន ក្នុង ការរៀបចំ ទិញ ដីធ្លី នៅ តំបន់ ទាំងនោះ រួចហើយ ដល់ ពេល ចុះ ទៅ ទិញ ស្រាប់តែ ទិញ មិន បាន ដោយសារ ម្ចាស់ ដី មិន លក់ ទើប ឲ្យ ពួកគេ ខក ពាក់កណ្ដាល ផ្លូវ និង ត្រូវ ប្រឈម ជាមួយ ក្រុមហ៊ុន ចិន ទៀត នោះ បានជា បង្កើត ល្បិច ថ្មី ទិញ ទឹកចិត្ត ពលរដ្ឋ ធ្វើជា រនាំង បង្កើត កិច្ចសន្យា លក់ ដី ខ្យល់ តែម្ដង ។
លោក ម៉ៅ ភិរុណ ថែមទាំង ប្រកាស ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ មិន លើកលែង ឲ្យ នោះ ឡើយ ចំពោះ ក្រុម ឈ្មួញ ទុចរិត ដែល បាន ធ្វើ រឿង មួយ នេះ ទៅ លើ ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន នោះ ។ លោក ម៉ៅ ភិរុណ បាន បញ្ជាក់ ថា « សូម អរគុណ បាន ផ្តល់ ព័ត៌មាន ពី ករណី ខាងលើ នេះ ខ្ញុំ ស្រាវជ្រាវ នឹង ចាត់ វិធានការ ទប់ស្កាត់ និង ង្ក្រាប សកម្មភាព ខុស ច្បាប់ នេះ » ។
ដោយឡែក អភិបាល ស្រុក លើក ដែក ខេត្ត កណ្ដាល លោក នូវ សំណាង ក៏ បាន បញ្ជាក់ ផងដែរ ថា ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ នេះ លោក ក៏ ទទួល ព័ត៌មាន យ៉ាង ដូច្នេះ ដែរ និង បាន ចាត់ ឲ្យ មេឃុំ ចុះ ទៅ ស្រាវជ្រាវ និង ប្រមូល ព័ត៌មាន ផងដែរ ប៉ុន្ដែ មិន ទាន់ ទទួលបាន លទ្ធផល ផ្លូវការ នៅឡើយ ។
លោក អភិបាល ស្រុក ក៏ បាន ប្រាប់ ទៅ មេឃុំ ឲ្យ ណែនាំ ប្រជាពលរដ្ឋ ទាំងនោះ បើសិន មាន ករណី នេះ កើតឡើង ត្រូវ ពន្យល់ និង ប្រាប់ គាត់ កុំ ឲ្យ ចាញ់បោក ពី ការទិញ ទឹកចិត្ត ពីព្រោះ បើ ផ្ដិត មេដៃ ជូន គេ ហើយ ត្រូវ ទទួលខុសត្រូវ មាន ដី លក់ ឲ្យ គេ ។
ការបញ្ជាក់ របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅ យប់ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ម៉ោង នៅ ទីក្រុង ញូវយ៉ក ក្នុង ពេល សម្ដេច ជួប សំណេះសំណាល ជាមួយ បងប្អូន ខ្មែរ នៅ អាមេរិក ប្រមាណ ជា ២ពាន់ នាក់ នៅក្នុង សណ្ឋាគារ មួយ កន្លែង ក្នុង ទីក្រុង ញូវយ៉ក ក្រោយ សម្ដេច បញ្ចប់ បេសកកម្ម ការងារ ដ៏ មមាញឹក ហើយ នោះ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា នៅពេល ប្រជាពលរដ្ឋ ខ្មែរ អាមេរិក បាន ប្រព្រឹត្ត អំពើ ខុស ច្បាប់ ហើយ ត្រូវ ជាប់ ពន្ធនាគារ នោះ បងប្អូន និង ក្រុមគ្រួសារ របស់ ពលរដ្ឋ នោះ អាច ចូលទៅ សួរសុខ បាន ប៉ុន្ដែ នៅពេល អនុវត្ត ទោស ចប់ សព្វគ្រប់ ហើយ ត្រូវ បញ្ជូន មក ប្រទេស កម្ពុជា វិញ នោះ គឺ មាន តែ ការព្រាត់ប្រាស់ ប៉ុណ្ណោះ ។
ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ទាំង ខ្ញុំ ក្ដី ទាំង សមាជិក រាជ រដ្ឋាភិបាល ក្ដី មើល ទៅ វា ពិបាក ភ្នែក ពេក អាណិត ខ្លោច ចិត្ត ពេក ចំពោះ ពលរដ្ឋ របស់ យើង ជាប់ គុក នៅ ស្រុក អាមេរិក ហើយ អាមេរិក ត្រូវ បញ្ជូន ទៅ ប្រទេស កម្ពុជា ។ ការ ជាប់ គុក នៅ អាមេរិក វា ជា រឿង ទោសទណ្ឌ មួយ ទៅ ហើយ ក៏ប៉ុន្ដែ ទោសទណ្ឌ ធ្ងន់ លើស ពី នេះ ទៅ ទៀត គឺ ការព្រាត់ប្រាស់ គ្នា » ។
សម្ដេច តេជោ ហ៊ុន សែន បាន បន្ដ ថា « កាល ពេល ជាប់ គុក នៅ អាមេរិក បងប្អូន គេ អាច ទៅ សួរសុខទុក្ខ បាន ខ្លះ ប្ដី ជាប់ គុក ប្រពន្ធ ទៅ សួរសុខទុក្ខ ខ្លះ កូន ជាប់ គុក ម្ដាយ ទៅ សួរសុខទុក្ខ ឪពុក ជាប់ គុក កូន ទៅ សួរសុខទុក្ខ ប៉ុន្ដែ នៅ ពេល ដែល ចេញ ពី គុក ហើយ អាមេរិក បញ្ជូន ទៅ ស្រុក ខ្មែរ ព្រាត់ រហូត លើកលែងតែ ក្រុមគ្រួសារ គេ អាច ធ្វើដំណើរ ទៅ ស្រុក ខ្មែរ » ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ក៏ បាន សង្កត់ធ្ងន់ ថា ចំពោះ ករណី ចាប់បញ្ជូន ពលរដ្ឋ ខ្មែរ អាមេរិក ដែល ជាប់ ពន្ធនាគារ នេះ ធ្លាប់ មាន ពលរដ្ឋ ខ្មែរ ៥នាក់ បាន ធ្វើ អត្តឃាត ដោយសារតែ តូចចិត្ត នឹង រាជ រដ្ឋាភិបាល អាមេរិក ដែល ចាប់ បញ្ជូន ពួកគាត់ ត្រឡប់មក ប្រទេស កម្ពុជា ឲ្យ ព្រាត់ ព្រាស់ ក្រុមគ្រួសារ ។
សូម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋាភិបាល អាមេរិក បាន ចុះ កិច្ចព្រមព្រៀង បញ្ជូន និង ទទួលយក ពលរដ្ឋ ខ្មែរ ពី សហរដ្ឋ អាមេរិក ឲ្យ ត្រឡប់មក កម្ពុជា វិញ ចាប់តាំងពី ឆ្នាំ ២០០២ ។ កិច្ចព្រមព្រៀង នេះ រដ្ឋាភិបាល សហរដ្ឋ អាមេរិក នឹង បញ្ជូន ពលរដ្ឋ ខ្មែរ ណា ដែល ប្រព្រឹត្ត ល្មើស ឲ្យ ត្រឡប់មក មាតុភូមិ វិញ ក្រោយពេល អនុវត្ត ទោស រួចរាល់ ។
ប៉ុន្តែ កាលពី ចុង ឆ្នាំ ២០១៧ ការបញ្ជូន ពលរដ្ឋ ខ្មែរ ពី អាមេរិក ត្រូវបាន ខកខាន ដោយសារតែ សហរដ្ឋ អាមេរិក មិន ព្រម តាម សំណើ កម្ពុជា ដែល ស្នើឲ្យ កែប្រែ លក្ខខណ្ឌ មួយចំនួន នៅក្នុង កិច្ចព្រមព្រៀង នេះ ដោយ ឈរ លើ គោលការណ៍ ស្ម័គ្រចិត្ត ។
សហរដ្ឋ អាមេរិក បាន សម្រេច ផ្អាក ទិដ្ឋាការ ដល់ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង ការបរទេស និង សាច់ញាតិ របស់ ពួកគេ ដែល រដ្ឋាភិបាល កម្ពុជា បាន ចាត់ទុក ថា ដោយសារតែ ការសើរើ កិច្ចព្រមព្រៀង នេះ ។ ជាមួយគ្នា នេះ កម្ពុជា ក៏ បាន សម្រេច ផ្អាក កិច្ច សហប្រតិបត្តិការ កម្ពុជា - អាមេរិក ក្នុង ការរុករក អដ្ឋិធាតុ ទាហាន អាមេរិក ដែល បាត់ខ្លួន នៅ កម្ពុជា ក្នុង សម័យ សង្គ្រាម ផងដែរ ។
សូម រំលឹក ថា កាលពី អំឡុង ខែមេសា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ ពលរដ្ឋ ខ្មែរ រស់ នៅ សហរដ្ឋ អាមេរិក ចំនួន ៤៣ នាក់ ក្នុង នោះ ស្ដ្រី ៣នាក់ បាន បញ្ជូន មកដល់ ប្រទេស កម្ពុជា ក្រោយ អនុវត្ត ទោស ក្នុង ជាប់ ពន្ធនាគារ ចប់ សព្វគ្រប់ ក្នុង នោះ មាន ពលរដ្ឋ អ្នក ខ្លះ មាន បញ្ហា សុខភាព ផងដែរ ៕
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន អញ្ជើញ ចូលរួម គោរព វិញ្ញាណក្ខន្ធ ស ព ឯកឧត្តម នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង សហការី ទាំងអស់ នៃ កាកបាទ ក្រហម កម្ពុជា នៅ ព្រឹក ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ចូលរួម គោរព វិញ្ញាណក្ខន្ធ សព ឯកឧត្ដម នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា ដែល បាន ទទួលមរណភាព ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម សម្ដែង នូវ ការសោកស្ដាយ និង ក្ដុកក្ដួល រំជួល ចិត្ត ឥត ឧបមា រក អ្វី ប្រៀបផ្ទឹម ពុំ បាន ចំពោះ មរណភាព របស់ ឯកឧត្ដម នៃ ប៉េណា ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ វេលា ម៉ោង ១៣៖០០ នាទី ក្នុង ជន្មាយុ ៧៤ ឆ្នាំ ដោយ រោគា ពាធ ។
ជាមួយ មរណភាព ដ៏ ក្រៀមក្រំ ជា ទីបំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ ស ព ឯកឧត្ដម នៃ ប៉េណា បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ ព្រឹទ្ធសភា ចូលរួម រំលែក មរណទុក្ខ និង សម្តែង ការសោកស្តាយ ចំពោះ មរណភាព របស់ លោក នៃ ប៉េណា
( ភ្នំពេញ ) ៖ ព្រឹទ្ធសភា កម្ពុជា តាមរយៈ លោក ទេព ង ន ប្រធាន ស្តីទី ព្រឹទ្ធសភា បាន សម្តែង ការសោកស្តាយ យ៉ាង ក្រៃលែង ចំពោះ មរណភាព របស់ លោក នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា ។
ក្នុង សាលិខិត ចូលរួម រំលែក មរណទុក្ខ ផ្ញើ ជូន លោកស្រី មាឃ ឡាញ់ ភរិយា សព លោក នៃ ប៉េណា នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោក ទេព ង ន បាន គូសបញ្ជាក់ ថា លោក នៃ ប៉េណា ជា ឥស្សរជនជាតិ ដ៏ ឧត្តុងឧត្តម ដែល បាន យក អស់ កម្លាំង កាយ ចិត្ត ប្រាជ្ញា និង ស្មារតី ដើម្បី បម្រើ ជាតិ មាតុភូមិ និង បាន ចូលរួម ក្នុង ចលនា តស៊ូ រំដោះ ប្រទេសជាតិ ដើម្បី សន្តិភាព និង ការអភិវឌ្ឍ ។
ក្នុង លិខិត នេះ បាន រំលេច ទៀត ថា ក្នុង នីតិកាល ទី៣ រហូតដល់ នីតិកាល ទី៤ នៃ ព្រឹទ្ធសភា លោក នៃ ប៉េណា បាន បំពេញ បេសកកម្ម ដ៏ ថ្លៃថ្លា ក្នុង ការបម្រើ ព្រឹទ្ធសភា ប្រកបដោយ ស្មារតី ស្នេហាជាតិ និង ប្រជាជន ដើម្បី រួមចំណែក ក្នុង ដំណើរការពង្រឹង នីតិរដ្ឋ លទ្ធិ ប្រជាធិបតេយ្យ និង លើកកម្ពស់ កិត្យានុភាព ជាតិ ទាំង ក្នុង តំបន់ និង លើ ឆាក អន្តរជាតិ ។
សូម បញ្ជាក់ ថា លោក នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ម្សិលមិញ នេះ ក្នុង ជន្មាយុ ៧៤ ឆ្នាំ ដោយ រោគា ពាធ ៕
ប្រធាន រដ្ឋសភា សម្តែង ការសោកស្តាយ ចំពោះ មរណភាព របស់ អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ ប្រធាន រដ្ឋសភា កម្ពុជា សម្តេច ពញា ចក្រី ហេង សំរិន បាន សម្តែង ក្តី រន្ធត់ និង សោកស្តាយ ក្រៃលែង ចំពោះ មរណភាព របស់ លោក នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា ។
ក្នុង សារលិខិត ចូលរួម រំលែក ទុក្ខ ផ្ញើ ជូន ភរិយា សព លោក នៃ ប៉េណា នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ សម្តេច ហេង សំរិន បាន ហៅ មរណភាព របស់ លោក នៃ ប៉េណា គឺជា ការបាត់បង់ ស្វាមី ឪពុក ឪពុក ក្មេ និង ជីតា ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជា ការបាត់បង់ នូវ ឥរស្សរជន ដ៏ ឆ្នើម មួយ រូប ដែល បាន លះបង់ គ្រប់ បែបយ៉ាង ក្នុង ការបម្រើ ជាតិ មាតុភូមិ គ្រប់ កាលៈទេសៈ ។
រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម ជំរុញ កសិករ ចងក្រង ជា សហគមន៍ កសិករ ក្នុង ការផលិត ស្រូវ ឲ្យ មាន លក្ខណៈ ស្តង់ដារ ស្រប តាម ទីផ្សារ អន្តរជាតិ
ក្នុង ដំណើរ ចុះ ពិនិត្យ នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ដែល អម ដំណើរ ដោយ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ នោះ លោក វេង សា ខុន បាន សម្តែង នូវ សេចក្តីរីករាយ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមិទ្ធិផល ដ៏ ល្អ ប្រសើរ ដែល ក្រុមហ៊ុន សម្រេចបាន ។
យោង តាម ការរាយការណ៍ របស់ ក្រុមហ៊ុន Amru Rice បាន ឲ្យដឹង ថា ក្រុមហ៊ុន បាន ប្រមូលផ្តុំ ស្រូវ ដែល ផ្គត់ផ្គង់ ដោយ សហគមន៍ តាមរយៈ ផលិតកម្ម កសិកម្ម តាម កិច្ចសន្យា ហើយក៏ ជា កន្លែង ចុងក្រោយ នៃ ខ្សែ ចង្វាក់ ផលិតកម្ម ស្រូវ មុន ធ្វើ ការលក់ ចេញ ទាំង នៅក្នុង ស្រុក និង នាំចេញ ទៅ ក្រៅ ប្រទេស ។
អ្វី ដែល គួរ ជា ទី មោទនៈ នោះ បច្ចុប្បន្ន ទូទាំង ប្រទេស ក្រុមហ៊ុន បាន អនុវត្ត ផលិតកម្ម កសិកម្ម ដំណាំ ស្រូវ ជាមួយ ៤៧ សហគមន៍ ក្នុង ខេត្ត គោលដៅ ចំនួន ៧ ដូចជា ខេត្ត ព្រះវិហារ ខេត្ត កំពង់ឆ្នាំង ខេត្ត កំពង់ស្ពឺ ខេត្ត តាកែវ ខេត្ត បាត់ដំបង ខេត្ត កំពង់ចាម និង ខេត្ត កំពង់ធំ ហើយ បាន បង្កើន ការងារ ជូន ៦. ២៤២ គ្រួសារ លើ ផ្ទៃដី សរុប ១៨. ៨៩១ហត ដើម្បី ផលិត ស្រូវ ប្រមាណ ជា ៥២. ៤៧៦តោន សម្រាប់ កែច្នៃ និង ផ្គត់ផ្គង់ ទៅ ទីផ្សារ ក្នុង ស្រុក និង នាំចេញ ។
ទន្ទឹមនឹង នេះ ហេដ្ឋារចនាសម្ព័ន្ធ ដូចជា ឃ្លាំង ស្តុក ស្រូវ ដែល បាន សាងសង់ អស់ ជាង ៨០ ម៉ឺន ដុល្លារ និង មាន លទ្ធភាព ស្តុក ទុក ស្រូវ បាន ជាង ៦ម៉ឺន តោន ក្នុង ១ រដូវកាល ។ ដោយឡែក ចំពោះ ឡសម្ងួត វិញ គឺ អាច សម្ងួត បាន ជាង ១.៦០០ តោន ក្នុង មួយ ថ្ងៃ ។ សរុប ពី ការវិនិយោគ គឺ ក្រុមហ៊ុន បាន ចំណាយ ថវិកា អស់ ប្រមាណ ៩លាន ដុល្លារ ដែល ក្នុង នោះ ក៏ មាន ការចូលរួម ផ្តល់ កម្ចី ឥណទាន ពី ធនាគារ អភិវឌ្ឍន៍ ជនបទ របស់ រាជ រដ្ឋាភិបាល ផងដែរ ៕
អ្នក ឧកញ៉ា ពុង ឃាវ សែ ចែក អំណោយ ដល់ ប្រជាពលរដ្ឋ ដែល ស្ម័គ្រចិត្ត រស់ នៅក្នុង បុរី « រុងរឿង » ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា ពុង ឃាវ សែ អគ្គ នាយក ក្រុមហ៊ុន OCIC បាន អញ្ជើញ ចុះ ចែក អំណោយ ជូន ដល់ ប្រជាពលរដ្ឋ ជាច្រើន គ្រួសារ ដែល ស្ម័គ្រចិត្ត ចូលមក រស់ នៅក្នុង បុរី រុងរឿង នៃ តំបន់ អភិវឌ្ឍន៍ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ ក្នុង ឱកាស ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ប្រពៃណី ជាតិ ខ្មែរ ។ ពិធី ចែក អំណោយ បាន ធ្វើឡើង នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ម្សិលមិញ នេះ ដោយ មាន ការចូលរួម ពី មន្ដ្រី សាលា ខណ្ឌ ជ្រោយ ចង្វារ និង មន្ដ្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ។
ប្រជាពលរដ្ឋ ដែល កំពុង រស់ នៅ យ៉ាង សុខដុមរមនា ក្នុង បុរី រុងរឿង បាន សម្ដែង ភាពសប្បាយរីករាយ យ៉ាង ក្រៃលែង ព្រោះ មាន ផ្ទះ រស់ នៅ សមរម្យ មាន ប្រព័ន្ធ ទឹក ស្អាត ប្រើប្រាស់ មាន ប្រព័ន្ធ លូ ត្រឹមត្រូវ និង លើស ពី នេះ ទៀត ជីវភាពររស់នៅ ក៏ កាន់តែ ល្អ ប្រសើរឡើង ជាលំដាប់ ។
តំណាង ប្រជាពលរដ្ឋ បាន ឲ្យដឹង ថា នៅ បុរី រឿង រឿង នេះ មាន ផ្សារ មាន សាលារៀន សម្រាប់ កូន ចៅ មាន មន្ទីរពេទ្យ មាន ប្រជាពលរដ្ឋ រស់ នៅ យ៉ាង ច្រើន កុះករ ដែល បង្ក លក្ខណៈ ឲ្យ ប្រកប អាជីវកម្ម បង្កើន ប្រាក់ ចំណូល ប្រចាំ ថ្ងៃ ល្អ ប្រសើរ និង ខ្លះ ទៀត ទទួលបាន ការងារ ក្នុង បុរី និង ទទួលបាន ប្រាក់ បៀវត្ស សមរម្យ ដែល ផ្ទុយ ស្រឡះ ពីមុន ពួកយើងខ្ញុំ ធ្លាប់ ជា កសិករ រស់នៅ ដាច់ស្រយាល និង មាន ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ខ្វះខាត ។
បើ តាម តំណាង ក្រុមហ៊ុន បាន និយាយ ថា កន្លងមក ក្រុមហ៊ុន បាន ធ្វើ ការចែក អំណោយ សប្បុរសធម៌ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល បាន ស្ម័គ្រចិត្ត រស់ នៅក្នុង បុរី រុងរឿង តំបន់ អភិវឌ្ឍន៍ ជ្រោយ ចង្វារ រាជធានី ភ្នំពេញ បាន ចំនួន ១៩ លើក រួច មកហើយ ហើយ នេះ ក៏ ជា លើក ទី២០ ផងដែរ ។
តំណាង ក្រុមហ៊ុន និយាយ ថា កត្តា ទាំងអស់ ខាងលើ នេះ ហើយ ទើប ជំរុញ ឲ្យ ប្រជាពលរដ្ឋ យល់ព្រម ទទួលយក នូវ គោល នយោបាយ ដោះដូរ ផ្ទះ ជាមួយ សាលា រាជធានី ភ្នំពេញ និង ក្រុមហ៊ុន ពី ផ្ទះ តូច ធ្វើ អំពី ឈើ ប្រក់ ស័ង្កសី មក ជា ផ្ទះ ថ្ម ធ្វើ អំពី ឥដ្ឋ បេតុង វិញ ហើយ មាន ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ គ្រប់គ្រាន់ ជាប់ ទីប្រជុំជន មាន ផ្សារ សម្រាប់ ប្រកបរបរ រកស៊ី ចិញ្ចឹម ជីវិត ។
តំណាង ក្រុមហ៊ុន បាន បន្ថែម ទៀត ថា លើស ពី នេះ ទៀត តម្លៃ ទីផ្សារ អចលន ទ្រព្យ របស់ ពួកគាត់ មាន ការកើនឡើង ខ្ពស់ បន្ទាប់ពី គម្រោង តំបន់ អភិវឌ្ឍន៍ ទីក្រុង រណប ជ្រោយ ចង្វារ ថ្មី នេះ លេចចេញ ជា រូបរាង ឡើង ។
សូម បញ្ជាក់ ថា អំណោយ សប្បុរសធម៌ របស់ អ្នក ឧកញ៉ា ពុង ឃាវ សែ អគ្គ នាយក ក្រុមហ៊ុន OCIC ជូន ប្រជាពលរដ្ឋ ដែល ស្ម័គ្រចិត្ត រស់ នៅក្នុង បុរី រុងរឿង បើ គិត ពី ការចំណាយ តាំងពី លើក ទី១ ដល់ លើក ទី២០ នេះ អ្នក ឧកញ៉ា ពុង ឃាវ សែ បាន ចំណាយ អស់ ទឹកប្រាក់ សរុប មាន ចំនួន ប្រមាណ ៥០១ លាន ៩សែន រៀល ហើយ ។
ថ្លែង នៅ ចំពោះ មុខ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ ក្នុង ទីក្រុង ញូយ៉ក លោក វ៉ាង យី បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « គំនិត គំាពារ និយម គឺ មាន តែ ធ្វើឱ្យ ខ្លួន ឯង ខាតបង់ និង ឈឺចាប់ រីឯ គំនិត ឯកតោ ភាគី មាន តែ នាំ ទៅ រក ការបំផ្លិចបំផ្លាញ ដល់ មនុស្ស គ្រប់ គ្នា ប៉ុណ្ណោះ .. . ហើយ ទីក្រុង ប៉េកាំង គ្មាន ចេតនា អាក្រក់ បង្ក ជម្លោះ ឬ ធ្វើឱ្យ ជម្លោះ កាន់តែ តានតឹង នោះ ទេ » ។
គួរ បញ្ជាក់ ថា បច្ច ប្បន្ន ទំនាក់ទំនង រវាង សហរដ្ឋ អាមេរិក និង ចិន កំពុង មាន ភាពតានតឹង នឹង គ្នា យ៉ាង ខ្លាំង ដោយសារតែ សង្រ្គាម ពាណិជ្ជកម្ម ដំឡើង ពន្ធ រវាង ប្រទេស ទាំង ពីរ ជាមួយ ការដំឡើង ពន្ធ ២០០ ពាន់ លាន ដុល្លារ ពីលើ ផលិតផល នាំចូល ពី ចិន របស់ សហរដ្ឋ អាមេរិក និង ការសងសឹង របស់ ចិន ៦០ ពាន់ លាន ដុល្លារ លើ ផលិតផល អាមេរិក ៕
កាល បរិឆ្ឆេទ ខាងលើ នា ឆ្នាំ ក្រោយ នេះ គឺជា កាល កំណត់ ចុងក្រោយ បំផុត ដែល រដ្ឋាភិបាល យោធា របស់ លោក ប្រាយុទ្ធ បាន សន្យា ថា នឹង រៀបចំ ការបោះឆ្នោត សាកល ដែល នឹង អនុញ្ញាតឲ្យ ប្រទេស ថៃ វិល ទៅរក ការគ្រប់គ្រង បែប ស៊ីវិល វិញ បន្ទាប់ពី ស្ថិត ក្រោម ការដឹកនាំ ដោយ រដ្ឋាភិបាល យោធា អស់ រយៈពេល ជាង ០៤ ឆ្នាំ មកហើយ ។ ប៉ុន្តែ នា ពេល កន្លងមក នេះ រដ្ឋាភិបាល ថៃ ក៏ ធ្លាប់ បាន ពន្យារ ពេល ជាច្រើន លើក ច្រើន សា ផងដែរ ។
គួរ ជម្រាប ថា ការប្រកាស បង្កើត បក្ស នយោបាយ នេះ បាន កើត មាន ឡើង បន្ទាប់ពី លោក ប្រាយុទ្ធ ចាន់ អូចា បាន និយាយ ថា រូប លោក មាន ចំណាប់អារម្មណ៍ ក្នុង ឆាក នយោបាយ ។ រដ្ឋមន្រ្តី ទាំង ០៤ រូប ខាងលើ គឺជា អ្នកដំបូង គេ នៅក្នុង ជួរ គណៈ រដ្ឋមន្រ្តី របស់ លោក ប្រាយុទ្ធ ដែល បាន បង្កើត គណបក្ស នយោបាយ ។ ទន្ទឹមនឹង នេះ មន្រ្តី ទាំង ០៤ រូប ពុំ បាន ប្រកាស លា លែង ពីមុខតំណែង បច្ចុប្បន្ន នោះ ឡើយ ៕
៦៖ សរុប ព្រឹត្តិការ ណ៍៖ អ្នក ជាប់ ឃុំ ចំនួន ២២ នាក់ រួម មាន អ្នកនយោបាយ សកម្មជន ដីធ្លី និង អ្នកសារព័ត៌មាន ត្រូវបាន ដោះលែង ក្នុង រយ : ពេល ២ខែ ចុងក្រោយ នេះ ( ចុច អាន )
៨៖ នាយក រដ្ឋមន្ត្រី ប្រទេស ម៉ាឡេស៊ី ផ្ញើ សារលិខិត ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី អបអរសាទរ ចំពោះ ជ័យជម្នះ របស់ គណបក្ស ប្រជាជន កម្ពុជា សម្រាប់ អាណត្តិ ថ្មី ( ចុច អាន )
ថ្ងៃ នេះ ជា ថ្ងៃ កាន់ បិណ្ឌ ទី៦. សូម ស្វែងយល់ អំពី ប្រវត្តិ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ដែល ជា ទំនៀមទម្លាប់ របស់ បងប្អូន ប្រជាជន ខ្មែរ
ក្នុង ជំនួប នោះ សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ ក្តី នឹករលឹក របស់ សម្តេច តេជោ ចំពោះ បងប្អូន ខ្មែរ នៅ អាមេរិក និង បាន អរគុណ ដល់ បងប្អូន ខ្មែរ ដែល បាន រង់ចាំ ជួប សម្តេច ។ សម្តេច នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក៏ បាន ថ្លែង បង្ហាញ ពី ស្ថានការណ៍ នយោបាយ នៅ កម្ពុជា ព្រមទាំង ការងារ ដឹកនាំ និង អភិវឌ្ឍ ជាតិ ជាច្រើន ទៀត ។
ខាងក្រោម នេះ គឺជា ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ពេល ជួប សំណេះសំណាល ជាមួយ បងប្អូន ខ្មែរ នៅ អាមេរិក រយៈពេល ជាង ពីរ ម៉ោ ង៖
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ពលរដ្ឋ ខ្មែរ នៅ អាមេរិក ទាំងអស់ ដែល បាន ស្វាគមន៍ ចំពោះ ដំណើរ របស់ សម្តេច ។ សម្តេច បាន ហៅ ការស្វាគមន៍ របស់ បងប្អូន ខ្មែរ នៅ អាមេរិក គឺជា ការលើកទឹកចិត្ត សម្តេច ។
* សម្តេច តេជោ ប្រាប់ ខ្មែរ នៅ ក្រៅ ប្រទេស ថា នឹង ធ្វើជា នាយក រដ្ឋមន្ត្រី រហូតដល់ ក្រុម ប៉ុនប៉ង បំផ្លាញ ជាតិ រលាយ រលត់ ពី ភព ផែនដី នេះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ ពលរដ្ឋ ខ្មែរ នៅ ប្រទេស បើ ទោះបី មិន បាន ទៅ ចូលរួម បោះឆ្នោត តែ បាន ធ្វើ វីដេអូ ឃ្លីប អំពាវនាវ ឲ្យ ខ្មែរ នៅក្នុង ស្រុក ចេញ ទៅ បោះឆ្នោត ដែល ជា ការគាំទ្រ ដល់ ដំណើរការលទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ។ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការអំពាវនាវ របស់ ខ្មែរ នៅ ក្រៅ ប្រទេស គឺជា រឿង ត្រឹមត្រូវ ហើយ ការបោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ស្មើនឹង ការបោះឆ្នោត ការពារ នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី ប្រាប់ ខ្មែរ នៅ ក្រៅ ប្រទេស ថា សម្តេច មិន អនុញ្ញាត និង អត់ឱន ឲ្យ នរណា ម្នាក់ នាំ កម្ពុជា ទៅ រក ភ្លើង សង្គ្រាម ជាថ្មី នោះ ឡើយ ទោះ ក្នុង តម្លៃ ណា ក៏ដោយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ឆ្អែត ឆ្អន់ ហើយ ចំពោះ ភ្លើង សង្គ្រាម រហូត ត្រូវ ពិការ ភ្នែក ម្ខាង ថែម ទៀត ផងដែរ ។ ដូច្នេះ សម្តេច មិន ចង់ ឃើញ សង្គ្រាម បំផ្លាញ កម្ពុជា កើតឡើង ជាថ្មី នោះ ឡើយ ។
* ក្នុង ជំនួប សំណេះសំណាល ជាមួយ ខ្មែរ នៅ ក្រៅ ប្រទេស សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក ពី ប្រវត្តិ នៃ ការបែកបាក់ របស់ ជាតិ ខ្មែរ ពី អតីតកាល និង ការឈាន មកដល់ ការបង្រួបបង្រួម ជាតិ ជា ធ្លុង បញ្ចប់ ការបែកបាក់ និង ការបង្រួបបង្រួម ជាតិ មិន ធ្លាប់ មាន ក្នុង ប្រវត្តិសាស្ត្រ ខ្មែរ ក្នុង រយៈពេល ប្រមាណ ៥០០ ឆ្នាំ ចុងក្រោយ នៅ ចុង ឆ្នាំ ១៩៩៨ តាមរយៈ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បុណ្យ ភ្ជុំ បិណ្ឌ នេះ នឹង មាន ការដោះលែង អ្នកទោស ទ្រង់ទ្រាយ ធំ ហើយ ក្រសួង មហាផ្ទៃ និង ក្រសួង យុត្តិធម៌ កំពុង ធ្វើការ លើ រឿង នេះ ។ សម្តេច តេជោ បាន ហៅ ការដោះលែង នេះ ដើម្បី អបអរសាទរ ខួប ២០ ឆ្នាំ នៃ ការបិទ បញ្ចប់ ភ្លើង សង្គ្រាម នៅ កម្ពុជា ហើយក៏ ចង់ ឃើញ ពលរដ្ឋ ខ្មែរ មាន កាស កសាង ខ្លួន ជាថ្មី ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការ ដែល សម្តេច តវ៉ា រឿង អាមេរិក បញ្ជូន ពលរដ្ឋ ខ្មែរ អាមេរិក ទៅ កម្ពុជា វិញ ព្រោះតែ មិន ចង់ ឃើញ ការព្រាត់ប្រាស់ របស់ ពលរដ្ឋ ខ្មែរ ដែល ជា ការឈឺចាប់ មួយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ប្រាប់ ខ្មែរ នៅ អាមេរិក ថា កិច្ចការ អាទិភាព របស់ រាជ រដ្ឋាភិបាល គឺ ស្ថេរភាព នយោបាយ និង ម៉ាក្រូ សេដ្ឋកិច្ច ។ សម្តេច តេជោ ថា បញ្ហា ទាំង ពីរ នេះ គឺជា បញ្ហា សំខាន់ មិន អាច កាត់ផ្តាច់ ពី គ្នា បាន ពោល បើ គ្មាន ស្ថេរភាព នយោបាយ គឺ គ្មាន ស្ថេរភាព សេដ្ឋកិច្ច ហើយ បើ គ្មាន ស្ថេរភាព សេដ្ឋកិច្ច ក៏ មិន អាច ធានា បាន ស្ថេរភាព នយោបាយ នោះ ដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រឿង ឆក់ ប្លន់ មិន មែន មាន តែ នៅ កម្ពុជា នោះ ទេ អាមេរិក ក៏ មាន ដូចគ្នា ផងដែរ ។ ប៉ុន្តែ កម្ពុជា ត្រូវ បង្កើត ការយកចិត្តទុកដាក់ លើ បញ្ហា សន្តិសុខ សណ្តាប់ធ្នាប់ ក្នុង សង្គម បន្ថែម ទៀត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា អតិផរណា គឺជា រឿង មួយ ដែល រាជ រដ្ឋាភិបាល កំពុង យកចិត្ត ដាក់ គ្រប់គ្រង ខ្ពស់ ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច ឲ្យ ក្រសួង សេដ្ឋកិច្ច សន្សំ លុយ ឲ្យ សម្តេច បើ រាជ រដ្ឋាភិបាល ជួប បញ្ហា សេដ្ឋកិច្ច ក៏ អាច បើក ប្រាក់ខែ ឲ្យ មន្ត្រីរាជការ បាន ១០ខែ ផងដែរ ។
* សម្តេច តេជោ បាន ថ្លែង ថា បច្ចុប្បន្ន រាជ រដ្ឋាភិបាល កំពុង ប្រើ ប្រព័ន្ធ បច្ចេកវិទ្យា ដើម្បី បំបាត់ អំពើពុករ លុយ ក្នុង ក្របខណ្ឌ មន្ត្រីរាជការ ដូចជា មន្ត្រី ខ្មោច និង មន្ត្រី ម្នាក់ បើក ប្រាក់ខែ ច្រើន ក្រសួង ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា វិស័យ កសិកម្ម របស់ កម្ពុជា ពេល បច្ចុប្បន្ន ប្រៀប ដូចជា មាន មាស តែ អត់ ក្រដាស ខ្ចប់ ។ ក្នុង ន័យ នេះ គឺ សម្តេច ចង់ឲ្យ មាន ការ បង្កើត រោងចក្រ កែច្នៃ ឲ្យបាន កាន់តែ ច្រើន ដើម្បី កែច្នៃ កសិផល ទាំងអស់ នេះ សម្រាប់ នាំចេញ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ផងដែរ ថា ក្រៅពី មាន មហិច្ឆតា បង្កើត រោងចក្រ កែច្នៃ កសិផល ហើយ នោះ រាជ រដ្ឋាភិបាល ក៏ កំពុង គិតគូរ ទៅ លើ វិស័យ សេវា និង ទេសចរណ៍ ផងដែរ ។ តែ ទោះជា យ៉ាងណា វិស័យ កសិកម្ម នៅតែ ត្រូវ យកចិត្តទុកដាក់ ឲ្យបាន ខ្ពស់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គោលដៅ របស់ រាជ រដ្ឋាភិបាល នៅ ឆ្នាំ ២០២០ ប្រជាពលរដ្ឋ គ្រប់ ភូមិ មាន អគ្គិសនី ប្រើប្រាស់ ខណៈ បច្ចុប្បន្ន សម្រេចបាន ៨២ ភាគរយ ហើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល ចង់ឲ្យ មាតា និង កុមារ កម្ពុជា មាន សុខភាព ល្អ ទើប បាន បច្ចុប្បន្ន រាជ រដ្ឋាភិបាល កំពុង យកចិត្តទុកដាក់ លើ សេវា គាំពារ សង្គម និង មាន ការឧបត្ថម្ភ ដល់ ស្ត្រី ពេល សម្រាល កូន ទាំង កម្ម ការិនី និង ស្ត្រី មាន ជីវភាព ក្រីក្រ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច មិន មែន មិន ស្តាប់ សំឡេង ប្រឆាំង នោះ ទេ ឲ្យ តែ ត្រឹមត្រូវ ព្រោះ មន្ត្រី រាជ រដ្ឋាភិបាល ខ្លះ ក៏ ខិល ខូច ផងដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច គឺជា អ្នកធ្វើ កំណែទម្រង់ ដីធ្លី មួយ រូប ពោល ក្រោយ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ដួលរលំ សម្តេច ជា អ្នកសម្រេចចិត្ត បែងចែក ដីធ្លី ជូន ប្រជាពលរដ្ឋ ធ្វើជា កម្មសិទ្ធិ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា សម្តេច ស្អប់ « អា ចោរ » កាប់ ឈើ ។ ប៉ុន្តែ គម្រប ព្រៃ ច្រើន ម៉ឺន ហិកតា ទៀត ត្រូវបាន បាត់បង់ ដោយសារ ដី នោះ ត្រូវបាន ក្លាយជា កម្មសិទ្ធិ របស់ ប្រជាពលរដ្ឋ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន លើកឡើង ថា នៅ ថ្ងៃ ខាងមុខ កម្ពុជា នឹង មាន ផ្ទៃដី ដាំ កៅស៊ូ ច្រើន ជាង ប្រទេស វៀតណាម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការដឹកនាំ និង ដោះស្រាយ បញ្ហា របស់ ជាតិ មួយ មិន មែន ជា រឿង ងាយស្រួល នោះ ទេ ។ ពោល ត្រូវ គិតគូរ ដោះស្រាយ ឲ្យ មាន ប្រសិទ្ធភាព រវាង តម្រូវការ និង ការផ្គត់ផ្គង់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប្រទេស កម្ពុជា មិន មែន ជា ប្រទេស របស់ នាយក រដ្ឋមន្ត្រី តែ មួយ នោះ ទេ គឺជា ប្រទេស របស់ ពលរដ្ឋ កម្ពុជា គ្រប់ គ្នា ។ ដូច្នេះ ត្រូវ ជួយ គិត គ្នា នាយក រដ្ឋមន្ត្រី គ្រាន់តែ ជា អ្នក គូស វាស តែ ប៉ុណ្ណោះ ។
* សម្តេច តេជោ ហ៊ុន សែន ផ្តាំ ដល់ បងប្អូន ខ្មែរ នៅ អាមេរិក ត្រូវ ប្រឹងប្រែង ជំរុញ កូន ចៅ រៀន ឲ្យបាន ខ្ពស់ ព្រោះ គ្មាន អ្វី ប្រសើរ ជាង ការបណ្តុះបណ្តាល ធនធាន មនុស្ស នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កុមារភាព របស់ សម្តេច ជា សម័យ ក្មេង ដើរ រក សាលា តែ បច្ចុប្បន្ន រាជ រដ្ឋាភិបាល បាន ខិតខំពង្រាយ សាលា កាន់តែ កៀក ផ្ទះ ប្រជាពលរដ្ឋ ដើម្បីឲ្យ កូន ចៅ ប្រជាពលរដ្ឋ បាន រៀនសូត្រ កាន់តែ ខ្ពស់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កុំ យក ករណី បុគ្គល សង្ឃ ណាមួយ ទៅជា បំផ្លាញ វិស័យ ព្រះពុទ្ធ សាសនា ទាំងមូល ហើយ កុំ យក ករណី បុគ្គល ស្ត្រី ណាមួយ ទៅ បំផ្លាញ តម្លៃ ស្ត្រី ទាំងមូល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប្រទេស កម្ពុជា ជា ទឹកដី សុវណ្ណ ភូមិ តែ ហេតុ អ្វី បានជា ក្រ? ហេតុផល នាំឲ្យ កម្ពុជា ក្រមាន ពីរ គឺ ការដឹកនាំ ខុស និង ធនធាន មនុស្ស ខ្សោយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង តម្រូវការ នៃ ការអភិវឌ្ឍ កំពុង ប្រឈម គ្នា ជាមួយ ការអភិរក្ស ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា សម្តេច គ្មាន ថវិកា ៥០០ ដុល្លារ ជូន បងប្អូន ខ្មែរ នៅ អាមេរិក ដូច ការចោទប្រកាន់ មួយចំនួន នោះ ទេ គឺ មាន តែ សៀវភៅ ពីរ ក្បាល គឺ សៀវភៅ អប់រំ ទូន្មាន របស់ ក្រុម ង៉ុយ និង សៀវភៅ បណ្ឌិត អ៊ូ ចុង ។
សម្តេច តេជោ ហ៊ុន សែន បញ្ចប់ កិច្ច សំណេះសំណាល ជាមួយ បងប្អូន ខ្មែរ នៅ អាមេរិក វេលា ម៉ោង ៨៖ ៥៨ នាទី ព្រឹក ថ្ងៃទី៣០ ខែកញ្ញា ម៉ោង នៅ កម្ពុជា ត្រូវ នឹង ម៉ោង ១០ យប់ ថ្ងៃទី ២៩ ខែកញ្ញា ម៉ោង នៅ ទីក្រុង ញូវយ៉ក ៕
ការថ្លែង បែប នេះ របស់ ប្រមុខ ការទូត កូរ៉េ ខាងជើង ត្រូវបាន ធ្វើឡើង នៅឯ មហាសន្និបាត នៃ អង្គការ សហ ប្រជាជាតិ ក្នុង ទីក្រុង ញូយ៉ក ។ លោក រី បាន ទទូច ឲ្យ សហរដ្ឋ អាមេរិក គោរព តាម ការសន្យា ដែល បាន ធ្វើឡើង ក្នុង អំឡុង កិច្ចប្រជុំ កំពូល នៅ ប្រទេស សិង្ហបុរី កាលពី ប៉ុន្មាន ខែ មុន រវាង មេដឹកនាំ នៃ ប្រទេស ទាំង ពីរ ។
គួរ ជម្រាប ថា ប្រតិកម្ម របស់ លោក រី យ៉ុង ហូ បាន កើតមាន បន្ទាប់ពី ការបន្ត ដាក់ទណ្ឌកម្ម និង ការជំទាស់ របស់ សហរដ្ឋ អាមេរិក ចំពោះ ការព្យាយាម ព្រមព្រៀង លើ សេចក្តីប្រកាស បញ្ចប់ សង្រ្គាម នៅ ឧបទ្វីប កូរ៉េ ។ ទីក្រុង វ៉ាស៊ីនតោន មាន ការព្រួយបារម្ភ អំពី រឿង នេះ ដោយសារតែ ខ្លួន យល់ ថា ពុំ ទាន់ ឃើញ ទីក្រុង ព្យុងយ៉ាង បាន បោះជំហាន គួរឲ្យ កត់សម្គាល់ ទាក់ទិន នឹង ដំណើរការ រំសាយ អាវុធ នុយក្លេអ៊ែរ ។
( សៀមរាប ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត សៀមរាប នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រគល់ រង្វាន់ ដល់ សិស្ស និទ្ទេស A សិស្ស ដែល ជា បេក្ខជន ប្រឡង សញ្ញាប័ត្រ មធ្យមសិក្សា ទុតិ យក ភូមិ ឆ្នាំ សិក្សា ២០១៧ - ២០១៨ ទទួលបាន លទ្ធផល និទ្ទេស A ចំនួន ៣១ នាក់ ស្រី ១៨ នាក់ នៅ មណ្ឌល សៀមរាប នូវ ម៉ូតូ ម្នាក់១ គ្រឿង និង សាំង ៥២លីត្រ ។
តាម សេចក្តីរាយការណ៍ របស់ លោក សយ ទិត្យាវង្ស ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត បាន ឲ្យដឹង ថា មណ្ឌល ប្រឡង សញ្ញាប័ត្រ មធ្យមសិក្សា ទុតិ យក ភូមិ ឆ្នាំ សិក្សា ២០១៧ - ២០១៨ នៅ ខេត្ត សៀមរាប មាន ចំនួន មាន ១២ មណ្ឌល នៅក្នុង ក្រុង សៀមរាប មាន ៣១៩ បន្ទប់ ក្នុង នោះ ផ្នែក វិទ្យាសាស្ត្រ មាន ចំនួន ៦ មណ្ឌល ស្មើ ១៤២ បន្ទប់ . ផ្នែក វិទ្យាសាស្ត្រ សង្គម ៦ មណ្ឌល ស្មើ ១៧៧ បន្ទប់ មាន បេក្ខជន ប្រឡង សរុប ៧. ៨៣០ នាក់ កើនឡើង លើស ឆ្នាំ មុន ចំនួន ៧១៧ នាក់ ក្នុង នោះ មាន ស្រី ៤ព .៣៨៣ នាក់ ។
បើ តាម លោក វរសេនីយ៍ ឯក គល់ យី បាន បញ្ចាក់ ថា ការបង្ក្រាប ជនសង្ស័យ ទាំង ៥នាក់ ខាងលើ នេះ គឺ បាន អនុវត្ត ឡើង ជាក់ស្ដែង នូវ ៣ទីតាំង ផ្សេង គ្នា ដោយ ប្រតិបត្តិការ នោះ ក្នុង ករណី ទី១ កម្លាំង នគរបាល ប៉ុស្ដិ៍ ឬស្សីកែវ ខណ្ឌ ឬស្សីកែវ បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ឈ្មោះ លឹម សុផល ភេទ ប្រុស អាយុ ៣៣ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ស្ថិត នៅ តាម បណ្ដោយ ផ្លូវ លំ ក្នុង ក្រុម១០ ភូមិ សាមគ្គី បន្ទាប់ពី កាន់ ដាវ សាំ ម៉ូរ៉ៃ ដើរ សំញ៉ែង យកមក ពិនិត្យ បាន រកឃើញ មាន សារធាតុ ញៀន ក្នុង ខ្លួន និង ដកហូត បាន ដាវ សាំ ម៉ូរ៉ៃ ២ដើម ។
លោក អធិការ ខណ្ឌ ឬស្សីកែវ បាន ឲ្យដឹង ទៀត ថា ក្រោយពី បង្ក្រាប ឃាត់ខ្លួន ជនសង្ស័យ ពាក់ព័ន្ធ កាន់កាប់ អវុធ ខុស ច្បាប់ . ប្រើប្រាស់ គ្រឿងញៀន . និង យក សាំង ដុត ផ្ទះ ធ្វើឲ្យ ខូចខាត ដោយ ចេតនា ទាំង ៥នាក់ រួម ជាមួយ វត្ថុតាង បាន និង កំពុង ស្ថិត នៅក្រោម ការបន្ត ឃុំ ខ្លួន សាកសួ ប ណ្ដោះអាសន្ន នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ក្នុង ការកសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម និតិវិធី ៕
សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន លោកជំទាវ មាឃ ឡាញ់ នៃ ប៉េណា
( ភ្នំពេញ ) ៖ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ការពារ ជាតិ បាន ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន លោកជំទាវ មាឃ ឡាញ់ នៃ ប៉េណា ដោយ បាន ទទួល ដំណឹង ថា « ឯកឧត្តម នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា » បាន ទទួលមរណភាព នៅ ជន្មាយុ ៧៤ ឆ្នាំ នា វេលា ម៉ោង ១រសៀល ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ដោយ រោគា ពាធ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃសៅរ៍ ទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ ចំនួន មនុស្ស ស្លាប់ កើន ដល់ ៣៨៤ នាក់ ដោយសារ គ្រោះ រញ្ជួយ ដី កម្រិត ធ្ងន់ និង រលក យក្ស ស៊ូណាមិ នៅ ប្រទេស ឥណ្ឌូណេស៊ី ។
៣៖ ក្រុមប្រឹក្សា សន្តិសុខ នៃ អង្គការ សហ ប្រជាជាតិ បើក កិច្ចប្រជុំ ស្តីពី បញ្ហា នៅ ឧបទ្វីប កូរ៉េ ។
៦៖ ប្រទេស ស៊ីរី ប្រកាស បើក ច្រក ព្រំដែន ដ៏ សំខាន់ ឡើងវិញ ជាមួយ ប្រទេស ហ្សង់ ដានី ។
ឆ្លង តាម អ្វី ដែល កើត លើក នេះ ពលរដ្ឋ ខ្មែរ ទាំង ក្នុង និង ក្រៅ ប្រទេស ពិតជា មាន ភស្តុតាង បញ្ជាក់ បន្ថែម ទៀត ថា សម រង្ស៊ី គឺជា អ្នកនយោបាយ គង់ ហ៊ាន កំសាក ញី និង គ្មាន គោលការណ៍ ច្បាស់លាស់ ។ សម រង្ស៊ី ជា អ្នកនយោបាយ គិត មួយ ថ្ងៃ ធ្វើ មួយ ថ្ងៃ និង ជា អ្នកនយោបាយ បោកប្រាស់ អាជីព និង ជា អ្នក បំផ្លាញ ជាតិ ពិតប្រាកដ ។ ការប្រឹង ស្រែក ឡូឡា របស់ អ្នកគាំទ្រ ខ្មោច បក្ស សង្គ្រោះ ជាតិ គឺ គ្រាន់តែ សំឡេង រ៉ៃ យំ តែ ប៉ុណ្ណោះ ។
( សកម្មភាព បងប្អូន ប្រជាពលរដ្ឋ គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ) សម្ដេច កិត្តិព្រឺទ្ធ បណ្ឌិត សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ជា ទីបំផុត ចំពោះ មរណភាព របស់ ឯកឧត្ដម នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា
( ភ្នំពេញ ) ៖ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន និង សហការី ទាំងអស់ នៃ កាកបាទ ក្រហម កម្ពុជា សូម សម្ដែង នូវ ការសោកស្ដាយ និង ក្ដុកក្ដួល រំជួល ចិត្ត ឥត ឧបមា រក អ្វី ប្រៀបផ្ទឹម ពុំ បាន ចំពោះ មរណភាព របស់ ឯកឧត្ដម នៃ ប៉េណា អនុប្រធាន ទី ១ ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ វេលា ម៉ោង ១៣:០០ នាទី ក្នុង ជន្មាយុ ៧៤ ឆ្នាំ ដោយ រោគា ពាធ ។
ជាមួយ មរណភាព ដ៏ ក្រៀមក្រំ ជា ទីបំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ ស ព ឯកឧត្ដម នៃ ប៉េណា បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
លោកស្រី បន្ត ថា មិន តែ ប៉ុណ្ណោះ យើង គួរតែ លើក គម្រោង នេះ មកកាន់ តុពិភាក្សា ដោយសារ ចំណុច ពិសេស នៃ គម្រោង នេះ ផ្ដោត សំខាន់ ទៅ លើ បរិបទ ក្នុង តំបន់ និង តម្លាភាព ។ « គំនិត ផ្តួចផ្តើម ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ » កំពុង មាន ឥទ្ធិពល យ៉ាង ខ្លាំង ខណៈ ដែល ការវិនិយោគ និង ការទំនាក់ទំនង រវាង ចិន ជាមួយ បណ្ដា ប្រទេស ដែល ស្ថិត ក្នុង គម្រោង ក៏ កាន់តែ ប្រសើរឡើង ប៉ុន្តែ ជា អកុសល្យ គម្រោង នេះ ហាក់ បែរ ដូចជា មាន ភាព ដាច់ ឆ្ងាយ ពី តំបន់ អភិវឌ្ឍន៍ នៃ អឺរ៉ុប និង សហរដ្ឋ អាមេរិក ទៅ វិញ ។
គម្រោង ខាងលើ នេះ ត្រូវបាន ផ្គត់ផ្គង់ ដោយ រូបិយវត្ថុ បម្រុង បរទេស និង សហគ្រាស ក្រោម ការគ្រប់គ្រង របស់ រដ្ឋ ដែល មាន តម្លៃ ជា ទឹកប្រាក់ រហូត ៣លាន លាន ដុល្លារ ។ ជាមួយគ្នា នេះ ផងដែរ នោះ ផ្លូវ ជំនួញ សូត្រ ថ្មី ក៏ បាន ឆ្លុះបញ្ចាំង ពី មហិច្ឆតា ភូមិសាស្ត្រ នយោបាយ របស់ រដ្ឋាភិបាល ក្រុង ប៉េកាំង ផងដែរ ។ វា បង្ហាញ ពី យុទ្ធសាស្ត្រ នៃ មេដឹកនាំ ចិន ចង់ គ្រប់គ្រង លើ តំបន់ ដ៏ ធំ មួយ ដែល មាន ទំហំ ស្មើ ជាង ពាក់កណ្តាល នៃ ពិភពលោក ទាំងមូល ។
* ចំណែក សកល ភាវូបនីយកម្ម របស់ ចិន មាន ន័យ យ៉ាងដូចម្តេច ?
ជា ប្រព័ន្ធ មួយ ដែល រដ្ឋាភិបាល ក្រុង ប៉េកាំង គ្រប់គ្រង គ្រប់ ច្រក ដើរ ទាំងអស់ ជាមួយនឹង ទម្រង់ ថ្មី មាន លក្ខណៈ មិន ផ្លូវការ ដឹកនាំ ដោយ ប្រទេស ចិន ដោយ លុបបំបាត់ សន្ធិសញ្ញា ផ្លូវការ ។
* តើ គម្រោង ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ មាន អត្ថន័យ យ៉ាងណា ចំពោះ សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត របស់ ខ្លួន ?
ខណៈ ដែល ប្រទេស ចិន ប្រកាស អំពី « គំនិត ផ្តួចផ្តើម ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ » ដែល ជា ការបោះជំហាន ឆ្ពោះ ផ្លាស់ប្តូរ ឆ្ពោះ ទៅរក កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច សកល នោះ ភាពរីកចម្រើន នៃ គម្រោង នេះ ក្លាយជា សញ្ញា ក្រើន រំឮក ដល់ សហរដ្ឋ អាមេរិក ឱ្យ ប្រុងប្រយ័ត្ន ជាប់ ជានិច្ច ចំពោះ ការកើនឡើង យ៉ាង សម្បើម នូវ ឥទ្ធិពល របស់ ចិន ក្នុង តំបន់ ។
* តើ ផ្លូវ សូត្រ ថ្មី របស់ ប្រទេស ចិន មាន អត្ថន័យ ដូចម្តេច សម្រាប់ អឺរ៉ុប និង រុស្ស៊ី ?
ជាង នេះ ទៅ ទៀត នោះ គម្រោង នេះ ទទួលបាន សន្ទុះ កាន់តែ ខ្លាំង ដែល ជា លទ្ធផល នៃ ការធ្លាក់ចុះ ឥទ្ធិពល របស់ អាមេរិក នៅក្នុង តំបន់ អាស៊ី បូព៌ា បន្ទាប់ពី ការដក ខ្លួន ចេញ ពី កិច្ចព្រមព្រៀង នៃ ភាពជាដៃគូ អន្តរប៉ាស៊ីហ្វិក ។ គម្រោង ខ្សែក្រវ៉ាត់ មួយ ផ្លូវ មួយ របស់ ចិន កំពុង ពង្រីក វិសាលភាព និង ឥទ្ធិពល ដ៏ ខ្លាំងក្លា ដូច្នេះ ការមើលងាយ ចំពោះ ឥទ្ធិពល នៃ គម្រោង ខាងលើ នេះ គឺជា កំហុសឆ្គង យុទ្ធសាស្ត្រ មួយ ដែល អឺរ៉ុប និង អាមេរិក មិន អាច ព្រងើយ កន្តើយ បាន ឡើយ ៕
អភិបាល ខេត្ត កំពង់ចាម ប្រគល់ រង្វាន់ ម៉ូតូ ជូន សិស្ស និទ្ទេស A ចំនួន ១០រូប
( កំពង់ចាម ) ៖ លោក គួច ចំរើន អភិបាល ខេត្ត កំពង់ចាម បាន ថ្លែង ថា ភាពជោគជ័យ របស់ ក្មួយ ៗ សិស្សានុសិស្ស នៅ ថ្ងៃ អនាគត ត្រូវតែ ផ្សារភ្ជាប់ ជាមួយ នយោបាយ របស់ ប្រទេសជាតិ ទាំង ផ្នែក នយោបាយ សង្គម និង នយោបាយ សេដ្ឋកិច្ច ។
លោក អភិបាល ខេត្ត កំពង់ចាម បាន ថ្លែង ដូចនេះ នា ព្រឹក ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ក្នុង ពេល ចុះ សំណេះសំណាល និង ផ្តល់ រង្វាន់ ម៉ូតូ១០ គ្រឿង ដល់ សិស្ស ដែល ប្រឡង មធ្យមសិក្សា ទុតិយភូមិ ជាប់ និទ្ទេស A ចំនួន ១០នាក់ នៅ វិទ្យាល័យ ព្រះសីហនុ ខេត្ត កំពង់ចាម ។
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែកញ្ញា លទ្ធផល៖ បង្ក្រាប ២១ករណី ឃាត់ខ្លួន ៣៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
* លទ្ធផល បង្ក្រាប រួម មាន៖ ២១ ករណី ឃាត់ខ្លួន ៣៦ នាក់ ( ស្រី ម្នាក់ ) ។ ១៖ ករណី ជួញដូរ គ្រឿងញៀន ១៤ករណី ឃាត់ខ្លួន ២៣នាក់ ( ស្រី ម្នាក់ ) ។ ២៖ ករណី ប្រើប្រាស់ គ្រឿងញៀន ៧ករណី ឃាត់ខ្លួន ១៣នាក់ ៕ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន លោកជំទាវ មាឃ ឡាញ់ នៃ ប៉េណា
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន លោកជំទាវ មាឃ ឡាញ់ នៃ ប៉េណា ដោយ បាន ទទួល ដំណឹង ថា « ឯកឧត្តម នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា » បាន ទទួលមរណភាព នៅ ជន្មាយុ ៧៤ ឆ្នាំ នា វេលា ម៉ោង ១រសៀល ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ដោយ រោគា ពាធ ។
( ភ្នំពេញ ) ៖ នៅ ម៉ោង ០៨៖០០ នាទី ព្រឹក ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ សមត្ថកិច្ច ជំនាញ នៃ ការិយាល័យ ស្រាវជ្រាវ បទល្មើស ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បញ្ជូន ចោរ ឆក់ វ័យ ក្មេង ០២ នាក់ ទៅ តុលាការ ដើម្បី ធ្វើ ការផ្តន្ទាទោស តាម ច្បាប់ ។
អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា បង្ហាញ កម្មវិធី បុណ្យ សព លោក នៃ ប៉េណា ចាប់ពី ថ្ងៃទី ២៩ ខែកញ្ញា ដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៨
( ភ្នំពេញ ) ៖ អគ្គ លេខាធិការដ្ឋាន នៃ ព្រឹទ្ធសភា នៅ ថ្ងៃទី ២៩ ខែកញ្ញា នេះ បាន បង្ហាញ នូវ កម្មវិធី បុណ្យ សព លោក នៃ ប៉េណា
អនុប្រធាន ទី១ ព្រឹទ្ធសភា ចាប់ពី ថ្ងៃទី ២៩ ខែកញ្ញា ដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៨ ។
សព របស់ លោក នៃ ប៉េណា តម្កល់ ធ្វើ បុណ្យ នៅ ផ្ទះ លេខ ៣៩១ ផ្លូវ ប៉ូឡាវីស ច្រកទ្វារ ទី២ បុរី ប៉េង ហួត ( បឹង ស្នោរ ) សង្កាត់ និរោធន៍ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។ ពិធី ដង្ហែរសព នឹង ប្រពឹត្ត ទៅ នៅ ព្រឹក ថ្ងៃពុធ ទី ០៣ ខែតុលា ឆ្នាំ ២០១៨ ឆ្ពោះ ទៅកាន់ ឈាប នដ្ឋាន នៅ ទីលាន មុខ វត្ត បុទុមវត្តី ៕ ផ្សារ ទំនើប មួយ ដ៏ ធំ សម្រាប់ ផ្គត់ផ្គង់ នូវ សម្ភារៈ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ចាប់ បើក ដំណើរការ ហើយ នៅ ចំការ ដូង រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ ដើម្បី បំពេញ នូវ តំរូវការ របស់ អតិថិជន កម្ពុជា ទៅ តាម សម័យកាល ដ៏ ទំនើប នា ពេល បច្ចុប្បន្ន នេះ ផ្សារ ទំនើប វ័ង វ័ង ដែល ជា ផ្សារ ទំនើប មួយ ដ៏ ធំ ដែល បាន នាំចូល នូវ សម្ភារៈ ឧបករណ៍ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ទំាង នៅក្នុង និង ក្រៅ ស្រុក ពិសេស ជាមួយនិង ចំណីអាហារ ជាច្រើន ផ្សេង ទៀត បាន បើក ដំណើរការ ហើយ នៅ កម្ពុជា ។
ពិសេស ផ្សារ ទំនើប មួយ នេះ បាន ស្ថិត នៅលើ ទីតាំង ដ៏ ល្អ ផងដែរ នៅ រាជធានី ភ្នំពេញ គឺ នៅ ផ្លូវ ២៧១ ( ចំការ ដូង ) សង្កាត់ ស្ទឹងមានជ័យ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ចំងាយ ២០០ម៉ែត្រ ពី ច្រមុះ ជ្រូក ស្ទឹងមានជ័យ ហើយ ដែល បាន បើក សម្ពោធ ជា ផ្លូវការ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
ផ្សារ ទំនើប វ័ង វ័ង បើក បម្រើ អតិថិជន ចាប់ពី ម៉ោង ៨ព្រឹក ដល់ ៩យប់ ហើយ គ្រប់ សម្ភារៈ ផលិតផល ចំណីអាហារ គឺ ប្រកបដោយ គុណភាព ខ្ពស់ ១០០ % ដូច នឹង នៅ ក្រៅ ប្រទេស តែម្ដង សម្រាប់ តម្លៃ គឺ កាន់តែ ពិសេស ល្អ គ្មាន ពីរ ។ នេះ ជា ភាពងាយស្រួល សម្រាប់ បងប្អូន ប្រជាជា ពលរដ្ឋ យើង ទទួលបាន ឱកាស ចំណេញ ច្រើន ទាំង គុណភាព សម្រាប់ សុខភាព រស់ នៅ ប្រចាំ ថ្ងៃ និង តម្លៃ សមរម្យ មិន ពិបាក ធ្វើដំណើរ ទៅ ក្រៅ ប្រទេស ។
ការបើក សម្ពោធ នូវ ផ្សារ ទំនើប វ័ង វ័ង នេះ នឹង បាន បំពេញ នូវ តំរូវ ការចាំបាប់ គ្រប់ ប្រភេទ និង គ្រប់ ជាន់ ថ្នាក់ របស់ ប្រជាជន ខ្មែរ ស្រប ពេល ដែល សេដ្ឋកិច្ច នៅ ប្រទេស កម្ពុជា មាន ការរីកចម្រើន ។
ផ្សារ ទំនើប វ័ង វ័ង នឹង បំពេញ តំរូវការ ដែល លោក អ្នក ចង់បាន ជា ប្រចាំ ថ្ងៃ គ្រប់ ប្រភេទ ដែល មិន ធ្លាប់ មាន ពីមុន មក !
( ព្រះវិហារ ) ៖ កម្លាំង អាវុធហត្ថ ខេត្ត ព្រះវិហារ នា ព្រឹក ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជូន ជនសង្ស័យ ពីរ នាក់ ពាក់ព័ន្ធ នឹង ករណី ជួញដូរ គ្រឿងញៀន ទៅ សាលាដំបូង ខេត្ត ដើម្បី ចាត់ការ តាម ច្បាប់ ។
អាវុធហត្ថ ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង ថា ជនសង្ស័យ ទាំង ពីរ នាក់ នេះ មាន ឈ្មោះ ទី ១៖ ប៉ុន ចន្ធូ ភេទ ប្រុស អាយុ ២៧ ឆ្នាំ មុខរបរ ជាង ជួសជុល ម៉ូតូ រស់ នៅ ភូមិ ស្រអែម ជើង ឃុំ ស្រអែម ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ និង ទី៖ ឈ្មោះ ហ៊ុន រ៉ាដា ភេទ ប្រុស អាយុ ២៤ ឆ្នាំ មុខរបរ កសិករ រស់ នៅ ភូមិ ស្រអែម ត្បូង ឃុំ កន្ទួត ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ។
អាវុធហត្ថ ខាងលើ បាន បន្ត ទៀត ថា ការឃាត់ខ្លួន ជនសង្ស័យ ទាំង ពីរ នេះ គឺ កម្លាំង អាវុធហត្ថ ស្រុក ជាំ ក្សាន្ត បាន ធ្វើ ការសហការ ជាមួយ យោធា កងពល លេខ ៣ និង យោធា កងពល លេខ ៨ ហើយ ការឃាត់ខ្លួន ជនសង្ស័យ ទាំង ពីរ នាក់ នេះ គឺ ធ្វើឡើង ថ្ងៃ ខុសគ្នា ពោលគឺ ម្នាក់ ឃាត់ខ្លួន នៅ ល្ងាច ថ្ងៃទី ២៧ និង ម្នាក់ ទៀត ឃាត់ខ្លួន ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ កន្លងទៅ ថ្មី ៗ នេះ និង បាន ធ្វើ ការដកហូត វត្ថុតាង រួម មាន ថ្នាំ ញៀន ប្រភេទ ម៉ា ទឹកកក ចំនួន ៥កញ្ចប់ លុយ ២៥២. ៥០០ រៀល និង ទូរសព្ទ ១ គ្រឿង ។
នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ដឹកនាំ មន្ត្រី ថ្នាក់ដឹកនាំ នៃ អគ្គ លេខាធិកាដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន អញ្ជើញ កាន់ បិណ្ឌ ទី៥ នៅ វត្ត បុទុមវតី
នុង ឱកាស អញ្ជើញ ទៅ ដាក់ បិណ្ឌ នេះ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ បាន នាំយក ចង្ហាន់ និង ទេយ្យ ទាន មួយចំនួន ទៀត ទៅ ប្រគេន ព្រះសង្ឃ ដើម្បី ឧទ្ទិស ទៅដល់ វិញ្ញាណក្ខន្ធ ជីដូន ជីតា និង បុព្វការី ជន ដែល បាន ចែក ឋាន ទៅ តាម ប្រពៃណី សាសនា ខ្មែរ ញាតិកា ទាំង ៧សណ្ដាន ដែល បាន បែក កាយ រំលាយ ក្ខ័ន្ធ ហើយ មួយចំណែក ទៀត ឧទ្ទិស ជូន ដួង វិញ្ញាណក្ខ័ន្ធ វិរៈ យុទ្ធជន វីរៈ យុទ្ធ នារី ដែល បាន បូជា ជីវិត ក្នុង បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ ។
ជាមួយគ្នា នេះ ជូន ក្រណាត់ ស តា ជី យាយ ជី៣០ នាក់ ក្នុង ១នាក់ ៗ ទទួលបាន ក្រណាត់ ស១ដុំ និង ថវិកា ២ម៉ឺន រៀល សិស្ស ក្រីក្រ ចំនួន ២០ នាក់ ក្នុង មួយ នាក់ ៗ ទទួលបាន ថវិកា ចំនួន ២ម៉ឺន រៀល ផងដែរ ៕ អគ្គិភ័យ លេប ត្របាក់ ផ្ទះ មួយ ខ្នង ទាំងស្រុង នៅ ខណ្ឌ ដង្កោ
លំនៅ ស្ថាន ដែល អគ្គិភ័យ ឆាបឆេះ មាន ទំហំ ៦ម៉ែត្រ គុណ នឹង ៨ម៉ែត្រ ធ្វើ អំពី ឈើ ប្រក់ ស័ង្កសី ។ ក្នុង ហេតុការឆេះ នោះ ដែរ បាន បំផ្លាញ ទ្រព្យសម្បត្តិ និង ផ្ទះ ទាំងស្រុង រួម ជាមួយ ម៉ូតូ សេ១២៥ មួយ គ្រឿង ផងដែរ ។
ជុំវិញ ករណី នេះ គេ បាន ឃើញ រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន ៣គ្រឿង បាន ចុះ ទៅ ទីតាំង កើត ហេតុ ប៉ុន្តែ បាញ់ ទឹក បាន តែ ១ គ្រឿង ប៉ុណ្ណោះ ដោយសារតែ ស្ថានភាព នៃ ការឆាបឆេះ រលត់ ទៅ វិញ ទាំងស្រុង ។ ក្នុង ហេតុការណ៍ នេះ មិន មាន មនុស្ស ណា ម្នាក់ រងគ្រោះថ្នាក់ នោះ ទេ ។
បើ តាម សមត្ថកិច្ច បញ្ជាក់ ថា ម្ចាស់ ទីតាំង មាន ឈ្មោះ សៅ វាសនា ភេទ ប្រុស អាយុ ៣២ ឆ្នាំ មុខរបរ ជាជាង ដែក ៕
នាយ ឧត្តមសេនីយ៍ សៅ សុខា ចូលរួម ក្នុង ពិធី កាន់ បិណ្ឌ វេន ទី៥ នៅ វត្ត អង្គ ស្វាយ និង វត្ត ពោធិ៍ ទន្ទឹម
គួរ រំលឹក ថា កាលពី ឆ្នាំ ២០០៤ កោះ ស៊ូ ម៉ាត្រា នៃ ប្រទេស ឥណ្ឌូណេស៊ី បាន ទទួលរង ការវាយប្រហារ ដោយ រលក យក្ស ស៊ូណាមិកម្ពស់ ១៥ម៉ែត្រ ក្រោយពី ការកើតមាន គ្រោះ រញ្ជួយ ដី នៅ មហាសមុទ្រ ឥណ្ឌា ដែល មាន កម្រិត រហូតដល់ ៩. ១រ៉ិចទ័រ និង បាន ផ្តាច់ ជីវិត មនុស្ស សរុប ជាង ២២០.០០០ នាក់ នៅ តាម បណ្តា ប្រទេស ជុំវិញ តំបន់ នោះ ប៉ុន្តែ ឥណ្ឌូណេស៊ី ជា អ្នករងគ្រោះ ធ្ងន់ធ្ងរ ជាង គេ បំផុត ដោយ មាន ប្រជាជន ស្លាប់ រហូតដល់ ១៦៨.០០០ នាក់ ៕
សាលា មី គីវ៉េ ប្រគល់ វិញ្ញាបនបត្រ បញ្ចប់ ការសិក្សា និង រង្វាន់ ជ័យលាភី ដល់ សិស្ស ឆ្នើម ប្រចាំ ឆ្នាំ សិក្សា ២០១៧ - ២០១៨
( ភ្នំពេញ ) ៖ នា ព្រឹក ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ សាលា មី គីវ៉េ បាន ប្រារព្ធ ពិធី ប្រកាស លទ្ធផល នៃ ការប្រឡង សិស្ស ពូកែ ផ្នែក ភាសា ខ្មែរ និង ភាសា អង់គ្លេស ទូទាំង សាលា មី គីវ៉េ ទាំង ២២ សាខា និង ប្រគល់ វិញ្ញាបនបត្រ បញ្ចប់ ការសិក្សា និង រង្វាន់ ជ័យលាភី ដល់ សិស្ស ឆ្នើម ផងដែរ ។
ពិធី នេះ បាន ប្រពឹ្រត្ត ទៅ ក្រោម អធិបតីភាព លោក ព្រាប កុម្ភៈ ប្រធាន ការិយាល័យ បឋម នៃ មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី ភ្នំពេញ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ សាលា បុគ្គលិក លោកគ្រូ អ្នកគ្រូ ព្រមទាំង សិស្សានុសិស្ស និង មាតាបិតា សិស្ស យ៉ាង ច្រើន កុះករ ។
លោក សៅ ហៃ ប្រធាន ការិយាល័យ ចំណេះ ទូទៅ ភាសា ខ្មែរ នៃ សាលា មី គីវ៉េ បាន បញ្ជាក់ ថា សាលា មី គីវ៉េ ទាំង ២២ សាខា មាន សិស្ស សរុប ចំនួន ២៥. ៨៧៦ នាក់ កំពុង សិក្សា កម្មវិធី ភាសា អង់គ្លេស និង ចំណេះ ទូទៅ ភាសា ខ្មែរ តាំងពី កម្រិត មត្តេយ្យ សិក្សា ដល់ កម្រិត ១២ ដោយ ក្នុង នោះ សិស្ស ចំណេះ ទូទៅ ភាសា ខ្មែរ ថ្នាក់ មត្តេយ្យ សិក្សា បឋមសិក្សា និង មធ្យមសិក្សា ទុតិយភូមិ មាន សិស្ស សរុប ចំនួន ៩. ៤៧៦ នាក់ ។
លោក បាន បន្ថែម ថា ក្នុង កម្មវិធី នេះ សាលា បាន អញ្ជើញ សិស្ស ពូកែ ( ចំណាត់ថ្នាក់ លេខ១ ប្រចាំ សាខា ) ទាំង ២៩០ នាក់ មក ពី គ្រប់ សាខា ទាំង ២២ ឲ្យ ចូលរួម និង ចែកជូន រង្វាន់ និង ប័ណ្ណ សរសើរ ដល់ ពួកគាត់ ហើយ នៅក្នុង ចំណោម សិស្ស ពូកែ ទាំង ២៩០ នាក់ មាន សិស្ស ចំនួន ៤២ នាក់ ត្រូវបាន ជ្រើសរើស ជា សិស្ស ឆ្នើម ទូទាំង សាលា មី គីវ៉េ ប្រចាំ ឆ្នាំ សិក្សា ២០១៧ - ២០១៨ ដោយ សាលា បាន ផ្តល់ ជូន ពាន ជ័យលាភី អាហារូបករណ៍ សម្ភារ សិក្សា និង ថវិកា ជាច្រើន ទៀត ដល់ សិស្ស ឆ្នើម ទាំងនោះ ដើម្បី ជា ការលើកទឹក ចិត្ត ។
ជាមួយគ្នា នេះ លោក សែម សុវ័ន បាន ធ្វើការ ថ្លែងអំណរគុណ ចំពោះ ការផ្តល់ ទំនុក ចិត្ត ដល់ សាលា មី គីវ៉េ របស់ សិស្សានុសិស្ស និង មាតាបិតា ឬ អាណាព្យាបាល សិស្ស ដោយ ការជ្រើសរើស យក សាលា មី គីវ៉េ ជា កន្លែង ផ្តល់ ការអប់រំ ដល់ ក្មួយ ៗ និង បុត្រ ធិតា និង សំណូមពរ ឲ្យ ក្មួយ ៗ និង មាតាបិតា ឬ អាណាព្យាបាល បន្ត នូវ ការគាំទ្រ និង សហការ ជាមួយ សាលា ដើម្បី ជំរុញ ឲ្យ ការសិក្សា របស់ ក្មួយ ៗ ជា សិស្សានុសិស្ស កាន់តែ មាន គុណភាព ។
ជាមួយគ្នា នេះ លោក ព្រាប កុម្ភៈ ប្រធាន ការិយាល័យ បឋម នៃ មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី ភ្នំពេញ បាន កំណត់ សម្គាល់ ថា សាលា មី គីវ៉េ គឺជា សាលា មាន អាជ្ញាប័ណ្ណ ត្រឹមត្រូវ និង គោរព តាម បទដ្ឋាន របស់ មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី ភ្នំពេញ និង ក្រសួង អប់រំ យុវជន និង កីឡា ហើយ លោក ក៏ បាន ធើ្វ ការកោតសរសើរ ចំពោះ ការរីកចម្រើន និង ប្រព័ន្ធ គ្រប់គ្រង របស់ សាលា មី គីវ៉េ ផងដែរ ។
លោក ព្រាប កុម្ភៈ បាន ផ្ដាំផ្ញើ ដល់ សមាជិក សមាជិកា អង្គ ពិធី ទាំងមូល ដោយ សង្កត់ធ្ងន់ លើ ការពង្រឹង សមត្ថភាព ក្នុង ការបង្រៀន និង រៀន ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ដោយ ឈរ លើ ការអនុវត្ត នូវ យុទ្ធសាស្រ្ត ចតុកោណ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ជា ប្រមុខ ។ ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ថ្មគោល និង សហការី ចូលរួម កាន់ បិណ្ឌ វេណ ទី៥ នៅ វត្ត និគម ក្រៅ ឃុំ ជ្រោយ ស្តៅ ស្រុក ថ្មគោល
( បាត់ដំបង ) ៖ នា ព្រឹក ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ លោក នឹម ថូត ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ថ្មគោល និង សហការី ទាំងអស់ បាន អញ្ជើញ ចូលរួម កាន់ បិណ្ឌ វេណ ទី៥ នៅ វត្ត និគម ក្រៅ ឃុំ ជ្រោយ ស្តៅ ស្រុក ថ្មគោល ដោយ មាន ពុទ្ធ បរិស័ទ្ធ ជិត ឆ្ងាយ ចំណុះ ជើង វត្ត ចូលរួម ជាច្រើន នាក់ ផងដែរ ។
លោក នឹម ថូត បាន ថ្លែង ថា ទៅកាន់ ព្រះសង្ឃ អាចារ្យ គណកម្មការ តា ជី យាយ ជី និង ពុទ្ធ បរិស័ទ្ធ ទាំងអស់ ថា ក្នុង នាម ក្រុមការងារ គណប្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ស្រុក ថ្មគោល ទាំងអស់ និង គណកម្មការ អាចារយ្យ វត្ត ពុទ្ធ បរិស័ទ្ធ ចំនុះ ជើង វត្ត ទាំងអស់ ពិសេស ក្រុមការងារ ក្នុង ឃុំ ជ្រោយ ស្តៅ បាន មូលមតិ ឯកភាព នាំគ្នា ចូលរួម ធ្វើ ពិធី កាន់ បិណ្ឌ វេណ ទី៥ នៅ វត្ត នៅ វត្ត និគម ក្រៅ ស្ថិត ក្នុង ភូមិ និគម ក្រៅ ឃុំ ជ្រោយ ស្តៅ ស្រុក ថ្មគោល ។
លោក នឹម ថូត បាន បញ្ជាក់ ថា ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព ពេញលេញ មាន ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ដែល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ធ្វើឲ្យ ប្រជាពលរដ្ឋ មាន ជីវភាព ធូធា ហើយ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន ផ្សារភ្ជាប់ រវាង អាណាចក្រ និង ពុទ្ធ ចក្រ រហូតមក ដោយ មិន អាច ខ្វះ មួយ ណា បាន ឡើយ ហើយ សាសនា ព្រះពុទ្ធ ជាសាសនា របស់ ផង នោះ ទើប វិស័យ សាសនា មាន ការរីកចំរើន មាន ការគាំទ្រ ពី ប្រជាពលរដ្ខ ផងដែរ ។
ជាក់ស្តែង ថ្ងៃ នេះ យើង បាន នាំគ្នា ធ្វើ បុណ្យ រួមគ្នា នេះ ឡើង នា រដូវកាល បុណ្យ ភ្ជំបិណ្ឌ នេះ ឡើង ក្នុង គោលបំណង ដើម្បី ឧទ្ទិស មហា កុសល់ ជូន ដល់ លោក អ្នក មាន គុណ មាន មាតាបិតា ជីដូន ជីតា ញាតិកាល ទាំង ប្រាំពីរ សណ្តាន ដែល បាន បាក់បែក ចែក ឋាន ទៅកាន់ បរលោក ទៅ ហើយ នោះ ។
ដូច្នេះ ពិធី បុណ្យ ភ្ជំបិណ្ឌ នេះ យើង ធ្វើ ទៅ ដោយ សេចក្តីគោរព បង្អោន កាយ វិចាចិត្ត ឆ្ពោះ ទៅរក ប្រេត ជន ជា ញាតិកាល ទាំង ប្រាំពីរ សណ្តាន ដែល លោក បាន ចែក ឋាន ទៅកាន់ បរលោក និង ជួយ រំដោះ ឲ្យ រួច ចាក ផុត ពី ទុក្ខ ទោស ទាំងឡាយ ឧបាយ ភូមិ ណាមួយ និង ឲ្យបាន ទៅកាន់ ភព កំណើត ថ្មី ហើយ សូម ងាក ក្រោយ ឲ្យ ពរ ជ័យ មក ជួយ បីបាច់ ថែរក្សា កូន ចៅ ដែល កំពុង នៅ រស់ ឲ្យ មាន សេចក្តីសុខ សប្បាយ ក្នុង ក្រុមគ្រួសារ សង្គមជាតិ ផងដែរ ។
លោក នឹម ថូត បាន ថ្លែងអំណរគុណ និង ជូនពរ ដល់ ក្រុមការងារ លោក តា លោកយាយ និង ពុទ្ធ បរិស័ទ្ធ ទាំងអស់ ដែល បាន អញ្ជើញ មក ចូលរួម ធ្វើ បុណ្យ ជាមួយគ្នា នា ពេលនេះ សូម ជូន កុសល ផល បុណ្យ នេះ បាន ស្មើ ៗ គ្នា និង សូមឲ្យ មាន សុខភាព ល្អ កម្លាំង មាំ មួន អាយុ វែង ប្រកប ការងារ អ្វី សូមឲ្យបាន ដូច សេចក្តីប្រាថ្នា រៀង ៗ ខ្លួន ៕
ទេសរដ្ឋមន្ត្រី គន់ គីម៖ វត្តមាន សម្តេច តេជោ ហ៊ុន សែន នៅ អង្គការ សហ ប្រជាជាតិ ជា កិត្តិយស និង មោទនភាព របស់ ជាតិ កម្ពុជា
( ព្រះវិហារ ) ៖ ថ្លែង ទៅកាន់ អតីត យុទ្ធជន ១. ៣៣៣ នាក់ នៅក្នុង ខេត្ត ព្រះវិហារ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន លើកឡើ ថា វត្តមាន របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ទីស្នាក់ការ អង្គការ ប្រជាជាតិ នា ពេលនេះ គឺជា កិត្តិយស និង មោទនភាព ថ្មី មួយ ទៀត របស់ ជាតិ កម្ពុជា ទាំងមូល ។
ក្នុង ពិធី ប្រគល់ ប័ណ្ណ បេឡា ជាតិ របប សន្តិសុខ សង្គម ដល់ អតីត យុទ្ធជន នៅ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន លើក បង្ហាញ នូវ សុន្ទរកថា ដ៏ មាន អត្ថន័យ យ៉ាង ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន ថ្លែង ទៅកាន់ អង្គការ សហ ប្រជាជាតិ នៅ យប់ មិញ នេះ ជូន ដល់ អតីត យុទ្ធជន ទាំងអស់ ដែល បាន ចូលរួម ក្នុង ពិធី ។
លោក គន់ គីម បាន ដកស្រង់ ខ្លឹមសារ សង្ខេប នៃ សុន្ទរកថា របស់ សម្តេច តេជោ ដូចជា ការបង្ហាញ ពី ស្ថានភាព របស់ ប្រទេស កម្ពុជា ដែល ធ្លាប់ តែ មាន សង្គ្រាម ពី អតីតកាល មកកាន់ ដំណាក់កាល សុខ សន្តិភាព ពី ប្រទេស ក្រីក្រ មក ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប . បញ្ហា បោះឆ្នោត នៅ កម្ពុជា ក៏ ដូចជា បញ្ហា នៅលើ ពិភពលោក ដែល ប្រទេស មហា អំណាច មួយចំនួន យក បញ្ហា សិទ្ធិ មនុស្ស ដើម្បី ជ្រៀត ជ្រែក ចូល កិច្ចការ របស់ ប្រទេស ដទៃ ជាដើម ... ។
លោក គន់ គីម បាន គូសបញ្ជាក់ ថា តាមរយៈ ប្រសាសន៍ របស់ សម្តេច តេជោ គឺ បាន បង្ហាញ ពី ការចូលរួមចំណែក ដ៏ សំខាន់ របស់ កម្ពុជា ក្នុង ការរក្សា បាន នូវ សុខ សន្តិភាព នៅលើ ពិភពលោក តាមរយៈ តួនាទី ស្នូល របស់ អង្គការ សហ ប្រជាជាតិ ។
« វត្តមាន និង ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ពី តួនាទី ដ៏ សំខាន់ របស់ កម្ពុជា យើង នៅលើ ឆាក អន្តរជាតិ ។ ទោះ យើង ជា ប្រទេស តូច យ៉ាងណា ក្តី តែ ក្នុង នាម ជា សមាជិក អង្គការ សហ ប្រជាជាតិ សំឡេង របស់ យើង ត្រូវបាន បង្ហាញ ទៅកាន់ ពិភពលោក ។ នេះ គឺជា កិត្តិយស និង ជា មោទនភាព មួយ សម្រាប់ យើង ជា ខ្មែរ ដែល មាន មេដឹកនាំ ដ៏ ខ្លាំងក្លា មួយ រូប ក្នុង ការអភិវឌ្ឍ ជាតិ ហើយ ដើរ តួនាទី យ៉ាង សំខាន់ លើ ឆាក អន្តរចាតិ » ។ លោក គន់ គីម បាន បញ្ជាក់ បន្ថែម ។
នៅក្នុង ពិធី នោះ ទាំង លោក គន់ គីម និង អតីត យុទ្ធជន កម្ពុជា សុទ្ធតែ បាន បង្ហាញ ការពេញចិត្ត ពេញ ថ្លើម យ៉ាង ខ្លាំង ចំពោះ សុន្ទរកថា របស់ សម្តេច តេជោ ហ៊ុន សែន នៅ អង្គការ សហ ប្រជាជាតិ ។ ពួកគេ បាន លើកឡើង ថា ប្រសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ ពី តថភាព ពិត របស់ កម្ពុជា និង ពិភពលោក ដែល ត្រូវ យកចិត្តទុកដាក់ ដើម្បី កសាង ពិភពលោក មួយ មាន សុខ សន្តិភាព សម្រាប់ មនុស្សជាតិ គ្រប់ ជាតិ សាសន៍ ៕
សណ្ឋាគារ ម៉េម័រ ផាឡេស រី សត និង ស្ប៉ា នឹង បញ្ចុះ តម្លៃ ពិសេស ជូន អតិថិជន សម្រាប់ អបអរសាទរ ពិធី បុណ្យ បិណ្ឌ ភ្ជុំ បិណ្ឌ
សម ប្រញាប់ រួសរាន់ ឡើង ចំនួន បន្ទប់ ផ្តល់ ជូន មាន កំណត់ ! ទីតាំង សណ្ឋាគារ ម៉េម័រ ផាឡេស រីសត & ស្ប៉ាស្ថិត នៅ ភូមិ វិហារ ចិន សង្កាត់ ស្វាយ ដង្គំ ចម្ងាយ ១០០ ម៉ែត្រ ពី ផ្សារ ចាស់ ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
សាកលវិទ្យាល័យ ពុទ្ធិសាស្រ្ត ធ្វើ សន្និសីទ ឱសថសាស្រ្ត លើក ទី១ រយៈពេល ២ ថ្ងៃ
( ភ្នំពេញ ) ៖ សន្និសីទ ឱសថសាស្រ្ត លើក ទី១ ឆ្នាំ ២០១៨ ដែល ប្រារព្ធ ឡើង ចាប់ពី ថ្ងៃទី ២៨ ដល់ ថ្ងៃទី ២៩ ខែកញ្ញា បាន ប្រព្រឹត្តទៅ ដោយ ជោគជ័យ ក្រោម អធិបតីភាព លោក បណ្ឌិត Ian Findlay សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ពុទ្ធិសាស្រ្ត . លោក ឱសថការី បាន បុត្តា ប្រធាន គណៈ ឱសថការី កម្ពុជា និង លោក លឹម រតនៈ ប្រធាន សមាគម ឱសថការី កម្ពុជា ។
កម្មវិធី នេះ ក៏ មាន ការចូលរួម ពីសំណាក់ ព្រឹទ្ធ បុរស - ព្រឹទ្ធ បុរស រង នៃ មហាវិទ្យាល័យ ឱសថសាស្រ្ត នានា នៅក្នុង ប្រទេស កម្ពុជា រួម មាន លោក - លោកស្រី ដែល ជា សាស្រ្តាចារ្យ បណ្ឌិត - បណ្ឌិត ឱសថសាស្រ្ត ឯកទេស ឱសថ បណ្ឌិត - ឱសថការី និង និស្សិត ឱសថសាស្ត្រ មកពី មហាវិទ្យាល័យ ឱសថសាស្រ្ត នានា ក្នុង ប្រទេស កម្ពុជា ក្នុង ន័យ ការចែករំលែក ចំណេះដឹង បទពិសោធន៍ ការអនុវត្តន៍ និង ភាពជោគជ័យ នៅក្នុង ផ្នែក ឳសថសាស្រ្ត គ្លីនិក ឳសថ សហគមន៍ ពាណិជ្ជកម្ម សហគ្រា ផលិត ឳស ថ និង វេជ្ជជីវសាស្រ្ត ។
គួរ ជម្រាប ថា លោក បាន បុត្តា គឺជា អ្នក ដែល បាន ជួយ ផ្តល់ ឱសថ ជាច្រើន ដល់ គ្រូពេទ្យ ស្ម័គ្រចិត្ត របស់ លោក ស សុខា ដើម្បី យក ទៅ ជួយ ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ដោយ ឥត គិត ថ្លៃ ផងដែរ ៕ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន៖ កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ មាន សុខ សន្តិភាព ការអភិវឌ្ឍ និង ទាក់ទាញ អ្នក វិនិយោគទុន មក បណ្តាក់ទុន រកស៊ី បង្កើត ការងារ យ៉ាង ច្រើន ជូន ប្រជាពលរដ្ឋ
ក្នុង ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន ថ្លែង បញ្ជាក់ ថា « កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ទាក់ទាញ អ្នក វិនិយោគទុន ធំ ៗ មក បណ្តាក់ទុន រកស៊ី បង្កើត ការងារ យ៉ាង ច្រើន ជូន ប្រជាពលរដ្ឋ ធ្វើការបាន ប្រាក់ខែ ច្រើន ជីវភាព គ្រួសារ បាន ធូរធា មាន ឱកាស បាន មក អង្គុយ ធ្វើ បុណ្យ ជាមួយគ្នា យ៉ាង សប្បាយរីករាយ » ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន ថ្លែងអំណរគុណ ដល់ មហា គ្រួសារ អ្នក បន្ទាយមានជ័យ ដែល បាន ចូលរួម ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ថែរក្សា និង យល់ ច្បាស់ ពី តំលៃ នៃ សន្តិភាព បោះឆ្នោត ជូន សម្តេច តេជោ ដើម្បី បន្ត ការអភិវឌ្ឍន៍ ប្រទេស រីកចម្រើន ទៅ មុខ ទៀត ។
ក្នុង ឱកាស អញ្ជើញ ទៅ ដាក់ បិណ្ឌ នេះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន នាំយក ចង្ហាន់ និង ទេយ្យ ទាន ទៅ ប្រគេន ដល់ ព្រះសង្ឃ និង ចែកជូន យាយ ជី តា ជី រួម មាន៖
( ភ្នំពេញ ) ៖ បុរី ភ្នំពេញ ថ្មី ចាប់ផ្តើម បើក លក់ គម្រោង ថ្មី របស់ ខ្លួន ២ទីតាំង ក្នុង ពេល តែ មួយ ចាប់ពី ថ្ងៃ ជួន ដំណឹង នេះ ហើយ និង បញ្ចុះ តម្លៃ ពិសេស ពី ២- ៨% ក្នុង ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។ គម្រោង ថ្មី ទី១ ឈ្មោះ បុរី ភ្នំពេញ ថ្មី គ្រីស្តាល់ ផាក មាន ទីតាំង តាម បណ្តោយ ផ្លូវ វេង ស្រេង បត់ ចូល ផ្លូវ អង់តាមិញ ចម្ងាយ ២០០ ម៉ែត្រ បញ្ចុះ តម្លៃ ពិសេស រហូតដល់ទៅ ៨% និង បញ្ចុះ បន្ថែម ៥.០០០ ដុល្លារ សម្រាប់ អតិថិជន ដែល កក់ ផ្ទះ ១ល្វែង ក្នុង ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។
ក្រុមហ៊ុន បាន រៀបចំ តាម មាត្រដ្ឋាន លំនៅឋាន រស់ នៅ ដ៏ ល្អ រួច ជា ស្រាច់ ដោយ មាន ការចាក់ ផ្លូវ បេតុង ធំ ទូលាយ តភ្ជាប់ ប្រព័ន្ធ ទឹក ប្រព័ន្ធ ភ្លើង ប្រព័ន្ធ លូ ដែល អម ទៅ ដោយ សួនច្បារ មាន ដើមឈើ ធំ ៗ ស្រស់បំព្រង និង ហេដ្ឋារចនាសម្ព័ន្ធ មាន សភាព ធំទូលាយ ។
ប្រធានាធិបតី ប្រទេស មហា សេដ្ឋកិច្ច ក្នុង តំបន់ អាស៊ាន រូប នេះ បាន បញ្ជាក់ ដោយ ជឿជាក់ ថា សម្ដេច តេជោ ហ៊ុន សែន ដែល មាន បទពិសោធន៍ និង ចំណេះដឹង ដ៏ ទូលំទូលាយ នឹង ទទួលបាន ជោគជ័យ ក្នុង ការបំពេញ កាតព្វកិច្ច និង តួនាទី ជា ថ្នាក់ដឹកនាំ របស់ ប្រទេស កម្ពុជា ហើយ ក្រោម ការដឹកនាំ របស់ សម្ដេច ប្រទេស កម្ពុជា នឹង បន្ដ មាន នូវ ស្ថេរភាព និង វិបុលភាព ព្រមទាំង សេដ្ឋកិច្ច ដ៏ រឹងមាំ ។
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា នាយ សេនាធិការ ចម្រុះ និង លោកស្រី ខៀវ បុប្ផា ផល រួម ជាមួយ ថ្នាក់ដឹកនាំ ក្រុមការងារ មន្ត្រីរាជការ កង នៃ កងយោធពល ខេមរភូមិន្ទ និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត មក ពី គ្រប់ ទិសទី ក្នុង ខេត្ត តាកែវ បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី បុណ្យ កាន់ បិណ្ឌ វេន ទី៤ ក្នុង ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ នៅ វត្ត ឈើ ទាល ទង ត្រា និង វត្ត ចំនួន ៨ទៀត ក្នុង ក្រុង ដូន កែវ ខេត្ត តាកែវ នា ព្រឹក ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ ម្សិលមិញ ។
ការស្នើ ឡើង ខាងលើ របស់ អាជ្ញាធរ ប៉ាឡេស្ទីន ធ្វើឡើង នៅក្នុង ពាក្យបណ្ដឹង ដាក់ ជូន ICJ ប្រឆាំង សហរដ្ឋ អាមេរិក នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ។ នៅក្នុង ពាក្យបណ្ដឹង កម្រាស់ ជាង ១៤ទំព័រ បាន ចោទប្រកាន់ ថា ការរើ ស្ថានទូត អាមេរិក ក្នុង ប្រទេស អ៊ីស្រាអែល ទៅកាន់ ទីក្រុង ហ្សេរុយ សាឡឹម គឺជា ទង្វើ រំលោភ លើ អនុសញ្ញា ទីក្រុង វីយែន ស្ដីពី ទំនាក់ទំនង ការទូត ចុះ នៅ ថ្ងៃទី ១៨ ខែមេសា ឆ្នាំ ១៩៦១ ។
គួរ បញ្ជាក់ ថា អាជ្ញាធរ ប៉ាឡេស្ទីន ក៏ បាន អំពាវនាវ ផងដែរ ឱ្យ តុលាការ យុត្តិធម៌ អន្តរជាតិ ប្រកាស ថា ការប្ដូរ ស្ថានទូត អាមេរិក ទៅកាន់ ទីក្រុង ហ្សេរុយ សាឡឹម បាន រំលោភ លើ ច្បាប់ ការទូត អន្តរជាតិ និង បង្ខំឱ្យ ទីក្រុង វ៉ាស៊ីនតោន ដក រាល់ បេសកកម្ម ការ ទូត របស់ ខ្លួន ទាំងអស់ ចេញ ពី ទីក្រុង មួយ នេះ មកវិញ ។
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា រៀបចំ ពិធី សំណេះសំណាល និង ពិសារ អាហាសាមគ្គី នៅ ល្ងាច ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ក្រោម វត្តមាន លោក ស សុខា រដ្ឋលេខាធិការ តំណាង លោក ហង់ ជួនណារ៉ុន រដ្ឋមន្ដ្រី ក្រសួង អប់រំ ។
ពិធី នេះ មាន ការចូលរួម ពី មន្ត្រីរាជការ អគ្គ នាយកដ្ឋាន កីឡា នាយកដ្ឋាន នីតិកម្ម នាយកដ្ឋាន សុខភាព សិក្សា ផ្នែក គ្រឿងញៀន និង ផ្នែក ជួញដូរ មនុស្ស ប្រមាណ ជិត ៤០០ នាក់ នៅ ភោជនីយដ្ឋាន ទន្លេ បាសាក់២ ។
ក្នុង ឱកាស នោះ ដែរ លោក ស សុខា បាន ឧបត្ថម្ភ ដល់ កីឡាករ កីឡាការិនី ពិការ ចំនួន ៤៥ រូប ដែល ត្រៀម ទៅ ប្រកួត កីឡា អន្តរជាតិ នៅ ប្រទេស ឥណ្ឌូនេស៊ី នា ពេល ខាងមុខ ក្នុង ម្នាក់ ៗ ១០០ ដុល្លារ បន្ថែម លើ ថវិកា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល សម្តេច បាន ឧបត្ថម្ភ ក្នុង ម្នាក់ ៗ ២០០ ដុល្លារ ៕ ធនាគារ ជាតិ នៃ កម្ពុជា៖ បច្ចុប្បន្ន កម្ពុជា មាន ប្រជាជន ពេញ វ័យ ៦៧% កំពុង ប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ
( ភ្នំពេញ ) ៖ លោក ជា ចាន់តូ អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើក បង្ហាញ ពី ការអភិវឌ្ឍន៍ លើ វិស័យ ធនាគារ ក្នុង ប្រទេស កម្ពុជា ដោយ ក្នុង នោះ លោក បាន លើក យក ពី ភាពរីកចម្រើន យ៉ាង ឆាប់រហ័ស នៃ ការប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ដោយ បច្ចុប្បន្ន អត្រា នៃ ប្រជាជន ពេញ វ័យ ដែល ប្រើប្រាស់ សេវា នេះ មាន រហូតដល់ ៦៧ % បើ ធៀប កាលពី មុន មាន ត្រឹម ក្រោម ១០% ប៉ុណ្ណោះ ។
ការលើកឡើង បែប នេះ របស់ លោក អគ្គ ទេសាភិបាល ធនាគារ ជាតិ ធ្វើឡើង នា ឱកាស ដែល លោក អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ តំណាង សមាគម នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា - ជប៉ុន លើក ទី៤៥ ចំនួន ៣៣ នាក់ នា ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
លោក អគ្គ ទេសាភិបាល ឲ្យដឹង ថា បច្ចុប្បន្ន វិស័យ មីក្រូ ហិរញ្ញវត្ថុ នៅ កម្ពុជា បាន កំពុង រួមចំណែក កាត់បន្ថយ ភាពក្រីក្រ និង ចូលរួម លើកស្ទួយ ជីវភាព របស់ ពលរដ្ឋ កម្ពុជា ។ បរិយាប័ន្ន ហិញ្ញវត្ថុ បាន កើនឡើង ជាលំដាប់ ទាំងនេះ បាន ឆ្លុះបញ្ចាំង តាមរយៈ កំណើន នៃ ប្រជាជន ពេញ វ័យ កំពុង ប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ។
លោក បន្ដ ទៀត ថា « បច្ចុប្បន្ន វិស័យ មីក្រូ ហិរញ្ញវត្ថុ កំពុង រីក ធំធាត់ គួរឲ្យ កត់សំគាល់ ដោយ ក្នុង នោះ ទ្រព្យសកម្ម ក្នុង វិស័យ នេះ កើន រហូតដល់ ១៤% នៃ ទ្រព្យ សកម្ម របស់ គ្រឹះស្ថាន ធនាគារ ឥណទាន បាន កើន ដល់ ១៩. ២% នៃ ឥណទាន គ្រឹះស្ថាន ធនាគារ និង ប្រាក់ បញ្ញើ កើន ដល់ ១១.១ ភាគរយ នៃ ប្រាក់ បញ្ញើ គ្រឹះស្ថាន ធនាគារ » ។
លោក បាន បញ្ជាក់ ទៀត ថា កំណើន រហូតដល់ ៦៧% នៃ ការប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ របស់ ប្រជាជន ពេញ វ័យ នៅ កម្ពុជា នេះ មាន ការកើនឡើង ខ្ពស់ មែនទែន បើ ធៀប នឹង រយៈពេល ដូចគ្នា កាលពី ១ ទសវត្សរ៍ កន្លងទៅ ដែល មាន ត្រឹមតែ ក្រោម ១០% ប៉ុណ្ណោះ ។ លើស ពី នេះ កំណើន ប្រជាជន កំពុង ប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ក៏ ឆ្លុះបញ្ចាំង ពី កម្រិត នៃ ការយល់ដឹង នៃ ពលរដ្ឋ លើ វិស័យ នេះ ផងដែរ ។
លោក បញ្ជាក់ បន្ថែម ទៀត ថា « វិស័យ មីក្រូ ហិរញ្ញវត្ថុ បាន ផ្ដល់ ឥណទាន ដល់ ប្រជាជន ចំនួន ១. ៨លាន នាក់ និង មាន អ្នក ដាក់ ប្រាក់ បញ្ញើ១.៦លាន នាក់ ។ វិស័យ មីក្រូ ហិរញ្ញវត្ថុ មិន ត្រឹមតែ បាន ចូលរួមចំណែក ពង្រីក បរិយាប័ន្ន ហិរញ្ញវត្ថុ ប៉ុណ្ណោះ ទេ តែ ថែមទាំង បាន ផ្ដល់ ការងារ ដល់ ប្រជាជន ៣ម៉ឺន នាក់ ហើយ ឥណទាន របស់ មីក្រូ ហិរញ្ញវត្ថុ បាន ផ្ដល់ ទៅ លើ វិស័យ សេដ្ឋកិច្ច នានា រួម មាន៖ វិស័យ កសិកម្ម ៣០% . ក្រុមគ្រួសារ ៣០. ៥% . វិស័យ ពាណិជ្ជកម្ម ១៨. ៨% . វិស័យ សេវាកម្ម ១០% និង វិស័យ ផ្សេង ៗ ទៀត ១០% ផងដែរ ។
សូម បញ្ជាក់ ថា ធនាគារ ជាតិ នៃ កម្ពុជា បាន ចូលរួមចំណែក អភិវឌ្ឍន៍ សេដ្ឋកិច្ច បន្ថែម ទៀត តាមរយៈ ការធ្វើឲ្យ ប្រសើរឡើង នូវ ហេដ្ឋារចនាសម្ព័ន្ធ ហិរញ្ញវត្ថុ ពង្រី បណ្ដាញ សេវា ហិរញ្ញវត្ថុ និង ធ្វើឲ្យ ប្រសើរឡើង នូវ បទប្បញ្ញាត្តិ និង ការត្រួតពិនិត្យ ដើម្បី ធានា នូវ ប្រព័ន្ធ ធនាគារ ដែល រឹងមាំ និង មាន ប្រសិទ្ធភាព ៕ ពលរដ្ឋ ទី ទាល់ ក្រ ២០ គ្រួសារ នៅ អូរ អណ្តូង សង្កាត់ អូរ តាវ៉ៅ ក្រុង ប៉ៃលិន ទទួលបាន អំណោយ ពី អាជ្ញាធរ ខេត្ត ប៉ៃលិន
( ប៉ៃលិន ) ៖ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន អម ដំណើរ ដោយ លោក ចេង ញ៉ាន់ អភិបាល រង ខេត្ត និង លោកស្រី ជា លាភ អភិបាល រង ខេត្ត ព្រមទាំង ក្រុមការងារ បាន អញ្ជើញ ចុះ សំណេះសំណាល សួរសុខទុក្ខ និង នាំយក អំណោយ ជា ស្បៀងអាហារ គ្រឿង ឧបភោគ បរិភោគ ទៅ ឧបត្ថម្ភ ដល់ ប្រជាពលរដ្ឋ ទី ទាល់ ក្រ ខ្វះខាត ស្បៀង ចំនួន ២០ គ្រួសារ នៅ ភូមិ ភ្នំ រាំង សង្កាត់ អូរ តាវ៉ៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។
លោក ផាន់ ចាន់ ធុល បាន លើកឡើង ថា ការចែក អំណោយ នៅ ពេល នេះ ដើម្បី ចូលរួមចំណែក ដោះស្រាយ ជីវភាព របស់ បងប្អូន បាន មួយ កំរិត សំដៅ ការអភិវឌ្ឍ រួមចំណែក លើក កំពស់ ជីវភាព របស់ បងប្អូន ឱ្យ កាន់តែ ល្អ ថែម ទៀត បើ ទោះបី អំណោយ ទាំងនេះ មិន បាន បំពេញ តាម តំរូវការ របស់ បងប្អូន ក៍ ពិត មែន ក៍ អាច ដោះស្រាយ បាន មួយ កំរិត ផងដែរ ដូច្នេះ សូម បងប្អូន ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង ប្រកប មុខរបរ ចិញ្ជឹម ជីវិត និង បង្កបង្កើត ផល ដាំ ដំណាំ ឱ្យ បាន កាន់ ច្រើន ដើម្បី បង្កើន ជីវភាព របស់ បងប្អូន ឱ្យ ធូធា ជាង មុន ។
លោក ផាន់ ចាន់ ធុល ក៏ បាន ផ្តាំ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ពី សុវត្ថិភាព ផ្ទាល់ខ្លួន និង ក្រុមគ្រួសារ ដោយ រដូវ នេះ មាន ភ្លៀង ធ្លាក់ លាយឡំ ជាមួយ ខ្យល់ កន្ត្រាក់ និង ផ្គរ រន្ទៈ ដែល ងាយ បង្ក គ្រោះថ្នាក់ ហើយ បើ បងប្អូន មាន បញ្ហា អ្វី កើតឡើង ក្នុង គ្រួសារ ត្រូវ រាយការណ៍ ទៅ អាជ្ញាធរ មូលដ្ឋាន ដែល នៅជិត កៀក ជាមួយ បងប្អូន ផ្ទាល់ ដើម្បីឱ្យ ក្រុមការងារ ចុះ ជួយ ដល់ បងប្អូន ឆាប់ រហ័ស និង ទាន់ ពេលវេលា ។
សូម បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ទី ទាល់ ក្រ ខ្វះខាត ស្បៀង ដែល ទទួល អំណោយ ពី អាជ្ញាធរ ខេត្ត មាន ចំនួន ២០ គ្រួសារ ដោយ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម មី ១កេះ ផងដែរ ៕ សមិទ្ធផល ថ្មី ! ផ្លូវ លំ ក្រាល ក្រួស ១ខ្សែ រ ប្រវែង ជិត ១០គីឡូម៉ែត្រ គ្រោង បើក ការដ្ឋាន នៅពេល ឆាប់ ៗ នេះ នៅ សង្កាត់ អូរ តាវ៉ៅ ក្រុង ប៉ៃលិន
( ប៉ៃលិន ) ៖ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន អម ដំណើរ ដោយ លោក ចេង ញ៉ាន់ និង លោកស្រី ជា លាភ អភិបាល រង ខេត្ត ព្រមទាំង ក្រុមការងារ និង អាជ្ញាធរ មូលដ្ឋាន នា ព្រឹក ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន អញ្ជើញ ពិនិត្យមើល ផ្លូវ លំ ១ខ្សែ រ ប្រវែង ជាង ១០គីឡូម៉ែត្រ ដើម្បី គ្រោង បើក ការដ្ឋាន កសាង នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ក្នុង ការឆ្លើយតប ទៅ តាម សំណូមពរ របស់ ប្រជាពលរដ្ឋ នៅ ភូមិ ភ្នំ រាំង និង ភូមិ ព្រៃ មង្គល សង្កាត់ អូរ តាវ៉ៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។
សូម បញ្ជាក់ ថា៖ ផ្លូវ លំ ក្រាល ក្រួស១ ខ្សែរ ដែល អាជ្ញាធរ ខេត្ត ប៉ៃលិន គ្រោង បើក ការដ្ឋាន កសាង នា ពេល ខាងមុខ ឆាប់ ៗ នេះ គឺ មាន ប្រវែង ៩៧០០ ម៉ែត្រ ទទឹង ៥ម៉ែត្រ ដាក់ មុខ កាត់១តឹក ចំនួន ៧កន្លែង ដោយ ប្រើប្រាស់ កញ្ចប់ ថវិកា អភិវឌ្ឍន ខេត្ត ៕ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៩ ខែកញ្ញា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ១.៦៨៤ គ្រឿង និង ផាក ពិន័យ ១. ៣៥៤ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ៧.៨០២ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ១.៦៨៤ គ្រឿង ( ម៉ូតូ ៨៨ %) អប់រំ៣៣០ គ្រឿង និង ផាក ពិន័យ ១៣៥៤ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៩ ខែកញ្ញា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ៤. ២៦៣ គ្រឿង . អប់រំ២៦៩ គ្រឿង និង ផាក ពិន័យ ៥៤៨ គ្រឿង ។
សាលា ខេម ប្រ៊ីដ អន្តរជាតិ កម្ពុជា បាន ដាក់ អោយ ប្រើប្រាស់ ការអប់រំ ៣ ភាសា រួមគ្នា
( ភ្នំពេញ ) ៖ ជា ការពង្រឹង សមត្ថិភាព កុមារ ក៏ ដូចជា តម្រូវការ ទីផ្សារ នា ពេល បច្ចុប្បន្ន និង ទៅ អនាគត សាលា ខេម ប្រ៊ីដ អន្តរជាតិ កម្ពុជា បាន ដាក់ អោយ ប្រើប្រាស់ កម្មវិធី សិក្សា ភាសា ដោយ ផ្ដោត សំខាន់ លើ ៣ភាសា រួមគ្នា ក្នុង ពេល តែ មួយ ។
ជុំវិញ ការដាក់ អោយ ប្រើប្រាស់ វិស័យ អប់រំ ៣ភាសា លោកស្រី លីឡែត នាយិការសាលា ខេម ប្រ៊ីដ អន្តរជាតិ កម្ពុជា បាន បញ្ជាក់ ថា វា ជា កម្មវិធី សិក្សា ភាសា ពេញលេញ មួយ ដោយ មាន ទាំង ភាសា ខ្មែរ ភាសា អង់គ្លេស និង ភាសា ចិន ក្នុង ពេល តែ មួយ ។
លោកស្រី ជឿជាក់ ថា ការដាក់ អោយ មាន កម្មវិធី សិក្សា ជា ៣ ភាសា នេះ ជា ផ្លូវ ទៅកាន់ ឱកាស ឥត ដែន កំណត់ ទៅក្នុង ថ្ងៃ អនាគត ក្នុង ការទំនាក់ទំនង ក៏ ដូចជា ក្នុង វិស័យ ការងារ ទាំង ថ្នាក់ ជាតិ និង កម្រិត អន្តរជាតិ ។ ជាពិសេស វា រឹតតែ សំខាន់ ស្រប ពេល ដែល ភ្ញៀវ ទេសចរ ចិន និង ចំនួន អ្នក វិនិយោគ ជនជាតិ ចិន ចួល មក កម្ពុជា ឈរ លើ លំដាប់ មួយ ខ្ពស់ បំផុត ។
លោកស្រី បន្ត ថា ការអប់រំ ជា ៣ ភាសា នេះ គឺ ត្រូវការបណ្ដុះ ឆន្ទៈ របស់ អាណាព្យាបាល សិស្ស អោយល់ ពី មជ្ឈដ្ឋាន ប្រកួតប្រជែង សម្រាប់ កូន របស់ ពួកគាត់ ហើយក៏ ទាមទារ អោយ កុមារ ទាំងអស់ មាន ឆន្ទៈ ស្រលាញ់ ការសិក្សា ជា៣ ភាសា ស្រប គ្នា ជាមួយនឹង គ្រូបង្រៀន មាន បទពិសោធន៍ និង គរុកោសល្យ ត្រឹមត្រូវ និង កម្មវិធី សិក្សា ច្បាស់លាស់ ទទួលស្គាល់ ជា លក្ខណៈ អន្តរជាតិ ។
សាលា ខេម ប្រ៊ីដ អន្តរជាតិ កម្ពុជា ជា សាលា មួយ ដែល ផ្ដល់ ការអប់រំ ជា លក្ខណៈ អន្តរជាតិ ពិតប្រាកដ ដោយ មុខវិជ្ជា សិក្សា ដូចជា គណិតវិទ្យា មុខវិជ្ជា សង្គម ក៏ ដូចជា មុខវិជ្ជា វិទ្យាសាស្រ្ត សុទ្ធតែ សិក្សា ជា ភាសា បរទេស ។ គោលបំណង សំខាន់ នៃ សាលា គឺ ធ្វើ យ៉ាងណា ក សាង អ្នកដឹកនាំ សម្រាប់ ថ្ងៃ អនាគត ក្នុង សហគមន៍ ពហុ វប្បធ៌ម ប្រកបដោយ សីល ធ៌ម និង សមត្ថិភាព ខ្ពស់ ៕
បុរី វិមាន ភ្នំពេញ ផ្លូវ ជាតិ ៦អា ទទួល ការសាទរ និង គាំទ្រ ពី គណៈប្រតិភូ ក្រសួង ការងារ និង គណៈប្រតិភូ ជប៉ុន ក្រោយ ការ ចុះ ត្រួតពិនិត្យ ការដ្ឋាន សំណង់
( ភ្នំពេញ ) ៖ គម្រោង ទី៧ បុរី វិមាន ភ្នំពេញ ដែល កំពុង សាងសង់ នៅ ផ្លូវ ជាតិ ៦អា ទទួលបាន ការសាទរ និង គាំទ្រ ខ្ពស់ ពីសំណាក់ គណៈប្រតិភូ ក្រសួង ការងារ និង គណៈប្រតិភូ ជប៉ុន . ក្នុង ឱកាស ចុះ ទស្សនកិច្ច និង ត្រួតពិនិត្យ អំពី សុវត្ថិភាព ការងារ ក្នុង វិស័យ សំណង់ និង សុវត្ថិភាព ការដ្ឋាន កាលពី ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
ការចុះ ទស្សនកិច្ច របស់ គណៈប្រតិភូ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជា្ជជីវៈ បាន ដឹកនាំ ដោយ លោក ឡេង តុង ប្រធាន នាយកដ្ឋាន ពេទ្យ ការងារ និង គណៈប្រតិភូ ជប៉ុន ដឹកនាំ ដោយ លោក Jiro KAWASAKI សមាជិក សភា និង ជា អតីត រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល ការងារ និង សុខុមាលភាព ជប៉ុន និង អម ដំណើរ ដោយ លោក លោកស្រី មន្រ្តី រាជការ គណៈប្រតិភូ ទាំង ពីរ ផងដែរ ។
ក្នុង ដំណើរ ចុះ ទស្សនៈកិច្ច នេះ ក៏ មាន កិច្ច ស្វាគមន៍ យ៉ាង កក់ក្តៅ ពីសំណាក់ ថ្នាក់ដឹកនាំ បុរី វិមាន ភ្នំពេញ ក្នុង នោះ ដែរ បុរី ក៏ បាន ធ្វើ បទបង្ហាញ អំពី បទដ្ឋាន បច្ចេកទេស សុវត្ថិភាព សំណង់ និង សុវត្ថភាព ការងារ ក្នុង ការដ្ឋាន សំណង់ ព្រមទាំងអញ្ជើញ គណៈប្រតិភូ ចុះ ត្រួតពិនិត្យ ផ្ទាល់ ក្នុង ការដ្ឋាន ផងដែរ ។
ក្នុង ឱកាស នោះ គណៈប្រតិភូ បាន សំដែង នូវ ការសាទរ និង កោតសរសើរ ចំពោះ បុរី វិមាន ភ្នំពេញ ដែល មិន ត្រឹមតែ គិតគូ អំពី គុណភាព សំណង់ នោះ ទេ ប៉ុន្តែ បុរី ថែមទាំង បាន អនុវត្តន៍ នូវ លក្ខខណ្ឌ ការងារ សុវត្ថិភាព ការងារ ក្នុង ការដ្ឋាន សំណង់ ដោយ អនុលោម តាម ច្បាប់ ការងារ និង បទដ្ឋាន គតិយុត្ត ផ្សេង ៗ ទៀត ផងដែរ ។
ដើម្បី ជា ការថ្លែងអំណរគុណ គណៈប្រតិភូ ក៏ បាន ប្រគល់ នូវ លិខិត ថ្លែងអំណរគុណ ជូន ដល់ បុរី វិមាន ភ្នំពេញ ចំពោះ ការសហការ និង ស្វាគមន៍ ចំពោះ ដំណើរទស្សនកិច្ច នេះ ក៏ ដូចជា ការរៀបចំ ការដ្ឋាន សំណង់ បាន ល្អ ប្រកបដោយ សុវត្ថិភាព ខ្ពស់ ផងដែរ ៕ រដ្ឋមន្ត្រី កសិកម្ម ចុះ ពិនិត្យ ឃ្លាំង ស្តុក និង ឡ សម្ងួត ស្រូវ របស់ ក្រុមហ៊ុន អេម រុរ៉ាយស៍ នៅ ខេត្ត កំពង់ធំ ដែល វិនិយោគ អស់ ទឹកប្រាក់ ៩លាន ដុល្លារ
ទន្ទឹមនឹង នេះ ហេដ្ឋារចនាសម្ព័ន្ធ ដូចជា ឃ្លាំង ស្តុក ស្រូវ ដែល បាន សាងសង់ អស់ ជាង ៨០ ម៉ឺន ដុល្លារ សហរដ្ឋ អាមេរិក និង មាន លទ្ធភាព ស្តុក ទុក ស្រូវ បាន ជាង ៦ម៉ឺន តោន ក្នុង ១ រដូវកាល ។ ដោយឡែក ចំពោះ ឡសម្ងួត វិញ គឺ អាច សម្ងួត បាន ជាង ១.៦០០ តោន ក្នុង ១ ថ្ងៃ ។ សរុប ពី ការវិនិយោគ គឺ ក្រុមហ៊ុន បាន ចំណាយ ថវិកា អស់ ប្រមាណ ៩លាន ដុល្លារ សហរដ្ឋ អាមេរិក ដែល ក្នុង នោះ ក៏ មាន ការចូលរួម ផ្តល់ កម្ចី ឥណទាន ពី ធនាគារ អភិវឌ្ឍន៍ ជនបទ របស់ រាជ រដ្ឋាភិបាល ផងដែរ ។
សាកលវិទ្យាល័យ ក៏ បាន បើក កម្មវិធី សិក្សា ជា ភាសា ជាតិ ដោយ បង្រៀន ជា ពីរ ភាសា គឺ ភាសា ខ្មែរ និង ភាសា អង់គ្លេស ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ និស្សិត ប៊ែល ធី ទទួលបាន នូវ ចំណេះដឹង ទាំង ភាសា ជាតិ និង អន្តរជាតិ និង ផ្តល់ ភាពងាយស្រួល ជូន ដល់ និស្សិត ក្នុង ការទំនាក់ទំនង រវាង ជាតិ និង អន្តរជាតិ ដែល ជា ឱកាស ក្នុង ការប្រកបរបរ អាជីវកម្ម ផ្ទាល់ខ្លួន ដោយ ជោគជ័យ និង ក្លាយជា សហគ្រិន ភាព ដ៏ ល្បី ក្នុង ពេល អនាគត ។
បន្ទាប់មក លោក បណ្ឌិត ប្រធាន គណៈ អធិបតី ក៏ បាន ចូលរួម អបអរសាទរ និង ប្រគល់ វិញ្ញា បនបត្រ ដល់ សិស្ស ជ័យលាភី ទាំង ៧៨៧ នាក់ នា ពេល នោះ ផងដែរ ៕ មន្ទីរ ពហុ ព្យាបាល អន្ដរជាតិ ខេមា នឹង ដាក់ ឲ្យ ដំណើរការ គ្លីនិក លាង ឈាម ដែល បំពាក់ ម៉ាស៊ីន យ៉ាង ទំនើប មកពី ប្រទេស ជប៉ុន
( ភ្នំពេញ ) ៖ ការលាង ឈាម គឺជា វិធី ច្រោះ យក កាកសំណល់ ដូចជា ក្រេអា ទីនីន និង អ៊ុយរ៉េ និង ជាតិទឹក លើស ចេញ ពី ក្នុង ខ្លួន ដោយ ប្រើ ម៉ាស៊ីន លាង ឈាម ជំនួស ឲ្យ តំរងនោម ធម្មជាតិ ដែល ខូច ឈប់ ដំណើរការ ។ មុនពេល មាន វីធី លាង ឈាម អ្នកជំងឺ ខូច តំរងនោម ទាំងស្រុង គ្មាន សង្ឃឹម ថា នឹង រស់រាន មាន ជីវិត បាន ឡើយ តែ បច្ចុប្បន្ន អ្នកជំងឺ ខូច តំរងនោម អាច រស់ នៅ និង ធ្វើ ការ ខ្លះ ៗ បានជា ធម្មតា ។
គ្លីនិក លាង ឈាម នៅ មន្ទីរ ពហុ ព្យាបាល អន្តរជាតិ ខេមា ដែល ចាប់ផ្តើម សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ពី ថ្ងៃទី ០១ ខែតុលា ឆ្នាំ ២០១៨ ខាងមុខ នេះ នឹង ចូលរួមចំណែក ផ្តល់ សេវា លាង ឈាម ប្រកបដោយ គុណភាព ខ្ពស់ នៅ កម្ពុជា ដោយ អនុវត្ត តាម ស្តង់ដារ វេជ្ជសាស្រ្ត ដែល មាន ការទទួលស្គាល់ ជា អន្តរជាតិ ។
គ្លីនិក លាង ឈាម ខេមា មាន បរិយាកាស សំរាក ព្យាបាល ល្អ បំពាក់ ដោយ ម៉ាស៊ីន លាង ឈាម ថ្មី ស្រឡាង និង ទំនើប ផលិត នៅ ប្រទេស ជប៉ុន ប្រើប្រាស់ សម្ភារ លាង ថ្មី ៗ ជានិច្ច ប្រើ ម្តង បោះចោល មិន ប្រើ ឡើងវិញ ឡើយ ដែល គ្រប់គ្រង និង ដំណើរការ ដោយ បុគ្គលិក ជំនាញ និង មាន បទពិសោធន៍ ច្បាស់លាស់ ដោយ សហការ ជាមួយ សាស្ត្រាចារ្យ ផ្នែក តំរងនោម និង អ្នកជំនាញ លាង ឈាម មកពី កោះ តៃវ៉ាន់ ។
លោក វេជ្ជបណ្ឌិត អ៊ុ សុភាព នាយក មន្ទីរ ពហុ ព្យាបាល អន្តរជាតិ ខេមា បាន លើកឡើង ថា គ្លីនិក លាង ឈាម ខេមា នឹង ចូលរួម លើក កំពស់ គុណភាព និង ស្តង់ដារ លាង ឈាម នៅ កម្ពុជា យើង ឲ្យ ស្មើនឹង កន្លែង លាង ឈាម នានា នៅក្នុង តំបន់ និង អន្តរជាតិ ព្រោះ យើង ប្រើ ម៉ាស៊ីន ដូចគ្នា បច្ចេកវិជ្ជា ដូចគ្នា និង កម្រិត អ្នកជំនាញ ដូចគ្នា ។
បន្ថែម ពី នេះ លោក សាស្ត្រាចារ្យ ទូជាន សៃ ប្រធាន ក្រុមហ៊ុន សុខភាព អាស៊ី ដែល សហការ ជាមួយ មន្ទីរ ពហុ ព្យាបាល អន្តរជាតិ ខេមា បាន សំដែង ការយល់ស្រប ថា ការរៀបចំ និង ដំណើរការ របស់ គ្លីនិក លាង ឈាម ខេមា គឺ ប្រហាក់ប្រហែល នឹង មណ្ឌល លាង ឈាម នៅ តៃវ៉ាន់ ជប៉ុន ឬ សាំងហ្គាពួរ ដែរ ៕
ហេតុការណ៍ នេះ បង្ក ការភ្ញាក់ផ្អើល ឡើង នៅ វេលា ម៉ោង ១២៖ ៤០ នាទី យប់ ឈានចូល ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅលើ កំណាត់ ផ្លូវ ជាតិ លេខ ៥ ត្រង់ ចន្លោះ បង្គោល គីឡូម៉ែត្រ លេខ ១៧០. ១៧១ លើ ស្ពាន ធ្លាម្អ ម ស្ថិត នៅ ភូមិ ត្រាំ ឃុំ ត្នោត ជុំ ស្រុក ក្រគរ ខេត្ត ពោធិ៍សាត់ ។
ករណី ខាងលើ នេះ រថយន្ត ត្រូវបាន ភ្លើង ឆាបឆេះ ខ្ទេច ទាំងស្រុង និង បណ្ដាលឲ្យ បុរស ជនជាតិ ចិន ចំនួន ៥នាក់ បាន រងរបួស ធ្ងន់ ២នាក់ និង ស្រាល ៣នាក់ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ បង្អែក ខេត្ត ពោធិ៍សាត់ ។ ហេតុការណ៍ ដដែល នោះ គេ ឃើញ សមត្ថកិច្ច បាន ចុះ ជួយ អន្តរាគមន៍ ដោយ ប្រើប្រាស់ រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន១ គ្រឿង ទើប គ្រប់គ្រង ស្ថានភាព បាន ។ បច្ចុប្បន្ន រថយន្ត ដែល ឆេះ នោះ កម្លាំង នគរបាល ស្រុក និង ប៉ុស្តិ៍ បាន អូស ដាក់ ទុក នៅ ពី ខាងមុខ ប៉ុស្តិ៍ នគរបាល ត្នោត ជុំ ។
សូម បញ្ជាក់ ថា ជនជាតិ ចិន ទាំងនោះ មិន បាន ស្គាល់ ឈ្មោះ ទេ ព្រោះ ពួកគាត់ ចេះតែ ភាសា ចិន មិន ចេះ អង់គ្លេស ទេ ទើប កម្លាំង នគរបាល សាកសួរ ព័ត៌មាន មិន បាន ៕ សាកលវិទ្យាល័យ ធនធាន មនុស្ស រៀបចំ កម្មវិធី សប្បុរសធម៌ និង ប្រគល់ ថវិកា ជិត៦ ពាន់ ដុល្លារ របស់ សប្បុរសជន ជូន ដល់ ព្រឹទ្ធ សិល្បករ នូ ស៊ិប
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ឯក មនោសែន សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ធនធាន មនុស្ស បាន រៀបចំ កម្មវិធី សប្បុរសធម៌ និង ប្រគល់ ថវិកា សប្បុរសជន ចំនួន ៥. ៧៨៨. ០២ ដុល្លារ អាមេរិក ជា របស់ សប្បុរសជន ជូន ដល់ ព្រឹទ្ធ សិល្បករ នូ ស៊ិប ជា ព្រឹទ្ធ សិល្បករ ខ្មែរ ដែល មាន ប្រវត្តិ ល្អ ជារៀងរហូតមក បម្រើ ក្នុង វិស័យ សិល្បៈ ជាតិ ដែល រហូតមកដល់ ពេលនេះ លោក បាន ជួប បញ្ហា លំបាក ក្នុង ជីវភាពចាស់ជរា ដែល មិន អាច រក ប្រាក់ ចំណូល បាន ។
កម្មវិធី សប្បុរសធម៌ និង ប្រគល់ ថវិកា ខាងលើ នេះ ធ្វើឡើង នា ថ្ងៃទី ២៧ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស ដែល មាន សប្បុរសជន សាធារណជន និស្សិត បុគ្គលិក សាស្រ្តាចារ្យ ចូលរួម ប្រមាណ ជាង ៥០០ នាក់ ។
លោក សាស្រ្តាចារ្យ ឯក មនោសែន បាន ឱ្យដឹង ទៀត ថា ការរៀបចំ កម្មវិធី សប្បុរសធម៌ នេះ មាន គោលបំណង សំខាន់ ៗ ដូច ជា៖ ១៖ ដើម្បី គោរព ផ្តល់ តម្លៃ ផ្តល់ កិត្តិយល និង លើកកម្ពស់ ស្នាដៃ ព្រឹទ្ធ សិល្បករ ខ្មែរ លោក នូ ស៊ិប ដែល មាន ប្រវត្តិ ល្អ ជារៀងរហូតមក បម្រើ ក្នុង វិស័យ សិល្បៈ ជាតិ ។
២៖ លើកទឹកចិត្ត សាធារណជន ទូទៅ ឱ្យ ចូលរួម ថែរក្សា ការពារ មរតក សំនៀង សិល្បៈ វប្បធម៌ ប្រពៃណី ដ៏ មាន តម្លៃ របស់ ខ្មែរ និង លើកទឹកចិត្ត ដល់ ព្រឹទ្ធ សិល្បករ ដែល មាន ស្នាដៃ ល្អ ។
៣៖ បញ្ជាក់ ពី សន្តាន ចិត្ត ការស្រឡាញ់ ស្រណោះ អាណិត និង ទឹកចិត្ត សប្បុរស ជួយ ដោះស្រាយ បញ្ហា លំបាក ក្នុង ជីវភាពចាស់ជរា របស់ លោក នូ ស៊ិប ខណៈពេល ដែល កត្តា សុខភាព មិន អាច ឱ្យ លោក ប្រកប អាជីព ចិញ្ចឹម ជីវិត បាន និង ជា ការឆ្លើយតប ទៅនឹង គុណូបការៈ និង ស្នាដៃ របស់ លោក ដែល បាន បម្រើ ក្នុង វិស័យ សិល្បៈ និង អារម្មណ៍ ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ ៗ រូប ជាច្រើន ទសវត្សរ៍ កន្លងមក ។
៤៖ ដើម្បី ទាញ ការចាប់អារម្មណ៍ ពី សប្បុរសជន ទូទៅ ឱ្យ បាន នឹកឃើញ ដល់ ស្នាដៃ និង ទេពកោសល្យ ដ៏ កម្ររ របស់ ព្រឹទ្ធ សិល្បករ ដ៏ ល្បី និង បន្ត ចូលរួមចំណែក ឧបត្ថម្ភ ជា ថវិកា និង សម្ភារៈ ជួយ ដល់ ជីវភាព និង ជីវិត ចុងក្រោយ របស់ លោក ឱ្យ បាន សមរម្យ សក្តិសម ជា ព្រឹទ្ធ សិល្បករ ម្នាក់ ។
៥៖ សកម្មភាព ជា កាយវិការ លើកកម្ពស់ ឱ្យ តម្លៃ វិស័យ សិល្បៈ ដែល ជា ព្រលឹង ជាតិ និង ជា ការលើកទឹកចិត្ត ដល់ សិល្បករ ដទៃ ទៀត ផងដែរ
សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ធនធាន មនុស្ស បាន បញ្ជាក់ ទៀត ថា ថវិកា ដែល អំពាវនាវ បាន មកពី សប្បុរសជន សម្រាប់ ប្រគល់ ជូន ព្រឹទ្ធ សិល្បករ នូ ស៊ិប នា ពេលនេះ មាន ចំនួន ៥. ៧៨៨. ០២ ដុល្លា អាមេរិក ផងដែរ ៕
យោង តាម អាជ្ញាធរ ឧតុនិយម ជប៉ុន ព្យុះ ទីហ្វុង Trami បាន បក់ បោក ក្នុង ល្បឿន ខ្យល់ អតិបរមា ២១៤ គីឡួ ម៉ែត្រ មួយ ម៉ោង ដោយ នាំ មក ជាមួយ នូវ ភ្លៀង ធ្លាក់ យ៉ាង សន្ធប់ ដូច គេ ចាប់ ហែក មេឃ ផងដែរ ។ មិន តែ ប៉ុណ្ណោះ វា បាន បង្ខំឱ្យ អាជ្ញាធរ ជប៉ុន ជម្លៀស មនុស្ស ៦០០ នាក់ ទៅ រក កន្លែង មាន សុវត្ថិភាព នៅ តាម ជំរុំ ស្នាក់ នៅ បណ្ដោះអាសន្ន លើ កោះ អូគីណា វ៉ា ស្រប ពេល ផ្ទះសម្បែរ ប្រជាជន ១២១.០០០ ខ្នង គ្មាន អគ្គិសនី ប្រើប្រាស់ និង ជើងហោះហើរ ចំនួន ៣៨៦ ត្រូវបាន លុបចោល ។
( ភ្នំពេញ ) ៖ លោក នៃ ប៉េណា អនុប្រធាន ទី១ ព្រឹទ្ធសភា ទទួលមរណភាព នៅ មុន នេះ បន្តិច នា ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ដោយ រោគា ពាធ នេះ បើ យោង តាម មន្រ្តី ព្រឹទ្ធសភា ថ្លែង ប្រាប់ បញ្ជាក់ ឲ្យដឹង យ៉ាង ដូច្នេះ ។
( ហ្សាការតា ) ៖ គ្រោះ ធម្មជាតិ រញ្ជួយ ផែនដី ដ៏ កក្រើក ផ្ទួន ៗ កាលពី ថ្ងៃសុក្រ សប្តាហ៍ នេះ ដែល មាន កម្រិត ចាប់ពី ៦.១រ៉ិចទ័រ រហូតដល់ ៧. ៧រ៉ិច ទ័រ និង បាន បង្ក ជា រលក យក្ស ស៊ូណាមិ វាយ សង្គ្រប់ លើ ខេត្ត ភាគ កណ្តាល ប្រទេស ឥណ្ឌូណេស៊ី នោះ បាន ផ្តាច់ ជីវិត មនុស្ស រហូតដល់ ៤៨ នាក់ ហើយ និង ៣៥៦ រងរបួស ។ នេះ បើ តាម ការចេញផ្សាយ នៅ មុន នេះ បន្តិច ដោយសារព័ត៌មាន ចិន ស៊ីន ហួរ នា រសៀល ថ្ងៃសៅរ៍ ទី ២៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
