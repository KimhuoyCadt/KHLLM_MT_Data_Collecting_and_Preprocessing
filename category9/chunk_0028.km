( ភ្នំពេញ ) ៖ ក្នុង នាម ជា មេដឹកនាំ នៃ ប្រទេស ជិតខាង គ្នា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ ទៅ សាធារណរដ្ឋ សង្គម និយម វៀតណាម នៅ ថ្ងៃទី ២៦ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ដើម្បី គោរព វិញ្ញាណក្ខន្ធ សព លោក ត្រាន់ ដាយ ក្វាង អតីត ប្រធានាធិបតី វៀតណាម ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃទី ២១ ខែកញ្ញា ឆ្នាំ ២០១៨ ។ នេះ បើ តាម សេចក្ដីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្ដរជាតិ ដែល អង្គភាព Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។
ឥស្សរៈ ជន កម្ពុជា ដែល នឹង អញ្ជើញ អម ដំណើរ សម្តេច តេជោ ហ៊ុន សែន រួម មាន៖ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ . លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ធ សភា ព្រឹទ្ធសភា និង អធិការកិច្ច និង មន្រ្តី ជាន់ ខ្ពស់ មួយចំនួន ទៀត នៃ រាជ រដ្ឋាភិបាល កម្ពុជា ។
កាលពី ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៦ សម្ដេច នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ក៏ បាន ដឹកនាំ គណៈប្រតិភូ ទៅ គោរព ព្រះវិញ្ញាណក្ខន្ធ ព្រះមហាក្សត្រ ថៃ ភូមិ ពល អាឌុល យ៉ាដេត (Bhumibol Adulyadej) នៅ ទីក្រុង បាងកក ហើយ នាយក រដ្ឋមន្ត្រី វៀតណាម នាយក រដ្ឋមន្ត្រី ឡាវ និង នាយក រដ្ឋមន្ត្រី ថៃ ក៏ ធ្លាប់ បាន ចូលរួម គោរព ព្រះវិញ្ញាណក្ខន្ធ ព្រះមហា វីរក្សត្រ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ នរោត្តម សីហនុ ផងដែរ កាលពី ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០១២ ៕
តាមរយៈ ខ្សែ វីដេអូ នេះ ក៏ បាន បង្ហាញ ពី ប្រភព ទឹក ទន្លេ ដែល បាន ហូ ចាក់ មកពី ទន្លេ ឡាង ឆាង ប្រទេស ចិន តាមរយៈ ទន្លេ មេគង្គ ដែល បាន ហូកាត់ ជាច្រើន ប្រទេស ដែល ជា ប្រភព នៃ ការស្រោចស្រប ពាំនាំ នូវ ភក់ ល្បាប់ បង្កើន ជីជាតិ ដី ស្រែ ប្រទាក់ ក្រឡា គ្នា រវាង ប្រទេស ចិន និង ប្រទេស កម្ពុជា ដែល មាន តាំងពី យូរ លុង មកហើយ ផងដែរ ដែល ជា អំណោយផល ដល់ ល្អ មួយ សំរាប់ ក្រុមគ្រួសារ របស់ លោក ក៏ ដូចជា ប្រជាជន កម្ពុជា និង ប្រជាជន ទូទៅ ដែល រស់ នៅ តាម ដងទន្លេ ធ្វើ ស្រែ ចំការ ជារៀងរហូតមក ។
សូម ទស្សនា កម្រង ខ្សែ វីដេអូ ស្ដីពី សកម្មភាព ធ្វើ ស្រែ របស់ លោក ឧកញ៉ា ឌី ប៉ូ ដូច ខាងក្រោម៖
ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៤ ជួប សំណេះសំណាល ជាមួយ ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង អាជ្ញាធរ / សមត្ថកិច្ច មូលដ្ឋាន
( សៀមរាប ) ៖ ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៤ ដែល ដឹកនាំ ដោយ លោក ប៉ុល លឹម ប្រធាន ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៤ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ជួប សំណេះសំណាល ជាមួយ ក្រុមប្រឹក្សា ឃុំ / សង្កាត់ និង អាជ្ញាធរ / សមត្ថកិច្ច មូលដ្ឋាន នៅ ខេត្ត សៀមរាប ប្រមាណ ជាង ៥០០ រូប ។
គោលបំណង នៃ អង្គ ពិធី នេះ គឺ ដើម្បី លើកកម្ពស់ សមត្ថភាព និង ពង្រឹង ការអនុវត្ត តួនាទី ភារកិច្ច ដែល ជាមួយគ្នា នេះ អង្គ ពិធី បាន ស្តាប់ នូវ បទបង្ហាញ ការពិភាក្សា និង អនុសាសន៍ ដូច ខាងក្រោម៖
ទី ១៖ បទបង្ហាញ ស្តីពី តួនាទី ភារកិច្ច របស់ ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា . ទី ២៖ ការងារ អត្រានុកូលដ្ឋាន . ទី ៣៖ ការកែតម្រូវ អក្ខរាវិរទ្ធ ក្នុង អត្រានុកូលដ្ឋាន . ទី ៤៖ ការផ្តល់ សេវា រដ្ឋបាល . ទី ៥៖ មូលនិធិ អភិវឌ្ឍន៍ ឃុំ សង្កាត់ . ទី ៦៖ ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ។
ជាមួយគ្នា នេះ អង្គ ពិធី បាន ស្តាប់ នូវ អនុសាសន៍ ចម្បង ជាច្រើន ក្នុង ការជំរុញ ការផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ ឆាប់រហ័ស មាន ប្រសិទ្ធិភាព និង តម្លាភាព ជាមួយនិង ការទទួលខុសត្រូវ ខ្ពស់ ផងដែរ ៕
ទេសរដ្ឋមន្ដ្រី គន់ គីម ប្រកាស ឲ្យ ចូលកាន់ តំណែង ប្រធាន សមាគម អតីត យុទ្ធជន រាជធានី ភ្នំពេញ . ឧត្តមសេនីយ៍ ឯក ស ថេត ជំនួស នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ដែល ទទួល ភារកិច្ច ថ្មី
( ភ្នំពេញ ) ៖ ទេសរដ្ឋមន្រ្តី គន់ គីម អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ អញ្ជើញ ប្រកាស តែងតាំង លោក ឧត្តមសេនីយ៍ ឯក ស ថេត ជា ប្រធាន សមាគម អតីត យុទ្ធជន រាជធានី ភ្នំពេញ ជំនួស នាយ ឧត្តមសេនីយ៍ ជួន សុណ្ណ ដែល ត្រូវ ទៅ ទទួល ភារកិច្ច ថ្មី និង ជួប សំណេះសំណាល និង ផ្តល់ ប័ណ្ណ បេឡា សន្តិសុខ សង្គម ជូន ដល់ សមាជិក អតីត យុទ្ធជន រាជធានី ភ្នំ ពញ ចំនួន ៦. ២៨៨ នាក់ ។
បន្ទាប់ពី របាយកាណ៍ របស់ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ រួច មក ទេសរដ្ឋមន្រ្តី គន់ គីម បាន នាំមក នូវ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន សមាគម ជូន ដល់ សមាជិក ទាំងអស់ ព្រមទាំង បាន បញ្ជាក់ ថា ដោយ ការយកចិត្តទុកដាក់ និង គិតគូរ ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន ជាពិសេស ការអនុវត្ត នូវ គោល នយោបាយ គាំពារ សង្គម ដែល សម្តេច បាន ប្រកាល នៅក្នុង យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត កន្លងមក ទើប ថ្ងៃ នេះ សមាជិក ទទួលបាន ប័ណ្ណ បេឡា សន្តិសុខ សង្គម សម្រាប់ ការព្យាបាល ជំងឺ ដោយ មិន អស់ លុយ នៅ តាម មន្ទីរពេទ្យ ។
បន្ថែម ពី នេះ ទេសរដ្ឋមន្ដ្រី គន់ គីម បាន ថ្លែង កោតស សើរ និង អរគុណ ចំពោះ សមាជិក សមាគម អតីត យុទ្ធជន កម្ពុជា ដែល បាន ទៅ បោះឆ្នោត និង បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន រហូត ទទួលបាន អាសនៈ នៅក្នុង រដ្ឋសភា ទាំងស្រុង ដើម្បី បន្ដ ដឹកនាំ រាជ រដ្ឋាភិបាល នៅ អាណត្តិ ទី៦ នេះ ។
បើ តាម លោក ទេសរដ្ឋមន្ដ្រី កន្លងមក លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ជា ប្រធាន កិត្តិយស មាគម អតីត យុទ្ធជន កម្ពុជា រាជធានី ភ្នំពេញ ក្នុង នាម សម្តេច ប្រធាន បាន សម្រេច ផ្តល់ ផ្ទះ ២០០ ខ្នង ជូន ដល់ សមាជិក អតីត យុទ្ធជន ដែល ខ្វះខាត ឥឡូវ ទើបតែ សាងសង់ បាន ជាង ១០ខ្នង ប៉ុណ្ណោះ ហេតុ នេះ សូមឲ្យ លោក អធិការ គ្រប់ ខណ្ឌ ដែល ជា ប្រធាន សមាគម ថ្នាក់ ខណ្ឌ ត្រូវ ចុះ ពិនិត្យ និង លើក សំណើមក ដើម្បី ដោះស្រាយ សាងសង់ ជូន បាន ទាន់ ពេល វេលា ។
មុននឹង បញ្ចប់ លោក ទេសរដ្ឋមន្ដ្រី គន់ គីម បាន ផ្តាំផ្ញើ ឲ្យ ប្រធាន សមាគម អតីត យុទ្ធជន រាជធានី ភ្នំពេញ ថ្មី ត្រូវ ជំរុញ ឲ្យ ថ្នាក់ដឹកនាំ សមាគម គ្រប់ ថ្នាក់ ត្រូវ គិតគូរ ពី សុខ ទុក្ខ និង ជីវភាព សមាជិក ឲ្យបាន ល្អ ៕
ការបើក សម្ពោធ នេះ ធ្វើឡើង ក្រោម ការចូលរួម ពី លោក ស៊ាង ប៊ុន លាង អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ទីប្រឹក្សា ផ្ទាល់ សម្ដេច តេជោ ហ៊ុន សែន . លោកស្រី ហ៊ុន ប៊ុន ធឿន ទីប្រឹក្សា អម ក្រសួង ការងារ បរទេស ឋានៈ ស្មើ អនុ រដ្ឋលេខាធិការ និង ជា អនុប្រធាន នាយកដ្ឋាន ហិរញ្ញវត្ថុ . ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ របស់ ក្រុមហ៊ុន វីនហ្គោ ព្រមទាំង ភ្ញៀវ កិត្តិយស មកពី បណ្តាល ប្រទេស ជាច្រើន រួម មាន៖ នាយក ប្រតិបត្តិ នៃ ក្រុមហ៊ុន ផ្សេង ៗ និង ភ្នាក់ងារ ឆ្នោត របស់ ក្រុមហ៊ុន ច្រើន រូប ផងដែរ ។
លោក ស៊ាង ប៊ុន លាង បាន ថ្លែង ឲ្យដឹង ថា ក្រៅពី ដំណើរការ ជា ផ្លូវការ ក្រុមហ៊ុន នៅ កម្ពុជា ក្រុមហ៊ុន ឆ្នោត Wingo នឹង បង្កើត ភ្នាក់ងារ លក់ ឆ្នោត តាម បណ្ដា ខេត្ត ផ្សេង ៗ នៅ កម្ពុជា ដើម្បី ផ្ដល់ ភាពងាយស្រួល ដល់ អតិថិជន ក្នុង ការទិញ ឆ្នោត និង អាច បើក រង្វាន់ ឆ្នោត នៅ តាម ភ្នាក់ងារ លក់ ឆ្នោត ដែល ជិត បំផុត ។
លោក បន្ដ ទៀត ថា ក្រៅពី ការដំណើរការ អាជីវកម្ម ឆ្នោត ក្រុមហ៊ុន Wingo នឹង ចែករំលែក ប្រាក់ ចំណេញ មួយចំនួន ជា មូលនិធិ មនុស្សធម៌ និង សប្បុរស ធម៌ សម្រាប់ ជួយ ឧបត្ថម្ភ ដល់ ជន ក្រីក្រ ជន ជួប ការលំបាក ជន គ្មាន ទីពឹង គ្រប់ ទីកន្លែង ដោយ គ្មាន រើសអើង ។ លោក ថា កត្តា ដែល ក្រុមហ៊ុន ផ្សេង ៗ មក ពី បណ្ដា ប្រទេស មក វិនិយោគ នៅ កម្ពុជា ព្រោះ ប្រទេស កម្ពុជា ជា ប្រទេស អំណោយផល និង ការអភិវឌ្ឍន៍ ឥត ឈប់ឈរ ។
លោក បាន បញ្ជាក់ ទៀត ថា « ខ្ញុំ សង្ឃឹម យ៉ាង មុតមាំ ថា ក្រុមហ៊ុន នឹង ផ្តល់ នូវ ទំនុកចិត្ត ព្រមទាំង ទទួលបាន នូវ ការគាំទ្រ ច្រើន ពី អតិថិជន កម្ពុជា គ្រប់ រូប ។ ក្រុមហ៊ុន ឆ្នោត Wingo មាន គោលដៅ ខិតខំ ប្រឹងប្រែង គ្រប់ បែបយ៉ាង ដើម្បី កែប្រែ ជីវភាព រស់ នៅ របស់ អតិថិជន ឲ្យ កាន់តែ ល្អ ប្រសើរ ជាង មុន » ។
សូម បញ្ជាក់ ថា ក្រុមហ៊ុន Wingo បាន បង្កើត ភ្នាក់ងារ មួយ ចំនួន រួចរាល់ ហើយ នៅក្នុង រាជធានី ភ្នំពេញ ដើម្បី ផ្តល់ ជូន ភាពងាយស្រួល ដល់ អតិថិជន អាច ទិញ សន្លឹក ឆ្នោត និង ប្តូរ រង្វាន់ បាន គ្រប់ ទីកន្លែង . ម៉្យាងទៀត ក្រុមហ៊ុន ក៏ បាន បង្កើត នូវ ឆ្នោត កោស៤ ប្រភេទ ដែល មាន រង្វាន់ ធំ ជា ទឹកប្រាក់ រហូតដល់ ១ម៉ឺន ដុល្លារ ដើម្បី បំពេញ តម្រូវការ ដល់ អតិថិជន ៕
ថ្ងៃ នេះ ខួប ទី ៤៩ ឆ្នាំ នៃ ការចូល ទិវង្គត របស់ សម្ដេច ព្រះមហា សុមេធាធិបតី ជួន ណាត
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ គឺជា ខួប ទី ៤៩ ឆ្នាំ នៃ ចូល ទិវង្គត របស់ សម្ដេច ព្រះមហា សុមេធាធិបតី ជួន ណាត ( ជោតញ្ញាណោ) សម្ដេច ព្រះសង្ឃរាជ ថ្នាក់ ទី១ នៃ គណៈមហា និកាយ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ស្នាដៃ និពន្ធ ជាច្រើន របស់ ព្រះអង្គ បាន បន្សល់ទុកឲ្យ កូន ចៅ ខ្មែរ ប្រើប្រាស់ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ដោយ មាន ទាំង វចនានុក្រម ជាដើម ។
សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត បាន ចូល ព្រះទិវង្គត កាលពី ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ១៩៦៩ ក្នុង ព្រះជន្មាយុ ៨៦ ព្រះវស្សា នៅ ព្រះដំណាក់ ព្រះអង្គ នាវត្ត ឧណ្ណាលោម រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត បាន ប្រសូត នៅ ថ្ងៃអង្គារ៍ ១១រោច ខែ ផល្គុន ឆ្នាំ វក ឆស័ក ព .ស ២៤២៧ ត្រូវនឹង ថ្ងៃទី ១១ ខែមីនា គ.ស ១៨៨៣ ។ នេះ បើ តាម ឯកសារ ចេញផ្សាយ ដោយ វិទ្យាស្ថាន ភាសា ជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ។ ស្រុក កំណើត របស់ ព្រះអង្គ នៅ ភូមិ កំរៀង ឃុំ រកា កោះ ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ និង មាន មាតា ឈ្មោះ យក់ បិតា ឈ្មោះ ព្រហ្ម ជួន ជា កសិករ ។ ព្រះអង្គ មាន បងប្អូន បង្កើត ចំនួន ពីរ នាក់ គឺ រូប ព្រះអង្គ និង ប្អូន ប្រុស គឺ លោក ឧកញ៉ា មន្ត្រី ជួន នុត ។
សម្ដេច ព្រះសង្ឃរាជកាល ក្នុង វ័យ កុមារ ព្រះអង្គ បាន សិក្សា ផ្នែក អក្សរសាស្ត្រ ជាតិ រហូតដល់ ជន្មាយុ ១៨ ឆ្នាំ ព្រះអង្គ បាន បួស ជាសាមណេរ ក្នុង ពុទ្ធ សករាជ ២៤៤១ ត្រូវ នឹង គ. ស១៨៩៧ ។ ព្រះអង្គ បួស នៅ ទីនោះ អស់ រយៈពេល ២ ឆ្នាំ ទើប ទៅ រៀនសូត្រ បរិយត្តិធម៌ នៅ វត្ត ឧណ្ណាលោម រាជធានី ភ្នំពេញ ។
ក្នុង ព្រះជន្មាយុ ២១ វស្សា ព្រះអង្គ បាន បំពេញ ឧបសម្បទា ជា ភិក្ខុ និង គង់ នៅក្នុង វត្ត ពោធិព្រឹក្ស ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្ដាល នៅក្នុង ព.ស ២៤៤៨ ត្រូវ នឹង គ. ស១៩០៤ ។ នៅ ពេល នោះ ព្រះអង្គ បាន ទទួល ព្រះនាមបញ្ញត្តិ ជោតញ្ញាណោ ។
ទាក់ទង នឹង វិស័យ សិក្សា គឺ ព្រះអង្គ បាន ចាប់ផ្ដើម រៀនសូត្រ ជា ដំបូង គឺ មេសូត្រ និង ប្រែ មូល កច្ចាយនៈ និង គម្ពីរ ធម្មបទ ពី ព្រះពុទ្ធ ឃោសាចារ្យ ព្រះនាម ម៉ា កេត ដែល ជា ព្រះឧបជ្ឈា ។ សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត ទ្រង់ បាន រៀន ចេះ ក្រៅពី ភាសា ជាតិ ព្រះអង្គ ក៏ បាន ចេះដឹង នូវ វេយ្យាករណ៍ ភាសា បាលី សំស្ក្រឹត ដែល កាល នោះ ក្នុង រវាង គ. ស១៩១០ ក្នុង ចំណោម អ្នកសិក្សា ភាសា បាលី ព្រះអង្គ មាន ព្រះកិត្តិសព្ទ ល្បី ថា ជា ព្រះថេរៈ មួយ អង្គ មាន ភាពស្ទាត់ជំនាញ និង ពូកែ ខាង ភាសា បាលី ។
ម្យ៉ាងទៀត ព្រះអង្គ បាន រៀន ចេះ ភាសា ផ្សេង ៗ ទៀត ជាច្រើន ដែល រួម មាន៖ ភាសា ថៃ ភាសា ឡាវ ភាសា បារាំង អង់គ្លេស និង វៀតណាម ។ នៅ ពុទ្ធ សករាជ ២៤៥៧ ត្រូវ នឹង គ.ស ១៩១៣ សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត បាន ចូល ប្រឡង ដេញ ប្រយោគ នៅក្នុង ព្រះឧបោស ថរតនា រាម វិហារ ព្រះកែវ មរក តបាន ៤ ប្រយោគ ដែល ជា ប្រយោគ ជាន់ ខ្ពស់ បំផុត ក្នុង សម័យ នោះ ។
នៅ ឆ្នាំ ១៩១៥ ព្រះអង្គ បាន ប្រឡង ជាប់ លេខ ២ និង ទទួលបាន ការតែងតាំង ជា សាស្ត្រាចារ្យ សាលា បាលី ជាន់ ខ្ពស់ ដែល សព្វ ថ្ងៃ នេះ ហៅ ថា ពុទ្ធិក វិទ្យាល័យ សុរា ម្រឹត ។ លុះ មកដល់ ព.ស ២៤៦៣ ដែល កាល នោះ ព្រះអង្គ ជា ព្រះគ្រូ សង្ឃ សត្ថា បាន ធ្វើជា សាមណ សិស្ស និមន្ត ទៅ បំពេញ វិជ្ជា ភាសា សំស្ក្រឹត និង អក្សរ សិលាចារឹក នៅ សាលា បារាំង សែស ចុង បូព៌ា ប្រទេស នៅ ទីក្រុង ហាណូយ ប្រទេស វៀតណាម ដោយ មាន លោក ល្វី ហ្វីណូត៍ (l Finot) ជនជាតិ បារាំង ជា ចាងហ្វាង សាលា នោះ ។
ឯកសារ ចេញផ្សាយ ដោយ វិទ្យាស្ថាន ភាសា ជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន បញ្ជាក់ ទៀត ថា សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត ទ្រង់ បាន បំពេញ ការងារ ជាច្រើន ទៀត ដោយ ធ្វើជា សមាជិក នៃ ក្រុម ជំនុំ វចនានុក្រម ខ្មែរ ជា សមាជិក នៃ ក្រុម ជំនុំ ពិនិត្យ អក្ខរាវិរុទ្ធ ក្នុង សៀវភៅ ផ្សេង ៗ ដែល សាលា បាលី ជាន់ ខ្ពស់ បាន បោះពុម្ព ផ្សាយ ។
ក្រៅពី នេះ ទៀត ព្រះអង្គ បាន ធ្វើជា មេ ប្រយោគ ក្នុង ការប្រឡង យក វិញ្ញាបនប័ត្រ បឋមសិក្សា ខ្មែរ និង ការប្រឡង យក សញ្ញាប័ត្រ បឋមសិក្សា ជាន់ ខ្ពស់ បារាំង ខ្មែរ នៅ រាជធានី ភ្នំពេញ ។
នៅក្នុង ព.ស ២៤៧១ ត្រូវ នឹង គ. ស១៩២៧ ព្រះអង្គ បាន ទទួល ការតែងតាំង ជា សមាជិក ជំនុំ ផ្ដាច់ ឆ្នាំ សម្រាប់ បណ្ណាល័យ កម្ពុជា ដែល សព្វ ថ្ងៃ ហៅ ថា វិទ្យាស្ថាន ពុទ្ធសាសន បណ្ឌិត្យ ។ ក្រៅពី នេះ ទៀត ព្រះអង្គ ជា ចាងហ្វាង រង សាលា បាលី ជាន់ ខ្ពស់ និង ជា សមាជិក ជំនួយ នៃ ក្រុម ជំនុំ ព្រះត្រៃបិដក ។
ម្យ៉ាងទៀត សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត ទ្រង់ ធ្លាប់ ជា សមាជិក នៃ ក្រុម ជំនុំ ខាង ការស្រាវជ្រាវ ជ្រើសរើស រក ពាក្យពេចន៍ ក្នុង ផ្ទៃ រឿង របស់ កវីនិពន្ធ ខ្មែរ បុរាណ ដើម្បី ប្រមូល បញ្ជូន ពាក្យ ទាំងនោះ ទៅក្នុង វចនានុក្រម ខ្មែរ និង ជា សមាជិក ក្រុម ជំនុំ ពិនិត្យ សៀវភៅ របស់ ក្រសួង សិក្សា ធិការ ជាតិ ។
ក្នុង ឯកសារ ដដែល បាន បញ្ជាក់ ថា នៅក្នុង ព.ស ២៤៧៨ គ. ស១៩៣៥ ព្រះអង្គ ធ្វើជា សាស្ត្រាចារ្យ បង្រៀន ភាសា បាលី សំស្ក្រឹត ខ្មែរ និង ឡាវ ប្រចាំ ថ្នាក់ ទីបំផុត នៃ មធ្យមសិក្សា នៅ វិទ្យាល័យ ព្រះស៊ីសុវត្ថិ រាជធានី ភ្នំពេញ ។ សម្ដេច ព្រះសង្ឃរាជ ទ្រង់ បាន ទទួល តំណែង ជា ព្រះចៅ អធិការ វត្ត ឧណ្ណាលោម និង ជា អធិបតី នៃ ថេរស ភា គឺ ក្រុម ជំនុំ ជាន់ ខ្ពស់ របស់ ព្រះសង្ឃ ។ ម្យ៉ាងទៀត ព្រះអង្គ បាន ទទួល តួនាទី ជា អនុប្រធាន គណៈកម្មការ វប្បធម៌ ផ្នែក អក្សរ « ក » នៃ គណៈកម្មការ ជាតិ ខាង ការសិក្សា ។
នៅក្នុង ឆ្នាំ ១៩៦១ ទ្រង់ បាន ធ្វើជា ប្រធាន នៃ ការសម្ភាសន៍ អក្សរសាស្ត្រ ផ្សាយ តាម វិទ្យុជាតិ នៅ រៀងរាល់ ថ្ងៃសុក្រ ។ ព្រះអង្គ ក៏ ជា ប្រធាន គណៈកម្មការពិនិត្យ អត្ថបទ ផ្សាយ ផ្នែក ប្រវត្តិសាស្ត្រ ខ្មែរ និង ជា ប្រធាន គណៈកម្មការពិនិត្យ និង កំណត់ អំពី ន័យ របស់ ទង់ជាតិ ខ្មែរ ។
ទាក់ទង នឹង ការបំពេញ ការងារ នៅ ក្រៅ ប្រទេស សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត ទ្រង់ ដឹកនាំ គណៈប្រតិភូ ទៅ ទស្សនា នៅ វត្ត ខ្មែរ កម្ពុជា ក្រោម និង ទៅកាន់ ប្រទេស ឡាវ ដើម្បី ប្រជុំ ប្រឹក្សា កិច្ចការ នៃ ពុទ្ធសាសន បណ្ឌិត្យ នៅ ទីនោះ ។
នៅ ឆ្នាំ ១៩៤៣ ព្រះអង្គ បាន ទទួល តួនាទី ជា សមាជិក ឆ្លើយឆ្លង សាលា បារាំង នៅ ចុង បូព៌ា ប្រទេស ។ សម្ដេច ក៏ បាន ដឹកនាំ ប្រតិភូ ទៅកាន់ ប្រទេស ស្រីលង្កា ភូមា ដើម្បី ធ្វើ ឆដ្ឋ សង្គាយ នា នៅ ទីនោះ ។ នៅ មាន បេសកកម្ម ក្រៅ ប្រទេស ជាច្រើន ទៀត ដែល សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត ទ្រង់ បាន បំពេញ ការងារ ។
លុះ មកដល់ ព.ស ២៥០៧ គ. ស១៩៦៣ ព្រះអង្គ បាន ទទួល ព្រះឋានៈ ជា សម្ដេច ព្រះសង្ឃរាជ ថ្នាក់ ទី១ ពី សម្ដេច ព្រះនរោត្តម សីហនុ ព្រះប្រមុខរដ្ឋ នៃ ប្រទេស កម្ពុជា ។ បន្ទាប់មក នៅ ឆ្នាំ ១៩៦៧ ព្រះអង្គ បាន ទទួល សញ្ញាប័ត្រ បណ្ឌិត អក្សរសាស្ត្រ ពេញ លក្ខណៈ ពី សម្ដេច ព្រះប្រមុខរដ្ឋ ក្នុង នាម មហាវិទ្យាល័យ អក្សរសាស្ត្រ និង មនុស្សសាស្ត្រ នៃ ភូមិន្ទ សកលវិទ្យាល័យ ។
សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត ទ្រង់ បាន កសាង គម្ពីរ ដីកា ជាច្រើន ទាំង គម្ពីរ ស្លឹក រឹត និង គម្ពីរ ជា សៀវភៅ ជាពិសេស គឺ សៀវភៅ ប្រែ ពី ភាសា បាលី មក ជា ភាសា ខ្មែរ ដើម្បី សម្រាប់ ឲ្យ ពុទ្ធ បរិស័ទ បាន សិក្សា រៀនសូត្រ ។
សៀវភៅ ទាំងនោះ រួម មាន៖ វចនានុក្រម ខ្មែរ មាន ពីរ ភាគ ហើយ ត្រូវបាន គេ បោះពុម្ព ផ្សាយ ជាច្រើន លើក រួច មកហើយ រហូតមកដល់ សព្វ ថ្ងៃ ។ សៀវភៅ កច្ចាយ នូបត្ថម្ភ កៈ ឬ វេយ្យាករណ៍ បាលី មាន ចំនួន ពីរ ភាគ ។ សៀវភៅ គិហិបដិបត្តិ សៀវភៅ សាមណេរ វិន័យ បាតិ មោក្ខ សំវារៈ សង្ខេប កាព្យ លោក ធម៌ ។ល ។
ក្រៅពី នេះ ទៀត ព្រះអង្គ ក៏ បាន តែង ជា សុភមង្គល ភាសា បាលី បឋ្យា វគ្គ ៧ គាថា ព្រមទាំង ប្រែ ជា សម្រាយ សម្រាប់ សូត្រ ថ្វាយ សុភមង្គល ព្រះមហាក្សត្រ ។
ព្រះអង្គ ក៏ បាន តែង អត្ថបទ ផ្សេង ៗ ជាច្រើន ទៀត នៅក្នុង ទស្សនាវដ្ដី កម្ពុជ សុរិយា របស់ ពុទ្ធសាសន បណ្ឌិត្យ តាំងពី ឆ្នាំ ១៩២៦ ហើយ នៅ មាន អត្ថបទ ធម៌ ផ្សេង ៗ ដែល ចុះ នៅក្នុង ទស្សនាវដ្ដី ពន្លឺ ពុទ្ធ ចក្រ ។
ប្រការ សំខាន់ មួយ ទៀត ដែល គួរឱ្យ កត់សម្គាល់ នោះ សម្ដេច ព្រះសង្ឃរាជ ជួន ណាត ព្រះអង្គ បាន និពន្ធ គឺ និពន្ធ នូវ ទំនុក ច្រៀង បទ ន គរាជ សម្រាប់ ភ្លេង ជាតិ ខ្មែរ ឬ បទ គោរព ទង់ជាតិ ដែល បាន បន្សល់ទុក រហូតមកដល់ សព្វ ថ្ងៃ នេះ ។ ព្រះអង្គ ក៏ បាន តែង និពន្ធ នូវ ទំនុកបទ សរភញ្ញ ឬ ធម៌ សូត្រ ជាបទ ជាដើម ។
នូវ រាល់ ស្នា ព្រះហស្ត ទាំងឡាយ របស់ ព្រះអង្គ ទាំង ផ្នែក អក្សរសាស្ត្រ ជាតិ និង ទាំង ផ្នែក ធម៌ ក្ដី ដូច បាន បញ្ជាក់ មក នេះ រហូតមកដល់ បច្ចុប្បន្ន ស្នា ព្រះហស្ត ទាំងនោះ នៅតែ បាន ដក់ ជាប់ ព្រមទាំង មាន ការកោតសរសើរ យ៉ាង ក្រៃលែង ពីសំណាក់ ពុទ្ធ បរិស័ទ ប្រជាពលរដ្ឋ កូន ចៅ ខ្មែរ ពី មួយ ជំនាន់ ទៅ មួយ ជំនាន់ ។ ដោយ ហេតុ គេ ឃើញ ថា ស្នា ព្រះហស្ត អស់ ទាំងនោះ គឺ មាន សារសំខាន់ និង មាន ប្រយោជន៍ ក្នុង ការជួយ ដល់ ការសិក្សា របស់ គេ ទាំង ផ្លូវ លោក និង ផ្លូវ ធម៌ ៕
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ទទួលបាន ការគាំទ្រ យ៉ាង ច្រើន លើសលប់ ពី ប្រជាពលរដ្ឋ នៅក្នុង ការបោះឆ្នោត ជាតិ កាលពី ចុង ខែកក្កដា កន្លងទៅ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា អាណត្តិ ដែល បន្ត ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា បាន ប្រសូត្រ ជា ផ្លូវការ ជាមួយនឹង ការបន្ត ដំណើរ លើ វិថី ពង្រឹង ការបង្រួបបង្រួម ជាតិ ។
ខាងក្រោម នេះ ជា វីដេអូ មួយ បង្ហាញ ពី បន្ត ដំណើរ លើ វិថី ពង្រឹង ការបង្រួបបង្រួម ជាតិ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា អាណត្តិ ថ្មី៖ រកឃើញ បង្អែមលត ខៀវ ផ្ទុក សារធាតុ គីមី Borax ដាក់ លក់ នៅ ផ្សារ ដី ហុយ . មន្រ្តី កាំ កុងត្រូល តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ ដកហូត យក ទៅ កម្ទេចចោល
( ភ្នំពេញ ) ៖ ក្នុង គោលបំណង ការពារ ផលប្រយោជន៍ របស់ អ្នកប្រើប្រាស់ និង ចូលរួម ទប់ស្កាត់ ផល ប៉ះពាល់ ដល់ សុខភាព ដែល ជា កង្វល់ រួម របស់ អ្នកប្រើប្រាស់ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ សាខា កាំ កុងត្រូល តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម រាជធានី និង គណៈកម្មការ ផ្សារ បាន បន្ត ចុះ មក ពិនិត្យ គុណភាព ទំនិញ ជា ម្ហូប អាហារ នៅ ផ្សារ ដី ហុយ ក្នុង សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
មន្រ្តី កាំ កុងត្រូល តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ បាន ឲ្យដឹង ថា ក្នុង ពេល ត្រួតពិនិត្យ នោះ ទំនិញ ជា ម្ហូប អាហារ ចំនួន ១៧ គំរូ រួម មាន៖ ម៊ឹក ក្លាសេ បង្គា ក្លាសេ ត្រី ប្រាហើម ត្រី ងៀត ប្រហិត សាច់ គោ ប្រហិត សាច់ ត្រី ឈាម ជ្រូក សរសៃ គុយ ទាវ បង្អែមលត ខៀវ បង្អែម បាញ់ ឌុក សណ្តែក បណ្តុះ ខ្ញី ហាន់ រួច ទំពាំង ជូរ ស្ពៃ ជ្រក់ ។ល ។ ត្រូវបាន សាខា ជ្រើស យកមក ធ្វើ វិភាគ បឋម នៅនឹង កន្លែង ដោយ ប្រើ Test kit ។
ជា លទ្ធផល វិភាគ ទំនិញ ជា ម្ហូប អាហារ ចំនួន ១៦ គំរូ មាន អនុលោម ភាព សុវត្ថិភាព ។
ចំពោះ អ្នកលក់ ហើយក៏ ជា អ្នកផលិតផង ( ផលិត មាន លក្ខណៈ តិចតួច ) បាន សារភាព ថា ពិតជា បាន ដាក់ បន្ថែម សារធាតុ គីមី ហាមឃាត់ នោះ ត្រូវបាន សាខា ណែនាំ និង ឲ្យ ធ្វើ កិច្ចសន្យា បញ្ឈប់ ជាបន្ទាន់ នូវ ការ ផលិត ដោយ ដាក់ បន្ថែម នូវ សារធាតុ គីមី ហាមឃាត់ នេះ បន្ត ទៀត ករណី មិន រាងចាល នឹង ចាត់ វិធានការ ផ្លូវ ច្បាប់ ។
ចំពោះ អ្នកទិញ មន្រ្តី កាំ កុងត្រូល ក៏ បាន ណែនាំ ពី របៀប នៃ ការជ្រើសរើស ផលិតផល មាន សុវត្ថិភាព មក បរិភោគ និង បាន ផ្តាំផ្ញើ ដល់ អ្នកទិញ គួរ ពិចារណា មុននឹង សម្រេចចិត្ត ទិញ ជាពិសេស ទំនិញ ដែល ខុសប្លែក ពី ធម្មតា ដូចជា ទំនិញ ដែល មាន សម្រស់ ស្រស់ ឆើតឆាយ មាន លក្ខណៈ ទាក់ទាញ ខ្លាំង ។ល ។
ជាមួយគ្នា នោះ មន្រ្តី កាំ កុងត្រូល តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ ក៏ បាន ឃ្លាំ ពិនិត្យមើល ថ្លៃ លក់ ប្រេងសាំង និង ម៉ាស៊ូត នៅ តាម បណ្តា ស្ថានី យ៏ ប្រេងឥន្ធនៈ នានា ក្នុង ភូមិសាស្រ្ត ខណ្ឌ សែនសុខ វិញ គឺ មាន តម្លៃ សមស្រប ទៅនឹង សេចក្តីជូន ដំណឹង របស់ ក្រសួង ពាណិជ្ជកម្ម លេខ ៣៣៥៥ ចុះ ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០១៨ ដោយ សាំង ធម្មតា មាន តម្លៃ មិន លើស ពី ៤.១៥០ ៛ ក្នុង ១លីត្រ និង ប្រេង ម៉ាស៊ូត មាន តម្លៃ មិន លើស ពី ៤.០០០ ៛ ក្នុង ១លីត្រ ឡើយ ៕
ភ័យ អស់ ព្រលឹង ! ពលរដ្ឋ ម្នាក់ ភ្ញាក់ ពី ដេក ទៅ មើល មង ស្រាប់តែ ប្រទះឃើញ សត្វ ក្រពើ កំពុង ជាប់ មង នៅក្នុង ស្ទឹង មេ ទឹក ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ ) ៖ បុរស ម្នាក់ បាន ភ្ញាក់ផ្អើល និង ភ័យ រន្ធត់ យ៉ាង ខ្លាំង បន្ទាប់ពី ប្រទះឃើញ សត្វ ក្រពើ ដ៏ ធំ មួយ ក្បាល ជាប់ មង របស់ គាត់ ដែល បាន ដាក់ យក ត្រី ក្នុង ស្ទឹង មេ ទឹក ទាំង ព្រឹក ព្រលឹម ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅក្នុង ស្ទឹង មេ ទឹក ដែន ជម្រក សត្វ ព្រៃ ភ្នំ សំកុស ក្នុង ភូមិ កណ្តាល ឃុំ ថ្ម ដា ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ ។
នៅក្នុង ការប្រកួត សហការ ស្វែងរក អ្វី មួយ នៅលើ ដី និង នៅលើ អាកាស គេ បាន សម្ពោធ យន្តហោះ ដ្រូន ស្វ័យប្រវត្តិ ដែល មាន សមត្ថភាព បង្កើត ផែនទី មួយ បាន ភ្លាម ៗ អំពី ទីតាំង ដែល គេ កំណត់ លើ ផ្ទៃដី ជិត១ គីឡូម៉ែត្រ ការេ ។ ហើយ បន្ទាប់មក វា អាច តាមដាន និង សន្មត គោលដៅ ជាក់លាក់ មួយ ស្រប ពេល ដែល កំពុង សហការ ជាមួយ យាន ស្វ័យប្រវត្តិ មួយ ទៀត ដែល នៅលើ ដី ដើម្បី ស្វែងរក អ្វី មួយ ។
ការប្រកួត សហការ ស្វែងរក នៅលើ ដី និង នៅលើ អាកាស ជា ផ្នែក ថ្មី មួយ នៃ ការប្រកួត ហើយ ក្នុង ឆ្នាំ នេះ មាន ប្រាំបី ក្រុម បាន ចូលរួម ។ ចំនុច សំខាន់ នៃ ការប្រកួត គឺ ផ្តោត ទៅ លើ ថា តើ ប្រព័ន្ធ បញ្ជា យាន ស្វ័យប្រវត្តិ នៅលើ ដី អាច ដាក់បញ្ចូល គ្នា ដោយ វិធី ណា ជាមួយ ដ្រូន នៅលើ អាកាស ដើម្បី ទទួលបាន ប្រសិទ្ធភាព ខ្ពស់ បំផុត ។
លោក លី ពិជុន ប្រធាន ក្រុម កង នាវា សកលវិទ្យាល័យ វូហាន និយាយ ថា « ជាធម្មតា នៅ តាម សាលារៀន យើង តែង ផ្តោត ជា សំខាន់ ទៅ លើ ការស្រាវជ្រាវ និង ក្បួន ដោះស្រាយ គណិតវិទ្យា មួយចំនួន ហើយ កម្រ ធ្វើតេស្ត គណិតវិទ្យា របស់ យើង ជាមួយ ស្ថានភាព ពិតជាក់ស្តែង ណាស់ ។ តាមរយៈ ការប្រកួត នេះ យើង អាច ចូលរួម ជាមួយ មិត្ត របស់ យើង និង ក្រុម ដទៃ ទៀត ហើយ រៀន ពី គ្នា ទៅ វិញ ទៅ មក ក៏ ដូចជា អភិវឌ្ឍ ខ្លួន យើង ដែល នេះ ពិតជា លទ្ធផល ដ៏ អស្ចារ្យ » ។
នៅក្នុង ការប្រកួត មនុស្ស យន្ត ដែល អាច ធ្វើ ចលនា ដូចជា វត្ថុ មាន ជីវិត ត្រូវ ឆ្លងកាត់ ឧបសគ្គ ស្រប ពេល ត្រូវ រែក ទម្ងន់ ដ៏ ធ្ងន់ ។ មនុស្ស យន្ត ទាំងនោះ ត្រូវ ធ្វើដំណើរ ឆ្លងកាត់ ផ្ទៃដី ដែល មាន លក្ខណៈ ស្មុគស្មាញ ដូចជា ស្មៅ ដី ភក់ ជ្រាំ និង ប្រឈមមុខ នឹង ឧបសគ្គ ដូចជា ជណ្ដើរ ប្រឡាយ និង ផ្លូវ ចោត ដែល មាន រយៈ ចម្ងាយ ជាង ៩០០ ម៉ែត្រ ។
( ភ្នំពេញ ) ៖ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៅ ទី២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន បង្ហាញ នូវ ក្ដីសង្ឃឹម និង ជឿជាក់ ថា ប្រតិភូ នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា នឹង ទទួលបាន ភាពជោគជ័យ ជូន ប្រទេសជាតិ ក្រោយ ត្រឡប់ មកពី កម្មវិធី « នា វា យុវជន អាស៊ី អាគ្នេយ៍ និង ជប៉ុន SSEAYP លើក ទី៤៥ » នៅ ប្រទេស ជប៉ុន ប៊្រុយណេ ហ្វីលីពីន ថៃ និង វៀតណាម វិញ ជាពិសេស ការពង្រឹង ពង្រីក និង ផ្សព្វផ្សាយ កិត្យានុភាព កម្ពុជា នៅលើ ឆាក អន្តរជាតិ ។
ការដាស់តឿន និង ជំរុញ បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ប្រធាន រដ្ឋសភា បាន អនុញ្ញាតឱ្យ ប្រតិភូ យុវជន ដឹកនាំ ដោយ លោក ស៊្រាង គឹម លី ប្រធាន សមាគម នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា ចូល ជួប សម្តែង ការគួរសម និង ស្នើសុំ អនុសាសន៍ និង ពុទ្ធិ គ្រប់ ជ្រុងជ្រោយ មុនពេល ចេញ ទៅ ចូលរួម កម្មវិធី ខាងលើ ។ កម្មវិធី នេះ មាន រយៈពេល ៥២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៣ ខែតុលា ដល់ ថ្ងៃទី ១២ ខែធ្នូ ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
សម្តេច ប្រធាន រដ្ឋសភា បាន លើកឡើង ថា ការចូលរួម កម្មវិធី នា វា យុវជន អាស៊ី អាគ្នេយ៍ និង ជប៉ុន ជា ឱកាស ពិសេស ក្នុង ការ ឱ្យ យុវជន កម្ពុជា ពង្រឹង និង ពង្រីក ចំណង ទំនាក់ទំនង មិត្តភាព និង ការយោគយល់ គ្នា ទៅ វិញ ទៅ មក រវាង យុវជន អាស៊ាន និង ជាមួយ ប្រទេស ជប៉ុន ។ ត្រូវ សិក្សា ស្វែងយល់ ឱ្យ បាន ច្បាស់ ពី ប្រវត្តិសាស្រ្ត ប្រទេស របស់ ខ្លួន និង ប្រទេស ដទៃ ដើម្បី ងាយស្រួល ក្នុង ការអនុវត្ត ការងារ និង បកស្រាយ បា្រប់ យុវជន រួម ដំណើរ ។
សូម ជម្រាប ថា យុវជន កម្ពុជា ចំនួន ២៩ នាក់ នឹង ត្រូវ ចូលរួម កម្មវិធី នា វា យុវជន អាស៊ី អាគ្នេយ៍ លើក ទី៤៥ ពី ថ្ងៃទី ២៣ ខែតុលា រហូតដល់ ថ្ងៃទី ១២ ខែធ្នូ ឆ្នាំ ២០១៨ នេះ ។
លោក ស្រ៊ាន គឹម លី បាន គូសបញ្ជាក់ ថា នៅ ពេល នោះ យុវជន និង ត្រូវ ចែករំលែក ពី វប្បធម៌ សិល្បៈ នៃ ប្រទេស នីមួយ ៗ ។ ការស្នាក់ នៅ ជាមួយ ឪពុក ម្តាយ ធម៌ ហើយ នៅពេល កម្មវិធី នា វា ឆ្លងកាត់ ប្រទេស ណា យុវជន គណៈប្រតិភូ និង បាន ចូល ជួប សម្តែង ការគួរសម ជាមួយ ថ្នាក់ដឹកនាំ ប្រទេស នោះ ផងដែរ ។
សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន បាន មានប្រសាសន៍ ផ្តាំផ្ញើ ថា « ក្មួយ ត្រូវ ខិតខំ សិក្សា ស្វែងយល់ បន្ថែម ទៀត អំពី ចំណេះដឹង ទូទៅ ទាក់ទង នឹង ស្ថាប័ន តំបន់ និង អន្តរជាតិ នានា ដែល កម្ពុជា ជា សមាជិក ក្នុង នោះ ដូចជា អាស៊ាន អន្តរសភា អាស៊ាន ( អាយប៉ា ) និង អង្គការ អន្តរជាតិ ផ្សេង ៗ ទៀត រួម ទំាង អត្ថប្រយោជន៍ ដែល កើត ចេញ ពី កិច្ចសហប្រតិបត្តិការ ជាមួយ បណ្តា អង្គការ ទំាង នោះ សម្រាប់ កម្ពុជា យើង » ។
សម្តេច បាន ផ្តល់ ជា អនុសាសន៍ ថា យុវជន ដែល ជា ប្រតិភូ ទំាង អស់ ត្រូវ យកចិត្តទុកដាក់ និង សិក្សា រៀនសូត្រ ពី ស្ថានភាព របស់ ប្រទេស ដទៃ និង អំពី ភាពរីកចម្រើន របស់ ប្រទេស នោះ ដើម្បី ពាំនាំ នូវ ចំណុច ល្អ ៗ យកមក អភិវឌ្ឍន៍ ប្រទេស របស់ ខ្លួន ។ ត្រូវ ចេះ ស្រលាញ់ គ្នា ឱ្យ ដូចជា បងប្អូន ដោយ ត្រូវ ធ្វើ ការសហការ គ្នា ធ្វើ ការងារ ជា ក្រុម និង ចេះ ជួយ ធុរៈ គ្នា ទៅ វិញ ទៅ មក នៅ គ្រប់ កាលៈទេសៈ ដូច ពាក្យ ខ្មែរ មួយ ឃ្លា ពោល ថា « នៅ ផ្ទះ ម្តាយ ទីទៃ ទៅ ព្រៃ ម្តាយ តែ មួយ » ។
សម្តេច អគ្គ មហា ពញា ចក្រី បាន សង្កត់ធ្ងន់ ថា យុវជន ទំាង អស់ ត្រូវ ធ្វើជា មគ្គុទេស ដ៏ ល្អ ម្នាក់ ជា អ្នកការទូត ម្នាក់ តំណាង ឱ្យ កម្ពុជា ដោយ រក្សា ឱ្យ បាន នូវ កិត្តិយស តម្លៃ និង វប្បធម៌ របស់ ជាតិ ដោយ ត្រូវ ព្យាយាម លើកកម្ពស់ វប្បធម៌ ទេសចរណ៍ និង អត្តសញ្ញាណ ជាតិ ព្រម ទំាង រក្សា នូវ ទំនាក់ទំនង ល្អ ជាមួយ យុវជន បណ្តា ប្រទេស ដ៏ទៃ ទៀត ។
កម្មវិធី នា វា យុវជន អាស៊ី អាគ្នេយ៍ - ជប៉ុន បង្កើតឡើង ដោយ ប្រទេស ជប៉ុន គឺ នៅ ឆ្នាំ ១៩៧៤ ។ ចំណែក សមាគម នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា បាន បង្កើតឡើង នៅ ឆ្នាំ ២០០៤ ដែល រហូតមកដល់ ពេលនេះ មាន យុវជន កម្ពុជា ចំនួន ៦៦៩ នាក់ ហើយ បាន ចូលរួម ជាមួយ កម្មវិធី នា វា យុវជន អាស៊ី អាគ្នេយ៍ - ជប៉ុន នេះ ។
លោក ស្រ៊ាន គឹម លី បាន ថ្លែង ថា សមាគម នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា បាន ដំណើរការ រហូតមកដល់ ពេលនេះ គឺ ដោយសារ ទទួល បាន ការគំា ទ្រ ពីសំណាក់ ថ្នាក់ដឹកនាំ ស្ថាប័ន កំពូល ៗ របស់ ជាតិ ក្រសួង មន្ទីរ នានា ជាពិសេស ការផ្តល់ កិត្តិយស យ៉ាង ថ្លៃថ្លា របស់ សម្តេច ប្រធាន រដ្ឋសភា ដែល ជា តំណាង ស្ថាប័ន នីតិប្បញ្ញត្តិ របស់ ជាតិ ។
សម្តេច ប្រធាន រដ្ឋសភា បាន ជូន ពរ ដល់ ក្មួយ ៗ យុវជន ទាំងអស់ សូម មាន សុខភាព ល្អ និង ធ្វើដំណើរ ប្រកបដោយ សេចក្តីសុខ សប្បាយ និង មាន សុវត្ថិភាព ព្រមទាំង សម្រេចបាន នូវ លទ្ធផល ផ្លែ ផ្កា តាម ការរំពឹងទុក ។ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ក៏ បាន ផ្តល់ ជូន យុវជន ដែល ជា ប្រតិភូ យុវជន កម្ពុជា នូវ ថវិកា ៤០ ម៉ឺន រៀល សម្រាប់ ម្នាក់ ៗ និង ថវិកា ចំនួន ៤លាន រៀល សម្រាប់ បម្រើការ ក្នុង សមាគម ផងដែរ ៕
សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៤ ជួប សំណេះសំណាល ជាមួយ ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាជ្ញាធរ និង សមត្ថកិច្ច មូលដ្ឋាន នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ លោក ប៉ុល លឹម ប្រធាន ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៤ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន ដឹកនាំ ក្រុម សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៤ ជួប សំណេះសំណាល ជាមួយ ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ អាជ្ញាធរ និង សមត្ថកិច្ច មូលដ្ឋាន នៅ ខេត្ត សៀមរាប នៅ សាល សន្និសីទ នៃ សណ្ឋាគារ សុខា អង្គរ ខេត្ត សៀមរាប ដើម្បី ពង្រីក និង ពង្រឹង នូវ ការផ្ដល់ សេវា សាធារណៈ និង ការអភិវឌ្ឍ នៅ ថ្នាក់ មូលដ្ឋាន ប្រកបដោយ ការទទួលខុសត្រូវ និង មាន ប្រសិទ្ធិភាព ខ្ពស់ ។
កម្មវិធី នេះ ក៏ មាន រវត្តមាន របស់ លោក ឃឹម ប៊ុន សុង អភិបាល នៃ គណៈអភិបាល ខេត្ត សៀមរាប និង លោក អ៊ឹង ហឿន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ស្តីទី អភិបាល រង ខេត្ត សមាជិក ក្រុមប្រឹក្សា ខេត្ត នាយក នាយក រង រដ្ឋបាល សមាជិក ព្រឹទ្ធសភា ប្រចាំ ភូមិភាគ ទី៤ និង ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង អាជ្ញាធរ សមត្ថកិច្ច មូលដ្ឋាន ជាង ៥០០ នាក់ ផងដែរ ។
គោលបំណង នៃ អង្គ ពិធី នេះ គឺ ដើម្បី លើកកម្ពស់ សមត្ថភាព និង ពង្រឹង ការអនុវត្ត តួនាទី ភារកិច្ច ។ ជាមួយគ្នា នេះ អង្គ ពិធី បាន ស្តាប់ នូវ បទ បង្ហាញ ការពិភាក្សា និង អនុសាសន៍ ដូច ជា៖
* ទី១៖ បទ បង្ហាញ ស្តីពី តួនាទី ភារកិច្ច របស់ ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា * ទី២៖ ការងារ អត្រានុកូលដ្ឋាន * ទី៣៖ ការកែតម្រូវ អក្ខរាវិរទ្ធ ក្នុង អត្រានុកូលដ្ឋាន *ទី ៤៖ ការផ្តល់ សេវា រដ្ឋបាល * ទី៥៖ មូលនិធិ អភិវឌ្ឍន៍ ឃុំ សង្កាត់ * ៦៖ ការអនុវត្ត គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ។
ជាមួយគ្នា នេះ អង្គ ពិធី បាន ស្តាប់ នូវ អនុសាសន៍ ចម្បង ជាច្រើន ក្នុង ការជម្រុញ ការផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ឆាប់រហ័ស មាន ប្រសិទ្ធិភាព និង តម្លាភាព ជាមួយ និង ការទទួលខុសត្រូវ ខ្ពស់ ផងដែរ ៕ ឧកញ៉ា ផាសុក បណ្ឌិត គាង សេង៖ ចំណេះដឹង ដែល គ្រូ ៗ ផ្តល់ឲ្យ ក្នុង គ្រា លំបាក វេទនា ជា ទុន ដ៏ សំខាន់ សម្រាប់ ឧត្តមភាព ជីវិត
លោក គាង សេង ជា កុមារា ម្នាក់ ដែល បាន កើត នៅក្នុង ភូមិ វត្ត កណ្តាល ឃុំ ស្វាយ ប៉ោរ ស្រុក សង្កែ ខេត្ត បាត់ដំបង និង ធំធាត់ នៅក្នុង ភូមិ អូតាំ គាំ២ សង្កាត់ ទួល តា ឯក ក្រុង បាត់ដំបង ។ កុមារភាព ក្រោយ ប្រទេស រំដោះ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម បាន ធ្វើឲ្យ កុមារ គាង សេង បាន ជួប ឧបសគ្គ និង ទុក្ខលំបាក ជាច្រើន ក្នុង នាម ជា កូន កំព្រា ឪពុក មាន តែ ម្តាយ ដែល រាប់ រង ចិញ្ចឹម កូន រហូតដល់ទៅ ៣នាក់ ។
លោក ឧកញ៉ា គាង សេង បាន រៀបរាប់ ថា តាមរយៈ ស្ថានភាព ដ៏ លំបាក របស់ លោក ពេល នោះ បើ គ្មាន ការតស៊ូ ប្រឹងប្រែង ជំរុញ របស់ ម្តាយ ការប្រឹងប្រែង ផ្ទាល់ខ្លួន ហើយ បើ គ្មាន ការជួយជ្រោមជ្រែង លើកទឹកចិត្ត និង ការលះបង់ ពី គ្រូ ៗ ទេ លោក មិន អាច ចាប់ យក ការសិក្សា ច្បាម យក ចំណេះដឹង ធ្វើជា ដើមទុន សាង ឧត្តមភាព ជីវិត ដូច ពេល បច្ចុប្បន្ន នោះ ឡើយ ។
« ពួកគាត់ មាន សណ្តានចិត្ត ល្អ ណាស់ គាត់ តែងតែ ប្រឹងប្រែង ជួយ បង្ហាត់ បង្រៀន យើង និង តែងតែ លើកទឹកចិត្ត ឲ្យ ប្រឹងប្រែង សិក្សា រៀនសូត្រ ។ ពួកគាត់ គឺ ល្អ ណាស់ បើ គ្មាន ពួកគាត់ ជួយ ប្រឹងប្រែង ផ្ទេរ ចំណេះដឹង មក យើង ទេ យើង មិន អាច មាន ថ្ងៃ នេះ បាន ឡើយ ។ នេះ ជា គុណ បំណាច់ ដ៏ ធំធេង មួយ សម្រាប់ ជីវិត របស់ ខ្ញុំ » ។ ឧកញ៉ា ផាសុក បណ្ឌិត គាង សេង រៀបរាប់ រំលឹក ពី ស្លាកស្នាម អនុស្សាវរីយ៍ ជាមួយ គ្រូ ៗ ក្នុង គ្រា ក្រខ្សត់ ពី កុមារភាព ។
បេះដូង ប្រកបដោយ មនោសញ្ចេតនា និង ការគោរព ដឹងគុណ ចំពោះ គ្រូ ៗ ដែល ត្រូវបាន គេ ប្រសិទ្ធ នាម ជា អ្នកមាន គុណ ទី២បន្ទាប់ពី ឪពុក ម្តាយ នោះ ឧកញ៉ា គាង សេង នៅ សប្តាហ៍ មុនេះ បាន រៀបចំ កម្មវិធី អញ្ជើញ គ្រូបង្រៀន របស់ ខ្លួន ក្នុង ខេត្ត បាត់ដំបង មាន វ័យ ចំណាស់ ៗ ហើយ បច្ចុប្បន្ន បាន ក្លាយជា និវត្តន៍ ជន អស់ ទៅ ហើយ ជិត ២០ នាក់ មក លេង កម្សាន្ត នៅ រាជធានី ភ្នំពេញ ដើម្បី បាន ឃើញ ពី ការអភិវឌ្ឍន៍ និង ភាពស្រស់បំព្រង របស់ រាជធានី ភ្នំពេញ នា ពេល បច្ចុប្បន្ន ។
ក្រៅពី នាំទស្សនា នៅក្នុង រាជធានី ភ្នំពេញ និង បាន ទៅ លេង កម្សាន្ត នៅ រមណីយដ្ឋាន មួយចំនួន ហើយ នោះ ក្នុង រយៈពេល ពីរ ថ្ងៃ នេះ ឧកញ៉ា គាង សេង ក៏ បាន នាំ គ្រូ ៗ ជា អ្នកមាន គុណ ដល់ ខ្លួន ទៅកាន់ ភោជនីយដ្ឋាន ល្បី ៗ និង ស្រស់ ស្រូប អាហារ ឆ្ងាញ់ ៗ ហើយក៏ មាន ផ្តល់ ជា សម្លៀកបំពាក់ សៀវភៅ សុខភាព ព្រមទាំង ផ្តល់ ការថែទាំង សុខភាព ដោយ ឥត គិត ថ្លៃ ជូន ពួកគាត់ ថែម ទៀត ផង ។
លោក ឧកញ៉ា ក៏ បាន អរគុណ គ្រូ ៗ ជាទីគោរព ស្រឡាញ់ ទាំងអស់ ដែល បាន ឆ្លៀត ពេល ដ៏ មាន តម្លៃ ចាក ឆ្ងាយ ពី គ្រួសារ និង បរិចាក ការនឿយហត់ មក លេង អតីត សិស្ស ដែល មាន ប្រវត្តិ ដ៏ កម្សត់ ជូរ ចត់ ម្នាក់ នេះ ។
មួយ ទៀត គឺ ដោយសារតែ ការកើនឡើង ទម្ងន់ ដី ទៅ ភាគ ខាងជើង ខណៈ ដែល ផ្ទាំង ទឹកក ធំ ៗ ប្រមូលផ្តុំ ខ្លួន វា វិញ នៅពេល មាន ការលាយ ។ ចុងក្រោយ គឺ ទាក់ទង ជាមួយ ស្រទាប់ Mantle ដែល ជា ស្រទាប់ កណ្តាល របស់ ផែនដី ដែល មាន ចលនា ប្រែប្រួល ធ្វើឲ្យ ប៉ះពាល់ ដល់ លំនឹង នៃ អ័ក្ស របស់ ភព ផែនដី ធ្វើឲ្យ ផែនដី យើង ល្អៀង អ័ក្ស ទៅ រក ព្រះអាទិត្យ រហូតដល់ទៅ ជាង ១០ម៉ែត្រ បន្ថែម ទៀត ។
គួរ ជម្រាប ថា អ្នកវិទ្យាសាស្រ្ត បាន ដឹង យូរ មកហើយ ថា របាយ នៃ ទម្ងន់ នៅ ជុំវិញ ផែនដី ស្ថិត ក្រោម ការកំណត់ នៃ រង្វិល ជុំ របស់ វា ហើយ រង្វិល ជុំ របស់ ផែនដី គឺ ពុំ មាន ភាពស្មើគ្នា ឥត ខ្ចោះ នោះ ឡើយ បើ តាម អ្នកវិទ្យាសាស្រ្ត ដឹង ដោយសារតែ ការប្រែប្រួល នៅក្នុង ចលនា នៃ ផ្កាយ នៅលើ ផ្ទៃ មេឃ ដែល ត្រូវបាន កត់ត្រា ទុក អស់ រយៈពេល រាប់ ពាន់ ឆ្នាំ កន្លងមក នេះ ។
លោក បណ្ឌិត គិន ភាព មន្ត្រី ជាន់ ខ្ពស់ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន លើកឡើង ថា « សកម្មភាព និង កាយវិការ ទាំង នេះ បាន ធ្វើឲ្យ រាស្ត្រ មាន ភាព មន្ទិល ពី សមត្ថភាព នៃ សមាជិក នៃ ឧត្តម ក្រុមប្រឹក្សា មួយ នេះ ដែល សុទ្ធតែ មាន ឋានៈ ស្មើ ទេសរដ្ឋមន្ត្រី និង រដ្ឋមន្ត្រី និង ទទួល ប្រាក់ខែ ពី រាជការ ច្រើន គួរសម ដែល ជា ប្រាក់ បង់ ពន្ធ របស់ រាស្ត្រ ។ ការរៀបចំ ខ្លួន លក្ខណៈ សម្បត្តិ សមត្ថភាព និង ឥរិយាបទ បុគ្គល អាច ប៉ះពាល់ ដល់ ស្ថាប័ន ទាំងមូល » ។
មន្ត្រី ជាន់ ខ្ពស់ នៃ រាជ បណ្ឌិត្យ សភា រូប នេះ ក៏ បាន រំលឹក ពី ការជ្រើសមន្ត្រី នៅក្នុង សម័យ សាធារណរដ្ឋ ប្រជាមានិត កម្ពុជា និង រដ្ឋ កម្ពុជា ពី ឆ្នាំ ១៩៧៩ ដល់ ១៩៩៣ ផងដែរ ។ លោក គិន ភា បាន បញ្ជាក់ ថា ក្នុង សម័យ នោះ មុន តែងតាំង មន្ត្រី ណា ម្នាក់ ឲ្យ កាន់ តួនាទី ណាមួយ មិន ថា តូច ឬ ធំ ទេ គេ សិក្សា ពី ប្រវត្តិ រូប មន្ត្រី នោះ ល្អិតល្អន់ ណាស់ មិន មែន ដូច បច្ចុប្បន្ន នេះ ឡើយ ។
ក្នុង ព្រះរាជ ក្រឹត្យ ស្តីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ ក្នុង មាត្រា១ បាន គូសបញ្ជាក់ ថា ការបង្កើត ស្ថាប័ន នេះ មាន គោលបំណង លើកស្ទួយ របប នយោបាយ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ដើម្បី ប្រមូលធនធាន នៃ ទស្សនៈ ពហុ គំនិត ជាប្រយោជន៍ ដល់ ការអភិវឌ្ឍ ជាតិ និង នាំមក នូវ ប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ ខ្មែរ ។
អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល៖ វត្តមាន បងប្អូន ខ្មែរ ស្វាគមន៍ សម្ដេច តេជោ ហ៊ុន សែន នៅ ញូវយ៉ក គឺជា សញ្ញា នៃ ឯកភាព ជាតិ
( ភ្នំពេញ ) ៖ លោក ផៃ ស៊ីផាន អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ថ្លែង ថា វត្តមាន របស់ បងប្អូន ជន រួម ជាតិ ខ្មែរ នៅ ក្រៅ ស្រុក ជាមួយ សម្ដេច តេជោ ហ៊ុន សែន គឺជា សញ្ញា នៃ ឯកភាព ជាតិ ហើយ ជា សម្បត្តិ មរតក របស់ ជាតិ ខ្មែរ ដែល ជា ធាតុ ចូលរួម ផ្សះផ្សា ក្នុង កិច្ចការពារ និង កសាង ជាតិ ដូច អ្វី ដែល ខ្មែរ បាន ធ្វើ និង ទទួលបាន ជោគជ័យ ។
លោក ផៃ ស៊ីផាន បាន លើកឡើង ដូច្នេះ បន្ទាប់ពី មាន ប្រជាពលរដ្ឋ ខ្មែរ រស់ នៅ សហរដ្ឋ អាមេរិក ជា បន្តបន្ទាប់ បាន ប្រកាស អំពី ភាពរីករាយ ចាំ ទទួលស្វាគមន៍ និង ទទួល ជួប សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា អំឡុង កិច្ចប្រជុំ អង្គការ សហ ប្រជាជាតិ នៅ ទីក្រុង ញូវយ៉ក ខាងមុខ នេះ ។
លោក ផៃ ស៊ីផាន បាន លើកឡើង ថា « កម្ពុជា បាន បោះជំហ៊ាន យ៉ាង ធំ ប្រកបដោយ សក្ដានុពលភាព ថាមពល និង ប្រសិទ្ធភាព ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ។ គឺ បរទេស ទេ ដែល បំបែក យើង គេ ទេ ! ដែល នាំ យើង ឲ្យ បម្រើម នោគម វិជ្ជា នៃ ផលប្រយោជន៍ ភូមិសាស្រ្ត នយោបាយ ក្នុង ការប្រកួតប្រជែង អំណាច និង ឥទ្ធិពល របស់ គេ នោះ រាប់ ទាំង អ្នកជិតខាង និង បរទេស ឯ នាយ សមុទ្រ ផង ។ នេះ ជា ប្រវត្តិសាស្រ្ដ មួយ ដ៏ ឈឺចាប់ បំផុត » ។
ទេសរដ្ឋមន្ត្រី មាស សុភា ចូលរួម កាន់ វេន បិណ្ឌ ទី១ នៅ វត្ត គោក បេង ក្រុង ព្រះវិហារ
( ព្រះវិហារ ) ៖ ទេសរដ្ឋមន្ត្រី មាស សុភា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត ព្រះវិហារ និង លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ចូលរួម ថ្ងៃ វេន បិណ្ឌ ទី១ នៅ វត្ត គោ គបេង សង្កាត់ កំពង់ប្រណាក ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ ។
នៅក្នុង ឱកាស នោះ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា បាន នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ដោយ ក្តី នឹករលឹក ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ លោកយាយ លោក តា គ្រប់ ៗ រូប ក្នុង ថ្ងៃ ភ្ជុំ បិណ្ឌ នេះ ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី បាន បន្ត ទៀត ថា ការកាន់ បិណ្ឌ បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ជា ប្រពៃណី តាំងពី ដូន តា ខ្មែរ ហើយ គោលបំណង នៃ ពិធី ភ្ជុំ បិណ្ឌ នេះ គឺ ដើម្បី ទុក លទ្ធភាព ឲ្យ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ គង់ ចាំ ព្រះវស្សា នៅក្នុង ទី អារ៉ាម ។
លោក បន្ត ថា ម៉្យាងទៀត គឺ ដើម្បី រំឭក ដល់ វិញ្ញាណក្ខន្ធ បុព្វការី ជន ដែល បាន លាចាក លោក នេះ ទៅកាន់ លោក ខាងមុខ ។
លោក អ៊ុន ចាន់ ដា បាន លើកឡើង ថា កុសល ផល បុណ្យ ដែល បាន ធ្វើ ក្នុង ថ្ងៃ វេន បិណ្ឌ ទី១ នេះ ពិតជា បាន ឆ្លើយតប ចំពោះ អ្វី ដែល កម្ពុជា កំពុងតែ ស្ថិត ក្នុង ភាពសប្បាយរីករាយ ហើយ ថ្ងៃ នេះ ដែរ លោក ក៏ បាន ឧទ្ទិស កុសល ផល បុណ្យ ដល់ វីរ យុទ្ធជន ដែល បាន លះបង់ ជីវិត ក្នុង បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ ។ លោក ថា លោក ក៏ បាន ឧទ្ទិស កុសល ផល បុណ្យ ដល់ លោក ព្រាប តាន់ អតីត អភិបាល ខេត្ត ព្រះវិហារ ដែល បាន ទទួលមរណភាព ។
លោក អ៊ុន ចាន់ ដា បាន សំណូមពរ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ លោកយាយ លោក តា នៅក្នុង ថ្ងៃ ភ្ជុំ បិណ្ឌ នេះ គឺ ធ្វើ យ៉ាងណា កុំ ឲ្យ ការជួបជុំគ្នា ក្នុង ឱកាស នេះ ប្រែក្លាយជា ការព្រាត់ប្រាស់ គ្នា តាមរយៈ ការធ្វើដំណើរ ទី ជិត ទី ឆ្ងាយ ដោយ ការធ្វេសប្រហែស ក្នុង ការធ្វើដំណើរ ដោយ មិន គោរព ច្បាប់ ចរាចរណ៍ ផងដែរ ។
( បាត់ដំបង ) ៖ បុរស ម្នាក់ ទើប ចេញ ពី គុក ថ្មី ៗ មិន ព្រម លះបង់ គំនិត បាន ធ្វើ ចោរ ដើរ រលួច គេ ពេល យប់ ទៀត ត្រូវបាន សមត្ថកិច្ច ចាប់ បាន ពេល កំពុង ដើរល្បាត នៅ ទៀប ភ្លឺ ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅ ចំណុច ភូមិ នំ ក្រៀប សង្កាត់ ព្រែក ព្រះស្តេច ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង រួច កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ដើម្បី ចាត់ការ តាម ច្បាប់ ។
លោក ក៏ បាន ឱ្យដឹង ទៀត ថា ជនសង្ស័យ ឈ្មោះ សំ ស៊ីណាត ហៅ ពេក ភេទ ប្រុស អាយុ ៣៨ ឆ្នាំ មាន ទីលំនៅ ភូមិ វត្ត តាមឹម ឃុំ អូរ ដំបង ១ ស្រុក សង្កែ ខេត្ត បាត់ដំបង ដែល បាន ធ្វើ សកម្មភាព ចូល លួច ទូរស័ព្ទដៃ ចំនួន ០៦ គ្រឿង នៅក្នុង ផ្ទះ របស់ ជនរងគ្រោះ ឈ្មោះ ឈូក សុខឿន ភេទ ប្រុស អាយុ ៣១ ឆ្នាំ មាន ទីលំនៅ ភូមិ នំ ក្រៀប សង្កាត់ ព្រែក ព្រះស្តេច ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ។ បន្ទាប់ពី បាន ឃាត់ខ្លួន រួច មក សមត្ថកិច្ច បាន ដកហូត វត្ថុតាង ម៉ូតូ ម៉ាក ស៊ូស៊ូ គីវីវ៉ា ស៊េរី ចាស់ មួយ គ្រឿង ផងដែរ ។
បច្ចុប្បន្ន ក្រុម អន្តរាគមន៍ បង្ការ បង្ក្រាប បាន ប្រគល់ ជនសង្ស័យ រួមទាំង វត្ថុតាង ខាងលើ ឱ្យ ទៅ ការិយាល័យ ជំនាញ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ខ្លួន ទៅ តុលាការ ខេត្ត ចាត់ការ តាម នីតិវិធី ៕ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បញ្ជា ថ្នាក់ដឹកនាំ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ទាំងអស់ ត្រូវ សហការ គ្នា ទ្រទ្រង់ ស្ថានការណ៍ សន្ដិសុខ និង សុវត្ថិភាព សង្គម
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន បញ្ជា ទៅ ថ្នាក់ដឹកនាំ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ទាំងអស់ ត្រូវ សហការ គ្នា ទ្រទ្រង់ ស្ថានការណ៍ សន្ដិសុខ និង សុវត្ថិភាព សង្គម ឲ្យបាន កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ក្នុង គោលបំណង ទប់ស្កាត់ និង បង្ក្រាប រាល់ បទល្មើស ទាំងអស់ ។
ថ្លែង ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ក្រោយ បញ្ចប់ ពិធី ប្រកាស ចូលកាន់ តំណែង អគ្គ ស្នងការ រង នគរបាល ជាតិ ថ្មី ចំនួន ៣រូប នៅ ព្រឹក មិញ នេះ លោក ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ឃឿន អគ្គ ស្នងការ រង និង ជា ប្រធាន សេនាធិការ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត លោក បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ទាំងអស់ រួម សហការ គ្នា ទ្រទ្រង់ ស្ថានការណ៍ សន្ដិសុខ សុវត្ថិភាព របស់ សង្គម » ។
បើ តាម អគ្គ ស្នងការ រង នគរបាល ជាតិ រូប នេះ . នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន បាន បញ្ជា ទៅកាន់ គ្រប់ អង្គភាព ជំនាញ ទាំងអស់ ត្រូវ លើកកម្ពស់ គ្រប់គ្រង ដឹកនាំ មន្ដ្រី ក្រោម ឱវាទ រួម មាន ទាំង កម្រិត វិន័យ ជំនាញ ប្រតិបត្តិការ សតិអារម្មណ៍ សីលធម៌ និង ភាពស្មោះត្រង់ របស់ កងកម្លាំង ជាមួយ វិជ្ជាជីវៈ របស់ ខ្លួន ។
បន្ថែម ពី នេះ ដើម្បី សម្រេច និង ទ្រទ្រង់ បាន តាម យុទ្ធសាស្ដ្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល នោះ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បាន ណែនាំ ទៅកាន់ ប្រធាន អង្គភាព ជំនាញ មួយចំនួន ដើម្បី ពង្រឹង ការងារ សន្ដិសុខ ដែល សំខាន់ ទៅ លើ ការប្រមូលផ្ដុំ ព័ត៌មាន ដើម្បី ចាត់ វិធានការ ទប់ស្កាត់ នូវ អំពើ ភេរវកម្ម ឧក្រិដ្ឋកម្ម ឆ្លង ដែន និង បទល្មើស ផ្សេង ៗ ទៀត ដែល អាច មាន ហានិភ័យ បង្ក អសន្ដិសុខ ដល់ ប្រទេសជាតិ ។
នាយ ឧត្តមសេនីយ៍ អគ្គ ស្នងការ នគរបាល ជាតិ ក៏ បាន ជំរុញ ការប្រយុទ្ធ ប្រឆាំង បទល្មើស គ្រឿងញៀន . ជួញដូរ មនុស្ស . បទល្មើស សេដ្ឋកិច្ច និង បទល្មើស ព្រហ្មទណ្ឌ ដែល ត្រូវ ខិតខំ ធ្វើ យ៉ាងណា ដើម្បី ទាញ ឲ្យ បទល្មើស ទាំងឡាយ នោះ ថយចុះ ។ ដោយឡែក បទល្មើស សេដ្ឋកិច្ច ត្រូវ បង្ក្រាប រាល់ ផលិតផល ដែល ប៉ះពាល់ ដល់ សុខភាព របស់ ប្រជាពលរដ្ឋ ។
លើស ពី នេះ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន ក៏ បាន ណែនាំឲ្យ ពង្រឹង លើ កងកម្លាំង ការពារ ព្រំដែន ធ្វើ យ៉ាងណា ត្រូវ ការពារ បូរណភាព ទឹកដី ជាពិសេស ត្រូវ បង្កើន ការលើកទឹកចិត្ត ដល់ កងកម្លាំង ដោយ ត្រូវ គិតគូរ លើ ការបំប៉ន់ ការឧបត្ថម្ភ ស្បៀងអាហារ លេណ ដ្ឋាន ឧបករណ៍ សម្រាប់ បម្រើ ឲ្យ ការការពារ ព្រំដែន និង លុបបំបាត់ ច្រក របៀង ខុស ច្បាប់ ដែល តែង មាន លួច លាក់ នោះ ៕
ឧត្តមសេនីយ៍ ឯក ស ថេត ចុះ សួរសុខទុក្ខ និង នាំ ថវិកា ប្រគល់ ជូន មន្រ្តី នគរបាល ប៉ុស្តិ៍ អូឡាំពិក ដែល ជួប គ្រោះថ្នាក់ ចរាចរណ៍ ពេល កំពុង បំពេញ ភារកិច្ច
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ រួម និង លោក ឧត្តមសេនីយ៍ ត្រី សុង លី ស្នងការ រង បាន ចុះ ទៅ សួរសុខទុក្ខ មន្រ្តី នគរបាល ប៉ុស្តិ៍ អូឡាំពិក ខណ្ឌ ចំការមន ព្រមទាំង នាំយក ថវិកា ផ្ទាល់ខ្លួន ចំនួន ៣លាន រៀល ថែម និង កន្រ្តក ផ្លែ ឈើ លាយ ភេសជ្ជៈ ជូន ដល់ នគរបាល ដែល សំរាក ព្យាបាល ក្នុង មន្ទីរពេទ្យ រុស្ស៊ី ។
លោក មាស សាឯ មវីរី មន្ត្រី នគរបាល ប៉ុស្តិ៍ អូឡាំពិក បាន ជួប គ្រោះថ្នាក់ ចរារណ៍ ពេល កំពុង បំពេញ ភារកិច្ច កាលវេលា ម៉ោង ១១និង ២០នាទី យប់ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅ ចំណុច ខាងក្រោយ វត្ត មហាមន្រ្តី តាម ផ្លូវ ១៧៣ កែង ផ្លូវ ១៩៣ ស្ថិត នៅ ភូមិ ៣ សង្កាត់ អូឡាំពពិក ខណ្ឌ ចំការមន និង កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ សូវៀត ។
លោក ឧត្តមសេនីយ៍ ស ថេត បាន ផ្ដាំផ្ញើ ឲ្យ ក្រុមគ្រួសារ ត្រូវ យកចិត្តទុកដាក់ និង លោក មាស សាឯ មវីរី ខំ តស៊ូ ឡើង ដើម្បី ឆាប់ ជា សះស្បាយ ពី ជំងឺ ។ នៅក្នុង ពេល នោះ លោក ស ថេត ក៏ បាន ផ្ដល់ ថវិកា ជូន អ្នកជំងឺ ដែល សំរាក ជាមួយ នគរបាល ដែល គ្រោះ ចរាចរណ៍ ចំនួន ២នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិការ ចំនួន ១០០ ដុល្លារ ផងដែរ ។
ជាមួយគ្នា នេះ លោក ឧត្តមសេនីយ៍ ឯក ស ថេត ក៏ បាន ឲ្យ ជំនាញ ការិយាល័យ នគរបាល ផ្នែក វាស់ ចរាចរណ៍ ផ្លូវគោក ធ្វើ ការស៊ើបអង្កេត តាមដាន រក រថយន្ត កាំរី ដែល បើក បុក មន្រ្តី នគរបាល បណ្ដាល រង របួស កក ឈាម ក្នុង ខួរក្បាល ដើម្បី ចាត់ការ តាម ផ្លូវ ច្បាប់ ដែល មិន ទទួលខុសត្រូវ បង្ក គ្រោះថ្នាក់ នៅលើ ផ្លូវ សាធារណៈ ៕
រថយន្ត ប្រធាន មន្ទីរ មុខងារ សាធារណៈ ខេត្ត ពោធិ៍សាត់ ត្រូវបាន ចោរ ចូល លួច ទាំង យប់
ហេតុការណ៍ នេះ បាន កើតឡើង កាលពី យប់ រំលង អាធ្រាត ឈានចូល ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ នៅក្នុង ផ្ទះ ជនរងគ្រោះ ស្ថិត ក្នុង ភូមិ តា ស្តី ឃុំ វាល ស្រុក កណ្តៀង ខេត្ត ពោធិ៍សាត់ ។
ម្ចាស់ រថយន្ត បាន ឱ្យដឹង ថា មុន កើត ហេតុ គាត់ បាន ចត ទុក រថយន្ត នៅមុខ ផ្ទះ ហើយ ចាក់សោ ទ្វារ បង ខាងមុខ ត្រឹមត្រូវ រួច ក៏ ចូល សម្រាក នៅក្នុង ផ្ទះ លុះ ព្រឹកឡើង គាត់ ក៏ បាន ភ្ញាក់ ពី ដំណេក ទើប ដឹង ថា បាត់ រថយន្ត ក៏ ផ្អើល ឆោឡោ រាយការណ៍ ទៅ សមត្ថកិច្ច តែម្តង ។
បើ តាម ការសន្និដ្ឋាន របស់ សមត្ថកិច្ច ជនសង្ស័យ ដែល ទៅ លួច រថយន្ត នោះ បាន ធ្វើ សកម្មភាព កាត់ សោរ ចូល ក្នុង អំឡុង ពេល ម្ចាស់ រថយន្ត កំពុង លង់លក់ ក្នុង ដំណេក បច្ចុប្បន្ន សមត្ថកិច្ច កំពុង ធ្វើ ការស្រាវជ្រាវ រក មុខ សញ្ញា មក ចាត់ការ តាម ច្បាប់ ៕ រដ្ឋមន្ត្រី អ៉ិត សំហេង និង មន្ត្រី ក្រោម ឱវាទ រួម ជាមួយ ពុទ្ធ បរិស័ទ ជាច្រើន បាន ចូលរួម កាន់ បិណ្ឌ១ នៅ វត្ត សារា វ័ន្ត តេជោ
( ភ្នំពេញ ) ៖ ដោយ ការប្រតិបត្តិ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា នៅ កម្ពុជា លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ នា ថ្ងៃទី ២៥ ខែកញ្ញា នេះ បាន ដឹកនាំ ថ្នាក់ដឹកនាំ - មន្ត្រី នៃ ក្រសួង ការងារ ចូលរួម ក្នុង ពិធី កាន់ បិណ្ឌ ( បិណ្ឌ១ ) នៅ វត្ត សារា វ័ន្ត តេជោ រាជធានី ភ្នំពេញ ក្នុង នោះ លោកដ្ឋមន្ត្រី បាន ប្រគេន បច្ច័យ មួយចំនួន សម្រាប់ កសាង សមិទ្ធផល ក្នុង វត្ត ប្រគេន ព្រះសង្ឃ ជូន យាយ ជីតា ជី និង សិស្សានុសិស្ស សរុប ថវិកា មាន ចំនួន ១៥.៧៥០.០០០ រៀល ។
ក្នុង ពិធី កាន់ បិណ្ឌ១ នេះ គេ ក៏ សង្កេតឃើញ មាន ប្រជាពុទ្ធ បរិស័ទ ជាច្រើន នាក់ បាន មូរមី នាំគ្នា ទៅ ធ្វើ បុណ្យ ទាន ចាប់ មគ្គផល រៀង ៗ ខ្លួន រួម ជាមួយ ការប្រតិបត្តិការ ធម៌ អារ្យ តាម ព្រះពុទ្ធ សាសនា យ៉ាង ខ្ជាប់ខ្ជួន ខណៈ ប្រទេស កម្ពុជា កំពុង មាន សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ពេញ ផ្ទៃ ប្រទេស ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
តថភាព សង្គម នេះ សបញ្ជាក់ ឱ្យ ឃើញ ថា វិស័យ អាណចក្រ និង ពុទ្ធ ចក្រ នៅ កម្ពុជា កំពុង មាន សុខដុមរមនា នឹង គ្នា យ៉ាង សម្បូរសប្បាយ ក្រោម ល្អង ធូលី ព្រះបាទ ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
បើ តាម ជនរងគ្រោះ បាន អោយ ដឹង ថា រូបលោក ត្រូវ ក្រុមហ៊ុន ចាត់ អោយ ទៅ យាម ផ្ទះ របស់ លោក ឧកញ៉ា ឡុង ហ៊ួរ មាន ទីតាំង ស្ថិត នៅ សង្កាត់ កាកាប១ ខណ្ឌ ពោធិ៍សែនជ័យ ។
បុរស រងគ្រោះ ឈ្មោះ ព្រុំ សារ៉េត បាន និយាយ ថា មុនពេល កើត ហេតុ រូប គេ អង្គុយ យាម កាម នៅក្នុង ផ្ទះ របស់ លោក ឧកញ៉ា ឡុង ហ៊ួរ រួច ក៏ បាន ដេកលក់ មួយ ភាំង លុះ ដល់ ម៉ោង ១០ យប់ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០១៨ ស្រាប់តែ លោក ឧកញ៉ា ឡុង ហ៊ួរ ឃើញ សន្តិសុខ ដេក លង់លក់ ដូច្នេះ ក៏ យក ដង អំបោស សំពង ក្បាល ចំនួន ៣អំបោស បណ្តាលឱ្យ បែក ហូរ ឈាម តែម្ដង ។
ក្រោយពេល ដែល ទទួលរង នូវ ការវាយដំ ពីសំណាក់ លោក ឧកញ៉ា ឡុង ហ៊ួរ ក៏ មាន អង្គរក្ស ម្នាក់ បាន ស្រែក គំរាម ថា ចេញ ឱ្យ ឆ្ងាយ ទៅ ប្រយ័ត្ន គាត់ ចូល ទៅក្នុង ចេញ មកវិញ យក កាំភ្លើង មក បាញ់ រួច គាត់ ក៏ បាន រត់ គេច ចេញ និង មក សុំ ការជួយ អន្តរាគមន៍ ពី នគរបាល ប៉ុស្តិ៍ កាកាប១ តែ ដោយ មិន បាន ជួប សមត្ថកិច្ច រូប គេ ក៏ ត្រលប់ ទៅ ផ្ទះ វិញ ទៅ ។
លុះ ស្អែក ឡើង វេលា ថ្ងៃត្រង់ ទើប រូប គេ បាន ធ្វើដំណើរ មក ប៉ុស្តិ៍ នគរបាល កាកាប១ ដាក់ ពាក្យ បណ្តឹង ទៅ លើ លោក ឧកញ៉ា ឡុង ហ៊ួរ ម្តង ទៀត ដើម្បីឱ្យ នគរបាល អន្តរាគមន៍ និង រក យុត្តិធម៌ ជូន រូប គេ ។
