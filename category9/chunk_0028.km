( ភ្នំពេញ ) ៖ លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល នៅ ព្រឹក ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន រៀបចំ កម្មវិធី ផ្សព្វផ្សាយ យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដល់ មន្ត្រី សុខាភិបាល នៅ ទីស្តីការ ក្រសួង ។ ការផ្សព្វផ្សាយ នេះ មាន គោលបំណង ឲ្យ មន្ត្រី សុខាភិបាល ទាំងអស់ យល់ ឲ្យ ច្បាស់ ពី គោលដៅ នៃ យុទ្ធសាស្ត្រ ចតុកោ ដំណាក់កាល ទី៤ ដើម្បី ត្រៀមខ្លួន ក្នុង ការអភិវឌ្ឍ វិស័យ នេះ ឲ្យបាន ល្អ ប្រសើរ ក្នុង អាណត្តិ ទី៦ នៃ រដ្ឋសភា នេះ ។
រាជ រដ្ឋាភិបាល កម្ពុជា បាន អនុវត្ត ប្រកបដោយ ជោគជ័យ នូវ យុទ្ធសាស្ត្រ ចតុកោណ ដើម្បី កំណើន ការងារ សមធម៌ និង ប្រសិទ្ធភាព នៅ កម្ពុជា ៣ដំណាក់កាល រួច មកហើយ ដែល នាំឲ្យ កម្ពុជា សម្រេចបាន នូវ ការផ្លាស់ប្តូរ មុខមាត់ គួរ ជា ទី មោទនៈ បំផុត ។ មុំ ទី៣ នៃ ចតុកោណទី១ បាន និយាយ អំពី ការលើកកម្ពស់ សេវា សុខភាព សាធារណៈ និង អាហារូបត្ថម្ភ ហើយ ក្រសួង សុខាភិបាល បាន ធ្វើ ការងារ នេះ ប្រកបដោយ ប្រសិទ្ធិភាព បំផុត ។
លោក ម៉ម ប៊ុន ហេង បាន គូសបញ្ជាក់ ថា ទោះបីជា រាជ រដ្ឋាភិបាល សម្រេចបាន នូវ សមិទ្ធផល ធំ ៗ ដូច ខាងលើ ក្តី ក៏ កម្ពុជា នៅតែ ជួប បញ្ហា មួយចំនួន រួម មាន៖ សេវា ថែទាំ សុខភាព បឋម នៅ មិន ទាន់ ឆ្លើយតប បាន ពេញលេញ និង ទាន់ ពេលវេលា . គុណភាព នៃ ការផ្តល់ សេវា ថែទាំ និង ព្យាបាល នៅ មាន កម្រិត . ចំនួន គ្រូពេទ្យ និង បុគ្គលិក សុខាភិបាល តាម ប្រភេទ ជំនាញ នៅ ពុំ ទាន់ គ្រប់គ្រាន់ តាម និយាម នៅឡើយ ។
បើ តាម លោក រដ្ឋមន្ត្រី ប្រព័ន្ធ ធានារ៉ាប់រង សុខភាព មិន ទាន់ គ្របដណ្តប់ សម្រាប់ ទាំងអស់ គ្នា ។ ការយល់ដឹង ពី ការប្រើប្រាស់ ឱសថ ថ្នាំជក់ គ្រឿងស្រវឹង និង ការយល់ដឹង ពី អនាម័យ និង សុវត្ថិភាព ចំណីអាហារ នៅ មាន កម្រិត ហើយ មរណភាព មាតា ទារក និង កុមារ និង កង្វះ អាហារូបត្ថម្ភ របស់ ស្រ្តី ទារក និង កុមារ ក្នុង ចំណោម គ្រួសារ ក្រីក្រ នៅ តំបន់ ជនបទ នៅតែ ជា បញ្ហា ប្រឈម ៕
ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ បើក វគ្គ ស្តីពី អភិបាលកិច្ច ល្អ សម្រាប់ សមាជិក ក្រុមប្រឹក្សា និង ប្រធាន ក្រុមប្រឹក្សា ខណ្ឌ
( ភ្នំពេញ ) ៖ ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ បាន ប្រកាស បើក វគ្គ បណ្តុះបណ្តាល ២ ថ្ងៃ សម្រាប់ សមាជិក ក្រុមប្រឹក្សា រាជធានី ២០ រូប ប្រធាន ក្រុមប្រឹក្សា ខណ្ឌ ១២ រូប គណៈ អភិបាល ៣ និង មន្រ្តី ទី ចាត់ការ ចំណុះ សាលា រាជធានី សរុប ប្រមាណ ៩០ រូប អំពី មេរៀន ចំនួន ពីរ គឺ ១ - គោលការណ៍ ជា សាកល នៃ អភិបាលកិច្ច ល្អ និង ២ - ការតម្រង់ ទិស ដល់ ក្រុមប្រឹក្សា ទើប កាន់ តំណែង ថ្មី ។
លោកស្រី មុំ ក្រសាល ប្រធាន គណៈកម្មការ អភិវឌ្ឍន៍ សមត្ថភាព របស់ សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី ខេត្ត ថ្លែង ថា ការបណ្តុះបណ្តាល លើ មេរៀន ទាំង ពីរ ធ្វើឡើង នៅ ក្រុមប្រឹក្សា រាជធានី ខេត្ត ទាំង ២៥ ក្នុង គោលបំណង លើកកម្ពស់ ការយល់ដឹង របស់ សមាជិក ក្រុមប្រឹក្សា ៣៩៣ រូប នៅ ទូទាំង ប្រទេស អំពី ទ្រឹស្តី និង ឆ្លុះបញ្ចាំង អំពី ការអនុវត្ត ជាក់ស្តែង ។
វគ្គ បណ្តុះបណ្តាល នេះ ត្រូវបាន រៀបចំឡើង នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម ការគាំទ្រ បច្ចេកទេស និង ថវិកា ពី សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី ខេត្ត សម្របសម្រួល ដោយ លោកស្រី ប្រាក់ ពុទ្ធី សមាជិក ក្រុមប្រឹក្សា ខេត្ត ត្បូង ស្វាយរៀង និង ជា គ្រូ ឧទ្ទេស ពី សមាគម ជាតិ ក្រុមប្រឹក្សា រាជធានី ខេត្ត និង លោក វ៉ាន់ ថេន គ្រូ ឧទ្ទេស ឯករាជ្យ ៕
ក្រុមការងារ ពិសេស លុបបំបាត់ ជម្ងឺ គ្រុនចាញ់ ខេត្ត ព្រះវិហារ ប្រជុំ ដោះស្រាយ រក វិធីសាស្ត្រ លុបបំបាត់ ជម្ងឺ គ្រុនចាញ់ ឲ្យ អស់ នៅ ឆ្នាំ ២០២៥
( ព្រះវិហារ ) ៖ ក្រុមការងារ ពិសេស លុបបំបាត់ ជម្ងឺ គ្រុនចាញ់ ខេត្ត ព្រះវិហារ នៅ រសៀល ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន បើក កិច្ចប្រជុំ ពិសេស មួយ ដើម្បី រក វិធីសាស្ត្រ ក្នុង ការលុបបំបាត់ ជម្ងឺ គ្រុនចាញ់ ឲ្យ អស់ ពី ខេត្ត ព្រះវិហារ ស្រប តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ក៏ ដូចជា ការប្តេជ្ញាចិត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
កិច្ចប្រជុំ ពិសេនេះ ស្ថិត ក្រោម វត្តមាន លោកស្រី ចឹក ហេង អភិបាល រង ខេត្ត ព្រះវិហារ តំណាង លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រមទាំង មាន ការចូលរួពី លោក វេជ្ជបណ្ឌិត គួង ឡូ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ និង លោក អភិបាល ក្រុង ស្រុក ទាំង៨ និង មន្ត្រី ពាក់ពន្ធ័ ជាច្រើន រូប ទៀត ។
លោកស្រី អភិបាល រង ខេត្ត បាន បន្ត ទៀត ថា « យើង គួរតែ ពង្រឹង ប្រពន្ធ័ សុខាភិបាល យើង ម្តង ទៀត មិន មែន មាន នយ័ថា ការងារ នេះ យើង មិន បាន ធ្វើ នោះ ទេ តែ យើង ត្រូវ ពង្រឹង ជាប្រចាំ នៅ សេវា សុខាភិបាល យើង គ្រប់ មូលដ្ឋាន ឲ្យ ទាក់ទង និង សុខាភិបាល និង អ្នកស្ម គ្រ័ចិត្ត គឺ យើង ត្រូវ ធ្វើ ការពង្រឹង ឡើងវិញ ដែរ ដើម្បី ព្យាបាល ជម្ងឺ គ្រុនចាញ់ របស់ បងប្អូន យើង ពេល មកដល់ មន្ទីពេទ្យ ឫម ណ្ឌុល សុខភាព » ។
ជាមួយគ្នា នេះ ផងដែរ លោកស្រី ចឹក ហេង ក៏ បាន សំណូមពរ ដល់ មន្ទីរ សុខាភិបាល ខេត្ត ត្រូវ យកចិត្តទុកដាក់ ផ្គត់ផ្គង់ ឱសថ សម្ភារ បរិក្ខា ទាក់ទង និង ជម្ងឺ គ្រុនចាញ់ នេះ កុំ ឲ្យ ដាច់ ។ មន្ទីរ សុខាភិបាល ត្រូវ ធ្វើ ការផ្សព្វផ្សាយ បន្ត ទាក់ទង និង ជម្ងឺ គ្រុនចាញ់ និង ជម្ងឺ គ្រុន ឈាម ធ្វើ យ៉ាងណា ឲ្យ ពួកគាត់ ត្រូវ សម្អាត បរិស្ថាន ជុំវិញ ផ្ទះ ឲ្យបាន ស្អាត ដូចជា សំបក កំប៉ុង សំបក កង់ ឡាន និង អ្វី ដែល ទាក់ទង និង សំបុក មុស ត្រូវ សំអាត អោយ បាន ស្អាត ។
ហើយ បើ មាន ជម្ងឺ គ្រុនចាញ់ ឫ គ្រុន ក្តៅ ត្រូវ នាំ កូន ចៅ គាត់ មក មណ្ឌុល សុខភាព កុំ ឲ្យ ព្យាបាល ពេទ្យ ឯកជន តាម ភូមិ ដែល គ្មាន វិជ្ជាជីវៈ ត្រឹមត្រូវ ដែល បើក គ្មាន ច្បាប់ ទម្លាប់ ដោយ គ្រាន់តែ ចេះ ថ្នាំ ចាក់ ដោត នោះ ឲ្យ សោះ ។
លោក វេជ្ជបណ្ឌិត គួង ឡូ បាន លើកឡើង ថា បញ្ហា ជម្ងឺ គ្រុនចាញ់ យើង ត្រូវ ធ្វើ ការចាប់អារម្មណ៍ ទាំងអស់ គ្នា ដើម្បី លុបបំបាត់ ឲ្យបាន តាម គោល នយោបាយ ថ្នាក់ ជាតិ ដែល បាន កំណត់ នៅ ឆ្នាំ ២០២៥ ។
ជាមួយគ្នា នេះ លោក គួង ឡូ ក៏ បាន សំដែង នូវ ការរីករាយ ផងដែរ ដែល ប្រទេស របស់ យើង បាន ប្តេជ្ញា លុបបំបាត់ ជម្ងឺ គ្រុនចាញ់ ឲ្យ អស់ នៅ ឆ្នាំ ២០២៥ លោក បន្ត ថា បើ ធៀប និង ប្រទេស ជិតខាង គឺ យើង ធ្វើ បាន លឿន ជាង គេ ដូចជា ប្រទេស ឡាវ ថៃ និង វៀតណាម គឺ គេ ប្តេជ្ញា លុបបំបាត់ ជម្ងឺ គ្រុនចាញ់ នៅ ឆ្នាំ ២០៣០ ឯណោះ ។
លោក គួង ឡូ បាន បន្ត ទៀត ថា ទាក់ទង និង បញ្ហា ជម្ងឺ គ្រុនចាញ់ និង វិធីសាស្ត្រ ដែល យើង ត្រូវ លុបបំបាត់ ជម្ងឺ គឺ មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ តែង ធ្វើ សកម្មភាព នៅ គ្រប់ ក្រុង ស្រុក ទាំងអស់ ទូទាំង ខេត្ត ដូចជា ការចែក មុង គ្រែ មុង អង្រឹង ជ្រលក់ ថ្នាំ ក៏ ដូចជា ការផ្សព្វផ្សាយ ពី ការសម្អាត បរិស្ថាន ជុំវិញ ផ្ទះ ក្នុង គោលបំណង បំបាត់ សំបុក មុស ខ្លា ផងដែរ ។
( បាត់ដំបង ) ៖ នៅ ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ មន្ត្រី កាំ កុងត្រូល ខេត្ត បាត់ដំបង និង គ្រប់ ស្ថាប័ន ពាក់ព័ន្ធ បាន យក សាច់ មាន់ ខូច គុណភាព ជាង ១.០៥៥ គីឡូក្រាម និង នំ ចំរុះ ខូច គុណភាព ៥០គីឡូក្រាម ដែល បង្កប់ ក្នុង រទេះ ដឹក បន្លែ - ផ្លែ ឈើ ទៅ ដុត ចោល ក្រោយ ការ ចុះ ត្រួតពិនិត្យ និង ស្ទាក់ ចាប់ បាន ទំនិញ នាំចូល ពី ប្រទេស ថៃ នៅ មាត់ ច្រក ប៉ុស្តិ៍ អូរ រំដួល ។
ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន៖ អតីត យុទ្ធជន ដែល ជា ជនពិការ នឹង ទទួលបាន ប័ណ្ណ សមធម៌ សម្រាប់ ការព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ រដ្ឋ ទាំងអស់ ដោយ ឥត គិត ថ្លៃ
ពិធី ចុះ សំណេះសំណាល សាកសួរ សុខទុក្ខ នេះ ដែរ ធ្វើឡើង នៅ ថ្ងៃទី ១៩ ខែតុលា ឆ្នាំ ២០១៨ នៅក្នុង ទី បញ្ជាការ ផ្នែក សឹក រង សន្ទុក នៃ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ស្ថិត នៅ ភូមិ បន្ទាយ យម រាជ ឃុំ ប្រាសាទ ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
ក្នុង ឱកាស នេះ លោក និង ក្រុមការងារ បាន ឧបត្ថម្ភ ជូន គាត់ នូវ អង្ករ ចំនួន ៧៥០ គីឡូក្រាម មី យើង ចំនួន ៣០កេះ មុង ជ្រលក់ ថ្នាំ ចំនួន ៣០ និង ថវិកា ចំនួន ៩០០.០០០ រៀល និង បាន ជួយ ដោះស្រាយ មធ្យោបាយ ធ្វើដំណើរ ជូន ពួកគាត់ ផងដែរ ៕
ទីបំផុត រដ្ឋាភិបាល អ៊ុយរ៉ាហ្គាយ ព្រម ឲ្យ សាងសង់ រូបសំណាក គ្រូបង្វឹក បាល់ទាត់ ដ៏ ឆ្នើម មួយ រូប ដែល បាន កសាង ស្នាដៃ ធំ ៗ ជាច្រើន ជូន ជាតិ !
ព័ត៌មាន លម្អិត សូម អាន នៅក្នុង សេចក្ដីប្រកាស ព័ត៌មាន របស់ រដ្ឋសភា ខាងក្រោម នេះ៖
ចាប់ មេក្លោង និង បក្ខពួក សរុប ៥នាក់ និង ដកហូត ថ្នាំ ញៀន ជាង ២គីឡូក្រាម នៅ ខេត្ត បន្ទាយមានជ័យ
( បន្ទាយមានជ័យ )៖ កម្លាំង នគរបាល ខេត្ត បន្ទាយមានជ័យ បាន បង្ហាញ មុខ ជនសង្ស័យ មេខ្លោង និង បក្ខពួក ជួញដូរ គ្រឿងញៀន សរុប ៥នាក់ និង គ្រឿងញៀន ជាង ២គីឡូក្រាម បន្ទាប់ពី សមត្ថកិច្ច បាន បើក ប្រតិបត្តិការ បង្ក្រាប ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ទោ អាត់ ខែម ស្នងការ នគរបាល ខេត្ត បន្ទាយមានជ័យ នៅក្នុង ភូមិសាស្រ្ត ក្រុង សិរី សោភ័ណ និង បន្ត ឈាន ទៅ បង្រ្កាប ផ្ទះ ជួល ជនសង្ស័យ ដល់ ទឹកដី ក្រុង សៀមរាប ដោយ រកឃើញ គ្រឿងញៀន លាក់ ទុក ក្នុង បន្ទប់ នៅ ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
លោក ឧត្តមសេនីយ៍ ត្រី ចាប សុប្ញទ្ធិ ស្នងការ រង ទទួល ការងារ ប្រឆាំង បទល្មើស បាន ប្រាប់ ឱ្យដឹង ថា កម្លាំង នគរបាល បង្រ្កាប ជនសង្ស័យ គ្រឿងញៀន ទាំង ៥នាក់ ជា បក្ខពួក និង ជា មេខ្លោង គ្រឿងញៀន ធំ បាន សម្រេច នៅ ពេល នេះ ក្រោយពី កម្លាំង នគរបាល បាន ស្រាវជ្រាវ ស៊ើបអង្កេត រយៈពេល ១ ខែ មក ហើយ ប្រើប្រាស់ វិធានការ សម្ងាត់ តាមរយៈ មុខ សញ្ញា ជនសង្ស័យ គ្រឿងញៀន ដែល បាន បង្រ្កាប កន្លងមក នៅក្នុង ខេត្ត បន្ទាយមានជ័យ ។
លោក ស្នងការ រង បាន ប្រាប់ ឱ្យដឹង ទៀត ថា ជនសង្ស័យ គ្រឿងញៀង ទាំងនេះ ជា មុខសញ្ញា ជួញដូរ លក់ ចែកចាយ គ្រឿងញៀន ចំនួន ៣ ខេត្ត គឺ ខេត្ត បន្ទាយមានជ័យ សៀមរាប និង ខេត្ត បាត់ដំបង ។ ការបង្រ្កាប នោះ ដែរ សមត្ថកិច្ច ដកហូត បាន គ្រឿងញៀន មេតំហ្វេតាមីន wy ៨. ៧៦៤ គ្រាប់ ស្មើ ទម្ងន់ ៧៩៩. ៩៤ ក្រាម . ថ្នាំ ញៀន តំហ្វេតាមីន ទឹកកក ទម្ងន់ ១. ៩៩៥. ០១ក្រាម . ថ្នាំ ញៀន កេតាមីន ៨. ៥១ ក្រាម ថ្នាំ គ្រាប់ អ៊ិចស្រា្តស៊ី ទម្ងន់ ២. ៩៦ក្រាម ជញ្ជីង ថ្លឹង គ្រឿងញៀន ៤ អាវុធ ខ្លី ៤ដើម ក្នុង នោះ អាវុធ ខ្យល់១ ដើម រថយន្ត ចំនួន ២គ្រឿង ។
លោក ស្នងការ ឲ្យដឹង ទៀត ថា ករណី បង្រ្កាប គ្រឿងញៀន ខាងលើ កម្លាំង នគរបាល បាន បន្ត ស្រាវជ្រាវ ដើម្បី តាម ស្វែងរក ចាប់ខ្លួន ជនសង្ស័យ ពាក់ព័ន្ធ មួយ ចំនួន ទៀត ។
លោក មាស ច័ន្ទ ពិសិដ្ឋ បាន ប្រាប់ ឱ្យដឹង ថា អយ្យការ អម សាលាដំបូង ខេត្ត បន្ទាយមានជ័យ បាន ប្តេជ្ញា ខ្ពស់ ជាមួយនឹង សមត្ថកិច្ច ពាក់ ដើម្បី បង្រ្កាប គ្រឿងញៀ ឱ្យ មាន ប្រសិទ្ធភាព កាត់បន្ថយ និង លប់ បំបាត់ គ្រឿងញៀន ក្នុង ទឹកដី ខេត្ត បន្ទាយមានជ័យ ។
លោក បាន បញ្ជាក់ ឱ្យដឹង ទៀត ថា គ្រឿងញៀន មាន ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ សង្គម ខ្មែរ ជាពិសេស អ្នកប្រើប្រាស់ គ្រឿងញៀន អាច ទៅ ធ្វើ សកម្មភាព ប្រព្រឹត្ត បទល្មើស លួច ឆក់ ប្លន់ អំពើហឹង្សា បង្កឱ្យ ប៉ះពាល់ សន្តិសុខ សង្គម ។
ជនសង្ស័យ គ្រឿងញៀន និង វត្ថុតាង នៅ រសៀល ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ សមត្ថកិច្ច បាន កសាង សំណុំរឿង ចាប់ បញ្ជូន ទៅកាន់ តុលាការ ដើម្បី ចាត់ការ តាម ផ្លូវ ច្បាប់ ៕
ជនសង្ស័យ ២នាក់ ឆក់ កាបូប ជនជាតិ ចិន នៅ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន ត្រូវ កម្លាំង នគរបាល តាម បង្ក្រាប បាន
( ភ្នំពេញ ) ៖ ជនសង្ស័យ ២នាក់ ម្នាក់ ជា សិស្ស វិទ្យាល័យ ផ្សារ ដើម ថ្កូវ និង ម្នាក់ ជា ជាង ទង ដែល បាន ធ្វើ សកម្មភាព ឆក់ កាបូប ជនជាតិ ចិន នៅ ផ្លូវ លេខ ២៩៤ ភូមិ ៤ សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ត្រូវ កម្លាំង នគរបាល ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ សហការ ជាមួយ កម្លាំង នគរបាល ខណ្ឌ ចំការមន តាម បង្ក្រាប បាន ។
លោក វរសេនីយ៍ ឯក ជា វ វិបុល នាយ ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ បាន ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ថា ប្រតិបត្តិការ បង្ក្រាប នៅ ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ធ្វើឡើង ក្រោម ការចង្អុលបង្ហាញ ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ . ប្រធាន នាយកដ្ឋាន កណ្ដាល នគរបាល យុត្តិធម៌ និង ដឹកនាំ បញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ដោយ សហការ ជាមួយ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
បើ តាម ចម្លើយ សារភាព របស់ ជនសង្ស័យ ដែល បង្ក្រាប បាន នៅពេល ឃើញ ជនជាតិ ចិន ២នាក់ ដើរ នៅ តាម ផ្លូវ ដោយ មាន យូរ កាបូប ឃើញ ដូច្នេះ ពួក ខ្លួន បាន ជិះ ម៉ូតូ ទៅ អែប ហើយ ធ្វើ សកម្មភាព ឆក់ យក កាបូប យួរ នោះ ពី ជនរងគ្រោះ ហើយ ជិះ ម៉ូតូ គេចខ្លួន ទៅ វត្ត ទួល ទំពូង ដើម្បី ពិនិត្យមើល សម្ភារ ដែល ឆក់ បាន ។
បច្ចុប្បន្ន ជនសង្ស័យ កម្លាំង នគរបាល ជំនាញ កំពុង កសាង សំណុំរឿង ដើម្បី បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការបន្ដ តាម ច្បាប់ ៕
ការសន្យា បង្កើត ការងារ នៅក្នុង សហរដ្ឋ អាមេរិក របស់ លោក Jack Ma ធ្វើឡើង នៅក្នុង ជំនួប ជាមួយ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ កាលពី ជាង ពីរ ឆ្នាំ មុន ។ ប៉ុន្តែ ដោយសារ សង្រ្គាម ពាណិជ្ជកម្ម បច្ចុប្បន្ន កំពូល មហាសេដ្ឋី ចិន រូប នេះ បាន អះអាង ថា ក្រុមហ៊ុន របស់ លោក មិន អាច បំពេញ តាម ការសន្យា នេះ បាន ទៀត ឡើយ ។
លោក Jack Ma បាន បញ្ជាក់ នៅក្នុង បទសម្ភាសន៍ ជាមួយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ ដូច្នេះ ថា « ការប្ដេជ្ញាចិត្ត នេះ គឺ ឈរ លើ មូលដ្ឋាន មិត្តភាព រវាង សហរដ្ឋ អាមេរិក និង ចិន ព្រមទាំង កិច្ចសហប្រតិបត្តិការ ក៏ ដូចជា ពាណិជ្ជកម្ម ទ្វេ ភាគី រវាង ប្រទេស ទាំង ពីរ ... ប៉ុន្តែ ស្ថានភាព បច្ចុប្បន្ន បាន បំផ្លាញ ការសន្យា នេះ ហើយ វា ក៏ គ្មាន ផ្លូវ អាច បំពេញ សន្យា នេះ បាន ទៀត ដែរ » ។
គួរ បញ្ជាក់ ថា បើ ទោះជា មាន កិច្ចពិភាក្សា ជា បន្តបន្ទាប់ ក៏ដោយ ប៉ុន្តែ សង្រ្គាម ពាណិជ្ជកម្ម រវាង សហរដ្ឋ អាមេរិក និង ចិន នៅតែ មិន ទាន់ អាច ដោះស្រាយ បាន ឡើយ ។ មិន តែ ប៉ុណ្ណោះ ជម្លោះ បច្ចុប្បន្ន កាន់តែ មាន សភាព ធ្ងន់ ឡើង ៗ បន្ទាប់ពី សហរដ្ឋ អាមេរិក ប្រកាស ដំឡើង ពន្ធ លើ ផលិតផល ចិន មាន តម្លៃ ២០០ ពាន់ លាន ដុល្លារ ខណៈ ចិន សងសឹក វិញ ជាមួយ ការដំឡើង ពន្ធ លើ ផលិតផល អាមេរិក មាន តម្លៃ ៦០ ពាន់ លាន ដុល្លារ ។
ប៉ុន្តែ ការដំឡើង ពន្ធ នេះ មិន ទាន់ បញ្ចប់ ត្រឹម នេះ ឡើយ ពោល គឺ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ព្រមាន ថា នឹង ដំឡើង ពន្ធ ឱ្យ ដល់ ២៦៧ ពាន់ លាន ដុល្លារ បន្ថែម ទៀត បើសិនជា ទីក្រុង ប៉េកាំង ហ៊ាន ចាត់ វិធានការសងសឹក នឹង សហរដ្ឋ អាមេរិក វិញ ៕ ព្រឹក នេះ រដ្ឋមន្ត្រី ក្រសួង អប់រំ ចុះ ជួប គ្រូ ៗ នៅ សាលា ព្រះស៉ី សុត្ថិ ដើម្បី ដោះស្រាយ បាតុភាព មួយចំនួន និង ដើម្បីឲ្យ គ្រូ ៗ បោះឆ្នោត ថា តើ ត្រូវ ដូរ នាយក សាលា ដែរ ទេ ?
( ភ្នំពេញ ) ៖ រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា លោក ហង់ ជួនណារ៉ុន នៅ ព្រឹក ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន មក ជួប គ្រូ ៗ នៅ វិទ្យាល័យ ព្រះស៉ី សុវត្ថិ ដើម្បី ដោះស្រាយ បញ្ហា មួយចំនួន ពិសេស បាតុភាព ប៉ុន្មាន ថ្ងៃ នេះ ដែល មាន ការតវ៉ា មិន ចង់ឲ្យ មាន ការផ្លាស់ប្តូរ នាយក សាលា ក៏ ដូចជា បញ្ហា ដែល មាន ពាក្យ អកុសល ថា សាលា នេះ នឹង ត្រូវ ដូរ ទៅជា សាលា ឯកជន វិញ ។
បើ តាម លោក ហង់ ជួនណារ៉ុន នៅក្នុង កិច្ចប្រជុំ បើក ទ្វារ ដំបូង បាន អនុញ្ញាតឲ្យ អ្នកសារព័ត៌មាន ស្តាប់ បាន បន្តិច នោះ បាន បង្ហើយ ឲ្យដឹង ថា នៅ ថ្ងៃ នេះ នឹង មាន ការបោះឆ្នោត ជា សម្ងាត់ ដើម្បីឲ្យ មាន ការសម្រេច ថា តើ ចង់ រក្សាទុក នាយក នៃ សាលា នេះ ឬ ត្រូវ ដូរ ចេញ ? ។ លោក បន្ត ថា ការដោះដូរ នឹង សម្រេច ទៅ តាម សម្លេង ឆ្នោត ភាគ ច្រើន របស់ គ្រូ ដែល បង្រៀង នៅ សាលា ព្រះស៉ី សុវត្ថិ ។
សូម បញ្ជាក់ ថា ក្នុង រយៈពេល ពីរ ថ្ងៃ នេះ គ្រូ ៗ បង្រៀន នៅ សាលា ព្រះស៊ីសុវត្ថិ និង សិស្ស មួយចំនួន បាន នាំគ្នា ចេញមក លើក បដាត វ៉ា ជា បន្តបន្ទាប់ ដោយ មិន ចង់ឲ្យ មាន កម្មវិធី « សាលា ជំនាន់ ថ្មី NGS» នៅក្នុង សាលា ព្រះស៊ីសុវត្ថិ ក្រោម ហេតុផល ថា កម្មវិធី នេះ នាំឲ្យ មាន ការបែងចែក រវាង គ្រូ និង គ្រូ សិស្ស និង សិស្ស ។
