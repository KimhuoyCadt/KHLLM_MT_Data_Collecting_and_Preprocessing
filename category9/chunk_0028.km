( កំពង់ចាម ) ៖ កម្លាំង សមត្ថកិច្ច ចម្រុះ ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន សហការ គ្នា បន្ដ ចុះបង្ក្រាប បទល្មើស នេសាទ ខុស ច្បាប់ ២ករណី ដោយ ដកហូត បាន វត្ថុតាង ពាក់ព័ន្ធ មួយ ចំនួន និង ចាក់ លែង កូន ត្រី ចម្រុះ ចូល ទឹក វិញ ។
ស្នងការ នគរបាល ខេត្ត កំពង់ចាម លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ឲ្យដឹង ថា ក្រោយពី ទទួលបាន ព័ត៌មាន អំពី បទល្មើស នេសាទ ខុស ច្បាប់ លោក ចាត់ បញ្ជា អធិការ នគរបាល ស្រុក កំពង់សៀម សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល វិហារ ធំ . ស្រក ប្រជាការពារ និង ខណ្ឌ រដ្ឋបាល ជលផល ខេត្ត កំពង់ចាម ដឹកនាំ ដោយ លោក យី វណ្ណៈ អភិបាល រង ស្រុក កំពង់សៀម ដោយ មាន ការចង្អុលបង្ហាញ ពី លោក ប៊ិន ឡាដា អភិបាល ស្រុក កំពង់សៀម បាន ចុះបង្រ្កាប បទល្មើស នេសាទ ខុស ច្បាប់ តែម្ដង ។
បើ តាម លោក ឧត្ដមសេនីយ៍ ស្នងការ ករណី ទី១ នៅ ចំណុច ភូមិ បឹង ក្តី ឃុំ វិហារ ធំ ស្រុក កំពង់សៀម ជា លទ្ធផល លូស្បៃ មុង ចំនួន ៣មាត់ . របាំង ព្រួល ប្រវែង ១៥០ ម៉ែត្រ . បង្គោល ឬ ស្សី ចំនួន ៣០ដើម ។ ចំពោះ សម្ភារ វត្ថុតាង បាន យកមក រក្សាទុក នៅ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល វិហារ ធំ បណ្តោះអាសន្ន ដើម្បី រង់ចាំ បទបញ្ជា ចាត់ការ បន្ត ។
ករណី ទី២ នៅ ចំណុច មុខ វត្ត ព្រះកែវ ឧទ្យាល្ពា ក និង ក្បាល ទំនប់ ត្រួយ ចេក ស្ថិត ក្នុង ឃុំ ស្រក ស្រុក កំពង់សៀម ជា លទ្ធផល លូស្បៃ មុង ចំនួន ៥មាត់ . របាំង ព្រួល ប្រវែង ២៥០ ម៉ែត្រ និង ចាក់ លែង កូន ត្រី ចម្រុះ ចូល បឹង ធម្មជាតិ ចំនួន ៣គីឡូក្រាម ។ ចំពោះ សម្ភារ វត្ថុតាង បាន ដុត បំផ្លាញ ចោល នៅនឹង កន្លែង ដោយ មាន ការឯកភាព ពី លោក ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត កំពង់ចាម ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ ថ្លែង ថា ការលា លែង ចេញ ពី នាយ រង សេនាធិការ ចម្រុះ ដើម្បី ទទួល តួនាទី ឲ្យ ដាច់ នៅក្រោម បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក គឺ ធ្វើឡើង តាម ច្បាប់ ដែល កំណត់ មិន មាន បញ្ហា អ្វី នៅក្នុង ជួរ កងទ័ព ទេ ( ចុច អាន )
២៖ ប្រធានាធិបតី ចិន និង ភរិយា ចូល គាល់ ព្រះមហាក្សត្រ ខ្មែរ និង សម្តេច ម៉ែ នៅ ទីក្រុង ប៉េកាំង ( ចុច អាន )
៤៖ IMF កោតសរសើរ ដល់ ការខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការបន្ដ រក្សា និង ជំរុញ កំណើន សេដ្ឋកិច្ច ប្រកបដោយ ចីរភាព ( ចុច អាន )
៥៖ អាល្លឺម៉ង់ ប្រកាស ត្រៀមខ្លួន រួច ជាស្រេច សម្រាប់ ការគាំទ្រ កម្ពុជា ជំរុញ ការអភិវឌ្ឍ ដែល ឈរ លើ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ដែល មាន ស្រាប់ ( ចុច អាន )
៦៖ រដ្ឋសភា ចេញ សេចក្ដីប្រកាស ព័ត៌មាន ស្ដីពី លទ្ធផល សម័យ ប្រជុំ រដ្ឋសភា លើក ទី១ នីតិកាល ទី៦ ក្នុង ការបោះឆ្នោត ជ្រើសតាំង បំពេញ បន្ថែម សមាជិក គណៈកម្មការ ទាំង១០ ( ចុច អាន )
៨៖ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ជំរុញ មន្ត្រី ពង្រឹង ការអនុវត្ត យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ( ចុច អាន )
៩៖ គ្រាន់តែ បង្កើត រាជ រដ្ឋាភិបាល ថ្មី ភ្លាម រឿង ធំ ៗ បាន ចូលមក ល្បង សមត្ថភាព រដ្ឋមន្ត្រី ក្រសួង អប់រំ ជា បន្តបន្ទាប់ ( ចុច អាន )
១១៖ ក្រសួង ដែនដី កំណត់ ថា រាល់ គម្រោង សាងសង់ អគារ រោងចក្រ សហគ្រាស និង គ្រឹះស្ថាន ការងារ ត្រូវតែ មាន កន្លែង សម្រាប់ កម្មករ និយោជិត ពិសា អាហារ ថ្ងៃត្រង់ ( ចុច អាន )
២៖ សហរដ្ឋ អាមេរិក អះអាង ថា « ត្រៀមខ្លួន រួច ជាស្រេច ដើម្បី ចាប់ផ្តើម កិច្ចចរចា ភ្លាម ៗ ក្នុង ការរំសាយ នុយក្លេអ៊ែរ កូរ៉េ ខាងជើង តាម គោលដៅ ទាំងស្រុង នៅ ឆ្នាំ ២០២១ » ( ចុច អាន )
៧៖ អគ្គ រដ្ឋទូត ចិន៖ គ្មាន នរណា អាច បំផ្លាញ ការប្តេជ្ញាចិត្ត របស់ ចិន ក្នុង ការរក្សា សន្តិភាព និង ស្ថិរភាព នៅ សមុទ្រ ចិន ខាងត្បូង បាន ឡើយ ! ( ចុច អាន )
៨៖ សហគ្រាស ជាង ៥០០ តាំង បង្ហាញ ផលិតផល របស់ ខ្លួន ក្នុង ពិព័រណ៍ បណ្តាញ ឧបករណ៍ ដែល អាច ភ្ជាប់ អ៊ីនធើណេត បាន នៅ ប្រទេស ចិន ( ចុច អាន )
៩៖ ប្រទេស ចិន នឹង បើក ផ្លូវ ហោះហើរ តាម អាកាស បន្ថែម ដើម្បី ពង្រីក ទំនាក់ទំនង ក្នុង ពិភពលោក ( ចុច អាន )
១០៖ មេបញ្ជាការ ទ័ព អាកាស អ៊ីស្រាអែល ត្រៀមខ្លួន ឡើង ទៅ បកស្រាយ ការពិត នៅ ចំពោះមុខ រុស្ស៊ី ! ( ចុច អាន )
១៣៖ អតីត អ្នកសារព័ត៌មាន មីយ៉ាន់ម៉ា ម្នាក់ ជាប់ ពន្ធនាគារ ០៧ ឆ្នាំ ដោយសារ រិះគន់ លោកស្រី អោង សាន ស៊ូជី ( ចុច អាន )
សរុប ខ្លឹមសារ សំខាន់ ៗ នៃ ជំនួប កំពូល រវាង មេដឹកនាំ កូរ៉េ ទាំង ពីរ នៅ ទីក្រុង ព្យុងយ៉ាង ដែល បញ្ចប់ ទៅក្នុង រយៈពេល ០៣ ថ្ងៃ !
( សេអ៊ូល ) ៖ អាច និយាយ បាន ថា វា ជា ព្រឹត្តិការណ៍ ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ បំផុត រវាង ប្រទេស កូរ៉េ ទាំង ពីរ ខណៈ ដែល ភាព វិជ្ជមាន ដែល ប្រមូល បាន នៅក្នុង រយៈពេល បី ថ្ងៃ កន្លងទៅ នេះ អាច ឲ្យ កូរ៉េ ទាំង ពីរ បន្ត ម ពូន ផ្តុំ ទំនាក់ទំនង ល្អ ឡើងវិញ នៅពេល អនាគត ខាងមុខ ទៀត ស្រប ពេល ដែល ទំនាក់ទំនង រវាង កូរ៉េ ខាងជើង និង សហរដ្ឋ អាមេរិក ក៏ អាចនឹង កាន់តែ ប្រសើរ ឡើងវិញ ផងដែរ ។ នេះ បើ តាម ការបូកសរុប ព្រឹត្តិការណ៍ សំខាន់ ស្តីពី បញ្ហា អន្តរ កូរ៉េ នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី២០ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
ជំនួប កំពូល រវាង មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន និង ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន បាន ចាប់ផ្តើម ឡើង នៅ ទីក្រុង ព្យុងយ៉ាង ចាប់តាំងពី រសៀល ថ្ងៃអង្គារ ទី១៨ ខែកញ្ញា មក ម្ល៉េះ ហើយ ត្រូវ បញ្ចប់ ទៅ វិញ ក្រោយពី លោក មូន ជែ អ៊ីន និង ភរិយា ជិះ យន្តហោះ ត្រឡប់ ទៅ កូរ៉េ ខាងត្បូង វិញ នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ នេះ តែម្តង ក្រោយពី បញ្ចប់ ទស្សនកិច្ច រយៈពេល បី ថ្ងៃ គត់ ។
អ្វី ដែល គួរឲ្យ ភ្ញាក់ផ្អើល បំផុត នោះ គឺ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន បាន ចេញមក ទទួល ដំណើរ ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន ដោយ ផ្ទាល់ នៅឯ អាកាសយានដ្ឋាន អន្តរជាតិ ទីក្រុង ព្យុងយ៉ាង ដែល នេះ ពិតជា រឿង ដែល កម្រ មាន បំផុត សម្រាប់ ពិធី ការទទួល មេដឹកនាំ លើសកលោក ។
ទីបំផុត ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន និង មេដឹកនាំ កំពូល ផុត លេខ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន បាន ចាប់ផ្ដើម កិច្ចចរចា ជុំ ទី ១ ហើយ នៅ ថ្ងៃអង្គារ នេះ ក្នុង កិច្ចប្រជុំ កំពូល អន្តរ កូរ៉េ លើក ទី ៣ ដែល មាន គោលបំណង សម្របសម្រួល ត្រួសត្រាយ ផ្លូវ ឱ្យ មាន ការចាប់ផ្ដើម ឡើងវិញ នូវ កិច្ចពិភាក្សា ស្ដីពី ការលុបបំបាត់ អាវុធ នុយក្លេអ៊ែរ នៅលើ ឧបទ្វីប កូរ៉េ រវាង លោក គីម និង លោក ដូណាល់ ត្រាំ ។
នៅ ថ្ងៃទី ១ នៃ កិច្ចពិភាក្សា គ្នា ដែល ចាប់ផ្តើ នៅពេល រសៀល ថ្ងៃអង្គារ នោះ លោក គីម ជុង អ៊ុន បាន ថ្លែង ទៅកាន់ ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន យ៉ាង ដូច្នេះ ថា « លោក ប្រធានាធិបតី មូន បាន ជួយ យើង ជាច្រើន ក្នុង ការស្វែងរក កិច្ចចរចា ជា ប្រវត្តិសាស្ត្រ រវាង សហរដ្ឋ អាមេរិក និង កូរ៉េ ខាងជើង .. . ហើយ ដោយសារតែ ការចូលរួម នេះ វា បាន ធ្វើឱ្យ តំបន់ ទាំងមូល មាន ស្ថេរភាព ខណៈ ភាពរីកចំរើន និង លទ្ធផល គួរ ជា ទី គាប់ ចិត្ត នឹង លេច រូបរាង ឡើង » ។
កិច្ចពិភាក្សា ថ្ងៃទី ២ គឺ ថ្ងៃពុធ ទី១៩ ខែកញ្ញា បាន ចាប់ផ្តើម ជា ផ្លូវការ រវាង លោក មូន និង លោក គីម ក្នុង ទីក្រុង ព្យុងយ៉ាង ដដែល ដោយ មិន បង្អង់ យូរ ប្រមុខ ដឹកនាំ វ័យ ក្មេង កូរ៉េ ខាងជើង បាន អះអាង ថា លោក នឹង បំពេញ ដំណើរទស្សនកិច្ច ទៅកាន់ ទីក្រុង សេអ៊ូល ក្នុង អនាគត ដ៏ ខ្លី ខាងមុខ នេះ ខណៈ លោក និង ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន ក៏ បាន ឯកភាព គ្នា ដែរ ថា នឹង ប្រឹងប្រែង ធ្វើឱ្យ ឧបទ្វីប កូរ៉េ គ្មាន អាវុធ នុយក្លេអ៊ែរ និង គ្មាន ការគំរាមកំហែង ។
ជា ចុងក្រោយ ទីក្រុង សេអ៊ូល និង ព្យុងយ៉ាង ក៏ បាន ព្រមព្រៀង បញ្ជូន ក្រុម អត្តពលិក រួមគ្នា ឲ្យ ទៅ ប្រកួត ក្នុង កីឡា អូឡាំពិក ឆ្នាំ ២០២០ និង ដាក់ សំណើ រួម ដើម្បី សុំ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កីឡា អន្តរជាតិ នេះ នៅ ឆ្នាំ ២០៣២ ផងដែរ ។ នេះ គឺ ភាពវិជ្ជមាន ថ្មី ៗ បន្ថែម ទៀត សម្រាប់ ការបន្ធូរបន្ថយ ភាពតានតឹង និង បង្កើន ទំនាក់ទំនង ប្រសើរ ឡើងវិញ រវាង បងប្អូន កូរ៉េ ទាំង ពីរ ដែល សហគមន៍ អន្តរជាតិ ចង់ ឃើញ ជា យូរ ណាស់ មកហើយ ។
ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន បាន ធ្វើដំណើរ ត្រឡប់ មកដល់ កូរ៉េ ខាងត្បូង វិញ នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ នេះ បន្ទាប់ពី បាន ចូលរួម ក្នុង ជំនួប កំពូល ជាមួយ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន ក្នុង ទីក្រុង ព្យុងយ៉ាង តាំងតែពី ថ្ងៃអង្គារ មក ។
គួរ ជម្រាប ថា លោក មូន ជែ អ៊ីន បាន ក្លាយជា ប្រធានាធិបតី កូរ៉េ ខាងត្បូង ទី ៣ ដែល បាន យក ជើង ជាន់ ទីក្រុង ព្យុងយ៉ាង ។ មេដឹកនាំ កូរ៉េ ទាំង ពីរ បាន ជួបគ្នា ពីរ លើក រួច មកហើយ គឺ កាលពី ថ្ងៃទី ២៧ ខែមេសា និង ថ្ងៃទី ២៦ ខែឧសភា ហើយ មិន តែ ប៉ុណ្ណោះ លោក គីម ជុង អ៊ុន ក៏ បាន សន្យា ផងដែរ ថា នឹង បំពេញ ដំណើរទស្សនកិច្ច ទៅកាន់ ទីក្រុង សេអ៊ូល ក្នុង ពេល អនាគត ដ៏ ខ្លី ខាងមុខ ។
* ពាក្យបណ្តាំ៖ នៅក្នុង ការត្រឡប់មក កូរ៉េ ខាងត្បូង វិញ លោក មូន ជែ អ៊ីន មិន ភ្លេច នៅក្នុង ការរំលឹក អំពី ពាក្យ ប្តេជ្ញា របស់ លោក គីម ជុង អ៊ុន ក្នុង ការលុបបំបាត់ នុយក្លេអ៊ែរ នៅ តំបន់ ឧបទ្វីប កូរ៉េ ព្រមទាំង ក្តី រំពឹង ខ្ពស់ របស់ មេដឹកនាំ កូរ៉េ ខាងជើង ដើម្បី បើក កិច្ច ជំនួប កំពូល លើក ទី ពីរ ជាមួយ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ៕ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែកញ្ញា លទ្ធផល៖ បង្ក្រាប ៣៣ ករណី ឃាត់ខ្លួន ៥៨ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
សាកលវិទ្យាល័យ ន័រតុន ប្រគល់ លិខិត សរសើរ ដល់ និស្សិត ឆ្នើម ប្រធាន ថ្នាក់ និង អនុប្រធាន ថ្នាក់ ក្នុង ន័យ លើកទឹកចិត្ត ដល់ និស្សិត ដែល បាន ខិតខំ ប្រឹងប្រែង
ពិធី « ប្រគល់ លិខិត សរសើរ ដល់ និស្សិត ឆ្នើម ប្រធាន ថ្នាក់ និង អនុប្រធាន ថ្នាក់ » នេះ ធ្វើឡើង នៅ សកលវិទ្យាល័យ ន័រ (NORTON University) ក្រោម វត្តមាន លោក សាស្ត្រាចារ្យ ចាន់ សុខ ឃាង សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ន័រតុន លោក បណ្ឌិត លឹម សុខ តៃ ព្រឹទ្ធ បុរស មហាវិទ្យាល័យ វិទ្យាសាស្ត្រ និង សាស្ត្រាចារ្យ លោកគ្រូ និង អ្នកគ្រូ រួម នឹង ថ្នាក់ដឹកនាំ សកលវិទ្យាល័យ ន័រតុន ជាច្រើន នាក់ ទៀត ។
នា ឱកាស ដ៏ ពិសេស នោះ លោក ចាន់ សុខ ឃាង សាកលវិទ្យាធិការ នៃ សកលវិទ្យាល័យ ន័រតុន ក៏ បាន សាទ រ យ៉ាង ខ្លាំង ផងដែរ ចំពោះ និស្សិត ទាំងអស់ ដែល បាន ខិតប្រឹងប្រែង រៀនសូត្រ រហូត ក្លាយទៅជា សិស្ស ឆ្នើម ប្រចាំ សកលវិទ្យាល័យ រួម នឹង ប្រធាន ថ្នាក់ និង អនុប្រធាន ថ្នាក់ ដែល បាន ខិតខំ ធ្វើ ការងារ ប្រចាំ ថ្នាក់ បាន ល្អ ពេញ មួយ ឆ្នាំ ។
ក្រៅពី នោះ លោក ចាន់ សុខ ឃាង ក៏ បាន ធ្វើ បទបង្ហាញ អំពី សារៈសំខាន់ នៃ ការសិក្សា ក៏ ដូចជា បទពិសោធន៍ ផ្សេង ជូន ដល់ និស្សិត ប្រមាណ ជាជាង ៤០០ នាក់ ដែល បាន ចូលរួម ក្នុង កម្មវិធី « ប្រគល់ លិខិត សរសើរ ដល់ និស្សិត ឆ្នើម ប្រធាន ថ្នាក់ និង អនុប្រធាន ថ្នាក់ » ឲ្យ យល់ដឹង កាន់តែ ច្បាស់ ពី អត្ថប្រយោជន៍ នៃ ការខិតខំ ប្រឹងប្រែង ក្នុង ជីវិត ជា និស្សិត ។
សាកលវិទ្យាធិការ រូប នេះ ក៏ បាន ថ្លែង កោតសរសើរ ដល់ ឪពុក ម្តាយ របស់ និស្សិត ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង បញ្ជូន កូន ចៅ មក សិក្សា ដើម្បី ក្រេប ចំណេះដឹង ពី លោកគ្រូ អ្នកគ្រូ ក្នុង ន័យ បំពេញ តម្រូវការ នៅពេល អនាគត ។
សូម ជម្រាប ជូន ថា បន្ទាប់ពី បញ្ចប់ ការប្រគល់ សញ្ញាបត្រ ថ្នាក់ ឆ្នាំ សិក្សា មូលដ្ឋាន ជូន និស្សិត ប្រមាណ ជា ៦០០ នាក់ កាលពី ម្សិលមិញ នោះ សកលវិទ្យាល័យ ន័រតុន នា ថ្ងៃ នេះ ក៏ បាន បង្កើតកម្ម ពិធី ប្រគល់ លិខិត សរសើរ ដល់ និស្សិត ឆ្នើម ប្រធាន ថ្នាក់ និង អនុប្រធាន ថ្នាក់ ដែល នេះ សបង្ហាញ ពី ការយកចិត្តទុកដាក់ និង កោតសរសើរ ជូន ចំពោះ និស្សិត ផងដែរ ។
ជាមួយគ្នា នោះ ដែរ លោក បណ្ឌិត លឹម សុខ តៃ ក៏ បង្ហាញ ក្តី សាទរ ចំពោះ និស្សិត ឆ្នើម ទាំងអស់ ដែល បាន សម្រេច បំណង ខ្លួន ការក្លាយ ខ្លួន ជា និស្សិត ពូកែ ប្រចាំ សកលវិទ្យាល័យ ហើយ ការលោក ក៏ បាន លើកទឹកចិត្ត ដល់ និស្សិត ទាំងអស់ នោះ ឲ្យ មាន ការខិតខំ បន្ថែម ទៀត ចំពោះ ការយកចិត្តទុកដាក់ ក្នុង ការសិក្សា មួយ នេះ ។
ព្រឹទ្ធ បុរស មហាវិទ្យាល័យ វិទ្យាសាស្ត្រ ប្រចាំ សាកលវិទ្យាល័យ ន័រតុន រូប នេះ ក៏ បាន ក្រើន រម្លឹក ដល់ និស្សិត ទាំងអស់ ថា ប្រសិនបើ ក្លាយ ខ្លួន ជា និស្សិត ឆ្នើម សាកលវិទ្យា ហើយ គប្បី ត្រូវ ក្លាយ ខ្លួន ជា និស្សិត ដែល មាន សីលធម៌ សុជីវធម៌ ល្អ ប្រចាំ សាលា ផងដែរ ទើប មាន ការកោតសរសើរ កាន់តែ ខ្លាំង ពី បណ្តា លោកគ្រូ អ្នកគ្រូ រួម នឹង មិត្ត រួម ថ្នាក់ ក៏ ដូចជា រួម សាលា ផងដែរ ។
សូម បញ្ចាក់ ថា ពិធី « ប្រគល់ លិខិត សរសើរ ដល់ និស្សិត ឆ្នើម ប្រធាន ថ្នាក់ និង អនុប្រធាន ថ្នាក់ » នេះ នឹង ធ្វើឡើង ក្នុង រយៈពេល មួយ ឆ្នាំ ម្តង ក្នុង គោលបំណង លើកទឹកចិត្ត ជូន ដល់ និស្សិត ទាំងអស់ ដែល ខិតខំ ប្រឹងប្រែង នឹង ការងារ ប្រចាំ ថ្នាក់ ឬ សាកលវិទ្យាល័យ រួម នឹង ការខិតខំ ប្រឹងប្រែង ក្នុង ការសិក្សា ៕ ក្រសួង កសិកម្ម សហការ ជាមួយ ក្រុមហ៊ុន ស៊ី .ភី . ខេមបូឌា រៀបចំ សិក្ខាសិលា ពី ជំងឺ ប៉េស្ត ជ្រូក អាហ្រិ្វក « ជំងឺ និង ផល ប៉ះពាល់ ដល់ អាជីវកម្ម »
លោក បណ្ឌិត សួន សុធឿន អគ្គ នាយក រង នៃ នាយកដ្ឋាន សុខភាព សត្វ និង ផលិតកម្ម សត្វ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ថ្លែង ថា ជំងឺ នេះ ជា ជំងឺ ប៉េស្ត ជ្រូក អាហ្រិ្វក បង្ក ដោយ វីរុស ដែល ធន់ នឹង បរិយាកាស ខាងក្រៅ វា នៅក្នុង លាមក សត្វ កាកសំណល់ ខោអាវ ដែល ស្លៀកពាក់ មធ្យា បាយ យានយន្ត ជាដើម ។ ឧទាហរណ៍៖ ប្រទេស ចិន ដែល បាន ចម្លង ពី កន្លែង មួយ ទៅ កន្លែង មួយ ទៀត ។
លោក បន្ថែម ថា « យើង ជា សមាជិក អង្គការ សុខភាព សត្វ ពិភពលោក យើង មាន ទំនាក់ទំនង ក្នុង ការចែកចាយ ព័ត៌មាន លើ បញ្ហា សុខភាព សត្វ ទំាង អស់ ដែល អាច ដឹង ពី ជំងឺ និង វិធានការ ដើម្បី ផ្សព្វផ្សាយ ដល់ ប្រជាជន ទូទៅ និង ត្រួតពិនិត្យ លើ បញ្ហា ដែល កើត លើ សត្វ ឲ្យ ទាន់ ពេលវេលា ហើយ យើង បាន សហការ ជាមួយ អង្គការ ដើម្បី ជជែក ពិភាក្សា ពី បញ្ហា ទប់ស្កាត់ នៃ ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក » ។
លោក បាន បញ្ជាក់ ថា « ព្រះរាជាណាចក្រ កម្ពុជា អត់ មាន ករណី កើត ជំងឺ ប៉េស្ត ជ្រូក អាហ្វ្រិក ប៉ុន្តែ ទោះបី មិន កើត ក៏ដោយ យើង មាន ចំណាត់ការ បង្ការ គ្រប់គ្រង ជំងឺ នេះ ជាមុន ដោយ ការសហការ ពី វិស័យ ឯកជន ជាមួយ ក្រសួង របស់ យើង » ។
លោក ស៊្រុន ពៅ ប្រធាន សមាគម ចិញ្ចឹម ជ្រូក កម្ពុជា បាន ឲ្យ ថា « បញ្ហា សព្វ ថ្ងៃ ដែល យើង អាច ប្រឈម ខ្លាំង គឺ បញ្ហា នាំចូល សាច់ ពី ក្រៅ ប្រទេស ដែល អាច បង្ក ការឆ្លង ដ៏ ងាយ បំផុត ដូច្នេះ សូមឲ្យ ក្រសួង ចេញ នូវ លិខិត បញ្ជាក់ ត្រឹមត្រូវ មុនពេល នំា ចូល សាច់ និង លើកស្ទួយ ដល់ កសិករ ក្នុង ការចិញ្ចឹម សត្វ ឲ្យ គ្រប់ នូវ តំរូវការ ទីផ្សារ ក្នុង ស្រុក » ។
អាការៈ ជំងឺ នេះ គួរ កត់សម្គាល់ ដូចជា ជ្រូក មាន កម្តៅ ខ្ពស់ ស្បែក ឡើង ក្រហម មាន កន្ទួល ឈាម ហើយ មាន ស្នាម ជាំ លើ ស្លឹក ត្រចៀក ពោះ និង ជើង ក្រោយ មាន អាការៈ ពិបាក ក្នុង ការដកដង្ហើម ជួបប្រទះ អាការៈ ខាង ប្រព័ន្ធ រំលាយ អាហារ លាមក រាក មាន លាយ ឈាម ជ្រូក មាន ការរលូត កូន ឬ កូន កើត មក ភ្លាម ងាប់ ភ្លាម ជ្រូក អាច ងាប់ ភ្លាម ៗ ដោយ មិន មាន រោគសញ្ញា អ្វី ទំាង អស់ ។
គួរ បញ្ជាក់ ដែរ ថា ប្រសិនបើ សត្វ ជ្រូក ឆ្លង ជំងឺ ប៉េស្ត ជ្រូក អាហ្រ្វិក នឹង ធ្វើឲ្យ សត្វ ជ្រូក ងាប់ ជាច្រើន ( អាចនឹង មាន អាត្រា ងាប់ ១០០ ភាគរយ ) ដែល ជំងឺ នេះ មិន ទាន់ មាន វ៉ាក់សាំង និង វិធី ព្យាបាល នៅឡើយ ទេ ប៉ុន្តែ វា ជា ជំងឺ ដែល មិន ឆ្លង ទៅ មនុស្ស ៕
ក្រសួង អប់រំ ប្រកាស ពន្យារ កាលបរិច្ឆេទ ទទទួល ពាក្យ សុំ ចុះឈ្មោះ ប្រឡង ជ្រើសរើស គ្រូបង្រៀន កម្រិត មូលដ្ឋាន បង្រៀន នៅ អនុវិទ្យាល័យ
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុវជន និង កីឡា បាន សេចក្តីជូនដំណឹង ស្តីពី ការពន្យារ កាលបរិច្ឆេទ ទទួល ពាក្យ សុំ ចុះឈ្មោះ ប្រឡង ជ្រើសរើស គ្រូបង្រៀន កម្រិត មូលដ្ឋាន បង្រៀន នៅ អនុវិទ្យាល័យ ។ នេះ បើ យោង តាម សេចក្តីជូនដំណឹង របស់ ក្រសួង អប់រំ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ។
សេចក្តីជូនដំណឹង ក្រសួង អប់រំ បាន ឱ្យដឹង ថា កាលបរិច្ឆេទ ប្រឡង នឹង ចាប់ផ្តើម ឡើង ដូច ខាងក្រោម៖
* សម័យ ប្រឡ ង៖ ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០១៨ ខាងមុខ នេះ * កាលបរិច្ឆេទ ឈប់ ទទួល ពាក្យ សុំ ចុះឈ្មោះ ប្រឡង៖ ពី ថ្ងៃទី ២៦ ទៅ ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ * មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី - ខេត្ត ត្រូវ បញ្ជូន សំណុំ លិខិត សុំ ចុះឈ្មោះ ប្រឡង របស់ បេក្ខជន ។
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្តីជូនដំណឹង របស់ ក្រសួង អប់រំ យុវជន និង កីឡា ដូច ខាងក្រោម៖
ក្រសួង ទេសចរណ៍ ប្រកាស អនុវត្ត ចលនា ប្រឡង ប្រណាំង « ភោជនីយដ្ឋាន - អាហារដ្ឋាន ទេសចរណ៍ ស្អាត » លើក ដំបូង
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ នា ថ្ងៃទី ២០ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ប្រកាស ដាក់ ឱ្យ អនុវត្ត ចលនា ប្រឡង ប្រណាំង « ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ស្អាត » លើក ទី១ ក្នុង គោលបំណង ចូលរួម ថែរក្សា បរិស្ថាន សោភ័ណភាព និង ភាពស្អាត នៅ តាម ទីតាំង ផ្តល់ សេវាកម្ម ម្ហូប អាហារ និង ភេសជ្ជៈ ព្រមទាំង តំបន់ គោលដៅ ទេសចរណ៍ នៅ កម្ពុជា ដែល ពិធី នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ជា បូរ៉ា រដ្ឋមន្ត្រី ស្តីទី ក្រសួង ទេសចរណ៍ នៅ ភោជនីយដ្ឋាន ទន្លេ បាសាក់២ ។
ជាមួយគ្នា នោះ លោក ជា បូរ៉ា បាន ផ្តាំផ្ញើ អនុសាសន៍ មួយចំនួន ដល់ ប្រតិបត្តិករ ពាក់ព័ន្ធ ដែល ចូលរួម ក្នុង ចលនា ប្រឡង ប្រណាំង ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ស្អាត ដូច ខាងក្រោម ៖
ទី១៖ ដើម្បីឱ្យ ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ត្រូវ ចូលរួម ឱ្យ បាន សកម្ម និង ខិតខំ ដើម្បី ទទួល ជ័យលាភី ជា ភោជនីយដ្ឋាន គំរូ ដោយ ត្រូវ គិតគូរ និង យកចិត្តទុកដាក់ លើ ការងារ សំខាន់ ៗ ២គឺ៖ * ភោជនីយដ្ឋាន ស្អាត៖ ភោជនីយដ្ឋាន គ្មាន សំរាម ជា ក្រដាស ក្រោម តុ ។ * ភោជនីយដ្ឋាន ស្អាត៖ ភោជនីយដ្ឋាន មាន បង្គន់ អនាម័យ ស្អាត ។
ទី ៣៖ ពាក់ព័ន្ធ នឹង ការងារ អនាម័យ និង ភាពស្អាត បង្គន់ នៅ ភោជនីយដ្ឋាន ត្រូវ មាន អ្នកប្រចាំ ការ និង ថែទាំ សម្អាត ឱ្យ បាន ច្បាស់លាស់ និង ជាប្រចាំ ធានា កុំ ឱ្យ មាន ក្លិន និង ត្រូវ មាន សម្ភារ ប្រើប្រាស់ ក្នុង បង្គន់ ឱ្យ បាន ល្អ និង គ្រប់គ្រាន់ ស្រប តាម ស្តង់ដា បង្គន់ សាធារណៈ កម្ពុជា ។ ទី ៤៖ ឯកឧត្តម បាន ស្នើសុំ ឱ្យ ប្រជាពលរដ្ឋ យុវជន មន្ត្រីរាជការ ចូល រូម ចុះឈ្មោះ ស្នើសុំ កូន សៀវភៅ (Green Passport) ដើម្បី វាយតម្លៃ ចលនា ប្រឡង ប្រណាំង ភោជនីយដ្ឋាន ស្អាត អាហារដ្ឋាន ទេសចរណ៍ ស្អាត ។
សូម ជម្រាប ថា ចលនា ប្រឡង ប្រណាំង « ភោជនីយដ្ឋាន - អាហារដ្ឋាន ទេសចរណ៍ ស្អាត » លើក ដំបូង នេះ ក៏ ជា សារ មួយ ក្រើនរំឭក និង ប្រកាស ជូន ប្រជាពលរដ្ឋ និង ភាគី ពាក់ព័ន្ធ ឱ្យ ចូលរួម គ្រប់គ្រង សំរាម នៅ តុ អាហារ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ដើម្បី សោភ័ណភាព និង ភាពស្អាត ដែល ជា កត្តា សំខាន់ មិន អាច ខ្វះ បាន ក្នុង ការអភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ ប្រកបដោយ ចីរភាព ៕ លោក មូន ជែ អ៊ីន ត្រឡប់ ទៅដល់ កូរ៉េ ខាងត្បូង វិញ ហើយ បន្ទាប់ពី បញ្ចប់ ជំនួប កំពូល ជាមួយ លោក គីម ជុង អ៊ុន
( សេអ៊ូល ) ៖ ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ជែ អ៊ីន បាន ធ្វើដំណើរ ត្រឡប់ មកដល់ កូរ៉េ ខាងត្បូង វិញ ហើយ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បន្ទាប់ពី បាន ចូលរួម ក្នុង ជំនួប កំពូល ជាមួយ មេដឹកនាំ កូរ៉េ ខាងជើង លោក គីម ជុង អ៊ុន ក្នុង ទីក្រុង ព្យុងយ៉ាង តាំងតែពី ថ្ងៃអង្គារ មក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២០ ខែកញ្ញា ឆ្នាំ ២០១៨ ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ម៉ៅ សុផាន់ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៧០ បាន ថ្លែង បញ្ជាក់ អះអាង ថា មូលហេតុ ដែល លោក និង ឧត្តមសេនីយ៍ ៤រូប ទៀត បាន សុំ លា លែង ក្នុង តួនាទី ពី នាយ រង សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ គឺ ធ្វើឡើង ទៅតាម ច្បាប់ ដែល កំណត់ មិន ថា តែ នៅ ប្រទេស កម្ពុជា គឺ នៅ តាម ប្រទេស ដទៃ ទៀត ក្នុង ពិភពលោក ពោល នៅពេល កាន់ តួនាទី ជា ប្រធាន កងពល ដែល ស្ថិត ក្រោម បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក ហើយ មិន ត្រូវ មាន តួនាទី ផ្សេង ទៀត នៅ ថ្នាក់ អគ្គ បញ្ជាការ ឡើយ ។
កាលពី ថ្ងៃទី ០៦ ខែកញ្ញា ឆ្នាំ ២០១៨ សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ការពារ ជាតិ បាន ចេញ សេចក្តីសម្រេច ថ្មី មួយ ដោយ កែសម្រួល ផ្ទេរ ក្របខ័ណ្ឌ អង្គភាព កងពល ធំ អន្តរាគមន៍ និង កងពល តូច អន្តរាគមន៍ ចំនួន ៥ ពី អគ្គ បញ្ជាការដ្ឋាន មក ចំណុះ ផ្ទាល់ បញ្ជាការដ្ឋាន កងទ័ព ជើងគោក ៕
