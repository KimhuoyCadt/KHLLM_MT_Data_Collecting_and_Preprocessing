( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន លើកឡើង នៅ ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ថា ដំណើរទស្សនកិច្ច របស់ គណៈប្រតិភូ កម្ពុជា នៅ ជប៉ុន នឹង បាន ចូលរួមចំណែក ក្នុង ការពង្រឹង និង ធ្វើឱ្យ កាន់តែ ស៊ីជម្រៅ នូវ កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា - ជប៉ុន ទាំង ក្នុង ក្របខណ្ឌ ទ្វេ ភាគី តំបន់ និង នៅលើ ឆាក អន្តរជាតិ ។
ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន បាន អញ្ជើញ ទៅ បំពេញ ទស្សនកិច្ចការងារ នៅ ប្រទេស ជប៉ុន រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៨ ដល់ ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ តប តាម ការអញ្ជើញ របស់ រដ្ឋាភិបាល ជប៉ុន ។ នេះ គឺជា ទស្សនកិច្ច ផ្លូវការ ក្រៅ ប្រទេស ជា លើក ដំបូង របស់ លោក រដ្ឋមន្រ្តី ការបរទេស កម្ពុជា សម្រាប់ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី ។
ខណៈ កំពុង ទស្សនកិច្ច នេះ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន សរសេរ នៅលើ ទំព័រ Facebook ផ្លូវការ របស់ លោក យ៉ាង ដូច្នេះ៖ « ខ្ញុំ ជឿជាក់ យ៉ាង មុតមាំ ថា ដំណើរទស្សនកិច្ច របស់ គណៈប្រតិភូ កម្ពុជា លើក នេះ នឹង ចូលរួមចំណែក ក្នុង ការពង្រឹង និង ធ្វើឱ្យ កាន់តែ ស៊ីជម្រៅ នូវ កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា និង ជប៉ុន ទាំង ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី តំបន់ និង នៅលើ ឆាក អន្តរជាតិ » ។
គួរ រំលឹក ផងដែរ ថា ឆ្នាំ នេះ គឺជា ខួប អនុស្សាវរីយ៍ លើក ទី ៦៥ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត រវាង កម្ពុជា និង ជប៉ុន ។ ប្រទេស ទាំង ពីរ បាន ឯកភាព គ្នា រៀបចំ សកម្មភាព រួមគ្នា មួយចំនួន ទាំង នៅ កម្ពុជា និង នៅ ជប៉ុន ហើយ ដំណើរទស្សនកិច្ច របស់ លោក និង គណៈប្រតិភូ កម្ពុជា លើក នេះ ក៏ ជា សកម្មភាព មួយ បំពេញ បន្ថែម លើ ការអបអរ ខួប អនុស្សាវរីយ៍ នេះ ដើម្បី ពង្រឹង នូវ ទំនាក់ទំនង ទ្វេ ភាគី ឱ្យ កាន់តែ រឹងមាំ ថែម ទៀត ។
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន បញ្ជាក់ ថា កម្ពុជា ក៏ បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បី សហការ យ៉ាង ជិតស្និទ្ធ ជាមួយ ជប៉ុន ដែល ជា ប្រធាន និង ជា ប្រទេស ម្ចាស់ ផ្ទះ ក្នុង ការរៀបចំ កិច្ចប្រជុំ កំពូល មេគង្គ - ជប៉ុន លើក ទី១០ នៅ ខែតុលា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ៕
ក្រុមហ៊ុន ឈាន មុខ មួយ ចំនួន របស់ អាមេរិក ចាប់អារម្មណ៍ លើ វិស័យ កសិកម្ម នៅក្នុង ប្រទេស កម្ពុជា ក្រោយ ការបោះឆ្នោត
( ភ្នំពេញ ) ៖ សភា ពាណិជ្ជកម្ម សហរដ្ឋ អាមេរិក - កម្ពុជា ដោយ មាន ការសម្របសម្រួល ពី ស្ថានទូត អាមេរិក នៅ ភ្នំពេញ នឹង រៀបចំ ព្រឹត្តិការណ៍ ពាណិជ្ជកម្ម មួយ នៅ រាជធានី ភ្នំពេញ រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៧ ខែកញ្ញា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។ ពិព័រណ៍ នេះ ផ្តោត លើ វិស័យ កសិកម្ម ដែល មាន ការប្រែប្រួល យ៉ាង ឆាប់រហ័ស របស់ ប្រទេស កម្ពុជា ក្រោម ប្រធានបទ « ឱកាស ធុរកិច្ច នៅក្នុង វិស័យ កសិកម្ម នៅ កម្ពុជា » ។ នេះ បើ តាម សេចក្តីប្រកាស របស់ ស្ថានទូត អាមេរិក ប្រចាំ នៅ ប្រទេស កម្ពុជា ។
គោលបំណង នៃ ការរៀបចំ ព្រឹត្តិការណ៍ នេះ គឺ ដើម្បី ជួយ ឲ្យ ក្រុមហ៊ុន អាមេរិក មាន ការយល់ដឹង ស៊ីជម្រៅ ទៅ លើ វិស័យ នេះ ដោយ ភ្ជាប់ ទំនាក់ទំនង ជាមួយ ភាគី កម្ពុជា ហើយ ស្វែងរកមើល អនាគត ដៃគូ វិនិយោគ និង ពាណិជ្ជកម្ម ដ៏ មាន សក្តានុពល នៅក្នុង ប្រទេស នេះ ។
( ពោធិ៍សាត់ )៖ ក្នុង គោលបំណង ការពារ ផលប្រយោជន៍ អ្នកប្រើប្រាស់ និង ចូលរួម ទប់ស្កាត់ ផល ប៉ះពាល់ ដល់ សុខភាព អ្នកប្រើ តាមរយៈ ចំណីអាហារ នៅ ព្រឹក ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ សាខា កាំ កុងត្រូល ខេត្ត ពោធិ៍សាត់ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង អាជ្ញាធរដែនដី បាន ចុះ ពិនិត្យ ទំនិញ ម្ហូប អាហារ និង ផ្សព្វផ្សាយ អប់រំ ដល់ ប្រជាពលរដ្ឋ នៅ ផ្សារ តា លោ ឃុំ តា លោ ស្រុក បាកាន និង តាម បណ្តា ម៉ាត នៅ ក្រុង ពោធិ៍សាត់ ដើម្បី តាមដាន រក ផលិតផល មួយចំនួន ដែល ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ និង ហាមឃាត់ ។
លោក តូច ចៅ កុយ ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ពោធិ៍សាត់ បាន ឲ្យដឹង ថា នៅក្នុង ប្រតិបត្តិការ ចុះអង្កេត ទំនិញ នៅ ផ្សារ តា លោ ខាងលើ ក្រុមការងារ បាន រកឃើញ ទំនិញ ០៨មុខ ខូច គុណភាព និង ហួស កាលបរិច្ឆេទ ដោយ សរុប ៥២៨ គីឡូក្រាម បាន ធ្វើ កំណត់ហេតុ ដកហូត យក ទៅ ដុត កម្ទេចចោល នៅនឹង កន្លែង តែម្តង ។
ជាមួយគ្នា នោះ លោក តូច ចៅ កុយ ក៏ បាន អំពាវនាវ ដល់ អាជីវករ អ្នកលក់ដូរ ទាំងអស់ ឲ្យ ប្រុងប្រយ័ត្ន និង យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ការចែកចាយ ព្រមទាំង នាំចូល ទំនិញ មក លក់ បន្ដ ៕ អ្នកនាំពាក្យ៖ គណបក្ស ប្រជាជន កម្ពុជា ស្វាគមន៍ ចំពោះ ជំហរ របស់ លោក ដូណាល់ ត្រាំ ចំពោះ រដ្ឋាភិបាល កម្ពុជា អាណត្តិ ថ្មី
( ភ្នំពេញ ) ៖ លោក សុខ ឥសាន អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ១៩ ខែកញ្ញា ឆ្នាំ ២០១៨ បាន ស្វាគមន៍ ចំពោះ ជំហរ ដ៏ ត្រឹមត្រូវ របស់ លោក ដូណាល់ ត្រាំ ប្រធានាធិបតី សហរដ្ឋ អាមេរិក ដែល បាន ថ្លែង ថា អាមេរិក រីករាយ នឹង ធ្វើ ការងារ ជាមួយ ប្រទេស កម្ពុជា សម្រាប់ រាជ រដ្ឋាភិបាល អាណត្តិ ថ្មី ។
សូម ជម្រាប ថា នៅ ចំពោះ មុខ លោក ជុំ សុន្ទរី ក្នុង ពេល អញ្ជើញ ប្រគល់ សារ តាំង បំពេញ បេសកកម្ម ការងារ ជា ឯក អគ្គ រាជ ទូត កម្ពុជា នៅ ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០១៨ នោះ លោក ដូណាល់ ត្រាំ បាន បញ្ជាក់ ថា សហរដ្ឋ អាមេរិក មាន ការភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង លើ ការរីកចម្រើន ផ្នែក សេដ្ឋកិច្ច របស់ កម្ពុជា ហើយ សហរដ្ឋ អាមេរិក មាន មោទនភាព ដែល ជា ដៃគូ នៅក្នុង កិច្ចអភិវឌ្ឍ នេះ ។
ប្រធានាធិបតី ប្រទេស មហា អំណាច រូប នេះ បាន បន្ថែម យ៉ាង ដូច្នេះ ទៀត ថា៖ « យើង ដឹង ថា កម្ពុជា មាន សក្តានុពល សម្រាប់ កិច្ចអភិវឌ្ឍ ធំ ធេង ជាង នេះ នៅក្នុង អនាគត ហើយ យើង មាន ក្តីរីករាយ ធ្វើការ ជាមួយគ្នា នៅ ចំពោះមុខ ការប្រឈម និង កាលានុវត្តភាព ជាច្រើន អនេក ។ យើង មាន ការរំពឹង ថា នឹង មាន ការរីកចម្រើន ក្នុង ពាណិជ្ជកម្ម សេរី ត្រឹមត្រូវ សន្តិសុខ តំបន់ ហើយនិង អភិបាលកិច្ច ប្រកបដោយ ការទទួលខុសត្រូវ និង ប្រជាធិបតេយ្យ ហើយ យើង នឹង ខិតខំ ដើម្បី ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ ផ្នែក សុខាភិបាល ទូទៅ » ។
លោក ដូណាល់ ត្រាំ បាន បញ្ជាក់ ទៀត ថា៖ « ខ្ញុំ រីករាយ នឹង ធ្វើការ ជាមួយ ឯកឧត្តម ដើម្បី ជំរុញ របៀបវារៈ រួម របស់ យើង ហើយ នឹង ធ្វើឱ្យ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ កាន់តែ ស៉ី ជម្រៅ ថែម ទៀត » ។
លោក សុខ ឥសាន បាន ចាត់ទុក ថា ជំហរ ដ៏ មាន អត្ថន័យ និង មាន តម្លៃ ចំពោះ សភាពការណ៍ កម្ពុជា ដែល លោក ប្រធានាធិបតី មាន ឆន្ទ : ចង់ ធ្វើការ ជាមួយ កម្ពុជា ដើម្បី ធ្វើឲ្យ ទំនាក់ទំនង ទ្វេ ភាគី កាន់តែ ស៉ី ជម្រៅ នោះ គឺជា ការផ្តល់ យុត្តិធម៌ ដល់ ប្រជាជន កម្ពុជា និង រាជ រដ្ឋាភិបាល កម្ពុជា ដែល កើត ចេញពី ការបោះឆ្នោត តាម ឆន្ទៈ របស់ ប្រជាជន កម្ពុជា នៅ ទូទាំង ប្រទេស ដែល ឆ្លុះបញ្ចាំង ពី លទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា បាន នឹង កំពុង រីកចម្រើន យ៉ាង ពិតប្រាកដ ។
បើ តាម អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា គោលជំហរ ដ៏ ត្រឹមត្រូវ របស់ លោក ដូ ណាល់ ត្រាំ ពេលនេះ ផ្ទុយ ស្រឡះ ពី សម្តី និង ការផ្សាយ របស់ ក្រុម ជ្រុល និយម មួយ ចំនួន ។ លោក បន្ត ថា ក្រុម ជ្រុលនិយម ទាំងនោះ តែងតែ បំភ្លៃ ការពិត និង មូល បង្កាច់ សភាពការណ៍ កម្ពុជា ដោយ ធ្វើ ខ្លួន ជា ខ្មាំង សត្រូវ របស់ ប្រទេស កម្ពុជា និង ធ្វើ ខ្លួន ជា អាមេរិក ជាង អាមេរិក ទៅ ទៀត ដែល ផ្ទុយ ពី ជំហរ ទាំងស្រុង របស់ លោក ដូ ណាល់ ត្រាំ ៕
