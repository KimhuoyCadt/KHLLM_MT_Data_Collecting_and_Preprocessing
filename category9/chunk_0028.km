( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ២.២៤៤ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៨១៤ គ្រឿង អប់រំ១៨៣ គ្រឿង និង ផាក ពិន័យ ៦៣១ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ០៦ ខែតុលា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១. ២៤៤ រឿង . អប់រំ ៨៦ គ្រឿង និង ផាក ពិន័យ ២១៣ គ្រឿង ។
ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ! មន្ត្រី កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បន្ត ចុះ ចាប់ ទំនិញ ខូច គុណភាព និង ហួស ការបរិច្ឆេទ នៅ តាម ផ្ទះ អាជីវករ រួច ដុត កំទេចចោល ភ្លាម ៗ
នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ មន្ត្រី កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត សមត្ថកិច្ច និង អជ្ញាធរ មូលដ្ឋាន បាន ធ្វើ ការ ចុះ ត្រួតពិនិត្យ ទំនិញ វេចខ្ចប់ ស្រាប់ ក៍ ដូចជា ទំនិញ ផ្សេង ៗ ទៀត ដែល តាំង លក់ដូរ តាម ផ្ទះ ក្នុង ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ បន្ទាប់ ចាប់ បាន ទំនិញ ខូច គុណភាព ទាំងអស់ នោះ មន្ត្រី កាំ កុងត្រូល ខេត្ត ក៏ បាន យក ទៅ ដុត កំទេចចោល ភា្លម ៗ តែម្តង ។
លោក ដួង មុនី ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន លើកឡើង ថា « ក្នុង ការចុះ ត្រួតពិនិត្យ នា ឱកាស នោះ ក្រុមការងារ យើង បាន ពិនិត្យ រកឃើញ ទំនិញ មួយចំនួន ខូច គុណភាព និង ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ រួម មាន ទឹកក្រូច ចម្រុះ ចំណុំ ១១. ៤៤លីត្រ ស្រា ប៊ៀរ ចំណុះ ០. ៩៩លីត្រ ភេសជ្ជះ ប៉ូវ កម្លាំង ចំណុំ ០. ៦៥លីត្រ មីម៉ាម៉ា ទម្ងន់ ៣. ៨៤ គីឡូក្រាម ផងដែរ ។ ក្រោយ ធ្វើ ការដកហូត ទំនិញ ទាំងនោះ ត្រូវបាន យក ទៅ ដុត កំទេចចោល » ។
លោក ក៏ បាន ធ្វើ ការងប់ រំណែនាំ អោយ អាជីវករ នៅ ខេត្ត ព្រះវិហារ ទាំងអស់ មុន និង ទិញ ទំនិញ ផ្សេង ៗ មក ដាក់ លក់ សូម ធ្វើ ការត្រួតពិនិត្យមើល អោយ បាន ច្បាស់លាស់ ដើម្បី កុំ អោយ ប៉ះពាល់ ដល់ សុខភាព របស់ អ្នកទិញ ៕
លោក ហេង វីលីន ប្រធាន ផ្នែក ផលិតផល ឲ្យដឹង ថា « នេះ ជា លើក ទី១ ហើយ ដែល ក្រុមហ៊ុន ធ្វើ បច្ចុប្បន្នភាព កំណែ ថ្មី ឲ្យ ទាន់ តម្រូវការ និង ការចង់បាន របស់ អ្នក គ្រប់គ្រង ផ្នែក ទីផ្សារ ។ ក្នុង នោះ ការផ្លាស់ប្តូរ មាន ដូច ជា៖ រូបរាង ប៉ូតុង ថ្មី ទាន់សម័យ សាកសម នឹង យុវវ័យ ជំនាន់ ថ្មី និង កាត់បន្ថយ ភាពស្មុគស្មាញ » ។
( ភ្នំពេញ ) ៖ ហ្សបហោស៍ ជា លំនៅឋាន មួយ ដែល ពេញនិយម និង មាន តម្រូវ ច្រើន សម្រាប់ អតិថិជន ព្រោះ ជា គេហដ្ឋាន ដែល អាច ប្រកប អាជីវកម្ម ផង និង រស់ នៅ ផង ។ លំនៅដ្ឋាន ប្រភេទ នេះ ទាមទារ អោយ មាន មាន ទីតាំង ល្អ ដែល ជា ទីប្រជុំជន ពាណិជ្ជកម្ម មាន មនុស្ស រស់ នៅ ច្រើន កុះករ ក្នុង តំបន់ អភិវឌ្ឍ ទើប សក្តិសម សម្រាប់ ការប្រកប អាជីវកម្ម ផងដែរ ។
បើ ក្រឡេក មើល ការអភិវឌ្ឍ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ១ ចាប់ពី ស្ពាន ព្រះមុនីវង្ស ដល់ តំបន់ បឹង ស្នោរ កំពុងតែ រីក ដុះដាល ទៅ ដោយ គម្រោង អភិវឌ្ឍ លំនៅដ្ឋាន ជាច្រើន រួមទាំង ផ្សារ ទំនើប ធនាគារ សាលារៀន មន្ទីរពេទ្យ ភោជនីយដ្ឋាន ហាង ទំនិញ បាន ក្លាយជា ទីតាំង ប្រជុំជន ពាណិជ្ជកម្ម មួយ ជាពិសេស តំបន់ បឹង ស្នោរ ផ្ទាល់ តែម្តង ។ បច្ចុប្បន្ន នេះ តំបន់ បឹង ស្នោរ លែង ស្ងប់ស្ងាត់ ដូច កាលពី មុន ឡើយ ក្រោយពេល គម្រោង ដ៏ ធំ មួយ របស់ បុរី ប៉េង ហួត ដែល មាន ឈ្មោះ ថា ហ្គ្រេន ស្តាផ្លា ទីនីម បាន លេច រូបរាង ឡើង ។
លើ ផ្ទៃដី ជាង ២០០ ហិចតា គម្រោង ដ៏ ធំ នេះ បាន ប្រែក្លាយ តំបន់ បឹងស្នោរ ជា ទីក្រុង រណប មួយ ដ៏ សម្បូរបែប មួយ ដែល រួម មាន សួន កម្សាន្ត បែប អឺរ៉ុប សាលារៀន អន្តរជាតិ កីឡដ្ឋាន ស្ថានីយ ពន្លត់ អគ្គីភ័យ ខុនដូ និង ផ្សា ទំនើប ថែម ទៀត ផង ។
ក្រៅតែ ពី ភាពសម្បូរបែប ខាងលើ ក្នុង គម្រោង ដ៏ ធំ នេះ ក៏ បាន បែប ចែក តំបន់ សម្រាប់ រស់ នៅ និង តំបន់ ពាណិជ្ជកម្ម ដែល មាន លំនៅដ្ឋាន ជាច្រើន ប្រភេទ ក្នុង ការបន្ថែម ជម្រើស សម្រាប់ អតិថិជន ដែល កំពុង ស្វែងរក លំនៅដ្ឋាន ។
គម្រោង ដឹស្តា ផ្លាទីនីម ប៉ូឡារី ស ១ និង ប៉ូឡារី ស ២ ព្រមទាំង សាលារៀន អន្តរជាតិ កីឡដ្ឋាន ស្ថានីយ ពន្លត់ អគ្គីភ័យ ខុនដូ និង ផ្សា ទំនើប ស្ថិត ក្នុង តំបន់ ពាណិជកម្ម រួមគ្នា តែ មួយ ក្នុង គម្រោង ហ្គ្រេន ស្តាផ្លា ទីនីម ( បឹង ស្នោរ ) នេះ សក្តិសម សម្រាប់ ប្រកប អាជីវកម្ម គ្រប់ ប្រភេទ ។
ក្នុង គម្រោង នេះ ក្រុមហ៊ុន បាន សាងសង់ លំនៅដ្ឋាន ប្រភេទ ហ្សបហោស៍ ជាច្រើន ដូច ជា៖ ហ្សបហោស៍ A ហ្សបហោស៍ B ហ្សបហោស៍ C ហ្សបហោស៍ D និង ហ្សបហោស៍ Classic រួមបញ្ចូល រចនាបថ យ៉ាង ល្អ ឥត ខ្ចោះ ដោយ ផ្អែក លើ គុណភាព ប្រណិតភាព សោភណ្ឌភាព ភាពស៊ីវិល័យ និង ភាពច្នៃប្រឌិត ខ្ពស់ ដែល មាន បន្ទប់ គេង៤ បន្ទប់ទឹក៥ ព្រមទាំង បរិវេណ ទទួល ភ្ញៀវ ដែល មាន បរិយាកាស ស្រស់ស្រាយ កន្លែង ទទួលទាន អាហារ បន្ទប់ ចម្អិន អាហារ និង កន្លែង ចត រថយន្ត ធំ ទូលាយ ដែល ស័ក្តិសម បំផុត សម្រាប់ ការរស់នៅ និង ប្រកប អាជីវកម្ម របស់ លោក អ្នក ។
ពិសេស ជាង នេះ ទៅ ទៀត អតិថិជន មាន ប្រាក់ ត្រឹមតែ ១០០០ ដុល្លារ អាច ក្លាយជា ម្ចាស់ ហ្សបហោស៍ ដ៏ ប្រណិត ក្នុង គម្រោង ដឹស្តា ផ្លាទីនីម ប៉ូឡារី ស ១ និង ប៉ូឡារី ស ២នេះ ។ សូម រួសរាន់ ឡើង កុំ អោយ ឱកាស នេះ កន្លងផុត អោយ សោះ ការផ្តល់ ជូន ពិសេស នេះ ត្រឹម ដំណាច់ ខែតុលា នេះ តែ ប៉ុណ្ណោះ ។
អភិបាល ក្រុង ប៉ោយប៉ែត ប្រើ ធម៌ ក្តៅ ទាមទារ ឲ្យ លុប សិទ្ធិ ប្រមូល សំរាម របស់ ក្រុមហ៊ុន « ឃ្យុង ធាវី » ហើយ សុខចិត្ត អស់ តំណែង បើ បញ្ឈប់ ក្រុមហ៊ុន នេះ មិន បាន
( បន្ទាយមានជ័យ ) ៖ អភិបាល ក្រុង ប៉ោយប៉ែត លោក សាន ស៊ាន ហូ បាន សម្តែង ការខកចិត្ត ជាខ្លាំង ចំពោះ ក្រុមហ៊ុន ប្រមូល សំរាម « ឃ្យុង ធាវី » ដែល មិន ប្រឹងប្រែង ក្នុង ការប្រមូល សំរាម លើកកម្ពស់ សោភណ្ឌភាព ក្រុង បែរជា ប្រឹងប្រែង រក អ្នក អន្តរាគមន៍ ការពារ ភាព អសកម្ម របស់ ខ្លួន ទៅ វិញ ។ លោក អភិបាល ក្រុង រូប នេះ បាន ថ្លែង ជាមួយ ភាព ម៉ឹង ម៉ាត់ ថា លោក សុខចិត្ត អស់ តំណែង អភិបាល ក្រុង តែ មិន សុខចិត្ត រស់ នៅ ជាមួយ សំរាម នោះ ឡើយ ។
ថ្លែង ក្នុង ពេល ចុះ ពិនិត្យ ស្ថានភាព សំរាម ក្នុង ក្រុង ប៉ោយប៉ែត នា ព្រឹក ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ លោក សាន ស៊ាន ហូ បាន ថ្លែង ថា « តាំងពី ខ្ញុំ មកកាន់ តំណែង ជា អភិបាល ក្រុង រយៈពេល ៩ខែ មក នេះ សុំ ខ្មា ស រឿង សំរាម តែ ម្តង ដល់ ពេលវេលា ក្រុមហ៊ុន ប្រមូល សំរាម ឃ្យុង ធាវី ដល់ អវសាន ហើយ ។ បើ ទុកឲ្យ ប្រមូល សំរាម មិន ចេះ អស់ សោះ តើ ឲ្យ ខ្ញុំ ប្រជាពលរដ្ឋ ខ្ញុំ រស់នៅ ប្រឈម បញ្ហា រិះគន់ បញ្ហា ផ្លូវ ដង្ហើម បញ្ហា ដង្កូវ បញ្ហា សំរាម ស្អុយ ក្នុង ក្រុង តាម ដងផ្លូវ ពាស វាលពាសកាល គ្មាន ត្រឹមត្រូវ ឡើយ » ។
លោក អភិបាល ក្រុង ប៉ោយប៉ែត បាន អំពាវនា ដល់ ក្រុមហ៊ុន ផ្សេង ៗ ទៀត មាន គោលបំណង ចង់ ប្រកប មុខរប ប្រមូល រាម នៅ ក្រុង ប៉ោប៉ែត អាច ចូលរួម ដាក់ទន់ ក្នុង ការប្រមូល សំរាម នេះ ។
លោក សាន ស៊ាន ហូ បាន រំលេច ថា បញ្ហា របស់ ក្រុមហ៊ុនេះ ក៏ កំពុង មាន ការអន្តរាគមន៍ ផងដែរ ប៉ុន្តែ លោក សុខចិត្ត មាន ការប្តឹង ផ្តល់ ដល់ តុលាការ ក៏ មិន ខ្លាច ដែរ ហើយ បើ អស់ តំណែង ជា អភិបាល ក្រុង ក៏ គ្មាន បញ្ហា ដែរ ឲ្យ តែ ដក ក្រុមហ៊ុន ប្រមូល សំរាម នេះ ចេញ ៕
និស្សិត នាយ នគរបាល ជាតិ កម្ពុជា មួយ រូប ទទួលបាន ពានរង្វាន់ ជា និស្សិត បរទេស ឆ្នើម បំផុត ពី បណ្ឌិត សភា នគរបាល ជាតិ សិង្ហបុរី
( សិង្ហបុរី ) ៖ លោក វរសេនីយ៍ ទោ វុទ្ធី វង្ស វិបុល ជា នាយ នគរបាល ជាតិ កម្ពុជា ទី១ ដែល ទទួលបាន ពានរង្វាន់ ជា និស្សិត បរទេស ឆ្នើម បំផុត ពី បណ្ឌិត សភា នគរបាល ជាតិ សិង្ហបុរី ដែល នេះ បង្ហាញ ពី ការវិវឌ្ឍន៍ ខ្លួន មួយ របស់ កម្ពុជា ដែល មាន បុគ្គល ឆើម ទទួលបាន ពានរង្វាន់ ដ៏ ល្អ មួយ នេះ ។
លោក ហ៊ុន ម៉ានី ៖ រាជ រដ្ឋាភិបាល កម្ពុជា យកចិត្តទុកដាក់ លើ ការងារ អភិវឌ្ឍ ធនធាន មនុស្ស ប្រកបដោយ គុណភាព និង មាន គុណធម៌ ដើម្បី អភិវឌ្ឍន៍ សង្គម សេដ្ឋកិច្ច
( សៀមរាប ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន គណៈកម្មការ អប់រំ យុវជន និង កីឡា ធម្មការ កិច្ចការ សាសនា វប្បធម៌ និង ទេសចរណ៍ នៃ រដ្ឋសភា បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន យកចិត្តទុកដាក់ ខ្ពស់ លើ ការងារ អភិវឌ្ឍ ធនធាន មនុស្ស ប្រកបដោយ គុណភាព គុណធម៌ ដើម្បី សម្រេច គោលដៅ អភិវឌ្ឍ សង្គម និង សេដ្ឋកិច្ច របស់ កម្ពុជា ឲ្យកាន់តែ រីកចម្រើន ។
អ្នកតំណាងរាស្ត្រ វ័យ ក្មេង រូប នេះ ក៏ បាន លើកឡើង ផងដែរ ថា បច្ចុប្បន្ន នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង លើ ការងារ អភិវឌ្ឍ ធនធាន មនុស្ស ប្រកបដោយ គុណភាព និង មាន គុណធម៌ ដែល ឆ្លើយតប ការអភិវឌ្ឍ សង្គម សេដ្ឋកិច្ច ឈាន ឆ្ពោះ ទៅរក ការកសាង សង្គម កម្ពុជា ប្រកបដោយ ភាពរីកចម្រើន ជឿនលឿន ។
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែតុលា លទ្ធផល៖ បង្ក្រាប ១៥ករណី ឃាត់ខ្លួន ២១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
តាមរយៈ ការស្វែងរុករក នៅ ប្រទេស កម្ពុជា យើង នឹង រៀបចំ ទីផ្សារ អាស៊ី អាគ្នេយ៍ ដទៃ ទៀត ដូចជា វៀតណាម ថៃ និង មីយ៉ាន់ម៉ា ហើយ បន្ទាប់មក រៀបចំ ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍ សកល ។ ក្រុមហ៊ុន មាន សមត្ថភាព ខ្លាំងក្លា និង ធានា ចំពោះ ការចូល ទីផ្សារ ។ សូម ប្រញាប់ ទំនាក់ទំនង មក ដើម្បី សួរ ព័ត៌មាន បន្ថែម ៕ មុន ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ឈាន មកដល់ មន្រ្តី កាំ កុងត្រូល រឹបអូស អាហារ វេច ខ្ចប់ ស្រេច ជា កាដូ អនុស្សាវរីយ៍ នៅ ម្តុំ ពេទ្យ ចិន ហួស គុណភាព ជាច្រើន កញ្ចប់
( ភ្នំពេញ ) ៖ ដើម្បី ការពារ សុខ សុវត្ថិភាព ម្ហូប អាហារ នា រដូវ បុណ្យ ភ្ជុំ បិណ្ឌ ខិត ជិត មកដល់ មន្រ្តី កាំ កុងត្រូល ផែ ស្ងួត ចុង ទី ភ្នំពេញ នៅ ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០១៨ បាន ចុះ ឆែកឆេរ និង ត្រួតពិនិត្យ អាហារ វេច ខ្ចប់ ស្រេច ដើម្បី ធ្វើជា កាដូ អនុស្សាវរីយ៍ ដាក់ លក់ នៅ ម្តុំ ពេទ្យ ចិន ហួស គុណភាព ជាច្រើន កញ្ចប់ ហើយ សម្រេច រឹបអូស យក ទៅ កំទេចចោល ភ្លាម ៗ ផងដែរ ។
ក្រោយពី រឹបអូស នូវ ទំនិញ ខូច គុណភាព ទាំងនេះ ជាច្រើន កញ្ចប់ នៅ ហាង មួយចំនួន នោះ លោក គង់ វុទ្ធី បាន ឲ្យ អាជីវករ ឬ ម្ចាស់ ហាង ចុះ កិច្ចសន្យា ឈប់ ដាក់ លក់ នូវ ទំនិញ ខូច គុណភាព ដែល វា ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព អ្នក បរិភោគ ហើយ ប្រសិនបើ មាន ដាក់ តាំង ទៀត នឹង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ។
ជាមួយគ្នា នោះ ដែរ លោក ក៏ បាន អំពាវនាវ ដល់ អាជីវករ អ្នកចែកចាយ លក់ ដុំ លក់ រាយ អ្នកផលិត នាំចូល ចែកចាយ ត្រូវតែ មាន ប្រភព ច្បាស់លាស់ សិន មុននឹង ទទួល លក់ ហើយ បញ្ចប់ ការលាយ បន្ថែម នូវ សារធាតុ គីមី ទៅ លើ ផលិតផល ម្ហូប អាហារ ដែល ធ្វើអោយ ប៉ះពាល់ ដល់ សុខភាព អ្នកប្រើប្រាស់ ជាដើម ។
លោក គង់ វុទ្ធី បាន បន្ថែម ថា នៅក្នុង ប្រតិបត្តិការ ចុះ ឆែកឆេរ នេះ គឺ ធ្វើឡើង តាម បទបញ្ជា ឯកឧត្តម ប្រធាន ប្រតិភូ ទទួលបន្ទុក អគ្គ នាយកដ្ឋាន កាំកុងត្រូល និង លោក ប្រធាន សាខា ផែ ស្ងួត ចុង ទី ភ្នំពេញ ដែល គិត អំពី សុវត្ថិភាព និង សុខភាព ដល់ បងប្អូន ប្រជាពលរដ្ឋ ហើយ នេះ គឺ បាន ធ្វើឡើង ដូច ភ្លៀង រលឹម យ៉ាង ដូច្នេះ ដែរ ៕
សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ ប្រារព្ធ សន្និបាត ដើម្បី តែងតាំង និង ទទួលស្គាល់ គណៈ កិត្តិយស និង គណៈកម្មាធិការ សាខា អាណត្តិ ទី ៥
សន្និបាត នេះ បាន ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព លោកស្រី អ៊ុក ម៉ាលី អគ្គ ហេរញ្ញិក កាកបាទ ក្រហម កម្ពុជា តំណាង ដ៏ ខ្ពង់ខ្ពស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង អញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ - មន្ត្រី ទីស្នាក់ការ កណ្តាល សាខា អនុសាខា និង អ្នក ពាក់ព័ន្ធ សរុប ប្រមាណ ១៧០ នាក់ ។
ក្នុង ឱកាស សន្និបាត អាណត្តិ ទី ៥ នេះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន សម្រេច តែងតាំង និង ទទួលស្គាល់ សមាសភាព គណៈ កិត្តិយស សាខា ចំនួន ២៣នាក់ . គណៈកម្មាធិការ សាខា ចំនួន ១៥នាក់ និង សមាជិក បម្រុង ចំនួន ២នាក់ ដែល បាន អាន សេចក្តីសម្រេច ជូន អង្គ សន្និបាត ដោយ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី ១ កាកបាទ ក្រហម កម្ពុជា ។
ជាមួយគ្នា នោះ លោក មាន ចាន់ យ៉ាដា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ អាណត្តិ ទី ៥ បាន ធ្វើ ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ បន្ត អនុវត្ត ឱ្យ បាន ជោគជ័យ ជា បន្តបន្ទាប់ នូវ ទិសដៅ យុទ្ធសាស្ត្រ និង ផែនការ សកម្មភាព ឱ្យ ទទួលបាន កាន់តែ មាន ប្រសិទ្ធភាព និង ទទួលបាន ការគាំទ្រ បន្ថែម ទៀត ។
ថ្លែង ក្នុង ឱកាស បិទ សន្និបាត សាខា លោកស្រី អ៊ុក ម៉ាលី អគ្គ ហេរ ញ្ញឹក បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ក្តី នឹករលឹក ការកោតសរសើរ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ ក្រោម ការដឹកនាំ របស់ លោក ប៉ា សុជាតិ វង្ស ដែល បាន ខិតខំ សម្រេចបាន នូវ សមិទ្ធផល ធំ ធេង ទុក ជា មរតក ស្នាដៃ សម្រាប់ អ្នក បន្ត វេន ។
ប្រធាន គណៈកម្មការ ទី១០ព្រឹទ្ធសភា ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ និង សាងសង់ ផ្លូវ ២ខ្សែ នៅ ឃុំ គោក ត្រប់ ខេត្ត កណ្តាល
( កណ្តាល ) ៖ ដើម្បី ជា ចំណង ដៃ ក្នុង ឱកាស ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ នៅ ថ្ងៃទី ៦ ខែតុលា ឆ្នាំ ២០១៨ លោក ម៉ម ប៊ុន នាង ប្រធាន គណៈកម្មការ ទី១០ព្រឹទ្ធសភា បាន អញ្ជើញ ដឹកនាំ ក្រុម បច្ចេកទេស សាងសង់ ផ្លូវ ចុះ ពិនិត្យ ផ្លូវ លំ ដែល ទទួលរង នូវ ការខូចខាត និង សិក្សា ស្ថានភាព ផ្លូវ ដើម្បី សាងសង់ ឡើងវិញ ស្ថិត ក្នុង ឃុំ គោក ត្រប់ ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ។
មានប្រសាសន៍ ក្នុង ឱកាស នោះ លោក ម៉ម ប៊ុន នាង បាន ថ្លែងអំណរគុណ ចំពោះ ប្រជាពលរដ្ឋ ទូទាំង ឃុំ គោក ត្រប់ ដែល បាន អញ្ជើញ ទៅ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្រ្ត នីតិកាល ទី៦ កាលពី ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ កន្លងទៅ ជាពិសេស ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន បន្ត គាំទ្រ រាជ រដ្ឋាភិបាល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ដើម្បី ថែរក្សា សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សណ្តាប់ធ្នាប់ សង្គម សម្រាប់ ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ។
លោក បាន បន្ត ថា ផ្លូវ ដែល កំពង់សិក្សា សាងសង់ ឡើងវិញ នេះ គឺជា សមិទ្ធផល ថ្មី មួយ បន្ថែម ទៀត ដែល បង្ហាញ អំពី ការរីកចំរើន នៃ ប្រទេសជាតិ ប្រកបដោយ សុខ សន្តិភាព និង បង្ហាញ អោយ ឃើញ ពី ការយកចិត្តទុកដាក់ របស់ អាជ្ញាធរ និង រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ នៅ មូលដ្ឋាន ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ហើយ ការកសាង ផ្លូវ នេះ គឺ មាន សារៈសំខាន់ ខ្លាំង ណាស់ ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ កសិករ រឺ អាជីវករ អាច ដឹក ទំនិញ បាន ងាយស្រួល និង សម្រួល ដល់ ការធ្វើចរាចរ ណ៏ ឱ្យ មាន ភាពងាយស្រួល ជាង មុន បន្ថែម ទៀត ។
ជាមួយគ្នា នោះ លោក ក៏ បាន ក្រើនរំឭក ឱ្យ អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការផ្តល់ សេវា សាធារណៈ ឱ្យ បាន ល្អ ជូន ដល់ ប្រជាពលរដ្ឋ ដូចជា ជួយ សម្រួល ដល់ ការធ្វើ ឯកសារ គតិយុត្តិ ផ្សេង ៗ នៅ មូលដ្ឋាន ការធ្វើ អត្តសញ្ញាណប័ណ្ណ អាត្រានុកូលដ្ឋាន សំបុត្រ កំណើត និង សំបុត្រ មរណភាព ជាដើម ។
មន្ត្រី អនុវត្តន៍ ការងារ ទាំងអស់ គឺជា អ្នកបម្រើ ប្រជាពលរដ្ឋ មិន មែន ជា ចៅហ្វាយ របស់ ជា ពលរដ្ឋ ឡើយ ដូច្នេះ មិន ត្រូវ ទារ លុយ បន្ថែម ពី ប្រជាពលរដ្ឋ នោះ ទេ ។ ហើយ មន្ត្រី គ្រប់ រូប ត្រូវ ខិតខំ បំពេញ ការងារ ជូន ប្រជាពលរដ្ឋ ដោយ ស្មោះត្រង់ និង ពន្លឿន ការងារ ឱ្យ បាន ឆាប់ រហ័ស ទើប អាច ឆ្លើយតប ទៅនឹង ការអនុវត្ត ការផ្តល់ សេវា សាធារណៈ មាន ប្រសិទ្ធភាព ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ម៉ម ប៊ុន នាង និង លោកស្រី បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី បុណ្យ កាន់ បិណ្ឌ វេន ទី ១២ ដើម្បី ឧទ្ទិស កោសល ផល បុណ្យ ដល់ ដួង វិញ្ញាណក្ខន្ធ បុព្វការី ជន និង ញាតិកាល ទាំង ៧ សន្តាន ដែល បាន ចែក ឋាន ទៅកាន់ លោក ខាងមុខ នៅ វត្ត កោក កាក ស្ថិត ក្នុង ភូមិ គោក ត្រប់ ឃុំ គោក ត្រប់ ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ។
( តូក្យូ . ជប៉ុន ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង គណៈប្រតិភូ ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន អញ្ជើញ ដល់ ទីក្រុង តូក្យូ ប្រទេស ជប៉ុន ប្រកបដោយ សុខ សុវត្ថិភាព នៅ វេលា ម៉ោង ១៧៖ ៤០ នាទី ម៉ោង នៅ ទីក្រុង តូក្យូ ប្រទេស ជប៉ុន ត្រូវ នឹង ម៉ោង ១៣៖ ៤០ នាទី ម៉ោង នៅ រាជធានី ភ្នំពេញ ប្រទេស កម្ពុជា ។
ការអញ្ជើញ ដល់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី និង គណៈប្រតិភូ ជាន់ ខ្ពស់ ត្រូវបាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ បំផុត ពី លោក ស៊ុយ ស៊ុយ គី ណូរី កាស៊ុ អនុ រដ្ឋមន្រ្តី ការបរទេស ជប៉ុន . លោក ហូរី ណូឈិះ ហ៊ីដេហ៊ីសា ឯក អគ្គ រាជ ទូត វិសាមញ និង ពេញ សមត្ថភាព របស់ ប្រទេស ជប៉ុន ប្រចាំ នៅ កម្ពុជា . លោក អ៉ឹង រចនា ឯក អគ្គ រាជ ទូត វិសាមញ និង ពេញ សមត្ថភាព របស់ កម្ពុជា ប្រចាំ ប្រទេស ជប៉ុន ព្រមទាំង វត្តមាន ឥស្សរជន ជាន់ ខ្ពស់ រដ្ឋាភិបាល ជប៉ុន និង ឥស្សរជន ការទូត របស់ កម្ពុជា ប្រចាំ ប្រទេស ជប៉ុន ជាច្រើន រូប ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន បាន ដឹកនាំ គណៈប្រតិភូ ហោះ ចេញ ពី ប្រទេស កម្ពុជា នៅ ព្រឹក មិញ នេះ ដើម្បី ចូលរួម កិច្ចប្រជុំ កំពូល មេគង្គ - ជប៉ុន លើក ទី១០ នៅ ទីក្រុង តូក្យូ ប្រទេស ជប៉ុន ។
យោង តាម ក្រសួង ការបរទេស កម្ពុជា បាន ឲ្យដឹង ថា កិច្ចប្រជុំ កំពូល មេគង្គ - ជប៉ុន លើក ទី១០ នេះ ធ្វើឡើង ពី ថ្ងៃទី ៦ ដល់ ១០ ខែតុលា ឆ្នាំ ២០១៨ ។ អញ្ជើញ អម ដំណើរ សម្តេច តេជោ ហ៊ុន សែន មាន លោក ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស ព្រមទាំង ឥស្សរជន ជាន់ ខ្ពស់ នៃ រាជ រដ្ឋាភិបាល និង ថ្នាក់ដឹកនាំ ធុរកិច្ច នៃ សភា ពាណិជ្ជកម្ម កម្ពុជា ផងដែរ ។
បើ តាម សេចក្តីជូន ព័ត៌មាន របស់ ក្រសួង ការបរទេស បាន ឲ្យដឹង ថា ក្នុង ពេល ចូលរួម កិច្ចប្រជុំ កំពូល នេះ ថ្នាក់ដឹកនាំចូលរួម កិច្ចប្រជុំ កំពូល មេគង្គ - ជប៉ុន នឹង ចូល ក្រាប បង្គំ គាល់ ព្រះចៅ អធិរាជ ជប៉ុន ផងដែរ ។
ក្រសួង ការបរទេស បាន ឲ្យដឹង ផងដែរ ថា កិច្ចប្រជុំ កំពូល មេគង្គ - ជប៉ុន លើក ទី១០ នេះ នឹង ពិភាក្សា និង អនុម័ត យុទ្ធសាស្រ្ត ទីក្រុង តូក្យូ ថ្មី សំដៅ ធ្វើឲ្យ ប្រសើរឡើង នូវ ការតភ្ជាប់ លើកកម្ពស់ សុខ មាលភាព ប្រជាជន និង ការពារ បរិស្ថាន ។ យុទ្ធសាស្ត្រ នេះ ផ្តោត សារៈសំខាន់ លើ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង ការកាត់បន្ថយ គម្លាត អភិវឌ្ឍន៍ រវាង ប្រទេស មេគង្គ និង ប្រទេស សមាជិក អាស៊ាន ផ្សេង ទៀត ។
សម្តេច តេជោ ហ៊ុន សែន នឹង ថ្លែង សុន្ទរកថា មួយ ដោយ ផ្តោត ជា សំខាន់ ទៅ លើ ទិសដៅ នា ពេល អនាគត នៃ កិច្ចសហប្រតិបត្តិការ មេគង្គ - ជប៉ុន ។
ថ្នាក់ដឹកនាំ មេគង្គ នឹង អញ្ជើញ ពិសារ អាហារ ការងារ ពេលព្រឹក រៀបចំ ដោយ សមាគម មិត្តភាព សភា ជប៉ុន - មេគង្គ ពិសារ អាហារ ការងារ ថ្ងៃត្រង់ រៀបចំ ដោយ ក្រុម ធុរកិច្ច និង ចូលរួម ក្នុង វេទិកា វិនិយោគ ជប៉ុន - មេគង្គ រៀបចំ ដោយ អង្គ ការ ពាណិជ្ជកម្ម ក្រៅ ប្រទេស ជប៉ុន (JETRO) ។ ក្នុង ឱកាស នោះ សម្តេច តេជោ នឹង ថ្លែង សង្ក ថា គន្លឹះ ផ្តោត លើ ការទាក់ទាញ វិនិយោគិន ជប៉ុន មក ធ្វើ ធុរកិច្ច ក្នុង តំបន់ មេគង្គ ។
នៅ ក្រៅ កិច្ចប្រជុំ កំពូល មេគង្គ - ជប៉ុន លើក ទី១០ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង ជួបពិភាក្សា ទ្វេ ភាគី ជាមួយ លោក ស៊ីន ហ្សូ អាបេ នាយក រដ្ឋមន្រ្តី ជប៉ុន ស្តីពី បញ្ហា ផ្សេង ៗ ដែល ជា ការយកចិត្តទុកដាក់ រួម នៃ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី តំបន់ និង អន្តរជាតិ ។ បន្ទាប់មក នាយក រដ្ឋមន្ត្រី ទាំង ពីរ នឹង មាន សន្និសីទ សារព័ត៌មាន រួមគ្នា ។
សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ក៏ នឹង ឆ្លៀត ឱកាស ជួប សំណេះសំណាល ជាមួយ សហគមន៍ និង និស្សិត កម្ពុជា ដែល កំពុង រស់ នៅ និង សិក្សា នៅក្នុង ប្រទេស ជប៉ុន ផងដែរ ។
( ភ្នំពេញ ) ៖ សកម្មភាព មីន នៅតែ បន្ត ពង្រឹង និង លើកកម្ពស់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង កំណើន សេដ្ឋកិច្ច ដើម្បី ជួយ កាត់បន្ថយ ភាពក្រីក្រ នៅ កម្ពុជា ។ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ នូវ យុទ្ធសាស្រ្ត ឆ្ពោះ ទៅរក កម្ពុជា មួយ ដែល គ្មាន មីន ឆ្នាំ ២០២៥ ដើម្បី សម្រេច គោលដៅ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា និង ភាគី ពាក់ព័ន្ធ ត្រូវ បន្ត សហការ គ្នា យ៉ាង រឹងមាំ ដោយ ឈលើ គោលការណ៍ ប្តេជ្ញាចិត្ត ខ្ពស់ ។
គិត ត្រឹម ខែធ្នូ ឆ្នាំ ២០១៧ ផ្ទៃដី ប្រមាណ ១.៧០០ គីឡូម៉ែត្រ ការ៉េ ត្រូវបាន បោសសម្អាត ជា លទ្ធផល នៃ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដោយ មាន ការគាំទ្រ ពី ម្ចាស់ ជំនួយ អន្តរជាតិ នានា ។
បញ្ហា មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម នៅ កម្ពុជា គឺជា លទ្ធផល នៃ ជម្លោះ ផ្ទៃក្នុង និង តំបន់ ចាប់តាំងពី ពាក់កណ្ដាល ទសវត្ស ឆ្នាំ ១៩៦០ ដល់ ចុង ឆ្នាំ ១៩៩៨ និង រហូតមកដល់ បច្ចុប្បន្ន ។ យោង តាម ការស្រាវជ្រាវ ផល ប៉ះពាល់ នៅ ទូទាំង ប្រទេស ក្នុង ឆ្នាំ ២០០២ មាន ៦. ៤១៦ ភូមិ ( ៤៦% នៃ ភូមិ ទាំងអស់ នៅក្នុង ប្រទេស កម្ពុជា ) ដែល មាន ផ្ទៃដី ចំនួន ៤. ៥៤៤ គីឡូម៉ែត្រ ការ៉េ បាន រង ផល ប៉ះពាល់ ។
មាន ជនរងគ្រោះ ៦៤. ៧២០ នាក់ ទាំង យោធា និង ជន ស៊ីវិល ដែល បាន ធ្វើឲ្យ រាំងស្ទះ ដល់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម របស់ ប្រទេស ។
អាជ្ញាធរ មីន និង អង្គការ NPA ត្រូវបាន ចាត់ទុក ជា ដៃគូ យូរអង្វែង នៅក្នុង ការអភិវឌ្ឍ សមត្ថភាព ចាប់តាំងពី ឆ្នាំ ២០០៧ តាមរយៈ ការបង្កើត អង្គភាព ទិន្នន័យ ថ្នាក់ ជាតិ (DBU) រួមទាំង ការគាំទ្រ បច្ចេកទេស ប្រឹក្សា យោបល់ និង ការផ្តល់ មូលនិធិ ។
ការអនុវត្ត គម្រោង អភិវឌ្ឍន៍ សមត្ថភាព តាម រយៈ នាយកដ្ឋាន អភិវឌ្ឍន៍ អន្តរជាតិ នៃ ចក្រភព អង់គ្លេស (DFID) ដំណាក់កាល ទី១ បាន ចាប់ផ្តើម ពី ឆ្នាំ ២០១៤ និង បាន បញ្ចប់ ក្នុង ខែមីនា ឆ្នាំ ២០១៨ និង ចាប់ បន្ត ដំណាក់កាល ទី២ពី ខែកក្កដា ឆ្នាំ ២០១៨ រហូតដល់ ខែមីនា ឆ្នាំ ២០២០ ។ កិច្ចសហការ នេះ ត្រូវបាន គេ កត់សម្គាល់ ថា ជា វិភាគទាន ដ៏ ធំធេង ក្នុង ការលើក កំពស់ សមត្ថភាព មន្ត្រី អាជ្ញាធរ មីន និង អង្គភាព រៀបចំ ផែនការ សកម្មភាព មីន ក្នុង ការដឹកនាំ ការគ្រប់គ្រង និង សម្របសម្រួល សកម្មភាព មីន អោយ កាន់តែ ប្រសើរឡើង ។
គម្រោង ថ្មី នេះ ផ្តោត ទៅ លើ៖ ទី១៖ ដំណើរការ រៀបចំ ផែនការ និង ការចាត់ អាទិភាព ទី ២៖ ការបង្កើត គោលការណ៍ ណែនាំ ស្តីពី ការបញ្ជ្រាប យេនឌ័រ ក្នុង សកម្មភាព មីន ទី ៣៖ បន្ត ធ្វើឲ្យ ប្រសើរឡើង នូវ ប្រព័ន្ធ គ្រប់គ្រង គុណភាព ទី ៤៖ បន្ត ធ្វើឲ្យ ប្រសើរឡើង នូវ ប្រព័ន្ធ គ្រប់គ្រង ព័ត៌មាន ទី ៥៖ ការបង្កើត យុទ្ធសាស្ត្រ គ្រប់គ្រង ការពង្រឹង សមត្ថភាព ជាតិ ក្នុង ការដោះស្រាយ បញ្ហា ដែល នៅ សេសសល់ ក្រោយ ឆ្នាំ ២០២៥ ៕
ខ្ញុំបាទ លឹម ជា វុត្ថា ក៏ សូម លើក ដៃ ប្រណម បួងសួង ដល់ បុណ្យ គុណ ព្រះរតនត្រ័យ វត្ថុ ស័ក្តិសិទ្ធ ក្នុង លោក ទេវតា ថែរក្សា ចក្រវាឡ យើង នេះ តាម ជួយ អភិបាល ប្រោស ព្រំ ដល់ ថ្នាក់ដឹកនាំ ជាតិ កម្ពុជា ដៃគូ ពាណិជ្ជកម្ម និង ជន រួម ជាតិ ខ្មែរ ទាំងអស់ បាន ជួប តែ សេចក្តីសុខ សេចក្តី ចម្រើន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង កាយ មាំ មួន សម្រេច រាល់ ភារកិច្ច ដែល ប៉ងប្រាថ្នា ជាពិសេស គ្រប់ ដំណើរ ទៅកាន់ ទីកន្លែង នានា បាន ជួប តែ សុខ សុវត្ថិភាព និង ពោរពេញ ដោយ ភាពសប្បាយរីករាយ ៕
របាយការណ៍ បាន បង្ហាញ ផងដែរ ថា ដំណើរការពិនិត្យ បញ្ជី ឈ្មោះ និង ចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨ ដែល ធ្វើឡើង ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ០៥ ខែតុលា នេះ គ.ជ. ប បាន សម្រេច លុប ឈ្មោះ អ្នកបោះឆ្នោត ៥. ៣៦៤ នាក់ ចេញ ពី បញ្ជី ឈ្មោះ បោះឆ្នោត និង ៣៦៧ នាក់ ទៀត បាន កែតម្រូវ ទិន្នន័យ មួយចំនួន ។
គ.ជ. ប បាន គូសបញ្ជាក់ ថា ដំណើរការ ពិនិត្យ និង ចុះឈ្មោះ បោះឆ្នោត នៅ ឆ្នាំ ២០១៨ នេះ នៅសល់ រយៈពេល តែ ១៣ ថ្ងៃ ប៉ុណ្ណោះ នឹង ត្រូវ បិទ បញ្ចប់ ហើយ ។ ក្នុង ន័យ នេះ គ.ជ. ប បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល បាន ចុះឈ្មោះ រួចហើយ សូម ទៅ ពិនិត្យ ឈ្មោះ ដើម្បី កែតម្រូវ ចំណុច ដែល ខុសឆ្គង កន្លងមក ។
ដោយឡែក ប្រជាពលរដ្ឋ ទើប គ្រប់ អាយុ ១៨ ឆ្នាំ ( កើត មុន ឬ កើត ត្រឹម ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០០១ ) និង ប្រជាពលរដ្ឋ មិន ធ្លាប់ បាន ចុះឈ្មោះ បោះឆ្នោត ពីមុន មក ក៏ សូមអញ្ជើញ រួសរាន់ ទៅ ចុះឈ្មោះ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី មាន សិទ្ធិ ចូលរួម បោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ក៏ ដូចជា បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ ៕ ប្រមុខរដ្ឋ ស្តីទី ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង ទីប្រឹក្សា និង ជំនួយ ការលោកស្រី ឃួន សុដារី អនុប្រធាន ទី២ រដ្ឋសភា ចំនួន ២៧ រូប
( ភ្នំពេញ ) ៖ ប្រមុខរដ្ឋ ស្តីទី សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ តែងតាំង ទីប្រឹក្សា និង ជំនួយ ការលោកស្រី ឃួន សុដារី អនុប្រធាន ទី២ រដ្ឋសភា ចំនួន ២៧ រូប ដែល មាន ឋានៈ ចាប់ពី អគ្គ នាយក ដល់ រដ្ឋលេខាធិការ ៕
ថ្ងៃ នេះ ជា ថ្ងៃ កាន់ បិណ្ឌ ទី ១២. សូម ស្វែងយល់ អំពី ប្រវត្តិ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ដែល ជា ទំនៀមទម្លាប់ របស់ បងប្អូន ប្រជាជន ខ្មែរ
ព្រឹក នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ចាប់ផ្តើម បញ្ចេញ រថយន្តក្រុង សាធារណៈ ចំនួន ១២០ គ្រឿង ដឹក ប្រជាពលរដ្ឋ ទៅ ស្រុក កំណើត ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ព្រលឹម ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៨ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ ចាប់ផ្តើម បញ្ចេញ រថយន្តក្រុង សាធារណៈ ចំនួន ១២០ គ្រឿង ដើម្បី ដឹក ប្រជាពលរដ្ឋ ទៅ លេង ស្រុក កំណើត ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។
សូម ជម្រាប ថា ដើម្បី សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ពី រាជធានី ភ្នំពេញ ទៅ ខេត្ត នានា ក៏ ដូចជា ត្រឡប់ ពី ខេត្ត នានា ត្រឡប់មក រាជធានី ភ្នំពេញ វិញ ឱ្យ មាន លក្ខណៈ ល្អ ប្រសើរ នោះ នៅក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន សម្រេច ផ្តល់ កាដូ មួយ ថ្មី ទៀត ជូន ដល់ ប្រជាពលរដ្ឋ ដោយ បញ្ជា ឱ្យ សាលា រាជធានី ភ្នំពេញ បញ្ចេញ រថយន្តក្រុង សាធារណៈ ១២០ គ្រឿង ដើម្បី ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ទៅ មក មិន គិត ថ្លៃ រយៈពេល ៦ ថ្ងៃ នៅក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។
ជាមួយ នោះ ដែរ សាលា រាជធានី ភ្នំពេញ នឹង ប្រើប្រាស់ រថយន្តក្រុង ចំនួន ៩៥ គ្រឿង ដើម្បី ដឹកជញ្ជូន ដោយ មិន បង់ប្រាក់ រយៈពេល ០៣ ថ្ងៃ ពី ថ្ងៃទី ០៨ ដល់ ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០១៨ ។
ក្រោយមក លោក ត្រូវបាន គេ បោះឆ្នោត ជ្រើសរើស ធ្វើជា សមាជិក នៃ ថ្នាក់ដឹកនាំ បក្ស PUK នៅក្នុង សន្និសីទ បក្ស លើក ទី១ ។ លោក ត្រូវបាន ចាត់តាំង ឱ្យដឹកនាំ ការិយាល័យ PUK ប្រចាំ នៅ សហរដ្ឋ អាមេរិក ។ បន្ទាប់ពី ការដួលរលំ នៃ របប Baathist លោក បាន ក្លាយជា ឧប នាយក រដ្ឋមន្ត្រី នៅក្នុង រដ្ឋាភិបាល បណ្តោះអាសន្ន របស់ អ៉ីរ៉ាក់ ( នៅ ពាក់កណ្តាល ឆ្នាំ ២០០៤ ) និង ជា រដ្ឋមន្រ្តី ក្រសួង ផែនការ នៅក្នុង រដ្ឋាភិបាល អន្តរកាល ( ឆ្នាំ ២០០៥) ។
ទីបំផុត លោក បាន ក្លាយជា ឧប នាយក រដ្ឋមន្ត្រី នៅក្នុង រដ្ឋាភិបាល ជាប់ ឆ្នោត របស់ ប្រទេស អ៉ីរ៉ាក់ ដោយ ទទួលបន្ទុក ផ្នែក ផលប័ត្រ សេដ្ឋកិច្ច និង ជា ប្រធាន គណៈកម្មាធិការ សេដ្ឋកិច្ច ។ តំណាង ឱ្យ រដ្ឋាភិបាល អ៉ីរ៉ាក់ លោក បាន ចុះ កិច្ចព្រមព្រៀង រវាង អ៉ីរ៉ាក់ និង សហគមន៍ អន្តរជាតិ ដើម្បី ជួយ ប្រទេស នេះ អាច សម្រេច កាតព្វកិច្ច របស់ ខ្លួន ក្នុង ការកសាង ប្រទេសជាតិ ប្រកបដោយ វិបុលភាព ប្រជាធិបតេយ្យ និង ជា ប្រទេស សហព័ន្ធ ប្រកបដោយ សន្តិភាព ទាំង ក្នុង ប្រទេស ទាំង ថ្នាក់ តំបន់ និង ពិភពលោក ។
* នាយក រដ្ឋមន្ត្រី នៃ រដ្ឋាភិបាល តំបន់ ស្វយ័ត ឃឺ ដ
* ផ្លាស់ទី ទៅ គណបក្ស ប្រឆាំង
នៅ ខែកញ្ញា ឆ្នាំ ២០១៧ លោក សាលីហ បាន ប្រកាស ថា លោក បាន ចាកចេញ ពី បក្ស PUK និង បង្កើត គណបក្ស ប្រឆាំង ថ្មី មួយ ដែល មាន ឈ្មោះ ថា សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ និង យុត្តិធម៌ ដើម្បី ប្រកួតប្រជែង នៅក្នុង ការបោះឆ្នោត នៅ អ៊ីរ៉ាក់ ដែល នឹង ចូល មកដល់ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ ។ មេដឹកនាំ រូប នេះ បាន បង្ហាញ សង្ឃឹម ថា នឹង ប្រមូលផ្តុំ គណបក្ស ប្រឆាំង ដទៃ ទៀត ដើម្បី រួមគ្នា ប្រកួតប្រជែង បក្ស សម្ព័ន្ធ KDP-PUK ។
* ប្រធានាធិបតី ប្រទេស អ៉ីរ៉ាក់
នៅ ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០១៨ លោក សាលីហ ត្រូវបាន ជាប់ ឆ្នោត ក្លាយជា ប្រធានាធិបតី ទី៨ នៃ ប្រទេស អ៊ីរ៉ាក់ ដោយ លោក ទទួលបាន ២១៩ សម្លេង ដោយ បាន យក ជ័យជម្នះ ទៅ លើ លោក ហ្វូដ ហូសេន ដែល ទទួលបាន ត្រឹមតែ ២២ សម្លេង ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ០៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ ឆ្នេរសមុទ្រ មួយ នៅ ប្រទេស ថៃ ត្រូវ បិទ មិន ឲ្យ ទៅ កម្សាន្ត ទៀត ព្រោះតែ ភ្ញៀវ ទេសចរ បំពុល ខ្លាំង ពេក ។
២៖ ពានរង្វាន់ ណូបែល សន្តិភាព ឆ្នាំ ២០១៨ បាន ទៅ លើ សកម្មជន ប្រឆាំង អំពើហិង្សា ផ្លូវភេទ ០២ រូប ។
៣៖ រកឃើញ សាកសព កើន ដល់ ១. ៥៧១ នាក់ ក្រោយ គ្រោះ រញ្ជួយ ដី និង ស៊ូណាមិវាយប្រហារ ឥណ្ឌូណេស៊ី ខណៈ ប្រមាណ ១.០០០ នាក់ នៅ បន្ត បាត់ខ្លួន ។
៤៖ កូរ៉េ ខាងជើង និង ខាងត្បូង ប្រារព្ធ ពី ធី អបអរសាទរ ខួប នៃ កិច្ចប្រជុំ កំពូល អន្តរ កូរ៉េ ដំបូង បំផុត កាលពី ២០០៧ ឆ្នាំ ២០០៧ ។
៥៖ ប៉ូលិស អាមេរិក ចាប់ខ្លួន បាតុករ ៣០២ នាក់ ដែល តវ៉ា ប្រឆាំង នឹង ការតែងតាំង ចៅក្រម តុលាការ កំពូល របស់ លោក ដូណាល់ ត្រាំ ។
៧៖ អតីត ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក Lee Myung-bak ត្រូវបាន តុលាការ កាត់ទោស ឱ្យ ជាប់ ពន្ធនាគារ ១៥ឆ្នាំ ។ អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន៖ សត្វ ព្រៃ ដ៏ កម្រ ជាច្រើន ប្រភេទ ត្រូវបាន គេ ប្រទះឃើញ នៅក្នុង ឧទ្យាន ជាតិ វីរៈ ជ័យ ក្នុង ខេត្ត រតនគិរី
( រតនគិរី ) ៖ សត្វ ខ្លាឃ្មុំ ស្វា ក្រវ៉ាត់ មាន់ ព្រៃ សំពោច ភ្នំ ឈ្លូស និង សត្វ ជាច្រើន ប្រភេទ ទៀត ក្នុង នោះ មាន ទាំង សត្វ កម្រ ផង ត្រូវបាន ឃើញ មាន វត្តមាន នៅក្នុង ឧទ្យាន ជាតិ វីរៈ ជ័យ ក្នុង ខេត្ត រតនគិរី ។ នេះ បើ យោង តាម ការ ឱ្យដឹង របស់ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា មន្ត្រី នាំ ពាក្យ ក្រសួង បរិស្ថាន នៅ ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ ។
លោក បាន ថ្លែង ថា ទិន្ន័យ និង រូបភាព ដែល បញ្ជាក់ ពី វត្តមាន ជីវៈ ចម្រុះ ទាំងនេះ ទទួលបាន ពី ម៉ាស៊ីន ថត ដោយ ស្វ័យប្រវត្តិ ដែល មន្ត្រី ឧទ្យានុរក្ស នៃ ឧទ្យាន ជាតិ វីរជ័យ បាន ដាក់ ចាប់តាំងពី ថ្ងៃទី ២៦ ខែកញ្ញា រហូតដល់ ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០១៨ នៅ តាម ទីតាំង មួយចំនួន ក្នុង ឧទ្យាន ជាតិ នេះ ។
សូម បញ្ជាក់ ថា ក្រោយពី មាន កំណែទម្រង់ ស៊ីជម្រៅ លើ តួនាទី និង ការទទួលខុសត្រូវ របស់ ក្រសួង បរិស្ថាន និង ក្រសួង កសិកម្ម មាន ការផ្ទេរ នូវ តំបន់ អភិរក្ស មួយចំនួន ពី ក្រសួង កសិកម្ម ឱ្យ មក ក្រសួង បរិស្ថាន គ្រប់គ្រង និង អភិរក្ស ។
( ភ្នំពេញ ) ៖ លោក ហេង រតនា អគ្គ នាយក មជ្ឈមណ្ឌល សកម្មភាព កម្ចាត់ មីន កម្ពុជា ( ស៊ីម៉ាក់ ) បាន បញ្ជាក់ នៅ ថ្ងៃទី ០៥ ខែតុលា នេះ ថា មន្ត្រី អង្គភាព ស៊ីម៉ាក់ ចំនួន ១២២ រូប បន្ថែម ទៀត ទើប បាន ទទួល ក្របខ័ណ្ឌ កងយោធពលកង ខេមរភូមិន្ទ ដើម្បី ជា ប្រយោជន៍ ទទួលគោល របប សោធន ។
លោក បាន បញ្ជាក់ ទៀត ថា សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន សំរេច បញ្ចូល ក្របខ័ណ្ឌ និង ប្រគល់ ឋានន្តរស័ក្តិ ជូន បងប្អូន ទាំងអស់ នៅ ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៨ នេះ ។
លោក បញ្ជាក់ ទៀត ថា គិត មកដល់ ពេលនេះ មាន មន្ត្រី អង្គភាព ស៊ីម៉ាក់ ៦៣១ រូប ហើយ ត្រូវបាន ដាក់បញ្ចូល ក្របខ័ណ្ឌ និង ផ្តល់ ជូន ឋានន្តរស័ក្តិ ។
ជាមួយគ្នា នេះ លោក សូម សំដែង អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ និង គណ:កម្មការបញ្ចូល ក្របខ័ណ្ឌ និង ផ្តល់ ឋានន្តរស័ក្តិ ជាពិសេស គោរព ដឹងគុណ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល ដែល យកចិត្តទុកដាក់ បំផុត ចំពោះ និវត្តន៍ ជន ទាំងអស់ ។
លោក ហេង រតនា ធ្លាប់ បាន ចាត់ទុក ថា ការប្រកាស បញ្ចូល ក្របខ័ណ្ឌ បំពាក់ ឋានន្ដរស័ក្ដិ នេះ ជា សក្ខីភាព មិន ត្រឹមតែ ជា ការឆ្លើយតប ទៅនឹង គុណ បំណាច់ របស់ បងប្អូន មន្ដ្រី ស៊ីម៉ាក់ ទាំងអស់ ដែល បាន ហ៊ាន លះបង់ អាយុជីវិត ខ្លួន ឯង ប្រឈមមុខ នឹង គ្រោះថ្នាក់ ចូលរួម បម្រើ ជាតិ និង ប្រជាជន ជាមួយ ស្មារតី យ៉ាង អង់អាច ក្លាហាន នោះ ប៉ុណ្ណោះ ទេ តែ ជា ការបង្ហាញ ឲ្យ ឃើញ ច្បាស់ នូវ ការដោះស្រាយ បញ្ហា សង្គមកិច្ច របស់ រាជ រដ្ឋាភិបាល ជូន អ្នក ដែល បាន រួមចំណែក ការពារ និង កសាង ប្រទេសជាតិ ឲ្យ កាន់តែ ប្រសើរឡើង ថែម ទៀត ។
លោក បញ្ជាក់ ទៀ ថា ការបញ្ចូល ក្របខ័ណ្ឌ បំពាក់ ឋានន្ដរស័ក្ដិ នេះ ក៏ បាន បង្ហាញ ពី ការយកចិត្តទុកដាក់ ពីសំណាក់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ចំពោះ មន្ត្រី ស៊ីម៉ាក់ ដែល បាន ពុះពារ បម្រើ ជាតិ ដូចជា ម បន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ ផ្សេង ទៀត ផងដែរ ។
សូម ជម្រាប ថា អតីត មន្ត្រី បុគ្គលិក ដែល បាន ចូលនិវត្តន៍ អ្នក បាត់បង់ លទ្ធភាព ពលកម្ម ពិការ ឬ គ្រួសារ នៃ អ្នក ដែល បាន ស្លាប់ ឬ ពលី កន្លងមក របស់ ស៊ីម៉ាក់ ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច បញ្ចូល ក្របខណ្ឌ ក្នុង កងយោធពល ខេមរភូមិន្ទ ប្រយោជន៍ ដើម្បី ទទួលបាន គោល របប សោធន ៕
ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៨២ គ្រួសារ មកពី ៥ភូមិ ក្នុង ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ ទទួលបាន អំណោយ មនុស្សធម៌ ពី កាកបាទ ក្រហម កម្ពុជា
លោកស្រី ចឹក ហេង បាន ថ្លែង ថា ជំនួស មុខ ឲ្យ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត ព្រះវិហារ និង ជា ប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត លោកស្រី បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីរសំណាក់ សម្តេច កិត្ត ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន ចំពោះ លោកយាយ លោក តា បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម ក្នុង ពិធី នេះ ។
ជាមួយគ្នា នេះ លោកស្រី ចឹក ហេង ក៏ បាន ផ្តាំផ្ញើរ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ធ្វើ យ៉ាងណា ត្រូវ សម្រាក ក្នុង មុង សុវត្ថិភាព ជានិច្ច ជៀសវាង កើត ជម្ងឺ គ្រុនចាញ់ គ្រុន ឈាម ព្រោះ នេះ ជា រដូវ វស្សា សំបូរ មូស ដែល គោល និង មូស ខ្លា ច្រើន ណាស់ ។ លោកស្រី ក៏ បាន ធ្វើ ការ ផ្តាំផ្ញើ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ក្នុង ការធ្វើដំណើរ ក្នុង រដូវ បុណ្យ ភ្ជុំ នេះ ជៀសវាង កុំ ឲ្យ កើតមាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ និង ត្រូវ ណែនាំ កូន ចៅ ត្រូវ ជៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន គ្រប់ ប្រភេទ ។
អំណោយ ដែល ចែកជូន ក្នុង ឱកាស នោះ មួយ គ្រួសារ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម អាវ១ មី១ កេស ត្រីខ១យួរ ទឹក ស៊ីវ អ៊ីវ១យួរ ឃីត១ កញ្ចប់ និង អារ ហារ បំប៉ន ១២កញ្ចប់ ៕ថៃ៖ ឆ្នេរសមុទ្រ មួយ ត្រូវ បិទ មិន ឲ្យ ទៅ កម្សាន្ត ទៀត ព្រោះតែ ភ្ញៀវ ទេសចរ បំពុល ខ្លាំង ពេក
ក៏ប៉ុន្តែ ដោយសារតែ ការទទួល ភ្ញៀវ ទេសចរ ច្រើន លើសលប់ ពេក វា បាន បណ្ដាលឱ្យ ផ្កា ថ្ម ជាង ៨០ ភាគរយ នៅ ជុំវិញ Maya Bay រង ការបំផ្លិចបំផ្លាញ យ៉ាង ដំណំ ហើយ បើ នៅតែ បណ្តែត បណ្តោយ ការបំផ្លាញ នេះ ទៅ មុខ ទៀត ធម្មជាតិ ដែល បាត់បង់ នឹង ពិបាក ក្នុង ការស្តារ ឡើងវិញ ខ្លាំង ណាស់ ។
គួរ បញ្ជាក់ ថា តំបន់ ឆ្នេរ ទេសចរណ៍ Maya Bay ត្រូវបាន បិទ ដោយ អាជ្ញាធរ ថៃ កាលពី ដើម ខែមិថុនា ហើយ ការបិទ ត្រូវបាន អូសបន្លាយ រហូតដល់ រយៈពេល មួយ ឆ្នាំ ក្រោយ ចំណាយ ពេល បួន ខែ ក្នុង ការសង្រ្គោះ ហើយ ប្រការ នោះ ត្រូវបាន បង្កឡើង ដោយ ការការពារ បរិស្ថាន មិន បាន គ្រប់គ្រាន់ ។ ចំណែកឯ ការបិទ ឆ្នេរ លើក នេះ មិន ត្រូវបាន គេ កំណត់ ពេលវេលា ឡើយ ៕
គម្រោង សាលា ស្អាត របស់ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស នៅ រាជធានី ភ្នំពេញ ឆ្នាំ ២០១៨
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន ចាប់ផ្តើម គម្រោង សាលា ស្អាត ដើម្បី លើកកម្ពស់ សោភ័ណភាព សាលារៀន ដោយ ជួសជុល កែលម្អ ហេដ្ឋារចនាសម្ព័ន្ធ មួយ ចំនួន ដូចជា ជួសជុល ឡើងវិញ របង សាលារៀន ខ្លោងទ្វារ ទីធ្លា សាលារៀន និង តារាង បាល់ ជាដើម ។
ក្នុង ឆ្នាំ ២០១៨ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន ចំណាយ ទឹកប្រាក់ សរុប ជាង ២០ម៉ឺន ដុល្លារ សហរដ្ឋ អាមេរិក សម្រាប់ គម្រោង សាលា ស្អាត នៅ រាជធានី ភ្នំពេញ ។
កាលពី ខែមីនា កន្លងទៅ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន សាងសង់ ទីលាន បាល់ទាត់ ដ៏ ស្រស់ស្អាត ថ្មី មួយ ជូន វិទ្យាល័យ ព្រះស៊ីសុវត្ថិ ដែល តារាង បាល់ទាត់ មួយ នេះ មាន ទំហំ ដី ៥២ម x ៧២ម ស្មើនឹង ៣៧៤៤ម៉ែត្រ ការ៉េ ។ ការរួមចំណែក នេះ មិន ត្រឹមតែ ជួយ ពង្រឹង វិស័យ បាល់ទាត់ ក្នុង វិទ្យាល័យ ប៉ុណ្ណោះ ទេ វា ថែមទាំង ជួយ លើក សោភ័ណភាព កាន់តែ ស្រស់ស្អាត មួយ កម្រិត ទៀត ផងដែរ ។
ក្រៅពី វិទ្យាល័យ ព្រះស៊ីសុវត្ថិ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ក៏ បាន កំពុងតែ ជួសជុល ហេដ្ឋ រចនាសម្ព័ន្ធ ក្នុង សាលារៀន មួយចំនួន ទៀត ក្នុង រាជធានី ភ្នំពេញ រួម មាន ការជួសជុល ឡើងវិញ របង សាលារៀន សម្រាប់ សាសា បឋមសិក្សា វត្ត ដំបូក ខ្ពស់ រៀបការ៉ូឡា ក្នុង បរិវេណ សាលា បឋមសិក្សា ដង្កោ ព្រមទាំង សាងសង់ ទីលាន បាល់ទាត់ និង បាល់ទះ ថ្មី សម្រាប់ វិទ្យាល័យ ទួល អំពិល ។
ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស នឹង បន្ត លើកកម្ពស់ សោភ័ណភាព សាលារៀន នៅ ជុំវិញ ប្រទេស ឲ្យ កាន់តែ ស្រស់ស្អាត មួយ កម្រិត ទៀត ដើម្បី បង្កើន បរិយាកាស សិក្សា ឲល្អ ប្រសើរ ជាង មុន សម្រាប់ សិស្សានុសិស្ស ទាំងអស់ ៕ ស្តាប់ សំនៀង ស្មូត្រ កំណាព្យ ដ៏ ក្រ អួន ក្រអៅ របស់ អ្នកគ្រូ យ ន ដានី ម្ចាស់ ជយលាភី ស្មូត្រ កំណាព្យ លេខ ១ ឆ្នាំ ២០១៨
( ភ្នំពេញ ) ៖ អ្នកគ្រូ យ ន ដានី បង្រៀន នៅ វិទ្យាល័យ ច័ន្ទ គ្រឹស្នា ស្រុក មេសាង ខេត្ត ព្រៃវែង គឺជា ម្ចាស់ ជយលាភី លេខ ១ ពានរង្វាន់ ព្រះភិរម្យ ភាសា អ៊ូ ហៅ ង៉ុយ ផ្នែក ស្មូត្រ កំណាព្យ ដែល រៀបចំ ដោយ ក្រសួង អប់រំ យុវជន និង កីឡា នៅក្នុង ឆ្នាំ ២០១៨ ។
ម្ចាស់ ជយលាភី ស្មូត្រ កំណាព្យ លេខ ១រូប នេះ នៅក្នុង ពិធី អបអរសាទរ ទិវា « គ្រូបង្រៀន ៥ តុលា » នៅ ព្រឹក ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ ត្រូវបាន អនុញ្ញាតឲ្យ មក បង្ហើ សំនៀង ដ៏ ក្រ អួន ក្រអៅ របស់ ខ្លួន នៅ ចំពោះ មុខ នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន និង មន្ត្រី ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល កម្ពុជា ព្រមទាំង លោកគ្រូ អ្នកគ្រូ ដែល ចូលរួម ក្នុង កម្មវិធី ជាច្រើន រូប ផ្សេង ទៀត ។
កំណាព្យ ដែល អ្នកគ្រូ ស្មូ ត្រ នា ព្រឹក មិញ នេះ ត្រូវបាន តែង និពន្ធ ដោយ លោកគ្រូ ស៊ុយ វ៉ាន់ សាក់ មកពី ខេត្ត កំពង់ធំ ម្ចាស់ ជយលាភី លេខ ១ ពានរង្វាន់ សម្តេច ព្រះសង្ឃរាជ ជួន ណាត ផ្នែក តែង និពន្ធ ។ កំណាព្យ របស់ លោកគ្រូ បាន រៀបរាប់ ពី គុណ បំណាច់ និង ការធ្វើ ពលីកម្ម របស់ គ្រូបង្រៀន ក្នុង ការផ្តល់ ចំណេះដឹង ដល់ កុលបុត្រ កុល ធីតា របស់ ខ្មែរ ។
ឥឡូវ សូម មក ស្តាប់ នូវ សំនៀង របស់ អ្នកគ្រូ យ ន ដានី ថា ពិរោះ កម្រិត ណា ទើប ធ្វើឲ្យ នាយក រដ្ឋមន្ត្រី និង អ្នកចូលរួម ក្នុង កម្មវិធី ស្លុង អារម្មណ៍ ស្ទើរ គ្រប់ ៗ គ្នា៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៥ ខែតុលា នេះ លទ្ធផល៖ បង្ក្រាប ១២ករណី ឃាត់ខ្លួន ២៨ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
១៖ ករណី ជួញដូរ គ្រឿងញៀន ៨ករណី ឃាត់ខ្លួន ១៥នាក់ ( ស្រី ម្នាក់ ) ។ ២៖ ករណី ប្រើប្រាស់ គ្រឿងញៀន ៤ករណី ឃាត់ខ្លួន ១៣នាក់ ( ស្រី ម្នាក់ )៕ មន្រ្តី កាំ កុងត្រូល ខេត្ត ព្រះវិហារ អំពាវនាវ ដល់ អាជីវករ មិន ត្រូវ លក់ ទំនិញ ខូច គុណភាព បន្ទាប់ពី រកឃើញ ទំនិញ ផុត កាលបរិច្ឆេទ ប្រើប្រាស់ នៅ ផ្សារ រវៀង
( ព្រះវិហារ ) ៖ ទំនិញ មួយចំនួន ដែល អាជីវករ តាំង លក់ ក្នុង ផ្សារ រវៀង ក្នុង ស្រុក រវៀង ខេត្ត ព្រះវិហារ ត្រូវបាន មន្ត្រី កាំ កុងត្រូល ដកហូត និង យក ទៅ ដុត កម្ទេចចោល ក្រោយ ត្រួតពិនិត្យ ឃើញ ថា ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ ដើម្បី ចៀសវាង ការប៉ះពាល់ ដល់ សុខភាព ប្រជាពលរដ្ឋ ។
លោក ដួង មុនី ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន ថ្លែង ថា នៅ ថ្ងៃទី ០៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ មន្ត្រី កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម ខេត្ត និង អាជ្ញាធរ មូលដ្ឋាន បាន ចុះ ត្រួតពិនិត្យ ទំនិញ ប្រភេទ វេចខ្ចប់ ស្រាប់ ក៏ ដូចជា មុខ ទំនិញ ផ្សេង ៗ ទៀត ក្នុង ផ្សារ រវៀង ស្ថិត ក្នុង ឃុំ របៀប ស្រុក រវៀង ខេត្ត ព្រះវិហារ ។
លោក បន្ត ថា ការត្រួតពិនិត្យ បាន រកឃើញ ទំនិញ មួយចំនួន ហួស កាលបរិច្ឆេទ ប្រើប្រាស់ រួម មាន៖ ទឹកក្រូច ចម្រុះ ៣២. ៣៦លីត្រ . ទឹក ស៉ីរ៉ូ ចំណុះ ៦. ០៨លីត្រ . ទឹក ផ្លែឈើ ចំណុះ ៧.២លីត្រ . ទឹក ម្ទេស ទម្ងន់ ៤គីឡូក្រាម . និង ម្សៅ ទឹកដោះគោ ទម្ងន់ ៣.២គីឡូក្រាម ផងដែរ ។ លោក ថា ក្រោយ ដកហូត ទំនិញ ទាំងនោះ ត្រូវបាន យក ទៅ ដុត កម្ទេចចោល ភ្លាម ។
ជាមួយគ្នា នោះ លោក ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ព្រះវិហារ បាន អំពាវនាវ អាជីវករ ត្រូវ ត្រួតពិនិត្យ ឲ្យបាន ច្បាស់លាស់ រាល់ ប្រភេទ ទំនិញ ផ្សេង ៗ ដែល បាន ទិញ មក ដាក់ លក់ នៅ តាម តូប របស់ ខ្លួន ។ លោក ថា ចៀសវាង លក់ ទំនិញ ណា ដែល ខូច គុណភាព ឫ ក៏ ទំនិញ ណា ដែល មាន កាលបរិច្ឆេទ ជិត ផុត សុពលភាព ៕
រដ្ឋបាល រាជធានី ភ្នំពេញ អំពាវនាវ ពលរដ្ឋ ទុកដាក់ សំរាម ឲ្យ មាន សណ្ដាប់ធ្នាប់ ខណៈ សេវា ប្រមូល សំរាម ក្រុមហ៊ុន ស៊ីន ទ្រី ឈប់ សម្រាក ៤ ថ្ងៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នា រសៀល ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០១៨ នេះ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ សូម រក្សាទុកដាក់ សំរាម ឲ្យ មាន សណ្ដាប់ធ្នាប់ និង ត្រឹមត្រូវ ខណៈ កម្មករ ផ្តល់ សេវា ប្រមូល សំរាម របស់ ក្រុមហ៊ុន ស៊ីន ទ្រី ត្រូវបាន អនុញ្ញាតឲ្យ ឈប់ សម្រាក រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៨ - ១១ ខែតុលា ឆ្នាំ ២០១៨ នេះ នា ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ប្រពៃណី ជាតិ ខ្មែរ ។
