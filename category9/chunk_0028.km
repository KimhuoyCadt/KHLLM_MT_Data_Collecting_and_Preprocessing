( ភ្នំពេញ ) ៖ លោក ស្យុង ប៉រ ឯក អគ្គ រដ្ឋទូត វិសាមញ្ញ និង ពេញ សមត្ថភាព នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា ដែល ចប់ អាណត្តិ បាន លើកឡើង ថា ប្រទេស កម្ពុជា មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ទាំង ជីវភាព រស់ នៅ របស់ ប្រជាជន កិត្យានុភាព កម្ពុជា នៅក្នុង តំបន់ ក៏ ដូចជា នៅលើ សកលលោក ផងដែរ ។
ការលើកឡើង របស់ លោក ស្យុង ប៉រ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ នៅក្នុង ឱកាស ដែល លោក ត្រូវបាន សម្ដេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា អនុញ្ញាតឱ្យ ចូល ជួប សម្តែង ការគួរសម និង ជម្រាប លា នៅ វិមាន រដ្ឋសភា ។
អគ្គ រដ្ឋទូត ចិន ជិត ផុត អាណត្តិ រូប នេះ បាន បញ្ជាក់ ថា លោក សង្ឃឹម ថា កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នឹង បន្ត អភិវឌ្ឍ រីកចម្រើន បន្ថែម ទៀត លើ គ្រប់ វិស័យ ទាំងអស់ ហើយ ប្រជាជន កម្ពុជា នឹង មាន ជីវភាពកាន់ តែ ល្អ ប្រសើរ បន្ថែម ទៀត និង កិត្យានុភាព កម្ពុជា ហើយ កម្ពុជា នឹង ដើរ តួនាទី សំខាន់ នៅក្នុង តំបន់ ក៏ ដូចជា សកលលោក ផងដែរ » ។
លោក ស្យុង ប័រ បាន បន្ត ថា ជាមួយនឹង កិច្ចសហប្រតិបត្តិការ ផ្លូវ មួយ ខ្សែក្រវ៉ាត់ មួយ បាន ជំរុញ ឱ្យ ក្រុមហ៊ុន ចិន ជាច្រើន មកវិន យោគ នៅ កម្ពុជា ដែល បាន តភ្ជាប់ នូវ វិស័យ ជាច្រើន ដូចជា ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម របស់ កម្ពុជា មួយ ផ្នែក ធំ ផងដែរ ។ លោក ស្យុង ប័រ ក៏ បាន លើកឡើង ថា សម្តេច ប្រធាន រដ្ឋសភា កម្ពុជា គឺជា ឥស្សរជន ជាន់ ខ្ពស់ មួយ រូប របស់ កម្ពុជា ដែល កសាង នូវ ទំនាក់ទំនង រវាង កម្ពុជា និង ចិន កន្លងមក ផងដែរ ។
លោក ស្យុង ប័រ បាន បន្ថែម ទៀត ថា៖ « ប្រទេស ចិន និង កម្ពុជា មាន ទំនុកចិត្ត គ្នា ខ្ពស់ ខាង ផ្នែក នយោបាយ ក៏ ទន្ទឹមនឹង នេះ ដែរ កិច្ចសហប្រតិបត្តិការ ទាំង វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម វិនិយោគ សង្គមកិច្ច បាន ឈានដល់ កម្រិត ខ្ពស់ មួយ ដែល ទាំងនេះ បាន ផ្តល់ ផលប្រយោជន៍ យ៉ាង ច្រើន ដល់ ប្រជាជាតិ ទាំង សង្ខាង » ។
លោក ស្យុង ប័រ ក៏ បាន វាយតម្លៃ ខ្ពស់ ពី កិច្ចសហប្រតិបត្តិការ រវាង ស្ថាប័ន នីតិបញ្ញាត្តិ ប្រទេស ទាំង ពីរ រហូតមក ផង បច្ចុប្បន្ន នេះ មាន ការរីកចម្រើន យ៉ាង ខ្លាំង ផងដែរ ។
ជា ការឆ្លើយតប សម្តេច ពញា ចក្រី ហេង សំរិន កោតសរសើ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង លោក ស្យុង ប័រ ដែល បាន បំពេញ បេសកកម្ម ជា អគ្គ រដ្ឋទូត នៅ កម្ពុជា រយៈពេល មួយ អាណត្តិ ដែល បាន បន្សល់ទុក នូវ ស្នាដៃ ជាច្រើន សម្រាប់ ជា ឧត្តម ប្រយោជន៍ នៃ ប្រជាជាតិ ទាំង ពីរ ដោយ មាន ជំរុញ នូវ ការអភិវឌ្ឍ គម្រោង ជាច្រើន ឱ្យ ក្លាយទៅជា ការអនុវត្ត ជាក់ស្តែង ដែល បាន ផ្តល់ ជា ប្រយោជន៍ និង ផ្លែ ផ្កា យ៉ាង ច្រើន ។
សម្តេច ហេង សំរិន បាន មានប្រសាសន៍ បន្ត ថា កិច្ច ខិតខំ ប្រឹងប្រែង ទាំងនេះ គឺជា លទ្ធផល នៃ កិច្ចសហប្រតិបត្តិការ ភាពជាដៃគូរ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ដែល រដ្ឋាភិបាល ប្រទេស ទាំង ពីរ បាន កសាងឡើង និង ជា ការអនុវត្ត គោល នយោបាយ « ផ្លូវ មួយ ខ្សែក្រវ៉ាត់ មួយ » របស់ ប្រទេស ចិន ផងដែរ ។
សម្តេច ហេង សំរិន បាន លើកឡើង ថា ឆ្នាំ នេះ ជា ឆ្នាំ នៃ ខួប ៦០ នៃ ទំនាក់ទំនង ការទូត កម្ពុជា - ចិន ដោយ សង្កេតឃើញ ពី ទំនាក់ទំនង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ កម្ពុជា - ចិន មាន ការរីកចម្រើន យ៉ាង ខ្លាំង ជា ប្រវត្តិសាស្ត្រ ទាំង វិស័យ នយោបាយ ការទូត សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ក៏ ដូចជា វិនិយោគ នៅ កម្ពុជា - ចិន មាន ការវិវត្ត រីកចម្រើន ខ្លាំងក្លា ផងដែរ ។
សម្តេច ហេង សំរិន បាន បញ្ជាក់ ថា រដ្ឋាភិបាល ចិន តែងតែ ផ្តល់ ការគាំទ្រ ដល់ ប្រជាជន កម្ពុជា ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម លើ គ្រប់ វិស័យ ។ ទន្ទឹមនឹង នេះ ផងដែរ មហា មិត្ត ចិន តែងតែ គាំទ្រ យ៉ាង រឹងមាំ ចំពោះ អធិបតេយ្យភាព ឯករាជ្យភាព ស្ថេរភាព សន្តិសុខ និង ការអភិវឌ្ឍ របស់ កម្ពុជា ផងដែរ ៕
នាយ ឧត្តមសេនីយ៍ ហ៊ីង ប៊ុន ហៀង គោរព វិញ្ញាណក្ខន្ធ កង អង្គរក្ស ឱកាស បុណ្យ កាន់ បិណ្ឌ នៅ បញ្ជាការដ្ឋាន អង្គរក្ស
( កណ្ដាល ) ៖ ស្រប ពេល ដែល ប្រជាពលរដ្ឋ កម្ពុជា ជា ពុទ្ធ សាសនិក ជន ចូលរួម ពិធី បុណ្យ កាន់ បិណ្ឌ និង បុណ្យ ភ្ជុំ បិណ្ឌ ជា ប្រពៃណី ជាតិ នៃ វេន ទី៤ នា ព្រឹក ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បញ្ជាការដ្ឋាន អង្គរក្ស បាន ប្រារព្វ ពិធី គោរព វិញ្ញាណក្ខន្ធ ដល់ អតីត យុទ្ធជន និង យុទ្ធ នារី នៃ បញ្ជាការដ្ឋាន អង្គរក្ស ដែល បាន ធ្វើ ពលីកម្ម និង ទទួលមរណៈភាព ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ និង ប្រជាជន នា ពេល កន្លងមក ។
ពិធី នេះ បាន ប្រារព្ធ ធ្វើឡើង ដោយ មាន វត្តមាន នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៊ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ បញ្ជាការដ្ឋាន អង្គរក្ស និង លោកស្រី ប៉ែន ចន្នី រួម ជាមួយ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ព្រមទាំង ក្រុមគ្រួសារ ក្នុង បញ្ជាការដ្ឋាន អង្គរក្ស ជាច្រើន រូប ទៀត ។
បញ្ជាការដ្ឋាន អង្គរក្ស ជា អង្គភាព ស្នូល មួយ របស់ កងយោធពល ខេមរភូមិន្ទ ដែល កន្លងមក បាន ចូ រួម បំពេញ តួនាទី ភារកិច្ច យ៉ាង សកម្ម ក្នុង កិច្ចការពារ ជាតិ មាតុភូមិ ការពារ ប្រជាជន ការកសាង និង អភិវឌ្ឍន៍ ជាតិ ជាពិសេស ការការពារ សន្តិសុខ សុវត្ថិភាព ថ្នាក់ដឹកនាំ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ព្រមទាំង ក្រុមគ្រួសារ និង ការចូលរួម ការងារ សង្គមកិច្ច ជាច្រើន ទៀត ។
នាយ ឧត្តមសេនីយ៍ ហ៊ីង ប៊ុន ហៀង បាន ថ្លែង ថា ជារៀងរាល់ ឆ្នាំ បញ្ជាការដ្ឋាន អង្គរក្ស តែង បាន រៀបចំ នូវ ពិធី នេះ ឡើង នៅក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ និង បុណ្យ ភ្ជុំ បិណ្ឌ ក្នុង គោលបំណង ដើម្បី ឧទ្ទិស កុសល ផល បុណ្យ ជូន ដល់ បុព្វការី ជន មាន ជីដូន ជីតា មាតា បិតា គ្រូ ឧប្បជា យាចារ្យ និង ញាត្តិការ ទាំង ៧សណ្តាន ជាពិសេស ជូន នាយ ទាហាន និង ពល ទាហាន ដែល បាន បូជា សាច់ ស្រស់ ឈាម ស្រស់ នៅក្នុង បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ ហើយ បាន មក ទទួល នូវ មនុញ ផល និង បាន សោយ សុខ ក្នុង ឋាន សុគតិភព ។
រយៈពេល ១ ថ្ងៃ មក នេះ មាន ប្រជាពលរដ្ឋ ខ្មែរ ជាច្រើន បាន ទៅ ទទួល សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង គណៈប្រតិភូ ជាន់ ខ្ពស់ កម្ពុជា ដែល អញ្ជើញ ចូលរួម កិច្ចប្រជុំ អង្គការ សហ ប្រជាជាតិ នៅ ទីក្រុង ញូវយ៉ក សហរដ្ឋ អាមេរិក ។
បងប្អូន ប្រជាពលរដ្ឋ ទាំងនោះ បាន លើកឡើង ថា ការដឹកនាំ តែង មាន ចំណុច វិជ្ជមាន ខ្លះ និង អវិជ្ជមាន ខ្លះ ប៉ុន្តែ សំខាន់ ឱ្យ តែ ចំណុច វិជ្ជមាន នោះ មាន ច្រើន លើសលប់ ជាង ផល អវិជ្ជមាន ដោយសារតែ នៅលើ លោក នេះ មិន មាន មេដឹកនាំ ណាល្អ ឥត ខ្ចោះ នោះ ទេ ។
បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ដែល ទៅ ទទួលស្វាគមន៍ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ទៀត ថា គ្រប់ គ្នា មាន សិទ្ធិ សេរីភាព ក្នុង ការបញ្ចេញមតិ ក៏ប៉ុន្តែ អត់ មាន សិទ្ធិ ណាមួយ ដែល បងប្អូន បញ្ចេញមតិ ក្នុង ការជេរប្រមាថ អ្នកដទៃ ដែល គេ ខុសពី បងប្អូន ទេ ។
ពួកគាត់ លើកឡើង ថា « អញ្ចឹង ខ្ញុំ សូម សំណូមពរ ខ្មែរ ហើយ ដើម្បី តម្កើង នូវ វប្បធម៌ ខ្មែរ ដ៏ រុងរឿង ពីដើម មក ដែល មាន ក្រមសីលធម៌ សូម បងប្អូន រិះគន់ ដើម្បី ស្ថាបនា ក្នុង ន័យ ក្រមសីលធម៌ ចៀសវាង ឲ្យបាន ក្នុង ការជេរប្រមាថ បន្ទាប បន្ថោក វប្បធម៌ ខ្មែរ យើង បង ក៏ ខ្មែរ គាត់ ក៏ ខ្មែរ ដែរ ហើយ យើង ជេរ ប្រមាថ គ្នា ដោយសារ និន្នាការ ខុសគ្នា ដោយ អសុរស បំផុត សូម មេត្តា សូម អង្វរ បងប្អូន ទាំងអស់ គ្នា សូម បញ្ឈប់ ទៅ »៕
ប្រកាស តែងតាំង អភិបាល រង ខេត្ត បន្ទាយមានជ័យ . លោក ប៉ាវ ហម ផាន ផ្ដាំផ្ញើ មន្រ្តី ថ្មី ត្រូវ ប្រកាន់ខ្ជាប់ សាមគ្គីភាព ផ្ទៃក្នុង និង ខិតខំ ប្រឹងប្រែង ចូលរួម ក្នុង ដំណើរការអភិវឌ្ឍន៍ ខេត្ត ឲ្យ មាន ការរីកចម្រើន
( បន្ទាយមានជ័យ )៖ លោក ប៉ាវ ហម ផាន រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ តំណាង សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨
បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង អភិបាល រង ខេត្ត មួយ រូប នៅ សាល ប្រជុំ ថ្មី សាលា ខេត្ត បន្ទាយមានជ័យ ។ លោកស្រី រស់ សុផានី ឋានន្តរស័ក្តិ គ្រូបង្រៀន កម្រិត ឧត្តម ដើម ខ្សែ ថ្នាក់ លេខ ២ នៃ ក្របខ័ណ្ឌ គ្រូបង្រៀន កម្រិត ឧត្តម ក្រសួង អប់រំ យុវជន និង កីឡា ត្រូវបាន ប្រកាស ឲ្យ កាន់ មុខតំណែង ជា អភិបាល រង នៃ គណៈអភិបាល ខេត្ត បន្ទាយមានជ័យ ។
ទន្ទឹម នេះ លោក ក៏ បាន ថ្លែង នូវ ការអបអរសាទរ និង បាន ផ្ដាំផ្ញើ ចំពោះ លោក អភិបាល រង ខេត្ត ដែល ទើប ទទួល ការតែងតាំង មុខ តំណែង ថ្មី ត្រូវ ប្រកាន់ខ្ជាប់ នូវ សាមគ្គីភាព ផ្ទៃក្នុង និង ត្រូវ ខិតខំ ប្រឹងប្រែង សហការ ចូលរួម ក្នុង ដំណើរការអភិវឌ្ឍន៍ ខេត្ត ឲ្យ មាន ការរីកចម្រើន ធ្វើឲ្យ ប្រជាពលរដ្ឋ កាន់តែ មាន ជីវភាព ធូរធា ប្រកបដោយ សេចក្ដីសុខ សាន្ដ បន្ថែម ទៀត ។
បើ តាម កញ្ញា កាណុផន ដំរង់ គុល ប្រធាន នាយកដ្ឋាន ពិព័រណ៍ ថៃ នៃ ទីភ្នាក់ងារ ការិយាល័យ សន្និបាត និង ពិព័រណ៍ ថៃ បាន ថ្លែង នៅក្នុង សន្និសីទ មួយ នៅ ភ្នំពេញ នា ថ្ងៃទី ២៧ ខែកញ្ញា ម្សិលមិញ ថា ប្រទេស ថៃ បាន ឃើញ ថា កម្ពុជា កំពុង មាន សក្ដានុពល ក្នុង ការបង្ហាញ នូវ ផលិតផល និង ទំនិញ ដែល ខ្លួន បាន ផលិត ទៅកាន់ ទីផ្សារ អន្តរជាតិ ជាពិសេស ទីផ្សារ អាស៊ាន ដូចនេះ ហើយ ទើប ចង់ឱ្យ ពាណិជ្ជករ កម្ពុជា ចូលរួម បង្ហាញ នូវ ទំនិញ របស់ ខ្លួន ក្នុង ព្រឹត្តិការណ៍ ពាណិជ្ជកម្ម ថៃ ឱ្យ បាន ច្រើន ។
កញ្ញា កាណុផន ដំរង់ គុល បាន ថ្លែង យ៉ាង ដូច្នេះ៖ « ក្នុង រយៈពេល ប្រមាណ ៥ ឆ្នាំ ចុងក្រោយ នេះ ដែល យើង បាន រៀបចំ ព្រឹត្តិការណ៍ ពាណិជ្ជកម្ម ក្នុង ប្រទេស ថៃ យើង ឃើញ ថា កំណើន អ្នកទស្សនា និង អ្នកចូលរួម បង្ហាញ ផលិតផល ពី កម្ពុជា មាន កំនើន ជាលំដាប់ ។ ជាក់ ស្ដេង ក្នុង ឆ្នាំ ២០១៣ ពី កម្ពុជា មាន ចំនួន ៣៣០ នាក់ តែ ដល់ ឆ្នាំ ២០១៧ មាន អ្នកចូលរួម ពី កម្ពុជា រហូតដល់ ១. ៩៤០ នាក់ មាន កំណើន ជាង ២៧៤ ភាគរយ » ។
លោក ថា៖ « សព្វ ថ្ងៃ នេះ យើង មាន ជើង ហើរ ត្រង់ ពី អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ទៅ បាងកក ចំនួន ៦ជើង ក្នុង មួយ ថ្ងៃ និង ពី អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប ទៅ បាងកក ៥ជើង ក្នុង មួយ ថ្ងៃ » ។
គួរ បញ្ជាក់ ថា ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា តែងតែ ជំរុញ ឱ្យ ពាណិជ្ជករ និង ផលិត ករ កម្ពុជា ដែល ផលិត ទំនិញ បាន ស្រប តាម ស្ដង់ដារ នោះ យក ផលិតផល និង ទំនិញ ទាំងនោះ ទៅ បង្ហាញ ក្នុង ព្រឹត្តិការណ៍ ជាតិ និង អន្តរជាតិ ដើម្បី ស្វែងរក ទីផ្សារ បន្ថែម ទៀត ក្នុង គោលដៅ ជំរុញ ដល់ ការលក់ ផលិតផល ខ្មែរ ទៅកាន់ ទីផ្សារ អន្តរជាតិ កាន់តែ ច្រើន ។
សម្ដេច ក្រឡាហោម ស ខេង តែងតាំង នាយក នាយក រង ខុទ្ទកាល័យ ទីប្រឹក្សា និង ជំនួយការសរុប ២០ នាក់ . នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ ជា នាយក ខុទ្ទកាល័យ
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ចេញ ប្រកាស តែងតាំង នាយក នាយ រង ខុទ្ទកាល័យ ទីប្រឹក្សា និង ជំនួយការ សរុប ចំនួន ២០ នាក់ ។
តាម សេចក្ដីប្រកាស ដែល អង្គភាព Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃ នេះ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត ខៀវ សុភ័គ ជា នាយក ខុទ្ទកាល័យ បន្ថែម លើ មុខងារ បច្ចុប្បន្ន ដែល អម ដោយ នាយក រង ចំនួន ៨នាក់ . ទីប្រឹក្សា បច្ចេកទេស ចំនួន ២នាក់ . ជំនួយការ៨នាក់ និង អនុព័ន្ធ សារព័ត៌មាន ម្នាក់ ។
សូម អាន ខ្លឹមសារ លម្អិត នៃ សេចក្ដីប្រកាស ដែល មាន នៅ ខាងក្រោម នេះ៖ មហា យក្ស ចិន ណែនាំឲ្យ គ្រប់ គ្នា « កុំ លូកលាន់ កិច្ច ផ្ទៃក្នុង មីយ៉ាន់ម៉ា » ជាពិសេស បញ្ហា ជនជាតិ រ៉ូហ៊ីងយ៉ា !
ការលើកឡើង បែប នេះ របស់ លោក វ៉ាង យី មិន មាន អ្វី គួរឱ្យ ភ្ញាក់ ឡើយ ពីព្រោះ ចិន គឺជា សម្ព័ន្ធមិត្ត ដ៏ ជិតស្និទ្ធ នឹង ចិន ហើយ ទីក្រុង ប៉េកាំង ក៏ ធ្លាប់ បាន បោះឆ្នោត វ៉េតូ ជាច្រើន លើក ប្រឆាំង នឹង សេចក្ដីថ្លែងការណ៍ UN ថ្កោល ទោស មីយ៉ាន់ម៉ា ផងដែរ ។
លោក វ៉ាង យី នៅក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ ដោយ ក្រសួង ការបរទេស ចិន នៅ ថ្ងៃសុក្រ នេះ បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « វិបត្តិ នៅក្នុង រដ្ឋ រ៉ាឃីន (Rakhine) គឺជា បញ្ហា ដ៏ សំខាន់ មួយ រវាង មីយ៉ាន់ម៉ា និង បង់ ក្លាដែស ... ដូច្នេះ ចិន មិន គាំទ្រ ឡើយ ចំពោះ ការយក សំណុំរឿង នេះ ឱ្យ អន្តរជាតិ ជួយ ដោះស្រាយ ព្រមទាំង សកម្មភាព ទាំងឡាយ ណា ដែល បង្កឱ្យ ស្ថានការណ៍ កាន់តែ ស្មុគស្មាញ រីឯ សហគមន៍ អន្តរជាតិ គួរតែ ដើរ តួនាទី ប្រកបដោយ លក្ខណៈ ស្ថាបនា » ។
( កំពង់ធំ )៖ និស្សិត ជា នាយ ទាហាន នៅ មហាវិទ្យាល័យ បញ្ជាការ សេនាធិការ ជំនាន់ ទី ១៧ នៃ សកលវិទ្យាល័យ ការពារ ជាតិ ជិត ១០០ នាក់ បញ្ជាការ សេនាធិការ ជំនាន់ ទី ១៧ បាន មក បំពេញ កម្មសិក្សា នៅ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ដើម្បី សិក្សា ស្វែងយល់ បន្ថែម លើ កិច្ចការ និង តួនាទី ជា នាយ ទាហាន របស់ ខ្លួន នា ថ្ងៃទី ២៧ ខែកញ្ញា ឆ្នាំ ២០១៨ ម្សិលមិញ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន ជា មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ បាន លើកឡើង នូវ បទពិសោធន៍ នៃ ការដឹកនាំ បញ្ជា ក្នុង រយៈពេល ដែល លោក កាន់ តំណែង ជា មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ជូន ដល់ សិស្ស និស្សិត មហាវិទ្យាល័យ បញ្ជាការ សេនាធិការ ជំនាន់ ទី ១៧ នៃ សកលវិទ្យាល័យ ការពារ ជាតិ ដែល អញ្ជើញ មក បំពេញ កម្មសិក្សា នៅ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ ។
លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន បាន បាន ឡើង ធ្វើ បទ ឧទ្ទេសនាម និង ធ្វើ ការរៀបរាប់ អំពី ជីវប្រវត្តិ របស់ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ រួម មាន ប្រវត្តិ យោធា ខេត្ត កំពង់ធំ . ឆាក ប្រយុទ្ធ របស់ យោធា ខេត្ត កំពង់ធំ . យុទ្ទសាស្រ្ត ធ្វើ សង្គ្រាម ជាមួយ ខ្មាំង . ឆាក ប្រយុទ្ធ របស់ ថ្នាក់ដឹកនាំ នៃ បញ្ជាការ យោធា ខេត្ត កំពង់ធំ តាំងពី ដើម រហូតដល់ បច្ចុប្បន្ន ។
ក្រុម និស្សិត មហាវិទ្យាល័យ បញ្ជាការ សេនាធិការ ជំនាន់ ទី ១៧ នៃ សកលវិទ្យាល័យ ការពារ ជាតិ ទាំងអស់ បាន យកចិត្តទុកដាក់ ស្តាប់ និង ប្តេជ្ញា យក ចំណេះដឹង ទាំងអស់ មក អនុវត្តន៍ ដើម្បីឱ្យ មាន ប្រសិទ្ធភាព ក្នុង ការចូលរួមចំណែក ធ្វើឱ្យ ប្រទេសជាតិ មាន សន្តិភាព រួម នឹង ការអភិវឌ្ឍ បន្ត ទៅ មុខ បន្ថែម ទៀត ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ប្រកបដោយ គតិបណ្ឌិត ឈ្លាសវៃ ក្នុង ការដឹកនាំ នាវា កម្ពុជា ឱ្យ មាន ឈ្មោះ បោះ សំឡេង នៅលើ ឆាក អន្តរជាតិ ៕
គ.ជ. ប ប្រកាស ការដាក់ និង ទទួល ពាក្យ សុំ ចុះឈ្មោះ អ្នកសង្កេតការណ៍ ជាតិ អន្តរជាតិ ភ្នាក់ងារ គណបក្ស នយោបាយ សម្រាប់ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨
គ.ជ. ប សង្ឃឹម ថា សមាគម អង្គការ មិន មែន រដ្ឋាភិបាល ជាតិ អន្តរជាតិ គណបក្ស នយោបាយ ក បឃ .ស និង លេខាធិការដ្ឋាន រាជធានី - ខេត្ត រៀបចំ ការបោះឆ្នោត ( លធ. ខប ) នឹង យកចិត្តទុកដាក់ សហការ គ្នា ល្អ ដើម្បី ជំរុញ ឱ្យ ពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០១៨ ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន ខ្លឹមសារ ទាំងស្រុង នៃ សេចក្តីប្រកាស ព័ត៌មាន របស់ គ.ជ. ប ដូច ខាងក្រោម៖
លោក អធិការ ខណ្ឌ រូប នេះ បាន ឲ្យដឹង ផងដែរ ថា បច្ចុប្បន្ន ជនសង្ស័យ ជា ចោរ ឆក់ ទាំង២នាក់ ជាមួយ វត្ថុតាង បាន និង កំពុង ស្ថិត នៅក្រោម ការសាកសួយ ក ចម្លើយ នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ឬស្សីកែវ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ខ្លួន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ក្នុង ការអនុវត្ត តាម និតិវិធី ៕
នា ឱកាស នោះ លោកស្រី Peng បាន បន្ត ទៀត ថា អង្គការ សុខភាព ពិភពលោក បាន អនុម័ត នូវ « យុទ្ធសាស្ត្រ ទប់ទល់ ជំងឺ របេង » រួច ជាស្រេច ហើយ គ្រប់ ប្រទេស ទាំងអស់ គួរ ចាប់ ដៃ ជាមួយគ្នា និង ខិតខំ យ៉ាង ពេញ ទំហឹង ដើម្បី ផ្លាស់ប្តូរ ជីវិត របស់ អ្នក ដែល រង ផល ប៉ះពាល់ ពី ជំងឺ របេង ចំនួន រាប់ រយ លាន នាក់ និង ដើម្បី បញ្ឈប់ ការរីករាលដាល នៃ ជំងឺ នេះ ៕ ប្រមុខរដ្ឋ ស្តីទី ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង ទីប្រឹក្សា និង ជំនួយការ សម្តេច ហេង សំរិន ចំនួន ៤៦ នាក់
បើ តាម ព្រះរាជ ក្រឹត្យ ដែល ចេញ ដោយ សម្តេច សាយ ឈុំ ទីប្រឹក្សា និង ជំនួការ របស់ សម្តេច ហេង សំរិន ទាំង ៤៦ នាក់ មាន ឋានៈ ស្មើ រដ្ឋមន្ត្រី រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ និង អគ្គ នាយក ៕
ព័ត៌មាន លម្អិត សូម អាន ខ្លឹមសារ ក្នុង ព្រះរាជ ក្រឹត្យ ខាងក្រោម នេះ៖
អ្នកផលិត និង អាជីវករ លក់ បារី ក្លែងក្លាយ ទាំងអស់ នឹង ត្រូវ ប្រឈម ចំពោះ មុខ ច្បាប់
( ភ្នំពេញ ) ៖ ក្រោយពី ការចុះបង្ក្រាប របស់ អាជ្ញាធរ ពាក់ព័ន្ធ ទៅ លើ អាជីវករ លក់ ដុំ លក់ រាយ បារី ក្លែងក្លាយ នៅ ទីតាំង ផ្សារ ធំ ថ្មី ផ្សារ កណ្ដាល រោងចក្រ ផលិត បារី ក្លែងក្លាយ ក្នុង សង្កាត់ គោក ឃ្លាង និង ក្នុង ក្រុង តាខ្មៅ ដែល មាន ម្ចាស់ ជា ជនជាតិ ចិន កាលពី ថ្មី ៗ កន្លងទៅ គេ សង្កេតឃើញ ការតាំង លក់ បារី ក្លែងក្លាយ ពីសំណាក់ អាជីវករ មាន ការធ្លាក់ចុះ គួរឲ្យ កត់សម្គាល់ ។ តែ ទោះជា យ៉ាង នេះ ក្ដី បារី ក្លែងក្លាយ គឺ នៅតែ ជា បញ្ហា ចោទ និង កំពុង វាយលុក ទីផ្សារ បារី កម្ពុជា ដដែល ។
លោក បន្ដ « យើង នឹង សហការ ធ្វើ ការចុះបង្ក្រាប ទាំង រោងចក្រ ផលិត និង អ្នកលក់ ដុំ អ្នកលក់ រាយ ទាំងអស់ នៅ ទូទាំង ប្រទេស ចំពោះ ការផលិត និង តាំង លក់ បារី ក្លែងក្លាយ ។ លោក បញ្ជាក់ ទៀត ថា ក្រោម ប្រតិបត្តិការ ចុះបង្ក្រាប បារី ក្លែងក្លាយ នា ត្រី មាស ចុងក្រោយ នេះ អាជ្ញា ដកហូត បារី ៥៥៥ ក្លែងក្លាយ ពី អាជីវករ ផ្សារ ធំ ថ្មី និង ផ្សារ កណ្ដាល ជាង ១.០០០ សុង ដែល នឹង ត្រូវ កម្ទេចចោល ក្នុង ពេល ឆាប់ ៗ បើ អាជ្ញាធរ រកឃើញ ថា ពិតជា ក្លែងក្លាយ ប្រាកដ មែន ។
ហេតុការណ៍ ខាង លើ បាន បណ្តាលឲ្យ អាកាសយានិក យន្តហោះ ចំនួន ០២ នាក់ បាត់បង់ជីវិត ខណៈ យោង តាម ការបញ្ជាក់ ពី អាជ្ញាធរ អាមេរិក មាន មនុស្ស ទាំងអស់ ០៤ នាក់ នៅលើ យន្តហោះ នោះ ។
បន្ថែម ពី នេះ ក្នុង ចំណោម ពី ឡុត ទាំង ពីរ នាក់ ម្នាក់ បាន ស្លាប់ នៅ ហ្នឹង កន្លែង ខណៈ ម្នាក់ ទៀត បាន ស្លាប់ នៅឯ មន្ទីរពេទ្យ ។ ចំណែក អ្នកដំណើរ ចំនួន ពីរ នាក់ វិញ គឺជា គូ ស្វាមី ភរិយា បាន រងរបួស ធ្ងន់ និង ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ដើម្បី សង្រ្គោះ បន្ទាន់ ។
គួរ ជម្រាប ថា បើ តាម សេចក្តីរាយការណ៍ ព័ត៌មាន ក្នុង ស្រុក អាមេរិក ហេតុការណ៍ ខាង លើ នេះ បង្កឡើង ដោយសារតែ យន្តហោះ នោះ ធ្វើ ការចុះចត ហួស ធ្លាក់ ចេញ ពី ផ្លូវ ៕
( ចិន ) ៖ ចំការសារី មួយ កន្លែង នៅ ខេត្ត សាន ស៊ី ប៉ែក ខាងជើង ប្រទេស ចិន គឺជា កសិដ្ឋាន ធំ បំផុត ដែល ដាំ ផ្លែ សារី ក្រអូប យូលូ នៅក្នុង ប្រទេស ចិន ។ កសិករ នៅ ទីនេះ បាន បង្កើត វិធី ថ្មី ៗ សម្រាប់ បង្កើត ទីផ្សារ លក់ ផ្លែ ឈើ របស់ ពួកគាត់ ដើម្បី អាច លក់ វា បាន កាន់តែ ច្រើន នៅ ទូទាំង ប្រទេស ចិន ទាំងមូល តែម្តង ។
ដោយសារ មាន បច្ចេកវិទ្យា ថ្មី និង វិធី បង្កើត ទីផ្សារ តាម ប្រព័ន្ធ លក់ ទំនិញ តាម អ៊ីនធើណេត តម្លៃ ផ្លែ សារី ដែល ដាំ នៅ ទីនេះ បាន ឡើង ថ្លៃ ជាង មុន ពី ៣ទៅ ៤ដង បើ ធៀប នឹង ពីរ បី សប្តាហ៍ មុន នៅ ពេល ដែល ពិធី បុណ្យ សែន ព្រះខែ បាន ខិត ចូល មកដល់ កាលពី ថ្ងៃច័ន្ទ កន្លងទៅ ។
តំបន់ ស៊ី សៀន នៃ ខេត្ត សាន ស៊ី ជា ទីតាំង ដ៏ អំណោយផល សម្រាប់ ដាំ ផ្លែ សារី ដោយសារ វា មាន ពន្លឺ ព្រះអាទិត្យ គ្រប់គ្រាន់ និង មាន សីតុណ្ហភាព ដែល ឡើង ចុះ ខ្លាំង បើ ធៀប រវាង ពេល ថ្ងៃ និង ពេល យប់ គួបផ្សំ នឹង ដី ដែល សំបូរ ទៅ ដោយ សារធាតុ សរីរាង្គ ។
ប៉ុន្តែ តំបន់ នេះ ឧស្សាហ៍ ជួប បញ្ហា រាំងស្ងួត និង ព្យុះ ទឹកកក ណាស់ ជា ហេតុ នាំឱ្យ កសិករ នៅ ទីនេះ ត្រូវ ប្រើ ឧបករណ៍ រក្សា សីតុណ្ហភាព ខ្នាត តូច ជាច្រើន ដើម្បី តាមដាន អាកាសធាតុ និង រក្សា សីតុណ្ហភាព ទៅ តាម ការចាំបាច់ ។ ឧទាហរណ៍ គេ អាច ប្រើ ឧបករណ៍ នេះ ដើម្បី បង្កើត ទឹកភ្លៀវ សិប្បនិម្មិត បាន ។
គេ ល្បី ថា សារី ដែល ដាំ នៅ ទីនេះ មាន រូបរាង ល្អ និង រសជាតិ ឆ្ងាញ់ ហើយ វា កាន់តែ ល្បីល្បាញ នា ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ដោយសារតែ មាន គេ ផ្សព្វផ្សាយ វា តាម បណ្តាញ លក់ ទំនិញ តាម អនឡាញ ។
អភិបាល ខេត្ត សៀមរាប បន្ដ ដឹកនាំ មន្ដ្រីរាជការ ចូលរួម កាន់ បិណ្ឌ វេន ទី៤ នៅ វត្ត ស្វាយ សង្កាត់ សាលា កំរើក ក្រុង សៀមរាប
( សៀមរាប ) ៖ នៅក្នុង ឱកាស បុណ្យ កាន់ បិណ្ឌ ប្រពៃណី ខ្មែរ កាន់ វេន ទី៤ ត្រូវនឹង ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ លោក បណ្ឌិត ឃឹម ប៊ុន សុង អភិបាល ខេត្ត សៀមរាប និង លោកស្រី ព្រមទាំងអស់ លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ មន្ទីរ មន្ត្រីរាជការ សាលា ខេត្ត សៀមរាប បាន អញ្ជើញ ទៅ ចូលរួម ក្នុង ពិធី កាន់ ជាមួយ បងប្អូន ពុទ្ធ បរិស័ទ នៅ វត្ត ស្វាយ សង្កាត់ សាលា កំរើក ក្រុង សៀមរាប ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឃឹម ប៊ុន សុង បាន លើកឡើង ថា ការប្រារព្ធ ធ្វើ ពិធី បុណ្យ ភ្ជំបិណ្ឌ នេះ ឡើង ក្នុង គោលបំណង ដើម្បី ឧទ្ទិស មហា កុសល ជូន ដល់ លោក អ្នក មាន គុណ មាន មាតាបិតា ជីដូន ជីតា ញាតិកាល ទាំង ៧សណ្តាន ដែល បាន បាក់បែក ចែក ឋាន ទៅកាន់ បរលោក ទៅ ហើយ នោះ និង ជួយ រំដោះ ឲ្យ រួច ចាក ផុត ពី ទុក្ខ ទោស ទាំងឡាយ ឧបាយ ភូមិ ណាមួយ និង ឲ្យបាន ទៅកាន់ សុគតិភព ថ្មី ហើយ ងាក ក្រោយមក ជួយ បីបាច់ ថែរក្សា កូន ចៅ ឲ្យ មាន សេចក្តីសុខ សប្បាយ ក្នុង ក្រុមគ្រួសារ សង្គមជាតិ ផងដែរ ។
ឧប នាយក រដ្ឋមន្ត្រី ម៉ែន សំអន ផ្តាំ តាម លោក ស្យុង ប៉ ថា កម្ពុជា សូម អរគុណ ចំពោះ ប្រជាជន និង រដ្ឋាភិបាល ចិន ដែល តែងតែ គាំទ្រ កម្ពុជា រហូតមក
( ភ្នំពេញ ) ៖ លោកស្រី ឧប នាយក រដ្ឋ ម៉ែន សំអន រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច តាមរយៈ លោក ស្យុង ប៉ ឯក អគ្គ រដ្ឋទូត ទើប ផុត អាណត្តិ បាន ថ្លែង ថា ក្នុង នាម សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា សូមអំណរគុណ ជូន ចំពោះ ប្រជាជន និង រដ្ឋាភិបាល ចិន ផងដែរ ដែល តែងតែ គាំទ្រ កម្ពុជា រហូតមក ។
លោកស្រី ឧប នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ដូច្នេះ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ ក្នុង ឱកាស ដែល លោក ស្យុង ប៉ ចូល ជួប សម្តែង ការគួរសម និង ជំរាប លា គ្រា លោក បាន បញ្ចប់ អាណត្តិការ ទូត របស់ ខ្លួន ប្រចាំ នៅ កម្ពុជា បន្ទាប់ពី បាន បំពេញ ការងារ អស់ រយៈពេល ពីរ ឆ្នាំ ប្រកបដោយ ភាពជោគជ័យ រួច មក ។
នៅ ក្រោយ បញ្ចប់ ជំនួប នេះ លោក ណុប ចាន់ ណារិន្ទ អ្នកនាំពាក្យ និង ជា អនុ រដ្ឋលេខាធិការ ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច បាន ឱ្យដឹង ថា តាមរយៈ នៃ ជំនួប នេះ លោក ស្យុង ប៉ ក៏ បាន ថ្លែង ថា ក្នុង រយៈពេល ២ឆ្នាំ កន្លងមក នេះ លោក បាន ធ្វើ កិច្ចការងារ ជាច្រើន ពិសេស ជួយ សម្របសម្រួល ក្នុង ដំណើរទស្សនកិច្ច លោក ប្រធានាធិបតី ចិន ស៉ី ជិន ពីង . លោក នាយក រដ្ឋមន្ត្រី ចិន លី ខឺ ឈាំង មកកាន់ កម្ពុជា ក៏ ដូចជា ដំណើរទស្សនកិច្ច របស់ សម្ដេច តេជោ ទៅកាន់ ប្រទេស ចិន ផងដែរ ។
លោក ស្យុង ប៉ បាន ថ្លែង បន្ត ថា ក្នុង អាណត្តិ របស់ លោក លោក បាន យកចិត្តទុកដាក់ ខ្លាំង នៅក្នុង ការជំរុញ កិច្ចអភិវឌ្ឍន៍ សេដ្ឋកិច្ច នយោបាយ ផ្លូវ មួយ ខ្សែក្រវ៉ាត់ មួយ និង កិច្ចសហប្រតិបត្តិការ ជាច្រើន ទៀត ដែល ក្នុង នោះ ទទួលបាន នូវ លទ្ធផល ដ៏ ត្រចះត្រចង់ ដើម្បី ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង ចិន - កម្ពុជា ដល់ ចំណុច ថ្មី មួយ ទៀត ។
សូម បញ្ជាក់ ថា លោក ស្យុង ប៉ ត្រូវបាន រដ្ឋាភិបាល ចិន ជ្រើសតាំង ឲ្យ មក បំពេញ បេសកកម្ម ការ ទូត នៅ កម្ពុជា កាលពី អំឡុង ឆ្នាំ ២០១៦ ហើយ មកដល់ ពេលនេះ មាន រយៈពេល ២ឆ្នាំ ហើយ ដែល លោក ត្រូវបាន បញ្ចប់ អណត្តិការ ទូត នេះ ។ ប៉ុន្ដែ ទោះជា យ៉ាងណា សម្រាប់ ឯក អគ្គ រដ្ឋទូត ថ្មី ដែល នឹង ត្រូវ មក បន្ដ បេសកកម្ម កាទូត នេះ ក្រសួង ការបរទេស កម្ពុជា មិន ទាន់ បាន បញ្ជាក់ នៅឡើយ ៕
លោក ពេជ្រ ស្រស់ ជួប ពិភាក្សា ជាមួយ លោក យន្ត មីន ដើម្បី សិក្សា បញ្ហា ជម្លោះ ដីធ្លី មួយ ចំនួន នៅ ខេត្ត ព្រះសីហនុ
( ភ្នំពេញ ) ៖ លោក ពេជ្រ ស្រស់ ប្រធាន គណបក្ស យុវជន កម្ពុជា និង ជា សមាជិក ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ នៅ ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ បាន ជួប ពិភាក្សា ជាមួយ លោក យន្ត មីន អភិបាល ខេត្ត ព្រះសីហនុ ដើម្បី សិក្សា បញ្ហា ជម្លោះ ដីធ្លី មួយ ចំនួន នៅ ខេត្ត ព្រះសីហនុ ។
ការជួប ពិភាក្សា នេះ បាន ធ្វើឡើង បន្ទាប់ពី លោក ពេជ្រ ស្រស់ ទទួលបាន បណ្តឹង មួយចំនួន ពី ប្រជាពលរដ្ឋ ដែល រស់ នៅ ខេត្ត នេះ ដែល ស្នើ ឱ្យ លោក ជួយ អន្តរាគមន៍ ដោះស្រាយ បញ្ហា ដីធ្លី របស់ ពួកគេ ។ បន្ទាប់ពី ជួប ពិភាក្សា នេះ លោក ពេជ្រ ស្រស់ ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ការងារ របស់ លោក អភិបាល ខេត្ត ព្រះសីហនុ ផងដែរ ។
លោក ពេជ្រ ស្រស់ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ជា ចុងក្រោយ ខ្ញុំ សូម កោតសរសើរ ចំពោះ ឯ . ឧ យន្ត មីន លោក គឺជា មន្រ្តី ចាស់ទុំ គួរឲ្យ គោរព និង សហការណ៍ យ៉ាង ល្អ ជាមួយ ខ្ញុំ ពេជ្រ ស្រស់ ដើម្បី ស្វែងរក ដំណោះស្រាយ ជូន ប្រជាពលរដ្ឋ » ។
កម្មវិធី ថ្មី នេះ បើក ឲ្យ មាន ការចុះឈ្មោះ ចាប់ពី ពេលនេះ រហូតដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៨ ក្នុង ការស្វែងរក អ្នក បង្កើត ឃ្លីប វីដេអូ ប្លែក ៗ នៅ កម្ពុជា ដែល មាន រង្វាន់ ជា ទឹកប្រាក់ ជាង ៥ម៉ឺន ដុល្លារ ដល់ អ្នក ទទួលបាន ជ័យលាភី ដោយ ឆ្លងកាត់ ការបោះឆ្នោត តាម ការផ្ញើ សារ SMS ។
ទេសរដ្ឋមន្ដ្រី ឆាយ ថន រៀបចំ ពិធី សូត្រ មន្ត ចម្រើន ព្រះបរិត្ត អគារ ទីស្តីការ ក្រសួង ផែនការ ថ្មី ដែល កំពស់ ៩ជាន់
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ដ្រី ឆាយ ថន រដ្ឋមន្ត្រី ក្រសួង ផែនការ នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្រសួង ផែនការ បាន និមន្ត ព្រះសង្ឃ មក សូត្រ មន្ត ចម្រើន ព្រះបរិត្ដ នៅ អគារ ទីស្តីការ ក្រសួង ផែនការ ថ្មី កំពស់ ៩ជាន់ ស្ថិត លើ ផ្លូវ លេខ ៣៦០ សង្កាត់ បឹងកេងកង១ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង តាម ទំនៀមទំលាប់ ប្រពៃណី ព្រះពុទ្ធ សាសនា ដើម្បី បួងសួង សុំ សេចក្តីសុខ ប្រោះ ព្រំ លើក រាសី សុំ ពរ ជ័យ សិរី សួស្តី ជ័យ មង្គល វិបុល សុខ បវរ មហារ ប្រសើរ កើតមាន ដល់ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ទាំងអស់ ក្រោម ឱវាទ នៃ ក្រសួង ផែនការ និង ជោគជ័យ គ្រប់ ភារកិច្ច ក្នុង ដំណើរការងារ កសាង ផែនការ រៀបចំ គោល នយោបាយ អភិវឌ្ឍន៍ ជាតិ ។
អ្វី ដែល គួរ កត់សម្គាល់ នោះ គឺ ថា ប្រជាជន កម្ពុជា ស្គាល់ ថា អ្វី ជា ស័ង្កសី ប៉ុន្តែ ពួកគេ មិន បាន ស្គាល់ វត្ថុធាតុ ដើម ដែល ប្រើ សម្រាប់ ផលិត ស័ង្កសី នោះ ឡើយ ។ វត្ថុធាតុ ដើម ល្អ នាំឱ្យ ផលិតផល ល្អ ដូច្នេះ ការស្គាល់ ពី វត្ថុធាតុ ដើម ច្បាស់ នឹង ជួយ ឱ្យ អ្នក អាច ជា វ ផលិតផល ស័ង្កសី ដែល មាន គុណភាព ។
( ភ្នំពេញ ) ៖ ស្រី្ត ខ្មែរ មួយ រូប ដែល ពិភពលោក បាន ស្គាល់ តាមរយៈ រូបថត បី កូន រួម ជាមួយ កូនប្រុស ស្រី ឈរ អម សង្ខាង មើល ទៅ គួរអោយ សង្វេ គ និង អាណោច អាធម ខណៈ គាត់ កំពុង រត់ គេច ពី របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ផ្សង ទៅ រក សេរីភាព នោះ ពេលនេះ គាត់ បាន ទទួលមរណភាព ហើយ ក្នុង ជន្មាយុ ៨៦ ឆ្នាំ កាលពី ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០១៨ កន្លងទៅ នេះ នៅ ពែរី ញើ ប្រទេស បារាំង នេះ បើ តាម ព័ត៌មាន ដែល គេ បង្ហោះ នៅ តាម បណ្ដាញ ទំនាក់ទំនង សង្គម ហ្វេសប៊ុក ។
បើ តាម ការផ្សព្វផ្សាយ ពី បណ្តាញ ទំនាក់ទំនង សង្គម ហ្វេសប៊ុក ដែល បាន ចែកចាយ បន្ត គ្នា នូវ រូបថត និង ព័ត៌មាន ស្ត្រី បី កូន រត់ គេច ពី សង្គ្រាម ក្នុង អំឡុង ឆ្នាំ ១៩៧៩ ក្នុង ឈុត សំលៀកបំពាក់ ពណ៌ ខ្មៅ បី កូន ក្នុង ដៃ ឈរ អម ដោយ កូនប្រុស ស្រី នៅ សង្ខាង ក្នុង ទឹកមុខ ស្លេកស្លាំង ស្គម ស្គាំង មើល ទៅ គួរឲ្យ សង្វេគ នោះ ត្រូវបាន គេ ចាប់អារម្មណ៍ ជាខ្លាំង ក្រោយពី រូបថត នេះ ត្រូវបាន គេ ផ្សព្វផ្សាយ ជាសាធារណៈ ។
នៅក្នុង របប គុក ឥត ជញ្ជាំង បន ប្រល័យ ពូជសាសន៍ ពុល ពត លោក ស្ត្រី រូប នេះ បាន ទទួលរង ទុក្ខវេទនា ដូចជា ប្រជាពលរដ្ឋ ខ្មែរ ទូទៅ ក្នុង សម័យ នោះ ដែរ ។ លុះ ដល់ ឆ្នាំ ១៩៧៩ រូប គាត់ និង កូន ៗ បាន រត់ ភៀសខ្លួន ជាមួយ ស្វាមី ទៅ រស់ នៅ ជំរុំ ព្រំដែន ថៃ បន្ទាប់មក ទើប ត្រូវបាន ជាប់ ជា ជនភៀសខ្លួន បាន ទៅ រស់ នៅ ប្រទេស បារាំង រហូត មក ដូច មាន នៅក្នុង រូបថត ស្រាប់ ( ស្លាប់ កូន ម្នាក់ ក្នុង សម័យ នោះ កូនស្រី ) ។
នាយ ឧត្តមសេនីយ៍ នេត សាវឿន ដាក់ ចេញ វិធានការ ក្ដៅ ចំនួន ៣ ឲ្យ ស្នងការ រាជធានី - ខេត្ត បង្ក្រាប គ្រឿងញៀន ក្នុង មូលដ្ឋាន ពិសេស កន្លែង កំសាន្ដ និង ផ្ទះសំណាក់
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ជា ប្រធាន លេខាធិការដ្ឋាន ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ លើក ទី៣ បាន ដាក់ចេញ នូវ វិធានការ ក្ដៅ ចំនួន ៣ ដើម្បីឲ្យ គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន រាជធានី - ខេត្ត លេខាធិការដ្ឋាន នៃ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ពិសេស ស្នងការដ្ឋាន រាជធានី - ខេត្ត ទៅ អនុវត្ត ផ្ទាល់ ដើម្បី បង្ក្រាប គ្រឿងញៀន ក្នុង មូលដ្ឋាន ពិសេស កន្លែង កំសាន្ដ និង ផ្ទះសំណាក់ ។
នេះ បើ តាម ការឲ្យដឹង ពី នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ ថ្លែង ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី ២៨ ខែកញ្ញា ឆ្នាំ ២០១៨ នេះ ក្រោយ បញ្ចប់ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ យុទ្ធ ប្រឆាំង គ្រឿងញៀន ប្រចាំ ខែ ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ។
នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ បាន បញ្ជាក់ ថា វិធានការ ទាំង ៣ចំណុច ដែល នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន ដាក់ ចេញ ក្នុង កិច្ចប្រជុំ នោះ រួម មាន៖
ទី១៖ ត្រូវ បង្កើន សកម្មភាព ក្នុង ការបង្ការ បង្ក្រាប និង ទប់ស្កាត់ បទល្មើស គ្រឿងញៀន តាមរយៈ ការជំរុញ គ្រប់ យន្ដ ការ ដែល មាន ស្រាប់ ដោយ ឲ្យ អនុវត្ត កាន់តែ សកម្ម បន្ថែម ទៀត ខណៈ ដែល កន្លងមក អនុវត្ត ទទួលបាន លទ្ធផល ក៏ ពិត មែន ប៉ុន្ដែ ត្រូវ ខិតខំ ធ្វើឲ្យ កាន់តែ ល្អ ប្រសើរ ជាង មុន ឲ្យ ស្រប ទៅនឹង កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។
ទី ២៖ ជំរុញ ឲ្យ លេខាធិការដ្ឋាន នៃ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ក៏ ដូចជា លេខាធិការដ្ឋាន នៃ គណៈកម្មាធិការ ត្រួតពិនិត្យ គ្រឿងញៀន រាជធានី - ខេត្ត ដែល មាន អភិបាល រង រាជធានី - ខេត្ត ទទួលបន្ទុក ក៏ ដូចជា ស្នងការដ្ឋាន នគរបាល រាជធានី - ខេត្ត ចូលរួម ទាំងអស់ គ្នា ក្រៅពី ការបង្ក្រាប ទប់ស្កាត់ បញ្ហា គ្រឿងញៀន នេះ គឺ ខិតខំ ធ្វើ សកម្មភាព ផ្សព្វផ្សាយ ជូន ប្រជាពលរដ្ឋ ពិសេស យុវជន ដើម្បីឲ្យ យល់ដឹង ពី ផល ប៉ះពាល់ និង គ្រោះថ្នាក់ បណ្ដាល មកពី ការប្រើប្រាស់ គ្រឿងញៀន ។
