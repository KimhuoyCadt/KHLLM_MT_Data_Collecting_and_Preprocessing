១៖ សម្រាប់ មន្ត្រី បម្រើ ការ ជួរ មុខ. មនុស្ស ចាស់ ដែល មាន អាយុ ចាប់ពី ៦០ ឆ្នាំ ឡើង និង អ្នក ដែល មាន ប្រព័ន្ធ ការពារ រាងកាយ ខ្សោយ . ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដូស ជំរុញ គួរ ធ្វើឡើង នៅ ចន្លោះ ខែ ទី៤ និង ខែ ទី៦បន្ទាប់ពី ទទួល ការចាក់ វ៉ាក់សាំង មូលដ្ឋាន បាន គ្រប់ ដូស ។ ដោយឡែក សម្រាប់ ប្រជាជន ទូទៅ ផ្សេង ទៀត ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដូស ជំរុញ គួរ ធ្វើឡើង នៅ ចន្លោះ ខែ ទី៦ និង ខែ ទី៨ បន្ទាប់ពី ទទួល ការចាក់ វ៉ាក់សាំង មូលដ្ឋាន បាន គ្រប់ ដូស ។
២៖ ចំពោះ ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដូស ជំរុញ នេះ . ទោះបី ប្រើប្រាស់ វ៉ាក់សាំង ប្រភេទ ដូចគ្នា ឬ វ៉ាក់សាំង ប្រភេទ ខុសគ្នា ក៏ដោយ មិន បង្កឱ្យ មាន ផល រំខាន ច្រើន លើស ពី ផល រំខាន ដែល បង្កឡើង ដោយ វ៉ាក់សាំង នីមួយ ៗ ជាធម្មតា នោះ ទេ ប៉ុន្តែ ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ដូស ជំរុញ នេះ ថែមទាំង អាច បង្កើន បាន នូវ ប្រព័ន្ធ ការពារ រាងកាយ កាន់តែ រឹងមាំ ក្នុង ការទប់ទល់ នឹង មេរោគ កូវីដ - ១៩ ប្រភេទ ដែល តា (Delta) និង ប្រភេទ បំប្លែង ខ្លួន ថ្មី ផ្សេង ទៀត ។
ខេត្ត ឧត្តរមានជ័យ បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ៥៧ នាក់ ទៀត និង ជាសះស្បើយ ១០២ នាក់
( ឧត្តរមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ នា ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន រកឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ៥៧ នាក់ បន្ថែម ទៀត ក្នុង នោះ ចំនួន ២២នាក់ ជា ពលករ ទើប មកពី ប្រទេស ថៃ . ២០ នាក់ ឆ្លង ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ និង ១៥នាក់ ទៀត ជា ពលករ កំពុង ធ្វើចត្តាឡី ស័ក ខណៈ អ្នក ដែល បាន ជាសះស្បើយ មាន ចំនួន ១០២ នាក់ ។
រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល មាន ការពាក់ព័ន្ធ ដោយ ផ្ទាល់ ឬ ដោយ ប្រយោល ជាមួយ បុគ្គល វិជ្ជមាន កូវីដ១៩ ទើប រកឃើញ នេះ ត្រូវ ដាក់ ខ្លួន ដាច់ដោយឡែក រយៈពេល ១៤ ថ្ងៃ ។ ក្នុង ករណី មាន រោគសញ្ញា ក្អក ផ្តាសាយ ហៀ សំបោរ ឈឺ បំពង់ ក ថប់ ដង្ហើម ក្ដៅ ខ្លួន ខ្លាំង ឬ រោគសញ្ញា សង្ស័យ ផ្សេង ៗ ទៀត ត្រូវ ទាក់ទង ក្រុមការងារ ប្រចាំ ការ និង យក សំណាក នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង មន្ទីរពេទ្យ បង្អែក អន្លង់ វែង ឬ ទំនាក់ទំនង សាកសួរ ព័ត៌មាន ផ្សេង ៗ តាមរយៈ លេខ ទូរស័ព្ទ៖ ០១២ ៤៩៩ ១៩២ ។
លោក ពូទីន បាន លើកឡើង បែប នេះ នៅក្នុង កិច្ចសន្ទនា តាម ទូរស័ព្ទ ជាមួយ ប្រធានាធិបតី ចិន លោក ស៊ី ជីន ពីង នៅ ល្ងាច ថ្ងៃពុធ នេះ ។ ទន្ទឹម នឹង នោះ ប្រធានាធិបតី រុស្ស៊ី រូប នេះ បាន និយាយ ទៀត ថា ប្រទេស របស់ លោក សង្ឃឹម ថា នឹង អាច ធ្វើការ ជាមួយ ចិន ដើម្បី បន្ត កិច្ចសហប្រតិបត្តិការ ជាក់ស្តែង ក្នុង វិស័យ ផ្សេង ៗ និង ពង្រឹង កិច្ចសហការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ រាតត្បាត ៕
ខេត្ត កំពង់ធំ ប្រកាស រកឃើញ អ្នកវិជ្ជមាន កូវីដ ១១នាក់ ជាសះស្បើយ ១នាក់ និង ស្លាប់ ១នាក់
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ធំ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការរក ឃើញ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ១១នាក់ ថ្មី បន្ថែម ទៀត តាមរយៈ ការធ្វើតេស្តរហ័ស និង ស្លាប់ ចំនួន ១នាក់ នៅ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០២១ ។ ជាមួយគ្នា នោះ ក៏ មាន អ្នក ជាសះស្បើយ ១នាក់ ទៀត ដែរ ។
ដើម្បី ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បន្ថែម ទៀត រដ្ឋបាល ខេត្ត បាន អំពាវនាវ ដល់ អ្នក ដែល ធ្លាប់ ប្រាស្រ័យទាក់ទង ជាមួយ អ្នកវិជ្ជមាន ខាងលើ សូម រួសរាន់ ទំនាក់ទំនង ទៅ អាជ្ញាធរ ឬ មណ្ឌល សុខភាព ដែល នៅ កៀក បំផុត ដើម្បី ពិនិត្យ សុខភាព និង ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ឱ្យ បាន ត្រឹមត្រូវ ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០២១
៣៖ ក្រសួង សុខាភិបាល ប្រកាស រកឃើញ មេរោគ បំប្លែង ដែល តា ឡើង ដល់ ១. ៣២៥ នាក់
៥៖ រាជ រដ្ឋាភិបាល កម្ពុជា ដាក់ ចេញ គោល នយោបាយ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ដូស ជំរុញ
៧៖ រាជ រដ្ឋាភិបាល ដាក់ ចេញ គោលការណ៍ ចំនួន ៥ សម្រាប់ ការចាក់ វ៉ាក់សាំង ដូស ជំរុញ . ចិន នៅតែ ជា បង្អែក យុទ្ធសាស្ត្រ សម្រាប់ ផ្គត់ផ្គង់ វ៉ាក់សាំង
៨៖ ឡាវ ប្រកាស រកឃើញ ករណី ឆ្លង កូវីដ១៩ ថ្មី ៗ ជិត១.០០០ នាក់ ក្នុង មួយ ថ្ងៃ
៩៖ រាជ រដ្ឋាភិបាល បញ្ជាក់ ថា ការចាក់ ដូស ជំរុញ ដោយ ប្រើ វ៉ាក់សាំង ដូចគ្នា ឬ ខុសគ្នា មិន បង្កឱ្យ មាន ផល រំខាន ទេ ប៉ុន្តែ អាច បង្កើន បាន នូវ ប្រព័ន្ធ ការពារ រាងកាយ កាន់តែ រឹងមាំ ទប់ទល់ នឹង មេរោគ បំប្លែង ខ្លួន
១១៖ រាជ រដ្ឋាភិបាល លើកទឹកចិត្ត វិស័យ ឯកជន និង ពលរដ្ឋ មាន លទ្ធភាព រ៉ាប់រង ការចាក់ វ៉ាក់សាំង ដូស ជំរុញ
១៣៖ កប៉ាល់ ដឹក ប្រេង ឆៅ ជិត ៣០ម៉ឺន បារ៉ែល ដែល លួច រត់ គេច ពី ប្រទេស កម្ពុជា ត្រូវបាន កងទ័ព ជើងទឹក ឥណ្ឌូនេស៉ី ចាប់ បាន ហើយ
១៤៖ ក្រុម អ្នកស្រាវជ្រាវ នៅ ព័រទុយហ្កាល់ រកឃើញ ថ្នាំ៣ ប្រភេទ ដែល អាច ជួយ ទប់ទល់ កូវីដ១៩
