( ព្រៃវែង ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បន្ដ នាំយក ថវិកា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ទៅ ប្រគល់ ជូន លោក តា លោកយាយ អាយុ ១០០ ឆ្នាំ ឡើង ដែល បាន ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ទទួលបាន ថវិកា ចំនួន ៣លាន រៀល និង សម្ភារ ជា គ្រឿង ឧបភោគ បរិភោគ មួយចំនួន ទៀត ។
ក្នុង ឱកាស នោះ ក៏ មាន ការចូលរួម ពី លោកស្រី វេជ្ជបណ្ឌិត Li Ailan តំណាង អង្គការ សុខភាព ពិភពលោក ប្រចាំ នៅ កម្ពុជា និង លោក វេជ្ជបណ្ឌិត សេង បញ្ញា ឫទ្ធិ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រៃវែង ផងដែរ ។
លោកតា និង លោកយាយ ដែល ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង ហើយ ទទួលបាន អំណោយ ពី សម្ដេច តេជោ ហ៊ុន សែន នា ឱកាស នេះ រួម មាន៖
សូម ជម្រាប ថា នៅ ទូទាំង ខេត្ត ព្រៃវែង មាន ប្រជាពលរដ្ឋ ប្រមាណ ៦០ ម៉ឺន នាក់ ហើយ ដែល បាន ចាក់ នូវ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ស្មើនឹង ៩០ ភាគរយ នៃ ប្រជាពលរដ្ឋ ដែល មាន អាយុ ពេញ វ័យ ចាប់ពី ១៨ ឆ្នាំ ឡើង ។ នេះ បើ តាម ការឲ្យដឹង ពី លោក វេជ្ជបណ្ឌិត សេង បញ្ញា ឫទ្ធិ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ព្រៃវែង ៕ រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង ចុះ ពិនិត្យ មន្ទីរពិសោធន៍ តេស្ត រក មេរោគ កូវីដ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល អម ដំណើរ ដោយ មន្រ្តី ជំនាញ ពាក់ព័ន្ធ នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចុះ ទៅ ពិនិត្យមើល មន្ទីរពិសោធន៍ តេស្ត រក មេរោគ កូវីដ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង ។
លោក រដ្ឋមន្ត្រី បាន ថ្លែង ថា មន្ទីរពិសោធន៍ តេស្ត រក មេរោគ កូវីដ១៩ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង នឹង បង្កើន ការធ្វើតេស្ត កាន់តែ ច្រើន និង មាន ភាព លឿន រហ័ស ។
ក្នុង ឱកាស នោះ រដ្ឋមន្ត្រី សុខាភិបាល បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ បង្កើន ការ ការពារ កូវីដ១៩ ឱ្យ បាន ខ្ពស់ បន្ថែម ទៀត ជាពិសេស ពេល ចេញ ក្រៅ ទៅ ផ្សារ ឬ ទៅ ធ្វើ ការងារ រក ស៉ី ត្រូវ ពាក់ ម៉ាស ឱ្យ បាន ត្រឹមត្រូវ និង សំអាត ដៃ ឱ្យ ជាប់ ជានិច្ច ៕ មកទល់ ពេលនេះ ចិន សម្រេចបាន ការចាក់ វ៉ាក់សាំង ជាង « ១. ៩៣ ពាន់ លាន ដូស » ជូន ប្រជាជន នៅ ទូទាំង ប្រទេស . កើន ជាង ១០លាន ដូស ក្នុង មួយ ថ្ងៃ
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ឧបត្ថម្ភ អង្ករ ២០តោន ដល់ រដ្ឋបាល ខេត្ត ប៉ៃលិន សម្រាប់ ផ្គត់ផ្គង់ ដល់ អ្នក ធ្វើចត្តាឡី ស័ក និង អ្នក កំពុង ព្យាបាល ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន សម្រេច ឧបត្ថម្ភ អង្ករ ២០តោន ដល់ រដ្ឋបាល ខេត្ត ប៉ៃលិន សម្រាប់ ផ្គត់ផ្គង់ ដល់ អ្នក ធ្វើចត្តាឡី ស័ក និង អ្នក កំពុង ព្យាបាល ជំងឺ កូវីដ១៩ ។
ការឧបត្ថម្ភ ខាងលើ ដោយ សង្កេតឃើញ ថា ខេត្ត ប៉ៃលិន ដែល ជា ខេត្ត នៅជាប់ ព្រំដែន ប្រទេស ថៃ មាន ពលករ ខ្មែរ រាប់ ពាន់ នាក់ ត្រឡប់ ពី ប្រទេស ថៃ ជាច្រើន ក្នុង មួយ ថ្ងៃ ៗ ហើយ តម្រូវ ឱ្យ ធ្វើចត្តាឡី ស័ក ៕
ខេត្ត ព្រះវិហារ បន្ត រកឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៤នាក់ ទៀត
រដ្ឋបាល ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង ថា អ្នកជំងឺ ដែល បាន រកឃើញ ថ្មី ចំនួន ៤នាក់ នេះ ត្រូវបាន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល ជំងឺ កូវីដ១៩ កម្រិត ស្រាល នៅ វិទ្យាល័យ ជា ស៉ី ម ត្បែងមានជ័យ ក្រុង ព្រះវិហារ និង មណ្ឌល ព្យាបាល ជំងឺ កូវីដ១៩ កម្រិត ស្រាល នៅ វិទ្យល័យ រវៀង ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស របស់ រដ្ឋបាល ខេត្ត ព្រះវិហារ៖ អភិបាល ខេត្ត ប៉ៃលិន ពិនិត្យ ដំណាំ បន្លែ កសិករ និង សន្យា ទិញ មិន ឲ្យ កកស្ទះ ឡើយ
( ប៉ៃលិន ) ៖ លោកស្រី បាន ស្រី មុំ អភិបាល ខេត្ត ប៉ៃលិន អភិបាល រង ខេត្ត និង មន្ត្រី ជំនាញ ពាក់ព័ន្ធ នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ បាន ចុះ ជួប ជាមួយ ប្រជាកសិករ ដែល ដាំដុះ បន្លែ បង្ការ គ្រប់ មុខ នៅក្នុង ក្រុង ប៉ៃលិន និង ស្រុក សាលា ក្រៅ ដែល កំពុង មាន បញ្ហា ប្រឈម ក្នុង ពេល មាន វិបត្តិ ជំងឺ កូវីដ - ១៩ ។
គួរ បញ្ជាក់ ផងដែរ ថា ដើម្បី ជួយ សម្រួល បន្ទុក នៃ ការលំបាក របស់ ប្រជាកសិករ ដែល រង ផល ប៉ះពាល់ សម្រាប់ ផលិតផល មៀន ខេត្ត ប៉ៃលិន កន្លងមក រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជាទិញ ផ្លែ មៀន ដែល មាន ការកកស្ទះ ដែល ពុំ អាច នាំចេញ ទៅ ក្រៅ ប្រទេស បាន សម្រាប់ ចែកជូន កងកម្លាំងប្រដាប់អាវុធ ក៏ ដូចជា ក្រុម គ្រូពេទ្យ ជួរ មុខ ទាំងអស់ ដែល នេះ គឺជា ការរួមចំណែក មួយ យ៉ាង សំខាន់ ក្នុង ការជួយ សម្រួល ការលំបាក របស់ ប្រជាកសិករ ។
សម្រាប់ ខេត្ត ប៉ៃលិន អភិបាល ខេត្ត ប៉ៃលិន ក៏ បាន បញ្ជាទិញ ផ្លែ មៀន គិត រហូតមកដល់ ពេលនេះ បាន ចំនួន ១០តោន ជាង និង នៅ បន្ត ទិញ ផងដែរ ដើម្បី ចែកជូន កងកម្លាំងប្រដាប់អាវុធ ដែល កំពុង ឈរជើង នៅ តាម គោលដៅ ចត្តាឡី ស័ក និង គោលដៅ ព្យាបាល នៅក្នុង ខេត្ត ប៉ៃលិន ក៏ដូចជា ក្រុម គ្រូពេទ្យ ដែល កំពុង បម្រើ ការងារ យ៉ាង សកម្ម ទៅតាម គោលដៅ ផ្សេង ៗ ផងដែរ ៕
ខេត្ត បបន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ២៨២ ករណី និង អ្នក ជាសះស្បើយ ១៦៨ នាក់
ទីក្រុង ពីរ នៅ ភាគ កណ្តាល ប្រទេស ចិន ប្រកាស អាសន្ន កម្រិត ខ្ពស់ សម្រាប់ ទឹក ជំនន់
ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៤២ នាក់ និង ជាសះស្បើយ ១៥នាក់
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ១៩ ចំនួន ៤២ នាក់ បន្ថែម ទៀត និង ជាសះស្បើយ ១៥នាក់ ។
( ភ្នំពេញ ) ៖ បណ្ឌិត សុក ស៊ី ផាន់ ណា ប្រធាន នៃ វិទ្យាស្ថាន ចក្ខុវិស័យ អាស៊ី បាន លើកឡើង នូវ កត្តា ចំនួន ២ ដែល អាច ជួយ ឲ្យ សហគ្រិន កម្ពុជា អាច ស្តារ នូវ អាជីវកម្ម របស់ ខ្លួន ឡើងវិញ បន្ទាប់ពី វិបត្តិ កូវីដ១៩ ស្រាកស្រាន្ត ដោយសារ វិធានការបន្ទាន់ របស់ រាជ រដ្ឋាភិបាល ។
កត្តា ចំនួន ២នោះ រួម មាន៖ ទី១ - ច្បាប់ វិនិយោគ ថ្មី ដែល ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា អនុម័ត កាលពី ពេល ថ្មី ៗ នេះ កំពុង ដំណើរការ ពិនិត្យ និង អនុម័ន រដ្ឋសភា កម្ពុជា ក្នុង ពេល ដ៏ ខ្លី ខាងមុខ នេះ និង ទី២ - កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ តំបន់ ( អាសិប -RCEP) ដែល ត្រូវបាន ចុះហត្ថលេខា រួចហើយ កាលពី ថ្ងៃទី ១៥ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
កាលើកឡើង របស់ លោក សុក ស៊ី ផាន់ ណា ក្នុង កិច្ចពិភាក្សា ពិសេស ស្ដីពី « មគ្គុទេសក៍ ស្ដារ អាជីវកម្ម ក្នុង បរិបទ កូវីដ១៩ ពី ទស្សនៈ វិស័យ ឯកជន » ដែល រៀបចំឡើង ដោយ សមាគម សហគ្រិន វ័យ ក្មេង នា ពេល ថ្មី ៗ កន្លងទៅ នេះ ។
លោក បណ្ឌិត និយាយ ថា ច្បាប់ វិនិយោគ ថ្មី ដែល នឹង ត្រូវ ចូល ជាធរមាន ប្រហែលជា ៣ខែ ខាងមុខ ជា ច្បាប់ វិនិយោគ ដ៏ ល្អ បង្ក លក្ខណៈ ងាយស្រួល ជាច្រើន និង ផ្ដល់ ភាពកក់ក្ដៅ ដល់ អ្នក វិនិយោគ ទាំង ក្នុង ស្រុក និង ក្រៅ ស្រុក ។
ដោយឡែក ចំពោះ កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ តំបន់ ( អាសិប -RCEP) ត្រូវបាន លោក សុក ស៊ី ផាន់ ណា លើកឡើង ថា អាចនឹង ផ្ដល់ លទ្ធភាព ឲ្យបាន ច្រើន ដល់ សហគ្រិន កម្ពុជា ប្រសិនបើ យល់ ច្បាស់ ពី កិច្ចព្រមព្រៀង នេះ ដែល អាចនឹង បង្កើត ឲ្យ មាន ដៃ គូ សហការ ជាមួយ បណ្តា ប្រទេស ជាច្រើន ដែល ជា សមាជិក របស់ អាសិប -RCEP ទាំង ១៥ ប្រទេស ។
កិច្ចព្រមព្រៀង RCEP ត្រូវបាន ផ្តួចផ្តើម ឡើង នៅ ខែវិច្ឆិកា ឆ្នាំ ២០១២ នា រាជធានី ភ្នំពេញ ពេល កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ កំពូល អាស៊ាន ។ កិច្ចព្រមព្រៀង នេះ បង្កើតឡើង សំដៅ ជំរុញ ពាណិជ្ជកម្ម រវាង ប្រទេស សមាជិក អាស៊ាន និង ប្រទេស ដៃ គូ ក្នុង តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក ។
បើ តាម ក្រសួង សុខាភិបាល ថៃ ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ១៨. ៨១៨ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ថៃ ទូទៅ និង ១៩៦ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ អ្នកជំងឺ ចំនួន ២៣៣ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ។ ដោយឡែក អ្នកជំងឺ ចំនួន ២០. ៦៧២ នាក់ ផ្សេង ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
តើ ប្រពៃណី សែន ក្បាល ទឹក បាន បង្ហាញ អំពី គុណ តម្លៃ ដល់ កុលបុត្រ កុល ធីតា ចិន យ៉ាងណា ?
អ្នកជំនាញ អារ្យធម៌ ខ្មែរ លោក រត្ន័ សណ្ដាប់ បាន ថ្លែង ថា ចំពោះ ប្រពៃណី សែន ក្បាល ទឹក ដែល កុលបុត្រ កុល ធីតា ចិន ឬ ខ្មែរ ជាប់ ខ្សែ ស្រទ្បាយ ចិន តែង ប្រារព្វ នៅ ថ្ងៃទី ១៥ កើត ខែ ស្រា ពណ៍ ត្រូវ នឹង ខែកក្ដ ដា ឬ សីហា ទៅ តាម ប្រតិទិន ចន្ទ គតិ ចិន នេះ គឺជា កិច្ច ពិធី រំឭក ដឹងគុណ ដល់ បុព្វការី ជន កុង ម៉ា ជីដូន ជីតា ម្ចាស់ ទឹក ម្ចាស់ ដី មិន ខុសពី ប្រពៃណី បុណ្យ ភ្ជុំ បិណ្ឌ និង បោះ បាយ បិណ្ឌ របស់ ខ្មែរ យើង នោះ ទេ ។
បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ទាំង ជំងឺ ទាំង ២៣ នាក់ ខាងលើ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង តាម មន្ទីរពេទ្យ បង្អែក ស្រុក នីមួយ ៗ ។
សូម កុំ ផ្ទុក អ្នកដំណើរ ឬ ទំនិញ លើស ច្បាប់ កំណត់ ! ស្លាប់ ១នាក់ និង របួស ៨នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២២ ខែសីហា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១នាក់ និង របួស ធ្ងន់ ៨នាក់ ។
សម្តេច តេជោ ហ៊ុន សែន បង្ហោះ រូបភាព ជួបជុំ ជាមួយ កូន ចៅ ដើម្បី ជូនដំណើរ ចៅ ប្រុស ១រូប ត្រៀម ចូលមហា វិទ្យាល័យ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ យប់ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បង្ហោះ រូបភាព ជួបជុំ ជាមួយ កូន ចៅ ដើម្បី ជា ការជូនដំណើរ ចៅ ប្រុស ១រូប របស់ សម្តេច ត្រៀម ចូលមហា វិទ្យាល័យ ។
សូម ជម្រាប ថា ចៅ ប្រុស របស់ សម្តេច តេជោ ដែល ត្រៀម ចូលរៀន នៅ មហាវិទ្យាល័យ នោះ គឺជា កូនប្រុស ច្បង របស់ លោក ហ៊ុន ម៉ានិត ៕
