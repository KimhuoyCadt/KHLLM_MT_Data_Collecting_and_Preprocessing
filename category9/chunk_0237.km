( ភ្នំពេញ ) ៖ រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង បាន ថ្លែង កោតសរសើរ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការដាក់ចេញ វិធានការ ប្រកបដោយ ប្រសិទ្ធភាព ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ រួម ជាមួយ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ទាន់ ពេលវេលា នៅ ទូទាំង ប្រទេស ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា នៅ ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០២១ ។
ការកោតសរសើរ ពី រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង ធ្វើឡើង តាមរយៈ លោក ឆុង អើយ យ៉ុង រដ្ឋមន្រ្តី ការបរទេស នៃ សាធារណរដ្ឋ កូរ៉េ ជាមួយ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា ក្នុង កិច្ចប្រជុំ ទ្វេ ភាគី ដែល បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៨ ខែកញ្ញា ឆ្នាំ ២០២១ នា ឱកាស ដំណើរទស្សនកិច្ច របស់ ប្រមុខ ការទូត កម្ពុជា នៅ ប្រទេស នេះ ។
សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « រដ្ឋមន្ត្រី ការបរទេស សាធារណរដ្ឋ កូរ៉េ បាន កោតសរសើរ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការដាក់ចេញ វិធានការ ប្រកបដោយ ប្រសិទ្ធភាព ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ រួម ជាមួយ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ទាន់ ពេលវេលា នៅ ទូទាំង ប្រទេស ។ លោក ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កម្ពុជា ដែល បាន ផ្តល់ ជំនួយ ដ៏ សប្បុរស ដល់ ប្រទេស ជិតខាង ដើម្បី ជួយ ប្រទេស ទាំងនោះ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ » ។
លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន និង លោក ឆុង អើយ យ៉ុង បាន កត់សម្គាល់ ដោយ ការពេញចិត្ត យ៉ាង ខ្លាំង ចំពោះ ការបន្ត រីកចម្រើន នៃ ទំនាក់ទំនង ទ្វេ ភាគី និង កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ រវាង ប្រទេស ទាំង ពីរ ទាំង ក្នុង ក្របខ័ណ្ឌ ទ្វេ ភាគី និង ពហុ ភាគី ដែល ឆ្លុះបញ្ចាំង តាមរយៈ ការផ្លាស់ប្តូរ ទស្សនកិច្ច ជាន់ ខ្ពស់ ជាញឹកញាប់ រវាង ប្រទេស ទាំង ពីរ ។
ស្រប ពេល ដែល កម្ពុជា និង សាធារណរដ្ឋ កូរ៉េ នឹង ប្រារព្ធ ខួប លើក ទី ២៥ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត ឡើងវិញ នៅ ឆ្នាំ ក្រោយ នេះ រដ្ឋមន្រ្តី ការបរទេស ទាំង ពីរ បាន បញ្ជាក់ សា ជា ថ្មី ពី ការប្តេជ្ញាចិត្ត ក្នុង ការពង្រឹង និង ពង្រីក ទំនាក់ទំនង ទ្វេ ភាគី ដ៏ ល្អ ដែល មាន ស្រាប់ បន្ថែម ទៀត ដើម្បី ជា ប្រយោជន៍ រួម នៃ ប្រជាជាតិ ទាំង ពីរ និង សម្រាប់ សន្តិភាព សន្តិសុខ ស្ថិរភាព និង វិបុលភាព ក្នុង តំបន់ និង សកលលោក ។
ក្នុង ន័យ នេះ រដ្ឋមន្រ្តី ទាំង ពីរ បាន ពិភាក្សា ពី មធ្យោបាយ និង វិធីសាស្រ្ត ក្នុង ការធ្វើឱ្យ កាន់តែ ស៊ីជម្រៅ នូវ កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ យោធា ពាណិជ្ជកម្ម ការវិនិយោគ កសិកម្ម ការងារ សុខាភិបាល បច្ចេកវិទ្យា គមនាគមន៍ និង ព័ត៌មាន វិទ្យាសាស្រ្ត និង ន វានុវត្តន៍ ទេសចរណ៍ ការអប់រំ និង បរិស្ថាន ។
រដ្ឋមន្រ្តី ទាំង ពីរ ក៏ មាន សុទិដ្ឋិនិយម ថា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី កម្ពុជា - សាធារណ កូរ៉េ (CKFTA) ដែល នឹង ត្រូវ ចុះហត្ថលេខា នៅ ដើម ខែតុលា ខាងមុខ នេះ នឹង ជួយ ជំរុញ ពាណិជ្ជកម្ម និង ការវិនិយោគ ទ្វេ ភាគី បន្ថែម ទៀត ព្រមទាំង ជួយ ពន្លឿន ការស្តារ សេដ្ឋកិច្ច នៃ ប្រទេស ទាំង ពីរ ឡើងវិញ នៅ ក្រោយ វិបត្តិ កូវីដ - ១៩ ។
លោក ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល សាធារណរដ្ឋ កូរ៉េ ក្នុង ការផ្តល់ ជំនួយ អភិវឌ្ឍន៍ ដល់ ប្រទេស កម្ពុជា ដែល បាន រួមចំណែក យ៉ាង សំខាន់ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម កម្ពុជា ។
លោក បាន សង្កត់ធ្ងន់ ថា កម្ពុជា ស្ញប់ស្ញែង ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ សាធារណរដ្ឋ កូរ៉េ ក្នុង ការពង្រីក ជំនួយ អភិវឌ្ឍន៍ ក្រោម គោល នយោបាយ ឆ្ពោះ ទៅរក ទិស ខាងត្បូង ថ្មី និង ស្វាគមន៍ គោល នយោបាយ ឆ្ពោះ ទៅរក ទិស ខាងត្បូង ថ្មី បូក ដែល ផ្តោត លើ វិស័យ សំខាន់ ៗ ចំនួន ៧ ក្នុង នោះ រួម មាន កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ លើ វិស័យ សុខាភិបាល និង វេជ្ជសាស្រ្ត ។
លោក ឧប នាយក រដ្ឋមន្រ្តី បាន កោតសរសើរ រដ្ឋាភិបាល និង ប្រជាជន កូរ៉េ ចំពោះ ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ប្រកបដោយ ប្រសិទ្ធភាព ដែល ធ្វើឱ្យ ការស្តារ សេដ្ឋកិច្ច - សង្គម មាន សន្ទុះ ខ្លាំង និង បាន វាយតំលៃ ខ្ពស់ ចំពោះ តួនាទី ដ៏ សកម្ម របស់ សាធារណរដ្ឋ កូរ៉េ ក្នុង ក្របខ័ណ្ឌ វ៉ាក់សាំង ពហុ ភាគី និយម ។ លោក ក៏ បាន សំដែង នូវ អំណរ អរគុណ របស់ កម្ពុជា ចំពោះ រដ្ឋាភិបាល សាធារណរដ្ឋ កូរ៉េ ដែល បាន បរិច្ចាគ និង ផ្គត់ផ្គង់ សម្ភារៈ វេជ្ជសាស្រ្ត ដល់ កម្ពុជា ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន សម្តែង នូវ អំណរ អរគុណ ដោយ ស្មោះ ចំពោះ រដ្ឋាភិបាល កូរ៉េ ដែល បាន យកចិត្តទុកដាក់ ខ្ពស់ ដល់ សហគមន៍ ខ្មែរ នៅ កូរ៉េ ។
ជា ការឆ្លើយតប លោក ឆុង អើយ យ៉ុង បាន ថ្លែងអំណរគុណ ដល់ សហគមន៍ ខ្មែរ នៅ កូរ៉េ ដែល បាន រួមចំណែក យ៉ាង វិជ្ជមាន ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង ការធ្វើ ពិពិធកម្ម វប្បធម៌ របស់ កូរ៉េ ។ សាធារណរដ្ឋ កូរ៉េ បាន សន្យា ថា នឹង បង្កើន ចំនួន កូតា ពលករ កម្ពុជា និង ចំនួន អាហារូបករណ៍ ដល់ កម្ពុជា នា ពេល អនាគត ។
លោក ឆុង អើយ យ៉ុង បាន បញ្ជាក់ សារជាថ្មី ថា ដោយសារ កម្ពុជា ជា ប្រទេស មួយ ក្នុង ចំណោម ប្រទេស ដៃ គូ អាទិភាព ក្នុង កម្មវិធី ជំនួយ អភិវឌ្ឍន៍ ផ្លូវការ និង ជា ដៃគូ ស្នូល ក្នុង គោល នយោបាយ ឆ្ពោះ ទៅរក ទិស ខាងត្បូង ថ្មី របស់ សាធារណរដ្ឋ កូរ៉េ សាធារណរដ្ឋ កូរ៉េ នឹង បន្ត ជួយ និង សហការ ជាមួយ កម្ពុជា ក្នុង វិស័យ គ្រប់គ្រង ទឹក សុខភាព សាធារណៈ ការដឹកជញ្ជូន ការអប់រំ និង វិស័យ ចាំបាច់ ផ្សេង ទៀត នៅ កម្ពុជា ។
រដ្ឋមន្រ្តី ការបរទេស សាធារណរដ្ឋ កូរ៉េ បាន កោតសរសើរ ចំពោះ តួនាទី ដ៏ សកម្ម របស់ កម្ពុជា ក្នុង កិច្ច ប្រតិបត្តិការ រក្សា សន្តិភាព ក្រោម ឆ័ត្រ អង្គការ សហ ប្រជាជាតិ នៅ ទ្វីប អាហ្វ្រិក និង មជ្ឈិមបូព៌ា ដែល បាន រួមចំណែក ដល់ សន្តិភាព និង ស្ថិរភាព ក្នុង តំបន់ ទាំងនោះ ហើយក៏ បាន ថ្លែងអំណរគុណ កម្ពុជា ចំពោះ តួនាទី យ៉ាង សកម្ម ក្នុង ការសម្របសម្រួល ទំនាក់ទំនង ក្នុង ក្របខណ្ឌ ដៃគូ សន្ទនា អាស៊ាន - សាធារណរដ្ឋ កូរ៉េ និង កិច្ចសហប្រតិបត្តិការ មេគង្គ - សាធារណរដ្ឋ កូរ៉េ ។
ក្នុង ការដោះស្រាយ បញ្ហា ប្រឈម នៃ បម្រែបម្រួល អាកាសធាតុ លោក ឧប នាយក រដ្ឋមន្រ្តី បាន អបអរសាទរ សាធារណរដ្ឋ កូរ៉េ ដែល ទទួលបាន ភាពជោគជ័យ ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ កំពូល លើក ទី ២ ស្តីពី ភាពជាដៃគូ ដើម្បី ការអភិវឌ្ឍ បៃតង និង គោលដៅ ពិភពលោក ឆ្នាំ ២០៣០ កាលពី ខែឧសភា កន្លងទៅ និង គាំទ្រ យ៉ាង មុតមាំ ចំពោះ គោល នយោបាយ បៃតង ថ្មី និង ការប្តេជ្ញាចិត្ត របស់ រដ្ឋាភិបាល កូរ៉េ ស្តីពី អព្យាក្រឹតភាព កាបូន ឆ្នាំ ២០៥០ ។
រដ្ឋមន្ត្រី ការបរទេស សាធារណរដ្ឋ កូរ៉េ បាន សម្តែង នូវ ការកោតសរសើរ ចំពោះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន ដែល បាន រួមចំណែក ដល់ ភាពជោគជ័យ នៃ កិច្ចប្រជុំ កំពូល ខាងលើ ដោយ ក្នុង ពេល នោះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ក៏ បាន សង្កត់ធ្ងន់ ពី តម្រូវការ នៃ ការអភិវឌ្ឍ បច្ចេកវិទ្យា បៃតង ។
លោក ឆុង អើយ យ៉ុង បាន បញ្ជាក់ ជាថ្មី ពី ការគាំទ្រ យ៉ាង ពេញ ទំហឹង របស់ សាធារណរដ្ឋ កូរ៉េ ដល់ កម្ពុជា ក្នុង ការធ្វើជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ កំពូល អាស៊ី - អឺរ៉ុប លើក ទី ១៣ នៅ ខែវិច្ឆិកា ឆ្នាំ ២០២១ និង ការទទួល តំណែង ជា ប្រធាន អាស៊ាន នៅ ឆ្នាំ ក្រោយ ៕ បទ អត្ថាធិប្បាយ៖ « ការប្រឆាំង ភេរវកម្ម បែប អាមេរិក » ធ្វើឱ្យ ភេរវ និយម មាន ភាព កាន់តែ ធ្ងន់ធ្ងរ
( ប៉េកាំង ) ៖ មុន ខួប ទី២០ នៃ ព្រឹតិ្តការណ៍ វាយប្រហារ ដោយ ភេរវកម្ម ថ្ងៃទី ១១ ខែកញ្ញា សង្រ្គាម អាហ្វហ្កានីស្ថាន ដែល អាមេរិក បាន បំផុស នោះ ត្រូវបាន បញ្ចប់ ដោយ បរាជ័យ ។ ក្នុង ដំណាក់កាល ចុងក្រោយ ដែល ទាហាន អាមេរិក ជម្លៀស ចេញ ដោយ ប្រញាប់ប្រញាល់ បក្ខពួក នៃ ក្រុម ភេរវករ ISIS ដែល ជា អង្គការ ជ្រុលនិយម បាន បង្ក រឿង បំផ្ទុះ ជា បន្តបន្ទាប់ នៅ ក្រុង កាប៊ុល រដ្ឋធានី អាហ្វហ្កានីស្ថាន បណ្តាលឱ្យ មនុស្ស ជាង មួយ រយ នាក់ បាត់បង់ជីវិត ក្នុង នោះ ក៏ បូករួម ទាំង ទាហាន អាមេរិក ១៣ នាក់ ផងដែរ ។
អ្វី ដែល ពួកគេ ហៅ ថា « សង្គ្រាម ប្រឆាំង ភេរវកម្ម » ដែល បាន អូសបន្លាយ អស់ រយៈពេល ២០ ឆ្នាំ ចំណាយ ប្រាក់ ជាង ២ទ្រី លាន ដុល្លារ អាមេរិក និង បណ្តាលឱ្យ ទាហាន អាមេរិក ជាង ២ម៉ឺន នាក់ ស្លាប់ បាត់ និង រងរបួស ហេតុ អ្វី បានជា បាន បញ្ចប់ ដោយ បរាជ័យ យ៉ាង ធ្ងន់ធ្ងរ ដូចនេះ ? ប្រការ នេះ ធ្វើឱ្យ ពិភពលោក ទាំងមូល បាន និង កំពុង គិត ពិចារណា ពី កំហុស ។
ដូច អ្នកវិភាគ មួយចំនួន បាន លើកឡើង ថា មូលហេតុ សំខាន់ មួយ គឺ ដោយ មកពី ក្នុង បញ្ហា ប្រឆាំង ភេរវកម្ម ការគិតគូរ របស់ អាមេរិក ផ្តោត សំខាន់ តែ ផលប្រយោជន៍ របស់ ខ្លួន ហើយ បាន អនុវត្ត ស្តង់ដារ ខុសគ្នា ក្នុង ពេល ធ្វើ ការវិនិច្ឆ័យ ចំពោះ ភេរវ និយម និង ទង្វើ ភេរវកម្ម ។ ដូច្នេះ ស្តង់ដា ស្ទួន ក្នុង បញ្ហា ប្រឆាំង ភេរវកម្ម បាន បណ្តែត បណ្តោយ ឱ្យ មាន ការរីករាលដាល នៃ ភេរវ និយម ។
តាមពិត ទៅ នៅ គ្រា ដំបូង ដែល អាមេរិក បញ្ជូន ទាហា ន ទៅកាន់ អាហ្វហ្កានីស្ថាន និង អ៊ីរ៉ាក់ ជាដើម អាមេរិក ក៏ប៉ុនប៉ង ផ្សារភ្ជាប់ ការប្រឆាំង ភេរវកម្ម ជាមួយនឹង ការអនុវត្ត អនុត្តរភាព និយម និង ការធ្វើ វិទ្ធង្ស នា រដ្ឋអំណាច ប្រទេស ដទៃ ។ ដូចនេះ របស់ ដែល ហៅ ថា « ប្រឆាំង ភេរវកម្ម » ដែល បូករួម ទាំង គោលបំណង ផ្ទាល់ខ្លួន តាមពិត ទៅ បាន ធ្វើឱ្យ ការប៉ះទង្គិច និង ភាពច្របូកច្របល់ ក្នុង តំបន់ និង ប្រទេស ពាក់ព័ន្ធ មាន ភាព កាន់តែ ធ្ងន់ធ្ងរ ឡើង បាន បណ្តាលឱ្យ កើតឡើង សកម្មភាព វាយប្រហារ ដោយ ភេរវកម្ម ជា បន្តបន្ទាប់ ។
ប្រព័ន្ធ សារព័ត៌មាន បរទេស ធ្លាប់ ធ្លាយ ឱ្យដឹង ថា ក្នុង រយៈពេល ជាច្រើន ឆ្នាំ កន្លងមក ដើម្បី សម្រេចបាន នូវ គោលដៅ ភូមិសាស្ត្រ នយោបាយ របស់ អាមេរិក នៅ តំបន់ មជ្ឈិមបូព៌ា អាមេរិក បាន រក្សា « ទំនាក់ទំនង សហប្រតិបតិ្តការ » ជាមួយ អង្គការ ភេរវកម្ម ដែល មាន ភាពរស់រវើក នៅ ប្រទេស ស៊ីរី និង អ៊ីរ៉ាក់ រហូតដល់ ផ្តល់ សម្ភារៈ និង ជំនួយ យោធា ដល់ អង្គការ ទាំង នេះ ។
បច្ចុប្បន្ន នេះ ប្រឈម នឹង ការសាកល្បង យ៉ាង តឹងរឹង ពី ភេរវ និយម និង ជ្រុលនិយម អាមេរិក ចាំបាច់ ត្រូវ លះបង់ ចោល ស្តង់ដារ ពីរ ក្នុង ការប្រឆាំង ភេរវកម្ម និង ទង្វើ ខុសឆ្គង់ ដូច « ដុត ស្ពាន បន្ទាប់ពី ឆ្លងកាត់ ទន្លេ » បើ ពុំ នោះ សោត អាមេរិក ពិតជា នឹង ទទួល ផលវិបាក កាន់តែ ច្រើន ហើយ នឹង បង្ខូច ផលប្រយោជន៍ ទាំង អ្នកដទៃ និង ខ្លួន ឯង ជា មិន ខាន !
ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រាប់ តំណាង ប្រទេស មហា អនុ តំបន់ ទន្លេ មេគង្គ ថា ទោះ វិបត្តិ កូវីដ១៩ កម្ពុជា បន្ត អនុវត្ត ផែនការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ដោយ ប្រើ គ្រប់ យន្តការជាតិ - អន្ត ជាតិ
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន បញ្ជាក់ ថា ប្រាប់ តំណាង ប្រទេស មហា អនុ តំបន់ ទន្លេ មេគង្គ ថា ទោះ វិបត្តិ ជំងឺ កូវីដ១៩ កម្ពុជា បន្ត អនុវត្ត ផែនការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ដោយ បាន ប្រើ គ្រប់ មធ្យោបាយ និង គ្រប់ យន្តការ ទាំង យន្តការជាតិ និង អន្ត ជាតិ ។
ការបញ្ជាក់ បែប នេះ របស់ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន នៅក្នុង ឱកាស អញ្ជេីញ ជា អធិបតី បេីក កិច្ចប្រជុំ ថ្នាក់ មន្រ្តី ជាន់ ខ្ពស់ នៃ បណ្តា ប្រទេស ហត្ថលេខី លើ អនុស្សរណៈ នៃ ការយោគយល់ គ្នា ឆ្នាំ ១៩៩៣ ស្តីពី កិច្ចសហប្រតិបត្តិការ ត្រួតពិនិត្យ គ្រឿងញៀន ដែល កម្ពុជា កម្ពុជា នឹង ធ្វេី ជា ម្ចាស់ ផ្ទះ ដែល មាន សមាសភាព ចូលរួម ពី ប្រទេស ចំនួន ៦ មាន ប្រទេស កម្ពុជា ចិន ឡាវ សហភាព មីយ៉ាន់ម៉ា ថៃ និង វៀតណាម នា ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ តាម ប្រព័ន្ធ វីដេអូ ។
ទន្ទឹមនឹង នេះ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ឱ្យដឹង ថា ក៏ សង្កេតឃើញ ថា ទោះបី ក្នុង ស្ថានភាព នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក៏ដោយ និន្នាការ នៃ ការចរាចរ ជួញដូរ និង ប្រើប្រាស់ គ្រឿងញៀន នៅ ស្ថិត ក្នុង ការព្រួយបារម្ភ នៅឡើយ ។
ជាមួយគ្នា នេះ ឧប នាយក រដ្ឋមន្រ្តី កែ គឹម យ៉ាន ក៏ បាន ថ្លែង នូវ ការកត់សម្គាល់ និង វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ការងារ ជាច្រើន ដែល យន្តការ អឹម . អូ. យូ MOU សម្រេចបាន កន្លងមក ឈាន ទៅ កាត់បន្ថយ នូវ ការដាំដុះ និង ការផលិត គ្រឿងញៀន ប្រភេទ អាភៀន នៅក្នុង តំបន់ បានជា អតិបរិមា និង សុំ ទាញ ការចាប់អារម្មណ៍ ធ្វេី ការកត់សម្គាល់ និង វាយតម្លៃ ជាក់ស្តែង ចំនួន ០៣ ដូច ខាងក្រោម៖
ជាមួយគ្នា នេះ ឧប នាយក រដ្ឋមន្ត្រី កែ គឹម យ៉ាន បាន ស្នើសុំ កិច្ចប្រជុំ ទាំងមូល ពិសេស អង្គការ UNODC ពិនិត្យ លើ ការកែសម្រួល និង រៀបចំ ផែនការ សកម្មភាព អនុ តំបន់ ឱ្យ សមស្រប និង ឆ្លើយតប ទិដ្ឋភាព នៃ បច្ចុប្បន្នភាព ៣ចំណុច៖
( ភ្នំពេញ ) ៖ លោកស្រី ខៀវ បូរី រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា ប្រធាន ក្រុមការងារ បច្ចេកទេស អន្តរ ក្រសួង ដើម្បី រៀបចំ ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ នៃ កម្ពុជា បាន ដឹកនាំ កិច្ចប្រជុំ ពិគ្រោះយោបល់ ជាមួយ ថ្នាក់ ក្រោម ជាតិ ដើម្បី ពិនិត្យ លើ សេចក្តីព្រាង មាតិកា នៃ សេចក្តីព្រាង ច្បាប់ ស្ដីពី កិច្ចការពារ កុមារ តាម ប្រព័ន្ធ អនឡាញ នា ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ ។
កិច្ចប្រជុំ ពិគ្រោះយោបល់ ថ្នាក់ ក្រោម ជាតិ រៀបចំ ដោយ លេខាធិការដ្ឋាន រៀបចំ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ដោយ មាន ការគាំទ្រ ពី អង្គការ Unicef និង អង្គការ PLAN និង មាន ការចូលរួម ពី អភិបាល រង ចៅក្រម និង តំណាង អយ្យការ អម សាលាដំបូង និង លោក លោកស្រី តំណាង មកពី អង្គភាព ពាក់ព័ន្ធ ក្នុង ខេត្ត កោះកុង កែប តាកែវ ព្រៃវែង ត្បូងឃ្មុំ និង រាជធានី ភ្នំពេញ ។
លោកស្រី ខៀវ បូរី បាន លើកឡើង ថា នេះ ជា កិច្ចប្រជុំ ពិគ្រោះយោបល់ លើក ទី៣ ការជួប លើក នេះ ហើយ យើង នឹង បន្ត រហូតដល់ គ្រប់ ២៥ រាចធានី - ខេត្ត ដើម្បី បង្ហាញ ពី ការប្តេជ្ញាចិត្ត និង ការទទួលខុសត្រូវ ព្រមទាំង ជា ការបង្ហាញ ពី ការយកចិត្តទុកដាក់ រួមគ្នា ក្នុង ការលើកកម្ពស់ និង ការពារ កុមារ ពី ការរំលោភបំពាន ផ្សេង ៗ សំដៅ ធ្វើឲ្យ កាន់តែ ប្រសើរឡើង នូវ ការអនុវត្ត អនុសញ្ញា អង្គការ សហ ប្រជាជាតិ ស្តីពី សិទ្ធិ កុមារ នៅ កម្ពុជា ។
អនុលោម តាម ច្បាប់ អន្តរជាតិ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន យកចិត្តទុកដាក់ និង ដោះស្រាយ ប្រកបដោយ ប្រសិទ្ធភាព លើ វិស័យ សុខុមាលភាព កុមារ តាមរយៈ ការដាក់ចេញ ឱ្យ អនុវត្ត នូវ ច្បាប់ គោល នយោបាយ និង ផែនការ សកម្មភាព ជាតិ ដូចជា ក្របខ័ណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០១៦ - ២០២៥ គោល នយោបាយ ជាតិ ស្តីពី ប្រព័ន្ធ កិច្ចការពារ កុមារ ២០១៩ - ២០២៩ ច្បាប់ ស្តីពី យុត្តិធម៌ អនីតិជន ច្បាប់ ស្តីពី ស្មុំ កូន អន្តរ ប្រទេស និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ ផ្សេង ទៀត ។
ជា ការបន្ថែម លោកស្រី ខៀវ បូរី បាន ថ្លែង ការអរគុណ ដល់ សមាជិក សមាជិកា ទាំងអស់ ដែល បាន ចូលរួម ក្នុង កិច្ចប្រជុំ និង សូម អរគុណ អង្គការ យូនី សេហ្វ និង អង្គការ ភ្លែន អន្តរជាតិ ដែល បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ ដំណើរការ នៃ ការ រៀបចំ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ ៕
( ភ្នំពេញ ) ៖ កិច្ចប្រជុំ កំពូល មហា អនុ តំបន់ មេគង្គ លើក ទី៧ ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រ ដ្មន្រ្តី នៃ កម្ពុជា បាន ប្រព្រឹត្តទៅ តាម ប្រព័ន្ធ វីដេអូ នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ក្រោម មូល បទ « មហា អនុ តំបន់ មេ គង្គ៖ ពង្រឹង ភាពខ្លាំង ដើម្បី ទប់ទល់ នឹង បញ្ហា ប្រឈម នៃ ទសវត្សរ៍ ថ្មី » ។
ក្រោយ បញ្ចប់ កិច្ច ជុំ នេះ ភាគី ទាំងអស់ បាន ចេញ សេចក្តីថ្លែងការណ៍ រួម ២០ ចំណុច ដូច ខាងក្រោម៖
រាជ រដ្ឋាភិបាល ប្រកាស ពី លទ្ធផល កិច្ចប្រជុំ កំពូល មហា អនុ តំបន់ មេគង្គ លើក ទី៧ តាម ប្រព័ន្ធ វីដេអូ ដែល សម្តេច តេជោ ធ្វេី ជា ប្រធាន
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ធ្វើជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ កំពូល មហា អនុ តំបន់ មេគង្គ លើក ទី៧ តាម ប្រព័ន្ធ វីដេអូ ដែល ធ្វើឡើង ក្រោម មូល បទ « មហា អនុ តំបន់ មេ គង្គ៖ ពង្រឹង ភាពខ្លាំង ដើម្បី ទប់ទល់ នឹង បញ្ហា ប្រឈម នៃ ទសវត្សរ៍ ថ្មី » ។
កិច្ចប្រជុំ កំពូល មហា អនុ តំបន់ មេគង្គ លើក ទី៧ បាន ពិនិត្យមើល វឌ្ឍនភាព នៃ កិច្ចសហប្រតិបត្តិការ ចាប់តាំងពី កិច្ចប្រជុំ កំពូល លើក ទី៦ នៅ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០១៨ នៅ ប្រទេស វៀតណាម ព្រមទាំង កំណត់ សកម្មភាព និង ទិសដៅ អនាគត នៃ កិច្ចសហប្រតិបត្តិការ នៅ ៣ឆ្នាំ បន្ទាប់ ក្រោម ការជួយគាំទ្រ ពី ធនាគារ អភិវឌ្ឍន៍ អាស៊ី ៕
គួរ បញ្ជាក់ ថា បើ តាម មន្ត្រី អាមេរិក ម្នាក់ ខាងលើ ពលរដ្ឋ អាមេរិក និង ជន បរទេស ដទៃ នឹង ត្រូវ ចាកចេញ ពី អាហ្វហា្កនីស្ថាន នៅក្នុង ថ្ងៃព្រហស្បតិ៍ នេះ ។ ប៉ុន្តែ ខាង ក្រសួង ការបរទេស អាមេរិក ឬ តាលី បង់ មិន ទាន់ បញ្ចេញ ប្រតិបត្តិ អ្វី នោះ ទេ ហើយក៏ មិន ទាន់ មាន ការបញ្ជាក់ ថា ពលរដ្ឋ អាមេរិក និង ជន បរទេស ទាំង នេះ គឺជា ក្រុម មនុស្ស ដែល កំពុង ជាប់គាំង នៅឯ អាកាសយានដ្ឋាន ក្នុង ទីក្រុង Mazar-i-Sharif ដោយសារតែ អាជ្ញាធរ តាលី បង់ មិន អនុញ្ញាតឱ្យ ចាកចេញ ឬ ក៏ យ៉ាងណា នោះ ដែរ ៕
លោក គួច ចំរើន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ៖ « ខ្ញុំ សូម ជម្រាប ជូន ឯកឧត្តម អស់ លោក លោកស្រី ថ្នាក់ដឹកនាំ ខេត្ត កងកម្លាំងប្រដាប់អាវុធ មន្ទីរ ជំនាញ អភិបាល ក្រុង ស្រុក តាម ព័ត៌មាន ដែល យើង ទទួលបាន រសៀល នេះ នឹង មាន ខ្យល់ រលក សមុទ្រ ធំ ចឹង ខ្ញុំ សម្រេច ឲ្យ ផ្អាក ការធ្វើដំណើរ តាម ផ្លូវ ទូក កាណូត ចូល ទៅក្នុង លម្ហ សមុទ្រ » ។
ចំពោះ អ្នក ដែល មាន សមត្ថកិច្ច ពាក់ព័ន្ធ ការធ្វើដំណើរ របស់ ភ្ញៀវ ក៏ ត្រូវ ផ្អាក ការចេញ ទៅ ប្រកបរបរ របស់ ប្រជានេសាទ ក៏ ត្រូវ ផ្អាក និង ស្នើឲ្យ អាជ្ញាធរ មូលដ្ឋាន ជូនដំណឹង ទៅដល់ ក្រុមគ្រួសារ អ្នក ដែល នៅលើ គោក ឲ្យ រក មធ្យោបាយ ដើម្បី ផ្ដល់ ព័ត៌មាន ទៅឲ្យ ប្រជា នេសាទ ដែល កំពុង នៅក្នុង លម្ហ សមុទ្រ ធ្វើដំណើរ ទៅ កន្លែង ដែល មាន សុវត្ថិភាព ដើម្បី ចៀស ពី គ្រោះថ្នាក់ ដោយ ខ្យល់ រលក សមុទ្រ ធំ ៗ ។
សូម ជម្រាប ថា ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាព អាកាសធាតុ នៅ កម្ពុជា ចាប់ពី ថ្ងៃ នេះ ដល់ ១៤ ខែកញ្ញា ឆ្នាំ ២០២១ ។ ក្នុង រយៈពេល នៃ ការព្យាការណ៍ អាកាសធាតុ នេះ រាជធានី ខេត្ត ចំនួន ១១ របស់ កម្ពុជា ប្រឈម នឹង ជំនន់ ទឹកភ្លៀង រួម មាន ខេត្ត បាត់ដំបង . ខេត្ត ពោធិ៍សាត់ . ខេត្ត កំពង់ធំ . ខេត្ត កំពង់ឆ្នាំង . ខេត្ត កំពង់ស្ពឺ . ខេត្ត កណ្តាល . ខេត្ត ស្វាយរៀង . រាជធានី ភ្នំពេញ . ខេត្ត កោះកុង . ខេត្ត ព្រះសីហនុ និង ខេត្ត កំពត ។
ជាមួយគ្នា នេះ ក្រសួង ធនធាន ទឹក ក៏ បាន អំពាវនាវ សូម ប្រជាពលរដ្ឋ បង្កើន ការប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ធម្មជាតិ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ៕
ប្រធាន មន្ទីរ សង្គមកិច្ច រាជធានី ភ្នំពេញ៖ សេវា ជួយ ដល់ កុមារ និង គ្រួសារ រងគ្រោះ ដែល ជួប ហានិភ័យ ត្រូវបាន យកចិត្តទុកដាក់ ខ្ពស់ ពី រដ្ឋាភិបាល កម្ពុជា
( ភ្នំពេញ ) ៖ លោក មុំ ចាន់ ដានី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនិតិសម្បទាន រាជធានី ភ្នំពេញ បាន ថ្លែង ថា ការផ្ដល់ ជំនួយ និង សេវា ជួយ ទៅដល់ កុមារ និង គ្រួសារ រងគ្រោះ . ងាយ រងគ្រោះ ដែល ជួបប្រទះ ហានិភ័យ ត្រូវបាន ការយកចិត្តទុកដាក់ ខ្ពស់ ពី រដ្ឋាភិបាល កម្ពុជា ដោយ មាន ការចូលរួម គាំទ្រ អនុវត្ត ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ព្រមទាំង កិច្ចសហការ ចូលរួម ក្នុង ភាពជាដៃគូរ អភិវឌ្ឍន៍ ពី តាម បណ្ដារ អង្គការ សមាគម អង្គការ សង្គម ស៊ីវិល វិស័យ ឯកជន និង សប្បុរសជន នានា ។
លោក មុំ ចាន់ ដានី បាន បញ្ជាក់ ទៀត ថា កុមារ អនាថា និង គ្រួសារ រងគ្រោះ ងាយ រងគ្រោះ ទាំងនេះ ត្រូវបាន ទទួល ពី អាជ្ញាធរ មូលដ្ឋាន ដែល បាន សង្គ្រោះ និង បញ្ជូន ឱ្យ ទៅ មន្ទីរ សង្គមកិច្ច ដើម្បី ផ្ដល់ សេវា បន្ត ក្រោយពេល បាន យក សំណាក កូវីដ - ១៩ នឹង ធ្វើចត្តាឡី ស័ក ២១ ថ្ងៃ រួចរាល់ ។
( ភ្នំពេញ ) ៖ លោក ហុង សុហួរ ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ ក្រុមហ៊ុន ផ្សារ មូលបត្រ កម្ពុជា នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា គិត មកដល់ ពេលនេះ ផ្សារ មូលបត្រ កម្ពុជា មាន ក្រុមហ៊ុន ចុះបញ្ជី ចំនួន ១៥ និង បាន ប្រមូល ទុន ពី ទីផ្សារ មូលបត្រ សរុប ប្រមាណ ជាង ២៧៧ លាន ដុល្លារ ។
លោក ហុង សុហួរ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « រាប់ ទាំង ថ្ងៃ នេះ ផង ផ្សារ មូលបត្រ កម្ពុជា មាន ក្រុមហ៊ុន ចុះបញ្ជី ចំនួន ១៥ ដែល រួម មាន ក្រុមហ៊ុន ចំនួន ៨ បាន ចុះបញ្ជី ជា ភាគហ៊ុន និង ៧ទៀត បាន ចុះបញ្ជី ជា សញ្ញា បណ្ណ សាជីវកម្ម ( មូលបត្រ បំណុល ) ។ ក្រុមហ៊ុន ទាំង ១៥ នេះ បាន ប្រមូល ទុន ពី ទីផ្សារ មូលបត្រ សរុប ប្រមាណ ជាង ២៧៧ លាន ដុល្លារ » ។
លោក អគ្គ នាយក បញ្ជាក់ ទៀត ថា ក្រុមហ៊ុន មួយចំនួន ទៀត កំពុង ធ្វើការ ជាមួយ ក្រុមការងារ បោះផ្សាយ លក់ មូលបត្រ រាប់ ទាំង ភាគហ៊ុន និង សញ្ញា បណ្ណ ដែល ផ្សារ មូលបត្រ កម្ពុជា រំពឹង ថា នឹង មាន ក្រុមហ៊ុន ស្នើសុំ ចុះបញ្ជី នៅ ផ្សារ មូលបត្រ ជា បន្តបន្ទាប់ ទៀត នៅក្នុង ឆ្នាំ ២០២១ នេះ មិន តិច ជាង ឆ្នាំ ២០២០ ទេ ។
អគ្គ នាយក ផ្សារ មូលបត្រ កម្ពុជា រំពឹង ថា ផ្សារ មូលបត្រ កម្ពុជា នឹង ក្លាយជា ទីកន្លែង វិនិយោគ ដ៏ មាន សក្តានុពល សម្រាប់ អ្នក វិនិយោគ ទាំងឡាយ ដូច នៅក្នុង ប្រទេស ជិតខាង ដោយ ក្លាយជា ប្រភព ទុន ថ្មី មួយ ដែល មិន ចេះ រីងស្ងួត សម្រាប់ ក្រុមហ៊ុន នានា និង ជា ប្រភព ប្រាក់ ចំណូល ថ្មី ( ប្រភព ចំណូល អកម្ម ) សម្រាប់ ប្រជាពលរដ្ឋ ៕
ក្រសួង សុខាភិបាល ទទួល ផលិតផល ខ្ញី ទឹកឃ្មុំ ឌូឌីវី និង សាប៊ូ រ៉េវឡន ពី ក្រុមហ៊ុន គីណូ ឃ៊ែរ ខន ស៊ូម មឺ ដើម្បី ចូលរួម ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ (Video inside) ( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន ទទួល ការឧបត្ថម្ភ ផលិតផល ខ្ញី ទឹកឃ្មុំ ឌូឌីវី និង សាប៊ូ រ៉េវឡន ពី ក្រុមហ៊ុន គីណូ ឃ៊ែរ ខន ស៊ូម មឺ ដើម្បី ចូលរួម ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ និង ដើម្បី ថ្លែងអំណរគុណ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង ដ៏ ធំធេង របស់ ក្រុមការងារ ជួរ មុខ ក្នុង ការរួមចំណែក ជួយ ប្រទេសជាតិ ។
ពិធី ប្រគល់ - ទទួល ផលិតផល ខ្ញី ទឹកឃ្មុំ ឌូឌីវី និង សាប៊ូ វ៉េឡន នេះ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ក្រោម វត្តមាន លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្នុង ក្របខ័ណ្ឌ ទូទាំង ប្រទេស និង លោកស្រី ចាន់ ភារី នាយិកា ក្រុមហ៊ុន គីណូ ឃ៊ែរ ខន ស៊ូម មឺ ខេមបូឌៀ ។
ក្រុមហ៊ុន គីណូ ឃ៊ែរ ខន ស៊ូម មឺ ជា ក្រុមហ៊ុន ដែល បាន នាំចូល នូវ ផលិតផល ថែរក្សា សុខភាព និង គ្រឿង សម្អាង ជាច្រើន មកពី ប្រទេស ឥណ្ឌូណេសី ដែល សព្វ ថ្ងៃ កំពុងតែ ធ្វើចរាចរណ៍ លក់ និង ចែកចាយ ទូទាំង ប្រទេស មាន ផលិតផល ចំនួន ២មុខ ដែល អាច ចូលរួម ក្នុង ការអនុវត្ត នូវ វិធានការណ៍ « ៣កុំ និង ៣ការពារ » ទប់ស្កាត់ នូវ ការរាលដាល នៃ មេរោគ កូវីដ១៩ និង មួយ ចំណែក ទៀត អាច ជួយ ថែទាំ សុខភាព ដល់ បុគ្គលិក សុខាភិបាល រួមទាំង ប្រជាពលរដ្ឋ ដែល កំពុង រងគ្រោះ ដោយសារ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ ។
ក្នុង ន័យ នេះ លោកស្រី ចាន់ ភារី ដែល ជា នាយិកា ក្រុមហ៊ុន ចង់ ចូលរួមចំណែក ក្នុង យុទ្ធនាការ ប្រឆាំង ការរាលដាល នៃ មេរោគ កូវីដ១៩ នេះ តាមរយៈ ការជួយ ឧបត្ថម្ភ ផលិតផល ២មុខ ដូច ខាងក្រោម៖
ទី ២៖ សាប៊ូ រ៉េវឡន ( លាងសំអាត ដៃ និង ដង ខ្លួន ) ជំរះ ភាព កខ្វក់ និង មេរោគ ។ ផលិតផល ទាំង ២មុខ ដែល នឹង ត្រូវ យក ទៅ ចូលរួម ឧបត្ថម្ភ គិត ជា ទឹកប្រាក់ ១១. ៦៤០ ដុល្លារ ៕ អភិបាល ខេត្ត កំពង់ឆ្នាំង ចែក ស្បៀងអាហារ ជូន ពលរដ្ឋ នៅ តំបន់ បិទ ខ្ទប់ ៤៦៥ គ្រួសារ ក្នុង ឃុំ សំរោងសែន ស្រុក កំពង់លែង
( កំពង់ឆ្នាំង ) ៖ លោក ស៊ុន សុវណ្ណ រិទ្ធ អភិបាល ខេត្ត កំពង់ឆ្នាំង នៅ ព្រឹក ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ បាន ដឹកនាំ ក្រុមការងារ ចុះ យក ស្បៀងអាហារ ទៅ ចែកជូន ប្រជាពលរដ្ឋ ចំនួន ៤៦៥ គ្រួសារ នៅក្នុង តំបន់ បិទ ខ្ទប់ ក្នុង ភូមិ ២ នៃ ឃុំ សំរោងសែន ស្រុក កំពង់លែង ។
នៅក្នុង ឱកាស នោះ លោក ចេង ចាន់ ដូណា អភិបាល រង ស្ដី ទី ស្រុក កំពង់លែង បាន រាយការណ៍ ឲ្យដឹង ថា ឃុំ សំរោង សែន មាន ភូមិ ចំណុះ ចំនួន ២ គឺ ភូមិ ប៉ប្រក និង ភូមិ សំរោងសែន ដែល មាន ប្រជាពលរដ្ឋ សរុប ចំនួន ៤៦៥ គ្រួសារ ស្មើនឹង ៣៤២ ខ្នង ផ្ទះ ។ នៅក្នុង សភាពការណ៍ ជំងឺ កូវីដ - ១៩ សហគមន៍ ២០កុម្ភៈ ឃុំ សំរោងសែន មាន ប្រជាពលរដ្ឋ ឆ្លង ជំងឺ កូវីដ - ១៩ សរុប ចំនួន ២០៣ នាក់ ស្រី ១០៨ នាក់ អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ - ១៩ មាន ចំនួន ១១នាក់ ។
កាលពី ថ្ងៃទី ៧ ខែកញ្ញា បាន ធ្វើ សំណាក តេស្ត រកឃើញ អ្នកវិជ្ជមាន កូវីដ១៩ ថ្មី ចំនួន ៨នាក់ ក្នុង នោះ ២នាក់ មាន ជំងឺ កូវីដប ម្លែង ថ្មី ប្រ ភេទ ដែល តា ទើប អាជ្ញាធរ ខេត្ត សម្រេច បិទ ខ្ទប់ ភូមិ ទាំង ២ ខាងលើ នៃ ឃុំ សំរោងសែន នេះ តែម្តង ដោយ ចាប់ពី ថ្ងៃ ទី៧ ខែកញ្ញា មក ។ ដោយឡែក ប្រជាពលរដ្ឋ កំពុង ធ្វើចត្តាឡី ស័ក បច្ចុប្បន្ន ៣៣៥ ខ្នង ផ្ទះ ស្មើនឹង មនុស្ស ចំនួន ១. ១៣១ នាក់ ។
នៅក្នុង ពិធី នេះ ដែរ លោក ស៊ុន សុវណ្ណា រិទ្ធិ បាន បញ្ជាក់ ថា អំណោយ ដែល រដ្ឋ បាល ខេត្ត ពាំនាំយក សាច់ ជូន ប្រជាពលរដ្ឋ នៅ ពេល នេះ គឺជា អំណោយ របស់ សម្ដេច ចៅហ្វា វាំង គង់ សំអុល . បណ្ឌិត សុភាចារ្យ អ៊ុក រ៉ាប៊ុន . លោក គង់ សុផល . បណ្ឌិត សឹង សំណាង និង លោក កែវ វ៉ាន់ ដេត ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ សំរោងសែន ។
ជាមួយគ្នា នេះ ដែរ ត្រូវ ពិនិត្យ តាមដាន នូវ រាល់ ការខ្វះខាត នានា របស់ ប្រជាពលរដ្ឋ នៅក្នុង តំបន់ បិទ ខ្ទប់ គឺ ត្រូវតែ រាយការណ៍ និង ដោះស្រាយ ឲ្យបាន ទាន់ ពេល វេលា ។ ចំពោះ អំណោយ ដែល ត្រូវ ចែកជូន ប្រជា ពលរដ្ឋ ក្នុង តំបន់ បិទ ខ្ទប់ នេះ គឺ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន អង្ករ ២៥ គីឡូ .មី១ កេស . ត្រីខ ១យួរ . ទឹកស៊ី អ៊ីវ១ យួរ . ទឹកត្រី ១យួរ និង ទឹក សុទ្ធ ១យួរ ផងដែរ ។
ដោយឡែក ចំពោះ វិធានការ របស់ រដ្ឋបាល ខេត្ត ទាក់ទង នឹង ជំងឺ កូវីដប ម្លែង ថ្មី ដែល តា នេះ ខេត្ត បាន រៀបចំ កន្លែង ព្យាបាល ជំងឺ ចំនួន ជាង ៦០ កន្លែង នៅក្នុង ស្រុក ៣ មាន ស្រុក រលាប្អៀរ ស្រុក បរិបូណ៌ និង ស្រុក កំពង់ត្រឡាច ដែល អាច ដាក់ អ្នកជំងឺ បាន ជាង ៣ពាន់ នាក់ ។
ចំពោះ ការចាក់ វ៉ាក់ សាំង វិញ នៅក្នុង សប្តាហ៍ នេះ ខេត្ត កំពង់ឆ្នាំង នឹង បញ្ចប់ ការ ចាក់ វ៉ាក់សាំង ដូស ទី១ហើយ ដោយ ចាប់ពី ថ្ងៃទី ១៦ ខែកញ្ញា នេះ ទៅ គឺ បន្ត ចាក់ដូស ទី២ ដោយ ត្រូវ សម្រុក ចាក់ ឱ្យ រួចរាល់ ក្នុង រយៈពេល ២សប្តាហ៍ បន្ត ទៀត ឲ្យ អស់ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត តែម្តង ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន៖ សាលារៀន និង គ្រឹះស្ថាន អប់រំ ជា កន្លែង ប្រមូលផ្តុំ ក្នុង ការផ្លាស់ប្តូរ ទម្លាប់ ផ្នត់គំនិត និង ឥរិយាបថ របស់ កុមារ និង យុវជន ចំពោះ អនាម័យ និង បរិស្ថាន
( ភ្នំពេញ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន ថ្លែង ថា សាលារៀន និង គ្រឹះស្ថាន អប់រំ ជា កន្លែង ប្រមូលផ្តុំ មាន លក្ខណៈ ងាយ ស្រួល ក្នុង ការបញ្រ្ជាប ចំណេះដឹង និង ចំណេះ ធ្វើ ក្នុង ចំណោម កុមារ សិស្សានុសិស្ស និង យុវជន ផ្លាស់ប្តូរ ទម្លាប់ ផ្នត់គំនិត និង ឥរិយាបថ ពួកគេ ចំពោះ អនាម័យ និង បរិស្ថាន ។
សាលា បឋមសិក្សា វត្ត ចែង ជា ជ័យលាភី លេខ១ សាលា មេត្រី បរិស្ថាន ផ្នែក បឋមសិក្សា ក្នុង ការប្រឡង ប្រណាំង សាលា មេត្រី បរិស្ថាន រៀងរាល់ ២ឆ្នាំ ម្តង លើក ទី៣ ឆ្នាំ ២០២១ នេះ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន បាន បន្ត ថា សាលា វត្ត ចែង បាន ទទួល នូវ ជ័យលាភី មេដាយ មាស ក្នុង ការប្រកួតប្រជែង សាលា មេត្រី បរិស្ថាន នេះ គឺ បង្ហាញ ពី កិច្ច ខិតខំប្រឹង ប្រែង និង គំនិត ច្នៃប្រឌិត ខ្ពស់ និង ភាព ជា អ្នកដឹកនាំ របស់ ថ្នាក់ដឹកនាំ សាលា ដោយ មាន ការចូលរួម គាំទ្រ ពី សិស្សានុសិស្ស មាតាបិតា សហគមន៍ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ ជាពិសេស រដ្ឋបាល ខេត្ត បាត់ដំបង ដែល បាន ចូលរួម គាំទ្រ អនុវត្ត នូវ គោល នយោបាយ ពាក់ព័ន្ធ នឹង វិស័យ បរិស្ថាន ។
នា ឱកាស នោះ ដែរ លោក នេត្រ ភក្ត្រា បាន បន្ត ថា ការខិតខំ ប្រឹងប្រែង របស់ គ្រប់ ភាគី ពាក់ព័ន្ធ ឥឡូវនេះ បាន ទទួល ផ្លែ ផ្កា គឺ ការទទួលបាន ជ័យលាភី មេដាយ មាស សាលា មេត្រី បរិស្ថាន ដែល នេះ ជា មោទកភាព របស់ ខេត្ត បាត់ដំបង និង ជា ការទទួលស្គាល់ នូវ កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា លើ ការ ក សាង ថ្នាល បណ្តុះបណ្តាល ធនធាន មនុស្ស ប្រកបដោយ គុណភាព មាន មេត្រីភាព បរិស្ថាន និង ផាសុកភាព ។
បន្ថែម ពី នេះ លោក រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន បាន បញ្ជាក់ ថា ការប្រឡង ប្រណាំង សាលា មេត្រី បរិស្ថាន គឺជា គំនិត ផ្តួចផ្តើម ដ៏ សំខាន់ និង ជា យន្តការ មួយ ដ៏ មាន សារៈសំខាន់ ក្នុង ចំណោម យន្តការ និង វិធានការ ជាច្រើន ទៀត ដែល ក្រសួង បរិស្ថាន និង ភាគី ពាក់ព័ន្ធ ទាំងអស់ បាន ខិតខំ ជំរុញ អនុវត្ត ជា បន្តបន្ទាប់ សំដៅ ធ្វើឱ្យ ប្រសើរឡើង នូវ កិច្ច គាំពារ បរិស្ថាន ការការពារ ធនធាន ធម្មជាតិ ការអភិរក្ស ជីវៈ ចម្រុះ និង ការរស់នៅ ដោយ ចីរភាព ។
បើ តាម លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង បាន ថ្លែង ថា ក្នុង នាម ពលរដ្ឋ ខេត្ត បាត់ដំបង បាន សម្តែង នូវ ការអបអរសាទរ ចំពោះ ជ័យលាភី របស់ សាលា បឋមសិក្សា វត្ត ចែង ក្នុង ឃុំ អូរ ដំបង ១ ស្រុក សង្កែ ខេត្ត បាត់ដំបង ដែល ទទួលបាន នូវ ជ័យលាភី ក្នុង ចំណោម សាលា បឋមសិក្សា នៅ ទូទាំង ប្រទេស ដែល នេះ ជា ការខិតខំ ប្រឹងប្រែង រួម ជាមួយ អ្នក ពាក់ព័ន្ធ និង ថ្នាក់ដឹកនាំ សាលា នៅ ទីនេះ ។
( ភ្នំពេញ ) ៖ លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ទទួល គ្រឿង ឧបភោគ បរិភោគ និង សំភារៈ ប្រើប្រាស់ មួយចំនួន ពី ក្រុមហ៊ុន ឆ្នោត មហាសំណាង នៅ សាលា រាជធានី ភ្នំពេញ ដើម្បី ទុក ប្រើប្រាស់ ប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ។
លោក កើត ឆែ បាន បន្ត ថា ទឹកចិត្ត សប្បុរស ធម៌ ដ៏ ថ្លៃថ្លា មួយ នេះ ស្តែង ឱ្យ ឃើញ អំពី ការគិតគូរ និង ក្ដី អាណិត ស្រលាញ់ ចំពោះ ជន រួម ជាតិ ដោយ ឈរ លើ បុព្វហេតុ ជាតិ សាមគ្គី ជា ធ្លុង មួយ ក្នុង ស្មារតី ជួយ គ្នា នៅក្នុង កាលៈទេសៈ ដែល ប្រទេសជាតិ បាន និង កំពុង ជួបប្រទះ នឹង គ្រោះ ភ័យ នៃ ការរាតត្បាត់ ពី ជំងឺ កូវីដ - ១៩ ។ សមាន ចិត្ត ដ៏ ប្រពៃ នេះ នឹង ត្រូវបាន ចងចាំ ទុក ដោយ រាជ រដ្ឋាភិបាល រដ្ឋបាល រាជធានី ភ្នំពេញ និង ប្រជាជន កម្ពុជា ទាំងអស់ ផងដែរ ។
តំណាង ក្រុមហ៊ុន ឆ្នោត មហាសំណាង ( ទឹក ច្រើន ឈ្នះ ច្រើន ) ក៏ បាន សន្យា ផងដែរ ថា ក្រុមហ៊ុន នៅតែ បន្ត ជួយ ជានិច្ច ទាំង គ្រឿង ឧបភោគ បរិភោគ សម្ភារ និង ថវិកា ទៅ តាម លទ្ធភាព និង តាម រយះ « មូលនិធិ មហាសំណាង » ដល់ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ ដូចជា តាម បណ្ដារ រដ្ឋបាល ខណ្ឌ និង សង្កាត់ ដើម្បី បន្ត ជួយ ដល់ ប្រជាពលរដ្ឋ ដែល ងាយ រងគ្រោះ គ្រប់ ប្រភេទ ក្នុង ការចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ។
រដ្ឋមន្ដ្រី ក្រសួង រ៉ែ ផ្ញើ លិខិត ចូលរួម រំលែក ទុក្ខ ជូន លោកស្រី បណ្ឌិត សភាចារ្យ ខ្លូត ធីតា និង ក្រុមគ្រួសារ ចំពោះ មរណភាព លោក មន់ សម្បត្តិ
( ភ្នំពេញ ) ៖ លោក ស៊ុយ សែម រដ្ឋមន្ដ្រី ក្រសួង រ៉ែ និង ថាមពល និង ភរិយា ព្រមទាំង ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ក្រោម ឱវាទ ទាំងអស់ នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ លិខិត ចូលរួម រំលែក ទុក្ខ ជូន លោកស្រី បណ្ឌិត សភាចារ្យ ខ្លូត ធីតា និង ក្រុមគ្រួសារ ចំពោះ មរណភាព លោក មន់ សម្បត្តិ ។
សារលិខិត បាន បញ្ជាក់ ថា « ខ្ញុំ និង ភរិយា មាន ក្តី រំជួល ចិត្ត ឥត ឧបមា ដោយ បាន ទទួល ដំណឹង ថា ឯកឧត្តម មន់ សម្បត្តិ ត្រូវ ជា ស្វាមី របស់ លោកជំទាវ បាន ទទួល មរណភាព កាលពី ថ្ងៃអង្គារ១ កើត ខែ ភទ្រប ទ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស .២៥៦៥ ត្រូវនឹង ថ្ងៃទី ៧ ខែកញ្ញា ឆ្នាំ ២០២១ វេលា ម៉ោង ១៧៖០៥ ក្នុង ជន្មាយុ ៨០ ឆ្នាំ ដោយ រោគា ពាធ ។
មរណភាព របស់ ឯកឧត្តម មន់ សម្បត្តិ គឺជា ការបាត់បង់ នូវ ស្វាមី ឪពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ ដ៏ ល្អ និង សង្គហធម៌ ដ៏ ជ្រាលជ្រៅ ចំពោះ ភរិយា កូន ៗ និង ចៅ ៗ ជាទី ស្រលាញ់ និង ជា ការបាត់បង់ នូវ ធនធាន មនុស្ស ដ៏ សំខាន់ មួយ រូប ដែល បាន រួមចំណែក យ៉ាង សកម្ម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង បុព្វហេតុ បម្រើ ជាតិ មាតុភូមិ កន្លងមក ។
ក្នុង វេលា ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ ខ្ញុំ និង ភរិយា សូម សម្តែង នូវ ការសោកស្តាយ និង ក្តី អាឡោះអាល័យ ជា ទីបំផុត ជាមួយ លោកជំទាវ និង ក្រុមគ្រួសារ និង សូម ឧទ្ទិស បួងសួង ដល់ ដួង វិញ្ញាណក្ខន្ធ ឯកឧត្តម យន់ សម្បត្តិ សូម ឆាប់ បាន ចាប់កំណើត ក្នុង សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ព័ត៌មាន ផ្ដល់ គន្លិះ សំខាន់ ៗ ចំនួន ៧ ចំណុច ក្នុង ការចូលរួម ទប់ស្កាត់ អំពើ ជួញដូរ មនុស្ស ក្នុង បរិបទ កូវីដ - ១៩
លោក បន្ត ថា លោក លោកស្រី អាច គិត ថា ក្រុមគ្រួសារ របស់ លោក លោកស្រី មិន កើតមាន បញ្ហា នេះ ទេ តែ ចុះ សាច់ញាតិ ជិត ឆ្ងាយ របស់ ខ្លួន តើ ពួកគាត់ អាច គេចផុត ទេ ? ចុះ គ្រួសារ ខ្មែរ ដទៃ ទៀត អាច គេចផុត ទេ ? នេះ ហើយ ដែល ហៅ ថា បញ្ហា រួម ។ យើង មិន មាន សមត្ថកិច្ច ក្នុង ការចាប់ ចង ឃាត់ឃាំង អី ទេ ប៉ុន្តែ យើង មាន សិទ្ធិ ក្នុង ការផ្តល់ ព័ត៌មាន ការអប់រំ និង ការផ្សព្វផ្សាយ អំពី ការប្រឈម ។
ចំណុច សំខាន់ ៗ ក្នុង ការចូលរួម ទប់ស្កាត់ អំពើ ជួញដូរ មនុស្ស ក្នុង បរិបទ បច្ចុប្បន្ន រួម មាន៖
( ប៉េកាំង ) ៖ គិត ពី ខែកញ្ញា ឆ្នាំ ២០១៣ មក ទល់ បច្ចុប្បន្ន នេះ គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » ដែល លើកឡើង ដោយ លោក ស៊ី ជីន ភីង ប្រធាន រដ្ឋ ចិន បាន គម្រប់ ៨ឆ្នាំ ហើយ ។ ក្នុង រយៈពេល ៨ឆ្នាំ កន្លងទៅ នេះ គំនិត ផ្តួចផ្តើម នេះ បាន វិវត្តន៍ ទៅ រក ភាព ចាស់ទុំ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ដែល មាន វិសាលភាព និង ឥទ្ធិពល យ៉ាង ទូលំទូលាយ ពោលគឺ បាន និង កំពុង ក្លាយជា សរសៃ ឈាម ថ្មី នៃ សេដ្ឋកិច្ច ពិភពលោក ។
យើង ងាក មក មើល ពី « ខ្សែក្រវាត់ និង ផ្លូវ » ដែល ជា ពាក្យ ហៅ កាត់ នៃ « ខ្សែក្រវាត់ សេដ្ឋកិច្ច ផ្លូវ សូត្រ » និង « ផ្លូវ សូត្រ សមុទ្រ ប្រចាំ សតវត្សរ៍ ទី ២១ » នា សម័យ បច្ចុប្បន្ន វិញ គឺ មាន វិសាលភាព កាន់តែ ធំ ទូលាយ និង ទទួលបាន ការទទួលស្គាល់ និង ចូលរួម ពីសំណាក់ ប្រទេស និង តំបន់ ជា ដៃគូ យ៉ាង ច្រើន ដើម្បី រួមគ្នា ចែករំលែក ពី សមិទ្ធផល នៃ ការរួមគ្នា កសាង រួមគ្នា អភិវឌ្ឍ ក្នុង ន័យ សម្រេចបាន នូវ វិបុលភាព រួម ដែល ជា បំណងប្រាថ្នា នៃ ប្រជាជន ទូទាំង ពិភពលោក ។
គិត ត្រឹម ចុង ខែមករា ឆ្នាំ ២០២១ នេះ មាន ប្រទេស ចំនួន ១៤០ និង អង្គការ អន្តរជាតិ ចំនួន ៣១ បាន ចុះហត្ថលេខា លើ ឯកសារ សហប្រតិបត្តិការ ស្តីពី ការរួមគ្នា កសាង « ខ្សែក្រវាត់ និង ផ្លូវ » ចំនួន ២០៥ ឯកសារ ជាមួយ ប្រទេស ចិន ដែល សបង្ហាញ ថា គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » បាន ក្លាយជា វេទិកា សហប្រតិបត្តិការ អន្តរជាតិ ដ៏ ធំ បំផុត នៅលើ ពិភពលោក ។
ពិសេស ក្រោយពី ប្រទេស ទាំង ពីរ កម្ពុជា និង ចិន បាន សន្មត គ្នា ជា « មិត្ត ដែក ថែប » មក កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ មាន ភាព កាន់តែ ស្អិត ល្មួត ចំណែកឯ គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » បាន ដើរ តួនាទី ជា កម្លាំង ចលករ ដែល ស៊ី ចង្វាក់ គ្នា ជាមួយ « យុទ្ធសាស្ត្រ ចតុកោណ » របស់ កម្ពុជា ។ តាមរយៈ ទិន្នន័យ ស្តីពី ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី ដែល កើនឡើង ជា បន្តបន្ទាប់ យើង មិន ពិបាក មើលឃើញ ទេ ថា ប្រទេស ទាំង ពីរ ជា ដៃគូ សហប្រតិបត្តិការ ដែល មាន អំណោយផល ពី ធម្មជាតិ ។
ក្រៅពី កម្ពុជា ដែល ទទួលបាន ផល ជាក់ស្តែង ជា បន្តបន្ទាប់ពី គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » បណ្តា ប្រទេសជា ដៃគូ ដទៃ ទៀត លើ ពិភពលោក ក៏ ទទួលបាន ផល ទៅ វិញ ទៅមក តាមរយៈ ការរួមគ្នា កសាង « ខ្សែក្រវាត់ និង ផ្លូវ » ផងដែរ ។ ពិសេស គឺ ប្រទេស កំពុង អភិវឌ្ឍន៍ ដែល បាន តភ្ជាប់ គោល នយោបាយ ឬ យុទ្ធសាស្ត្រ ជាតិ របស់ ខ្លួន ជាមួយ គំនិត ផ្តួចផ្តើម នេះ សុទ្ធសឹងតែ ទទួលបាន សមិទ្ធផល លើ វិស័យ ជាច្រើន ដើម្បី អភិវឌ្ឍ ប្រទេសជាតិ ក៏ ដូចជា លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាជន ។
ដោយ៖ តាំង ស៊ី ឡេង ជា បុគ្គលិក នៃ វិទ្យុ មិត្តភាព កម្ពុជា - ចិន អភិបាល ខណ្ឌ ចំការមន៖ ពេល បើក ដំណើរការ សាលារៀន ឡើងវិញ នោះ នឹង មាន ក្រុម គ្រូពេទ្យ ប្រចាំ ការតែម្តង
លោក ថេង សុថុល បាន បញ្ជាក់ ថា ការធ្វើ អនាម័យ នៅ ពេល នេះ ដើម្បី ប្រាកដ ថា ទីតាំង សាលា ទាំងមូល មាន អនាម័យ និង មិន ឲ្យ សិស្ស ក៏ ដូចជា អាណាព្យាបាល មាន ការព្រួយបារម្មណ៍ នៅពេល ត្រឡប់ ចូល សិក្សា វិញ ។
លោក នាយក វិទ្យាល័យ បឹងត្របែក បាន ឲ្យដឹង ដែរ ថា សិស្សានុសិស្ស នៃ វិទ្យាល័យ ទួល ទំពូង ប្រមាណ ជា ៨៥% ហើយ ក្នុង ចំណោម សិស្ស ប្រមាណ ៦០០ នាក់ បាន ទទួល នូវ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ខណៈ សិស្ស ដែល មិន បាន ចាក់ វ៉ាក់សាំង នោះ គឺ ពួកគាត់ មាន ជំងឺ ប្រចាំ កាយ ។
លោក បាន លើកឡើង ថា ក្រោយពី ផ្ទុះឡើង នៅ ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ សាលារៀន នៅ ទូទាំង ប្រទេស ក៏ ដូចជា វិទ្យាល័យ បឹងត្របែក បាន បិទ ជា បណ្ដោះអាសន្ន ដោយ បាន ឲ្យ សិស្សានុសិស្ស ទាំងអស់ រៀន តាម ប្រព័ន្ធ អនឡាញ ។ តែ យ៉ាងណា លោក នាយក បាន បញ្ជាក់ ថា ការរៀន តាម Online របស់ សិស្សានុសិស្ស គឺ ទទួលបាន ការបង្រៀន យ៉ាង យកចិត្តទុកដាក់ ពី លោកគ្រូ អ្នកគ្រូ នៃ វិទ្យាល័យ បឹងត្របែក និង មាន ការសហការ ល្អ ផងដែរ ពី មាតាបិតា របស់ សិស្សានុ សិស្ស ផ្ទាល់ ។
សូម រំលឹក ថា យោង តាម សារជា សំឡេង នៅ ព្រឹក ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ស្នើ ឱ្យ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួនណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា ធ្វើ ការពិភាក្សា ជាមួយ អភិបាល ខេត្ត - រាជធានី ដើម្បី កំណត់ បើក ទីតាំង សាលារៀន នៅ តាម ទីតាំង មួយចំនួន ដែល ពុំ មាន ជំងឺ ឆ្លង កើតឡើង ។
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ឌី វិជ្ជា អគ្គ ស្នងការ រង និង ជា ប្រធាន នាយកដ្ឋាន កណ្តាល សន្តិសុខ . ឧត្តមសេនីយ៍ ឯក យឹម លាង អគ្គ ស្នងការ រង និង ឧត្តមសេនីយ៍ ឯក ជុំ សុវុធ ប្រធាន នាយកដ្ឋាន អង្គរក្ស នៅ ព្រឹក ថ្ងៃពុធ ទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១ បាន អញ្ជើញ ជួបប្រជុំ ជាមួយ លោក លី ជីង ហ្វឹង អនុព័ន្ធ យោធា អម ស្ថានទូត ចិន និង លោក ចាង ពីង មន្ត្រី ទំនាក់ទំនង កិច្ចការ ប៉ូលីស ស្ថានទូត ចិន ។
