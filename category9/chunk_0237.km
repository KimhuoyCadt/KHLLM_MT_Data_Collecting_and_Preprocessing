( ព្រៃវែង ) ៖ រដ្ឋបាល ខេត្ត ព្រៃវែង នា ថ្ងៃទី ៩ ខែកញ្ញា នេះ បាន រកឃើញ ករណី អ្នកវិជ្ជមាន កូវីដ - ១៩ ចំនួន ២៨ នាក់ ជាសះស្បើយ ចំនួន ៤០ នាក់ និង ស្លាប់ ចំនួន ១នាក់ នៅ មូលដ្ឋាន ក្នុង ក្រុង / ស្រុក ចំនួន ១០ មកពី ខេត្ត កណ្ដាល និង មកពី ខេត្ត ត្បូងឃ្មុំ ។
ជាថ្មី ម្តង ទៀត រដ្ឋបាល ខេត្ត បាន អំពាវនាវ ចំពោះ អ្នក ដែល បាន ប្រាស្រ័យទាក់ទង ប៉ះពាល់ ដោយ ផ្ទាល់ ឬ ប្រយោល ជាមួយ បុគ្គល វិជ្ជមាន កូវីដ១៩ ខាងលើ សូម ដាក់ ខ្លួន ដាច់ដោយឡែក តាមដាន សុខភាព រយៈពេល ១៤ ថ្ងៃ និង រាយការណ៍ មក អាជ្ញាធរ ដើម្បី យក សំណាក និង ធ្វើចត្តាឡី ស័ក ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត ព្រៃវែ ង៖
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០២១
១៖ កិច្ចប្រជុំ កំពូល មហា អនុ តំបន់ មេគង្គ លើក ទី៧ ចេញ សេចក្តីថ្លែងការណ៍ រួម ២០ ចំណុច
៣៖ រាជ រដ្ឋាភិបាល ប្រកាស ពី លទ្ធផល កិច្ចប្រជុំ កំពូល មហា អនុ តំបន់ មេគង្គ លើក ទី៧ តាម ប្រព័ន្ធ វីដេអូ ដែល សម្តេច តេជោ ធ្វើជា ប្រធាន
៥៖ សម្តេច តេជោ ហ៊ុន សែន៖ កិច្ចសហប្រតិបត្តិការ សាមគ្គីភាព ក្រោម យន្តការ ពហុ ភាគី និយម ជា គន្លឹះ សំខាន់ ក្នុង ការកសាង ប្រទេស មហា អនុ តំបន់ ទន្លេ មេគង្គ ពី វិបត្តិ ជំងឺ កូវីដ១៩
៧៖ សម្តេច តេជោ ហ៊ុន សែន វាយតម្លៃ ខ្ពស់ ចំពោះ តួនាទី ចិន ក្នុង ការផ្គត់ផ្គង់ វ៉ាក់សាំង នៅក្នុង តំបន់ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការផ្តល់ ជំនួយ វ៉ាក់សាំង ដល់ ប្រជាជន កម្ពុជា
៨៖ ចិន នឹង ធ្វើឱ្យ កំណែទម្រង់ និង ការបើក ទូលាយ ក្នុង តំបន់ សហប្រតិបត្តិការ Qianhai មាន ភាព កាន់តែ ស៊ីជម្រៅ និង គ្រប់ ជ្រុងជ្រោយ ដើម្បី គាំទ្រ ការអភិវឌ្ឍ នៃ សេដ្ឋកិច្ច និង សង្គមកិច្ច ហុង ហុង
៩៖ ប្រទេស មហា អនុ តំបន់ ទន្លេ មេគង្គ ដាក់ ចេញ ផែនការឆ្លើយតប និង ស្តា ប្រទេស ពី វិបត្តិ ជំងឺ កូវីដ១៩ . សម្តេច តេជោ ជំរុញ ពង្រឹង បន្ថែម កិច្ចសហប្រតិបត្តិការ ដើម្បី ដោះស្រាយ វិបត្តិ
១០៖ បារាំង នឹង ផ្ដល់ សេវា ពន្យារ កំណើត ដោយ ឥត គិត ថ្លៃ សម្រាប់ ស្រ្តី រហូតដល់ អាយុ ២៥ ឆ្នាំ
១២៖ កូរ៉េ ខាងជើង ទទួលស្គាល់ ការធ្វើ ព្យុហយាត្រា យោធា ក្រោម អធិបតីភាព លោក គីម ជុង អ៊ុន
១៣៖ រដ្ឋបាល រាជធានី ភ្នំពេញ សម្រេច បន្ត វិធានការ រដ្ឋបាល ផ្អាក សកម្មភាព ការងារ មុខរបរ ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង ជំងឺ កូវីដ១៩ និង ការជួបជុំ ជា លក្ខណៈ ឯកជន រយៈពេល ១៤ ថ្ងៃ ថែម ទៀត
ខេត្ត កំពង់ធំ ប្រកាស រកឃើញ អ្នកវិជ្ជមាន កូវីដ១៩ ចំនួន ៣៣ នាក់ និង ជាសះស្បើយ ចំនួន ២៧ នាក់
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ផងដែរ ថា សម្រាប់ អ្នក ជាសះស្បើយ មាន ចំនួន ២៧ នាក់ ផងដែរ ។
ដើម្បី ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បន្ថែម ទៀត រដ្ឋបាល ខេត្ត សូម អំពាវនាវ ដល់ អ្នក ដែល ធ្លាប់ ប្រាស្រ័យទាក់ទង ជាមួយ អ្នកវិជ្ជមាន ខាងលើ សូម រួសរាន់ ទំនាក់ទំនង ទៅ អាជ្ញាធរ ឬ មណ្ឌល សុខភាព ដែល នៅ កៀក បំផុត ដើម្បី ពិនិត្យ សុខភាព និង ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ឱ្យ បាន ត្រឹមត្រូវ ៕
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត កំពង់ធំ៖
អភិបាល ខេត្ត ព្រៃវែង ចុះ ពិនិត្យ ស្ថានភាព ជាក់ស្តែង ដើម្បី ត្រៀម បើក ដំណើរការ សាលារៀន ឡើងវិញ នា ពេល ខាងមុខ នេះ
( ព្រៃវែង ) ៖ លោក ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង នា រសៀល ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០២១ បាន ដឹកនាំ មន្ទីរ អង្គភាព អាជ្ញាធរ ពាក់ព័ន្ធ ចុះ ពិនិត្យ ស្ថានភាព ជាក់ស្ដែង និង មើល លើ ការរៀបចំ វិទ្យាល័យ ព្រះអង្គ ឌួង ស្ថិត នៅ ភូមិ ៣ សង្កាត់ កំពង់លាវ ក្រុង ព្រៃវែង និង វិទ្យាល័យ សម្តេច តេជោ ហ៊ុន សែន ស្រុក ពារាំង ខេត្ត ព្រៃវែង ដើម្បី ត្រៀម ក្នុង ការបើកឲ្យ ដំណើរការចូលរៀន ឡើងវិញ នា ពេល ខាងមុខ នេះ ។
លោក ជា សុមេធី បាន លើកឡើង ថា ការចុះ ពិនិត្យ ស្ថានភាព ជាក់ស្តែង នៃ ការរៀបចំ សាលារៀន ដើម្បី បើក ឲ្យ ដំណើរការ ឡើងវិញ នៅពេល ខាងមុខ នេះ ដោយ យោង តាម អនុសាសន៍ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ឲ្យ អភិបាល រាជធានី - ខេត្ត ត្រូវ ត្រៀម រៀបចំ បើក សាលារៀន ឡើងវិញ នៅ តំបន់ ដែល គ្មាន ការឆ្លង និង មាន ការឆ្លង ចំនួន តិច នៃ ជំងឺ កូវីដ១៩ ។
លោក អភិបាល ខេត្ត ក៏ ស្នើសុំ ដល់ អភិបាល ក្រុង ស្រុក ទាំង ១៣ ត្រូវ ចុះ រៀបចំ ឡើងវិញ នូវ ហេដ្ឋារចនាសម្ព័ន្ធ នៅក្នុង សាលារៀន ទាំងអស់ ក្នុង ភូមិសាស្ត្រ ក្រុង - ស្រុក នីមួយ ៗ ជាពិសេស កាលពី កន្លងមក សាលារៀន មួយចំនួន ត្រូវបាន យក ធ្វើជា កន្លែង សម្រាប់ ចត្តាឡី ស័ក និង ជា កន្លែង សម្រាប់ ព្យាបាល អ្នកជំងឺ កូវីដ១៩ ត្រូវ រៀបចំ ឲ្យបាន ស្អាត ឡើងវិញ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត បាន ស្នើឲ្យ ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ពិនិត្យ និង ណែនាំ តាម សាលា នីមួយ ៗ ជាពិសេស នាយក សាលា នីមួយ ៗ ត្រូវ សហការ ជាមួយនឹង មន្ទីរពេទ្យ បង្អែក ការិយាល័យ អប់រំ ស្រុក និង អភិបាល ស្រុក និមួយ ៗ ដើម្បី ពិនិត្យ និង វាយតម្លៃ មើល លទ្ធភាព ទីតាំង ដែល មាន ហានិភ័យ ទាប ហានិភ័យ មធ្យម និង ហានិភ័យ ខ្ពស់ មុននឹង ស្នើសុំ បើក សាលា ឡើងវិញ ។
