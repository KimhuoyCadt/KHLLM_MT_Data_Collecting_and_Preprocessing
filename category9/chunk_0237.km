( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២០ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ២ករណី និង ជួញដូរ ១៨ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤២ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ នេះ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៤.០០៥ ករណី ឃាត់ មនុស្ស ៨. ៩៣៣ នាក់ ( ស្រី ៥៣១ នាក់ )៕ ប្រទះឃើញ សាកសព បុរស វ័យ ជាង ៤០ ឆ្នាំ ម្នាក់ ត្រូវ គេ កប់ ចោល នៅ ស្រុក គាស់ ក្រឡ ខេត្ត បាត់ដំបង សង្ស័យ ជា រឿង ឃាតកម្ម
( បាត់ដំបង ) ៖ ប្រជាពលរដ្ឋ ក្នុង ភូមិ បាន នាំគ្នា ប្រទះឃើញ សាកសព បុរស វ័យ ជាង ៤០ ឆ្នាំ ម្នាក់ ដែល ត្រូវបាន គេ យក ទៅ កប់ ដី ក្នុង ដី ទំនេរ មួយ កន្លែង ។ ហេតុការណ៍ ប្រទះឃើញ សាកសព នេះ បាន កើតឡើង នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ ត្រង់ ដីឡូតិ៍ ទុកចោល មួយ កន្លែង ឋិត នៅក្នុង ក្រុម ទី ២ ភូមិ បា ស្រែ ឃុំ ដូន បា ស្រុក គាស់ ក្រឡ ខេត្ត បាត់ដំបង ។
លោក វរសេនីយ៍ ឯក ប៉ាង ហៀង អធិការ នគរបាល ស្រុក គាស់ ក្រឡ បាន បញ្ជាក់ ប្រាប់ ថា សាកសព ជនរងគ្រោះ មាន ឈ្មោះ យ៉ង សារ៉ាត់ ហៅ តាក់ ភេទ ប្រុស ឣា យុ៤៥ ឆ្នាំ រស់ នៅ ភូមិ ព្រៃ ភ្ងាស់ ឃុំ ដូន បា មាន ជំងឺ សរសៃ ប្រសាទ ជាប់ នឹង ខ្លួន ។
ក្រោយ ការពិនិត្យ ធ្វើ កោសល្យវិច្ឆ័យ ក្រុម នគរបាល ជំនាញ បាន រកឃើញ ស្លាកស្នាម មួយ ចំនួន ដែល វាយ ដោយ វត្ថុ រឹង ត្រូវ ផ្ទៃ មុខ ខាងឆ្វេង និង ក្បាល ផ្នែក ខាងក្រោយ ចំហៀង ខាងស្តាំ សាកសព មាន សភាព ហើម និង រលួយ ធុំ ក្លិន ។
ប្រភព ពី ប្រជាពលរដ្ឋ ជា អ្នករក អុស ដែល ប្រទះឃើញ បញ្ជាក់ ថា ដំបូង គាត់ បាន ឃើញ ដាន អាចម៍ ដី ដែល លុប ជា រណ្តៅ ជម្រៅ ប្រហែល កន្លះ ម៉ែត្រ ហើយ ដាក់ ការសង្ស័យ រួច គាត់ ក៏ ឆ្កឹះ កាយ ដី មើល ក៏ ធុំ ក្លិន ស្អុយ ក៏ មាន ការភ្ញាក់ផ្អើល និង រាយការណ៍ ដល់ សមត្ថកិច្ច តែម្តង ។
ករណី ឃាតកម្ម ខាងលើ នេះ កម្លាំង ផ្នែក ជំនាញ កំពុង បើក ការស្រាវជ្រាវ ដើម្បី ស្វែងរក ជន បង្ក ពិតប្រាកដ យកមក ផ្តន្ទាទោស តាម ច្បាប់ ៕
រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង បញ្ចប់ ការបិទ ខ្ទប់ ភូមិសាស្ដ្រ ក្រុង ស្ទឹងត្រែង ប៉ុន្ដែ ដាក់ ចេញ វិធានការ រដ្ឋបាល និង វិធានការ សុវត្ថិភាព ផ្នែក សុខាភិបាល
( ស្ទឹងត្រែង ) ៖ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីសម្រេច បញ្ចប់ ការបិទ ខ្ទប់ ជា បណ្ដោះអាសន្ន ភូមិសាស្ដ្រ « ក្រុង ស្ទឹងត្រែង ខេត្ត ស្ទឹងត្រែង » និង មូលដ្ឋាន បិទ ខ្ទប់ មួយចំនួន និង ដាក់ចេញ នូវ វិធានការ រដ្ឋបាល និង វិធានការ សុវត្ថិភាព ផ្នែក សុខាភិបាល ដើម្បី បន្ដ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។
បើ ទោះបី បញ្ចប់ ការបិទ ខ្ទប់ ប៉ុន្ដែ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង បាន កំណត់ ឲ្យ បន្ដ អនុវត្ត វិធានការ និង វិធានការ សុវត្ថិភាព ផ្នែក សុខាភិបាល ដើម្បី ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ដ្រ ខេត្ត ស្ទឹងត្រែង ដែល រួម មាន៖
* ផ្អាក ជា បណ្ដោះអាសន្ន សកម្មភាព មុខរបរ និង អាជីវកម្ម ក្លឹប កម្សាន្ដ គ្រប់ ប្រភេទ រមណីយដ្ឋាន និង សួន កម្សាន្ដ នានា * ផ្អាក ជា បណ្ដោះអាសន្ន អាជីវកម្ម ម៉ាស្សា * ផ្អាក ជា បណ្ដោះអាសន្ន ហាង លក់ និង សេព គ្រឿងស្រវឹង គ្រប់ ប្រភេទ * ផ្អាក ជា បណ្ដោះអាសន្ន ក្លឹប ហាត់ប្រាណ ទីតាំង លេខ កីឡា គ្រប់ ប្រភេទ * ផ្អាក ជា បណ្ដោះអាសន្ន ការជួបជុំ មាន មនុស្ស ច្រើន ខុសពី វិធាន សុវត្ថិភាព សុខាភិបាល ក្នុង មូលដ្ឋាន ក្រុង ស្ទឹងត្រែង ចាប់ពី ម៉ោង ២៣៖ ៥៩ នាទី យប់ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ ត ទៅ រហូតដល់ មាន សេចក្ដីសម្រេច ថ្មី ។
បន្ថែម ពី នេះ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង បាន កំណត់ នូវ ការអនុវត្ត បំរាម គោចរ ពី ចន្លោះ ម៉ោង ២១ យប់ ដល់ ម៉ោង ៣ភ្លឺ សម្រាប់ ភូមិសាស្ដ្រ ក្រុង ស្ទឹងត្រែង និង ទីប្រជុំជន នានា ក្នុង មូលដ្ឋាន ស្រុក ទាំង៥ និង បន្ដ អនុវត្ត វិធានការ សុខាភិបាល ក្នុង ការបំពេញ កាតព្វកិច្ច ពាក់ ម៉ាស និង គម្លាត សុវត្ថិភាព បុគ្គល និង សង្គម ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
សូម ជម្រាប ថា កាលពី ពេល កន្លងទៅ បន្ទាប់ រកឃើញ មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ប្រភេទ បំប្លែង ខ្លួន ថ្មី នៅ មូលដ្ឋាន ក្រុង ស្ទឹងត្រែង នោះ រដ្ឋបាល ខេត្ត បាន ចេញ សេចក្ដីសម្រេច បិទ ខ្ទប់ ភូមិសាស្ដ្រ ក្រុង នេះ ជា បណ្ដោះអាសន្ន ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ពិសេស ពួក បំប្លែង ខ្លូន ថ្មី តែម្ដង ៕
លោក លឹម ហ៊ុយ ឡេង ចេញ លិខិត បំភ្លឺ ពាក់ព័ន្ធ បញ្ហា ជម្លោះ ដីធ្លី មួយ កន្លែង នៅ ក្រុង ព្រះសីហនុ ជាមួយ លោកស្រី ខូវ ប៉ោស៊ាង
( ព្រះសីហនុ) ៖ លោក លឹម ហ៊ុយ ឡេង នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចេញ លិខិត បំភ្លឺ និង រៀបរាប់ ពី ដំណើរ រឿង ជម្លោះ ដីធ្លី មួយ កន្លែង ស្ថិត នៅ ក្រុង ព្រះសីហនុ ជាមួយ លោកស្រី ខូវ ប៉ោស៊ាង ដែល ករណី នេះ បាន ប្តឹង ផ្តល់ គ្នា រហូតដល់ តុលាការ កំពូល ។
លោក លឹម ហ៊ុយ ឡេង បាន ទទួលស្គាល់ ថា លោក ពិត ជាមួយ បញ្ហា ដីធ្លី ជាមួយ លោកស្រី ខូវ ប៉ោស៊ាង ប្រាកដ មែន ហើយក៏ ប្តឹង ប្តល់ គ្នា ដល់ តុលាការ កំពូល ទៀតផង រហូត សាល ដីកា បាន ចូល ជា ស្ថាពរ និង ឈាន ទៅដល់ ការអនុវត្ត ដោយ បង្ខំ ប៉ុន្តែ ការអនុវត្ត ត្រូវ ផ្អាក មួយ សរយៈពេល ដោយសារតែ ការចុះបញ្ជី ផ្ទេរ កម្មសិទ្ធិ ដី ទំនាស់ មិន អាច អនុវត្ត បាន ព្រោះ ម្ចាស់ បំណុល នៃ ការអនុវត្ត មិន បាន បង្ហាញ ទីតាំង និង និយាម កាដី ទំនាស់ ។
លោក Kerry មាន តួនាទី ដឹកនាំ កិច្ចប្រឹងប្រែង របស់ សហរដ្ឋ អាមេរិក ក្នុង ការបញ្ចុះបញ្ចូល សហគមន៍ អន្តរជាតិ អំពី ការគំរាមកំហែង ដែល កាន់តែ ជាក់ស្តែង ឡើង ៗ នៃ បម្រែបម្រួល អាកាសធាតុ ហើយ ទទូច ឲ្យ មាការពន្លឿន កិច្ចខិតខំ កាត់បន្ថយ ការបញ្ចេញ ឧស្ម័ន កាបូន ។ នៅ ជប៉ុន កិច្ចពិភាក្សា ទំនងជា នឹង ផ្តោត សំខាន់ ទៅ លើ ការប្រើប្រាស់ ធ្យូងថ្ម របស់ ប្រទេស នេះ ខណៈ វា ជា ឥន្ធនៈ ហ្វូស៉ីល ដែល បំពុល បរិយាកាស ខ្លាំង ជាង គេ បង្អស់ ។
