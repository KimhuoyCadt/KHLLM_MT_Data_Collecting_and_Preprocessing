( ប៉េកាំង ) ៖ ថ្ងៃទី១ ខែកញ្ញា គឺជា ថ្ងៃ បើក បវេសនកាល របស់ សាលា មត្តេយ្យ សាលា បឋមសិក្សា និង មធ្យម កិស្សា សិក្សា នៅ តំបន់ ភាគ ច្រើន នៃ ប្រទេស ចិន ។ ដោយសារ ស្ថានការណ៍ គ្រប់គ្រង ការរីករាលដាល នៃ ជំងឺ ជំងឺ កូវីដ១៩ នៅ ទូទាំង ប្រទេស ចិន មាន ស្ថិរភាព បានជា សាលា មត្តេយ្យ សាលា បឋមសិក្សា និង មធ្យមសិក្សា ភាគ ច្រើន របស់ ចិន បាន បើក បវេសនកាល នៅ ថ្ងៃទី១ ខែកញ្ញា នេះ ។
បរិវេណ សាលា ដែល ស្ងាត់ ជ្រងំ នឹង ឮ សំឡេង អាន សៀវភៅ របស់ សិក្សានុសិស្ស ឡើងវិញ ។ យើង ងាក មក មើល ពី អាហ្វហ្ការ នីស្ថាន ចិញ ។ ថ្វីត្បិ តែ ពេល ថ្មី ៗ កន្លងទៅ នេះ តាលី បង់ បាន អនុញ្ញាតឱ្យ សិស្ស បឋមសិក្សា ពី ថ្នាក់ ទី១ ដល់ ទី៦ ចូលរៀន វិញ ក៏ដោយ ក៏ នៅតែ មាន សិស្ស និង គ្រូបង្រៀន ជាច្រើន ដែល មិន បាន ត្រលប់ ចូល សាលារៀន វិញ ដោយសារ បារម្ភ ពី បញ្ហា សុវត្ថិភាព ។ ប៉ុន្តែ គ្រូ និង សិស្ស សុទ្ធតែ ចង់ ទៅ សាលារៀន វិញ ក្នុង ពេល ឆាប់ ៗ ។
គ្រូបង្រៀន ស្រី ម្នាក់ នៅ សាលា បឋមសិក្សា មួយ នៅ ទីក្រុង Kabul បាន និយាយ ថា « កាលពី មុន មាន សិស្ស ជាច្រើន នៅ ទីនេះ ។ ពួកគេ ខំ រៀន ណាស់ ប៉ុន្តែ នា ពេល ថ្មី ៗ នេះ ស្ថានកាណ៍ មិន សូវ ល្អ ទេ មាន តែ សិស្ស ខ្លះ មក រៀន បន្ទាប់ពី វិស្សមកាល ដ៏ យូរ កាលវិភាគ សិក្សា របស់ យើង ក៏ មាន ភាពច្របូកច្របល់ បន្តិច ដែរ »៕ តាលី បង់ ចង់ កសាង ទំនាក់ទំនង រឹងមាំ ជាមួយ ចិន ដែល ជា ប្រទេស ដ៏ ខ្លាំងក្លា មួយ ស្ថិត នៅជាប់ អាហ្វហ្គានីស្ថាន
លោក ហ្សាប៊ី ហ៊ុល ឡោះ មូចា ហ៊ីដ បាន ថ្លែង នៅក្នុង កិច្ចសម្ភាសន៍ ដែល ត្រូវបាន ធ្វើឡើង កាលពី ថ្ងៃអង្គារ សប្តាហ៍ នេះ ថា « ចិន ពិតជា សំខាន់ ខ្លាំង ណាស់ និង ជា ប្រទេស ដ៏ ខ្លាំងក្លា មួយ ស្ថិត នៅ ជិតខាង របស់ យើង .. . យើង ធ្លាប់ មាន ទំនាក់ទំនង ដ៏ វិជ្ជមាន និង ល្អប្រសើរ ជាមួយ ចិន កាលពី អតីតកាល ។ យើង ចង់ ធ្វើឲ្យ ទំនាក់ទំនង ទាំងនេះ កាន់តែ រឹងមាំ ឡើង ហើយក៏ ចង់ឲ្យ ការទុកចិត្ត គ្នា ទៅ វិញ ទៅ មក ឈានដល់ កម្រិត ថ្មី មួយ ទៀត ដែរ » ។
អភិបាល ខេត្ត ពោធិ៍សាត់ បន្ត ប្រើប្រាស់ តួនាទី សម្របសម្រួល និង ដោះស្រាយ បញ្ហា ប្រឈម ជា ចាំបាច់ បាន ចំនួន ១១ករណី
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បន្ត ប្រើប្រាស់ និង បំពេញ តួនាទី ជា អ្នកបម្រើ ប្រជាពលរដ្ឋ ដោយ ខិតខំ សម្របសម្រួល និង ដោះស្រាយ នូវ រាល់ បញ្ហា ទំនាស់ ក៏ ដូចជា បញ្ហា ប្រឈម នានា ដែល កើតមាន ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ បាន ចំនួន ១១ករណី ផ្សេង គ្នា នៅ វេទិកា ក្នុង សាលាខេត្ត ។
ការបន្ត ប្រើប្រាស់ តួនាទី របស់ លោក ក្នុង នាម ថ្នាក់ដឹកនាំ ខេត្ត ដើម្បី សម្របប សម្រួប ដោះស្រាយ បញ្ហា ប្រឈាម របស់ ប្រជាពរដ្ឋ បន្ត ទៀត នេះ គឺ ក្រោយពី ស្ថានភាព កូវីដ១៩ បាន ធូរស្បើយ បន្តិច ខណៈ ដែរ ខកខាន មួយ រយៈ ក្នុង អំឡុង នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ពិសេស ក្នុង យុទ្ធនាការ បង្ការ ការពារ និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩ នៃ ព្រឹត្តការណ៍ សហគមន៍ ២០កុម្ភៈ ។
លោក នាយក រង រដ្ឋបាល បាន បន្ត ថា យន្តការ ដែល ឯកឧត្តម កំពុងតែ ដើរ នេះ គឺជា យន្តការ របស់ រាជ រដ្ឋាភិបាល តាមរយៈ វេទិកា សាធារណៈ ដែល បាន ចង្អុលបង្ហាញ ឱ្យ ថ្នាក់ ខេត្ត ថ្នាក់ មូលដ្ឋាន ផ្សារភ្ជាប់ សុខ ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ដោយ ផ្ទាល់ ទៅ លើ បញ្ហា ប្រឈម និង តម្រូវការ ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ។
ជានិច្ច ជាកាល លោក អភិបាល ខេត្ត តែងតែ ប្រើប្រាស់ ឋានានុក្រម២ គឺ ទី ១៖ ក្នុង នាម ជា អភិបាល ខេត្ត សម្រាប់ សម្របសម្រួល ដោះស្រាយ បញ្ហា ប្រឈម ជូន ពុក ម៉ែ ប្រជាពលរដ្ឋ ទៅ លើ ផ្លូវ ច្បាប់ និង ទី២៖ ក្នុង ឋានៈ ជា គ្រួសារ មាន តួនាទី ជាបង ជា ប្អូន ជា កូន ជា ក្មួយ និង ជា ចៅ មួយ ក្នុង គ្រួសារ ប្រជាពលរដ្ឋ ជាង ៥០ម៉ឺន នាក់ ទូទាំង ខេត្ត ដើម្បី ចូលរួម សុខ រួម ទុក្ខ ជាមួយ ពួកគាត់ គ្រប់ ពេលវេលា ។
តាមរយៈ វេទិកា សម្របសម្រួល និង ដោះស្រាយ ខាងលើ នេះ បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ មាន ការទទួលយក និង សាទ រ យ៉ាង ខ្លាំង ដោយឡែក ប្រជាពលរដ្ឋ ខ្លះ ក៏ ទទួលបាន អង្ករ សារុង ក៏ ដូចជា ថវិកា បន្តិចបន្តួច សម្រាប់ ជា ទ្រនាប់ ដៃ វិលត្រឡប់ ទៅ លំនៅដ្ឋាន វិញ ផងដែរ ។
នៅពេល និយាយ ដល់ រឿង កងទ័ព អាមេរិក បាន ធ្វើ ការវាយប្រហារ តាម អាកាស ច្រើន លើក ច្រើន សា ទៅ លើ ប្រទេស អាហ្វហ្កានីស្ថាន មុនពេល ដក ចេញ ដែល បណ្តាលឱ្យ ជូន ស៊ីវិល ស្លូតត្រង់ ជាច្រើន ស្លាប់ បាត់បង់ជីវិត លោក Anas Haqqani បាន ថ្លែង ថា ក្នុង រយៈពេល ពីរ ទសវត្សរ៍ កន្លងមក នេះ កងទ័ព អាមេរិក បាន អះអាង ជាប់ រហូត ថា តាលី បង់ បាន សម្លាប់ ប្រជាជន អាហ្វហ្កានីស្ថាន ហើយ បាន ធ្វើ ការឃោសនា អវិជ្ជមាន ពី រឿង នេះ ប៉ុន្តែ ការពិត គឺ កងទ័ព អាមេរិក ទេ ដែល ធ្វើ សកម្មភាព បំផ្លិចបំផ្លាញ នៅ អាហ្វហ្កានីស្ថាន ។
ចាប់តាំងពី ចូល ទីក្រុង Kabul មក តាលី បង់ មិន បាន បំផ្លិចបំផ្លាញ កន្លែង ណាមួយ នោះ ទេ ។ តាលី បង់ សង្ឃឹម ថា ព្រលានយន្តហោះ នេះ នឹង មិន ត្រូវបាន បំផ្លាញ ឡើយ ពីព្រោះ នេះ ជា និមិត្តរូប នៃ អធិបតេយ្យភាព ជាតិ ។ ប៉ុន្តែ ជា អកុសល កងទ័ព អាមេរិក បាន បំផ្លាញ យន្តហោះ និង បរិក្ខារ ភាគ ច្រើន នៅ ព្រលានយន្តហោះ មុនពេល ពួកគេ ដក ចេញ ៕ រដ្ឋបាល ស្រុក រលាប្អៀរ ទទួលបាន គ្រឿង ឧបភោគ បរិភោគ ពី ព្រះគ្រូ អនុគណស្រុក ដើម្បី សម្រួល ការលំបាក របស់ ពលរដ្ឋ ដោយសារ កូវីដ - ១៩
( កំពង់ឆ្នាំង ) ៖ ដើម្បី ចូលរួមចំណែក ក្នុង ការជួយ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ព្រះមេត្តិ សត្ថា វង្ស កុសល ព្រះរាជា គណថ្នាក់ កិត្តិយស និង ជា ទីប្រឹក្សា សម្ដេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស និង ជា ព្រះអនុគណស្រុក រលាប្អៀរ និង សហការី នៅ ព្រឹក ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន និមន្ត នាំយក គ្រឿង ឧបភោគ បរិភោគ និង បច្ច័យ ឧបត្ថម្ភ ដល់ រដ្ឋបាល ស្រុក រលាប្អៀរ សម្រាប់ ដោះស្រាយ ផ្សេង ៗ ជូន ដល់ ពលរដ្ឋ ដែល រងគ្រោះ ក្នុង បរិបទ កូវីដ ។
លោក យ៉ង់ សៅ វុឌ្ឍី អភិបាល ស្រុក រលាប្អៀរ បាន ថ្លែងអំណរ ព្រះគុណ ដល់ ព្រះមេត្តិ សត្ថា វង្ស កុសល និង និង សហការី ទាំងអស់ សូម មាន ព្រះសុខភាព ល្អ ព្រះជន្ម យឺន យូរ ដើម្បី បន្ត ដឹកនាំ និង អភិវឌ្ឍន៍ វិស័យ ព្រះពុទ្ធ សាសនា ឱ្យ កាន់តែ ទទួលបាន ភាព កក់ក្តៅ ពី ប្រជាពុទ្ធ បរិស័ទ ជា បន្ត ទៀត ។
សូម បញ្ជាក់ ថា គ្រឿង ឧបភោគ បរិភោគ និង បច្ច័យ ឧបត្ថម្ភ ដល់ រដ្ឋបាល ស្រុក រលាប្អៀរ រួម មាន៖ អង្ករ១តោន មី ៤២ កេស ទឹកត្រី ៤០ យួរ ទឹក ស៊ីអ៊ីវ៤២ យួរ និង បច្ច័យ ១លាន រៀល ៕ ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល៖ មេដឹកនាំ ល្អ « កុំ ថើប ខាងលើ ធាក់ ខាងក្រោម »
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន លើកឡើង បែប នេះ ជា ដំបូន្មាន ដល់ និស្សិត កំពុង សិក្សា នៅ វិទ្យាស្ថាន « តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន » នៅក្នុង ជំនួប សំណេះសំណាល នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។
ក្នុង ជំនួប សំណេះសំណាល ដែល ផ្តោត លើ ការអប់រំ ចរិយា ធម៌ ដល់ និស្សិត នេះ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ផ្តល់ នូវ ការអប់រំ ជាច្រើន ដល់ និស្សិត ក្នុង នោះ រួម មាន ការរៀបចំ ខ្លួន ជា អ្នកដឹកនាំ សម្រាប់ ក្រសួង ស្ថាប័ន ក៏ ដូចជា កន្លែង ធ្វើការ នា ពេល អនាគត ផងដែរ ។
រដ្ឋមន្ត្រី ដែល មាន កេរ្តិ៍ឈ្មោះ ល្បាញ ល្បី រូប នេះ បាន លើកឡើង ថា « ខ្ញុំ ព្រះករុណា តែងតែ ប្រាប់ ថា បើ យើង ចង់ ក្លាយជា ថ្នាក់ដឹកនាំ ល្អ កុំ ថើប ខាងលើ ធាក់ គេ ខាងក្រោម ដើម្បី ខ្លួន ឯង មិន បាន ទេ ហ្នឹង មិន មែន ជា ថ្នាក់ដឹកនាំ ទេ ។ ត្រូវ ទទួលខុស ឱ្យ បាន ច្រើន ហើយ ត្រូវ បញ្ជូន ទៅ មន្ត្រី របស់ យើង ។ នេះ ជា ការងារ ដែល ខ្ញុំ ព្រះករុណា តែងតែ លើក ជាមួយ ថ្នាក់ដឹកនាំ » ។
ក្នុង កិច្ច សំណេះសំណាល នោះ លោក ទេសរដ្ឋមន្ត្រី បាន ផ្តល់ នូវ ដំបូន្មាន និង ការអប់រំ ជាច្រើន ទៀត ជូន ដល់ និស្សិត ដើម្បី ជា ទុន បន្ថែម លើ ជំនាញ ដែល ពួកគេ កំពុង សិក្សា នៅ វិទ្យាស្ថាន « តេជោ សែន សាធារណការ និង ដឹកជញ្ជូន »៕ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៧៣៥ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១
បើ តាម អ្នកនាំពាក្យ . គិត ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ០១ ខែកញ្ញា ក្នុង ឆ្នាំ ២០២១ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១៤៥ .៩០៧ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១០៨ .៩១៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៣៦. ៩៩៤ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ គឺ ភាគ ច្រើន អត់ មួក ល្មើស សញ្ញា ទូរស័ព្ទ លើស ចំណុះ និង អត់ ស្លាកលេខ ជាដើម ។ ដោយឡែក រថយន្ត ល្មើស ល្បឿន ល្មើស សញ្ញា អត់ ប័ណ្ណ បើកបរ អត់ ស្លាកលេខ បត់ ជែង ស្រវឹង លើស ចំណុះ ទូរស័ព្ទ អត់ ខ្សែក្រវាត់ ឆៀក ជាដើម ។
អ្នកនាំពាក្យ ការបរទេ ស៖ កម្ពុជា បន្ត សម្រួល បញ្ជូន ពលរដ្ឋ ខ្មែរ នៅ ថៃ ១៤នាក់ ត្រឡប់មក មាតុ ប្រទេស វិញ
( ភ្នំពេញ ) ៖ ស្ថាន អគ្គកុងស៊ុល កម្ពុជា នៅ ខេត្ត ស្រះកែវ ប្រទេស ថៃ នៅ ថ្ងៃទី១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បន្ត សហការ ជាមួយ អាជ្ញាធរ ថៃ ជួយ សម្រួល បញ្ជូន ពលរដ្ឋ ខ្មែរ ចំនួន ១២នាក់ និង កុមារ ២នាក់ ទៀត ត្រឡប់មក កម្ពុជា វិញ ដោយ សុវត្ថិភាព តាម ច្រក អន្តរជាតិ ខ្លង លឹក - ប៉ោយប៉ែត ។
លោក កុយ គួង អ្នកនាំពាក្យ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន បន្ត ថា ប្រជាពលរដ្ឋ ទាំង ១២នាក់ ត្រូវបាន ប្រគល់ជូន សមត្ថកិច្ច កម្ពុជា ចាត់ការ តាម និតិវិធី សុខាភិបាល បន្ត ៕ អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ បើក ការដ្ឋាន បុក ជញ្ជាំង បេតុង ស៊ី ផាយ ប្រឡាយ មេទួល ពង្រ
លោក អភិបាល ខណ្ឌ បាន លើកឡើង ថា ប្រឡាយ នេះ ជា ដី របស់ រដ្ឋ ពេលនេះ សាលា រាជធានី ភ្នំពេញ ត្រូវការអភិវឌ្ឍន៍ ប្រឡាយ ឱ្យ បាន ធំទូលាយ ដើម្បីឱ្យ ទឹក ហូរ បាន លឿន កាត់បន្ថយ ការលិចលង់ ពី ជំនន់ ទឹកភ្លៀង រដូវ វស្សា ពិសេស នៅ តំបន់ ប៉ែក ខាងលើ ក្នុង ភូមិសាស្រ្ត ខណ្ឌ ពោធិ៍សែនជ័យ និង ខណ្ឌ កំបូល ព្រោះ ទឹក មួយ ភាគ ធំ ធ្លាក់ តាម ប្រឡាយ នេះ មុន ចូលទៅ ប្រឡាយ បឹង ហា នៅក្នុង ខណ្ឌ ដង្កោ ។
លោក ថា « តែ បើ បងប្អូន ដឹង ថា ការអភិវឌ្ឍន៍ នេះ ធ្វើ ដើម្បី ប្រយោជន៍ បងប្អូន ដើម្បី ប្រយោជន៍ សង្គម មិន គួរ នឹង ប្តឹង ខ្ញុំ នោះ ទេ គួរតែ គាំទ្រ និង ចូលរួម ជាមួយ រដ្ឋបាល ខណ្ឌ ដើម្បីឱ្យ ការអភិវឌ្ឍន៍ ដំណើរការ ដោយ រលូន និង សំរេច តាម ផែនការ ដែល បាន គ្រោង ទុក » ។
គួរ បញ្ជាក់ ថា កំណាត់ ប្រឡាយ មេទី១ ភូមិ ទទួល ពង្រ ចាប់ពី ផ្លូវ ប្រវ៉ាត់ ក្រុង ទី២ ផ្សារ ទួល ពង្រ រហូតដល់ ព្រំប្រទល់ ខណ្ឌ ដង្កោ មាន ប្រវែង ជាង ១.០០០ ម៉ែត្រ ដែល មាន គំរោង ស្ថាបនា ស្ពាន ចំនួន ៧កន្លែង ក្នុង នោះ ស្ពាន ធំ ៗ ចំនួន ២ មាន ទំហំ ១០x១០ម៉ែត្រ និង ស្ពាន តូច ៗ ចំនួន ៥ទៀត មាន ទំហំ ៨ x ៨ម៉ែត្រ ដែល មកដល់ ថ្ងៃ នេះ ការស្ថាបនា ស្ពាន ទាំងអស់ សំរេច បាន ៨០ ភាគរយ ហើយ ។
ជាមួយគ្នា នេះ តាមរយៈ ការគាំទ្រ គំរោង ថវិកា ពី សាលា រាជធានី ភ្នំពេញ . ក្រុមហ៊ុន ទទួល ការបាន ចាប់ផ្តើម បុក ស៊ី ផាយ សងខាង ប្រឡាយ នៅ ថ្ងៃ នេះ ជា បន្ត ទៀត ដើម្បី ទប់ ដី កុំ ឱ្យ ហូរ ធ្លាក់ ចូល ប្រឡាយ ទុក ឱ្យ ប្រឡាយ ឱ្យ រក្សា ភាព ដើម ធំ ទូលាយ សម្រួល ចរន្ត ទឹក ហូរ បាន លឿន ។
លោក អភិបាល ខណ្ឌ ក៏ បាន ណែនាំ ដល់ អាជ្ញាធរ សង្កាត់ - ភូមិ សូម ផ្សព្វផ្សាយ អប់រំ ណែនាំ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម បណ្តោយ ប្រឡាយ នេះ កុំ ឱ្យ បោះ សំរាម ចូល ប្រឡាយ និង កុំ ធ្វើ អ្វី ឱ្យ ប៉ះពាល់ តួ ប្រឡាយ ជាដាច់ខាត ពុំ នោះ ទេ រដ្ឋបាល ខណ្ឌ និង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ចំពោះ ជន ណា ដែល រឹងរូស និង បង្ក ផល ប៉ះពាល់ ដល់ សម្បត្តិ សាធារណៈ ជា មិន ខាន ៕
រដ្ឋបាល ខេត្ត តាកែវ ជូនដំណឹង ពី ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ លើក ទី២ ជូន កុមារ និង យុវវ័យ នៅ ក្រុង ដូន កែវ និង ស្រុក ចំនួន ៦
( តាកែវ )៖ រដ្ឋបាល ខេត្ត តាកែវ បាន ចេញ សេចក្តីជូនដំណឹង ពី ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ លើក ទី២ ជូន កុមារ និង យុវវ័យ នៅ ទីតាំង ដែល បាន ចាក់ លើក ទី១ ដោយ ភ្ជាប់ មក ជាមួយ នូវ ប័ណ្ណ ចាក់ លើក ទី១ នៅ ក្រុង ដូន កែវ ស្រុក ព្រៃ កប្បាស ស្រុក អង្គរ បូរី ស្រុក បូរី ជលសារ ស្រុក ទ្រាំង ស្រុក គិរី វង់ និង ស្រុក កោះ អណ្ដែត ។
ខាង នេះ ជា សេចក្តីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ត តាកែ វ៖
គួរ បញ្ជាក់ ថា ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ក្រោម ការដឹកនាំ របស់ លោក កិត្តិ សេដ្ឋា បណ្ឌិត ទេសរដ្ឋមន្រ្តី ចម ប្រសិទ្ធ ដែល លោក តែងតែ គិតគូ ជា ប្រចាំ ចំពោះ សុខ ទុក្ខ និង សុខ មាលភាព របស់ មន្ត្រី ក្រោម ឱវាទ តាម គ្រប់ មធ្យោបាយ ។ ជាក់ស្តែង ដូចជា លោក ទេសរដ្ឋមន្រ្តី បាន ធ្វើ ការ កោះប្រជុំ ជាប្រចាំ ក្នុង មួយ សប្តាហ៍ ម្តង តាម ប្រព័ន្ធ អនឡាញ ស្តីពី ស្ថានភាព កូវីដ នៅ កម្ពុជា ដើម្បី ស្តាប់ របាយការណ៍ និង ដាក់ចេញ នូវ វិធានការ ជាក់ស្តែង ជា បន្តបន្ទាប់ មាន ដូច ជា៖
ក្រៅពី នោះ ដោយ ទទួលបាន ជំនួយ ពី ប្រភព ផ្សេង ៗ បូក និង ជំនួយ ផ្ទាល់ របស់ លោក កិត្តិ សេដ្ឋា បណ្ឌិត និង លោកស្រី គឺ បាន ឧបត្តម្ភ ជា ម៉ាស់ ជា អាល់កុល ជា ថវិកា និង គ្រឿង ឧបភោគ - បរិភោគ ដល់ តំបន់ គោលដៅ មួយចំនួន ដូចជា សាលា រាជធានី ភ្នំពេញ ខេត្ត កែប ខេត្ត កំពត និង រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ជា ដេីម ៕ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ចេញ អនុក្រឹត្យ កំណត់ ចំនួន សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥
យោង តាម អនុក្រឹត្យ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ការកំណត់ ចំនួន សមាជិក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ នេះ ធ្វើឡើង អនុលោម តាម មាត្រា ១២ នៃ ច្បាប់ ស្តីពី ការគ្រប់គ្រង រដ្ឋបាល ឃុំ - សង្កាត់ ៕
ខាងក្រោម នេះ ជា អនុក្រឹត្យ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា៖ រដ្ឋ Victoria របស់ អូស្រ្តាលី សម្រេច អូសបន្លាយ វិធានការបិទ ខ្ទប់ ព្រោះ ស្ថានការណ៍ កូវីដ១៩ នៅតែ ធ្ងន់ធ្ងរ
ក្រសួង ទេសចរណ៍ ដាក់ ឲ្យ អនុវត្ត ស្តង់ដា ប្រតិបត្តិ អប្បបរមា តាម គន្លង ប្រក្រតី ភាព ថ្មី ដល់ ប្រភេទ អាជីវកម្ម ទេសចរណ៍ ធំ ៗ ចំនួន ៤
លោក បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « មូលដ្ឋាន អាជីវកម្ម ទេសចរណ៍ ណា បំពេញ បាន តាម លក្ខណៈ វិនិច្ឆ័យ ដូច បាន កំណត់ ក្នុង វិធាន សុវត្ថិភាព ទេសចរណ៍ នឹង ទទួលបាន លិខិត បញ្ជាក់ ទទួលស្គាល់ អាជីវកម្ម ដែល មាន សុវត្ថិភាព ប្រឆាំង នឹង កូវីដ - ១៩ » ។
លោក រដ្ឋមន្ត្រី ថោង ខុន បាន ស្នើសុំ រដ្ឋបាល រាជធានី - ខេត្ត និង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ ត្រូវ ចុះ អនុវត្ត ចុះ ណែនាំ និង ផ្សព្វផ្សាយ ដល់ គ្រប់ មូលដ្ឋាន អាជីវកម្ម និង ត្រូវ រាយការណ៍ ជាប្រចាំ ពិសេស ត្រូវ អប់រំ ប្រជាពលរដ្ឋ ភ្ញៀវ ទេសចរ បុគ្គល បម្រើការ នៅ តាម គោលដៅ ទេសចរណ៍ នីមួយ ៗ និង ប្រតិបត្តិករ ទេសចរណ៍ ដែល ជា ដៃគូ សហការ ដើម្បី ពង្រឹង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ និង ធានា ឱ្យ បាន នូវ សុខ សុវត្ថិភាព ជូន ភ្ញៀវ ទេសចរ ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា ការជំរុញ ឱ្យ មាន ការអនុវត្ត បទដ្ឋាន គតិយុត្ត ខាងលើ នេះ គឺ ដើម្បី ជួយ ឱ្យ អាជីវកម្ម ទេសចរណ៍ ទាំង ៤ ប្រភេទ ធំ ៗ ខាងលើ អាច ធ្វើ សកម្មភាព អាជីវកម្ម របស់ ខ្លួន បាន ផង និង សម្រប ខ្លួន រៀន រស់ ក្នុង ប្រក្រតីភាព ថ្មី មួយ ។
លោក រដ្ឋមន្ត្រី បន្ត ទៀត ថា នៅពេល អាជីវកម្ម ទេសចរណ៍ ទាំង ៤ នេះ អនុវត្ត វិធាន សុវត្ថិភាព ទេសចរណ៍ និង និតិវិធី ស្តង់ដា ប្រតិបត្តិ អប្បបរមា (SOP) តាម គន្លង ប្រក្រតី ភាព ថ្មី ទាំង នេះ បាន ត្រឹមត្រូវ នឹង ទទួលបាន ក្ដី ទុកចិត្ត ពីសំណាក់ ភ្ញៀវ ទេសចរ ។ យើង ទាំងអស់ គ្នា នឹង ចូលរួម ប្រែក្លាយ ការគំរាមកំហែង ពី ជំងឺ កូវីដ - ១៩ ទៅជា ឱកាស សម្រាប់ ការលើកកម្ពស់ គុណភាព សេវាកម្ម ទេសចរណ៍ ដើម្បី ជំរុញ ការទាក់ទាញ ទេសចរ ក្នុង ស្រុក និង អន្តរជាតិ ៕
ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ចេញ អនុក្រឹត្យ បង្កើត ឃុំ បួវិល នៃ ស្រុក បវេល ខេត្ត បាត់ដំបង
យោង តាម អនុក្រឹត្យ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ឃុំ បួវិល មាន ភូមិ ចំនួន ០៩ គឺ ភូមិប វេល២ ភូមិ ទំនប់ ទឹក ភូមិ ព្រៃ ទទឹង១ ភូមិ ព្រៃ ទទឹង២ ភូមិ គោក ភូមិ ស្ល ខ្លាញ់ ភូមិ កំពង់ឆ្នាំង១ ភូមិ កំពង់ឆ្នាំង ២ និង ភូមិ សាមគ្គី ដោយ កាត់ យក ពី ឃុំ បវេល ៕ ទូត កម្ពុជា ប្រចាំ អូស្ដ្រាលី ប្រាប់ ពលរដ្ឋ ខ្មែរ ឲ្យ ប្រុងប្រយ័ត្ន រាល់ ព័ត៌មាន ជ្រើសរើស ពលករ មក ធ្វើការ នៅ អូស្ដ្រាលី ក្រោម គម្រោង ទិដ្ឋាការ « កសិកម្ម » ថ្មី
( ភ្នំពេញ ) ៖ ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ អូស្ដ្រាលី នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង មួយ ដោយ ប្រាប់ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ឲ្យ មាន ការប្រុងប្រយ័ត្ន រាល់ ព័ត៌មាន ជ្រើសរើស ពលករ ឲ្យ មក ធ្វើការ នៅ ប្រទេស អូស្ដ្រាលី ក្រោម គម្រោង ទិដ្ឋាការ « កសិកម្ម » ថ្មី ខណៈ គម្រោង នេះ បច្ចុប្បន្ន រដ្ឋាភិបាល អូស្ត្រាលី ( ក្រសួង ការបរទេស មហាផ្ទៃ និង ក្រសួង កសិកម្ម អូស្ត្រាលី ) កំពុង ពិភាក្សា នៅឡើយ ទេ ។
ករណី នេះ ដើម្បី ជៀសវាង ការចាញ់បោក ជន ខិលខូច ឆ្លៀត ឱកាស ស្ថានទូត សូម បំភ្លឺ ជូន ថា បច្ចុប្បន្ន រដ្ឋាភិបាល អូស្ត្រាលី ( ក្រសួង ការបរទេស មហាផ្ទៃ និង ក្រសួង កសិកម្ម អូស្ត្រាលី ) កំពុង ពិភាក្សា នៅឡើយ លើ ការរៀបចំ គម្រោង ទិដ្ឋាការ « កសិកម្ម ថ្មី » ជាមួយនឹង ការកំណត់ លក្ខខ័ណ្ឌ ផ្សេង ៗ ក្នុង ការទទួលបាន ទិដ្ឋាការ នេះ ។
តាម គម្រោង ទិដ្ឋាការ ថ្មី នេះ នឹង ពិភាក្សា ចប់ សព្វគ្រប់ នៅ ចុង ខែកញ្ញា ឆ្នាំ ២០២១ ខាងមុខ ។ ជាមួយគ្នា នេះ រដ្ឋាភិបាល អូស្ត្រាលី នឹង ធ្វើ ការពិភាក្សា ចរចារ ទ្វេរ ភាគី ជាមួយ ប្រទេស ដៃគូរ មួយចំនួន នៅក្នុង តំបន់ លើ គម្រោង ទិដ្ឋាការ ថ្មី ។
ស្ថានទូត សូម ជម្រាប ជូន បងប្អូន ផងដែរ ថា ក្រោម គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការស្វែង រក ទីផ្សារ ការងារ ជូន ពលករ ខ្មែរ កន្លងមក ស្ថានទូត បាន ខិតខំ ស្វះស្វែងរក ទីផ្សារ ការងារ ជូន បងប្អូន ខ្មែរ ទាំង នៅ ប្រទេស អូស្ត្រាលី ក៏ ដូចជា ប្រទេស នូវែលហ្សេឡង់ តាមរយៈ ការជួប ពិភាក្សា ជាមួយ ថ្នាក់ដឹកនាំ របស់ រដ្ឋាភិបាល ប្រទេស និមួយ ៗ ជា បន្តបន្ទាប់ ។
ចំពោះ គម្រោង ទិដ្ឋាការ កសិកម្ម ថ្មី នេះ ក្រោម ការណែនាំ ពី ថ្នាក់ដឹកនាំ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ និង កិច្ចសហការ គាំទ្រ ពី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ កម្ពុជា ស្ថានទូត បាន ត្រៀម ខ្លួន ជាស្រេច ក្នុង ការបន្ត ជួប ចរចារក ទីផ្សារ ការងារ ជូន ពលរដ្ឋ ខ្មែរ ជាមួយ រដ្ឋាភិបាល អូស្ត្រាលី ។
ស្ថានទូត សូម បញ្ជាក់ ជាថ្មី ថា មកទល់ ពេលនេះ គម្រោង ទិដ្ឋាការ កសិកម្ម នេះ កំពុង ស្ថិត ក្នុង ដំណាក់កាល រៀបចំ នៅឡើយ ហើយ រដ្ឋាភិបាល អូស្ត្រាលី នៅ ពុំ ទាន់ សម្រេច ថា នឹង ផ្តល់ ទិដ្ឋាការ ប្រភេទ នេះ ជូន កម្ពុជា ឬ ប្រទេស ណាមួយ នៅឡើយ ទេ ។ ហេតុ នេះ ស្ថានទូត ស្នើ បងប្អូន ប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ រាល់ ការផ្សព្វផ្សាយ ព័ត៌មាន ពី ការជ្រើសរើស និង ការបញ្ជូន ពលករ ខ្មែរ មក ធ្វើការ នៅ ប្រទេស អូស្ត្រាលី ដោយ ទីភ្នាក់ងារ ជ្រើសរើស បុគ្គល ឬ អង្គភាព ណាមួយ ។
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ផ្តល់ អនុសាសន៍ ៤ ចំណុច ជំរុញ ឲ្យ វិស័យ ឯកជន នៅ កម្ពុជា ប្រើប្រាស់ បច្ចេកវិទ្យា ឌីជីថល ក្នុង ប្រតិបត្តិការ អាជីវកម្ម ដើម្បី ពង្រីក ទីផ្សារ ។
ការជំរុញ របស់ ឧប នាយក រដ្ឋមន្រ្ដី អូន ព័ន្ធ មុនីរ័ត្ន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ចូលរួម ក្នុង កម្មវិធី ដាក់ ដំណើរការ ផ្លូវការ ប្រព័ន្ធ ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន ដំណាក់កាល ទី២ រៀបចំឡើង នៅ ថ្ងៃទី១ ខែកញ្ញា ឆ្នាំ ២០២១ ។
អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន បាន ថ្លែ ថា វិស័យ ឯកជន បាន និង កំពុង ដើរ តួនាទី សំខាន់ មួយ ដែល ត្រូវ ចាប់ផ្តើម ធ្វើ បរិវត្តកម្ម ឌីជីថល ក្នុង អាជីវកម្ម របស់ ខ្លួន ផងដែរ តាមរយៈ ការប្រើប្រាស់ បច្ចេកវិទ្យា ឌីជីថល ក្នុង ប្រតិបត្តិការ អាជីវកម្ម និង សម្រាប់ ជា មធ្យោបាយ ដើម្បី ពង្រីក ទីផ្សារ របស់ ខ្លួន ដូចជា ការលក់ដូរ អនឡាញ និង ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក ជាដើម ។
អគ្គ បណ្ឌិត សភាចារ្យ ក៏ បាន ប្រកាស ថា រាជ រដ្ឋាភិបាល តាមរយៈ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ នឹង ដាក់ ឱ្យ មាន កម្មវិធី គាំទ្រ ថ្នាក់ ជាតិ ដល់ សហគ្រាស ធន តូច និង មធ្យម ចាប់ យក បច្ចេកវិទ្យា ឌីជីថល ដែល កម្មវិធី នេះ មាន ការគិតគូរ ជា កញ្ចប់ និង គ្រប់ ជ្រុងជ្រោយ ទាំង ទិដ្ឋភាព ហិរញ្ញវត្ថុ . បច្ចេកទេស និង ជំនាញ » ។
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ដ្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ឲ្យដឹង ថា រយៈពេល ជាង ១ឆ្នាំ កន្លងមក នេះ ពោល ចាប់ពី ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ ដល់ ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២១ មាន ក្រុមហ៊ុន ចំនួន ៧. ៧១៥ បាន ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន មាន ដើមទុន សរុប ស្មើ ជិត ៣ពាន់ លាន ដុល្លារ អាមេរិក ។
ការបញ្ជាក់ ឲ្យដឹង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ធ្វើជា តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ប្រកាស ដាក់ ដំណើរការ ជា ផ្លូវការ នូវ ប្រព័ន្ធ ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន ដំណាក់កាល ទី២ តាម ប្រព័ន្ធ វីដេអូ នា ព្រឹក ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ក្នុង រយៈពេល ជាង ១ឆ្នាំ កន្លងមក . ប្រព័ន្ធ ចុះបញ្ជី អាជីវកម្ម បាន ដំណើរការ ឥត ដាច់ និង បាន អនុញ្ញាតឲ្យ ធុរ ជន អាច ធ្វើ ការស្នើសុំ ការចុះបញ្ជី អាជីវកម្ម គ្រប់ ពេលវេលា និង ទីកន្លែង ហើយ គិត ត្រឹម ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២១ ក្រុមហ៊ុន ដែល បាន ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន នេះ មាន ចំនួន សរុប ដល់ ទៅ ៧ ៧១៥ និង មាន ដើមទុន សរុប ស្មើ ជិត ៣ពាន់ លាន ដុល្លារ អាមេរិក » ។
បើ តាម ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រកាស ដាក់ ដំណើរការ ជា ផ្លូវការ នូវ ប្រព័ន្ធ ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន ដំណាក់កាល ទី១ កាលពី ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ កន្លងទៅ ដោយ ទទួលបាន ការចាប់អារម្មណ៍ និង ការសាទរ ខ្ពស់ ពី វិស័យ ឯកជន ។ ប្រព័ន្ធ នេះ ក៏ បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ដល់ ការរក្សា និរន្តរភាព សកម្មភាព សេដ្ឋកិច្ច ក្នុង បរិការណ៍ នៃ វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ ។
បន្ថែម ពី នោះ ទៀត ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន បាន គូសបញ្ជាក់ ថា ការណ៍ នេះ គូស រំលេច បន្ថែម នូវ សារៈសំខាន់ និង ភាពចាំបាច់ នៃ ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល សម្រាប់ គាំទ្រ ដល់ ការផ្តល់ សេវា សាធារណៈ ជាពិសេស ក្នុង បរិបទ នៃ វិបត្តិ ជំងឺ កូវីដ - ១៩ ។
សូម បញ្ជាក់ ថា ប្រព័ន្ធ ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន គឺជា ការកែទម្រង់ មុត ស្រួច ជា កញ្ចប់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដែល បាន ដាក់ចេញ ក្នុង វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន លើក ទី១៨ កាលពី ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០១៩ កន្លងទៅ ។
ក្នុង ដំណាក់កាល ទី១ ប្រព័ន្ធ បាន គ្របដណ្តប់ លើ ការចុះបញ្ជី ពាណិជ្ជកម្ម របស់ ក្រសួង ពាណិជ្ជកម្ម . ការចុះបញ្ជី ពន្ធដារ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង ការផ្តល់ សេចក្តីប្រកាស ជូនដំណឹង បើក សហគ្រាស របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង បាន ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ នា ថ្ងៃទី ១៥ ខែមិថុនា ឆ្នាំ ២០២០ ។
ដោយឡែក . ក្នុង ដំណាក់កាល ទី២នេះ . ប្រព័ន្ធ នឹង ពង្រីក វិសាលភាព ដល់ ការស្នើសុំ អាជ្ញាបណ្ណ ឬ លិខិត អនុញ្ញាត ផ្សេង ៗ តាម អនឡាញ ទៅ តាម សកម្មភាព អាជីវកម្ម ពី ក្រសួង - ស្ថាប័ន ជំនាញ ដែល មាន តួនាទី ត្រួតពិនិត្យ ផ្នែក បច្ចេកទេស តាម វិស័យ ។
ក្នុង នោះ . ក្រសួង - ស្ថាប័ន ចំនួន ៤ បាន ចូលរួម ក្នុង ដំណាក់កាល ទី២ នេះ រួម មាន៖ ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្រ្ត បច្ចេកវិទ្យា និង ន វានុវត្តន៍ . ក្រសួង ទេសចរណ៍ . ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ និង និយ័តករ អាជីវកម្ម អចលន វត្ថុ និង បញ្ជាំ នៃ អាជ្ញាធរ សេវា ហិរញ្ញវត្ថុ មិន មែន ធនាគារ ៕
បង្ក្រាប ទីតាំង ជួញដូរ ឈើ ខុស ច្បាប់ នៅ ស្រុក ឆែប ខេត្ត ព្រះវិហារ រឹបអូស ឈើ ប្រមាណ ៣០ម៉ែត្រ គូប និង គោយន្ត ១ គ្រឿង
( ព្រះវិហារ ) ៖ លោក វុធ សាវី ព្រះរាជអាជ្ញា រង និង ជា អ្នកនាំពាក្យ សាលាដំបូង ខេត្ត ព្រះវិហារ ដឹកនាំ កម្លាំង ចម្រុះ ចុះបង្ក្រាប ទីតាំង អាជីវកម្ម ជួញដូរ ឈើ ខុស ច្បាប់ ដុះស្លែ ១កន្លែង ស្ថិត ក្នុង ភូមិ ឆែប ពី ឃុំ ឆែប កើត ស្រុក ឆែប ខេត្ត ព្រះវិហារ ដោយ បង្រ្កាប និង រឹបអូស ឈើ ប្រមាណ ៣០ម៉ែត្រ គូប និង គោយន្ត១ គ្រឿង យកមក រក្សាទុក ដើម្បី ចាត់ការ ទៅតាម ច្បាប់ ។
ទាក់ទង នឹង ការចុះបង្ក្រាប ទីតាំង អាជីវកម្ម ជួញដូរ ឈើ ដុះ ស្លែ នៅ ទីតាំង ខាងលើ នេះ មាន ការសំណូមពរ ពី ប្រជាពលរដ្ឋ ថា គួរតែ តំណាង អយ្យការ អម សាលាដំបូង ខេត្ត ព្រះវិហារ កោះហៅ មន្ត្រី ពាក់ព័ន្ធ មក បំភ្លឺ ពិសេស កោះហៅ មន្ត្រី រដ្ឋបាល ព្រៃ ផ្នែក និង មន្ត្រី រដ្ឋបាល ព្រៃឈើ សង្កាត់ នៅ ស្រុក ឆែប ព្រោះ ក្រោម ការគ្រប់គ្រង របស់ គាត់ ។
ប្រជាពលរដ្ឋ បាន បន្ត ថា តើ មន្ត្រី រដ្ឋបាល ព្រៃ ផ្នែក និង មន្ត្រី រដ្ឋបាល ព្រៃឈើ សង្កាត់ នៅ ស្រុក ឆែប ដែល ស្តិត នៅក្រោម ការគ្រប់គ្រង របស់ គាត់ កន្លងមក ពួកគាត់ កន្លងម្ក មាន បាន ដឹង ថា ទីតាំង នេះ ប្រកបរបរ ជួញដូរ ឈើ ខុស ច្បាប់ ដែរ ឬ ទេ ? ប្រជាពលរដ្ឋ បន្ថែម ទៀត ថា ត្រូវ ស្វែងរក ចាប់ខ្លួន ម្ចាស់ ទីតាំង ខាងលើ ដើម្បី មក បំភ្លឺ នោះ នឹង បាន ដឹង ការពិត ជាក់ ជា មិន ខាន ៕
ខេត្ត កំពង់ចាម រកឃើញ និង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ៤៨ នាក់ . ជាសះស្បើយ ៧១ នាក់ និង ស្លាប់ ២នាក់
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បញ្ជាក់ អំពី ការរកឃើញ និង បង្ហាញ អត្ដសញ្ញាណ អ្នក កើត ជំងឺ កូវីដ - ១៩ ចំនួន ៤៨ នាក់ បន្ថែម ទៀត ជាសះស្បើយ ចំនួន ៧១ នាក់ និង ស្លាប់ ចំនួន ២នាក់ មកពី ខេត្ត ត្បូងឃ្មុំ ១នាក់ និង ស្រុក ស្ទឹងត្រង់ ១នាក់ ។
( ភ្នំពេញ ) ៖ មេបញ្ជាការ យោធ ភូមិភាគ ទី៥ លោក ឧត្ត សេនីយ៍ ឯក ឯក សំអូន បាន ដាក់ចេញ បទបញ្ជា ទៅដល់ កងទ័ព ឈរជើង នៅ តាម ព្រំដែន ខ្មែរ - ថៃ ទប់ស្កាត់ ឱ្យ បាន ជាដាច់ខាត នូវ ការលួច នាំចូល រថយន្ត ចង្កូត ស្តាំ តាម ច្រក របៀង នៅ តាម ខ្សែ បណ្តោយ ព្រំដែន ។
ក្នុង បទបញ្ជា ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០១ ខែកញ្ញា នេះ លោក ឧត្តមសេនីយ៍ ឯក ឯក សំអូន បាន គូសបញ្ជាក់ ថា ការទប់ស្កាត់ ការលួច នាំចូល រថយន្ត ចង្កូត ស្តាំ នេះ គឺ អនុលោម តាម សំណើ របស់ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា កាលពី ថ្ងៃទី ០៤ ខែសីហា កន្លងទៅ នេះ ។
ក្នុង បទបញ្ជា នេះ លោក ឧត្តមសេនីយ៍ ឯក ឯក សំអូន បាន គូសបញ្ជាក់ ផងដែរ ថា យោធិន រូប ណា ឃុបឃិត ក្នុង ការលួច នាំចូល រថយន្ត ចង្កូត ស្តាំ តាម ច្រក របៀង នៅ តាម ខ្សែ បណ្តោយ ព្រំដែន ល្មើស នឹង សេចក្តីសម្រេច នេះ មេបញ្ជាការ កង ឯកភាព នោះ នឹង ត្រូវ ប្រឈម ចំពោះ មុខ ច្បាប់ ។
មេបញ្ជាការ យោធ ភូមិភាគ ទី៥ ក៏ បាន ណែនាំ ទៅ មេបញ្ជាការប្រចាំ ទិសទី១ ទិស ទី២ ទិស ទី៣ និង ទី៤ ផ្សព្វផ្សាយ បទបញ្ជា នេះ ដល់ មេបញ្ជាការគ្រប់ កង ឯកភាព ស្ថិត នៅក្នុង ភូមិសាស្ត្រ ដែល ខ្លួន ទទួលខុសត្រូវ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ០៤ ខែសីហា កន្លងទៅ នេះ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ធ្វើ លិខិត ស្នើសុំ សម្តេច តេជោ ហ៊ុន សែន សម្រេច លើ ចំណាត់ការ មួយចំនួន ចំពោះ រថយន្ត ដែល ប្រើ ផ្លាកលេខ ខ. ម និង ន . ប ក៏ ដូចជា រថយន្ត ចង្កូត ស្តាំ ផងដែរ ។
ក្នុង សំណើ នោះ ក៏ បាន បញ្ជាក់ ដែរ ថា ការអនុញ្ញាតឲ្យ បង់ ពន្ធ និង អាករ នាំចូល ចំពោះ រថយន្ត ចង្កូត ស្តាំ មាន ស្រាប់ ក្នុង ស្រុក ជា លើក ចុងក្រោយ ត្រឹម ដំណាច់ ខែមិថុនា ឆ្នាំ ២០២២ ។ ប៉ុន្តែ ត្រូវ កែ ចង្កូត ពី ស្តាំ មក ឆ្វេង ដើម្បីឲ្យ ស្រប ច្បាប់ ចរាចរណ៍ ផ្លូវគោក របស់ កម្ពុជា ។ បន្ទាប់ពី នោះ រថយន្ត ចង្កូត ស្តាំ ដែល ត្រូវ បង្ក្រាប បាន នឹង តម្រូវឲ្យ ដោះ បំបែក ជា គ្រឿង បន្លាស់ ឬ កម្ទេចចោល ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ចារ ឯកភាព ឱ្យ អនុវត្ត តាម សំណើ ខាងលើ នេះ ទាំងស្រុង ៕ ឧទ្ធម្ភាគចក្រ យោធា អាមេរិក មួយ គ្រឿង ធ្លាក់ ក្នុង ដែន សមុទ្រ រដ្ឋ កាលីហ្វ័រញ៉ា . មនុស្ស ៥នាក់ បាត់ខ្លួន និង ម្នាក់ ត្រូវបាន ជួយសង្គ្រោះ
នៅ ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២១ រដ្ឋបាល ស្រុក ស្វាយ ជ្រំ ក៏ បាន អញ្ជើញ បុគ្គល ទាំង ២នាក់ មក ធ្វើការ ផាកពិន័យ អន្តរការណ៍ ចំពោះ ការ មិន គោរព វិធានការ រដ្ឋបាល តែ បុគ្គល ទាំង ២នាក់ នេះ នៅតែ មិន ទទួលយក ការពិន័យ អន្តរការណ៍ ហើយ មាន ចេតនា ធ្វើ កា រារាំង អាជ្ញាធរ ក្នុង ការអនុវត្ត វិធានការ ដែល បាន ហៅ ប្រជាពលរដ្ឋ មក ប្រមូលផ្ដុំ គ្នា ច្រើន នាក់ នៅ សាលា ឃុំ ឈើ ទាល ក្នុង គោលបំណង ដាក់ សម្ពាធ ដល់ អាជ្ញាធរ ក្នុង ការអនុវត្ត ច្បាប់ ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន បន្ថែម ថា ផ្អែក តាម សកម្មភាព ដែល ប្រព្រឹត្ត ដោយ បុគ្គល ទាំង២ ខាងលើ មាន ចេតនា មិន គោរព វិធានការ រដ្ឋបាល និង ចេតនា រារាំង ដល់ ការអនុវត្ត វិធានការ ដែល ជា បទល្មើស ព្រហ្មទណ្ឌ មាន ចែង និង ឱ្យ ផ្ដន្ទាទោស តាម មាត្រា ១០ និង មាត្រា ១១ នៃ ច្បាប់ ស្ដីពី វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ និង ជំងឺ ឆ្លងការសាហាវ និង ប្រកបដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ដែល បាន ប្រព្រឹត្ត កាលពី ថ្ងៃទី២ ដល់ ថ្ងៃទី ៤ ខែសីហា ឆ្នាំ ២០២១ នៅ ចំណុច ភូមិ ចេក ឃុំ ឈើ ទាល ស្រុក ស្វាយ ជ្រំ ។
អាស្រ័យ ដូច បាន ជម្រាប ជូន ខាងលើ សូម ប្រជាពលរដ្ឋ និង សាធារណជន ជ្រាប ជា ព័ត៌មាន និង សូម ចូលរួម គោរព ច្បាប់ វិធានការ សុខាភិបាល វិធាន រដ្ឋបាល ការអនុវត្ត កាតព្វកិច្ច ពាក់ ម៉ាស់ និង រក្សា គម្លាត សុវត្ថិភាព ព្រមទាំង អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ ការពារ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ ទប់ស្កាត់ ការពារ ជំងឺ កូវីដ១៩ « ៣ការពារ និង ៣កុំ » តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ៕
លោក ហ៊ុន ម៉ានី៖ មរណភាព អ្នកគ្រូពេទ្យ អ៉ឹម ស្រី និ ឆ្លុះបញ្ចាំង ពី ស្មារតី ទឹកចិត្ត និង ឆន្ទៈ ក្នុង ការចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ចាត់ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ នូវ ការសោកស្តាយ និង ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ អ្នកគ្រូពេទ្យ អ៉ឹម ស្រី និ ដែល បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារ ជំងឺ កូវីដ១៩ ។ ។
សារ រំលែក ទុក្ខ បង្ហោះ លើ បណ្តាញ សង្គម Facebook . លោក ហ៊ុន ម៉ានី បាន ចាត់ទុក ថា ការលះបង់ របស់ អ្នកគ្រូពេទ្យ អ៉ឹម ស្រី និ បាន ឆ្លុះបញ្ចាំង ពី ស្មារតី ទឹកចិត្ត និង ឆន្ទៈ ក្នុង ការចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី ជួយ ប្រជាពលរដ្ឋ ឲ្យ ចៀស ចាក ឆ្ងាយ ពី ជំងឺ កូវីដ១៩ ។
បើ តាម លោក ហ៊ុន ម៉ានី ការបាត់បង់ជីវិត របស់ ប្រជាពលរដ្ឋ កម្ពុជា និង អ្នកគ្រូពេទ្យ បាន សរ បញ្ជាក់ ថា ជំងឺ កូវីដ១៩ នៅតែ ជា ហានិភ័យ ខ្ពស់ ចំពោះ ប្រជាពលរដ្ឋ កម្ពុជា ដែល ត្រូវ រួមគ្នា ប្រយុទ្ធ ប្រឆាំង នឹង គ្រោះថ្នាក់ ដ៏ កាច សាហាវ នេះ ។ លោក បាន បួងសួង ឲ្យ ដួង វិញ្ញាណក្ខន្ធ របស់ អ្នកគ្រូពេទ្យ អ៉ឹម ស្រី និ បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
សូម ជម្រាប ថា អ្នកគ្រូពេទ្យ អ៉ឹម ស្រី និ ដែល ជា គ្រូពេទ្យ បម្រើ ការងារ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រះសីហនុ ផ្នែក ព្យាបាល អ្នកជំងឺ កូវីដ១៩ បាន ស្លាប់ កាលពី ម៉ោង ១០ យប់ ថ្ងៃទី ២៩ ខែសីហា ឆ្នាំ ២០២១ ដោយសា ជំងឺ កូវីដ១៩ ។
អ្នកគ្រូពេទ្យ អ៉ឹម ស្រី និ បាន ឆ្លង ជំងឺ កូវីដ១៩ និង ព្យាបាល នៅ ខេត្ត ព្រះសីហនុ ដោយសារ ស្ថានភាព ជំងឺ ធ្វើទុក ខ្លាំង ក៏ ត្រូវ បញ្ជូន មក ព្យាបាល នៅ មណ្ឌល ព្យាបាល ជំងឺ កូវីដ១៩ ព្រី មៀរ សែន សុខ បាន តែ រយៈពេល ២ ថ្ងៃ ក៏ ទទួលមរណភាព ដោយសារ ស្ថានភាព ជំងឺ ធ្ងន់ធ្ងរ មិន អាច ជួយសង្គ្រោះ បាន ៕
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន បញ្ជាក់ ពី ការបន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៤៥៥ នាក់ . អ្នកជំងឺ ចំនួន ៣២៨ នាក់ ជាសះស្បើយ និង អ្នកស្លាប់ ថ្មី ចំនួន ១៣នាក់ ។
( បន្ទាយមានជ័យ )៖ ខេត្ត បន្ទាយមានជ័យ គឺជា តំបន់ រងគ្រោះ ធ្ងន់ធ្ងរ មួយ ដោយសារ ជំនន់ ទឹកភ្លៀង ក្នុង រដូវ ភ្លៀង ធ្លាក់ កាលពី ឆ្នាំ ២០២០ កន្លងទៅ ។ កងទ័ព ដែល ឈរជើង នៅក្នុង ខេត្ត បន្ទាយមានជ័យ នេះ បាន ក្លាយទៅជា កម្លាំង ស្នូល ក្នុង ប្រតិបត្តិការ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ កាលពី ពេល នោះ ។
នៅ រដូវ ភ្លៀង ធ្លាក់ ឆ្នាំ ២០២១ នេះ បើ ទោះបី ខេត្ត ជាប់ ព្រំដែន ប្រទេស ថៃ មួយ នេះ មិន ទាន់ រង ការជន់ លិច យ៉ាងណា ក្តី តែ កងទ័ព បាន ត្រៀមលក្ខណៈ សម្បត្តិ ជាប់ ជានិច្ច ក្នុង ការជួយ ដល់ ប្រជាពលរដ្ឋ ក្នុង ករណី មាន ការជន់ លិច ។
នៅ ព្រឹក ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ លោក ឧត្តមសេនីយ៍ ត្រី សឹង្ហ ទុំ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ បាន ប្រមូលផ្តុំ កងកម្លាំង អន្តរាគមន៍ និង ត្រៀម សម្ភារ មធ្យោបាយ ជួយសង្គ្រោះ មួយចំនួន ទៀត ដើម្បី ត្រៀម ជួយ ប្រជាពលរដ្ឋ ក្នុង ករណី មាន ការជន់ លិច ។
ឧត្តមសេនីយ៍ ត្រី សឹង្ហ ទុំ បាន បញ្ជាក់ ថា ទោះបី កម្លាំង មួយចំនួន កំពុង បំពេញ ប្រតិបត្តិការ នៅ តាម បន្ទាត់ ព្រំដែន និង ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូសទី១ ជូន ប្រជាពលរដ្ឋ ក្តី ។ ប៉ុន្តែ កងកម្លាំង មួយចំនួន ទៀត ក៏ បាន ត្រៀមលក្ខណៈ ២៤ ម៉ោង លើ ២៤ ម៉ោង គ្រប់ បណ្តា គោលដៅ ឈរ ជើង សម្រាប់ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ធម្មជាតិ ផ្សេង ៗ ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ត្រី ក៏ បាន ក្រើន រំលឹក ដល់ កង អន្តរាគមន៍ ទាំងអស់ ឱ្យ ត្រៀមខ្លួន ក្នុង ប្រតិបត្តិការ អន្តរាគមន៍ ហើយ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ស្មារតី ជួយសង្គ្រោះ ដល់ ប្រជាពលរដ្ឋ ក្នុង ករណី ជន់ លិច ។ កិច្ចអន្តរាគមន៍ នេះ ក៏ ត្រូវ ផ្សារភ្ជាប់ ជាមួយ គោលការណ៍ ទាំងឡាយ របស់ ក្រសួង សុខាភិបាល ក្នុង ការទប់ស្កាត់ នឹង មេរោគ កូវីដ១៩ ផងដែរ ៕ ប៉ាគីស្ថាន កំពុង ព្រួយបារម្ភ ចំពោះ សន្តិសុខ តាម ព្រំដែន ក្រោយ តាលី បង់ គ្រប់គ្រង អាហ្វហ្កានីស្ថាន
( អ៉ី ស្លាម៉ា បាដ) ៖ ក្រុម មន្ត្រី ប៉ាគីស្ថាន បាន បង្ហាញ ក្ដី ព្រួយបារម្ភ ចំពោះ ការគំរាមកំហែង ផ្នែក សន្តិសុខ ពីសំណាក់ ប្រទេស ក្បែរខាង នោះ គឺ អាហ្វហ្កានីស្ថាន ខណៈ ក្រុម តាលី បង់ កំពុង ព្យាយាម បង្កើត រដ្ឋាភិបាល ថ្មី និង រក្សា ស្ថិរភាព នៅក្នុង ប្រទេស បន្ទាប់ពី ការចាកចេញ របស់ កងទ័ព អាមេរិក និង កងទ័ព អង្គការ NATO ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ព្រឹក ថ្ងៃពុធ ទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ ។
បើ តាម ក្រុម មន្ត្រី ប៉ាគីស្ថាន អ្វី ដែល ពួកគេ បារម្ភ គឺ ខ្លាចក្រែង ថា ក្រុម សកម្ម ប្រយុទ្ធ ផ្ដាច់ ខ្លួន មួយចំនួន ដូចជា ក្រុម តាលី បង់ - ប៉ាគីស្ថាន នឹង ឆ្លង ព្រំដែន ពី ប្រទេស អាហ្វហ្កានីស្ថាន ហើយ បើក ការវាយប្រហារ ណាមួយ នៅលើ ទឹកដី របស់ ប៉ាគីស្ថាន ។
មន្ត្រី ប៉ាគីស្ថាន ម្នាក់ បាន ប្រាប់ ទីភ្នាក់ងារ ព័ត៌មាន Reuters ក្នុង លក្ខខណ្ឌ មិន បញ្ចេញ ឈ្មោះ យ៉ាង ដូច្នេះ ថា « ក្នុង រយៈពេល ពីរ ទៅ បី ខែ ខាងមុខ គឺជា ពេលវេលា មួយ ដ៏ សំខាន់ ... . ទីក្រុង អ៉ីស្លា ម៉ា បាដ ភ័យខ្លាច ចំពោះ ការកើនឡើង នៃ ការវាយប្រហារ ពីសំណាក់ ក្រុម សកម្ម ប្រយុទ្ធ នៅ តាម បណ្ដោយ ព្រំដែន រវាង ប៉ាគីស្ថាន និង អាហ្វហ្កានីស្ថាន ស្រប ពេល ក្រុម តាលី បង់ កំពុង ព្យាយាម បង្កើត រដ្ឋាភិបាល ថ្មី ក្រោយ ការដួលរលំ នៃ រដ្ឋាភិបាល ដែល គាំទ្រ ដោយ លោក ខាងលិច » ។
គួរ បញ្ជាក់ ថា ប៉ាគីស្ថាន ជា ប្រទេស មួយ ដែល គេ ជឿជាក់ ថា បាន ផ្ដល់ ការគំាទ្រ យ៉ាង ខ្លាំង ដល់ ក្រុម តាលី បង់ ព្រោះ ជារឿយ ៗ សហរដ្ឋ អាមេរិក ក៏ តែងតែ ចោទប្រកាន់ ប៉ាគីស្ថាន ផងដែរ ថា បាន ផ្ដល់ ទី ជម្រក លាក់ ខ្លួន ដល់ មេដឹកនាំ ក្រុម តាលី បង់ ៕
បើ តាម ក្រសួង សុខាភិបាល ថៃ ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ១៤. ៥៨៥ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ថៃ ទូទៅ និង ២១៧ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ អ្នកជំងឺ ចំនួន ២៥២ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ។ ដោយឡែក អ្នកជំងឺ ចំនួន ១៨. ៩៩៦ នាក់ ផ្សេង ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
( សៀមរាប ) ៖ រដ្ឋបាល ខេត្ត សៀមរាប បាន ចេញ សេចក្តីសម្រេច កំណត់ ភូមិសាស្ត្រ ភូមិ ប្រឡាយ និង ភូមិ គោក ស្នួល ឃុំ ខ្នាត ស្រុក ពួក ជា « តំបន់ ក្រហម » រយៈពេល ១៤ ថ្ងៃ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។
សម្ដេច ពិជ័យ សេនា ទៀ បាញ់ អំពាវនាវ ឲ្យ វិស័យ ឯកជន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការបង្កើន ភាពស៊ាំ ក្នុង សហគមន៍
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន អំពាវនាវ ឲ្យ វិស័យ ឯកជន ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការបង្កើន ភាពស៊ាំ ក្នុង សហគមន៍ កម្ពុជា ដើម្បី ចូលរួម ទប ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
សម្ដេច ធ្លាប់ បាន បញ្ជាក់ ថា វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ គឺជា វីធីសាស្ត្រ ដ៏ ចម្បង មួយ សម្រាប់ រាជ រដ្ឋាភិបាល កម្ពុជា បន្ទាប់ពី វិធាន នានា របស់ ក្រសួង សុខាភិបាល ដើម្បី ប្រយុទ្ធ ប្រឆាំង ការរាត ត្បាត ជំងឺ កូវីដ - ១៩ ។
រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ នូវ វិធានការចាក់ វ៉ាក់សាំង ដល់ ប្រជាពលរដ្ឋ ចាប់ពី អាយុ ១២ ឆ្នាំ ឡើង ទៅ ជាមួយនឹង ការប្រកាន់ខ្ជាប់ នូវ វិធានការ « ៣ការពារ និង ៣កុំ » ។
គិត ត្រឹម យប់ ថ្ងៃទី៣០ ខែសីហា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១០. ៨០១. ៦៩១ នាក់ ៕
ពលរដ្ឋ មាន ជីវភាព ខ្វះខាត និង មាន ជំងឺ ប្រចាំ កាយ ៣គ្រួសារ នៅ ក្រុង កំពង់ឆ្នាំង បាន ទទួល អំណោយ ពី សប្បុរសជន
ពលរដ្ឋ ជា ជន ចាស់ជរា ទាំង ៣គ្រួសារ ខាងលើ នេះ មាន ឈ្មោះ៖
លោកយាយ ប៉ាវ ស៊ុន ក៏ បាន ស្នើសុំ ដល់ អាជ្ញា ធរ មូលដ្ឋាន មេត្តា ផ្ដល់ ប័ណ្ណ ក្រីក្រ ជូន លោកយាយ ផង ក្រែង បាន ប្រាក់កាស ខ្លះ ដើម្បី យក ទៅ ធ្វើ បុណ្យ នឹង គេ ។
ប្រធាន សហព័ន្ធ សេវាកម្ម អប់រំ នៅ កម្ពុជា៖ ការកំណត់ តំបន់ មួយចំនួន សម្រាប់ ការបើក ទ្វារ សាលារៀន ឡើងវិញ ជា ការគិត ដ៏ ល្អ របស់ រាជ រដ្ឋាភិបាល
( ភ្នំពេញ ) ៖ ឧកញ៉ា ប៉ិច បូឡែន ទីប្រឹក្សា ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច និង ជា ប្រធាន សហព័ន្ធ សេវាកម្ម អប់រំ នៅ កម្ពុជា បាន គាំទ្រ សេចក្តីណែនាំ របស់ រាជ រដ្ឋាភិបាល ដែល សម្រេច កំណត់ តំបន់ មួយចំនួន សម្រាប់ ការបើក ទ្វារ សាលារៀន ឡើងវិញ ដោយ លោក ចាត់ទុក ថា ជា ការគិតគូរ ដ៏ ល្អ និង ត្រឹមត្រូវ ។
លោក បាន ថ្លែង បែប នេះ ក្នុង ឱកាស ដឹកនាំ ការជួប សំណេះសំណាល តាម ប្រព័ន្ធ អនឡាញ រវាង ក្រុមប្រឹក្សាភិបាល ជាមួយ សមាជិក កំពុង ជួប ការលំបាក ដើម្បី ឈេ្វង យល់ ពី បញ្ហា ប្រឈម និង ស្វែងរក ដំណោះស្រាយ រួម សម្រាប់ រក្សា និរន្តរភាព សាលារៀន ក្នុង អំឡុង ពេល វិបត្តិ កូវីដ - ១៩ ក៏ ដូចជា ការត្រៀមលក្ខណៈ សម្បតិ្ត សម្រាប់ ការបើក សាលារៀន ឡើងវិញ តាម ការណែនាំ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ រសៀល ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ ។
លោក បាន សង្កត់ធ្ងន់ ថា សហព័ន្ធ សេវា អប់រំ នៅ កម្ពុជា គឺជា គ្រួសារ និង ជា បណ្តុំ សាលារៀន ឯកជន ដូចនេះ សមាជិក ទាំងអស់ មាន ឱកាស សហការ ជួប ពិភាក្សា ផ្លាស់ប្តូរ យោបល់ ជាមួយ អ្នកស្រឡាញ់ ការងារ អប់រំ ដូចគ្នា លើកទឹកចិត្ត គ្នា ទៅ វិញ ទៅ មក ដើម្បី ទទួលបាន នូវ ចំណេះ និង បទពិសោធន៍ ថ្មី លើ ដំណើរការ សាលារៀន និង កម្មវិធី សិក្សា ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ បាន ណែនាំ ដល់ រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា ឱ្យ ពិភាក្សា ជាមួយ អភិបាល រាជធានី - ខេត្ត ទាំងអស់ ដើម្បី បើក សាលារៀន ឡើងវិញ នៅ ទីតាំង ដែល គ្មាន ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ នៅ តាម ទី ជនបទ ក្នុង ប្រទេស កម្ពុជា ៕ ពលរដ្ឋ នៅ ភូមិ ទួល ពពេល ស្រុក កញ្ច្រៀច ខេត្ត ព្រៃវែង ចាប់ យក អាជីព ចិញ្ចឹម ចង្រិត ដែក ព្រោះ មាន ទីផ្សារ ច្រើន
ប្រជាពលរដ្ឋ បាន បន្ត ថា ការចិញ្ចឹម ចង្រិត នេះ គឺ សម្បូរ ទីផ្សារ ដោយ មាន អ្នក មក ទិញ ចង្រិត របស់ គាត់ ដល់ ផ្ទះ តែម្តង ការចិញ្ចឹម ចង្រឹត នេះ ដែរ គឺ មិន ទាន់ នឹង តម្រូវការ អ្នកទិញ នោះ ទេ ដោយ ការចិញ្ចឹម នៅ មាន កម្រិត នៅឡើយ ។ ដូច្នេះ ប្រជាពលរដ្ឋ នឹង បន្ត ពង្រីក អាង ចិញ្ចឹម ឲ្យបាន ច្រើន ថែម ទៀត ដើម្បី ផ្គត់ផ្គង់ ទីផ្សារ ចង្រិត ឱ្យ បាន ត្រូវ នឹង តម្រូវការ អ្នកទិញ ។
ប្រជាពលរដ្ឋ បាន បន្ថែម ថា សព្វ ថ្ងៃ មាន ប្រជាពលរដ្ឋ នៅ ឃុំ គោក គង់ លិច អ្នក ខ្លះ ចិញ្ចឹម ចង្រឹត ១០ អាង អ្នក ខ្លះ ទៀត ចិញ្ចឹម ២០ អាង ហើយក៏ មាន ច្រើន ជាង នេះ ក៏ មាន ដែរ ចង្រិត មួយ គីឡូ គឺ លក់ ក្នុង តម្លៃ ១១.០០០ រៀល ហើយ ការចិញ្ចឹម ចង្រិត នេះ ងាយស្រួល ជាង ចិញ្ចឹម មាន់ ទា ជ្រូក ដោយ ប្រើ រយៈពេល ខ្លី គឺ អាច ទទួលបាន ផល ចំពោះ ការចំណាយ ទៅ លើ ចំណី ក៏ តិច ដែរ ដោយ ចង្រិត ស៊ី ស្លឹកឈើ និង ចំណី កូន មាន់ បន្តិចបន្តួច តែ ប៉ុណ្ណោះ ។
ប្រជាពលរដ្ឋ បាន លើកឡើង ថា មុខរបរ នេះ គឺជា ការងារ មួយ ដែល ផ្ដល់ឲ្យ ពលរដ្ឋ នៅ ឃុំ គោក គង់ លិច មាន ការងារ ធ្វើ ដោយ ខ្លួន ឯង ហើយ ផ្ដល់ ប្រាក់ ចំណូល ប្រចាំ ថ្ងៃ បាន ប្រសើរ ជាង ទៅ ធ្វើ ការងារ ចំណាកស្រុក ឆ្ងាយ ពី ផ្ទះ ហើយ ជាង នេះ ទៅ ទៀត ការងារ នេះ ប្រសើរ ជាង ការងារ ផ្សេង ទៀត ដែល ធ្វើ ការ ហាល ថ្ងៃ ហាល ភ្លៀង ប្រឈម គ្រោះថ្នាក់ ច្រើន ផងដែរ ៕ តម្លៃ ប្រេងឥន្ធនៈ លក់ រាយ ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ១៥ ខែកញ្ញា៖ តម្លៃ សាំង ធម្មតា ៣. ៩០០ រៀល និង ម៉ាស៊ូត តម្លៃ ៣.៥០០ រៀល ក្នុង ១លីត្រ
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការកំណត់ ថ្លៃ ប្រេងឥន្ធនៈ ត្រូវ លក់ រាយ តាម ស្ថានីយ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ១៥ ខែកញ្ញា ឆ្នាំ ២០២១ ដោយ សាំង ធម្មតា ត្រូវ លក់ តម្លៃ ៣. ៩០០ រៀល ក្នុង មួយ លីត្រ និង ម៉ាស៊ូត លក់ ក្នុង តម្លៃ ៣.៥០០ រៀល ក្នុង ១លីត្រ៕
ខេត្ត ស្វាយរៀង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៣នាក់ និង ជាសះស្បើយ ៤នាក់
ជាមួយគ្នា នេះ ដែរ រដ្ឋបាល ខេត្ត ស្វាយរៀង ក៏ បាន បញ្ជាក់ ពី ការជាសះស្បើយ ចំនួន ០៤ នាក់ ផងដែរ ។
( បន្ទាយមានជ័យ )៖ ជំនន់ ទឹកភ្លៀង នៅ ថ្ងៃទី ០១ ខែកញ្ញា នេះ បាន ចាប់ផ្ដើម ជន់ លិច ផ្ទះ របស់ ប្រជាពលរដ្ឋ មួយចំនួន រស់ នៅ ជាប់ ព្រំដែន កម្ពុជា - ថៃ ក្នុង ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ ។ តំបន់ ដែល រង ការជន់ លិច នេះ ស្ថិត នៅក្នុង ឃុំ បឹង បេង និង ឃុំ ម៉ាឡៃ ។
បន្ទាប់ពី ទទួលបាន ព័ត៌មាន នៃ ការជន់ លិច នេះ កងកម្លាំង អន្តរាគមន៍ របស់ កងពល តូច ថ្មើរជើង លេខ ៥១ បាន ចេញ បំពេញ ប្រតិបត្តិការ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រងគ្រោះ ភ្លាម ៗ ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ត្រី សឹង្ហ ទុំ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ បាន បញ្ជូន កម្លាំង សហការ ជាមួយ កងកម្លាំង ចម្រុះ និង អាជ្ញាធរ មូលដ្ឋាន ជួយ ជញ្ជូន សម្ភារ នៅ ផ្ទាល់ ដី ដែល រង ផល ប៉ះពាល់ របស់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ទៅកាន់ ទី ទួល សុវត្ថិភាព ។
ជាមួយគ្នា នេះ មេបញ្ជាការ កងពល តូច ថ្មើរជើង លេខ ៥១ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ក្នុង តំបន់ ដែល កំពុង ជន់ លិច សូម មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ កូន តូច ៗ ដែល អាច បង្ក គ្រោះថ្នាក់ ដល់ អាយុជីវិត ។
លោក ឧត្តមសេនីយ៍ ត្រី ក៏ បាន ក្រើន រំលឹក ដល់ កង អន្តរាគមន៍ ទាំងអស់ ឲ្យ ត្រៀមខ្លួន ក្នុង ប្រតិបត្តិការ អន្តរាគមន៍ ហើយ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ ស្មារតី ជួយសង្គ្រោះ ដល់ ប្រជាពលរដ្ឋ ក្នុង ករណី ជន់ លិច ។ កិច្ចអន្តរាគមន៍ នេះ ក៏ ត្រូវ ផ្សារភ្ជាប់ ជាមួយ គោលការណ៍ ទាំងឡាយ របស់ ក្រសួង សុខាភិបាល ក្នុង ការទប់ស្កាត់ នឹង មេរោគ កូវីដ១៩ ផងដែរ ៕
គ.ជ. ប នឹង រៀបចំ កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ពី ការប្រកាស ផ្សព្វផ្សាយ ប្រតិទិន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២១ តាម ប្រព័ន្ធ វីដេអូ នៅ ថ្ងៃទី ១០ ខែកញ្ញា
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នឹង រៀបចំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្តីពី ការប្រកាស ផ្សព្វផ្សាយ ប្រតិទិន នៃ ការពិនិត្យ បញ្ជី ឈ្មោះ និង ការចុះឈ្មោះ បោះឆ្នោត ឆ្នាំ ២០២១ ការផ្សព្វផ្សាយ ស្ថិតិ ប្រជាពលរដ្ឋ និង ចំនួន ការិយាល័យ បោះឆ្នោត ប៉ាន់ស្មាន ការចែក លិខិត អញ្ជើញ អ្នក ចុះឈ្មោះ បោះឆ្នោត ការចុះឈ្មោះ អ្នកសង្កេតការណ៍ ជាតិ និង អន្តរជាតិ និង ការចុះឈ្មោះ អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ឱ្យដឹង ថា កិច្ចប្រជុំ នេះ នឹង ធ្វើឡើង ក្រោម អធិបតីភាព លោក ប្រាជ្ញា ចន្ទ ប្រធាន គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត នៅ ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០២១ វេលា ម៉ោង ១០៖០០ នាទី ព្រឹក ។
លោក បៃ ដិន និង លោក Ghani បាន ជជែកគ្នា ប្រហែល ១៤នាទី កាលពី ថ្ងៃទី ២៣ ខែកក្កដា ឆ្នាំ ២០២១ ។ នៅ ថ្ងៃទី ១៥ ខែសីហា ឆ្នាំ ២០២១ លោក Ghani បាន ភៀសខ្លួន ទៅ ក្រៅ ប្រទេស ហើយ ក្រុម តាលី បង់ បាន ចូល ដល់ រដ្ឋធានី កាប៊ុល។ តាំងពី នោះ មក ប្រជាជន អាហ្វហ្គានីស្ថាន រាប់ ម៉ឺន នាក់ បាន នាំគ្នា ភៀសខ្លួន ចេញ ពី ប្រទេស ខណៈ មនុស្ស ជាច្រើន នាក់ បាន បាត់បង់ជីវិត ទៀតផង កំលុង ការបំផ្ទុះ គ្រាប់បែក អត្តឃាត នៅ ព្រលានយន្តហោះ កាប៊ុល ។
ក្នុង កិច្ចសន្ទនា ទូរស័ព្ទ នោះ លោក បៃ ដិន បាន ស្នើ បន្ត ផ្តល់ ការជួយជ្រោមជ្រែង ផ្នែក យោធា ប្រសិនបើ លោក Ghani អាច បញ្ជាក់ ប្រាប់ ពី ផែនការ ដែល លោក មាន សម្រាប់ ក្រោយពេល អាមេរិក ដក កងទ័ព ចេញ ទៅ អស់ ។ ជាមួយគ្នា នោះ លោក បៃ ដិន ក៏ បាន ធ្វើ ការណែនាំឲ្យ លោក Ghani ព្យាយាម ស្វែងរក ការគាំទ្រ ពី ក្រុម បុគ្គល មាន អំណាច នៅ អាហ្វហ្គានីស្ថាន សម្រាប់ យុទ្ធសាស្រ្ត យោធា ថ្មី ផងដែរ ហើយ ឲ្យ ចាត់តាំង បុគ្គល ដែល មាន សមត្ថភាព ឲ្យដឹកនាំ កិច្ចប្រឹងប្រែង នេះ ។
លោក បៃ ដិន បាន ចំណាយ ពេល ភាគ ច្រើន ក្នុង កិច្ចសន្ទនា ផ្តោត ទៅ លើ អ្វី ដែល លោក ហៅ ថា បញ្ហា ទស្សនៈ របស់ រដ្ឋាភិបាល អាហ្វហ្គានីស្ថាន នា ពេល នោះ ។ លោក ប្រធានាធិបតី អាមេរិក បាន ឲ្យ យោបល់ ដល់ លោក Ghani ថា គួរតែ ផ្លាស់ប្តូរ ទស្សនៈ ថ្មី ។ យ៉ាងណា ក្តី ទាំង លោក បៃ ដិន ទាំង លោក Ghani ហាក់ មិន បាន និយាយ អ្វី ពាក់ព័ន្ធ នឹង លទ្ធភាព នៃ ការដួលរលំ រដ្ឋាភិបាល អាហ្វហ្គានីស្ថាន ដែល បាន កើតឡើង ក្នុង រយៈពេល ត្រឹម ២៣ ថ្ងៃ ប៉ុណ្ណោះ ក្រោយ កិច្ចសន្ទនា ។
គួរ បញ្ជាក់ ថា អាមេរិក បាន បញ្ចប់ ប្រតិបត្តិការ ជម្លៀស មនុស្ស និង ដក កងទ័ព ចេញ អស់ ទាំងស្រុង ពី អាហ្វហ្គានីស្ថាន កាលពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ ដែល ជា ការបិទ បញ្ចប់ ផ្លូវការ នៃ ប្រតិបត្តិការ យោធា រយៈពេល ២០ ឆ្នាំ នៅ ទីនោះ ៕
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ដ្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ណែនាំ ដល់ ក្រុមការងារ បច្ចេកទេស អន្តរ ក្រសួង ទទួលបន្ទុក រៀបចំ ការចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន ពង្រីក វិសាលភាព ក្នុង ការផ្ដល់ អាជ្ញា បណ្ណ ឬ លិខិត អនុញ្ញាត តាម ប្រព័ន្ធ ឌីជីថល ឲ្យ គ្របដណ្ដប់ ដល់ វិស័យ ផ្សេង ៗ ទៀត និង បន្តបញ្ចូល នូវ សេវា សំខាន់ ៗ និង ចាំបាច់ នានា សម្រាប់ ផ្តល់ នូវ ការសម្រួល បន្ថែម ដល់ ការធ្វើ ធុរកិច្ច នៅ កម្ពុជា ។
ការណែនាំ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ជា ប្រធាន គណៈកម្មាធិការ គោល នយោបាយ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ចូលរួម ក្នុង ពិធី ប្រកាស ដាក់ ដំណើរការ ជា ផ្លូវការ នូវ ប្រព័ន្ធ ចុះបញ្ជី អាជីវកម្ម តាម ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន ដំណាក់កាល ទី២ តាម ប្រព័ន្ធ វីដេអូ នា ព្រឹក ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ជា ការពិត ដំណាក់កាល ទី២ គ្រាន់តែ ជា ការចាប់ផ្តើម នៃ ដំណើរ នៃ ការផ្តល់ សេវា ប្រភេទ នេះ តាម ប្រព័ន្ធ អនឡាញ តែ ប៉ុណ្ណោះ ។ ក្នុង ន័យ នេះ ខ្ញុំ សូម ស្នើ ក្រុមការងារ ខិតខំ ពង្រីក វិសាលភាព នៃ ប្រព័ន្ធ ផ្តល់ អាជ្ញា បណ្ណ ឬ លិខិត អនុញ្ញាត និង បន្ត គ្របដណ្ដប់ ដល់ វិស័យ ផ្សេង ៗ ទៀត និង បន្តបញ្ចូល នូវ សេវា សំខាន់ ៗ និង ចាំបាច់ នានា សម្រាប់ ផ្តល់ នូវ ការសម្រួល បន្ថែម ដល់ ការធ្វើ ធុរកិច្ច នៅ កម្ពុជា » ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន បាន លើកទឹកចិត្ត ឲ្យ គ្រប់ តួអង្គ ពាក់ព័ន្ធ ចូលរួម ផ្សព្វផ្សាយ ឲ្យបាន ទូលំទូលាយ នូវ ថ្នាល បច្ចេកវិទ្យា ព័ត៌មាន នេះ ផងដែរ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត ប៉ៃលិន៖ សន្និសីទ ថ្នាក់ តំបន់ ពី ការអភិវឌ្ឍ ការបណ្តុះបណ្តាល គំរូ ដោយ វិធី ឆ្លាស់ ដែល សម្រប ទៅ តាម បរិបទ សិក្សា នៃ សាកលវិទ្យាល័យ ទាំងឡាយ នៅ អាស៊ី ប៉ាស៊ីហ្វិក ត្រូវបាន រៀបចំ តាម ប្រព័ន្ធ អនឡាញ
( ភ្នំពេញ ) ៖ សន្និសីទ ថ្នាក់ តំបន់ ស្តី អំពី « ការអភិវឌ្ឍ ការបណ្តុះបណ្តាល គំរូ ដោយ វិធី ឆ្លាស់ ដែល អាច សម្រប ទៅ តាម បរិបទ សិក្សា នៃ សាកលវិទ្យាល័យ ទាំងឡាយ នៅ អាស៊ី ប៉ាស៊ីហ្វិក » ត្រូវបាន រៀបចំឡើង ដោយ ទីភ្នាក់ងារ ឧត្តម សិក្សា ប្រើប្រាស់ ភាសា បារាំង AUF សហការណ៍ ជាមួយ សាកលវិទ្យាល័យ សេដ្ឋកិច្ច នៃ ទីក្រុង ហូជីមិញ នា ថ្ងៃទី ៣១ ខែសីហា ឆ្នាំ ២០២១ តាម អនឡាញ ។
សិក្ខាកាម ដែល ជា ថ្នាក់ដឹកនាំ សាកលវិទ្យាល័យ សាស្ត្រាចារ្យ តាម បណ្តា សាកលវិទ្យាល័យ អ្នកស្រាវជ្រាវ និង អ្នកជំនាញ ផ្នែក សេដ្ឋកិច្ច និង ផ្នែក បណ្តុះបណ្តាល ប្រមាណ ៣០០ នាក់ មកពី ប្រទេស ជាច្រើន ក្នុង តំបន់ រួម មាន៖ វៀតណាម ឡាវ ថៃ ម៉ុងហ្គោលី វ៉ាណា ទូ នូវែល កាលេដូនី ។ល ។ បាន ចូលរួម ក្នុង វេទិការ នេះ ។
ថ្លែង ក្នុង ការបើក ព្រឹត្តិការណ៍ នេះ លោក SLIM Khalbous សាកលវិទ្យាធិការ នៃ ទីភ្នាក់ងារ ឧត្តម សិក្សា ប្រើប្រាស់ ភាសា បារាំង បាន បញ្ជាក់ ថា អាស៊ី ស្ថិត ក្នុង ការផ្លាស់ប្តូរ មួយ ដ៏ ស៊ី ជំរៅ ដែល បញ្ជាក់ ច្បាស់ តាមរយៈ វិស័យ អប់រំ និង ការបណ្តុះបណ្តាល តាម គ្រឹះស្ថាន ឧត្តម សិក្សា នានា ។ ការអប់រំ ជា កត្តា សំខាន់ ក្នុង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ដោយ ផ្តោត លើ គុណភាព ជាពិសេស ។
លោក បាន បន្ត ថា ដើម្បី ឈានដល់ គោលដៅ នេះ ការបណ្តុះបណ្តាល តាម ជំនាញ ក្នុង ប្រទេស ជាច្រើន បាន ផ្សារភ្ជាប់ នូវ តួអង្គ សំខាន់ ៗ ចំនួន រួម៣មាន៖ និស្សិត ដែល នឹង ក្លាយជា អនាគត និយោជិក សាកលវិទ្យាល័យ បើក ចំហរ ទៅ រក វិស័យ ឯកជន និង ក្រុមហ៊ុន ដែល ជា អនាគត និយោជក នៃ យុវជន ទាំងឡាយ ដែល នឹង ប្រឡូក ចូលក្នុង ទីផ្សារ ការងារ ។
ស្ថិត ក្នុង ន័យ នេះ AUF បាន គៀង គរ ធនធាន និង ចំណេះដឹង ទាំងឡាយ ពី ប្រភព នៃ ហ្វ្រង់ កូហ្វូនី វិទ្យាសាស្ត្រ ដែល AUF បាន កសាង ជា បណ្តាញ នៅលើ ពិភពលោក ដើម្បី គាំទ្រ ប្រព័ន្ធ អប់រំ និង គ្រឹះស្ថាន ឧត្តម សិក្សា ស្តី អំពី បញ្ហា ចោទ លើ ភាពទទួលបាន ការងារ ធ្វើ ដើម្បី ផ្តល់ ឱកាស ដល់ យុវជន ដែល នឹង បញ្ចប់ ការសិក្សា ឱ្យ បាន កាន់តែ ប្រសើរ ។
សូម បញ្ជាក់ ថា សន្និសីទ ដែល រៀបចំឡើង មួយ ព្រឹក ធំ នេះ ផ្តោត ជា សំខាន់ លើ ការបណ្តុះបណ្តាល គំរូ នៅ តាម គ្រឹះស្ថាន ឧត្តម សិក្សា មួយចំនួន ក្នុង តំបន់ អាស៊ី និង តំបន់ ផ្សេង ទៀត ដោយ សហការណ៍ ជាមួយ វិស័យ ឯកជន លើ ការបង្កើត កម្មវិធី បណ្តុះបណ្តាល ឆ្លាស់ គ្នា រវាង ការសិក្សា ទ្រឹស្តី នៅ តាម គ្រឹះស្ថាន សិក្សា និង ការប្រតិបត្តិ ឬ អនុវត្តន៍ ជាក់ស្តែង នៅ តាម ក្រុមហ៊ុន ។
វា ជា ការបណ្តុះបណ្តាល មួយ ដែល សម្រប តាម តម្រូវការ ជាក់ស្តែង នៃ វិស័យ ឯកជន ។ វា គ្មិន បាន បង្ហាញ អំពី ការកសាង មូលដ្ឋាន នៃ ការសិក្សា និង ការបញ្ចូល កម្មវិធី នានា តាម សាកលវិទ្យាល័យ និង គំរូ មួយចំនួន នៃ ការបណ្តុះបណ្តាល ដោយ សហការណ៍ ជាមួយ វិស័យ ឧស្សាហកម្ម នៅក្នុង វិទ្យាស្ថាន ពហុ បច្ចេកវិទ្យា នៃ ទីក្រុង ហាណូយ ។
ការបណ្តុះបណ្តាល តាម វិធី ឆ្លាស់ នេះ ទើប ត្រូវបាន បង្កើតឡើង នា ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ តាម គ្រឹះស្ថាន មួយចំនួន ក្នុង តំបន់ ដែល បង្ហាញ នូវ ប្រសិទ្ធិភាព និង សមត្ថភាព យ៉ាង សំខាន់ ក្នុង ទីផ្សារ ការងារ ។ ស្ថិត ក្នុង គោលដៅ នេះ ហើយ AUF បាន បង្កើត មជ្ឈមណ្ឌល ការងារ ហ្វ្រង់ កូហ្វូន (CEF) ដែល នឹង ស្នើ នូវ កម្មវិធី បណ្តុះបណ្តាល រយៈពេល ខ្លី ផ្តោត លើ ជំនាញ ។ CEF ក៏ ជា កន្លែង ជួបជុំ ផ្លាស់ប្តូរ រវាង សាកលវិទ្យាល័យ និង តួអង្គ សង្គម សេដ្ឋកិច្ច ជាច្រើន ផងដែរ ។ A
UF បាន នឹង បង្កើត មជ្ឈមណ្ឌល ការងារ ហ្វ្រង់ កូហ្វូន (CEF) ជាង ៨០០ មជ្ឈមណ្ឌល នៅ ជុំវិញ ពិភពលោក និង ផ្សារភ្ជាប់ មជ្ឈមណ្ឌល នេះ ឱ្យ ខិត ជិត គ្នា រវាង ទៅ វិស័យ អប់រំ និង វិស័យ ឯកជន ៕ សម្ដេច ក្រឡាហោម ស ខេង៖ អ្នកស្លាប់ ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ខែសីហា មាន ការកើនឡើង ខណៈ ចំនួន គ្រោះថ្នាក់ ថយចុះ
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក នៅ ព្រឹក ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ឲ្យដឹង ថា ចំនួន អ្នកស្លាប់ ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ខែសីហា កន្លងទៅ មាន ការកើនឡើង បើ ធៀប នឹង ខែកក្កដា ប៉ុន្ដែ ចំនួន គ្រោះថ្នាក់ ចរាចរណ៍ មាន ការថយចុះ ទៅវិញ ។
តាមរយៈ Facebook សម្ដេច ក្រឡាហោម ស ខេង បាន សម្ដែង នូវ ការសោកស្ដាយ យ៉ាង ខ្លាំង ចំពោះ ចំនួន អ្នក ដែល បាន បាត់បង់ជីវិត ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ខែសីហា កន្លងទៅ ដែល មាន ចំនួន ១២៣ នាក់ ខណៈ អ្នកស្លាប់ ដោយសារ គ្រោះថ្នាក់ សង្គម មួយ នេះ កាលពី ខែកក្កដា មាន ត្រឹម ១០៧ នាក់ ។
សម្ដេច ក្រឡាហោម ស ខេង បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖
« ថ្ងៃ នេះ ខ្ញុំ សូម ជម្រាប ជូន បងប្អូន ជន រួម ជាតិ នូវ របាយការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ប្រចាំ ខែសីហា ឆ្នាំ ២០២១ ដែល យើង បាន មើលឃើញ ថា ករណី គ្រោះថ្នាក់ នេះ បាន បណ្តាលឲ្យ អត្រា ជនរងគ្រោះ បាត់បង់ជីវិត មាន ការកើនឡើង នៅ ពេល ដែល អត្រា អ្នក រងរបួស មាន ចំនួន ថយចុះ ធៀប នឹង ខែកក្កដា កន្លងទៅ នេះ ។
ជា ការកត់សម្គាល់ កំណើន អ្នកស្លាប់ ដោយ គ្រោះថ្នាក់ ចរាចរណ៍ ក្នុង ខែសីហា នេះ គឺ ការធ្វើដំណើរ នៅក្នុង ឱកាស នៃ ពិធី សែន ក្បាល ទឹក ដែល មាន ជនរងគ្រោះ ស្លាប់ ចំនួន ១៥នាក់ របួស ៣២ នាក់ និង ការធ្វើដំណើរ នៅ រៀងរាល់ ថ្ងៃ ចុង សប្ដាហ៍ ផងដែរ បន្ទាប់ពី ស្ថានភាព ជំងឺ កូវីដ - ១៩ បាន ថមថយ ហើយ ការធ្វើចរាចរណ៍ មាន កំណើន ឡើងវិញ ។
