( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC ) បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ ដល់ ថ្ងៃទី ២២ ខែសីហា ឆ្នាំ ២០២១ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
( បរទេស ) ៖ ខាងក្រោម គឺជា រូបភាព គួរឲ្យ ចាប់អារម្មណ៍ មួយចំនួន នៃ ស្ថានការណ៍ អន្តរជាតិ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃពុធ ទី១៨ ខែសីហា ឆ្នាំ ២០២១ ។ ១៖ ក្រុម តាលី បង់ សន្យា ផ្ដល់ សន្តិភាព . សិទ្ធិ ស្ត្រី និង លើកលែង ទោស ឱ្យ អ្នក ដែល ធ្លាប់ ធ្វើការ ឱ្យ កងទ័ព បរទេស
២៖ ចក្រភព អង់គ្លេស ប្រកាស ទទួលយក ជនភៀសខ្លួន អាហ្វហ្កានីស្ថាន ២០.០០០ នាក់
៤៖ បទ វិភាគ អន្តរជាតិ៖ « មុខមាត់ លាក់ ពុត ខាង សិទ្ធិ មនុស្ស បែប អាមេរិក ត្រូវ លាតត្រដាង យ៉ាង ច្បាស់ ទៅ ហើយ »
វ៉ាក់សាំង ដែល ប្រើ សម្រាប់ ចាក់ ជូន ក្មេង ៗ និង យុវវ័យ គឺជា វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ដែល ផលិត ឡើង ដោយ ក្រុមហ៊ុន នៅក្នុង ប្រទេស ចិន ៕ ទូទាំង ប្រទេ ស៖ សរុប ការចាក់ វ៉ាក់សាំង កូវីដ១៩ បាន ចំនួន ៩. ២៧២. ៧៦៩ នាក់ ( គិត ត្រឹម ថ្ងៃទី ១៨ ខែសីហា )
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ៩. ២៧២. ៧៦៩ នាក់ ។
ខាងក្រោម តារាង បញ្ជី បូកសរុប ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩៖ ខេត្ត ឧត្តរមានជ័យ បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ចំនួន ៧២ នាក់ . ៥៣ នាក់ ជា ពលករ ទើប មកពី ថៃ តាម ច្រក អូរ ស្មាច់ និង ជាសះស្បើយ ១០នាក់
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ថា អ្នកជំងឺ រកឃើញ ថ្ងៃ នេះ មាន ចំនួន ៥៣ នាក់ ជា ពលករ ទើប វិលត្រឡប់ មកពី ប្រទេស ថៃ តាម ច្រក អូរ ស្មាច់ ចំនួន ១៧នាក់ រកឃើញ ឆ្លង ក្នុង សហគមន៍ និង ចំនួន ២នាក់ ទៀត ជា ពលករ កំពុង ធ្វើចត្តាឡី ស័ក ។
រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ថា មកទល់ ពេលនេះ ខេត្ត ឧត្តរមានជ័យ រកឃើញ អ្នកជំងឺ កូវីដ១៩ សរុប ៥. ៩១៨ នាក់ ។ ក្នុង នោះ ករណី នាំចូល ពី បរទេស ៤.៩០៩ នាក់ និង ករណី ព្រឹត្តិការណ៍ សហគមន៍ ២០កុម្ភៈ ១០០៨ នាក់ ។ ជាមួយគ្នា នេះ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ២. ៣៧៩នាក់ កំពុង សម្រាក ព្យាបាល ចំនួន ៣. ៥២៩ នាក់ និង ស្លាប់ ចំនួន ១០នាក់ ៕
ខេត្ត ព្រៃវែង បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ៤៨ នាក់ . ជាសះស្បើយ ១០២ នាក់ និង ស្លាប់ ២នាក់
បច្ចុប្បន្ន អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ទាំង ជំងឺ ទាំង ៤៨ នាក់ ខាងលើ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត និង តាម មន្ទីរពេទ្យ បង្អែក ស្រុក នីមួយ ៗ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត ព្រៃវែ ង៖ BREAKING: ប្រធានាធិបតី អាហ្វហ្កានីស្ថាន និង ក្រុមគ្រួសារ បាន ទៅដល់ ប្រទេស អេមីរ៉ាត់ អារ៉ាប់ រួម
ក្រសួង ការបរទេស និង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ អេមីរ៉ាត អារ៉ាប់ រួម បាន គូសបញ្ជាក់ នៅក្នុង សេចក្តីថ្លែងការណ៍ នៅ ថ្ងៃពុធ នេះ ថា « អារ៉ាប់ រួម បាន ស្វាគមន៍ ប្រធានាធិបតី អាស្ហាហ្វហ្កានី និង ក្រុមគ្រួសារ របស់ លោក ចូលមក ក្នុង ប្រទេស ដោយ ឈរ លើ មូលដ្ឋាន មនុស្សធម៌ » ។
ផ្សារ ព្រះដាក់ បើក ឡើងវិញ តែ ត្រូវ គោរព តាម វិធានការ របស់ អាជ្ញាធរ
( សៀមរាប ) ៖ រដ្ឋបាល ស្រុក បន្ទាយស្រី នៅ ថ្ងៃទី ១៨ ខែ សីហា ឆ្នាំ ២០២១ បាន អនុញ្ញាតឱ្យ ផ្សារ ព្រះដាក់ បើក ឡើងវិញ បន្ទាប់ពី ផ្សារ នេះ បាន បិទ មួយ រយៈ ដោយសារ ករណី ផ្ទុះ ជំងឺ កូវីដ១៩ ។ បើ ទោះបី អនុញ្ញាតឱ្យ បើក លក់ ឡើងវិញ តែ អ្នកលក់ដូរ ត្រូវ គោរព តាម វិធាន របស់ សុខាភិបាល និង អាជ្ញាធរ ។
បើ តាម ការបង្ហោះ តាម បណ្ដាញ សង្គម ហ្វេសប៊ុក របស់ លោក ឃឹម ហ្វីណង់ អភិបាល ស្រុក បន្ទាយស្រី ថា « ផ្សារ ព្រះដាក់ ត្រូវបាន អនុញ្ញាតឱ្យ ដំណើរការវិញ ហើយ តែ ត្រូវ គោរព តាម គោលការណ៍ សុវត្ថិភាព និង រៀបចំ លក់ដូរ តាម គន្លង ថ្មី ដោយ ធ្វើ ការឆ្លាស់ វេន គ្នា និង រក្សា គម្លាត រវាង នាក់ លក់ នីមួយ ៗ ដើម្បី បញ្ចៀស ហានិភ័យ នៃ ការផ្ទុះ ឆ្លង ថ្មី នៅក្នុង ផ្សារ ម្តង ទៀត » ។
លោក អភិបាក ស្រុក ក៏ បាន សុំ ការយោគយល់ និង អធ្យាស្រ័យ ពីសំណាក់ អាជីវករ ដែល មិន ទាន់ អាច អនុញ្ញាតឱ្យ ទៅ លក់ដូរ គ្រប់ គ្នា ឡើងវិញ បាន ដោយ ហេតុតែ កន្លែង មាន កំណត់ ។
បើ ទោះបី យ៉ាងណា រដ្ឋបាល ស្រុក ក៏ តែ បន្ត ដំណើរការផ្សារ ក្រមួន ព្រះដាក់ មួយ រយៈពេល ទៀត ដើម្បី រំលែក អ្នកលក់ ខ្លះ ចេញមក ផ្នែក ខាងក្រៅ ក៏ ដូចជា បន្ត ផ្តល់ ជម្រើស ដែល មាន សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ក្នុង ការស្វែងរក ទិញ របស់របរ ដែល ជា តម្រូវ ការចាំបាច់ ប្រចាំ ថ្ងៃ របស់ ខ្លួន ទម្រាំ ដល់ មាន ការប្រាកដ ក្នុង ចិត្ត ថា ហានិភ័យ នៃ ការឆ្លង នៅក្នុង សហគមន៍ អាច គ្រប់គ្រង បាន ទាំងស្រុង ។
គូរ រំលឹក ផងដែរ រដ្ឋបាល ស្រុក បន្ទាយស្រី សម្រេច បិទ ខ្ទប់ ផ្សារ ព្រះដាក់ នៅ ថ្ងៃទី ៥ ខែកក្កដា ក្រោយ អាជីវករ ច្រើន នាក់ ក្នុង ផ្សារ នេះ រកឃើញ មាន វិជ្ជមាន ជំងឺ កូវីដ១៩ ៕ វិភាគ អន្តរជា តិ៖ តើ ការដួលរលំ របស់ អាហ្វហ្កានីស្ថាន មាន ន័យ ដូចម្ដេច ចំពោះ កោះ តៃវ៉ាន់ ?
* មេរៀន ពី អាហ្វហ្កានីស្ថាន
ការដក កងទ័ព អាមេរិក ចេញ ពី អាហ្វហ្កានីស្ថាន គឺ មាន ជាប់ពាក់ព័ន្ធ នឹង ការប្ដូរ យុទ្ធសាស្ត្រ ងាក មក ផ្ដោត សំខាន់ លើ តំបន់ អាស៊ី ជាពិសេស គឺ ការខ្ទប់ ការកើនឡើង ឥទ្ធិពល ចិន របស់ សហរដ្ឋ អាមេរិក ។ យុទ្ធសាស្ត្រ បែប នេះ មាន តាំងតែពី សម័យ អតីត ប្រធានាធិបតី អាមេរិក លោក បារ៉ាក់ អូបាម៉ា មក ម្លេះ ហើយ កំពុង ត្រូវបាន យកមក អនុវត្ត បន្ត ក្រោម រដ្ឋបាល របស់ លោក ប្រធានាធិបតី ចូ បៃ ដិន ។ ប៉ុន្តែ វា មិន មែន មាន ន័យ ថា ប្រទេស នៅ អាស៊ី ទាំងអស់ សុទ្ធតែ ទទួលបាន ការថែទាំ និង យកចិត្តទុកដាក់ ខ្ពស់ ពី អាមេរិក នោះ ទេ ។
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ផងដែរ ថា សម្រាប់ អ្នក ជាសះស្បើយ ពី ជំងឺ មាន ចំនួន ១៤១ នាក់ ផងដែរ ។
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ មាន តែ ១២ករណី ប៉ុណ្ណោះ ដែល ជា ករណី នាំចូល ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង ស្រុក ទាំងអស់ ខណៈ ទីក្រុង ហូជីមិញ ដែល ជា ចំណុច កណ្តាល នៃ ការផ្ទុះ រីករាល នៃ ជំងឺ នេះ បាន រ៉ាប់រង ករណី ឆ្លង ថ្មី តែ ឯង រហូតដល់ ៣. ៧៣១ នាក់ ។
នៅក្នុង ថ្ងៃពុធ នេះ ដែរ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស រកឃើញ អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ ដ៏ កាច សាហាវ នេះ ចំនួន ២៩៨ នាក់ ទៀត ផងដែរ ។
សរុប មកវិញ គិត ត្រឹម យប់ ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ នេះ វៀតណាម មាន ករណី ឆ្លង កូវីដ - ១៩ សរុប នៅ ទូទាំង ប្រទេស ចំនួន ២៩៩. ៦៣៤ នាក់ ក្នុង នោះ អ្នកជំងឺ ជាសះស្បើយ ចំនួន ១១៥. ០៥៩ នាក់ ខណៈ ចំនួន អ្នកស្លាប់ កើន ដល់ ៦.៧៧០ នាក់ ៕ សម្តេច តេជោ ហ៊ុន សែន ប្រកាស យក មៀន ទិញ ពី កសិករ ទៅ ចែក កងទ័ព អាវុធហត្ថ នគរបាល គ្រូពេទ្យ អ្នកជំងឺ និង អ្នក កំពុង ធ្វើចត្តាឡី ស័ក
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ប្រកាស ថា ផ្លែ មៀន ដែល សម្តេច ប្រមូល ទិញ ពី កសិករ ដាំដុះ នៅ តាម ខេត្ត ជាប់ ព្រំដែន ថៃ នឹង យក ទៅ ចែកជូន កងទ័ព អាវុធហត្ថ នគរបាល គ្រូពេទ្យ អ្នកជំងឺ និង ប្រជាពលរដ្ឋ កំពុង ធ្វើចត្តាឡី ស័ក ។
សម្តេច តេជោ បាន បញ្ជាក់ ដូច្នេះ « ថ្មី ៗ នេះ ខ្ញុំ បាន ចេញ បញ្ជា ឱ្យ នាយ ឧត្តមសេនីយ៍ ហ៉ីង ប៊ុន ហៀង ដឹកនាំ កម្លាំង ទៅ ប្រមូល ទិញ ផ្លែ មៀន ពី កសិករ ដែល មិន អាច រក ទីផ្សារ ដើម្បី លក់ មៀន បាន ។ នៅពេល ប្រមូល ទិញ បាន ខ្ញុំ នឹង យក ទៅ ចែកជូន កងទ័ព នគរបាល អាវុធហត្ថ គ្រូពេទ្យ អ្នកជំងឺ បងប្អូន ដែល កំពុង ធ្វើចត្តាឡី ស័ក ទទួលទាន ដោយ មិន គិត ថ្លៃ » ។
សម្តេច តេជោ បាន រំលឹក ដល់ នាយ ឧត្តមសេនីយ៍ ហ៉ីង ប៊ុន ហៀង . លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង . លោកស្រី បាន ស្រី មុំ អភិបាល ខេត្ត ប៉ៃលិន ត្រូវ ទិញ ពី កសិករ គឺ សំដៅ ដល់ កសិករ ក្រីក្រ ដែល ដាំ មៀន ដោយ ផ្ទាល់ ។ សម្រាប់ ចំការមៀន របស់ មន្ត្រី ទាំង សុី វិល ទាំង កងកម្លាំងប្រដាប់អាវុធ ឬ របស់ ឧកញ៉ា អ្នក ឧកញ៉ា ឬ អ្នកជំនួញ ត្រូវ រក ទីផ្សារ ដោយ ខ្លួន ឯង ។
សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល បាន ណែនាំ ក្រសួង កសិកម្ម ក្រសួង ពាណិជ្ជកម្ម អភិបាល ខេត្ត បាត់ដំបង និង ប៉ៃលិន ត្រូវ ខិតខំ ដោះស្រាយ រក ទីផ្សារ ជូន កសិករ ។
សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០២១ បាន ប្រកាស ប្រមូល ទិញ ផ្លែ មៀន ពី កសិករ នៅ ខេត្ត ជាប់ ព្រំដែន ថៃ ជាពិសេស ខេត្ត បាត់ដំបង និង ប៉ៃលិន ។
ម៉ាឡេស៊ី បាន បំបែក កំណត់ ត្រា កាលពី លើក មុន កាលពី ថ្ងៃទី ១២ ខែសីហា ដោយ កត់ត្រា ករណី ឆ្លង ថ្មី ៗ ចំនួន ២១. ៦៦៨ ករណី ក្នុង មួយ ថ្ងៃ ។
នៅ ថ្ងៃ ជាមួយគ្នា នេះ ម៉ាឡេស៊ី ក៏ បាន រកឃើញ ករណី ស្លាប់ ថ្មី ដោយសារ ជំងឺ ដ៏ កាច សាហាវ នេះ ចំនួន ២២៥ នាក់ ទៀត ផងដែរ ។
ក្រុម តាលី បង់ បើក ការបាញ់ប្រហារ ទៅ លើ ហ្វូង បាតុករ ដែល ទាមទារ ឲ្យ ដោត ទង់ជាតិ អាហ្វហ្គានីស្ថាន នៅលើ អគារ របស់ រដ្ឋ ដូច មុន ឡើងវិញ
ប្រព័ន្ធ ផ្វព្វផ្សាយ ក្នុង ស្រុក របស់ អាហ្វហ្គានីស្ថាន បាន រាយការណ៍ ថា សកម្មភាព បាតុកម្ម ខាងលើ ត្រូវបាន ធ្វើឡើង ដើម្បី ទាមទារ ឲ្យ មាន ការបំពាក់ ទង់ជាតិ ប្រទេស អាហ្វហ្គានីស្ថាន នៅ តាម អគារ ការិយាល័យ ដូច មុន ឡើងវិញ ជំនួស ឲ្យ ទង់ របស់ ក្រុម តាលី បង់ ។ ប៉ុន្តែ ក្រុម តាលី បង់ បាន បើក ការបាញ់ប្រហារ ទៅ លើ ក្រុម បាតុករ ។
ប្រភព ពី អាជ្ញាធរ សុខាភិបាល ក្នុង តំបន់ បាន អះអាង ថា មនុស្ស យ៉ាងហោច ២នាក់ បាន បាត់បង់ជីវិត និង ១២ នាក់ បាន រងរបួស ។ មិន តែ ប៉ុណ្ណោះ សមាជិក ក្រុម តាលី បង់ ក៏ ត្រូវ គេ អះអាង ថា បាន ប្រើ អំពើហិង្សា លើ អ្នកកាសែត មួយចំនួន ដែល យក ព័ត៌មាន អំពី ហេតុការណ៍ នោះ ផងដែរ ។
គួរ បញ្ជាក់ ថា ព្រឹត្តិការណ៍ ខាងលើ គឺជា សញ្ញា ដំបូង មួយ នៃ សំឡេង ប្រឆាំង នឹង ក្រុម តាលី បង់ ចាប់តាំងពី ក្រុម សកម្ម ប្រយុទ្ធ នេះ បាន ឡើងគ្រប់គ្រង អាហ្វហ្គានីស្ថាន កាលពី ថ្ងៃអាទិត្យ ចុង សប្តាហ៍ មុន ។ ប្រជាជន អាហ្វហ្គានីស្ថាន ជាច្រើន នាក់ បាន ភៀសខ្លួន ចេញ ពី ប្រទេស ហើយ រាប់ រយ នាក់ ទៀត កំពុង រង់ចាំ ឱកាស ដូចគ្នា នៅឯ ព្រលានយន្តហោះ ទីក្រុង កាប៊ុល ៕
អភិបាល ខេត្ត ព្រះសីហនុ និង លោកស្រី ឧបត្ថម្ភ ថវិកា សរុប ៨៥ លាន រៀល ជូន មន្រ្តី នគរបាល ខេត្ត ដែល កើត ជំងឺ កូវីដ១៩
( ព្រះសីហនុ) ៖ លោក គួច ចំរើន អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ និង លោកស្រី បាន បរិច្ចាគ ថវិកា ផ្ទាល់ខ្លួន សរុប ៨៥ លាន រៀល ជូន ដល់ មន្រ្តី នគរបាល ខេត្ត ដែល កើត ជំងឺ កូវីដ ចំនួន ២០ នាក់ ក្នុង នោះ បាន ជាសះស្បើយ ចំនួន ៥នាក់ និង កំពុង សម្រាក ព្យាបាល ចំនួន ១៥ នាក់ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ តំណាង ឲ្យ មន្រ្តី នគរបាល ទាំង ២០ នាក់ សូម ថ្លែងអំណរ អរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ លោក អភិបាល និង លោកស្រី ដែល បាន គិតគូរ ចំពោះ សុខ ទុក្ខ ដល់ កងកម្លាំង នគរបាល នៅពេល មាន ទុក្ខ ធុរៈ ហើយ ការចូលរួម ឧបត្ថម្ភ នេះ គឺ ពិតជា រួមចំណែក ដល់ ជីវភាព របស់ ពួកគេ បាន មួយ កម្រិត ទៀត ខណៈ មាន ជំងឺ កូវីដ១៩ ៕
ខេត្ត បាត់ដំបង បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ចំនួន ៧១ នាក់ និង ជាសះស្បើយ ៨៨ នាក់
សូម ជម្រាប ថា ចាប់តាំងពី ផ្ទុះ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ខេត្ត បាត់ដំបង បាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៤.៩១៦ នាក់ ព្យាបាល ជាសះស្បើយ ចំនួន ៣. ៧៣០ នាក់ ស្លាប់ ចំនួន ៦១ នាក់ និង កំពុង សម្រាក ព្យាបាល ចំនួន ១.១២៥ នាក់ ទៀត ៕
« ទឹកចិត្ត កម្ពុជា » សម្រេច ផែនការបរិច្ចាគ ទឹក បរិសុទ្ធ ដល់ មន្ទីរពេទ្យ និង មណ្ឌល សុខភាព ចំនួន ២០ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល
( ភ្នំពេញ ) ៖ យុទ្ធនាការ « ទឹកចិត្ត កម្ពុជា » របស់ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន សម្រេច ផែនការបរិច្ចាគ ទឹក បរិសុទ្ធ កម្ពុជា ចំនួន ២០០០ កេស ជូន ដល់ មន្ទីរពេទ្យ និង មណ្ឌល សុខភាព ចំនួន ២០ នៅ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ដែល បាន ចាប់ផ្តើម កាលពី ចុង ខែកក្កដា ដើម្បី ចូលរួម ទប់ស្កាត់ ការរាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
ក្រុមហ៊ុន បាន ប្រគល់ ទឹក បរិសុទ្ធ កម្ពុជា ចំនួន ៣០០ កេស ជូន ដល់ មន្ទីរ សុខាភិបាល រាជធានី ភ្នំពេញ មណ្ឌល សុខភាព ពញា ពន់ និង មជ្ឈមណ្ឌល ព្យាបាល កុមារ បេះដូង ជប៉ុន កាលពី ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ ដើម្បី បង្គ្រប់ ផែនការបរិច្ចាគ ទឹក បរិសុទ្ធ ជូន ដល់ មន្ទីរពេទ្យ និង មណ្ឌល សុខភាព ចំនួន ២០ ។
លោក បណ្ឌិត អ៊ឹម សុធារិទ្ធ នាយក ទំនាក់ទំនង សាធារណៈ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស មានប្រសាសន៍ ថា៖ « ក្រុមហ៊ុន ពិតជា អរគុណ ជាខ្លាំង ដល់ ក្រុម គ្រូពេទ្យ ដែល បាន លះបង់ យ៉ាង ធំធេង ដើម្បី ការពារ អាយុជីវិត ប្រជាពលរដ្ឋ គ្រប់ រូប ពី ការឆ្លង ជំងឺ កូវីដ - ១៩ ហើយ សង្ឃឹម ថា ការបរិច្ចាគ នេះ នឹង ចូលរួម មួយ ផ្នែក ជាមួយ កងទ័ព អាវ សរបស់ យើង ក៏ ដូចជា ផ្តល់ កម្លាំងចិត្ត បន្ថែម ដល់ ពួកគាត់ ផងដែរ » ។
ក្រៅពី ការបរិច្ចាគ ខាងលើ យុទ្ធនាការ « ទឹកចិត្ត កម្ពុជា » នា ពេល កន្លងមក បាន បរិច្ចាគ ភេសជ្ជៈ និង ទឹក បរិសុទ្ធ ជាច្រើន ម៉ឺន កេស ជូន ដល់ ស្ថាប័ន ផ្សេង ៗ ជាច្រើន ។
ក្រុមហ៊ុន នឹង បន្ត បរិច្ចាគ ដល់ មន្ទីរពេទ្យ និង ស្ថាប័ន ផ្សេង ទៀត នា ពេល ខាងមុខ ផងដែរ ៕
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត វង្សី វិស្សុត រដ្ឋមន្ដ្រី ប្រតិភូ អម នាយក រដ្ឋមន្ដ្រី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន គូសបញ្ជាក់ ថា នៅ ឆ្នាំ ២០២២ និង ឆ្នាំ ២០២៣ ខាងមុខ នេះ កម្ពុជា មាន ព្រឹត្ដការណ៍ ធំ ៗ ក្រៅពី ការដោះស្រាយ បញ្ហា កូវីដ - ១៩ ដែល ត្រូវការ ចំណាយ ខ្ពស់ ទាមទារ ឲ្យ មាន ការប្រមូល ចំណូល ពន្ធ និង ចំណូល មិន មែន សារពើពន្ធ ត្រូវតែ មាន ប្រសិទ្ធភាព ខ្ពស់ ។
ការគូសបញ្ជាក់ បែប នេះ ក្នុង ឱកាស ដែល លោក បណ្ឌិត វង្សី វិស្សុត អញ្ជើញ ចូលរួម ក្នុង សិក្ខាសាលា សភា ស្តីពី ការស្វែងយល់ អំពី ការកសាង ក្របខណ្ឌ គោល នយោបាយ ម៉ាក្រូ សេដ្ឋកិច្ច និង គោល នយោបាយ ហិរញ្ញវត្ថុ សាធារណៈ សម្រាប់ រៀបចំ សេចក្តីព្រាង ច្បាប់ ស្ដីពី ហិរញ្ញវត្ថុ សម្រាប់ គ្រប់គ្រង ឆ្នាំ ២០២២ នា ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០២១ តាម ប្រព័ន្ធ អនឡាញ ។
បណ្ឌិត វង្សី វិស្សុត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ឆ្នាំ ២០២២ និង ឆ្នាំ ២០២៣ បន្ថែម ពីលើ ការងារ គ្រប់គ្រង កូវីដ - ១៩ និង ដោះស្រាយ បញ្ហា សេដ្ឋកិច្ច ជីវភាពសង្គម យើង មាន កាតព្វកិច្ច ធំ គឺ ការធ្វើជា ម្ចាស់ ផ្ទះ អាស៊ាន រៀបចំ ការបោះឆ្នោត និង ស៊ីហ្គេម ដូច្នេះ គ្មាន ជម្រើស អ្វី ក្រៅពី ប្រមូលធនធាន ជាតិ ឲ្យ អស់ លទ្ធភាព ចំណូល ទាំង សារ ពន្ធ និង មិន មែន សារ ពន្ធ » ។
បន្ថែម ពី នោះ ទៀត មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង សេដ្ឋកិច្ច បាន គូសបញ្ជាក់ ថា បើ កម្ពុជា អាច ងើប ឡើងវិញ និង អាច គ្រប់គ្រង នូវ បញ្ហា កូវីដ - ១៩ បាន នៅ ឆ្នាំ ២០២២ ក្នុង នាម ជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន ឆ្នាំ ២០២២ គឺជា មុខមាត់ ប្រវិត្ដសាស្ដ្រ និង ដូរ មុខមាត់ ប្រទេស កម្ពុជា ទាំងស្រុង តែម្ដង ។
លោក បណ្ឌិត វង្សី វិស្សុត បាន លើកឡើង ថា ការរៀបចំ ការបោះឆ្នោត និង ការរៀបចំ ជា ម្ចាស់ ផ្ទះ កិច្ចប្រជុំ កំពូល អាស៊ាន នៅ ឆ្នាំ ២០២២ ព្រមទាំង ការដោះស្រាយ បញ្ហា កូវីដ - ១៩ គឺ សុទ្ធសឹងតែ ត្រូវការ ថវិកា ដូច្នេះ សម្ពាធ កម្ពុជា កាន់តែ ធ្ងន់ នៅ ពេល ដែល ខ្វះខាត ហើយ នៅ ឆ្នាំ ២០២៣ ស៊ីហ្គេម មួយ ទៀត ដែល ចាយ ចង់ ធំ ជាង ការរៀបចំ កិច្ចប្រជុំ អាស៊ាន ទៀត ផងដែរ ។
មន្ត្រី ជាន់ ខ្ពស់ កសិកម្ម៖ អ្នក ដាំ មៀន នៅ កម្ពុជា អាច មាន សង្ឃឹម ជាថ្មី នាំចេញ ទៅ ថៃ ឡើងវិញ បន្ទាប់ពី ចិន សម្រេច ឱ្យ ក្រុមហ៊ុន ថៃ ចំនួន ៥៦ អាច នាំចូល មៀន ទៅ ចិន បាន
( ភ្នំពេញ ) ៖ លោក ហ៊ាន វណ្ណ ហន រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា អ្នក ដាំ មៀន នៅ កម្ពុជា អាច មាន សង្ឃឹម ជាថ្មី ក្នុង នាំចេញ ទៅ ថៃ បន្ទាប់ពី រដ្ឋាភិបាល ចិន បាន ច សម្រេច នៅ ថ្ងៃ នេះ ឱ្យ ក្រុមហ៊ុន ថៃ ចំនួន ៥៦ អាច នាំចូល មៀន ទៅ ចិន បាន ឡើងវិញ ។
លោក ហ៊ាន វណ្ណ ហន បាន បញ្ជាក់ ឲ្យដឹង យ៉ាង ដូច្នេះ ថា « អ្នក ដាំ មៀន នៅ កម្ពុជា អាច មាន សង្ឃឹម ជាថ្មី បន្ទាប់ពី រដ្ឋាភិបាល ចិន បាន សម្រេច ឡើងវិញ ក្នុង ថ្ងៃ នេះ ឱ្យ ក្រុមហ៊ុន ថៃ ៥៦ ក្រុមហ៊ុន នាំចូល មៀន ទៅ ប្រទេស ចិន ដោយ ឆ្លងកាត់ នីតិវិធី លាង សម្អាត ដ៏ ហ្មត់ចត់ មួយ » ។
សូម ជម្រាប ថា រយៈពេល ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ មាន ប្រជាពលរដ្ឋ អ្នក ដាំ មៀន នៅ តាម ខេត្ត ជាប់ ព្រំដែន កម្ពុជា - ថៃ បាន បង្ហាញ នូវ ក្តី ព្រួយបារម្ភ ចំពោះ ការខាតបង់ របស់ ពួកគាត់ ដោយសារ មៀន ដល់ ពេល ប្រមូល ផល ស្រាប់តែ មិន អាច នាំចេញ ទៅ ប្រទេស ថៃ បាន ខណៈ ប្រទេស ថៃ ដែល ធ្លាប់ នាំ មៀន ទៅ ទីផ្សារ ចិន ជួប បញ្ហា ដោយសារ មាន ជាប់ នៅលើ ផ្លែ មៀន នូវ ចៃ ម្សៅ ឬ ហៅ ថា ក្រាម្សៅ ។
សហគមន៍ មៀន ប៉ៃលិន បាន អះអាង ថា សមាជិក របស់ ខ្លួន មាន នៅ ខេត្ត បាត់ដំបង ប៉ៃលិន បន្ទាយមានជ័យ មាន ទិន្នផល មៀន ប៉ៃលិន ដែល ត្រូវ ប្រមូល ផល ចំនួន ៥ម៉ឺន តោន ។
បន្ទាប់ពី ទទួលបាន ដំណឹង អំពី ការលំបាក របស់ ប្រជាកសិករ ដាំ មៀន នេះ នៅ រសៀល ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០២១ សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជា ឲ្យ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការបញ្ជាការដ្ឋាន អង្គរក្ស និង ជា នាយក រង ខុទ្ទកាល័យ សម្តេច តេជោ ហ៊ុន សែន ប្រមូល ទិញ ផ្លែ មៀន របស់ កសិករ នៅ តាម បណ្ដា ខេត្ត ជាប់ ព្រំដែន កម្ពុជា - ថៃ ដែល ជួបប្រទះ នូវ បញ្ហា ក្នុង ការនាំចេញ ទៅ លក់ នៅ ក្រៅ ប្រទេស ដោយសារ ការឆ្លង រីករាលដាល ជំងឺ កូវី១៩ ។
សម្រាប់ បងប្អូន ប្រជាកសិករ ដែល មាន ផល្លានុផល ផ្លែ មៀន ឬ តាង៉ែន សូម ទំនាក់ទំនង មក ក្រុមការងារ របស់ នាយ ឧត្តមសេនីយ៍ កិត្តិបណ្ឌិត ហ៉ីង ប៊ុន ហៀង និង ចាប់ផ្តើម ទទួល ទិញ ពី ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ នេះ តទៅ ។ ទីកន្លែង ទទួល ទិញ នៅ តារាង បាល់ទាត់ ខេត្ត បាត់ដំបង ជិត សាលា ភូមិភាគ ឬ ទំនាក់ទំនង តាម រយៈ ទូរស័ព្ទ លេខ៖
សេចក្តីប្រកាស ព័ត៌មាន ដដែល បាន បញ្ជាក់ ថា ដោយ អនុវត្ត តាម សារាចរ របស់ រាជ រដ្ឋាភិបាល លេខ ០៤ សរ ចុះ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២១ ស្តីពី ការដាក់ចេញ យុទ្ធនាការ ពង្រឹង វិធានការប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ . នា ព្រឹក ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ ក្រសួង យុត្តិធម៌ បាន បន្ត រៀបចំ នូវ ការធ្វើតេស្តរហ័ស រក មេរោគ កូវីដ - ១៩ លើក ទី២ ជូន ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង យុត្តិធម៌ នៅ ទីស្តីការ ក្រសួង យុត្តិធម៌ និង នៅ តាម អង្គភាព ទាំងអស់ ចំណុះ ក្រសួង យុត្តិធម៌ ។
« ក្រោយពី បញ្ចប់ ការធ្វើតេស្ត រហ័ស នេះ ឃើញ ថា ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ក្រសួង យុត្តិធម៌ សរុប ចំនួន ៤៦២ រូប បាន មក ធ្វើតេស្តរហ័ស រក មេរោគ កូវីដ - ១៩ ហើយ ជា លទ្ធផល នៅក្នុង ចំណោម អ្នក ដែល បាន ធ្វើតេស្ត រហ័ស ទាំងអស់ គឺ មិន មាន មន្ត្រី ណា ម្នាក់ ត្រូវបាន រកឃើញ ថា មាន វិជ្ជមាន មេរោគ កូវីដ - ១៩ នោះ ទេ » ។ ក្រសួង យុត្តិធម៌ បញ្ជាក់ បន្ថែម ។
ជាមួយនឹង លទ្ធផល ល្អ ប្រសើរ ខាងលើ នេះ ក្រសួង យុត្តិធម៌ នឹង បន្ត ពង្រឹង ការអនុវត្ត ដោយ យកចិត្តទុកដាក់ នូវ វិធានការ សុខាភិបាល និង ប្រកាន់ខ្ជាប់ នូវ វិធានការ គន្លឹះ ៣កុំ និង ៣ការពារ ព្រមទាំង បន្ត អនុវត្ត ការធ្វើតេស្តរហ័ស រក មេរោគ វីដ - ១៩ ជូន ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ទាំងអស់ នៃ ក្រសួង យុត្តិធម៌ ដើម្បី ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការប្រយុទ្ធ និង ទប់ស្កាត់ នូវ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
សូម ជម្រាប ថា ក្រសួង យុត្តិធម៌ កាលពី ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២១ បាន ធ្វើតេស្ត រហ័ស លើក ទី១ លើ មន្រ្តី របស់ ខ្លួន ជិត ៥០០ នាក់ ហើយ ជា លទ្ធផល បាន រកឃើញ អ្នកវិជ្ជមាន កូវីដ - ១៩ ចំនួន ៣នាក់ ៕ ខេត្ត ស្វាយរៀង ប្រកាស រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ប្រភេទ Delta ចំនួន ២៦ នាក់ . សូម អ្នក ពាក់ព័ន្ធ ធ្វើចត្តាឡី ស័ក ២១ ថ្ងៃ និង តាមដាន សុខភាព ជាប្រចាំ
( ភ្នំពេញ ) ៖ បណ្ឌិត វង្សី វិស្សុត រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ថ្លែង ថា ប្រទេស កម្ពុជា ក្រ តែ កម្រិត នៃ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ស្ថិត នៅ ដូចជាមួយ កម្រិត ប្រទេស អ្នក មាន ដែរ ។
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង ក្នុង សិក្ខាសាលា ឈ្វេងយល់ អំពី ការកសាង ក្រម ខណ្ឌ គោល នយោបាយ ម៉ាក្រូ សេដ្ឋកិច្ច និង គោល នយោបាយ ហិរញ្ញា វត្ថុ សាធារណៈ សម្រាប់ រៀបចំ សេចក្ដីព្រាង ច្បាប់ ស្ដីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០២២ រវាង គណៈកម្មការ ទី២ នៃ រដ្ឋសភា និង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០២១ ។
លោក ថ្លែង ថា « ពិភពលោក គិត ជា មធ្យម អ្នក ចាក់ វ៉ាក់សាំង បាន ១ដូស មាន ៣២ ភាគរយ ផ្ទុយទៅវិញ ប្រទេស អ្នកក្រ ទើប បាន ចាក់ ១.២ភាគរយ ទេ ក្រៅពី នោះ ប្រទេស អ្នក មាន ល្មម ប្រទេស អ្នក មាន គេ យក អស់ ហើយ វ៉ាក់សាំង ប៉ុន្ដែ ចំណែក កម្ពុជា ប្រទេស ក្រ តែ កម្ពុជា នៅ ជាមួយ ប្រទេស អ្នក មាន ចំពោះ កម្រិត នៃ ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ » ។
លោក បញ្ជាក់ ថា សម្រាប់ សមត្ថភាព ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នៅ កម្ពុជា រយៈពេល ២ខែ កន្លងមក នេះ កម្ពុជា ឡើង មក ធម្មតា ហើយ ខណៈ ក្នុង ខែឧសភា និង មិថុនា ឆ្នាំ ២០២១ កន្លងទៅ កម្ពុជា ជួប ការលំបាក ខ្លាំង ។ បច្ចុប្បន្ន នេះ កម្ពុជា បាន ឡើង មក ដំណាក់កាល ល្អ ឡើងវិញ ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ក្នុង នោះ មាន ការចាក់ វ៉ាក់សាំង និង វិធានការចាំបាច់ ផ្សេង ទៀត ។
លោក ថា នៅ ឆ្នាំ ២០២២ ខាងមុខ គឺ នៅតែ មិន ប្រាកដប្រជា មិន ដឹង ថា ជំងឺ កូវីដ១៩ ចប់ ពេលណា នោះ ទេ ព្រោះថា ពិភពលោក នឹង មាន សុវត្ថិភាព ទាល់តែ ប្រទេស ទាំងអស់ មាន សុវត្ថិភាព ដូចជា ការចាក់ វ៉ា សាំង ឲ្យបាន ទាំងអស់ ទើប អាច បន្ថយ នូវ ការឆ្លង ។ សម្រាប់ កម្ពុជា វិញ បើ គ្រប់គ្រង បាន ល្អ ហើយ ប្រទេស ជិតខាង មាន បញ្ហា នោះ កម្ពុជា ស្រួល នោះ ដែរ ។
លោក បញ្ជាក់ បន្ត ថា ប្រសិនបើ សមត្ថភាព នៃ គ្រប់គ្រង ជំងឺ កូវីដ១៩ នៅ កម្ពុជា បាន ល្អ នោះ ជា គន្លឹះ សម្រាប់ ការងើបឡើង នូវ សេដ្ឋកិច្ច និង ការស្ដារ នូវ ជីវភាព ប្រជាជន តាមរយៈ ការធ្វើ ការងារ ប្រកប របប ឡើងវិញ ពិតជា មាន សារៈសំខាន់ ។
ស្ថានភាព សេដ្ឋកិច្ច ពិភពលោក ដែល ប្រទេស ទីផ្សារ របស់ កម្ពុជា មាន លក្ខណៈ ល្អ ប្រសើរ ដូចជា ចិន អាមេរិក អឺរ៉ុប និង អង់គ្លេស គឺ សុទ្ធតែ ងើប ឡើងវិញ ទាំងអស់ ហើយ ជា ទីផ្សារ នាំចេញ របស់ កម្ពុជា ចំណុច ខ្លាំង របស់ កម្ពុជា នៅពេល កម្ពុជា ងើប ឡើងវិញ នោះ នឹង បង្កើត ឱកាស ល្អ សម្រាប់ វិស័យ ឧស្សាហកម្ម ខណៈ ដៃ គូ ប្រកួតប្រជែង ជាមួយ កម្ពុជា ដូចជា ភូមា បង់ក្លាដេស កំពុងតែ ជាប់ ផុង ក្នុង ជំងឺ កូវីដ១៨ ក៏ ដូចជា វិបត្តិ នយោបាយ រួមទាំង វៀតណាម ផងដែរ ៕
ស្ថានភាព នៅ ក្រុង ស្ទឹងត្រែង ស្ងប់ស្ងាត់ ក្រោយ បិទ ខ្ទប់ ទាំងស្រុង ដោយសារ ឆ្លង រីករាល ជំងឺ កូវីដ បំប្លែង ខ្លួន ថ្មី Delta
( ស្ទឹងត្រែង ) ៖ ក្រុង ស្ទឹងត្រែង ខេត្ត ស្ទឹងត្រែង ត្រូវបាន បិទ ខ្ទប់ ទាំងស្រុង ចាប់ពី នៅ ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ នេះ រហូត មាន ការសម្រេច ជាថ្មី បន្ទាប់ពី ខេត្ត ភាគ ឦសាន មួយ នេះ រង នូវ ការវាយប្រហារ ពី មេរោគ កូវីដ១៩ បំប្លែង ខ្លួន ថ្មី ប្រភេទ Delta ដែល បណ្ដាលឲ្យ មនុស្ស ជាច្រើន ជា បន្ដ បន្ទាប់ រកឃើញ វិជ្ជមាន ជំងឺ កូវីដ ។
ក្រោយ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែង ចេញ សេចក្ដីសម្រេច បិទ ខ្ទប់ ហើយ នោះ ស្ថានភាព ទូទៅ នៅក្នុង ក្រុង ស្ទឹងត្រែង បាន ប្រែ ពី ភាពអ៊ូអរ ទៅជា ស្ងប់ស្ងាត់ ស្ទើរតែ គ្មាន ប្រជាពលរដ្ឋ ធ្វើចរាចរណ៍ តាម ដងផ្លូវ ពោល មាន តែ កម្លាំង អនុវត្ត ច្បាប់ និង មន្ដ្រី សុខាភិបាល ដែល មាន តួនាទី ក្នុង ប្រយុទ្ធ ប្រឆាំង ជាមួយ ជំងឺ កូវីដ១៩ ប៉ុណ្ណោះ ។
ជាក់ស្ដែង នៅ ព្រឹក ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ នេះ លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ ឌី មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត ស្ទឹងត្រែង បាន ចុះ ពិនិត្យ នៅ តាម គោលដៅ ដែល ត្រូវ បិទ ខ្ទប់ ព្រមទាំង ណែនាំ ដល់ ប្រជាពលរដ្ឋ ត្រូវ គោរព និង អនុវត្ត តាម សេចក្ដីសម្រេច របស់ រដ្ឋបាល ខេត្ត ដើម្បី ទប់ស្កាត់ ការឆ្លង រីករាលដាល ជំងឺ កូវីដ១៩ ។
ប្រការ១ នៃ សេចក្ដីសម្រេច នេះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ត្រូវបាន បិទ ខ្ទប់ ភូមិសាស្ដ្រ ក្រុង ស្ទឹងត្រែង ខេត្ត ស្ទឹងត្រែង ជា បណ្ដោះអាសន្ន ចាប់ពី វេលា ម៉ោង ២៣៖ ៥៩ នាទី យប់ ថ្ងៃទី ១៧ ខែសីហា ឆ្នាំ ២០២១ រហូតដល់ មាន ការសម្រេច ថ្មី សំដៅ ទប់ស្កាត់ ការឆ្លង រាលដាល ក្នុង សហគមន៍ ដែល បណ្ដាល មកពី មេរោគ កូវីដ១៩ ប្រភេទ Delta ព្រមទាំង ធានា ការពារ បាន អាយុជីវិត ប្រជាជន សុខភាព សាធារណៈ និង សន្ដិសុខ សុវត្ថិភាព សង្គម » ។
នៅក្នុង កំឡុង ពេល នៃ មហាសន្និបាត នេះ នឹង មាន កិច្ចប្រជុំ តាម គណៈកម្មាធិការ ជាច្រើន របស់ អាយ ប៉ា ដែល សម្តេច ប្រធាន រដ្ឋសភា និង សមាជិក គណៈប្រតិភូ នឹង អញ្ជើញ ចូលរួម មាន ដូច ជា៖ ពិធី បើក - បិទ នៃ មហាសន្និបាត កិច្ចប្រជុំ គណៈ កម្មាធិការ ស្រ្តី អាយប៉ា កិច្ចប្រជុំ របស់ អ្នកនយោបាយ សភា អាយប៉ា វ័យ ក្មេង កិច្ចប្រជុំ គណៈកម្មាធិការ នយោបាយ កិច្ចប្រជុំ គណៈកម្មាធិការ សេដ្ឋកិច្ច កិច្ចប្រជុំ គណៈកម្មាធិការ សង្គមកិច្ច និង កិច្ចប្រជុំ គណៈកម្មាធិការ រៀបចំ ។
អន្តរសភា អាស៊ាន ដែល ហៅ កាត់ ថា អាយ ប៉ា(AIPA) ជា អង្គការ អន្តរសភា តំណាង ស្ថាប័ន នីតិប្បញ្ញត្តិ នៃ បណ្តា ប្រទេស ជា សមាជិក សមាគម ប្រជាជាតិ អាស៊ី អាគ្នេយ៍ (ASEAN) ដែល មាន ប្រទេស ព្រុយណេដា រូស្សា ឡាម កម្ពុជា ឥណ្ឌូណេស៊ី ឡាវ ម៉ាឡេស៊ី មីយ៉ាន់ម៉ា ហ្វីលីពីន សិង្ហបុរី ថៃ និង វៀតណាម ។
បើ តាម សេចក្តីជូនដំណឹង របស់ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា . អន្តរសភា អាស៊ាន ជា ការប្រមូលផ្តុំ សំឡេង ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ អាស៊ាន ជា ដៃគូ របស់ អាស៊ាន ក្នុង ការជំរុញ ឱ្យ សម្រេចបាន នូវ គោលដៅ សហគមន៍ អាស៊ាន តែ មួយ ។ មហាសន្និ បាត អន្តរសភា អាស៊ាន បាន ប្រារព្ធ ធ្វើជា រៀងរាល់ ឆ្នាំ ដោយ ប្រទេស ជា សមាជិក តាម វេន នៃ លំដាប់ អក្ខរ ក្រម នៃ ឈ្មោះ ប្រទេស តាម អក្សរ ឡាតាំង ៕ ខេត្ត ត្បូងឃ្មុំ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ៣៣ នាក់ ជាសះស្បើយ ១៧នាក់
ជាមួយនឹង ការរក ឃើញ អ្នកជំងឺ កូវីដ - ១៩ ចំនួន ៣៣ នាក់ បន្ថែម ទៀត នេះ រដ្ឋបាល ខេត្ត សូម អំពាវនាវ អ្នក ប៉ះពាល់ ផ្ទាល់ និង អ្នក ប៉ះពាល់ ប្រយោល សូម រួសរាន់ មក ជួប ក្រុម គ្រូពេទ្យ និង ធ្វើចត្តាឡី ស័ក ដើម្បី យក សំណាក ទៅ ពិនិត្យ និង អ្នក ដែល ប៉ះពាល់ ដោយ ប្រយោល ជា អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ខាងលើ សូម រួសរាន់ ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ ក្នុង ក្រុមគ្រួសារ រៀង ៗ ខ្លួន ដោយ មិន ត្រូវ ពាក់ព័ន្ធ ជាមួយ អ្នកដទៃ ជាដាច់ខាត ។
ក្រុម គ្រូពេទ្យ តាម រថយន្ត ចល័ត យោធ ភូមិភាគ ទី៥ បន្ត ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូសទី១ ជូន ពលរដ្ឋ និង កម្មករ ក្នុង ក្រុង ប៉ោយប៉ែត
( បន្ទាយមានជ័យ )៖ ក្រុម គ្រូពេទ្យ រថយន្ត ចល័ត យោធ ភូមិភាគ ទី៥ បាន បន្ត យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ដូសទី១ ជូន ប្រជាពលរដ្ឋ កម្មករ និយោជិត ក្នុង ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
យុទ្ធនាការ នេះ ដឹកនាំ ផ្ទាល់ ពីសំណាក់ លោក ឧត្តមសេនីយ៍ ទោ សេង ធារិន មេបញ្ជាការ រង នាយ សេនាធិការ យោធ ភូមិភាគ ទី៥ និង ជា ប្រធាន គ្រប់គ្រង សន្តិសុខ សណ្ដាប់ធ្នាប់ គោលដៅ ធ្វើចត្តាឡី ស័ក ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ យោធ ភូមិភាគ ទី៥ នា ថ្ងៃទី ១៧ ខែសីហា ម្សិលមិញ ។
លោក ឧត្ត សេនីយ៍ ទោ សេង ធារិន ក៏ បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ដែល បាន ទទួល ការចាក់ វ៉ាក់សាំង ដូស ទី១ រួច ត្រូវ អនុវត្ត តាម ការណែនាំ របស់ គ្រូពេទ្យ និង បន្ត អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ជាពិសេស វិធានការ « ៣កុំ ម និង ៣កាពារ » របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នូវ ជំងឺ កូវីដ១៩ ដ៏ កាច សាហាវ នេះ ។
ឆ្លើយតប ទៅនឹង ការផ្តល់ ជូន នូវ វ៉ាក់សាំង ដូស ទី១នេះ ប្រជាពលរដ្ឋ បាន សម្តែង សេចក្តីត្រេកអរ រីករាយ និង រំភើប ឥត ឧបមា ដល់ ប្រមុខ រាជ រដ្ឋាភិបាល និង បាន សម្តែង នូវ ក្តី ត្រេកអរ ក្រៃលែង ដែល ទទួលបាន ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជាពិសេស សូម គោរព អរគុណ ជូន ចំពោះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល សម្តេច បាន យកចិត្តទុកដាក់ និង គិតគូរ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ ព្រមទាំង អរគុណ ចំពោះ អាជ្ញាធរ សមត្ថកិច្ច និង ក្រុមការងារ ចុះ ចាក់ វ៉ាក់សាំង ជូន ពួកគាត់ នា ពេលនេះ ៕
ក្រុមហ៊ុន ផ្គត់ផ្គង់ ជណ្តើរ យន្ត « អូឌីម៉ាស់ » បញ្ជាក់ ភាព សុចរិត លើ អាជីវកម្ម ក្រោយ គេ និយាយ បង្ខូច កេរ្តិ៍ឈ្មោះ
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ផ្គត់ផ្គង់ ជណ្តើរ យន្ត នៅ កម្ពុជា ដែល មាន ឈ្មោះ ថា « អូឌី ម៉ាស់ ( ខេមបូឌា ) ឯ . ក » បាន ទាត់ ចោល ទាំងស្រុង ចំពោះ ការនិយាយ បំភ្លៃ ការពិត និង បង្ខូច កេរ្តិ៍ឈ្មោះ ក្រុមហ៊ុន ពីសំណាក់ អ្នករកស៊ី លើ ការផ្គត់ផ្គង់ ជណ្តើរ យន្ត ដូចគ្នា ។ ជន ដែល បាន និយាយ បង្ខូច កេរ្តិ៍ឈ្មោះ ក្រុមហ៊ុន នេះ ក៏ បាន ចូលខ្លួន សូម ទោស ចំពោះ កំហុសឆ្គង របស់ ពួកគេ នៅ ចំពោះមុខ សមត្ថកិច្ច ផងដែរ ។
ក្នុង សេចក្តីជូនដំណឹង របស់ ក្រុមហ៊ុន ចេញផ្សាយ នៅ ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ ថា កាលពី ពេល ថ្មី ៗ នេះ មាន បុគ្គល ពីរ រូប ឈ្មោះ ជឿន កក្កដា ភេទ ប្រុស អាយុ ៣៦ ឆ្នាំ មុខរបរ ផ្នែក លក់ ក្នុង ក្រុមហ៊ុន ជណ្តើរ យន្ត និង ឈ្មោះ សា លីន ភេទ ស្រី អាយុ ២៦ ឆ្នាំ មុខរបរ បុគ្គលិក ការិយាល័យ ក្រុមហ៊ុន ជណ្តើរ យន្ត ដែរ នោះ បាន និយាយ បង្កាច់ បង្អួច កេរ្តិ៍ឈ្មោះ ក្រុមហ៊ុន « អូឌីម៉ាស់ » ។
ក្នុង សេចក្តីជូនដំណឹង បាន បញ្ជាក់ ថា បុគ្គល ទាំង ពីរ នេះ បាន ព្យាយាម ម្ដង ហើយ ម្ដង ទៀត ជាច្រើន លើក ច្រើន សា ក្នុង ការនិយាយ មួល បង្កាច់បង្អួច កេរ្តិ៍ឈ្មោះ ក្រុមហ៊ុន « អូឌីម៉ាស់ » ថា ជា ក្រុមហ៊ុន នាំចូល ជណ្តើរ យន្ត ក្លែងក្លាយ និង យក ឈ្មោះ ជណ្តើរ យន្ត មក គ្រាន់តែ ជាន់ ម៉ាក បន្ថែម ដើម្បី បោកប្រាស់ អតិថិជន ។
ក្រោយ ទទួលបាន ព័ត៌មាន ពី ការនិយាយ បង្ខូច កេរ្តិ៍ឈ្មោះ នេះ ក្រុមហ៊ុន « អូឌីម៉ាស់ » ក៏ បាន ស្រាវជ្រាវ ហើយ ឈាន ទៅ ប្តឹង សមត្ថកិច្ច និង កោះហៅ ឈ្មោះ លឿន កក្កដា និង ឈ្មោះ សា លីន ចូល ខ្លួន មក បំភ្លឺ លើ ករណី នេះ ។ នៅ ថ្ងៃទី ០២ ខែសីហា ឆ្នាំ ២០២១ ឈ្មោះ សា លីន បាន សារភាព ថា ខ្លួន ធ្វើ តាម បញ្ជា របស់ ជឿន កក្កដា ។
នៅ ចំពោះមុខ សមត្ថកិច្ច បុគ្គល ទាំង ពីរ បាន ព្រម ទទួលស្គាល់ កំហុស ហើយ បាន យល់ព្រម ធ្វើ កិច្ចសន្យា ទទួលស្គាល់ កំហុស របស់ ខ្លួន ។ ក្នុង កិច្ចសន្យា លោក ជឿន កក្កដា បាន រៀបរាប់ ថា « ខ្ញុំបាទ មាន ការសោកស្តាយ ។ ខ្ញុំបាទ បាន និយាយ ថា ក្រុមហ៊ុន អូឌី ម៉ាស់ ខេមបូឌា លក់ ជណ្តើរ យន្ត ម៉ាក OTIS ក្លែងក្លាយ ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ ឈ្មោះ ក្រុមហ៊ុន អូឌី ម៉ាស់ ខេមបូឌា និង នាំឱ្យ អតិថិជន មាន ការយល់ ច្រឡំ លើ ក្រុមហ៊ុន អូឌី ម៉ាស់ ខេមបូឌា » ។
លោក ជឿន កក្កដា បាន សន្យា មិន និយាយ អ្វី ដែល នាំឱ្យ ប៉ះពាល់ ដល់ ក្រុមហ៊ុន អូឌី ម៉ាស់ ខេមបូឌា ទៀត ឡើយ ។
ក្នុង សេចក្តីជូនដំណឹង នេះ ក្រុមហ៊ុន « អូឌីម៉ាស់ » បាន គូសបញ្ជាក់ ដែរ ថា ក្រុមហ៊ុន នេះ ជា ក្រុមហ៊ុន ស្រប ច្បាប់ និង ជា អ្នកឯកទេស ក្នុង ការផ្គត់ផ្គង់ ជណ្តើរ យន្ត សុទ្ធ ១០០ % ក្នុង ទីផ្សារ នៃ ប្រទេស កម្ពុជា ។ ក្រុមហ៊ុន ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ ស្មោះត្រង់ សុចរិត ទៀង ត្រង់ ជាមួយ អតិថិជន ក៏ ដូចជា ដៃគូ ប្រកួតប្រជែង ក្នុង វិស័យ មួយ នេះ ផងដែរ ។
លើស ពី នេះ ទៀត បណ្ណ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ របស់ ក្រសួង ការពារ ជាតិ ត្រូវបាន ចុះហត្ថលេខា ដោយ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ផងដែរ ។
បើ ទោះបី មាន ការចាប់អារម្មណ៍ ទៅ លើ សោភ័ណភាព និង ការរៀបចំ នៅលើ បណ្ណ នេះ ក្តី ក៏ មាន ការ ទោមនស្ស មួយចំនួន ពី អ្នក ចាក់ វ៉ាក់សាំង ដោយសារតែ បណ្ណ នេះ មិន អាច ផ្តល់ ជូន ពួកគេ ភ្លាម ៗ ក្រោយពេល ចាក់ នោះ ឡើយ ។ ការ ដែល មិន អាច ផ្តល់ ជូន ភ្លាម ៗ នេះ ក៏ ដោយសារ បញ្ហា បច្ចេកទេស មួយចំនួន ជាពិសេស ការរៀបចំ ទិន្នន័យ របស់ ចាក់ តែម្តង ។
លោក ឧត្តមសេនីយ៍ ទោ កុសល សុវណ្ណ វិសាល នាយក នៃ នាយកដ្ឋាន បញ្ជូន សារ ក្រសួង ការពារ ជាតិ បាន បញ្ជាក់ ថា ការផលិត បណ្ណ ចាក់ វ៉ាក់សាំង នេះ មាន ៧ដំណាក់កាល រួម មាន៖ ការស្រង់ ទិន្នន័យ អ្នក ចាក់ វ៉ាក់សាំង មាន ថត រូប ថត ទម្រង់ ព័ត៌មាន ចាក់ វ៉ាក់សាំង និង អត្តសញ្ញាណ បណ្ណ . បញ្ជូន ទិន្នន័យ ទៅ កន្លែង ផ្ទុក ទិន្នន័យ . បញ្ចូល ទិន្នន័យ អ្នក ចាក់ ទៅក្នុង ប្រព័ន្ធ . ពិនិត្យ អនុម័ត និង ស្នើសុំ បោះពុម្ព . បោះពុម្ព . កាត់ រៀបចំ កាត់ និង ចែកចាយ កាត ។
លោក ឧត្តមសេនីយ៍ ទោ កុសល សុវណ្ណ វិសាល បាន បញ្ជាក់ ថា បច្ចុប្បន្ន កម្លាំង ផលិត កាត នេះ មាន ចំនួន ប្រមាណ ១.៧០០ នាក់ ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន អះអាង ថា ការផលិត បណ្ណ នេះ នឹង រួចរាល់ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១
