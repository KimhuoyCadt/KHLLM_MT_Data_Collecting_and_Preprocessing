( កោះកុង ) ៖ លោកស្រី មិថុនា ភូថង អភិបាល ខេត្ត កោះកុង និង លោក ហោ សេរី វឌ្ឍន៍ ប្រធាន មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ ព្រមទាំង ក្រុមការងារ បាន ប្រគល់ ជូន នូវ អំណោយ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ព្រមទាំង សប្បុរស ជន ផ្សេង ៗ ទៀត តាមរយៈ មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ ដែល ផ្តួចផ្តើម គំនិត ដោយ លោក អ៊ុក ភក្ត្រា អភិបាល រង ខេត្ត កោះកុង ជូន ដល់ ប្រជាពលរដ្ឋ ១០០ គ្រួសារ ក្នុង ស្រុក មណ្ឌល សីមា ខេត្ត កោះកុង ដែល ស្ថិត ក្នុង វត្ត ចាំ យាម ៥០ គ្រួសារ និង វត្ត បាក់ ខ្លង ៥០ គ្រួសារ នា ថ្ងៃទី ១២ ខែសីហា ។
នា ឱកាស នោះ ដែរ លោកស្រី មិថុនា ភូថង សូម ថ្លែងអំណរគុណ ដល់ ទឹកចិត្ត សប្បុរស របស់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី ព្រមទាំង សប្បុរសជន ដែល បរិច្ចាក តាមរយៈ មូលនិធិ កម្ពុជា ប្រឆាំង កូវីដ១៩ មាន លោក ហោ សេរី វឌ្ឍន៍ ជា ប្រធាន ជូន មកដល់ ប្រជាពលរដ្ឋ ខេត្ត កោះកុង នា ពេលនេះ ។
តំណាង ប្រជាពលរដ្ឋ លោកស្រី អភិបាល ខេត្ត ក៏ សូម កោតសរសើរ ពី ការយកចិត្តទុកដាក់ ខ្ពស់ និង ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង កិច្ចការ ប្រឆាំង និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ជាពិសេស ការមើលឃើញ ពី ទុក លំបាក ដែល រដ្ឋបាល ខេត្ត កំពុង ជួបប្រទះ នា ពេល បច្ចុប្បន្ន ប្រឈម នឹង ការកើនឡើង នៃ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
នា ឱកាស នោះ លោក ហោ សេរី វឌ្ឍន៍ ប្រធាន មូលនិធិ បាន ពាំនាំ ផ្តាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុន្នី និង សូម ចូលរួម គាំទ្រ នូវ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ និង តួនាទី ភារកិច្ច ចំពោះ មុខ ក្នុង នាម រដ្ឋបាល ខេត្ត ដើម្បី តាមដាន និង ស្វែងរក បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន វិជ្ជមាន កូវីដ១៩ ។
លោក ក៏ បាន លើកទឹកចិត្ត ឱ្យ ប្រជាពលរដ្ឋ ក៏ ដូចជា អាជ្ញាធរ ត្រូវ មាន « ក្តីសង្ឃឹម » ថា យើង អាច យកឈ្នះ លើ ជំងឺ នេះ បាន បើ យើង ចូលរួម អនុវត្តន៍ តាម ការណែនាំ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ក្រសួង សុខាភិបាល និង រដ្ឋបាល ជាមួយគ្នា ដើម្បី ទប់ស្កាត់ អោយ បាន ការចម្លង ពី មនុស្ស ម្នាក់ ទៅ មនុស្ស ម្នាក់ និង ទៅ ចូល សហគមន៍ ។
( ប៉េកាំង ) ៖ អាជ្ញាធរ ចិន នៅ ថ្ងៃសុក្រ នេះ បាន រាយការណ៍ ថា មនុស្ស យ៉ាងហោចណាស់ ២១ នាក់ បាន ស្លាប់ ដោយសារ ភ្លៀង ធ្លាក់ ខ្លាំង បាន វាយប្រហារ ខេត្ត ហ៊ូប៉ី (Hubei) ភាគ កណ្តាល ប្រទេស ចិន ប៉ុន្មាន សប្តាហ៍ បន្ទាប់ពី គ្រោះ ទឹក ជំនន់ បាន វាយប្រហារ ខេត្ត ជិតខាង មួយ ទៀត ដែល បណ្ដាលឱ្យ មនុស្ស រាប់ រយ នាក់ បាន ស្លាប់ និង ទ្រព្យសម្បត្តិ ជាច្រើន ត្រូវបាន បំផ្លិចបំផ្លាញ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន AFP នៅ រសៀល ថ្ងៃសុក្រ ទី ១៣ ខែសីហា ឆ្នាំ ២០២១ ។
ការិយាល័យ គ្រប់គ្រង គ្រា អាសន្ន របស់ ខេត្ត បាន ប្រកាស ថា ភ្លៀង ធ្លាក់ ខ្លាំង នៅក្នុង ខេត្ត Hubei បាន បណ្តាលឱ្យ ដាច់ ចរន្ត អគ្គិសនី និង ការបាក់ ដី ដែល បាន បំផ្លាញ ផ្ទះសម្បែង រាប់ រយ ខ្នង និង បាន បង្ខំឱ្យ ប្រជាជន ជិត ៦.០០០ នាក់ ជម្លៀស ចេញ ពី ផ្ទះសម្បែង ។ បើ តាម ទូរទស្សន៍ រដ្ឋ ចិន បាន រាយការណ៍ នៅ ថ្ងៃសុក្រ នេះ ថា មនុស្ស ២១ នាក់ បាន ស្លាប់ និង ០៤ នាក់ ផ្សេង ទៀត កំពុង បាត់ខ្លួន នៅឡើយ ខណៈ ភ្លៀង ធ្លាក់ ខ្លាំង បាន កើតមាន នៅ តាម ទីក្រុង នានា ក្នុង ខេត្ត នេះ កាលពី ថ្ងៃពុធ កន្លងទៅ ។
គួរ បញ្ជាក់ តាម រដ្ឋបាល ឧតុនិយម ចិន បាន ព្រមាន ថា ភ្លៀង ធ្លាក់ ខ្លាំង ទំនងជា បន្ត អូសបន្លាយ រហូតដល់ សប្តាហ៍ ក្រោយ ដោយ តំបន់ ដែល ស្ថិត នៅ តាម បណ្ដោយ ដង ទន្លេ យ៉ាង សេ (Yangtze) រួមទាំង ទីក្រុង សៀងហៃ គឺ ងាយ នឹង រងគ្រោះ ខ្លាំង បំផុត ដោយសារ គ្រោះ ទឹក ជំនន់ ដែល បង្កឡើង ដោយ ភ្លៀង ធ្លាក់ ខ្លាំង នេះ ៕ អាជ្ញាធរ ខេត្ត កោះកុង ឃាត់ខ្លួន ពលករ ខ្មែរ ៩នាក់ ដែល លួច ឆ្លង ដែន ខុស ច្បាប់ ចូល កម្ពុជា និង ត្រូវ បញ្ជូន ទៅ ធ្វើចត្ដាឡី ស័ក រយៈពេល ២១ ថ្ងៃ
( កោះកុង ) ៖ លោក សុវណ្ណ ប៊ុន ធឿន ប្រធាន ទីស្នាក់ការច្រកទ្វារ អន្តរជាតិ ចាំ យាម ស្រុក មណ្ឌល សីមា ខេត្ត កោះកុង បាន ឃាត់ខ្លួន ពលករ ខ្មែរ ឆ្លង ដែន តាម ព្រៃ ភ្នំ ពីក្រោយ ទីស្នាក់ការត្រួតពិនិត្យ ច្រកទ្វារ អន្តរជាតិ បាន ចំនួន ៧នាក់ និង ឆ្លង ដែន តាម មាត់ ច្រកទ្វារ អន្តរជាតិ ចំនួន ២នាក់ នៅ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ នេះ ។
រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច បិត ព្រំដែន កម្ពុជា - ថៃ ចំនួន ១៤ ថ្ងៃ និង បន្ត បិត បន្ថែម រយៈពេល ៧ បន្ថែម ទៀត រហូតដល់ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ ប្រសិនបើ ជំងឺ កូវីដ១៩ មាន អាត្រា ថយចុះ និង គ្មាន កូវីដ១៩ ។
លោក សុវណ្ណ ប៊ុន ធឿន បាន បន្ត ថា នៅក្នុង ខែសីហា នេះ សមត្ថកិច្ច ប្រចាំ ការច្រទ្វារ អន្តរជាតិ ចាំ យាម បាន ឃាត់ខ្លួន ពលករ ដែល លួច ឆ្លង ដែន កាត់ ព្រៃ ភ្នំ ក្រោយ ទីស្នាក់ការត្រួតពិនិត្យ ច្រកទ្វារ អន្តរជាតិ បាន ចំនួន ៧នាក់ និង តាម ច្រក ទ្វារ អន្តរជាតិ ចាំ យាម បាន ចំនួន ២នាក់ ។
ចំពោះ ពលករ ទាំង ៩នាក់ ក្រោយពី សមត្ថកិច្ច ឃាត់ខ្លួន បាន ហើយ បាន នាំ គាត់ មក ធ្វើតេស្ត រហ័ស នៅ មណ្ឌល សុខា ភាព ប្រចាំ មាត់ ច្រក ហើយ ធ្វើតេស្ត រក មេរោគ កូវីដ១៩ ហើយ ប្រគល់ ខ្លួន គាត់ ទៅ ឱ្យ អធិការ និង មន្ត្រី សុខាភិបាល ដើម្បី ធ្វើច ក្តាឡី ស័ក នៅ មណ្ឌល ព្យាបាល បន្ត ។
លោក បាន បញ្ជាក់ បន្ថែម ថា មន្ត្រី សមត្ថកិច្ច ពាក់ព័ន្ធ ប្រចាំ ការច្រកទ្វារ អន្តរជាតិ ទាំងអស់ រួមទាំង សមត្ថកិច្ច ប្រចាំ ការណ៍ ទាំង សមត្ថកិច្ច ជើងទឹក ទាំង ច្រក ធម្មជាតិ នានា បាន ចូលរួម សហការណ៍ បាន ល្អ ដ៏ ប្រសើរ ក្នុង ការរឹតបន្ដឹង ក្នុង ការលួច ឆ្លង ដែន របស់ ពលករ និង មាន ការទំនាក់ទំនង ល្អ ជាមួយ ភាគី ថៃ បាន យ៉ាង ល្អ ប្រសើរ ។ នេះ កាតព្វកិច្ច របស់ សមត្ថកិច្ចការពារ ខ្សែក្រវ៉ាត់ ព្រំដែន ដើម្បី សុវត្ថិភាព ប្រជាពលរដ្ឋ ក្នុង ហានិភ័យ កូវីដ១៩ ដែល ជា ជំងឺ ឆ្លង សកល ៕
កម្លាំង អាវុធហត្ថ ខេត្ត ព្រះសីហនុ បញ្ជូន ក្រុម ចោរ ឆក់ ចំនួន ៥នាក់ ទៅ តុលាការ ក្រោយ បង្ក្រាប បាន ពេល ឆក់ កាបូប ពី ជនជាតិ ចិន នៅ ក្រុង ព្រះសីហនុ
( ព្រះសីហនុ) ៖ កម្លាំង អាវុធហត្ថ ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បញ្ជូន ក្រុម ចោរ ឆក់ ចំនួន ៥នាក់ ទៅ សាលាដំបូង ខេត្ត ក្រោយ បង្ក្រាប បាន បន្ទាប់ពី ធ្វើ សកម្មភាព ឆក់ កាបូប ដៃ ពី ជនជាតិ ចិន ម្នាក់ កាលពី ថ្ងៃទី ០៧ ខែសីហា ថ្មី ៗ នេះ ហើយ ជនសង្ស័យ ចំនួន ៥នាក់ នេះ គឺ មាន សារធាតុ ញៀន ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ត្រី ហេង ប៊ុន ទី មេបញ្ជាការ អាវុធហត្ថ ខេត្ត បាន បញ្ជាក់ ថា ក្រុម ចោរ ឆក់ កាបូប ដៃ ទាំង ៥នាក់ នេះ ត្រូវបាន ឃាត់ខ្លួន នៅ វេលា ម៉ោង ១៦៖៣០ នាទី ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២១ នៅ ចំណុច ភូមិ៥ សង្កាត់ លេខ ៤ ក្រុង ព្រះសីហនុ ដឹកនាំ ដោយ លោក អនុ សេនីយ៍ ឯក ញា វិសិដ្ឋ ប្រធាន មន្ទីរ ស្តីទី ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស ។
លោក បាន បញ្ជាក់ ថា ជនសង្ស័យ ទាំង ៥នាក់ ខាងលើ នេះ រួម មាន៖
ពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ ទៀត នៅ ខណ្ឌ ពោធិ៍សែនជ័យ ទទួលបាន អំណោយ មនុស្សធម៌ ពី កាកបាទ ក្រហម កម្ពុជា
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ ទៀត នៅក្នុង សង្កាត់ ត្រពាំង ក្រសាំង ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ទទួល អំណោយ មនុស្សធម៍ ពី សាខា កាកបាទ ក្រហម ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី ជួយ សម្រួល ការលំបាក ក្នុង កំឡុង ពេល ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដែល កំពុង រីករាលដាល ក្នុង ប្រទេស កម្ពុជា ។
ពិធី ចែក អំណោយ នេះ ធ្វើឡើង ក្រោម វត្តមាន លោក ហែម ដារិទ្ធិ ប្រធាន កិត្តិយស អនុសាខា កាកបាទ ក្រហម ខណ្ឌ ពោធិ៍សែនជ័យ . លោកស្រី អ៊ឹម ថា វី ប្រធាន អនុ សាខា កាកបាទ ក្រហម ខណ្ឌ ពោធិ៍សែនជ័យ លោក លោកស្រី ជា អភិបាល រង ខណ្ឌ ចៅសង្កាត់ រួម និង ក្រុមការងារ អនុសាខា ជាច្រើន នាក់ នៅ បរិវេន្ត វត្ត អរុណវតី ស្ថិត ក្នុង ភូមិ ត្រពាំង អណ្តូង សង្កាត់ ត្រពាំង ក្រសាំង ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
លោក ហែម ដារិទ្ធិ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើរ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ជូន ដល់ គ្រួសារ ទាំងអស់ ប្រកបដោយ សេចក្តីនឹករលឹក ។ ទីណា មាន ការលំបាក ទីនោះ មាន កាកបាទ ក្រហម កម្ពុជា ជាក់ស្តែង ដូចជា ពេលនេះ គឺ ការជួយ របស់ កាកបាទ ក្រហម កម្ពុជា ដោយ មិន ប្រកាន់ ពី និន្នាការ នយោបាយ ជាតិ សាសន៍ សាសនា វណ្ណៈ ពណ៌ សម្បុរ អ្វី ឡើយ ។
លោក ក៏ សូម អំពាវនាវ ដល់ គ្រួសារ ទាំងអស់ បន្ត ការប្រុងប្រយត្ន័ បន្ថែម ទៀត និង ជាពិសេស សូម បន្ត អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ វិធានការ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី គឺ ៣ការពារ និង ៣កុំ ដើម្បី ចូលរួម ទប់ស្កាត់ និង ការពារ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ទាំងអស់ គ្នា ។
សូម បញ្ជាក់ ថា នៅ ដើម ខែសីហា នេះ សង្កាត់ ចំនួន ៦ហើយ បាន ផ្តល់ អំណោយ មនុស្សធម៌ ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា និង ជន ពិការ ៤៧ គ្រួសារ នេះ ។ អំណោយ ផ្តល់ ជូន ក្នុង ១គ្រួសារ ៗ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម មី មួយ កេស ទឹក ស៊ីអ៊ីវ១យួរ ត្រីខ១យួរ ម៉ាស់ ១ ប្រអប់ រួម និង ថវិការ ៣០ ០០០ រៀល ផងដែរ ៕
( ភ្នំពេញ ) ៖ អាជ្ញាធរ ខណ្ឌ ដូនពេញ នៅ រសៀល ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បើក ប្រតិបត្តិការ ចុះបង្ក្រាប ទីតាំង ល្បែង ទ្រង់ទ្រាយ ធំ មួយ កន្លែង ស្ថិត នៅ សង្កាត់ វត្តភ្នំ ដោយ ឃាត់ខ្លួន មនុស្ស ចំនួន ៣២ នាក់ និង ដកហូត ម៉ូតូ ចំនួន ១៤ គ្រឿង ព្រមទាំង វត្ថុតាង មួយចំនួន ទៀត ។
ប្រតិបត្តិការ បង្ក្រាប ល្បែងស៊ីសង ទ្រង់ទ្រាយ ធំ ខាងលើ នេះ បាន ធ្វើឡើង ក្រោម បទបញ្ជា និង ដឹកនាំ ផ្ទាល់ ពី លោក សុខ ពេញវុធ អភិបាល ខណ្ឌ ដូនពេញ . លោក ទៀង ចាន់ សារ អធិការ នគរបាល ខណ្ឌ និង នាយក រដ្ឋបាល ខណ្ឌ លោក ចាប ឌីណា ព្រមទាំង កងកម្លាំង សមត្ថកិច្ច និង ប្រជាការពារ ជាច្រើន នាក់ ផ្សេង ទៀត ។
លោក សុខ ពេញវុធ បាន បញ្ជាក់ ថា ក្រោយ ទទួលបាន ព័ត៌មាន សំងាត់ ស្តីពី ល្បែងស៊ីសងខាងលើ នេះ លោក បាន សុំ គោលការណ៍ ពី អភិបាល រាជធានី ភ្នំពេញ រួច ដឹកនាំ កម្លាំង ចុះ មក បង្ក្រាប តែម្តង ដោយ ឃាត់ខ្លួន មនុស្ស ជាក់ស្តែង ចំនួន ៣២ នាក់ ដកហូត ម៉ូតូ ជាង១០ គ្រឿង និង វត្ថុតាង មួយចំនួន ទៀត ។
លោក អភិបាល ខណ្ឌ បាន បន្ត ថា សម្រាប់ មនុស្ស ទាំងនេះ និង វត្ថុតាង ត្រូវបាន បញ្ជូន ទៅកាន់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដូនពេញ ដើម្បី ធ្វើ ការសួរនាំ និង ញែក ឲ្យ ឃើញ ថា តើ នរណា ខ្លះ ជា ម្ចាស់ ទីតាំង និង អ្នកលេង រួច បន្ត ចាត់ការ តាម ច្បាប់ មិន លើកលែង ឲ្យ ឡើយ ។
លោក ថា ការលួច បើកបន ល្បែង ខុស ច្បាប់ ទាំងនេះ គឺ បាន បំពាន វិធានការ សុខាភិបាល ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដែល រាជ រដ្ឋាភិបាល និង អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ កំពុងតែ ប្រឹងប្រែង និង មួយ ទៀត បាន ធ្វើឲ្យ ប៉ះពាល់ ដល់ ក្រុម យុវជន ជំនាន់ ក្រោយ ដែល ជា ទំពាំង ស្នង ឬស្សី ។ សម្រាប់ មនុស្ស ទាំងនេះ នឹង ត្រូវ ធ្វើតេស្ត រក កូវីដ ហើយ បើក រកឃើញ វិជ្ជមាន ត្រូវ បញ្ជូន ទៅ មណ្ឌល ចត្តាឡី ស័ក រួច ពេល ចប់ នឹង ចាត់ការ បន្ត តាម ផ្លូវ ច្បាប់ ។
រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ចាប់ផ្តើម បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ដូស ទី៣ ជូន មន្ត្រីរាជការ ស៊ីវិល កម្លាំង នគរបាល និង មន្ត្រី មូលដ្ឋាន ទូទាំង ខេត្ត រយៈពេល ១៤ ថ្ងៃ
រដ្ឋបាល ខេត្ដ បាន បន្ថែម ទៀត ថា សម្រាប់ កម្មវិធី ចាក់ វ៉ាក់សាំង នេះ និង មាន ជូន ភ្ជាប់ នូវ តារាង បង្ហាញ ទីតាំង ចាក់ និង ថ្ងៃ ខែ ឆ្នាំ ត្រូវ ចាក់ តាម សា្ថប័ន និង អង្គភាព នីមួយ ៗ តាម ការរៀបចំ របស់ អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្នុង ក្របខ័ណ្ឌ ទូទាំង ខេត្ត ត្បូងឃ្មុំ ក្នុង នោះ សូម មេត្តា ចូលរួម អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ « ៣កុំ និង ៣ការពារ » ។
ដោយឡែក ចំពោះ ប្រជាពលរដ្ឋ ដែល មិន ទាន់ មាន ឈោ្មះ ចាក់ វាក់ សាំង កូវីដ១៩ ដូស ជំរុញ ឬ ដូស ទី៣នេះ អនុគណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ខេត្ត កំពុង រៀបចំ កម្មវិធី ចាក់ ជា បន្តបន្ទាប់ តាម ផែនការ ដែល បាន គ្រោង ទុក ។
រដ្ឋបាល ខេត្ត ក៏ បាន រំឮក ដល់ មន្ត្រីរាជការ ស៊ីវិល មន្ត្រី នគរបាល ជាតិ និង មន្ត្រី មូលដ្ឋាន ទូទាំង ខេត្ត ដែល ទៅ ទទួល ចាក់ វ៉ាក់សាំង នៅ តាម ទីតាំង ដែល បាន កំណត់ និង សូម ភ្ជាប់ មក ជាមួយ នូវ ប័ណ្ណ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ដូសទី១ និង ទី២ ឬ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ មក ជាមួយ ផងដែរ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ដ ត្បូង ឃ្មុំ៖
ជន ពិការ ក្រីក្រ ១គ្រួសារ នៅ ខេត្ត ក្រចេះ ទទួលបាន ផ្ទះ ថ្មី ១ ខ្នង ពី មូលនិធិ ជន ពិការ
( ក្រចេះ ) ៖ លោក ស៊ឹម សុធន នាយក មូលនិធិ ជន ពិការ អម ដំណើរ ដោយ ថ្នាក់ដឹកនាំ មូលនិធិ ជន ពិការ តំណាង មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ខេត្ត និង អាជ្ញាធរ នៅ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ បាន ចុះ ផ្តល់ ផ្ទះ ថ្មី ចំនួន មួយ ខ្នង ធ្វើ ពី ថ្ម ប្រក សង្ហ័ សី ទំហំ ៤គុណ នឹង ៦ម៉ែត្រ ដែល បាន សាងសង់ រួចរាល់ ជា ស្ថាពរ ជូន ដល់ ជន ពិការ ឈ្មោះ ស៊ាម វ៉ាន់ រស់ នៅ ភូមិ រការ កណ្តាល ទី១ សង្កាត់ រការ កណ្តាល ក្រុង ក្រចេះ ខេត្ត ក្រចេះ ។
លោក នាយក ក៏ បាន ផ្តល់ បញ្ចប់ អំណោយ សប្បុរសធម៌ របស់ មូលនិធិ ជន ពិការ និង មន្ទីរ សង្គមកិច្ច ខេត្ត ដល់ គ្រួសារ ម្ចាស់ ផ្ទះ ដើម្បី ប្រើប្រាស់ ប្រចាំ ថ្ងៃ និង បាន ផ្តាំផ្ញើ ឱ្យ ពួកគាត់ ត្រូវ ថែរក្សា សុខភាព និង ចូលរួម អនុវត្ត ទាំងអស់ គ្នា នូវ វិធាន ៣ការពារ ៣កុំ ៕
តំបន់ ប្រតិបត្តិការ សឹក រង តាកែវ បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ដូស ទី៣ ជូន នាយ ទាហាន នាយ រង ពល ទាហាន និង គ្រួសារ
លោក ឧត្តមសេនីយ៍ នាង សុភារ៉ា បាន អំពាវនាវ ឱ្យ កងទ័ព និង ក្រុមគ្រួសា ទាំងអស់ ត្រូវ បន្ត យកចិត្តទុកដាក់ ការពារ ខ្លួន កុំ ឱ្យ ឆ្លង ជំងឺ កូវីដ១៩ ដោយ ត្រូវ បន្ត អនុវត្តន៍ ទៅ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ការណែនាំ របស់ ប្រមុខ រាជ រាជ រដ្ឋាភិបាល « ៣កុំ និង ៣ការពារ » ដើម្បី ការពារ ខ្លួន យើង ក្រុមគ្រួសារ សហគមន៍ និង អង្គភាព ពី ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ បើ ទោះបីជា បាន ចាក់ ថ្នាំ បង្កា ដូស ទី៣ ហើយក៏ ដោយ ។
បើ តាម លោក មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត តាកែវ សម្រាប់ កងទ័ព និង ក្រុម គ្រូសារ ក្នុង ខេត្ត តាកែវ មាន ចំនួន ជាង ១០២៧ នាក់ ដែល នឹង ត្រូវ ទទួល ការចាក់ វ៉ាក់សាំង ដូស ទី៣ នៅ ថ្ងៃ នេះ ហើយ ដំណើរការចាក់ វ៉ាក់សាំង គឺ ធ្វើ តែ មួយ ថ្ងៃ នេះ ទេ ដោយ ប្រើប្រាស់ ក្រុម គ្រូពេទ្យ ចំនួន ១៥ នាក់ ។ ដោយឡែក សម្រាប់ អតីត យុទ្ធជន ទូទាំង ខេត្ត តាកែវ នឹង ត្រូវ ចាប់ផ្ដើម ចាក់ ដូស ទី៣ នៅ ថ្ងៃស្អែក នេះ ៕
មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ចាប់ផ្តើម ចាក់ វ៉ាក់សាំង ដូស ទី៣ ជូន ក្រុម គ្រូពេទ្យ ជួរ មុខ នៅ ថ្ងៃស្អែក
អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ នេះ ប្រធាន មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ បន្ត ថា៖ « សូម ជម្រាប ជូនដំណឹង ដល់ ថ្នាក់ដឹកនាំ បុគ្គលិក មន្ត្រីរាជការ កម្មករ ក្របខណ្ឌ រដ្ឋ និង ជាប់ កិច្ចសន្យា សរុប ចំនួន ៣២៣ រូប ដែល ស្ថិត នៅ តាម ផ្នែក នីមួយ ៗ ក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ត្រូវ មក ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូស ជំរុញ ឬ ដូស ទី៣ កុំបី អាក់ខាន » ។
ប្រធាន មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ក៏ បាន ក្រ់ន រំឮក ដល់ ថ្នាក់ដឹកនាំ បុគ្គលិក មន្ត្រីរាជការ កម្មករ ទាំងអស់ រូតរះ មក ទទួល ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូស ជំរុញ ឬ ដូស ទី៣ តាម កាល កំណត់ ។
