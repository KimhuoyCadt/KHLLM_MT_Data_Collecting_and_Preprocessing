( ភ្នំពេញ ) ៖ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច នា រសៀល ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ទទួល អំណោយ សប្បុរ ធម៌ ពី លោកស្រី ចាន់ កន្និកា អគ្គ នាយិកា ក្រុមហ៊ុន ស៊ី ខេ ខេ អ៉ិន វេស ម៉ិន ឯ . ក ដើម្បី ទ្រទ្រង់ ដល់ ការងារ សប្បុរសធម៌ នៅ មូលដ្ឋាន ខេត្ត ស្វាយរៀង ។
លោកស្រី ម៉ែន សំអន ក៏ បាន ថ្លែងអំណរគុណ ដល់ លោកស្រី ចាន់ កន្និកា ដែល បាន បរិច្ចាគ នូវ ធនធាន ដ៏ ច្រើន នា ពេលនេះ ដើម្បី ចូលរួមចំណែក ក្នុង សម្រាល បន្ទុក រាជ រដ្ឋាភិបាល ក្នុង បរិការណ៍ កូវីដ១៩ ។
អំណោយ សប្បុរសធម៌ រួម មាន អង្ករ ១០តោន ម៉ាស់ ១០កេស ធំ និង ទឹក ថ្នាំ សម្លាប់ មេរោគ ចំនួន ២០០លីត្រ៕
គួរ បញ្ជាក់ ថា បច្ចុប្បន្ន រដ្ឋាភិបាល ឥណ្ឌូនេស៊ី កំពុង អនុវត្ត វិធានការរឹតត្បិត យ៉ាង តឹង រ៊ឹង ដើម្បី ទប់ស្កាត់ កូវីដ១៩ បំប្លែង ខ្លួន ថ្មី Delta ដែល កំពុង ឆ្លង រីករាលដាល យ៉ាង ឆាប់រហ័ស នៅ តាម តំបន់ មួយចំនួន នៃ ប្រទេស អាស៊ាន មួយ នេះ ៕
ក្រសួង យុត្តិធម៌ អនុវត្ត តាម សារ ចរ របស់ រាជ រដ្ឋាភិបាល ដោយ ធ្វើតេស្ត រហ័ស លើ មន្រ្តី របស់ ខ្លួន ជិត ៥០០ នាក់ រកឃើញ អ្នកវិជ្ជមាន កូវីដ១៩ ចំនួន ៣រូប
សេចក្តីប្រកាស ព័ត៌មាន ដដែល បាន បញ្ជាក់ ថា ដោយ អនុវត្ត តាម សារាចរ របស់ រាជ រដ្ឋាភិបាល ចុះ ថ្ងៃទី ២៨ ខែកក្កដា ឆ្នាំ ២០២១ ស្តីពី ការដាក់ចេញ យុទ្ធនាការ ពង្រឹង វិធានការប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ . នា ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២១ ក្រសួង យុត្តិធម៌ បាន រៀបចំ នូវ ការធ្វើតេស្តរហ័ស រក មេរោគ កូវីដ - ១៩ ជូន ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ ក្រសួង យុត្តិធម៌ នៅ ទីស្តីការ ក្រសួង យុត្តិធម៌ និង នៅ តាម អង្គភាព ទាំងអស់ ចំណុះ ក្រសួង ។
ការធ្វើតេស្តរហ័ស រក មេរោគ កូវីដ - ១៩ នា ពេលនេះ បាន ជួយ ឱ្យ មន្ត្រី ទាំង ៣រូប បាន ដឹង ថា ខ្លួន មាន វិជ្ជមាន កូវីដ - ១៩ ម៉្យាង ដើម្បី ទទួលបាន ការព្យាបាល និង ម៉្យាងទៀត ដើម្បី ជួយ ដល់ ការទប់ស្កាត់ ការឆ្លង រាលដាល នៅ ទីកន្លែង ធ្វើការងារ និង ក្រុមគ្រួសារ របស់ ខ្លួន ។
( ភ្នំពេញ ) ៖ បម្រាម គោចរ ពេលយប់ ដែល អនុវត្ត រយៈពេល ២សប្តាហ៍ កន្លងមក នេះ ត្រូវបាន រដ្ឋបាល រាជធានី ភ្នំពេញ សម្រេច បន្ត ឱ្យ អនុវត្ត រយៈពេល ១ សប្តាហ៍ បន្ថែម ទៀត ចាប់ពី ថ្ងៃទី ១៣ ដល់ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ ដើម្បី ទប់ស្កាត់ ការរាលដាល ជំងឺ កូវីដ១៩ ជាពិសេស មេរោគ បំប្លែង ថ្មី Delta ។
ករណី ចាំបាច់ ដែល ត្រូវបាន លើកលែង ទាំងនោះ មាន ដូច ជា៖
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ក្នុង អំឡុង ពេល នៃ ការដាក់ចេញ វិធានការ រដ្ឋបាល ត្រូវបាន ផ្អាក ជា បណ្តោះអាសន្ន ចំពោះ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ សម្រាប់ រយៈពេល ១៤ ( ដប់ បួន ) ថ្ងៃ គិត ចាប់ពី ម៉ោង សូន្យ នា ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ២៦ ខែសីហា ឆ្នាំ ២០២១ » ។
សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ដែល ត្រូវបាន ផ្អាក បណ្តោះអាសន្ន ១៤ ថ្ងៃ ទៀត នោះ រួម មាន៖
* សាលារៀន រួមទាំង សាលា បណ្តុះបណ្តាល វិជ្ជាជីវៈ ទាំង រដ្ឋ និង ឯកជន ប៉ុន្តែ អាច ធ្វើ ការបណ្តុះបណ្តាល តាម ប្រព័ន្ធ អនឡាញ * អាជីវកម្ម ក្លឹប កម្សាន្ត គ្រប់ ប្រភេទ ជា អាទិ៍ ខារ៉ាអូខេ រង្គ សាល ឌីស្កូ តែ ក បៀហ្គាឌិន និង កាស៉ីណូ * រមណីយដ្ឋាន សារមន្ទីរ សួន កុមារ និង សួន កម្សាន្ត នានា * អាជីវកម្ម ម៉ាស្សា សូណា និង ស្ចឹម គ្រប់ ប្រភេទ * ហាង លក់ និង សេព គ្រឿងស្រវឹង គ្រប់ ប្រភេទ * រោង ភាពយន្ត រោង សម្តែង សិល្បៈ ក្លឹប ហាត់ប្រាណ និង មជ្ឈមណ្ឌល កីឡា គ្រប់ ប្រភេទ ។
សូម ជម្រាប ថា អាជ្ញាធរ រាជធានី ភ្នំពេញ បាន បន្ត ដាក់ចេញ នូវ វិធានការ រដ្ឋបាល ដោយ ផ្អាក ជា បណ្តោះអាសន្ន ចំពោះ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ការជួបជុំ ឬ ការប្រមូលផ្តុំ មនុស្ស ជា លក្ខណៈ ឯកជន និង បម្រាម គោចរ រាល់ ការធ្វើចរាចរណ៍ និង រាល់ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម នៅ ចន្លោះ ម៉ោង ២២ ( ម្ភៃ ពីរ ) ដល់ ម៉ោង ៣ ( បី ) នៅក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ដើម្បី ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ ៕
សម្ភារ ការពារ ជំងឺ កូវីដ១៩ អំណោយ របស់ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ត្រូវបាន ប្រគល់ ជូន តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ សម្ភារ ជាច្រើន មុខ សម្រាប់ ការពារ ជំងឺ កូវីដ១៩ ដែល ជា អំណោយ របស់ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ ត្រូវបាន នាំយក ទៅ ប្រគល់ ជូន ដល់ អង្គភាព តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត សម្រាប់ ប្រើប្រាស់ ។
ពិធី ប្រគល់ ទទួល សម្ភារ ទាំង នេះ ស្ថិត ក្រោម វត្តមាន លោក ឈឿន មុនី អនុប្រធាន ប្រចាំ ការ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ តំណាង លោក ទេសរដ្ឋមន្ត្រី មាស សុភា និង លោក ឧត្តមសេនីយ៍ ទោ ច័ន្ទ សុភ័ក្ត្រា មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះវិហារ និង នាយ ទាហាន ជាច្រើន រូប ទៀត នៅ រសៀល ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២១ នេះ ។
នៅក្នុង ឱកាស នោះ លោក ឈឿន មុនី បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី លោក ទេសរដ្ឋមន្ត្រី មាស សុភា ជូន ដល់ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្នុង អង្គភាព តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត ទាំងអស់ ជាពិសេស បាន ផ្តាំផ្ញើ អោយ រក្សា សុខភាព អនាម័យ ក្នុង ការរស់នៅ ដើម្បី ការពារ បាន ពី ជំងឺ ទាំងឡាយ ពិសេស ជំងឺ កូវីដ១៩ ។
តំណាង លោក ទេសរដ្ឋមន្ត្រី មាស សុភា បាន ថ្លែង បន្ត ថា សម្ភារ ដែល នាំមក ប្រគល់ ជូន នៅ ពេល នេះ រួម មាន៖ ថ្នាំ កូវីដ៥ ប្រអប់ ឧបករណ៍ តេស្ត រហ័ស ចំនួន ១០០ ឈុត ម៉ាស់ ក្រណាត់ ល្អ ចំនួន ៥០០ សន្លឹក និង អាល់កុល ចំនួន ២០លីត្រ ផងដែរ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន ផ្តាំផ្ញើ ដល់ នាយ នាយ រង និង ពល ទាហាន ទាំងអស់ ត្រូវ ការពារ ខ្លួន កុំ ឲ្យ ឆ្លង ជំងឺ កូវីដ១៩ ដោយ ត្រូវ អនុវត្តន៍ ឲ្យបាន ទៀងទាត់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង ការណែនាំ របស់ រាជ រដ្ឋាភិបាល « ៣កុំ និង ៣ការពារ » ដើម្បី ការពារ ខ្លួន យើង ក្រុមគ្រួសារ និង អង្គភាព យើង ពី ជំងឺ កូវីដ១៩ ៕
វិធានការ ដែល បាន ដាក់ចេញ បន្ត នេះ រួម មាន វិធានការផ្អាក ជា បណ្តោះអាសន្ន ចំពោះ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ចំងឺ កូវីដ១៩ ការជួបជុំ ឬ ការប្រមូលផ្តុំ មនុស្ស ជា លក្ខណៈ ឯកជន និង បម្រាម គោចរ នៅក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ជាដើម ។
យោង តាម ប្រការ១ នៃ សេចក្តីសម្រេច នេះ បាន បញ្ជាក់ ថា ការផ្អាក ជា បណ្តោះអាសន្ន ចំពោះ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ការជួបជុំ ឬ ការប្រមូលផ្តុំ មនុស្ស ជា លក្ខណៈ ឯកជន និង បម្រាម គោចរ រាល់ ការធ្វើចរាចរណ៍ និង រាល់ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ត្រូវ អនុវត្ត ចាប់ពី ម៉ោង ២២ ( ម្ភៃ ពីរ ) ដល់ ម៉ោង ៣ ( បី ) នៅក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ដើម្បី ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩
ដោយឡែក ប្រការ៣ បាន ចែង ថា ក្នុង អំឡុង ពេល នៃ ការដាក់ចេញ វិធានការ រដ្ឋបាល ត្រូវ ផ្អាក ជា បណ្តោះអាសន្ន ការជួបជុំ ឬ ការប្រមូល មនុស្ស ជា លក្ខណៈ ឯកជន ដែល មាន មនុស្ស ចូលរួម លើស ពី ១៥ ( ដប់ ប្រាំ ) នាក់ សម្រាប់ រយៈពេល ១៤ ថ្ងៃ គិត ចាប់ពី ម៉ោង សូន្យ នា ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ២៦ ខែសីហា ឆ្នាំ ២០២១ លើកលែងតែ ក្នុង ករណី សកម្មភាព ចាំបាច់ មួយ ចំនួន ។
ទន្ទឹមនឹង នេះ ក្នុង ប្រការ៤ បាន បញ្ជាក់ ថា ក្នុង អំឡុង ពេល នៃ ការដាក់ចេញ នូវ វិធានការ នេះ ត្រូវបាន អនុវត្ត បម្រាម គោចរ ដោយ ផ្អាក ជា បណ្តោះអាសន្ន នូវ រាល់ ការធ្វើចរាចរណ៍ និង រាល់ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម នានា នៅ ម៉ោង ២២ ( ម្ភៃ ពីរ ) ដល់ ម៉ោង ៣ ( បី ) សម្រាប់ រយៈពេល ៧ ថ្ងៃ វិញ គិត ចាប់ពី ម៉ោង សូន្យ នា ថ្ងៃទី ១៣ ខែសីហា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ លើកលែងតែ ក្នុង ករណី ចាំបាច់ មួយ ចំនួន ៕
ខេត្ត បាត់ដំបង បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ចំនួន ៧៦ នាក់ ជាសះស្បើយ ៨០ នាក់ និង ស្លាប់ ១ នាក់
ជាមួយគ្នា នេះ រដ្ឋបាល ខេត្ត បាត់ដំបង បាន អំពាវនាវ ដល់ អ្នក ប៉ះពាល់ ផ្ទាល់ សូម រួសរាន់ ទៅ ជួប ក្រុម គ្រូពេទ្យ និង ធ្វើចត្តាឡី ស័ក ដើម្បី យក សំណាក ទៅ ពិនិត្យ ហើយ ចំពោះ អ្នក ប៉ះពាល់ ប្រយោល ត្រូវ ធ្វើចត្តាឡី ស័ក តាម ផ្ទះ រៀង ៗ ខ្លួន ដោយ មិន ត្រូវ ពាក់ព័ន្ធ ឬ ប៉ះពាល់ ជាមួយ អ្នកដទៃ ដាច់ខាត ។
សូម ជម្រាប ថា ចាប់តាំងពី ផ្ទុះ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ខេត្ត បាត់ដំបង បាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៤. ៤០៥ នាក់ ព្យាបាល ជាសះស្បើយ ចំនួន ២.៨៦២ នាក់ ស្លាប់ ចំនួន ៥២ នាក់ និង កំពុង សម្រាក ព្យាបាល ចំនួន ១.៤៩១ នាក់ ទៀត ៕
អាជ្ញាធរ ជាតិ អប្សរា ច្រានចោល រឿង ប្រជាពលរដ្ឋ រិះគន់ ចំ ៗ ដែល ថា អាជ្ញាធរ អប្សរា កំពុង កៀប សង្កត់ ប្រជាពលរដ្ឋ
( សៀមរាប ) ៖ អាជ្ញាធរ ជាតិ អប្សរា នា ថ្ងៃ ទៅ ១១ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីបំភ្លឺ លើ ការចេញផ្សាយ របស់ ព័ត៌មាន មួយ ដែល បំភ្លៃ រឿង ប្រជាពលរដ្ឋ រង ការកៀប សង្កត់ ពីសំណាក់ អាជ្ញាធរ ជាតិ អប្សរា កើតឡើង នៅ ភូមិ តា ប៉ាង ភូមិ គិរី មានន្ទ និង ភូមិ បង្កោង ឃុំ អំពិល ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប ។
ខាងក្រោម នេះ ជា សេចក្ដីបំភ្លឺ របស់ អាជ្ញាធរ ជា តិ៖
ចូរ ប្រាប់ មនុស្ស ជា ទី ស្រលាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែសីហា ៖ បង្ក្រាប ១២ករណី ឃាត់ខ្លួន ២៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៣ករណី និង ជួញដូរ ៩ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២៥ នាក់ ។
