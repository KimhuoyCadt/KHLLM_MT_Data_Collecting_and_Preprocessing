( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន សម្រេច បិទ បញ្ចប់ យុទ្ធនាការ ពង្រឹង វិធានការប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ នៅ ទូទាំង ប្រទេស ក្រោយ អនុវត្ត បាន ២១ ថ្ងៃ ប៉ុន្តែ អនុញ្ញាតឱ្យ រដ្ឋបាល រាជធានី - ខេត្ត ទាំងអស់ ដាក់ វិធានការ រដ្ឋបាល វិធានការ សុខាភិបាល និង វិធានការ ច្បាប់ តាម ស្ថានភាព ជាក់ស្តែង ។ នេះ បើ តាម សេចក្តីណែនាំ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
( ភ្នំពេញ ) ៖ ការបង្កើត រដ្ឋាភិបាល នៅ ក្រៅ ប្រទេស របស់ អតីត ក្រុម ប្រឆាំង មិន ទទួលបាន ការគាំទ្រ ឡើយ សម្រាប់ នយោបាយ កម្ពុជា ដោយសារ ហេតុផល ៣យ៉ាង សំខាន់ ៗ ។ នេះ បើ តាម លោក បណ្ឌិត សភាចារ្យ សុខ ទូច ប្រធាន រាជ បណ្ឌិត្យ សភា កម្ពុជា ដែល បាន លើកឡើង នៅក្នុង កិច្ចពិភាក្សា តុ មូល « កម្ពុជា នៅ ចន្លោះ មហា អំណា ចិន និង សហរដ្ឋ អាម៉េរិក » ដែល រៀបចំឡើង ដោយ រាជ បណ្ឌិត្យ សភា កម្ពុជា នៅ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ ។
ក្នុង នាម ជា បញ្ញវន្ត មួយ រូប លោក សុខ ទូច បាន ក្រើន រំឮក ដល់ ប្រជាជន កម្ពុជា ទាំង ក្នុង និង ក្រៅ ស្រុក ព្រមទាំង អ្នកនយោបាយ ទាំងអស់ សូម មើល ប្រវត្តិសាស្ត្រ របស់ កម្ពុជា បាន ឱ្យ បាន ច្បាស់លាស់ ដើម្បី កុំ ឱ្យ កម្ពុជា ធ្លាក់ ចូល ក្នុង គ្រោះមហន្តរាយ ដូច អតីតកាល ៕ លោក ពុយ គា៖ សារព័ត៌មាន ចិន នៅ កម្ពុជា មាន ច្រើន ជាង សារព័ត៌មាន អាមេរិក តែ ចិន មិន បាន ផ្សាយ តែ ពី ភាពអវិជ្ជមាន កម្ពុជា ដូច អាមេរិក ទេ (Video inside)
( ភ្នំពេញ ) ៖ អ្នកកាសែត ជើង ចាស់ ដ៏ ល្បី ឈ្មោះ នៅ កម្ពុជា លោក ពុយ គា ដែល អ្នកយកព័ត៌មាន របស់ ទីភ្នាក់ងារ ព័ត៌មាន ក្យូ ដូជ ប៉ុន ប្រចាំ នៅ កម្ពុជា បាន បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ សារព័ត៌មាន ចិន នៅ កម្ពុជា មាន ច្រើន ជាង សារព័ត៌មាន របស់ សហរដ្ឋ អាមេរិក ទៅ ទៀត ប៉ុន្តែ ចិន មិន ដូច ព័ត៌មាន លោក ខាងលិច ដែល ផ្សាយ តែ ពី ភាពអវិជ្ជមាន រឿង អាស្រូវ របស់ កម្ពុជា ទេ ។
លោក ពុយ គា បាន លើកឡើង ដូចនេះ នា ព្រឹក ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ នៅក្នុង កិច្ចពិភាក្សា តុ មូល ស្តីពី « កម្ពុជា នៅ ចន្លោះ មហា អំណាច ចិន និង សហរដ្ឋ អាមេរិក » ដែល វេទិកា នេះ បាន រៀន ចំឡើង ដោយ រាជ បណ្ឌិត្យ សភា កម្ពុជា ។
លោក ពុយ គា បាន បន្ថែម ថា អាមេរិក ចាប់តាំងពី ឆ្នាំ ២០១៧ មកដល់ ឆ្នាំ ២០២១ បាន ព្យាយាម ដាក់ ជា ទណ្ឌកម្ម មក លើ កម្ពុជា រហូតដល់ ៨ ចំណុច មាន ដូចជា ប្រព័ន្ធ អនុគ្រោះ ពន្ធ បញ្ហា រឿង ប្រជាធិបតេយ្យ ដែល សំដៅ លើ រឿង គណបក្ស នយោបាយ ដាក់ទណ្ឌកម្ម លើ មេដឹកនាំ កម្ពុជា និង ឥស្សរជន មួយចំនួន ទៀត ដែល មាន សរុប ចំនួន ៨ទៅ ហើយ ។
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា នៅ រសៀល ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ចាត់ សហការី ដែល ដឹកនាំ ដោយ លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា នាំយក ផ្លែ មៀន បាត់ដំបង ( តាង៉ែន ) ចំនួន ២១តោន ដែល ទិញ ពី ប្រជាកសិករ នៅ ខេត្ត បាត់ដំបង យក ទៅ ចែកជូន ក្រុម គ្រូពេទ្យ និង អ្នកជំងឺ ដែល កំពុង សម្រាក ព្យាបាល តាម មន្ទីរពេទ្យ និង កន្លែង ព្យាបាល ចំនួន ៤កន្លែង ។
ក្នុង នោះ ផ្លែ មៀន បាត់ដំបង ចំនួន ៥តោន បាន ប្រគល់ ជូន ក្រុម គ្រូពេទ្យ បុគ្គលិក និង អ្នកជំងឺ នៃ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត នៅ រសៀល ថ្ងៃទី ១៩ ខែសីហា នេះ រួចរាល់ និង ផ្លែ មៀន ចំនួន ១៦តោន ទៀត នឹង ដឹក មក ភ្នំពេញ ជា បន្តបន្ទាប់ ដើម្បី ចែកជូន ក្រុម គ្រូពេទ្យ និង អ្នកជំងឺ ចំនួន ៣ មណ្ឌល ថែម ទៀត រួម មាន៖
រដ្ឋបាល ខេត្ត ព្រះវិហារ នឹង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន កុមារ និង យុវវ័យ អាយុ ១២ ឆ្នាំ ដល់ ក្រោម ១៨ ឆ្នាំ នៅ ថ្ងៃទី ២០ ខែសីហា
អាស្រ័យ ហេតុ នេះ សូម បងប្អូន ដែល ជា មាតា បិតា ឬ អាណាព្យាបាល ដែល រស់ នៅ តាម បណ្តា ក្រុង ស្រុក ទាំង ០៨ ដែល មាន កូន អាយុ ចាប់ពី ១២ ឆ្នាំ ដល់ ក្រោម ១៨ ឆ្នាំ សូម នាំយក កូន ទៅ ទទួល ការចាក់ វ៉ាក់សាំង តាម ការស្ម័គ្រចិត្ត និង ដោយ ឥត គិត ថ្លៃ នៅ តាម ទីតាំង ចាក់ វ៉ាក់សាំង ដែល រដ្ឋបាល ក្រុង ស្រុក ចំនួន ០៧ បាន រៀបចំ ចាប់ពី ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០២១ នេះ តទៅ ។
ដោយ រដ្ឋបាល ស្រុក រវៀង រៀបចំ ចាប់ពី ថ្ងៃទី ២៥ ខែសីហា ឆ្នាំ ២០២១ ដែល មាន រយៈពេល ១៤ ថ្ងៃ ក្នុង ការចាក់ដូស លើក ទី១ ដោយ ដំណើរការ ចាប់ពី ម៉ោ ង៖
ជាមួយគ្នា នេះ សូម បងប្អូន ដែល ជា មាតា បិតា ឬ អាណាព្យាបាល របស់ កុមារ អាយុ ១២ ឆ្នាំ ដល់ ក្រោម ១៨ ឆ្នាំ នាំយក កូន មក ចូលរួម ចាក់ វ៉ាក សាំង តាម ទីតាំង នីមួយ ៗ ជៀសវាង ការមក ប្រមូលផ្តុំ គ្នា ដែល បង្ក ហានិភ័យ ខ្ពស់ ក្នុង ការ ចម្លង ជំងឺ កូវីដ១៩ និង សូម អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ អនាម័យ រក្សា គម្លាត និង ពាក់ ម៉ាស់ ឱ្យ បាន គ្រប់ ៗ គ្នា ពេល មក ទទួល ការចាក់ វ៉ាក់សាំង ។
បញ្ជា ក់៖ សូម ភ្ជាប់ មក ជាមួយ នូវ អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ . លិខិត ឆ្លង ដែន . ឆារ សង្ឃ ដីកា . សំបុត្រ កំណើត . សៀវភៅ គ្រួសារ សៀវភៅ ស្នាក់ នៅ ឬ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ សូម ជូន ភ្ជាប់ ជាមួយ នូវ ទីតាំង ចាក់ វ៉ាក់សាំង ៕
សូម អាន សេចក្តីជូនដំណឹង ខាងក្រោម៖ ខេត្ត ត្បូងឃ្មុំ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ១៩ ចំនួន ១៩ នាក់ ជាសះស្បើយ ២៦ នាក់
ជាមួយនឹង ការរក ឃើញ អ្នកជំងឺ កូវីដ១៩ ចំនួន ១៩ នាក់ បន្ថែម ទៀត នេះ រដ្ឋបាល ខេត្ត សូម អំពាវនាវ អ្នក ប៉ះពាល់ ផ្ទាល់ និង អ្នក ប៉ះពាល់ ប្រយោល សូម រួសរាន់ មក ជួប ក្រុម គ្រូពេទ្យ និង ធ្វើចត្តាឡី ស័ក ដើម្បី យក សំណាក ទៅ ពិនិត្យ និង អ្នក ដែល ប៉ះពាល់ ដោយ ប្រយោល ជា អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ខាងលើ សូម រួសរាន់ ធ្វើចត្តាឡី ស័ក នៅ តាម ផ្ទះ ក្នុង ក្រុមគ្រួសារ រៀង ៗ ខ្លួន ដោយ មិន ត្រូវ ពាក់ព័ន្ធ ជាមួយ អ្នកដទៃ ជាដាច់ខាត ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស ព័ត៌មាន របស់ រដ្ឋបាល ខេត្ត ត្បូង ឃ្មុំ៖ កម្ពុជា និង សមាជិក អាស៊ាន ដទៃ ទៀត រួមគ្នា កៀរគរ ជំនួយ មនុស្សធម៌ ជួយ ដល់ មីយ៉ាន់ម៉ា
អ្នកចូលរួម នៅក្នុង សន្និសីទ បាន សម្តែង នូវ ការគាំទ្រ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អាស៊ាន ក្នុង ការកៀរគរ ជំនួយ មនុស្សធម៌ សម្រាប់ មីយ៉ាន់ម៉ា ស្រប ទៅតាម ចំណុច ទី៤ នៃ ការព្រមព្រៀង ជា ឯកច្ឆន្ទ ៥ ចំណុច ដែល ត្រូវបាន សម្រេច នៅក្នុង កិច្ចប្រជុំ ថ្នាក់ដឹកនាំ អាស៊ាន កាលពី ថ្ងៃទី ២៤ ខែមេសា ឆ្នាំ ២០២១ ។ អង្គ សន្និសីទ បាន ធ្វើ ការសន្យា ចូលរួមចំណែក ជាមួយ កញ្ចប់ ហិរញ្ញវត្ថុ ដ៏ សំខាន់ និង ជំនួយ សប្បុរស រួម មាន វ៉ាក សាំង ជាដើម ដោយ ផ្តោត ជា សំខាន់ សម្រាប់ ដំណើរ ប្រតិបត្តិការ នៃ ជំនួយ នៅ ដំណាក់កាល ទី១ ។
ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន បាន ជម្រាប ជូន អង្គ សន្និសីទ អំពី ការចូលរួមចំណែក របស់ កម្ពុជា ជា ថវិកា ចំនួន ១០០.០០០ ( ១០ម៉ឺន ) ដុល្លារ អាមេរិក ដើម្បី គាំទ្រ ជំនួយ មនុស្សធម៌ ដល់ ប្រទេស មីយ៉ាន់ម៉ា តាមរយៈ មជ្ឈមណ្ឌល សម្របសម្រួល អាស៊ាន ដើម្បី ជំនួយ មនុស្សធម៌ និង ការគ្រប់គ្រង គ្រោះមហន្តរាយ (AHA Centre) ។
អាជ្ញាធរ ខេត្ត កំពង់ស្ពឺ ប្រកាស រកឃើញ មេរោគ កូវីដ១៩ បំប្លែង ថ្មី ប្រភេទ Delta ចំនួន ១ករណី ក្នុង មណ្ឌល ចត្តាឡី ស័ក ខេត្ត
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បាន បញ្ជាក់ ឱ្យដឹង យ៉ាង ដូច្នេះ ថា៖ « នៅ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ ក្រុម គ្រូពេទ្យ ជំនាញ បាន ទទួល លទ្ធផល ពី ការវិភាគរក មេរោគ បំប្លែង ថ្មី Delta ពី វិទ្យាស្ថាន ប៉ាស្ទ័រ ដោយ បាន ឃើញ ករណី វិជ្ជមាន មេរោគ បំប្លែង ខ្លួន ថ្មី ប្រភេទ នេះ នៅក្នុង មណ្ឌល ចត្តាឡី ស័ក វិទ្យាល័យ ឧដុង្គ ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ ចំនួន ១នាក់ ឈ្មោះ ប៉ូច វាសនា ភេទ ប្រុស អាយុ ២៥ ឆ្នាំ ស្នាក់ នៅ ភូមិ ខ្នារ អំពិល ឃុំ វាល ពង់ ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ » ។
បច្ចុប្បន្ន អ្នកជំងឺ រូប នេះ ត្រូវបាន ក្រុម គ្រូពេទ្យ ដាក់ ព្យាបាល នៅ ដាច់ដោយឡែក នៅ មណ្ឌល ពន្លឺ ថ្មី ជាមួយគ្នា នេះ ក្រុមការងារ ជំនាញ ថ្នាក់ ខេត្ត កំពុង បន្ត ស្រាវជ្រាវ រក អ្នក ប៉ះពាល់ ដើម្បី ធ្វើ សំណាក វត្ថុ វិភាគ ទៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ វិភាគរក ប្រភេទ មេរោគ កូវីដ១៩ បំប្លែង ថ្មី ទៅ តាម បច្ចេកទេស សុខាភិបាល បន្ត ទៀត ។
ពាក់ព័ន្ធ ករណី នេះ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ សូម ក្រើន រំលឹក និង សូម អំពាវនាវ យ៉ាង ទទូច ដល់ សាធារណជន និង ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង ខេត្ត កំពង់ស្ពឺ សូម ឱ្យ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ការពារ ខ្លួន និង កែប្រែ ទម្លាប់ នៃ ការរស់នៅ តាម បែប គន្លង ថ្មី សម្រប តាម បរិបទ នៃ ជំងឺ កូវីដ១៩ សំដៅ បង្ការ គ្រប់គ្រង និង កាត់ ខ្សែ ចម្លង នៃ មេរោគ កូវីដ១៩ ជាពិសេស ពពួក ប្រភេទ មេរោគ បំប្លែង ថ្មី ប្រភេទ Delta ដែល កំពុង បង្ក គ្រោះ ភ័យ ។
រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ សង្ឃឹម យ៉ាង មុតមាំ ថា ប្រជាពលរដ្ឋ អនុវត្ត ឱ្យ បាន ខ្ជាប់ ខ្ន នូវ វិធានការ « ៣កុំ និង ៣ការពារ » ព្រមទាំង វិធាន នៃ ការអនាម័យ នានា តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ពិសេស ការអនុវត្ត នូវ ការតព្វកិច្ច ពាក់ ម៉ាស់ និង រក្សា គម្លាត សង្គម រួម ជាមួយ វិធានការ រដ្ឋបាល ដែល កំពុង មាន ជាធរមាន ។
ទន្ទឹមនឹង នេះ សូម ប្រជាពលរដ្ឋ ត្រូវ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ ស្តីពី ការពង្រឹង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ និង សូម កុំ ចេញ ក្រៅ ឬ កាត់បន្ថយ ការធ្វើដំណើរ ចេញពី កន្លែង មួយ ទៅ កន្លែង មួយ ក្នុង ករណី មិន មាន កិច្ចការ ចាំបាច់ ៕ យុវជន ល្អ រួបរួម គាំទ្រ កំចាត់ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៩ ខែសីហា៖ បង្ក្រាប ១៤ករណី ឃាត់ខ្លួន ២១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៤ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១ករណី និង ជួញដូរ ១៣ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ២១ នាក់ ។
ខេត្ត បន្ទាយមានជ័យ បង្ហាញ អត្តសញ្ញាណ អ្នកជំងឺ កូវីដ ចំនួន ៣១៤ នាក់ និង ជាសះស្បើយ ៥៣ នាក់
រដ្ឋបាល ខេត្ត កំពត បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ដូស ទី៣ ដល់ មន្ត្រីរាជការ ជួរ មុខ ក្រុម គ្រូពេទ្យ រដ្ឋ និង ឯកជន
( កំពត ) ៖ លោក ជឹង ផល្លា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កំពត និង លោក ជា វ តាយ អភិបាល ខេត្ត នៅ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ មន្ត្រីរាជការ ជួរ មុខ ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ ឆ្លង កូវីដ១៩ ដូស ទី៣ ឬ ដូស ជំរុញ ប្រភេទ អាស្ត្រា ហ្សេនីកា នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ខេត្ត កំពត ។
ក្នុង ដំណើរការចាក់ វ៉ាក់សាំង ដូស ទី៣ ខាងលើ លោក ជា វ តាយ ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ក្រុម គ្រូពេទ្យ ដែល បាន យក អស់ កម្លាំង កាយ ចិត្ត ក្នុង ការចាក់ វ៉ាក់សាំង ជូន ដល់ ប្រជាពលរដ្ឋ ទូទៅ កងកម្លាំង និង មន្ត្រីរាជការ កន្លងមក ។ ជាក់ស្តែង ថ្ងៃ នេះ បន្ត ចាក់ ជូន ដល់ មន្ត្រីរាជការ ជួរ មុខ របស់ សាលា ខេត្ត កំពត ដោយ មិន គិត អំពី ការនឿយហត់ សំដៅ រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការបង្ការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ។
លោក ជា វ តាយ បាន បន្ត ថា ជានិច្ចកាល សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា សម្ដេច ទាំង ទ្វេរ តែងតែ យកចិត្តទុកដាក់ ចំពោះ សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ មន្ត្រីរាជការ ទាំងអស់ ពិសេស ក្នុង បរិបទ កូវីដ១៩ ដ៏ សែន លំបាក នេះ ។
ក្រៅពី ការដាក់ចេញ នូវ វិធានការ ចំណាត់ការ បទបញ្ជា ក៏ ដូចជា សាចរ ណែនាំ ជាច្រើន ដើម្បី បង្កា ទប់ ស្កា់ត់ ការឆ្លង រីករាលដាល់ ជងឺ កូវីដ១៩ សម្តេច បាន ខិតខំ ប្រើ អស់ លទ្ធភាព គ្រប់ មធ្យោបាយ ដើម្បី ស្វែងរក វ៉ាក់សាំង មក ចាក់ ជូន ដល់ ប្រជាពលរដ្ឋ និង មន្ត្រីរាជការ ទាំងអស់ ។
ជាក់ស្ដែង នៅ ពេល នេះ សម្ដេច តេជោ បាន ផ្ដល់ វ៉ាក់សាំង ប្រភេទ អាស្ត្រា ហ្សេនីកា ដូស ទី៣ ឬ ដូស ជំរុញ សម្រាប់ ចាក់ ជូន ដល់ ក្រុម គ្រូពេទ្យ រដ្ឋ និង ឯកជន ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ជួរ មុខ ចំនួន ១០. ១៤៤ ដូស បន្ថែម ទៀត បន្ទាប់ពី ជំហ៊ាន ដំបូង បាន ចាក់ ជូន ក្រុមគ្រួសារ អតីត យុទ្ធជន ចំនួន ប្រមាណ ៤.២៣៨ ដូស រួច មក ។
សិក្ខាសាលា នេះ រៀបចំឡើង ក្នុង គោលបំណ ង៖
ស្រ្តី រងគ្រោះ ដោយ ប្ដី ជះ ទឹក អាស៊ីត ទទួលបាន អំណោយ ពី អាជ្ញាធរ
( ភ្នំពេញ ) ៖ លោកស្រី ឈុន ស៊ុន នី អភិបាល រង ខណ្ឌ ពោធិ៍សែនជ័យ នា វេលា រសៀល ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ បាន ដឹកនាំ មន្រ្តី សាលា ខណ្ឌ រួម និង មន្រ្តី សង្កាត់ ចោម ចៅ ទី១ ចុះ សួរសុខទុក្ខ អ្នកស្រី លី រ៉ានី អាយុ ៥០ ឆ្នាំ ដែល រងគ្រោះ ដោយ ប្ដី ជះ ទឹក អាស៊ីត កាលពី ជាង ១ឆ្នាំ មុន ។ សព្វ អ្នកស្រី ថ្ងៃ កំពុង រស់ ម្នាក់ឯង ក្នុង ស្ថានភាព លំបាក នៅក្នុង ផ្ទះ ជួល មួយ នៅក្នុង ភូមិ ត្រពាំង ថ្លឹង១ សង្កាត់ ចោម ចៅ ទី១ ។
នៅក្នុង ឱកាស នោះ លោកស្រី អភិបាល រង ខណ្ឌ និង មន្រ្តី ក្រោម ឱវាទ បាន នាំយក អំណោយ មួយចំនួន របស់ រដ្ឋបាល ខណ្ឌ រួម មាន៖ អង្ករ ចំនួន ២៥ គីឡូ ថវិកា ៤០ ម៉ឺន រៀល ត្រីខ១យួរ ទឹកត្រី ១យួរ ទឹក ស៊ីវ អ៊ីវ១យួរ ។
លោកស្រី ឈុន ស៊ុន នី ក៏ បាន ចូលរួម សោកស្ដាយ នូវ អ្វី ដែល បាន កើតឡើង ទៅ លើ អ្នកស្រី លី រ៉ានី និង បង្កឡើង ដោយ ប្ដី របស់ គាត់ ។ ខណៈ នេះ គឺជា លើក ទី១ ហើយ ដែល រដ្ឋបាល ខណ្ឌ ពោធិ៍សែនជ័យ ចុះ សួរសុខទុក្ខ អ្នកស្រី ហើយ បន្ទាប់ពី នេះ ទៅ លោកស្រី អភិបាល រង ខណ្ឌ និង ពិភាក្សា ជាមួយ លោក អភិបាល ខណ្ឌ ដើម្បី ជួយ ដល់ ស្រ្តី រងគ្រោះ រូប នេះ ជាបន្ត ទៀត ។
សូម រំឭក ថា អ្នកស្រី លី រ៉ានី ត្រូវបាន ជន កំណាច ម្នាក់ ឈ្មោះ ហេង ចាន់ ឌី អាយុ ៤៣ ឆ្នាំ មាន វ័យ ក្មេង ជាង គាត់ រហូត៧ ឆ្នាំ មុខរបរ រត់ ម៉ូតូ ឌុប ត្រូវ ជា ប្ដី ទី២ របស់ គាត់ ជះ ទឹក អាស៊ីត កាលពី វេលា ម៉ោង ១០៖ ១៥នាទី យប់ ថ្ងៃទី ២៨ ខែមិនា ឆ្នាំ ២០២០ កន្លងទៅ ខណៈពេល ដែល គាត់ កំពុង ដើរ ចេញពី ធ្វើការ រោងចក្រ ទៅដល់ ផ្ទះ ជួល ស្ថិត នៅក្នុង ភូមិ ត្រពាំង ថ្លឹង១ សង្កាត់ ចោម ចៅ ទី១ ។
អំពើហិង្សា នេះ ក៏ ព្រោះតែ អតីត ប្ដី បាន ក្បត់ ចិត្ត ទៅ លួច មាន ប្រពន្ធ ថ្មី និង បាន ចុះ ចោល គាត់ ទៅ នៅ ជាមួយ ប្រពន្ធ ក្រោយ បាត់ អស់ រយៈពេល ជាង ៥ ឆ្នាំ ទើប ត្រឡប់មក រក គាត់ និង សុំ រួមរស់ ជាមួយគ្នា វិញ តែ គាត់ ពុំ ព្រម ជា ហេតុ ធ្វើឲ្យ ប្ដី ខឹង ក៏ ជះ ទឹក អាស៊ីត ដាក់ តែម្ដង ៕
បង់ក្លាដែស ចាក់ វ៉ាក់សាំង បង្ការ កូវីដ - ១៩ ដល់ ក្រុម អ្នក រកស៊ី ផ្លូវភេទ រាប់ រយ នាក់ នៅ តំបន់ ផ្តល់ សេវា នេះ ដ៏ ធំ បំផុត
បង់ក្លាដែស ត្រូវបាន គេ ដឹង ថា ស្ថិត ក្នុង ចំណោម ប្រទេស ( ម៉ូស្លីម ) ដ៏ តិចតួច បំផុត ដែល អនុញ្ញាតឲ្យ ការរកស៊ី ផ្លូវភេទ ប្រព្រឹត្តទៅ ដោយ ស្រប ច្បាប់ ។ ប្រទេស ដែល មាន ប្រជាជន ១៦៩ លាន នាក់ មួយ នេះ មាន តំបន់ បម្រើ សេវា ផ្លូវភេទ យ៉ាងហោចណាស់ ១១កន្លែង នៅ ទូទាំង ប្រទេស ហើយ ចាប់តាំងពី មាន ការរាត ត្បាត ជំងឺ COVID-19 ក្រុម អ្នក ប្រកប មុខរបរ នេះ បាន ជួប វិបត្តិ ធ្ងន់ធ្ងរ ខ្លាំង បំផុត ។
កន្លងមក នេះ អាជ្ញាធរ បង់ក្លាដែស ក៏ ធ្លាប់ ព្យាយាម ផ្តល់ ការចាក់ វ៉ាក់សាំង ជូន ដល់ ក្រុម អ្នកបម្រើ ផ្លូវភេទ ទាំងនោះ ផងដែរ ប៉ុន្តែ ផែនការ នេះ មិន បាន សម្រេច នោះ ឡើយ ព្រោះតែ ការខ្វះខាត វ៉ាក់សាំង ហើយ អាទិភាព ចម្បង កាល ណោះ ត្រូវបាន ផ្តល់ ជូន អ្នកបម្រើ ការងារ លើ វិស័យ សុខាភិបាល ជួរ មុខ ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង បង្ហាញ អត្តសញ្ញាណ អ្នកវិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ១៦នាក់ និង ជាសះស្បើយ ២៨ នាក់
ខេត្ត កំពង់ធំ បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្កា ជំងឺ កូវីដ១៩ ដល់ កុមារ និង ដូស ទី៣ ដល់ មន្ត្រីរាជការ ជិត ៨ម៉ឺន នាក់
( កំពង់ធំ )៖ អាជ្ញាធរ ខេ្ត កំពង់ធំ បាន ចាប់ផ្ដើម បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ប្រភេទ ស៊ីណូ វ៉ាក់ ដល់ កុមារ និង យុវវ័យ មាន អាយុ ចាប់ពី ១២ ឆ្នាំ ដល់ ក្រោម ១៨ ឆ្នាំ ចំនួន ៦១. ៩៣៧ នាក់ និង ដូស ទី៣ ដល់ មន្ត្រីរាជការ អាជ្ញាធរដែនដី ជាង ១៥.០០០ នាក់ នៅ ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ ។
លោក សុខ លូ អភិបាល កំពង់ធំ បាន ឲ្យដឹង ថា ការច៉ាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន ដល់ កុមារ និង យុវវ័យ នា ពេលនេះ ធ្វើឡើង នៅ ទូទាំង ៩ក្រុង ស្រុក ក្នុង ខេត្ត ។ ដោយឡែក តែ មន្ត្រីរាជការ និង អាជ្ញាធរដែនដី គឺ រដ្ឋបាល ខេត្ត បាន រៀបចំ បញ្ជី ឈ្មោះ រួច ជាស្រេច ហើយ មក ចាក់ នៅ សាលា ខេត្ត មួយ កន្លែង តែ ប៉ុណ្ណោះ ដោយ បែងចែក ទៅតាម អង្គភាព និង ក្រុង ស្រុក ។
អភិបាល ខេត្ត បាន អំពាវនាវ ដល់ មាតាបិតា និង អាណាព្យាបាល ទាំងអស់ ដែល មាន កូន ចៅ គ្រប់ អាយុ សូម យកមក ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ឱ្យ បាន គ្រប់ ៗ គ្នា និង បន្ត ចូលរួម អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ពិសេស អនុវត្ត វិធានការ « ៣កុំ និង ៣ការពារ » ឱ្យ បាន ត្រឹមត្រូវ ពេល នាំ កូន មក ចាក់ វ៉ាក់សាំង សូម រក្សា គម្លាត សុវត្ថិភាព និង ពាក់ ម៉ាស មាន អាកុល ជាប់ ខ្លួន ដើម្បី រួមគ្នា កាត់ ផ្តាច់ការចម្លង ជំងឺ កូវីដ១៩ នៅក្នុង សហគមន៍ របស់ យើង ។
លោក សុខ លូ បាន អំពាវនាវ ប្រជាពលរដ្ឋ ដែល មក ទទួល ការចាក់ វ៉ាក់សាំង នា ពេលនេះ ត្រូវ មក តាម ការកំណត់ របស់ អាជ្ញាធរ ចៀសវាង មក ប្រជ្រៀត គ្នា ធ្វើឱ្យ បាត់ សណ្ដាប់ធ្នាប់ ជាដើម ។
ជាមួយគ្នា នោះ ដែរ អាណាព្យាបាល មាតា បិតា និង កុមារ មាន ភាពសប្បាយរីករាយ យ៉ាង ខ្លាំង ដោយ ទទួលបាន ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ហើយ បាន ថ្លែងអំណរគុណ ដល់ សម្ដេច តេជោ ហ៊ុន សែន ដែល សម្ដេច តែងតែ គិតគូរ ពី សុខុមាលភាព របស់ បងប្អូន ប្រជាពរដ្ឋ ជាពិសេស គឺ កុមារ បាន ចូល សិក្សា រៀនសូត្រ ឡើងវិញ ហើយ ប្រជាពលរដ្ឋ និង បាន ប្រកប មុខរបរ ចិញ្ចឹម ជីវិត រៀង ៗ ខ្លួន ៕ ក្រសួង សង្គមកិច្ច បើក កិច្ចប្រជុំ ពិគ្រោះ និង ពិនិត្យ សេចក្តីព្រាង មាតិកា នៃ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោកស្រី ខៀវ បូរី រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា ប្រធាន ក្រុមការងារ បច្ចេកទេស អន្តរ ក្រសួង ដើម្បី រៀបចំ ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ នៃ កម្ពុជា បាន ដឹកនាំ កិច្ច កិច្ចប្រជុំ ពិគ្រោះយោបល់ ជាមួយ ថ្នាក់ ក្រោម ជាតិ ដើម្បី ពិនិត្យ ទៅ លើ សេចក្តីព្រាង មាតិកា នៃ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ តាម ប្រព័ន្ធ អនឡាញ នា ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ ។
កិច្ចប្រជុំ នា ពេលនេះ មាន ការចូលរួម ពី ក្រសួង ស្ថាប័ន អង្គការ ពាក់ព័ន្ធ និង ជា អភិបាល រង ចៅក្រម និង តំណាង អយ្យការ អម សាលាដំបូង និង លោក លោកស្រី តំណាង មកពី អង្គភាព ពាក់ព័ន្ធ ក្នុង ខេត្ត សៀមរាប បន្ទាយមានជ័យ បាត់ដំបង កំពង់ធំ មណ្ឌលគិរី និង ស្ទឹងត្រែង ជាដើម ។
ក្នុង ឱកាស បើក កិច្ចប្រជុំ នោះ លោកស្រី ខៀវ បូរី បាន លើកឡើង ថា គោលបំណង សំខាន់ នៃ កិច្ចប្រជុំ នា ព្រឹក នេះ គឺ ដើម្បី ពិនិត្យ និង ផ្តល់ យោបល់ ទៅ លើ សេចក្តី ព្រាង មាតិកា នៃ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ ។
ជា ការបន្ថែម លោកស្រី ខៀវ បូរី បាន ថ្លែង ការអរគុណ ដល់ សមាជិក សមាជិកា ទាំងអស់ ដែល បាន ចូលរួម ក្នុង កិច្ចប្រជុំ និង សូម អរគុណ អង្គការ យូនី សេហ្វ និង អង្គការ ភ្លែន អន្តរជាតិ ដែល បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ ដំណើរការ នៃ ការ រៀបចំ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចការពារ កុមារ ៕ អភិបាល ខេត្ត កំពង់ឆ្នាំង នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ចំនួន ១៥០ គ្រួសារ នៅ តំបន់ បិទ ខ្ទប់ ក្នុង ឃុំ ប្រឡាយ មាស ស្រុក កំពង់លែង
( កំពង់ឆ្នាំង ) ៖ រដ្ឋបាល ខេត្ត កំពង់ឆ្នាំង ក្នុង យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែសីហា ឆ្នាំ ២០២១ ដឹកនាំ ដោយ លោក ស៊ុន សុវណ្ណា រិទ្ធិ អភិបាល ខេត្ត បាន នាំយក អំណោយ ទៅ ចែកជូន ប្រជាពលរដ្ឋ ចំនួ ន ១៥០ គ្រួសារ ស្ថិត ក្នុង តំបន់ បិទ ខ្ទប់ ក្នុង ឃុំ ប្រឡាយ មាស ស្រុក កំពង់លែង ដោយ មាន ការចូលរួម ពី លោក អម សុភា អភិបាល រង ខេត្ត និង លោក កែវ វណ្ណ ដេត ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ស្រុក កំពង់លែង ។
ក្នុង ការសំណេះសំណាល នា ឱកាស នោះ លោក ស៊ុន សុវណ្ណា រិទ្ធិ បាន ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពី សម្តេច ចៅហ្វា វាំង វរ វៀង ជ័យ អធិបតី ស្រឹង្គារ គង់ សំអុល ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ព្រះបរម រាជ វាំង . លោក បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន រដ្ធ មន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ត កំពង់ឆ្នាំង ដែល តែងតែ គិតគូរ និង យកចិត្តទុកដាក់ លើ ការអភិវឌ្ឍន៍ ខេត្ត អោយ កាន់តែ មាន ការរីកចម្រើន និង បាន កសាង នូវ សមិទ្ធិផល ជាច្រើន នៅក្នុង ខេត្ត កំពង់ឆ្នាំង ។
ដោយឡែក អំឡុង ពេល នៃ ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ថ្នាក់ដឹកនាំ និង ក្រុមការងារ តែងតែ បាន ផ្តល់ នូវ ស្បៀង សម្ភារ និង ថវិកា ជាច្រើន ដល់ រដ្ឋបាល ខេត្ត សម្រាប់ យក ចាត់ចែង ជូន ប្រជាពលរដ្ធ ដែល ទទូល រង ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ១៩ និង គ្រោះមហន្តរាយ ផ្សេង ៗ នៅក្នុង ទូទាំង ខេត្ត កំពង់ឆ្នាំង ។
ចំពោះ អំណោយ ចែកជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង តំបន់ បិទ ខ្ទប់ ទាំង ១៥០ គ្រួសារ គឺ ក្នុង ១គ្រួសារ ៗ ទទូល បាន អង្ករ ២០គ .ក្រ មី ១កេស ត្រីខ១០ កំប៉ុង ទឹកត្រី ១យួរ ទឹក ស៊ីវ អ៊ីវ១យួរ និង ម៉ាស់១ ប្រអប់ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក អភិបាល ខេត្ត និង ក្រុមការងារ បាន ប្រគល់ ស្បៀង រដ្ឋបាល ខេត្ត ដល់ មេឃុំ ប្រឡាយ មាស សម្រាប់ ចែកចាយ ជូន ប្រជាពលរដ្ធ ធ្វើចត្តាឡី ស័ក តាម ខ្នង ផ្ទះ ដែល កំពុង ជួប ការខ្វះខាត នូវ អង្ករ ចំនួន ៤តោន មី ២០០ កេស ទឹក សុទ្ធ ២០០ កេស ត្រីខ ២០០ យួរ ទឹក ត្រី ២០០ យួរ ទឹក ស៊ីវ អ៊ីវ ២០០ យួរ និង ម៉ាស ២០០ ប្រអប់ ផងដែរ ៕ មន្ត្រី ជំនាញ បន្ត រកឃើញ អាល់កុល ក្លែងក្លាយ ចំនួន ៤៥លីត្រ និង ពពុះ សណ្ដែក មួយចំនួន នៅ ក្រុង ស្វាយរៀង
( ស្វាយរៀង ) ៖ នៅក្នុង ឱកាស បុណ្យ សែន ក្បាល ទឹក ប្រពៃណី ចិន - វៀតណាម ជិត ចូល មកដល់ មន្ត្រី សាខា ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ សាខា ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០២១ បាន សហការ ជាមួយ មន្ទី ពាណិជ្ជកម្ម ខេត្ត និង អាជ្ញាធរដែនដី បាន ចុះ ត្រួតពិនិត្យ ទំនិញ តាម ឃ្លាំង និង ផលិតផល អាល់កុល ជែល លាង ដៃ បន្លែ ផ្លែ ឈើ គ្រឿង សមុទ្រ នៅ ផ្សារ វាល យន្ត ទី រួម ខេត្ត ស្វាយរៀង ។
មន្ត្រី បាន បញ្ជាក់ ថា ជា លទ្ធផល ក្រោយ ការចុះអនុវត្ត ការងារ មន្ត្រី ជំនាញ បាន រកឃើញ អាល់កុល ក្លែងក្លាយ ចំនួន ៤៥លីត្រ ពពុះ សណ្តែក ចំនួន ២Kg មាន សារធាតុ គីមី ។ មន្ត្រី ជំនាញ បាន ធ្វើ កំណត់ហេតុ ដកហូត ទំនិញ ទាំងនោះ និង អាល់កុល ក្លែងក្លាយ ធ្វើ ការដុត កម្ទេចចោល តែម្តង ។
ភូមិ ទើប បង្កើត ថ្មី មួយ ក្នុង ស្រុក សាមគ្គី មាន ជ័យ ខេត្ត កំពង់ឆ្នាំង មិន ទាន់ មាន អគ្គិសនី និង ទឹក ប្រើប្រាស់ . ពលរដ្ឋ សំណូមពរ អាជ្ញាធរ ជួយ ដោះស្រាយ
( កំពង់ឆ្នាំង ) ៖ ភូមិ គិរី អភិវឌ្ឍន៍ ស្ថិត នៅក្នុង ឃុំ ឈានឡើង ស្រុក សាមគ្គី មាន ជ័យ ខេត្ត កំពង់ឆ្នាំង ជា ភូមិ ទើប បង្កើត បាន ៦ ឆ្នាំ ដែល អាជ្ញាធរ ស្រុក និង ខេត្ត បាន ជ្រើសរើស ប្រជាពលរដ្ឋ ក្រីក្រ កំរិត ១ ជាង ២០០ គ្រួសារ មក ប្រមូលផ្តុំ គ្នា ចាប់ ឆ្នោត ចែក ដី សម្បទាន សង្គមកិច្ចសង់ លំនៅឋាន បង្កើត ជា ភូមិ ថ្មី រហូតដល់ ពេលនេះ មិន ទាន់ មាន ភ្លើង និង ទឹក ប្រើប្រាស់ នោះ ឡើយ ។
ដោយឡែក នៅ អំឡុង ឆ្នាំ ២០១៣ អង្គការ ជំនួយ ព្រះវិហារ របស់ ប្រទេស ហ្វាំង ទ្បង់ បាន ជួយ កសាង ទំនប់ ទឹក និង ទ្វារ ទឹក មួយ កន្លែង ។ នៅក្នុង ឆ្នាំ ២០២០ អង្គការ ឡាសិត បាន ជួយ កសាង ទំនប់ ស្ទាក់ ទឹកភ្លៀង មួយ កន្លែង ជូន សហគមន៍ ភូមិ គិរី អភិវឌ្ឍន៍ ដែល មាន ប្រវែង ១៦២ ម៉ែត្រ និង សំណង់ សិល្បការ្យ ៣កន្លែង គាំទ្រ ថវិកា ដោយ រាជ រដ្ឋាភិបាល និង ធនាគារ ពិភពលោក ។
លោក មេភូមិ គិរី អភិវឌ្ឍន៍ បាន បញ្ជាក់ ទៀត ថា ប្រសិនបើ ភូមិ គីរី អភិវឌ្ឍន៍ មាន ប្រភព ទឹក ទំនប់ ស្តុក ទុក ប្រើប្រាស់ គ្រប់គ្រាន់ និង មាន អគ្គិសនី ប្រើប្រាស់ បរិបូរ វិញ នោះ ភូមិ គិរី អភិវឌ្ឍន៍ ដែល សំបូរ ដោយ ព្រៃ ភ្នំ ក្រម ថ្ម និង ក្លាយជា រមណីយដ្ឋាន ទេសចរណ៍ ធម្មជាតិ ដ៏ ល្អ ប្រណិត ដែល អាច ស្រូបយក ភ្ញៀវ ទេសចរណ៍ មក លេង កំសាន្ត ច្រើន ជា មិន ខាន ឡើយ ។
អាស្រ័យ ហេតុ នេះ ក្នុង នាម អាជ្ញាធរ ភូមិ តំណាង ឲ្យ ប្រជាពលរដ្ឋ ទាំង ២៣៨ គ្រួសារ គោរព ស្នើសុំ អាជ្ញាធរ ខេត្ត និង ស្ថាប័ន ពាក់ព័ន្ធ មេត្តា ជួយ ដោះស្រាយ នូវ កង្វះខាត ខាងលើ នេះ ជូន ប្រជាពលរដ្ឋ ភូមិ គិរី អភិវឌ្ឍន៍ ដែល ទើបនឹង បង្កើត ថ្មី នេះ ផង ៕ABA រក ចំណូល បាន ជិត ២៣០ លាន ដុល្លារ . ចំណេញ ជាង ៩០ លាន ដុល្លារ ក្នុង រយៈពេល ៦ខែ ឆ្នាំ នេះ
