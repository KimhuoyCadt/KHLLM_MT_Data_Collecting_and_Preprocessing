( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ទួលគោក នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ថ្នាក់ដឹកនាំ ខណ្ឌ ចុះ ជួប សំណេះសំណាល និង ឧបត្ថម្ភ ថវិកា ចំនួន ២.០០០.០០០ រៀល ដើម្បី លើកទឹកចិត្ត ដល់ កងកម្លាំង អធិការដ្ឋាន នគរបាល ខណ្ឌ និង កម្លាំង កងរាជអាវុធហត្ថ ខណ្ឌ ។
ក្នុង ពិធី ជួប សំណេះសំណាល នេះ . លោក ជា ពិសី បាន ជំរុញ ដល់ កងកម្លាំង សមត្ថកិច្ច ទាំងអស់ ត្រូវតែ យកចិត្តទុកដាក់ អនុវត្ត តួនាទី និង ភារកិច្ច ដើម្បី បម្រើ រាជ រដ្ឋាភិបាល និង ប្រជាពលរដ្ឋ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ បំផុត និង ការពង្រឹង លើ ការងារ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ។
លោក ជា ពិសី បាន សង្កត់ធ្ងន់ ថា សំខាន់ ការពង្រឹង ការអនុវត្ត គោល នយោបាយ ភូមិ - សង្កាត់ មាន សុវត្ថិភាព ដែល ដាក់ចេញ ដោយ រាជ រដ្ឋាភិបាល ស្ដី អំពី ការថែរក្សា ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ និង ស្ថិរភាព ក្នុង មូលដ្ឋាន ឱ្យ បាន ល្អ ប្រសើរ ជាមួយ ការផ្ដល់ សេវា កាន់តែ ល្អ ជូន ដល់ ប្រជាពលរដ្ឋ ។
លោក អភិបាល ថ្មី ខណ្ឌ ទួលគោក រូប នេះ បាន ប្រកាស ច្បាស់ ៗ ថា កងកម្លាំង ទាំងអស់ ត្រូវតែ ប្រកាន់ខ្ជាប់ខ្ជួន នូវ ស្មារតី សាមគ្គីភាព ផ្ទៃក្នុង ជា ធ្លុង មួយ ដ៏ រឹងមាំ ដោយ យក អស់ កម្លាំង កាយ ចិត្ត ខិតខំ បម្រើ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ ប្រកបដោយ កិត្តិបណ្ឌិត ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ប្រកបដោយ ភក្ដីភាព បំផុត ឥត ងាក រេរ និង បម្រើ ប្រជាពលរដ្ឋ ប្រកបដោយ ភាពស្មោះត្រង់ ហើយ ត្រូវតែ ចាត់ទុក ផលប្រយោជន៍ ជាតិ ជា ធំ និង ចាត់ទុក ប្រជាពលរដ្ឋ ជា ម្ចាស់ ។
លោក ជា ពិសី បាន ប្រកាស ប្រាប់ ដល់ កងកម្លាំង ថា ត្រូវតែ ប្រឆាំង ដាច់ខាត នឹង ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល មាន បំណង ទុច្ចរិត ចង់ បំផ្លិចបំផ្លាញ សន្តិភាព ការអភិវឌ្ឍ និង ភាពសុខដុមរមនា របស់ ជាតិ និង ប្រជាជន ហើយ បន្ត ការពារ ដាច់ខាត ចំពោះ រាជ រដ្ឋាភិបាល ដែល ប្រសូត្រ ឡើង ដោយ ការបោះឆ្នោត ស្រប ច្បាប់ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ៕
ចិន ជំរុញ ឲ្យ មាន ការស៊ើបអង្កេត លើ ការសម្លាប់ រង្គាល ជន ស៊ីវិល ដោយ សហរដ្ឋ អាមេរិក នៅ អាហ្វហ្គានីស្ថាន
( ប៉េកាំង ) ៖ អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន បាន និយាយ កាលពី ថ្ងៃពុធ ថា ទោះបី យោធា អាមេរិក បាន ដក ខ្លួន ចេញ ពី អាហ្វហ្គានីស្ថាន ក៏ដោយ ក៏ ការសម្លាប់ រង្គាល ជន ស៊ីវិល ដោយ យោធា អាមេរិក និង សម្ព័ន្ធមិត្ត របស់ ខ្លួន នៅក្នុង ប្រទេស អាហ្វហ្គានីស្ថាន ក្នុង សង្គ្រាម ២០ ឆ្នាំ នេះ ត្រូវតែ ស៊ើបអង្កេត ឲ្យបាន ហ្មត់ចត់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ យប់ ថ្ងៃពុធ ទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ ។
អ្នកនាំពាក្យ លោក Wang Wenbin បាន ធ្វើការកត់សម្គាល់ បែប នេះ នៅក្នុង សន្និសីទ សារព័ត៌មាន ប្រចាំ ថ្ងៃ ដើម្បី ឆ្លើយតប ទៅនឹង សំនួរ អំពី ការសម្លាប់ ជន ស៊ីវិល នា ពេល ថ្មី ៗ នេះ ដោយ កងទ័ព អាមេរិក ក្នុង អំឡុង ពេល ដក ទ័ព ចេញ ពី អាហ្វហ្គានីស្ថាន ។
យោង តាម របាយការណ៍ កាល ថ្ងៃទី ២៦ ខែសីហា កន្លងទៅ ការវាយប្រហារ ភេរវកម្ម នៅជិត ព្រលានយន្តហោះ ទីក្រុង កាប៊ុល បណ្តាលឱ្យ មនុស្ស រាប់ រយ នាក់ ស្លាប់ និង របួស ។ ជនរងគ្រោះ ខ្លះ បាន អះអាង ថា ក្រោយ ករណី បំផ្ទុះ គ្រាប់បែក អត្តឃាត យោធា អាមេរិក បាន បាញ់ តម្រង់ ទៅ ហ្វូង មនុស្ស ដែល បណ្តាលឱ្យ មាន មនុស្ស ស្លាប់ និង របួស ជាច្រើន នាក់ ។
របាយការណ៍ ក៏ បាន និយាយ ផងដែរ ថា នៅ ថ្ងៃទី ២៩ ខែសីហា យោធា អាមេរិក នៅ អាហ្វហ្គានីស្ថាន បាន ប្រើ យន្តហោះ គ្មាន មនុស្ស បើក ដើម្បី វាយប្រហារ អគារ លំនៅដ្ឋាន មួយ នៅ ទីក្រុង កាប៊ុល ដោយ ផ្អែក លើ សកម្មភាព ប្រឆាំង ភេរវកម្ម ដែល បាន សម្លាប់ ជន ស៊ីវិល១០ នាក់ ក្នុង នោះ ក៏ មាន ក្មេង អាយុ តែ ២ឆ្នាំ ផងដែរ ។
អភិបាល ខេត្ត កំពង់ចាម ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ សម្តេច តេជោ ផ្តល់ ជូន អតីត យុទ្ធជន ៣៤ គ្រួសារ
( ក្រចេះ ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន កិត្តិយស សមាគម អតីត យុទ្ធជន រួម ជាមួយ លោក ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត និង ជា ប្រធាន គណៈកម្មាធិការ សមាគម អតីត យុទ្ធជន ខេត្ត នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ បាន ដឹកនាំ ក្រុមការងារ ចុះ សួរសុខទុក្ខ និង នាំ អំណោយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ទៅ ផ្តល់ បងប្អូន អតីត យុទ្ធជន ៣៤ គ្រួសារ ដែល បាន ស្ម័គ្រ ចិត្ត មក រស់ នៅ លើ ដី សម្បទាន សង្គមកិច្ច ស្ថិត នៅក្នុង ភូមិ សំបួរ សែន ជ័យ ឃុំ ស្វាយ ជ្រះ ស្រុក ស្នួល ខេត្ត ក្រចេះ ។
ស្ថិត ក្នុង ឱកាស នោះ ដែរ ដោយ មាន សំណូមពរ ពី បងប្អូន អតីត យុទ្ធជន លោក អភិបាល ខេត្ត ក៏ បាន សម្រេច ផ្តល់ ជូន ការសាងសង់ បង្គន់ អនាម័យ ចំនួន ២០ បន្ទប់ បន្ថែម ដែល គ្រោង ចំណាយ ថវិកា សរុប ប្រមាណ ជាង ២៦ លាន រៀល ៕ ខេត្ត ស្ទឹងត្រែង បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ១៥នាក់ និង ជាសះស្បើយ ១៩ នាក់
ខាងក្រោម នេះ ជា លិខិត បញ្ជាក់ របស់ រដ្ឋបាល ខេត្ត ស្ទឹងត្រែ ង៖
ខេត្ត ក្រចេះ បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ចំនួន ៧នាក់ និង ជាសះស្បើយ ១១នាក់
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី កូនប្រុស របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ជា តំណាងរាស្រ្ត មណ្ឌល កំពង់ស្ពឺ និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ថ្លែង ថា ការចង់ បំបែកបំបាក់ គណបក្ស ប្រជាជន កម្ពុជា របស់ ក្រុម ប្រឆាំង ក្រៅ ច្បាប់ គឺ មិន អាច ទៅ រួច ទេ ។
លោក ហ៊ុន ម៉ានី បាន បញ្ជាក់ បែប នេះ បន្ទាប់ពី លោក សម រង្ស៉ី និង បក្ខពួក កាលពី ពេល ថ្មី ៗ នេះ បាន បំភ្លៃ ព័ត៌មាន ថា ពួកគេ បាន ជួប ជាមួយ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ ដើម្បី ពិភាក្សា អំពី ការបង្កើត រដ្ឋាភិបាល បណ្តោះអាសន្ន មួយ ខណៈ ដែល សម្តេច ទៅ ពិនិត្យ សុខភាព នៅ ប្រទេស បារាំង ។
ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ប្រកាស គាំទ្រ ចំពោះ ការចេញមុខ បដិសេធ និង បញ្ជាក់ ការពិត របស់ លោក ស សុខា ក្នុង នាម ជា កូន និង គ្រួសារ ទៅកាន់ មហាជន ។
លោក ស សុខា និង នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ បាន ចេញមុខ ច្រានចោល ភ្លាម ៗ ចំពោះ ព័ត៌មាន នេះ ។ ជាមួយគ្នា នេះ ក្រសួង មហាផ្ទៃ កំពុង ស្រាវជ្រាវ ចាប់ខ្លួន ជន ដែល បំភ្លៃ និង ចែកចាយ បន្ត ដោយ គោលដៅ ទុចរិត ផងដែរ ។
លោក ស សុខា រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា ដែល ជា កូនប្រុស សម្តេច ក្រឡហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បាន ថ្លែង ថា ល្បែង ប្រជាភិថុតិ របស់ ក្រុម អ្នកនយោបាយ ប្រឆាំង មួយចំនួន ដែល ភ្ជាប់ សម្តេច ក្រឡាហោម ស ខេង ដើម្បី ស្តារ ស្ថានភាព និង ប្រជាប្រិយភាព របស់ ខ្លួន និង ឃោសនា កុហក បោកប្រាស់ បំភាន់ មហាជន គួរ ត្រូវបាន បញ្ចប់ ៕ ខេត្ត ព្រះវិហារ បន្ត រកឃើញ អ្នកជំងឺ កូវីដ ចំនួន ៩នាក់ និង ជាសះស្បើយ ១១នាក់
រដ្ឋបាល ខេត្ត ព្រះវិហារ បាន ឱ្យដឹង ថា ក្នុង ចំណោម អ្នកជំងឺ កូវីដ ទាំង ៩នាក់ ត្រូវបាន បញ្ជូន ទៅ សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល ជំងឺ កូវីដកម្រិត ស្រាល នៅ វិទ្យាល័យ ជា ស៉ី ម ត្បែងមានជ័យ ក្រុង ព្រះវិហារ និង មណ្ឌល ព្យាបាល ជំងឺ កូវីដកម្រិត ស្រាល នៅ វិទ្យាល័យ រវៀង ស្រុក រវៀង ។
រដ្ឋបាល ខេត្ត កំពង់ធំ សម្រេច បិទ បញ្ចប់ វិធានការដ្ឋបាល ចាប់ពី ថ្ងៃទី ៣ ខែកញ្ញា ត ទៅ
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ បាន ចេញ សេចក្តីសម្រេច បិទ បញ្ចប់ វិធានការដ្ឋបាល ដែល ផ្អាក ជា បណ្តោះអាសន្ន នូវ សកម្មភាព ការងារ មុខរបរ និង អាជីវកម្ម ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ និង ការជួបជុំ ឬ ប្រមូលផ្តុំ មនុស្ស ជា លក្ខណៈ ឯកជន ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពង់ធំ ចាប់ពី ថ្ងៃទី ០៣ ខែកញ្ញា ឆ្នាំ ២០២១ត ទៅ ។
បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រលប់ ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ត្រូវ បិទ បញ្ចប់ វិធានការដ្ឋបាល ដែល ផ្អាក ជា បណ្តោះអាសន្ន នូវ សកម្មភាព ការងារ មុខរបរ និង អាជីវកម្ម ដែល មាន ហានិភ័យ ខ្ពស់ នៃ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ និង ការជួបជុំ ឬ ប្រមូលផ្តុំ មនុស្ស ជា លក្ខណៈ ឯកជន ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ភូមិសាស្ត្រ ខេត្ត កំពង់ធំ ចាប់ពី ថ្ងៃទី ០៣ ខែកញ្ញា ឆ្នាំ ២០២១ត ទៅ » ។
រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា រាល់ ការធ្វើ សកម្មភាព មុខរបរ និង អាជីវកម្ម រមណីយដ្ឋាន សួន កម្សាន្ត រោង សម្តែង សិល្បៈ សារ មន្ទីរ ក្លឹប ហាត់ប្រាណ និង មជ្ឈមណ្ឌល កីឡា អាច ដំណើរការ ឡើងវិញ បាន ដោយ តម្រូវឱ្យ គោរព តាម វិធានការ សុខាភិបាល និង វិធានការ « ៣ការពារ និង ៣កុំ » ឱ្យ បាន ត្រឹមត្រូវ ។
ជាមួយគ្នា នេះ ដែរ រដ្ឋបាល ខេត្ត បាន ឱ្យដឹង ថា សកម្មភាព អាជីវកម្ម អាហារដ្ឋាន ភោជនីយដ្ឋាន ហាង កាហ្វេ ហាង ភេសជ្ជៈ និង ភោជនីយដ្ឋាន នៅ តាម សណ្ឋាគារ អាច ដំណើរការ ជាធម្មតា ឡើងវិញ បាន ដោយ ត្រូវ រៀបចំ ឱ្យ មាន ទឹក អាល់កុល ឬ ដែល សម្រាប់ លាង ដៃ នៅមុខ ច្រក ចេញ ចូល ធ្វើ ការវាស់ កម្តៅ ភ្ញៀវ ទាំងអស់ មុននឹង អនុញ្ញាតឱ្យ ចូល ភោជនីយដ្ឋាន ឬ អាហារដ្ឋាន ជាពិសេស ត្រូវ រក្សា គម្លាត សុវត្ថិភាព យ៉ាងតិច ១.៥ម៉ែត្រ នៅ កន្លែង អង្គុយ ពី តុ មួយ ទៅ តុ មួយ ៕
សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ៨ ចំណុច ដើម្បី បន្ត ចូលរួម លើកកម្ពស់ ការងារ អក្ខរកម្ម ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន អំពាវនាវ ៨ ចំណុច ដើម្បី បន្ត ចូលរួម លើកកម្ពស់ ការងារ អក្ខរកម្ម នៅ កម្ពុជា ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ។ នេះ បើ តាម សារ លិខិត សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ប្រារព្ធ ទិវា អក្ខរកម្ម ជាតិ ៨កញ្ញា ២០២១ ដែល បណ្តាញ ព័ត៌មាន ទទួលបាន ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា ដើម្បី បន្ត ចូលរួម លើកកម្ពស់ ការងារ អក្ខរកម្ម នៅ កម្ពុជា ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ថែម ទៀត សម្តេច សូម អំពាវនាវ ដូចត ទៅ៖
* ទី១៖ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ រៀបចំ គោល នយោបាយ ក្របខណ្ឌ ច្បាប់ លិខិត បទដ្ឋាន និង យន្ត ការចាំបាច់ ដើម្បី ដឹកនាំ គ្រប់គ្រង និង អនុវត្ត ឱ្យ មាន ប្រសិទ្ធភាព និង គុណភាព ធានា បាន នូវ ការសិក្សា ពេញ មួយ ជីវិត សម្រាប់ ប្រជាពលរដ្ឋ គ្រប់ រូប និង ស្រប ទៅនឹង បរិការណ៍ ថ្មី នៃ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ក៏ ដូចជា ការស្តារ ឡើងវិញ សង្គម - សេដ្ឋកិច្ច បន្ទាប់ពី វិបត្តិ កូវីដ១៩ ។
* ទី២៖ ក្រសួង ស្ថាប័ន គ្រឹះស្ថាន សិក្សា មណ្ឌល សិក្សា ទី វត្តអារាម ទាំងអស់ ត្រូវ បន្ត បង្កើត កម្មវិធី អប់រំ កម្មវិធី សិក្សា ពេញ មួយ ជីវិត ទាំង ផ្នែក អក្ខរកម្ម ទាំង ផ្នែក វិជ្ជាជីវៈ ទាំង ផ្នែក បច្ចេកវិទ្យា ព័ត៌មាន ឱ្យ កាន់តែ សម្បូរបែប ឆ្លើយតប នឹង តម្រូវការ អ្នកសិក្សា ។
* ទី ៣៖ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ ត្រូវ យកចិត្តទុកដាក់ ចូលរួម គាំទ្រ ឱ្យ បាន ខ្លាំងក្លា ថែម ទៀត ក្នុង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ មជ្ឈមណ្ឌល សិក្សា និង ជំរុញ លើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ដែល មិន បាន រៀនសូត្រ ឬ បោះបង់ ការសិក្សា ឱ្យ មាន ឱកាស ទទួលបាន ការរៀនសូត្រ ជាថ្មី ជាពិសេស ត្រូវ ខិតខំ បង្ក លក្ខណៈ ងាយស្រួល ដល់ ប្រជាពលរដ្ឋ មាន ពិការភាព ឱ្យ ទទួលបាន លទ្ធភាព ក្នុង ការសិក្សា រៀនសូត្រ ប្រកបដោយ សមធម៌ និង បរិយាប័ន្ន ។
* ទី ៥៖ ក្មួយ ៗ ជា សិស្ស និស្សិត តាម គ្រឹះស្ថាន សិក្សា សាធារណៈ និង ឯកជន យុវជន សហភាព សហព័ន្ធ យុវជន កម្ពុជា យុវជន កាយ រឹទ្ធិ និង យុវជន កាកបាទ ក្រហម កម្ពុជា ត្រូវ សកម្ម ចូលរួម ជួយ បង្រៀន ដោយ ស្ម័គ្រចិត្ត ដល់ អ្នក មិន ចេះ អក្សរ ដែល ស្ថិត ក្នុង មូលដ្ឋាន របស់ ក្មួយ ៗ រស់ នៅ ។ បងប្អូន ជន រួម ជាតិ ដែល ជា មាតាបិតា ឬ អ្នកអាណាព្យាបាល ក៏ សូម ជួយ ជំរុញ កូន ចៅ ឱ្យ រៀនសូត្រ បាន ជាប់ លាប់ និង ទទួលបាន លទ្ធផល ល្អ គ្រប់ ៗ គ្នា ។
* ទី ៦៖ វត្ត អារាម និង វិហារ សាសនា នានា ត្រូវ ចលនា ព្រះសង្ឃ បព្វជិត សាសនា តា ជី ដូន ជី ចូលរួម ជំរុញ កម្មវិធី អក្ខរកម្មវិជ្ជាជីវៈ ឱ្យ កាន់តែ ខ្លាំងក្លា ថែម ទៀត តាមរយៈ ការទេស នា អប់រំ អំពី សារៈប្រយោជន៍ នៃ ការរៀនសូត្រ អំពី សីលធម៌ និង លើកកម្ពស់ វប្បធម៌ រស់ នៅ ក្នុង ភាពជា ពលរដ្ឋ សកល ។
* ទី ៧៖ ដៃគូ អភិវឌ្ឍ និង អង្គការ មិន មែន រដ្ឋាភិបាល ត្រូវ បង្កើន កិច្ចសហការ និង ពង្រឹង ភាពជាដៃគូ ជាមួយ គ្រឹះស្ថាន រដ្ឋ ដើម្បី ជួយ ឧបត្ថម្ភ គាំទ្រ ទាំង ធនធាន ទាំង បច្ចេកទេស ដល់ គ្រប់ កម្មវិធី អប់រំ ជាពិសេស កម្មវិធី អក្ខរកម្ម ផ្សារភ្ជាប់ នឹង ការអប់រវិជ្ជាជីវៈ ឱ្យ មាន ដំណើរការ ល្អ ជាប់ ជាប្រចាំ ។
* ៨៖ ប្រធាន រោងចក្រ សហគ្រាស និង ក្រុមហ៊ុន ឯកជន សូម ជួយ ជំរុញ បើក ថ្នាក់ អក្ខរកម្ម គួបផ្សំ ជាមួយ ថ្នាក់ បំប៉ន មុខជំនាញ វិជ្ជាជីវៈ ផ្សេង ៗ ដល់ បងប្អូន កម្មករ កម្ម ការិនី ដើម្បី ជា ប្រយោជន៍ របស់ ពួកគេ ផង និង ជា ប្រយោជន៍ ដល់ ម្ចាស់ រោងចក្រ សហគ្រាស ផង ដោយ យើង ទាំងអស់ គ្នា ត្រូវ ចងចាំ ថា « មាន អក្ខរកម្ម មាន ការគិតគូរ និង ការសម្រេចចិត្ត បាន ត្រឹមត្រូវ ». « មាន អក្ខរកម្ម នាំឱ្យ ការអភិវឌ្ឍ សហគមន៍ កាន់តែ រីកចម្រើន ». « មាន អក្ខរកម្ម មាន សុខដុម ជីវិត បុគ្គល គ្រួសារ និង សង្គម »៕
តៃវ៉ាន់ អះអាង ថា ចិន មាន សមត្ថភាព ធ្វើឱ្យ ប្រព័ន្ធ ការពារ ដែន អាកាស របស់ ខ្លួន ប្រើ មិន កើត
ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ ធ្វើ ការសន្និដ្ឋាន បែប នេះ នៅក្នុង របាយការណ៍ ប្រចាំ របស់ ខ្លួន ស្ដីពី យោធា ចិន ដាក់ ជូន សភា ជាតិ ។ របាយការណ៍ ដដែល បាន បញ្ជាក់ ដូច្នេះ ថា « ចិន អាច វាយប្រហារ ព័ត៌មានវិទ្យា ប្រឆាំង នឹង បណ្ដាញ អ៉ិន ធើណិត សកលលោក ដែល នេះ អាច ឱ្យ ពួកគេ បញ្ឈប់ ដំណើរការ ឬ ធ្វើឱ្យ ប្រព័ន្ធ ការពារ ដែន អាកាស របស់ យើង ជាប់គាំង ហើយ នេះ នឹង ក្លាយជា ការគំរាមកំហែង ដ៏ ធំ សម្រាប់ ពួកយើង » ។
គួរ បញ្ជាក់ ថា បើ តាម ក្រសួង ការពារ ជាតិ តៃវ៉ាន់ ចិន បាន អភិវឌ្ឍ សមត្ថភាព ស៊ើបការណ៍ សម្ងាត់ យ៉ាង ឆាប់រហ័ស តាមរយៈ ប្រព័ន្ធ ផ្កាយ រណប Beidou ដែល ចិន ប្រើ ដើម្បី បង្កើត ប្រព័ន្ធ GPS ផ្ទាល់ខ្លួន ទប់ទល់ ជាមួយ សហរដ្ឋ អាមេរិក ។ នេះ មាន ន័យ ថា ទីក្រុង ប៉េកាំង អាច តាមដាន ឬ ឃ្លាំមើល រាល់ សកម្មភាព នៅ ជុំវិញ កោះ តៃវ៉ាន់ ដោយ មាន ជំនួយ ពី យន្ដហោះ ស៊ើបការណ៍ . យន្ដហោះ ដ្រូន . និង នាវា ស៊ើបការណ៍ សម្ងាត់ ជាដើម ៕
មន្ត្រី សាធារណការ ម្នាក់ នៅ ខេត្ត ស្វាយរៀង ត្រូវ ដាក់ ឱ្យ ចូល និវត្តន៍ មុន អាយុ កំណត់ ខណៈ មន្ត្រី ៥នាក់ ទៀត ត្រូវ ទម្លាក់ ឋានៈ និង ប្តូរ កន្លែង ធ្វើការ ក្រោយ បង្ក កំហុស ចេញ ប័ណ្ណ បើកបរ ឲ្យ គេ ដោយ មិន ចាំបាច់ ប្រឡង
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន សម្រេច ដាក់ មន្ត្រី មួយ រូប ឱ្យ ចូល និវត្តន៍ មុន អាយុ ខណៈ មន្ត្រី ៥រូប ទៀត ត្រូវបាន ផ្លាស់ប្តូរ កន្លែង ធ្វើការ ព្រមទាំង ទម្លាក់ មួយ ឋានៈ ដោយសារ ពួកគេ ក សាង កំហុស ចេញ ប័ណ្ណ បើកបរ ឱ្យ ពលរដ្ឋ ដោយ មិន មាន សាម៉ីខ្លួន មក ប្រឡង ។ នេះ បើ តាម សេចក្តីសម្រេច របស់ រដ្ឋមន្រ្តី ក្រសួង សាធារណការ និង អភិបាល ខេត្ត ស្វាយរៀង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ល្ងាច ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
យោង បាន សេចក្តី ខាងលើ . លោក ព្រំ ផូ មាន តួនាទី ជា ប្រធាន ការិយាល័យ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ស្វាយរៀង និង ជា ប្រធាន គណៈកម្មការ ប្រឡង យក ប័ណ្ណ បើកបរ ត្រូវបាន ដាក់ ឱ្យ ចូល និវត្តន៍ មុន អាយុ កំណត់ ដោយ ប្រាក់ បៀរវត្ស និង ប្រាក់ បំណាច់ ផ្សេង ៗ ទៀត របស់ សាម៉ីខ្លួន ត្រូវ ផ្តាច់ ចេញ ពី តារាង ទូទាត់ បៀរវត្ស ចាប់ពី ថ្ងៃទី ០១ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
ជាមួយ ការដាក់ទោសទណ្ឌ ទៅ លើ មន្រ្តី របស់ ខ្លួន ក្រោយ ប្រព្រឹត្ត ខុសពី តួនាទី នេះ លោក គង់ វិមាន ជា នាយក ខុទ្ទកាល័យ និង ជា អ្នកនាំពាក្យ ក្រសួង បាន បញ្ជាក់ បន្ថែម ថា ករណី នេះ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ បាន អនុវត្ត វិន័យ ដោយ ផ្លាស់ប្តូរ ដោយ បង្ខំ ចំពោះ មន្ត្រី ទាំង នេះ ក្នុង នោះ មាន ម្នាក់ គឺ លោក ព្រំ ផូ ឱ្យ ចូល និវត្តន៍ មុន អាយុ និង មន្ត្រី ៥រូប ទៀត បាន ផ្លាស់ប្តូរ មុខតំណែង ពី កន្លែង ចាស់ ទៅ កន្លែង ថ្មី ជាមួយនឹង ការដកហូត ឋានៈ មួយ ថ្នាក់ ។
