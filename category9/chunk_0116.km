ការធ្វើ ផ្សពព្វផ្សាយ នៅ ធ្វើឡើង តាមរយៈ ការតាំងពិព៌រណ៍ រូបភាព សកម្មភាព ថ្នាក់ដឹកនាំ រូបភាព ផលវិបាក នៃ គ្រឿងញៀន ខិត្តប័ណ្ណ ផ្ទាំង រូបភាព បដា សារ ព្រមាន សៀវភៅ ចំណេះដឹង ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ច្បាប់ និង វត្ថុអនុស្សារីយ៍ ផ្សេង ៗ មាន៖ មួក ប្រតិទិន ឆ័ត្រ ផ្លិត កែវ កាបូប ចែកជូន និង បន្ត ផ្សព្វផ្សាយ បន្ត ដល់ ក្រុមគ្រួសារ មិត្តភក្តិ និង មនុស្ស ជា ទីស្រឡាញ់ សំដៅ ចូលរួម សកម្មភាព ជាមួយ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត « សំអាត ចក ពី បឹង » ដោះស្រាយ កង្វល់ ប្រជាពលរដ្ឋ ពី បញ្ហា គ្រឿងញៀន ។
លោក ឡោ សុវិជ្ជា មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង ទេសចរណ៍ បាន ឱ្យដឹង ថា ក្រុមការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ក្នុង វិស័យ ទេសចរណ៍ គឺ រាល់ ពិធី បុណ្យ សមុទ្រ និង បុណ្យ ទន្លេ តែងតែ ទទួលបាន ការគាំទ្រ ចូលរួម ទស្សនា សិក្សា ស្វែងយល់ ពី បញ្ហា គ្រឿងញៀន ច្រើន កុះករ ដើម្បី ទទួលបាន ចំណេះដឹង បន្ថែម កាន់តែ ច្បាស់ ពី បញ្ហា គ្រឿងញៀន ។
ថ្លែង ក្នុង នាម ជា ដៃគូ . លោក សុខ វឿន ប្រធាន នាយក ប្រតិបត្តិ មីក្រូ ហិរញ្ញវត្ថុ អិល អូអិល ស៊ី បាន ថ្លែង ថា ការចូលរួម របស់ វិស័យ ឯកជន ជួយ សង្គម ពិសេស ការចូលរួម ជួយ ដល់ ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ជា ការសំខាន់ ចាំបាច់ ណាស់ ព្រោះថា បញ្ហា គ្រឿងញៀន ជា បញ្ហា រួម របស់ យើង ទាំងអស់ គ្នា ហើយ ជាដើម ចម នាំឱ្យ សហគមន៍ គ្មាន សុវត្ថិភាព មិន អាច អភិវឌ្ឍ បាន ទេ ហើយ គួរ រួមគ្នា ជួយ ឧបត្ថម្ភ បន្ត ទៀត ។
ចាប់ផ្តើម ពី ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន ទាំងអស់ ក្រុមហ៊ុន ឯកជន រោងចក្រ សហគ្រាស រហូតដល់ សមាជិក គ្រួសារ ធ្វើ ការអប់រំ ក្រើន រំលឹក ពី ផល ប៉ះពាល់ វិនាសកម្ម នៃ គ្រឿងញៀន និង មាន វិធាន ម៉ឺងម៉ាត់ និង តឹងរឹង បំផុត ចំពោះ ការប្រើប្រាស់ គ្រឿងញៀន ត្រូវ និយាយ ថា ទេ ដាច់ខាត ចំពោះ គ្រឿងញៀន ។
ស្ថិត ក្នុង ឱកាស ប្រកបដោយ សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ឧទ្ទិស បួងសួង ដល់ វិញ្ញាណក្ខន្ធ ស ព ឯកឧត្ដម ឃួន ផល្លា រិទ្ធ សូម បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
សម្តេច ធិបតី បាន លើកឡើង បែប នេះ ក្នុង ឱកាស ដែល សម្តេច និង លោកជំទាវ បណ្ឌិត អញ្ជើញ បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅ ខេត្ត សៀមរាប នា ល្ងាច ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ក្នុង ន័យ នេះ . រាជ រដ្ឋាភិបាល នីតិកាល ទី ៧ បន្ត ចាត់ទុក វិស័យ ទេសចរណ៍ ជា វិស័យ អាទិភាព ដែល រួមចំណែក ដល់ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ជាតិ តាមរយៈ ការបង្កើត ឱកាស ការងារ . ការបង្កើន ប្រាក់ ចំណូល ជូន ប្រជាជន ដោយ ផ្ទាល់ និង ដោយ ប្រយោល . ការជំរុញ ការនាំចេញ នៅ នឹង កន្លែង . ការទ្រទ្រង់ កំណើន សេដ្ឋកិច្ច . ការបង្កើន ចំណូល ជាតិ . ការចូលរួម ដល់ ការអភិរក្ស វប្បធម៌ និង ការថែរក្សា ការពារ បរិស្ថាន ធនធាន ធម្មជាតិ របស់ យើង ប្រកបដោយ ប្រសិទ្ធភាព និង ការទទួលខុសត្រូវ ខ្ពស់ » ។
សម្តេច ធិបតី ក៏ បាន លើកឡើង ទៀត ថា វិស័យ ទេសចរណ៍ ក្លាយជា កម្លាំង ចលករ ដ៏ សំខាន់ ក្នុង រយៈពេល ៣០ ឆ្នាំ ចុងក្រោយ នេះ ក្នុង ការចូលរួម ជំរុញ វឌ្ឍនភាព សេដ្ឋកិច្ច កម្ពុជា ឱ្យ កើនឡើង ប្រមាណ ១៣ ដង ចាប់ពី ឆ្នាំ ១៩៩៣ - ២០២៣ ។
តាម របាយការណ៍ របស់ លោក សុខ សូកេន រដ្ឋមន្តី ក្រសួង ទេសចរណ៍ . កម្ពុជា ទទួលបាន ភ្ញៀវ ទេសចរ អន្តរជាតិ សរុប ប្រមាណ ៥.៤៥ លាន នាក់ ក្នុង ឆ្នាំ ២០២៣ ហើយ សង្ឃឹម ថា ចំនួន ភ្ញៀវ អន្តរជាតិ មក កម្ពុជា អាចនឹង ត្រលប់ ទៅ រក ស្ថានភាព មុន វិបត្តិ ជំងឺ កូវីដ - ១៩ ត្រឹម ឆ្នាំ ២០២៥ ។
សម្តេច ធិបតី នៅតែ មាន សុទិដ្ឋិនិយម ថា វិស័យ ទេសចរណ៍ នឹង នៅតែ ជា វិស័យ ចន្ទល់ សេដ្ឋកិច្ច មួយ ដ៏ សំខាន់ ក្នុង ការបង្កើត ឱកាស ការងារ . មុខរបរ . ប្រាក់ ចំណូល និង រួមចំណែក ការសម្រេចបាន គោលដៅ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ - ដំណាក់កាល ទី ១. ជាពិសេស រួមចំណែក ដល់ ការសម្រេចបាន ចក្ខុវិស័យ កម្ពុជា ជា ប្រទេស ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
សម្តេច បាន បញ្ជាក់ ថា នៅ ឆ្នាំ ២០២៤ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ យុទ្ធនាការ « ទស្សនា សៀមរាប ឆ្នាំ ២០២៤ » និង ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន កម្ពុជា - ចិន និង ឆ្នាំ ទេសចរណ៍ កម្ពុជា - ឥណ្ឌា លើក ទី១ ដើម្បី ជួយ ឱ្យ ទេសចរណ៍ មក ទស្សនា កម្ពុជា កាន់តែ ច្រើន ។
ការថ្លែង របស់ សម្តេច យ៉ាង ដូច្នេះ ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅ ខេត្ត សៀមរាប នា ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ ។
សម្តេច បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ យុទ្ធនាការ « ទស្សនា សៀមរាប ឆ្នាំ ២០២៤ » និង បាន កំណត់ យក ឆ្នាំ ២០២៤ ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន កម្ពុជា - ចិន និង ឆ្នាំ ទេសចរណ៍ កម្ពុជា - ឥណ្ឌា លើក ទី១ ដើម្បី លើកស្ទួយ វិស័យ ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប និង ជួយ ជំរុញ ឱ្យ ទេសចរណ៍ ដ៏ មាន សក្តានុពល ពី ប្រទេស ទាំង ពីរ ចូលមក ទស្សនា នៅ កម្ពុជា កាន់តែ ច្រើន » ។
សម្តេច ធិបតី បាន ថ្លែង ទៀត ថា ការដាក់ ឱ្យ ប្រើប្រាស់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ កាលពី ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ជា កាលានុវត្តភាព ថ្មី ដែល កំពុង ក្លាយទៅជា សក្តានុពល ស្រូបទាញ ដ៏ ខ្លាំង សំរាប់ វិស័យ ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នៅតែ មាន សុទិដ្ឋិនិយម ថា វិស័យ ទេសចរណ៍ នឹង នៅតែ ជា វិស័យ ចន្ទល់ សេដ្ឋកិច្ច មួយ ដ៏ សំខាន់ ក្នុង ការបង្កើត ឱកាស ការងារ . មុខរបរ . ប្រាក់ ចំណូល និង រួមចំណែក ការសម្រេចបាន គោលដៅ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី ១. ជាពិសេស រួមចំណែក ដល់ ការសម្រេចបាន ចក្ខុវិស័យ កម្ពុជា ជា ប្រទេស ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សម្តេច បាន ចេញ អនុក្រឹត្យ បង្កើត ក្រុង រុន តា ឯក តេជោ សែន ដើម្បី ជំរុញ ការអភិវឌ្ឍ តំបន់ រុន តា ឯក ឱ្យ ក្លាយ ទៅជា ក្រុង មួយ ដ៏ ស្រស់ស្អាត របស់ ខេត្ត សៀមរាប ក្នុង ការផ្តល់ ភាពងាយស្រួល ដល់ ប្រជាពលរដ្ឋ ក៏ ជា ការលើកទឹកចិត្ត ដល់ ប្រជាពលរដ្ឋ ដែល បាន ស្ម័គ្រចិត្ត ចាកចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ ។
សម្តេច បញ្ជាក់ ថា ការរៀបចំ ផ្លាស់ទី ប្រជាពលរដ្ឋ ចេញ ពី តំបន់ រមណីយដ្ឋាន អង្គរ គឺជា កិច្ចការ ដ៏ ចាំបាច់ បំផុត ក្នុង ការ បំពេញ តាម លក្ខខណ្ឌ អង្គការ យូណេស្កូ . ជាពិសេស ការពារ តម្លៃ ជា សកល នៃ រមណីយដ្ឋាន អង្គរ ឱ្យ បន្ត ស្ថិត ក្នុង បញ្ជី បេតិកភណ្ឌ ពិភពលោក ។
សូម ជម្រាប ថា បើ តាម របាយការណ៍ របស់ មន្ទីរ ទេសចរណ៍ ចាប់ពី ខែមករា - ខែកុម្ភៈ ឆ្នាំ ២០២៤ ខេត្ត សៀមរាប ទទួលបាន ភ្ញៀវ ទេសចរ សរុប ចំនួន ៥៣៧. ៣៥០ នាក់ កើនឡើង ៦២. ៦៩ ភាគរយ បើ ធៀប នឹង រយៈពេល ដូចគ្នា នៅ ឆ្នាំ ២០២៣ ក្នុង នោះ ភ្ញៀវ ទេសចរ ជាតិ មាន ចំនួន ៣០១. ៥០០ នាក់ និង ភ្ញៀវ ទេសចរ អន្តរជាតិ មាន ចំនួន ២៣៥. ៨៥០ នាក់ ។
សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ដូចនេះ ថា « ខ្ញុំ បាន ឯកភាព ជាមួយ ការស្នើសុំ របស់ ឧត្តម ទេសរដ្ឋមន្ត្រី ថោង ខុន ប៉ុន្មាន ថ្ងៃ មុន នៅក្នុង ការបង្កើត នូវ ព្រឹត្តិការណ៍ ប្រចាំ ឆ្នាំ ច្រើន កន្លែង ទាំង នៅ សៀមរាប ទាំង នៅ កន្លែង ផ្សេង ៗ ទាំង ព្រឹត្តិការណ៍ កីឡា ព្រឹត្តិការណ៍ វប្បធម៌ ជា ប្រចាំ ឆ្នាំ តែម្តង » ។
សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន បន្ថែម ថា កិច្ចការ នេះ គឺ សំខាន់ ដោយ នៅ ពេល ដែល សម្តេច បាន ប្រជុំ ជាមួយ បងប្អូន នៅក្នុង វិស័យ ទេសចរណ៍ តែងតែ បាន ស្នើសុំ សម្តេច ឱ្យ ពួកគាត់ បាន ដឹង ថា មាន កម្មវិធី អ្វី ខ្លះ ពេលណា ខ្លះ ដើម្បី បាន រៀបចំ ផែនការទាក់ ម៉ូយ ផង ។ ដូចនេះ ពេល ដែល អនុញ្ញាតឱ្យ មាន ឲ្យ មាន ព្រឹត្តិការណ៍ ជា ប្រចាំ ឆ្នាំ បែប នេះ គឺជា កិច្ចការ ងាយស្រួល នៅក្នុង វិស័យ ទេសចរណ៍ អាច រៀបចំ ជា កញ្ចប់ ទេសចរណ៍ បាន ល្អ ។
សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជា ដែរ ថា ជា វិស័យ ឯកជន ជា អ្នក ដើរ តួនាទី សំខាន់ នៅក្នុង ការផលិត នូវ ផលិតផល ទេសចរណ៍ ដើរ ទាក់ ម៉ូយ បន្ថែម ផ្គូរ ផ្គង គ្នា ដើម្បី ធ្វើការ ជាមួយគ្នា ទើប ទទួលបាន ជោគជ័យ ។
សម្តេច ធិបតី ថ្លែង បែប នេះ ក្នុង ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅ ខេត្ត សៀមរាប នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ ។
ប្រសាសន៍ នេះ ត្រូវបាន ថ្លែង អំឡុង ពេល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន - អង្គការ សហ ប្រជាជាតិ នៅ ទីក្រុង ហ្សាការតា ប្រទេស ឥណ្ឌូនេស៉ី នៅ ព្រឹក ថ្ងៃទី ៧ ខែកញ្ញា ឆ្នាំ ២០២៣ ។
សម្តេច ក៏ បាន ថ្លែង ថា ក្នុង កិច្ចការ អភិវឌ្ឍ សហគមន៍ ទាំងអស់ គឺ មិន ត្រូវ បោះបង់ ចោល នរណា ម្នាក់ ឬ ក៏ ទីកន្លែង ណាមួយ ៕ ប្អូន ប្រុស បង្កើត របស់ សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី ទទួលមរណភាព នៅ ល្ងាច ថ្ងៃសៅរ៍ នេះ ដោយ រោគា ពាធ
( ភ្នំពេញ ) ៖ លោក ឃួន ផល្លារិទ្ធ នាយក រង ខុទ្ទកាល័យ និង ជា ប្អូន ប្រុស បង្កើត សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ប្រធាន រដ្ឋសភា បាន ទទួលមរណភាព នៅ ថ្ងៃសៅរ៍ ៧កើត ខែ ផល្គុន ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ វេលា ម៉ោង ១៧: ៤០ នាទី ក្នុង ជន្មាយុ ៦៧ ឆ្នាំ ដោយ រោគា ពាធ ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ផ្លូវការ របស់ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា ។
រដ្ឋសភា បាន បញ្ជាក់ ទៀត ថា សព នឹង ត្រូវ ដង្ហែ យក ទៅ បូជា នៅ ម៉ោង ០៧ : ១២ព្រឹក ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៤ នៅ វត្ត វិមាន តេជៈ ហៅ វត្ត ស្រះចក ស្ថិត នៅ សង្កាត់ ស្រះចក ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ នៅ ល្ងាច ថ្ងៃសៅរ៍ ៧កើត ខែ ផល្គុន ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អញ្ជើញ ជា អធិបតី បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅក្នុង ខេត្ត សៀមរាប ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ ៗ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឱកាស អញ្ជើញ បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅ ខេត្ត សៀមរាប៖
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន . អតីត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា . កម្ពុជា ទទួលបាន សុខ សន្តិភាព ពេញ លើ ផ្ទៃ ប្រទេស ដែល ពុំ ធ្លាប់ មាន ក្នុង រយៈពេល ជាង ៥០០ ឆ្នាំ ក្នុង ប្រវត្តិសាស្ត្រ ជាមួយនឹង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ជាមួយ សុខ សន្តិភាព កម្ពុជា បាន ក្លាយជា គោលដៅ ទេសចរណ៍ វិនិយោគ និង ពាណិជ្ជកម្ម ដ៏ គួរឱ្យ ទាក់ទាញ មួយ ក្នុង តំបន់ អាស៊ី . ជាពិសេស បាន ធ្វើឱ្យ វិស័យ ទេសចរណ៍ ក្លាយជា កម្លាំង ចលករ ដ៏ សំខាន់ ក្នុង រយៈពេល ៣០ ឆ្នាំ ចុងក្រោយ នេះ ក្នុង ការចូលរួម ជំរុញ វឌ្ឍនភាព សេដ្ឋកិច្ច កម្ពុជា ឱ្យ កើនឡើង ប្រមាណ ១៣ ដង ចាប់ពី ឆ្នាំ ១៩៩៣ - ២០២៣ ។
* ដោយ ភ្ជាប់ ទៅនឹង អនុស្សាវរីយ៍ របស់ នាយក រដ្ឋមន្ត្រី អូស្ត្រាលី លើ ទឹកដី អង្គរ កាលពី ឆ្នាំ ១៩៨៧ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា កាលពី មុន សៀមរាប មិន មាន សំឡេង ទេសចរណ៍ អ៊ូអរ កង រំពង ដូច ពេល បច្ចុប្បន្ន នេះ ឡើយ ។ នេះ ហើយ ជា ផល លាភ នៃ សុខ សន្តិភាព ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ក្នុង រយៈពេល មួយ ទសវត្សរ៍ ចុងក្រោយ នេះ . វិស័យ ទេសចរណ៍ កម្ពុជា បាន រីកលូតលាស់ គួរ ជា ទី មោទនៈ ដោយ បាន ចូលរួមចំណែក យ៉ាង ច្រើន ក្នុង ផ.ស.ស . ជាតិ ។ ប៉ុន្តែ កំណើន នេះ ត្រូវបាន បង្អាក់ ស្ទើរតែ ទាំងស្រុង ដោយសារ ការរីករាលដាល នៃ វិបត្តិ ជំងឺ កូវីដ១៩ ដែល បាន ជះ ឥទ្ធិពល ជា អវិជ្ជមាន ដល់ សុខភាព សាធារណៈ និង បង្ក ផល ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ ការ អភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម អន្តរជាតិ នៅ ទូទាំង សកលលោក ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត មានប្រសាសន៍ ថា ក្នុង អំឡុង ពេល វិបត្តិ ជំងឺ កូវីដ១៩ . រាជ រដ្ឋាភិបាល នីតិកាល ទី៦ បាន ប្រែក្លាយ វិបត្តិ ទៅជា កាលានុវត្តភាព សម្រាប់ ការស្តារ និង ការកែលម្អ រចនាសម្ព័ន្ធ ចាំបាច់ នានា សំដៅ គាំទ្រ ដល់ កិច្ច ដំណើរការ ឡើងវិញ នៃ វិស័យ ទេសចរណ៍ ដ៏ សំខាន់ របស់ កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សម្រាប់ ខេត្ត សៀមរាប រាជ រដ្ឋាភិបាល បាន សម្រេចចិត្ត ជា យុទ្ធសាស្ត្រ ក្នុង ការស្ថាបនា បណ្តាញ ផ្លូវ ៣៨ ខ្សែ និង ការរៀបចំ ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ ព្រមទាំង ការស្ដារ និង កែលម្អ ស្ទឹង សៀមរាប ដែល បាន ធ្វើឱ្យ ខេត្ត សៀមរាប កាន់តែ មាន ភាពទាក់ទាញ បន្ថែម ទៀត ។ សមិទ្ធផល ថ្មី ទាំង នេះ បាន កំពុង បំពេញ ថាមពល បន្ថែម ដល់ វិស័យ ទេសចរណ៍ ក្នុង ខេត្ត ទេសចរណ៍ វប្បធម៌ និង ប្រវត្តិសាស្ត្រ ដ៏ រុងរឿង នេះ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ យុទ្ធនាការ « ទស្សនា សៀមរាប ឆ្នាំ ២០២៤ » និង បាន កំណត់ យក ឆ្នាំ ២០២៤ ជា ឆ្នាំ នៃ ការផ្លាស់ប្តូរ រវាង ប្រជាជន និង ប្រជាជន កម្ពុជា - ចិន និង ឆ្នាំ ទេសចរណ៍ កម្ពុជា - ឥណ្ឌា លើក ទី១ ដើម្បី លើកស្ទួយ វិស័យ ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប និង ជួយ ជំរុញ ឱ្យ ទេសចរណ៍ ដ៏ មាន សក្តានុពល ពី ប្រទេស ទាំង ពីរ ចូលមក ទស្សនា នៅ កម្ពុជា កាន់តែ ច្រើន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នៅតែ មាន សុទិដ្ឋិនិយម ថា វិស័យ ទេសចរណ៍ នឹង នៅតែ ជា វិស័យ ចន្ទល់ សេដ្ឋកិច្ច មួយ ដ៏ សំខាន់ ក្នុង ការបង្កើត ឱកាស ការងារ . មុខរបរ . ប្រាក់ ចំណូល និង រួមចំណែក ការសម្រេចបាន គោលដៅ នៃ យុទ្ធសាស្ត្រ បញ្ចកោណ - ដំណាក់កាល ទី ១. ជាពិសេស រួមចំណែក ដល់ ការសម្រេចបាន ចក្ខុវិស័យ កម្ពុជា ជា ប្រទេស ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា សូម វាយតម្លៃ ខ្ពស់ ចំពោះ ក្រសួង ទេសចរណ៍ ក្រោម ការដឹកនាំ របស់ ឯកឧត្តម សុខ សូកេន ដែល ក្នុង រយៈពេល ជាង ៦ខែ មក នេះ បាន ខិតខំ ដាក់ចេញ នូវ ផែនការ យុទ្ធសាស្ត្រ ថ្មី ៗ ពិសេស គំនិត ផ្តួចផ្តើម យុទ្ធសាស្ត្រ « បង្កើន ៥ អភិវឌ្ឍ ៣» និង ទិសដៅ កែទម្រង់ មុត ស្រួច មួយចំនួន ទៀត ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត សូម ស្នើ ឱ្យ គ្រប់ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ ផ្តល់ កិច្ចសហការ ល្អ ជាមួយ ក្រសួង ទេសចរណ៍ ដើម្បី ធ្វើ យ៉ាងណា សម្រេច ឱ្យ បាន នូវ ចក្ខុវិស័យ ខាងលើ និង ជំរុញ ការអនុវត្ត គំនិត ផ្តួចផ្តើម ពាក់ព័ន្ធ នឹង វិស័យ ទេសចរណ៍ នានា ឱ្យ ទទួលបាន ជោគជ័យ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ការអភិវឌ្ឍ តំបន់ តាម ដងទន្លេ មិន មែន ធ្វើឡើង សម្រាប់ តែ ពេល បច្ចុប្បន្ន នោះ ទេ ប៉ុន្តែ យើង ត្រូវ គិតគូរ ឱ្យ បាន វែងឆ្ងាយ ទៅដល់ អនាគត ដោយ ត្រូវ មាន ផែនការ ច្បាស់លាស់ និង គ្រប់ ជ្រុងជ្រោយ ស្រប ពេល ដែល ពិភពលោក ទាំងមូល បាន និង កំពុង ប្រឈម នឹង ការវិវត្ត ថ្មី ៗ ទាំង លើ នយោបាយ សេដ្ឋកិច្ច សង្គម និង បរិស្ថាន ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា គោលដៅ អភិវឌ្ឍន៍ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី គឺ មិន ចោល ប្រជាពលរដ្ឋ រូប ណា ម្នាក់ នោះ ឡើយ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ឯកភាព កំណត់ ឱ្យ មាន ជា ប្រចាំ ឆ្នាំ នូវ ព្រឹត្តិការណ៍ នានា ដើម្បី ទាក់ទាញ អ្នកទេសចរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ថ្លែង ថា ត្រូវ ពង្រឹង យន្តការដៃគូរ វាង រដ្ឋ និង វិស័យ ឯកជន ដើម្បី ជំរុញ សកម្មភាព ទេសចរណ៍ នៅ កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ការស្វាគមន៍ នៅ ព្រលានយន្តហោះ ជា រឿង ដំបូង គេ ដើម្បី ទាក់ទាញ អ្នកទេសចរ និង អាច ទាកចិត្ត អ្នកទេសចរ ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ រៀបចំ ភ្លេង ឆៃ យាំស្វាគមន៍ អ្នកទេសចរ នៅ តាម ព្រលានយន្តហោះ ស្វាគមន៍ អ្នកទេសចរ ចូលមក លេង កម្សាន្ត នៅ កម្ពុជា ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ណែនាំ ឱ្យ រៀបចំ ស្វាគមន៍ ពលករ ខ្មែរ ត្រឡប់ មកពី ថៃ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ។
* សម្តេច ធិបតី ហ៊ុន ម៉ាណែត សូម លើកទឹកចិត្ត និង ផ្ដល់ នូវ ទស្សនៈ ចំនួន ៩ ចំណុច ដើម្បី រួមចំណែក ដល់ ការលើកកម្ពស់ វិស័យ ទេសចរណ៍ ។
ការវាយប្រហារ លើ ប៉ុស្ត យោធា ប៉ាគីស្ថាន ដែល នៅជាប់ ព្រំដែន អាហ្វហ្គានីស្ថាន សម្លាប់ មនុស្ស ៧នាក់
( អ៉ី ស្លាម៉ា បាដ) ៖ យោធា ប៉ាគីស្ថាន និយាយ ថា ក្រុម សកម្ម ប្រយុទ្ធ បាន វាយប្រហារ លើ ប៉ុស្ត យោធា មួយ នៅក្នុង ប្រទេស ប៉ាគីស្ថាន ក្បែរ ប្រទេស អាហ្វហ្គានីស្ថាន កាលពី ព្រឹក ថ្ងៃសៅរ៍ ( ម៉ោង ក្នុង តំបន់ ) ដោយ ការបំផ្ទុះ គ្រាប់បែក អត្តឃាត បណ្តាលឱ្យ ស្លាប់ ៧នាក់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ សារព័ត៌មាន Reuters នៅ ថ្ងៃសៅរ៍ ទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ ។
( ភ្នំពេញ ) ៖ មន្ទីរ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ខេត្ត កំពង់ធំ បាន ចេញ សេចក្តី បំភ្លឺ មួយ ដោយ ច្រានចោទ ការចោទប្រកាន់ របស់ ជន អនាមិក តាមរយៈ ការផ្សាយ ជាសាធារណៈ របស់ វិទ្យុ ABC កាលពី ថ្ងៃទី ១៤ ខែមីនា ឆ្នាំ ២០២៤ ដែល និយាយ មិន ពិត ថា មន្រ្តី ក្រសួង អធិការកិច្ច បាន ទារ ប្រាក់ ៥០០០ ដុល្លា អាមេរិក ជា ថ្នូរ នឹង ការ មិន ត្រួតពិនិត្យ ឯកសារ ។
រដ្ឋមន្ត្រី នេត្រ ភក្ត្រា និង លោកស្រី ទុយ សិរី រតនៈ នេត្រ ភក្រ្តា ដឹកនាំ គណៈប្រតិភូ សមាគម នារី សាខា ក្រសួង ព័ត៌មាន ប្រមាណ ៣០០ នាក់ ធ្វើ ទស្សនកិច្ច នៅ ខេត្ត ព្រះសីហនុ
ដំណើរទស្សនកិច្ច ដើម្បី ស្វែងយល់ ពី ការរីកចម្រើន របស់ ខេត្ត ព្រះសីហនុ ដែល ជា តំបន់ សេដ្ឋកិច្ច ពហុ បំណង របស់ កម្ពុជា និង ផ្តល់ ការកម្សាន្ត ដល់ មន្ត្រី នៃ ក្រសួង ព័ត៌មាន ជា នារី ។
លោក នេត្រ ភក្ត្រា បាន ថ្លែង ថា ការរៀបចំ ដំណើរទស្សនកិច្ច នេះ ធ្វើឡើង ដើម្បី ចូលរួម អបអរ សាទរ ទិវា អន្តរជាតិ នារី ផង . ដើម្បី ផ្តល់ ឱកាស ដល់ មន្ត្រី ក្រសួង ព័ត៌មាន ជា នារី បាន ដើរ ទស្សនា កម្សាន្ត នៅលើ ទឹកដី ខេត្ត ព្រះសីហនុ ដែល កំពុង មាន ការរីកចម្រើន ផង និង ក៏ ដើម្បី លើកទឹកចិត្ត មន្ត្រី នៃ ក្រសួង ព័ត៌មាន ។
លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ មន្ត្រីរាជការ នៃ ក្រសួង ព័ត៌មាន ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង បំពេញ ការងារ ប្រកបដោយ វិជ្ជាជីវៈ និង ការទទួលខុសត្រូវ ខ្ពស់ ក្នុង បុព្វហេតុ ក្នុង វិស័យ ព័ត៌មាន និង សោត ទស្សន៍ នៅ កម្ពុជា ។
នា ឱកាស នោះ ដែរ លោក បាន លើកឡើង ថា ស្ត្រី បាន ដើរ តួនាទី យ៉ាង សំខាន់ ទាំង ក្នុង គ្រួសារ និង ក្នុង សង្គមជាតិ ហើយ ដោយឡែក មន្ត្រី នៃ ក្រសួង ព័ត៌មាន ជា ស្ត្រី បាន បំពេញ ការងារ យ៉ាង សកម្ម និង បាន ចូលរួម ក្នុង ការដ្ឋាន កំណែទម្រង់ នានា ពង្រឹង ប្រសិទ្ធភាព ស្ថាប័ន និង គុណភាព ការងារ ។
( មូស្គូ ) ៖ ក្រុម មន្ត្រី រុស្ស៉ី បាន ឱ្យដឹង នៅ ថ្ងៃសៅរ៍ ទី ១៦ ខែមីនា នេះ ថា មនុស្ស ២នាក់ ត្រូវបាន សម្លាប់ និង ៣នាក់ ផ្សេង ទៀត រងរបួស នៅក្នុង ការវាយប្រហារ ដោយ មីស៊ីល មួយ គ្រាប់ របស់ អ៊ុយក្រែន លើ តំបន់ Belgorod នៃ ព្រំដែន រុស្ស៉ី ខណៈ ប្រជាជន រុស្ស៉ី កំពុង បោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី មាន រយៈពេល ៣ ថ្ងៃ ដែល ចាប់ផ្ដើម កាលពី ថ្ងៃសុក្រ រហូតដល់ ថ្ងៃអាទិត្យ ចុង សប្ដាហ៍ នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters ។
( ឧត្តរមានជ័យ )៖ គិត ចាប់តាំងពី ថ្ងៃទី ១១ ដល់ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ មាន ព្រះសង្ឃ និង ប្រជាពលរដ្ឋ ចំនួន ៤៧៥ អង្គ - នាក់ ក្នុង នោះ ស្ត្រី ចំនួន ២៥០ នាក់ មកពី តាម បណ្តា ក្រុង ស្រុក នានា ក្នុង ខេត្ត ឧត្តរមានជ័យ បាន មក ទទួល ការពិនិត្យ និង ពិគ្រោះ ជំងឺ ភ្នែក ដោយ ឥត គិត ថ្លៃ នៅក្នុង មន្ទីរពេទ្យ បង្អែក ខេត្ត ។
លោក វេជ្ជបណ្ឌិត ឃ្លោក ហួត ទីប្រឹក្សា ក្រសួង សុខាភិបាល និង ជា ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ឧត្តរមានជ័យ បាន ប្រាប់ ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ថា « ក្នុង ការពិនិត្យ ព្យាបាល ជំងឺ ភ្នែក ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ក្នុង ឱកាស នោះ ក្រុម គ្រូពេទ្យ បាន ធ្វើ ការវះកាត់ ជំងឺ ភ្នែក ចំនួន ១៨៦ ករណី ក្នុង នោះ ស្រី ១០២ នាក់ បាយ ភ្នែក ១៥២ ករណី ស្រី ៧៦ នាក់ កន្ទុយ ថ្លែន ភ្នែក ៣៣ ករណី ស្រី ២៦ នាក់ ផងដែរ » ។
បើ តាម លោក វេជ្ជបណ្តិត ឃ្លោក ហួត បាន ថ្លែង ថា តាម ការកត់សម្គាល់ របស់ លោក អ្នក មាន អ្នកជំងឺ បាយ ភ្នែក ច្រើន ភាគ ច្រើន ជា មនុស្ស ចាស់ ដោយសារ មូលហេតុ មក វ័យ ចាស់ជរា ផង និង មាន ជំងឺ រ៉ាំរ៉ៃ ផង ។
សូម បញ្ជាក់ ថា ការពិនិត្យ ព្យាបាល ជំងឺ ភ្នែក ដោយ ឥត គិត ថ្លៃ នៅក្នុង បរិវេណ មន្ទីរពេទ្យ បង្អែក ខេត្ត ឧត្តរមានជ័យ ចាប់ពី ថ្ងៃទី ១១ ដល់ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ កន្លងទៅ ថ្មី ៗ នេះ គឺ មាន ការសហការ ពី ក្រុម គ្រូពេទ្យ របស់ កម្មវិធី ជាតិ សុខភាព ភ្នែក និង ក្រុម គ្រូពេទ្យ ឯកទេស ភ្នែក នៃ ក្រសួង សុខាភិបាល និង ក្រុម គ្រូពេទ្យ នៃ មន្ទីរពេទ្យ បង្អែក ខេត្ត ឧត្តរមានជ័យ ៕
ក្នុង ឱកាស នោះ សម្ដេច ព្រះមហាសង្ឃរាជ បួរ គ្រី មាន ព្រះបន្ទួល ទៅកាន់ គណៈប្រតិភូ ព្រះសង្ឃ ជាន់ ខ្ពស់ អំពី យុទ្ធសាស្ត្រ បញ្ចកោណ អភិវឌ្ឍន៍ ជាតិ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ដែល ក្នុង នោះ ក៏ មាន ការបណ្ដុះ នូវ ធនធាន មនុស្ស ឲ្យបាន កាន់តែ ច្រើន ដើម្បី ចូលរួម អភិវឌ្ឍន៍ និង ធ្វើឲ្យ សម្រេច ជោគជ័យ នូវ គោលដៅ ឆ្នាំ ២០៣០ និង ឆ្នាំ ២០៥០ ។
សម្ដេច មាន ព្រះបន្ទួល បន្ត ថា ក្រោម ការជួយជ្រោមជ្រែង តាមរយៈ រាជ រដ្ឋាភិបាល តាំងពី អាណត្តិ មុន ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី បាន ជួយ កសាង នូវ អគារ សិក្សា កម្ពស់ ៩ជាន់ ដែល ធ្វើឲ្យ PSBU មាន លទ្ធភាព អាច បង្កើន ការផ្ដល់ អាហារូបករណ៍ ដល់ សមណ និស្សិត និង សិស្ស និស្សិត បាន សិក្សា កាន់តែ ច្រើន ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ។
សម្ដេច ព្រះមហាសង្ឃរាជ បួរ គ្រី មាន ព្រះបន្ទួល បន្ថែម ថា ក្រៅពី មាន សមត្ថភាព អាច បង្កើន ការផ្ដល់ អាហារូបករណ៍ និង បន្ទប់ សិក្សា នោះ នៅ ឆ្នាំ នេះ PSBU បាន បើក នូវ ការ បង្រៀន ថ្នាក់ បណ្ឌិត ខណៈ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា គឺជា សាកលវិទ្យាល័យ ផ្នែក ព្រះពុទ្ធ សាសនា នៅ កម្ពុជា ដំបូង គេ ដែល បើក បង្រៀន ថ្នាក់ បណ្ឌិត នេះ ។
មន្ត្រី៖ ការចងក្រង បង្កើត សហគមន៍ កសិកម្ម ជា មុខ ព្រួញ ស្នូល ដ៏ សំខាន់ លើកកម្ពស់ អំណាច ការចរចា ទីផ្សារ របស់ ប្រជាកសិករ និង ពង្រីក ឱកាស ទីផ្សារ កសិផល
( ព្រះវិហារ ) ៖ លោក ពឹង ទ្រី ដា ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ បាន ថ្លែង ថា ការចងក្រង បង្កើត សហគមន៍ កសិកម្ម គឺជា មុខ ព្រួញ ស្នូល ដ៏ សំខាន់ ក្នុង ការលើកកម្ពស់ អំណាច ការចរចា ទីផ្សារ របស់ ប្រជាកសិករ ការទទួលបាន ព័ត៌មាន ទីផ្សារ ពង្រីក ឱកាស ទីផ្សារ ក សិផល របស់ កសិករ ដើម្បី លើកកម្ពស់ គុណភាព កសិផល ឬ ផលិតផល របស់ កសិករ និង បង្កើន ប្រាក់ ចំណូល គ្រួសារ របស់ កសិករ ជា សមាជិក សហគមន៍ ផងដែរ ។
ការថ្លែង បែប នេះ របស់ ប្រធាន មន្ទីរកិសកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត ព្រះវិហារ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ចូលរួម ក្នុង ពិធី អបអរសាទរ មហាសន្និបាត កំណើត ដំបូង បណ្តាញ សហគមន៍ កសិកម្ម ស្វាយចន្ទី ព្រះវិហារ សាមគ្គី ដោយ មាន ការចូលរួម ពី តំណាង អង្គការ ទស្សន ពិភពលោក អន្តរជាតិ - កម្ពុជា និង សមាជិក បណ្តាញ សហគមន៍ ចំនួន ១៤ សហគមន៍ មកពី ៧ស្រុក ក្រុង នានា ក្នុង ខេត្ត ព្រះវិហារ នា ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ ម្សិលមិញ ។
ជាមួយគ្នា នេះ ដែរ ប្រធាន មន្ទីរ ក៏ បាន ជំរុញ លើកទឹកចិត្ត ដល់ សហគមន៍ កសិកម្ម ទាំង ១៤ ត្រូវ ខិត្ត ខំប្រឹងប្រែង លើ ការពង្រឹង និង អភិវឌ្ឍន៍ សក្តានុពល លើ ផលិតកម្ម កែច្នៃ ស្វាយចន្ទី របស់ ខ្លួន បន្ថែម ទៀត ព្រោះថា ផលិតផល គ្រាប់ ស្វាយចន្ទី គឺជា ផលិតផល កសិកម្ម ដ៏ សំខាន់ មួយ ដែល រាជ រដ្ឋាភិបាល កំពុង ជំរុញ ឱ្យ មាន ការផលិត ជា ផលិតផល សម្រេច ដើម្បី នាំចេញ ទៅ លក់ លើ ទីផ្សារ ក្នុង ស្រុក និង ក្រៅ ស្រុក ។
សូម បញ្ជាក់ ថា ពិធី សន្និបាត នា ឱកាស នោះ ក៏ មាន ការបោះឆ្នោត ដើម្បី ជ្រើសរើស ប្រធាន អនុប្រធាន ក្រុមប្រឹក្សាភិបាល និង គណៈកម្មា ធិការ ត្រួតពិនិត្យ របស់ បណ្តាយ សហគមន៍ កសិកម្ម ស្វាយចន្ទី ព្រះវិហារ សាមគ្គី ផងដែរ ៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សាធារណការ បើក កិច្ចប្រជុំ ពិភាក្សា ស្តីពី គម្រោង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ ទីក្រុង ក្រោម ក្របខ័ណ្ឌ ហិរញ្ញប្បទាន ពី ធនាគារ វិនិយោគ ហេដ្ឋារចនាសម្ព័ន្ធ អាស៊ី
( ភ្នំពេញ ) ៖ លោក ហេង ណន រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន នា ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ ដំបូង លើ គម្រោង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ ទីក្រុង នៅ ព្រះរាជាណាចក្រ កម្ពុជា ក្រោម ក្របខ័ណ្ឌ ហិរញ្ញប្បទាន ពី ធនាគារ វិនិយោគ ហេដ្ឋារចនាសម្ព័ន្ធ អាស៊ី (AIIB) ដោយ មាន ការចូលរួម ពី លោក លោកស្រី ជា សមាជិក សមាជិកា អង្គភាព គ្រប់គ្រង គម្រោង ក្នុង គោលបំណង ដើម្បី ប្រកាស សុពលភាព សមាសភាព អង្គភាព គ្រប់គ្រង គម្រោង នេះ ។
ថ្លែង ទៅកាន់ អង្គប្រជុំ លោក រដ្ឋលេខាធិការ បាន គូសបញ្ជាក់ ពី សារសំខាន់ នៃ គម្រោង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ ទីក្រុង ដែល ផ្តោត ជា សំខាន់ លើ ការធ្វើឱ្យ ប្រសើរឡើង ហេដ្ឋារចនាសម្ព័ន្ធ ក្រុង នៅ កម្ពុជា ក្នុង នោះ រួម មាន ការសាងសង់ ប្រព័ន្ធ ការពារ ទឹក ជំនន់ បណ្តាញ លូ និង អាង ចម្រោះ ទឹក កខ្វក់ ដោយ នឹង ត្រូវ អនុវត្ត ក្នុង ខេត្ត ចំនួន បួន រួម មាន៖ កំពង់ឆ្នាំង កំពង់ចាម តាកែវ និង ព្រៃវែង ។
បន្ថែម ពីលើ នេះ លោក រដ្ឋលេខាធិការ បាន ស្នើ ឱ្យ ប្រធាន គ្រប់គ្រង គម្រោង រួសរាន់ រៀបចំ សេចក្តីព្រាង ផែនការ សកម្មភាព ស្រប ទៅតាម ការណែនាំ នៃ លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន និង ស្នើ ឱ្យ សមាជិក សមាជិកា នៃ អង្គភាព គ្រប់គ្រង គម្រោង ទាំងអស់ ត្រូវ ខិតខំ អនុវត្ត គម្រោង នេះ ឱ្យ មាន ប្រសិទ្ធភាព និង ប្រកបដោយ គុណភាព ស្រប តាម សេចក្តីទុកចិត្ត និង គោលបំណង របស់ ថ្នាក់ដឹកនាំ ៕ សមាគម ឧកញ៉ា កម្ពុជា ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការបញ្ចប់ គោរមងារ « ឧកញ៉ា » ពី គោរម វន្ត ណា ម្នាក់ ដែល ស្ថិត ក្នុង ករណី ចំនួន ៥
សមាគម ឧកញ៉ា កម្ពុជា បាន ឲ្យដឹង ថា យោង តាម មាត្រា ១៩ នៃ ព្រះរាជ ក្រឹត្យ លេខ ន ស/ រក ត/ ១០២៣ / ២២៥០ ចុះ ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២៣ ស្តីពី គោរមងារ ឧកញ៉ា បាន បញ្ញត្តិ ពី តួនាទី ភារកិច្ច និង ការទទួលខុសត្រូវ របស់ សមាគម ឧកញ៉ា កម្ពុជា ក្នុង ភាពជា តំណាង គោរម វន្ត ទាំងអស់ នៅ ព្រះរាជ ណាចក្រ កម្ពុជា និង ភាពជាដៃគូ របស់ រាជ រដ្ឋាភិបាល ។
ទន្ទឹមនឹង នេះ សមាគម ឧកញ៉ា កម្ពុជា ក៏ ជា សមាជិក គណៈកម្មការ អន្តរ ក្រសួង ពិនិត្យ និង វាយតម្លៃ លើ សំណើ សុំ គោរមងារ និង ការបញ្ចប់ គោរមងារ ឧកញ៉ា ( គ. ព. វ. គ) ដែល គណៈកម្មការ នេះ នឹង ត្រូវ រៀបចំ អនុក្រឹត្យ ស្តីពី បែបបទ និង នីតិវិធី នៃ ការស្នើសុំ និង វាយតម្លៃ ក្នុង ការផ្តល់ គោរមងារ ឧកញ៉ា និង ការបញ្ចប់ គោរមងារ ឧកញ៉ា ផងដែរ ។
យោង តាម មាត្រា ២២ នៃ ព្រះរាជ ក្រឹត្យ ដដែល បាន បញ្ញត្តិ ថា លោក អ្នក ឧកញ៉ា អ្នក ឧកញ៉ា និង ឧកញ៉ា ត្រូវ គោរព រដ្ឋធម្មនុញ្ញ ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត នានា របស់ ព្រះរាជាណាចក្រ កម្ពុជា ប្រកាន់ខ្ជាប់ នូវ សីលធម៌ ល្អ ប្រកប មុខរបរ ស្រប ច្បាប់ និង ចៀសវាង សកម្មភាព ណា ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ កិត្តិយស និង សេចក្តីថ្លៃថ្នូរ របស់ គោរមងារ ឧកញ៉ា ។
អាស្រ័យ ដូច បាន គោរព ជម្រាប ជូន ខាងលើ សូម អ្នក ឧកញ៉ា ឧកញ៉ា និង សាធារណជន ទាំងអស់ មេត្តា ជ្រាប ជា ព័ត៌មាន តាម ការគួរ ។ សម្រាប់ ព័ត៌មាន បន្ថែម សូម ទាក់ទង អ្នកនាំពាក្យ សមាគម ឧកញ៉ា កម្ពុជា តាមរយៈ លេខ ទូរស័ព្ទ ០១២ ៨១០ ៨១១ នៅ រៀងរាល់ ម៉ោង ធ្វើការ ៕ គម្រោង ស្ដារ និង លើកកម្រិត គុណភាព ផ្លូវ ជាតិ លេខ ៣៣ សម្រេចបានជាង ៥៥% ពោល លឿន ជាង ផែនការ
កិច្ចពិភាក្សា នេះ ធ្វើឡើង ក្នុង គោលបំណង ពិនិត្យ ដាន លើ កិច្ចសន្យា ការងារ បច្ចេកទេស សាងសង់ ដែល បាន ឯកភាព គ្នា ពិភាក្សា លើ បញ្ហា ប្រឈម ដំណោះស្រាយ ដើម្បី ធានា ឱ្យ បាន នូវ ការសាងសង់ អនុវត្ត ទៅ តាម លក្ខណៈ បទដ្ឋាន បច្ចេកទេស ត្រឹមត្រូវ ប្រកបដោយ គុណភាព និង អាច ប្រើប្រាស់ បាន យូរអង្វែង ។
ឆ្លៀត ក្នុង ឱកាស នេះ ដែរ លោក រដ្ឋលេខាធិការ បាន ធ្វើ ការណែនាំ ដល់ ក្រុមហ៊ុន សាងសង់ ត្រូវ យកចិត្តទុកដាក់ ឱ្យ បាន ខ្ពស់ បំផុត ក្នុង ការអនុវត្ត ការងារ ឱ្យ បាន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស ជៀសវាង ការធ្វើ ខុស ហើយ ត្រូវ ធ្វើ ឡើងវិញ ដដែល ៗ ។ លើស ពី នេះ ទៅ ទៀត ក្រុមហ៊ុន ត្រូវ គិតគូរ ឱ្យ បាន ហ្មត់ចត់ ពី សុវត្ថិភាព ដោយ ដាក់ ផ្លាក សញ្ញា ចរាចរណ៍ នៅ តាម ការដ្ឋាន ភ្លើង សញ្ញា ចរាចរណ៍ នៅ ពេល យប់ និង ការស្រោច ទឹក កាត់បន្ថយ ដី ហុយ ជាដើម ជៀសវាង ការរំខាន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ។
សូម ជម្រាប ជូន ថា៖ គម្រោង ផ្លូវ ជាតិ លេខ ៣៣ ធ្វើឡើង ក្រោម ឥណទាន សម្បទាន ពី រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន រួម ជាមួយនឹង ថវិកា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រាប់ ការដោះស្រាយ ផល ប៉ះពាល់ និង ពន្ធ អាករ ផ្សេង ៗ ៕ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បញ្ជាក់ ពី ការឃាត់ខ្លួន អនុប្រធាន បណ្តោះអាសន្ន គណបក្ស កម្លាំង ជាតិ ខេត្ត កំពង់ចាម និង ច្រានចោល ការលើកឡើង ពាក់ព័ន្ធ នឹង រឿង នយោបាយ
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ នៃ ស្នងការដា្ឋន នគរបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន បដិសេធ និង ច្រានចោល ទាំងស្រុង ចំពោះ ការផ្សាយ ថា ការឃាត់ខ្លួន អនុប្រធាន បណ្តោះអាសន្ន គណបក្ស កម្លាំង ជាតិ ខេត្ត កំពង់ចាម ពាក់ព័ន្ធ នឹង នយោបាយ ។
ក្នុង សេចក្ដីប្រកាស ព័ត៌មាន បាន បញ្ជាក់ ថា អ្នកនាំពាក្យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ មាន កិត្តិយស សូម ជម្រាប ជូន សាធារណជន មេត្តា ជ្រាប អំពី ករណី ឃាត់ខ្លួន ឈ្មោះ មី សេង ហ៊ ( ហៅ គាវិសាល ) ភេទ ប្រុស អាយុ ៥៩ ឆ្នាំ ជនជាតិ ខ្មែរ បច្ចុប្បន្ន ជា អនុប្រធាន បណ្តោះអាសន្ន គណបក្ស កម្លាំង ជាតិ ខេត្ត កំពង់ចាម ដូចត ទៅ៖
នា ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២៤ សមត្ថកិច្ច ជំនាញ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ទទួល ពាក្យបណ្តឹង ពី ឈ្មោះ ម៉ៃ ហុង សៀង ប្តឹង ម្ចាស់ គណនី ហ្វេសប៊ុក ឈ្មោះ Kea Visal មាន ឈ្មោះ មី សេង ហ៊ ( ហៅ វិសាល ) ភេទ ប្រុស មុខរបរ អនុប្រធាន បណ្ដោះអាសន្ន គណបក្ស កម្លាំង ជាតិ ខេត្ត កំពង់ចាម អាសយដ្ឋាន បច្ចុប្បន្ន នៅ ផ្លូវ បេតុង ភូមិ កោះ ប៉ែន ឃុំ កោះ មិត្ត ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម ។
ក្រោយ ទទួល ពាក្យបណ្តឹង ពី ជនរងគ្រោះ សមត្ថកិច្ច ជំនាញ បាន ធ្វើ ការស្រាវជ្រាវ ប្រមូល ភស្តុតាង ព័ត៌មាន ជាក់លាក់ ពី បទ ញុះញង់ បង្កឲ្យ មាន ការរើសអើង និង ជេរ ប្រមាថ ជាសាធារណៈ និង បាន រាយការណ៍ សុំ គោលការណ៍ ពី អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។
ដោយ ទទួលបាន ការអនុញ្ញាត ពី លោក សេង ហៀង ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ចេញ ដីកា បញ្ជា ឲ្យ ចូល ខ្លួន លេខ ១៧៥ អ. យ.ន ចុះ ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ ពាក់ព័ន្ធ សំណុំរឿង ញុះញង់ បង្កឲ្យ មាន ការរើសអើង និង ជេរ ប្រមាថ ជាសាធារណៈ ហើយ សមត្ថកិច្ច បាន ឃាត់ខ្លួន ឈ្មោះ មី សេង ហ៊ ( ហៅ គា វិសាល ) ភេទ ប្រុស ជនជាតិ ខ្មែរ នៅ ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម ។
បច្ចុប្បន្ន ជនសង្ស័យ សមត្ថកិច្ច ជំនាញ កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ចាត់ការ តាម នីតិវិធី ។ ការឃាត់ខ្លួន នេះ គឺ សមត្ថកិច្ច អនុវត្ត តាម វិធានការ ច្បាប់ ដោយ ពុំ មាន ហេតុផល អ្វី ផ្សេង ពាក់ព័ន្ធ ដល់ គម្រាមកំហែង ឬ បំភិតបំភ័យ ដល់ សកម្មជន គណបក្ស នយោបាយ ណាមួយ ឡើយ ។
អ្នកនាំពាក្យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ សូម បដិសេធ និង ច្រានចោល ទាំងស្រុង ការ ចោទប្រកាន់ ទាំង បំពាន ដោយ គ្មាន ហេតុផល គ្មាន មូលដ្ឋាន ច្បាស់លាស់ របស់ គណបក្ស កម្លាំង ជាតិ ដែល បាន ចុះផ្សាយ កាលពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤៕ កម្ពុជា - ចិន បើក កិច្ចប្រជុំ ពិភាក្សា ការងារ លើ យន្ដ ការសហប្រតិបត្តិការ ផ្លូវ ដែក កម្ពុជា - ចិន
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ ក្នុង គោលបំណង ដើម្បី ជជែក ពិភាក្សា អំពី ការជំរុញ អភិវឌ្ឍ ផ្លូវ ដែក នៅ កម្ពុជា ស្រប តាម ស្មារតី នៃ អនុស្សរណៈ យោគយល់ ស្ដីពី ការបង្កើត យន្តការសហប្រតិបត្តិការ ផ្លូវ ដែក កម្ពុជា - ចិន ដែល បាន ចុះហត្ថលេខា កាលពី ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២៣ ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោកស្រី រដ្ឋលេខាធិការ ប្រចាំ ការ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការជួយគាំទ្រ របស់ ភាគី ចិន ជាពិសេស គណៈកម្មការ ជាតិ អភិវឌ្ឍន៍ និង កែទម្រង់ នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន (NDRC) នៅក្នុង ការរៀបចំ ផែនការអភិវឌ្ឍន៍ ផ្លូវ ដែក នៅ កម្ពុជា និង ស្វាគមន៍ ចំពោះ កិច្ចសហប្រតិបត្តិការ បន្ត និង ការអញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ ព្រះរាជាណាចក្រ កម្ពុជា របស់ គណៈប្រតិភូ និង ជំនាញ ការចិន នា ពេល ខាងមុខ ៕
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ចេញ អនុក្រឹត្យ ស្ដីពី ការរៀបចំ និង ការប្រព្រឹត្ដទៅ របស់ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល
( ភ្នំពេញ ) ៖ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បាន ចេញ អនុក្រឹត្យ ស្ដីពី ការរៀបចំ និង ការប្រព្រឹត្ដទៅ របស់ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល ។ នេះ បើ តាម អនុក្រឹត្យ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ ៕
ខាងក្រោម នេះ ជា អនុក្រឹត្យ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត៖ វេទិកា ប្រព័ន្ធ អេកូឡូស៊ី ធុរកិច្ច ថ្មី រួមចំណែក ជួយ ដល់ សេដ្ឋកិច្ច ជាតិ ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត តាំង ងួន លី នាយក មជ្ឈមណ្ឌល បណ្តុះ ធុរកិច្ច ថ្មី « តេជោ » បាន ថ្លែង បញ្ជាក់ ថា វេទិកា ប្រព័ន្ធ អេកូឡូស៊ី ធុរកិច្ច ថ្មី ឆ្នាំ ២០២៤ ជា វេទិកា មួយ ចូលរួមចំណែក ក្នុង ការជួយ ដល់ សេដ្ឋកិច្ច ជាតិ ឱ្យ កាន់តែ រីកចម្រើន និង ស្រប តាម យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ថ្មី ដែល នៅលើ មុំ ទី៥ បាន និយាយ ពី ការអភិវឌ្ឍ សេដ្ឋកិច្ច ឌីជីថល ។
លោក បណ្ឌិត តាំង ងួន លី ក៏ បាន គូសបញ្ជាក់ ដែរ វេទិកា ប្រព័ន្ធ អេកូឡូស៊ី ធុរកិច្ច ថ្មី ឆ្នាំ ២០២៤ នេះ ធ្វើឡើង ដើម្បី តភ្ជាប់ តួអង្គ ក្នុង ប្រព័ន្ធ អេកូឡូស៊ី ធុរកិច្ច ថ្មី ឱ្យ បាន ជជែក ពី អ្វី ដែល បាន ធ្វើ នា ឆ្នាំ កន្លងមក និង ដាក់ចេញ ទិសដៅ ការងារ ថ្មី ៗ សម្រាប់ ឆ្នាំ ២០២៤ នេះ សំដៅ ធ្វើ យ៉ាងណា ឱ្យ ប្រព័ន្ធ អេកូឡូស៊ី ធុរកិច្ច ថ្មី កាន់តែ ល្អ ប្រសើរ ជាង មុន និង ជា ថ្នាល សម្រាប់ បណ្តុះ ធុរកិច្ច ថ្មី កាន់តែ មាន ចំនួន ច្រើន ឡើង បន្ថែម ទៀត ។
លោក បណ្ឌិត តាំង ងួន លី បាន បន្ថែម ថា វេទិកា ប្រព័ន្ធ អេកូឡូស៊ី ធុរកិច្ច ថ្មី នេះ មាន សារៈសំខាន់ ណាស់ សម្រាប់ តភ្ជាប់ តួអង្គ ក្នុង ប្រព័ន្ធ អេកូឡូស៊ី ដើម្បី បាន ចែករំលែក គ្នា ពី បញ្ហា ដែល ធ្លាប់ ជួបប្រទះ កន្លងមក នឹង ចែករំលែក ព័ត៌មាន ជាមួយគ្នា ទៅ វិញ ទៅ មក ជៀសវាង ធ្វើ ការប្រកួតប្រជែង ជាមួយគ្នា នូវ រឿង ដដែល ៗ ហើយ ងាក មក ធ្វើ ការសម្របសម្រួល ជាមួយគ្នា និង បំពេញ ឱ្យ គ្នា ទៅ វិញ ទៅមក នូវ ចំណុច ខ្វះខាត ឱ្យ គ្នា ដើម្បី ជួយ ឱ្យ អាជីវកម្ម កាន់តែ រីកចម្រើន លូតលាស់ បាន លឿន ផងដែរ ។
របាំ « នាគ ក្នុង ដួងចិត្ត ខ្មែរ » គឺ របាំ ដែល ផ្តោត លើ ភាពបម្លាស់ ទី រេរាំ នៃ សត្វ នាគ . ការបែង ក្រឡា ជា ក្បាច់ សត្វ នាគ ធ្វើដំណើរ ប៉ុន្តែ ការច្នៃ របាំ បុរាណ នេះ ឱ្យ ក្លាយជា របាំ សហសម័យ គេ នឹង ត្រូវ ការ កែសម្រួល ខ្លឹមសារ តិចតួច ទៅ តាម វគ្គ នីមួយ ៗ និង តាម ទំនុក ច្រៀង និង ក្បាច់ រាំ ប៉ុន្តែ នៅតែ រក្សា ភាព ដើម នៃ ដំណើរ របស់ សត្វ នាគ នៃ និមិត្តរូប ឆ្នាំ រោង នៃ ប្រពៃណី ជាតិ ខ្មែរ មិន ប្រែប្រួល ឡើយ ។
របាំ « នាគ ក្នុង ដួងចិត្ត ខ្មែរ » ក្នុង ទម្រង់ របាំ សហសម័យ នឹង ត្រៀម ថត នៅ តាម តំបន់ ប្រាសាទ បុរាណ ខ្មែរ និង តាម ឆ្នេរសមុទ្ទ ដែល នឹង បង្ហាញ ភាពរស់រវើក ពិត នៃ ដួង ព្រលឹង សត្វ នាគ ជាមួយ ក្តី រំពឹង ថា ភាពច្នៃប្រឌិត នេះ នឹង ផ្តល់ នូវ ចំណាប់អារម្មណ៍ ថ្មី ប្លែក និង ក្លាយជា វប្បធម៌ អភិរក្ស ថ្មី មួយ ទៀត នៃ ស្នាដៃ របាំ ខ្មែរ ។
កញ្ញា ថៅ ពេជ្រ អម្រិត បាន ថ្លែង បញ្ជាក់ ទៀត ថា របាំ ច្នៃ មក ទម្រង់ ជា សហសម័យ នេះ នឹង រំពឹង « ជួយ លើកតម្កើង កិត្យានុភាព វប្បធម៌ ខ្មែរ ដែល គេ ល្បី ស្គាល់ រន្ទឺ ថា ជា នគរ នាគរាជ . ជា ពូជ នាគ រាជ និង ជា ពូជសាង អង្គរ តាមរយៈ ការថត ផ្សព្វផ្សាយ ឱ្យ ឃើញ ពី ទិដ្ឋភាព ដ៏ អស្ចារ្យ នៃ តំបន់ ទេសចរណ៍ និង តំបន់ វប្បធម៌ សំខាន់ ៗ ក្នុង ប្រទេស កម្ពុជា » ។
នៅ ព្រឹក ថ្ងៃអាទិត្យ ទី ១៧មីនា ឆ្នាំ ២០២៤. ក្រុម « អប្សរា ២៥ ដួង » នឹង ធ្វើ ពិធី សំពះ គ្រូ តម្លើង ស្នាដៃ និង ក្រុង ពាលី សម្ពោធ ការចេញ ថត ជា ផ្លូវការ នូវ របាំ « នាគ ក្នុង ដួងចិត្ត ខ្មែរ » ក្នុង ទម្រង់ របាំ សហ សម័យ ខ្មែរ ដែល នឹង ពី ធី នេះ នឹង ធ្វើ នៅ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ មុននឹង ការចេញ សម្តែង ថត ជា ផ្លូវការ ជា វីដេអូ ផ្សព្វផ្សាយ ដើម្បី អបអរសាទរ ពិធី បុណ្យ ចូល ឆ្នាំ ខ្មែរ ខាង មុខ នេះ ៕
ពលរដ្ឋ ម្នាក់ ស្នើ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ដង្កោ ជួយ អន្តរាគមន៍ ករណី បាត់បង្កាន់ដៃ ដក អចលន ទ្រព្យ ច្បាប់ ដើម លេខ ៤៦២១ និង លិខិត ផ្ទេរ សិទ្ធិ កាន់កាប់ ប្រើប្រាស់ ដីធ្លី និង ផ្ទះសម្បែង លេខ ៤០២២ ល . ប
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ម្នាក់ ឈ្មោះ លី ហួរ ភេទ ស្រី បាន ស្នើ នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ដង្កោ អន្តរាគមន៍ ករណី បាត់បង្កាន់ដៃ ដក អចលន ទ្រព្យ ច្បាប់ ដើម លេខ ៤៦២១ និង លិខិត ផ្ទេរ សិទ្ធិ កាន់កាប់ ប្រើប្រាស់ ដីធ្លី និង ផ្ទះសម្បែង លេខ ៤០២២ ល. ប ស្ថិត នៅ ភូមិ សំបួរ សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ៕
ខាងក្រោម នេះ ជា លិខិត ស្នើ៖ លោក ប៉េង ពោធិ៍នា ប្រកាស ដាក់ចិត្ត ដាក់ កាយ ជួយ អ្នកស្រុក កោះ ធំ
( កណ្តាល ) ៖ លោក ប៉េង ពោធិ៍នា សមាជិក គណៈ អចិន្ត្រៃយ៍ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន គណៈអចិន្ត្រៃយ៍ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កោះ ធំ ខេត្ត កណ្តាល ប្រកាស ដាក់ចិត្ត ដាក់ កាយ ជួយ អភិវឌ្ឍន៍ និង ជួយ លើកកម្ពស់ ការរស់នៅ របស់ ពលរដ្ឋ ក្នុង ស្រុក កោះ ធំ ឱ្យ កាន់តែ ល្អ ប្រសើរ ។
នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ បន្ទាប់ពី អញ្ជើញ ប្រកាស សមាសភាព ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក ស្អាង រួចរាល់ ហើយ នោះ លោក ប៉េង ពោធិ៍នា បាន បន្ត ដំណើរ មកកាន់ ទីស្នាក់ការ គណបក្ស ប្រជាជន ស្រុក កោះ ធំ ដើម្បី ប្រកាស សមាសភាព ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កោះ ធំ បន្ត ទៀត ។
ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការងារ មូលដ្ឋាន បន្ថែម ទៀត លោក ប៉េង ពោធិ៍នា បាន ស្នើ ក្រុមការងារ យកចិត្តទុកដាក់ អនុវត្ត តួនាទី ភារកិច្ច ដូច មាន ចែង ក្នុង សេចក្តីសម្រេច លេខ ១២/ ២៤ សរ .កក .កណ ស្តីពី ការចាត់តាំង សមាសភាព ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កោះ ធំ ខេត្ត កណ្តាល ជាមួយ ភាព បុរេសកម្ម ប្រកបដោយ ស្មារតី សាមគ្គី និង ទំនួល ខុសត្រូវ ខ្ពស់ ។
លោក ប្រធាន បាន បង្ហាញ សុឆន្ទៈ យ៉ាង មុតមាំ ថា ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា នៃ ក្រុមការងារ គណបក្ស ទាំងអស់ នឹង បន្ត បំពេញ សេចក្តីត្រូវការ របស់ ប្រជាពលរដ្ឋ ឱ្យ បានជា អតិបរមា ពិសេស គឺ បន្ត ដំណើរ តាម មាគ៌ា ដ៏ ត្រឹមត្រូវ របស់ គណបក្ស ប្រជាជន កម្ពុជា បន្ត ទៀត ដើម្បី រួមគ្នា ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍ ប្រទេសជាតិ ឱ្យ មាន ការរីកចម្រើន ទាំង ក្នុង អាណត្តិ ទី៧ ក៏ ដូចជា អាណត្តិ ជា បន្តបន្ទាប់ ទៀត ផងដែរ ៕
មន្ត្រី ក្រសួង សេដ្ឋកិច្ច៖ យន្តការ ភាពជាដៃគូរ វាង រដ្ឋ និង ឯកជន (PPP) ដើរ តួនាទី យ៉ាង សំខាន់ បំពេញ បន្ថែម តម្រូវការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ និង ការផ្តល់ សេវា សាធារណៈ
១៖ ការប្រើប្រាស់ ទុន វិនិយោគ ពី ដៃគូ ឯកជន៖ យន្តការ នេះ អនុញ្ញាតឱ្យ ភាគី រដ្ឋ អាច គៀង គរ ធនធាន ពី វិស័យ ឯកជន ដើម្បី ផ្តល់ ហិរញ្ញប្បទាន សម្រាប់ អភិវឌ្ឍ គម្រោង ហេដ្ឋារចនាសម្ព័ន្ធ សាធារណៈ ដោយសារ គម្រោង ទាំងនោះ ភាគ ច្រើន មាន ទំហំ ទុន វិនិយោគ ធំ ស្រប ពេល ដែល ធនធាន របស់ វិស័យ សាធារណៈ មាន កំណត់ ។
២៖ ប្រសិទ្ធភាព និង ន វានុវត្ត ន៍៖ ជាធម្មតា សម្រាប់ យន្តការ PPP ដៃគូ ឯកជន នាំមក នូវ ន វានុវត្តន៍ ជំនាញ និង ប្រសិទ្ធភាព ពាក់ព័ន្ធ នឹង ការរចនា ប្លង់ . ការសាងសង់ និង ការធ្វើ ប្រតិបត្តិការ គម្រោង ដែល អាច ជួយ សន្សំ សំចៃ ថ្លៃ ទុន វិនិយោគ និង លើកកម្ពស់ គុណភាព សេវា សាធារណៈ ។
៣៖ ការចែករំលែក ហានិភ័យ៖ មាន ការបែងចែក ហានិភ័យ រវាង ភាគី រដ្ឋ និង ដៃគូ ឯកជន ដោយ ភាគី ដែល អាច គ្រប់គ្រង ហានិភ័យ បាន ល្អ បំផុត មាន ភារៈ ទទួលបន្ទុក នូវ ហានិភ័យ នោះ តាម ការបែងចែក នៅក្នុង កិច្ចសន្យា PPP ។
៤៖ ការអនុវត្ត គម្រោង អាច ប្រព្រឹត្តទៅ បាន លឿន៖ ការចូលរួម របស់ ដៃគូ ឯកជន អាច ពន្លឿន ដំណើរការ គម្រោង តាម កាលវិភាគ ច្បាស់លាស់ ដែល អាច ឱ្យ សាធារណជន ទទួលបាន ការប្រើប្រាស់ ហេដ្ឋារចនាសម្ព័ន្ធ និង សេវា សាធារណៈ កាន់តែ ឆាប់រហ័ស ។
៥៖ សេវា សាធារណៈ ដែល ប្រសើរ ជាង មុន៖ តាមរយៈ យន្តការ PPP នេះ ភាគី រដ្ឋ អាច កែលម្អ គុណភាព និង លទ្ធភាព ទទួលបាន នូវ សេវា សាធារណៈ មួយចំនួន មាន ដូចជា ការថែទាំ សុខភាព . ការអប់រំ និង ការដឹកជញ្ជូន ជាដើម ។
ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី ផ្តល់ បទ ឧទ្ទេសនាម លើ ប្រធានបទ « ភាពជា អ្នកដឹកនាំ ន វានុវត្តន៍ និង គុណាធិបតេយ្យ ក្នុង រដ្ឋបាល សាធារណៈ » ក្នុង វគ្គ អប់រំនយោបាយ របស់ គណបក្ស កម្រិត ២ ជំនាន់ ទី ៧
នៅក្នុង បាឋ កថា ឧប នាយក រដ្ឋមន្ត្រី ហ៊ុន ម៉ានី បាន បែងចែក ជា ពីរ ផ្នែក សំខាន់ ៗ ជាពិសេស ដែល ផ្តោត សំខាន់ ទៅ លើ ភាព អ្នកដឹកនាំ ទូទៅ ក៏ ដូចជា អ្នកដឹកនាំ តាមរយៈ ភាព ជា គំរូ របស់ គណបក្ស ប្រជាជន កម្ពុជា ក៏ ដូចជា ភាព គំរូ របស់ សម្តេច តេជោ ។
ក្នុង ផ្នែក ទី២ បន្ថែម ទៀត នោះ ឧប នាយក រដ្ឋមន្ត្រី បាន ចែករំលែក នូវ កិច្ចការងារ កែទម្រង់ រដ្ឋបាល សាធារណៈ ដែល ក្នុង នាម ក្រសួង មុខងារ សាធារណៈ ជា សេនាធិការ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ប្រែក្លាយ ទស្សនៈ វិស័យ របស់ សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី ក្លាយជា សមិទ្ធកម្ម ពិតប្រាកដ ។
ជាក់ស្តែង ឧប នាយក រដ្ឋមន្ត្រី ហ៊ុន ម៉ានី បាន លើកឡើង អំពី សមិទ្ធផល មួយចំនួន ដែល ក្រសួង មុខងារ សាធារណៈ សម្រេចបាន ក្នុង នោះ រួម មាន៖ ការប្រឡង ជ្រើសរើស មន្ត្រីរាជការ ក្នុង បរិបទ ថ្មី ដោយ ឈរ លើ គោលការណ៍ គុណាធិបតេយ្យ តម្លាភាព បរិយា បន្ន ប្រសិទ្ធភាព រួម ជាមួយនឹង ការរៀបចំ នូវ និយាម នីតិវិធី ប្រតិបត្តិ ក៏ ដូចជា ការរៀបចំ នូវ វិធាន គន្លឹះ ផ្សេង ៗ ទៀត ដែល គាំទ្រ ទៅដល់ ការងារ កែទម្រង់ រដ្ឋបាល សាធារណៈ ជាពិសេស កម្មវិធី គន្លឹះ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
បន្ទាប់ពី បទ ឧទ្ទេសនាម ទាំង ពីរ ផ្នែក របស់ លោក ឧប នាយក រដ្ឋមន្ត្រី សិក្ខាកាម ក៏ បាន ផ្តល់ ឱកាស ឲ្យ សួរ សំណួរ និង ជជែក ពិភាក្សា វែកញែក ជាច្រើន ដើម្បី ផ្តល់ ជា ពុទ្ធិ និង ចំណេះដឹង ជូន គ្នា ទៅ វិញ ទៅមក ប្រកបដោយ ភាតរភាព ៕ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៧៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១៥ ខែមីនា ម្សិលមិញ
