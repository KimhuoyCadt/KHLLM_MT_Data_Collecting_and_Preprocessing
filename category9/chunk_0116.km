( ភ្នំពេញ )៖ គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា សហការ ជាមួយ សមាគម គ្រូបង្រៀន ខ្មែរ ឥស្លាម កម្ពុជា រៀបចំ មហាសន្និបាត បូកសរុប ការងារ អប់រំ ឥស្លាម ២០១៥ - ២០២៣ និង លើក ទិសដៅ ការងារ បន្ត ក្រោម ប្រធានបទ « កំណែទម្រង់ វិស័យ អប់រំ ឥស្លាម ក្នុង បរិបទ ឌីជីថល » នៅ ព្រឹក ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២៤ ។
ពិធី នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម គ្រូបង្រៀន ខ្មែរ ឥស្លាម និង អ្នក ឧកញ៉ា សុះ កំរ៉ី ចាងហ្វាង គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា ដោយ សន្និបាត នេះ ធ្វើឡើង ចាប់ពី ថ្ងៃទី៥ ដល់ ទី៦ ខែមីនា ឆ្នាំ ២០២៤ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ (NIE) ។
ថ្លែង ក្នុង ពិធី បើក មហាសន្និបាត លោក បណ្ឌិត អូស្មាន ហាស្សាន់ បាន សម្ដែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ថ្នាក់ដឹកនាំ ទាំងអស់ នៃ គណៈដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា និង ថ្នាក់ដឹកនាំ នៃ ក្រសួង អប់រំ យុវជន និង កីឡា មន្ទី អប់រំ យុវជន និង កីឡា ខេត្ត និង ថ្នាក់ដឹកនាំ ឥស្លាម គ្រប់ លំដាប់ថ្នាក់ ព្រមទាំង គ្រូបង្រៀន ខ្មែ ឥស្លាម ដែល បាន បំពេញ ការងារ យ៉ាង សកម្ម ដើម្បីឲ្យ សិស្ស និស្សិត ខ្មែរ ឥស្លាម ទទួលបាន លទ្ធផល សិក្សា ល្អ ប្រកបដោយ ចំណេះ និង ជំនាញ ពិតប្រាកដ និង ច្បាស់លាស់ ។
ទន្ទឹម គ្នា នេះ ដែរ លោក ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ អង្គការ ជាតិ និង អន្តរជាតិ វិស័យ ឯកជន និង សប្បុរសជន ក្នុង និង ក្រៅ ប្រទេស ដែល បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការស្ដារ អភិវឌ្ឍ វិស័យ អប់រំ ឥស្លាម នៅ កម្ពុជា ឲ្យ រីកចម្រើន ដូច សព្វ ថ្ងៃ ។
លោក បាន បន្ថែម ថា សហគមន៍ ឥស្លាម កម្ពុជា មាន ភ័ព្វសំណាង ខ្ពស់ ដោយ បាន រួមរស់ ក្រោម ដំបូល សុខ សន្តិភាព សុខដុមរមនា មាន សិទ្ធិ និង កាតព្វកិច្ច ដូច ប្រជាពលរដ្ឋ ទូទៅ គ្មាន ការរើសអើង ជាពិសេស មាន សិទ្ធិ សេរីភាព ក្នុង ការប្រតិបត្តិ សាសនា ក្រោម ការដឹកនាំ ប្រកប ដោយ គតិបណ្ឌិត របស់ សម្ដេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី និង បន្ត មក សម្ដេច មហា បវធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
ជាមួយគ្នា នោះ អ្នក ឧកញ៉ា សុះ កំរុី ចាងហ្វាង នៃ គណៈដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា មាន សេចក្ដីសោមនស្ស រីករាយ យ៉ាង ក្រៃលែង ដែល នេះ ជា លើក ទី១ នៃ សហគមន៍ ខ្មែ ឥស្លាម នៅ កម្ពុជា ដែល បាន រៀបចំ ឲ្យ មាន មហាសន្និបាត បូកសរុប ការងា អប់រំ ឥស្លាម ឆ្នាំ ២០១៥ - ២០២៣ និង លើក ទិសដៅ ការងារ បន្ត ដ៏ មាន សារៈសំខាន់ នេះ ឡើង ។
អ្នកឧញ៉ា បាន បន្ត ទៀត ថា បន្ទាប់ពី កម្ពុជា ទទួលរង នូវ ការបំផ្លិចបំផ្លាញ ទាំងស្រុង នូវ របប ប្រល័យ ពូជសាសន៍ កម្ពុជា បាន បាត់បង់ នូវ ធនធាន មនុស្ស ជាពិសេស ប្រព័ន្ធ អប់រំ ដែល ជា សសរ ទ្រូង ប្រទេសជាតិ ។ គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការបណ្ដុះបណ្ដាល និង បង្កើត ធនធាន មនុស្ស ដែល ជា ចំណែក អភិវឌ្ឍន៍ សង្គមជាតិ ។
ខាងក្រោម នេះ ជា សារាច រ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ ប្រារព្ធ ពិធី អបអរសាទរ ខួប លើក ទី ១១៣ ទិវា អន្តរជាតិ នារី ៨ មីនា ក្រោម មូល បទ « ស្ត្រី និង ក្មេងស្រី ក្នុង បរិវត្តកម្ម ឌីជីថល »
( ភ្នំពេញ ) ៖ លោក ម៉ប់ សារិន ប្រធាន ក្រុមប្រឹក្សា និង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ដឹកនាំ រៀប ពិធី អបអរសាទរ ខួប លើក ទី ១១៣ ទិវា អន្តរជាតិ នារី ៨ មីនា ឆ្នាំ ២០២៤ ក្រោម ប្រធានបទ « ស្ត្រី និង ក្មេងស្រី ក្នុង បរិវត្តកម្ម ឌីជីថល » នា ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
លោក អភិបាល រាជធានី ភ្នំពេញ បាន បន្ត ថា សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត ជានិច្ចកាល តែង គាំទ្រ លើកកម្ពស់ និង ជំរុញ នារី កម្ពុជា ឲ្យ ចូលរួម ក្នុង សកម្មភាព អភិវឌ្ឍ ជាតិ មាតុភូមិ តាមរយៈ ការបង្កើន ចំនួន ស្ត្រី ជា មន្ត្រីរាជការ ស៊ីវិល កងកម្លាំងប្រដាប់អាវុធ និង មន្ត្រី មុខងារ សាធារណៈ ក្នុង មុខ តំណែង ជា ថ្នាក់ដឹកនាំ ក្រសួង - ស្ថាប័ន រាជធានី - ខេត្ត ក្រុង - ស្រុក - ខណ្ឌ ឃុំ - សង្កាត់ និង មន្ទីរ - អង្គភាព គ្រប់ លំដាប់ថ្នាក់ ។
នារី ក្នុង រចនាសម្ព័ន្ធ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន សហការ ចូលរួម ជ្រោមជ្រែង បំពេញ ភារកិច្ច ជូន ជាតិ មាតុភូមិ ពី ដំណាក់កាល មួយ ទៅ ដំណាក់កាល មួយ ជាពិសេស ការផ្តល់ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ក្នុង ដែន សមត្ថកិច្ច ដោយ មិន ខ្លាច នឿយហត់ និង បាន ចូលរួមចំណែក ជាច្រើន ក្នុង សកម្មភាព សង្គម សកម្មភាព មនុស្សធម៌ និង ការអភិវឌ្ឍ រាជធានី ភ្នំពេញ រហូត ទទួលបាន ជោគជ័យ យ៉ាង ធំធេង ជា បន្តបន្ទាប់ ។
បើ តាម លោក ឃួង ស្រេង . បច្ចុប្បន្ន នេះ នារី នៅតែ ជា ដៃគូរ មិន អាច ខ្វះ បាន និង បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ដំណើរការអភិវឌ្ឍ ជាតិ មាតុភូមិ ។ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន ចូលរួមចំណែក លើកកម្ពស់ សិទ្ធិ នារី និង កុមារ យ៉ាង សំខាន់ ក្នុង ការទប់ស្កាត់ អំពើហិង្សា ក្នុង គ្រួសារ ការធ្វើ អាជីវកម្ម ផ្លូវភេទ លើ ស្ត្រី និង កុមារ ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ការយកចិត្ត ទុកដាក់ លើ ទុរគត ជន - ក្មេង កំព្រា និង ការប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ព្រមទាំង សកម្មភាព មនុស្សធម៌ ជាច្រើន ទៀត ។
នៅ សាលា រាជធានី ភ្នំពេញ មាន មន្ត្រីរាជការ ក្របខ័ណ្ឌ សរុប ចំនួន ២៩៧ រូប ក្នុង នោះ៖ នារី មាន ចំនួន ១០៣ រូប ស្មើនឹង ៣៤. ៧% កំពុង កាន់ មុខតំណែង ជា សមាជិកា ក្រុមប្រឹក្សា រាជធានី អភិបាល រង រាជធានី នាយក រង រដ្ឋបាល អនុប្រធាន ការិយាល័យ ប្រជាពលរដ្ឋ នាយិកា - នាយិការង ទី ចាត់ការ - អង្គភាព និង ថ្នាក់ ការិយាល័យ ដោយ បាន បំពេញ ការងារ និង ទទួលខុសត្រូវ លើ ការដឹកនាំ អង្គភាព គ្រប់គ្រង រដ្ឋបាល ជំនាញ បច្ចេកទេស និង ជា ប្រតិបត្តិករ ជួរ មុខ ក្នុង ការផ្តល់ សេវា សាធារណៈ ជូន ដល់ ប្រជាពលរដ្ឋ យ៉ាង សកម្ម បំផុត ។
សូម ជម្រាប ថា នារី បម្រើ ការងារ នៅ សាខា កាកបាទ ក្រហម កម្ពុជា រាជធានី ភ្នំពេញ . នៅ មន្ទីរ បក្ស រាជធានី និង នៅ សាលា រាជធានី សរុប ចំនួន ២៦៥ នាក់ ដែល ចូលរួម ក្នុង កម្មវិធី នេះ ទទួលបាន ប្រាក់ ឧបត្ថម ពី លោក ឃួង ស្រេង អភិបាល រាជធានី ដោយ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា ចំនួន ៤០ ម៉ឺន រៀល ៕ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ក្រើន រំលឹក កងទ័ព បន្ត ចូលរួម ថែរក្សា សន្តិភាព គាំទ្រ កម្មវិធី នយោបាយ របស់ រដ្ឋាភិបាល និង ស្មោះត្រង់ ចំពោះ ជាតិ សាសនា ព្រះមហាក្សត្រ
( កណ្តាល ) ៖ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ បាន ក្រើន រំលឹក ដល់ កងទ័ព ត្រូវ បន្ត ចូលរួម ថែរក្សា សន្តិភាព គាំទ្រ អនុវត្ត រាល់ កម្មវិធី នយោបាយ របស់ រាជ រដ្ឋាភិបាល ត្រូវ ស្មោះត្រង់ ចំពោះ ជាតិ សាសនា ព្រះមហាក្សត្រ និង ស្មោះត្រង់ ចំពោះ រាជ រដ្ឋាភិបាល ដែល ប្រសូត្រ ចេញពី ការបោះឆ្នោត ដែល ដឹកនាំ ដោយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ព្រមទាំង ទប់ស្កាត់ រាល់ ឧបាយកល បំផ្លាញ សុខ សន្តិភាព របស់ ប្រទេសជាតិ ឱ្យ បាន ជាដាច់ខាត ។
ការបន្ត ក្រើន រំលឹក បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព បិទ វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ បំភ័ន្តអក្ខរៈ ជំនាន់ ទី២ ឆ្នាំ ២០២៣ នៅ សាលា បំភ័ន្តអក្ខរៈ ស្ថិត នៅ សង្កាត់ ស្វាយរលំ ក្រុង តាខ្មៅ ខេត្ត កណ្តាល នា ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
នា ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ពាំនាំ នូវ ការ សួរសុខទុក្ខ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា . នាយ ឧត្ដមសេនីយ៍ ទៀ សីហា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ . នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ ជូន ចំពោះ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ ទី ចាត់ការ និង សាលា បំភ័ន្តអក្ខរៈ អគ្គ បញ្ជាការដ្ឋាន ជាពិសេស សិក្ខាកាម វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ បំភ័ន្តអក្ខរៈ ជំនាន់ ទី២ ឆ្នាំ ២០២៣ ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ សូម កោតសរសើរ ដ៏ ស្មោះ ចំពោះ ថ្នាក់ដឹកនាំ ទី ចាត់ការ និង សាលា បំភ័ន្តអក្ខរៈ ព្រមទាំង បណ្តា ស្ថាប័ន ដែល មាន ការពាក់ព័ន្ធ ដែល បាន ខិតខំ យកចិត្តទុកដាក់ ពង្រឹង ពង្រីក ស្ថាប័ន បំភ័ន្តអក្ខរៈ ឆ្លើយតប ទៅនឹង សេចក្តីត្រូវការ លើ ការការពារ សម្ងាត់ ព័ត៌មាន យោធា ដើម្បី បម្រើ ឱ្យ រាល់ សកម្មភាព និង ការទំនាក់ទំនង ទាំងឡាយ ក្នុង កងទ័ព ជាពិសេស សកម្មភាព នៃ ប្រតិបត្តិការ របស់ បណ្តា កង ឯកភាព ទូទាំង កងយោធពល ខេមរភូមិន្ទ ។
នាយ ឧត្តមសេនីយ៍ បាន បន្ត ថា វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ បំភ័ន្តអក្ខរៈ ជំនាន់ ទី២ ឆ្នាំ ២០២៣ គឺជា ការកសាង សមត្ថភាព កងយោធពល ខេមរភូមិន្ទ ឱ្យ មាន លទ្ធភាព គ្រប់គ្រាន់ ក្នុង ការបំពេញ ភារកិច្ច ក្នុង កិច្ចការងារ ការពារ សម្ងាត់ ព័ត៌មាន យោធា ជាពិសេស ឱ្យ មាន សមត្ថភាព ចំណេះដឹង ចំណេះ ធ្វើ ក្នុង ការបំពេញ តួនាទី ភារកិច្ច របស់ ខ្លួន ។
បន្ថែម ពី នេះ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ណែនាំ ដល់ កងទ័ព ត្រូវ ខិតខំ ពង្រឹង កសាង សមត្ថភាព និង កាយសម្បទា របស់ យោធិន ម្នាក់ ៗ ព្រមទាំង អប់រំ សតិអារម្មណ៍ ឱ្យ យោធិន ទាំងអស់ មាន ការគោរព វិន័យ គោរព បទបញ្ជា គោរព ច្បាប់ របស់ រដ្ឋ ជាពិសេស ស្មោះត្រង់ ចំពោះ រាជ រដ្ឋាភិបាល ចំពោះ មេបញ្ជាការគ្រប់ ថ្នាក់ ហើយ ត្រូវ ប្រឆាំង រាល់ ឧបាយកល គ្រប់ បែបយ៉ាង របស់ ពួក អគតិ និង ជ្រុលនិយម ដែល បំផ្លិចបំផ្លាញ សុខ សន្តិភាព របស់ ប្រទេសជាតិ ។
នាយ ឧត្តមសេនីយ៍ បាន បន្ថែម ថា កងទ័ព ត្រូវ លើកកម្ពស់ ស្មារតី គោរព បទបញ្ជា វិន័យ និង សីលធម៌ សេចក្តីថ្លៃថ្នូរ ឱ្យ សាកសម ជា យោធិន នៃ កងយោធពល ខេមរភូមិន្ទ ហើយ ត្រូវ ខិតខំ រៀនសូត្រ បន្ត ពី រៀមច្បង និង ជៀស ឱ្យ ផុត ពី គ្រឿងញៀន និង មិន ធ្វើ អ្វី ដែល ខុសពី ច្បាប់ លក្ខន្តិកៈ នៃ កងយោធពល ខេមរភូមិន្ទ ហើយ ទោះបី ការរៀនសូត្រ បាន បញ្ចប់ វគ្គ រួចហើយ តែ ក៏ ត្រូវ ខិតខំ ស្វែងយល់ រៀនសូត្រ បន្ត ទៀត ដោយ ខ្លួន ឯង ដើម្បី ពង្រីក ចំណេះដឹង របស់ ខ្លួន បន្ថែម ទៀត ។
ទន្ទឹមនឹង នេះ ដែរ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន បញ្ជាក់ ថា កងទ័ព ត្រូវ ខិតខំ បំពេញ ភារកិច្ច តាម ជំនាញ រៀង ៗ ខ្លួន ហើយ ត្រូវ ស្រឡាញ់ ជំនាញ និង តួនាទី របស់ ខ្លួន មាន ស្មារតី ច្នៃប្រឌិត ថែរក្សា គ្រប់គ្រង ឯកសារ សម្ភារ ជំនាញ ជៀសវាង ការបាត់បង់ និង ត្រូវ រក្សា ការសម្ងាត់ ឱ្យ បាន ជាដាច់ខាត ព្រមទាំង ការបញ្ជូន រាល់សារ ទូរលេខ នានា ឱ្យ បាន ទាន់ ពេលវេលា ពីព្រោះថា ការរក្សា បាន ការ សម្ងាត់ និង ការបញ្ជូន សារ ឱ្យ ទាន់ ពេលវេលា ក៏ ជា កត្តា រួម ចំណែក ទទួលបាន ជ័យជំនះ គ្រប់ ភារកិច្ច ៕
ការពិនិត្យ ឡើងវិញ ដែល អាចនឹង ដក ចេញ នូវ ការរឹតត្បិត ចំពោះ ក្រុម អ្នកបើកបរ រថយន្ត ដឹក ទំនិញ រវាង អ៊ុយក្រែន និង សហភាព អឺរ៉ុប គឺ ស្ថិត ក្នុង ចំណោម ការទាមទារ សំខាន់ ៗ របស់ ក្រុម អ្នក ដឹក ទំនិញ ប៉ូឡូញ ដែល ធ្វើ ការតវ៉ា អស់ រយៈពេល ជាច្រើន សប្តាហ៍ មក ទល់ នឹង ដើម ឆ្នាំ នេះ ។
ក្រសួង ហេដ្ឋារចនាសម្ព័ន្ធ ប៉ូឡូញ បាន ចេញ សេចក្តីថ្លែងការណ៍ ថា « គណៈកម្មាការ អឺរ៉ុប បាន ចាប់ផ្តើម នីតិវិធី កែសម្រួល លើ កិច្ចព្រមព្រៀង ស្តីពី ការដឹកជញ្ជូន តាម ផ្លូវគោក សហភាព អឺរ៉ុប - អ៊ុយក្រែន នេះ ហើយ » ។ បើ តាម លោក រដ្ឋមន្រ្តី Dariusz Klimczak នៃ ក្រសួង ហេដ្ឋារចនាសម្ព័ន្ធ ប៉ូឡូញ សំណើរ ផ្លាស់ប្តូរ នៅក្នុង កិច្ចព្រមព្រៀង ត្រូវ បញ្ជូន ទៅកាន់ ប្រទេស ជា សមាជិក សម្រាប់ ការចរចា បន្ថែម ទៀត ។
ក្រៅតែ ពី ចូលរួម ក្នុង ពិធី ទាំង ពីរ ខាងលើ នេះ លោកជំទាវ បណ្ឌិត បាន អញ្ជើញ ពិសារ អាហារ ថ្ងៃត្រង់ រៀបចំ និង ស្វាគមន៍ ដោយ លោកជំទាវ Jodie Haydon ភរិយា នាយក រដ្ឋមន្ត្រី អូស្ត្រាលី ផងដែរ ៕ រដ្ឋបាល ខេត្ត កំពង់ចាម បើក យុទ្ធនាការ តេស្ត រក សារធាតុ ញៀន លើ មន្ត្រីរាជការ ជិត២.០០០ នាក់ នៃ ចំនួន ៣៥មន្ទីរ - អង្គភាព
( កំពង់ចាម ) ៖ រដ្ឋបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន បើក យុទ្ធនា ការធ្វើតេស្ត រក សារធាតុ ញៀន លើ មន្ត្រីរាជការ ប្រមាណ ជិត២.០០០ នាក់ នៃ មន្ទីរ - អង្គភាព ជុំវិញ ខេត្ត ។
នាយក រដ្ឋបាល សាលា ខេត្ត កំពង់ចាម លោក ឃ ន ប្រុស បាន ថ្លែង ថា ដោយ អនុវត្ត តាម បទបញ្ជា លេខ ០១ប ប ចុះ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០២៤ របស់ រាជដ្ឋាភិបាល កម្ពុជា ស្តីពី ការដាក់ចេញ វិធានការ ម៉ឺងម៉ាត់ ក្នុង ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ នៅ តាម ក្រសួង ស្ថាប័ន និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
លោក បញ្ជាក់ ថា ថ្ងៃ នេះ រដ្ឋបាល ខេត្ត បាន រៀបចំ ធ្វើតេស្ត ដល់ មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា ដើម្បី ចូលរួមចំណែក ធានា ប្រសិទ្ធភាព នៃ ការអនុវត្ត យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ លើក ទី៩ ដែល ជា អាទិភាព នយោបាយ របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ការលើកកម្ពស់ ជំនឿ ទុកចិត្ត ប្រសិទ្ធភាព ការងារ និង អភិបាលកិច្ច ល្អ នៅក្នុង ស្ថាប័ន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ។
លោក បាន បន្ដ ថា មាន មន្ត្រីរាជការ តាម មន្ទីរ អង្គភាព ក្នុង ខេត្ត កំពង់ចាម រួម មាន សមាជិក ក្រុមប្រឹក្សា ខេត្ត មន្ត្រីរាជការ សាលា ខេត្ត មន្ត្រី មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង មន្ត្រី ជាប់ កិច្ចសន្យា សរុប ចំនួន ១. ៩៦៧ នាក់ ស្រី ៧៣៧ នាក់ មកពី ៣៥ មន្ទីរ អង្គភាព ដែល ត្រូវ ធ្វើតេស្ត រក សារធាតុ ញៀន នៅ ថ្ងៃទី ០៦ ខែមីនា ឆ្នាំ ២០២៤ ដោយ បែងចែក ជា ២វេន ( ព្រឹក - ល្ងាច ) ។
សូម ជម្រាប ថា អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ឲ្យដឹង ថា នៅ ជំហាន ដំបូង នេះ រដ្ឋបាល ខេត្ត បាន ទទួល ឧបករណ៍ សម្រាប់ ធ្វើតេស្ត ចំនួន ៥.០០០ ឧបករណ៍ ដូច្នេះ ត្រូវ បើក យុទ្ធនា ការធ្វើតេស្ត រក សារធាតុ ញៀន ទៅ លើ មន្ត្រីរាជការ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត រដ្ឋបាល ក្រុង ស្រុក ឃុំ សង្កាត់ និង សមាជិក ភូមិ និង ដំណាក់កាល ទី២ និង ឈាន ទៅដល់ ការធ្វើតេស្ត ក្រុម គ្រូបង្រៀន និង ក្រុម គ្រូពេទ្យ សរុប ទាំងអស់ ប្រមាណ ២ម៉ឺន នាក់ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ទៀត ថា មន្ត្រីរាជការ ក្នុង ខេត្ត ត្រូវតែ ចូលរួម ធ្វើតេស្ត ទាំងអស់ គ្នា ដើម្បី បញ្ជាក់ នូវ ភាព ស្អាតស្អំ ភាពត្រឹមត្រូវ ក៏ ដូចជា បញ្ជាក់ ពី ការចូលរួម គាំទ្រ យុទ្ធនាការ នេះ ផងដែរ ដើម្បី អនុវត្ត ទៅ ទទួលបាន ជោគជ័យ ៕
គួរ បញ្ជាក់ ថា ភាគ ច្រើន នៃ សម្ព័ន្ធមិត្ត អឺរ៉ុប របស់ បារាំង និយាយ ថា ពួកគេ នឹង មិន បញ្ជូន កងទ័ព ទៅ អ៊ុយក្រែន ទេ ក្រោយ ការអត្ថាធិប្បាយ ថ្ងៃទី ២៦ កុម្ភៈ របស់ លោក ម៉ាក្រុង អំពី លទ្ធភាព បញ្ជូន កងទ័ព លោក ខាងលិច ទៅ ជួយ អ៊ុយក្រែន ៕
រយៈពេល ២ខែ ឆ្នាំ ២០២៤ នេះ រដ្ឋាភិបាល បាន ឧបត្ថម្ភ មូលនិធិ នៃ មន្ទីរពេទ្យ គន្ធ បុប្ផា កម្ពុជា បាន ចំនួន សរុប ៤៧១. ៧០០ ដុល្លារ អាមេរិក ពី ចំណែក នៃ ការលក់ បណ្ណ ជូន ភ្ញៀវ ទេសចរ បរទេស ចូល ទស្សនា រមណីយ អង្គរ ដើម្បី ជួយ ក្នុង មូលនិធិ សម្រាប់ សង្គ្រោះ ជីវិត កុមារ កម្ពុជា ។
សូម អាន សេចក្ដីប្រកាស ព័ត៌មាន របស់ គ្រឹះស្ថាន អង្គរ ទាំង ស្រុង៖ រដ្ឋបាល ខណ្ឌ ដូនពេញ ដង្ហែ ក្បួន អបអរសាទរ ក្រោយ ទទួលបាន ពានរង្វាន់ ទីក្រុង ទេសចរណ៍ ស្អាត អាស៊ាន លើក ទី ១២
( ភ្នំពេញ ) ៖ លោក ហែម អាន ប្រធាន ក្រុមប្រឹក្សា ខណ្ឌ ដូនពេញ និង លោក ជា ខេមា អភិបាល ខណ្ឌ ដូនពេញ នា ព្រឹក ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២៤ បាន ដឹកនាំ មន្ត្រីរាជការ កងកម្លាំង សមត្ថកិច្ច អាជ្ញាធរ ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ចូលរួម ដង្ហែ ក្បួន អបអរសាទរ ខណ្ឌ ដូនពេញ ទទួលបាន ពានរង្វាន់ ទីក្រុង ទេសចរណ៍ ស្អាត អាស៊ាន លើក ទី៤ នៅ តាម បណ្តោយ ផ្លូវ មាត់ ទន្លេ ព្រះស៊ីសុវត្ថិ ចាប់ពី មុខ ព្រះបរម រាជ វាំង មកដល់ រមណីយដ្ឋាន ប្រវត្តិសាស្រ្ត វត្តភ្នំ សរុប ចំនួន ប្រមាណ ៣. ៥០០ នាក់ ។
គួរ ជម្រាប ថា ក្រុង និង ខណ្ឌ ចំនួន ៣ របស់ កម្ពុជា ទទួលបាន ជ័យលាភី ទីក្រុង ស្អាត អាស៊ាន លើក ទី៤ ដែល មាន សុពលភាព ឆ្នាំ ២០២៤ - ២០២៦ រួម មាន៖ ក្រុង កែប ក្រុង កំពត និង ខណ្ឌ ដូនពេញ ។
ការអនុស្សរណៈ នេះ បាន បង្ហាញ ពី កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា ដើម្បី គាំទ្រ ការដោះស្រាយ បញ្ហា មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម នៅ កម្ពុជា ជាពិសេស ការកសាង សមត្ថភាព ថ្នាក់ ជាតិ ប្រកបដោយ និរន្តរភាព ក្នុង ការគ្រប់គ្រង ហានិភ័យ សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ដែល ស្ថាប័ន ទាំង ពីរ អាជ្ញាធរ មីន និង GICHD បាន បង្កើត ភាពជាដៃគូរយៈពេល ជាង មួយ ទសវត្សរ៍ និង បាន ប្តេជ្ញាចិត្ត រួម ក្នុង គោលការណ៍ នៃ សកម្មភាព មនុស្សធម៌ សិទ្ធិ មនុស្ស និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
ទេសរដ្ឋមន្រ្តី លី ធុជ ជឿជាក់ ថា អាជ្ញាធរ មីន និង GICHD នឹង បោះជំហាន ទៅ មុខ យ៉ាង សំខាន់ ឆ្ពោះ ទៅរក ប្រទេស កម្ពុជា រួចផុត ពី ការគំរាម ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម និង ធ្វើឲ្យ សហគមន៍ ទាំងអស់ មាន ការរីកចម្រើន ប្រកបដោយ សុវត្ថិភាព និង វិបុលភាព ។ ជាមួយគ្នា នោះ ការប្តេជ្ញាចិត្ត នេះ គឺជា កិច្ចការ រួមគ្នា ឈាន ឆ្ពោះ ទៅរក អនាគត មួយ ដែល ពិភពលោក គ្មាន ការគំរាម ពី គ្រាប់ មីន ។
ក្នុង ពិធី នោះ ផងដែរ ទេសរដ្ឋមន្រ្តី លី ធុជ បាន លើកឡើង អំពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ កម្ពុជា ក្នុង ការដោះស្រាយ បញ្ហា មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ។
លោក ថា ចាប់តាំងពី ឆ្នាំ ១៩៩២ ដល់ ឆ្នាំ ២០២៣ ក្រោម ការដឹកនាំ ដ៏ ប៉ិនប្រសប់ របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី កម្ពុជា បាន រដោះ ផ្ទៃដី មាន មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ចំនួន ៣០២៤ គីឡូម៉ែត្រ ក្រឡា ក្នុង នោះ រួមទាំង តំបន់ មាន គ្រាប់បែក ចង្កោម ។ ទោះបី មាន កិច្ចខិតខំ ប្រឺង ប្រែង និង មាន ការរួមចំណែក ពី GICHD ក៏ដោយ កម្ពុជា នៅសល់ ផ្ទៃដី មាន មីន ចំនួន ៥៣៣ គីឡូម៉ែត្រ ក្រឡា និង ១.៣២១ គីឡូម៉ែត្រ ក្រឡា នៃ សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម រួមទាំង គ្រាប់បែក ចង្កោម ដែល ត្រូវ បន្ត ដោះស្រាយ ។
ទេសរដ្ឋមន្រ្តី លី ធុជ បាន បន្ត ទៀត ថា ជាមួយនឹង ប្តេជ្ញាចិត្ត ឥត ងាក រេ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល ដឹកនាំ ប្រកបដោយ ចក្ខុវិស័យ គឺជា មូលដ្ឋានគ្រឹះ នៃ វឌ្ឍនភាព និង ទំនុកចិត្ត ក្នុង ការសម្រេចបាន នូវ គោលដៅ កម្ពុជា គ្មាន មីន ឆ្នាំ ២០២៥ ក៏ ដូចជា ការកាត់បន្ថយ ការគំរាមកំហែង ពី សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម ឲ្យ ស្ថិត នៅ កម្រិត អប្បបរមា ។
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ! យប់ មិញ នៅ រាជធានី ភ្នំពេញ ឃាត់ យានយន្ដ ល្មើស ៦០ គ្រឿង
( ភ្នំពេញ ) ៖ លទ្ធផល នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ និង ត្រួតពិនិត្យ ជាតិ អាល់កុល នៅ យប់ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២៤ ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ កម្លាំង សមត្ថកិច្ច បាន ឃាត់ យានយន្ដ ល្មើស ចំនួន ៦០ គ្រឿង ក្នុង នោះ រថយន្ត ចំនួន ១១គ្រឿង និង ម៉ូតូ ៤៩ គ្រឿង ។
ប្រតិបត្តិការ នេះ ធ្វើឡើង ដោយ អនុវត្ត តាម បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ និង តប តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា សំដៅ ទប់ស្កាត់ និង បង្ការ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ដែល ជា សញ្ញាណ គួរឲ្យ ព្រួយបារម្ភ ។
ជា លទ្ធផល តាម បណ្តា អធិការដ្ឋាន នគរបាល ខណ្ឌ បាន ចុះ អនុវត្ត រឹត បន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក និង ត្រួតពិនិត្យ ជាតិ អាល់កុល ដូច ខាងក្រោម៖ ឃាត់ យានយន្ត ល្មើស សរុប ចំនួន ៦០ គ្រឿង ( រថយន្ត ចំនួន ១១គ្រឿង និង ម៉ូតូ ចំនួន ៤៩ គ្រឿង ) ៖
ថ្លែង ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ បាន អះអាង ថា « កម្លាំង សមត្ថកិច្ច ជំនាញ របស់ ស្នងការដ្ឋាន នគរបាល រាជធានី បាន ចេញ យុទ្ធនាការ រឹតបន្តឹង ច្បាប់ ត្រួតពិនិត្យ ជាតិ អាល់កុល ក្នុង ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ ជាប្រចាំ ដោយ មិន លើកលែង »៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ អំពាវនាវ ឱ្យ កម្លាំង តាម ព្រំដែន បន្ត ពង្រឹង និង អភិវឌ្ឍន៍ តំបន់ ព្រំដែន ជាមួយ ប្រទេស ជិតខាង ឱ្យ ក្លាយជា ព្រំដែន សន្តិភាព មិត្តភាព និង សហប្រតិបត្តិការ
( បន្ទាយមានជ័យ )៖ លោក ឧត្តមសេនីយ៍ ឯក សៀក សុជាតិ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ បាន អំពាវនាវ ដល់ កម្លាំង កម្លាំង ឈរជើង តាម ខ្សែ បន្ទាត់ ព្រំដែន ត្រូវ បន្ត ពង្រឹង និង អភិវឌ្ឍន៍ តំបន់ ព្រំដែន ជាមួយ ប្រទេស ជិតខាង ឱ្យ ក្លាយជា ព្រំដែន ប្រកបដោយ សន្តិភាព មិត្តភាព សហប្រតិបត្តិការ ចូលរួម ថែរក្សា ការពារ ខ្សែ បន្ទាត់ ព្រំដែន បង្គោល ព្រំដែន ដែល មាន ស្រាប់ និង បន្ត យកចិត្តទុកដាក់ លើ ការបង្កើត និង រក្សា តំបន់ ប្រវត្តិសាស្ត្រ យោធា នៅ តាម តំបន់ ព្រំដែន ដើម្បី ពង្រឹង ប្រៀបការពារ ជាតិ ឱ្យ បាន កាន់តែ រឹងមាំ ។
ក្រុម អ្នកចរចា មកពី ក្រុមហា ម៉ាស កាតា និង អេហ្ស៉ី ប លើកលែង អ៊ីស្រាអែល ចេញ កំពុង ស្ថិត ក្នុង ទីក្រុង គែរ ប្រទេស អេហ្ស៉ី ប ដើម្បី ពិភាក្សា គ្នា ស្វែងរក ច្រក ចេញ សម្រាប់ បទ ឈប់ បាញ់ រយៈពេល ៤០ ថ្ងៃ នៅក្នុង សង្រ្គាម រវាង អ៉ី ស្រាអែល និង ក្រុមហា ម៉ាស ខណៈ ខែរ៉ាម៉ាឌន ដែល ជា ខែតម អាហារ នៅ ពេល ថ្ងៃ របស់ អ្នកកាន់ សាសនា អ៉ី ស្លាម នឹង ចាប់ផ្ដើម នៅ ដើម សប្ដាហ៍ ក្រោយ នេះ ។
នៅ ចំពោះមុខ អ្នកសារព័ត៌មាន កាលពី ថ្ងៃអង្គារ ទី៥ ខែមីនា លោក បៃ ដិន បាន កត់សម្គាល់ ដូច្នេះ ថា « បច្ចុប្បន្ន អ្វី ៗ គឺ វា អាស្រ័យ ទៅ លើ ការសម្រេចចិត្ត របស់ ក្រុមហា ម៉ាស ស្រប ពេល អ៉ី ស្រាអែល កំពុង ផ្ដល់ កិច្ចសហការ ... តែ ប្រសិនបើ ការប្រយុទ្ធ គ្នា នៅតែ បន្ត ធ្វើឡើង នៅក្នុង ខែរ៉ាម៉ាឌន នោះ វា នឹង ក្លាយជា រឿង គ្រោះថ្នាក់ ជា ទីបំផុត » ។
គួរ បញ្ជាក់ ថា មន្ត្រី ហាម៉ាស ម្នាក់ ឈ្មោះ Osama Hamdan បាន ប្រាប់ អ្នកសារព័ត៌មាន ក្នុង ទីក្រុង បេរូត ប្រទេស លី បង់ ដែរ ថា លក្ខខណ្ឌ ចម្បង របស់ ក្រុមហា ម៉ាស នោះ គឺ អ៉ី ស្រាអែល ត្រូវតែ បញ្ឈប់ ប្រតិបត្តិការ យោធា ដក ទ័ព ចេញ ពី ហ្កាហ្សា និង អនុញ្ញាតឱ្យ ប្រជាជន ប៉ាឡេស្ទីន ដែល បាន ភៀសខ្លួន ពី សង្រ្គាម អាច ត្រឡប់ ទៅកាន់ ផ្ទះសម្បែង របស់ ពួកគេ វិញ ។ តាម មន្ត្រី ហាម៉ាស រូប នេះ ដដែល ការដោះដូរ អ្នកទោស ណាមួយ នឹង មិន អាច កើតឡើង នោះ ទេ ទាល់តែ មាន បទ ឈប់ បាញ់ ជាមុន សិន ។
ប៉ុន្តែ អ៉ី ស្រាអែល វិញ ក៏ បាន បញ្ជាក់ ដែរ ថា ខ្លួន គ្រាន់តែ មាន បំណង ផ្អាក សង្រ្គាម ជា ថ្នូរ នឹង ការដោះលែង ចំណាប់ខ្មាំង តែ ប៉ុណ្ណោះ ដោយ នៅតែ ទទូច ដដែល ថា នឹង មិន បញ្ឈប់ សង្រ្គាម នោះ ទេ រហូត ទាល់តែ ក្រុមហា ម៉ាស ត្រូវបាន កម្ទេច ៕
រដ្ឋមន្ត្រី សុខាភិបាល បង្ហាញ ពី ការប្រើ ន វានុវត្តន៍ ក្នុង ការផ្តល់ សេវា សុខាភិបាល នឹង ធ្វើឲ្យ សេវា សាធារណៈ កាន់តែ មាន ប្រសិទ្ធិភាព និង សក្តិសិទ្ធភាព សំដៅ ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ ពលរដ្ឋ
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៤ បាន បន្ត ដឹកនាំ វគ្គ បណ្តុះបណ្តាល ស្តីពី « ភាពជា អ្នកដឹកនាំ និង ន វានុវត្តន៍ » សម្រាប់ មន្រ្តី រាជការ ក្រោម ឱវាទ ក្រសួង សុខាភិបាល តាម ប្រព័ន្ធ វីដេអូ សន្និសីទ ដែល មាន សមាសភាព ចូលរួម សរុប ចំនួន ២៥០១ នាក់ ដើម្បី ពង្រឹង ស្ថាបន័ ដែល ជា យុទ្ធសាស្រ្ត ជា អាទិភាព មួយ ក្នុង ចំណោម អាទិភាព ទាំង ៣ ដែល បាន ដាក់ចេញ ដោយ ក្រសួង សុខាភិបាល ក្នុង ការគាំទ្រ កំណែទម្រង់ រាជ រដ្ឋាភិបាល សម្រាប់ នីតិកាល ទី៧ នៃ រដ្ឋសភា ។
មេរៀន ក្នុង សប្តាហ៍ នេះ ផ្តល់ ចំណេះដឹង បទពិសោធន៍ ជាក់ស្តែង ជាមួយ ឧទាហរណ៍ នៃ ការប្រើប្រាស់ ន វានុវត្តន៍ ដើម្បី ធ្វើអោយ កិច្ចការ បម្រើ សេវា សាធារណៈ ពិសេស សេវា សុខាភិបាល កាន់តែ បាន គាប់ ប្រសើរ ។
លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី បាន បង្ហាញ ពី ដំណាក់កាល ទាំង៤ នៃ ន វានុវត្តន៍ ដែល រួម មាន ការវិនិច្ឆ័យ រក បញ្ហា ការរៀបចំ សេវា ការអនុវត្តន៍ និង ការវាយតំលៃ តាមដាន លទ្ធផល ។ ការប្រើ ន វានុវត្តន៍ នៅក្នុង ការផ្តល់ សេវា សុខាភិបាល នឹង ធ្វើ សេវា សាធារណៈ កាន់តែ មាន ប្រសិទ្ធិភាព និង សក្តិសិទ្ធភាព សំដៅ ឆ្លើយតប ទៅនឹង តំរូវការ របស់ ប្រជាពលរដ្ឋ ព្រមទាំង ផ្តល់ ជូន គាត់ នូវ បទពិសោធន៍ ល្អ ៗ ក្រោយពី ទទួលបាន សេវា ពី គ្រឹះស្ថាន សុខភាព សាធារណៈ ។
ក្រៅពី ការធ្វើ បទបឋក ថា លោក សាស្ត្រាចារ្យ រដ្ឋមន្ត្រី ក៏ បាន បង្ហាញ ពី ប្រធានបទ ដែល បាន ជ្រើសរើស សម្រាប់ ពិភាក្សា នៅក្នុង សន្និបាត សុខាភិបាល លើក ទី ៤៣ នា ពេល ខាងមុខ នេះ ដែល រួម មាន៖ ( ១ ) ការបង្ការ និង គ្រប់គ្រង ជំងឺ មិន ឆ្លង ( ២) ការលើកកម្ពស់ សុខភាព មាតា និង ទារក និង អាហារ រូបត្ថម្ភ ( ៣) ការបង្ការ និង គ្រប់គ្រង នឹង ជំងឺ ឆ្លង ( ៤) ការផ្ដល់ សេវា ថែទាំ សុខភាព បឋម និង ( ៥) ការផ្ដល់ សេវា ថែទាំ សុខភាព នៅ មន្ទីរពេទ្យ បង្អែក ។
លោក សាស្រ្តាចារ្យ បាន ជំរុញ ឲ្យ មន្រ្តី សុខាភិបាល ទាំងអស់ ចូលរួម លើក ជា សំណួរ ឲ្យបាន ផុសផុល សំដៅ ប្រមែប្រមូល ធាតុ ចូល សម្រាប់ យក ទៅ ពិចារណា នៅក្នុង សន្និបាត ឬ សម្រាប់ ប្រើប្រាស់ នៅក្នុង ការងារ ពង្រឹង វិស័យ សុខាភិបាល នា ពេល បច្ចុប្បន្នក៍ ដូចជា ក្នុង ពេល អនាគត ។
កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - អូស្ត្រាលី ចាប់ផ្តើម បើក ជា ផ្លូវការ
( ម៉ែល ប៊ន . អូស្ត្រាលី ) ៖ កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - អូស្ត្រាលី ដែល រៀបចំឡើង នៅ ទីក្រុង ម៉ែល ប៊ន ប្រទេស អូស្ត្រាលី បាន ចាប់ផ្តើម បើក ជា ផ្លូវការ ហើយ នៅ ព្រឹក ថ្ងៃពុធ ទី៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
កិច្ចប្រជុំ នេះ មាន ការអញ្ជើញ ចូលរួម ពី មេដឹកនាំ ប្រទេស សមាជិក អាស៊ាន និង លោក នាយក រដ្ឋមន្ត្រី អូស្ត្រាលី ព្រមទាំង អគ្គ លេខាធិការ អាស៊ាន ផងដែរ ។
កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - អូស្ត្រាលី ធ្វើឡើង ដើម្បី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៥០ នៃ ទំនាក់ទំនង ដៃគូ សន្ទនា អាស៊ាន - អូស្ត្រាលី ។ កិច្ចប្រជុំ នេះ នឹង ផ្តល់ ឱកាស ដល់ ថ្នាក់ដឹកនាំ កំណត់ ទិសដៅ អនាគត រួម និង ធ្វើឱ្យ ទំនាក់ទំនង កាន់តែ ស៊ីជម្រៅ តាមរយៈ ការអនុវត្ត ឱ្យ បាន ពេញលេញ និង ប្រកបដោយ ប្រសិទ្ធភាព នូវ អាទិភាព សំខាន់ ៗ នៃ ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - អូស្ត្រាលី ។
ថ្នាក់ដឹកនាំ គ្រោង នឹង អនុម័ត សេចក្តីថ្លែងការណ៍ ទីក្រុង ម៉ែល ប៊ន និង សេចក្តីប្រកាស ចក្ខុវិស័យ របស់ ថ្នាក់ដឹកនាំ អាស៊ាន - អូស្ត្រាលី ៕
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន ! ស្លាប់ ៣នាក់ និង ៥នាក់ រងរបួស ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៥ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ៥នាក់ ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក អ៊ុក គឹម សាន អភិបាល រង ខេត្ត តំណាង លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ និង លោក បណ្ឌិត ស ចិត្ត្រា អគ្គ លេខាធិការ រង នៃ ក្រសួង កសិកម្ម ដោយ មាន ការចូលរួម ពី លោក ពឹង ទ្រី ដា ប្រធាន មន្ទីរ កសិកម្ម ខេត្ត ព្រះវិហារ ព្រមទាំង មន្ត្រី ពាក់ព័ន្ធ និង ប្រជា សហគមន៍ កសិកម្ម ជាច្រើន រូប ទៀត ។
ក្នុង នាម លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ លោក អ៊ុក គឹម សាន បាន ថ្លែង នូវ ក្តី សោមនស្ស ដែល បាន ចូលរួម សន្និបាត និង ចែក ពូជ ដំឡូង មី ដល់ សហគមន៍ កសិកម្ម នា ពេលនេះ ។ លោក ក៏ ថ្លែងអំណរគុណ ដល់ មន្ទីរ ពាក់ព័ន្ធ វិស័យ ឯកជន ដៃគូរ អភិវឌ្ឍន៍ ពិសេស មន្ទីរ កសិកម្ម ខេត្ត ដែល បាន ជ្រោមជ្រែង និង ជំរុញ ផលិតកម្ម កសិកម្ម សរីរាង្គ តាម កិច្ចសន្យា ក្នុង ខេត្ត ព្រះវិហារ បាន ទទួល ជោគជ័យ ។
លោក អ៊ុក គឹម សាន បាន បង្ហាញ ពី សមិទ្ធផល នៃ ការអនុវត្ត កសិកម្ម សរីរាង្គ តាមរយៈ កិច្ចសន្យា ផលិតកម្ម កសិកម្ម ដែល សហភាព សហគម កសិកម្ម និង សហគមន៍ កសិកម្ម ក្នុង ខេត្ត ព្រះវិហារ បាន ផ្គត់ផ្គង់ ជូន ក្រុមហ៊ុន នាំចេញ នានា ក្នុង ឆ្នាំ ២០២៣ រួម មាន៖
តុលាការ ICC ដែល មាន មូលដ្ឋាន នៅ ទីក្រុង ឡាអេ បាន និយាយ ថា « មាន មូលហេតុ សម ហេតុផល ក្នុង ការជឿ ថា ជនសង្ស័យ ទាំង ពីរ នាក់ ខាងលើ ទទួលខុសត្រូវ ចំពោះ ការវាយប្រហារ ដោយ មីស៊ីល ដែល ធ្វើឡើង ដោយ កងកម្លាំង ក្រោម ការបញ្ជា របស់ ពួកគេ ប្រឆាំង នឹង ហេដ្ឋារចនាសម្ព័ន្ធ អគ្គិសនី របស់ អ៊ុយក្រែន ចាប់តាំងពី ខែតុលា ឆ្នាំ ២០២២ ម ដល់ ថ្ងៃទី ៩ ខែមីនា ឆ្នាំ ២០២៣ ។
តុលាការ បាន បន្ថែម ថា គ្រោះថ្នាក់ ដល់ ជន ស៊ីវិល និង ការខូចខាត ដែល បណ្តាល មកពី ការវាយប្រហារ គឺ ពិតជា ហួស កម្រិត បើ ប្រៀបធៀប ទៅនឹង ផលប្រយោជន៍ យោធា ដែល រំពឹងទុក ។
ដោយឡែក រដ្ឋអាជ្ញា អ៊ុយក្រែន ក៏ កំពុង ស៊ើបអង្កេត ឧក្រិដ្ឋកម្ម សង្គ្រាម នៃ យុទ្ធនាការ រដូវ រងា របស់ រស្ស៉ី ដែល បាន វាយប្រហារ តាម អាកាស លើ ហេដ្ឋារចនាសម្ព័ន្ធ ថាមពល និង ឧបករណ៍ ប្រើប្រាស់ សាធារណៈ របស់ ប្រទេស អ៊ុយក្រែន ។
ប្រទេស រុស្ស៊ី បាន បដិសេធ ចំពោះ ការកំណត់ គោលដៅ លើ ហេដ្ឋារចនាសម្ព័ន្ធ ស៊ីវិល ដោយ ចេតនា ក្នុង ប្រទេស អ៊ុយក្រែន ដោយ និយាយ ថា ការវាយប្រហារ របស់ ខ្លួន គឺ សុទ្ធតែ មាន គោលបំណង កាត់បន្ថយ សមត្ថភាព ប្រយុទ្ធ របស់ ទីក្រុង គៀវ ។
( ភ្នំពេញ ) ៖ លោក ឌី រ័ត្ន ខេមរុណ អភិបាល រង ខណ្ឌ ៧មករា និង ជា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ អូ ឬ ស្សី ទី២ ព្រមទាំង លោកស្រី ហ៊ុន សុធារ៉ា ជា ភរិយា នៅ រសៀល ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជួបជុំ សំណេះសំណាល ជាមួយ ក្រុមការងារ យេនឌ័រ ព្រមទាំង មន្រ្តី ជា នារី នៅ សង្កាត់ អូ ឬ ស្សី ទី២ ដើម្បី អបអរសាទរ ខួប លើក ទី ១១៣ ទិវា អន្តរជាតិ នារី ៨មីនា ២០២៤ ក្រោម ប្រធានបទ « ស្រ្តី និង ក្មេងស្រី ក្នុង បរិវត្តកម្ម ឌីជីថល » ។
លោក អភិបាល រង បាន បញ្ជាក់ ថា រដ្ឋបាល ខណ្ឌ ៧មករា រួមទាំង រដ្ឋបាល សង្កាត់ ទាំង៨ មាន ភាពចាំបាច់ ក្នុង ការចូលរួម គាំទ្រ និង អនុវត្ត ការងារ លើកកម្ពស់ សមភាព យេនឌ័រ និង បង្កើន ភាពអង់អាច ដល់ ស្ត្រី ដើម្បី បង្កើត បរិស្ថាន អំណោយផល និង ផ្តល់ ឱកាស ឱ្យ ស្ត្រី បាន បន្ត ចូលរួម យ៉ាង ពេញលេញ ក្នុង ការអនុវត្ត សិទ្ធិ និង ករណី យកិច្ចព្រមទាំង ទទួលបាន ផលប្រយោជន៍ ពី កិច្ចអភិវឌ្ឍ ក្នុង មូលដ្ឋាន ខណ្ឌ ៧មករា ប្រកបដោយ សមធម៌ និង សមភាព តាមរយៈ ការបន្ត គិតគូរ ដល់ ស្ត្រី ។
ក្នុង ពិធី សំណេះសំណាល នេះ ដែរ លោក អភិបាល រង ក៏ បាន ផ្តល់ ជូន នូវ បាច់ ផ្កា អនុស្សាវរីយ៍ ដល់ ភរិយា ព្រមទាំង តំណាង នារី សង្កាត់ និង បាន ឧបត្ថម្ភ លើកទឹកចិត្ត ដល់ មន្រ្តី នារី ដែល បាន ចូលរួម សរុប ២៣នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន សំពត់ សឹង្ហ ១. ទឹក សុទ្ធ ១កេស . ថវិកា ៤០.០០០ រៀល និង ឧបត្ថម្ភ បុគ្គលិក សង្កាត់ ១៤នាក់ ( បុរស ) ក្នុង ម្នាក់ ៤ម៉ឺន រៀល រួមទាំង លោក ចៅសង្កាត់ ៤០០.០០០ រៀល សម្រាប់ ទ្រទ្រង់ រដ្ឋបាល សង្កាត់ ផងដែរ ៕
មន្ត្រី ជាន់ ខ្ពស់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀ ន៖ អន្តរ សាសនា ខេត្ត ព្រះសីហនុ ជា ក្រុម គោលដៅ អាទិភាព មួយ អាច បញ្ជូន សារ អប់រំ ពី បញ្ហា គ្រឿងញៀន ដល់ សហគមន៍
( ព្រះសីហនុ) ៖ ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត ប្រធាន នាយកដ្ឋាន ផ្សព្វផ្សាយ អប់រំ និង ទំនាក់ទំនង សាធារណៈ នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ថ្លែង ថា អន្តរ សាសនា ខេត្ត ព្រះសីហនុ ជា ក្រុម គោលដៅ អាទិភាព មួយ អាច បញ្ជូន សារ អប់រំ ពី បញ្ហា គ្រឿងញៀន ដល់ សហគមន៍ ។
ការថ្លែង បែប នេះ របស់ ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត បាន ធ្វើឡើង ក្នុង ពិធី បិទ សិក្ខាសាលា ការ លើកកម្ពស់ ការផ្សព្វផ្សាយ អប់រំ ពី ផល ប៉ះពាល់ នៃ ការប្រើប្រាស់ គ្រឿងញៀន និង ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន ដល់ អន្តរ សាសនា ខេត្ត ព្រះសីហនុ នា ល្ងាច ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៤ ។
លោក អ៊ួង យូហាន ប្រធាន ក្រុមប្រឹក្សា បណ្តាញ ព្រះវិហារ គ្រីស្ទ បរិស័ទ កម្ពុជា បាន ថ្លែងអំណរគុណ ដល់ កិច្ចសហការ យ៉ាង ល្អ រវាង អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន អាជ្ញាធរ ខេត្ត ព្រះសីហនុ និង វិស័យ សាសនា ដើម្បី ផ្តល់ ឱកាស ឱ្យ វិស័យ សាសនា អាច ចូលរួម ការងារ សង្គម ពិសេស ការងារ ផ្សព្វផ្សាយ ព័ត៌មាន ពិត ពី បញ្ហា គ្រឿងញៀន ដល់ បរិស័ទ របស់ ខ្លួន ។
ថ្លែង ក្នុង នាម នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ អគ្គ លេខាធិការ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន . ឧត្តមសេនីយ៍ ឯក លឹម តុង ហួត បាន ថ្លែង ថាអំណរគុណ ដល់ គ្រប់ សាសនា ដែល បាន បញ្ជូន តំណាង ជា ព្រះសង្ឃ ជា អ៉ីម៉ាំ គ្រូ គង្វាល បូជាចារ្យ អាចារ្យ និង ក្រុម ជំនុំ មក ចូលរួម សិក្សា ស្វែងយល់ ចាប់ យក ចំណេះដឹង ការចែក រម្លែក បទពិសោធន៍ ពី សិក្ខាសាលា ក្នុង គោលបំណង រួមគ្នា ជួយ សហគមន៍ ឱ្យ មាន សុវត្ថិភាព ពី បញ្ហា គ្រឿងញៀន ដែល ជាដើម ចម នៃ បទល្មើស ផ្សេង ៗ ។
ឧត្តមសេនីយ៍ ត្រី យិន យឿត បាន ឱ្យដឹង ថា សិក្ខាកាម បាន យល់ដឹង ពី អ្វី ទៅជា គ្រឿងញៀន ? ឥទ្ធិពល និង គ្រោះថ្នាក់ នៃ ការប្រើប្រាស់ គ្រឿងញៀន គ្រប់ ប្រភេទ ហេតុ អ្វី គេ ប្រើ គ្រឿងញៀន របៀប បដិសេធ គ្រឿងញៀន ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន ៕
បណ្ឌិត កៅ គឹម ហួន ជួប នាយក រដ្ឋមន្ត្រី អូស្ត្រាលី នាយក រដ្ឋមន្ត្រី នូវែលសេឡង់ និង ចូលរួម ព្រឹត្តិការណ៍ សំខាន់ ៗ មួយចំនួន នៅ អូស្ត្រាលី
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ទំនាក់ទំនង ដៃគូ សន្ទា អាស៊ាន - អូស្ត្រាលី និង ការប្តេជ្ញាចិត្ត ពង្រឹង បន្ថែម ទៀត នូវ ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - អូស្ត្រាលី ។
លោក អគ្គ លេខាធិការ អាស៊ាន បាន ថ្លែងអំណរគុណ ចំពោះ ការគាំទ្រ យ៉ាង ខ្លាំងក្លា របស់ អូស្ត្រាលី សម្រាប់ ការកសាង សហគមន៍ អាស៊ាន និង មជ្ឈភាព អាស៊ាន ហើយ សង្ឃឹម លើ ការបន្ត គាំទ្រ របស់ អូស្ត្រាលី ចំពោះ អាស៊ាន ដើម្បី លើកស្ទួយ សន្តិភាព ស្ថិរភាព និង វិបុលភាព នៅក្នុង តំបន់ ។
នៅ ព្រឹក ថ្ងៃ ដដែល លោក បណ្ឌិត កៅ គឹម ហួន បាន អញ្ជើញ ថ្លែង សន្ទរកថា គន្លឹះ នៅក្នុង វេទិកា នាយក ប្រតិបត្តិ នៃ កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - អូស្ត្រាលី ។
នៅក្នុង សន្ទរកថា នោះ លោក អគ្គ លេខាធិការ អាស៊ាន បាន លើកទឹកចិត្ត ឱ្យ ធុរកិច្ច អូស្ត្រាលី កាន់តែ ច្រើន ទៅ បណ្តាក់ទុន នៅក្នុង តំបន់ អាស៊ាន និង ចូលរួម នៅក្នុង បរិវត្តកម្ម ឌីជីថល អាស៊ាន និង ការធ្វើដំណើរ ផ្លាស់ប្តូរ បៃតង ។
នៅក្នុង ឱកាស នោះ ភាគី ទាំង ពីរ បាន ពិភាក្សា រក វិធី ដើម្បី បង្កើន ទំនាក់ទំនង តំបន់ ស្តីពី ការចូលរួម ផ្នែក សេដ្ឋកិច្ច ក៏ ដូចជា បង្កើន ឱកាស ឱ្យ អាស៊ាន នៅក្រោម យុទ្ធសាស្ត្រ សេដ្ឋកិច្ច អាស៊ី អាគ្នេយ៍ របស់ អូស្ត្រាលី ស្តីពី ការជំរុញ ពាណិជ្ជកម្ម ការវិនិយោគ និង ទេសចរណ៍ ។
បន្ថែម ពី នេះ លោក បណ្ឌិត កៅ គឹម ហួន បាន អញ្ជើញ ថ្លែង សន្ទរកថា បិទ ក្នុង កិច្ចសន្ទនា មេដឹកនាំ កំពុង លេច មុខ នា ឱកាស នៃ កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - អូស្ត្រាលី ។
លោក បណ្ឌិត បាន លើកទឹកចិត្ត ឱ្យ មេដឹកនាំ ដែល កំពុង លេច មុខ បង្កើត ភាពជាដៃគូ និង ពង្រឹង ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ក្នុង ចំណោម អាស៊ាន និង អូស្ត្រាលី ដើម្បី បង្កើត អនាគត ដែល មាន វិបុលភាព រួម ។
ក្រសួង អភិវឌ្ឍន៍ ជនបទ នឹង ធ្វើ សន្និបាត បូកសរុប ការងារ ២ ថ្ងៃ ចាប់ពី ថ្ងៃ ១៩ - ២០ ខែមីនា
( ភ្នំពេញ ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នា រសៀល ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៤ បាន ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ លោក យូ ស៊ុន ឡុង រដ្ឋមន្ដ្រី ប្រតិភូ អម នាយក រដ្ឋមន្ដ្រី និង ប្រតិភូ ទទួលបន្ទុក សន្តិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ដំណើរការសន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ។
លោក រដ្ឋមន្រ្ដី ឆាយ ឫទ្ធិ សែន បាន បង្ហាញ ពី កិច្ច ត្រៀម សហការ ព្រមទាំង បាន គាំទ្រ ចំពោះ ផែនការ សន្តិសុខ ទាំងអស់ របស់ ក្រុមការងារ ដើម្បី ការពារ សន្តិសុខ សុវត្ថិភាព ជូន ប្រមុខ រាជ រដ្ឋាភិបាល ក្នុង ឱកាស បិទ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ។
សូម បញ្ជាក់ ថា សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ នឹង ប្រព្រឹត្តទៅ នៅ ទីស្ដីការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ រយៈពេល ២ ថ្ងៃ គឺ ថ្ងៃទី ១៩ - ២០ ខែមីនា ឆ្នាំ ២០២៤ ដែល បើក ដោយ លោក ឆាយ ឫទ្ធិ សែន និង ពិធី បិទ ក្រោម អធិបតីភាព របស់ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ៕ វិភាគ អន្តរជា តិ៖ ហេតុ អ្វី រដ្ឋាភិបាល អារ៉ាប់ ភាគ ច្រើន មិន ឈរ នៅ ខាងក្រុមហា ម៉ាស ?
រូបភាព ពី AFP រដ្ឋបាល ខេត្ត កោះកុង បំភ្លឺ ករណី វិវាទ ដីធ្លី ពាក់ព័ន្ធ យោធា ដែល កំពុង ផ្ទុះ លើ បណ្តាញ សង្គម
រដ្ឋបាល ខេត្ត កោះកុង បំភ្លឺ ករណី វិវាទ ដីធ្លី ពាក់ព័ន្ធ យោធា ដែល កំពុង ផ្ទុះ លើ បណ្តាញ សង្គម
( ភ្នំពេញ ) ៖ វិវាទ ដីធ្លី ពាក់ព័ន្ធ នឹង មន្ត្រី យោធា ស្ថិត នៅក្នុង ខេត្ត កោះកុង បង្ក ការចាប់អារម្មណ៍ ជាខ្លាំង លើ បណ្តាញ សង្គម ។ ឆ្លើយតប នឹង ការផ្សព្វផ្សាយ នេះ រដ្ឋបាល ខេត្ត កោះកុង ចេញមក បំភ្លឺ ដូច ខាងក្រោម៖
( ម៉ែល ប៊ន . អូស្ត្រាលី ) ៖ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោក ចូកូ វីដូដូ ប្រធានាធិបតី ឥណ្ឌូនេស៊ី បាន បង្ហាញ ក្តីរីករាយ ចំពោះ ទំនាក់ទំនង ល្អ ប្រសើរ រវាង កម្ពុជា និង ឥណ្ឌូនេស៊ី ព្រមទាំង សន្យា ធ្វើឱ្យ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ទាំងឡាយ កាន់តែ ល្អ ប្រសើរ ។
ក្នុង ជំនួប ពិភាក្សា ការងារ ធ្វើឡើង នា រសៀល ថ្ងៃទី ៥ ខែមីនា ឆ្នាំ ២០២៤ នៅ ទីក្រុង ម៉ែល ប៊ន ប្រទេស អូស្ត្រាលី សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន អបអរសាទរ ប្រធានាធិបតី ចូកូ វីដូដូ ចំពោះ ភាពជោគជ័យ ក្នុង ការរៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ាន លើក ទី ៤៣ ឆ្នាំ ២០២៣ ក៏ ដូចជា ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី កាលពី ថ្ងៃទី ១៤ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ។
ក្នុង ជំនួប នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោក ប្រធានាធិបតី ឥណ្ឌូនេស៊ី បាន ពិភាក្សា គ្នា លើ វិស័យ សំខាន់ ៗ ដែល ជា កម្មវត្ថុ នៃ ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ បន្ថែម និង ជា ផលប្រយោជន៍ រួម រវាង កម្ពុជា និង ឥណ្ឌូនេស៊ី ដែល រួម មាន៖ វិស័យ ការទូត សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម ទេសចរណ៍ និង សន្តិសុខ ។
ជាមួយ ការប្រារព្ធ ខួប លើក ទី ៦៥ នៃ ទំនាក់ទំនង ការទូត រវាង កម្ពុជា និង ឥណ្ឌូនេស៊ី សម្តេច ធិបតី និង លោក ចូកូ វីដូដូ បាន បង្ហាញ ក្តី សោមនស្ស រីករាយ ចំពោះ ទំនាក់ទំនង ដ៏ ល្អ ប្រសើរ រវាង ប្រទេស ទាំង ពីរ ក្នុង រយៈពេល ប្រមាណ ជិត ៧ទសវត្សរ៍ កន្លងមក នេះ ដោយ ផ្ដល់ ផ្លែ ផ្កា ជាច្រើន តាមរយៈ ទំនាក់ទំនង គ្នា កម្រិត ខ្ពស់ ទំនាក់ទំនង ផ្នែក សេដ្ឋកិច្ច ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ជាពិសេស ការពង្រឹង ទំនាក់ទំនង ក្នុង វិស័យ សន្តិសុខ និង ការពារ ជាតិ ។
ក្នុង ជំនួប នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង ប្រធានាធិបតី ឥណ្ឌូនេស៊ី បាន ឯកភាព គ្នា បន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លេី វិស័យ ខាង លេី ព្រមទាំង បន្ត រួមគ្នា បង្កេីន កិច្ចសហប្រតិបត្តិការ លេី វិស័យ មាន សក្ដានុពល ផ្សេង ទៀត ដេីម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ នៃ ប្រទេស ទាំង ពីរ កាន់តែ រឹងមាំ ។ សម្តេច ធិបតី បាន ថ្លែងអំណរគុណ ចំពោះ ការអញ្ជើញ សម្តេច បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ឥណ្ឌូណេស៊ី នា ពេល ពេលវេលា សមស្រប ណាមួយ ៕
( ភ្នំពេញ ) ៖ នៅ ខែ មុន នេះ គឺជា ខួប គម្រប់៣ ឆ្នាំ នៃ ការធ្វើ រដ្ឋប្រហារ យោធា ក្នុង ប្រទេស មីយ៉ាន់ម៉ា ដែល បាន ទម្លាក់ រដ្ឋាភិបាល ជាប់ ឆ្នោត តាម លទ្ធិ ប្រជាធិបតេយ្យ ហើយ បណ្តាលឱ្យ មាន សង្គ្រាម ស៊ីវិល បង្ហូរ ឈាម មួយ ហែក ហួរ ប្រទេស អាស៊ាន មួយ នេះ ដល់ បច្ចុប្បន្ន ។
តើ មកទល់ ពេលនេះ ស្ថានការណ៍ មីយ៉ាន់ម៉ា មាន ការវិវឌ្ឍន យ៉ាងណា ហើយ ? តើ របប សឹក ពិតជា អាច បន្ត ដឹកនាំ ប្រទេស ដោយ រលូន ឬ យ៉ាងណា ?
ខាងក្រោម នេះ ជា កិច្ចសម្ភាស រវាង Fresh News និង លោក បណ្ឌិត កា ម៉ាធុល អនុប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា ថា តើ រដ្ឋប្រហារ យោធា នៅ មីយ៉ាន់ម៉ា ៣ ឆ្នាំ តែ នៅ ឆ្ងាយ ពី ក្រសែភ្នែក ពិភពលោក ឬ យ៉ាងណា ? អាវុធហត្ថ ខេត្ត បន្ទាយមានជ័យ បញ្ជូន ជនសង្ស័យ ម្នាក់ ទៅ តុលាការ ពាក់ព័ន្ធ ករណី ហិង្សា និង គ្រឿងញៀន
( បន្ទាយមានជ័យ )៖ នៅ ថ្ងៃទី ៤ ខែមីនា ឆ្នាំ ២០២៤ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត បាន ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ឈ្មោះ ជា ជាក់ អាយុ ៣៥ ឆ្នាំ នៅ ភូមិ គីឡូម៉ែត្រ លេខ ៤ សង្កាត់ ផ្សារ កណ្តាល ពាក់ព័ន្ធ ករណី ហិង្សា ដោយ ចេតនា មាន ស្ថាន ទម្ងន់ ទោស និង ប្រើប្រាស់ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ។
លោក វរសេនីយ៍ ត្រី នួន នីណារ៉ូ មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង បាន ឱ្យដឹង ថា កាលពី វេលា ម៉ោង ២០៖៣០ នាទី ថ្ងៃទី ០៣ ខែមីនា ឆ្នាំ ២០២៤ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ប៉ោយប៉ែត បាន ទទួល ព័ត៌មាន ពី ប្រជាពលរដ្ឋ ថា នៅ ចំណុច កើត ហេតុ មាន ករណីកាប់ ដោយ ពូ ថៅ បណ្ដាលឱ្យ រងរបួស ធ្ងន់ . ភ្លាម ៗ នោះ កម្លាំង មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង បាន ចុះ ទៅដល់ ហើយ ឃាត់ខ្លួន ជនសង្ស័យ រួមទាំង ដក វត្ថុតាង ពូ ថៅ ដង ឈើ រួច នាំ មកកាន់ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង ដើម្បី សួរនាំ ។
លោក វរសេនីយ ត្រី នួន នីណារ៉ូ បាន បញ្ជាក់ ថា ជនសង្ស័យ ក្រោយពី សមត្ថកិច្ច ឃាត់ខ្លួន ហើយ បាន ធ្វើតេស្ត ទឹកនោម រកឃើញ មាន សារធាតុ ញៀន ។ ជនសង្ស័យ បាន ឆ្លើយ សារភាព ថា រូប ខ្លួន ពិតជា បាន យក ពូ ថៅ កាប់ ជនរងគ្រោះ ពិតប្រាកដ មែន ដោយសារ ខ្លួន និង ជនរងគ្រោះ មាន គំនុំ នឹង គ្នា តាំងពី ២ខែ មុន មក ម្ល៉េះ ។
លោក វរសេនីយ៍ ត្រី នួន នីណារ៉ូ បាន ប្រាប់ ទៀត ថា ជនរងគ្រោះ ឈ្មោះ សារឿន សែន អាយុ ៣៤ ឆ្នាំ ត្រូវបាន ក្រុមគ្រួសារ បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ជប៉ុន មង្គល បូរី ។
លោក វរសេនីយ៍ ឯក ម៉ែន ភិរម្យ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត ទទួល ការងារ ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស បាន ឱ្យដឹង ថា ការបង្ក្រាប ករណី ខាងលើ នេះ ទទួលបាន ការអនុញ្ញាត ពី លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត និង មាន ការសម្របសម្រួល នីតិវិធី ពី លោក កើត វណ្ណារ៉េត ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ។
បច្ចុប្បន្ន ជនសង្ស័យ រួម នឹង វត្ថុតាង ត្រូវបាន កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កងរាជអាវុធហត្ថ ខេត្ត កងរាជអាវុធហត្ថ ខេត្ត បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ហើយ នៅ រសៀល ថ្ងៃអង្គារ ទី៥ ខែមីនា ឆ្នាំ ២០២៤ នេះ ដើម្បី អនុវត្ត តាម នីតិវិធី ៕
អភិបាល ខេត្ត ពោធិ៍សាត់ ដឹកនាំ កិច្ចប្រជុំ បន្ទាន់ ដើម្បី បន្ត តាមដាន ត្រួតពិនិត្យ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ ក្នុង ភូមិសាស្ត្រ ស្រុក វាលវែង និង ស្រុក ភ្នំ ក្រវាញ
( ពោធិ៍សាត់ )៖ លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន ក្រុមការងារ ដឹកនាំ រួម នា រសៀល ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ បន្ទាន់ មួយ ជាមួយ គណៈកម្មការ ថ្នាក់ ខេត្ត និង អនុគណៈកម្មការ ទាំង ៩ក្រុម ដើម្បី បន្ត តាមដាន ត្រួតពិនិត្យ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ ក្នុង ភូមិសាស្ត្រ ស្រុក វាលវែង និង ស្រុក ភ្នំ ក្រវាញ នៃ ខេត្ត ពោធិ៍សាត់ ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ធ្វើឡើង នៅ សាល ប្រជុំ ជាន់ ទី១ អគារ រដ្ឋបាល ខេត្ត ដោយ បាន ការចូលរួម ពី ប្រធាន អនុប្រធាន និង សមាជិក នៃ អនុគណៈកម្មការ ទាំង ៩ក្រុម និង ក្រុម លេខាធិការ ចំណុះ ឱ្យ គណៈកម្មការ ថ្នាក់ ខេត្ត ដើម្បី ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ ក្នុង ភូមិសាស្ត្រ ស្រុក វាលវែង និង ស្រុក ភ្នំ ក្រវាញ ជាច្រើន នាក់ ទៀត ។
លោក សូម ស្នើ ដល់ អនុគណ:កម្មការ ទាំង ០៩ ក្រុម ត្រូវ ត្រួតពិនិត្យ ទីតាំង ចាស់ ដែល បាន ដកហូត និង ឃ្លុំ ទុក កន្លងមក ព្រមទាំង ឡើង ផែនទី និង ធ្វើ របាយការណ៍ ជាក់លាក់ ក្នុង ការពិនិត្យ ករណី កាប់ រុករាន ថ្មី ដោយ កំណត់ មុខ សញ្ញា និង ស្រាវជ្រាវ ចាប់ខ្លួន ជន ប្រព្រឹត្ត បទល្មើស ឱ្យ បាន ដាច់ខាត ដើម្បី យកមក ចាត់ការ តាម នីតិវិធី ។ បន្ថែម ពី នោះ ត្រូវ ត្រៀម ទីតាំង ឈរជើង និង ត្រៀម ដាំ កូន ឈើ ឡើងវិញ ដែល ទាំងនេះ ជា កិច្ចការ របស់ រដ្ឋបាល ព្រៃឈើ និង មន្ទីរ បរិស្ថាន ៕
មន្ដ្រី ជាន់ ខ្ពស់ ក្រសួង ពាណិជ្ជកម្ម ជំរុញ ឱ្យ សហគ្រាស - ក្រុមហ៊ុន ត្រូវ ពង្រឹង ផលិតភាព គុណភាព និង បរិមាណ ដើម្បី រក្សា និរន្តរភាព នាំចេញ បើ ទោះបី បាត់បង់ ការអនុគ្រោះ ក្តី ( ភ្នំពេញ ) ៖ លោក ប៉ែន សុវិជាតិ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន ជំរុញ ដល់ សហគ្រាស ក្រុមហ៊ុន ដែល ផលិតផលិតផល សម្រាប់ នាំចេញ ត្រូវ ពង្រឹង សមត្ថភាព ក្នុង ការផលិត ដើម្បី រក្សា បាន ការនាំចេញ ទោះបីជា កម្ពុជា អាច បាត់បង់ ការអនុគ្រោះ មួយចំនួន យ៉ាងណា ក្ដី ។
ការលើកឡើង របស់ លោក ប៉ែន សុវិជាតិ ធ្វើឡើង នៅក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី « ការដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ របស់ ប្រព័ន្ធ ទូរស័ព្ទ សាធារណៈ របស់ ក្រសួង ពាណិជ្ជកម្ម » រៀបចំឡើង នៅ ថ្ងៃទី ៤ ខែមីនា ឆ្នាំ ២០២៤ ។
លោក ប៉ែន សុវិជាតិ បាន ថ្លែង ថា « ជា ការពិត យើង ត្រូវបាន បាត់បង់ ការអនុគ្រោះ ពន្ធ មួយ ចំនួន ប៉ុន្ដែ កម្ពុជា ក៏ ទទួលបាន លក្ខខណ្ឌ មួយ ចំនួន ទៀត ដែល ត្រូវ ប្រុងប្រៀប អនុវត្តន៍ ។ ក្នុង នោះ សហគ្រាស ក្រុមហ៊ុន ត្រូវតែ ផ្ដោត លើ ការបង្កើន សមត្ថភាព បង្កើន លទ្ធភាព របស់ ខ្លួន ធ្វើ យ៉ាងណា ពង្រីក និង ពង្រឹង ការផលិត របស់ ខ្លួន » ។
លោក បាន បញ្ជាក់ ថា លោក តែងតែ ផ្ដោត លើ ភាពជឿជាក់ របស់ សហគ្រាស ក្រុមហ៊ុន លើ ការបង្កើន សមត្ថភាព និង លទ្ធភាព របស់ ខ្លួន ក្នុង ការចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដូច្នេះ ដើម្បី ធ្វើឲ្យ ក្រុមហ៊ុន ទាំងអស់ ពង្រឹង ខ្លួន ឯង បាន ត្រូវ អនុវត្តន៍ ចំណុច សំខាន់ ៗ ៣យ៉ាង រួម មាន៖
* ការបង្កើន ផលិតភាព ផលិតកម្ម ។ ឧទាហរណ៍ បើ ក្នុង ១ ម៉ោង គេ ផលិត បាន អាវ ១០ឡូ កម្ពុជា ត្រូវតែ ផលិត ឲ្យបាន ១០ឡូ ដូចគ្នា ដើម្បី មាន ភាពប្រកួតប្រជែង ។
លោក ប៉ែន សុវិជាតិ បាន បន្ថែម ថា កាល ដែល ក្រុមហ៊ុន ទាំងអស់ ពង្រឹង ខ្លួន ឯង បាន លើ ចំណុច ទាំង ៣នេះ និង ត្រូវ បន្ថែម ជំនាញ លើ សមត្ថភាព ការចែករំលែក ចំណេះដឹង និង ចំណេះ ធ្វើ ដល់ បុគ្គលិក ឬ កម្មករ របស់ ខ្លួន ដើម្បីឲ្យ ពួកគាត់ អាច បង្កើន នូវ សមត្ថភាព របស់ ខ្លួន បាន ។
លោក បាន បញ្ជាក់ ថា « យើង បាន ឆ្លង ផុត ពី ដំណាក់កាល ប្រទេស អភិវឌ្ឍន៍ តិចតួច និង ធ្លាប់ ទទួលបាន ការអនុគ្រោះ ទៅជា ប្រទេស កំពុង អភិវឌ្ឍន៍ ដែល ត្រូវបាន បាត់បង់ ការអនុគ្រោះ មួយចំនួន ហើយ ត្រូវ ឲ្យ យើង បង្កើន ការផលិត របស់ ខ្លួន ឲ្យ មាន គុណភាព ឬ ត្រូវ បង្កើន នូវ បច្ចេកទេស ផលិត ឲ្យ ឆ្លើយតប នឹង តម្រូវការ ទីផ្សារ គឺជា រឿង ចាំបាច់ » ។
នាយកដ្ឋាន ប្រឆាំង ភេរវកម្ម និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ខួប លើក ទី១១៣ ក្រោម ប្រធានបទ « ស្ត្រី និង ក្មេងស្រី ក្នុង បរិវត្តកម្ម ឌីជីថល »
( ភ្នំពេញ ) ៖ នា រសៀល ថ្ងៃអង្គារ ទី៥ ខែមីនា ឆ្នាំ ២០២៤ ឧត្តមសេនីយ៍ ឯក ធូ សារឿន ប្រធាន នាយកដ្ឋាន ប្រឆាំង ភេរវកម្ម និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន និង លោកស្រី បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី អបអរសាទរ ទិវា អន្តរជាតិ នារី ៨ មីនា ឆ្នាំ ២០២៤ ខួប លើក ទី១១៣ ក្រោម ប្រធានបទ « ស្ត្រី និង ក្មេងស្រី ក្នុង បរិវត្តកម្ម ឌីជីថល » ។
អញ្ជើញ សំណេះសំណាល នា ឱកាស នោះ ឧត្តមសេនីយ៍ ឯក ធូ សារឿន បាន គូសបញ្ជាក់ ថា ស្រ្តី បាន រួមចំណែក យ៉ាង សំខាន់ និង ឆ្លើយតប ទៅ និង បរិបទ បច្ចុប្បន្ន ក្នុង គោលបំណង បន្ត លើកកម្ពស់ តម្លៃ ស្ត្រី ដែល មិន អាច កាត់ថ្លៃ បាន ក្នុង ការចូលរួម ថែរក្សា សុខ សន្តិភាព ក៏ ដូចជា ការចូលរួម យ៉ាង សកម្ម ក្នុង ការពន្លឿន កិច្ចអភិវឌ្ឍ លើ គ្រប់ វិស័យ ជាពិសេស នៅក្នុង យុគសម័យ ឌីជីថល នេះ ។
ទន្ទឹម នោះ លោក ឧត្តមសេនីយ៍ ប្រធាន នាយកដ្ឋាន ក៏ បាន សង្កត់ធ្ងន់ ថា៖
* ស្ត្រី មាន ភាពស្មើ មុខ ស្មើ មាត់ ជាមួយ បុរស នៅក្នុង សង្គម *ស្ត្រី អាច មាន សមត្ថភាព ជាង បុរស * ស្ត្រី ក៏ អាច ចូលរួម គ្រប់ វេទិការជាតិ និង អន្តរជាតិ * ស្ត្រី ជា កម្លាំង ចលករ ជួយ រុញ អោយ បុរស បំពេញ នូវ តួនាទី របស់ ខ្លួន បាន ជោគជ័យ ។
ឧត្តមសេនីយ៍ ឯក ធូ សារឿន បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សួសុខ ទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនី យ៏ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ និង បាន អរគុណ ដល់ សមាជិក ទាំងអស់ ដែល បាន ចូលរួម និង បាន ផ្តល់ ជូន ថវិការ ក្នុង ម្នាក់ ៥០.០០០ រៀល ៕ អភិបាល ខេត្ត កំពត ស្នើ ឱ្យ ស្ត្រី បន្ត ចូលរួម គ្រប់ សកម្មភាព សង្គម សំដៅ លើកកម្ពស់ សីលធម៌ តម្លៃ ស្ត្រី តម្លៃ គ្រួសារ ខ្មែរ និង ការអភិវឌ្ឍ ឲ្យបាន កាន់តែ ល្អ ប្រសើរ ថែម ទៀត
( កំពត ) ៖ លោក បណ្ឌិត អភិបាល ខេត្ត កំពត ម៉ៅ ធ និន បាន ស្នើ និង លើកទឹកចិត្ត ដល់ ស្ត្រី ទាំងអស់ បន្ត ចូលរួម ឱ្យ បាន គ្រប់ សកម្មភាព សង្គម សំដៅ រួមចំណែក យ៉ាង ធំ ធេង ក្នុង ការលើកកម្ពស់ សីលធម៌ សង្គម តម្លៃ ស្ត្រី តម្លៃ គ្រួសារ ខ្មែរ និង ការអភិវឌ្ឍ ព្រោះថា សង្គម មួយ ប្រសិនបើ គ្មាន ការចូលរួម ពី ស្ត្រី សង្គម នោះ មិន អាច ដំណើរការ ទៅ បាន ដោយ រលូន នោះ ទេ ។
