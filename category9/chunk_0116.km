( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ៣កើត ខែ ផល្គុន ឆ្នាំ ថោះ បញ្ចស័ក ព .ស ២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១២ ខែមីនា ឆ្នាំ ២០២៤ ស្អែក នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា នឹង អញ្ជើញ ត្រួតពិនិត្យ ការសាងសង់ ព្រលានយន្តហោះ អន្តរជាតិ តេជោ ស្ថិត នៅ ឃុំ ព្រែក ស្លែង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ។
( ភ្នំពេញ ) ៖ វេទិកា រដ្ឋាភិបាល ឌីជីថល ឆ្នាំ ២០២៤ និង ពិព័រណ៍ រដ្ឋាភិបាល ឌីជីថល និង បច្ចេកវិទ្យា ឌីជីថល កម្ពុជា - អន្តរជាតិ បាន ចាប់ផ្តើម ហើយ សម្រាប់ រយៈពេល ៣ ថ្ងៃ គឺ ថ្ងៃទី ១១ - ១៣ ខែមីនា ឆ្នាំ ២០២៤ នៅ មណ្ឌល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ ។
សូម បញ្ជាក់ ថា ពិព័រណ៍ រដ្ឋាភិបាល ឌីជីថល និង បច្ចេកវិទ្យា ឌីជីថល កម្ពុជា - អន្តរជាតិ នៃ វេទិកា រដ្ឋាភិបាល ឌីជីថល ដែល ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី ១១ - ១៣ ខែមីនា ឆ្នាំ ២០២៤ ចាប់ពី ម៉ោង ៧:០០ នាទី ព្រឹក - ៦:០០ នាទី ល្ងាច នៅ មជ្ឈមណ្ឌល សន្និបាត និង ពិព័រណ៍ កោះ ពេជ្រ អគារ H-L ៕ សន្ដិ បណ្ឌិត គៀត ច័ន្ទ ថា រិទ្ធ ប្រាប់ នគរបាល អន្ដោប្រវេសន៍ ត្រូវ យកចិត្តទុកដាក់ ចំពោះ សភាពការណ៍ ពិភពលោក និង ក្ដាប់ ឲ្យបាន មុខ សញ្ញា ដែល ងាយ ឬ អាច បង្ក គ្រោះថ្នាក់ ចូលមក កម្ពុជា
( ភ្នំពេញ ) ៖ ក្នុង សន្និបាត បូកសរុប លទ្ធផល ការងារ និង លើក ទិសដៅ បន្ដ របស់ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ នៅ រសៀល ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៤ នេះ លោក សន្ដិ បណ្ឌិត គៀត ច័ន្ទ ថា រិទ្ធ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ បាន ផ្ដាំផ្ញើ ដល់ មន្ដ្រី នគរបាល នៃ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ ទាំងអស់ ត្រូវ បន្ដ យកចិត្តទុកដាក់ ចំពោះ ការវិវឌ្ឍន៍ របស់ សភាពការណ៍ ពិភពលោក ទាំង ក្នុង តំបន់ និង ក្រៅ តំបន់ ហើយ ក្ដាប់ ឲ្យបាន នូវ មុខ សញ្ញា ដែល ងាយ ឬ អាច បង្ក គ្រោះថ្នាក់ ចូលមក ប្រទេស កម្ពុជា ។
លោក សន្ដិ បណ្ឌិត គៀត ច័ន្ទ ថា រិទ្ធ បាន គូសបញ្ជាក់ ថា ការងារ អន្តោប្រវេសន៍ គឺជា កិច្ចការ ដ៏ សំខាន់ មួយ ក្នុង ចំណោម កិច្ចការ សំខាន់ ៗ ដ៏ទៃ ទៀត របស់ ជាតិ និង ក្រសួង មហាផ្ទៃ ដែល ការងារ នេះ មាន ការពាក់ព័ន្ធ ដោយ ផ្ទាល់ ទៅនឹង ការរក្សា សន្តិសុខ ជាតិ អធិបតេយ្យភាព ជាតិ បូរណភាព ទឹកដី សុវត្ថិភាព និង សណ្តាប់ធ្នាប់ សង្គម ក៏ ដូចជា ការទាក់ទាញ ភ្ញៀវ ទេសចរ និង វិនិយោគិន បរទេស ផងដែរ ដែល ក្រសួង មហាផ្ទៃ មាន ភារកិច្ច ទទួលខុស ត្រូវ ទាំងស្រុង ចំពោះ មុខ រាជ រដ្ឋាភិបាល និង ប្រជាជន ផងដែរ ។
លោក រដ្ឋលេខាធិការ បាន បន្ថែម ទៀត ថា ការងារ អន្តោប្រវេសន៍ មាន ឥទ្ធិពល ដល់ ការអនុវត្ត គោល នយោបាយ សំខាន់ ៗ របស់ រាជ រដ្ឋាភិបាល ដូច ជា៖ នយោបាយ ការបរទេស នយោបាយ ទេសចរណ៍ វិនិយោគ ពាណិជ្ជកម្ម និង សេដ្ឋកិច្ច ជាដើម ។ ហេតុ នេះ ហើយ ទើប ជានិច្ចកាល ថា្នក់ ដឹកនាំ ក្រសួង មហាផ្ទៃ តែងតែ យកចិត្តទុកដាក់ ពិនិត្យ តាមដាន និង ចង្អុល ដឹកនាំ លើ ការងារ នេះ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ។
លោក បន្ដ ថា ក្នុង ការអនុវត្ត កិច្ចការ ជំនាញ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ បាន ដើរ តួនាទី យ៉ាង សកម្ម ក្នុង ការរួមចំណែក ការពារ អធិបតេយ្យភាព ជាតិ ការពារ សន្តិសុខ សុវត្ថិភាព សង្គម តាមរយៈ ការយក ចិត្តទុកដាក់ ត្រួតពិនិត្យ ការចេញ - ចូល ឆ្លងកាត់ ច្រកទ្វារ អន្តរជាតិ នានា ដើម្បី បង្ការ ទប់ស្កាត់ ការ ជ្រៀត ចូល របស់ មុខ សញ្ញា ភេរវកម្ម មុខ សញ្ញា ឧក្រិដ្ឋកម្ម ឆ្លង ដែន គ្រប់ ប្រភេទ និង មុខ សញ្ញា ល្មើស ច្បាប់ ផ្សេង ៗ ទៀត ។
ទោះបី សភាពការណ៍ សាកល លោក និង តំបន់ មាន ការវិវត្ត ប្រែប្រួល ស្មុគស្មាញ យ៉ាង នេះ ក្តី ក៏ រាជ រដ្ឋាភិបាល នៅតែ ប្រកាន់ ជំហរ ពង្រឹង ពង្រីក កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ដើម្បី បើក ទូលាយ ការងារ ការទូត និង ទំនាក់ទំនង ពាណិជ្ជកម្ម វិនិយោគ ព្រមទាំង បន្ត អនុវត្ត គោល នយោបាយ បើក ចំហរ ជើង មេឃ ដើម្បី ស្រូបទាញ ភ្ញៀវ ទេសចរ និង អ្នក វិនិយោគ បរទេស បង្កើត ការងារ ជូន ពលរដ្ឋ និង បង្កើន ចំណូល ថវិកា ជាតិ ។
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន គណៈកម្មការ ប្រឡង ប្រជែង ជ្រើសរើស មន្ដ្រីរាជការ ស៉ី វិល នៅ រសៀល ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ អំពី បច្ចុប្បន្នភាព នៃ ការប្រកាស លទ្ធផល ប្រឡង ប្រជែង ជ្រើសរើស មន្ដ្រីរាជការ ឲ្យ ចូល បម្រើ ការងារ ក្នុង ក្របខ័ណ្ឌ អង្គភាព ប្រឆាំង អំពើពុករលួយ . ក្រសួង សាធារណៈ ការ និង ដឹកជញ្ជូន និង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ។
តាមរយៈ សន្និសីទ សារព័ត៌មាន ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី បាន គូសបញ្ជាក់ ថា៖
ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី បាន បន្ថែម ថា បេក្ខជន ដែល ត្រូវបាន ជ្រើសរើស ឲ្យ ចូល បម្រើ ការងារ ក្នុង ក្របខ័ណ្ឌ មន្ត្រីរាជការ ត្រូវ គោរព អនុវត្ត និង បំពេញ គ្រប់ លក្ខខណ្ឌ តម្រូវ ដោយ ច្បាប់ សហលក្ខន្តិកៈ មន្ត្រីរាជការ ស៊ីវិល និង លិខិត បទដ្ឋាន គតិយុត្ត ពាក់ព័ន្ធ ជាធរមាន របស់ រាជ រដ្ឋាភិបាល ព្រមទាំង មិន ធ្លាប់ ជាប់ ទណ្ឌកម្ម បណ្តេញ ចេញ ឬ លុប ឈ្មោះ ចេញ ពី ក្របខណ្ឌ មន្ត្រីរាជការ ទាំង ផ្នែក ស៊ីវិល និង កងកម្លាំងប្រដាប់អាវុធ ។
លោក បាន សង្កត់ធ្ងន់ ថា ក្នុង ករណី មិន បាន គោរព មិន បាន អនុវត្ត ឬ មិន បាន បំពេញ តាម លក្ខខណ្ឌ តម្រូវ បេក្ខជន នឹង ត្រូវ លុប ឈ្មោះ ទោះបី បាន ជាប់ ជាស្ថាពរ ជាប់ បម្រុង កម្មសិក្សា ការី ឬ ត្រូវបាន តាំង ស៊ប់ ក្នុង ក្របខណ្ឌ មន្ត្រីរាជការ ហើយក៏ ដោយ ។
តាមរយៈ លទ្ធផល ដែល បាន ប្រកាស នៅ ពេល នេះ លោក ហ៊ុន ម៉ានី បាន អះអាង ថា លទ្ធផល នៃ ការប្រឡង ប្រជែង នៅតែ ឆ្លុះបញ្ចាំង ពី សមត្ថភាព ចេះ គឺជាប់ ជាប់ ដោយ មោទនៈ ធ្លាក់ ដោយ អស់ចិត្ត ។ លោក បន្ដ ថា គណៈកម្មការ ប្រឡង ប្រជែង ក៏ ទុក រយៈពេល ១សប្ដាហ៍ ផងដែរ ដល់ បេក្ខជន ទាំងអស់ ធ្វើ ការតវ៉ា ចំពោះ លទ្ធផល របស់ ខ្លួន ក្នុង ករណី យល់ឃើញ ថា ខ្លួន មិន អស់ចិត្ត ចំពោះ អ្វី ដែល ជា លទ្ធផល នៅ ពេល នេះ ៕
សូម ទស្សនា កិច្ចសម្ភាស របស់ ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី ទាំងស្រុង នៅ ខាងក្រោម នេះ៖
ជនជាតិ ចិន ម្នាក់ បម្រុង នាំ គ្រឿងញៀន ពី កម្ពុជា ទៅ ជប៉ុន ត្រូវ សមត្ថកិច្ច ឃាត់ខ្លួន ព្រលានយន្តហោះ ភ្នំពេញ ដកហូត ថ្នាំ ញៀន ជិត ៥គីឡូក្រាម
( ភ្នំពេញ ) ៖ ជនជាតិ ចិន ម្នាក់ ( តៃវ៉ាន់ ) បម្រុង នាំ គ្រឿងញៀន ពី កម្ពុជា ទៅ ជប៉ុន តាម ជើងហោះហើរ ក៏ ត្រូវ សមត្ថកិច្ច កម្ពុជា បង្ក្រាប និង ឃាត់ខ្លួន បាន នៅ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ព្រមទាំង ដកហូត ថ្នាំ ញៀន ចំនួន ៤៩៦៥. ៣០ក្រាម ។
ក្រោយ ការឃាត់ខ្លួន សមត្ថកិច្ច ជំនាញ បាន កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការ តាម ផ្លូវ ច្បាប់ ។
សូម ជម្រាប ថា ដោយ ទទួលបាន បទបញ្ជា ដ៏ ម៉ឺងម៉ាត់ របស់ នាយ ឧត្ដមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ជំរុញ ឱ្យ ធ្វើ ការបោសសម្អាត ឧក្រិដ្ឋ ជន គ្រឿងញៀន ឲ្យ អស់ កម្លាំង ជំនាញ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បាន ប្តេជ្ញាចិត្ត និង ខិតខំ ចុះបង្ក្រាប គ្រឿងញៀន តាម បណ្ដា រាជធានី - ខេត្ដ យ៉ាង សស្រាក់សស្រាំ ដូច ភ្លៀង រលឹម ធ្វើ យ៉ាងណា បង្ក្រាប ឱ្យ ដល់ ឫសគល់ នៃ បទល្មើស ។
ជា ការគត់ សម្គាល់ កម្លាំង ជំនាញ នៃ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ដែល ដឹកនាំ ដោយ ឧត្តមសេនីយ៍ ឯក ឃឹង សារ៉ាត់ បង្ក្រាប បាន ករណី ជួញដូរ គ្រឿងញៀន ជាប្រចាំ ស្ទើរតែ រាល់ ថ្ងៃ ដោយ ឃាត់ខ្លួន ឧក្រិដ្ឋ ជន បញ្ជូន ទៅ តុលាការ ដើម្បី អនុវត្តន៍ នីតិវិធី ៕ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនីរាជា រៀបចំ កិច្ចប្រជុំ ពិភាក្សា ស្តីពី ផែនការអភិវឌ្ឍ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ឆ្នាំ ២០២៤ - ២០២៥ (Video inside)
( ភ្នំពេញ ) ៖ សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី ព្រះ សាកលវិទ្យាធិការ នៅ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា ស្តីពី ផែនការអភិវឌ្ឍ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ នៃ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា ឆ្នាំ ២០២៤ - ២០២៥ ។
ក្នុង កិច្ចប្រជុំ នេះ Dr. Kerl តំណាង ក្រុមប្រឹក្សា ទទួលស្គាល់ គុណភាព នៃ ប្រទេស អូស្ត្រាលី បាន ថ្វាយ ពានរង្វាន់ កោតសរសើរ ស្នា ព្រះហស្ត ដ៏ ថ្លៃថ្លា របស់ សម្តេច ជា អម្ចាស់ ដែល បាន យក ព្រះទ័យ ទុកដាក់ ប្រឹងប្រែង អភិវឌ្ឍ ពុទ្ធិក សាកលវិទ្យាល័យ ឱ្យ មាន ការរីកចំរើន រុងរឿង កំណើន នៃ ការចុះឈ្មោះ ចូលរៀន របស់ និស្សិត និង ការផ្តល់ អាហារូបករណ៍ ជូន ដល់ និស្សិត មកពី គ្រប់ ទិសទី នៃ ប្រទេស កម្ពុជា ។
សម្តេច ជា អម្ចាស់ ថ្នាក់ដឹកនាំ និង គណៈប្រតិភូ អន្តរជាតិ បាន ថត រូប អនុស្សាវរីយ៍ ជុំគ្នា ប្រកបដោយ ស្នាមញញឹម បង្ហាញ ពី មិត្តភាព សាមគ្គីភាព និង កិច្ចសហប្រតិបត្តិការ ដ៏ រឹងមាំ ៕ កាកបាទ ក្រហម កម្ពុជា ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤ ដោយ អំពាវនាវ ដល់ សប្បុរសជន បន្ត ចូលរួម បរិច្ចាគ ថវិកា និង សម្ភារៈ
( ភ្នំពេញ ) ៖ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជា ព្រះប្រធាន កិត្តិយស និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ខួប លើក ទី ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ២០២៤ ក្រោម ប្រធានបទ « រួមគ្នា ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដើម្បី សហគមន៍ មាន សុខភាព ល្អ និង មាន ភាពធន់ នឹង អាកាសធាតុ » ។
តាម សេចក្តីប្រកាស របស់ កាកបាទ ក្រហម កម្ពុជា ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៤ បាន ឲ្យដឹង ថា ការប្រារព្ធ ខួប ១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ដើម្បី រំលឹក ដល់ ខួប នៃ ការបង្កើត ចលនា អន្តរជាតិ កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម និង ជា ឱកាស បង្ហាញ ពី បេសកកម្ម មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ជូន សាធារណជនជាតិ និង អន្តរជាតិ ។
តាមរយៈ ការប្តេជ្ញាចិត្ត ខ្ពស់ របស់ សមាគម ជាតិ រួម ជាមួយ រាជ រដ្ឋាភិបាល នីតិកាល់ទី៧ នៃ រដ្ឋសភា ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ ការលើកកម្ពស់ វិស័យ សុខភាព សាធារណៈ និង ការពង្រឹង ភាពធន់ របស់ សហគមន៍ ទៅនឹង ការប្រែប្រួល អាកាសធាតុ កាកបាទ ក្រហម កម្ពុជា ត្រូវ ការចាំបាច់ នូវ ការជួយ ឧបត្ថម្ភ គាំទ្រ ពី សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន ដើម្បី ធានា បន្ត និរន្តរភាព ការងារ របស់ ខ្លួន ។
អាស្រ័យ ហេតុ នេះ កាកបាទ ក្រហម កម្ពុជា សូម អំពាវនាវ ចំពោះ សម្តេច ឯកឧត្តម លោកជំទាវ អ្នក ឧកញ៉ា ឧកញ៉ា លោក លោកស្រី អ្នកនាង កញ្ញា សូម បន្ត ចូលរួម បរិច្ចាគ ថវិកា សម្ភារៈ ជូន កាកបាទ ក្រហម កម្ពុជា ដើម្បីឱ្យ សមាគម ជាតិ មាន ធនធាន និង លទ្ធភាព គ្រប់គ្រាន់ ក្នុង ការបន្ត ផ្តល់ សេវាកម្ម មនុស្សធម៌ ជួយ ដល់ ជនរងគ្រោះ និង ជន ងាយ រងគ្រោះ បំផុត ប្រកបដោយ បរិយាប័ន្ន ។
ទន្ទឹមនឹង នេះ កាកបាទ ក្រហម កម្ពុជា មាន សង្ឃឹម យ៉ាង មុតមាំ ថា សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន នឹង ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ កាកបាទ ក្រហម កម្ពុជា ដោយ សទ្ធា ជ្រះថ្លា និង តាម ការស្ម័គ្រចិត្ត ពុំ ខាន ឡើយ ។
កាកបាទ ក្រហម កម្ពុជា មាន ក្រុម ប្រចាំ ការទទួល បដិសណ្ឋារកិច្ច និង រៀបចំ កម្មវិធី ប្រគល់ - ទទួល ថវិកា សម្ភារៈ ពី សប្បុរសជន គ្រប់ មជ្ឈដ្ឋាន រៀងរាល់ ម៉ោង ធ្វើការចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា ៕
ចំពោះ ការបរិច្ចាគ តាមរយៈ គណនី ធនាគារ របស់ កាកបាទ ក្រហម កម្ពុជា នឹង មាន ជម្រើស ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ លោក ស៊ន សៀប ប្រធាន សមាគម អ្នក វាយតម្លៃ និង ភ្នាក់ងារ អចលន វត្ថុ កម្ពុជា នៅ ថ្ងៃទី ១១ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន លើកឡើង ថា វិស័យ ចលន ទ្រព្យ នៅ កម្ពុជា ឆ្នាំ ២០២៤ នេះ មាន ភាពវិជ្ជមាន ជាង ឆ្នាំ ២០២៣ ។
ទន្ទឹម គ្នា នេះ ប្រធាន សមាគម រូប នេះ បាន បង្ហាញ ក្ដី រំពឹង ថា វិស័យ ចលន ទ្រព្យ នៅ កម្ពុជា នឹង ត្រឡប់ ទៅ រក ស្ថានភាព ល្អ ឡើងវិញ នៅ ឆ្នាំ ២០២៦ ឬ ឆ្នាំ ២០២៧ ។
លោក បាន លើកឡើង ថា អចលន ទ្រព្យ តាម ការសង្កេត របស់ លោក បន្ទាប់ពី សេដ្ឋកិច្ច ធ្លាក់ចុះ ប្រហែលជា ៦ខែ ទៅ១ ឆ្នាំ គឺ ចាប់ផ្ដើម ចុះ តាម ក្រោយ ដែរ ហើយ នៅ ដែល សេដ្ឋកិច្ច ឡើង ៦ខែ ទៅ១ ឆ្នាំ ឡើង ដែរ ។
