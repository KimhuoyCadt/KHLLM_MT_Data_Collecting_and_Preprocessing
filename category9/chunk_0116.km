( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន ស្តីពី ការចោទប្រកាន់ ជនជាតិ ចិន ចំនួន ០៣ នាក់ និង ជនជាតិ ម៉ាឡេស៊ី ចំនួន ០១ នាក់ ករណី គ្រឿងញៀន ទម្ងន់ ប្រមាណ ៦គីឡូក្រាម និង សម្អាត ប្រាក់ ។
ជា លទ្ធផល សមត្ថកិច្ច បាន ឃាត់ខ្លួន ជនសង្ស័យ ជនជាតិ ចិន ចំនួន ០៣ នាក់ និង ជនជាតិ ម៉ាឡេស៊ី ចំនួន ០១នាក់ រកឃើញ សារធាតុ ញៀន ប្រភេទ មេតំហ្វេតាមីន មាន ទម្ងន់ ១. ៦៤៨ ក្រាម ប្រភេទ DMA មាន ទម្ងន់ ២. ៣៣៦. ៥២ ក្រាម ប្រភេទ កេតាមីន មាន ទម្ងន់ ៧២៤. ៩០ ក្រាម កញ្ជា ក្រៀម មាន ទម្ងន់ ១០៨. ០៩ ក្រាម និង សារធាតុ មិន ច្បាស់ ទម្ងន់ ៩២៥. ០២ ក្រាម ព្រមទាំង ភស្តុតាង មួយចំនួន ដែល សង្ស័យ ជាប់ពាក់ព័ន្ធ នឹង ការសម្អាត ប្រាក់ ។
ក្រោយ បញ្ចប់ ប្រតិបត្តិការ នេះ សមត្ថកិច្ច បាន កសាង សំណុំរឿង និង បញ្ជូន ជនសង្ស័យ ខាងលើ មកកាន់ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ។ ចំណែកឯ បក្ខពួក ដែល ពាក់ព័ន្ធ នឹង ករណី គ្រឿងញៀន ខាងលើ នេះ សមត្ថកិច្ច បាន នឹង កំពុង ស្រាវជ្រាវ បញ្ជូន មក អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ចាត់ការស្រប តាម នីតិវិធី ច្បាប់ ។
សម្តេច តេជោ ហ៊ុន សែន៖ ហេតុ អ្វី បានជា មកដល់ ពេលនេះ ហើយ មាន មន្ត្រី យើង ប្រព្រឹត្ត បែប នេះ ដោយ ពាក់ ស្បែកជើង ចូលក្នុង ព្រះវិហារ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហាញ ការប្រតិកម្ម ចំពោះ មន្ត្រី មួយ រូប ដែល ពាក់ ស្បែកជើង ចូលក្នុង ព្រះវិហារ ដែល ជាទីគោរព សក្ការៈ របស់ បងប្អូន ប្រជាពលរដ្ឋ ។
វេទិកា អាជីវកម្ម លើក ទី១ ឆ្នាំ ២០២៤ របស់ សមាគម នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា ជួយ បង្កើត ទំនាក់ទំនង រវាង អ្នកចូលរួម សម្រាប់ ម្ចាស់ អាជីវកម្ម និង ប្រតិបត្តិករ
សមាគម នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា ជា សមាគម អតីត អ្នកចូលរួម កម្មវិធី នា វា យុវជន អាស៊ី អាគ្នេយ៍ និង ជប៉ុន ដែល ជា កម្មវិធី ផ្លាស់ យុវជន ក្នុង តំបន់ ដ៏ ធំ មួយ ចាប់បដិសន្ធិ តាំងពី ឆ្នាំ ១៩៧៤មក ម្ល៉េះ និង មាន យុវជន ចូលរួម មកពី បណ្តា ប្រទេស អាស៊ាន និង ជប៉ុន ប្រមាណ ១២.០០០ រូប ។ កម្ពុជា បាន ចូលរួម ពេញ សិទ្ធិ ក្នុង កម្មវិធី នេះ កាលពី ឆ្នាំ ២០០០ បន្ទាប់មក សមាគម នា វា យុវជន អាស៊ី អាគ្នេយ៍ កម្ពុជា ត្រូវបាន បង្កើតឡើង ក្នុង ឆ្នាំ ២០០៤ ។
មូលបទ នៃ វេទិកា នេះ មាន ចំណងជើង ថា « និរន្តរភាព អាជីវកម្ម សម្រាប់ សហគ្រាស ធុន តូច និង មធ្យម៖ ការដោះស្រាយ បញ្ហា ប្រឈម ផ្នែក ហិរញ្ញវត្ថុ និង ផ្នែក ផ្សេង ៗ ទៀត » ។ ក្នុង បរិការណ៍ សកល ដែល មាន ភាព មិន ប្រាកដប្រជា ខ្ពស់ បន្ទាប់ពី មាន ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ១៩ និង សង្គ្រាម ដែល កំពុង កើត មាន ឡើង ក្នុង ពិភពលោក សហគ្រាស ធុន តូច និង មធ្យម កាន់តែ ត្រូវ ផ្តោត សំខាន់ ណាស់ លើ ការធានា នូវ និរន្តភាព អាជីវកម្ម ។
គន្លឹះ សំខាន់ ៗ ក្នុង ការកសាង អាជីវកម្ម ឱ្យ កាន់តែ មាន ភាពធន់ មាំ ចីរភាព និង ភាពចំណេញ ខ្ពស់ គឺជា ចំណេះដឹង និង បទពិសោធ ដ៏ មាន តម្លៃ ក្នុង ការឆ្លើយតប និង ជួយ ដល់ សហគ្រាស ទាំងឡាយ ក្នុង គ្រា ដ៏ ចាំបាច់ នេះ ។ ក្នុង វេទិកា នេះ ប្រធានបទ មួយ ចំនួន ត្រូវបាន យកមក ធ្វើ បទបង្ហាញ និង ពិភាក្សា ដេញដោល ដោយ មាន ការសម្របសម្រួល ដោយ លោក ស៊ាង សុបញ្ញា អគ្គ នាយក វិទ្យាស្ថាន អន្តរជាតិ ខេម - អាស៊ាន និង ជា អតីត ប្រធាន សមាគម នេះ ផងដែរ ។ ប្រធានបទ ទាំងនោះ រួម មាន៖
លទ្ធផល នៃ ការពិភាក្សា នេះ ត្រូវបាន រំពឹង ថា នឹង ក្លាយជា ចំណេះដឹង និង បទពិសោធន៍ ដែល ជា ធាតុ ចូល ដ៏ សំខាន់ សម្រាប់ ម្ចាស់ អាជីវកម្ម និង ប្រតិបត្តិករ ទាំងឡាយ យក ទៅ អនុវត្ត ក្នុង សហគ្រាស របស់ ខ្លួន ។
( ព្រះវិហារ ) ៖ លោក ស៊ាប កែវ ជីវ៉ា អភិបាល ស្រុក សង្គម ថ្មី ខេត្ត ព្រះវិហារ បាន អំពាវនាវ ប្រគេន ព្រះសង្ឃ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ជិត ឆ្ងាយ ត្រូវ ចូលរួម សាមគ្គី គ្នា ដើម្បី ធ្វើ ការអភិវឌ្ឍ ទី វត្តអារាម មួយ ក្នុង ទីប្រជុំជន ស្រុក ឱ្យ មាន ការរីកចម្រើន ។
ការអំពាវនាវ បែប នេះ របស់ លោក ស៊ាប កែវ ជីវ៉ា បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ដឹកនាំ មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ ចំណុះ រដ្ឋបាល ស្រុក សង្គម ថ្មី ចូលរួម ក្នុង ពិធី បុណ្យ ផ្កា ប្រាក់ សាមគ្គី នៅ វត្ត តេជៈ រង្សី ហៅ វត្ត បឹង ស្ថិត ក្នុង ភូមិ ប្រធាតុ ឃុំ ចម្រើន ស្រុក សង្គម ថ្មី នា ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ ។
នៅក្នុង ឱកាស នេះ ដែរ លោក ស៊ាប កែវ ជីវ៉ា បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ ប្រគេន ព្រះសង្ឃ និង ជូន ប្រជាពលរដ្ឋ ដែល មាន វត្តមាន នៅ ទីនេះ ក៏ ដូចជា ប្រជាពលរដ្ឋ ទូទាំង ស្រុក សង្គម ថ្មី ទាំងមូល ។
លោក អភិបាល ស្រុក សង្គម ថ្មី គូសបញ្ជាក់ ថា៖ « ដោយឡែក វត្ត តេជៈ រង្សី ហៅ វត្ត បឹង ដែល យើង កំពុង ជួបជុំគ្នា នា ពេលនេះ ក៏ មាន ការរីកចម្រើន ជាបន្តបន្តាប់ ដែរ ដោយ យើង បាន សម្ពោធ ខ្លោងទ្វារ ដ៏ ស្រស់ស្អាត ក្រោម វត្តមាន លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ កាលពី ឆ្នាំ កន្លងទៅ ហើយ ពេលនេះ យើង បាន ធ្វើ បុណ្យ ផ្កា ប្រាក់ សាមគ្គី រួមគ្នា ទៀត ដើម្បី ប្រមូល បច្ច័យ មក កសាង ទី អារាម ក្នុង ទីប្រជុំជន ស្រុក នេះ ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត » ។
លោក អភិបាល ស្រុក សង្គម ថ្មី បាន ប្រគេន ព្រះសង្ឃ និង ជម្រាប ជូន មន្ត្រីរាជការ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម សាមគ្គី គ្មា ដើម្បី ធ្វើ ការអភិវឌ្ឍ វត្រតេជៈ រង្សី ហៅ វត្ត បឹង ឱ្យ មាន ការរីកចម្រើន ដើម្បី ជា ទី សក្ការ បូជា សម្រាប់ ព្រះសង្ឃ និង ពុទ្ធ បរិស័ទ ជិត ឆ្ងាយ ។ នៅក្នុង ឱកាស នេះ ដែរ ក្នុង នាម រដ្ឋបាល ស្រុក សង្គម ថ្មី លោក បាន ចូល បច្ច័យ ផ្កា ប្រាក់ សាមគ្គី ចំនួន ៥១. ០០០០ រៀល ផងដែរ ៕
ការបោះឆ្នោត ប្រធានាធិបតី នៅ រុស្ស៉ី ចូល ដល់ ថ្ងៃ ចុងក្រោយ ខណៈ ទីក្រុង មូស្គូ ចោទ អ៊ុយក្រែន ប៉ុនប៉ង បំផ្លាញ ដំណើរការបោះឆ្នោត របស់ ខ្លួន
( មូស្គូ) ៖ នៅ ថ្ងៃអាទិត្យ នេះ ប្រទេស រុស្ស៉ី បាន ចាប់ផ្តើម ថ្ងៃ ចុងក្រោយ នៃ ដំណើរការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី ខណៈ ទីក្រុង មូស្គូ បាន ចោទ អ៊ុយក្រែន អំពី ការប្រើប្រាស់ សកម្មភាព វាយប្រហារ តាម ផ្លូវ អាកាស ក្នុង ចេតនា ប៉ុនប៉ង បំផ្លាញ ការបោះឆ្នោត របស់ ខ្លួន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នា ថ្ងៃអាទិត្យ ទី១៧ ខែមីនា ឆ្នាំ ២០២៤ ។
លោក ពូទីន ក៏ បាន ប្តេជ្ញា ថា នឹង សងសឹក ចំពោះ ការវាយប្រហារ របស់ អ៊ុយក្រែន ផងដែរ ។ បើ តាម ក្រុម មន្រ្តី រុស្ស៉ី នា ថ្ងៃអាទិត្យ នេះ កងកម្លាំង អ៊ុយក្រែន ហាក់ នៅតែ បន្ត ការវាយប្រហារ របស់ ខ្លួន មក លើ បណ្តា តំបន់ របស់ រុស្ស៉ី ដែល នៅក្បែរ ព្រំប្រទល់ អ៊ុយក្រែន ។ ទីក្រុង កៀវ ចាត់ទុក ការបោះឆ្នោត ប្រព្រឹត្តទៅ នៅ តាម ដែនដី របស់ ខ្លួន ដែល គ្រប់គ្រង់ ដោយ រុស្ស៉ី ជា ទង្វើ ខុស ច្បាប់ និង គ្មាន សុពលភាព ។
គួរ បញ្ជាក់ ថា ប្រជាជន រុស្ស៉ី សរុប ជាង ១១៤លាន នាក់ មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ហើយ បើ តាម គណៈកម្មាធិការ កណ្តាល រៀបចំ ការបោះឆ្នោត របស់ រុស្ស៉ី គិត ត្រឹម ល្ងាច ថ្ងៃសៅរ គឺជាង ៦៣លាន នាក់ ក្នុង ចំណោម នោះ បាន ទៅ បោះឆ្នោត រួចរាល់ អស់ ហើយ ៕
សម្តេច រដ្ឋសភា ធិបតី ឃួន សុដារី ថ្លែងអំណរគុណ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ចំពោះ មរណភាព ឯកឧត្ដម ឃួន ផល្លា រិទ្ធ ដែល ត្រូវ ជា ប្អូន បង្កើត របស់ សម្តេច
( ភ្នំពេញ ) ៖ សម្តេច មហា រដ្ឋសភា ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា កម្ពុជា នៅ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន ផ្ញើ សារ ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល បាន ផ្ញើ សារ ចូលរួម រំលែក មរណទុក្ខ ចំពោះ មរណភាព ឯកឧត្ដម ឃួន ផល្លារិទ្ធ នាយក រង ខុទ្ទកាល័យ និង ជា ប្អូន បង្កើត របស់ សម្ដេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ។
( ភ្នំពេញ ) ៖ ការបើក ដំណើរការ អាជីវកម្ម ក្រុមហ៊ុន សហគ្រាស មិន មែន ជា រឿង ងាយស្រួល នោះ ហើយ គេ សង្កេតឃើញ ថា មាន ក្រុមហ៊ុន ថ្មី ៗ ជាច្រើន បើក ដំណើរការ រួចហើយ ក៏ ត្រូវបាន បិទ អាជីវកម្ម ទៅ វិញ ។
លោក បាន ពន្យល់ ថា ក្នុង ការបើក ដំណើរការ ក្រុមហ៊ុន ឬ សហគ្រាស មួយ មិន មែន បើក ថ្ងៃ នេះ អាច ធ្វើ អ្នក មាន ស្អែក បាន នោះ ទេ ព្រោះ ការបើក ដំណើ ការ ក្រុមហ៊ុន តែងតែ មាន ឧបសគ្គ ហើយ ពេល ខ្លះ ចំណូល ដែល ទទួលបាន គឺ មិន ដូច ការរំពឹងទុក របស់ យើង នោះ ទេ ។ ហេតុ ដូច្នេះហើយ ម្ចាស់ ក្រុមហ៊ុន សហគ្រាស ជាពិសេស សហគ្រាស ថ្មី ថ្មោង ត្រូវតែ រៀបចំ ផែនការគិត ទុក ជាមុន ថា តើ នៅពេល មាន បញ្ហា ឬ ទទួលបាន ចំណូល ទាប អាច រស់ បាន ដោយ របៀប ណា ?
លោក បន្ថែម ថា ជាក់ស្តែង ឃើញ ថា ស្ថានភាពសង្គម តែងតែ ប្រែប្រួល ដែល យើង មិន អាច ដឹង មុន បាន ដូចជា ករណី ជំងឺ កូវីដ១៩ បញ្ហា សង្រ្គាម រុស្ស៊ី អ៊ុយក្រែន ជាដើម ដែល បាន ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច សកល និង ប៉ះពាល់ ដល់ អាជីវកម្ម ជាច្រើន ហេតុ នេះ ហើយ យើង ត្រូវ រៀបចំ យុទ្ធសាស្រ្ត ដើម្បី ទប់ទល់ ជាមួយ ស្ថានការណ៍ ទាំងនេះ ដែល មាន ន័យ ថា នៅពេល បើក ដំណើរការ ហើយ មិន ដំណើរការ ដូច យើង បាន គិត តើ យើង អាច រស់ បាន ទេ នេះ គឺជា ចំណុច ដែល ម្ចាស់ អាជីវកម្ម ត្រូវតែ គិត ៕
សូម ទស្សនា ការពន្យល់ បន្ថែម របស់ ឧកញ៉ា ឱសថ បណ្ឌិត ហៃ លី អ៊ាង ៖
បើកបរ កុំ ល្មើស ល្បឿន កំណត់ ! ស្លាប់ ៧នាក់ និង របួស ១៤នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៦ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ និង របួស ធ្ងន់ ស្រាល ១៥ នាក់ ។
កម្លាំង នគរបាល ឃាត់ខ្លួន ជនសង្ស័យ ៣នាក់ ក្រោយ ឆក់ កាបូប ស្ពាយ របស់ ជន បរទេស នៅលើ សួនច្បារ មាត់ ទន្លេ ខណ្ឌ ដូនពេញ
( ភ្នំពេញ ) ៖ ដោយ អនុវត្ត តាម បទបញ្ជា របស់ ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ . នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ កម្លាំង ជំនាញ ខណ្ឌ សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ផ្សារ កណ្តាល ទី១ ខណ្ឌ ដូនពេញ បាន ស្រាវជ្រាវ ឈានដល់ បង្ក្រាប ជនសង្ស័យ ចំនួន ៣នាក់ ( ស្រី ម្នាក់ ) ពាក់ព័ន្ធ នឹង ករណី ឆក់ កាបូប ស្ពាយ កាលពី ថ្ងៃទី ៣ ខែមីនា ឆ្នាំ ២០២៤ នៅលើ សួនច្បារ មាត់ ទន្លេ ផ្លូវ ព្រះស៊ីសុវត្ថិ សង្កាត់ ផ្សារ កណ្តាល ទី១ ។
បច្ចុប្បន្ន ជនសង្ស័យ ខាងលើ សមត្ថកិច្ច កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម នីតិវិធី ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ២៩៣ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៦.៥៤១ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៥.០៣៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៥០៨ គ្រឿង ។
( កំពត ) ៖ អ្នក ម្នាង ស៊ីសុវត្ថិ គន្ធីរ៉េត អគ្គ ស្នងការរង សមាគម កាយ ឬទ្ធិ នារី ក ម្កុជា បាន លើកទឹកចិត្ត ដល់ សមាជិក ថ្មី នៃ សមាគម កាយ ឫទ្ធិ កម្ពុជា សូម បន្ត យកចិត្តទុកដាក់ ខិតខំ រៀនសូត្រ និង អភិវឌ្ឍន៍ ខ្លួន ឲ្យ កាន់តែ ប្រសើរ ក្នុង នាម ជា កូន ល្អ សិស្ស ល្អ និង ជា ប្រជាពលរដ្ឋ ល្អ របស់ ប្រទេសជាតិ ដែល មាន ការទទួលខុសត្រូវ ចំពោះ ខ្លួន ផង គ្រួសារ សមាគម និង ប្រទេសជាតិ ផង ។
អ្នក ម្នាង អគ្គ ស្នងការ រង បាន បញ្ជាក់ ថា សមាគម មិន ត្រឹមតែ ផ្តល់ ឱកាស ឲ្យ សមាជិក ថ្មី បាន ស្វែងយល់ ពី សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា ប៉ុណ្ណោះ ទេ សមាជិក ថ្មី មាន ឱកាស ចូលរួម ក្នុង សកម្មភាព ផ្សេង ៗ ជាមួយ សមាគម និង សកម្មភាព នានា ដែល មាន ប្រយោជន៍ ដល់ សង្គមជាតិ និង ភាព ជា អ្នកដឹកនាំ ទៅ ថ្ងៃ អនាគត ផងដែរ ។
អ្នក ម្នាង បាន លើកទឹកចិត្ត ដល់ សមាជិក ថ្មី បន្ត យកចិត្តទុកដាក់ ខិតខំ រៀនសូត្រ និង អភិវឌ្ឍន៍ ខ្លួន ឲ្យ កាន់តែ ប្រសើរ ក្នុង នាម ជា កូន ល្អ សិស្ស ល្អ និង ជា ប្រជាពលរដ្ឋ ល្អ របស់ ប្រទេសជាតិ ។
លោកស្រី ហ៊ុន ចាន់ ធី ប្រធាន ក្រុមប្រឹក្សា សមាគម កាយ ឬទ្ធិ នារី ក ម្កុជា សាខា ខេត្ត កំពត បាន ថ្លែង ថា សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ មាន ភាពប៉ិនប្រសប់ ប្រកបដោយ បទពិសោធន៍ និង គោលដៅ ជាក់លាក់ របស់ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី អគ្គ ស្នងការ សមាគម កាយ ឫទ្ធិ នារី កម្ពុជា អាណត្តិ ថ្មី ឆ្នាំ ២០២១ - ២០២៤. សមាគម សម្រេចបាន នូវ វឌ្ឍនភាព ការងារ និង សមិទ្ធផល ជាច្រើន គួរឱ្យ កត់សម្គាល់ ។
លោក បាន ជម្រាប ថា បច្ចុប្បន្ន រាជ រដ្ឋាភិបាល បាន បង្កើត គណៈកម្មាធិការ សម្របសម្រួល ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ និង កំពុង រៀបចំ ផែនការ សកម្មភាព ព្រមទាំង យន្ត ការប្រមូល ទិន្នន័យ ជាមួយ ភាគី ពាក់ព័ន្ធ ដើម្បី កំណត់ និង វាយតម្លៃ ជា មូលដ្ឋាន ទិន្នន័យ ពាក់ព័ន្ធ នឹង សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ មុននឹង ឈានដល់ ការអភិវឌ្ឍ ប្រព័ន្ធ ចុះឈ្មោះ នា ពេល ខាងមុខ ដើម្បី កំណត់ បាន គោលដៅ ច្បាស់លាស់ សម្រាប់ ការទទួលបាន ជំនួយ ជាក់ស្តែង ពី រាជ រដ្ឋាភិបាល ។
បងប្អូន សកម្មជន នៃ ផែន សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ បាន បង្ហាញ អារម្មណ៍ ស្វាគមន៍ រីករាយ ដោយ បាន យល់ ជ្រួតជ្រាប អំពី ការងារ ជំរុញ និង លើកកម្ពស់ សេដ្ឋកិច្ច ក្រៅ ប្រព័ន្ធ របស់ រាជ រដ្ឋាភិបាល និង បាន បង្ហាញ ការគាំទ្រ យ៉ាង ខ្លាំង លើ កម្មវិធី គោល នយោបាយ ខាងលើ តាមរយៈ ការទទួលបាន ការយកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ទាំង ក្នុង ទិដ្ឋភាព គណបក្ស និង ក្នុង ទិដ្ឋភាព គោល នយោបាយ ជាតិ ។
សមិទ្ធផល នានា ក្នុង វត្ត ឈ្នួន ក្នុង ស្រុក រវៀង ខេត្ត ព្រះវិហារ ដែល ចំណាយ ការកសាង ថវិកា ប្រមាណ ១០មុឺន ដុល្លា ត្រូវ រៀបចំ ឆ្លង ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ
( ព្រះវិហារ ) ៖ សមិទ្ធផល នានា នៅក្នុង វត្ត ចន្ទ រង្សី និមិត្ត ហៅ វត្ត ឈ្នួន ដែល កសាង អស់ ថវិកា ចំនួន ៩៦. ៨៦៥ ដុល្លា ស្ថិត ក្នុង ឃុំ រួសរាន់ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ត្រូវបាន រៀបចំ ពិធី ឆ្លង ជា ផ្លូវការ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ហោ ប៊ុន ហួរ អភិបាល ស្រុក រវៀង ដោយ មាន ការនិមន្ត និង អញ្ជើញ ចូលរួម ពី មន្ត្រីរាជការ ព្រះសង្ឃ ប្រជាពលរដ្ឋ ជិត ឆ្ងាយ យ៉ាង ច្រើន កុះករ ។
សមិទ្ធផល នានា នៅក្នុង វត្ត ចន្ទ រង្សី និមិត្ត ហៅ វត្ត ឈ្នួន ដែល រៀបចំ ពិធី ឆ្លង នា ពេលនេះ ចាប់ផ្តើ សាងសង់ តាំងពី ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០១៩មក ម្លេះ រួម មាន៖ ប្លង់ សេ ចំណាយ ថវិកា ចំនួន ១៨៥ លាន រៀល ដំបូល ព្រះវិហារ ចំណាយ ថវិកា ចំនួន ៤មុឺន ដុល្លារ បន្ទប់ទឹក ចំនួន ៥ ចំណាយ ថវិកា ចំនួន ១៧លាន រៀល ចាក់ ដី ក្នុង វត្ត ចំណាយ ថវិកា ចំនួន ១៥ លាន រៀល ផ្លូវ ចាក់ បេតុង ចំណាយ ថវិកា ចំនួន ២៦១៥ ដុល្លារ ។
នៅក្នុង ឱកាស នេះ ដែរ លោក ហោ ប៊ុន ហួរ បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ និង លោក អ៊ុក គឹម សាន ប្រធាន ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក រវៀង ប្រគេន ព្រះសង្ឃ និង ជូន ប្រជាពលរដ្ឋ ដែល មាន វត្តមាន នៅ ទីនេះ ក៏ ដូចជា ប្រជាពលរដ្ឋ ទូទាំង ស្រុក រវៀង ទាំងមូល ។
លោក អភិបាល ស្រុក រវៀង បាន ចូលរួម អបអរសាទរ ជាមួយ ព្រះសង្ឃ ប្រជាពលរដ្ឋ ចំពោះ សមិទ្ធផល នានា នៅក្នុង ចន្ទ រង្សី និមិត្ត ហៅ វត្ត ឈ្នួន ដែល បាន រៀបចំ ពិធី ឆ្លង នា ថ្ងៃ នេះ ។ លោក ចាត់ទុក សមិទ្ធផល ទាំងនេះ ជា សមិទ្ធផល រួម ទាំងអស់ គ្នា ដែល កើតឡើង ដោយ ការចូលរួម ពី ព្រះសង្ឃ អាជ្ញាធរ មូលដ្ឋាន ប្រជាពលរដ្ឋ ជិត ឆ្ងាយ ។
លោក ហោ ប៊ុន ហួរ បាន ប្រគេន ព្រះសង្ឃ និង ជម្រាប ជូន ប្រជាពលរដ្ឋ ពី តម្លៃ នៃ សន្តិភាព ដែល ធ្វើឱ្យ យើង មាន ឱកាស បាន ជួបជុំគ្នា មាន ឱកាស បាន កសាង សមិទ្ធផល រួមគ្នា ពិសេស ធ្វើឱ្យ ប្រទេសជាតិ ទាំងមូល មាន ការអភិវឌ្ឍ រីកចម្រើន គ្រប់ វិស័យ ។
លោក ក៏ បាន អំពាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ បន្ត រួមគ្នា ការពារ សុខ សន្តិភាព ឱ្យ នៅ គង់វង្ស យូរអង្វែង ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជា នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ត្រូវ ចូលរួម គាំទ្រ កម្មវិធី នយោបាយ នានា របស់ រាជ រដ្ឋាភិបាល ពិសេស គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព ទាំង ៧ចំណុច ៕
ករណី ភ្លើង ឆេះ ព្រៃ នៅ ចំណុច ជ្រោះ ឪម៉ាល់ ក្នុឧទ្យាន ជាតិ ព្រះមុនីវង្ស បូក គោ ត្រូវបាន ពន្លត់ ទាំងស្រុង
( កំពត ) ៖ ករណី ភ្លើង ឆេះ ព្រៃ នៅ ចំណុច ជ្រោះ ឪម៉ាល់ ក្នុឧទ្យាន ជាតិ ព្រះមុនីវង្ស បូក គោ ខេត្ត កំពត បាន ត្រូវ ពន្លត់ បាន ទាំងស្រុង នៅ វេលា ព្រឹក ព្រលឹម ថ្ងៃ អាទិត្យ ទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
ចំពោះ ករណី នេះ មន្ទីរ បរិស្ថាន សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ រស់ នៅក្បែរ និង ជាប់ តំបន់ ការពារ ធម្មជាតិ សូម ចូលរួម បង្ការ និង ទប់ស្កាត់ ភ្លើង ឆេះ ព្រៃ តាម វិធាន ដែល បាន ណែនាំ ដោយ ក្រសួង បរិស្ថាន និង ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ព្រោះ ជា រដូវ ប្រាំង ហើយ អាកាស ក្តៅ ខ្លាំង ងាយ នឹង បង្កឱ្យ មាន ភ្លើង ឆេះ ព្រៃ ។
ព្រះវិហារ ថ្មី និង សមិទ្ធផល នានា ក្នុង វត្ត ឧត្តម ប្រិយ៍ ជា មាន តម្លៃ ជាង ២៧ម៉ឺន ដុល្លារ ត្រូវកាត់ ខ្សែបូ កាត់ ឬ សីមា និង សម្ពោធ ឆ្លង ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ
( ពោធិ៍សាត់ )៖ ព្រះវិហារ ថ្មី និង សមិទ្ធផល នានា ក្នុង វត្ត ឧត្តម ប្រិយ៍ ជា ( ហៅ វត្ត ប្រាប ប្រជា ) ដែល ស្ថិត ក្នុង ភូមិ ក្រញាំ ឃុំ ផ្ទះ រុង ស្រុក តា លោ សែន ជ័យ ខេត្ត ពោធិ៍សាត់ ដែល បាន កសាង អស់ រយៈពេល ជាង ១៣ ឆ្នាំ ទើប រួចរាល់ ជា ស្ថាពរ ដោយ ចំណាយ ថវិកា សរុប ប្រមាណ ជាង ២៧ម៉ឺន ដុល្លារ អាមេរិក នោះ . ត្រូវបាន លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ បាន អញ្ជើញ កាត់ ខ្សែបូ កាត់ ឬ សីមា និង សម្ពោធ ឆ្លង ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នា ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
លោក អភិបាល ស្រុក បន្ត ថា ចាប់ពី ឆ្នាំ ២០២០ ព្រះគ្រូ ចៅអធិការ ព្រះនាម កុក សៀង ក៏ បាន ដឹកនាំ កសាង បន្ត ជាមួយ ព្រះសង្ឃ គណៈកម្មការ អាជ្ញាធរ មូលដ្ឋាន និង ពុទ្ធ បរិស័ទ ដើម្បី បង្ហើយ នូវ ព្រះវិហារ បាន រួចរាល់ នៅ ខែឧសភា ឆ្នាំ ២០២៣ ដោយ ចំណាយ ថវិកា សរុប ប្រមាណ ជាង ២៧ម៉ឺន ដុល្លារ អាមេរិក ត្រូវបាន ប្រារព្ធ ពិធី បុណ្យ បញ្ចុះ ខណ្ឌ សីមា សម្ពោធ ឆ្លង នា ពេលនេះ ។
ជាក់ស្តែង ដូចជា ព្រះវិហារ ថ្មី បាន ចេញ លេចធ្លោរ ឡើង នៅ ចំពោះមុខ យើង ទាំងអស់ គ្នា នេះ គឺ ពិតជា បាន មក ពី ការចូលរួម ពី សប្បុរសជន និង ពុទ្ធ បរិស័ទ គ្រប់ ទិសទី និង គួបផ្សំ ទៅនឹង សង្គមជាតិ យើង ទាំងមូល មាន សុខ សន្តិភាព ស្ថេរភាព ក្រោម ការដឹកនាំ ប្រកប ដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង មាន សម្តេច បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
លោក បាន ថ្លែង ថា ព្រះវិហារ នេះ កសាង យូរ ឆ្នាំ ណាស់ ទើប រួចរាល់ ហើយ យើង ពិតជា រីករាយ សាទ រ ណាស់ ចំពោះ សមិទ្ធិផល នៅក្នុង វត្ត ឧត្តម ប្រិយ៍ ជា « ហៅ វត្ត ប្រាប ប្រជា » ព្រោះ ជា មនុញ្ញ ផល បាន មក ពី ទឹកចិត្ត សទ្ធា ជ្រះថ្លា និង ជឿជាក់ ចំពោះ សាសនា ហេតុ នេះ សូម អំពាវនាវ ដល់ ព្រះសង្ឃ អាចារ្យ គណៈកម្មការ និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ចូលរួម ថែរក្សាទុក ជា គុណ ប្រយោជន៍ និង សម្បត្តិ រួម របស់ យើង ទាំងអស់ គ្នា ទាំង ផ្លូវ លោក និង ផ្លូវ ធម៌ ។
នៅក្នុង ឱកាស នោះ លោក ខូយ រីដា ក៏ បាន ប្រគេន និង ចែក ជូន ប័ណ្ណ ថ្លែងអំណរគុណ ជូន ដល់ ព្រះគ្រូ ចៅអធិការ វត្ត និង សប្បុរ រសជន ព្រមទាំង បាន ចូលរួម ថវិកា បុណ្យ ៥លាន រៀល និង បាន អញ្ជើញ កាត់ ខ្សែបូរ កាត់ ឬ សីមាស ម្ពោធ ឆ្លង ដាក់ ឱ្យ ប្រើប្រាស់ នូវ សមិទ្ធិផល ក្នុង វត្ត ជា ផ្លូវការ ផងដែរ ៕ ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ម្នាក់ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ បង្កឡើង រវាង ម៉ូតូ និង ម៉ូតូ សណ្ដោង រ៉ឺម៉ក នៅ ស្រុក រលាប្អៀរ
( កំពង់ឆ្នាំង ) ៖ យ៉ាងហោចណាស់ មាន យុវជន ២នាក់ បាន ស្លាប់ ភ្លាម ៗ នៅ កន្លែង កើត ហេតុ និង យុវជន ១នាក់ ទៀត បាន ស្លាប់ ក្រោយពី បញ្ជូន ទៅដល់ មន្ទីរពេទ្យ ក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ មួយ ដែល បង្កឡើង រវាង ម៉ូតូ បុក ជាមួយ ម៉ូតូ សណ្ដោង រ៉ឺម៉ក ។
ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បាន ឡើង នៅ វេលា ម៉ោ ង ១៖ ៤០ នាទី រំលង អធ្រាត ឈានចូល ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ នៅលើ កំណាត់ ផ្លូវ ជាតិ លេខ ៥ ផ្លូវ វាង ក្រុង កំពង់ឆ្នាំង ចំណុច ផ្លូវ បំបំបែក ជា៤ ស្ថិត ក្នុង ភូមិ ត្រពាំង ស្បូវ ឃុំ ស្រែ ថ្មី ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ។
លោក វរសេនីយ៍ បាន បញ្ជាក់ ថា បើ តាម ការសន្និដ្ឋាន ជា បឋម និង ឆ្លង តាម ការពិនិត្យ នៅ កន្លែ ង កើត ហេតុ អាច ធ្វើ ការសន្និដ្ឋាន បឋម បាន ដូច ខាង ក្រោម៖
* ដោយឡែក ភាគី ម៉ូតូ សណ្ដោង រ៉ឺម៉ក បើកបរ មិន មាន ភ្លើង បំភ្លឺ និង ចំណាំងផ្លាត គ្រប់គ្រាន់ ធ្វេសប្រហែស ខ្វះ ការប្រុងប្រយ័ត្ន និង រត់គេចខ្លួន ពី កន្លែង កើត ហេតុ ក្នុង គោលបំណង មិន ទទួលខុសត្រូវ រឿង ហេតុ ខាង លើ ។
ចំណែក មធ្យោបាយ ទាំងអស់ ត្រូវបាន សមត្ថកិច្ច យក ទៅ រក្សាទុក នៅ អធិការដ្ឋាន នគរបាល ស្រុក រលាប្អៀរ រង់ចាំ ធ្វើការដោះស្រាយ តាម នីតិវិធី ជាបន្ត ៕ ប្រកាស ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ក្រុង ច្បារមន . លោក ហ៊ុន ម៉ានី ណែនាំឲ្យ ពង្រឹង ការយកចិត្តទុកដាក់ និង ដោះស្រាយ បញ្ហា ពលរដ្ឋ ឲ្យបាន ទាន់ ពេល
( កំពង់ស្ពឺ ) ៖ លោក ហ៊ុន ម៉ានី សមាជិក គណៈ អចិន្រ្តៃយ៍ គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ បាន អញ្ជើញ ប្រកាស ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ ។ ពិធី ប្រកាស នេះ បាន ប្រព្រឹត្តទៅ នា ព្រឹក ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ នៅ ទីស្នាក់ការ គណក្ស ប្រជាជន កម្ពុជា ក្រុង ច្បារមន ។
យោង សេចក្តីសម្រេច របស់ ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ ដែល អាន ដោយ លោក សំ រិទ្ធី អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត បាន សម្រេច ចាត់តាំង លោក យក់ ប៊ុណ្ណា ជា ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ក្រុង ច្បារមន ព្រម ជាមួយ អនុប្រធាន និង សមាជិក សមាជិកា សរុប ចំនួន ៩៥ រូប ។
មាន មតិ សំណេះសំណាល ទៅកាន់ សមាជិក សមាជិកា ក្រុមការងារ គណបក្ស លោក ហ៊ុន ម៉ានី បាន ធ្វើការ ថ្លែងអំណរគុណ និង កោតសរសើរ ក្រុមការងារ ទាំងអស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង ក្នុង យុទ្ធនាការ ឃោសនា បោះឆ្នោត និង ការបោះឆ្នោត បោះឆ្នោត ជ្រើសតាំង សមាជិក ព្រឹទ្ធសភា នីតិកាល ទី៥ កន្លងទៅ ដែល បាន យក ជ័យ ជំនះ ជូន គណបក្ស ។
លោក បាន ផ្តាំផ្ញើ ឲ្យ ក្រុមការងារ គណបក្ស និង គណបក្ស មូលដ្ឋាន គ្រប់ ជាន់ ថ្នាក់ បន្ត យកចិត្តទុកដាក់ ក្នុង ការតាមដាន ការងារ នយោបាយ សតិអារម្មណ៍ សមាជិក បក្ស និង ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ដោយ ត្រូវ ដោះស្រាយ បញ្ហា ប្រឈម នានា ឲ្យបាន ទាន់ ពេលវេលា និង ល្អប្រសើរ ។ ជាមួយគ្នា នេះ ក្រុមការងារ និង គណៈកម្មាធិការ គណបក្ស គ្រប់ ជាន់ ថ្នាក់ ត្រូវ បន្ត សហការ គ្នា ឲ្យបាន ស្អិត រមួត ពង្រឹង សាមគ្គីភាព ផ្ទៃក្នុង និង ពង្រីក សមាជិក គណបក្ស ត្រៀម ឆ្ពោះ ទៅរក ជ័យ ជំនះ ជា បន្តបន្ទាប់ ក្នុង ការបោះឆ្នោត ខាងមុខ តទៅទៀត ។
ទន្ទឹមនឹង ពិធី ប្រកាស ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ក្រុង ច្បារ មន នេះ លោក ហ៊ុន ម៉ានី ក៏ បាន បន្ត ដឹកនាំ ប្រជុំ ជាមួយ ក្រុមការងារ និង គណៈកម្មាធិការ គណបក្ស ក្រុង និង សង្កាត់ ដើម្បី ពិនិត្យ វឌ្ឍនភាព ការងារ និង ក្តាប់ សភាពការណ៍ ដើម្បី លើក ទិសដៅ ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ខេត្ត និង ក្រុង - ស្រុក នា ពេល ខាងមុខ ៕
អាជ្ញាធរ ខេត្ត កោះកុង ធ្លាប់ បាន ឲ្យ ម្ចាស់ ទីតាំង របង ថ្ម ៣កន្លែង ដែល សង់ រំលោភ ឆ្នេរ នេសាទ ត្រូវ វាយ កម្ទេចចោល តែ រហូតមកដល់ ពេលនេះ មិន ទាន់ វាយ កម្ទេច នៅឡើយ
( កោះកុង ) ៖ ក្រោយពី អាជ្ញាធរ ខេត្ត កោះកុង បាន ចុះ ពិនិត្យ របង ថ្ម ចំនួន ៣ទីតាំង កាលពី ថ្ងៃទី ៩ ខែមករា ឆ្នាំ ២០២៤ ហើយ បាន ដាក់ បទបញ្ជា ឲ្យ ក្រុម ម្ចាស់ ទីតាំង ចំនួន ៣កន្លែង ដែល លួច សង់ របង ថ្ម រឹងមាំ លយ ចូល ឆ្នេរសមុទ្រ តំបន់ រមណីយដ្ឋាន ឆ្នេរ នេសាទ នៅ ឃុំ ជ្រោយ ស្វាយ ស្រុក ស្រែ អំបិល ប៉ុន្តែ គិត មក ទល់ ថ្ងៃ នេះ ម្ចាស់ សំណង នៅតែ រឹង ទទឹង មិន ព្រម វាយ កម្ទេច បាន ត្រឹមត្រូវ តាម ការកំណត់ នោះ ទេ ។
ការ មិន វាយ របង ថ្ម នេះ ចោល គឺ គឃ្លើន នឹង បទបញ្ជា របស់ លោក អន សុធារិទ្ធ អភិបាល រង ខេត្ត កោះកុង និង ជា អនុប្រធាន គណៈកម្មាធិការ គ្រប់គ្រង និង អភិវឌ្ឍ តំបន់ ឆ្នេរសមុទ្រ កម្ពុជា ខេត្ត កោះកុង ជិត ២ខែ កន្លងមក ក្រុម ម្ចាស់ សំណង់ របង ថ្ម ចំនួន ៣កន្លែង ហាក់ មិន ខ្វាយខ្វល់ សោះ នឹង អ្វី ដែល ជា ចំណាត់ការ ឲ្យ រុះរើ វាយ កម្ទេចចោល របង ខុស ច្បាប់ របស់ ខ្លួន នោះ ឡើយ ។
ទាំង អាជ្ញាធរ ខេត្ត និង មន្ទីរ ជំនាញ ពាក់ព័ន្ធ ធ្លាប់ ពន្យល់ ថា រាល់ ការសង់ របង ថ្ម នេះ គឺ ពិតជា មាន ការរំលោភបំពាន ដោយ ការសង់ សំណង់ រឹងមាំ ខុស ច្បាប់ បែប អនាធិតេយ្យ មក លើ តំបន់ ឆ្នេរ ធ្វើឲ្យ ប៉ះពាល់ សោភ័ណ យ៉ាង ធ្ងន់ធ្ងរ ដល់ តំបន់ សមុទ្រ របស់ រដ្ឋ ៕ ប្រធាន ស្ដីទី ព្រឹទ្ធសភា ផ្ញើ សារ រំលែក ទុក្ខ ជូន ចំពោះ សម្ដេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ចំពោះ មរណភាព ឯកឧត្ដម ឃួន ផល្លា រិទ្ធ
( ភ្នំពេញ ) ៖ លោក កិត្តិនីតិកោសល បណ្ឌិត ស៉ឹម កា ប្រធាន ស្ដីទី ព្រឹទ្ធសភា បាន ផ្ញើ សារ ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត និង ការសោកស្ដាយ ជា ពន់ពេក ចំពោះ មរណភាព ឯកឧត្ដម ឃួន ផល្លារិទ្ធ នាយក រង ខុទ្ទកាល័យ និង ជា ប្អូន បង្កើត របស់ សម្ដេច មហា រដ្ឋសភាធិការ ធិបតី ឃួន សុដារី ប្រធាន រដ្ឋសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល បាន ទទួលមរណភាព នៅ ថ្ងៃសៅរ៍ ៧កើត ខែ ផល្គុន ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ វេលា ម៉ោង ១៧: ៤០ នាទី ក្នុង ជន្មាយុ ៦៧ ឆ្នាំ ដោយ រោគា ពាធ ។
« ក្នុង នាម សមាជិក សមាជិកា ព្រឹទ្ធសភា មន្ត្រីរាជការ នៃ អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា និង ខ្លួនខ្ញុំ ផ្ទាល់ មាន សេចក្តីក្រៀមក្រំ ជា ទីបំផុត ចំពោះ មរណភាព ឯកឧត្តម ឃួន ផល្លារិទ្ធ នាយក រង ខុទ្ទកាល័យ និង ត្រូវ ជា ប្អូន ប្រុស បង្កើត សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ប្រធាន រដ្ឋសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ថ្ងៃសៅរ៍ ៧កើត ខែ ផល្គុន ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ វេលា ម៉ោង ១៧: ៤០ នាទី ក្នុង ជន្មាយុ ៦៧ ឆ្នាំ ដោយ រោគា ពាធ ។
ខ្ញុំ សូម ឧទ្ទិស បួងសួង ដល់ វត្ថុ ស័ក្តិសិទ្ធិ ក្នុង លោក និង តេជៈ បារមី នៃ ព្រះពុទ្ធ ព្រះធម៌ ព្រះសង្ឃ តាម ជួយ បីបាច់ ថែរក្សា ដល់ ដួង វិញ្ញាណក្ខន្ធ ឯកឧត្តម ឃួន ផល្លា រិទ្ធ បាន ទៅកាន់ សុគតិភព ជានិច្ច និរន្តរ៍ ត រៀង ទៅ ។ សូម សម្តេច មហា រដ្ឋសភាធិការ ធិបតី ព្រមទាំង ក្រុមគ្រួសារ ទទួល នូវ មនោសញ្ចេតនា ចែករំលែក ទុក្ខ ដោយ ក្តី ក្រៀមក្រំ បំផុត ពី យើងខ្ញុំ ទាំងអស់ គ្នា » ៕
( ភ្នំពេញ ) ៖ គិត ត្រឹម ឆ្នាំ ២០២២ ប្រទេស កម្ពុជា បាន លក់ សេវាកម្ម ទៅ កាន់ ពិភពលោក មាន តម្លៃ ជាង ២៣០០ លាន ដុល្លារ អាមេរិក ស្រប ពេល ដែល កម្ពុជា ក៏ ទិញ សេវាកម្ម មកវិញ មាន តម្លៃ ប្រមាណ ២៧០០ លាន ដុល្លារ អាមេរិក ។
ការទិញ សេវាកម្ម របស់ កម្ពុជា ភាគ ច្រើន លើ សេវាកម្ម ដឹក ជញ្ជូន ការធ្វើដំណើរ ទេសចរណ៍ និង ផ្នែក បច្ចេកវិទ្យា ព័ត៌មាន ៕
( កាប៊ុល) ៖ កាលពី ថ្ងៃសៅរ៍ សប្តាហ៍ នេះ រដ្ឋាភិបាល តាលី បង់ បាន បង្ហាញ ការស្វាគមន៍ ចំពោះ ការបន្ត អាណត្តិ នៃ បេសកកម្ម អង្គការ សហ ប្រជាជាតិ ប្រចាំ នៅ អាហ្វហ្កានីស្ថាន ហើយ និយាយ ថា បេសកកម្ម នេះ គួរ ដើរ តួនាទី ជួយ លើកកម្ពស់ ទំនាក់ទំនង រវាង អាហ្វហ្កានីស្ថាន និង បណ្តា ប្រទេស ផ្សេង ទៀត ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន AFP នា ថ្ងៃអាទិត្យ ទី១៧ ខែមីនា ឆ្នាំ ២០២៤ ។
បេសកកម្ម UN នៅ អាហ្វហ្កានីស្ថាន ហៅ កាត់ ថា UNAMA បាន រក្សា វត្តមាន នៅ ប្រទេស មជ្ឈិមបូព៌ា មួយ នេះ ចាប់តាំងពី ឆ្នាំ ២០០២មក ហើយ ទើបតែ ត្រូវបាន បន្ត អាណត្តិ បេសកកម្ម ថែម ទៀត រហូតដល់ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៥ ក្រោយ ការបោះឆ្នោត ក្នុង សំឡេង ឯក ច្ឆន្ទ មួយ ដោយ ក្រុមប្រឹក្សា សន្តិសុខ របស់ UN កាលពី ថ្ងៃសុក្រ សប្តាហ៍ នេះ ។
គួរ បញ្ជាក់ ថា មកទល់ ពេលនេះ រដ្ឋាភិបាល តាលី បង់ មិន ទាន់ ត្រូវបាន ទទួលស្គាល់ ជា ផ្លូវការ ដោយ ប្រទេស ណាមួយ នៅឡើយ ទេ ចាប់តាំងពី ការដណ្តើម អំណាច កាលពី ខែសីហា ឆ្នាំ ២០២១ អំឡុង ដំណើរការដក កងទ័ព យ៉ាង ចលាចល របស់ អាមេរិក ដោយសារ ក្តីកង្វល់ ពាក់ព័ន្ធ បញ្ហា ជាច្រើន រួម មាន ទាំង សិទ្ធិ ស្រ្តី ព្រមទាំង សន្តិសុខ ជាដើម ។
យ៉ាងណាមិញ លោក Mujahid បាន ស្នើ ឱ្យ UNAMA ជួយ ពាំនាំ វ ឌ្ឈន ភាព ស្តីពី ស្ថានភាព សន្តិសុខ និង ស្ថិរភាព របស់ អាហ្វហ្កានីស្ថាន ទៅកាន់ សហគមន៍ អន្តរជាតិ និង បាន ថ្កោលទោស ការដាក់ សម្ពាធ យ៉ាង អយុត្តិធម៌ មក លើ ប្រទេស អាហ្វហ្កានីស្ថាន និង ទាមទារ សា ជា ថ្មី ឱ្យ ទ្រព្យសម្បត្តិ អាហ្វហ្កានីស្ថាន ទាំងឡាយ ដែល ជាប់ ការបង្កក ត្រូវបាន ដោះលែង វិញ ៕ អ្នកនាំពាក្យ៖ ថ្ងៃទី ៤ នៃ យុទ្ធនាការ បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ នៅ ខេត្ត ពោធិ៍សាត់ សមត្ថកិច្ច ចម្រុះ បន្ត ឃាត់ខ្លួន មនុស្ស ៤នាក់ និង ឃ្លុំ ដី ជាង ១ពាន់ ហិកតា
សូម បញ្ជាក់ ថា ក្នុង កិច្ចប្រជុំ ពេញ អង្គរ គណៈ រដ្ឋមន្ត្រី កាលពី ថ្ងៃសុក្រ ទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ណែនាំ ឱ្យ អាជ្ញាធរ ពាក់ព័ន្ធ យកចិត្តទុកដាក់ លើ ការគ្រប់គ្រង និង ការពារ ធនធាន ធម្មជាតិ ជាពិសេស ព្រៃឈើ ដើម្បី កុំ ឱ្យ មាន ជន ឆ្លៀត ឱកាស បំផ្លាញ ធនធាន ធម្មជាតិ ។
លោក ខ្វៃ អាទិត្យា បាន បន្ថែម ថា លោក បណ្ឌិត អ៊ាង សុផល្លែត បាន ជំរុញឱ្យ ថ្នាក់ដឹកនាំ ក្រសួង និង មន្ទីរ បរិស្ថាន រាជធានី ខេត្ត ទូទាំង ប្រទេស យកចិត្តទុកដាក់ ពង្រឹង យុទ្ធសាស្រ្ត បៃតង ដោយ អន្តរាគមន៍ ទប់ស្កាត់ បទល្មើស ធនធាន ធម្មជាតិ ឱ្យ មាន ប្រសិទ្ធភាព និង ត្រូវ រៀបចំ ផែនការស្តារ ព្រៃឈើ នៅ តាម គម្រោង វិនិយោគ និង នៅលើ ដី ដែល ដកហូត បាន ពី បទល្មើស នៃ ការកាប់ រុករាន ទន្ទ្រាន ដី ព្រៃ យកមក ធ្វើជា កម្មសិទ្ធិ ដោយ ខុស ច្បាប់ នៅពេល ខាងមុខ ។
អ្នកនាំពាក្យ ក្រសួង បរិស្ថាន បាន បញ្ជាក់ ថា លោក បណ្ឌិត អ៊ាង សុផល្លែត រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន កន្លងមក បាន ដាក់ចេញ នូវ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ បំផុត ក្នុង ការទប់ស្កាត់ បទល្មើស ធនធាន ធម្មជាតិ ដោយ ក្នុង នោះ រួម មាន៖
៣៖ បន្ត សហការ ជាមួយ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង អង្គភាព ប្រឆាំង អំពើពុករលួយ បន្ថែម លើ កិច្ចសហការ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ដែល បាន អនុវត្ត កន្លងមក
( ភ្នំពេញ ) ៖ ទិស ស្លោក « រក្សា ចាស់ បង្កើន ថ្មី » របស់ គណបក្ស ប្រជាជន កម្ពុជា ត្រូវបាន លោក ឯក ឃុន ដឿន ប្រធាន គណបក្ស ខណ្ឌ ឫស្សីកែវ បន្ត រម្លឹក ឡើង និង ជំរុញ ដាស់តឿន ដល់ សមាជិក សមាជិកា គណបក្ស ឱ្យ យកចិត្តទុកដាក់ ខ្ពស់ ដើម្បី រក្សា ឱ្យ បាន ប្រៀប ឈ្នះ របស់ គណបក្ស ។
នៅក្នុង កិច្ចប្រជុំ . លោក ឯក ឃុន ដឿន បាន ដាក់ចេញ នូវ យុទ្ធសាស្ត្រ ចាំបាច់ ជំរុញឱ្យ មន្ត្រី បក្ស គ្រប់ រូប ត្រូវ ខិតខំ កសាង ពង្រឹង និង ពង្រីក សមាជិក បក្ស បន្ថែម ទៀត តាម ទិស ស្លោក « រក្សា ចាស់ បង្កើន ថ្មី » ក្នុង នោះ ត្រូវ ធានា ឱ្យ បាន ទាំង បរិមាណ និង គុណភាព ពោលគឺ សមាជិក បក្ស ១រូប ជា សន្លឹក ឆ្នោត គាំទ្រ គណបក្ស ១សន្លឹក ក្នុង ន័យ រក្សា ប្រៀប ឈ្នះ របស់ គណបក្ស ដើម្បី ឆ្ពោះទៅ បោះឆ្នោត នា ពេល ខាងមុខ ក្នុង ការជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ អាណត្តិ ទី៤ ឆ្នាំ ២០២៤ ៕
( វ៉ាស៉ីន តោន ) ៖ កាលពី ថ្ងៃសៅរ៍ សប្តាហ៍ នេះ ថា អតីត ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន និយាយ ថា ប្រសិនបើ លោក មិន ឈ្នះ ក្នុង ការបោះឆ្នោត ប្រធានាធិបតី ខែវិច្ឆិកា ឆ្នាំ នេះ ទេ នោះ វា នឹង មាន ន័យ ថា លទ្ធិ ប្រជាធិបតេយ្យ របស់ សហរដ្ឋ អាមេរិក ហាក់ ឈានដល់ ទី បញ្ចប់ ហើយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នា ថ្ងៃអាទិត្យ ទី១៧ ខែមីនា ឆ្នាំ ២០២៤ ។
ថ្លែង ទៅកាន់ ក្រុម អ្នកគាំទ្រ នៅ រដ្ឋ Ohio លោក ដូណាល់ ត្រាំ បាន ព្រមាន ដូច ខាងលើ បន្ទាប់ពី នៅតែ បន្ត អះអាង ម្តង ហើយ ម្តង ទៀត ថា ភាពបរាជ័យ របស់ លោក ក្នុង ការបោះឆ្នោត កាលពី ឆ្នាំ ២០២០ ក្រោម ដៃ ប្រធានាធិបតី អាមេរិក បច្ចុប្បន្ន លោក ចូ បៃ ដិន គឺ ដោយសារតែ មាន ការបន្លំ ដំណើរការបោះឆ្នោត ។ លោក ត្រាំ បាន និយាយ យ៉ាង ដូច្នេះ ថា « ប្រសិនបើ យើង មិន ឈ្នះ ការបោះឆ្នោត លើក នេះ ទេ ខ្ញុំ ពុំ គិត ថា យើង នឹង អាច មាន ការបោះឆ្នោត ទៀត នៅក្នុង ប្រទេស នេះ ឡើយ » ។
លោក ត្រាំ ដែល កំពុងតែ ស្ថិត ក្រោម ការចោទប្រកាន់ ព្រហ្មទណ្ឌ នៅឯ រដ្ឋ Georgia ពី បទ ព្យាយាម កែប្រែ លទ្ធផល បោះឆ្នោត ឆ្នាំ ២០២០ នៅ ទីនោះ ក្នុង សប្តាហ៍ នេះ ទើបតែ ឈ្នះ បាន សំឡេង គ្រប់គ្រាន់ ដើម្បី អាច ក្លាយជា បេក្ខជន តំណាង ឱ្យ បក្ស សាធារណរដ្ឋ ដើម្បី ទៅ ប្រជែង ក្នុង ការបោះឆ្នោត ជ្រើសរើស ប្រធានាធិបតី ដែល នឹង ប្រព្រឹត្តទៅ នា ថ្ងៃទី ៥ ខែវិច្ឆិកា ។
គួរ បញ្ជាក់ ថា លោក ដូណាល់ ត្រាំ បាន ជាប់ ឆ្នោត ជា ប្រធានាធិបតី អាមេរិក លើក ដំបូង កាលពី ឆ្នាំ ២០១៦ ប៉ុន្តែ កាន់ តំណែង បាន តែ មួយ អាណត្តិ ប៉ុណ្ណោះ ក្រោយ ចាញ់ លោក បៃ ដិន ពេល ព្យាយាម ឈរឈ្មោះ សម្រាប់ អាណត្តិ ទី២ កាលពី ឆ្នាំ ២០២០ ។ សម្រាប់ ការបោះឆ្នោត ឆ្នាំ ២០២៤ នេះ គឺ សឹងតែ មួយ រយ ភាគរយ ទៅ ហើយ ដែល លោក ត្រាំ នឹង ត្រូវ ជួប ត ទល់ ជាមួយ លោក បៃ ដិន សា ជា ថ្មី ម្តង ទៀត ៕ ក្រសួង ការងារ នាំយក ឱកាស ការងារ ថ្មី ប្រមាណ ជាង ២៥០០ កន្លែង ជូន កម្មករ Y & W
( ភ្នំពេញ ) ៖ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ឱ្យដឹង ថា មាន ឱកាស ការងារ ប្រមាណ ជាង ២៥០០ កន្លែង សម្រាប់ ជូន កម្មករ រោងចក្រ Y & W ដើម្បី បន្ត និរន្តរភាព ជីវភាព គ្រួសារ ។
ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ១៧ ខែមីនា ឆ្នាំ ២០២៤ ។
ក្រសួង បាន ឱ្យដឹង ថា សម្ពាធ ទាប បាន និង បន្ត គ្របដណ្ដប់ មក លើ ព្រះរាជាណាចក្រ កម្ពុជា ប្រទេស ថៃ ឈូង សមុទ្រ ថៃ ភាគ កណ្តាល នៃ អាង ទន្លេ មេគង្គ និង សមុទ្រ ចិន ខាងត្បូង ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឱ្យ៖ ចាប់ពី ថ្ងៃទី ១៧ ដល់ ថ្ងៃទី ១៩ ខែមីនា ឆ្នាំ ២០២៤៖
៣. តំបន់ មាត់ សមុទ្រ៖ * សីតុណ្ហភាព អប្បបរមា ២៦ °C និង សីតុណ្ហភាព អតិបរមា ៣៥ °C ។ ខ្យល់ បក់ មកពី ទិស អាគ្នេយ៍ និង ទិស និរតី មាន ល្បឿន មធ្យម២ម៉ែត្រ / វិនាទី ។ មាន ភ្លៀង ធ្លាក់ គ្របដណ្ដប់ លើ ផ្ទៃដី ប្រមាណ ពី ៥- ១០% ។ * រលក សមុទ្រ មាន កម្ពស់ មធ្យម អប្បបរមា០ .៥០ ម៉ែត្រ និង កម្ពស់ មធ្យម អតិបរមា១.០០ ម៉ែត្រ ៕ លោក ហ៊ុន ម៉ានី ដឹកនាំ កិច្ចប្រជុំ ជាមួយ ក្រុមការងារ គណៈកម្មាធិការ គណបក្ស ក្រុង និង សង្កាត់ នៃ ក្រុង ឧដុង្គ ម៉ែ ជ័យ
( កំពង់ស្ពឺ ) ៖ នា រសៀល ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ លោក ហ៊ុន ម៉ានី ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ បាន ដឹកនាំ កិច្ចប្រជុំ ជាមួយ ក្រុមការងារ គណៈកម្មាធិការ គណបក្ស ក្រុង និង សង្កាត់ នៃ ក្រុង ឧដុង្គ ម៉ែ ជ័យ ដើម្បី តាមដាន វឌ្ឍនភាព ការងារ និង ស្តាប់ នូវ សំណូមពរ ក៏ ដូចជា បញ្ហា ប្រឈម ដែល ក្រុមការងារ ជួបប្រទះ នៅ ស្នាក់ការ គណបក្ស ។
ក្រោយពី ស្តាប់ របាយការណ៍ លោក ហ៊ុន ម៉ានី បាន ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ ក្រុមការងារ គណៈកម្មាធិការ គណបក្ស ក្រុង និង សង្កាត់ នៃ ក្រុង ឧដុង្គ ម៉ែ ជ័យ ដែល បាន ចំណាយ ពេលវេលា មក ចូលរួម ប្រជុំ និង ចូលរួម ផ្តល់ រាយការណ៍ ផ្តល់ មតិ យោបល់ ចែករំលែក បទពិសោធន៍ មកកាន់ អង្គប្រជុំ ។
លោក ហ៊ុន ម៉ានី បាន គូសបញ្ជាក់ ថា គ្រប់ ពេល ដែល លោក បាន មកដល់ ទឹកដី ក្រុង ឧដុង្គ ម៉ែ ជ័យ គឺ តែងតែ ទទួលបាន ឱកាស រៀនសូត្រ បន្ត តាមរយៈ ការចែករំលេក បទពិសោធន៍ ថ្នាក់ដឹកនាំ នៅ មូលដ្ឋាន ក្រុង ឧដុង្គ ម៉ែ ជ័យ ផ្ទាល់ តែម្តង ។
សរុប មតិ នៃ អង្គប្រជុំ នា រសៀល នេះ លោក បាន កោតស សើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង និង ការសហការ យ៉ាង សកម្ម របស់ ក្រុមការងារ គណៈកម្មាធិការ គណបក្ស ក្រុង សង្កាត់ ដែល បាន រួមគ្នា នាំមក នូវ ភាពជោគជ័យ ជូន គណបក្ស នា ពេល កន្លងមក ។
ជាមួយគ្នា នេះ លោក ហ៊ុន ម៉ានី បាន លើកទឹកចិត្ត ដល់ សមាជិក សមាជិកា ក្នុង អង្គប្រជុំ ឲ្យ បន្ត រក្សា សាមគ្គី ឯកភាព ទាំង ទស្សនៈ និង គោលជំហរ រួមទាំង របៀបរបប ធ្វើ ការងារ ដើម្បី នូវ ភាព ឈ្នះ របស់ គណបក្ស ប្រជាជន កម្ពុជា ៕
តុលាការ ខេត្ត កណ្ដាល ឃុំ ខ្លួន បុរស ម្នាក់ ដែល ផលិត ឧបករណ៍ ឆក់ ត្រី ហើយ បង្ហោះ លក់ តាម បណ្តាញ សង្គម
លោក ហេង សុភារិទ្ធ បាន ឱ្យដឹង ថា ជនសង្ស័យ ឈ្មោះ សោម ពិសិដ្ឋ ហៅ ជាង រិទ្ធី ភេទ ប្រុស អាយុ ២៧ ឆ្នាំ ។
« កម្លាំង យើង ធ្វើ ការតាមដាន រូប គេ យូរ ខែ មក ហើយ ទើបតែ កាលពី ព្រឹក ថ្ងៃទី ១៤ ខែមីនា តាម ឃាត់ រូប គេ នៅ ទីតាំង ផ្ញើ អីវ៉ាន់ មួយ និង បាន នាំ រូប គេ យក ទៅ បង្ហាញ ទីតាំង ផលិត នៅក្នុង លំនៅដ្ឋាន របស់ គេ ឯ ភូមិ - ឃុំ កើត ហេតុ ខាង លើ ដែល ក្នុង ប្រតិបត្តិការ នេះ យើង បាន ដកហូត ម៉ូតូ១ គ្រឿង ទូរស័ព្ទ១ គ្រឿង ព្រមទាំង ឧបករណ៍ ឆក់ ត្រី រួម ជាមួយ គ្រឿង ដង្គុំ សម្រាប់ ផលិត ជាច្រើន ទៀត កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ សាលាដំបូង ខេត្ត កណ្តាល ចាត់ការ តាម នីតិវិធី » ។ នេះ ជា ការគូសបញ្ជាក់ បន្ថែម របស់ លោក ហេង សុភារិទ្ធ ។
លោក បាន បន្ត ថា សម្រាប់ ជន ដែល លួច ទិញ ឧបករណ៍ ឆក់ ត្រី ទាំងនេះ ត្រូវបាន សមត្ថកិច្ច ជំនាញ មាន ទាំង ឈ្មោះ និង លេខ ទូរសព្ទ័ អាសយដ្ឋាន អស់ ហើយ តាមរយៈ វិក័យបត្រ ដូច្នេះ សូម ប្រគល់ ឧបករណ៍ ទាំងនោះ ឱ្យ សមត្ថកិច្ច តាម មូលដ្ឋាន របស់ ខ្លួន មុនពេល គេ អនុវត្តន៍ ច្បាប់ ។
នាយ ខណ្ឌ រដ្ឋបាល ជលផល ខេត្ត កណ្ដាល បាន បន្ថែម ផងដែរ ថា ចំពោះ ឆ្នាំ ២០២៣ កន្លងទៅ ខេត្ត កណ្តាល បាន បង្ក្រាប បទល្មើស នេសាទ បាន ចំនួន ១៨៨ ករណី ដុត បំផ្លាញ លូស្បែ មុង ចំនួន ២៤២៤មាត់ របាំង ស្បៃ មុង និង សាច់ អួន ១៦៦៤៧៨ម៉ែត្រ និង ឧបករណ៍ ឆក់ ៦៧ គូ អាគុយ ចំនួន ៧៤ និង អាំង វ៉ិចទ័រ ចំនួន ៧០ គ្រឿង ផងដែរ ៕
ក្រសួង ទេសចរណ៍ សហការ ជាមួយ រដ្ឋបាល ខេត្ត សៀមរាប បើក យុទ្ធនាការ សម្អាត បរិស្ថាន នៅ ចុង ឃ្នៀស ដើម្បី អបអរសាទរ ពិធី បុណ្យ ទន្លេ លើក ទី៨ ឆ្នាំ ២០២៤
( សៀមរាប ) ៖ ក្រសួង ទេសចរណ៍ សហការ ជាមួយ រដ្ឋបាល ខេត្ត សៀមរាប នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ បាន បើក យុទ្ធនាការ សម្អាត បរិស្ថាន នៅ ចុង ឃ្នៀស ក្នុង ក្រុង សៀមរាប ដើម្បី អបអរសាទរ ពិធី បុណ្យ ទន្លេ លើក ទី៨ ឆ្នាំ ២០២៤ ក្រោម ប្រធានបទ « កម្ពុជា ស្អាត កម្ពុជា បៃតង » ។
ក្នុង ឱកាស បើក យុទ្ធនាការ សម្អាត នេះ លោក យុន លីនណេ បាន ថ្លែងអំណរគុណ គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត ក្រសួង ទេសចរណ៍ ដែល បាន សហការ រៀបចំ យុទ្ធនាការ កម្ពុជា ស្អាត នា ថ្ងៃ នេះ ក្នុង គោលបំណង ចូលរួម អបអរសាទរ ពិធី បុណ្យ ទន្លេ លើក ទី៨ និង រួមចំណែក ជំរុញ ភាពស្អាត ក្នុង ក្រុង សៀមរាប ជាពិសេស តំបន់ បឹង ទន្លេ សាប ដែល ជា តំបន់ ទាក់ទាញ ទេសចរណ៍ ក្រៅពី ប្រាសាទ ។
លោក ហ៊ួត រិទ្ធី បាន លើកឡើង ថា ដោយ ទទួលបាន ការអនុញ្ញាត ពី លោក សុខ សូកេន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ គណៈកម្មាធិការ ជាតិ វាយតម្លៃ ទីក្រុង ស្អាត មាន សេចក្តី សោមនស្ស រីករាយ ដែល បាន សហការ ជាមួយ រដ្ឋបាល ខេត្ត សៀមរាប រៀបចំ យុទ្ធនាការ « កម្ពុជា ស្អាត កម្ពុជា បៃតង » នៅ តំបន់ សហគមន៍ ទេសចរណ៍ ចុង ឃ្នៀស ។
លោក ហ៊ួត រិទ្ធី បាន បន្ត ថា ដើម្បី អភិវឌ្ឍន៍ សហគមន៍ ចុង ឃ្នៀស ឱ្យ ក្លាយជា សហគមន៍ មួយ ដែល មាន សក្តានុពល ទេសចរណ៍ ផ្សារភ្ជាប់ នឹង ធម្មជាតិ និង ទាក់ទាញ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ ឱ្យ មក ទស្សនា កាន់តែ ច្រើន បន្ទាប់ពី ការទស្សនា ប្រាសាទ នៅក្នុង ខេត្ត សៀមរាប ជាពិសេស ដើម្បី អបអរសាទរ ពិធី បុណ្យ ទន្ល លើក ទី៨ នៅ ខេត្ត សៀមរាប នេះ យើង ត្រូវ មាន ចេះ ថែរក្សា អនាម័យ បរិស្ថាន និង ទុកដាក់ សំរាម ឱ្យ បាន ត្រឹមត្រូវ ។
លោក ហ៊ួត រិទ្ធី បាន អំពាវនាវ ប្រជាពលរដ្ឋ ទាំងអស់ ឱ្យ ចូលរួម បញ្ឈប់ ការចោល សំរាម ឥត សណ្តាប់ធ្នាប់ ដើម្បី ចូលរួម ថែរក្សា បរិស្ថាន ធម្មជាតិ និង សោភ័ណភាព ទាំងអស់ គ្នា ។ ទន្ទឹមនឹង នេះ ដែរ យើង ក៏ ត្រូវការ ជា ចាំបាច់ នូវ ការ បង្កើន ការអប់រំ និង បន្ត បង្កើន ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ គ្រប់គ្រង សំរាម នៅក្នុង សហគន៍ ផងដែរ ។
យុទ្ធនាការ សម្អាត បរិស្ថាន នេះ ត្រូវបាន បែងចែក ជា ៣ក្រុម៖
គួរ បញ្ជាក់ ថា ក្នុង សប្តាហ៍ នេះ ក្រុមហា ម៉ាស់ បាន លើក សំណើ បទ ឈប់ បាញ់ ថ្មី មួយ ឱ្យ ដល់ ក្រុម អ្នក សម្រុះសម្រួល និង សម្ព័ន្ធមិត្ត របស់ អ៉ី ស្រាអែល គឺ សហរដ្ឋ អាមេរិក ដែល រួម មាន ការដោះលែង ចំណាប់ខ្មាំង អ៉ី ស្រាអែល ជា ថ្នូរ នឹង សេរីភាព របស់ អ្នកទោស ប៉ាឡេ ស្ទីន ៕
ទស្សនា រូបភាព៖ ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅ ខេត្ត សៀមរាប ក្រោម អធិបតីភាព សម្តេច ធិបតី ហ៊ុន ម៉ាណែត
សម្តេច បាន ថ្លែង ថា វិស័យ ទេសចរ នៅ នៅតែ ជា វិស័យ ជន្ទល់ សេដ្ឋកិច្ច មួយ ដ៏ សំខាន់ ក្នុង ការបង្កើត ឱកាស ការងារ មុខរបរ ប្រាក់ ចំណូល និង រួមចំណែក សម្រេចបាន នៃ គោលដៅ យុទ្ធសាស្រ្ត បញ្ចកោណ ដំណាក់កាល ទី១ ជាពិសេស រួមចំណែក សម្រេចបាន នូវ ចក្ខុវិស័យ របស់ កម្ពុជា ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
ក្នុង ឱកាស នេះ សម្តេច បាន លើកទឹកចិត្ត និង ផ្ដល់ នូវ ទស្សនៈ មួយចំនួន ដើម្បី រួមចំណែក ដល់ ការលើកកម្ពស់ វិស័យ ទេសចរណ៍ ដូច ខាងក្រោម ៖
ទី៣. ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ដៃគូ អភិវឌ្ឍន៍ និង វិស័យ ឯកជន ត្រូវ បន្ត សហការ ឱ្យ បាន ជិតស្និទ្ធ ស្រប តាម អភិក្រម « ចីវភាព នៃ ប្រព័ន្ធ តួអង្គ តែ មួយ » ដើម្បី ចូលរួម អនុវត្ត វិធានការ និង គោល នយោបាយ នានា សំដៅ សម្រេចបាន នូវ គោលដៅ នៃ យុទ្ធនាការ « ទស្សនា សៀមរាប ឆ្នាំ ២០២៤ » ។
ទី៦. ស្នើ ក្រសួង បរិស្ថាន . ក្រសួង ទេសចរណ៍ . ក្រសួង វប្បធម៌ និង វិចិត្រ សិល្បៈ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ . និង រដ្ឋបាល ខេត្ត សៀមរាប សហការ គ្នា សិក្សា និង គិតគូរ រៀបចំ តំបន់ ឧទ្យាន ជាតិ ភ្នំ គូលែន ឱ្យ ក្លាយជា គោលដៅ ទេសចរណ៍ វប្បធម៌ ធម្មជាតិ ផ្សងព្រេង និង សាសនា ប្រកបដោយ ភាពទាក់ទាញ ខ្ពស់ ដើម្បី បង្កើន ពិពិធកម្ម ផលិតផល ទេសចរណ៍ កម្ពុជា ។
ទី៧. ខ្ញុំ សូម លើកទឹកចិត្ត ឱ្យ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ទាំងអស់ រៀបចំ យុទ្ធសាស្ត្រ ជំរុញ ឱ្យ មាន ការជួបជុំ ដូចជា កិច្ចប្រជុំ . វិបស្សនា . កម្មវិធី កីឡា និង កម្មវិធី នានា នៅ ខេត្ត សៀមរាប ដើម្បី គាំទ្រ ដល់ យុទ្ធនាការ ទស្សនា សៀមរាប ឆ្នាំ ២០២៤ ឱ្យ សម្រេចបាន ជោគជ័យ ។
ទី៨. ខ្ញុំ ស្នើ ឱ្យ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន . ក្រសួង ទេសចរណ៍ . រដ្ឋលេខាធិការដ្ឋាន អាកាសចរណ៍ ស៊ីវិល . អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ . និង ក្រុមហ៊ុន អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប - អង្គរ សហការ ដោះស្រាយ បញ្ហា ទាំងឡាយ ដែល ពាក់ព័ន្ធ នឹង ការធ្វើដំណើរ របស់ ភ្ញៀវ ទេសចរ ដើម្បី ធ្វើឱ្យ ការធ្វើដំណើរ របស់ ភ្ញៀវ ទេសចរ ជាតិ និង អន្តរជាតិ មាន ភាពងាយស្រួល និង កក់ក្តៅ ។
ការណែនាំ បែប នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត អញ្ជើញ ជា អធិបតី បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅក្នុង ខេត្ត សៀមរាប នៅ ល្ងាច ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ បាន ឲ្យ គោល គំនិត ទៅ ឯកឧត្ដម សុខ សូកេន ពេល បុណ្យ ចូល ឆ្នាំ ថ្មី ខាងមុខ នេះ ត្រូវ រៀបចំ ភ្លេង ឆៃយាំ ស្វាគមន៍ ភ្ញៀវ នៅ ព្រលានយន្ដហោះ ដែល ជា កាដូ ជូន គាត់ ជា អនុស្សាវរីយ៍ មុន គេ ពេល គាត់ មកដល់ ទឹកដី កម្ពុជា មិន មែន តែ ខេត្ដ សៀមរាប គឺ គ្រប់ ខេត្ដ ទាំងអស់ ទាំង នៅ រាជធានី ភ្នំពេញ » ។
បន្ថែម ពី នោះ ទៀត សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ណែនាំឲ្យ មាន ការរៀបចំ ភ្លេង ឆៃយាំ ដើម្បី ស្វាគមន៍ ភ្ញៀវ ទេសចរ នៅ គ្រប់ ខេត្ដ - រាជធានី ទាំងអស់ តែម្ដង ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន លើកឡើង ថា ការស្វាគមន៍ ភ្ញៀវ នៅ ព្រលានយន្ដហោះ គឺជា កិច្ចការ សំខាន់ ដែល អាច ឲ្យ មនុស្ស ប្ដូរចិត្ដ ពី ការមក លេង ១ ថ្ងៃ ទៅជា ៥ ថ្ងៃ ឬមួយ ពី ៥ ថ្ងៃ មក១ ថ្ងៃ វិញ ដែល នេះ ជា កិច្ចការ សំខាន់ ។
ការណែនាំ បែប នេះ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅក្នុង ខេត្ត សៀមរាប នៅ ព្រលប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
សម្តេច ធិបតី ហ៊ុ ម៉ាណែត បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « ហើយ ម្សិលមិញ ខ្ញុំ បាន ឱ្យ គោលការណ៍ ទៅ ឯកឧត្តម ហេង សួរ ធ្វើការ ជាមួយ អគ្គ នាយកដ្ឋាន អន្តោប្រវេសន៍ និង បណ្តា ខេត្ត ជាប់ ព្រំដែន ពេល ចូល ឆ្នាំ បងប្អូន ពលករ យើង ហ្នឹង ត្រឡប់ មកវិញ ពី ប្រទេស ថៃ ស្វាគមន៍ តាម គ្រប់ រូបភាព ដែល អាច ធ្វើ ទៅ បាន ដើម្បី មាន ភាព កក់ក្តៅ » ។
បន្ថែម ពី នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា សម្តេច បាន ចរចា ជាមួយ នាយក រដ្ឋមន្ត្រី របស់ ថៃ កាល កំឡុង សម្តេច អញ្ជើញ ទៅ បំពេញ បេសកកម្ម នៅ ប្រទេស ថៃ ដោយ ភាគី ថៃ បាន ឯកភាព មិន ឱ្យ ពលករ ខ្មែរ ដែល មក លេង ស្រុក កំណើត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ គឺ មិន តម្រូវឱ្យ បង់ប្រាក់ នោះ ទេ ។
ក្រៅពី ការ នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ណែនាំ រៀបចំ ភ្លេង ឆៃ យាំស្វាគមន៍ អ្នកទេសចរ នៅ តាម ព្រលានយន្តហោះ ស្វាគមន៍ អ្នកទេសចរ ចូលមក លេង កម្សាន្ត នៅ កម្ពុជា ។
គួរឱ្យដឹង ថា នៅក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី កាលពី ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ ថ្មី ៗ នេះ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន ណែនាំ ឱ្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ និង ក្រសួង ទេសចរណ៍ សហការ ជាមួយ បណ្តា ខេត្ត ជាប់ ព្រំដែន ដើម្បី ស្វាគមន៍ ប្រជាពលរដ្ឋ ខ្មែរ ដែល ត្រឡប់មក ស្រុក កំណើត ក៏ ដូចជា ភ្ញៀវ ទេសចរ បរទេស ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ខាងមុខ ។
តាមរយៈ សេក្តី ប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន បញ្ជាក់ ថា ពិធី បដិសណ្ឋារកិច្ច ក៏ ត្រូវ ធ្វើ តាម ព្រលានយន្តហោះ ផងដែរ ។ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន ណែនាំ ឱ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច ពង្រឹង ការរក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ក្នុង អំឡុង ពេល បុណ្យ ចូល ឆ្នាំ ថ្មី ផងដែរ ។
គួរឱ្យដឹង ថា យោង តាម ប្រតិទិន ឈប់ សម្រាក ចូល ឆ្នាំ ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ រោង ឆស័ក នឹង ប្រព្រឹត្តិ ទៅ ពី ថ្ងៃទី ១៣ រហូតដល់ ១៦ ខែមេសា ឆ្នាំ ២០២៤ ដែល មាន ៤ ថ្ងៃ ចាប់ពី ថ្ងៃអាទិត្យ ដល់ ថ្ងៃអង្គារ៍ ៕ ទីភ្នាក់ងារ UN ប្រចាំ តំបន់ ហ្គាហ្សា ថា កុមារ ម្នាក់ ក្នុង ចំណោម ៣នាក់ អាយុ ២ ឆ្នាំ កំពុង ខ្វះ អាហារូបត្ថម្ភ ធ្ងន់ធ្ងរ
ជាង ៥ខែ នៃ សង្រ្គាម ផ្លូវ អាកាស និង ជើង គោក របស់ អ៉ី ស្រាអែល នៅ ហ្គាហ្សា ដែល បង្កឡើង ដោយសារតែ ការវាយប្រហារ របស់ ក្រុមហា ម៉ាស កាលពី ថ្ងៃទី ៧ ខែតុលា ធ្វើឱ្យ ហេដ្ឋារចនាសម្ព័ន្ធ ភាគ ច្រើន រង ការបំផ្លិចបំផ្លាញ ហើយ ប្រជាជន ភាគ ច្រើន នៃ ចំនួន សរុប ២.៣លាន នាក់ ត្រូវ ផ្លាស់ ទីលំនៅ ក៏ ដូចជា ប្រឈមមុខ នឹង វិបត្តិ មនុស្សធម៌ ។
UNRWA បាន បង្ហោះ លើ ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម របស់ ខ្លួន យ៉ាង ដូច្នេះ ថា « កង្វះ អាហារូបត្ថម្ភ របស់ កុមារ កំពុង រីករាលដាល យ៉ាង រហ័ស និង ឈានដល់ កម្រិត មិន ធ្លាប់ មាន ពីមុន មក នៅក្នុង តំបន់ ហ្គាហ្សា » ។ មន្ទីរពេទ្យ មួយចំនួន នៅក្នុង តំបន់ ហ្គាហ្សា រាយការណ៍ ថា មាន កុមារ ស្លាប់ ដោយសារតែ កង្វះ អាហារូបត្ថម្ភ និង ខ្វះ ជាតិ ទឹក ។ ដោយឡែក ឃ្លាំមើល អសន្តិសុខ ស្បៀង អន្តរជាតិ (IPC) ក៏ គ្រោង ចេញ របាយការណ៍ អំពី វិសាលភាព នៃ វិបត្តិ ភាពអត់ឃ្លាន នៅក្នុង តំបន់ ហ្គាហ្សា នេះ ដែរ ។
គួរ បញ្ជាក់ ថា បើ តាម IPC យ៉ាងហោចណាស់ ២០ ភាគរយ នៃ ចំនួន ប្រជាជន នៅ ទីនោះ ខ្វះខាត ស្បៀងអាហារ យ៉ាង ខ្លាំង ដោយ កុមារ ម្នាក់ ក្នុង ចំណោម ៣នាក់ មាន កង្វះ អាហារូបត្ថម្ភ ធ្ងន់ធ្ងរ ហើយ មនុស្ស ២នាក់ ក្នុង ចំណោម ១០.០០០ នាក់ ត្រូវ ស្លាប់ ជារៀងរាល់ ថ្ងៃ ដោយសារ ការអត់ឃ្លាន ឬ កង្វះ អាហារូបត្ថម្ភ និង ជំងឺ ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៤៣០ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៦.២៤៨ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៤.៧៨៦ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៤៦២ គ្រឿង ។
បទល្មើស ដែល ត្រូវបាន កត់សម្គាល់ សម្រាប់ ម៉ូតូ រួម មាន៖ មួក គ្រឿងញៀន ស្រវឹង កែច្នៃ ស្លាកលេខ និង ភ្លើង - ផ្លាក ជាដើម ។ ដោយឡែក រថយន្ត រួម មាន៖ អត់ បណ្ណ បើកបរ ដឹក សំពីង សំពោង ភ្លើង - ផ្លាក ឆៀក គ្មាន ភ្លើង បំភ្លឺ និង លើស ល្បឿន ជាដើម ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១០លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៧ នាក់ របួស ចំនួន ១៥នាក់ ( របួស ធ្ងន់ ចំនួន ០៧ នាក់ ) ។ រយៈពេល ១៦ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១៣៦ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៨២ នាក់ របួស ១៦៧ នាក់ ( របួស ធ្ងន់ ៩៥ នាក់ )៕ កម្មវិធី ផ្សព្វផ្សាយ ក្នុង ដំណើរ ឆ្ពោះ ទៅ ការប្រារព្ធ ខួប ១៦១ ឆ្នាំ នៃ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា នៅ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ
( ភ្នំពេញ ) ៖ កាកបាទ ក្រហម កម្ពុជា នៅ រសៀល ថ្ងៃទី ១៥ ខែមីនា ឆ្នាំ ២០២៤ បាន រៀបចំ កម្មវិធី ផ្សព្វផ្សាយ ដំណើរ ឆ្ពោះ ទៅ ការប្រារព្ធ ខួប ១៦១ ឆ្នាំ នៃ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ឧសភា ឆ្នាំ ២០២៤ នៅ សាកលកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ ក្រោម ប្រធានបទ « រួមគ្នា ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដើម្បី សហគមន៍ មាន សុខភាព ល្អ និង មាន ភាពធន នឹង អាកាសធាតុ » ដែល នេះ ជា កម្មវិធី ទី៣ហើយ នៃ កម្មវិធី ផ្សព្វផ្សាយ នៅ តាម សាកលវិទ្យាល័យ ។
បទបង្ហាញ នេះ ត្រូវបាន ចូលរួម យ៉ាង ផុសផុល ពីសំណាក់ និស្សិត ក្នុង ឆ្លើយ សំណួរ លើកកម្ពស់ ការយល់ដឹង ។
នៅក្នុង ឳកាស នោះ លោកស្រី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា បាន មានប្រសាសន៍ កោតសរសើរ ដល់ ប្អូន ៗ និស្សិត សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ ដែល បាន ចូលរួម ស្តាប់ បទ បង្ហាញ ដោយ យកចិត្តទុកដាក់ ។ លោកស្រី បាន លើកឡើង ថា សម្តេច មហា បវរធិបតី នាយក រដ្ឋមន្រ្តី កម្ពុជា បាន លើកឡើង ជា ការប្តេជ្ញាចិត្ត ថា « ការលើកកម្ពស់ សុខភាព ប្រជាជន គឺជា អាទិភាព របស់ រាជ រដ្ឋាភិបាល » ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ក៏ តែ តែ គិតគូ អំពី សុខ ទុក របស់ ប្រជាជន កម្ពុជា ដោយ សម្តេច តែងតែ អំពាវនាវ ឱ្យ បងប្អូន ប្រជាពលរដ្ឋ យើង ប្រកាន់ខ្ជាប់ នូវ ទម្លាប់ រស់ នៅ ប្រកបដោយ សុខ ភាព ល្អ បញ្ចៀស នូវ ជំងឺ នានា ។
ដោយាសារ មូលបទ ឆ្នាំ នេះ មាន លក្ខណៈ ពិសេស ពាក់ព័ន្ធ នឹង ទាំងអស់ គ្នា គឺ ដើម្បី សហគមន៍ មាន សុខភាព ល្អ និង មាន ភាពធន នឹង អាកាសធាតុ លោកស្រី បាន អំពាវនាវ សូម ឱ្យ ប្អូន ៗ និស្សិត ចូលរួម ជាមួយ កាកបាទ ក្រហម កម្ពុជា យក នូវ ចំណេះដឹង ពី ការផ្សព្វផ្សាយ ថ្ងៃ នេះ ទៅ ផ្សព្វផ្សាយ បន្ត នៅ តាម សហគមន៍ ដែល ខ្លួន រស់ នៅ ដើម្បី ដើម្បី ជា គុណ ប្រយោជន៍ ដល់ ខ្លួន ឯង គ្រួសារ និង សហគមន៍ ។
ទន្ទឹម នឹង នោះ លោកស្រី ក៏ បាន ថ្លែង នូវ ការ អំពាវនាវ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន សូម បន្ត ចូលរួម បរិច្ចាក ថវិកា សម្ភារៈ ជូន កាកបាទ ក្រហម កម្ពុជា ដើម្បីឱ្យ សមាគម ជាតិ មាន ធនធាន គ្រប់គ្រាន់ ក្នុង ការបន្ត ផ្តល់ សេវាកម្ម មនុស្សធម៌ ជួយ ដល់ ជនរងគ្រោះ និង ងាយ រងគ្រោះ បំផុត ប្រកបដោយ បរិយា បន្ន ៕
ឃាត់ខ្លួន បុរស ម្នាក់ ក្រោយ ហែក បំផ្លាញ ស្លាក គណបក្ស ប្រជាជន កម្ពុជា នៅ សង្កាត់ បឹង ទំពន់ ទី២ ខណ្ឌ មានជ័យ
( ភ្នំពេញ ) ៖ បុរស ម្នាក់ ត្រូវបាន កម្លាំង ជំនាញ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ឃាត់ខ្លួន បន្ទាប់ពី រូប គេ ធ្វើ សកម្មភាព ហែក ស្លាក គណបក្ស ប្រជាជន កម្ពុជា នៅ ចំណុច ផ្លូវ ៣៧១ កែង ផ្លូវ ៩០BT ភូមិ ត្នោត ជ្រុំ៤ សង្កាត់ បឹង ទំពន់ ទី២ ខណ្ឌ មានជ័យ ។
ការឃាត់ខ្លួន នេះ ធ្វើឡើង ដោយ អនុវត្ត តាម បទបញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២២ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៤៨ នាក់ ។
សម្រាប់ លោក រោងចក្រ អាយ អេ អឺ ភែរឹល នឹង ផ្តល់ អត្ថប្រយោជន៍ ជាច្រើន ដូចជា លុយ បាយ ថ្ងៃត្រង់ លុយ បាយ ក្នុង ១ ខែ លុយ ព្រីម ប្រាក់ សម្រាប់ ធ្វើដំណើរ លុយ ជំនាញ ប្រាក់ រង្វាន់ និង ប្រាក់ ថែទាំ កូន ដែល ជា មធ្យមកម្មក ម្នាក់ អាច ទទួលបាន ប្រាក់ខែ ចន្លោះ ៣៨៧ ដុល្លារ ដល់ ៥៤០ ដុល្លារ ។
ទន្ទឹមនឹង នេះ លោក អំពាវនាវ ឱ្យ កម្មករ នៅ រោងចក្រ Y & W ដែល កំពុង ទន្ទឹងរង់ចាំ ដំណោះស្រាយ ឱ្យ ដាក់ ពាក្យ រក ការងារ ឱ្យ បាន គ្រប់ ៗ គ្នា ។ សូម បញ្ជាក់ ថា ការផ្តល់ ឱកាស ការងារ ដល់ កម្មករ នេះ គឺជា យន្តការ យកចិត្តទុកដាក់ ពី រាជ រដ្ឋាភិបាល ដែល មាន ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ជា សេនាធិការ ដើម្បី ផ្តល់ ឱកាស ការងារ ដល់ កម្មករ កម្មការិនី នៅ រោងចក្រ Y & W ក្នុង គោលបំណង បន្ត និរន្តរភាព ជីវភាព តាមរយៈ ការងារ ថ្មី ៕
ល្ងាច នេះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត និង លោកជំទាវ បណ្ឌិត អញ្ជើញ បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅ ខេត្ត សៀមរាប
( សៀមរាប ) ៖ នៅ ល្ងាច ថ្ងៃសៅរ៍ ៧កើត ខែ ផល្គុន ឆ្នាំ ថោះ បញ្ចស័ក ព .ស .២៥៦៧ ត្រូវនឹង ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា និង លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត នឹង អញ្ជើញ ជា អធិបតី បើក ពិធី បុណ្យ ទន្លេ លើក ទី៨ នៅក្នុង ខេត្ត សៀមរាប ។
ពិធី បើក បុណ្យ ទន្លេ រសៀល នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី សមាជិក ព្រឹទ្ធសភា សមាជិក រដ្ឋសភា សមាជិក រាជ រដ្ឋាភិបាល គណៈកម្មការ អន្តរ ក្រសួង ឯក អគ្គ រាជ ទូត - រដ្ឋទូត មេគង្គ និង មេគង្គ បូក១ គណៈ អភិបាល ខេត្ត ថ្នាក់ដឹកនាំ និង មន្ដ្រីរាជការ ក្រសួង ទេសចរណ៍ និង ខេត្ត សៀមរាប អង្គការ ជាតិ និង អន្តរជាតិ និង ផ្នែក ឯកជន សរុប ប្រមាណ ២.០០០ នាក់ ។
ពិធី បុណ្យ ទន្លេ លើក ទី៨ ក្នុង ខេត្ត សៀមរាប រៀបចំឡើង ក្រោម ប្រធានបទ « ទន្លេ ដើម្បី សន្តិភាព និង ការអភិវឌ្ឍ » មាន រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៥ ដល់ ទី១៧ ខែមីនា ឆ្នាំ ២០២៤ ។
ខេត្ត សៀមរាប ជា ខេត្ត ទេសចរណ៍ ដ៏ ល្បាញ ល្បី និង ប្រកបដោយ សក្តានុពល បំផុត របស់ កម្ពុជា ។ មិន ត្រឹម ទស្សនា ប្រាង្គ ប្រាសាទ ដែល ជា រតនៈ សម្បត្តិ របស់ កម្ពុជា មិន អាច កាត់ថ្លៃ បាន នោះ ទេ តែ ខេត្ត សៀមរាប មាន កន្លែង សម្រាប់ ទេសចរណ៍ បែប ធម្មជាតិ ដូចជា នៅ សហគមន៍ ទេសចរណ៍ កំពង់ភ្លុក ទស្សនា ភូមិឋាន ប្រជាពលរដ្ឋ ទស្សនា ផលិតផល ប្រចាំ តំបន់ និង ការលេង កម្សាន្ត នៅ តាម រមណីយដ្ឋាន ទេសចរ ច្នៃប្រឌិត ជាច្រើន ទៀត ។
បន្ទាប់ពី ជួប ស្ថានភាព ដ៏ លំបាក នៃ ការរាត ត្បាត ជំងឺ កូវីដ១៩ រាជ រដ្ឋាភិបាល កំពុង ដាក់ ចេញ វិធានការ ជាច្រើន ដើម្បី លើកកម្ពស់ សកម្មភាព ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប ឡើងវិញ ។ ក្នុង នោះ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន កំណត់ យក ឆ្នាំ ២០២៤ ជា ឆ្នាំ ទស្សនា ខេត្ត សៀមរាប ដែល ជា កម្មវិធី មួយ ជំរុញ សកម្មភាព ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប ឡើងវិញ ។
ពិធី បុណ្យ ទន្លេ ក្នុង ខេត្ត សៀមរាប ឆ្នាំ នេះ គឺជា ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ គាំទ្រ ដល់ សកម្មភាព ទស្សនា ចរ ខេត្ត សៀមរាប ក្នុង ឆ្នាំ ២០២៤ ។ ដើម្ប ទាក់ទាញ អ្នកទេសចរ ក្នុង ពិធី បុណ្យ ទន្លេ បាន រៀបចំ ព្រឹត្តិការណ៍ ជាច្រើន ជាមួយ ការបញ្ចេញ កញ្ចប់ ថវិកា រហូតដល់ទៅ ប្រមាណ ៤៥០ លាន រៀល ។
គួរ បញ្ជាក់ ថា រុស្ស៉ី កំពុង ដំណើរការ ការបោះឆ្នោត ប្រធានាធិបតី មាន រយៈពេល ៣ ថ្ងៃ ដែល បាន ចាប់ផ្ដើម កាលពី ថ្ងៃទី ១៥ រហូតដល់ ថ្ងៃទី ១៧ ខែមីនា ខណៈ មាន ការរំពឹង ខ្ពស់ ថា ការបោះឆ្នោត នេះ នឹង ផ្ដល់ ឱកាស ឱ្យ លោក ពូទីន បន្ត កាន់អំណាច ដឹកនាំ រុស្ស៉ី ៦ឆ្នាំ ទៀត ៕
គួរ បញ្ជាក់ ថា Rafah គឺជា កន្លែង ជ្រកកោន ចុងក្រោយ របស់ ប្រជាជន ប៉ាឡេស្ទីន ដែល បាន រត់ ភៀសខ្លួន ពី សង្រ្គាម សងសឹក របស់ អ៉ី ស្រាអែល ប្រឆាំង នឹង ក្រុមហា ម៉ាស ដែល បាន វាយប្រហារ លើ ភាគ ខាងត្បូង អ៉ី ស្រាអែល កាលពី ថ្ងៃទី ៧ ខែតុលា ។ បើ តាម ក្រសួង សុខាភិបាល ហ្កាហ្សា ការវាយប្រហារ សងសឹក នេះ ដែរ បាន សម្លាប់ ជនជាតិ ប៉ាឡេស្ទីន ៣១ ៤៩០ នាក់ ហើយ ក្នុង នោះ ភាគ ច្រើន ជា ស្ត្រី និង កុមារ ៕
ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី អញ្ជើញ ជា អធិបតី ពិធី បុណ្យ បញ្ចុះ ខណ្ឌ សីមា និង សម្ពោធ សមិទ្ធផល នានា នៅ វត្ត វិហារ ខ្ពស់ នៅ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ លោក ហ៊ុន ម៉ានី ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ និង ប្រធាន ក្រុមការងារ គណបក្ស ប្រជាជន កម្ពុជា ចុះ ជួយ ខេត្ត កំពង់ស្ពឺ អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បុណ្យ បញ្ចុះ ខណ្ឌ សីមា និង សម្ពោធ សមិទ្ធផល នានា នៅ វត្ត វិហារ ខ្ពស់ ដែល ស្ថិត នៅ សង្កាត់ វាំង ចាស់ ក្រុង ឧដុង្គ ម៉ែ ជ័យ ខេត្ត កំពង់ស្ពឺ ដែល បាន ប្រព្រឹត្តទៅ នា ព្រឹក ថ្ងៃទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ ។
និមន្ត និង អញ្ជើញ ចូលរួម ក្នុង ពិធី នោះ រួម មាន ព្រះមុនី សត្ថាចារ្យ កោសល កែវ ចន្ថា ព្រះមេ គណ ខេត្ត កំពង់ស្ពឺ ព្រះថេរានុ ថេរៈ សមាជិក ព្រឹទ្ធសភា រដ្ឋសភា ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ ជួយ មូលដ្ឋាន ខេត្ត ក្រុង ស្រុក នៃ ខេត្ត កំពង់ស្ពឺ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ចំណុះ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ និង ប្រជាពលរដ្ឋ ជាច្រើន រូប ។
ជាមួយគ្នា នេះ ក៏ មាន សមិទ្ធផល ថ្មី ៗ ជាច្រើន ទៀត ដែល ត្រូវ សម្ពោធ ឆ្លង នា ព្រឹក នេះ ផងដែរ ក្នុង នោះ រួម មាន ដង ទង់១គូ កម្ពស់ ២៧.៥ម៉ែត្រ . ហោត្រៃ ទំហំ ១៥ម៉ែត្រ គុណ ៩ម៉ែត្រ កម្ពស់ ១២ម៉ែត្រ . កុដិ ២ខ្នង . ក្លោងទ្វារ ដែល មាន ទទឹង ៥ម៉ែត្រ កម្ពស់ ៨ម៉ែត្រ និង ហេដ្ឋារចនាសម្ព័ន្ធ ដទៃ ទៀត ដែល គិត ជា ទឹកប្រាក់ សរុប អស់ ប្រមាណ ជាង ៥៦០.០០០ ដុល្លារ អាមេរិក ៕ ស្រូវ ប្រាំង របស់ ប្រជាកសិករ ក្នុង ស្រុក កំពង់លែង មួយ ភាគ ធំ ប្រមូល ផល រួច នៅ សេសសល់ បន្តិចបន្តួច ដែល កំពុង បន្ត ជួយសង្គ្រោះ
ជាមួយគ្នា នេះ លោក អភិបាល រង ខេត្ត ក៏ បាន ពិនិត្យ ឃើញ ថា ស្រែ របស់ ប្រជាកសិករ នៅ ក្នុង ស្រុក កំពង់លែង មួយចំនួន ក៏ ត្រូវបាន ច្រូ ត កាត់ រួចរាល់ហើយ ផងដែរ ដោយ នៅ សេសសល់ ស្រូវ ស្រែ ប្រជាកសិករ មួយចំនួន ទៀត ដែល កំពុង ត្រូវការ ទឹក មុនពេល ប្រមូល ផល ចំណែក ស្រូវ ដែល នៅ សេសសល់ ទាំងអស់ នោះ គឺ បាន បែក ស្រុះ ជា បណ្ដើរ ៗ ដែល នៅ មិន យូរ ប៉ុន្មាន ថ្ងៃ ទៀត នោះ ទេ នឹង ត្រូវបាន ប្រមូល ផល ទាំងអស់ ដោយ ស្ថាពរ ៕
ប្រកាស កែសម្រួល សមាសភាព ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត និង ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ស្រុក នៃ ខេត្ត រតនគិរី
( រតនគិរី ) ៖ លោក ជៀង អំ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត រតនគិរី បាន អញ្ជើញ ប្រកាស កែសម្រួល សមាសភាព ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត និង ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង ស្រុក នៃ ខេត្ត រតនគិរី ។
ពិធី នេះ បាន ធ្វើឡើង នៅ នា ព្រឹក ថ្ងៃសៅរ៍ ទី ១៦ ខែមីនា ឆ្នាំ ២០២៤ នេះ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត រតនគិរី ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក ញ៉ែ ម សំអឿន ប្រធាន គណៈកម្មាធិការ គណបក្ស ខេត្ត រតនគិរី ព្រមទាំង សមាជិក សមាជិការ គណបក្ស ក្រុង ស្រុក សរុប ប្រមាណ ២០០ នាក់ ។
តាមរយៈ សេចក្តីសម្រេច គឺ សមាជិក សមាជិកា គណៈកម្មាធិការ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ស្រុក ក្រុង ឃុំ សង្កាត់ និង សមាជិក សមាជិកា ក្រុមប្រឹក្សា ខេត្ត ស្រុក ក្រុង ឃុំ សង្កាត់ នៃ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត រតនគិរី និង សកម្មជន ដែល ទទួល ភារកិច្ច នៅក្នុង ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន នានា ក្នុង ខេត្ត រតនគិរី ត្រូវ បន្ត ភារកិច្ច ក្នុង ក្រុមការងារ នេះ ដដែល ។
ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត និង ប្រធាន គណៈកម្មាធិការ គណបក្ស ខេត្ត មាន សិទ្ធិ ស្នើ ចាត់តាំង កែសម្រួល បំពេញ បន្ថែម ឬ ចាត់តាំង កែសម្រួល បំពេញ បន្ថែម សមាសភាព ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត ស្រុក ក្រុង ឃុំ សង្កាត់ តាម ការចាំបាច់ ។
ថ្លែង នៅក្នុង ឱកាស នេះ លោក ញ៉ែម សំអឿន បាន លើកឡើង ថា សាមគ្គីភាព និង ការសហការ ល្អ រវាង ក្រុមការងារ គណបក្ស និង សមាជិក សមាជិកា គណៈកម្មាធិការ គណបក្ស ខេត្ត រតនគិរី គ្រប់ ជាន់ ថ្នាក់ បម្រើ ប្រជាពលរដ្ឋ ប្រកបដោយ ការទទួលខុសត្រូវ ស្រប តាម គោល នយោបាយ និង អំពើ ល្អ របស់ មន្ត្រី បក្ស គឺជា កត្តា សំខាន់ ទទួលបាន ទំនុកចិត្ត ពី ប្រជាពលរដ្ឋ និង ជា កត្តា ចម្បង នៃ ជ័យជម្នះ របស់ គណបក្ស ប្រជាជន កម្ពុជា នា ពេល កន្លងមក ។
លោក បាន លើកទឹកចិត្ត ដល់ សមាជិក សមាជិកា ទាំងអស់ ត្រូវ បន្ត ប្រពៃណី ដ៏ ល្អ ប្រពៃ នេះ និង រួមគ្នា ខិតខំ បម្រើ ប្រជាពលរដ្ឋ ឱ្យ អស់ លទ្ធភាព ។ ជ័យជម្នះ ដែល គណបក្ស ប្រជាជន កម្ពុជា ទទួលបាន នៅ រៀងរាល់ ការបោះឆ្នោត គឺ មិន មែន ត្រឹមតែ ជា ជោគជ័យ នៅលើ សន្លឹក ឆ្នោត ទេ ប៉ុន្តែ គឺជា ជោគជ័យ របស់ ប្រជាជន កម្ពុជា នៅ ទូទាំង ប្រទេស ។
នា ឱកាស នោះ ដែរ លោក ជៀង អំ បាន កោតសរសើរ ចំពោះ ក្រុមការងារ ទាំងអស់ និង សមាជិក សមាជិកា គណបក្ស ប្រជាជាន កម្ពុជា ខេត្ត រតនគិរី ដែល បាន ខិតខំ ប្រឹងប្រែង យក អស់ កម្លាំង កាយ ចិត្ត ស្មារតី និង ថវិកា ដើម្បី បុព្វហេតុ ប្រជាជន និង ត្រូវ បន្ត សហការ ស្អិត រមួត ជាមួយ គណៈកម្មាធិការ បក្ស ខេត្ត ក្រុង ស្រុក និង ឃុំ សង្កាត់ សាខា បក្ស ភូមិ ដើម្បី បន្ត បម្រើ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត រតនគិរី ឱ្យ កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ស្រប តាម ស្មារតី នៃ មហាសន្និបាត វិសាមញ្ញ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
ដើម្បី បំពេញ ការងារ ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ប្រធាន ក្រុមការងារ បាន ធ្វើ ការដាក់ចេញ ផែនការ ដល់ ក្រុមការងារ សម្រាប់ អនុវត្តន៍ បន្ត រួម មាន៖
១៖ បន្ត ការងារ ចាត់តាំង ក្រុមការងារ ចុះ មូលដ្ឋាន តាម ក្រុង ស្រុក ឃុំ សង្កាត់ និង ត្រូវ រៀបចំ កែសម្រួល សមាភាព ក្រុមការងារ ចុះ មូលដ្ឋាន ក្រុង ស្រុក ឃុំ សង្កាត់ ។
២៖ ត្រូវ បន្ត ផ្សព្វផ្សាយ កម្មវិធី នយោបាយ របស់ គណបក្ស ដែល បាន ដាក់ចេញ តាមរយៈ កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ និង ត្រូវ អនុវត្ត បណ្តា ការងារ សំខាន់ ៗ រួម មាន៖
* យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ នីតិកាល ទី៧ នៃ រដ្ឋសភា គឺ ផ្តោត សំខាន់ លើ អាទិភាព ចំនួន ៥ « មនុស្ស ផ្លូវ ទឹក ភ្លើង និង បច្ចេកវិទ្យា ឌីជីថល » ។ * បន្ត ពង្រឹង ការអនុវត្ត ថែរក្សា ការពារ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ក្នុង នោះ ខ្ញុំ សូម សង្កត់ធ្ងន់ លើ « កងទ័ព មិន អព្យាក្រឹត្យ លើ រាជ រដ្ឋាភិបាល អព្យាក្រឹត្យ លើ គណបក្ស នយោបាយ » ។ * បន្ត ពង្រឹង ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព យកចិត្តទុកដាក់ បង្ក្រាប បទល្មើស ជួញដូរ គ្រឿងញៀន ឱ្យ មាន ប្រសិទ្ធិភាព ខ្ពស់ ៕
សាលាដំបូង រាជធានី ភ្នំពេញ បើក សវនាការ ជំនុំជម្រះ ក្ដី ទាក់ទិន ករណី ឆបោក លើ វិនិយោគ គិន ជប៉ុន រឿង ទិញ ដីធ្លី នៅ ខេត្ត កំពង់ស្ពឺ
( ភ្នំពេញ ) ៖ សំណុំរឿង ឆបោក អ្នក វិនិយោគ ជប៉ុន រឿង ទិញ លក់ ដីធ្លី នៅ ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ ត្រូវបាន សាលាដំបូង រាជធានី ភ្នំពេញ បើក សវនាការ ជំនុំជម្រះ កាលពី សប្ដាហ៍ កន្លងទៅ ហើយ នឹង ប្រកាស សាលក្រម នៅ ចុង ខែមីនា ខាងមុខ នេះ ។
បើ តាម ការស្រាយ បំភ្លឺ ពី ជនរងគ្រោះ និង ជាដើម បណ្ដឹង ជនជាតិ ជប៉ុន បាន បកស្រាយ ថា លោកស្រី ថោង សុខ ខេង និង បក្ខពួក ខាងលើ រួមទាំង បុគ្គល ពាក់ព័ន្ធ ផ្សេង ទៀត បាន ធ្វើ ការរារាំង និង រំខាន គ្រប់ រូបភាព លើ គំរោង វិនិយោគ របស់ លោក នា ពេល កន្លងមក ។
ជាក់ស្តែង បង្គោល ព្រំ ដី របស់ លោក ត្រូវបាន រង ការបំផ្លិចបំផ្លាញ ទាំងស្រុង នៅ ឆ្នាំ ២០២០ ។ មិន ត្រឹមតែ ប៉ុណ្ណោះ នៅពេល ចុះ វាស់វែង រក បង្គោល ព្រំ ដី ម្តង ទៀត អ្នកតំណាង របស់ ម្ចាស់ ដី ត្រូវបាន ក្រុម ខាងលើ ដាក់ពាក្យ ប្តឹង ពី បទ ព្រហ្មទណ្ឌ ដោយ ចោទ ថា ក្រុម លោក បាន ចូល បំផ្លិចបំផ្លាញ ទ្រព្យសម្បត្តិ របស់ ពួកគេ ទៅ វិញ ។
អ្វី ដែល គួរឲ្យ តក់ស្លុត ជាង នេះ ទៅ ទៀត នោះ កសិដ្ឋាន ចិញ្ចឹម មាន់ ចំនួន ១៦ រោង មាន តំលៃ សរុប ជាង កន្លះ លាន ដុល្លា ដែល រង ការរំខាន មិន បាន ដំណើរការ ស្រាប់ ទៅ ហើយ នោះ ត្រូវ រង ការដុត បំផ្លាញ ទាំងស្រុង ពី ជន មិន ស្គាល់ មុខ ទាំង កណ្តាល ថ្ងៃត្រង់ កាលពី ថ្ងៃទី ២៨ ខែកុម្ភៈ ឆ្នាំ ២០២៤ ថ្មី ៗ នេះ មុន ការ ជំនំ ជំរះ លើ ករណី លោកស្រី ថោង សុខ ខេង តែ ប្រមាណ ជា ១សប្តាហ៍ តែ ប៉ុណ្ណោះ ។
បច្ចុប្បន្ន អ្នក វិនិយោគ ជនជាតិ ជប៉ុន ( សញ្ជាតិ ខ្មែរ ) បាន និង កំពង់ រង ភាពអយុត្តិ ធ៌ម ពី ការឆបោក ដី ចំនួន ៣២៨ ហិចតា ពី លោកស្រី ថោង សុខ ខេង និង បក្ខពួក មួយ ករណី ពី ការរំលោភបំពាន កាន់កាប់ ដី ដោយ ហិង្សា លើ ដី ចំនួន ១១៧ ហិចតា ពីសំណាក់ មនុស្ស មួយ ក្រុម ។
ដោយឡែក អ្នកតំណាង របស់ លោក ម្នាក់ ជា ជន ជតិ ខ្មែរ កំពង់ រងគ្រោះ ដោយ បណ្តឹង ព្រហ្មទណ្ឌ សំណុំរឿង លេខ ១៣៧១ ចុះ ថ្ងៃទី ២៦ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នៅ សាលាដំបូង ខេត្ត កំពង់ស្ពឺ ពី ក្រុម អ្នក មក រំលោភបំពាន ទៅ វិញ ។
ក្រៅពី នេះ ជនរងគ្រោះ ជា អ្នក វិនិយោគ ខាងលើ បាន ខាតបង់ ពេលវេលា ដើមទុន និង ឱកាស វិនិយោគ យ៉ាង ច្រើន សន្ធឹក សណ្ធាប់ លើ វិស័យ កសិឧស្សាហកម្ម សេវាកម្ម វិស័យ អប់រំ និង បាត់ ឧកាស ក្នុង ការទាក់ទាញ វិនិយោគិន ជនជាតិ ជប៉ុន ផ្សេង ទៀត មក បណ្តាក់ទុន រកស៊ី នៅ កម្ពុជា ទៀតផង ។
