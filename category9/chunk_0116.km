( ភ្នំពេញ ) ៖ ចាប់តាំងពី ឆ្នាំ ១៩៤៥មក ប្រទេស កម្ពុជា មាន នាយក រដ្ឋមន្ត្រី ចំនួន ៣៧អង្គ / រូប ហើយ ដោយ ក្នុង ចំណោម នោះ មាន ទាំង ព្រះមហាក្សត្រ រាជ វង្សានុវង្ស ឥស្សរជន ម្យ៉ាងទៀត ក៏ មាន ៤រូប ជា នាយក រដ្ឋមន្រ្តី ស្តីទី ( បណ្តោះអាសន្ន ) ។ នេះ បើ តាម គេហទំព័រ វីគី ភីឌា ។
លោក វ៉ាន់ មូហាម៉ាត់ ណ មៈ ថា បាន ថ្លែង បែប នេះ ក្នុង ពេល ជួប សម្តែង ការគួរសម ក៏ ដូចជា ពិភាក្សា ការងារ មួយចំនួន ជា មួួយ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ រសៀល ថ្ងៃសុក្រ ទី ២២ ខែមីនា ឆ្នាំ ២០២៤ នេះ ។
លោក វ៉ាន់ មូហាម៉ាត់ ណ មៈ ថា កំពុង ដឹកនាំ គណៈប្រតិភូ រដ្ឋសភា ថៃ បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ។ ក្នុង ជំនួប ជាមួយ សម្តេច ធិបតី លោក ប្រធាន រដ្ឋសភា ថៃ បាន ថ្លែងអំណរគុណ សម្តេច ធិបតី ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មមាញឹក អនុញ្ញាតឱ្យ រូប លោក និង គណៈប្រតិភូ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ។ លោក ក៏ បាន ថ្លែងអំណរគុណ ព្រឹទ្ធសភា និង រដ្ឋសភា កម្ពុជា ដែល បាន ទទួលស្វាគមន៍ រូបលោក និង គណៈប្រតិភូ យ៉ាង ល្អ និង យ៉ាង កក់ក្តៅ ក្នុង ឱកាស បំពេញ ទស្សនកិច្ចការងារ នេះ ។
នៅ ចំពោះមុខ សម្តេច ធិបតី . ប្រធាន រដ្ឋសភា ថៃ បាន សម្តែង ការកោតសរសើរ ជាខ្លាំង ចំពោះ សមត្ថភាព និង ភាព ជា អ្នកដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ ដោយ នាំមក នូវ ភាពរីកចម្រើន និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដល់ ប្រទេស កម្ពុជា ។
ប្រធាន រដ្ឋសភា ថៃ ក៏ បាន បង្ហាញ ការជឿជាក់ ដែរ ថា ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី កម្ពុជា នឹង បន្ត ការអភិវឌ្ឍ យ៉ាង ខ្លាំងក្លា ថែម ទៀត ។
សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន សម្តែង ការស្វាគមន៍ ចំពោះ ប្រធាន រដ្ឋសភា និង គណៈប្រតិភូ ដែល បាន អញ្ជើញ មក បំពេញ ទស្សនកិច្ច នៅ កម្ពុជា ព្រមទាំង បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា - ថៃ ដែល បាន ឈានដល់ កម្រិត « ភាពជាដៃគូ យុទ្ធសាស្រ្ត » ដែល ជា ទំនាក់ទំនង ដ៏ ល្អ ប្រសើរ ។
សម្តេច ធិបតី ក៏ បាន បញ្ជាក់ ផងដែរ ថា តាមរយៈ ទស្សនកិច្ច នា ពេលនេះ នឹង ចូលរួមចំណែក ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ មាន ជាអាទិ៍ វិស័យ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម អប់រំ ទេសចរណ៍ ការពារ ជាតិ សន្តិសុខ និង វិស័យ ផ្សេង ៗ ទៀត ។
មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ ប្តេជ្ញា បន្ត ការងារ ផ្តល់ វ៉ាក់សាំង ផ្តល់ អាហារូបត្ថម្ភ សម្រាប់ ទារក កុមារ និង ស្ត្រី ឲ្យ កាន់តែ ប្រសើរឡើង ថែម ទៀត
( ត្បូងឃ្មុំ ) ៖ លោក វេជ្ជបណ្ឌិត កែវ វណ្ណៈ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ ប្តេជ្ញា បន្ត ការងារ ផ្តល់ វ៉ាក់សាំង គ្រប់ ប្រភេទ ការងារ អាហារូបត្ថម្ភ សម្រាប់ ទារក កុមារ និង ស្ត្រី ស្ថិត ក្នុង វ័យ បន្ត ពូជ ឲ្យ កាន់តែ ប្រសើរឡើង ថែម ទៀត ។
ការលើកឡើង បែប នេះ ក្នុង សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ នៅ សាល ប្រជុំ ( គ) សាលា ខេត្ត ត្បូងឃ្មុំ ។ ពិធី នេះ ប្រព្រឹត្តទៅ នា ថ្ងៃទី ២១ ខែមីនា ឆ្នាំ ២០២៣ ក្រោម អធិបតីភាព របស់ លោក ពាង ណារិទ្ធ និង លោក ម៉ៅ ឌុង អភិបាល រង ខេត្ត ត្បូងឃ្មុំ តំណាង លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត និង លោក ឡុង ធាម សមាជិក ក្រុមប្រឹក្សា ខេត្ត ។
ថ្លែង ទៅកាន់ លោក លោកស្រី ថ្នាក់ដឹកនាំ សាលា ខេត្ត មន្ទីរ - អង្គភាព ជុំវិញ ខេត្ត អាជ្ញាធរ មូលដ្ឋាន មន្ត្រី សុខាភិបាល និង អង្គការ ដៃគូ ដែល បាន អញ្ជើញ ចូលរួម លោក វេជ្ជបណ្ឌិត កែវ វណ្ណៈ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត ត្បូងឃ្មុំ បាន លើកឡើង ថា « យើង ទាំងអស់ គ្នា បាន ពិនិត្យ ឃើញ ហើយ ពី សមិទ្ធផល ការងារ សុខាភិបាល យ៉ាង ច្រើន ដែល សម្រេចបាន ក្នុង ឆ្នាំ ២០២៣ តាមរយៈ ការធ្វើ បទបង្ហាញ » ។
លោក វេជ្ជបណ្ឌិត បន្ថែម ថា ជាពិសេស បាន កំណត់ ធាតុ ចូល រួមបញ្ចូល ជាមួយ កម្មវិធី ជា យុទ្ធសាស្ត្រ ក្រសួង សុខាភិបាល សម្រាប់ ផែនការ ទិសដៅ ការងារ បន្ត នៅ ឆ្នាំ ខាងមុខ ទៀត ពិសេស បញ្ហា ប្រឈម សំណូមពរ និង តម្រូវការ ពី អាជ្ញាធរ មូលដ្ឋាន ។
អភិបាល ខេត្ត ព្រះវិហារ ណែនាំ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត ពង្រឹង ការអនុវត្ត ឲ្យបាន ស្រួច ស្រាល់ បំផុត កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧
( ព្រះវិហារ ) ៖ លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត បាន ថ្លែង ណែនាំ ដល់ កងកម្លាំង កងទ័ព ក្នុង អង្គភាព តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត ត្រូវតែ បន្ត ពង្រឹង ការអនុវត្ត ឲ្យបាន ស្រួច ស្រាល់ បំផុត តាម កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា និង អាណត្តិ បន្ត ទៀត ។
ក្នុង ឱកាស នោះ លោក គឺ ម រិទ្ធី បាន ធ្វើ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ មេបញ្ជាការ មេបញ្ជាការ រង នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន កម្លាំង ជំនាញ និង អង្គភាព ចំណុះ បញ្ជាការដ្ឋាន តំបន់ ប្រតិបត្តិការ សឹក រង ព្រះវិហារ ដែល បាន យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការអនុវត្ត ការងារ រហូត សម្រេចបាន លទ្ធផល ល្អ ប្រសើរ ។
ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត ជា ប្រមុខ ដឹកនាំ បាន ធ្វើឲ្យ កងយោធពល ខេមរភូមិន្ទ បំពេញ តួនាទី ជា ស្នូល ក្នុង ការការពារ សន្តិភាព ការពារ បូរណភាព ទឹកដី អធិបតេយ្យ ជាតិ រឹងមាំ ក្នុង នោះ កងយោធពល ខេមរៈ ភូមិន្ទ គឺជា កម្លាំង ឈាន មុខ និង ជា គំរូដ៍ ធំ ធេង លើ មាតុភូមិ ដោយ បំពេញ ភារកិច្ច អនុវត្ត មុឺង ម៉ាត់ ប្រកបដោយ ប្រសិទ្ធភាព តាម វិធានការ របស់ រាជ រដ្ឋាភិបាល ដែល បាន ដាក់ចេញ ។
អគ្គ ស្នងការ នគរបាល ជាតិ ប្រគល់ រថយន្ដ អគ្គិសនី បំពាក់ ស៊ីរ៉ែន ជូន ស្នងការដ្ឋាន នគរបាល រាជធានី - ខេត្ត ចំនួន ៥
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រគល់ រថយន្ត អគ្គិសនី បំពាក់ ស៊ីរ៉ែន ជូន ស្នងការដ្ឋាន នគរបាល រាជធានី - ខេត្ត ចំនួន ៥ ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ ស ថេត បាន ថ្លែងអំណរគុណ ចំពោះ សប្បុរសជន ដែល បាន ចំណាយ ធនធាន ផ្ទាល់ខ្លួន ជួយ គាំទ្រ ដល់ កងកម្លាំង នគរបាល ជាតិ ដើម្បី ចូលរួមចំណែក រក្សា សន្តិសុខ សុវត្ថិភាព និង ការបំពេញ ភារកិច្ច ប្រចាំ ថ្ងៃ របស់ អង្គភាព ។ រថយន្ត នេះ ជា ប្រភេទ រថយន្ត ប្រើប្រាស់ ថាមពល អគ្គីសនី ដែល អាច ប្រើប្រាស់ ក្នុង រង្វង់ ៣០០ ទៅ ៤០០ គីឡូម៉ែត្រ ទើប សាកបញ្ចូល ឡើងវិញ ហើយ រថយន្ត នេះ អាច ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ដូច ជា៖ ដឹកនាំ ក្បួន និង បម្រើ ការងារ ផ្សេង ៗ នៅក្នុង រាជធានី - ខេត្ត របស់ ខ្លួន ។
នាយ ឧត្តមសេនីយ៍ អគ្គ ស្នងការ បាន ផ្តាំផ្ញើ ដល់ ស្នងការ នគរបាល រាជធានី - ខេត្ត ដែល ទទួលបាន រថយន្ត នេះ ត្រូវ ទទួលខុសត្រូវ ថែរក្សា ឲ្យ ដូចជា ទ្រព្យសម្បត្តិ របស់ ខ្លួន ដើម្បី ធានា ការប្រើប្រាស់ បាន យូរអង្វែង ។ ដោយឡែក សម្រាប់ បណ្តា ខេត្ត ដែល មិន ទាន់ ទទួលបាន រថយន្ត អាចនឹង មាន នៅ ពេល ក្រោយ ៗ ពីព្រោះ ខេត្ត ដែល ទទួលបាន រថយន្ត នេះ គឺជា ខេត្ត ដែល ចាំបាច់ ក្នុង ការទទួល រថយន្ត ទាំងនេះ ។
នាយ ឧត្តមសេនីយ៍ សង្ឃឹម ថា សប្បុរសជន នឹង បន្ត ជួយ ជា រថយន្ត ឬ សម្ភារៈ នានា មកដល់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បន្ត ទៀត ដើម្បី ចូលរួមចំណែក ក្នុង កិច្ចការ ការពារ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ។
សូម បញ្ជាក់ ថា រថយន្ត ដែល ត្រូវ ប្រគល់ ជូន ដល់ ស្នងការ នគរបាល រាជធានី - ខេត្ត នា ពេលនេះ មាន ចំនួន១០ គ្រឿង ក្នុង នោះ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ទទួលបាន ចំនួន ២គ្រឿង . ស្នងការដ្ឋាន នគរបាល ខេត្ត បាត់ដំបង ចំនួន ២គ្រឿង . ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រៃវែង ចំនួន ២គ្រឿង . ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ចំនួន ២គ្រឿង និង ស្នងការដ្ឋាន នគរបាល ខេត្ត ពោធិ៍សាត់ ចំនួន ២គ្រឿង ៕
ក្រសួង ទេសចរណ៍ និង អង្គការ អន្តរជាតិ ហ្រ្វង់ កូហ្វូនី ជំរុញ ការបណ្តុះបណ្តាល ភាសា បារាំង ដល់ អ្នកធ្វើការ ក្នុង វិស័យ ទេសចរណ៍ កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ និង អង្គការ អន្តរជាតិ ហ្រ្វង់ កូហ្វូនី ឯកភាព ពង្រឹង ការអភិវឌ្ឍ ទេសចរណ៍ ប្រកបដោយ និរន្តរភាព ដោយ ផ្តោត លើ ស្ត្រី និង យុវជន ក្នុង វិស័យ ទេសចរណ៍ និង ជំរុញ ការបណ្តុះបណ្តាល ភាសា បារាំង ដល់ អ្នកធ្វើការ ក្នុង វិស័យ ទេសចរណ៍ កម្ពុជា ។
ការឯកភាព នេះ ធ្វើឡើង ក្នុង ជំនួប រវាង លោក សុខ សូកេន រដ្ឋមន្រ្តី ក្រសួង ទេសចរណ៍ ជាមួយ លោក Edgar Doerig តំណាង អង្គការ អន្តរជាតិ ហ្រ្វង់ កូហ្វូនី (OIF) នៃ តំបន់ អាស៊ី ប៉ាស៊ីហ្វិក នា ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៤ ដើម្បី ពិនិត្យ កាលានុវត្តភាព ជំរុញ កិច្ចសហប្រតិបត្តិការ ក្នុង ការអភិវឌ្ឍ ទេសចរណ៍ កម្ពុជា ប្រកបដោយ និរន្តរភាព ដោយ ការអភិវឌ្ឍ ទេសចរណ៍ ប្រកបដោយ និរន្តរភាព ជា កម្មវិធី មួយ ក្នុង ចំណោម កម្មវិធី អាទិភាព ទាំង២០ របស់ អង្គការ អន្តរជាតិ ហ្រ្វង់ កូហ្វូនី ។
លោក រដ្ឋមន្រ្តី និង លោក Edgar Doerig បាន ឯកភាព ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង ក្រសួង ទេសចរណ៍ និង អង្គការ អន្តរជាតិ ហ្រ្វង់ កូហ្វូនី ក្នុង ការជំរុញ ការអភិវឌ្ឍ ទេសចរណ៍ ប្រកបដោយ និរន្តរភាព ដោយ ផ្តោត លើ ស្ត្រី និង យុវជន ក្នុង វិស័យ ទេសចរណ៍ និង ជំរុញ ការបណ្តុះបណ្តាល ភាសា បារាំង ដល់ អ្នកធ្វើការ ក្នុង វិស័យ ទេសចរណ៍ កម្ពុជា ផងដែរ ៕
ទេសរដ្ឋមន្ត្រី អៀង មូលី ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ ឯក អគ្គ រដ្ឋទូត បារាំង ទទួលបន្ទុក សិទ្ធិ អ្នកស្រឡាញ់ ភេទ ដូចគ្នា
ជា ការចូលរួម មតិ លោកស្រី លេខា ទី១ ស្ថានទូត បារាំង ប្រចាំ កម្ពុជា បាន គូសបញ្ជាក់ ថា មាន វិស័យ មួយចំនួន ដែល កម្ពុជា ធ្វើជា គំរូ ។ ក្នុង នោះ ការព្យាបាល បង្ការ ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ គឺជា គំរូ សម្រាប់ ប្រទេស នានា នៅលើ ពិភពលោក ។ មុននឹង បញ្ចប់ ឯក អគ្គ រដ្ឋទូត បាន សន្យា បំពេញ ការងារ យ៉ាង ជិតស្និទ្ធ ជាមួយ កម្ពុជា ។ ទន្ទឹម នឹង នោះ កម្ពុជា ត្រូវ ការពារ របាយការណ៍ នៅ ហ្សឺណែវ នៅក្នុង កិច្ចប្រជុំ នា ខែឧសភា ខាងមុខ ដែល នឹង ធ្វើ ការបូកសរុប លទ្ធផល នៅ ពេល នោះ ។
ជា ទីបញ្ចប់ ទេសរដ្ឋមន្រ្តី បាន ថ្លែងអំណរគុណ ចំពោះ ពាក្យពេចន៍ កោតសរសើរ កម្ពុជា ក្នុង ការខិតខំ ប្រឹងប្រែង ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ និង សន្យា បន្ត សហការ ជាមួយ ភាគី បារាំង បន្ត ទៅ មុខ ទៀត ៕ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត ឧប នាយក រដ្ឋមន្ត្រី ហ៊ុន ម៉ានី បន្ត ចុះ ពិនិត្យ និង ព្យាបាល ដោយ ឥត គិត ថ្លៃ ជូន ពលរដ្ឋ នៅ ស្រុក បរ កែវ ខេត្ត រតនគិរី (Video inside)
គួរ បញ្ជាក់ ផងដែរ ការចូលរួម សកម្មភាព បម្រើ សង្គម រៀនសូត្រ បន្ថែម នៅ មូលដ្ឋាន ជាក់ស្តែង និង ចូលរួមចំណែក លើកកម្ពស់ សុខ មាលភាព ប្រជាជន ដែល ស្រប តាម គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចេរភាព របស់ រាជ រដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា អណត្តិ ទី៧ ដែល មាន សម្តេច មហា បវធិបតី ហ៊ុន ម៉ាណែត ជា ប្រមុខ ដឹកនាំ ។
ដូច សព្វមួយ ដង ប្រជាពលរដ្ឋ ពិតជា មាន ក្តី រំភើប កក់ក្តៅ ឥត ឧបមា គោរព ថ្លែងអំណរគុណ យ៉ាង ខ្លាំង ចំពោះ សម្តេច តេជោ ហ៊ុន សែន និង ឯកឧត្តម ហ៊ុន ម៉ានី ក្នុង ការជួយ សកម្មភាព មនុស្សធម៌ នេះ ជូន ដល់ ប្រជាពលរដ្ឋ ជារៀងរហូតមក គឺ កើត ចេញ ពី ការឧបត្ថម្ភ គាំទ្រ និង ការចង្អុលបង្ហាញ ដោយ ផ្ទាល់ ពីសំណាក់ ឯកឧត្តម ហ៊ុន ម៉ានី ដែល លោក តែងតែ ខ្វល់ខ្វាយ គិតគូរ និង រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ដែល ជួប ការលំបាក ក្នុង គ្រប់ កាល ទេសៈ ។
ជា ចុងក្រោយ លោក លេង ផាលី ក៏ បាន ឡើង ផងដែរ ថា « យើង នាំគ្នា រួម សុខ រួម ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ដើម្បី រួបរួម គ្នា ធ្វើ អំពើ ល្អ ដើម្បី ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ក្នុង បុព្វហេតុ ជាតិ និង មាតុភូមិ របស់ យើង ជាពិសេស ការចូលរួម លើកកម្ពស់ សុខុមាលភាព ប្រជាជន គឺ នាំអោយ មាន កំណើន សេដ្ឋកិច្ច និង កាត កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ កម្ពុជា ស្រប ទៅតាម គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព របស់ រាជ រដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា »៕
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៨.៣៨៥ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៦.៤២២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ១.៩៦៣ គ្រឿង ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១០លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៣ នាក់ របួស ចំនួន ១៣នាក់ ( របួស ធ្ងន់ ចំនួន ១០នាក់ ) ។ រយៈពេល ២២ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ១៩១ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១០៦ នាក់ របួស ២៤២ នាក់ ( របួស ធ្ងន់ ១៥០ នាក់ )៕ រដ្ឋមន្ត្រី ក្រសួង សាធារណការ ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ ឯក អគ្គ រដ្ឋទូត ឥណ្ឌូនេស៊ី ប្រចាំ នៅ កម្ពុជា
ជំនួប នា រសៀល នេះ បាន ប្រព្រឹត្តទៅ ក្រោម បរិយាយ កាស រីករាយ ស្និទ្ធស្នាល ក្នុង គោលបំណង រឹតបន្តឹង កិច្ចសហប្រតិបត្តិការ ការទូត រវាង ប្រទេស ទាំង ពីរ កម្ពុជា - ឥណ្ឌូនេស៊ី ឱ្យ កាន់តែ មាន ភាពរឹងមាំ និង ស៊ីជម្រៅ ។
តាមរយៈ ជំនួប នេះ លោក រដ្ឋមន្ត្រី និង លោក ឯក អគ្គ រដ្ឋទូត បាន ពិភាក្សា លើ ការងារ មួយចំនួន ពាក់ព័ន្ធ នឹង ការតភ្ជាប់ និង ហេដ្ឋារចនាសម្ព័ន្ធ ដឹកជញ្ជូន ដែល រួម មាន ការធ្វើឱ្យ ប្រសើរឡើង ផ្លូវ ដែក ការអភិវឌ្ឍ លើ ផ្លូវ ល្បឿន លឿន ការដឹកជញ្ជូន តាម ផ្លូវ ទឹក និង ការបណ្តុះបណ្តាល មូលធន មនុស្ស ក្នុង វិស័យ សាធារណការ និង ដឹកជញ្ជូន ។
ជម្រាប ទៅកាន់ លោក ឯក អគ្គ រដ្ឋទូត និង សហការី អម ដំណើរ លោក រដ្ឋមន្ត្រី ក៏ បាន លើកឡើង អំពី ផែនការ មេគ្រប់ ជ្រុងជ្រោយ ស្ដីពី ប្រព័ន្ធ ដឹកជញ្ជូន អន្តរ មធ្យោបាយ និង ភស្តុភារកម្ម កម្ពុជា ២០២៣ - ២០៣៣ ដែល បើក ទូលាយ និង ស្វាគមន៍ រាល់ ការចូលរួម ពី គ្រប់ ភាគី ក្នុង ការវិនិយោគ ។
លោក ឯក អគ្គ រដ្ឋទូត ក៏ បាន បង្ហាញ នូវ ចំណាប់អារម្មណ៍ ដោយ រំពឹង ថា នឹង មាន ជំនួប នា ឱកាស ក្រោយ សារ ជាថ្មី ដោយ នាំ មក ជាមួយ នូវ បណ្តា វិនិយោគិន ពី ប្រទេស ឥណ្ឌូនេស៊ី ដែល មាន សក្តានុពល ដើម្បី មក ជជែក ពិភាក្សា ផ្លាស់ប្តូរ ទស្សនៈ សំដៅ ពិនិត្យ លទ្ធភាព ក្នុង ការបង្កើត កិច្ចសហការ ជាមួយគ្នា ៕ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ ប្រធាន រដ្ឋសភា ថៃ
មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល ស្នើ អាជ្ញាធរ មូលដ្ឋាន ជួយ ពិនិត្យ និង វាយតម្លៃ លទ្ធផល ការងារ របស់ មន្រ្តី សុខាភិបាល នៅ តាម មណ្ឌល សុខភាព ដើម្បី កែលម្អ នូវ ចំណុច ខ្វះខាត
ការស្នើ យ៉ាង ដូច្នេះ របស់ លោក ង៉ូវ កាង ក្នុង ពិធី បិទ សន្និបាត សុខាភិបាល នៃ រដ្ឋបាល ខេត្ត សៀមរាប នៅ ថ្ងៃទី ២២ ខែមីនា ឆ្នាំ ២០២៤ នេះ ដោយ មាន ការចូលរួម ពី លោក កុយ សង សមាជិក ក្រុមប្រឹក្សា ខេត្ត . លោក ពិន ប្រាកដ អភិបាល រង ខេត្ត និង លោក វេជ្ជបណ្ឌិត ក្រុស សារ៉ាត់ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត សៀមរាប ព្រមទាំង លោក លោកស្រី ជា ថ្នាក់ដឹកនាំ និង មន្ត្រី សុខាភិបាល មន្ទីរ អង្គភាព ពាក់ព័ន្ធ អភិបាល ក្រុង / ស្រុក មេឃុំ ក ចៅសង្កាត់ និង អង្គការ ដៃគូរ ពាក់ព័ន្ធ ជាច្រើន ចូលរួម ផងដែរ ។
លោក ង៉ូវ កាង បាន បន្ត ថា ខេត្ត សៀមរាប ជា ខេត្ត មួយ ដែល មាន សំណាង ជាង គេ ដោយ មាន ប្រាសាទ អង្គរវត្ត ដែល ជា គេ មរតក កេរ្តិ៍ឈ្មោះ របស់ កម្ពុជា ។ ងាក មក វិស័យ សុខាៈ បាល វិញ ខេត្ត សៀមរាប មាន មន្ទីរពេទ្យ កុមារ ( មន្ទីរពេទ្យ ជ័យ វរ្ម័ន ទី៧ ខេត្ត សៀមរាប ) ជា ខេត្ត មួយ ដែល ទទួលបាន សំណាង ឬ ក៏ ជា ឱកាស មួយ សម្រាប់ ទ្រទ្រង់ សុខភាព របស់ ប្រជាពលរដ្ឋ ផងដែរ ។
លោក ពិន ប្រាកដ បាន ធ្វើ ការវាយតំលៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ថ្នាក់ដឹកនាំ និង មន្រ្តី រាជការ ដែល ជា វេជ្ជបណ្ឌិត គ្រូពេទ្យ គិលានុបដ្ឋាក ‑យិការ ឆ្មប និង បុគ្គលិក កិច្ចសន្យា ទាំងអស់ នៃ វិស័យ សុខាភិបាល ដែល បាន ខិតខំ យកចិត្ដទុកដាក់ ខ្ពស់ ចំពោះ ការបំពេញ តួនាទី ភារកិច្ច ដោយ ការទទួលខុសត្រូវ ក្នុង ការពិនិត្យ ពិគ្រោះ ថែទាំ និង ព្យាបាល ជំងឺ ជូន បងប្អូន ប្រជាជន ក្នុង រយៈពេល ពេញ មួយ ឆ្នាំ ២០២៣ កន្លងមក នេះ ។
( ភ្នំពេញ ) ៖ ខណៈ ប្រទេស ខ្លះ មាន អាយុកាល រាប់ រយ ឆ្នាំ និង ខ្លះ ទៀត មាន ប្រវត្តិសាស្រ្ត ដល់ ទៅ រាប់ ពាន់ ឆ្នាំ ឯណោះ នោះ មាន ប្រទេស មួយចំនួន ដែល ទើបតែ បង្កើតឡើង ប៉ុណ្ណោះ ។
ខាងក្រោម នេះ គឺជា ប្រទេស ចំនួន ៥ ដែល មាន អាយុ ក្មេងខ្ចី ជាង គេ បំផុត នៅលើ ពិភពលោក៖
២ ថ្ងៃ បន្ទាប់ពី ការប្រកាស ឯករាជ្យ របស់ ប្រទេស ម៉ុង តេណេហ្គ្រោ ស៊ែប៊ី ក៏ បាន ប្រកាស ខ្លួន ឯង ជា រដ្ឋ អធិបតេយ្យ ដែល បន្ត មកពី រដ្ឋ សហភាព ស៊ែប៊ី និង ម៉ុង តេណេហ្រ្គោ ។
អង្គការ សហ ប្រជាជាតិ ដែល ជា អ្នកគ្រប់គ្រង ចាត់ចែង តំបន់ នេះ ចាប់តាំងពី ជម្លោះ កូសូវ៉ូ ត្រូវបាន បញ្ចប់ ទៅ នៅក្នុង ឆ្នាំ ១៩៩៩ បាន ចាប់ផ្ដើម ដំណើរការ មួយ នៅ ឆ្នាំ ២០០៥ ដើម្បី កំណត់ ឋានៈ របស់ កូសូវ៉ូ ។ នៅ ឆ្នាំ ២០០៨ កូសូវ៉ូ ក៏ បាន ប្រកាស ឯករាជ្យ ជា លក្ខណៈ ឯកតោ ភាគី ពី ស៊ែប៊ី ។ បើ ទោះបីជា ប្រទេស អឺរ៉ុប ភាគ អាគ្នេយ៍ មួយ នេះ ត្រូវបាន ទទួលស្គាល់ ដោយ សមាជិក ជាច្រើន របស់ អង្គ សហ ប្រជាជាតិ រួម មាន ទាំង សហរដ្ឋ អាមេរិក ក៏ ពិត មែន ប៉ុន្តែ ប្រទេស នេះ ពុំ ទាន់ ទទួល សមាជិកភាព ពី អង្គការ សហ ប្រជាជាតិ នៅឡើយ ទេ ។
នៅ ខែមករា ឆ្នាំ ២០១១ ការបោះឆ្នោត ប្រជាមតិ មួយ សម្រាប់ ប្រជាជន ដែល រស់ នៅ ភាគ ខាងត្បូង នៃ ប្រទេស ស៊ូ ដង់ ត្រូវបាន រៀបចំឡើង ។ ពេល នោះ ពួកគេ បាន គាំទ្រ ក្នុង សំឡេង យ៉ាង លើសលុប ឱ្យ បង្កើត ប្រទេស ដាច់ដោយឡែក មួយ ទៀត ពី ស៊ូ ដង់ ដោយ មាន ទីក្រុង ជូបា ធ្វើជា រដ្ឋធានី ។ ៥ ថ្ងៃ បន្ទាប់ពី នៃ ការប្រកាស ឯករាជ្យ អង្គការ សហ ប្រជាជាតិ ក៏ បាន ទទួលស្គាល់ ប្រទេស នេះ ជា សមាជិក ទី ១៩៣ ៕
( ភ្នំពេញ ) ៖ នៅ រយៈពេល ចុងក្រោយ នេះ យើង ឃើញ ថា មាន ការចាប់អារម្មណ៍ ខ្លាំង ទៅ លើ សកម្មភាព របស់ យុវជន ពាក់ព័ន្ធ នឹង ឥរិយាបថ ក៏ ដូចជា ការនិពន្ធ បទចម្រៀង មាន ន័យ អាសអាភាស និង ការនិយាយ ភាសា ខ្មែរ លាយឡំ និង ភាសា បរទេស ច្រើន ខ្លាំង ក្នុង វេទិការ សាធារណៈ ។ ឥរិយាបថ ទាំង នេះ ត្រូវបាន រង ការរិះគន់ ពីសំណាក់ ប្រជាពលរដ្ឋ ខ្មែរ ដែល មាន ទិន្នាការ អភិរក្ស និយម និង អ្នកជំនាញ សង្គម ទស្សនវិទ្យា ជាដើម ។
តើ ឥរិយាបថ មួយចំនួន របស់ យុវជន លើ បណ្ដាញ សង្គម ទាំង នេះ ពិតជា អាច ជះឥទ្ធិល ពល អវិជ្ជមាន ធ្ងន់ធ្ងរ លើ សង្គម ខ្មែរ ឬ យ៉ាងណា ?
