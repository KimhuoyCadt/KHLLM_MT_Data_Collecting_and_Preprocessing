( ភ្នំពេញ ) ៖ កម្មករ រោងចក្រ ស្បែកជើង អ. ជី ហ្វ៊ូត វែរ ទាំងអស់ នៅ ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២៤ នេះ បាន សម្តែង ភាពរីករាយ ជាខ្លាំង ដែល ទទួលបាន ប្រាក់ ឈ្នួល និង ប្រាក់ បំណាច់ ផ្សេង ៗ លឿន ជាង ការកំណត់ ក្រោម ការសម្របសម្រួល ពី រាជ រដ្ឋាភិបាល កម្ពុជា ។
ទន្ទឹមនឹង នេះ កម្មករ រោងចក្រ អ. ជី ហ្វ៊ូត វែរ ( ខេមបូឌា ) ទាំងអស់ បាន អរគុណ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ដែល តែងតែ ខិតខំ បំពេញ ការងារ និង គិតគូ ពី សុខ ទុក្ខ របស់ កម្មករ រហូតដល់ ដោះស្រាយ បញ្ហា ជូន កម្មករ ដោយ ជោគជ័យ នៅ ថ្ងៃ នេះ ៕
អង្គការ ឃ្លាំមើល សិទ្ធិ មនុស្ស ស៊ីរី មាន មូលដ្ឋាន ក្នុង ទីក្រុង ឡុងដ៍ បាន ឱ្យដឹង ទៀត ថា ការវាយប្រហារ តាម ផ្លូវ អាកាស របស់ អ៉ី ស្រាអែល គឺ មាន គោលដៅ លើ តំបន់ មួយ ស្ថិត នៅក្បែរ ឃ្លាំង ស្ដុក គ្រាប់ រ៉ុក្កែត មួយ កន្លែង ជា កម្មសិទ្ធិ របស់ ក្រុម Hezbollah លី បង់ ។ តាម អង្គការ នេះ ដដែល មនុស្ស ជាច្រើន នាក់ ផ្សេង ទៀត ក៏ បាន រងរបួស ផងដែរ ។
ដោយឡែក បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ រដ្ឋ ស៊ីរី SANA វិញ ការវាយប្រហារ តាម ផ្លូវ អាកាស បាន កើតឡើង នៅ ប្រហែលជា ម៉ោង ១៖៤៥ នាទី រំលង អធ្រាត្រ ថ្ងៃសុក្រ ទី ២៩ ខែមីនា នេះ ដោយ បាន សម្លាប់ និង ធ្វើឱ្យ មនុស្ស ជាច្រើន នាក់ រងរបួស ទាំង ជន ស៊ីវិល និង យោធា ។ ប៉ុន្តែ ខាង យោធា អ៉ី ស្រាអែល មិន បាន ធ្វើ អត្ថាធិប្បាយ អ្វី ទេ ។
គួរ បញ្ជាក់ ថា អ៉ី ស្រាអែល ត្រូវបាន គេ រាយការណ៍ ថា បាន បើក ការវាយប្រហារ តាម ផ្លូវ អាកាស រាប់ រយ លើក ប្រឆាំង នឹង គោលដៅ ក្នុង ប្រទេស ស៊ីរី ចាប់តាំងពី សង្រ្គាម ស៊ីវិល ក្នុង ប្រទេស នេះ ផ្ទុះឡើង កាលពី ឆ្នាំ ២០១១មក ហើយ ការវាយប្រហារ នេះ គឺ មាន គោលដៅ លើ កងកម្លាំង គាំទ្រ ដោយ អ៉ីរ៉ង់ ក្នុង នោះ រួម មាន ទាំង ក្រុម Hezbollah និង ទីតាំង របស់ កងទ័ព ស៊ីរី ៕
គួរ បញ្ជាក់ ថា ក្នុង ពេល បច្ចុប្បន្ន អ៊ុយក្រែន សង្ឃឹម ថា អាចនឹង រៀបចំ កិច្ចប្រជុំ កំពូល មួយ ជាមួយ មេដឹកនាំ ពិភពលោក ដោយ មិន មាន វត្តមាន រុស្ស៉ី នៅ ប៉ុន្មាន ខែ ខាងមុខ ទៀត នេះ ដើម្បី ជំរុញ ការស្វែងរក សន្តិភាព បញ្ចប់ សង្រ្គាម ។ ផែនការ សន្តិភាព របស់ អ៊ុយក្រែន ក្នុង នោះ រួម មាន ការតម្រូវ ឱ្យ កងទ័ព រុស្ស៉ី ទាំងអស់ ដក ចេញ ពី ទឹកដី អ៊ុយក្រែន ប៉ុន្តែ ទីក្រុង មូស្គូ បាន ច្រានចោល ផែនការ សន្តិភាព នេះ ហើយ ថា កិច្ចប្រជុំ កំពូល ណាមួយ ស្ដីពី សន្តិភាព នៅ អ៊ុយក្រែន ដែល គ្មាន វត្តមាន រុស្ស៉ី នឹង ទទួលបរាជ័យ ៕
រុស្ស៉ី បោះឆ្នោត វេតូ ដើម្បី បិទ បញ្ចប់ ការតាមដាន ទណ្ឌកម្ម UN ប្រឆាំង នឹង កូរ៉េ ខាងជើង (Video inside) ( យូ អិន ) ៖ រុស្ស៉ី កាលពី ថ្ងៃព្រហស្បតិ៍ ទី២៨ ខែមីនា បាន បោះឆ្នោត វេតូរាំង ខ្ទប់ ការផ្ដល់ អាណត្តិ ថ្មី ដល់ គណៈកម្មាធិការ នៃ ក្រុម អ្នកជំនាញ UN ដែល តាមដាន លើ ការអនុវត្ត ការដាក់ទណ្ឌកម្ម របស់ អង្គការ សហ ប្រជាជាតិ ប្រឆាំង នឹង កូរ៉េ ខាងជើង ពាក់ព័ន្ធ នឹង ការអភិវឌ្ឍ កម្មវិធី អាវុធ នុយក្លេអ៊ែរ និង មីស៊ីល បាលិស្ទីគ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន AFP ។
សម្តេច តេជោ ហ៊ុន សែន និង អនុប្រធាន គណៈកម្មការ យោធា មជ្ឈឹម ចិន ជួប ពិភាក្សា ការងារ
( ចិន . ហៃ ណាន) ៖ នៅ ព្រឹក ថ្ងៃសុក្រ ទី ២៩ ខែមីនា ឆ្នាំ ២០២៤ នេះ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ក្រុម ឧត្តមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ បាន ជួប ពិភាក្សា ការងារ ទ្វេ ភាគី ជាមួយ នាយ ឧត្តមសេនីយ៍ ហឺ វ័យ ទុង សមាជិក ការិយាល័យ នយោបាយ មជ្ឈឹម បក្ស និង ជា អនុប្រធាន ទី២ នៃ គណៈកម្មការ យោធា មជ្ឈឹម បក្ស នៅ ក្រុង បូអាវ ខេត្ត ហៃ ណាន ប្រទេស ចិន ។
ក្នុង ជំនួប នេះ សម្តេច តេជោ ហ៊ុន សែន និង នាយ ឧត្តមសេនីយ៍ ហឺ វ័យ ទុង បាន ជជែក ពិភាក្សា ទៅ លើ ការពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ ការបណ្តុះបណ្តាល ការផ្លាស់ប្តូរ ព័ត៌មាន ការចែករំលែក បទពិសោធន៍ និង ការដោះ មីន ។
សម្តេច តេជោ ហ៊ុន សែន និង នាយ ឧត្តមសេនីយ៍ អនុប្រធាន គណៈកម្មការ យោធា មជ្ឈឹម ចិន បាន បង្ហាញ ការពេញចិត្ត ចំពោះ ការរីកចំរើន ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការណ៍ លើ គ្រប់ វិស័យ រវាង កម្ពុជា និង ចិន ៕ លោក ប៉េង ពោធិ៍នា ដឹកនាំ កិច្ចប្រជុំ ប្រចាំ ខែ របស់ ថ្នាក់ដឹកនាំ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន
( កំពង់ឆ្នាំង ) ៖ ទីតាំង ដាក់ ម៉ាស៊ីន កិន កម្ទេច ឈើ ខ្នាត ធំ ខុស ច្បាប់ ១កន្លែង ដែល មាន លាក់ ទុក កូន ឈើ រាប់ រយ ម៉ែត្រ គូប និង កម្ទេច ឈើ កិន រួចរាប់ រយ តោន នៅក្នុង ភូមិ ក្រាំង ស្គារ ត្បូង ឃុំ ក្រាំង ស្គារ ស្រុក ទឹក ផុស ខេត្ត កំពង់ឆ្នាំង ត្រូវបាន នគរបាល ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ឆ្នាំង ស្រាវជ្រាវ រកឃើញ នៅ វេលា ម៉ោ១៣៖ ០០នាទី រសៀល ថ្ងៃទី ២៨ ខែមីនា ឆ្នាំ ២០២៤ និង កំពុង អនុវត្ត នីតិវិធី ដើម្បី បញ្ជូន ទៅ តុលាការ ។
លោក ឧត្តមសេនីយ៍ ត្រី ចាប ចន្ថា បាន បន្ត ថា នៅក្នុង ទីតាំង ខាងលើ នេះ សមត្ថកិច្ច បាន រកឃើញ ម៉ាស៊ីន កិន ដើមឈើ ឱ្យ ទៅជា កម្ទេច ឈើ ដ៏ ទំនើប ខ្នាត ធំ២គ្រឿង និង គំនរ កម្ទេច ឈើ កិន រួចរាប់ រយ តោន ចំនួន ៣កន្លែង និង គ្រឿងចក្រ សម្រាប់ ចាប់ លើក ដើមឈើ ចូល ម៉ាស៊ីន កិន ចំនួន ២គ្រឿង រថយន្ត ធុន ធំ សម្រាប់ ដឹក កម្ទេច ឈើ លាក់ ទុក ក្នុង ព្រៃ ១គ្រឿង និង គ្រឿង បន្លាស់ គ្រឿងចក្រ កិនក កម្ទេច ឈើ មួយចំនួន ទៀត ។
លោក បាន បញ្ជាក់ ថា នៅក្នុង ពេល ប្រតិបត្តិការ នៅលើ ទីតាំង ខាងលើ នេះ កម្មករ និង ម្ចាស់ ក្រុមហ៊ុន បាន ចាក់សោ ទ្វារ ចេញ ចូលក្នុង ទីតាំង ក្រុមហ៊ុន រួច បាន នាំគ្នា រត់គេចខ្លួន អស់ ។
បន្ទាប់មក នៅ ថ្ងៃទី ២៨ ទើប សមត្ថកិច្ច បើក ប្រតិបត្តិការ រុករក ស្រាវជ្រាវ រហូត ឈាន មក រកឃើញ ទីតាំង លាក់ ទុក ម៉ាស៊ីន ទំនើប កិន កម្ទេច ឈើ នៅក្នុង ទីតាំង ខាងលើ នេះ ។
លោក មេភូមិ ក្រាំង ស្គារ ត្បូង ដែល បាន សហការ ជាមួយ សមត្ថកិច្ច ក្នុង ពេល គ្រប់គ្រង ទីតាំង ខុស ច្បាប់ ខាងលើ នេះ បាន ឱ្យដឹង ថា ដី ក្រុមហ៊ុន ហ្គី្រន រីសត នេះ មាន ទំហំ ជាង ៨០០ ហិកតា ក្នុង ពេល មាន សកម្មភាព ខុស ច្បាប់ មួយ រយៈ ចុងក្រោយ នេះ គឺ ម្ចាស់ ក្រុមហ៊ុន បាន បិទ ទ្វារ ច្រក ចេញ ចូលក្នុង ទីតាំង ក្រុមហ៊ុន រហូតមក មិន ឱ្យ ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ចេញ ចូល លេង កម្សាន្ត និង សម្រាក លំហែ កាយ ដូច ឆ្នាំ មុន ៗ ឡើយ ។
ប្រកាស សមាសភាព ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ឃុំ ទាំង៨ នៃ ស្រុក តាំង គោក . តំណាង រាជ រដ្ឋាភិបាល ណែនាំ ទិសដៅ ការងារ ចម្បង ៦ ចំណុច ដើម្បី បម្រើ ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ
( កំពង់ធំ )៖ ក្នុង ពិធី ប្រកាស សមាសភាព ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ឃុំ ទាំង៨ នៃ ស្រុក តាំង គោក និង លេខាធិការដ្ឋាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក តាំង គោក តំណាង រាជ រដ្ឋាភិបាល បាន ណែនាំ ទិសដៅ ការងារ ចម្បង ៗ ៦ ចំណុច ដើម្បី ក្លាយជា សេនាធិការ របស់ រដ្ឋាភិបាល ក្នុង ការបម្រើ ប្រជាពលរដ្ឋ ឱ្យ បាន ល្អ ។
ពិធី នេះ ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២៩ ខែមីនា ឆ្នាំ ២០២៤ នៅ សាលា ស្រុក តាំង គោក ខេត្ដ កំពង់ធំ ក្រោម អធិបតីភាព លោក ឈាង វណ្ណា រិទ្ធ រដ្ឋលេខាធិការ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី និង ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក តាំង គោក ដោយ មាន ការចូលរួម ពី ប្រធាន អនុប្រធាន សមាជិក សមាជិកា ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន នៃ ឃុំ ទាំង៨ នៃ ស្រុក តាំង គោក មន្រ្ដី រាជការ និង កងកម្លាំងប្រដាប់អាវុធ ប្រមាណ ៣៦៥ នាក់ ។
លោក ឈាង វណ្ណា រិទ្ធ បាន លើកឡើង ថា ដោយ មាន ការយកចិត្តទុកដាក់ ពី ប្រមុខ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដោយ សម្ដេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ការផ្ដល់ ទំនុកចិត្ដ ខ្ពស់ ពីសំណាក់ លោក វង្សី វិស្សុត ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ខេត្ដ កំពង់ធំ បាន ចាត់តាំង ឱ្យ មាន រៀបចំ ក្រុមការងារ ចុះ មូលដ្ឋាន របស់ រាជ រដ្ឋាភិបាល ស្រុក តាំង គោក និង ឃុំ ទាំង៨ នៃ ស្រុក តាំង គោក ដើម្បី ជួយ ដោះស្រាយ បញ្ហា ប្រឈម និង ទុក្ខ កង្វល់ របស់ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ។
លោក ឈាង វណ្ណា រិទ្ធ បាន លើក ទិសដៅ ការងារ ចម្បង ៗ ជា អាទិ៍៖
១៖ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ភូមិ ឃុំ ទាំងអស់ នៃ ស្រុក តាំង គោក ត្រូវ សហការ គ្នា និង ធ្វើការ ជាមួយគ្នា ប្រកបដោយ ឆន្ទៈ ខ្ពស់ . ការទទួលខុសត្រូវ និង មាន ភាពម្ចាស់ ការ
២៖ ជំរុញ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ត្រូវ ចូលរួម ដោះស្រាយ បញ្ហា ប្រឈម ជាពិសេស បញ្ហា ដីធ្លី ប្រកបដោយ តម្លាភាព គណនេយ្យភាព និង ភាព ជា ម្ចាស់
៣៖ ជំរុញ ឱ្យ រដ្ឋបាល ស្រុក ឃុំ និង កងកម្លាំង មាន សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ ត្រូវ ផ្ដល់ សេវា សាធារណៈ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព . គុណភាព និង ប្រកបដោយ បរិយា បន្ន
៤៖ ជំរុញ ឱ្យ រដ្ឋបាល ស្រុក ឃុំ និង កងកម្លាំង មាន សមត្ថកិច្ច ត្រូវ បន្ត ជំរុញ ការអនុវត្ត គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ដើម្បី បន្ដ ដោះស្រាយ ភាពអសកម្ម ដូចជា ចោរកម្ម ល្បែងស៊ីសង គ្រឿងញៀន ក្មេង ទំនើង ទំនាស់ ដីធ្លី បទល្មើស ឆបោក តាម ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន
៥៖ ជំរុញ ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ រូប វន្ត ចាំបាច់ នានា សម្រាប់ បម្រើ ដល់ សកម្មភាព សេដ្ឋកិច្ច និង ជីវភាព ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន
៦៖ ជំរុញ ការកៀរ គរ ថវិកា និង ជំនួយ បច្ចេកទេស ពី ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដៃគូ អភិវឌ្ឍន៍ អង្គការ ក្រៅ រដ្ឋាភិបាល សង្គម ស៊ីវិល និង សប្បុរសជន នានា ។
ជាមួយគ្នា នេះ លោក រដ្ឋលេខាធិការ ក៏ បាន ណែនាំ អំពី យន្ដ ការងារ របស់ ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក និង ឃុំ ទាំង៨ នៃ ស្រុក តាំង គោក ត្រូវ អនុលោម តាម សេចក្ដីណែនាំ លេខ ០៤ សណន ចុះ ថ្ងៃទី ៣០ ខែវិច្ឆិកា ឆ្នាំ ២០២៣ របស់ រាជ រដ្ឋាភិបាល ។
លោក ក៏ បាន ផ្ដាំផ្ញើ ដល់ អ្នកចូលរួម ទាំងអស់ ត្រូវតែ សហការ គ្នា ជា កម្លាំង មួយ ក្នុង ការកសាង អភិវឌ្ឍ ស្រុក តាំង គោក នេះ ឱ្យ មាន ការរីកចម្រើន ចាប់ពី ពេល ប្រកាស សមាសភាព នេះ ឱ្យ មាន ភាពត្រឹមត្រូវ និង យុត្តិធម៌ ជូន បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ សង្កាត់ ។
គួរ បញ្ជាក់ ថា សមាសភាព ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ឃុំ ទាំង៨ នៃ ស្រុក តាំង គោក និង លេខាធិការដ្ឋាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ស្រុក តាំង គោក សរុប ៣៥០ នាក់ ៕
ក្រសួង អភិវឌ្ឍន៍ ជនបទ និង រដ្ឋបាល ខេត្ត ព្រះវិហារ ផ្សព្វផ្សាយ ខ្លឹមសារ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ
( ព្រះវិហារ ) ៖ លោក បណ្ឌិត ចាន់ ដារ៉ុង រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍ ជនបទ និង លោក អ៊ុក គឹម សាន អភិបាល រង ខេត្ត ព្រះវិហារ បាន ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ខ្លឹមសារ សន្និបាត បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០២៣ និង លើក ទិសដៅ ការងារ ឆ្នាំ ២០២៤ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ។
