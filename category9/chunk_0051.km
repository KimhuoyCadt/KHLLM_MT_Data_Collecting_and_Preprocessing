15 គេបង្ហាញថាក្រឹត្យ ‌ វិន័យត្រូវបាន កត់ទុកក្នុង ចិត្តគេ ។
៩ មានការច លាចលយ៉ាងខ្លាំង ហើយគ្រូច្បាប់ខ្លះដែលជាផារិស៊ីបានក្រោកឈរ ហើយប្រកែកយ៉ាងខ្លាំង ។
ស្អែកវាជាថ្ងៃរបស់គេ » ។
ឥឡូវនេះ នេះ គឺជា រូបថត អាពាហ៍ពិពាហ៍ ហួស កំណត់ ។
ដូច្នេះ អ្វី ដែល មើលឃើញ ដោយ ភ្នែក ត្រូវបាន គេ ជឿ ។
យ៉ាង ហោចណាស់ពួកគេបានរស់នៅ ទីនោះកន្លះឆ្នាំហើយ ។
គោលបំណង គឺ ដើម្បី បង្កើត វត្ថុ នៃ ថ្នាក់ ។
លោក ហ៊ុន សែន ថ្លែង ជា សាធារណៈច្រើនដងថា មិនគួរមានការ កាត់ទោសទៀតទេ ។
សូម ឱ្យ វា ក្លាយជា អនុញ្ញាតឱ្យ វា ឃ្មុំ
មានអំណាចទាំងអស់ ប៉ុន្តែបាននាំគាត់ទៅលុតជង្គង់ ។
ដូច្នេះ អ្នកត្រូវទទួលបានរូបភាពដែលយើងមិនជឿថាគាត់នៅមានជីវិត ។
ការលើកលែង ចំពោះ ច្បាប់ អាច ត្រូវបាន ផ្តល់ " ក្នុង កាលៈទេសៈ ជាក់លាក់ " ដោយ ប្រធាន ទីភ្នាក់ងារ រហូតដល់ 2 ឆ្នាំ ឬ ដោយ នាយក ស៊ើបការណ៍ ជាតិ នៅក្នុង ករណី ផ្សេង ទៀត ដែល មិន ត្រូវបាន បញ្ជាក់ ។
មិនមានទៅមួយនៅគ្រប់សាលាទេ ។
ប៉ុន្តែប៉ុន្មានឆ្នាំទៀត ខ្ញុំមិនដឹងថាខ្ញុំនឹងគិតយ៉ាងម៉េចទេ ។
យើងត្រូវបានគេបង្កើតឡើងសម្រាប់ការ ថ្វាយបង្គំ ហើយយើងនឹងថ្វាយបង្គំអ្វីមួយ ។
សូមស្វាគមន៍ មកកាន់ ព្រះរាជាណាចក្រ បារ៉ែ ន
សង្ឃឹមថាយើងមិនចាប់ផ្ដើមសម្លាប់ខ្លួនមុនថ្ងៃចុងក្រោយ ។
ភីលីព 1:5 ... ដោយ សារ ភាព ជាដៃ គូរបស់អ្នកក្នុងដំណឹងល្អ តាំងពីថ្ងៃដំបូងរហូតដល់ឥឡូវនេះ ។
ម៉ាស៊ីន ទាំងមូល ត្រូវបាន ដាក់បញ្ចូល គ្នា ។
ប៉ុន្តែ កិច្ចបម្រើដែលព្រះ យេស៊ូវបានទទួលគឺប្រសើរជាងពួកគេ ដូចជា កិច្ច សន្យាដែលទ្រង់ ជាអ្នកសម្រុះសម្រួល គឺប្រសើរជាង កិច្ច សន្យាចាស់ ហើយវាត្រូវបានបង្កើតឡើងដោយការសន្យាដែលល្អជាង ។
ចំណាំ៖ យើង សូម ណែនាំ ឱ្យ ប្រើ កំណែ ចុងក្រោយ បំផុត នៃ រូបរាង ។
អ្នកប្រាជ្ញចាស់ពោលថា៖ « កុំជឿអ្វីដែលអ្នកបានឮ ហើយគ្រាន់តែពាក់កណ្តាលនៃអ្វីដែលអ្នក ឃើញប៉ុណ្ណោះ » ។
ខ្ញុំ បាន ប្រាប់ អ្នក ថា នេះ គឺជា ថ្ងៃ ណាមួយ ។
« ឯងស្មាន ថាខ្ញុំចង់ពេញចិត្តគាត់?
ប្រាកដមែន ខ្ញុំប្រាប់អ្នក រាល់គ្នាជាប្រាកដថា ប្រសិនបើអ្នក ណា កាន់តាមពាក្យខ្ញុំ អ្នក នោះនឹងមិនឃើញសេចក្ដី ស្លាប់ឡើយ ។
នៅ ពេល ដែល នរណា ម្នាក់ ធ្វើឱ្យ ខ្ញុំ ឈឺចាប់ ខ្ញុំ កាន់ វា
ខ្ញុំបានប្រាប់ពួកគេថា “ ឥឡូវនេះហើយ ។
អរុណ សួស្តី សុខសប្បាយ ទេ ?
នៅថ្ងៃនេះ អ្នក ស្មោះត្រង់ត្រូវបានលើកទឹក ចិត្តឲ្យដាក់ព្រះវិញ្ញាណនៃព្រះ មុននឹងតម្រូវការ របស់ពួកគេ ។
តើក្រសួងសុខាភិបាល និងសេវាមនុស្សធ្វើអ្វីក្នុងឆ្នាំ ២០២០
ដូច្នេះខ្ញុំមានស្ថានីយថ្មី។
ខ្ញុំនឹងធ្វើជាប្រធាន » ។
នាងបាននិយាយថា៖ « តើមនុស្សទាំងនេះមានរឿងអ្វីដែលព្យាយាម វិនិច្ឆ័យនិងចាត់ថ្នាក់មនុស្ស?
យើងនឹងធ្វើបានល្អណាស់ » ។
ប៉ុន្តែ ព្រះអម្ចាស់មានព្រះហឫទ័យស្មោះត្រង់ ហើយព្រះអង្គនឹងពង្រឹង និងការពារអ្នកពីមារកំណាច ។
ខ្ញុំ មាន ក្តីសង្ឃឹម សម្រាប់ នាង ។
២៣ « អ្នក ណាដែលស្អប់ខ្ញុំក៏ស្អប់បិតាខ្ញុំដែរ ។
ក្នុង ករណី ចុងក្រោយ នេះ មិន អី ទេ ។
យានជំនិះ ដើម្បី គាំទ្រ ការបណ្តាក់ទុន ថ្មី នេះ ។
18 ដ្បិតលោក យ៉ូហានមិនបានមកបរិភោគឬផឹកទេ ហើយគេថាគាត់មានវិញ្ញាណកំណាច !
២០ ហេតុដូច្នេះហើយ ដោយការ ប្រព្រឹត្តនៃក្រិត្យវិន័យ គ្មានអ្នក ណានឹងបានរាប់ជាសុចរិតនៅចំពោះព្រះនេត្ររបស់ទ្រង់ឡើយ ត្បិតដោយក្រឹត្យ វិន័យហើយ ជាចំណេះអំពីអំពើ បាប ។
នេះ មិន មែន និយាយ អំពី រឿង អាសអាភាស របស់ កុមារ ឬ រឿង អាសអាភាស ជាទូទៅ នោះ ទេ ។
នៃ ព្រះដែល បាន បង្ហាញ ដល់ យើង វា ត្រូវតែ នៅលើ ដី នេះ ជាពិសេស ។
អ្នក គ្រាន់តែ ផ្លាស់ប្តូរ ការយល់ដឹង របស់ អ្នក ទៅ ផ្នែក ខ្លះ នៃ រាងកាយ របស់ អ្នក អាស្រ័យ លើ ថា តើ អ្នក កំពុង ស្រូប ចូល ឬ ដកដង្ហើម ចេញ ។
« កុំនៅជាប់នឹងខ្ញុំឡើយ ព្រោះខ្ញុំមិនទាន់បានឡើងទៅ ឯព្រះវរ បិតាខ្ញុំទេ » ។
ម្យ៉ាង វិញ ទៀត ខ្ញុំ នឹង ប្រឹងប្រែង ឱ្យ អស់ ពី សមត្ថភាព ដើម្បី ធ្វើ ត្រូវ ហើយ មិន អើពើ ចំពោះ អ្នក ដែល សម នឹង ទទួលបាន ។
គាត់ មាន ការឃោសនា បំផ្លើស ជាច្រើន ពីក្រោយ គាត់ នៅ ថ្ងៃ មុននឹង ទទួលរង ការបាត់បង់ ដំបូង របស់ គាត់ ។
ប្រហែលជា ឈ្មោះ នៃ ប្រទេស នេះ គួរតែ ត្រូវបាន ផ្លាស់ប្តូរ ។
បំពង់ ក ស្ថិត នៅក្នុង ជួរ នោះ ។
បង្ហាញ ពី ក្តី ស្រលាញ់ របស់ អ្នក ផងដែរ ។
ស្វែងយល់ ពី អ្វី ដែល គួរតែ មាន ភាពខុសគ្នា ។
ហេតុអ្វីបានជាព្រះ យេហូវ៉ា អនុញ្ញាតឲ្យយើងចាញ់ដោយពួកភីលី ស្ទីន ? » ។
ដំបូន្មាន និង ការធានារ៉ាប់រង សម្រាប់ អ្នក ។
ប៉ុន្តែ អ្នក មិន មែន ជា អ្វី ដែល អ្នក គួរ ក្លាយជា បន្ទាប់ពី ប្រភេទ របស់ អ្នក ; ដែលជាបុរសល្អ ឬស្ត្រីល្អ ឬជាកូនល្អ ។
បែហោង ធ្មែញ មាត់ និង ផ្នែក ម្ខាង នៃ អណ្តាត ។
ទ្រព្យសម្បត្តិ និង មរតក របស់ ស្ត្រី នៅតែ ស្ថិត ក្នុង ដៃ របស់ ពួកគេ សូម្បីតែ ក្នុង អាពាហ៍ពិពាហ៍ ក៏ដោយ ។
ភ្ជាប់ គាត់ ទៅ កន្លែង ចុងក្រោយ ។
កុំហ៊ានធ្វើជាមនុស្សចម្លែក ពេលអ្នក រើខ្លួនមានរបស់ខ្ញុំ
ស្មុគស្មាញ ថាមពល ទាំងមូល បាន ធ្លាក់ចុះ ។
26 រួចគាត់ក៏ចាត់គាត់ទៅផ្ទះគាត់ ដោយមាន ប្រសាសន៍ថា ៖ « កុំចូលទៅក្នុងភូមិ ឬប្រាប់អ្នក ណានៅក្នុងភូមិឡើយ » ។
14 ប៉ុន្តែដោយ សារការ ធ្វើការ នេះ អ្នក បានទទួលការ មើលងាយដល់ព្រះ‌ អម្ចាស់យ៉ាងខ្លាំង នោះកូនប្រុសដែលកើតមកនឹងត្រូវស្លាប់ » ។
