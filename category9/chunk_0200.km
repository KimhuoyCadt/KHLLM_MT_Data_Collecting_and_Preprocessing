ពលរដ្ឋ នៅ បឹងកក់ ចោទ អាជ្ញាធរ និង ក្រុមហ៊ុន ថា រារាំង មិន ឱ្យ ជួសជុល ផ្ទះ
និង លោកគ្រូ ផងដែរ ។
ពលរដ្ឋ បារម្ភ !
កសិករ ប្រមូល ផល ពោត នៅ ខេត្ត បាត់ដំបង កាលពី ថ្ងៃទី ១កក្កដា ឆ្នាំ ២០១២ ។
ជំរាប សួរ ទន្សាយ តូច
យ៉ាងណាមិញ អ្នកជំនាញ សុខាភិបាល លើកឡើង ពី មន្ទិល សង្ស័យ ទាក់ទិន ប្រសិទ្ធភាព នៃ អនុវត្ត បែប នេះ ។
នៅ ខាងឆ្វេង ដៃ អ្នកស្រី ឃាង អាន គឺ ស្ត្រី អ្នកលក់ ទឹក ត្នោត ម្នាក់ ទៀត ។
អនុ រដ្ឋមន្ត្រី ការបរទេស អង់គ្លេស ការបោះឆ្នោត ដោយ …
ការវិលត្រឡប់ ទៅ ចំណុច ដើម
អដ្ឋក ថា ព្រះសុត្តន្តបិដក ភាគ ៥២៧
សមុទ្រ ប្រមាណ ជា ៦០ ភាគរយ ត្រូវបាន កែប្រែ យ៉ាង ខ្លាំង ដោយសារ សកម្មភាព មនុស្ស ។
ការចុះឈ្មោះ បោះឆ្នោត នៅអាទិត្យ ដំបូង មាន ការយឺត យាវ ដោយ បច្ចេកទេស ទំព័រ ពិសេស ៖
ជួនកាល ពេល យើង គិត អំពី ការប្រុងប្រៀប ខ្លួន សម្រាប់ ការយាង មក របស់ ព្រះយេស៊ូវ យើង ក៏ បាន គិត ផងដែរ អំពី ការអ្វី ខ្លះ ដែល យើង មិន ត្រូវ ធ្វើ ។
កុំ ចង់ សក់ តឹង ពេក និង ប្រើ ខ្យល់ ត្រជាក់ នៅពេល ផ្លុំ សក់ ។
ទាំងនោះ មក ផ្គុំ ចូល គ្នា ធ្វើជា វីដេអូ មួយ ។
ពី ដំបូង លោក បាន បដិសេធ ហើយ មេធាវី របស់ លោក នឹង ការពារ ក្តី របស់ លោក នៅពេល មាន សវនការ ។
ចំនួន ឡាន ទុកចោល យ៉ាង ច្រើន បាន ក្លាយជា រឿង ឈឺ ក្បាល សម្រាប់ មន្ត្រី នៅក្នុង តំបន់ ព្រោះ មិន ដឹង ត្រូវ ធ្វើ យ៉ាងណា ចំពោះ រថយន្ត ទាំងនោះ ។
ប្រមុខ រាជ រដ្ឋាភិបាល បើ គណបក្ស ប្រជាជន មិន យកចិត្តទុកដាក់ តើ វិស័យ សាសនា អាច រីកចំរើន ដូច សព្វ ថ្ងៃ បាន ទេ ?
អត្ថបទ បន្ទាប់ នរណា ខ្ទាត ចេញពី ការប្រកួត បន្ត ទៀត ?
ជាប់ គ្នា ,ភ្ជាប់គ្នា កិ.
ខាំ បំផ្លាញ លិង្គ ប្រុស ស្នេហ៍ ព្រោះ មាន គំនិត បិសាច ចង់ តែ បំផ្លាញ លិង្គ មនុស្ស ប្រុស
វាយតម្លៃ ផ្អែក ទៅ លើ អារម្មណ៍ ផ្អែក ទៅ លើ ការយល់ឃើញ ជា អត្តនោម័តិ ។
មាន ដូចជា ផ្សារ ណាត់ ផ្សារ ធំ ផ្សារ លើ ផ្សារ អប្សរា ផ្សារ ថ្មី ផ្សារ ១៣
បច្ចេកវិទ្យា អ៊ីនធឺណិត ក៏ មាន ចំនួន ច្រើន ជាង បុរស ដែរ ។
នៅ ភ្នំពេញ មាន បាញ់ កាំជ្រួច អត់ យប់ ឆ្លង ឆ្នាំ ថ្មី សប្បាយ ?
ខ្ញុំ គាំទ្រ ឱ្យ មាន ច្បាប់ អំពី ហាម តាតា ចាស់ ៗ
ក្រុមហ៊ុន អេច ស៊ីស៊ី គ្រុប ត្រូវការ ជ្រើសរើស បុគ្គលិក ដូច ខាងក្រោម ៖
ចំរៀង នេះ គ្មាន លក្ខណៈ អប់រំ អ្វី ទាំងអស់ ក្រៅតែ អំពី ការអួត ស្រី ញី ផឹក ស៊ី ។
ពួកគេ និយាយ ថា ប្រការ ល្អ បំផុត ក្នុង ការព្យាបាល រោគ ក្តៅ ខ្លួន របស់ កុមារ គឺ ការការមើល ថែ ពួកគេ ឱ្យ ល្អ ក្នុង ពេល ដែល រកមើល សញ្ញា នៃ ជំងឺ ធ្ងន់ធ្ងរ ជាជាង ការយកចិត្តទុកដាក់ លើ ការបន្ថយ កម្តៅ ពួកគេ ឱ្យ ស្ថិត ក្នុង កម្រិត ធម្មតា ។
អាច ទៅ កេហដ្ឋាន របស់ អេឃន នៅ ទីនេះ ដើម្បី ស្វែងរក ពតរ មាន បន្ថែម ។
នេះ ថា ជា ការដើរ ឃ្លាត ពី គន្លង លទ្ធិ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ។
១០. សូកូឡា ខ្មៅ
ក្នុង ឱកាស អញ្ជើញ បើក ការដ្ឋាន សាងសង់ មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - ចិន ត្បូងឃ្មុំ
លទ្ធផល ប្រឡង ឡើងវិញ និស្សិត ជំនាន់ ៧ឆ្នាំ ទី៤
ការទិញ កើនឡើង ៤៥ ភាគរយ នៅពេល ការចុះឈ្មោះ ដោយ បង្ខំ ត្រូវបាន យក ចេញ ពី ទំព័រ ពិនិត្យ ចេញ
ដោយឡែក លើក នេះ ផល សោភ័ណ្ឌ ត្រូវ ជួប ឡៅ ចិត្ត្រា វិញ ម្តង ។
នៅ កម្ពុជា មាន តែ មន្ត្រីរាជការ តូចតាច ប៉ុណ្ណោះ ដែល និយាយ អំពី ប្រាក់ខែ ។
ផលិតផល ក្នុង ស្រុក របស់ កម្ពុជា រំពឹង ថា នឹង មាន កំណើន
រថយន្ត បុក រថយន្ត រួច បន្ត ទៅ បុក ម៉ូតូ របួស ធ្ងន់ ស្រាល ៥នាក់
ម៉ូតូ ជនរងគ្រោះ ត្រូវបាន សមត្ថកិច្ច យក ទៅ រក្សាទុក នៅ ខណ្ឌ ដូនពេញ ៕
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ក្មួយ ៗ
ជម្រាប សួរ អ្នក មីង សង្វា វ៉ាន
ទោះជា យ៉ាង នេះ ក៏ដោយ ច្បាប់
លោក បន្ត ថា នៅ តាម បណ្តា ខេត្ត មាន ស្នង កុារ រង មួយ រូប ជា អ្នក ទទួលបន្ទុក លើ ជន អន្តោប្រវេសន៍ ។
ករណី ស្នើសុំ ឱ្យ អង្គភាព ប្រឆាំង អំពើពុករលួយ ជួយ អន្តរាគមន៍ កុំ ឱ្យ មាន ការបង្រួម ផ្លូវ លេខ ២ស្ទួន នៅ ភូមិ ពាល ញែក២.. អាន បន្ត ..
អ្នក ជា មនុស្ស ដែល ទាក់ទាញ ម្នាក់ ស៊ិចស៊ី ចិត្ត សប្បុរស អៀន មិន សូវ ចេះ មាត់ ក មាន ចិត្ត ស្មោះ ចិត្ត ល្អ ស្រលាញ់ សន្តិភាព ។
យ៉ាងណា ក៏ដោយ ដោយសារតែ រឿង នេះ ទើបតែ កើតឡើង ថ្មី ៗ
កម្ពុជា ក្រោម ១ចំ,១ទំ
បើ មាន សិទ្ធ តិ
ខ្ញុំ បោះ ឱ្យ តែ គណបក្ស ដដែល ។
ខ្មែរ យើង មាន បទចម្រៀង ជាច្រើន បទ ដែល ទាក់ទង នឹង ផ្កា ចម្ប៉ា និង ចំប៉ី នេះ ។
ដឹង អត់ ថា សង្គ្រាម លោក លើក ទី១ ផ្ទុះឡើង ក្រោយ ការធ្វើគត រជ្ជទាយាទ មួយ អង្គ នេះ !
ផ្ទះ ផលិតផល ផលិតផល អ៊ីសូឡង់ កញ្ចក់
លទ្ធផល បង្ហាញ ថា អ្នក ផឹក ច្រើន ហាក់ ទទួល រង ជំងឺ ដាច់ សរសៃ ឈាម ខួរក្បាល ក្នុង រយៈពេល ៥ឆ្នាំ ក្រោយ មិន ថា ពួកគេ មាន ភេទ ប្រវត្តិ សុខភាព ឥរិយាបទ បែប ណា ក៏ដោយ ៕
នេះ បើ តាម លិខិត ដែល វីអូអេ ទទួលបាន ។
ចង់ ដឹង ទេ តារា កំប្លែង នីឡា មាន ការងារ អ្វី ខ្លះ ក្រៅពី វិស័យ សិល្បៈ ?
ហើយ ក្រុម ទាំងអស់ នោះ នឹង ត្រូវ ធ្វើ ការចាប់ ឈ្មោះ នៅ ថ្ងៃទី ២០ ខែកក្កដា ឆ្នាំ ២០១២ ដើម្បី ស្វែងរក ថា តើ ក្រុម ណា ដែល នឹង ត្រូវ ប្រកួត ជាមួយ ក្រុម ណា
តាមរយៈ សារ បន្តប ន្…
៣ ពេល នោះ ព្រះអម្ចាស់ មាន ព្រះបន្ទូល មក ពួកគេ តាមរយៈ ព្យាការី ហាកាយ ដូចតទៅ ៖
ប្រទេស ហ្វីលីពីន , លេខ ៧៧ឡៃ ផាន បាហ្សា ។
ចំណែក លោក សុខ ទូច បណ្ឌិត វិទ្យាសាស្ត្រ នយោបាយ ។
ក្រសួង នាំ ទឹក ពី អាងទឹក កំពីង កំពួយ ប្រមាណ ៥លាន ម៉ែត្រ គូប បង្ហូ ទៅ ឱ្យ អ្នក សេរី សោភ័ណ ប្រើប្រាស់
ស្តេច និង ក្មេង គ្វាល ក្របី តា ម៉ាប់ យាយ ម៉ាប់
ឈឺក ញឹកញាប់ កម្រ កើត
បុណ្យក ធ្វើ ឈើក កាប់
នៃ ការវិនិយោគទុន មកពី បណ្តា ប្រទេស សេដ្ឋកិច្ច រីកលូតលាស់ ។
ហេតុ អ្វី បានជា វ៉ាក់សាំង កូវីដ - ១៩ដូស ទី២មាន ផល ប៉ះពាល់ ខ្លាំង ជាង ?
នេះ បើ យោង តាម រយ សារព័ត៌មាន បរទេស ចេញផ្សាយ នៅ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៦ ។
យក ទៅ ប្រើប្រាស់ ។
ឥឡូវ នៅ ម្នាក់ឯង ចូលចិត្ត អ៊ូអរ ដល់ ការប្រពន្ធ ចង់ នៅតែ ពីរ នាក់ ប្រពន្ធ វិញ ហើយ
ជាសាធារណៈ ថា ក្នុង ចំណោម រដ្ឋមន្ត្រី ទាំងអស់ គឺ រដ្ឋមន្ត្រី ក្រសួង សាធារណការ …
ជាពិសេស គឺ កម្មវិធី ទាំងអស់ នឹង បើក ចូល ទស្សនា ដោយ ឥត បង់ ថ្លៃ ។
មិន មាន បន្ទប់ទឹក នៅលើ យានអវកាស ទេ នេះ ជា វិធី ដែល អវកាសយានិក ប្រើ បន្ទប់ទឹក - ជីវិត និង សង្គម
រោម អូសញ មនុសស ។
ធារី ចន្ថាប៊ីន ប៉ះ ចាន់ វឌ្ឍនាកា ជាថ្មី ម្តង ទៀត ក្នុង ជំនួប បើក ឆាក លី គ កំពូល ម៉ាឡេស៊ី យប់ នេះ
២១សីហា ដើម ត្នោត នៅលើ ព្រិល ដោយ លូស ហ្គាហ្សាស
អ្នកគាំទ្រ រៀល ម៉ាឌ្រីដ ប្រាប់ ឱ្យ ខត ធឹស បន្ត …
នាយ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល រាជធានី ភ្នំពេញ ឃាត់ខ្លួន ជនសង្ស័យ ២នាក់ ពី បទ លួច មាន ស្ថាន ទម្ងន់ ទោស នគរបាល ជាតិ
ទី១ ក្រសួង នឹង ផ្សព្វផ្សាយ ឱ្យ ស្គាល់ ជា សាធារណ ចំពោះ ក្រុមហ៊ុន ម្ចាស់ ក្រុមហ៊ុន និង ទឹកប្រាក់ ដែល ជំពាក់ ។
សម្តែង ខ្លួន ឯង អត់ មាន អ្នកមើល ទេ ។
ច្រើន ណាស់ អីចឹង ហើយ វា អាច ប៉ះពាល់ សុខភាព របស់ ពួកគេ ។
ស្លាប់ បី នាក់ របួស ប្រាំមួយ នាក់ ក្នុង គ្រោះថ្នាក់ …
មកដល់ ពេលនេះ មិន ទាន់ មាន ការពន្យល់ ណា មួយ ពី សមត្ថកិច្ច ក្រុង ភ្នំពេញ ទាក់ទង ចំណាត់ការ នៅ ពេល នេះ ទេ ។
តុលាការ ជម្រះ ក្តី អតីត ចៅសង្កាត់ បក្ស ប្រឆាំង
យ្របៃ ពេសចកើ នះ
វា ជា ការពិត ណាស់ វិធី ២យ៉ាង សម្រាប់ ផ្ទេរ ចំណេះដឹង ចំណេះ ធ្វើ ពី គ្រូ ទៅដល់ សិស្ស គឺ ៖
លោក បាន បញ្ជាក់ ថា ការរួមគ្នា ទទួលខុសត្រូវ បែប នេះ ជា វិធី តែ មួយ គត់ ដែល អាច ធានា និរន្តរភាព នៃ ការផ្គត់ផ្គង់ អគ្គីសនី ជូន ជាតិ យើង បាន ៕
មួយ យល់ ថា មាន សន្តិភាព វា ទាល់តែ បំបែកបំបាក់បង្ក្រាប ដើរ រំខាន គេ ។
លោក អ៊ុំ សំអាន ត្រូវបាន ដោះលែង ក្រោយ ព្រះមហាក្សត្រ ខ្មែរ ព្រះរាជ ទាន ទោស
ស៊ុន ស្រី ពេជ្រ បញ្ជូន ឪពុក ទៅ វៀតណាម ថ្ងៃ នេះ
ខ្ញុំ សុខចិត្ត នៅ ចាំ មើល ស្នាដៃ របស់ ពួកគេ វិញ
នៃ សវនកម្ម ត្រូវបាន កត់ត្រា ទុក ។
ត្រូវការ ទិញ ដី ផ្ទះ
ផលិត ករ ព្រម សង លុយ ជំពាក់ ជាង ៦០០ ដុល្លារ
ក្រុមហ៊ុន បាន សន្យា ថា កាស របស់ ខ្លួន ដែល នឹង ចេញ លក់ ឆាប់ ៗ
ចាប់ រថយន្ត ដឹក ឈើ ២គ្រឿង នៅ រតនគិរី តែ ម្ចាស់ រត់ រួច ឯ នៅ ស្ទឹងត្រែង ចាប់ បាន អ្នកបើក និង ព្រូ ឡាន
មាន បាន ទទួលស្គាល់ ថា គណបក្ស ប្រជាជន កម្ពុជា បាន ខ្សែក្រវ៉ាត់ ប្រដាល់ ឬ ទេ ?
របស់ រដ្ឋបាល អាណានិគម និយម បារាំង តាមរយៈ ព្រឹត្តិប័ត្រ ទាំងនេះ ។
ទោះបីជា មាន ការកើនឡើង នា ពេល ថ្មី ៗ
ឱ្យ ស្អាត ទុក នៅក្នុង ចាន ចង្កឹះ ។
លោក បញ្ជាក់ ថា អាជ្ញាធរ បាន ទទួល ដំណឹង អំពី ការបាត់ ខ្លួន ស្ត្រី នេះ ពី កូនស្រី នៅ ម៉ោង ប្រហែល ៩យប់ ហើយ មកដល់ ពេលនេះ មិន ទាន់ បាន រកឃើញ នៅឡើយ ។
បាន ឮ ថា ព្រះទេស បូជក ត្ថេរ មាន អាយុ បាន សម្តែង នូវ គាថា ទាំង នេះ ដោយ ប្រការ ដូច្នេះ ។
ពោលគឺជា ការគ្រប់គ្រង អំណាច តាម របៀប ជា អាជ្ញា កណ្តាល ផង និង ជា កីឡាករ ផង ។
ក៏ បាន ផ្តល់ សុពលភាព ដល់ សមាជិក រដ្ឋសភា ទាំង១២៣ រូប ជា ផ្លូវការ …
នា ព្រឹក ថ្ងៃទី ១ ខែធ្នូ ឆ្នាំ ២០១៨ ស្អែក នេះ នឹង មាន ព្រឹត្តិការណ៍ ប្រណាំង កង់ ដែល មាន ទាំង ប្រភេទ វិញ្ញាសា សម្រាប់ គ្រួសារ នាំ កូន ៗ
ផ្អាក ការចេញ - ចូល ទីតាំង ទាំងនេះ ។
ដៃ ដែល ធ្លាប់ ធ្វើបាប អ្នកដទៃ នឹង ត្រូវបាក់ ។
វា គ្មាន ពាក្យ អ្វី ដែល អាច បរិយាយ អំពី អារម្មណ៍ ខុស ប្រក្រតី ដែល បុគ្គល ម្នាក់ មាន នៅ ពេល ដែល ប្រឈមមុខ ជាមួយនឹង អ្នក ដែល បាន ធ្វើ ទារុណកម្ម មក លើ ខ្លួន ។
ខ្ញុំ ធ្វើ តែ ស្រូវ វស្សា ទេ ។
ពី អ្នក ដាំ ស្វាយចន្ទី ធម្មតា អ្នកស្រី អ៊ិន ឡៃ ហួត ក្លាយជា ម្ចាស់ រោងចក្រ កែច្នៃ គ្រាប់ ស្វាយចន្ទី លំដាប់ អន្តរជាតិ
ការបង្រៀន នៅក្នុង ចំណុច នេះ គឺ មាន ន័យ ថា យើង មិន ស្ថិត ទៅ លើ ការថ្វាយតង្វាយ ដែល មាន ភាគរយ ទាប ឬ ភាគរយ ខ្ពស់ នោះ ទេ ។
ំ៤រូបែដល មក ជួយ ងូត
ផ្ទៃ មុខ មិន ស្រស់ស្អាត ជា បញ្ហា ចម្បង មួយ ដែល មិត្ត ៗ
វត្ថុតាង ត្រូវបាន យក ទៅ រក្សាទុក នៅ សាលា ខណ្ឌ ទួលគោក ដើម្បី កម្ទេចចោល ៕
២០រីឯ មនុស្ស អាក្រក់ វិញ ប្រៀប បាន នឹង
សោកនាដកម្ម នេះ គឺជា គ្រោះថ្នាក់ ចុងក្រោយ គេ ក្នុង ចំណោម គ្រោះថ្នាក់ សំណង់ មួយចំនួន ដែល បាន សម្លាប់ មនុស្ស នៅក្នុង ប្រទេស ឥណ្ឌា ដែល ការអនុវត្ត ច្បាប់ សុវត្ថិភាព នៅ ទន់ខ្សោយ ហើយ សម្ភារ ក្រោម ស្តង់ដា ជាញឹកញាប់ ត្រូវបាន គេ ប្រាស់ ៕
ប្រមុខ រដ្ឋាភិបាល បញ្ជា អោយ អាជ្ញាធរ ពិនិត្យ និង ដកហូត ក្រុមហ៊ុន ទទួលបាន ដី សម្បទាន មិន គោរព ច្បាប់
មាន មុខ មួយ ប៉ុន្តែ អាច បែង ភាគ ជាមុខ ៥ក ខៀវ ក្នុង រឿង ព្រះកុរមៈ សម្លៀកបំពាក់ ស្ប…
អ្នក ប្រកបរបរ រកស៊ី ជួញដូរ បើ លោកអ្នក មាន បើក របរ រយៈពេល ខ្លី ៗ
ទោះ យ៉ាងណា យុវវ័យ គ្រប់ រូប គួរតែ ចេះ ស្វែង រក វិធី ជំនះ ការបាក់ ទឹកចិត្ត និង …
អ្នក គួរ ពង្រឹង ស្មារតី ខ្លួន ឯង តាម ៣វិធី នេះ
អ្នក មិន ព្រម ពាក់ ម៉ាស់ ចាប់ បង្ខំឱ្យ ជីក ផ្នូរ កប់ សាកសព អ្នក កើត កូវីដ
៤. កាត់បន្ថយ ការចំណាយ
លោក បាន បញ្ជាក់ ប្រាប់ អ្នកសារព័ត៌មាន នៅក្នុង គ្លីនិក ព្យាបាល មួយ ថា ៖
ដោយ លើក ទង់ជាតិ អេហ្ស៊ីប ពួក បាតុករ នាំគ្នា ស្រែក ថា ប្រជាជន ចង់ឱ្យ អនុវត្ត ច្បាប់ នានា របស់ ព្រះអាល់ឡាហ៍ និង អ៊ិ
សម្រាប់ ខ្ញុំ ថ្មី ៗ
