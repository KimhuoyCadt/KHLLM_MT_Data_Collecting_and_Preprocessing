កុំធ្លាក់ចុះ មើលពណ៌ខាងក្រោយ៖
គាត់បានវិទ្យុវាចូល ។
យើងបានឃើញវានៅក្នុងតំបន់មួយចំនួន ។
ព្រះ‌ អម្ចាស់ធ្វើឲ្យព្រះ‌បាទផារ៉ោនជាស្ដេចស្រុកអេស៊ីបរឹងទទឹង ហើយដេញតាមជន ‌ជាតិអ៊ីស្រា ‌ អែល ។ ជន ជាតិអ៊ីស្រាអែលចេញទៅដោយ ចិត្ត ក្លាហាន ។
កុំ អាត្មា និយម បុរស ។
ខ្ញុំបានសុំផ្ទេរគាត់ បើគាត់មានអំណាច ។
ដូចយើងបានឃើញលើកមុន អ្នក ជឿខ្លះដែលជាសមាជិកនៃក្រុមផារិស៊ីបានក្រោកឈរ ហើយនិយាយថា៖ « ពួក សាសន៍ ដទៃត្រូវកាត់ស្បែក ហើយតម្រូវឲ្យគោរពតាមច្បាប់របស់លោកម៉ូសេ» ។
ប៉ុន្តែ ព្រះយេស៊ូវបានបញ្ជាក់យ៉ាងច្បាស់ថា ពួកគេនឹងទទួលខុស ត្រូវចំពោះការ បដិសេធរបស់ពួកគេចំពោះទ្រង់ ។
ខ្ញុំគិតថានៅប៉ុន្មានសប្តាហ៍ខាងមុខទៀត ពួកគេនឹងត្រៀមខ្លួនជាឪពុករបស់ពួកគេ ។
20 ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូល ថា៖ « ខ្ញុំបានលើកលែងទោសតាមពាក្យរបស់ លោក ។
នេះ ជា ការទាមទារ របស់ យុវជន ។
