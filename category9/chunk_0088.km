20 ហើយមាន ប្រសាសន៍ថា៖ « ចូរលើក ត ម្កើងដល់ព្រះនាមនៃព្រះជារៀងរហូត តទៅ ! ប្រាជ្ញា និង អំណាច គឺជា របស់ គាត់ ។
ការ ភ័យខ្លាចនៃជំងឺកូរូណានិងសេចក្ដី ស្លាប់គឺសម្រាប់អ្នកដែលមានជីវិតរុងរឿងនិងមិនចង់ស្លាប់។
ខ្ញុំ ខ្លាច ណាស់ ប៉ុន្តែ កូន ខ្ញុំ នៅក្បែរ ខ្ញុំ ។
ផ្តល់ អាហារ ដល់ ពួកគេ នៅ ពេល ត្រឹមត្រូវ ?
ដាក់ នៅក្នុង ផ្ទះ មួយ ភួង ស្រូវ សាលី តំណាង ឱ្យ ការសន្យា នៃ ភាពបរិបូរណ៍ និង ទ្រព្យសម្បត្តិ ។
យើងមិនដឹងច្បាស់ពីកាលបរិច្ឆេទនៃការ សោយទិវង្គតរបស់គាត់ទេ ។
គាត់បានឆ្លើយ តបវិញថា « របស់ដែលលាក់ទុកក្នុងពាង » ។
ធ្វើ តាម ពួកគេ ផងដែរ ។
វាល ស្រែ ហើយ កណ្តូបក៏ចាប់សត្វមួយខ្សែជាប់នឹងដើមឈើ
យើងមានទំនោរភ្លេចថា សាតាំងនឹងមិនវាយ ប្រហារអ្នកដែលនៅក្នុងក្រុមរបស់វាឡើយ ។
១៩ ហើយខ្ញុំដឹងថា ស្ដេចស្រុកអេស៊ីបនឹងមិនទុកឲ្យអ្នក រាល់គ្នាចេញដំណើរឡើយ លើកលែង តែដោយដៃដ៏ខ្លាំងក្លា ប៉ុណ្ណោះ ។
២០ ជន ជាតិយូដាពោលថា៖ « ត្រូវចំណាយពេលសែសិបប្រាំមួយឆ្នាំដើម្បី សង់ព្រះវិហារនេះ ហើយតើអ្នកនឹង សង់ឡើងក្នុង រយៈពេលបីថ្ងៃឬ ? » ។
ខ្ញុំ មិន បរិភោគ លាមក របស់ ខ្ញុំ ទេ ។
ពាក្យអង្វររបស់ឪពុកចំពោះ ឃាតក រ៖ ប្រាប់យើងពីកន្លែងដែលអដ្ឋិធាតុកូនស្រីយើង ..
ខ្ញុំ ចង់ និយាយ ថា រហូតដល់ អ្នកស្លាប់ ។
ហេតុនេះហើយបានជាគេកោតខ្លាចទ្រង់ ហើយញាប់ញ័រនៅចំពោះទ្រង់ ។
ហើយមាន ភាពបរិសុទ្ធមិនអាចប្រកែកបាន។
14 តើនរណានឹងនិយាយទៅ កាន់អ្នក រាល់គ្នានូវពាក្យដែលអ្នកនឹងបាន សង្គ្រោះ អ្នក និងផ្ទះរបស់អ្នកទាំងអស់គ្នា ។
ម្ចាស់ បំណុល ដូចជា កូន បំណុល តែ មួយ គត់ ដោយ មិន ប្រកាន់ ស្តាំ
ហោរាដែលមានចែងក្នុងគម្ពីរគម្ពី គូ រ៉ា ?
ដូច្នេះ ដោយ សារសេចក្ដី មេត្តា ក រុណារបស់ព្រះ យើងមាន កិច្ចបម្រើនេះ យើងមិនបាត់ បង់ ចិត្តឡើយ ។
នេះជាអ្វីដែលខ្ញុំបង្គាប់នៅក្នុងសាសនា ចក្រទាំងអស់ ។
លុះ មកដល់ហើយ ទ្រង់មាន បន្ទូលទៅគេថា
ចូរអ្នកបរិភោគពេញមួយជីវិតរបស់អ្នក ហើយខ្ញុំនឹងធ្វើឲ្យអ្នកនិងស្ត្រីមានសេចក្តី ប្រច័ណ្ឌ
ដូច្នេះ ការ ដែលមាន កិច្ចការ នេះដោយសេចក្ដី មេត្តា ក រុណារបស់ព្រះ យើងមិនបាត់ បង់ ចិត្តឡើយ ។
អ្នកបង្កើតសន្តិភាពមាន ពរហើយ ដ្បិតគេនឹងត្រូវបានហៅថាជាកូនរបស់ព្រះ។
គាត់នឹងក្លាយទៅជាបិតានៃសម្ដេចទាំងដប់ ពីរ ហើយយើងនឹងធ្វើឲ្យគាត់ក្លាយជាប្រជាជាតិដ៏ធំ ។
អាថ៌កំបាំងគឺមិនធ្វើឱ្យឆ្អិនពេកទេ ដែលធ្វើឱ្យវាស្ងួត ។
នេះ ជា ការ ល្អ ហើយ គាប់ ព្រះហឫទ័យ ព្រះជាម្ចាស់ ជា ព្រះអង្គ សង្គ្រោះ របស់ យើង ដែល ចង់ឱ្យ មនុស្ស ទាំងអស់ បាន សង្រ្គោះ ហើយ មក ស្គាល់ ការពិត ។
មិន ឃើញ មាន ដើមឈើ ទេ ដូច្នេះ ត្រូវ ត្រៀម ព្រះអាទិត្យ ឲ្យបាន ច្រើន ។
ទោះបីជា វា ជា ពេលវេលា ដ៏ លំបាក សម្រាប់ ពួកយើង ភាគ ច្រើន ក៏ដោយ វា ពិតជា មាន សារៈសំខាន់ ខ្លាំង ណាស់ ក្នុង ការបន្ត ធ្វើ ការលើ ទំនាក់ទំនង របស់ មនុស្ស ទាំងនោះ ។
វា គ្មាន ការ ខ្មាស់អៀន ទេ ក្នុង ការក្លាយជា អ្នក ប៉ុន្តែ របៀប ដែល អ្នក បង្ហាញ ខ្លួន ឯង អាច បង្វែរ មនុស្ស ចេញ ។
ប៉ុន្តែ លោកយេស៊ូបានដេក លក់ ។
ហោ រាឡុត ដើម្បីអះអាងពីការ គ្រប់គ្រងរបស់ពួកគេ ហើយបន្ទាប ប ន្ថោកគាត់ ។
... ត្រូវបាន បង្កើត ហើយ បន្ទាប់ពី នោះ វា ត្រូវបាន បង្កើតឡើង ហើយ បន្ទាប់មក វា ត្រូវបាន បង្កើត ។
ប្រជាជន ទាំងអស់ នៅលើ ផែនដី នឹង ថ្វាយបង្គំ សត្វ នេះ - អស់ អ្នក ដែល មិន មាន ឈ្មោះ នៅក្នុង សៀវភៅ ជីវិត ដែល ជា កម្មសិទ្ធិ របស់ កូន ចៀម ដែល ត្រូវបាន សម្លាប់ តាំងពី កំណើត នៃ ពិភពលោក ។
ខ្ញុំគិតក្នុង ចិត្តថា “ ហេតុអ្វីបានជាខ្ញុំមិនភ័យខ្លាច ?
អាកប្បកិរិយា របស់ ពួកគេ ចំពោះ អ្នក បុរាណ គឺជា ការគោរព ប្រណិប័តន៍ ដ៏ បរិសុទ្ធ ជាពិសេស អ្នកណែនាំ ផ្ទាល់ របស់ ពួកគេ ។
ប្រសិនបើ ភ្នែក ម្ខាង ប៉ះពាល់ ។
១៦៤ ក្នុងមួយថ្ងៃ ខ្ញុំសរសើរអ្នក រាល់គ្នាប្រាំពីរដង ដោយ សារការ វិនិច្ឆ័យនៃសេចក្ដី សុចរិតរបស់អ្នក ។
ដ្បិតអ្នក រាល់គ្នាមិនត្រូវស្លាប់ដោយការ ទទួល ទានឡើយ ។
ដំណឹង ល្អ មិន សំខាន់ ជាង សៀវភៅ ផ្សេង ទៀត ទេ ។ ទោះបីជា ពួកវា លេចឡើង នៅក្នុង ផ្នែក នៃ វិវរណៈ ក៏ដោយ ។ ទោះបីជា ។
៨ បន្ទាប់មក យើងបាន នាំអ្នកទៅក្នុងទឹកដីរបស់ជន ជាតិអាម៉ូរី ដែល រស់នៅត្រើយម្ខាងនៃទន្លេយ័រ ដាន់ ហើយពួកគេបានច្បាំងជាមួយនឹងអ្នក យើងបានប្រគល់វាមកក្នុងដៃអ្នក ហើយអ្នកបាន កាន់កាប់ដីរបស់គេ ហើយយើងបានបំផ្លាញពួកគេនៅចំពោះមុខអ្នក។
ខ្ញុំប្រាប់អ្នក រាល់គ្នាជាប្រាកដថា បើអ្នក ណា កាន់តាមពាក្យខ្ញុំ អ្នក នោះនឹងមិនឃើញសេចក្ដី ស្លាប់ឡើយ » ។
“ ការសរសើរ តម្កើង ព្រះជាម្ចាស់ ហើយ មាន សេចក្តី ពេញចិត្ត ( សេចក្តីស្រឡាញ់ ឬ សេចក្តីស្រឡាញ់ ) ជាមួយ មនុស្ស ទាំងអស់ ។
(30) កុំ សោក សៅ ចំពោះ ព្រះវិញ្ញាណ បរិសុទ្ធ នៃ ព្រះ ដែល ពួក អ្នក ត្រូវបាន ផ្សារភ្ជាប់ ជាមួយនឹង ថ្ងៃ នៃ ការប្រោស លោះ ។
" អ្នក សមនឹងនៅជាមួយអ្នកដែលអ្នក ទុក ចិត្ត ហើយមិនធ្វើឱ្យអ្នកឈឺចាប់ " ។
ឥឡូវនេះ យើង ធ្វើ វា ទាំងអស់ តាម អ៊ីនធឺណិត ។
អ៊ីយ៉ុង គឺ ចាំបាច់ ។
កុមារ និង មនុស្ស វ័យ ក្មេង មិន គួរ ផ្តល់ ព័ត៌មាន ផ្ទាល់ខ្លួន ឡើយ ហើយ គ្រាន់តែ ធ្វើជា " មិត្ត " ជាមួយ មនុស្ស ដែល ពួកគេ ស្គាល់ និង ទុកចិត្ត នៅក្នុង ពិភព ពិត ។
មនុស្ស ជាច្រើន និយាយ ថា វា ជា ថ្ងៃ សំណាង ។
ទោះបីជា ពួកគេ អាច ដំណើរការវា ជាមួយ ស្រា រួចហើយ ក៏ដោយ ។
ហើយនៅពេលដែលអ្នកឈោងទៅរកគាត់ គាត់មិនដែលធ្វើឱ្យអ្នកខក ចិត្តឡើយ ។
ជាង អ្នក បាន បង្ហាញ ពី ពួកគេ ។
ខ្ញុំ មិន កក់ សក់ ញឹកញាប់ ដូច ពីមុន ទេ ។
ដើមឈើដែលគេវាយមនុស្សបាក់បែក ។
ចូរធ្វើអាជីវកម្មខ្លះ ។
« ហើយបន្លឺសំឡេងយ៉ាងខ្លាំងដូចជាពេលដែលសត្វ តោស្រែកឡើង ហើយពេលវាស្រែកឡើង នោះផ្គរ លាន់ប្រាំពីរក៏បន្លឺសំឡេងរបស់វា » ។
២១ ចូរធ្វើឲ្យអស់ ពីសមត្ថភាពដើម្បីមកមុនរដូវ រងា ។
អ្នកដែលបង្កើតសន្តិភាពមាន ពរហើយ ព្រោះគេនឹងហៅថាជាកូនរបស់ព្រះ។
គាត់ចូល មករាល់ថ្ងៃ ហើយគាត់ធ្វើការ នៅក្នុងការ ប្រកួតរបស់គាត់ » ។
ថ្ងៃនោះខ្ញុំនឹងផ្តល់សេវាដល់អ្នក រាល់គ្នាពេញ ចិត្ត ។
ពួកគេ មិន បាន ហៅ ពួកគេ ថា មិន ត្រឹមត្រូវ ទេ ប៉ុន្តែ ពួកគេ បាន ចោទសួរ ពី សុពលភាព របស់ ពួកគេ ។
ជាក់ស្តែង មនុស្ស គ្រប់ គ្នា នៅ ឆ្នេរ ខាងលិច មាន គំនិត ដូចគ្នា ទៅនឹង អ្នក ដែរ ។
« តើខ្ញុំត្រូវឡើងទៅវាយពួកភីលី ស្ទីនឬ ? »
« ហើយខ្ញុំ ពេលខ្ញុំត្រូវបានលើកឡើងពីផែនដីនឹងទាញមនុស្សទាំងអស់មក ឯខ្លួនខ្ញុំ » ។
« ហើយពេលដែលខ្ញុំត្រូវបានលើកឡើងពីផែនដី នោះនឹងទាញមនុស្សទាំងអស់មក ឯខ្លួនខ្ញុំ » ។
« ហើយពេលដែលខ្ញុំត្រូវបានលើកឡើងពីផែនដីនឹងទាញមនុស្សទាំងអស់មក រកខ្លួនខ្ញុំ » ។
១៤ ហើយកំពែងក្រុងមាន គ្រឹះដប់ ពីរ ហើយនៅលើនោះមានឈ្មោះសាវកដប់ ពីរនាក់នៃកូនចៀម ។
កុំ ផ្លាស់ទី វា លើកលែងតែ នៅ ពេល ដែល អ្នក មាន កាតព្វកិច្ច ដាក់ វា នៅក្នុង ធុង ផ្សេង ទៀត ។
៥ហើយអ្នកដឹងថាទ្រង់ ( ព្រះគ្រីស្ទ ) បានសម្ដែងមក ដើម្បីដកយកអំពើ បាបរបស់យើងចេញ ហើយនៅក្នុងទ្រង់គ្មានអំពើ បាបអ្វីឡើយ ។
៨ ព្រះអម្ចាស់មានព្រះបន្ទូលមក កាន់លោកយ៉ូស្វេ ថា៖ « កុំខ្លាចពួកគេឡើយ យើងបានប្រគល់វាមកក្នុងកណ្ដាប់ដៃរបស់អ្នក ហើយ គ្មាននរណាម្នាក់អាចទប់ទល់នឹងអ្នកបានឡើយ » ។ (BA)
និក្ខម នំ 78:42 គេមិននឹកឃើញដៃរបស់លោកឡើយ ហើយក៏មិនចាំថ្ងៃដែលលោកបានរំដោះគេពីខ្មាំង ស ត្រូវដែរ ។
សួនច្បារ របស់ យើង គឺ ស្ថិត នៅ កំពូល របស់ ពួកគេ ក្នុង កំឡុង ខែ ដ៏ កក់ក្តៅ ជាមួយនឹង ពណ៌ និង ក្លិន ក្រអូប គួរឱ្យ ចាប់អារម្មណ៍ ។
ពួកគេ ក៏ មិន ធ្វើ ការ ហៅទូរសព្ទ ដែល មិន ចង់បាន ផងដែរ ។
៣ យើងបានឮ និងដឹងថាបុព្វបុរសរបស់យើងបានប្រាប់យើង ។
នៅ ពេល ដែល រដូវ ក្តៅ មកដល់ ទី បញ្ចប់ ហើយ រដូវ ស្លឹកឈើ ជ្រុះ ក៏ ខិត ជិត មកដល់
នេះមាន ន័យថា វាជារឿងសំខាន់ក្នុងការ ជ្រើសរើសអ្នកដែលអ្នក និយាយជាមួយដោយប្រុងប្រយ័ត្ន ។
ដើរ តាម អំពើ ល្អ ដើម្បី ប្រយោជន៍ ខ្លួន
ជិន បាន ណែនាំ គាត់ ។
៤; លោកម៉ូសេ បាននិយាយទៅ កាន់កូនចៅអ៊ីស្រា ‌ អែល ដើម្បីរៀបចំបុណ្យចម្លង ។
បើទោះបីជាគេធ្វើយ៉ាង ណាក៏គួរទទួល ទានដែរ ?
ជា ឧទាហរណ៍ សូម និយាយ ថា កាលពី ប៉ុន្មាន ឆ្នាំ មុន អ្នក បាន ធ្វើ បទបង្ហាញ ដ៏ សំខាន់ មួយ នៅ ចំពោះមុខ ក្រុម ធំ មួយ ហើយ អ្នក បាន ធ្វើ វា យ៉ាង ធ្ងន់ធ្ងរ ។
5:11 ហើយនៅទីនោះនៅជិតភ្នំមួយហ្វូងនៃជ្រូកយ៉ាងធំកំពុងចិញ្ចឹម .
អ្នកប្រាជ្ញ និង អ្នក កាន់ សាសនា ] ។
យើង និងមនុស្សជំនាន់ក្រោយនឹងរងទុក្ខសម្រាប់វា ។
អ្នក ទាំងនេះជាអ្នកអង្វរដែលបានដេក លក់ អ្នកដែលឈប់ឈ្លោះគ្នាព្រោះវាយូរពេកមិនអាចប្រកែកបាន ។
ពេលនោះ ទេវតាពោលថា៖ « អ្នកនឹងមានផ្ទៃពោះ ហើយសម្រាលបានកូនប្រុស ។
តើអ្នកមានបំណងបង្ហាញវាដល់លោកអាកា ជី ឬ ?
សូមស្ដាប់ ចម្លើយ៖ « ប៉ុន្តែសូមទទួលស្គាល់នៅថ្ងៃនេះថា ព្រះអម្ចាស់ ជាព្រះ របស់អ្នកគឺ ជាព្រះអង្គដែលនឹងឆ្លងកាត់ពីមុខអ្នក ដូចជាភ្លើងឆេះបំផ្លាញពួកគេ ។
នាង ជា ជនជាតិ ម៉ិកស៊ិក ប៉ុន្តែ នាង រស់ នៅក្នុង ទីក្រុង ញូវយ៉ក ។
ប្រសិនបើ ពួកគេ អាច ជួយ វា បាន - ប្រសិនបើ រាល់ ហានិភ័យ ផ្នែក ហិរញ្ញវត្ថុ ដែល ពួកគេ បាន យក ក្នុង រយៈពេល 40 ឆ្នាំ ចុងក្រោយ នេះ ដំណើរការចេញ - ពួកគេ សង្ឃឹម ថា នឹង ក្លាយជា មនុស្ស ជំនាន់ ចុងក្រោយ ក្នុង គ្រួសារ របស់ ពួកគេ ដើម្បី ចិញ្ចឹម ជីវិត នៅលើ ទឹក ។
វាជាគំនិតអាក្រក់ ប៉ុន្តែយើងខ្លះប្រហែលជាគ្មានជម្រើស ។
ជារៀងរាល់ព្រឹក ថ្ងៃត្រង់ និងល្ងាច ពួកគេប្រាប់អង្កាំ ហើយសូត្រ ធម៌ម្ដងទៀត ។
អ្នកមិនអាចនៅទីនោះជានិច្ចដើម្បីគ្រប់គ្រងសកម្មភាពបណ្ដាញរបស់គ្រួសារអ្នក ។
កូនមនុស្សបាន មកស្វែង រក និង សង្គ្រោះអ្វីដែលបានបាត់ បង់ » ។
នាងមិនភ័យខ្លាចថាមានអ្វីអាក្រក់នឹងកើតឡើងចំពោះពួកគេឡើយ ។
