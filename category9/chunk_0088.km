គ្មានអ្នកសំខាន់ ណាម្នាក់នឹងត្រូវបានគេទុកចោល ។
ជនជាតិ យូដា ដែល ស្អប់ ខ្លួន ឯង មាន ច្រើន ណាស់ ។
មាន អាជីវកម្ម ជាច្រើន ដែល មនុស្ស គ្រប់ គ្នា ដឹង និង យល់ ។
នេះ ក៏ ត្រូវបាន គំរាមកំហែង ដោយ សកម្មភាព របស់ បក្ស កុម្មុយនិស្ត ។
ជាអកុសល ខ្ញុំគិតថានេះជាយុទ្ធសាស្ត្រដ៏គួរឲ្យខ្លាច » ។
ខ ) ខួរក្បាល ធ្វើ ការសម្រេចចិត្ត ។
ជាយូរមកហើយគាត់បានឆ្លើយ តបថា៖ «វាល្អប្រសើរជាងមុន ។
តើអ្នក យល់យ៉ាង ណាក្នុងការ បង្កើត " វគ្គរាសីចក្រ " នេះ ?
ខ្ញុំ មិន ដឹង ថា អ្នកណា ខ្លះ ជាប់ពាក់ព័ន្ធ ទេ រហូតដល់ ខ្ញុំ ទទួលបាន ភស្តុតាង សៀវភៅ ហើយ ខ្ញុំ ដូចជា ហេ !
ក្មេងប្រុសក៏រំជួល ចិត្តពេកដែរ ។
មានការ រីក រាយយ៉ាង រីក រាយក្នុងចំណោមប្រជាជន ។
យើង មិន ធ្វើ ការទាមទារ ណាមួយ សម្រាប់ ការប្រើប្រាស់ ឬ ប្រសិទ្ធភាព នៃ ទៀន ទាំងនេះ ទេ ។
បាទ ប៉ុន្តែវាជាពេលមួយក្នុងចំណោមការ ធ្វើដំណើរចំនួន 5 ដែលវាបានកើតឡើង ។
60:5 ពេលនោះ អ្នកនឹងឃើញ ហើយហូរចូលគ្នា ហើយ ចិត្តអ្នកនឹង ភ័យខ្លាច ហើយរីក ធំ ។ ដោយ សារទឹកសមុទ្រដ៏បរិបូរណ៍នឹងត្រឡប់មក រកអ្នក នោះ កម្លាំងរបស់ សាសន៍ ដទៃនឹង មក រកអ្នក ។
ពិនិត្យមើល ថា តើ កន្លែងណា ដែល មាន ទឹក
ចិត្ត ដើម្បីឱ្យ សិស្ស របស់ ខ្ញុំ អាច រៀន ប្រកបដោយ ប្រសិទ្ធភាព ។
« វាហាក់ដូចជាបានទៅពាក់កណ្តាលផ្លូវហើយ ប៉ុន្តែមិនបាន បញ្ចប់ការងារនោះទេ » ។
ខ្ញុំ មាន គ្រូ វាយ កូនហ្គោល បោះបង់ ខ្ញុំ !
ខ្ញុំ នឹង ត្រលប់ ទៅ កន្លែង ដែល ខ្ញុំ បាន ជួប អ្នក ។
រួចគេក៏ខ្សឹបប្រាប់គ្នាថា « ចេញមក?
“ ខ្ញុំពិតជាជឿថាយកភូមិមួយ !
គាត់ចុះ មកឈរចាំឯង » ។
ចំណុចនៃទិដ្ឋភាព ! - ធ្វើខ្លួនឱ្យខ្ទេចខ្ទាំ ។
ការ គិតរបស់វាធ្វើឲ្យយើងឈឺ ។
អ្នក ណាមិនលះបង់អ្វី ៗទាំងអស់ដែលខ្លួនមាន អ្នកនោះមិនអាចធ្វើជាសិស្សរបស់ខ្ញុំបានឡើយ ។
« តែអ្នកដែលស្រឡាញ់ព្រះជាអ្នកស្គាល់ព្រះ» ។
ហើយ សម្រាប់ ជា ប្រយោជន៍ របស់ ព្រះឈប់ ការពារ ក្រុម ជំនុំ ។
កុំ ចិញ្ចឹម សំណល់ ។
តើអ្នកចង់ផ្លាស់ ប្តូ រវាសម្រាប់មួយផ្សេងទៀត?
ពួកគេ ក៏ ជា អ្នកគាំទ្រ ដ៏ ធ្ងន់ធ្ងរ ផងដែរ ។
២៤ ពេលនោះ នឹងជា ទី បញ្ចប់ នៅពេលដែលទ្រង់នឹងប្រគល់នគរដល់ព្រះ សូម្បីតែព្រះវរ បិតា ; នៅ ពេល ដែល ទ្រង់ នឹង លុបចោល ការគ្រប់គ្រង និង អំណាច និង អំណាច ទាំងអស់ ។
ការស្រាវជ្រាវ គឺ ផ្តោត លើ ការពិនិត្យមើល ចិត្ត វិទ្យា នៃ វប្បធម៌ ប្រព័ន្ធ ផ្សព្វផ្សាយ ពេញនិយម ។
តើវាមកពី ណាខ្ញុំមិនដឹងទេ ?
ប៉ុន្តែ អ្នក គឺជា ពលរដ្ឋ នៃ ពិភពលោក ។
អ្នក បានមកជាមួយអាចត្រូវបានបំបែក
ប៉ុន្តែ ត្រូវ ប្រាកដ ថា ទៅ លេង សហគមន៍ ។
ខ្ញុំ ដឹង ថា ក្នុង នាម យើង ជា គ្រិស្ត បរិស័ទ យើង និយាយ ពាក្យ នេះ គ្រប់ ពេល ប៉ុន្តែ ព្រះជាម្ចាស់ ល្អ ណាស់ ។
យូដាស 1:18 ពួកគេបានប្រាប់អ្នក រាល់គ្នាថា នៅ គ្រាចុងក្រោយ បង្អស់នឹងមានអ្នកមើលងាយ ដោយប្រព្រឹត្តទៅតាមសេចក្ដី ប៉ងប្រាថ្នារបស់ខ្លួនដោយមិនគោរព ។
១៧ហើយឥឡូវនេះ ខ្ញុំសូមអង្វរអ្នកសូមឲ្យព្រះចេស្ដានៃព្រះចេស្ដានៃព្រះ អម្ចាស់បានសម្ដែងឲ្យឃើញដូចដែលអ្នកបាននិយាយថា
ដូច្នេះ នេះ ជា ការរំលឹក របស់ អ្នក ដើម្បី ចុះឈ្មោះ ។
វិវរណៈ បញ្ចប់ដោយការសន្យានៃការ ស្ដារឡើងវិញនូវអ្វី ៗទាំងអស់ ។
បន្ទាប់មកនាងសម្រាលបានកូនប្រុសម្នាក់ដែលបានស្លាប់បន្ទាប់ពីបាន 4 ខែ ។
៥ ប៉ុន្តែ ទេវតាពោលទៅ កាន់ស្ត្រី ថា៖ « កុំខ្លាចឡើយ ដ្បិតខ្ញុំដឹងថាអ្នកស្វែង រកព្រះ យេស៊ូដែលត្រូវគេឆ្កាង ។
បើអ៊ីចឹងខ្ញុំប្រហែលត្រូវចាំប៉ុន្មានឆ្នាំទៀត ទាល់ តែខ្ញុំមានលទ្ធភាពចូលនិវត្តន៍សិន !
វា គឺ សម្រាប់ ហេតុផល នេះ ដែល ជា ព្យាការី របស់ យើង ។
ពេលនេះខ្ញុំដឹងថាវាងាយស្រួលប៉ុណ្ណា ខ្ញុំនឹងធ្វើនំរបស់ខ្ញុំ ។
រង់ចាំការ ផ្ដល់ជូនហើយ បញ្ចូលវា ។
ហើយឥឡូវនេះយើងដឹងថាគ្មានអ្វីសូម្បីតែជំងឺរាតត្បាតឬការ បំពានអំណាចក៏មិនអាចពន្លត់ ភ្លើងនោះបានដែរ » ។
ជឿជាក់យ៉ាងខ្លាំងនឹងពាក្យពោលថា៖ « បើអ្នកអាចសុបិនបាន អ្នកអាចធ្វើបាន » ។
ប៉ុន្តែអ្នកបោះឆ្នោតសម្រេចជ្រើសរើសមនុស្សតែពីរពណ៌ ។
នៅលើ ការប្រកួត ជើងឯក ពិភពលោក នៅលើ ការកសាង រាងកាយ មួយ កីឡាករ កាយ វប្បកម្ម ឡាត វី បាន កាន់កាប់ និង មិន ផ្តល់ឱ្យ ។
នៅលើ ដៃ មួយ សត្វ ល្អិត ដែល គួរឱ្យ ភ័យខ្លាច ។
ខ្ញុំ មិន ដឹង ទេ អោប
ច្រៀង ជូន សត្វ គោ នៅ ពេល យប់ ដើម្បី រក្សា
យ៉ាងហោចណាស់ រត់ ឡើង បំណុល កាត ឥណទាន ។
យកស្លាបឆ្វេងជាមួយនឹងអ្នក ធ្នូ ។
នេះជាទុក្ខលំបាកបន្តិចសម្រាប់ម្ដាយរបស់គាត់ ។
យើងបានឲ្យពួកគេលើសពីថ្ងៃនេះ » ។
តើអ្នកបានឮអ្វីពីអ្នកតំណាង រាស្ត្ររបស់អ្នក ?
ការងារ តិចតួច ដែល អស់ រយៈពេល ពីរ សតវត្ស មក ហើយ បាន ទទួល ការពេញចិត្ត ពី គ្រប់ គូស្នេហ៍
ហើយ ដល់ ពេល ដែល ត្រូវ ទៅ ជួប គ្រូពេទ្យ ។
ខ្ញុំ បាន និយាយ ពី មុន ថា ខ្ញុំ ជា គ្រិស្ត សាសនិក ម្នាក់ ដែល មិន ខ្មាស់អៀន ។
បង្ហាញ ការគោរព ចំពោះ អ្នកដទៃ និង គំនិត របស់ ពួកគេ ។
ភាគ ច្រើន នឹង ជា មធ្យម នៅ សកម្មភាព ដែល បាន ជ្រើសរើស របស់ ពួកគេ ឬ បង្ហាញ ចំណាប់អារម្មណ៍ ខុស ៗ គ្នា នៅពេល ផ្សេង ៗ គ្នា ក្នុង ជីវិត របស់ ពួកគេ ។
បន្ទាប់មក គាត់ បាន បន្លឺ សំឡេង របស់ គាត់ ដើម្បី បញ្ជា ។
បាតុកម្មថ្ងៃទី១៣ ខែ មេសា គឺជាបាតុកម្មដ៏មានឥទ្ធិពល ។
អ្នកមាន ពរហើយ ពេលដែលមនុស្សប្រមាថអ្នក ហើយបៀតបៀនអ្នក ហើយនិយាយមិនពិតគ្រប់បែបយ៉ាងប្រឆាំងនឹងអ្នកដោយសារខ្ញុំ » ( ម៉ាថា យ ៥:១០, ១១) ។
