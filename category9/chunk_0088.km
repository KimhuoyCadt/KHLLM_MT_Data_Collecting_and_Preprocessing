ជន ជាតិអ៊ីស្រាអែលជាច្រើននាក់បានបង្ហាញខ្លួនថាមិនគោរពព្រះ។
« ដូចដែលអ្នក ឃើញហើយ កន្លែងនេះមិនមែនសម្រាប់មនុស្សទេ ។
ខ្ញុំ ឮថា នៅពេលដែលអ្នក រាល់គ្នាមកជាក្រុមជំនុំ នោះមានការ បែកបាក់គ្នាក្នុងចំណោមអ្នក ។
ស្វែងរក កន្លែង សម្រាក របស់ អ្នក នៅក្នុង ទ្រង់ ហើយ ផ្តល់ឱ្យ គាត់ នូវ បន្ទុក របស់ អ្នក ទាំងអស់ ។
ដោយ សារការ ផ្ទុះភ្នំ ភ្លើងនៅជិតក្រុង ម៉ានីល ខ្ញុំ សង្ឃឹមថានឹងមិនមាននរណាម្នាក់រងគ្រោះដោយគ្រោះ មហន្តរាយនេះឡើយ » ។
យើងក៏មិនជិតដល់កន្លែងដែលយើងចង់ទៅដែរ » ។
ពេលខ្ញុំមក រកបងប្អូនអើយ ខ្ញុំមិនបានមកប្រកាសអាថ៌កំបាំងនៃព្រះដល់អ្នក រាល់គ្នាដោយពាក្យសំដី ឬប្រាជ្ញាដ៏ខ្ពង់ខ្ពស់ឡើយ ។
យើង សប្បាយ ចិត្ត ណាស់ ដែល បាន ញ៉ាំ នៅ ទីនេះ ។
តាមពិត ទ្រង់បាន សន្យាថាទ្រង់នឹងមិនចាកចេញពីយើង ឬបោះ បង់យើងឡើយ ។
និង ព័ទ្ធ ជុំវិញ ដោយ ជញ្ជាំង ខ្ពស់ ។
គេ ស្គាល់ ធនាគារ រួចហើយ ។
១៦ ពួកគេមិនមែនជារបស់លោកីយ៍ទេ ដូចខ្ញុំក៏មិនកើតពីលោកីយ៍ដែរ ។
អ្នក ក៏ អាច ជា មនុស្ស លេងសើច និង ឆ្លាត ផងដែរ ។
ទ្រង់នឹងធ្វើជាបិតានៃអ្នកគ្រប់គ្រងដប់ ពីរនាក់ ហើយយើងនឹងតាំងគាត់ឲ្យទៅជាប្រជាជាតិដ៏ធំ ។
នៅពេល ពួកគេ មកដល់ ផ្ទះ នាង បាន រាប់ ម្ភៃ ។
អេសាវ និយាយថា៖ « អរគុណចំពោះសត្វដែលអ្នកបានបញ្ជូនមក ។
នេះជាមូលហេតុដែលយើងត្រូវធ្វើការ ស្រាវជ្រាវ និងអភិវឌ្ឍ ។
ព្រះអម្ចាស់ អើយ ហេតុ អ្វី បានជា ខ្ញុំ មិន អាច តាម អ្នក ឥឡូវនេះ ?
« ទ្រង់នឹងបង្រៀនយើងអំពីមាគ៌ារបស់ទ្រង់ ដូច្នេះយើងអាចដើរតាមមាគ៌ាទ្រង់ » ។
ខ្ញុំប្រគល់វិញ្ញាណទៅក្នុងដៃអ្នក › ។
យើងនឹងបំផ្លាញប្រាជ្ញារបស់អ្នក ប្រាជ្ញ
ភាព ទន់ភ្លន់ និង ការគ្រប់គ្រង ខ្លួន ឯង ។ ប្រឆាំង នឹង រឿង បែប នេះ មិន មាន ច្បាប់ ទេ ។
ថ្វាយបង្គំអ្នកដែលពាក់មកុដលើក្បាល
ប្រសិនបើ អ្នក នៅតែ រីករាយ ជាមួយ ការចែករំលែក ពេលវេលា របស់ អ្នក នោះ ការចុះហត្ថលេខា លើ កិច្ចសន្យា ថ្មី ប្រហែលជា ល្អ សម្រាប់ អ្នក ។
ខ្ញុំ បាន ប្រាប់ អ្នក ថា វា នឹង កើតឡើង ។
ពេលបែរទៅជ្រុងម្ខាងឃើញក៏ភ្ញាក់ផ្អើល ។
20 ហើយដើម្បីឲ្យគាត់ចាត់ព្រះ‌ គ្រីស្ទ ដែលបានត្រូវតែងតាំងឲ្យអ្នក រាល់គ្នា គឺគឺព្រះ‌ យេស៊ូវ
17 យើងនឹងធ្វើឲ្យព្រះ‌នាមរបស់អ្នកត្រូវបានគេចងចាំនៅគ្រប់ជំនាន់ ហេតុនេះហើយបានជាប្រជា‌ជនសរសើរ ត ម្កើងព្រះអង្គជារៀងរហូត ។
ខ្ញុំសូមយោង ទៅលើក្រឹត្យរបស់ព្រះ យេហូវ៉ា ។ គាត់បាននិយាយមកខ្ញុំថា : អ្នក ជាកូនរបស់ខ្ញុំ។ ថ្ងៃ នេះ ខ្ញុំ បាន ក្លាយជា ឪពុក របស់ អ្នក ។
19 អ្នក រាល់គ្នាជឿថាមានព្រះតែមួយ ... សូម្បីតែអារក្សក៏ជឿហើយញាប់ញ័រ !
គ្មាននរណាមកជិតគាត់ឡើយ » ។
« សូមយកពែងនេះមកពេញដោយកំហឹងរបស់ខ្ញុំ ហើយធ្វើឲ្យប្រជាជាតិទាំងអស់ដែលខ្ញុំចាត់អ្នកឲ្យមកផឹក ។
ហើយគាត់វាយចេញពី ៨ ទៅ ៩ គ្រាប់ក្នុងមួយវគ្គ ៩ ដង ។
ដូច្នេះអ្វីដែលអ្នក ធ្វើឱ្យអ្នក ណាដែលចង់ដឹងអាចមើលឃើញ ។
ត្រាស់ដឹងច្បាប់ក្រោយពីព្រះតថាគតផុត រលត់ទៅហើយ រមែង រលត់សូន្យឈឹង ។
ពេលអ្នក នាំប្រជាជនចេញពីស្រុកអេស៊ីបហើយ អ្នកនឹងបម្រើយើងនៅលើភ្នំនេះ ។
ពីព្រោះកូនមនុស្សពិតជាទៅ ដូចមានចែងទុកពីគាត់ តែវេទនា ដល់អ្នក ណាដែលកូនមនុស្សក្បត់ » ។
គាត់ចាប់ផ្ដើមដើរតាមព្រះ យេស៊ូ ។
៥ ព្រះអង្គដែលគង់លើបល្ល័ង្កពោលថា៖ « មើល !
ព្រះ បានវិនិច្ឆ័យលោកយេស៊ូយ៉ាងពេញ លេញក្នុងក្រិត្យវិន័យ ។
នាងបានព្យាយាមមើលគាត់រាល់ថ្ងៃពេលគាត់នៅមន្ទីរពេទ្យ ។
គឺជា ការអាម៉ាស់ មួយ សម្រាប់ ស្ត្រី ក្នុង ការនិយាយ នៅក្នុង ព្រះវិហារ ។
អត្ថបទ៖ « ព្រះអម្ចាស់បានដកទោសអ្នក ចេញ » ។
យើងពិតជាគោរពប្រណិប័តន៍ព្រះជាម្ចាស់មែន » ។
ចាប់តាំងពីប៉មហាណា ណែលរហូតដល់ទ្វារកែង ។
នៅ ចុងបញ្ចប់ នៃ ថ្ងៃ អ្នក នឹង អស់ កម្លាំង ។
អ្វីដែលល្អបំផុតដែលត្រូវធ្វើគឺលាតត្រដាង ភាព អយុត្តិធម៌ដែលបានធ្វើមកលើអ្នក ។
ប៉ុន្តែ នេះ នឹង មិន រារាំង យើង ពី ការស្វែងរក និង ផ្តន្ទាទោស ឧក្រិដ្ឋ ជន នោះ ទេ ។
ព្រះអង្គដែលប្រទាន ពរដល់បុព្វបុរសរបស់យើង
ប៉ុន្តែអ្នកមិនអាចធ្វើដូច្នេះបានទេនៅក្រោមច្បាប់ផ្លាស់ ទីលំនៅឋាន ។
ដូច្នេះហើយ វានឹងមិនធ្វើឱ្យ រលាកជើងរបស់អ្នកឡើយ ។
« តើអ្នកគិតថាដោយ សារពួកកាលីឡេទាំងនេះបានរងទុក្ខដោយរបៀបនេះពួកគេជាមនុស្សមាន បាបធំជាងអ្នកកាលីឡេ ឯទៀតឬ ?
ហើយប្រសិនបើពួកគេធ្វើនោះ ពួកគេនឹងត្រូវ លាពួកគេនៅខាងក្រៅទ្វាររបស់យើង។
ក្រោយមក ហោរាបរិសុទ្ធបានសុំឲ្យគាត់ចូលក្នុងសួនយ៉ាង ហោចណាស់បន្ទាប់ពីទទួលបានការ អនុញ្ញាតពីម្ចាស់ ។
គាត់ត្រូវបានគេតែងតាំងនៅខែ កញ្ញា ប៉ុន្តែគាត់បានធ្វើដំណើរប្រហែល ៧ ដង ។
២៧ លោក យ៉ូហានឆ្លើយ ថា៖ « មនុស្សអាចទទួលបាន តែអ្វីដែលបានប្រទាន មកលោកពីស្ថានសួគ៌ ។
ហើយ តាម ការពិត ព្រះទ្រង់ មាន កំហុស ចំពោះ ពួកគេ គាត់មាន ប្រសាសន៍ថា ៖ មើលចុះ ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលថា ថ្ងៃនឹង មកដល់ ពេលដែលយើងនឹងធ្វើសម្ពន្ធ មេត្រីថ្មីជាមួយនឹង វង្សអ៊ីស្រាអែល និងក្រុមគ្រួសារយូដា ។
ម្តាយ របស់ ឡូរ៉ា
អ្នកដែលនៅដៃស្ដាំ - តើមនុស្សនៅដៃស្ដាំនឹងមាន ពរយ៉ាងណា ។
នៅពេលដែលមនុស្សស្អប់អ្នកដែលមិនដូចគ្នា វាក្លាយជាចំណុចទាក់ទាញសម្រាប់ខ្ញុំ » ។
រុក្ខជាតិរបស់អ្នកពិតជាបានមកពីគ្រាប់សត្វស្លាប ហើយក៏ជាគ្រាប់ ធញ្ញជាតិ ។
ពេល ខ្លះ ត្រូវ រំខាន ពួកគេ ។
ខ្ញុំមិនប្រាកដថាគួរឱ្យស្រឡាញ់
« ទៅជាមួយនឹងបុរសទាំងនេះចុះ ប៉ុន្តែអ្នកអាចនិយាយតែអ្វីដែលខ្ញុំប្រាប់អ្នក ប៉ុណ្ណោះ » ។
អញ្ចឹងពេលគេចង់ឃើញទៀត គេ មក រកយើង » ។
ពួកគេផឹកស្រាក្នុងដំណាក់ព្រះ របស់គេ ។
ខ្ញុំ នឹង ព្យាយាម ជាមួយ ពួកគេ ។
កន្លែង ខ្លះ មាន ទីតាំង នៅជិត មនុស្ស ។
ប៉ុន្តែ ព្រះ បានធ្វើការ អស្ចារ្យ ជាច្រើន ។
លុះ រកឃើញហើយក៏សួរថា លោកគ្រូមកដល់ពេលណា ?
11 ហើយអំពី ការ កាត់ ទោស ពីព្រោះម្ចាស់នៃពិភពលោកត្រូវបានកាត់ ទោស ។
បទនេះបើកជាមួយនឹងទំនុកច្រៀងដែល លងបន្លាចថា " មើលឡើងនេះ ខ្ញុំនៅស្ថានសួគ៌ / ខ្ញុំមានស្នាមដែលមិនអាចមើលឃើញ " ។
ពេលកូនចៅអ៊ីស្រា ‌ អែលធ្លាក់ទៅជាទាសករនៅស្រុកអេស៊ីប ទ្រង់បានរំដោះគេឲ្យរួចពីទាសកររបស់ផារ៉ោន ។
ហើយ អ្នក មិន មែន ជា អាកប្បកិរិយា របស់ អ្នកទេ ។
ពួកគេប្រហែលជាមិននៅស្ងៀមចំពោះការ កាត់ទោសដែលស្ថិតនៅលើមនុស្សទាំងអស់ដោយធម្មជាតិ ហើយក៏ប៉ុន្តែពួកគេមិនមែនជាអ្នក បម្រើរបស់ម៉ូសេ ឡើយ ។
ដោយ ពួក ខុង ជឺ នៅសម័យ បច្ចុប្បន្ន ។
យើងមិនដើរតាមនរណាក្រៅពីព្រះយេស៊ូវ គ្រីស្ទទេ ។
សេចក្ដីសញ្ញា ត្រូវ ធ្វើឡើង រវាង ព្រះ និង សហគមន៍ ដែល នៅ សេសសល់ បន្ទាប់ពី ការនិរទេស ខ្លួន ។
តើពួកគេតែងតែមានបញ្ហាក្នុងថ្នាក់រៀន រារាំងដល់ការ សិក្សារបស់ពួកគេឬ ?
លោហៈ ដែល ត្រូវបាន ដឹកជញ្ជូន ( ហើយ ដូច្នេះ ចំនួន ប្រាក់ កម្ចី នីមួយ ៗ )
ខ្ញុំមិនអធិស្ឋានសម្រាប់ តែ ទាំងនេះទេ ប៉ុន្តែក៏សម្រាប់អស់អ្នកដែលជឿលើខ្ញុំតាម រយៈ សាររបស់ពួកគេផងដែរ » ។
ខ្ញុំ ដឹង ប៉ុន្តែ វា ជា ការសង្ស័យ របស់ ខ្ញុំ ផងដែរ !
អាមីបាន ក្រោក ឡើង ។
វា គ្រប់គ្រាន់ ហើយ សម្រាប់ ថ្ងៃ នេះ ខ្ញុំ នឹង បន្ត នៅ ថ្ងៃស្អែក
អ្នក ណាដែលជឿលើខ្ញុំនឹងមានជីវិត ទោះបីគាត់ស្លាប់ក៏ដោយ ។ ហើយ អ្នកណា ដែល រស់ នៅ ហើយ ជឿ លើ ខ្ញុំ នឹង មិន ស្លាប់ ឡើយ » ។
ពួកគេនឹង បង្វែរត្រចៀកចេញពីសេចក្ដី ពិត ហើយបែរទៅរករឿងព្រេងនិទាន › ។
តើយើងសុខ ចិត្តឆ្លុះ បញ្ចាំងពីពេលវេលាបន្តិចដើម្បីបង្ហាញព្រះបន្ទូលរបស់ព្រះ ដូចដែលមាននៅក្នុង បទគម្ពីរ ហើយមានបទពិសោធន៍ក្នុងការ អធិស្ឋានដែរឬទេ ?
ជាកម្មសិទ្ធិរបស់យូដា សម្រាប់អ៊ីស្រាអែល តើពួកគេមិនមានសរសេរនៅក្នុងសៀវភៅរបស់លោកទេ ។
« តើអ្នក រាល់គ្នាចង់ឲ្យខ្ញុំដោះលែងមួយ ណា បារ៉ា បាសអើយ !
គាត់ ក៏ មិន យឺត ក្នុង ការចេញមុខ ជា អ្នកគាំទ្រ ដែរ ។
វិក តូរី យ៉ា៖ ខ្ញុំ ចង់ មើល កន្លែង ដែល គ្រូពេទ្យ បាត់ ។
វា ជា របស់ ខ្ញុំ ដូច្នេះ ខ្ញុំ កំពុង លោភលន់ ។
ហើយបន្ទាប់មកពួកគេបានសុំឱ្យគាត់នៅជាមួយពួកគេជាច្រើនថ្ងៃ។
បន្ទាប់មកពួកគេបានដាក់អន្ទាក់របស់ពួកគេ ហើយឃើញថាពួកគេជាបងប្អូន ។
ខ្ញុំ ស្រលាញ់ ខ្លួន ឯង និង ជីវិត របស់ ខ្ញុំ ។
អ្នក និយាយ ត្រូវ ហើយ ពួកយើង មិន អាច បញ្ឈប់ វា ទាំងស្រុង បាន ទេ ។
នេះ ជារឿងអយុត្តិធម៌សម្រាប់ប្រពន្ធគាត់ ។
" គោលបំណង នៃ កញ្ចប់ គឺ ដើម្បី អនុញ្ញាតឱ្យ អ្នកប្រើ ប្រើ កន្សោម នៅ ខាងក្នុង ការកំណត់ រចនាសម្ព័ន្ធ សម្រាប់ តក្កវិជ្ជា ស្មុគស្មាញ ។
ទម្រង់ នៃ ទិន្នន័យ ឬ ព័ត៌មាន ដែល គាត់ ចង់ ត្រួតពិនិត្យ ។
១៤ ត្បិតយើងមិនបានពង្រីកខ្លួនយើងហួស ហេតុពេក ដូចជាយើងមិនបានទៅដល់អ្នកទេ ចាប់តាំងពីយើងបានមក រកអ្នកដោយដំណឹងល្អនៃព្រះ គ្រីស្ទ ។
ហើយអ្នកខ្លះនៅ តែនិយាយថា “ បើទុកឲ្យខ្លួនឯងគ្មានអ្នក ណាបានរួចទេ ” ។
វា នឹង បើក កម្មវិធី គ្រប់គ្រង ភារកិច្ច ។
ពេលអ្នកដែលនៅជាមួយប្រភពរបស់យើងបានឃើញដូច្នោះក៏វង្វេងស្មារតី ហើយដួលទាំងសង្កៀតធ្មេញ ។
អ្វី ដែល អ្នក គួរ បង្ហោះ ។
ចុះបុណ្យជ្រមុជទឹកឲ្យមនុស្សស្លាប់ ( ដែលមានចែងយ៉ាងច្បាស់នៅក្នុង បទគម្ពីរ ) ?
« គាត់ស្រឡាញ់ មរតកខ្មែរ ហើយបានធ្វើការ ដើម្បីការពារវា » ។
ព្រះ យេស៊ូមាន បន្ទូលថា ‹ ខ្ញុំ ជាផ្លូវ ជាជីវិត និងជាសេចក្ដី ពិត ហើយគ្មានអ្នក ណាអាចមក ឯព្រះវរ បិតាបានឡើយ លើកលែង តែតាម រយៈខ្ញុំ › ។
ពួកសិស្សទូលសួរព្រះអង្គ ថា៖ « លោកគ្រូដែលប្រព្រឹត្តអំពើ បាបលោកនេះ ឬឪពុកម្តាយលោកកើតមកខ្វាក់ ?
ចូលទៅជិត ហើយប្រគល់ក្រណាត់សូត្រឲ្យគាត់
ពេល រសៀល នាង នឹង ត្រលប់ មកវិញ ។
« អ្នកបានរស់ នៅដោយរីករាយនៅលើផែនដីនេះ ហើយមាន ចិត្តលោភលន់ អ្នក បានចិញ្ចឹម ចិត្តរបស់អ្នក ដូចជាថ្ងៃនៃការ សម្លាប់ » ។
អ្នក នឹង ក្លាយជា អ្នកតស៊ូ មតិ របស់ យើង ។
សេចក្តីសម្រេច ស្តីពី ការសូត្រ Surah នៅ ចុងបញ្ចប់ នៃ ការ ដែល មាន ការបូជា នៅក្នុង ការអធិស្ឋាន
អ្នកមាន ចិត្តរាបទាប ហើយត្រៀមខ្លួនជា ស្រេចដើម្បីសុំការ អភ័យទោស ។
ពីមនុស្សស្លាប់ និងព្រហ្មចារីយ៍របស់ស្ត្រីឈ្លើយ សឹក ។
យើង មាន ទឹក ផ្ទាល់ខ្លួន ។
« អ្នកនិយាយថា ព្រះអម្ចាស់បានបោះបង់ខ្ញុំចោល ។
ហើយ ខ្ញុំ នឹង ក្លាយជា ព្រះរបស់ ពួកគេ ។
« ថ្ងៃ នេះគេប៉ុនប៉ងធ្វើ ឃាតខ្ញុំ » ។
នៅ ចុងបញ្ចប់ នៃ ថ្ងៃ នេះ មាន តែ អ្នក ដឹង ពី អ្វី ដែល ល្អ បំផុត សម្រាប់ អ្នក ប៉ុណ្ណោះ ។
យើង នឹង ឃើញ មូលហេតុ នៅ ផ្នែក បន្ទាប់ ។
ក្នុង ពេល ជាមួយគ្នា នេះ ខ្ញុំ ឃើញ ថា មាន មនុស្ស ថ្មី ជាច្រើន បាន បាត់ខ្លួន ពី ភូមិ ជារៀងរាល់ ថ្ងៃ ។
មនុស្ស មាន សិទ្ធិ ទៅ កន្លែង របស់ ពួកគេ ។
មាន ប្រអប់ ថត ឯកសារ ក្នុង ចំណោម ទ្រព្យសម្បត្តិ
« វាអត់មានអីទេ ហើយម្សៅមិនទាន់ឡើងទៀតទេ ។
ហើយយើងជឿ ហើយប្រាកដថាទ្រង់ជាព្រះ ដ៏បរិសុទ្ធនៃព្រះ» ។
នេះ គឺជា ធម្មជាតិ នៃ អំពើ អាក្រក់ ដែល បង្ខូច អ្វី ៗ ទាំងអស់ ។
វា មិន មែន ជា កន្លែង ត្រឹមត្រូវ សម្រាប់ ពួកគេ ទេ ។
ពួកគេជាកូនរបស់ព្រះ ព្រោះពួកគេ ជាអ្នកដែលនឹង រស់ឡើងវិញ ។
ប្រើ អ្វី ដែល អ្នក មាន ក្រសួង ពន្ធនាគារ
អ្នកសម្ភាសន៍ សួរ ថា ហេតុ អ្វី អ្នក ចង់ ធ្វើការ នៅ ទីនេះ ?
“ អ្វីដែលខ្ញុំដឹងគឺថាខ្ញុំបានបាត់ បង់សម្រស់ពីរ
ជារឿយ ៗ ខ្ញុំ មិន ធ្វើឱ្យ អ្នក ជួប ការលំបាក ទេ ។
