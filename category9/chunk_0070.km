( ភ្នំពេញ ) ៖ កម្លាំង ជំនាញ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បាន បង្រ្កាប ករណី កែច្នៃ រក្សាទុក ដឹកជញ្ជូន និង ជួញដូរ សារធាតុ ញៀន ដោយ ឃាត់ខ្លួន ជនល្មើស ចំនួន ៤នាក់ រឹបអូស ថ្នាំ ញៀន ជាង ១៦គីឡូក្រាម និង សារធាតុ គីមី ផ្សំ ជិត ៧០០ គីឡូក្រាម ស្ថិត នៅ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ។
ជា ការគត់ សម្គាល់ រយៈពេល ៣សប្តាហ៍ ចុងក្រោយ នេះ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បង្ក្រាប បាន បទល្មើស គ្រឿង ធំ ចំនួន ៣ករណី ដែល ឧក្រិដ្ឋ ជន ដឹកជញ្ជូន រក្សាទុក ក្នុង បរិមាណ រាប់ រយ គីឡូក្រាម និង បាន ឃាត់ខ្លួន ជនល្មើស ជាច្រើន នាក់ បញ្ជូន ទៅ ផ្តន្ទាទោស នៅ តុលាការ ៕ ក្រសួង ការបរទេស បង្ហាញ លទ្ធផល ឧប នាយក រដ្ឋមន្ត្រី សុខ ចិន្តា សោភា អញ្ជើញ ចូលរួម កិច្ចប្រជុំ សហគ្រិន ហ្វ្រង់ កូហ្វូន (REF) លើក ទី៤
( ភ្នំពេញ ) ៖ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា នៅ ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ លទ្ធផល របស់ ឧប នាយក រដ្ឋមន្ត្រី សុខ ចិន្តា សោភា រដ្ឋមន្រ្តី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ដែល បាន អញ្ជើញ ចូលរួម កិច្ចប្រជុំ សហគ្រិន ហ្វ្រង់ កូហ្វូន (REF) លើក ទី៤ នៅ ទីក្រុង ម៉ារ៉ាកិច កាលពី ថ្ងៃទី ៣០ - ៣១ ខែឧសភា ឆ្នាំ ២២០៤ ។
ព្រះគ្រូ ឃោសានុ រ័ក្ខ មុនី មាស សំណាង អំពាវនាវ ដល់ ពុទ្ធ បរិស័ទ ចូលរួម កម្មវិធី បុណ្យ ផ្កា ប្រាក់ មហាសាមគ្គី និង សម្ពោធ ឆ្លង សៀវភៅ អក្ខរ ក្រម ទស្សនៈ ភាគ ៣
( ភ្នំពេញ ) ៖ សៀវភៅ ឈ្មោះ អក្ខរ ក្រម ទស្សនៈ ភាគ ៣ ជា វណ្ណកម្ម ទី៥ ដែល ជា ស្នាដៃ និពន្ធ និង រៀបរៀង ដោយ ព្រះសាស្ត្រាចារ្យ បេក្ខភាព បណ្ឌិត ព្រះគ្រូ ឃោសានុ រ័ក្ខ មុនី មាស សំណាង ជា ទីប្រឹក្សា ផ្ទាល់ សម្ដេច ព្រះមហា សុមេធាធិបតី នន្ទ ង៉ែត សម្ដេច ព្រះសង្ឃ នាយក នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា អ្នក ស្ថាបនិក គណៈ ធម្មយាត្រា ព្រះត្រៃរតន៍ និង ជា ព្រះប្រធាន កម្មវិធី បុណ្យ ផ្កា ប្រាក់ មហាសាមគ្គី ។
ព្រះពុទ្ធ សាសនា ដើម្បី សន្ដិភាព សង្គម មាន សទ្ធា ជ្រះថ្លា បាន ចំណាយ ពេលវេលា ដែល មាន ទាំង ប៉ុន្មាន តាម លទ្ធភាព ដែល អាច ធ្វើ បាន ព្យាយាម ខិតខំ ស្រាវជ្រាវ និពន្ធ និង រៀប រៀង សៀវភៅ អក្ខរ ក្រម ទស្សនៈ ភាគ ៣ ចែកជូន ជាធម្មទាន ចំនួន ១០០០ ច្បាប់ សម្រាប់ ជា ប្រយោជន៍ តបគុណ ជូន ជាតិ និង ព្រះពុទ្ធ សាសនា ។
បើ យើង និយាយ ពី ក្រុង បូក គោ ឬ ឧទ្យាន ជាតិ ព្រះមុនីវង្ស គេ នឹង នឹក ដល់ អាកាសធាតុ ដ៏ សែន ត្រជាក់ និង ជា ទី មនោរម្យ សម្រាប់ សម្រាក លម្ហែ អារម្មណ៍ បាន យ៉ាង ល្អ ប្រសើរ ។ ក្រៅតែ ពី ភាព អំណោយផល ពី ធម្មជាតិ នៅលើ កំពូល ភ្នំ បូកគោ ក៏ មាន ដែរ អគារ កេរ ដំណែល ប្រវត្តិសាស្រ្ត ដែល បាន បន្សល់ទុក តាំងពី សម័យ ព្រះបាទ ស៊ីសុវត្ថិ មុន្នី វង្ស . សម័យ អាណានិគមន៍ បារាំង និង សម័យ សង្គម រាស្រ្ត និយម ។
នៅពេល បច្ចុប្បន្ន នេះ អ្នក ឧកញ្ញ៉ា សុខ គង់ ក៏ កំពុង កសាង នូវ ព្រះពុទ្ធ បដិមារ ដែល មាន កម្ពស់ រហូតដល់ទៅ ១០៨ ម៉ែត្រ ដែល នឹង ក្លាយជា ព្រះពុទ្ធរូប ដែល មាន កម្ពស់ ខ្ពស់ ជា គេ នៅ អាស៊ី ព្រម ជាមួយ ព្រះពុទ្ធ បដិមា តូច ៗ ចំនួន ៨. ៤០០០ ព្រះអង្គ ថែម ទៀត ដែល តំណាង ឲ្យ ព្រះត្រៃបិដក ដែល មាន ចំនួន ៨. ៤០០០ ព្រះធម្មក្ខន្ធ ។
អ្នក ឧកញ្ញ៉ា សុខ គង់ បាន បញ្ជាក់ ដូច្នេះ ថា៖ « ការសម្រេច កសាង ព្រះពុទ្ធ បដិមា នេះ ក៏ ព្រោះតែ ប្រទេស កម្ពុជា ជា ប្រទេស គោរព នូវ ព្រះពុទ្ធ សាស ហើយ ព្រះពុទ្ធ សាសនា ក៏ ជា សាសនា មួយ ដែល មនុស្ស ជាច្រើន នៅលើ ពិភពលោក បាន គោរព និង ប្រតិបត្តិ ផងដែរ » ។
បើ តាម ការបង្ហាញ ពី លោក ធឿន ប៊ុន ថន ប្រធាន ផ្នែក លក់ នៃ សណ្ឋាគារ សុខា បាន ឲ្យដឹង ថា ក្នុង តំបន់ ដែល កម្កល់ ព្រះពុទ្ធរូប នេះ ក៏ មាន ដែរ នូវ ទី សក្ការៈបូជា ដូចជា ល្អាង ទឹក អម្រឹត ស័ក្តិសិទ្ធិ និង ទីតាំង សមាធិ ដែល ជា កន្លែង ដែល ពេញនិយម ជាង គេ គឺ ស្ថិត នៅក្នុង តំបន់ វាល ស្រែ ៥០០ និង ប្រវាំង កូន ។ ការបញ្ជាក់
តំបន់ វាល ស្រែ៥០០ គឺជា ទីកន្លែង សមាធិ តាំងពី បុរាណ បែរ មុខ ចំលំហូរ នៃ ខ្យល់ បក់ ចេញ ពី ខ្នងភ្នំ រាប់ រយ តភ្ជាប់ តាំងពី ខេត្ត កំពង់ស្ពឺ រហូតដល់ ខេត្ត កំពត ធ្វើឲ្យ គុណ ភាព ខ្យល់ ពោរពេញ ទៅ ដោយ អុកស៊ីហ្សែន យ៉ាង ល្អ សម្រាប់ ស្រូប ដង្ហើម ចេញ / ចូលក្នុង សួត ។ ក្រុម ភ្ញៀវ ទេសចរ ដែល និយម ចូលចិត្ត និង មាន ជំនឿរ លើ ការតាំង សមាធិ ភាពស្ងប់ស្ងាត់ ជាមួយ ធម្មជាតិ កាត់បន្ថយ ស្ត្រេស និង ភាពតានតឹង ផ្សេង ៗ ពួកគាត់ តែងតែ មក ទីនេះ ជាប្រចាំ ។
ដើម្បី ជ្រាប កាន់តែ ច្បាស់ សូម ទស្សនិកជន ទស្សនា កិច្ចសម្ភាសន៍ ទាំងស្រុង ដូចតទៅ៖ លោក ហេង សួរ និង ប្រធាន សភា ពាណិជ្ជកម្ម អាមេរិក នៅ កម្ពុជា ប្តេជ្ញា រួមគ្នា បង្កើន ផលិតភាព ការងារ សម្រាប់ ទាក់ទាញ ការវិនិយោគ បន្ថែម
បន្ថែម ពី នេះ លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ទៅកាន់ សមភាគី ផងដែរ ថា ដើម្បី បង្កើន ផលិតភាព ការងារ របស់ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ប្រសើរ បន្ថែម ទៀត ក្នុង ការបំពេញ តម្រូវការ ជូន វិស័យ ឯកជន នោះ គឺ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដែល ជា សេនាធិការ របស់ រាជ រដ្ឋាភិបាល បាន ផ្តល់ ការបណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស វិជ្ជាជីវៈ ទៅដល់ ប្រជាពលរដ្ឋ ទាំង អ្នក មិន ទាន់ មាន ការងារ ធ្វើ និង អ្នក ដែល កំពុង ប្រកប ការងារ អាច ចូល សិក្សា បាន តាម វេន សិក្សា ដែល មាន ភាពបត់បែន ។
ទន្ទឹមនឹង នេះ ភាគី ទាំង ពីរ បាន ឯកភាព រួមគ្នា ជំរុញ ការអភិវឌ្ឍ ជំនាញ ថ្មី ៗ នៅ កម្ពុជា ដែល ទីផ្សារ កំពុង ត្រូវការ បន្ថែម ទៀត ដើម្បី បង្កើន ផលិតភាព ការងារ ឱ្យ ស្រប ទៅតាម តម្រូវ ការចាំបាច់ ក្នុង ទីផ្សារ ដែល កំពុង ប្រកួតប្រជែង និង ដើម្បី ទាក់ទាញ ការវិនិយោគ ធំ ៗ មកកាន់ កម្ពុជា ។ ជាមួយគ្នា នេះ លោក រដ្ឋមន្ត្រី បាន សង្កត់ធ្ងន់ ថា ភាពជោគជ័យ របស់ សភា ពាណិជ្ជកម្ម អាមេរិក ប្រចាំ នៅ កម្ពុជា គឺជា អ្វី ដែល ក្រសួង ផ្ទាល់ ក៏ ដូចជា រាជ រដ្ឋាភិបាល ចង់បាន ៕
លោក ខាន់ ត្រូវបាន ចាប់ខ្លួន កាលពី ខែឧសភា បន្ទាប់ពី តុលាការ កាត់ទោស លោក ឱ្យ ជាប់ ពន្ធនាគារ រយៈពេល ៣ ឆ្នាំ ពី បទ ពុករលួយ ។ លោក ក៏ ត្រូវបាន កាត់ទោស ឱ្យ ជាប់ ពន្ធនាគារ រយៈពេល ១០ឆ្នាំ ទៀត ពី បទ លួច លាក់ ឯកសារ រដ្ឋ កាលពី ដើម ឆ្នាំ នេះ ។
ការសម្រេច របស់ តុលាការ ក្នុង ការទម្លាក់ ការចោទប្រកាន់ លោក ខាន់ ពី បទ លួច លាក់ ឯកសារ រដ្ឋ នេះ គឺជា ជ័យជម្នះ មួយ សម្រាប់ អតីត នាយក រដ្ឋមន្ត្រី រូប នេះ និង គណបក្ស របស់ លោក ។ ទោះជា យ៉ាងណា ក៏ដោយ លោក នៅតែ ជាប់ ពន្ធនាគារ ហើយ មិន ទាន់ អាច ចូលរួម ក្នុង ការបោះឆ្នោត ជាតិ ដែល គ្រោង នឹង ធ្វើឡើង នៅ ដើម ឆ្នាំ ក្រោយ នៅឡើយ ទេ ៕ ឧកញ៉ា តែ តាំង ប៉ ចូល ជួប សម្ដែង ការគួរសម ជាមួយ ឧប នាយក រដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល
