ការ ធ្លាក់ភ្លៀងនេះបានសម្លាប់មនុស្ស ១៨នាក់។
ដើម្បី សម្លាប់ មនុស្ស ។
ព្រោះ ខ្ញុំ ជា អ្នក បំរើ របស់ អ្នក ។
" បន្ទាប់មកពួកគេបានទៅរៀននៅវិទ្យាល័យហើយបន្ទាប់មកពួកគេបានចូលរៀននៅ មហាវិទ្យាល័យ ... តើមានអ្វីកើតឡើង បន្ទាប់ពីម៉ាក់ ? "
ខ្ញុំចង់ធ្វើឱ្យមាន ភាពខុសគ្នាច្រើនជាងដែលខ្ញុំកំពុងធ្វើនៅថ្ងៃនេះ ។
ខ្ញុំ នឹង ពេញចិត្ត គាត់ ជារៀងរាល់ ថ្ងៃ ។ "
« មាន ពរហើយអ្នក ណាដែលការ រំលងត្រូវបានអត់ទោស ហើយអំពើ បាបត្រូវបានបិទ បាំង » ។ — ទំនុក ដំកើង ៣២: ១
មនុស្ស ជាច្រើន មិន ដឹង ថា ខ្ញុំ ជា មនុស្ស ស្អាតស្អំ ។
ខ្ញុំនឹងប្រាប់មនុស្សថាខ្ញុំនៅក្មេងមើលទៅអាយុ 80 ឆ្នាំ។
កូនប្រុស ទាំង ពីរ របស់ គាត់ បាន ដើរ តាម គន្លង របស់ គាត់ ។
ហើយនៅពេលដែលដំណើរការ ហួសកម្រិត ពួកវាបាត់បង់ថាមពលព្យាបាល ហើយអ្នក ប្រហែលជាកំពុងធ្វើ បាបច្រើនជាងល្អ » ។
ខ្ញុំដាក់សម្ពាធខ្លាំងលើកុមារ ។
ចុះបើកូនរត់ចេញពីផ្ទះធ្វើម៉េច ?
២ សាំ យូអែល 7:5 « ចូរទៅប្រាប់ដាវីឌ ជាអ្នក បម្រើរបស់យើងថា ព្រះ‌ អម្ចាស់មានព្រះ‌បន្ទូលដូច តទៅ : « តើអ្នកគួរ សង់ផ្ទះឲ្យខ្ញុំជា ទីលំនៅរបស់ខ្ញុំឬ ?
ពេញ មួយ ជីវិត នៃ ការបម្រើ នៅក្រោម សហភាព អឺរ៉ុប ។
ដូចជាស្នាដៃនិស្សិតក្មេង ៗទាំងអស់គ្នាគួរឱ្យស្រឡាញ់ !
ខ្ញុំ សាទ រ ចំពោះបារ៉ាក់ អូបាម៉ា ។
ការប្រគុំតន្ត្រី ក៏ មាន បទភ្លេង ដំបូង របស់ អ្នកនិពន្ធ ផងដែរ ។
ពេល បន់ស្រន់ កុំ ប្រើ ពាក្យ អសុរស ច្រើន ដូច អ្នក មិន ជឿ ដែល គិត ថា ព្រះរបស់ គេ នឹង ស្តាប់ ព្រោះ ការអធិស្ឋាន របស់ គេ មាន រយៈពេល យូរ ។
“ ពេលយើងធ្វើបែបនេះ យើងកំពុងជួយអ្នក រាល់គ្នា ។
ពួកគេ បាន មកពី ជួរ នៃ
ពួកគេបានលះបង់ខ្លួនទៅនឹងការ បង្រៀនរបស់ពួកសាវ័ក និងការ ប្រកបដោយការ ប្រកបដោយការ កាច់នំបុ័ង និងការ អធិស្ឋាន ។
ប៉ុន្តែសម្រាប់ជាប្រយោជន៍របស់ព្រះ សូមប្រាកដថាគាត់បានអាស្រ័យលើវា ។
ចាប់ពី ថ្នាក់ ទី ប្រាំពីរ នឹង ច្រៀង ។
ធ្វើ ទាហាន រយៈពេល ប្រាំបី ខែ ។
សម្រាប់មួយ ខ្ញុំមិនចង់ពាក់ព័ន្ធនឹងរឿងពន្ធទេ ។
កូនយើងមិនដឹងថាប៉ាម៉ាក់បារម្ភប៉ុណ្ណាទេ !
ខ្ញុំមិនដែល ឮនរណាម្នាក់ក្នុងក្រុមនោះនិយាយអ្វីអំពីរឿងនោះទេ » ។
ដូច្នេះ ខ្ញុំបានធ្វើផែនការ មួយចំនួន ។
ទ្រនុង ដ៏ មាន សំណាង ដែល បាន បញ្ឈប់ ការដួលរលំ របស់ គាត់ ហាក់ដូចជា គាត់ មិន មែន ជា ហេតុផល គ្រប់គ្រាន់ សម្រាប់ ពួកគេ ក្នុង ការសម្រេច ថា គាត់ គឺជា ព្រះដែល ចាប់កំណើត ឡើង វិញ នោះ ទេ ។
ឥឡូវនេះ ការកំណត់ គឺ ស្អាត ជាង មុន ។
ដើម្បី អាច អភិវឌ្ឍ ការងារ ជា ក្រុម ។
« ខ្ញុំមិនស្គាល់ព្រះអម្ចាស់ទេ ហើយខ្ញុំនឹងមិនអនុញ្ញាតឲ្យអ៊ីស្រាអែលទៅឡើយ » ។
ទោះបីជា ខ្ញុំ ទើបតែ ឃើញ ម៉ោង ចុងក្រោយ នៃ កិច្ចប្រជុំ នេះ ក៏ដោយ ខ្ញុំ នឹង បង្ហោះ មតិ យោបល់ ទាំងនេះ ដូច ដែល ធ្លាប់ មាន ។
« ព្រះអម្ចាស់ ទូលបង្គំសុខ ចិត្តទៅជាមួយនឹងទ្រង់ទៅក្នុងគុក និងស្លាប់ » ។
រ៉ូម 9:10 មិនត្រឹម តែប៉ុណ្ណោះ កូនរបស់រេបិកាក៏មានឪពុក តែមួយដែរ គឺអ៊ីសាក ជាឪពុករបស់យើង ។
ពេល ខ្លះ ពេល ខ្លះ អ្នក នឹង ភ័យខ្លាច ។
ព្រះ‌ អម្ចាស់ធ្វើឲ្យព្រះ‌បាទផារ៉ោន ជាស្ដេចស្រុកអេស៊ីបរឹង ‌រូស ដូច្នេះ ព្រះអង្គក៏ដេញតាមជន ‌ជាតិអ៊ីស្រា ‌ អែល ដែលនៅ សល់ដោយកណ្តាប់ដៃទាំងកំហឹង ។
បន្ទាប់ពី អ្នក កើត ។
ហើយ ខ្ញុំ សូម ប្រាប់ អ្នក ថា ខ្ញុំ ដឹង គុណ ចំពោះ សេចក្តីស្រឡាញ់ ដែល ខ្ញុំ ទទួលបាន ពី អ្នកអាន របស់ ខ្ញុំ ។
មនុស្ស គ្រប់ គ្នា និយាយ អំពី ការិយាធិបតេយ្យ នៅ ប្រទេស បារាំង ។
ការជួសជុល តែ មួយ គត់ ចំពោះ ការវង្វេង គឺ ភាព ល្អ និង ព្រះគុណ របស់ ព្រះ។
សមស្រប សម្រាប់ បក្សី ។
ដើម្បី ស្វែងយល់ ពី ភាពត្រឹមត្រូវ នៃ ការទាមទារ របស់ ពួកគេ អ្នក គួរតែ សួរ ពួកគេ នូវ សំណួរ ខាងក្រោម៖
បាទ យើងត្រូវបានគេវាយបំបែក ។
យើង កំពុង រង់ចាំ មើល ថា តើ ការចុះឈ្មោះ ត្រូវបាន ប្រើប្រាស់ ។
អ៊ីមែល របស់ មិត្ត របស់ អ្នក ។
សូមយកវាចេញឲ្យឆ្ងាយពីគាត់ ហើយជួយគាត់ឲ្យបានជា សះស្បើយ និងមានសុភមង្គល ។
អាក្រក់បំផុតគឺគេនឹងយកអ្នកមិនចូលចិត្តមកវាយអ្នកក្នុងភក់ ។
តើធ្វើ ដូចម្តេចពេលជួបរឿងនេះ ?
« តើអ្នកដឹងទេថាហេតុ អ្វីបានជាព្រះយេស៊ូវ សុគតលើឈើ ឆ្កាង?
« ខ្ញុំនឹងមិនបោះបង់ចោលការ ស្វែង រកយុត្តិធម៌ឲ្យកូនប្រុសខ្ញុំឡើយ » ។
ខ្ញុំ សង្ឃឹម ថា នឹង មាន អ្នក សរសេរ ប្លុក ភ្ញៀវ មួយចំនួន ។
ត្រូវបាន បង្កើតឡើង ដោយ ។
កុំវង្វេងចេញពីព្រះ‌ អម្ចាស់ ។
អ្នកជាប់ឃុំ ៦០០នាក់ត្រូវបានដោះលែង
ញ៉ាំ អាហារ ពេលព្រឹក នៅ ពាក់កណ្តាល ថ្ងៃត្រង់
មាន កម្មវិធី ដែល មាន កម្មសិទ្ធិ ដែល អ្នក មិន អាច រស់ នៅ ដោយ គ្មាន បាន ។
ពួកគេ ចាប់ផ្តើម លង់ ស្នេហ៍ ។
ទុក សម្រាប់ បង្ហាញ អំណោយ ,
« ខ្ញុំធ្លាប់លាក់ថាឪពុកខ្ញុំជាប់គុក ។
« ដូចគ្នាដែរ ប្ដីត្រូវស្រឡាញ់ប្រពន្ធដូចរូបខ្លួន ។
ហើយ នាង កំពុង ស្វែងរក នរណា ម្នាក់ ដើម្បី ចែចង់ ។
ចុះបើគេជឿថាគេនឹង ប្រែក្លាយទៅជាព្រះ ដោយខ្លួនឯង ពេលស្លាប់ទៅ ហើយគ្រប់គ្រងលើភពផែនដីរបស់គេ ?
RSVP មិន ត្រូវបាន ទាមទារ សម្រាប់ ព្រឹត្តិការណ៍ ថ្ងៃសុក្រ ទេ ។
គ្រួសារជនរងគ្រោះចូលរួមក្នុងការប្រហារជីវិត ។
មាន វិធី ជាច្រើន ក្នុង ការប្រាប់ បុរស ឱ្យដឹង ថា អ្នក យកចិត្តទុកដាក់ ចំពោះ គាត់ ហើយ ការធ្វើឱ្យ គាត់ ពេញចិត្ត ជាមួយនឹង អំណោយ គឺ ច្បាស់ ណាស់ មួយ ក្នុង ចំណោម ពួកគេ ។
អ្នក នឹង ត្រូវការ អ្នក បង្កើត គេហទំព័រ ដែល នឹង អាច ចែកចាយ គេហទំព័រ ក្នុង រយៈពេល ជាក់លាក់ ណាមួយ ។
ផែនការ គឺ ដើម្បី ជួយ ឱ្យ នាង គ្រប់គ្រង បាន ប្រសើរ ជាង មុន ។
គាត់បានជ្រើសរើសពេលវេលាដ៏ត្រឹមត្រូវដើម្បីអនុញ្ញាតឱ្យអំណាចរបស់ គាត់ កាន់កាប់។
លោកថា លោកមិនដឹងថាគណបក្សប្រជាធិបតេយ្យនៅឯណាទេ ។
ខ្ញុំគិតថាវាមិនល្អទាល់ តែសោះ ចូរគិតវិជ្ជមាន !
អ្នក គឺជា អ្នក ដែល ធ្វើ ការអះអាង ជា វិជ្ជមាន ( បង្កាច់បង្ខូច ) បន្ទុក ភស្តុតាង គឺ ស្ថិត នៅលើ អ្នក ។
ទទួល រង្វាន់ ពី អំពើ ទុច្ចរិត របស់ គាត់ ។
ខ្ញុំនិយាយដូច្នេះ ព្រោះអ្នកអះអាងថាខ្ញុំដេញអារក្ស ដោយបេល សេប៊ូប បេល សេប៊ូល ។
ត្រូវតែ មាន ពេលវេលា ដើម្បី មើល ផ្លូវ របស់ ពួកគេ ។
« កាលទ្រង់ចាត់បណ្ដាជនចេញទៅហើយ ទ្រង់ក៏ឡើងទៅលើភ្នំដាច់ដោយ ឡែកដើម្បីអធិស្ឋាន លុះដល់ល្ងាច ទ្រង់គង់នៅ ទីនោះតែឯង » ( ម៉ាថា យ ១៤: ២៣) ។
« តែងតាំងស្ដេចលើយើង ដូច សាសន៍ ដទៃមាន » ។
សុភាពបុរស ម្តង ទៀត ប៉ុន្តែ ខ្ញុំ ដឹង ថា សម្តេច ជាច្រើន
ខ្ញុំ សង្ឃឹម ថា នឹង ស្លាប់ មុន ពេល នោះ ។
បាន ជួយ ខ្ញុំ យ៉ាង ឆាប់រហ័ស ។
ជីវិតរបស់ពួកគេស្ថិតក្នុងគ្រោះថ្នាក់ដល់ជីវិត » ។
« តម្លៃប្រជាធិបតេយ្យគឺជា ភាពមិនប្រាកដប្រជា » ។
ហើយអ្នកមិនចង់ឱ្យពួកគេខក ចិត្តនឹងរបៀបដែលពួកគេបានអនុវត្ត។
ប៉ុន្តែនៅពេល ណាមួយ តើនរណានឹងដាំអាហាររបស់យើង ?
នេះ ជា អ្វី ដែល ប្រាជ្ញា បង្រៀន យើង ។
នាងបាននិយាយថា៖ « យើងមកទីនេះជារៀងរាល់ឆ្នាំ ហើយយើងទាំងអស់គ្នាមកជួបជុំមិត្តភ័ក្ដិ ។
ប៉ុន្តែ គេមិនបាន សង់ព្រះដំណាក់របស់ព្រះអម្ចាស់ឡើងវិញទេ ។
ព្រះគុណ៖ គាត់ នៅ ជាមួយ យើង ។
ក្នុងការ ចងចាំដល់ទេវតាជា ទី ស្រឡាញ់របស់យើងទាំងអស់ដែលបានឆ្លងកាត់...
ឬរឿងមួយកន្លះជាមួយមេឃនឹងល្អជាង ?
សរសេរ ការណែនាំ ទាំង នេះ ដើម្បី ពិភាក្សា ជាមួយ ពួកគេ នៅ ពេល ក្រោយ ។
អ្នក មិន បាន ស្គាល់ ព្រះទេ ។
អ្នកគួរតែបង្ហាញដល់ពួកគេនូវទស្សនៈរបស់អ្នក ចំពោះអ្វីដែលនៅ សល់ ។
« ដូច្នេះ ពួកគេ នៅ ចំពោះ បល្ល័ង្ក របស់ ព្រះជាម្ចាស់ ហើយ បម្រើ ទ្រង់ ទាំង ថ្ងៃ ទាំង យប់ នៅក្នុង ព្រះវិហារ របស់ ទ្រង់ ហើយ អ្នក ដែល អង្គុយ លើ បល្ល័ង្ក នឹង ផ្តល់ ជម្រក ដល់ ពួកគេ ដោយ វត្តមាន របស់ ទ្រង់ ។
« ប៉ុន្តែ ភីលីពបានឃើញខ្លួនគាត់នៅក្រុងអាហ្សូស ហើយពេលគាត់ដើរកាត់ គាត់បានផ្សាយដំណឹងល្អដល់គ្រប់ក្រុងរហូតដល់គាត់ មកដល់ក្រុងសេសារា » ។
ខ្ញុំប្រាប់គាត់ឲ្យផ្ញើសារមកខ្ញុំ បើគាត់មកស្រុកខ្ញុំ ។
ម៉្យាង វិញ ទៀត ខ្ញុំ មានអារម្មណ៍ ថា ត្រូវ សរសេរ ។
ការសប្បាយ គឺជា អំពើ បាប ប៉ុន្តែ អំពើ បាប គឺជា សេចក្តីរីករាយ ។
