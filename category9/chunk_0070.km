( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តី ជូនដំណឹង អំពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា សម្រាប់ ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ ។
ក្រសួង បញ្ជាក់ ថា សម្ពាធ ទាប គ្របដណ្ដប់ មក លើ ឈូង សមុទ្រ ថៃ ព្រះរាជាណាចក្រ កម្ពុជា ភាគ កណ្តាល នៃ អាង ទន្លេ មេគង្គ និង សមុទ្រ ចិន ខាងត្បូង ។ ស្ថានភាព បែប នេះ នឹង ធ្វើ ឱ្យ៖ ចាប់ពី ថ្ងៃទី៤ ដល់ ថ្ងៃទី ៦ ខែមិថុនា ឆ្នាំ ២០២៤៖ លោក ចាយ បូរិន និង គណៈ សង្ឃ នាយក ប្រគេន ព្រះបរម អដ្ឋិ សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស ជូន អង្គការ សន្និសីទ ពុទ្ធសាសនា ពិភពលោក
បន្ទាប់ពី ដង្ហែរ ព្រះបរម អដ្ឋិ សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ពី វាល ព្រះមេរុ មុខ វត្ត បុទុមវតី រាជ វរា រាម ឆ្ពោះ មក វត្ត ឧណ្ណាលោម និង មួយចំណែក បាន ដង្ហែ ព្រះអង្គារ យក ទៅ បំប្លែង ក្នុង ទន្លេ ចតុមុខ មង្គល បាន ធ្វើឱ្យ ប្រជារាស្ត្រ ខ្មែរ រន្ធត់ ចិត្ត ក្តុកក្តួល សោកស្តាយ អាឡោះអាល័យ ជា ទីបំផុត ចំពោះ ការបែក ឃ្លាត ជា លើក ចុងក្រោយ ដែល គ្មាន ថ្ងៃ ជួប វិញ ។
សម្ដេច ព្រះពោធិវ័ង្ស កិត្តិបណ្ឌិត មាន ព្រះថេរ ដីកា ថា ការលះបង់ ដែល ស្ទើរ ពេញ មួយ ព្រះជន្ម វស្សា របស់ សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រកបដោយ ព្រះព្រហ្មវិហារ ធម៌ ព្រះសច្ចធម៌ និង ព្រះគុណធម៌ ដ៏ ខ្ពង់ខ្ពស់ ព្រមទាំង បាន ផ្សព្វផ្សាយ ព្រះធម៌ បរិសុទ្ធ ដល់ ពិភពលោក ជា សមាជិក ស្ថាបនិក និង ជា ព្រះអនុប្រធាន នៃ ជំនួប កំពូល ពុទ្ធសាសនា ដែល សម្តេច បាន យាង ក្នុង ជំនួប លើក ដំបូង ក្នុង ទីក្រុង តូក្យូ ប្រទេស ជប៉ុន នា ឆ្នាំ ១៩៩៨ ។
លោក ចាយ បូរិន បាន មានប្រសាសន៍ ថា ក្រោម ការយកចិត្តទុកដាក់ ដ៏ ខ្ពង់ខ្ពស់ បាន ធ្វើឲ្យ ព្រះពុទ្ធ សាសនា នៅ កម្ពុជា មាន ការរីកចម្រើន យ៉ាង ខ្លាំង ក្រោម ដំបូង សុខ សន្តិភាព ដែល ជា ការខិតខំ ប្រឹងប្រែង របស់ សម្តេច អគ្គ មហាស សេនា បតី តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្រ្តី បាន ដឹកនាំ នាវា កម្ពុជា ពី គ្មាន សាសនា មក មាន សាសនា យ៉ាង ច្រើន នៅ កម្ពុជា ហើយ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ ដែល មាន សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន កំពុង បន្ត នូវ បេសកម្ម ដ៏ ជ្រះថ្លា នេះ ។
ព្រះគុណ បំណាច់ ព្រះកិត្តិយស និង ព្រះមហា ករុណា ទិគុណ ដ៏ ធំធេង របស់ សម្តេច ព្រះអម្ចាស់ ដែល ស្ទើរតែ ពេញ មួយ ព្រះជន្ម វស្សា បាន បំរើ ជាតិ សាសនា និង ព្រះមហាក្សត្រ ទាំង ក្នុង អាណាចក្រ និង ពុទ្ធ ចក្រ លើក តម្កើង តម្លៃ ព្រះពុទ្ធ សាសនា ប្រកបដោយ សទ្ធា ជ្រះថ្លា ខ្ពង់ខ្ពស់ និង ឧត្តុង្គឧត្តម តាមរយៈ សកម្មភាព ព្រះពុទ្ធ សាសនា នានា ដរាប បាន ក្លាយជា ព្រះនិមិត្តរូប ដ៏ ល្អ បរិសុទ្ធ ឧត្តុងឧត្តម នៃ ឯកភាព ជាតិ និង និរន្តរភាពជាតិ ជា គំរូ ក្នុង ការប្រតិបត្តិ និង ផ្សព្វផ្សាយ ព្រះធម៌ ព្រះពុទ្ធ លើ សកលលោក ។
ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ប្រជាពុទ្ធ បរិស័ទ ទាំង ក្នុង និង ក្រៅ ប្រទេស ញាតិ ព្រះធម៌ គ្រប់ ទិសទី សូម បួងសួង ឧទ្ទិស ថ្វាយ នូវ មហា រាជ កុសល ដ៏ ខ្ពង់ខ្ពស់ ថ្វាយ ចំពោះ ដួង ព្រះវិញ្ញាណក្ខន្ធ ព្រះបរម សព សម្តេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្តេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ព្រះគោរមងារ ដ៏ ខ្ពង់ខ្ពស់ ជា " មហាវីរសង្ឃ សិរី ធម្មរាជ " សូម ព្រះវិញ្ញាណក្ខ័ន្ធ ព្រះអង្គ បាន យាង គង់ ប្រថាប់ ក្នុង ទី ឋាន ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ព្រះបរម សុខ កុំបី អាក់ ខាន ឡើយ ។
លោកស្រី បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក ឧកញ៉ា លោក លោកស្រី មន្ទីរ អង្គភាព កងកម្លាំងប្រដាប់អាវុធ អាជីវករ ពាណិជ្ជករ និង សប្បុរសជន ដែល មាន សទ្ធា ជ្រះថ្លា បរិច្ឆា គ ថវិកា ជូន សាខា និង បាន សន្យា ថា នឹង យក ថវិកា ទាំងនេះ ទៅ ប្រើប្រាស់ ចាត់ចែង និង ជួយ ទ្រទ្រង់ សកម្មភាព មនុស្សធម៌ ឆ្លើយតប ទាន់ ពេលវេលា ទៅនឹង តម្រូវ ការចាំបាច់ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ប្រការ ផ្សេង ៗ ទៅ តាម គោល ការ ច្បាស់លាស់ និង ចំ គោលដៅ ប្រកបដោយ ប្រសិទ្ធភាព និង តម្លាភាព ។
ក្រុម អ្នកជំនាញ បាន និយាយ នៅក្នុង សេចក្តីថ្លែងការណ៍ របស់ ពួកគេ ថា « ការទទួលស្គាល់ នេះ គឺជា ការទទួលស្គាល់ ដ៏ សំខាន់ មួយ ចំពោះ សិទ្ធិ របស់ ប្រជាជន ប៉ាឡេស្ទីន និង ការតស៊ូ និង ការរងទុក្ខ របស់ ពួកគេ ក្នុង ការស្វែងរក សេរីភាព និង ឯករាជ្យ » ។
ក្រុម អ្នកជំនាញ បាន សង្កត់ធ្ងន់ ថា ប៉ាឡេ ស្ទីន ត្រូវតែ អាច ទទួលបាន សិទ្ធិ កំណត់ ដោយ ខ្លួន ឯង ពេញលេញ រួមទាំង « សមត្ថភាព ក្នុង ការកំណត់ ជោគវាសនា ផ្ទាល់ខ្លួន និង អភិវឌ្ឍ ដោយ សេរី ជា ប្រជាជន ដែល មាន សុវត្ថិភាព និង សន្តិសុខ » ។
ពួកគេ បាន សង្កត់ធ្ងន់ ថា « នេះ គឺជា លក្ខខណ្ឌ មុន សម្រាប់ សន្តិភាព យូរអង្វែង សម្រាប់ ប៉ាឡេស្ទីន និង ទូទាំង តំបន់ មជ្ឈិមបូព៌ា » ហើយ ពួកគេ បាន និយាយ ថា វា ចាប់ផ្តើម ដោយ ការប្រកាស ភ្លាម ៗ នៃ បទ ឈប់ បាញ់ នៅក្នុង តំបន់ ហ្គាហ្សា និង គ្មាន ការឈ្លានពាន យោធា បន្ថែម ទៀត ចូល ទៅក្នុង ទីក្រុង រ៉ាហ្វា (Rafah) ឡើយ ។
ក្រុម អ្នកជំនាញ បាន ស្វាគមន៍ ការទទួលស្គាល់ ថ្មី ៗ នៃ រដ្ឋ ប៉ាឡេស្ទីន ដោយ ប្រទេស ន័រវេស អៀរឡង់ និង អេស្ប៉ាញ ។ ពួកគេ បាន និយាយ ថា « ទោះបីជា ការរំពឹងទុក នៃ សន្តិភាព ពិត ប្រាកដ និង ការបញ្ចប់ ការកាន់កាប់ នៅតែ មិន អាច សម្រេចបាន ចាប់តាំងពី កិច្ចព្រមព្រៀង Oslo ជាង ៣០ ឆ្នាំ មក នេះ ក៏ដោយ ក៏ ដំណោះស្រាយ នយោបាយ មិន គួរ ត្រូវបាន ចាត់ទុក ថា ជា រឿង ដែល មិន អាច កើតមាន ឡើយ » ។
ក្រុម អ្នកជំនាញ បាន និយាយ ថា « ដំណោះស្រាយ រដ្ឋ ពីរ នៅតែ ជា មាគ៌ា តែ មួយ គត់ ដែល បាន ឯកភាព គ្នា នៅលើ ឆាក អន្តរជាតិ ដើម្បី សន្តិភាព និង សន្តិសុខ សម្រាប់ ទាំង ប៉ាឡេស្ទីន និង អ៊ីស្រាអែល និង ជា ផ្លូវ ចេញ ពី វដ្ត នៃ អំពើហិង្សា បន្ត ជំនាន់ » ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០២៤ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១១៥. ៣១៦. ៨២៤ នាក់ ។ ក្នុង នោះ រួម មាន៖
សេព គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គម ! បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៣ ខែមិថុនា៖ បង្ក្រាប ២៣ករណី ឃាត់ខ្លួន ៤៤ នាក់
( ភ្នំពេញ ) ៖ ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៣ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៤៤ នាក់ ។
ក្នុង ជំនួប នេះ លោក រដ្ឋមន្ត្រី បាន ពិភាក្សា អំពី កិច្ចការ សិក្សា គម្រោង រៀបចំ មហោស្រព តន្ត្រី អូប៉េរ៉ា នៅក្នុង ប្រទេស កម្ពុជា ដែល នេះ ជា សកម្មភាព មួយ ក្នុង ចំណោម សកម្មភាព នានា ជាច្រើន ក្នុង ការជំរុញ លំហូរ ភ្ញៀវ ទេសចរ ទាំង ជាតិ និង អន្តរជាតិ ទៅកាន់ ប្រទេស កម្ពុជា និង ចូលរួម គាំទ្រ ដល់ យុទ្ធនាការ ឆ្នាំ ទស្សនា សៀមរាប ២០២៤ ។
គួរ បញ្ជាក់ ថា មហោស្រព តន្រ្តី អូប៉េរ៉ា ស្តារ ធួរ បាន និង កំពុង រៀបចំ នៅ តាម ទីតាំង ដ៏ អស្ចារ្យ នានា នៅ បណ្តា ប្រទេស អាស៊ី ហើយ ថ្មី ៗ នេះ លោក បាន និង កំពុង សិក្សា គម្រោង រៀបចំ មហោស្រព តន្ត្រី នេះ នៅលើ ទឹកដី អង្គរ ដ៏ អច្ឆរិយៈ នៃ ប្រទេស កម្ពុជា ។
ឧប នាយក រដ្ឋមន្ត្រី ស សុខា និង អ្នកតំណាង កម្មវិធី អភិវឌ្ឍន៍ អង្គការ សហ ប្រជាជាតិ ប្រចាំ កម្ពុជា (UNDP) ឯកភាព បន្ត កិច្ចសហការ ដែល ជា ប្រយោជន៍ ដល់ ពលរដ្ឋ កម្ពុជា ជាពិសេស ពលរដ្ឋ នៅ មូលដ្ឋាន
( ភ្នំពេញ ) ៖ លោក អភិសន្តិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង អ្នកតំណាង កម្មវិធី អភិវឌ្ឍន៍ អង្គការ សហ ប្រជាជាតិ ប្រចាំ កម្ពុជា (UNDP) បាន ឯកភាព បន្ត កិច្ចសហការ ដែល ជា ប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ កម្ពុជា ជាពិសេស ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ។
លោក អភិសន្តិ បណ្ឌិត ស សុខា បាន វាយតម្លៃ ខ្ពស់ ចំពោះ វត្តមាន នៃ UNDP នៅ ប្រទេស កម្ពុជា ដែល គិត មកដល់ ពេលនេះ មាន រយៈពេល ជាង ៥០ ឆ្នាំ ពោលគឺ ចាប់ពី ឆ្នាំ ១៩៥៨ ព្រមទាំង ការបង្កើត ការិយាល័យ ផ្លូវការ របស់ UNDP នៅ រាជធានី ភ្នំពេញ ក្នុង ឆ្នាំ ១៩៩៤ ។
នៅក្នុង ជំនួប ពិភាក្សា ក្នុង នាម រាជ រដ្ឋាភិបាល លោក ឧប នាយក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ ចំពោះ UNDP ដែល បាន ជួយ គាំទ្រ កម្ពុជា ក្នុង ការធ្វើ មូលដ្ឋាន នីយកម្ម គោលដៅ សកល នៃ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ឱ្យ ស្រប ទៅនឹង បរិការណ៍ កម្ពុជា ដើម្បី ពន្លឿន ការសម្រេចបាន នូវ របៀបវារៈ ឆ្នាំ ២០៣០ សម្រាប់ គោលដៅ អភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
លោក ក៏ បាន ជម្រាប ជូន លោកស្រី Alissar Chaker អំពី កិច្ច ខិតខំ ប្រឹងប្រែង និង ការបន្ត ប្តេជ្ញាចិត្ត ខ្ពស់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការពន្លឿន នូវ ការផ្តល់ សេវា សាធារណៈ ជូន ពលរដ្ឋ នៅ មូលដ្ឋាន និង ការពង្រឹង សមត្ថភាព ថ្នាក់ ក្រោម ជាតិ ព្រមទាំង ឆន្ទៈ ខ្ពស់ របស់ ក្រសួង មហាផ្ទៃ និង ក្រសួង នានា ក្នុង ការពង្រឹង ភាពធន់ នឹង បម្រែបម្រួល អាកាសធាតុ ។
ជា ការឆ្លើយតប លោកស្រី អ្នកតំណាង UNDP ប្រចាំ កម្ពុជា បាន ថ្លែងអំណរគុណ ចំពោះ រាជ រដ្ឋាភិបាល កម្ពុជា ចំពោះ កិច្ចសហការ យ៉ាង យូរ លង់ មក នេះ ហើយ លោកស្រី ក៏ បាន គូសបញ្ជាក់ នូវ ការជួយជ្រោមជ្រែង របស់ UNDP កន្លងមក ជាមួយ ក្រសួង មហាផ្ទៃ ក្នុង កំណែទម្រង់ វិម ជ្ឍការ និង វិសហម ជ្ឍការ . ការអភិវឌ្ឍ អាជ្ញាធរ ថ្នាក់ ក្រោម ជាតិ . ការពង្រឹង ការចូលរួម របស់ សង្គម ស៊ីវិល . និង ការគាំទ្រ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ កម្ពុជា តាមរយៈ គម្រោង នានា ។
ភ្នំ ភ្លើង នៅ កណ្តាល ប្រទេស ហ្វីលីពីន ផ្ទុះ បញ្ចេញ ផ្សែង ខ្មៅ ងងឹត ដល់ កម្ពស់ ៥គីឡូម៉ែត
( ម៉ានីល) ៖ ភ្នំ ភ្លើង មួយ នៅ កណ្តាល ប្រទេស ហ្វីលីពីន បាន ផ្ទុះឡើង នៅ ថ្ងៃចន្ទ នេះ បញ្ចេញ ផ្សែង ដ៏ ខ្មៅ ងងឹត ដល់ កម្ពស់ ប្រាំ គីឡូម៉ែត្រ នេះ បើ តាម ការបញ្ជាក់ របស់ ទីភ្នាក់ងារ រញ្ជួយ ដី របស់ ប្រទេស នេះ ។ ទីភ្នាក់ងារ នេះ បាន បន្ថែម ថា ការជម្លៀស ប្រជាជន នៅក្នុង តំបន់ នៅ មិន ទាន់ ត្រូវបាន ណែនាំ នៅឡើយ ទេ ។ នេះ បើ យោង តាមា ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២៤ ។
ការព្រមាន នេះ បាន កើតឡើង ជា ការឆ្លើយតប ទៅនឹង ការសម្រេចចិត្ត របស់ ប្រធានាធិបតី អាមេរិក ចូ បៃ ដិន កាលពី សប្តាហ៍ មុន ក្នុង ការអនុញ្ញាតឱ្យ ប្រើប្រាស់ អាវុធ អាមេរិក ដើម្បី វាយប្រហារ គោលដៅ នៅក្នុង ទឹកដី រុស្ស៊ី ដែល ជាប់ពាក់ព័ន្ធ នឹង ការវាយប្រហារ នៅក្នុង តំបន់ Kharkiv ភាគ ឦសាន នៃ ប្រទេស អ៊ុយក្រែន ។
លោក Ryabkov បាន សង្កត់ធ្ងន់ ថា មេដឹកនាំ អាមេរិក កំពុង « មើល ស្រាល » ចំពោះ ភាពធ្ងន់ធ្ងរ នៃ ស្ថានការណ៍ ហើយ អំពាវនាវ ឱ្យ ពួកគេ ពិចារណា ឡើងវិញ នូវ ផលវិបាក ដ៏ ធ្ងន់ធ្ងរ ដែល អាច កើត មាន ឡើង ។ ដោយ ដកស្រង់ សម្តី របស់ ប្រធានាធិបតី វ្ល៉ាឌីមៀ ពូទីន ថ្មី ៗ នេះ លោក បាន និយាយ ថា បណ្តា ប្រទេស ណា តូ កំពុង ប្រឈម នឹង ជម្លោះ សកល កាន់តែ ជ្រៅ ដោយ ការគាំទ្រ អ៊ុយក្រែន ។
គួរ ជម្រាប ថា ប្រធានាធិបតី ពូទីន បាន បញ្ជាក់ ថា ការចូលរួម ណាមួយ របស់ លោក ខាងលិច ក្នុង ការវាយប្រហារ របស់ អ៊ុយក្រែន លើ ប្រទេស រុស្ស៊ី នឹង ធ្វើឱ្យ លោក ខាងលិច ជាប់ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ក្នុង ជម្លោះ ក្នុង នោះ រួម មាន ដូចជា ការផ្តល់ឱ្យ អ៊ុយក្រែន នូវ ប្រព័ន្ធ ផ្កាយ រណប ការស៊ើបការណ៍ សម្ងាត់ និង ការគាំទ្រ ផ្នែក យោធា ជាដើម ៕
១០ ថ្ងៃ នេះ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត ចាត់ការ លើ សំណុំរឿង ក្មេង ទំនើង ៧៣ ករណី មាន ជនសង្ស័យ ៤៧៨ នាក់
អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ ក៏ បាន អំពាវនាវ ដល់ ឪពុក ម្តាយ ព្រមទាំង អាណាព្យាបាល ទាំងអស់ ត្រូវ ខិតខំ តាមដាន អប់រំ និង ទូន្មាន ប្រៀន ប្រដៅ ដល់ កូន ៗ ឱ្យ ដើរ តាម គន្លង ត្រឹមត្រូវ វៀរចាក នូវ អំពើ អបាយ មុខ ដើម្បី ក្លាយជា ពលរដ្ឋ ល្អ សម្រាប់ សង្គមជាតិ និង សូម អំពាវនាវ ដល់ យុវជន ទាំងអស់ ដែល ជា ទំពាំង ស្នង ឫស្សី របស់ ប្រទេសជាតិ សូម ប្រកាន់ខ្ជាប់ នូវ វិន័យ សីលធម៌ និង សេចក្តីថ្លៃថ្នូរ ហើយ សូម ចៀសវាង ពី សកម្មភាព ទាំងឡាយ ណា ដែល បង្ក អន្តរាយ ដល់ ខ្លួន គ្រួសារ និង សង្គមជាតិ ៕
ថវិកា ទាំងនេះ ទទួលបាន ពី ការចូលរួម បរិច្ចាគ ពីសំណាក់ សប្បុរសជន ដែល ជា ថ្នាក់ដឹកនាំ . ភរិយា ថ្នាក់ដឹកនាំ និង ក្រុមហ៊ុន - សហគ្រាស សំខាន់ ៗ យ៉ាង ផុល ផុស ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា និង លោក ម៉ារ យ៉ារិទ្ធិ អ្នកតាមដាន ព្រឹត្តិការណ៍ នយោបាយ អន្តរជាតិ បាន ឆ្លើយតប ចំពោះ សំណួរ Fresh Talk ថា តើ ទស្សនកិច្ច រដ្ឋមន្រ្តី ការពារ ជាតិ អាមេរិក មកកាន់ កម្ពុជា នឹង ធ្វើឱ្យ ទំនាក់ទំនង ទ្វេ ភាគី ប្រសើរឡើង ឬ យ៉ាងណា ?
សូម ស្តាប់ ការលើកឡើង របស់ លោក បណ្ឌិត គិន ភា និង លោក ម៉ារ យ៉ារិទ្ធិ ៖
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត គិន ភា ប្រធាន វិទ្យាស្ថាន ទំនាក់ទំនង អន្តរជាតិ នៃ កម្ពុជា បាន ព្យាករណ៍ បច្ចុប្បន្ន ពិភពលោក កំពុង មាន សង្គ្រាម ត្រជាក់ នៅឡើយ ហើយ មាន បញ្ហា មួយចំនួន កំពុង ទាញ ឱ្យ ពិភពលោក ខិត ទៅ រក មាត់ ជ្រោះ នៃ សង្គ្រាម លោក លើក ទី៣ ។
សូម ស្តាប់ ការលើកឡើង របស់ លោក បណ្ឌិត គិន ភា៖
( ភ្នំពេញ ) ៖ លោក ម៉ារ យ៉ារិទ្ធិ អ្នកតាមដាន ព្រឹត្តិការណ៍ នយោបាយ អន្តរជាតិ បាន លើកឡើង ថា អាមេរិក ដែល ជា ប្រទេស សេរី មាន ភាពស្និទ្ធស្នាល ជាមួយ វៀតណាម គឺជា នយោបាយ ច្រែះស៊ី ដែក របស់ សហរដ្ឋ អាមេរិក ដើម្បី កៀរគរ ប្រទេស ផ្សេង ៗ ប្រឆាំង ចំពោះ ឥទ្ធិពល របស់ ចិន ។
សូម ស្តាប់ ការលើកឡើង របស់ លោក ម៉ារ យ៉ារិទ្ធិ ៖
ក្រសួង កសិកម្ម កំពុង រៀបចំ សេចក្ដីព្រាង ច្បាប់ « កិច្ចសន្យា ផលិតកម្ម កសិកម្ម »
( ភ្នំពេញ ) ៖ លោក ឌិត ទីណា រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន មានប្រសាសន៍ ថា ក្រសួង កសិកម្ម កំពុង រៀបចំ សេចក្តីព្រាង ច្បាប់ ស្តីពី កិច្ចសន្យា ផលិតកម្ម កសិកម្ម ដែល ជា ច្បាប់ ពិសេស មួយ ដើម្បី ការពារ ផលប្រយោជន៍ ដល់ ប្រជាកសិករ ។
លោក រដ្ឋមន្ត្រី បាន លើកឡើង ថា៖ « ក្រសួង កំពុង រៀបចំ ច្បាប់ កិច្ចសន្យា ផលិតកម្ម កសិកម្ម ហេតុ អ្វី បាន ត្រូវការ ច្បាប់ ពិសេស ? ព្រោះ យើង យោង ច្បាប់ ធម្មតា ច្បាប់ រដ្ឋប្បវេណី មក ប្រើ គឺ មាន ន័យ ថា គាត់ ត្រូវ សង ការខូចខាត អ្វី មួយចំនួន ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ កសិករ ខ្លាំង ណាស់ ឥឡូវ យើង ធ្វើ ច្បាប់ ពិសេស ដើម្បី ជួយ ការពា មិន ឱ្យ គាត់ ខូច ទេ ប៉ុន្តែ បើ គាត់ មាន បញ្ហា យើង អាច ជួយ ដោះស្រាយ បាន » ។
ជាមួយគ្នា នេះ ដែរ លោក បាន បន្ថែម ថា យ៉ាងហោចណាស់ យើង ត្រូវ រក ដំណោះស្រាយ បញ្ហា សេ្ថរភាព នៃ ការផ្គត់ផ្គង់ នេះ បាន ពីព្រោះថា រឿង នេះ គឺ ពិបាក បើ លើកឡើង តាម អ្នក ជ្រុលនិយម គាត់ នឹង និយាយ ថា កុំ ឱ្យ នាំចូល តែ កុំ ភ្លេច ថា នៅ ពេល ដែល យើង ផ្គត់ផ្គង់ មិន បាន ហើយ មិន ឱ្យ នាំចូល អ្នក ដែល ប៉ះពាល់ គឺ អ្នកប្រើប្រាស់ ទាំងអស់ ។
លើស ពី នេះ លោក រដ្ឋមន្ត្រី បាន លើកឡើង ថា អ្វី ដែល យើង កំពុង ធ្វើ សព្វ ថ្ងៃ គឺ ការរក្សា ស្ថេរភាព ថ្លៃ នេះ តាមរយៈ ការថ្លឹងថ្លែង ការផ្គត់ផ្គង់ និង ការប្រើប្រាស់ នេះ ឯង ដោយ យើង មិន មែន ចេះតែ បើក ឱ្យ មាន ការនាំចូល ហើយ យើង ក៏ មិន ចេះតែ បិទ នោះ ដែរ កុំ ភ្លេច ថា សព្វ ថ្ងៃ នេះ យើង មាន សេដ្ឋកិច្ច មួយ ដែល ផ្សាភ្ជាប់គ្នា ដោយ ថ្លឹងថ្លែង ច្បាស់លាស់ និង គិត ផល ប្រយោជន៍ រួម ជា ធំ ។
សម្រាប់ បញ្ហា ចង្វាក់ ផ្គត់ផ្គង់ ផលិតផល កសិផល លោក ឌិត ទីណា បាន លើកឡើង ពី វិធីសាស្ត្រ ដោះស្រាយ ដែល វិធីសាស្ត្រ នោះ គឺជា ការចងក្រង នូវ សហគមន៍ រួមផ្សំ ជាមួយនឹង ការរៀបចំ ខ្សែ ចង្វាក់ តម្លៃ ជាមួយគ្នា ដោយ ត្រូវការ នូវ រយៈពេល សមរម្យ ក្នុង ការរៀបចំ ឱ្យ លេចចេញ នូវ កិច្ចការ នេះ ហើយ ក៏ប៉ុន្តែ នៅក្នុង អាណត្តិ អ្វី ដែល ក្រសួង ព្យាយាម ធ្វើ គឺ កសាង ខ្សែ ចង្វាក់ ផ្គត់ផ្គង់ មួយ ដែល មាន ស្ថេរភាព ហើយ តម្លៃ ទៀតសោត អាច ធានា ទៅ បាន ៕
អគ្គ លេខាធិការ អាស៊ាន ចាប់ផ្តើម ទស្សនកិច្ចការងារ នៅ សាធារណរដ្ឋ កូរ៉េ
រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ប្ដេជ្ញា ខិតខំ បង្កើន ការផលិត កម្មវិធី ល្អ ៗ និង ផ្សព្វផ្សាយ អប់រំ កុមារ ឱ្យ ប្រព្រឹត្ត អំពើ ល្អ និង លើកកម្ពស់ ការយល់ដឹង របស់ ពលរដ្ឋ អំពី តម្លៃ របស់ កុមារ
( ភ្នំពេញ ) ៖ លោក នេត្រ ភក្ត្រា រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បាន ថ្លែង ថា ក្រសួង ព័ត៌មាន នឹង ខិតខំ បង្កើន ការផលិត កម្មវិធី ល្អ ៗ គ្រប់ រូបភាព ប្រកបដោយ ភាពទាក់ទាញ ឱ្យ កាន់តែ ច្រើន ដើម្បី អប់រំ កុមារ ឱ្យ ប្រព្រឹត្ត អំពើ ល្អ និង លើកកម្ពស់ ការយល់ដឹង របស់ ប្រជាពលរដ្ឋ អំពី តម្លៃ របស់ កុមារ និង អំពី បញ្ហា ប្រឈម នានា របស់ កុមារ ។
នេះ ជា ការថ្លែង បែប នេះ ធ្វើឡើង ក្នុង ឱកាស លោក រដ្ឋមន្ត្រី នេត្រ ភក្ត្រា និង លោកស្រី ទុយ សិរី រតនៈ នេត្រ ភក្ត្រា ប្រធាន កិត្តិយស សមាគម នារី ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ សាខា ក្រសួង ព័ត៌មាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ មហោស្រព តន្ត្រី និង ចម្រៀង កុមារ ឆ្នាំ ២០២៤ ពានរង្វាន់ ក្រសួង ព័ត៌មាន នា ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ នៅ ទីស្តីការ ក្រសួង ព័ត៌មាន ។
លោក រដ្ឋមន្ត្រី នេត្រ ភក្ត្រា បាន គូសបញ្ជាក់ ថា ក្រសួង ព័ត៌មាន ដែល មាន ប្រព័ន្ធ ផ្សព្វផ្សាយ និង ក្រុមការងារ ដើម្បី កុមារ ជា សេនាធិការ នឹង បន្ត រៀបចំ ផលិត កម្មវិធី ថ្មី បន្ថែម ទៀត ទាក់ទង កិច្ចការងារ កុមារ បន្ទាប់ពី ក្រសួង បាន រៀបចំ មហោស្រព តន្ត្រី និង ចម្រៀង កុមារ ឆ្នាំ ២០២៤ ពានរង្វាន់ ក្រសួង ព័ត៌មាន ឈាន មកដល់ ថ្ងៃ បញ្ចប់ ដោយ ជោគជ័យ ។
តាមរយៈ ជោគជ័យ នៃ ដំណើរការ កម្មវិធី មហោស្រព តន្រ្តី និង ចម្រៀង កុមារ នេះ ដែរ លោក រដ្ឋមន្រ្តី នេត្រ ភក្ត្រា លើកទឹកចិត្ត ឱ្យ មាន ការប្រារព្ធ ធ្វើ មហោស្រពចម្រៀង កុមារ ឱ្យ បាន ជាប់ ជារៀងរាល់ ឆ្នាំ ហើយ សង្ឃឹម ថា ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង សប្បុរសជន នានា នឹង បន្ត ជួយ ឧបត្ថម្ភ ជ្រោមជ្រែង ដល់ កម្មវិធី នេះ ដើម្បី ជា ឧត្តម ប្រយោជន៍ សម្រាប់ កុមារ ដែល ជា ទំពាំង ស្នង ឫស្សី របស់ កម្ពុជា ទៅ ថ្ងៃ អនាគត ។
លោក បាន ផ្ដាំផ្ញើ ដល់ កុមារា កុមារី ទាំងអស់ ខិតខំ កសាង ខ្លួន សិក្សា រៀនសូត្រ ដើម្បី ក្លាយជា កូន ល្អ សិស្ស ល្អ មិត្ត ល្អ និង ពលរដ្ឋ ល្អ ដែល ជា ធនធាន ដ៏ សំខាន់ ក្នុង ការរួមចំណែក អភិវឌ្ឍន៍ ប្រទេសជាតិ ។
លោក ក៏ បាន អរគុណ ដល់ គ្រប់ ផ្នែក ពាក់ ពន្ធ័ ទាំងអស់ ក វីនិពន្ធ ដែល បាន រួម គិត រួម ធ្វើ ជាមួយគ្នា ដើម្បី បុព្វហេតុ ជាតិ និង គុណ ប្រយោជន៍ កុមារ កម្ពុជា តាមរយៈ ការបង្កើត ស្នាដៃ និពន្ធ បទភ្លេង និង ទំនុក ច្រៀង សម្រាប់ កុមារ ដោយ ឈរ លើ គោលការណ៍ ងាយ ចេះ ងាយ ចាំ ។
តាមរយៈ របាយការណ៍ សង្ខេប របស់ លោកស្រី ច័ន្ទ ធី រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន ទទួលបន្ទុក ជា ប្រធាន គណៈកម្មការ បូក ពិន្ទុ ក បាន ឱ្យដឹង ថា មហោស្រព តន្ត្រី និង ចម្រៀង កុមារ បាន ចាប់កំណើត តាំងពី ឆ្នាំ ១៩៨៥ រហូតមក ឆ្នាំ ២០១២ ក្រោម ការគាំទ្រ ពី លោក ខៀវ កាញារីទ្ធ អតីត រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ដែល នៅ បន្ត គាំទ្រ រហូតដល់ ឆ្នាំ ២០១៩ ប៉ុន្តែ ត្រូវ ផ្អាក អស់ រយៈពេល ជិត៣ ឆ្នាំ ដោយសារ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
ក្នុង ឆ្នាំ ២០២៤ នេះ មហោស្រព តន្ត្រី និង ចម្រៀង កុមារ ត្រូវបាន ប្រារព្ធ ឡើងវិញ ក្រោម ការផ្តួចផ្តើម ដោយ លោក នេត្រ ភក្ត្រា រដ្ឋមន្រ្តី ក្រសួង ព័ត៌មាន ។ កុមារា កុមារី ដែល បាន ចូលរួម ប្រលង មាន ចំនួន ៣៤ ក្រុម ទំនុក ច្រៀង ចំនួន ៦៨ អត្ថបទ ដែល មាន អត្ថរូប អត្ថន័យ អត្ថរស ល្អ ៗ និង ជាសារ ផ្តល់ នូវ ការអប់រំ ចំណេះដឹង យ៉ាង ទូលំទូលាយ គ្របដណ្តប់ ទៅ លើ សីលធម៌ អត្តចរឹត របស់ កុមារ ។
* ជ័យលាភី លេខ ១ ទទួលបាន ពាន១ ប្រកាស នីយបត្រ១ និង ថវិកា ១០លាន រៀល * ជ័យលាភី លេខ ២ ទទួលបាន ពាន១ ប្រកាស នីយបត្រ១ និង ថវិកា ៦លាន រៀល * ជ័យលាភី លេខ ៣ ទទួលបាន ពាន១ ប្រកាស នីយបត្រ១ និង ថវិកា ៤លាន រៀល * ជ័យលាភី កិត្តិយស លេខ ៤ និង លេខ ៥ ទទួលបាន ពាន កិត្តិយស ចំនួន ១ ប្រកាស នីយបត្រ ចំនួន ១ និង ថវិកា ២លាន រៀល ៕ រដ្ឋមន្ត្រី ទេសចរណ៍ ជួប ពិភាក្សា ជាមួយ ក្រុមហ៊ុន វិនិយោគ មួយ ដែល ចូលរួម ជំរុញ រំហូរ ភ្ញៀវ ទេសចរ យ៉ាង ច្រើន ទៅកាន់ ខេត្ត កោះកុង
ក្នុង ជំនួប នោះ លោក ប្រធាន ក្រុមប្រឹក្សាភិបាល ក្រុមហ៊ុន បាន លើកឡើង ពី ការចូលរួម របស់ ក្រុមហ៊ុន ជាមួយ រាជ រដ្ឋាភិបាល ជាពិសេស ក្រសួង ទេសចរណ៍ ក្នុង ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ស្រប តាម គំនិត ផ្ដួច ផ្ដើម « បង្កើន ៥ អភិវឌ្ឍ ៣» ដែល ដាក់ចេញ ដោយ ក្រសួង ទេសចរណ៍ ។
គួរ បញ្ជាក់ ថា ក្រុមហ៊ុន នេះ បាន វិនិយោគ លើ ការសាងសង់ គម្រោង ផ្លូវថ្នល់ គម្រោង ផ្លូវ ទឹក ហេដ្ឋារ រចនាសម្ព័ន្ធ ចម្រុះ អាកាសយានដ្ឋាន អន្តរជាតិ ខ្នាត F4 កំពង់ផែ ទឹក ជ្រៅ រួមទាំង គម្រោង ជាច្រើន ទៀត នៅក្នុង តំបន់ តារា សាគរ ដែល បាន ចូលរួម ជំរុញ រំហូរ ភ្ញៀវ ទេសចរ យ៉ាង ច្រើន ទៅកាន់ ខេត្ត កោះកុង ៕
កូរ៉េ ខាងជើង ថ្កោល ទោស ការអំពាវនាវ ឱ្យ លុបបំបាត់ អាវុធ នុយក្លេអ៊ែរ នៅក្នុង កិច្ចប្រជុំ កំពូល អ្នកជិតខាងក្នុង ទីក្រុង សេអ៊ូល
( សេអ៊ូល ) ៖ កូរ៉េ ខាងជើង នៅ ថ្ងៃចន្ទ នេះ បាន ថ្កោលទោស ចិន ជប៉ុន និង កូរ៉េ ខាងត្បូង ជុំវិញ ការប្តេជ្ញាចិត រួមគ្នា លុបបំបាត់ អាវុធ នុយក្លេអ៊ែរ នៅ ឧបទ្វីប កូរ៉េ ដោយ ពណ៌នា អំពី សេចក្តីថ្លែងការណ៍ រួម របស់ ប្រទេស ទាំង បី បន្ទាប់ពី កិច្ចប្រជុំ កំពូល ដ៏ កម្រ មួយ នៅ ទីក្រុង សេអ៊ូល ថា ជា « ការបង្កហេតុ នយោបាយ ធ្ងន់ធ្ងរ » ដែល រំលោភ លើ អធិបតេយ្យភាព របស់ ខ្លួន ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ ។
កូរ៉េ ខាងជើង បាន ជូន ដំណឹង អំពី ផែនការ របស់ ខ្លួន ក្នុង ការបាញ់ បង្ហោះ រ៉ុក្កែត មួយ នៅ ដើម ខែមិថុនា ដើម្បី ដាក់ ផ្កាយ រណប ចារកម្ម មួយ ដែល នឹង ជួយ បង្កើន សមត្ថភាព របស់ ប្រទេស នេះ ក្នុង ការវាយប្រហារ នុយក្លេអ៊ែរ ។ ក្នុង កិច្ចប្រជុំ កំពូល ត្រី ភាគី លើក ដំបូង នៅ ទីក្រុង សេអ៊ូល ចាប់តាំងពី ឆ្នាំ ២០១៩ បណ្តា ប្រទេស ទាំង បី បាន ស្វែងរក កិច្ចសហប្រតិបត្តិការ លើ សន្តិសុខ ដោយ បញ្ជាក់ ជាថ្មី នូវ ជំហរ របស់ ពួកគេ លើ សន្តិភាព ស្ថិរភាព និង ការលុបបំបាត់ អាវុធ នុយក្លេអ៊ែរ នៅ ឧបទ្វីប កូរ៉េ ។
គួរ ជម្រាប ថា ចិន បាន ធ្វើឱ្យ កូរ៉េ ខាងជើង ខឹងសម្បារ ម្តង នៅ ពេល ដែល ខ្លួន បាន ចុះហត្ថលេខា លើ ដំណោះស្រាយ ក្រុមប្រឹក្សា សន្តិសុខ អង្គការ សហ ប្រជាជាតិ ដាក់ទណ្ឌកម្ម លើ កម្មវិធី អាវុធ នុយក្លេអ៊ែរ និង មីស៊ីល របស់ ទីក្រុង ព្យុងយ៉ាង ពី ឆ្នាំ ២០០៦ ដល់ ២០១៧ ប៉ុន្តែ ក្នុង ប៉ុន្មាន ឆ្នាំ ថ្មី ៗ នេះ ទីក្រុង ប៉េកាំង បាន ចូលរួម ជាមួយ រុស្ស៊ី ក្នុង ការរារាំង ការដាក់ទណ្ឌកម្ម ថ្មី និង អំពាវនាវ ឱ្យ មាន ការបន្ធូរបន្ថយ វិធានការ ដែរ ដែល មាន ស្រាប់ ។
កូរ៉េ ខាងជើង បាន បាញ់ បង្ហោះ ផ្កាយ រណប ចារកម្ម យោធា ដំបូង របស់ ខ្លួន ទៅកាន់ គន្លង ផែនដី កាលពី ខែវិច្ឆិកា ឆ្នាំ ២០២៣ បន្ទាប់ពី ការប៉ុនប៉ង ពីរ លើក មុន បាន បរាជ័យ ៕ សាលាដំបូង រាជធានី ភ្នំពេញ ប្រកាស សាលក្រម ទាស់ លើ បណ្តឹង របស់ ជនជាប់ចោទ វ៉េត សុភា និង បក្ខពួក មួយចំនួន ពាក់ព័ន្ធ នឹង សំណុំរឿង រំលោភ លើ សេចក្តីទុកចិត្ត
( ភ្នំពេញ ) ៖ សាលាដំបូង រាជធានី ភ្នំពេញ កាលពី ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២៤ បាន ចេញ សាលក្រម ច្រានចោល នឹង បណ្តឹង ទាស់ របស់ ជនជាប់ចោទ ឈ្មោះ វ៉េត សុភា ពាក់ព័ន្ធ នឹង សំណុំរឿង រំលោភ លើ សេចក្តីទុកចិត្ត ដែល តុលាការ បាន សម្រេច ផ្តន្ទាទោស ជន ជាប់ចោទ កាលពី ខែកុម្ភៈ ឆ្នាំ ២០២៣ ។
ក្រោយមក រឿងរ៉ាវ ទាំងនេះ បែកធ្លាយ ក៏ ជនជាប់ ចោទ បាន ធ្វើ លិខិត ទទួលស្គាល់ កំហុស និង ទទួលខុសត្រូវ ចំពោះ អំពើ ខ្លួន ជាមួយ ដើម បណ្ដឹង ។ ប៉ុន្តែ ជនជាប់ចោទ ឈ្មោះ វ៉េត សុភា មិន បាន ចេញមុខ ទទួលខុសត្រូវ ចំពោះ ទង្វើ របស់ ខ្លួន នោះ ឡើយ ថែមទាំង គេចវេស រហូត ទើប ដើម បណ្ដឹង សម្រេច ដាក់ពាក្យ ប្ដឹង ទៅ តុលាការ ។
ក្រោយ ដំណើរការ ក្តី នៅ តាម ផ្លូវ តុលាការ ជា បន្តបន្ទាប់ . ជន ជាប់ចោទ មិន ចូលខ្លួន នោះ ទេ រហូត ថ្ងៃទី ២៧ ខែកុម្ភៈ ឆ្នាំ ២០២៣ ទើប តុលាការ បាន ចេញ សាលក្រម ផ្ដន្ទាទោស ជន ជាប់ចោទ ឈ្មោះ វ៉េត សុភាព និង បុគ្គល ពាក់ព័ន្ធ ផ្សេង ទៀត ពី បទ « រំលោភ លើ ទំនុកចិត្ត » និង ចេញ ដីការ ចាប់ខ្លួន ។
លុះ ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២៤ ជន ជាប់ចោទ បាន ប្ដឹង ទាស់ នឹង សាលក្រម កំបាំងមុខ នេះ តែ នៅ ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២៤ តុលាការ បាន ប្រកាស សាលក្រម លើ បណ្ដឹង ទាស់ របស់ ជនជាប់ចោទ ឈ្មោះ វ៉េត សុភា ដោយ សម្រេច លើក ចោល បណ្ដឹង ទាស់ របស់ ជនជាប់ចោទ ដោយ ចាត់ទុក ថា ឥត បាន ការ និង សម្រេច តម្កល់ សាលក្រម ចុះ ថ្ងៃទី ០៩ ខែមីនា ឆ្នាំ ២០២៣ ទុក ជា បាន ការដដែល ៕
ចំណេះដឹង ទូទៅ៖ ព្រឹត្តិការណ៍ ដែល ផ្ដាច់ ជីវិត មនុស្ស ច្រើន ជាង គេ ក្នុង ប្រវត្តិសាស្ត្រ
( ភ្នំពេញ ) ៖ ព្រោះតែ ផលប្រយោជន៍ ប្រជែង ឥទ្ធិពល និង ការស្រេកឃ្លាន អំណាច មនុស្ស បាន បង្ក ជម្លោះ នឹង គ្នា ឥត ឈប់ឈរ រហូត ឈានដល់ ការធ្វើ សឹក សង្គ្រាម នឹង គ្នា ទៅ វិញ ទៅ មក ដែល នាំឱ្យ កើតមាន នូវ ក្ដី វិនាស អន្តរាយ ដល់ អាយុជីវិត និង បំផ្លិចបំផ្លាញ សមិទ្ធផល ពិសេស គឺ បង្ក វិនាសកម្ម ដល់ ផែនដី ទៀតផង ។
ប្រសិនបើ រាប់ ទាំង សមរភូមិ ការធ្វើ បដិវត្តន៍ បន ប្រល័យ ពូជសាសន៍ ការកាន់កាប់ អំណាច ឃោរឃៅ ល្បែង កីឡា មរណៈ ការកាត់ទោស ការធ្វើ ពលកម្ម និង ការកសាង ទ្រង់ទ្រាយ ធំ ការធ្វើ ពាណិជ្ជកម្ម ទាសករ ផង នោះ គឺ សុទ្ធតែ បាន ធ្វើឱ្យ ជីវិត មនុស្ស ស្លាប់ អស់ រាប់ រយ លាន នាក់ ខណៈ មក ទល់ សម័យ បច្ចុប្បន្ន ហើយ សង្គ្រាម ក៏ នៅតែ បន្ត កើតមាន ។
៣. បដិវត្ត វប្បធម៌ លោក ប្រធាន ម៉ៅ សេទុង បាន អនុវត្ត នយោបាយ បញ្ជូន ប្រជាជន ទៅ ធ្វើការ នៅ មូលដ្ឋាន ដើម្បី ជំរុញ វិស័យ កសិកម្ម ក សាង ជាតិ និង ពង្រឹង ស្មារតី បក្ស ដែល លោក ឱ្យ ឈ្មោះ ថា « បដិវត្ត វប្បធម៌ » ចាប់ពី ឆ្នាំ ១៩៤៩ - ១៩៧៦ ក្នុង នោះ បាន បង្កឱ្យ ជីវិត មនុស្ស ប្រមាណ ៤០.០០០.០០០ នាក់ ត្រូវ ស្លាប់ ។
បើ តាម អ្នកនាំពាក្យ . សម្រាប់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៨.៥៥៧ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៦.១៧៣ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២. ៣៨៤ គ្រឿង ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១០លើក ក្នុង នោះ អ្នកស្លាប់ ចំនួន ០៦ នាក់ របួស ចំនួន ៥៦ នាក់ ( របួស ធ្ងន់ ចំនួន ០៦ នាក់ ) ។ រយៈពេល ២៧ ថ្ងៃ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ២១២ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ១១៥ នាក់ របួស ២៧៥ នាក់ ( របួស ធ្ងន់ ១៤៥ នាក់ )៕
កម្លាំង អាវុធហត្ថ បាត់ដំបង ចាប់ ក្រុម ក្មេង ទំនើង ៣នាក់ និង បញ្ជូន ទៅ តុលាការ ក្រោយ ប្រើ ដាវ សាំ ម៉ូរ៉ៃ និង កាំបិត កាប់ ជនរងគ្រោះ បណ្តាលឲ្យ រងរបួស ធ្ងន់
( បាត់ដំបង ) ៖ កម្លាំង អាវុធហត្ថ ខេត្ត បាត់ដំបង បាន ចាប់ និង បញ្ជូន ក្មេង ទំនើង ចំនួន ៣នាក់ ទៅ តុលាការ នៅ រសៀល ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ក្រោយ ប្រើ ដាវ សាំ ម៉ូរ៉ៃ និង កាំបិត កាប់ ជនរងគ្រោះ បណ្តាលឲ្យ រងរបួស ធ្ងន់ ។
សូម បញ្ជាក់ ថា ក្រុម បង្ក នេះ បាន ប្រព្រឹត្ត អំពើហិង្សា នៅ វេលា ម៉ោង ០០ និង ១០នាទី រំលង អាធ្រាត្រ ឈានចូល ថ្ងៃទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ នៅ ចំណុច អនុវិទ្យាល័យ មោង ភូមិ ពោធិ៍ ១ឃុំ គារ ស្រុក មោង ឬ ស្សី ខេត្ត បាត់ដំបង ។
តាម របាយការណ៍ កងរាជអាវុធហត្ថ ខេត្ត បាន បញ្ជាក់ ថា បន្ទាប់ កើត ហេតុ ភ្លាម ៗ នោះ និង យោង តាម បណ្តឹង របស់ ជនរងគ្រោះ ឈ្មោះ វាសនា វណ្ណ : អាយុ ២១ ឆ្នាំ ទីលំនៅ បច្ចុប្បន្ន ភូមិ ចក តូច ឃុំ ក កោះ ស្រុក មោង ឬ ស្សី រួច មក កម្លាំង ជំនាញ បាន ធ្វើ ការបង្ក្រាប បាន ភ្លាម ៗ និង ចាប់ ក្រុម បង្ក បាន នៅ ចំណុច អនុវិទ្យាល័យ មោង ភូមិ ពោធិ៍១ ឃុំ គារ ។
ជន បង្ក ទាំង ៣នាក់ រួម មាន៖
បើ តាម របាយការណ៍ . នៅពេល កើត ហេតុ ក្រុម ជនសង្ស័យ បាន ធ្វើ សកម្មភាព យក ដាវ សាំ ម៉ូរ៉ៃ និង កាំបិត បាន ធ្វើ់ សកម្មភាព កាប់ ទៅ លើ ជនរងគ្រោះ ខណ: ដែល កំពុង មើល ការបង្គំ តន្ត្រី បណ្តាលឲ្យ រងរបួស រយះ ត្រង់ ប្រអប់ ជើង និង ក្បាល ជង្គង់ ខាងឆ្វេង កាលពី វេលា ម៉ោង ២២ និង ០០ នាទី ថ្ងៃទី ២៥ ខែឧសភា ឆ្នាំ ២០២៤ នៅ ចំណុច ខាងលើ ។
ឧត្តមសេនីយ៍ ត្រី ហែម វុទ្ធី មេបញ្ជាការ កងរាជ វុធហត្ថ ខេត្ត បាត់ដំបង បាបញ្ជាក់ ថា បន្ទាប់ពី ឃាត់ខ្លួន ទាំង ៣នាក់ . កម្លាំង របស់ លោក បាន ដកហូត វត្ថុតាង មាន៖ កាំបិត ចំនួន ០១ ដើម ប្រវែង ៦៥សង់ទីម៉ែត្រ . ម៉ូតូ ចំនួន ០១ គ្រឿង ម៉ាក ហុង ដា ឃ្លីច ស៊េរី ឆ្នាំ ២០២០ ពណ៌ ស ពាក់ ផ្លាកលេខ បាត់ដំបង 1AL-7311 និង ទូរស័ព្ទ ចំនួន ០១ គ្រឿង ។
លោក បាន បញ្ជា ឲ្យ មន្រ្តី ការិយាល័យ ជំនាញ កសាង សំណុំរឿង បញ្ជូន ខ្លួន ទៅ សាលាដំបូង ខេត្ត ដើម្បី ចាត់ការ តាម នីតិវិធី ៕
អាជ្ញាធរ មីន ដឹកនាំ កិច្ចប្រជុំ តាម ប្រព័ន្ធ អនឡាន ជាមួយ គណៈកម្មការ នានា នៃ អនុសញ្ញា អូតា វ៉ា ដើម្បី ត្រៀម រៀបចំ កិច្ចប្រជុំ កំពូល សៀមរាប - អង្គរ ស្តីពី ពិភពលោក មួយ ដែល គ្មាន មីន ឆ្នាំ ២០២៤
កិច្ចប្រជុំ បាន ផ្តោត ជាពិសេស លើ ការពិភាក្សា អំពី ការរៀបចំ កិច្ចប្រជុំ ត្រួតពិនិត្យ ឡើងវិញ លើក ទី៥ ឬ កិច្ចប្រជុំ កំពូល សៀមរាប - អង្គរ ស្តីពី ពិភពលោក មួយ ដែល គ្មាន មីន ការពិនិត្យ វឌ្ឍនភាព ការអនុវត្ត ផែនការ សកម្មភាព ទីក្រុង អូស្លូ២០១៩ - ២០២៤ និង ការកំណត់ សកម្មភាព និង វិធានការ សំខាន់ ៗ សម្រាប់ រៀបចំ សេចក្តីថ្លែងការណ៍ នយោបាយ និង ផែនការ សកម្មភាព សៀមរាប - អង្គរ រយៈពេល ៥ឆ្នាំ ទៅ មុខ ដែល ជា ឯកសារ តម្រង់ ទិស សកម្មភាព មីន សម្រាប់ ពិភពលោក ទាំងមូល ។
លោក ក៏ បាន អបអរសារទរ និង កោតសរសើរ កម្ពុជា ដែល មាន ការផ្ទេរ អំណាច ដោយ រលូន និង ប្រកបដោយ សន្តិភាព ដល់ ថ្នាក់ដឹកនាំ ជំនាន់ ក្រោយ ។ ក្នុង នាម ប្រធាន សភា ជាតិ បង់ក្លាដែស លោក ឯក អគ្គ រដ្ឋទូត សូម គោរព អញ្ជើញ សម្តេច តេជោ ធ្វើ ទស្សនកិច្ច ជា ផ្លូវការ នៅ បង់ក្លាដែស និង ចែករំលែក ពី សារសំខាន់ នៃ សន្តិភាព និង ស្ថិរភាព សម្រាប់ ការអភិវឌ្ឍ ។
ជា ចុងក្រោយ សម្ដេច តេជោ ប្រធាន ព្រឹទ្ធសភា បាន សុំ ឱ្យ លោក អគ្គ រដ្ឋទូត ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្ដេច ទៅកាន់ លោកស្រី នាយក រដ្ឋមន្ត្រី Sheikh Hasina និង សូម ជូនពរ លោក ឱ្យ មាន សុខភាព ល្អ និង បន្ត នូវ ភាពជោគជ័យ ជា បន្តបន្ទាប់ ទៀត ៕ សភា ពាណិជ្ជកម្ម កម្ពុជា និង សហព័ន្ធ ឧស្សាហកម្ម និង ពាណិជ្ជកម្ម ចិន ចុះ អនុស្សរណៈ យោគយល់ គ្នា គោលបំណង ចូលរួមចំណែក ជំរុញ ទំនាក់ទំនង សេដ្ឋកិច្ច និង លើកកម្ពស់ ពាណិជ្ជកម្ម និង វិនិយោគ កម្ពុជា - ចិន
ក្នុង ឱកាស នៃ ជំនួប ពិភាក្សា នេះ សភា ពាណិជ្ជកម្ម កម្ពុជា និង សហព័ន្ធ ឧស្សាហកម្ម និង ពាណិជ្ជកម្ម ចិន បាន ចុះ អនុស្សរណៈ យោគយល់ គ្នា ក្នុង គោលបំណង ចូលរួមចំណែក ជំរុញ ទំនាក់ទំនង សេដ្ឋកិច្ច និង លើកកម្ពស់ ពាណិជ្ជកម្ម និង វិនិយោគ កម្ពុជា - ចិន ។
