( យ៉េរ៉េវ៉ាន់ ) ៖ ទឹក ជំនន់ បង្កឡើង ដោយ ភ្លៀង ធ្លាក់ ខ្លាំង និង បណ្តាលឱ្យ ទឹក ទន្លេ ឡើង ខ្លាំង ហួស ច្រាំង នៅក្នុង ប្រទេស អាមេនី ក៏ ដូចជា ហ្សក ហ្ស៉ី បាន ឆក់ យក ជីវិត មនុស្ស ៣នាក់ លិច លង់ ភូមិ មួយចំនួន ហើយ តម្រូវ ឱ្យ មាន ការជម្លៀស អ្នកស្រុក រាប់ រយ នាក់ ចេញ ពី ផ្ទះសម្បែង របស់ ពួកគេ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន Reuters នៅ ថ្ងៃចន្ទ ទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ ។
ក្រសួង ការពារ ជាតិ រុស្ស៉ី បាន បញ្ជូន កងទ័ព ទៅ ជួយ សង្រ្គោះ តប តាម សំណើ របស់ អាមេនី ។ ទីភ្នាក់ងារ ព័ត៌មាន TASS បាន ដកស្រង់ សម្តី របស់ រដ្ឋមន្រ្តី មហាផ្ទៃ អាមេនី ដែល និយាយ ថា មាន អ្នកស្លាប់ ចំនួន ៣នាក់ ហើយ នៅក្នុង ភូមិ ជាប់ ទន្លេ Debed ក្បែរ ព្រំដែន ជាមួយ ហ្សក ហ្ស៉ី ។ ជាមួយគ្នា នេះ ផ្ទះ រាប់ រយ នាក់ ត្រូវបាន ជន់ លិច រីឯ ក្រុម សង្រ្គោះ ២៣០ នាក់ ត្រូវបាន បញ្ជូន ទៅកាន់ តំបន់ នោះ ។ នៅឯ ហ្សក ហ្ស៉ី យ៉ាងហោចណាស់ ភូមិឋាន ចំនួន ១៥ ត្រូវបាន កាត់ផ្តាច់ ដោយសារតែ ភ្លៀង ធ្លាក់ ជោគជាំ ។
ទោះ កំពុង ជាប់ មើល ថែ ប្តី នៅក្នុង មន្ទីរពេទ្យ . សមាជិក ក្រុមប្រឹក្សា សង្កាត់ ផ្សារ ដើម គរ ម្នាក់ សុខចិត្ត ជិះ យន្តហោះ ពី ចក្រភព អង់គ្លេស មក បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ អាណត្តិ ទី៤ នៅ ភ្នំពេញ
លោកស្រី ឈិត ពៅ បាន បន្ត ថា ដោយសារ មាន គណបក្ស ប្រជាជន កម្ពុជា ទើប កម្ពុជា ទទួលបាន សុខ សន្តិភាព . ស្ថេរភាព នយោបាយ និង ការអភិវឌ្ឍ ពាសពេញ ផ្ទៃ ប្រទេស ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ និង បន្ត ដោយ សម្តេច ធិបតី ។ បើ គ្មាន គណបក្ស ប្រជាជន កម្ពុជា ក៏ លោកស្រី គ្មាន ឱកាស មក ឈរ និយាយ មក ចូលរួម ប្រើ សិទ្ធ ស្វ័យ សំរេច ដោយ បង្ហាញ ពី សណ្តានចិត្ត គោរព ស្រឡាញ់ ឥត ងាក រេ ចំពោះ គណបក្ស ប្រជាជន កម្ពុជា ។
ក្នុង វ័យ ៤០ ឆ្នាំ លោកស្រី ឈិត ពៅ បាន គូសបញ្ជាក់ ថា៖ « ពេលនេះ ស្វាមី របស់ លោកស្រី កំពុង សំរាក ព្យាបាល ជំងឺ នៅ ចក្រភព អង់គ្លេស ។ តែ ដើម្បី បង្ហាញ ពី ការសង គុណ ទៅ គណបក្ស ប្រជាជន កម្ពុជា វិញ ដែល លោកស្រី គោរព ស្រឡាញ់ ជារៀងរហូតមក លោកស្រី បាន ទុកឲ្យ ប្តី នៅ មន្ទីរពេទ្យ តែ ម្នាក់ឯង សុខចិត្ត ជិះ យន្តហោះ រាប់ ម៉ឺន គីឡូម៉ែត្រ មក បោះឆ្នោត ដើម្បី មក បំពេញ កាតព្វកិច្ច ជា ពលរដ្ឋ ម្នាក់ និង ជា សមាជិក ក្រុមប្រឹក្សា ម្នាក់ ផងដែរ » ។
លោកស្រី ឈិត ពៅ បាន សបញ្ជាក់ ឱ្យ ឃើញ របស់ សមាជិក សមាជិកា របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល បាន លះបង់ គ្រប់ បែបយ៉ាង ដើម្បី គាំទ្រ គោល នយោបាយ ដ៏ ត្រឹមត្រូវ របស់ គណបក្ស ប្រជាជន កម្ពុជា យ៉ាង ផុល ផុស ។
( ភ្នំពេញ ) ៖ លោកស្រី ឥម នី ថា រ៉ា រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ជា ប្រធាន ក្រុមប្រឹក្សាភិបាល មន្ទីរពិសោធន៍ សំណង់ និង សាធារណការ នា ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ ក្រុមប្រឹក្សាភិបាល នៃ មន្ទីរពិសោធន៍ សំណង់ និង សាធារណការ អាណត្តិ ទី៦ លើក ទី២ ដោយ មាន ការចូលរួម ពី តំណាង ថ្នាក់ដឹកនាំ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ធ្វើឡើង ដោយ ផ្តោត សំខាន់ ទៅ លើ របៀបវារៈ ចំនួន បី៖ ១៖ ពិនិត្យ និង អនុម័ត លើ របាយការណ៍ អនុវត្តន៍ ការងារ អាជីវកម្ម - សេវាកម្ម និង ការងារ វិនិយោគ ប្រចាំ ឆ្នាំ ២០២៣ របស់ មន្ទីរពិសោធន៍ សំណង់ និង សាធារណការ ( មពសស) ២៖ ពិនិត្យ និង អនុម័ត លើ របាយការណ៍ អនុវត្ត ការងារ អាជីវកម្ម - សេវាកម្ម និង ការងារ វិនិយោគ ត្រីមាស ទី១ ឆ្នាំ ២០២៤ របស់ មពសស និង ៣៖ បញ្ហា ផ្សេង ៗ ។
មន្ទីរពិសោធន៍ សំណង់ និង សាធារណការ បាន អនុវត្ត អាជីវកម្ម - សេវាកម្ម ប្រចាំ ឆ្នាំ ២០២៣ ធៀប នឹង ឆ្នាំ ២០២២ ទទួល លទ្ធផល ល្អ ចំណែក ការអនុវត្ត អាជីវកម្ម - សេវាកម្ម ត្រីមាស ទី១ ឆ្នាំ ២០២៤ ធៀប នឹង ត្រីមាស ទី១ ឆ្នាំ ២០២៣ ក៏ បាន ទទួល លទ្ធផល ល្អ ប្រសើរ ផងដែរ ។
ទន្ទឹមនឹង នេះ មន្ទីរពិសោធន៍ សំណង់ និង សាធារណការ បាន គោរព នូវ រាល់ គោលការណ៍ និង កាតព្វកិច្ច ជា សហគ្រាស សាធារណៈ ដោយ បាន ប្រមូល ពន្ធ អាករ លើ តម្លៃ បន្ថែម (VAT) ពី អតិថិជន និង ពន្ធ អាករ ផ្សេង ៗ ជាច្រើន ទៀត បង់ ចូល ថវិកា រដ្ឋ យ៉ាង ត្រឹមត្រូវ ៕
សិក្ខាសាលា ផ្សព្វផ្សាយ ច្បាប់ ស្តីពី វិនិយោគ និង អនុក្រឹត្យ ស្តីពី ការអនុវត្ត ច្បាប់ វិនិយោគ និង កម្មវិធី កសាង សមត្ថភាព មន្ត្រី នៃ អនុគណៈកម្មាធិការ វិនិយោគ ខេត្ត ស្វាយរៀង - ខេត្ត ព្រៃវែង
លោក សរ សុដានី បាន ថ្លែង ថា អង្គ សិក្ខាសាលា ដ៏ មាន សារៈសំខាន់ នា ពេលនេះ គឺ ចាំបាច់ សម្រាប់ វិនិយោគិន ពាណិជ្ជករ ក៏ ដូចជា មន្ត្រីរាជការ នៃ រដ្ឋបាល ខេត្ត ស្វែងយល់ ក្នុង ការអនុវត្ត ច្បាប់ និង ជំរុញ ការអនុវត្ត វិស័យ វិនិយោគ ឲ្យ កាន់តែ ល្អ ប្រសើរឡើង ដើម្បី រួមគ្នា អភិវឌ្ឍន៍ សេដ្ឋកិច្ច ខេត្ត ក៏ ដូចជា សេដ្ឋកិច្ច ជាតិ ជា ប្រយោជន៍ លើកស្ទួយ ជីវភាព ប្រជាជន អោយ សម្បូរសប្បាយ ជា បន្តបន្ទាប់ ។
កិច្ចប្រជុំ នេះ មាន គោលបំណង បង្ហាញ ពី សមិទ្ធផល ឆ្លើយតប នឹង មេរោគ អេដស៍ កម្ពុជា ដែល សម្រេចបាន កន្លងមក ។ ពិនិត្យ នូវ ឋាម វ័ន្ត នៃ ប្រព័ន្ធ រួមគ្នា ក្នុង ការឆ្លើយតប នឹង មេរោគ អេដស៍ ព្រមទាំង ពិនិត្យ និង អនុវត្ត នូវ វិធាន នានា នៃ នូវ គោល នយោបាយ ជាតិ បញ្ចប់ អេដស៍ និង ចីរភាព កម្មវិធី អេដស៍ ក្នុង វិស័យ អភិវឌ្ឍន៍ ជនបទ ។
ជា កិច្ច ចាប់ផ្តើម លោក ទេសរដ្ឋមន្រ្តី អៀង មូលី ប្រធាន អាជ្ញាធរ ជាតិ បាន ថ្លែង នូវ ការស្វាគមន៍ ដល់ ក្រុមការងារ និង អង្គប្រជុំ ដោយ បាន ថ្លែង នូវ ការកោតសរសើរ ដល់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ដែល បាន ប្រឹងប្រែង ចូលរួម ក្នុង ការអនុវត្ត ការឆ្លើយតប នឹង មេរោគ អេដស៍ កន្លងមក ។ ក្នុង ឱកាស នេះ ផងដែរ លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន បញ្ជាក់ ពី តួនាទី ភារកិច្ច របស់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ ស្រប តាម អនុក្រឹត្យ លេខ ១០៩ ។
ទិវា ជីវៈ ចម្រុះ អន្តរជាតិ ឆ្នាំ ២០២៤ ប្រារព្ធ ឡើង ដើម្បី បញ្រ្ជាប និង បង្កើន ការយល់ដឹង ជាសាធារណៈ តម្លៃ ធនធាន ជីវៈ ចម្រុះ
ពិធី នេះ បាន ធ្វើឡើង ក្រោម ធិបតីភាព លោក ជួប ប៉ារីស៍ រដ្ឋលេខាធិការ ក្រសួង បរិស្ថាន តំណាង លោក បណ្ឌិត អ៊ាង សុផល្លែ រដ្ឋមន្រ្តី ក្រសួង បរិស្ថាន និង ជា ប្រធាន ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព . លោក គីម រិទ្ធី អភិបាល ខេត្ត ព្រះវិហារ រួម ជាមួយ ស្ថាប័ន ពាក់ព័ន្ធ អាជ្ញាធរដែនដី អង្គការ ដៃគូ ភ្ញៀវ ជាតិ - អន្តរជាតិ ប្រជា សហគមន៍ លោកគ្រូ អ្នកគ្រូ យុវជន និង សិស្សានុសិស្ស ជាច្រើន កុះករ នៅ វិទ្យាល័យ ស្រយ៉ង់ ខេត្ត ព្រះវិហារ ។
លោក បាន បន្ថែម ថា បាន បញ្ជាក់ ថា ការប្រារព្ធ « ទិវា ជីវៈ ចម្រុះ អន្តរជាតិ ប្រចាំ ឆ្នាំ ២០២៤ » នា ពេលនេះ ក៏ ជា ការបង្ហាញ អំពី សុឆន្ទៈ និង ការប្តេជ្ញាចិត្ត របស់ រាជ រដ្ឋាភិបាល អាណត្តិ ទី៧ និង គោល នយោបាយ របស់ ក្រសួង បរិស្ថាន ក្នុង ការចូលរួមចំណែក យ៉ាង សកម្ម លើ ការគ្រប់គ្រង ធនធាន ជីវៈ ចម្រុះ នៅ ឆាក អន្តរជាតិ ដែល តែងតែ ខិតខំ ប្រឹងប្រែង ក្នុង ការអនុវត្ត អនុសញ្ញា សហ ប្រជាជាតិ ស្តីពី ជីវៈ ចម្រុះ ក្នុង នាម ជា ស្ថាប័ន បង្គោល ផងដែរ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន រូប នេះ បាន បញ្ជាក់ ថា នៅ ថ្ងៃទី ១០ ដល់ ១១ ខែកក្កដា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ក្រសួង បរិស្ថាន នឹង រៀបចំ ពិព័រណ៍ កូន ឈើ ក្រោម ប្រធានបទ « ពន្លក បៃតង » ដែល នឹង មាន ការចែក កូន ឈើ ដោយ ឥត គិត ថ្លៃ ជូន ដល់ សាធារណជន នៅមុខ ទីស្តីការ ក្រសួង បរិស្ថាន ផងដែរ ។
នៅក្នុង ពិធី អបអរសាទរ « ទិវា ជីវៈ ចម្រុះ អន្តរជាតិ ២២ ឧសភា » អ្នកចូលរួម ទាំងអស់ បាន ប្តេជ្ញាចិត្ត ក្នុង យុទ្ធនាការ « ថ្ងៃ នេះ ខ្ញុំ មិន ប្រើ ថង់ ប្លាស្ទិក ទេ » និង យុទ្ធនាការ « កម្ពុជា ស្អាត ខ្មែរ ធ្វើ បាន » ។ បន្ថែម ពី នេះ ចូលរួម បាន នាំគ្នា ដាំ ដើមឈើ ជា និមិត្តរូប ផងដែរ ។
គួរ បញ្ជាក់ ថា ក្រសួង សុខាភិបាល តំបន់ ហ្កាហ្សា បាន ឱ្យដឹង ថា ប្រជាជន ប៉ាឡេស្ទីន ជិត ៣៦.០០០ នាក់ ត្រូវបាន សម្លាប់ ក្រោម ប្រតិបត្តិការ យោធា របស់ អ៉ី ស្រាអែល ដើម្បី សងសឹក នឹង ការវាយឆ្មក់ របស់ ក្រុមហា ម៉ាស លើ ទឹកដី អ៉ី ស្រាអែល កាលពី ថ្ងៃទី ៧ ខែតុលា ឆ្នាំ ២០២៣ ៕
អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី ចោទប្រកាន់ ក្រុម ក្មេង ទំនើង ដែល ជា ជនល្មើស ចំនួន ០៨ នាក់ ពី បទ ហិង្សា ដោយ ចេតនា មាន ស្ថាន ទម្ងន់ ទោស
( រតនគិរី ) ៖ អ្នកនាំពាក្យ អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី ការចោទប្រកាន់ ក្រុម ក្មេង ទំនើង ដែល ជា ជនល្មើស ចំនួន ០៨ នាក់ ពី បទ ហិង្សា ដោយ ចេតនា មាន ស្ថាន ទម្ងន់ ទោស ។
បើ តាម អ្នកនាំពាក្យ នៃ អយ្យការ អម សាលាដំបូង ខេត្ត រតនគិរី កាលពី ថ្ងៃទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី បាន បញ្ជូន សំណុំរឿង ពាក់ព័ន្ធ នឹង ករណី ក្មេង ទំនើង ចំនួន ០២ ក្រុម ដែល បាន វាយប្រតាយ ប្រតប់ គ្នា ទៅ វិញ ទៅមក ដោយ ក្នុង នោះ សមត្ថកិច្ច បាន ឃាត់ខ្លួន ជនល្មើស បាន ចំនួន ០៨ នាក់ ។
ជា កិច្ច ចាប់ផ្តើម សម្ដេច តេជោ ហ៊ុន សែន បាន សម្តែង នូវ ក្ដីរីករាយ ដែល បាន ជួប ឯក អគ្គ រដ្ឋទូត ប៉ុន្តែ ក៏ មាន អារម្មណ៍ សោកស្តាយ ដោយ ចប់ បេសកកម្ម និង ត្រូវ ចាកចេញ ពី កម្ពុជា ។
សម្តេច បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ឯក អគ្គ រដ្ឋទូត ដែល បាន ចូលរួមចំណែក ពង្រឹង និង ពង្រីក ទំនាក់ទំនង កម្ពុជា - ចិន ក្នុង ពេល លោក កាន់ តំណែង ជា ឯក អគ្គ រដ្ឋទូត ប្រចាំ នៅ កម្ពុជា ជិត៦ ឆ្នាំ ដែល ជា អំឡុង ពេល រវល់ ខ្លាំង និង បាន ធ្វើ កិច្ចការ រួមគ្នា ជាច្រើន ប្រកបដោយ ជោគជ័យ ដ៏ ត្រចះត្រចង់ ជាពិសេស នៅក្នុង ដំណាក់កាល នៃ ជំងឺ កូវីដ ដែល សម្តេច បាន ធ្វើការ យ៉ាង ស្និត រមួត ជាមួយ លោក ក្នុង ការខិតខំ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ ឆ្លង នេះ ។
លោក ក៏ បាន ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ លោក ប្រធានាធិបតី ស៊ី ជីន ពីង លោក នាយក រដ្ឋមន្ត្រី លី ឈាង ជូន សម្ដេច តេជោ ។ លោក ក៏ បាន សម្ដែង ការអបអរសាទរ ចំពោះ ជោគជ័យ យ៉ាង ត្រចះត្រចង់ នៃ ការបោះឆ្នោត បន្ត បន្ទាប់ របស់ គណបក្ស ប្រជាជន កម្ពុជា ជាពិសេស ការបោះឆ្នោត ជ្រើសរើស សមាជិក ព្រឹទ្ធសភា នា ខែកុម្ភៈ កន្លងមក ដែល ជា សក្ខីភាព នៃ ការទុកចិត្ត របស់ ប្រជាជន កម្ពុជា ចំពោះ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក បាន សង្កត់ បញ្ជាក់ ថា ចិន និង កម្ពុជា គឺជា មិត្ត ប្រពៃណី និង មិត្ត ដែក ថែប ។ លោក មាន កិត្តិយស បំផុត ក្នុង ជីវិត របស់ លោក ដែល បាន ធ្វើជា ឯក អគ្គ រដ្ឋទូត ប្រចាំ នៅ កម្ពុជា និង ត្រូវបាន ផ្តល់ ឱកាស ឱ្យ ចូលរួម លើកកម្ពស់ ទំនាក់ទំនង ចិន - កម្ពុជា និង ចូលរួម ព្រឹត្តិការណ៍ ជា ប្រវត្តិសាស្ត្រ ជាច្រើន នៅ កម្ពុជា ។
លោក មាន ការពេញចិត្ត បំផុត ដែល បាន ធ្វើការ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ក្នុង នីតិកាល ទី៦ និង ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ក្នុង នីតិកាល ទី៧ នៃ រដ្ឋសភា ដែល បាន នាំមក នូវ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច និង សុខុមាលភាព ជូន ប្រជាជន កម្ពុជា ។ លោក បាន អបអរសារ កម្ពុជា ដែល មាន ការផ្ទេរ អំណាច ដោយ រលូន ដល់ ថ្នាក់ដឹកនាំ ជំនាន់ ក្រោយ និង អបអរសាទរ សម្តេច ដែល បាន ជាប់ ឆ្នោត ជា ប្រធាន ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ក្រោម គំនិត ផ្តួចផ្តើម ខ្សែក្រវាត់ និង ផ្លូវ (BRI) ចិន និង កម្ពុជា បាន សហការ ប្រែក្លាយ ក្រុង ព្រះសីហនុ ទៅជា តំបន់ សេដ្ឋកិច្ច ពិសេស គំរូ ពហុ បំណង និង កសាង ហេដ្ឋ រចនាសម្ព័ន្ធ ជាច្រើន ជាពិសេស តំបន់ សេដ្ឋកិច្ច ពិសេស ខេត្ត ព្រះសីហនុ ផ្លូវ ល្បឿន លឿន រាជធានី ភ្នំពេញ - ក្រុង ព្រះសីហនុ និង អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប ពហុកីឡាដ្ឋាន មរត តេជោ - ល - ។ ជា លទ្ធផល នៃ ការចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី (FTA) ចិន - កម្ពុជា ទំហំ ពាណិជ្ជកម្ម នៃ ប្រទេស ទាំង ពីរ បាន កើនឡើង សន្ធឹកសន្ធាប់ ។
លោក ក៏ បាន រំលឹក ផងដែរ អំពី ភាពជោគជ័យ របស់ កម្ពុជា ក្នុង ការរៀបចំ កិច្ចប្រជុំ កំពូល អាស៊ី - អឺរ៉ុប ជា ប្រធាន អាស៊ាន និង ការរៀបចំ ការប្រកួត កីឡា ស៊ីហ្គេម ដែល បាន លើកកម្ពស់ កម្ពុជា នៅក្នុង ឆាក អន្តរជាតិ ព្រមទាំង ភាពជោគជ័យ របស់ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដោយ មាន ការចូលរួមចំណែក របស់ ប្រទេស និង ប្រជាជន ចិន ។ នេះ គឺ សក្ខីភាព បញ្ជាក់ ពី ការរួម សុខ រួម ទុក្ខ របស់ ចិន ជាមួយ កម្ពុជា ។
លោក បាន ថ្លែងអំណរគុណ សម្តេច និង រាជ រដ្ឋាភិបាល កម្ពុជា ដែល រក្សា ជំហរ យុត្តិធម៌ ស្តីពី សមុទ្រ ចិន ខាងត្បូង បញ្ហា កោះ តៃវ៉ាន់ និង តំបន់ ស៊ីង ជាំង សំដៅ ការពារ ផលប្រយោជន៍ ចិន - កម្ពុជា និង ផលប្រយោជន៍ អាស៊ាន - ចិន ។ ស្ថានការណ៍ ពិភពលោក ប្រែប្រួល ទំនាក់ទំនង ចិន - កម្ពុជា មិន ប្រែប្រួល ទេ ។ លោក បាន លើកឡើង ថា ប្រជាជន ចិន នឹង មាន ក្តីរំភើប ទទួល ទស្សនកិច្ច របស់ សម្តេច តេជោ នៅ ប្រទេស ចិន នា ពេល ខាងមុខ ។
សម្ដេច តេជោ បាន គូសបញ្ជាក់ ថា ទំនាក់ទំនង កម្ពុជា - ចិន ដែល ជា ទំនាក់ទំនង ប្រវត្តិសាស្ត្រ យូរអង្វែង បាន រីកចម្រើន រហូតដល់ កម្រិត ដែល មិន អាច បំបែក បាន ។ ទំនាក់ទំនង នេះ ស័ក្តិសម នឹង គុណ តម្លៃ នៃ ការជឿទុកចិត្ត គ្នា ជាពិសេស ទំនុកចិត្ត ខាង នយោបាយ ។ ជំនួយ របស់ ប្រទេស ចិន ដល់ ប្រទេស កម្ពុជា មិន ត្រឹមតែ ជួយ អភិវឌុ្ឍ សង្គម - សេដ្ឋកិច្ច ប៉ុណ្ណោះ ទេ តែ ថែមទាំង ជួយ ពង្រឹង ឯករាជ្យភាព ខាង នយោបាយ របស់ កម្ពុជា ទៀតផង ។
សម្ដេច បាន បញ្ជាក់ សា ជា ថ្មី ថា ទោះ មាន ការផ្លាស់ប្ដូរ នាយក រដ្ឋមន្ត្រី និង គណៈ រដ្ឋមន្ត្រី នៅ កម្ពុជា ក៏ដោយ ក៏ ពុំ មាន ការផ្លាស់ប្ដូរ គោលជំហរ ក្នុង ទំនាក់ទំនង កម្ពុជា ជាមួយ ចិន នោះ ឡើយ និង ជូនពរ មិត្តភាព កម្ពុជា - ចិន ស្ថិតស្ថេរ ជា អមតៈ ។
ទាក់ទង ទៅ នឹង កិច្ចសហប្រតិបត្តិការ ទប់ស្កាត់ ជំងឺ កូវីដ១៩ សម្ដេច តេជោ បាន សម្ដែង នូវ ការអរគុណ ចំពោះ មិត្ត ចិន ដែល ធ្វើឲ្យ កម្ពុជា អាច ទប់ទល់ នឹង ជំងឺ នេះ បាន ប្រកបដោយ ភាពជោគជ័យ ។ សម្ដេច តេជោ ក៏ បាន កោតសរសើរ លោក ឯក អគ្គ រដ្ឋទូត ដែល បាន ជួយ ដល់ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ កន្លងទៅ នេះ ។
ជា ចុងក្រោយ សម្ដេច តេជោ ប្រធាន ព្រឹទ្ធសភា បាន សុំឲ្យ លោក ពាំនាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្ដេច ទៅកាន់ ប្រធានាធិបតី ចិន ស៊ី ជីន ពីង . នាយក រដ្ឋមន្ត្រី លី ឈាង និង ថ្នាក់ដឹកនាំ ចិន ដទៃ ទៀត និង សូម ជូនពរ លោក មាន សុខភាព ល្អ បន្ត នូវ ភាពជោគជ័យ ជា បន្តបន្ទាប់ ទៀត និង សង្ឃឹម ថា លោក នឹង ត្រឡប់មក ប្រទេស កម្ពុជា និង មាន វត្តមាន នៅ កម្ពុជា នា ពេល ខាងមុខ ៕
( ភ្នំពេញ ) ៖ លោក ឆាយ ឫទ្ធិ សែន រដ្ឋមន្ត្រី ក្រសួង អភិវឌ្ឍន៍ ជនបទ នា ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ បាន ដឹកនាំ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ប្រចាំ ខែឧសភា និង លើក ទិសដៅ ការងារ ខែមិថុនា ឆ្នាំ ២០២៤ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ។
កិច្ចប្រជុំ មាន ការចូលរួម ដោយ ផ្ទាល់ ពីសំណាក់ រដ្ឋលេខាធិការ ប្រចាំ ការ អនុ រដ្ឋលេខាធិការ អគ្គ នាយក អគ្គ នាយក រង ប្រធាន នាយកដ្ឋាន ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ និង មាន ការចូលរួម ពីសំណាក់ មន្ទីររអភិវឌ្ឍន៍ ជនបទ ទាំង ២៥ រាជធានី - ខេត្ត តាមរយៈ ប្រព័ន្ធ និម្មិត (Zoom Meeting) ផងដែរ ដោយ កិច្ចប្រជុំ នេះ មាន អ្នកចូលរួម សរុប ចំនួន ៤៥៤ នាក់ ។
បន្ទាប់ពី ស្តាប់ របាយការណ៍ រួច មក លោក ឆាយ ឫទ្ធិ សែន បាន ថ្លែងអំណរគុណ ចំពោះ ថ្នាក់ដឹកនាំ និង មន្ដ្រីរាជការ ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ លើ សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ ជាពិសេស ក្នុង ស្ថានភាព ដែល ប្រជាជន នៅ តំបន់ ជនបទ បាន ជួបប្រទះ នឹង ការខ្វះខាត ទឹក បរិភោគ និង ទឹក ប្រើប្រាស់ នៅក្នុង រដូវ ប្រាំង ដែល អូសបន្លាយ រយៈ យូរ ដោយសារ កត្តា ប្រែប្រួល អាកាសធាតុ ។
លោក រដ្ឋមន្ត្រី បាន ឲ្យដឹង ថា ក្រសួង បាន និង កំពុង យកចិត្តទុកដាក់ ក្នុង ការចូលរួម កំណែទម្រង់ ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង នោះ ក្រសួង បាន និង កំពុង ជំរុញ ការបញ្ចប់ ការវិភាគ មុខងារ របស់ ក្រសួង នា ពេល ខាងមុខ ដើម្បី ធានា ដល់ ការបំពេញ តួនាទី ភារកិច្ច បម្រើ ជូន ប្រជាពលរដ្ឋ ឱ្យ មាន ប្រសិទ្ធភាព តាមរយៈ ការចាត់តាំង មន្ដ្រី ឱ្យ ត្រូវ តាម ជំនាញ បទពិសោធន៍ និង មាន ចំនួន គ្រប់គ្រាន់ ។
លើស ពី នេះ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ក៏ គ្រោង នឹង បញ្ចប់ ការរៀបចំ គោល នយោបាយ ជាតិ អភិវឌ្ឍន៍ ជនបទ ឆ្នាំ ២០២៥ - ២០៣៨ នៅក្នុង ឆ្នាំ ២០២៤ នេះ ដើម្បី ជា ការចូលរួម អនុវត្ត យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ ក្រោម ការដឹកនាំ របស់ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ជាមួយ នេះ លោក រដ្ឋមន្រ្ដី បាន ផ្ដាំផ្ញើ ដល់ ថ្នាក់ដឹកនាំ និង ផ្ដល់ អនុសាសន៍ ជូន ដល់ មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ដូច ខាងក្រោម៖
* ប្រធាន អង្គភាព ទាំងអស់ ទាំង នៅ ថ្នាក់ ជាតិ និង ថ្នាក់ ក្រោម ជាតិ ត្រូវ រៀបចំ ឱ្យ មាន សៀវភៅ កំណត់ត្រា ការងារ ប្រចាំ ថ្ងៃ សម្រាប់ មន្ដ្រី កត់ត្រា រាល់ លទ្ធផល ការងារ ដែល អនុវត្ត បាន ប្រចាំ ថ្ងៃ ។
* ក្នុង នាម មន្ដ្រីរាជការ ត្រូវ បម្រើ ប្រជាពលរដ្ឋ ប្រកបដោយ ក្រមសីលធម៌ និង វិជ្ជាជីវៈ . ត្រូវ គោរព វិន័យ របៀបរបប ធ្វើ ការ . ត្រូវ អនុវត្ត ការងារ ទៅ តាម រាល់ ការចាត់តាំង របស់ ប្រធាន អង្គភាព និង ត្រូវ រាយការណ៍ និង សុំ អន្ដរាគមន៍ ពេល ជួបប្រទះ ការប្រឈម នានា ។
មេធាវី តំណាង ស្រ្តី ម្នាក់ ជូនដំណឹង ទៅ លោកជំទាវ មួយ រូប ឱ្យ ចូល ខ្លួន ដោះស្រាយ ប្រគល់ ប្លង់ ដី និង សង ប្រាក់ ១០ម៉ឺន ដុល្លារ ក្រោយ យក ប្រាក់ ទៅ រត់ ការ មិន បាន សម្រេច
( ភ្នំពេញ ) ៖ លោក មេធាវី ផាង លាង សេង និង លោក មេធាវី វង្ស វុត្ថា ជា តំណាង ឱ្យ កូន ក្ដី ឈ្មោះ គង់ ធីតា កាលពី ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២៤ កន្លងទៅ បាន ចេញ លិខិត ជូន ដំណឹង មួយ ជូន ស្រី ល្បី ឈ្មោះ ម្នាក់ ដែល គេ ស្គាល់ ថា លោកជំទាវ គង់ មាលា ឱ្យ ចូលរួម ដោះស្រាយ ប្រគល់ លុយ ១០ម៉ឺន ដុល្លារ និង ប្លង់ ដី ជូន កូន ក្ដី របស់ ពួក លោក វិញ ដែល នេះ ជា ទម្រង់ សម្របសម្រួល គ្នា ដើម្បី បញ្ចៀស នូវ ការប្តឹង ផ្តល់ តាម ផ្លូវ ច្បាប់ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារលិខិត ជូន ដំណឹង របស់ មេធាវី៖
អភិបាល ស្រុក ស្ទោង សួរសុខទុក្ខ និង ចែក អំណោយ ជូន ពលរដ្ឋ ក្រីក្រ ដែល ទទួល រងគ្រោះ ដោយ ភាពរាំងស្ងួត
( កំពង់ធំ )៖ នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ លោក សាយ គឹម ឡម អភិបាល ស្រុក ស្ទោង និង លោកស្រី ចាន់ សុផល ប្រធាន អង្គការ ទស្សន ពិភពលោក ប្រចាំ តំបន់ ស្ទោង២ និង សហការី បាន អញ្ជើញ សំណេះ សំណាល សួរសុខទុក្ខ និង ចែក អំណោយ ជូន ពលរដ្ឋ ក្រីក្រ ដែល ទទួល រងគ្រោះ ដោយ ភាពរាំងស្ងួត កាលពី ពេល ថ្មី ៗ កន្លងទៅ នេះ នៅក្នុង ឃុំ រុងរឿង ស្រុក ស្ទោង ខេត្ត កំពង់ធំ ។
ថ្លែង ទៅកាន់ ពុក ម៉ែ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ក៏ ដូចជា អាជ្ញាធរ ឃុំ រុងរឿង នៅក្នុង ឱកាស នោះ លោក សាយ គឹម ឡម បាន ណែនាំ រដ្ឋបាល ឃុំ រុងរឿង ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ពី សុខ មាលភាព ប្រជាពលរដ្ឋ ជាពិសេស ត្រូវ ខិតខំ កសាង ប្រព័ន្ធ ធារាសាស្ត្រ ឲ្យបាន ច្រើន ស្អេកស្កះ ដើម្បី លើកកម្ពស់ សេដ្ឋកិច្ច គ្រួសារ កសិករ ឱ្យ កាន់តែ ប្រសើរឡើង និង កាត់បន្ថយ ចំណាកស្រុក របស់ ពលរដ្ឋ ទៅ ស្រុក ខេត្ត ឬ ក៏ ប្រទេស ផ្សេង ដែល អាច នាំឲ្យ ប្រឈម នឹង ហានិភ័យ ផ្សេង ៗ ជាពិសេស ការចាញ់បោក មេខ្យល់ នៅ ប្រទេស ក្រៅ ជាដើម ។
ជាមួយគ្នា នេះ លោក អភិបាល ស្រុក ស្ទោង បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ អង្គការ ទស្សន ពិភពលោក កម្ពុជា ដែល តែងតែ សហការ និង ឧបត្ថម្ភ គាំទ្រ ជ្រោមជ្រែង សព្វ បែប យ៉ាង ក្នុង កិច្ចការ អភិវឌ្ឍន៍ ស្រុក ស្ទោង ក៏ ដូចជា ការជួយ ឧបត្ថម្ភ គ្រួសារ ងាយ រងគ្រោះ វិស័យ សង្គមកិច្ច អប់រំ និង វិស័យ ផ្សេង ៗ ទៀត ជាច្រើន ។
គួរ បញ្ជាក់ ថា អំណោយ ដែល បាន ចែកជូន ពុក ម៉ែ បងប្អូន ប្រជាពលរដ្ឋ ទាំង ៥០ គ្រួសារ នៅក្នុង ឱកាស នេះ ជា ជំនួយ របស់ ប្រទេស ម៉ាឡេស៊ី តាមរយៈ អង្គការ ទស្សន ពិភពលោក កម្ពុជា ប្រចាំ ស្រុក ស្ទោង ដែល ក្នុង មួយ គ្រួសារ ៗ ទទួលបានូវ អង្ករ ១បេ ទឹក ស៊ីអ៊ីវ១យួរ ទឹកត្រី ១យួរ មី១កេះ និង ទឹក សុទ្ធ ព២ប៊ី ដុង ដែល ១ប៊ី ដុង ស្មើនឹង ២០លីត្រ៕
កម្លាំង នគរបាល ខេត្ត ព្រះវិហារ ឃាត់ខ្លួន ក្រុម ក្មេង ទំនើង ៩នាក់ ដែល តែងតែ ជិះ ម៉ូតូ បង្ហោះ បង្ក ការអុក ឡុក ក្នុង ក្រុង ព្រះវិហារ . ដកហូត ដាវ និង កាំបិត ផ្គាក់ ចំនួន ៣ដើម
( ព្រះវិហារ ) ៖ ក្រុម ក្មេង ទំនើង ចំនួន ២ក្រុម មាន គ្នា ចំនួន ៩នាក់ ដែល តែងតែ ជិះ ម៉ូតូ បង្ហោះ បង្ក ការអុក ឡុក ក្នុង ក្រុង ព្រះវិហារ ត្រូវបាន កម្លាំង នគរបាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះវិហារ ឃាត់ខ្លួន ជាមួយនឹង ការដកហូត បាន នូវ ដាវ ចំនួន ១ដើម និង កាំបិត ផ្គាក់ ចំនួន ២ដើម និង ម៉ូតូ ចំនួន ៣គ្រឿង ។
ការឃាត់ខ្លួន ក្រុម ក្មេង ទំនើង ទាំងនេះ គឺ ធ្វើឡើង ក្រោម បញ្ជា ដ៏ ម៉ឺងម៉ាត់ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ និង គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ព្រះវិហារ ក៏ ដូចជា បទបញ្ជា ដ៏ ម៉ឺងម៉ាត់ របស់ លោក ឧត្តមសេនីយ៍ ទោ សួស សុខ ដារ៉ា ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ ។
លោក គង់ គា បាន ថ្លែង ឱ្យដឹង ថា កម្លាំង ជំនាញ កំពុង កសាង សំណុំរឿង បញ្ជូន ក្រុម ក្មេង ទំនើង ទាំងនេះ ទៅ អយ្យការ អម សាលាដំបូង ខេត្ត ព្រះវិហារ ដើម្បី ចាត់ការ ទៅតាម និតិវិធី ច្បាប់ ។
លោក យុង គឹម ហ៊ាន បាន ផ្តាំផ្ញើ របស់ លោក អភិបាល ខេត្ត ព្រះវិហារ ដោយ ណែនាំ បងប្អូន ប្រជាពលរដ្ឋ យើង ជាពិសេស តាមរយៈ គ្រួសារ ប្អូន ប្រុស រងគ្រោះ ឱ្យ បងប្អូន យើង ដែល ប្រកបរបរ នៅក្នុង ព្រៃ ដូចជា បោចវល្លិ៍ បេះ ផ្លែ ឈើ រក ផ្សិត ដង ជ័រ ឬ ក៏ ប្រកបរបរ ផ្សេង ៗ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្លួន ជានិច្ច ការពារ ពី សត្វ កាច សាហាវ ផ្សេង ៗ ពិសេស កុំ ចូល ព្រៃ ជ្រៅ តែ ម្នាក់ឯង ឱ្យ សោះ ។
អំណោយ របស់ លោក អភិបាល ខេត្ត ព្រះវិហារ នាំមក ប្រគល់ជូន ជនរងគ្រោះ នា ពេលនេះ រួម មាន៖ អង្ករ ៣០គ .ក ភេសជ្ជៈ ( ទឹក ផ្លែឈើ ) ចំនួន ២កេស ទឹកដោះ ឆៅ ចំនួន ២៤ កំប៉ុង ទឹក បរិសុទ្ធ ចំនួន ២កេស និង ថវិកា ចំនួន ១លាន រៀល ផងដែរ ។
សូម បញ្ជាក់ ថា ក្មេងប្រុស រងគ្រោះ ដោយសារ សត្វ ដំរី ព្រៃ វ័ធ និង តប់ ដោយ ប្រម៉ោយ គឺ កើតឡើង នៅ ព្រឹក ថ្ងៃទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ ខណៈ ដែល ក្មេងប្រុស រងគ្រោះ និង ក្មេងប្រុស ម្នាក់ ទៀត ដើរ ចូល ព្រៃ ក្នុង ដែន ជម្រក សត្វ ព្រៃ ព្រះរកា ប្រមាណ ៥គីឡូម៉ែត្រ ពី ភូមិ ដើម្បី រក ផ្សិត ប៉ក់ ចៃដន្យ ជួប នឹង សត្វ ដំរី ហើយក៏ ត្រូវ សត្វ ដំរី ដេញ វាត់ តប់ និង ប្រម៉ោយ បណ្តាលឱ្យ រងរបួស តែម្តង ៕
អង្គភាព ប្រឆាំង អំពើពុករលួយ និង គណៈកម្មាធិការ ត្រួតពិនិត្យ រដ្ឋ ខេត្ត ក្វាង ទុង ប្ដេជ្ញា បង្កើន កិច្ចសហប្រតិបត្តិការ ប្រឆាំង អំពើពុករលួយ និង ផ្លាស់ប្ដូរ ព័ត៌មាន ទៅ វិញ ទៅមក ពាក់ព័ន្ធ មុខ សញ្ញា ទាំងឡាយ
( ភ្នំពេញ ) ៖ អង្គភាព ប្រឆាំង អំពើពុករលួយ (ACU) និង គណៈកម្មាធិការ ត្រួតពិនិត្យ រដ្ឋ ខេត្ត ក្វាង ទុង នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន ប្ដេជ្ញា បង្កើន កិច្ចសហប្រតិបត្តិការ ប្រឆាំង អំពើពុករលួយ រួមគ្នា ពិសេស កិច្ចសហប្រតិបត្តិការ ផ្លាស់ប្ដូរ ព័ត៌មាន ទៅ វិញ ទៅ មក ក៏ ដូចជា ការស្វែងរក អង្កេត និង ឃាត់ខ្លួន មុខ សញ្ញា ទាំងឡាយ ដែល រត់គេចខ្លួន ចេញ ពី ប្រទេស ចិន មក កម្ពុជា ឬ ពី ប្រទេស កម្ពុជា ទៅ ប្រទេស ចិន ។
ការប្ដេជ្ញា នេះ ធ្វើឡើង ស្រប ពេល ទស្សនកិច្ច របស់ គណៈប្រតិភូ នៃ គណៈកម្មាធិការ ត្រួតពិនិត្យ រដ្ឋ ខេត្ត ក្វាង ទុង នៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ នា ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ ក្នុង គោលបំណង ផ្លាស់ប្តូរ បទពិសោធ និង ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ កិច្ចការ ប្រឆាំង អំពើពុករលួយ នៃ ប្រទេស ទាំង ពីរ ។
គណៈប្រតិភូ ភាគី ចិន នេះ ដឹកនាំ ដោយ លោក សុង ហ្វ៊ូ ឡុង (Song Fulong) សមាជិក គណៈកម្មាធិការ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ បក្ស កុម្មុយនិស្ត ចិន ខេត្ត ក្វាង ទុង លេខាធិការ នៃ គណៈកម្មការ អធិការកិច្ច វិន័យ នៃ គណៈកម្មាធិការ បក្ស កុម្មុយនិស្ត ចិន ខេត្ត ក្វាង ទុង និង ជា ប្រធាន នៃ គណៈកម្មាធិការ ត្រួតពិនិត្យ រដ្ឋ ខេត្ត ក្វាង ទុង ដែល មាន ការទទួលស្វាគមន៍ ដោយ លោក កិត្តិនីតិកោសល បណ្ឌិត ឱម យ៉ិន ទៀង ទេសរដ្ឋមន្រ្តី ប្រធាន អង្គភាព ប្រឆាំង អំពើពុករលួយ ។
លោក ទេសរដ្ឋមន្រ្តី ឱម យ៉ិនទៀង បាន ប្រាប់ ទៅ គណៈប្រតិភូ ប្រទេស ចិន ក្នុង ពេល ទស្សនកិច្ច ថា នៅ ថ្ងៃទី ១៧ ខែមេសា ឆ្នាំ ២០១០ កន្លងទៅ រដ្ឋសភា កម្ពុជា បាន អនុម័ត ច្បាប់ ស្តីពី ការប្រឆាំង អំពើពុករលួយ និង បង្កើត ស្ថាប័ន ប្រឆាំង អំពើពុករលួយ ។ ការប្រឆាំង អំពើពុករលួយ ឈរ លើ គោលការណ៍ ធំ ៗ ចំនួន ៣ រួម មាន៖ ទី១ - ការអប់រំ ដោយ អប់រំ ឱ្យ ស្អប់ អំពើពុករលួយ អប់រំ ឱ្យ ស្រឡាញ់ សុចរិតភាព និង ស្រឡាញ់ ភាពស្អាតស្អំ . ទី២ - ការបង្ការ និង ទប់ស្កាត់ . ទី៣ - បង្ក្រាប និង កសាង សំណុំរឿង ទៅ តុលាការ ។
លោក សុង ហ្វ៊ូ ឡុង បាន អរគុណ ដល់ លោក កិត្តិនីតិកោសល បណ្ឌិត ឱម យ៉ិនទៀង ដែល បាន ទទួលស្វាគមន៍ យ៉ាង កក់ក្តៅ និង បាន ចែករំលែក បទពិសោធន៍ ប្រឆាំង អំពើពុករលួយ នៅ កម្ពុជា ឱ្យ គណៈប្រតិភូ ប្រទេស ចិន បាន ដឹង ។ ក្រៅពី នេះ លោក ក៏ បាន អញ្ជើញ លោក ទេសរដ្ឋមន្ត្រី ឱម យ៉ិនទៀង ធ្វើ ទស្សនកិច្ច នៅ ខេត្ត ក្វាង ទុង ដើម្បី បង្កើន កិច្ចសហប្រតិបត្តិការ លើ កិច្ចការ ប្រយុទ្ធ ប្រឆាំង អំពើពុករលួយ បន្ថែម ទៀត ។
ភាគី អង្គភាព ប្រឆាំង អំពើពុករលួយ និង ភាគី គណៈកម្មាធិការ ត្រួតពិនិត្យ រដ្ឋ ខេត្ត ក្វាង ទុង បាន ប្ដេជ្ញា បង្កើន កិច្ចសហប្រតិបត្តិការ ប្រឆាំង អំពើពុករលួយ រួមគ្នា ពិសេស កិច្ចសហប្រតិបត្តិការ ផ្លាស់ប្ដូរ ព័ត៌មាន ទៅ វិញ ទៅ មក ក៏ ដូចជា ការស្វែងរក អង្កេត និង ឃាត់ខ្លួន មុខ សញ្ញា ទាំងឡាយ ដែល រត់គេចខ្លួន ចេញ ពី ប្រទេស ចិន មក កម្ពុជា ឬ ពី ប្រទេស កម្ពុជា ទៅ ប្រទេស ចិន ។
គួរ បញ្ជាក់ ដែរ ថា ក្នុង ពេល ទស្សនកិច្ច នៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ គណៈប្រតិភូ ប្រទេស ចិន បាន ទស្សនា នៅ ទីតាំង មួយចំនួន ដូចជា បន្ទប់ វិភាគ ពាក្យបណ្ឌឹង បន្ទប់ Polygraph បន្ទប់ ប្រតិបត្តិការ បន្ទប់ ស្តាប់ ចម្លើយ បន្ទប់ សម្រាក ជនសង្ស័យ ឬ ជន ឃាត់ខ្លួន និង បន្ទប់ ឃ្លាំង ប្រកាស ទ្រព្យសម្បត្តិ និង បំណុល ជាដើម ៕
ពលរដ្ឋ ក្រីក្រ ៣០០ គ្រួសារ រស់ នៅ សង្កាត់ គោក ចក ក្រុង សៀមរាប ទទួលបាន អំណោយ ពី អង្គការ សមាគម សង្គ្រោះ ជីវិត មកពី ប្រទេស សឹង្ហបុរី
( សៀមរាប ) ៖ អ្នកតំណាងរាស្ត្រ មណ្ឌល សៀមរាប លោក សៀង ណាំ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ បាន ដឹកនាំ សប្បុរសជន អង្គការ សមាគម សង្គ្រោះ ជីវិត មកពី ប្រទេស សឹង្ហបុរី បាន ចុះ ចែក អំណោយ ដល់ ប្រជាជន ក្រីក្រ ចំនួន ៣០០ គ្រួសារ រស់ នៅ សង្កាត់ គោក ចក ក្រុង - ខេត្ត សៀមរាម ។
ក្នុង ពិធី សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ លោក សៀង ណាំ បាន ថ្លែង ថា នេះ គឺ សកម្មភាព មនុស្សធម៌ គឺជា ការចែករំលែក សេចក្តីស្រឡាញ់ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ពីសំណាក់ ជនជាតិ បរទេស ហើយ លោក បាន សំណូមពរ ប្រជាពលរដ្ឋ ថែទាំ សុខភាព ពិសារ ទឹក ឱ្យ បាន គ្រប់គ្រាន់ និង អនាម័យ ជាប្រចាំ ។
លោក សៀង ណាំ បាន លើកឡើង ថា អំណោយ បន្តិចបន្តួច នេះ គ្រាន់ ជា ការជួយ ដោះ ទាល់ បាន មួយ គ្រា ប៉ុណ្ណោះ ៕ សម្តេច តេជោ ហ៊ុន សែន អនុញ្ញាតឲ្យ ឯក អគ្គ រដ្ឋទូត បង់ក្លាដែស ចូល ជួប សម្ដែង ការគួរសម និង ពិភាក្សា ការងារ
ភ្លាម ៗ បន្ទាប់ពី នោះ រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង ក៏ បាន និយាយ ដែរ ថា កូរ៉េ ខាងជើង បាន ចេញ សេចក្តីជូនដំណឹង ស្តី អំពី ការត្រៀម បាញ់ បង្ហោះ ផ្កាយ រណប ឈ្លប ការណ៍ យោធា ១គ្រឿង ។ ការជូនដំណឹង នេះ កើត មាន ឡើង ស្រប ពេល កូរ៉េ ខាងត្បូង ជប៉ុន និង ចិន បើក កិច្ចប្រជុំ កំពូល ត្រី ភាគី ឡើងវិញ ជា លើក ដំបូង ក្រោយ ខកខាន អស់ រយៈពេល ជិត ៥ឆ្នាំ ។
ក្រសួង ការបរទេស ជប៉ុន បាន ឱ្យដឹង ថា ឆ្លើយតប ចំពោះ ការជូនដំណឹង ខាងលើ ក្រុម មន្រ្តី អាមេរិក ជប៉ុន និង កូរ៉េ ខាងត្បូង បាន សន្ទនា គ្នា តាម ទូរស័ព្ទ ហើយ មាន ទស្សនៈ ដូចគ្នា ថា ការបាញ់ បង្ហោះ ផ្កាយ រណប របស់ កូរ៉េ ខាងជើង ដោយ ប្រើប្រាស់ បច្ចេកវិទ្យា មីស៉ីល បាលិស្ទី គ គឺ នឹង បំពាន សេចក្តីសម្រេច របស់ អង្គការ សហ ប្រជាជាតិ ។ មិន តែ ប៉ុណ្ណោះ ក្រុម មន្រ្តី នៃ ប្រទេស ទាំង៣ បាន ឯកភាព គ្នា ទាមទារ ឱ្យ កូរ៉េ ខាងជើង លុបចោល ផែនការបាញ់ បង្ហោះ ផ្កាយ រណប នេះ វិញ ។
គួរ បញ្ជាក់ ថា ប្រសិនបើ ជោគជ័យ វា នឹង ជា ផ្កាយ រណប ចារកម្ម គ្រឿង ទី២ហើយ របស់ ទីក្រុង ព្យុងយ៉ាង ដែល ត្រូវបាន ដាក់ ទៅក្នុង ទី អវកាស ។ កូរ៉េ ខាងជើង បាន បាញ់ បង្ហោះ ផ្កាយ រណប ចារកម្ម យោធា ដំបូង បំផុត របស់ ខ្លួន កាលពី ខែវិច្ឆិកា ឆ្នាំ ២០២៣ ក្រោយ ទទួលបរាជ័យ ២លើក ក្នុង ឆ្នាំ ដដែល នោះ ៕ ហេតុ អ្វី បានជា យើង ត្រូវ សិក្សា « របៀប សរសេរ ព័ត៌មាន ស៊ើបអង្កេត និង អត្ថបទ យក ការណ៍ » ?
បទ យក ការណ៍ ធ្វើឱ្យ អ្នកអាន ស្តាប់ និង ទស្សនា យល់ដឹង កាន់តែ ស៊ីជម្រៅ និង កាន់តែ ជក់ចិត្ត អំពី សាច់រឿង ដែល អ្នកសារព័ត៌មាន បាន គាស់ក កាយ ចេញមក ដើម្បី បង្ហាញ អំពី ភាពសំខាន់ ណាមួយ ដ៏ គួរឱ្យ ភ្ញាក់ផ្អើល ។ ចំណែក ព័ត៌មាន ស៊ើបអង្កេត គឺជា ជំនាញ ក្នុង ការស្រាវជ្រាវ ចុះ តាមដាន រឿងរ៉ាវ ណាមួយ ដើម្បី ប្រមូល យក ព័ត៌មាន លម្អិត ពិតជាក់ស្តែង មក ផ្សាយ ជូន មិត្ត អ្នកអាន ស្តាប់ និង ទស្សនា ។
វគ្គ សិក្សា នេះ នឹង បង្រៀន ផ្ទាល់ ដោយ លោក ម៉ារ យ៉ារិទ្ធិ ប្រធាន FTC និង ជា អ្នកជំនាញ សារព័ត៌មាន ជិត ៤០ ឆ្នាំ ដោយ ចាប់ផ្តើម ទទួល ពាក្យ ចុះឈ្មោះ ចូលរៀន ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ រហូតដល់ ថ្ងៃទី ០៧ ខែមិថុនា ឆ្នាំ ២០២៤ ហើយ ការចូលរៀន នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃសៅរ៍ ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០២៤ត ទៅ រយៈពេល ៣ខែ ។
វគ្គ សិក្សា នេះ នឹង បើក ឱ្យ ចុះឈ្មោះ រយៈពេល ១ ខែ ប៉ុណ្ណោះ ហើយ ការចូលរួម នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃទី ០៨ ខែមិថុនា ឆ្នាំ ២០២៤ត ទៅ ។ នៅ ក្រោយ ការបញ្ចប់ វគ្គ សិក្សា លោក អ្នក នឹង ទទួលបាន វិញ្ញាបនបត្រ បញ្ជាក់ ការសិក្សា មួយ ដែល ចេញ ដោយ អង្គភាព និង គ្រូបង្គោល ជាពិសេស សម្រាប់ សិក្ខាកាម ដែល ឆ្នើម មាន ទេពកោសល្យ ល្អ នឹង ទទួលបាន ឱកាស ចូលហាត់ការណ៍ និង បម្រើការ នៅក្នុង អង្គភាព ព័ត៌មាន Fresh News ទៀតផង ។
ចំណែក ទីភ្នាក់ងារ ព័ត៌មាន ចិន Xinhua បាន រាយការណ៍ ថា អំឡុង កិច្ច ចាប់ផ្តើម នៃ ជំនួប ខាងលើ លោក Li បាន អំពាវនាវ ឱ្យ មាន ការបន្ត ឡើងវិញ ឱ្យ គ្រប់ ជ្រុងជ្រោយ នូវ កិច្ចសហប្រតិបត្តិការ ត្រី ភាគី ដោយ ប្រកាន់ខ្ជាប់ នូវ ឥរិយាបថ បើក ទូលាយ និង ចំណាត់ការ ដែល មាន តម្លាភាព ។ បើ តាម ក្រសួង ការបរទេស ចិន លោក Li ក៏ បាន លើកឡើង បន្ថែម ទៀត ថា « ជំនួប របស់ ពួកយើង នា ថ្ងៃ នេះ ដែល ជា លើក ដំបូង ក្នុង រយៈពេល លើស៤ ឆ្នាំ គឺជា ការចាប់ផ្តើម ឡើងវិញ ហើយក៏ ជា ការបើក ទំព័រ ថ្មី មួយ ផងដែរ » ។
( ភ្នំពេញ ) ៖ នាយកដ្ឋាន នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ នេះ បាន បន្ដ សហការ ជាមួយ ផ្សារ ទំនើប អ៉ី អន៣ ស្ថិត ក្នុង ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ បើក ការធ្វើ លំហាត់ សមយុទ្ធ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ ។ ក្រៅពី មន្ដ្រី នគរបាល ជំនាញ របស់ នាយកដ្ឋាន ក៏ មាន ការចូលរួម ពី បុគ្គលិក របស់ ផ្សារ ទំនើប អ៉ី អន៣ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ត្រី សេក ធឿន អនុប្រធាន នាយកដ្ឋាន នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ បាន លើកឡើង ថា ការធ្វើ សមយុទ្ធ រួមគ្នា នៅ ពេល នេះ ដើម្បីឲ្យ មន្ដ្រី នគរបាល ជំនាញ មាន ឱកាស ពន្យល់ អំពី ការងារ បច្ចេកទេស មួយចំនួន ដល់ បុគ្គលិក របស់ ផ្សារ ទំនើប អ៉ី អន៣ ឲ្យ មាន ភាពច្បាស់ ការ និង ចូលរួម បង្ការ ទប់ស្កាត់ ពិសេស សង្គ្រោះ បឋម នៅពេល មាន គ្រោះ អគ្គិភ័យ កើតឡើង ។
លោក ឧត្តមសេនីយ៍ ត្រី សេក ធឿន បាន អះអាង ថា ដោយ អនុវត្ត តាម ការចង្អុលបង្ហាញ ពី នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ ពិសេស លោក ឧត្តមសេនីយ៍ ឯក នេត វន្ថា ប្រធាន នាយកដ្ឋាន នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ មន្ដ្រី នគរបាល ជំនាញ តែងតែ ផ្ដល់ នូវ កិច្ចសហការ ល្អ ជាមួយ បណ្ដា គ្រឹះស្ថាន សហគ្រាស ពិសេស ទីផ្សារ ធំ ៗ ដើម្បី ជួយ បណ្ដុះបណ្ដាល ដល់ បុគ្គលិក អំពី វិធានការ បង្ការ និង ការសង្គ្រោះ បឋម នេះ ។
លោក បាន យល់ឃើញ ថា កន្លងទៅ រហូតមកដល់ ពេលនេះ ផ្សារ ទំនើប អ៉ី អន តែងតែ រក្សា បាន យ៉ាង ខ្ជាប់ខ្ជួន នូវ កិច្ចសហការ ជាមួយ នាយកដ្ឋាន ជំនាញ ហើយក៏ តែងតែ ធ្វើ សមយុទ្ធ រួមគ្នា ជា ទៀងទាត់ នៅ គ្រប់ សាខា ទាំង៣ នៃ ផ្សារ ទំនើប អ៉ី អន ។ លោក ចាត់ទុក ថា នេះ ជា គំរូ មួយ ដែល ម្ចាស់ ទីតាំង ដ៏ទៃ ទៀត គួរ អនុវត្ត តាម ជាពិសេស គោរព ទៅ តាម បទដ្ឋាន គតិយុត្តិ ជាធរមាន ។
ជាមួយគ្នា នេះ លោក ជូ សុវណ្ណារ៉ា អ្នកគ្រប់គ្រង ទូទៅ នៃ ផ្សារ ទំនើប អ៉ី អន៣ បាន លើកឡើង ថា ផ្សារ ទំនើប អ៉ី អន៣ តែង ស្នើសុំ កិច្ចសហការ ពី នាយកដ្ឋាន នគរបាល បង្ការ ពន្លត់ អគ្គិភ័យ និង សង្គ្រោះ ដើម្បីឲ្យ បុគ្គលិក បាន ស្គាល់ កាន់តែ ច្បាស់ និង ត្រៀមខ្លួន ក្នុង ការបង្ការ និង សង្គ្រោះ អគ្គិភ័យ ។ លើស ពី នេះ ដើម្បីឲ្យ មន្ដ្រី នគរបាល របស់ នាយកដ្ឋាន ជំនាញ បាន ស្គាល់ ច្បាស់ អំពី ទីតាំង ប្រទាក់ ក្រឡា គ្នា នៃ បណ្ដាញ ទុយោ ទឹក របស់ ផ្សារ ។
លោក បាន បន្ដ ថា ការស្នើសុំ កិច្ចសហការ ធ្វើ សមយុទ្ធ នេះ ក៏ ដើម្បីឲ្យ បុគ្គលិក របស់ ផ្សារ ទាំងអស់ មាន ចំណេះដឹង បន្ថែម និង ពង្រឹង ស្មារតី ឲ្យបាន ល្អ ក្នុង ករណី មាន អគ្គិភ័យ កើតឡើង ងាយស្រួល ក្នុង ការគ្រប់គ្រង និង រាយការណ៍ សុំ ជំនួយ អន្ដរាគមន៍ ។ លោក បន្ថែម ទៀត ថា គ្រប់ ផ្សារ ទំនើប អ៉ី អន ទាំងអស់ ពិសេស អ៉ី អន មានជ័យ ( អ៉ី អន៣ ) នៅតែ បន្ដ សហការ ជាមួយ នាយកដ្ឋាន ជំនាញ ដើម្បី ពង្រឹង សមត្ថភាព ដល់ បុគ្គល ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ដឹកនាំ កិច្ចប្រជុំ ចង្អៀត ជំនាញ ស្រាវជ្រាវ និង បង្រ្កាប បទល្មើស ។
កិច្ចប្រជុំ នេះ ចូលរួម មាន លោក មេបញ្ជាការ រង ទទួល ជំនាញ លោក នាយ សេនាធិការ ប្រធាន មន្ទីរ ស្រាវជ្រាវ និង បង្ក្រាប បទល្មើស ប្រធាន មន្ទីរ ផែនការ ប្រតិបត្តិការ និង ហ្វឹកហ្វឺន នាយ ការិយាល័យ ប្រឆាំង គ្រឿងញៀន នាយ ការិយាល័យ ព្រហ្មទណ្ឌ និង នាយ ការិយាល័យ ប្រឆាំង ការជួញដូរ មនុស្ស ។
( បាត់ដំបង ) ៖ នៅ ថ្ងៃទី ២៧ ខែឧសភា ឆ្នាំ ២០២៤ នៅ សាល ប្រជុំ សាលាដំបូង ខេត្ត បាត់ដំបង អយ្យការ អម សាលាដំបូង ខេត្ត បាត់ដំបង បាន រៀបចំ កិច្ចប្រជុំ បន្ទាន់ មួយ ជាមួយ នគរបាល យុត្តិធម៌ មកពី ស្នងការដ្ឋាន នគរបាល ខេត្ត អធិការ ក្រុង - ស្រុក ទាំង ១៤ និង ពី បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ ខេត្ត - ក្រុង - ស្រុក ទាំង ១៤ ដើម្បី ពិភាគ្សា ស្វែងរក វិធានការ គន្លឹះ និង ដាក់ចេញ នូវ យន្តការ សម្រាប់ អនុវត្ត អោយ បាន តឹងរឹង លើ ករណី ក្មេង ទំនើង ។
កិច្ចប្រជុំ នេះ បាន ដឹកនាំ ដោយ លោក កែវ សុជាតិ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត ។
ក្រោយ ចប់ កិច្ចពិភាក្សា ព្រះរាជអាជ្ញា បាន បូកសរុប ខ្លឹមសារ នៃ អង្គប្រជុំ និង បាន នែនាំ ដល់ នគរបាល យុត្តិ ធ៌ម ឱ្យ ធ្វើ សកម្មភាព ឱ្យ សកម្ម នៅ មូលដ្ឋាន ដោយ កំណត់ ទុក ដូចជា ការធ្វើ យុទ្ធនាការ សម្រាប់ ដោះស្រាយ បញ្ហា ក្មេង ទំនើង ។
ជាមួយគ្នា នេះ លោក ព្រះរាជអាជ្ញា បាន ដាក់ចេញ នូវ វិធានការ២ សម្រាប់ អនុវត្ត គឺ៖
* ទី ១៖ វិធានការ បង្ការ ទប់ស្កាត់ ដែល មាន ៥ចំណុច ដូច ខាងក្រោម៖
* ទី ២៖ វិធានការបង្ក្រា ប៖
* រៀបចំ កម្លាំង អន្តរាគមន៍ ដើម្បី ចេញ ប្រតិបត្តិការ ឲ្យ ទាន់ ពេល វេលា ។ * ស្រាវជ្រាវ បង្ក្រាប បទល្មើស ឲ្យ ដល់ ទី បញ្ចប់ កុំ អោយ បទល្មើស មាន ការកើតឡើង ទៀត ៕
លោក Wang Wentian មាន ការពេញចិត្ត បំផុត ដែល បាន ធ្វើការ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង នីតិកាល ទី៦ និង ក្រោម ការដឹកនាំ របស់ សម្តេច ធិបតី ក្នុង នីតិកាល ទី៧ នៃ រដ្ឋសភា ដែល បាន នាំមក នូវ ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច និង សុខុមាលភាព ជូន ប្រជាជន កម្ពុជា ។
លោក មាន មោទកភាព បំផុត ដែល នៅ ឆ្នាំ ២០១៩ ចិន និង កម្ពុជា បាន ចុះហត្ថលេខា មុន គេ បង្អស់ លើ អនុស្សរណយោគយល់ គ្នា ស្តីពី កិច្ចព្រមព្រៀង ជា ឯកច្ឆន្ទ ក្នុង ការកសាង សហគមន៍ ជោគវាសនា រួម ចិន - កម្ពុជា ក្នុង យុគសម័យ ថ្មី ប្រកបដោយ គុណភាព ខ្ពស់ កម្រិត ខ្ពស់ និង ស្តង់ដារ ខ្ពស់ ។
លោក ចាត់ទុក ថា ទំនង ចិន - កម្ពុជា គឺជា គម្រូ នៃ ទំនាក់ទំនង អន្តរជាតិ បែប ថ្មី ។ ចិន ចាត់ទុក កម្ពុជា ជា ប្រទេស អាទិភាព ក៏ បាន ប្តេជ្ញា សហការ ក្នុង កិច្ចសហប្រតិបត្តិការ ត្បូង ពេជ្រ និង ខិតខំ ជំរុញ ច្រក របៀង មច្ឆា និង អង្ករ ឧស្សាហកម្ម និង បច្ចេកវិទ្យា ឲ្យ មាន ការរីកចម្រើន ដើម្បី ផលប្រយោជន៍ ទៅ វិញ ទៅមក ។
សម្ដេច តេជោ ហ៊ុន សែន បាន សម្តែង នូវ ក្ដីរីករាយ ដែល បាន ជួប ឯក អគ្គ រដ្ឋទូត ប៉ុន្តែ ក៏ មាន អារម្មណ៍ សោកស្តាយ ដោយ ចប់ បេសកកម្ម និង ត្រូវ ចាកចេញ ពី កម្ពុជា ។
សម្ដេច តេជោ ហ៊ុន សែន បាន ឲ្យដឹង ទៀត ថា ទំនាក់ទំនង នេះ ស័ក្តិសម នឹង គុណ តម្លៃ នៃ ការជឿទុកចិត្ត គ្នា ជាពិសេស ទំនុកចិត្ត ខាង នយោបាយ ។ ជំនួយ របស់ ប្រទេស ចិន ដល់ ប្រទេស កម្ពុជា មិន ត្រឹមតែ ជួយ អភិវឌុ្ឍ សង្គម - សេដ្ឋកិច្ច ប៉ុណ្ណោះ ទេ តែ ថែមទាំង ជួយ ពង្រឹង ឯករាជ្យភាព ខាង នយោបាយ របស់ កម្ពុជា ទៀតផង ។
