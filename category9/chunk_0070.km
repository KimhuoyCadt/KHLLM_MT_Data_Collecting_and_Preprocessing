( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ផ្ដល់ ឱកាស ការងារ ក្នុង ស្រុក សម្រាប់ ថ្ងៃទី ៣ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ មាន ចំនួន ៤៦.៧៦៨ កន្លែង ។
អភិបាល ខេត្ត ពោធិ៍សាត់ ប្តេជ្ញា ជំរុញ ចលនា ដាំ ឈើ នៅ បរិវេណ សាលា ស្រុក តា លោ សែន ជ័យ ឱ្យ ក្លាយជា ស្រុក គម្រូ មាន ពណ៌ បៃតង
( ពោធិ៍សាត់ )៖ លោក ខូយ រីដា អភិបាល ខេត្ត ពោធិ៍សាត់ បាន ប្តេជ្ញា ជំរុញ ចលនា ដាំ កូន ឈើ ចម្រុះ និង ឈើ ហូប ផ្លែ ជាច្រើន ឱ្យ បាន តាម ផែនការ នៅ បរិវេណ តំបន់ រដ្ឋបាល ប្រមូលផ្តុំ សាលា ស្រុក តា លោ សែន ជ័យ ( ស្រុក ទើបនឹង បង្កើត ថ្មី ) ស្ថិត ក្នុង ភូមិ ថ្លុក ដង្កោ ឃុំ ផ្ទះ រុង ស្រុក តា លោ សែន ជ័យ ខេត្ត ពោធិ៍សាត់ ដើម្បីឱ្យ ស្រុក មួយ នេះ ក្លាយ ខ្លួន ជា ស្រុក គម្រូ ឈាន មុខ គេ ទាំង ហេដ្ឋារចនាសម្ព័ន្ធ រដ្ឋបាល ថ្មី និង មាន សោភណ្ឌភាព បៃតង ស្រស់ស្អាត ។
លោក បាន បញ្ជាក់ ថា នៅ សង្ខាង ផ្លូវ ទាំង ផ្លូវ ធំ និង ផ្លូវ តូច តាម ផែនការ គឺ ត្រូវ ដាំ ដើម ក្ងោក ហើយ ដើមឈើ ចម្រុះ និង ឈើ ហូប ផ្លែ ជាច្រើន ផ្សេង ទៀត ក៏ ត្រូវ ដាំ ជា បន្តបន្ទាប់ ឱ្យ មាន សោភណភាព មាន សណ្តាប់ធ្នាប់ និង មាន ជួរ ស្អាត ល្អ ជាពិសេស ដាំ ដោយ យកចិត្តទុកដាក់ មិន ត្រូវ ឱ្យ ងាប់ នោះ ឡើយ ។
លោក បន្ត ថា ផែនការដាំ ដើមឈើ នេះ គឺ ធ្វើឡើង ក្នុង ក្របខ័ណ្ឌ ទាក់ទាញ ចំណាប់អារម្មណ៍ ប្រជាពលរដ្ឋ ក៏ ដូចជា មន្ត្រីរាជការ ដែល ត្រូវ មក ទទួល និង ផ្តល់ សេវា រដ្ឋបាល ហាក់ មាន អារម្មណ៍ ត្រជាក់ ស្រស់ស្រាយ និង បាន ហាត់ប្រាណ ដើម្បី សុខភាព និង ដើម្បី ចូលរួមចំណែក ទប់ស្កាត់ គ្រោះ ធម្មជាតិ ផ្សេង ៗ ដូចជា ខ្យល់ព្យុះ ខ្យល់ កន្ត្រាក់ ទឹក ជំនន់ និង បាតុភូត ធម្មជាតិ ផ្សេង ៗ ដែល អាច កើតឡើង ជា យថាហេតុ ។
ជាមួយគ្នា នោះ ដែរ លោក អភិបាល ខេត្ត ខូយ រីដា ក៏ បាន ស្នើ ដល់ ថ្នាក់ដឹកនាំ និង មន្ត្រី រដ្ឋបាល ស្រុក តា លោ សែន ជ័យ សូម ចូលរួម ថែរក្សា ការពារ នូវ សមិទ្ធផល ទាំងអស់ នេះ ឱ្យ បាន គង់វង្ស និង បាន ល្អ ប្រសើរ ដើម្បីឱ្យ ស្រុក ទើបនឹង បង្កើត ថ្មី នេះ មាន ព័ត៌ បៃតង និង ស្រស់បំព្រង ឡើង យ៉ាង យូរ ២ទៅ ៣ឆ្នាំ ខាងមុខ ។
គួរ ជម្រាប ជូន ថា កាលពី ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០១៩ រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច ចេញ អនុក្រឹត្យ ដើម្បី បង្កើត ស្រុក តា លោ សែន ជ័យ មួយ ទៀត នៅក្នុង ទឹកដី ខេត្ត ពោធិ៍សាត់ ។ ស្រុក តា លោ សែន ជ័យ ទើបនឹង បង្កើត នេះ មាន ឃុំ ចំនួន ០២ ក្នុង នោះ មាន ឃុំ តា លោ ដែល កាត់ ចេញ ពី ស្រុក បាកាន និង ឃុំ ផ្ទះ រុង ដែល កាត់ ចេញ ពី ស្រុក ភ្នំ ក្រវាញ នៃ ខេត្ត ពោធិ៍សាត់ ។
ជាមួយគ្នា នោះ រាជ រដ្ឋាភិបាល ក៏ បាន កាត់ យក ភូមិ ចំនួន ២ គឺ ភូមិ កោះ ស្វាយ និង ភូមិ កោះ វត្ត ពី ឃុំ ខ្នារ ទទឹង នៃ ស្រុក បាកាន ឱ្យ មក នៅក្នុង ឃុំ តា លោ នៃ ស្រុក តា លោ សែន ជ័យ ផងដែរ ។ ដោយឡែក ទីតាំង សាលា ស្រុក គឺ ស្ថិត ក្នុង ភូមិ ថ្លុក ដង្កោ ឃុំ ផ្ទះ រុង ស្រុក តា លោ សែន ជ័យ ខេត្ត ពោធិ៍សាត់ ខណៈ ដែរ បច្ចុប្បន្ន បាន ដំណើរការ សាងសង់ រួចរាល់ហើយ នូវ អាគារ រដ្ឋបាល ស្រុក និង ការិយាល័យ ច្រក ចេញ ចូល តែ មួយ ៕
លោក វរសេនីយ៍ ឯក សៀ ទីន ដឹកនាំ ក្រុម នាយ ទាហាន បញ្ចប់ ការសិក្សា ពី បណ្ឌិត្យ សភា យោធា អូស្ត្រាលី ចូលរួម ក្នុង កម្មវិធី សប្បុរស ធម៍ នៅ វិទ្យាល័យ អប់រំ ពិសេស ភ្នំពេញ ថ្មី ជូន ដល់ ក្រុម កុមារ និង សិស្សានុសិស្ស ពិការ ភ្នែក គរ ថ្លង់
កញ្ចប់ ជំនួយ សប្បុរស ធម៍ រួម មាន បរិក្ខារ ជំនួយ ដល់ ការសិក្សា ដូចជា កង្ហារ ម៉ាស៊ីន ចំរោះ ទឹក ស្អាត ឧបករណ៍ បញ្ចាំង ស្លាយ ម៉ាស៊ីន ព្រីន ធើរ ទឹក ថ្នាំ ព្រីន ធើរ ឈើច្រត់ សំរាប់ ជន ពិការ និង ស្បៀងអាហារ ដូចជា អង្ករ មី កញ្ចប់ ត្រីខរ ទឹកត្រី ទឹក សុី អុីវ ទឹក សណ្តែក បំប៉ន ព្រមទាំង ម្ហូប អាហារ ថ្ងៃត្រង់ មួយ ពេល សំរាប់ សិស្ស ចំនួន ៣៥០ នាក់ ។
កញ្ចប់ ជំនួយ សប្បុរសធម៌ នេះ គឺ ជំនួយ ដ៏ មាន តម្លៃ ក្នុង ការឧបត្ថម ការខ្វះខាត ផ្នែក បរិក្ខារ ផ្គត់ផ្គង់ ចាំបាច់ របស់ សាលារៀន ទ្រទ្រង់ កម្មវិធី បង្ហាត់ បង្រៀន ដោះស្រាយ ចំណូល ចំណាយ ព្រមទាំង អភិវឌ្ឍន៍ កែលំអរ ក្នុង បរិវេន សាលារៀន បាន មួយ កំរិត ផងដែរ ។
សប្បុរសជន ដែល បាន ចូលរួម បន្ថែម មាន៖
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បាន ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា រួចហើយ នោះ លោក ឡយ អូស្ទីន រដ្ឋមន្ត្រី ការពារ ជាតិ អាមេរិក បាន បន្ត ដំណើរ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
សូម បញ្ជាក់ ថា រដ្ឋមន្ត្រី ការពារ ជាតិ សហរដ្ឋ អាមេរិក លោក ឡយ អូស្ទីន បាន ដឹកនាំ គណៈប្រតិភូ អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា នៅ វេលា ម៉ោង ប្រមាណ ៩ព្រឹក នៅ ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ។
ដំណើរ អញ្ជើញ ដល់ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ របស់ លោក ឡយ អូស្ទីន ត្រូវបាន ទទួលបាន ការស្វាគមន៍ ពី មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ តំណាង អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ និង តំណាង មេបញ្ជាការ កងទ័ព ទាំង៣ ប្រភេទ របស់ កម្ពុជា ផងដែរ ។
ក្នុង ដំណើរទស្សនកិច្ច នេះ ក្រៅពី ជួប សម្តេច តេជោ និង សម្តេច ធិបតី ហើយ នោះ លោក ឡយ អូស្ទីន នឹង ជួប ជាមួយ ឧប នាយក រដ្ឋមន្ត្រី ទៀ សីហា រដ្ឋមន្ត្រី ការពារ ជាតិ របស់ កម្ពុជា ។ នៅ ទីស្តីការ ក្រសួង ការពារ ជាតិ មុននឹង ជំនួប ពិភាក្សា នោះ ក៏ នឹង មាន ការរៀបចំ ពិធី ទទួល បដិសណ្ឋារកិច្ច ជា ផ្លូវការ ផងដែរ ។
ដំណើរទស្សនកិច្ច រយៈពេល មួយ ថ្ងៃ របស់ លោក ឡយ អូស្ទីន នៅ កម្ពុជា នា ពេលនេះ ត្រូវបាន គេ មើលឃើញ ថា ជា ការរួមចំណែក លើកកម្ពស់ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ការពារ ជាតិ រវាង កម្ពុជា និង អាមេរិក ឱ្យ កាន់តែ ល្អ ប្រសើរ ។
ក្រសួង ការពារ ជាតិ កម្ពុជា បាន ចាត់ទុក ថា នេះ ជា ទស្សនកិច្ច ផ្លូវការ ជា ប្រវត្តិសាស្ត្រ លើក ដំបូង មកកាន់ ប្រទេស កម្ពុជា ដែល ធ្វើឡើង ដើម្បី បន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ ល្អ រវាង ប្រទេស ទាំង ពីរ កម្ពុជា - អាមេរិក ដែល មាន ជាង ៧០ ឆ្នាំ មកហើយ ជាពិសេស តាមរយៈ ការជំរុញ ការអនុវត្ត កិច្ចសហប្រតិបត្តិការ របស់ រដ្ឋាភិបាល ទាំង ពីរ ។
ក្រសួង ការពារ ជាតិ បាន អះអាង ថា ដំណើរទស្សនកិច្ច ផ្លូវការ លោក ឡយ អូស្ទីន រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ សហរដ្ឋ អាមេរិក នឹង បញ្ជាក់ ជាថ្មី នូវ ចំណង មិត្តភាព ដ៏ យូរអង្វែង និង គូសបញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត របស់ ក្រសួង ការពារ ជាតិ អាមេរិក និង កង យោធរាល ខេមរភូមិន្ទ ក្នុង ការសហការ ជា ដៃគូរ ដ៏ សំខាន់ ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ ការពារ ជាតិ ឱ្យ កាន់តែ ស៊ីជម្រៅ សម្រាប់ ការថែរក្សា នូវ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព របស់ ប្រទេស ទាំង ពីរ ក៏ ដូចជា សម្រាប់ តំបន់ ទាំងមូល ។
សូម បញ្ជាក់ ថា ដំណើរទស្សនកិច្ច របស់ លោក ឡយ អូស្ទីន នៅ កម្ពុជា នា ពេលនេះ គឺជា លើក ទី២ ហើយ ។ កាល ឆ្នាំ ២០២២ លោក ឡយ អូស្ទីន ធ្លាប់ បាន អញ្ជើញ មក កម្ពុជា ម្តង ផងដែរ ដើម្បី ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក លើក ទី ៩៕ អ្នក ឧកញ៉ា សំអាង វឌ្ឍនៈ ឧបត្ថម្ភ ថវិកា ៥ពាន់ ដុល្លារ ដល់ ដំណើរការកែលម្អ សោភ័ណភាព រមណីដ្ឋាន បឹង កន្សែង
ចុង ទសវត្ស ៨០ មាន ការសាងសង់ មន្ទីរ សុខាភិបាល ១ នៅ មាត់ បឹង មាន រហូតមកដល់ សព្វ ថ្ងៃ ។ មាន ផ្លូវ បេតុង ក្រវាត់ ៧០ % ជុំវិញ បឹង ។ ដោយសារ ថា ក្រុង បាន លុង មិន មាន ទីតាំង កំសាន្ត លំហែរ និង ស្ថានភាព បឹង មិន ស្អាត ទើប លោក ញ៉ែ ម សំអឿន អភិបាល ខេត្ត រតនគិរី បាន រៀបចំ បឹង នេះ ឲ្យ មាន សោភ័ណភាព សំរាប់ បងប្អូន ប្រជាពលរដ្ឋ កំសាន្ត ជាពិសេស ពិធី បុណ្យ អ៊ំ ទូក និង បុណ្យ ផ្សេង ៗ ដោយ ប្រើ ថវិកា លោក ផ្ទាល់ និង ការកៀគរ ពី សប្បុរសជន នានា ។
ខេត្ត កំពង់ចាម គ្រោង ប្រកាស ជា ខេត្ត បញ្ចប់ ការ បន្ទោរបង់ ពាសវាលពាសកាល ក្នុង ចុង ខែកក្កដា ខាងមុខ
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ជំរុញ ឱ្យ មន្ទីរ អង្គភាព ជំនាញ ពាក់ព័ន្ធ ខិតខំ បំពេញ ភារកិច្ច លើ វិស័យ ផ្គត់ផ្គង់ ទឹក ស្អាត និង អនាម័យ ជនបទ ដើម្បី ឈាន ទៅ ប្រកាស ខេត្ត កំពង់ចាម ជា ខេត្ត បញ្ចប់ ការ បន្ទោរបង់ ពាល វាលពាសកាល នៅ ចុង ខែកក្កដា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។
លោក អភិបាល ខេត្ត បាន ជំរុញ ដូច្នេះ នៅ ព្រឹក ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ ក្នុង កិច្ចប្រជុំ ស្ដីពី ការជំរុញ បញ្ចប់ ស្ថានភាព ការ បន្ទោរបង់ ពាល វាលពាសកាល នៃ ក្រុង ស្រុក ទាំង១០ក្នុង ខេត្ត កំពង់ចាម ។
លោក អភិបាល ខេត្ត បាន ថ្លែង ថា « មកដល់ ពេលនេះ យើង រួមគ្នា តាំងចិត្ត ត្រូវ ធ្វើ ការងារ ខាងលើ នេះ ឲ្យបាន បញ្ចប់ ក្នុង ខែមិថុនា និង ដើម្បី ឈាន ទៅ ប្រកាស ខេត្ត កំពង់ចាម ជា ខេត្ត បញ្ចប់ ការ បន្ទោរបង់ ពាល វាលពាសកាល (ODF) នៅ ចុង ខែកក្កដា ឆ្នាំ ២០២៤ ខាងមុខ នេះ ។
លោក អភិបាល ខេត្ត បាន រំលឹក មន្ត្រី មន្ទីរ អង្គភាព ជំនាញ ឱ្យ ពិនិត្យមើល បញ្ហា ដែល នៅ សេសសល់ ហើយ ត្រូវ តាំងចិត្ត ធ្វើឱ្យ បាន ដើម្បី សម្រេច ដល់ គោលដៅ ។ លោក អភិបាល ខេត្ត បាន យក ឱកាស នោះ ថ្លែងអំណរគុណ មន្ត្រី នៅ មន្ទីរ អង្គភាព ពាក់ព័ន្ធ អាជ្ញាធរ ក្រុង ស្រុក ដែល បាន រួមគ្នា ក្នុង ការចុះ ទៅ តម្រង់ ទិស ដល់ អាជ្ញាធរ មូលដ្ឋាន នៃ ក្រុង ស្រុក ទាំង១០ ក្នុង រយៈពេល មួយ ខែ កន្លងមក នេះ ។
ប្រធាន មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត កំពង់ចាម លោក អ៉ឹង វិសុទ្ធ បាន ឲ្យដឹង ថា ខេត្ត កំពង់ចាម បច្ចុប្បន្ន អត្រា ខ្នង ផ្ទះ មាន បង្គន់ អនាម័យ មាន ចំនួន ៨៩. ៧៦% ខ្នង ផ្ទះ ប្រើប្រាស់ រួម មាន ចំនួន ៤. ៦៦% សរុប ខ្នង ផ្ទះ បាន ប្រើប្រាស់ បង្គន់ សរុប ទូទាំង ខេត្ត មាន ចំនួន ៩៤. ៤២% ។
ក្រសួង សេដ្ឋកិច្ច ចាប់ផ្តើម យុទ្ធនាការ បញ្រ្ជាប ការយល់ដឹង លើ « ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ តាម ប្រព័ន្ធ FMIS ជូន អង្គភាព ថវិកា អាណាប័ក ផ្ទេរ សិទ្ធិ ពេញលេញ នៃ ក្រសួង - ស្ថាប័ន ចំនួន ១១»
( ភ្នំពេញ ) ៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ បាន ចាប់ផ្តើម យុទ្ធនាការ បញ្រ្ជាប ការយល់ដឹង លើ « ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ តាម ប្រព័ន្ធ FMIS ជូន អង្គភាព ថវិកា អាណាប័ក ផ្ទេរ សិទ្ធិ ពេញលេញ នៃ ក្រសួង - ស្ថាប័ន ចំនួន ១១» ដែល មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ មន្រ្តី និង បុគ្គលិក ជំនាញ របស់ អង្គភាព ថវិកា អាណាប័ក ផ្ទេរ សិទ្ធិ ពេញលេញ នៃ ក្រសួង - ស្ថាប័ន ប្រមាណ ជាង ៣០០ រូប ។
កម្មវិធី នេះ បាន ប្រព្រឹត្តទៅ ក្រោម អធិបតីភាព របស់ បណ្ឌិត សភាចារ្យ ហ៊ាន សាហ៊ីប រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន ក្រុមការងារ គ្រប់គ្រង គម្រោង FMIS ។
បណ្ឌិត សភាចារ្យ បាន បន្ថែម ទៀត ថា ការផ្លាស់ប្តូរ ទាំង របៀបរបប នៃ អនុវត្ត ការងារ និង ការអភិវឌ្ឍ ជំនាញ ហិរញ្ញវត្ថុ រួមទាំង ការប្រើប្រាស់ FMIS ទាមទារ ការយកចិត្តទុកដាក់ និង ការទទួលខុសត្រូវ ខ្ពស់ ពី ថ្នាក់ដឹកនាំ រហូតដល់ មន្រ្តី ជំនាញ គ្រប់ ជាន់ ថ្នាក់ ក្នុង ការចូលរួម អនុវត្ត គម្រោង FMIS នៅក្នុង ក្របខ័ណ្ឌ នៃ ការអនុវត្ត កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
( ភ្នំពេញ ) ៖ និយ័តករ អចលន វត្ថុ និង បញ្ចាំ បាន ចេញ សេចក្តីជូនដំណឹង ចំនួន ២ដាច់ដោយឡែក ពី គ្នា ដោយ ការកោះអញ្ជើញ ម្ចាស់ សហគ្រាស ប្រកប អាជីវកម្ម បញ្ចាំ ចំនួន ៥ ឱ្យ ចូល ខ្លួន មក បង់ប្រាក់ ផាក ពិន័យ ករណី ប្រកប អាជីវកម្ម គ្មាន អាជ្ញាបណ្ណ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ និយ័តករ អចលន វត្ថុ និង បញ្ចាំ៖
ជា ផ្នែក មួយ នៃ កញ្ចប់ ទណ្ឌកម្ម ទី ១៤ លើ ប្រទេស រុស្ស៊ី ជុំវិញ ការបង្ក សង្រ្គាម លើ ប្រទេស អ៊ុយក្រែន សហភាព អឺរ៉ុប បាន ស្នើ ច្បាប់ ហាមឃាត់ មួយ ដោយ មិន ឱ្យ ប្រតិបត្តិការ លើកដាក់ ទំនិញ និង នាវា ដឹកជញ្ជូញ របស់ សហភាព អឺរ៉ុប ផ្តល់ សេវា សម្រាប់ ការដឹកជញ្ជូន ឧស្ម័ន LNG របស់ រុស្ស៊ី ទៅកាន់ ប្រទេស ទី បី ឡើយ ។ ការហាមឃាត់ នេះ មិន ប៉ះពាល់ ដល់ ការនាំចូល ទៅកាន់ សហភាព អឺរ៉ុប ទេ ។
បណ្តា ប្រទេស មួយចំនួន រួមទាំង បែលហ្ស៊ិក អាឡឺម៉ង់ និង បារាំង បាន ស្នើ ឱ្យ គណៈកម្មការ អឺរ៉ុប វាយតម្លៃ ថា តើ ការហាមឃាត់ នេះ អាច ប៉ះពាល់ ដល់ សេដ្ឋកិច្ច រុស្ស៊ី ច្រើន ជាង សហភាព អឺរ៉ុប ដែរ ឬ ទេ នេះ បើ យោង តាម ក្រុម អ្នកការទូត ។
លោក កែវ រតនៈ បាន បញ្ជាក់ ថា សព្វ ថ្ងៃ នេះ កម្ពុជា យើង មាន ថាមពល បៃតង ប្រមាណ ៦២ ភាគរយ ប៉ុន្តែ យើង ចង់ឲ្យ បង្កើន ដល់ ជាង ៧០ ភាគរយ មុន ឆ្នាំ ២០៣០ ដើម្បី ការពារ បរិស្ថាន . ដើម្បី យក ថាមពល បៃតង នេះ យក ទៅ ទាក់ទាញ ការវិនិយោគ ពី ក្រៅ ប្រទេស មក បង្កើត ជា ការងារ ឲ្យ កម្មករ - កម្ម ការិនី យុវជន យុវនារី ឲ្យ សម្បូរ ការងារ ធ្វើ សម្រាប់ ជា ការជ្រើសរើស ផងដែរ ។
បន្ថែម ពី នោះ ទៀត លោក បាន ឲ្យដឹង ថា កម្ពុជា នៅ មាន បញ្ហា ប្រឈម ដែល ត្រូវ ខិតខំ ធ្វើ ការអភិវឌ្ឍ បន្ថែម ទៀត ពីព្រោះ ប្រសិនបើ អត់ មាន ធ្វើ ការអភិវឌ្ឍ ទៀត ទេ កម្ពុជា ប្រាកដជា ខ្វះ អីចឹង បើ មាន អ្នកប្រឆាំង ចូលចិត្ត តែ ប្រឆាំង មិន ឲ្យ មាន ការអភិវឌ្ឍ ប្រាកដជា ខ្វះ ប៉ុន្តែ បើ រួមគ្នា គាំទ្រ ការអភិវឌ្ឍ គាំទ្រ សន្ដិភាព ដូច ដែល យើង បាន ធ្វើ ហូរហែ កន្លងមក បញ្ហា ខ្វះខាត នឹង ត្រូវបាន កាត់បន្ថយ ។
លោក កែវ រតនៈ ក៏ សូម បងប្អូន ប្រជាពលរដ្ឋ យើង ជួយ គាំទ្រ គំនិត នេះ ពីព្រោះ ការគាំទ្រ គំនិត នេះ គឺជា ការនាំមក នូវ វិបុលភាព ថ្មី ឲ្យ កម្ពុជា យើង មិន មែន ឲ្យ អ្នកណា ម្នាក់ ទេ គឺ ឲ្យ ជាតិ ខ្មែរ យើង ទាំងមូល តែម្ដង ៕ សិស្សានុសិស្ស សាលា បឋមសិក្សា សំរ៉ោង ក្នុង ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ ទទួលបាន សម្ភារៈ សិក្សា និង អំណោយ មួយចំនួន ធំ ក្នុង ឱកាស « ទិវា សិទ្ធិ កុមារ អន្តរជាតិ » ១មិថុនា
( កំពង់ស្ពឺ ) ៖ សិស្សានុសិស្ស នៃ សាលា បឋមសិក្សា សំរ៉ោង ស្ថិត នៅ ភូមិ ក្បាល ដំរី ឃុំ ព្រាំង ជោ ស្រុក ឱរ៉ាល់ ខេត្ត កំពង់ស្ពឺ បាន ទទួល នូវ សំភារៈ សិក្សា ដែល ដូចជា កាបូប ស្ពាយ សៀវភៅ ខ្មៅដៃ ដែក ខួង ក្តា ឈ្នួន ដី ស ខ្មៅដៃ ពណ៍ ជ័រ លុប បន្ទាត់ មួក អាវ ភ្លៀង ច្រាស ដុះ ធ្មេញ ថ្នាំ ដុះ ធ្មេញ និង នំ នែក ផងដែរ នា ឱកាស « ទិវា សិទ្ធិ កុមារ អន្តរជាតិ » ១មិថុនា ថ្ងៃទី១ ខែមិថុនា ឆ្នាំ ២០២៤ ។
ដោយឡែក ក្រុមការងារ ក៏ បាន រៀបចំ សម្ភារៈ ប្រើប្រាស់ សំរាប់ សាលា ក៏ ដូចជា ឧបករណ៍ ភ្លេង ខ្មែរ ដើម្បី រក្សាទុក នៅ សាលា ឲ្យ ក្មួយ ៗ បាន ឃើញ ដោយ ផ្ទាល់ នូវ មរតក ឧបករណ៍ ភ្លេង ខ្មែរ មាន ដូចជា ស្គរ ដៃ ទ្រឆេ ទ្រអ៊ូ រ នាត ឯក អុក ចក្រ ត្រង្គ ខ្លុយ ។ល ។ និង សៀវភៅ ពុម្ភ ចាប់ពី ថ្នាក់ ទី១ រហូតដល់ ថ្នាក់ ទី៦ ផា មួង ខ្មែរ ម្នាក់ មួយ សំពត់ ក្រម៉ា ខ្មែរ សៀវភៅ រឿង ព្រេង ខ្មែរ ប៉ិច និង សៀវភៅ សរសេរ ៣០០ ក្បាល ទុក ជូន សាលា ដើម្បី ប្រើប្រាស់ ព្រមទាំង ថវិការ មួយចំនួន ជូន ដល់ សាលា បឋមសិក្សា សំរ៉ោង ។
លើស ពី នោះ ទៀត ក្រុមការងារ ក៏ បាន រៀបចំ ស្រស់ ស្រូប អាហារ សាគ្គី ថ្ងៃត្រង់ ជុំគ្នា ជាមួយ សិស្សានុសិស្ស និង លោកគ្រូ អ្នកគ្រូ កម្មវិធី បំនិន ជីវិត និង លេង ល្បែង ប្រជា ព្រៃ ខ្មែរ ជាមួយ ក្មួយ ៗ សិស្សានុសិស្ស ដើម្បី កំសាន្ត ក៏ ដូចជា ឲ្យ ក្មួយ បាន ស្គាល់ ច្បាស់ ពី ល្បែង ប្រពៃណី ជាតិ និង បង្កើន ភាពស្និតស្នាល តាមរយៈ ល្បែង ប្រពៃណី ខ្មែរ ។
លោក បាន បន្ថែម ទៀត ថា កម្មវិធី នេះ មិន ត្រឹមតែ ជា កម្មវិធី សប្បុរសធម៌ ប៉ុណ្ណោះ ទេ តែ ក៏ មាន គោលដៅ ចង់ បណ្តុះ គំនិត សកម្មភាព និង ធ្វើជា ឧទាហរណ៍ ដល់ យុវជន ជំនាន់ ក្រោយ ឲ្យ ចេះ ជួយ យកអាសា គ្នា ជា បន្តបន្ទាប់ និង បង្កើន សាមគ្គីភាព ឲ្យ ចេះ រួបរួម គ្នា តាមរយៈ សកម្មភាព សប្បុរសធម៌ នេះ និង ល្បែង ប្រជាប្រិយ ខ្មែរ យើង ផងដែរ ។
ក្រោយ បញ្ចប់ ការសំណេះសំណាល ជាមួយ ក្មួយ ៗ សិស្សានុសិស្ស ប្រធាន ការិយាល័យ មេធាវី ថៈណាយ និង សហការី ព្រមទាំង ក្រុមការងារ បាន ដឹកនាំ ធ្វើ ការចែកជូន សំភារៈ សិក្សា និង អំណោយ ផ្សេង ទៀត ជាមួយ ក្រុមហ៊ុន ទាំងអស់ ដែល បាន ចូលរួម ដោយ ផ្ទាល់ ទៅដល់ កុមារ កម្ពុជា ប្រហែល ៣០០ នាក់ និង លោកគ្រូ អ្នកគ្រូ ។
គួរ បញ្ជាក់ ផងដែរ ថា ការិយាល័យ មេធាវី ថៈណាយ & សហការី បាន ផ្តួចផ្តើម បង្កើត កម្មវិធី សប្បុរស ធម៍ ក្រោម ប្រធានបទ « បរិច្ចាគ ដើម្បី ស្នាមញញឹម កុមារ » នេះ ចំនួន ០២ លើក រួច មកហើយ ដែល នេះ គឺជា លើក ទី ០៣ ដោយ មាន ការចូលរួម ឧបត្ថម គាំទ្រ ពីសំណាក់ ក្រុមហ៊ុន ជា ដៃគូ ជាច្រើន ដើម្បី បង្ហាញ ពី ក្តី ស្រលាញ់ ការចេះ ចែករំលែក និង យកចិត្តទុកដាក់ ដល់ កុមារ ដែល នឹង ក្លាយជា សសរ ទ្រូង នៃ សង្គម និង ប្រទេសជាតិ នា ពេល អនាគត ៕
ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី៖ ក្រសួង - ស្ថាប័ន និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ដែល មិន បាន ពិនិត្យ ឡើងវិញ រចនាសម្ព័ន្ធ និង ការវិភាគ មុខងារ មិន អនុញ្ញាតឲ្យ ជ្រើសរើស មន្រ្តី ឡើយ
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មុខងារ សាធារណ និង ជា អនុប្រធាន ប្រចាំ ការ នៃ គណៈកម្មាធិការ ជាតិ ជំរុញ ការអនុវត្ត វិធានការ គន្លឹះ ក្នុង ការកែទម្រង់ រដ្ឋបាល សាធារណៈ របស់ រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា ( គ. វ. រ. ) បាន អះអាង ថា ក្នុង ករណី ក្រសួង - ស្ថាប័ន និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ដែល មិន បាន អនុវត្ត ការពិនិត្យ ឡើងវិញ រចនាសម្ព័ន្ធ និង ការវិភាគ មុខងារ មិន ត្រូវបាន អនុញ្ញាតឱ្យ ជ្រើសរើស មន្រ្តី រាជការ ស៊ីវិល ឡើយ ។
ការអះអាង បែប នេះ របស់ ឧប នាយក រដ្ឋមន្ដ្រី ហ៊ុន ម៉ានី ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២៤ នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី ការពិនិត្យ ឡើងវិញ និង ការវិភាគ មុខងារ និង រចនាសម្ព័ន្ធ ក្រសួង ស្ថាប័ន និង ធ្វើ បច្ចុប្បន្នភាព ទិន្នន័យ មន្ត្រីរាជការ ស៊ីវិល ក្រសួង ស្ថាប័ន ។
បន្ថែម លើ នេះ ក្នុង នាម លេខាធិការដ្ឋាន គ. វ. រ. ក្រសួង មុខងារ សាធារណៈ ត្រូវ សម្របសម្រួល ការអនុវត្ត ឲ្យបាន ចប់ សព្វគ្រប់ នូវ ការ ពិនិត្យ ឡើងវិញ រចនាសម្ព័ន្ធ និង ការវិភាគ មុខងារ របស់ ក្រសួង - ស្ថាប័ន និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ត្រឹម ត្រីមាស ទី៣ ឆ្នាំ ២០២៤ ។
លោក ហ៊ុន ម៉ានី បាន គូសបញ្ជាក់ ថា ជា លទ្ធផល សម្រាប់ ការកែលម្អ ប្រព័ន្ធ ជ្រើសរើស មន្រ្តី ចូល បម្រើ ការងារ ក្នុង រដ្ឋបាល សាធារណៈ ក្រសួង មុខងារ សាធារណៈ បាន រៀបចំ និយាម ស្តីពី នីតិវិធី ប្រតិបត្តិ សម្រាប់ ការប្រឡង ប្រជែង ជ្រើសរើស មន្រ្តី រាជការ ស៊ីវិល ដែល ត្រូវបាន ដាក់ ឲ្យ អនុវត្ត តាមរយៈ អនុក្រឹត្យ ។ ក្រសួង បាន ដឹកនាំ រៀបចំ ការប្រឡង ប្រជែង ជ្រើសរើស មន្រ្តី រាជការ ស៊ីវិល ចំនួន ៦លើ ក ដោយ បាន ជ្រើសរើស បេក្ខជន សរុប ចំនួន ៩៧៥ នាក់ និង កំពុង ដំណើរការជ្រើសរើស ជា បន្តបន្ទាប់ ។
សូម ជម្រាប ថា វគ្គ បណ្ដុះបណ្ដាល ស្តីពី ការពិនិត្យ ឡើងវិញ ការវិភាគ មុខងារ និង រចនាសម្ព័ន្ធ ក្រសួង - ស្ថាប័ន និង ការធ្វើ បច្ចុប្បន្នភាព រចនាសម្ព័ន្ធ ទិន្នន័យ មន្រ្តី រាជការ ស៊ីវិល ក្រសួង - ស្ថាប័ន ជា ជំហាន មួយ ទៀត ក្នុង ការសម្រេច ឲ្យបាន នូវ ការងារ កែទម្រង់ រដ្ឋបាល សាធារណៈ ។
តាម ការអញ្ជើញ របស់ រដ្ឋាភិបាល នៃ ប្រទេស អូស្ត្រាលី លោក បណ្ឌិត ស៊ឺន សំ អ្នកវិភាគ គោល នយោបាយ នៃ រាជ បណ្ឌិត្យ សភា កម្ពុជា បាន អញ្ជើញ ទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស អូស្ត្រាលី ចាប់ពី ថ្ងៃទី ២៤ ដល់ ថ្ងៃទី៣០ ខែឧសភា ឆ្នាំ ២០២៤ ។ នៅក្នុង ដំណើរទស្សនកិច្ច នោះ លោក បណ្ឌិត បាន ជួប ជាមួយនឹង មន្ត្រី រដ្ឋាភិបាល អូស្ត្រាលី អ្នកសិក្សា ស្រាវជ្រាវ និង បាន ជួប ជាមួយ ឧបការី រដ្ឋមន្ត្រី រដ្ឋការ បរទេស អូស្ត្រាលី ទទួលបន្ទុក កិច្ចការ អាស៊ី អាគ្នេយ៍ ផងដែរ ។
ក្នុង ឱកាស នៃ ជំនួប លោក Jyri Järviaho បាន ថ្លែងអំណរគុណ ចំពោះ សម្តេច ធិបតី ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មមាញឹក អនុញ្ញាតឲ្យ រូប លោក ចូល ជួប សម្តែង ការគួរសម និង ជម្រាប លា ក្នុង ឱកាស បញ្ចប់ អាណត្តិការ ទូត ព្រមទាំង បាន អបអរសាទរ ចំពោះ សម្ដេច ធិបតី ដែល ត្រូវបាន រដ្ឋសភា បោះឆ្នោត ជ្រើសតាំង ជា នាយក រដ្ឋមន្រ្តី នៃ ព្រះរាជាណាចក្រ កម្ពុជា នីតិកាល ទី៧ នៃ រដ្ឋសភា កាលពី ខែសីហា ឆ្នាំ ២០២៣ កន្លងទៅ នេះ ។
លោក ឯក អគ្គ រដ្ឋទូត ក៏ បាន បញ្ជាក់ អំពី ការបន្ត ក្នុង ការពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ លើ វិស័យ អប់រំ ការបណ្ដុះបណ្ដាល វិជ្ជាជីវៈ សុខាភិបាល ពាណិជ្ជកម្ម និង វិស័យ បរិស្ថាន ។
ជា ការឆ្លើយតប សម្តេច ធិបតី ហ៊ុន ម៉ាណែត បាន ស្វាគមន៍ ចំពោះ វត្តមាន របស់ លោក Jyri Järviaho ព្រមទាំង បាន អរគុណ និង បាន វាយតម្លៃ ខ្ពស់ ចំពោះ ការចូលរួមចំណែក យ៉ាង សកម្ម របស់ លោក ឯក អគ្គ រដ្ឋទូត ក្នុង ការពង្រឹង និង ពង្រីក ទំនាក់ទំនង ការទូត និង កិច្ចសហប្រតិបត្តិការ ក្នុង អាណត្តិការ ទូត របស់ លោក លើ វិស័យ ជាច្រើន ជាពិសេស លើ វិស័យ អប់រំ ។
សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ នៃ រដ្ឋសភា នឹង បន្ត អនុវត្ត គោល នយោបាយ លើកកម្ពស់ វិស័យ អប់រំ តាមរយៈ ការផ្តល់ អាទិភាព លើ ការកសាង មូលធន មនុស្ស ប្រកបដោយ សមត្ថភាព និង សុខភាព ដើម្បី អភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ឲ្យ កាន់តែ រីកចម្រើន និង រឹងមាំ បន្ថែម ទៀត ។
ពាក់ព័ន្ធ នឹង ការបណ្ដុះបណ្ដាល វិជ្ជាជីវៈ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត ក៏ បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ គោល នយោបាយ ជា អាទិភាព ក្នុង ការអភិវឌ្ឍ ជំនាញ វិជ្ជាជីវៈ និង បច្ចេកទេស ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ ទីផ្សារ ការងារ ប្រកបដោយ ភាពបត់បែន និង តាម តម្រូវការ ជាក់ស្តែង ព្រមទាំង ពង្រឹង សមត្ថភាព បន្ថែម តាមរយៈ ការរៀបចំ ជំនាញ ឡើងវិញ (Reskilling) និង ការបង្កើន ជំនាញ (Upskilling) ។
សម្ដេច ធិបតី ក៏ បាន សម្តែង នូវ ការស្វាគមន៍ និង លើកទឹកចិត្ត ដល់ រដ្ឋាភិបាល ហ្វាំងឡង់ ក្នុង ការបន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អប់រំ សុខាភិបាល ពាណិជ្ជកម្ម និង បរិស្ថាន បន្ថែម ទៀត តាមរយៈ កិច្ចសហការ ជាមួយ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា រួម មាន៖ ក្រសួង អប់រំ យុវជន និង កីឡា ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្រសួង សុខាភិបាល ក្រសួង ពាណិជ្ជកម្ម និង ក្រសួង បរិស្ថាន ។
គួរ បញ្ជាក់ ថា ៣ ថ្ងៃ បន្ទាប់ពី នោះ ចិន បាន បើក ការធ្វើ សមយុទ្ធ យោធា ទ្រង់ទ្រាយ ធំ ដោយ ឡោមព័ទ្ធ តៃវ៉ាន់ ជាមួយ យន្តហោះ និង នាវា យោធា ដើម្បី ព្រមាន ចំពោះ សកម្មភាព ប៉ុនប៉ង ផ្តាច់ ខ្លួន ។ មក ទល់នឹង ពេលនេះ ចិន មិន ដែល ធ្លាប់ បោះបង់ ចោល ឡើយ នូវ ជម្រើស ប្រើ កម្លាំង យោធា ដើម្បី បង្រួបបង្រួមគ្នា វិញ ជាមួយ តៃវ៉ាន់ នៅ ថ្ងៃ ណាមួយ ៕ ម្សិលមិញ នេះ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត ចាត់ការ លើ សំណុំ ក្មេង ទំនើង ៥ ករណី ដែល មាន ជនសង្ស័យ ៤២ នាក់
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ លោក ជិន ម៉ាលី ន បាន ឱ្យដឹង ថា នៅ ថ្ងៃទី ៣ ខែមិថុនា ឆ្នាំ ២០២៤ ម្សិលមិញ នេះ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត បាន ទទួល ចាត់ការ លើ សំណុំរឿង ពាក់ព័ន្ធ នឹង ករណី ក្មេង ទំនើង ចំនួន ៥ ករណី ដែល មាន ជនសង្ស័យ ចំនួន ៤២ នាក់ ហើយ តុលាការ បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ២៦ នាក់ ។
កំណាត់ ផ្លូវ ជាតិ លេខ ៣ ( ត្រពាំង រពៅ - វាល រេញ ) បាន កៀរកិន បង្ហាប់ ស្រោច ទឹក ដើម្បី សម្រួល ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ
( កំពត ) ៖ ក្រោម ការអនុវត្តន៍ ការងារ ថែទាំ ជាប្រចាំ ( ខួប ) ដោយ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះសីហនុ គិត មកដល់ ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ កំណាត់ ផ្លូវ ជាតិ លេខ ៣ ( ត្រពាំង រពៅ - វាល រេញ ) ត្រូវបាន កៀរកិន បង្ហាប់ លុប គ្រលុក ស្រោច ទឹក ជា បន្តបន្ទាប់ ដើម្បី ជួយ សម្រួល ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ ។
ស្ថានភាព នៃ ការធ្វើដំណើរ លើ កំណាត់ ផ្លូវ នេះ គឺ មាន សភាព មមាញឹក ជាធម្មតា ទាំង រថយន្ត តូច រថយន្ត ធំ និង ទោ ចក្រយានយន្ត ដែល ប្រើប្រាស់ ថេរ វេលា រង្វង់ ជាង ២០ - ៣០នាទី លើ ចម្ងាយ ផ្លូវ ជាង ២០ គីឡូម៉ែត្រ នេះ ។
គួរ បញ្ជាក់ ថា លោក ប៉េង ពោធិ៍នា រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន តែងតែ យកចិត្តទុកដាក់ ខ្ពស់ និង បាន ចង្អុលបង្ហាញ ដល់ អង្គភាព ពាក់ព័ន្ធ បន្ត ថែទាំ ក្នុង ឆ្នាំ ២០២៤ នេះ មុននឹង ឈាន ទៅដល់ ការអនុវត្ត ការងារ សាងសង់ ជាក់ស្តែង ឱ្យ ស្រប ទៅតាម បទដ្ឋាន បច្ចេកទេស ខ្ពស់ នា ពេល ខាងមុខ ។
សូម បញ្ជាក់ ថា កំណាត់ ផ្លូវ ជាតិ លេខ ៣ ( ត្រពាំង រពៅ - វាល រេញ ) ប្រវែង ជាង ២០ គីឡូម៉ែត្រ ជា ប្រភេទ ដី ស្អុយ បៀម ទឹក ខ្លាំង ដែល មាន ជម្រៅ ជ្រៅ ជាង ១០ម៉ែត្រ ។ ដើម្បីឱ្យ ការស្ថាបនា កំណាត់ ផ្លូវ នេះ ឡើងវិញ ជាប់ ធន់ បាន យូរ ទាមទារ ការប្រើប្រាស់ បច្ចេកសាងសង់ ខ្ពស់ ជាពិសេស ការសាងសង់ គ្រឹះ ទម្រ ស្រទាប់ កម្រាល ផ្លូវ តែម្តង ៕ រដ្ឋមន្រ្តី ការពារ ជាតិ កម្ពុជា ទទួលស្វាគមន៍ និង ជួបពិភាក្សា ទ្វេ ភាគី ជាមួយ រដ្ឋមន្រ្តី ការពារ ជាតិ អាមេរិក
( ភ្នំពេញ ) ៖ នៅក្នុង ដំណើរទស្សនកិច្ច រយៈពេល ១ ថ្ងៃ នៅ រសៀល ថ្ងៃទី ០៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ លោក ឡយ អូស្ទីន (Lloyd Austin) រដ្ឋមន្រ្តី ការពារ ជាតិ អាមេរិក បាន ជួប ពិភាក្សា ការងារ ជាមួយ នាយ ឧត្តមសេនីយ៍ ទៀ សីហា ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង ការពារ ជាតិ កម្ពុជា នៅ ទីស្តីការ ក្រសួង ការពារ ជាតិ ។ នៅ ទីស្តីការ ក្រសួង ការពារ ជាតិ មុននឹង ជំនួប ពិភាក្សា នេះ ក៏ មាន ពិធី រៀបចំ ទទួលស្វាគមន៍ លោក ឡយ អូស្ទីន ផងដែរ ។
ជំនួប នេះ បាន ធ្វើឡើង បន្ទាប់ពី លោក បាន ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា និង ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា ។
រដ្ឋមន្ត្រី ការពារ ជាតិ សហរដ្ឋ អាមេរិក លោក ឡយ អូស្ទីន បាន ដឹកនាំ គណៈប្រតិភូ អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា នៅ វេលា ម៉ោង ប្រមាណ ៩ព្រឹក នៅ ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ ។ ដំណើរ អញ្ជើញ ដល់ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ របស់ លោក ឡយ អូស្ទីន ត្រូវបាន ទទួលបាន ការស្វាគមន៍ ពី មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង ការពារ ជាតិ តំណាង អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ និង តំណាង មេបញ្ជាការ កងទ័ព ទាំង៣ ប្រភេទ របស់ កម្ពុជា ផងដែរ ។
ក្រសួង ការពារ ជាតិ បាន អះអាង ថា ដំណើរទស្សនកិច្ច ផ្លូវការ លោក ឡយ អូស្ទីន រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ សហរដ្ឋ អាមេរិក នឹង បញ្ជាក់ ជាថ្មី នូវ ចំណង មិត្តភាព ដ៏ យូរអង្វែង និង គូសបញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត របស់ ក្រសួង ការពារ ជាតិ អាមេរិក និង កងយោធពល ខេមរភូមិន្ទ ក្នុង ការសហការ ជា ដៃគូរ ដ៏ សំខាន់ ដើម្បី ជំរុញ កិច្ចសហប្រតិបត្តិការ ការពារ ជាតិ ឱ្យ កាន់តែ ស៊ីជម្រៅ សម្រាប់ ការថែរក្សា នូវ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព របស់ ប្រទេស ទាំង ពីរ ក៏ ដូចជា សម្រាប់ តំបន់ ទាំងមូល ។
សូម បញ្ជាក់ ថា ដំណើរ របស់ លោក ឡយ អូស្ទីន មកកាន់ កម្ពុជា នា ពេលនេះ គឺជា លើក ទី២ ហើយ ។ កាល ឆ្នាំ ២០២២ លោក ឡយ អូស្ទីន ធ្លាប់ បាន អញ្ជើញ មក កម្ពុជា ម្តង ផងដែរ ដើម្បី ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន បូក លើក ទី ៩៕ គ.ជ. ប ចេញ សេចក្តីប្រកាស ស្តីពី លទ្ធផល នៃ កិច្ចប្រជុំ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ កិច្ចប្រជុំ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ដែល បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប ដើម្បី ពិនិត្យ និង សម្រេច លើ ឯកសារ ចំនួន ៥ ពាក់ព័ន្ធ នឹង លទ្ធផល នៃ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ អាណត្តិ ទី៤ ឆ្នាំ ២០២៤ ។
១៖ កែសម្រួល ខ្លឹមសារ នៃ របាយការណ៍ ស្តីពី ការផ្ទៀងផ្ទាត់ សន្លឹក ឆ្នោត ដែល បាន ប្រើ ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុម - ប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ អាណត្តិ ទី៤ នា ថ្ងៃអាទិត្យ ទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ ។
២៖ ឯកភាព លើ តារាង ចំនួន អ្នក បាន ទៅ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា - ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ អាណត្តិ ទី៤ នា ថ្ងៃអាទិត្យ ទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ ។ តាម តួលេខ ក្នុង តារាង នោះ អ្នក បាន ទៅ បោះឆ្នោត ចំនួន ១១.៥៩៨ នាក់ ស្មើនឹង ៩៩. ៧៩ % នៃ ចំនួន អ្នក មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ចំនួន ១១.៦២២ នាក់ ។
៥៖ ឯកភាព លើ សេចក្តីសម្រេច ស្តីពី ការប្រកាស បេក្ខជន ជាប់ ឆ្នោត ជា សមាជិក ក្រុមប្រឹក្សា ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ក្រុមប្រឹក្សា ខេត្ត ក្រុមប្រឹក្សា ក្រុង ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ខណ្ឌ អាណត្តិ ទី៤ នា ថ្ងៃអាទិត្យ ទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ ដែល មាន ទម្រង់បែបបទ លេខ ១១១៨ ខ និង ទម្រង់បែបបទ ១១១៨ ស ។
ក្នុង របៀបវារៈ ផ្សេង ៗ លោក ប្រាជ្ញ ចន្ទ បាន ណែនាំ ដល់ ក្រុម អ្នកនាំពាក្យ និង ក្រុម ប្រតិកម្ម ព័ត៌មាន គ.ជ. ប ត្រៀម ឆ្លើយតប ទៅនឹង បញ្ហា នានា ដែល ពាក់ព័ន្ធ នឹង ការបោះឆ្នោត ក្នុង ករណី មាន មតិ រិះគន់ ដោយ មិន សម ហេតុផល លើ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា អាណត្តិ ទី៤ នេះ ៕
រោងចក្រ កែច្នៃ គ្រាប់ ស្វាយចន្ទី នៅ ស្រុក កំពង់ស្វាយ តម្លៃ ជាង ១លាន ដុល្លារ ត្រូវបាន សម្ពោធ ជា ផ្លូវការ (Video inside) ( កំពង់ធំ )៖ លោក តូច ប៊ុន ហួរ រដ្ឋលេខាធិការ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ និង លោក អាត ស៊ូស៊ិ អ៊ូអិណូ អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ កម្ពុជា បាន អញ្ជើញ សម្ពោធ រោងចក្រ កែច្នៃ គ្រាប់ ស្វាយចន្ទី នៅ ភូមិ ត្រពាំង អារក្ស ឃុំ ជ័យ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ នា ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ ។
លោក តូច ប៊ុន ហួរ លើកឡើង ថា ខេត្ត កំពង់ធំ ត្រូវបាន គេ ស្គាល់ យ៉ាង ទូលំទូលាយ ថា ជា ខេត្ត ផលិត គ្រាប់ ស្វាយចន្ទី ឈាន មុខ គេ ក្នុង ប្រទេស កម្ពុជា ។ លើស ពី នេះ គ្រាប់ ស្វាយចន្ទី របស់ កម្ពុជា មាន ទំហំ ធំ និង មាន រសជាតិ ឈ្ងុយ ឆ្ងាញ់ ហើយក៏ ទទួលបាន ការវាយតម្លៃ ខ្ពស់ ពី ប្រទេស នានា រួម មាន ប្រទេស ជប៉ុន ផងដែរ ។
លោក បន្ត ថា រាជ រដ្ឋាភិបាល នីតិកាល ទី៧ បាន ដាក់ចេញ យុទ្ធសាស្ត្រ បញ្ចកោណ ដំណាក់កាល ទី១ រួម មាន៖ កំណើន ការងារ សមធម៌ ប្រសិទ្ធភាព និង ចីរភាព ជាមួយនឹង ការកំណត់ យក អាទិភាព គន្លឹះ ៥គឺ៖ « មនុស្ស ផ្លូវ ទឹក ភ្លើង និង បច្ចេកវិទ្យា » និង គោលដៅ យុទ្ធសាស្ត្រ ជាក់លាក់ ។
ទន្ទឹម នេះ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ កម្មវិធី គោល នយោបាយ អាទិភាព សម្រាប់ ចាប់ផ្តើម អនុវត្ត ក្នុង ឆ្នាំ ២០២៣ ពាក់ព័ន្ធ នឹង វិស័យ កសិកម្ម ពោល គឺ៖ កម្មវិធី ទី៥ « ការដាក់ចេញ នូវ យន្តការសម្របសម្រួល និង កម្មវិធី ហិរញ្ញប្បទាន សំដៅ លើកស្ទួយ ផលិតកម្ម រក ទីផ្សារ និង រក្សា លំនឹង ថ្លៃ កសិផល សំខាន់ ៗ ក្នុង កម្រិត សមរម្យ » និង កម្មវិធី ទី៦ « ការដាក់ពង្រាយ មន្ត្រី បច្ចេកទេស កសិកម្ម ទៅ គ្រប់ ឃុំ - សង្កាត់ ដែល មាន សកម្មភាព កសិកម្ម នៅ ទូទាំង ប្រទេស និង ការរៀបចំ ឱ្យ មាន សហគមន៍ កសិករ នៅ តាម ទី ជនបទ » ។
លោក បញ្ជាក់ ថា ដោយ ឃើញ ពី សក្តានុពល នៃ ផលិតផល ស្វាយចន្ទី សម្តេច ធិបតី នាយក រដ្ឋមន្ត្រី បាន ផ្តល់ ការណែនាំ ដ៏ ខ្ពង់ខ្ពស់ ដល់ គណៈកម្មាធិការ គោល នយោបាយ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ឱ្យ ធ្វើ ការដឹកនាំ រៀបចំ និង ដាក់ចេញ នូវ វិធានការ ចាំបាច់ នានា ក្នុង ការជំរុញ ការកែច្នៃ និង ការនាំចេញ ផលិតផល ស្វាយចន្ទី ក្នុង នោះ រួម មាន៖
លោក ញ៉ឹក បាន ខេង បញ្ជាក់ ថា ខេត្ត កំពង់ធំ មាន ផ្ទៃដី ដាំដុះ ដំណាំ កសិឧស្សាហកម្ម ដូចជា ដំណាំ ចន្ទី ដាំដុះ បាន ១៤៥. ៣០០ ហិចតា ប្រមូល ផល សរុប បាន ៨០.០០០ ហិចតា និង ទទួលបាន ទិន្នផល ជា មធ្យម ១.៥តោន / ហិចតា ក្នុង ១ឆ្នាំ ។
លោក ថា ខេត្ត កំពង់ធំ មាន សហគ្រាស សិប្បកម្ម កែច្នៃ ស្វាយចន្ទី ចំនួន ៧កន្លែង និង ម៉ាស៊ីន សម្ងួត ២៣កន្លែង ផងដែរ ។ គួរ បញ្ជាក់ ថា រោងចក្រ កែច្នៃ គ្រាប់ ស្វាយចន្ទី ប្រើប្រាស់ ទុន ជាង ១លាន ដុល្លារ មាន ទំហំ ៥៨ ម៉ែត្រ គុណ២០ ម៉ែត្រ និង អាច ផលិត បាន ១០តោន ក្នុង ១ ថ្ងៃ ក្នុង កម្រិត កុងត្រា ១៥០០តោន ក្នុង ១ ឆ្នាំ សម្រាប់ ឆ្នាំ ដំបូង និង សម្រាប់ ឆ្នាំ បន្ទាប់ ៣០០០តោន ក្នុង ១ឆ្នាំ ៕
សាសនិក ឥស្លាម កម្ពុជា ចំនួន ៥៧០ នាក់ ហើយ បាន ចេញដំណើរ ទៅ ប្រារព្ធ បុណ្យ ហាជ្ជ ខណៈ ឆ្នាំ នេះ មាន ចំនួន ៩១១ នាក់
នេះ ជា ការលើកឡើង របស់ លោក រ៉ូហ្វី អូស្មាន សមាជិក រដ្ឋសភា តំណាង លោក បណ្ឌិត អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស នា ឱកាស អញ្ជើញ សំណេះសំណាល និង ជូន ដំណើរ សាសនិក ឥស្លាម ចំនួន ២២៤ នាក់ នា រសៀល ថ្ងៃទី ៣ ខែមិថុនា ឆ្នាំ ២០២៤ សម្រាប់ ជើង ទី៥ ។
ក្រុម ហាជ្ជី ( អ្នក ទៅ ធ្វើ បុណ្យ ហាជ្ជ ) នា ថ្ងៃទី ៣ នេះ ភាគ ច្រើន មកពី ខេត្ត ត្បូងឃ្មុំ ពោធិ៍សាត់ កំពង់ចាម តាកែវ កំពង់ធំ ក្រចេះ កំពត ភ្នំពេញ និង ខេត្ត ផ្សេង ៗ ទៀត ។
ក្នុង ឱកាស នោះ លោក រ៉ូហ្វី អូស្មាន បាន បង្ហាញ អាម្មរណ៍ សប្បាយរីករាយ ជាខ្លាំង ដែល បាន ឃើញ សាសនិក ឥស្លាម កម្ពុជា អាច មាន លទ្ធភាព ទៅ បំពេញ កាតព្វកិច្ច បុណ្យ ហាជ្ជ ខណៈ ការ ទៅ ធ្វើ បុណ្យ ហាជ្ជ នេះ ត្រូវ ចំណាយ ថវិកា ច្រើន ។
លោក បន្ថែម ទៀត ថា នេះ ដោយសារតែ ក្រោម ម្លប់ ដ៏ ត្រជាក់ របស់ រាជ រដ្ឋាភិបាល ដែល ដឹកនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន អតីត នាយក រដ្ឋមន្ត្រី និង បន្ត មក សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត បាន បង្ក លក្ខណៈ ងាយស្រួល ដល់ ប្រជាពលរដ្ឋ ក្នុង ការប្រកប មុខរបរ និង ទទួលបាន ជីវភាពល្អ ប្រសើរ ជាង មុន រហូត អាច មាន លទ្ធភាព ទៅ ធ្វើ បុណ្យ ហាជ្ជ ដែល ជា កាតព្វកិច្ច ទី៥ ក្នុង ចំណោម កាតព្វកិច្ច ឥស្លាម ទាំង ៥ សម្រាប់ អ្នក មាន លទ្ធភាព និង សមត្ថភាព ។
បើ តាម សេចក្តីថ្លែងការណ៍ កាលពី ថ្ងៃចន្ទ កិច្ចព្រមព្រៀង នោះ នឹង នាំទៅ រក បទ ឈប់ បាញ់ បន្ទាន់ មួយ សម្រាប់ តំបន់ ហ្កាហ្សា ការដោះលែង ចំណាប់ខ្មាំង នៅ សេសសល់ ការបង្កើន លំហូរ ជំនួយ មនុស្សធម៌ ចូលក្នុង តំបន់ និង ការបញ្ចប់ វិបត្តិ យូរអង្វែង ផ្អែក លើ ផលប្រយោជន៍ សន្តិសុខ អ៉ី ស្រាអែល និង សុវត្ថិភាព ជន ស៉ី វិល ។ G7 ដែល មាន អ៉ីតាលី ជា ប្រធាន ប្តូរ វេន ក្នុង ឆ្នាំ នេះ បាន គូសបញ្ជាក់ ឡើងវិញ នូវ ការគាំទ្រ សម្រាប់ ផែនការ នេះ ថា « វា ជា មាគ៌ា ដ៏ គួរឱ្យ ទុកចិត្ត ឆ្ពោះ ទៅរក សន្តិភាព ឈាន ទៅ រក ដំណោះស្រាយ រដ្ឋ ពីរ » ។
គួរ បញ្ជាក់ ថា ស្វីស បាន រង សម្ពាធ ពី សម្ព័ន្ធមិត្ត លោក ខាងលិច ឱ្យ ធ្វើ ការ បន្ថែម ទៀត ដើម្បី ជួយ ដល់ អ៊ុយក្រែន ខណៈ ដែល សមាជិក សភា ស្តាំ និយម ជំរុញ ឱ្យ រក្សា អព្យាក្រឹត យ៉ាង តឹងរ៉ឹង ៕
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង កិច្ចការ នារី អំពាវនាវ ឱ្យ អ្នក ផ្តល់ សេវា ទាំងអស់ ចូលរួម យ៉ាង ពេញលេញ ក្នុង ការទប់ស្កាត់ និង ការឆ្លើយតប ចំពោះ ការប្រើ អំពើហិង្សា លើ ស្ត្រី និង ក្មេងស្រី ឱ្យ មាន ប្រសិទ្ធិភាព
( ព្រះវិហារ ) ៖ លោកស្រី ហ៊ូ សាមិត្ត រដ្ឋលេខាធិការ ក្រសួង កិច្ចការ នារី បាន ណែនាំ ដល់ សិក្ខាកាម ដែល ចូលរួម ក្នុង វគ្គ បណ្តុះបណ្តាល ស្តីពី ច្បាប់ និង ឯកសារ ក្បួន នីតិវិធី ប្រតិបត្តិការ ដល់ មន្ត្រី ភ្នាក់ងារ នគរបាល យុត្តិធម៌ និង អ្នក ផ្តល់ សេវា ពាក់ព័ន្ធ មកពី ខេត្ត ចំនួន ៨ ត្រូវ ចូលរួម យ៉ាង ពេញលេញ ក្នុង ការទប់ស្កាត់ និង ការឆ្លើយតប ចំពោះ ការប្រើ អំពើហិង្សា លើ ស្ត្រី និង ក្មេងស្រី ឱ្យ មាន ប្រសិទ្ធិភាព ។
លោកស្រី អភិបាល រង ខេត្ត ថ្លែង លើកឡើង ថា អំពើហិង្សា លើ ស្ត្រី និង ក្មេងស្រី គឺជា ការរំលោភបំពាន សិទ្ធិ មនុស្ស ដែល បណ្តាលឱ្យ មាន គ្រោះថ្នាក់ ឬ ឈឺចាប់ ផ្លូវកាយ ផ្លូវចិត្ត និង ផ្នែក ជីវភាព សេដ្ឋកិច្ច ដល់ ស្ត្រី រាប់បញ្ចូល ទាំង ការ គំរាមកំហែង ថា នឹង ប្រព្រឹត្ត ទង្វើ ទាំង នេះ និង មាន ផល ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ លើ ជីវភាព រស់ នៅ ការអភិវឌ្ឍ ធនធាន មនុស្ស ជីវភាព លំបាក បាត់បង់ ចំណូល ក្នុង ការផ្គត់ផ្គង់ គ្រួសារ ។
លោកស្រី បន្ត ថា ជនរងគ្រោះ ភាគ ច្រើន គឺជា ស្ត្រី និង កុមារ ដែល ទទួល ការរំលោភបំពាន ទៅ លើ សិទ្ធិ ជាច្រើន ប្រភេទ ខុស ៗ គ្នា ប៉ុន្តែ ការរំលោភបំពាន ដែល គួរឱ្យ ស្ងប់ ខ្ពើម ជាង គេ បំផុត នោះ គឺ អំពើ « ហិង្សា លើ ស្ត្រី » ដែល កើត ជា ញឹកញាប់ ជាង គេ ក្នុង ប្រទេស របស់ យើង រួម មាន៖
* អំពើហិង្សា ក្នុង គ្រួសារ * អំពើ រំលោភ សេពសន្ថវៈ * អំពើ ជួញដូរ មនុស្ស និង អំពើ បៀតបៀន ផ្លូវភេទ នៅ ទីកន្លែង ធ្វើការ ។
ជនរងគ្រោះ មួយចំនួន ទទួលរងគ្រោះ ដោយសារ ទំនាក់ទំនង អំណាច មិន ស្មើគ្នា រវាង បុរស និង ស្ត្រី ហើយ ជនរងគ្រោះ នៅ ស្ងៀមស្ងាត់ ដោយ មិន បាន ស្វះស្វែងរក ជំនួយ ពី អាជ្ញាធរ មូលដ្ឋាន អាជ្ញាធរ មាន សមត្ថកិច្ច និង អ្នក ផ្តល់ សេវា ពាក់ព័ន្ធ ផ្សេង ៗ ទៀត ។
លោកស្រី រដ្ឋលេខាធិការ ថា អាជ្ញាធរ មាន សមត្ថកិច្ច និង អាជ្ញាធរ មូលដ្ឋាន មាន តួនាទី និង ភារកិច្ច ដែល ច្បាប់ បាន កំណត់ ហើយក៏ មាន ការលំបាក មួយចំនួន ភ្ជាប់ ជាមួយ ការអនុវត្ត ការងារ របស់ ខ្លួន ផងដែរ ។
កម្មវិធី អភិវឌ្ឍ សមត្ថភាព គឺជា កម្មវិធី បញ្ជាក់ ឱ្យ ឃើញ ពី ការខិតខំ ប្រឹងប្រែង ក្នុង ការចូលរួម បំពេញ បន្ថែម លើ ការឆ្លើយតប សេវា ឱ្យ កាន់តែ ល្អ ប្រសើរ របស់ អ្នក ផ្តល់ សេវា ទាំងអស់ ហើយក៏ ឆ្លើយតប ទៅ ផែនការ សកម្មភាព ជាតិ ស្តីពី ការទប់ស្កាត់ អំពើហិង្សា លើ ស្ត្រី លើក ទី៣ ឆ្នាំ ២០១៩ - ២០២៣ នៅ យុទ្ធសាស្ត្រ ទី២ ការការពារ ផ្នែក ច្បាប់ និង សេវាកម្ម ពហុ វិស័យ ។
គោលដៅ រួម ក្នុង កម្មវិធី អភិវឌ្ឍ សមត្ថភាព នេះ ដើម្បីឱ្យ យើង ទាំងអស់ គ្នា ដែល ជា អ្នក ផ្តល់ សេវា ចូលរួម យ៉ាង ពេញលេញ ក្នុង ការទប់ស្កាត់ និង ការឆ្លើយតប ចំពោះ ការប្រើប្រាស់ អំពើហិង្សា លើ ស្ត្រី និង ក្មេងស្រី ឱ្យ មាន ប្រសិទ្ធិភាព និង ប្រកបដោយ បរិយា បន្ន ៕
រដ្ឋមន្ដ្រី ឈាង រ៉ា ក្រើន រម្លឹក ដល់ អង្គភាព ថា្នក់ ជាតិ និង គ្រប់ មូលដ្ឋាន សុខាភិបាល ត្រូវ យកចិត្តទុកដាក់ ប្រុងប្រយ័ត្ន ខ្ពស់ កុំ ឱ្យ មាន ការធ្វេសប្រហែស ឬ ប្រព្រឹត្ត កំហុស ប៉ះពាល់ ដល់ ក្រមសីលធម៌ វិជ្ជាជីវៈ សុខាភិបាល
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ កម្រិត ថ្នាក់ដឹកនាំ ក្នុង ដើម ខែមិថុនា នេះ ដើម្បី ពិនិត្យ វឌ្ឍនភាព ការងារ និង លើក ទិសដៅ ការងារ បន្ត លោក សាស្ដ្រាចារ្យ ឈាង រ៉ា រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល បាន ថ្លែង ក្រើន រម្លឹក អង្គភាព ថា្នក់ ជាតិ ក៏ ដូចជា គ្រប់ មូលដ្ឋាន សុខាភិបាល សាធារណៈ ត្រូវ យកចិត្តទុកដាក់ ប្រុងប្រយ័ត្ន ខ្ពស់ កុំ ឱ្យ មាន ការធ្វេសប្រហែស ឬ ប្រព្រឹត្ត កំហុស ណាមួយ ដែល ប៉ះពាល់ ដល់ ក្រមសីលធម៌ វិជ្ជាជីវៈ សុខាភិបាល និង សូម បុរេសកម្ម ចំពោះ វិស័យ សុខាភិបាល រួម ទាំង វិស័យ ឯកជន ។
ទន្ទឹម នឹង នោះ លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី បាន លើកទឹកចិត្ត ដល់ មន្ទីរពេទ្យ ទាំងឡាយ ត្រូវ ស្វែងយល់ ពី បច្ចេកទេស ព្យាបាល នៅ ប្រទេស ជឿនលឿន បំផុត ផ្នែក វេជ្ជសាស្ត្រ និង ទស្សនកិច្ច សិក្សា ពី មន្ទីរពេទ្យ នៃ ប្រទេស ទាំងនោះ ដើម្បី យកមក អនុវត្ត ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព គុណភាព ក ម្រឹត អតិប្បរមា ។
លោក សាស្ដ្រាចារ្យ រដ្ឋមន្រ្តី ក៏ បាន ផ្តល់ អនុសាសន៍ មួយចំនួន ជូន ដល់ ថ្នាក់ដឹកនាំ និង មន្រ្តី សុខាភិបាល គ្រប់ លំដាប់ថ្នាក់ ដើម្បី បន្ត អនុវត្ត សកម្មភាព ក្នុង ការផ្តល់ សេវា សុខាភិបាល ជូន ដល់ ប្រជាពលរដ្ឋ ប្រកបដោយ គុណភាព និង ប្រសិទ្ធភាព ផងដែរ ។
លើស ពី នោះ លោក សាស្រ្តាចារ្យ រដ្ឋមន្រ្តី បាន ស្នើ ឱ្យ ថ្នាក់ដឹកនាំ មន្រ្តី និង បុគ្គលិក សុខាភិបាល ទាំងអស់ ត្រូវ សហការ គ្នា ចូលរួម លើក តម្លៃ ស្ថាប័ន តាមរយៈ ការពង្រឹង និង រៀបចំ ជា សកម្មភាព ដោយ បុរេសកម្ម តាមដាន អភិបាលកិច្ច និង ការកែលម្អ គ្រប់ ចំណុច ដែល បាន រកឃើញ ដើម្បី ធានា បាន ប្រសិទ្ធិភាព និង ចីរភាព ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃអង្គារ ទី៤ ខែមិថុនា ឆ្នាំ ២០២៤ នេះ សម្តេច មហា បវរធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន អនុញ្ញាតឱ្យ លោក Kelvin K . Mo ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា ប្រចាំ ទីក្រុង ម៉ុង រ៉េអាល់ ប្រទេស កាណាដា និង ប្រតិភូ ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ មួយចំនួន ពាក់ព័ន្ធ ការធ្វើ ធុរកិច្ច និង ពាណិជ្ជកម្ម ។
ប្រទេស កម្ពុជា និង ប្រទេស កាណាដា មាន ទំនាក់ទំនង ដ៏ រឹងមាំ និង យូរអង្វែង មក ហើយ ចាប់ផ្តើម តាំងពី ឆ្នាំ ១៩៥២ ព្រមទាំង បាន ភ្ជាប់ ទំនាក់ទំនង ការទូត ឡើងវិញ ក្នុង ឆ្នាំ ១៩៩៣ ។
ប្រទេស កាណាដា គឺជា ដៃគូ ដ៏ សំខាន់ របស់ កម្ពុជា ទាំង ការស្វែងរក សន្តិភាព នា ពេល អតីតកាល និង ការកសាង សេដ្ឋកិច្ច ដោយ ប្រទេស កាណាដា គឺជា ដៃគូ ពាណិជ្ជកម្ម លេខរៀង ទី៨ របស់ កម្ពុជា ។
ក្នុង ឆ្នាំ ២០២២ ទំហំ វិនិយោគ ដោយ ផ្ទាល់ (FDI) ពី ប្រទេស កាណាដា មាន ទំហំ រហូតដល់ ២. ០៦២ ពាន់ លាន ដុល្លារ បូករួម ជាមួយនឹង គំនិត ផ្តួចផ្តើម ចូលក្នុង ទីផ្សារ កាណាដា ដែល ផ្តល់ កូតា ក្នុង ការលើកលែង ពន្ធ ដល់ កម្ពុជា លើ មុខ ទំនិញ ដូចជា៖ សម្លៀកបំពាក់ ស្បែកជើង និង វាយន ភណ្ឌ ៕ យុទ្ធនាការ « ១ ម៉ឺន រៀល ១ម៉ឺន នាក់ » មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ទទួលបាន ទឹកប្រាក់ បរិច្ចាគ ពី សប្បុរ ជន ជាង ១. ១៦លាន ដុល្លារ គិត ត្រឹម ម៉ោង ៥ព្រឹក នេះ
( ភ្នំពេញ ) ៖ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត ប្រធាន កិត្តិយស នៃ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន បញ្ជាក់ ឱ្យដឹង ថា គិត ត្រឹម ម៉ោង ៥:០០ ព្រឹក ថ្ងៃទី ៤ ខែមិថុនា ឆ្នាំ ២០២៤ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន ទទួល ថវិកា បរិច្ចាគ ពី បងប្អូន ប្រជាពលរដ្ឋ ចំនួន ៩៩.៩៦៥ នាក់ ទទួលបាន ទឹកប្រាក់ ចំនួន ១. ១៦៤.០៤៧ ដុល្លារ អាមេរិក ។
លោកជំទាវ បណ្ឌិត សូម គោរព ថ្លែងអំណរគុណ ចំពោះ ការគាំទ្រ យ៉ាង ផុល ផុស ក្នុង ស្មារតី សាមគ្គីភាព « ខ្មែរ ជួយ ខ្មែរ » របស់ ប្រជាជាតិ ខ្មែរ ទាំងមូល ។
ជាមួយគ្នា នេះ លោកជំទាវ បណ្ឌិត សូម អំពាវនាវ ដល់ បងប្អូន សប្បុរសជន ដែល មាន បំណង ចូលរួម បរិច្ចាគ ក្នុង យុទ្ធនាការ នេះ សូម មេត្តា បន្ត ចូលរួម គាំទ្រ រហូតដល់ ថ្ងៃ បិទ យុទ្ធនាការ ។
សូម ជម្រាប ថា យុទ្ធនាការ « ១ ម៉ឺន រៀល ១ម៉ឺន នាក់ » មាន រយៈពេល ១ ខែ ចាប់ពី ថ្ងៃទី ០១ រហូតដល់ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២៤ ។ យុទ្ធនាការ នេះ ទទួលបាន ការការគាំទ្រ យ៉ាង ច្រើន ពី បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ ។ លោកជំទាវ បណ្ឌិត ចាត់ទុក ការចូលរួម នេះ សបញ្ជាក់ ឱ្យ ឃើញ ពី ការគាំទ្រ យ៉ាង ផុល ផុស ប្រកបដោយ ស្មារតី សាមគ្គីភាព យ៉ាង រឹងមាំ របស់ ប្រជាជាតិ ខ្មែរ ទាំងមូល ៕
