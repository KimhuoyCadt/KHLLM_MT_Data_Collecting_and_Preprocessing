( កំពង់ស្ពឺ ) ៖ ក្រុមប្រឹក្សា ឃុំ ទួល អំពិល ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ ដែល ជា អង្គ បោះឆ្នោត នៅ ថ្ងៃទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ ស្អែក នេះ បាន បង្ក អំពើហិង្សា លើ អ្នកដទៃ ដោយសារ ផឹក ស៉ី ស្រវឹង ។ ករណី ហិង្សា នេះ បាន កើតឡើង នៅ យប់ ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២៤ ។
នគរបាល ស្រុក បសេដ្ឋ បាន ឲ្យដឹង ថា ជនសង្ស័យ ដែល ត្រូវបាន ឃាត់ មាន ចំនួន ២នាក់ ក្នុង នោះ រួម មាន ឈ្មោះ ឈូក ង៉ែត អាយុ ៤៣ ឆ្នាំ រស់ នៅ ភូមិ សង្រ្គាម បូរ ឃុំ ទួល អំពិល ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ ជា អង្គ បោះឆ្នោត បក្ស ភ្លើង ទៀន និង បក្ខពួក ឈ្មោះ យ៉ុង ផាត អាយុ ៤៣ ឆ្នាំ រស់ នៅ ភូមិ តា ម៉ឺន ឃុំ ទួល អំពិល ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ ។
ក្រុមប្រឹក្សា បក្ស ភ្លើង ទៀន និង បក្ខពួក បាន ត្រួត គ្នា ធ្វើ សកម្មភាព វាយ ដាល់ ទៅ លើ ជនរងគ្រោះ ឈ្មោះ ដាង គ្រុយ ភេទ ប្រុស អាយុ ៤៦ ឆ្នាំ រស់ នៅ ភូមិ - ឃុំ កើត ហេតុ ខាង លើ ត្រូវ ចំ ត្រចៀក ចំនួន ១កន្លែង បបូរមាត់ ចំនួន ១កន្លែង និង ក្បាល ជង្គង់ បណ្ដាលឲ្យ រងរបួស ជា ទម្ងន់ ខណៈពេល ជនរងគ្រោះ និង ជនសង្ស័យ បាន ផឹក ស៊ី ជាមួយគ្នា ទាស់ ពាក្យសម្ដី គ្នា ទៅ វិញ ទៅ មក ភ្លាម នោះ ជនសង្ស័យ ខាងលើ ខឹង បាន ព្រួត គ្នា វាយ លើ ជនរងគ្រោះ ឲ្យ រងរបួស តែម្ដង ។
ពេល ធ្វើ សកម្មភាព រួច ក្រុម ជនសង្ស័យ បាន រត់គេចខ្លួន ចេញ ពី កន្លែង កើត ហេតុ បាត់ អស់ តែម្ដង ។ ចំណែក ជនរងគ្រោះ ត្រូវបាន សាច់ញាតិ បញ្ជូន ទៅ ព្យាបាល នៅពេទ្យ ឯកជន មួយ កន្លែង ក្នុង ឃុំ ទួល អំពិល ស្រុក បសេដ្ឋ ។
យោង តាម ចម្លើយ របស់ ជនសង្ស័យ ឈ្មោះ ឈូក ង៉ែត បាន ឆ្លើយ សារភាព ថា ខ្លួន និង បក្ខពួក ឈ្មោះ យ៉ុង ផាត ពិតជា បាន ធ្វើ សកម្មភាព ត្រួត គ្នា វាយ ទៅ លើ ជនរងគ្រោះ ឈ្មោះ ដាង គ្រុយ ប្រាកដ មែន មូលហេតុ ផឹក ស៊ី ទាស់ ពាក្យសម្តី គ្នា ៕
ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត ពោធិ៍សាត់ ថ្វាយ គ្រឿង រន្តាប់ បូជា ជូន លោក ឧកញ៉ា ឃ្លាំង មឿង និង ជំទាវ ខាន់ ខៀវ
លោក បណ្ឌិត កៅ គឹម ហួន ក៏ នឹង អញ្ជើញ ចូលរួម ក្នុង វេទិកា ចេជូ សម្រាប់ សន្តិភាព និង វិបុលភាព លើក ទី ១៩ ដែល គាត់ នឹង ថ្លែង សន្ទរកថា គន្លឹះ នៅក្នុង កិច្ចពិភាក្សា តុ មូល នៅក្រោម ប្រធានបទ « កិច្ចសហប្រតិបត្តិការ សម្រាប់ នៃ វិបុលភាព រួម » នា ឱកាស នៃ ពិធី បើក វេទិកា នេះ ។
លោក អគ្គ លេខាធិការ អាស៊ាន ក៏ នឹង អញ្ជើញ ចូលរួម ក្នុង ពិធី អបអរសាទរ នៃ ការចូលកាន់ តំណែង របស់ អគ្គ លេខាធិការ ទី៦ នៃ មជ្ឈមណ្ឌល អាស៊ាន កូរ៉េ ក្នុង ទីក្រុង សេអ៊ូល ផងដែរ ។
ក្នុង ឱកាស ទស្សនកិច្ច នេះ ដែរ ដើម្បី ជំរុញ ការទូត អាស៊ាន បន្ថែម ទៀត លោក បណ្ឌិត កៅ គឹម ហួន ក៏ នឹង ឆ្លៀត ឱកាស ទៅ ធ្វើបាឋ កថា នៅ សាកលវិទ្យាល័យ Sogang ដើម្បី បញ្ជូន សារ និង ប្រាប់ ពី សាច់រឿង របស់ អាស៊ាន ដល់ ក្រុម និស្សិត ឱ្យ ពួកគេ យល់ដឹង កាន់តែ ច្បាស់ អំពី អាស៊ាន ៕
តើ ការស្លាប់ របស់ មេដឹកនាំ អ៉ីរ៉ង់ នេះ ជា រឿង ចៃដន្យ ឬ ក៏ អាច ជា ការរៀបចំ ទុក ? ហើយ បញ្ហា នៅ តំបន់ មជ្ឈិមបូព៌ា អាចនឹង ស្ងប់ស្ងាត់ ឬ កាន់តែ ឡើង កម្ដៅ ថែម ក្រោយ ព្រឹត្តិការណ៍ នេះ ?
* លោក ម៉ារ យ៉ារិទ្ធិ អ្នកតាមដាន ព្រឹត្តិការណ៍ ជាតិ និង អន្តរជាតិ * លោក ពុយ គា ប្រធាន ក្លឹប អ្នកកាសែត កម្ពុជា
រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច នាំយក ថវិកា ៤០ លាន រៀល ប្រគល់ ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤
( ភ្នំពេញ ) ៖ លោក ជា សុមេធី រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង លោកស្រី ជា ផល្គុន ព្រមទាំង ក្រុមគ្រួសារ បាន នាំយក នូវ ថវិកា ចំនួន ៤០.០០០.០០០ រៀល មក ប្រគល់ ជូន កាកបាទ ក្រហម កម្ពុជា ក្នុង ឱកាស ខួប ទី១៦១ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២៤ ក្រោម ប្រធានបទ « រួមគ្នា ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដើម្បី សហគមន៍ មាន សុខភាព ល្អ និង មាន ភាពធន់ នឹង អាកាសធាតុ » ។
ពិធី ប្រគល់ និង ទទួល ថវិកា សប្បុរសធម៌ ខាងលើ នេះ បាន ធ្វើឡើង នៅ ស្នាក់ការ កណ្ដាល កាកបាទ ក្រហម កម្ពុជា កាលពី ដើម សប្តាហ៍ នេះ ក្រោម អធិបតីភាព លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា និង លោក ជា សុមេធី រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង លោកស្រី ជា ផល្គុន ព្រមទាំង គណៈប្រតិភូ នៃ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ។
ក្នុង ឱកាស នោះ លោកស្រី អគ្គ លេខាធិការ បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ លោក រដ្ឋមន្ត្រី និង លោកស្រី ព្រមទាំង ក្រុមគ្រួសារ ដែល បាន ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ សកម្មភាព មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ។
ទន្ទឹម នឹង នោះ លោកស្រី អគ្គ លេខាធិការ ក៏ បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ចំពោះ លោក រដ្ឋមន្ត្រី ដែល កន្លងមក ជា អតីត អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រៃវែង និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រៃវែង ដែល បាន ដឹកនាំ សកម្មភាព មនុស្សធម៌ ជួយ ដល់ ប្រជាជនរងគ្រោះ និង ងាយ រងគ្រោះ បំផុត នៅក្នុង ខេត្ត ព្រៃវែង ព្រមទាំង ការជួយសង្គម និង អភិវឌ្ឍ ជាតិ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី៖ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បន្ត ផ្តល់ អាហារូបករណ៍ ជូន សិស្ស - និស្សិត ក្រីក្រ ក សាង មូលធន មនុស្ស ដើម្បី អភិវឌ្ឍន៍ ជាតិ
( ភ្នំពេញ ) ៖ លោកជំទាវ បណ្ឌិត ពេជ ចន្ទ មុន្នី ហ៊ុន ម៉ាណែត បាន អះអាង ថា សម្តេច តេជោ ហ៊ុន សែន ប្រធាន ព្រឹទ្ធសភា កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន នឹង បន្ត ផ្តល់ អាហារូបករណ៍ ជូន ដល់ សិស្ស និស្សិត មកពី គ្រួសារ ក្រីក្រ និង ខ្វះខាត ដើម្បី រួមចំណែក កសាង មូលធន មនុស្ស ។
លោកជំទាវ បណ្ឌិត បាន អរគុណ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង យក អស់ ពី កម្លាំង កាយ ចិត្ត បញ្ញា ស្មារតី និង ធនធាន ក្នុង ការចូលរួមចំណែក និង បំពេញ តួនាទី ប្រកបដោយ ភាពប៉ិនប្រសប់ ស ស្រាក់សស្រះ និង ភាពបុរេសកម្ម ដើម្បី បុព្វហេតុ ដ៏ ថ្លៃថ្លា ឧត្តុង្គឧត្តម ជូន ជាតិ និង ប្រជាជន ។
សូម បញ្ជាក់ ថា តាមរយៈ កម្មវិធី អាហារូបករណ៍ របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត បាន ផ្តល់ ឱកាស សិក្សា ជាច្រើន កន្លែង ដល់ សិស្ស និង និស្សិត មក ពី គ្រួសារ ក្រីក្រ ឱ្យ ទទួលបាន ការអប់រំ និង បញ្ចប់ ការសិក្សា កម្រិត ខ្ពស់ ។ សិស្ស និស្សិត ខ្លះ មិន ត្រឹម ទទួលបាន អាហារូបករណ៍ សិក្សា ក្នុង ប្រទេស ប៉ុណ្ណោះ ទេ តែ ក៏ ទទួលបាន អាហារូបករណ៍ សម្រាប់ សិក្សា នៅ ក្រៅ ប្រទេស ថែម ទៀត ផង ។
តាមរយៈ ចំណេះដឹង ទទួលបាន ពី ការអប់រំ ទាំង នេះ បាន ផ្តល់ ទុន ដ៏ ធំ សម្រាប់ ពួកគេ យក ទៅ កសាង ជីវិត ឱ្យ ប្រសើរ ហើយ អ្នក ខ្លះ ទៀត ក៏ បាន ប្រឡង ចូល បំពេញ ការងារ ក្នុង ក្របខណ្ឌ រាជការ បម្រើ ជាតិ មាតុភូមិ ពោរពេញ ដោយ សក្តានុពល ថែម ទៀត ផង ៕
នៅក្នុង ការប្រឡង ដែល មាន ៧សំណួរ អំពី ទ្រឹស្ដី លោក អាន ស៊ី ថា វ ជា គ្រូបង្គោល បាន ដាក់ នូវ លំហាត់ អនុវត្តន៍ ក្នុង របៀប សរសេរ សេចក្តីប្រកាស ព័ត៌មាន សម្រាប់ ក្រុមហ៊ុន ឯកជន ថែម ទៀត ។ សិស្ស បាន ប្រឡង ប្រកបដោយ ការយកចិត្តទុកដាក់ និង ខិតខំ ប្រឹងប្រែង យ៉ាង ខ្លាំង ដើម្បី អាច ប្រឡង ជាប់ និង អាច ទទួលបាន វិញ្ញាបនបត្រ បញ្ជាក់ ការសិក្សា ពី មជ្ឈមណ្ឌល បណ្ដុះបណ្ដាល Fresh News (FTC) ។
លើស ពី នេះ ទៀត បើ ទោះបីជា FTC ជា ថ្នាក់ បង់ ថ្លៃ សិក្សា ក៏ ពិត មែន ប៉ុន្តែ គោលបំណង សំខាន់ របស់ មជ្ឈមណ្ឌល គឺ ផ្ដល់ជូន ដល់ សិក្ខាកាម នូវ មូលដ្ឋានគ្រឹះ នៃ ការសរសេរ ព័ត៌មាន ក្រមសីលធម៌ អ្នកសារព័ត៌មាន ដើម្បី អាច មាន សមត្ថភាព ក្នុង ការប្រកប អាជីព អ្នកសារព័ត៌មាន ដែល មាន តម្លៃ មួយ រូប ។
ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ អាណត្តិ ទី៤នេះ មាន គណបក្ស នយោបាយ ចំនួន ៥ នឹង ចូលរួម ប្រកួតប្រជែង រួម មាន៖
ទី១៖ គណបក្ស ប្រជាជន កម្ពុជា ទី២៖ គណបក្ស ឆន្ទៈ ខ្មែរ ទី ៣៖ គណបក្ស កម្លាំង ជាតិ ទី៤៖ គណបក្ស ហ៊្វុនស៊ិនប៉ិច និង ទី៥៖ គណបក្ស ខ្មែរ រួបរួម ជាតិ ៕ ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ បញ្ជា កម្លាំង នគរបាល រាជធានី ភ្នំពេញ ស្រាវជ្រាវ បង្ក្រាប ទីតាំង លួច កែច្នៃ និង ចែកចាយ ដាវ សាម៉ូរ៉ៃ ខុស ច្បាប់ ដែល ជា សម្ភារ ក្មេង ទំនើង ធ្វើ សកម្មភាព
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន ដាក់ បទបញ្ជា កម្លាំង ការិយាល័យ ជំនាញ និង អធិការដ្ឋាន នគរបាល ខណ្ឌ ទាំង ១៤ ស្រាវជ្រាវ ទីតាំង លួច កែច្នៃ និង ចែកចាយ ដាវ សាម៉ូរ៉ៃ ខុស ច្បាប់ ដែល ជា សម្ភារ ក្មេង ទំនើង ប្រើប្រាស់ ធ្វើ សកម្មភាព ។
ដាវ សាម៉ូរ៉ៃ គឺជា សម្ភារ សម្រាប់ ធ្វើ សកម្មភាព យ៉ាង ពេញនិយម ពីសំណាក់ ក្រុម ក្មេង ទំនើង បង្ក អុក ឡុក សង្គម ដោយ ពួកគេ ប្រើប្រាស់ ដើម្បី បង្ក ហិង្សា ទៅ គូ ជម្លោះ ឬ ឈានដល់ ការប្រព្រឹត្ត អំពើ ចោរកម្ម ថែម ទៀត ផង ។ ដាវ សាម៉ូរ៉ៃ ត្រូវបាន ក្រុម ក្មេង ទំនើង ទាំងនោះ កែច្នៃ ដាក់ ក្រោម កែប ម៉ូតូ ឬ កៀន បំពង់ ស៉ី ម៉ាំង ម៉ូតូ ហើយ ខ្លះ ដាក់ ក្នុង កាតាប ផងដែរ ។
ទាក់ទិន ករណី ក្មេង ទំនើង នេះ ដោយ អនុវត្ត តាម បទញ្ជា ដ៏ ម៉ឺងម៉ាត់ របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា . កម្លាំង ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ក្នុង រយៈពេល ២ ថ្ងៃ មក នេះ បាន បង្ក្រាប ករណី ក្មេង ទំនើង បង្ក អុក ឡុក សង្គម ចំនួន ៥ករណី ឃាត់ខ្លួន មនុស្ស ២០ នាក់ ។
លោក ឧត្តមសេនីយ៍ ឯក ជួន ណារិន្ទ អគ្គ ស្នងការ រង និង ជា ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ការបង្រ្កាប នេះ ធ្វើឡើង នៅ ថ្ងៃទី ២៣ - ២៤ ខែឧសភា ឆ្នាំ ២០២៤ ដោយ ក្រុម ក្មេង ទំនើង កាន់កាប់អាវុធ ដោយ គ្មាន ការអនុញ្ញាត និង បង្ក អំពើហិង្សា ។
លោក បាន បន្ដ ថា ដោយ អនុវត្ត តាម បទបញ្ជា របស់ សម្ដេច ធិបតី ហ៊ុន ម៉ាណែត . លោក អភិសន្ដិ បណ្ឌិត ស សុខា ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ និង នាយ ឧត្តមសេនីយ៍ ស ថេត អគ្គ ស្នងការ នគរបាល ជាតិ កម្លាំង នគរបាល រាជធានី ភ្នំពេញ នឹង បន្ដ ប្រតិបត្តិការ នេះ យ៉ាង ម៉ឺងម៉ាត់ បំផុត ដើម្បី រក្សា សណ្ដាប់ធ្នាប់ របៀបរៀបរយ និង សុវត្ថិភាព សង្គម ជូន ប្រជាពលរដ្ឋ ៕ មន្ដ្រី អាជ្ញាធរ គ្រឿងញៀន ស្នើឲ្យ ប្រជាពលរដ្ឋ ទាញយក App Nodrug ដើម្បី ទទួលបាន ចំណេះដឹង និង រាយការណ៍ បញ្ហា គ្រឿងញៀន ជូន ទៅ សមត្ថកិច្ច
( កំពង់ចាម ) ៖ លោក ថោង សុគន្ធា អគ្គ លេខាធិការ រង អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃុំ កោះ រកា បាន ជួប សំណេះសំណាល សួរសុខទុក្ខ និង ពិភាក្សា ការងារ ជាមួយ ថ្នាក់ដឹកនាំ គណបក្ស មូលដ្ឋាន ឃុំ កោះ រកា នា ល្ងាច ថ្ងៃទី ២៤ ខែឧសភា ឆ្នាំ ២០២៤ ។
លោក ផន ផូ ប្រធាន គណបក្ស ឃុំ កោះ រកា បាន សម្តែង នូវ ទឹកចិត្ត សប្បាយរីករាយ ក្នុង នាម ជា មហា គ្រួសារ គណបក្ស ប្រជាជន កម្ពុជា ហើយ លោក បាន ជម្រាប ជូន ពី សភាពការណ៍ ក្នុង មូលដ្ឋាន សំដៅ ភាព សុខសាន្ត ក្នុង មូលដ្ឋាន កោះ រកា ទាំងមូល និង ការត្រៀមលក្ខណៈ រួចរាល់ សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ខេត្ត ក្រុង ស្រុក នៅ ថ្ងៃទី ២៦ ខែឧសភា ឆ្នាំ ២០២៤ ។
ក្នុង នាម លោក មាស វិរិទ្ធ ប្រធាន ក្រុម គណបក្ស ចុះ មូលដ្ឋាន ស្រុក កំពង់សៀម ក្នុង ឱកាស នោះ លោក ថោង សុគន្ធា បាន ថ្លែងអំណរគុណ កោតស សើរ ដល់ ក្រុមការងារ ទាំងអស់ ពិសេស គណបក្ស ឃុំ ដែល បាន ខិតខំ បំពេញ ការងារ អភិវឌ្ឍ មូលដ្ឋាន សណ្តាប់ធ្នាប់ សន្តិសុខ ចូលរួម អនុវត្ត នូវ គោល នយោបាយ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ។
ជាមួយគ្នា នេះ លោក ថោង សុគន្ធា បាន ផ្សព្វផ្សាយ អប់រំ ឲ្យ ប្រជាពលរដ្ឋ ចៀស ចាក ឆ្ងាយ ពី បញ្ហា គ្រឿងញៀន និង បំផុស ឲ្យ ទាញយក App Nodrug មក ប្រើប្រាស់ ដើម្បី ទទួលបាន ចំណេះដឹង និង រាយការណ៍ ដើម្បី ដោះស្រាយ កង្វល់ របស់ ប្រជាពលរដ្ឋ ៕
សម្តេច តេជោ ហ៊ុន សែន បញ្ជាក់ ទៀត ថា ការសម្រេច ក្នុង ការបើក ការដ្ឋាន សាងសង់ នៅ ពេលណា នោះ គឺជា សិទ្ធិ ផ្តាច់ មុខ របស់ នាយក រដ្ឋមន្ត្រី ហ៊ុន ម៉ាណែត ។
គម្រោង ផ្លូវ នាវាចរណ៍ និង ប្រព័ន្ធ ភស្ដុភារកម្ម ទន្លេ បាសាក់ « ព្រែក ជីក ហ្វូណន តេជោ » តភ្ជាប់ ផ្លូវ ទឹក រវាង ទន្លេរ ទៅកាន់ សមុទ្រ កម្ពុជា ដោយ ឆ្លងកាត់ ខេត្ត កណ្តាល តាកែវ កំពត និង ខេត្ត កែប ដែល មាន ប្រវែង ១៨០ គីឡូម៉ែត្រ គ្រោង ចំណាយ ទុន សាងសង់ ប្រមាណ ១.៧០០ លាន ដុល្លារ អាមេរិក ។
ព្រែក ជីក ហ្វូណន តេជោ នឹង តភ្ជាប់ ពី កំពង់ផែ ស្វយ័ត ភ្នំពេញ ទៅកាន់ កំពង់ផែ ទឹក ជ្រៅ ដែល កំពុង ស្ថិត ក្រោម គម្រោង សាងសង់ នៅក្នុង ខេត្ត កែប និង កំពង់ផែ ទឹក ជ្រៅ ដែល ត្រូវបាន សាងសង់ រួចរាល់ នៅក្នុង ខេត្ត ព្រះសីហនុ ។ បច្ចុប្បន្ន ពាណិជ្ជកម្ម មួយ ភាគ ធំ របស់ កម្ពុជា ជាពិសេស ចេញ និង ចូល ទីក្រុង ភ្នំពេញ គឺ ត្រូវ ធ្វើឡើង កាត់ តាម កំពង់ផែ ភាគ ខាងត្បូង របស់ វៀតណាម តួយ៉ាង ដូចជា កំពង់ផែ Cai Mep ។
រដ្ឋាភិបាល កម្ពុជា បាន គណនា យ៉ាង លម្អិត ថា ព្រែក ជីក ហ្វូណន តេជោ នឹង ជួយ កាត់បន្ថយ ការពឹងផ្អែក លើ កំពង់ផែ វៀតណាម បាន រហូតដល់ទៅ ៧០ ភាគរយ ។ នា ពេល បច្ចុប្បន្ន កំពង់ផែ របស់ កម្ពុជា មិន សូវ ទទួលបាន ការធ្វើ ពាណិជ្ជកម្ម ច្រើន នោះ ទេ ហើយក៏ មិន សូវ ប្រមូល ពន្ធ បាន ច្រើន នោះ ដែរ ។
លោក Napintorn បាន ថ្លែង ថា ប្រទេស ទាំង ពីរ ចាត់ទុក FTA នេះ ថា ជា យន្តការ ដ៏ សំខាន់ មួយ ក្នុង ការលើកកម្ពស់ ពាណិជ្ជកម្ម និង ការវិនិយោគ ទ្វេ ភាគី កាត់បន្ថយ របាំង ពាណិជ្ជកម្ម និង ផ្តល់ លទ្ធភាព ចូល ទៅកាន់ ទីផ្សារ កាន់តែ ប្រសើរឡើង ជាពិសេស សម្រាប់ ផលិតផល កសិកម្ម ដែល មាន បំណង ឈានដល់ គោលដៅ ចំនួន ១២០ លាន ដុល្លារ នៅ ឆ្នាំ ២០២៥ ។
ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ បាន កើនឡើង ជាលំដាប់ ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ មក នេះ ជាមួយនឹង ទំហំ ពាណិជ្ជកម្ម សរុប ចំនួន ១៨. ៧លាន ដុល្លារ ក្នុង ឆ្នាំ ២០២៣ ។ សម្រាប់ រយៈពេល បី ខែ ដំបូង នៃ ឆ្នាំ ២០២៤ នេះ តម្លៃ ពាណិជ្ជកម្ម ទ្វេ ភាគី រវាង ប្រទេស ថៃ និង ប៊ូតាន មាន ចំនួន ៣. ០៦ លាន ដុល្លារ ។
ការនាំចេញ របស់ ថៃ ទៅកាន់ ប៊ូតាន មាន តម្លៃ ៣. ០៣ លាន ដុល្លារ ខណៈ ការនាំចូល មាន តម្លៃ ៣០ ០០០ ដុល្លារ ។ ទំនិញ ការនាំចេញ សំខាន់ ៗ រួម មាន កុំព្យូទ័រ និង គ្រឿង បន្លាស់ កុំព្យូទ័រ វាយន ភណ្ឌ ស្រូវ សាលី ឧបករណ៍ អគ្គិសនី និង អាហារ កែច្នៃ ញ៉ាំ បាន ភ្លាម ៗ ។ ទំនិញ នាំចូល សំខាន់ ៗ រួម មាន គ្រឿង បរិក្ខារ អាកាសចរណ៍ និង គ្រឿងផ្សំ ផលិតផល ដែក និង ផលិតផល សិល្បៈ ។ នេះ បើ យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ៕
