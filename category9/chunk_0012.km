វត្តមាន ប្រាសាទ បុរាណ នេះ បាន បង្ហាញ ឱ្យដឹង ថា ក្នុង តំបន់ អង្គរ - សៀមរាប បច្ចុប្បន្ន ក៏ ធ្លាប់ មាន សំណង់ ស្ថាបត្យកម្ម ខ្លះ ដែរ កាលពី សម័យ បុរេ អង្គរ ប៉ុន្តែ មកដល់ សម័យ អង្គរ ប្រាសាទ និង សំណង់ ស្ថាបត្យកម្ម ទាំងនោះ ក៏ ត្រូវបាន បាក់ ស្រុត លិច ក្រោម ដី និង ត្រូវបាន លុប ដោយ សំណង់ ថ្មី ៗ នា សម័យ អង្គរ តួយ៉ាង ដូចជា ប្រាសាទ អក យំ នេះ ផ្នែក មួយចំនួន ក៏ ត្រូវបាន កប់ ក្រោម ដី ទំនប់ ខាងត្បូង នៃ បារាយណ៍ ខាងលិច ឬ បារាយណ៍ ទឹក ថ្លា ក្នុង ពេល កសាងឡើង នា រជ្ជកាល ព្រះបាទ ឧទយាទិត្យ វ រ្ម័ន ទី២ ( ១០៥០ - ១០៦៦) ។
បើ តាម អាជ្ញាធរ ជាតិ អប្សរា ដំណើរការ ជួសជុល ប្រាសាទ អក យំ មកដល់ ឆ្នាំ ២០២០ នេះ មាន រយៈពេល ជិត មួយ ឆ្នាំ ហើយ ដែល ក្រុម អ្នកជំនាញ អាជ្ញាធរ ជាតិ អប្សរា បាន ប្រឹងប្រែង សង្គ្រោះ ឱ្យ រួចផុត ពី ហានី ភ័យ ដើម្បីឱ្យ បុរាណ ដ្ឋាន មួយ នេះ មាន ភាពរឹងមាំ ស្រស់ស្អាត និង ចៀស ផុត ពី គ្រោះថ្នាក់ ផ្សេង ៗ សម្រាប់ ទទួលស្វាគមន៍ ទេសចរ គ្រប់ ទិសទី មក ទស្សនា ឱ្យ បាន ច្រើន កុះករ ។
បន្ត ពី នោះ ក្រុមការងារ បាន ដក ដើម ពោធិ៍ រើរាន ព្រះភូមិ នៅ ផ្នែក ខាងកើត ដែល ជា ច្រក ចូល ដ៏ សំខាន់ ហើយ ពង្រឹង ខឿន ទី៣ និង កម្រាល ខឿន ដែល ឫស ពោធិ៍ បាន ចាក់ ចូល ធ្វើឱ្យ ខូចខាត រួចហើយ ពង្រឹង និង ជួសជុល ខឿន ប្រាង្គ ដំឡើង កាំ ជណ្តើរ ថ្ម ភក់ និង ដាក់ បង្កាន់ដៃ ឥដ្ឋ សងខាង ។ ចំណែក នៅ កណ្តាល ប្រាង្គ ក្រុមការងារ បាន រៀបចំ ពង្រឹង ជើង ទម្រ និង លើក បំណែក ជើង ទម្រមក ដាក់ នៅ ទីតាំង ដើម វិញ ។
ប្រធាន គម្រោង រូប នេះ បាន បញ្ជាក់ ថា គោលបំណង នៃ ការជួសជុល ប្រាសាទ អក យំ គឺ ដើម្បី រួមចំណែក លើក តម្លៃ ប្រាសាទ នេះ ឱ្យ ផុត ពី ការបំផ្លាញ របស់ ធម្មជាតិ បរិស្ថាន និង មនុស្ស ឱ្យ សម តម្លៃ ជា បេតិកភណ្ឌ ពិភពលោក ។
លោក សុជាតិ សង្ឃឹម ថា ក្រោយ បញ្ចប់ គម្រោង ជួសជុល ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នឹង មាន ភ្ញៀវ ទេសចរ ស្គាល់ ច្រើន មក ទស្សនា ច្រើន ដូច បារាយណ៍ ដែរ ដើម្បី សិក្សា ស្វែងយល់ អំពី ប្រវត្តិសាស្ត្រ បរិស្ថាន ការជួសជុល សំណង់ ប្រាសាទ ភ្នំ ដែល មាន វ័យ ចំណាស់ ជាង គេ នៅក្នុង តំបន់ រមណីយដ្ឋាន អង្គរ ៕ អភិបាល ខេត្ត ស្វាយរៀង ស្នើ ឱ្យ គ្រប់ អង្គភាព ពាក់ព័ន្ធ ទាំងអស់ រៀបចំ ទីតាំង បម្រុងទុក ឱ្យ បាន រួចរាល់ តាម ផែនការ ត្រៀម ជួយ អ្នក ដែល មាន ជំងឺ កូវីដ១៩
សូម បញ្ជាក់ ថា ឆ្លើយតប នឹង សភាពការណ៍ បច្ចុប្បន្ន ដែល សកលលោក ក៏ ដូចជា ប្រទេស កម្ពុជា យើង កំពុង រង នូវ ការវាយលុក ពី ជំងឺ កូវីដ - ១៩ រដ្ឋបាល ខេត្ត ស្វាយរៀង បាន ត្រៀម នូវ ទីតាំង បម្រុងទុក សម្រាប់ ដាក់ ឲ្យ នៅ ដាច់ដោយឡែក ចំពោះ អ្នក ដែល មាន ការសង្ស័យ និង អ្នក ផ្ទុក នូវ ជំងឺ កូវីត - ១៩ នេះ នៅ តាម ទីតាំង មួយចំនួន ទាំង នៅ តាម បណ្ដា មន្ទីរពេទ្យ ខេត្ត ក្រុង ស្រុក សណ្ឋាគារ និង ផ្ទះសំណាក់ ដោយ សរុប មាន ចំនួន ១១១ បន្ទប់ ស្មើនឹង ២១១ គ្រែ ៕
លោក ឡាំ ហេង ហួត បរិច្ចាគ ប្រាក់ បៀវត្ស៦ ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ឡាំ ហេង ហួត អនុប្រធាន និង ជា អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៦ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ដោះស្រាយ ការលំបាក ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល ពី ឥទ្ធិពល នៃ ជំងឺ កូវីដ១៩ ។
ប្រាក់ បៀវត្ស របស់ លោក ឡាំ ហេង ហួត ដែល បរិច្ចាគ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នេះ គិត ចាប់ពី ខែមេសា ដល់ ខែកញ្ញា ។ លោក ឡាំ ហេង ហួត ក្នុង នាទី របស់ លោក នា ពេល បច្ចុប្បន្ន មាន ឋានៈ ស្មើ រដ្ឋមន្ត្រី ។ ដូច្នេះ ប្រាក់ បៀវត្ស របស់ លោក ស្មើនឹង រដ្ឋមន្ត្រី ផងដែរ ។
សូម ជម្រាប ថា នៅ ថ្ងៃ ម្សិលមិញ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រេចបាន បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ បៀវត្ស របស់ សម្តេច តេជោ ដែល បរិច្ចាគ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ។
ប្រាក់ខែ នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា មាន ប្រមាណ ១០លាន រៀល ក្នុង ១ខែ ខណៈ ប្រាក់ខែ ឧប នាយក រដ្ឋមន្ត្រី ៨លាន រៀល មួយ ខែ ប្រាក់ខែ ទេសរដ្ឋមន្រ្តី ចំនួន ៦លាន រៀល និង រដ្ឋមន្ត្រី មាន ប្រមាណ ៥លាន រៀល ក្នុង ១ខែ ៕
នាយ ឧត្តមសេនីយ៍ ឈន សារ៉ាណេ ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ៥០ % ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ ឈន សារ៉ាណេ អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន ភស្តុភារ និង ហិរញ្ញវត្ថុ ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ៥០% ចំនួន ៧ខែ ចាប់ពី ខែមេសា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រេចបាន បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០៕ អភិបាល ខេត្ត កំពង់ស្ពឺ ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ៧ ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( កំពង់ស្ពឺ ) ៖ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៧ខែ ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
( ភ្នំពេញ ) ៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ នៅ យប់ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៧ខែ ចាប់ពី ខែមេសា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ប្រាក់ខែ នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា មាន ប្រមាណ ១០លាន រៀល ក្នុង ១ខែ ខណៈ ប្រាក់ខែ ឧប នាយក រដ្ឋមន្រ្តី ៨លាន រៀល . ប្រាក់ខែ ទេសរដ្ឋមន្រ្តី ចំនួន ៦លាន រៀល និង រដ្ឋមន្ត្រី មាន ប្រមាណ ៥លាន រៀល ក្នុង ១ខែ ៕ អតីត សិស្ស មន្រ្តី ជាន់ ខ្ពស់ ជំនាន់ ទី២ សាលា ភូមិន្ទ រដ្ឋបាល ចូលរួម វិភាគទាន ជាង ៧ ពាន់ ដុល្លារ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
ប្រាក់ខែ នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា មាន ប្រមាណ ១០លាន រៀល ក្នុង ១ខែ ខណៈ ប្រាក់ខែ ឧប នាយក រដ្ឋមន្រ្តី ៨លាន រៀល . ប្រាក់ខែ ទេសរដ្ឋមន្រ្តី ចំនួន ៦លាន រៀល និង រដ្ឋមន្ត្រី មាន ប្រមាណ ៥លាន រៀល ក្នុង ១ខែ ៕ លោក គង់ វិបុល អគ្គ នាយកដ្ឋាន ពន្ធដារ ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស៦ ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក គង់ វិបុល ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៦ខែ ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ក្នុង លិខិត បាន បញ្ជាក់ ថា « ខ្ញុំបាទ សូម ចូលរួម សម្ដែង នូវ សមានចិត្ដ តាមរយៈ ការស្ម័គ្រចិត្ត ជូន ទៅ គណៈកម្មាធិការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ (Coivd-19) នូវ ប្រាក់ ប្រៀវត្ស របស់ ខ្ញុំបាទ ជា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ ចំនួន ស្មើនឹង ៦ខែ ដោយ គិត ចាប់ពី ថ្ងៃមេសា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ » ។
សូម ជម្រាប ថា នៅ ថ្ងៃ ម្សិលមិញ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រេចបាន បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ៕ សម្តេច តេជោ ហ៊ុន សែន ផ្ញើ លិខិត ថ្លែងអំណរគុណ លោក ព្រុំ សុខា ចំពោះ ការបរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ដល់ រាជ រដ្ឋាភិបាល សម្រាប់ ប្រយុទ្ធ ប្រឆាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ផ្ញើ លិខិត ថ្លែងអំណរគុណ ដល់ លោក ព្រុំ សុខា រដ្ឋមន្ដ្រី ក្រសួង មុខងារ សាធារណៈ និង លោកជំទាវ ដែល បាន ឧបត្ថម្ភ ទឹកប្រាក់ ចំនួន ១ម៉ឺន ដុល្លារ អាមេរិក ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រាប់ សកម្មភាព ប្រយុទ្ធ ប្រឆាំង និង ការរាត ត្បាត ជំងឺ កូវីដ១៩ ដែល កំពុង បង្ក គ្រោះ ភ័យ ដល់ សុខភាព និង ជីវិត របស់ ប្រជាជន កម្ពុជា ។ នេះ បើ តាម លិខិត ថ្លែងអំណរគុណ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ០២ ខែមេសា ។
ក្នុង លិខិត ថ្លែងអំណរគុណ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា « ក្នុង ស្មារតី នេះ រាជ រដ្ឋាភិបាល សូម ថ្លែងអំណរគុណ និង កោតសរសើរ ដោយ ស្មោះ ចំពោះ ឯកឧត្ដម និង លោកជំទាវ ដែល បាន បរិច្ចាគ នូវ ជំនួយ ជា ថវិកា ចំនួន១០.០០០ $ ( ដប់ ពាន់ ដុល្លារ ) អាមេរិក ជូន ដល់ រាជ រដ្ឋាភិបាល សម្រាប់ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ដ៏ កាច សាហាវ មួយ នេះ ជា កិច្ច បំពេញ កាតព្វកិច្ចការពារ និង សង្គ្រោះ សុខភាព និង ជីវិត ប្រជាជន កម្ពុជា » ។
មិន ដែល ឲ្យ ស្ងាត់ ទេ អ័រគីដេវីឡា បាន ផ្តល់ ជូន ប្រ៉ូម៉ូសិន ប្លែក ! ពុំ ធ្លាប់ មាន ពីមុន មក នោះ លោក អ្នក អាច ទទួលបាន ការបញ្ចុះ តម្លៃ យ៉ាង ពិសេស រហូតដល់ ២០% ។
( ប៉េកាំង ) ៖ ក្រោយ រង ការចោទប្រកាន់ ពី សហរដ្ឋ អាមេរិក ថា មាន ការលាក់បាំង តួលេខ ពិតប្រាកដ នៃ អ្នក ឆ្លង និង ស្លាប់ ដោយសារ ជំងឺ COVID-19 នៅក្នុង ប្រទេស ចិន រដ្ឋាភិបាល ទីក្រុង ប៉េកាំង នា ថ្ងៃព្រហស្បតិ៍ នេះ បាន ឆ្លើយតប វិញ ថា វា គឺជា ការអះអាង ឥត កេរ្តិ៍ ខ្មាស់ របស់ អ្នកនយោបាយ អាមេរិក មួយចំនួន ដែល ពោរពេញ ដោយ ការភូតកុហក ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ពី សារព័ត៌មាន Sputnik នៅ ថ្ងៃព្រហស្បតិ៍ ទី០២ ខែមេសា ឆ្នាំ ២០២០ ។
( ប៉ារីស )៖ ម៉ាស សម្រាប់ ប្រើប្រាស់ នៅ ចំពោះមុខ ការរាតត្បាត នៃ ជំងឺ COVID-19 ដែល បារាំង បាន បញ្ជាទិញ ពី ចិន នោះ ត្រូវបាន អាមេរិក ដែល ជា សម្ព័ន្ធមិត្ត របស់ ខ្លួន ទិញ យក ទៅ បាត់ នៅ នាទី ចុងក្រោយ គឺ នៅពេល ប្រអប់ ស្តុក ម៉ាស ទាំងនោះ កំពុង ស្ថិត ក្រោម ការរង់ចាំ ជញ្ជូន ទៅ ដាក់ លើ យន្តហោះ ដើម្បី ដឹក ទៅ ប្រទេស បារាំង ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន RT នៅ ថ្ងៃព្រហស្បតិ៍ ទី០២ ខែមេសា ឆ្នាំ ២០២០ ។
យោង តាម សារព័ត៌មាន RT អាជ្ញាធរ នៅ ប្រទេស បារាំង បាន ឲ្យដឹង ថា សហរដ្ឋ អាមេរិក បាន ប្រើ លុយ លើស បារាំង បី ទៅ បួន ដង ក្នុង ទម្រង់ ជា សាច់ប្រាក់ សុទ្ធ ដើម្បី កាត់ មុខ ទិញ យក ម៉ាស ប្រមាណ ៦០ លាន បន្ទះ ដែល កំពុង ស្ថិត ក្រោម ការរង់ចាំ ជញ្ជូន ទៅ ដាក់ លើ យន្តហោះ ដែល ត្រៀម នឹង ហោះ មកកាន់ ប្រទេស បារាំង ទៅ ហើយ ។ ហេតុការណ៍ នោះ បាន កើតឡើង ក្នុង សប្តាហ៍ នេះ ប៉ុន្តែ ពុំ មាន ការបញ្ជាក់ ឲ្យ ច្បាស់ ថា កាលពី ថ្ងៃ ណា ឡើយ ។
ឧប នាយក រដ្ឋមន្រ្តី ហោ ណាំ ហុង ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស៦ ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ ឧប នាយក រដ្ឋមន្រ្តី ហោ ណាំ ហុង ក្រៅពី បាន ឧបត្ថម្ភ ២ម៉ឺន ដុល្លារ រួចហើយ . នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៦ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ដោយ ចាប់ផ្តើម ពី ខែមេសា នេះ តទៅ ។
អភិបាល រាជធានី ភ្នំពេញ ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ៧ ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៧ខែ ចាប់ពី ខែមេសា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ប្រាក់ខែ នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា មាន ប្រមាណ ១០លាន រៀល ក្នុង ១ខែ ខណៈ ប្រាក់ខែ ឧប នាយក រដ្ឋមន្រ្តី ៨លាន រៀល . ប្រាក់ខែ ទេសរដ្ឋមន្រ្តី ចំនួន ៦លាន រៀល និង រដ្ឋមន្ត្រី មាន ប្រមាណ ៥លាន រៀល ក្នុង ១ខែ ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០
១៖ រាជ រដ្ឋាភិបាល តែងតាំង សមាសភាព គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ( ចុច អាន )
៣៖ ព្រះមហាក្សត្រ កោតសរសើរ សម្តេច តេជោ ហ៊ុន សែន និង រដ្ឋសភា ចំពោះ កិច្ចប្រឹងប្រែង ក្នុង កិច្ចការ ជាតិ ( ចុច អាន )
៥៖ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល៖ កាលវិភាគ នៃ ការទៅ ពិនិត្យ ព្រះរាជ សុខភាព របស់ ព្រះមហាក្សត្រ មាន មុន កម្ពុជា រៀបចំ ធ្វើ ច្បាប់ គ្រប់គ្រង ប្រទេស ក្នុង គ្រា មាន អាសន្ន ( ចុច អាន )
៦៖ សេចក្តីព្រាង ច្បាប់ ចំនួន ៣ ពាក់ព័ន្ធ នឹង វិស័យ អគ្គិសនី បាន ឆ្លង ផុត ព្រឹទ្ធសភា ( ចុច អាន )
៧៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ ការធានា ទូទាត់ របស់ រដ្ឋ ឱ្យ ក្រុមហ៊ុន រ៉ូយ៉ាល់ គ្រុប សម្រាប់ គម្រោង សង់ រោងចក្រ អគ្គិសនី ដុត ធ្យូងថ្ម ៧០០ មេហ្គាវ៉ាត់ នៅ ខេត្ត កោះកុង បាន ឆ្លង ផុត ព្រឹទ្ធសភា ហើយ ( ចុច អាន )
៨៖ រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល ថ្លែងអំណរគុណ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន បរិច្ចាគ ប្រាក់ បៀវត្សរ៍ ៧ខែ ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ( ចុច អាន )
១៧៖ លោក ដូណាល់ ត្រាំ ទម្លាយ ផែនការសម្ងាត់ អ៉ីរ៉ង់ ដែល ចង់ វាយប្រហារ អាមេរិក ជាថ្មី និង ព្រមាន អ៉ីរ៉ង់ កុំ ធ្វើ រឿង នេះ ឲ្យ សោះ ! ( ចុច អាន )
JICA ចុះ កិច្ចព្រមព្រៀង ផ្តល់ ប្រាក់ កម្ចី ៥០ លាន ដុល្លារ ដល់ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ហត្ថា កសិករ លីមីតធីត
( ភ្នំពេញ ) ៖ ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ ជប៉ុន (JICA) បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ផ្តល់ ប្រាក់ កម្ចី ៥០ លាន ដុល្លារ អាមេរិក ដល់ ហត្ថា កសិករ លីមីតធីត ដែល ជា គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ទទួល ប្រាក់ បញ្ញើ សន្សំ ឈាន មុខ គេ មួយ នៅក្នុង ប្រទេស កម្ពុជា ដើម្បី ផ្តល់ មូលនិធិ គាំទ្រ ដល់ សហគ្រាស ខ្នាត តូច បំផុត ខ្នាត តូច និង មធ្យម នៅ តាម បណ្តា តំបន់ នានា ក្នុង ប្រទេស ។
កិច្ចព្រមព្រៀង ផ្តល់ ប្រាក់ កម្ចី នេះ គឺ បាន បង្ហាញ ពី ទំនុកចិត្ត ខ្ពស់ និង ភាពជឿជាក់ មក លើ ភាពរឹងមាំ របស់ ហត្ថា កសិករ លីមីតធីត ក្នុង ការរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការផ្តល់ ប្រាក់ កម្ចី ដល់ សហគ្រាស ខ្នាត តូច បំផុត ខ្នាត តូច និង មធ្យម នៅ តាម ទី ជនបទ ឲ្យ កាន់តែ មាន ភាព ទូលំទូលាយ ជាង មុន ។
តាម ការចុះផ្សាយ របស់ JICA ប្រាក់ កម្ចី នេះ ត្រូវបាន បង្កើតឡើង ក្នុង គោលបំណង ជួយ គាំទ្រ ដល់ សហគ្រាស ខ្នាត តូច បំផុត ខ្នាត តូច និង មធ្យម ឲ្យ កាន់តែ រីកចម្រើន បង្កើត ឱកាស ការងារ ធ្វើឲ្យ ប្រសើរឡើង នូវ បរិយាប័ន ហិរញ្ញវត្ថុ សម្រាប់ សហគ្រាស ខ្នាត តូច បំផុត ខ្នាត តូច និង មធ្យម នៅ តាម បណ្តា តំបន់ ជនបទ ព្រមទាំង កាត់បន្ថយ ភាពក្រីក្រ និង ភាពខុសគ្នា នៃ កំរិត ជីវភាព ក្នុង តំបន់ នានា នៃ ប្រទេស កម្ពុជា ។
អ្វី ដែល សំខាន់ បំផុត នោះ ការរីកចម្រើន របស់ សហគ្រាស ខ្នាត តូច បំផុត ខ្នាត តូច និង មធ្យម គឺជា ផ្នែក មួយ ដ៏ សំខាន់ ក្នុង ការលើកកម្ពស់ ស្រ្តី ។ ដូច្នេះ ប្រាក់ កម្ចី នេះ មិន ត្រឹមតែ ជួយ ដល់ កំណើន សេដ្ឋកិច្ច ប្រកបដោយ ចីរភាព ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ ជួយ ដល់ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ចំនុច ទី ៨ ៩ និង ១៧ ផងដែរ ។
ក្រសួង សុខាភិបាល ម៉ាឡេស៊ី បាន ឲ្យដឹង ថា អ្នកជំងឺ ចំនួន ០៥ នាក់ ទៀត បាន បាត់បង់ជីវិត នៅក្នុង ថ្ងៃព្រហស្បតិ៍ នេះ ដែល ជា ហេតុ នាំឲ្យ ចំនួន ករណី ស្លាប់ កើនឡើង ដល់ ៥០ នាក់ ដូច ខាងលើ ។ ដោយឡែក អ្នកជំងឺ ចំនួន ១២២ នាក់ ទៀត ក៏ បាន ជាសះស្បើយ វិញ ផងដែរ នាំឲ្យ ចំនួន អ្នក ជាសះស្បើយ សរុប កើនឡើង ដល់ ៧៦៧ នាក់ គិត ត្រឹម ល្ងាច ថ្ងៃព្រហស្បតិ៍ នេះ ។
គួរ បញ្ជាក់ តាម អង្គការ សុខភាព ពិភពលោក (WHO) បាន ប្រកាស កាលពី ពេល ថ្មី ៗ ថា អត្រា ឆ្លង ជំងឺ COVID-19 នៅក្នុង ប្រទេស ម៉ាឡេស៊ី អាចនឹង ឈានដល់ កម្រិត កំពូល នៅ ពាក់កណ្តាល ខែមេសា នេះ ហើយ វា នឹង ថមថយចុះ មកវិញ ប៉ុន្តែ WHO ក៏ បាន ព្រមាន ផងដែរ ថា ប្រសិនបើ ខ្វះ ការប្រុងប្រយ័ត្ន នោះ ការផ្ទុះ ជំងឺ នេះ នឹង កើន ឡើងវិញ ៕ ប្រធាន ក្រុមប្រឹក្សា និង អភិបាល ខេត្ត កណ្តាល ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ៧ ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ម៉ៅ ភិរុណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កណ្តាល និង លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្តាល នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា នៅ ថ្ងៃ ម្សិលមិញ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រេចបាន បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ។ ទេសរដ្ឋមន្ត្រី គន់ គីម ណែនាំ មន្ត្រី និង អាជ្ញាធរ បន្ត ចុះ ដល់ ខ្នង ផ្ទះ ពលរដ្ឋ ជួប ការលំបាក ក្នុង ជីវភាព
( ឧត្តរមានជ័យ )៖ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត ឧត្តរមានជ័យ នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ មន្ត្រី និង អាជ្ញាធរ ពាក់ព័ន្ធ ក្នុង ខេត្ត ឧត្តរមានជ័យ ដើម្បី ស្រាវជ្រាវ រក ប្រជាពលរដ្ឋ មាន ជីវភាព ខ្វះខាត នៅ តាម បណ្តា ស្រុក ទាំង៥ និង រិះរក នូវ វិធានការ ដោះស្រាយ បញ្ហា ប្រឈម នានា ។
ក្នុង កិច្ចប្រជុំ នេះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ណែនាំ ថ្នាក់ដឹកនាំ មន្ត្រី អាជ្ញាធរ កងកម្លាំងប្រដាប់អាវុធ និង ក្រុមការងារ ចុះ ជួយ ខេត្ត ត្រូវ បន្ត យកចិត្តទុកដាក់ ចំពោះ ទុក្ខលំបាក របស់ ប្រជាពលរដ្ឋ ហើយ ត្រូវតែ ប្រឹងប្រែង គ្រប់ លទ្ធភាព ដើម្បី ដោះស្រាយ បញ្ហា លំបាក កំពុង កើតមាន និង ប្រឈម ទៅ ថ្ងៃ ខាងមុខ ។
ក្រោយ ទទួលបាន ការណែនាំ រួច មក ថ្នាក់ ស្រុក ឃុំ និង ភូមិ បាន ចុះ ទៅ ព្រម ៗ គ្នា ដល់ ខ្នង ផ្ទះ ប្រជាពលរដ្ឋ រងគ្រោះ និង បាន ពិនិត្យ ជាក់ស្តែង ផ្ទះ សំបែង នៅ ទីតាំង រងគ្រោះ ដោយ ខ្យស់ កន្ត្រាក់ ភ្យុះ ភ្លៀង ដែល រង ការខូត ខាត ។
លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ក៏ បាន ថ្លែងអំណរគុណ ដល់ អង្គការ ការីតា ស កម្ពុជា ដែល បាន ចូលរួមចំណែក ឧបត្ថម នូវ សាប៊ូ លាង ដៃ ចំនួន ៥.០០០ ដុំ និង ប័ណ្ណ ផ្សព្វផ្សាយ ស្តីពី ការការពារ ពី ជំងឺ ឆ្លង កូវីត - ១៩ ចំនួន ១.៦០០ សន្លឹក សម្រាប់ ប្រើប្រាស់ និង ចែកជូន បងប្អូន ប្រជាពលរដ្ឋ មាន ការខ្វះខាត ក្នុង ខេត្ត ឧត្តរមានជ័យ ៕
អភិបាល ខណ្ឌ ដូនពេញ ចុះ សុខ ទុក្ខ និង ផ្សព្វផ្សាយ វិធានការ បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល ជំងឺ COVID-19 ដល់ ពលរដ្ឋ នៅ សហគមន៍ ក្រីក្រ ក្នុង សង្កាត់ ផ្សារ ថ្មី ទី៣
ក្នុង ពិធី សួរសុខទុក្ខ និង សំណេះសំណាល នេះ លោក សុខ ពេញវុធ បាន ផ្ដាំផ្ញើ ទៅ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ សូម ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្រសួង សុខាភិបាល និង អាជ្ញាធរ មូលដ្ឋាន អំពី ការថែរក្សា សុខភាព ផ្ទាល់ខ្លួន និង ក្រុមគ្រួសារ របស់ បងប្អូន ដើម្បី បង្ការ ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ ដ៏ កាច សាហាវ COVID-19 ។
ស្រប នឹង កិច្ច សួរសុខទុក្ខ និង សំណេះសំណាល លោក អភិបាល ក៏ បាន ចែកជូន នូវ អង្ករ ចំនួន ១០គីឡូក្រាម ក្នុង មួយ គ្រួសារ និង មី យើង ០១កេស ព្រមទាំង សាប៊ូ លាង ដៃ ០៤ ដុំ តូច ផងដែរ ៕
ទីភ្នាក់ងារ គ្រប់គ្រង ពេល គ្រា មាន អាសន្ន របស់ សហរដ្ឋ អាមេរិក បាន ស្នើសុំ ថង់ វេចខ្ចប់ សាកសព ចំនួន ១០០.០០០ ថង់ ពី មន្ទីរ បញ្ចកោណ ដើម្បី ត្រៀម សម្រាប់ រុំ សាកសព អ្នក ដែល បាត់បង់ជីវិត ដោយ ជំងឺ COVID-19 ព្រោះ បើ តាម ការព្យាករណ៍ ទុក របស់ ក្រុម អ្នកជំនាញ ផ្នែក ជំងឺ ឆ្លង បាន ឲ្យដឹង ថា នា ប៉ុន្មាន សប្តាហ៍ ខាងមុខ អត្រា អ្នកស្លាប់ ដោយសារ ជំងឺ ដ៏ កាច សាហាវ នេះ នឹង កើនឡើង ទ្វេ ដង ។
គួរ ជម្រាប ថា ថង់ រុំ សាកសព បែប យោធា នេះ ជាធម្មតា ត្រូវបាន គេ ប្រើប្រាស់ និង ចែកចាយ ទៅកាន់ តំបន់ ដែល មាន សង្រ្គាម ប៉ុណ្ណោះ ។ បើ តាម មន្ត្រី ជាន់ ខ្ពស់ នៃ រដ្ឋាភិបាល អាមេរិក បាន ប៉ាន់ប្រមាណ ថា យ៉ាងហោចណាស់ ប្រជាជន អាមេរិក ពី ១០០.០០០ ទៅ ២០០.០០០ នាក់ ឯណោះ នឹង ត្រូវ ស្លាប់ ដោយសារ ជំងឺ នេះ ខណៈ ចំនួន អ្នក ឆ្លង អាច កើន ដល់ ១លាន ករណី នៅ ទូទាំង ប្រទេស ។ រហូតមក ទល់នឹង ពេលនេះ ប្រទេស មហា អំណាច មួយ នេះ បាន កត់ត្រា ចំនួន អ្នក ឆ្លង សរុប ជាង ២១៥.០០០ ករណី ហើយ ក្នុង នោះ ៥. ១១២ នាក់ ស្លាប់ បាត់បង់ជីវិត ៕
ធនាគារ អេស៊ីលីដា បរិច្ចាគ ថវិកា ៣០០០ លាន រៀល ដើម្បី រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង សកម្មភាព មនុស្សធម៌ និង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ ធនាគារ អេស៊ីលីដា ភី អិល ស៊ី នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល សម្រាប់ គោលដៅ មនុស្សធម៌ នៅក្នុង ពេល តែ មួយ ដោយ បរិច្ចាគ ថវិកា សរុប ចំនួន ៣០០០ លាន រៀល ( ប្រហែល ៧៥ ម៉ឺន ដុល្លារ ) សម្រាប់ ចូលរួម ក្នុង កិច្ចការ សង្គម និង មនុស្សធម៌ ។
បរិច្ចាគ ថវិកា សរុប ចំនួន ៣០០០ លាន រៀល សម្រាប់ ចូលរួម ក្នុង កិច្ចការ សង្គម និង មនុស្សធម៌ ដូច ខាងក្រោម៖
១៖ ថវិកា ចំនួន ៨០០ លាន រៀល សម្រាប់ ចូលរួមចំណែក ដោយ ផ្ទាល់ ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
២៖ ថវិកា ចំនួន ២០០ លាន រៀល តាមរយៈ សមាគម ធនាគារ នៅ កម្ពុជា សម្រាប់ ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
៣៖ ថវិកា ចំនួន ១២០០ លាន រៀល ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដើម្បី ទ្រទ្រង់ ដល់ វិភាគទាន សប្បុរសធម៌ នៅ កម្ពុជា ។ ៤៖ ថវិកា ចំនួន ៨០០ លាន រៀល ជូន កាកបាទ ក្រហម កម្ពុជា ដើម្បី ទ្រទ្រង់ សកម្មភាព មនុស្សធម៌ និង ជួយ ទ្រទ្រង់ ដល់ សកម្មភាព កាកបាទ ក្រហម កម្ពុជា ។
នៅ ចំពោះមុខ សមត្ថកិច្ច បុគ្គល « អគ្គីនេត្រ » បាន សារភាព និង យល់ព្រម ទទួល កំហុស ដែល ខ្លួន បាន ចុះផ្សាយ ព័ត៌មាន មិន ពិត នេះ ដែល ធ្វើឲ្យ មហាជន មាន ការយល់ ច្រឡំ ។
ជាមួយគ្នា នេះ ដែរ បុគ្គល រូប នេះ ក៏ បាន ធ្វើ កិច្ចសន្យា បញ្ឈប់ រាល់ សកម្មភាព ទាំងនេះ ជាមួយនឹង ការថត វីដេអូ ដើម្បី ធ្វើ ការសុំទោស ជាសាធារណៈ ផងដែរ ។ ក្រោយពី ធ្វើ កិច្ចសន្យា ណែនាំ អប់រំ និង ថត វីដេអូ សុំទោស រួច សមត្ថកិច្ច អនុញ្ញាតឱ្យ គាត់ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
សូម បញ្ជាក់ ថា បុគ្គល រូប នេះ កាលពី ទី៣០ ខែឧសភា ឆ្នាំ ២០១៨ តុលាការ បាន ប្រកាស សាលក្រម សម្រេច ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ កំណត់ រយៈពេល ៣ ឆ្នាំ និង ពិន័យ ជា ប្រាក់ ចំនួន ៤លាន រៀល ចូល ជា ថវិកា រដ្ឋ ពាក់ព័ន្ធ គ្រឿងញៀន ៕ អាជ្ញាធរ ខេត្ត កំពង់ចាម នាំយក អំណោយ ប្រគល់ជូន សាលា សង្កាត់ ចំនួន ៤ ទុក ចែកជូន ពលរដ្ឋ ខ្វះខាត ដល់ ខ្នង ផ្ទះ ជាង ៥០០ គ្រួសារ
( កំពង់ចាម ) ៖ ប្រធាន គណៈកម្មការ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា អម ដំណើរ ដោយ អភិបាល រង ខេត្ត កំពង់ចាម ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ជុំវិញ ខេត្ត និង អាជ្ញាធរ ក្រុង កំពង់ចាម នា ព្រឹក ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ផ្ដល់ អំណាយ ជូន សាលា សង្កាត់ ចំនួន ៤ ក្នុង ក្រុង កំពង់ចាម សម្រាប់ ចែក នាំយក ជូន បន្ត ដល់ ប្រជាពលរដ្ឋ ប្រមាណ ជា ៥៦៦ គ្រួសារ ដែល កំពុង ជួប ការខ្វះខាត ក្នុង កំឡុង ពេល កើតមាន ជំងឺ Covid-19 នេះ ដល់ ខ្នង ផ្ទះ របស់ ពលរដ្ឋ ។
សូម បញ្ជាក់ ថា អំណោយ ដែល បាន ប្រគល់ជូន សាលា សង្កាត់ ចំនួន ៤ ក្នុង ក្រុង កំពង់ចាម មាន ទី១៖ សង្កាត់ សំបួរ មាស មាន ចំនួន ១៨១ គ្រួសារ . ទី ២៖ សង្កាត់ វាលវង់ មាន ចំនួន ១៦២ គ្រួសារ . ទី ៣៖ សង្កាត់ កំពង់ចាម មាន ចំនួន ១០២ គ្រួសារ និង ទី៤៖ សង្កាត់ បឹង កុក មាន ចំនួន ១២១ គ្រួសារ ។ ដោយ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ចំនួន ២៥ គីឡូក្រាម ត្រីខ ១២ កំប៉ុង ក្រម៉ា០១ និង សាប៊ូ លាង ដៃ ០១ដប ៕ នាយ ឧត្តមសេនីយ៍ សួស អង្គារ៍ បរិច្ចាគ ប្រាក់ បៀវត្ស ៦ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សួស អង្គារ៍ អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ជា រដ្ឋលេខាធិការ របស់ ខ្លួន ចំនួន ៦ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ដោះស្រាយ ការលំបាក ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ បៀវត្ស របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ។
នៅ ថ្ងៃទី ០២ ខែមេសា ឆ្នាំ ២០២០ នេះ គេ បាន សង្កេតឃើញ មន្ត្រី ជាន់ ខ្ពស់ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ជាច្រើន រូប បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស ប្រចាំ ខែ របស់ ខ្លួន ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នេះ ផងដែរ ដើម្បី ដោះស្រាយ ការលំបាក របស់ ជាតិ ក្នុង ពេល រង ការរាតត្បាត ដោយ ជំងឺ កូវីដ១៩ ៕
គួរ បញ្ជាក់ ថា មក ទល់នឹង ពេលនេះ កូរ៉េ ខាងជើង មិន បាន ទទួលស្គាល់ ពី ករណី ឆ្លង COVID-19 ណាមួយ នោះ ទេ សូម្បី មួយ ករណី បើ ទោះជា ប្រព័ន្ធ ផ្សព្វផ្សាយ កូរ៉េ ខាងត្បូង រាយការណ៍ ជា បន្តបន្ទាប់ ថា មនុស្ស រាប់ រយ នាក់ បាន បាត់បង់ជីវិត ដោយសារ ជំងឺ រាតត្បាត សកល មួយ នេះ ក៏ដោយ ៕
លោក រស់ វណ្ណា បរិច្ចាគ ប្រាក់ បៀវត្ស៦ ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក រស់ វណ្ណា ទីប្រឹក្សា សម្តេច អគ្គ មហា សេនាបតី តេជោ ហ៊ុន សែន និង ជា រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ជា រដ្ឋលេខាធិការ របស់ ខ្លួន ចំនួន ៦ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ដោះស្រាយ ការលំបាក ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
យោង តាម តារាង ប្រាក់ បៀវត្ស របស់ មន្ត្រីរាជការ បាន បង្ហាញ មន្ត្រីរាជការ ក្នុង តំណែង ជា រដ្ឋលេខាធិការ ទទួលបាន ប្រាក់ បៀវត្ស ប្រមាណ ៣.៥០០.០០០ រៀល ក្នុង មួយ ខែ ។
ទេសរដ្ឋមន្រ្តី ចម ប្រសិទ្ធ ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ដែល រក ទិញ ផលិតផល ឬ សារធាតុ សម្លាប់ មេរោគ សូម ពិនិត្យមើល ផលិតផល ដែល មាន ប្រភព ច្បាស់លាស់ ។ ប៉ុន្តែ ទោះ យ៉ាងណា សមត្ថកិច្ច កម្ពុជា ក៏ កំពុង មាន វិធានការ ជា បន្តបន្ទាប់ ចំពោះ ផលិតផល គ្មាន គុណភាព និង ក្លែងក្លាយ ផងដែរ ។
លោកស្រី បាន បញ្ជាក់ ថា ផលិតផល សម្លាប់ មេរោគ ដែល មាន ជាតិ អាល់កុល ខ្ពស់ អាចនឹង បង្កឲ្យ មាន ការឆាបឆេះ និង រលាក លើ ខ្លួនប្រាណ បាន ។ ចំពោះ ផលិតផល ម៉ាក OKA របស់ ក្រុមហ៊ុន លោកស្រី ធានា បាន នូវ ការរលាក ឬ ការឆាបឆេះ ជា យថាហេតុ ។ ប៉ុន្តែ មាន សមត្ថភាព សម្លាប់ មេរោគ ប្រកបដោយ ប្រសិទ្ធិភាព ខ្ពស់ ។ លោកស្រី បាន សង្កត់ ធ្អន់ ថា ដរាបណា នៅ មាន វត្ថុធាតុ ដើម ជា អាល់កុល ដែល ក្រុមហ៊ុន អាច ទិញ បាន ក្រុមហ៊ុន នៅតែ បន្ត ផលិត ដើម្បី ចែកចាយ លើ ទីផ្សារ និង ផ្តល់ ជា ជំនួយ ជា បន្តបន្ទាប់ ទៀត ។
