សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បាន ថ្លែង ចាត់ទុក ថា ពេលនេះ ម៉ាស់ ប្រៀប ដូចជា គ្រាប់ កាំភ្លើង ដែល ត្រូវ បម្រុងទុក ដើម្បី ការពារ ខ្លួន ហើយ សម្តេច បាន បញ្ជាក់ ថា ថវិកា ទិញ ម៉ាស និង អាវ ផ្គត់ផ្គង់ ដល់ គ្រូពេទ្យ គឺជា ថវិកា របស់ សប្បុរស ដែល ចូលរួម បរិច្ចាគ ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
១៖ ទីបំផុត ! រដ្ឋសភា បោះឆ្នោត ផ្តល់ សេចក្តីទុកចិត្ត ទាំងស្រុង លើ ការតែងតាំង និង កែសម្រួល សមាសភាព រាជ រដ្ឋាភិបាល ដែល មាន ទេសរដ្ឋមន្រ្តី និង រដ្ឋមន្រ្តី ៩រូប ( ចុច អាន )
២៖ ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង ទេសរដ្ឋមន្ដ្រី និង រដ្ឋមន្ដ្រី ក្រោយ រដ្ឋសភា បាន បោះឆ្នោត ផ្ដល់ សេចក្ដីទុកចិត្ត ( ចុច អាន )
៤៖ សម្តេច តេជោ ហ៊ុន សែន បែងចែក ភារកិច្ច ជូន ទេសរដ្ឋមន្រ្តី ថ្មី ៤រូប ( ចុច អាន )
៥៖ រាជ រដ្ឋាភិបាល រៀបចំ សេចក្តីព្រាង ច្បាប់ គ្រប់គ្រង ប្រទេស ក្នុង គ្រា មាន អាសន្ន ស្រប ពេល ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ( ចុច អាន )
៧៖ សម្តេច តេជោ ហ៊ុន សែន បញ្ជា ឲ្យ ផ្អាក ការនាំចេញ អង្ករ ស និង ស្រូវ ដើម្បី ធានា សន្តិសុខ ស្បៀង ក្នុង ស្រុក ចាប់ អនុវត្តន៍ ពី ថ្ងៃទី៥ ខែមេសា ឆ្នាំ ២០២០ រហូត មាន បទបញ្ជាថ្មី ( ចុច អាន )
៨៖ សម្តេច តេជោ ហ៊ុន សែន ប្រកាស បិទ កាស៊ីណូ ទាំងអស់ នៅ ទូទាំង ប្រទេស ចាប់ពី ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២០ ជា បណ្ដោះអាសន្ន ( ចុច អាន )
៩៖ សម្តេច តេជោ ហ៊ុន សែន៖ រដ្ឋ កំពុង ពិនិត្យ ក្នុង ការបញ្ចេញ ថវិកា ៥០០ ទៅ ៦០០ លាន ដុល្លារ ដើម្បីឲ្យ ធនាគារ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ខ្ចី ដោយ អត្រា ការប្រាក់ ទាប ( ចុច អាន )
១០៖ នាយក រដ្ឋមន្ត្រី កម្ពុជា បញ្ជាទិញ ម៉ាស ៣លាន ពី ក្រៅ ប្រទេស និង អាវ ពេទ្យ ៥ពាន់ កំប្លេ ( ចុច អាន )
១១៖ សម្តេច តេជោ ហ៊ុន សែន៖ ការផ្លាស់ប្តូរ រដ្ឋមន្រ្តី ក្រសួង ៤ ពេលនេះ ដោយសារ ក្រសួង ត្រូវការ រដ្ឋមន្ត្រី សកម្ម ( ចុច អាន )
១៣៖ កម្ពុជា រកឃើញ អ្នក ប៉ះពាល់ ផ្ទាល់ ជាមួយ អ្នក ផ្ទុក កូវីដ១៩ ចំនួន ៣៥៣ នាក់ ខណៈ អ្នក ប៉ះពាល់ ប្រយោល ១៣៥៩ នាក់ ( ចុច អាន )
១៥៖ ក្រសួង សុខាភិបាល រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ថ្មី ចំនួន ៤ទៀត ខណៈ អ្នក ជាសះស្បើយ សរុប កើន ដល់ ២៣នាក់ និង កំពុង សម្រាក ព្យាបាល ៨៤ នាក់ នៃ អ្នក ឆ្លង សរុប ១០៧ នាក់ ( ចុច អាន )
៣៖ កូរ៉េ ខាងជើង ប្រកាស ជោគជ័យ ថ្មី ទៀត ហើយ លើ ការធ្វើតេស្ត ជើង ទម្របាញ់ រ៉ុក្កែត ខ្នាត ធំ ( ចុច អាន )
គណបក្ស យុវជន កម្ពុជា ក៏ បាន អំពាវនាវ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវតែ មាន ការ អនាម័យ ជានិច្ច ដូចជា ការលាង ដៃ ជាមួយ អាល់កុល ឬ សាប៊ូ ឲ្យ បាន ញឹកញាប់ ជានិច្ច និង កាត់បន្ថយ ការជួបជុំគ្នា នៅ ខាងក្រៅ ក្នុង ករណី ណាមួយ ដែល មិន ចាំបាច់ ។
