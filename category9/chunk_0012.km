( ភ្នំពេញ ) ៖ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ចេញ សេចក្តីណែនាំ ស្តីពី ការអនុវត្ត វិធានការ បង្ការ និង ទប់ស្កាត់ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ នៅ តាម មណ្ឌល ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ និង ក្រុមហ៊ុន ដឹកជញ្ជូន អ្នកដំណើរ ទាំងអស់ ក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង គោលបំណង អនុវត្ត នូវ វិធានការ បង្ការ និង ទប់ស្កាត់ ហានិភ័យ ពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
នៅក្នុង សេចក្តីណែនាំ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ដែល Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ឱ្យដឹង ថា ក្នុង គោលបំណង អនុវត្ត នូវ វិធានការ បង្ការ និង ទប់ស្កាត់ ហានិភ័យ ពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ នេះ អគ្គ នាយកដ្ឋាន ដឹកជញ្ជូន ផ្លូវគោក សូម ធ្វើ ការណែនាំ ដល់ លោកស្រី នាយិកា ក្រុមហ៊ុន ខេបូឌា ម៉ូធ័រ វីហ៊ីឃល អ៊ិន ស្ពេក សិន ខម ភេនី និង លោក នាយក ក្រុមហ៊ុន អេច ខេ ខា អ៊ិន ស្ពេក សិន សូម ចូម រួម អនុវត្តន៍ នូវ វិធានការ ដូច ខាងក្រោម៖
* ទី១៖ រៀបចំ ឱ្យ មាន សាប៊ូ ឬ ទឹក អាកុល លាង ដៃ នៅ ច្រក ចេញ ចូល មណ្ឌល ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ សម្រាប់ ឲ្យ បុគ្គលិក ឬ អតិថិជន លាង សម្អាត ដៃ មុនពេល ចូលក្នុង មណ្ឌល ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ ។
* ទី២៖ រៀបចំ បម្រុងទុក ម៉ាស់ និង ស្រោម ដៃ ការពារ ឱ្យ បាន គ្រប់គ្រាន់ សម្រាប់ ផ្ដល់ជូន បុគ្គលិក ក្រុមហ៊ុន នៅក្នុង មណ្ឌល ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ
* ទី៣៖ រៀបចំ ឱ្យ មាន ការវាស់ កំដៅ គ្រប់ បុគ្គលិក ទាំងអស់ មុនពេល ចូលក្នុង មណ្ឌល ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ ជាប្រចាំ ក្នុង មួយ ថ្ងៃ ២ដង គឺ ពេលព្រឹក ១ដង និង ពេល រសៀល ១ ដង ។ ចំពោះ បុគ្គលិក ណា ដែល មាន កំដៅ ខ្លួន លើស ពី ៣៧.២អង្សា ត្រូវ អនុញ្ញាតឲ្យ សម្រាក ពី ការងារ និង តម្រូវ ឱ្យ ទៅ ពិនិត្យ សុខភាព ផ្ទាល់ខ្លួន ដោយ ការទទួលខុសត្រូវ ខ្ពស់ ។
ទី៤៖ ណែនាំ ដល់ បុគ្គលិក ទាំងអស់ ត្រូវ រក្សា អនាម័យ និង បង្កើន ភាពប្រុងប្រយ័ត្ន គ្រប់ ពេលវេលា ដោយ គម្លាត សុវត្ថិភាព យ៉ាងតិច ១.៥ម៉ែត្រ ពី គ្នា ក្នុង ពេល ធ្វើ ទំនាក់ទំនង ការងារ ជាមួយ អតិថិជន ឬ សហការី ។
* ទី ៥៖ ត្រូវ រំលឹក បុគ្គលិក នៅពេល ក្អក កណ្ដាស់ ត្រូវ ខ្ទប់ មាត់ ច្រមុះ ដោយ ប្រើ ក្រដាស អនាម័យ រួច បោះចោល ទៅក្នុង ធុង សំរាម ឱ្យ បាន ត្រឹមត្រូវ បន្ទាប់មក ត្រូវ លាង ដៃ សម្អាត ដៃ នឹង សាប៊ូ ឬ ទឹក អាកុល ។
* ទី ៦៖ ត្រូវ ណែនាំ ដល់ បុគ្គលិក ឲ្យ អនុវត្ត ការស្វាគមន៍ គ្នា ដោយ ការលើក តែ សំពះ តាម ទំនៀមទម្លាប់ ប្រពៃណី ជាតិ ជៀសវាង ការចាប់ ដៃ ។
* ទី ៧៖ ណែនាំ ដល់ បុគ្គលិក រដ្ឋបាល ទទួល ប្រគល់ ឯកសារ ត្រូវ ពាក់ ម៉ាស់ និង ស្រោម ដៃ ការពារ ពេល ប៉ះពាល់ ឯកសារ ហើយ ត្រូវ លាង សម្អាត ដៃ នឹង សាប៊ូ ឬ ទឹក អាកុល មុននឹង ក្រោយ ទទួល ប្រគល់ ឯកសារ ។
* ទី ៨៖ ណែនាំ ដល់ បុគ្គលិក ឲ្យ ស្នើសុំ ម្ចាស់ យានជំនិះ ទាំងអស់ វាស់ កម្តៅ និង មិន ត្រូវ អង្គុយ នៅ ខាងក្នុង យានជំនិះ ជាមួយ បុគ្គលិក ត្រួតពិនិត្យ ក្នុង អំឡុង ពេល អនុវត្ត ការត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ ដោយ ឲ្យ ម្ចាស់ យានជំនិះ ទាំងនោះ ទៅកាន់ កន្លែង រង់ចាំ និង យក តាម ខ្លួន នូវ វត្ថុ មាន តម្លៃ ដែល ផ្ទុក នៅក្នុង យានជំនិះ ដូចជា គ្រឿងអលង្ការ កាបូប ទូរសព្ទ ។ល ។
* ទី ៩៖ ណែនាំ ដល់ បុគ្គលិក ត្រួតពិនិត្យ ត្រូវ រាប់ ត្រូវ ពាក់ ម៉ាស និង ស្រោម ដៃ ការពារ ពេល បើកបរ រថយន្ត ហើយ ត្រូវ លាង ដៃ សំអាត នឹង សាប៊ូ ឬ ទឹក អាកុល មុន និង ក្រោយ ការត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ ។
* ទី ១០៖ វិធានការ អនាម័យ សម្លាប់ មេរោគ ដោយ ប្រើប្រាស់ សាប៊ូ ឬ ទឹក អាកុល ត្រូវ អនុវត្ត ឲ្យបាន ហ្មត់ចត់ និង ជាប្រចាំ ដោយ ត្រូវ សម្អាត នូវ រាល់ បរិក្ខារ និង ឧបករណ៍ ដែល ប្រើប្រាស់ រួមគ្នា នៅក្នុង មណ្ឌល ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ ៕
ខាងក្រោម នេះ ជា សេចក្តីណែនាំ របស់ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន៖ ព្រឹក ថ្ងៃ នេះ ព្រះមហាក្សត្រ និង សម្តេច ម៉ែ យាង ទៅ ពិនិត្យ ព្យាបាល ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង
( ភ្នំពេញ ) ៖ ព្រះមហាក្សត្រ ខ្មែរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ជាទីគោរព សក្តារៈ ដ៏ ខ្ពង់ខ្ពស់ និង ព្រះមហាក្សត្រី នរោត្តម មុនី នា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ នៅ ថ្ងៃពុធ ទី ០១ ខែមេសា ឆ្នាំ ២០២០ នេះ យាង ទៅ ពិនិត្យ ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន ។ នេះ បើ តាម ព្រះរាជ សារ របស់ ព្រះមហាក្សត្រ នៃ កម្ពុជា ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
នៅក្នុង ឱកាស អវត្តមាន របស់ ទូលព្រះបង្គំ ខ្ញុំ ព្រះករុណា ខ្ញុំ ខាង លើ នេះ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា នឹង ទទួល ជួយ ទូលព្រះបង្គំ ខ្ញុំ ព្រះករុណា ខ្ញុំ ក្នុង ឋានៈ ជា ប្រមុខរដ្ឋ ស្តីទី នៃ ព្រះរាជាណាចក្រ កម្ពុជា »៕
ព្រះរាជ សារ របស់ ព្រះមហាក្សត្រ នៃ កម្ពុជា ដូច ខាងក្រោម៖
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ ប៉ូលិស នៅ ចក្រភព អង់គ្លេស បាន ទទួលរង ការរិះគន់ ថា ពួកគេ មួយចំនួន បាន ប្រើ អំណាច ជ្រុល ហួសហេតុ កំឡុង ការអនុវត្ត វិធានការបិទ ប្រទេស ដែល ត្រូវបាន ដាក់ចេញ ដើម្បី កាត់បន្ថយ ការឆ្លង រាលដាល នៃ ជំងឺ COVID-19 ។
៣៖ រដ្ឋាភិបាល វៀតណាម បាន សម្រេច ដាក់ចេញ នូវ វិធានការ « រក្សា គម្លាត សង្គម » ដែល ចាប់ពី ថ្ងៃពុធ ស្អែក នេះ តទៅ នោះ គឺ មនុស្សម្នា គួរ ស្នាក់ នៅក្នុង ផ្ទះ ប្រសិនបើ គ្មាន ភាពចាំបាច់ ខ្លាំង ហើយ នៅ តាម ទី សាធារណៈ វិញ គឺ ពុំ អនុញ្ញាតឲ្យ មាន ការជួបជុំគ្នា លើស ពី ០២ នាក់ និង ត្រូវ នៅ ឲ្យ ឆ្ងាយ ពី គ្នា យ៉ាងតិច ០២ ម៉ែត្រ ។
៥៖ ភ្នាក់ងារ ពន្លត់ អគ្គិភ័យ ១៨នាក់ និង អ្នកនាំផ្លូវ ចូល ព្រៃ ម្នាក់ ទៀត បាន បាត់បង់ជីវិត កំឡុង ប្រយុទ្ធ ជាមួយ អណ្ដាត ភ្លើង ឆេះ ព្រៃ ដ៏ សម្បើម មួយ នៅ ភាគ និរតី ប្រទេស ចិន ។
បើ តាម អាជ្ញាធរ សុខាភិបាល ហ្វីលីពីន ចំនួន អ្នកស្លាប់ ដោយសារ COVID-19 ក៏ បាន កើន ដល់ ៨៨ នាក់ ផងដែរ បន្ទាប់ពី អ្នកជំងឺ ១០នាក់ ត្រូវបាន គេ រាយការណ៍ ថា បាន ស្លាប់ ។ ហ្វីលីពីន បាន បើក មន្ទីរពិសោធន៍ ថ្មី ជាច្រើន និង បាន ធ្វើតេស្ដ លើ មនុស្ស ច្រើន ជាង ១៥.០០០ នាក់ បើ ធៀប ទៅនឹង សប្ដាហ៍ មុន មាន តែ ៣.០០០ នាក់ ប៉ុណ្ណោះ ។
ហ្វីលីពីន បាន ដាក់ចេញ នូវ ការអនុវត្ត វិធានការ « ស្នាក់ នៅក្នុង ផ្ទះ ដាច់ដោយឡែក » ទ្រង់ទ្រាយ ធំ នៃ ប្រជាជន របស់ ខ្លួន ១០៧ លាន នាក់ រហូតដល់ ករណី ឆ្លង មាន ភាពធូរស្រាល តាម ការរំពឹងទុក ៕
សារ អប់រំ ក្រសួង សុខាភិបាល៖ បញ្ឈប់ ការរីករាលដាល ជំងឺ កូវីដ១៩ អនុត្ត ការរស់នៅ ឲ្យ ឆ្ងាយ ពី គ្នា ( គម្លាត សង្គម ) ដើម្បី ខ្លួនអ្នក និង គ្រួសារ មាន សុវត្ថិភាព
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ នូវ សារ អប់រំ ថ្មី មួយ ដោយ ជំរុញ ឲ្យ ប្រជាពលរដ្ឋ ចេះ ការពារ ខ្លួន និង អនុវត្ត ការរស់នៅ ឲ្យ ឆ្ងាយ ពី គ្នា ( គម្លាត សង្គម ) ដើម្បី ខ្លួន ឯង និង ក្រុមគ្រួសារ មាន សុវត្ថិភាព បញ្ឈប់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
សារ អប់រំ របស់ ក្រសួង សុខាភិបាល បាន ផ្តល់ ដំបូន្មាន ចំនួន ៦ ចំណុច ដូច ខាងក្រោម៖
១៖ ជៀង វាង ប៉ះពាល់ ជិតស្និទ ជាមួយ អ្នក មាន ជំងឺ ផ្លូវ ដង្ហើម ដូចជា គ្រុន ក្តៅ ក្អក កណ្តាស់ ឬ ផ្តាសាយ ។
២៖ ជៀសវាង ការប្រើប្រាស់ មធ្យោបាយ ដឹកជញ្ជូន សាធារណៈ ដែល មិន ចាំបាច់ ។ ប្តូរ ពេលវេលា ធ្វើដំណើរ ជៀសវាង ម៉ោង មមាញឹក ។
៤៖ ជៀសវាង ការជួបជុំ ក្នុង សង្គម និង កន្លែង ប្រមូលផ្តុំ ដោយ ជា ហាង ស្រា រោង ភាពយន្ត ភោជនីយដ្ឋាន ហាង កាហ្វេ បារ ក្លឹម កម្សាន្ត ។
៥៖ ជៀសវាង ការជួបជុំ មិត្តភក្តិ និង ក្រុមគ្រួសារ ។ រក្សា ទំនាក់ទំនង ដោយ ប្រើ ទូរស័ព្ទ អ៊ីនធើណេត និង ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ។
៦៖ ស្វាគមន៍ ដោយ ការសំពះ ជំនួស ដោយ ការចាប់ ដៃ និង អោប ។ រក្សា ចម្ងាយ យ៉ាងតិច ១.៥ម៉ែត្រ ពី គ្នា ៕
លោក ទេសរដ្ឋមន្ត្រី គន់ គន់ បាន ឱ្យដឹង ថា នៅក្នុង ស្រុក ត្រពាំងប្រាសាទ មាន ប្រជាពលរដ្ឋ ជួប ការខ្វះខាត និង កំពុង ប្រឈម ការលំបាក ព្រោះ បាត់ ចំណូល ពី ឥទ្ធិពល នៃ ជំងឺ កូវីដ១៩ ប្រមាណ ជា ៣. ៥៩១ គ្រួសារ ។
ក្នុង ដំណើរ ទៅកាន់ ស្រុក ត្រពាំងប្រាសាទ ដើម្បី ស្វែងរក ប្រជាពលរដ្ឋ ខ្វះខាត ក្នុង ជីវភាព លោក គន់ គីម និង ក្រុមការងារ បាន ធ្វើដំណើរ ទៅ គ្រប់ ច្រកល្ហក និង តំបន់ ដាច់ស្រយាល ខ្លាំង ។ កន្លែង ខ្លះ ដោយសារ សភាព ផ្លូវ លំបាក នោះ លោក ទេសរដ្ឋមន្ត្រី និង ក្រុមការងារ ជ្រើសយក ការធ្វើដំណើរ តាម ម៉ូតូ ឬ ថ្មើរជើង ក៏ មាន ។
ស្បៀងអាហារ ដែល លោក ទេសរដ្ឋមន្ត្រី បាន នាំយក ទៅ ជូន ប្រជាពលរដ្ឋ នា ពេល នោះ មាន អង្ករ ត្រីខ ទឹក ស៊ីវ និង ទឹកត្រី ជាដើម ។ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ថ្លែង ថា ការផ្តល់ ស្បៀងអាហារ ជូន ប្រជាពលរដ្ឋ ខ្វះខាត នឹង ធ្វើឡើង ជា បន្តបន្ទាប់ ទៀត ពោល រហូតដល់ ស្ថានភាព សេដ្ឋកិច្ច របស់ កម្ពុជា វិលត្រឡប់មក រក ភាព ប្រក្រតី វិញ នៅពេល វិបត្តិ នៃ ជំងឺ កូវីដ១៩ បិទ បញ្ចប់ ។
ក្នុង ដំណើរ ចុះ តាម ខ្នង ផ្ទះ របស់ ប្រជាពលរដ្ឋ នៅក្នុង ស្រុក ត្រពាំងប្រាសាទ លោក ទេសរដ្ឋមន្ត្រី និង ក្រុមការងារ ក៏ បាន ឆ្លៀង ពន្យល់ អប់រំ ប្រជាពលរដ្ឋ ឱ្យ អនុវត្តន៍ នូវ វិធាន ទាំងឡាយ របស់ ក្រសួង សុខាភិបាល ដើម្បី ការពារ ការឆ្លង និង ចម្លង ជំងឺ កូវីដ១៩ ។
ស្រុក ត្រពាំងប្រាសាទ ក៏ មាន ប្រជាពលរដ្ឋ មួយចំនួន ទើប ត្រឡប់ មកពី ស្រុក ថៃ ផងដែរ ។ ដើម្បី បង្ការ និង បញ្ចៀស ការចម្លង ជំងឺ កូវីដ១៩ ជា យថាហេតុ ណាមួយ នោះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ចាត់ ច្រែង ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត ដើរ វាស់ កម្តៅ អ្នក ទាំងនោះ និង បាន ណែនាំ ឱ្យ ពួកគេ ដាក់ ខ្លួន នៅ ដាច់ដោយឡែក រយៈពេល ១៤ ថ្ងៃ ផងដែរ ។
ក្រុមការងារ ថ្នាក់ ជាតិ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើ សកម្មភាព យ៉ាង សស្រាកសស្រាំ ចុះ ទៅតាម ទីតាំង របស់ ពួកគេ រៀង ៗ ខ្លួន ដើម្បី ផ្តល់ ជំនួយ សង្គ្រោះ ដល់ ប្រជាពលរដ្ឋ ខ្វះខាត ។ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ដែល ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត ឧត្តរមានជ័យ ក៏ បាន ធ្វើដំណើរ ចុះ ទៅ ក្រុម ច្រក ល្អក ផងដែរ ។
បន្ទាប់ពី ការចុះ ជួបប្រជាពលរដ្ឋ ដោយ ផ្ទាល់ តាម ខ្នង ផ្ទះ នេះ លោក ទេសរដ្ឋមន្ត្រី គន់ គីម មិន ត្រឹមតែ ផ្តល់ ជា អំណោយ សង្គ្រោះ និង ដោះស្រាយ ក្នុង ជីវភាព នោះ ទេ លោក ក៏ កំពុង រិះរក នូវ វិធី ដើម្បី ស្តារ និង ដោះស្រាយ បញ្ហា ប្រឈម ក្នុង ជីវភាព របស់ ពួកគេ តាមរយៈ ការលើកកម្ពស់ ជីវភាព ឡើងវិញ ផងដែរ ។
បើ តាម លោក ទេសរដ្ឋមន្ត្រី គន់ គីម ការដាំដុះ បន្លែ និង ចិញ្ចឹម សត្វ គឺជា ដំណោះស្រាយ មួយ ដែល អាច ជួយ លើកកម្ពស់ ជីវភាព របស់ ប្រជាពលរដ្ឋ នៅ តំបន់ ដាច់ស្រយាល ។ លោក បាន អះអាង ថា ការដាំដុះ បន្លែ និង ចិញ្ចឹម សត្វ វា មិន ត្រឹមតែ ជួយ ជីវភាព ពលរដ្ឋ ត្រឹម ក្នុង ពេល ជួប វិបត្តិ ដោយសារ ជំងឺ កូវីដ១៩ ទេ តែ អាច ជួយ ទ្រទ្រង ជីវភាព របស់ ប្រជាពលរដ្ឋ រយៈពេល វែង ផងដែរ ។
លោក ទេសរដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ ថា លោក បាន រៀបចំ ចាត់ចែង ក្រុមការងារ ធ្វើការ ជាមួយ មន្ត្រី មន្ទីរ កសិកម្ម ខេត្ត រកក អ្នក បច្ចេកទេស ផ្តល់ ជា បច្ចេកទេស ផ្តល់ ជា គំនិត នានា គាំទ្រ និង លើកកម្ពស់ ការដាំដុះ និង ចិញ្ចឹម សត្វ របស់ ប្រជាពលរដ្ឋ នៅលើ ទឹកដី ជាយ ដែន មួយ នេះ ៕
វិធានការ ថ្មី ដែល រដ្ឋាភិបាល ចក្រភព អង់គ្លេស បាន ដាក់ចេញ កាលពី សប្តាហ៍ មុន បាន ផ្តល់ សិទ្ធិ ឲ្យ ប៉ូលិស ធ្វើការ ផាកពិន័យ ជា ប្រាក់ ភ្លាម ៗ ចំពោះ អ្នក ដែល នៅ ប្រមូលផ្តុំ គ្នា ជា ក្រុម លើស ពី ០២ នាក់ ឬ ចាកចេញ ពី ផ្ទះ ដោយ ពុំ មាន ហេតុផល សមរម្យ ដូចជា ត្រូវ ទៅ បំពេញ ការងារ ឬ ទៅ ទិញ ស្បៀងអាហារ ជាដើម ។
ប៉ុន្តែ មន្រ្តី ប៉ូលិស មួយចំនួន រង ការចោទប្រកាន់ ថា បាន ប្រើ អំណាច ជ្រុល ហួសហេតុ តាមរយៈ ការប្រើប្រាស់ ដ្រូន ឃ្លាំមើល សាធារណជន ការដាក់ ប៉ុស្តិ៍ ត្រួតពិនិត្យ យានជំនិះ របស់ អ្នកធ្វើដំណើរ និង ការហាម មិន ហាង មួយចំនួន លក់ ទំនិញ ក៏ ដូចជា រារាំង មនុស្ស មួយចំនួន ឲ្យ ទៅ ទិញ ឥវ៉ាន់ ជាដើម ។
យ៉ាងណាមិញ បើ តាម ការបកស្រាយ ពី ខាង ប៉ូលិស ចក្រភព អង់គ្លេស ពួកគេ កំពុង ព្យាយាម ធានា ឲ្យបាន នូវ ការធ្វើ សកម្មភាព ដែល សមរម្យ ពាក់ព័ន្ធ នឹង វិធានការ ថ្មី នេះ ។ ចំណែកឯ រដ្ឋាភិបាល ចក្រភព អង់គ្លេស ក៏ បាន ទទូច ឲ្យ ប្រជាជន ទាំងអស់ ចូលរួមគ្នា ជួយ ផងដែរ តាមរយៈ ការស្ថិត នៅក្នុង ផ្ទះ នៅ ចំពោះមុខ ការឆ្លង រាលដាល នៃ ជំងឺ COVID-19 ដោយ សង្កត់ធ្ងន់ ថា បើ គ្រប់ គ្នា សុទ្ធតែ ធ្វើ យ៉ាង ដូច្នោះ ក៏ នឹង មិន មាន បញ្ហា ច្រើន នោះ ដែរ ។
បន្ទាប់ពី ធ្វើការ ក្នុង វិស័យ មុខងារ សាធារណៈ បាន ប្រមាណ ២២ ឆ្នាំ មក ហើយ នោះ លោក ពេជ្រ ប៊ុន ធិន ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ផ្លាស់ ពី រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ ដំឡើង ទៅជា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស ដោយ តំណែង រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ ត្រូវបាន ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ តែងតាំង លោក ព្រុំ សុខា ជំនួស វិញ ។
លោក ពេជ្រ ប៊ុន ធិន បាន រៀបរាប់ ពី សមិទ្ធផល ជាច្រើន ដែល លោក និង ថ្នាក់ដឹកនាំ ទាំងឡាយ បាន អនុវត្ត ការងារ សម្រេចបានជា បន្តបន្ទាប់ ព្រមទាំង ការរៀបចំ ផែនការ យុទ្ធសាស្ត្រ សម្រាប់ ទិសដៅ ការងារ បន្ត ទៅ មុខ ។
លោក រដ្ឋមន្ត្រី ថ្មី បាន ប្ដេជ្ញា បន្ត ពង្រឹង ការដឹកនាំ គ្រប់គ្រង និង អភិវឌ្ឍ វិស័យ មុខងារ សាធារណៈ និង ការបណ្តុះបណ្តាល សមត្ថភាព វិជ្ជាជីវៈ របស់ មន្ត្រីរាជការ ស៊ីវិល ដោយ ផ្អែក ទៅ លើ គោលការណ៍ គុណាធិបតេយ្យ រួមចំណែក កសាង អភិវឌ្ឍ ធនធាន មនុស្ស ក្នុង វិស័យ សាធារណៈ ។
ទាំងនេះ សបញ្ជាក់ ឲ្យ ឃើញ ថា ការដឹកនាំ គ្រប់គ្រង និង អភិវឌ្ឍ វិស័យ មុខងារ សាធារណៈ ក្រោម សមត្ថភាព និង ភាព ជា អ្នកដឹកនាំ របស់ លោក ពេជ្រ ប៊ុន ធិន បាន រួមចំណែក ធ្វើឲ្យ ការអនុវត្ត យុទ្ធសាស្ត្រ ត្រីកោណ និង យុទ្ធសាស្ត្រ ចតុកោណ គ្រប់ ដំណាក់កាល របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបាន នូវ លទ្ធផល ជា ទី គាប់ ប្រសើរ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា បាន កត់ត្រា ជា ស្នាដៃ និង សមិទ្ធផល ទាំងនេះ ទាំង នៅពេល បច្ចុប្បន្ន និង ទៅ អនាគត ។
នា ឱកាស នោះ លោក ប៊ិន ឈិន បាន ផ្តល់ នូវ មគ្គទេស ដឹកនាំ និង មតិ ផ្តាំផ្ញើ ដល់ លោក ព្រំ សុខា រដ្ឋមន្រ្តី ក្រសួង មុខងារ សាធារណៈ ព្រមទាំង រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ អគ្គ នាយក ដែល ជា ថ្នាក់ដឹកនាំ ក្រសួង និង មន្ត្រីរាជការ និង ប្រធាន មន្ទីរ របស់ ក្រសួង មុខងារ សាធារណៈ ទាំងអស់ ដើម្បី យក ទៅ អនុវត្ត ការងារ ឲ្យ កាន់តែ ទទួលបាន ជោគជ័យ ថ្មី ៗ បន្ថែម ទៀត ៕ឡាវ មិន បាន រកឃើញ ករណី ឆ្លង COVID-19 ថ្មី សូម្បីតែ ម្នាក់ នៅ ថ្ងៃអង្គារ នេះ . ចំនួន សរុប ៩ករណី ដដែល
សប្បុរស ជន ជាច្រើន បាន ចូលរួម ឧបត្ថម្ភ ថវិកា សម្រាប់ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឹកូវីដ១៩ នៅ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ យោង តម្រូវ ការចាំបាច់ រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ បាន ចេញ លិខិត បង្គាប់ ការ ដោយ ចាត់តាំង ឱ្យ ក្រុមការងារ មន្ត្រីរាជការ សាលា ខេត្ត ចំនួន ៨រូប ដើម្បី ប្រចាំ ការទទួល ការឧបត្ថម្ភ ថវិកា និង សម្ភារ នានា ពី សប្បុរសជន សម្រាប់ ចូលរួមចំណែក ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ (Covid-19) ដោយ ជ្រើសរើស យក ទីតាំង វេទិកា ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ក្នុង បរិវេណ សាលា ខេត្ត ។
លោក ម៉ៅ ធ និន ក្នុង នាម ថ្នាក់ដឹកនាំ ខេត្ត បាន លើកឡើង ថា ដើម្បី ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ខេត្ត ពោធិ៍សាត់ បាន ខិតខំ ធ្វើ អ្វី ៗ គ្រប់ បែបយ៉ាង ដើម្បី សង្គ្រោះ និង ការពារ ជីវិត របស់ ប្រជាជន យើង ។ លោក ក៏ សូម ថ្លែងអំណរគុណ ដល់ ឯកឧត្តម លោក ឧកញ៉ា លោកជំទាវ លោក លោកស្រី និង សប្បុរសជន ទាំងអស់ និង សូម ជួបប្រទះ តែ នឹង ពុទ្ធ ពរ ទាំង ៤ប្រការ៖ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ និង សូម ជៀស ផុត អំពី ជំងឺ ដ៏ កាច សាហាវ ដែល កំពុងតែ គំរាមកំហែង ទូទាំង ពិភពលោក នេះ ។
សប្បុរស ជន ជួយ ចូលរួម ឧបត្ថម្ភ ថវិកា និង សម្ភារៈ សម្រាប់ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នៅ ខេត្ត ពោធិ៍សាត់ រួម មាន៖
គ្រាន់តែ ក្នុង រយៈពេល ពេញ មួយ ថ្ងៃអង្គារ ម្សិលមិញ នេះ ប្រទេស អ៊ឺរ៉ុប ដែល មាន ប្រជាជន ប្រមាណ ជាង ៨លាន នាក់ និង ជា ប្រទេស ដែល ត្រូវបាន គេ ចាត់ទុក ថា មាន ភាពជឿនលឿន ផ្នែក សេដ្ឋកិច្ច និង វេជ្ជសាស្ត្រ មួយ នេះ បាន កត់ត្រា ចំនួន អ្នកស្លាប់ ដោយសារ ជំងឺ COVID-19 រហូតដល់ ៧៨ នាក់ ឯណោះ ។
នៅ ចំពោះមុខ ការរីករាលដាល នៃ ជំងឺ ដ៏ កាច សាហាវ នេះ រដ្ឋាភិបាល ប្រទេស ស្វីស បាន ដាក់ចេញ នូវ វិធានការរឹតត្បិត ជាច្រើន ដើម្បី ទប់ស្កាត់ តួយ៉ាង ដូចជា ការហាមឃាត់ មិន ឲ្យ ជួបជុំគ្នា បិទ សាលារៀន ក៏ ដូចជា បិទ សេវាកម្ម មួយ ចំនួន ដែល មិន ចាំបាច់ ជាដើម ។ តែ ទោះជា យ៉ាងណា នា រយៈពេល ចុងក្រោយ នេះ សន្ទុះ នៃ អត្រា អ្នក ឆ្លង និង អ្នកស្លាប់ ចេះតែ កើនឡើង ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ។
គួរ បញ្ជាក់ ថា រហូតមលទល់ ពេលនេះ អាជ្ញាធរ សុខាភិបាល ស្វីស បាន ធ្វើតេស្ត លើ មនុស្ស ចំនួន ១៥. ៥៧៥ នាក់ ដោយ ក្នុង នោះ មនុស្ស ចំនួន ១៦. ១៧៦ នាក់ មាន លទ្ធផល វិជ្ជមាន ចំពោះ ជំងឺ COVID-19 ហើយ ក្នុង ចំណោម អ្នក ឆ្លង ទាំងអស់ នេះ ទៀតសោត មាន អ្នកស្លាប់ ចំនួន ៣៧៣ នាក់ និង ១. ៨២៣ នាក់ បាន ជាសះស្បើយ ឡើងវិញ ៕ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ ទទួលបាន ម៉ាស ទឹក សម្លាប់ មេរោគ និង សម្លៀកបំពាក់ ពេទ្យ ពី សប្បុរសជន
( ព្រះសីហនុ) ៖ នៅ រសៀល ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ សូម ថ្លែងអំណរគុណ ទៅដល់ កាស៊ីណូ ប៉ ឡាយ ដែល បាន ឧបត្ថម្ភ ឈុត សំលៀកបំពាក់ ពេទ្យ ចំនួន ១២០ កំប្លេ ទឹក សម្លាប់ មេរោគ ១០កាន និង ម៉ាស ចំនួន ៥កេះ ធំ ។
ជាមួយគ្នា នេះ ស្នងការដ្ឋាន នគរបាល ខេត្ត ក៏ សូម ថ្លែងអំណរគុណ ទៅដល់ សភា ពាណិជ្ជកម្ម លាវ នេញ នៅ កម្ពុជា ដែល បាន ឧបត្ថម្ភ ម៉ាស់ ចំនួន ៣កេះ ធំ និង សមាគម សហគ្រិន ចិន ជាំង ស៊ូ នៅ កម្ពុជា ដែល បាន ឧបត្ថម្ភ ម៉ាស ចំនួន ៣កេះ ធំ ផងដែរ ។
សូម បញ្ជាក់ ថា គិត ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២០ នេះ សម្រាប់ ខេត្ត ព្រះសីហនុ មាន ឆ្លង COVID-19 មាន ចំនួន ៣៦ នាក់ ក្នុង នោះ មាន ជនជាតិ ចិន ម្នាក់ ជនជាតិ ខ្មែរ ២នាក់ និង ជនជាតិ បារាំង ៣៣ នាក់ ក្នុង ចំណោម អ្នក ឆ្លង សរុប ចំនួន ១០៩ នាក់ ៕ ពលរដ្ឋ ច្រើន គ្រួសារ នៅ បឹង ទំពន់ ខណ្ឌ មានជ័យ ស្នើសុំ ប័ណ្ណ កម្មសិទ្ធិ ស្រប ច្បាប់ ក្រោយ ស្នាក់ អាស្រ័យ ជាង ១០ ឆ្នាំ ខណៈ អាជ្ញាធរ កំណត់ ឱសាន វាទ ថ្ងៃ នេះ លើ ការដោះស្រាយ គោល នយោបាយ
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ជាង ២០០ គ្រួសារ ដែល រស់ នៅ ស្នាក់ អាស្រ័យ រយៈពេល ជាង ១០ឆ្នាំ ហើយ ស្ថិត នៅ បឹង ទំពន់ ( បឹង ធំ ) ក្នុង សង្កាត់ បឹង ទំពន់ទី១ ខណ្ឌ មានជ័យ នៅ ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ស្នើសុំ យ៉ាង ទទូច ដើម្បី ធ្វើ ប័ណ្ណ កម្មសិទ្ធិ កាន់កាប់ ស្រប ច្បាប់ ក្រៅពី ការដោះស្រាយ ផល ប៉ះពាល់ លើ គោល នយោបាយ អភិវឌ្ឍន៍ ពីសំណាក់ រាជ រដ្ឋាភិបាល និង អាជ្ញាធរ រាជធានី ភ្នំពេញ ។
ការស្នើសុំ យ៉ាង ទទូច របស់ តំណាង ប្រជាពលរដ្ឋ ជាង ២០០ គ្រួសារ ទៅកាន់ រាជ រដ្ឋាភិបាល ឲ្យ ជួយ ផ្ដល់ ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ស្រប ច្បាប់ ជូន គឺ បាន ធ្វើឡើង ក្រោយពី អាជ្ញាធរ ដាក់ ឱសានវាទ ឲ្យ ពួកគាត់ ត្រឹមតែ រយៈពេល ៧ ថ្ងៃ ប៉ុណ្ណោះ ជា កំហិត បើ គិត ចាប់ពី ថ្ងៃទី ២៦ ខែមីនា រហូតដល់ ថ្ងៃទី១ ខែមេសា ឆ្នាំ ២០២០ នេះ ៕ លោក ពេជ្រ ស្រស់ ប្រកាស ចែក អង្ករ៦តោន និង មី ម្នាក់ មួយ កេស ដល់ បងប្អូន ប្រជាពលរដ្ឋ ចំនួន ៣០០ គ្រួសារ
( ភ្នំពេញ ) ៖ ប្រធាន គណបក្ស យុវជន កម្ពុជា លោក ពេជ្រ ស្រស់ នៅ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស ថា លោក បាន សម្រេច ទិញ អង្ករ ចំនួន ៦តោន និង មី មួយចំនួន ដើម្បី ចែកជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ចំនួន ៣០០ គ្រួសារ ផ្តោត សំខាន់ លើ បងប្អូន ជា អ្នក ប្រកបរបរ រើស អេត ចាយ និង ធាក់ស៊ី ក្លូ ក្នុង គ្រា ដែល កម្ពុជា កំពុង ជួប បញ្ហា នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ហើយ ពួកគាត់ ពិបាក ប្រកបរបរ ចិញ្ចឹម ជីវិត ។
ការប្រគុំតន្ត្រី ខាងលើ នេះ ធ្វើឡើង នៅ នៅ ខាងក្រៅ បន្ទប់ មន្ទីរពេទ្យ ដែល ជា កម្មសិទ្ធ របស់ គ្រួសារ មួយ ដែល មាន សមាជិក ម្តាយ ម្នាក់ ជីដូន ម្នាក់ និង កូន ៗ ចំនួន បី នាក់ ។
គួរ ជម្រាប ជូន ថា កូរ៉េ ខាងត្បូង បច្ចុប្បន្ន បាន កត់ត្រា អ្នក ឆ្លង ជំងឺ COVID-19 ចំនួន ៩. ៧៨៦ ករណី នៅ ទូទាំង ប្រទេស ក្នុង នោះ ស្លាប់ ១៦២ នាក់ និង ជាសះស្បើយ ៥. ៤០៨ នាក់ ។ ទោះជា យ៉ាងណា នា រយៈពេល ប៉ុន្មាន សប្តាហ៍ ចុងក្រោយ នេះ ប្រទេស អាស៊ី ខាងកើត មួយ នេះ ហាក់ ស្គាល់ ភាពធូរស្រាល ខ្លាំង បន្ទាប់ពី ត្រូវបាន គេ ចាត់ទុក ថា ជា ប្រទេស ដែល រងគ្រោះ ធ្ងន់ធ្ងរ ជាង គេ បំផុត ដោយសារ ជំងឺ នេះ នៅ អាស៊ី បន្ទាប់ពី ចិន ៕
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ បាន ចេញ បទបញ្ជា ដល់ កងទ័ព គ្រប់ កង ឯកភាព និង បន្ទាយ ទាំងអស់ ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ខ្មែរ ដែល នឹង ចូល មកដល់ ក្នុង ពេល ខាងមុខ នេះ មិន ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ក្រៅ កង ឯកភាព ឬ បន្ទាយ ជាដាច់ខាត គឺ ត្រូវ ត្រៀម កម្លាំង ជាស្រេច ដើម្បី ចេញ អន្តរាគមន៍ ទប់ស្កាត់ ការរីករាលដាល មេរោគ កូវីដ១៩ ។
១៖ មេបញ្ជាការប្រភេទ ទ័ព ទ័ព ជំនាញ កង ឯកភាព ស្ថាប័ន និង សាលា ចំណុះ អគ្គ បញ្ជាការដ្ឋាន នៃ កងយោធពល ខេមរភូមិន្ទ ទាំងអស់ ដែល មាន ទ័ព ប្រមូលផ្តុំ នៅក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ឆ្នាំ ជូន ទោស័ក ព .ស ២៥៦៤ ត្រូវ អនុវត្ត យ៉ាង ម៉ឺងម៉ាត់ ដូច ខាងក្រោម៖
* មិន អនុញ្ញាតឲ្យ យោធិន ចេញ ក្រៅ កង ឯកភាព ឬ បន្ទាយ ជាដាច់ខាត ។ * មិន ត្រូវ ប្រមូលផ្តុំ ជប់លៀង ឬ ពិធី ផ្សេង ៗ នាំឲ្យ ប៉ះពាល់ ដល់ វិធានការ ការពារ មេរោគ កូវីដ១៩ ។ * ត្រូវ ត្រៀម កម្លាំង ជាស្រេច ដើម្បី អន្តរាគមន៍ ទប់ស្កាត់ ការរីករាលដាល មេរោគ កូវីដ១៩ តាម បទបញ្ជា អគ្គ បញ្ជាការ ។
២៖ ត្រូវ យកចិត្ត ទុកដ្ឋាន អនុវត្ត ឲ្យ មាន ប្រសិទ្ធភាព តាម សារាចរ ណែនាំ ស្តីពី ការបង្ការ ការពារ ទប់ស្កាត់ និង គ្រប់គ្រង ជំងឺ កូវីដ១៩ របស់ អគ្គ បញ្ជាការ ។
៣៖ នាយក ខុទ្ទកាល័យ អគ្គ បញ្ជាការដ្ឋាន មេបញ្ជាការប្រភេទ ទ័ព និង ទ័ព ជំនាញ នាយក ស្ថាប័ន និង សាលា ចំណុះ អគ្គ បញ្ជាការដ្ឋាន ត្រូវ ចាត់តាំង អនុវត្ត បទបញ្ជា នេះ ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ចាប់ពី ថ្ងៃ ចុះហត្ថលេខា រហូត មាន បទបញ្ជាថ្មី ៕ ក្រសួង កសិកម្ម៖ ៣ខែ ដំបូង ឆ្នាំ នេះ កម្ពុជា នាំចេញ កសិផល ជិត ៣លាន តោន !
( ភ្នំពេញ ) ៖ របាយការណ៍ របស់ រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ លោក វេង សា ខុន បាន បញ្ជាក់ ឲ្យដឹង ថា រយៈពេល ៣ខែ ដើម ឆ្នាំ ២០២០ នេះ កម្ពុជា បាន នាំចេញ កសិផល ទៅកាន់ ទីផ្សារ អន្តរជាតិ ទាំង ផ្លូវការ និង ក្រៅ ផ្លូវការ បាន ជិត ៣លាន តោន ។
ក្រសួង កសិកម្ម បាន បញ្ជាក់ ថា តួលេខ នៃ ការនាំចេញ កសិផល នៅ រយៈពេល ៣ខែ ដំបូង នេះ ការកត់ត្រា ការនាំចេញ ផ្លូវការ ដោយ អគ្គ នាយកដ្ឋាន កសិកម្ម មាន ចំនួន ១. ៦៣៨. ៣៣៨តោន និង ក្រៅ ផ្លូវការ មាន ចំនួន ១. ២៩៨. ៦៥៤តោន ។
ដោយ ការនាំចេញ ក្រៅ ផ្លូវការ មាន ដំឡូង មី និង ស្រូវ ទៅកាន់ ប្រទេស វៀតណាម មាន ចំនួន ១. ២៩៨. ៦៥៤តោន ។
ទីផ្សារ សម្រាប់ កសិផល របស់ កម្ពុជា មាន ប្រទេស ចិន អឺរ៉ុប អាមេរិក វៀតណាម ថៃ ជប៉ុន រុស្ស៊ី ឥណ្ឌា ប្រទេស សមាជិក អាស៊ាន និង ប្រទេស មួយចំនួន ទៀត ៕
ក្រសួង ធនធាន ទឹក អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល អាចនឹង កើតមាន ចាប់ពី ថ្ងៃទី ០២ - ០៦ ខែមេសា !
ជាមួយគ្នា នេះ ក្រសួង ក៏ បាន ឲ្យដឹង ថា នៅ រយៈពេល នេះ តំបន់ មួយចំនួន នឹង មាន ភ្លៀង ធ្លាក់ ពី កម្រិត ខ្សោយ ទៅ បង្គួរ ផងដែរ ។ ទន្ទឹមនឹង ការមាន ភ្លៀង ធ្លាក់ នេះ ក្រសួង ក៏ អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ សូម ប្រុងប្រយ័ត្ន ចំពោះ បាតុភូត ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ដែល អាចនឹង កើតមាន ចាប់ពី ថ្ងៃទី ០២ - ០៦ ខែមេសា ៕
សូម អាន សេចក្តីជូនដំណឹង របស់ ក្រសួង ធនធាន ទឹក ទាំង ស្រុង៖ គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន គ្រប់ វិនាទី ! ស្លាប់ ៧នាក់ និង ១២នាក់ រងរបួស ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៣១ ខែមីនា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ របួស ស្រាល ៧នាក់ និង របួស ធ្ងន់ ៥នាក់ ក្នុង នោះ មិន ពាក់ មួក ១១នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ មិន គោរព សិទ្ធិ និង ប្រជែង ៕
ការណែនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ គណៈ អចិន្ត្រៃយ៍ គណៈ រដ្ឋមន្ត្រី នា ព្រឹក ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ ។ ក្នុង សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ កិច្ចប្រជុំ បាន ឱ្យដឹង ថា ក្នុង កិច្ចប្រជុំ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ នូវ វិធានការ ជាច្រើន ដើម្បី ដោះស្រាយ បញ្ហា ទាំងឡាយ ដែល កំពុង កើតមាន និង អាច កើតមាន បណ្តាល មកពី ជំងឺ កូវីដ១៩ ។
ក្នុង ចំណោម វិធាន ទាំងឡាយ ដែល បាន លើកឡើង នោះ សម្តេច តេជោ បាន ផ្តល់ អនុសាសន៍ ឱ្យ ត្រៀម ទុក នូវ វិធានការ សេដ្ឋកិច្ច ដែល អាច រង ផល ប៉ះពាល់ រយៈពេល យូរ ដោយសារតែ ជំងឺ កូវីដ១៩ នេះ ។ សម្តេច តេជោ បាន ណែនាំ ឱ្យ ពង្រឹង វិស័យ កសិកម្ម ដែល ជា ចំណុច ខ្លាំង របស់ កម្ពុជា ។
សម្តេច តេជោ ក៏ បាន ណែនាំ ឱ្យ ត្រៀម ទំនិញ ស្បៀង ចាំបាច់ សម្រាប់ ប្រជាជន កម្ពុជា ដូចជា អង្ករ និង អំបិល ជាដើម ។
សូម បញ្ជាក់ ថា ដើម្បី ត្រៀម ស្បៀងអាហារ ទុក សម្រាប់ ផ្គត់ផ្គង់ តម្រូវការ ក្នុង ស្រុក នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ឱ្យ ផ្អាក ជា បណ្តោះអាសន្ន នូវ ការនាំចេញ ស្រូវ និង អង្ករស ទៅ ក្រៅ ប្រទេស ផងដែរ ៕ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រប់គ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ត្រូវ បញ្ជូន ទៅ រដ្ឋសភា ក្រោយ គណៈ អចិន្ត្រៃយ៍ គណៈ រដ្ឋមន្ត្រី ពិនិត្យ
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ គណៈ អចិន្ត្រៃយ៍ គណៈ រដ្ឋមន្ត្រី ដើម្បី ពិនិត្យ លើ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រប់គ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ។
ក្នុង សេចក្តីប្រកាស ព័ត៌មាន បន្ថែម ថា សេចក្តីព្រាង ច្បាប់ នេះ នឹង ផ្តល់ ជា មូលដ្ឋាន គតិយុត្ត ដើម្បី ធានា ដល់ ការអនុវត្តមាត្រា ២២ ថ្មី នៃ រដ្ឋធម្មនុញ្ញ និង ជា មូលដ្ឋាន គតិយុត្ត កំណត់ សិទ្ធិ អំណាច របស់ រាជ រដ្ឋាភិបាល ក្នុង ការដាក់ចេញ នូវ វិធានការចាំបាច់ ដែល មិន អាច ខ្វះ បាន ដើម្បី ឆ្លើយតប ទៅនឹង ស្ថានភាព របស់ ប្រទេស ក្នុង ភាពអាសន្ន សំដៅ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ការពារ អាយុជីវិត និង សុខភាព របស់ ប្រជាពលរដ្ឋ ព្រមទាំង ការពាំរ ទ្រព្យសម្បត្តិ និង បរិស្ថាន ។
សម្តេច តេជោ ហ៊ុន សែន ក្នុង សន្និសីទ ព័ត៌មាន នៅ ថ្ងៃទី៣០ ខែមីនា ម្សិលមិញ នេះ បាន ប្រកាស ពី ការសម្រេចចិត្ត តាក់តែង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ។ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា កម្ពុជា មិន មាន ទាន់ ច្បាប់ គ្រប់គ្រង ប្រទេសជាតិ ក្នុង ពេល មាន អាសន្ន នៅឡើយ នោះ ទេ ។ ដូច្នេះ ការបង្កើត ច្បាប់ នេះ ឡើង ដើម្បី ជា ឧបករណ៍ ផ្នែក ច្បាប់ មួយ គ្រប់គ្រង ប្រទេសជាតិ ក្នុង ភាព មាន អាសន្ន ។
សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ និង អង្គការ សង្គម ស៊ីវិល ផងដែរ កុំ ឱ្យ មាន ការព្រួយបារម្ភ ច្បាប់ នេះ ព្រោះ មិន មែន បង្កើតឡើង មក ដើម្បី រឹត ដ្បិត សេរីភាព របស់ ប្រជាពលរដ្ឋ និង សេរីភាព នៃ ការបញ្ចេញមតិ នោះ ឡើយ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បង្ហាញ ក្តី រំពឹង ផងដែរ ថា រដ្ឋសភា នឹង ពន្លឿន ក្នុង ការពិនិត្យ និង អនុម័ត ទៅ លើ សេចក្តីព្រាង ច្បាប់ មួយ នេះ ផងដែរ ។
ដោយឡែក ជំពូក ទី៥ ដែល ជា ជំពូក ចុងក្រោយ និយាយ ពី ន រាករណ៍ និង ការប្រកាស ជា ការ ប្រញាប់ នៃ ច្បាប់ នេះ ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០
១៖ ព្រះមហាក្សត្រ និង សម្តេច ម៉ែ នឹង យាង ទៅ ពិនិត្យ ព្យាបាល ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន នៅ ថ្ងៃទី ០១ ខែមេសា ឆ្នា ២០២០ ( ចុច អាន )
២៖ សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ កិច្ចប្រជុំ គណៈ អចិន្ត្រៃយ៍ គណៈ រដ្ឋមន្ត្រី ពិនិត្យ សេចក្តីព្រាង ច្បាប់ គ្រប់គ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ( ចុច អាន )
៤៖ មន្ទីរ សុខាភិបាល ខេត្ដ សៀមរាប៖ ឆាប់ ៗ នេះ អ្នកជំងឺ កូវីដ១៩ នឹង ជាសះស្បើយ បន្ដ ទៀត បន្ទាប់ពី បុរស ជនជាតិ ខ្មែរ អាយុ ៣៨ ឆ្នាំ បាន ជាសះស្បើយ ចេញ ពី មន្ទីរពេទ្យ ម្សិលមិញ ( ចុច អាន )
៧៖ មន្រ្ដី នគរបាល អនុវត្ត ច្បាប់៖ ការកែ អនុក្រឹត្យ ដំឡើង ប្រាក់ ពិន័យ ល្មើស ច្បាប់ ចរាចរណ៍ ពី ៣ទៅ ៥ដង អនុវត្តន៍ តាម ប្រទេស ជោគជ័យ ក្នុង ការកាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ( ចុច អាន )
ក្លឹប បាល់ទាត់ អង់គ្លេស Man City ដៃគូ ពាណិជ្ជកម្ម របស់ វើក និង ស្រាបៀរ កម្ពុជា ប្រគល់ កីឡដ្ឋាន ជូន រដ្ឋ សម្រាប់ ប្រយុទ្ធ នឹង កូវីដ១៩
តាម សេចក្តីរាយការណ៍ បាន បង្ហាញ ថា ទីធ្លា នៃ ពហុកីឡដ្ឋាន Etihad ដែល មាន កៅអី ទស្សនា ចំនួន ៥៥០០០ រួម ជាមួយ សាល សន្និសីទ នឹង ត្រូវ យក ទៅ ប្រើប្រាស់ ជា កន្លែង បណ្តុះបណ្តាល បុគ្គលិក គិលានុប្បដ្ឋាយិកា ជួរ មុខ ដែល ពួកគេ ត្រូវ ទៅ មើល ថែ និង ព្យាបាល់ អ្នក ឆ្លង មេរោគ កូវីដ១៩ ដោយ ផ្ទាល់ ។
លោកស្រី លីនដា រ៉េយ ណុល ដស៍ (Linda Reynolds) ដែល ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ អូស្ត្រាលី បាន ប្រកាស ក្នុង សេចក្តីថ្លែងការណ៍ មួយ កាលពី ថ្ងៃចន្ទ សប្តាហ៍ នេះ ថា ការដាក់ពង្រាយ កងទ័ព ត្រូវបាន ពន្យារ ពេល ។ ប៉ុន្តែ ទោះជា យ៉ាងណា លោកស្រី ក៏ បាន គូសបញ្ជាក់ ដែរ ថា អូស្ត្រាលី នឹង ធ្វើការ ជាមួយ សហរដ្ឋ អាមេរិក ដើម្បី បង្កើត ជម្រើស សម្រាប់ ការដាក់ពង្រាយ នៅ ពេល ក្រោយ ទៀត តាម ដែល អាច ធ្វើ ទៅ បាន អាស្រ័យ លើ លក្ខខណ្ឌ និង លទ្ធភាព ប្រសើរ ជាង នេះ ។
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា ជំរុញ លើកទឹកចិត្ត ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ បន្ត ការទិញ ស្រូវ ពី កសិករ ក្នុង តម្លៃ សមរម្យ តាម តម្លៃ ទីផ្សារ បើ ខ្វះ ទុន សូម ទាក់ទង ធនាគារ អភិវឌ្ឍន៍ ជនបទ
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា នៅ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ថ្មី មួយ ជំរុញ និង លើកទឹកចិត្ត ម្ចាស់ រោង ម៉ាស៊ីន កិន ស្រូវ បន្ត ការទិញ ស្រូវ ពី កសិករ តម្លៃ មួយ សមរម្យ តាម តម្លៃ ទីផ្សារ បើ ខ្វះ ទុន បង្វិល សូម ទាក់ទង ធនាគារ អភិវឌ្ឍន៍ ជនបទ និង កសិកម្ម ដែល កំពុង រង់ចាំ ផ្តល់ កម្ចី ។
ចូរ ប្រាប់ មនុស្ស ជា ទីស្រឡាញ់ អំពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣១ ខែមីនា៖ បង្ក្រាប ២៧ករណី ឃាត់ខ្លួន ៥១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១១ករណី . ជួញដូរ ១៦ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ៥១ នាក់ ។
ការលើកឡើង បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ឯក សំអុល ផ្ដល់ កិច្ចសម្ភាសន៍ ជូន ក្រុម អ្នកសារព័ត៌មាន នៅ ទីស្នាក់ការ កណ្ដាល របស់ សមាគម មិត្តភាព កម្ពុជា - ចិន នា រសៀល ថ្ងៃទី ៣១ ខែមីនា ឆ្នាំ ២០២០ នេះ ។
តាង នាម សមាគម មិត្តភាព កម្ពុជា - ចិន លោក សូមស្វាគមន៍ យ៉ាង កក់ក្តៅ បំផុត ចំពោះ ក្រុម វេជ្ជបណ្ឌិត ប្រទេស ចិន មក បំពេញ បេសកកម្ម នៅ កម្ពុជា ដើម្បី រួម ជាមួយ វេជ្ជបណ្ឌិត កម្ពុជា ក្នុង ភារកិច្ច ប្រយុទ្ធ ប្រឆាំង ជាមួយ មេរោគ កូវីដ - ១៩ ។ សកម្មភាព នេះ បាន ឆ្លុះបញ្ចាំង នូវ អត្ថន័យ សំខាន់ ដូចត ទៅ៖
១៖ មិត្តភាព និង សហប្រតិបត្តិការ កម្ពុជា - ចិន កសាងឡើង រវាង បេះដូង និង បេះដូង ហើយ មាន អាយុកាល ៦២ ឆ្នាំ ហើយ តាំងពី ជំនាន់ ព្រះករុណា ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ ជាមួយ លោក ម៉ៅ សេទុង . លោក ជូ អេនឡាយ ។
២៖ សហប្រតិបត្តិការ កម្ពុជា - ចិន បាន ក្លាយជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ តាំងពី ឆ្នាំ ២០១០មក រយៈពេល ១០ឆ្នាំ ចុងក្រោយ នេះ ចិន បាន ឆ្លើយតប ទៅនឹង សំណូមពរ តម្រូវការ របស់ កម្ពុជា ក្នុង ការកសាង និង អភិវឌ្ឍន៍ ប្រទេស ជាតិ លើ គ្រប់ វិស័យ ។ ចិន ជាប់ ចំណាត់ថ្នាក់ លេខ មួយ ច្រើន វិស័យ ក្នុង ការអភិវឌ្ឍន៍ កម្ពុជា ។
៣៖ គឺជា ការឆ្លើយតប ទៅនឹង កិច្ចព្រមព្រៀង កម្ពុជា - ចិន ចុះហត្ថលេខា នៅ ថ្ងៃទី ២៨ ខែមេសា ឆ្នាំ ២០១៩ នៅ ក្រុង ប៉េកាំង ស្តីពី ការកសាង សហគមន៍ រួម វាសនា តែ មួយ ជា ការឆ្លើយតប ទៅនឹង គំនិត ផ្តួចផ្តើម « ខ្សែក្រវ៉ាត់ ផ្លូវ » របស់ ចិន ។
៤៖ គឺជា ការឆ្លើយតប ទៅនឹង ទស្សនកិច្ច របស់ សម្តេច តេជោ ហ៊ុន សែន កាលពី ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅ ទីក្រុង ប៉េកាំង ក្នុង ពេល ដែល ចិន កំពុង លំបាក បំផុត ក្នុង ការប្រយុទ្ធ ប្រឆាំង មេរោគ កូវីដ - ១៩ ។ ពេល នោះ បណ្តា ប្រទេស ក្នុង តំបន់ នៅ អ៊ឺរ៉ុប អូស្ត្រាលី និង សហរដ្ឋ អាមេរិក គេ មើល ស្រាល គេ រើសអើង ចិន ។
ជាមួយគ្នា នោះ លោក ឯក សំអុល បាន គូសបញ្ជាក់ ថា « យើង ត្រូវ ដឹង ថា ប្រទេស ចិន ជា មហាអំណាច សេដ្ឋកិច្ច ទី ពីរ ក្នុង លោក ។ ទន្ទឹមនឹង ភារកិច្ច ត្រូវ បំពេញ ក្នុង ប្រទេស ចិន មាន ការទទួលខុសត្រូវ ធំ ធេង លើ ភារកិច្ច អន្តរជាតិ ក្នុង សម័យ សកល ភាវូបនីយកម្ម ជួយ ដល់ បណ្តា ប្រទេស ដើម្បី ការអភិវឌ្ឍន៍ ពិភពលោក និង ដើម្បី ជោគវាសនា របស់ មនុស្សជាតិ ។ មេរោគ កូវីដ - ១៩ ជា សត្រូវ ស្លាប់ រស់ របស់ មនុស្សជាតិ » ។
ប្រធាន សមាគម មិត្តភាព កម្ពុជា - ចិន បាន បន្ថែម ទៀត ថា « ទន្ទឹម នេះ គឺជា ការឆ្លុះបញ្ចាំង អំពី សមត្ថភាព គុណធម៌ របស់ ប្រទេស ចិន ក្នុង ឆ្នាំ ២០២០ ។ ពីមុន មនុស្ស គ្រប់ ប្រទេស អភិវឌ្ឍន៍ សម្លឹង តែ ទៅ លើ អឺរ៉ុប និង សហរដ្ឋ អាមេរិក ទេ ។ ប៉ុន្តែ ពេល នេះ ប្រែប្រួល ហើយ គេ ត្រូវ ងាក មក រក ចិន ។ អ្នកណា ប្រឆាំង ចិន គឺ ពិតជា ល្ងង់ខ្លៅ បំផុត » ។
គូសបញ្ជាក់ ថា ក្រុម គ្រូពេទ្យ ជំនាញ របស់ ចិន ចំនួន ៧នាក់ ដែល មាន បទពិសោធ ខ្ពស់ ក្នុង ការព្យាបាល កូវីដ១៩ បាន មកដល់ ប្រទេស កម្ពុជា នា ព្រឹក ថ្ងៃទី ២៣ ខែមីនា ឆ្នាំ ២០២០ ដើម្បី ចែករំលែក បទពិសោធន៍ ក្នុង ការព្យាបាល ជំងឺ កូវីដ១៩ នៅក្នុង ប្រទេស កម្ពុជា ។
ក្នុង នោះ ក្រុមហ៊ុន ព្រីនស៍ ហូល ឌីង គ្រុប បាន ផ្ដល់ វិភាគទាន ជាច្រើន ដូច ជា៖
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ផ្ញើ សារលិខិត ថ្លែងអំណរគុណ និង កោតស សើរ ចំពោះ លោក ឧកញ៉ា ចេន ហ្ស៊ី ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ក្រុមហ៊ុន ព្រីនស៍ ដែល បាន ផ្តល់ វិភាគទាន ជា សាច់ប្រាក់ ចំនួន ៥០ ម៉ឺន ដុល្លារ អាមេរិក សម្រាប់ យុទ្ធនាការ ទប់ទល់ និង ប្រឆាំង ការរីករាលដាល នៃ ជំងឺ Covid-19 ។
លោក ឧកញ៉ា ចេន ហ្ស៊ី ប្រធាន ក្រុមប្រឹក្សាភិបាល នៃ ក្រុមហ៊ុន ព្រីនស៍ បាន ថ្លែង ថា ក្រោម ការបញ្ជា និង ការដាក់ពង្រាយ យុទ្ធសាស្ត្រ ផ្ទាល់ របស់ លោក ប្រធានាធិបតី ចិន ស៊ី ជីន ពីង ប្រជាជន ចិន ទាំងអស់ បាន រួមគ្នា ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ ជំងឺ Covid-19 ហើយ បាន ទទួល ជោគជ័យ ជា បន្តបន្ទាប់ ក្រោយ ការខិតខំ ប្រឹងប្រែង អស់ រយៈពេល ជាង ៦០ ថ្ងៃ កន្លងមក ។
លោក ឧកញ៉ា ថ្លែង បន្ដ ថា ក្នុង គ្រា លំបាក បំផុត នៅ ដំណាក់កាល ដំបូង នៃ ការតស៊ូ ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ ជំងឺ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើដំណើរ ទៅកាន់ ទីក្រុង ប៉េកាំង ដោយ ផ្ទាល់ ដោយ មិន គិត ពី ហានិភ័យ ផ្ទាល់ខ្លួន និង បាន ជួយ គាំទ្រ ដល់ ការតស៊ូ របស់ ប្រទេស ចិន ចំពោះ ការរីករាលដាល នៃ ជំងឺ នេះ ដែល នេះ បាន ឆ្លុះបញ្ចាំង ពី ភាតរភាព ដ៏ ជ្រាលជ្រៅ រវាង កម្ពុជា និង ចិន នៅពេល មាន វិបត្តិ ។
លោក ឧកញ៉ា បញ្ជាក់ ថា បច្ចុប្បន្ន ក្រុមហ៊ុន ព្រីនស៍ ហូល ឌីង គ្រុប គ្រោង នឹង បន្ត ទិញ សម្ភារ ផ្នែក វេជ្ជសាស្ត្រ ពី ប្រទេស ចិន បន្ថែម ទៀត ដើម្បី បន្ត គាំទ្រ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ Covid-19 ។
លោកស្រី ពេជ ចន្ទ មុន្នី អនុប្រធាន ក្រុមប្រឹក្សាភិបាល សមាគម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន សម្តេច តេជោ (TYDA) បាន ថ្លែង ឲ្យដឹង ថា នេះ ជា សំភារៈ ដែល ក្រុម គ្រូពេទ្យ ជួរ មុខ កំពុង ត្រូវការ ជាបន្ទាន់ ពិសេស ម៉ាស៊ីន . អុកស៊ីសែន . សម្លៀកបំពាក់ ការពារ . ម៉ាស និង ឧបករណ៍ ធ្វើតេស្ត រក មេរោគ កូវិដ១៩ ។
លោកស្រី បាន បញ្ជាក់ ថា « ខ្ញុំ សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ក្រុមហ៊ុន ព្រីនស៍ ដែល បាន ផ្តល់ ជំនួយ ខណៈ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា កំពុង ត្រូវការ ខ្លាំង បំផុត » ៕
លោក ក៏ បាន លើកឡើង ដែរ ថា ការចុះ ផ្សព្វផ្សាយ នេះ គឺ ក្នុង គោលបំណង ដើម្បី បញ្ជ្រាប ព័ត៌មាន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ឲ្យ គាត់ បាន យល់ដឹង កាន់តែ ច្បាស់ អំពី វិធានការ ការពារ ទប់ស្កាត់ អំពី ការរីករាលដាល នៃ ជំងឺ Covid 19 ដែល កំពុងតែ ឆ្លង មក ប្រទេស កម្ពុជា យើង នេះ ។
សម្រាប់ ព័ត៌មាន បន្ថែម ឬ មាន ករណី សង្ស័យ សូម ទំនាក់ទំនង តាម លេខ ទូរស័ព្ទ ១១៥ ដោយ ឥត គិត ថ្លៃ ។
អ្នកស្ម័គ្រចិត្ត ទទួលបាន៖ អាល់កុល ២៥០ ml និង សាប៊ូ ១ដុំ នោះ ផងដែ៕ គោល នយោបាយ ការបរទេស របស់ កម្ពុជា៖ មិត្ត ពិតប្រាកដ គឺជា មិត្ត ដែល ចេះ ជួយ គ្នា ក្នុង គ្រា លំបាក
ជប៉ុន បាន ផ្តល់ ការផ្គត់ផ្គង់ ផ្នែក វេជ្ជសាស្ត្រ យ៉ាង ច្រើន ដល់ កម្ពុជា ខណៈពេល ដែល សហរដ្ឋ អាមេរិក បាន សន្យា ផ្តល់ ប្រាក់ ចំនួន ២លាន ដុល្លារ ដើម្បី ជួយ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ រាតត្បាត នេះ ។ កម្ពុជា សូម កោតសរសើរ យ៉ាង ខ្លាំង ចំពោះ ជំនួយ ទាំងអស់ ដែល បាន ផ្តល់ ពី មិត្ត របស់ កម្ពុជា សម្រាប់ បុព្វហេតុ មនុស្សធម៌ ហើយ យើង សូម កោតសរសើរ ចំពោះ ប្រទេស ជា មិត្ត របស់ កម្ពុជា ទាំងអស់ ដែល បាន ទទួលស្គាល់ ការចូលរួម របស់ កម្ពុជា ដល់ សហគមន៍ អន្តរជាតិ ។
ចិន គោរព ឯករាជ្យ អធិបតេយ្យភាព និង បូរណភាព ទឹកដី របស់ កម្ពុជា ហើយ កម្ពុជា សូម គាំទ្រ ជានិច្ច នូវ គោល នយោបាយ ចិន តែ មួយ ។ កម្ពុជា ទទួលស្គាល់ រដ្ឋាភិបាល សាធារណរដ្ឋ ប្រជាមានិត ចិន ថា ជា រដ្ឋាភិបាល ស្រប ច្បាប់ តែ មួយ គត់ ដែល តំណាង ឱ្យ ចិន ទាំងមូល រួម មាន ហុងកុង ម៉ាកាវ និង តៃវ៉ាន់ ។ កម្ពុជា ចាត់ទុក ទឹកដី ទាំង បី ជា តំបន់ រដ្ឋបាល ពិសេស របស់ ចិន ។ កម្ពុជា ប្រកាន់ខ្ជាប់ យ៉ាង ម៉ឺងម៉ាត់ ចំពោះ គោល នយោបាយ នេះ នៅ គ្រប់ កាលៈទេសៈ ៕
