( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក វូ ហាក់ អនុប្រធាន នាយកដ្ឋាន កណ្ដាល នគរបាល ព្រំដែន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ២០ ម៉ឺន រៀល ក្នុង មួយ ខែ រយៈពេល ៦ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ៕ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង ឧបត្ថម្ភ ថវិកា ២ម៉ឺន ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង ដែល ឧបត្ថម្ភ ថវិកា ២០.០០០ ដុល្លារ ( ពីរ ម៉ឺន ដុល្លារ អាមេរិក ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី ចូលរួម អបអរសាទរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ សន្តិភាព និង កាកបាទ ក្រហម កម្ពុជា »៕
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ ដែល ឧបត្ថម្ភ ថវិកា ១០.០០០ ដុល្លារ ( មួយ ម៉ឺន ដុល្លារ អាមេរិក ) ដល់ កាកបាទ ក្រហម កម្ពុជា ដេីម្បី ចូលរួម អបអរសាទរ ខួប ទី១៥៧ ទិវា ពិភពលោក កាកបាទ ក្រហម និង អឌ្ឍ ចន្ទ ក្រហម ៨ ឧសភា ឆ្នាំ ២០២០ ក្រោម ប្រធានបទ « ខ្ញុំ ស្រឡាញ់ សន្តិភាព និង កាកបាទ ក្រហម កម្ពុជា »៕
គួរ ជម្រាប ថា នៅ ថ្ងៃសុក្រ នេះ កូរ៉េ ខាងត្បូង បាន រាយការណ៍ ពី ការរកឃើញ ករណី ឆ្លង ថ្មី ចំនួន ត្រឹម ២៧ នាក់ ប៉ុណ្ណោះ ដែល អត្រា ឆ្លង ប្រចាំ ថ្ងៃ កាន់តែ ទាប ថែម ទៀត ខណៈ កាលពី ចុង ខែកុម្ភៈ កន្លងទៅ អត្រា ឆ្លង ប្រចាំ ថ្ងៃ ធ្លាប់ បាន កើន ដល់ កម្រិត កំពូល គឺជាង ៩០០ នាក់ ។ យ៉ាងណាមិញ អ្នកជំងឺ ០៤ នាក់ ទៀត ក៏ ទើបតែ បាន បាត់បង់ជីវិត ផងដែរ ដែល ធ្វើឲ្យ ចំនួន អ្នកស្លាប់ សរុប កើន ដល់ ២០៨ នាក់ ៕
សិស្ស មន្រ្តី ជាន់ ខ្ពស់ សាលា ភូមិន្ទ រដ្ឋបាល ចុះ ផ្សព្វផ្សាយ ពី វិធានការ កាត់បន្ថយ ហានិភ័យ នៃ ជំងឺ កូវីដ - ១៩ ដល់ អ្នក់ រត់ ស៊ី ក្លូ កម្មករ សំណង់ អ្នកបើក ម៉ូតូ ឌុប និង ម៉ូតូ កង បី
( ភ្នំពេញ ) ៖ សិស្ស មន្រ្តី ជាន់ ខ្ពស់ ជំនាន់ ទី ១១ នៃ សាលា ភូមិន្ទ រដ្ឋបាល បាន ចុះ អនុវត្ត នូវ សកម្មភាព សង្គម របស់ ខ្លួន ដោយ ធ្វើ ការផ្សព្វផ្សាយ អប់រំ ពី វិធី កាត់បន្ថយ ហានិភ័យ នៃ ការឆ្លង ជំងឺ កូវីដ១៩ និង បាន ផ្ដល់ នូវ ទឹក អាល់កុល លាង ដៃ ដល់ អ្នករត់ ស៊ី ក្លូ កម្មករ សំណង់ ម៉ូតូ ឌុប អ្នកបើកបរ ម៉ូតូ កង់ បី និង បងប្អូន ប្រជាពលរដ្ឋ ដទៃ ទៀត ចំនួន ២៥០ នាក់ ។
ការចុះ ផ្សព្វផ្សាយ អប់រំ ពី វិធានការ កាត់បន្ថយ ហានិភ័យ នៃ ជំងឺ កូវីដ - ១៩ របស់ សិស្ស មន្រ្តី ជាន់ ខ្ពស់ សាលា ភូមិន្ទ រដ្ឋបាល បាន ធ្វើឡើង នា ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២០ នៅ ខាងមុខ សាលា ភូមិន្ទ រដ្ឋបាល ។
ក្នុង ឱកាស ផ្សព្វផ្សាយ អប់រំ នេះ សិស្ស មន្រ្តី ជាន់ ខ្ពស់ បាន ជម្រាប ដល់ បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម អនុវត្ត តាម សេចក្ដីណែនាំ របស់ ក្រសួង សុខាភិបាល ដើម្បី កាត់បន្ថយ ហានិភ័យ ការឆ្លង ជំងឺ កូវីដ១៩ នេះ ដូច ជា៖
ទី១៖ លាង ដៃ ឱ្យ បាន ញឹកញាប់ ជាមួយ សាប៊ូ នឹង ទឹក ស្អាត ឬ ទឹក អាល់កុល លាង ដៃ ៗ អាល់កុល ហ្សែល ទី ២៖ ខ្ទប់ មាត់ និង ច្រមុះ នៅពេល ក្អក ឬ កណ្ដាស់ ដោយ ប្រើ កែង ដៃ ឬ ក្រដាស អនាម័យ រួច បោះចោល ក្នុង ធុង សំរាម ឱ្យ បាន ត្រឹមត្រូវ ទី ៣៖ ជៀសវាង ប៉ះពាល់ ជិតស្និទ្ធ ជាមួយ អ្នក ដែល មាន ជំងឺ គ្រុន ក្ដៅ ឬ ផ្ដាសាយ ទី ៤៖ ជៀសវាង ប៉ះពាល់ ភ្នែក ច្រមុះ ឬ មាត់ ទី ៥៖ បរិភោគ អាហារ ដែល ចម្អិន បាន ឆ្អិន ល្អ និង ទី៦៖ ស្វាគមន៍ គ្នា ដោយ ការ សំពះ ជំនួស ការចាប់ ដៃ គ្នា ។
សិស្ស មន្រ្តី ជាន់ ខ្ពស់ ក៏ បាន ជម្រាប ដល់ បងប្អូន ប្រជាពលរដ្ឋ ថា ប្រសិនបើ មាន អាការៈ មិន ស្រួល ឬ មាន ការសង្ស័យ ពាក់ព័ន្ធ នឹង ជំងឺ នេះ សូម មេត្តា ទូរសព្ទ ទៅ លេខ ១១៥ ។
ជាមួយគ្នា នេះ លោក ទេ ព កុសល ប្រធាន នាយកដ្ឋាន បណ្ដុះបណ្ដាល ដំបូង នៃ សាលា ភូមិន្ទ រដ្ឋបាល ដែល បាន ចុះ ដឹកនាំ អនុវត្ត សកម្មភាព សង្គម នេះ បាន អំពាវនាវ ដល់ បងប្អូន អ្នក រត់ ស៊ី ក្លូ កម្មករ សំណង់ ម៉ូតូ ឌុប និង ប្រជាពលរដ្ឋ ដទៃ ផ្សេង ទៀត ឱ្យ ធ្វើ ការលាង សម្អាត ដៃ ជាប្រចាំ ជាមួយ សាប៊ូ នឹង ទឹក ស្អាត ឬ ទឹក អាល់កុល លាង ដៃ ឱ្យ បាន ទៀងទាត់ និង ពាក់ ម៉ាស ជាប្រចាំ ដើម្បី ថែរក្សា សុខភាព ឱ្យ បាន ល្អ ប្រសើរ ពោលគឺ ការពារ ល្អ ជាង ព្យាបាល គឺ ត្រូវតែ ស្អាត និង មាន អនាម័យ ជានិច្ច ។
សូម បញ្ជាក់ ថា កម្មវិធី សង្គម របស់ សាលា ភូមិន្ទ រដ្ឋបាល ក្នុង គម្រោង ចែក ទឹក អាល់កុល លាង ដៃ នេះ បាន ទទួល នូវ ថវិកា គាំទ្រ ពី ថ្នាក់ដឹកនាំ សមាជិក ក្រុមប្រឹក្សាភិបាល គណៈ គ្រប់គ្រង សាស្រ្តាចារ្យ មន្រ្តី កម្មសិក្សា ការី សិស្ស មន្រ្តី រួមទាំងអស់ អតីត កម្មសិក្សា ការី សិស្ស មន្រ្តី នៃ សាលា ភូមិន្ទ រដ្ឋបាល ក្នុង គោលបំណង ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការចាត់ វិធានការ ទប់ទល់ នឹង ជំងឺ កូវីដ១៩ ដោយ ចាប់ផ្ដើម អនុវត្ត តាំង ពី ថ្ងៃទី ០៦ ខែមេសា ឆ្នាំ ២០២០មក ៕
ថ្នាក់ដឹកនាំ និង មន្ត្រី ៗ ចំនួន ៣២១ រូប ( វគ្គ ទី២ ) នៃ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ សរុប ជិត ២០០ លាន រៀល
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង មន្រ្តី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ចំនួន ៣២១ រូប សម្រាប់ វគ្គ ទី២ នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ស្ម័គ្រចិត្ត បរិច្ចាគ ប្រាក់ខែ របស់ ខ្លួន ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ សរុប ទឹកប្រាក់ ជិត ២០០ លាន រៀល ។
សូម បញ្ជាក់ ថា កាលពី វគ្គទី១ នា ថ្ងៃទី ៣ ខែមេសា ឆ្នាំ ២០២០ លោក លឹម គាន ហោ រដ្ឋមន្ដ្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ព្រមទាំង រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ រហូតដល់ ប្រធាន ការិយាល័យ របស់ ក្រសួង សរុប ចំនួន ៥៨ រូប ក៏ បាន ស្ម័គ្រចិត្ត បរិច្ចាគ ប្រាក់ខែ របស់ ខ្លួន ចំនួន ពី១ ខែ ដល់ ៦ខែ រួចហើយ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ សរុប ទឹកប្រាក់ ជិត ៤០០ លាន រៀល ។
លោក ហួត វុទ្ធី អគ្គ ព្រះរាជអាជ្ញា នៃ មហា អយ្យការ អម សាលាឧទ្ធរណ៍ ត្បូងឃ្មុំ បរិច្ចាគ ប្រាក់ បៀវត្ស ២លាន រៀល ក្នុង មួយ ខែ រយៈពេល ៦ខែ ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
( ត្បូងឃ្មុំ ) ៖ លោក ហួត វុទ្ធី អគ្គ ព្រះរាជអាជ្ញា នៃ មហា អយ្យការ អម សាលាឧទ្ធរណ៍ ត្បូងឃ្មុំ នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស រំលែក ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ២០០០.០០០ រៀល ក្នុង ១ខែ សម្រាប់ រយៈពេល ៦ខែ ចាប់ពី ខែមេសា ដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ៕ អាជ្ញាធរ រាជធានី ភ្នំពេញ ដាក់ គោលដៅ ចំនួន ៩ ដើម្បី បិទ គ្រប់ ច្រក ចេញ ចូល រាជធានី ភ្នំពេញ ទាំងស្រុង ទប់ស្កាត់ ការឆ្លង COVID-19
( ភ្នំពេញ ) ៖ ក្រោយ ទទួលបាន បទបញ្ជា របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ស្ដីពី ការផ្អាក ការធ្វើដំណើរ ចេញ ចូល រាជធានី ភ្នំពេញ ទៅ តាម បណ្ដា ខេត្ត និង តាម បណ្ដា ខេត្ត ទៅ ខេត្ត កម្លាំង នគរបាល រាជធានី ភ្នំពេញ តាំងពី ម៉ោង ១២រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ដាក់ គោលដៅ គ្រប់ ច្រក ចេញ ចូល ទាំងអស់ ដើម្បី ការធ្វើដំណើរ នេះ ជា បណ្ដោះអាសន្ន ទប់ស្កាត់ ការរីករាលដាល ជំងឺ COVID-19 ។
យោង តាម របាយការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង នគរបាល បាន ដាក់ គោលដៅ ចំនួន ០៩ ទីតាំង នៅ គ្រប់ ច្រក ចេញ ចូល រាជធានី ភ្នំពេញ ដើម្បី ផ្អាក ការធ្វើដំណើរ ជា បណ្ដោះអាសន្ន របស់ ប្រជាពលរដ្ឋ លើកលែង ករណី ចាំបាច់ ។
គោលដៅ ទាំង ០៩ ទីតាំង នោះ រួម មាន៖
សូម បញ្ជាក់ ថា នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចេញ បទបញ្ជា បន្ទាន់ មួយ ដោយ ហាម ធ្វើដំណើរ ឆ្លងកាត់ ចេញ ចូល រាជធានី ភ្នំពេញ និង ធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ព្រមទាំង ពី ស្រុក មួយ ទៅ ស្រុក មួយ ផងដែរ ។ បំរាម នេះ ចាប់ផ្តើម អនុវត្ត ពី ម៉ោង ២៤៖០០ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ រហូតដល់ ម៉ោង ២៤៖០០ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ ។
ការហាមឃាត់ នេះ ត្រូវបាន លើកលែង ចំពោះ៖
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជា ឱ្យ គ្រប់ ក្រសួង - ស្ថាប័ន និង អាជ្ញាធរ មាន សមត្ថកិច្ច ពាក់ព័ន្ធ ត្រូវ អនុវត្ត បទបញ្ជា នេះ ឱ្យ បាន ម៉ឺងម៉ាត់ បំផុត និង មាន ប្រសិទ្ធភាព ខ្ពស់ ៕
ក្រសួង មហាផ្ទៃ ទទួល អំណោយ ជា ម៉ាស់ និង សម្ភារៈ ការពារ កូវិដ១៩ ពី សប្បុរសជន
( ភ្នំពេញ ) ៖ សប្បុរសជន នានា ដឹកនាំ ដោយ លោក ស្រេង វង្ស ហៀង ទីប្រឹក្សា របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្រ្តី និង ជា រដ្ឋមន្រ្តី ក្រសួង មហាផ្ទៃ បាន ផ្តល់ ម៉ាស និង សម្ភារៈ ការពារ នូវ មេរោគ កូវិដ១៩ ជាច្រើន ជូន ដល់ ក្រសួង មហាផ្ទៃ ដើម្បី ចែកជូន កងកម្លាំងប្រដាប់អាវុធ និង មន្រ្តី ស៊ីវិល នៅក្នុង ក្រសួង និង តាម បណ្តា ខេត្ត មួយចំនួន ។
ថ្លែង បន្ទាប់ពី ធ្វើ កិច្ច ទទួល នូវ ម៉ាស់ និង សម្ភារៈ បរិក្ខា ទាំងនោះ នា រសៀល ថ្ងៃទី ៩ ខែមេសា ឆ្នាំ ២០២០ នៅ ទីស្តីការ ក្រសួង សម្តេច ក្រឡាហោម ស ខេង បាន លើកឡើង ថា ម៉ាស់ ដែល សប្បុរសជន នានា ដឹកនាំ ដោយ លោក ស្រេង វង្ស ហៀង នេះ គឺ មាន ចំនួន ៣៥.០០០ ម៉ាស និង ទឹក សម្លាប់ មេរោគ ចំនួន ៨០០ ដប ដោយ សម្ភារៈ ទាំង នេះ នឹង ចាប់ផ្តើម ចែកជូន មន្រ្តី ប្រដាប់អាវុធ និង ស៊ីវិល ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ខ្មែរ នេះ ។
សម្តេច ក្រឡាហោម ស ខេង បាន ថ្លែង បន្ត ទៀត ថា ថ្វីត្បិ តែ សម្ភារៈ ទាំងនេះ មិន ទាន់ គ្រប់ តម្រូវការ ក៏ ពិត មែន ប៉ុន្តែ វា ជា ទឹកចិត្ត ដ៏ ល្អ របស់ សប្បុរសជន ដែល ពួកគេ បាន ផ្តល់ឲ្យ ហើយ នឹង យក សម្ភារៈ ទាំងនេះ ទៅ ចែកជូន កងកម្លាំង និង មន្រ្តី ស៊ីវិល ដែល បម្រើការ នៅក្នុង ក្រសួង មហាផ្ទៃ និង នៅ តាម ខេត្ត បាត់ដំបង និង ខេត្ត ព្រៃវែង ដើម្បី ប្រើប្រាស់ សម្រាប់ កិច្ចការពារ និង ទប់ស្កាត់ នូវ មេរោគ កូវិដ១៩ ដែល ប្រទេស កម្ពុជា កំពុង បន្ត រីករាលដាល នោះ ។
លោក ស្រេង វង្ស ហៀង ទីប្រឹក្សា សម្តេច ក្រឡាហោម ស ខេង បាន លើកឡើង ថា ម៉ាស់ និង ប្រដាប់ លាង ដៃ នេះ ដែល លោក បាន រៃ អង្គាស ពី សប្បុរសធម៌ នានា នេះ គឺ ដើម្បី ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង កិច្ចការពារ និង ទប់ស្កាត់ នូវ មេរោគ កូវិដ១៩ ដែល ប្រទេស កម្ពុជា យើង ក៏ ដូចជា ពិភពលោក កំពុងតែ ប្រឈម នោះ ។
លោក ស្រេង វង្ស ហៀង បាន បន្ត ទៀត ថា លោក នឹង ខិតខំ រៃ អង្គាស់ ពី សប្បុរសធម៌ នានា ទៀត ដើម្បី បន្ត ជួយ ដល់ រាជ រដ្ឋាភិបាល តាមរយៈ ក្រសួង មហាផ្ទៃ ហើយ ការជួយ នេះ នឹង ប្រព្រឹត្ត ទៅ នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ផងដែរ ៕ លោក ជឺ អាន អភិបាល រង ស្រុក ត្បូងឃ្មុំ ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ចំនួន ១០ម៉ឺន រៀល ក្នុង មួយ ខែ រយៈពេល ៤ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ត្បូងឃ្មុំ ) ៖ លោក ជឺ អាន អភិបាល រង ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ១០ម៉ឺន រៀល ក្នុង មួយ ខែ រយៈពេល ៤ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែសីហា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ៕ អភិបាល ខេត្ត កំពង់ចាម ចុះ ពិនិត្យ តាម គោលដៅ ហាម ធ្វើដំណើរ អនុវត្ត បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ដើម្បី បង្ការ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា នៅ វេលា រំលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ រួម ដំណើរ ជាមួយ មន្ត្រី ពាក់ព័ន្ធ ចុះ ពិនិត្យ កងកម្លាំងប្រចាំ គោលដៅ សំខាន់ ៗ ក្នុង ការអនុវត្ត តាម បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ស្តីពី ការកំណត់ លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ដើម្បី បង្ការ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ដែល បាន អនុវត្ត ចាប់ពី ម៉ោង ២៤៖០០ ថ្ងៃទី ៩ ខែមេសា រហូតដល់ ម៉ោង ២៤៖០០ នាទី ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ ។
ក្នុង ដំណើរ ត្រួតពិនិត្យ កម្លាំង តាម គោលដៅ នីមួយ ៗ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន ផ្តាំផ្ញើ ដល់ កងកម្លាំង ទាំងអស់ ត្រូវ យក ចិតទុកដាក់ ក្នុង ការអនុវត្ត តាម បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត និង មាន ប្រសិទ្ធភាព ខ្ពស់ ផងដែរ ។
គួរ បញ្ជាក់ ថា ការចុះ ពិនិត្យ កម្លាំង ចេញ តាម គោលដៅ នា ឱកាស នោះ ត្រូវបាន ធ្វើឡើង នៅ តាម បណ្ដា គោលដៅ សំខាន់ ៗ មួយចំនួន មាន ដូច ជា៖
* គោលដៅ ផ្លូវ ព្រែក ក្តាម ជាប់ ព្រំប្រទល់ រវាង ខេត្ត កំពង់ចាម - ខេត្ត កណ្តាល * គោលដៅ ស្ពាន ទី២៥ ជាប់ ព្រំប្រទល់ រវាង ខេត្ត កំពង់ចាម - ខេត្ត កណ្តាល * ស្ពាន គីហ្សូណា ជាប់ ព្រំប្រទល់ ខេត្ត កំពង់ចាម - ខេត្ត ត្បូងឃ្មុំ ព្រមទាំង គោលដៅ ផ្សេង ៗ មួយចំនួន ផងដែរ ៕
អធិការ នគរបាល ក្រុង សួង ប្រកាស បរិច្ចាគ ថវិកា ៣សែន រៀល ៦ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ
( ត្បូងឃ្មុំ ) ៖ លោក វរសេនីយ៍ ឯក ឈន សុឆន អធិការ នគរបាល ក្រុង សួង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ត្បូងឃ្មុំ បាន ប្រកាស បរិច្ចាគ ថវិកា ចំនួន ៣០០.០០០ រៀល សម្រាប់ រយៈពេល ៦ខែ ចាប់ពី ខែមេសា ដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។
ជាមួយគ្នា នោះ អធិការ រង នគរបាល ក្រុង សួង នាយ ប៉ុស្ដិ៍ នគរបាល និង មន្ត្រី នគរបាល ទូទាំង ក្រុង សួង ចំនួន ៥១ នាក់ ទៀត ក៏ បាន ចូលរួម បរិច្ចាគ ប្រាក់ បៀវត្ស ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ផងដែរ ។
កិច្ចប្រជុំ ពេញ អង្គ នេះ ដឹកនាំ ដោយ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ដោយ មាន ការចូលរួម ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា រួមទាំង សមាជិក សភា សរុប ចំនួន ១១៥ នាក់ និង តំណាង រាជ រដ្ឋាភិបាល ផងដែរ ។
ដោយ មាន ការឡើង ការពារ ដោយ លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ថ្មី នៃ ក្រសួង យុត្តិធម៌ « សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន » ត្រូវបាន សមាជិក សភា ទាំងអស់ បោះឆ្នោត គាំទ្រ ក្រោម សំឡេង ១១៥ លើ ១១៥ សំឡេង ។
សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន មាន ចំនួន ៥ជំពូក និង ចែកចេញ ១២មាត្រា ។ សេចក្តីព្រាង ច្បាប់ នេះ ត្រូវបាន រៀបចំឡើង ដោយ ផ្អែក តាម ស្មារតី នៃ មាត្រា ២២ ថ្មី នៃ រដ្ឋធម្មនុញ្ញ របស់ កម្ពុជា ដែល ចែង ថា « នៅពេល ប្រជាជាតិ ប្រឈមមុខ នឹង គ្រោះថ្នាក់ ព្រះមហាក្សត្រ ទ្រង់ ប្រកាស ប្រទាន ដំណឹង ជាសាធារណៈ ដាក់ ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ក្រោយពី បាន មតិ ឯកភាព ពី នាយក រដ្ឋមន្ត្រី ប្រធាន រដ្ឋសភា និង ប្រធាន ព្រឹទ្ធសភា » ។
សេចក្តីព្រាង ច្បាប់ នេះ ក៏ ផ្តល់ ជា មូលដ្ឋាន គតិយុត្ត ដើម្បី ធានា ដល់ ការអនុវត្តមាត្រា ២២ ថ្មី នៃ រដ្ឋធម្មនុញ្ញ និង ជា មូលដ្ឋាន គតិយុត្ត កំណត់ សិទ្ធិ អំណាច របស់ រាជ រដ្ឋាភិបាល ក្នុង ការដាក់ចេញ នូវ វិធានការចាំបាច់ ដែល មិន អាច ខ្វះ បាន ដើម្បី ឆ្លើយតប ទៅនឹង ស្ថានភាព របស់ ប្រទេស ក្នុង ភាពអាសន្ន សំដៅ ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ ការពារ អាយុជីវិត និង សុខភាព របស់ ប្រជាពលរដ្ឋ ព្រមទាំង ការពាំរ ទ្រព្យសម្បត្តិ និង បរិស្ថាន ។
សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ក៏ នឹង កំណត់ នូវ បែបបទ នីតិវិធី និង លក្ខខណ្ឌ នៃ ការប្រកាស ដាក់ ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ព្រមទាំង វិធានការ ចាំបាច់ នានា ដែល រាជ រដ្ឋាភិបាល មាន សិទ្ធិ ដាក់ ចេញ ក្នុង ពេល ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ។
ការដាក់ ប្រទេសជាតិ ក្នុង ភាពអាសន្ន អាច ធ្វើឡើង នៅពេល ប្រជាជាតិ ប្រឈមមុខ នឹង គ្រោះថ្នាក់ ជា អាទិ៍ គ្រោះថ្នាក់ ដែល បង្កឡើង ដោយ សង្គ្រាម ឬ ការឈ្លាន ពាន ពី កម្លាំង បរទេស គ្រោះអាសន្ន បន្ទាន់ ចំពោះ សុខភាព សាធារណៈ បណ្តាល មកពី ការឆ្លង រាលដាល នៃ ជំងឺ ភាពវឹកវរ ធ្ងន់ធ្ងរ ដល់ សន្តិសុខ ជាតិ និង សណ្តាប់ធ្នាប់ សាធារណៈ ព្រមទាំង គ្រោះមហន្តរាយ ធ្ងន់ធ្ងរ ដែល គំរាមកំហែង ឬ អាច បង្ក គ្រោះថ្នាក់ រីករាលដាល ដល់ កម្រិត ទូទាំង ប្រទេស ។
ក្នុង សេចក្តីព្រាង ច្បាប់ ត្រង់ មាត្រា ៤ ជំពូក ទី៣ បាន កំណត់ ថា នៅពេល ប្រទេស ជាតិ ត្រូវបាន ប្រកាស ដាក់ ស្ថិត នៅក្នុង ភាពអាសន្ន រាជ រដ្ឋាភិបាល មាន សិទ្ធិ ដាក់ ចេញ វិធាន ដូច ខាងក្រោម៖
រីឯ នីតិបុគ្គល ដែល ប្រព្រឹត្ត អំពើ ដោយ ចេតនា មិន គោរព វិធានការ ដាក់ចេញ ដោយ រាជ រដ្ឋាភិបាល ដែល មាន ចែង ក្នុង មាត្រា ៥ ត្រូវ ទទួលខុសត្រូវ ព្រហ្មទណ្ឌ ដូច មាន ចែង ក្នុង មាត្រា ៤២ ( ការទទួលខុសត្រូវ ព្រហ្មទណ្ឌ របស់ នីតិបុគ្គល ) នៃ ក្រម ព្រហ្មទណ្ឌ ដោយ ត្រូវ ផ្តន្ទាទោស ពិន័យ ជា ប្រាក់ ពី ៥០ លាន រៀល ដល់ ៥០០ លាន រៀល ព្រមទាំង ទោស បន្ថែម មួយ ឬ ច្រើន ដូច មាន ចែង ក្នុង មាត្រា ១៦៨ ( ទោស បន្ថែម អនុវត្ត ចំពោះ នីតិបុគ្គល ) នៃ ក្រម ព្រហ្មទណ្ណ ៕
សេចក្តីសម្រេច នេះ ត្រូវបាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ដ៏ បន្ទាន់ មួយ នៅក្នុង ទីក្រុង ព្រុច សែល ដែល ជា ទីស្នាក់ការ កណ្តាល របស់ សហភាព អឺរ៉ុប ។ កិច្ចប្រជុំ នោះ ត្រូវបាន ធ្វើឡើង ក្រោយពី នាយក រដ្ឋមន្ត្រី ប្រទេស អេស្ប៉ាញ បាន ប្រកាស ថា ប្រទេស អឺរ៉ុប មួយ នេះ ជិត ឈានដល់ ចំណុច កំពូល ដ៏ អាក្រក់ បំផុត នៃ ការឆ្លង និង ស្លាប់ ដោយសារតែ ជំងឺ COVID-19 ហើយ ។
គួរ បញ្ជាក់ ថា មេដឹកនាំ សហរដ្ឋ អាមេរិក រុស្ស៊ី និង អារ៉ាប៊ី សាអូឌីត បាន សម្រេច ដូច ខាងលើ នេះ ក្រោយ ការជួប ពិភាក្សា គ្នា តាម ទូរស័ព្ទ កាលពី ថ្ងៃព្រហស្បតិ៍ និង ត្រូវបាន ប្រកាស ចេញ ដោយ វិមាន រដ្ឋាភិបាល រុស្ស៊ី នៅ ព្រឹក ថ្ងៃសុក្រ នេះ តែម្តង ។ មេដឹកនាំ ទាំង បី ប្រទេស ក៏ បាន ព្រមព្រៀង គ្នា ផងដែរ ក្នុង ការបង្កើត កិច្ចប្រជុំ ពិសេស អូប៉ិច បូក (OPEC+) ក៏ ដូចជា ការជួប ពិភាក្សា គ្នា ថ្នាក់ រដ្ឋមន្ត្រី ថាមពល នៃ បណ្តា ប្រទេស G20 តាម វីដេអូ ខុន ហ្វឺរិន នៅក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ៕
គណៈកម្មាធិការ អន្តរជាតិ នៃ កាកបាទ ក្រហម ឧបត្ថម្ភ សម្ភារ អនាម័យ ២០តោន ដល់ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ដើម្បី បង្ការ ជំងឺ កូវីដ១៩ ក្នុង ពន្ធនាគារ
( ភ្នំពេញ )៖ គណៈកម្មាធិការ អន្តរជាតិ នៃ កាកបាទ ក្រហម ប្រចាំ ប្រទេស កម្ពុជា (ICRC) បាន ប្រគល់ សម្ភារ អនាម័យ ចំនួន ២០តោន ជូន អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ដើម្បី បង្កា ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ពន្ធនាគារ នៅឯ មណ្ឌល អប់រំ កែប្រែ ទី១ ( ម១) ។
ពី ប្រគល់ និង ទទួលបាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ ដោយ មាន ការចូលរួម ពី លោក រ៉ូម៉ាន៍ ប៉ារ៉ាម៉ូណូវ ប្រធាន បេសកកម្ម ICRC ប្រចាំ ប្រទេស កម្ពុជា . នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត ចាន់ គីម សេង អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ . និង លោក នុត សាវនា អ្នកនាំពាក្យ នៃ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ។
គោលបំណង នៃ ការឧបត្ថម្ភ សម្ភារៈ ទាំងនេះ គឺ ក្នុង ន័យ គាំទ្រ និង ចូលរួម បំពេញ បន្ថែម នូវ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ក្នុង ការបង្កា ទប់ស្កាត់ និង ការគ្រប់គ្រង ការរាតត្បាត នៃ ជំងឺ ខូវីដ១៩ នៅ តាម មណ្ឌល អប់រំ កែប្រែ និង ពន្ធនាគារ រាជធានី ខេត្ត ។ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ទទួលបន្ទុក ក្នុង ការគ្រប់គ្រង និង បែងចែក សម្ភារ ទាំង នេះ ។
លោក រ៉ូម៉ាន៍ ប៉ារ៉ាម៉ូណូវ បាន ថ្លែង ថា ជំងឺ រាលដាល កូវីដ១៩ កំពុងតែ បន្ត ផ្ដល់ នូវ ផល ប៉ះពាល់ យ៉ាង ខ្លាំង ជុំវិញ សកលលោក ។ ខណៈ ដែល ការអនុវត្ត គម្លាត សង្គម និង ការសម្អាត ដៃ កំពុងតែ ត្រូវបាន អនុវត្តន៍ ពី សាធារណៈ ជន ទូទៅ ប៉ុន្តែ ចំណុច ទាំង ប៉ុន្មាន នេះ គេ អាច ចាត់ទុក បាន ថា ជា រឿង ដែល ប្រណីត បំផុត នៅក្នុង ពន្ធនាគារ ។ យ៉ាងណាមិញ ការអនុវត្ត របស់ ជនជាប់ ឃុំ បាន បង្ហាញ ឲ្យ ឃើញ នូវ កត្តា ប្រឈម មួយ បែប ទៀត គឺ ការប្រឈមមុខ នឹង កង្វះ ខ្យល់ អនាម័យ និង ភាពចង្អៀត ណែន ក្នុង ពន្ធនាគារ ។
ICRC ក៏ ប្រាកដ ថា មណ្ឌល ស្ដារ លទ្ធភាព ពលកម្ម កាយសម្បទា ក្នុង ខេត្ត បាត់ដំបង និង កំពង់ស្ពឺ និង នៅតែ មាន ប្រតិបត្តិការ ដដែល ។ ជាង នេះ ទៅ ទៀត កិច្ច គាំទ្រ ជាមួយ សមាគម ជាតិ កាកបាទ ក្រហម ក្នុង ការលើកកម្ពស់ ការយល់ដឹង អំពី អនាម័យ សុខភាព និង វិធីសាស្រ្ត សុវត្ថិភាព ដើម្បី ទប់ស្កាត់ ការរីករាល នៃ ជំងឺ កូវីដ១៩ នៅក្នុង ខេត្ត ទាំង ១៣ ដែល ទទួលរង ផល ប៉ះពាល់ ពី ជំងឺ នេះ ៕
សម្ដេច ក្រឡាហោម ស ខេង បញ្ជា អភិបាល រាជធានី - ខេត្ត អនុវត្ត បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ឲ្យបាន ម៉ឺងម៉ាត់ ចំពោះ ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ដើម្បី ទប់ស្កាត់ ការឆ្លង ជំងឺ COVID-19
( ភ្នំពេញ ) ៖ សម្ដេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ដាក់ បទបញ្ជា ដល់ អភិបាល រាជធានី - ខេត្ត និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល រាជធានី - ខេត្ត ត្រូវ អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ នូវ បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ស្ដីពី ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ក្នុង គោលដៅ បង្ការ និង ទប់ស្កាត់ ការរាតត្បាត នៃ ជំងឺ COVID-19 ។
ក្នុង សេចក្ដីណែនាំ ដែល ផ្ញើ ទៅកាន់ អភិបាល រាជធានី - ខេត្ត សម្ដេច ក្រឡាហោម ស ខេង បាន គូសបញ្ជាក់ ថា ក្នុង ការអនុវត្ត នូវ បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល រាជធានី - ខេត្ត ត្រូវ ខិតខំ សម្របសម្រួល ដោះស្រាយ និង បញ្ចៀស ឲ្យបាន នូវ អំពើហិង្សា គ្រប់ រូបភាព ។
( ប៉ៃលិន ) ៖ ក្នុង កិច្ចប្រជុំ គណៈកម្មការ ប្រយុទ្ធ នឹង ជំងឺ COVID-19 ខេត្ត នា ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន បាន ជំរុញ និង ដាក់ចេញ នូវ វិធានការ យ៉ាង ម៉ឺងម៉ាត់ ដល់ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ ជាន់ ថ្នាក់ ត្រូវ គ្រប់គ្រង ពលករ ដែល ទើប ត្រលប់ មកពី ក្រៅ ប្រទេស ឲ្យបាន ច្បាស់លាស់ ជាពិសេស ត្រូវ អប់រំ ណែនាំ និង តាមដាន សុខភាព របស់ ពួកគាត់ ឲ្យបាន ជាប្រចាំ ។
លើស ពី នោះ ទៀត ត្រូវ បន្ត យុទ្ធនាការចុះ ផ្សព្វផ្សាយ នៅ តាម មូលដ្ឋាន ចាប់ពី ប្រជុំជន រហូតដល់ ជនបទ ខណៈ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ សែន បាន ចេញ សេចក្តីប្រកាស ឲ្យ ផ្អាក ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ ឆ្នាំ ជូត ទោស័ក ព .ស ២៥៦៣ និង មន្ត្រីរាជការ មិន អនុញ្ញាតឱ្យ ឈប់ សម្រាក នោះ ទេ ដើម្បី រួមគ្នា បង្ការ និង ទប់ស្កាត់ ការ រីករាលដាល នៃ ជំងឺ COVID-19 នៅក្នុង ប្រទេស កម្ពុជា ស្រប ពេល ដែល ពិភពលោក មាន អ្នក កើត ជំងឺ និង ស្លាប់ ដោយសារ វីរុស នេះ រាប់ ម៉ឺន នាក់ ។
សូម បញ្ជាក់ ថា ចាប់ពី ថ្ងៃទី ២២ ខែមីនា រហូតដល់ ថ្ងៃទី ០៨ ខែមេសា ឆ្នាំ ២០២០ នៅ ខេត្ត ប៉ៃលិន មាន ពលករ ទើប ត្រលប់ មកពី ក្រៅ ប្រទេស សរុប ចំនួន ៩០៧ នាក់ ស្រី ៤៣៤ នាក់ ដោយ ក្នុង នោះ ក្រុង ប៉ៃលិន ចំនួន ៣៨០ នាក់ ស្រី ១៨៧ នាក់ និង ស្រុក សាលា ក្រៅ ចំនួន ៥២៧ នាក់ ស្រី ២៤៧ នាក់ ៕ ក្រសួង ការពារ ជាតិ ផ្សព្វផ្សាយ បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ស្តីពី « ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ក្នុង គោលដៅ បង្ការ និង ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ »
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សំ វណ្ណ ថន អគ្គ លេខាធិការ ក្រសួង ការពារ ជាតិ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ប្រជុំ ផ្សព្វផ្សាយ អនុក្រឹត្យ ស្តីពី ការលើក ការឈប់ សម្រាក ការងារ របស់ មន្ត្រី រាការ និយោជិក កម្មករ និង បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ស្តីពី ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ក្នុង គោលដៅ បង្ការ និង ទប់ស្កាត់ នៃ ជំងឺ កូវីដ - ១៩ ដល់ នាយ ទាហាន នៃ កងយោធពល ខេមរភូមិន្ទ ។
នាយ ឧត្តមសេនីយ៍ សំ វណ្ណ ថន បាន ថ្លែង ថា អនុក្រឹត្យ ស្តីពី ការលើក ការឈប់ សម្រាក ការងារ និង បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល លើ ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ដែល បាន ចេញ នា ពេល ថ្មី ៗ នេះ ក្នុង គោលបំណង ការពារ អាយុជីវិត របស់ យើង ទាំងអស់ គ្នា ទប់ស្កាត់ ការរាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ នៅក្នុកា លៈទេសៈ ពិសេស នា បច្ចុប្បន្ន មិន ឱ្យ ជំងឺ នេះ រាលដាល ឈាន ចេញ ពី ដំណាក់កាល នៃ ការឆ្លង ដោយសារ ការនាំចូល ពី ប្រភព ខាងក្រៅ ទៅដល់ ដំណាក់កាល នៃ ការឆ្លង រាលដាល រវាង ប្រជាជន ក្នុង សហគមន៍ នៅក្នុង ប្រទេស ។
នាយ ឧត្តមសេនីយ៍ សំ វណ្ណ ថន បាន បញ្ជាក់ ថា សព្វ ថ្ងៃ នេះ ជំងឺ កូវីដ - ១៩ បាន រាតត្បាត យ៉ាង ខ្លាំង នៅ លោ ពិភពលោក មិន ថា ប្រទេស អ្នក មាន ប្រទេស ក្រីក្រ ឬ ក៏ សម្បុស ខ្មៅ - ស នោះ ទេ ហើយក៏ មិន អាច សណ្ឋាន បាន ថា វា ចប់ នៅ ពេលណា នោះ ដែរ ។ រហូមកដល់ ពេលនេះ ថ្នាំ និង វ៉ាក់សាំង ការពារ ក៏ មិន ទាន់ រកឃើញ នៅឡើយ ទេ ដូចនេះ យើង ត្រូវ មាន ការប្រុងប្រយ័ត្ន អនុវត្ត ឱ្យ បាន ម៉ឺងម៉ាត់ និង ផ្សព្វផ្សាយ បន្ត ព្រមទាំង ថែរក្សា សុខភាព ឱ្យ បាន ល្អ ទាំងអស់ គ្នា ។
( ភ្នំពេញ ) ៖ លោក កៅ អ៉ីម រ៉ន អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៥០ ម៉ឺន រៀល ក្នុង មួយ ខែ រយៈពេល ៤ខែ គិត ចាប់ពី ខែមិថុនា ដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០៕ ត្រីមាស ទី១ ឆ្នាំ នេះ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ទទួលបាន ថវិកា បរិច្ចាគ ជាង ១. ៥លាន ដុល្លារ សម្រាប់ ទ្រទ្រង់ មន្ទីរពេទ្យ គន្ធ បុប្ផា !
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន ឲ្យដឹង ទៀត ថា ក្នុង ត្រីមាស ទី១នេះ មូលនិធិ បាន ផ្ទេរ ថវិកា ចំនួន ១. ០៨៦. ៣៦៨ ដុល្លារ អាមេរិក ទៅ មន្ទីរពេទ្យ គន្ធ បុប្ផា ដើម្បី បន្ត គាំទ្រ ការពិនិត្យ ព្យាបាល ដោយ ឥត គិត ថ្លៃ ដល់ កុមារ កម្ពុជា ។
ទី២៖ សម្រេច លុបចេញ នូវ ការហាមឃាត់ ការធ្វើដំណើរ ឆ្លងកាត់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ ទៀត នៅក្នុង ខេត្ត តែ មួយ ដោយ រក្សាទុក ជាធរមាន នូវ ការហាមឃាត់ ការធ្វើដំណើរ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត ។
ខាងក្រោម ជា សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល ដែល បណ្តាញ ព័ត៌មាន Fresh News ទើប ទទួលបាន មុន នេះ នា ថ្ងៃត្រង់ ទី១០ ខែមេសា ឆ្នាំ ២០២០៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ សាកលវិទ្យាល័យ ភូមិន្ទ នីតិសាស្ត្រ និង វិទ្យាសាស្ត្រ សេដ្ឋកិច្ច ឧបត្ថម្ភ ថវិកា ២៥.០០០ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា
ថ្លែង នា ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង / ស្រុក កងកម្លាំង និង អ្នក ពាក់ព័ន្ធ គ្រប់ លំដាប់ថ្នាក់ ដែល ខិតខំ ប្រឹងប្រែង រួម សហការ គ្នា ថែរក្សា សុខ សុវត្ថិភាព និង បាន ធ្វើ ការចុះ ផ្សព្វផ្សាយ ដល់ ខ្នង ផ្ទះ ប្រជាពលរដ្ឋ អំពី បញ្ហា សុខភាព និង ទប់ស្កាត់ ឲ្យបាន នូវ ការរីករាលដាល ចម្លង បន្ត នៃ ជំងឺ កូវីដ - ១៩ ទៅក្នុង សហគមន៍ មូលដ្ឋាន របស់ ខេត្ត ត្បូងឃ្មុំ ។
លោក អភិបាល ខេត្ត បាន មានប្រសាសន៍ ថា ការបង្កើត ក្រុមការងារ ចល័ត ពិសេស ត្រួតពិនិត្យ លើ ការងារ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ចរាចរណ៍ ផ្លូវគោក និង ការដឹកជញ្ជូន លើស ទម្ងន់ កម្រិត កំណត់ របស់ ខេត្ត ត្បូងឃ្មុំ ដោយ ត្រូវ អនុវត្ត វិធានការ ច្បាប់ ទៅ លើ ជនល្មើស ចរាចរណ៍ ផ្លូវគោក ដោយ ឈរ លើ អង្គការ តម្លាភាព គណនេយ្យភាព សមភាព និង គ្មាន ការរើសអើង ។
លោល បន្ថែម ថា មន្ត្រី ជំនាញ ត្រូវ ត្រួតពិនិត្យ និង តាមដាន បាតុភាព មិន ប្រក្រតី នៅ តាម មូលដ្ឋាន មិន ព្រម ចូលរួម អនុវត្ត តាម ច្បាប់ ចរាចរណ៍ ត្រូវ ធ្វើ ការអប់រំ ណែនាំ តាម គ្រប់ មធ្យោបាយ សំដៅ កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ឲ្យបាន ជា អតិបរមា ។
លោល អភិបាល ខេត្ត បាន សំណូមពរ អោយ អ្នក អនុវត្ត ច្បាប់ ត្រូវ ចូលរួម អនុវត្ត ប្រកបដោយ ប្រសិទ្ធភាព និង សម្រេច រាល់ ភារកិច្ច ដែល គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ក្រុង ស្រុក បាន ដាក់ចេញ តាម គោលការណ៍ ផែនការ កាតព្វកិច្ច ភារកិច្ច តាម គោលដៅ រៀង ៗ ខ្លួន គឺ ដាច់ខាត ត្រូវ ធ្វើឲ្យ ខាន តែ បាន ស្រប ទៅនឹង គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
( ភ្នំពេញ ) ៖ កម្លាំង សមត្ថកិច្ច របស់ គណៈម្មាធិការ ប្រយុទ្ធ ប្រឆាំង ផលិតផល ក្លែងក្លាយ ( គ. ប. ផ. ក) នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ បាន ចុះបង្ក្រាប ផលិតផល នាំចូល ស្តុក ទុក និង ចែកចាយ ខុស ច្បាប់ នៅ សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ ដោយ មាន ការសម្របសម្រួល ដោយ លោក សាយ ណូរ៉ា ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ និង មាន ការចូលរួម ពី សមត្ថកិច្ច ពាក់ព័ន្ធ អាជ្ញាធរដែនដី មន្ត្រី សុខាភិបាល ខណ្ឌ និង មន្ត្រី កាំ កុងត្រូល នៃ ក្រសួង ពាណិជ្ជកម្ម ។
ការ ចុះ ត្រួតពិនិត្យ នេះ គណៈកម្មាធិការ អន្តរ ក្រសួង របស់ គ. ប. ផ. ក បាន រកឃើញ ផលិតផល ខុស ច្បាប់ ជាច្រើន មុខ សរុប ចំនួន ជាង ២. ០០០កេស ស្មើនឹង ប្រមាណ ១៣តោន ( សារធាតុ សម្លាប់ មេរោគ ម៉ាស់ និង គ្រឿង សម្អាង ) ដូច មាន ខាងក្រោម៖
បន្ទាប់ពី បាន ត្រួតពិនិត្យ ផលិតផល ទំាង នេះ សមត្ថកិច្ច ចម្រុះ បាន ពិនិត្យ និង សន្និដ្ឋាន បឋម ទី តំាង នាំចូល ស្តុក ទុក និង ចែកចាយ ខាងលើ មិន អនុលោម តាម ច្បាប់ កំណត់ ដូច ជា៖
ក្រោយពី បាន ពិនិត្យ និង ការសន្និដ្ឋាន ខាងលើ សមត្ថកិច្ច ចម្រុះ សម្រេច ផ្អាក អជីវកម្ម បណ្តោះអាសន្ន ហើយ ផលិតផល ទាំងនេះ ឃាត់ រក្សាទុក នៅ ទីតាំង ដដែល និង ដកហូត វត្ថុតាង មួយចំនួន យក ទៅ ធ្វើ ការពិសោន៍ និង សមត្ថកិច្ច ចម្រុះ គ. ប. ផ. ក កំពុង បាន បន្ត នីតិវិធី ចាត់ វិធានការ តាម ច្បាប់ ។
អភិបាល ខេត្ត និង មន្ទីរ សុខាភិបាល ខេត្ត មណ្ឌលគិរី ច្រានចោល និង អំពាវនាវ ពលរដ្ឋ កុំ ភ័យខ្លាច ពាក្យ ចចាមអារ៉ាម ថា មាន អ្នក ផ្ទុក វីរុស COVID-19 កំពុង ស្នាក់ នៅក្នុង ខេត្ត
( មណ្ឌលគិរី ) ៖ អភិបាល ខេត្ត មណ្ឌលគិរី លោក ស្វាយ សំអ៊ាង នៅ ព្រឹក ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស ច្រានចោល រាល់ សម្តី ក្រុម អគតិ ដែល និយាយ បំពុល បំប៉ោង ជា ព័ត៌មាន ថា ខេត្ត មណ្ឌលគិរី មាន អ្នក ឆ្លង កូវីដ១៩ ជាង ១០នាក់ បង្កឱ្យ មាន ភាពភ័យខ្លាច ដល់ ពលរដ្ឋ ។
លោក អភិបាល ខេត្ត បាន ប្រាប់ ពលរដ្ឋ នៅក្នុង ខេត្ត ថា « សូម កុំ ឲ្យ មាន ការ ភិតភ័យ ដោយសារ ការផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ធ្វើឲ្យ ប្រជាពលរដ្ឋ មាន ភាពជ្រួលច្របល់ ភ័យខ្លាច ហើយ ករណី នេះ លោក កំពុង បញ្ជា ឲ្យ ខាង នគរបាល ជំនាញ កោះហៅ អ្នកសារព័ត៌មាន នោះ នៅ ខេត្ត មណ្ឌលគិរី ធ្វើ ការសួរនាំ » ។
ជាង នេះ ទៅ ទៀត លោក អភិបាល ខេត្ត បាន បន្ត ទៀត ថា ដើម្បី ចូលរួម ទប់ស្កាត់ ការរីករាលដាល មេរោគ កូវីដ១៩ ឲ្យបាន ល្អ ប្រសើរ ខេត្ត មណ្ឌលគិរី បាន ដាក់ កន្លែង ត្រួតពិនិត្យ ចំនួន ៥ គោលដៅ ២ គោលដៅ នៅ ព្រំប្រទាល់ ខេត្ត ក្រចេះ និង ខេត្ត រតនគិរី និង ៣ គោលដៅ ខេត្ត គឺ ជុំវិញ ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគិរី ។
តាមរយៈ សេចក្តីប្រកាស ព័ត៌មាន នេះ ដែរ បាន ឱ្យដឹង ថា ករណី បង្ហោះ សារជា សំលេង នេះ បាន បង្កឱ្យ មាន ការភ័យខ្លាច ដល់ ប្រជាពលរដ្ឋ និង មន្ត្រីរាជការ នៅក្នុង ខេត្ត ហើយ ករណី នេះ មន្ទីរ សុខាភិបាល ខេត្ត កំពុង ធ្វើ ការស្រាវជ្រាវ ដល់ អ្នក ប៉ះពាល់ ឬ ប្រាស្រ័យទាក់ទង ដោយ ផ្ទាល់ ជាមួយ អ្នកជំងឺ ដែល ឱ្យ ពួកគាត់ មក ពិនិត្យ សុខភាព រក មេរោគ COVID-19 ដើម្បី ការការពារ ទប់ស្កាត់ ឱ្យ បាន ទាន់ ពេល វេលា ។
មន្ទីរ សុខាភិបាល ខេត្ត មណ្ឌលគិរី បាន បញ្ជាក់ ថា មកដល់ ពេលនេះ មន្ត្រី ជំនាញ ក្រុម ឆ្លើយតប បន្ទាន់ មន្ទីរ សុខាភិបាល ខេត្ត បាន ពិនិត្យ លើ អ្នក ពាក់ព័ន្ធ ពុំ ទាន់ រកឃើញ បុគ្គល ណាមួយ សង្ស័យ ថា ឆ្លង ឬ មាន រោគសញ្ញា ដូច ក្នុង និយមន័យ ជំងឺ COVID-19 នៅឡើយ ទេ ។ ក្នុង ពេលនេះ ដែរ មន្ត្រី ជំនាញ ក្រុម ឆ្លើយតប បន្ទាន់ មន្ទីរ សុខាភិបាល ខេត្ត មណ្ឌលគិរី កំពុង ខិតខំ ប្រឹងប្រែង ធ្វើការត្រួតពិនិត្យ បន្ត ទៀត ឱ្យ អស់ ពី លទ្ធភាព និង ភាពហ្មត់ចត់ បំផុត ។
ទន្ទឹមនឹង នេះ ដែរ មន្ទីរ សុខាភិបាល ខេត្ត មណ្ឌលគិរី បាន អំពាវនាវ ប្រជាពលរដ្ឋ ទាំងអស់ កុំ មាន ការភ័យខ្លាច ក៏ប៉ុន្តែ សូម ស្នើ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវា មាន ការប្រុងប្រយ័ត្ន ដោយ មាន ការធ្វើ អនាម័យ ជាប្រចាំ ដូច ជា៖ ពាក់ ម៉ាស់ លាង ដៃ នឹង សាប៊ូ ឬ ជែល ឱ្យ បាន ញឹកញាប់ កាត់បន្ថយ ការជួបជុំគ្នា ផ្សេង ៗ ។ល ៕
( ភ្នំពេញ ) ៖ លោក ប៉ែន ប្រាកដ ទីប្រឹក្សា សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស រំលែក ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ២០០.០០០ រៀល ក្នុង ១ខែ សម្រាប់ រយៈពេល ៥ខែ ចាប់ពី ខែមេសា ដល់ ខែសីហា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
( ភ្នំពេញ ) ៖ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ បាន អំពាវនាវ ដល់ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ និង ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម ឱ្យ បាន ម៉ឺងម៉ាត់ ក្នុង ការអនុវត្ត បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល អំពី ការដាក់កំហិត ការធ្វើដំណើរ ចេញ ចូល និង ឆ្លងកាត់ រាជធានី ភ្នំពេញ ការឆ្លងកាត់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ និង ការធ្វើដំណើរ ពី ខេត្ត ទៅ ខេត្ត មួយ ទៀត ដើម្បី ការពារ ការរីករាលដាល នៃ មេរោគ COVID-19 ។
ការអំពាវនាវ បែប នេះ របស់ សម្តេច ពិជ័យ សេនា ទៀ បាញ់ បាន ធ្វើឡើង បន្ទាប់ពី ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៩ ខែមេសា បាន ចេញ បទបញ្ជា ឱ្យ អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ បិទ ការធ្វើដំណើរ ក្នុង ប្រទេស ពី រាជធានី ភ្នំពេញ ទៅកាន់ បណ្ដា ខេត្ត . ការធ្វើដំណើរ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ និង ពី ស្រុក មួយ ទៅ ស្រុក មួយ ដោយ ចាប់ អនុវត្ត ពី ម៉ោង ២៤៖០០ នាទី ថ្ងៃទី ០៩ រហូតដល់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ ។
គួរ ជម្រាប ថា បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ហាមឃាត់ ការធ្វើដំណើរ នៅ ផ្ទៃក្នុង ប្រទេស រួម មាន ការធ្វើដំណើរ ឆ្លងកាត់ ចេញ - ចូល រាជធានី ភ្នំពេញ ( ដោយ មិន ប៉ះពាល់ ដល់ ការធ្វើដំណើរ ផ្ទៃក្នុង រាជធានី ភ្នំពេញ នោះ ទេ ) ការធ្វើដំណើរ ឆ្លងកាត់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ និង ការធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត ។
ប៉ុន្តែ ទោះបីជា យ៉ាងណា ការហាមឃាត់ នេះ ត្រូវបាន លើកលែង ចំពោះ
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក នឹម មាលា នាយក វិទ្យាស្ថាន វិទ្យាសាស្ត្រ សុខាភិបាល នៃ កងយោធពល ខេមរភូមិន្ទ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ១លាន រៀល ក្នុង ១ខែ សម្រាប់ រយៈពេល ៦ខែ ចាប់ពី ខែឧសភា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
អភិបាល ខេត្ត កំពង់ធំ ចុះ ត្រួតពិនិត្យ ការអនុវត្ត បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ដែល ដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ដើម្បី ទប់ស្កាត់ COVID-19
( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន ដឹកនាំ កម្លាំង ចម្រុះ ចុះ តាម គោលដៅ នៃ ក្រុង - ស្រុក នីមួយ ៗ តាម បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ដោយ ហាមឃាត់ ការធ្វើដំណើរ នៅក្នុង ផ្ទៃ ប្រទេស រួម មាន ការធ្វើដំណើរ ឆ្លងកាត់ ចេញ - ចូល រាជធានី ភ្នំពេញ ការធ្វើដំណើរ ឆ្លងកាត់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ និង ការធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត ។
ការ ចុះ ត្រួតពិនិត្យ នេះ ធ្វើឡើង នា វេលា រំលង អធ្រាត្រ ថ្ងៃទី ០៩ ឈានចូល ដល់ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ ខណៈ ការដាក់ បទបញ្ជា នេះ គឺ ធ្វើឡើង ក្នុង គោលបំណង ទប់ស្កាត់ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ នៅក្នុង កាលៈទេសៈ ពិសេស នា បច្ចុប្បន្ន ដោយ ការនាំចូល ពី ប្រភព ខាងក្រៅ ដល់ ដំណាក់កាល នៃ ការឆ្លង ដល់ ប្រជាជន ក្នុង សហគមន៍ នៅក្នុង ប្រទេស ។
គួរ បញ្ជាក់ ផងដែរ ថា ខេត្ត កំពង់ធំ មាន ៩ក្រុង - ស្រុក
រដ្ឋមន្ត្រី ក្រសួង អប់រំ ស្នើឲ្យ បុគ្គលិក អប់រំ និង សិស្សានុសិស្ស អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត នូវ សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល កុំ ធ្វើដំណើរ ឆ្លង ស្រុក និង ខេត្ត ដើម្បី កាត់ផ្តាច់ការឆ្លង កូវីដ១៩
( ភ្នំពេញ ) ៖ បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន អំពាវនាវ ដល់ បុគ្គលិក អប់រំ ទាំងអស់ និង សិស្សានុសិស្ស សូម អនុវត្ត ឲ្យបាន ម៉ឺងម៉ាត់ បំផុត នូវ សេចក្តីណែនាំ របស់ រាជ រដ្ឋាភិបាល កុំ ធ្វើដំណើរ ឆ្លង ស្រុក និង ខេត្ត ដើម្បី ចូលរួម កាត់ផ្តាច់ការឆ្លង កូវីដ១៩ ។
សូម បុគ្គលិក អប់រំ សិស្សានុសិស្ស មាតាបិតា និង អ្នកអាណាព្យាបាល ជឿជាក់ លើ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី យក ជ័យជម្នះ លើ មេរោគ កូវីដ១៩ ។ សូមឲ្យ ទេវតា ឆ្នាំ ថ្មី នាំមក នូវ សុខភាព ល្អ និង សុវត្ថិភាព ផ្លូវការយ និង ផ្លូវចិត្ត ដល់ បុគ្គលិក អប់រំ សិស្សានុសិស្ស និង មាតាបិតា អ្នកអាណាព្យាបាល ទាំងអស់ ។ ប្រសិនបើ យើង មិន ផ្លាស់ប្តូរ ទម្លាប់ កូវីដ នឹង ផ្លាស់ប្តូរ យើង » ។
សេចក្តីសម្រេច នេះ ត្រូវបាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ដ៏ បន្ទាន់ មួយ នៅក្នុង ទីក្រុង ព្រុច សែល ដែល ជា ទីស្នាក់ការ កណ្តាល របស់ សហភាព អឺរ៉ុប ។ កិច្ចប្រជុំ នោះ ត្រូវបាន ធ្វើឡើង ក្រោយពី នាយក រដ្ឋមន្ត្រី ប្រទេស អេស្ប៉ាញ បាន ប្រកាស ថា ប្រទេស អឺរ៉ុប មួយ នេះ ជិត ឈានដល់ ចំណុច កំពូល ដ៏ អាក្រក់ បំផុត នៃ ការឆ្លង និង ស្លាប់ ដោយសារតែ ជំងឺ COVID-19 ហើយ ៕
គួរ ជម្រាប ថា ការកើនឡើង ជាថ្មី នៃ ចំនួន អ្នកស្លាប់ ប្រចាំ ថ្ងៃ ដោយសារ COVID-19 ខាងលើ គឺជា តួលេខ ខ្ពស់ បំផុត មួយ ចាប់តាំងពី ថ្ងៃទី ០៥ ខែមេសា មក ហើយ វា កើត មាន ឡើង បន្ទាប់ពី រដ្ឋាភិបាល អ៉ីតាលី ប្រកាស ពី គម្រោង បន្ធូរបន្ថយ វិធានការរឹតត្បិត បន្តិច ម្ដង ៗ នៅក្នុង ករណី ដែល ស្ថានភាព បច្ចុប្បន្ន កាន់តែ មាន ភាពប្រសើរឡើង ៕
* បុរស ជនជាតិ ខ្មែរ អាយុ ៥៩ ឆ្នាំ នៅ ភូមិ រ៉ែន ក្រោម ឃុំ ស្វាយ ប្រទាល ស្រុក ស្អាង ខេត្ត កណ្តាល ទទួល លទ្ធផល តេស្ត អវិជ្ជមាន ២លើក អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ខេត្ត កណ្តាល ។ បុរស នេះ ដែល បាន ប៉ះពាល់ ផ្ទាល់ ជាមួយ បុរស អាយុ ៦០ ឆ្នាំ ដែល វិលត្រឡប់ បី ពិធី សាសនា នៅ ប្រទេស ម៉ាឡេស៊ី ។
* បុរស ជនជាតិ ខ្មែរ អាយុ ៤៥ ឆ្នាំ នៅ ស្រុក កង មាស ខេត្ត កំពង់ចាម ទទួលបាន លទ្ធផល តេស្ត អវិជ្ជមាន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ខេត្ត កំពង់ចាម ។ បុរស នេះ ជា កម្មករ សម្អាតិ ព្រះវិហារ ឥស្លាម និង ជា អ្នក ប៉ះពាល់ ជាមួយ ជនជាតិ ម៉ាឡេស៊ី ។
* បុរស ជនជាតិ ខ្មែរ អាយុ ៣៥ ឆ្នាំ នៅ ក្រុង ព្រះវិហារ ទទួលបាន លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ខេត្ត ព្រះវិហារ ។ បុរស រូប នេះ ជា អ្នក ត្រឡប់ មកពី ពិធី សាសនា នៅ ម៉ាឡេស៊ី ។
* បុរស ជនជាតិ ម៉ាឡេស៊ី អាយុ ៥៨ ឆ្នាំ ស្នាក់ នៅ បណ្តោះអាសន្ន នៅ ក្រុង កែប ទទួល លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន ២លើក ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ ខេត្ត កែប ។ បុរស នេះ មក ធ្វើ ការងារ សាសនា នៅ កម្ពុជា ។
ចំពោះ ការរកឃើញ ករណី ថ្មី ម្នាក់ គឺជា ស្ត្រី ជនជាតិ វៀតណាម អាយុ ៣៤ ឆ្នាំ ជា អ្នកទេសចរ ស្នាក់ នៅ ខុនដូ មួយ កន្លែង ដែល ស្ថិត នៅ កោះ ពេជ្រ រាជធានី ភ្នំពេញ ។ ដោយ ទទួលបាន លទ្ធផល តេស្ត វិជ្ជមាន វីរុស កូវីដ១៩ ហើយ ស្ត្រី រូប នេះ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ៕
ព្រឹក នេះ រដ្ឋសភា បើក កិច្ចប្រជុំ ពិភាក្សា និង អនុម័ត លើ « សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន »
( ភ្នំពេញ ) ៖ « សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន » ដែល ជា សេចក្តីព្រាង ច្បាប់ ថ្មី មួយ នៅក្នុង ប្រទេស កម្ពុជា នោះ នឹង ត្រូវ លើក មក ពិភាក្សា និង អនុម័ត នៅក្នុង កិច្ចប្រជុំ រដ្ឋសភា នា ព្រឹក ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នេះ ហើយ ។
កិច្ចប្រជុំ រដ្ឋសភា នា ព្រឹក ថ្ងៃ នេះ នឹង ដឹកនាំ ដោយ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ។ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ក៏ អញ្ជើញ ចូលរួម កិច្ចប្រជុំ នា ព្រឹក ថ្ងៃ នេះ ផងដែរ ។
លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ថ្មី នៃ ក្រសួង យុត្តិធម៌ នឹង ដឹកនាំ មន្ត្រី របស់ ខ្លួន ដើម្បី ការពារ សេចក្តីព្រាង ច្បាប់ មួយ នេះ នៅ ចំពោះមុខ សមាជិក សមាជិកា រដ្ឋសភា ។
ក្រៅពី ការពិភាក្សា និង អនុម័ត លើ « សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន » ហើយ នោះ កិច្ចប្រជុំ រដ្ឋសភា នា ព្រឹក ថ្ងៃ នេះ នឹង សម្រេច អំពី សុពលភាព នៃ អាណត្តិ របស់ លោកស្រី នូ សុវណ្ណ នី ជា តំណាងរាស្រ្ត មណ្ឌល តាកែវ ជំនួស លោក ជា វ៉ាន់ ដេត ដែល បាន សុំ លា លែង ហើយ ទៅកាន់ តំណែង ជា រដ្ឋមន្រ្តី ក្រសួង ប្រៃសនីយ៍ និង ទូរគមនាគមន៍ ។
សមាជិក សភា ដែល ចូលរួម កិច្ចប្រជុំ នា ព្រឹក នេះ ក៏ នឹង បោះឆ្នោត ជ្រើសតាំង លោក ឡូយ សុផាត ជា សមាជិក គណៈកម្មការ ផែនការ វិនិយោគ កសិកម្ម អភិវឌ្ឍន៍ ជនបទ បរិស្ថាន និង ធនធាន ទឹក និង លោក ស៊ូ ភិរិន្ទ ជា សមាជិក គណៈកម្មការ សេដ្ឋកិច្ច ហិរញ្ញវត្ថុ ធនាគារ និង សវនកម្ម ។
សូម បញ្ជាក់ ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី ការគ្រង ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន មាន ចំនួន ៥ជំពូក និង ចែកចេញ ១១មាត្រា ។ សេចក្តីព្រាង ច្បាប់ នេះ ត្រូវបាន រៀបចំឡើង ដោយ ផ្អែក តាម ស្មារតី នៃ មាត្រា ២២ ថ្មី នៃ រដ្ឋធម្មនុញ្ញ របស់ កម្ពុជា ដែល ចែង ថា « នៅពេល ប្រជាជាតិ ប្រឈមមុខ នឹង គ្រោះថ្នាក់ ព្រះមហាក្សត្រ ទ្រង់ ប្រកាស ប្រទាន ដំណឹង ជាសាធារណៈ ដាក់ ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ក្រោយពី បាន មតិ ឯកភាព ពី នាយក រដ្ឋមន្ត្រី ប្រធាន រដ្ឋសភា និង ប្រធាន ព្រឹទ្ធសភា » ។
នៅក្នុង មាត្រា ៧ ក្នុង ជំពូក ទី៤ និយាយ ពី ទោស ប្បញ្ញត្តិ បាន ចែង ថា អំពើ ដោយ ចេតនា រារាំង ឬ បង្ក ឧបសគ្គ ដល់ កិច្ច ប្រតិបត្តិការ ឆ្លើយតប ចំពោះ ភាពអាសន្ន ត្រូវ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ពី ១ ឆ្នាំ ដល់ ទៅ ៥ ឆ្នាំ និង ពិន័យ ជា ប្រាក់ ពី ១លាន រៀល ដល់ ៥លាន រៀល ។
ចំពោះ អំពើ រារាំង ដល់ កិច្ច ប្រតិបត្តិការ ពេល ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ត្រូវ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ពី ៥ ឆ្នាំ ទៅ១០ ឆ្នាំ កាលបើ អំពើ នេះ នាំឱ្យ មាន ចលាចល ជាសាធារណៈ ឬ ប៉ះពាល់ ដល់ សន្តិសុខ ជាតិ ។
ក្នុង មាត្រា ៨ នៃ ជំពូក ដដែល បាន ចែង ថា អំពើ ដោយ ចេតនា មិន គោរព វិធានការ ដាក់ចេញ ដោយ រាជ រដ្ឋាភិបាល ដែល មាន ចែង ក្នុង មាត្រា ៥ ត្រូវ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ពី១ ខែ ទៅ១ ឆ្នាំ និង ពិន័យ ជា ប្រាក់ ពី១០ ម៉ឺន រៀល ដល់ ១លាន រៀល ។ ដោយឡែក អំពើ មិន គោរព តាម វិធានការពេល ប្រទេសជាតិ ស្ថិត ក្នុង ភាពអាសន្ន ត្រូវ ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ពី ១ ឆ្នាំ ទៅ ៥ ឆ្នាំ និង ពិន័យ ជា ប្រាក់ ពី ១លាន រៀល ទៅ ៥លាន រៀល កាលបើ អំពើ នេះ នាំឱ្យ មាន ចលាចល ជាសាធារណៈ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ម្នាក់ . របួស ស្រាល ៤នាក់ និង របួស ធ្ងន់ ២នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . ប្រជែង . មិន ប្រកាន់ ស្ដាំ ៕
អគ្គ នាយក ពន្ធដារ ណែនាំ ពី ការអនុវត្ត ការសម្រេច របស់ រាជ រដ្ឋាភិបាល លើ ការសម្រួល ផ្នែក ពន្ធដារ ដល់ វិស័យ អាកាសចរណ៍ និង ទេសចរណ៍ ដែល ប៉ះពាល់ ធ្ងន់ ធរ ពី ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក គង់ វិបុល ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ចេញ លិខិត ណែនាំ អំពី ការអនុវត្ត ការសម្រេច របស់ រាជ រដ្ឋាភិបាល ស្តីពី វិធានការ បន្ថែម សម្រួល ផ្នែក ពន្ធដារ ជួយ ដល់ វិស័យ អាកាសចរណ៍ និង វិស័យ ទេសចរណ៍ ដែល ទទួលរង ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ពី ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ៕
សេចក្តីណែនាំ នេះ បាន សរសេរ ថា៖ ដើម្បី អនុវត្ត បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ស្តីពី ការដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ក្នុង គោលដៅ បង្ការ និង ទប់ស្កាត់ ការរាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ ឱ្យ មាន ប្រសិទ្ធភាព រដ្ឋបាល រាជធានី ភ្នំពេញ សូម ធ្វើ ការណែនាំ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ចំណុះ រដ្ឋបាល រាជធានី ភ្នំពេញ ព្រមទាំង បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ និង ស្នាក់ នៅក្នុង រាជធានី ភ្នំពេញ ទាំងអស់ ដូច ខាងក្រោម៖
១៖ អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ចំណុះ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការធ្វើចរាចរ ការធ្វើដំណើរ និង ការដឹកជញ្ជូន ទំនិញ របស់ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ពី ភូមិ មួយ ទៅ ភូមិ មួយ ពី សង្កាត់ មួយ ទៅ សង្កាត់ មួយ ពី ខណ្ឌ មួយ ទៅ ខណ្ឌ មួយ ដោយ មិន មាន ការហាមឃាត់ ឬ រឹតត្បិត ឡើយ ។
២៖ បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ និង ស្នាក់ នៅក្នុង រាជធានី ភ្នំពេញ អាច ធ្វើចរាចរ ធ្វើដំណើរ និង ដឹកជញ្ជូន ទំនិញ នៅក្នុង ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ ពី ភូមិ មួយ ទៅ ភូមិ មួយ ពី សង្កាត់ មួយ ទៅ សង្កាត់ មួយ ពី ខណ្ឌ មួយ ទៅ ខណ្ឌ មួយ ដោយ សេរី គ្មាន ការហាមឃាត់ ឡើយ ។
( បរទេស ) ៖ ខាងក្រោម គឺជា សំណុំ រូបភាព មួយចំនួន នៃ ស្ថានការណ៍ អន្តរជាតិ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃព្រហស្បតិ៍ ទី០៩ ខែមេសា ឆ្នាំ ២០២០ ។
១៖ អវកាសយានិក ៣រូប ចាកចេញ ពី ផែនដី ដោយ ជោគជ័យ និង សំដៅ ទៅកាន់ ស្ថានីយ អវកាស អន្តរជាតិ ISS ។
២៖ អេស៉្បាញ និង អ៉ីតាលី កំពុង ពិចារណា បន្ធូរបន្ថយ ការរឹតត្បិត ដោយ សន្សឹម ៗ ខណៈ អត្រា អ្នក ឆ្លង និង ស្លាប់ ហាក់ ចាប់ផ្តើម ថយចុះ ។
៧៖ UN ដឹក ជំនួយ ផ្នែក សុខាភិបាល ចំនួន ៩០តោន ទៅកាន់ ប្រទេស វេណេស៊ុយអេឡា ។ អគ្គិសនី កម្ពុជា ជូនដំណឹង ពី ការផ្អាក ផ្គត់ផ្គង់ អគ្គិសនី នៅ តំបន់ មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ ដើម្បី អនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃស្អែក
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
ទោះជា មាន ការខិតខំ ថែរក្សា មិន ឲ្យ មាន ការប៉ះពាល់ ដល់ ការផ្គត់ផ្គង់ អគ្គិសនី ធំដុំ ប៉ុន្តែ ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី នៅ តំបន់ ខាងលើ អាចនឹង មាន ការរអាក់រអួល ខ្លះ ៗ ជៀស មិន ផុត ដែល យើងខ្ញុំ ស្នើសុំ អភ័យទោស ទុក ជាមុន ៕ ថ្នាក់ដឹកនាំ និង មន្ត្រី សាធារណការ រាជធានី ភ្នំពេញ ១៤៩ នាក់ ស្ម័គ្រចិត្ត បរិច្ចាគ ថវិកា ជាង ៤៦ លាន រៀល ជូន រាជ រដ្ឋាភិបាល ដើម្បី ប្រយុទ្ឋ ប្រឆាំង នឹង ជំងឺ COVID19
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ ចំនួន ១៤៩ នាក់ នា ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ស្ម័គ្រចិត្ត បរិច្ចាក ថវិកា ចំនួន ៤៦.៨៨៥.០០០ រៀល ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី ប្រយុទ្ឋ ប្រឆាំង នឹង ជំងឺ COVID-19 ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ លោក ឧកញ៉ា ជៀម ផែន និង ភរិយា ឧបត្ថម្ភ ថវិកា ១ម៉ឺន ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា
( ភ្នំពេញ ) ៖ លោក ចេង ប៉ូលី ជំនួយការ គ.ជ. ប និង ជា អនុប្រធាន ការិយាល័យ គណនេយ្យ នៅ នាយកដ្ឋាន ហិរញ្ញវត្ថុ នៃ គណៈកម្មធិការ ជាតិ រៀបចំ ការបោះឆ្នោត បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ២០ ម៉ឺន រៀល សម្រាប់ រយៈពេល ៥ខែ ចាប់ពី ខែឧសភា ដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០
១៖ សម្ដេច តេជោ ហ៊ុន សែន ចេញ បទបញ្ជា ឲ្យ ដាក់កំហិត លើ ការធ្វើដំណើរ ក្នុង ប្រទេស ក្នុង គោលដៅ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវី ដ ចាប់ពី យប់ ថ្ងៃទី ៩ - ១៦ ខែមេសា ឆ្នាំ ២០២០ ( ចុច អាន )
២៖ សម្តេច តេជោ ហ៊ុន សែន៖ ដើម្បី សុវត្ថិភាព របស់ ជាតិ គ្មាន ជម្រើស អ្វី ល្អ ជាង ការបិទ ការធ្វើដំណើរ ឆ្លង ខេត្ត ឡើយ ( ចុច អាន )
៥៖ សម្តេច តេជោ ហ៊ុន សែន៖ ឆ្នាំ ថ្មី រាជ រដ្ឋាភិបាល នឹង បន្ត ធ្វើ កំណែទម្រង់ ស៊ីជម្រៅ តាម អភិក្រមទាំង ៥ ( ចុច អាន )
៦៖ សម្តេច តេជោ ហ៊ុន សែន បង្ហាញ សមិទ្ធផល ការងារ ដែល រាជ រដ្ឋាភិបាល សម្រេចបាន ក្នុង ឆ្នាំ ២០១៩ ( ចុច អាន )
៧៖ ដំណឹង ល្អ៖ ថ្ងៃ នេះ ក្រសួង ប្រកាស ថា អ្នកជំងឺ កូវីដ១៩ ជាសះស្បើយ កើន ថ្មី រហូតដល់ ៦នាក់ ទៀត ធ្វើឲ្យ ចំនួន អ្នក ជាសះស្បើយ សរុប កើន ដល់ ៦៨ នាក់ និង រកឃើញ ករណី ឆ្លង ថ្មី ម្នាក់ និង លាប់ ជំងឺ ឡើងវិញ ម្នាក់ ( ចុច អាន )
៩៖ ក្រសួង ការងារ ចេញ វិធានការ បន្ថែម ៤ ចំណុច ដល់ រោងចក្រ សហគ្រាស ហើយ បញ្ជាក់ ថា បើសិន ឈប់ សម្រាក ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី នឹង ត្រូវ ដាក់ ឲ្យ ដាច់ដោយឡែក ១៤ ថ្ងៃ ( ចុច អាន )
១១៖ លោក គី តិច ដឹកនាំ ប្រតិភូ មេធាវី ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ លោក កើត រិទ្ធ រដ្ឋមន្ត្រី ក្រសួង យុត្តិធម៌ ( ចុច អាន )
១១៖ រដ្ឋមន្ត្រី ការបរទេស អាស៊ាន ពិភាក្សា គ្នា តាម ប្រព័ន្ធ វីដេអូ ដើម្បី រួម ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ( ចុច អាន )
អគ្គ មេបញ្ជាការ កងទ័ព បញ្ជា ឲ្យ ចល័ត រថ ក្រោះ និង រថ ពាស ដែក ជាង ២០ គ្រឿង ចូល បន្ទាយ វិញ នៅ ថ្ងៃស្អែក
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន ចេញ បទបញ្ជា ឲ្យ ចល័ត រថ ក្រោះ និង រថ ពាស ដែក ជាង ២០ គ្រឿង ចូល បន្ទាយ ដើម វិញ ក្រោយ ធ្វើ សមយុទ្ធនាគ មាស ឆ្នាំ ២០២០ ជាមួយ កងទ័ព ចិន រួចរាល់ កាលពី ពេល ថ្មី ៗ នេះ ។
យោង តាម បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន គូសបញ្ជាក់ ថា៖
២៖ ការធ្វើ យុទ្ធ ដំណើរ ត្រូវ រៀបចំ ផែនការ ឲ្យបាន ច្បាស់លាស់ ដើម្បី ធានា និង រក្សា បាន នូវ សន្តិសុខ សុវត្ថិភាព ។
៤៖ នាយក ខុទ្ទកាល័យ អគ្គ បញ្ជាការដ្ឋាន មេបញ្ជាការ កងទ័ព ជើងគោក មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ អនុវត្តន៍ បទបញ្ជា នេះ ឲ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ ៕ មកដល់ ពេលនេះ ឡាវ ទើប រកឃើញ អ្នក ឆ្លង COVID-19 សរុប តែ ១៦ ករណី ប៉ុន្តែ ការប្រុងប្រយ័ត្ន ខ្ពស់ នៅតែ បន្ត
បើ តាម លោក រដ្ឋមន្ត្រី ដដែល បាន គូសបញ្ជាក់ ទៀត ថា អ្នកជំងឺ ថ្មី ខាងលើ នេះ កំពុងតែ ទទួលបាន ការព្យាបាល ក្នុង មន្ទីរពេទ្យ មួយ កន្លែង នៅក្នុង ទីក្រុង វៀង ច័ន្ទ និង មាន អការៈ រោគ នឹង នរ ល្អ ធម្មតា ។ ទោះបីជា ឡាវ មាន ករណី ឆ្លង តិច និង មិន ទាន់ មាន ករណី ស្លាប់ ក្តី ក៏ ការរឹតបន្តឹង នៅតែ កើតមាន ដោយ ក្នុង នោះ សាលារៀន ជាច្រើន តែ បន្ត បិទ ទ្វារ ខណៈ នៅ តាម ច្រក ព្រំដែន និង អាកាសយានដ្ឋាន ស្ថិត នៅក្នុង ការត្រួតពិនិត្យ យ៉ាង ដិតដល់ បំផុត ។
( ភ្នំពេញ ) ៖ វរសេនីយ៍ ទោ ម៉ន វុទ្ធី អធិការ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៣០ ម៉ឺន រៀល ក្នុង ១ខែ រយៈពេល ៦ខែ ចាប់ពី ខែឧសភា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ៕ មន្ត្រី ចំណុះ ក្រោម រតនាគារ ជាតិ ទូទាំង ប្រទេស ៤១៥ នាក់ បរិច្ចាគ ប្រាក់ បៀវត្ស ជូន គណៈកម្មការ កូវីដ សរុប ជាង ២១៩ លាន រៀល
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា ដែល បម្រើ ការ ចំណុះ ក្រោម អគ្គ នាយកដ្ឋាន រតនាគារ ជាតិ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចូលរួម បរិច្ចាគ ប្រាក់ បៀវត្ស ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ដោយ សរុប ជា ទឹកប្រាក់ ២១៩. ១១៣. ៥០០ រៀល ។
នៅក្នុង ចំណោម បញ្ជី ឈ្មោះ សរុប ៤១៥ នាក់ យើងខ្ញុំ ដកស្រង់ លិខិត បរិច្ចាគ ផ្ទាល់ខ្លួន របស់ មន្រ្តី សំខាន់ ៗ មួយចំនួន តែ ប៉ុណ្ណោះ ។
ខាងក្រោម នេះ ជា បញ្ជី ឈ្មោះ របស់ សប្បុរសជន ទាំង ៤១៥នា ក់៖
នគរបាល ស្រុក អង្គស្នួល ខេត្ត កណ្តាល វៃ ខ្នោះ ចោរ ឆក់ ម្នាក់ ក្រោយ ធ្វើ សកម្ម បាន សម្រេច រត់ គេច មិន បាន មួយ ចម្អិន កំពិស
( កណ្តាល ) ៖ កម្លាំង នគរបាល ស្រុក ស្អាង ខេត្ត កណ្តាល បាន ឃាត់ខ្លួន ចោរ ឆក់ ម្នាក់ ក្រោយ ធ្វើ សកម្មភាព ឆក់ កាបូប ពី ស្ត្រី ចំណាស់ ម្នាក់ ព្យាយាម រត់ គេច មិន បាន មួយ ចម្អិន កំពិស ប៉ុន្តែ ត្រូវ ជាប់ ខ្នោះ របស់ សមត្ថកិច្ច ដើម្បី យកមក ចាត់ការ តាម ផ្លូវ ច្បាប់ ។
លោក ថាច់ សុវណ្ណា ប្រធាន ផ្នែក ព្រហ្មទណ្ឌ នគរបាល ស្រុក អង្គស្នួល បាន ឱ្យដឹង ថា ហេតុការ ខាងលើ នេះ បាន កើតឡើង នៅ យប់ វេលា ម៉ោង ១០៖ ៥០ ថ្ងៃទី ៩ ខែមេសា ឆ្នាំ ២០២០ នេះ នៅ ចំណុច ផ្លូវ ជាតិ លេខ ៤ ភូមិ ត្រពាំង ពើក ឃុំ ពើក ស្រុក អង្គស្នួល ខេត្ត កណ្តាល ។
លោក ថាច់ សុវណ្ណា បាន ឱ្យដឹង ថា ជនរងគ្រោះ ឈ្មោះ ម៉ៅ សុម៉ាលី ភេទ ស្រី អាយុ ៥៩ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ កសិករ នៅ ភូមិ ទួល ស្រម៉រ ឃុំ ពើក ស្រុក អង្គស្នួល ខេត្ត កណ្តាល ។ ចំណែក ជនសង្ស័យ មាន ឈ្មោះ រុន មក រា ភេទ ប្រុស អាយុ ១៧ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ មិន ពិត នៅ ភូមិ ត្រពាំង ក្រសាំង ឃុំ បែក ចាន ស្រុក អង្គស្នួល ខេត្ត កណ្តាល ។
លោក ថាច់ សុវណ្ណា បាន បន្ត ទៀត ថា នៅ មុនពេល កើត ហេតុ ជនរងគ្រោះ ជិះ ម៉ូតូ ម៉ាក ឃ្លីច ទៅ រក ឌុប ចៅ នៅ ផ្សារ ថ្នល់ ទទឹង ទៅដល់ ចៅ ដេកលក់ ក៏ ត្រឡប់ មកវិញ លុះ មកដល់ ចំណុច កើត ហេតុ ស្រាប់តែ ជនសង្ស័យ តាម មកពីក្រោយ ឆក់ យក កាបូប លុយ ដែល ទុក ក្នុង ខ្លប់ ម៉ូតូ តែម្តង ហើយ ជិះ រត់ គេច ទៅ ទិស ខាងកើត ចំពេល កម្លាំង ល្បាត ប្រទះឃើញ ដេញ តាម ឃាត់ខ្លួន ជនសង្ស័យ និង វត្ថុតាង បាន មកវិញ ។
លោក ថាច់ សុវណ្ណា បាន បញ្ជាក់ ថា ជនសង្ស័យ បាន សារភាព ថា ខ្លួន ពិតជា បាន ឆក់ កាបូប លុយ ពី ជនរងគ្រោះ ដែល ទុក ក្នុង ខ្លប់ ម៉ូតូ ពិត ប្រកដ មែន និង កន្លងមក ធ្លាប់ បាន ធ្វើ សកម្មភាព ឆក់ បាន ចំនួន ១០លើក ផ្សេង ទៀត ។ ឆក់ នៅ ម្តុំ កន្លែង លក់ សាច់ក្រក ខណ្ឌ កំបូល ចំនួន ៧លើក នៅ ផ្លូវ ជាតិ លេខ ៤១ ចំនួន ២លើ ក និង នៅ ស្រុក អង្គស្នួល១ លើក ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន បាន តែម្តង ។
បច្ចុប្បន្ន សមត្ថកិច្ច ជំនាញ បាន កំពុង កសាង សុំ ណុំរឿង បញ្ជូន ទៅកាន់ តុលាការ តាម ផ្លូវ ច្បាប់ ៕ អភិបាល រាជធានី ភ្នំពេញ បើក កិច្ចប្រជុំ បន្ទាន់ រៀបចំ ផែនការបិទ ចរាចរណ៍ ចេញ ពី រាជធានី ភ្នំពេញ ទៅ តាម ខេត្ត តាម បទបញ្ជា របស់ នាយក រដ្ឋមន្ត្រី ដើម្បី ទប់ស្កាត់ COVID-19
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ ល្ងាច ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន បើក កិច្ចប្រជុំ ជាបន្ទាន់ ត្រៀម រៀបចំ ផែនការបិទ ចរាចរណ៍ ចេញ ពី រាជធានី ភ្នំពេញ ទៅ តាម បណ្តា ខេត្ត - ក្រុង ស្រុក នានា ឡើយ ដើម្បី ឆ្លើយតប នឹង បទបញ្ជា របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ចូលរួម ការរីករាលដាល COVID-19 ។
សូម បញ្ជាក់ ថា សម្ដេច តេជោ ហ៊ុន សែន បាន ចេញ បទបញ្ជា ឲ្យ អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ បិទ ការធ្វើដំណើរ ក្នុង ប្រទេស ពី រាជធានី ភ្នំពេញ ទៅកាន់ បណ្ដា ខេត្ត និង ការធ្វើដំណើរ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត រហូតដល់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ ដោយ ចាប់ អនុវត្តន៍ ពី ម៉ោង ២៤៖០០ នាទី ថ្ងៃទី ០៩ រហូតដល់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ ។
បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ដែល ចេញផ្សាយ នៅ ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន បញ្ជាក់ ថា ហាមឃាត់ ការធ្វើដំណើរ នៅ ផ្ទៃក្នុង ប្រទេស រួម មាន ការធ្វើដំណើរ ឆ្លងកាត់ ចេញ - ចូល រាជធានី ភ្នំពេញ ( ដោយ មិន ប៉ះពាល់ ដល់ ការធ្វើដំណើរ ផ្ទៃក្នុង រាជធានី ភ្នំពេញ នោះ ទេ ) ការធ្វើដំណើរ ឆ្លងកាត់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ និង ការធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត ។
អភិបាល ខេត្ត កំពង់ចាម បើក កិច្ចប្រជុំ ជាបន្ទាន់ ដាក់ ផែនការបិទ ការធ្វើដំណើរ . ក្រោយ មាន បទបញ្ជា សម្ដេច តេជោ ហ៊ុន សែន ក្នុង គោលដៅ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា នៅ ល្ងាច ថ្ងៃទី ៩ ខែមេសា ឆ្នាំ ២០២០ នេះ បាន បើក កិច្ចប្រជុំ មួយ ជាបន្ទាន់ ជាមួយ ថ្នាក់ដឹកនាំ ខេត្ត មន្រ្តី រាជការ និង កងកម្លាំងប្រដាប់អាវុធ ដើម្បី ដាក់ ផែនការ ភ្លាម ៗ បិទ ការធ្វើដំណើរ ឆ្លង ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ និង ស្រុក មួយ ទៀត ទៅ ស្រុក មួយ ទៀត ក្នុង គោលដៅ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ តាម បទបញ្ជា របស់ នាយក រដ្ឋមន្រ្តី ។
សូម បញ្ជាក់ ថា សម្ដេច តេជោ ហ៊ុន សែន បាន ចេញ បទបញ្ជា ឲ្យ អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ បិទ ការធ្វើដំណើរ ក្នុង ប្រទេស ពី រាជធានី ភ្នំពេញ ទៅកាន់ បណ្ដា ខេត្ត និង ការធ្វើដំណើរ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត រហូតដល់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ ដោយ ចាប់ អនុវត្ត ពី ម៉ោង ២៤៖០០ នាទី ថ្ងៃទី ០៩ រហូតដល់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ ។
បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ដែល ចេញផ្សាយ នៅ ថ្ងៃ នេះ បាន បញ្ជាក់ ថា ហាមឃាត់ ការធ្វើដំណើរ នៅ ផ្ទៃក្នុង ប្រទេស រួម មាន ការធ្វើដំណើរ ឆ្លងកាត់ ចេញ - ចូល រាជធានី ភ្នំពេញ ( ដោយ មិន ប៉ះពាល់ ដល់ ការធ្វើដំណើរ ផ្ទៃក្នុង រាជធានី ភ្នំពេញ នោះ ទេ ) ការធ្វើដំណើរ ឆ្លងកាត់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ និង ការធ្វើដំណើរ ឆ្លងកាត់ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត ។
ជា ការពិត មាន អ្នក ខ្លះ អាច យល់ឃើញ ថា នេះ ជា ការបិទ សិទ្ធិ សេរីភាព ក្នុង ការដើរ ហើរ របស់ ប្រជាពលរដ្ឋ ជាពិសេស ក្នុង ពេល បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ដែល គ្រួសារ ខ្មែរ ត្រូវ ការជួបជុំគ្នា មួយ ឆ្នាំ ម្តង ។
នៅ អឺរ៉ុប និង សហរដ្ឋ អាមេរិក ដែល កំពុង រង ការវាយប្រហារ ពេញ ទំហឹង ដោយ កូវិដ - ១៩ រហូត ធ្វើឲ្យ មនុស្ស ឆ្លង រាប់ សែន នាក់ និង ស្លាប់ រាប់ ម៉ឺន នាក់ គឺ ក៍ ដោយសារតែ ពលរដ្ឋ មិន ស្តាប់ ការណែនាំ របស់ រដ្ឋាភិបាល ហើយ នាំគ្នា ចេញ ដើរ រហេត រហូត គ្មាន ឈប់ឈរ ។
ក្នុង ន័យ នេះ រដ្ឋាភិបាល កម្ពុជា ដែល បាន សម្រេច ហាមប្រាម មិន ឲ្យ ពលរដ្ឋ ខ្លួន ធ្វើដំណើរ ឆ្លង ពី ភ្ន ពេញ ទៅ ខេត្ត ឬ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត រឺ ពី ស្រុក មួយ ទៅ ស្រុក មួយ ទៀត គឺជា ជម្រើស ដ៏ សមស្រប បំផុត ដែល មិន អាច ចៀសវាង បាន ឡើយ នៅក្នុង ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ និង ក្នុង ទស្សនៈ « ការពារ ប្រសើរ ជាង ព្យាបាល » ។
ជាពិសេស ក្នុង សមរភូមិ ប្រយុទ្ធ ជាមួយ សត្រូវ ឥត ស្រមោល ដូចជា កូវិដ - ១៩ នេះ ជាដើម រឹតតែ មិន ត្រូវ មើលងាយ សភាពការណ៍ សោះឡើយ ។ បច្ចុប្បន្ន ប្រទេស កម្ពុជា យើង មិន ទាន់ រងគ្រោះ ខ្លាំង ដោយសារ កូវិដ - ១៩ នៅឡើយ នោះ ទេ ។ នេះ គឺ ដោយសារតែ រដ្ឋាភិបាល ដឹកនាំ ដោយ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន មាន ភាពឈ្លាសវៃ ស្គាល់ និង វាយតម្លៃ សភាពការណ៍ បាន ត្រឹមត្រូវ និង ស្គាល់ កាលៈទេសៈ ហើយ ដឹង ថា ពេលណា ត្រូវ ធ្វើ អ្វី ។
ដំណើរការចាត់ចែង របស់ នាយក រដ្ឋមន្ត្រី តាំងពី ដំណាក់កាល ទី១ រហូតដ មកដល់ ពេលនេះ គឺជា ការរៀបចំ ក្រឡា ដើរ បាន យ៉ាង ល្អ ទាំង នៅក្នុង ក្របខណ្ឌ ជាតិ និង អន្តរជាតិ ទើប អាច បញ្ចៀស ប្រទេសជាតិ យើង មិន ឲ្យ ធ្លាក់ ចូលក្នុង មហន្តរាយ នៃ កូវិដ - ១៩ រហូតដល់ ពេលនេះ ខណៈ ដែល បណ្តា ប្រទេស ក្នុង តំបន់ និង ក្នុង ពិភពលោក កំពុងតែ ធ្លាក់ ដុន ដាប យ៉ាង ខ្លាំង បំផុត ។
ដូច្នេះ សរុប មក វីញ យើង ជា ពលរដ្ឋ ខ្មែរ គ្មាន ជម្រើស អ្វី ល្អ ជាង ការស្តាប់ និង អនុវត្ត តាម ការណែនាំ របស់ រដ្ឋាភិបាល នោះ ឡើយ ហើយ ជាពិសេស ការខកខាន ជួបជុំគ្នា ម្តង ក្នុង ពិធី បុណ្យ ចូល ឆ្នាំ មិន មែន ជា រឿង ដែល យើង មិន អាច ធ្វើ បាន នោះ ឡើយ ។ ពិធី បុណ្យ ចូល ឆ្នាំ នៅតែ អាច ធ្វើ នៅនឹង កន្លែង ជាមួយ បងប្អូន មិត្តភ័ក្តិ ក្រុមគ្រួសារ ជា លក្ខណៈ ទ្រង់ទ្រាយ តូច បាន ដដែល ។ ប៉ុន្តែ អ្វី ដែល សំខាន់ បំផុត នោះ គឺ « ក្រោយ បុណ្យ ចូល ឆ្នាំ យើង មាន សុវត្ថិភាព ពី កូវិដ - ១៩ នោះ ទើប ជា ដំណឹង ល្អ » ។
ដោយ៖ អ្នកនយោបាយ តុកាហ្វេ មន្ត្រី អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា លោក ពៅ ថា រី បរិច្ចាគ ប្រាក់ បៀវត្ស ១សែន រៀល ក្នុង ១ខែ រយៈពេល ៦ខែ ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ពៅ ថា រី អនុប្រធាន នាយកដ្ឋាន នីតិវិធី នៃ អគ្គ នាយកដ្ឋាន សេវា ច្បាប់ និង សមូហភាព ដែនដី នៃ អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ១ សែន រៀល សម្រាប់ រយៈពេល ៦ខែ ចាប់ពី ខែឧសភា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
សូម ជម្រាប ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ សម្តេច ចំនួន ៧ខែ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ ។ ប្រាក់ខែ របស់ សម្តេច តេជោ ដែល បរិច្ចាគ នេះ គឺ រាប់ ចាប់ពី ខែមីនា រហូតដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ៕ មន្ត្រីរាជការ នៃ ក្រសួង ទេសចរណ៍ ៣៧រូប ទៀត ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ជូន គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ សប្បុរសជន ចំនួន ៣៧រូប ដែល ជា មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា នៃ ក្រសួង ទេសចរណ៍ បាន ចូលរួម បរិច្ចាគ ប្រាក់ បៀវត្ស តាម លទ្ធភាព រៀង ៗ ខ្លួន ជូន ដល់ គណៈកម្មការ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
សប្បុរសជន ទាំង ៣៧ រូប នោះ រួម មាន៖
១៖ លោកស្រី តឹក សុភី អគ្គ នាយក រង អភិវឌ្ឍន៍ ទេសចរណ៍ និង សហប្រតិបត្តិការ អន្តរជាតិ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ២០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៖ លោក ចឹក ណាន់ ប្រធាន ការិយាល័យ នៃ នាយកដ្ឋាន គណនេយ្យ និង ហិរញ្ញវត្ថុ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១៥០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៣៖ លោកស្រី អ៊ូ លក្ខិណា អនុប្រធាន អង្គភាព លទ្ធកម្ម ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៤៖ លោក សោម ចំរើន ឫទ្ធិ អនុប្រធាន ការិយាល័យ ផ្គត់ផ្គង់ នៃ នាយកដ្ឋាន គណនេយ្យ និង ហិរញ្ញវត្ថុ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៥៖ លោកស្រី ឡឹក សាវ៉ាត់ អនុប្រធាន អង្គភាព លទ្ធកម្ម ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៦៖ លោកស្រី អៀង វ៉ានីតា អនុប្រធាន នាយកដ្ឋាន គ្រប់គ្រង ទីភ្នាក់ងារ ដឹកជញ្ជូន និង មគ្គុទ្ទេសក៍ ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៧៖ លោក គុណ គឹម ជួរ អនុប្រធាន នាយកដ្ឋាន វាយតម្លៃ ទីក្រុង ស្អាត ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៨៖ លោក សុខ សេង ហុង អនុប្រធាន ការិយាល័យ គ្រប់គ្រង និង ទ្រព សម្បត្តិ រដ្ឋ នៃ នាយកដ្ឋាន គណនេយ្យ និង ហិរញ្ញវត្ថុ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៩៖ លោក រិទ្ធ ប៊ុណ្ណា រ័ត្ន អនុប្រធាន ការិយាល័យ គ្រប់គ្រង បុគ្គលិក នៃ នាយកដ្ឋាន ធនធាន មនុស្ស ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
១០៖ លោក ចាន់ សុភា អនុប្រធាន ការិយាល័យ រាជធានី - ខេត្ត នៃ នាយកដ្ឋាន ធនធាន មនុស្ស ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ២ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែមិថុនា ឆ្នាំ ២០២០ ។
១១៖ លោក ភី មុនី អនុប្រធាន ការិយាល័យ គ្រប់គ្រង បុគ្គលិក នៃ នាយកដ្ឋាន ធនធាន មនុស្ស ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
១២៖ លោកស្រី ហង្ស សៅ វ៉ាន់ ឌី ប្រធាន ការិយាល័យ គោល នយោបាយ សង្គម នៃ នាយកដ្ឋានដ្ឋាន ធនធាន មនុស្ស ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
១៣៖ លោក អឿន ចាន់ ថន អនុប្រធានាយកដ្ឋាន ស្ថិតិ ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
១៤៖ លោក ឆាន់ ឌីម៉ង់ មន្ត្រី បម្រើការ នៅ នាយកដ្ឋាន ស្ថិតិ ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
១៥៖ លោក គន្ធា ភិរម្យ ប្រធាន ការិយាល័យ នៃ នាយកដ្ឋាន ជំរុញ ទេសចរណ៍ ក្នុង ស្រុក និង អប់រំ ការយល់ដឹង ជាសាធារណៈ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៥ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកញ្ញា ឆ្នាំ ២០២០ ។
១៦៖ លោក សេង វិរៈ យុទ្ធ មន្ត្រី នៃ នាយកដ្ឋាន បណ្ដុះបណ្ដាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ២០០.០០០ រៀល សម្រាប់ រយៈពេល ២ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែមិថុនា ឆ្នាំ ២០២០ ។
១៧៖ អ្នកនាង ចាន់ ថុន បញ្ញា អនុប្រធាន ការិយាល័យ បច្ចេកទេស វាយតម្លៃ ទីក្រុង ស្អាត ភាគ ពាយ័ព្យ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១៥០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
១៨៖ លោក អ៉ឹម ស៉ិន ណារិទ្ធ អនុប្រធាន នាយកដ្ឋាន ធនធាន មនុស្ស ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
១៩៖ លោក សារុន ន រិន្ទ អធិការ នៃ អគ្គាធិការដ្ឋាន ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២១៖ លោក សូ វណ្ណា អនុប្រធាន ការិយាល័យ គ្រប់គ្រង និង ទ្រព្យសម្បត្តិ រដ្ឋ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២២៖ លោកស្រី ឡឹក សាវី អនុប្រធាន ការិយាល័យ ចំណូល មិន មែន សារពើពន្ធ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៣៖ លោក អ៊ុត សីលា មន្ត្រី ការិយាល័យ គ្រប់គ្រង បុគ្គលិក ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៤៖ លោក ឡៅ កុសល ប្រធាន ការិយាល័យ នៃ នាយកដ្ឋាន អភិវឌ្ឍន៍ ផលិតផល ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៤ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែសីហា ឆ្នាំ ២០២០ ។
២៥៖ លោកស្រី រ៉េត សុភទ្រា អនុប្រធាន ការិយាល័យ នៃ នាយកដ្ឋាន អភិវឌ្ឍន៍ ផលិតផល ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៤ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែសីហា ឆ្នាំ ២០២០ ។
២៦៖ អ្នកនាង ភាវ រដ្ឋា អនុប្រធាន ការិយាល័យ ជំរុញ ការប្រឡង ប្រណាំង រង្វាន់ ធុរកិច្ច បៃតង ក្នុង វិស័យ ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៧៖ លោកស្រី ចុង ស៉ី ណា អនុប្រធាន ការិយាល័យ តាមដាន និង វាយតម្លៃ ការយល់ដឹង ពី និរន្តរភាព ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៨៖ លោក ឌួង បញ្ញា វឌ្ឍន៍ ប្រធាន ការិយាល័យ សេវាកម្ម ផ្ទះ ភ្ញៀវ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
២៩៖ លោកស្រី ហួតនន់ សុខាវណ្ណ ណែត អនុប្រធាន នាយកដ្ឋាន សិក្សា ស្រាវជ្រាវ និង គោល នយោបាយ ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១៥០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៣០៖ លោក កែន សុភី អនុប្រធាន នាយកដ្ឋាន អភិវឌ្ឍន៍ ផលិតផល ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១៥០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៣១៖ លោក ប៉ែន សត្យា អនុប្រធាន ការិយាល័យ នៃ នាយកដ្ឋាន អភិវឌ្ឍន៍ ផលិតផល ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៣២៖ លោកស្រី ឱ វិស័យ អនុប្រធាន ការិយាល័យ គ្រប់គ្រង សេវាកម្ម ម្ហូប អាហារ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៣៣៖ លោកស្រី សារុំ សារ៉ាលី ដា មន្ត្រី នាយកដ្ឋាន អាស៊ាន និង សហប្រតិបត្តិការ អន្តរជាតិ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ១០០.០០០ រៀល សម្រាប់ រយៈពេល ៤ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែសីហា ឆ្នាំ ២០២០ ។
៣៤៖ លោក មាស ប៉ូលីកា ទីប្រឹក្សា និង ជា អនុប្រធាន នាយកដ្ឋាន ធនធាន មនុស្ស ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ២០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៣៦៖ លោកស្រី នូ អ៊ុត កាលី អនុប្រធាន នាយកដ្ឋាន វាយតម្លៃ ទីក្រុង ស្អាត ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ២០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែកក្កដា ឆ្នាំ ២០២០ ។
៣៧៖ លោក តុ ប បញ្ញា អនុប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សេវា កម្សាន្ត និង កីឡា ទេសចរណ៍ ក្រសួង ទេសចរណ៍ ប្រការ បរិច្ចាគ ប្រាក់ បៀវត្ស ក្នុង មួយ ខែ ២០០.០០០ រៀល សម្រាប់ រយៈពេល ៣ខែ គិត ចាប់ពី ខែឧសភា ដល់ ខែតុលា ឆ្នាំ ២០២០ ៕
ទីប្រឹក្សា គ.ជ. ប លោក សំ សាវុធ បរិច្ចាគ ប្រាក់ បៀវត្ស ៥សែន រៀល ក្នុង ១ខែ រយៈពេល ៦ខែ ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក សំ សាវុធ ទីប្រឹក្សា ប្រធាន គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត និង ជា ប្រធាន នាយកដ្ឋាន ប្រតិបត្តិការ នៃ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន ចំនួន ៥សែន រៀល ក្នុង ១ខែ សម្រាប់ រយៈពេល ៦ខែ ចាប់ពី ខែឧសភា ដល់ ខែតុលា ឆ្នាំ ២០២០ ជូន ដល់ គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ ។
ឧត្តមសេនីយ៍ ទោ ចៅ វ៉ាន់ ហេង បរិច្ចាគ ប្រាក់ បៀវត្ស ៥ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ទោ ចៅ វ៉ាន់ ហេង នាយក រង ទី ចាត់ការការងារ ព្រំដែន អគ្គ បញ្ជាការ សម្រេច បរិច្ចាគ ប្រាក់ បៀវត្ស របស់ ខ្លួន មួយ ខែ ៣០ ម៉ឺន រៀល រយៈពេល ៥ខែ ជូន គណៈកម្មការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ដើម្បី ចូលរួម ដោះស្រាយ ការលំបាក ទាំងឡាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ថ្លែងអំណរគុណ លោក ស៊ូ ភិរិន្ទ និង ភរិយា ឧបត្ថម្ភ ថវិកា ៣ពាន់ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ទិវា ៨ឧសភា
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ១០ ខែមេសា ឆ្នាំ ២០២០ ដោយ ធ្វើ ការផ្គត់ផ្គង់ អគ្គិសនី នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តីជូនដំណឹង លម្អិត ខាងក្រោម ។
លោក បន្ត ថា នៅ កម្ពុជា ក្រុម នេះ បាន ធ្វើ ការប្រយុទ្ធ ប្រឆាំង នឹង មេរោគ នេះ (COVID-19) រាល់ ថ្ងៃ ។ ពួកគេ បាន ធ្វើ ទស្សនកិច្ច នៅ មន្ទីរពេទ្យ សហគមន៍ អាកាសយានដ្ឋាន សណ្ឋាគារ និង សួន ឧស្សាហកម្ម ហើយក៏ បាន ផ្តល់ យោបល់ ដល់ ភាគី កម្ពុជា និង ចែករំលែក បទពិសោធន៍ របស់ ពួកគេ ក្នុង ការធ្វើ រោគវិនិច្ឆ័យ និង ព្យាបាល ជំងឺ ។ ក្រៅពី នេះ អ្នកជំនាញ ចិន ក៏ បាន ផ្តល់ ការណែនាំ និង ជំនួយ ផ្នែក វេជ្ជសាស្ត្រ ដល់ ពលរដ្ឋ ចិន នៅ កម្ពុជា ផងដែរ ។
បើ តាម អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន ដដែល បាន បន្ថែម ថា ក្រុមការងារ ជំនាញ ចិន ទាំងនេះ ទទួលបាន ការកោតសរសើរ យ៉ាង ខ្លាំង ពី ប្រជាជន កម្ពុជា ។ ដូច សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន មានប្រសាសន៍ ថា « ស្រឡាញ់ គ្នា ក្នុង គ្រា ក្រ និង ស្គាល់ មិត្ត ល្អ ក្នុង គ្រា លំបាក »៕
ចៅ ស្រី សំណព្វចិត្ត សម្តេច តេជោ ហ៊ុន សែន បន្ត ឈរ កំពូល តារាង កម្មវិធី ប្រកួតប្រជែង គណិតវិទ្យា ប្រចាំ តំបន់ អាស៊ី និង ពិភពលោក
លទ្ធផល នៅលើ គេហទំព័រ បាន បង្ហាញ ថា កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា បាន ឈរ នៅលើ កំពូល តារាង តំបន់ អាស៊ី និង ពិភពលោក ជាមួយ ពិន្ទុ ១៦. ៦០៧ ។
សូម ជំរាប ថា នៅ រសៀល ថ្ងៃទី ០៩ ខែមេសា ឆ្នាំ ២០២០ នេះ សម្ដេច តេជោ ហ៊ុន សែន បាន ចេញ បទបញ្ជា ឲ្យ អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ បិទ ការធ្វើដំណើរ ក្នុង ប្រទេស ពី រាជធានី ភ្នំពេញ ទៅកាន់ បណ្ដា ខេត្ត និង ការធ្វើដំណើរ ពី ខេត្ត មួយ ទៅ ខេត្ត មួយ ទៀត រហូតដល់ ពី ស្រុក មួយ ទៅ ស្រុក មួយ ដោយ ចាប់ អនុវត្ត ពី ម៉ោង ២៤៖០០ នាទី ថ្ងៃទី ០៩ រហូតដល់ ថ្ងៃទី ១៦ ខែមេសា ឆ្នាំ ២០២០ ។
ក្រោម ការខិតខំ របស់ ប្រជាពលរដ្ឋ ចិន ស្ថានភាព នៃ ជំងឺ វីរុស មាន ភាពល្អ ប្រសើរឡើង ឥត ឈប់ឈរ ហើយ ស្ថានភាពសន្ទុះ សណ្តាប់ធ្នាប់ នៃ ជីវភាព ប្រជាពលរដ្ឋ និង ការផលិត មាន ភាពរឹងមាំ និង ពង្រីក ខ្លួន ជា បន្តបន្ទាប់ ។ នា ពេល ពាក់កណ្ដាល អធ្រាត្រ ថ្ងៃទី ៨ ខែមេសា ឆ្នាំ ២០២០ ទីក្រុង អ៊ូហាន់ ប្រទេស ចិន ត្រូវបាន ដក បម្រាម ធ្វើដំណើរ ចាកចេញ ពី ទីក្រុង នេះ បាន បង្ហាញ ពី កិច្ចការងារ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ COVID-19 នៅក្នុង ប្រទេស ចិន ទទួលបាន ភាពជោគជ័យ ជា ទី គាប់ ចិត្ត ។
តាមពិត ទៅ ចាប់តាំងពី មាន ការផ្ទុះឡើង នៃ ជំងឺ វីរុស នេះ មក ភាគី ចិន បាន ជូន ដំណឹង ស្តីពី ជំងឺ វីរុស យ៉ាង ទាន់ ពេលវេលា ដោយ ប្រកាន់ភ្ជាប់ ឥរិយាបថ បើក ចំហ តម្លាភាព និង ទំនួល ខុសត្រូវ មាន ការចែករំលែក បទពិសោធន៍ ក្នុង ការទប់ស្កាត់ និង ការព្យាបាល ជូន ដល់ អង្គការ សុខភាព ពិភពលោក និង សហគមន៍ អន្តរជាតិ ដោយ គ្មាន ការលាក់បាំង បន្តិច សោះឡើយ ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិ ស្រាវជ្រាវ វិទ្យាសាស្រ្ត ។
យើង បាន រាយការណ៍ អំពី ស្ថានភាព ជំងឺ វីរុស COVID-19 ជូន ដល់ អង្គការ សុខភាព ពិភពលោក ប្រទេស ដែល ជាប់ពាក់ព័ន្ធ និង អង្គការ ក្នុង តំបន់ ទៅ តាម ពេល កំណត់ បាន ចែករំលែក ពី ខ្លឹមសារ ស្តី អំពី លំដាប់ សែន នៃ ជំងឺ វីរុស COVID-19 ជាមួយនឹង សហគមន៍ អន្តរជាតិ ជាបន្ទាប់ ក៏ បាន អញ្ជើញ អ្នកជំនាញ នៃ អង្គការ សុខភាព ពិភពលោក និង ស្ថាប័ន ផ្សេងទៀត មក ពិនិត្យ ជាក់ស្តែង នៅក្នុង ទីក្រុង អ៊ូហាន់ ប្រទេស ចិន ។
