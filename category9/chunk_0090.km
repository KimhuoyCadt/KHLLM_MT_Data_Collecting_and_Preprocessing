នាងមានប្អូនស្រីម្នាក់ឈ្មោះ ម៉ារៀ ដែលអង្គុយនៅជើងព្រះ‌ អម្ចាស់ ដោយស្តាប់ពាក្យដែលលោកមាន ប្រសាសន៍ ។
ប៉ុន្តែ ក្នុង រយៈពេល 10 ឆ្នាំ កន្លងមក នេះ ទីក្រុង ប៉េកាំង បាន បង្កើន ជំនួយ និង ប្រាក់ កម្ចី របស់ ខ្លួន ដល់ កម្ពុជា ដែល ធ្វើឲ្យ ឥទ្ធិពល របស់ លោក ខាងលិច ចុះខ្សោយ ។
ប៉ុន្តែ នោះ មិន មែន ដើម្បី ក្លាយជា
ការលើកទឹកចិត្ត ក៏ សំខាន់ ផងដែរ នៅ កន្លែង ធ្វើការ ។
គ្មានលេសធ្វើឲ្យចំណុចនេះមានសុពលភាពទេ ។
សត្វពាហនៈត្រូវបានឮនៅលើភ្នំ ។
ទាញ វា ចេញ ពី ប្រអប់
ដូច្នេះ អ្នក បានក្លាយជាគំរូសម្រាប់អ្នក ជឿទាំងអស់នៃស្រុក ម៉ា សេដូន និងស្រុកអាខៃ ។
ម្តាយ របស់ នាង បាន កាត់ នាង ចោល អស់ រយៈពេល ប្រាំមួយ ខែ បន្ទាប់ពី នាង ដឹង ថា នាង ធ្វើការ ក្នុង រឿង អាសអាភាស ហើយ ម្តាយ របស់ មិត្ត ប្រុស នាង មាន ការ ខ្មាស់អៀន យ៉ាង ខ្លាំង ដែល នាង ព្យាយាម បំបែក គូស្នេហ៍ នេះ ឱ្យ បែក គ្នា ។
បើក សម្រាប់ លទ្ធផល ។
អ្នក ដឹងថាវាមាន ន័យថាមិនអាចទទួលបានមួយអ៊ឹម
« ដោយ សារព្រះគុណរបស់ព្រះ ព្រះយេស៊ូវបាន សុគតសម្រាប់មនុស្សគ្រប់រូប ។
ហើយ នេះ គឺជា ផ្ទាំង លទ្ធផល បន្ទាប់ពី យើង បាន រក្សាទុក វា ។
អនុញ្ញាតឱ្យ X = ទេ ។ ការទស្សន៍ទាយ ត្រឹមត្រូវ ។
ឥឡូវគាត់កំពុងស្វែង រកការ ដកចេញម្តងទៀត ។
៦៖ តើ មាន អ្វី កើតឡើង នៅ វេហ្គាស
គាត់ជាហេតុផលដែលខ្ញុំធ្វើការ នៅ ទីនេះអស់ រយៈពេលប្រាំឆ្នាំ ។
ចៅហ្វាយ របស់ ខ្ញុំ មិន ជួយ ខ្ញុំ ទេ ។
ឥឡូវនេះ ដោយសារ ការល្បួង នេះ នៅ ចំពោះមុខ ពួកគេ ពួកគេ ពិតជា មិន អាច ទប់ទល់ នឹង វា បាន ទេ ។
ការសរសើរ របស់ យើង ចំពោះ បុរស កាមេរ៉ា ។
យើងមិនអាចអង្គុយនៅមួយកន្លែងបានទេ ។
យើងមិនចង់ជាប់គាំងក្នុងការ រស់នៅពីមួយថ្ងៃទៅមួយថ្ងៃទេ ។
« វាខុសហើយជេរអ៊ីចឹង ខ្ញុំជេរគាត់ វិញ » ។
អ៊ីនធឺណិតរបស់កូរ៉េខាងជើងបាត់អស់ រយៈពេល ៩ ម៉ោង ។
ទម្រង់ នៃ ចំណេះដឹង ខ្ពស់ បំផុត របស់ មនុស្ស គឺ ការយល់ ចិត្ត ព្រោះ វា តម្រូវ ឱ្យ យើង ព្យួរ អត្មា របស់ យើង ហើយ រស់ នៅក្នុង ពិភពលោក របស់ អ្នកដទៃ ។
និង ឌិ គ្រីប ដែល ជា ការសម្ងាត់ ការពារ យ៉ាង ជិតស្និទ្ធ បំផុត នៃ សង្រ្គាម ។
នេះ គឺជា បញ្ហា នៃ ចំណេះដឹង ទូទៅ ; ថា ស្ថានភាព ការសម្រេចចិត្ត របស់ ពួកគេ ។
“ ក្នុងជីវិត កាលពីមុន ខ្ញុំធ្វើទីផ្សារ ។
“ យើង នឹង ធ្វើការ ជាមួយ រដ្ឋ ទាំងអស់ ដើម្បី យើង អាច ធានា បាន នូវ ភាពជោគជ័យ របស់ ខ្លួន ។
( ឬ តាមរយៈ ខ្ញុំ ប្រសិនបើ អាសយដ្ឋាន អ៊ីមែល របស់ ពួកគេ មិន ត្រូវបាន រាយ បញ្ជី ។ )
តម្លៃ ថោក បំផុត នៃ ប្រភេទ របស់ វា នៅក្នុង តំបន់ ។
ទោះ យ៉ាងណា ក៏ដោយ ដោយសារ ការបង្ខូច កេរ្តិ៍ឈ្មោះ ភាគរយ នឹង កើនឡើង ។
នៅ ទីបំផុត គាត់ បាន ចេញ ពី ការយល់ព្រម របស់ គាត់ មួយ ថ្ងៃ មុនពេល ការណែនាំ ត្រូវបាន កក់ ។
ឥឡូវនេះ នាង ស្ថិត នៅលើ ទី ពីរ ។
ខូច ដោយសារ ការ រំខាន ញឹកញាប់ ។
ជាន់ ខាងលើ គឺ សម្រាប់ ផ្ទុក ។
នេះ គឺ ដោយសារតែ កាលៈទេសៈ ។
ពេល ខ្ញុំ លេង ចប់ គាត់ ថែមទាំង សម្ភាស ខ្ញុំ និង អ្វី ៗ ទាំងអស់ ។
មិនបានផ្លាស់ ពីកន្លែងរបស់អ្នកទេ ប្រសិនបើគាត់ដាក់ ពង្រាយគ្រាប់មីនរបស់គាត់ ។
ប៉ូលីស សហព័ន្ធ អូស្ត្រាលី អាច និយាយ លើ បញ្ហា ប្រតិបត្តិការ ប៉ុន្តែ យើង នឹង ធ្វើ អ្វី ដែល ចាំបាច់ ដើម្បី ធានា ថា មនុស្ស ដែល ត្រូវបាន នាំ ទៅ ប្រទេស ម៉ាឡេស៊ី ក្រោម កិច្ចព្រមព្រៀង ត្រូវបាន នាំយក ទៅ ដោយ មេធាវី បដិសេធ ចំពោះ ការព្យាបាល អ្នក ស្វែងរក សិទ្ធិ ជ្រកកោន ។
- អ្នក កំពុង ស្វែងរក ព្រះ
ខ្ញុំមានបញ្ហាមួយដែលខ្ញុំប្រាកដថាអ្នកទាំងអស់គ្នាមាន ប៉ុន្តែខ្លាចមិនហ៊ាននិយាយ ...
ខ្ញុំគិតថាអារម្មណ៍ច្រណែនជារឿងធម្មជាតិ ប៉ុន្តែវាជាអ្វីដែលអ្នកត្រូវព្យាយាមនិងរក្សាការ ត្រួតពិនិត្យ ។
សេចក្ដីសង្គ្រោះរបស់យើងជិតដល់ហើយ » ។
ប្រធានាធិបតី នីហ្សេរីយ៉ា ?
អាលីណាសោកស្តាយ ហើយនាងមិនដឹងពន្យល់យ៉ាង ណាទេ ។
មនុស្ស ជាច្រើន មក ទីនេះ ដើម្បី បង្រៀន ឬ សិក្សា ។
យើង មិន មាន កំណត់ ត្រា អំពី គាត់ នៅក្នុង ឯកសារ របស់ យើង ទេ ។
សម្លាប់ ១០ នាក់ និងចាប់អ្នក ទោស ៣០នាក់ ។
« បើយើងស្លាប់ជាមួយគាត់ យើងក៏នឹង រស់នៅជាមួយគាត់ដែរ » ។
នេះ ជា១០យ៉ាង ដែល អ្នក មិន គួរ និយាយ ទៅកាន់ គ្រូព្យាណូ ។
ខ្ញុំផ្អៀងទៅជិតចិញ្ចើមផ្លូវ ប៉ុន្តែពេលនោះខ្ញុំដឹងថាវាឆ្កួត ។
ទីពឹង អាស្រ័យ របស់ ខ្លួន ។
ការស្ដារ ឡើងវិញ នៃ ពូជ មនុស្ស ត្រូវបាន ស្ដារ ឡើងវិញ ជា របស់ ព្រះ
គាត់មិនត្រឹម តែជាអ្នកគ្រប់គ្រងល្អម្នាក់ទេ គាត់ជាមនុស្សល្អ » ។
ប្រពន្ធ របស់ គាត់ មកពី ទីក្រុង ។
កំពូល មនុស្ស ល្បី ទាំង ១០ ដែល មិន ធ្លាប់ មាន ។
ថ្ងៃ នេះខ្ញុំបានរំលឹកពីកម្មវិធីម្តងទៀតហើយអង្គុយនៅ .. .
មែន ហើយ ធ្នូ តែងតែ ព្រួយបារម្ភ អំពី គ្រួសារ របស់ នាង ក្នុង ការស្វែងរក នាង ។
« យើងសូមអំពាវនាវដល់រដ្ឋាភិបាល និងអ្នក ពាក់ព័ន្ធទាំងអស់ឲ្យមានសកម្មភាពសកម្ម ។
ការមកដល់ របស់ នាង តែ ម្នាក់ឯង បង្ហាញ ពី ការស្វែងរក ភាពស្រប ច្បាប់ និង ការគោរព ជាច្រើន នៅក្នុង សហគមន៍ អន្តរជាតិ ។
អ្នក ណាដែលជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ » ។
អ្នកនឹងត្រូវបង្កើតកន្លែងសម្រាប់ការ ស្រាវជ្រាវស្ទង់ មតិជាបន្តបន្ទាប់ជាច្រើនបង្ហាញថាផ្ទុយ ពីខ្សែ ពួរ ។
