( ភ្នំពេញ ) ៖ អាំងប៉ាវ សំណាង ពី ក្រុមហ៊ុន ស៊ុន ស៊ី ម៉ិចកូ ដោយ ក្រុមហ៊ុន នេះ បាន ប្រកាស លក់ ជាមួយ ការបញ្ចុះ តម្លៃ កាន់តែ ពិសេស ហើយ រាល់ ការទិញ ភ្លាម ក៏ អាច មាន ឱកាស ឈ្នះ រង្វាន់ ភ្លាម ៗ ផងដែរ ជាពិសេស នោះ អតិថិជន ក៏ អាច ជ្រើសរើស ការបង់ រំលស់ ដោយ គ្មាន ការប្រាក់ បាន ផងដែរ ជាមួយ ធនាគារ ឯកទេស អ៊ីអន ។
តំណាងរាស្ត្រ មណ្ឌល កំពង់ចាម លោក បណ្ឌិត ម៉ា ឈឿន បាន ថ្លែង បន្ដ ថា « យើង ទាំងអស់ គ្នា សូម ថ្លែងអំណរគុណ សម្ដេច តេជោ ហ៊ុន សែន ដែល ជា វីរៈ ជន ដ៏ អង់អាច ក្លាហាន មួយ រូប របស់ ប្រជាជន កម្ពុជា ដែល តែងតែ នៅ រួម សុខ ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ជាប់ ជានិច្ច ជាពិសេស ដឹក នំា កម្ពុជា នាំមក នូវ សន្ដិភាព យ៉ាង ពិតប្រាកដ » ។
លោក បណ្ឌិត ម៉ា ឈឿន បាន បញ្ជាក់ ថា « ពលរដ្ឋ អរគុណ សន្ដិភាព អ្នកណា ធ្វើឱ្យ មាន សន្ដិភាព គឺ គណបក្ស ប្រជាជន កម្ពុជា ដោយសារតែ ការដឹកនាំ ដ៏ ឈ្លាសវៃ និង ប៉ិនប្រសព្វ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន ដាក់ចេញ នូវ គោល នយោបាយ ឈ្នះ ឈ្នះ បាន ធ្វើឱ្យ កម្ពុជា មាន សន្ដិភាព ពេញលេញ និង មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ បើ គ្មាន សន្ដិភាព មិន អាច និយាយ ទៅដល់ អ្វី ទាំងអស់ . សន្ដិភាព ជា បេះដូង របស់ ប្រជាជន កម្ពុជា យើង ។ ដូច្នេះ យើង ត្រូវ រួមគ្នា ថែរក្សា សុខ សន្ដិភាព នេះ ឱ្យ បាន គង់វង្ស រហូត ទៅ » ។
តំណាងរាស្ដ្រ រូប នេះ បាន សង្គត់ ធ្ងន់ ថា « មាន តែ ជន អគតិ ទេ ដែល ចង់ បង្កើត បដិវត្ដន៍ ពណ៌ បំផ្លាញ សន្ដិភាព នៅ កម្ពុជា យើង ទាំងអស់ គ្នា ប្ដេជ្ញា ប្រឆាំង ដាច់ខាត គ្រប់ រូបភាព ទោះ ក្នុង តម្លៃ ណា ក៏ដោយ ត្រូវតែ ប្រឆាំង ចំពោះ បដិវត្ដន៍ ពណ៌ និង ជម្នះ ការពារ ដាច់ខាច ចំពោះ សន្ដិភាព មួយ នេះ សម្រាប់ ប្រទេសជាតិ ឱ្យ បាន គង់វង្ស » ។
( រដ្ឋ វ៉ាស៊ីងតោន . អាមេរិក ) ៖ ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជនបក្ស ប្រជាជន កម្ពុជា នៃ សហរដ្ឋ អាម៉េរិក ទទួលបន្ទុក តំបន់ ឆ្នេរ ខាងលិច រដ្ឋ វ៉ាស៊ីងតោន សមាជិក សមាជិកា យុវជន បក្ស នៅ ចុង សប្តាហ៍ នេះ បាន រៀបចំ កម្មវិធី អបអរសាទរ ខួប ទី ៤១ នៃ ទិវា ជ័យជម្នះ ៧ មករា ( ១៩៧៩ - ២០២០) ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម អធិបតី លោក ជុំ សន្ទរី ឯក អគ្គ រាជ ទូត វិសមញ្ញ និង ពេញ សមត្ថភាព នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រចាំ សហរដ្ឋ អាម៉េរិក និង មិច ស៉ិក កូ. លោក ណុប ដារ៉ា អនុប្រធាន ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន ប្រចាំ តំបន់ ឆ្នេរ ខាងលិច និង លោក ហ៊ឹង ប៊ុន ថន ប្រធាន ក្រុមការងារ ប្រចាំ រដ្ឋ វ៉ាស៊ីងតោន និង ប្រតិភូ អម ដំណើរ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី គណៈកម្មាធិការ អនុសាខា ប្រធាន អនុប្រធាន យុវជន សមាជិក សមាជិកា យុវជនបក្ស ប្រជាជន កម្ពុជា ភ្ញៀវ អន្តរជាតិ កុងស៊ុល ទូត និង បណ្តា អង្គ ទូត មួយចំនួន ចូលរួម សរុប ចំនួន អ្នកចូលរួម ៥២៥ នាក់ ៕ មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង មហាផ្ទៃ អំពាវនាវ ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ រួមគ្នា ជួយ ការពារ និង ថែរក្សា សន្តិភាព ដែល រកបាន ដោយ លំបាក បំផុត នេះ សំរាប់ អនាគត កូន ចៅ
( បាត់ដំបង ) ៖ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន ក្រុមក ការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ស្រុក សង្កែ ខេត្ត បាត់ដំបង លោក កុល វីរក្ស នា ព្រឹក ថ្ងៃទី ៨ ខែមករា ឆ្នាំ ២០២ បាន អញ្ជើញ ក្នុង ពិធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៤១ នៃ ទិវា ជ័យជម្នះ ៧ មករា ១៩៧៩ - ២០២០ និង រាប់ បាត ប្រគេ ព្រះសង្ឃ ៤១ អង្គ ដើម្បី ឧទ្ទិស កុសល ដល់ អតីត យុទ្ធ ដែល បាន ពលី ជីវិត ដើម្បី បុព្វហេតុ ជាតិ មាតុភូមិ នៅ វត្ត តា ប៉ុន ឃុំ តា ប៉ុន ស្រុក សង្កែ ខេត្ត បាត់ដំបង ។
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំង និង សមាជិក ក្រុមការងារ ថ្នាក់ ស្រុក ឃុំ ភូមិ សិស្សានុសិស្ស និង ពុទ្ធ បរិស័ទ្ធ ចំនួន ៣វត្ត គឺ វត្ត តា ប៉ុន វត្ត រការ និង វត្ត ន រាចូលរួម ប្រមាណ ៧០០ នាក់ ។
រាជ រដ្ឋាភិបាល យកចិត្តទុកដាក់ លើកស្ទួយ ជីវភាព ប្រជាកសិករ ស្ថេរភាព ថ្លៃក សិផល និង ការពង្រីក ទីផ្សារ កសិផល ឈាន ឆ្ពោះទៅ សម្រេច ចក្ខុវិស័យ កម្ពុជា ឆ្នាំ ២០៣០ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ និង ចក្ខុវិស័យ ឆ្នាំ ២០៥០ ជា ប្រទេស មាន ចំណូល ខ្ពស់ ។
លោក បាន បន្ត ថា ពី សភាពការណ៍ នយោបាយ ការបរទេស ដោយ បាន បញ្ជាក់ ថា យើង ត្រូវ បង្កើត មិត្ត ប្រទេស ផ្សេង ៗ ឲ្យបាន ច្រើន ប្រកាន់ យក ជា ប្រទេស អព្យា ក្រិត្យ និង ពង្រឹង សាមគ្គីភាព ផ្ទៃក្នុង ឲ្យបាន ល្អ ទើប ប្រទេស យើង មាន ភាពរឹងមាំត ទៅ អនាគត់ ផងដែរ ។
បន្ទាប់មក លោក កុល វីរក្ស ក៏ បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ត្រូវ រួមគ្នា ជួយ ការពារ និង ថែរក្សា សន្តិភាព ដែល រកបាន ដោយ លំបាក បំផុត នេះ ឲ្យ ស្ថិតស្ថេរ គង់វង្ស ប្រកបដោយ និរន្តភាព សំរាប់ អនាគត យូរអង្វែង តទៅ ក្រោម ទិស ស្លោក ថា មាន ថ្ងៃ៧ មករា ទើប មាន សន្តិភាព អរគុណ សន្តិភាព មាន សន្តិភាព ទើប មាន អ្វី ៗ ទាំងអស់ ដល់ សព្វ ថ្ងៃ នេះ តែ បើ យើង គ្មាន សន្តិភាព ទេ គឺ គ្មាន សុខ សុវត្ថិភាព សន្តិភាព និង ការអភិវឌ្ឍន៍ នោះ បាន ឡើយ ។
ក្នុង ឱកាស នោះ ដែរ លោក កុល វីរក្ស និង សហការី បាន រាប់ ប្រគេន ព្រះសង្ឃ ៤១ អង្គ ដើម្បី ឧទ្ទិស កុសល ដល់ ថ្នាក់ដឹកនាំ វីរ ជន កម្មាភិបាល យុទ្ធជន ស្នេហាជាតិ ដែល ពលី ជីវិត ក្នុង បុព្វហេតុ ជាតិ មាតុភូមិ បាន ធ្វើឲ្យ ប្រទេសជាតិ ត្រូវបាន រំដោះ ផុត ពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម បាន ឈានដល់ មាន សុខ សន្តិភាព ពេញលេញ និង មាន អភិវឌ្ឍន៍ យ៉ាង ឆាប់រហ័ស ផងដែរ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ០៨ ខែមករា ឆ្នាំ ២០២០ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
មេរៀន ពី ករណី រលំ សំណង់ អគារ
( ប៉េកាំង . ចិន ) ៖ ជា បឋម ខ្ញុំបាទ សូម ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ចំពោះ ជនរងគ្រោះ និង គ្រួសារ នៃ ជនរងគ្រោះ ក្នុង ករណី រលំ សំណង់ អគារ នៅ ព្រះសីហនុ សៀមរាប និង កែប ។ សូម វិញ្ញាណក្ខ័ន្ធ នៃ អ្នកស្លាប់ បាន ដល់ សុគតិភព ចំណែកឯ អ្នក រងរបួស សូម បាន ឆាប់ ជាសះស្បើយ ។
ទន្ទឹមនឹង នេះ ខ្ញុំបាទ សូម សម្តែង នូវ ការគោរព និង កោតសរសើរ ដោយ ស្មោះ អស់ ពី ចិត្ត ចំពោះ ទឹកចិត្ត និង សេចក្តីស្រឡាញ់ ដ៏ ធំធេង របស់ សម្តេច តេជោ ហ៊ុន សែន ចំពោះ ប្រជាជន កម្ពុជា គ្រប់ រូប ។ សម្តេច តេជោ តែងតែ ចាត់ទុក សុខ ទុក្ខ របស់ រាស្រ្ត ជា អាទិភាព គ្រប់ ពេល មិន មែន តែ ពេល ដែល រាស្រ្ត ជួប ទុក្ខលំបាក ប៉ុណ្ណោះ ទេ ។ នេះ ជា សំណាង របស់ ប្រជាជន កម្ពុជា ។
ជាក់ស្តែង ត្រឹមតែ រយៈពេល កន្លះ ឆ្នាំ ចុងក្រោយ នេះ យ៉ាងហោចណាស់ មាន ៣ករណី នៃ ការរលំ សំណង់ អគារ ។ នៅ ថ្ងៃទី ២៣ ខែមិថុនា ឆ្នាំ ២០១៩ មាន ករណី រលំ សំណង់ អគារ កម្ពស់ ៧ជាន់ នៅ ក្រុង ព្រះសីហនុ បាន សម្លាប់ មនុស្ស ២៨ នាក់ និង បង្ករ បួស ២៦ នាក់ ។ នៅ ថ្ងៃទី២ ខែធ្នូ ឆ្នាំ ២០១៩ មាន ករណី រលំ សំណង់ ព្រះវិហារ នៅ ខេត្ត សៀមរាប បាន សម្លាប់ មនុស្ស ៣នាក់ និង បង្ករ បួស ១៣នាក់ ។
ត្រឹម មួយ ខែ បន្ទាប់ គឺ ថ្ងៃទី ៣ ខែមករា ឆ្នាំ ២០២០ នេះ មាន ករណី រលំ សំណង់ អគារ កម្ពស់ ៦ជាន់ មួយ ទៀត នៅក្នុង ខេត្ត កែប បណ្តាលឱ្យ កម្មករ និង កូនក្មេង ៣៦ នាក់ ស្លាប់ និង ២៣ នាក់ រងរបួស ។
តើ អ្វី ខ្លះ ដែល កម្ពុជា អាច រៀន បាន ពី ករណី រលំ សំណង់ អគារ ទាំង នេះ ? មាន រឿង ជាច្រើន ដែល កម្ពុជា អាចនឹង ត្រូវ រៀនសូត្រ ពី បញ្ហា ទាំងនេះ ។ យ៉ាងហោចណាស់ មាន ចំណុច មួយចំនួន ដែល ពលរដ្ឋ ទូទៅ អាច មើលឃើ ញ៖
ទី១៖ ការអនុវត្ត ច្បាប់ និង បទបញ្ញាត្តិ សំណង់ នៅ មាន កម្រិត៖ អត្រា ខ្ពស់ នៃ គម្រោង និង សំណង់ អគារ ដែល បាន ចាប់ផ្តើម សាងសង់ ទាំង មិន ទាន់ មាន ច្បាប់ អនុញ្ញាត បង្ហាញ យ៉ាង ច្បាស់ ពី ចំណុច នេះ ពិសេស ករណី នៅ ក្រុង ព្រះសីហនុ ។ បន្ថែម ពីលើ នេះ ក៏ អាច មាន ករណី ខ្វះខាត លើ ការត្រួតពិនិត្យ បច្ចេកទេស ប្លង់ និង គ្រឿង បង្គំ ការវាយតម្លៃ ផល ប៉ះពាល់ ការវាយតម្លៃ គុណភាព ដី និង អធិការកិច្ច ជាដើម ។ ដូច្នេះ ការពង្រឹង ច្បាប់ គួរតែ ជា រឿង អាទិភាព ។
ទី ២៖ អំពើពុករលួយ ក្នុង វិស័យ សំណង់៖ ករណី ប្រធាន មន្ទីរ និង បក្ខពួក ក្នុង មន្ទីរ សុរិយោដី នៅ ខេត្ត ពោធិ៍សាត់ ជា មេរៀន មួយ ដ៏ ល្អ ។ ក្រសួង សាមី គួរតែ បន្ថែម ការត្រួតពិនិត្យ និង ដុស ក្រែល មន្ត្រី បែប នេះ ឱ្យ បាន កាន់តែ ច្រើន ។ សេវា រត់ ការ ក្រៅ ផ្លូវការ ក៏ គួរតែ ត្រូវបាន កាត់បន្ថយ ជា អតិបរមា ។
ទី ៣៖ សុវត្ថិភាព ការងារ ក្នុង វិស័យ សំណង់ នៅ ទាប៖ ប្រព័ន្ធ សុវត្ថិភាព ការត្រួតពិនិត្យ មុន ចូល - ចេញ ការដ្ឋាន និង ចំណេះដឹង កម្មករ សំណង់ ស្តី អំពី សុវត្ថិភាព នៅ មាន កម្រិត ។ រដ្ឋ និង ក្រុមហ៊ុន គួរតែ រឹតបន្តឹង និង បណ្តុះបណ្តាល ចំណេះដឹង មូលដ្ឋាន ស្តីពី សុវត្ថិភាព ក្នុង ទីតាំង ការងារ ។
មុន ចូលក្នុង ការដ្ឋាន សំណង់ កម្មករ ទាំងអស់ ត្រូវតែ មាន ពាក់ ឧបករណ៍ សុវត្ថិភាព ដូចជាមួក ការពារ និង ស្រោម ដៃ ជាដើម ។ សំណង់ ដែល ប្រើ រយៈពេល យូរ លើ ការសាងសង់ គួរតែ ផ្តល់ កន្លែង ស្នាក់ នៅ ដល់ កម្មករ នៅ ទីតាំង ខាងក្រៅ នៃ ទីតាំង សំណង់ ដែល កំពុង សាងសង់ ។ ពិសេស កម្មករ សំណង់ គួរតែ ទទួលបាន ការគាំពារ ផ្នែក សង្គមកិច្ច យ៉ាងហោចណាស់ មាន ការធានារ៉ាប់រង រយៈពេល ខ្លី ជាដើម ។
ទី ៥៖ មន្ត្រី ទទួលបន្ទុក និង ជាប់ពាក់ព័ន្ធ មួយ ចំនួន នៅតែ បង្ក ការលំបាក ដល់ ថ្នាក់ដឹកនាំ ប្រទេ ស៖ ប្រសិនបើ ស្រឡាញ់ ថ្នាក់ដឹកនាំ និង ប្រជាជន សូម ចូលរួម បំពេញ ការងារ របស់ ខ្លួន ប្រកបដោយ ទំនួល ខុសត្រូវ ខ្ពស់ ។ ទង្វើ ខ្វះ ទំនួល ខុសត្រូវ របស់ មន្ត្រី មួយចំនួន មិន ត្រឹមតែ ធ្វើឱ្យ ថ្នាក់ដឹកនាំ នឿយហត់ ជាមួយ ប៉ុណ្ណោះ ទេ តែ ថែមទាំង បាន បំផ្លាញ ទឹកចិត្ត រាស្រ្ត ចំពោះ ថ្នាក់ដឹកនាំ ទៀតផង ៕
( លោក យ៉េន យ៉ាត អ្នកស្រាវជ្រាវ ថ្នាក់ ក្រោយ បណ្ឌិត នៅ សាកលវិទ្យាល័យ ប៉េកាំង )
ចិន អំពាវនាវ ឲ្យ គ្រប់ ភាគី អត់ធ្មត់ និង ព្យាយាម ដោះស្រាយ ជម្លោះ ដោយ សន្តិវិធី ក្រោយ អ៉ីរ៉ង់ បាញ់ មីស៉ីល សងសឹក លើ អាមេរិក
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ១៩ករណី ក្នុង នោះ មាន ករណី ប្រើប្រាស់ ១៣ករណី និង ជួញដូរ ៣១ ករណី ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៤៥ នាក់ ។
ការបាញ់ មីស៊ីល រាប់ សិប គ្រាប់ ទៅ លើ មូលដ្ឋាន ទ័ព អាមេរិក ចំនួន ពីរ កន្លែង ក្នុង ទឹកដី អ៊ីរ៉ាក់ គឺជា សារ បញ្ជាក់ ថា អ៊ីរ៉ង់ ពិតជា ពិបាក ទប់ កំហឹង បំផុត ហើយ ប្រទេស នេះ ក៏ ទំនងជា មិន ខ្លាច អាមេរិក តបត វិញ នោះ ដែរ ប្រសិនបើ ស្ថានការណ៍ កាន់តែ អាក្រក់ ខ្លាំង ជាង នេះ ។ ប៉ុន្តែ សមត្ថភាព ជាក់ស្តែង នៃ យោធា អ៊ីរ៉ង់ ពិតជា មិន អាច ទប់ទល់ ជាមួយ អាមេរិក នោះ ឡើយ បើសិនជា យើង មើល លើ ក្រដាស ។
តើ សង្រ្គាម រវាង សហរដ្ឋ អាមេរិក និង សាធារណរដ្ឋ អ៊ីស្លាម អ៊ីរ៉ង់ អាចនឹង ផ្ទុះឡើង ដែរ ឬ ទេ ? ចម្លើយ គឺ ងាយ នឹង ឆ្លើយ បំផុត នោះ គឺ សង្រ្គាម អាចនឹង ផ្ទុះឡើង ប៉ុន្តែ មិន មែន ពេលនេះ ហើយក៏ មិន មាន នរណា ដឹង ថា នៅ ពេលណា នោះ ដែរ ។ ប៉ុន្តែ បើ សង្រ្គាម ផ្ទុះ មែន អ៊ីរ៉ង់ មិន មែន ជា ដៃគូ របស់ អាមេរិក ដែល ជា មហាអំណាច យោធា លេខ មួយ នៅលើ ពិភពលោក បាន ឡើយ ។
ខាងក្រោម នេះ គឺ ការប្រៀបធៀប ត្រួស ៗ រវាង កម្លាំង យោធា អាមេរិក និង អ៊ីរ៉ង់៖
យ៉ាងណា ក៏ដោយ ការរៀបរាប់ អំពី សក្កានុពល យោធា ជាក់ស្តែង រវាង ប្រទេស ទាំង ពីរ មិន អាច បង្ហាញ អំពី ភាពឈ្នះ ឬ ចាញ់ សង្គ្រាម ដែល អាច ទៅ រួច ទាំងស្រុង នោះ ឡើយ ខណៈ កត្តា សំខាន់ ៗ ផ្សេង ទៀត ដូចជា យុទ្ធសាស្ត្រ យោធា ទីតាំង ភូមិសាស្ត្រ និង ការជួយ បន្ថែម ពីក្រោយ ខ្នង ឬ ដោយ ចំពោះ ពីសំណាក់ បណ្តា សម្ព័ន្ធមិត្ត នៃ ភាគី ជម្លោះ រៀង ៗ ខ្លួន នោះ ក៏ ចាំបាច់ ដែល អាច បង្កើន កម្លាំង ប្រទេស នីមួយ ៗ នៅក្នុង ពេល ផ្ទុះ សង្គ្រាម នោះ ផងដែរ ។
គួរ ជម្រាប ថា ភាពតានតឹង រវាង សហរដ្ឋ អាមេរិក និង អ៊ីរ៉ង់ បាន ផ្ទុះឡើង ចាប់តាំងពី សហរដ្ឋ អាមេរិក ចាប់ផ្ដើម ផែនការ ដាក់ទណ្ឌកម្ម ឡើងវិញ ប្រឆាំង ទីក្រុង តេហេរ៉ង់ កាលពី ចុង ឆ្នាំ ២០១៨ ក្រោយ ដក ខ្លួន ចេញ ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ឆ្នាំ ២០១៥ ។ សហរដ្ឋ អាមេរិក តាមរយៈ ទីភ្នាក់ងារ ស៊ើបការណ៍ សម្ងាត់ របស់ ខ្លួន កាលពី ខែឧសភា ឆ្នាំ ២០១៩ បាន អះអាង ថា ខ្លួន បាន ដឹង អំពី ផែនការសម្ងាត់ របស់ អ៊ីរ៉ង់ ដែល កំពុង ត្រៀម វាយប្រហារ មក លើ សម្ព័ន្ធមិត្ត អាមេរិក នៅក្នុង តំបន់ មជ្ឈិ បូព៌ា ។
ការលើកឡើង របស់ ប្រធាន គណបក្ស យុវជន កម្ពុជា បាន ធ្វើឡើង នេះ ក៏ ស្រប ពេល ដែល កម្ពុជា បាន នឹង កំពុង បង្ហោះ សារ ថ្លែង « អរគុណ សន្តិភាព » ជា បន្តបន្ទាប់ ដោយសារតែ សន្តិភាព បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ សម័យ នេះ ទទួល ផ្លែ ផ្កា គ្រប់ បែបយ៉ាង ហើយ មាន ឱកាស ជួបជុំ ក្រុមគ្រួសារ នៅក្នុង ឱកាស បុណ្យ ទាន ក៏ ដូចជា ឱកាស ផ្សេង ៗ ទៀត ។
បន្ទាប់ពី ដាក់ចេញ នូវ នយោបាយ ឈ្នះ ឈ្នះ ចាប់តាំងពី ឆ្នាំ ១៩៩៨ រហូតមកដល់ ពេល បច្ចុប្បន្ន នេះ កម្ពុជា បាន ស្គាល់ នូវ សន្តិភាព ពេញលេញ រយៈពេល ២១ ឆ្នាំ មកហើយ ជាមួយនឹង ការបោះជំហាន អភិវឌ្ឍ ប្រទេស ជាបន្ទាប់ ។ ជាមួយគ្នា នេះ ប្រជាពលរដ្ឋ ក៏ រស់ នៅ សុខ សប្បាយ ជាមួយនឹង កំណើន ជីវភាព កាន់តែ ល្អ ប្រសើរ បន្តិច ម្តង ៗ ផងដែរ ។
កាលពី អំឡុង ចូល ឆ្នាំ សកល ២០២០២ កន្លងទៅ នេះ បណ្តា ក្រសួង ស្ថាប័ន មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ វិស័យ ឯកជន និង ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស បាន នឹកឃើញ ដល់ សន្តិភាព ដែល ថ្នាក់ដឹកនាំ កម្ពុជា ខិតខំ រក មក ដោយ លំបាក និង បាន បង្ហោះ សារ ថ្លែង « អរគុណ សន្តិភាព » ជា បន្តបន្ទាប់ ដោយសារតែ សន្តិភាព បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ សម័យ នេះ ទទួល ផ្លែ ផ្កា គ្រប់ បែបយ៉ាង ហើយ មាន ឱកាស ជួបជុំ ក្រុមគ្រួសារ នៅក្នុង ឱកាស បុណ្យ ទាន ក៏ ដូចជា ឱកាស ផ្សេង ៗ ទៀត ៕
អគ្គ នាយកដ្ឋាន ពន្ធដារ ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការបាត់ វិញ្ញាបនបត្រ សម្គាល់ សិទ្ធិ កាន់កាប់ អចលន វត្ថុ នៅ សាខា ពន្ធដារ ក្នុង រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការបាត់ វិញ្ញាបនបត្រ សម្គាល់ សិទ្ធិ កាន់កាប់ អចលន វត្ថុ នៅ សាខា ពន្ធដារ ខណ្ឌ ក្នុង រាជធានី ភ្នំពេញ ។
សេចក្ដីជូនដំណឹង របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ នេះ បាន បញ្ជាក់ ថា ដោយសារ មាន កំហុស ដោយ អចេតនា របស់ សាខា ពន្ធដារ ខណ្ឌ មួយ ចំនួន នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ធ្វើឲ្យ បាត់ វិញ្ញាបនបត្រ សម្គាល់ សិទ្ធិ កាន់កាប់ អចលន វត្ថុ « ច្បាប់ ដើម »៕
វិញ្ញាបនបត្រ សម្គាល់ សិទ្ធិ កាន់កាប់ អចលន វត្ថុ សម្រាប់ សម្គាល់ ក្បាល ដី ទាំងនោះ ស្ថិត នៅក្នុង ទីតាំង ភូមិសាស្ត្រ ដូច មាន ក្នុង ការតារាង ខាងក្រោម៖ ខេត្ត ប៉ៃលិន បិទ ការប្រកួត កីឡា បាល់ទាត់ ដណ្តើម ពានរង្វាន់ អភិបាល ខេត្ត ដើម្បី អបអរសាទរ ខួប ទី ៤១ ទិវា ជ័យជម្នះ ៧ មករា
( ប៉ៃលិន ) ៖ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន នា ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ ការប្រកួត កីឡា បាល់ទាត់ ដើម្បី អបអរសាទរ ខួប ទី ៤១ ទិវា ជ័យជម្នះ ៧មក រា ១៩៧៩ ដល់ ៧ មករា ២០២០ ដែល ជា ថ្ងៃ កំណើត ទី ពីរ របស់ ប្រជាជន កម្ពុជា ទាំងមូល នៅ ទីលាន តារាង បាល់ទាត់ សួន រីករាយ ដែល ស្ថិត នៅ ភូមិ ខ្លុង សង្កាត់ អូរ តាវ៉ៅ ក្រុង ប៉ៃលិន ខេត្ត ប៉ៃលិន ។
លោក ផាន់ ចាន់ ធុល បាន ឲ្យដឹង ថា បច្ចុប្បន្ន នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ សែន ជា ប្រមុខ ដឹកនាំ បាន នឹង កំពុង យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ វិស័យ កីឡា គ្រប់ ប្រភេទ ធ្វើឲ្យ វិស័យ កីឡា នៅ ទូទាំង ប្រទេស មាន ការរីកចម្រើន យ៉ាង ខ្លាំង ហើយ បាន ទទួល ជ័យលាភី ជា បន្តបន្ទាប់ លើ ឆាក អន្តរជាតិ ហើយ សមិទ្ធផល ទាំងអស់ នេះ គឺ កើត ចេញ ពី ថ្ងៃ ជ័យ ជំនះ ៧ មក រា ១៩៧៩ ដែល ជា ថ្ងៃ កំណើត ទី២ របស់ ប្រជាជន កម្ពុជា និង ក្រោម នយោបាយ ឈ្នះ ៗ របស់ សម្តេច ដែល មិន អាច កាត់ថ្លៃ បាន ។
នៅក្នុង ឱកាស នោះ ដែរ អភិបាល ខេត្ត ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត និង សប្បុរសជន ដែល បាន ចូលរួម និង ឧបត្ថម្ភ គាំទ្រ លើកស្ទួយ វិស័យ កីឡា ក្នុង ខេត្ត របស់ យើង ឲ្យ មាន ការរីកចម្រើន ជាពិសេស បាន ផ្តល់ ឱកាស ដល់ យុវជន បាន បង្ហាញ នូវ សមត្ថភាព បង្កើន នូវ បទពិសោធន៍ ដើម្បី អភិវឌ្ឍន៍ ខ្លួន ឲ្យ ក្លាយជា កីឡាករ ដ៏ ល្អ សម្រាប់ ឆ្ពោះ ទៅ ការប្រកួត ថ្នាក់ ជាតិ ។
លោក ផាន់ ចាន់ ធុល ក៏ បាន ផ្តាំផ្ញើ ដល់ ប្អូន ៗ ក្មួយ ៗ ក្រុម កីឡាករ ទាំងអស់ ត្រូវ ខិតខំ ប្រកួត តាម លក្ខណៈ បច្ចេកទេស និង ត្រូវ មាន សាមគ្គីភាព យោគយល់ អធ្យាស្រ័យ គ្នា ទៅ វិញ ទៅ មក ព្រោះថា ការប្រកួត តែងតែ មាន ចាញ់ និង ឈ្នះ ហើយ ជៀស មិន ផុត ពី ការប៉ះពាល់ គ្នា បន្តិចបន្តូច មិន ខាន ឡើយ ជាពិសេស ត្រូវ ជៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន ហើយ នាំគ្នា លេង កីឡា ដើម្បី សុខភាព ។
បើ តាម របាយការណ៍ របស់ លោក តង់ ធារ៉ា ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ប៉ៃលិន បាន ឲ្យដឹង ថា ការប្រកួត ដណ្តើម ពានរង្វាន់ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត គឺ ដើម្បី អបអរសាទរ ខួប ទី ៤១ ទិវា ជ័យជម្នះ ៧មករា ១៩៧៩ - ៧មករា ២០២០ នា ពេលនេះ គឺ បាន ប្រព្រឹត្តទៅ អស់ រយៈពេល ០៧ ថ្ងៃ ដោយ គិត ចាប់ពី ថ្ងៃទី ០១ មករា ដល់ ថ្ងៃទី ០៧ មករា ឆ្នាំ ២០២០ ដោយ ការប្រកួត នេះ មាន ក្រុម កីឡាករ ចូលរួម ចំនួន ១១ក្រុម ។
ថ្លែង ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន នៅ ទីស្តីការ ក្រសួង ការបរទេស នៅ ព្រឹក ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ នេះ លោក កុយ គួង បាន អះអាង ថា កម្ពុជា ព្រួយបារម្ភ យ៉ាង ខ្លាំង ចំពោះ សភាពការណ៍ ដ៏ តានតឹង រវាង អ៉ីរ៉ង់ - អាមេរិក នៅ ពេល ថ្មី ៗ នេះ ។ លោក បន្ត ថា ស្ថានភាព ប្រទេស អ៉ីរ៉ង់ ក៏ ដូចជា ទំនាក់ទំនង រវាង អាមេរិក និង អ៉ីរ៉ង់ នៅ ពេល ថ្មី ៗ នេះ គឺ ប្រទេស កម្ពុជា យើង ក៏ ដូចជា ប្រទេស ដទៃ ទៀត ដែរ បាន និង កំពុង តាមដាន ដោយ យកចិត្តទុកដាក់ បំផុត ។
( ភ្នំពេញ ) ៖ វិថី ដ៏ សំខាន់ មួយ នៅក្នុង ទីក្រុង ដាកា ប្រទេស បង់ក្លាដេស នឹង ប្រើ ព្រះនាម ព្រះបរម រតន កោដ្ឋ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ នរោត្តម សីហនុ ព្រះមហា វីរក្សត្រ ខ្មែរ ។ នេះ បើ យោង តាម លោក កុយ គួង អ្នកនាំពាក្យ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ។
ការបញ្ជាក់ របស់ លោក កុយ គួង បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃពុធ ទី ០៨ ខែមករា ឆ្នាំ ២០២០ បន្ទាប់ពី ជំនួប រវាង ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ក្រសួង ការបរទេស និង គណៈប្រតិភូ កិច្ចការ បរទេស នៃ សភា បង់ក្លាដេស ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ នៅ ទីស្តីការ ក្រសួង ។
បើ តាម អ្នកនាំពាក្យ ក្រសួង ការបរទេស ក្នុង ជំនួប នេះ ភាគី ទាំង ពីរ បាន លើកឡើង ពី ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ កាន់តែ ប្រសើរឡើង ។ លោក បន្ត ថា ជាពិសេស នោះ កម្ពុជា បាន យក ឈ្មោះ លោក សេនូជី ប៊ូ រ៉ាម៉ាន់ ទៅ ប្រើប្រាស់ សម្រាប់ ហៅ ផ្លូវ ជាតិ លេខ ៣៣៧ នៅ រាជធានី ភ្នំពេញ ចំណែកឯ បង់ក្លាដេស វិញ បាន យក ព្រះនាម ព្រះបរម តន កោដ្ឋ ទៅ ប្រើប្រាស់ សម្រាប់ ហៅ វិថី សំខាន់ មួយ នៅ ទីក្រុង ដាកា ។
« នៅ ក្រុង ដាកា នោះ គេ ដាក់ ឈ្មោះ ថា វិថី ព្រះនរោត្តម សីហនុ ហើយ គេ គ្រោង សម្ពោធ នៅ ដើម ឆ្នាំ ហ្នឹង ហើយ វិថី នៅ ក្រុង ភ្នំពេញ យើង លេខ ៣៣៧ មាន ឈ្មោះ វិថី សេក មូជី ប៊ួ រ៉ាម៉ាន់ ដែល វិថី ហ្នឹង គ្រោង នឹង សម្ពោធ ដើម ឆ្នាំ ហ្នឹង ដែរ » ។ នេះ ជា ការបញ្ជាក់ របស់ លោក កុយ គួង ៕ កម្ពុជា - វៀតណាម បន្ត ស្វែងរក និង ធ្វើ មាតុភូមិ និវត្តន៍ អដ្ឋិធាតុ យុទ្ធជន កងទ័ព ស្ម័គ្រចិត្ត វៀតណាម ដែល ពលី ជីវិត ក្នុង សម័យ សង្គ្រាម នៅ ខេត្ត ប៉ៃលិន
( ប៉ៃលិន ) ៖ លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន បាន ប្រជុំ ពិភាក្សា ការងារ ជាមួយ គណៈប្រតិភូវៀតណាម ដឹកនាំ ដោយ លោក ផាម វ៉ាន់ កាញ់ អនុប្រធាន គណៈកម្មាធិការ ប្រជាជន ខេត្ត ឡុង អាន នៃ សាធារណៈ រដ្ឋ សង្គម និយម វៀតណាម ដើម្បី ពិភាក្សា ពី ផែនការសហប្រតិបត្តិការ ស្វែងរុករក គាស់ និង ធ្វើ មាតុភូមិ និវត្តន៍ អដ្ឋិធាតុ យុទ្ធជន កងទ័ព ស្ម័គ្រចិត្ត វៀតណាម ដែល បាន ពលី ជីវិត ក្នុង សម័យ សង្គ្រាម នៅ កម្ពុជា ដំណាក់កាល ទី១៩ ( រដូវ ប្រាំង ឆ្នាំ ២០១៩ - ២០២០ ) កាលពី ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ២០២០ ។
លោក ផាន់ ចាន់ ធុល បាន បន្ដ ទៀត ថា ដូច្នេះ អាជ្ញាធរ គ្រប់ ជាន់ ថ្នាក់ និង កងកម្លាំងប្រដាប់ អាវុធ ពាក់ព័ន្ធ ព្រមទាំង ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ទាំងអស់ ត្រូវ បន្ត ខិតខំ សហប្រតិបត្តិការ និង បង្ក លក្ខណៈ ងាយស្រួល ដល់ ដំណើរការស្វែងរុករក គាស់ អដ្ឋិធាតុ កងទ័ព វៀតណាម ដែល បាន ពលី ជីវិត នៅ ទឹកដី ខេត្ត ប៉ៃលិន ដែល នៅ សេសសល់ បន្ត ទៀត ដើម្បី ធ្វើ មាតុភូមិ និវត្តន៍ ទៅ ប្រទេស វៀតណាម វិញ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ អាជ្ញាធរ ខេត្ត ប៉ៃលិន គ្រប់ លំដាប់ថ្នាក់ និង កងកម្លាំង គ្រប់ ប្រភេទ ព្រមទាំង ប្រជាពលរដ្ឋ ខេត្ត ប៉ៃលិន ទាំងអស់ ដែល កន្លងមក បាន សហការ ល្អ ជាមួយ ក្រុមការងារ គណៈកម្មាធិការ ប្រជាជន ខេត្ត ឡុង អាន ធ្វើឲ្យ ដំណើរការ រុករក អ ដិ្ឋ ធាតុ កងទ័ព វៀតណាម ទទួលបាន ជោគជ័យ ជា បន្តបន្ទាប់ ។
គួរ បញ្ជាក់ ថា ការរុករក ជីក គាស់ អដ្ឋិធាតុ កងទ័ព វៀតណាម ដែល បាន ពលី ជីវិត ក្នុង សម័យ សង្គ្រាម ក្នុង ភូមិសាស្ត្រ ខេត្ត ប៉ៃលិន ចាប់ពី ឆ្នាំ ២០០៥ ដល់ បច្ចុប្បន្ន សរុប ចំនួន ១០៥ អដ្ឋិធាតុ ដោយឡែក នៅ ឆ្នាំ ២០១៩ - ២០២០ នេះ មាន ព័ត៌មាន ចំនួន ៩ទីតាំង សរុប ចំនួន ២៧ អដ្ឋិធាតុ ដែល ក្នុង នោះ ក្រុង ប៉ៃលិន មាន ៤ទីតាំង ចំនួន ១០អដ្ឋិធាតុ និង ស្រុក សាលា ក្រៅ មាន ៥ទីតាំង ចំនួន ១៧អដ្ឋិធាតុ ៕
លោក ម៉ម ប៊ុន នាង៖ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន គឺ មិន អនុញ្ញាតឲ្យ បុគ្គល ណា ម្នាក់ បំផ្លាញ សុខ សន្តិភាព នៅ កម្ពុជា បាន ឡើយ
ការលើកឡើង របស់ លោក ម៉ម ប៊ុន នាង បាន ធ្វើឡើង ខណៈ លោក ចុះ ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា ឃុំ និង បងប្អូន ប្រជាពលរដ្ឋ នៅ ឃុំ គោក ត្រប់ និង ឃុំ ត្រពាំង វែង ខេត្ត កណ្តាល សរុប ចំនួន ៤៣០ នាក់ ក្នុង ឱកាស អបអរសាទរ ខួប លើក ទី ៤១ ទិវា ជ័យជម្នះ ៧មករា ១៩៧៩ - ២០១៩ នា ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ ។
លោក ម៉ម ប៊ុន នាង បាន បន្ថែម ថា ការអភិវឌ្ឍ នៅក្នុង ប្រទេស កម្ពុជា យើង មិន មែន ជា ភាព ចៃដន្យ នោះ ទេ ពោលគឺ បច្ចុប្បន្ន មាន អ្នក វិនិយោគទុន បរទេស យ៉ាង ច្រើន បាន ចូលមក វិនិយោគ នៅ កម្ពុជា នោះ ក៏ ព្រោះតែ ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ មាន សេរីភាព នយោបាយ និង សេរីភាព ម៉ាក្រូ សេដ្ឋកិច្ច ហើយ កម្ពុជា បាន ចែង ច្បាប់ លើកទឹកចិត្ត នៅក្នុង ច្បាប់ វិនិយោគ ផងដែរ ។
ទន្ទឹមនឹង នេះ ដែរ លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម រក្សា នូវ ប្រពៃណី សាមគ្គីភាព ឯកភាព ជា ក្រោម ដំបូល នៃ សុខ សន្តិភាព ក្រោម ការដឹកនាំ ដោយ សម្ដេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ក្នុង ឱកាស នោះ ដែរ លោក ប្រធាន ក៏ បាន ឧបត្ថម្ភ នូវ ថវិកា ជូន ទៅដល់ សមាជិក សមាជិកា ក្រុមប្រឹក្សា ឃុំ ទាំង ពីរ និង បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន ចូល រូម សរុប ៤៣០ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន ថវិកា មួយ ចំនួន ព្រមទាំង បាន ឧបត្ថម្ភ កសាង នូវ សមិទ្ធផល នានា ទៅ តាម ការសំណូមពរ របស់ បងប្អូន ប្រជាពលរដ្ឋ ផងដែរ ក្នុង ឃុំ ត្រពាំង វែង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ៕ បណ្ណាល័យ អេឡិចត្រូនិក មួយ បណ្ដុំ ទៅ ដោយ ព័ត៌មាន និង មេរៀន ល្អ ៗ សម្រាប់ អ្នកអាន ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ
លោក ជា ឌីណា បាន បន្ដ ទៀត ថា ស្ថិត នៅក្នុង តំណាក់កាល ដែល ប្រទេស កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ ហើយ បាន នឹង កំពុង មាន ការអភិវឌ្ឍ រីកចម្រើន លើ គ្រប់ វិស័យ ក្នុង នោះ វិស័យ បច្ចេកវិទ្យា ក៏ មាន ការរីកចម្រើន យ៉ាង ខ្លាំង និង បាន ដើរ តួនាទី យ៉ាង សកម្ម ដល់ ការលើកកម្ពស់ ប្រសិទ្ធភាព ការងារ នៅ តាម បណ្តា ក្រសួង ស្ថាប័ន អង្គភាព អាជីវកម្ម ព្រមទាំង អាជីវករទូទៅ ផងដែរ ។
