( ភ្នំពេញ ) ៖ កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ បាន បើក ប្រតិបត្តិការ បង្ក្រាប ករណី ចាប់ ជំរិត និង គំរាម ទារ ប្រាក់ ដែល ប្រព្រឹត្ត ដោយ ជនជាតិ វៀតណាម ទៅ លើ ជនជាតិ វៀតណាម នៅ សង្កាត់ ព្រលឹត ខណ្ឌ ៧មករា ដោយ ចាប់ខ្លួន បាន ជនល្មើស ៣នាក់ និង រំដោះ ជនរងគ្រោះ ម្នាក់ ។
លោក វរសេនីយ៍ ឯក ជា វ វិបុល អនុប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២០ នេះ ថា ប្រតិបត្តិការ នេះ ធ្វើឡើង ក្រោម ការបញ្ជា ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ . លោក ឧត្តមសេនីយ៍ ឯក អ៉ិន បូរ៉ា អគ្គ ស្នងការ រង និង មាន ការចង្អុលបង្ហាញ ចំ គោលដៅ ពី លោក ឧត្តមសេនីយ៍ ឯក ង៉េង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ។
ភា្លម ៗ បន្ទាប់ពី ទទួលបាន ពាក្យបណ្ដឹង កម្លាំង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ នៃ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ សហការ ជាមួយ កម្លាំង ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ក្រោម ការសម្របសម្រួល ពី តំណាង អយ្យការ ទើប រហូតដល់ ម៉ោង ជាង ១២ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ កម្លាំង ជំនាញ បាន ឈានដល់ ការចាប់ខ្លួន ជនសង្ស័យ ៣នាក់ និង រំដោះ ជនរងគ្រោះ ម្នាក់ នៅ ផ្ទះសំណាក់ ហេង ឡុង១ ភូមិ៤ ក្រុម ២២ ផ្លូវ លេខ ១១១ សង្កាត់ បឹង ព្រលឹត ខណ្ឌ ៧មករា ។
បើ តាម លោក វរសេនីយ៍ ឯក ជា វ វិបុល បន្ទាប់ពី ស្ដាប់ ចម្លើយ សារភាព របស់ ជនសង្ស័យ និង ការបំភ្លឺ របស់ ជនរងគ្រោះ សមត្ថកិច្ច ជំនាញ សន្និដ្ឋាន បាន ថា នេះ ពិតជា ករណី ចាប់បង្ខាំង មនុស្ស ដោយ ខុស ច្បាប់ និង គំរាម ទារ ប្រាក់ ប្រាកដ មែន ។
បន្ទាប់ពី បញ្ចប់ ការសួរនាំ នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២០ នេះ កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ បាន បញ្ជូន ជនសង្ស័យ ទាំង ៣នាក់ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ផ្ដន្ទាទោស តាម ផ្លូវ ច្បាប់ ៕ តំណាង កាកបាទ ក្រហម នាំយក សម្ភារ និង ថវិកា ចូលរួម រំលែក ទុក្ខ សព លោក រស់ ប៊ុន ណាន ស្នងការ រង ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន នា ថ្ងៃទី ២៥ ខែមករា នេះ បាន ចាត់ ឱ្យ មន្ត្រី ចូលរួម រំលែក ទុក្ខ និង នាំយក គ្រឿង ឧបភោគ - បរិភោគ ព្រមទាំង បច្ច័យ ចូល បុណ្យ សព លោក ឧត្ដមសេនីយ៍ ទោ រស់ ប៊ុន ណាន ស្នងការ រង នគរបាល ខេត្ត ពោធិ៍សាត់ ។
លោក ឧត្ដមសេនីយ៍ ទោ រស់ ប៊ុន ណាន ត្រូវ ជា កូន របស់ លោកស្រី ហួន ច័ន្ទ បូរ៉ា នាយក នៃ នាយកដ្ឋាន ទំនាក់ទំនង កាកបាទ ក្រហម កម្ពុជា ដែល បាន ទទួលមរណភាព កាលពី ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២០ នា វេលា ម៉ោង ១៧ល្ងាច នៅ គេហដ្ឋាន នៃ សព ស្ថិត ក្នុង ភូម ពោធិ៍តា គួយ សង្កាត់ លលកស ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ក្នុង ជន្មាយុ ៥៥ ឆ្នាំ ដោយ រោគា ពាធ ។
ក្នុង សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ លោក វេជ្ជបណ្ឌិត អ៊ុយ សំអាត នាយក នៃ នាយកដ្ឋាន គ្រប់គ្រង គ្រោះមហន្តរាយ បាន ពាំនាំ ប្រសាសន៍ របស់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ បំផុត ក្នុង ក្តី សោកស្តាយ ឥត គណនា ចំពោះ ក្រុមគ្រួសារ សព ដែល បាន បាត់បង់ កូន និង បិតា ជាទីគោរព ស្រឡាញ់ ដែល ក្នុង ជីវិត របស់ លោក បាន ធ្វើ ពលិកម្ម ជាច្រើន បាន បូជា សព្វ បែប យ៉ាង ទាំង កម្លាំង កាយ ចិត្ត មិន គិត ពី ការនឿយហត់ លំបាក លំបិន ជម្នះ រាល់ ឧបសគ្គ នានា ដើម្បី សង្គមជាតិ និង ក្រុមគ្រួសារ ។
ជាមួយគ្នា នេះ ដែរ លោក វេជ្ជបណ្ឌិត បាន បួងសួង ដល់ វត្ថុ ស័ក្ត សិទ្ធិ ក្នុង លោក និង តេជះ បារមី នៃ ព្រះពុទ្ធ ព្រះធម៌ ព្រះសង្ឃ សូម តាម ជួយ បីបាច់ ថែរក្សា ដល់ ដួង វិញ្ញាណក្ខន្ធ របស់ លោក ឧត្ដមសេនីយ៍ ទោ រស់ ប៊ុន ណាន សូម ទៅកាន់ សុគតិភព ជានិច្ច និរន្តរ៍ ត រៀង ទៅ ។
លោកស្រី ហួន ច័ន្ទ បូរ៉ា ត្រូវ ជា ម្តាយ នៃ សព បាន សម្តែង នូវ ក្តី គោរព ដឹងគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល តែងតែ យកចិត្តទុកដាក់ គិត គូរ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ រងគ្រោះ ឬ ជួប ការលំបាក ដោយ មិន រើសអើង មិន ប្រកាន់ វណ្ណៈ ពូជសាសន៍ ពណ៌ សម្បុរ ឬ និន្នាការ នយោបាយ អ្វី ឡើយ ។
សម្ភារៈ ដែល នាំយក មក ចូលរួម រំលែក ទុក្ខ នា ឱកាស នេះ រួម មាន៖ អង្ករ ១២០ គីឡូក្រាម មី ៥កេស ទឹក សុទ្ធ ៥កេស ភេសជ្ជៈ ៥កេស ត្រីខ ៥យួរ និង ថវិកា ៥លាន រៀល ៕ និយ័តករ ទូរគមនាគមន៍ កម្ពុជា៖ ការទទួល លេខ ទូរស័ព្ទ ពី ក្រៅ ប្រទេស មិន ធ្វើឱ្យ បាត់ លុយ ពី ធនាគារ របស់ ម្ចាស់ ទូរស័ព្ទ នោះ ទេ !
ដោយ មិន ដឹង អំពី មូលហេតុ បច្ចេកទេស និង ហានីយ ភ័យ ពិតប្រាកដ ដែល ធ្វើឱ្យ បំពាល់ ដល់ អ្នកប្រើប្រាស់ ទូរស័ព្ទ ចល័ត នៅ ប្រទេស កម្ពុជា ពី ការស៊ីញ៉ូ ហៅ នេះ អ្នកកាន់ គេហទំព័រ និង គណនី បណ្តាញ សង្គម ហ្វេសបុក របស់ បុគ្គល មួយចំនួន បាន បង្ហោះ និង ចុច ស៊ែរ ចែករំលែក ត ៗ គ្នា នូវ សារ បំភ្លៃ បំភ័ន្ត និង បំភ័យ ដល់ សាធារណជន អ្នកប្រើប្រាស់ សេវា ទូរស័ព្ទ ចល័ត ថា « សូម ប្រយ័ត្ន ! សាហាវ ណាស់ គ្រាន់តែ លើក លេខ នេះ ភ្លាម លុយ ក្នុង កុង កាត់ អស់ រលីង ពិតជា សាហាវ កំពូល » ។
ពាក់ព័ន្ធ ការបង្ហោះ សារ ខាងលើ នេះ ពិតជា ការអះអាង មិន ត្រឹមត្រូវ និង មាន លក្ខណៈ បំភ័ន្ត និង បំភ័យ ទាំងស្រុង ។ ធាតុ ពិត នៃ ផល ប៉ះពាល់ ជា បច្ចេកទេស និង ហានីយ ភ័យ ពី ការស៊ីញ៉ូ ហៅ នេះ មិន មាន ផល ប៉ះពាល់ នឹង ធ្វើឱ្យ ខាតបង់ អ្វី ៗ ដូច បាន បញ្ជាក់ ជា អត្ថន័យ នៃ សារ បង្ហោះ របស់ អ្នកកាន់ គេហទំព័រ និង គណនី បណ្តាញ សង្គម ទាំងនោះ ឡើយ ។
តាម ការការស្រាវជ្រាវ ការបកស្រាយ និង ការបញ្ជាក់ ពី បណ្តា ប្រតិបត្តិករ ទូរស័ព្ទ ចល័ត ទាំងអស់ នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា បាន បង្ហាញ ជា លក្ខណៈ បច្ចេកទេស ថា ក្នុង ការលើក ទទួល ឬ ការហៅ ទៅ វិញ លេខ អនាមិក ទាំងនោះ មិន បាន ធ្វើឱ្យ ប៉ះពាល់ ដល់ អ្នកប្រើប្រាស់ ក្នុង ការធ្វើឱ្យ បាត់បង់ ទិន្នន័យ ដែល ផ្ទុក នៅក្នុង ទូរស័ព្ទ ឬ ថវិកា ក្នុង គណនី សេវា ទូរស័ព្ទ ឬ ថវិកា ដែល បាន ផ្ទុក ក្នុង គណនី ធនាគារ របស់ ពួកគាត់ ឡើយ ហើយ អ្វី ដែល ជា ហានីភ័យ ពិតប្រាកដ ជាក់ស្តែង នោះ៖
* ទី ១៖ ក្នុង ករណី អ្នកប្រើប្រាស់ ទូរស័ព្ទ ចល័ត ក្នុង ប្រទេស កម្ពុជា ណា ម្នាក់ បាន លើក ទទួល លេខ អនាមិក ដែល ស៊ីញ៉ូ ហៅ ចូលមក នោះ គឺ មិន បាន ធ្វើឱ្យ បាត់បង់ អ្វី ទាំងអស់ របស់ អ្នកប្រើប្រាស់ នោះ សូម្បីតែ ទិន្នន័យ ផ្ទុក ក្នុង ទូរស័ព្ទ ឬ ថវិកា ផ្ទុក ក្នុង គណនី សេវា ទូរស័ព្ទ ឬ ថវិកា នៅក្នុង គណនី ធនាគារ មាន តែ ធ្វើឲ្យ អ្នក ស៊ីញ៉ូហៅ លេខ អនាមិក នោះ បាត់បង់ ថ្លៃ ហៅ ចេញ ក្រៅ ប្រទេស របស់ ខ្លួន ទៅ វិញ ទេ ព្រោះ មិន មាន បច្ចេកទេស ណា អាច អនុវត្ត ទៅ បាន នៅឡើយ ទេ ។
* ទី ២៖ ក្នុង ករណី អ្នកប្រើប្រាស់ ទូរស័ព្ទ ចល័ត ក្នុង ប្រទេស កម្ពុជា ណា ម្នាក់ បាន ហៅ ត្រលប់ ទៅកាន់ លេខ អនាមិក ដែល ស៊ីញ៉ូ ហៅ ចូលមក នោះ គឺ ធ្វើឱ្យ អ្នកប្រើប្រាស់ នោះ បាត់បង់ ថវិកា ក្នុង គណនី សេវា ទូរស័ព្ទ របស់ គាត់ សម្រាប់ ការសន្ទនា ទូរស័ព្ទ អន្តរជាតិ ឬ ហៅ ទៅ ក្រៅ ប្រទេស ដែល គិត ទៅ តាម អត្រា គិត លុយ របស់ ប្រតិបត្តិករ ទូរស័ព្ទ ក្នុង ស្រុក ដែល អ្នកប្រើប្រាស់ នោះ បាន ជាវ យកមក ប្រើប្រាស់ ក្នុង អត្រា តម្លៃ មួយ គិត ទៅ តាម ទំហំ នាទី សរុប ដែល អ្នកប្រើប្រាស់ នោះ បាន សន្ទនា ។
សូម បញ្ជាក់ បន្ថែម ទៀត ថា បញ្ហា នេះ បាន កើតឡើង ម្តង រួចទៅហើយ នៅក្នុង ឆ្នាំ ២០១៧ ហើយនិយ័តករ ទូរគមនាគមន៍ កម្ពុជា និង ប្រតិបត្តិករ ទូរគមនាគមន៍ បាន ធ្វើ ការបញ្ជាក់ និង បកស្រាយ ម្តង រួចទៅហើយ ។ បាតុភាព នេះ ក៏ បាន ស្ងប់ស្ងាត់ ទៅ វិញ មួយ រយៈ ជាង ពីរ ឆ្នាំ មកហើយ ទើបតែ កក្រើក ឡើង ម្តង ទៀត ក្នុង ប៉ុន្មាន ថ្ងៃ នេះ ទេ ។
ម៉្យាង វិញ ទៀត ចាប់ពី ការបំភ្លឺ និង ការកកើត ហេតុ នៅក្នុង ឆ្នាំ ២០១៧ រហូតមកទល់ ពេលនេះ មិន ទាន់ មាន ករណី ណាមួយ ពិតប្រាកដ ដែល បង្ហាញ ថា មាន អ្នកប្រើប្រាស់ ទូរស័ព្ទ ចល័ត របស់ ប្រជាពលរដ្ឋ កម្ពុជា ណា ម្នាក់ បាន ទទួលបាន ផល ប៉ះពាល់ ពី រឿង នេះ ឡើយ ។
ទោះបីជា យ៉ាងណា និយ័តករ ទូរគមនាគមន៍ កម្ពុជា និង ប្រតិបត្តិករ ទូរគមនាគមន៍ ទាំងអស់ ដែល កំពុង ធ្វើ ប្រតិបត្តិការ សេវា ទូរគមនាគមន៍ នៅ កម្ពុជា កំពុងតែ យកចិត្ត ទុក ធ្វើ ការ នេះ យ៉ាង ម៉ឺងម៉ាត់ ត្រួតពិនិត្យ លើ ផ្នែក បច្ចេកទេស ក្នុង កិច្ចការពារ ផលប្រយោជន៍ អ្នកប្រើប្រាស់ មិន ឱ្យ ទទួល ផល ប៉ះពាល់ ណាមួយ ជា យថាហេតុ ឡើយ ។
ក្រុមការងារ ផ្នែក ឯកជន នៃ វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន ចំនួន ១៣ ក្រុម ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា ចេញ សេចក្តីសម្រេច ទទួលស្គាល់ ដើម្បី ចូលរួម សន្ទនា ដោះស្រាយ បញ្ហា ផ្សេង ៗ ជាមួយ រាជ រដ្ឋាភិបាល ។
ក្រុមការងារ ផ្នែក ឯកជន នៃ វេទិកា រាជ រដ្ឋាភិបាល - ផ្នែក ឯកជន ទាំងនោះ រួម មាន៖
( ភ្នំពេញ ) ៖ យោង តាម លទ្ធផល នៃ ការតាមដាន ត្រួតពិនិត្យ គុណភាព ខ្យល់ របស់ ក្រសួង បរិស្ថាន ស្ថានភាព គុណភាព ខ្យល់ នៅ តាម បណ្តា ខេត្ត នានា នៃ ព្រះរាជាណាចក្រ កម្ពុជា នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ នេះ មាន លក្ខណៈ ល្អ ប្រសើរ ។
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ ក្រសួង បរិស្ថាន៖ ឆ្នាំ ២០១៩ កម្ពុជា នាំចេញ ផល នេសាទ បាន ជាង ១ម៉ឺន តោន ខណៈ ចំណូល បាន ពី ថ្លៃ សួយ សារ ព្រៃឈើ មាន ជិត ៧លាន ដុល្លារ
តាម របាយការណ៍ របស់ ក្រសួង កសិកម្ម បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា រយៈពេល ១២ ខែ ឆ្នាំ ២០១៩ ដែល គិត ចាប់ពី ខែមករា ដល់ ខែធ្នូ ការនាំចេញ ផល នេសាទ ស្រស់ អនុវត្ត បាន ចំនួន ៩.១៩០ តោន បើ ធៀប នឹង ឆ្នាំ ២០១៨ ថយចុះ ចំនួន ៣១០តោន ។ ចំណែក ការនាំចេញ ផល នេសាទ កែច្នៃ អនុវត្ត បាន ចំនួន ៤.៩១០ តោន ថយចុះ ៩០តោន ។
ដោយឡែក សម្រាប់ ចំណូល ដែល បាន ពី ថ្លៃ សួយ សារ ព្រៃឈើ សរុប ចំនួន ជិត ៧លាន ដុល្លារ អាមេរិក ។
របាយការណ៍ ដដែល បាន បន្ត ទៀត ថា សម្រាប់ ឆ្នាំ ២០១៩ សំណុំរឿង បទល្មើស ព្រៃឈើ សត្វ ព្រៃ និង កាប់ រាន ដី ព្រៃ សរុប មាន ចំនួន ១. ២០១ ករណី ដោយ ពិន័យ អន្តរការណ៍ ចំនួន ៥៩៨ ករណី និង បញ្ជូន ទៅ តុលាការ មាន ចំនួន ៦០៣ ករណី ៕
សូម អាន របាយការណ៍ របស់ ក្រសួង កសិកម្ម ទាំង ស្រុង៖ កម្ពុជា នាំចេញ ជ័រ កៅស៊ូ ជិត ៣០ម៉ឺន តោន បាន ចំណូល ជិត ៤០០ លាន ដុល្លារ នៅ ឆ្នាំ ២០១៩
សូម បញ្ជាក់ ថា រយៈពេល ពេញ មួយ ឆ្នាំ ២០១៨ កម្ពុជា បាន នាំចេញ ជ័រ កៅស៊ូ ជាង ២១ម៉ឺន តោន ទទួលបាន ចំណូល ជិត ៣០០ លាន ដុល្លារ អាមេរិក ។ ជ័រ កៅស៊ូ កម្ពុជា បាន នាំចេញ ទៅកាន់ ប្រទេស ចិន វៀតណាម សង្ហឹ បុរី និង ម៉ាឡេស៊ី ៕
សម្តេច តេជោ យល់ព្រម ឱ្យ ប្តូរ ឈ្មោះ ក្រសួង « ឧស្សាហកម្ម និង សិប្បកម្ម » ទៅជា « ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ »
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន ឯកភាព ឱ្យ ប្តូរ ឈ្មោះ ក្រសួង « ឧស្សាហកម្ម និង សិប្បកម្ម » ទៅជា « ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ » ។ ការឯកភាព បាន ធ្វើឡើង បន្ទាប់ពី មាន សំណើ របស់ លោក ទេសរដ្ឋមន្ត្រី ចម ប្រសិទ្ធ ដែល ជា រដ្ឋមន្ត្រី ក្រសួង ឧស្សាហកម្ម និង សិប្បកម្ម នា ពេល បច្ចុប្បន្ន នេះ ។
យោង តាម លិខិត របស់ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ផ្ញើ ជូន លោក ទេសរដ្ឋមន្ត្រី ចម ប្រសិទ្ធ នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ បាន គូសបញ្ជាក់ ថា ទន្ទឹមនឹង ការយល់ព្រម ឱ្យ ប្តូរ ឈ្មោះ ក្រសួង ហើយ នោះ រាជ រដ្ឋាភិបាល ក៏ យល់ព្រម ឱ្យ ធ្វើ វិសោធនកម្ម ច្បាប់ ទាំងឡាយ និង ឯកសារ គតិយុត្ត ផ្សេង ៗ ដែល មាន ការពាក់ព័ន្ធ ដល់ រចនាសម្ព័ន្ធ និង ការប្រព្រឹត្តទៅ នៃ ក្រសួង ដែល ប្តូរ ឈ្មោះ ថ្មី នេះ ផងដែរ ។
ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល ក៏ ឯកភាព ឱ្យ បង្កើត អង្គភាព ថ្មី ពីរ ទៀត គឺ អគ្គ នាយកដ្ឋាន វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ និង វិទ្យាស្ថាន ជាតិ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ដែល មាន ថ្នាក់ ស្មើ អគ្គ នាយកដ្ឋាន ។ ការបង្កើត អង្គភាព ទាំង ពីរ នេះ គឺ ពុំ មាន ការតម្រូវ ឱ្យ បន្ថែម នូវ ក្របខណ្ឌ រដ្ឋ នោះ ទេ ពោលគឺ ប្រើប្រាស់ ក្របខណ្ឌ ទាំងឡាយ ដែល កំពុង មាន ហើយ ពាក់ព័ន្ធ ដល់ ការងារ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ។
រាជ រដ្ឋាភិបាល ក៏ បាន ណែនាំ ឱ្យ មាន កិច្ចប្រជុំ អន្តរ ក្រសួង ជាមួយ បណ្តា ក្រសួង ពាក់ព័ន្ធ ជុំវិញ ការរៀបចំ សេចក្តីព្រាង ច្បាប់ ស្តីពី រចនាសម្ព័ន្ធ អង្គការ លេខ និង ការប្រព្រឹត្តទៅ របស់ ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ដើម្បី ដាក់ ឆ្លង គណៈ រដ្ឋមន្ត្រី ។
រាជ រដ្ឋាភិបាល ក៏ បាន ណែនាំ ឱ្យ បើក ទូលាយ ឱ្យ មាន ឥស្សរជន សំខាន់ ៗ បញ្ញា វន្ត ដែល មាន សញ្ញាបត្រ ផ្នែក វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ក៏ ដូចជា គំនិត ផ្តួចផ្តើម ទាំងឡាយ ដែល មាន លក្ខណៈ ន វានុវត្តន៍ និង មន្ត្រី ផ្នែក បច្ចេកទេស និង វិទ្យាសាស្ត្រ ចូលមក បម្រើ ការ ឬ ផ្ទេរ ក្របខណ្ឌ មន្ត្រី មាន បំណង ស្ម័គ្រចិត្ត ពី បណ្តា ក្រសួង នានា ដែល ពាក់ព័ន្ធ ការងារ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា មក បម្រើ ការងារ ក្នុង អង្គភាព ថ្មី ទាំង ពីរ ដែល នឹង ត្រូវ បង្កើតឡើង នេះ ។
រាជ រដ្ឋាភិបាល ក៏ ចាត់ ឱ្យ ក្រសួង ឧស្សាហកម្ម និង សិប្បកម្ម ត្រូវ រៀបចំ តាក់តែង សេចក្តីព្រាង ច្បាប់ ឆ្លង រដ្ឋសភា និង ព្រឹទ្ធសភា និង សេចក្តីព្រាង អនុក្រឹត្យ ស្តីពី ការរៀបចំ និង ការប្រព្រឹត្តទៅ នៃ ក្រសួង ឧស្សាហកម្ម វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ផងដែរ ។ ក្រោយពេល រៀបចំ រួរាល់ ត្រូវ ដាក់ ឆ្លង គណៈ រដ្ឋមន្ត្រី ទាំង ពីរ តែម្តង ។
សូម បញ្ជាក់ ថា ក្រសួង ឧស្សាហកម្ម និង សិប្បកម្ម ដើម ឡើយ មាន ឈ្មោះ ថា ក្រសួង ឧស្សាហកម្ម រ៉ែ និង ថាមពល ។ លុះ នៅ អាណត្តិ ទី៥ រាជ រដ្ឋាភិបាល សម្រេច បង្កើត ក្រសួង ថ្មី មួយ ទៀត ឈ្មោះ ថា ក្រសួង « រ៉ែ និង ថាមពល » ដូច្នេះ ក្រសួង « ឧស្សាហកម្ម រ៉ែ និង ថាមពល » ត្រូវបាន ប្តូរ ឈ្មោះ ទៅជា ក្រសួង « ឧស្សាហកម្ម និង សិប្បកម្ម » វិញ ៕
គ្រឿងញៀន បំផ្លាញ អនាគត អ្នក ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៤ ខែ មក រា៖ បង្ក្រាប ១០ករណី ឃាត់ខ្លួន ៣៣ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១០ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី និង ជួញដូរ ៥ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៣៣ នាក់ ។
របាយការណ៍ បាន ឲ្យដឹង ថា លទ្ធផល អនុវត្ត ច្បាប់ ពី ថ្ងៃទី១ ខែមករា ដល់ ថ្ងៃ ២៤ ខែមករា ឆ្នាំ ២០២០ កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ចំនួន ៥៥២ ករណី ឃាត់ មនុស្ស ១. ២០២ នាក់ ( ស្រី ៧០ នាក់ )៕ ថ្ងៃ សែន ចូល ឆ្នាំ ចិន ! គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស កើតឡើង ១៣លើ ក ស្លាប់ ១២នាក់ និង របួស ១៧នាក់
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ ដែល ជា ថ្ងៃ សែន ចូល ឆ្នាំ ចិន មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ១៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ១២នាក់ . របួស ស្រាល ៣នាក់ និង របួស ធ្ងន់ ១៤នាក់ ។
ដំណឹង មរណភាព ! ឪពុក បង្កើត របស់ លោក យឹម សារ៉ាន់ បាន ទទួលមរណភាព ដោយ ជរា ពាធ
( ភ្នំពេញ ) ៖ ឧបាសក យឹម លឹម ត្រូវ ឪពុក បង្កើត របស់ ឧត្តមសេនីយ៍ ឯក យឹម សំណាង អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន ភស្តុភារ និង ហិរញ្ញវត្ថុ ក្រសួង មហាផ្ទៃ និង លោក វរសេនីយ៍ ឯក យឹម សារ៉ាន់ អនុប្រធាន នាយកដ្ឋាន បង្ការ និង ពន្លត់ អគ្គីភ័យ បាន ទទួលមរណភាព នៅ វេលា ម៉ោង ០៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ នេះ ក្នុង ជន្មាយុ ៨៤ ឆ្នាំ ដោយ ជរា ពាធ ។
បច្ចុប្បន្ន សព បាន តម្កល់ ធ្វើ បុណ្យ តាម ប្រពៃណី ព្រះពុទ្ធ សាសនា នៅ គេហដ្ឋាន ទល់ មុខ អូតែល ឈូក ទិព្វ៥ ផ្ទះ លេខ ១៨B ផ្លូវ ៣៣៦ ស្ថិត ក្នុង សង្កាត់ ផ្សារ ដើម គរ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ។
ដំណឹង នេះ ចាត់ទុក ជា ការអញ្ជើញ បងប្អូន ញាតិមិត្ត ជិត ឆ្ងាយ ចូលរួម បុណ្យ សព ឧបាសក យឹម លឹម ឲ្យបាន គ្រប់ ៗ គ្នា ៕
រាជ រដ្ឋាភិបាល កម្ពុជា ប្រកាស ពី ការរឹតបន្តឹង ច្បាប់ ចរាចរណ៍ បន្ទាប់ពី អត្រា ស្លាប់ កើនឡើង ច្រើន ពេក
( ភ្នំពេញ ) ៖ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក នៅ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីប្រកាស ពី ការរឹតបន្តឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក បន្ទាប់ពី អត្រា ស្លាប់ ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ កើនឡើង ច្រើន ពេក នៅ ឆ្នាំ ២០១៩ ។ នេះ បើ យោង តាម សេចក្តីប្រកាស របស់ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន ។
យោង តាម សេចក្តីប្រកាស ដែល ចុះហត្ថលេខា ដោយ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ សមត្ថកិច្ច គ្រប់ ថ្នាក់ និង ប្រជាពលរដ្ឋ ប្រើប្រាស់ ផ្លូវ ដ៏ ច្រើន លើសលុប ដែល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការអនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ។
ប៉ុន្តែ យោង តាម សភាពការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក ក្នុង ឆ្នាំ ២០១៩ កន្លងទៅ នេះ បាន បង្ហាញ ឲ្យ ឃើញ ថា គ្រោះថ្នាក់ ចរាចរណ៍ មាន កំណើន យ៉ាង គំហុក ទាំង ស្លាប់ ទាំង របួស និង ការខូចខាច ទ្រព្យសម្បត្តិ សាធារណៈ ទ្រព្យសម្បត្តិ ឯកជន បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០១៨ ។
ជាក់ស្តែង អ្នកស្លាប់ កើនឡើង ចំនួន ២២០ នាក់ ស្មើនឹង ១២% និង អ្នករបួស កើនឡើង ចំនួន ១. ៣៧១ នាក់ ស្មើនឹង ២៩% ។ ទាំងនេះ មូលហេតុ ដោយសារ កត្តា សំខាន់ បី យ៉ាង គឺ កត្តា កំណើន យានយន្ត ( ប្រមាណ ៣៧%) កត្តា ហេដ្ឋារចនាសម្ព័ន្ធ ដែល មិន ទាន់ មាន តុល្យភាព នឹង កំណើន យានយន្ត និង កត្តា ឥរិយាបថ របស់ អ្នកប្រើប្រាស់ ផ្លូវ ដែល មិន គោរព និង អនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ឲ្យបាន ម៉ឺងម៉ាត់ ។
បើ តាម សេចក្តីប្រកាស ដដែល បាន ឲ្យដឹង ទៀត ថា ដើម្បី ទប់ស្កាត់ និង កាត់បន្ថយ ជា អតិបរមា នូវ គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក ក្នុង ឆ្នាំ ២០២០ នេះ អនុវត្តន៍ តាម អនុសាសន៍ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា « ថ្ងៃ នេះ ថ្ងៃស្អែក កុំ ឱ្យ មាន គ្រោះថ្នាក់ ចរាចរណ៍ » គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក សូម ប្រកាស ជូន សាធារណជន ដូច ខាងក្រោម៖
១៖ ក្រសួង ស្ថាប័ន អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ ថ្នាក់ ក្រុមហ៊ុន រោងចក្រ សហគ្រាស និង សាលារៀន ... ត្រូវ បន្ត និង បង្កើន ការផ្សព្វផ្សាយ ការអប់រំ ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ដល់ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ បុគ្គលិក កម្មករ សិស្ស និស្សិត ... ឱ្យ ប្រកាន់ខ្ជាប់ នូវ ការគោរព ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ។ ទន្ទឹម នេះ ត្រូវ បញ្ចូល ស្មារតី គោរព ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ទៅក្នុង បទបញ្ជា ផ្ទៃក្នុង ក្រសួង ស្ថាប័ន ... របស់ ខ្លួន ។
២៖ អ្នកបើកបរ យានជំនិះ គ្រប់ ប្រភេទ ត្រូវ ប្រកាន់ខ្ជាប់ នូវ សីលធម៌ ១០ ចំណុច ឲ្យបាន ដាច់ខាត ( ដកស្រង ចេញ ពី ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ) ដែល មាន ដូច ខាងក្រោម៖
១៖ ត្រូវ ចេះ បើកបរ ២៖ ត្រូវ ពាក់ មួក សុវត្ថិភាព ៣៖ ត្រូវ ពាក់ ខ្សែក្រវាត់ សុវត្ថិភាព ៤៖ ត្រូវ ប្រកាន់ ស្តាំ ៥៖ ត្រូវ ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានយន្ត៦. ត្រូវ ប្រុងប្រយ័ត្ន ជានិច្ច៧. មិន ត្រូវ បើកបរ លើស ល្បឿន កំណត់ ៨៖ មិន ត្រូវ បើកបរ ក្រោម ឥទ្ធិពល គ្រឿងស្រវឹង ៩៖ មិន ត្រូវ បើកបរ ក្រោម ឥទ្ធិពល គ្រឿងញៀន ១០៖ មិន ត្រូវ បើកបរ ក្នុង ស្ថានភាពងងុយដេក ។
៣៖ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក សូម ប្រកាស យក ឆ្នាំ ២០២០ ជា ឆ្នាំ នៃ ការរឹតបន្ដឹង អនុវត្ត ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក ។
អភិបាល ខេត្ត កំពង់ចាម ស្នើ គ្រប់ គ្រឹះស្ថាន សិក្សា នៃ ពេលវេលា អប់រំ យុវសិស្ស ឲ្យ មាន សីលធម៌ ល្អ
ការស្នើ របស់ លោក អភិបាល ខេត្ត បាន ធ្វើឡើង ក្នុង ឱកាស ប្រារព្ធ ពិធី បិទ អង្គ សន្និបាត បូកសរុប វាយតម្លៃ លទ្ធផល ការងារ អប់រំ យុវជន និង កីឡា ប្រចាំ ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ និង ទិសដៅ ការងារ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ នៅ រសៀល ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២០ នៅ មជ្ឈមណ្ឌល គរុកោសល្យ ភូមិភាគ កំពង់ចាម ។
រដ្ឋបាល ខេត្ត កំពង់ចាម រៀបចំ យន្តការ ក្រុមការងារ ថ្មី ដើម្បី ថែទាំ សួនច្បារ ក្រោយ សួនច្បារ នៅ តាម ផ្លូវ ជាតិ លេខ៦ រង ការខូចខាត
( កំពង់ចាម ) ៖ បន្ទាប់ពី មាន កិច្ចប្រជុំ លើ ប្រធានបទ រៀបចំ យន្តការថែរក្សា សួនច្បារ តាម ដងផ្លូវ ជាតិ លេខ ៦ នា ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ នេះ រដ្ឋបាល ខេត្ត កំពង់ចាម បាន សម្រេច រៀបចំ យន្តការ ក្រុមការងារ ថ្មី មួយ ដើម្បី ថែទាំ សួនច្បារ បន្ត ។
អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា បាន ថ្លែង ថា ការថែ សួនច្បារ នៅ តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៦ ពីមុន ស្ថិត នៅក្រោម ការគ្រប់គ្រង ថែទាំ របស់ មន្ទីរ សាធារណការ ខេត្ត ប៉ុន្តែ ឥឡូវនេះ អាជ្ញាធរ ខេត្ត បាន រៀបចំ ឲ្យ រដ្ឋបាល ខេត្ត កំពង់ចាម ជា អ្នកគ្រប់គ្រង ថែទាំ វិញ ដោយ មាន ការសហការ ជាមួយនឹង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ។
លោក អភិបាល ខេត្ត បាន ឲ្យដឹង ទៀត ថា ការស្ដារ ឡើងវិញ នៅ សួនច្បារ ដែល បាន ខូចខាត អាច ចាប់ផ្ដើម នៅក្នុង រដូវ វស្សា ហើយ ត្រូវបាន ចាត់ចែង ការស្រោច ទឹក ថែទាំ ឲ្យបាន ត្រឹមត្រូវ ជា ប្រចាំ ផងដែរ ៕ អភិបាល ខេត្ត ត្បូងឃ្មុំ ចាត់ទុក លោកគ្រូ អ្នកគ្រូ ជា វីវជន វីរ នារី សំខាន់ បំផុត សម្រាប់ សង្គមជាតិ
( ត្បូងឃ្មុំ ) ៖ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន ចាត់ទុក លោកគ្រូ អ្នកគ្រូ គឺជា វីវ ជន វីរ នារី សំខាន់ បំផុត សម្រាប់ សង្គមជាតិ ជា អ្នកបណ្ដុះបណ្ដាល ថ្នាល ធនធាន មនុស្ស សំខាន់ បំផុត មិន អាច ខ្វះ បាន ។
លោក ជា ម ច័ន្ទ សោភ័ណ ថ្លែង បែប នេះ ក្នុង ឱកាស អញ្ជើញ ជា អធិបតី បិទ សន្និបាត បូកសរុប វាយតម្លៃ លទ្ធផល ការងារ អប់រំ យុវជន និង កីឡា ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ និង លើក ទិសដៅ ការងារ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ របស់ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ត្បូងឃ្មុំ ដែល ធ្វើឡើង នៅ សាល ប្រជុំ ( គ) សាលា ខេត្ត ត្បូងឃ្មុំ នា រសៀល ថ្ងៃទី ២៣ ខែមករា ឆ្នាំ ២០២០ ។
ក្នុង ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត ការិយាល័យ អប់រំ ក្រុង ស្រុក មន្ត្រី អប់រំ ដែល សម្រេចបាន នូវ លទ្ធផល ការងារ បាន យ៉ាង ល្អ ប្រសើរ ។ ជាពិសេស លោកគ្រូ អ្នកគ្រូ ដែល សង្គមជាតិ ទាំងមូល ត្រូវការ ជា ចាំបាច់ ក្នុង ការបង្ហាត់ បង្រៀន ពង្រឹង សមត្ថភាព ធ្វើ យ៉ាងណា ឲ្យ សិស្សានុសិស្ស ជា ទំពាំង ស្នង ឬស្សី ដ៍ រឹងមាំ សម្រាប់ បន្ត និង អភិវឌ្ឍន៍ សង្គមជាតិ ទាំងមូល ទៅកាន់ ថ្ងៃ អនាគត ។
លោក អភិបាល ខេត្ត ក៏ បាន ជំរុញ ដល់ លោកគ្រូ អ្នកគ្រូ បន្ត ធ្វើ ការបង្ហាត់ បង្រៀន ដល់ សិស្សានុសិស្ស ឲ្យ កាន់តែ ល្អ បន្ថែម ទៀត ជាពិសេស ពង្រឹង លើ គ្រប់ ការប្រលង ទាំងអស់ មិន ថា ប្រចាំ ខែ ត្រី មាស ឆមាស ដើម្បី ធ្វើ យ៉ាងណា ឲ្យ សិស្ស ពង្រឹង សមត្ថភាព ដុសខាត់ ចំណេះដឹង ឲ្យ កាន់តែ មុត ស្រួច ដើម្បី មាន លទ្ធភាព គ្រប់គ្រាន់ ក្នុង ការប្រឡង ថ្នាក់ ជាតិ ជោគជ័យ ក្នុង ការឡើង ថ្នាក់ ជា បន្ត ក៍ ដូចជា សម្រាប់ ជា គ្រឹះ ដ៏ រឹងមាំ បន្ត ការសិក្សា នៅ ថ្នាក់ បរិញ្ញាបត្រ ។
សម្តេច ចៅហ្វា វាំង គង់ សំអុល នាំយក ព្រះរាជ ក្រឹត្យ របស់ ព្រះមហាក្សត្រ ប្រគល់ ជូន សម្តេច ធម្មវិសុទ្ធ វង្សា សៅ ទី ហេង សំរិន
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២០ សម្តេច ចៅហ្វា វាំង វរ វៀង ជ័យ អធិបតី ស្រឹង្ការ គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង បាន អញ្ជើញ នាំយក ព្រះរាជ ក្រឹត្យ របស់ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ផ្តល់ គោរមងារ ជា សម្តេច ធម្មវិសុទ្ធ វង្សា សៅ ទី ហេង សំរិន ជូន សម្តេច នៅ គេហដ្ឋាន ។
ក្នុង ព្រះរាជ ក្រឹត្យ ព្រះករុណា ព្រះមហាក្សត្រ ទ្រង់ បាន លើកឡើង បន្ថែម ថា សម្តេច ធម្មវិសុទ្ធ វង្សា បាន បរិច្ចាគ កម្លាំង កាយ ចិត្ត និង ទ្រព្យធន ប្រកបដោយ សទ្ធា ជ្រះថ្លា បរិសុទ្ធ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ជូន សង្គមជាតិ និង បាន ជួយ កសាង សមិទ្ធផល នានា ជួយ ឧបត្ថម្ភ ដល់ ជន ក្រីក្រ គ្មាន ទី ពំនឹង ទាំងឡាយ ប្រកបដោយ មហាសប្បុរសធម៌ មនុស្សធម៌ ដ៏ ឧត្តុង្គឧត្តម នៅ ទូទាំង ព្រះរាជាណាចក្រ កម្ពុជា និង បាន ប្រកាន់ខ្ជាប់ ក្នុង សេចក្តី បរិសុទ្ធ ដ៏ វិសេសវិសាល ក្នុង ព្រះធម៌ បូជា ចំពោះ ព្រះពុទ្ធ សាសនា ៕
កាន់ កាំភ្លើង ដើរ គំរាម គេ ឯង ផ្អើល រត់ ពេញ កាស៊ីណូ នៅ ក្រុង ព្រះសីហនុ ចុងក្រោយ ជន បង្ក ត្រូវ ជាប់ ខ្នោះ
( ព្រះសីហនុ) ៖ ហេតុការណ៍ ភ្ញាក់ផ្អើល មួយ បាន កើតឡើង ខណៈ បុគ្គលិក នៅ កាស៊ីណូ ប៉ឡាយ ស្ថិត នៅ ក្រុម ទី១៤ ភូមិ ៤ សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុ កំពុង ធ្វើ ពិធី ជប់លៀង សម្រាប់ ចូល ឆ្នាំ ប្រពៃណី ចិន ស្រាប់តែ មាន បុរស ជនជាតិ ខ្មែរ ម្នាក់ កាន់ កាំភ្លើង ១ដើម ដើរ គំរាម បុគ្គលិក ទាំងអស់ បង្កឱ្យ មាន ភាពចលាច ល ព្រលឹង ចុង សក់ ពេញ កាស៊ីណូ ។
ហេតុការណ៍ នេះ កើតឡើង នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ នេះ បើ តាម ការបញ្ជាក់ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ។
បន្ទាប់ពី ទទួលបាន ព័ត៌មាន ភ្លាម កម្លាំង ជំនាញ ផែន នគរបាល ព្រហ្មទណ្ឌ បាន ចុះ ទៅដល់ ទីតាំង កើត ហេតុ រួច ឃាត់ខ្លួន បាន ជនសង្ស័យ ១នាក់ និង កាំភ្លើង ១ដើម យកមកកាន់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ព្រះសីហនុ ដើម្បី បន្ត នីតិវិធី ។
ជនរងគ្រោះ មាន ចំនួន ២នាក់ មាន ឈ្មោះ សេង កុសល់ អាយុ ២៣ ឆ្នាំ មុខរបរ សន្តិសុខ នៅក្នុង កាស៊ីណូ ប៉ឡាយ ស្នាក់ នៅ កាស៊ីណូ ប៉ឡាយ និង ឈ្មោះ នឹម ដាវិន អាយុ ៥១ ឆ្នាំ មុខរបរ អ្នកគ្រប់គ្រង រថយន្ត ( តំណាង កាស៊ីណូ ប៉ឡាយ ) មាន ទីលំនៅ ភូមិ ៤ សង្កាត់ ៤ ក្រុង - ខេត្ត ព្រះសីហនុ ប៉ុន្តែ ពួកគេ ទាំង ពីរ នាក់ គ្មាន ការងរបួស នោះ ឡើយ ។
ចំណែកឯ ជនសង្ស័យ មាន ឈ្មោះ គុណ ពិសិដ្ឋ អាយុ៣០ ឆ្នាំ មុខរបរ សន្តិសុខ នៅ កាស៊ីណូ ប៉ឡាយ ជាមួយគ្នា ។
មូលហេតុ ដែល នាំឱ្យ កើត ករណី នេះ ដោយសារ ជនសង្ស័យ ផឹក ស្រា ស្រវឹង ក៏ កើតមាន ការទាស់ ពាក្យសម្តី គ្នា ចំពោះ កាំភ្លើង នេះ គ្មាន លិខិតស្នាម អ្វី ទាំងអស់ ។ ករណី នេះ កំពុង បន្ត នីតិវិធី នៅ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ស្រាល ៕
អុជ ធូប សែន កុង ម៉ាឱ្យ ជួយ បែរ មិន ជួយ ធ្វើឱ្យ ឆេះ ផ្ទះ ពីរ ខ្នង មាស ៥ដំឡឹង លុយ ជាង ៤ម៉ឺន ដុល្លារ និង សម្ភារៈ ជាច្រើន
( កំពង់ចាម ) ៖ ទាំង ពលរដ្ឋ ចិន និង ខ្មែរ ជាប់ សែ ស្រឡាយ ចិន មាន ជំនឿ ខ្លាំង ណាស់ ចំពោះ ការសែន កុងម៉ា ដើម្បី ជួយ ឱ្យ ពួកគេ បាន រុងរឿង និង រីកចម្រើន ។ ចម្លែក អី ពលរដ្ឋ ខ្មែរ ជាប់ សែ ស្រឡាយ ចិន ពីរ គ្រួសារ នៅ ភូមិ សំរោង ឃុំ អូរ ម្លូ ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម ភ្លើង ធូប ដែល ពួកគេ សែន កុង ម៉ានោះ មិន បាន ជួយ ឱ្យ ពួកគេ ចម្រុង ចម្រើន បែរជា ឆេះ បំផ្លាញ ផ្ទះសម្បែង និង ទ្រព្យសម្បត្តិ ដែល ខំ រក យ៉ាង លំបាក អស់ រលីង ។
សមត្ថកិច្ច បាន ឱ្យដឹង ថា ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ គឺ នៅ ថ្ងៃ សែន ចូល ឆ្នាំ ចិន ។ បើ តាម សមត្ថកិច្ចការ ឆាបឆេះ នេះ ដោយសារតែ ម្ចាស់ អុជ ធូប សែន កុង ម៉ាហើយ បិទ ទ្វារ ផ្ទះ ចោល ភ្លើង ធូប បាន ឆេះ រាលដាក បង្ក ជា អគ្គិភ័យ តែម្តង ។
ផ្ទះ ដែល ឆេះ នេះ ម្ចាស់ ទី មួយ ឈ្មោះ ម៉ីន ផា ភេទ ប្រុស អាយុ ៤៨ ឆ្នាំ បណ្តាលឱ្យ ខូចខាត ផ្ទះ ទំហំ ៨ម៉ែត្រ គុណ ១៦ម៉ែត្រ ធ្វើ ពី ឈើរ ប្រក់ គ្បឿង ឆេះ ខូចខាត ទាំងស្រុង និង បាត បង់ សម្ភារ រួម មាន៖ មាស ចំនួន ៥តំឡឹង . ប្រាក់ ដុល្លារ ចំនួន ៤០.០០០ ដុល្លារ . ប្រាក់ រៀល ចំនួន ៧០ លាន រៀល និង សម្ភារ ប្រើប្រាស់ មួយចំនួន ទៀត ។
ម្ចាស់ ផ្ទះ ទី ពីរ ឈ្មោះ លី លាង ភេទ ប្រុស អាយុ ៥៨ ឆ្នាំ ខូចខាត ផ្ទះ ទំហំ ១០ម៉ែត្រ គុណ ១៦ម៉ែត្រ ធ្វើ ពី ឈើ ប្រក់ គ្បឿង ឆេះ ខូចខាត ទាំងស្រុង និង ខូចខាត បាត់បង់ សម្ភារ រួម មាន៖ ប្រាក់ ដុល្លារ ចំនួន ៣០០០ ដុល្លារ . ម៉ាស៊ីន កិន ស្រូវ ១៥សេះ ១គ្រឿង . ម៉ាស៊ីន ធ្វើ នំបញ្ចុក ១៥ សេស ០១គ្រៀង . ស្រូវ ចំនួន ២០បេ និង សម្ភារ ប្រើប្រាស់ មួយចំនួន ។
មន្ត្រី នគរបាល ស្រុក ស្ទឹងត្រង់ បាន បញ្ជាក់ ថា ក្នុង ហេតុការណ៍ អគ្គិភ័យ នេះ មិន មាន គ្រោះថ្នាក់ ដល់ មនុស្ស ឡើយ ។ សមត្ថកិច្ច បាន ប្រើ រថយ្ត ពន្លត់ អគ្គិភ័យ ចំនួន ៥គ្រឿង និង ប្រើប្រាស់ ទឹក អស់ ចំនួន ៨ឡាន ៕ អាជ្ញាធរ ខេត្ត ប៉ៃលិន បើក យុទ្ធនាការ រឹតបន្តឹង ការពាក់ មួក សុវត្ថិភាព ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ចិន
( ប៉ៃលិន ) ៖ អាជ្ញាធរ ខេត្ត ប៉ៃលិន សហការ ជាមួយ កងកម្លាំង នគរបាល ចរាចរណ៍ បាន បើក យុទ្ធនាការ រឹតបន្តឹង ការពាក់ មួក សុវត្ថិភាព ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ចិន ដើម្បី ពញ្ញាក់ ស្មារតី ដល់ អ្នកប្រើប្រាស់ ផ្លូវ ឱ្យ មាន ការប្រុងប្រយ័ត្ន និង គោរព ច្បាប់ ។
យុទ្ធនាការ នេះ ក៏ មាន ការរៀបចំ ជា កម្មវិធី សួរ ឆ្លើយ សំណួរ ស្តីពី ច្បាប់ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក និង ចែកជូន នូវ មួក សុវត្ថិភាព ឯកសារ ពាក់ព័ន្ធ និង ច្បាប់ ស្តីពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ផងដែរ ។
លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ពេល បើកបរ ម៉ូតូ ត្រូវ ពាក់ មួក សុវត្ថិភាព ឱ្យ បាន ត្រឹមត្រូវ និង គ្រប់ ពេលវេលា មិន ថា ផ្លូវ ជិត ឬ ឆ្ងាយ ឡើយ ។
លោក ផាន់ ចាន់ ធុល បាន លើកឡើង ថា គ្រោះថ្នាក់ ចរាចរណ៍ ជា ឃាតក លាក់ មុខ ដែល បាន ឱ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ តាម ដងផ្លូវ ស្លាប់ និង រងរបួស ជារៀងរាល់ ថ្ងៃ ដោយសារ ការធ្វេសប្រហែស និង មិន គោរព ច្បាប់ ហើយ មហន្តរាយ ដ៏ ធំធេង នេះ ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខដុមរមនា ជីវភាព រស់ នៅ របស់ ពលរដ្ឋ និង សេដ្ឋកិច្ច សង្គមជាតិ ទាំងមូល ដែល មាន តម្លៃ មិន អាច កាត់ថ្លៃ បាន ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា គ្រោះថ្នាក់ ចរាចរណ៍ ផ្តើម ចេញ កត្តា ៣គឺ មនុស្ស សម្ភារៈ និង ផ្លូវ ដូច្នេះ កត្តា ទាំង៣នេះ សូមឲ្យ ពលរដ្ឋ ទាំងអស់ គ្នា មាន ការប្រុងប្រយ័ត្ន ជាពិសេស បងប្អូន អ្នក រត់ តាក់ស៊ី និង ម៉ូតូ ឌុប ត្រូវតែ បង្កើន ការប្រុងប្រយ័ត្ន នៅពេល ធ្វើដំណើរ និង ពេល បើកបរ ព្រោះថា យ៉ាងហោចណាស់ មាន អ្នក ជិះ ៣ ទៅ ៥ នាក់ ដែល បាន ផ្ញើ ជីវិត ទៅ លើ អ្នកបើកបរ ។
លោក ផាន់ ចាន់ ធុល បាន បន្ត ថា សកម្មភាព ចុះ ចែក មួក ដល់ អ្នកបញ្ជា ទោចក្រយានយន្ត នា ពេលនេះ គឺជា ការដាស់ ស្មារតី ដល់ អ្នកបើកបរ ទាំងឡាយ ឲ្យ មាន ការប្រុងប្រយ័ត្ន លើ បញ្ហា សុវត្ថិភាព ក្នុង ពេល បើកបរ ព្រោះ នៅពេល មាន ការប៉ះទង្គិច ដោយ ប្រការ ណាមួយ មួក សុវត្ថិភាព អាច ការពារ ក្បាល របស់ អ្នក ពី គ្រោះថ្នាក់ ទាំងនោះ បាន យ៉ាង មាន ប្រសិទ្ធភាព ។
មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ច្រានចោល ការរិះគន់ ថា មន្ទីរពេទ្យ មិន ព្យាបាល អ្នកជំងឺ នៅ ថ្ងៃសៅរ៍ - អាទិត្យ
( តាកែវ )៖ បន្ទាប់ពី បណ្ដាញ ផ្សព្វផ្សាយ ក្នុង ស្រុក មួយ បាន ចុះផ្សាយ រិះគន់ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ថា មិន ជួយ ព្យាបាល អ្នកជំងឺ នៅ ថ្ងៃសៅរ៍ - អាទិត្យ នា រសៀល ថ្ងៃទី ២៥ ខែមករា នេះ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ បាន ចេញ សេចក្ដីបំភ្លឺ មួយ ដោយ ច្រានចោល ទាំងស្រុង ចំពោះ ការចោទប្រកាន់ ទាំងអស់ នោះ ។
យោង តាម ការបកស្រាយ បំភ្លឺ របស់ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ បាន ឲ្យដឹង ថា នា ព្រឹក ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២០ មាន ករណី ស្រ្តី មាន ផ្ទៃពោះ ម្នាក់ ឈ្មោះ ព្រំ លីដា អាយុ ៤៥ ឆ្នាំ រស់ នៅ ភូមិ កំបៅ ឃុំ បឹងត្រាញ់ ខាងត្បូង ស្រុក សំរោង បាន ចូលមក ពិនិត្យ ផ្ទៃពោះ រួម ជាមួយ គ្រួសារ បាន មកកាន់ មន្ទីរពេទ្យ ដើម្បី ពិនិត្យ សុខភាព ។
មន្ទីរពេទ្យ បាន បំភ្លឺ បន្ត ថា ក្នុង ករណី នេះ ស្រ្តី ខាងលើ ចង់ តែ ពិនិត្យ អេកូ ប៉ុន្តែ ការពិនិត្យ អេកូ នៅ មន្ទីរពេទ្យ សម្រាប់ ថ្ងៃសៅរ៍ អាទិត្យ និង ថ្ងៃ បុណ្យ ត្រូវ ធ្វើឡើង ក្នុង ករណី បន្ទាន់ និង ធ្ងន់ធ្ងរ តែ ប៉ុណ្ណោះ ដោយសារតែ គ្រូពេទ្យ ជំនាញ អេកូ មិន គ្រប់គ្រាន់ ក្នុង វេន យាម ប្រចាំ ការ នីមួយ ៗ ។ ប៉ុន្តែ បើ ទោះជា គ្រូពេទ្យ ពន្យល់ យ៉ាងណា ក៏ដោយ ក៏ ស្រ្តី ខាងលើ មិន ព្រម ទទួលយក ការសម្រាក ពេទ្យ គាត់ ចង់បាន អ្វី ដែល គាត់ ចង់បាន ( អេកូ ) តែ ប៉ុណ្ណោះ ។
បើ តាម ការបកស្រាយ របស់ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ មន្ទីរពេទ្យ សូម បដិសេធ នូវ ការលើកឡើង នេះ ទាំងស្រុង ចំពោះ ការចោទប្រកាន់ ថា មន្ទីរពេទ្យ ខេត្ត តាកែវ មិន ទទួល ពិនិត្យ ជំងឺ ថ្ងៃសៅរ៍ អាទិត្យ និង បដិសេដ រាល់ ការចោទប្រកាន់ ការចុះផ្សាយ របស់ សារព័ត៌មាន មួយចំនួន ផងដែរ ។
មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ ក៏ សូម អរគុណ នូវ រាល់ ព័ត៌មាន រិះគន់ ដើម្បី ស្ថាបនា ហើយ មន្ទីរពេទ្យ នឹង ខិតខំ កែលម្អ នូវ រាល់ ចំណុច ខ្វះខាត ផងដែរ ៕
( ភ្នំពេញ ) ៖ លោក កុក ឡុង គ្រូ ហុង ស៊ុយ ចិន ល្បី ឈ្មោះ មួយ រូប នៅក្នុង ប្រទេស កម្ពុជា បាន ផ្តល់ ដំបូន្មាន ឱ្យ ប្រុងប្រយ័ត្ន និង យកចិត្តទុកដាក់ ឱ្យ បាន ខ្ពស់ ទៅ លើ រឿង ៣យ៉ាង គឺ គ្រោះ អគ្គិភ័យ ការកាប់ ទន្ទ្រាន ព្រៃឈើ និង ជម្លោះ ដីធ្លី សម្រាប់ ឆ្នាំ ២០២០ នេះ ។
លោក កុក ឡុង បាន ពន្យល់ ថា ឆ្នាំ ២០២០ ដែល ត្រូវ នឹង ឆ្នាំ ជូត ធាតុ ដី បើ កើតមាន គ្រោះ អគ្គិភ័យ ហើយ គឺ លំបាក ពន្លត់ ណាស់ ។ ក្រៅពី គ្រោះ អគ្គិភ័យ ហើយ នោះ ការកាប់ ទន្ទ្រាន ព្រៃឈើ និង ជម្លោះ ដីធ្លី ក៏ កើតមាន ច្រើន ផងដែរ ដែល ទាមទារ ឱ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ៕ អាសូរ ណាស់ ! មន្ត្រី យោធា វរៈ ព្រំដែន កម្ពុជា - ឡាវ និង កូនប្រុស អាយុ បី ឆ្នាំ ត្រូវ រថយន្ត បុក ផ្ដាច់ ជីវិត ទាំង ២នាក់ នៅ ក្រុង ស្ទឹងត្រែង
គ្រោះថ្នាក់ ចរាចរណ៍ បាន កើតឡើង នៅ វេលា ល្ងាច ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ ស្ថិត នៅ ត្រង់ ចំណុច ខាងលើ ផ្ទះ ១០០ ខ្នង តាម បណ្តោយ ផ្លូវ ជាតិ ៧A ស្ថិត នៅក្នុង ភូមិ គីឡូ៨ សង្កាត់ សាមគ្គី ក្រុង ស្ទឹងត្រែង ។
( ភ្នំពេញ ) ៖ លោកស្រី សៅ ទី ហេង សំរិន ដែល ជា ភរិយា របស់ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៃ កម្ពុជា ត្រូវបាន ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា ត្រាស់បង្គាប់ ផ្តល់ គោរមងារ ជា សម្តេច ធម្មវិសុទ្ធវងស្សា សៅ ទី ហេង សំរិន ។ នេះ បើ យោង តាម ព្រះរាជ្រ ក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ២៥ ខែមករា ឆ្នាំ ២០២០ នេះ ៕
( ភ្នំពេញ ) ៖ បុរី ឡុង នី ក្នុង ឱកាស បុណ្ប ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ នេះ សូម បួងសួង ដល់ ទេវតា ប្រោសប្រទាន ពរ ជ័យ ដល់ លោក អ្នក ទាំងអស់ គ្នា ព្រមទាំង ក្រុមគ្រួសារ ទទួលបាន នូវ សេរី សួស្តី ជ័យ មង្គល វិបុល សុខ មហា ប្រសើរ និង ចម្រើន រុងរឿង ជានិច្ច និរន្តរ៍ បុរី ឡុង នី ជា បុរី ដែល នាំមក នូវ ផ្ទះ ក្នុង ក្តីស្រម៉ៃ និង ភាពអស្ចារ្យ ក្នុង ការរស់នៅ ប្រកបដោយ ផាសុកភាព ។
បុរី ឡុង នី គម្រោង ទី ០២ និង ទី០៣ គឺ នាំមក គុណភាព សំណង់ សោភ័ណភាព និង ភាពស៊ីវិល័យ ភាពល្អ នៃ ទីតាំង នៃ គម្រោង ភាព ឈាន មុខ នៃ សម័យកាល ទំនើប និង ភាពលឿន នៃ ការសាងសង់ ។
សម្រាប់ ទីតាំង គម្រោង ទី២៖ ផ្លូវ៣០ ម៉ែត្រ ភូមិ ទួល ពង្រ សង្កាត់ ចោម ចៅ១ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ( បត់ ឆ្វេង ត្រង់ ស្តុប អាងទឹក ផ្លូវ វេង ស្រេង ប្រហែល៧០០ ម៉ែត្រ ) និង ទីតាំង គម្រោង ទី៣៖ ផ្លូវ ៦០ម៉ែត្រ សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ( បត់ ស្តាំ ប្រហែល៤០០ ម៉ែត្រ ពី ផ្លូវ បំបែក ជា៤ ផ្លូវ ព្រៃ ស និង ផ្លូវ ៦០ម៉ែត្រ ) ។
( ភ្នំពេញ ) ៖ នៅក្នុង សង្គម ខ្មែរ បើ និយាយ ពី បងប្អូន ជនជាតិ ដែល រស់ នៅ លាយ ទ្បំ ជាមួយ ប្រជាពលរដ្ឋ ខ្មែរ គឺ មាន ច្រើន ។ ក្នុង ចំណោម បងប្អូន ជនជាតិ ទំាង នេះ គឺ បាន ប្រកាន់ នូវ ជំនឿ សាសនា ប្រពៃណី ទំនៀមទម្លាប់ រៀង ៗ ខ្លួន ក្នុង នោះ គឺ បងប្អូន ខ្មែរ ជាប់ សែ ស្រទ្បាយ ចិន មាន ចំនួន ច្រើន ជាង គេ ។
បើ ហេតុ នេះ បើ និយាយ អំពី ប្រពៃណី ទំនៀមទម្លាប់ របស់ បងប្អូន ជាប់ សែ ស្រទ្បាយ ចិន តើ ឥទ្ធិពល បុណ្យ ចូល ឆ្នាំ ចិន ប៉ះពាល់ ដល់ ប្រពៃណី ខ្មែរ ឬ ទេ ?
អ្នកជំនាញ អារ្យធម៌ ខ្មែរ លោក រត្ន័ សណ្ដាប់ បាន ថ្លែង ដោយ មើលឃើញ ថា ក្នុង សង្គម ខ្មែរ បើ និយាយ ពី ប្រពៃណី ទំនៀមទម្លាប់ របស់ បងប្អូន ខ្មែរ ជាប់ ខ្សែ ស្រទ្បាយ ចិន ពិសេស ពិធី ទទួលអំណរ សាទរ ទេវតា ឆ្នាំ ថ្មី ប្រពៃណី ចិន ដែល មាន តំាង ពី បឋម កាល រៀង មក ដែល យើង ឃើញ មិន ថា ខ្មែរ ជាប់ សែ ស្រទ្បាយ ចិន ឬ កូនចៅ ចិន ដែល កំពុង រៀបចំ ប្រារព្វ ពិធី យ៉ាង អ៊ូរ អរសប្បាយរីករាយ ដូច យើង ឃើញ នេះ គឺ ពុំ ប៉ះពាល់ ដល់ ប្រពៃណី ខ្មែរ នោះ ទេ ។
ពីព្រោះ បងប្អូន ខ្មែរ ជាប់ សែ ស្រទ្បាយ ចិន ទំាង នេះ ពួកគាត់ បាន សម្រប ខ្លួន ទៅនឹង ប្រពៃណី វប្បធម៌ ខ្មែរ យ៉ាង ប្រពៃ អស់ ទៅ ហើយ តែ អ្វី ដែល ពួកគាត់ តែង ប្រារព្វ ពិធី ទទួលអំណរ សាទរ ទេវតា ឆ្នាំ ថ្មី ប្រពៃណី ចិន យ៉ាង សប្បាយរីករាយ ឬក៏ កិច្ច ពិធី ផ្សេង ៗ ទៀត នោះ គឺ គ្រាន់តែ ជា ការរក្សា កិច្ច ពិធី ជា ប្រពៃណី ដើម្បី រំឭក នឹក គុណ ដល់ បុព្វការី ជន ជីដូន ជីតា ម៉ាកុង ខ្លួន តែ ប៉ុណ្ណោះ ។
មាន ន័យ ថា « ចំពោះ បងប្អូន ខ្មែរ ជាប់ សែ ស្រទ្បាយ ចិន ឬ កូនចៅ ចិន ទំាង នេះ នៅក្នុង ទស្សនជាតិនិយម សាច់ ឈាម បេះដូង ថ្លើម ប្រមាត់ របស់ ពួកគាត់ បាន ចាត់ទុក មាតុ ភុមិ ខ្មែរ ជា ទឹកដី កំណើត របស់ ខ្លួន » ។
ចំពោះ កត្ដា ទំាង អស់ នេះ គឺ ផ្ដើម ចេញ មកពី រ៖ ទី មួយ៖ មេដឹក នំា ទី ពី រ៖ សាសនា និង ទីបី៖ ជនជាតិ ខ្មែរ ជាជាតិ សាសន៍ មួយ មាន ភាពញញឹម រួសរាយ រាក់ទាក់ ប្រកបដោយ មនោសញ្ចេតនា និង ការយោគយល់ អាស្រ័យ គ្នា ៕ អង្គការ មួយ នៅ ម៉ាឡេស៊ី ពេញចិត្ត ជួយ ដល់ ឥស្លាម សាសនិក កម្ពុជា ព្រោះ ឃើញ ប្រមុខ ដឹកនាំ កម្ពុជា គិតគូរ ពី សាសនិក
( ភ្នំពេញ ) ៖ អង្គការ អាល់ តើរ ម៉ីហ្ស៊ី ដែល ជា អង្គការ សាសនា ធំ មួយ នៅ សហព័ន្ធ ម៉ាឡេស៊ី បាន អះអាង ពី ការពេញចិត្ត ជាខ្លាំង ក្នុង ការជួយ ដល់ ឥស្លាម សាសនិក នៅ កម្ពុជា ដោយសារ មើលឃើញ ពី ការគិតគូរ យកចិត្តទុកដាក់ ដល់ ប្រជា សាសនិក នានា ពីសំណាក់ ប្រមុខ ដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ។
ជាក់ស្ដែង នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ អាល់ តើរ ម៉ីហ្ស៊ី ម៉ាឡេស៊ី បាន ប្រគល់ សម្ភារៈ សម្រាប់ ថ្វាយបង្គំ ព្រះ សម្រាប់ សាសនិក ឥស្លាម ទាំង បុរស - ស្ត្រី ចំនួន ៤០០ ឈុត តាមរយៈ ក្រសួង សុខាភិបាល កម្ពុជា ដើម្បី បែងចែក តាម បណ្ដា មន្ទីរ អង្គភាព របស់ រដ្ឋ ជាង ៨០ នៅ ទូទាំង ប្រទេស កម្ពុជា ដែល កម្មវិធី នេះ ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង សុខាភិបាល ។
លោកស្រី យូសុះ ហ្វាតៀរ នី សមាជិក ក្រុម លេខា សម្ដេច តេជោ ហ៊ុន សែន បាន ឱ្យដឹង ថា ដោយសារតែ ចង់ ជួយ ដល់ សហគមន៍ ឥស្លាម កម្ពុជា ឲ្យ មាន ការរីកចម្រើន និង ជួយ ដល់ ជន ក្រី ផង នោះ ទើប លោកស្រី និង ស្វាមី បាន ខិតខំ កៀរ គរ សប្បុរសជន នានា ទាំង ក្នុង ស្រុក និង ក្រៅ ស្រុក ដើម្បី ជួយ ផ្គត់ផ្គង់ ដល់ សាសនិក ឥស្លាម កម្ពុជា ដែល កំពុង មាន ការខ្វះខាត ខណៈ អង្គការ នឹង នៅតែ បន្ត បេសកកម្ម ចែក អំណោយ របស់ ខ្លួន ដល់ បណ្ដា សាសនិក ឥស្លាម ទូទាំង ប្រទេស កម្ពុជា ។
លោក លើកឡើង ទៀត ថា ក្រសួង សុខាភិបាល បាន ខិតខំ រៀបចំ ទីតាំង សមរម្យ មួយ នៅ តាម បណ្ដា មន្ទីរពេទ្យ រដ្ឋ ឲ្យ មាន កន្លែង សម្រាប់ ថ្វាយបង្គំ ព្រះ របស់ សាសនិក ឥស្លាម ខណៈ ដែល ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដឹកនាំ ដោយ សម្ដេច តេ ហ៊ុន សែន បាន បើក ឱកាស ទូលាយ ដល់ សាសនិក ទាំងអស់ គោរព ប្រតិបត្តិ សាសនា របស់ ខ្លួន ប្រកបដោយ សុខ សន្តិភាព ៕ អ្នក ឧកញ៉ា គិត ម៉េង ផ្ញើ សារលិខិត ជូន ពរ សម្ដេច តេជោ ហ៊ុន សែន និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ចិន
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា បាន ផ្ញើ សារលិខិត ជូន ពរ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ ជូត ត្រូវ នឹង ឆ្នាំ ២០២០ ។
រាត្រី សមោសរ អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ នេះ ដែល ផលិត ដោយ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន លើក នេះ មាន រយៈពេល ២៦០ នាទី ក្នុង នោះ រួម មាន ទាំង កម្មវិធី ចម្រៀង របាំ វេទមន្ត សៀក ល្ខោន ហ៊ីនិង កម្មវិធី ជជែក កម្សាន្ត ជាដើម ។
រាត្រី សមោសរ លើក នេះ បាន ផ្តោត សំខាន់ ទៅ លើ ប្រធានបទ យុគសម័យ និង ចំណុច ក្តៅ ក្នុង សង្គម ក្នុង ន័យ បញ្ចេញ មនោសញ្ចេតនា ស្រឡាញ់ ញាតិ សន្តាន និង ស្រឡាញ់ ស្រុក កំណើត ច្រៀង សរសើរ ប្រជាជាន និង ជូនពរ មាតុ ប្រទេស ដើម្បី ស្វែងរក និង សម្រេចបាន នូវ សុបិន ក៏ ដូចជា សុំ សេចកី្ត សុខ និង សិរី មង្គល មាន កម្មវិធី ច្រៀង ចម្រៀង ជនជាតិ ផង ហើយក៏ មាន ការរាំ របាំ ឌីស្កូ ផង កម្មវិធី ដ៏ ល្អ ឆើតឆាយ ដែល រួមបញ្ចូល ភាព ប្រពៃណី និង ទាន់សម័យ បាន ក្លាយជា រាត្រី សមោរ មួយ លើក ប្រកបដោយ វប្បធម៌ យប់ ដាច់ ឆ្នាំ តាម ប្រពៃណី ចិន ។
ដើម្បី ទប់ទល់ នឹង ជំងឺ រលាក សួត បង្កឡើង ដោយ វីរុស ការ៉ូណា ប្រភេទ ថ្មី រាត្រី សមោសរ អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន បាន បន្ថែម នូវ កម្មវិធី ពិសេស មួយ ក្រោម ចំណងជើង ថា « ក្តីស្រឡាញ់ ជា ស្ពាន » ដើម្បី ជួយ គាំទ្រ ក្រុង វ៉ូហាន និង លើកទឹកចិត្ត ប្រទេស ចិន ។
ឆ្នាំ ២០២០ នេះ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន នឹង ផលិត និង ដាក់ ចេញ ភាពយន្ត ឈ្មោះ « រាត្រី សមោសរ អបអរសាទរ ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ ២០២០ » ។ ប្រព័ន្ធ សារព័ត៌មាន ជាង ៥០០ នៃ ប្រទេស ជាង ១៧០ ដូចជា អាមេរិក អង់គ្លេស ជប៉ុន រុស្ស៊ី ប្រេស៊ីល សិង្ហបុរី ម៉ាឡេស៊ី ថៃ និង ឡាវ ជាដើម ក៏ ដូចជា រោង ភាពយន្ត នៃ ប្រទេស និង តំបន់ ជាង ២០ នឹង ចាក់ផ្សាយ និង ចាក់បញ្ចាំង កម្មវិធី រាត្រី សមោស អបអរសាទរ ឆ្នាំ ថ្មី ប្រពៃណី ចិន និង ភាពយន្ត ឈ្មោះ « រាត្រី សមោសរ អបអរសាទរ ឆ្នាំ ថ្មី ប្រពៃណី ចិន ឆ្នាំ ២០២០ » ។
( កំពង់ចាម ) ៖ អគ្គិភ័យ បាន លេប ត្របាក់ ផ្ទះ ចំនួន ២ខ្នង ឆេះ ខូចខាត ទាំងស្រុង និង ខាតបង់ ទ្រព្យសម្បត្តិ អស់ មួយចំនួន ធំ ដោយសារតែ ម្ចាស់ ផ្ទះ ដុត ធូប សែន កុង ម៉ា ហើយ បិទ ទ្វារ ផ្ទះ ចោល ធ្វើឱ្យ ភ្លើង ធូប រៀល ឆេះ បង្ក ជា អគ្គិភ័យ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ ស្ថិត នៅ ភូមិ សំរោង ឃុំ អូរ ម្លូ ស្រុក ស្ទឹង ត្រង់ ខេត្ត កំពង់ចាម ។
សមត្ថកិច្ច បាន បញ្ជាក់ ថា ក្នុង ហេតុការ អគ្គិភ័យ នេះ មិន មាន គ្រោះថ្នាក់ ដល់ មនុស្ស ឡើយ ។ ក្នុង នោះ សមត្ថកិច្ច បាន ប្រើប្រាស់ រថយ្ត ពន្លត់ អគ្គិភ័យ ចំនួន៥ គ្រឿង រថយន្ត អធិការដ្ឋាន នគរបាល ស្រុក ស្ទឹងត្រង់១ គ្រឿង រថយន្ត អធិការដ្ឋាន នគរបាល ស្រុក ចំការលើ ០១ គ្រឿង . រថយន្ត ស្នងការដ្ឋាន នគរបាល ខេត្ត ០២ គ្រឿង រថយន្តក្រុមហ៊ុន ឡុង ស្រេង ចំការ កៅស៊ូ បឹង កេត០១ គ្រឿង និង ប្រើប្រាស់ ទឹក អស់ ចំនួន ០៨ ឡាន ។
អគ្គិភ័យ នេះ កើតឡើង ដោយ មូលហេតុ ម្ចាស់ ផ្ទះ ឈ្មោះ ម៉ីន ផា អុជ ធូប សែន កុង ម៉ា ហើយ បាន បិទ ទ្វារ ផ្ទះ នាំគ្នា ទៅ ភូមិ បែក អន្លូង ៕
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ត្រឡប់មក ផ្ទះ វិញ ដោយ សុវត្ថិភាព ! ស្លាប់ ១២នាក់ និង របួស ១៧នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៤ ខែមករា ម្សិលមិញ
លិខិត មិត្ត អ្នកអាន៖ សម រង្ស៉ី បន្ត ចំអក ឲ្យ កឹម សុខា តែ ចង់ លាង ខ្លួន ក្រោយ ត្រូវ ព្រនង់ រដ្ឋ បរទេស !
( ភ្នំពេញ ) ៖ បន្ទាប់ពី បាន ប្រកាស ក្តែង ៗ ថា ខ្លួន ជា មេក្លោង ក្នុង ការឃុបឃិត ជាមួយ បរទេស ដើម្បី ផ្តួលរំលំ រដ្ឋាភិបាល សម្តេច ហ៊ុន សែន ហើយ បាន បង្ហោះ រូបថត ជាច្រើន សន្លឹក ដើម្បី ជា ភស្តុតាង ដាក់បន្ទុក ខ្លួន ឯង និង ដាក់បន្ទុក លើ លោក កឹម សុខា ផង នោះ លោក សម រង្ស៉ី បាន បន្ត ចំអក បញ្ឈឺចិត្ត លោក កឹម សុខា បន្ថែម ទៀត ដោយ អះអាង នៅ ថ្ងៃ ២៤មករា នេះ ថា ខ្លួន សប្បាយ ចិត្ត ពេល ដឹង ថា មេធាវី រដ្ឋាភិបាល ប្រកាស យក ភស្តុតាង ទាំងនោះ ទៅ ប្រើ ។
លោក សម រង្ស៉ី ដែល គេ ដឹង ថា បាន ប្រឹងប្រែង ប្រើប្រាស់ គ្រប់ វិធី និង ល្បិច កិច្ច កល ដើម្បី សង្កត់ ក លោក កឹម សុខា មិន ឲ្យ មាន សេរីភាព ឡើងវិញ នោះ បាន សរសេរ ក្នុង ហ្វេសប៊ុក និង ក្នុង ធ្វីតធ័រ របស់ ខ្លួន ថា « ខ្ញុំ ត្រេកអរ ណាស់ ដោយ បាន ទទួល ព័ត៌មាន ថា លោក គី តិច មេធាវី រដ្ឋាភិបាល បាន យល់ព្រម ទទួលយក ឯកសារ និង រូបថត ផ្សេង ៗ ដែល ខ្ញុំ បង្ហោះ ក្នុង ហ្វេសប៊ុក ដើម្បី ធ្វើជា ភស្តុតាង ក្នុង សំណុំរឿង ក្បត់ ជាតិ របស់ លោក កឹម សុខា ... » ។
សារ របស់ លោក សម រង្ស៉ី នេះ ត្រូវបាន មជ្ឈដ្ឋាន ទូទៅ មើលឃើញ យ៉ាង ច្បាស់ ក្រឡែត ថា គឺជា ការចំអក បញ្ឈឺចិត្ត លោក កឹម សុខា បន្ថែម ទៀត ក្រោយពី ខ្លួន បាន ប្រកាស ផ្តល់ ភស្តុតាង ជាច្រើន ដល់ តុលាការ ពាក់ព័ន្ធ នឹង ការឃុបឃិត ជាមួយ បរទេស ក្នុង ផែនការ ផ្តួលរំលំ រដ្ឋាភិបាល ស្រប ច្បាប់ ខណៈ ដែល លោក កឹម សុខា កំពុង ព្យាយាម ដោះ សារ បដិសេធ ម្តង ហើយ ម្តង ទៀត ថា មិន បាន ឃុបឃិត ជាមួយ បរទេស នោះ ឡើយ ។
ទង្វើ របស់ លោក សម រង្ស៉ី នេះ បាន ទទួល ប្រតិកម្ម យ៉ាង ខ្លាំងក្លា ពី ភាគី អ្នកគាំទ្រ លោក កឹម សុខា និង ពី ផ្ទៃក្នុង អ្នកគាំទ្រ លោក សម រង្ស៉ី មួយចំនួន ផងដែរ ។ ពួកគេ អះអាង ថា សម រង្ស៊ី គ្មាន ការងារ ធ្វើ និង កំពុង ដើរ ទាត់ ខ្យល់ ហើយ ទំនងជា អផ្សុក ពេក បែរជា និយាយ រឿង បែប នេះ ចេញមក កើត ក្នុង កាលៈទេសៈ ដែល លោក កឹម សុខា កំពុង តតាំង ក្តី យ៉ាង តឹង តែង នៅឯ តុលាការ ។ សម រង្ស៊ី ធ្វើ បែប នេះ ព្រោះតែ ខ្លាច គេ ភ្លេច ឈ្មោះ ខ្លួន ហើយ នាំគ្នា និយាយ តែ ពី ឈ្មោះ លោក កឹម សុខា ។
ជាពិសេស គឺ ក្រោយពេល មេធាវី រដ្ឋាភិបាល លោក គី តិច បាន ប្រកាស អរគុណ លោក សម រង្ស៉ី ដែល បាន បង្ហាញ ភស្តុតាង ដើម្បី ដាក់ បន្ទុក លើ លោក កឹម សុខា និង លើ ខ្លួន ឯង ផង នោះ ប្រតិកម្ម ពី ផ្ទៃក្នុង អតីត បក្ស សង្គ្រោះ ជាតិ កាន់តែ កើតឡើង យ៉ាង ខ្លាំងក្លា ។ ពួកគេ អាក់អន់ចិត្ត ខឹងសម្បារ និង ស្តីបន្ទោស លោក សម រង្ស៉ី យ៉ាង ខ្លាំង ចំពោះ ទង្វើ បែប អសីលធម៌ ទ្រូស មិត្ត ដោយ ខុស បែបបទ ជាមួយ លោក កឹម សុខា ។
ផ្ទុយទៅវិញ លោក សម រង្ស៉ី ដែល ជា អ្នកនយោបាយ មិន សូវ យល់ ពី ការទូត និង ខ្សោយ ខាង យុទ្ធសាស្ត្រ បែរជា ប្រកាស ជា ចំហរ ហើយ ថែមទាំង បាន បង្ហោះ ទាំង រូបថត មេដឹកនាំ បរទេស ជាច្រើន ដោយ បញ្ជាក់ ថា អ្នក ទាំងនោះ ជា អ្នក ជួយ ជ្រោមជ្រែង ក្នុង ការធ្វើឲ្យ មាន ការ ផ្តួលរំលំ ប្តូរ របប នៅ កម្ពុជា ទៅ វិញ ។ នេះ គឺជា ហេតុផល ដែល រដ្ឋាភិបាល បរទេស ទាំងនោះ សម្តែង ការ មិន សប្បាយ ចិត្ត និង ហួសចិត្ត មិន នឹកស្មាន ថា សម រង្ស៉ី ឆោត ល្ងង់ ដល់ ម្លឹង សោះ ។ ប្រទេស ទាំងនោះ បាន ព្រមាន លោក សម រង្ស៉ី យ៉ាង ធ្ងន់ធ្ងរ ។
ដោយសារ បញ្ហា នេះ ហើយ បានជា ក្នុង សារ លើក ក្រោយ នេះ សម រង្ស៉ី ហាក់ដូចជា ចង់ លាង ខ្លួន វិញ ដោយ ចង់ កាឡៃ សាច់រឿង ថា នោះ គ្រាន់តែ ជា ជំនួប ធម្មតា ជាមួយ បរទេស តែ ប៉ុណ្ណោះ ដែល គេ មិន អាច យក ទៅ ធ្វើ ភស្តុតាង បាន ទេ ។
ប៉ុន្តែ សម រង្ស៉ី ភ្លេច គិត ថា សារ ដែល ខ្លួន សរសេរ ក្នុង ហ្វេសប៊ុក ផេក ផ្លូវការ និង ការ និយាយ សារ ភាព តាម វិទ្យុ អាស៊ី សេរី កន្លងទៅ វា មាន លក្ខណៈ ធ្ងន់ធ្ងរ និង ផ្តល់ បច្ច័យ អាក្រក់ យ៉ាងណា ដល់ លោក កឹម សុខា រហូតដល់ មេធាវី រដ្ឋាភិបាល ប្រកាស អរគុណ ថែម ទៀត បែប នេះ ។
យោង តាម សារ ទាំងនោះ លោក សម រង្ស៉ី មិន អាច លាង ខ្លួន បាន ឡើយ ទោះជា ខំ សរសេរ ថា ការ និយាយ បែប នេះ គ្រាន់តែ ចង់ ឌឺ សម្តេច នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ក៏ដោយ ពីព្រោះ ក្នុង តុលាការ អ្វី ដែល សំខាន់ បំផុត នោះ គឺ ភស្តុតាង និង សាក្សី ។
ពេលនេះ ខ្ញុំ យល់ ថា លោក សម រង្ស៉ី កំពុង ធ្ងន់ ក មែនទែន ហើយ ពីព្រោះ ទាំង លោក កឹម សុខា និង អ្នកគាំទ្រ កឹម សុខា ក៏ មិន សប្បាយ ចិត្ត ទាំង អ្នកគាំទ្រ សម រង្ស៉ី ខ្លួន ឯង ក៏ បញ្ចេញ ប្រតិកម្ម ស្តីបន្ទោស និង លើស ពី នេះ លោក សម រង្ស៉ី ក៏ ត្រូវ ព្រនង់ យ៉ាង ធ្ងន់ធ្ងរ របស់ រដ្ឋាភិបាល បរទេស ដែល ខ្លួន ធ្លាប់ ចាត់ទុក ជា ទីពឹង បង្អែក ។ សូម កុំ ភ្លេច ថា ពាក្យពេចន៍ របស់ លោក សម រង្ស៉ី ត្រូវបាន គេ ថតចម្លង ទុក អស់ ហើយ ទោះ ចង់ កែ ក៏ កែ មិន បាន ដែរ ។
សរុប មកវិញ សម រង្ស៉ី ពេលនេះ ក្លាយជា មនុស្ស គ្រប់គ្រង ខ្លួន ឯង លែង បាន ហើយ ដោយសារ បាន ដឹងខ្លួន ឯង យ៉ាង ច្បាស់ ថា ឈ្មោះ របស់ គាត់ ត្រូវបាន គេ បំភ្លេច ចោល ទាំងស្រុង ចាប់តាំងពី ថ្ងៃទី ៩ វិច្ឆិកា ២០១៩មក ។
ដូច្នេះ ដើម្បី កុំ ឲ្យ គេ ភ្លេច ឈ្មោះ ខ្លួន ជំរើស របស់ លោក សម រង្ស៉ី មាន នៅសល់ តែ មួយ គត់ គឺ ការដាក់ បន្ទុក បន្ថែម លើ សំណុំរឿង ក្បត់ ជាតិ របស់ លោក កឹម សុខា ទោះជា ត្រូវ យក ប្រទេស ធំ ៗ ជាច្រើន មក ពាក់ព័ន្ធ នឹង សំណុំរឿង ក្បត់ ជាតិ របស់ ខ្លួន ក៏ដោយ ដែល ជា កំហុសឆ្គង ខាង នយោបាយ យ៉ាង ធ្ងន់ធ្ងរ ក៏ដោយ ។ នេះ ជា ហេតុផល ដែល លោក សម រង្ស៉ី មិន បោះបង់ ចេតនា អាក្រក់ នេះ ចោល ជាដាច់ខាត ក្នុង ការដាក់ បន្ទុក លើ លោក កឹម សុខា ពីព្រោះ សម រង្ស៉ី និង កឹម សុខា គឺ « មាន តែ មួយ » ប៉ុណ្ណោះ ៕
គូ ស្វាមី ខាងលើ មាន មកពី រាជធានី ភ្នំពេញ ៤គូ ខេត្ត កំពង់ចាម ១៨ គូ ស្វាយរៀង ១៥គូ ត្បូងឃ្មុំ ៧គូ បាត់ដំបង ៣គូ ក្រចេះ ៥គូ ព្រះវិហារ ៣គូ កំពង់ឆ្នាំង ៧គូ កោះ កុង ៤គូ ព្រៃវែង ២គូ បន្ទាយមានជ័យ ៧គូ ព្រះសីហនុ ៣គូ ពោធ៌សាត់ ១២គូ និង ខេត្ត ឧត្តមានជ័យ ២គូ ផងដែរ ។
លោកស្រី គង់ កុសល នាយិការ ទីផ្សារ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បាន ចូលរួម អបអរសាទរ និង ជូនពរ ដល់ គូ ស្វាមី ភរិយា ថ្មី ទាំងអស់ គ្នា ឱ្យ ក្តី ស្រលាញ់ របស់ ពួកគេ ចំពោះ គ្នា ទៅ វិញ ទៅមក បាន នាំមក នូវ ភាពរីករាយ និង សុភមង្គល ក្នុង គ្រួសារ ថ្មី ថ្មោង នេះ ផងដែរ ។
លោកស្រី បញ្ជាក់ ទៀត ថា ការចាប់ រង្វាន់ នឹង ធ្វើឡើង ចំនួន ៣លើក បន្ត ទៀត ដែល រង្វាន់ កាន់ តែ ពិសេស នោះ គឺ ជី ប ម៉ុង ផាក លែន ខុនដូ១ យូនីត តែម្តង សម្រាប់ ការចាប់ឆ្នោត សរុប លើក ចុងក្រោយ ។
ដូច្នេះ សម្រាប់ គូស្នេហ៍ ដែល មាន បំណង រៀប មង្គលការ ក្នុង ពេល ឆាប់ ៗ នេះ សូម ជ្រើសរើស ស្រាបៀរ កម្ពុជា កំប៉ុង ចំនួន ២៥ កេស ឡើង ទៅ លោក អ្នក នឹង ទទួលបាន ការថែម ជូន ៣កេស បន្ថែម សៀវភៅ កត់ ចំណង ដៃ ២ក្បាល និង បណ្ណ ផ្សង សំណាង មួយ សន្លឹក ផងដែរ ហើយ ការចាប់ឆ្នោត បន្ទាប់ នឹង ធ្វើឡើង ក្នុង រយៈពេល ២ខែ បន្ទាប់ ៕ ស្វែងយល់ ពី ប្រភេទ វីរុស ដ៏ កាច សាហាវ នៅលើ ពិភពលោក ដែល មាន ប្រភព មកពី សត្វ
ដោយឡែក ឆ្នាំ ដែល ល្អ វិញ រួម មាន៖ ឆ្លូវ រោង ម្សាញ់ និង វក ។ សម្រាប់ ការរៀបអាពាហ៍ពិពាហ៍ ដែល ល្អ ជាង គេ វិញ រួម មាន៖ ឆ្លូវ រោង ម្សាញ់ វក រ កា ។ ក្រៅពី នោះ អាច រៀបអាពាហ៍ពិពាហ៍ បាន តែ កុំ អាល យក កូន ។
គួរ បញ្ជាក់ ថា បើ តាម ក្រុម មន្ត្រី កូរ៉េ ខាងត្បូង កូរ៉េ ខាងជើង បាន ជូន ដំណឹង ដល់ ស្ថានទូត នៃ បណ្ដា ប្រទេស ដែល មាន ទំនាក់ទំនង ការទូត ជាមួយ ខ្លួន ថា លោក Ri Son Gwon ត្រូវបាន តែងតាំង ជា រដ្ឋមន្ត្រី ការបរទេស ថ្មី កាលពី សប្ដាហ៍ មុន មក ម្លេះ ហើយ លោក Ri ផ្ទាល់ បាន ថ្លែង សារ ក្នុង នាម ជា រដ្ឋមន្ត្រី នា ឱកាស ចូលរួម ពិធី ទទួលទាន អាហារ ពេលល្ងាច អបអរ ឆ្នាំ ថ្មី រៀបចំឡើង ដោយ ក្រសួង ការបរទេស កូរ៉េ ខាងជើង កាលពី ថ្ងៃព្រហស្បតិ៍ សម្រាប់ បណ្ដា ស្ថានទូត និង អង្គការ អន្តរជាតិ មួយចំនួន ៕
( ភ្នំពេញ ) ៖ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន រៀបចំ ពិធី ចុះហត្ថលេខា លើ អនុស្សារណៈ នៃ កិច្ចព្រមព្រៀង (MoU) ជាមួយ អង្គការ ចំនួន ១១ ក្នុង ទំហំ ទឹកប្រាក់ សរុប ១២. ៧២៤. ៧៤៥ ដុល្លារ ប្រើប្រាស់ ក្នុង រយៈពេល ៣ ឆ្នាំ ដើម្បី ជួយ ក្នុង វិស័យ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ដោយ ផ្តោត សំខាន់ លើ ការជួយ ជនរងគ្រោះ និង ងាយ រងគ្រោះ នៅ កម្ពុជា រយៈពេល ៣ឆ្នាំ ។
ពិធី ចុះហត្ថលេខា នៃ កិច្ចព្រមព្រៀង (MoU) នា ពេលនេះ បាន រៀបចំឡើង ជា ផ្លូវការ នា ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០២០ ដឹកនាំ ដោយ លោក តូច ចាន់ នី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន បច្ចេកទេស ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ អង្គការ ទាំង ១១ រួម នឹង មន្រ្តី រាជការ ពាក់ព័ន្ធ របស់ ក្រសួង ជាច្រើន រូប ទៀត ផងដែរ ។
អង្គការ ទាំង ១១នោះ រួម មាន៖
បន្ថែម ពីលើ នោះ លោក តូច ចាន់ នី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន បច្ចេកទេស តំណាង លោក វង សូត រដ្ឋមន្ត្រី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន លើកឡើង ថា ការចូលរួម សហការ របស់ អង្គការ ដៃគូ ពិតជា សំខាន់ ណាស់ ក្នុង ការលើកកម្ពស់ វិស័យ សង្គមកិច្ច នៅ កម្ពុជា ។
ជាមួយគ្នា នោះ លោក តូច ចាន់ នី បាន ស្នើឲ្យ ក្រុមការងារ ក្រសួង និង អង្គការ ដែល សហការ នា ពេលនេះ រួមគ្នា ដើម្បី ធ្វើ ការងារ ដោយ យកចិត្តទុកដាក់ ឲ្យ ខ្លាំង បំផុត តាម ដែល អាច ធ្វើ បាន ។ សម្រាប់ ក្រសួង សង្គមកិច្ច វិញ នៅតែ ស្វាគមន៍ ជានិច្ច ជាមួយ ដៃគូ ពាក់ព័ន្ធ ដើម្បី ជួយ ដល់ ជនរងគ្រោះ ងាយ រងគ្រោះ នៅ កម្ពុជា ឲ្យ មាន ជីវភាព និង ជីវិត រស់ នៅ ល្អ ប្រសើរ ថែម មួយ កម្រិត ទៀត ។
បន្ថែម ពីលើ នោះ ទៀត លោក បាន បន្ថែម ថា រាល់ អង្គការ ដៃគូ ទាំងអស់ ដែល បាន ចុះ កិច្ចព្រមព្រៀង ជាមួយ ក្រសួង សូម ធ្វើ ប្រតិបត្តការទៅ តាម លក្ខខណ្ឌ ហើយ សុំ ធ្វើ តែ កិច្ចការ ការងារ សង្គម តែ ប៉ុណ្ណោះ មិន ត្រូវ ធ្វើ ការងារ នយោបាយ ឡើយ ប្រសិនបើ ក្រសួង រកឃើញ ថា អង្គការ ណាមួយ មិន បាន គោរព តាម លក្ខខណ្ឌ នៃ កិច្ចព្រមព្រៀង យក ការងារ សង្គម មក ធ្វើជា ការងារ នយោបាយ ក្រសួង នឹង បញ្ចប់ កិច្ចព្រមព្រៀង ភ្លាម នឹង ឈានដល់ បញ្ឈប់ សកម្មភាព ៕
គម្រោង បង្កើត រោងចក្រ កាត់ដេរ សម្លៀកបំពាក់ ប្រើ ទុន វិនិយោគ ជិត ១១លាន ដុល្លារ នៅ ស្រុក គងពិសី ខេត្ត កំពង់ស្ពឺ ត្រូវបាន ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា អនុម័ត
( ភ្នំពេញ ) ៖ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា (CDC) ទើបតែ អនុម័ត ចេញ វិញ្ញាបនប័ត្រ ចុះបញ្ជី ជា ស្ថាព រ នូវ គម្រោង វិនិយោគ ថ្មី ចំនួន ១ទៀត សរុប ទុន វិនិយោគ ជិត ១១លាន ដុល្លារ អាមេរិក និង ផ្តល់ ការងារ ថ្មី ជាច្រើន ពាន់ កន្លែង ។
ឆ្លើយតប ទៅនឹង បញ្ហា ខាងលើ នេះ ទីភ្នាក់ងារ ឧតុនិយម ចិន បាន ណែនាំឲ្យ អ្នកបើកបរ យានជំនិះ នានា នៅ តាម តំបន់ រង ការប៉ះពាល់ គួរ បន្ថយ ល្បឿន ហើយ ស្នើឲ្យ ព្រលានយន្តហោះ ស្ថានីយ រថភ្លើង និង កំពង់ផែ នានា ចាត់ វិធានការ សុវត្ថិភាព តាម ការគួរ ។
គួរ ជម្រាប ថា ប្រទេស ចិន មាន ប្រព័ន្ធ ប្រកាស អាសន្ន សម្រាប់ ការចុះ អ័ព្ទ ដែល ប្រើ ពណ៌ ចំនួន ៣ គឺ លឿង ទឹកក្រូច និង ក្រហម ដើម្បី តំណាង ឲ្យ កម្រិត ប្រកាស អាសន្ន ហើយ ក្នុង នោះ ពណ៌ ក្រហម ជា កម្រិត ធ្ងន់ ជាង គេ បង្អស់ ។ ជាមួយគ្នា នេះ ទីភ្នាក់ងារ ឧតុនិយម ចិន ក៏ បាន ព្យាករណ៍ អំពី ការធ្លាក់ ភ្លៀង និង ព្រិល ខ្លាំង នៅ តាម តំបន់ ភាគ ត្បូង ប្រទេស ផងដែរ ក្នុង កំឡុង រយៈពេល ០៣ ថ្ងៃ ខាងមុខ ។
