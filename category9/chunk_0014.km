( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ . របួស ស្រាល ៦នាក់ និង របួស ធ្ងន់ ៦នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង១០លើក នេះ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . មិន គោរព សិទ្ធិ . ប្រជែង និង ស្រវឹង ៕
សេចក្តីរាយការណ៍ បាន បញ្ជាក់ ទៀត ថា បើ តាម បុគ្គលិក ក្នុង ហេតុ ដែល បាន ឃើញ ហេតុការណ៍ នេះ បាន បញ្ជាក់ ថា មុនពេល កើត ហេតុ គេ ឃើញ បុរស រងគ្រោះ និង បុរស ម្នាក់ ទៀត ដែល ជា ជនដៃ ដល់ បាន ជិះ រថយន្ត មក ជាមួយគ្នា ដើម្បី ហូប ស៊ុប ពេល ជិត មកដល់ ភោជនីយដ្ឋាន ជនរងគ្រោះ បាន ដើរ ចូលក្នុង ហាង អង្គុយ តុ មុន ឯ ជន ដៃ ដល់ ក៏ នៅ រៀបចំ ចត រថយន្ត នៅ ខាងក្រៅ ។ បន្ទាប់ពី ចត រថយន្ត រួច ជន ដៃ ដល់ បាន ដើរ ចូលក្នុង ហាង និង ទាញ កាំភ្លើង បាញ់ ផ្អឹប សៀត ផ្កា ជនរងគ្រោះ ១គ្រាប់ បណ្តាលឲ្យ ជនរងគ្រោះ អង្គុយ ស្លាប់ លើ តុ ។
ជនរងគ្រោះ មិន ទាន់ ត្រូវបាន គេ ស្គាល់ អត្តសញ្ញាណ នោះ ឡើយ ដោយ រង់ចាំ មន្ត្រី ជំនាញ ធ្វើ កោសល្យវិច្ច័យ សិន ៕ សិង្ហបុរី បារម្ភ អំពី ភាពតានតឹង នៅ តំបន់ មជ្ឈិមបូព៌ា និង អំពាវនាវ ឲ្យ ពលរដ្ឋ ខ្លួន កុំ ធ្វើដំណើរ ទៅកាន់ ប្រទេស អ៉ីរ៉ាក់ និង អ៉ីរ៉ង់
លោក ដូណាល់ ត្រាំ នឹង ធ្វើ សេចក្ដីថ្លែងការណ៍ នៅ ម៉ោង ១១ព្រឹក ថ្ងៃពុធ នេះ ( ម៉ោង នៅ វ៉ាស៊ីនតោន ) ជុំវិញ ការវាយប្រហារ របស់ អ៉ីរ៉ង់ លើ មូលដ្ឋាន ទ័ព អាមេរិក នៅ អ៊ីរ៉ាក់
( វ៉ាស៊ីនតោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នឹង ធ្វើ សេចក្ដីថ្លែងការណ៍ មួយ នៅ ម៉ោង ១១ព្រឹក ថ្ងៃពុធ សប្ដាហ៍ នេះ ( ម៉ោង នៅ វ៉ាស៊ីនតោន ) ជុំវិញ ការវាយប្រហារ ដោយ មីស៊ីល រាប់ សិប គ្រាប់ របស់ អ៊ីរ៉ង់ លើ មូលដ្ឋាន ទ័ព អាមេរិក ចំនួន ពីរ កន្លែង នៅក្នុង ប្រទេស អ៊ីរ៉ាក់ ។ នេះ បើ តាម សេតវិមាន ដកស្រង់ ចេញ ផ្សាយ ដោយសារព័ត៌មាន Bloomberg នៅ ថ្ងៃពុធ ទី ០៨ ខែមករា ឆ្នាំ ២០២០ ។
ត្រឹម រយៈពេល ជិត ៤ឆ្នាំ ប្រជាពលរដ្ឋ ខ្មែរ ចាស់ ក្មេង សរុប ជិត ២លាន នាក់ បាន ស្លាប់ បាត់បង់ជីវិត ដោយសារតែ មិន អាច ទ្រាំ ចំពោះ ទារុណកម្ម ការអត់ឃ្លាន ជំងឺ តម្កាត់ និង ការកាប់ សម្លាប់ ក្រោម ការចោទប្រកាន់ ថា ជា ខ្មាំង នោះ ។ ក្រៅពី ការកាប់ សម្លាប់ ហើយ នោះ របប ខ្មែរ ក្រហម បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ ត្រូវ និរាស ព្រាត់ប្រាស់ គ្នា យ៉ាង ខ្លោចផ្សារ ជា ទីបំផុត ។ របប ដឹកនាំ ដោយ បន ប្រល័យ ពូជសាសន៍ នេះ បាន ធ្វើឱ្យ ជីវិត ប្រជាពលរដ្ឋ ខ្មែរ ប្រៀប ដូចជា ស្ថិត ក្នុង ឋាននរក ទាំង នៅ រស់ ។
ព្រោះតែ ក្តី វេទនា មិន អាច គណនា បាន ក្រោម ការដឹកនាំ របស់ បន ប្រល័យ ពូជសាសន៍ ប៉ុល ពត នេះ ប្រជាពលដ្ឋ ខ្មែរ តែង លួច បន់ ព្រះសំពះ ទេវតា ស្វែងរក អ្នក ជ័យសង្គ្រោះ ជីវិត របស់ ពួកគេ ឱ្យ រួចផុត ពី ជីវិត ដ៏ សែន វេទនា នោះ ។ ព្រោះតែ មិន អាច ទ្រាំ ជាមួយ ទុក្ខវេទនា ការជិះ ជាន់ និង កាប់ សម្លាប់ គ្មាន ត្រា ប្រណី របស់ បន ប្រល័យ ពូជសាសន៍ នេះ ខ្មែរ អ្នកតស៊ូ ដោយ មាន កងទ័ព វៀតណាម ជា បង្អែក បាន ប្រយុទ្ធ និង វាយ ផ្តួលរលំ របប ខ្មែរ ក្រហម នៅ ថ្ងៃទី ៧ ខែមករា ឆ្នាំ ១៩៧៩ ។
ពលរដ្ឋ ខ្មែរ ដែល បាន រួច ចេញ គុក ឥត ជញ្ជាំង នៃ របប អាវ ខ្មៅ នេះ សែន រីករាយ មិន អាច រក អ្វី មក ប្រៀបផ្ទឹម បាន នោះ ឡើយ ។ ការដួលរលំ របប កម្ពុជា ប្រជាធិបតេយ្យ ត្រូវបាន ប្រជាពលរដ្ឋ ខ្មែរ ប្រដូច ទៅនឹង ការរំដោះ ជីវិត ចេញ ពី ឋាន នរក ដូច្នោះ ដែរ ។
ប្រជាពលរដ្ឋ ខ្មែរ រួច ជីវិត ចេញ ពី ចង្កូម មច្ចុរាជ នៃ របប កម្ពុជា ប្រជាធិបតេយ្យ តែងតែ ប្រារព្ធ ពិធី អបអរសាទរ យ៉ាង កង រំពង ចំពោះ ថ្ងៃ ជ័យជម្នះ ៧មករា នេះ ។ ការប្រារព្ធ ពិធី អបអរសាទរ ថ្ងៃ ជ័យជម្នះ ៧មករា ជា ការរំលឹក ដល់ វីរភាព របស់ អ្នកតស៊ូ ទាំងឡាយ និង រំលឹក ទៅដល់ ការលះបង់ ពលី ជីវិត របស់ វីរ យុទ្ធជន វីរ យុទ្ធ នារី ទាំងឡាយ ក្នុង បុព្វហេតុ រំដោះ ជាតិ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ។
ប្រជាពលរដ្ឋ ក្នុង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ជាង ២ពាន់ នាក់ នៅ ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ បាន ជួបជុំគ្នា ប្រារព្ធ ពិធី អបអរសាទរ ថ្ងៃ ដែល ពួកគេ បាន រស់រាន មាន ជីវិត ជាថ្មី និង មាន សិទ្ធិ សេរីភាព ក្នុង ការប្រកបរបរ ចិញ្ចឹម ជីវិត និង ធ្វើ សកម្មភាព ផ្សេង ៗ ជាថ្មី ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ឧកញ៉ា ទ្រី ភាព អគ្គ នាយក ក្រុមហ៊ុន ទ្រីភាព និង ជា ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
ពលរដ្ឋ ខ្មែរ ដែល រួច ជីវិត ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម បាន ហៅ ថ្ងៃ ជ័យជម្នះ ៧មករា ថ្ងៃ ដែល របប ខ្មែរ ក្រហម ដួលរលំ គឺជា ថ្ងៃ ដ៏ មាន គុណ សម្រាប់ ជីវិត របស់ ពួកគេ ។ បើ គ្មាន ការរំដោះ នេះ ទេ គឺ ជីវិត របស់ ពួកគេ ប្រឈម នឹង ការស្លាប់ គ្រប់ ពេលវេលា ។ បើ មិន ស្លាប់ នឹង ការសម្លាប់ នោះ ទេ ក៏ នឹង ត្រូវ ស្លាប់ ដោយសារ ការអត់ឃ្លាន និង ជំងឺ ផងដែរ ។
លោក ឧកញ៉ា ទ្រី ភាព បាន ថ្លែង ថា ផ្តើម ចេញ ពី ថ្ងៃ រំដោះ ៧មករា នោះ ហើយ ធ្វើឱ្យ ជាតិ និង ប្រជាជន កម្ពុជា រស់ ឡើងវិញ ហើយ ផ្តើម ចេញ ពី ថ្ងៃ ៧មករា នោះ ហើយ ដែល នាំឱ្យ កម្ពុជា មាន ការអភិវឌ្ឍ និង រីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
របប ខ្មែរ ក្រហម រយៈពេល ជិត ៤ ឆ្នាំ បាន បំផ្លាញ ជាតិ កម្ពុជា ស្ទើរតែ ក្លាយទៅជា ផេះ ផង់ ។ មិន ត្រឹមតែ សេដ្ឋកិច្ច ជាតិ ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ នោះ ទេ សូម្បីតែ ធនធាន មនុស្ស ក៏ បាត់បង់ ស្ទើរតែ អស់ ផងដែរ ។
កម្ពុជា បាន ប្រែក្លាយ ពី វាល ពិឃាត នៃ របប ប្រល័យ ពូជសាសន៍ ពី សមរភូមិ នៃ សង្គ្រាម ដ៏ រ៉ាំរៃ ពី ទឹកដី ដែល គ្មាន សេរីភាព ពី ការបែកបាក់ ជាតិ និង បែងចែក ទឹកដី និង ពី គំនរ ផេះ ផង់ ទៅជា ទឹកដី ប្រកបដោយ សន្តិភាព ស្ថិរភាព សេរីភាព ប្រជាធិបតេយ្យ នីតិរដ្ឋ និង កំពុង អភិវឌ្ឍ ដ៏ ខ្លាំងក្លា លើ គ្រប់ វិស័យ ធ្វើឱ្យ ប្រជាជន បាន រស់ នៅ យ៉ាង សុខសាន្ត និង ប្រកបដោយ ក្តីសង្ឃឹម ចំពោះ អនាគត របស់ ខ្លួន ។
លោក ទ្រី ភាព លើកឡើង ថា តាមរយៈ ការរីកចម្រើន នេះ បាន ឆ្លុះបង្ហាញ ឱ្យ ឃើញ ពី ភាពប៉ិនប្រសប់ ក្នុង ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។ លោក ទ្រី ភាព បាន មើលឃើញ ថា វឌ្ឍនភាព ដ៏ រុងរឿង របស់ ជាតិ កម្ពុជា មិន អាច កើតមាន ឡើយ បើ គ្មាន ការធ្វើ ពលី កម្មកម្លាំង កាយ ចិត្ត របស់ សម្តេច តេជោ ហ៊ុន សែន រាប់ ចាប់ ត្រឹម ពី ការយក ជីវិត ធ្វើ ការតស៊ូ ផ្តួលរំលំ របប ខ្មែរ ក្រហម នៅ ឆ្នាំ ១៩៧៧មក នោះ ។
ប្រជាពលរដ្ឋ ខ្មែរ ដែល រួច ជីវិត ពី របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ក៏ បាន មើលឃើញ ដូចគ្នា ចំពោះ ការរីកចម្រើន របស់ កម្ពុជា ក្រោយ ការផ្តួលរំលំ របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត រយៈពេល ៤១ ឆ្នាំ មក នេះ ៕
ជាមួយគ្នា នោះ ឯក អគ្គ រដ្ឋទូត អាមេរិក ក៏ បាន លើកឡើង ផងដែរ ថា ទំនាក់ទំនង ( អាមេរិក - កម្ពុជា ) ៧០ ឆ្នាំ មក នេះ វា មិន មែន សុទ្ធតែ ស្រួល នោះ ទេ វា ក៏ មាន បញ្ហា ប៉ុន្ដែ យើង ផ្ដោត អារម្មណ៍ លើ វិស័យ នៃ កិច្ចសហប្រតិបត្ដិការ ដែល នឹង ជួយ ជំរុញ កិច្ចសហប្រតិបត្ដិការ នេះ ឲ្យបាន ល្អ ហើយ ជួយ ប្រទេស កម្ពុជា ឲ្យ មាន ភាពរីកចម្រើន ។
យោង តាម លទ្ធផល ប្រកួតប្រជែង បង្ហាញ នៅលើ គេហទំព័រ ប្រឡង គណិតវិទ្យា ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ បាន បង្ហាញ ថា កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា បាន ឈរ នៅលើ កំពូល តារាង ក្នុង ចំណោម សិស្ស ១០០ នាក់ ទាំង នៅក្នុង តំបន់ អាស៊ី និង ពិភពលោក ជាមួយ ពិន្ទុ ១២១៧០ ។
ជាមួយ ការដណ្តើម បាន ចំណាត់ថ្នាក់ កំពូល តារាង របស់ កុមារី ហ៊ុន ពេជ្រ មុន្នីលីណា បាន ធ្វើឲ្យ រូបភាព ទង់ជាតិ របស់ កម្ពុជា ត្រូវបាន បង្ហាញ លើ កំពូល តារាង គេហទំព័រ «Mathletics» ដែល ជា គេហទំព័រ បង្រៀន គណិតវិទ្យា និង មាន ការប្រកួតប្រជែង គណិតវិទ្យា របស់ កុមារា កុមារី មកពី ប្រទេស ជាច្រើន នៅលើ ពិភពលោក ។
តាមរយៈ លទ្ធផល នេះ បាន លើក តម្លៃ អប់រំ នៅ កម្ពុជា នា ពេល បច្ចុប្បន្ន ហើយ បាន បង្ហាញ ថា ភាព វៃឆ្លាត របស់ កុមារ កម្ពុជា មិន ចាញ់ កុមារ នៅលើ ពិភពលោក នោះ ឡើយ ។
តាមរយៈ សមត្ថភាព លិច ធ្លោ លើ ការប្រកួតប្រជែង គណិតវិទ្យា នេះ បាន បង្ហាញ ពី សមត្ថភាព របស់ កូន ខ្មែរ ។ បើ ទោះបី ប្រទេស នេះ ធ្លាប់ ជា ប្រទេស រស់ នៅ ក្រោម អាណានិគម ជា ប្រទេស ធ្លាប់ យាយី ដោយ ភ្លើង សង្គ្រាម តែ បច្ចុប្បន្ន ប្រជាជាតិ កម្ពុជា ក្រោម ម្លប់ សន្តិភាព កំពុង មាន ឱកាស ទទួលបាន ចំណេះដឹង និង ប្រកួតប្រជែង សមត្ថភាព ជាមួយ មនុស្សជាតិ នៅលើ ពិភពលោក ហើយក៏ អាច ដណ្តើម បាន ចំណាត់ថ្នាក់ ខ្ពស់ លើស គេ ផងដែរ ៕ មេដឹកនាំ កំពូល អ៉ីរ៉ង់៖ ការវាយប្រហារ ដោយ មីស៊ីល របស់ យើង គឺជា ការទះមុខ អាមេរិក មួយ កំផ្លៀង
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០
១៖ អ្នកនាំពាក្យ ក្រសួង ការបរទេ ស៖ កម្ពុជា ព្រួយបារម្ភ យ៉ាង ខ្លាំង ចំពោះ ភាពតានតឹង រវាង អាមេរិក និង អ៉ីរ៉ង់ ហើយ ចង់ ឃើញ ដំណោះស្រាយ ដោយ សន្តិវិធី ( ចុច អាន )
៥៖ ស្ថានទូត សិង្ហបុរី ចូលរួម រំលែក ទុក្ខ ចំពោះ ក្រុមគ្រួសារ នៃ ជនរងគ្រោះ ដែល បាន បាត់បង់ ជិវិត ក្នុង ការបាក់ រលំអាគារ នៅ ខេត្ត កែប ( ចុច អាន )
៧៖ ៣ ថ្ងៃ ទៀត ទឹក ស្ទឹង មង្គលបុរី នឹង រីងស្ងួត អស់ ប៉ះពាល់ ដល់ ពលរដ្ឋ ជាង ៨ ពាន់ គ្រួសារ . ក្រសួង ធនធាន ទឹក និង អាជ្ញាធរ កំពុង បើក ប្រតិបត្តិការ ជួយ អន្ដរាគមន៍ ( ចុច អាន )
៨៖ ព្រះរាជ ទ្រព្យ ២ម៉ឺន ដុល្លារ . គ្រឿង បរិភោគ និង សម្ភារ ព្រះរាជ អំណោយ របស់ សម្តេច ម៉ែ ត្រូវបាន ប្រគល់ ដល់ គ្រួសារ ជនរងគ្រោះ រលំអគារ នៅ ខេត្ត កែប រួចរាល់ ហើយ ( ចុច អាន )
១៖ អាមេរិក អះអាង ថា អ៊ីរ៉ង់ បាញ់ ស្រោច មីស៊ីល រាប់ សិប គ្រាប់ លើ មូលដ្ឋាន ទ័ព ក្នុង ប្រទេស អ៊ីរ៉ាក់ នាំឲ្យ មនុស្ស មួយចំនួន ស្លាប់ និង រងរបួស ! ( ចុច អាន )
២៖ យោធា អ៉ី រ៉ង់ អះអាង ថា យោធា អាមេរិក ៨០ នាក់ ត្រូវបាន សម្លាប់ នៅក្នុង ការវាយប្រហារ ដោយ គ្រាប់ មីស៊ីល ( ចុច អាន )
៦៖ ការធ្លាក់ យន្តហោះ ស្លាប់ មនុស្ស ១៧៦ នាក់ នៅ ទីក្រុង តេហេរ៉ង់ របស់ អ៉ីរ៉ង់ មិន មែន ព្រោះតែ ភេរវកម្ម ឬ មីស៊ីល នោះ ទេ គឺ វា ធ្លាក់ ដោយសារ ម៉ាស៊ីន ជួប បញ្ហា ( ចុច អាន )
៧៖ ចំណោម អ្នកស្លាប់ ទាំង ១៧៦ នាក់ ក្នុង គ្រោះថ្នាក់ ធ្លាក់ យន្តហោះ នៅ អ៉ី រ៉ង់ មាន ជនជាតិ អ៉ីរ៉ង់ ច្រើន ជាង គេ រហូតដល់ទៅ ៨២ នាក់ ( ចុច អាន )
១១៖ វេណេស៊ុយអេឡា៖ មេ បក្ស ប្រឆាំង លោក ហ្គៃ ដូ ត្រូវបាន កងកម្លាំង សន្តិសុខ លោក ម៉ាឌូរ៉ូ រារាំង មិន ឱ្យ ចូលក្នុង រដ្ឋសភា ( ចុច អាន )
១៤៖ គ្រោះ រញ្ជួយ ដី ២លើក ផ្ទួន គ្នា វាយប្រហារ ចំក្បែរ រោងចក្រ ថាមពល នុយក្លេអ៊ែរ នៅ ប្រទេស អ៊ីរ៉ង់ ( ចុច អាន )
អ្នកធ្វើដំណើរ តាម ផ្លូវ ជាតិ លេខ ៥ ស្នើ មន្ដ្រី រដ្ឋបាល ព្រៃឈើ ចុះ ណែនាំ អ្នកលក់ដូរ សត្វ ស្លាប នៅ តាម ផ្លូវ ក្រោយ យក ឆ្មា ស្រុក បន្លំ ធ្វើ សត្វ ខ្លា ត្រី
( កំពង់ឆ្នាំង ) ៖ អ្នកធ្វើដំណើរ តាម ផ្លូវ ជាតិ លេខ ៥ ពិសេស នៅ ម្ដុំ ស្រុក រលាប្អៀរ ខេត្ត កំពង់ឆ្នាំង ស្នើ ដល់ មន្ដ្រី ពាក់ព័ន្ធ ពិសេស មន្ដ្រី រដ្ឋបាល ព្រៃឈើ ចុះ អប់រំ ណែនាំ ការលក់ដូរ សត្វ ស្លាប ក្រោយ មាន ព័ត៌មាន ថា ការលក់ដូរ នេះ បន្លំ អ្នកទិញ ព្រោះ អ្នក លក់ បាន យក សត្វ ឆ្មារ ស្រុក មក បន្លំ ធ្វើ សត្វ ខ្លា ត្រី ជាដើម ។
លោក ថោង វ៉ាន់ វីរ៉ាវុឌ្ឍី នាយ ខណ្ឌ រដ្ឋបាល ព្រៃឈើ កំពង់ឆ្នាំង បាន ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នៅ ល្ងាច ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ នេះ ថា ករណី ការដាក់ តាំង សត្វ ព្រៃ លក់ តាម បណ្ដោយ ផ្លូវ ជាតិ លេខ ៥ ត្រង់ ចំណុច ភូមិ អូរ សណ្ដាន់ ឃុំ ទឹក ហូត ខាងលើ នេះ កន្លងមក ខាងកម្លាំង របស់ លោក ក៏ ធ្លាប់ បាន ធ្វើ ការចុះបង្ក្រាប ផងដែរ ដើម្បី កុំ ឲ្យ ពួកគាត់ បរបាញ់ សត្វ ព្រៃ ដែល មាន ដូចជា ខ្លា ត្រី ឆ្មា ព្រៃ ។ល ។
លោក បាន បញ្ជាក់ ទៀត ថា ការយក សត្វ ទាំងនោះ មក ដាក់ លក់ តាម ផ្លូវថ្នល់ ក៏ ខុស នឹង ច្បាប់ ផងដែរ ប៉ុន្ដែ ក្រោយមក លោក ទទួលបាន ព័ត៌មាន ថា សត្វ ដែល ពួកគាត់ ដាក់ តាំង លក់ នោះ គឺ មិន មែន ជា ខ្លា ត្រី ឬ ឆ្មា ព្រៃ នោះ ឡើយ ពោល ជា សត្វ ឆ្មា ស្រុក ដូច្នេះ ខាង លោក មិន បាន ធ្វើ ការបង្ក្រាប ទេ ព្រោះ សត្វ ស្រុក ប្រជាពលរដ្ឋ ទូទៅ អាច ចិញ្ចឹម លក់ បាន ។
ទោះជា យ៉ាង នេះ ក៏ដោយ ប្រជាពលរដ្ឋ អ្នកធ្វើដំណើរ នៅលើ ផ្លូវ ជាតិ លេខ៥ ឆ្លងកាត់ តំបន់ ខាងលើ នេះ បាន ធ្វើ ការរិះគន់ ចំពោះ ចំណាត់ការ អាជ្ញាធរ និង សមត្ថកិច្ច ជំនាញ ដែល មិន ធ្វើ ការរៀបចំ សោភ័ណភាព តាម ផ្លូវ ដោយ បណ្ដែតបណ្ដោយ ឲ្យ ដាក់ លក់ សត្វ ព្រៃ ក៏ ដូចជា សត្វ ឆ្មា ស្រុក នៅ តាម ផ្លូវ សាធារណៈ ដែល ធ្វើឲ្យ មាន ការរិះគន់ ពី ភ្ញៀវ ជាតិ និង ភ្ញៀវ បរទេស ផងដែរ ៕
រដ្ឋមន្ត្រី ថោង ខុន៖ អ្នក មិន គាំទ្រ ស្មារតី ៧មករា គឺជា អ្នក មិន ស្រលាញ់ សន្តិភាព និង ប្រជាជន !
លោក បាន បន្ត ថា ការប្រារព្ធ ទិវា ជ័យជម្នះ ៧ មករា គឺជា ការទទួលស្គាល់ សច្ចធម៌ ប្រវត្តិសាស្ត្រ ។ អស់ រយៈពេល ៤១ ឆ្នាំ ហើយ ដែល ប្រជាពលរដ្ឋ កម្ពុជា ចូលរួម ប្រារព្ធ ទិវា ជ័យជម្នះ ៧ មករា មិន ដែល មាន ការរុញ រា ម្ដង ណា ឡើយ ។
លោក បាន បន្ត ថា មានជ័យជម្នះ ៧ មករា ទើប មាន សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ដូច ពេល បច្ចុប្បន្ន ។ ក្នុង រយៈពេល ៤១ ឆ្នាំ នៃ ដំណើរការអភិវឌ្ឍ ប្រទេស នេះ កម្ពុជា ទទួលបាន ការកោតសរសើរ ល្អ ក្រៃលែង និង គ្មាន អ្នកណា នឹកស្មាន ដល់ ថា កម្ពុជា អាច អភិវឌ្ឍន៍ ខ្លួន លឿន ឆាប់រហ័ស យ៉ាង ដូច្នេះ សោះ ។
លោក ថា កាលពី មហាសន្និបាត សមាគម អភិបាល ក្រុង និយាយ ភាសា បារាំង នៅ រាជធានី ភ្នំពេញ នា ដើម ខែធ្នូ ឆ្នាំ ២០១៩ កន្លងទៅ លោក បាន ធ្វើ បទបង្ហាញ ពាក់ព័ន្ធ នឹង ការអភិវឌ្ឍ ទីក្រុង ភ្នំពេញ ក៏ ដូចជា ប្រទេស កម្ពុជា ក្រោយ ការដួលរលំ របប ប្រល័យ ពូជសាសន៍ ខ្មែរ ក្រហម ។ បណ្ដា អភិបាល ក្រុង និយាយ ភាសា បារាំង ទាំងនោះ លើកឡើង ថា ពួកគេ មិន នឹកស្មាន ទាល់តែសោះ ថា កម្ពុជា អាច កសាង អភិវឌ្ឍន៍ ខ្លួន តាំងពី បាត ដៃ ទទេ បាន លឿន ដូច្នេះ សោះ ។
លោក បាន បន្ត ថា លោក បាន ប្រាប់ បណ្ដា អភិបាល ក្រុង និយាយ ភាសា បាំ រាំង ទាំងនោះ ថា នេះ ហើយ ជា សច្ចធម៌ ប្រវត្តិសាស្ត្រ របស់ កម្ពុជា ក៏ ដូចជា របស់ មនុស្សជាតិ ទូទាំង ពិភពលោក ។ បណ្ដា អភិបាល ក្រុង និយាយ ភាសា បាំ រាំង ទាំងនោះ ក៏ បាន ចាត់ទុក កម្ពុជា ជា ប្រទេស គំរូ មួយ ក្នុង ការអភិវឌ្ឍ តាំងពី បាត ដៃ ទទេ ឬ ក្រោយ ដំណាក់កាល សង្គ្រាម ។
សូម ជម្រាប ថា ការប្រារព្ធ ទិវា ជ័យជម្នះ ៧ មករា ( ១៩៧៩ - ២០២០ ) ខាងលើ ត្រូវបាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២០ ។ ក្រោយ បញ្ចប់ ការប្រារព្ធ ទិវា នេះ រួចហើយ លោក ថោង ខុន ព្រមទាំង ថ្នាក់ដឹកនាំ និង ប្រជាពលរដ្ឋ ក៏ បាន អញ្ជើញ ចូលរួម ពិសា អាហារ សាមគ្គី និង នំបញ្ចុក តេជោ សន្តិភាព រួមគ្នា ផងដែរ ។
សណ្ឋាគារ ហា យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ នឹង បើក ដំណើរការ ក្នុង ត្រីមាស ទី៣ ឆ្នាំ ២០២០ នេះ
( ភ្នំពេញ ) ៖ សណ្ឋាគារ ហា យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ ដែល ជា ពាណិជ្ជកម្ម មួយ របស់ ក្រុមហ៊ុន ជី ប ម៉ុង គ្រោង នឹង ដាក់ ឲ្យ ដំណើរការ ដើម្បី បម្រើ ភ្ញៀវ ជាតិ និង អន្តរជាតិ ក្នុង ឆ្នាំ ២០២០ នេះ ។
សណ្ឋាគារ ហា យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ វិនិយោគ លើ ការសាងសង់ ដោយ ក្រុមហ៊ុន ជី ប ម៉ុង ។ ចំណែកឯ ប្រព័ន្ធ គ្រប់គ្រង របស់ សណ្ឋាគារ នេះ គឺ ប្រើប្រាស់ ប្រព័ន្ធ គ្រប់គ្រង ស្តង់ដារ អន្តរជាតិ របស់ សណ្ឋាគារ ហា យ៉ាត់ សាកល ដ៏ ទំនើប ដើម្បី ធានា លើ ការបម្រើ សេវា បដិសណ្ឋារកិច្ច និង សណ្ឋាគារ ដ៏ ល្អ ឥត ខ្ចោះ ជូន ដល់ ភ្ញៀវ ទេសចរណ៍ ធុរ ជន កម្ពុជា និង អន្តរជាតិ ។
ការលេចឡើង នៃ វត្តមាន សណ្ឋាគារ ហា យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ លំដាប់ថ្នាក់ អន្តរជាតិ មួយ នេះ កំពុង រួមចំណែក យ៉ាង សំខាន់ ក្នុង វិស័យ ទេសចរណ៍ ក៏ ដូចជា ទាក់ទាញ ទាំង ភ្ញៀវ ទេសចរណ៍ និង ធុរ ជន កម្ពុជា និង អន្តរជាតិ មកកាន់ រាជធានី ភ្នំពេញ កាន់តែ ច្រើន ។
សណ្ឋាគារ លំដាប់ ផ្តាយ ៥នេះ ស្ថិត នៅ កណ្តាល បេះដូង នៃ ពាណិជ្ជកម្ម និង វប្បធម៌ នៃ រាជធានី ភ្នំពេញ តាម បណ្ដោយ ផ្លូវ ១៧៨ ជិត សារមន្ទីរ ជាតិ ខណ្ឌ ដូនពេញ ។
