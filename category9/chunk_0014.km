( ព្រះវិហារ ) ៖ នៅ ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ ក្នុង បរិវេណ វត្ត សំពៅ កែវ ហៅ វត្ត ពើក ភូមិ ពើក ឃុំ ពុទ្រា ស្រុក ជ័យ សែន ខេត្ត ព្រះវិហារ បាន រៀបចំ វេទិការ សាធារណៈ របស់ ក្រុមការងារ ថ្នាក់ ជាតិ ដើម្បី ជួប ជាមួយ ប្រជាពលរដ្ឋ និង ស្តាប់ នូវ បញ្ហា ប្រឈម សំណូមពរ និង បញ្ហា នានា របស់ ប្រជាពលរដ្ឋ ។
ពិធី នេះ ស្ថិត ក្រោម អធិបតី លោក មាស សុភា ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកម្ម ពិសេស និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ព្រះវិហារ និង មាន ការអញ្ជើញ ចូលរួម ពី លោក ឡុង សុវណ្ណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រមទាំង សមាជិក ក្រុមការងារ ថ្នាក់ ជាតិ អភិបាល រង ខេត្ត សមាជិក ក្រុមប្រឹក្សា ខេត្ត ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
បន្ថែម ពី នេះ ទៅ ទៀត លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន សំណូមពរ ឲ្យ ប្រជាពលរដ្ឋ ត្រូវ ចូលរួម ជា មតិ យោបល់ និង លើកឡើង បញ្ហា ប្រឈម សំណូមពរ ដែល ជា ក្ដីកង្វល់ និង តម្រូវ ការចាំបាច់ ដើម្បីឲ្យ គណៈអធិបតី ឡើង បកស្រាយ ចម្ងល់ នានា ក៏ ដូចជា ស្វែងរក ដំណោះស្រាយ ទាំងអស់ គ្នា ។
ក្នុង ឱកាស ដ៏ មាន សារសំខាន់ ជូន បងប្អូន ប្រជាពលរដ្ឋ បាន ទាន់ ពេលវេលា ឆ្លើយតប ទៅនឹង សំណូមពរ ចាំបាច់ នានា ក្នុង មូលដ្ឋាន ជាពិសេស គឺ ដើម្បីឲ្យ ការអនុវត្តន៍ គោល នយោបាយ ក្នុង ការ អភិវឌ្ឍ ភូមិ - ឃុំ និង គោល នយោបាយ យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់ការ ទី៤ និង កម្មវិធី កំណែទម្រង់ វិម ជ្ឍការ និង វិសហម ជ្ឍការ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា មាន ប្រសិទ្ធភាព ខ្ពស់ ។
ឆ្លើយតប និង សំណូមពរ របស់ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ឱកាស នោះ ដែរ លោក ទេសរដ្ឋមន្ត្រី មាស សុភា បាន ដោះស្រាយ ជូន ភ្លាម ៗ និង បញ្ហា មួយចំនួន ទៀត គឺ ត្រូវ ដោះស្រាយ នៅ ពេល ក្រោយ ផងដែរ ៕
( ម៉ានីល) ៖ អាជ្ញាធរ ហ្វីលីពីន ឥណ្ឌា និង ហ្វាំងឡង់ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បាន ទទួលស្គាល់ ដូចគ្នា ពី ករណី ឆ្លង វីរុស កូរ៉ូណា ជា លើក ដំបូង នៅក្នុង ប្រទេស របស់ ពួកគេ ខណៈ ចំនួន អ្នក សា្លប់ ដោយសារ វីរុស នេះ នៅក្នុង ប្រទេស ចិន បាន កើន ដល់ ១៧០ នាក់ ហើយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី៣០ ខែមករា ឆ្នាំ ២០២០ ។
សម្រាប់ កម្ពុជា វិញ តើ មាន ត្រៀមលក្ខណៈ សម្បត្តិ ចូលរួម ជួយ ដោះស្រាយ ការលំបាក របស់ ចិន នេះ ដែរ ឬ ទេ ? ឆ្លើយតប សំណួរ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ក្នុង សេចក្តីថ្លែង សារ ពី បញ្ហា ជំងឺ ផ្លូវ ដង្ហើម កូរ៉ូណា នា ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ បាន ថ្លែង ថា កម្ពុជា នឹង ពិនិត្យមើល ថា តើ អាច ធ្វើ អ្វី បាន ខ្លះ ដើម្បី ជួយ ដល់ បញ្ហា របស់ ចិន ។
ទន្ទឹមនឹង ការពិនិត្យ លទ្ធភាព ដើម្បី ជួយ ដោះស្រាយ បញ្ហា របស់ ចិន នេះ ការ ដែល មិន បិទ ជើងហោះហើរ ជាមួយ ចិន ការ មិន បិទ ការដឹកជញ្ជូន ផ្លូវ ទឹក ជាមួយ ចិន ការគ្រប់គ្រង ពលរដ្ឋ ចិន នៅ កម្ពុជា កុំ ឱ្យ រង ការវាយប្រហារ ដោយ ជំងឺ ផ្លូវ ដង្ហើម គឺជា ការចូលរួមចំណែក ជួយ ដល់ ការលំបាក របស់ ចិន ផងដែរ ។ នេះ ជា ការបញ្ជាក់ របស់ សម្តេច តេជោ ហ៊ុន សែន ។
បន្ថែម ពីលើ នេះ ការជួយ ព្យាបាល ពលរដ្ឋ ចិន កំពុង មាន ជំងឺ ផ្លូវ ដង្ហើម នៅ កម្ពុជា ការ មិន រើសអើង ចំពោះ ជនជាតិ ចិន ក៏ ដូចជា ការ មិន ជម្លៀស អ្នកការទូត និង និស្សិត ខ្មែរ ចេញពី ចិន ក៏ ជា ការជួយ ដោះស្រាយ ការលំបាក របស់ ចិន នា ពេលនេះ ផងដែរ ។
សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ថ្លែង បញ្ជាក់ យ៉ាង ដូច្នេះ « ជាក់ស្តែង យើង ជួយ ព្យាបាល ប្រជាជន ចិន ដែល កំពុង នៅ ស្រុក យើង ឱ្យ ជាសះស្បើយ ក៏ ជា ផ្នែក មួយ ចូលរួម ចំណែក ទៅដល់ ប្រជាជន ផងដែរ ។ យើង ខិតខំ ការពារ ប្រជាជន ចិន ដែល កំពុង នៅ ស្រុក យើង កុំ ឱ្យ ឆ្លង រាលដាល ក៏ ជា ផ្នែក មួយ នៃ ការចូលរួម របស់ យើង » ។
រដ្ឋាភិបាល ចិន បាន ដាក់ចេញ នូវ វិធានការបន្ទាន់ ជាច្រើន ដើម្បី ដោះស្រាយ ការវាយប្រហារ ដោយ ជំងឺ ផ្លូវ ដង្ហើម កូរ៉ូណា នេះ ។ ក្នុង នោះ គណៈ រដ្ឋមន្ត្រី ចិន ដឹកនាំ ដោយ លោក ប្រធានាធិបតី ស៊ី ជីន ពីង និង លោក នាយក រដ្ឋមន្ត្រី លី ខឺ ឈាង បាន បើក កិច្ចប្រជុំ រក ដំណោះស្រាយ រួមគ្នា ហើយ លោក លី ខឺ ឈាង បាន ចុះ ទៅដល់ តំបន់ វាយប្រហារ ដោយ ជំងឺ នេះ ថែម ទៀត ផង ដើម្បី ដាក់ ចេញ វិធានការ ក្នុង ការដោះស្រាយ ។
សម្តេច តេជោ ហ៊ុន សែន បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការទទួលខុសត្រូវ ខ្ពស់ របស់ រដ្ឋាភិបាល ចិន ៕
ក្រុមហ៊ុន មេនូឡាយ ហ្វ៍ និង ធនាគារ ស្ថាបនា សហការ គ្នា ដើម្បី ផ្តល់ ជូន អតិថិជន នូវ ជម្រើស ក្នុង ការបង់ បុព្វលាភ រ៉ាប់រង តាម ទូរស័ព្ទ
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន មេនូឡាយ ហ្វ៍ ខេមបូឌា ដែល ជា ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត អន្តរជាតិ ដំបូង បំផុត នៅក្នុង កម្ពុជា និង ធនាគារ ស្ថាបនា ដែល ជា ធនាគារ ឈាន មុខ គេ មួយ នៅ ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន ប្រកាស ជា ផ្លូវការ ពី ភាព ជាដៃគូ ក្នុង ការបង់ បុព្វលាភ រ៉ាប់រង តាម ទូរស័ព្ទ ដែល អនុញ្ញាតឱ្យ អតិថិជន របស់ ក្រុមហ៊ុន មេនូឡាយ ហ្វ៍ បង់ បុព្វលាភ រ៉ាប់រង របស់ ពួកគាត់ គ្រប់ ពេល ដោយ ឥត គិត ថ្លៃ តាមរយៈ កម្មវិធី ទូរស័ព្ទ Sathapana Mobile ។
ក្រុមហ៊ុន មេនូឡាយ ហ្វ៍ និង ធនាគារ ស្ថាបនា បាន ចាប់ ជា ដៃគូ ក្នុង ការចែកចាយ ផលិតផល ធានារ៉ាប់រង អាយុជីវិត កាលពី ឆ្នាំ ២០១៨ ហើយ កិច្ចសហការ ដែល ប្រកាស ថ្ងៃ នេះ នឹង អនុញ្ញាតឱ្យ អតិថិជន ធ្វើ ការទូទាត់ បុព្វលាភ រ៉ាប់ រង បាន កាន់តែ ឆាប់រហ័ស ងាយស្រួល និង មាន សុវត្ថិភាព ដោយ ធ្វើ តាម ជំហាន ងាយ ៗ ដូច ខាងក្រោម៖
វិធានការ សម្តេច តេជោ ហ៊ុន សែន រួម មាន ដូច ជា៖
១៖ កុំ មាន ការភ័យខ្លាច ហួស ពី អ្វី ដែល ជា ការពិត ដែល នាំឱ្យ យើង ខាតបង់ ពេល វេលា ។ យើង អាច បញ្ចៀស បាន នូវ ការឆ្លង មេរោគ គ្រប់ ប្រភេទ តាមរយៈ អនាម័យ ទាំង ការរស់នៅ ការទទួលទាន ការធ្វើ ការងារ ។ សម្តេច ចាត់ទុក ថា អនាម័យ នេះ ការពារ ជំងឺ ច្រើន ជាពិសេស ផ្តាសាយ មិន មែន តែ វីរុស កូរ៉ូណា ទេ ។
២៖ ត្រូវ ផ្សព្វផ្សាយ ព័ត៌មាន ពិត ជូន ប្រជាពលរដ្ឋ ។ សម្តេច កោតសរសើរ ចំពោះ សារព័ត៌មាន មាន វិជ្ជាជីវៈ មាន ការទទួលខុសត្រូវ អ្នកលេង បណ្តាញ សង្គម ដែល មាន ការទទួលខុសត្រូវ ដែល ជួយ ផ្សព្វផ្សាយ ព័ត៌មាន ពិត ប្រឆាំង ព័ត៌មាន ក្លែងក្លាយ ដែល បំពុល សង្គម ។ សម្តេច បាន បង្គាប់ ឱ្យ ក្រសួង ព័ត៌មាន ចាត់ វិធានការ ចំពោះ ព័ត៌មាន ក្លែងក្លាយ ។ សម្តេច បាន ព្រមាន ថា ទោះបីជា ខ្មែរ មិន ទាន់ មាន ការចាប់ អ្នកសារព័ត៌មាន បំពុល រឿង វីរុស កូរ៉ូណា តែ បើ នៅ មិន រាងចាល អាចនឹង ចាប់ខ្លួន ។
៣៖ ត្រូវ មាន ដំណើរការធម្មតា នៅ ស្ថាប័ន រដ្ឋ ក្រុមហ៊ុន ឯកជន រោងចក្រ សហគ្រាស ផ្សារ លក់ដូរ វត្ត អារ៉ាម … ។
៤៖ សាលារៀន គឺជា គោលដៅ ដែល ត្រូវ យកចិត្តទុកដាក់ ត្រូវ ធ្វើឱ្យ មាន ទំនុកចិត្ត ដល់ អាណាព្យាបាល មាតាបិតា បញ្ជូន កូន មក រៀន ធម្មតា ។ ត្រូវ ដំណើរ ការធម្មតា ដោយ បង្កើន អនាម័យ ហើយ ក្រសួង អប់រំ ត្រូវ ចុះ អប់រំ តាម សាលា ។
៥៖ ត្រូវ មាន ម៉ាស់ ការពារ នៅ កន្លែង ចាំបាច់ ប៉ុន្តែ កន្លែង ដែល មិន ចាំបាច់ មិន មាន អ្វី ត្រូវ ពាក់ នោះ ទេ ។ នៅ តាម ព្រលានយន្តហោះ មាន តែ អាស៊ី ទេ ដែល ពាក់ ម៉ាស់ រីឯ អ្នកទេសចរ អឺរ៉ុប មិន មាន ពាក់ ម៉ាស់ ទេ ដោយសារ គេ យល់ដឹង ច្បាស់ ពី របៀប ឆ្លង ។
៧៖ ត្រូវ ផ្តល់ សេវាកម្ម ដោយ គ្មាន ការរើសអើង ដូចជា ការដឹកនាំ តាម ផ្លូវគោក ផ្លូវ ទឹក និង ផ្លូវ អាកាស ទាក់ទង នឹង យន្តហោះ និង តាម សណ្ឋាគារ ជាដើម ដូច្នេះ អ្នក ថា ឲ្យ បិទ ជើង យន្តហោះ បើ បិទ គឺ មិន មែន បិទ តែពី ចិន ទេ គឺ ត្រូវ បិទ ប្រទេស ទាំងអស់ ដោយសារតែ ជំងឺ នេះ កើតឡើង ច្រើន ប្រទេស ហើយ ជប៉ុន ម៉ាឡេស៊ី ថៃ សិង្ហបុរី វៀតណាម ក៏ មាន … អញ្ចឹង ត្រូវ បិទ ទាំងអស់ ដោយ ដាក់ កម្ពុជា ខ្លួន ឯង នៅក្នុង ភាពឯកោ ដែរ ។
៨៖ អ្នកការទូត កុងស៊ុល និង និស្សិត កម្ពុជា ដែល កំពុង ធ្វើ ការ និង រៀនសូត្រ នៅ ប្រទេស ចិន ពិសេស នៅ ទីក្រុង វូហាន ត្រូវ បន្ត ចូលរួម ជាមួយ ប្រជាជន ចិន នៅ ទីនោះ កុំ រត់ ចោល គេ ។ ស្រឡាញ់ គ្នា ក្នុង គ្នា ក្រ កុំ មិត្តភាព ក្នុង គ្រា ស្រួល តែ រត់ ចោល គ្នា ក្នុង គ្រា លំបាក ។
លោក កែវ រតនៈ ដឹកនាំ ប្រតិភូ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ទៅ ប្រគល់ ជូន បងប្អូន កងទ័ព និង នគរបាល ការពារ ព្រំដែន នៅ ប្រចាំ ទិស ប្រាសាទ តា មាន់
ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ ផងដែរ ។
លោក កែវ រតនៈ បាន បញ្ជាក់ ឲ្យដឹង ថា នៅ រៀងរាល់ ២ ខែម្តង ក្រុមហ៊ុន ទាំង ពីរ គឺ អគ្គិសនី កម្ពុជា និង ក្រុមហ៊ុន LYP Group ដែល មាន ចំណង មេត្រីភាព ជាមួយ អង្គភាព កងពល តូច ថ្មើរជើង លេខ ៤២ និង វរសេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៧០២ ប្រចាំ ទិស ប្រាសាទ តា មាន់ តែងតែ ចុះ សាកសួរ សុខទុក្ខ និង នាំយក អំណាយ ទៅ ប្រគល់ ជូន បងប្អូន កងទ័ព ដែល កំពុង ឈរ ការពារ ខ្សែ បន្ទាប់ ព្រំដែន ដោយ មិន ដែល កាត់ផ្តាច់ ពី គ្នា បាន ឡើយ រវាង សមរភូមិ មុខ និង សមរភូមិ ក្រោយ ។
លោក កែវ រតនៈ បាន បន្ត ថា កត្តា សំខាន់ បំផុត មិន អាច ខ្វះ បាន ដើម្បី ធានា ដល់ ភាពរុងរឿង ថ្កុំថ្កើង របស់ ប្រទេសជាតិ និង វិបុលភាព សុខសាន្ត របស់ ប្រជាជន នា ពេល បច្ចុប្បន្ន នេះ ក៏ ដូចជា ទៅ ថ្ងៃ អនាគត គឺ មាន តែ សុខ សន្តិភាព និង ស្ថិរភាព របៀបរៀបរយ ជា បុព្វហេតុ ដើម្បី ធានា ឲ្យ ប្រទេស កម្ពុជា បន្ត អភិវឌ្ឍន៍ ទៅ មុខ ប្រកបដោយ ចីរភាព ។ ដូច្នេះ លោក បាន អំពាវនាវ ដល់ កងទ័ព នគរបាល និង គ្រួសារ កងទ័ព ទាំងអស់ សូម បន្ត ចូលរួម ថែរក្សា សន្តិភាព ការពារ សន្តិភាព ស្រឡាញ់ សន្តិភាព ឲ្យបាន គង់វង្ស ។
លោក កែវ រតនៈ ក៏ បាន វាយតម្លៃ ខ្ពស់ ថា កងទ័ព កម្ពុជា និង កងកម្លាំង នគរបាល ពិតជា មាន ទឹកចិត្ត មោះ មុខ ការពារ ទឹកដី និង រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច ហ៊ុន សែន ជា ប្រមុខ ដ៏ ឈ្លាសវៃ និង អង់អាច ក្លាហាន ៕
សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា អំពាវនាវ គ្រូពេទ្យ ឯកជន ទាំងអស់ ចូលរួម អប់រំ ពលរដ្ឋ ពី អនាម័យ ខ្លួនប្រាណ ឱ្យ បាន ជាប់ ជាប្រចាំ
( ភ្នំពេញ ) ៖ សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា ( ស.ស .ឯ .ក ) បាន ចេញ សេចក្តី អំពាវនាវ អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា ទាំងអស់ ត្រូវ ចូលរួម សហការ ក្នុង ការអប់រំ ប្រជាពលរដ្ឋ អំពី ការធ្វើ អនាម័យ ខ្លួនប្រាណ ដោយ លាង ដៃ នឹង ទឹក ស្អាត ជាមួយ សាប៊ូ ឬ អាល់កុល ឲ្យ បាន ញឹកញាប់ ជាប់ ជាប្រចាំ តាម គោលការណ៍ ណែនាំ របស់ ក្រសួង សុខាភិបាល ។
សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា សូម ចូលរួម ជាមួយ ក្រសួង សុខាភិបាល ដោយ អំពាវនាវ ដូច ខាងក្រោម៖
* ទី២ ៖ ចំពោះ ប្រជាពលរដ្ឋ ទូទៅ ត្រូវ ចូលរួម តាមដាន សេចក្តីប្រកាស ព័ត៌មាន ឬ សេចក្តីជូនដំណឹង របស់ ក្រសួង សុខាភិបាល ចៀសវាង ការជឿ ឬ ផ្សព្វផ្សាយ បន្ត តាម ព័ត៌មាន មិន ពិត និង គ្មាន ប្រភព ច្បាស់លាស់ ដែល ជា ហេតុ ធ្វើឲ្យ មាន ចលាច ល និង វឹកវរ នៅក្នុង សង្គម . អនុវត្ត វិធានការណ៍ ការពារ ខ្លួន តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ( ដូច មាន ជូន ភ្ជាប់ មក ជាមួយ នូវ វិធានការ ការពា របស់ ក្រសួង សុខាភិបាល )៕
ខាងក្រោម នេះ ជា សេចក្តី អំពាវនាវ របស់ សមាគម អ្នក ផ្តល់ សេវា សុខាបាល ឯកជន នៅ កម្ពុជា៖ ឱកាស បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ដើម្បី ការងារ និង មុខរបរ នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស
( ភ្នំពេញ ) ៖ កសាង សមត្ថភាព វិជ្ជាជីវៈ និង សហគ្រិន ភាព នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស ដែល មាន វ័យ ចំណាស់ បទពិសោធន៍ បណ្តុះបណ្តាល ជាង ២១ ឆ្នាំ ល្បី ឈាន មុខ គេ លើ គុណភាព ការងារ និង មុខរបរ និស្សិត ចេះ ភាសារ អង់គ្លេស កុំព្យូទ័រ និង ជំនាញ ឯកទេស ក្នុង ពេល តែ មួយ ។
សាកលវិទ្យាល័យ ធនធាន មនុស្ស មាន អគារ សិក្សា ផ្ទាល់ខ្លួន ធំ ទូលាយ កណ្តាល រាជធានី ភ្នំពេញ សម្ភារ រូបវន្ត ទំនើប សាស្រ្តាចារ្យ មាន សមត្ថភាព វិជ្ជាជីវៈ ខ្ពស់ មាន ដៃគូ ផ្តល់ ការងារ និង ដៃគូ អន្តរជាតិ ជាច្រើន ។ សិក្សា នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស ដើម្បី ទទួលបាន នូវ ឧត្តមភាព សមត្ថភាព ជំនាញ និង ឱកាស ការងារ ជាង ៩០ ភាគរយ ។
ចុះឈ្មោះ ចូលរៀន ចាប់ពី ថ្ងៃ នេះ តទៅ នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស ខាងត្បូង វត្ត មហា មន្ត្រី ។
ការបញ្ជាក់ បែប នេះ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ថ្លែង សារ ទៅកាន់ ប្រជាពលរដ្ឋ ពាក់ព័ន្ធ ជំងឺ រលាក ផ្លូវ ដង្ហើម ដោយ វីរូស « កូរ៉ូណា » នៅក្នុង ប្រទេស កម្ពុជា នៅ វិមាន សន្តិភាព ។
សម្តេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា៖ « កុំ មាន ការភ័យខ្លាច ហួស ពី អ្វី ដែល ជា រឿង ពិត ដែល ធ្វើឱ្យ យើង ខាតបង់ ពេលវេលា បំពេញ ការការ យើង អាច បញ្ចៀស បាន នូវ ការឆ្លង មេរោគ គ្រប់ ប្រភេទ តាមរយៈ អនាម័យ ការរស់នៅ ការទទួលទាន ការធ្វើដំណើរ និង ការធ្វើ ការងារ ។ល។ មនុស្ស ម្នាក់ ៗ គ្រួសារ នីមួយ ត្រូវ ចេះ ការពារ ខ្លួន ដោយ ខ្លួន ឯង ខ្ញុំ និយាយ ថា ការពារ ជំងឺ គ្រប់ ប្រភេទ មិន មែន គ្រាន់តែ អាកូរ៉ូណា នោះ ទេ ជំងឺ គ្រប់ ប្រភេទ បើ យើង អត់ មាន អនាម័យ ទេ ជំងឺ អី ក៏ វា ឆ្លង ដែល » ។
ទោះជា យ៉ាង នេះ ក្តី រហូតដល់ មកដល់ ពេលនេះ ស្ថានភាព ជនជាតិ ចិន ដែល ផ្ទុក ជំងឺ ផ្លូវ ដង្ហើម ថ្មី ហើយ ដាក់ ឱ្យ សម្រាក នៅ បន្ទប់ ដាច់ដោយឡែក នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រះសីហនុ នោះ កំពុង មាន សុខភាព ល្អ ធម្មតា និង កាន់តែ ប្រសើរ ជាង មុន ដោយ មិន មាន អ្វី ធ្ងន់ធ្ងរ គួរឱ្យ កត់សម្គាល់ នោះ ឡើយ ខណៈ ដែល ក្រុមគ្រួសារ របស់ គាត់ ទាំង ៣នាក់ ពុំ មាន រោគសញ្ញា នៃ មេរោគ កូរ៉ូណា នោះ ទេ ៕
បើ តាម សេចក្តីជូនដំណឹង ដដែល បាន ឱ្យដឹង ថា វគ្គ បណ្តុះបណ្តាល នេះ នឹង បង្ហាត់ បង្រៀន ដោយ សាស្ត្រាចារ្យ និង អ្នកឯកទេស ចំនួន ០៧ រូប ហើយ បើក ទូលាយ ការចុះឈ្មោះ ចូលរៀន ជូន ដល់ និស្សិត បុគ្គលិក ក្រុមហ៊ុន មន្ត្រីរាជការ សារព័ត៌មាន មហាជន និង អ្នកសារព័ត៌មាន ដែល មាន បំណង បំប៉ន ចំណេះដឹង បន្ថែម ។ វិញ្ញាបនបត្រ បញ្ជាក់ ការសិក្សា នឹង ប្រគល់ ជូន សិក្ខាកាម ក្រោយពេល បញ្ចប់ វគ្គ សិក្សា ។
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ សហភាព សហព័ន្ធ អ្នកសារព័ត៌មាន កម្ពុជា៖ កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពត បូកសរុប លទ្ធផល ការងារ និង លើក ទិសដៅ អនុវត្ត បន្ត
( កំពត) ៖ នៅ ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នៅ សាល ប្រជុំ សាលា ខេត្ត បាន បើក កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ ឆ្នាំ ២០១៩ និង លើក ទិសដៅ សម្រាប់ អនុវត្ត ឆ្នាំ ២០២០ របស់ គណៈកម្មាធិការ កាកបាទ ក្រហម កម្ពុជា សាខា ខេត្ត កំពត ។
កិច្ចប្រជុំ នេះ ក្រោម អធិបតីភាព លោក ជា វ តាយ អភិបាល ខេត្ត និង ជា ប្រធាន គណៈកម្មាធិការ កាកបាទ ក្រហម កម្ពុជា សាខា ខេត្ត កំពត ដោយ មាន ការចូលរួម ពី អនុប្រធាន អចិន្ត្រៃយ៍ លាង ហៃ ជាវ តាយ និង សមាជិក សមាជិកា គណៈកម្មាធិការ សាខា ប្រធាន កិត្តិយស ប្រធាន គណៈកម្មាធិការ អនុសាខា ក្រុង - ស្រុក ព្រមទាំង មន្ត្រី ប្រតិបត្តិ សាខា ប្រមាណ ជាង ៤០ រូប ។
ក្នុង កិច្ចប្រជុំ បូកសរុប នេះ លោក ជា វ តាយ បាន ថ្លែង ថា ក្នុង នាម គណៈកម្មាធិការ កាកបាទ ក្រហម កម្ពុជា សាខា ខេត្ត កំពត លោក សូម កោតសរសើរ ដោយ ស្មោះ ចំពោះ សមាជិក សមាជិកា សាខា កាកបាទ ក្រហម ខេត្ត និង អនុសាខា ក្រុង - ស្រុក ទាំងអស់ ដែល បាន បំពេញ ការងារ រហូត ទទួលបាន លទ្ធផល ជា វិជ្ជមាន នា ពេល កន្លងមក ពិសេស ផ្នែក ការងារ មនុស្សធម៌ ។
ព្រម ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត ក៏ បាន ក្រើន រំលឹក ផងដែរ ថា ដើម្បីឱ្យ សាខា កាកបាទ ក្រហម ខេត្ត ទទួលបាន នូវ លទ្ធផល ល្អ ប្រសើរ បន្ថែម ទៀត នោះ គឺ សមាជិក សមាជិកា ទាំងអស់ ត្រូវ ចូលរួមចំណែក ក្នុង ការពន្លឿន និង ការកាត់បន្ថយ ភាពក្រីក្រ ការពារ សេចក្តីថ្លៃថ្នូរ របស់ មនុស្សជាតិ ព្រមទាំង ការពារ តម្លៃ មនុស្សធម៌ របស់ ជនរងគ្រោះ ៕ នគរបាល ខេត្ត សៀមរាប បន្ត នាំ ខ្លួនអ្នកលេង Facebook ម្នាក់ ទៀត មក សួរ នាំ ក្រោយ បង្ហោះ ព័ត៌មាន មិន ពិត ពាក់ព័ន្ធ វីរុស « កូរ៉ូណា »
លោក ឧត្តមសេនីយ៍ ត្រី ហួត សុធី បាន បញ្ជាក់ ថា ក្រៅពី ស្ត្រី ម្នាក់ ខាងលើ នេះ កម្លាំង ផែនការងារ សន្តិសុខ បាន ឃាត់ខ្លួនអ្នក ផ្សេង ចំនួន ទាំង ២នាក់ ដែល បាន ចែកចាយ ព័ត៌មាន ប្រឌិត ពាក់ព័ន្ធ នឹង ការរក ឃើញ មាន ជំងឺ រលាក សួត « កូរ៉ូណា » ក្នុង ខេត្ត សៀមរាប នេះ មាន ឈ្មោះ ម៉ែន ចាន់ នឿន ភេទ ប្រុស អាយុ ៣៤ ឆ្នាំ និង ឈ្មោះ អ៊ឹង ជិង សេរី រតនៈ ភេទ ស្រី អាយុ ២០ ឆ្នាំ ដែល ពួកគេ ជា បុគ្គលិក ក្រុមហ៊ុន ទេសចរណ៍ ពួកគេ ក៏ បាន មក សារភាព កំហុស ចំពោះមុខ សមត្ថកិច្ច កាលពី ថ្ងៃទី ២៨ ខែមករា ឆ្នាំ ២០២០ កន្លងទៅ ដែរ ។
លោក ឧត្តមសេនីយ៍ ត្រី បាន បញ្ជាក់ ទៀត ថា ពួកគេ ទាំង ៣នាក់ បាន សន្យា នៅ ចំពោះមុខ សមត្ថកិច្ច ថា នឹង មិន បន្ត ផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ដែល បណ្តាលឲ្យ មាន ការចលាចល ដល់ ប្រជាជន ក្នុង ខេត្ត សៀមរាប និង ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ទៀត ឡើយ ។ ក្រោយ ធ្វើ កិច្ចសន្យា រួច អ្នក ទាំង ៣នាក់ ត្រូវបាន អនុញ្ញាតឲ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ។
លោក ស្នងការរង ក៏ បាន សំណូម និង អំពាវនាវ បងប្អូន ប្រជាពលរដ្ឋ ទាំង ត្រូវ ប្រើប្រាស់ បណ្ដាញ សង្គម ឲ្យបាន ត្រឹមត្រូវ មិន ត្រូវ បង្ហោះ ឬ ចែកចាយ (share) ព័ត៌មាន មិន ពិត ឬ ប្រឌិត ដែល មិន មាន ប្រភព ច្បាស់លាស់ ធ្វើឲ្យ ប៉ះពាល់ សន្តិសុខ សណ្តាប់ធ្នាប់ សង្គម ដែល នាំឲ្យ ជា អំពើ ខុស ច្បាប់ មាន ទោស ៕
ក្នុង សន្និសីទ សារព័ត៌មាន ស្ដីពី ជំងឺ រលាក ផ្លូវ ដង្ហើម ថ្មី ដែល បង្ក ដោយ វីរុស កូរ៉ូណា សម្ដេច តេជោ ហ៊ុន សែន បាន អះអាង ថា នៅ ពេល នេះ រាជ រដ្ឋាភិបាល មាន ថវិកា គ្រប់គ្រាន់ នៅក្នុង ដៃ ដើម្បី ចំណាយ លើ ការងារ នេះ ដោយ មិន ទុកឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ ខ្វះ ការទទួលខុសត្រូវ នោះ ទេ ប៉ុន្ដែ នៅ ពេល នេះ មិន ទាន់ ដល់ ដែល រាជ រដ្ឋាភិបាល ត្រូវ ចំណាយ លុយ នោះ ទេ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន សង្កត់ធ្ងន់ ថា វិធានការ ចំពោះ មុខ នៅ ពេល នេះ ថវិកា របស់ ក្រសួង សុខាភិបាល មាន គ្រប់គ្រាន់ ណាស់ ទៅ ហើយ សម្រាប់ ចំណាយ ដើម្បី ទប់ស្កាត់ ការឆ្លង ជំងឺ ដែល បង្ក ដោយ វីរុស កូរ៉ូ ណា ។
ទន្ទឹម គ្នា នេះ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន គូសបញ្ជាក់ ថា ក្រសួង សុខាភិបាល នៅតែ ជា អ្នកនាំមុខ ដើម្បី ដោះស្រាយ បញ្ហា នេះ ដោយ មាន កិច្ចសហការ ទៅ តាម វិស័យ ដែល មាន ការទទួលខុសត្រូវ ពី ស្ថាប័ន ផ្សេង ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង៖ ការអនុវត្ត ថវិការ របស់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ជា ស្នូល នៃ កំណែទម្រង់ ការគ្រប់គ្រង់ ហិរញ្ញវត្ថុ សាធារណៈ
ការថ្លែង លើកឡើង របស់ លោក សុខ រស់ អភិបាល រង ខេត្ត ស្វាយរៀង បែប នេះ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ ក្នុង កិច្ចប្រជុំ ប្រជុំ ផ្សព្វផ្សាយ សារាចរ ណែនាំ លេខ ០០៩សហវ ចុះ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០១៩ស្តីពី ការអនុវត្ត ច្បាប់ ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០២០ របស់ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ។
ពិធី នេះ មាន ការចូលរួម ពី លោក ជូ សុធី ប្រធាន មន្ទីរ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ខេត្ត និង លោក លោកស្រី ជា អភិបាល ក្រុង ស្រុក និង ស្មៀន ឃុំ សង្កាត់ ទូទាំង ខេត្ត ផងដែរ ។
លោក សុខ រស់ បាន បន្ត ថា ការផ្សព្វផ្សាយ សារាចរ ណែនាំ នៅ ពេល នេះ គឺ ស្ថិត ក្នុង ដំណាក់កាល មួយ ដ៏ មាន សារៈសំខាន់ បំផុត សម្រាប់ បញ្ជ្រាប ជំរុញ និង ពង្រីក ការអនុវត្ត សកម្ម កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ឲ្យ ដល់ បណ្តា រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ទាំងអស់ ដែល បោះ ទីតាំង នៅ មូលដ្ឋាន និង ជា ខ្សែ បណ្តោយ ថ្នាក់ ជាតិ ។
ថ្លែង ក្នុង សន្និសីទ សារព័ត៌មាន នៅ ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន បន្ថែម ថា ទោះបី បច្ចុប្បន្ន គេ គ្មាន ថ្នាំ សម្រាប់ ព្យាបាល ជំងឺ ដែល បង្កឡើង ដោយ វីរ៉ុស កូរ៉ូណា ប៉ុន្តែ គេ មាន តែ វិធី ការពារ និង ទប់ស្កាត់ ។
ទោះជា យ៉ាង នេះ ក្តី រហូតដល់ មកដល់ ពេលនេះ ស្ថានភាព ជនជាតិ ចិន ដែល ផ្ទុក ជំងឺ ផ្លូវ ដង្ហើម ថ្មី ហើយ ដាក់ ឱ្យ សម្រាក នៅ បន្ទប់ ដាច់ដោយឡែក នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រះសីហនុ នោះ កំពុង មាន សុខភាព ល្អ ធម្មតា និង កាន់តែ ប្រសើរ ជាង មុន ដោយ មិន មាន អ្វី ធ្ងន់ធ្ងរ គួរឱ្យ កត់សម្គាល់ នោះ ឡើយ ខណៈ ដែល ក្រុមគ្រួសារ របស់ គាត់ ទាំង ៣នាក់ ពុំ មាន រោគសញ្ញា នៃ មេរោគ កូរ៉ូណា នោះ ទេ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ចោទ ជា សំណួរ ថា តើ រហូតមកដល់ ពេលនេះ មាន មនុស្ស ណា ម្នាក់ នៅក្នុង ប្រទេស កម្ពុជា បាន ស្លាប់ ដោយ ជំងឺ រលាក ផ្លូវ ដង្ហើម ថ្មី នៅក្នុង ទឹកដី កម្ពុជា ហើយ ឬ នៅ ? ចុះ ម្តេច ហេតុ អ្វី បាន មាន ពលរដ្ឋ ខ្មែរ មួយចំនួន មាន សម្ពាធ ផ្លូវ អារម្មណ៍ ខ្លាំង ម្ល៉េះ ? ដូច្នេះ ជំងឺ ពិតប្រាកដ គឺជា ជំងឺ ភ័យខ្លាច ហួសហេតុ ដែល ហួស ពី ការពិត បន្ថែម ដោយ ការបំពុល ព័ត៌មាន ដែល ខ្វះ ការទទួលខុសត្រូវ ដែល ជា ប្រភេទ នៃ ការបំពុល សង្គម ។
សម្តេច តេជោ ហ៊ុន សែន បញ្ជាក់ ថា ជំងឺ បែប នេះ មិន មែន ជា ជំងឺ ថ្មី នៅក្នុង តំបន់ និង ពិភពលោក ទេ ។ សម្តេច តេជោ ហ៊ុន សែន បាន ពន្យល់ ដល់ ប្រជាពលរដ្ឋ កុំ ឱ្យ ធ្លាក់ ក្នុង សង្រ្គាម ចិត្តសាស្រ្ត ដែល នាំ រហូតដល់ បាត់បង់ ជំនឿចិត្ត លើ ខ្លួន ឯង និង ប្រទេស ខ្លួន ឯង ក្នុង ការការពារ ខ្លួន នោះ ទេ ។ វិធានការ ល្អ បំផុត គឺ ការពារ ប្រសើរ ជាង ព្យាបាល នោះ ជា វិធីសាស្រ្ត ល្អ បំផុត ៕
សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន អះអាង ទៀត ថា កម្ពុជា ត្រូវ ចូលរួមចំណែក ជាមួយ ចិន ដោយ មិន បិទ ជើងហោះហើរ មិន ជន្លៀស ប្រជាជន កម្ពុជា ពី ចិន មិន បិទ ការនាំចូល ទំនិញ ពី ចិន ការជួយ ព្យាបាល ប្រជាជន ចិន ឲ្យ ជាសះស្បើយ គឺជា សមាន ចិត្ត ដែល យើង មាន ជាមួយ ប្រជាជន ចិន ។ សម្ដេច ថា កម្ពុជា មិន ចាំបាច់ ប្រកាស បិទ ជើងហោះហើរ នោះ ទេ ពោល ចិន បាន បិទ ខ្លួន ឯង រួចទៅហើយ ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « យើង មិន ចាំបាច់ ប្រកាស បិទ ទេ ចិន គេ បិទ ពី ប្រទេស គេ រួចស្រេច ទៅ ហើយ មិន ត្រឹមតែ បិទ ជើងហោះហើរ ពី វូហាន មកកាន់ កម្ពុជា ឬ ទៅកាន់ បរទេស ប្រទេស ដ៏ ទៃ ទេ គេ បិទ ទាំង នៅក្នុង មិន ឲ្យ មាន ការហោះហើរ ពី ទីក្រុង វូហាន ទៅកាន់ ប៉េកាំង ឬ ទីក្រុង ដ៏ទៃ ទៀត នៅក្នុង ប្រទេស ចិន បិទ ទាំង ផ្លូវ ដេក បិទ ទាំង ផ្លូវគោក ដើម្បី ទុកឲ្យ មាន ការ ដោះស្រាយ នៅក្នុង ក្របខ័ណ្ឌ មួយ ក្នុង កម្រិត តូច ជាង កុំ ឲ្យ វា រីករាដាល » ។
ជាមួយគ្នា នេះ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បាន ជម្រាប ជូន ជា ផ្លូវការ អំពី ការសម្រេច មិន ចាំបាច់ បិទ ជើងហោះហើរ តាម អាកាស តាម កប៉ាល់ ទឹក តាម ផ្លូវគោក ពី ចិន មក កម្ពុជា ដោយ មូលហេតុ ថា៖
សម្ដេច តេជោ ហ៊ុន សែន បាន សង្កត់ធ្ងន់ ថា ប្រសិនបើ កម្ពុជា សម្រេច បិទ ជើង យន្តហោះ ឬ តាម ផ្លូវ ទឹក និង ផ្លូវគោក នៅ ពេល នេះ គឺ ស្មើនឹង កម្ពុជា រត់ ចោល មិត្ត ក្នុង គ្រា មាន អាសន្ន រីឯ កម្ពស់ នៃ ទំនាក់ទំនង រវាង ប្រទេស ទាំង ពីរ ក៏ នឹង ធ្លាក់ចុះ វិស័យ វិនិយោគ ពាណិជ្ជកម្ម ទេសចរណ៍ និង សេវាកម្ម ជាច្រើន ទៀត នឹង ត្រូវ ជាប់គាំង ហើយ ចំនួន និស្សិត អាហារូបករណ៍ ទៅ សិក្សា នៅ ប្រទេស ចិន ក៏ នឹង ធ្លាក់ចុះ ផងដែរ ។
គួរ ជម្រាប ថា បន្ទាប់ពី ផ្ទុះ ជំងឺ រលាក ផ្លូវ ដង្ហើម ដែល បង្ក ដោយ វីរុស កូរ៉ូណា ថ្មី ហើយ មាន ការរីករាដាល ទៅ តាម បណ្ដា ប្រទេស ផ្សេង ៗ រួមទាំង កម្ពុជា មួយ ករណី ទៅ លើ ជនជាតិ ចិន នោះ មាន មតិ មហាជន នៅ តាម បណ្ដាញ សង្គម បាន លើកឡើង ដោយ ស្នើ រដ្ឋាភិបាល ផ្អាក ការហោះហើរ ជា បណ្ដោះអាសន្ន ពី ទីក្រុង វូហាន និយាយ ដោយឡែក និង និយាយ ជាមួយ ពី ប្រទេស ចិន ចូលមក កម្ពុជា ព្រោះ ខ្លាច ឆ្លង ជំងឺ នេះ ។
( ភ្នំពេញ ) ៖ សវនាការ លើក ទី៩ លើ សំណុំរឿង « សន្ទិដ្ឋិភាព ជាមួយ បរទេស » របស់ លោក កឹម សុខា អតីត ប្រធាន គណបក្ស សង្គ្រោះ ជាតិ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ ត្រូវបាន បញ្ចប់ នៅ វេលា ម៉ោង ប្រមាណ ១២ ថ្ងៃត្រង់ ។
លោក គី តិច មេធាវី របស់ រាជ រដ្ឋាភិបាល និង ជាដើម បណ្ដឹង រដ្ឋប្បវេណី បាន ផ្ដល់ ធ្វើ សន្និសីទ សារព័ត៌មាន ក្រោយ បញ្ចប់ សវនាការ នេះ ជូន ក្រុម អ្នកសារព័ត៌មាន ដើម្បី ដឹង អំពី ដំណើរការ នីតិវិធី មួយចំនួន នៅក្នុង សវនាការ នា ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ ។
ទស្សនា វីដេអូ ទាំងស្រុង នៃ សន្និសីទ សារព័ត៌មាន របស់ មេធាវី គី តិច ក្រោយ បញ្ចប់ សវនាការ៖ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន អរគុណ រដ្ឋាភិបាល និង ប្រជាជន ស៊ុយអែត ដែល បាន ផ្តល់ ជំនួយ មនុស្សធម៌ ដល់ ប្រជាជន កម្ពុជា
អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី បាន វាយតម្លៃ ខ្ពស់ និង ថ្លែង អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ស៊ុយអែត ដែល បាន ផ្តល់ ជំនួយ មនុស្សធម៌ ដល់ ប្រជាជន កម្ពុជា ចាប់តាំងពី កម្ពុជា ទើប បាន រំដោះ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ។ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា ចងចាំ ជានិច្ច ចំពោះ ការរួម វិភាគទាន ដ៏ ថ្លៃថ្លា ក្នុង គ្រា ដ៏ លំបាក នោះ ។
លោក ឧប នាយក រដ្ឋមន្ត្រី បាន លើកឡើង ថា រដ្ឋាភិបាល ស៊ុយអែត បាន និង បន្ត ផ្តល់ ហិរញ្ញប្បទាន ឥត សំណង សម្រាប់ អនុវត្ត គម្រោង អភិវឌ្ឍន៍ ជាច្រើន នៅ កម្ពុជា ដោយ ភាគ ច្រើន ផ្តល់ ហិរញ្ញប្បទាន តាមរយៈ អង្គការ សហ ប្រជាជាតិ និង សហភាព អឺរ៉ុប ។ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ប្រកបដោយ ផ្លែផ្កា រវាង ប្រទេស ទាំង ពីរ កម្ពុជា និង ស៊ុយអែត ត្រូវបាន ពង្រឹង និង ពង្រីក ឥត ឈប់ឈរ ហើយ បាន នាំមក នូវ ផលប្រយោជន៍ ទៅ វិញ ទៅមក សម្រាប់ ប្រទេស ទាំង ពីរ ។
ឯក អគ្គ រាជ ទូត ស៊ុយអែត បាន លើកឡើង ថា បច្ចុប្បន្ន ទំហំ វិនិយោគ ដោយ វិនិយោគិន ស៊ុយអែត នៅ កម្ពុជា នៅ មាន បរិមាណ តិចតួច នៅឡើយ ។ ប៉ុន្តែ ប្រទេស ទាំង ពីរ មាន សក្តានុពល ក្នុង ការជំរុញ កិច្ចសហប្រតិបត្តិការ ពាណិជ្ជកម្ម និង វិនិយោគ តាមរយៈ ការពង្រឹង កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី និង ការបង្កើន កិច្ចសន្ទនា រវាង ភាគី ពាក់ព័ន្ធ នៃ ប្រទេស ទាំង ពីរ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ . ជាថ្មី ម្តង ទៀត អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ស៊ុយអែត ដែល បាន និង បន្ត ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា ហើយ បាន រួមចំណែក យ៉ាង ធំធេង ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម នៅ កម្ពុជា និង បាន ជូន ពរ សូមឲ្យ លោក Björn Häggmark បំពេញ បេសកកម្ម ការ ទូត នៅ កម្ពុជា ប្រកបដោយ ជោគជ័យ ៕
អាជ្ញាធរ ខេត្ត កោះកុង ជំរុញ ឲ្យ មន្ត្រី កសិកម្ម ពង្រឹង វិស័យ ដាំដុះ ទាំង ផ្នែក កសិកម្ម ទាំង ផ្នែក ជល ផល ដើម្បី ប្រជាពលរដ្ឋ
( កោះកុង ) ៖ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន បើក កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ វិស័យ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ប្រចាំ ឆ្នាំ ២០១៩ និង លើក ទិសដៅ អនុវត្ត បន្ត ឆ្នាំ ២០២០ ក្រោម វត្តមាន លោក សុខ សុទ្ធី អភិបាល រង ខេត្ត កោះកុង និង លោក អ៉ី ម៉េង លាង ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ ខេត្ត កោះកុង ។
លោក សុខ សុទ្ធី បាន ថ្លែង ថា មន្ត្រី កសិកម្ម ត្រូវ ពង្រឹង ពង្រីក ផ្នែក វិស័យ កសិកម្ម ទាំង ផ្នែក ដាំដុះ ទាំង ផ្នែក ជល ផល និង ធ្វើ ការដាំ ដើមឈើ បន្ត បន្ថែម សម្ធិផល ទាំងនេះ ហើយ ធ្វើឲ្យ ប្រជាពលរដ្ឋ កាត់បន្ថយ ភាពក្រីក្រ ព្រោះ ប្រទេសជាតិ យើង មាន សន្តិភាព ពេញ ជូន ប្រជាពលរដ្ឋ ។
លោក សុខ សុទ្ធី បាន ថ្លែង បន្ថែម ថា មន្ត្រី កសិកម្ម ទាំងអស់ ត្រូវតែង មាន ការអភិវឌ្ឍ វិស័យ កសិកម្ម ក្នុង ខេត្ត ធ្វើឲ្យ ជីវភាព ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន កាន់តែ មាន ភាពល្អ ប្រសើរឡើង ជាលំដាប់ ដោយ ផ្អែក ទៅ តាម ទិសដៅ ការងារ ប្រចាំ ឆ្នាំ របស់ មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ។ មន្ទីរ កសិកម្ម ត្រូវ ពិនិត្យ នូវ ភាពចន្លោះប្រហោង ណា ដែល នៅ សេសសល់ យកមក ជជែក និង ពិភាក្សា បន្ត ដើម្បី រក ដំណោះស្រាយ ហើយ ធ្វើ យ៉ាង ឲ្យ វិស័យ កសិកម្ម កាន់តែ រីកចំរើន ដើម្បី ទ្រទ្រង់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ។
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ នឹង រៀបចំ ព្រឹត្តិការណ៍ កីឡា ទេសចរណ៍ អន្លង់ វែង លើក ទី២ ក្រោម ប្រធានបទ « ថ្មើរជើង ប្រវត្តិសាស្រ្ត » ចាប់ពី ថ្ងៃទី ០៧ - ០៩ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅ ទី រួម ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ដើម្បី ផ្សព្វផ្សាយ ពី សក្តានុពល តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្ត្រ អន្លង់ វែង ។
គោលបំណង នៃ ការរៀបចំ ព្រឹត្តិការណ៍ នេះ គឺ ដើម្បី រំឭក នូវ ភាពជោគជ័យ នៃ នយោបាយ ឈ្នះ - ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្នុង ការបញ្ចប់ សង្គ្រាម និង នាំមក នូវ សន្តិភាព ពេញលេញ ជូន ប្រទេសជាតិ ។
ការរៀបចំ នេះ ក៏ មាន កិច្ចសហការ ជាមួយ គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី គ្រប់គ្រង និង អភិវឌ្ឍ តំបន់ ទេសចរណ៍ ប្រវត្តិសាស្ត្រ អន្លង់ វែង គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ រដ្ឋបាល ស្រុក អន្លង់ វែង និង មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា ។
ក្រសួង ទេសចរណ៍ ក៏ បាន អំពាវនាវ ដល់ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ផ្នែក ឯកជន ក្នុង វិស័យ ទេសចរណ៍ កីឡាករ - កីឡាការិនី យុវជន សិស្ស និស្សិត និង សាធារណជន ទាំងអស់ មេត្តា ចូលរួម ក្នុង ព្រឹត្តិការណ៍ កីឡា ទេសចរណ៍ អន្លង់ វែង លើក ទី២ នេះ ឲ្យបាន ច្រើន កុះករ ៕ គណៈកម្មការ ទី៣ នៃ រដ្ឋសភា ក្រសួង ធនធាន ទឹក និង រដ្ឋបាល ខេត្ត កំពង់ចាម ចុះ ពិនិត្យមើល ទីតាំង សិក្សា ការពារ ច្រាំង ទន្លេ នៅ តំបន់ ប្រជុំ កោះ ពាម កោះ ស្នា ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ គណៈប្រតិភូ គណៈកម្មការ ទី៣ នៃ រដ្ឋសភា បាន បន្ត ដំណើរ ចុះ ពិនិត្យមើល ទីតាំង សិក្សា ការពារ ច្រាំង ទន្លេ នៅ តំបន់ ប្រជុំ កោះ ពាម កោះ ស្នា ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម ចម្ងាយ ប្រមាណ ជាង ៥០ គីឡូម៉ែត្រ ពី ទី រួម ខេត្ត កំពង់ចាម ។
ឆ្លៀត ក្នុង ឱកាស ចុះ ពិនិត្យ ទីតាំង ខាងលើ គណៈកម្មការ ទី៣ នៃ រដ្ឋសភា ថ្នាក់ដឹកនាំ ខេត្ត កំពង់ចាម ព្រមទាំង ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ឯកភាព គ្នា រក ក្រុមហ៊ុន ឯកជន មក បូម ខ្សល់ ចេញ ដើម្បី សំរួល ចរន្ត ទឹក កុំ ឱ្យ បាក់ ច្រាំង កុំ ឱ្យ បាត់បង់ ប្រយោជន៍ របស់ ប្រជាពលរដ្ឋ នៅ ថ្ងៃ អនាគត ។
កាលពី ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២០ ប្រធាន គណៈកម្មការ ផែនការ វិនិយោគ កសិកម្ម អភិវឌ្ឍន៍ ជនបទ បរិស្ថាន និង ធនធាន ទឹក នៃ រដ្ឋសភា លោក ជា វ៉ាន់ ដេត បាន ដឹកនាំ សមាជិក សមាជិកា នៃ គណៈកម្មការ ទី៣ អញ្ជើញ ចុះ ជួបប្រជុំ និង ពិភាក្សា ការងារ ជាមួយ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម ព្រមទាំង មន្ទីរ ពាក់ព័ន្ធ នឹង ការទទួលបន្ទុក របស់ គណៈកម្មការ ។
នៅក្នុង ជំនួប ពិភាក្សា ការងារ ជាមួយ លោក អ៊ុន ចាន់ ដា. លោក ជា វ៉ាន់ ដេត បាន គូសបញ្ជាក់ ថា បេសកកម្ម របស់ គណៈកម្មការ នា ពេលនេះ គឺ ក្នុង គោលបំណង សិក្សា ស្វែងយល់ ពី ស្ថានភាព ភូមិសាស្ត្រ និង ប្រមូល ព័ត៌មាន មួយចំនួន ពាក់ព័ន្ធ នឹង វិស័យ ទទួលបន្ទុក របស់ គណៈកម្មការ អំពី វឌ្ឍនភាព ការងារ ប្រសិទ្ធភាព នៃ ការអនុវត្តន៍ ច្បាប់ នានា និង បញ្ហា ប្រឈម របស់ ខេត្ត ដើម្បី រួមគ្នា រក ដំណោះស្រាយ មិន មែន មក ដេញដោល រក ហេតុផល ខុសត្រូវ អ្វី នោះ ទេ ។
អភិបាល ខេត្ត កំពង់ចាម បាន ជម្រាប គណៈកម្មការ រដ្ឋសភា ថា ដោយសារ ប្រទេសជាតិ មាន សុខ សន្តិភាព ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ផ្តល់ ភាពអនុគ្រោះ ដល់ ការអភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ នៅ ទូទាំង ប្រទេស ។ ទន្ទឹម នេះ ខេត្ត កំពង់ចាម ក៏ មាន ការអភិវឌ្ឍ រីកចម្រើន ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ បាន ធ្វើឱ្យ លេចឡើង នូវ សមិទ្ធផល នានា ជាច្រើន មាន ដូចជា វិស័យ ផែនការវិនិយោគ វិស័យ កសិកម្ម វិស័យ អភិវឌ្ឍន៍ ជនបទ វិស័យ បរិស្ថាន និង វិស័យ ធនធាន ទឹក និង ឧតុនិយម ។
អភិបាល ខេត្ត បាន គួរ បញ្ចាក់ ថា សមិទ្ធិផល ខាងលើ គឺ ពិតជា បាន កើតឡើង ពី ការខិតខំ រួមគ្នា ពី ថ្នាក់ដឹកនាំ គ្រប់ ថ្នាក់ ពិសេស គឺ ថ្នាក់ដឹកនាំ ជំនាន់ មុន ៗ បាន បន្សល់ទុក នូវ ស្នាដៃ ជា គំរូ ដល់ អ្នកជំនាន់ ក្រោយ រៀនសូត្រ និង កសាង អភិវឌ្ឍ បន្ត ទៀត សម្រាប់ សង្គមជាតិ និង ប្រជាជន ខេត្ត កំពង់ចាម ។
លោក បាន បន្ត ថា ទោះបីជា មាន ការរីកចម្រើន គួរឱ្យ កគ់ សម្គាល់ យ៉ាងណា ក៏ដោយ ក៏ តម្រូវការ ជា អាទិភាព ស្ថានភាព ជាក់ស្តែង ខេត្ត កំពង់ចាម បច្ចុប្បន្ន នៅតែ ជួបប្រទះ បញ្ហា ប្រឈម មួយ ចំនួន ដូចជា ហេដ្ឋារចនាសម្ព័ន្ធ ផ្លូវ គមនាគមន៍ មួយចំនួន បាន រង ការខូត ខាត ដោយសារតែ ការប្រើ និង មាន ទឹក ដក់ ដែល តម្រូវ ឱ្យ ធ្វើ ការជួសជុល ថែទាំ ជាប្រចាំ ។ ប្រព័ន្ទ លូបង្ហូរ ទឹក ស្អុយ មាន សមាព ចាស់ កកស្ទះ ត្រូវការ ជួសជុល ស្តារ ឡើង និង មួយចំនួន ត្រូវការសាងសង ថ្មី ។
ថវិកា សម្រាប់ វិស័យ វិនិយោគ អភិវឌ្ឍន៍ នៅ មិន ទាន់ ឆ្លើយតប តាម តម្រូវការ របស់ មូលដ្ឋាន ភាគ ច្រើន បាន ប្រើប្រាស់ តែ សកម្មភាព គម្រោង ហេដ្ឋារចនាសម្ព័ន ដោយ មិន ទាន់ បាន ផ្តោត លើ ការងារ សេវា សង្គម មាន ដូចជា គ្រោះមហន្តរាយ ទឹក ជំនន់ គ្រោះ រាំងស្ងួត ជន ងាយ រងគ្រោះ ពិការភាព ស្ត្រី កុមារ និង ជន ទី ទាល់ ក្រ។ ការចូលរួម របស់ អង្គការ សង្គម ស៊ីវិល និង វិស័យ ឯកជន ក្នុង ការអភិវឌ្ឍ នៅ ពុំ ទាន់ មាន ភាព គ្រប់គ្រាន់ ។
បន្ទាប់ពី បាន ស្តាប់ នូវ ការរាជការណ៍ របស់ ថ្នាក់ដឹកនាំ ខេត្ត កំពង់ចាម រួច មក លោក ជា វ៉ាន់ ដេត បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង បំពេញ ភារកិច្ច យ៉ាង សកម្ម របស់ ថា្នក់ដឹកនាំ ខេត្ត មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ដែល បាន សម្រេច លទ្ធផល គួរអោយ កោតសរសើរ ជា ប្រយោជន៍ ជូន ប្រជាពលរដ្ឋ ក្នុង ខេត្ត ទាំងមូល ។
( កំពង់ស្ពឺ ) ៖ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ បាន ក្រើន រំលឹក ថា ការងារ ហ្វឹកហ្វឺន បណ្តុះបណ្តាល ធនធាន មនុស្ស ក្នុង កងយោធពល ខេមរភូមិន្ទ គឺជា កត្តា ចាំបាច់ បំផុត មួយ ក្នុង ចំណោម បញ្ហា សំខាន់ ៗ ជាច្រើន ទៀត ដើម្បី ឆ្លើយតប ទៅនឹង សំណូមពរ ភារកិច្ច ចាំបាច់ ចំពោះ មុខ និង យូរអង្វែង ។
ការលើកឡើង របស់ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន ត្រូវបាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ នៅក្នុង ឱកាស អញ្ជើញ ជា អធិបតី នៃ ពិធី សម្តែង លំហាត់ សំយោគ របស់ សិក្ខាកាម នាយ ទាហាន ទ័ព ជើងគោក ជំនាន់ ទី៨ នៅ វិទ្យាស្ថាន កងទ័ព ជើងគោក ។
នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន បាន សង្កត់ធ្ងន់ ថា ដើម្បី បន្ត ពង្រឹង ការកសាង ធនធាន មនុស្ស ក្នុង វិស័យ ការពារ ជាតិ ចាំបាច់ ត្រូវ ធ្វើ ការកែទម្រង់ ដោយ ឈរ លើ គោលការណ៍ សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ពិសេស ប្រព័ន្ធ អប់រំ យោធិន ត្រូវ កែសម្រួល ដើម្បី បង្កើន ប្រសិទ្ធភាព ទាំង ការបណ្តុះបណ្តាល យោធិន អាជីព និង ការហ្វឹកហ្វឺន ជំនាញ ផ្សេង ៗ ។
តាម សេចក្តីរាយការណ៍ របស់ នាយក វិទ្យាស្ថាន កងទ័ព ជើងគោក សិក្ខាកាម នាយ ទាហាន ជើង គោក ជំនាន់ ទី៨ មាន ចំនួន សរុប ២២៧ នាក់ ឆ្លងកាត់ ការហ្វឹកហ្វឺន រយៈពេល ៤ ឆ្នាំ ក្នុង នោះ មាន ហ្វឹកហ្វឺន មេរៀន យុទ្ធ វិធី ពី កម្រិត បុគ្គល ដល់ កម្រិត នាយ ក្រុម ហ្វឹកហ្វឺន មេរៀន ចំណេះដឹង ទូទៅ និង យោធា ថ្នាក់ មូលដ្ឋាន ហ្វឹកហ្វឺន មេរៀន យុទ្ធ វិធី ពី កម្រិត មេញ្ជាការ កង អនុ សេនា តូច និង សិក្សា ស្វែងយល់ ថ្នាក់ កង អនុ សេនា ធំ ហ្វឹកហ្វឺន មេរៀន ចំណេះដឹង បច្ចេកទេស និង មុខជំនាញ អន្តរាវុធ ។
នាយ ឧត្ដមសេនីយ៍ អគ្គ មេបញ្ជាការ បាន ថ្លែងអំណរគុណ ដល់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ នានា ដែល បាន ផ្តល់ កិច្ចសហការ យ៉ាង ល្អ ជាមួយនឹង ស្ថាប័ន ជំនាញ អគ្គ បញ្ជាការដ្ឋាន ធ្វើឲ្យ ការងារ បណ្តុះបណ្តាល យោធិន នៅ តាម បណ្តា សាលា សមស្រប ជាមួយនឹង ប្រព័ន្ធ អប់រំ ជាតិ និង មាន លក្ខណៈ និយាម អន្តរជាតិ ។
ដើម្បី ជា មូលដ្ឋាន សម្រាប់ សិក្ខាកាម ដែល ទើប បញ្ចប់ ការសិក្សា យក ទៅ អនុវត្ត ឲ្យ ទទួលបាន លទ្ធផល ល្អ នាយ ឧត្ដមសេនីយ៍ អគ្គ មេបញ្ជាការ បាន ផ្តាំផ្ញើ នូវ ចំណុច សំខាន់ ៗ មួយចំនួន ដូច ខាងក្រោម៖
អ្នកជំនាញ ប្រាប់ កុំ ឲ្យបារម្ភ ពី វីរុស « កូរ៉ូណា » ដោយសារ វា ស្រដៀង គ្នា នឹង ជំងឺ ផ្តាសាយ ធម្មតា ប៉ុណ្ណោះ សូម មេត្តា ចូលរួម អនាម័យ ជា ចម្បង ដើម្បី ជៀសវាង ជំងឺ នេះ
( ភ្នំពេញ ) ៖ អ្នកជំនាញ ផ្នែក វេជ្ជសាស្ត្រ កម្ពុជា បាន ថ្លែង សារ ប្រាប់ ទៅ ប្រជាពលរដ្ឋ កុំ ឲ្យ ព្រួយបារម្ភ ពី ជំងឺ រលាក សួត ដែល បង្កឡើង ដោយ វីរុស កូរ៉ូណា ប្រភេទ ថ្មី ឲ្យ សោះ ដោយសារ វា ស្រដៀង គ្នា នឹង ជំងឺ ផ្តាសាយ តែ ប៉ុណ្ណោះ សូម មេត្តា ចូលរួម អនាម័យ ជា ចម្បង ដើម្បី ជៀសវាង ជំងឺ នេះ ។
អ្នក ធ្លាប់ ធ្វើការ នៅ មន្ទីពិសោធន៍ ស្រាវជ្រាវ វេជ្ជសាស្រ្ត នៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា លោក ជឹម ភ័ក្ត្រា បាន លើកឡើង ប្រាប់ អង្គភាព ព័ត៌មាន Fresh News នា ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ ថា ជាទូទៅ ការចម្លង វីរុស កូរ៉ូណា អាច ឆ្លង បាន ត្រូវ ពឹង លើ កត្តា មួយ ចំនួន សមស្រប គឺ ចំនួន មេរោគ និង ការប៉ះពាល់ នឹង នៅ ទល់មុខ អ្នកជំងឺ ផ្ទាល់ ។
អ្នកជំនាញ ផ្នែក វេជ្ជសាស្ត្រ ជាង ១០ឆ្នាំ រូប នេះ បាន លើកឡើង បន្ត ថា នៅ កម្ពុជា មាន អ្នក ផ្ទុក វិរុស កូរ៉ូណា តែ ម្នាក់ ប៉ុណ្ណោះ . អាស្រ័យ ហេតុ នេះ សូម កុំ ព្រួយបារម្ភ ពេក នាំឲ្យ មាន ការជ្រួលច្របល់ ។ សំខាន់ បំផុត ត្រូវ ឲ្យ ពលរដ្ឋ បាន យល់ ច្បាស់ ថា វីរុស នេះ មិន មែន ហោះ ពាស វាលពាសកាល នោះ ទេ ដូច្នោះ បើ មិន នៅជិត ផ្ទាល់ ឬ ប៉ះពាល់ ផ្ទាល់ បើ គ្រាន់តែ ប៉ះពាល់ ត្រូវ លាង សម្អាត ដៃ លុប មុខ នឹង សាប៊ូ ឬ សារធាតុ សម្លាប់ មេរោគ នោះ ក៏ វា មិន អាច ឆ្លង បាន ដែរ ។ សំខាន់ បំផុត គឺ ត្រូវ រក្សា អនាម័យ គ្រប់ ពេលវេលា ។
សូម ជំរាប ថា លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្រ្តី ក្រសួង សុខាភិបាល កម្ពុជា បាន បន្ត ក្រើន រំលឹក ជូន ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ លើ ការបង្ការ ការ ចម្លង ជំងឺ រលាក សួត ដោយ វីរុស កូរ៉ូណា ថ្មី ដោយ អនុវត្ត នូវ វិធានការ ដូចត ទៅ៖
ដើម្បី ធានា ការ គ្រប់គ្រង វត្តមាន ជន បរទេស បម្រើ ឲ្យ សំណូមពរ រក្សា សន្តិសុខ សុវត្ថិភាព សង្គម អគ្គ នាយកដ្ឋាន បាន យកចិត្តទុកដាក់ ពង្រឹង កិច្ច ដំណើរការ នៃ ការត្រួតពិនិត្យ ផ្តល់ ទិដ្ឋាការ ចូល ប្រទេស និង ការបំពេញ បែបបទ ស្នើសុំ ទិដ្ឋាការ បន្ត ស្នាក់ នៅ បណ្តោះអាសន្ន ជាពិសេស អាសយដ្ឋាន ស្នាក់ នៅ និង អាសយដ្ឋាន ទំនាក់ទំនង និង ឯកសារ ចាំបាច់ មួយ ចំនួន ទៀត ដោយ៖
ក្នុង នោះ បាន រកឃើញ អ្នកដំណើរ ជា មុខសញ្ញា នានា និង មិន គ្រប់ លក្ខណៈ សម្បត្តិ ធ្វើ ការបដិសេធ មិន ផ្ដល់ ទិដ្ឋាការ ជូន ចំនួន ២១៥ លើក មនុស្ស ២៦៥ នាក់ មាន ៦៣សញ្ជាតិ ដោយ បាន ប្រមូល អាករ ជូន រដ្ឋ សរុប ចំនួន ១៧៦. ៣៥៦. ១៣៥ ដុល្លារ ៕ រកឃើញ ម្នាក់ ទៀត ហើយ ! អ្នក ខេត្ត ស្វាយរៀង មាន កូន ៣នាក់ ហើយ ទើប សម្រេច ក្តីស្រម៉ៃ ក្រោយ ឈ្នះ រង្វាន់ ៥០ លាន រៀល ពី ស្រាបៀរ កម្ពុជា
( ស្វាយរៀង ) ៖ បុរស ខេត្ត ស្វាយរៀង ម្នាក់ ឈ្មោះ ពៅ អាន វ័យ ៤០ ឆ្នាំ ប្រកបរបរ ជាជាង អារ ឈើ ហើយ គ្រាន់តែ មាន ក្តីស្រមៃ ត្រឹម ទិញ ត្រាក់ទ័រ មួយ ផ្ទាល់ខ្លួន សោះ ត្រូវ រង់ចាំ តាំងពី មាន កូនទី១ រហូតដល់ មាន កូន ៣នាក់ ទើប សម្រេច ក្តីស្រមៃ មួយ នេះ បាន ក្រោយ មាន សំណាង ឈ្នះ រង្វាន់ ទឹកប្រាក់ ៥០ លាន រៀល ពី ក្រវិល កំប៉ុង ស្រាបៀរ កម្ពុជា កាលពី ពេល ថ្មី ៗ នេះ ។
អ្នក ឃុំ អំពិល ស្រុក រមាសហែក រូប នេះ បាន និយាយ ថា « ខ្ញុំ ស្រមៃ ចង់បាន ត្រាក់ទ័រ ១ គ្រឿង នេះ យូរ ហើយ តាំងពី មាន កូន ដំបូង ម្ល៉េះ ដោយសារ ត្រាក់ទ័រ អាច ជួយ សម្រួល ការងារ ស្រែ ចម្ការ របស់ ខ្ញុំ បាន ច្រើន ។ ម្យ៉ាង វិញ ទៀត ខ្ញុំ ក៏ អាច យក ទៅ ជួល ធ្វើ ស្រែ ឱ្យ អ្នកស្រុក ភូមិ បាន ប្រាក់ កម្រៃ ផ្គត់ផ្គង់ គ្រួសារ ជា ប្រចាំ ថ្ងៃ ផងដែរ ។ ពេលនេះ កូន ៣នាក់ ទៅ ហើយ ទើបនឹង ទិញ បាន ត្រាក់ទ័រ ១ គ្រឿង នេះ ដាក់ នៅក្នុង ផ្ទះ ហើយ វា លែង ជា សុបិន ទៀត ហើយ » ។
លោក ពៅ អាន បាន ឲ្យ យោបល់ អ្នក ដែល មាន ក្តីស្រមៃ ស្រដៀង លោក គួរ បន្ត ក្ដី ស្រមៃ នេះ ដោយ អត់ធ្មត់ បើ ទោះជា ជួប ឧបសគ្គ អ្វី មក រារាំង ប៉ុណ្ណា ក៏ដោយ ព្រោះ ថ្ងៃ មួយ ពួកគេ នឹង ជួប សំណាង ដូច លោក មិន ខាន ៕
ពិសា ដោយ ការទទួលខុសត្រូវ ! ប្រកាស ចូលកាន់ មុខតំណែង ប្រធាន មន្ទីរ រៀបចំ ដែនដី ខេត្ត ពោធិ៍សាត់ . លោក ឱន សទ្ធា ជំនួស លោក លៀម ប៊ុន រឿន
( ពោធិ៍សាត់ )៖ លោក ឆាន់ សាផាន រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ តំណាង លោក ឧប នាយក រដ្ឋមន្រ្តី ជា សុផារ៉ា និង លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នា ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រកាស ចូលកាន់ មុខតំណែង ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត ពោធិ៍សាត់ ។
តាម ប្រកាស របស់ ក្រសួង បាន សម្រេច តែងតាំង លោក ឱន សទ្ធា អតីត អនុប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ខេត្ត មក ជា ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ត ពោធិ៍សាត់ វិញ ជំនួស លោក លៀម ប៊ុន រឿន ។
ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន និង លោក ឆាន់ សាផាន បាន ឲ្យដឹង ថា ការប្រកាស តែងតាំង ប្រធាន មន្ទីរ ថ្មី នេះ ជា រឿង ធម្មតា សម្រាប់ មន្ត្រីរាជការ ទូទៅ ដើម្បី ផ្លាស់ប្ដូរ បទពិសោធន និង ពង្រឹង ការងារ ឲ្យ កាន់តែ រលូន ថែម ទៀត ។ ថ្នាក់ដឹកនាំ ទាំង២ បាន ថ្លែង ការកោតសរសើរ ចំពោះ ការខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ បំពេញ តម្រូវការ និង សេវា ផ្សេង ៗ ជូន ប្រជាពលរដ្ឋ ហើយ ការអនុវត្ត ច្បាប់ ក៏ មាន លក្ខណៈ ល្អ ប្រសើរ ដែរ ។
ថ្នាក់ដឹកនាំ ទាំង២ បាន បន្ថែម ថា ប្រទេសជាតិ មាន ច្បាប់ ដូច្នេះ យើង ត្រូវ ចូលរួម គោរព និង អនុវត្តន៍ ច្បាប់ ទាំងអស់ គ្នា ដោយ ប្រើប្រាស់ ឆន្ទះ មន សិក្កា ទៅ លើ ផ្លូវ ច្បាប់ ប្រើប្រាស់ តួនាទី ពេលវេលា ផ្សារភ្ជាប់ ទៅនឹង សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ មិន អាច យក តួនាទី ដែល រដ្ឋ ផ្តល់ឲ្យ ទៅ ប្រើប្រាស់ លក្ខណៈ ឯកជន ប្រើប្រាស់ ជា ផលប្រយោជន៍ ឯកជន ដែល ផ្ទុយ នឹង ច្បាប់ កំណត់ នោះ បាន ឡើយ ។
ថ្នាក់ដឹកនាំ ទាំង២ បាន ផ្តាំផ្ញើ ដល់ គ្រប់ មន្ត្រី នៃ មន្ទីរ រៀបចំ ដែនដី ខេត្ត ទាំងអស់ ត្រូវ បន្ត ខិតខំ ធ្វើ ការងារ ដោយ បង្កើន ចំណង សាមគ្គីភាព ឯកភាព ផ្ទៃក្នុង ប្រើប្រាស់ មន្ត្រី ឲ្យ ត្រូវ ជំនាញ និង ត្រូវ គោរព វិន័យ ការងារ តួនាទី ភារកិច្ច លក្ខខណ្ឌ ការងារ ដែល បាន បែងចែក ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ នៅ គ្រប់ ការិយាល័យ ភូមិបាល ស្រុក ទាំងអស់ ត្រូវ ខិតខំ រួមគ្នា បម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ ឲ្យ មាន តម្លាភាព ប្រសិទ្ធភាព និង មាន ភាពជឿជាក់ ។
ជាមួយគ្នា នោះ លោក ចង់ ឃើញ នូវ ស្នាមញញឹម នៃ ការដឹកនាំ ការចេះដឹង ក្រមសីលធម៌ ខ្ពស់ ពោរពេញ ទៅ ដោយ បទពិសោធន៍ ជាពិសេស ត្រូវ បន្ត ពង្រឹង និង អភិវឌ្ឍន៍ សមត្ថភាព របស់ ខ្លួន ឲ្យ សាកសម ជា អ្នក បន្ត វេន ដ៏ ល្អ និង ឲ្យ សមស្រប ទៅនឹង សម្ភារៈ បច្ចេកទេស ដែល មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ក្នុង យុគ្គ សម័យ បច្ចុប្បន្ន ។
( ភ្នំពេញ ) ៖ វីរុស កូរ៉ូណា បង្កឱ្យ មាន ភាពភ័យខ្លាច ខ្លាំង នៅ កម្ពុជា ជាជាង ការពិត ដូច ដែល លោក អ្នក បាន ដឹង មក ហើយ ថា វីរុស កូរ៉ូណា បាន វាយលុក ពិភពលោក យ៉ាង លឿន ដោយ វីរុស នេះ កើត ចេញ ពី ប្រទេស ចិន ក្នុង ទីក្រុង វូហាន ។
ចំណែក នៅ ប្រទេស កម្ពុជា លោក ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន ប្រកាស ក្នុង សន្និសីទ កាសែត នា ថ្ងៃទី ២៧ ខែមករា ឆ្នាំ ២០២០ ចំពោះ ករណី នៃ ការរកឃើញ នេះ ដោយ មាន បុរស ម្នាក់ ជា ជនជាតិ ចិន មាន ផ្ទុក វីរុស កូរ៉ូណា ជា លើក ដំបូង នៅ ខេត្ត ព្រះសីហនុ ដែល គាត់ បាន ធ្វើដំណើរ មកពី ខេត្ត វូហាន នៃ ប្រទេស ចិន ។
យោង ទៅតាម ប្រសាសន៍ របស់ លោកស្រី នាយក សាលា ហ៊ែរ៉ុដស៍ អន្តរជាតិ៖ លោកស្រី បាន លើក ទឡ្ហីករណ៍ មួយចំនួន ដែល បាន កើតឡើង ក្នុង វិស័យ អប់រំ ហើយ ចំពោះ សាលា ហ៊ែរ៉ុដស៍ អន្តរជាតិ បាន បើក ដំណើរការជា ប្រក្រតី ដោយ សំអាង ទៅ លើ ហេតុផល ជាក់លាក់ ដូច ខាងក្រោម៖ ទី ១៖ សាលា ជឿជាក់ លើ ការវិវឌ្ឍន៍ ពិតប្រាកដ បច្ចុប្បន្នភាព របស់ វីរុស កូរ៉ូណា នៅក្នុង ប្រទេស កម្ពុជា ដែល មាន ការយកចិត្តទុកដាក់ ពីសំណាក់ ក្រសួង សុខាភិបាល ក្នុង ការចាត់ វិធានការគ្រប់គ្រង ទប់ស្កាត់ និង បង្ការ ។
ទី ២៖ រាជ រដ្ឋាភិបាល ដែល មាន សេនាធិការ ក្រសួង អប់រំ ពុំ បាន ចេញ សេចក្តីប្រកាស ណែនាំ ឱ្យ បិទ គ្រឹះស្ថាន អប់រំ សាលា ណាមួយ តែ ក្រសួង បាន ចេញ សេចក្តីណែនាំ ក្នុង ការទប់ស្កាត់ បង្ការ និង អនាម័យ ។
ទី៣៖ សាលា ហ៊ែរ៉ុដស៍ អន្តរជាតិ មាន គោល នយោបាយ ក្នុង ការអនុវត្ត អនាម័យ សុវត្ថិភាព ជាប្រចាំ និង បាន ចាត់ វិធានការ យ៉ាង ពិសេស ក្នុង កំឡុង ពេល មួយ រយៈ នេះ ។ វិធានការ ទាំង នេះ រួម មាន៖
* ការពិនិត្យ សីតុណ្ហភាព សិស្ស បុគ្គលិក និង មនុស្ស គ្រប់ រូប មុន ឆ្លងកាត់ ច្រក ចេញ ចូល សាលា ដែល ជា រៀងរាល់ ពេល ចេញ និង ចូល បរិវេន សាលារៀន ។
* នាយក សាលា និង គិលានុបដ្ឋាយិកា របស់ សាលា ក៏ ដូចជា លោកគ្រូ អ្នកគ្រូ បាន ផ្តល់ ដំបូន្មាន អំពី របៀប ពាក់ ម៉ាស់ ហើយ សាលា បាន បង្កើត គណៈកម្មាធិការ ពិសេស ក្នុង ការត្រួតពិនិត្យ តាមដាន និង វាយតម្លៃ ស្ថាន ការ ណ៏ រៀបចំ កញ្ចប់ ថវិការ សម្រាប់ ឆ្លើយតប ទៅនឹង ស្ថានភាព នា ពេល បច្ចុប្បន្ន នេះ ។ល ។
បន្ថែម លើស ពី នេះ ទាក់ទិន អំពី និង ការសម្អាត ដៃ សាលា បាន រៀបចំ ដាក់ ទឹក សម្អាត អនាម័យ លាង ដៃ នៅ គ្រប់ បន្ទប់ រៀន ហើយ សាលា ក៏ បាន បាញ់ ថ្នាំ សម្លាប់ មេរោគ ជាប្រចាំ ។
ចាប់ មន្ដ្រី មន្ទីរ សុខាភិបាល នៅ ខេត្ដ ក្រចេះ ម្នាក់ និង បក្ខពួក ២នាក់ ទៀត ពាក់ព័ន្ធ ករណី ជួញដូរ គ្រឿងញៀន
( ក្រចេះ ) ៖ នគរបាល ក្រុង ក្រចេះ ក្រោម ការបញ្ជា ពី ឧត្ដមសេនីយ៍ ទោ លន់ សុផាត ស្នងការ នគរបាល ខេត្ត ក្រោម សម្របសម្រួល ពី លោក កែវ សុជាតិ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត នៅ ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២០ បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៣នាក់ ពាក់ ពន្ធ័ករណី ជួញដូរ គ្រឿងញៀន នៅ សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ។
យោង តាម របាយការណ៍ នគរបាល ក្រុង ក្រចេះ បាន ឲ្យដឹង ថា ប្រតិបត្តិការ នេះ នៅមុខ សាល មហោស្រប សង្កាត់ ក្រចេះ ដោយ បាន ឃាត់ខ្លួន ជនសង្ស័យ ឈ្មោះ ក្រេង ចាន់ រស្មី ភេទ ប្រុស អាយុ ២៩ ឆ្នាំ មុខរបរ ជាង មាស រស់ នៅ បន្ទប់ ជួល ភូមិ ដូន ជ្រាំ សង្កាត់ ក្រចេះ ក្រុង ក្រចេះ ។ ក្រោយ ការចាប់ខ្លួន កម្លាំង នគរបាល បាន ដកហូត បាន វត្ថុតាង រួម មាន៖ ម្សៅ ក្រាម ពណ៌ ស ចំនួន ១ កញ្ចប់ ទូរស័ព្ទ១ គ្រឿង ម៉ូតូ ១ គ្រឿង ។
តាម របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា នៅ ថ្ងៃ ដដែល កម្លាំង នគរបាល បន្ត ឆែកឆេរ បន្ទប់ ជួល របស់ ឈ្មោះ ក្រេង ចាន់ រស្មី បាន ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ២ទៀត រួម មាន៖
* ទី១៖ ឈ្មោះ សុខ អីឡន ភេទ ប្រុស អាយុ ២២ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ធ្លាប់ ជាប់ ពន្ធនាគារ មាន ទីលំ ភូមិ សំបុក ឃុំ សំបុក ស្រុក ចិត្រ បុរី ខេត្ត ក្រចេះ * ទី២៖ ឈ្មោះ អែល រដ្ឋា ភេទ ប្រុស អាយុ ៣៤ ឆ្នាំ មុខរបរ ជា មន្រ្តី មន្ទីរ សុខាភិបាល ខេត្ត ក្រចេះ រស់ នៅ សង្កាត់ អូរឬស្សី ដោយ ដកហូត បាន ម្សៅ ក្រាម ពណ៌ ស ចំនួន ៥កញ្ចប់ ទូរស័ព្ទ ចំនួន ២គ្រឿង និង សម្ភារ ប្រើប្រាស់ គ្រឿងញៀន មួយចំនួន ។
ថ្លែង នៅក្នុង សុន្ទរកថា មួយ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ និង ចំពេល កំពុង មាន បាតុកម្ម តវ៉ា ប្រឆាំង នឹង ការរៀបចំ ទីតាំង សម្រាប់ អ្នក មាន ផ្ទុក វីរុស កូរ៉ូណា លោក មូន បាន គូសបញ្ជាក់ ដូច្នេះ ថា « អាវុធ ដែល ការពារ យើង ពី វីរុស កូរ៉ូណា គឺ បញ្ចប់ ភាពភ័យខ្លាច . ការរើសអើង ហើយ បង្កើន ការជឿទុកចិត្ត និង កិច្ចសហប្រតិបត្តិការ »។ បន្ថែម ពីលើ នេះ លោក ប្រធានាធិបតី កូរ៉េ ខាងត្បូង ក៏ បាន ថ្កោលទោស ផងដែរ ចំពោះ ការផ្សព្វផ្សាយ ព័ត៌មាន ក្លែងក្លាយ ឬ fake News ដែល កំពុង បង្ក ភាពភ័យខ្លាច ដល់ ប្រជាជន ។
គួរ ជម្រាប ថា ជើងហោះហើរ ដំបូង ក្នុង ចំណោម ជើងហោះហើរ ចំនួន ០៤ ទៅកាន់ ទីក្រុង វូហាន ដើម្បី ជម្លៀស ពលរដ្ឋ កូរ៉េ ខាងត្បូង ជាង ៧០០ នាក់ បាន ចាកចេញ ពី កូរ៉េ ខាងត្បូង នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ ប៉ុន្តែ ស្រាប់តែ ពន្យារ ពេល ទៅ វិញ ដោយ មិន ដឹង មូលហេតុ ។ យ៉ាងណា ក៏ដោយ ជើងហោះហើរ នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ចេញដំណើរ នៅ រសៀល ឬ ល្ងាច ថ្ងៃ ដដែល ។ បច្ចុប្បន្ន នេះ នៅ កូរ៉េ ខាងត្បូង មាន អ្នក ផ្ទុក វីរុស កូរ៉ូណា ថ្មី សរុប ០៤ នាក់ ដោយ ពួកគេ សុទ្ធតែ បាន ធ្វើដំណើរ ពី ទីក្រុង វូហាន (Wuhan) ៕
ឃាត់ខ្លួន យុវជន ម្នាក់ ក្រោយ វាយ សិស្សសាលា « លីម កុក វីង » និង បាន ផ្ញើ រូប កាំភ្លើង គំរាម
( ភ្នំពេញ ) ៖ សមត្ថកិច្ច នគ បាល ព្រហ្មទណ្ឌ នៃ អធិការ ខណ្ឌ ៧មករា បាន ឃាត់ខ្លួន យុវជន ហេង គឹម ហួត អាយុ ២១ ឆ្នាំ សិស្យ សាលា មាន ទីលំនៅ ផ្ទះ លេខ ៤៣៨Eo ផ្លូវ ៣៤៥ សង្កាត់ ទឹកល្អក់៣ ខណ្ឌ ទទួល កោក រាជធានី ភ្នំពេញ ដើម្បី កសាង សំណុំរឿង បញ្ជូន ឱ្យ តុលាការ ចាត់ការ តាម ច្បាប់ ក្រោយ យុវជន រូប នេះ បាន វាយ និង ផ្ញើ រូប កាំភ្លើង ទៅ គំរាម ជនរងគ្រោះ ម្នាក់ នៅ សាលា លីម កុង វីង ។
ការឃាត់ខ្លួន យុវសិស្ស រូប នេះ ធ្វើឡើង កាលពី យប់ ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២០ ដោយ មាន ការឯកភាព ពី លោក ឡុង ជៀប ព្រះរាជអាជ្ញា រង អម សាលាដំបូង រាជធានី ភ្នំពេញ និង បន្ទាប់ពី យុវជន រូប នេះ ចូល ខ្លួន សារភាព កំហុស នៅ ប៉ុស្តិ៍ នគបាល រដ្ឋបាល សង្កាត់ មនោរម្យ ជាមួយ ការសុំ ជួសជុល សំណង ផ្លូវចិត្ត ដែល រូប គេ បាន ប្រព្រឹត្ត កំហុស លើ ជនរងគ្រោះ ។
លោក អធិការង បាន បញ្ជាក់ ថា បន្ទាប់ពី ប្រព្រឹត្ត ហិង្សា រួច ជន រូប នេះ បាន ប្រើប្រាស់ ប្រព័ន្ធ បណ្តាញ សង្គម ដោយ ផ្ញើ រូប កាំភ្លើង មក គំរាម ជនរងគ្រោះ បន្ថែម ទៀត ផង ។
បើ តាម សមត្ថកិច្ច ជនរងគ្រោះ មាន ឈ្មោះ ហម សុវណ្ណារ៉ា អាយុ ១៨ ឆ្នាំ មុខរបរ ជា សិស្ស មាន ទីលំនៅ សង្កាត់ ច្បារអំពៅ ទី១ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។
ពាក់ព័ន្ធ ករណី នេះ ជនរងគ្រោះ បាន រៀបរាប់ប្រាប់ សមត្ថកិច្ច ថា កាលពី ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២០ វេលា ម៉ោង ១០៖៣០ នាទី ព្រឹក ខ្លួន កំពុង អង្គុយ រៀន នៅ សាកលវិទ្យាល័យ « លីម កុក វីង » ក្នុង សង្កាត់ មនោរម្យ ខណ្ឌ ៧មករា ស្រាប់តែ ឈ្មោះ ហួត និង បក្ខពួក ម្នាក់ បាន ឡើង ដល់ ជាន់ ទី៧ ដោយ និយាយ ជាមួយ ខ្លួន ថា « ហ្អែង ឈ្លើយ ណាស់ » រួច ក៏ ចាប់ ច្របាច់ ក ហើយ រុញ ជនរងគ្រោះ អឹប នឹង ទ្វារ រួច បាន វៃ ចំនួន ៣ដៃ ចំភ្នែក ខាងឆ្វេង និង ចំផ្ទៃ មុខ បែក វ៉ែនតា រួច ក៏ ចុះ ទៅ ក្រោម វិញ បាត់ ទៅ ។
អូស្ត្រាលី កំពុង ត្រៀមលក្ខណៈ ទប់ទល់ ភ្លើង ឆេះ ព្រៃ ដែល អាច ឆេះ កញ្ជ្រោល ឡើងវិញ នៅ ភាគ អាគ្នេយ៍
( ស៊ីដនី ) ៖ តំបន់ មួយចំនួន ធំ នៃ ភាគ អាគេ្នយ៍ ប្រទេស អូស្ត្រាលី កំពុង ត្រៀមខ្លួន ទប់ទល់ នឹង រលក ម្ដៅ និង ខ្យល់ បក់ ខ្លាំង ដែល កំពុង បង្ក ការគំរាមកំហែង ក៏ ដូចជា ការព្រួយបារម្ភ កាន់តែ ខ្លាំង ឡើង អំពី ការផ្ទុះ ឡើងវិញ នូវ ភ្លើង ឆេះ ព្រៃ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី៣០ ខែមករា ឆ្នាំ ២០២០ ។
អ្នកជំងឺ ដែល បាន ឆ្លង វីរុស កូរ៉ូណា ប្រភេទ ថ្មី ខាងលើ នេះ មាន ឈ្មោះ ថា ចាង (Zhang) ត្រូវបាន ដាក់ ស្ថិត នៅក្នុង បន្ទប់ ពិសេស មួយ ហើយ ដើម្បី តាមដាន ប្រវត្តិ នៃ ការឆ្លង ។ គិត ត្រឹម ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ លោក ចាង កំពុង ស្ថិត នៅក្នុង ស្ថានភាពធម្មតា ហើយ អាជ្ញាធរ តំបន់ ស្វយ័ត ទី បេ ទាំងមូល ក៏ កំពុង បង្កើន ការឆ្លើយតប កម្រិត ខ្ពស់ ចំពោះ វីរុស កូរ៉ូណា ប្រភេទ ថ្មី នេះ ផងដែរ ។
ជាពិសេស ក្រសួង សុខាភិបាល បាន ដាក់ ម៉ាស៊ីន ស្កេន កំដៅ នៅ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ខេត្ត ព្រះសីហនុ និង សៀមរាប បាវិត ប៉ោយប៉ែត ព្រែក ចាក និង ស្រាវជ្រាវ រក ករណី សង្ស័យ ដោយ ក្រុម ចត្តាឡី ស័ក នៅ តាម ច្រក អាកាសយានដ្ឋាន អន្តរជាតិ ។
ទន្ទឹម នឹង នោះ នាយក រដ្ឋមន្រ្ដី កម្ពុជា ក៏ បាន ថ្លែង កោតសរសើរ ដល់ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ របស់ ក្រសួង សុខាភិបាល លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ណឌីន ដែល បាន ធ្វើ កិច្ចការ យ៉ាង សកម្ម ក្នុង ការផ្ដល់ជូន នូវ ព័ត៌មាន ភ្លាម ៗ ទៅដល់ អ្នកសារព័ត៌មាន ដើម្បី ផ្សព្វផ្សាយ ជូន ដល់ ប្រជាពលរដ្ឋ ។
សម្ដេច តេជោ ថ្លែង ដូច្នេះ ថា « សូម កោតសរសើរ ចំពោះ ក្រសួង សុខាភិបាល ជាពិសេស រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង ដែល មាន ភាពម្ចាស់ ការលើ យន្ដ ការប្រតិកម្ម រហ័ស ឆ្លើយតប នឹង ជំងឺ រលាក សួត ប្រភេទ កូរ៉ូណា វីរុស និង កោតសរសើរ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ របស់ ក្រសួង សុខាភិបាល លោកស្រី ឱ វណ្ណឌីន ដែល ធ្វើ កិច្ចការងារ ផ្សព្វផ្សាយ ព័ត៌មាន យ៉ាង ឆាប់រហ័ស ជូន ប្រជាពលរដ្ឋ តាមរយៈ ប្រព័ន្ធ ផ្សព្វផ្សាយ នានា » ។
ជា បន្ដ បន្ទាប់ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង បាន ចុះ ទៅតាម អាកាសយាន្ដដ្ឋាន អន្ដរជាតិ នីមួយ ៗ ដើម្បី ពិនិត្យមើល ពី ស្ថានភាព ការងារ របស់ មន្ដ្រី របស់ ខ្លួន ជាពិសេស លោក បាន ចុះ អប់រំ ផ្សព្វផ្សាយ ចែក លិខិត និង បិទ សេចក្ដីប្រកាស ព័ត៌មាន ពី វិធានការពារ ពី វិរុស កូរ៉ូណា នេះ នៅ តាម ចំណត រថយន្ដក្រុង និង ពលរដ្ឋ ធ្វើដំណើរ នៅ តាម ដងផ្លូវ ផងដែរ ៕
លោក ដូណាល់ ត្រាំ៖ បើ ខ្ញុំ ស្ដាប់ លោក បូល តុន ពិភពលោក សព្វ ថ្ងៃ ប្រហែលជា ស្ថិត ក្នុង សង្រ្គាម លោក លើក ទី៦ បាត់ ទៅ ហើយ !
លោក អប់ រ៉ាឌី បាន លើកឡើង ថា នៅក្រោម ច្បាប់ កម្មសិទ្ធិ បញ្ញា នៃ ប្រទេស ភាគ ច្រើន មាន បទប្បញ្ញត្តិ ស្តីពី កិច្ចការពារ ម៉ាក សមូហភាព ។
« ម៉ាក សមូហភាព » ជាទូទៅ ត្រូវបាន កំណត់ ថា ជា សញ្ញា សម្រាប់ សម្គាល់ ប្រភព ដើម ភូមិសាស្ត្រ វត្ថុធាតុ ដើម របៀប ផលិត ឬ ចរិត លក្ខណៈ ទូទៅ ផ្សេង ទៀត នៃ ទំនិញ ឬ សេវាកម្ម របស់ សហគ្រាស ផ្សេង ៗ ដែល ប្រើប្រាស់ ម៉ាក សមូហភាព នោះ ។
លោក បាន បន្ត ថា ម្ចាស់ ម៉ាក សមូហភាព អាច ជា សមាគម ដែល មាន សហគ្រាស ផ្សេង ៗ ជា សមាជិក ឬ អង្គភាព ផ្សេង ៗ ទៀត រួមទាំង ស្ថាប័ន សាធារណៈ ឬ សហករណ៍ ហើយ ម្ចាស់ ម៉ាក សមូហភាព ដែល បាន ចុះបញ្ជី គឺជា អ្នកទទួលខុសត្រូវ ក្នុង ការធានា ឲ្យ មាន អនុលោម ភាព តាម បទដ្ឋាន ជាក់លាក់ ណាមួយ ( ជាធម្មតា ត្រូវបាន កំណត់ នៅក្នុង បទបញ្ជា គ្រប់គ្រង ការប្រើប្រាស់ ម៉ាក រួម ) ដោយ សមាជិក របស់ ខ្លួន ។ ដូច្នេះ មុខងារ នៃ ម៉ាក សមូហភាព គឺ ដើម្បី ជូនដំណឹង ដល់ សាធារណជន អំពី ចរិត លក្ខណៈ ពិសេស នៃ ផលិតផល ដែល ពាក់ ម៉ាក សមូហភាព នោះ ។
លោក បាន បន្ត ទៀត ថា ម៉ាក សមូហភាព ជាញឹកញាប់ ត្រូវបាន ប្រើប្រាស់ ដើម្បី ផ្សព្វផ្សាយ ផលិតផល ដែល មាន ចរិត លក្ខណៈ ពិសេស ដែល ផ្តល់ ឱ្យ ដោយ តំបន់ ណាមួយ ។ ក្នុង ករណី បែប នេះ ការបង្កើត ម៉ាក សមូហភាព មិន ត្រឹមតែ ជួយ ធ្វើ ទីផ្សារ ផលិតផល ក្នុង ស្រុក និង ក្រៅ ស្រុក ប៉ុណ្ណោះ ទេ ថែមទាំង បាន ផ្តល់ ក្របខណ្ឌ សម្រាប់ កិច្ចសហប្រតិបត្តិការ រវាង ផលិត ករ ក្នុង ស្រុក ផងដែរ ។
ជា ការពិត ការបង្កើត ម៉ាក សមូហភាព ត្រូវតែ ដើរ ទន្ទឹម គ្នា ជាមួយនឹង ការអភិវឌ្ឍ ស្តង់ដារ លក្ខណៈ វិនិច្ឆ័យ និង យុទ្ធសាស្ត្រ រួម មួយ ។ លោក បាន បញ្ជាក់ ថា ម៉ាក សូហភាព អាច ក្លាយជា ឧបករណ៍ ដ៏ មាន ឥទ្ធិពល សម្រាប់ ការអភិវឌ្ឍ មូលដ្ឋាន ដោយ ការធ្វើ ការរួមគ្នា អាច ធ្វើឱ្យ ផលិត ករ - អាជីវករ និង សហគ្រាស ធុន តូច និង មធ្យម ទទួលបាន ផលប្រយោជន៍ ពី សេដ្ឋកិច្ច និង ការទទួលស្គាល់ ម៉ាក យីហោ កាន់តែ ទូលំទូលាយ ដោយ ផ្លាស់ប្តូរ ពី ការផលិត ទៅរក ការធ្វើ ទីផ្សារ ក្នុង លក្ខណៈ ដូច ក្រុមហ៊ុន ខ្នាត ធំ ផ្សេង ៗ ។
ម៉ាក សមូហភាព គឺជា សញ្ញា ដែល មើលឃើញ សំដៅ ប្រើ ក្នុង ការដាក់ពាក្យ ស្នើសុំ ចុះបញ្ជី ហើយ អាច សម្គាល់ នូវ ប្រភព ដើម នៃ ទំនិញ ឬ សេវា ឬ សម្គាល់ នូវ ចរិត លក្ខណៈ រួម ដទៃ ទៀត គិត ទាំង គុណភាព នៃ ទំនិញ ឬ សេវា របស់ សហគ្រាស ផ្សេង ៗ គ្នា ដែល ប្រើ សញ្ញា នោះ ក្រោម ការគ្រប់គ្រង របស់ ម្ចាស់ ម៉ាក សមូហភាព ដែល បាន ចុះបញ្ជី ។
គួរ បញ្ជាក់ ថា អ្នកលក់ អំបុក នៅក្នុង ឃុំ សានគរ មាន ប្រាំ ភូមិ ដែល មាន ចំនួន ៩៨ គ្រួសារ ក្នុង នោះ ភូមិសានគរ ខ ចំនួន ៤០ គ្រួសារ . ភូមិ ក្បិល មាន ចំនួន ១៨ គ្រួសារ . ភូមិ សំពៅ មាស មាន ចំនួន ៧ គ្រួសារ ភូមិ ក្រសាំង ក ចំនួន ១៣គ្រួសារ និង ភូមិ ក្រសាំង ខ ចំនួន ២០ គ្រួសារ ៕ មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង សុខាភិបាល ធ្វើបាឋ កថា បញ្ជាក់ ពី ស្ថានភាព បច្ចុប្បន្ន នៃ ករណី វីរុស កូរ៉ូណា ថ្មី ដើម្បី លើកកម្ពស់ ការយល់ដឹង វិធានការ បង្ការ ការឆ្លង វីរុស
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ នៃ ក្រសួង សុខាភិបាល នៅ ម៉ោង ២៖៣០ នាទី រសៀល ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ នឹង ធ្វើបាឋ កថា ស្តីពី ស្ថានភាព បច្ចុប្បន្ន នៃ ករណី វីរុស កូរ៉ូណា ថ្មី (2019-ncov) ដើម្បី លើកកម្ពស់ ការយល់ដឹង វិធានការ បង្ការ ការឆ្លង វីរុស កូរ៉ូណា ថ្មី នៅ វិទ្យាស្ថាន បច្ចេកវិទ្យា កម្ពុជា ( សាលា តិច ណូ) ។
បាឋ កថា នេះ រៀចំឡើង ដោយ ក្រសួង អប់រំ យុវជន និង កីឡា ក្នុង គោលបំណង ដើម្បី ចែករំលែក ព័ត៌មាន អំពី បច្ចុប្បន្នភាព នៃ ករណី វីរុស កូរ៉ូណា ថ្មី និង វិធានការ ការពារ ការឆ្លង វីរុស នេះ ៕
វៀតណាម សម្រេច ផ្អាក រាល់ ជើងហោះហើរ ទាំងអស់ ជាមួយ បណ្តា តំបន់ នៅ ប្រទេស ចិន ដែល រង ការវាយលុក ខ្លាំង ពី វីរុស កូរ៉ូណា
( ហាណូយ ) ៖ អាជ្ញាធរ អាកាសចរណ៍ ស៊ីវិល នៃ ប្រទេស វៀតណាម កាលពី ថ្ងៃពុធ សប្តាហ៍ នេះ បាន សម្រេច ផ្អាក រាល់ ជើងហោះហើរ ទាំងអស់ ដែល ឆ្ពោះទៅ និង មកពី បណ្តា តំបន់ ដែល រង ការវាយប្រហារ ខ្លាំង ដោយសារ វីរុស កូរ៉ូណា ប្រភេទ ថ្មី នៅ ប្រទេស ចិន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន VN Express នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី៣០ ខែមករា ឆ្នាំ ២០២០ ។
ក្រៅពី ការផ្អាក ជើងហោះហើរ ជាមួយ បណ្តា តំបន់ រង ការវាយប្រហារ ដោយ វីរុស នៅ ចិន អាជ្ញាធរ អាកាសចរណ៍ ស៊ីវិល វៀតណាម កំពុងតែ បន្ត ការត្រួតពិនិត្យ អ្នកដំណើរ នានា ដែល ចូលមកដល់ ប្រទេស វៀតណាម ។ ករណី អ្នក ផ្ទុក វីរុស កូរ៉ូណា ប្រភេទ ថ្មី (2019-nCoV) នៅ វៀតណាម នៅ មិន ទាន់ មាន ការកើនឡើង នោះ ឡើយ គឺ នៅ ០២ ករណី ដដែល ហើយ សុទ្ធតែ ជា ជនជាតិ ចិន ពុំ មាន ជនជាតិ វៀតណាម ណា ម្នាក់ បាន ឆ្លង ទេ ។
តួលេខ ខាងលើ នេះ គិត ត្រឹម ម៉ោង ១៤៖០០ នាទី រសៀល ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០៕ កម្លាំង ចម្រុះ ចុះ ត្រួតពិនិត្យ និង បិទ រោង សិប្បកម្ម កែច្នៃ ឈើ មួយចំនួន នៅ ក្រុង ស្ទឹងត្រែង ដែល មិន ទាន់ ទៅ ធ្វើ ច្បាប់ អាជីវកម្ម
( ស្ទឹងត្រែង ) ៖ ចាប់តាំង ថ្ងៃទី ២៨ - ២៩ ខែមករា ឆ្នាំ ២០២០ កម្លាំង ចម្រុះ ខេត្ត ស្ទឹងត្រែង ក្រោម ការដឹកនាំ ពី តំណាង អយ្យការ បាន ចុះ តាម រោង សិប្បកម្ម កែច្នៃ ឈើ មួយចំនួន នៅក្នុង ក្រុង ស្ទឹងត្រែង ដែល រោង សិប្បកម្ម ទាំងនោះ មិន ទាន់ បាន ធ្វើ លិខិតស្នាម ឲ្យបាន ត្រឹមត្រូវ ដើម្បី ធ្វើ អាជីវកម្ម នៅឡើយ ទេ ។
ប្រតិបត្តិការ ខាងលើ លោក ឧត្តមសេនីយ៍ ត្រី អៀង វ៉ាន់ ឌី មេបញ្ជាការ អាវុធហត្ថ ខេត្ត និង ជា ប្រធាន ក្រុម បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ ផល អនុផល ព្រៃឈើ ថ្នាក់ ខេត្ត បាន ដឹកនាំ កម្លាំង ដោយ ផ្ទាល់ រួមទាំង កម្លាំង អធិការ នគរបាល ក្រុង កម្លាំង បរិស្ថាន និង ជំនាញ រដ្ឋបាល ព្រៃឈើ ផងដែរ បាន ចុះ ត្រួតពិនិត្យ តាម រោង សិប្បកម្ម បាន ចំនួន ២កន្លែង និង ផ្ទះ មួយ កន្លែង ឈ្មោះ « ចែពៅ » ដែល ជា កន្លែង ស្តុក ឈើ សម្រាប់ នាំចេញ យកមក លក់ ឲ្យ រោង សិប្បកម្ម ផ្សេង ៗ នៅក្នុង ខេត្ត ។
លោក ឧត្តមសេនីយ៍ បាន ឲ្យដឹង ថា ក្នុង នាម ប្រធាន គណ:កម្មាធិការ បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ ព្រៃឈើ ថ្នាក់ ខេត្ត លោក នឹង បន្ត ដឹកនាំ កម្លាំង ចម្រុះ ចុះ ត្រួតពិនិត្យ ជា បន្តបន្ទាប់ ទៀត តាម រោង សិប្បកម្ម នានា ដែល សង្ស័យ ថា មិន មាន ច្បាប់ អនុញ្ញាត ។ ករណី បង្ក្រាប នេះ ដែរ លោក នឹង រក ឲ្យ ឃើញ ចំពោះ មូលហេតុ ដែល ម្ចាស់ សិប្បកម្ម កែច្នៃ ឈើ ទាំងនោះ មិន ព្រម ទៅ ធ្វើ ច្បាប់ ជាពិសេស លោក ឧត្តមសេនីយ៍ បាន ជំរុញ ឲ្យ ជំនាញ រដ្ឋបាល ព្រៃឈើ ធ្វើ កំណត់ហេតុ ឲ្យបាន ច្បាស់លាស់ ដើម្បី បន្ត នីតិវិធី ទៅកាន់ តុលាការ ។
ករណី ចុះ ត្រួតពិនិត្យ តាម រោង សិប្បកម្ម កែច្នៃ ឈើ នេះ គឺជា លើក ទី ពីរ ហើយ បន្ទាប់ពី យុទ្ធា ការក្តៅ លើក ទី មួយ កាលពី ឆ្នាំ ២០១៩ កន្លងទៅ ថ្មី ៗ ។
បន្ទាប់ពី យុទ្ធ ការក្តៅ លើក ទី មួយ កាលពី ឆ្នាំ ២០១៩ បាន បញ្ចប់ ទៅ សិប្បកម្ម កែច្នៃ ឈើ លួច លាក់ ជាច្រើន កន្លែង ត្រូវបាន កក្រើក ឡើងវិញ ខ្លះ លួច ពួន ធ្វើ ក្នុង ព្រៃ ខ្លះ នៅ កន្លៃង ស្ងាត់ ដើម្បី បិត បាំង ភ្នែក សមត្ថកិច្ច ដែល សិប្បកម្ម ទាំងនោះ កែច្នៃ ជា ទ្វារ បង្អួច តុ កៅអី និង គ្រែ ជាដើម តាម ការកាម៉ង់ បញ្ជាទិញ ពី ក្រុម ឈ្មួញ ។
សូម រំលឹក ថា ការចុះ ត្រួតពិនិត្យ តាម រោង សិប្បកម្ម កែច្នៃ ឈើ លើក នេះ គឺជា កន្លែង ចាស់ ដ៏ ដែល ៗ បាន ចុះបង្ក្រាប កាលពី លើក មុន ប៉ុន្តែ ពួកគាត់ នៅតែ មិន រៀង ចាល នៅតែ លួច ធ្វើ ដ៏ ដែល ៕
មន្ត្រី សុខាភិបាល និង អាជ្ញាធរ ចុះ ផ្សព្វផ្សាយ និង ចែក ម៉ាស់ ជូន ប្រជាពលរដ្ឋ រស់ នៅ តាម ព្រំដែន ចូលរួម ការពារ ជំងឺ រលាក សួត ថ្មី « កូរ៉ូណា » នៅ ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ
( ព្រះវិហារ ) ៖ មន្ត្រី នៃ មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ សហការ ជាមួយ អាជ្ញាធរ ស្រុក ជាំ ក្សាន្ត រយៈពេល ពេញ មួយ ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២០ បាន ចុះ ផ្សព្វផ្សាយ អប់រំ ប្រជាពលរដ្ឋ នៅ តាម មណ្ឌល សុខភាព នានា និង តាម ទីប្រជុំជន ក៏ ដូចជា អាជីវករ លក់ដូរ នៅ ច្រក អាន សេះ ឲ្យ ពួកគាត់ បាន យល់ ជ្រួតជ្រាប អី ជំងឺ រលាក សួត ថ្មី « កូរ៉ូណា វីរុស » ដើម្បី ជា ចំណេះដឹង មួយ សម្រាប់ អោយ ពួកគាត់ មាន វិធានការ ការពារ ។
មន្ត្រី នៃ មន្ទីរ សុខាភិបាល ខេត្ត ព្រះវិហារ បាន ថ្លែង ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ នេះ ថា យុទ្ធនាការ ចុះអប់រំ ផ្សព្វផ្សាយ និង ចែក ម៉ាស់ ការពារ ជំងឺ « កូរ៉ូណា វីរុស » នេះ ធ្វើឡើង ក្រោម បទបញ្ជា របស់ លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ ហើយ យុទ្ធនាការ នេះ សំដៅ ទៅ លើ ប្រជាពលរដ្ឋ រស់ នៅ តាម ព្រំដែន ដូចជា ព្រំដែន ច្រក អាន សេះ ក្នុង ស្រុក ជាំ ក្សាន្ត និង ព្រំដែន ឡាវ ស្រុក ឆែប ។
មន្ត្រី សុខាភិបាល ខេត្ត ព្រះវិហារ បាន ថ្លែង ឲ្យដឹង ទៀត ថា ការចុះអប់រំ ផ្សព្វផ្សាយ នៅក្នុង ឱកាស នោះ ផ្តោត សំខាន់ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ យើង ត្រូវ ចេះ ថែរក្សា សុខភាព អនាម យ័ក្នុង ការរស់នៅ ឲ្យបាន ល្អ ត្រូវ មាន ការប្រុងប្រយត្ន័ ពាក់ ម៉ាស់ ជាប់ ជានិច្ច រាល់ ពេល ឆ្លង ដែន ក៏ ដូចជា នៅ តាម ទីប្រជុំ ជន ផ្សេង ៗ ផងដែរ ។
នៅក្នុង ឱកាស នោះ ដែរ ម៉ាស់ ជិត ១០០០ម៉ាស់ ត្រូវបាន ចែកជូន បងប្អូន ប្រជាពលរដ្ឋ ក៏ ដូចជា បងប្អូន អាជីវករ ផងដែរ ៕ វេសឡាញ ចេញ វិធានការកាពារ សិស្ស ពី ជំងឺ រលាក សួត ដែល បង្ក ដោយ វីរ៉ុស កូរ៉ូណា តាម ការអំពាវនាវ របស់ ក្រសួង អប់រំ
( ភ្នំពេញ ) ៖ តប តាម សេចក្តីណែនាំ ក៏ ដូចជា ការអំពាវនាវ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា ក្រុមហ៊ុន វេសឡាញ អេឌ្យូ ខេ សិន គ្រុប បាន ចេញ វិធានការ មួយចំនួន ក្នុង ការកាពារ សិស្ស របស់ ខ្លួន ពី ជំងឺ រលាក សួត ដែល បង្ក ដោយ វីរ៉ុស កូរ៉ូណា ប្រភេទ ថ្មី ។
ដើម្បី ចូលរួម ទប់ស្កាត់ ការរាលដាល នៃ វីរ៉ុស កូរ៉ូណា នេះ វេសឡាញ បាន ចេញ សេចក្តីជូនដំណឹង មួយ ឲ្យ គ្រប់ សាខា អនុវត្តន៍ ដូច ខាងក្រោម៖
លោក គង់ សំនៀង ប្រធាន នាយក ប្រតិបត្តិ វេសឡាញ អេឌ្យូ ខេ សិន គ្រុប បាន ថ្លែង ផ្តាំង ផ្ញើ ទៅ អាណាព្យាបាល សិស្ស ថា កុំ មាន ការព្រួយបារម្ភ ខ្លាំង ពេក ពី បញ្ហា ការរីករាលដាល នៃ ជំងឺ ថ្មី នេះ ។ លោក ថ្លែង ថា ប្រសិនបើ យើង បាន ចូលរួម រក្សា អនាម័យ ល្អ ហើយ ព្រមទាំង មាន ការយកចិត្តទុកដាក់ ពី សាលា ផង សូម បញ្ជូន កូន ទៅ សាលារៀន ជាធម្មតា ដើម្បី កុំ ឲ្យ មាន ការប៉ះពាល់ ដល់ ការសិក្សា របស់ ពួកគាត់ ។
បន្ថែម លើ សេចក្តីជូនដំណឹង នេះ លោក គង់ សំនៀង បាន ថ្លែង ទៀត ថា សំខាន់ ត្រូវ លាង ដៃ សិស្ស គ្រប់ គ្នា នឹង សាប៊ូ កម្ចាត់ មេរោគ ឬ អាកុល វាស់ កម្តៅ រាល់ ថ្ងៃ លើ សិស្ស គ្រប់ រូប គ្រប់ ពេល ចូល សាលារៀន ទិញ ម៉ាស់ ទុក សម្រាប់ សិស្ស ដែល មាន អាការៈ មិន ស្រួល ហើយ ហៅ អាណាព្យាបាល មក យក ទៅ ផ្ទះ វិញ ។ សម្រាប់ គ្រប់ បន្ទប់ រៀន ទាំងអស់ ដែល មាន បង្អូច យើង នឹង ឲ្យ គាត់ បិទ ម៉ាស៉ីន ត្រជាក់ បើកបង្អួច ឲ្យ មាន ពន្លឺ និង កម្តៅ ចូល ខ្លះ ដើម្បីឲ្យ មាន លំហូរ ខ្យល់ ចេញ និង ចូលល្អ ។
សូម បញ្ជាក់ ថា បន្ទាប់ពី ក្រសួង អប់រំ យុវជន និង កីឡា ចេញ សេចក្ដីណែនាំ ស្ដីពី ការអនុវត្ត វិធានការ បង្ការ ជំងឺ រលាក សួត ដោយ វីរុស កូរ៉ូណា ថ្មី រួច មក . នៅ ថ្ងៃទី ២៨ ខែមករា ឆ្នាំ ២០២០ នៅ គ្រឹះស្ថាន សិក្សា សាធារណៈ និង ឯកជន នានា បាន ចូលរួម ធ្វើ សកម្មភាព ទប់ស្កាត់ ការឆ្លង វីរុស នេះ នៅ តាម គ្រឹះស្ថាន សិក្សា របស់ ខ្លួន ដោយ លើកទឹកចិត្ត ឲ្យ បុគ្គលិក និង សិស្សានុសិស្ស ពាក់ ម៉ាស ការពារ ជាប្រចាំ មាន ការវាស់ស្ទង់ សីតុណ្ហភាព ក្នុង ខ្លួន មុនពេល ចូលរៀន ជាដើម ។
ទោះជា យ៉ាង នេះ ក្តី រហូតដល់ មកដល់ ពេលនេះ ស្ថានភាព ជនជាតិ ចិន ដែល ផ្ទុក ជំងឺ ផ្លូវ ដង្ហើម ថ្មី ហើយ ដាក់ ឲ្យ សម្រាក នៅ បន្ទប់ ដាច់ដោយឡែក នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រះសីហនុ នោះ កំពុង មាន សុខភាព ល្អ ធម្មតា និង កាន់តែ ប្រសើរ ជាង មុន ដោយ មិន មាន អ្វី ធ្ងន់ធ្ងរ គួរឲ្យ កត់សម្គាល់ នោះ ឡើយ ខណៈ ដែល ក្រុមគ្រួសារ របស់ គាត់ ទាំង ៣នាក់ ពុំ មាន រោគសញ្ញា នៃ មេរោគ កូរ៉ូណា នោះ ទេ ៕
សិង្ហបុរី ដឹក ពលរដ្ឋ ខ្លួន ជិត ១០០ នាក់ ត្រឡប់ មកពី វូហាន វិញ និង ធ្វើ ការពិនិត្យ សុខភាព ពួកគេ នៅ ព្រលានយន្តហោះ តែម្តង
តួលេខ ខាងលើ នេះ គិត ត្រឹម ម៉ោង ១២៖៣០ នាទី រសៀល ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០ ៕ អភិបាល រាជធានី ភ្នំពេញ ណែនាំ ឲ្យ លោកគ្រូ អ្នកគ្រូ ជួយ អប់រំ សិស្សានុសិស្ស ឲ្យ យល់ ពី គុណ តម្លៃ នៃ សន្តិភាព
( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ បាន ណែនាំឲ្យ លោកគ្រូ អ្នកគ្រូ ជួយ អប់រំ សិស្សានុសិស្ស ឲ្យ យល់ ពី គុណ តម្លៃ នៃ សន្តិភាព ដើម្បី ជា មូលដ្ឋានគ្រឹះ នៃ ការស្រលាញ់ សន្តិភាព ហើយ រួមគ្នា ការពារ សន្តិភាព ឲ្យបាន គង់វង្ស ដែល មិន ឲ្យ អ្នក មក បំផ្លាញ បាន ឡើយ ។
លោក បាន បញ្ជាក់ ថា ការអប់រំ សិស្សានុសិស្ស និង សង្គម ឲ្យ ស្រលាញ់ សន្តិភាព គឺ ធានា ឲ្យ កម្ពុជា នៅតែ រក្សា បាន សុខ សន្តិភាព ប្រទេសជាតិ និង ប្រជាពលរដ្ឋ មាន អ្វី ៗ ទាំងអស់ ហើយ ទោះ ក្នុង រូបភាព ណា ក៏ដោយ មិន អោយ ជន អគតិ ណាមួយ មក បំភ្លេច បំផ្លាញ សុខ សន្តិភាព នេះ បាន ឡើយ ខណៈ ដែល សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្ដី នៃ កម្ពុជា បាន កសាង សុខ សន្តិភាព ជូន កម្ពុជា មកដល់ ពេលនេះ បាន ដោយ លំបាក ណាស់ ។
លោក ឃួង ស្រេង ក៏ បាន ណែនាំ ដល់ លោកគ្រូ អ្នកគ្រូ ទំាង អស់ ត្រូវ បង្កើន គុណភាព អប់រំ ដល់ សិស្សានុសិស្ស ដើម្បីឲ្យ ពួកគេ មាន សមត្ថភាព ពេញលេញ ក្លាយជា ធនធាន មនុស្ស ពិតប្រាកដ ដើម្បី សម្រាប់ ការអភិវឌ្ឍ ប្រទេសជាតិ ផង និង អភិវឌ្ឍន៍ អនាគត របស់ ខ្លួន ផង ។
លោក ហែម ស៊ីណារ៉េត ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា រាជធានី ភ្នំពេញ បាន ថ្លែង ថា មន្រ្តី គ្រប់គ្រង លោកគ្រូ អ្នកគ្រូ នៅ ទូទំាង រាជធានី ភ្នំពេញ បាន បំពេញ ការងារ តួនាទី រៀង ៗ ខ្លួន ប្រកបដោយ មនសិកា វិជ្ជាជីវៈ គ្រូបង្រៀន ដើម្បី ធានា ឲ្យ ការអប់រំ ប្រកបដោយ គុណភាព សមធម៌ បរិយា បន្ន និង លើកកម្ពស់ ឱកាស នៃ ការសិក្សា ពេញ មួយ ជីវិត សម្រាប់ ទំាង អស់ គ្នា ទាំង ក្នុង ប្រព័ន្ធ និង ក្រៅ ប្រព័ន្ធ ។
សូម ជម្រាប ថា នៅ រាជធានី ភ្នំពេញ មាន គ្រឹះស្ថាន សិក្សា សាធារណៈ របស់ រដ្ឋ ដូចជា សាលា បឋមសិក្សា ចំនួន ១៦៤ ទីតាំង អនុវិទ្យាល័យ វិទ្យាល័យ មាន ចំនួន ៦៨ សាលា និង សាលាម តេយ្យ សិក្សា ម តេ្តយ្យ សហគមន៍ មាន ១៥៨ ទីតាំង ដោយ រដ្ឋ និង ឯកជន សរុប ទាំងអស់ មាន ជាង ៣០ម៉ឺន នាក់ ៕ ភរិយា លោក ជា ចាន់តូ អញ្ជើញ ចុះ ត្រួតពិនិត្យ សំណង់ អគារ សាលា ពុទ្ធិក សិក្សា
( កំពង់ធំ )៖ លោកស្រី ខៀវ ស៊ីណា ជា ចាន់ តូ អនុប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ធំ បាន អញ្ជើញ ទៅ ចុះ ត្រួតពិនិត្យ លើ ការកសាង អគារ ពុទ្ធិក សិក្សា សម្រាប់ ឲ្យ ព្រះសង្ឃ សិក្សា រៀនសូត្រ ។
លោកស្រី ខៀវ ស៊ីណា ជា ចាន់ តូ ក៏ បាន លើកឡើង ថា ការកសាង អគារ សមរម្យ សម្រាប់ ឲ្យ ព្រះសង្ឃ សិក្សា រៀនសូត្រ គឺជា កិច្ចការ ដែល ប្រជាពលរដ្ឋ គ្រប់ រូប ៗ ពិសេស ពុទ្ធសាសនិជន ខ្មែរ ត្រូវ ខិតខំ រួមគ្នា រៀបចំ កសាងឡើង ព្រោះ កន្លែង នេះ មិន គ្រាន់តែ ផ្ដល់ នូវ ចំណេះដឹង សម្រាប់ តែ ព្រះសង្ឃ ទេ ប៉ុន្តែ កន្លែង នេះ ក៏ មាន តួនាទី ដ៏ សំខាន់ នៅក្នុង ការរួមចំណែ ជួយ បណ្ដុះបណ្ដាល សិស្ស មក រៀនសូត្រ ជាមួយ ព្រះសង្ឃ ផងដែរ ។
លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ បាន ឲ្យដឹង ថា ក្នុង សង្គម បច្ចុប្បន្ន ការរៀនសូត្រ មិន ថា ប្រជាពលរដ្ឋ ទូទៅ ឬ ព្រះសង្ឃ ទេ គឺ ត្រូវ មាន ការសិក្សា រៀនសូត្រ ឲ្យបាន ចំណេះ ខ្ពស់ ដើម្បី លើកស្ទួយ វិស័យ សាសនា និង សម្រាប់ ចូលរួម អភិវឌ្ឍ សង្គមជាតិ ។
លោកស្រី បន្ដ ថា ដូចនេះ ចាំបាច់ ត្រូវ រួម សាមគ្គី គ្នា ជួយ កសាង ទាំង កន្លែង រៀន និង កន្លែង ស្នាក់ របស់ ព្រះសង្ឃ ឲ្យបាន សមរម្យ ដើម្បីឲ្យ ព្រះសង្ឃ មាន ឱកាស និង មាន លទ្ធភាព បាន បន្ត ការសិក្សា រៀនសូត្រ ទាំង ធ៌ម វិន័យ បាលី សំស្គ្រឹត និង ចំណេះដឹង ទូទៅ តាម បំណងប្រាថ្នា ។ មួយ ចំណែក ទៀត បើក សាង សាលា ពុទ្ធិកៈ បាន ច្រើន នៅ បណ្ដា វត្ត តាម ឃុំ ស្រុក និង តំបន់ ដាច់ ប្រយាល នោះ ក៏ បាន ជួយ សម្រួល ដល់ ការនិមន្ត ទៅ រៀន ឆ្ងាយ របស់ ព្រះសង្ឃ ផងដែរ ។
លោក ឯក ប្រុស អ្នកទទួល ការងារ សាងសង់ សំណង់ ឲ្យដឹង ថា ទាំង សំណង់ សាលា ពុទ្ធិកៈ និង កុដិ ដែល កំពុង កសាង នេះ ជា សមិទ្ធផល កើត ចេញ ពី ទឹកចិត្ត ប្រកបដោយ សុទ្ធា ជ្រះថ្លា រ ចំពោះ វិស័យ ព្រះពុទ្ធ សាសនា របស់ លោក ជា ចាន់តូ និង លោកស្រី ក្នុង នោះ កុដិថ្មី ១ ខ្នង ៥ បន្ទប់ ស្ថិត នៅ វត្ត ក្រយា ឃុំ ក្រយា និង កសាងឡើង នៅ ខែមករា ឆ្នាំ ២០២០ មាន ទំហំ ៨ម៉ែត្រ គុណ៣០ ម៉ែត្រ និង សម្រេចបាន ៣០ ភាគរយ ហើយ ។
លោក បាន បន្ដ ថា ដោយឡែក សាលា ពុទ្ធិកៈ សិក្សា ស្ថិត ក្នុង វត្ត ធម្មនា ថ ក្នុង ឃុំ តាំង ក្រសាំង បាន ចាប់ផ្ដើម កសាង នៅ ខែមិថុនា ឆ្នាំ ២០១៩ មាន ទំហំ ២០ម៉ែត្រ គុណ ១៣ម៉ែត្រ ស្មើ៣ បន្ទប់ គិត ដល់ ពេលនេះ សម្រេចបាន ៧០% ។
ក្នុង ឱកាស នោះ លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ បាន សម្រេច ជួយ ជួសជុល កែលម្អ រ ព្រះវិហារ បុរាណ ដែល មាន អាយុកាល ជាង ១០៣ ឆ្នាំ ចាត់ទុក ជា ព្រះវិហារ៍ ដ៏ ចំណាស់ មួយ ផងដែរ ស្ថិត នៅ វត្ត បារាយ ណ៏ ជាន់ ដែក ក្នុង ភូមិ រាបាយ ណ៏ ជាន់ ដែក ឃុំ បល ង្ក័ ស្រុក បារាយណ៍ ។
