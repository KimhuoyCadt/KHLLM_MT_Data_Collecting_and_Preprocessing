( កំពង់ចាម ) ៖ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី កម្ពុជា នៅ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ នេះ បាន សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ ផ្លូវ លំ ក្រាល គ្រួស ក្រហម ចំនួន ៦គីឡូម៉ែត្រ ស្ថិត នៅក្នុង ឃុំត្រពាំង គរ ស្រុក ជើង ព្រៃ ខេត្ដ កំពង់ចាម ដែល មាន ប្រជាពលរដ្ន ចូលរួម ប្រមាណ ជិត ៤ពាន់ នាក់ ។
ការជួសជុស ផ្លូវ ជូន ប្រជាពលរដ្ឋ នេះ គឺ ដើម្បី បន្ដ ការអភិវឌ្ឍ ភូមិ ឃុំ ក៏ ដូចជា ផ្ដល់ ភាពងាយស្រួល ដល់ ប្រជាពលរដ្ឋ ក្នុង ការធ្វើដំណើរ និង ដឹក កសិផល ដែល ប្រមូល ផល រួច យក ទៅ លក់ នៅ តាម ទីផ្សារ ឱ្យ កាន់តែ បាន ល្អ ប្រសើរឡើង មួយ កម្រិត ទៀត ។
ជាពិសេស ក្រុមការងារ យុវជន ស្រុក ជើង ព្រៃ ដឹកនាំ ដោយ លោក បណ្ឌិត ម៉ឹង មករា តំណាង លោក បណ្ឌិត ហ៊ុន ម៉ាណែត បាន បំពេញ គ្រប់ តម្រូវការ របស់ ប្រជាពលរដ្ឋ ជា បន្ដ បន្ទាប់ មិន ថា ផ្លូវថ្នល់ ទឹក ប្រើប្រាស់ និង ជួយ សម្រាល ការលំបាក របស់ ពលរដ្ឋ ភ្លាម ៗ ពេល ជួប នូវ គ្រោះមហន្ដរាយ នានា ដូចជា កង្វះ ទឹក ទឹក ជំនន់ និង ខ្យល់ កន្ដ្រាក់ នានា ។
លើស ពី នោះ ដើម្បី ចូលរួម ការពារ និង លើកកម្ពស់ សោភណ្ឌភាព បរិស្ថាន នៅ តាម ដងផ្លូវ ក្រុមការងារ យុវជន ស្រុក ជើង ព្រៃ ដែល ដឹកនាំ ដោយ លោក បណ្ឌិត ម៉ឹង មករា បាន ដាំ ដើម ក្ងោក អម តាម សងខាង ផ្លូវ នេះ ឱ្យ មាន ភាពស្រស់ស្អាត ជាមួយ ធម្មជាតិ ពណ៌ បៃតង និង ផ្កា ក្រហម ឆ្អិនឆ្អៅ ជាពិសេស ជួយ កាត់បន្ថយ កំដៅ ពេល ប្រជាពលរដ្ឋ ធ្វើដំណើ តាម ផ្លូវ ផងដែរ ។
ជាង នេះ ទៅ ទៀត « ការដាំ ដើមឈើ នេះ នឹង ចូលរួមចំណែក ក្នុង ការថែរក្សា បរិស្ថាន និង ចូលរួម បំផុស នូវ ការស្រលាញ់ ធម្មជាតិ ហើយ យើង នឹង បន្ដ អភិវឌ្ឍ ភូមិ ឃុំ នៅក្នុង ស្រុក ជើង ព្រៃ ឱ្យ កាន់តែ មាន ភាពល្អ ប្រសើរ បន្ថែម ទៀត ដោយ ធ្វើ យ៉ាងណា ជួយ លើកកម្ពស់ កម្រិត ជីវភាព របស់ ពលរដ្ឋ យើង ឱ្យ កាន់តែ បាន ធូរធារ » ។ នេះ បើ តាម ការបញ្ជាក់ របស់ លោក បណ្ឌិត ម៉ឹង មករា ។
សូម ជម្រាប ថា ការជួសជុល និង ពង្រីក ផ្លូវ ក្រាល គ្រួស ក្រហម ប្រវែង ៦.០០០ ម៉ែត្រ នៅលើ ផ្លូវ ចាស់ មាន ទទឹង ៣.៥ម៉ែត្រ មាន សភាព តូច ចង្អៀត និង លិច ទឹក នៅ រដូវ វស្សា ឥឡូវនេះ ត្រូវបាន ពង្រីក ទទឹង ៦ម៉ែត្រ ព្រមទាំង លើកកម្ពស់ តួរ ផ្លូវ និង ដាក់ លូកាត់ ទទឹង ផ្លូវ បាន ចំនួន ១២កន្លែង ។
សម្រាប់ ផ្លូវ នេះ ប្រជាជន ចំនួន ៥ភូមិ ( ភូមិ ពង្រ ភូមិ ប្រតេន ភូមិ ទម្ពរ ភូមិ ត្នោត បាក់ និង ភូមិ អរក្ស ) សរុប ប្រមាណ ៧០០ គ្រួសារ និង ពលរដ្ឋ ផ្សេង ទៀត ឆ្លងកាត់ នឹង ទទួលបាន ទាំង ភាពងាយស្រួល ក្នុង ការធ្វើដំណើរ និង ដឹក ដំណាំ កសិផលប្រចាំ ថ្ងៃ ផងដែរ ៕
រកឃើញ សាកសព ជនជាតិ ចិន ពីរ នាក់ នៅជិត កន្លែង យន្តហោះ អាមេរិក ធ្លាក់ កាលពី ឆ្នាំ ១៩៧៣ នៅ ប្រទេស អ៉ី ស្លង់
បើ តាម ការពិនិត្យភាព ជាក់ស្តែង ករណី ស្លាប់ របស់ ជនជាតិ ចិន ជា ភ្ញៀវ ទេសចរ ទាំង ពីរ នាក់ នេះ គឺ ទំនងជា មិន មែន ករណី ឃាតកម្ម នោះ ឡើយ ។ ប៉ូលិស បាន រកឃើញ សាកសព ស្ត្រី នៅក្បែរ ខ្មោច យន្តហោះ ខណៈ សាកសព បុរស វិញ ត្រូវបាន គេ រកឃើញ នៅ ឆ្ងាយ ពី នោះ បន្តិច ដោយ ពួកគេ ប្រហែលជា បាន រង អការៈ បាត់បង់ កម្តៅ ក្នុង ខ្លួន និង ព្យាយាម ស្វែងរការ ជួយសង្គ្រោះ ។ បច្ចុប្បន្ន អាជ្ញាធរ អ៉ី ស្លង់ កំពុង សហការ ជាមួយ ស្ថានទូត ចិន ដើម្បី ស៊ើបអង្កេត លើ រឿង នេះ ។
គួរ បញ្ជាក់ ថា ខ្មោច យន្តហោះ ខាងលើ នេះ គឺជា កម្មសិទ្ធិ របស់ កងទ័ព សហរដ្ឋ អាមេរិក ដែល បាន ធ្លាក់ នៅ ទីនោះ កាលពី ឆ្នាំ ១៩៧៣ ប៉ុន្តែ វា មិន បាន បង្កឲ្យ នរណា ម្នាក់ ស្លាប់ នោះ ឡើយ ។ ដោយសារតែ អាកាសធាតុ នៅ ទីនោះ មាន ការប្រែប្រួល និង ធ្លាក់ ព្រិល ខ្លាំង ទើប នាំឲ្យ គេ ពិបាក ក្នុង ការយក យន្តហោះ ចេញ ហើយ នៅ ទីបំផុត វា បាន ក្លាយជា ទីកន្លែង កម្សាន្ត មួយ ដ៏ ល្បី តែម្តង ៕
មេប បញ្ជាការ អាវុធហត្ថ រាជធានី ភ្នំពេញ បង្ហាញ នូវ ការយកចិត្តទុកដាក់ ចំពោះ សមាជិក ក្រោម ឱវាទ យ៉ាង កក់ក្តៅ !
ក្នុង ឱកាស សួរសុខទុក្ខ នោះ ផងដែរ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន បង្ហាញ នូវ ក្តី ព្រួយបារម្ភ ជាខ្លាំង ចំពោះ សុខភាព លោក វរសេនីយ៍ ទោ អៀង សាក់ឡូ និង បាន យកចិត្តទុកដាក់ លើកទឹកចិត្ត អ្នក ជម្ងឺ ឲ្យ នៅ សម្រាក ព្យាបាល រហូតដល់ បាន ធូរស្បើយ មាន កម្លាំង ឡើងវិញ ចាំ ចូល បម្រើ ការងារ ជូន អង្គភាព រីឯ ថ្លៃ ចំណាយ លើ សេវា ព្យាបាល អង្គភាព នឹង ទទួលខុសត្រូវ ធានារ៉ាប់រង ៕ ក្រុម អ្នកវិទ្យាសាស្ត្រ រកឃើញ វិធី ថ្មី មួយ ដែល អាច បង្កើត អុកស៊ីហ្សែន ចេញ ពី ធូលី ព្រះច័ន្ទ !
គួរ បញ្ជាក់ ថា ការពិសោធន៍ របស់ ក្រុម អ្នកវិទ្យាសាស្ត្រ ខាងលើ នេះ គឺ បាន ប្រើប្រាស់ សារធាតុ គំរូ ដែល ដូច ហ្នឹង ធូលី ព្រះច័ន្ទ ប៉ុណ្ណោះ ដោយ ពួកគេ មិន ទាន់ មាន ឱកាស ក្នុង ការពិសោធន៍ ធូលី យក ពី ព្រះច័ន្ទ ពិត ៗ នោះ ឡើយ ។ ក្រុម អ្នកវិទ្យាសាស្ត្រ របស់ ESA ក៏ មាន គំរោង ក្នុង ការរចនា រោងចក្រ សាកល្បង ដែល អាច បញ្ជូន ទៅ ដាក់ ឲ្យ ដំណើរការ លើ ផ្ទៃ ព្រះច័ន្ទ នៅ ឆ្នាំ ២០២៥ ផងដែរ ៕ ព្រលឹង ចុង សក់ ! យន្តហោះ រុស្ស៊ី មាន គោលដៅ ទៅ វៀតណាម ត្រូវ ចុះចត វិញ យ៉ាង ទាន់ហន់ ដោយសារ ឆេះ ម៉ាស៊ីន មួយ ចំហៀង !
ពិធី ប្រកាស បើក ដំណើរ សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ នេះ នៅ ភោជនីយដ្ឋាន ទន្លេ បាសាក់២ និង ដោយ មាន ការចូលរួម ពី ក្រុម វេជ្ជបណ្ឌិត ជំនាញ ០៩ រូប ផងដែរ ។ សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា នេះ ដែរ បង្កើតឡើង ដោយ មាន ការគាំទ្រ និង ទទួលស្គាល់ ពី ក្រសួង សុខាភិបាល និង ក្រសួង មហាផ្ទៃ ផងដែរ ។
ពលរដ្ឋ នៅ ខេត្ត ឧត្តរមានជ័យ ប្រទះឃើញ គ្រាប់ យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ ចំនួន ១៨ គ្រាប់
( ឧត្តរមានជ័យ ) ៖ គ្រាប់ យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ ចំនួន ១៨គ្រាប់ ត្រូវបាន ប្រទះឃើញ នៅ ព្រឹក ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ នេះ ខណៈ ដែល កសិករ ម្នាក់ កំពុង ភ្ជួរ ដី ខាងត្បូង ភូមិ ពោធិ៍ ចាស់ ឃុំ បេង ស្រុក បន្ទាយ អំពិល ខេត្ត ឧត្តរមានជ័យ ។
មន្ត្រី នគរបាល ស្រុក បន្ទាយ អំពិល បាន ឲ្យដឹង ថា លោក ទួក រាំ ភេទ អាយុ ៤៣ ឆ្នាំ រស់ នៅ ភូមិ បេង ឃុំ បេង ស្រុក បន្ទាយ អំពិល បាន រាយការណ៍ មក សមត្ថកិច្ច ថា នៅ ពេល ដែល គាត់ កំពុង ភ្ជួរ ដី របស់ គាត់ ក៏ បាន ប្រទះឃើះ គ្រាប់ យុទ្ធភ័ណ្ឌ មិន ទាន់ ផ្ទុះ ជាច្រើន គ្រាប់ ។
ក្រោយ ទទួលបាន ដំណឹង នេះ ភ្លាម នាយ ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល បេង បាន ចុះ ទៅ ពិនិត្យ ឃើញ គ្រាប់ ទាំងអស់ សរុប ចំនួន ១៨គ្រាប់ រួម មាន៖ គ្រាប់ B40 ចំនួន ២គ្រាប់ គ្រាប់ មីន ប្រភេទ ៧២ A ចំនួន ១៥គ្រាប់ និង គ្រាប់ មីន ខ្លឹម ម៉រ ចំនួន ១គ្រាប់ ផងដែរ ។ លោក ថា គ្រាប់ ទាំងអស់ នោះ គឺ បាន បន្សល់ទុក តាំងពី សម័យ សង្គ្រាម មក ម្ល៉េះ ។
ក្រោយពី បាន ធ្វើ ការត្រួតពិនិត្យ រួចរាល់ សមត្ថកិច្ច បាន ទាក់ទង ទៅ អង្ក ការដោះ មីន កម្ពុជា ដើម្បី មក ទទួលយក ធ្វើ ការកំទេចចោល ៕
អភិបាល ខេត្ត កំពង់ចាម៖ ការកសាង ផ្លូវថ្នល់ ផ្ដល់ ប្រយោជន៍ ច្រើន យ៉ាង ជូន ដល់ ប្រជាពលរដ្ឋ
នេះ ជា ការលើកឡើង របស់ លោក អភិបាល ខេត្ត កាលពី ព្រឹក ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ ក្នុង ពិធី សម្ពោធ ផ្លូវ ក្រាល គ្រួស ក្រហម មួយ ខ្សែ មាន ប្រវែង ៦០០០ ម៉ែត្រ ស្ថិត ក្នុង ឃុំត្រពាំង គរ ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម ។
បើ តាម អភិបាល ស្រុក ជើង ព្រៃ លោក អួត ឈាង លី បាន ថ្លែង ឲ្យដឹង ថា ផ្លូវ នេះ បាន ចាប់ សាងសង់ កាលពី ថ្ងៃទី ២១ ខែមេសា ឆ្នាំ ២០១៩ នោះ គឺជា ការចាប់ផ្តើម ត្រាស់ សេទៅ តាម ក្រុម បច្ចេកទេស និង បាន បញ្ចប់ ការជួសជុល នៅ ថ្ងៃទី ៨ ខែកញ្ញា ឆ្នាំ ២០១៩ ជា ប្រភេទ ផ្លូវ ក្រាល គ្រួស ក្រហម មាន ប្រវែង ៦០០០ ម៉ែត្រ ។
លោក បន្ត ថា នេះ ជា កាយកចិត្តទុកដាក់ របស់ ក្រុម យុវជន ថ្នាក់ កណ្តាល ក្រុម ទី៨ បាន បញ្ជូន កូន ក្ងោក យកមក ដាំ តាម ដង ផ្លូវ ប្រវែង ៦០០០ ម៉ែត្រ កូន ក្ងោក ចំនួន ២០០០ កូន ផងដែរ ។
អភិបាល ខេត្ត កំពង់ចាម បាន ថ្លែង ក្នុង ឱកាស នោះ ថា ផ្លូវ មួយ ខ្សែ នេះ ត្រូវបាន កសាង និង ខូចខាត ច្រើន ដង មក ហើយ ដែល ធ្វើឲ្យ បងប្អូន ប្រជាពលរដ្ឋ នៅ តំបន់ នេះ មាន ការលំបាក ក្នុង ការធ្វើដំណើរ ឆ្លងកាត់ ម ឬ ក៏ ដឹកនាំ កសិផល យក ទៅ លក់ នៅ ទីផ្សារ ជាដើម ។
ប៉ុន្តែ ថ្ងៃ នេះ ផ្លូវ មួយ ខ្សែ នេះ បាន សាងសង់ រួចរាល់ និង សម្ពោធ ដាក់ ឲ្យ ដំណើរការជា ស្ថាពរ ហើយ បងប្អូន ប្រជាពលរដ្ឋ យើង ក៏ ចាប់ផ្ដើម មាន សង្ឃឹម ដោយសារតែ ផលប្រយោជន៍ របស់ ផ្លូវ នេះ មាន ដូចជា ដី ក្នុង តំបន់ នេះ អាចនឹង ឡើង ថ្លៃ និង ប្រែក្លាយ តំបន់ នេះ ទៅជា តំបន់ សេដ្ឋកិច្ច ឧស្សាហកម្ម ហើយក៏ ជា តំបន់ ទាក់ទាញ លើ ផ្នែក វិស័យ ទេសចរណ៍ ផងដែរ ដោយ ហេតុ ថា ផ្លូវ នេះ តភ្ជាប់ ពី ផ្លូវថ្នល់ ធំ ឆ្ពោះ ទៅកាន់ ខេត្ត សៀមរាប ដែល ភ្ញៀវ ទេសចរ ភាគ ច្រើន ទៅ លេង នៅ ប្រាសាទ អង្គរ ។
ដូច្នេះ ប្រសិនបើ អាជ្ញាធរ រៀបចំ តំបន់ នេះ រៀបចំ ឲ្យបាន ត្រឹមត្រូវ នោះ យើង នឹង អាច ទាក់ទាញ ភ្ញៀវ ទេសចរ ឱ្យ ចូលទៅ ទស្សនា កម្សាន្ត នៅ រមណីយដ្ឋាន ទឹក ឆា ដោយ ឆ្លងកាត់ តាម ផ្លូវ មួយ ខ្សែ នេះ ។
ម្យ៉ាងទៀត អត្ថប្រយោជន៍ ផ្លូវ នេះ សម្រាប់ បងប្អូន ដឹកនាំ កសិផល យក ទៅ ទីផ្សារ បាន ឆាប់ រហ័ស ហើយ បងប្អូន ពី ទី ជិត ឆ្ងាយ ក៏ ងាយស្រួល នឹង មក លេង ផ្ទះ ចំណែក ប្អូន ៗ ក្មួយ ៗ សិស្សសាលា ក៏ អាចនឹង ធ្វើដំណើរ ទៅ សាលារៀន បាន ដោយ ងាយស្រួល ផងដែរ ។
ទន្ទឹម នឹង នោះ លោក អភិបាល ខេត្ត ក៏ បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ឲ្យ ជួយ ថែរក្សា ផ្លូវ ដែល ទើបនឹង សាងសង់ រួច នេះ សម្រាប់ ការប្រើប្រាស់ យូរអង្វែង តទៅ ។ ក្នុង នោះ លោក អភិបាល ខេត្ត ក៏ បាន បញ្ជាក់ ផងដែរ ថា ផ្លូវ មួយ ខ្សែ នេះ អាច វ អភិវឌ្ឍន ទៅជា ផ្លូវ ក្រាល កៅស៊ូ ឬ អាច ទៅជា ផ្លូវ បេតុង នៅ ពេល ក្រោយ ផងដែរ ៕
គ្រួសារ នៃ ជនរងគ្រោះ ជា ពលរដ្ឋ កាណាដា បាត់បង់ជីវិត ក្នុង ហេតុការណ៍ បាញ់ ទម្លាក់ យន្ដហោះ នៅ អ៉ីរ៉ង់ នឹង ទទួលបាន បា្រក់ ២៥.០០០ ដុល្លារ ក្នុង ម្នាក់
មន្ត្រី យោធា ឈរ ជើង ទិស ប្រាសាទ ព្រះវិហារ ម្នាក់ ច្រានចោល ការចោទ ថា លោក រំលោភ ដី ត្រឹម ៥ម៉ែត្រ នៅ ស្រុក ជាំ ក្សាន្ត
( ព្រះវិហារ ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ប៉ូច សុខ ជា នាយ រង ការិយាល័យ អធិការកិច្ច កងទ័ព ជើងគោក ឈរ ជើង ទិស ប្រាសាទ ព្រះវិហារ បាន ថ្លែង ថា លោក មិន បាន រំលោភ យក ដី របស់ គេ ចំនួន ៥ម៉ែត្រ នៅ ភូមិ អាន សេះ ឃុំ ជាំ ក្សាន្ត ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ដូច ការផ្សព្វផ្សាយ តាម បណ្តាញ សង្គម នោះ ទេ ។
លោក ឧត្តមសេនីយ៍ ត្រី ប៉ូច សុខ ជា បាន រៀបរាប់ ប្រវត្តិ ដី ទំនាស់ ឲ្យដឹង ថា ដី នេះ ដំបូង ឡើយ គឺ លោក បាន ប្រគល់ឲ្យ លោក សុក ហៃ អតីត អភិបាល ស្រុក ជាំ ក្សាន្ត បច្ចុប្បន្ន ជា អភិបាល រង ខេត្ត កំពង់ធំ ដែល មាន ទំហំ ២០ម៉ែត្រ គុណ ១៥០ ម៉ែត្រ ដោយ ឥត គិត ថ្លៃ លុះ ក្រោយមក លោក សុក ហៃ បាន លក់ ដី នេះ បន្ត ទៅឲ្យ លោកស្រី ឌុច គឹម យ៉ាន ។
បង្ក្រាប រថយន្តក្រុង មួយ គ្រឿង លួច ដឹក ឈើ ប្រណិត នៅ ខេត្ត ស្ទឹងត្រែង និង ឃាត់ ជនជាតិ វៀតណាម ៧នាក់
( ស្ទឹងត្រែង ) ៖ កម្លាំង នគរបាល ខេត្ត ស្ទឹងត្រែង បាន បង្ក្រាប រថយន្តក្រុង វៀតណាម មួយ គ្រឿង បង្កប់ ឈើ ប្រណិត និង គ្រាប់ ស្លែង មាន ចំនួន ៥០បេ សរុប មួយ តោន ហើយ សមត្ថកិច្ច ក៏ បាន ឃាត់ ក្រុម ជនជាតិ វៀតណាម ចំនួន ៧នាក់ ផងដែរ ។
បើ តាម សមត្ថកិច្ច រថយន្តក្រុង មួយ គ្រឿង នេះ បាន ទិសដៅ ពី ខេត្ត ស្ទឹងត្រែង ទៅ ខេត្ត រតនគិរី ហើយ បំណង ឆ្ពោះទៅ ប្រទេស វៀតណាម តែម្ដង ។
ការបង្ក្រាប នោះ បាន ធ្វើឡើង នៅ វេលា ម៉ោង ៨ ៖ ២០ នាទី ព្រឹក ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ នៅលើ ដង ផ្លូវ ជាតិ លេខ ៧៨ ត្រង់ គោលដៅ ប៉ុស្តិ៍ ត្រួតពិនិត្យ ចរាចរណ៍ ផ្លូវគោក ជិត ផ្លូវ ចូលទៅ ទំនប់ វារី អគ្គិសនី សេសាន្ត ក្រោម ២ ស្ថិត ក្នុង ឃុំ ភ្លុក ស្រុក សេសាន្ត ខេត្ត ស្ទឹងត្រែង ។
សមត្ថកិច្ច បាន បង្ហើប ឲ្យ ថា រថយន្តក្រុង នេះ បាន ផ្ទុក ឈើ ប្រណិត ដោយ ដឹក ចេញ ពី ខេត្ត ស្ទឹងត្រែង ឆ្ពោះ ទៅកាន់ ខេត្ត រតនគិរី ក្នុង បំណង នាំ ឆ្លង ដែន ចូលទៅ ប្រទេស វៀតណាម តាម ច្រក ទ្វារ អន្តរជាតិ អូរ យ៉ាដាវ ស្ថិត ក្នុង ស្រុក អូរយ៉ាដាវ ខេត្ត រតនគិរី ។
សមត្ថកិច្ច បន្ត ថា ដោយ មាន ការសង្ស័យ ក៏ បាន ឃាត់ រថយន្តក្រុង នេះ ត្រួតពិនិត្យ ហើយ បាន រកឃើញ មាន ផ្ទុក សុទ្ធតែ ឈើ ប្រណិត នៅក្នុង ពេល នោះ ក៏ បាន ឃាត់ ជនជាតិ វៀតណាម ៧នាក់ ផងដែរ ។
រថយន្តក្រុង ដឹក ឈើ ល្មើស ច្បាប់ និង ជនសង្ស័យ ៧នាក់ ត្រូវបាន បញ្ជូន មកកាន់ ការិយាល័យ នគរបាល ប្រឆាំង បទល្មើស នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត ស្ទឹងត្រែង ចាត់ការ ជា បន្ត តាម ច្បាប់ ៕ គ្រួសារ សព និង អ្នករបួស សរុប ១៦ នាក់ នៅ ខេត្ត កំពង់ធំ . បន្ទាយមានជ័យ និង បាត់ដំបង រងគ្រោះ ក្នុង ឧបទ្ទវហេតុ បាក់ រលំអាគារ នៅ ខេត្ត កែប ទទួលបាន អំណោយ ពី កាកបាទ ក្រហម ចិន
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ទទួលបាន នូវ ថវិកា ចំនួន ៥ម៉ឺន ដុល្លារ ពី សមាគម ជាតិ កាកបាទ ក្រហម ចិន បាន ផ្តល់ ជូន កាកបាទ ក្រហម កម្ពុជា . សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ចាត់ ឱ្យ តំណាង របស់ សម្តេច ចុះ សួរសុខទុក្ខ និង ចូលរួម រំលែក ទុក្ខ យ៉ាង ក្រៀមក្រំ ដោយ នាំមក នូវ អំណោយ កាកបាទ ក្រហម ចិន ប្រគល់ ជូន ក្រុមគ្រួសារ សព និង អ្នក រងរបួស ដោយសារ បាក់ រលំអាគារ នៅ ខេត្ត កែប កាលពី កន្លងទៅ ថ្មី ៗ នេះ ។
នៅ ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ នេះ គណៈប្រតិភូ ដឹកនាំ ដោយ លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា ព្រមទាំង ថ្នាក់ដឹកនាំ - មន្ត្រី កាកបាទ ក្រហម កម្ពុជា ក៏ បាន អញ្ជើញ ចូលរួម រំលែក មរណទុក្ខ យ៉ាង ក្រៀមក្រំ ជាមួយ ក្រុមគ្រួសារ សព និង ជនរងគ្រោះ សរុប ចំនួន ១៦ នាក់ នៅ ខេត្ត ចំនួន ៣ គឺ ខេត្ត កំពង់ធំ អ្នកស្លាប់ ម្នាក់ . បន្ទាយមានជ័យ អ្នកស្លាប់ ៤នាក់ របួស ៥នាក់ និង ខេត្ត បាត់ដំបង អ្នកស្លាប់ ៥នាក់ និង របួស ១នាក់ ។
ដោយឡែក សម្រាប់ អ្នកស្លាប់ និង របួស ផ្សេង ទៀត មន្ត្រី កាកបាទ ក្រហម កម្ពុជា បាន ចេញ ទៅ តាម មុខ ព្រួញ ប្រតិបត្តិការ ផ្តល់ ថវិកា ដែល ទទួលបាន ពី កាកបាទ ក្រហម ចិន ជូន ដល់ គ្រួសារ សព និង អ្នករបួស ដោយ បាក់ រលំអាគារ នៅ ខេត្ត កែប ផងដែរ ។
ក្នុង សមាន ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ លោកស្រី ពុំ ចន្ទីនី បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្តាំផ្ញើ សួរសុខទុក្ខ ក្តីអាណិតអាសូរ និង សម្តែង ការសោកស្តាយ យ៉ាង ក្រៃលែង ចំពោះ សោកនាដកម្ម ដែល បាន កើតឡើង ចំពោះ គ្រួសារ ជនរងគ្រោះ ទាំងអស់ និង សូម បួងសួង ដល់ វិញ្ញាណក្ខន្ធ សព ជនរងគ្រោះ បាន ទៅកាន់ សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
ជាមួយគ្នា នេះ លោកស្រី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា បាន ថ្លែង ថា សមាគម ជាតិ កាកបាទ ក្រហម ចិន បាន ផ្តល់ ថវិកា ៥ម៉ឺន ដុល្លារ តាមរយៈ កាកបាទ ក្រហម កម្ពុជា កាលពី ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២០ ម្សិលមិញ ដើម្បី ចូលរួមចំណែក រំលែក ទុក្ខ និង សម្រាល ការលំបាក របស់ ជនរងគ្រោះ និង គ្រួសារ ជនរងគ្រោះ របស់ ពលរដ្ឋ យើង ដោយ រលំអគារ នៅ កែប កាលពី ពេល កន្លងទៅ ថ្មី ៗ នេះ ។ ដូច្នេះ ក្រុមការងារ កាកបាទ ក្រហម កម្ពុជា ក៏ បាន ចុះ មក សួរ សុខទុក្ខ និង ប្រគល់ ថវិកា ជូន ដល់ គ្រួសារ សព និង អ្នករងគ្រោះ ភ្លាម ៗ តែម្តង ។
លោកស្រី ពុំ ចន្ទីនី បាន ថ្លែង បញ្ជាក់ ថា មិត្ត ចិន ក៏ដូចជា សមាគម ជាតិ កាកបាទ ក្រហម ចិន ជានិច្ចកាល តែងតែ ជួយ ដល់ ប្រជាជន កម្ពុជា គ្រប់ ពេលវេលា ដែល ជួប នឹង ទុក្ខលំបាក ៕ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ និង វិទ្យាស្ថាន មួយ របស់ ចិន សហការ គ្នា ដាំ កប្បាស ចំនួន ១០ម៉ឺន ហិកតា
( កំពង់ស្ពឺ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ស្ពឺ បាន ចុះ អនុស្សារណៈ យោគយល់ គ្នា ជាមួយ វិទ្យាស្ថាន ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ កសិកម្ម នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ស្តីពី គម្រោង ដាំដុះ កប្បាស ១០ម៉ឺន ហិកតា ក្នុង ខេត្ត កំពង់ស្ពឺ ។ ពិធី នេះ បាន រៀបចំ ធ្វើឡើង នៅ រដ្ឋបាល ខេត្ត កំពង ស្ពឺ នា រសៀល ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ ។
នៅក្នុង ឱកាស នោះ លោក វ៉ី សំណាង អភិបាល ខេត្ត កំពង់ស្ពឺ បាន ឲ្យដឹង ថា ក្រោម ការដឹកនាំ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន បាន ឲ្យ មាន សន្តិភាព និង ជំនឿ ជឿ ទុកចិត្ត ពី សំណាក់ អ្នក វិនិយោគ ក្រៅ ប្រទេស មាន ការចាប់អារម្មណ៍ យ៉ាង ខ្លាំង ក្នុង ប្រទេស កម្ពុជា ។
លោក វ៉ី សំណាង បាន លើកឡើង ថា ជាក់ស្ដែង ក្នុង ខេត្ត កំពង់ស្ពឺ រយៈពេល ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ខេត្ត កំពង់ស្ពឺ ទទួលបាន ការវិនិយោគ ២៦១ រោងចក្រ ដំណាំ ស្វាយ កែវ ល្មៀត ៤.៥០០ ហិកតា និង ដំណាំ អំពៅ ជាង ៤០.០០០ ហិកតា ផងដែរ ។
លោក ថា ចំពោះ វិទ្យាស្ថាន ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ កសិកម្ម នៃ ប្រទេស ចិន មាន ការចាប់អារម្មណ៍ ទៅ លើ ការដាំដុះ ដំណាំ កប្បាស នៅ ខេត្ត កំពង់ស្ពឺ នេះ គឺ ពិតជា ធ្វើឲ ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត រីករាយ ស្វាគមន៍ និង រំពឹង ថា ដំណាំ កប្បាស នេះ និង ជួយ ប្រជាពលរដ្ឋ កាត់បន្ថយ ភាពក្រីក្រ អាច ផ្ដល់ ការងារ ជាច្រើន ដល់ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត កំពង់ស្ពឺ ។
ជាពិសេស ដើម្បី កាន់តែ រឹត ចំណង មិត្តភាព កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា ទៅ វិញ ទៅ មក រវាង ខេត្ត កំពង់ស្ពឺ និង វិទ្យាស្ថាន ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ កសិកម្ម នៃ សាធារណៈ រដ្ឋ ប្រជាមានិត ចិន ។ នេះ ជា ការគូសបញ្ជាក់ បន្ថែម របស់ លោក អភិបាល ខេត្ត ។
លោក Li Zheng ប្រធាន វិទ្យាស្ថាន ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ កសិកម្ម នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន ឲ្យដឹង អំពី គោលបំណង វិនិយោគ ដាំ កប្បាស ចំនួន ១០ម៉ឺន ហិកតា នៅ ខេត្ត កំពង់ស្ពឺ ជា លើក ដំបូង សិន គឺ លោក មើលឃើញ ថា ខេត្ត កំពង់ស្ពឺ មាន អាកាសធាតុ ល្អ ចំណែក ដី ក៏ មាន សក្តានុពល សាកសម ដំណាំ កប្បាស នេះ ហើយក៏ មើលឃើញ ប្រជាជន នៅ ខេត្ត កំពង់ស្ពឺ ឧស្សាហ៍ ព្យាយាម ផងដែរ ។
លោក តឹក ង៉ូយ សហគ្រិន ខ្មែរ - អាមេរិក ដែក គេ ស្គាល់ ថា ជា ស្ដេច នំ ដូណាត់ ដែល ដឹកនាំ គណៈប្រតិភូ នៃ វិទ្យាស្ថាន ស្រាវជ្រាវ អភិឌ្ឍន៍ កសិកម្ម និង ក្រុមហ៊ុន វិនិយោគ ដាំ កប្បាស របស់ ប្រទេស ចិន បាន ឲ្យដឹង ផងដែរ ថា លោក បាន ទៅ ទស្សនកិច្ច ដំណាំ កប្បាស នៅ ប្រទេស ចិន ដោយ ប្រជាជន ចិន នៅ ខេត្ត ស៊ី ជាំង ដាំ កប្បាស ១ហិកតា ទទួលបាន ផល ៧តោន ។
លោក បាន លើកឡើង ថា បើ ប្រៀបធៀប ទៅ ដំណាំ ស្រូវ និង មាន តម្លៃ ខ្ពស់ មាន ភាពងាយស្រួល ដាំ ដែល អាច រក ចំណូល បាន ខ្ពស់ សម្រាប់ ប្រជាកសិករ ដូចនេះ ជា ជោគជ័យ មួយ ទៀត សម្រាប់ កម្ពុជា ដែល ជា ប្រទេស មាន សន្តិភាព ក្រោយ ការដឹកនាំ របស់ តេជោ ដែល ធ្វើឲ្យ អ្នក វិនិយោគ កសិកម្ម កប្បាស នៃ ប្រទេស ចិន មើលឃើញ កម្ពុជា មុន គេ ក្នុង បណ្ដាល ប្រទេស អាស៊ាន ។
លោក តឹក ង៉ូយ បន្ថែម ទៀត ថា បន្ទាប់ពី ការចុះអនុស្សារណៈ យោគយល់ រវាង ខេត្ត កំពង់ស្ពឺ និង វិទ្យាស្ថាន ស្រាវជ្រាវ និង អភិវឌ្ឍន៍ កសិកម្ម នៃ ប្រទេស ចិន ទៅ លើ កិច្ចសហប្រតិបត្ត ការ លើ កសិកម្ម ដំណាំ ក្បាស នេះ មិន យូរ ទេ ភាគី ចិន មក ធ្វើ ការបណ្ដុះបណ្ដាល ការងារ បច្ចេកទេស ផ្ដល់ ពូជ ល្អ លេខ ១ ជី និង ការថែទាំ ដល់ ប្រជាកសិករ ខ្មែរ ហើយ នៅពេល ប្រមូល ផល គឺ លក់ ឲ្យ ក្រុមហ៊ុន តែម្ដង ៕
( ត្បូងឃ្មុំ ) ៖ សិស្ស អនុ - វិទ្យាល័យ ក្រូចឆ្មារ ខេត្ត ត្បូងឃ្មុំ ចំនួន ៤១ នាក់ គិត ត្រឹម រសៀល ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ បាន ដួល សន្លប់ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ ប៉ុន្តែ សម្រាប់ ស្ថានភាព ជំងឺ វិញ បាន ធូរស្រាល ខ្លះ ហើយ មិន ប៉ះពាល់ ដល់ អាយុជីវិត នោះ ឡើយ ។
លោក ហាក់ សុខ មករា បាន បញ្ជាក់ បន្ថែម ថា តាម ការសន្និដ្ឋាន ពី ការដួល សន្លប់ អាច មក កត្តា មួយ ចំនួន រួម មាន៖
*ទី១ ៖ កត្តា បរិស្ថាន៖ អាច ផ្សែង ចេញ ពីឡ ឥដ្ឋ ខាងក្រោយ វិទ្យាល័យ ចំងាយ ប្រហែល ២០០ ម៉ែត្រ និង ឡ ដុត សំរាម ក្នុង សាលា និង អាកាសធាតុ ក្ដៅហប់ * ទី២ ៖ កត្តា សុខភាព៖ សិស្ស ខ្សោយ អាហារ មិន ទៀងទាត់ សម្រាក មិន គ្រប់គ្រាន់ ក្នុង នោះ ចំណោម ៤១ នាក់ អ្នកជំងឺ ខ្វះ ជាតិ ស្ករ ៥ករណី ខ្វះ ជាតិ កាល់ស្យូម ៣ករណី ក្រៅពី នេះ ពាក់ព័ន្ធ អារម្មណ៍ តក់ស្លុត ក្រោយពេល ឃើញ មិត្តភក្តិ ដួល សន្លប់ ។
បើ តាម អភិបាល រង ខេត្ត រូប នេះ គិត មកដល់ ពេលនេះ ស្ថានភាព សិស្ស បាន ធូរស្រាល ឡើងវិញ ហើយ ពុំ មាន បញ្ហា ធ្ងន់ធ្ងរ អ្វី ឡើយ ដោយសារ មាន ការជួយ សង្រ្គោះ បន្ទាន់ ពី ក្រុម គ្រូពេទ្យ អាជ្ញាធរ និង សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ ។
នៅ រសៀល ថ្ងៃ ដដែល នេះ លោក ហាក់ សុខ មករា ចុះ ពិនិត្យ នៅ វិទ្យាល័យ រួច ឧបត្ថម្ភ សាងសង់ របង សាលា ៤ប្រឡោះ ដោយ ចំណាយ ថវិកា ៦២០ ដុល្លារ ៕
អត្ថបទ ប្រកួតប្រជែង របស់ ស្ថានទូត ចិន៖ « រឿង និទាន ខ្លី ស្តីពី ប្រទេស ចិន របស់ ខ្ញុំ »
( ភ្នំពេញ ) ៖ ដោយសារ ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ ល្អ រវាង រាជ រដ្ឋា ពិបាល កម្ពុជា និង ប្រជាមានិត នៃ ប្រជាជន ចិន មាន តាំងពី យូរ លង់ ណាស់ មកហើយ រហូតមកដល់ បច្ចុប្បន្ន និង ដោយ មាន ការជួយ ទំនុកបម្រុង ឥត ឈប់ឈរ លើ គ្រប់ វិស័យ ពីសំណាក់ ប្រទេស ចិន ទើប ធ្វើឲ្យ ខ្ញុំ មាន ភ័ព្វសំណាង ល្អ បាន ទៅ ស្គាល់ ប្រទេស មហា អំណាច ដែល មាន វប្បធម៌ ដ៏ ចំណាស់ និង អស្ចារ្យ មួយ នេះ តាមរយៈ ការចូលរួម វគ្គ បណ្តុះបណ្តាល បាន ចំនួន ពីរ លើក ។
កាលពី ចុង ឆ្នាំ ២០១៨ ក្រសួង សុខាភិបាល នៃ ប្រទេស កម្ពុជា បាន ទទួល រថយន្ត មន្ទីរពេទ្យ ចល័ត ចំនួន ៤០ គ្រឿង ដែល សុទ្ធតែ បាន បំពាក់ នូវ ឧបករណ៍ និង សម្ភារ ទំនើប ៗ និង មាន តំលៃ ថ្លៃ ជូន ដល់ គ្រូពេទ្យ កម្ពុជា សម្រាប់ ផ្តល់ ដល់ មូលដ្ឋាន ជូន ប្រជាជន ។ នេះ សុទ្ធតែ ជា ជំនួយ ឥត សំណង របស់ រដ្ឋាភិបាល ចិន មក ឲ្យ កម្ពុជា ។
ឆ្លងកាត់ វគ្គ បណ្តុះបណ្តាល ទាំង ពីរ លើក នេះ ខ្ញុំ ពិតជា ទទួលបាន នូវ ចំណេះដឹង និង បទពិសោធន៍ ល្អ ៗ គួរ ជា ទី គាប់ ចិត្ត និង មិន អាច បំភ្លេច បាន ឡើយ ។ វគ្គ បណ្តុះបណ្តាល ទាំង ពីរ បាន ផ្តល់ អត្ថប្រយោជន៍ យ៉ាង សំបើម សម្រាប់ ការអភិវឌ្ឍ រិស័យ ការងារ នៅ អង្គភាព របស់ ខ្ញុំ និង រួមចំណែក យ៉ាង ច្រើន ដល់ ការអភិវឌ្ឍន៍ នៃ ប្រទេស កម្ពុជា ទាំងមូល ។
ចំណែកឯ ការចំណាយ ប្រចាំ ឆ្នាំ លើ វិស័យ សុខាភិបាល ( ៦. ៣៩% នៅ ឆ្នាំ ២០១៨ ) គឺ តិច តែ មាន ប្រសិទ្ធភាព ល្អ ។ ប្រជាជន ចិន ៩៥ ភាគរយ មាន ប័ណ្ណ ធានារ៉ាប់រង លើ សុខភាព ដោយ រដ្ឋ ។ ដោយសារ មាន កំណែទម្រង់ លើ គ្រប់ វិស័យ ប្រកបដោយ ប្រសិទ្ធភាព និង ចេរភាព និង កំណើន សេដ្ឋកិច្ច លឿន ទើប ធ្វើឲ្យ អត្រា ឈឺ និង អត្រា ស្លាប់ របស់ ប្រជាពលរដ្ឋ មាន ការថយចុះ គួរ កត់សំគាល់ ។ រីឯ ជីវភាព រស់ នៅ និង ជីវិត រំពឹង រស់ ជា មធ្យម របស់ ប្រជាពលរដ្ឋ ក៏ កាន់តែ ប្រសើរឡើង ជាលំដាប់ ផងដែរ ។
ទោះ យ៉ាង នេះ ក្តី ដើម្បី ឆ្លើយតប ទៅនឹង បញ្ហា ខាងលើ ប្រកបដោយ ប្រសិទ្ធភាព រដ្ឋាភិបាល នៃ ប្រទេស ចិន បាន ផ្តួចផ្តើម បង្កើត នូវ គោល នយោបាយ ជា យុទ្ធសាស្ត្រ ថ្មី មួយ ដែល បាន ដាក់ ឲ្យ អនុវត្ត ជាធរមាន តាំងពី ឆ្នាំ ២០១៦ ។ ផែនការ នេះ មាន ឈ្មោះ ថា « ផែនការ យុទ្ធសាស្ត្រ ដើម្បី ប្រទេស ចិន មាន សុខភាព ល្អ នៅ ឆ្នាំ ២០៣០» ។
ផែនការ យុទ្ធសាស្ត្រ នេះ បាន ដាក់ ឲ្យ អនុវត្ត ដោយ ផ្អែក លើ គោលដៅ ចំណុច ធំ ៗ ៥យ៉ាង រួម មាន៖
* ទី១៖ ផ្សព្វផ្សាយ ពី ការរស់នៅ ប្រកបដោយ ផាសុខភាព ល្អ ដល់ ប្រជាជន ទូទៅ ។ តាម រថភ្លើង តាម រថយន្តក្រុង តាម ផ្សា ទំនើប ស្ថាប័ន រដ្ឋ និង ឯកជន និង តាម ផ្លូវ សាធារណៈ តែង មាន ការបិត ផ្ទាំង សារ អប់រំ សុខភាព រួមទាំង ការផ្សព្វផ្សាយ តាម វិទ្យុ និង ទូរទស្សន៍ ផងដែរ ។
* ទី ២៖ កែលំអរ សេវា សុខាភិបាល ឲ្យបាន ល្អ បំផុត តាមររយៈ ការពង្រឹង គុណភាព សេវាស សុខាភិបាល បង្កើន សមត្ថភាព ធនធាន មនុស្ស បង្កើន គ្រឹះស្ថាន សុខាភិបាល ឲ្យបាន គ្រប់ តំបន់ ដែល មាន ប្រជាជន រស់ នៅ និង ត្រូវ បំពាក់ ឧបករណ៍ ពេទ្យ នៅ គ្រប់ មូលដ្ឋាន សុខាភិបាល តាម តំរូវការ ជាក់ស្តែង បង្កើន អត្រា គ្របដណ្តប់ សេវា ធានារ៉ាប់រង សុខភាព ឲ្យបាន ១០០ ភាគរយ ផ្តល់ សេវា ព្យាបាល ប្រកបដោយ គុណភាព ប្រសិទ្ធភាព គុណធម៌ ខ្ពស់ និង តំលៃ ទទួលយក បាន ។
ដើម្បី កាត់បន្ថយ ជំងឺ រ៉ាំរ៉ៃ ដែល ជា បន្ទុក ធ្ងន់ របស់ រដ្ឋ រដ្ឋាភិបាល បាន ខិតខំ ស្រាវជ្រាវ រក ជំងឺ មហារីក គ្រប់ ទំរង់ និង ជំងឺ រ៉ាំរ៉ៃ ផ្សេង ទៀត នៅ គ្រប់ ទីកន្លែង ។ ស្រាវជ្រាវ ពី របប អាហារ ប្រចាំ ថ្ងៃ ដែល ជះឥទ្ធិពល ដល់ ជំងឺ រ៉ាំរ៉ៃ និង វាស់វែង ស្ថានភាព អាហារូបត្ថម្ភ ដើម្បី ស្វែងរក កត្តា កំណត់ នៃ ជំងឺ រ៉ាំរ៉ៃ ។ អប់រំ និង ទប់ស្កាត់ ជំងឺ ឆ្លង គ្រប់ ប្រភេទ នៅ គ្រប់ ទីកន្លែង ដោយ កម្ចាត់ ឲ្យ អស់ នូវ ប្រភព ចម្លង ជំងឺ និង ផ្តល់ ថ្នាំ បង្ការ ជំងឺ គ្រប់ ប្រភេទ ឲ្យបាន ១០០ ភាគរយ និង មាន ប្រសិទ្ធភាព ខ្ពស់ ។
* ទី៣៖ អភិវឌ្ឍន៍ ឧស្សាហ៍កម្ម សុខាភិបាល ទំនើប ៗ និង បំពាក់ នូវ បច្ចេកវិទ្យា ទំនើប ដូចជា ប្រព័ន្ធ ៥ជី (5G) ដែល គ្រូពេទ្យ ឯកទេស អាច ធ្វើ ការវះកាត់ អ្នកជំងឺ តាម ប្រព័ន្ធ ផ្កាយ រណប បាន ។
* ទី៤៖ បង្កើត ឲ្យ មាន បរិស្ថាន ប្រកបដោយ ផាសុខភាព ( កែលំអរ បរិស្ថាន កាត់បន្ថយ ខ្យល់ ពុល ) តាមរយៈ ការបញ្ឈប់ ការប្រើប្រាស់ ទោចក្រយាន ដំណើរការ ដោយ ប្រេងសាំង ទៅជា ទោចក្រយាន ដើរ ដោយ អាគុយ វិញ ។ រដ្ឋាភិបាល បាន លើកទឹកចិត្ត ប្រជាជន ឲ្យ ប្រើប្រាស់ រថយន្ត ដើរ ដោយ អាគុយ ដោយ មិន យក ពន្ធ ។
រថយន្តក្រុង និង រថភ្លើង សុទ្ធតែ ដំណើរការ ដោយ ចរន្ត អគ្គីសនី ។ ខ្ញុំ បាន សង្កេតមើល សព្វ ទីកន្លែង ដែល ខ្ញុំ បាន ទៅដល់ ឃើញ ថា គ្រប់ ផ្លូវថ្នល់ ទាំងអស់ សុទ្ធតែ ត្រូវបាន កែលំអរ យ៉ាង ស្អាត គ្មាន សំរាម គ្មាន ដី ហុយ និង គ្មាន ក្លឹន ស្អុយ ។ បើ មាន ផ្លូវ ណា ដែល កំពុង ស្ថិត នៅក្រោម ការជួសជុល ក៏ មាន ការគ្រប ស្បៃ ឬ ផ្ទាំង កៅស៊ូ ការពារ កុំ ឲ្យ ហុយ ដី ដែរ ។ នៅ តាម ដង វិថី គ្រប់ ទិសទី សុទ្ធតែ មាន ដាំ ដើមឈើ និង ដើម ផ្កា ទាំង សងខាង ផ្លូវ ដើម្បី ជា សម្រស់ ទីក្រុង ផង និង កាត់បន្ថយ ខ្យល់ ពុល ផង ។
* ទី៥៖ កែរ លំអរ ប្រព័ន្ធ ធានារ៉ាប់រង សុខភាព សង្គម តាមរយៈ ការផ្តល់ ប័ណ្ណ ធានារ៉ាប់រង សុខភាព ជូន ដល់ ប្រជាជន គ្រប់ រូប ដើម្បី ទទួលបាន ការព្យាបាល ស្មើភាព គ្នា ប្រកបដោយ គុណភាព និង គុណធម៌ ។
សរុប សេចក្តី មក ខ្ញុំ ពិតជា មាន មោទនភាព និង សេចក្តីរំភើប ក្រៃលែង ដែល ថ្នាក់ដឹកនាំ របស់ ប្រទេស កម្ពុជា និង ប្រទេស ចិន មាន ចំណង មិត្តភាព និង សាមគ្គីភាព រឹងមាំ ដូច បងប្អូន ដែល ធ្វើឲ្យ ប្រជាជន នៃ ប្រទេស ទាំង ពីរ មាន ឱកាស រៀនសូត្រ ពី គ្នា ទៅវិញ ទៅ មក និង ទទួលបាន ជំនួយ កសាង លើ គ្រប់ វិស័យ សម្រាប់ កម្ពុជា ពី រដ្ឋាភិបាល ចិន ។
ដោយ៖ ឃុន ម៉ៅ មន្ទីរ សុខាភិបាល ខេត្ត កំពត ក្រសួង សុខាភិបាល កម្ពុជា ។ អត្ថបទ នេះ មកពី ការប្រកួតប្រជែង អត្ថបទ អំពី « រឿង ព្រេង ប្រទេស ចិន របស់ ខ្ញុំ » ដែល រៀបចំ ដោយ ការិយាល័យ ទីប្រឹក្សា សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម នៃ ស្ថានទូត ចិន ប្រចាំ នៅ ប្រទេស កម្ពុជា ៕ អបអរ បុណ្យ ចូល ឆ្នាំ ចិន ! ក្រុមហ៊ុន ស៊ុន ស៊ី ម៉ិចកូ ប្រកាស បញ្ចុះ តម្លៃ យ៉ាង ពិសេស លើ បរិក្ខារ ផ្ទះបាយ ជូន ដល់ អតិថិជន
( ភ្នំពេញ ) ៖ ដើម្បី អបអរ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ចិន ក្រុមហ៊ុន ស៊ុន ស៊ី ម៉ិច កូ នឹង ផ្តល់ ជូន ការបញ្ចុះ តម្លៃ ទៅ លើ បរិក្ខារ ផ្ទះបាយ ជាច្រើន ប្រភេទ ដូចជា ចង្ក្រាន ហ្គាស ឆ្នាំង ដាំ បាយ ម៉ាស៊ីន ក្រឡុក បំពង់ ទឹក ក្តៅ ចង្ក្រាន បង្កប់ ម៉ាស៊ីន បឺត ផ្សែង ម៉ាស៊ីន បំពង ម៉ាស៊ីន អាំង សាច់ ម៉ាស៊ីន ដុត មាន់ និង បរិក្ខារ ជាច្រើន មុខ ទៀត ដែល សុទ្ធសឹង ជា ម៉ាក ល្បី ៗ និង មាន ប្រជាប្រិយភាព នៅលើ ទីផ្សារ អឺរ៉ុប និង អាស៊ី ។
ផ្តើម ចេញ ពី គោលបំណង នាំឱ្យ អតីត និស្សិត រៀន មិន ចប់ បរិញ្ញាបត្រ ម្នាក់ ជោគជ័យ យ៉ាង ខ្លាំង ក្នុង ជំនួញ
( ភ្នំពេញ ) ៖ មនុស្ស ម្នាក់ ៗ រស់ នៅ លើ លោក យើង នេះ សុទ្ធតែ មាន ក្តីស្រមៃ និង បំណងប្រាថ្នា រៀង ៗ ខ្លួន គ្រាន់តែ ថា អ្នក ខ្លះ អាច សម្រេច បំណង របស់ ខ្លួន ដោយសារតែ ពួក គាត់ ខិតខំ តស៊ូ ជម្នះ រាល់ ឧបសគ្គ មិន បោះបង់ ចោល ងាយ ៗ ចំពោះ ក្ដីស្រមៃ របស់ ខ្លួន ។
អ្នកស្រី បន្ត ថា គ្រួសារ អ្នកស្រី រកស៊ី បោះ ដុំ ហូល ខ្មែរ ទូទាំង ប្រទេស នេះ អស់ រយៈកាល ជាង ៣០ ឆ្នាំ មកហើយ ប៉ុន្តែ ដោយសារ អ្នកស្រី ឃើញ ថា តម្រូវការ នៃ ការប្រើប្រាស់ ហូល មិន សូវ ខ្លាំង ដោយ ហេតុ ថា ហូល ខ្មែរ ភាគ ច្រើន ដែល បាន ដាក់ លក់ លើ ទីផ្សារ មាន តម្លៃ ថ្លៃ ពេក ( ដោយសារ ឆ្លងកាត់ ឈ្មួញ កណ្តាល ច្រើន តង់ និង ការលក់ ថ្លៃ ខ្លាំង តាម ការ នឹកឃើញ របស់ អ្នកលក់ មួយចំនួន ) ។
ទើប អ្នកស្រី សម្រេចចិត្ត បើក ហាង លក់ ហូល ផា មួង ខ្លួន ឯង ដើម្បីឱ្យ អតិថិជន ភាគ ច្រើន មាន លទ្ធភាព ប្រើប្រាស់ ហូល ផា មួង ខ្មែរ ដែល មាន គុណភាព ខ្ពស់ និង តម្លៃ សមរម្យ បំផុត ដោយ អ្នកស្រី កំណត់ តម្លៃ លក់ រាយ ទាប ដូច តម្លៃ លក់ បោះ ដុំ អ៊ីចឹង ដើម្បី ជំរុញ ឱ្យ មាន ការប្រើប្រាស់ ហូល ផា មួង ខ្មែរ ឱ្យ បាន កាន់តែ ច្រើន ជាង មុន ។
១៖ កំណត់ គោលបំណង ច្បាស់លា ស់៖ ដោយ អ្នកស្រី តែង ប្រាថ្នា ចង់ឱ្យ ពលរដ្ឋ ខ្មែរ ភាគ ច្រើន មាន លទ្ធភាព ប្រើប្រាស់ ហូល ផា មួង ខ្មែរ ពិត ៗ គោលបំណង នេះ បាន ជំរុញ អ្នកស្រី ឱ្យ មាន ការតាំងចិត្ត ខ្ពស់ និង ខិតខំ ប្រឹងប្រែង យ៉ាង ខ្លាំង ស្ទើរ គ្មាន ពេល សំរាក ។
២៖ លក់ ទំនុកចិត្ត និង ភាពស្មោះត្រង់៖ អ្នកស្រី មានប្រសាសន៍ ថា អ្នកស្រី មិន មែន លក់ តែ ហូល ផា មួង ទៅ អតិថិជន ទេ ប៉ុន្តែ អ្នកស្រី លក់ ទាំង ទំនុកចិត្ត និង ភាពស្មោះត្រង់ ជូន អតិថិជន មិន ផ្ដោត តែ ចង់បាន ប្រាក់ ចំណេញ ជា ធំ នោះ ទេ ។ ដោយសារតែ ការធ្វើ អាជីវកម្ម ដោយ លក់ ទំនុកចិត្ត និង ភាពស្មោះត្រង់នេះ ហើយ ទើប បានជា អាជីវកម្ម របស់ អ្នកស្រី តែងតែ ទទួលបាន នូវ ពាក្យ អរគុណ ពាក្យ សរសើរ និង អាជីវកម្ម បន្ត រីកចម្រើន ជារៀងរាល់ ថ្ងៃ ។
៣៖ គុណភាព ល្អ ជាង គេ៖ ឆ្លងកាត់ ការសម្រិត សម្រាំង អ្នកស្រី បាន ថ្លែង ថា ហាង របស់ អ្នកស្រី លក់ តែ ផលិតផល ហូល ផា មួង ណា ដែល មាន គុណភាព ខ្ពស់ តែ ប៉ុណ្ណោះ ដើម្បីឱ្យ អតិថិជន ចំណាយ ថវិកា របស់ ពួកគេ ហើយ ប្ដូរ បាន មកវិញ នូវ បេះដូង និង ស្នាមញញឹម ។
៤៖ តម្លៃ ទាប ជាង គេ៖ ដោយសារ មាន សិប្បកម្ម ផ្ទាល់ខ្លួន នៅ ខេត្ត តាកែវ ផង និង ទទួល ទិញ ដោយ ផ្ទាល់ ពី បងប្អូន ខ្មែរ ដែល ជា អ្នកតម្បាញ ផង អ្នកស្រី ហ៊ាន ធានា ថា ហូល ផា មួង ជាង ៥០០០ក្បិន នៅ ហាង អ្នកស្រី ទាំង ៣សាខា គឺ មាន តម្លៃ ទាប ជាង ហាង នានា ទូទាំង ប្រទេស ។
៥៖ សេវាកម្ម ឆាប់ រហ័ស៖ តាម តម្រូវការ អតិថិជន អ្នកស្រី តែង ផ្តោត លើ ការផ្តល់ សេវាកម្ម ដ៏ ល្អ និង លឿន រហ័ស មិន ឱ្យ អតិថិជន ខក បំណង និង ទន្ទឹងរង់ចាំ យូរ នោះ ទេ ។
៦៖ ផ្ដល់ ការប្រឹក្សា ចេញ ពី បេះដូង៖ នៅ ពេល ដែល អតិថិជន ចង់ ជា វហូល ផា មួង ពី ហាង របស់ អ្នកស្រី គឺ អតិថិជន តែងតែ ទទួលបាន នូវ ការប្រឹក្សា យ៉ាង ល្អ ទាក់ទង នឹង ប្រភេទ ហូល ផា មួង តម្លៃ ការច្នៃ ម៉ូត និង បញ្ហា ផ្សេង ៗ មួយចំនួន ទៀត ដើម្បី ធានា ធ្វើ យ៉ាងណា ឱ្យ អតិថិជន ទទួលបាន នូវ ភាពស្រស់ស្អាត និង សប្បាយ ចិត្ត ក្រោយពេល ដែល ទិញ ផលិតផល ពី ហាង របស់ អ្នកស្រី ។
អ្នកស្រី ក៏ បាន លើកឡើង ថា អតិថិជន ដែល ទិញ ហូល ផា មួង ពី ហាង អ្នកស្រី មិន ត្រឹមតែ អាច ទិញ ហូល ផា មួង ដែល ល្អ ជាង គេ ក្នុង តម្លៃ ទាប ជាង គេ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ពួកគាត់ ថែមទាំង បាន ជួយ ឱ្យ គ្រួសារ អ្នកតម្បាញ ខ្មែរ មាន ជីវិភាព ប្រសើរ និង រួមចំណែក ក្នុង ការជួយសង្គម ដោយ អ្នកស្រី នឹង ប្រើប្រាស់ ចំណូល ពី ការលក់ មួយចំនួន ចូលរួម ក្នុង ការជួយ ដល់ កិច្ចការងារ សង្គម ផ្សេង ៗ ដើម្បី តបស្នង ទៅកាន់ សង្គម វិញ ផងដែរ ៕
សាច់ញាតិ របស់ ជនរងគ្រោះ បាន ឲ្យដឹង ថា មុនពេល កើត ហេតុ មាន បុរស ម្នាក់ បាន បន្លំ ខ្លួន ថា ជាជាង ត GPS រថយន្ដ ហើយ ខាង ក្រុមហ៊ុន ឲ្យ ឆែកមើល ពេល នោះ ម្ចាស់ រថយន្ដ ក៏ អនុញ្ញាត ឲ្យ ចូល ដើម្បី ពិនិត្យ ។ ដោយសារ កំពុងតែ រវល់ រក ស៉ី ជនរងគ្រោះ បាន ទុកឲ្យ ជនសង្ស័យ នៅ ពិនិត្យ ភ្លាម នោះ ជនសង្ស័យ ឃើញ ឱកាស ល្អ ក៏ ឡើង បើក រថយន្ដ គេចខ្លួន បាត់ តែម្ដង ។
បច្ចុប្បន្ន ជនរងគ្រោះ កំពុង ដាក់ពាក្យបណ្ដឹង នៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី សុំឲ្យ សមត្ថកិច្ច ជួយ អន្ដរាគមន៍ ។ អធិការ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ លោក ម៉ែន សុធី បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ថា នៅ ពេល នេះ កម្លាំង នគរបាល របស់ លោក កំពុង តាម ស្ទាក់ ជនសង្ស័យ ដោយ សហការ ជាមួយ កម្លាំង សមត្ថកិច្ច ផ្សេង ទៀត ។
ក្រោយ ការបិទ ទ្វារ សណ្ឋាគារ នេះ បាន ចាត់តាំង ការិយាល័យ មេធាវី អេចប៊ី អេស (HBS) ឲ្យ ទទួល ដោះស្រាយ នូវ ដំណើរការ នៃ ការបិទ សណ្ឋាគារ រួមទាំង ការគិតគូរ ដោះស្រាយ ពី អត្ថប្រយោជន៍ របស់ បុគ្គលិក ទាំងអស់ ទៅ តាម ផ្លូវ ច្បាប់ ជាធរមាន ។
ក្នុង ការជួបជុំគ្នា អតីត បុគ្គលិក ទាំងអស់ នោះ បាន ស្នើ ដល់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ នឹង ការងារ ពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល សម្តេច តេជោ តែងតែ បារម្ភ ពី សុខ ទុក្ខ ប្រជាពលរដ្ឋ ឲ្យ ជួយ ជំរុញ ការពន្លឿន ការ ដោះស្រាយ សំណង ជូន ពួកគាត់ ស្រប តាម ច្បាប់ ការងារ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ខណៈ សមាជិក ក្រុមគ្រួសារ របស់ ពួកគាត់ រាប់ រយ នាក់ កំពុង ជួប បញ្ហា ខ្វះខាត ក្នុង ជីវភាព ដោយ អ្នក ខ្លះ ត្រូវ បង់លុយ ធនាគារ និង ត្រូវ ផ្គត់ផ្គង់ ការចំណាយ ជីវភាព គ្រួសារ ប្រចាំ ថ្ងៃ ។
លោក ទូច កុសល បន្ត ថា ជំនួប ជាមួយ មេធាវី សណ្ឋាគារ លើក ទី២ នៅ ថ្ងៃទី ០៣ ខែមករា ឆ្នាំ ២០២០ កន្លងទៅ នេះ ប៉ុន្តែ ជំនួប នោះ មិន បាន លទ្ធ អ្វី ឡើយ ដោយ មិន យល់ស្រប តាម ការស្នើសុំ របស់ អតីត បុគ្គលិក ហើយ រហូតដល់ ថ្ងៃទី ១៨ ខែមករា នេះ មាន រយៈពេល ជាង ១០ ថ្ងៃ ហើយ មិន ទាន់ ទទួលបាន ដំណឹង ថ្មី ឡើយ ។
លោក បាន ឲ្យដឹង ថា មាន បុគ្គលិក ម្នាក់ ឈ្មោះ ទាវ សំអូន មិន ដឹង ជា យ៉ាងម៉េច បន្ទាប់ពី សណ្ឋាគារ នេះ បិទ គាត់ ក៏ ធ្លាក់ខ្លួន ឈឺ រហូតដល់ ស្លាប់ ទើប ធ្វើ បុណ្យ ៧ ថ្ងៃ រួច កាលពី ម្សិលម្ងៃ ថែម ទៀត ។
អ្វី ដែល គេ នៅ ចងចាំ នោះ គឺ សណ្ឋាគារ នេះ បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជួយ ឲ្យ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ អាស៊ាន លើក ដំបូង កាលពី ឆ្នាំ ២០០២ ដែល ទទួល បដិសណ្ឋារកិច្ច មេដឹកនាំ ធំ ៗ មួយចំនួន ។
នាយក គ្រប់គ្រង នៅ ក្រុមហ៊ុន លក់ រថយន្ត MAZDA រូប នេះ បាន បន្ថែម ទៀត ថា លើស ពី នោះ ទៀត ដើម្បី ផ្តល់ នូវ ភាពសប្បាយរីករាយ ក៏ ដូចជា ការជួបជុំ រីករាយ បង្កើត មិត្តភាព និង ទំនាក់ទំនង យ៉ាង ជិតស្និត រវាង គ្នា និង គ្នា ។
រទេះ គោ ខ្មែរ កំពុង បម្រើការ ក្នុង វិស័យ ទេសចរណ៍ នា ពេល បច្ចុប្បន្ន
( កំពង់ឆ្នាំង ) ៖ បើ គេ និយាយ ពី រទេះ គោ ខ្មែរ ជនជាតិ ខ្មែរ គ្រប់ រូប ទាំង ក្មេង ទាំង ចាស់ ពិតជា ស្គាល់ និមិត្តរូប របស់ វា យ៉ាង ច្បាស់លាស់ ព្រោះ រទេះ គោ បាន មាន វត្តមាន នៅលើ ទឹកដី អច្ឆរិយៈ នៃ យើង តាំងពី សម័យ បុរេ អង្គរ ក៏ ដូចជា សម័យ អង្គរ ដែរ ដែល កាល ណោះរទេះ គោ បាន បំពេញ តួនាទី យ៉ាង សំខាន់ បំផុត ក្នុង សង្គម ខ្មែរ មិន ត្រឹមតែ ក្នុង ផ្នែក សង្គមកិច្ច ប៉ុណ្ណោះ ទេ ក៍ ប៉ុន្តែ ពាក់ព័ន្ធ ទៅនឹង វិស័យ ជំនឿ សាសនា ផងដែរ ។
តាំងពី ដើម សតវត្សរ៍ ទី១ រហូតមកដល់ សព្វ ថ្ងៃ រទេះ គោ ខ្មែរ នៅតែ ជា ទី ពេញនិយម សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ នៅក្នុង ការដឹកជញ្ជូន កសិផល ផ្សេង ៗ ។ ជាក់ស្តែង ប្រជាពលរដ្ឋ ចំនួន ៣ភូមិ ក្នុង ឃុំ កំពង់ត្រឡាច បាន និង កំពុង ប្រើប្រាស់ រទេះ គោ ខ្មែរ ដើម្បី ដឹក ភ្ញៀវ ទេសចរណ៍ ក្នុង ការរក ចំណូល សម្រាប់ ផ្គត់ផ្គង់ ជីវភាព គ្រួសារ បាន មួយ ផ្នែក ផងដែរ ។
ក្រៅពីមុខរបរ ធ្វើ ស្រែ វស្សា ស្រែ ប្រាំង ធ្វើ ចំការ និង នេសាទ ប្រជាពលរដ្ឋ នៅ បាន ចាប់ យក មុខរបរ នេះ អស់ រយៈពេល ជិត ១៩ ឆ្នាំ មកហើយ ដែល ចំណូល ពី ការដឹក ភ្ញៀវ ទេសចរណ៍ ក្នុង ១ ថ្ងៃ ៗ បាន ប្រមាណ ពី ១០ទៅ ១៥ ដុល្លារ ទៅ តាម កំណើន ភ្ញៀវ ឡើង ចុះ តែ ពេលនេះ ពួកគាត់ បាន បង្កើត ជា សហគមន៍ មួយ ហើយ ក្នុង ភូមិ ទាំង៣ នោះ ។
លោក នូ ផល្គុន អនុប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត កំពង់ឆ្នាំង បាន ឲ្យដឹង ថា នៅក្នុង ស្រុក កំពង់ត្រឡាច រមណីយដ្ឋាន ដែល ភ្ញៀវ ទេសចរ បរទេស ចូលចិត្ត មក ទស្សនា នោះ គឺ វត្ត កំពង់ត្រឡាច លើ ឬ វត្ត ពោធិរុក្ខា រាម ព្រោះ វត្ត នេះ បាន កសាងឡើង តាំងពី ឆ្នាំ ១៦៧២ មាន ព្រះវិហារ មួយ ត្រូវបាន គេ សាងសង់ ឡើង ដោយ មាន ខឿន ជា ថ្ម បាយ ក្រៀម និង រូប គំនូរ តាម ជញ្ជាំង វិហារ តាំងពី ឆ្នាំ ១៨៤៧ និង ម្យ៉ាងទៀត គឺ គេ ចង់ ស្គាល់ ពីរ ទេះ គោ ខ្មែរ របស់ ជាតិ យើង ។
ចំណែក ភ្ញៀវ ទេសចរណ៍ ក្នុង ១ ឆ្នាំ ៗ មាន ការកើនឡើង ជាលំដាប់ ហើយ ភ្ញៀវ មក ទស្សនា ច្រើន បំផុត គឺ ក្នុង ខែ ១១និង ១២ ចំណូល នៃ ការដឹកជញ្ជូន ភ្ញៀវ របស់ ពលរដ្ឋ ទាំង ៣ភូមិ ខាងលើ នេះ មួយចំណែក ក៏ បាន ដាក់ចូល សន្សំ នៅក្នុង សហគមន៍ ផងដែរ ដើម្បី ជួល គ្រូ មក បង្រៀន ភាសា អង់គ្លេស ដល់ ពលរដ្ឋ ដែល ជា អ្នកបរ រទេះ គោ និង ចំណាយ ផ្សេង ៗ ទៀត ។
លោក បាន បន្ត ថា នៅ ថ្ងៃ ខាងមុខ មន្ទីរ មាន គំរោង រៀបចំ ជា សម្លៀកបំពាក់ ខោ ចែវ អាវ បំពង់ តាម ប្រពៃណី ខ្មែរ ជូន បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង សហគមន៍ នោះ ដើម្បីឲ្យ ភ្ញៀវ ទេសចរណ៍ បាន ស្គាល់ ពី សំលៀកបំពាក់ បុរាណ ខ្មែរ និង រៀបចំ ឲ្យ ប្រជាពលរដ្ឋ តាំង វត្ថុអនុស្សាវរីយ៍ ដែល ជា ស្នាដៃ ខ្មែរ លក់ ជូន ភ្ញៀវ ក្នុង តំលៃ សមរម្យ ទៀតផង ៕ ព្យុះភ្លៀង កំពុង គំរាមកំហែង បណ្តា រដ្ឋ ភាគ ខាងកើត អូស្ត្រាលី បន្ថែម ពីលើ មហន្តរាយ ភ្លើង ឆេះ ព្រៃ (Photo inside)
( ស៊ីដនី ) ៖ ព្យុះភ្លៀង លាយឡំ ជាមួយ រន្ទះ បាញ់ បាន វាយប្រហារ លើ តំបន់ ឆ្នេរ ភាគ ស្ថិត នៅ ខាងកើត ប្រទេស អូស្ត្រាលី នៅ ព្រឹក ថ្ងៃសៅរ៍ ទី១៨ ខែមករា ឆ្នាំ ២០២០ នេះ ដោយ បង្ក ជា គ្រោះ ទឹក ជំនន់ និង បាន បង្ខំ ផ្លូវ សំខាន់ ៗ មួយចំនួន ត្រូវ ផ្អាក ចរាចរណ៍ ជា បណ្ដោះអាសន្ន ខណៈ ក្រុម អ្នក ពន្លត់ អគ្គីភ័យ កំពុង បន្ត តស៊ូ ប្រយុទ្ធ នឹង អណា្តត ភ្លើង ឆេះ ព្រៃ ជិត ១០០ កន្លែង ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ពី ទីភ្នាក់ងារ ព័ត៌មាន Reuters ។
ទោះបីជា យ៉ាងណា ក៏ដោយ មិន ទាន់ មាន សេចក្ដីរាយការណ៍ ពី ជនរងគ្រោះ ណា ម្នាក់ ឬ ការបំផ្លិចបំផ្លាញ នៅឡើយ ទេ តែ ភ្លៀង ធ្លាក់ ខ្លាំង ឬ ទឹក ជំនន់ អាចនឹង កើតឡើង ជាថ្មី នៅ រដ្ឋ Victoria ដែល កំពុង ដោះស្រាយ បញ្ហា ផ្សែង ពុល បង្កឡើង ដោយ ភ្លើង ឆេះ ព្រៃ ៕
ឆ្នាំ ថ្មី មីជាតិ បញ្ចេញ ស្នាដៃ ថ្មី ៣រសជាតិ ក្នុង កេស តែ មួយ !
( ភ្នំពេញ ) ៖ មី ជាតិ បញ្ចេញ ស្នាដៃ ថ្មី ៣រសជាតិ ក្នុង កេស តែ មួយ ជាមួយ តម្លៃ ប្រម៉ូសិន ដើម្បី អបអរសាទរ ក្នុង ឱកាស ឆ្នាំ ថ្មី ឆ្នាំ ២០២០ និង ចូល ឆ្នាំ ប្រពៃណី ចិន នៅ ចុង ខែមករា ខាងមុខ នេះ ។
កេស មីជាតិ សម្រាប់ ប្រូម៉ូសិន ថ្មី នេះ ត្រូវបាន ឌីហ្សាញ ដោយ ប្រើ ពណ៌ ការ៉ុត ឆើត ដែល ងាយស្រួល ចំណាំ និង រកមើល នៅលើ ទីផ្សារ ដោយ ក្នុង មួយ កេស មាន មី ជាតិ រសជាតិ សាច់ ជ្រូក ចិញ្រ្ចាំ ១០កញ្ចប់ រសជាតិ ស៊ុប មាន់ ១០កញ្ចប់ និង រសជាតិ ខគោ១០ កញ្ចប់ ។
លោក ពន្យល់ ថា « ធម្មតា បើ គិត ជា កេស មីជាតិ រសជាតិ ខ គោ មាន តម្លៃ ថ្លៃ ជាង រសជាតិ ស៊ុប មាន់ និង សាច់ ជ្រូក ចិញ្រ្ចាំ បន្តិច ប៉ុន្តែ តម្លៃ ជា កេស សម្រាប់ ប្រម៉ូសិន ថ្មី នេះ គឺ ស្មើនឹង តម្លៃ មីជាតិ រសជាតិ ស៊ុប មាន់ និង សាច់ ជ្រូក ចិញ្រ្ចាំ ដែល ធ្វើឲ្យ ចំណេញ សម្រាប់ អ្នកទិញ ទៅ បរិភោគ ខ្លូន ឯង និង ទៅ លក់ រាយ បន្ត » ។ លោក បន្ត ថា ស្តុក សម្រាប់ ប្រូម៉ូសិន នេះ ក៏ មាន កំណត់ ផងដែរ ដូច្នេះ គួរ រួសរាន់ ឡើង មុនពេល មីជាតិ ប្រូម៉ូសិន នេះ មុន អស់ ពី ស្តុក ។
គួរ បញ្ជាក់ ផងដែរ ថា មីជាតិ ជា ផលិតផល មី កញ្ចប់ របស់ ខ្មែរ ដែល មាន រសជាតិ បែប ខ្មែរ ដំបូង គេ បង្អស់ នៅ ប្រទេស កម្ពុជា និង ត្រូវបាន ផលិត ឡើង ដោយ ប្រើប្រាស់ ម៉ាស៊ីន ជប៉ុន និង បច្ចេកវិទ្យា ជប៉ុន ដើម្បី ធានា ឲ្យបាន គុណភាព ខ្ពស់ ស្រប តាម បទដ្ឋាន អន្តរជាតិ ។ មីជាតិ មាន បី រសជាតិ គឺ សាច់ ជ្រូក ចិញ្ច្រាំ ស៊ុប មាន់ និង ខគោ ។ មីជាតិ ស្នាដៃ ខ្មែរ រសជាតិ ខ្មែរ ៕ The Palms គម្រោង លំនៅឋាន បែប លំហែ រកាយ ដំបូង នៅក្នុង រាជធានី ភ្នំពេញ
កត្តា នេះ ជួយ បង្ក ភាពងាយស្រួល ទៅដល់ អ្នក រស់ នៅក្នុង គម្រោង នេះ ព្រោះ ពួកគេ អាច ធ្វើដំណើរ បាន យ៉ាង ងាយស្រួល ទៅ តំបន់ នានា ក្នុង រាជធានី ភ្នំពេញ តាមរយៈ មហាវិថី ព្រះនរោត្តម មហាវិថី ព្រះមុនីវង្ស និង មហាវិថី សម្តេច ហ៊ុន សែន ។
( ភ្នំពេញ ) ៖ សាស្រ្តាចារ្យ ធា គ្រុយ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការត្រួតពិនិត្យ ខ្លឹមសារ ផ្សព្វផ្សាយ លក់ ផលិតផល សម្រាប់ ចិញ្ចឹម ទារ និង កុមារ បាន ថ្លែង ជំរុញ ដល់ គ្រូពេទ្យ ទូទាំង ប្រទេស ត្រូវតែ ពន្យល់ ណែនាំ បន្ថែម ទៀត ដល់ មាតា អាណាព្យាបាល ពី សារៈសំខាន់ នៃ ការបំបៅ ទឹក កូន ដោយ ទឹកដោះ ម្ដាយ មួយ គត់ ដល់ កូន ទើប សម្រាល រួម ភ្លាម ៗ ។
លោក សាស្រ្ដាចារ្យ បន្ដ ថា ផលប្រយោជន៍ និង ឧត្តមភាព នៃ ការបំបៅ កូន ដោយ ទឹកដោះ ម្តាយ គឺ សំខាន់ ណាស់ សម្រាប់ ជីវិត ទារក ទើប ប្រសូត រួម ភ្លាម ៗ ដូច ខ្លឹមសារ ក្នុង អនុក្រឹត្យ លេខ ១៣៣ បាន ចែង ថា « គ្មាន អ្វី ប្រសើរ ជាង ការបំបៅ កូន ដោយ ទឹកដោះ ម្តាយ តែ មួយ មុខ គត់ រហូត បាន ៦ខែ និង បន្ត ការបំបៅ ដោះ ម្តាយ រហូត បាន អាយុ២ ឆ្នាំ ឬ លើស » ។
ការថ្លែង បែប នេះ រដ្ឋលេខាធិការ រូប នេះ ក្នុង ឱកាស រៀបចំ កិច្ចប្រជុំ ពី ការពង្រឹង ការអនុវត្ដ តាម ខ្លឹមសារ អនុក្រឹត្យ លេខ ១៣៣ អន ក្រ. បក ស្តីពី ការផ្សព្វផ្សាយ លក់ ផលិតផល សម្រាប់ ចិញ្ចឹម ទារ ក និង កុមារ ដែល ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង សុខាភិបាល ថ្មី ៗ នេះ ចូលរួម ដោយ ម្ចាស់ និង តំណាង ក្រុមហ៊ុន ចែកចាយ លក់ ផលិតផល សម្រាប់ ចិញ្ចឹម ទារ ក និង កុមារ ( ផលិតផល ទឹកដោះគោ ម្សៅ ដប បំបៅ ក្បាល ដោះ ជ័រ ជាដើម ) ចំនួន ៣២ ក្រុមហ៊ុន និង មន្រ្តី សុខាភិបាល សរុប ចំនួន ៥៨ នាក់ ទៀត ។
ក្នុង ឱកាស នោះ លោក សាស្ដ្រាចារ្យ ធា គ្រុយ ក៏ បាន បង្ហាញ ចំនុច សហការ ល្អ របស់ ក្រុមហ៊ុន មួយចំនួន និង ចំនុច ខ្វះចន្លោះ របស់ ក្រុមហ៊ុន មួយចំនួន តូច ដែល ត្រូវ បំពេញ បន្ថែម ។ ដោយ ចង់ឱ្យ ក្រុមហ៊ុន នាំចូល និង ចែកចាយ លក់ ផលិតផល សម្រាប់ ចិញ្ចឹម ទារ ក និង កុមារ ទាំងអស់ អនុវត្ត ការផ្សព្វផ្សាយ លក់ ផលិតផល ក្រុមហ៊ុន ឱ្យ បាន ល្អ ត្រឹមត្រូវ ។
ជាពិសេស តាម ខ្លឹមសារ អនុក្រឹត្យ លេខ ១៣៣ អន ក្រ. បក ដែល តម្រូវ ឱ្យ មាន ការត្រួតពិនិត្យ និង អនុញ្ញាត ពី ក្រសួង សុខាភិបាល មុននឹង ធ្វើ ការផ្សព្វផ្សាយ ។ ជា ការកត់សំគាល់ ម្ចាស់ និង តំណាង ក្រុមហ៊ុន ចូលរួម ទាំងអស់ បាន ឯកភាព និង សហការ ល្អ ជាមួយ ក្រសួង សុខាភិបាល ៕ ឱកាស បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ដើម្បី ការងារ និង មុខរបរ នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស
ព្រឹក ស្អែក នេះ លោក ហ៊ុន ម៉ានី ដឹកនាំ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត ជាង ៥០០ នាក់ ចុះ ពិនិត្យ ព្យាបាល ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ នៅ ស្រុក ឧដុង្គ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ លោក ហ៊ុន ម៉ានី តំណាងរាស្ត្រ មណ្ឌល កំពង់ស្ពឺ . ប្រធាន គណៈកម្មការ ទី៧ រដ្ឋសភា និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១៩ ខែមករា ឆ្នាំ ២០២០ ស្អែក នេះ នឹង ដឹកនាំ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត របស់ លោក ចំនួន ៥២២ នាក់ បន្ត ចុះ ពិនិត្យ ព្យាបាល ជំងឺ និង ចែកជូន អំណោយ ថ្នាំ ពេទ្យ ដោយ ឥត គិត ថ្លៃ ដល់ ប្រជាពលរដ្ឋ ប្រមាណ ជាង ២ពាន់ នាក់ នៅ សាលា បឋមសិក្សា ប្រជុំ មិត្ត ភូមិ ខ្វិត ឃុំ ពាំងល្វា ស្រុក ឱដុង្គ ខេត្ត កំពង់ស្ពឺ ។
បើ តាម លោក លេង ផាលី ប្រធាន ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី បាន ឲ្យដឹង ថា « មិន ថា រដូវ ប្រាំង ឬ វស្សា ឆ្ងាយ ឬ ជិត ទោះបីជា ការងារ មមាញឹក យ៉ាងណា ក៏ដោយ ក៏ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ក្រោម ការដឹកនាំ និង ចង្អុលបង្ហាញ យ៉ាង ឈ្លាសវៃ របស់ លោក ហ៊ុន ម៉ានី នៅតែ បន្ត ចុះ ទៅ ព្យាបាល ជូន ប្រជាពលរដ្ឋ មិន ខ្លាច ពី ភាពនឿយហត់ ព្រោះតែ ចង់ ឃើញ បងប្អូ ប្រជាពលរដ្ឋ មាន សុខភាព ល្អ » ។
រុស្ស៊ី៖ « អាមេរិក គឺជា មេបង្ក ភាពវឹកវរ នៅ ទូទាំង ពិភពលោក »
លោក Lavrov ដែល បាន កាន់ តំណែង ជា ប្រមុខ ការទូត រុស្ស៊ី ចាប់តាំងពី ឆ្នាំ ២០០៤ មក នោះ បាន ប្រាប់ អ្នកសារព័ត៌មាន នៅ ថ្ងៃសុក្រ សប្ដាហ៍ នេះ ទៀត ថា វិមាន ក្រឹមឡាំង មិន សប្បាយ ចិត្ត ទាល់តែសោះ ចំពោះ គោល នយោបាយ ការបរទេស របស់ សហរដ្ឋ អាមេរិក ពាក់ព័ន្ធ នឹង អ៉ីរ៉ង់ តំបន់ មជ្ឈិមបូព៌ា ជាពិសេស គឺ ការគ្រប់គ្រង ឬ រឹតត្បិត អាវុធ នុយក្លេអ៊ែរ តែម្ដង ។
លោក Lavrov បាន គូសបញ្ជាក់ ដូច្នេះ ថា « ពិភពលោក នៅតែ បន្ត ស្ថិត នៅក្នុង ភាពវឹកវរ ហើយ សហរដ្ឋ អាមេរិក និង សម្ព័ន្ធមិត្ត លោក ខាងលិច មួយចំនួន របស់ ពួកគេ គឺជា អ្នកទទួលខុសត្រូវ លើ ស្ថានភាព ដូច សព្វ ថ្ងៃ នេះ ... ដ្បិត ពួកគេ បាន និង កំពុង បំផ្លាញ ក៏ ដូចជា ព្យាយាម ផ្លាស់ប្ដូរ សន្តិសុខ សណ្ដាប់ធ្នាប់ ពិភពលោក បង្កើតឡើង ដោយ ច្បាប់ អន្តរជាតិ ជាមួយ សណ្ដាប់ធ្នាប់ ថ្មី មួយ ដែល ពួកគេ ជា អ្នកបង្កើតឡើង ដោយ ខ្លួន ឯង » ។
រដ្ឋមន្ដ្រី សុខាភិបាល៖ អគារ សិក្សា ថ្មី កម្ពស់ ៨ជាន់ នឹង លេច រូបរាង ខាងមុខ នេះ នឹង ជួយ ពង្រឹង គុណភាព ស្ដង់ដារ អន្ដរជាតិ ផ្ដល់ សេវា ជូន ពលរដ្ឋ
( ភ្នំពេញ ) ៖ រដ្ឋមន្ដ្រី ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ថ្លែង ថា អគារ សិក្សា ថ្មី កម្ពស់ ៨ជាន់ របស់ សាកលវិទ្យាល័យ វិទ្យាសាស្ដ្រ សុខាភិបាល ដែល បាន ចាប់ផ្ដើម សាងសង់ ហើយ គ្រោង នឹង បញ្ចប់ ជាស្ថាពរ នៅ រយៈពេល ២ឆ្នាំ ខាងមុខ នេះ នឹង ជួយ បង្កើន ការបណ្ដុះបណ្ដាល ធនធាន មនុស្ស ប្រកបដោយ សមត្ថភាព ខ្ពស់ គុណធម៌ និង ក្រមសីលធម៌ វិជ្ជាជីវៈ ដើម្បី ផ្តល់ ការថែទាំ ព្យាបាល ដល់ ប្រជាពលរដ្ឋ យើង ដោយ ពុំ មាន ភាព រើសអើង និង ប្រកបដោយ ទំនុកចិត្ត ខ្ពស់ ។
ជាពិសេស ស្រប ពេល ជាមួយគ្នា នឹង ការលេច រូបរាង តំណាល គ្នា នៃ មន្ទីរពេទ្យ កាល់ម៉ែត ដែល នឹង បញ្ចប់ ការសាងសង់ ជា នៅពេល ២ឆ្នាំ ខាងមុខ នេះ ដូច្នេះ វិស័យ សុខាភិបាល យើង នឹង កាន់តែ ឈាន ទៅកាន់ ស្ដង់ដារ ក្នុង ការផ្ដល់ សេវា ពិនិត្យ ព្យាបាល ជូន អ្នកជំងឺ ។
ការថ្លែង បែប នេះ របស់ រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង ក្នុង ពិធី បញ្ចុះ បឋមសិលា សាងសង់ អគារ ថ្មី កម្ពស់ ៨ជាន់ នៅ ទីតាំង ទី១ នៃ សាកលវិទ្យាល័យ វិទ្យាសាស្រ្ត សុខាភិបាល នៅ រសៀល ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ ។
រដ្ឋមន្ដ្រី សុខាភិបាល បាន ថ្លែង បន្ដ ថា « ការរីកលូចលាស់ នូវ អគារ សិក្សា មន្ទីរពេទ្យ ស្ដង់ដារ គឺ ស្រប ទៅនឹង ការខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី កម្ពុជា ដែល បាន យកចិត្តទុកដាក់ ខ្ពស់ និង កំណត់ ជា អាទិភាព លើ ការកសាង ធនធាន មនុស្ស ប្រកបដោយ គុណភាព ជាពិសេស ការកសាង ធនធាន មនុស្ស ក្នុង វិស័យ សុខាភិបាល » ។
ក្នុង នោះ ក្រសួង សុខាភិបាល បាន ដាក់ចេញ នូវ យុទ្ធសាស្រ្ត ជាច្រើន សម្រាប់ ការពង្រឹង គុណភាព បណ្តុះបណ្តាល ក្នុង វិស័យ សុខាភិបាល និង ធានា បាន ថា ធនធាន មនុស្ស ដែល បាន ផលិត ទាំងនោះ ប្រកបដោយ សមត្ថភាព ខ្ពស់ គុណធម៌ ឥរិយាបទ ល្អ ប្រកបដោយ ក្រមសីលធម៌ វិជ្ជាជីវៈ ដើម្បី ផ្តល់ ការថែទាំ ព្យាបាល ដល់ ប្រជាពលរដ្ឋ យើង ដោយ ពុំ មាន ភាព រើសអើង និង ប្រកបដោយ ទំនុកចិត្ត ខ្ពស់ ។
រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង ថ្លែង បន្ដ ថា ដើម្បី សម្រេចបាន នូវ យុទ្ធសាស្រ្ត នេះ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ សម្រាប់ ការបណ្តុះបណ្តាល ក្នុង វិស័យ វិទ្យាសាស្រ្ត សុខាភិបាល ដែល ជា តម្រូវ ការចាំបាច់ សម្រាប់ គ្រឹះស្ថាន បណ្តុះបណ្តាល ។ « ជាក់ស្តែង កន្លងមក នេះ យើង បាន កសាង អគារ បន្ថែម ជា បន្តបន្ទាប់ បាន ពង្រឹង ការបង្រៀន និង រៀន នៅ សាកលវិទ្យាល័យ វិទ្យាសាស្រ្ត សុខាភិបាល ដោយ ពង្រីក បន្ថែម មន្ទីរពិសោធន៍ បង្ហាញ ត្រាប់ បំពាក់ នូវ សម្ភារ ឧបករណ៍ ទំនើប ៗ សម្រាប់ ការអនុវត្ត របស់ និស្សិត » ។
លោក បន្ដ ថា « យើង ក៏ បាន ពង្រីក ហេដ្ឋារចនាសម្ព័ន្ធ ផ្សេង ៗ ទាំង បណ្ណាល័យ គ្លីនីក ទន្តសាស្រ្ត មណ្ឌល ធ្វើ រោគវិនិច្ឆ័យ មន្ទីរពិសោធន៍ ផលិត ថ្នាល បណ្តុះ មេរោគ ដើម្បី ផ្តល់ ឱកាស ឲ្យ និស្សិត យើង មាន លទ្ធភាព សិក្សា និង ធ្វើ កម្មសិក្សា ។ ខ្ញុំ សង្ឃឹម ថា អគារ សិក្សា ថ្មី ដែល នឹង ចាប់ផ្តើម សាងសង់ នេះ នឹង បន្ថែម លទ្ធភាព ដល់ សាកលវិទ្យាល័យ មួយ នេះ ក្នុង ការធ្វើឲ្យ ការបណ្តុះបណ្តាល ការស្រាវជ្រាវ និង ការផ្តល់ សេវា របស់ ខ្លួន កាន់តែ មាន ភាពប្រសើរឡើង និង ឆ្លើយតប បាន ទៅនឹង ស្តង់ដារ ជាតិ និង អន្តរជាតិ » ។
ទន្ទឹមនឹង អគារ ថ្មី នេះ « យើង នឹង ខិតខំ ប្រឹងប្រែង បន្ដ ទៀត ដោយ ធ្វើ យ៉ាងណា ស្វែងរក ដៃគូ ឆ្នើម ៗ និង បន្ដ រឹត ចំណង កិច្ចសហប្រតិបត្ដិការ ជាមួយ ដៃគូ អភិវឌ្ឍ ដែល មាន ស្រាប់ ដើម្បី ជួយ បង្កើន គុណភាព ធនធាន មនុស្ស ក្នុង វិស័យ សុខាភិបាល កម្ពុជា យើង ឈាន ទៅ លក្ខណៈ ស្ដង់ដារ អន្ដរជាតិ និង ប្រសិទ្ធិភាព ខ្ពស់ ក្នុង ការផ្ដល់ ពិនិត្យ ព្យាបាល ថែទាំ ជូន ពលរដ្ឋ យើង » ។
ជាមួយគ្នា នោះ ដែរ សាកលវិទ្យាធិការ សាកលវិទ្យាល័យ វិទ្យាសាស្ដ្រ សុខាភិបាល លោក សាស្ដ្រាចារ្យ សា ផុន វឌ្ឍនៈ បាន ថ្លែង ថា សាកលវិទ្យាល័យ វិទ្យាសាស្ដ្រា សុខាភិបាល បាន ឈាន ទៅ រក ឧត្ដម ភាព ក្នុង ការបណ្ដុះបណ្ដាល ការស្រាវជ្រាវ និង ផ្ដល់ សេវា នៅ កម្ពុជា ដែល ជា ការចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍ ធនធាន មនុស្ស ប្រកបដោយ សមត្ថភាព និង សីលធម៌ ខ្ពស់ ដើម្បី ធានា ឲ្យបាន ប្រសិទ្ធភាព នៃ សេវា សាធារណៈ សំដៅ បម្រើ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ ប្រសើរឡើង ។
ជាង នេះ ទៅ ទៀត ដើម្បី បន្ដ ជួយ ពង្រីក ធនធាន មនុស្ស ឱ្យ កាន់តែ មាន សមត្ថភាព ដូច្នេះ ការសាងសង់ អគារ សិក្សា ថ្មី មួយ នេះ នឹង ឆ្លើយតប នឹង តម្រូវការ ក្នុង ការរៀន និង បង្រៀន របស់ យើង ឱ្យ កាន់តែ មាន ប្រសិទ្ធិភាព និង គុណភាព ថែម ទៀត ។ អគារ សិក្សា ថ្មី កម្ពស់ ៨ ជាន់ នេះ គ្រោង សាងសង់ អស់ ថវិកា ជាង ២៤ម៉ឺន លាន ដុល្លារ ថវិកា ផ្ទាល់ របស់ សាលា ដែល មាន បន្ទប់ រៀន បន្ទប់ មន្ទីរពិសោធន៍ បង្ហាញ ត្រាប់ បន្ទប់ ការិយាល័យ និង បន្ទប់ ប្រជុំ ផងដែរ ៕
សម្តេច តេជោ ហ៊ុន សែន ឆ្លៀត ហាត់ប្រាណ វាយ កូនគោល នៅ ថ្ងៃ សម្រាក ចុង សប្តាហ៍ !
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ព្រលឹម ថ្ងៃសៅរ៍ ទី១៨ ខែមករា ឆ្នាំ ២០២០ នេះ បាន បង្ហោះ រូបថត សម្តេច អញ្ជើញ វាយ កូនគោល និង សារ ជូនពរ បងប្អូន ជន រួម ជាតិ ឲ្យ ជួប តែ សេចក្តី សេចក្តីសុខ សេចក្តី ចំរើន ក្នុង ឱកាស ថ្ងៃ ចុង សប្តាហ៍ នេះ ។
ធនាគារ ជាតិ នៃ កម្ពុជា៖ តម្រូវការ នៃ ប្រាក់ រៀល កើនឡើង ជាលំដាប់ បាន ជួយ បន្ទាប កម្រិត ដុល្លារូបនីយកម្ម !
( ភ្នំពេញ ) ៖ យោង តាម សេចក្ដីប្រកាស ព័ត៌មាន ចេញផ្សាយ ដោយ ធនាគារ ជាតិ នៃ កម្ពុជា (NBC) ក្នុង កម្មវិធី សន្និបាត បូកសរុប លទ្ធផល ការងារ ប្រចាំ ឆ្នាំ ២០១៩ និង ទិសដៅ ការងារ ឆ្នាំ ២០២០ បាន បង្ហាញ ឲ្យ តម្រូវការ នៃ ការប្រើប្រាស់ ប្រាក់ រៀល បាន កើនឡើង ជាលំដាប់ ក្នុង ឆ្នាំ ២០១៩ ។
លោក ជា ចាន់តូ អគ្គ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា បាន ឲ្យដឹង ថា ដើម្បី លើកស្ទួយ ការប្រើប្រាស់ ប្រាក់ រៀល ធនាគារ ជាតិ នៃ កម្ពុជា បាន ដាក់ចេញ នូវ វិធានការ ជាច្រើន ដែល បាន ផ្ដល់ ផល វិជ្ជមាន ដល់ ការប្រើប្រាស់ ប្រាក់ រៀល ក្នុង វិស័យ សេដ្ឋកិច្ច ។
លោក ជា ចាន់តូ បាន បញ្ជាក់ ថា « ដោយ ឃើញ ពី ភាពវិជ្ជមាន ក្នុង ការប្រើប្រាស់ ប្រាក់ រៀល នេះ ខ្ញុំ សូម ស្នើ អគ្គ នាយកដ្ឋាន ទាំងអស់ បន្ដ វិធានការលើកកម្ពស់ ការប្រើប្រាស់ ប្រាក់ រៀល ជាប្រចាំ ដែល ពង្រឹង អភិវឌ្ឍន៍ វិធានការ ដែល មាន ស្រាប់ និង ដាក់ចេញ នូវ វិធានការ ថ្មី ៗ ដោយ ផ្អែក លើ សកម្មភាព ជាក់ស្ដែង និង សន្សឹម ៗ ទៅ តាម ការរីកចម្រើន នៃ វិស័យ សេដ្ឋកិច្ច » ។
លោក បាន បន្ថែម ថា វិស័យ ធនាគារ បាន បន្ដ ភាពរីកចម្រើន និង ទទួលបាន ទំនុកចិត្ត ពី សាធារណជន និង វិនិយោគិន ដែល ឆ្លុះបញ្ចាំង តាមរយៈ កំណើន ដ៏ អស្ចារ្យ នៃ ចំនួន អតិថិជន ។
សូម ជម្រាប ថា វិស័យ ធនាគារ បាន បន្ត រីកចម្រើន យ៉ាង ឆាប់រហ័ស ដែល រួមចំណែក យ៉ាង សកម្ម គាំទ្រ ការរីកចម្រើន នៃ សេដ្ឋកិច្ច ។ ទ្រព្យ សកម្ម របស់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ បាន កើនឡើង ២៤. ៥% ហើយ ឥណទាន បាន កើន ២៦% ។
បណ្តាញ ប្រតិបត្តិការ និង ពិពិធកម្ម សេវា ហិរញ្ញវត្ថុ របស់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ត្រូវបាន បន្ត ពង្រឹង និង បាន ជួយ ជំរុញ បរិយា បន្ន ហិរញ្ញវត្ថុ នៅ កម្ពុជា បច្ចុប្បន្ន ចំនួន គណនី ប្រាក់ បញ្ញើ កើន ដល់ ប្រមាណ ៧. ៥លាន គណនី និង គណនី ឥណទាន កើន ដល់ ៣. ១លាន គណនី ។
ប្រព័ន្ធ ទូទាត់ ត្រូវបាន ធ្វើ ទំនើបកម្ម ស្រប តាម ការរីកចម្រើន បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ ដើម្បី បង្កើន ប្រសិទ្ធភាព នៃ ការទូទាត់ ប្រកបដោយ ឆាប់រហ័ស សុវត្ថិភាព និង ងាយស្រួល ។ បច្ចុប្បន្ន ប្រជាជន ប្រមាណ ៥លាន នាក់ កំពុង ប្រើប្រាស់ សេវា ទូទាត់ សង ប្រាក់ តាម អេឡិចត្រូនិក ៕
លោក សុខ នីម បាន បញ្ជាក់ ថា តំបន់ នៃ ខណ្ឌ ចំនួន ៤ ក្នុង រាជធានី ភ្នំពេញ នៅតែ បន្ត មាន ផល វិជ្ជមាន ចំណេញ ច្រើន ចំពោះ អ្នក វិនិយោគ លើ វិស័យ អចលន វត្ថុ នៅ ឆ្នាំ ថ្មី ២០២០ នេះ ។
ជាមួយគ្នា នេះ លោក ប្រធាន សមាគម បាន ពន្យល់ វិធី ក្នុង ការមើល ទីតាំង ឬ តំបន់ ដែល ចង់ វិនិយោគ ដើម្បី ការពារ នូវ ហានិភ័យ ដែល អាច និយាយ បាន ថា កុំ ទិញ ហើយ ខាត ។
សូម ទស្សនា វីដេអូ ទាំងស្រុង ដូច ខាងក្រោម៖
ធនាគារ អេស៊ីលីដា ចូលរួម យ៉ាង សកម្ម ក្នុង ការពង្រីក ចំណេះដឹង ស្ដីពី ផ្សារ មូលបត្រ ក្រោយ ប្រកាស បោះ លក់ ភាគហ៊ុន
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ការប្រកាស ឈានជើង ចូលក្នុង ផ្សារ មូលបត្រ ធនាគារ អេស៊ីលីដា ភី អិល ស៊ី បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការពង្រីក ចំណេះដឹង ស្ដីពី ផ្សារ មូលបត្រ កម្ពុជា ជូន សាធារណជន ជា បន្ដ បន្ទាប់ ។
ក្នុង នោះ ធនាគារ អេស៊ីលីដា ភី អិល ស៊ី បាន រៀបចំ សិក្ខាសាលា ជា បន្តបន្ទាប់ ដើម្បី អញ្ជើញ វិនិយោគិន អតិថិជន និង ប្រជាពលរដ្ឋ ដែល មាន ចំណាប់អារម្មណ៍ ក្នុង ការវិនិយោគ ជាមួយ អេស៊ីលីដា ក្នុង វិស័យ មូលបត្រ មក ទទួលយក ចំណេះដឹង ថ្មី ៗ បន្ថែម ទៀត ។
លោក បណ្ឌិត អ៉ិន ចាន់ នី ប្រធាន នាយក ប្រតិបត្តិ ធនាគារ អេស៊ីលីដា ឲ្យដឹង ថា « នេះ ជា លើក ទី៤ ហើយ ដែល ធនាគារ អេស៊ីលីដា ភី អិល ស៊ី បាន រៀបចំ សិក្ខាសាលា ស្ដី អំពី ការបោះផ្សាយ លក់ មូលបត្រ កម្មសិទ្ធិ លើក ដំបូង ជាសាធារណៈ ដោយ ក្នុង រយៈពេល ៤លើក នេះ ធនាគារ អេស៊ីលីដា ទទួលបាន អតិថិជន ចូលរួម ប្រមាណ ៦០០ នាក់ » ។
លោក បណ្ឌិត អ៉ិន ចាន់ នី បាន បញ្ជាក់ ថា ក្នុង ចំណោម សិក្ខាកាម ជាង ៦០០ នាក់ នេះ ក៏ មាន មួយ សិក្ខាកាម មួយ ចំនួន បើក គណនី ជួញដូរ ភ្លាម ៗ ខណៈ ប្រជាពលរដ្ឋ កម្ពុជា ជាច្រើន ពាន់ នាក់ ទៀត បាន បើក គណនី សម្រាប់ ជួញដូរ នៅ ខាងក្រៅ រួចរាល់ហើយ ផងដែរ ។
លោក បណ្ឌិត បន្ថែម ថា « ជា តួលេខ ក្នុង វិស័យ មូលបត្រ ទាំងមូល មាន ២២.០០០ គណនី បាន មក ចុះឈ្មោះ ជួញដូរ ក្នុង នោះ មាន ១៦០០០ គណនី បាន បើក ជាមួយ ធនាគារ អេស៊ីលីដា និង ចំនួន ៤ពាន់ គឺជា គណនី ថ្មី ដែល បើក ជាមួយ អេស៊ីលីដា ផង និង ក្រុមហ៊ុន ផ្សេង ៗ ផង » ។
លោក បណ្ឌិត បន្ថែម ថា ក្រៅពី សិក្ខាសាលា ធនាគារ អេស៊ីលីដា នឹង មាន ដំណាក់ ថ្មី មួយ ទៀត ប៉ុន្ដែ ដំណាក់កាល ថ្មី នេះ ពុំ ទាន់ ប្រកាស នោះ ឡើយ គឺ រង់ចាំ អាជ្ញាធរ អនុញ្ញាត ជាមុន សិន ៕
របាយការណ៍ ដដែល បាន ឲ្យដឹង ទៀត ថា ក្រោយ CMAC ពិនិត្យ ចប់ សព្វគ្រប់ ក្រុមការងារ នៃ អគ្គ បញ្ជាការ ក្រសួង ការពារ ជាតិ បាន សម្រេច កាត់ ដ្រូន នេះ ជា បំណែក ៗ ដឹក យក ទៅ ទី បញ្ជាការ កងទ័ព ដើម្បី ពិនិត្យ និង វិភាគ បន្ត ទៀត ។
សូម ជម្រាប ថា ករណី យន្ដហោះ ដ្រូន១ គ្រឿង ដែល មាន តួ យន្តហោះ ប្រវែង ៥ម៉ែត្រ និង មាន ស្លាប សងខាង សរុប ប្រវែង ៩ម៉ែត្រ បាន ធ្លាក់ ចំកណ្ដាល ព្រៃ នៅក្នុង ភូមិ ពាម កាយ ឃុំ កោះ ស្ដេច ស្រុក គិរី សាគរ ខេត្ត កោះកុង កាលពី ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២០ តែ មិន បណ្ដាលឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ រងគ្រោះថ្នាក់ នោះ ទេ ៕ ការប្រកួតប្រជែង អត្ថបទ របស់ ស្ថានទូត ចិន៖ កំណាព្យ លំនាំ បទ កាកគតិ ក្រោម ចំណងជើង « រំដួល អង្គរ ដុះ លើ កំផែង ថ្ម និរន្ដន៍ »
( ភ្នំពេញ ) ៖ ការិយាល័យ ទីប្រឹក្សា សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម នៃ ស្ថានទូត ចិន ប្រចាំ នៅ ប្រទេស កម្ពុជា បាន រៀបចំ ការប្រកួតប្រជែង អត្ថបទ « រឿង ព្រេង ប្រទេស ចិន របស់ ខ្ញុំ » ។ ខាងក្រោម នេះ ជា អត្ថបទ កំណាព្យ មួយ លំនាំបទ កាកគតិ ដែល មាន ចំណងជើង ថា « រំដួល អង្គរ ដុះ លើ កំផែង ថ្ម និរន្ដន៍ » ។
រំដួល អង្គរ រូប ស្រស់ បវរ នា ភាគ និរតី ស្ថិត ចំ កណ្ដាល កំពូល ឆើត បី មួយ ខ្ពស់ ផ្សេង ខ្លី ចែងចាំង សូរិយា ។
គ្រប់ចរណ៍ បា្រថ្នា គយ គន់ ទស្សនា ប្រាសាទ អស្ចារ្យ គ្រប់ គ្នា ត្រេកអរ អំណរ ថ្លែង សារ កេរ្តិ៍ ពី ដូន តា ប្រឹង ថែរក្សា ។
អតិត កម្ពុជា ឆ្លង ឥត គណនា ភ្លើង ពី សង្រ្គាម មាន តែ មិត្ត ចិន ផ្សេង ដក អស់ ភ្លាម គ្មាន សោះ អ្នកយាម បន្ដ ចំណង មិត្ត ។
តាំងពី អតិត ថែ ចំណង ស្និត ព្រះរតន កោដ្ឋ បន្ដ គ្មាន ក្រោធ អ៊ីប៉ាយ ឈៀន មក សម្ដេច តេជោ កម្ពុជា - ចិន ។
មួយ ខែ វាសនា បាន ទៅ សិក្សា ដែនដី ចុង ហ្គ័រ អារម្មណ៍ ត្រេកអរ ចង ចិត្ត ចាំច រ ទស្សនា ប្រាង្គ ថ្ម កំផែង មហិមា ។
២៤ឧសភា មន្ដ្រី កម្ពុជា ស្ទើរ គ្រប់ គ្នីគ្នា មន្ទីរ សាលា ស្រូបយក វិជ្ជា បច្ចេកវិទ្យា កែច្នៃ ថែរក្សា ។
ឆ្នាំ ដប់ ប្រាំមួយ ថ្ងៃ ខែ តែ មួយ បាន ភ្ជាប់ ជីវ៉ា បាន ស្គាល់ មែន ពិត កំផែង អសា្ចរ្យ ចារ កំណត់ ត្រា បេតិកភ័ណ្ឌ ។
ឈិន ម៉ាទីន ហ្វឹង ជា ទី រំពឹង ឆ្លើយឆ្លង បន្ទាន់ គ្រប់ ការគ្រប់គ្រា មិន រាតប ទាន់ មិន រារួសរាន់ កាលៈទេសៈ ។
អ្នកសម្របសម្រួល រួម មាន លោក ហ្វឹង ប្រធាន អ្នក សម្របសម្រួល លោក ម៉ាទីន និង កញ្ញា ឈិន អ្នកសម្របសម្រួល ។ កំឡុង ពេល សិក្សា សិក្ខាកាម ទាំងអស់ ត្រូវបាន នាំ ទៅ ដើរ កម្សាន្ដ ទស្សនា មហា កំផែង ដ៏ មហិមា ផងដែរ ។ សំគា ល់៖ ពាក្យ ថា « ចុង ហ្គ័រ » ជា ភាសា ចិន មាន ន័យ ថា ប្រទេស ចិន ឬ សំដៅ ដល់ សាធារណៈ រដ្ឋ ប្រជាមានិត ចិន ។
វប្បធម៌ ដ៏ ល្អ ប្រពៃណី ថ្ម សេដ្ឋកិច្ច ឆ្អៅ ឆ្អិន ចម្រើន រុងរឿង ពាណិជ្ជកម្ម ចិន កម្ពុជា នឹង ប្រាំមួយ ប៊ីលាន ។
សូម ថ្លែងអំណរ គុណ ដ៏ បវរ ប្រមុខរដ្ឋា តែងតែ មេត្តា ក រុណា មុទិតា ចំរើន ឧបេក្ខា រដ្ឋា ទាំង ទ្វេរ ។
ដោយ៖ ផុន រិណុ （PHON RENO） នាយកដ្ឋាន កសិ- ឧស្សាហកម្ម ក្រោម ឱវាទ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ។ អត្ថបទ នេះ មកពី ការប្រកួតប្រជែង អត្ថបទ អំពី « រឿង ព្រេង ប្រទេស ចិន របស់ ខ្ញុំ » ដែល រៀបចំ ដោយ ការិយាល័យ ទីប្រឹក្សា សេដ្ឋកិច្ច និង ពាណិជ្ជកម្ម នៃ ស្ថានទូត ចិន ប្រចាំ នៅ ប្រទេស កម្ពុជា ៕ សហរដ្ឋ អាមេរិក ចាប់ផ្ដើម ត្រួតពិនិត្យ អ្នកធ្វើដំណើរ នៅ តាម អាកាសយានដ្ឋាន ដើម្បី រក អ្នក មាន ផ្ទុក មេរោគ ថ្មី មកពី ចិន
អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន ពន្យល់ ទៀត ថា ការលុបចោល ពន្ធ សត្តឃាត នេះ គឺជា ការលុបចោល ប្រភេទ ពន្ធ មួយ ក្នុង ចំណោម ប្រភេទ ពន្ធ ដែល ទាក់ទិន នឹង អាជីវកម្ម សត្ត ឃាតដ្ឋាន ( កន្លែង ពិឃាត សត្វ គោ ក្របី ជ្រូក ) តែ ប៉ុណ្ណោះ មិន មែន មាន ន័យ ថា អាជីវកម្ម សត្ត ឃាតដ្ឋាន ត្រូវ រួច ផុត ពី កាតព្វកិច្ច បង់ ពន្ធ - អាករ គ្រប់ ប្រភេទ នោះ ទេ ។
យោង តាម ច្បាប់ ស្តីពី ហិរញ្ញវត្ថុ សម្រាប់ ការគ្រប់គ្រង ឆ្នាំ ២០១៦ ដែល ប្រកាស ឲ្យ ប្រើ ដោយ ព្រះរាជ ក្រម លេខ ន ស/ រក ម/ ១២១៥ / ២០១៦ របប កំណត់ ពន្ធ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវបាន កំណត់ ជា របប ស្វ័យប្រកាស ដែល បែងចែក អ្នក ជាប់ ពន្ធ ជា បី ប្រភេទ គឺ អ្នក ជាប់ ពន្ធ តូច អ្នក ជាប់ ពន្ធ មធ្យម និង អ្នក ជាប់ ពន្ធ ធំ ។
យោង តាម ប្រកាស លេខ ០២៥ សហវ . ប្រក ចុះ ថ្ងៃទី ២៤ ខែមករា ឆ្នាំ ២០១៨ ស្តីពី ការកែសម្រួល ចំណាត់ថ្នាក់ អ្នក ជាប់ ពន្ធ តាមរបប ស្វ័យប្រកាស គឺ៖
ចំពោះ អ្នក ជាប់ ពន្ធ ទាំងឡាយ ណា ដែល មាន ផល របរ ស្ថិត ក្នុង ចំណាត់ថ្នាក់ ទាំង បី ខាងលើ ត្រូវ មាន កាតព្វកិច្ចប្រកាស បង់ ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ ដែល ទាក់ទិន នឹង អាជីវកម្ម របស់ ខ្លួន ដូច ជា៖
ទី១៖ កាតព្វកិច្ច ដាក់ លិខិត ប្រកាស និង បង់ប្រាក់ ពន្ធ ប្រចាំ ខែ រួម មាន៖ * ប្រាក់ រំដោះ ពន្ធ លើ ប្រាក់ ចំណួល អាករ លើ ការស្នាក់ នៅ អាករ ពិសេស លើ ទំនិញ និង សេវា មួយចំនួន អាករ បំភ្លឺ សាធារណៈ និង ពន្ធ អាករ ដទៃ ទៀត * ពន្ធ លើ ប្រាក់ បៀវត្ស * ពន្ធ កាត់ទុក ទូទៅ * អាករ លើ តម្លៃ បន្ថែម
អគ្គ នាយកដ្ឋាន ពន្ធដារ សង្កត ធ្ងន់ ថា « អាជីវកម្ម គ្រប់ ប្រភេទ រួមទាំង អាជីវកម្ម សត្ត ឃាតដ្ឋាន ផងដែរ ឲ្យ តែ មាន ផល របរ ប្រចាំ ឆ្នាំ ចាប់ពី ២៥០ លាន រៀល ឡើង ទៅ ត្រូវ មាន កាតព្វកិច្ច បង់ ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ ស្រប តាម ច្បាប់ និង បទប្បញ្ញត្តិ ស្តីពី ពន្ធដារ ជាធរមាន ។ ដោយឡែក អាជីវកម្ម ទាំងឡាយ ណា ដែល មាន ផល របរ ប្រចាំ ឆ្នាំ ក្រោម ២៥០ លាន រៀល មិន តម្រូវឲ្យ បំពេញ កាតព្វកិច្ច បង់ ពន្ធ ប្រចាំ ខែ និង ប្រចាំ ឆ្នាំ ឡើយ »៕
ពិសេស ដើម ឆ្នាំ នេះ ! សាគូរ៉ា ប៊ុហ្វេ សាច់ អាំង និង ស៊ុប ស៊ុគី សាខា ផ្សារ ទំនើប ជីប ម៉ុង ណូរ៉ូម៉ល ជាន់ ទី៣ បញ្ចុះ តម្លៃ ២០ % ចាប់ពី ថ្ងៃ នេះ រហូតដល់ ថ្ងៃទី ២៤មករា
នេះ ជា ឱកាស មួយ ពិសេស សម្រាប់ អតិថិជន ដែល និយម ចូលចិត្ដ ពិសា សាច់ អាំង និង ស៊ុប រសជាតិ ឈ្ងុយ ឆ្ងាញ់ អនាម័យ ល្អ ជាមួយ ក្រុមគ្រួសារ មិត្ដ រួម ការងារ ជាដើម ។
រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម៖ « សន្តិភាព » បង្កើន ទំនុកចិត្ត កាន់តែ ខ្ពស់ សម្រាប់ អ្នក វិនិយោគ វិនិយោគ ជប៉ុន
( ភ្នំពេញ ) ៖ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម លោក ប៉ាន សូរស័ក្តិ បាន ទាញការកត់សម្គាល់ ថា « សុខ សន្តិភាព » និង ស្ថេរភាព នៅក្នុង សង្គម កម្ពុជា បាន ក្លាយទៅជា កត្តា ចម្បង មួយ ជួយ បង្កើន ទំនុកចិត្ត ដល់ អ្នក វិនិយោគ ឱ្យ មក វិនិយោគ នៅ កម្ពុជា កាន់តែ ច្រើន ។
លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន លើកឡើង បែប នេះ ក្នុង ពេល អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ អគារ ស្នាក់ការ កណ្តាល ក្រុមហ៊ុន តូយ៉ូតា ( ខេមបូឌា ) ដែល ទើបតែ នឹង សាងសង់ រួច នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ ។
ក្នុង ពិធី នោះ លោក ប៉ាន សូរស័ក្តិ បាន កោតសរសើរ ក្រុមហ៊ុន តូយ៉ូតា ដែល បាន ពង្រីក សាខា ជា បន្តបន្ទាប់ តាំងពី ឆ្នាំ ១៩៩៥ ហើយ កាន់តែ ពិសេស នោះ គឺ នៅ ឆ្នាំ ២០២០ ក្រុមហ៊ុន បាន សម្ពោធ អគារ ស្នាក់ការ កណ្តាល របស់ ខ្លួន ដើម្បី បំពេញ តម្រូវការ អតិថិជន របស់ ខ្លួន ។
លោក រដ្ឋមន្ត្រី បាន លើកឡើង ថា ការវិវឌ្ឍន៍ និង រីកចម្រើន របស់ ក្រុមហ៊ុន តូយ៉ូតា ក៏ ដូចជា វិស័យ ឯកជន ទូទៅ បាន ឆ្លុះបញ្ជាំង ជាក់ស្ដែង ពី ការអនុវត្តន៍ គោល នយោបាយ ត្រឹមត្រូវ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការរក្សា នូវ សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ ។
ក្នុង ឱកាស នោះ ជួស មុខ ឱ្យ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា លោក រដ្ឋមន្ត្រី បាន ថ្លែងអំណរគុណ និង វាយតម្លៃ ខ្ពស់ ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន ជប៉ុន ដែល បាន រួមចំណែក យ៉ាង សំខាន់ ក្នុង ដំណើរ ស្វែងរក សន្តិភាព ឯកភាព ជាតិ ព្រមទាំង ការស្តារ និង អភិវឌ្ឍន៍ សេដ្ឋកិច្ច កម្ពុជា ឱ្យ រីកចម្រើន រហូតមកដល់ សព្វ ថ្ងៃ តាមរយៈ ការផ្តល់ ហិរញ្ញប្បទាន សហប្រតិបត្តិការ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ ជំនួយ បច្ចេកទេស នានា និង ការអភិវឌ្ឍ ធនធាន មនុស្ស ព្រមទាំង ការវិនិយោគ របស់ វិស័យ ឯកជន ជប៉ុន នៅ កម្ពុជា ។
ក្នុង ក្របខ័ណ្ឌ នៃ ការវិនិយោគ ផ្ទាល់ ពី ជប៉ុន គិត ពី ឆ្នាំ ១៩៩៤ រហូតដល់ ត្រីមាស ទី១ ឆ្នាំ ២០១៩ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន ចុះបញ្ជី គម្រោង វិនិយោគ របស់ ក្រុមហ៊ុន ជប៉ុន ចំនួន ១៣៧ គម្រោង ក្នុង ទុន វិនិយោគ សរុប ចំនួន ប្រមាណ ២.៥ ពាន់ លាន ដុល្លារ អាមេរិក ផ្ដោត សំខាន់ លើ ផ្នែក ផលិត គ្រឿង បង្គុំ អគ្គិសនី និង អេឡិចត្រូនិក គ្រឿង បង្គុំ រថយន្ត និង សម្ភារៈ បរិក្ខារ បច្ចេកទេស កសិឧស្សាហកម្ម ការកែច្នៃ ម្ហូប អាហារ សណ្ឋាគារ ទេសចរណ៍ មន្ទីរពេទ្យ និង ផ្សារ ទំនើប ។
ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ ផ្នែក ពាណិជ្ជកម្ម និង វិនិយោគ កម្ពុជា - ជប៉ុន បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ស្ដីពី សេរីភាវូបនីយកម្ម ការជំរុញ និង ការការពារ វិនិយោគ ដោយ បាន បង្កើត យន្តការកិច្ចប្រជុំ គណៈកម្មាធិការ ចម្រុះ កម្ពុជា - ជប៉ុន ។
ក្រុមការងារ ថ្នាក់ ខេត្ត ចុះ ជួយ ស្រុក ស្រឡាញ់ ទាំងអស់ សូម ចូលរួម អបអរសាទរ យ៉ាង ស្មោះ អស់ ពី ដួងចិត្ត និង សូម បួងសួង ដល់ ទេវតា និង វត្ថុ ស័ក្ត សិទ្ធ លើ លោក សូម ប្រសិទ្ធ ពរ ជ័យ ដល់ ឯកឧត្តម បណ្ឌិត និង លោកជំទាវ ទទួលបាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង ពលាំង មាំ មួន ជន្មាយុ យឺន យូរ ដើម្បី បន្ត ចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន ខ្លាំងក្លា ថែម ទៀត ។
ឯកឧត្តម បាន ថ្លែង ថា ទោះបីជា ពេលនេះ កំហាប់ ភាគ ល្អិត និចល ដែល មាន ទំហំ តូច ជាង សសៃ សក់ ១០ដង ទៅ ទៀត មាន ការធ្លាក់ចុះ ហើយ ស្ថានភាព គុណភាព ខ្យល់ ជា រួម មាន ការប្រសើរឡើង ក៏ ពិត មែន ប៉ុន្តែ មន្ត្រី ជំនាញ នៃ ក្រសួង បរិស្ថាន មន្ទីរ បរិស្ថាន នៅ តាម បណ្តា រាជធានី ខេត្ត ទាំងអស់ នៅតែ បន្ត តាមដាន និង ចាត់ វិធានការ តាម ការណែនាំ របស់ ក្រសួង ជាប្រចាំ ដើម្បី ធានា ថា ស្ថានភាព គុណភាព ខ្យល់ មាន គុណភាពល្អ ប្រសើរ ឡើងវិញ ។
សភា ពាណិជ្ជកម្ម ខេត្ត សៀមរាប - ឧត្តម មាន ជ័យ និង ប្រតិបត្តិករ ទេសចរណ៍ ព្រមទាំង អាជីវករ នៅ ខេត្ត សៀមរាប ទាំងអស់ សូម ចូលរួម អបអរសាទរ យ៉ាង ស្មោះ អស់ ពី ដួងចិត្ត និង សូម បួងសួង ដល់ ទេវតា និង វត្ថុ ស័ក្ត សិទ្ធ លើ លោក សូម ប្រសិទ្ធ ពរ ជ័យ ដល់ ឯកឧត្តម បណ្ឌិត និង លោកជំទាវ ទទួលបាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង ពលាំង មាំ មួន ជន្មាយុ យឺន យូរ ដើម្បី បន្ត ចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន ខ្លាំងក្លា ថែម ទៀត ។
សូម ទេវតា តាម ជួយ បី ថែរក្សា ឯកឧត្តម បណ្ឌិត សៀង ណាំ និង លោកជំទាវ ព្រមទាំង បុត្រា - បុត្រី និង ចៅ ប្រុស - ចៅ ស្រី ជួប តែ សុភមង្គល វិបុល សុខ គ្រប់ ប្រការ និង ប្រកបដោយ ពុទ្ធ ពរ ទាំង ៤ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
សាខា កាកបាទ ក្រហម ខេត្ត . សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត និង យុវជន កាយ រឹទ្ធិ ខេត្ត សៀមរាប សូម ចូលរួម អបអរសាទរ យ៉ាង ស្មោះ អស់ ពី ដួងចិត្ត និង សូម បួងសួង ដល់ ទេវតា និង វត្ថុ ស័ក្ត សិទ្ធ លើ លោក សូម ប្រសិទ្ធ ពរ ជ័យ ដល់ ឯកឧត្តម បណ្ឌិត និង លោកជំទាវ ទទួលបាន សុខភាព ល្អ បរិបូរណ៍ កម្លាំង ពលាំង មាំ មួន ជន្មាយុ យឺន យូរ ដើម្បី បន្ត ចូលរួមចំណែក ក្នុង ការអភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន ខ្លាំងក្លា ថែម ទៀត ។
អភិបាល ខណ្ឌ ឫស្សីកែ វ៖ តំបន់ ជុំវិញ ផ្សារ សាំ ហាន់ ល្អ ឡើងវិញ ហើយ ដើម្បី ផលប្រយោជន៍ សាធារណៈ សណ្ដាប់ធ្នាប់ និង រំដោះ ចរាចរណ៍
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ឫស្សីកែវ និង ជា សមាជិក ក្រុម លេខា សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន គូសបញ្ជាក់ ថា មុន អាជ្ញាធរ ឈាន ដល់ ចាត់ វិធានការក្ដៅ ដកហូត យក សម្ភារ ផ្សេង ៗ មក រក្សាទុក ពី ក្រុម អាជីវករ គឺ អនុវត្ត ឡើង នៅ ក្រោយពី ជូនដំណឹង ច្រើន លើក ច្រើន សារ មកហើយ ក្នុង គោលបំណង ការពារ ផលប្រយោជន៍ សាធារណៈ ពិសេស រក្សា សណ្ដាប់ធ្នាប់ របៀបរៀបរយ និង រំដោះ ចរាចរណ៍ ឲ្យបាន ល្អ ប្រសើរ ឡើងវិញ ។
ការគូសបញ្ជាក់ របស់ លោក ជា ពិសី បាន ធ្វើឡើង នៅ ខណៈ ដែល លោក ដឹកនាំ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ សង្កាត់ ចុះ រៀបចំ សណ្ដាប់ធ្នាប់ ដើម្បី លើកកម្ពស់ សោភ័ណ្ឌភាព និង របៀបរៀបរយ សង្គម « ក្នុង យុទ្ធនាការ រំដោះ ចំណី ចិញ្ចើមផ្លូវ » ស្ថិត នៅ តាម បណ្ដោយ ផ្លូវ លេខ ១០៥ និង ផ្លូវ លេខ ៦៨R ជុំវិញ បរិវេណ ផ្សារ ធំ ទួល សង្កែ ( ផ្សារ សាំ ហាន់ ) ក្នុង ភូមិ បាក់ទូក សង្កាត់ ទួល សង្កែទី១ នា ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ ។
លោក ជា ពិសី បញ្ជាក់ ថា រយៈពេល ជិត មួយ សប្ដាហ៍ ហើយ ដែល អាជ្ញាធរ ខណ្ឌ - សង្កាត់ អនុវត្ត វិធានការក្ដៅ « ក្នុង យុទ្ធនាការរំដោះ ចិញ្ចើមផ្លូវ » ពី អ្នក រំលោភ យក ធ្វើ អាជីវកម្ម នៅ តំបន់ ជុំវិញ « ផ្សារ សាំ ហាន់ » ដើម្បី ការពារ ផលប្រយោជន៍ សាធារណៈ ពិសេស រក្សា សណ្ដាប់ធ្នាប់ របៀបរៀបរយ និង ចរាចរណ៍ ឲ្យ ល្អ ប្រសើរ ឡើងវិញ ដែល ជា ផែនការរួម មួយ ដាក់ ចេញ ដោយ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ។
ការសាងសង់ ផ្លូវ ចំនួន ៣៤ ខ្សែ ដែល មាន ប្រវែង ជាង ៨០ គីឡូម៉ែត្រ នៅក្នុង ក្រុង ព្រះសីហនុ មក ទល់ នឹង ពាក់កណ្តាល ខែមករា ឆ្នាំ ២០២០ សម្រេច លទ្ធផល បាន ប្រមាណ ជា ៣០ ភាគរយ នៃ គម្រោង ហើយ បន្ទាប់ពី បើក ការដ្ឋាន ជា ផ្លូវការ ក្រោម អធិបតីភាព ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា កាលពី ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ រួច មក ។
ការដ្ឋាន សាងសង់ ផ្លូវ ទាំង ៣៤ ខ្សែ ដែល បាន អនុវត្ត ដោយ ក្រុមហ៊ុន ឯកជន ចំនួន ៦ និង កង វិស្វកម្ម ចំនួន ពីរ គឺ កង វិស្វកម្ម សម្តេច តេជោ ហ៊ុន សែន សៀមរាប និង កង វិស្វកម្ម លេខ ១៧៨ ស្ពាន ថ្នល់ នៃ ក្រសួង ការពារ ជាតិ គិត ពី ថ្ងៃទី ១៦ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ដែល ជា ថ្ងៃ បើក ការដ្ឋាន ជា ផ្លូវការ មកដល់ ត្រឹម ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២០ នេះ គឺ មាន រយៈពេល ពីរ ខែ គត់ ។
តូយ៉ូតា ( ខេមបូឌា ) បើក សម្ពោធ ទីស្នាក់ការ កណ្តាល ថ្មី របស់ ខ្លួន នៅ រាជធានី ភ្នំពេញ ដែល ជា ការិយាល័យ កណ្តាល ដ៏ ធំ បំផុត នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន តូយ៉ូតា ( ខេមបូឌា ) ខូអិលធីឌី បាន ប្រកាស បើក សម្ពោធ ជា ផ្លូវការ នូវ អគារ ទីស្នាក់កណ្តាល និង បន្ទប់ តាំង បង្ហាញ ថ្មី (Showroom) របស់ ខ្លូន នៅ កណ្តាល រាជធានី ភ្នំពេញ ។ តាមរយៈ ទីតាំង ដ៏ ប្រណិត និង ថ្មី សន្លាង រួម ជាមួយ ទំហំ ធំ ទូលាយ និង ស្ថិត នៅ ចំ កណ្តាល ទីក្រុង នា ពេលនេះ គឺជា ការឆ្លុះបញ្ចាំង ឲ្យ ឃើញ ពី វឌ្ឍនភាព នៃ ប្រតិបត្តិការ ដ៏ រីកចម្រើន របស់ ក្រុមហ៊ុន មួយ នេះ នៅក្នុង ប្រទេស កម្ពុជា ក្រោម ការគាំទ្រ និង ជឿ ទុកចិត្ត យ៉ាង ខ្លាំង ពីសំណាក់ អតិថិជន ។
អ្នកនាំពាក្យ របស់ ក្រុមហ៊ុន តូយ៉ូតា ( ខេមបូឌា ) បាន ថ្លែង ថា ការបើក ការិយាល័យ និង អគារ តាំង បង្ហាញ ថ្មី នេះ គឺជា ការចាប់ផ្តើម នៃ សករាជ ថ្មី ឬ អាច និយាយ បាន ថា វា ជា ជំហាន ថ្មី មួយ ទៀត នៃ ការបម្រើ សេវាកម្ម របស់ ក្រុមហ៊ុន ឲ្យ កាន់តែ បាន ល្អ និង រហ័ស បំផុត ក្នុង ឆ្នាំ ថ្មី នេះ ហើយ វា ក៏ បង្ហាញ ឲ្យ ឃើញ ពី ការរីកចម្រើន ឥត ឈប់ឈរ នៃ ប្រតិបត្តិការ ក្នុង វិស័យ យានយន្ត របស់ ក្រុមហ៊ុន នៅ កម្ពុជា និង នៅក្នុង តំបន់ ផងដែរ ។
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ ជិត ៥០០ នាក់ រស់ នៅក្នុង សង្កាត់ ឃ្មួញ ខណ្ឌ សែនសុខ បាន សម្ដែង ការសប្បាយចិត្ដ និង ថ្លែងអំណរគុណ ដល់ ក្រុម គ្រូពេទ្យ ដែល បាន ចុះ មក ពិនិត្យ ព្យាបាល ជំងឺ ពលរដ្ឋ ដោយ គិត ថ្លៃ ជាពិសេស ចុះ មក ព្យាបាល នៅជិត ៗ ផ្ទះ របស់ ពួកគាត់ តែម្ដង ។
ប្រជាពលរដ្ឋ ដែល មក ពិនិត្យ សុខភាព នៅ ទីនោះ បាន លើកឡើង ស្រដៀង ៗ គ្នា ថា ការចុះ មក ពិនិត្យ ព្យាបាល ជំងឺ នេះ បាន ជួយ ផ្ដល់ ភាពងាយស្រួល ច្រើន ណាស់ ដល់ ពួកគាត់ ផ្ដល់ ឱកាស បាន ព្យាបាល ហើយ ចំណេញ ទាំង ពេលវេលា ធ្វើដំណើរ ជាពិសេស លោកគ្រូពេទ្យ អ្នកគ្រូពេទ្យ បាន យកចិត្ដ ទុក្ខ ដាក់ ខ្ពស់ ហើយ មិន អស់ ថវិកា ទៀត ។
ដូច្នេះ ប្រជាពលរដ្ឋ នៅ សង្កាត់ ឃ្មួញ បាន ស្នើសុំ ឱ្យ រដ្ឋមន្រី្ដ ក្រសួង សុខាភិបាល លោក សាស្ដ្រាចារ្យ ម៉ម ប៊ុន ហេង បន្ដ ចាត់ មន្ដ្រី និង ក្រុម គ្រូពេទ្យ ចុះ មក ផ្ដល់ សេវា សុខភាព ជូន ពួកគាត់ នៅលើក ក្រោយ ៗ ទៀត ។
ជា ការឆ្លើយតប លោក វ៉េង ថៃ អនុប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ សែនសុខ និង លោក វេជ្ជបណ្ឌិត ងី មាន ហេង តំណាង រដ្ឋមន្ដ្រី ម៉ម ប៊ុន ហេង ដឹកនាំ ក្រុម គ្រូពេទ្យ ចុះ មក ពិនិត្យ ព្យាបាល សុខភាព ជូន ពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ នៅ រសៀល ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ បាន ថ្លែង ថា ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ សែនសុខ នឹង បន្ដ ចុះ មក ពិនិត្យ ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ យើង នៅ ខែ ក្រោយ ទៀត ។
ជាពិសេស ផ្តើម ចេញ ពី ការពិនិត្យ ព្យាបាល ជំងឺ ថ្ងៃ នេះ គឺ ក្រុមការងារ នឹង ធ្វើជា ផែនការរួម មួយ សម្រាប់ ទប់ទល់ ឬ ក៏ ប្រឆាំង ការពារ នូវ ជំងឺ ផ្សេង ៗ ដែល បងប្អូន ជួបប្រទះ ច្រើន ជាង គេ ។ ជាក់ស្ដែង នៅ ខែ នេះ មាន ជំងឺ រាគ កើតឡើង ច្រើន ដូចនេះ ក្រុមការងារ ធ្វើ ផែនការចុះអប់រំ សុខភាព ជូន បងប្អូន ឬ ក៏ ទប់ស្កាត់ នូវ ជំងឺ រាគ ព្រោះថា ជំងឺ រាគ គឺ វា ផ្តើម ចេញ ពី ការបរិភោគ គ្មាន អនាម័យ ។
ក្នុង ឱកាស នោះ លោក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឱ្យ ចេះ ថែរក្សា សុខភាព និង អនាម័យ ជា ចម្បង ដើម្បី ចៀសវាង ពី ជំងឺ ផ្សេង និង ត្រូវ សម្អាត បរិស្ថាន នៅ ជុំវិញ លំនៅឋាន ដែល ខ្លួន រស់ នៅ ផងដែរ ។
( ភ្នំពេញ ) ៖ ខណៈ ដែល ប្រជាពលរដ្ឋ ជា អ្នក ប្រកប អាជីវកម្ម ទីផ្សារ បណ្ដាញ ក៏ ដូចជា អ្នក ប្រកប អាជីវកម្ម ខ្នាត និង មធ្យម កំពុង ស្វះស្វែងរក ការសិក្សា បន្ថែម ពី ការប្រកប អាជីវកម្ម ចំណេះដឹង អំពី នីតិវិធី ច្បាប់ បទដ្ឋាន គតិយុត្ត នានា នោះ ស្រាប់តែ មាន អ្នក មួយចំនួន មក និយាយ បង្អាក់ ឆន្ទៈ ស្មារតី របស់ ពលរដ្ឋ ក្នុង ការសិក្សា បង្កើន ចំណេះដឹង នេះ ទៅ វិញ ។
លោក បាន កត់សម្គាល់ ឃើញ ថា ក្រុម ដែល ព្យាយាម ប្រព្រឹត្ត ទង្វើ បែប នេះ មាន ប្រភព ចេញ ពី ក្រុម ប្រឆាំង ដែល មិន ចង់ឱ្យ ក្នុង អាណត្តិ ដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន មាន ការរីកចម្រើន ពិសេស លើ ផ្នែក ធនធាន មនុស្ស កំពុង ប្រតិបត្តិការ ក្នុង វិស័យ ទីផ្សារ បណ្ដាញ ដែល លោក និង ថ្នាក់ដឹកនាំ ដទៃ ទៀត កំពុង ខិតខំ ប្រឹងប្រែង កៀរគរ ពួកគេ មក បណ្ដុះបណ្ដាល ចំណេះដឹង អំពី នីតិវិធី ច្បាប់ ក្នុង ការប្រកប អាជីវកម្ម ទីផ្សារ បណ្ដាញ ឱ្យ បាន ត្រឹមត្រូវ តាម ច្បាប់ និង គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។
ចំណុច គួរឱ្យ កត់សម្គាល់ មួយ ទៀត ត្រង់ ថា បានជា ពួកគេ មិន ចង់ឱ្យ ប្រជាពលរដ្ឋ អ្នក ប្រកប អាជីវកម្ម ទីផ្សារ បណ្ដាញ មក ទទួល ការបណ្ដុះបណ្ដាល នោះ គឺ ពួកគេ ចង់ឱ្យ ពលរដ្ឋ នៅតែ ល្ងង់ ដើម្បី ងាយស្រួល ឱ្យ ពួកគេ បោកប្រាស់ ដូចជា តាមរយៈ ការលក់ ផលិតផល ក្លែងក្លាយ ផលិតផល គ្មាន គុណភាព ឬ ផលិតផល ដែល ច្បាប់ ហាមឃាត់ ជាដើម ។
លោក ឡី សុភាព បាន បន្ត ថា ពួកគេ ធ្វើ យ៉ាង ដូច្នេះ ក៏ ព្រោះតែ ពួកគេ គិត តែ ពី ផលប្រយោជន៍ ផ្ទាល់ខ្លួន មិន គិត ពី សុខភាព ប្រជាពលរដ្ឋ អ្នកប្រើប្រាស់ មិន គិត ពី វិប្បត្តិ សង្គម ដែល កើត ចេញ ពី បញ្ហា សុភាព របស់ ពលរដ្ឋ ពិសេស អន្តរ ការី ចែកចាយ ផលិតផល បន្ត ដែល ជា អ្នក ប្រកប អាជីវកម្ម ទីផ្សារ បណ្ដាញ នេះ ក៏ ជា អ្នករងគ្រោះ ជំនួស គេ ឬ ក៏ ជា អ្នកចូលរួម បំផ្លាញ សង្គម ខ្លួន ឯង ដោយ មិន ដឹងខ្លួន ផងដែរ ។
ហេតុ ដូច្នេះហើយ បាន ជា ប្រធាន សមាគម ដែល ខិតខំ ជួយ ប្រជាពលរដ្ឋ ទាំង យប់ ទាំង ថ្ងៃ រូប នេះ ប្រកាស អំពាវនាវ ហើយ អំពាវនាវ ទៀត សូម ឱ្យ ប្រជាពលរដ្ឋ អ្នក ប្រកប អាជីវកម្ម ទីផ្សារ បណ្ដាញ អ្នក ប្រកប អាជីវកម្ម ខ្នាត និង មធ្យម នាំគ្នា មក ទទួល ការបណ្ដុះបណ្ដាល ចំណេះដឹង នានា ពាក់ព័ន្ធ នឹង ការប្រកប អាជីវកម្ម នីតិវិធី ច្បាប់ និង បទដ្ឋាន គតិយុត្ត ក៏ ដូចជា គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ជាដើម ។
គេ សង្កេតឃើញ ថា មកដល់ ពេលនេះ មាន ប្រជាពលរដ្ឋ ច្រើន ណាស់ ដែល បាន មក ទទួល ការបណ្ដុះបណ្ដាល ចំណេះដឹង ទាំង នេះ ជាមួយ សមាគម ទីផ្សារ បណ្ដាញ កម្ពុជា ខណៈ ការបណ្ដុះបណ្ដាល នេះ ក៏ ទទួលបាន ការគាំទ្រ ពី ក្រសួង - ស្ថាប័ន មាន សមត្ថកិច្ច ដៃគូ វិស័យ ឯកជន ពិសេស តែងតែ ទទួលបាន ការចូលរួម ធ្វើ បទបង្ហាញ ពី លោក ឧត្តមសេនីយ៍ ឯក ជា ប៊ុន ថុល អនុប្រធាន នាយកដ្ឋាន កណ្ដាល នគរបាល យុត្តិធម៌ នៃ អគ្គ ស្នងការ នគរបាល ជាតិ ផងដែរ ៕
បើ តាម របាយការណ៍ របស់ លោក សយ ទូច អភិបាល ស្រុក ក្រូចឆ្មារ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ចាប់ពី វេលា ម៉ោង ០១ ថ្ងៃត្រង់ រហូតដល់ ម៉ោង ៤: ៣០ នាទី ល្ងាច សិស្ស នៅ វិទ្យាល័យ ក្រូចឆ្មារ ចំនួន ១២នាក់ កំពុង អង្គុយ រៀន ក្នុង ថ្នាក់ បាន សន្លប់ ជា បន្តបន្ទាប់ ដូច មាន ឈ្មោះ ខាងក្រោម៖
សូម ជម្រាប ជូន ថា សិស្ស ទាំង ១២នាក់ ខាងលើ នេះ ត្រូវបាន បញ្ជូន ទៅ សង្គ្រោះ នៅ មន្ទីរពេទ្យ ស្រុក ដោយ មិន មាន គ្រោះថ្នាក់ ដល់ អាយុជីវិត នោះ ឡើយ ។
បើ តាម ការសន្និដ្ឋាន របស់ ពេទ្យ ចំពោះ មូលហេតុ សិស្ស ២នាក់ ខ្វះ ជាតិ ស្ករ ក្រៅពី នោះ គាត់ មាន សភាព ខ្សោយ តាម របៀប រៀន ច្រើន ពេក ពេល សំរាក បាន តិច ពេក ។
រហូតមកដល់ ព្រឹក ថ្ងៃទី ១៨ ខែមករា ឆ្នាំ ២០២០ នេះ សិស្ស ១៤នាក់ ផ្សេង ទៀត បាន បន្ត សន្លប់ ជា បន្តបន្ទាប់ ក្នុង ចំណោម សិស្ស ជាច្រើន ពេល កំពុង ឈរ គោរព ទង់ជាតិ ដូច មាន ឈ្មោះ ខាងក្រោម៖
បច្ចុប្បន្ន ត្រូវបាន បញ្ជូន ទៅ សង្គ្រោះ នៅ មន្ទីពេទ្យ ស្រុក ក្រូចឆ្មារ ដោយ លោក អភិបាល ស្រុក ចុះ ទៅ ពិនិត្យ ផ្ទាល់ រួម ជាមួយនឹង ការមើល ថែ យកចិត្តទុកដាក់ ពីសំណាក់ ក្រុម គ្រូពេទ្យ និង កំពុង តាមដាន រក ប្រភព នៃ ការសន្លប់ របស់ សិស្ស នេះ ជា បន្ត ទៀត ផងដែរ ៕ ប្រធានាធិបតី អ៊ុយក្រែន « មិន ទទួលយក ពាក្យ សុំ លា លែង ពី តំណែង » របស់ នាយក រដ្ឋមន្ត្រី ឡើយ
ព្រឹត្តិការណ៍ រត់ ចម្ងាយ ឆ្ងាយ ១២៨ គីឡូម៉ែត្រ នៅ តំបន់ អង្គរ ចាប់ផ្ដើម ការប្រកួត !
ក្នុង ឱកាស ចូលរួម ពិធី ចេញដំណើរការរត់ ចម្ងាយ ឆ្ងាយ ខាងលើ លោក វ៉ាត់ ចំរើន អគ្គ លេខាធិការ គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា (NOCC) តំណាង លោក បណ្ឌិត ថោង ខុន រដ្ឋមន្ដ្រី ក្រសួង ទេសចរណ៍ និង ជា ប្រធាន NOCC បាន បង្ហាញ នូវ ការស្វាគមន៍ យ៉ាង កក់ក្ដៅ ចំពោះ វត្តមាន កីឡាករ - កីឡាការិនី ជាតិ និង អន្ដរជាតិ ដែល បាន ចូលរួម និង គាំទ្រ ព្រឹត្តិការណ៍ កីឡា ទេសចរណ៍ បែប ផ្សងព្រេង នេះ ហើយ លោក បាន អំពាវនាវ ឲ្យ ពួកគេ បន្ដ ការគាំទ្រ និង ចូលរួម កាន់តែ ច្រើន បន្ថែម ទៀត នា ឆ្នាំ ក្រោយ ៗ ។
បន្ថែម លើ នេះ រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ ដដែល បាន បង្ហាញ នូវ សុទិដ្ឋិនិយម ខ្ពស់ ចំពោះ កីឡាករ - កីឡាការិនី ទាំងអស់ ដែល បាន បង្ហាញ នូវ ស្នាមញញឹម អម ដោយ ភាពសប្បាយរីករាយ ក្នុង ការចូលរួម រត់ ចម្ងាយ ឆ្ងាយ រហូតដល់ទៅ ១២៨ គីឡូម៉ែត្រ ក្នុង នោះ ក៏ មាន កីឡាករ កម្ពុជា ៣ រូប ចូលរួម ដែរ ។ ពិសេស គឺ ជន បរទេស ដែល បាន អរគុណ កម្ពុជា ក្នុង ការរៀបចំ ព្រឹត្តិការណ៍ នេះ ឡើង នៅ តំបន់ អង្គរ ជា តំបន់ បេតិកភណ្ឌ ដ៏ ល្អ ឯក ហើយ មាន ការស្វាគមន៍ យ៉ាង កក់ក្ដៅ ពី ប្រជាពលរដ្ឋ ។
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ១២លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៨នាក់ . របួស ស្រាល ១នាក់ និង របួស ធ្ងន់ ៩នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១២លើក នេះ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . បត់ គ្រោះថ្នាក់ និង ស្រវឹង ៕
ពាន ជយលាភី ទីក្រុង ស្អាត អាស៊ាន សម្រាប់ ខណ្ឌ - ក្រុង ទាំង៣ ត្រូវបាន ដង្ហែ មក កម្ពុជា ហើយ
( ភ្នំពេញ ) ៖ ពាន ជយលាភ ភី ទីក្រុង ស្អាត អាស៊ាន ដែល សមាគម អាស៊ាន បាន ផ្ដល់ជូន ខណ្ឌ - ក្រុង ទាំង៣ របស់ កម្ពុជា ( ខណ្ឌ ដូនពេញ ក្រុង តាខ្មៅ និង ក្រុង កំពត ) ត្រូវបាន ដង្ហែ មកដល់ មាតុភូមិ កម្ពុជា ហើយ ខណៈ មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ ប្រចាំ ខណ្ឌ - ក្រុង របស់ ខ្លូន រួមទាំង ប្រទេស កម្ពុជា ទាំងមូល បាន បង្ហាញ ការអបអរសាទរ យ៉ាង ក្រៃលែង ចំពោះ ការទទួលបាន ពាន មហា កិត្តិយស ទាំង៣ នេះ ។
សម្រាប់ ខណ្ឌ ដូនពេញ នៃ រាជធានី ភ្នំពេញ គ្រាន់តែ មកដល់ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ វិញ នា ថ្ងៃទី ១៧ ខែមករា នេះ លោក ហួត ហៃ អភិបាល រង រាជធានី ភ្នំពេញ និង លោក សុខ ពេញវុធ អភិបាល ខណ្ឌ ដូនពេញ បាន លើក ពាន ជយលាភី បង្ហាញ ប្រជាពលរដ្ឋ និង ភ្ញៀវ អ្នកដំណើរ ប្រកបដោយ ភាគ រីករាយ ។
ចំណែកឯ ក្រុង តាខ្មៅ នៃ ខេត្ត កណ្ដាល ត្រូវបាន លោក ម៉ៅ ភិរុណ អភិបាល ខេត្ត កណ្ដាល សន្យា ថា នឹង រៀបចំ ពិធី អបអរសាទរ ឱ្យ បាន ឱឡារិក ចំពោះ ការទទួលបាន ពាន ជយលាភី ទីក្រុង ស្អាត អាស៊ាន សម្រាប់ ក្រុង តាខ្មៅ ។
រីឯ ក្រុង កំពត ឯណោះ វិញ មន្ត្រីរាជការ និង ប្រជាពលរដ្ឋ ក៏ សប្បាយរីករាយ មិន ណយ ដែរ នៅពេល បាន ឃើញ រូបភាព លោក ជា វ តាយ អភិបាល ខេត្ត កំពត លើក ពាន ជយលាភី ទីក្រុង ស្អាត អាស៊ាន សម្រាប់ ក្រុង កំពត របស់ ខ្លួន លើ វេទិកា មួយ ដែល ត្រូវបាន រៀបចំ នៅឯ ប្រទេស ព្រុយណេ ។
សូម ជម្រាប ថា នា ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២០ ខណ្ឌ - ក្រុង ចំនួន ៣ ដែល ត្រូវបាន ចាត់ទុក ជា ទីក្រុង ទេសចរណ៍ របស់ កម្ពុជា រួម មាន៖ ខណ្ឌ ដូនពេញ ( រាជធានី ភ្នំពេញ ) ក្រុង កំពត ( ខេត្ត កំពត ) និង ក្រុង តាខ្មៅ ( ខេត្ត កណ្ដាល ) បាន ទទួល ពាន ជយលាភី ទីក្រុង ទេសចរណ៍ ស្អាត អាស៊ាន ដែល ត្រូវបាន ប្រគល់ ជូន តំណាង រៀង ៗ ខ្លួន នា ឱកាស វេទិកា ទេសចរណ៍ អាស៊ាន ឆ្នាំ ២០២០ នៅ ទីក្រុង បង់ដា សេរី បេហ្គាវ័ន ប្រទេស ព្រុយណេដារូ សាឡឹម ។
ក្នុង ការចូលរួម ប្រឡង ប្រណាំង ទីក្រុង ស្អាត អាស៊ាន នេះ កម្ពុជា បាន ដាក់ ខណ្ឌ - ក្រុង ចំនួន ៦ ប៉ុន្តែ ក្រុង កំពង់ចាម ក្រុង ពោធិ៍សាត់ និង ក្រុង ក្រចេះ មិន អាច ដណ្ដើម បាន ពាន ជយលាភី នេះ ។
ការប្រគល់ រង្វាន់ នេះ ធ្វើឡើង ដើម្បី ពង្រឹង ភាពទាក់ទាញ និង បង្កើន ភាពប្រកួតប្រជែង របស់ ទីក្រុង ទេសចរណ៍ អាស៊ាន ក៏ ដូចជា ពង្រឹង គុណភាព ផលិតផល និង សេវាកម្ម ទេសចរណ៍ នៅក្នុង តាម បណ្តា ទីក្រុង របស់ អាស៊ាន ស្រប តាម ផែនការ យុទ្ធសាស្រ្ត ទេសចរណ៍ អាស៊ាន ២០១៦ - ២០២៥ សំដៅ ធ្វើឲ្យ អាស៊ាន ក្លាយជា គោលដៅ ទេសចរណ៍ ប្រកបដោយ គុណភាព និង ភាពទាក់ទាញ ផ្តល់ ភាពកក់ក្តៅ ដល់ ភ្ញៀវ ទេសចរ ។
ការប្រកួតប្រជែង នេះ ក៏ បាន ជំរុញ ដល់ ការរៀបចំ មជ្ឈដ្ឋាន រស់ នៅ របស់ ប្រជាពលរដ្ឋ តាម បណ្តា ទីក្រុង នៅក្នុង តំបន់ អាស៊ាន ឲ្យ កាន់តែ ប្រសើរឡើង ព្រមទាំង ចូលរួម យ៉ាង មាន ប្រសិទ្ធភាព ដល់ ការអភិវឌ្ឍ ទីក្រុង ប្រកបដោយ និរន្តរភាព ៕ អភិបាល ខេត្ត ពោធិ៍សាត់ លើកទឹកចិត្ត ឱ្យ មន្ត្រី ខំ អភិវឌ្ឍន៍ សមត្ថភាព ដើម្បី ចូល បម្រើការ តាម ប្រអប់ ដែល នៅ ទំនេរ
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ បាន ផ្តាំផ្ញើ ដល់ មន្ត្រីរាជការ សាលា ខេត្ត ទាំងអស់ ត្រូវ បន្ត សាមគ្គីភាព ផ្ទៃក្នុង ឲ្យបាន ល្អ ប្រសើរ បន្ថែម ទៀត ក្នុង ឆ្នាំ ថ្មី នេះ និង ត្រូវ បង្កើន ចំណេះដឹង ស្វែងយល់ បន្ថែម ឲ្យបាន ច្រើន ដើម្បី មាន ឱកាស ចូល បំពេញ ការងារ តាម ប្រអប់ ដែល នៅ ទំនេរ ។
ការផ្តាំផ្ញើ បែប នេះ ត្រូវបាន ធ្វើឡើង ពិធី ជួប សំណេះសំណាល ជាមួយ មន្ត្រីរាជការ និង មន្ត្រី ជាប់ កិច្ចសន្យា នៃ រដ្ឋបាល ខេត្ត ចំនួន ១៩២ រូប ព្រមទាំង ពិនិត្យ រចនាសម្ពន្ធ មន្ត្រីរាជការ តាម បណ្តា ទី ចាត់ការ និង អង្គភាព នីមួយ ៗ ដើម្បី បំពេញ បន្ថែម នូវ ប្រអប់ ដែល នៅ ទំនេរ ។
លោក បាន បន្ថែម ទៀត ថា នៅក្នុង ខេត្ត ក៏ដូចជា បណ្តា ក្រុង - ស្រុក ដទៃ ទៀត តែង ពិនិត្យ ឃើញ ថា នៅ មាន កន្លែង ជាច្រើន ត្រូវការ ធនធាន មនុស្ស គឺ មាន តែ មន្ត្រី ជំនាន់ ថ្មី នេះ ហើយ ជា ទំពាំង ស្នង ឫស្សី ដែល មាន សមត្ថភាព អាចនឹង ចូលទៅ បម្រើការ នៅ ទីនោះ បាន ។
លោក អភិបាល ខេត្ត បាន គូសបញ្ជាក់ ថា ខេត្ត ពោធិ៍សាត់ ពិតជា មោទនភាព ក្រៃលែង ដែល ត្រូវបាន ថ្នាក់ដឹកនាំ ក្រសួង មហាផ្ទៃ ជ្រើសរើស ដើម្បី សម្ពោធ ជា រួម នូវ អគារ ច្រក ចេញ - ចូល តែ មួយ តំណាង ឱ្យ រដ្ឋបាល រាជធានី - ខេត្ត ទាំង ២៥ នា ថ្ងៃទី ២២ ខែមករា ឆ្នាំ ២០២០ ខាងមុខ ក្រោម វត្តមាន សម្តេច ក្រឡាហោម ស ខេ ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ។
ជាមួយគ្នា នោះ លោក បាន ស្នើ ដល់ មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ សហការ គ្នា ចូលរួម រៀបចំ កម្មវិធី នេះ ឲ្យ ទទួលបាន ផ្លែ ផ្កា និង ប្រសិទ្ធភាព ខ្ពស់ សម្រាប់ ជា មុខមាត់ ខេត្ត ពោធិ៍សាត់ ៕
នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន ដឹកនាំ ប្រតិភូ អគ្គ បញ្ជាការ ជូនពរ ឆ្នាំ ថ្មី ឯក អគ្គ រដ្ឋទូត ចិន ប្រចាំ នៅ កម្ពុជា
មានប្រសាស ន៏ ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន បាន គូសបញ្ជាក់ ពី ចំណង មិត្តភាព ជា ប្រពៃណី រវាង កម្ពុជា - ចិន ក្នុង ភាពជាដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ ដែល ក្នុង រយៈពេល មួយ ឆ្នាំ ២០១៩ នេះ ថ្នាក់ដឹកនាំ នៃ ប្រទេស ទាំង ពីរ បាន ខិតខំ លើកកម្ពស់ ឈានដល់ កម្រិត កំពូល ។
នាយ ឧត្តមសេនីយ៍ បាន ថ្លែងអំណរគុណ ដល់ សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល កន្លងមក បាន ជួយ ឧបត្ថម្ភ ដល់ កងយោធពល ខេមរភូមិន្ទ ធ្វើឲ្យ កងទ័ព កម្ពុជា មាន ការវិវត្តន៍ រីកចម្រើន ជា បន្តបន្ទាប់ ។
នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ បាន ថ្លែង នូវ ការ ជូនពរ ដល់ លោក ឯក អគ្គ រដ្ឋទូត ចិន និង ក្រុមគ្រួសារ ព្រមទាំង សហការី សូម ជួប តែ ភាពសប្បាយរីករាយ ក្នុង ឱកាស ចូល ឆ្នាំ ថ្មី ប្រពៃណី ចិន និង សូមឲ្យ មាន សុខភាព ល្អ មាន សុភមង្គល ជាពិសេស សូមឲ្យ ចំណង មិត្តភាព រវាង ប្រទេស ទាំង ពីរ ស្ថិតស្ថេរ ជា អមតៈ ។
ជា កិច្ច ឆ្លើយតប លោក វ៉ាង វិន ធាន បាន ថ្លែងអំណរគុណ ដល់ ប្រតិភូ អគ្គ បញ្ជាការ ដែល បាន ចំណាយ ពេលវេលា ដ៏ មាន តម្លៃ មក ជូនពរ ឆ្នាំ ថ្មី នា ឱកាស នេះ ។
លោក បាន រម្លឹក ឡើងវិញ ពី ដំណើរ បំពេញ ទស្សនកិច្ច ផ្លូវការ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា នៅ សាធារណរដ្ឋ ប្រជាមានិត ចិន កាលពី ខែមេសា ឆ្នាំ ២០១៩ ដែល ជា ព្រឹត្តិការណ៍ ដ៏ សំខាន់ នៃ កិច្ច ពង្រឹង កិច្ចសហប្រ តិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ។
ពាក់ព័ន្ធ ដល់ វិស័យ យោធា រវាង ប្រទេស ទាំង ពីរ ឯកឧត្តម អគ្គ រដ្ឋទូត ចិន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ទំនាក់ទំនង នា ពេល កន្លងមក ហើយ លោក ក៏ បាន ប្រសិទ្ធ ពរ សូមឲ្យ ចំណង សាមគ្គីភាព មិត្តភាព ដែល មាន ស្រាប់ កាន់តែ ត្រូវបាន ពង្រឹង ពង្រីក ទ្វេរ ដង ថែម ទៀត សមស្រប នឹង ស្ថាន ការ ណ៏ ដែល កំពុង ឈានដល់ ការរីកចម្រើន ក្នុង ដំណាក់កាល ថ្មី ៕
ក្រោយពី ការផ្ទុះ ព័ត៌មាន នៃ ការរក ឃើញ អ្នក ឈ្នះ រង្វាន់ រថយន្ត ដ៏ ទំនើប ខាងលើ ភ្លាម សាធារណជន បាន ដាក់ ចម្ងល់ ថា តើ ការប្រគល់ នឹង ប្រព្រឹត្តទៅ នៅ ពេលណា កន្លែងណា និង គគ្រឹកគគ្រេង កម្រិត ណា ព្រោះ នេះ ជា រង្វាន់ ដ៏ ធំ បំផុត របស់ ស្រាបៀរ កម្ពុជា ។
បើ តាម ការ ឱ្យដឹង ពី ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ដែល ផលិត ស្រាបៀរ កម្ពុជា ក្រុមហ៊ុន ក៏ នឹង រៀបចំ ការប្រគំ តន្រ្តី មួយ ដើម្បី អបអរសាទរ ដល់ អ្នក ឈ្នះ លោក ណុយ សុខ ណេម នៅ បរិវេណ មុខ មហោស្រព កោះ ពេជ្រ វេលា ម៉ោង ៨ល្ងាច តទៅ ដូច្នេះ សាធារណជន អាច ចូលរួម ទស្សនា និង កម្សាន្ត ដោយ សេរី បាន ផងដែរ ៕
( ព្រះសីហនុ) ៖ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត ព្រះសីហនុ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ហេង ប៊ុន ទី មេបញ្ជាការ អាវុធហត្ថ ខេត្ត បាន បើក ប្រតិបត្តិការ បង្ក្រាប ករណី ជួញដូរ គ្រឿងញៀន ២ករណី ឃាត់ខ្លួន ជនសង្ស័យ ប្រុស ស្រី ១៧នាក់ និង ដកហូត បាន ថ្នាំ ញៀន មួយចំនួន ។
ប្រតិបត្តិការ ជា បន្ដ បន្ទាប់ នៅ ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២០ បាន ធ្វើឡើង ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង លោក គួច ចំរើន អភិបាល ខេត្ត និង ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត ព្រមទាំង មាន ការសម្របសម្រួល នីតិវិធី ពី តំណាង អយ្យការ ផងដែរ ។
ដោយឡែក ទីតាំង ទី ២៖ បង្ក្រាប ករណី ប្រើប្រាស់ គ្រឿងញៀន នៅ ចំណុច ក្រុម៦ ភូមិ២ សង្កាត់ ៤ ក្រុង ព្រះសីហនុ ឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ៧នាក់ ចាប់ យក វត្ថុតាង រួម មាន ដប ជក់ ចំនួន ៤. ដែក កេះ ចំនួន ២ និង ខ្សៀជក់ ចំនួន ១ ។ ក្រោយ ឃាត់ខ្លួន ជនសង្ស័យ រួម ជាមួយ វត្ថុតាង ត្រូវបាន បញ្ជូន ទៅ ការិយាល័យ ជំនាញ ដើម្បី កសាង សំណុំរឿង ចាត់ការ តាម នីតិវិធី ។
ជាមួយនឹង លទ្ធផល នៃ ប្រតិបត្តិការ នេះ ត្រូវបាន លោក ឧត្តមសេនីយ៍ ត្រី ហេង ប៊ុន ទី បញ្ជាក់ ថា លោក គួច ចំរើន ក្នុង នាម ជា ប្រធាន គណៈ បញ្ជាការ ឯកភាព ខេត្ត ក៏ បាន ផ្ដល់ រង្វាន់ លើកទឹកចិត្ត ដល់ កម្លាំង កងរាជអាវុធហត្ថ ខេត្ត របស់ លោក ផងដែរ ៕
ការបង្ហាញ ជំនឿចិត្ត ដ៏ រឹងមាំ របស់ នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ធ្វើឡើង ក្នុង ឱកាស ដែល សម្តេច អញ្ជើញ ចូលរួម ពិសា អាហារ អបអរសាទរ បុណ្យ ចូល ឆ្នាំ ថ្មី របស់ វៀតណាម នៅ សណ្ឋាគារ សុខា ភ្នំពេញ នា រាត្រី ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ នេះ ។
នៅក្នុង ឱកាស នោះ ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ បាន សម្តែង ការអបអរសាទរ ចំពោះ វឌ្ឍនភាព នៃ សេដ្ឋកិច្ច របស់ វៀតណាម ក្នុង ប៉ុន្មាន ឆ្នាំ ចុងក្រោយ នេះ ដែល មាន ការកើនឡើង យ៉ាង ខ្លាំងក្លា ។ សម្តេច បាន អបអរសាទរ ចំពោះ ការចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី និង ការការពារ វិនិយោគ រវាង វៀតណាម និង សហភាព អឺរ៉ុប ដែល នឹង បន្ត ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម និង វិនិយោគ រវាង ប្រទេស វៀតណាម និង សហភាព អឺរ៉ុប ។
សម្តេច ជឿជាក់ ថា កំណើន សេដ្ឋកិច្ច វៀតណាម និង ការចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង នេះ នឹង មិន ត្រឹមតែ ផ្តល់ ផលប្រយោជន៍ សេដ្ឋកិច្ច ដោយ ផ្ទាល់ ដល់ ប្រទេស វៀតណាម ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ក៏ នឹង ផ្តល់ ផ្លែ ផ្កា ដល់ ប្រទេស ជិតខាងក្នុង តំបន់ រួមទាំង កម្ពុជា ផងដែរ តាមរយៈ លំហូរ ពាណិជ្ជកម្ម វិនិយោគ និង ទេសចរណ៍ ។
កម្ពុជា និង វៀតណាម បាន ភ្ជាប់ ទំនាក់ទំនង ការទូត ជាមួយ គ្ នា នៅ ថ្ងៃទី ២៤ ខែមិថុនា ឆ្នាំ ១៩៦៧ ហើយ ត្រូវបាន កាត់ផ្តាច់ នៅ ខែមីនា ឆ្នាំ ១៩៧០ ។ ប្រទេស ទាំង ពី បាន តភ្ជាប់ ទំនាក់ទំនង ឡើងវិញ នៅ ខែមករា ឆ្នាំ ១៩៧៩ ។ ក្រោយ ទំនាក់ទំនង ថ្មី នេះ មេដឹកនាំ ប្រទេស ទាំង ពីរ បាន ខិតខំ រក្សា សន្តិភាព និង អភិវឌ្ឍ តាម បណ្តោយ ព្រំដែន ក្នុង នាម ជា ប្រទេស ភូមិ ផង របង ជាមួយគ្នា ព្រមទាំង ជំរុញ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ លើ គ្រប់ វិស័យ ជា បន្តបន្ទាប់ ។
សម្តេច បាន ស្វាគមន៍ ចំពោះ រាល់ ការសម្រេចចិត្ត ដ៏ ឈ្លាសវៃ របស់ អ្នក វិនិយោគ បរទេស ទាំងអស់ ជាពិសេស អ្នកវិនិយោត វៀតណាម ដែល បាន ជ្រើសរើស និង មាន បំណង ជ្រើសរើស កម្ពុជា ជា គោលដៅ វិនិយោគ ដ៏ មាន សក្តានុពល ខ្ពស់ ក្នុង ការចាប់ផ្តើម ឬ ពង្រីក អាជីវកម្ម របស់ ខ្លួន ដើម្បី ទាញយក ប្រយោជន៍ ជា អតិបរមា ពី កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី រវាង កម្ពុជា និង វៀតណាម និង កិច្ចសហប្រតិបត្តិការ ពហុ ភាគី នានា ដែល មាន កម្ពុជា និង វៀតណាម ជា សមាជិក ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០
១៖ ក្រសួង បរិស្ថាន៖ ស្ថានភាព គុណភាព ខ្យល់ មិន ទាន់ ឈានដល់ កម្រិត ប៉ះពាល់ ដល់ សុខភាព គួរឱ្យ ព្រួយបារម្ភ នៅឡើយ ទេ ( ចុច អាន )
២៖ រដ្ឋសភា ចេញ សេចក្តីប្រកាស ព័ត៌មាន ស្តីពី លទ្ធផល នៃ ការចូលរួម កិច្ចប្រជុំ ប្រចាំ ឆ្នាំ វេទិកា សភា អាស៊ី - ប៉ាស៊ីហ្វិក នៅ អូស្ត្រាលី របស់ គណៈប្រតិភូសភា កម្ពុជា ដឹកនាំ ដោយ សម្តេច ហេង សំរិន ( ចុច អាន )
៣៖ ថវិកា ជាង ១លាន ដុល្លារ បាន មកពី ការដក កម្រៃ ពី សំបុត្រ ចូល ទស្សនា តំបន់ អង្គរ ត្រូវបាន ប្រគល់ ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា ( ចុច អាន )
៤៖ យន្ដហោះ ដ្រូន១ គ្រឿង ធ្លាក់ ចំកណ្ដាល ព្រៃ នៅ ស្រុក គិរី សាគរ ខេត្ត កោះកុង . សមត្ថកិច្ច កំពុង ស្រាវជ្រាវ ស្វែងរក ម្ចាស់ ( ចុច អាន )
៦៖ អាជ្ញាធរ ច្រានចោល ព័ត៌មាន ថា ពលរដ្ឋ ស្រុក អង្គរ បូរី ខេត្ត តាកែវ ជួល ដី ឲ្យ ជនជាតិ វៀតណាម ជាង ៣ពាន់ ហិកតា ( ចុច អាន )
៨៖ រាជ រដ្ឋាភិបាល បង្កើត គណៈកម្មការ អន្តរ ក្រសួង ដើម្បី សិក្សា រៀបចំ ផែនការ មេ សម្រាប់ អភិវឌ្ឍ វិស័យ ទេសចរណ៍ នៅ ខេត្ត កែប និង មណ្ឌលគិរី ( ចុច អាន )
៩៖ ករណី ក្មេងស្រី ៤នាក់ ព្រួត វាយ ក្មេងស្រី ម្នាក់ នៅ វិទ្យាល័យ ផ្សារ ដើម ថ្កូវ ត្រូវបាន ដោះស្រាយ បញ្ចប់ . សមត្ថកិច្ច ឲ្យ អាណាព្យាបាល និង សិស្ស បង្ក សុំទោស ឪពុក ម្តាយ និង យុវតី រងគ្រោះ ( ចុច អាន )
៣៖ មន្ទីរ បញ្ចកោណ ទទួល សំណើ ពី រដ្ឋបាល ដូណាល់ ត្រាំ ឲ្យ កង សាង ជញ្ជាំង ព្រំដែន ប្រវែង ៤៣៥ គីឡូម៉ែត្រ ជាមួយ មិច ស៊ីកូ ( ចុច អាន )
១០៖ របាយការណ៍ ថ្មី៖ ចំនួន អ្នកធ្វើ អត្តឃាត ក្នុង ប្រទេស ជប៉ុន ធ្លាក់ចុះ ដល់ អាត្រា ទាប បំផុត ក្នុង អំឡុង ៤០ ឆ្នាំ ចុងក្រោយ នេះ ( ចុច អាន )
រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម ជួប ពិភាក្សា ជាមួយ ប្រធាន សម្ព័ន្ធ កៅស៊ូ វៀតណាម ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ លើ វិស័យ កៅស៊ូ
លោក Tran Ngoc Thuan បាន ថ្លែងអំណរគុណ ចំពោះ លោក រដ្ឋមន្ត្រី និង មន្ត្រី ជំនាញ នៃ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ដែល តែងតែ ផ្តល់ ការគាំទ្រ និង កិច្ចសហការ យ៉ាង ល្អ ប្រសើរ ចំពោះ ផែនការវិនិយោគ ដាំដុះ និង កែច្នៃ កៅស៊ូ របស់ សម្ព័ន្ធ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក ក៏ បាន ធ្វើ ការរាយការណ៍ អំពី ស្ថានភាព និង វឌ្ឍនភាព ដែល សម្ព័ន្ធ សម្រេចបាន ជូន ដល់ រដ្ឋមន្ត្រី ជ្រាប ថា ក្នុង ឆ្នាំ ២០១៩ កន្លងទៅ នេះ ផ្ទៃដី ចៀរ ជ័រ កៅស៊ូ ដែល សម្ព័ន្ធ សម្រេចបាន គឺជាង ៤.៧ម៉ឺន ហិកតា ទទួលបាន ផល ជ័រ កៅស៊ូ ប្រមាណ ជា ៥០ ពាន់ តោន ។ សម្រាប់ ឆ្នាំ ២០២០ សម្ព័ន្ធ នឹង ពង្រីក ផ្ទៃដី ចៀរ ជ័រ រហូតដល់ ៦.៥ម៉ឺន ហិកតា សម្រាប់ ធ្វើ ការកែច្នៃ ក្នុង រោងចក្រ កែច្នៃ កៅស៊ូ របស់ សម្ព័ន្ធ នៅ កម្ពុជា ។
លោក រដ្ឋមន្ត្រី បាន ស្វាគមន៍ និង កោតសរសើរ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង និង ឆន្ទៈ ក្នុង ការអនុវត្ត ផែនការវិនិយោគ សម្បទាន ដី សេដ្ឋកិច្ច ដាំដុះ កៅស៊ូ នៅ កម្ពុជា របស់ សម្ព័ន្ធ កៅស៊ូ វៀតណាម ទទួលបាន ជោគជ័យ គួរឲ្យ សរសើរ ក្រោម ម្លប់ សន្តិភាព ដែល រាជ រដ្ឋាភិបាល បាន បង្កើតឡើង ។
ហើយ ដើម្បី បន្ត អភិវឌ្ឍន៍ វិស័យ កៅស៊ូ ជា ប្រយោជន៍ ដល់ សេដ្ឋកិច្ច ជាតិ លោក រដ្ឋមន្ត្រី សង្ឃឹម និង ជឿជាក់ ថា សម្ព័ន្ធ នឹង បន្ត ផ្តល់ កិច្ចសហការ យ៉ាង ល្អ ប្រសើរ នេះ មកដល់ ក្រសួង និង គ្រប់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ជាពិសេស ត្រូវ បន្ត ផ្តល់ ការគាំទ្រ ដល់ កៅស៊ូ គ្រួសារ កម្ពុជា ធ្វើ យ៉ាងណា ជួយ លើកកម្ពស់ កម្រិត ជីវភាព របស់ ពួកគាត់ ឲ្យ មាន ភាពរីកចម្រើន ៕ ក្រោយ សម្រេច ព្រឹត្តិការណ៍ ប្រណាំង កង់ ពិភពលោក អគ្គ នាយក ក្លឹប ឆ្នេរ ស្អាត ជាង គេ លើ ពិភពលោក ចូលរួម រំលែក ទុក្ខ ចំពោះ ការបាក់ អគារ នៅ ខេត្ត កែប
លោក ប្រ៊ុយណូ ក៏ បាន ដឹង ថា មុន ពីរ បី ថ្ងៃ នៃ វិញ្ញាសារ ប្រកួត ជុំបញ្ចប់ នៅ ខេត្ត កែប ឧប្បទ្ទវហេតុ នៃ ការបាក់ រលំអគារ មួយ បាន កើត មាន ឡើង បាន បណ្តាលឲ្យ មាន អ្នកស្លាប់ ចំនួន ៣៦ នាក់ និង រងរបួស ជាច្រើ នាក់ ។ ខណៈ នោះ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី ហ៊ុន សែន បាន ចុះ ដឹកនាំ បញ្ជា ផ្ទាល់ ដល់ កន្លែង កើត ហានិភ័យ នោះ ។
ស្រប ជាមួយគ្នា នេះ ក្នុង នាម អង្គការ ឆ្នេរសមុទ្រ ដែល ស្អាត បំផុត លើ សកលលោក និង សហគម អន្ដរជាតិ ដែល បាន ចូលរួម នូវ ព្រឹត្ដិការណ៍ ប្រណាំង កង់ ពិភពលោក លោក សូម ចូលរួម សម្ដែង នូវ មរណទុក្ខ និង សេចក្ដីក្រៀមក្រំ តាមរយៈ រដ្ឋមន្ដ្រី ថោង ខុន ជូន ចំពោះ គ្រួសារ ជនរងគ្រោះ ក៏ ដូចជា ជូន ប្រជាពលរដ្ឋ ខេត្ដ កែប និង កម្ពុជា ទាំងមូល ។
ក្នុង ក្របខណ្ឌ នៃ ការកសាង កម្ពុជា បែប ទំនើប មួយ លោក ប្រ៊ុយណូ ក៏ បាន ជូន ពរ ប្រកបដោយ ជ្រៀល ជ្រៅ បំផុត ថា សន្ដិភាព និង ភាពសុខដុម គឺជា អទិភាព ជានិច្ច ៕
ក្រសួង បរិស្ថាន ជូន ដំណឹង បន្ទាន់ មួយ ស្តីពី វិធានការ ទប់ស្កាត់ និង កាត់បន្ថយ ការបំពុល ខ្យល់ សាធារណៈ ខណៈ ស្ថានភាព គុណភាព ខ្យល់ មាន ការធ្លាក់ចុះ គួរឲ្យ បារម្ភ
( ភ្នំពេញ ) ៖ នៅ ល្ងាច ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ នេះ ក្រសួង បរិស្ថាន បាន ចេញ សេចក្តីជូនដំណឹង ផ្លូវការ និង បន្ទាន់ មួយ ស្តីពី វិធានការ ទប់ស្កាត់ និង កាត់បន្ថយ ការបំពុល ខ្យល់ សាធារណៈ បន្ទាប់ពី លទ្ធផល នៃ ការអង្កេត តាមដាន គុណភាព ខ្យល់ បាន បង្ហាញ ថា ស្ថានភាព គុណភាព ខ្យុល់ មាន ការធ្លាក់ចុះ គួរឲ្យ បារម្ភ ជាពិសេស កំហាប់ ប៉ារ៉ាម៉ែត្រ ភាគ ល្អិត និចល PM10 និង PM2.5 មាន ការកើនឡើង លើស កំណត់ ស្តង់ដារ ដែល ជា ហានិភ័យ បង្ក ការប៉ះពាល់ ចំពោះ សុខភាព ប្រជាពលរដ្ឋ ។
ក្រសួង បរិស្ថាន បាន បង្ហាញ ពី វិធានការ ទប់ស្កាត់ និង កាត់បន្ថយ ការបំពុល ខ្យល់ ដូច ខាងក្រោម៖
( ភ្នំពេញ ) ៖ វិទ្យាស្ថាន ជាតិ សង្គមកិច្ច ក្រោម កិច្ចសហប្រតិបតិ្តការ ជាមួយ អង្គការ Unicef រៀបចំ ការបណ្តុះបណ្តាល ដល់ កម្លាំង សេវា សង្គម នៅ កម្ពុជា បាន ប្រកាស ជ្រើសរើស ទីប្រឹក្សា ជាតិ ដើម្បី បំពេញ ការងារ រយៈពេល ៣ខែ កន្លះ ( ៨០ ថ្ងៃ ) ដើម្បី រៀបចំ ផែនការ យុទ្ធសាស្រ្ត បណ្តុះបណ្តាល និង កញ្ចប់ បណ្តុះបណ្តាល ដូច ខាងក្រោម៖
២៖ បេក្ខភាព ដែល អាច ដាក់ពាក្យ ចូលរួម ត្រូវ មាន កម្រិត វប្បធម៌ ចាប់ពី ថ្នាក់ អនុបណ្ឌិត និង មាន បទពិសោធន៍ ពាក់ព័ន្ធ នឹង កិច្ចការ សង្គម ដើម្បី ការពារ កុមារ ពី អំពើហិង្សា និង ការជួញដូរ យ៉ាងហោចណាស់ ក៏ ០២ ឆ្នាំ ឡើង ទៅ ដែរ ។
៣៖ បន្ថែម ពី នេះ បេក្ខជន បេក្ខ នារី ត្រូវ ចេះ ភាសា អង់គ្លេស និង ខ្មែរ យ៉ាង ស្ទាត់ជំនាញ ព្រមទាំង អាច សរសេរ របាយការណ៍ នានា ដោយ លម្អិត ។
សម្រាប់ បេក្ខជន បេក្ខ នារី ដែល ចាប់អារម្មណ៍ អាច ធ្វើ ការដាក់ពាក្យ ទៅ តាម អាស័យដ្ឋាន ដូច បាន បង្ហាញ ខាងក្រោម ដែល នឹង ផុត កំណត់ នៅ ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ វេលា ម៉ោង ៥៖០០ នាទី ល្ងាច ៕
សិស្ស ប៊ែល ធី ជាង ២ពាន់ នាក់ ចូលរួម ប្រកួតប្រជែង សំណេរ ភាសា អង់គ្លេស លើក ទី៥
លោក ចាន់ ទីតា ប្រធាន នាយកដ្ឋាន ភាសា អង់គ្លេស ទូទៅ នៃ ប៊ែល ធី គ្រុប បាន ឲ្យដឹង ថា « គោលបំណង នៃ ការប្រកួត សំណេរ ភាសា អង់គ្លេស គឺ ធ្វើឲ្យ សិស្សានុសិស្ស ស្ទាត់ជំនាញ ក្នុង ការសរសេរ មាន ភាពក្លាហាន ហ៊ាន បញ្ចេញ សមត្ថភាព និង អាច ចូលរួម ប្រកួតប្រជែង សំណេរ ជា លក្ខណៈ ជាតិ និង អន្តរជាតិ » ។
ក្នុង ឱកាស នោះ ដែរ លោក បណ្ឌិត លី ឆេង បាន ថ្លែង កោតសរសើរ ចំពោះ ជយលាភី ទាំងអស់ ដែល បាន ខិតខំ ប្រឹងប្រែង សិក្សា រៀនសូត្រ និង មាន ភាពក្លាហាន ហ៊ាន បញ្ចេញ សមត្ថភាព ប្រកួតប្រជែង និង សរសេរ បាន យ៉ាង ស្ទាត់ជំនាញ ក្នុង ការប្រឡង នា ថ្ងៃ នេះ ។
លោក បណ្ឌិត បាន ថ្លែងអំណរគុណ ចំពោះ មាតាបិតា និង អាណាព្យាបាល សិស្ស ទាំងអស់ ដែល តែងតែ គាំទ្រ លើ ការអប់រំ របស់ សាលា ប៊ែល ធី អន្តរជាតិ រហូតមក ទាំង ផ្នែក ចំណេះ ទូទៅ និង ភាសា អង់គ្លេស ទូទៅ ដែល ធ្វើឲ្យ សាលា មាន លទ្ធភាព ពង្រីក ទីតាំង និង ពង្រឹង គុណភាព អប់រំ ឱ្យ បាន កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ បន្ថែម ទៀត ស្រប តាម បាវចនា របស់ ប៊ែល ធី គឺ « គុណភាព ប្រសិទ្ធភាព ឧត្តមភាព សីលធម៌ គុណធម៌ » ។
បន្ថែម ពី នេះ លោក បណ្ឌិត លី ឆេង ក៏ បាន ផ្តាំផ្ញើ ដល់ សិស្សានុសិស្ស ទាំងអស់ មិន ត្រូវ យក ពេល ទំនេរ ទៅ ដើរលេង សេព គប មិត្តភក្តិ មិន ល្អ ត្រូវ ចៀសវាង ឲ្យ ផុត ពី គ្រឿងញៀន និង ល្បែងស៊ីសង ដែល សង្គម ស្អប់ខ្ពើម ។ គឺ ត្រូវ ខិតខំ សិក្សា រៀនសូត្រ ពង្រឹង សមត្ថភាព ដើម្បី ធ្វើ ខ្លួន ឲ្យ សាកសម ជា ទំពាំង ស្នង ឫស្សី និង ក្លាយជា ធនធាន មនុស្ស ដ៏ សំខាន់ ក្នុង ការអភិវឌ្ឍ ប្រទេស ជាតិ នា ពេល អនាគត ។
