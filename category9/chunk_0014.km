ក្រោយ ចាប់ខ្លួន កម្លាំង បាន វត្ថុតាង ដកហូត បាន រួម មាន៖ រថយន្ត ម៉ាក កាម ម៉ារី ០១ គ្រឿង ម៉ាស៊ីន រាវ ចំនួន ០២ គ្រឿង និង សម្ភារ ជីក គាស់ កាយ មួយចំនួន ទៀត ។
ក្រោយពី បាន ស្តាប់ ចម្លើយ សារភាព ជនសង្ស័យ ទាំង ០៥ នាក់ រួច មក សមត្ថកិច្ច បាន កសាង សំណុំរឿង បញ្ជូន ខ្លួន ជនសង្ស័យ ទាំង ០៥ នាក់ និង វត្ថុតាង ទៅ សាលាដំបូង ខេត្ត ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕ សិក្សា ថ្នាក់ អនុបណ្ឌិត ផ្នែក គ្រប់គ្រង ធុរកិច្ច ឥឡូវនេះ នៅ សាកលវិទ្យាល័យ AUPP
( ភ្នំពេញ ) ៖ ក្រោយ បញ្ចប់ ថ្នាក់ បរិញ្ញាបត្រ និស្សិត ជាច្រើន តែងតែ មាន បំណង ទៅ សិក្សា ថ្នាក់ អនុបណ្ឌិត នៅ សាកលវិទ្យាល័យ នានា លើ ពិភពលោក ជាពិសេស នៅ ប្រទេស ធំ ៗ ដូចជា សហរដ្ឋ អាមេរិក បារាំង អូស្រ្តាលី ណូវែលសាឡង់ ជាដើម ដោយ តម្រូវ ឱ្យ និស្សិត ត្រូវ ទៅ សិក្សា ដោយ ផ្ទាល់ នៅ ប្រទេស ទាំងនោះ និង ចំណាយ ថវិការ ដ៏ ច្រើន សន្ធឹកសន្ធាប់ ។
ចាប់ពី ពេលនេះ តទៅ វា លែង ជា ក្តីបារម្ភណ៍ ទៀត ហើយ សម្រាប់ និស្សិត ដែល ចង់ រៀន ថ្នាក់ អនុបណ្ឌិត ស្រប តាម ស្តង់ដារ អាមេរិក ដោយ គ្រាន់តែ សិក្សា នៅ សាកលវិទ្យាល័យ អាមេរិកាំង ភ្នំពេញ (AUPP) នោះ ពួកគាត់ នឹង ទទួលបាន ការអប់រំ ថ្នាក់ អនុបណ្ឌិត ផ្នែក គ្រប់គ្រង ធុរកិច្ច ដែល ប្រកបដោយ គុណភាព ខ្ពស់ ពិសេស ជាង នេះ ទៅ ទៀត ពួកគាត់ នឹង មិន ចាំបាច់ ចំណាយ ប្រាក់កាស ច្រើន ឬ ឃ្លាត ឆ្ងាយ ពី ក្រុមគ្រួសារ ឡើយ ព្រោះ ពួកគេ អាច សិក្សា នៅក្នុង ប្រទេស កម្ពុជា តែម្តង ។
ថ្នាក់ អនុបណ្ឌិត នៅ AUPP មាន គោលដៅ រៀបចំ និស្សិត ដែល បញ្ចប់ ការសិក្សា ឱ្យ ទទួលបាន ភាពជោគជ័យ ក្នុង វិស័យ ជំនួញ ទាំង ក្នុង និង ក្រៅ ប្រទេស ទាំង ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ និង ពិភពលោក ។ ជាមួយនឹង កម្មវិធី សិក្សា ស្តង់ដារ អាមេរិក និង បង្រៀន ដោយ សាស្រ្តាចារ្យ ជនជាតិ អាមេរិកាំង និង ប្រទេស លោក ខាងលិច ដែល មាន បទពិសោធ យូរ ឆ្នាំ និស្សិត នឹង អភិវឌ្ឍ ចំណេះដឹង និង សមត្ថភាព ទៅ លើ យុទ្ធសាស្រ្ត គ្រប់គ្រង ធុរកិច្ច ភាព ជា អ្នកដឹកនាំ និង សហគ្រិន ភាព ។
កម្មវិធី សិក្សា ត្រូវបាន ត្រួតពិនិត្យ យ៉ាង យកចិត្តទុកដាក់ បំផុត ក្រោម គណៈកម្មាធិការ ត្រួតពិនិត្យ កម្មវិធី សិក្សា ថ្នាក់ អនុបណ្ឌិត ផ្នែក គ្រប់គ្រង ធុរកិច្ច ហើយក៏ ជា កម្មវិធី សិក្សា ថ្មី ដែល ត្រូវបាន រៀបចំឡើង ដោយ មាន ការចូលរួម យ៉ាង សកម្ម ពី អ្នកជំនាញ ជាច្រើន រូប រួម មាន សាស្ត្រាចារ្យ និស្សិត អតីត និស្សិត បុគ្គលិក និង អ្នកជំនាញ ផ្សេង ៗ ។
និស្សិត ត្រូវការពេល តែ មួយ ឆ្នាំ កន្លះ ប៉ុណ្ណោះ ដើម្បី បញ្ចប់ ថ្នាក់ អនុបណ្ឌិត នេះ ។ និស្សិត រៀន មួយ សប្តាហ៍ បី ថ្ងៃ គឺ ច័ន្ទ ពុធ សុក្រ ពី ម៉ោង ៥៖៣០ ដល់ ៨៖៣០ ល្ងាច ។
ថ្នាក់ អនុបណ្ឌិត ផ្នែក គ្រប់គ្រង ធុរកិច្ច នេះ គឺជា ឱកាស ដ៏ ល្អ ប្រសើរ សម្រាប់ និស្សិត ដែល ចង់ បន្ត ការអប់រំ ថ្នាក់ ឧត្តម សិក្សា ប្រកបដោយ គុណភាព ខ្ពស់ ។ AUPP ទទួល ពាក្យ ចូលរៀន ចាប់ពី ពេលនេះ តទៅ ។ វគ្គ ថ្មី ចូលរៀន នៅ ថ្ងៃទី ១១ ខែឧសភា ឆ្នាំ ២០២០ ។
សេចក្តីប្រកាស ព័ត៌មាន បាន បន្ត ថា នៅ ឆ្នាំ ២០១៩ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន បង្វែរ ថវិកា ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា ជា បន្តបន្ទាប់ សរុប ចំនួន ប្រមាណ ១១លាន ដុល្លារ ក្នុង នោះ ប្រាក់ រៀល ចំនួន ៨ប៊ីលាន រៀល និង ប្រាក់ ដុល្លារ ចំនួន ៨. ៨៩២. ៤០៤ ដុល្លារ ។
( វ៉ាស៊ីនតោន ) ៖ ប្រធានាធិបតី សហរដ្ឋ អាមេរិក លោក ដូណាល់ ត្រាំ បាន ប្រកាស នៅ ថ្ងៃព្រហស្បតិ៍ នេះ ( ពេលវេលា នៅ វ៉ាស៊ីនតោន ) ថា ស្ថាបនិក និង ជា មេដឹកនាំ នៃ ក្រុម ចលនា ភេរវកម្ម អាល់កៃដា ប្រចាំ ឧបទ្វីប អារ៉ាប់ ឬ ហៅ កាត់ ថា AQAP ពិតជា ត្រូវបាន កងទ័ព អាមេរិក ផ្តាច់ ជីវិត នៅក្នុង ប្រទេស យ៉េមែន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នា ព្រឹក ថ្ងៃសុក្រ ទី ០៧ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
អាជ្ញាធរ ចិន បាន បញ្ចេញ របាយការណ៍ ប្រចាំ ថ្ងៃ នៅ ព្រឹក ថ្ងៃសុក្រ នេះ អំពី ស្ថានភាព នៃ ការរីករាលដាល វីរុស កូរ៉ូណា ថ្មី នៅ ទូទាំង ផ្ទៃ ប្រទេស ក្នុង នោះ ចំនួន មនុស្ស ស្លាប់ បាន កើនឡើង ដល់ ៦៣៦ នាក់ និង ឆ្លង ៣១. ១៦១ នាក់ នៅក្នុង ខេត្ត និង តំបន់ សរុប ចំនួន ៣១ របស់ ចិន ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ជូន បងប្អូន ជន រួម ជាតិ ថា នៅ ពេល នេះ សុខភាព របស់ សម្តេច មិន មាន អ្វី ប្រែប្រួល ទេ គឺ នៅ រឹងមាំ ដូច ធម្មតា ។
ជាពិសេស នោះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា បន្ទាប់ពី ដំណើរទស្សនកិច្ច របស់ សម្តេច ទៅ ទីក្រុង ប៉េកាំង ជួប មេដឹកនាំ កំពូល របស់ ចិន នោះ បាន ធ្វើឲ្យ កម្ពុជា នៅ កាន់តែ ជិត ជាមួយ មិត្ត ចិន ពិសេស ក្នុង កាលៈទេសៈ ដ៏ លំបាក ដែល ចិន កំពុង ជួប វិបត្តិ បង្កឡើង ដោយ វីរុស កូរ៉ូណា នេះ ។
ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា ចេញ សេចក្តីសម្រេច ផ្លាស់ប្តូរ ប្រធាន មន្ទីរ រៀបចំ ដែនដី ខេត្ត កណ្តាល . លោក សុក កាន់ ណារិទ្ធ ជំនួស លោក លឹម ចាន់ សូភី
( ភ្នំពេញ ) ៖ លោក ឧប នាយក រដ្ឋមន្ត្រី ជា សុផារ៉ា រដ្ឋមន្ត្រី ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ បាន ចេញ សេចក្តីសម្រេច ផ្លាស់ប្តូរ ប្រធាន មន្ទីរ រៀបចំ ដែនដី ខេត្ត កណ្តាល ដោយ លោក សុក កាន់ ណារិទ្ធ ត្រូវបាន តែងតាំង ជា ប្រធាន មន្ទីរ ជំនួស លោក លឹម ចាន់ សូភី ដែល ត្រូវ ចាត់ ឲ្យ មក បម្រើ ការងារ នៅ ទីស្តីការ ក្រសួង រៀបចំ ដែនដី ។ នេះ បើ តាម សេចក្តីសម្រេច ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៧ ខែកុម្ភៈ នេះ ៕
ក្រសួង ធនធាន ទឹក៖ តំបន់ ជួរ ភ្នំ ដងរែក និង ខ្ពង់រាប ឦសាន នឹង ចុះ ត្រជាក់ ដល់ ១៧អង្សា សេ ខណៈ តំបន់ ទំនាប កណ្តាល និង មាត់ សមុទ្រ នឹង មាន ភ្លៀង ធ្លាក់ ក្នុង កម្រិត ខ្សោយ ទៅ មធ្យម
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ស្ថានភាពធាតុអាកាស នៅ កម្ពុជា ចាប់ពី ថ្ងៃ នេះ ដល់ ១០ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
សេចក្តីជូនដំណឹង របស់ ក្រសួង ធនធាន ទឹក បាន បញ្ជាក់ ថា តាមរយៈ ការតាមដាន ស្ថានភាព អាកាសធាតុ ជាប់ ជា បន្តបន្ទាប់ សង្កេតឃើញ ថា ចាប់ពី ថ្ងៃទី ០៤ ដល់ ទី១០ ខែកុម្ភៈ ជ្រលង សម្ពាធ ខ្ពស់ រំកិល គ្របដណ្តប់ លើ កម្ពុជា ។
ស្ថានភាព បែប នេះ ធ្វើ ឲ្យ៖
នៅ ថ្ងៃទី ៩ - ១០ ខែកុម្ភៈ ផ្នែក មួយចំនួន នៃ បណ្តា ខេត្ត នៅ តំបន់ វាល ទំនាប ភាគ ខាងក្រោម និង ខេត្ត នៅ ជាប់ មាត់ សមុទ្រ នឹង អាច មាន ភ្លៀង ក្នុង កម្រិត ខ្សោយ ទៅ មធ្យម ៕
