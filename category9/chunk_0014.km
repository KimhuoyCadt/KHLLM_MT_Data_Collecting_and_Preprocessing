( ប៉េកាំង ) ៖ ចិន កំពុង ពិចារណា លើក ពេល កិច្ចប្រជុំ សភា ប្រចាំ ឆ្នាំ ខណៈ កំពុង ប្រយុទ្ធ ប្រឆាំង នឹង ការរីករាលដាល នៃ វីរុស កូរ៉ូណា ដែល បង្ខំឱ្យ ប្រទេស ជាច្រើន ចាត់ វិធានការរឹតត្បិត លើ ការធ្វើដំណើរ មកកាន់ ចិន ដី គោក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
គួរ បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃព្រហស្បតិ៍ ទី០៦ ខែកុម្ភៈ នេះ ចំនួន មនុស្ស ស្លាប់ ដោយសារ វីរុស កូរ៉ូណា ថ្មី 2019-nCoV ក្នុង ប្រទេស ចិន បាន កើនឡើង ដល់ ៥៦៣ នាក់ ហើយ ខណៈ មនុស្ស រហូតដល់ ២៨. ០១៨ នាក់ បាន ឆ្លង ៕ កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ ប្រលង កាយសម្បទា តាម វិធីសាស្ត្រ ចម្រុះ ប្រចាំ ឆ្នាំ
( ភ្នំពេញ ) ៖ កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ តែង បាន ធ្វើ ការហ្វឹកហាត់ ជាប់ ជាប្រចាំ ដើម្បី ពង្រឹង កាយសម្បទា តាមរយៈ ការហ្វឹកហាត់ ក្បាច់គុណ ការហាត់ប្រាណ តាម វិធីសាស្ត្រ ចម្រុះ ការថែទាំ សុខភាព និង អនាម័យ ក្នុង ការរស់នៅ ជា ទៀងទាត់ ដើម្បី បង្កើន សមត្ថភាព ក្នុង ប្រតិបត្តិការ លើ ការងារ បង្កា បង្ក្រាប និង សង្គ្រោះ ។
ព្រម ជាមួយគ្នា នោះ ផងដែរ ជារៀងរាល់ ឆ្នាំ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន បង្កើត ឲ្យ មាន កម្មវិធី ប្រលង កាយ សម្បទា ដែល ជា ការជម្រុញ ទឹកចិត្ត កងកម្លាំង ឲ្យ ប្រឹងប្រែង ហ្វឹកហាត់ ដើម្បី ប្រកួតប្រជែង គ្នា ។
ជាក់ស្តែង នៅ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ធ្វើ ការប្រលង កាយសម្បទា ប្រចាំ ឆ្នាំ ២០២០ នៅក្នុង បរិវេណ ពហុកីឡាដ្ឋាន ជាតិ អូរ ឡាំពិក ប្រកបដោយ ភាពស្វាហាប់ ៕ ប្រជាពលរដ្ឋ នៅ ភ្នំពេញ អាច បង់ ថ្លៃ សំរាម និង សំណល់ រឹង តាមរយៈ អេស៉ី លីដា ទាន់ចិត្ត App ដោយ ឥត គិត ថ្លៃ
( ភ្នំពេញ ) ៖ សន្តិភាព បាន ផ្តល់ សេចក្តីសុខ ដល់ មនុស្ស ទាំងឡាយ រស់ នៅ បាន សប្បាយ សុខដុមរម្យ នា ជួបជុំគ្នា មាន សុភមង្គល ជាមួយនឹង ជីវភាព កិច្ចការ ប្រចាំ ថ្ងៃ ។ ដើម្បី រួមចំណែក អភិវឌ្ឍន៍ ប្រទេសជាតិ របស់ យើង ឲ្យ កាន់តែ រីកចម្រើន និង បង្កើន ជីវភាព កាន់តែ សម្បូរសប្បាយ រួម នឹង បំណងប្រាថ្នា រស់ នៅ មាន ផាសុកភាព ទីក្រុង ស្អាត ចាប់ផ្តើម ពី យើង ទាំងអស់ គ្នា ។
លោក អភិបាល រង បាន បញ្ជាក់ ថា ប្រជាពលរដ្ឋ ដែល ត្រូវ បង់ ថ្លៃ សេវា ប្រមូល សំរាម នៅក្នុង ខែមករា នេះ គឺ គ្មាន ការប្រែប្រួល ទេ គឺ អនុវត្តន៍ តាម តារាង តម្លៃ កាលពី ខែតុលា ឆ្នាំ ២០១៩ កន្លងទៅជា គោល ។
លោក បាន បន្ត ថា « ការបង់ សេវា សំរាម ពុំ មែន ជា ការបង់ ដោយ ស្ម័គ្រចិត្ត ទេ ព្រោះ យើង អ្នកផលិត សំរាម ត្រូវ តែ បង់លុយ មិន អាច គេចវេស បាន ទេ ។ ក្នុង អំឡុង អន្តរកាល នេះ គឺ ឲ្យ គាត់ បង់ ពី ថ្ងៃទី១ ដល់ ថ្ងៃទី ១៥ ខែកុម្ភៈ បើ យឺត ពេលនេះ យើង កត់ ចូល ជា បំណុល ។ ក្នុង ករណី មិន បង់ គឺ យើង មាន វិធានការ ឧទាហណ៍ ម្ចាស់ ភោជ្ជនីយដ្ឋាន មិន បង់ គឺ ដកហូត ការធ្វើ អាជីវកម្ម ទាល់តែ បង់ ទើប ប្រគល់ឲ្យ វិញ » ។
យ៉ាងណា ក៏ លោក បាន បន្ថែម ថា ក្នុង អំឡុង ពេល អន្តរកាល នេះ យើង មិន ទាន់ អនុវត្ត វិធានការណ៍ ច្បាប់ ទេ គឺ ទុកឲ្យ គាត់ មក បង់លុយ ប្រកបដោយ មនសិការ ដើម្បី ធានា ឲ្យ ទីក្រុង យើង មាន សោភ័ណភាព ស្រស់ស្អាត ។
លោក ហួត ហៃ អភិបាល រង រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ប្រព័ន្ធ បង់ប្រាក់ សេវា ប្រមូល សំរាម នេះ ចាប់ បើក ពី ថ្ងៃទី ១ដល់ ថ្ងៃទី ១៥ ខែកុម្ភៈ ដូច្នេះ ប្រជាពលរដ្ឋ ដែល ខកខាន បង់ គឺ ចាត់ ចូល ជា បំណុល ដែល ត្រូវ បង់ នៅ ខែ បន្ទាប់ ។
ក្នុង កិច្ចប្រជុំ នោះ គឺ មាន អ្នក រស់ នៅ សិង្ហបុរី ផ្ទាល់ ចំនួន ១៥នាក់ និង ៩៤ នាក់ ទៀត មកពី ក្រៅ ប្រទេស ខណៈ ពួកគេ ជា បុគ្គលិក របស់ ក្រុមហ៊ុន តែ មួយ ។ ក្រៅពី បុរស ជនជាតិ ម៉ាឡេស៊ី ខាងលើ ជនជាតិ កូរ៉ូ ខាងត្បូង ០២ នាក់ ដែល បាន ទៅ ចូលរួម កិច្ចប្រជុំ ក៏ ត្រូវបាន ធ្វើតេស្ត រកឃើញ វីរុស នៅ ប្រទេស កូរ៉េ ខាងត្បូង ផងដែរ ខណៈ អ្នក រស់ នៅ សិង្ហបុរី ០៤ នាក់ ដែល បាន ចូលរួម កិច្ចប្រជុំ នោះ បាន បង្ហាញ រោគសញ្ញា សង្ស័យ និង កំពុង រង់ចាំ លទ្ធផល ធ្វើតេស្ត ។
( កំពង់ស្ពឺ ) ៖ យោង តាម សេចក្តីសម្រេច ស្តីពី ការបង្កើត អនុគណកម្មការគ្រប់គ្រង វគ្គ បំប៉ន ជំនាញ កងរាជអាវុធហត្ថ លើក ទី១ ឆ្នាំ ២០២០ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២៩ នេះ លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ បាន អញ្ជើញ បើក វគ្គ បំប៉ន ជំនាញ កងរាជអាវុធហត្ថ លើក ទី១ ឆ្នាំ ២០២០ ដល់ សិក្ខាកាម ៣០ នាក់ ស្មើ ចំនួន ១២៦ ម៉ោង ។
ពិធី បើក វគ្គ បំប៉ន នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី មេបញ្ជាការ រង សេនាធិការដ្ឋាន អនុប្រធាន មន្ទីរ ទាំង ៥ នាយ ការិយាល័យ មេបញ្ជាការ ក្រុង / ស្រុក យ៉ាង ច្រើន ផងដែរ ។
ក្នុង ពិធី បើក វគ្គ នេះ លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន ក៏ បាន ជំរុញ ឱ្យ សិក្ខាកាម ទាំងអស់ ត្រូវ គោរព វិន័យ ខិតខំ រៀនសូត្រ និង តាមដាន ស្តាប់ ដោយ យកចិត្តទុកដាក់ បំផុត ជាពិសេស កក់ ត្រា ពេល លោកគ្រូ ឧទ្ទេសនាម ពន្យល់ គ្រប់ មេរៀន ទាំងអស់ ។ ជាមួយគ្នា នោះ សិក្ខាកាម ត្រូវ ស្លៀកពាក់ ឯកសណ្ឋាន ឱ្យ ត្រឹមត្រូវ រក្សា បាន របៀបរៀបរយ ក្នុង ថ្នាក់រៀន ដោយ ហាម ដាច់ខាត រាល់ ការនិយាយ រំខាន ដល់ ការរៀនសូត្រ របស់ សិក្ខាកាម និង ការធ្វើឱ្យ ខូចខាត ដោយ ចេតនា សម្ភារៈ ក្នុង ថ្នាក់រៀន ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ត្រី បាន បន្ត ថា ចំពោះ វគ្គ ហ្វឹកហ្វឺន នេះ ថា ការរៀនសូត្រ គឺជា ការធ្វើ ទំនើបកម្ម និង បំពេញ ជំនាញ បន្ថែម ជូន នាយ ទាហាន នាយ ទហាន រង ដើម្បី ពង្រឹង សមត្ថភាព ផ្តល់ ជំនាញ តាមរយៈ ការហ្វឹកហ្វឺន បន្ត ក្នុង មួយ ឆ្នាំ ៣ដង ។
លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន បាន បញ្ជាក់ ថា ការរៀនសូត្រ ជា ចក្ខុវិស័យ រយៈពេល វែង របស់ អង្គភាព និង សម្រាប់ នាយ ទាហាន នាយ ទហាន រង គឺ ការកសាង មូលដ្ឋាន គ្រិះ នៃ ការបណ្តុះបណ្តាល ជាពិសេស គឺ ជំនាញ ដែល តម្រូវ ឱ្យ មាន ការខិតខំ រៀនសូត្រ ព្រមទាំង ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ សមស្រប មាន ចំណេះដឹង និង បទពិសោធន៍ ពិតប្រាកដ ៕ ក្រសួង ព័ត៌មាន នឹង រៀបចំ សិក្ខាសាលា ស្ដីពី ការផ្សាយ ព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ និង ក្រមសីលធម៌ នៅ ថ្ងៃទី ១២ ខែកុម្ភៈ
( ភ្នំពេញ ) ៖ ក្រសួង ព័ត៌មាន បាន ចេញ សេចក្តីជូនដំណឹង ដល់ អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ ឲ្យបាន ជ្រាប ថា ខ្លួន នឹង រៀបចំ សិក្ខាសាលា ស្ដីពី ការផ្សាយ ព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ និង ក្រមសីលធម៌ នៅ ព្រឹក ថ្ងៃពុធ ទី ១២ ខែកុម្ភៈ ឆ្នាំ ២០២០ ខាងមុខ នេះ ។
យោង តាម សេចក្តីជូនដំណឹង ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃ នេះ បាន ឲ្យដឹង ថា មូលហេតុ នៃ ការបើក សិក្ខាសាលា ស្ដីពី ការផ្សាយ ព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ និង ក្រមសីលធម៌ ដើម្បី បញ្ជ្រាប ចំណេះដឹង ដល់ អ្នកសារព័ត៌មាន សម្តៅ ដល់ ការធានា ផ្សព្វផ្សាយ ព័ត៌មាន ប្រកបដោយ វិជ្ជាជីវៈ ចៀសវាង ផ្សព្វផ្សាយ ព័ត៌មាន មិន ពិត ដែល មាន លក្ខណៈ ញុះញង់ បង្កាច់បង្ខូច បំប៉ោង ស្ថានការណ៍ ឬ ព្រឹត្តិការណ៍ ណាមួយ នាំឲ្យ សាធារណជន មាន ការភាន់ច្រឡំ ៕
ខាងក្រោម នេះ ជា សេចក្តីជូនដំណឹង របស់ ក្រសួង ព័ត៌មាន៖
ការសំណូមពរ របស់ លោក ផៃ ស៉ី ផាន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ក្នុង ឱកាស ដែល អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា រៀបចំ សន្និសីទ សារព័ត៌មាន នៅ ទីស្តីការ គណៈ ស្តីពី « បច្ចុប្បន្នភាព និង វឌ្ឍនភាព ក្រសួង ពាណិជ្ជកម្ម » ។
បើ តាម លោក ផៃ ស៉ី ផាន ប្រព័ន្ធ អនុគ្រោះ ពន្ធ ទំនិញ គ្រប់ យ៉ាង លើកលែងតែ សព្វាវុធ ឬ ហៅ កាត់ ថា EBA គ្រាន់តែ ជា ព្រឹត្តិការណ៍ នយោបាយ មិន មែន ជា បី សាច ដូច វីរ៉ុស កូរ៉ូណា ទេ ពោល វា គ្រាន់តែ ជា ព្រឹត្តិការណ៍ ធ្វើ វិទ្ធង្ស នា ផ្លូវ ចិត្តសាស្ត្រ តែ ប៉ុណ្ណោះ ។ លោក បន្ត ថា រាជ រដ្ឋាភិបាល បាន រៀបចំ ជា កញ្ចប់ ថវិកា ស្រេច រួចទៅហើយ ដើម្បី ឆ្លើយតប ជាមួយនឹង ការដក ឬ ការកាត់បន្ថយ EBA ។
លោក បន្ថែម ថា ការកាត់បន្ថយ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ EBA គ្រាន់តែ ឲ្យ កម្ពុជា ឬ អ្នកនាំចេញ អ៉ីវ៉ាន់ ពី កម្ពុជា បង្កើន ការ បង់ ពន្ធ តែ ប៉ុណ្ណោះ ដោយឡែក កម្ពុជា អត់ មាន បាត់ ទីផ្សារ នៅ សហគមន៍ អឺរ៉ុប នោះ ទេ ។ លោក ថ្លែង ថា កម្ពុជា មាន ផែនការ ត្រឹមត្រូវ ហើយ EBA មិន មែន ជា មូលដ្ឋានគ្រឹះ និង ជា ចំណុច សំខាន់ សម្រាប់ កំណើន សេដ្ឋកិច្ច របស់ កម្ពុជា ទេ ។
សូម បញ្ជាក់ ថា សហភាព អឺរ៉ុប បាន ផ្ញើ របាយការណ៍ របស់ ខ្លួន មកកាន់ រដ្ឋាភិបាល កម្ពុជា កាលពី ថ្ងៃទី ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ កន្លងទៅ និង ទុក រយៈពេល ១ ខែ ដើម្បីឲ្យ ភាគី កម្ពុជា ធ្វើ ការឆ្លើយតប ។ បន្ទាប់ពី កម្ពុជា ឆ្លើយតប សហភាព អឺរ៉ុប នឹង ធ្វើ សេចក្តីសម្រេចចិត្ត មួយ នៅ ខែកុម្ភៈ ឆ្នាំ ២០២០ ថា តើ ត្រូវ ដក ការអនុគ្រោះ ពន្ធ របស់ កម្ពុជា ជាបណ្តោះអាសន្ន ឬ យ៉ាងណា ។
សេចក្តីសម្រេចចិត្ត នេះ គឺ ត្រូវ ធ្វើឡើង ដោយ សំឡេង ភាគ ច្រើន នៅក្នុង ចំណោម សមាជិក ទាំង ២៧ នៃ គណៈកម្មការ អឺរ៉ុប ។ បើសិន គណៈកម្មការ អឺរ៉ុប សម្រេច មិន ព្យួរ ប្រព័ន្ធ អនុគ្រោះ ពន្ធ នេះ ទេ នោះ នីតិវិធី ត្រូវ បិទ បញ្ចប់ ត្រឹម នេះ ។
ប្រទេស កម្ពុជា ទំនងជា ប៉ះពាល់ ខ្លះ ដល់ វិស័យ កាត់ដេរ សម្លៀកបំពាក់ និង ស្បែកជើង ប្រហែលជាង ២០ ភាគរយ ដែល ស្មើនឹង ទឹកប្រាក់ ចំនួន ៥០០ លាន ដុល្លារ សហរដ្ឋ អាមេរិក តែ ប៉ុណ្ណោះ ប៉ុន្តែ កម្ពុជា បាន ត្រៀម ខ្លួន រួច ជាស្រេច ហើយ លើ បញ្ហា នេះ ។ នេះ បើ តាម ការលើកឡើង របស់ លោក វង្ស៊ី វិស្សុត រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដែល លោក ទទួលបាន ក្រៅ ផ្លូវការ ។ ព័ត៌មាន ក្រៅ ផ្លូវការ នៅ ការសម្រេច របស់ អឺរ៉ុប គ្រោង ប្រកាស នៅ ទី១២ ខែកុម្ភៈ ឆ្នាំ ២០២០ ខាងមុខ នេះ ។
លោក ថា ឆ្លើយតប នឹង ភាព មិន ប្រាកដប្រជា នៃ ប្រព័ន្ធ អនុគ្រោះ ផ្សេង ៗ ដែល ផ្តល់ ជូន ពី ដៃគូ អភិវឌ្ឍន៍ នៅ ឆ្នាំ ២០២០ នេះ រាជ រដ្ឋាភិបាល បាន បម្រុង ថវិកា ៣ភាគរយ នៃ ថវិកា ជាតិ ស្មើនឹង ប្រមាណ ៧០០ លាន ដុល្លារ ដើម្បី ត្រៀម ដោះស្រាយ បញ្ហា ដែល អាច កើតមាន ឡើយ ៕
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ប្រធាន អនុគណៈកម្មការ ទី២ នៃ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក នៅ រសៀល ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ដឹកនាំ កិច្ចប្រជុំ ផ្សព្វផ្សាយ ផែនការ សកម្មភាព ការរឹតបណ្ដឹង ច្បាប់ ស្ដីពី ចរាចរណ៍ ផ្លូវគោក ឆ្នាំ ២០២០ ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ធ្វើឡើង នៅ ទីស្ដីការ ក្រសួង មហាផ្ទៃ ដែល មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ . ស្នងការ រាជធានី - ខេត្ត ទាំង២៥ និង តំណាង ស្ថាប័ន ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត ផងដែរ ។
លោក ស៊ាង ថៃ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « យើង សង្កេតឃើញ ថា ក្នុង រយៈពេល ខ្លី មួយ ខែ នេះ គឺ ការនាំចេញ របស់ យើង ក្រសួង ពាណិជ្ជកម្ម ពិនិត្យ ទៅ លើ ការសុំ លិខិត អនុញ្ញាត នាំចេញ ទំនិញ ទាំងឡាយ ទៅកាន់ ប្រទេស ចិន មិន មាន ការប្រែប្រួល អ្វី ទេ ។ ដំណើរការ នៅ ប្រក្រតី អ្នក ស្នើសុំ គឺ នៅតែ ដដែល ហើយ បើ យើង ក្រឡេង មើល ទៅ យើង នៅតែ អាច និយាយ បាន ថា វីរ៉ុស នេះ វា វាយ ទៅ លើ មនុស្ស រីឯ ទំនិញ មិន មាន ជាបញ្ហា អ្វី ទេ យើង បញ្ជូន ទំនិញ ជាធម្មតា ទេ » ។
អ្នកនាំពាក្យ រូប នេះ បន្ត ថា កម្ពុជា ក៏ កំពុង រង់ចាំ មើល ថា តើ ការផ្ទុះឡើង នៃ វីរុស កូរ៉ូណា នេះ អូសបន្លាយ រយៈពេល វែង បែប ណា ហើយ អាចនឹង ជះឥទ្ធ ពល យ៉ាងណា ចំពោះ វិស័យ ពាណិជ្ជកម្ម របស់ កម្ពុជា ប៉ុន្តែ ចំពោះ ពេល បច្ចុប្បន្ន នេះ ដំណើរការនាំចេញ នាំចូល ពី កម្ពុជា ទៅ ចិន និង ពី ចិន កម្ពុជា នៅតែ ដំណើរការ ធម្មតា ។
លោក ប៉ែន សុវិជាតិ អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ឆ្លាស់ វេន ក្រសួង ពាណិជ្ជកម្ម បាន ឲ្យដឹង ថា ការផ្ទុះឡើង នៃ ជំងឺ កូរ៉ូណា បាន ប៉ះពាល់ ដល់ ស្ថានភាព សេដ្ឋកិច្ច ជា សកល ប៉ុន្តែ ចំពោះ ការប្តេជ្ញាចិត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង រដ្ឋាភិបាល ចិន គឺ មិន មាន បិទ ច្រក ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង២ ដោយសារតែ ភ័យខ្លាច វីរុស កូរ៉ូណា នោះ ទេ ។
លោក សុវិជាតិ បាន បញ្ជាក់ ថា « យើង អាច សម្លឹង ឃើញ ផលវិបាក វែងឆ្ងាយ ប៉ុន្តែ បច្ចុប្បន្ន មិន មាន ផលវិបាក ទេ ដោយ យើង កំពុង រក្សា នៅក្នុង ស្ថានភាព ដដែល នៃ ការនាំចេញ របស់ យើង ទៅកាន់ ប្រទេស ចិន ក៏ ដូចជា ការនាំចូល ទំនិញ ពី ចិន មក កម្ពុជា យើង » ។
លោក ប៉ែន សុវិជាតិ បាន បង្ហាញ នូវ ក្តីសង្ឃឹម និង ជឿជាក់ ថា ដោយសារតែ ទំនាក់ទំនង ល្អ រវាង កម្ពុជា - ចិន ជាមួយនឹង គោល នយោបាយ ជំរុញ ការវិនិយោគិន របស់ ចិន មក កម្ពុជា រោងចក្រ កែច្នៃ ផលិត កសិកម្ម ដែល វិនិយោគ ដោយ ភាគី ចិន នឹង បង្កើតឡើង ជា បន្តបន្ទាប់ នៅ ប្រទេស កម្ពុជា ជាក់ ជា ពុំ ខាន ។
អ្នកនាំពាក្យ រូប នេះ និយាយ ថា « ខ្ញុំ ជឿជាក់ ថា នៅ ពេល ដែល មហា មិត្ត ចិន មើញ ឃើញ ថា ប្រទេស កម្ពុជា បច្ចុប្បន្ន មិន មាន ការរើសអើង ហើយ មាន សេចក្តីក្លាហាន ក្នុង ការបន្ត ទំនាក់ទំនង សេដ្ឋកិច្ច ជាមួយគ្នា នេះ គឺ ការទាក់ទាញ វិនិយោគ របស់ អ្នក វិនិយោគ ចិន មក ធ្វើ កិច្ចការ រកស៊ី នៅក្នុង ប្រទេស កម្ពុជា បច្ចុប្បន្ន នេះ យើង ជួប ការលំបាក បន្តិច មែន ប៉ុន្តែ ទៅ អនាគត ការលំបាក នេះ ទៅជា ភាពងាយស្រួល វិញ យើង គិត ថា ក្រោយ ភ្លៀង មេឃ និង ស្រឡះ » ។
សូម ជម្រាប ថា ទំហំ ពាណិជ្ជកម្ម កម្ពុជា - ចិន ឆ្នាំ ២០១៨ សម្រេចបាន ទឹកប្រាក់ ៧.៤០០ លាន ដុល្លារ អាមេរិក នៅក្នុង នោះ ការនាំចេញ របស់ កម្ពុជា ទៅ ចិន មាន ទំហំ ទឹកប្រាក់ ១. ៣៧៧ លាន ដុល្លារ អាមេរិក កើនឡើង ៣៧% និង នាំចូល មាន ទំហំ ទឹកប្រាក់ ៦.០០០ លាន ដុល្លារ អាមេរិក គឺ បាន កើនឡើង ២៦% ។ ប្រទេស ទាំង ពីរ បាន ដាក់ចេញ នូវ គោលដៅ ថ្មី ទៀត គឺ ជំរុញ ទំហំ ពាណិជ្ជកម្ម ទ្វេ ភាគី ឲ្យ ឈានដល់ ១០ប៊ីលាន ដុល្លា អាមេរិក នៅ ឆ្នាំ ២០២៣ ៕
អាជ្ញាធរ ចុះ រុះរើ ផ្ទះ ចំនួន ១៣ខ្នង ដែល សង់ រំលោភ លើ ដី ប្រឡាយ នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ កម្លាំង អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ រួម ជាមួយ កម្លាំង អាជ្ញាធរ សង្កាត់ កាកាប ទី២ ដឹកនាំ ដោយ លោក អភិបាល រង ខណ្ឌ ប៉ាង លីដា និង លោក ចៅសង្កាត់ កាកាប ទី២ លោក ម៉ាលី ពិសិដ្ឋ បាន នាំយក គ្រឿងចក្រ ចុះ ទៅ ធ្វើ ការរុះរើ ផ្ទះ របស់ ប្រជាពលរដ្ឋ ចំនួន ១៣គ្រួសារ ដែល បាន នាំគ្នា ទៅ សង់ រំលោភ យក ដី ប្រឡាយ មួយ កន្លែង ។
មុននឹង ឈានដល់ ការចុះ រុះរើ បែប នេះ អាជ្ញាធរ បាន ទប់ស្កាត់ តាំងពី ពេល ដែល បងប្អូន ប្រជាពលរដ្ឋ ទាំងនោះ រៀបចំ សាងសង់ មក ម្ល៉េះ តែ ពួកគាត់ មិន ស្ដាប់ នៅតែ សង់ ទាំង បំពាន រហូត អ្នក ខ្លះ សង់ រួច និង ខ្លះ ជិត រួចទៅហើយ ។
ទីតាំង ប្រឡាយ ដែល ទទួលរង ការសង់ ផ្ទះ រំលោភបំពាន នោះ មាន ទីតាំង ស្ថិត នៅក្នុង ភូមិ ព្រៃ សាលា សង្កាត់ កាកាប ទី២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ត្រូវបាន អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ នាំយក គ្រឿងចក្រ ចុះ ទៅ ធ្វើ ការរុះរើ ចេញ វេលា ព្រឹក ថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
លោក ចៅសង្កាត់ រូប នេះ បាន បន្ត ទៀត ថា ប៉ុន្តែ ទោះជា ខំ រារាំង យ៉ាងណា ក៏ ពួកគាត់ មិន ស្ដាប់ ដែរ នៅតែ នាំគ្នា ធ្វើ ការសាងសង់ ផ្ទះ ឈើ ប្រក់ ស័ង្កសី ព្រមទាំង បាំង ជញ្ជាំង ស័ង្កសី របៀប ជា ផ្ទះ អនាធិបតេយ្យ ហើ យោយសារតែ មិន អាច ឃាត់ ឈ្នះ លោក បាន រាយការណ៍ ជូន សាលា ខណ្ឌ ដើម្បី សុំ គោលការណ៍ ។
រហូតមកដល់ វេលា ព្រឹក ថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ ទើប អាជ្ញាធរ ខណ្ឌ ពោធិ៍សែនជ័យ និង សង្កាត់ កាប កាប ទី២ ដឹកនាំ ដោយ លោក អភិបាល រង ខណ្ឌ ប៉ាង លីដា និង រូបលោក ផ្ទាល់ ដាក់ គ្រឿងចក្រ ចុះ ទៅ ធ្វើ ការរុះរើ ចេញ វិញ ដោយ មិន ទទួលខុសត្រូវ លើ ការខូចខាត អ្វី ទាំងអស់ ដើម្បី រំដោះ យក ប្រឡាយ មេ មកវិញ ទុក សម្រាប់ រំដោះ ទឹក មិន ឲ្យ មាន ការលិចលង់ ផ្ទះសម្បែង ប្រជាពលរដ្ឋ រាប់ រយ ខ្នង នា រដូវ វស្សា ៕ អបអរសាទរ ! រដ្ឋបាល ខេត្ត កំពត ដង្ហែ ពាន ជ័យលាភី ទីក្រុង ទេសចរណ៍ ស្អាត អាស៊ាន លើក ទី២
( កំពត) ៖ រដ្ឋបាល ខេត្ត កំពត នៅ ថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ បាន ដង្ហែ ក្បួន បង្ហាញ ជាសាធារណៈ ពានរង្វាន់ ជ័យលាភី ទីក្រុង ទេសចរណ៍ ស្អាត អាស៊ាន លើក ទី២ ដែល រដ្ឋបាល ខេត្ត កំពត ទទួលបាន កាលពី ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២០ កន្លងទៅ នេះ នៅ រដ្ឋធានី បង់ដា សេរី បេហ្គាវ៉ាន់ ប្រទេស ប្រុយណេដារ៉ូសាឡឹម ។ ការធ្វើ ក្បួន ដង្ហែ ពានរង្វាន់ ជ័យលាភី ទីក្រុង ស្អាត អាស៊ាន ទី២នេះ បាន ដង្ហែ តាម ដងផ្លូវ ទី សាធារណៈ ក្នុង ក្រុង កំពត ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម ការដឹកនាំ ពី លោក ជឹង ផល្លា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក ជា វ តាយ អភិបាល ខេត្ត កំពត ព្រមទាំង លោក - លោកស្រី ថ្នាក់ដឹកនាំ ខេត្ត មន្ទីរ អង្គភាព កងកម្លាំងប្រដាប់អាវុធ លោកគ្រូ - អ្នកគ្រូ សិស្សានុសិស្ស និស្សិត ប្រជាពលរដ្ឋ យ៉ាង ច្រើន កុះករ ។
ក្នុង ឱកាស នោះ លោក លាង រឿន សុធី អភិបាល ក្រុង កំពត បាន លើក បញ្ជាក់ ថា រដ្ឋបាល ក្រុង កំពត ទទួលបាន ជ័យលាភី ជាបន្តបន្តាប់ ក្នុង នោះ មាន ការ ប្រឡង ប្រណាំង ទីក្រុង ស្អាត ថ្នាក់ ជាតិ លើក ទី១ ឆ្នាំ ( ២០១៥ - ២០១៨ ) ដោយ ទទួលបាន ជ័យលាភី រំដួល បី ទង ។
ក្នុង ចំណោម ក្រុង ខណ្ឌ ទាំង៦ មាន ក្រុង ខណ្ឌ ចំនួន ៣ ដែល ទទួលបាន រង្វាន់ ជ័យលាភី ទីក្រុង ទេសចរណ៍ ស្អាត អាស៊ាន ដែល មាន សុពលភាព ពី ( ឆ្នាំ ២០២០ - ២០២២ ) នៅ រដ្ឋធានី បង់ ដាស៊េរី បេហ្គាវ៉ាន់ ប្រទេស ព្រុយណេដារ៉ូសាឡឹម កាលពី ថ្ងៃទី ១៦ ខែមករា ឆ្នាំ ២០២០ ក្នុង នោះ ក្រុង កំពត ក៏ ទទួលបាន រង្វាន់ ជ័យលាភី ទីក្រុង ទេសចរណ៍ ស្អាត អាស៊ាន លើក ទី២ ។
( ភ្នំពេញ ) ៖ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស៊្រាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ អម ដំណើរ ដោយ មេបញ្ជាការ រង នាយ នាយ រង អាវុធហត្ថ រាជធានី ភ្នំពេញ ជាច្រើន រូប នៅ រសៀល ថ្ងៃទី ៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ បាន ចុះ សួរសុខទុក្ខ មន្ត្រី អាវុធហត្ថ ០១ រូប ដែល កំពុង ចូល សម្រាក ព្យាបាល ជម្ងឺ នៅ មន្ទីរពេទ្យ កាល់ម៉ែត គឺ លោក ឧត្តមសេនីយ៍ ត្រី លី សាត់ សាយ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ប្រកបដោយ ការឈឺឆ្អាល និង យកចិត្តទុកដាក់ បំផុត ។
ក្នុង ឱកាស សួរសុខទុក្ខ នោះ ផងដែរ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ក៏ នាំយក ថវិកា ទឹក សុទ្ធ ភេសជ្ជ: ចម្រុះ និង ផ្លែ ឈើ ស្រស់ ជូន ដល់ អ្នក ជម្ងឺ ជា អំណោយ សួរសុខទុក្ខ ផងដែរ ៕
សមាគម ទីភ្នាក់ងារ ទេសចរណ៍ កម្ពុជា៖ ក្នុង ពេល ផ្ទុះ វីរុស កូរ៉ូណា នេះ ភ្ញៀវ អន្តរជាតិ លុបចោល ដំណើរកម្សាន្ត មក កម្ពុជា រាល់ ថ្ងៃ
នៅក្នុង សិក្ខាសាលា អប់រំ និង ណែនាំ ពី វិធានការ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ រលាក សួត (2019-nCoV) ដល់ ប្រតិបត្តិករ ទេសចរណ៍ នា ថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅ វិទ្យាស្ថាន ជាតិ អប់រំ លោកស្រី ឆាយ ស៊ីវលីន បាន ស្នើ មាន កិច្ចសហការ ពី ក្រសួង ទេសចរណ៍ ដើម្បី ជួយ គ្នា ក្នុង ការផ្សព្វផ្សាយ ពី ផលិតផល ទេសចរណ៍ របស់ កម្ពុជា ឱ្យ បាន កាន់តែ ច្រើន ។
លោកស្រី ក៏ បាន ស្នើ ដល់ មូលដ្ឋាន អាជីវកម្ម ទេសចរណ៍ សណ្ឋាគារ ភោជនីយដ្ឋាន ហាង លក់ វត្ថុអនុស្សាវរីយ៍ នានា សូម មាន ការបញ្ចុះ តម្លៃ ផលិតផល របស់ ខ្លួន ដើម្បីឱ្យ សមាគម CATA ជួយ ផ្សព្វផ្សាយ រឿង នេះ ទៅដល់ ភ្ញៀវ ទេសចរ ធ្វើ យ៉ាងណា ឱ្យ ពួកគេ ចាប់អារម្មណ៍ និង មក ទស្សនា កម្ពុជា ឡើងវិញ ។
លោកស្រី ឆាយ ស៊ីវលីន ក៏ បាន លើកឡើង ពី សំណើ សុំ ការបន្ធូរបន្ថយ ការប្រើប្រាស់ ថាមពល អគ្គិសនី ទឹក និង សេវា ផ្សេង ទៀត ពី ភាគី រដ្ឋ ផងដែរ ពិសេស គឺ ការសម្រួល មធ្យោបាយ ក្នុង ការផ្ដល់ អាជ្ញា បណ្ណ អាជីវកម្ម ក៏ ដូចជា ការបន្ត អាជ្ញា បណ្ណ អាជីវកម្ម ជាដើម ។
នា ឱកាស នោះ លោក ប៉ាក់ សុខុម រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ បាន ឱ្យដឹង ថា ក្នុង ដំណាក់កាល តានតឹង នេះ គ្រប់ ក្រុមហ៊ុន ទីភ្នាក់ងារ ទេសចរណ៍ ប្រតិបត្តិករ ទេសចរណ៍ ក៏ ដូចជា អាជ្ញាធរ តាម មូលដ្ឋាន រមណីយដ្ឋាន ទេសចរណ៍ នានា ត្រូវ រួមគ្នា បង្កើត ព្រឹត្តិការណ៍ ទេសចរណ៍ ឱ្យ បាន ច្រើន ដើម្បី ទាក់ទាញ ការមក ទស្សនា របស់ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ។
ត្រង់ ចំណុច នេះ លោក បាន បញ្ជាក់ ថា « កាលណា បើ យើង នាំគ្នា នៅ ស្ងៀមស្ងាត់ វា ទៅជា បង្ក ការភ័យខ្លាច ទៅ វិញ ដូច្នេះ យើង ត្រូវ នាំគ្នា ធ្វើ សកម្មភាព បង្កើត ព្រឹត្តិការណ៍ កម្សាន្ត ឱ្យ ច្រើន ដើម្បី ដេញ ការភ័យខ្លាច និង នាំមក នូវ សកម្មភាព ទេសចរណ៍ ឡើងវិញ » ។
លោក រដ្ឋលេខាធិការ ក៏ បាន ផ្សព្វផ្សាយ ពី ការត្រៀម រៀបចំ កម្មវិធី ធំ មួយ នៅ រាជធានី ភ្នំពេញ ដោយ ក្រសួង ទេសចរណ៍ បាន សហការ ជាមួយ ស្ថានទូត សិង្ហបុរី ប្រចាំ កម្ពុជា នឹង រៀបចំ ព្រឹត្តិការណ៍ ទេសចរណ៍ មួយ ដោយ ភ្ជាប់ ទៅនឹង ម្ហូប អាហារ ដ៏ ធំ មួយ ចាប់ពី ថ្ងៃទី ១៥ - ២៩ ខែកុម្ភៈ ឆ្នាំ ២០២០២ ខាងមុខ ។ ដូច្នេះ លោក បាន អំពាវនាវ សូម ឱ្យ គ្រប់ ផ្នែក ទាំងអស់ ក្នុង វិស័យ ទេសចរណ៍ ចូលរួម ឱ្យ បាន ច្រើន កុះករ ។
ដោយ មិន បាន បញ្ជាក់ ពី ឈ្មោះ ក្រុមហ៊ុន ខាងលើ អង្គការ WHO បាន បញ្ជាក់ ទៀត ថា អ្នកចូលរួម ក្នុង កិច្ចប្រជុំ នៅឯ សណ្ឋាគារ Grand Hyatt ពី ថ្ងៃទី ២០ ដល់ ថ្ងៃទី ២២ ខែមករា កន្លងទៅ មាន ១៥នាក់ ជា ពលរដ្ឋ សិង្ហបុរី និង ៩៤ នាក់ មកពី បរទេស ។ ពលរដ្ឋ សិង្ហបុរី ៤នាក់ ក្នុង ចំណោម ១៥នាក់ ត្រូវបាន គេ រាយការណ៍ ថា បាន បង្ហាញ រោគសញ្ញា គួរឱ្យ សង្ស័យ និង កំពុង ស្ថិត នៅក្រោម ការត្រួតពិនិត្យ សុខភាព ខណៈ ១១នាក់ ផ្សេង ទៀត មាន សុខភាពល្អ ប្រសើរ ។
( ភ្នំពេញ ) ៖ ខាងក្រោម គឺជា សំណុំ រូបភាព មួយចំនួន ដែល បង្ហាញ ពី ព្រឹត្តិការណ៍ នយោបាយ អន្តរជាតិ និង ស្ថានការណ៍ ជុំវិញ ពិភពលោក រួម ជាមួយ រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ព្រមទាំង ទិដ្ឋភាព នៅ តំបន់ ផ្សេង ៗ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃព្រហស្បតិ៍ ទី០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ៖
១៖ យន្តហោះ តួកគីរ អិល ចេញ ពី ផ្លូវ និង ដាច់ ចេញ ជា បី កំណាត់ បណ្តាលឲ្យ មនុស្ស ៣នាក់ ស្លាប់ និង ១៧៩ នាក់ រងរបួស ។
២៖ ព្រឹទ្ធសភា អាមេរិក សម្រេចចិត្ត បោះឆ្នោត មិន ដក តំណែង លោក ដូណាល់ ត្រាំ ។
៣៖ អ្នកជំងឺ ឆ្លង វីរុស កូរ៉ូណា ថ្មី សរុប ១. ១៥៣ នាក់ ជាសះស្បើយ និង ចាកចេញ ពី មន្ទីរពេទ្យ ។
៥៖ វត្ត មួយ នៅ ទីក្រុង បាងកក ច្នៃ សំរាម ប្លាស្ទិច ទៅជា ស្បង់ ចីពរ ព្រះសង្ឃ និង ដាក់ លក់ ដើម្បី យក ថវិកា ជួយ សង្គម ។
៦៖ ស្រ្តី អវកាសយានិក អាមេរិក ម្នាក់ ត្រឡប់ ចុះ មក កាន់ ផែនដី វិញ ក្រោយ ស្នាក់ នៅលើ ស្ថានីយ អវកាស អន្តរជាតិ ជិត ១ឆ្នាំ ។
៧៖ រថភ្លើង ល្បឿន លឿន រអិល ធ្លាក់ ផ្លូវ នៅ អ៉ីតាលី បង្កឲ្យ មនុស្ស ២នាក់ ស្លាប់ និង ២៧ នាក់ របួស ។ សណ្ឋាគារ ហា យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ អភិរក្ស វីឡា សម័យ អាណានិគម បារាំង ចំ កណ្តាល សណ្ឋាគារ
( ភ្នំពេញ ) ៖ សណ្ឋាគារ ហា យ៉ាត់ រី ជិស៊ី ភ្នំពេញ លំដាប់ ផ្កាយ ប្រាំ ដែល នឹង ដាក់ ឱ្យ ដំណើរការ នៅ ត្រីមាស ទី៣ បាន ចូលរួមចំណែក យ៉ាង សំខាន់ មួយ ក្នុង ការអភិរក្ស សំណង់ អគារ បេតិកភណ្ឌ សម័យ អាណានិគម បារាំង ។
សណ្ឋាគារ ហា យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ ដែល ស្ថិត នៅ ចំ កណ្តាល សង្កាត់ ពាណិជ្ជកម្ម វប្បធម៌ និង ប្រវត្តិសាស្ត្រ នៃ ខណ្ឌ ដូនពេញ បាន អភិរក្ស វីឡា សម័យ អាណានិគម បារាំង នៅ ចំ កណ្តាល សណ្ឋាគារ ដែល វីឡា នេះ ត្រូវបាន កែលម្អ ឡើងវិញ ដើម្បី រក្សា នូវ ភាពរឹងមាំ របស់ សំណង់ ប៉ុន្តែ រក្សា ទម្រង់ និង រចនាបថ ដើម ទាំងស្រុង ។
ការអភិរក្ស វីឡា សម័យ អាណានិគម បារាំង នៅ ចំ កណ្តាល សណ្ឋាគារ នេះ មាន គោលបំណង រក្សា ប្រវត្តិ នៃ ការវិវឌ្ឍ របស់ សំណង់ ស្ថាបត្យកម្ម របស់ កម្ពុជា ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ លើកកម្ពស់ តម្លៃ ស្ថាបត្យកម្ម កម្ពុជា និង ចូលរួមចំណែក អភិរក្ស សំណង់ នា សម័យ អាណានិគម បារាំង ។
មួយវិញទៀត ការអភិរក្ស អគារ សម័យ អាណានិគម បារាំង របស់ សណ្ឋាគារ ហា យ៉ាត់ រី ជិន ស៊ី ភ្នំពេញ គឺជា ផ្នែក មួយ នៃ រក្សា អត្តសញ្ញាណ របស់ តំបន់ នេះ ផងដែរ ដោយសារ អគារ សណ្ឋាគារ បាន ផុសត្រ ដែត ឡើង នៅក្នុង តំបន់ ពាណិជ្ជកម្ម សារមន្ទីរ ជាតិ ព្រះបរម រាជ វាំង សាកលវិទ្យាល័យ ភូមិន្ទ វិចត្រ សិល្បៈ វត្ត អារាម និង ទន្លេ ចតុមុខ ដែល មាន ប្រវត្តិសាស្ត្រ និង វប្បធម៌ ដ៏ សម្បូរបែប ។
វីឡា នេះ ត្រូវបាន គេ ជឿ ថា សាងសង់ ក្នុង អំឡុង ទសវត្សរ៍ ឆ្នាំ ១៩០០ ដែល អាច ជា កម្មសិទ្ធិ ខ្សែ រាជ្យ វង្ស ឬ មន្ត្រីរាជការ ជាន់ ខ្ពស់ ដែល បម្រើ ការងារ ក្នុង ព្រះបរម រាជ វាំង ពីព្រោះ នៅ សម័យ នោះ មាន តែ ខ្សែ រាជ្យ វង្ស ឬ មន្ត្រីរាជការ ជាន់ ខ្ពស់ ទេ ដែល រស់ នៅក្នុង តំបន់ បរិវេណ នោះ ៕
ក្រសួង បរិស្ថាន រៀបចំ ពិធី អបអរសាទរ ទិវា តំបន់ ដី សើម នៅ ខេត្ត បន្ទាយមានជ័យ ដើម្បី ផ្សព្វផ្សាយ ពី សារៈប្រយោជន៍ មហាសាល របស់ តំបន់ សម្រាប់ មនុស្ស - សត្វ
ទិវា តំបន់ ដី សើម ពិភពលោក ឆ្នាំ នេះ ប្រព្រឹត្តទៅ ក្រោម ប្រធានបទ « តំបន់ ដី សើម និង ជីវៈ ចម្រុះ » ដែល បង្ហាញ ដល់ សាធារណជន ពី ទំនាក់ទំនង និង ភាពសម្បូរបែប នៃ ជីវៈ ចម្រុះ នៅ តាម តំបន់ ដី សើម ហើយ ទាំង នេះ ជាមុខងារ មួយ នៃ សេវាកម្ម ប្រព័ន្ធ អេកូឡូស៊ី តំបន់ ដី សើម ។
លោក កែន សេរី រដ្ឋា ប្រធាន អង្គការ សមាគម អភិរក្ស សត្វ ព្រៃ ប្រចាំ កម្ពុជា បាន ន បញ្ជាក់ ថា ពិភពលោក បាន បាត់បង់ ដី សើម អស់ ១ភាគ ៣ នៃ តំបន់ ដី សើម ទាំងអស់ តាំងពី ឆ្នាំ ១៩៧០មក ម្ល៉េះ ។ ហើយ មនុស្ស ជាង ១ ពាន់ លាន នាក់ នឹង ជួប បញ្ហា ខ្វះ ទឹក និង ចំណីអាហារ ។ ហើយ ៤០ ភាគរយ នៃ សត្វ ព្រៃ គ្រប់ ប្រភេទ ត្រូវ រងគ្រោះ ។ លោក បាន បញ្ជាក់ ថា តំបន់ ការពារ ទេសភាព អាង ត្រពាំង ថ្ម កំពុង ត្រូវបាន អភិរក្ស ហើយ ក្លាយជា តំបន់ ទេសសចរណ៍ ផ្នែក ស្រាវជ្រាវ និង ផ្នែក ទស្សនា សត្វ ស្លាប យ៉ាង សំខាន់ នា ពេល បច្ចុប្បន្ន ។
លោក បាន មានប្រសាសន៍ ថា តាមរយៈ ការចូល អភិរក្ស សត្វ ស្លាប កន្លងមក គឹទទួលបាន ជោគជ័យ ក្នុង នេះ គេ ឃើញ សត្វ ស្លាប បាន កើន ចំនួន ជា បន្តបន្ទាប់ ។ ទន្ទឹម ជាមួយគ្នា ក៏ មាន បញ្ហា ប្រឈម មួយ ចំនួន ដែរ ក្នុង នេះ ដូចជា ការប្រឈម ទៅនឹង ទី ជម្រក សត្វ ស្លាប ដោយសារតែ ការរីកចម្រើន ក្នុង តំបន់ នេះ ដែល ធ្វើឱ្យ ពលរដ្ឋ កាប់ ស្ការ ព្រៃ ការសង់ លំនៅដ្ឋាន និង ការធ្វើដំណាំ កសិកម្ម ដែល ប្រើ សារជាតិ គីមី ជាដើម ។
ដោយឡែក លោក អោម ចន្ថា អភិបាល រង ខេត្ត បន្ទាយមានជ័យ មានប្រសាសន៍ ថា នៅក្នុង ខេត្ត បន្ទាយមានជ័យ មាន តំបន់ ទេសចរណ៍ ធម្មជាតិ និង តំបន់ ដី សើម ជាច្រើន កន្លែង ។ ឯកឧត្តម បាន ឱ្យដឹង បន្ថែម ថា ការចូលរួម ការពារ និង អភិរក្ស ធនធាន ធម្មជាតិ ឱ្យ គង់វង្ស សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ក៏ ដូចជា ការអភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ ទៅ ថ្ងៃ ខាងមុខ ។
ក្នុង ឱកាស នោះ លោក ស្រ៊ុន ដារិទ្ធ មានប្រសាសន៍ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ តំបន់ ដី សើម ៥កន្លែង ទៅជា តំបន់ ដី សើម ដែល មាន សារៈសំខាន់ ជា អន្តរជាតិ ដែល មាន ឈ្មោះ ថា តំបន់ រ៉ាម សារ គឺ តំបន់ រ៉ាម សារ ស្ទឹងត្រែង នៅ ខេត្ត ស្តឹង ត្រែង តំបន់ រ៉ាម សារ កោះ កាពិ នៅ ខេត្ត កោះកុង និង តំបន់ រ៉ាម សារ បឹង ឆ្មារ ព្រែក ទាល់ និង ស្ទឹង សែន ស្ថិត ក្នុង ប្រព័ន្ធ អេកូឡូស៊ី តំបន់ បឹង ទន្លេ សាប ។
លើស នេះ ទៀត ប្រទេស កម្ពុជា យើង ក៏ បាន កំណត់ តំបន់ ដី សើម សំខាន់ ៗ មួយចំនួន ទៅជា តំបន់ ការពារ ធម្មជាតិ ដែល ក្នុង នោះ មាន តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង ចំនួន ៥កន្លែង គឺ តំបន់ ប្រើប្រាស់ ច្រើន យ៉ាង បឹង ទន្លេ សាប ដង ពែង ពញា ក្រែក ព្រែក ទឹក សាប ក្បាល ឆាយ និង បឹង យក្ខឡោម និង តំបន់ ការពារ ទេសភាព ចំនួន ៦កន្លែង ទៀត គឺ តំបន់ ការពារ ទេសភាព ទំនាប ខាងជើង ទន្លេ សាប អន្លង់ ព្រីង អាង ត្រពាំង ថ្ម បឹង ព្រែក ទប់ បឹង លំកុដ និង តំបន់ ការពារ ទេសភាព បឹង ព្រែក ល្ពៅ ។
គួរ បញ្ជាក់ ថា ទិវា តំបន់ ដី សើម ពិភពលោក ត្រូវបាន គេ ប្រារព្ធ ឡើង ជារៀងរាល់ ឆ្នាំ នៅ ថ្ងៃទី ២ខែកុម្ភៈ ដើម្បី អបអរ ការអនុម័ត អនុសញ្ញា ស្តីពី តំបន់ ដី សើម ( អនុសញ្ញា រ៉ាម សារ ) នៅ ថ្ងៃទី២ ខែកុម្ភៈ ឆ្នាំ ១៩៧១ ។ សម្រាប់ កម្ពុជា ជា ប្រទេស ចុះ ហត្ថលេខី មួយ ក្នុង ចំណោម ប្រទេស ១៧១ លើ ពិភពលោក ដែល មាន កាតព្វកិច្ច គ្រប់គ្រង អភិរក្ស និង ការពារ តំបន់ ដី សើម ដែល មាន និង មាន សារសំខាន់ ជា អន្តរជាតិ ៕ ក្រសួង បរិស្ថាន ចេញ ប្រកាស ស្តីពី ចំណាត់ថ្នាក់ នៃ ការវាយតម្លៃ ហេតុ ប៉ះពាល់ បរិស្ថាន សម្រាប់ គម្រោង អភិវឌ្ឍន៍
ក្រសួង បរិស្ថាន បាន ឲ្យដឹង ថា ប្រកាស ថ្មី នេះ មាន គោលបំណង ជួយ សម្រួល និង ផ្តល់ ការណែនាំ ដល់ ម្ចាស់ គម្រោង អភិវឌ្ឍន៍ ឯកជន និង សាធារណៈ ក្នុង ការអនុវត្តន៍ នីតិវិធី នៃ ការវាយតម្លៃ ហេតុ ប៉ះពាល់ បរិស្ថាន សម្រាប់ គម្រោង អភិវឌ្ឍន៍ ឲ្យ មាន ប្រសិទ្ធភាព នៅក្នុង ប្រទេស កម្ពុជា ៕
សូម អាន ប្រកាស របស់ ក្រសួង បរិស្ថាន ទាំង ស្រុង៖
( បាងកក )៖ វត្ត មួយ កន្លែង នៅ ភាគ ខាងត្បូង ទីក្រុង បាងកក ត្រូវបាន គេ ចាត់ទុក ជា « ម៉ាស៊ីន កម្ទេច ប្លាស្ទិច » ដោយ ព្រះសង្ឃ ទាំងឡាយ ដែល គង់ នៅ វត្ត នោះ បាន យក សំរាម ផ្លាសិ្ទច ទៅ ឱ្យ គេ កែច្នៃ ធ្វើជា ស្បង់ ជីវ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
មហា ព្រឹត្តិការណ៍ ពិព័រណ៌ លំនៅឋាន និង ជីវិត ទាន់សម័យ ដ៏ ធំ របស់ កម្ពុជា ឆ្នាំ ២០២០ ជិត មកដល់ ហើយ
ពិព័រណ៍ លំនៅដ្ឋាន និង ជីវិត ទាន់សម័យ កម្ពុជា ឆ្នាំ ២០២០ នឹង ក្លាយជា ព្រឹត្តិការណ៍ ដ៏ ធំ និង ជោគជ័យ បំផុត របស់ ប្រទេស ម្តង ទៀត ជាមួយនឹង ការលក់ ចេញ នូវ អចលន ទ្រព្យ ដែល មាន តម្លៃ រាប់ លាន ដុល្លារ ក្នុង រយៈពេល ត្រឹមតែ ពីរ ថ្ងៃ ប៉ុណ្ណោះ ។
ស្តង់ មាន កំណត់ ដូច្នេះ សូម ទូរស័ព្ទ មក ឥឡូវនេះ តាមរយៈ លេខ៖ ០៩២ ៩២ ១០០០ ដើម្បី ធ្វើ ការកក់ ស្ដង់ របស់ អ្នក និង ចូលរួម តាំង បង្ហាញ ផលិតផល និង សេវាកម្ម របស់ អ្នក នៅក្នុង ព្រឹត្តិការណ៍ ពិព័រណ៍ ដ៏ ធំ បំផុត របស់ កម្ពុជា ។
មកទល់ ពេល បច្ចុប្បន្ន នេះ ពិព័រណ៍ លំនៅឋាន និង ជីវិត ទាន់សម័យ កម្ពុជា ឆ្នាំ ២០១៩ នៅតែ គ្រោង តំណែង ជា ព្រឹត្តិការណ៍ ពិព័រណ៍ ដែល ធំ ជាង គេ បំផុត មាន អ្នកចូលរួម ច្រើន រហូតដល់ ជាង ២ម៉ឺន នាក់ និង លក់ អចលន ទ្រព្យ បាន ច្រើន ជាង គេ បំផុត គិត ជា ទឹកប្រាក់ ច្រើន ជាង ៣០លាន ដុល្លារ ក្នុង រយៈពេល ត្រឹម២ ថ្ងៃ ប៉ុណ្ណោះ ។
ការចូលរួម ក្នុង ពិព័រណ៍ លំនៅឋាន និង ជីវិត ទាន់សម័យ កម្ពុជា ឆ្នាំ ២០២០ មាន ន័យ ថា អ្នក នឹង ចូលរួម តាំង បង្ហាញ គម្រោង របស់ អ្នក ជាមួយ ក្រុម ធំ ៗ ច្រើន ជាង ១០០ ដែល នឹង ធ្វើ ការបង្ហាញ គម្រោង របស់ ពួកគេ ពី គ្រប់ ទិសទី ក្នុង ប្រទេស កម្ពុជា មាន ដូចជា បុរី ខុនដូ អាផាតមិន វីឡា ទំនើប និង គម្រោង ចម្រុះ ជាច្រើន ផ្សេង ទៀត ។
ពិព័រណ៍ លំនៅឋាន និង ជីវិត ទាន់សម័យ កម្ពុជា ឆ្នាំ ២០២០ នឹង ប្រារព្ធ ធ្វើ តែ ២ ថ្ងៃ ប៉ុណ្ណោះ គឺ នៅ ថ្ងៃទី ២៤ និង ២៥ ខែមេសា ឆ្នាំ ២០២០ នៅ សាល ពិព័រណ៍ កោះ ពេជ្រ ដែល ជា កន្លែង តាំងពិព័រណ៍ លំដាប់ ពិភពលោក និង ធំ ជាង គេ បង្អស់ នៅ រាជធានី ភ្នំពេញ ។
សាល ពិព័រណ៍ កោះ ពេជ្រ មិន ត្រឹមតែ ជា កន្លែង ដ៏ ល្អ ឥត ខ្ចោះ សម្រាប់ ព្រឹត្តិការណ៍ ដ៏ ធំ បែប នេះ ប៉ុណ្ណោះ ទេ ប៉ុន្តែ វា ក៏ ជា កន្លែង ដែល ប្រជាជន ក្នុង ស្រុក និង ជន បរទេស ដែល រស់ នៅក្នុង រាជធានី ភ្នំពេញ និយម ចូលចិត្ត ទៅ ។
ដោយ មាន ការតាំង បង្ហាញ នូវ គម្រោង ថ្មី ៗ រាប់ រយ គម្រោង មកពី គ្រប់ ទិសទី នៃ ប្រទេស កម្ពុជា ពិព័រណ៍ លំនៅដ្ឋាន និង ជីវិត ទាន់សម័យ កម្ពុជា ឆ្នាំ ២០២០ នឹង ទាក់ទាញ អ្នក ស្វែងរក អចលន ទ្រព្យ គ្រប់ ប្រភេទ ដែល ភាគ ច្រើន ជា ជនជាតិ ខ្មែរ មាន ដូច ជា៖
អ្នក ដែល មាន បំណង ចង់ ទិញ ផ្ទះ ដំបូង គ្រួសារ ដែល មាន ជីវភាព មធ្យម និង អ្នកមាន ទ្រព្យ ច្រើន ។ ពិព័រណ៍ នេះ ក៏ នឹង ទាក់ទាញ អ្នក វិនិយោគ មក ពី គ្រប់ ទីកន្លែង រួមទាំង អ្នក ក្នុង តំបន់ មក ចូលរួម ផងដែរ មាន ដូច ជា៖ វិនិយោគិន ចិន ហុងកុង សឹង្ហបុរី តៃវ៉ាន់ ម៉ាឡេស៊ី ថៃ ជប៉ុន និង កូរ៉េ ។
ការដើរ ទិញ ទំនិញ មាន ការបញ្ចុះ តម្លៃ ច្រើន សន្ធឹកសន្ធាប់ និង ការដើរកំសាន្ដ ជុំ គ្រួសារ ក្រៅពី វិស័យ អចលន ទ្រព្យ ក៏ មាន ការតាំង បង្ហាញ ពី វិស័យ ផ្សេង ៗ ជាច្រើន ទៀត ដូច ជា៖ ធនាគារ មីក្រូ ហិរញ្ញវត្ថុ យានយន្ត ទូរស័ព្ទ គ្រឿង សង្ហារិម សម្ភារ ផ្ទះបាយ គ្រឿងអលង្ការ និង សម្លៀកបំពាក់ ។
អ្វី ដែល កាន់តែ ពិសេស អ្នកចូលរួម ក្នុង ព័រណ៍ លំនៅដ្ឋាន និង ជីវិត ទាន់សម័យ កម្ពុជា ឆ្នាំ ២០២០ ក៏ នឹង មាន ឱកាស ពិភាក្សា គ្នា ជាមួយ អ្នកតំណាង មកពី ធនាគារ និង មីក្រូ ហិរញ្ញវត្ថុ ឈាន មុខ គេ នៅក្នុង ប្រទេស កម្ពុជា ដើម្បី ស្វែងយល់ បន្ថែម អំពី តម្រូវការ ឬ នីតិវិធី ក្នុង ការស្នើសុំ កម្ចី សម្រាប់ ទិញ ផ្ទះ ឬ យានយន្ដ ។
ខណៈពេលនេះ មាន ក្រុមហ៊ុន អភិវឌ្ឍន៍ គម្រោង អចលន ទ្រព្យ ធំ ៗ ជាច្រើន នៅក្នុង ប្រទេស កម្ពុជា ក៏ ដូចជា ធនាគារ ស្ថាប័ន មីក្រូ ហិរញ្ញវត្ថុ ភ្នាក់ងារ អចលន ទ្រព្យ និង ក្រុមហ៊ុន ស្ថាបត្យកម្ម មួយ ចំនួន បាន កក់ កន្លែង របស់ ពួកគេ រួចរាល់ ហើយ សម្រាប់ ពិព័រណ៍ លំនៅឋាន មាន ក្រុមហ៊ុន៖
សម្រាប់ ព័ត៌មាន អំពី ការជាវ ស្ដង់ ពិព័រណ៍ និង ការចូលរួម ជា ម្ចាស់ ឧបត្ថម្ភ កម្មវិធី៖ សូម ទំនាក់ទំនង ទៅ កាន់៖
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « បច្ចុប្បន្ន អ្នកជំងឺ មាន សុខភាពល្អ ប្រសើរ ដូច ធម្មតា វិញ ហើយ រីឯ ការធ្វើតេស្ត លើ វត្ថុ វិភាគ របស់ អ្នកជំងឺ រូប នេះ ដោយ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា បាន បង្ហាញ លទ្ធផល អវិជ្ជមាន ចំនួន ២លើក គិត ត្រឹម ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ » ។
ក្រសួង បញ្ជាក់ ថា ថ្វីត្បិតតែ សុខភាព របស់ ជនជាតិ ចិន រូប នោះ មាន សភាព ល្អ ប្រសើរ និង ដើម្បីឲ្យ មាន ភាពច្បាស់លាស់ តាម ការពិភាក្សា ជាមួយ អង្គការ សុខភាព ពិភពលោក អ្នក មិន ទាន់ ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ នៅ ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ នៅឡើយ ទេ ដោយ ទុក តាមដាន បន្ថែម ទៀត រហូតដល់ ថ្ងៃអាទិត្យ ទី ០៩ ខែកុម្ភៈ ឆ្នាំ ២០២០ ដើម្បី រង់ចាំ ការធ្វើតេស្ត ជាថ្មី ម្តង ទៀត ទៅ តាម វិធាន វេជ្ជសាស្ត្រ ក្នុង ការបញ្ជាក់ នូវ ភាពសះស្បើយ ដោយ មិន មាន វីរុស កូរ៉ូណា ថ្មី ពិតប្រាកដ របស់ អ្នកជំងឺ ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ទៀត ថា នៅពេល វិភាគ ធ្វើតេស្ត បង្ហាញ លទ្ធផល អវិជ្ជមាន វីរុស កូរ៉ូណា ថ្មី នេះ ជា លើក ទី៣ នៅ ថ្ងៃទី ១0 ខែកុម្ភៈ ឆ្នាំ ២០២០ នោះ ក្រសួង នឹង រៀបចំ តាម លក្ខណៈ បច្ចេកទេស ឲ្យ អ្នកជំង ចេញ ពី មន្ទីរពេទ្យ តែម្តង ហើយ សមាជិក គ្រួសារ គាត់ បី នាក់ ទៀត ដែល មាន អវិជ្ជមាន វីរុស ក៏ នឹង បាន រួច ផុត ពី ការសង្កេតតាមដាន សុខភាព ចំនួន ១៤ ថ្ងៃ ស្រប ពេល ជាមួយគ្នា ទៅនឹង ការចាកចេញ ពី មន្ទីរពេទ្យ របស់ អ្នកជំងឺ ។
ជាថ្មី ម្ដង ទៀត យើងខ្ញុំ ទាំងអស់ គ្នា សូម បួងសួង ដល់ គុណ បុណ្យ ព្រះរតនត្រ័យ កែវ ទាំង បី វត្ថុ ស័ក្តិសិទ្ធិ ទាំងឡាយ ក្នុង លោក និង ទេវតា ឆ្នាំ ថ្មី សូម ព្រះអង្គ តាម ជួយ បីបាច់ ថែរក្សា អភិបាល ប្រោះ ព្រំ សព្ទ សាធុការ ពរ ជ័យ ជូន សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ និង លោកជំទាវ ព្រមទាំង បុត្រា បុត្រី និង ចៅ ៗ ទាំងអស់ សូម ជួប តែ នឹង ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀង ឃ្លាត ឡើយ ៕
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា៖ ខែ ដំបូង ឆ្នាំ នេះ កម្ពុជា នាំចេញ អង្ករ ជាង ៥ម៉ឺន តោន បាន ចំណូល ជិត ៤០ លាន ដុល្លារ
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បាន ឲ្យដឹង ថា ទឹកប្រាក់ ដែល ទទួល បាន ពី ការនាំចេញ អង្ករ នៅ ខែមករា មាន ប្រមាណ ៣៩ លាន ដុល្លារ អាមេរិក ។
សហព័ន្ធ ស្រូវ អង្ករ បាន គត់ សម្គាល់ ឃើញ ថា ចំពោះ ស្ថានភាព ជា រួម សហគមន៍ អឺរ៉ុប នៅតែ បន្ត ឈាន មុខ គេ សម្រាប់ ទីផ្សារ អង្ករ កម្ពុជា ដែល កាន់កាប់ ចំណែក ទីផ្សារ រហូតដល់ ៣៧ ភាគរយ ស្រប ពេល ដែល ប្រទេស ចិន ៣០ ភាគរយ អាស៊ាន ១១ភាគរយ និង បណ្តា ប្រទេស ផ្សេង ៗ ទៀត ២២ ភាគរយ ។
ចំពោះ ការនាំ អង្ករ ចេញ ទៅកាន់ ប្រទេស ចិន ក្នុង ខែមករា ឆ្នាំ ២០២០ នេះ ក៏ បាន ថយចុះ ផងដែរ ប្រមាណ ជា ២០% ឬ ៣ ៦៦៤តោន ។ បើ សង្កេត ជា រួម លើ មូលហេតុ នៃ ការថយចុះ នេះ គឺ បណ្តាល មកពី ការប្រារព្ធ ពិធី ចូល ឆ្នាំ ថ្មី ឆ្នាំ ចិន នៅ ប្រទេស ចិន ធ្វើឡើង នៅក្នុង មក រា ឆ្នាំ ២០២០ ដែល លឿន ជាង ការចូល ឆ្នាំ ចិន នៅ ឆ្នាំ ២០១៩ នា ដើម ខែកុម្ភៈ ។ ហេតុ នេះ ហើយ បានជា ការធ្វើ ការបញ្ជាទិញ និង ដំណើរការដឹកជញ្ជូន ត្រូវ ឈប់ សម្រាក ក្នុង រយៈពេល ជា មធ្យម ប្រមាណ ជា២ សប្តាហ៍ ។
ចំណែកឯ ទីផ្សារ អាស៊ាន វិញ ឃើញ ថា មាន ការប្រែប្រួល ខ្លះ អាស្រ័យ លើ ប្រទេស ជិតខាង ដូចជា ប្រទេស ថៃ និង វៀតណាម ។ ទន្ទឹម នឹង នោះ ទីផ្សារ ចម្បង របស់ កម្ពុជា គឺ ប្រទេស ម៉ាឡេស៊ី និង ព្រុយណេ ដែល មិន មាន ការប្រែប្រួល ខ្លាំង នោះ ទេ គឺ នៅ រក្សា បាន ស្ថានភាព ល្អ មាន លំនឹង នៅឡើយ ។ រីឯ ទីផ្សារ ផ្សេង ៗ ទៀត បាន កើនឡើង ប្រមាណ ៤០ % ក្នុង នោះ ប្រទេស កាប៉ុង នៅតែ បន្ត នាំមុខ ដដែល ស្រប ពេល ជាមួយគ្នា នោះ ប្រទស អូស្ត្រាលី បាន បង្កើន ល្បឿន នាំចូល អង្ករ ច្រើន ពី កម្ពុជា គួរឱ្យ កត់សម្គាល់ ផងដែរ ៕
ក្រសួង ទេសចរណ៍ និង ក្រសួង សុខាភិបាល រួមគ្នា បញ្ជ្រាប វិធានការ ការពារ វីរុស កូរ៉ូណា និង ដំណោះស្រាយ លើ វិស័យ ទេសចរណ៍ ដល់ ប្រតិបត្តិករ ទេសចរណ៍
វគ្គ បណ្ដុះបណ្ដាល នេះ ទទួលបាន កិច្ចសហការ ជាមួយ ក្រសួង សុខាភិបាល ដែល ត្រូវបាន រៀបចំឡើង ក្នុង គោលបំណង ផ្តល់ ចំណេះដឹង អំពី វិធានការ ទប់ស្កាត់ ពី វិធានការ ការពារ ខ្លួនប្រាណ ពី ការឆ្លង ជំងឺ និង ព័ត៌មាន ថ្មី ៗ នៃ ការរីករាលដាល នៃ ជំងឺ រលាក សួត ថ្មី នេះ ។
លោក ជួន ជ័យ សត្យា អគ្គ លេខាធិការ រង គ. ជ. វ. ទ និង ជា ប្រធាន នាយកដ្ឋាន ជម្រុញ ទេសចរណ៍ ក្នុង ស្រុក និង អប់រំ ការយល់ដឹង ជាសាធារណៈ បាន អាន សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង ទេសចរណ៍ លេខ ០០១ ចុះ ថ្ងៃទី ២៩ ខែមករា ឆ្នាំ ២០២០ ដែល មាន ខ្លឹមសារ អំពាវនាវ ដល់ សាធារណជន ជាពិសេស ប្រតិបត្តិករ ទេសចរណ៍ ត្រូវ ជ្រាប ថា មេត្តា អនុវត្ត យ៉ាង មុតមាំ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ដែល បាន ដាក់ចេញ នូវ សេចក្តី អប់រំ ណែនាំ និង បាន ចាត់ វិធានការ យ៉ាង ច្រើន ដើម្បី ទប់ ស្តាត់ ចំពោះ ការរីករាលដាល ជំងឺ ដ៏ កាច សាហាវ នេះ ។
បច្ចុប្បន្ន ប្រទេស កម្ពុជា ស្ថិត នៅក្នុង ស្ថានភាព ក្រោម ការគ្រប់គ្រង របស់ រាជ រដ្ឋាភិបាល ក្រសួង សុខាភិបាល បាន សហការ ជាមួយ សមត្ថកិច្ច ពាក់ព័ន្ធ បាន ខិតខំ បំពេញ ការងារ បាន យ៉ាង ល្អ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ។
ក្រសួង ទេសចរណ៍ បាន ជំរុញ ចលនា ទេសចរ ក្នុង ស្រុក និង ទេសចរ ផ្ទៃក្នុង ឱ្យ កាន់តែ ខ្លាំង ថែម ទៀត ក្នុង ន័យ កាត់បន្ថយ ផល ប៉ះពាល់ ដល់ ផ្នែក អាជីវកម្ម និង ឧស្សាហកម្ម ទេសចរណ៍ ជំរុញ សកម្មភាព សេដ្ឋកិច្ច ផ្ទៃក្នុង រក្សា ស្ថិរភាព មុខរបរ ការងារ របស់ ប្រជាជន នៅក្នុង ដំណាក់កាល លំបាក នេះ ។
លោក ប៉ាក់ សុខុម បាន ធ្វើ ការអំពាវនាវ ដល់ បុគ្គលិក និង ម្ចាស់ មូលដ្ឋាន អាជីវកម្ម ដូចជា សណ្ឋាគារ ភោជនីយដ្ឋាន មគ្គទ្ទេសក៍ ទេសចរណ៍ ត្រូវ មាន ការយោគយល់ គ្នា ទៅ វិញ ទៅមក និង រួមគ្នា ជម្នះ ការលំបាក នេះ ដើម្បី បង្ការ ទប់ស្កាត់ និង ចាត់ វិធានការដោះស្រាយ និង ខិតខំ ជំរុញ ចលនា ទេសចរណ៍ ផ្ទៃក្នុង ឲ្យ កាន់តែ ផុល ផុស ដើម្បី លើកកម្ពស់ កម្រិត ជីវភាព របស់ ប្រជាជន មូលដ្ឋាន តាមរយៈ វិស័យ ទេសចរណ៍ ក្នុង ដំណាក់កាល នេះ ។
អភិបាល ខេត្ត បាត់ដំបង អញ្ញាតឱ្យ អង្គភា ពាក់ព័ន្ធ រាយការណ៍ ពី បញ្ហា ប្រឈម ចំពោះ ដំណើរងារ របស់ ខ្លួន ដើម្បី រក វិធី ដោះស្រាយ
( បាត់ដំបង ) ៖ ក្នុង ពិធី បើក កិច្ចប្រជុំ ស្តាប់ របាយការណ៍ ប្រចាំ ខែមករា ដើម្បី ធ្វើ ការដោះស្រាយ បញ្ហា នានា និង លើក ទិសដៅ បន្ត ឆ្នាំ ២០២០ នៅ ថ្ងៃទី ៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង និង ជា ប្រធាន គណ: បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត បាន អនុញ្ញាត ឱ្យ ប្រធាន អង្គភាព នីមួយ ៗ ឡើង រាយការណ៍ ពី បញ្ហា ដែល កើត មាន ឡើង តាម ជំនាញ របស់ ខ្លួន ដើម្បី រក វិធី ដោះស្រាយ ភ្លាម ៗ ក្នុង ន័យ តម្រង់ រក វិធីសាស្ត្រ ឈ្នះ - ឈ្នះ លើ ប្រសិទ្ធ ការងារ រៀង ៗ ខ្លួន ។
នៅក្នុង ពិធី នេះ ដែរ ក៏ បាន ការចូលរួម ពី ថ្នាក់ គណៈ អភិបាល ខេត្ត ព្រះរាជអាជ្ញា ប្រធាន សាលាដំបូង ខេត្ត មេបញ្ជាការ ថ្នាក់ យោធ ភូមិភាគ ទី៥ ថ្នាក់ តំបន់ ប្រតិបត្តិការ សឹក រង បាត់ដំបង កងរាជអាវុធហត្ថ ខេត្ត លោក ស្នងការ នគរបាល ខេត្ត អភិបាល ក្រុង ស្រុក ប្រធាន មន្ទីរ អង្គភាព រដ្ឋ នានា ជុំវិញ ខេត្ត និង មន្រ្តី ពាក់ព័ន្ធ ជាច្រើន នាក់ ចូលរួម ផងដែរ ។
នៅក្នុង កិច្ចប្រជុំ នោះ ដែរ លោក ងួន រតនៈ បាន សង្កត់ធ្ងន់ អំពី បញ្ហា គ្រឿងញៀន បទល្មើស ផ្សេង ៗ ពិសេស ការពង្រឹង ច្បាប់ និង អនុវត្ត ច្បាប់ ចរាចរណ៍ លើ អ្នក ជិះ យានយន្ត គ្រប់ ប្រភេទ មិន គោរព ច្បាប់ ចរាចរណ៍ ក្នុង គោលបំណង ឱ្យ ប្រជាពលរដ្ឋ ទាំងអស់ គោរព ច្បាប់ ទាំងអស់ គ្នា ។
សេវា ទូទាត់ ប្រាក់ របស់ ប្រាសាក់ ផ្តល់ ភាពងាយស្រួល ដល់ ការចាត់ចែង អាជីវកម្ម របស់ អតិថិជន
ចាប់តាំងពី ថ្ងៃ បើក សវនាការ នៅ ថ្ងៃទី ១៥ ខែមករា ឆ្នាំ ២០២០ មកដល់ ពេលនេះ មេធាវី ការពារ ក្តី ឱ្យ ជនជាប់ចោទ កឹម សុខា បាន ដាក់ ភស្តុតាង ចំនួន ៥១ ហើយ ។ ភស្តុតាង ទាំង ៥១ នេះ មាន វីដេអូ ឃ្លីប ចំនួន ២០ ។
បន្ទាប់ពី ប្រកាស ទទួលយក នូវ ឯកសារជា ភស្តុតាង ថ្មី របស់ មេធាវី ការពារ ក្តី ឱ្យ ជនជាប់ចោទ ហើយ នោះ ក្នុង សវនាការ នៅ ព្រឹក ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ ប្រធាន ក្រុមប្រឹក្សា ជំនុំជម្រះ លោក ចៅក្រម កូយ សៅ ក៏ បាន ប្រកាស ឱ្យដឹង ពី អង្គហេតុ ដែល ត្រូវ លើក មក ជជីក ដេញដោល នៅ សប្តាហ៍ ក្រោយ ថ្ងៃទី ១២ - ១៣ ខែកុម្ភៈ ផងដែរ ។
បើ តាម លោក កូយ សៅ សវនាការ នៅ សប្តាហ៍ ក្រោយ នេះ អង្គ សវនាការ នឹង ចាប់ផ្តើម ជជីក ដេញដោល ទៅ លើ អង្គហេតុ ស្ថិត ក្នុង ចន្លោះ ឆ្នាំ ២០១២ រហូតដល់ ពេល ចាប់ខ្លួន ជនជាប់ចោទ កឹម សុខា នៅ យប់ ថ្ងៃទី ០៣ ខែកញ្ញា ឆ្នាំ ២០១៧ ។ លោក កូយ សៅ បាន ប្រកាស ថា ដើម្បីឱ្យ ការដេញដោល លើ អង្គហេតុ នេះ បាន ស្រួល លោក សូម ចែក អង្គហេតុ ជា ពីរ គឺ អង្គហេតុ នៃ ការត្រូវ រ៉ូវ គ្នា ជា សម្ងាត់ ជាមួយ បរទេស របស់ ជនជាប់ចោទ និង អង្គហេតុ នាំឱ្យ មាន ការប្រទូសរ៉ាយ ។
សម្រាប់ អង្គហេតុ នៃ ការត្រូវ រ៉ូវ គ្នា ជា សម្ងាត់ ជាមួយ បរទេស នេះ នឹឹង ដេញដោល គ្នា លើ បង្កើត គណបក្ស សង្គ្រោះ ជាតិ នៅ ថ្ងៃទី ១៧ ខែកក្កដា ឆ្នាំ ២០១២ . ការបោះឆ្នោត នៅ ឆ្នាំ ២០១៣ និង ព្រឹត្តិការណ៍ ក្រោយ ការបោះឆ្នោត ឆ្នាំ ២០១៣ រហូតដល់ ពេល ចាប់ខ្លួន ជនជាប់ចោទ ។
លោក កូយ សៅ ក៏ បាន ឱ្យដឹង ផងដែរ ថា ក្រោយពេល បញ្ចប់ លើ អង្គហេតុ នៃ ការត្រូវ រ៉ូវ គ្នា ជាមួយ បរទេស ហើយ នោះ នឹង ឈានដល់ ការដេញដោល អង្គហេតុ បង្កឱ្យ មាន ប្រទូសរ៉ាយ មុន ឈាន ទៅដល់ ការសាកសួរ សាក្សី ។
សវនាការ ជំនុំជម្រះ ក្តី គឺជា ដំណាក់កាល មួយ នៃ ការជជែក ដេញដោល គ្នា រវាង តំណាង អយ្យការ មេធាវី ដើម បណ្តឹង រដ្ឋប្បវេណី មេធាវី ការពាក្តី ឱ្យ ជនជាប់ចោទ ជាមួយនឹង ជនជាប់ចោទ ដើម្បី រកមើល ថា លោក កឹម សុខា ពិតជា បាន ប្រព្រឹត្ត ទង្វើ សន្ទិដ្ឋិភាព ជាមួយ បរទេស ដូច ការចោទប្រកាន់ ប្រាកដ មែន ឬ យ៉ាងណា ?
ក្នុង ដំណាក់កាល នេះ តំណាង អយ្យការ និង មេធាវី ដើម បណ្តឹង រដ្ឋប្បវេណី នឹង ប្រឹងប្រែង គ្រប់ វិធី ដើម្បី បង្ហាញ ទៅ ចៅក្រម ជំនុំជម្រះ ឱ្យ ឃើញ ថា ជន ជាប់ចោទ កឹម សុខា ពិតជា បាន ប្រព្រឹត្ត ទង្វើ សន្ទិដ្ឋិភាព ជាមួយ បរទេស ប្រាកដ មែន ខណៈ មេធាវី ការពារ ក្តី ឱ្យ ជនជាប់ចោទ ចំនួន ៩រូប វិញ ប្រឹងប្រែង ធ្វើ យ៉ាងណា បង្ហាញ ចៅក្រម ឱ្យ ឃើញ ថា ជន ជាប់ចោទ កឹម សុខា មិន បាន ប្រព្រឹត្ត ទង្វើ សន្ទិដ្ឋិភាព ឬ ហៅ ថា ទង្វើ ក្បត់ ជាតិ ដូច ការចោទប្រកាន់ នោះ ឡើយ ៕
( សៀមរាប ) ៖ កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប បាន ឃាត់ខ្លួន ក្រុម ចោរ ២នាក់ ក្នុង ចំណោម បក្ខពួក ៤នាក់ បន្ទាប់ពី ធ្វើ សកម្មភាព លួច សត្វ គោ របស់ ប្រជាពលរដ្ឋ បាន ២ក្បាល ចំណែក បក្ខពួក ២នាក់ រត់គេចខ្លួន បាត់ ស្រមោល ។
ករណី បង្ក្រាប ក្រុម ចោរ លួយ សត្វ គោ របស់ ប្រជាពលរដ្ឋ បាន ធ្វើឡើង វេលា ម៉ៅ ១រលង អធ្រាត្រ ឈានចូល ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នេះ នៅ ភូមិ បង្កោង ឃុំ ឣំ ពិល ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប ។
ជនសង្ស័យ ទាំង២នាក់ ខាងលើ រួម មាន ទី១៖ ឈ្មោះ សៅ ភ្លឿយ ភេទ ប្រុស អាយុ ៤៤ ឆ្នាំ ភូមិ ត្រាវ គៀត ឃុំ ដាន រុន ស្រុក សូទ្រនិគម ខេត្ត សៀមរាប និង ទី២៖ ឈ្មោះ សំ ជា ភេទ ប្រុស អាយុ ៥០ ឆ្នាំ ភូមិ ប៉ាត ត ឃុំ គោក ធ្លក ក្រោម ស្រុក ជីក្រែង ខេត្ត សៀម តាម ចម្លើយ សារភាព បាន បញ្ជាក់ ថា ពួក ខ្លួន ពិតជា បាន ធ្វើ សកម្មភាព លួច គោ ចំនួន ២ក្បាល ពិត បា្រក ដមែន ដោយ មាន បក្សពួក ២នាក់ ទៀត គឺ ឈ្មោះ បារាំង និង ឈ្មោះ ឌី ដែល បាន រត់គេចខ្លួន ។
លោក អធិការ បាន ឱ្យដឹង ថា កន្លងមក ពួក ខ្លួន បាន ធ្វើ សកម្មភាព លួច គោ នៅ ស្រុក ប្រាសាទ បាគង ២លើ ក នៅ ស្រុក សូទ្រនិគម ៤លើក និង ស្រុក ជីក្រែង បាន ១លើក ។
យោង តាម បណ្តឹង របស់ ឈ្មោះ ភិម ឈង់ ភេទ ប្រុស ឣាយុ ៦២ ឆ្នាំ នៅ ភូមិ បង្កោង ឃុំ ឣំពិល ស្រុក ប្រាសាទ បាគង ខេត្ត សៀមរាប បាន បំភ្លឺ ថា គាត់ បាន ចង គោ នៅ ខាងជើង ផ្ទះ លុះ ប្រហែល ម៉ោង ៣ស្រាប់តែ បាត់ គោ ក្រោយមក លឺ ថា សមត្ថកិច្ច ចាប់ បាន ចោរ លួច គោ ពេល មក មើល គោ នោះ គឺជា គោ របស់ គាត់ ពិត មែន ៕ កម្ពុជា មាន អ្នក ផ្ទុក មេរោគ អេដស៍ ជាង ១ម៉ឺន នាក់ ទៀត មិន ព្រម ចេញមុខ ទទួលយក សេវា ថែទាំ សុខភាព និង ការគាំពារ សង្គម
( ភ្នំពេញ ) ៖ ទេសរដ្ឋមន្រ្តី អៀង មូលី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ បាន ប្រកាស ឲ្យដឹង ថា បច្ចុប្បន្ន កម្ពុជា នៅ មាន អ្នក ផ្ទុក មេរោគ អេដស៍ ជាង ១ម៉ឺន នាក់ ទៀត កំពុង លាក់ ខ្លួន ដែល មិន ព្រម ចេញមុខ មក ទទួលយក សេវា ព្យាបាល និង ការគាំពារ ផ្នែក សង្គម ពី សេវា ព្យាបាល សាធារណៈ និង មិន ត្រូវបាន ដាក់បញ្ចូល ក្នុង ប្រព័ន្ធ សេវា ថែទាំ ជំងឺ អេដស៍ ខណៈ ដែល ពួកគេ ទាំងនោះ អាច ជា មនុស្ស មាន ធនធាន គ្រប់គ្រាន់ ដើម្បី រក សេវា ព្យាបាល ដោយ ខ្លួន ឯង និង ជា មនុស្ស មាន ឈ្មោះ ល្បី ក្នុង សង្គម ជាដើម ។
ការថ្លែង បែប នេះ របស់ លោក ទេសរដ្ឋមន្រ្តី អៀង មូលី គឺ ក្នុង ឱកាស ដែល លោក បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បើក សិក្ខាសាលា ពិគ្រោះយោបល់ ស្តីពី ការវាយតម្លៃ លើ មេរោគ អេដស៍ និង ការគាំពារ សង្គម នា ព្រឹក ថ្ងៃទី ០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ នៅ សណ្ឋាគារ ភ្នំពេញ ។
ក្នុង ឱកាស នោះ មាន វត្តមាន អស់ លោក លោកស្រី ទាំងអស់ ដែល មក ពី ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម ក្រសួង សុខាភិបាល ក្រសួង ផែនការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ទីភ្នាក់ងារ បញ្ជាក់ ចំណាយ សេវា សុខាភិបាល រួមទាំង អ្នកតំណាង ពី ប្រជាជន គន្លឹះ និង ជាពិសេស អង្គការ UNAIDS និង អង្គការ HP+ ដែល បាន ជួយ គាំទ្រ ទាំង ហិរញ្ញវត្ថុ និង បច្ចេកទេស ដល់ ការរៀបចំ សិក្ខាសាលា ដ៏ មាន សារៈសំខាន់ នេះ ។
យ៉ាងណាមិញ គោលបំណង សំខាន់ នៃ សិក្ខាសាលា នេះ គឺ៖
*ទី១. បញ្ជាក់ ឲ្យបាន ច្បាស់ នូវ ទម្រង់ នៃ ការរៀបចំ និង ការអនុវត្ត ការគាំពារ សង្គម *ទី២. រក ឲ្យ ឃើញ របាំង ដែល អ្នក ផ្ទុក មេរោគ អេដស៍ និង ប្រជាជន គន្លឹះ ប្រឈម ក្នុង ការទទួលបាន សេវា គាំពារ ពី កម្មវិធី * ទី៣. រក ឲ្យ ឃើញ នូវ អនុសាសន៍ អំពី វិធី ដែល អាច ឆ្លើយតប នឹង របាំង ទាំងនោះ ។ ប្រធានបទ នៃ សិក្ខាសាលា ពិគ្រោះយោបល់ នេះ គ្របដណ្តប់ លើ ចំណុច សំខាន់២ គឺ ការគាំពារ សង្គម និង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ ។
នៅក្នុង ឱកាស នេះ ក៏ មាន ការពិភាក្សា អំពី បញ្ហា មេរោគ អេដស៍ និង ការគាំពារ សង្គម កាលពី ថ្ងៃទី ២១ ខែកុម្ភៈ ឆ្នាំ ២០១៩ នៅ ទីស្តីការ គណៈ រដ្ឋមន្រ្តី បាន ទទួល ការឯកភាព ពី សម្តេច តេជោ ហ៊ុន សែន តាម សំណើ របស់ កិច្ចប្រជុំ ពេញ អង្គ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ នឹង ជំងឺ អេដស៍ នូវ វិធានការ៦ ចំណុច ដើម្បី លើកកម្ពស់ ភាព ជា ម្ចាស់ ប្រទេស និង ការឆ្លើយតប ប្រកប ដោយ ចីរភាព នឹង មេរោគ អេដស៍ និង ជំងឺ អេដស៍ រយៈពេល វែង ។ ចំណុច ទី២ នៃ វិធានការ បាន ចែង ថា អ្នក ផ្ទុក មេរោគ អេដស៍ ទាំងអស់ ត្រូវ ទទួលបាន មូលនិធិ សមធម៌ សុខាភិបាល ។
គួរ បញ្ជាក់ ថា ( កម្មវិធី ) អត្តសញ្ញាណ បណ្ណ ក្រីក្រ តាម តម្រូវការ នៃ ក្រសួង ផែនការ ដែល ត្រូវបាន ដាក់ចេញ នៅ ចុង ឆ្នាំ ២០១៩ នឹង ផ្តល់ នូវ ការគាំទ្រ ដល់ ប្រជាជន គន្លឹះ ផងដែរ ៕ សម្តេច ម៉ែ និង ព្រះមហាក្សត្រ ប្រទាន ព្រះរាជ ទ្រព្យ ១៥ម៉ឺន ដុល្លារ ដល់ ចិន ដើម្បី ចូលរួម សម្រាល ការលំបាក ពេល ជំងឺ កូរ៉ូណា កំពុង រាតត្បាត
« លោក ប្រធានាធិបតី ក៏ បាន អរ ព្រះគុណ ព្រះមហាក្សត្រ និង ព្រះមហាក្សត្រី ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ដែល បាន សព្វ ព្រះរាជ ហឫ រាជ ឧបត្ថម្ភ ថវិកា ១០ម៉ឺន និង ៥ម៉ឺន ដុល្លារ សម្រាប់ ជួយ ដល់ ការលំបាក របស់ ចិន » ។ លោក កៅ កឹម ហួន គូសបញ្ជាក់ ។
សូម បញ្ជាក់ ថា ព្រះមហាក្សត្រ នៃ កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ បាន សព្វ ព្រះរាជ ហឫទ័យ ប្រោស ព្រះរាជ ទាន ព្រះរាជ សារ ជូន លោក ស៉ី ជីន ពីង ចំពោះ ការផ្ទុះឡើង នូវ មេរោគ កូរ៉ូណា ។ ក្នុង ព្រះរាជ សារលិខិត នោះ ព្រះមហាក្សត្រ នៃ កម្ពុជា ទ្រង់ បាន បង្ហាញ នូវ អារម្មណ៍ សោក សៅ ក្រៃលែង ចំពោះ ការផ្ទុះឡើង នៃ វីរុស កូរ៉ូណា ដែល បាន ធ្វើឱ្យ ប៉ះពាល់ ដល់ ប្រទេស ចិន និង បណ្តាលឲ្យ បាត់បង់ជីវិត ប្រជាពលរដ្ឋ ។
ស្រប ពេល ជាមួយគ្នា នេះ សម្តេច ម៉ែ ទ្រង់ ក៏ បាន សព្វ ព្រះហ ឫទ័យ ប្រទាន រាជ សារ មួយ ជូន លោក ស៉ី ជិន ពីង ដោយ សម្តែង នូវ សេចក្តីក្រៀមក្រំ ចំពោះ ប្រជាជន ចិន ជា បងប្អូន ដែល បាន បាត់បង់ជីវិត និង រងគ្រោះ ដោយសារ វីរ៉ុស កូរ៉ូណា ថ្មី ។ សម្តេច ម៉ែ សូម ចូលរួម រំលែក ទុក្ខសោក របស់ ប្រជាជន ចិន ជាពិសេស ក្រុមគ្រួសារ នៃ ជនរងគ្រោះ ដែល បាន បាត់បង់ជីវិត ដោយសារ វីរ៉ុស នេះ ៕
សង្ក្រាន្ត ព្រៃវែង ឆ្នាំ ២០២០ នឹង រៀបចំ ឱ្យ មាន ទស្សនីយភាព ប្លែក ៗ តាមរយៈ ការបង្កើត ល្បែង កម្សាន្ត បែប ប្រពៃណី ខ្មែរ
ការលើកឡើង បែប នេះ របស់ លោក ជា សុមេធី បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ៥ ខែកុម្ភៈ ឆ្នាំ ២០២០ ម្សិលមិញ នៅក្នុង ឱកាស ដែល លោក បាន ដឹកនាំ កិច្ចប្រជុំ ត្រៀម រៀបចំ សង្ក្រាន្ត ព្រៃវែង ឆ្នាំ ២០២០ ជាមួយ អង្គភាព ពាក់ព័ន្ធ នានា នៅ សាល ប្រជុំ សាលា ខេត្ត ព្រៃវែង ។
លោក ជា សុមេធី បាន បន្ត ថា ដូច្នេះ ព្រឹត្តិការណ៍ សង្រ្គាន្ត ព្រៃវែង នេះ អាច បំពេរ នូវ ភាពសប្បាយរីករាយ មួយ ផ្នែក សម្រាប់ ប្រជាពលរដ្ឋ និង រួមចំណែក ថែរក្សា ប្រពៃណី ទំនៀមទម្លាប់ ក៏ ដូចជា វប្បធម៌ ជា មរតក ដ៏ មាន តម្លៃ របស់ បុព្វបុរស ខ្មែរ និង ថែមទាំង ផ្តល់ នូវ ជំនឿចិត្ត ដល់ ប្រជាពលរដ្ឋ កាន់តែ ខ្ពស់ លើ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
ទន្ទឹមនឹង នេះ លោក ជា សុមេធី ក៏ បាន ឱ្យដឹង ដែរ ថា សង្រ្គាន្ត ព្រៃវែង ឆ្នាំ ២០២០ នេះ មាន ការរៀប ជា ស្តង់ ពិរ ពណ៍ ជាតិ និង អន្តរជាតិ ប្រមាណ ជាង ១០០ ស្តង់ ក្នុង នោះ មាន ស្តង់ លក់ ចំណីអាហារ កន្លែង ប្រារព្ធ ពិធីសាសនា និង កម្មវិធី កម្សាន្ត ជាច្រើន ទៀត ដូច ជា៖ ការសម្តែង របាំ ប្រពៃណី របាំ ត្រុដ របាំ ជូនពរ និង ទម្រង់ របាំ ជាច្រើន ទៀត ហើយ លោក រំពឹងទុក ថា មិន ខុសពី ឆ្នាំ កន្លងទៅ នោះ ទេ ។
សូម បញ្ជាក់ ថា នៅក្នុង កិច្ចប្រជុំ នោះ ផងដែរ លោក ជា សុមេធី ក៏ បាន ឱ្យ គណៈកម្មការ ទាំង៨ ដើម្បី លើកឡើង អំពី គម្រោង ផែនការ សកម្មភាព របស់ ខ្លួន និង គម្រោង ថវិកា សម្រាប់ ធ្វើ ការចំណាយ នៅក្នុង ការរៀបចំ សង្ក្រាន្ត ព្រៃវែង ឆ្នាំ ២០២០ នេះ ធ្វើ យ៉ាងណា រៀបចំ ការងារ នេះ ឱ្យ បាន រលូត ។
លោក ស្នងការ នគរបាល ខេត្ត ព្រៃវែង ក៏ បាន លើកឡើង អំពី ផែនការ ការពារ សន្តិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ដែល មក លេង កម្សាន្ត ក្នុង ឱកាស បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ខ្មែរ សង្ក្រាន្ត ព្រៃវែង ឆ្នាំ ២០២០ ដើម្បី ធានា សុវត្ថិភាព ជូន ពួកគាត់ ឱ្យ បាន ល្អ ប្រសើរ ៕ ស្រ្តី អវកាសយានិក អាមេរិក ត្រឡប់ ចុះ មក កាន់ ផែនដី វិញ ក្រោយ ស្នាក់ នៅលើ ស្ថានីយ អវកាស អន្តរជាតិ ជិត ១ ឆ្នាំ
សាលា អាយ ឌាលី អន្តរជាតិ ចេញ វិធានការកាពារ សិស្ស ពី ជំងឺ រលាក សួត ដែល បង្ក ដោយ វីរ៉ុស កូរ៉ូណា តាម ការអំពាវនាវ របស់ ក្រសួង អប់រំ
( ភ្នំពេញ ) ៖ តប តាម សេចក្តីណែនាំ ក៏ ដូចជា ការអំពាវនាវ របស់ ក្រសួង អប់រំ យុវជន និង កីឡា សាលា អាយ ឌាលី អន្តរជាតិ បាន ចេញ សេចក្តីជូនដំណឹង ដោយ ដាក់ ចេញ វិធានការ មួយចំនួន ក្នុង ការកាពារ សិស្ស របស់ ខ្លួន ពី ជំងឺ រលាក សួត ដែល បង្ក ដោយ វីរ៉ុស កូរ៉ូណា ប្រភេទ ថ្មី ។
យោង តាម សេចក្តីជូនដំណឹង នេះ សាលា អាយ ឌាលី អន្តរជាតិ បាន ប្រាប់ ឲ្យ អនុវត្តន៍ ដូច ខាងក្រោម៖
បន្ថែម លើ សេចក្តីជូនដំណឹង នេះ ដែរ លោក លី ហាវ ស្ថាបនិក សាលា អាយ ឌាលី អន្តរជាតិ បាន ថ្លែង ថា គ្រប់ សាខា ត្រូវ អនុវត្តន៍ និង តាមដាន ជាប្រចាំ នូវ សុខភាព និង អនាម័យ របស់ សិស្ស គ្រប់ រូប ទាំង ពេល ចូលរៀន និង ពេល ចេញ លេង ។ ជាពិសេស ត្រូវ មាន សហការ ល្អ ជាមួយ អាណាព្យាបាល និង តាមដាន ព័ត៌មាន ពី ក្រសួង សុខាភិបាល និង ក្រសួង អប់រំ ជាប្រចាំ ផងដែរ ។
លោក លី ហាវ ថែមទាំង បាន អំពាវនាវ ដល់ អាណាព្យាបាល និង សិស្សានុសិស្ស មិន ត្រូវ មាន ការភ័យខ្លាច ជំងឺ នេះ ឡើយ ព្រោះ បើសិនជា យើង ធ្វើ អនាម័យ បាន ល្អ យើង ក៏ មិន ឆ្លង ជំងឺ នេះ បាន ដែរ ។ លោក បញ្ជាក់ ថា « ប្រសិនបើ យើង បាន ចូលរួម រក្សា អនាម័យ ល្អ ហើយ ព្រមទាំង មាន ការយកចិត្តទុកដាក់ ពី សាលា ផង សូម បញ្ជូន កូន ទៅ សាលារៀន ជាធម្មតា ដើម្បី កុំ ឲ្យ មាន ការប៉ះពាល់ ដល់ ការសិក្សា របស់ ពួកគាត់ » ។
សូម បញ្ជាក់ ថា បន្ទាប់ពី ក្រសួង អប់រំ យុវជន និង កីឡា ចេញ សេចក្ដីណែនាំ ស្ដីពី ការអនុវត្តន៍ វិធានការ បង្ការ ជំងឺ រលាក សួត ដោយ វីរុស កូរ៉ូណា ថ្មី រួច មក . គ្រឹះស្ថាន សិក្សា សាធារណៈ និង ឯកជន នានា បាន ចូលរួម ធ្វើ សកម្មភាព ទប់ស្កាត់ ការឆ្លង វីរុស នេះ នៅ តាម គ្រឹះស្ថាន សិក្សា របស់ ខ្លួន ដោយ លើកទឹកចិត្ត ឲ្យ បុគ្គលិក និង សិស្សានុសិស្ស ពាក់ ម៉ាស ការពារ ជាប្រចាំ មាន ការវាស់ស្ទង់ សីតុណ្ហភាព ក្នុង ខ្លួន មុនពេល ចូលរៀន ជាដើម ។
ក្រសួង អប់រំ បាន ឲ្យដឹង ថា ក្នុង នោះ ដែរ ក៏ មាន ដាក់ អាកុល សាប៊ូ សម្រាប់ សិស្ស លាង ដៃ ឲ្យបាន ទៀងទាត់ និង ញឹកញាប់ ជាប្រចាំ ពិសេស មុនពេល បរិភោគ អាហារ ឬ ក្រោយពេល ប៉ះពាល់ អ្វី ដែល កខ្វក់ ព្រមទាំង មាន ការណែនាំឲ្យ សិស្ស ចៀសវាង ប៉ះពាល់ អ្នក មាន ជំងឺ ផ្លូវ ដង្ហើម ប្រកាន់ខ្ជាប់ នូវ ការអនុវត្ត អនាម័យ ស្អាត សុវត្ថិភាព ចំណីអាហារ មិន គួរ ទៅកាន់ កន្លែងណា ដែល មាន មនុស្ស អ៊ូអរ ពេក ព្រមទាំង បរិភោគ ទឹក ឲ្យបាន ច្រើន ។
ទោះជា យ៉ាង នេះ ក្តី រហូតដល់ មកដល់ ពេលនេះ ស្ថានភាព ជនជាតិ ចិន ដែល ផ្ទុក ជំងឺ ផ្លូវ ដង្ហើម ថ្មី ហើយ ដាក់ ឲ្យ សម្រាក នៅ បន្ទប់ ដាច់ដោយឡែក នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ព្រះសីហនុ នោះ កំពុង មាន សុខភាពល្អ ប្រសើរឡើង ដោយ មិន មាន អ្វី គួរឲ្យ កត់សម្គាល់ ទៀត ឡើយ ខណៈ ដែល ក្រុមគ្រួសារ របស់ គាត់ ទាំង ៣នាក់ ពុំ មាន រោគសញ្ញា នៃ មេរោគ កូរ៉ូណា នោះ ទេ ៕ ក្រសួង មហាផ្ទៃ សម្រេច ដាក់ ឱ្យ ដំណើរការ នូវ រចនាសម្ព័ន្ធ ថ្មី នៃ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ទូទាំង ប្រទេស
លិខិត ក្រសួង មហាផ្ទៃ បាន បន្ថែម ទៀត ថា ដើម្បីឲ្យ កិច្ច ដំណើរការ រៀបចំ ពិធី ប្រកាស ដាក់ ឱ្យ ដំណើរការរចនាសម្ព័ន្ធ ក្រុង ស្រុក ខណ្ឌ នីមួយ ៗ ប្រព្រឹត្តទៅ ដោយ រលូន និង បាន ទាន់ ពេលវេលា កំណត់ ក្រសួង មហាផ្ទៃ សូម ធ្វើ ការរៀបចំ ពិធី ប្រកាស ដាក់ ឲ្យ ដំណើរការរចនាសម្ព័ន្ធ ក្រុង ស្រុក ខណ្ឌ ដូច ខាងក្រោម៖
១៖ រដ្ឋបាល រាជធានី ខេត្ត នីមួយ ៗ ត្រូវ រៀបចំ កម្មវិធី និង បែងចែក ថ្នាក់ដឹកនាំ រាជធានី ខេត្ត ដើម្បី ធ្វើជា អធិបតី ក្នុង ពិធី ប្រកាស ដាក់ ឱ្យ ដំណើរការរចនាសម្ព័ន្ធ ក្រុង ស្រុក ខណ្ឌ ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ។ ចំពោះ កម្មវិធី ប្រកាស នៅ តាម រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ នីមួយ ៗ ត្រូវ ប្រព្រឹត្តទៅ នៅ អំឡុង សប្តាហ៍ ទី២ នៃ ខែកុម្ភៈ ចាប់ពី ១០ ដល់ ថ្ងៃ ១៤ ខែកុម្ភៈ ឆ្នាំ ២០២០ ខាងមុខ ។
២៖ នាយក រដ្ឋបាល សាលា រាជធានី ខេត្ត ត្រូវ ធ្វើជា សេនាធិការ ជូន គណៈអភិបាល របស់ ខ្លួន ក្នុង ការសម្របសម្រួល កម្មវិធី ដោយ សហការ ជាមួយ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ នីមួយ ៗ ដើម្បី ចាត់ចែង រៀបចំ ពិធី ប្រកាស ដាក់ ឲ្យ ដំណើរការរចនាសម្ព័ន្ធ ថ្មី នៃ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ នីមួយ ៗ ។
សូម បញ្ជាក់ ថា បន្ទាប់ពី ដាក់ ឱ្យ ដំណើរការ នូវ រចនាសម្ព័ន្ធ ថ្មី នៃ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ទូទាំង ប្រទេស ខាងមុខ នេះ ការិយាល័យ មួយចំនួន នៅក្នុង មន្ទីរ តាម បណ្តា រាជធានី ខេត្ត នឹង ស្ថិត នៅក្រោម ការគ្រប់គ្រង របស់ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ដោយ មិន ស្ថិត នៅក្រោម មន្ទីរ ដូច មុន ទេ ។ នេះ បើ តាម ការបញ្ជាក់ ពី មន្រ្តី ជំនាញ ៕
ខាងក្រោម លិខិត របស់ ក្រសួង មហា ផ្ទៃ៖
លោក វេជ្ជបណ្ឌិត អូដា នៅ ប្រទេស ជប៉ុន បាន បញ្ជាក់ ថា ទឹក បរិសុទ្ធ នេះ មាន មុខងារ សំខាន់ ណាស់ សំរាប់ អ្នកជំងឺ របស់ គាត់ ជាច្រើន ពាន់ អ្នក មកពី បណ្តា ប្រទេស ជាច្រើន ក្នុង តំបន់ អាស៊ី ដោយ លោក បាន ណែនាំ ពួកគាត់ ឱ្យ ទទួលទាន ទឹក នេះ ជាមួយ ថ្នាំ ព្យាបាល មហារីក ពីព្រោះ ម៉ូលេគុល ដ៏ តូច ល្អិត ៗ របស់ ទឹក រ៉ែ នេះ អាច ជ្រាប ចូល ដល់ សារ ពាង្គកាយ មនុស្ស បាន លឿន ល្អ សំរាប់ លៀង កោសិកា អាក្រក់ និង ជាតិ ពុល ផងដែរ ។
របៀប ប្រើប្រាស់ ទឹក ពិសារ សុខភាព Hisui ៖ លោក វេជ្ជបណ្ឌិត សូម ណែនាំ ពិសារ យ៉ាងតិច ២លីត្រ ក្នុង មួយ ថ្ងៃ . អ្នក ដែល មាន បញ្ហា សុខភាព ពិសារ រយៈពេល ៣ខែ អ្នក នឹង ទទួលបាន ផល ល្អ ប្រសើរ . សូម ធ្វើ ការសាកល្បង ពិសារ ដើម្បី ដឹង ពី សមត្ថភាព របស់ ទឹក ដោយ ធ្វើ ការពិនិត្យ សុខភាព មុនពេល ទទួលទាន និង ពិនិត្យ សុខភាព ឡើងវិញ បន្ទាប់ពី ទទួល តាម ការកំណត់ ខាងលើ លោក អ្នក នឹង ឃើញ ពី លទ្ធផល របស់ វា ។
ទេសរដ្ឋមន្រ្តី លី ធុជ៖ សម្តេច តេជោ ហ៊ុន សែន លះបង់ គ្រប់ បែបយ៉ាង ដើម្បី រក្សា ការពារ សន្តិភាព ស្ថេរភាព នយោបាយ និង ការអភិវឌ្ឍ
ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក ង៉ោ ម៉េង ជ្រួន អភិបាល រង ខេត្ត បន្ទាយមានជ័យ អភិបាល ស្រុក ថ្ម ពួក មន្ទីរ ជុំវិញ ខេត្ត ស្រុក ប្រជាពលរដ្ឋ ជា ជនពិការ និង សិស្សានុសិស្ស សរុប ប្រមាណ ៧០០ នាក់
ទេសរដ្ឋមន្រ្តី ក្នុង នាម សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បាន អរគុណ ដល់ អតីត យុទ្ធជន និង ប្រជាពលរដ្ឋ ស្រុក ថ្ម ពួក ដែល បាន ចូលរួម ជាមួយ សម្តេច តេជោ ក្នុង ការបញ្ចប់ សង្រ្គាម នាំ មក ការបង្រួបបង្រួម ជាតិ និង សន្តិភាព ជូន ជាតិ មាតុភូមិ ក្រោម គោល នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្រេច តេជោ នាយក រដ្ឋមន្រ្តី ។
ទេសរដ្ឋមន្រ្តី បាន ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ ការសួរសុខទុក្ខ និង សេចក្តីនឹករលឹក របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ជូន ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ និង សិស្សានុសិស្ស ទាំងអស់ និង ការខិតខំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ដើម្បី រក្សា ការពារ សន្តិភាព ស្ថេរភាព នយោបាយ សន្តិសុខ សង្គម និង ការអភិវឌ្ឍ ជូន ជាតិ មាតុភូមិ នៃ យើង ។
ទេសរដ្ឋមន្រ្តី បាន បញ្ជាក់ បន្ថែម ថា « សម្តេច តេជោ នាយក រដ្ឋ តែងតែ មាន កង្វល់ និង យកចិត្តទុកដាក់ បំផុត ចំពោះ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ហើយ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី អាណិតអាសូរ និង សោកស្តាយ ជា ពន់ពេក នៅពេល លឺ ដំណឹង ថា មាន បងប្អូន ប្រជាពលរដ្ឋ ណា ម្នាក់ រងគ្រោះ និង ពិការភាព ដោយសារ គ្រោះថ្នាក់ ដោយសារ មីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ម្តង ៗ ក្នុង កំឡុង ពេល ដែល ប្រទេស កម្ពុជា ទទួលបាន នូវ សុខ សន្តិភាព ពេញលេញ ទូទាំង ប្រទេស » ។
ក្នុង នាម សម្តេច តេជោ ប្រធាន អាជ្ញាធរ មីន ទេសរដ្ឋមន្រ្តី លី ធុជ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ និង អាជ្ញាធរ មូលដ្ឋាន ទាំងអស់ ដែល រស់ នៅ តំបន់ រង ផល ប៉ះពាល់ ដោយសារ មីន /ស. ផ.ស. បង្កើន ការប្រុងប្រយ័ត្ន និង ចូលរួម ផ្សព្វផ្សាយ ការយល់ដឹង អំពី ការគ្រោះថ្នាក់ ដោយសារ មីន /ស. ផ. ស. នៅ តាម សហគមន៍ ។
ឆ្លៀត ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្ត្រី លី ធុជ បាន នាំ អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន អាជ្ញាធរ មីន ចែកជូន ដល់ បងប្អូន ជន ពិការ ចំនួន ៣០០ នាក់ តា ជី - យាយ ជី លោកគ្រូ - អ្នក គ្រូ និង សិស្សានុសិស្ស ផងដែរ ។
ចិន៖ ទារក ម្នាក់ ក្លាយជា អ្នក ឆ្លង វីរុស កូរ៉ូណា ក្មេង ជាង គេ បំផុត ជា លើក ដំបូង ចាប់តាំងពី ការផ្ទុះឡើង
( ប៉េកាំង ) ៖ ទារក ចិន ម្នាក់ ត្រូវបាន គេ ពិនិត្យ រកឃើញ ថា បាន ឆ្លង វីរុស កូរ៉ូណា ក្រោយ ចាប់កំណើត បាន ត្រឹមតែ ៣០ ម៉ោង ប៉ុណ្ណោះ ហើយ ដែល នេះ គឺជា ករណី ឆ្លង លើ ទារក ដំបូង គេ បំផុត ចាប់តាំងពី ការផ្ទុះឡើង នៃ វីរុស នេះ រហូតមក ទល់នឹង ពេល បច្ចុប្បន្ន ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ថ្ងៃព្រហស្បតិ៍ ទី០៦ ខែកុម្ភៈ ឆ្នាំ ២០២០ ។
ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ បាន ឱ្យដឹង ទៀត ថា ទារក ខាងលើ កើត នៅ ថ្ងៃទី២ ខែកុម្ភៈ ក្នុង មន្ទីរពេទ្យ មួយ នៅឯ ទីក្រុង វូហាន រីឯ ម្ដាយ របស់ ទារក រូប នេះ ត្រូវបាន គេ ធ្វើតេស្ដ រកឃើញ ថា ឆ្លង វីរុស កូរ៉ូណា មុននឹង គាត់ សម្រាល កូន ។ ប៉ុន្តែ មិន ទាន់ មាន ការបញ្ជាក់ ឱ្យ បាន ច្បាស់ ថា តើ វីរុស កូរ៉ូណា ឆ្លង ទៅ ទារក រូប នេះ ដោយ របៀប ណា នោះ ទេ ខណៈ ទារក ដែល មាន ទម្ងន់ ៣.២៥ គីឡូក្រាម រូប នេះ កំពុង ស្ថិត ក្នុង ស្ថានភាព នឹង នរ និង ត្រូវបាន តាមដាន យ៉ាង យកចិត្តទុកដាក់ ។
ចាប់តាំងពី ថ្ងៃទី៣០ ខែមករា ឆ្នាំ ២០២០មក មាន ប្រជាជន ចិន ជាច្រើន នាក់ បាន ចូលមក សរសេរ សារ ថា « សូម ថ្លែងអំណរគុណ និង ទឹកចិត្ត របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល បាន បង្ហាញ នូវ ការគាំទ្រ និង មាន ជំនឿ ទុកចិត្ត ចំពោះ រដ្ឋាភិបាល ចិន និង ប្រជាជន ចិន ក្នុង ការប្រយុទ្ធ ប្រឆាំង ប្រឹង យកឈ្នះ ជាមួយនឹង សង្គ្រាម ដែល មើល មិន ឃើញ នេះ » ។
ប្រជាជន ចិន បាន អះអាង ទៀត ថា ទឹកចិត្ត របស់ សម្ដេច តេជោ ហ៊ុន សែន បាន ធ្វើឲ្យ ប្រជាជន ចិន មានអារម្មណ៍ កក់ ក្ដៅ ក្នុង ចិត្ត ខណៈ ដែល ប្រទេស មួយ នេះ កំពុង ស្ថិត ក្នុង កាលៈទេសៈ ដ៏ លំបាក នេះ ។ ពួកគេ បញ្ជាក់ ថា « ការធ្វើដំណើរ យូរ ទើប ដឹង កម្លាំង សេះ នៅពេល ប្រឈម នឹង គ្រា លំបាក បាន គឺ កាន់ ដឹង ច្បាស់ ណាស់ ថា ប្រទេស កម្ពុជា ជា មិត្តភ័ក្ដិ ល្អ ជា អ្នកជិតខាង ល្អ និង ជា បងប្អូន ល្អ របស់ ប្រទេស ចិន » ។
