( ភ្នំពេញ ) ៖ លោក ផ្លោក ផោន រដ្ឋលេខាធិការ ក្រសួង ធម្មការ និង សាសនា នៅ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ចូលរួម បើក ពិធី សូត្រ លើក ទី ២៩ និង ប្រឡង ចាំ មាត់ លើក ទី៣ គម្ពីរ អាល់គូរ អានុល ការីម ថ្នាក់ ជាតិ ឆ្នាំ ២០២០ នៅ វិហារ ធំ គីឡូម៉ែត្រ លេខ ៩ ភូមិ ៣ សង្កាត់ ច្រាំង ចំរេះ១ ខណ្ឌ ឬស្សីកែវ រាជធានី ភ្នំពេញ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក រដ្ឋលេខាធិការ បាន លើកឡើង ថា រាជ រដ្ឋាភិបាល ដែល មាន សមេ្តច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ បាន នឹង កំពុង ខិតខំ យ៉ាង សកម្ម បំផុត ក្នុង ការរក្សា សុខ សន្តិភាព ស្ថិរភាព សុវត្ថិភាព ការពង្រឹង និង ពង្រីក ខឿន សេដ្ឋកិច្ច ជាតិ និង ការធ្វើឱ្យ មាន វឌ្ឍនភាព វប្បធម៌ ប្រពៃណី ក៏ ដូចជា ការបង្ក បរិយាកាស យោគយល់ ចុះ សម្រុង គ្នា និង ភាពសុខដុមរមនា រវាង សាសនិក នៃ សាសនា ទាំងឡាយ នៅ កម្ពុជា ដើម្បី ឈាន ទៅកាន់ ការអភិវឌ្ឍ សង្គមជាតិ ។
លោក បាន សង្កត់ធ្ងន់ ថា រាជ រដ្ឋាភិបាល តែង ស្វាគមន៍ ជានិច្ច នូវ រាល់ សកម្មភាព គ្រប់ សាសនា នៅ កម្ពុជា ដែល មាន លក្ខណៈ ជា ការអភិវឌ្ឍ សង្គមជាតិ ដោយ គោរព ច្បាប់ ប្រទេសជាតិ ជា ធំ គោរព សិទ្ធិ និង កិត្តិយស ផង គ្នា មិន រំលោភបំពាន គ្នា ពិសេស នៅក្នុង ការផ្សព្វផ្សាយ សាសនា របស់ ខ្លួន ។
ឆ្លៀត ក្នុង ឱកាស នេះ លោក ផ្លោក ផោន សូម ស្ងើចសរសើរ ដោយ ស្មោះ ច៓ពោះ លទ្ធផល សកម្មភាព ការងារ ដែល គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា សម្រេចបាន នា ពេល កន្លងមក ដើម្បី រួមចំណែក ជាមួយនឹង រាជ រដ្ឋាភិបាល ក្នុង ការកសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ។ ការធ្វើដំណើរ យ៉ាង រលូន និង សន្សឹម ៗ តាម ទិសដៅ របស់ ខ្លួន ដើម្បី បំពេញ នូវ ទំនុកចិត្ត របស់ ព្រះអល់ ឡោះ និង របស់ មនុស្សជាតិ គឺជា កត្តា មួយ ដ៏ សំខាន់ បំផុត ក្នុង ការសម្រេចបាន នូវ ផែនការ ទិសដៅ របស់ ខ្លួន ។
បើ តាម លោក ឧកញ៉ា សុះ កុំ រី ចាងហ្វាង គណៈ ដឹកនាំ ជាន់ ខ្ពស់ នៃ សាសនា ឥស្លាម កម្ពុជា បាន លើកឡើង ថា ការរៀប ពិធី សូត្រ អាល់គូរ អាន នេះ បាន ធ្វើឡលង ជារៀងរាល់ ឆ្នាំ ហើយ ប្រធានបទ ខុស ៗ គ្នា ខណៈ លើក នេះ យើង បាន ដាក់ ប្រធានបទ ថ្មី គឺ « ឥស្លាម និង សេដ្ឋកិច្ច » ។
សូម ជម្រាប ថា បេក្ខជន បេក្ខ នារី ដែល ចូលរួម ប្រកួត សូត្រ អាល់គូរ អាន នុល ការីម នេះ មាន ចំនួន ៣៦ រូប ក្នុង នោះ ប្រុស មាន ចំនួន ២០ រូប នារី មាន ចំនួន ១៦រូប ៕
ទេសរដ្ឋមន្ត្រី អូស្មាន ហាស្សាន់ អញ្ជើញ មកដល់ កម្ពុជា វិញ ក្រោយ បញ្ចប់ ទស្សនកិច្ចការងារ នៅ អារ៉ាប៊ី សាអ៊ូឌីត និង អេមីរ៉ាត អារ៉ាប់ រួម រយៈពេល មួយ សប្តាហ៍
( ភ្នំពេញ ) ៖ នៅ យប់ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ លោក អូស្មាន ហាស្សាន់ ទេសរដ្ឋមន្ត្រី ទទួលបន្ទុក បេសកកម្ម ពិសេស បាន អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា វិញ ហើយ បន្ទាប់ពី បំពេញ ទស្សនកិច្ចការងារ ប្រដោយ ជោគជ័យ នៅ ប្រទេស អារ៉ាប៊ី សាអ៊ូឌីត និង ប្រទេស អេមីរ៉ាត អារ៉ាប់ រួម រយៈពេល មួយ សប្តាហ៍ គឺ ចាប់ពី ថ្ងៃទី ០៤ ដល់ ថ្ងៃទី ១០ ខែមករា នេះ ។
បន្ទាប់មក ទេសរដ្ឋមន្រ្តី អូស្មាន ហាស្សាន់ បាន បន្ត ដំណើរ ទៅកាន់ ប្រទេស អារ៉ាប់ រួម អេមីរ៉េត នៅ ទីក្រុង ឌូបៃ និង ទីក្រុង អាប៊ុយ ដាប៊ី ដើម្បី ជួប ពិភាក្សា ការងារ ជាមួយ ថ្នាក់ដឹកនាំ ស្ថាប័ន សំខាន់ ៗ និង សប្បុរស ជន មួយចំនួន ៕
នៅពេល ត្រូវបាន អ្នកសារព័ត៌មាន សួរ ថា តើ អ៉ី រ៉ង់ បាន បង្ក ការគំរាមកំហែង ធ្ងន់ធ្ងរ ដល់ កម្រិត ណា ទើប ឈាន ទៅដល់ ការសម្រេចចិត្ត ឲ្យ មាន ការវាយប្រហារ ដោយ យន្តហោះ ដ្រូន របស់ សហរដ្ឋ អាមេរិក កាលពី ថ្ងៃសុក្រ សប្តាហ៍ មុន ? លោក ដូណាល់ ត្រាំ បាន ឆ្លើយតប យ៉ាង ដូច្នេះ ថា « ខ្ញុំ អាច ត្រឹម បង្ហើប ថា ស្ថានទូត របស់ យើង យ៉ាងតិច ចំនួន ០៤ ត្រូវបាន អ៉ីរ៉ង់ រៀបចំ ផែនការ ដើម្បី វាយប្រហារ » ។
( ភ្នំពេញ ) ៖ ក្នុង ខែធ្នូ ឆ្នាំ ២០១៩ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល ជា មូលនិធិ ផ្លូវការ បង្កើតឡើង ដោយ រាជ រដ្ឋាភិបាល ក្នុង គោលដៅ ចូលរួម ធានា និរន្តរភាព នៃ កិច្ច ដំណើរការ របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ទាំង ប្រាំ ទីតាំង បាន ទទួល ថវិកា បរិច្ចាគ សរុប ចំនួន ៣៩៣. ៤៤៤. ៩០០ រៀល ( ស្មើនឹង ជាង ៩ម៉ឺន ដុល្លារ ) និង ១៧៦. ៤៩៨ ដុល្លារ អាមេរិក ។
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សូម ថ្លែងអំណរគុណ ដល់ សប្បុរសជន ទាំងអស់ ដែល តែងតែ ផ្តល់ ការគាំទ្រ និង បរិច្ចាគ ថវិកា សម្រាប់ ទ្រទ្រង់ និង ផ្ដល់ ការគាំពារ ផ្នែក ថែទាំ សុខភាព កុមារ ប្រកបដោយ គុណភាព និង មិន - គិត ថ្លៃ ដោយ មន្ទីរពេទ្យ គន្ធ បុប្ផា នា ពេល កន្លងមក និង នៅពេល អនាគ ។
មន្ដ្រី នគរបាល ជាន់ ខ្ពស់ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ មកកាន់ បណ្ដាញ ព័ត៌មាន Fresh News ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០១៩ នេះ ថា ប្រតិបត្តិការ នេះ ធ្វើឡើង ក្រោម ការបញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ និង ដឹកនាំ ប្រតិបត្តិការ ផ្ទាល់ ដោយ លោក ឧត្តមសេនីយ៍ ទោ ហួត ចាន់ យ៉ារ៉ាន់ ស្នងការ រង នគរបាល រាជធានី ភ្នំពេញ ។
សូម ជម្រាប ថា ជន បង្ក ដែល ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន នេះ គឺជា អ្នកបើក រថយន្ដ ផ្ទាល់ តែម្ដង ហើយ ត្រូវ ជា ពូ របស់ ឈ្មោះ ឆេង គីម លី អាយុ ២១ ឆ្នាំ ដែល ជា ម្ចាស់ រថយន្ដ ដែល ត្រូវ សមត្ថកិច្ច ចាប់ខ្លួន កាលពី ម្សិលមិញ នៅ ផ្ទះ ដែល មាន ទីតាំង ក្នុង សង្កាត់ បឹង ទំពុន ខណ្ឌ មានជ័យ ។ ដោយឡែក ឈ្មោះ ឆេង ម៉េង លី ដែល ជា ឈ្មោះ នៅក្នុង ប័ណ្ណ សម្គាល់ យានយន្ដ នោះ គឺជា បង ជីដូនមួយ របស់ ឆេង គីម លី ហើយ មិន ជាប់ពាក់ព័ន្ធ ក្នុង ករណី នេះ ទេ ។
បន្ទាប់ពី ឃាត់ខ្លួន ជន បង្ក ឈ្មោះ ហ៊ុយ ទូច រួម ជាមួយ រថយន្ដ ត្រូវបាន បញ្ជូន ទៅកាន់ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី កសាង សំណុំរឿង ចាត់ការបន្ដ តាម នីតិវិធី ។
ភ្ញៀវ ពិសេស ប្រចាំ សប្តា ហ៍៖ ប្រធាន សមាគម អ្នក វាយតម្លៃ និង ភ្នាក់ងារ អចលន វត្ថុ កម្ពុជា នឹង បញ្ជាក់ ពី « សុខភាព វិស័យ អចលន ទ្រព្យ នៅ កម្ពុជា ឆ្នាំ ២០២០ » នៅ ថ្ងៃចន្ទ សប្តាហ៍ ក្រោយ !
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ឱ្យដឹង ថា រយ : ពេល៣ ថ្ងៃ បន្ទាប់ពី ប្រកាស ដាក់ លក ជា ផ្លូវការ កាលពី ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២០ កន្លងទៅ នេះ « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » លក់ បាន ជាង ១០០ ផ្លាក ហើយ បាន ចំណូល ប្រមាណ ១លាន ដុល្លារ អាមេរិក ។
លោក ស៊ុន ចាន់ថុល បាន លើកឡើង ថា ការទិញ « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » នេះ មិន ត្រឹមតែ ងាយស្រួល សម្រាប់ ម្ចាស់ រថយន្ត នោះ ទេ តែ វា ចំណេញ ថែម ទៀត ផង ព្រោះ ពេល ដូរ រថយន្ត មិន បាច់ ចំណាយ ថ្លៃ ផ្លាកលេខ ទៀត នោះ ឡើយ ។
សូម បញ្ជាក់ ថា « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » ត្រូវបាន ប្រកាស ដាក់ លក់ ជា ផ្លូវការ កាលពី ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២០ កន្លងទៅ នេះ ខួប ៤១ ឆ្នាំ នៃ ការផ្តួលរំលំ របប ខ្មែរ ថ្ងៃ ដែល ពលរដ្ឋ ខ្មែរ រស់រាន មាន ជីវិត ឡើងវិញ ។
ផ្លាកលេខ នេះ មាន តម្លៃ ចាប់ពី ២លាន រៀល ឡើង ទៅ រហូតដល់ ១.០០០ លាន រៀល តែ សម្រាប់ ការដេញថ្លៃ អាចនឹង មាន តម្លៃ ច្រើន ជាង នេះ ។ « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » នេះ អាច ជ្រើសរើស និង កំណត់ ឈ្មោះ តាម ការចង់បាន លើក តែ ពាក្យ មិន សមរម្យ ឈ្មោះ ថ្នាក់ដឹកនាំ និង ទីតាំង ប្រវត្តិសាស្ត្រ ។
« ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » នេះ អ្នក ដែល ទិញ អាច រក្សាទុក ពេញ ជីវិត ដោយ គ្រាន់តែ កាត់ ឈ្មោះ ចេញ នៅពេល លក់ រថយន្ត ឬ គេ អាច លក់ ផ្លាកលេខ ពេល លក់ ទាំង រថយន្ត ក៏ បាន ។ ម្ចាស់ ផ្លាកលេខ ក៏ អាច រក្សា ផ្លាកលេខ នេះ ទុក ដល់ កូន ចៅ ផងដែរ ដោយ គ្រាន់តែ ធ្វើការផ្លាស់ប្តូរ ព័ត៌មាន អ្នក ដែល ត្រូវ បន្ត គ្រប់គ្រង ផ្លាកលេខ ប៉ុណ្ណោះ ។
គួរ ជម្រាប ថា ឧបទ្ទវហេតុ ខាង លើ ជា ឧទាហរណ៍ ថ្មី ចុងក្រោយ គេ មួយ នៃ ការប្រឈមមុខ គ្នា កៀក បែប នេះ រវាង កម្លាំង យោធា របស់ សហរដ្ឋ អាមេរិក និង របស់ រុស្ស៊ី នៅលើ ដែន សមុទ្រ ខណៈ ប្រមាណ ជា ០៧ ខែ មុន ហេតុការណ៍ ស្រដៀង គ្នា នេះ ក៏ បាន កើត មាន ឡើង ផងដែរ នៅឯ មហាសមុទ្រ ប៉ាស៊ីហ្វិក នៅពេល នាវា ចម្បាំង អាមេរិក និង នាវា ចម្បាំង រុស្ស៊ី បាន ជ្រុល ទៅ កៀក គ្នា ខ្លាំង ស្ទើរតែ បុក គ្នា ទៅ ៕
យោង តាម សេចក្តីថ្លែងការណ៍ នា ថ្ងៃសុក្រ នេះ របស់ ការិយាល័យ នាយក រដ្ឋមន្រ្តី អ៉ីរ៉ាក់ លោក Abdel Mahdi ក្នុង កំឡុង កិច្ចសន្ទានា តាម ខ្សែ ទូរស័ព្ទ ជាមួយ រដ្ឋមន្រ្តី ការបរទេស អាមេរិក លោក Mike Pompeo បាន ដាក់ សំណើ ថា អាមេរិក ត្រូវ បញ្ជូន ក្រុមការងារ មក ប្រទេស អ៉ីរ៉ាក់ ដើម្បី ចាប់ផ្តើម អនុវត្ត សេចក្តីសម្រេច របស់ សភា អ៉ីរ៉ាក់ ដែល បាន កំណត់ ឲ្យ កងកម្លាំង បរទេស ត្រូវ ដក ចេញ ទៅ វិញ ពី ក្នុង ទឹកដី របស់ អ៉ីរ៉ាក់ ក្រោយ ឈរ ជើង អស់ រយៈពេល ជាច្រើន ឆ្នាំ មកហើយ ។
( ភ្នំពេញ ) ៖ ខាងក្រោម គឺជា សំណុំ រូបភាព មួយចំនួន ដែល បង្ហាញ ពី ព្រឹត្តិការណ៍ នយោបាយ អន្តរជាតិ និង ស្ថានការណ៍ ជុំវិញ ពិភពលោក រួម ជាមួយ រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ព្រមទាំង ទិដ្ឋភាព នៅ តំបន់ ផ្សេង ៗ ដែល ត្រូវបាន ជ្រើសរើស សម្រាប់ ថ្ងៃសុក្រ ទី១០ ខែមករា ឆ្នាំ ២០២០ នេះ៖
សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០
១៖ ទីប្រឹក្សា ពិសេស អង្គការ សហប្រជាជាតិ៖ កម្ពុជា រីកចម្រើន និង អភិវឌ្ឍន៍ ហួស ពី ការស្មាន ( ចុច អាន )
២៖ ក្រសួង រៀបចំ ដែនដី ចេញ សេចក្តីសម្រេច ចាត់តាំង មន្រ្តី ត្រួតពិនិត្យ សំណង់ ទូទាំង ប្រទេស ( ចុច អាន )
៤៖ រដ្ឋបាល រាជធានី ភ្នំពេញ គ្រោង សាងសង់ ផ្លូវ ក្រោម ដី នៅ មហាវិថី សហព័ន្ធ រុស្ស៊ី ត្រង់ ចំណុច មុខ សាកលវិទ្យាល័យ ភូមិន្ទ ភ្នំពេញ និង វិទ្យាស្ថាន ភាសា បរទេស ( ចុច អាន )
៥៖ នៅ ថ្ងៃទី ១០ ខែមករា ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ មាន ធ្វើ សមយុទ្ធ ទ្រង់ទ្រាយ ធំ ពី ការសង្គ្រោះ ចំណាត់ ខ្មាំង លើ យន្តហោះ . សូម សាធារណជន កុំ ភាន់ ច្រឡំ ( ចុច អាន )
៦៖ បុគ្គលិក ណាហ្គាជិត១ ពាន់ នាក់ បន្ត ប្រមូលផ្តុំ តវ៉ា ដោយ មិន ទាន់ ទទួល ការសម្របសម្រួល ( ចុច អាន )
៧៖ ពលរដ្ឋ ស្រុក មង្គលបុរី មាន ទឹក ប្រើ វិញ ហើយ . ទេសរដ្ឋមន្ត្រី គន់ គីម អរគុណ រដ្ឋមន្ត្រី ធនធាន ទឹក និង អាជ្ញាធរ ពាក់ព័ន្ធ ( ចុច អាន )
២៖ ទីបំផុត សភា អាមេរិក « អនុម័ត ដំណោះស្រាយ រារាំង លោក ដូណាល់ ត្រាំ ធ្វើ សង្គ្រាម ជាមួយ អ៉ីរ៉ង់ » តែ ត្រូវ ឆ្លង ព្រឹទ្ធសភា ជា ចុងក្រោយ ( ចុច អាន )
៣៖ អ៉ីរ៉ង់ ចេញមុខ តវ៉ា និង ទាមទារ ភស្តុតាង ក្រោយ ត្រូវ អន្តរជាតិ ចោទ ថា យន្តហោះ ដឹក អ្នកដំណើរ របស់ អ៊ុយក្រែន ធ្លាក់ ដោយសារ មីស៊ីល ខ្លួន ( ចុច អាន )
៨៖ អូស្ត្រាលី បង្គាប់ ឱ្យ ប្រជាជន ២៤០.០០០ នាក់ ជម្លៀស ខ្លួន ទៅកាន់ កន្លែង មាន សុវត្ថិភាព ខណៈ ភ្លើង ឆេះ ព្រៃ គំរាមកំហែង កាន់តែ ខ្លាំង ( ចុច អាន )
គ្រឿងញៀន បំផ្លាញ អនាគត អ្នក ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១០ ខែ មក រា៖ បង្ក្រាប ២៨ ករណី ឃាត់ខ្លួន ៩១ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៨ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៦ករណី និង ជួញដូរ ២២ ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៩១ នាក់ ។
សាលាដំបូង រាជធានី ភ្នំពេញ បញ្ជាក់ ថា នៅក្នុង សវនាការ នោះ អាច ទទួល មនុស្ស ប្រមាណ ៣០ នាក់ ប៉ុណ្ណោះ ។
( បន្ទាយមានជ័យ )៖ ឧប នាយក រដ្ឋមន្ដ្រី កែ គឹម យ៉ាន អនុប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ក្នុង នាម សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា នឹង អញ្ជើញ សម្ពោធ ផ្លូវ មួយ ខ្សែ ប្រវែង ៤គីឡូម៉ែត្រ និង ប្រគល់ ផ្ទះ ១០៣ ខ្នង ជូន អតីត យុទ្ធជន នៅ តំបន់ ២២២២ ក្នុង ស្រុក ភ្នំស្រុក ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២០ ស្អែក នេះ ។
លោក គន់ គីម បាន បញ្ជាក់ ថា ឧប នាយក រដ្ឋមន្ដ្រី កែ គឹម យ៉ាន នឹង ឧបត្ថម្ភ បន្ថែម ទៀត ដើម្បី កសាង ផ្ទះ នៅ តំបន់ នេះ ឲ្យបាន ៣០៩ គ្រួសារ ដែល អតីត យុទ្ធជន កម្ពុជា កំពុងតែ មាន ការខ្វះខាត ផ្ទះ និង ដី ។ ទេសរដ្ឋមន្ដ្រី គន់ គីម បាន បន្ថែម ទៀត ថា ពិធី ប្រគល់ ស្អែក នេះ គឺជា លើក ទី២ ខណៈ ដែល លើក ទី១ ប្រគល់ បាន ៨០ ខ្នង ផ្ទះ ហើយ លើក ទី៣ នឹង ប្រគល់ ៣៦ ខ្នង ទៀត ។
បើ តាម ទេសរដ្ឋមន្ដ្រី គន់ គីម គម្រោង បន្ដ ទៅ ទៀត នោះ សម្ដេច តេជោ ហ៊ុន សែន នឹង ឧបត្ថម្ភ បន្ថែម ១០០ ខ្នង ផ្ទះ ទៀត ដើម្បីឲ្យ គ្រប់ ចំនួន ៣០៩ ខ្នង ស្មើនឹង ៣០៩ គ្រួសារ ដែល មាន ការខ្វះខាត ដើម្បី ផ្ដល់ ឱកាស ឲ្យ អតីត យុទ្ធជន បាន រស់ នៅ និង បង្កបង្កើន ផល នៅលើ ទឹកដី ថ្មី នៅ ខេត្ត បន្ទាយមានជ័យ ៕
ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ព្រម ជាមួយ អតីត សិស្សសាលា បាក់ទូក បាន នាំគ្នា ទៅ សួរសុខទុក្ខ មិត្ត រួម ជំនាន់ ដែល មាន ជម្ងឺ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ប្រទេស វៀតណាម
( វៀតណាម ) ៖ ក្នុង រយៈកាល កន្លងមក គេ តែង សង្កេតឃើញ ក្រុម អតីត មិត្ត រួម ជំនាន់ នៃ សាលា បាក់ទូក មួយ ក្រុម ដែល ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស មេបញ្ជាការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ តែង បង្ហាញ នូវ សកម្មភាព ទំនាក់ទំនង គ្នា យ៉ាង ជិតស្និត និង ចែករំលែក ជួយ ទុក្ខ ធុរៈ គ្នា ជាប់ ជាប្រចាំ មិន ដែល មាន ខាន នៅ ពេល ដែល មាន មិត្ត ណា ម្នាក់ របស់ ពួកគាត់ ជួប ការលំបាក ។
លើស ពី នេះ ពួកគាត់ តែង គៀង គគ្នា ប្រារព្ធ នូវ ពិធី ជួបជុំ អតីត មិត្ត រួម ជំនាន់ និង អតីត លោកគ្រូ អ្នកគ្រូ ជារៀងរាល់ ឆ្នាំ ព្រមទាំង បាន យកចិត្តទុកដាក់ ពី សុខ ទុក្ខ របស់ អតីត លោកគ្រូ អ្នកគ្រូ របស់ ពួកគាត់ ជាប់ ជាប្រចាំ មិន ដែល មាន ខាន ដូចគ្នា ។
ក្នុង ឱកាស សួរ សុខ ទុក្ខ នា ពេលនេះ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង តំណាង ឲ្យ អតីត សិស្ស មិត្ត រួម ជំនាន់ សាលា បាក់ទូក បាន នាំយក នូវ ថវិកា ចំនួន ៤៥០០ ដុល្លារ ដែល បាន មក ពី ការចូលរួម របស់ អតីត សិស្ស មិត្ត រួម ជំនាន់ ប្រគល់ ជូន អ្នកស្រី រឿន សូនី ទុក ជា ការដោះស្រាយ សម្រាល បន្ទុក ព្យាបាល ជម្ងឺ របស់ គាត់ ផងដែរ ។
សកម្មភាព យកចិត្តទុកដាក់ និង ចែករំលែក ធនធាន ជួយ មិត្ត ដែល មាន អាសន្ន ទាំងនេះ គឺជា មនោសញ្ចេតនា និង ជា គោលការណ៍ ក្នុង ក្រុម ស្រប តាម ពាក្យស្លោក ដែល ពួកគាត់ បាន រួមគ្នា បង្កើតឡើង ថា « សាមគ្គី មិត្តភាព បង្កើត ចិត្តរមនា ចែករំលែក ជួយ គ្នា គ្រប់គ្រា លំបាក »៕ អនុព័ន្ធ យោធា ចិន ថ្មី ប្រចាំ កម្ពុជា នឹង ខិតខំ ប្រឹងប្រែង ឲ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ជំរុញ ឲ្យ ទំនាក់ទំនង មិត្តភាព ដូច ដែក ថែប រវាង ប្រទេស ទាំង ពីរ កាន់តែ ខ្លាំង ឡើង ថែម ទៀត
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន អគ្គ មេបញ្ជាការ នៃ កងយោធពល ខេមរភូមិន្ទ នៅ រសៀល ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន អនុញ្ញាតឲ្យ ប្រធាន ការិយាល័យ អនុព័ន្ធ យោធា ចិន ចាស់ និង ថ្មី ចូល ជួប ជម្រាប លា និង សម្តែង ការគួរសម នៅ បន្ទប់ សវនាការ អគ្គ បញ្ជាការដ្ឋាន ។
ឱកាស នោះ នាយ ឧត្ដមសេនីយ៍ វង្ស ពិសេន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ស្នាដៃ ដែល លោក វរសនីយ៍ ឯក លី នីង យ៉ា អនុព័ន្ធ យោធា ចិន ចាស់ សម្រេចបាន នា ពេល កន្លងមក និង មាន ជំនឿ ថា ទៅ ថ្ងៃ ខាងមុខ ក្រោម កិច្ច ដឹកនាំ បន្ត របស់ លោក វរសេនីយ៍ ឯក លី ជីង ហ្វឹង ក្នុង តួនាទី ជា អនុព័ន្ធ យោធា ថ្មី ប្រចាំ កម្ពុជា នឹង ដំណើរការ យ៉ាង រលូន បន្ត ទៀត ដើម្បីឲ្យ ចំណង មិត្តភាព សាមគ្គីភាព កិច្ចសហប្រតិបត្តិការ រវាង រដ្ឋាភិបាល កងទ័ព និង ប្រជាជន ប្រទេស ទាំង ពីរ កាន់តែ ល្អ ប្រសើរ ទ្វេ ឡើង ថែម ទៀត ។
នាយ ឧត្ដមសេនីយ៍ អគ្គ មេបញ្ជាការ បាន ថ្លែងអំណរ អគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល បាន ជួយ ជ្រោមជ្រែង ដល់ ប្រទេស កម្ពុជា ជារៀងរហូតមក ក្នុង នោះ លើ វិស័យ យោធា ចិន បាន ជួយ ទាំង មធ្យោបាយ សម្ភារ បរិក្ខារ និង បណ្តុះបណ្តាល ធនធាន មនុស្ស ជារៀងរាល់ ឆ្នាំ ដែល ជំនួយ ទាំងនេះ គឺ បង្ហាញ ឱ្យ ឃើញ ថា ចិន នៅជិត កម្ពុជា ជានិច្ច ។
ជា កិច្ច ឆ្លើយតប លោក វរសេនីយ៍ ឯក លី នីង យ៉ា បាន ថ្លែងអំណរគុណ នាយ ឧត្ដមសេនីយ៍ អគ្គ មេបញ្ជាការ ដែល បាន ផ្តល់ វេលា ដ៍ មាន តម្លៃ ឲ្យ លោក បាន ចូល ជួប សម្តែង ការគួរសម និង បង្ហាញ ខ្លួន ចំពោះ ប្រធាន ការិយាល័យ អនុព័ន្ធ យោធា ថ្មី ដែល ត្រៀម ទទួល តំណែង ពី លោក ។
លោក វរសេនីយ៍ ឯក លី នីង យ៉ា បាន គូសបញ្ជាក់ ថា ក្នុង រយៈពេល ៥ឆ្នាំ មក នេះ លោក មាន សេចក្ដីសោមនស្ស ជាខ្លាំង ដោយ បាន រួមចំណែក នៅក្នុង ការអភិវឌ្ឍន៍ កិច្ចសហប្រតិបត្តិការ រវាង កងទ័ព ប្រទេស ទាំង ពីរ មាន ភាពល្អ ប្រសើរ ជាពិសេស ក្នុង នាមជា ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ។ លទ្ធផល ល្អ ប្រសើរ នេះ ក៏ អាស្រ័យ ដោយ មាន ការយកចិត្តទុកដាក់ គាំទ្រ និង ផ្តល់ កិច្ចសហការ ពេញ ទំហឹង ពីសំណាក់ នាយ ឧត្ដមសេនីយ៍ អគ្គ មេបញ្ជាការ ផងដែរ ។
លោក វរសេនីយ៍ ឯក លី ជីង ហ្វឹង ប្រធាន ការិយាល័យ អនុព័ន្ធ យោធា ថ្មី បាន លើកឡើង ថា ក្នុង កិច្ច ទំនាក់ទំនង ជា បងប្អូន នៃ បរិបទ ថ្មី នេះ អាស្រ័យ ដោយ កងទ័ព ប្រទេស ទាំង ពីរ មាន ចំណុច ឯកភាព ជាច្រើន ជាពិសេស កងទ័ព កើតឡើង ពី ប្រជាជន និង ធ្វើ អ្វី ៗ ដើម្បី ប្រជាជន ។
នៅក្នុង ឱកាស នោះ ដែរ លោក វរសេនីយ៍ ឯក លី ជីង ហ្វឹង ក៏ បាន បង្ហាញ ពី ការប្តេជ្ញាចិត្ត នៅ ចំពោះ មុខ នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ ថា នៅក្នុង ការបំពេញ បេសកកម្ម ការ ទូត នៅ កម្ពុជា លោក នឹង ខិតខំ ប្រឹងប្រែង ឲ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ធ្វើ យ៉ាងណា ជំរុញ ឲ្យ ទំនាក់ទំនង មិត្តភាព ដូច ដែក ថែប រវាង ប្រទេស ទាំង ពីរ កាន់តែ ពង្រឹង ពង្រីក ខ្លាំង ឡើង ថែម ទៀត ៕
( ភ្នំពេញ ) ៖ « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » គ្រាន់តែ ជា ការបង្កើត ជម្រើ បន្ថែម សម្រាប់ អ្នកប្រើប្រាស់ រថយន្ត តែ ប៉ុណ្ណោះ ពោល ទោះបី មាន « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » ផ្លាកលេខ ធម្មតា នៅតែ មាន លក់ សម្រាប់ អ្នកប្រើប្រាស់ រថយន្ត ទូទៅ ។ ម្ចាស់ រថយន្ត មិន មែន តម្រូវ ឱ្យ ត្រូវតែ ប្រើ « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » នោះ ឡើយ ។ នេះ ជា ការបញ្ជាក់ របស់ លោកស្រី កុយ សុដានី រដ្ឋលេខា ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
« ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » ដែល ជា ប្រភេទ ផ្លាកលេខ ថ្មី មួយ ដែល អនុញ្ញាត ម្ចាស់ ផ្លាកលេខ អាច គ្រប់គ្រង ពេញ មួយ ជីវិត នោះ ត្រូវបាន ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ប្រកាស ដាក់ លក់ ជា ផ្លូវការ កាលពី ថ្ងៃទី ០៧ ខែមករា ឆ្នាំ ២០២០ កន្លងទៅ នេះ ។ បន្ទាប់ពី ការប្រកាស ដាក់ លក់ មាន ប្រជាពលរដ្ឋ ខ្លះ មាន ការយល់ ច្រឡំ ថា ម្ចាស់ រថយន្ត តម្រូវឱ្យ ទិញ បន្ថែម ផ្លាកលេខ ប្រភេទ នេះ ដែល ធ្វើឱ្យ ម្ចាស់ រថយន្ត នឹង ត្រូវ ចំណាយ កាន់តែ ច្រើន ។
« ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » នេះ បើ ទោះបី ថា មាន ប្រជាពលរដ្ឋ ខ្លះ មាន ការប្រតិកម្ម ឬ រិះគន់ លើ បញ្ហា ផ្សេង ៗ ។ តែ ក៏ ទទួលបាន ការគាំទ្រ និង ទិញ ពី ម្ចាស់ រថយន្ត មួយចំនួន ផងដែរ ។ បើ តាម លោកស្រី កុយ សុដានី ក្រោយពេល ប្រកាស លក់ តែ ពីរ ថ្ងៃ មាន អ្នកទិញ រហូតដល់ ៤២ ផ្លាក និង ទទួលបាន ថវិកា ប្រមាណ ជា ២២ម៉ឺន ដុល្លារ ។ ថវិកា ដែល ទទួលបាន ពី ការលក់ ផ្លាកលេខ នេះ ត្រូវបាន ដាក់ ជា ថវិកា របស់ ជាតិ ដើម្បី បំពេញការចំណាយ របស់ រដ្ឋ ។
ផ្លាកលេខ នេះ មាន តម្លៃ ចាប់ពី ២លាន រៀល ឡើង ទៅ រហូតដល់ ១.០០០ លាន រៀល តែ សម្រាប់ ការដេញថ្លៃ អាចនឹង មាន តម្លៃ ច្រើន ជាង នេះ ។ « ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » នេះ អាច ជ្រើសរើស និង កំណត់ ឈ្មោះ តាម ការចង់បាន ។ លើក តែ ពាក្យ មិន សមរម្យ ឈ្មោះ ថ្នាក់ដឹកនាំ និង ទីតាំង ប្រវត្តិសាស្ត្រ ។ សម្រាប់ តម្លៃ វិញ លេខ ឬ តួ អក្សរ ៨ខ្ទង់ មាន តម្លៃ ធូរ ថ្លៃ តែ បើ ចំនួន លេខ ឬ តួ អក្សរ កាន់តែ តិច តម្លៃ ក៏ កាន់តែ ថ្លៃ ផងដែរ ។
« ផ្លាកលេខ ពិសេស ផ្ទាល់ខ្លួន » នេះ អ្នក ដែល ទិញ អាច រក្សាទុក ពេញ ជីវិត ដោយ គ្រាន់តែ កាត់ ឈ្មោះ ចេញ នៅពេល លក់ រថយន្ត ឬ គេ អាច លក់ ផ្លាកលេខ ពេល លក់ រថយន្ត ក៏ បាន ។ ម្ចាស់ ផ្លាកលេខ ក៏ អាច រក្សា ផ្លាកលេខ នេះ ទុក ដល់ កូន ចៅ ផងដែរ ដោយ គ្រាន់តែ ធ្វើការផ្លាស់ប្តូរ ព័ត៌មាន អ្នក ដែល ត្រូវ បន្ត គ្រប់គ្រង ផ្លាកលេខ ប៉ុណ្ណោះ ៕ ទេសរដ្ឋមន្ដ្រី គន់ គីម អញ្ជើញ ប្រកាស ទទួលស្គាល់ ប្រធាន អនុប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត ប៉ៃលិន និង ប្រគល់ ប័ណ្ណ ប .ស. ស ជូន គ្រួសារ ពលី
( ប៉ៃលិន ) ៖ ទេសរដ្ឋមន្ដ្រី គន់ គីម អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ប្រកាស ទទួលស្គាល់ ប្រធាន និង អនុប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត ប្រគល់ ប័ណ្ណ មូលនិធី សមធម៌ សុខាភិបាល ជូន គ្រួសារ ជន ពលី មរណៈ និង ប្រគល់ ផ្ទះ ជូន គ្រួសារ អតីត យុទ្ធជន ចំនួន ៣គ្រួសារ នៅ ខេត្ត ប៉ៃលិន ។
ទេសរដ្ឋមន្ត្រី គន់ គីម ក៏ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ដល់ ថ្នាក់ដឹកនាំ សមាគម គ្រប់ ថ្នាក់ គ្រប់ ផ្នែក ដែល នៅក្នុង រយៈពេល ១ ឆ្នាំ ២០១៩ កន្លងមក នេះ បាន ជំរុញ សកម្មភាព សមាគម មាន ដំណើរការវិវត្តន៍ គួរឲ្យ កត់សម្គាល់ ។ ក្នុង នោះ កិច្ចសហការ ដឹកនាំ សមាសភាព ចម្រុះ កិច្ច ពង្រឹង អង្គការ ចាត់តាំង ថ្នាក់ ខេត្ត ក្រុង ស្រុក ឃុំ ដល់ ភូមិ ។
ជាមួយគ្នា នេះ អតីត យុទ្ធជន ទាំង ៣គ្រួសារ បាន គោរព ថ្លែងអំណរគុណ សម្តេច ទាំង ពីរ ដែល ផ្ដល់ ផ្ទះ ជូន ពួកគាត់ ធ្វើឲ្យ ជីវភាព រស់ នៅ របស់ ពួកគាត់ មាន លំនឹង និង សូម ជូនពរ ឲ្យ សម្តេច ទាំង ពីរ ព្រមទាំង ក្រុមគ្រួសារ ជួបប្រទះ ពុទ្ធ ពរ ទាំង បួន ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ លោក ស សុខា សំណូមពរ ដល់ អ្នក ពាក់ព័ន្ធ បន្ត ចូលរួម ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង ការជួញដូរ មនុស្ស គ្រប់ ទម្រង់
( ភ្នំពេញ ) ៖ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ នៅ សាល ប្រជុំ ក្រសួង អប់រំ យុវជន និង កីឡា មាន រៀបចំ សិក្ខាសាលា ស្តីពី វឌ្ឍនភាព នៃ ការអនុវត្ត ផែនការ យុទ្ធសាស្រ្ត បង្ការ ទប់ស្កាត់ អំពេី ជួញដូរ មនុស្ស និង គ្រោះថ្នាក់ បង្ក ដោយ ការប្រេី ប្រាស់ គ្រឿងញៀន ខុស ច្បាប់ ក្រោម អធិបតីភាព លោក ស សុខា រដ្ឋលេខាធិការ តំណាង បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្រ្តី ក្រសួង អប់រំ យុវជន និង កីឡា ។
ពិធី នេះ ក៏ បាន ប្រព្រឹត្តិ ទៅ ដោយ មាន ការអញ្ជេីញ ចូលរួម ពី រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ អគ្គ លេខាធិការ ជា តំណាង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង គណៈកម្មាធិការ ជាតិ ប្រឆាំង ការជួញដូរ មនុស្ស និង តំណាង មន្ទីរ អង្គភាព ជា សមាជិក គណកម្មាធិការ ប្រយុទ្ធ ប្រឆាំង គ្រឿញៀន និង ប្រឆាំង ជួញដូរ មនុស្ស ក្នុង វិស័យ អប់រំ ទាំង ២៥ រាជធានី - ខេត្ត ។
ក្នុង ឱកាស នោះ លោកស្រី បណ្ឌិត សឿ សុជាតា អនុ រដ្ឋលេខាធិការ ប្រធាន ក្រុមការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន និង ប្រឆាំង ការជួញដូរ មនុស្ស ប្រចាំ ក្រសួង អប់រំ យុវជន និង កីឡា បាន ធ្វេី សេចក្តីរាយការណ៍ ពី វឌ្ឍនភាព ការងារ បង្ការ ទប់ស្កាត់ បញ្ហា គ្រឿងញៀន និង បញ្ហា ជួញដូរ មនុស្ស សំដៅ ពង្រឹង គុណភាព ប្រសិទ្ធភាព ធន ធន មនុស្ស នៅ កម្ពុជា ។
ព្រម ជាមួយគ្នា នោះ លោក សាម៉ន បណ្ឌិត អនុ រដ្ឋលេខាធិការ ក្រសួង ព័ត៌មាន បាន ថ្លែង ថា វិស័យ ព័ត៌មាន ដេីរ តួនាទី សំខាន់ ក្នុង ការចូលរួម ផ្សាយ ព័ត៌មាន ចំណេះដឹង ទូទៅ នានា និង ច្បាប់ ពាក់ព័ន្ធ បញ្ហា គ្រឿងញៀន និង បញ្ហា ជួញដូរ មនុស្ស ដល់ ប្រជាពលរដ្ឋ បាន យល់ដឹង ។
ទន្ទឹម គ្នា នេះ ដែរ លោកស្រី ឧត្តមសេនីយ៍ ឯក ប៉ុន សំខាន់ អគ្គ លេខាធិការ គណកម្មាធិការ ជាតិ ប្រឆាំង ការជួញដូរ មនុស្ស បាន ឲ្យដឹង ថា អំពេី ជួញដូរ មនុស្ស គឺជា បទល្មេី ស ឧក្រិដ្ឋកម្ម ឆ្លង ដែន មាន អង្គការ ចាត់តាំង ដែល តម្រូវឲ្យ មាន ការប្រឆាំង ទប់ស្កាត់ ការជួញដូរ និង សង្រ្គោះ ជនរងគ្រោះ ពី អំពេី ជួញដូរ គ្រប់ ទម្រង់ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ អគ្គ លេខាធិការ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន បាន ថ្លែង សាទរ ពី វឌ្ឍនភាព និង ថ្លែងអំណរគុណ ដល់ ក្រសួង អប់រំ យុវជន និង កីឡា និង ក្រសួង ពាក់ព័ន្ធ ដែល បាន ចូលរួម ប្រយុទ្ធ ប្រឆាំង បង្ការ ទប់ស្កាត់ បញ្ហា គ្រឿងញៀន ដេីម្បី ប្រយោជន៍ រួម គោលដៅ តែ មួយ គឺ កសាង បាន នូវ ធនធាន មនុស្ស ប្រកបដោយ ប្រសិទ្ធភាព ជាធនធាន បន្ត វេន ដ៏ មាន សក្តានុពល របស់ ប្រទេសជាតិ ។
ក្នុង ចំណាប់អារម្មណ៍ របស់ មន្ទីរ ក្រសួង អប់រំ យុវជន និង កីឡា ខេត្ត កោះកុង បន្ទាយមានជ័យ បាត់ដំបង ព្រៃវែង រាជធានី ភ្នំពេញ កណ្តាល និង អង្គការ ភ្លេន Plan សុទ្ធតែ បាន បង្ហាញ ពី ឆន្ទៈ ចូលរួម បង្ការ ទប់ស្កាត់ បញ្ហា គ្រឿងញៀន និង បញ្ហា ជួញដូរ មនុស្ស ដេីម្បី អនាគត កូន ចៅ យេីង ។
លោក ស សុខា បាន ថ្លែងអំណរគុណ ដល់ អ្នក ពាក់ព័ន្ធ ដែល បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ផ្សព្វផ្សាយ បង្ការ ទប់ស្កាត់ បញ្ហា គ្រឿងញៀន និង ការជួញដូរ មនុស្ស និង សំណូមពរ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច អ្នក ពាក់ព័ន្ធ ទាំងអស់ យុវកាយ រឹទ្ធិ កាកបាទ ក្រហម សិល្បករ សិល្បការិនី ពិធី ករ ពិធី ការិនី សង្គម ស៉ី វិល សូម បន្ត ចូលរួម ទាំងអស់ គ្នា ឲ្យបាន សកម្ម ជាប់ ជាប្រចាំ ដូច ភ្លៀង រលឹម ដេីម្បី សុវត្ថិភាព សហគមន៍ ៕
មកទល់ ពេលនេះ វា មិន មាន ការរីករាលដាល លឿន នោះ ទេ ដោយ អ្នកជំងឺ ទាំង ៥៩ នាក់ មាន ផ្ទុក មេរោគ ថ្មី នេះ ចាប់ផ្ដើម នៅ ចន្លោះ ពី ថ្ងៃទី ១២ ខែធ្នូ និង ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០១៩ ហើយ វា មិន មាន ករណី ឆ្លង ថ្មី ត្រូវបាន រាយការណ៍ នោះ ទេ ។ ប៉ុន្តែ ការព្រួយបារម្ភ នៅ កើតមាន ដដែល ថា មេរោគ នេះ អាចនឹង ឆ្លង ដល់ មនុស្ស រាប់ លាន នាក់ ដែល ធ្វើដំណើរ ទៅ ស្រុក កំណើត កំឡុង បុណ្យ ចូល ឆ្នាំ ចិន នៅ ចុង ខែមករា នេះ ។
អ្នកជំងឺ ទាំង ៥៩ នាក់ ត្រូវបាន ដាក់ តាមដាន និង ព្យាបាល ដាច់ ឆ្ងាយ ពី គេ ឯង ដើម្បី កាត់បន្ថយ ហានិភ័យ រីករាលដាល ហើយ បើ តាម អាជ្ញាធរ ចិន មនុស្ស ច្រើន ជាង ១៥០ នាក់ ដែល បាន ទាក់ទង ដោយ ផ្ទាល់ ជា អ្នកជំងឺ កំពុង ត្រូវបាន តាមដាន ។ មិន តែ ប៉ុណ្ណោះ អាជ្ញាធរ ចិន ក៏ បាន ដំឡើង ឧបករណ៍ វាស់ កម្ដៅ ដើម្បី ត្រួតពិនិត្យ លើ អ្នកដំណើរ ផងដែរ ខណៈ ផ្សារ លក់ គ្រឿង សមុទ្រ ត្រូវបាន បិទ ទ្វារ ជា បណ្ដោះអាសន្ន ដើម្បី សម្អាត កម្ចាត់ មេរោគ ។
* ការព្រួយបារម្ភ របស់ អ្នកជំនាញ ចំពោះ វីរុស នេះ
ប្រភព៖ BBC ( ថ្ងៃសុក្រ ទី១០ ខែមករា ឆ្នាំ ២០២០ ) អភិបាល ខេត្ត កំពង់ចាម ចុះ ពិនិត្យ លទ្ធភាព សាងសង់ ផ្លូវ ជូន ពលរដ្ឋ នៅ ស្រុក បាធាយ ប្រវែង៤.០០០ ម៉ែត្រ
( កំពង់ចាម ) ៖ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ ក្រុមការងារ មន្ត្រី ជំនាញ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ចុះ ពិនិត្យ សិក្សា លទ្ធភាព សាងសង់ ផ្លូវ ជូន ប្រជាពលរដ្ឋ ប្រវែង ៤០០០ ម៉ែត្រ ស្ថិត នៅ ភូមិ មេ ព្រីង ឃុំ មេ ព្រីង ស្រុក បាធាយ ខេត្ត កំពង់ចាម ។
ប៉ុន្តែ ទោះជា យ៉ាង នោះ ក្តី នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា នេះ លោក អភិបាល ខេត្ត កំពង់ចាម បាន ដឹកនាំ ក្រុមការងារ ដើម្បី ចុះ សិក្សា ពិនិត្យមើល លទ្ធភាព ជាក់ស្ដែង ដើម្បី ដោះស្រាយ សាងសង់ ផ្លូវ ជូន ប្រជាពលរដ្ឋ ។
មន្ត្រី សាលា ខេត្ត ដឹង ទៀត ថា ក្នុង បេសកកម្ម រយៈពេល មួយ ថ្ងៃ របស់ អាជ្ញាធរ ខេត្ត កំពង់ចាម នេះ លោក អ៊ុន ចាន់ ដា បាន ចុះ ពិនិត្យ ស្ថានភាព លើ កិច្ចការ ផ្សេង ទៀត ដូច ជា៖ បញ្ហា សន្តិសុខ និង ការរស់នៅ របស់ ប្រជាពលរដ្ឋ នៅ ឃុំ កង តាណឹង ស្រុក កង មាស ផងដែរ ។ បន្ទាប់មក លោក អភិបាល ខេត្ត បាន បន្ត ដំណើរ ចុះ ពិនិត្យមើល ផ្លូវ បេតុង ដែល សាងសង់ រួច ប្រវែង ១៩៥០ ម៉ែត្រ បាន សាងសង់ រួច ស្ថិត នៅ ភូមិ អូរម៉ាល់ ក្នុង ស្រុក បាធាយ និង ពិនិត្យមើល លទ្ធភាព ផ្សេង ៗ ទៀត ដើម្បី សម្រួល ដល់ ការរស់នៅ របស់ ប្រជាពលរដ្ឋ នៅ តំបន់ នោះ ៕
ក្រុមហ៊ុន លក់ សម្ភារ ប្រើប្រាស់ ក្នុង ផ្ទះ ម៉ាក ល្បី ៗ នឹង បើក ដំណើរការ ក្នុង ពេល ឆាប់ ៗ នេះ ជាមួយនឹង ការបញ្ចុះ តម្លៃ ៣០%
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន មេហ្គាឌីស ជា ក្រុមហ៊ុន ឈាន មុខ គេ មួយ ដែល មាន បទពិសោធន៍ ជិត ១០ឆ្នាំ មកហើយ ក្នុង ការនាំចូល និង ចែកចាយ ផលិតផល ម៉ាក ល្បី ៗ ពី ក្រៅ ប្រទេស ដែល ផ្តោត សំខាន់ លើ សម្ភារ ប្រើប្រាស់ ក្នុង ផ្ទះ និង សណ្ឋគារ ម៉ាក ល្បី ៗ នឹង ចាប់ផ្តើម បើក ដំណើរការ ផ្លូវការ នៅ នៅ ថ្ងៃទី ១៧ ខែមករា ឆ្នាំ ២០២០ ខាងមុខ នេះ ដែល មាន ទីតាំង នៅក្នុង ផ្សារ បាយ័ន ( ជាន់ ទី១ ) ទួលគោក ។
ក្នុង ឱកាស បើក ដំណើរការ នេះ អតិថិជន ទាំងអស់ គ្នា អាច រីករាយ ក្នុង ការទិញ ទំនិញ គុណភាព ខ្ពស់ ដ៏ សម្បូរបែប ជាមួយនឹង ម៉ាក ល្បី ៗ ដែល មាន គុណភាព ខ្ពស់ ជាមួយនឹង ការបញ្ចុះ តម្លៃ រហូតដល់ ៣០% គ្រប់ មុខ ទំនិញ ទាំងអស់ ជាមួយនឹង ការបង្វិល កង សំណាង យក រង្វាន់ ភ្លាម ៗ ។ កាន់តែ ពិសេស សម្រាប់ អតិថិជន ១០០ នាក់ ដំបូង អាច ទិញ ទំនិញ តម្លៃ ត្រឹមតែ ១ដុល្លា ប៉ុណ្ណោះ ជារៀងរាល់ ថ្ងៃ ។
ត្រឹមតែ ១ ថ្ងៃ ប៉ុណ្ណោះ ក្រុមហ៊ុន ស៊ុន ស៊ី ម៉ិចកូ ប្រកាស បញ្ចុះ តម្លៃ ពិសេស ជាង គេ បំផុត សម្រាប់ សម្ភារ បរិក្ខារ ផ្ទះបាយ
( ភ្នំពេញ ) ៖ ត្រឹមតែ ១ ថ្ងៃ តែ ប៉ុណ្ណោះ សម្រាប់ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២០ ស្អែក នេះ ក្រុមហ៊ុន ស៊ុន ស៊ី ម៉ិចកូ បាន រៀបចំ ការផ្តល់ ជូន ពិសេស សម្រាប់ អតិថិជន ៥០ នាក់ ដំបូង នឹង មាន សិទ្ធិ ទិញ ផលិតផល ៤មុខ ក្នុង តម្លៃ កាន់តែ ពិសេស ជាង គេ បំផុត ផងដែរ ។
ដើម្បី អបអរ ក្នុង ឱកាស ពិធី បុណ្យ ចូល ឆ្នាំ ចិន ក្រុមហ៊ុន ស៊ុន ស៊ី ម៉ិចកូ ក៏ នឹង ផ្តល់ ជូន ការបញ្ចុះ តម្លៃ ទៅ លើ បរិក្ខារ ផ្ទះបាយ ជាច្រើន ប្រភេទ ដូចជា ចង្ក្រាន ហ្គាស ឆ្នាំង ដាំ បាយ ម៉ាស៊ីន ក្រឡុក បំពង់ ទឹក ក្តៅ ចង្ក្រាន បង្កប់ ម៉ាស៊ីន បឺត ផ្សែង ម៉ាស៊ីន បំពង ម៉ាស៊ីន អាំង សាច់ ម៉ាស៊ីន ដុត មាន់ និង បរិក្ខារ ជាច្រើន មុខ ទៀត ដែល សុទ្ធសឹង ជា ម៉ាក ល្បី ៗ និង មាន ប្រជាប្រិយភាព នៅលើ ទីផ្សារ អឺរ៉ុប និង អាស៊ី ។
ដើម្បី ធានា ដល់ ការប្រើប្រាស់ និង ការពារ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ធ្វើដំណើរ ឆ្លងកាត់ រដ្ឋបាល ខេត្ត ក្រចេះ នឹង តម្លើង បារ៉ាស់ បិទ ចរាចរណ៍ រថយន្ដ ធុន ធំ គ្រប់ ប្រភេទ កម្ពស់ ២.៥ម៉ែត្រ កាត់ ទទឹង ស្ពាន ចំនួន ៤កន្លែង រួម មាន៖ ស្ពាន អណ្ដែង ដួន និង ស្ពាន ក្រគរ ស្ថិត ក្នុង ក្រុង ក្រចេះ . ស្ពាន កាំពី ស្ថិត ក្នុង ស្រុក ចិត្រ បុរី និង ស្ពាន អាហារ ស្ថិត ក្នុង ស្រុក សំបូរ ៕
ក្បាច់គុន ល្បុក្កតោ និង ល្ខោន ខោល ត្រូវ បើក សម្តែង ដើម្បី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៤១ ឆ្នាំ ជ័យជម្នះ ៧ មករា នៅ ខេត្ត កំពង់ឆ្នាំង
ការបើក សម្តែង ក្បាច់គុន ល្បុក្កតោ កម្ពុជា និង ល្ខោន ខោល នេះ ត្រូវបាន ធ្វើឡើង នៅ ដើម សប្តាហ៍ នេះ ក្រោម វត្តមាន សម្តេច ចៅហ្វា វាំង វរ វៀង ជ័យ អធិបតី ស្រឹង្គា គង់ សំអុល ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ព្រះបរម រាជ រាំង នៅ សួន កុមារ មុខ សាលា ខេត្ត កំពង់ឆ្នាំង ដែល បាន រៀបចំ ដោយ ក្រុមការងារ បណ្ឌិត សភា គុន ល្បុក្កតោ កម្ពុជា និង ដឹកនាំ ដោយ លោកគ្រូ តា ក្រមា មាស សាន គឹម ស៊ាន ។
គោលបំណង នៃ ការសម្តែង នេះ មាន ២យ៉ាង រួម មាន ទី១៖ ចូលរួម អបអរសាទរ ថ្ងៃ បុណ្យ ខួបកំណើត ទី២ របស់ យើង ទាំងអស់ គ្នា និង ទី២៖ ផ្សព្វផ្សាយ អំពី កេរមរតក វប្បធម៌ ជាតិ ដែល ដូនតា ខ្មែរ បាន បន្សល់ទុក ជូន កូន ចៅ ជំនាន់ ក្រោយ ។
សូម បញ្ជាក់ ជូន ផងដែរ ថា គ្រូបង្ហាត់ ទាំង ៨រូប នេះ បាន ទទួល ការបណ្តុះបណ្តាល ត្រឹមត្រូវ ពី បណ្ឌិត សភា គុន ល្បុក្កតោ កម្ពុជា ដែល ការបង្ហាត់ បង្រៀន នៅ បណ្ឌិត សភា គុន ល្បុក្កតោ កម្ពុជា គឺ ដើម្បី ធានា បាន ថា ក្បាច់គុន ឬ ស្នៀត ដែល បង្ហាត់ សិស្ស ត្រឹមត្រូវ តាម ក្បួន ខ្នាត ដែល ត្រូវ អភិរក្ស ដើម្បី រក្សា បាន នូវ អត្តសញ្ញាណ វប្បធម៌ ជាតិ ដែល កម្ពុជា កំពុងតែ ដាក់ ស្នើសុំ ចុះបញ្ជី ជា បេតិភណ្ឌ អរូបី របស់ មនុស្សជាតិ នៅ អង្គការ យូនេស្កូ ។
ជុំវិញ ការចោទប្រកាន់ នេះ ស្ដ្រី ឈ្មោះ ហុក មករា បាន ឲ្យដឹង ថា ខ្លួន និង ម្ចាស់ លុយ គឺជា អ្នក ស្គាល់ រាប់អាន គ្នា ហើយ ខ្លួន សន្យា ជាថ្មី ថា នឹង សង ប្រាក់ ទាំងអស់ ឲ្យ រួចរាល់ នៅ បំណាច់ ខែមករា ឆ្នាំ ២០២០ នេះ ។
បើ តាម ម្ចាស់ បំណុល នា ពេល កន្លងទៅ កូន បំណុល រូប នេះ ធ្លាប់ បាន ចេញ សែក ជូន ខ្លួន ផងដែរ ប៉ុន្តែ សែក នោះ មិន មាន សាច់ប្រាក់ ឡើយ ដែល លោក អាច ប្តឹង ចាត់ វិធានការរតាម ច្បាប់ បាន ។
ប៉ុន្ដែ ទោះជា យ៉ាងណា ក៏ដោយ ម្ចាស់ បំណុល បាន បញ្ជាក់ ថា ស្ដ្រី ហុក មករា តែងតែ សន្យា បែប នេះ ជា រហូតមក ហើយ តែ មិន ដែល អនុវត្ត នោះ ឡើយ ដូច្នេះ ម្ចាស់ បំណុល ថា នឹង ដាក់ពាក្យ ប្ដឹង ទៅ តាម ផ្លូវ ច្បាប់ បើសិន ស្ដ្រី ហុក មករា មិន ព្រម សង ប្រាក់ នៅ ចុង ខែ នេះ ៕ អាជ្ញាធរ ខណ្ឌ បឹងកេងកង ចុះ ប្រមូល សំរាម ក្រោយ កម្មករ ស៊ីន ទ្រី ធ្វើ កូដកម្ម កាលពី យប់ មិញ ទាមទារ បើកប្រាក់ ឈប់ ប្រចាំ ឆ្នាំ
( ភ្នំពេញ ) ៖ បន្ទាប់ពី កម្មករ ស៊ីន ទ្រី ធ្វើ កូដកម្ម កាលពី យប់ មិន បញ្ចេញ កម្លាំង មក ប្រមូល សំរាម តាម មូលដ្ឋាន នានា ក្នុង រាជធានី ភ្នំពេញ មក នោះ ធ្វើឲ្យ សំរាម កកស្ទះ តាម ខណ្ឌ នោះ ទើប នៅ ព្រឹក ព្រលឹម ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ នេះ លោក ធឹម សំអាន អភិបាល ខណ្ឌ បឹងកេងកង ដឹកនាំ កម្លាំង ចម្រុះ ចុះ ធ្វើ អនាម័យ បរិស្ថាន ដោយ ប្រមូល សំរាម នៅ តាម ដងផ្លូវ នានា និង តាម ដង មហាវិថី នានា នៅក្នុង មូលដ្ឋាន ខណ្ឌ បឹងកេងកង ។
លោក ធឹម សំអាន បាន ឲ្យដឹង ថា កម្លាំង សមត្ថកិច្ច អាជ្ញាធរ ខណ្ឌ សង្កាត់ និង កម្លាំង នៅ តាម បណ្ដា ផ្សារ នីមួយ ៗ ចុះ មក ប្រមូល និង ដឹកជញ្ជូន សំរាម តាម ដងផ្លូវ និង តាម ដង មហាវិថី នានា ដែល គេ យកមក ចាក់ គរ តាម ចិញ្ចើមផ្លូវ និង តាម ដេរ ប៉ូសំរាម ក្នុង មូលដ្ឋាន ខណ្ឌ បឹងកេងកង នៃ រាជធានី ភ្នំពេញ ដែល មាន ការកកស្ទះ សំរាម ដោយ ចាក់ សំរាម គរ ទុកចោល យូរ ច្រើន ថ្ងៃ មក ហើយ ដោយ ប្រើប្រាស់ ឡាន ដឹក សំរាម និង រឺ ម៉ក់ ម៉ូតូ ដឹក យក សំរាម ចេញ ពី តាម ដងផ្លូវ យក ទៅ ចាក់ ចោល នៅ គំនរ សំរាម នៅឯ ជាយ ក្រុង ភ្នំពេញ ។
លោក ធឹម សំអាន អភិបាល ខណ្ឌ បឹងកេងកង បាន ឲ្យដឹង ទៀត ថា ចំពោះ ការងារ ចុះ ធ្វើ អនាម័យ បរិស្ថាន ដោយ ប្រើប្រាស់ កម្លាំង ចម្រុះ ចុះ ដើរ ប្រម៉ែ ប្រមូល សំរាម និង កាកសំណល់ នៅ តាម ដងផ្លូវ នានា ដែល កត្តា សំខាន់ ណាស់ ក្នុង ការដោះស្រាយ បញ្ហា កកស្ទះ សំរាម ដែល គេ គរ ទុក តាម ដងផ្លូវ យូរ អាច ហូរ ចូល ស្ទះ ប្រពន្ធ័ លូ និង ជា ការលើកកម្ពស់ នូវ កិត្តិយស មុខមាត់ មូលដ្ឋាន ខណ្ឌ បឹងកេងកង ទាំងមូល ផងដែរ ។
សូម បញ្ជាក់ ថា កាលពី យប់ ថ្ងៃទី ៩ ខែមករា នេះ កម្មករ ស៊ីន ទ្រី រួម មាន៖ អ្នកបើកបរ រថយន្ត ដឹក សំរាម និង កម្មករ បាន ធ្វើ កូដកម្ម មិន ព្រម ចេញ ប្រមូល សំរាម ដែល ធ្វើឲ្យ មាន ការអាក់ខាន ក្នុង ការប្រមូល សំរាម ៕
អភិបាល ខណ្ឌ ច្បារអំពៅ បញ្ចេញ កម្លាំង ប្រមូល កើប សំរាម ភ្លាម ក្រោយ កម្មករ ស៊ីន ទ្រី ធ្វើ កូដកម្ម មិន ចូល ធ្វើ ការ
( ភ្នំពេញ ) ៖ ក្រោយ ទទួលបាន ការណែនាំ ពី លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ លោក រស់ សុភក្តិ អភិបាល រង ខណ្ឌ បាន ដឹកនាំ កម្លាំង សណ្តាប់ធ្នាប់ ចុះ ប្រមូល សំរាម នៅ គ្រប់ ទីតាំង ទាំងអស់ ដែល ប្រជាពលរដ្ឋ យក សំរាម មក ចាក់ គរ ទុក នៅក្នុង មូលដ្ឋាន ពិសេស ផ្លូវ ជាតិ លេខ ១ ។
លោក រស់ សុភក្តិ អភិបាល រង តំណាង លោក អភិបាល ខណ្ឌ បាន ឲ្យដឹង ថា ការងារ នេះ អាជ្ញាធរ ខណ្ឌ បន្ត ចុះ ធ្វើជា ប្រចាំ ឲ្យ ដូច ភ្លៀង រលឹម មិន ថា ថ្ងៃ ឬ យប់ នោះ ទេ តួយ៉ាង ដូច ពេលនេះ អ៊ីចឹង ពិសេស នា ថ្ងៃ ចុង សប្ដាហ៍ គឺ កម្លាំង សណ្តាប់ ខណ្ឌ ចុះ ប្រមូល សំរាម មិន មាន កកស្ទះ នោះ ឡើយ ។
ជាមួយគ្នា នេះ លោក អភិបាល រង ខណ្ឌ ក៏ បាន អំពាវនាវ ដោយ សំណូមពរ ទៅដល់ បងប្អូន ប្រជាជន ទូទៅ និង បងប្អូន អាជីវករ សូម មេត្តា វេចខ្ចប់ ទុកដាក់ សំរាម ឲ្យបាន ត្រឹមត្រូវ និង ចូលរួម បោសសម្អាត ធ្វើ អនាម័យ បរិស្ថាន ដើម្បី ទីក្រុង យើង ឲ្យ កាន់តែ ល្អ ប្រសើរ មាន ផាសុខភាព ផងដែរ ពោល គឺ ទីក្រុង ស្អាត គឺ ផ្ដើម ចេញ ពី យើង ទាំងអស់ គ្នា ។
សូម បញ្ជាក់ ថា កាលពី យប់ ថ្ងៃទី ៩ ខែមករា នេះ កម្មករ ស៊ីន ទ្រី រួម មាន៖ អ្នកបើកបរ រថយន្ត ដឹក សំរាម និង កម្មករ បាន ធ្វើ កូដកម្ម មិន ព្រម ចេញ ប្រមូល សំរាម ដែល ធ្វើឲ្យ មាន ការអាក់ខាន ក្នុង ការ ប្រមូល សំរាម ។
ចំពោះ ការទាមទារ នេះ ក្រុមហ៊ុន កំពុង ដោះស្រាយ ដើម្បី បើក ជូន អ្នកបើកបរ កម្មករ អោយ ទាន់ ពេល កំណត់ ។ អាស្រ័យ ដូច បាន ជំរាប ជូន ខាងលើ សូម ម្ចាស់ លំនៅដ្ឋាន ម្ចាស់ អាជីវកម្ម និង បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ មេត្តា អធ្យាស្រ័យ ដោយ ក្តី អនុគ្រោះ ៕
អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ៖ សន្ដិភាព គឺជា កត្តា ដ៏ ចំបង បំផុត ក្នុង ការធ្វើឲ្យ ប្រទេស មាន ការរីកចម្រើន និង ការអភិវឌ្ឍន៍
( កំពង់ធំ )៖ លោក នង វាសនា តំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក សណ្ដាន់ ខេត្ត កំពង់ធំ នៅ ព្រឹក ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ចូលរួម រៀបចំ ប្រារព្ធ ពី ធី អបអរសាទរ ខួប អនុស្សាវរីយ៍ លើក ទី ៤១ ទិវា ជ័យជម្នះ ៧មករា ( ៧ មក រា ១៩៧៩ - មករា ២០២០ ) នៅ ស្រុក សណ្តាន់ ដោយ មាន ការចូលរួម ពី សមាជិក សមាជិកា និង បងប្អូន ប្រជាពលរដ្ឋ ជាច្រើន នាក់ ។
ថ្លែង ក្នុង ពិធី នោះ លោក នង វាសនា បាន លើកឡើង ថា ថ្ងៃ ៧មករា ឆ្នាំ ២០២០ នេះ ជា ថ្ងៃ គម្រប់ ខួប ទី ៤១ នៃ ទិវា ជ័យជម្នះ ៧មករា ឆ្នាំ ១៩៧៩ ជា ប្រវត្តិសាស្ត្រ ដែល បាន ផ្ដួលរំលំ របប ប្រល័យ ពូជសាសន៍ របស់ បន ប៉ុល ពត សង្គ្រោះ ជាតិ និង ប្រជាជន កម្ពុជា ឲ្យ មាន ជីវិត រស់រាន ឡើងវិញ រួចផុត ពី ការសម្លាប់ រង្គាល នៃ របប ដ៏ សាហាវ យង់ឃ្នង បំផុត បាន ទាន់ ពេលវេលា និង បាន បញ្ចប់ នូវ សករាជ ដ៏ ខ្មៅ ងងឹត បំផុត នៃ ប្រទេស កម្ពុជា ហើយ បើក ឡើង នូវ សករាជ ថ្មី គឺ ឯករាជ្យ សេរីភាព ប្រជាធិបតេយ្យ និង វឌ្ឍនភាព សង្គម ។
លោក នង វាសនា បាន លើកឡើង ថា មាន ថ្ងៃ៧ មករា ឆ្នាំ ១៩៧៩ ទើប មាន អ្វី ៗ ដូច សព្វ ថ្ងៃ នេះ ដែល ធ្វើឲ្យ ប្រទេសជាតិ មាន សន្តិភាព ពាសពេញ ផ្ទៃ ប្រទេស ហើយ មាន ឧទារណ៍ សម្រាប់ នៅលើ ប្រទេស ជាច្រើន ដូចជា ប្រទេស សិង្ហបុរី ប្រទេស ជប៉ុន ប្រទេស ថៃ ប្រទេស កូរ៉េ និង ប្រទេស ចិន ជាដើម ។ ដូច្នេះហើយ លោក នង វាសនា ក្នុង សំណូមពរ ឲ្យ ប្រជាជន កម្ពុជា ពិសេស បងប្អូន ប្រជាពលរដ្ឋ នៅ ស្រុក សណ្តាន់ សូម ចូលរួម ថែរក្សា សន្តិភាព ដែល រកបាន ដោយ ការលំបាក នេះ ឲ្យបាន គង់វង្ស រាប់ ពាន់ ឆ្នាំ ទៅ មុខ ទៀត ។
លោក សង្កត់ធ្ងន់ ថា « សន្ដិភាព គឺជា កត្តា ដ៏ ចំបង បំផុត ក្នុង ការធ្វើឲ្យ ប្រទេស មាន ការរីកចម្រើន និង ការអភិវឌ្ឍន៍ សូម អរគុណ ដល់ សន្តិភាព » ។
អ្នកតំណាងរាស្ត្រ រូប នេះ ក៏ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ រំលឹក ពី សមិទ្ធិផល និង ការលះបង់ របស់ អ្នកតស៊ូ រំដោះ ជាតិ ដែល បាន រំដោះ កម្ពុជា ឲ្យ រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ ទម្រាំ បាន ជោគជ័យ និង មាន សន្តិភាព ដូច សព្វ ថ្ងៃ នេះ ។
លោក បាន បាន បញ្ជាក់ ថា ដើម្បី អបអរ ជ័យ ជំនះ ៧មករា ខួប លើក ទី ៤១ ដែល មាន សន្តិភាព ដូច សព្វ ថ្ងៃ លោក ក៏ បាន បំពាក់ នូវ អំពូលភ្លើង សូឡា នៅ តាម ដងផ្លូវ សួនច្បារ និង នៅ តាម ដងស្ទឹង សែន ក៏ ដូចជា នៅ តាម ស្ពាន ហ៊ុន សែន ស្រុក សណ្ដាន់ និង បំពាក់ អំពូលភ្លើង នៅ ឃុំ ទំរីង ដែល ជា ឃុំ មួយ ដាច់ស្រយាល ដែល មាន ចម្ងាយ ៩៥ គីឡូម៉ែត្រ ពី ទី រួម ខេត្ត កំពង់ធំ ផងដែរ ។
លោក បញ្ជាក់ ទៀត ថា នៅក្នុង ឃុំ ទំរីង នេះ ដែល កើត ចេញ ពី សមិទ្ធិផល សន្តិភាព ក្រោម ការចង្អុលបង្ហាញ ពី សម្ដេច តេជោ ហ៊ុន សែន នៅ ដើម ទស្សវត្ស ឆ្នាំ ២០០១ ដើម្បី បង្កើត តំបន់ ស្នូល សេដ្ឋកិច្ច កៅស៊ូ មួយ ដែល កើត ចេញ ពី ចំការ កៅស៊ូ និង មាន រោងចក្រ កែច្នៃ ដែល អាច បង្កើត ទៅជា ឧស្សាហកម្ម កៅស៊ូ សម្រាប់ ខេត្ត កំពង់ធំ ។
លោក បន្ត ថា បច្ចុប្បន្ន នេះ ឃុំ ទំរីង ក៏ ក្លាយជា ឃុំ មួយ ដែល មាន សេដ្ឋកិច្ច ខ្ពស់ និង មាន ប្រជាជន មាន ជីវភាព ធូរធារ ហើយ សមិទ្ធិផល ទាំងអស់ នេះ ហើយ ដែល កើត ចេញ ពី កត្តា សន្តិភាព សូម អរគុណ សន្តិភាព និង សូម ថែរក្សា ការពារ សន្តិភាព ៕
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ប្រុងប្រយ័ត្ន ! ស្លាប់ ៥នាក់ និង របួស ១០នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ១០ ខែមករា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១០ ខែមករា ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ស្រាល ២នាក់ និង របួស ធ្ងន់ ៨នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង១០លើក នេះ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . បត់ គ្រោះថ្នាក់ . និង មិន គោរព សិទ្ធិ ៕
នៅ ចំពោះមុខ ក្រុម អ្នកតវ៉ា ដែល កំពុង ទាមទារ ឲ្យ រដ្ឋាភិបាល ទីក្រុង កង់ បេរ៉ា ចាត់ វិធានការ ឲ្យបាន ខ្លាំងក្លា ដើម្បី ពន្លត់ ភ្លើង ឆេះ ព្រៃ នោះ អាជ្ញាធរ អូស្ត្រាលី ក៏ បាន ចេញ សារ ព្រមាន កាន់តែ ធ្ងន់ធ្ងរ ជាង មុន ទៀត ដោយ តម្រូវ ប្រជាជន ទាំងអស់ បង្កើន ការប្រុងប្រយ័ត្ន និង ត្រៀម ភៀសខ្លួន ចេញ ទៅ រក តំបន់ ក្បែរខាង ដែល មាន សុវត្ថិភាព ព្រោះ មិន ត្រឹមតែ ភ្លើង ឆេះ ព្រៃ នោះ ទេ សូម្បីតែ ខ្យល់ ក៏ បោកបក់ លឿន ក្នុង ល្បឿន ៩០ គីឡូម៉ែត្រ ក្នុង មួយ ម៉ោង ខណៈ អាកាសធាតុ នឹង កើន កម្តៅ ដល់ លើស ៤០ អង្សា សេ ឯណោះ ។
គួរ បញ្ជាក់ ថា នាយក រដ្ឋមន្ត្រី អូស្ត្រាលី លោក Morrison នៅ ថ្ងៃព្រហស្បតិ៍ និង ថ្ងៃសុក្រ នេះ បាន ច្រានចោល នូវ ការចោទប្រកាន់ របស់ សកម្មជន បរិស្ថាន និង ប្រជាជន អូស្ត្រាលី ជាច្រើន ពាក់ព័ន្ធ ជំហរ រដ្ឋាភិបាល ចំពោះ ការប្រែប្រួល អាកាសធាតុ ។ លោក Morrison បាន ព្យាយាម ពន្យល់ ថា រដ្ឋាភិបាល របស់ លោក ក៏ មិន ចង់ឲ្យ ប្រជាជន បាត់បង់ ការងារ សេដ្ឋកិច្ច ត្រូវ បំផ្លាញ ឬ រង្គោះរង្គើ ដោយសារតែ បញ្ហា បម្រែបម្រួល អាកាសធាតុ នោះ ដែរ ៕
រដ្ឋមន្រ្តី ក្រសួង កិច្ចការ នារី និង ឯក អគ្គ រដ្ឋទូត អាមេរិក ជួប ពិភាក្សា គ្នា អំពី វឌ្ឍនភាព របស់ ក្មេងស្រី និង ស្ត្រី នៅ កម្ពុជា
ក្នុង ជំនួប រវាង លោកស្រី រដ្ឋមន្រ្តី ក្រសួង កិច្ចការ នារី និង ឯក អគ្គ រដ្ឋទូត សហរដ្ឋ អាមេរិក ប្រចាំ នៅ ប្រទេស កម្ពុជា ខាងលើ នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី ពិភាក្សា គ្នា អំពី វឌ្ឍនភាព របស់ ក្មេងស្រី និង ស្ត្រី នៅក្នុង ប្រទេស កម្ពុជា ។
លោកស្រី អ៉ឹង កន្ថា ផាវី បាន ថ្លែង ថា ក្នុង ជំនួប នេះ ដោយ ពិភាក្សា គ្នា ផ្ដោត ទៅ លើ ចំណុច សំខាន់ ៗ មួយចំនួន រួម មាន៖ វិស័យ អប់រំ សុខភាព ពង្រឹង ភាពអង់អាច ដល់ ស្រ្តី ក្នុង វិស័យ សេដ្ឋកិច្ច ស្ត្រី ក្នុង សេចក្តីសម្រេចចិត្ត កិច្ចការពារ ផ្លូវ ច្បាប់ ស្រ្តី និង ការប្រែប្រួល អាកាសធាតុ និង ស្ត្រី ក្នុង វិស័យ ព័ត៌មានវិទ្យា ។
ជាមួយគ្នា នោះ រដ្ឋមន្រ្តី ក្រសួង កិច្ចការ នារី បាន លើកឡើង ផងដែរ ថា កន្លងមក សហរដ្ឋ អាមេរិក ក៏ ធ្លាប់ បាន សហការ ជាមួយ ក្រសួង កិច្ច នារី ទៅ លើ គម្រោង មួយចំនួន ។
ក្រុមហ៊ុន ស៊ីង បាយ អូ ថេក ខិតខំ បញ្ចប់ ការកំណត់ ព្រំ ដី និង កសាង ផ្លូវថ្នល់ ដើម្បី ធ្វើ ផែនការអភិវឌ្ឍ និង ជួយ សម្រួល ផ្លូវ គមនាគមន៍ ដល់ ប្រជាពលរដ្ឋ
ជាមួយគ្នា នេះ ដើម្បី លុបបំបាត់ ការចោទប្រកាន់ និង ការលាប ពណ៌ របស់ ក្រុម ជន មួយចំនួន ថា ក្រុមហ៊ុន ស៊ីង បាយ អូ ថេក មាន ការពាក់ព័ន្ធ នឹង ការកាប់បំផ្លាញ ព្រៃឡង់ ដែល នៅជាប់ នឹង ដី ដែល ខ្លួន បាន ទទួល សិទ្ធិ វិនិយោគ នោះ ក្រុមហ៊ុន បាន សហការ ជាមួយ អាជ្ញាធរ ពាក់ព័ន្ធ នានា ដើម្បី កំណត់ ព្រំ ដី នៃ តំបន់ នោះ ។
