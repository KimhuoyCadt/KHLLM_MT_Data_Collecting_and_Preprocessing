លោក តែ ហាំង ម្ចាស់ ចម្ការ ដំឡូង មី ដ៏ ធំ មួយ នៅ បន្ទាយមានជ័យ ដែល មាន ផ្ទៃដី ដាំដុះ ជាង ១ ពាន់ ហិកតា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា តាំងពី ចាប់ផ្តើម រដូវកាល ដាំដុះ ដំបូង ពួកគេ ជួបប្រទះ ភាពរាំងស្ងួត តែ ទើប ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ ភ្លៀង ធ្លាក់ យ៉ាង ខ្លាំង ហើយ បាន ប៉ះពាល់ ដល់ ផ្ទៃដី ដាំដុះ ដំឡូង មី ជាច្រើន ហិកតា ។
ដំឡូង មី ជា ដំណាំ កសិកម្ម ធំ ជាង គេ ទី ពីរ ក្នុង ខេត្ត បន្ទាយមានជ័យ បន្ទាប់ពី ដំណាំ ស្រូវ ហើយ វា ក៏ បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការរួមចំណែក អភិវឌ្ឍ ស្ថានភាព នៃ ការរស់នៅ របស់ ប្រជាជន ក្នុង ខេត្ត ជាប់ ព្រំដែន ថៃ មួយ នេះ ផងដែរ ។
លោក រុន សុផាន់ ណារ៉ា ប្រធាន ការិយាល័យ ក្សេត្រសាស្ត្រ នៃ មន្ទីរ កសិកម្ម ខេត្ត បន្ទាយមានជ័យ បាន ឱ្យដឹង ថា មកដល់ ពេលនេះ ដំឡូង មី ត្រូវបាន ដាំដុះ លើ ផ្ទៃដី សរុប ៣៥០០ ហិកតា ហើយ បើ តាម ផែនការ លោក រំពឹង ថា ផ្ទៃដី ដាំដុះ ដំឡូង មី សរុប នៅក្នុង ខេត្ត បន្ទាយមានជ័យ នា ឆ្នាំ នេះ មាន ចំនួន សរុប ៤៥០០ ហិកតា ។
លោក បន្ត ថា បច្ចុប្បន្ន មាន តំបន់ ដាំដុះ ដំឡូង មី សំខាន់ ៗ មួយចំនួន នៅក្នុង ខេត្ត កំពុង រង ការប៉ះពាល់ ដោយសារ អាកាសធាតុ ពិសេស ក្នុង ស្រុក ម៉ាឡៃ ដែល ទទួលរង ផល ប៉ះពាល់ ខ្លាំង ជាង គេ ។
លោក តែ ហាំង បាន ស្នើ ឱ្យ មាន ការវិនិយោគ លើ រោងចក្រ កែច្នៃ ដំឡូង មី ឱ្យ បាន ច្រើន ជាង នេះ ព្រោះ តម្រូវការ ដំឡូង មី ដែល ជា វត្ថុធាតុ ដើម នឹង មាន ជា ប្រចាំ ។
ដូច្នេះ កសិករ នឹង បន្ត មាន ការប្រមូល ផល ជាប់ រហូត ៕
ថាមពល ពី រោងចក្រ ធ្យូងថ្ម ពន្យារ ដល់ ចុង ខែ៧
ភ្នំពេញៈ ការដាក់ ឱ្យ ដំណើរ រោងចក្រ ថាមពល អគ្គិសនី ដើរ ដោយ ធ្យូងថ្ម នៅ ខេត្ត ព្រះសីហនុ នឹង ត្រូវ ពន្យារ រហូតដល់ ចុង ខែកក្កដា ។
មន្ត្រី អគ្គិសនី កម្ពុជា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ខែឧសភា ថា រោងចក្រ ថាមពល មួយ នេះ នឹង បញ្ជូន អគ្គិសនី មក ទីក្រុង ភ្នំពេញ នៅ ខែមិថុនា នេះ ប៉ុន្តែ លោក អ៊ិត ប្រាំង រដ្ឋលេខាធិការ ក្រសួង ឧស្សាហកម្ម រ៉ែ និង ថាមពល និយាយ ថា រោងចក្រ ផលិត ថាមពល អគ្គិសនី ដើរ ដោយ ថាមពល ធ្យូងថ្ម កម្លាំង ១០០ មេហ្គាវ៉ាត់ នេះ គ្រោង នឹង ដាក់ ឱ្យ ដំណើការ នៅក្នុង ខែកក្កដា តែ មិន បញ្ជាក់ ពី កាលបរិច្ឆេទ ទេ ។
ចាប់ពី ចុង ខែកក្កដា ទៅ យើង លែង ខ្វះ ភ្លើង ប្រើ ហើយ តែ បើ វា ដាច់ គឺ ដោយសារ ដាច់ ខ្សែភ្លើង ។
លោក បញ្ជាក់ ថា បន្ទាប់ពី រោងចក្រ ដើរ ដោយ ថាមពល ធ្យូងថ្ម នេះ បាន ដាក់ ឱ្យ ដំណើរការវា នឹង ធានា ស្ថិរភាព ថាមពល យ៉ាងហោច ក៏ បាន មួយ ឆ្នាំ ។
បន្ទាប់ពី នោះ មក ស្ថានីយ វារី អគ្គិសនី ជាច្រើន កន្លែង នឹង ដាក់ ឱ្យ ដំណើរការ ជា បន្តបន្ទាប់ រួមទាំង រោងចក្រ ថាមពល ធ្យូងថ្ម មួយចំនួន ទៀត ផងដែរ ។
លោក កែវ រតនៈ អគ្គ នាយក អគ្គិសនី កម្ពុជា EDC បាន ឱ្យដឹង បន្ទាប់ពី បិទ កិច្ចប្រជុំ មន្ត្រី ជាន់ ខ្ពស់ ទទួលបន្ទុក ថាមពល អគ្គិសនី មក ពី តំបន់ អាស៊ាន កាលពី ចុង ខែឧសភា ថា រោងចក្រ ថាមពល ធ្យូងថ្ម ពី ខេត្ត ព្រះសីហនុ និង ខ្សែ បណ្តាញ តភ្ជាប់ អគ្គិសនី មក ភ្នំពេញ បាន រៀបចំ រួចរាល់ ។
លោក អ៊ិត ប្រាំង បាន ឱ្យដឹង ថា ការប្រើប្រាស់ អគ្គិសនី កំពុង មាន ការកើនឡើង ដោយសារ កំណើន ក្នុង វិស័យ សំណង់ ។
ការវិនិយោគ លើ រោងចក្រ មួយ នេះ តម្លៃ ប្រមាណ ១៧០ លាន ដុល្លារ ។
លោក អ៊ិត ប្រាំង ឱ្យដឹង ថា កាកសំណល់ ពី ធ្យូងថ្ម ត្រូវបាន គេ យក ទៅ ប្រើប្រាស់ ច្រើន យ៉ាង ដោយ រួម មាន កៅស៊ូ ក្រាល ថ្នល់ សម្ភារ ចម្លាក់ និង អ្វី ផ្សេង ៗ ទៀត ។
លោក ស្បោង សារ៉ាត អភិបាល ខេត្ត ព្រះសីហនុ និយាយ ថា រោងចក្រ ស្ថិត ក្នុង ស្រុក ស្ទឹង ហាវ នេះ ថ្មី ៗ នេះ ត្រូវបាន គេ ដំណើរការ សាកល្បង ត្រឹម កម្លាំង ៥មេហ្គាវ៉ាត់ ជា បណ្តោះអាសន្ន ។
លោក បាន លើកឡើង បន្ទាប់ពី ការដាក់ ដំណើរកម្លាំង ៥មេហ្គាវ៉ាត់ ថាមពល នៅក្នុង ខេត្ត ហាក់ បាន ជួយ ការខ្វះខាត បាន មួយចំនួន ហើយ បច្ចុប្បន្ន នេះ គេ កំពុងតែ ស្ថាបនា ស្ថានីយ ចែកចាយ ថាមពល ពី រោងចក្រ នេះ នៅក្នុង ខេត្ត នេះ ។
ប៉ុន្តែ លោក នៅ មិន ទាន់ ដឹង ពី កាលបរិច្ឆេទ ដំណើរការ ជា ផ្លូវការ និង ពេញ សមត្ថភាព នៅឡើយ ទេ ។
បច្ចុប្បន្ន រាជធានី ភ្នំពេញ ប្រឈម នឹង កង្វះ ថាមពល ហើយ មាន ការ កាត់ផ្តាច់ អគ្គិសនី ទៅ តាម តំបន់ ជាញឹកញាប់ ជាពិសេស នៅ រដូវ ក្តៅ ។
កង្វះ ការផ្គត់ផ្គង់ អគ្គិសនី ត្រូវបាន ម្ចាស់ សហគ្រាស ត្អូញត្អែរ ថា បាន ធ្វើឱ្យ ការផលិត ក្នុង រោងចក្រ មាន ការធ្លាក់ចុះ ។
យោង តាម សេចក្តីរាយការណ៍ របស់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ឆ្នាំ ២០១២តម្រូវការអគ្គិសនី សរុប នៅក្នុង រាជធានី ភ្នំពេញ មាន ប្រមាណ ៤០០ មេហ្គាវ៉ាត់ ក្នុង មួយ ថ្ងៃ ខណៈ កាល នោះ ការផ្គត់ផ្គង់ មាន ក្នុង រង្វង់ តែ ២៩០ មេហ្គាវ៉ាត់ ។
របាយការណ៍ មួយ កាលពី ឆ្នាំ ២០១១ របស់ មជ្ឈមណ្ឌល ថាមពល អាស៊ាន បាន បង្ហាញ ថា តម្លៃ អគ្គិសនី របស់ កម្ពុជា ខ្ពស់ ជាង គេ នៅក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ ។
របាយការណ៍ បង្ហាញ ថា តម្លៃ អគ្គិសនី ក្នុង មួយ គីឡូវ៉ាត់ ម៉ោង ជា មធ្យម គិត ជា ដុល្លារ មាន តម្លៃ ចន្លោះ ពី ១១, ៧១សេន ទៅ ១៤, ៦៣សេន ក្នុង មួយ គីឡូវ៉ាត់ ម៉ោង សម្រាប់ អ្នកប្រើប្រាស់ ក្នុង វិស័យ ឧស្សាហកម្ម ខណៈ តម្លៃ នៅ ប្រទេស វៀតណាម មាន ចន្លោះ ពី២,៣សេន ទៅ៨, ៣២សេន ប្រទេស ថៃ មាន ចន្លោះ ពី ៨, ៦៧សេន ទៅ៩, ៤៣សេន ហើយ ប្រទេស ឡាវ ស្ថិត ក្នុង ចន្លោះ ពី៦, ២៣សេន ទៅ៧,៣៤សេន ។
លោក សុខ ចិន្តា សោភា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា CDC បាន ឱ្យដឹង កាលពី ថ្ងៃទី ៦មីនា ថា កង្វះ ការផ្គត់ផ្គង់ អគ្គិសនី និង តម្លៃ ខ្ពស់ នៅតែ ជា បញ្ហា ប្រឈម យ៉ាង ចម្បង នៅក្នុង បរិយាកាស វិនិយោគ នៅ ប្រទេស កម្ពុជា ។
វា ប៉ះពាល់ ដល់ ការសម្រេចចិត្ត របស់ វិនិយោគិន ហើយក៏ បាន បង្ក ការលំបាក ដល់ CDC ក្នុង ការទាក់ទាញ វិនិយោគ ក្រៅ ប្រទេស ឱ្យ ចូលមក វិនិយោគ នៅ កម្ពុជា ផងដែរ ។
ទោះបី យ៉ាង នេះ ក្តី លោក ក៏ បាន រំពឹង ថា បរិមាណ និង គុណភាព ផ្គត់ផ្គង់ អគ្គិសនី នៅ កម្ពុជា នឹង មាន ភាព ល្អ ឡើង ចាប់ពី ពាក់កណ្តាល ឆ្នាំ នេះ ទៅ បន្ទាប់ពី ការវិនិយោគ លើ រោងចក្រ ផលិត ថាមពល ជាច្រើន កន្លងមក នឹង អាច ចាប់ផ្តើម ផ្តល់ ថាមពល មក វិញ ។
ប្តឹង ទារ សំណង ពី គម្រោង ៤២ ជាន់
ដូច្នេះ មធ្យោបាយ គឺ រឹបអូស អចលន វត្ថុ លក់ ឡាយ ឡុង យក ប្រាក់ មក សង បំណុល ។
ដើម្បី ចាត់ វិធានការ ការពារ នូវ ផលប្រយោជន៍ ខ្ញុំ ចាំបាច់ ត្រូវតែ ស្នើសុំ ចេញ ដីកា សម្រេច រក្សា ការពារ ឃាត់ទុក ទ្រព្យសម្បត្តិ ទាំងអស់ ខាងលើ ជា បណ្តោះអាសន្ន សិន ទម្រាំ តុលាការ សម្រេច ដល់ រឿង អង្គ សេចក្តី ចប់ ជាស្ថាពរ ។
លោក ឡេង ស៊ូ ហួត បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា លោក ទើបតែ ទទួលបាន លិខិត នោះ ពី តុលាការ នៅ ប៉ុន្មាន ថ្ងៃ ចុងក្រោយ នេះ ដើម្បី ធ្វើ ការកែប្រែ ខ្លះ ក្នុង ពាក្យបណ្តឹង នេះ ។
មិន អាច ទាក់ទង លោក យូ ប៊ុណ្ណា ចៅក្រម នៅ សាលាដំបូង រាជធានី ភ្នំពេញ បាន ទេ កាលពី ម្សិលមិញ ៕
ពិព័រណ៍ ត្បូង នឹង ជួយ ពង្រឹង ឧស្សាហកម្ម នេះ
ភ្នំពេញៈ ពិព័រណ៍ គ្រឿងអលង្ការ និង ត្បូង លើក ទី៥ ត្រូវបាន រៀបចំឡើង រយៈពេល ៤ ថ្ងៃ នៅ ភ្នំពេញ ពី ថ្ងៃទី ១៣ដល់ ទី១៦ ដោយ មាន ការចូលរួម ពី ក្រុមហ៊ុន ក្នុង ស្រុក និង បរទេស ៧៨ ក្រុមហ៊ុន ។
ថ្លែង ក្នុង ពិធី បើក ពិព័រណ៍ នេះ ពី ម្សិលមិញ លោក ចម ប្រសិទ្ធ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម កម្ពុជា បាន ឱ្យដឹង ថា ការបង្កើត ឱ្យ មាន ការដាក់ បង្ហាញ នៃ ផលិតផល គ្រឿងអលង្ការ និង ត្បូង មាន តម្លៃ នេះ គឺជា វេទិកា ដ៏ មាន សារៈសំខាន់ ព្រោះថា កម្ពុជា កំពុង មាន គម្រោង ក្លាយជា អ្នកផ្គត់ផ្គង់ ត្បូង ថ្ម មាន តម្លៃ និង គ្រឿងអលង្ការ ដ៏ សំខាន់ មួយ ផងដែរ នា ពេល អនាគត ដ៏ ខ្លី ខាងមុខ ។
មន្ត្រី និង ពាណិជ្ជករ បាន លើកឡើង ថា វត្ថុធាតុ ដើម សម្រាប់ ផលិត និង កែច្នៃ ផលិតផល នេះ អាច ទ្រទ្រង់ កំណើន ផលិតកម្ម និង ការអភិវឌ្ឍ ក្នុង ឧស្សាហកម្ម គ្រឿងអលង្ការ និង ត្បូង មាន តម្លៃ នៅ កម្ពុជា បាន ។
តែ ភាគី ពាក់ព័ន្ធ មិន អាច បង្ហាញ ពី តួលេខ នៃ តម្រូវការ ជាក់ស្តែង និង លទ្ធភាព នៃ ការផ្គត់ផ្គង់ ផលិតផល នេះ នៅឡើយ ទេ ។
លោក ឌីលី ម្ចាស់ ហាង ត្បូង ឌីលី ប៉ៃលិន ដែល បាន ចូលរួម យក ផលិតផល ត្បូង មក ដាក់ បង្ហាញ ក្នុង ពិធី តាំង ពិព័រណ៍ នេះ លើកឡើង ថា ភាគ ច្រើន នៃ ផលិតកម្ម កែច្នៃ ត្បូង នៅ ប៉ៃលិន ជា ផលិតកម្ម លក្ខណៈ ជា គ្រួសារ ហើយក៏ កែច្នៃ តាម របៀប ពី បុរាណ តាមរយៈ ផលិតកម្ម ដោយ ដៃ ។
លោក កាប៊ីហ្កូ វ័រ ប្រធាន មន្ទីរពិសោធ Intertek ជា ក្រុមហ៊ុន ត្រួតពិនិត្យ គុណភាព និង ផ្តល់ វិញ្ញាបនបត្រ បញ្ជាក់ សម្រាប់ នាំចេញ ត្បូង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ម្សិលមិញ ថា រហូតមកទល់ ពេលនេះ គុណភាព និង សក្តានុពល ក្នុង ឧស្សាហកម្ម ត្បូង និង គ្រឿងអលង្ការ កម្ពុជា នៅ មិន ទាន់ មាន ការទទួលស្គាល់ ឱ្យ បាន ទូលំទូលាយ នៅលើ ឆាក អន្តរជាតិ នៅឡើយ ទេ ។
លោក រំពឹង ថា ឧស្សាហកម្ម នេះ នឹង មាន ការវិវឌ្ឍ ល្អ ជាង នេះ នៅ ថ្ងៃ អនាគត តែ វា ត្រូវការពេល យ៉ាងហោចណាស់ ពី ៤ទៅ ៥ឆ្នាំ ទៀត ដើម្បី កសាង ទំនុកចិត្ត និង ភាពជឿជាក់ កាន់តែ ខ្លាំង ពី ទីផ្សារ អន្តរជាតិ ។
លោក ចម ប្រសិទ្ធ បង្ហាញ សុទិដ្ឋិនិយម អំពី អនាគត ឧស្សាហកម្ម គ្រឿងអលង្ការ និង ត្បូង របស់ កម្ពុជា ថា ការទទួលបាន ការអនុគ្រោះ ពន្ធ ឬ ការលើកលែង ពន្ធ លើ ការនាំចេញ ពី កម្ពុជា ពី បណ្តា ប្រទេស អភិវឌ្ឍ ជាច្រើន រួមទាំង អាមេរិក នឹង ជួយ លើកទឹកចិត្ត ដល់ ក្រុមហ៊ុន បរទេស ជាច្រើន អាច រើ ទីតាំង វិនិយោគ គេ មក កម្ពុជា ៕
វិនិយោគិន ឥណ្ឌា មក មើល ឱកាស អាជីវកម្ម នៅ កម្ពុជា
ភ្នំពេញៈ គណៈប្រតិភូ ធុរកិច្ច ឥណ្ឌា ប្រមាណ ៤០ រូប មកពី រដ្ឋ នានា នៃ ភាគ ឦសាន ប្រទេស ឥណ្ឌា បាន មក ស្វែងរក ឱកាស វិនិយោគ នៅ កម្ពុជា ដើម្បី ពង្រីក កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ក្នុង វិស័យ មួយចំនួន ។
