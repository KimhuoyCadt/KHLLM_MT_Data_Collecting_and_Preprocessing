ព្រឹត្តិការណ៍ កម្ពុជា ប្រចាំ ថ្ងៃ នៅក្នុង ដំណាក់កាល ដ៏ តឹង តែង និង គ្រោះថ្នាក់ បំផុត ហេតុ អ្វី នៅតែ មាន អ្នក …
ខ្ញុំ លែង ចង់ ឮ ពាក្យ ថា ធ្វើ ខាងមុខ ខូច ខាងក្រោយ ទៀត ហើយ
ជ័យលាភី កម្មវិធី ប្រកួតប្រជែង រូបថត នៃ ក្តី ស្រលាញ់ ពី …
ចាប់តាំងពី ពេល នោះ មក ជនភៀសខ្លួន បាន ប្រើប្រាក់ ច្រកផ្លូវ ផ្សេង ទៀត ដើម្បី ទៅកាន់ អឺរ៉ុប ។
បន្ទាប់មក ពួកគេ នាំគ្នា បើក ភ្លើង ទូរស័ព្វ បង្កើត ជា សមុទ្រ ពន្លឺ មួយ ។
ដំណាក់កាល ទី៣ ខ្ញុំ រីកចម្រើន និង ដឹង ហើយ វា ចាប់ផ្តើម បង្ហាញ ចេញមក
កាលពី ឆ្នាំ ទៅ អង្គការ ទស្សនៈ ពិភពលោក បាន ធ្វើ
កាត់បន្ថយ ការយាយី ផ្លូវភេទ នៅ កន្លែង ធ្វើការ ។
ឥណ្ឌូណេស៊ី នេសាទ
សុំទោស ដែល ធ្វើឱ្យ អូន ខូចចិត្ត អាន គុណ កូឡា
នៃ ព្រះតេជ ព្រះគុណ មេ គណរង ឡឹម ពៅ វិភទ្ទញ្ញាណ
ខ្ញុំ មិន យល់ ថា ហេតុ អ្វី បានជា គ្រួសារ ខ្ញុំ គិត ថា គាត់ ជា មនុស្ស សម គ្នា ជាមួយនឹង ខ្ញុំ ។
ខ្ញុំ សូម ឱ្យ តុលាការ បន្ថយ ទោស ខ្លះ ដល់ ខ្ញុំ ។
ទឹក ធ្លាក់ អូរ អង្កាល ត្រូវការច្នៃ លើក សម្រស់ ដើម្បី ទាក់ចិត្ត ភ្ញៀវ ទេសចរ
ឪពុក ម្តាយ មិន អោយ តំលៃ លើ ការសិក្សា ។
នៅ ខេត្ត កំពង់ស្ពឺ មាន ស្ពាន មួយ ឈ្មោះ ស្ពាន គុណ គ្រូ សម្តេច ហ៊ុន សែន អ្នក ដាក់ ឈ្មោះ ។
ការចាប់ផ្តើម អាជីវកម្ម ទាំង នេះ បង្កើត តម្លៃ ដល់ មនុស្ស ដែល បាន ចាប ផ្តើម វា ពី ដំបូង ។
និយាយ ដល់ ស្វាយចន្ទី សម្រាប់ លោក អ្នក ដែល មាន បំណង ចង់ ចេះ ពាក្យ ភាសា បរទេស ។
អារម្មណ៍ នេះ មាន ច្រើន
មិន អោយ វិនាស អន្តរាយ ឡើយ ។
ស្នេហា ពិត កើត ចេញពី ការស្រលាញ់ ចិត្ត និង ចិត្ត មិន គិត ពី រូប សម្បត្តិ អ្វី ឡើយ ។
យើង ដឹង ហើយ ថា ប្រទេស អភិវឌ្ឍន៍ មួយ គឺ ត្រូវការ ចំណេះដឹង ។
ក្តី ព្រោះ មន្ត្រី ជាប់រវល់ ចុះ សហការ តាម វត្ត ស្រុក ក្រុង ។
បន្លែ ត្រូវការ សំណើម ខ្ទឹម ស ត្រសក់ ខ្ទឹម បារាំង ។
ប៉ុន្តែ កុំ ប្តូរ សង្សារ និង ប្រពន្ធ អី !
លោក គ្មាន ស្មារតី ទទួលខុសត្រូវ ទេ ឬ ?
ដោយសារ ហេតុផល ទាំងនេះ ហើយ ទើប មនុស្ស ភាគ ច្រើន ជ្រើសរើស ប្រើប្រាស់ ឈ្មួញ កណ្តាល ឬ អ្នក គក់ ចេ ។
យ៉ាងណា ក្តី ខ្ញុំ ឈប់ យំ តែ ខ្ញុំ ហ្វឹកហាត់ យ៉ាង ខ្លាំង ។
នៅក្នុង វិស័យ អចលន ទ្រព្យ ជំនួញ គឺ មាន ការពឹងពាក់ ខ្លាំង ទៅ លើ អ្នក ជួយ ណែនាំ ។
ក្នុង អាល់ប៊ុម មាន រូបថត ៤១ សន្លឹក សូម មើល តាម បណ្តាញ ខាងក្រោម ៖
លោក អ្នក អាច ធ្វើ ការ ស្កេន ទូទាត់ បាន ភ្លាម ៗ
បាន រៀនសូត្រ អស់ រយៈពេល ជា យូរ ឆ្នាំ មកហើយ ។
ខ្លួន ទាប មិន ត្រូវ ឈោង ខ្ពស់ ក្រែងគ្រោះ ទ្រូង ស្រី ទន្ទ្រាន
ភាពយន្ត អប់រំ ខ្លី រឿង ប្រពន្ធ បាយក ក ចាក់ ចំបេះដូង អ្នកទស្សនា ខ្លាំង
ស្រា ជា សត្រូវ នៃ អាយុជីវិត ហេតុ អ្វី បានជា គេ ចូលចិត្ត ផឹក ម្ល៉េះ ?
នេះ ប្រៀប ដូចជា មនុស្ស គ្មាន ការសិក្សា សំដី ពាល ជាង ក្មេង ហិត កាវទៅ ទៀត បើ និយាយ អោយ
មិន ចង់ ប្តូរ ទេ បើ អា ចាស់ វា មិន ផ្លាស់ប្តូរ ប្រូម៉ូស្យុង នោះ !
វាសនា របស់ កូន កសិករ ម្នាក់ បាន ប្រែក្លាយជា និស្សិត ឆ្នើម ប្រចាំ សាកលវិទ្យាល័យ
ពលរដ្ឋ ខ្មែ ដែល ស្រលាញ់ ភេទ ដូចគ្នា ។
របស់ មន្ត្រី នគរបាល ជាតិ ចាប់ពី ខែកញ្ញា ឆ្នាំ ២០១៦ត ទៅ ។
មាគ៌ា របស់ ព្រះអម្ចាស់ សុទ្ធតែ ទៀង ត្រង់
នៅ ប្រទេស ចិន ដោយសារតែ ខ្ញុំ គិត ថា វា អាច បង្ក ជា បញ្ហា បន្ថែម ដល់ ពួកគេ ។
ម្យ៉ាងទៀត លោក ប្រកាស ថា នឹង ខិតខំ ប្រឹងប្រែង ឱ្យ មាន ការអនុម័ត ច្បាប់ មួយ សម្រាប់ បំពេញ ។
បើ លោក ហ៊ុន សែន មិន ព្រម កែ ខ្លួន ទេ កម្ពុជា អាច បាត់បង់ ប្រយោជន៍ កាន់តែ ច្រើន ថែម ទៀត ។
ពត៌មាន ប្រចាំ ថ្ងៃ ស្នេហា និង ផ្លូវភេទ អាហារ ៥យ៉ាង ល្អ សម្រាប់ សុខភាព មេជីវិត ឈ្មោល
ក្នុង ន័យ នេះ យើង មិន ត្រឹមតែ អរគុណ សន្តិភាព ប៉ុណ្ណោះ ទេ ប៉ុន្តែ យើង ក៏ ត្រូវ នឹក គុណ ដល់ អ្នក ដែល បាន នាំមក នូវ សន្តិភាព អោយ យើង ផងដែរ ។
ដោយ មាន អតិថិជន មក ទិញ កង់ ទៅ ជិះ ហាត់ប្រាណ មាន ចំនួន ច្រើន ជារៀងរាល់ ថ្ងៃ ហើយ បើ ទោះបីជា ក្នុង វិបត្តិ កូវីដ១៩ នេះ ក្តី ក៏ អតិថិជន ទិញ កង់ ជិះ ហាត់ប្រាណ នៅតែ មាន ចំនួន ច្រើន ដដែល ។
យ៉ាប់ ទាំង ព្រឹក នឹក ចង់ ខឹង
ន័យ នេះ សំដៅ ទៅ លើ ខេត្ត ក្រុង មួយចំនួន ធ្វើ ការជួសជុល ផ្លូវ នីមួយ ៗ
យើង លែង ជា ស្នេហា ហើយ ប៊ុត សីហា
យើង ដូចជា អ្នក នៅ ម៉ាឡេ អី ណឹង អូហូចូល ឆ្នាំ ម្តង ៗ
យ័ន ទៅ ប្រាក់ រៀល កម្ពុជា ការបម្លែង ។
លោក បន្ត ថា រឿង នេះ នឹង ប៉ះពាល់ ដល់ ការលើកទឹកចិត្ត អ្នកនិពន្ធ ក្នុង ស្រុក ខ្លាំង ។
ទាំងនេះ ពី ពន្លឺ ព្រះអាទិត្យ និង បង្រៀន ពួកគេ អំពី សុវត្ថិភាព នៃ ការប៉ះពាល់ ពន្លឺ ព្រះអាទិត្យ នៅ ខាងក្រៅ ផ្ទះ ។
សូម ស្តាប់ កិច្ចសម្ភាសន៍ នេះ ដូចតទៅ ៖
ឥឡូវនេះ គាត់ បរាជ័យ ទាំង ២ចំណុច ហ្នឹង ។
គេ បាន សិក្សា ឃើញ ថា ការចម្អិន វា ឱ្យ បាន ល្អ អ្នក នឹង ទទួលបាន ជាតិ វីតាមីន ខ្ពស់ បំផុត ដែល រាងកាយ ត្រូវការ ។
មនុស្ស ខាក ស្តោះ គ្រប់ ទិសទី ដោយ សេរី និង មិន មាន ការណែនាំ អ្វី ។
កាន់តែ ប្រថុយប្រថា ន គ្រោះថ្នាក់ ជាង មុន ។
ទោះ បង ទៅ កុំ ភ្លេច ស្រលាញ់ បង រ័ត្ន
សន្និសីទ ជំងឺ គ្រុនចាញ់ ហេតុ អ្វី បានជា កម្ពុជា គឺជា មជ្ឈមណ្ឌល នៃ ពិភពលោក ?
ហើយ ព្រះអង្គ នឹង ដាក់ទោស ពួកគេ
ទៀត នោះ គឺ ត្រូវ ធ្វើឱ្យ បង្គន់ ស្អាត និង មាន អនាម័យ ។
ទោះជា យ៉ាង នេះ ក្តី តំណាងរាស្ត្រ និង ជា អ្នកនាំពាក្យ គណបក្ស ប្រជាជន កម្ពុជា លោក សុខ ឥសាន បាន គាំទ្រ ទៅនឹង ការសម្រេច នេះ ។
កាន់តែ ពិសេស នោះ គឺ គោ ងៀត អាំង ជា ស្នាដៃ ម្ចាស់ ហាង ធ្វើ ផ្ទាល់ តែ ម្តង ទាំង រសជាតិ និង អនាម័យ ល្អ ។
ទៀតផងដែល បង្ហាញ ថា បើ គ្មាន កម្លាំង បង្កប់ បញ្ជូន ទៅ ឱ្យ ក៏ វិទ្យុ ក្រៅ ស្រុក នោះ មិន អាច ដឹង បាន ដែរ ។
តុលាការ អាមេរិក ចេញមុខ តទល់ ច្បាប់ ជន អន្តោប្រវេសន៍ របស់ ត្រាំ ហើយ !
ពិការ ភាព ជីវិត ក៏ អាច ជោគជ័យ បាន ដែរ
សម្តេច ក្រុម ព្រះអំពាវនាវ ឱ្យ បក្ស ប្រឆាំង ចូលរួម ជាមួយ ព្រះអង្ក និង បក្ស កាន់អំណាច
តែ ឆ្លងកាត់ ការស្រាវជ្រាវ យ៉ាង ល្អិតល្អន់ បំផុត ។
សង្គ្រាម តម្លៃ នឹង ប៉ះពាល់ ដល់ ប្រាក់ ចំណេញ របស់ ឧស្សាហកម្ម ធន តូច និង មធ្យម
សម្រាប់ រឿង ចុះ ស្រាវជ្រាវ នេះ ក្រសួង បរិស្ថាន បាន បន្ត ចោទ ថា ៖
១២អស់ អ្នក ដែល ចង់ រស់ នៅ ដោយ គោរព ប្រណិប័តន៍ ព្រះជាម្ចាស់ ក្នុង ព្រះគ្រិស្ត យេស៊ូ មុខ ជា ត្រូវ គេ បៀតបៀន ដូច្នេះ ឯង ។
តើ អ្នក ពិបាកចិត្ត យ៉ាងណា នៅ ពេល ដែល បាន ដឹង ថា មនុស្ស ដែល យើង កំពុង ស្រលាញ់ កំពុងតែ ឈឺចាប់ ព្រោះតែ ស្នេហ៌ ខក បំណង ជាមួយ អ្នក ផ្សេង ?
ប៉ុន្តែ មាន អំណោយ ខ្លះ ដែល ខ្សែ រាជ វង្ស អាច ទទួលយក បាន ក្នុង ករណី លើកលែង ។
នេះ បើ តាម អ្នកនាំពាក្យ បាន ឱ្យដឹង ។
ខ្ញុំ ងាក ទៅ រក បុរស ម្នាក់ ដែល ជា អ្នកនាំផ្លូវ នោះ ស្រាប់តែ គាត់ ញញឹម ដោយ ភាពភ័យខ្លាច ។
