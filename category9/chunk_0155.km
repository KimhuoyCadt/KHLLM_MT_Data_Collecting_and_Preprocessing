នេះ មាន តម្លៃ ប្រហែលជា ពាក់កណ្តាល នៃ តម្លៃ ផ្គត់ផ្គង់ គ្រូប រទេស ម្នាក់ រស់ នៅក្នុង ប្រទេស កូរ៉េ ។
អ្នកយកព័ត៌មាន យើង បាន ទូរស័ព្ទ ចូល ទូរស័ព្ទ លោក ទេព ចាន់ ណា ជាច្រើន ដង តែ លោក អធិការ មិន លើក ទទួល ហើយ រថយន្ត ដឹក ឈើ ក្រញូង ធ្វើដំណើរ បាន ដោយ រលួន ។
សព្វ ថ្ងៃ នេះ វា គឺជា ការពេញនិយម និង ទាក់ទាញ យ៉ាង ខ្លាំង ក្នុង ស្រុក អាមេរិក ដែល ត្រូវបាន គេ ហៅ ថា មិន ផ្លូវការ ថា ជា ផ្ទះ ដើមឈើ ធំ ជាង គេ បំផុត នៅក្នុង ពិភពលោក ។
គ្នា បូកសរុប លទ្ធផល ទាំងឡាយ ដែល ទទួលបាន ក្នុង រយៈពេល ១
៣០ ស្បែក របស់ ខ្ញុំ ឡើង ខ្មៅ
បុរស អភ័ព្វ រូប នេះ អាច ត្រូវ វះកាត់ បង្កើត អណ្តាត ថ្មី ទើប សង្ឃឹម ថា អាច និយាយ រួច ។
ហើយ ក្លិន សំលៀកបំពាក់ របស់ ឯង ដូចជា ក្លិន ក្រអូប
យល់ដឹង អំពី ប្រទេស កម្ពុជា កំប្លែង
តើ វា ជា យុទ្ធសាស្ត្រ ការពារ នៃ ការវិលត្រឡប់ នៃ របប ប្រល័យ ពូជសាសន៍ ដែរ ឬ អត់ ?
លោក ថា នឹង មិន បណ្តោយ ឱ្យ មាន សកម្មភាព ល្មើស ច្បាប់ បែប នេះ កើតឡើង ទៀត ឡើយ ហើយ កន្លងទៅ ក៏ មិន ធ្លាប់ មាន ករណី ទាំង នេះ កើតឡើង ដែរ ។
ករណី ភាគ ច្រើន វា គ្មាន បញ្ហា អ្វី ឡើយ គ្រប់ យ៉ាង ដែល អ្នក ត្រូវ ធ្វើ គឺ អត់ធ្មត់ រង់ចាំ ។
សាក្សី ជា ប្រពន្ធ ជនជាប់ចោទ ខៀវ សំផន និយាយ កុហក តុលាការ
សរុប មក យើង មាន តម្រុយ មួយ ជំហាន រួចហើយ ។
ពូក គេ មាន ឯកសណ្ឋាន ជា កងរាជអាវុធហត្ថ ។
អ្នកស្រុក ក៏ ទៅ យកមក ដុត ទៀត ។
ចំណែក វិភាគទាន របស់ ប្រទេស ជប៉ុន ចំពោះ កំណើន សេដ្ឋកិច្ច ពិភពលោក គឺ សូន្យ ។
យើង បាន រៀបចំ ឯកសារ រួចហើយ នៅសល់ តែ ព័ត៌មាន មួយចំនួន ដែល ត្រូវ ចរចា ។
ណា ខ្លះ គេង ថ្ងៃ ដើម្បី ប្រសិទ្ធភាព ការងារ និង ភាពច្នៃប្រឌិត ?
ហេតុ អ្វី ប្រទេស រុស្ស៊ី ចង់ ចង សម្ព័ន្ធភាព ជាមួយ ប្រទេស ចិន ទៅ វិញ ?
ដោយសារ មិន ទាន់ ច្បាស់លាស់ បាន យើង ទាមទារ គេ មិន ឱ្យ សាងសង់ ។
សម្រាប់ ប្រទេស ខ្លះ វិបត្ត ទិាំង នេះ នឹង ជះឥទ្ធិពល អាក្រក់ រយៈពេល រាប់ សិប ឆ្នាំ ៕
ពី ពេលនេះ ទៅ មុខ អស់ អ្នក ដែល មាន ប្រពន្ធ ហើយ ត្រូវកាន់ចិត្ត ដូចជា គ្មាន ប្រពន្ធ ៣០អស់ អ្នក ដែល យំសោក ដូចជា មិន យំសោក អស់ អ្នក ដែល អរសប្បាយ ដូចជា មិន អរសប្បាយ អស់ អ្នក ដែល ទិញ ដូចជា មិន មែន ម្ចាស់ ទ្រព្យ ៣១ ហើយ អស់ អ្នក ដែល ប្រើប្រាស់ សម្បត្តិ លោកីយ៍ ក៏ ត្រូវកាន់ចិត្ត ដូចជា មិន បាន ប្រើប្រាស់ ដែរ ដ្បិត ពិភពលោក នេះ នឹង ត្រូវ ប្រែប្រួល ជា មិន ខាន ។
ការការពារ ដោយ ស្រប ច្បាប់ ត្រូវ មាន លក្ខខណ្ឌ ដូច ខាងក្រោម នេះ ៖
ក្រុមហ៊ុន តែងតែ មាន ពេលវេលា គ្រប់គ្រាន់ ដើម្បី ឆ្លើយតប ទៅនឹង សំនួរ ទាំងឡាយ របស់ អាជ្ញាធរ ប្រេស៊ីល ។
រដ្ឋាភិបាល លន់ នល់ ត្រូវ រៀបចំ ឡើងវិញ ។
រម្យ នីដ្ឋាន នេះ គឺ មាន ទឹក ធ្លាក់ តិច ៗ
វា ជា ការលំបាក ដើម្បី ចាប់ផ្តើម កំនត់ ពី ពេល មើល ទូរទស្សន៍ របស់ កូន របស់ អ្នក ជាពិសេស ប្រសិនបើ កូន របស់ អ្នក មាន ទូរទស្សន៍ នៅក្នុង បន្ទប់ គេង របស់ ពួកគេ ឬ គ្រួសារ ទាំងមូល ញ៉ាំ អាហារ នៅមុខ ទូរទស្សន៍ នោះ ។
រដ្ឋាភិបាល ថ្មី គួរ បញ្ចប់ ការកាប់បំផ្លាញ ព្រៃឈើ
មិច៌្ឆត្ត ធម វិគី ភីឌា
ម៉ាដូណា ចេញ បទ ថ្មី ទៀត ហើយ ក្រោយ បទ ក្ងោក ផ្ទុះ បញ្ហា មាន វិដេអូ
ការកេងចំណេញ ពី ផ្សារ ពីរៈ ការទិញ និង លក់ ទ្រព្យសម្បត្ត ដូិច គ្នា ក្នុង ពេល តែ មួយ នៅ ទីផ្សារ ពីរ ផ្សេង គ្នា
ព្រឹត្តិការណ៍ នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ជួយ ជំរុញ វិស័យ សិល្បៈ ពិសេស វិស័យ ភាពយន្ត កាន់តែ ប្រសើរឡើង ។
គួរ រំលឹក ថា គម្រោង កំណាត់ ផ្លូវ ជាតិ សំខាន់ ៗ
នេះ បញ្ជាក់ ថា សំណុំរឿង នេះ ជា ចេតនា នយោបាយ ជាជាង ផ្លូវ ច្បាប់ ។
ឆ្លៀត ឱកាស ម្តាយ មិន នៅ ធ្វើ ទង្វើ បែប នេះ ដាក់ កូនស្រី ដល់ ទៅ ២នាក់
ខេមរៈ សេរី មន្ត បាន មុន្នីល័ក្ខឱ !
យើង សង្ឃឹម ថា យើង អាច ពិភាក្សា ម្តង ទៀត ក្នុង ពេល ឆាប់ ៗ
ជាច្រើន មិន សាលារៀនសូត្រ រឺក៏ ពួកគេ ទៅ សាលារៀន ដែល មិន មាន ការ គ្រប់គ្រង់ ល្អ ។
នេះ ជា ហេតុ ធ្វើឱ្យ ការផ្តល់ សេវា នៅ តំបន់ ជនបទ នៃ បណ្តាល ខេត្ត ដែល ជា កន្លែង ប្រជាជន កម្ពុជា ភាគ ច្រើន កំពុង រស់ នៅ មិន បាន គ្រប់គ្រាន់ ៕
សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ វិលត្រឡប់ មកដល់ កម្ពុជា វិញ ហើយ
យប់ នេះ ពិតជា មាន ជម្រើស ច្រើន ណាស់ សម្រាប់ អ្នក ចូលចិត្ត តន្ត្រី !
អ្នកនាង ខាត់ សុឃីម បាន ប្រាប់ ថា ៖
ជាទូទៅ ពលរដ្ឋ ចេញ ទៅ បោះឆ្នោត ដោយ …
នេះ បើ តាម របាយការណ៍ ថ្មី មួយ ចេញ កាលពី ម្សិលមិញ ។
ប្រសិនបើ អ្នក ចង់ រៀន អ្វី ឆាប់ ទទួលបាន លឿន រហ័ស សូម ដើរស ន្សឹម ៗ
អង្គការ ចំនួន ៦៥ទទូច ឱ្យ ដោះលែង អ្នកស្រី ទេព វន្នី ជាបន្ទាន់
ប្រពន្ធ ចេះតែ ឱប អង្អែល ។
ការស្រោប ផ្ទៃ ណាណូ ច្បាស់ ល្អ ពី គ្រប់ មុំ
អ្នក ចូលចិត្ត ដើរលេង ច្រើន ថែមទាំង ចូលចិត្ត ធ្វើដំណើរ ហើយ រុករក អ្វី ថ្មី ៗ
ចំណែកឯ កីឡាករ ហាមីតុន ដែល ត្រូវ អាឡុន សូវ៉ា យក ចំណាត់ លេខ ២បាន នោះ បាន និយាយ ថា យើង បាន ចាប់ផ្តើម បាន យ៉ាង ឥត ខ្ចោះ ហើយ ប៉ុន្តែ ដោយសារតែ មាន កំហុសឆ្គង បន្តិចបន្តួច ទើប ធ្វើឱ្យ យើង ទទួលបាន លទ្ធផល ដូចនេះ ។
គ្រូ ជំនួយ ការ ក្រុម ជម្រើសជាតិ អង់គ្លេស វ័យ ៤០ ឆ្នាំ រូប នេះ បញ្ជាក់ បន្ថែម ៕
អ្នកគាំទ្រ សម្រុក ចូល មើល ខ្លាំង តាំងពី ម៉ោង ៣រសៀល ម្ល៉េះ !
អ្នកឃ្លាំមើល ថា បទល្មើស បាញ់ សម្លាប់ គ្នា រវាង ជនជាតិ ចិន និង ជនជាតិ ចិន នៅ ខេត្ត ព្រះសីហនុ មិន ថមថយ ទេ
