រឿងរ៉ាវ ទាំងអស់ នេះ ប្រហែលជា ម្ខាង ៗ
ចំនែក ឯ អ្នក ដទៃ ទៀត បាន បញ្ចេញមតិ ថា សូម ចាប់ខ្លួនខ្ញុំ មក និង ខ្ញុំ លង់ ស្រលាញ់ អ្នក ហើយ ទៀតផង ។
ទន្ទឹមនឹង នេះ គ្រាប់ មីន គឺ បាន រារាំង ដល់ ការដាំដុះ ដំណាំ កសិកម្ម របស់ ប្រជាពលរដ្ឋ ផងដែរ ។
ជាមួយ នៃ ការចាប់ខ្លួន សមត្ថកិច្ច ក៏ បាន រកឃើញ និង ចាប់ យក បាន វត្ថុតាង មួយចំនួន ផងដែរ រួម មាន ៖
ជាង ១០អង្គ ដែល មាន
កូន បាត់បង់ ការសិក្សា ។
ដែរ កុំ ឱ្យ ប្រិយមិត្ត ចាំ យូរ មក ទស្សនា វីដេអូ ខាងក្រោម ជាមួយគ្នា ៖
ទិដ្ឋាការ របស់ លោក នឹង ត្រូវ ផុត កំណត់ នៅ ថ្ងៃទី ២០ ខែកុម្ភៈ ឆ្នាំ ២០១៥ ហើយ អាជ្ញាធរ បាន បដិសេធ មិន បន្ត ទិដ្ឋាការ ឱ្យ លោក ទៀត ទេ ។
សម្តេច បញ្ជាក់ ទៀត ថា ការសម្រេច អនុគ្រោះ ពន្ធ នេះ សម្តេច តេជោ ទើបតែ សម្រេច នៅ ថ្ងៃទី ០៥ ខែមីនា ឆ្នាំ ២០១៩ ម្សិលមិញ នេះ ។
តែងតាំង កូន អញ្ចឹង វា ធ្វើឱ្យ មាន វិប្បដិសារី ដល់ ឧត្តម មន្ត្រី មួយចំនួន ដែល នៅក្នុង ស្ថាប័ន ហ្នឹង ។
ប្រទេស កម្ពុជា ស្ថិត នៅក្នុង ចំណោម ប្រទេស ចំនួន ១០ ដែល ស្ថានភាព សិទ្ធិ សេរីភាព បាន ធ្លាក់ចុះ យ៉ាង ខ្លាំង ។
តារា សម្តែង ស្រី អ្នកនាង សឿសុធារ៉ា កាលពី ថ្មី ៗ
ករណី រថយន្ត ៣ គ្រឿង បុក បន្ត រកន្ទុយ គ្នា បណ្តាលឱ្យ …
សូម្បីតែ ឯកសារ ទាំង សំណេរ ទាំង រូបថត និង ភាពយន្ត ឯកសារ នានា ក៏ បាន បញ្ជាក់ ពី ចំណុច ទាំង នេះ ដែរ ។
ដូច គេ បន្សុទ្ធ ប្រាក់ នោះ ទេ
បច្ឆាម រណនាម របស់ ទ្រង់ គឺ ព្រះបាទ បរម និស្កលបទ ។
ផ្លូវ ព្រះសុធារស់ ដាក់ របាំង ដែក ដើម្បីឱ្យ អ្នកធ្វើដំណើរ ដឹង ថា ជា ផ្លូវ ឯក ទិស
តាម បណ្តា អ្នកសង្កេត ការ ថា ទទួលបាន នូវ
ចប់ បព្វជ្ជា របស់ ព្រះសារី បុត្ត និង ព្រះមោគ្គល្លាន ។
កន្លែង ថើប ដែល ធ្វើឱ្យ មនុស្ស ស្រី ព្រឺ រោម
ក៏ប៉ុន្តែ រដ្ឋសភា មិន បាន លើក យកមក ពិចារណា ឡើយ ។
ស្តង់ដារ ឌីន ឌីន ។
ពេល ដែល ខ្ញុំ ពិចារណា អំពី រឿង នេះ ខ្ញុំ ក៏ បាន នឹកចាំ ថា ព្រះបាន បង្កើត របស់ សព្វ សារពើ ក្នុង ចំនួន ដ៏ ច្រើន លើស ពី ការរំពឹង គិត របស់ យើង ។
លី គកំពូល កម្ពុជា ៖
អនុប្រធាន ទី២ រដ្ឋសភា ពី អតីតកាល កម្ពុជា ត្រូវ ប…
នេះ ជា ពាក្យ ដ៏ ត្រឹមត្រូវ និង មាន ប្រយោជន៍ ខ្លាំង សម្រាប់ មនុស្ស គិត ហើយ អនុវត្ត ។
គេ ខំប្រឹង ដើម្បី ប្រជាជន ឯង ថា អោយ គេ ។
មិន មាន ការយកចិត្តទុកដាក់ នូវ អ្វី ដែល សង្សា ខ្លួន ត្រូវការ
ខ២ក្នង ពូល ណាមួយ
សម្រាប់ សវនាការ នៅ ព្រឹក ថ្ងៃពុធ លោក សង្ឃឹម ថា
ការងារ រីកចម្រើន សមត្ថភាព របស់ អ្នក ត្រូវបាន គេ ទទួលស្គាល់ វាយតម្លៃ ខ្ពស់ ។
បើ អ្នកឯង តាំង ខ្លួន ជា ភេរវករ ហើយ ខ្ញុំ នឹង តាម យក អ្នកឯង ឱ្យ ទាល់តែ បាន ។
ខណៈ ដែល ការប្រណាំង ទូក គឺជា កីឡា ប្រពៃណី ដ៏ ពេញនិយម របស់ ប្រជាជន កម្ពុជា ហើយ មាន ទូក ង ទូក មួង រាប់ រយ បាន ចូលរួម ប្រកួត នៅ ឆ្នាំ នេះ ។
បទ សិក្សា ខ្លី លេខ ១៦២ស្តិ អំពី ៖
ប៉ុន្តែ នរណា បាន ពិសាមុខ ម្ហូប នេះ ម្តង គឺ មិន អាច បំភ្លេច បាន នូវ រសជាតិ ដ៏ ឈ្ងុយ ឆ្ងាញ់ របស់ វា ឡើយ ៕
ស្រមប់ ព័ត៌ មនបែន ថមេ ទៀត សូមេ មើល ឯក
ពើ ទីម៉ាល់ ឬ កម្រិត តូច ៖
ប៉ិន ខ្ញុំ មិន ទាន់ ចូល ដោះស្រាយ ទេ ដោយសារ នាយក អត់ នៅ ។
នេះ គាត់ បាន នាំ កូន របស់ គាត់ ទៅ ចុះឈ្មោះ ចូល រៀន នៅ សាលា បឋមសិក្សា សន្ធរ ម៉ុក ។
៨នាក់ ត្រូវបាន សម្លាប់ និង ជាង
អ្នកយកព័ត៌មាន រូប នោះ បាន បន្ត ថា ប្រព័ន្ធ ការពារ គ្រាប់ មីស៊ីល នោះ ត្រូវបាន ដាក់ នៅ ភាគ ខាងលិច នៃ រដ្ឋធានី ។
ការគ្រប់គ្រង នៅ ទីនេះ ឃើញ មាន ភាព រលូន ត្រឹមត្រូវ ល្អ ។
ជនរងគ្រោះ ទាំងអស់ សុទ្ធតែ ជា កម្មករ ដោយ អ្នកស្លាប់ មាន អាយុ ប្រមាណ ១៦ ឆ្នាំ ៕
រាងកាយ ដែល គ្មាន វិញ្ញាណ របស់ យ៉ន នីត្រូវ នាំ ឡើង យន្តហោះ ព្រម គ្នា ជាមួយ អ្នកដំណើរ ផងដែរ ។
្រពះត សេន្រ ទង្រ គប្រ់់ះ គង៉ិ
ឥឡូវ យើង ក្រឡេក មក មើល ស្ថានភាព នៅពេល បច្ចុប្បន្ន នេះ វិញ ។
យើង នឹង ព្យាយាម សម្រេច ពី មូលហេតុ នេះ នៅពេល ឆាប់ ៗ
ៀត ថា ក្នង យន្តការ
លើក ក្រោយ មាន បទ ចំរៀង អង់គ្លេស ពីរោះ ៗ
ថ្លែង ក្នុង កិច្ចពិភាក្សា នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា ប្រជាជន វៀតណាម ពិតជា អរគុណ និង មាន មោទនភាព ចំពោះ ក្រុម វេជ្ជបណ្ឌិត ណាស់ ។
អាយុ ចាប់ពី ៤ ឆ្នាំ ចុះ មនុស្ស ចាស់ អាយុ ចាប់ពី ៦៥ ឆ្នាំ ឡើង អ្នក ធាត់ ៗ
មកវិញ ហើយ ពូពិសិដ្ឋ !
១ស្បែក ស្លេកស្លាំង
នឹង ត្រូវ ខ្មាំង សត្រូវ នាំយក ទៅ ។
ខ្ញុំ មាន ការពិបាក ច្រើន ចំពោះ ការប្រើ យូនី កូដ ខ្មែរ ។
ដែល មក ពឹងពាក់ អ្នក ឡើយ ។
ករណី គ្រោះថ្នាក់ អគ្គិភ័យ នេះ មិន បង្កឱ្យ មាន រងរបួស ឬ ស្លាប់ ឡើយ ។
ទឹក ជំនន់ ខ្លាំង បង្ខំ មនុស្ស រាប់ ពាន់ នាក់ ចាកចេញ …
ជាធម្មតា មិន មាន ប្រទេស ណា ដែល មាន ឯករាជ្យ ពេញ ១០០ ភាគរយ នោះ ទេ កូណា គិត អញ្ចឹង រឿង នេះ វា ដូច រឿង យុត្តិធម៌ អញ្ចឹង ដែរ ។
របស់ ពួកគេ អោយ បាត់ អស់ ពី ផែនដី
លោកស្រី ទេពធីតា លើ ផ្លូវ នយោបាយ បក្ស ប្រឆាំង មាន សំឡេង
ចំពោះ ពុទ្ធ អ៊ុំ អ៊័ន ខ្ទាត ចេញពី ការប្រកួត ត្រឹម នេះ ទាំង ព្រលឹម ដែរ ។
ហ្ហែង ត្រូវ ចាំ ទៅ ។
ទោះជា យ៉ាងណា ទូរស័ព្ទ ដៃ ស៊ាំ ស្ស៊ុង ហ្គាឡាក់ស៊ីហ្គោល ដិន នេះ ទើបតែ ប្រកាស ចេញ នៅក្នុង ប្រទេស កូរ៉េ ខាងត្បូង តែ ប៉ុណ្ណោះ ។
បិទែតម បេផមៃ បសណីយ៍ ក៏ន ។
ការបង្ហាញ នូវ ការលើក សរសើរ នេះ អាច ធ្វើឡើង តាម ច្រើន បែប ច្រើន វិធី ហើយ វា មិន មែន ចេះតែ អាច ធ្វើ បាន តាមរយៈ ការដំឡើង ប្រាក់ខែ ឬ លុយ បន្ថែម នោះ ទេ ។
យើង ពុំ ចង់ឱ្យ មាន គ្រោះថ្នាក់ ដល់ អាយុជីវិត មនុស្ស ឡើយ ។
យើង ពិតជា សប្បាយ ណាស់ ដែល មាន អ្នកធ្វើការ ជាមួយ ។
អ្នក ត្រើយ ខាងណោះ គ្រប់គ្រាន់ ទេ ។
ចាំ មើល អ្នកណា រក សង្សារ បាន មុន កែវ វាសនា
ហើយ លោក ម៉ូសេទទួល ទោស ព្រោះតែ ពួកគេ
ជាក់ស្តែង លោក បាន មក ចូលរួម គ្រប់ ចំនួន ១០ដង សរុប ទាំង លើក នេះ ហើយ ។
តើ អ្នក នឹង ធ្វើ ចំណង មិត្តភាព ជាមួយនឹង អ្នកប្រើប្រាស់ ប្លក់ ផ្សេង ទៀត ទេ ?
មាណ ព ទាំងឡាយ ឆ្លើយ ថា អម្ពដ្ឋ ជា អ្នក មាន កំណើត ល្អ មាន ត្រកូល ខ្ពស់ គួរ ឆ្លង ឆ្លើយ ជាមួយ ព្រះអង្គ ហើយ ។
ចំណែក ទំនាស់ រវាង ពលរដ្ឋ និង ក្រុមហ៊ុន បន្ត កើតមាន រហូត បច្ចុប្បន្ន ៕
សក់ គឺជា ផ្នែក មួយ ដ៏ សំខាន់ សម្រាប់ រក្សា ។
ចុច ត្រង់នេះ ដើម្បី បន្ត តាមដាន អត្ថបទ ហ្គេម ដទៃ ទៀត
៦ល្បឿន ទិន្នន័យ
ហើយ យើង មាន ទិសដៅ អនុវត្ត ដោយ មាន ការអនុញ្ញាត ពី សម្តេច ក្រឡាហោម រួចហើយ ។
យើង សូម កត់សម្គាល់ កីឡាករ មួយចំនួន ដែល នឹង អាច មក លេង នៅ អង់គ្លេស ។
អាល្លឺម៉ង់ ត្រៀម កាត់បន្ថយ យ៉ាង ច្រើន នូវ ថវិកា យោធា
នាយក រដ្ឋមន្ត្រី អង់គ្លេស បង្ហើប ថា លោក ដូណាល់ ត្រាំ បញ្ចេះ ឱ្យ អង់គ្លេស ប្តឹង អឺរ៉ុប
ខ្សែ ប្រយុទ្ធ វ័យ ៣៣ ឆ្នាំ ឆ្លើយ ៖
ទោះជា យ៉ាងណា កិច្ចសហការ សហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ នៅតែ មាន កំណើន … មិន អញ្ចឹង ?
ការជូនដំណឹង លើ ផ្ទៃ តុ រុញ កម្មវិធី រុករក ទំនើប ផ្តល់ ជូន នូវ ឱកាស ការជំរុញ ការជូនដំណឹង ។
លោក បាន បន្ត ថា រដ្ឋាភិបាល នឹង មិន ទទួល នូវ សំណើរ អ្វី ផ្សេង ពី នេះ សម្រាប់ ការផ្ទៀត ផ្ទាត់ ផែនទី នេះ ទៀត ឡើយ ។
ខ្ញុំ ស្វាគមន៍ ជានិច្ច ប្រសិនបើ អ្នក ចង់ រក កំហុស ខ្ញុំ សូម ធ្វើ ចុះ ខ្ញុំ មិន ខ្លាច ទេ ។
បើ គ្មាន អ្នកណែនាំ ក៏ លោក សង្ឃ នេះ មិន អាច ធ្វើ អ៊ីចឹង ដែរ ។
ប្រសិនបើ អ្នក មាន ជំងឺ លើស សម្ពាធ ឈាម នោះ អ្នក នឹង ត្រូវ ធ្វើ ការតានដាន ពី សម្ពាធ ឈាម របស់ អ្នក នៅ ផ្ទះ ដោយ ខ្លួនអ្នក ។
ខ្ញុំ មាន ភស្តុតាង ថ្មី ៗ
ប្រធាន សម្ព័ន្ធ សហជីព ចលនា កម្មករ លោក ប៉ាវ ស៊ីណា មានប្រសាសន៍ ថា ក្នុង ពេល ថ្មី ៗ
ក្រសួង សម្រេច មិន ដោះស្រាយ ទំនាស់ ដី ឱ្យ ពលរដ្ឋ ២៩២ គ្រួសារ
កម្មវិធី នេះ បាន រៀបចំ អស់ រយៈពេល ១៨ ឆ្នាំ មកហើយ ។
សន្មត ថា ចំពោះ គ្រប់ ។
ក្រោយពេល បុគ្គលិក អាច សម្រេច គោលដៅ នោះ តាម កាល កំណត់ ក្រុមហ៊ុន នឹង ផ្តល់ ជា ប្រាក់ រង្វាន់ ដល់ បុគ្គលិក ឆ្នើម មួយ ចំនួន ឬ បុគ្គលិក ទាំងអស់ ជា ការលើកទឹកចិត្ត ។
លោក គិត ថា ក្រុមហ៊ុន ទូរស័ព្ទ នឹង ផលិត ស៊ីម ប្រភេទ ថ្មី នេះ នា ពេល ឆាប់ ៗ
អកុសល ធម្មសូត្រ ៣៧៣៨
ប្រសិនបើ អតិថិជន
ការងារ សព្វមុខ ប្រព្រឹត្តទៅ យ៉ាង រលូន ។
យោធា សហរដ្ឋ អាមេរិក បដិសេធ ចំពោះ ការសហការវាយប្រហារ តាម ដែន អាកាស ជាមួយ ប្រទេស រុស្ស៊ី
ទំនាក់ទំនង យូរអង្វែង ជាមួយ បណ្តា ប្រទេស ជាវ ខាង យោធា នៅ ជុំវិញ ពិភពលោក បាន ជួយ ឱ្យ អាមេរិក ទទួលបាន ការបញ្ជាទិញ ជាច្រើន ពី បណ្តា ប្រជាជាតិ ដែល បាន ប្រើ ប្រព័ន្ធ សព្វាវុធ អាមេរិក ក្នុង រយៈពេល កន្លងមក នេះ ។
សូម សួរ អ្នក នៅ កូរ៉េ បន្តិច ខ្ញុំ ចង់ ដឹង ចំណងជើង បទ ចំរៀង កូរ៉េ ខ្ញុំ អត់ ចេះ កូរ៉េ ទេ ។
សូម ថ្លែងអំណរ អរគុណ ចំពោះ សាលាក្រុង ដែល បាន ផ្តល់ ជា អនុសាសន៍ …
៧ ទេវតា របស់ ព្រះអម្ចាស់ បាន ជួប នាង នៅក្បែរ ប្រភព ទឹក មួយ ក្នុង វាល រហោស្ថាន តាម ផ្លូវ ទៅ ស្រុក ស៊ើរ ។
ការកើនឡើង កំដៅ បង្ខំឱ្យ ក្រសួង …
គេ បាន កត់សម្គាល់ ថា ប្រទេស ជប៉ុន គឺជា ប្រទេស មហា មិត្ត របស់ កម្ពុជា មួយ ដែរ និង បាន ផ្តល់ ជំនួយ ច្រើន រយ លាន ដុល្លារ អាមេរិក ក្នុង មួយ ឆ្នាំ ៗ
ការគ្រប់គ្រង ទឹក ក្នុង សួន ដំណាំ លក្ខណៈ គ្រួសារ ក្នុង រដូវ ប្រាំង និង រដូវ វស្សា
ដែល ពួកយើង បាន ធ្វើ ។
ទន្ទឹមនឹង បញ្ហា នេះ ខ្ញុំ ក៏ នឹក ដល់ រឿង កំប្លែង មួយ ដែល និយាយ ពី បន្ទប់ទឹក នៅ តាម ស្ថានីយ៍ ប្រេង ឥន្ទធនៈ ។
សកម្មភាព ដដែល ៗ
ព្រហ្មទណ្ឌ នីតិពុទ្ធិ
ល្បែង កម្សាន្ត ជួយ ឱ្យ កូន កាន់តែ រឹងមាំ
អ្នក ប្រណិបតិ ន៏ និង អ្នកបដិបត្តិ ន៏ មាន បំណង ខុសប្លែក គ្នា ។
បេក្ខជន មាស សាម៉ន
នេះ ជា លើក ទី១ សម្រាប់ អ្នកស្រី រ៉ាំឌឿន ដែល បាន មក មើល ល្ខោន យីកេដុំ កង់ ។
ហើយ ខ្ញុំ ក៏ សូម ប្រាប់ ទៅ អាណាព្យាបាល ផងដែរ ត្រូវតែ ធានា ថា ឱ្យ កូន ៗ
នាយក រដ្ឋមន្ត្រី អេត្យូពី ឈ្នះ ពានរង្វាន់ ណូប៊ែល សន្តិភាព ឆ្នាំ ២០១៩
៥ឧបសគ្គ ដ៏ ធំ បំផុត ដែល នាំ ទៅ រក ការរុករកឃើញ ពុំ មែន ជា ភាពល្ងង់ខ្លៅ នោះ ទេ តែ គឺជា ការបោកបញ្ឆោត នៃ ចំណេះដឹង ។
អា នេះ ដែល យើង ធ្វើ សវនកម្ម ពីរ ទៀត ហើយ នៅ ខែ៣បាន យើង ចេញ របាយការណ៍ ចុងក្រោយ ។
បន្លែ មួយ នេះ អាច ព្យាបាល បញ្ហា សុខភាព យ៉ាងតិច ៥ !
ហើយ តែង បន្ធូរបន្ថយ និង ពន្យារ ពេល នៃ ការសង បំណុល ដើម្បីឱ្យ ពួកគេ អាច មាន លទ្ធភាព សង បាន ។
ពួកគេ នឹង រស់ យ៉ាង សុខសាន្ត នៅលើ ទឹកដី របស់ ខ្លួន ។
អំពើ ឃាតកម្ម មួយ បាន កើតឡើង បង្ហូរ ឈាម ស្រស់ ៗ
ហើយ ពេល នោះ ក៏ គ្មាន សេចក្តីស្លាប់ ដែរ ។
ចាន់ ណារ៉ូ ណាន ៖
មិន ត្រឹមតែ ប៉ុណ្ណោះ ភាពតានតឹង បែប នេះ អាច ផ្តល់ ជា គ្រោះថ្នាក់ ដល់ សុខភាព យើង ច្រើន យ៉ាងណា ដែរ ។
និង ភាពងងឹត នៅក្នុង ខ្យល់ព្យុះ ព្រះយេស៊ូវ ក៏ បាន យាង មក រក ពួកគេ ដោយ ដើរ នៅលើ ទឹក រលក ដែល កំពុង បក់ បោក ខ្លាំង ដោយសារ ខ្យល់ព្យុះ ។
រាក អាច បណ្តាល មកពី កត្តា មួយ ចំនួន ។
ប៉ុន្តែ បើ បើក យឺត មិន ទៀងទាត់ ប្រចាំ ខែ នាំឱ្យ ប៉ះពាល់ ការសិក្សា របស់ កូន ៗ
ក្នុង ឆ្នាំ ២០១៧ អ្នក ញៀន គ្រឿងញៀន មាន ចំនួន ១៤៧៨២ នាក់ ដែល ទទួល ការព្យាបាល នៅ តាម មូលដ្ឋាន សុខាភិបាល សាធារណៈ និង មណ្ឌល បណ្តោះអាសន្ន ។
ប្រទេស ភាគ ច្រើន នៅក្នុង តំបន់ អាហ្វ្រិក និង អាស៊ី ត្រូវ ស្ថិត ក្រោម ការកាន់កាប់ របស់ មហា អំណាច អាណានិគម អឺរ៉ុប ។
