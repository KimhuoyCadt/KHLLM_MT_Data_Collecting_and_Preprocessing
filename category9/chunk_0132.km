មាន តែ ព្រះអង្គ ទេ ដែល អាច កសាង បងប្អូន ឡើង ជា ក្រុម ជំនុំ ព្រមទាំង អោយ បងប្អូន ទទួលមត៌ ក រួម ជាមួយ ប្រជាជន ដ៏ វិសុទ្ធ ។
ព្រួយបារម្ភ ជាង គេ គឺ ខ្លាច គេ បណ្តេញ ហ្នឹង តែម្តង ។
លោក ត្រាំ កំពុងតែ ធ្វើឱ្យ ឥទ្ធិពល យោធា របស់ អាមេរិក ធ្លាក់ចុះ
សមាជិក គ្រួសារ ខ្ញុំ ជាច្រើន ត្រូវបាន សម្លាប់ ។
ដោយឡែក ការនិយាយ ស្តី
គាត់ មិន ដែល ក្បត់ តែង នៅក្បែរ ខ្ញុំ និង ជា អ្នក ផ្តល់ ភាពកក់ក្តៅ បំផុត ។
ការប្រព្រឹត្ត ត្រឹមត្រូវ ឬ ការប្រព្រឹត្ត ល្អ ហេតុ នោះ ទើប ឈ្មោះ ថា សុចរិត សុដ្ឋុ ចរិតា និ, សុន្ទរា និវា ចរិតា នីតិសុចរិតា និ។
ពួកយើង អាច ធ្វើ កិច្ចការ នេះ បាន រាល់ ថ្ងៃ ។
បើសិន ខ្ញុំ ចូល កៀក អាច ប្រើ ជង្គង់ បាន ល្អ ។
ពិធី នេះ ក៏ មាន បង្ហាញ ម្ហូប អាហារ ខ្មែរ ផងដែរ ។
នៅ ស្ថាន សួគ៌ មិន មាន ការរស់នៅ ជា ប្តី ប្រពន្ធ ដូច នៅ ផែនដី ឡើយ ។
ឥទ្ធិពល ទាំងនេះ ភាគ ច្រើន គឺ ពី ប្រទេស ចិន ដែល ក្លាយជា ប្រភព ជំនួយ អភិវឌ្ឍន៍ ផ្លូវការ ODA ចំបង ។
កំសាន្ត ជាមួយ ខ្ញុំ ស្នាមញញឹម
តែងតែ ត្រូវការ ការសើច សប្បាយ ផងដែរ ។
យើង ឃើញ រឿង នេះ កើតឡើង ក្នុង ប្រទេស កម្ពុជា ។
គួរតែ ជ្រើសយក ផលិត ណា ដែល មិន ធ្វើឱ្យ ស្បែក អ្នក ស្ងួត ។
អំពី អត្ថប្រយោជន៍ នៃ ជីវិត រស់ នៅ របស់ ពួកគេ ចំពោះ ភ្នែក អ្នក មិន ជឿ នៅលើ ផែនដី នេះ ។
នៅ មន្ទីរពេទ្យ វិកលចរិត អ្នកជំងឺ ពីរ នាក់ និយាយ គ្នា ៖
ភិក្ខុ ទាំងនោះ ក្រាប ទូល សេចក្តីនុ៎ះ ចំពោះ ព្រះ មាន ព្រះភាគ ។
គេ មាន របប ពាណិជ្ជកម្ម គេ ត្រឹមត្រូវ អញ្ចឹង គេ មិន មែន នឹកឃើញ បិទ នឹកឃើញ បើក ទេ !
ក្រោយមក ពាក្យ ចចាម ទំនាក់ទំនង ស្នេហ៍ នេះ ត្រូវបាន បំបិទ ចោល ដោយ ភ្នាក់ងារ របស់ ពួកគេ ដែល បាន អះអាង ថា ពួកគេ ជា មិត្តភ័ក្តិ នឹង គ្នា ប៉ុណ្ណោះ ។
អាល់ដែន បាន និយាយ ថា សេតវិមាន អាច អួត អាង ថា វា ជា ការដាក់ លក្ខខណ្ឌ ដ៏ ម៉ឺងម៉ាត់ លើ ចិន និង ថា តាម បច្ចេកទេស លោក បាន សំរេច កិច្ចព្រមព្រៀង មួយ ជា អ្វី មួយ ដែល លោក បាន សន្យា ចំពោះ អ្នកបោះឆ្នោត កាលពី ឆ្នាំ ២០១៦ ។
ក្នុង ជីវិត នេះ សេចក្តីស្រឡាញ់ របស់ យើង ចំពោះ ទ្រង់ មិន ទាន់ ជាល្អ ឥត ខ្ចោះ នៅឡើយ ទេ ។
មើល ទៅ ដូចជា ដើមឈើ ។
ថា ពួកគេ ចង់ ទៅ ណា ប្រសិនជា ពួកគេ មាន ឱកាស ហើយ ប្រាប់ អ្នក ថតរូប ឱ្យ ផលិត រូបថត របស់ ពួកគេ ក្នុង ទីតាំង ដែល ជា ក្តី សុបិន របស់ ពួកគេ ។
អ្នក រាល់គ្នា បាន ចាប់ផ្តើម ដោយ វិញ្ញាណ តើ ឥឡូវនេះ បញ្ចប់ ដោយ សាច់ ឈាម ឬ ?
សាក ទាយ មើល៍ កំពូល មេដឹកនាំ ពិភពលោក ចូលចិត្ត ប្រើ ទូរសព្ទ ម៉ាក អី ខ្លះ ?
ឥឡូវនេះ ការចុះឈ្មោះ បាន ចាប់ បើក ហើយ ចុច ទីនេះ ដើម្បី ចុះឈ្មោះ នេះ ជា របៀប ចុះឈ្មោះ
ទាំង១០ ដើម្បី កម្ចាត់ អាការៈ ឈឺ ក្បាល
ទោះបីជា បែប ណា មិន បណ្តាលឱ្យ មាន មនុស្ស ណា ម្នាក់
ប៉ុន្តែ ពួកគេ ហាក់ដូចជា មិន រវល់ ចង់ បន្ត កុងត្រា ទៀត ទាល់តែសោះ ។
តើ នរណា ប្រគល់ ពិភពលោក ទាំងមូល
ពិពាហ៍ បើ យល់ស្រប គ្នា ហើយ ត្រូវ ប្រុងប្រៀប ៖
យើង ក៏ គ្មាន សមុទ្រ ។
ក្មេងស្រី រងគ្រោះ ឈ្មោះ ថ សភ ។
ព្រះគម្ពីរ បាន លើកទឹកចិត្ត យើង កុំ ឱ្យ មាន ការភ័យខ្លាច ១ពេត្រុស ៣១៤តែ ត្រូវ កោតខ្លាច ព្រះអម្ចាស់ នៅក្នុង ចិត្ត យើង វិញ ខ. ១៥ ។
ពាក់កណ្តាល ខែ នេះ នឹង មាន ការប្រកួត មិត្តភាព អន្តរជាតិ កម្ពុជា - ចិន ចំនួន 2ប្រកួត
ចំណុច ដែល អ្នក ត្រូវ ដឹង ក្នុង ការថែទាំ សុខភាព មាត់ ធ្មេញ ឱ្យ មាន សុខភាព ល្អ
ខ្លួន ដូច ខាងក្រោម ៖
មិត្ត ប្រុស របស់ ខ្ញុំ ប្រាកដជា អន្ទះសារ ទន្ទឹងរង់ចាំ ខ្ញុំ មិន ខាន ។
នៅពេល ជ្រើសរើស បែបបទ ចាំបាច់ ត្រូវ ជ្រើសរើស បែបបទ អាទិភាព ៕
ទោះបី ពួកយើង ខុសគ្នា គ្រប់ យ៉ាង ក៏ដោយ ចុះ តែ អ្វី ដែល ពួកយើង មាន រួមគ្នា គឺជា សេចក្តីស្រលាញ់ របស់ ពួកយើង ចំពោះ គ្នា ទៅ វិញ ទៅមក ។
មាន ការរិះគន់ ជាច្រើន ចំពោះ ការដឹកនាំ របស់ រដ្ឋាភិបាល ប្រេស៊ីល បច្ចុប្បន្ន ដែល បណ្តាយ ឱ្យ ហេតុការណណ៍ នេះ កាន់តែ ធំ ៕
លោក បាន អះអាង ថា កម្ពុជា មាន កម្លាំង ពលកម្ម ច្រើន ។
រីករាយ ណាស់ ដែល បណ្ឌិត ចាប់អារម្មណ៍ !
លោកគ្រូ អ្នកគ្រូ ត្រូវ មាន ស្មារតី ប្រឹងប្រែង ដើម្បី
ក្មេងស្រី កំរិត វិទ្យាល័យ សោះ !
ប៉ុន្តែ ខ្ញុំ គិត ថា គាត់ ត្រូវតែ ចាកចេញ ។
ជា ការណ៍ ពិត សាលា ក្តី ឥត ដែល ផ្សព្វផ្សាយ ជា ផ្លូវការ នូវ ឈ្មោះ របស់ ជនសង្ស័យ នៅក្នុង សំណុំរឿង នេះ ទេ ។
ពីព្រោះ ឧស្ម័ន កាបូនិក នេះ អាច ស្ថិត នៅក្នុង ខ្យល់ រាប់ សិប ពាន់ ឆ្នាំ និង កាន់ យូរ ខ្លាំង ទៀត បើ នៅក្នុង ទឹក ។
អរគុណ សម្រាប់ ចំណាប់អារម្មណ៍ !
១៧គ្រា នោះ លោក ហាដាឌ នៅជា កុមារ នៅឡើយ លោក បាន រត់គេចខ្លួន ទៅ ស្រុក អេស៊ីប ជាមួយ ជនជាតិ អេដុម ខ្លះ ដែល ជា អ្នក បំរើ របស់ ឪពុក លោក ។
ព្រះជាម្ចាស់ ត្រាស់ ហៅ លោក ម៉ូសេអោយ រំដោះ ជនជាតិ អ៊ីស្រាអែល
យើង ងាយ នឹង រកមើលឃើញ ចំណុច សំខាន់ ៗ
លើ បបូរមាត់ ខ្ញុំ មួយ ភ្លែត មុននឹង ឆ្លើយតប ចេញមក ៖
កងទ័ព ទាំងមូល របស់ លោក ស៊ី សេរ៉ា ស្លាប់ ដោយ មុខ ដាវ គ្មាន សល់ ម្នាក់ ឡើយ ។
នៅ អាយុ ៤០ ឆ្នាំ មុខរបរ អ្នក នឹង អាច ឃ្លាត ឆ្ងាយ ពី ឧបសគ្គ ដោយ កាន់តែ ខិត ជិត ភាពជោគជ័យ ។
ព្រមទាំង ភាព ជា អ្នកដឹកនាំ ។
លីលី ឱ្យ ខ្ញុំ សូម ទោស ផង មិន គួរ ណា ខ្ញុំ ធ្វើឱ្យ នាង ពិបាកចិត្ត ដល់ ថ្នាក់ ហ្នឹង នោះ ទេ ។
ខ្ញុំ បាន អាប់ ឡូត អាល់ប៊ុម នេះ រួចហើយ ។
ដែល ឪពុក ម្តាយ អត់ មាន លទ្ធភាព ដូច ខ្ញុំ ជាដើម ។
ក្នុង ចំណោម ពួក អ្នកកាត់ ស្បែក មាន តែ អ្នក ទាំងនេះ ទេ ដែល ជា អ្នក រួម ការងារ សម្រាប់ នគរ ព្រះជាម្ចាស់ ហើយ បាន លើកទឹកចិត្ត ខ្ញុំ ទៀតផង ។
បើ វិបត្តិ នយោបាយ អូសបន្លាយ ទៀត វា នឹង ប៉ះពាល់ ដល់ វិស័យ អចលន ទ្រព្យ
ខ្ញុំ ជឿ ថា ផលិត ករ បរទេស នឹង ចាប់អារម្មណ៍ ដូច ខ្ញុំ ដែរ ។
វាសមហេតុសម ផល ណាស់ គាត់ ចង់ ចាប់រំលោភ ពួកយើង ។
អ្វី ដែល អ្នក ត្រូវ ធ្វើ គឺ អ្នក ត្រូវ ញ៉ាំ ល្ហុង អោយ បាន ច្រើន ។
កាលពី ថ្ងៃ ម្សិលមិញ ផែនការ បរិស្ថាន ជាតិ លើក ដំបូង របស់ ប្រទេស កម្ពុជា ក្នុង រយៈពេល ជាង មួយ ទសវត្សរ៍ ត្រូវបាន ចាប់ផ្តើម ។
ប៉ុន្តែ ពេល ដែល យើង បាន អាន សាច់រឿង របស់ ពួកគេ ពី ដើម ដល់ ចប់ នោះ យើង សង្កេតឃើញ ថា អ្នក ទាំងនេះ អាច ជម្នះ លក្ខណៈ ខ្វះខាត របស់ ខ្លួន ដោយ ជំនួយ ពី ព្រះហើយ នៅ ទីបំផុត ពួកគេ សុទ្ធតែ មាន ប្រយោជន៍ ចំពោះ ទ្រង់ ។
ហេតុ នេះ លោក មិន ចង់ មាន បញ្ហា ជាមួយនឹង សហគមន៍ នោះ ទេ ។
ឯ ការបំពេញ ពាក្យ សូម ចូល ប្រឡង នៅ ទីនេះ ៖
ទៀត ចាប់តាំងពី ដើម ឆ្នាំ នេះ មក ដែល ក្រុម អ្នកស្រាវជ្រាវ និយាយ ថា វា ជា ការរំលោភ យក ដី ។
ហោរា នៃ សាសន៍ អ៊ីស្រាអែល និង សាសន៍ យូដា
ដើម្បី អស់ លោក នឹង មាន លទ្ធភាព គ្រប់គ្រាន់ អាច កាន់ការ នោះ បាន ។
តើ យើង នឹង នៅតែ ស្តាប់ បង្គាប់ ទ្រង់ ដែរ ឬ ទេ ទោះ បើ ការស្តាប់ បង្គាប់ នោះ នាំឱ្យ យើង បាត់បង់ ប្រយោជន៍ ផ្ទាល់ខ្លួន ក៏ដោយ នោះ ?
ដូច្នេះ ប្រហែលជា ធ្វើឱ្យ អ្នកអាន ច្រើន គ្នា មិន យល់ ពី សាច់រឿង បាន ។
អ្នក គួរ ព្យាយាម គូរ ឱ្យ មើល ទៅ ធម្មជាតិ ហើយ ប្រើ ជក់ ស្តើង ៗ
ជានន្ត ញានា ផ្លាស់ ញា ជាជា ដឹង ឬ ត្រាស់ ដឹង
ព្រះយេស៊ូវ បាន យាង មក ក្នុង លោកិយ នេះ ដើម្បី បង្ហាញ សេចក្តីស្រឡាញ់ របស់ ព្រះតាមរយៈ ការប្រព្រឹត្ត ហើយ ដើម្បី ទទួល ការសុគត ដ៏ រន្ធត់ ដើម្បីឱ្យ យើង អាច ទទួល ការអត់ទោស បាប ។
មនុស្ស ជាច្រើន ភ័យខ្លាច ការ នៅ ម្នាក់ឯង ព្រោះ ពួកគេ មិន បាន គិត ថា នៅ ម្នាក់ឯង គឺជា ជម្រើស មួយ ឱ្យ យើង រៀន ស្វែងយល់ ពី ខ្លួន ឯង ឡើយ ។
១០ប៉ុន្តែ ហេតុ ដែល ខ្ញុំ បាន ដូច សព្វ ថ្ងៃ នេះ ក៏ មក តែ ពី ព្រះគុណ របស់ ព្រះជា ម្ចាស់ ប៉ុណ្ណោះ ។
របាយការណ៍ ដដែល នេះ បាន ឱ្យដឹង ថា ក្នុង ចំណោម អ្នកស្លាប់ ៦នាក់ នោះ មាន ស្រី ម្នាក់ ។
បុត្រា ព្រះអង្គម្ចាស់ វីល្លៀម ដាក់ ព្រះនាម ថា ចច តាម ការជ្រើសរើស បែប ប្រពៃណី
ប៉ុន្តែ ការផ្តាច់ សុរា នៅតែ ជា បញ្ហា លំបាក សម្រាប់ មនុស្ស មួយចំនួន ធំ ។
អ្នក ចិត្តវិទ្យា និង អ្នកប្រសាទ វិទ្យា បាន បញ្ជាក់ អំពី រឿង នេះ ។
នេះ បើ យោង តាម ការស្រាវជ្រាវ ។
ជាញឹកញាប់ នឹង កើតឡើង ក្នុង ដំណាក់កាល នេះ ។
គ្នា ក៏ដោយ ក៏ ពួកគេ មាន ភារៈ នាំសារ ទៅ វិញ ទៅ មក រវាង ពលរដ្ឋ និង ថ្នាក់ដឹកនាំ ប្រទេស ។
ហេតុ អ្វី បានជា កុំព្យូទ័រ របស់ ខ្ញុំ មិន អាច រកឃើញ ឧបករណ៍ របស់ ខ្ញុំ ?
ត្រូវ តម្កល់ តង្វាយ នោះ នៅ ចំពោះ ព្រះភក្ត្រ ព្រះអម្ចាស់ ជា ព្រះរបស់ អ្នក ហើយ ក្រាប ថ្វាយបង្គំ ព្រះអម្ចាស់ ជា ព្រះរបស់ អ្នក ។
អត់ ទេ ខ្ញុំ និយាយ ឡិកឡក់ លេង ជាមួយ ហ្នឹង
រៀងរាល់ ថ្ងៃ កម្មវិធី វិទ្យុ របស់ យើងខ្ញុំ ផ្តល់ ជូន ព័ត៌មាន ថ្មី ៗ
ព្រះអង្គ ម្ចសា់ ស៊ីសុវត្ថិធ ម្មិកោ ៖
ព្រះមហាក្សត្រ ប្រទាន ការលើកលែង ទោស ដល់ លោក សម រង្ស៊ី .
ប៉ុន្តែ ខ្ញុំ សង្កេតឃើញ មាន អាចម៍ ត្រចៀក ច្រើន ណាស់ តើ យើង គួរ សម្អាត បែប ណា ទៅ ?
លោក ហ៊ុន សែន ចង់ ធ្វើ សេចក្តីថ្លែងការណ៍ អំពី រឿង នេះ ។
ម្ចាស់ អាជីវកម្ម ទាំងអស់ ត្រូវ ទទួលស្គាល់ បរិបទ ថ្មី នៃ ការលូតលាស់ បច្ចេកវិទ្យា ទាំងនេះ ។
ទង្វើ របស់ គាត់ និង មេធាវី របស់ គាត់ ទាំងនោះ បាន ធ្វើឱ្យ ប៉ះពាល់ ដ៏ អាក្រក់ ដល់ កេរ្តិ៍ឈ្មោះ យុត្តិធម៍ ។
ដោយឡែក កញ្ញា សុខ ពិសី បាន និយាយ ថា សិល្បករ មួយចំនួន ដែល ធ្លាប់ ច្រៀង ថ្វាយ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហនុ ពិតជា មាន សំណាង ដោយ ទទួលបាន ការសន្តោស ប្រណី ពី ទ្រង់ ។
យើងខ្ញុំ តែងតែ ខ្វល់ខ្វាយ
និង គម្រោង របស់ បង ប្រុស ម្នាក់ ដែល ខ្ញុំ បាន រំលឹក ថា ជា អ្នកថត រូប សត្វ ស្លាប ។
រីឯ លោក អដាំ ចុងក្រោយ បង្អស់ បាន ទៅ ជា ព្រះវិញ្ញាណ ដែល ផ្តល់ ជីវិត ។
ដាក់ ទៅ តំបន់ ណា ដែល ងាយ រងគ្រោះ យើង ចាប់ផ្តើម មុន ។
តថាគត ស្សសាវតោ ប្រែ ថា សាវក នៃ ព្រះតថាគត ។
លោក ហ៊ុន សែន ប្រកាស មិន លើកលែង ឱ្យ អ្នកនយោបាយ កំពុង ជាប់ ឃុំ ទេ
ព្រះអង្គ ត្រាស់ សួរ ថា ម្នាល ភិក្ខុ អ្នកឯង មាន ចិត្ត គិត ដូចម្តេច ។
ទេសចរណ៍ ទាំងឡាយ នៅក្នុង ពិភពលោក គប្បី ត្រូវ មក ទស្សនា យ៉ាង ហោយ ណាស់ ឱ្យ បាន ម្តង នៅក្នុង ជីវិត ។
ខ្ញុំបាទ មាន ដី ធូរ ថ្លៃ ត្រូវការលក់ បន្ទាន់ ដូច ខាងក្រោម ៖
ប៉ុន្តែ សម្រាប់ ខ្ញុំ គឺ ខ្ញុំ ដាច់ខាត គឺ ខ្ញុំ នៅ ជ្រោង ដួង ព្រលឹង សង្គ្រោះ ជាតិ ដដែល ។
៊រ អាក្យ៊ ក្មាន ក្ូន ២នា ក្់ៈ
លោក ត្រាំ ច្រានចោល ការរិះគន់ ហើយ បាន និយាយ ថា លោក មាន ជំនួប ដ៏ អស្ចារ្ស ជាមួយ មេដឹកនាំ រុស្ស៊ី
នេះ ក្រពុំ មែន ងាយ ទេ
ខ្ញុំ នឹង មិន ផ្លាស់ប្តូរ អ្វី ដែល ខ្ញុំ មាន នោះ ឡើយ ទោះបីជា ខ្ញុំ បាន ផ្លាស់ប្តូរ ខ្លះ ៗ
ទ្រាំ បន្តិច ទៀត ទៅ ជិត បាន មើល ហើយ
មនុស្ស ដែល អ្នក មិន ស្គាល់ នៅពេល ដំបូង គឺជា មនុស្ស ដែល ចង់ ជឿ ទុកចិត្ត លើ អ្នក ។
ពួកយើង ត្រូវ រក្សា ធ្វើ នូវ អ្វី ដែល យើង កំពុង ធ្វើ ពីព្រោះ ខ្ញុំ គិត ថា យើង អាច ឈ្នះ ពានរង្វាន់ ជាច្រើន បន្ថែម ទៀត ក្នុង ពេល អនាគត ។
ប៉ុន្តែ ពេល អ្នក នៅក្នុង ទ្រុង ឬ លើ សង្វៀន អ្នក ត្រូវតែ ប្រឈមមុខ ដាក់ គ្នា ដោយ ប្រើ ក្បាច់ បច្ចេកទេស វ៉ៃ ។
អ្នក ក៏ មាន អារម្មណ៍ ថា អ្នក ជា ចំណែក មួយ នៃ ភាពជោគជ័យ របស់ ក្រុមហ៊ុន ផងដែរ ៕
ថ្វីត្បិត បែប នេះ ក្តី តែ ពេលនេះ ពួកគេ បាន វិល មក ត្រូវ រ៉ូវ គ្នា វិញ ហើយនិង ថែមទាំង ស្រលាញ់ គ្នា ខ្លាំង លើស ដើម ទៀត ផង ។
នៅ ពេល ដែល ខ្ញុំ ចង់ ញ៉ាំ ម្ហូប អ្វី មួយ ខ្ញុំ សម្រេចចិត្ត ទៅ ញ៉ាំ ភ្លាម ៗ
៣ ខ្ញុំ គិត ថា ភាពស្រស់ស្អាត បាន មកពី ការដឹង ថា អ្នក ជា នរណា ។
គាត់ មិន បាន នៅ ទីនោះ យូរ ទេ ដោយសារ គាត់ បាន ជម្រាប ទៅ ថ្នាក់ លើ អំពី ភាព មិន ប្រក្រតី មួយចំនួន នៅក្នុង បញ្ហា ហិរញ្ញវត្ថុ ហើយ គាត់ ត្រូវបាន គេ ប្រាប់ ថា នោះ មិន មែន ជា រឿង របស់ អ្នកទេ ។
ក្រោយ ជីវិត រៀបកា បាន ៧៥ ឆ្នាំ គូរ ស្នេហ៍ វ័យ ចំណាស់ បាន ស្លាប់ ក្នុង ដៃ គ្នា ទៅ វិញ ទៅ មក
មនុស្ស ជាច្រើន បាន បង្កើត គេហទំព័រ មួយ សម្រាប់ ខ្លួន ឯង រួចរាល់ ហើយ ។
ហេតុអី គ្រប់ គ្នា សុទ្ធតែ ថ្កោល ទោស ខ្ញុំ អញ្ចឹង !
វា ធ្វើការ រហូតដល់ យើង ចាស់ ដល់ ពេល យើង ចូល និវត្តន៍ ។
តើ ជីវិត ស្ត្រី មេម៉ាយ អភ័ព្វ នេះ ហេតុអី ព្រហ្ម …
អង្គប្រជុំ បាន តាមដាន ស្តាប់ និង ពិភាក្សា គ្នា លើ ៖
បណ្តើរ នោះ អ្នក នឹង ទទួលបាន នូវ អារម្មណ៍ ល្អ ពេញ មួយ ថ្ងៃ ជាក់ ជា មិន ខាន ។
លោក បាន គូសបញ្ជាក់ ថា នៅក្នុង ច្បាប់ របស់ យើង វា មិន សូវ ច្បាស់លាស់ ទេ ។
ចាប់ផ្តើម ហ៊ុមព័ទ្ធ វាល ព្រះមេរុ ដើម្បី ស្ថាបនា របង ថ្មី ជំនួស របង ដែក ចាស់
របស់ សមាជិក ទាហាន របស់ យើង ដែល បាន បូជា ជីវិត ។
មន្ត្រី ជាន់ ខ្ពស់ ម្នាក់ នៃ សេតវិមាន បាន ថ្លែង ទៅកាន់ អ្នកកាសែត ថា បទបញ្ជា ប្រធានាធិបតី នៅ ថ្ងៃ នេះ គឺ បិទ ផ្លូវ សម្រាប់ អំពើពុករលួយ មួយ ទៀត ដែល យើង បាន សង្កេតឃើញ ថា កំពុង កើតមាន ។
លោក បាន និយាយ ថា ការណ៍ នេះ ច្បាស់ ណាស់ បាន បង្កើត បរិយាកាស ជា ល្អ មួយ ហើយ លោក ប្រធានាធិបតី ត្រាំ បាន ឆ្លើយតប យ៉ាង វិជ្ជមាន ។
ក្នុង បន្ទប់ ជំនុំជម្រះ ។
ពីព្រោះ លោកស្រី អាច ប្រាប់ យើង ពី អ្វី ដែល ពួកគេ បាន សន្និដ្ឋាន ។
កាលពី ថ្ងៃទី ១០លោក នាយក រដ្ឋមន្ត្រី ក៏ បាន ធ្វើដំណើរ បាន តិច ៗ
លើស ពី នោះ ទៅ ទៀត ពួកគេ ត្រូវ ចំណាយ លើ តម្រូវ ការចាំបាច់ ផ្សេង ទៀត មួយចំនួន ផងដែរ ។
ទម្លាប់ គេង ៤នេះ នឹង បំផ្លាញ ស្បែក អ្នក យ៉ាង លឿន
ភាពជោគជ័យ គឺជា គោលដៅ របស់ យើង គ្រប់ គ្នា ប៉ុន្តែ មិន មែន ទាំងអស់ គ្នា សុទ្ធតែ ជោគជ័យ នោះ ទេ ។
គ្នា អ្នក ដឹង នាំ ក៏ ដូចគ្នា ប្រសិនជា យើង ជា ម្ចាស់ ក្រុមហ៊ុន ឬ ក៏ ជា អ្នកដឹកនាំ ក្នុង ក្រុមហ៊ុន ចាំបាច់ ណាស់ ត្រូវ មាន ចំណុច ទាំង នេះ ។
បន្ទាប់ពី ការបិទ មិន ដំណើរការ រោងចក្រ ។
មេរោគ ហ្នឹង ពិតជា គួរឱ្យ ខ្លាច មែន ហើយ ។
នៅក្នុង សវកា កន្លងមក ដើម បណ្តឹង ហាក់បីដូចជា មិន សូវ មាន ជំនឿ ខ្លួន ឯង ភ័ស្តុតាង ពុំ មាន ភាពច្បាស់លាស់ ។
១ ពេល ព្រះយេស៊ូ យាង ចេញពី ព្រះវិហារ ទៅ មាន សិស្ស ម្នាក់ ទូល ព្រះអង្គ ថា ៖
សូម រង់ចាំ ការមកដល់ នៅ សប្តាហ៍ ក្រោយ ណា៎ !
ព្រះជាម្ចាស់ បាន ត្រាស់ហៅ យើង អោយ មក រស់ ក្នុង សេចក្តីសុខសាន្ត ។
បាន និយាយ ថា ខ្ញុំ តែងតែ ចង់ ក្លាយទៅជា នរណា ម្នាក់
ប្រសិនបើ យើង និយាយ ដោយ សង្ខេប ក្នុង មនុស្ស មាន ៣ប្រភេទ គឺ ៖
ព្រះអង្គ ជា កំពែង សំរាប់ សង្គ្រោះ ស្តេច
ដែល មាន ដូចជា ផ្ទះល្វែង ទោល ផ្ទះ ក្នុង ក្រុង ផ្ទះ ភ្លោះ និង ផ្ទះល្វែង ត ៗ
និង នាំយក បញ្ហា នេះ ទៅកាន់ តុលាការ អន្ត ជាតិ ៕
ប្រាថ្នា មួយ គឺ ចង់ រៀន លេង បទ មួយ នេះ ជាបទ ដែល ខ្ញុំ ចូលចិត្ត ជា ទីបំផុត ។
យើង មិន អាច ទទួលយក របាយការណ៍ របស់ អង្គការ ឃ្លាំមើល សិទ្ធ ម ន៉ិស្ស បែប នេះ ទេ ។
បាន ភ្លក់ ព្រះបន្ទូល ដ៏ ល្អ របស់ ព្រះជាម្ចាស់ និង អំណាច នៃ លោក ខាងមុខ រួចហើយ
ខ្ញុំ កំពុងតែ ចាំ ក្រែង មាន អ្នកបកប្រែ ឱ្យ ។
សន្លឹក ឆ្នោត នេះ ត្រូវ ជឿ ថា ជា អ្នកគាំទ្រ លោក ចូបៃ ឌិន ។
អ្នក ដឹង ច្បាស់ ជាង គេ ស្រាប់ ហើយ ថា កាល ខ្ញុំ នៅ ក្រុង អេភេសូគាត់ បាន ជួយ ជ្រោមជ្រែង ខ្ញុំ យ៉ាងណា ខ្លះ ។
ប៉ុន្តែ ពួកគាត់ នៅតែ មិន ទាន់ ទទួលបាន ដំណោះស្រាយ ណាមួយ ពី រដ្ឋាភិបាល នៅឡើយ ។
ខ្ញុំ គិត ថា លោក ហ៊ុន សែន កាន់តែ ធ្វើ ជ្រុល ខ្លាំង ៗ
បន្ទាប់ពី នេះ ព្រះអង្គ ក៏ រៀបរាជាភិសេក នឹង ព្រះនាង សោមា ដែល ជា ព្រះរាជ បុត្រី របស់ ស្តេច ភុជង្គ នាគ ។
ជនសង្ស័យ ៤នាក់ ជិះ ឡាន វាយ ប្លន់ យក ម៉ូតូ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន
សន្ន ដ្ឋិាន ថា ភាជន៍ ទាំងនេះ បាន ផលិត ក្នុង ប្រទេស ថៃ
នាង ក៏ បាន បន្ត បើក ទូរស័ព្ទ ដើម្បីឱ្យ ខ្ញុំ អាច ស្តាប់ ឮ សម្លេង វា ។
ប្រសិនបើ លោកអ្នក មិន អាច រកឃើញ នូវ អ្វី ៗ
ទោះ យ៉ាងណា ក៏ដោយ អត្ថបទ នោះ មិន បាន ប្រាប់ ថា តើ ប្រភេទ អាវុធ អ្វី ដែល នាវា មុជទឹក នោះ មាន ទេ ។
ទាំង កាយសម្បទា និង ចិត្ត គំនិត នឹង ត្រូវបាន រីកដុះដាល ជាលំដាប ។
ពីសំណាក់ គ្រូពេទ្យ ជំនាញ ផងដែរ ។
ជា សៀវភៅ គម្ពីរ របស់ ពួក បរិសុទ្ធ ថ្ងៃ ចុងក្រោយ មួយ ដែល មាន នូវ ការ សរសេរ របស់ លោក អ័ ប្រាហាំ លោក ម៉ូសេ និង លោក ម៉ាថា យ ដែល បាន បកប្រែ ដោយ យ៉ូសែប ស្ម៊ីធ ក៏ បាន ដកស្រង់ ចេញមកពី ការរសរសេរ របស់ យ៉ូសែប ស្ម៊ីធ ផងដែរ ។
បើ ទោះ អ៊ុក ណារី ម និង ឆោម ឆពុំ មិន មាន ប្រជាប្រិយភាព ដូច ប៉ុន្មាន ឆ្នាំ មុន ក៏ ពិត មែន តែ អ្នក ទាំង ពីរ នៅតែ បន្ត អាជីព ចម្រៀង របស់ ខ្លួន ដដែល ហើយ ពេលនេះ ពួកគេ ក៏ មាន ក្រុម តន្ត្រី ផ្ទាល់ខ្លួន ផងដែរ ។
សុជាតិ គេ ការបារ បាន ល្អ គ្រាន់បើ គឺ កម្រ មាន នរណា ធ្វើឱ្យ គេ មាន របួស ណាស់ ។
ចូលក្នុង កន្លែង តែ មួយ ។
វិធី នេះ ងាយស្រួល និង មិន ចំណាយ អ្វី ទាំងអស់ ហើយ ថែមទាំង អាច ធ្វើ បាន គ្រប់ ទីកន្លែង ទៀតផង ។
