ជាមួយនឹង ការចាប់ខ្លួន នៅ ថ្ងៃ នេះ សម្ព័ន្ធ បី ក្រុមហ៊ុន អាចនឹង ក្រឡាប់ ចាក់ ។
ថ្វីត្បិតតែ ពី ដំបូង មើល ទៅ ហាក់ដូចជា ឈ្នះ ក៏ដោយ ។
ដោយ ការគោរព ពេលវេលា ខ្ញុំ បាន អង្គុយ ចាំ នៅមុខ សាលា តាំងពី កន្លះ ម៉ោង មុន ។
តែ ព្រះយេស៊ូវ បាន មាន បន្ទូល បញ្ជាក់ ដល់ គាត់ ថា គុណ របស់ អញ ល្មម ដល់ ឯង ហើយ ដ្បិត កំឡាំង អញ បាន ពេញ ខ្នាត ដោយ សេចក្តី កំសោយ ។
គ ប្រជាជន ក្នុង ប្រទេស អាច បាត់បង់ ការងារ ដែល ជា ក្តីស្រមៃ របស់ ពួកគេ
ពួក អ្នក ការពារ សិទ្ធិ មនុស្ស យល់ ថា តួលេខ ពិតប្រាកដ មាន ច្រើន ជាង នេះ ដល់ ទៅ៣ ដង ឯណោះ ។
ខ្ញុំ និយាយ ថា ខ្ញុំ ស្រឡាញ់ ការងារ អង្គការ ចាត់តាំង ។
ឥរិយាបថ របស់ កូរ៉េ ខាងជើង អាច ជា ប្រភេទ នៃ ការបោកបញ្ឆោត មួយចំនួន ប៉ុន្តែ នៅក្នុង ការពិត រហូតដល់ ពេលនេះ សហរដ្ឋ អាមេរិក មិន បាន វាយប្រហារ គាត់ ។
ម្យ៉ាង វិញ ទៀត បុរស ទំនងជា មាន បញ្ហា ខាង ការប្រព្រឹត្តិ អាកប្បកិរិយា រួមភេទ ទៅ វិញ ។
ផលិតផល ថ្មី នេះ សក្តិសម បំផុត សម្រាប់ រដូវ វិស្សមកាល និង រដូវ ដើរ ទិញ អីវ៉ាន់ ក្នុង ឆ្នាំ នេះ ហើយ ម្យ៉ាងទៀត …
ទន្ទឹមនឹង ពានរង្វាន់ ផ្សេង ៗ
ប៉ុន្តែ នាង គឺជា អតីត មិត្ត ស្រី តែ ម្នាក់ គត់ ដែល ចាស ស្ទីន ធ្លាប់ បាន បង្ហាញ មុខ ជា ផ្លូវការ ។
ខ្ញុំ នៅតែ តាមដាន លោក ពេល លោក កាន់ តំណែង ជា និពន្ធ នាយក បោះពុម្ព ។
មក បម្រើ ក្នុង វិស័យ នេះ ។
គាត់ មិន សុំ ការអភ័យទោស នោះ ឡើយ ដោយ បាន ប្រាប់ ថា ខ្ញុំ ចង់ ដោះស្រាយ យ៉ាងម៉េច ក៏ បាន ។
គឺ មាន ការស្មុគស្មាញ ខ្លាំង មិន ងាយ ដូច ការគិត របស់ ពួកគេ ឡើយ ៕
ហេតុអី មិន ឃើញ អើត ក្បាល មក
ព ពោះ ១៧ខែ ហើយ គ្រូពេទ្យ ប្រាប់ ថា ជា រឿង ធម្មតា
គួរតែ មើល មាន វីដេអូ
សូម្បីតែ មនុស្ស ធម្មតា ក៏ រមែង តិះដៀល បុគ្គល ដែល មាន ធនធាន ហើយ មិន បាន ផ្គត់ផ្គង់ ឪពុក ម្តាយ បណ្តោយ ឱ្យ ពួកគាត់ រង ទុក្ខវេទនា ដោយ ក្តី ស្រេកឃ្លាន និង រងា ជាដើម នោះ ដែរ ។
វា ដូចគ្នា នឹង គេហទំព័រ ផ្សេង ៗ
ប្រសិនបើ តុល្យការ នេះ ត្រូវបាន បញ្ជាក់ នោះ នឹង ជា តុល្យការ យ៉ាង ខ្ពស់ បំផុត នៃ អ្នកស្លាប់ នា ថ្ងៃ តែ មួយ ក្នុង សង្គ្រាម នៅ ស៊ីរី ចាប់តាំងពី ជិត ៥ឆ្នាំ មកហើយ ។
ខ្ញុំ នឹង ទៅ ជួប លោក កឹម សុខាជជែក ពី ការយក អាសនៈ ឃុំ សង្កាត់ មកវិញ
និង សលឹក្ត ឈើ ដៅ ដរល រាងកាយ ដៅ ព្រព្រឹត ដតៅាន ក្៏
លោក ប៉ូល ព្រួយបារម្ភ អំពី អ្នកស្រុក កាឡា ទី
សម្តេច តេជោ ផ្តល់ សញ្ញាបត្រ ឱ្យ ខ្ញុំ ក្នុង ពិធី បញ្…
ចិន និយាយ ថា គ្មាន ប្រទេស ណា ផ្តល់ តម្លៃ ដល់ សន្តិភាព និង ការអភិវឌ្ឍ ច្រើន ជាង ប្រទេស ចិន ទេ ។
ផ្ញើរ ទុក សិន ចាំ បន្តិច ទៀត ត្រឡប់មក មើល វិញ
អ្នក ប្រហែលជា មិន ដឹង ទេ ថា ការរាំ ជួយ អ្នក បាន ច្រើន ណាស់ ។
ឥឡូវនេះ មន្ទីរពេទ្យ របស់ លោក មាន អ្នកជំងឺ ពេញ ។
ក្តី សុបិន របស់ ខ្ញុំ គឺ ធ្វើឱ្យ ជីវិត ប្រសើរឡើង សម្រាប់ កូន ៗ
ប៉ុន្តែ យើងខ្ញុំ មិន ដឹង ពី ចំណង់ចំនូល ចិត្ត នៃ ការធ្វើការ របស់ អ្នកទេ ។
៣បើ ខ្ញុំ ដឹង ថា ព្រះអង្គ នៅ ទីណា
ខ្ញុំ ពិតជា ចូលចិត្ត នូវ ការងារ របស់ ក្រុមការងារ លោក ណាស់ !
ដូច្នេះ កុំ ភ្លេច រង់ចាំ តាមដាន ទាំងអស់ គ្នា ណា ប្រិយមិត្ត !
អ្នកធ្វើ សកម្មភាព គឺ ពីរ នាក់ បងប្អូន ។
ចំណែក ជនរងគ្រោះ ដែល កំពុង ជួយសង្គ្រោះ នោះ នៅ មិន ទាន់ ស្គាល់ អត្តសញ្ញាណ នៅឡើយ ។
មើល ទៅ ខ្ញុំ ពិតជា មាន បញ្ហា ជាមួយ អាយ អ៊ី៧ ។
ដូចនេះ ដរាបណា មនុស្ស មិន មាន ការអភិវឌ្ឍ ដរាប នោះ មនុស្ស នៅតែ ល្ងង់ …
ពួកគេ មាន ការជឿជាក់ លើ ខ្លួន ពួកគេ ដែល យើង មិន ដែល មាន កាលពី យើង នៅ ក្មេង ។
កាម ភោគី អ្នក បរិភោគ កាម ។
ហើយ ស្ថិត នៅក្នុង ធូលី ដី ជាមួយ ខ្ញុំ ។
គាត់ ជា កីឡាករ ម្នាក់ ដែល មាន ភាពឆ្លាតវៃ បំផុត លើ លោក ។
មាន តែ ព្រះយេស៊ូវ ទេ ដែល ជា ដំណោះស្រាយ ដ៏ ពិត ។
ហើយ ទូលបង្គំ ក៏ នឹង ថ្លែង អំពី ភាពឧត្តុង្គឧត្តម
ថ្ងៃ យាង ត្រឡប់ មកវិញ របស់ ព្រះយេស៊ូវ
យើង ឈប់ ជឿ អាជ្ញាធរ ហើយ ពីព្រោះ យើង បាន ស្នើសុំ ឱ្យ ពួកគេ ជួយ ជាច្រើន លើក រួចហើយ ប៉ុន្តែ ពួកគេ មិន បាន ចាប់អារម្មណ៍ ចំពោះ ការឈឺចាប់ របស់ យើង នោះ ទេ ។
ឥណ្ឌា ក្នុង ចំណោម ៤នាក់ ស្លាប់ ម្នាក់ ដោយ កូវីដ ប្រភេទ ថ្មី
នៅក្នុង កម្មវិធី ថ្ងៃ នេះ លោក បាន លើកឡើង ចំណុច សំខាន់ ៗ
ដប្រវា សប្ម្រ់ កម្មវិធី អនុវត្ត ជាក់ ដស ដង កាន់ ដត្ប្រយ សើរយ ឡើង ។
នៅ តាម ប្រទេស ជាច្រើន ដូចជា ប្រទេស ឥណ្ឌា ថៃ ម៉ាឡេស៊ី ជាដើម ។
មើល យើង ធ្វើ អ្វី អ៊ីចឹង ។
គ្នា ដែល រួមបញ្ជូល ទាំង បញ្ហា ផ្លូវចិត្ត ផងដែរ …
នេះ ជា ឱកាស ល្អ ដើម្បី នាំ រូបភាព វៀតណាម ទៅកាន់ ពិភពលោក ៕
យើងខ្ញុំ មាន មោទនភាព គឺជា កន្លែង គួរ ជឿជាក់ សម្រាប់ អតិថិជន ទាំងអស់ គ្នា ។
ចំណែក អាមេរិក វិញ លើកឡើង ថា បើសិន …
ប្រភព ដើម នៃ នាម ត្រកូល ស្ពែស ។
ក៏ មាន ឈ្មោះ ទៅ តាម ប្រភេទ ក្រុមហ៊ុន នីមួយ ៗ
ក្នុង វចនានុក្រម គេ ថា អញ្ចឹង មែន ។
ពួកគេ បាន ចូលមក ក្នុង បន្សំ ពណ៌ ភ្លឺ ដែល ធ្វើឱ្យ ពួកគេ ជា រូបរាង ភ្នែក ចាប់ ។
វា ប្រហែល បណ្តាល មកពី សង្គ្រាម ក៏ ថា បាន ។
ព្រោះតែ ខ្ញុំ ទើប ធ្វើឱ្យ អ្នកម្តាយ ទឹកភ្នែក
សម្រាប់ ព័ត៌មាន បន្ថែម អំពី ការបរាជ័យ នៃ អនាមិក សូម មើល ជំពូក ទី 6 នៃ សៀវភៅ នេះ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន សំណូមពរ ដល់ ប្អូន ត្រូវ គោរព ច្បាប់ ចរាចរណ៍ អោយ បាន ខ្ជាប់ខ្ជួន ក្នុង ពេល បញ្ជា យានជំនិះ គ្រប់ ប្រភេទ ៕
យើង នឹង រីករាយ ខ្លាំង ណាស់ ក្នុង ការស្តាប់ ឮ ពី អ្នក និង ការឆ្លើយតប ទៅនឹង អ្នក ដូច្នេះ ។
ព្រះអង្គ ជា ហ៊ឺ និង ប្រជាពុទ្ធ បរិស័ទ ច្រានចោល ការចោទប្រកាន់ នេះ ។
ប្រជាជន ទាំងឡាយ អើយ សូម ស្តាប់ ខ្ញុំ
៤ឥឡូវនេះ ព្រះអម្ចាស់ ជា ព្រះរបស់ ទូល បង្គំ ប្រោសប្រទាន សេចក្តីសុខសាន្ត នៅ គ្រប់ ទិសទី គឺ គ្មាន មារស ត្រូវ គ្មាន គ្រោះ កាច ទៀត ទេ ។
ចូរ កុំ ធ្វើ សឹក ទល់ នឹង ព្រះអម្ចាស់ ជា ព្រះនៃ ដូនតា របស់ អ្នក រាល់គ្នា ឡើយ ដ្បិត អ្នក រាល់គ្នា ពុំ អាច ឈ្នះ ជាដាច់ខាត !
៥ អ្នក ទាំងនោះ កើត មកពី លោកីយ៍ ហេតុ នេះ ហើយ បានជា ពាក្យសំដី របស់ គេ ចេញ ពី លោកីយ៍ ហើយ មនុស្សលោក ស្តាប់ គេ ។
តែ ព្រះយេស៊ូវ បាន មាន បន្ទូល ប្រាប់ ពួកគេ ថា កុំ ឱ្យ អរសប្បាយ ដោយ ព្រោះ អារក្ស ចុះ ចូល អ្នក រាល់គ្នា នោះ ឡើយ ត្រូវ ឱ្យ រីករាយ ដោយ ព្រោះ ឈ្មោះ អ្នក រាល់គ្នា បាន កត់ទុក នៅ ស្ថាន សួគ៌ វិញ ខ. ២០ ។
លក់ រូបភាព តាម អ៊ីនធឺណិត 9
ជា ដំបូង ខ្ញុំ សូម អរគុណ ព្រះជាម្ចាស់ ដែល បាន ប្រទាន សុខភាព ល្អ ឱ្យ មក ខ្ញុំ ដែល ធ្វើឱ្យ ខ្ញុំ ងាច លេង បាល់ទាត់ បានជាច្រើន ឆ្នាំ ។
ពាក្យ នេះ គេ មិន ត្រូវ យកមក ទុកដាក់ ក្នុង ចិត្ត សោះ ទេ ព្រោះថា ៖
លោកស្រី គ្រោង នឹង បង្ហាញ ខ្លួន នៅ ថ្ងៃសុក្រ សប្តាហ៍ ក្រោយ ។
ទាំង សហគមន៍ ទាំង មេភូមិ ហ្នឹង ហើយ ។
ខ្ញុំ រកឃើញ ឈ្មោះ ពួកគេ នៅក្នុង សៀវភៅ ប្រវត្តិសាស្ត្រ ទីក្រុង រ៉ូម ។
ប្រសិនបើ លោកអ្នក មាន គន្លឹះ ក្រៅពី នេះ សូម ដាក់ មតិ ក្នុង ប្រអប់ ខាងក្រោម
អ្នក បច្ចុប្បន្ន ក្លាយជា លេខ មួយ ហើយ អ្នក ពិតជា សាកសម ទទួលបាន វា ។
ដូច្នេះ គេ គួរ ចៀសវាង ការផឹក កាហ្វេ ឬ ភេសជ្ជៈ ប៉ូវ កម្លាំង អំឡុង ពេល មក រដូវ ។
ពលរដ្ឋ ចិន ជាង ១០០ លាន នាក់ ត្រូវបាន បិទ ឱ្យ នៅក្នុង ផ្ទះ ជាថ្មី
នៅក្នុង បន្ទប់ នោះ មាន កង្ហារ តែ ពីរ បី ដែល មិន អាច ផ្តល់ ភាពត្រជាក់ គ្រប់គ្រាន់ ទេ ។
ប៉ុន្តែ មនុស្សលោក ទទួលស្គាល់ ថា ព្រះប្រាជ្ញា ញាណ របស់ ព្រះជាម្ចាស់ ពិតជា ល្អ ត្រឹមត្រូវ មែន ដោយ គេ បាន ឃើញ កិច្ចការ ដែល ព្រះអង្គ ធ្វើ ។
២៤ ដូច្នេះ បងប្អូន ឃើញ ថា ព្រះជាម្ចាស់ ប្រោស មនុស្ស អោយ បាន សុចរិត ដោយសារ អំពើ ល្អ ដែល គេ ប្រព្រឹត្ត គឺ មិន ត្រឹមតែ ដោយសារ ជំនឿ ប៉ុណ្ណោះ ទេ ។
សូចនាករ សន្ទុះ បរិមាណ
មនោសញ្ចេតនា កើត រឿង ឈ្លោះប្រកែកគ្នា ញឹកញាប់ ៕
លោក បន្ថែម ថា ការលក់ដូរ មាន ការកើនឡើង ៖
នេះ បែរជា កំណត់ នូវ គោលដៅ ជីវិត របស់ ខ្លួន ចូលក្នុង វិស័យ យោធា នេះ ទៅ វិញ ។
គឺ តែងតែ មាន ការលំបាក ប៉ុន្តែ អ្នក នឹង ទទួលបាន រង្វាន់ នា ពេល ក្រោយ ។
ខ្ញុំ មិន អាច អង្គុយ លើ កៅអី រហូតដល់ ពេល ត្រូវ ស្លាប់ ទេ ។
ដូច្នេះ អាជ្ញាធរ មាន គ្រប់ សាច់រឿង ទាំងអស់ ។
មាតា និង ទារកបាន មានប្រសាសន៍ ថា ទន្ទម
ការប្រែប្រួល ធាតុអាកាស ប្រថុច ញ៉ុច ងាយ ធ្វើឱ្យ អ្នក កើត ផ្តាសាយ អស់ កម្លាំង ។
ខ្ញុំ ចង់ មាន សៀវភៅ នេះ មួយ ច្បាប់ ។
ហ្នឹង គឺជា លទ្ធផល ជាក់ស្តែង ហ្នឹង ហើយ ដែល ខ្ញុំ និយាយ ថា ជោគជ័យ ក្នុង រយៈកាល កន្លងមក ។
ជ័យជម្នះ លើ ពួក ខ្មែរ ក្រហម គឺជា ជ័យជម្នះ របស់ ប្រជាជន កម្ពុជា ទាំងអស់ ។
មិន ដឹងខ្លួន ទេ ថា មាន អ្នកស្រី
មូលហេតុ នេះ ទើប ស្ត្រី រួប នេះ ប្តឹង ទៅ តុលាការ ។
ក្រៅពី សម្តែង បន្តិចបន្តួច នាង ក៏ ទទួល ការងារ ហូរហែ ពី ក្រុមហ៊ុន ជាច្រើន ដែរ ។
មួយចំនួន បាន បញ្ចេញ ចម្រៀង របស់ ខ្លួន មាន ដូចជា ៖
ដោយសារតែ បែប នេះ ហើយ បានជា គេ ហៅ រូបលោក ថា ជា បិតា ស្ថាបនិក របស់ សហរដ្ឋ អាមេរិក ។
កំពុងតែ ក្លាយជា ពពួក សត្វ កម្រ នៅលើ ភព ផែនដី ។
តែ បើ ងាក ទៅ មើល អតីតកាល វិញ សម្រស់ តារា ទាំងនោះ ពិតជា ខុសគ្នា ឆ្ងាយ បើ ធៀប នឹង បច្ចុប្បន្ន ។
ខ្ញុំ ស្គាល់ ពួក មនុស្ស នៅ ទីនេះ ។
គាត់ តែង ចែក ទាន ជាច្រើន ឱ្យ ប្រជាជន , ព្រមទាំង ទូល អង្វរ ព្រះជាម្ចាស់ គ្រប់ ពេលវេលា ។
លោក សម រង្ស៊ី កំពុង ភ័យ ខ្លាំង ខ្លាច លោក កឹម សុខា បែក ពី ខ្លួន ទៅ បង្កើត បក្ស ថ្មី
ហើយ នោះ គឺជា ផ្លូវ ដូចគ្នា ដែល កម្ពុជា នឹង ទទួលយក នៅ ទីបញ្ចប់ ។
កំហឹង ដែល មិន អាច គ្រប់គ្រង បាន អាច មាន គ្រោះថ្នាក់ យ៉ាង ធ្ងន់ធ្ងរ ទៅ លើ ខ្លួន ឯង និង ជីវិត ទាំងមូល ព្រោះ វា អាច ក្លាយទៅជា ការបំផ្លាញ ដ៏ សាហាវ មួយ ទៅ លើ ខ្លួនអ្នក និង មនុស្ស នៅ ជុំវិញ អ្នក ។
ទៀត ឱ្យ បាន ដឹង យ៉ាងហោចណាស់ អ្នក អាច ជួយសង្គ្រោះ ជីវិត មនុស្ស ម្នាក់ បាន ។
៦នៅ ថ្ងៃទី ដប់ ប្រាំ ក្នុង ខែ ដដែល នោះ ជា បុណ្យ នំប៉័ង ឥត មេថ្វាយ ព្រះអម្ចាស់ ។
ហើយ ត្រូវ អាវុធហត្ថ ក្រុង ចាប់ បាន ជា បន្តបន្ទាប់ នៅ កន្លែង ផ្សេង ៗ
យើង ទាំងអស់ គ្នា មាន មោទនភាព ចំពោះ ការងារ ដែល យើង ធ្វើ ដើម្បី ទប់ស្កាត់ ការពារ និង ការផ្តន្ទាទោស នូវ ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ដ៏ ធ្ងន់ធ្ងរ នេះ ។
យ៉ាងណាមិញ ថ្ងៃ នេះ យើងខ្ញុំ នឹង បង្ហាញ បងប្អូន ថា តើ ហេតុ អ្វី អ្នក មាន ឬ មហាសេដ្ឋី មួយចំនួន ចេះតែ ស្លៀកពាក់ សាមញ្ញ និង ដដែល ៗ
លោក មិន មាន ទិន្នន័យ ថា តើ ទណ្ឌិត ជនជាតិ វៀតណាម មាន ប៉ុន្មាន នាក់ នោះ ទេ ។
សេចក្តី ទាំងនេះ គឺជា លក្ខខណ្ឌ ទាំង ប្រាំពីរ យ៉ាង នៃ ភាពជា សិស្ស របស់ ព្រះគ្រីស្ទ ។
ដែល មាន ទ្រព្យសម្បត្តិ ព្រមទាំង មាន កេរ្តិ៍ឈ្មោះ ព្រោះតែ វិជ្ជា ផ្សំ ថ្នាំ គេ ក៏ មិន ចេះ អក្សរ ដូច ចៅ ដែរ ។
ដូច្នេះ ត្រូវតែ ដុត វត្ថុ ទាំងនោះ ចោល ។
គេ តែង ពោល ថា លោកគ្រូ អ្នកគ្រូ ជា វិស្វករ ព្រលឹង ។
គ្មាន នរណា ធ្លាប់ ដឹង ការពិត ទេ ថា នៅ ពីក្រោម ស្រោម មុខ មឹះ ៗ
តាម ជំនឿ ថ្មី នេះ ធម្មជាតិ លែង ជា ព្រះដូចជា គេ ធ្លាប់ ជឿ ពីមុន ទៀត ហើយ ។
ក្នុង រយៈពេល ២៤ ម៉ោង ដំបូង ក្រោយ វះ ដក ធ្មេញ ។
