ល្បិច សម្ងាត់ មិន សូវ មាន អ្នក ដឹង ទាំងនេះ នឹង ជួយ ឱ្យ ការចងចាំ ក្នុង ការសិក្សា អ្នក កាន់តែ ល្អ !
ចម្លើយ ខ្ញុំ ជឿ ថា ហនុ មាន បោះជំហាន ទៅ ទីផ្សារ អន្តរជាតិ ។
មុននឹង យើង មក ធ្វើ បុណ្យ ហ្នឹង គឺ យើង គោរព ថ្វាយបង្គំ ឪពុក ម្តាយ យើង សិន បាន យើង យក ចង្ហាន់ ហ្នឹង មក ប្រគេន លោក គឺ អ្នកមាន គុណ ទី១ របស់ យើង ។
នេះ បើ យោង តាម ទិន្នន័យ ចេញផ្សាយ ដោយ អាជ្ញាធរ ជប៉ុន កាលពី ថ្ងៃទី ៨មិថុនា កន្លងមក ។
អា ហ្នឹង ហើយ ជា ចំណុច គ្រោះថ្នាក់ របស់ អស់ លោក ព្រោះ គេ នៅតែ បញ្ជា កម្លាំងប្រដាប់អាវុធ របស់ គេ អង្គភាព របស់ គេ បាន ។
កម្សត់ កម្រ ជាមួយគ្នា ជាច្រើន ឆ្នាំ ប៉ុន្តែ ថ្ងៃ លោក អ៊ិត សេដ្ឋា លាចាក លោក បែ ជា មិន ឃើញ វត្តមាន របស់ អ្នកនាង …
អាមេរិក ថា ការលុបបំបាត់ ជាតិ មេន ថុល ពី បារី នឹង នាំមក នូវ ផលប្រយោជន័ សុខភាព
ខ្ញុំ ដឹង ថា ខ្ញុំ អាក្រក់ ខ្ញុំ មិន ល្អ ដែល ធ្វើ បែប នេះ ប៉ុន្តែ ក៏ ព្រោះតែ ខ្ញុំ ហាម ចិត្ត ខ្លួន ឯង មិន បាន និង ស្រលាញ់ គាត់ ខ្លាំង ពេក ។
ខ្ញុំ បញ្ជាក់ ហើយ ថា ប្រសិនបើ ស៊ើប ដឹង នោះ ខ្ញុំ នឹង ដាក់ ពាក្យបណ្តឹង ។
ខ្ញុំ គេច តែ រៀន មិន ស្គាល់ គ្រូ តើ ត្រូវ គិតគូរ តបដូចម្តេច ?
ឬ ក៏ អ្នក រីករាយ ជាមួយ ការទស្សនា ព្រះអាទិត្យ រះ ?
កុមារា ទាំង ពីរ នាក់ នេះ គឺ ម្នាក់ ៗ
ឃាត់ បុរស អាមេរិកាំង ម្នាក់ ពាក់ព័ន្ធ ករណី បទឧក្រិដ្ឋកម្ម ឆ្លង ដែន កម្រិត ធ្ងន់
សម្តេច តេជោ បាន បញ្ជាក់ ថា សូម បងប្អូន ប្រជាពលរដ្ឋ ជាពិសេស ក្មួយ ៗ
បច្ចេកវិទ្យា ឌីជីថល កំពុង បង្កើត នូវ ធុរកិច្ច ថ្មី ៗ
អាហារ ទារក និង ផ្សៅ ទឹកដោះគោ សម្រាប់ ក្មេង ក្រោម អាយុ ១២ ខែ
នេះ មិន ឱ្យ ថ្ងៃ បោះឆ្នោត ទេ ។
រីឯ ព្រះកេស វិញ មាន ផ្នួង សក់ ។
សហគមន៍ អន្តរជាតិ ព្រមាន ថា បើ របប ក្រុង ភ្នំពេញ មិន ស្តារ លទ្ធិ ប្រជាធិបតេយ្យ ឡើងវិញ ទេ ពួកគេ នឹង ដាក់ទណ្ឌកម្ម ។
យើង ប្តេជ្ញាចិត្ត ចូលរួម ការពារ ព្រៃឈើ យើង ទាំងអស់ គ្នា !
មួយ ឆ្នាំ មាន ម្តង កុំ ភ្លេច ត្រៀមខ្លួន សប្បាយ ម៉ាអស់ ដៃ ណា៎ !
លោក បាន ថ្លែង តាម ទំព័រ ផ្ទាល់ខ្លួន នៅលើ បណ្តាញ សង្គម ដដែល ថា ខ្ញុំ ប្រើ ពេលវេលា ច្រើន ណាស់ ទំរាំ កសាង កេរ្ត៍ ឈ្មោះ ក្រុម ទាំង ២នេះ អោយ បាន លេចធ្លោ ។
ក៏ប៉ុន្តែ បន្ទាប់មក កាំភ្លើង ធំ ត្រូវបាន គេ ប្រើប្រាស់ ពេញ មួយ យប់ ។
កន្លែង សំរាប់ ជាតិ សាសន៍ ទាំងអស់ អធិស្ឋាន ។
ការបន្ថយ សិទ្ធិ ខាងលើ មិន ត្រូវ អនុវត្ត លើ នារី ទេ ។
ណាស់ សុទ្ធតែ រ៉ាឌីកាល់ ដូច្នេះ ពួក ខ្ញុំ អត់ ហ៊ាន ឆ្ងល់ ទេ
ទិស លើ គោរព ប្រតិបត្តិ សាសនា ពីព្រោះ ព្រះជា ម្ចាស់ ទេព តានឹង តែងតែ តាម ថែរ រក្សា ការពារ បុគ្គល ល្អ ដែល ប្រព្រឹត្ត អំពើ ល្អ ។
សេចក្តីរាយការណ៍ ឬ របាយការណ៍ ?
អ្នកភូមិ យើង មិន ទាន់ ស្គាល់ រឿង ពិត នៃ បុណ្យ ណូអែល នៅឡើយ ទេ ។
អ្វី ដែល បង ផល លើក យកមក បង្ហាញ គឺ ប្រហាក់ប្រហេល នឹង ខ្ញុំ ដែរ ។
កត្តា នេះ ហើយ ដែល ធ្វើឱ្យ ជំងឺ កូវីដ វាយប្រហារ ឆ្លង ពី ម្នាក់ ទៅ ម្នាក់ ។
តាមរយៈ រូបភាព ប៉ុន្មាន សន្លឹក នេះ …
គួរ មាន ដឹង លឺ ពី សាក្សី ណាមួយ ដូចជា មេធាវី ជាដើម ។
ពួកគេ បាន ប្រឹងប្រែង ខ្លាំង ណាស់ ពួកគេ ស័ក្តិសម នឹង ទទួលបាន តំណែង ជើងឯក ។
នៅ ទីបញ្ចប់ យុត្តិធម៌ នឹង ត្រូវ កើតឡើង ចំពោះ សកម្មភាព នេះ ។
ការឈឺចាប់ របស់ ហ៊ីត្លែរបន្ទាប់ អ្នកស្រី ក្លារ៉ា បាន ស្លាប់
ទើប ខ្ញុំ យល់ព្រម ស្រាត សម្លៀកបំពាក់ នៅ ចំពោះ មុខ មហាជន ៕
យើង នឹង បាន ទទួល នូវ ព្រះគុណ ដ៏ គ្រប់គ្រាន់ មិន ដែល ខាន ពី ព្រះដែល កម្លាំង របស់ ទ្រង់ បាន ពេញ ខ្នាត នៅក្នុង ភាពកម្សោយ របស់ យើង ២កូរិន ថូស ១២៩ ហើយ ទ្រង់ នឹង មិន ដែល ចាកចេញ ឬ បោះបង់ យើង ចោល ឡើយ ហេព្រើ ១៣៥ ។
លោក បញ្ជាក់ ថា ទូរទស្សន៍ គណបក្ស លោក គឺ មិន ផ្សព្វផ្…
នៅក្នុង ក្រុមហ៊ុន មួយ លក្ខណៈ បែប នេះ វា ធ្វើឱ្យ លើស ពី ភាពត្រឹមតែ ជា សហការី ។
បើសិនជា អ្នករៀបការ រួច មនុស្ស តែ មួយ គត់ ដែល អ្នក ចង់ ញ៉ែ គួរតែ ជា ប្រពន្ធ របស់ អ្នក ទៅ វិញ ទេ ។
ប្រសិនបើ អ្នក មាន ការណែនាំ ពី មនុស្ស ដែល មាន បទពិសោធន៍ នោះ ជោគជ័យ របស់ អ្នក នឹង រត់ មក រក អ្នក កាន់តែ លឿន ។
ដៃ ប៉ា មិន ធ្លាប់ កាន់ លុយក ខ្វក់ របស់ អ្នកណា ។
និយាយ ថា អ្នក យក ប្តី គេ ប្រយ័ត្ន ស្តាយក្រោយ អស់ មួយ ជីវិត ព្រោះ ត្រូវ គេ ជះ ទឹក អាស៊ីត ។
ខាង អ៊ីស្រាអែល មិន មាន អ្នកណា ម្នាក់ រងគ្រោះថ្នាក់ ឡើយ ៕
លោក បាន ថ្លែង ថា ពួកយើង ស្អាតស្អំ ណាស់ ពួកយើង ដាច់ខាត ហើយ មិន ប្រព្រឹត្តិ អំពើពុករលួយ នោះ ទេ
ដោយសារ ពួកគេ ស្គាល់ គ្នា ច្បាស់ ទៅ ហើយ ។
ក្នុង ការព្យាបាល បបូរមាត់ ស្ងួត ខាងក្រោម ជាមួយនឹង យើង ទាំងអស់ គ្នា !
ខ្ញុំ ចង់ ប្រាប់ អ្នក ថា ខ្ញុំ នឹង រង់ចាំ ដល់ ថ្ងៃ នោះ មកដល់ ។
១២សូម កុំ អោយ ជនជាតិ អេស៊ីប ពោល ថា ព្រះអង្គ បាន នាំ ជនជាតិ អ៊ីស្រាអែល ចេញ ទៅ ដោយ បំណង អាក្រក់ ដើម្បី សម្លាប់ ពួកគេ នៅ តាម ភ្នំ ព្រមទាំង លុបបំបាត់ ពួកគេ អោយ អស់ ពី ផែនដី ។
ខ្ញុំ ចង់ ដឹង ម៉េច បានជា បង សរសេរ អំខ្ញុំ ផ្ទាល់ ?
គោលបំណង នៃ ការស្លាប់ របស់ ព្រះយេស៊ូ នៅលើ ឈើ ឆ្កាង គឺ ដើម្បី បង់ ចំពោះ អំពើ បាប របស់ យើង និង ដូច្នេះ បំបាត់ ចេញ អំពើ បាប ពី ខ្លួន របស់ យើង និង ស្តារ ឡើងវិញ នូវ ទំនាក់ទំនង ដែល បាក់បែក រវាង យើង នឹង ព្រះជាម្ចាស់ ។
ព្រះអង្គ បាន បន្ត ថា បើ សល់ ប៉ុន្មាន អាត្មាភាព និង បន្ត ធ្វើ មនុស៌្ស ធម ធ្វើ ទាន ដល់ ញាតិ ញោម ទីទ័ល ចាស់ជរា បន្ត ទៀត ។
ទោះបីជា ខ្ញុំ ជាប់ មាន បាប តែ ទ្រង់ បាន អត់ទោស ដល់ ខ្ញុំ
កំពុង ទន្ទឹងរង់ចាំ មើល ការបង្ហាញ វត្តមាន របស់ តារា ស្រី រូប នេះ ។
លោក ជិន សុខ ង៉េង ថ្លែង ថា គាត់ មិន សហការ ជាមួយ ពួកយើង ។
ដែល គាត់ អត់ ចេះ បើក ឡាន អញ្ចឹង ស្រួល មែនទែន ណា ក្មួយ ។
