អ្នក ណាដែលជឿលើខ្ញុំនឹងមានជីវិត ទោះបីគាត់ស្លាប់ក៏ដោយ ។ ហើយអ្នក ណាដែលមានជីវិត ហើយជឿលើខ្ញុំ អ្នក នោះនឹងមិនស្លាប់ឡើយ » ។
តើអ្នក កាសែតអាចធ្វើការ បានត្រឹមត្រូវដោយរបៀប ណា បើមិនដឹងថាអ្នក ណាគ្រប់គ្រងក្រុមហ៊ុនដែលខ្លួនធ្វើការ ?
ហើយ វា គឺ តាមរយៈ សមាគម នេះ ដែល គាត់ បាន ជួប សហរដ្ឋ អាមេរិក ។
នាង ស្នាក់ នៅ ទីនោះ រហូតដល់ ថ្ងៃ នាង ស្លាប់ ។
តាម រយៈទ្រង់ អស់អ្នកដែលជឿបានរាប់ជាសុចរិតពីអ្វីៗទាំង អស់ ដែលអ្នកមិនអាចរាប់ជាសុចរិតដោយក្រឹត្យវិន័យរបស់លោកម៉ូសេ ឡើយ ។
ខ្ញុំ ចង់ ផ្តល់ឱ្យ បុរស ដែល ត្រូវបាន ជួល ចុងក្រោយ ដូច ដែល ខ្ញុំ បាន ផ្តល់ឱ្យ អ្នក ។
មានគេនិយាយរហូតមកដល់សព្វថ្ងៃនេះថា៖ « នៅភ្នំនៃព្រះ យេហូវ៉ានឹងត្រូវធ្វើ
មនុស្ស ម្នាក់ ៗ គួរតែ ផ្តល់ អ្វី ដែល ខ្លួន បាន សម្រេចចិត្ត ក្នុង ចិត្ត ថា នឹង ផ្តល់ឱ្យ ដោយ មិន ស្ទាក់ស្ទើរ ឬ ក្រោម ការបង្ខិតបង្ខំ ឡើយ ត្បិត ព្រះស្រឡាញ់ អ្នក ផ្តល់ ដោយ រីករាយ ។
ខាងក្រោមនេះគឺជាម៉ូដែលដែលអាចធ្វើឲ្យប្រសើរ ឡើ ង៖
« កាលពី ពីរ ឆ្នាំ មុន យើង មិន បាន យកចិត្តទុកដាក់ លើ អចលន ទ្រព្យ ប្រភេទ នោះ ទេ ប៉ុន្តែ ឥឡូវនេះ អ្វី ៗ បាន ផ្លាស់ប្តូរ ។
ប្រាប់ ខ្ញុំ ពី ដៃ ។
ហើយបើមនុស្សខ្វាក់ម្នាក់ដឹកនាំមនុស្សខ្វាក់ នោះអ្នកទាំងពីរនឹងធ្លាក់ទៅក្នុងប្រឡាយ » ។
ធ្វើបែបនេះដើម្បីចងចាំខ្ញុំ » ។
បន្ទាប់មក លោកចាកចេញពីស្រុកខាល់ ដេ ហើយទៅតាំងទីលំនៅនៅហារ៉ាន ។
ដូច ដែល បាន ពិភាក្សា ជាមួយ អ្នក ពីមុន ។
វាមិនចម្លែកទេដែលទូរទស្សន៍ធ្ងន់មែន ទេ ?
១០ រួចទេវតាបាននិយាយមកខ្ញុំថា ៖ ‹ កុំលាក់ទុកពាក្យទំនាយដែលមាននៅក្នុងសៀវភៅនេះឡើយ ។ សម្រាប់ ពេលវេលា ជិត មកដល់ ហើយ ។
សញ្ញា ត្រូវបាន បែងចែក ដោយ ផ្នែក នៃ ការនិយាយ ។
ប្រសិនបើ អ្នក មិន ដឹង អំពី ស៊ូស៊ី
ពេលខ្ញុំសួរគេថា “ ចុះអ្នក ណាដែលមិនស្តាប់បង្គាប់ ?
ឌីស ៥៖ ពិភពលោក គឺជា របស់ អ្នក ។
២៦ ប៉ុន្តែ អ្នក រាល់គ្នាមិនជឿទេ ព្រោះអ្នកមិនមែនជាចៀមរបស់ខ្ញុំ ។
ដូច្នេះហើយ យើងបានព្យាយាមទុកពួកគេឱ្យនៅដដែល
យើងនឹង នាំគេចេញពីស្រុកដែលគេ រស់នៅ ហើយគេនឹងមិនចូលទៅក្នុងទឹកដីអ៊ីស្រា ‌ អែលឡើយ ។
ការងារ ល្អ សុបិន្ត ។
ពេលនោះ ភ្លើងរបស់ព្រះជាម្ចាស់បានធ្លាក់ចុះពីលើមេឃ មក ហើយឆេះគាត់ និងគាត់ទាំងហាសិបនាក់ ។
ព្រះគម្ពីរចែងនៅក្នុង យ៉ូហាន ៣៖
បុរសទាំងពីរនាក់មិនមាន តម្រុយអ្វីនៅខាងមុខពួកគេទេ ។
យើងអាចធ្វើបានល្អខ្លះក្នុងលោកនេះ ។
« ឥឡូវនេះ មាន មេ ប្រឆាំងព្រះគ្រិស្ដជាច្រើនបានមកដល់ ហេតុដូច្នេះហើយបានជាយើងដឹងថាវាជាម៉ោងចុងក្រោយ ។
លោកបានថ្លែងថា៖ « ហើយពួកគេបានសួរ ចម្លើយយើង។
ដូច្នេះ យើងមានកាតព្វកិច្ចត្រាប់តាមការប្រៀន ប្រដៅរបស់អ៊ីម៉ាម - ក្រោកឡើងប្រឆាំងនឹងកេរ ដំណែលអយុត្តិធម៌ ។
