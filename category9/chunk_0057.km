ខ្ញុំមិនបានមកដើម្បីហៅមនុស្សសុចរិតទេ គឺមកដើម្បីហៅមនុស្សមាន បាបឲ្យ ប្រែ ចិត្ត » ។
ដូចយើងបានឃើញហើយ មនុស្សស្លាប់មិនមានការ ឈឺចាប់ ឬឈឺ ចិត្តឡើយ ។
គ្មាន អ្នកណា ដឹង ទេ មិន មែន គ្រួសារ ខ្ញុំ ទេ ។
មានទុរ្ភិក្សធ្ងន់ធ្ងរនៅស្រុកសាម៉ារី ។
ទិវា នៃ ក្តីស្រឡាញ់ គឺជា ពេលវេលា ដែល មនុស្ស បង្ហាញ សេចក្តីស្រឡាញ់ របស់ ពួកគេ ចំពោះ គ្នា ទៅ វិញ ទៅមក ។
សប្តាហ៍ ដំបូង របស់ ខ្ញុំ ខ្ញុំ ភ័យ ខ្លាំង ណាស់ ។
ហើយ ពី ទេវតា ទាំង ពីរ នេះ
បើក ខ្លួនអ្នក ទៅនឹង វេទមន្ត នៃ ជីវិត ។ .
នាងឆ្លើយ ត ប ថា “ ស្ត្រីនេះនិយាយមកខ្ញុំថា ឲ្យកូនឯង ស៊ីថ្ងៃនេះ ហើយយើងនឹង ស៊ីកូននៅថ្ងៃស្អែក ” ដូច្នេះហើយបានជាយើងស្ងោរកូនប្រុសឲ្យ ស៊ី ។
៣២ មនុស្សអាក្រក់មើលមនុស្សសុចរិត ហើយរកសម្លាប់គេ ។
យើងអរគុណព្រះ ចំពោះព្រះចេស្ដានៃព្រះវិញ្ញាណបរិសុទ្ធដែលគង់នៅក្នុងយើង ហើយជួយយើង ។
រាងវាហើយបោះចោលដោយរីក ចម្រើននៃការ អភ័យទោស និងការ ទទួល យក ។
ហើយ ស្ត្រី ដែល គាំទ្រ ពួកគេ ផងដែរ ។
អ្នក និយាយ ត្រូវ នេះ សម នឹង ការរង់ចាំ ។
5 ចូរក្រឡេកមើលទៅលើមេឃ ហើយមើលទៅផ្ទៃមេឃខ្ពស់ជាង
របៀប ដើម្បី ទទួលបាន កូដ ប្រភព នៃ ឧបករណ៍ នេះ ។
គ្រោះ កាច ទី ១០ ត្រូវបាន ម៉ូសេពន្យល់ ដល់ ផារ៉ោន តាម របៀប នេះ៖
ប្រសិនបើ អ្នក នៅក្នុង ក្រុមហ៊ុន ឬ ភ្នាក់ងារ សម្តែង វា មិន ពិបាក ទេ ។
ចូរក្រោកឡើង វានឹងចេញទៅលើដី ។
កំពុង ស្វែងរក ហ្គេម កុំព្យូទ័រ
ថ្ងៃ នេះ នៅ ការិយាល័យ របស់
ពេលឃើញព្រះអង្គក៏ថ្វាយបង្គំព្រះអង្គ ។ ប៉ុន្តែ អ្នក ខ្លះ សង្ស័យ ។
« ហោរាគ្មានកិត្តិយសក្នុងប្រទេសរបស់ខ្លួនទេ » ។
ដោយយើងមិនងាយ រកវាបាននៅទី នោះ នាងបានធ្វើចានដូងដោយខ្លួន ឯង ។
ណាសាបានបង្ហាញថាវាមានសមត្ថភាព
ព្រះ យេស៊ូវបានមាន បន្ទូលថា “ ព្រះបន្ទូលទ្រង់ជាសេចក្តី ពិត ” ។
ម្តាយ ខ្ញុំ ច្រៀង ខ្លួន ឯង ពេល កំពុង សម្អាត ផ្ទះ រៀបចំ អាហារ ហើយ ពេល គាត់ ងូតទឹក ម្តង ក្នុង មួយ សប្តាហ៍ ។
ស្ត្រីបោសសម្អាតឃើញក៏សួរថាឡើងទម្ងន់ឬ ?
ធ្វើ បាន ល្អ ប្រសិនបើ អ្នក ជា អ្នកនិពន្ធ ។
ទោះបីជាពួកគេ បង្វែរការ លេងរបស់ពួកគេក៏ដោយ ពួកគេនឹងពិបាកក្នុងការ ប្រកួតជាមួយនឹងគេ » ។
គាត់នឹងបង្កើតបានមេ ដប់ ពីរនាក់ ហើយយើងនឹងតាំងគាត់ជាប្រជាជាតិដ៏ធំ ។
វា ពិសេស ណាស់ សម្រាប់ ខ្ញុំ ក្នុង ការឈ្នះ នៅ ទីនេះ ។
សួរខ្លួនឯងថា " តើខ្ញុំបានបញ្ជាក់ថាគាត់ស្លាប់នៅទី ណាទេ ? "
ទោះ យ៉ាងណា ក៏ដោយ យើង អាច ការពារ ខ្លួន យើង ។
116 សូមទ្រ ខ្ញុំតាមពាក្យរបស់អ្នក ដើម្បីឲ្យខ្ញុំមានជីវិត ហើយកុំឲ្យខ្ញុំខ្មាសនឹងសេចក្ដីសង្ឃឹមរបស់ខ្ញុំឡើយ ។
រំខាន ដោយ ការទទួលខុសត្រូវ !
ជាពិសេស បន្ទាប់ពី បាន ឃើញ កន្លែង មួយចំនួន ដែល យើង កំពុង សិក្សា ។
ខ្ញុំសរសេរសេចក្ដី ទាំងនេះទៅអ្នក រាល់គ្នាដែលជឿលើព្រះនាមព្រះរាជបុត្រានៃព្រះ អ្នកអាចនឹងដឹងថា អ្នកមានជីវិតអស់ កល្ប ជានិច្ច ។
ស្ត្រីនោះភ្ញាក់ពីដំណេក ហើយក្រោកឡើងដោយខ្លួន ឯង ។
ការធ្វើ ចំណាកស្រុក ម៉ិកស៊ិក ទៅកាន់ សហរដ្ឋ អាមេរិក មាន ផលិតភាព ច្រើន ជាង 5 ដង
កុំ ធ្វើ អ្វី ដែល រារាំង ការលក់ ។
ប្រសិនបើអ្នកនៅជាប់ក្នុងខ្ញុំ ហើយខ្ញុំនៅក្នុងអ្នក អ្នកនឹងបង្កើតផ្លែផ្កាទៅក្រៅពីខ្ញុំ អ្នកមិនអាចធ្វើអ្វីបានឡើយ » ។
ថា គាត់ គួរតែ មកពី ក្នុង ចំណោម អ្នក ដែល ត្រូវបាន សន្យា ថា នឹង ចូល
ទោះបីជាឪពុកជិតស្លាប់បន្ទាប់ពីត្រូវគោមួយក្បាលរបស់គេទាត់ ។
អ្នក ឈ្នះ នឹង ត្រូវបាន ចាប់ នៅ ថ្ងៃ នោះ ។
បាន ផ្លាស់ប្តូរ ចេញ ពី ស្នេហា ។
សកលលោក អាច ត្រូវបាន កែច្នៃ ឡើងវិញ
“ ខ្ញុំប្រាប់អ្នក រាល់គ្នាថា ដីនោះស្អាត ។
១០ នាងមាន ចិត្តជូរ ចត់ ហើយអធិស្ឋានដល់ព្រះ យេហូវ៉ា ហើយយំ ជាខ្លាំង ។
គេច ចេញ ពី អំពើ អាក្រក់ ។
ខ្ញុំ សប្បាយ ចិត្ត នៅពេល ខ្ញុំ នៅ ជាមួយ មនុស្ស ហើយ ខ្ញុំ កំពុង និយាយ ជាមួយ ពួកគេ ។
ជ្រុង ខាងស្តាំ ខាងលើ បង្ហាញ ថា តើ ពេលវេលា នៅសល់ ប៉ុន្មាន ។
ហើយដាវីឌ បានតែងតាំងគាត់ជាមេ អង្គរក្សរបស់គាត់ ។
ដោយ ដៃ របស់ មនុស្ស ខូច
20 សូមប្រគល់អំណាចខ្លះដល់គាត់ ដើម្បីឲ្យសហគមន៍អ៊ីស្រា ‌ អែលទាំងមូលស្តាប់បង្គាប់គាត់ ។
2 ដែលបានថ្លែង សក្ខីភាពអំពីព្រះបន្ទូលនៃព្រះ និងពីទី បន្ទាល់របស់ព្រះយេស៊ូវ គ្រីស្ទ ( សូម្បីតែ ) អំពីគ្រប់ ការណ៍ដែលគាត់បានឃើញ ។
ក្មេងក្រុងខ្លះក៏មិនដឹងដែរ ។
ផែនដី ទាំងមូល នឹង ពោរពេញ ដោយ ចំណេះដឹង អំពី សិរី ល្អ របស់ ទ្រង់ !
រហូតដល់រូបព្រះ ត្រូវបានគេដាក់នៅក្នុងព្រះវិហារបរិសុទ្ធ គាត់មិនបានចាប់ផ្ដើមការ បះបោររបស់គាត់ទេ ។
អ្នក មិន អាច បង្ខំ នរណា ម្នាក់ ឱ្យ អធិស្ឋាន បាន ទេ ។
សង្កត់ អ្នក ដូចជា ថ្ម ។
សូលមានបំណងចង់ឲ្យដាវីឌ ធ្លាក់ទៅក្នុងកណ្ដាប់ដៃរបស់ជន ជាតិភីលី ស្ទីន ។
តើវាក៏ត្រូវបានគេរាប់ បញ្ចូលដែរឬទេ ?
« មិនបានញ៉ាំអីទាល់ តែខ្ញុំប្រាប់អ្នកពីអ្វីដែលខ្ញុំត្រូវប្រាប់ » ។
១៤ហេតុដូច្នោះហើយ ខ្ញុំប្រាថ្នាចង់ឲ្យស្ត្រីមេម៉ាយក្មេងៗរៀបការ បង្កើតកូន ចាត់ចែងផ្ទះ ដើម្បីកុំឲ្យឱកាសដល់មារ ស ត្រូវដោយ សារតែពាក្យតិះដៀល
ផ្តល់ ឱកាស ឱ្យ ខ្ញុំ ដើម្បី បញ្ជាក់ ថា វា មិន ងាយស្រួល ទេ ក្នុង ការផ្គាប់ ចិត្ត កូនប្រុស ម្នាក់ ។
« ច្បាប់គ្រា អាសន្នក្នុងពេលនេះនឹងមិនត្រូវបានប្រជាជនទទួល យកទេ ។
៥ ប៉ុន្តែពេលអេលី ហ៊ូវឃើញថាគ្មាន ចម្លើយនៅក្នុងមាត់របស់បុរសទាំងបីនាក់នេះ គាត់ក៏ខឹង ។
