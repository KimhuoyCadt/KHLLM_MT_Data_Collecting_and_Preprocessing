គាត់ កំពុង មើល អ្នក ដើម្បី ជួយ អ្នក និង ប្រទាន ពរ ដល់ អ្នក ។
ប៉ុន្តែខ្ញុំនឹងចូលធ្វើការ វិញនៅពេលដែលខ្ញុំត្រូវបានអនុញ្ញាត » ។
កុំ បាញ់ នៅ កម្ពុជា
មែន ហើយ នាង តែងតែ សុខចិត្ត បិទ មាត់ ហើយ ស្តាប់ ខ្ញុំ ។
ដូច្នេះត្រូវរក្សាពួកគេនៅតាមផ្លូវជារៀងរហូត !
ជំនឿ ដែល អ្នក សាងសង់ សៀវភៅ ដែល អ្នកអាន មនុស្ស ដែល អ្នក ឃើញ ក្នុង ភាពយន្ត ផ្លាស់ប្តូរ របៀប ដែល អ្នក មើលឃើញ ពិភពលោក ហើយ ធ្វើឱ្យ អ្នក ក្លាយជា មនុស្ស សព្វ ថ្ងៃ នេះ ។
" អំពីប្រជាជនរបស់ខ្ញុំ និងពេលដែលយើងនឹងទៅដល់ពួកគេ " ។
ប៉ុន្តែខ្ញុំគិតពីមុខគេច្រើនជាង ។
ឥទ្ធិពល លើ អ្នក ដែល មិន បោះបង់ ចោល ។
មួយចំនួននៃអត្ថន័យនៃ បទ ចម្រៀង " មានអ្នក ណាចង់ស្រឡាញ់អ្នក ណាដូចខ្ញុំ ?
ជាមួយនឹង ដ្រាយ វ៍ រឹង អ្នកបើកបរ ។
ប្រសិនបើ អ្នក ធ្លាប់ គិត អំពី ថ្ងៃ នេះ
ការបះបោរ ប្រឆាំង នឹង ការគំរាមកំហែង របស់ ស្តេច សាឡូម៉ូន
រោគដែលលោកបានដឹង
មាន ទារក នៅ ទីនេះ ផងដែរ ។
ប្រើ ពាក្យ សម្បថ ក្នុង ព្រះនាម ព្រះជា ម្ចាស់
ព្រះយេស៊ូយាងឡើងលើភ្នំមួយ ហើយព្រះអង្គគង់នៅ ទីនោះជាមួយសិស្សរបស់ព្រះអង្គ ។
« មានមនុស្សប៉ុន្មាននាក់ទៀតដែលបានឃើញការរត់គេចរបស់ព្រះ នោះ ? »
ខ្ញុំ តែងតែ ទុក នាង ចោល រហូតដល់ នាង ស្រែក រក ខ្ញុំ ។
មនុស្សដែលខ្ញុំមិនអាចទៅដល់ » ។
ចចក៖ ទឹកឃ្មុំ សូម ប្រាប់ ខ្ញុំ ពី របៀប ធ្វើ វា ។
ដរាបណា អ្នក ឈប់ សូម ត្រលប់ ទៅការរត់ វិញ ។
គាត់មិនទៅមើលស្ត្រីនោះតាម រយៈកាំភ្លើងវែងទេ ។
គ្រួសារ បង ស្រី ខ្ញុំ ត្រូវ ប្រើ របស់ គេ រួចហើយ ។
បាន សន្យា ថា នឹង វិលត្រឡប់ មកវិញ ទ្រង់ នឹង នាំមក នូវ សន្តិភាព ដល់ ផែនដី និង ប្រជាជន នៅលើ ផែនដី ។
ពិភពលោក ទាំងមូល កំពុង សម្លឹងមើល ពួកគេ » ។
« មាន ពរ ហើយ អស់ អ្នក ដែល អំពើ ទុច្ចរិត ត្រូវបាន លើកលែង ទោស ហើយ អំពើ បាប ត្រូវបាន បិទបាំង ។
គាត់បានឃើញពួកគេដូចដែលពួកគេត្រូវបានគេចង់បានដូចជាពួកគេនៅក្នុងភ្នែករបស់
៥ ហើយមានសំឡេងចេញពីបល្ល័ង្កមក ថា៖ « ចូរសរសើរ ត ម្កើងព្រះ នៃយើងខ្ញុំ អ្នក បម្រើទាំងអស់ និងអ្នកដែលកោតខ្លាចព្រះអង្គ ទាំងអ្នកតូចទាំងធំ » ។
ចូរប្រយ័ត្ននឹងព្យាការីក្លែងក្លាយ .. . អ្នកនឹងស្គាល់ពួកគេដោយ ផលផ្លែរបស់ពួកគេ ...
នៅក្នុង ហ្គេម បែប នេះ អ្នក ត្រូវការ អាកប្បកិរិយា នេះ ចំពោះ អ្នក បោកប្រាស់ ។
ជា ការប្រសើរ ណាស់ ដោយ ផ្អែក លើ ឈ្មោះ អ្នកប្រើប្រាស់ របស់ អ្នក អ្នក ពិតជា ជិត ដល់ ឋាន នរក ហើយ ។
មិននឹកស្មានថាឈឺ ចិត្តខ្លះទេ ?
តាម របៀប ស្រដៀង គ្នា មាន ពាក្យបញ្ជា ពិសេស ដែល ត្រូវបាន យល់
ហេតុ អ្វីបានជាអ្នកគួរព្យាយាមចែចង់ជាមួយបុរសដែលរៀបការ រួច ?
នឹង ភ្លឺ ជាង ព្រះអាទិត្យ ប្រាំពីរ ដង ។
វា មិន មែន ជាមួយ មជ្ឈមណ្ឌល ទេ ។
បន្ទាប់មក លោកមាន ប្រសាសន៍ទៅពួកគេ ថា៖ « ព្រលឹងខ្ញុំរងទុក្ខព្រួយរហូតដល់ស្លាប់ ។
« យើងនឹងបន្តធ្វើ ការ យ៉ាងជិតស្និទ្ធជាមួយប្រទេសឥណ្ឌាដើម្បីធានាថាមហាសមុទ្រឥណ្ឌានៅតែមានសុវត្ថិភាព។
ចងចាំ អត្ថន័យ នៃ ការអភ័យទោស ។
គ្មានអ្វីដែល សង្ស័យថាគាត់ស្រឡាញ់អ្នកទេ ។
ឆ្នេរនេះមិនត្រូវបានគេអភិវឌ្ឍទេ ហើយមានទាំងអស់
« ប៉ុន្តែ ពេត្រុសនៅ តែគោះទ្វារ ហើយពេលគេបើកទ្វារឃើញគាត់ នោះពួកគេភ្ញាក់ផ្អើល ។
៨ យើងមិនអាចធ្វើអ្វីប្រឆាំងនឹងសេចក្ដី ពិតបានឡើយ គឺសម្រាប់ តែសេចក្ដី ពិតប៉ុណ្ណោះ ។
ខ្ញុំ រស់នៅ ទីនេះអស់១៥ ឆ្នាំ ហើយមានអារម្មណ៍ថានៅផ្ទះ » ។
ភ្លឺ ដូច ភ្លើង ឆេះ ។
43 ពេលនោះមានទេវតាមួយរូប មក កាន់គាត់ ដោយ មកពីស្ថាន បរម សុខ មកជួយគាត់ ។
មាន ពរ ហើយ អ្នកបង្កើត សន្តិភាព ពួកគេ នឹង ត្រូវបាន គេ ហៅ ថា ជា កូន របស់ ព្រះ។
នោះ អាច ជួយ សេដ្ឋកិច្ច អាមេរិក កាន់តែ ទូលំទូលាយ ។
អ្នក ណាដែលជឿលើខ្ញុំនឹងមានជីវិត ទោះបីស្លាប់ក៏ដោយ ” ហើយអ្នក ណាដែល រស់ដោយជឿលើខ្ញុំនឹងមិនស្លាប់ឡើយ ។
អ្នក បាន បង្កើត អ្វី ៗ ទាំងអស់ ។
ដ្បិតការ កោតខ្លាចព្រះ មិននៅចំពោះមុខគេទេ ។
ហើយ វា បាន ធ្វើ យ៉ាង ស្ងប់ស្ងាត់ ។
ម្យ៉ាង វិញ ទៀត ការ សង្កត់ធ្ងន់ គឺជា របៀប ដែល អ្នក អាច យក អតីត របស់ អ្នក មកវិញ នៅ យប់ នេះ ។
ទោះជា យ៉ាង នេះ ក្តី មន្ត្រី អាមេរិក បាន និយាយ ថា វា នឹង ត្រូវការ ពេលវេលា ខ្លះ ដើម្បី បញ្ចប់ ការវិភាគ យ៉ាង ម៉ត់ចត់ នៃ ទំហំ នៃ ការបំផ្ទុះ និង ប្រភេទ ឧបករណ៍ ដែល បាន បំផ្ទុះ ។
ប្រាសាទនេះជាប្រាសាទ...
យើងនឹងបន្តស្វែងរកខ្លួនយើងក្នុងស្ថានភាពដដែល ដោយនៅ លីវរហូត ។
គ្មាន ចំនួន ប្រជាជន ជា របស់ រដ្ឋ C គឺ ច្បាស់លាស់ និង ពិតប្រាកដ ។
“ ខ្ញុំខ្លាចខ្លាំងចំពោះការ មានព្រឹត្តិការណ៍អូឡាំពិក មិនមែនសម្រាប់ តែប្រទេសជប៉ុនទេ ប៉ុន្តែសម្រាប់ប្រទេស ជាច្រើន ។
គាត់ នៅជិត អ្នក ដូចជា មិត្ត ជិតស្និទ្ធ បំផុត ឬ ដៃគូ របស់ អ្នក ។
43 ស៊ីម៉ូន ឆ្លើយ ថា៖ « ខ្ញុំស្មានថាអ្នកនោះបានលើកលែងទោសទៀត » ។
ដោយបញ្ជាក់ថា លោកត្រូវបានគេ បណ្តេញចេញ
ដូច ដែល អ្នក បាន ដឹង ហើយ ថា ទឹកដោះ ម្តាយ មាន សារៈសំខាន់ ខ្លាំង ណាស់ សម្រាប់ កូន របស់ អ្នក យ៉ាងហោចណាស់ សម្រាប់ រយៈពេល ប្រាំមួយ ខែ ដំបូង ។
អ្នកមានចំណេះដឹងរួមគ្នាជាច្រើនអំពីអ្វីដែលពិតជាមានប្រសិទ្ធភាព ។
ចងចាំ ក្នុង គម្ពីរ សញ្ញា ចាស់ បន្ទាប់ពី បទ គម្ពីរ ត្រូវបាន លាក់ ទុក ជា យូរ ណាស់ មកហើយ ហើយ វា ត្រូវបាន បញ្ចេញ ហើយ វា ត្រូវបាន អាន មុន មនុស្ស ?
ពួកគេ ប្រាំមួយ ឬ ប្រាំពីរ នាក់ អង្គុយ នៅលើ ដី ខ្ចាត់ខ្ចាយ នៅ ជុំវិញ ដៃ របស់ ពួកគេ នៅ ពីក្រោយ ខ្នង របស់ ពួកគេ ។
រាងជើងសេះដូច្នេះពន្លឺធ្លាក់មកលើដា ហូប ( អាសនៈ )
ហើយ គាត់ បាន និយាយ ថា " ខ្ញុំ នៅ ទីនេះ " ។ ៣ រួចគាត់មាន ប្រសាសន៍ ថា៖ « យើងជាព្រះ ជាព្រះ របស់ឪពុកអ្នក កុំខ្លាចចុះទៅស្រុកអេស៊ីបឡើយ ដ្បិតនៅ ទីនោះ យើងនឹងបង្កើតប្រជាជាតិដ៏ធំមួយពីអ្នក ។
ជាថ្មី ម្តង ទៀត គាត់ នឹង
ប៉ុន្តែ ពួកគេ នៅតែ មាន ការព្រួយបារម្ភ ។
ហៅ ទៅ គ្រួសារ ។
ខ្ញុំអាណិតគាត់ខ្លាំងណាស់ ព្រោះគាត់ត្រូវគេបោក » ។
នៅ ពេល ដែល ឆន្ទៈ ស្ថិត នៅក្រោម ការគ្រប់គ្រង នៃ អារម្មណ៍ រាងកាយ ។
នាងបានគំរាមប្ដឹងអ្នក ណាដែលផ្សាយរូបភាពតាមអ៊ីនធឺណិត ។
ប្រាប់គេឲ្យចេញទៅខាងក្រៅ ហើយត្រូវ « ឃើញ តែមិនឮ » ។
