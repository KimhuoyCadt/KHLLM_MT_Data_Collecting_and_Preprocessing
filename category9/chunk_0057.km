ពួកគេចង់ឲ្យសាលាត្រូវដក ចេញជាអចិន្ត្រៃយ៍ ។
ទឹកនោម មាន ពពុះ តើ ខ្ញុំ គួរ ព្រួយបារម្ភ ទេ ?
យើងជាអ្នកវង្វេងម្ដងទៀត ហើយជាអ្នក ស៊ីស្មៅ ។
តើយើងមិនពឹងលើម្ចាស់ផែនដីដូចគ្នាទេឬ ?
នេះ ជា ការរំលោភ សិទ្ធិ របស់ ខ្ញុំ ។
ដើម្បី ដោះស្រាយ បញ្ហា នេះ នេះ ជា ចំណុច មួយចំនួន ដែល អ្នក អាច សាកល្បង បាន !
ពេលអ្នកទាំងដប់នាក់បានឮដូច្នេះ ពួកគេខឹងយ៉ាកុប និង យ៉ូហាន ។
មាន គំនិត ជា ភាសា ផ្លូវការ ទាំង ប្រាំមួយ របស់ អង្គការ សហ ប្រជាជាតិ !
នឹង មាន ផល ប៉ះពាល់
ខ្ញុំ នឹង បង្រួបបង្រួម ស្នេហា របស់ អ្នក ។
នៅ ទីនេះ នៅ អឺរ៉ុប គ្រាន់តែ ទទួលបាន ការងារ ជា ជនជាតិ ស្បែក ខ្មៅ គឺ ពិបាក ណាស់ ។
ដូច្នេះប្រសិនបើអ្នក ឃើញរូបសំណាកដែលមានឈាមប្រឡាក់ពេញមាត់របស់វា សូមប្រយ័ត្ន ។
តើអ្នកមិនបានកត់សម្គាល់ថារឿងនេះបានកើតឡើងលើអ្នកពីរឬបីដងទេឬ ?
ការប្រជុំ ដូចជា រដូវ រងា នៅ ភាគ ខាងជើង ។
អស់អ្នកដែលមិនមានវិញ្ញាណរបស់ព្រះ គឺមិនមែនជារបស់គាត់ ។
គាត់មិនដឹងទេ ហើយគាត់បាននិយាយថា៖ « ខ្ញុំមិនដឹងទេ » ។
មានរឿងជាច្រើនដែល ទប់មិនឲ្យគាត់ឈឺចាប់ » ។
ហើយ ឆាប់ ៗ នេះ គាត់ នឹង ត្រូវ ឧទ្ទិស ដល់ ពេជ្ឈឃាដ ។
វា មិន ត្រឹមតែ ជា ទិដ្ឋភាព សំខាន់ សម្រាប់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ប៉ុណ្ណោះ ទេ
ខណៈដែល ចិត្តគេនៅឆ្ងាយពីខ្ញុំ » ។
គាត់ បាន និយាយ ថា " ខ្ញុំ ជឿ ថា យើង ត្រូវការ តួនាទី សកម្ម បន្ថែម ទៀត សម្រាប់ រដ្ឋាភិបាល និង និយតករ ។
ការសន្យានឹងត្រូវគោរព » ។
« ខ្ញុំប្រាប់អ្នកយ៉ាងពិតប្រាកដថា ម្នាក់ក្នុងចំណោមអ្នក រាល់គ្នានឹងក្បត់ខ្ញុំ » ។
ការ ញ៉ាំអាហារពេលយប់គឺជាទម្លាប់អាក្រក់ ។
កាលព្រះយេស៊ូយាងចេញពីព្រះវិហារទៅ សិស្សម្នាក់ទូលព្រះអង្គថា៖
កាលព្រះយេស៊ូយាងចេញពីព្រះវិហារ សិស្សម្នាក់ទូលព្រះអង្គថា៖
នោះជាឈុតមួយដែលអ្នកមិនធ្លាប់បានឃើញពីមុនមកក្នុង សភា » ។
ជា កម្មសិទ្ធិ របស់ បុរស ម្នាក់ ដែល មាន
នៅលើ កាលបរិច្ឆេទ ដំបូង ។ អនុញ្ញាតឱ្យ អ្នកធ្វើ តាម ។
« ហើយអ្នកដឹងថាគ្មានឃាតកណាមានជីវិតអស់ កល្ប នៅក្នុងខ្លួននោះទេ » ។
សមាមាត្រ នៃ បុរស នឹង ឈប់ ។
មិន ដឹង ថា មាន អ្វី នៅ ទីនោះ ទេ ខ្ញុំ បាន សម្រេចចិត្ត ធ្វើដំណើរ ទាំងស្រុង ។
ពួកគេចង់សម្លាប់ខ្ញុំ » ។
២ យើងក៏បានទទួលបានការចូលតាមរយៈទ្រង់ផងដែរដោយសេចក្ដី ជំនឿចំពោះព្រះគុណនេះ ដែលយើងឈរ ហើយយើងរីករាយក្នុងសេចក្ដីសង្ឃឹមនៃសិរី ល្អនៃព្រះ។
កុំ សូម្បីតែ មួយ វិនាទី ដើម្បី ដកដង្ហើម
ស៊ូ ដង់ ខាងត្បូង មិន បំពេញ លក្ខខណ្ឌ ទាំង ពីរ នេះ ទេ ។
អ្នក ស្គាល់ ខ្ញុំ ហើយ កន្លែងណា ដែល ខ្ញុំ ទៅ អ្នក នឹង តាម ខ្ញុំ ។
40 ចូរធ្វើការ ទាំងនេះ ដើម្បីឲ្យគេខ្លាចអ្នករាល់ថ្ងៃដែលពួកគេ រស់នៅលើទឹកដីដែលអ្នកបានប្រគល់ឲ្យដូនតារបស់យើង ។
ការអភ័យទោស ធ្វើឱ្យ យល់ បាន តែ នៅក្នុង ពន្លឺ នៃ សេចក្តីសុចរិត និង យុត្តិធម៌ របស់ ព្រះប៉ុណ្ណោះ ។
ខ្ញុំ បាន ទៅ ទីនោះ មុនពេល ព្រឹត្តិការណ៍ ចាប់ផ្តើម ។
ហើយអរ សប្បាយជាមួយនឹងពួកគេ » ។
គ្រប់គ្នាដែលបានឮមានការ ភ្ញាក់ផ្អើលចំពោះអ្វីដែលពួកគង្វាលបាននិយាយ ។
តើអ្នកអភិវឌ្ឍជំនឿថាអ្នកមានសមត្ថភាពសម្រេចបានតាមអ្វីដែលអ្នកប្រាថ្នាចង់បាន ?
សាច់រឿង បន្ត ពី ការប្រកួត ដែល បាន លេង ។
ពួកគេមិនជឿលើការ ថ្វាយ បង្គំរបស់ធម្មជាតិ ឬការ ថ្វាយ បង្គំរូបព្រះ ឡើយ ។
ដល់ថ្ងៃត្រង់ហើយ តើអភិបាលនៅឯណា ? »
បញ្ហា មួយ កើតឡើង នៅ ពេល ដែល អ្នក ត្រូវបាន ប្រឹក្សា ដោយ មនុស្ស ច្រើន ពេក ជាពិសេស ប្រសិនបើ ពួកគេ ភាគ ច្រើន មិន មាន ភារកិច្ច និង ការយល់ដឹង ពី ព្រះសម្រាប់ អាពាហ៍ពិពាហ៍ របស់ អ្នក ។
ហើយគាត់បានបន្តផ្សព្វផ្សាយនៅក្នុងសាលា ប្រជុំនានានៃស្រុកយូដា » ។
ដៃ ដូច្នេះ គ្មាន នរណា ម្នាក់ អាច មើលឃើញ ។
ដូច្នេះកុំទុកឲ្យការ ធ្វើដំណើររបស់មនុស្សជាទី ស្រឡាញ់របស់អ្នកឆ្លងកាត់ បន្ទុកនៃពិភពលោកនេះ ។
អរគុណណាស់ដែលមានភ្លៀងធ្លាក់ច្រើន ដូច្នេះខ្ញុំជឿថារុក្ខជាតិទាំងនេះអាច រស់បានគ្រប់យ៉ាង » ។
ពួកគេត្រូវប្រើអំណាចរបស់ខ្លួនក្នុងលក្ខណៈដែលគោរពព្រះ។
អ្វី ដែល អ្នក ត្រូវ ធ្វើ គឺ បង្កើត មាតិកា ដ៏ អស្ចារ្យ !
វត្ថុ ដែល ឆ្លុះបញ្ចាំង នៅក្នុង ទឹក និង នៅ ត្រី នៅ ខាងក្រោម ។
អ្នកជំពាក់ ខ្ញុំ ច្រើន អាវ ហើយ ខ្ញុំ នឹង មក ប្រមូល !
ពួកសិស្សទូលសួរព្រះអង្គ ថា៖ ‹ លោកគ្រូដែលធ្វើ បាប បុរសនេះ ឬឪពុកម្ដាយរបស់គាត់ ដែលគាត់កើតមកខ្វាក់ ? › ។
ហា៎ តាមមើលបញ្ហារបស់អ្នក ខ្ញុំ ជឿថា តាមពិត វាជាទ្វារមាសរបស់អ្នក ។
តាម រយៈគ្រួសារនេះ និងអ្នក ដទៃ គាត់ក៏បានកំណត់ផ្សេងទៀតដែរ ។
តើគេហៅវាថាជាថ្ងៃរបស់មនុស្សស្រី ?
មុនការ ស្រែកជេរប្រមាថ ។
លោករស់នៅវាល រហោស្ថានរហូតដល់ថ្ងៃដែលលោកបង្ហាញខ្លួនដល់ជន ជាតិអ៊ីស្រាអែល ។
៣ហើយពួកគេនឹងធ្វើការ នេះ ដោយ សារពួកគេមិនបានស្គាល់ព្រះវរ បិតា ឬក៏ខ្ញុំដែរ ។
ខ្ញុំឃើញមេឃបើក ហើយកូនមនុស្សឈរនៅខាងស្ដាំព្រះ។
« ពេលលោកយេស៊ូមាន ប្រសាសន៍ដូច្នេះ មន្ត្រីម្នាក់នៅក្បែរនោះបានទះ កំផ្លៀងលោក ។
ខ្ញុំនិងប្តីប្រពន្ធរបស់ខ្ញុំស្រឡាញ់វា។
គោល នយោបាយ នៅ ហ៊ូស្តុន ។
" ប្រសិនបើ យើង មិន ចាប់ផ្តើម មើល រឿង នេះ
ប៉ុន្តែ វា មិន មែន គ្រាន់តែ ជា ការបំប្លែង ផ្លូវចិត្ត នោះ ទេ ។ វាមិនបាននិយាយថា៖ « នេះជាការ ពិត ការ ធ្វើតាមរូបព្រះ គឺជារឿងខុស ។
ហេតុនេះហើយបានជាគេអាច ទម្លុះឆ្អឹងសត្វព្រៃបាន
ដូច្នេះ ខ្ញុំគិតថាចាំបាច់ត្រូវដាស់តឿនបងប្អូនឲ្យមក រកអ្នក ហើយរៀបចំជាមុនសម្រាប់អំណោយដែលអ្នកបាន សន្យា ។
« នេះជាកូនជាទី ស្រឡាញ់របស់ខ្ញុំ ដែលខ្ញុំបានជ្រើស រើស » ។
ប្រសិនបើ អ្នក ទទួលបាន ទឹកដោះគោ ជូរ
ប្រវត្តិពីរ រយសែសិបឆ្នាំធ្លាក់បង្គន់ ?
« នេះជាភស្ដុតាងនៃការ វិនិច្ឆ័យដ៏សុចរិតរបស់ព្រះ ហើយមានបំណងធ្វើឲ្យអ្នក សក្ដិសមនឹងនគរនៃព្រះ ដែលអ្នកត្រូវរងទុក្ខដែរ » ( ខ. ៥) ។
ដើម្បី បញ្ជា ក់៖ ខ្ញុំ សំដៅ លើ រូបថត ក្នុង អត្ថបទ ។
ពេល ថ្ងៃ ជា របស់ មនុស្ស យប់
អ្វី ដែល ជនជាតិ អង់គ្លេស និង អាមេរិក អាច ធ្វើ បាន ។
វា ជា ការចំណាយ លិច ។
យើង ទាំង ពីរ នាក់ ក៏ ស្រវឹង ខ្លាំង ដែរ ។
“ នេះជាទម្រង់ នាគរបស់ខ្ញុំ ដែលជាធម្មជាតិសម្រាប់ខ្ញុំ ។
ធ្វើ ដូចជា ត្រកូល ទាំងមូល គឺជា គ្រួសារ របស់ នាង ។
ចោរប្រដាប់អាវុធ តែ មួយ គាំទ្រ ។
« កុំចាត់ទុកគាត់ ជា ស ត្រូវឡើយ តែត្រូវដាស់តឿនគាត់ជាបងប្អូន » ។
អើរ៉ុនបានបោះ ដំបងទៅខាងមុខផារ៉ោន និងពួក មន្ត្រី ហើយវាក្លាយទៅជាពស់ ។
ខ្ញុំ ឃើញ មុខ អ្នក នៅ ពីមុខ ខ្ញុំ ។
នេះ ជា ក្តីសង្ឃឹម របស់ អាមេនី ។
កុំឈរឲ្យឪពុកម្ដាយធ្វើទាំងអស់ ។
ប្រសិនបើ អ្នក ធ្វើ ចងចាំ រឿង នេះ៖ អ្នក មិន គាំទ្រ ឫស ទេ ប៉ុន្តែ ឫស គាំទ្រ អ្នក ។
ហៅទូរស័ព្ទ ឬ បញ្ជា ។
ឧត្តមសេនីយ៍ គឺជា កន្លែង ដ៏ ល្អ បំផុត សម្រាប់ គាត់ ។
ខ្ញុំដឹងថាវាធ្វើឲ្យគាត់ខក ចិត្ត ប៉ុន្តែគាត់ខិតខំ ប្រឹងប្រែង » ។
ស្ទើរស្រក់ទឹកភ្នែកហើយ !
លោកយេស៊ូត្រូវមាន ប្រសាសន៍ទៅ កាន់អ្នក កាន់តាមលោកថា៖ « ចូរមាន ចិត្តអាណិតអាសូរ ដូចបិតារបស់អ្នក រាល់គ្នានៅស្ថានសួគ៌មាន ចិត្តអាណិតអាសូរ ព្រោះលោកមាន ចិត្តសប្បុរសចំពោះមនុស្សពាលនិងមនុស្សទុច្ចរិត » ។
អំពើ បាប របស់ ព្រះបិតា មិន មែន សម្រាប់ មនុស្ស ដែល មាន ចិត្ត ទន់ខ្សោយ នោះ ទេ ។
នេះ ជា អ្វី ដែល កូនប្រុស របស់ មិត្ត ខ្ញុំ បាន និយាយ ទៅកាន់ គាត់ កាលពី ថ្ងៃអាទិត្យ មុន បន្ទាប់ពី សាសនា ចក្រ ។
ហើយនៅថ្ងៃនោះ យើងនឹងស្វែង រកបំផ្លាញ អស់ទាំង សាសន៍ដែល មកវាយក្រុងយេរូសាឡិម .. .
ប៉ុន្តែគាត់មិនភ្លេចភាសាអារ៉ាប់ ជាភាសា កំណើតរបស់គាត់ទេ ។
ពេលខ្ញុំទៅទីនោះជាមួយមិត្តភ័ក្តិរបស់ខ្ញុំ យើងមិនបានទឹកសូម្បីតែកន្លះម៉ោង ។
អ្នក បានផ្តាច់ការ ទុក ចិត្តរបស់គេ មកលើអ្នក ហើយវានឹងមិនវិល មកវិញទេ ។
អឺរ៉ុប ទិញ ប្រេង ច្រើន ពី អ៊ីរ៉ង់ ។
គាត់ បាន ឈាន ទៅដល់ មូលដ្ឋាន ទី បី នៅលើ តែ មួយ
ឬ ចូល ទៅកាន់ មេ កានិក ពេញនិយម ។
មនុស្សបីនាក់ត្រូវបានចាប់ខ្លួនក្នុងខែ កញ្ញា និងខែ តុលា ឆ្នាំ ២០១១ ។
បន្ទាប់ពី កិច្ចប្រជុំ លោក Ja'afari បាន ទាមទារ ឱ្យ ក្រុម អ្នកចរចា របស់ ក្រុម ប្រឆាំង បរិហារ ការវាយប្រហារ នេះ ថា ជា សក្ខីភាព នៃ ការប្តេជ្ញាចិត្ត របស់ ពួកគេ ចំពោះ ដំណើរការ សន្តិភាព ។
ផែនដីមិនមែនជាកម្មសិទ្ធិរបស់អ្នក ណាទេ ប៉ុន្តែត្រូវបានប្រគល់ឲ្យទាំងអស់ ។
យើង មិន មែន ជា ទីផ្សារ គោលដៅ ដូច្នេះ យើង មិន សំខាន់ ទេ ។
តើមានលទ្ធភាពទេដែលប្រព័ន្ធផ្សព្វផ្សាយក្នុងទម្រង់អ៊ីនធឺណិតអាចដោះលែងយើងបាន ។
មិនតិចទេ ព្រោះជនជាប់ចោទ ជាមនុស្សចាស់ ។
ខ្ញុំ គិត ថា ការបកស្រាយ របស់ គាត់ គឺ ថា អ្នក ថ្វាយបង្គំ ព្រះអាទិទេព និង អ្នក ថ្វាយបង្គំ អារក្ស ភាគ ច្រើន ពិតជា បាន ថ្វាយបង្គំ ព្រះមួយ អង្គ ដែល មាន វ័យ ចំណាស់ ។
ប្រយ័ត្ន ចំពោះ ព័ត៌មាន មិន ពិត
ក្រោយមក ពួកគេបានកើតទឹកជំនន់ដោយ សារអំពើរំលងរបស់ពួកគេ ។
“ វា ជា ការខកចិត្ត សម្រាប់ ពួកយើង ក្នុង រយៈពេល ពីរ ឆ្នាំ ចុងក្រោយ នេះ ។
ចូល ចិត្តមើលហើយចង់វ៉ៃ !
