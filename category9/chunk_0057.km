3 ហើយព្រះ នៃយើងរាល់គ្នាគង់នៅស្ថាន សួគ៌ ។ បាន ធ្វើ អ្វី គ្រប់ យ៉ាង ដែល គាត់ ពេញចិត្ត ។
ហេ អ្នកកំពុងបំពេញកាតព្វកិច្ចសម្រាប់ ចច ។
យើង នឹង មិន បាត់បង់ ក្តីសង្ឃឹម ឡើយ ដរាបណា យើង ដកដង្ហើម ។
ការកាត់ក្តី ត្រូវបាន បញ្ចប់ នៅ ពេល ដែល ជនជាប់ចោទ ត្រូវបាន កោះហៅ ឱ្យ មក ធ្វើ ការសាកសួរ ។ ការ ចូលនៃការ អង្វរមិនមែនជាផ្នែកនៃការជំនុំ ជម្រះនោះទេ ។
ហេតុ អ្វី បានជា អ្នក គ្មាន ការគោរព ចំពោះ គ្រួសារ ឬ ចំពោះ ព្រះ ដ៏ មាន មហិទ្ធិ ឫទ្ធិ ដែល បាន បង្កើត វា ?
យើង ជឿ ថា ព្រះនាម ទ្រង់ គឺជា ផ្លូវ តែ មួយ គត់ ទៅកាន់ ព្រះវរ បិតា ។ មិន ថា នៅក្នុង ការអធិស្ឋាន ឬ សម្រាប់ ការសង្គ្រោះ ។
គាត់ បាន អាន ការហៅ ។
ខ្ញុំ ប្រាកដ ថា គាត់ នឹង ចាកចេញ ។
បើគ្មានមនុស្សស្រីក៏គ្មានអ្នក ណាដែរ ។
« បើអ្នក រាល់គ្នារស់នៅតាមនិស្ស័យ បាប នោះអ្នកនឹងត្រូវស្លាប់ ប៉ុន្តែបើអ្នក រាល់គ្នាសម្លាប់អំពើអាក្រក់ខាងរូប កាយដោយព្រះវិញ្ញាណ នោះអ្នកនឹងមានជីវិត ព្រោះអស់អ្នកដែលត្រូវបានព្រះវិញ្ញាណនៃព្រះដឹកនាំ គឺជាកូនរបស់ព្រះ» ( រ៉ូម ៨ :13) .
តើ យើង អាច ពន្លឿន ការមកដល់ នៃ រាជាណាចក្រ របស់ ព្រះដោយ របៀប ណា ?
រហូតដល់ អ្នក ឃើញ ពន្លឺ ។
ហើយ វា ជា ឋានសួគ៌ នៅលើ ផែនដី ។
រឿង ព្រេងនិទាន ថា ធ្លាប់ មាន ព្រះអាទិត្យ ដប់ នៅលើ មេឃ ។
របៀបដែលគេត្រូវចិញ្ចឹមគឺគ្រប់គ្រាន់ដើម្បីធ្វើឲ្យប្រាកដនោះ › ។
៧ ហើយនិយាយទៅ កាន់ជន ជាតិអ៊ីស្រាអែលទាំងមូលថា ៖ ទឹកដីដែលយើងបានដើរនោះល្អណាស់ ។
ហើយគាត់កាច់អុសសម្រាប់ តង្វាយដុត ។
ខ្ញុំ ឲ្យ អ្នក ឃើញ ខ្ញុំ បើក ។
ដូច្នេះ តើអ្នកចូលទៅក្នុងអំណាចនៃព្រះ ដោយរបៀបណា ?
នៅពេលត្រូវបានគេចោទប្រកាន់ ដើមបណ្តឹងបានសារភាពថាមិនមាន ទោស ។
តាំងពីពេលនោះមក ខ្ញុំតែង តែអនុវត្តវានៅពេលដែលខ្ញុំដោះស្រាយជាមួយមនុស្ស ។
ឥឡូវនេះ ស្ដីអំពីស្ត្រីព្រហ្ម ចារី ខ្ញុំគ្មាន បញ្ជាពីព្រះ អម្ចាស់ទេ ប៉ុន្តែខ្ញុំផ្ដល់យោបល់ថាជាអ្នកដែលគួរឲ្យទុក ចិត្តដោយសេចក្ដី មេត្តា ក រុណារបស់ព្រះ អម្ចាស់ ។
ទឹកដី និង កម្មសិទ្ធិ ហើយ សង្គ្រាម បាន មកដល់ ទ្វារ ឆ្ងាយ របស់ ពួកគេ ។
ព្រោះ គាត់ បាន ប្រគល់ អំណាច របស់ គាត់ ទៅ សត្វ ។
ការអត់ទោស មិន លុបបំបាត់ ផលវិបាក នៃ អំពើ បាប ទេ ។
ពួកគេហាក់ដូចជាមិនសូវដូចក្រិកទេ » ។
ចំណាប់អារម្មណ៍ នៅក្នុង ចិត្ត របស់ មនុស្ស ដែល បាន ឃើញ វា ។
ដូច្នេះ តើ មនុស្ស គ្រប់ គ្នា កំពុង និយាយ អំពី អ្វី ?
នៅថ្ងៃទីប្រាំពីរ អ្នកត្រូវធ្វើ សន្និបាតថ្វាយព្រះអម្ចាស់ ជាព្រះ របស់អ្នក ។ អ្នកមិនត្រូវធ្វើការណាមួយនៅថ្ងៃនោះទេ ។
ពី ផែនដី មុនពេលវេលា សមស្រប ។
តើយើងឮយើងម្នាក់ ៗជាភាសា កំណើតរបស់យើងយ៉ាងម៉េចដែរ ?
ខ្ញុំ បាន រៀន ថា ព្រះយេស៊ូវ ស្រឡាញ់ ខ្ញុំ ។
ដើម ឡើយ ពួកគេ ទាំងអស់ គ្នា មក ទីនេះ ដើម្បី សុំ ថ្នាំ ។
ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « ខ្ញុំបានធ្វើការ អស្ចារ្យមួយ ហើយអ្នក រាល់គ្នាភ្ញាក់ផ្អើល ។
គាត់ស្រឡាំងកាំង និងនិយាយមិនចេញមួយ រយៈ ។
ប្រសិនបើ វា មិន ដូច្នោះ ទេ អ្នក ត្រូវតែ កំណត់ ពាក្យ សម្ងាត់ អ្នកគ្រប់គ្រង ឡើងវិញ ។
ទិវាពលកម្មអន្តរជាតិ ឬហៅម្យ៉ាងទៀតថា ទិវាពលកម្មនៅកន្លែងខ្លះ ។
មាន កំណត់៖ គោលដៅ គួរ ត្រូវបាន កំណត់ មិន លើស ពី ពីរ បី សប្តាហ៍ ។
ខ្ញុំ គិត ថា ការអធិស្ឋាន ក៏ រៀបចំ យើង សម្រាប់ អ្វី ដែល នឹង មកដល់ ។
នៅរដូវភ្លៀង អ្នកត្រូវញ៉ាំអាហារទាំងនេះ
ដូច្នេះ តើរូប មន្តអ្វីដែលមានប្រសិទ្ធភាពបំផុតដើម្បីជំរុញការ រីកចម្រើន និងការ អភិវឌ្ឍរបស់កូនអ្នក ?
ចូរយើងមើលថាតើអេលីយ៉ានឹង មកចាប់គាត់ចុះឬទេ ?
គាត់ បាន យក ខ្សែ សង្វាក់ ដ៏ រឹងមាំ មួយ ។
ជីវិត របស់ ខ្ញុំ បាន ផ្លាស់ប្តូរ ជាមួយនឹង ការមកដល់ របស់ គាត់ ។
ជាមួយនឹង អ្វី ដែល អ្នក ចង់ ប្រើ កម្មវិធី ។
ហើយ គាត់ បាន ធ្វើឱ្យ ជីវិត របស់ ខ្ញុំ ធ្លាក់ចុះ ។
ហើយ ជា ការពិត មិន មែន គ្រប់ ស្ត្រី មាន ផ្ទៃពោះ នោះ ទេ ។
ដូច្នេះ គ្រូថាមិនពិតទេ មានសត្វស្លាបបីក្បាលនៅ សល់ ។
នាង បាន ជួប ព្រះអង្គ សង្គ្រោះ ។
ប៉ុន្តែ លោកយេស៊ូឆ្លើយ ថា៖ « ខ្ញុំមកហើយ ដើម្បីឲ្យអ្នក រាល់គ្នាមានជីវិត និងជីវិតពេញ លេញ » ។
បាទ ប៉ុន្តែ អ្នកមាន គុណ ច្រើន ។
លើកតម្កើងក្នុងគ្រួសាររបស់ពួកគេ ហើយដោយការ បន្ថែមទៀត គ្រួសាររបស់ព្រះ។
ជាង វា ជា ឧបករណ៍ ប្រហោង ។
គ្រួសារ នីមួយ ៗ រស់ នៅក្នុង ផ្នែក មួយ ។
នៅ ទីនេះ អ្នក អាច មើលឃើញ គេហទំព័រ សម្រាប់ ពិភពលោក ទាំងមូល ។
ខ្ញុំ នៅ ទីនេះ ដើម្បី ជួយ ដូច្នេះ តើ អ្នក ត្រូវការ អ្វី ?
អរគុណ អ្នកតស៊ូ ទាំង យប់ ទាំង ថ្ងៃ ។
សំឡេងបុរសម្នាក់បន្លឺឡើងពីម្ខាងទៀត ។
នៃ កូនប្រុស ទាំង ពីរ របស់ អ័ដាម ។
កិច្ចព្រមព្រៀង ដ៏ អស្ចារ្យ មួយ អាច ធ្វើ បាន ក្នុង រយៈពេល បី ខែ ហើយ ខ្ញុំ នឹង ផ្តល់ឱ្យ ទាំងអស់ ។
បន្ទាប់មកគាត់ កាន់តែ ស៊ាំនឹងវា ។
ហើយតើយើងអាចជួយគ្នាដោយរបៀប ណាមិត្ត ភក្តិរបស់ខ្ញុំ ?
ហើយដូចដែលខ្ញុំចង់ប្រាប់សិស្ស C ថា៖ អ្នកក៏អាចធ្វើជាប្រធានបានដែរ » ។
មីងរបស់ រ៉េតនឹងរៀបការ ជាមួយបុរសខ្លាំងក្នុងពេលឆាប់ ៗនេះ ។
នៅក្នុង ការ ដែល ពួកគេ បាន បង្ហាញ ខ្លួន ហើយ ថា ពួកគេ រត់ ទៅ កាន់តែ ធំ
មិនអាចចុះពីក្រោយ?
ឯងមានអារក្សមកហើយ តើអ្នក ណាចង់សម្លាប់ឯង ? »
រស់ នៅដូចជាអ្នក បម្រើទ្រង់ ។
ទូរទស្សន៍ សម្រាប់ លក់ ។
អ្នកមិនសមនឹងលើកឡើងថាបានឃើញ? មាន អ្វី មួយ ដែល .
គាត់បាន ប្រទះ ឃើញអណ្តាតភ្លើង និងផ្សែងហុយចេញពីផ្ទះ ។
ខ្ញុំ មិន អាច បន្ទោស មនុស្ស ឱ្យ ខកចិត្ត បាន ទេ ។
អ្នក ប្រាជ្ញខ្លាំងជាងអ្នកខ្លាំង ហើយអ្នកដែលមានចំណេះ កាន់ តែខ្លាំងឡើង ។
ខ្ញុំ បាន រក្សា វា ឱ្យ សាមញ្ញ ដូចជា ខ្ញុំ កំពុង និយាយ ជាមួយ កុមារ ។
វា មិន ច្បាស់ ទេ
ប៉ុន្តែ គាត់ នៅតែ ស្រឡាញ់ វា ។
ហេតុនេះហើយបានជាទ្រង់មាន បន្ទូលថា៖ « ប៉ុន្តែអ្នក ណាដែល ស៊ូ ទ្រាំនឹងព្រះ
ខ្ញុំស្មានថាគាត់ត្រូវបានគេ សង្គ្រោះដោយការ ពិតដែលគ្មាននរណាម្នាក់ដឹងថាគាត់ ជាអ្នក ណា។
គាត់ត្រូវថែទាំខ្លួនគាត់ដោយមានដូចជាគាត់មាន កំណើតបានធ្វើការ កាតព្វកិច្ចរបស់គាត់ដើម្បី
ដូច្នេះ ខ្ញុំចាប់ផ្ដើមនិយាយជាមួយព្រះ អំពីរឿងនោះ ។
តើ នឹង មាន អ្វី កើតឡើង ។ អ្នក នឹង មាន អារម្មណ៍ ក្លាហាន
ត្រូវបានលេបចូលដោយផែនដី ។
