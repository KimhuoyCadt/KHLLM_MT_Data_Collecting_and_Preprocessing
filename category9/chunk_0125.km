នៅ ទូទាំង ពិភពលោក កម្ពុជា ជាប់ ចំណាត់ ថ្នាក់ លេខ ៩០ ក្នុង ចំណោម ៩៧ ប្រទេស ក្នុង ទស្សនៈ នៃ ការ កម្រិត មាន ប្រសិទ្ធភាព លើ អំណាច រដ្ឋាភិបាល និង លេខ ៩៤ ក្នុង ទស្សនៈ នៃ ការ អនុវត្ត ច្បាប់ និង យុតិ្តធម៌ ស៊ីវិល ។
កម្ពុជា មាន ការ ខ្វះ ខាត ច្រើន បើ ធៀប នឹង ប្រទេស ដទៃ ទៀត ក្នុង តំបន់ និង នៅ លើ ពិភពលោក បើ គិត អំពី គណនេយ្យភាព នៃ រដ្ឋាភិបាល ។
ព្រះរាជាណាចក្រ កម្ពុជា បាន បង្ហាញ ចំណុច ខ្លាំង ក្នុង សូចនាករ មួយ ចំនួន ដូច ជា ទស្សនៈ អំពី សន្តិសុខ និង សិទិ្ធ ជា មូលដ្ឋាន ដោយ ទទួល បាន ពិន្ទុ ខ្ពស់ បំផុត ក្នុង ផ្នែក « អវត្ត មាន នៃ ឧក្រិដ្ឋកម្ម » និង ផ្នែក « ជម្លោះ ស៊ីវិល ត្រូវ បាន កម្រិត ប្រកប ដោយ ប្រសិទ្ធភាព » ។
ទោះ ជា យ៉ាង ណា ក្នុង សូចនាករ ៩ ដទៃ ទៀត នៃ ទស្សនៈ អំពី សន្តិសុខ និង សិទិ្ធ ជា មូលដ្ឋាន ប្រទេស កម្ពុជា ទទួល បាន ពិន្ទុ ទាប ក្នុង ការ សម្រេច បាន នូវ ផ្នែក « ប្រជាជន មិន ប្រើ អំពើ ហិង្សា ដើម្បី ដោះស្រាយ កំហឹង ផ្ទាល់ ខ្លួន » ។
ចំពោះ សូចនាករ ទាំង មូល ការ រក ឃើញ អំពី អំពើ ពុករលួយ បាន ធ្វើ ឲ្យ ពិន្ទុ របស់ កម្ពុជា ធ្លាក់ ចុះ ខ្លាំង បំផុត ។
ម្យ៉ាង ទៀត កម្ពុជា មាន អត្រា បទ ល្មើស ទាប ជាង ប្រទេស ភាគ ច្រើន ក្នុង ប្រភេទ ប្រទេស ចំណូល ទាប » ។
យោង តាម WJP ឲ្យ ដឹង ថា គោលការណ៍ ជា សកល ទាំង បួន សម្រាប់ នីតិរដ្ឋ គឺ រដ្ឋាភិបាល ត្រូវ មាន គណនេយ្យភាព សន្តិសុខ និង ត្រូវ គោរព សិទិ្ធ ជា មូលដ្ឋាន របស់ ប្រជា ពលរដ្ឋ រដ្ឋាភិបាល បើក ចំហ ការ អនុវត្ត ច្បាប់ និង ការ ផ្តល់ យុតិ្ត ធម៌ ៕
អាជ្ញាធរចុះជួបជន ជាតិភាគតិចចារ៉ាយរឿងឈូសដីព្រៃសហគមន៍
តំណាង ម្នាក់ របស់ សហគមន៍ លោក សេវ យួន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ឲ្យ ដឹង ថា ក្រុម ហ៊ុន ជា ច័ន្ទ រិទ្ធ បាន ឈូស ឆាយ ដី ព្រៃ ស្រោង ដែល អាជ្ញាធរ ព្រៃឈើ បាន កាត់ ឲ្យ សហគមន៍ តាំង ពី ឆ្នាំ ២០១០ ដើម្បី ការពារ និង ស្វែង រក អនុផល ពី ព្រៃឈើ ត្រង់ ចំណុច អូរ ចង្វា ភ្នំ ទ្រូ ភូមិ ឡែ ។
សហគមន៍ បាន ដាក់ ពាក្យ បណ្តឹង ទៅ រដ្ឋបាល ព្រៃឈើ អភិបាល ខេត្ត និង អាជ្ញាធរ ខេត្ត រតនគិរី កាល ពី ថ្ងៃ សុក្រ សប្តាហ៍ កន្លង ទៅ នេះ ថា ក្រុម ហ៊ុន បាន ឈូស ឆាយ ដី ព្រៃ ជាង ៣០ ហិកតា របស់ សហគមន៍ ចាប់ តាំង ពី ថ្ងៃ ទី ២០ វិច្ឆិកា មក ។
លោក សេវ យួន តំណាង សហគមន៍ ជន ជាតិ ភាគ តិច ចារ៉ាយ ក្នុង ភូមិ ឡែ ឃុំ លំជ័រ ស្រុក អូរ យ៉ា ដាវ ថ្លែង ថា ក្រោយ បណ្តឹង ពលរដ្ឋ សហគមន៍ ព្រៃឈើ ភូមិ ឡែ ដាក់ ជូន ដល់ ស្ថាប័ន ទាំង បី មក មន្ត្រី ពាក់ ព័ន្ធ រាប់ ទាំង អាជ្ញាធរ រដ្ឋបាល ព្រៃឈើ មក ពី រាជធានី ភ្នំពេញ ផង ដែរ បាន ចុះ មក ជួប ប្រជា ពលរដ្ឋ ស្រង់ យក ព័ត៌មាន ពី ការ ប្តឹង តវ៉ា នោះ ។
ក្រុមហ៊ុន ជា ច័ន្ទ រិទ្ធ អភិវឌ្ឍន៍ បាន អះអាង ថា ខ្លួន មាន សិទ្ធិ លើ ផ្ទៃដី ទំហំ ៦៥៩ ហិកតា សម្បទាន ដោយ រដ្ឋាភិបាល ដើម្បី ដាំ កៅស៊ូ នៅ ស្រុក បរកែវ និង ស្រុក អូរ យ៉ា ដាវ ហើយ មាន លិខិត អនុញ្ញាត ឲ្យ ឈូស ឆាយ កាល ពី ថ្ងៃ ទី២២ តុលា ២០១២ ចេញ ដោយ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ។
លោក ចាន់ ម៉ាប់ តំណាង ក្រុមហ៊ុន ជា ច័ន្ទ រិទ្ធ អភិវឌ្ឍន៍ ថ្លែង ថា លោក បាន គោរព តាម ការ ណែ នាំ ពី អាជ្ញាធរ ស្រុក ឲ្យ ផ្អាក ការ ឈូស ឆាយ ប៉ុន្តែ លោក អះអាង ថា ក្រុមហ៊ុន របស់ លោក ធ្វើ ការ ឈូស ឆាយ តែ លើ ព្រៃ រេចរឹល ទៅ តាម ផែនទី ដែល ក្រុមហ៊ុន មាន ប៉ុណ្ណោះ មិន មែន ដី ព្រៃ ស្រោង ឡើយ ៕
ឧប្បត្តិហេតុនៅអាតៃ របួស ៥ និងបាត់ខ្លួន ៤នាក់
លោក ឲ្យ ដឹង ទៀត ថា អ្នក ដែល រង របួស ត្រូវ បាន បញ្ជូន ជា បន្ទាន់ ទៅ មន្ទីរពេទ្យ នៅ ភ្នំពេញ ហើយ មន្ត្រី ជំនាញ កំពុង តែ សិក្សា អំពី ផល ប៉ះពាល់ និង ការ ខូច ខាត ។
រីឯ សោហ៊ុយ នៃ ការ ព្យាបាល គឺ ខាង ក្រុមហ៊ុន ជា អ្នក ទទួល ខុស ត្រូវ ទាំង អស់ ។
ឧប្បត្តិ ហេតុ នៅ ទំនប់ វារី អគ្គិសនី ស្ទឹង អាតៃ មិន មែន ជា លើក ទី មួយ ទេ ក្នុង ឆ្នាំ នេះ ។
លោក បន្ត ទៀត ថា បញ្ហា សុខភាព វិជ្ជាជីវៈ និង សុវត្ថិភាព ក្នុង ប្រទេស កម្ពុជា គឺ ពិត ណាស់ មិន ទាន់ ស្រប ទៅ តាម ស្តង់ដារ អន្តរជាតិ នៅ ឡើយ ទេ ហើយ ត្រូវ ការ ឲ្យ មាន បទប្បញ្ញត្តិ បន្ថែម ទៀត ជា ពិសេស នៅ ក្នុង វិស័យ សំណង់ ។
គម្រោង ទំនប់ វារី អគ្គិសនី ស្ទឹង អាតៃ ត្រូវ បាន គេ រិះគន់ ថា ខ្វះ ការ ត្រួត ពិនិត្យ ដោយ រដ្ឋាភិបាល ពាក់ព័ន្ធ នឹង បញ្ហា សុវត្ថិភាព ។
វារី អគ្គិសនី ស្ទឹង អាតៃ របស់ ក្រុមហ៊ុន ចិន ខេមបូឌា ហាយ ដ្រូផៅ វើរ ឌីវេឡុប មែន ត្រូវ បាន សម្ពោធ ឲ្យ ដំណើរ ការ សាង សង់ នៅ ថ្ងៃ ទី ៨ ឧសភា ឆ្នាំ ២០០៨ ។
ថាមពល អគ្គិសនី បាន ពី ទំនប់ អាតៃ នឹង ចែកចាយ ប្រើប្រាស់ នៅ ខេត្ត ពោធិ៍សាត់ ហើយ សល់ ពី នេះ នឹង បញ្ជូន បន្ត ទៅ ទីក្រុង ភ្នំពេញ និង ខេត្ត បាត់ដំបង ។
តំណាង ក្រុមហ៊ុន ខេមបូឌា ហាយ ដ្រូផៅ វឺ ឌីវេឡុប មែន ពុំ អាច ទាក់ ទង បាន ទេ ពី ម្សិលមិញ ៕
គម្រោង វារី អគ្គិសនី ស្ទឹង អាតៃ មាន កម្លាំង ១២០ មេហ្កាវ៉ាត់ ដែល កំពុង សាងសង់ ស្ថិត នៅ កណ្ដាល ទ្រូង ព្រៃ នៃ ជួរ ភ្នំ ក្រវ៉ាញ នា មាត់ ស្ទឹង អាតៃ តំបន់ ត្រី កោណ រវាង ខេត្ត ពោធិសាត់ កោះ កុង និង កំពង់ស្ពឺ នឹង គ្រោង ដាក់ ឲ្យ ដំណើរ ការ នៅ ឆ្នាំ ២០១៣ ខាង មុខ ។
បន្ទាប់ ពី សាង សង់ រួច វារី អគ្គិសនី អាតៃ នឹង បញ្ជូន ភ្លើង ទៅ ចែកចាយ ប្រើ ប្រាស់ នៅ ខេត្ត ពោធិសាត់ ដែល មាន ចម្ងាយ ១៧៥ គីឡូម៉ែត្រ ពី ទីតាំង វារី អគ្គិសនី ហើយ សល់ ពី នេះ នឹង បញ្ជូន បន្ត ទៅ ទីក្រុង ភ្នំពេញ និង ខេត្ត បាត់ដំបង ។
តំណាង ក្រុម ហ៊ុន ខេមបូឌា ហាយ ដ្រូផៅ វឺឌីវេឡុប មែន ពុំ អាច ទំនាក់ ទំនង ដើម្បី ធ្វើ ការ អត្ថា ធិប្បាយ បាន ទេ កាល ពី ថ្ងៃ ម្សិល មិញ ។
សហគមន៍ខ្មែរអ៊ិស្លាមនៅក្នុងស្រុកបរិបូណ៌ មានជម្លោះគ្នា
កំពង់ឆ្នាំងៈ ជម្លោះ វាយ តប់ គ្នា ពេល ស្រវឹង បាន កើត ឡើង នៅ ក្នុង សហគមន៍ មូស្លីម ខេត្ត កំពង់ឆ្នាំង កាល ពី សប្ដាហ៍ មុន ពេល ដែល មេ ដឹក នាំ សហគមន៍ នេះ និង គ្រួសារ ត្រូវ យុវជន មួយ ក្រុម ព្រួត គ្នា វាយ រហូត មាន របួស នាំ ទៅ ពេទ្យ ។
ក្នុង អំឡុង វាយ ប្រហារ នេះ កូន ស្រី ប្រធាន សហគមន៍ ខ្មែរ អ៊ិស្លាម ដែល មាន ផ្ទៃ ពោះ ជិត គ្រប់ ខែ អាយុ ២១ ឆ្នាំ បាន រង របួស ។
មន្ត្រី នគរបាល ស្រុក បរិបូណ៌ នៅ មិន ទាន់ ចាប់ ឬ ឃាត់ ខ្លួន ជន ណា ម្នាក់ ដែល ជាប់ សង្ស័យ ក្នុង អំពើ ហិង្សា នេះ នៅ ឡើយ ទេ ។
លោក នួន សុវណ្ណ រិទ្ធិ អធិការ នគរបាល ស្រុក បរិបូណ៌ បាន ប្រាប់ ពី ថ្ងៃ ម្សិលមិញ ថា លោក មិន ទាន់ បាន ឃាត់ ខ្លួន អ្នក ណា ម្នាក់ ដែល បង្ក អំពើ ហិង្សា លើ ក្រុម គ្រួសារ និង ប៉ះពាល់ ដល់ ស្ត្រី មាន គភ៌ ម្នាក់ នេះ នៅ ឡើយ ទេ ព្រោះ គ្មាន សាក្សី បាន ឃើញ ផ្ទាល់ ភ្នែក ។
មន្ត្រី នគរបាល ឃុំ ឆ្នុក ទ្រូ ម្នាក់ សុំ មិន បញ្ចេញ ឈ្មោះ បាន ឲ្យ ដឹង ថា ក្រុម ប្រមឹក បាន ប្រើ ពាក្យ អសីលធម៌ ដាក់ ប្រធាន សហគមន៍ ខ្មែរ អ៊ិស្លាម ដែល រស់ នៅ ក្នុង ឃុំ នេះ ។
មន្ត្រី នគរបាល ប៉ុស្តិ៍ ឃុំ រូប នេះ បាន បញ្ជាក់ ថា៖
លោក ម៉ាត់ លី ប្រធាន សហគមន៍ ខ្មែរ អ៊ិស្លាម នៅ ក្នុង ភូមិ ឆ្នុក ទ្រូ មិន អាច ទាក់ ទង សុំ ការ អធិប្បាយ បាន ទេ ពី ថ្ងៃ ម្សិល មិញ ៕
ក្រុម ជន សង្ស័យលួចទំនិញ ក្នុងកុងតឺន័រ ៤ នាក់ត្រូវចាប់ឃាត់ខ្លួន
លោក ទៀង ច័ន្ទ សារ អធិការ នគរបាល ខណ្ឌ ឫស្សីកែវ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃ ម្សិលមិញ ថា កម្លាំង នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ រួម ទាំង លោក ឌី សុផាន់ ណា ព្រះរាជ អាជ្ញា រង អម សាលា ដំបូង ភ្នំពេញ បាន ចុះ ចាប់ ជន សង្ស័យ ជា ចោរ លួច សម្លៀក បំពាក់ របស់ រោងចក្រ ៤នាក់ និង រឹប អូប បាន វត្ថុតាង ជា សម្លៀក បំពាក់ ចំនួន ៩២១ កេស ។
លោក ហម គន្ធី នាយ កា រិយាល័យ ស៊ើបការណ៍ នៃ នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ និង លោក ឌី សុផាន់ ណា ព្រះរាជអាជ្ញា រង អម សាលា ដំបូង ភ្នំពេញ មិន អាច សុំ ការ ពន្យល់ បាន ទេ នៅ ថ្ងៃ ម្សិលមិញ ពី ប្រតិបត្តិការ នេះ ។
តាម មន្ត្រី នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ ម្នាក់ មិន បញ្ចេញ ឈ្មោះ បាន ប្រាប់ ថា រថយន្ត កុងតឺន័រ មួយ ដែល ត្រូវ ដឹក សម្លៀក បំពាក់ ចេញ ពី រោងចក្រ មួយ នៅ ភូមិ ព្រៃ ទា សង្កាត់ ចោម ចៅ ខណ្ឌ ពោធិ៍ សែន ជ័យ យក ទៅ ដាក់ នៅ កំពង់ផែ ស្វយ័ត ភ្នំពេញ តែ ត្រូវ បាន អ្នក បើកបរ រថយន្ត កុងតឺន័រ ឃុបឃិត គ្នា ជាមួយ បុគ្គលិក រោងចក្រ និង បុគ្គលិក ក្រុមហ៊ុន ដឹក ជញ្ជូន ដឹក សម្លៀក បំពាក់ ទាំង នោះ យក ទៅ ទម្លាក់ ទុក នៅ ក្នុង ដីឡូត៍ មួយ កន្លែង ទាំង យប់ នៅ ជាប់ មាត់ ទន្លេ ក្នុង សង្កាត់ គីឡូម៉ែត្រ លេខ ៦ ខណ្ឌ ឫស្សីកែវ ។
ប៉ុន្តែ ទោះ យ៉ាង ណា ប្រភព បាន បញ្ជាក់ ថា៖
រដ្ឋាភិបាលកាត់ ដី ៤១៥៨ ហិកតាពីក្រុមហ៊ុន ភា ពីម៉ិចជូនប្រជាជន
នៅ ក្នុង អនុក្រឹត្យ បាន បង្ហាញ ថា ស្រុក ចំនួន ពីរ នៅ ក្នុង ខេត្ត កំពង់ឆ្នាំង ដូច ជា ស្រុក ទឹក ផុស និង ស្រុក សាមគ្គី មានជ័យ ដែល មាន ឃុំ ចំនួន បី ដូច ជា ឃុំ ក្បាល ទឹក ឃុំ ក្រាំងល្វា និង ឃុំ ត្បែង ខ្ពស់ នឹង ត្រូវ ទទួល បាន ដី ពី អនុក្រឹត្យ នោះ ។
នៅ ក្នុង មាត្រា ទី ២ នៃ អនុក្រឹត្យ បាន ឲ្យ ដឹង ថា ត្រូវ បាន ប្រគល់ អាណត្តិ កាន់ កាប់ និង បែង ចែក ដី របស់ រដ្ឋ ដូច មាន ចែង ក្នុង មាត្រា ១ ជូន គណៈ កម្មាធិការ គ្រប់គ្រង ដី រដ្ឋ ខេត្ត កំពង់ឆ្នាំង គ្រប់គ្រង និង ប្រទាន កម្ម ជា កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ៤ ៥០៦ គ្រួសារ ដែល ស្ថិត នៅ ក្នុង ស្រុក ទាំង ពីរ ខាង លើ ។
នៅ ក្នុង មាត្រា ទី៤ នៃ អនុក្រឹក្យ បាន កំណត់ ថា ក្នុង ពេល ដំណើរ ការ វាស់ វែង និង បែង ចែក ជាក់ ស្តែង គណៈ កម្មាធិការ គ្រប់គ្រង ដី រដ្ឋ ខេត្ត កំពង់ឆ្នាំង ត្រូវ កាត់ ចេញ នូវ ចំណែក ដី មួយ ចំនួន សម ស្រប ដើម្បី រក្សា ទុក សម្រាប់ បម្រើ ផល ប្រយោជន៍ សាធារណៈ ទាំង សម្រាប់ ការ អភិវឌ្ឍ ហេដ្ឋា រចនា សម័្ពន្ធ រូប វន្ត និង សង្គម នៅ ក្នុង មូល ដ្ឋាន ។
អនុក្រឹត្យ បាន បង្ហាញ ថា ៖
បន្ទាប់ ពី រដ្ឋាភិបាល ផ្តល់ ដី សម្បទាន សេដ្ឋកិច្ច ឲ្យ ក្រុមហ៊ុន ភាពី ម៉ិច គ្រុប ចំនួន ៣១៥០២៨ ហិក តា ដែល ស្ថិត ក្នុង ខេត្ត ពោធិ៍សាត់ និង ខេត្ត កំពង់ឆ្នាំង សម្រាប់ អភិវឌ្ឍ លើ ការ ដាំ ដើម អាកាស្យា ដំឡូង មី និង អភិវឌ្ឍ ដំណាំ ក សិ- ឧស្សាហ៍កម្ម បាន ធ្វើ ឲ្យ ប៉ះពាល់ ដល់ ពលរដ្ឋ ចំនួន ៨ ២០០ គ្រួសារ នៅ ក្នុង ខេត្ត ទាំង ពីរ គឺ ខេត្ត កំពង់ឆ្នាំង និង ពោធិ៍សាត់ ។
រីឯ ខេត្ត ពោធិ៍សាត់ ធ្វើ ឲ្យ ប៉ះពាល់ ដី ពលរដ្ឋ ចំនួន បី ស្រុក គឺ ស្រុក ក្រគរ ស្រុក ភ្នំ ក្រវាញ និង ក្រុង ពោធិ៍សាត់ នៅ ក្នុង ឃុំ ចំនួន ១៣ នៃ ៥៩ ភូមិ ដែល មាន ផ្ទៃដី ចំនួន ១៣ ១១៦ ហិកតា ។
ទាក់់ ទិន ទៅ នឹង ជម្លោះ ដីធ្លី នេះ មាន ប្រជា ពលរដ្ឋ ចំនួន ១៨ នាក់ រួច ហើយ ដែល បាន ទទួល ដីកា ពី តុលាការ ចាប់ តាំង ពី ខែ វិច្ឆិកា ឆ្នាំ ២០១០ រហូត ដល់ ខែ មក រា ឆ្នាំ ២០១១ ទាក់ទង នឹង បណ្តឹង របស់ ក្រុមហ៊ុន ចោទ ប្រកាន់ ថា បាន ញុះញង់ បំផ្លិច បំផ្លាញ ទ្រព្យ សម្បត្តិ អ្នក ដទៃ និង រារាំង សមត្ថកិច្ច មិន ឲ្យ អភិវឌ្ឍ ។
លោក ជា សុផុន តំណាង ពលរដ្ឋ នៅ ក្នុង ឃុំ ក្រាំង ល្វា ស្រុក ទឹក ផុស បាន ប្រាប់ ឲ្យ ដឹង ថា សព្វ ថ្ងៃ នេះ ក្រុម យុវជន ស្ម័គ្រចិត្ត បាន ចាប់ ផ្តើម វាស់ វែង កាត់ ដី ពី ក្រុមហ៊ុន មក ឲ្យ ពលរដ្ឋ វិញ ហើយ ។
នេះ គឺជា ជោគជ័យ របស់ ពលរដ្ឋ ដែល រួម គ្នា ធ្វើ ការ តវ៉ា ស្ទើរ គ្រប់ ទីកន្លែង ដើម្បី ទាម ទារ ឲ្យ បាន ដី មក វិញ ។
ប៉ុន្តែ បើ ដូច បច្ចុប្បន្ន នេះ ខ្ញុំ សប្បាយ ចិត្ត បំផុត ហើយក៏ អរគុណ សម្តេច បំផុត ដែរ ដែល បាន គិត គូរ ដល់ ទុក្ខ លំបាក របស់ ពួក យើង » ។
នៅ ថ្ងៃ ទី ១៤ មិថុនា លោក នាយក រដ្ឋ មន្ត្រី ក៏ ថ្លែង ជា សាធារណៈ បញ្ជា ឲ្យ អាជ្ញាធរ ទូទាំង ប្រទេស ធ្វើ ការ វាស់ វែង បែង ចែក ដី ធ្លី ឲ្យ ប្រជា ពលរដ្ឋ ដែល មាន ទំនាស់ ដី ធ្លី ជា មួយ ក្រុមហ៊ុន ព្រៃ សម្បទាន ដី សម្បទាន សេដ្ឋកិច្ច យ៉ាង យូរ បំផុត ត្រឹម ៦ខែ ។
នៅ ថ្ងៃ ទី ២៨ ខែ មិថុនា ក្រុម យុវជន ស្ម័គ្រចិត្ត របស់ លោក នាយក រដ្ឋ មន្ត្រី ចំនួន ១ ១៧៨ នាក់ បាន ចេញ ដំណើរ ទៅ កាន់ ខេត្ត ចំនួន ១៣ នៅ ក្នុង ប្រទេស កម្ពុជា ដើម្បី ធ្វើ យុទ្ធនាការ វាស់វែង ដី ចែក ជូន ប្រជា ពលរដ្ឋ នៅ លើ ផ្ទៃ ដី ដែល ត្រូវ វាស់ វែង ចំនួន ១២ សែន ហិកតា នៅ ទូទាំង ប្រទេស ប្រគល់ ជូន ពលរដ្ឋ ចំនួន ៣៥ ម៉ឺន គ្រួសារ ។
លោក ចាន់ សុវ៉េត មន្ត្រី ស៊ើប អង្កេត ជាន់ ខ្ពស់ សមាគម សិទ្ធិ មនុស្ស អាដហុក បាន ថ្លែង ឲ្យ ដឹង ថា លោក ស្វាគមន៍ ចំពោះ ឆន្ទៈ របស់ រដ្ឋាភិបាល ដែល ស្វែង រក ដំណោះ ស្រាយ ដើម្បី បញ្ចប់ ជម្លោះ ដី ធ្លី ជូន ប្រជាពលរដ្ឋ ។
លោក ថា នេះ គឺជា សកម្មភាព ល្អ មួយ តែ ក្នុង នាម សង្គម ស៊ីវិល លោក ទទូច សុំ ឲ្យ ធ្វើ ដូច្នេះ នៅ ទូទាំង ប្រទេស ពីព្រោះ ជម្លោះ ដីធ្លី រវាង ប្រជាជន ជា មួយ ក្រុម ហ៊ុន ដី សម្បទាន គឺ បាន កើត ឡើង ពេញ ក្នុង ប្រទេស ។
កន្លង មក ដោយ សារ តែ ជម្លោះ ដីធ្លី នេះ បាន ធ្វើ ឲ្យ ពលរដ្ឋ ជា ច្រើន ទទួល ដីកា ពី តុលាការ ខូចខាត ផ្ទះ សម្បែង និង ទ្រព្យ សម្បត្តិ របស់ ខ្លួន » ។
លោក ទី គឹម តុក តំណាង ឲ្យ ក្រុមហ៊ុន ភាពី ម៉ិច គ្រុប មិន អាច ទំនាក់ ទំនង សុំ ការ អត្ថាធិប្បាយ បាន ទេ កាល ពី ថ្ងៃ ម្សិលមិញ ៕
ដំណើរប្រកាសទ្រព្យ សម្បត្តិលើកទី ២ នឹងធ្វើនៅខែ មករា
ភ្នំពេញៈ វា ជា លើក ទី២ នៅ ក្នុង ប្រវតិ្តសាស្រ្ត ប្រទេស កម្ពុជា ដែល តំណាង រាស្រ្ត មន្រ្តី រាជការ ត្រូវ ប្រកាស ទ្រព្យ សម្បតិ្ត របស់ ខ្លួន ដាក់ ជូន អង្គភាព ប្រឆាំង អំពើ ពុករលួយ បើ ទោះ ជា មាន ការ រិះគន់ ពី ក្រុម មន្ត្រី សង្គម ស៊ីវិល ថា ដំណើរ ការ ប្រកាស ទ្រព្យ សម្បតិ្ត ជា សម្ងាត់ នេះ គឺ ដូច គ្នា នឹង ការ មិន ប្រកាស នោះ ក៏ ដោយ ។
ចាប់ ពី ថ្ងៃ ទី១ ដល់ ថ្ងៃ ទី៣១ ខែ មករា ខាង មុខ នេះ តំណាង រាស្រ្ត មន្រ្តី ឃុំ សង្កាត់ មន្រ្តី រាជការ និង មន្រ្តី អង្គភាព ប្រឆាំង អំពើ ពុករលួយ នឹង ដាក់ លិខិត ប្រកាស ទ្រព្យ សម្បតិ្ត របស់ ខ្លួន ក្នុង ស្រោម សំបុត្រ បិទ ជិត ដែល អាច បើក បាន តែ ប្រធាន អង្គភាព ប្រឆាំង អំពើ ពុករលួយ ម្នាក់ និង បាន តែ ក្នុង ករណី ស៊ើប អង្កេត ប៉ុណ្ណោះ ។
នេះ បើ យោង តាម លោក ស សម្បតិ្ត មន្រ្តី អង្គភាព ប្រឆាំង អំពើ ពុករលួយ ឲ្យ ដឹង កាល ពី ម្សិល។
បើ ទោះ ជា កិច្ច ដំណើរ ការ ប្រកាស ទ្រព្យ សម្បតិ្ត នេះ មាន គោល បំណង ជួយ រាជ រដ្ឋាភិបាល ក្នុង ការ អង្កេត និង ស៊ើប រក ឲ្យ ឃើញ នូវ ទ្រព្យ សម្បតិ្ត ដែល ទទួល បាន ពី មធ្យោបាយ មិន ត្រឹម ត្រូវ ក៏ ដោយ ប៉ុន្តែ ក្រុម មន្ត្រី សិទិ្ធ មនុស្ស និង អ្នក សង្កេត ការណ៍ នានា បាន ថ្លែង ថា ចន្លោះ ប្រហោង ក្នុង ច្បាប់ បាន ទុក ឱកាស គ្រប់គ្រាន់ ក្នុង ការ ប្រព្រឹត្ត អំពើ ពុករលួយ ដោយ ពុំ មាន បារម្ភ ពី អ្នក ណា ដឹង ។
លោក សុន ឆ័យ តំណាង រាស្រ្ត គណបក្ស សម រង្ស៊ី បាន ថ្លែង ថា៖
លោក សុន ឆ័យ បន្ត ថា ទម្រង់ នៃ ពាក្យ ប្រកាស ទ្រព្យ សម្បតិ្ត ស្នើ អ្នក ប្រកាស ឲ្យ សរ សេរ តែ ទ្រព្យ សម្បតិ្ត រូប វន្ត ប៉ុណ្ណោះ មិន មែន សាច់ ប្រាក់ ទេ ហើយ ពុំ តម្រូវ ឲ្យ ប្រកាស ទ្រព្យសម្បតិ្ត របស់ សមាជិក គ្រួសារ ឡើយ ដូច លោក បាន លើក ជា ញឹកញាប់ ថា គឺជា អ្នក រក្សា ទុក ប្រាក់ របស់ មន្រ្តី រាជ ការ ក្រោម ឈ្មោះ របស់ ខ្លួន ។
ទោះ ជា យ៉ាង ណា លោក បាន បន្ថែម ថា ការ ពិត ទ្រព្យ សម្បតិ្ត ត្រូវ បាន រក្សា ជា ការ សម្ងាត់ ប៉ះពាល់ យ៉ាង ខ្លាំង ដល់ កិច្ច ប្រឹង ប្រែង ត្រួត ពិនិត្យ ពួក គេ ដើម្បី រក ភាព មិន ប្រក្រតី ។
លោក សុន ឆ័យ បាន អះអាង ថា លោក សុខ ស្រួល ក្នុង ចិត្ត ពេល ប្រកាស ទ្រព្យ សម្បតិ្ត របស់ លោក ជា សាធារណៈ ដោយ បញ្ជាក់ ថា ៖
លោក ព្រាប កុល នាយក ប្រតិបតិ្ត នៃ អង្គការ តម្លាភាព អន្តរជាតិ កម្ពុជា បាន ចង្អុល បង្ហាញ ថា ការ សម្ងាត់ នៃ ការ ប្រកាស ទ្រព្យ សម្បតិ្ត បាន បើក ទ្វារ សម្រាប់ បញ្ហា ជាច្រើន ។
លោក ព្រាប កុល លើក ឡើង ថា ការ សម្ងាត់ នៃ អង្គភាព ប្រឆាំង អំពើ ពុករលួយ ក៏ មាន ប៉ះពាល់ បន្ទាប់ បន្សំ ផង ដែរ ក្នុង ការ ប្រែ ក្លាយ ជា ការ ការពារ ប្រឆាំង ទៅ នឹង ការ ចោទ ប្រកាន់ ។
ប៉ុន្តែ អ្នក ខ្លះ អាច នឹង ប្រឌិត ចំនួន ប្រាក់ ដូច្នេះ នោះ ជា ចំណុច ខ្សោយ នៃ ច្បាប់ » ។
ក្នុង សន្ទស្សន៍ ស្តីពី អំពើ ពុករលួយ ឆ្នាំ ២០១១ របស់ អង្គ ការ តម្លាភាព អន្តរ ជាតិ មាន តែ ១៨ ប្រទេស ប៉ុណ្ណោះ ដែល ត្រូវ ចាត់ ជា ប្រទេស ដែល ពុករលួយ ជាង ប្រទេស កម្ពុជា នៅ ក្នុង ចំណោម ១៨៣ ប្រទេស ។
នៅ ឆ្នាំ ដដែល នោះ អង្គភាព ប្រឆាំង អំពើ ពុករលួយ បាន ចាប់ ផ្តើម ការ ប្រកាស ទ្រព្យ សម្បតិ្ត ជា លើក ទី ១ បែប ជា សម្ងាត់ នេះ ដែល ជា កិច្ច ដំណើរ ការ ដែល រង ការ រិះគន់ យ៉ាង ខ្លាំង ពេល នោះ ។
ប៉ុន្តែ ទោះ ជា បែប នេះ ក្តី ក៏ មាន ឧកញ៉ា ១០ រូប បាន លា លែង ពី តំណែង ទីប្រឹក្សា រដ្ឋាភិបាល ជា ជាង ដាក់ សេចក្តី ប្រកាស ទៅ អង្គភាព ប្រឆាំង អំពើ ពុករលួយ ។
លោក សៀង បូរ៉ាត់ មន្រ្តី អង្គភាព ប្រឆាំង អំពើ ពុករលួយ បាន កត់ សម្គាល់ គ្រា នោះ ថា ការ លា លែង មិន មែន ជា ការ ទទួល ស្គាល់ ពិរុទ្ធភាព ឡើយ ប៉ុន្តែ អាច ដោយ សារ តែ ការ បារម្ភ ថា ទ្រព្យ សម្បត្តិ អាច មិន ត្រូវ បាន ប្រកាស ដោយ ចៃដន្យ ។
តែ យោង តាម ច្បាប់ អ្នក ដែល ខក មិន បាន ប្រកាស ទ្រព្យ សម្បតិ្ត ត្រូវ ពិន័យ រហូត ដល់ ៥០០ ដុល្លារ អាមេរិក និង ជាប់ ពន្ធនាគារ រហូត ដល់ ១ឆ្នាំ ។
លោក ព្រាប កុល លើក ឡើង ថា៖
បញ្ហា នេះ លោក សុន ឆ័យ អះអាង ថា ការ មិន គោរព ភាគ ច្រើន គឺ ក្នុង ចំណោម មន្ត្រី គណបក្ស កាន់ អំណាច ។
ប៉ុន្តែ លោក ផៃ ស៊ីផាន អ្នក នាំ ពាក្យ ទីស្ដីការ គណៈ រដ្ឋ មន្រី្ត ថ្លែង ថា ប្រកាស ទាំង អស់ ត្រូវ បាន ដាក់ ទៅ អង្គ ភាព ប្រឆាំង អំពើ ពុករលួយ ដោយ គ្មាន លើក លែង ឡើយ ។
ទោះ ជា យ៉ាង ណា អ្នក ស្រី ពុង ឈីវ កេក ប្រធាន អង្គការ លីកាដូ បាន ថ្លែង ថា ការ សម្ងាត់ និង ការ គោរព តាម នោះ វា ជា បញ្ហា បន្ទាប់ បន្សំ តែ ប៉ុណ្ណោះ បញ្ហា សំខាន់ គឺ នៅ ត្រង់ សេរីភាព របស់ អង្គភាព ប្រឆាំង អំពើ ពុករលួយ រង ឥទ្ធិពល ពី ខាង ក្រៅ ។
លោក ស្រី លើក ឧទាហរណ៍ ថា ការ ប្រយុទ្ធ ប្រឆាំង អំពើ ពុករលួយ មិន គួរ ប្រើ ដើម្បី ធ្វើ ឲ្យ ក្រុម ប្រឆាំង ឬ ជំទាស់ ចុះ ខ្សោយ ឡើយ ប៉ុន្តែ គឺ ប្រើ ដើម្បី ប្រយុទ្ធ ប្រឆាំង នឹង អំពើ ពុករលួយ ប៉ុណ្ណោះ ៕
ការ បត់ជើងតូចនៅតាម ទី សាធារណៈគួរតែបញ្ឈប់
នឹកឃើញ ពេល ខ្ញុំ សិក្សា នៅ មហាវិទ្យាល័យ ពេល ដែល មិត្តភក្តិ របស់ ខ្ញុំ និង ខ្ញុំ ចេញ ក្រៅ ផឹក ស្រា ហើយ ត្រូវ រក កន្លែង បត់ ដៃ បត់ ជើង ។
អ្នក រត់ ម៉ូតូ ឌុប និង ម៉ូតូ កង់ បី បាន ថ្លែង ថា ពួក គេ មិន ត្រូវ បាន អនុញ្ញាត ឲ្យ ចូល ក្នុង ភោជនីយដ្ឋាន ដើម្បី ប្រើប្រាស់ បន្ទប់ ទឹក ឡើយ ដូច្នេះ គ្មាន ជម្រើស ផ្សេង ក្រៅ ពី បត់ ជើង តូច នៅ ទី សាធារណៈ ឡើយ ។
ស្រ្តី ម្នាក់ អះអាង ថា ការ បត់ ជើង តូច នៅ ទី សាធារណៈ មិន មែន ជា ការ ល្អ ឡើយ ព្រោះ ក្លិន ឆ្អេះ ប៉ះពាល់ ដល់ បរិស្ថាន ខាង ក្រៅ ដែល ប្រជាជន លំហែ កាយ ដូចជា សួន ច្បារ ។
ទឹក នោម ធ្វើ ឲ្យ ប្រឡាក់ ជញ្ជាំង ព្រោះ វា ជា ទឹក យ៉ូរិក អាស៊ីត ហើយ ជា បញ្ហា សុខភាព សាធារណៈ ។
ចាប់ តាំង ពី ឆ្នាំ ២០០១ ទិវា បង្គន់ ពិភពលោក បាន ក្លាយ ជា យុទ្ធនាការ សំខាន់ មួយ ដែល ទាមទារ សកម្មភាព ពី រដ្ឋាភិបាល ព្រោះ បង្គន់ សំខាន់ សម្រាប់ ជីវិត រស់ នៅ និង តម្រូវ ការ ជា មូលដ្ឋាន របស់ មនុស្ស ។
រៀប ចំ ឡើង ដោយ ក្រុម ប្រឹក្សា សហប្រតិបតិ្តការ អនាម័យ និង ផ្គត់ ផ្គង់ ទឹក និង អង្គការ បង្គន់ ពិភពលោក « ខ្ញុំ បត់ ជើង ធំ ចុះ អ្នក វិញ ?
ប្រារព្ធ ធ្វើ ឡើង ជា រៀង រាល់ ឆ្នាំ នៅ ថ្ងៃ ទី១៩ ខែ វិច្ឆិកា ទិវា បង្គន់ ពិភពលោក លើក កម្ពស់ ការ យល់ ដឹង អំពី បញ្ហា អនាម័យ នៅ លើ សកលលោក ។
ប្រជាជន ប្រហែល ២,៥ ពាន់ លាន នាក់ ជួប ប្រទះ បញ្ហា គ្មាន បង្គន់ ស្អាត រៀង រាល់ ថ្ងៃ ឬ បញ្ហា គ្មាន លទ្ធភាព ប្រើ ប្រាស់ បង្គន់ ។
កម្មវិធី នេះ ត្រូវ បាន ទទួល ស្គាល់ ជា អន្តរជាតិ ហើយ នា ពេល ថ្មី ៗ នេះ ត្រូវ បាន ដាក់ បញ្ចូល ក្នុង សាល កិតិ្តយ ស របស់ អង្គការ បង្គន់ ពិភពលោក ។
ការ បំបាត់ ការ ហាម ឃាត់ ជុំវិញ បង្គន់ មាន សារៈ សំខាន់ ហើយ រដ្ឋាភិបាល វិស័យ ឯកជន អង្គ ការ ក្រៅ រដ្ឋាភិបាល និង ប្រព័ន្ធ ផ្សព្វផ្សាយ ត្រូវ ធ្វើ ការ រួម គ្នា ដើម្បី ដោះស្រាយ បញ្ហា សកល លោក មួយ នេះ ឲ្យ បាន ល្អ ប្រសើរ ពីព្រោះ អនាម័យ គឺជា សេចក្តី ថ្លៃថ្នូរ របស់ មនុស្ស និង ក៏ ជា សិទិ្ធ ជា មូល ដ្ឋាន របស់ មនុស្ស ផង ដែរ ៕
សម រង្ស៊ី៖ បក្ស កាន់អំណាចមិនហ៊ានប្រកួតនិង ដៃគូខ្លាំង
នៅក្នុង សេចក្ដី ថ្លែង ការណ៍ មួយ របស់ ខុទ្ទកាល័យ គណបក្ស សង្គ្រោះ ជាតិ ចេញ កាល ពី ម្សិល មិញ លោក សម រង្ស៊ី បាន សរសេរ ថា ប្រព័ន្ធ វិនិច្ឆ័យ យុត្តិធម៌ នៅ កម្ពុជា គឺ អយុត្តិធម៌ ដោយ គណៈ កម្មាធិ ការ ជាតិ រៀប ចំ ការ បោះ ឆ្នោត ( គ.ជ. ប ) និង ក្រុម ប្រឹក្សា ធម្មនុញ្ញ បាន សម្រេច លុប ឈ្មោះ លោក សម រង្ស៊ី ចេញ ពី បញ្ជី ឈ្មោះ អ្នក បោះ ឆ្នោត ដោយ យក លេស ថា ជា ទណ្ឌិត ។
សេច ក្ដី ថ្លែង ការណ៍ ក៏ បាន ចង្អុល បង្ហាញ ថា៖
លោក ទិត្យ សុធា អ្នក នាំ ពាក្យ អង្គភាព ព័ត៌មាន និង ប្រតិកម្ម រហ័ស នៃ ទីស្តី ការ គណៈ រដ្ឋ មន្ត្រី មាន ប្រសាសន៍ ថា លោក សម រង្ស៊ី ពុំ មាន ឥទ្ធិពល នយោបាយ មក ធ្វើ ជា ដៃគូ ប្រកួត ប្រជែង ជា មួយ នឹង រដ្ឋាភិបាល នោះ ទេ ពី ព្រោះ សារ នយោបាយ របស់ គាត់ តែង តែ បញ្ចេញ ជា បន្ត បន្ទាប់ គឺ ខុស ឆ្គង ដដែល ៗ ។
លោក សម រង្ស៊ី ត្រូវ បាន តុលាការ កម្ពុជា ផ្តន្ទា ទោស កំបាំង មុខ ឲ្យ ជាប់ ពន្ធនាគារ ចំនួន ១២ ឆ្នាំ ពី បទ ដក តម្រុយ បង្គោល ព្រំដែន កម្ពុជា វៀត ណា ម និង ក្លែង បន្លំ ឯកសារ ពាក់ព័ន្ធ នឹង ផែន ទី ព្រំ ដែន កម្ពុជា វៀត ណាម ។
ការ កាត់ ទោស នេះ ត្រូវ បាន គណបក្ស ប្រឆាំង ច្រាន ចោល និង អះអាង ថា តុលាការ មិន ឯករាជ្យ តុលាការ ស្ថិត នៅ ក្រោម ឥទ្ធិពល របស់ គណបក្ស កាន់ អំណាច ៕
ការកាប់ព្រៃឈើធ្វើឲ្យជនភាគតិចឦសាន ភ័យខ្លាចអារក្ខព្រៃ
ភ្នំពេញៈ រហូត ទាល់ តែ ការ អភិវឌ្ឍ ទ្រង់ទ្រាយ ធំ បាន មក ដល់ ជុំវិញ ផ្ទះ របស់ អ្នក ស្រី ក្នុង ខេត្ត រតនគិរី អ្នក ស្រី សាវ សាម៉ន ដែល ជា សមាជិក ជន ជាតិ ភាគ តិច ចារ៉ាយ មាន ការ ភ័យ ខ្លាច ចំពោះ សត្វ ព្រៃ និង ខ្មោច ព្រាយ បិសាច ។
ប៉ុន្តែ ខណៈ ដែល ព្រៃឈើ ត្រូវ បាន កាប់ បំផ្លាញ ហើយ គ្រឿង យន្ត ឧស្សាហកម្ម បាន រុករាន ចូល ទៅ ក្នុង ដី ព្រៃ ពួក ខ្មោច អារក្ខ ទាំង នោះ បាន ធ្វើ ឲ្យ អ្នក ស្រី ភ័យ ខ្លាច ។
ការងារ នេះ គឺជា ការងារ មួយ ក្នុង ចំណោម ការ ងារ ចំនួន ១២ នៅ ក្នុង « ការ ប្រកួត ប្រជែង ខ្សែ ភាពយន្ត ឯកសារ ស្តីពី រោងចក្រ ក្នុង ពិភពលោក » ដែល ក្នុង នោះ មាន ខ្សែ ភាពយន្ត មក ពី ប្រទេស អេហ្ស៊ីប រុស្ស៊ី ឥណ្ឌា អៀរឡង់ ចិន និង ប្រទេស ផ្សេង ទៀត មាន នៅ ក្នុង បញ្ជី ប្រកួត ប្រជែង នោះ ។
លោក ស្រី មុំ បាន លើក ឡើង ថា បញ្ហា មួយ ក្នុង ចំណោម បញ្ហា សំខាន់ ដែល ប៉ះពាល់ ដល់ កម្ពុជា គឺ បញ្ហា សិទ្ធិ ដីធ្លី ។
ខ្សែ ភាពយន្ត នេះ បង្ហាញ ពី ការ បំផ្លិច បំផ្លាញ ប្រព័ន្ធ អេកូឡូស៊ី តាម រយៈ ការ ថត របស់ លោក សារី ម៉ាត ជា អ្នក នេសាទ វ័យ ជំទង់ ម្នាក់ ដែល ទទួល បាន ទិន្នផល ត្រី របស់ គាត់ កាន់ តែ ធ្លាក់ ចុះ ទៅ ៗ ជាមួយ នឹង សាច់ រឿង របស់ ខៀវ មុក ដែល បាន បោះ បង់ ស្រែ ចម្ការ ខ្លួន មក ធ្វើ ការងារ ជា កម្មករ កាត់ ដេរ នៅ ភ្នំពេញ ដើម្បី ជួយ សង បំណុល គ្រួសារ ។
លោក ស្រី មុំ សង្ឃឹម ថា បើ ទោះ ជា ខ្សែ ភាព យន្ត នេះ ប្រហែល ជា មិន បង្ហាញ អំពី លក្ខណៈ នយោបាយ បរិស្ថាន ឬ ការ ស៊ើប អង្កេត លោក ស្រី សង្ឃឹម ថា ការ បង្ហាញ អំពី ស្ថានភាព បន្ទាន់ នេះ នឹង ធ្វើ ឲ្យ « សហគមន៍ ក្នុង ស្រុក និង អន្តរជាតិ ចាត់ វិធានការ » ជួយ ដោះស្រាយ បញ្ហា ទាំង នោះ ៕
សមត្ថកិច្ចតាមចាប់ មន្ត្រីយោធាម្នាក់ដែលវាយព្រះរាជអាជ្ញា
សមត្ថកិច្ច ខេត្ត ក្រចេះ បាន ធ្វើ ការ ឡោម ព័ទ្ធ និង ឆែក ឆេរ ផ្ទះ ដើម្បី ចាប់ ខ្លួន មន្ត្រី យោធា ម្នាក់ ដែល ត្រូវ បាន ចោទ ប្រកាន់ ថា បាន វាយ ដំ លើ ព្រះ រាជ អាជ្ញា រង ខេត្ត កណ្តាល ម្នាក់ ឲ្យ រង របួស ធ្ងន់ ក្នុង ជម្លោះ មួយ នៅ ស្រុក សម្បូណ៌ កាល ពី ថ្ងៃ ពុធ ។
វរសេនីយ៍ ត្រី ស្រី វុត្ថា ប្រធាន ការិយាល័យ នរគ បាល ស្រាវជ្រាវ និង យុត្តិធម៌ ខេត្ត ក្រចេះ បាន ថ្លែង ថា អនុ សេនីយ៍ ឯក មាស ពិសិដ្ឋ ដែល ជា មន្រ្តី យោធា ធ្វើ ការ ងារ នៅ អង្គភាព យោធា ក្នុង ស្រុក សម្បូណ៌ ខេត្ត ក្រចេះ ត្រូវ បាន ចោទ ប្រកាន់ ពាក់ព័ន្ធ នឹង ការ វាយ លោក កែវ សុជាតិ ព្រះ រាជ អាជ្ញា រង ខេត្ត កណ្តាល ឲ្យ រង របួស ធ្ងន់ធ្ងរ នៅ ក្នុង ខេត្ត ក្រចេះ កាល ពី ថ្ងៃ ពុធ ។
លោក បាន ប្រាប់ ភ្នំ ពេញ ប៉ុស្តិ៍ តាម ទូរស័ព្ទ កាលពី ម្សិលមិញ ថា ៖
បើ តាម លោក ស្រី វុត្ថា ជនរងគ្រោះ ត្រូវ បាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរ ពេទ្យ ក្នុង រាជធានី ភ្នំពេញ ក្រោយ ពី ការ វាយ ដំ នោះ ។
លោក សាក់ សុគុន មេ បញ្ជាការ រង កង រាជ អាវុធហត្ថ ក្រុង ក្រចេះ បាន ថ្លែង ថា កាល ពី ម្សិលមិញ នគរបាល និង កង រាជ អាវុធ ហត្ថ ដែល ដឹក នាំ ដោយ លោក ហាក់ ហ៊ាន ព្រះ រាជ អាជ្ញា រង សាលា ដំបូង ខេត្ត ក្រចេះ បាន ព័ទ្ធ ផ្ទះ របស់ មាស ពិសិដ្ឋ ដែល ស្ថិត នៅ ក្នុង សង្កាត់ អូរឫស្សី ក្រុង ក្រចេះ ។
លោក បាន បន្ថែម ទៀត ថា យោង តាម ការ ស៊ើប អង្កេត របស់ នគរបាល មាស ពិសិដ្ឋ គឺជា មនុស្ស ម្នាក់ ក្នុង ចំណោម ក្រុម ឈ្មួញ រក ស៊ី ឈើ ប្រណីត ក្នុង ខេត្ត ក្រចេះ ។
គាត់ បាន ប្រើ កន្លែង យោធា របស់ គាត់ ក្នុង ការ រត់ ពន្ធ ឈើ ប្រណីត ពី ប្រទេស កម្ពុជា ទៅ ប្រទេស វៀតណាម អស់ រយៈ ពេល ជា ច្រើន ឆ្នាំ មក ហើយ ។
លោក ហាក់ ហ៊ាន ព្រះ រាជអាជ្ញា រង ខេត្ត ក្រចេះ បាន ថ្លែង ថា រហូត មក ដល់ ពេល នេះ មាស ពិសិដ្ឋ ត្រូវ បាន ចោទ ប្រកាន់ ដោយ តុលាការ រួច ហើយ ពី បទ បង្ក របួស ស្នាម ។
លោក មាស ពិសិដ្ឋ និង គ្រួសារ របស់ គាត់ ព្រម ទាំង ជន រង គ្រោះ មិន អាច ទាក់ទង សុំ អត្ថាធិប្បាយ បាន ទេ កាល ពី ម្សិលមិញ ៕
ទ្រាំមិនបាននឹងប្តីប្រើអង្រែវាយប្រដាប់ភេទ រត់រកអាដ ហុកឲ្យជួយ
ស្ត្រី រងគ្រោះ មាន ឈ្មោះ នឹង នៀត រស់ នៅ សង្កាត់ ស្ទឹង វែង ក្រុង ខេមរភូមិន្ទ បាន រត់ គេច ពី ផ្ទះ កាល ពី យប់ ថ្ងៃ ពុធ ដោយ ហែល ទឹក ទៅ កាន់ ការិយា ល័យ អង្គការ អាដហុក បន្ទាប់ ពី ត្រូវ ប្តី វាយ ធ្វើបាប ។
ស្រ្តី រូប នេះ បាន អំពាវនាវ ដល់ អាជ្ញាធរ មូលដ្ឋាន ចាប់ ខ្លួន និង ផ្តន្ទា ទោស ស្វាមី របស់ អ្នកស្រី ទៅ តាម ផ្លូវ ច្បាប់ ។
លោក នាង បូរ៉ាទី ណូ អ្នក សម្រប សម្រួល អង្គការ អាដហុក ប្រចាំ ខេត្ត កោះ កុង បាន ថ្លែង ថា វា ជា ករណី ប្រើ អំពើ ហិង្សា ធ្ងន់ធ្ងរ នៅ ក្នុង គ្រួសារ ។
គាត់ ត្រូវ បាន ប្តី វាយ ធ្វើ បាប ស្ទើរ ឆ្កួត ។
លោក នុត សុខុម នាយ ប៉ុស្តិ៍ ប៉ូលិស សង្កាត់ ស្ទឹង វែង បាន ដឹកនាំ កម្លាំង អន្តរាគមន៍ ចុះ ទៅ ដល់ ផ្ទះ ស្ត្រី រងគ្រោះ ដើម្បី ធ្វើ ការ សាក សួរ ពី បញ្ហា នេះ កាល ពី ម្សិល មិញ ប៉ុន្តែ ក្រោយ ពី សួរ នាំ រួច មក បុរស ជា ប្តី បាន រត់ គេ ច ខ្លួន បាត់ ។
អង្គការ យេនឌ័រ និង ការ អភិវឌ្ឍ សម្រាប់ កម្ពុជា (GADC) និង អង្គការ ក្រៅ រដ្ឋាភិបាល មួយ ចំនួន ទៀត ព្រម ទាំង រដ្ឋា ភិបាល បាន រួម គ្នា ធ្វើ យុទ្ធនាការ បំពាក់ បូ ពណ៌ ស ប្រឆាំង អំពើ ហិង្សា លើ ស្រ្តី ចាប់ តាំង ពី ថ្ងៃទី ២៥ ខែ វិច្ឆិកា រហូត ដល់ ថ្ងៃទី ១០ ខែធ្នូ ឆ្នាំ ២០១២ នៅ រាជធានី ភ្នំពេញ និង នៅ តាម បណ្តា ខេត្ត មួយ ចំនួន ។
គ្រូវិទ្យាល័យបីនៅ រ វៀង ត្អូញបាត់ប្រាក់ម៉ោង ៦ ខែ
អ្នកគ្រូ ត្អូញ ត្អែរ ថា៖
ខាង ក្រសួង អប់រំ គួរ ពិនិត្យ ឡើង វិញ ព្រោះ ប្រាក់ ខែ គ្រូ ទប់ តម្លៃ ទំនិញ មិន បាន ទេ ៕
ចាប់ឃុំមន្ត្រីយោធាម្នាក់ពី បទរំលោភក្មួយស្រីថ្លៃ
លោក វរសេនីយ៍ ត្រី ហួត លឹម ហ៊ាង អនុ ប្រធាន ការិយា ល័យ កម្រិត ធ្ងន់ នៃ ស្នងការ ដ្ឋាន នគរបាល ខេត្ត ក្រចេះ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិល មិញ ថា ជន សង្ស័យ ឈ្មោះ ស៊ឹម វិទូ អាយុ ៣៣ ឆ្នាំ មាន មុខងារ ជា មន្ត្រី យោធា អង្គភាព វរ ការពារ ព្រំដែន លេខ ២០៤ នៅ ស្រុក ស្នួល មាន លំនៅ ក្នុង ភូមិ ជើង ឃ្លេ ឃុំ ២ ធ្នូ ស្រុក ស្នួល ត្រូវ បាន ចាប់ ខ្លួន កាល ពី ថ្ងៃ អង្គារ តាម បណ្ដឹង របស់ ស្ត្រី ជា ភរិយា និង ក្មេង ស្រី រងគ្រោះ ដែល ត្រូវ ជា ក្មួយ សាច់ ថ្លៃ ពី បទ រំលោភ សេព សន្ថវៈ ។
លោក លឹម ហ៊ាង បន្ត ថា៖
កម្ពុជាទទួល រងគ្រោះធ្ងន់ធ្ងរដោយគ្រោះធម្មជាតិ
គ្រោះ ទឹក ជំនន់ កាលពី ចុង ឆ្នាំ ២០១១ បាន បំផ្លាញ ផល ដំណាំ ប្រមាណ ១០ ភាគរយ នៃ ផល ដំណាំ ទាំង អស់ របស់ កម្ពុជា ហើយ ដែល លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន បាន ថ្លែង បន្ទាប់ ពី នោះ ថា ស្រែ ចំនួន ២២ ម៉ឺន ហិកតា ត្រូវ បាន រង ប៉ះពាល់ ។
លោក កែវ វី ថ្លែង ថា៖
លោក កែវ វី ថ្លែង ថា គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន ទទួល ស្គាល់ ថា កម្ពុជា « ទទួល រង គ្រោះ គួរ ឲ្យ កត់ សម្គាល់ ដោយ សារ ការ ប្រែប្រួល អាកាសធាតុ » ពីព្រោះ ខ្លួន ជា ប្រទេស កំពុង អភិវឌ្ឍន៍ ប៉ុន្តែ បាន សង្កត់ ធ្ងន់ ថា ពួក គេ មិន មាន សមត្ថភាព គ្រប់គ្រាន់ ដើម្បី សម្រប សម្រួល ខ្លួន ទៅ នឹង បាតុភូត គ្រោះ មហន្តរាយ ទេ ។
របាយការណ៍ មួយ ចេញ ដោយ អង្គការ OXFAM កាលពី ថ្ងៃ អាទិត្យ បាន ឲ្យ ដឹង ថា បណ្តា ប្រទេស កំពុង អភិវឌ្ឍន៍ អាច នឹង ជួប បញ្ហា ហិរញ្ញវត្ថុ សម្រាប់ ការ ដោះស្រាយ បញ្ហា ប្រែប្រួល អាកាសធាតុ ។
លោក កែវ វី បាន ថ្លែង ថា ចាប់ តាំង ពី ទឹក ជំនន់ ឆ្នាំ ២០១១ រដ្ឋាភិបាល បាន ប្រើប្រាស់ កម្ចី ADB ដើម្បី សាងសង់ ផ្លូវ និង ស្ពាន ព្រម ទាំង អភិវឌ្ឍ ប្រព័ន្ធ ធារាសាស្ត្រ ដែល នឹង ជួយ កាត់ បន្ថយ ផល ប៉ះពាល់ នៃ គ្រោះមហន្តរាយ នា ពេល អនាគត ។
ទាហានថៃគប់ពលរដ្ឋខ្មែរ របួស ៦នាក់
អំពើ ហិង្សា នេះ បាន ធ្វើ ឲ្យ ពលរដ្ឋ ខ្មែរ ប្រមាណ ៦០០ នាក់ ផ្សេង ទៀត ដែល បម្រុង ឆ្លង ដែន បាន បង្ខំ ចិត្ត វិល មក ស្រុក វិញ ។
លោក ណង សុង បាន បញ្ជាក់ ថា៖
លើស ពី នេះ ប្រជា ពលរដ្ឋ ខ្មែរ ដែល ឆ្លង ដែន ខុស ច្បាប់ ចំនួន ៦៨៦៥៩ នាក់ ត្រូវ បាន ចាប់ បញ្ជូន មក ស្រុក ខ្មែរ វិញ ៕
អ្នកភូមិមិនទាន់បានព័ត៌មានការសង់ទំនប់សេសាន
សំណង និង ការ រៀបចំ ការ តាំង លំនៅ ថ្មី សម្រាប់ អ្នក ភូមិ ដែល ស្ម័គ្រ ចិត្ត ផ្លាស់ លំនៅ និង ត្រូវ បាន បង្ខំ ឲ្យ ផ្លាស់ ចេញ ពី ផ្ទះ និង ដី របស់ ពួក គេ គឺជា បញ្ហា សំខាន់ ក្នុង ជម្លោះ ដីធ្លី នៅ ទូទាំង ប្រទេស កម្ពុជា ។
ទោះ ជា យ៉ាង ណា រដ្ឋាភិបាល កម្ពុជា ពុំ បាន ចាត់ វិធានការ តឹងរ៉ឹង ឆ្ពោះ ទៅ បង្កើត គោល នយោបាយ រួម មួយ ស្តីពី ការ ផ្លាស់ លំនៅ ថ្មី ឡើយ ។
លោក ផៃ ស៊ីផាន អ្នក នាំ ពាក្យ ទីស្តីការ គណៈ រដ្ឋ មន្រ្តី បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នា សប្តាហ៍ នេះ ថា៖
រដ្ឋធម្មនុញ្ញ កម្ពុជា ចែង ថា ជន ណា ក៏ ដោយ អាច បាត់ បង់ កម្មសិទិ្ធ ដី របស់ ខ្លួន តែ ដើម្បី ផល ប្រយោជន៍ សាធារណៈ ប៉ុណ្ណោះ ដោយ អនុលោម តាម ច្បាប់ ហើយ សំណង ត្រឹម ត្រូវ និង យុតិ្តធម៌ ត្រូវ បាន ផ្តល់ ឲ្យ ជា មុន ។
ទោះ ជា យ៉ាង ណា អង្គការ សិទិ្ធ មនុស្ស បាន ថ្លែង ថា កង្វះ នៃ គោលការណ៍ ណែនាំ ច្បាស់ លាស់ ឬ មាន ការ ឯកភាព នៅ ថ្នាក់ ជាតិ បាន ធ្វើ ឲ្យ មាន ការ លំបាក ក្នុង ការ បំពេញ លក្ខខណ្ឌ ២ ក្នុង ចំណោម លក្ខខណ្ឌ វិនិច្ឆ័យ ទាំង ៣។
លោក វ៉ាន់ សុផាត អ្នក សម្រប សម្រួល គម្រោង កំណែ ទម្រង់ ដីធ្លី នៅ មជ្ឈមណ្ឌល សិទិ្ធ មនុស្ស កម្ពុជា បាន ថ្លែង ថា៖
លោក វ៉ាន់ សុផាត បាន បញ្ជាក់ ថា៖
លោក បាន បន្ថែម ថា គោលការណ៍ ណែនាំ នោះ គួរ កំណត់ តម្លៃ កែ លម្អ និង វត្ថុ តាំង ភ្ជាប់ លើ ទ្រព្យសម្បត្តិ ដូច ជា លំនៅដ្ឋាន ឬ កសិដ្ឋាន អគ្គិសនី និង អណ្តូង ទឹក ជាដើម ។
ប៉ុន្តែ គោល ជំហរ របស់ រដ្ឋាភិបាល គឺ ថា បញ្ហា ទាំង នេះ គួរ កំណត់ ផ្អែក លើ ការ វិភាគ តាម ករណី ដោយ ក្រុមហ៊ុន អភិវឌ្ឍន៍ និង គណៈកម្មាធិការ ក្រសួង ថ្នាក់ ជាតិ ឬ ថ្នាក់ ក្រោម ជាតិ ។
គោល នយោបាយ ផ្លាស់ លំនៅ ថ្មី បច្ចុប្បន្ន របស់ រដ្ឋាភិបាល គឺជា ផែន ការ ស្បែក ខ្លា ដោយ រក្សា ភូមិ ដែល មាន ស្រាប់ ក្នុង ដី សម្បទាន សេដ្ឋកិច្ច ដូចជា ចំណុច ខ្មៅ លើ ខ្លួន ខ្លារ ខិន ។
ទោះ បី បែប នេះ ក៏ ដោយ លោក ផៃ ស៊ីផាន បាន ទទួល ស្គាល់ ថា កិច្ច ខិតខំ ប្រឹង ប្រែង ទាំង នេះ អាច ជាប់ គាំង ក្នុង បែប បទ ការិយាធិបតេយ្យ ហើយ នោះ ជា មូលហេតុ ដែល កត្តា ជំរុញ គឺ ស្ថិត នៅ លើ ប្រជាជន ក្នុង ការ ដាក់ វិវាទ របស់ ខ្លួន ទៅ កាន់ តុលាការ ។
សិទិ្ធ ទទួល បាន លក្ខខណ្ឌ សំណង យុត្តិធម៌ ក្នុង ច្បាប់ អស្សា មិករណ៍ ត្រូវ បាន ធានា ក្នុង រដ្ឋ ធម្មនុញ្ញ ទូទៅ នៅ ទូទាំង ពិភពលោក ហើយ ក៏ ជា បញ្ហា នៃ បណ្តឹង ផង ដែរ បើ គិត ពី លក្ខណៈ ប្រែ ប្រួល នៃ ពាក្យ « លក្ខខណ្ឌ យុតិ្តធម៌ » ។
ដូច ដែល រដ្ឋាភិបាល ទទួល ស្គាល់ ជា សាធារណៈ ថា ប្រព័ន្ធ តុលាការ កម្ពុជា ខ្វះ ធនធាន យ៉ាង ខ្លាំង ។
លោក សុផាត បាន បញ្ជាក់ ថា៖
ក្រៅ ពី មិន អនុវត្ត កាតព្វកិច្ច ទៅ តាម ផ្លូវ ច្បាប់ អាជ្ញាធរ ខ្លះ មិន បាន ដឹង ពី កាតព្វកិច្ច នេះ ផង ។
នេះ បើ យោង តាម លោក សៀក មេគង្គ មេ ឃុំ ក្នុង ភូមិ ដែល នឹង ត្រូវ បំផ្លាញ ដោយ សារ ការ សាងសង់ ទំនប់ វារី អគ្គិសនី សេសាន ២។
លោក សៀក មេគង្គ មេ ឃុំ ស្រែ គរ ក្នុង ខេត្ត ស្ទឹងត្រែង បាន ថ្លែង ថា៖
លោក សៀក មេគង្គ បាន លើក ឡើង ថា៖
ប៉ុន្តែ សំណើ របស់ ពួក គេ ពុំ មាន ការ ឆ្លើយ តប ឬ ផ្ដល់ ព័ត៌មាន ពី អាជ្ញាធរ ខេត្ត ឬ ក្រុមហ៊ុន ពាក់ព័ន្ធ ក្នុង គម្រោង ឡើយ ។
លោក សៀក មេគង្គ បាន បន្ត ថា ចំណុច ច្បាស់ មួយ សម្រាប់ អ្នក ភូមិ គាត់ គឺ ការ ផ្លាស់ លំនៅ ថ្មី ហើយ សេចក្តី លម្អិត ដទៃ ទៀត នៅ តែ ជា ចំណុច ស្រពេច ស្រពិល ។
លោក វ៉ាន់ សុផាត បាន គូស បញ្ជាក់ ថា សំណើ របស់ អ្នក ភូមិ ពុំ មាន ឥទិ្ធពល ខ្លាំង ទេ ក្នុង ករណី គម្រោង អភិវឌ្ឍន៍ ធំ បែប នេះ ។
កាល ពី ថ្ងៃ ចន្ទ ក្រុម ហ៊ុន កម្ពុជា និង ក្រុមហ៊ុន ចិន បាន ចុះ កិច្ច ព្រមព្រៀង ចំនួន ៤ ក្នុង ការ ដាក់ ហិរញ្ញវត្ថុ រយៈ ពេល ពីរ ឆ្នាំ ដំបូង លើ គម្រោង សង់ ទំនប់ វារី អគ្គិសនី សេសាន ក្រោម ពីរ ប៉ុន្តែ ព័ត៌ មាន លម្អិត មិន ត្រូវ បាន គេ ទម្លាយ ឲ្យ ដឹង ទេ ៕
កសិករត្រូវបានបង្រៀនឲ្យចេះជួសជុលម៉ាស៊ីនបូមទឹក
ថ្លៃ ជួសជុល និង ការ ធ្វើ ដំណើរ ម្តង មាន តម្លៃ ប្រហែល ជា ១០ ដុល្លារ អាមេរិក ។
យោង តាម ធនាគារ ពិភពលោក និង គណៈ កម្ម ការ សេដ្ឋកិច្ច និង សង្គម របស់ អង្គការ សហ ប្រជា ជាតិ សម្រាប់ អាស៊ី ឲ្យ ដឹង ថា ចំនួន ម៉ាស៊ីន បូម ទឹក និង ម៉ាស៊ីន បោក ស្រូវ នៅ កម្ពុជា បាន កើន ឡើង ទ្វេ ដង នៅ ចន្លោះ ឆ្នាំ ២០០៨ ដល់ ឆ្នាំ ២០១០ ខណៈ ចំនួន ត្រាក់ ទ័រ បាន កើន ឡើង ជាង ៥០ ភាគ រយ នៅ ក្នុង អំឡុង ពេល នោះ ។
លោក ស៊ូសាន នូវ៉ាក់ នាយក កម្ម វិធី រាប់ បញ្ចូល សង្គម និង អភិវឌ្ឍន៍ សមត្ថភាព បាន ថ្លែង ថា នៅ ក្នុង ការ បណ្ដុះ បណ្ដាល ជុំ ទី ពីរ ដែល គ្រោង នឹង ធ្វើ នៅ ដើម ឆ្នាំ ក្រោយ នេះ កម្មវិធី នេះ មាន បំណង ពង្រីក ចូល ទៅ ក្នុង ភូមិ ផ្សេង ៗ ថែម ទៀត ហើយ ដាក់ បញ្ចូល ប្រភេទ ម៉ាស៊ីន ច្រើន យ៉ាង ទៀត រួម មាន ទូក ម៉ាស៊ីន និង ម៉ាស៊ីន ផ្សេង ទៀត ទុក ប្រើ សម្រាប់ ការ ធ្វើ នេសាទ និង កាប់ ឆ្ការ ព្រៃ ។
តម្រូវ ការ តែ មួយ គត់ សម្រាប់ អ្នក ចូល រួម នៅ ក្នុង ការ បណ្ដុះ បណ្ដាល ជុំ ចុង ក្រោយ នេះ គឺ ពួក គាត់ មាន អាយុ ចន្លោះ ពី ១៦ ទៅ ៣០ ឆ្នាំ ហើយ ជា គ្រួសារ ដែល មាន ម៉ាស៊ីន ប្រើប្រាស់ ផ្ទាល់ ខ្លួន ។
លោក សាង សារ៉េត ជា អ្នក បណ្ដុះបណ្ដាល ដែល បាន បង្រៀន អ្នក ភូមិ សរុប ជិត ១០០ នាក់ នៅ ក្នុង ស្រុក ចំនួន បី នៃ ខេត្ត ពោធិ៍សាត់ បាន ថ្លែង ថា៖
ការ បណ្ដុះ បណ្ដាល ផ្ទាល់ របស់ ខ្ញុំ ចំណាយ ពេល ៦ ខែ ។
លោក ប៊ី ពេជ្រ សិក្ខា កាម មក ពី ភូមិ ភ្នំ រី ក្នុង ស្រុក សំឡូត ខេត្ត បាត់ដំបង និយាយ ថា ការ រៀន ជួស ជុល ម៉ាស៊ីន រយៈ ពេល បួន ថ្ងៃ គឺ មិន គ្រប់គ្រាន់ ទេ ។
ស្ត្រីពិការដោយ សារមីនម្នាក់ត្រូវរន្ទះបាញ់ស្លាប់នៅស្រុកក្រវាញ
ពោធិ៍សាត់ៈ ស្ត្រី ក្រីក្រ ពិការ ជើង ម្ខាង ដោយ គ្រាប់ មីន សល់ ពី សម័យ សង្គ្រាម ម្នាក់ បាន ស្លាប់ ដោយ សារ រន្ទះ បាញ់ ពី រសៀល ថ្ងៃទី ២៦ ខែ វិច្ឆិកា កន្លង ទៅ នៅ ក្នុង ភូមិ ឡ ឃុំ រកាត ស្រុក ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់ ក្នុង ពេល កំពុង មាន ភ្លៀង និង ខ្យល់ ។
នេះ បើ តាម ការ អះអាង របស់ អាជ្ញាធរ មូលដ្ឋាន ។
លោក មាស សាវ៉េត អធិការ រង នគរបាល ស្រុក ក្រវាញ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃ ម្សិលមិញ ថា ស្ត្រី រងគ្រោះ ឈ្មោះ អិន ធា អាយុ ៤៩ ឆ្នាំ ពិការ ជើង ម្ខាង បាន ស្លាប់ ដោយ រន្ទះ បាញ់ ពេល មេឃ កំពុង មាន ភ្លៀង ធ្លាក់ លាយឡំ ដោយ ខ្យល់ នៅ នឹង ផ្ទះ របស់ ជនរងគ្រោះ តែ ម្តង ប៉ុន្តែ មិន មាន នរណា ផ្សេង រង បួស នោះ ទេ ។
លោក បាន ឲ្យ ដឹង បន្ថែម ដែរ ថា គ្រួសារ មួយ នេះ គ្មាន មុខរបរ អ្វី មួយ ច្បាស់ លាស់ នោះ ទេ ក្រៅ តែ ពី ដើរ ស៊ី ឈ្នួល ឲ្យ អ្នក ភូមិ បាន ប្រាក់ បន្តិច បន្តួច ដោះស្រាយ ជីវភាព នោះ ។
តាម លោក កែវ វី អនុប្រធាន នាយក ដ្ឋាន ព័ត៌មាន និង ទំនាក់ ទំនង នៃ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះ មហន្តរាយ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ដើម ខែ វិច្ឆិកា កន្លង ទៅ ថា ក្នុង រយៈពេល ១០ ខែ ដើម ឆ្នាំ ២០១២ នេះ មាន មនុស្ស ១០០ នាក់ បាន ស្លាប់ ដោយ សារ រន្ទះ បាញ់ និង ៧០ នាក់ ផ្សេង ទៀត បាន រងរបួស ធ្ងន់ និង ស្រាល សត្វ គោ ក្របី ៣២ ក្បាល ក៏ បាន ងាប់ និង ផ្ទះ ៥ខ្នង រង ការ ខូចខាត ផង ដែរ ។
ព្រះ អង្គ ម្ចាស់ ស៊ីសុវត្ថិ ធម្មិកោ ទីប្រឹក្សា អម ព្រះរាជ ខុទ្ទកាល័យ ព្រះមហាក្សត្រ និង ជា អតីត លេខា ផ្ទាល់ របស់ ព្រះ មហា វីរក្សត្រ បាន មាន បន្ទូល ថា ការ នេះ គឺជា ប្រពៃណី របស់ រាជ វង្ស នៅ ពេល ណា ដែល មាន ព្រះ មហាក្សត្រ យាង ចូល ទិវង្គត គឺ តែង តែ ផ្តល់ ព្រះ គោរម ងារ ដល់ ព្រះ បរម សព របស់ ព្រះ មហាក្សត្រ ។
លោក រស់ ចន្ត្រា បុត្រ សាស្ត្រា ចារ្យ ផ្នែក វិទ្យាសាស្ត្រ នយោបាយ និង ជា ប្រវត្តិ វិទូ ខ្មែរ បាន ថ្លែង ឲ្យ ដឹង ថា ជា ធម្មតា ព្រះមហាក្សត្រ ខ្មែរ គឺ តែង តែ មាន ព្រះគោរមងារ ចំនួន បី គឺ ទី មួយ នៅ ពេល ដែល ព្រះ អង្គ ប្រសូត មក គឺ មាន ព្រះ នាម ផ្ទាល់ ខ្លួន ទី ពីរ នៅ ពេល ដែល សោយរាជ្យ ត្រូវ មាន ព្រះ គោរមងារ មួយ ទៀត ហើយ នៅ ពេល ដែល សោយ ទិវង្គត ក៏ ត្រូវ មាន ព្រះ គោរព ងារ មួយ ទៀត ដែរ ។
កាល ពី ថ្ងៃ ទី ២៦ ខែ វិច្ឆិកា ឆ្នាំ ២០១២ ក្នុង ពិធី បើក ការ ដ្ឋាន សាងសង់ ស្ពាន អាកាស ស្ទឹងមានជ័យ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន មាន ប្រសាសន៍ ថា នៅ ថ្ងៃ ពិធី បុណ្យ អុំ ទូក ថ្ងៃ សំពះ ព្រះ ខែ គឺជា ថ្ងៃ ដែល ព្រះមហាក្សត្រ ប្រទាន នូវ ព្រះ បរម បច្ឆាម រណនាម ថ្វាយ ព្រះ សព សម្តេច ព្រះមហា វីរក្សត្រ សម្តេច ព្រះ នរោត្តម សីហនុ ដែល មាន ព្រះ នាម ថា « ព្រះ បរម រតន កោដិ » ។
ព្រះ អង្គ ត្រូវ បាន ពលរដ្ឋ ជាច្រើន ចង ចាំ ពី យុគ សម័យ ដែល កម្ពុជា ជួប ប្រទះ ក្រោយ ពី ទទួល បាន ឯករាជ្យ ក្នុង ឆ្នាំ ១៩៥៣ ពី អាណានិគម បារាំង ។
ការ សោយ ទិវង្គត របស់ ព្រះ អង្គ គឺជា ព្រឹត្តិការណ៍ ដែល មាន ការ ចូល រួម មរណទុក្ខ ដ៏ ធំ បំផុត មួយ ក្នុង ប្រវត្តិសាស្ត្រ មេដឹកនាំ កម្ពុជា នៅ ក្នុង រយៈពេល ៧០ ឆ្នាំ ចុង ក្រោយ នេះ ៕
អ្នកភូមិ៧ នាក់ នៅព្រៃឈរ ចុះក្អួតរាក សង្ស័យថាពុលទឹកស៊ីអ៊ីវ
កំពង់ចាមៈ យ៉ាង ហោច មាន ប្រជាពលរដ្ឋ ៧ នាក់ ដែល ភាគ ច្រើន ជា កុមារ បាន ពុល អាហារ ចុក ពោះ រាក និង ក្អួត ចង្អោរ និង សង្ស័យ ថា បណ្តាល ម ក ពី ហូប បបរ ជាមួយ ទឹក ស៊ីអ៊ីវ កាលពី យប់ ថ្ងៃ អង្គារ ។
បច្ចុប្បន្ន គេ មាន អាការ ធូរស្រាល វិញ ហើយ » ។
អ្នក ស្រី ទេព គឹម ហ៊ាន់ អាយុ ៣៤ ឆ្នាំ រស់ នៅ ភូមិ ទ្រមក់ ឃុំ តុង រ៉ុង ស្រុក ព្រៃ ឈរ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ តាម ទូរស័ព្ទ កាលពី ម្សិលមិញ ថា កាលពី ល្ងាច ថ្ងៃ អង្គារ គាត់ ទៅ ទិញ ទឹក ស៊ីអ៊ីវ « ស៊ូគី !
លោក សែម ចាន់ថុល ប្រធាន មណ្ឌល សុខភាព ឃុំ តុង រ៉ុង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា គាត់ បាន ចុះ ទៅ ប្រមូល សំណាក ដប ទឹក ស៊ីអ៊ីវ ដែល អ្នក ភូមិ ថា ពុល នោះ មក រក្សា ទុក ហើយ ពី ព្រឹក ម្សិលមិញ ។
ពាក់ព័ន្ធ នឹង បញ្ហា នេះ លោក ថោង តារា ប្រធាន ទីផ្សារ ក្រុមហ៊ុន ទឹក ស៊ីអ៊ីវ ស៊ូគី ស៊ូគី អះអាង កាលពី ម្សិលមិញ ថា ទឹក ស៊ីអ៊ីវ ក្រុមហ៊ុន លោក បាន ផលិត ចេញ ពី សណ្ដែក សៀង ពិត ៗ គ្មាន លាយ សារធាតុ គីមី អ្វី ឡើយ ។
លោក ស្នើ ឲ្យ មាន ការ ត្រួត ពិនិត្យ ករណី នេះ ឲ្យ បាន ច្បាស់ លាស់ ព្រោះ លោក បារម្ភ ថា៖
បាក់ច្រាំងទន្លេនៅពញា ឮ រ លំបាក់ផ្ទះ ១ ខ្នងទៅក្នុងទឹក
កណ្តាលៈ ផ្ទះ មួយ ខ្នង ធ្វើ ពី បេតុង ក្រោម ប្រក់ ស័ង្កសី លើ ទំហំ ៥ ម៉ែត្រ គុណ និង ៧ ម៉ែត្រ ត្រូវ បាន ដួល រលំ បាក់ ចូល ក្នុង ទឹក ទន្លេ ដោយ ការ ស្រុត បាក់ ដី ច្រាំង ខណៈ ដែល ម្ចាស់ ផ្ទះ បាន ដឹង មុន ហើយ បាន ភៀស ខ្លួន និង ជញ្ជូន របស់ របរ ចេញ ទាន់ មុន ពេល កើត ឧប្បត្តិហេតុ កាលពី ព្រឹក ម្សិលមិញ នៅ ក្នុង ឃុំ កំពង់ ហ្លួង ស្រុក ពញា ឮ ។
លោក ឲ្យ ដឹង ទៀត ថា ម្ចាស់ ផ្ទះ ដែល រលំ នោះ ជា ស្ត្រី ខ្មែរ អ៊ិស្លាម ឈ្មោះ ម៉ាន់ ម៉ាស់ រស់ នៅ តាម បណ្តោយ ដង ទន្លេ សាប ក្នុង ភូមិ ទួល ងោក ឃុំ កំពង់ហ្លួង ស្រុក ពញា ឮ ខេត្ត កណ្តាល ។
អាជ្ញាធរ បាន ឲ្យ ត្រឹម ម្ចាស់ ផ្ទះ ២ខ្នង នោះ ប្រុងប្រយ័ត្ន ការ បាក់ រលំ ចៀសវាង គ្រោះថ្នាក់ ឬ បាត់បង់ ទ្រព្យសម្បត្តិ ជា យថាហេតុ ។
នគរបាលកំពុងតាមចាប់អ្នកស្ទាក់វាយអ្នកទៅលេងបុណ្យនៅសំរោង
ឧត្តរមានជ័យៈ នគរបាល ខេត្ត ឧត្តរមានជ័យ កំពុង តាម ចាប់ ខ្លួន បុរស ចំនួន ១១ នាក់ បន្ទាប់ ពី ពួក គេ បាន ស្ទាក់ វាយ មនុស្ស ចាស់ ក្មេង ជាង ២០ នាក់ ក្នុង ក្រុង សំរោង នៅ ពេល អ្នក ទាំង នោះ កំពុង ធ្វើ ដំណើរ មក ពី លេង បុណ្យ កាល ពី យប់ ថ្ងៃ សុក្រ សប្តាហ៍ មុន ។
លោក រឹម សៅ ម៉ៅ នាយ រង ការិយាល័យ កម្រិត ស្រាល ខេត្ត ឧត្តរមានជ័យ បាន ប្រាប់ ឲ្យ ដឹង ថា ប្រជាពលរដ្ឋ ចាស់ ក្មេង ជាង ២០ នាក់ នៅ ក្នុង សង្កាត់ បន្សាយ រាក់ ក្រុង សំរោង ខេត្ត ឧត្តរមានជ័យ បាន ជិះ គោ យន្ត ត្រឡប់ មក ពី លេង បុណ្យ អុំ ទូក នៅ ឯ ទី រួម ខេត្ត ពេល នោះ បុរស មួយ ក្រុម បាន ស្ទាក់ ផ្លូវ វាយ ទៅ លើ ប្រជាពលរដ្ឋ ទាំង នោះ ដោយ ប្រើ ដំបង ឈើ និង ដាវ សាំ ម៉ូរ៉ៃ មួយ បណ្តាល ឲ្យ រង របួស ជាង ១០ នាក់ ឯណោះ ។
លោក សៅ ម៉ៅ បាន បញ្ជាក់ ថា៖
លោក ថា នគរបាល បាន បញ្ជូន ជន សង្ស័យ រូប នេះ ទៅ តុលាការ ខេត្ត កាល ពី ថ្ងៃ អង្គារ ហើយ តុលាការ បាន ចេញ ដីការ ឃុំ ខ្លួន បណ្តោះ អាសន្ន ក្រោម ការ ចោទ ប្រកាន់ ពី បទ បង្ក របួស ស្នាម ដោយ ចេតនា ។
លោក ម្លិះ ហឿត ប្រធាន សហគមន៍ ព្រៃឈើ មួយ ដែល ទទួល ការ ពឹង ពាក់ ពី សាច់ ញាតិ ជនសង្ស័យ អះអាង ថា នគរបាល នៅ ក្នុង មូលដ្ឋាន នេះ តែង តែ ទទួល ប្រយោជន៍ ពី ជម្លោះ នានា ។
ភរិយាលោក ម៉ម សូណង់ ដូ សុំឲ្យរដ្ឋាភិបាលនិងតុលាការ ដកការ ចោទប្រកាន់ស្វាមី
ភ្នំពេញៈ ភរិយា របស់ លោក ម៉ម សូណង់ ដូ ប្រធាន វិទ្យុ សំបុក ឃ្មុំ និង ជា ប្រធាន សមាគម អ្នក ប្រជាធិបតេយ្យ អំពាវនាវ សុំ ឲ្យ រដ្ឋាភិបាល និង តុលាការ លើកលែង ការ ចោទ ប្រកាន់ ស្វាមី របស់ គាត់ ដែល កំពុង ឃុំ ខ្លួន ក្នុង ពន្ធនាគារ ព្រៃ ស ពី បទ ចោទ ប្រកាន់ បង្កើត តំបន់ អបគមន៍ នៅ ក្នុង ខេត្ត ក្រចេះ ប្រឆាំង ទៅ នឹង រដ្ឋាភិបាល ។
អ្នក ស្រី ឌិន ផាណារ៉ា បាន ឲ្យ ដឹង ថា អ្នក ស្រី សប្បាយ ចិត្ត នៅ ពេល ដែល អ្នក ស្រី បាន ឮ ដំណឹង ថា លោក ប្រធានាធិបតី សហរដ្ឋ អាមេរិក បារ៉ាក់ អូបាម៉ា បាន លើក យក បញ្ហា នៃ ការ ចោទ ប្រកាន់ ប្ដី របស់ គាត់ ទៅ ជជែក ជាមួយ នឹង លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន ក្នុង ជំនួប ទ្វេ ភាគី កន្លង ទៅ នេះ ។
ខ្ញុំ សុំ ឲ្យ រដ្ឋាភិបាល និង តុលាការ លើក លែង ការ ចោទ ប្រកាន់ ស្វាមី របស់ ខ្ញុំ » ។
អ្នក ស្រី ផាណារ៉ា បន្ត ទៀត ថា អ្នក ស្រី នៅ មាន សង្ឃឹម និង ជឿ ជាក់ ទៅ លើ រដ្ឋាភិបាល ក៏ ដូច ជា ប្រព័ន្ធ តុលាការ និង ស្វែងរក យុត្តិធម៌ សម្រាប់ ស្វាមី របស់ គាត់ ។
អ្នក ស្រី អះអាង ថា ៖
អ្នក ស្រី ឲ្យ ដឹង ទៀត ថា គាត់ មាន មោទនភាព ចំពោះ សកម្មភាព របស់ ស្វាមី ចំពោះ អ្វី ដែល គាត់ ធ្វើ គឺ ដើម្បី សង្គម ជាតិ គឺ គាត់ ទាមទារ សេរីភាព និង លទ្ធិ ប្រជាធិបតេយ្យ ជូន ប្រជាពលរដ្ឋ ដែល ជា ការ លះបង់ និង មាន តម្លៃ ជា សកល សូម្បី តែ មេ ដឹកនាំ ប្រទេស មហា អំណាច ដូចជា សហរដ្ឋ អាមេរិក ក៏ គេ យក ចិត្ត ទុក ដាក់ និង ផ្តល់ តម្លៃ ដល់ ស្នាដៃ និង ការ លះ បង់ របស់ ស្វាមី គាត់ ដែរ ។
នៅ ថ្ងៃទី១ ខែ តុលា ឆ្នាំ ២០១២ លោក ម៉ម សូណង់ ដូ ត្រូវ សាលា ដំបូង រាជធានី សម្រេច ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ២០ ឆ្នាំ និង ពិន័យ ជា ប្រាក់ ១០ លាន រៀល ពី បទ ផ្តើម គំនិត ញុះញង់ ប្រជាពលរដ្ឋ ប្រឆាំង អាជ្ញាធរ និង ផ្តើម គំនិត ឲ្យ ប្រជា ពលរដ្ឋ ធ្វើ កុបកម្ម ប្រឆាំង នឹង អ្នក រាជការ សាធារណៈ ។
ការ សម្រេច នេះ ធ្វើ ឲ្យ មាន ប្រតិកម្ម ពី អ្នក នាំ ពាក្យ ប្រទេស មហា អំណាច ចំនួន ពីរ និង អង្គការ ក្រៅ រដ្ឋាភិបាល ជាតិ និង អន្តរជាតិ ថា ជា រឿង នយោបាយ ហើយ នេះ ជា ការ ជាប់ ពន្ធនាគារ លើក ទី៣ របស់ លោក ម៉ម សូណង់ ដូ ។
នៅ ក្នុង កិច្ច ប្រជុំ ទ្វេ ភាគី មួយ ប្រធានាធិបតី អាមេរិក លោក បារ៉ាក់ អូបាម៉ា នៅ ថ្ងៃទី ១៩ ខែ វិច្ឆិកា នៅ ឯ វិមាន សន្តិភាព លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន បាន លើក ថា នៅ ប្រទេស កម្ពុជា មិន មាន អ្នក ទោស នយោបាយ ទេ តែ មាន អ្នក នយោបាយ ដែល ប្រព្រឹត្ត ខុស ត្រូវ តុលាការ កាត់ ទោស ។
អ្នក នាំ ពាក្យ ទីស្ដីការ គណៈ រដ្ឋ មន្ត្រី លោក ផៃ ស៊ីផាន បាន ធ្វើ ការ ឆ្លើយ ត ប ទៅ នឹង ការ ស្នើ និង ប្រតិកម្ម ខាង លើ ដែរ ថា រដ្ឋាភិបាល មិន មាន លទ្ធភាព ជួយ សម្រួល ឲ្យ មាន ការ ដោះលែង អ្នក ទោស ឬ ជន ដែល ត្រូវ តុលាការ ចោទ ប្រកាន់ បាន ទេ ពី ព្រោះ វា មិន មែន ជា កាតព្វកិច្ច ឬ ជា សមត្ថកិច្ច របស់ រដ្ឋាភិបាល ។
ចាប់ខ្លួនឧកញ៉ាតាន់ សេងហាក់ និងបក្ខពួក១៥ នាក់ផ្សេងទៀតពាក់ព័ន្ធនឹងគ្រឿងញៀន
ភ្នំពេញៈ មនុស្ស ១៦ នាក់ រាប់ ទាំង ឧកញ៉ា និង ជន ជាតិ ចិន ៣នាក់ ផង ត្រូវ មន្ត្រី ប្រឆាំង គ្រឿង ញៀន អះអាង ថា ត្រូវ បាន ចាប់ ខ្លួន កាល ពី ម្សិលមិញ ពី បទ ប្រើប្រាស់ និង ចែកចាយ គ្រឿង ញៀន នៅ ក្នុង ខណ្ឌ សែន សុខ រាជធានី ភ្នំពេញ ។
លោក សឿង នុល ប្រធាន ការិយាល័យ ប្រឆាំង គ្រឿង ញៀន នៃ ក្រសួង មហា ផ្ទៃ បាន ប្រាប់ ឲ្យ ដឹង កាល ពី ម្សិលមិញ ថា លោក ឧកញ៉ា តាន់ សេងហាក់ ប្រពន្ធ កូន ស្រី និង កូន ប្រុស បី នាក់ និង ជនជាតិ ចិន ៣នាក់ ក្នុង នោះ មាន ស្រី ម្នាក់ និង មនុស្ស ៨នាក់ ផ្សេង ទៀត ត្រូវ បាន ចាប់ ខ្លួន ក្នុង ពេល នគរបាល ចុះ បង្ក្រាប នៅ ភូមិ គ្រឹះ របស់ ឧកញ៉ា តាន់ សេងហាក់ ស្ថិត ក្នុង ភូមិ ពោង ពាយ សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែន សុខ រាជធានី ភ្នំពេញ កាល ពី ម៉ោង ប្រហែល ១១ ព្រឹក ថ្ងៃ ទី២៧ ខែ វិច្ឆិកា ឆ្នាំ ២០១២ ។
ពួក គេ ត្រូវ បាន ចាប់ ខ្លួន នៅ ពេល នគរបាល របស់ យើង បាន ចុះ បង្ក្រាប ភូមិ គ្រឹះ របស់ ឧកញ៉ា តាន់ សេង ហាក់ ស្ថិត ក្នុង សង្កាត់ ភ្នំពេញ ថ្មី ។
លោក បញ្ជាក់ បន្ថែម ថា ដើម្បី បង្ក្រាប នៅ ភូមិ គ្រឹះ ឧកញ៉ា តាន់ សេងហាក់ នគរបាល ត្រូវ បាន ដាក់ ពង្រាយ និង ឡោមព័ទ្ធ ភូមិ គ្រឹះ តាំង ពី ម៉ោង ៩ ព្រឹក ហើយ ដើម្បី បង្ការ ពួក គេ កុំ ឲ្យ រត់ គេច នគរបាល ក៏ បាន ធ្វើ ការ បាញ់ កាំភ្លើង ឡើង ទៅ លើ គំរាម ផង ដែរ ។
លោក ជា ម៉េត ព្រះរាជអាជ្ញា រង អម សាលា ដំបូង រាជធានី ភ្នំពេញ ដែល បាន ដឹក នាំ កម្លាំង នគរបាល ចុះ បង្ក្រាប ករណី គ្រឿង ញៀន ខាង លើ មិន អាច ទាក់ ទង សុំ ការ អត្ថាធិប្បាយ បាន ទេ កាល ពី ម្សិលមិញ ។
លោក ឧត្តម សេនីយ ខៀវ សាម៉ន ប្រធាន នាយកដ្ឋាន ប្រឆាំង គ្រឿង ញៀន នៅ ក្រសួង មហា ផ្ទៃ បាន ថ្លែង ថា កង កម្លាំង ប្រឆាំង គ្រឿង ញៀន បាន ចំណាយ ពេល អស់ ជាច្រើន ខែ ក្នុង ការ តាម ដាន និង ស៊ើប អង្កេត សកម្មភាព របស់ ឧកញ៉ា តាន់ សេងហាក់ មុន នឹង ឈាន ដល់ ការ ចុះ បង្ក្រាប និង ចាប់ ខ្លួន ពួក គេ នៅ ភូមិ គ្រឹះ នេះ កាល ពី ម្សិលមិញ ។
ដើម្បី បង្ក្រាប សកម្មភាព គ្រឿងញៀន និង ការ ប្រើប្រាស់ គ្រឿង ញៀន នៅ កម្ពុជា យើង នឹង បន្ត ខិតខំ ប្រឹង ប្រែង ត ទៅ ទៀត » ។
លោក ឧកញ៉ា តាន់ សេងហាក់ និង ក្រុម គ្រួសារ មិន អាច ទាក់ ទង សុំ ការ អត្ថាធិប្បាយ បាន ទេ កាល ពី ម្សិលមិញ ៕
តំណាង រាស្ត្របក្សប្រជាជនត្រៀមសុំទោស ព្នង
ប្រសាសន៍ ដែល លោក ឈាង វុន និយាយ ជាមួយ ភ្នំ ពេញ ប៉ុស្តិ៍ គឺ ស្រប ពេល ជន ជាតិ ដើម ភាគ តិច ព្នង គ្រោង រៀបចំ សន្និ សីទ សារព័ត៌មាន ជា សាធារណៈ មួយ នៅ រាជធានី ភ្នំពេញ នៅ ថ្ងៃ ទី ៥ ខែ ធ្នូ សប្តាហ៍ ក្រោយ នេះ ដើម្បី បង្ហាញ ពី ប្រតិកម្ម និង លាង ជម្រះ នូវ ការ ប្រើប្រាស់ ពាក្យ ពេចន៍ មិន សមរម្យ ដែល វាយ ប្រហារ និង មាក់ ងាយ ទៅ លើ ជន ជាតិ ព្នង របស់ ពួក គេ ។
ព្រៃសហគមន៍រំដួលវាសនាកំពុងត្រូវគេកាប់ រាន យកដី
ឧត្ត រមានជ័យៈ ព្រៃ សហគមន៍ មួយ នៅ ក្រុង សំរោង ដែល រដ្ឋាភិបាល បាន ចុះ កិច្ច ព្រមព្រៀង អភិរក្ស ជាមួយ នឹង អង្គការ ក្រៅ រដ្ឋាភិបាល មួយ កំពុង ទទួល រង ការ កាប់ ទន្រ្ទាន ពី ប្រជា ពលរដ្ឋ ដែល រហូត មក ដល់ ពេល នេះ បាត់ បង់ អស់ ជាង ១ ពាន់ ហិកតា ហើយ ។
លោក ម្លិះ ហឿត ប្រធាន សហគមន៍ ព្រៃឈើ រំដួល វាសនា ដែល ស្ថិត នៅ ក្នុង សង្កាត់ បន្សាយ រាក់ ក្រុង សំរោង ខេត្ត ឧត្តរមានជ័យ បាន អះអាង កាល ពី ថ្ងៃ ម្សិលមិញ ថា ប្រជា ពលរដ្ឋ បាន និង កំពុង បន្ត ទន្រ្ទាន កាប់ ឆ្ការ ដី ព្រៃ សហគមន៍ រំដួល វាសនា ដើម្បី យក ដី ធ្វើ កសិកម្ម ដោយ គ្មាន ការ ជួយ ទប់ស្កាត់ ពី សំណាក់ អាជ្ញាធរ មូលដ្ឋាន ឡើយ បើ ទោះ ជា ព្រៃ សហគមន៍ នោះ ត្រូវ បាន ចុះ កិច្ច ព្រមព្រៀង អភិរក្ស ហើយ យ៉ាង ណា ក៏ ដោ យ ។
លោក ម្លិះ ហឿត និយាយ ថា៖
ព្រៃ សហគមន៍ ជា របស់ រួម ប៉ុន្តែ អាជ្ញាធរ មិន ខ្វល់ នោះ ទេ ។
ខ្វល់ ខ្លាច តែ បាត់ សន្លឹក ឆ្នោត និង លាភសការៈ ហើយ បើក ដៃ ឲ្យ មាន សកម្មភាព កាប់ បំផ្លាញ » ។
លោក បាន បន្ថែម ថា កន្លង មក លោក បាន ដាក់ លិខិត សុំ អន្តរាគមន៍ ពី ស្ថាបន័ រដ្ឋាភិបាល សើ្ទរ គ្រប់ អស់ ហើយ ប៉ុន្តែ នៅ មិន ទាន់ មាន វិធានការ ណា មួយ ជួយ ទប់ស្កាត់ ការ កាប់ ទន្រ្ទាន ព្រៃ យក ដី នេះ នៅ ឡើយ ទេ ។
ថវិកា មួយ ចំនួន នឹង ចំណាយ លើ ក្រុម ការងារ ល្បាត សម្រាប់ ទប់ស្កាត់ ការ កាប់ បំផ្លាញ ព្រៃឈើ និង ទន្រ្ទាន យក ដី ព្រៃ សហគមន៍ នេះ ។
លោក ស្រី ណា រ៉េន អ្នក សម្រប សម្រួល សមាគម សិទិ្ធ មនុស្ស អាដហុក ប្រចាំ ខេត្ត ឧត្តរមានជ័យ ក៏ បាន អះអាង ផង ដែរ ថា សព្វ ថ្ងៃ នេះ ពិត ជា មាន ការ កាប់ ទន្រ្ទាន ដី ព្រៃ សហគមន៍ នោះ មែន ។
អាជ្ញាធរ មូលដ្ឋាន ក៏ មិន សូវ យក ចិត្ត ទុក ដាក់ លើ បញ្ហា នេះ ប៉ុន្មាន ដែរ ហើយ កន្លង មក រឿង ការ ចូល កាប់ ទន្រ្ទាន ដី ព្រៃ សហគមន៍ នេះ ក៏ ធ្លាប់ បង្ក ជា អំពើ ហិង្សា ដាក់ គ្នា រវាង ពលរដ្ឋ និង ប្រជា ការពារ ព្រៃ នោះ ដែរ ។
លោក ប៉ិច សុខិន អភិបាល ខេត្ត និង លោក សាន វណ្ណា អភិបាល រង ខេត្ត ឧត្តរមានជ័យ ជាប់ រវល់ មិន អាច ធ្វើ ការ អត្ថាធិប្បាយ បាន ទេ កាល ពី ម្សិលមិញ ។
ភ្នំពេញៈ រដ្ឋាភិបាល បាន ធ្វើ អនុប យោគ ប្តូរ ពី ទ្រព្យសម្បតិ្ត សាធារណៈ របស់ រដ្ឋ មក ជា ទ្រព្យ សម្បត្តិ ឯកជន របស់ រដ្ឋ នូវ ទីតាំង នាយក ដ្ឋាន ចំនួន ៤ នៃ ក្រសួង ធនធាន ទឹក និង ឧតុ និយម ក្នុង ខណ្ឌ សែន សុខ ។
នៅ ថ្ងៃ ទី ៣០ ខែ តុលា ឆ្នាំ ២០១២ លោក នាយក រដ្ឋ មន្ត្រី ហ៊ុន សែន បាន ចុះ ហត្ថលេខា លើ អនុក្រឹត្យ ធ្វើ អនុប យោគ ប្តូរ ចំណាត់ ថ្នាក់ ពី ទ្រព្យ សម្បតិ្ត សាធារណៈ របស់ រដ្ឋ មក ជា ទ្រព្យ សម្បត្តិ ឯកជន របស់ រដ្ឋ នូវ ទី តាំង នាយកដ្ឋាន ចំនួន ៤ របស់ ក្រសួង ធនធាន ទឹក ស្ថិត នៅ សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែន សុខ លើ ផ្ទៃ ដី ទំហំ ៤៤៤៥៦ ម៉ែត្រ ក្រឡា ។
យោង តាម អនុក្រឹត្យ របស់ រាជ រដ្ឋាភិបាល មាត្រា ទី ២ បាន ចែង ថា ការ លក់ ទីតាំង ដូច មាន ចែង នៅ ក្នុង មាត្រា ១ ចេញ ពី បញ្ជី សារ ពើ ភណ្ឌ ទ្រព្យ សម្បត្តិ រដ្ឋ ត្រូវ ស្ថិត ក្រោម ការ ចាត់ ចែង នីតិវិធី ដោយ ក្រសួង ប្រៃសណីយ៍ ធនធាន ទឹក សង្គម កិច្ច និង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
លោក ម៉ៅ ប៊ុន ធឿន ប្រធាន មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម បាន បដិសេធ ពុំ ធ្វើ ការ អត្ថាធិប្បាយ ទេ កាល ពី ថ្ងៃ ម្សិលមិញ ដោយ ថ្លែង ថា ៖
ពលរដ្ឋ ម្នាក់ ក្នុង ចំណោម ៦ គ្រួសារ ដែល ជា អតីត បុគ្គលិក ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដែល បាន សង់ ផ្ទះ រស់ នៅ ក្នុង ទីតាំង នាយកដ្ឋាន នោះ ដែល ស្នើ សុំ មិន បញ្ចេញ ឈ្មោះ បាន ឲ្យ ដឹង ថា ខាង នាយកដ្ឋាន ឧតុ និយម បាន ណែនាំ ឲ្យ ក្រុម បុគ្គលិក រស់ នៅ ទីនោះ រុះរើ ផ្ទះ សម្បែង ចេញ ទាំង អស់ ដោយ ប្រាប់ ថា ដី នេះ ថ្នាក់ លើ បាន លក់ ទៅ ឲ្យ ក្រុមហ៊ុន ឯក ជន រួច ហើយ ។
ថ្ងៃបុណ្យអុំ ទូកនៅភ្នំពេញក្នុងឆ្នាំនេះស្ងប់ស្ងាត់
រាជធានី ភ្នំពេញ មាន សភាព ស្ងប់ ស្ងាត់ កាល ពី ម្សិល មិញ ដែល ជា ថ្ងៃ ទី ១ នៃ ពិធី បុណ្យ អុំ ទូក អក អំបុក សំពះ ព្រះ ខែ និង លយ ប្រទីប បន្ទាប់ ពី រាជ រដ្ឋាភិបាល បាន សម្រេច លុបចោល ពិធី បុណ្យ ប្រចាំ ឆ្នាំ នៅ មុខ ព្រះ បរម រាជ វាំង មួយ នេះ ដោយ សារ តែ អតីត ព្រះ មហា វីរក្សត្រ សម្តេច ព្រះ នរោត្តម សីហនុ យាង ចូល ទិវង្គត ។
ទិដ្ឋភាព នៅ ជួរ មាត់ ទន្លេ កាល ពី ម្សិលមិញ មាន សភាព ស្ងប់ស្ងាត់ ដូច ថ្ងៃ ធម្មតា ផ្លូវ ជុំវិញ ព្រះបរម រាជ វាំង នៅ តែ បន្ត ដាក់ របាំង បិទ ចរាច រណ៍ ដូច សព្វ ដង ។
