លោក នេត សារឿន ប្រធាន ការិយាល័យ នគរបាល ប្រឆាំង ការជួញដូរ មនុស្ស ខេត្ត ស្វាយរៀង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ មុន នេះ បន្តិច ថា លោក ស៊ុំ ពៅ អនុប្រធាន ក្រុមការងារ ស្រាវជ្រាវ យុទ្ធសាស្ដ្រ យោធា នៃ អគ្គ បញ្ជាការដ្ឋាន កងទ័ព ជើង គោក រួមទាំង មន្ត្រី យោធា ៥ នាក់ ទៀត ដែល ជា បក្ខពួក របស់ គាត់ ត្រូវ បាន ចាប់ខ្លួន កាល យប់ ថ្ងៃទី ២១ ខែ មេសា ឆ្នាំ ២០២១ ពាក់ព័ន្ធ ករណី រត់ ពន្ធ មនុស្ស ២៨ នាក់ ពី ភ្នំពេញ ទៅ ខេត្ត ស្វាយរៀង ។
ទោះ យ៉ាងណា ក៏ដោយ ក្រុម ជនសង្ស័យ ទាំង ៦ នាក់ នឹង ត្រូវ បញ្ជូន ទៅកាន់ តុលាការ ខេត្ត ស្វាយរៀង ក្រោយ បញ្ចប់ ការស៊ើបសួរ ចម្លើយ នៅ រសៀល ឬ ល្ងាច ថ្ងៃទី ២៣ ខែ មេសា នេះ » ។
លោក បាន ប្រាប់ ឲ្យ ដឹង ទៀត ថា ចំណែក ជនជាតិ ចិន ទាំង ២៨ នាក់ ដែល បាន រត់ គេ ច ពី រាជធានី ភ្នំពេញ ដែល ជា តំបន់ ត្រូវបាន បិទ ខ្ទប់ ដោយសារ ករណី ឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ នោះ កំពុង ត្រូវ បាន ធ្វើ កំណត់ហេតុ និង ក សាង សំណុំរឿង ដើម្បី បញ្ជូន ឲ្យ កម្លាំង នគរបាល ការិយាល័យ អន្តោប្រវេស រៀបចំ សំណុំ ឯកសារ បណ្ដេញ ចេញ ពី កម្ពុជា ផងដែរ ។
ជុំវិញ ករណី ចាប់ខ្លួន លោក ស៊ុំ ពៅ និង និង បក្ខពួក ជា មន្ត្រី យោធា ៥ ទៀត ខាងលើ នេះ លោក ឈុំ សុជាតិ អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែមេសា នេះ ថា ករណី នេះ មិន ជាប់ ពាក់ព័ន្ធ ស្ថាប័ន និង អង្គភាព យោធា នោះ ទេ ។
ជាមួយ គ្នា នេះ លោក វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេមរភូមិន្ទ បាន ជំរុញ ឲ្យ សមត្ថកិច្ច នគរបាល ខេត្ត ស្វាយរៀង ចាត់ វិធានការ ទៅ លើ បុគ្គល ឈ្មោះ ស៊ុំ ពៅ និង បក្ខពួក ជា មន្ត្រី យោធា ៥ នាក់ ទៀត នោះ ទៅ តាម នីតិវិធី ច្បាប់ ។
ខ្ញុំ មិន យោគយល់ មិន អី ទៀត ទេ ព្រោះ នេះ មិន គោរព បទបញ្ជា ហើយ អនុវត្ត ល្មើស ច្បាប់ បាត់ ទៅ ហើយ ។
បើ តាម លោក នេត សារឿន នៅពេល ឃាត់ខ្លួន លោក ស៊ុំ ពៅ បាន បង្ហាញ លិខិត បេសកកម្ម មួយ សន្លឹក ដែល ចេញ ដោយ ឧត្តមសេនីយ៍ ឯក មាស វណ្ណា ប្រធាន ក្រុមការងារ ស្រាវជ្រាវ យុទ្ធសាស្ត្រ យោធា អនុញ្ញាត ឲ្យ គាត់ ធ្វើដំណើរ តាម រាជធានី - ខេត្ត ចាប់ពី ថ្ងៃទី ០១ ខែមេសា រហូតដល់ ថ្ងៃទី ផុត កំណត់ ទី ៣០ ខែឧសភា ឆ្នាំ ២០២១ ។
សូម បញ្ជាក់ ថា កាលពី យប់ ថ្ងៃទី ២១ ខែ មេសា ឆ្នាំ ២០២១ កម្លាំង នគរបាល ខេត្ត កែប និង ខេត្ត កំពត ក៏ បាន បង្ក្រាប ការរត់ ពន្ធ នាំ ជនជាតិ វៀតណាម ចំនួន ៧ នាក់ ពី ខេត្ត ព្រះសីហនុ ទៅ វៀតណាម ផងដែរ ក្នុង នោះ ជនជាតិ ខ្មែរ ចំនួន ៣ នាក់ ក៏ ត្រូវបាន ចាប់ខ្លួន និង ក សាង សំណុំរឿង បញ្ជូន ទៅ កាន់ តុលាការ ចាត់ វិធានការ តាម ច្បាប់ ៕
លោកគួច ចំរើន ចេញសេចក្តី សម្រេចបិទខ្ទប់ក្រុងព្រះសីហនុ ១៤ ថ្ងៃ ដើម្បីទប់ស្កាត់ការឆ្លងរាលដាលជំងឺកូវីដ
ទោះ យ៉ាងណា ការបិទ ខ្ទប់ នេះ ក៏ មាន ការលើកលែង ចំពោះ ការធ្វើ ដំណើរ ដោយ មូលហេតុ ចាំបាច់ នឹង បន្ទាន់ ផ្សេង ៗ ផងដែរ ដោយ មាន ការអនុញ្ញាត ជា មុន ពី អាជ្ញាធរ មាន សមត្ថកិច្ច ដែល អនុវត្ត វិធានការ បិទ ខ្ទប់ ។
ប៉ុន្តែ បុគ្គល គ្រប់ រូប ត្រូវ អនុវត្ត វិធានការ សុខាភិបាល រួម មាន ការពាក់ ម៉ាស់ និង ការរក្សា គម្លាត សុវត្ថិភាព ព្រមទាំង ប្រកាន់ខ្ជាប់ នូវ ការធ្វើ អនាម័យ ដើម្បី សម្លាប់ មេរោគ និង ការវាស់ កម្តៅ ដើម្បី ប្រយុទ្ធ ប្រឆាំង ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ ។
ចំណែក ប្រការ ៣ នៃ សេចក្តី សម្រេច នេះ បាន ចែង ថា ក្នុង អំឡុង ពេល នៃ ការអនុវត្ត វិធានការ បិទ ខ្ទប់ ត្រូវ បាន ហាមឃាត់ រាល់ ការជួបជុំ និង ការប្រមូលផ្តុំ មនុស្ស លើកលែង តែ ករណី ចាំបាច់ ដូចជា ការជួបជុំ ក្នុង ចំណោម សមាជិក គ្រួសារ ដែល រស់ នៅក្នុង លំនៅឋាន ឬ ទីសំណាក់ អាស្រ័យ ជាមួយ គ្នា ការរៀបចំ ពិធី បុណ្យ សព ដោយ គោរព តាម ការកំណត់ របស់ អាជ្ញាធរ ការជួបជុំ របស់ បុគ្គលិក សុខាភិបាល ដើម្បី យក សំណាក បុគ្គល ដែល ពាក់ព័ន្ធ ដោយ ផ្ទាល់ ជាមួយ អ្នក ឆ្លង កូវីដ និង មូលហេតុ ចាំបាច់ ផ្សេង ៗ ទៀត ។
ក្រៅពី នេះ សេចក្តី សម្រេច ក៏ បាន គូសបញ្ជាក់ ផងដែរ ថា ក្នុង អំឡុង ពេល នៃ ការអនុវត្ត វិធានការ បិទ ខ្ទប់ នេះ ក៏ ត្រូវបាន ហាមឃាត់ រាល់ សកម្មភាព ការងារ មុខរបរ ឬ អាជីវកម្ម ទាំងអស់ ដែល មិន មែន ជា តម្រូវការ ចាំបាច់ ប្រចាំ ថ្ងៃ ផងដែរ ។
យោង តាម សេចក្តី ជូន ដំណឹង របស់ រដ្ឋបាល ខេត្ត ព្រះសីហនុ នៅ ថ្ងៃទី ២២ ខែ មេសា បាន ឱ្យ ដឹង ថា លទ្ធផល វិភាគ វត្ថុ សំណាក នៅ ថ្ងៃទី ២១ ខែ មេសា បាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ចំនួន ៨១ នាក់ ។
ក្នុង ចំណោម អ្នក វិជ្ជមាន កូវីដ ទាំង ៨១ នាក់ នោះ មាន អាជីវករ ផ្សារ លើ ក្រុង ព្រះសីហនុ និង ក្រុមគ្រួសារ ក៏ ដូចជា អ្នក ពាក់ព័ន្ធ ជាមួយ អាជីវករ ដែល ក្នុង នោះ ក៏ មាន ទារក អាយុ ១ ខួប ម្នាក់ ផងដែរ ៕
លោកស ខេង ផ្តល់ថវិកាលើកទឹកចិត្តដល់កងកម្លាំងក្នុងអំឡុង ពេលបិទខ្ទប់រាជធានីភ្នំពេញនិងក្រុង តា ខ្មៅ
លិខិត ផ្ញើ ទៅកាន់ លោក នេត សាវឿន អគ្គ ស្នងការ គរបាល ជាតិ របស់ លោក ស ខេង នៅ ល្ងាច ថ្ងៃទី ២២ ខែ មេសា ឆ្នាំ ២០២១ បាន សរសេរ ថា លោក ឧបត្ថម្ភ នូវ ថវិកា ចំនួន ៣៤៨ ៣២០ ០០០ រៀល ដើម្បី ជា ការលើក ទឹកចិត្ត ដល់ កងកម្លាំង នគរបាល ជាតិ ចំនួន ១ ២៤៤ នាក់ ដែល កំពុង ការពារ តាម គោលដៅ និង ប្រចាំ ការត្រៀម អន្តរាគមន៍ ក្នុង ដំណាក់កាល បិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ក្រុង តា ខ្មៅ នៃ ខេត្ត កណ្តាល ។
ជាមួយ គ្នា នេះ ក្រសួង ព័ត៌មាន បាន ឲ្យ ដឹង កាលពី ថ្ងៃ ២២ មេសា ថា ក្នុង ដំណាក់កាល ដែល ប្រទេស កម្ពុជា កំពុង ទទួលរង នូវ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវី ដ១៩ ចូល ក្នុង សហគមន៍ ដែល តម្រូវ ឱ្យ រាជ រដ្ឋាភិបាល មាន ការបិទ ខ្ទប់ ទីក្រុង ភ្នំពេញ និង ក្រុង តា ខ្មៅ នៃ ខេត្ត កណ្ដាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ នោះ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន និង ភរិយា បាន ចាត់ ឲ្យ តំណាង របស់ លោក នាំយក នូវ អំណោយ ទេយ្យ ទាន មួយចំនួន ធំ ប្រគេន ដល់ ព្រះសង្ឃ ដែល គង់ នៅ គ្រប់ វត្ត ចំនួន ១៤២ វត្ត ក្នុង រាជធានី ភ្នំពេញ ។
ក្រសួង បាន បញ្ជាក់ ថា៖
ជន សង្ស័យក្លែង បន្លំជាឧត្តមសេនីយ៍ឯកយោធាម្នាក់ ត្រូវបានចាប់បញ្ជូនទៅតុលាការយោធា
លោក សូ ឌី ប្រធាន មន្ទីរ យុត្តិធម៌ នៃ ទី បញ្ជាការដ្ឋាន កងរាជ អាវុធហត្ថ ខេត្ត បាត់ដំបង ឲ្យ ដឹង ថា សមត្ថកិច្ច អាវុធហត្ថ បាន ឃាត់ ខ្លួន ជនសង្ស័យ ២ នាក់ នៅ ភូមិ ស្តៅ ឃុំ បាយ ដំរាំ ស្រុក បាណន់ ខេត្ត បាត់ដំបង កាល ពី រសៀល ថ្ងៃទី ២១ មេសា ។
ប៉ុន្តែ ក្រោយ ពី ការ ស្រាវជ្រាវ ឃើញ ថា ម្នាក់ ទៀត មិន ពាក់ព័ន្ធ ទើប ត្រូវ ដោះលែង ទៅ វិញ ។
ជន សង្ស័យ មាន ឈ្មោះ រស់ វណ្ណៈ ភេទ ប្រុស អាយុ ៣៣ ឆ្នាំ មុខ របរ មិន ពិត ប្រាកដ រស់ នៅ ភូមិ តា ងួន សង្កាត់ កាកាប ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ចំណែក ម្នាក់ ទៀត ឈ្មោះ រៃ វណ្ណា សី ភេទ ប្រុស អាយុ ៤០ ឆ្នាំ អ្នក បើកបរ មាន ទីលំនៅ ភូមិ វាល សង្កាត់ គោក ចក ក្រុង សៀមរាប ខេត្ត សៀមរាប ត្រូវ បាន ដោះលែង ។
លោក បាន បន្ត ថា ក្នុង ចំណោម ផ្ទះ ៥២ ខ្នង ដែល រង ការខូចខាត ដោយសារ ភ្លៀង និង ខ្យល់ កន្ត្រាក់ កាលពី ល្ងាច ថ្ងៃទី ២១ ខែមេសា នោះ ភាគ ច្រើន ជា សំណង់ ធ្វើ ពី ឈើ ប្រក់ សង្កសី ដែល សង់ ឡើង មិន ត្រឹមត្រូវ តាម ស្ដង់ដា បច្ចេកទេស ។
ជាមួយ គ្នា នេះ ដំបូល អគារ សាលារៀន ចំនួន ២ ក្នុង សង្កាត់ ទឹក ថ្លា ក្រុង សិរី សោភណ្ឌ ខេត្ត បន្ទាយមានជ័យ ក៏ បាន ប៉ើង របើក រង ការខូចខាត ផងដែរ ។
លោក កែវ វី បាន បន្ត ថា ចំណែក ផ្គរ រន្ទះ ដែល បាន កើតឡើង ក្នុង ពេល មេឃ កំពុង ភ្លៀង កាលពី ល្ងាច ថ្ងៃទី ២១ ខែ មេសា នោះ បាន បណ្ដាល ឲ្យ ងាប់ សត្វ ក្របី ចំនួន ២ ក្បាល របស់ ប្រជាកសិករ ក្នុង ស្រុក បន្ទាយស្រី ខេត្ត សៀមរាប ផងដែរ ។
លោក លឹម គាន ហោ រដ្ឋមន្ត្រី ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ថ្ងៃទី ២១ ខែ មេសា បាន ប្រកាស តាមរយៈ សេចក្ដី ជូនដំណឹង ស្ដីពី ការព្យាករ អាកាសធាតុ លើក ទី ២ សម្រាប់ ឆ្នាំ ២០២១ នេះ ថា ភ្លៀង លាយឡំ ខ្យល់ កន្ត្រាក់ និង ផ្គរ រន្ទះ នឹង កើតមាន កាន់តែ ច្រើន ឡើង ចាប់ពី ដើម រដូវ វស្សា ដែល នឹង ចាប់ផ្ដើម ពី សប្ដាហ៍ ទី ១ នៃ ខែឧសភា ខាងមុខ នេះ ។
មិន តែ ប៉ុណ្ណោះ នៅក្នុង ឆ្នាំ នេះ នឹង មាន ព្យុះ កើតឡើង ក្នុង រង្វង់ ចន្លោះ ពី ២៨ - ៣០ នៅក្នុង មហាសមុទ្រ ប៉ាស៊ីហ្វិក និង អាច មាន មួយចំនួន កើតឡើង ផ្ទាល់ នៅក្នុង សមុទ្រ ចិន ខាងត្បូង ដែល អាច មាន ឥទ្ធិពល ដល់ កម្ពុជា ។
ថ្វីបើ មាន ការ ជូនដំណឹង និង ក្រើនរំឭក អំពី ករណី នេះ ក្ដី ប៉ុន្តែ ប្រជាកសិករ នៅ ខេត្ត ភាគ ពាយព្យ និង ឧត្តរ នៃ ប្រទេស កម្ពុជា ហាក់ដូចជា មិន សូវ យកចិត្ត ទុកដាក់ នោះ ទេ ។
ជាពិសេស ក្នុង កាលៈទេសៈ ដែល ប្រទេស កម្ពុជា កំពុង ប្រឈម នឹង វិបត្តិ រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។
លោក ប៉ក់ អិត ប្រជាកសិករ នៅ ភូមិ - ឃុំ សឿ ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ដោយសារ ប៉ុន្មាន ឆ្មាំ មុន នេះ ដើម រដូវ វស្សា ពុំ មាន ភ្លៀង ធ្លាក់ គ្រប់គ្រាន់ គ្រួសារ របស់ គាត់ ធ្វើ ស្រែ ពុំ សូវ បាន ផល នោះ ទេ ។
ជាមួយ គ្នា នេះ លោក លី យឿន ប្រជាកសិករ នៅ ភូមិ ពាម រមាស ឃុំ ត្រពាំង ប្រីយ៍ ស្រុក អន្លង់ វែង ខេត្ត ឧត្តរមានជ័យ ក៏ បាន ថ្លែង ដែរ ថា៖
លោកស្រី ជូ ប៊ុន អេង រដ្ឋលេខាធិកា ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន អចិន្ត្រៃយ៍ របស់ គណៈកម្មាធិការ ជាតិ ប្រយុទ្ធ ប្រឆាំង ការ ជួញដូរ មនុស្ស ថ្លែង ថា ការ ផ្តល់ ជំនួយ របស់ USAID មក កម្ពុជា នេះ គឺ ជា ការ ទទួល ខុស ត្រូវ រួម របស់ ពិភព លោក ក្នុង ការ ប្រយុទ្ធ ប្រឆាំង ទៅ នឹង ការ ជួញដូរ មនុស្ស ដោយ ប្រទេស ណា មួយ ក៏ មាន សិទ្ធិ ក្នុង ការ ទទួល ជំនួយ នេះ ដែរ ។
លោកស្រី ថា ជំនួយ នេះ មិន មែន ផ្តល់ ឱ្យ ដោយ ត្រង់ មក រដ្ឋាភិបាល នោះ ទេ គឺ ត្រូវ បាន ផ្តល់ ទៅ អង្គការ ក្រៅ រដ្ឋាភិបាល យក ទៅ ប្រើប្រាស់ ក្នុង វិស័យ ណា មួយ ។
ប៉ុន្តែ ទោះបី ប្រើប្រាស់ ក្នុង រូបភាព ណា មួយ ក៏ មិន អាច ប្រើប្រាស់ ខុស ពី គោល នយោបាយ និង ច្បាប់ ដែល កំណត់ រួម គ្នា រវាង រាជ រដ្ឋាភិបាល កម្ពុជា ជាមួយ នឹង អង្គការ ក្រៅ រដ្ឋាភិបាល នោះ ដែរ ។
ក្រសួងសុខាភិបាល អនុញ្ញាតឲ្យសេវាសុខាភិបាលឯកជនទាំងអស់ ប្រើប្រាស់ឧបករណ៍ តេស្ត រហ័ស រកវីរុសកូវីដ១៩
លោក ម៉ម ប៊ុន ហេង បញ្ជាក់ ថា៖
វេជ្ជបណ្ឌិត ១ រូប នៃ គ្លីនិក លី ស្រី វីណា ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ២២ មេសា ថា ខាង គ្លីនិក លោកស្រី មិន ទាន់ មាន តេស្ត នេះ ទេ ។
លោកស្រី ទើបតែ ទទួលបាន ព័ត៌មាន ពី ការអនុញ្ញាត ឲ្យ ប្រើប្រាស់ នូវ ការតេស្ត រហ័ស នេះ ដែរ ។
កាលពី ថ្ងៃទី ១៨ មេសា ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត យុវជន របស់ « សម្តេច តេជោ » បាន ប្រើប្រាស់ នូវ ការតេស្ត រហ័ស នេះ លើ អាជីវករ ផ្សារ នាគ មាស ដោយ ទទួល បាន លទ្ធផល រហ័ស គឺ ត្រឹមតែ រយៈពេល ១៥ នាទី ប៉ុណ្ណោះ ។
បើ តាម លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល ឧបករណ៍ តេស្ត រក វីរុស កូវីដ ១៩ រហ័ស នេះ មាន ភាពងាយស្រួល ក្នុង ការតេស្ត រក មេរោគ បាន លទ្ធផល លឿន ហើយ លទ្ធផល នៃ ការធ្វើ តេស្ត របស់ ឧបករណ៍ នេះ ត្រឹមត្រូវ ដូច ទៅ នឹង ម៉ាស៊ីន ពិសោធន៍ ផងដែរ ។
នៅ ថ្ងៃទី ២២ មេសា ក្រសួង សុខាភិបាល បន្ត រកឃើញ អ្នក ឆ្លង កូវីដ១៩ រហូត ដល់ ៤៤៦ នាក់ ថែម ទៀត ដែល ភាគ ច្រើន នៅ រាជធានី ភ្នំពេញ ។
ទោះ យ៉ាងណា ក៏ មាន អ្នក ព្យាបាល ជាសះស្បើយ ចំនួន ១៣០ នាក់ ផងដែរ ។
សេចក្តី ប្រកាស ព័ត៌មាន របស់ ក្រសួង សុខាភិបាល ឲ្យ ដឹង ថា អ្នក ដែល បាន ឆ្លង ថ្មី ទាំងអស់ នេះ ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ ។
ក្នុង នោះ រកឃើញ នៅ រាជធានី ភ្នំពេញ ចំនួន ៣៣១ នាក់ ខេត្ត ព្រះសីហនុ ចំនួន ៨២ នាក់ ខេត្ត កណ្តាល ២១ នាក់ ខេត្ត តាកែវ ៥ នាក់ ខេត្ត កំពង់ស្ពឺ ២ នាក់ និង ខេត្ត ស្វាយរៀង បន្ទាយមានជ័យ បាត់ដំបង កំពង់ចាម ព្រៃវែង មាន ចំនួន ០១ ករណី ដូច ៗ គ្នា ។
គិត ត្រឹម ព្រឹក ថ្ងៃទី ២២ មេសា សរុប អ្នក ឆ្លង កូវីដ នៅ ទូទាំង ប្រទេស កម្ពុជា មាន ចំនួន ៨ ១៩៣ នាក់ ។
នគរបាលកំពុងតាមស៊ើបអង្កេតលើបុរសម្នាក់ ដែលបានព្យាបាលអ្នកភូមិម្នាក់បណ្ដាលឱ្យស្លាប់
លោក ជា ពឿន ប្រធាន ការិយាល័យ ទទួល ការងារ ផែន ព្រហ្មទណ្ឌ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ធំ កាល ពី ថ្ងៃទី ២១ មេសា បាន ឱ្យ ដឹង ថា ជន រងគ្រោះ ឈ្មោះ ឌាន ឌាង អាយុ ៤១ ឆ្នាំ រី ឯ បុរស ដែល គ្មាន ជំនាញ ពេទ្យ នោះ ឈ្មោះ ហ៊ាន ចំរើន អាយុ ២៣ ឆ្នាំ ពួក គេ ស្នាក់ នៅ ភូមិ - ឃុំ ជា មួយគ្នា ។
លោក ពឿន ថ្លែង ថា៖
ក្រសួងសាធារណការ ផ្ដល់សាជីចរាចរណ៍ និង រនាំងសុវត្ថិភាពសរុប ១ ១០០ ដល់សមត្ថកិច្ចនគរបាល ដើម្បីដាក់តាមគោលដៅត្រួតពិនិត្យ
លោក ហ៊ាង សុទ្ធា យុត្តិ អ្នក នាំ ពាក្យ ក្រសួង សាធារណការ និង ដឹក ជញ្ជូន បាន ប្រាប់ ភ្នំពេញ ប៉ុស្ដិ៍ នៅ ថ្ងៃទី ២២ មេសា នេះ ថា ការ ផ្ដល់ ជូន នូវ សាជី ចរាចរណ៍ និង រនាំង សុវត្ថិភាព ដល់ សមត្ថកិច្ច នគរបាល ជាតិ នា ពេល នេះ គឺ ជា ផ្នែក មួយ នៃ ការ ចូលរួម ចំណែក ក្នុង ការ ពង្រឹង ការ អនុវត្ត វិធានការ ទប់ស្កាត់ ការ រីក រាលដាល នៃ ជំងឺ កូវីដ ១៩ ដែល កំពុង រាតត្បាត ខ្លាំង ក្នុង រាជធានី ភ្នំពេញ និង ក្រុង តា ខ្មៅ ក៏ ដូច បណ្តា ខេត្ត - ក្រុង មួយ ចំនួន ទៀត ។
ការ បិទ ខ្ទប់ ភូមិសាស្ត្រ រាជធានី ភ្នំពេញ និង ក្រុង តា ខ្មៅ ខេត្ត កណ្តា ត្រូវ បាន ប្រមុខ រាជ រដ្ឋាភិបាល សម្រេច អនុវត្ត រយៈពេល ១៤ ថ្ងៃ ដោយ គិត ចាប់ ពី ថ្ងៃទី ១៥ ខែ មេសា ដល់ ថ្ងៃទី ២៨ ខែ មេសា ឆ្នាំ ២០២១ ដើម្បី ធានា ប្រសិទ្ធភាព នៃ ការ គ្រប់គ្រង ការ ឆ្លង រាលដាល នៃ ជំងឺ កូវីដ ១៩ ។
ទាក់ទង នឹង បញ្ហា នេះ លោក សុទ្ធា យុត្តិ បាន លើក ឡើង ថា ដើម្បី ឲ្យ ជីវភាព ប្រចាំ ថ្ងៃ វិល ត្រឡប់ មក រក ប្រក្រតីភាព ឡើង វិញ ទាំង សកម្មភាព សេដ្ឋកិច្ច និង សង្គម ផ្សេង ៗ គឺ តម្រូវ ឲ្យ គ្រប់ ពលរដ្ឋ ទាំង អស់ ចូលរួម គោរព អនុវត្ត តាម ឲ្យ បាន ពេញ លេញ តាម សេចក្ដី សម្រេច របស់ រាជ រដ្ឋាភិបាល ខាង លើ នេះ និង តាម សេចក្ដី ណែនាំ របស់ ក្រសួង សុខាភិបាល ឱ្យ បាន ខ្ជាប់ខ្ជួន ។
ជាពិសេស ត្រូវ ចូលរួម គោរព ច្បាប់ ចរាចណ៍ ផ្លូវ គោក ដោយ ស្តាប់ តាម ការ ណែនាំ របស់ មន្ត្រី នគរបាល ចរាចរណ៍ និង អាជ្ញាធរ មូលដ្ឋាន ផង ដែរ ។
ទាក់ទិន ការ គោរព និង អនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវ គោក លោក ឆាយ គឹម ខឿន អ្នក នាំ ពាក្យ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ សៀល ថ្ងៃ នេះ ថា ក្នុង រយៈពេល ១១២ ថ្ងៃ គិត ចាប់ ពី ថ្ងៃទី ១ ខែ មករា ដល់ ថ្ងៃទី ២២ ខែ មេសា ឆ្នាំ ២០២១ គ្រោះ ថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស បាន កើត ឡើង ៨៨១ លើក បណ្តាល ឲ្យ មនុស្ស ៥០០ នាក់ ស្លាប់ និង ១ ២៥៣ នាក់ ទៀត រង របួស ធ្ងន់ និង ស្រាល ។
លោក បាន ឲ្យ ដឹង ទៀត ថា នៅ ក្នុង យន្តការ រឹត បន្តឹង ការ អនុវត្ត ច្បាប់ ចរាចរណ៍ ក្នុង រយៈពេល ១១២ ថ្ងៃ ដើម ឆ្នាំ នេះ កម្លាំង សមត្ថកិច្ច នគរបាល ជំនាញ បាន ឃាត់ យានយន្ត ដែល ល្មើស ច្បាប់ ចរាចរណ៍ សរុប ចំនួន ៧៣ ៨៥៦ គ្រឿង ក្នុង នោះ ម៉ូតូ ចំនួន ៥៣ ៩៩០ គ្រឿង និង រថយន្ត ចំនួន ១៩ ៨៦៧ គ្រឿង ក្នុង នោះ រថយន្ត តូច ចំនួន ១៥ ៤៩៥ គ្រឿង និង រថយន្ត ធំ ចំនួន ៤ ៣៧២ គ្រឿង ៕
អាជ្ញាធរ ជាតិអប្សរា និងអ្នកជំនាញអាល្លឺម៉ង់ កំពុងជួសជុល អភិរក្សក្បាច់ចម្លាក់នៃកំពូលប្រាសាទអង្គរវត្ត
លោក ឡុង កុសល អ្នក នាំ ពាក្យ អាជ្ញាធរ ជាតិ អប្សរា ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ២២ មេសា ថា ក្នុង ការ ជួសជុល នេះ គឺ មាន ការ លំបាក និង ជួប បញ្ហា ប្រឈម ជាច្រើន ពាក់ព័ន្ធ នឹង អាយុកាល នៃ ថ្ម ប្រាសាទ មាន វ័យ ចំណាស់ និង ទ្រុឌទ្រោម ផង ដែរ ។
លោក ថា ជាមួយ គ្នា នេះ ថ្ម មួយ ចំនួន ទៀត ក៏ ទទួល រង នូវ ការ រេចរិល ដោយសារ កត្តា ពេលវេលា និង ធម្មជាតិ ដែល ធ្វើ ឲ្យ អ្នក ជំនាញ ដែល ជា ជនជាតិ ខ្មែរ ត្រូវ មាន ការ ប្រុងប្រយ័ត្ន ខ្ពស់ និង យក ចិត្ត ទុក ដាក់ យ៉ាង ខ្លាំង ដោយ មិន អាច ចេះ តែ ធ្វើ បាន នោះ ទេ ព្រោះ ថ្ម នៃ តួ ប្រាសាទ មាន អាយុ កាល ច្រើន ឆ្នាំ និង ប្រឈម នឹង ការ ធ្លាក់ ចុះ គុណភាព ដែល ទាមទារ ក្នុង ការ ជួសជុល ត្រូវ ការ ពេល ច្រើន ឆ្នាំ ។
បើ តាម អ្នក នាំ ពាក្យ រូប នេះ កត្តា ប្រឈម ផ្សេង ទៀត គឺ បញ្ហា អាកាសធាតុ និង ទីកន្លែង ក៏ មាន លក្ខណៈ ខ្ពស់ ដែល ពិបាក ក្នុង ការ ជួសជុល អាច ធ្វើ ឲ្យ មាន ភាព យឺតយ៉ាវ ខ្លះ ផង ដែរ ។
ទោះ ជា យ៉ាងណា បញ្ហា នេះ ក៏ មិន អាច បង្អាក់ ដំណើរការ ជួសជុល នោះ ដែរ ។
ក្រុម អ្នក ជំនាញ នឹង ខិតខំ ប្រឹងប្រែង បញ្ចប់ ទៅ តាម ផែនការ ដែល បាន គ្រោង ទុក ។
លោក បញ្ជាក់ ថា មិន ត្រឹម តែ ចំពោះ ការ ជួយ ពី សំណាក់ ប្រទេស អាល្លឺម៉ង់ នោះ ទេ គឺ មាន ប្រទេស ផ្សេង ៗ ទៀត ជាច្រើន ដែល ជា ដៃគូ សហការ ជាមួយ កម្ពុជា ក៏ បាន ជួយ ផង ដែរ ដោយសារ ប្រាសាទ អង្គរ ត្រូវ បាន ដាក់ បញ្ចូល ទៅ ក្នុង បញ្ជី បេតិកភណ្ឌ ពិភព លោក របស់ អង្គការ យូណេស្កូ ។
លោក ឡុង កុសល ថ្លែង ថា៖
តាម របាយការណ៍ របស់ អាជ្ញាធរ ជាតិ អប្សរា ការ ជួសជុល អភិរក្ស ក្បាច់ ចម្លាក់ នៅ កំពូល ប្រាសាទ អង្គរវត្ត បាន ចាប់ ផ្តើម តាំង ពី ពាក់ កណ្តាល ឆ្នាំ ២០១៩ មក ដល់ បច្ចុប្បន្ន អនុវត្ត បាន ប្រមាណ ៤០ ភាគរយ និង គ្រោង បញ្ចប់ នៅ ពាក់ កណ្តាល ឆ្នាំ ២០២៣ ៕
មន្ត្រីយោធាពាក់ផ្កាយ ២ ម្នាក់ត្រូវបានចាប់ខ្លួនពេលកំពុងដឹកជនជាតិចិន ២៨ នាក់ បំពានលើបម្រាមរាជ រដ្ឋាភិបាលក្នុងពេលប្រឆាំងកូវីដ១៩
លោក ម៉ែន វិបុល អភិបាល ខេត្ត ស្វាយរៀង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ឱ្យដឹង ថា សមត្ថកិច្ច ខេត្ត ស្វាយរៀង បាន ឃាត់ខ្លួន មន្ត្រី យោធា រូប នេះ កាលពី យប់ ថ្ងៃទី ២១ ខែមេសា ក្រោយពី មន្ដ្រី យោធា ជាន់ ខ្ពស់ រូប នេះ ត្រូវ បាន បង្ក្រាប ពាក់ព័ន្ធ ការរត់ ពន្ធ ជនជាតិ ចិន ជិត ៣០ នាក់ ពី ភ្នំពេញ ទៅ ស្វាយរៀង ។
លោក វិបុល បាន ថ្លែង ថា៖
ខ្ញុំ មិន ទាន់ បកស្រាយ អ្វី បាន ជុំវិញ ការចាប់ខ្លួន នោះ ទេ ព្រោះ សមត្ថកិច្ច កំពុង ធ្វើ រឿង នេះ មិន ទាន់ ហើយ ផង ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ ថា មន្ត្រី យោធា រូប នោះ ឈ្មោះ ស៊ុ ពៅ ដែល មាន តួនាទី ជា ឧត្ដមសេនីយ៍ ទោ នៃ កងយោធពល ខេរម ភូមិន្ទ បាន នាំ ជនជាតិ ចិន ចំនួន ២៨ នាក់ ធ្វើដំណើរ ឆ្លង ខេត្ត ខុស នឹង បម្រាម របស់ រាជ រដ្ឋាភិបាល ក្នុង ការបិទ ខ្ទប់ ប្រឆាំង នឹង ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
លោក ថា លោក វង្ស ពិសេន អគ្គ មេបញ្ជាការ កងយោធពល ខេរម ភូមិន្ទ បាន បើក ផ្លូវ ឲ្យ សមត្ថកិច្ច ខេត្ដ ស្វាយរៀង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ យ៉ាង ម៉ឺងម៉ាត់ និង មិន ត្រូវ លើកលែង ចំពោះ បុគ្គល ឈ្មោះ ស៊ុ ពៅ ដែល ជា មន្ដ្រី យោធា ផ្កាយ ពីរ មាន តួនាទី ជា អនុប្រធាន ក្រុមការងារ ស្រាវជ្រាវ យុទ្ធសាស្ដ្រ យោធា នៃ អគ្គ បញ្ជាការ ក្រោម ក្រសួង ការពារ ជាតិ ។
យោង តាម សំឡេង ដែល ត្រូវបាន ចែកចាយ តាម បណ្ដាញ សង្គម របស់ លោក វង្ស ពិសេន បាន ឲ្យ ដឹង ថា ករណី នេះ គឺ សមត្ថកិច្ច នឹង អនុវត្ត តាម វិធានការ ច្បាប់ ដោយ មិន មាន ការការពារ នោះ ឡើយ គឺ អនុវត្ត ទៅ តាម បទបញ្ជា របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន និង បើក ផ្លូវ ឲ្យ សមត្ថកិច្ច ខេត្ត ស្វាយរៀង អនុវត្ត ទៅ តាម នីតិវិធី ។
សារ ជា សំឡេង របស់ លោក វង្ស ពិសេន បាន បញ្ជាក់ ថា៖
លោក ស៊ុ ពៅ បាន ទទួល លិខិត បេសកកម្ម មួយ សន្លឹក ដែល ចេញ ដោយ លោក មាស វណ្ណា ប្រធាន ក្រុមការងារ ស្រាវជ្រាវ យុទ្ធសាស្ដ្រ យោធា អនុញ្ញាត ឲ្យ ធ្វើដំណើរ តាម រាជធានី - ខេត្ត ចាប់ពី ថ្ងៃទី ០១ ខែមេសា រហូត ដល់ ថ្ងៃ ផុត កំណត់ ទី ៣០ ខែ ឧសភា ឆ្នាំ ២០២១ ។
ក្រោយ បាន លិខិត បេសកកម្ម មួយ សន្លឹក នេះ លោក ស៊ុ ពៅ បែរ ជា លួច រត់ ពន្ធ ជនជាតិ ចិន ២៨ នាក់ ពី ភ្នំពេញ ទៅ ខេត្ត ស្វាយរៀង ដើម្បី បន្ដ ចេញ ទៅ ក្រៅ ប្រទេស ប៉ុន្ដែ ត្រូវ បាន បង្ក្រាប ដោយ កម្លាំង សមត្ថកិច្ច នគរបាល នៅ ខេត្ត ស្វាយរៀង ។
យោង តាម សារព័ត៌មាន ហ្វ្រេស ញូវ ។
លោក ទេ ព ផល្លា ប្រធាន លេខាធិការ រដ្ឋបាល សាលាដំបូង ខេត្ត ស្វាយរៀង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា សាលាដំបូង ខេត្ត មិន ទាន់ ទទួល បាន សំណុំរឿង នៅឡើយ ទេ រហូត មក ដល់ ពេលនេះ ។
លោក ផល្លា បញ្ជាក់ ថា៖
អ្នកនាំពាក្យ ស្នងការ នគរបាល រាជធានី ភ្នំពេញ លោក សាន សុខ សីហា ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃ នេះ ថា គិត ត្រឹម ថ្ងៃទី ២២ មេសា សមត្ថកិច្ច ក្រុង ភ្នំពេញ បាន ធ្វើ ការ ឃាត់ មនុស្ស សរុប ២៣៦ នាក់ ដែល បាន ល្មើស បម្រាម រាជ រដ្ឋាភិបាល ខណៈ លោក អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ចូលរួម គោរព វិធានការ ទាំងអស់ គ្នា ។
បើ តាម លោក សុខ សីហា ការឃុំ ខ្លួន និង ការពិន័យ អន្តរការណ៍ អាស្រ័យ ទៅ លើ ការប្រព្រឹត្ត របស់ បុគ្គល នីមួយ ។
ក្នុង ចំណោម មនុស្ស ចំនួន ២៣៦ នាក់ ក្នុង នោះ មាន មន្ត្រី នគរបាល ផ្កាយ ពីរ ម្នាក់ និង មន្ត្រី យោធា ផងដែរ ដែល មិន បាន ចូលរួម គោរព តាម វិធានការ ណែនាំ របស់ រាជ រដ្ឋាភិបាល ។
ជាមួយ គ្នា នេះ ដែរ សមត្ថកិច្ច ខេត្ត កំពង់ស្ពឺ កាលពី ថ្ងៃទី ២១ មេសា បាន ធ្វើ ការ ឃាត់ខ្លួន ជនជាតិ ឥណ្ឌូនេស៊ី ចំនួន ១៦ នាក់ ជនជាតិ ខ្មែរ ២ នាក់ ដែល បាន ល្មើស បម្រាម រាជ រដ្ឋាភិបាល ។
ស្នងការ នគរបាល ខេត្ត កំពង់ស្ពឺ លោក សម សាមួយ បាន ថ្លែង ថា៖
រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង យុត្តិធម៌ លោក គឹម សន្តិភាព បាន ថ្លែង ថា វិធានការ ដែល សមត្ថកិច្ច បាន អនុវត្ត នា ពេលនេះ គឺ ដើម្បី ធានា ដល់ សុវត្ថិភាព សុខភាព សាធារណៈ ក៏ ដូចជា លទ្ធផល ដែល បាន គ្រោង ទុក ពោល គឺជា ការកាត់ផ្តាច់ ចរន្ត នៃ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។
ទន្ទឹម នេះ លោក គឹម សន្តិភាព បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ សូម ឱ្យ យោគយល់ និង ចូលរួម គោរព វិធានការ ដែល បាន ដាក់ ចេញ ទាំងអស់ គ្នា ។
ដោយឡែក ទាក់ទង ការអនុវត្ត វិធានការ នៅ តាម បណ្តា ខេត្ត មួយចំនួន សាលាដំបូង ខេត្ត កំពង់ចាម បាន សម្រេច ផ្ដន្ទាទោស បុរស ម្នាក់ ដាក់ ពន្ធនាការ មួយ ឆ្នាំ ដោយ ចោទប្រកាន់ ពី បទ « រារាំង ដល់ ការអនុវត្ត វិធានការ » ដោយ យោង តាម មាត្រា ១១ នៃ ច្បាប់ ស្តីពី វិធានការ ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ និង ជំងឺ ឆ្លង កាច សាហាវ និង ប្រកប ដោយ គ្រោះថ្នាក់ ធ្ងន់ធ្ងរ ផ្សេង ទៀត ខណៈ រដ្ឋបាល ខេត្ត ផ្សេង ទៀត ក៏ បាន ធ្វើ ការ ឃាត់ខ្លួន មនុស្ស ដែល បាន ល្មើស បម្រាម និង ក សាង សំណុំរឿង បញ្ជូន ទៅ តុលាការ ផងដែរ ៕
តាម សេចក្តី ប្រកាស ព័ត៌មាន របស់ USAID បាន ឲ្យ ដឹង នៅ ថ្ងៃ នេះ ថា ឧបករណ៍ នេះ នឹង ផ្សារភ្ជាប់ ពលរដ្ឋ ទៅនឹង សេវា នានា ដែល ផ្ដល់ ដោយ ការិយាល័យ ច្រក ចេញ ចូល តែ មួយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា និង ជា ឧបករណ៍ ស្រដៀង គ្នា ដែល បាន ដាក់ ឱ្យ ប្រើប្រាស់ នៅ ខេត្ត បាត់ដំបង ក្នុង ឆ្នាំ ២០២០ ។
សេចក្តី ប្រកាស នេះ បាន បញ្ជាក់ ពី តួនាទី របស់ កម្មវិធី នេះ យ៉ាង ដូច្នេះ ថា ១ - ការទទួល បាន ព័ត៌មាន ស្តីពី ដំណើរការ ដាក់ពាក្យ ស្នើសុំ លម្អិត ពី ឯកសារ ដែល ត្រូវការ ថ្លៃ សេវា និង បទដ្ឋាន រយៈពេល នៃ ការប្រគល់ ត្រឡប់ មកវិញ ។
២ - ជា យន្តការ មាន សុវត្ថិភាព មួយ សម្រាប់ អ្នកប្រើប្រាស់ ក្នុង ការផ្តល់ យោបល់ អំពី គុណភាព សេវាកម្ម ដែល ពួកគេ បាន ទទួល នៅ ការិយាល័យ ច្រក ចេញ ចូល តែ មួយ ។
ការដាក់ ឱ្យ ប្រើប្រាស់ ឧបករណ៍ របស់ គម្រោង OW4C នៅ ខេត្ត កំពង់ឆ្នាំង គឺជា ការកសាងឡើង បន្ថែម លើ ជោគជ័យ នៃ គម្រោង ដែល បាន បង្កើត សមិទ្ធផល ដ៏ វិជ្ជមាន នៅក្នុង ខេត្ត បាត់ដំបង កាលពី ខែ សីហា ឆ្នាំ ២០២០ ។
នេះ បើ តាម ការអះអាង ក្នុង សេចក្តី ប្រកាស ព័ត៌មាន ដដែល ។
គិត មកដល់ ពេល នេះ ផ្សារ ជាង ៣០ កន្លែង ហើយ ត្រូវបាន បិទ ផ្អាក ក្នុង នោះ មាន ទាំង ផ្សារ ធំ ៗ ចំនួន ពីរ ក្នុង រាជធានី ភ្នំពេញ ក៏ ត្រូវ បាន បិទ ផ្អាក បណ្តោះអាសន្ន ផងដែរ គឺ ផ្សារ អូឡាំពិក និង ផ្សារ អូរឫស្សី ។
លោក ធីម សំអាន អភិបាល ខណ្ឌ បឹងកេងកង បាន ថ្លែង ឱ្យ ដឹង ថា ផ្សារ អូឡាំពិក បាន បិទ ផ្អាក ជា បណ្តោះអាសន្ន ចាប់ពី ថ្ងៃទី ២១ ខែមេសា នេះ ។
ជាមួយ គ្នា នេះ លោក ធីម សំអាន ក៏ បាន អំពាវនាវ ដល់ អាជីវករ សន្តិសុខ បុគ្គលិក កម្មករ បម្រើ ការងារ ក្នុង ផ្សារ នេះ ចាប់ពី ថ្ងៃ ០៨ ខែ មេសា ដល់ ថ្ងៃទី ១៤ ខែមេសា ឆ្នាំ ២០២១ បើ មាន អាការៈ សង្ស័យ ណាមួយ ត្រូវ ទៅ យក សំណាក ធ្វើតេស្ត រក មេរោគ កូវីដ១៩ ជា បន្ទាន់ នៅ បរិវេណ សាល មហោស្រព ចេនឡា ។
នៅ ថ្ងៃ ម្សិលមិញ នេះ ដែរ អភិបាល ខណ្ឌ សែន សុខ លោក ម៉ូវ ម៉ានិត ក៏ បាន ផ្អាក ជា បណ្តោះអាសន្ន ផ្សារ ពិភព ថ្មី ឈូក មាស ផ្សារ រីករាយ និង អាជីវករ ទាំងអស់ ដែល លក់ដូរ នៅ ជុំវិញ ស្ថិត ក្នុង សង្កាត់ ក្រាំង ធ្នង់ និង សង្កាត់ គោក ឃ្លាង ផងដែរ ។
នៅក្នុង ខេត្ត កំពង់ឆ្នាំង ទីតាំង ចំនួន ៣ ក៏ ត្រូវ បាន ផ្អាក ផងដែរ ក្នុង នោះ មាន វត្ត ទួល សន្ធាសត្ថា រាម ផ្សារ ព្រៃ ខ្មែរ និង មន្ទីរ សម្រាក ព្យាបាល ផ្សារ ឆ្នាំង ដែល ទីតាំង ទាំង ២ នេះ ស្ថិត ក្នុង ក្រុង កំពង់ឆ្នាំង និង ស្រុក រលាប្អៀរ ។
លោក ឈួរ ច័ន្ទ ឌឿន អភិបាល ខេត្ត កំពង់ឆ្នាំង បាន ឱ្យ ដឹង ថា ការបិទ ជា បណ្តោះអាសន្ន នូវ ទីតាំង ៣ កន្លែង នេះ គឺ ដើម្បី ទប់ស្កាត់ ការរាលដាល ជំងឺ កូវីដ១៩ បន្ទាប់ពី រដ្ឋបាល ខេត្ត បាន រកឃើញ អ្នក វិជ្ជមាន កូវីដ១៩ ម្នាក់ នៅក្នុង ឃុំ ជ្រៃ បាក់ ស្រុក រលាប្អៀរ កាលពី ថ្ងៃទី ១៩ ខែមេសា កន្លងមក ។
នៅក្នុង ខេត្ត ព្រះសីហនុ មកដល់ ពេល នេះ ផ្សារ ចំនួន ១ បន្ថែម ទៀត ត្រូវបាន បិទ ផ្អាក គឺ ផ្សារ ពាណិជ្ជកម្ម ស្ថិត ក្នុង សង្កាត់ លេខ ២ ក្រុង ព្រះសីហនុ បន្ទាប់ពី ផ្សារ ចំនួន ២ បាន ផ្អាក កាលពី ថ្ងៃទី ២០ ខែមេសា ។
លោក ឃាង ភារម្យ អ្នកនាំពាក្យ សាលា ខេត្ត ព្រះសីហនុ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃ ព្រហស្បតិ៍ ទី ២២ ខែមេសា ថា សម្រាប់ ខេត្ត ព្រះសីហនុ ពាក់ព័ន្ធ នឹង ការបិទ ខ្ទប់ មកដល់ ពេល នេះ មាន ភូមិ ចំនួន ២ គឺ ភូមិ ៣ ( មួយ ផ្នែក ) ក្នុង តំបន់ ទំនប់ រលក សង្កាត់ លេខ ១ និង ភូមិ ភ្នំ តូច ក្នុង ឃុំ បឹង តាព្រំ ស្រុក ព្រៃ នប់ ។
ចំណែក នៅ ខាង ខេត្ត ព្រៃវែង វិញ អភិបាល ខេត្ត លោក ជា សុមេធី បាន ប្រកាស ផ្អាក បណ្តោះអាសន្ន នូវ ការចរាចរណ៍ ចេញ ចូល ក្នុង ភូមិ សាស្ត្រ ឃុំ ពោធិ៍ ទី ក្នុង ស្រុក ស៊ីធរ កណ្តាល ចាប់ពី ថ្ងៃទី ២១ ខែមេសា ត ទៅ ។
លោក ជា សុមេធី ថ្លែង ថា គិត មក ទល់ ពេលនេះ ស្រុក ស៊ីធរ កណ្តាល មាន អ្នក វិជ្ជមាន ជំងឺ កូវីដ១៩ ចំនួន ០៥ នាក់ ហើយ ដោយសារ ស្ថានភាព រីករាលដាល នៃ ជំងឺ កូវីដ១៩ នៅ តែ បន្ត កើនឡើង ជា លំដាប់ និង ដើម្បី កាត់ផ្តាច់ នូវ ការចម្លង នេះ បន្ត ទៀត រដ្ឋបាល ខេត្ត បាន ផ្អាក បណ្តោះអាសន្ន នូវ ការ ចេញ - ចូល ក្នុង ភូមិ សាស្ត្រ ឃុំ ពោធិ៍ ទី ចាប់ពី ថ្ងៃទី ២១ ខែ មេសា ឆ្នាំ ២០២១ នេះ ត ទៅ ។
សម្រាប់ ខេត្ត បាត់ដំបង ក៏ មាន ការបិទ ខ្ទប់ ផងដែរ នូវ ភូមិ ខ្នាច រំពេរ ក្នុង ឃុំ ព្រែក ជីក ស្រុក រុក្ខគិរី ដែល ជា តំបន់ មាន ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តិការណ៍ សហគមន៍ លើក ទី ៣ នេះ ។
លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង បាន ឱ្យដឹង ថា ការបិទ ខ្ទប់ នេះ មាន រយៈពេល ១៤ ថ្ងៃ ដោយ គិត ចាប់ពី ថ្ងៃទី ២២ ខែមេសា ដល់ ថ្ងៃទី ០៥ ខែឧសភា ក្នុង គោលបំណង ធានា ដល់ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង រាលដាល នៃ ជំងឺ កូវីដ១៩ នៅ ភូមិសាស្ត្រ ដែល ត្រូវបាន បិទ ខ្ទប់ នេះ ។
គួរ បញ្ជាក់ ផងដែរ ថា គិត សរុប មក ដល់ ពេល នេះ ផ្សារ ចំនួន ៣៥ ហើយ ដែល ត្រូវបាន បិទ ផ្អាក បណ្តោះអាសន្ន ដែល ក្នុង នោះ មាន នៅក្នុង រាជធានី ភ្នំពេញ ខេត្ត កណ្តាល ខេត្ត ព្រះសីហនុ ខេត្ត កំពង់ឆ្នាំង ខេត្ត បាត់ដំបង និង កំពង់ស្ពឺ ។
សម្រាប់ រាជធានី ភ្នំពេញ មាន ផ្សារ ចំនួន ១៤ គឺ មជ្ឈមណ្ឌល ពាណិជ្ជកម្ម ផ្សារ អូរឫស្សី ផ្សារ ដើម គរ និង ផ្សារ បន្លែ ផ្សារ ចាស់ ផ្សារ ធំ ទួល សង្កែ ផ្សារ បឹងត្របែក ផ្លាហ្សា ផ្សារ ត្រពាំង ថ្លឹង ផ្សារ ឯករាជ្យ១ ផ្សារ ទួល ពង្រ ផ្សារ សេន ជូរី ផ្លាហ្សា ផ្សារ ពោធិ៍ ចិន តុង ផ្សារ កណ្ដាល ផ្សារ ដេប៉ូ ផ្សារ ពិភព ថ្មី ឈូក មាស និង ផ្សារ រីករាយ និង ផ្សារ អូឡាំពិក ៕
បុរសខ្មែរម្នាក់ដែលលួចដឹកជនជាតិវៀតណាម ៧ នាក់ គេចចេញពីគោលដៅបិទខ្ទប់ត្រូវចាប់បញ្ជូនទៅតុលាការ
លោក ប៉ូង សុខេង ស្នងការ រង ទទួល ការងារ ផែន ព្រហ្មទណ្ឌ ខេត្ត កែប បាន ប្រាប់ នៅ ថ្ងៃទី ២២ មេសា នេះ ថា បុរស សង្ស័យ ឈ្មោះ សាន គៀន អាយុ ៣៧ ឆ្នាំ ជា អ្នក បើកបរ រថយន្ត តាក់ស៊ី រស់ នៅ ភូមិ កំពង់ ដូង ឃុំ កំពង់ត្នោត ស្រុក ឈូក ខេត្ត កំពត ។
ចំពោះ ជនជាតិ វៀតណាម ទាំង ៧ នាក់ ដោយ អនុវត្ត តាម បទបញ្ជា ពី អយ្យការ អម សាលា ដំបូង ខេត្ត កែប គឺ ត្រូវ ផាក ពិន័យ អន្តរកាល តាម ច្បាប់ ស្តីពី វិធានការ ទប់ស្កាត់ ជំងឺ កូវីដ ១៩ ដោយ ពិន័យ ចន្លោះ ពី ១ លាន ទៅ ៥ លាន រៀល ហើយ ត្រូវ បញ្ចូ ន ទៅ មណ្ឌល ចត្តាឡី ស័ក ១៤ ថ្ងៃ ។
នៅ ថ្ងៃ នេះ ភ្នំពេញ ប៉ុស្តិ៍ បាន ទាក់ទង ទៅ លោក ហ៊ុន ឌី ស្នងការ រង ទទួល ការងារ ផែន អន្តោប្រវេសន៍ ខេត្ត កែប តែ មិន អាច ទាក់ទង បាន ។
ប៉ុន្តែ បើ តាម មន្រ្តី នគរបាល មួយ រូប ដែល សុំ មិន បញ្ចេញ ឈ្មោះ បាន ថ្លែង ថា ក្រុម ជនជាតិ វៀតណាម ប្រុស - ស្រី ទាំង ៧ នាក់ ក្រោយ ពី ធ្វើ ចត្តាឡី ស័ក រួច នឹង ត្រូវ បណ្តេញ ចេញ ពី ប្រទេស កម្ពុជា ទៅ ប្រទេស វៀតណាម វិញ ។
មនុស្ស ២ នាក់ស្លាប់ និង ២ នាក់ទៀត របួសធ្ងន់ ដោយសារផ្ទុះគ្រាប់ សល់ពីសម័យសង្គ្រាម
ត្បូងឃ្មុំ / ឧត្តរមានជ័យ៖
មនុស្ស ២ នាក់ ស្លាប់ និង ២ នាក់ ទៀត រង របួស ធ្ងន់ ដោយសារ ផ្ទុះ គ្រាប់ យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ សល់ ពី សម័យ សង្គ្រាម ចំនួន ២ ករណី ផ្សេង គ្នា ស្ថិត នៅ ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត ឧត្តរមានជ័យ កាល ពី ថ្ងៃទី ២១ មេសា ។
ក្រោយ កើត ហេតុ សាច់ញាតិ បាន បញ្ជូន ជន រងគ្រោះ ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត ត្បូងឃ្មុំ ។
ប៉ុន្តែ ដោយសារ របួស ធ្ងន់ ជន រងគ្រោះ ម្នាក់ ឈ្មោះ ពឿន ពៅ ភេទ ប្រុស អាយុ ១២ ឆ្នាំ បាន ស្លាប់ ក្រោយ ពី បញ្ជូន ទៅ មន្ទីរពេទ្យ ។
ចំណែក ឈ្មោះ ម៉ុត សំណាង ភេទ ប្រុស អាយុ ២៩ ឆ្នាំ របួស ធ្ងន់ ដាច់ ប្រអប់ ដៃ ស្តាំ ត្រូវ បាន បញ្ជូន ទៅ សង្គ្រោះ នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ចាម និង ឈ្មោះ បេ គួយ របួស ស្រាល ត្រូវ បាន បញ្ជូន ទៅ ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ស្រុក តំបែរ ។
របាយការណ៍ របស់ សមត្ថកិច្ច បញ្ជាក់ ថា៖
បើ តាម របាយការណ៍ របស់ អាជ្ញាធរ ជន រងគ្រោះ ឈ្មោះ សោន សាវឿន ភេទ ប្រុស អាយុ ៥៣ ឆ្នាំ រស់ នៅ ភូមិ អូរ ខ្មៅ សង្កាត់ កូន ក្រៀល ក្រុង សំរោង ខេត្ត ឧត្តរមានជ័យ បាន យក គ្រាប់ យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ ទៅ កែច្នៃ ហើយ បាន ផ្ទុះ ស្លាប់ នៅ ចំណុច ខ្ទម ចាំ ចម្ការ របស់ ខ្លួន ស្ថិត នៅ ភូមិ ត្រពាំង ទូង សង្កាត់ កូន ក្រៀល ក្រុង សំរោង ខេត្ត ឧត្តរមានជ័យ ។
អាជ្ញាធរ អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទាំង អស់ នៅ ពេល ឃើញ គ្រាប់ មីន និង គ្រាប់ យុទ្ធភណ្ឌ មិន ទាន់ ផ្ទុះ សូម កុំ ប៉ះពាល់ ដំ គប់ លេង ឬ កែច្នៃ ផ្សេង ៗ វា អាច បណ្តាល ឲ្យ ផ្ទុះ ស្លាប់ របួស ពិការ គ្រប់ ពេល និង សូម រាយការណ៍ ទៅ អាជ្ញាធរ មូលដ្ឋាន និង ប្រតិបត្តិករ បោស សំអាត មីន ដែល នៅ ជិត ទីនោះ ដើម្បី យក គ្រាប់ ទាំង នោះ ទៅ កម្ទេច ចោល ៕
ថ្ងៃនេះ រកឃើញអ្នកឆ្លងកូវីដ ចំនួន ៤៤៦ នាក់បន្ថែមទៀត ខណៈអ្នក ជា សះស្បើយចំនួន ១៣០ នាក់
អ្នក ដែល បាន ឆ្លង ថ្មី ទាំង អស់ នេះ ពាក់ព័ន្ធ នឹង ព្រឹតិ្តការណ៍ សហគមន៍ ២០ កុម្ភៈ ដែល ក្នុង នោះ រក ឃើញ នៅ រាជធានី ភ្នំពេញ ចំនួន ៣៣១ នាក់ ខេត្ត ព្រះសីហនុ ៨២ នាក់ ខេត្ត កណ្ដាល ២១ នាក់ ខេត្ត តាកែវ ៥ នាក់ ខេត្ត កំពង់ស្ពឺ ២ នាក់ និង ខេត្ត ស្វាយរៀង បន្ទាយមានជ័យ បាត់ដំបង កំពង់ចាម ព្រៃវែង មាន ចំនួន ០១ ករណី ដូច ៗ គ្នា ។
សាលាក្រុង អនុញ្ញាតឱ្យខណ្ឌនីមួយ ៗចេញ បណ្ណជូនពលរដ្ឋនៅក្រៅតំបន់ក្រហម ដើម្បីអាចទៅរកទិញទំនិញប្រើប្រាស់
អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃ នេះ ថា ដើម្បី បង្ក លក្ខណៈ ងាយ ស្រួល ដល់ ពលរដ្ឋ ក្នុង ការ ចេញ ក្រៅ ទិញ ម្ហូប អាហារ គឺ អាជ្ញាធរ ភ្នំពេញ បាន អនុញ្ញាត ឱ្យ តាម បណ្តា ខណ្ឌ នីមួយ ៗ អាច ចេញ បណ្ណ ធ្វើ ដំណើរ ទៅ ផ្សារ ជូន ពលរដ្ឋ ដែល នៅ ក្រៅ តំបន់ ក្រហម បាន ប៉ុន្តែ ក៏ អាស្រ័យ លើ ស្ថានភាព ជាក់ ស្តែង ក្នុង តំបន់ នោះ ផង ដែរ ។
ទាក់ទង ទៅ នឹង តំបន់ ក្រហម វិញ អ្នក នាំ ពាក្យ សាលា រាជធានី ភ្នំពេញ លោក ម៉េត មាស ភក្តី បាន ថ្លែង ថា អាជ្ញាធរ នឹង មិន ចេញ បណ្ណ ធ្វើ ដំណើរ ទៅ ផ្សារ ជូន ដល់ ពលរដ្ឋ ដែល ស្ថិត នៅ ក្នុង តំបន់ ហានិភ័យ ខ្លាំង នោះ ទេ ។
យ៉ាង ណា ក៏ ដោយ នៅ តំបន់ ក្រហម នេះ កាល ពី ថ្ងៃទី ២១ មេសា ក្រសួង ពាណិជ្ជកម្ម បាន ដំឡើង ស្តង់ លក់ គ្រឿង ឧបភោគ បរិភោគ ចាំបាច់ មួយ ចំនួន នៅ ទីនោះ ដើម្បី សម្រួល ដល់ ពលរដ្ឋ ទទួល បាន ម្ហូប អាហារ ចាំបាច់ ដែល ទំនិញ ទាំង នោះ រួម មាន អង្ករ ទឹកត្រី ទឹក ស៊ីអ៊ីវ ត្រីខ កំប៉ុង និង មី ជាដើម ។
ក្រសួង នេះ បាន បញ្ជាក់ ថា៖
សូម ជម្រាប ថា កាល ពី យប់ ថ្ងៃទី ១៤ ខែ មេសា រាជ រដ្ឋាភិបាល បាន ចេញ សេចក្តី សម្រេច ស្តីពី ការ បិទ ខ្ទប់ ភូមិសាស្រ្ត រាជធានី ភ្នំពេញ និង ក្រុង តា ខ្មៅ នៃ ខេត្ត កណ្តាល ជា បណ្តោះ អាសន្ន ក្នុង រយៈពេល ២ សប្ដាហ៍ ដោយ ចាប់ អនុវត្ត ពី ថ្ងៃ ១៥ មេសា រហូត ដល់ ថ្ងៃទី ២៨ មេសា ២០២១ ដើម្បី ធានា ប្រសិទ្ធភាព នៃ ការ គ្រប់គ្រង ការ ឆ្លង រាលដាល ជំងឺ កូវីដ ១៩ នៅ ក្នុង ភូមិសាស្ត្រ ទាំង ២ នេះ ៕
មេ ដឹកនាំវៀតណាមថា វៀតណាមតែងតែយក ចិត្តទុកដាក់ចំពោះកម្ពុជា ខណៈកម្ពុជាកំពុងប្រឈមនឹងជំងឺកូវីដ ១៩
លោក ង្វៀន ហ៊្វូ ចុង អគ្គ លេខាធិការ នៃ គណៈកម្មាធិការ មជ្ឈឹម បក្ស កុម្មុយនីស្ត វៀតណាម ថ្លែង ក្នុង លិខិត សួរ សុខ ទុក្ខ ផ្ញើ ជូន លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ថា៖
សភាពការណ៍ នៃ ជំងឺ កូវីដ ១៩ នៅ តែ បន្ត ប្រព្រឹត្ត ទៅ យ៉ាង ស្មុគស្មាញ លើ ពិភព លោក ទាំង មូល ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ សុខភាព មនុស្ស ជះ ឥទ្ធិពល យ៉ាង ជ្រាលជ្រៅ និង គ្រប់ ជ្រុងជ្រោយ ដល់ គ្រប់ វិស័យ នៃ ជីវភាព រស់ នៅ ខាង សេដ្ឋកិច្ច សង្គមកិច្ច របស់ បណ្តា រដ្ឋ ក្នុង នោះ មាន វៀតណាម និង កម្ពុជា ។
មក ដល់ បច្ច ប្បន្ន ទោះបី នៅ មាន ភាព ស្មុគស្មាញ ជា ច្រើន ប៉ុន្តែ ជា មូលដ្ឋាន គឺ វៀតណាម គ្រប់គ្រង បាន នូវ ការ រីក រាលដាល នៃ ជំងឺ នេះ ។
លោក ង្វៀន ហ៊្វូ ចុង បញ្ជាក់ ថា៖
ជាមួយ គ្នា នេះ លោក ក៏ បាន ថ្លែង អំណរគុណ ដល់ គណបក្ស ប្រជាជន កម្ពុជា រដ្ឋាភិបាល កម្ពុជា ដែល បាន ចាក់ វ៉ាក់សាំង « កម្មាភិបាល បណ្តា ស្ថាប័ន តំណាង របស់ វៀតណាម និស្សិត និង ជួយ ឧបត្ថម្ភ សហគមន៍ ជនជាតិ វៀតណាម » នៅ កម្ពុជា ក្នុង ការ បង្ការ និង ប្រឆាំង ជំងឺ នេះ ផង ដែរ ។
ជា ការ ឆ្លើយ ត ប លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន សរសេរ សារ លិខិត ជូន លោក ង្វៀន ហ៊្វូ ចុង ដោយ ថ្លែង អំណរ គុណ ចំពោះ បក្ស រដ្ឋ និង ប្រជាជន វៀតណាម ដែល តែងតែ យក ចិត្ត ទុក ដាក់ ដល់ ការ ថែរក្សា នូវ ចំណង មិត្តភាព សាមគ្គីភាព និង រួម សុខ រួម ទុក្ខ ជាមួយ គ្នា នៅ គ្រប់ កាលៈទេសៈ ទាំង អស់ ។
លោក ហ៊ុន សែន ថ្លែង ថា នៅ កម្ពុជា ទោះបី ជា វា មិន ទទួល ជោគជ័យ ក្នុង ការ ទប់ស្កាត់ ជំងឺ កូវីដ ១៩ បាន ស្ទើរ ពេញ ១ ឆ្នាំ ២០២០ ក៏ សង្គ្រាម ប្រឆាំង នឹង ជំងឺ ដ៏ កាច សាហាវ នេះ កំពុង វិវឌ្ឍន៍ មក ដល់ ដំណាក់កាល ថ្មី ដែល ស្មុគស្មាញ ។
ជា ពិសេស ក្រោយ ការ ផ្ទុះ ព្រឹត្តិការណ៍ សហគមន៍ ២០ កុម្ភៈ ។
ទន្ទឹម នឹង នេះ រដ្ឋាភិបាល វៀតណាម បាន ផ្តល់ ជំនួយ សប្បុរសធម៌ ជា ថវិកា ចំនួន ៣០០ ០០០ ដុល្លារ អាមេរិក ដល់ រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា កាល ពី ថ្ងៃទី ២០ មេសា ។
យោង តាម សេចក្តី ប្រកាស ព័ត៌មាន របស់ ក្រសួង ការបរទេស រាជ រដ្ឋាភិបាល និង ប្រជាជន កម្ពុជា បាន ថ្លែង អំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន វៀតណាម ដែល បាន ផ្តល់ នូវ ជំនួយ ជា បន្តបន្ទាប់ ដើម្បី ចូលរួម ចំណែក ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង ក្នុង ការ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ ១៩ នៅ កម្ពុជា ៕
នាយកដ្ឋានប្រឆាំងបទល្មើសបច្ចេកវិទ្យា ប្រាប់ពលរដ្ឋឲ្យប្រុងប្រយ័ត្ន ចំពោះល្បិច កលបោកប្រាស់មួយចំនួន
ល្បិច ទាំងនោះ មាន ជា រូបភាព ការជួយ ឧបត្ថម្ភ ថវិកា ឬ ម្ហូប អាហារ ការផ្ដល់ ប្រាក់ កម្ចី ងាយ ៗ ឬ បន្លំ ជា អាជ្ញាធរ មន្ត្រី មន្ទីរពេទ្យ ហើយ ទាមទារ ឱ្យ បង់ប្រាក់ ដើម្បី ជួយ ឧបត្ថម្ភ ឬ ជួយសង្គ្រោះ ។
លោក ជា ពៅ ប្រធាន នាយកដ្ឋាន ប្រឆាំង បទល្មើស បច្ចេកវិទ្យា បាន ឲ្យ ដឹង ថា ក្នុង ពេល ប្រជាពលរដ្ឋ កំពុង មាន ការព្រួយបារម្ភ យ៉ាង ខ្លាំង នឹង ការរាតត្បាត ពី ជំងឺ កូវីដ១៩ ក៏ មាន ជន ខិលខូច មួយចំនួន បាន កំពុង រិះរក ល្បិច កល ដើម្បី បោកប្រាស់ ប្រជាពលរដ្ឋ ដោយ បន្លំ ក្រោម រូបភាព ផ្សេង ៗ ជាច្រើន ។
ចំណែក វិធី មួយ ទៀត គឺ គេ ក្លែងបន្លំ ជា អាជ្ញាធរ ឬ មន្ត្រី មន្ទីរពេទ្យ ហើយ ទាមទារ ឱ្យ បង់ប្រាក់ ដើម្បី ជួយ ឧបត្ថម្ភ ឬ ជួយសង្គ្រោះ បងប្អូន ។
លោក ជា ពៅ បញ្ជាក់ ថា ការប្រកាស ប្រាប់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន បែប នេះ មិន មែន មាន ន័យ ថា សកម្មភាព នោះ បាន កើតឡើង ហើយ ទើប ធ្វើ ការ ប្រកាស ប្រាប់ ពលរដ្ឋ នោះ ទេ ។
លោក ថា នេះ ជា ការពញ្ញាក់ ស្មារតី ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ជាមុន ដើម្បី កុំ ឲ្យ ចាញ់ ការឆ បោក ដែល នាំឲ្យ ខាតបង់ ពេលវេលា និង ទ្រព្យសម្បត្តិ ។
ធ្វើ ការ ពិនិត្យ ឱ្យ បាន ច្បាស់លាស់ មុននឹង ផ្ដល់ ព័ត៌មាន ផ្ទាល់ខ្លួន ទាក់ទង នឹង ការឧបត្ថម្ភ ម្ហូប អាហារ ឬ ការឧបត្ថម្ភ ផ្សេង ៗ ទៀត ដើម្បី ចៀសវាង កុំ ឱ្យ ជន ខិលខូច អាច យក ទិន្នន័យ ទាំងនេះ ទៅ ធ្វើ ការ បោក បញ្ឆោត នៅពេល ក្រោយ ។
ក្នុង ករណី ដែល មាន ការពាក់ព័ន្ធ នឹង ការផ្ដល់ សេវា សុខាភិបាល សូម ទូរស័ព្ទ ទៅ លេខ ១១៥ ឬ ទំនាក់ទំនង ទៅ អាជ្ញាធរ មូលដ្ឋាន ដើម្បី សួរនាំ បន្ថែម ឬ បញ្ជាក់ ពី ព័ត៌មាន ទាំងនោះ » ។
លោក ស៊ឹង សីហា ប្រជាពលរដ្ឋ ម្នាក់ រស់ នៅ សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែន សុខ បាន ឲ្យ ដឹង ថា តាមរយៈ ការប្រើប្រាស់ បណ្តាញ សង្គម ហ្វេសប៊ុក លោក សង្កេត ឃើញ ថា មាន ករណី បង្ហោះ បោក បញ្ឆោត ដោយ ដាក់ លុយ ធ្វើជា នុយ ច្រើន បែប ច្រើន យ៉ាង លើ បណ្តាញ សង្គម ហ្វេសប៊ុក ។
លោកអភិបាលខេត្តមណ្ឌលគិរី បានជំរុញឱ្យមន្ត្រីជំនាញពន្លឿនការ សាងសង់ស្ពាន និងផ្លូវទៅ កាន់ច្រកព្រំដែនទ្វេភាគីណា ម លៀរ ( កម្ពុជា - វៀតណាម )
ក្នុង ឱកាស ចុះ ពិនិត្យ មើល ការ ស្ថាបនា ស្ពាន និង ផ្លូវ ឆ្ពោះ ទៅ ច្រក ទ្វារ ព្រំដែន ទ្វេ ភាគី ណា ម លៀរ ក្នុង ស្រុក ពេជ្រា ដា លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី បាន ជំរុញ ឲ្យ មន្ត្រី ជំនាញ យក ចិត្ត ទុក ដាក់ និង ពន្លឿន ការ សាងសង់ ស្ពាន និង ផ្លូវ មួយ ខ្សែ នេះ ឲ្យ បាន ទាន់ ពេលវេលា ដើម្បី ជួយ សម្រួល ដល់ ការ ធ្វើ ដំណើរ ក៏ ដូចជា ការ ដឹក កសិផល នានា របស់ ប្រជាពលរដ្ឋ ឲ្យ កាន់ តែ មាន លក្ខណៈ ល្អ ប្រសើរ ។
មន្ទីរ ជំនាញ ត្រូវ យក ចិត្ត ទុក ដាក់ ស្ថាបនា ស្ពាន និង ផ្លូវ នេះ ឲ្យ សម ស្រប តាម ស្តង់ដា និង លក្ខណៈ បច្ចេកទេស ដើម្បី ធ្វើ យ៉ាង ណា ឲ្យ មាន គុណភាព ក្នុង ការ ប្រើប្រាស់ ឲ្យ បាន យូរ អង្វែង » ។
ក្រៅ ពី ជំរុញ មន្ត្រី ជំនាញ លោក ស្វាយ សំអ៊ាង ក៏ ស្នើ ឲ្យ ប្រជាពលរដ្ឋ ទាំង អស់ ត្រូវ ចូលរួម សហការ ជាមួយ មន្ទីរ ជំនាញ និង អាជ្ញាធរ មូលដ្ឋាន ដើម្បី ធ្វើ យ៉ាង ណា ឲ្យ ដំណើរការ សាងសង់ ស្ពាន និង ផ្លូវ នេះ ឲ្យ ទទួល បាន ជោគជ័យ ខណៈ លោក ចាត់ ទុក សមិទ្ធផល ទាំង នេះ គឺ ជា សរសៃ ឈាម របស់ ប្រជាពលរដ្ឋ នៅ ក្នុង ខេត្ត ក៏ ដូច ជា ភ្ញៀវ ទេសចរ ដែល ម ក ទស្សនា កម្សាន្ត នៅ តាម រមណីយដ្ឋាន និង ខ្សែ ក្រវាត់ ព្រំដែន ផង ដែរ ។
នេះ បើ តាម លោក រស់ គីម ធន ប្រធាន មន្ទីរ សាធារណការ និង ដឹក ជញ្ចូន ខេត្ត មណ្ឌលគិរី បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃ ព្រហស្បតិ៍ ។
យ៉ាងណា ចំពោះ ផ្លូវ ដែល នៅ សេសសល់ នេះ លោក បាន អះអាង ថា មន្ទីរ នឹង ខិតខំ លើក គម្រោង ផែនការ នៅ ឆ្នាំ បន្ត បន្ទាប់ ទៀត ដើម្បី ធ្វើ យ៉ាង ណា ឲ្យ ការ ដំណើរការ ស្ថាបនា ផ្លូវ ១ ខ្សែ នេះ ឲ្យ បាន រួចរាល់ នា ពេល ខាង មុន រហូត ដល់ ព្រំដែន ដើម្បី ងាយ ស្រួល ដល់ ប្រជាពលរដ្ឋ ធ្វើ ចរាចរណ៍ ក៏ ដូចជា ការ ផ្លាស់ប្តូរ កសិផល នានា រវាង ប្រទេស ជិត ខាង ឲ្យ កាន់ តែ មាន លក្ខណៈ ល្អ ប្រសើរ ។
មន្ត្រីអាជ្ញាធរ និង អង្គការ សហជីព កំពុង មមាញឹកចែកស្បៀងជូនអ្នកខ្វះខាត ដោយសារវិបត្តិ កូវីដ ១៩
សម្រាប់ នៅ រាជធានី ភ្នំពេញ នា ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ចែក អំណោយ គាំពារ សង្គម ជូន ដល់ ពលរដ្ឋ ដែល រស់ នៅក្នុង តំបន់ បិទ ខ្ទប់ ជា បន្តបន្ទាប់ ។
ជាក់ស្តែង នៅ ថ្ងៃទី ២១ ខែមេសា ម្សិលមិញ លោក បាន ចែក ស្បៀងអាហារ ទៅដល់ ពលរដ្ឋ ក្នុង សង្កាត់ ចោម ចៅ ទី ២ ខណ្ឌ ពោធិ៍សែនជ័យ ជាង ២០០ គ្រួសារ ។
លោក ឃួង ស្រេង បាន បន្ត ថា រាជ រដ្ឋាភិបាល ដែល មាន លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ជា ថ្នាក់ដឹកនាំ បាន បញ្ជា ឱ្យ មាន ការចុះ ចែក ស្បៀង ភ្លាម ៗ ជូន ដល់ ពលរដ្ឋ នៅ តាម តំបន់ បិទ ខ្ទប់ និង តំបន់ ក្រហម ដែល ជា តំបន់ មាន ការឆ្លង រាលដាល វីរុស កូវី ដ១៩ ច្រើន ។
ក្រៅពី នោះ នៅ ព្រលប់ ថ្ងៃ ដដែល នោះ រដ្ឋបាល រាជធានី ភ្នំពេញ ក៏ បាន ដឹកជញ្ជូន អំណោយ ដល់ រដ្ឋបាល ខណ្ឌ មានជ័យ ដើម្បី យក ទៅ ចែកជូន ពលរដ្ឋ ដែល កំពុង រស់ នៅក្នុង តំបន់ ក្រហម ក្នុង សង្កាត់ ស្ទឹងមានជ័យ ទី ១ សង្កាត់ សឹ្ទង មានជ័យ ទី ២ និង សង្កាត់ ស្ទឹងមានជ័យ ទី ៣ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ចំនួន ៣ ០០០ គ្រួសារ ផងដែរ ។
លោក នាយក រដ្ឋមន្ត្រី ធ្លាប់ បាន ថ្លែង កាលពី សប្តាហ៍ មុន ថា មាន ពលរដ្ឋ រាប់ សិប ម៉ឺន គ្រួសារ បាន និង កំពុង រស់ នៅ ក្នុង តំបន់ បិទ ខ្ទប់ ដែល រាជ រដ្ឋាភិបាល កំពុង បញ្ជូន អំណោយ ជា ស្បៀង ផ្តល់ ជូន ពួកគាត់ ជា បន្តបន្ទាប់ ដោយ លោក មិន ឱ្យ ពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ ការអត់ឃ្លាន នោះ ទេ ។
ជាមួយ គ្នា នេះ មជ្ឈមណ្ឌល សម្ព័ន្ធភាព ការងារ និង សិទ្ធិ មនុស្ស ( សង់ត្រាល់ ) ក៏ បាន ផ្តល់ ជូន នូវ ស្បៀង មួយចំនួន ទៅដល់ កម្មករ - កម្ម ការិនី ដែល កំពុង ជួប ការលំបាក និង ស្ថិត ក្នុង តំបន់ បិទ ខ្ទប់ ផងដែរ ។
