រហូត មក ដល់ ព្រលប់ ថ្ងៃ ម្សិលមិញ ស្ត្រី ជន ជាតិ ចិន រូប នេះ នៅ តែ កំពុង ត្រូវ ធ្វើ ការ សាកសួរ នៅ ស្នង ការ នគរបាល រាជធានី ភ្នំពេញ នៅ ឡើយ ។
ចិន សង់ទំនប់វារីអគ្គិសនីតាមទន្លេមេគង្គនៅតែជាចំណោទបញ្ហា
អ្នកស្រី បាន បន្ថែម ថា អង្គការ សម្ព័ន្ធ សង្គ្រោះ ទន្លេ មេគង្គ បាន សរសេរ លិខិត ទៅ គណៈ កម្ម ការ ទន្លេ មេគង្គ ពេល នោះ សាក សួរ អំពី ផល ប៉ះពាល់ នៃ ទំនប់ ចិន មាន មក លើ គ្រោះ រាំង ស្ងួត ហើយ គេ បាន ធ្វើ ការ សន្យា មក ថា នឹង ផ្តល់ របាយ ការណ៍ លម្អិត ឲ្យ ។
អ្នកស្រី ឲ្យ ដឹង ថា ប៉ុន្តែ សម្ព័ន្ធ នេះ ពុំ ទាន់ បាន ទទួល ការ វិភាគ នេះ នៅ ឡើយ ខណៈ ដែល ចិន ពុំ មាន កាតព្វ កិច្ច ត្រូវ ផ្តល់ សេចក្តី លម្អិត នៃ ការ សិក្សា ស្រា វ ជ្រាវ របស់ ខ្លួន មក ឲ្យ ប្រទេស ទន្លេ មេគង្គ ។
ក្នុង ការ ឆ្លើយ ត ប តាម អ៊ីមែល នៅ ក្នុង សប្តាហ៍ នេះ លេខាធិការ ដ្ឋាន គណៈកម្ម ការ ទន្លេ មេគង្គ បាន ឲ្យ ដឹង ថា ខ្លួន មិន បាន ធ្វើ ការ វិភាគ ជាក់ លាក់ លើ ផល ប៉ះពាល់ នៃ ទំនប់ ចិន មក លើ កម្ពុជា ក្នុង អំឡុង រដូវ ប្រាំង ឆ្នាំ ២០១០ នោះ ទេ ។
សេចក្តីឆ្លើយតប នោះ ថា៖
គណៈ កម្ម ការ ទន្លេ មេគង្គ ក្នុង ឆ្នាំ ២០១០ បាន ផ្តល់ ការ វិភាគ លើ ស្ថាន ការណ៍ គ្រោះ រាំង ស្ងួត នៅ ក្នុង វិចារណ ក ថា ចេញ ផ្សាយ របស់ កាសែត បាង ក ក ប៉ុស្តិ៍ ។
សារាចរថ្មីកំណត់យកថ្ងៃ១៥ តុលារំឭកខួបសម្តេចឪសោយទិវង្គត
នៅក្នុង សារាចរ មួយ ចុះ ហត្ថលេខា ដោយ លោក នាយក រដ្ឋ មន្រ្តី ហ៊ុន សែន កាល ពី ម្សិល មិញ រដ្ឋាភិបាល បាន កំណត់ ថ្ងៃ ទី ១៥ ខែ តុលា ជា ថ្ងៃ ឈប់ សម្រាក សាធារណៈ ប្រចាំ ឆ្នាំ និង ជា ថ្ងៃ រំឭក ដល់ ការ យាង ចូល ទិវង្គត របស់ អតីត ព្រះ មហាវីរ ក្សត្រ សម្តេច ព្រះ បាទ ន រោត្តម សីហនុ ។
សារាចរ នេះ បាន បញ្ជាក់ ថា៖
សារាចរ នេះ ក៏ ណែនាំ ឲ្យ គ្រប់ ស្ថាន អគ្គ រាជ ទូត និង ស្ថាន កុង ស៊ុល នៃ ព្រះ រាជា ណាចក្រ កម្ពុជា ប្រចាំ នៅ បរទេស និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ គ្រប់ លំដាប់ ថ្នាក់ រួម មាន រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ឃុំ សង្កាត់ ត្រូវ រៀបចំ ប្រារព្ធ ពិធី នេះ ឲ្យ បាន ទូលំ ទូលាយ និង សម ស្រប តាម ព្រះ គោរមងារ របស់ ព្រះអង្គ ជា ព្រះ វរ រាជ បិតា ឯកភាព ជាតិ ខ្មែរ ។
លោក ជា មុនី ប្រធាន សហជីព សេរី កម្មករ នៃ ព្រះ រាជា ណា ចក្រ កម្ពុជា បាន ស្វាគមន៍ ចំពោះ ថ្ងៃ ឈប់ សម្រាក ថ្មី នេះ ប៉ុន្តែ ក៏ បាន អំពាវ ដល់ រដ្ឋាភិបាល ឲ្យ មាន ការ ឈប់ សម្រាក នៅ ថ្ងៃទី ២៣ ខែ តុលា ផង ដែរ ។
តាម ប្រតិទិន ឈប់ សម្រាក ការងារ ប្រចាំ ឆ្នាំ ២០១២ បាន កំណត់ ថ្ងៃ ឈប់ សម្រាក សាធារណៈ សរុប ចំនួន ២៥ ថ្ងៃ ក្នុង នោះ មាន ពិធី ចម្រើន ព្រះជន្ម ព្រះ មហាក្សត្រ ៣ ថ្ងៃ ពិធី ចម្រើន ព្រះ ជន្ម សម្តេច ព្រះ មហា ក្សត្រិយ៍ នរោត្តម មុនី នា ថ សីហនុ មួយ ថ្ងៃ និង ពិធី ចម្រើន ព្រះ ជន្ម ព្រះ មហា វីរក្សត្រ មួយ ថ្ងៃ គឺ នៅ ថ្ងៃទី ៣១ តុលា ហើយ ដែល សម្រាប់ ឆ្នាំ ខាង មុខ និង ជំនួស តាម សារាចរ ថ្មី ដែល យក ថ្ងៃ ទី១៥ តុលា រំឭក ថ្ងៃ សោយ ទិវង្គត វិញ ៕
បរិស័ទ ២០០នាក់ តវ៉ាការពារ សង្ឃជាប់ចោទថាមានស្រី ញី
ព្រះអង្គ បាន បន្ត ថា ៖
ក្រឡាប់គោ យន្តកែច្នៃនៅស្ទឹងត្រែង របួស ១០ នាក់
ស្ទឹងត្រែងៈ យ៉ាង ហោច មាន មនុស្ស ជិត ១០ នាក់ បាន រង របួស នៅ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ក្រឡាប់ គោយន្ត កែច្នៃ មួយ កាល ពី វេលា ម៉ោង ៣ និង ១០ នាទី រសៀល ថ្ងៃទី ២១ ខែ តុលា នៅ ចំណុច ផ្លូវ កោង ស្ថិត នៅ ក្នុង ភូមិ ច្រប់ ឃុំ ក្បាល រ មាស ស្រុក សេសាន ខេត្ត ស្ទឹងត្រែង ។
លោក ណ្ណៅ វ៉ាន់ នី មន្ត្រី នគរបាល ចរាចរ ផ្លូវ គោក ខេត្ត ស្ទឹងត្រែង ទទួល បន្ទុក ផ្នែក របាយការណ៍ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិល មិញ ថា ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ នេះ បាន បណ្តាល ឲ្យ មនុស្ស ក្មេង ចាស់ ប្រុស ស្រី យ៉ាង ហោច ជិត ១០ នាក់ រង របួស ធ្ងន់ និង ស្រាល ។
លោក ណត ណា រ៉ន មេ ប៉ុស្តិ៍ ក្បាល រ មាស បាន ឲ្យ ដឹង ថា មាន មនុស្ស ជិត ១០ នាក់ បាន នាំ គ្នា ធ្វើ ដំណើរ តាម គោយន្ត កែច្នៃ ចេញ ពី លំនៅដ្ឋាន ក្នុង ខេត្ត មណ្ឌលគិរី ឆ្ពោះ ទៅ ខេត្ត រតនគិរី ដើម្បី បោក សណ្តែក សៀង លុះ មក ដល់ ចំណុច កើត ហេតុ គោយន្ត ក៏ បាន រេ ចង្កូត ធ្លាក់ ចុះ ពី ផ្លូវ បណ្តាល ឲ្យ ក្រឡាប់ ធ្លាក់ អ្នក ដំណើរ ចេញ ពី គោយន្ត អស់ តែ ម្តង ។
ទាក់ទង នឹង ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នេះ របាយការណ៍ អគ្គ ស្នងការ នគរបាល ជាតិ ថា នៅ ថ្ងៃទី ២២ ខែ តុលា ម្សិលមិញ នេះ មាន មនុស្ស ស្លាប់ ម្នាក់ រង របួស ៨ នាក់ ក្នុង ករណី គ្រោះ ថ្នាក់ ចរាចរណ៍ ៦ លើក ដែល បាន កើត ឡើង នៅ ទូទាំង ប្រ ទេស កម្ពុជា ៕
ដើមបណ្តឹងរដ្ឋ ប្បវេណីបន្តផ្តល់ ក សិណដល់សាលា ក្តី
ភ្នំពេញៈ មិន យូរ ប៉ុន្មាន បន្ទាប់ ពី ការ ដួល រលំ នៃ របប ក្រុង ភ្នំពេញ នៅ ខែ មេសា ឆ្នាំ ១៩៧៥ លោក ជុំ សុខា ត្រូវ ទទួល កាតព្វកិច្ច ជា អ្នក ប្រមូល លាមក និង ទឹក នោម ។
ក្រុម មេធាវី ការពារ ក្តី បាន ទឡ្ហីករណ៍ ថា ការ ថ្លែង អំពី ទុក្ខ សោក មួយ ចំនួន នៅ សវនាការ គឺ តាម លក្ខណៈ បច្ចេកទេស មិន ពាក់ព័ន្ធ នឹង សំណុំ រឿង ដែល កំពុង កាត់ ក្តី នេះ ទេ ។
ថៃចាត់ការ បញ្ឈប់ការ កេងប្រវ័ញ្ចលើពលករខ្មែរ
ភ្នំពេញៈ ក្រសួង ការងារ ថៃ បាន អន្តរាគមន៍ ដ៏ កម្រ ទៅ លើ វិធានការ បញ្ឈប់ ការ កេង ប្រវ័ញ្ច លើ ពលករ ចំណាក ស្រុក មក ពី ប្រទេស កម្ពុជា និង ភូមា នៅ ឯ រោងចក្រ ផលិត អាហារ សមុទ្រ មួយ កន្លែង ភាគ ខាង ត្បូង នៃ ប្រទេស ។
ក្រសួង ការងារ ថៃ បាន ស្វែងរក ឃើញ កំហុស យ៉ាង ហោច បី ចំណុច ដែល ផ្ទុយ នឹង ច្បាប់ ការងារ ថៃ នៅ ឯ រោងចក្រ អាហារ សមុទ្រ ឈ្មោះ ផាត់ ថា ណា នៅ ក្នុង ខេត្ត ស៊ុង ក្លា ដែល មាន កម្មករ ខ្មែរ ៦០០ នាក់ កំពុង ធ្វើ ការងារ នៅ ទីនោះ ។
នៅ ក្នុង លិខិត ដែល បាន ផ្ញើ ទៅ ការិយាល័យ ឧត្តម ស្នងការ ជាន់ ខ្ពស់ ទទួល បន្ទុក សិទ្ធិ មនុស្ស របស់ អង្គការ សហ ប្រជាជាតិ កាល ពី ខែ កក្កដា ក្រសួង ការងារ ថៃ បាន ឲ្យ ដឹង ថា ខ្លួន បាន រក ឃើញ ថា រោងចក្រ ផាត់ ថា ណា បាន ដក ហូត លិខិត ឆ្លង ដែន ពី កម្មករ និង កាត់ ប្រាក់ ខែ កម្មករ ឲ្យ ទៅ ក្រុម ហ៊ុន ជ្រើសរើស កម្មករ ជា ភាគី ទី បី ដែល ជា ទង្វើ ផ្ទុយ ទៅ នឹង ច្បាប់ ការងារ របស់ ប្រទេស ថៃ ។
នៅ ក្នុង នេះ ក៏ បញ្ជាក់ ថា៖
វិធានការ បាន កែ តម្រូវ ស្ថានភាព ដែល ត្រូវ បាន អនុវត្ត និង កិច្ច អន្តរាគមន៍ មួយ ចំនួន កំពុង តែ បន្ត ធ្វើ » ។
ករណី លើក ឡើង ធ្ងន់ធ្ងរ បំផុត គឺ ថា សំណុំ បែប បទ នៃ លិខិត ឆ្លង ដែន ជា សុវត្ថិភាព កម្មករ នោះ រោងចក្រ ផាត់ ថា ណា កំពុង តែ ដក ហូត ទុក ហេតុ ដូច្នេះ ទើប បាន ជា កម្មករ ខ្មែរ មួយ ចំនួន អស់ សង្ឃឹម ហើយ បាន ភៀស ខ្លួន ធ្វើ ដំណើរ ដោយ គ្មាន ឯកសារ ស្រប ច្បាប់ ។
សមត្ថកិច្ច ថៃ ដែល ធ្លាប់ បាន ធ្វើ អធិការកិច្ច ម្តង នៅ រោងចក្រ នេះ និង បញ្ជាក់ ថា គ្មាន បញ្ហា នោះ ត្រូវ បាន ចោទ ប្រកាន់ ពី បទ វាយ តប់ និង កោរ សក់ កម្មករ មួយ ចំនួន និង យក ប្រាក់ ពី ពួកគេ ព្រម ទាំង បាញ់ គំរាម ដើម្បី បំបែក ហ្វូង កូដករ ។
លោក អាន ឌី ហល់ ជា អ្នក ជំនាញ ការ នៅ វិទ្យាស្ថាន អត្រា ប្រជាជន និង ស្រា វ ជ្រាវ សង្គម នៃ សាកល វិទ្យាល័យ ម៉ាហ៊ីដុល បាន និយាយ ថា ចាប់ តាំង ពី មាន អន្តរាគមន៍ របស់ ក្រសួង ការងារ ថៃ មក លក្ខខណ្ឌ ការងារ នៅ រោងចក្រ មាន លក្ខណៈ ល្អ ជាង មុន បើ ទោះ ជា នៅ មាន ចំណុច គួរ ឲ្យ ព្រួយ បារម្ភ ខ្លះ ក៏ ដោយ ។
លក់ ឡាយ ឡុងបរិក្ខារនៅរោងចក្រ តុក្កតាខ្លា ឃ្មុំនៅ តែសងកម្មករមិនគ្រប់
កម្មករ ជាង ៣៥០ នាក់ ជាប់ គាំង ពេល រោង ចក្រ ដេរ តុក្កតា ខ្លា ឃ្មុំ របស់ សហរដ្ឋ អាមេរិក នេះ បាន បិទ ទ្វារ ក្នុង ខែ សីហា ហើយ មន្រ្តី រដ្ឋាភិបាល បាន គ្រប់ គ្រង ទ្រព្យ របស់ រោង ចក្រ ក្នុង បំណង បង់ ប្រាក់ ឈ្នួល និង អត្ថ ប្រយោជន៍ ផ្តាច់ ការ ងារ ដល់ កម្មករ ។
គណៈកម្មាធិការ ក្រសួង សង្គម កិច្ច ដែល ទទួល បន្ទុក កិច្ចការ នេះ បាន បង្ហាញ ការ ប្តេជ្ញា តិច តួច ក្នុង ការ ផ្តល់ ដំណោះ ស្រាយ គ្រប់គ្រាន់ ដល់ កម្មករ ។
ពុំ មាន ការ ប្តេជ្ញា ពិត ប្រាកដ ពី មន្ត្រី រដ្ឋាភិបាល និង គណៈកម្មាធិការ ក្នុង ការ អនុវត្ត តាម នីតិវិធី ត្រឹម ត្រូវ ។
លោក កែ សុខ ស៊ីដនី មន្រ្តី ក្រសួង សង្គមកិច្ច បាន ថ្លែង ថា ប្រាក់ ២១ ០០០ ដុល្លារ បាន បង់ ប្រាក់ ឈ្នួល សម្រាប់ ខែ សីហា ឲ្យ កម្មករ ប៉ុន្តែ លោក ទទួល ស្គាល់ ថា វា បង់ បាន តែ ៥ ភាគ រយ នៃ អត្ថ ប្រយោជន៍ ផ្តាច់ ការ ងារ ដែល ជំពាក់ កម្មករ តែ ប៉ុណ្ណោះ ។
លោក ស្រី ម៉ិច មុំ តំណាង កម្មករ បាន ថ្លែង ថា គាត់ ស្ថិត ក្នុង ២៧ នាក់ ដែល មិន ព្រម ផ្តិត មេ ដៃ លើ លិខិត លា លែង ដើម្បី ទទួល ប្រាក់ ខែ តែ ពាក់ កណ្តាល និង មិន បាន ប្រាក់ អត្ថប្រយោជន៍ ផ្តាច់ ការ ងារ ។
ឃុំខ្លួនអ្នកក្លែង ជាទីប្រឹក្សាលោក ស ខេងនិងគូក ន
សៀមរាបៈ សាលា ដំបូង ខេត្ត សៀមរាប បាន សម្រេច ឃុំ ខ្លួន បុរស បី នាក់ ជា បណ្ដោះ អាសន្ន ពី ថ្ងៃ ម្សិល មិញ ចោទ ប្រកាន់ ពី បទ ឆ បោក បន្ទាប់ ពី បុរស ម្នាក់ ក្នុង ចំណោម បី នាក់ បាន ក្លែង ខ្លួន ជា ទីប្រឹក្សា របស់ លោក ឧប នាយក រដ្ឋ មន្ត្រី រដ្ឋ មន្ត្រី ក្រសួង មហា ផ្ទៃ លោក ស ខេង ។
សមត្ថកិច្ចឃាត់ខ្លួនគ្រួសារទាហានធ្វើអត្តឃាតនៅឫស្សីកែវ
ភ្នំពេញៈ សមត្ថកិច្ច នគរបាល បាន ឃាត់ និង នាំ ខ្លួន មនុស្ស នៅ ក្នុង ក្រុម គ្រួសារ នៃ មន្រ្តី យោធា ម្នាក់ ដែល បាន បាញ់ សម្លាប់ ខ្លួន ឯង កាលពី វេលា ម៉ោង ៧ និង ៤០ នាទី យប់ ថ្ងៃ ទី ២១ ខែ តុលា មក កាន់ អធិការដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ ដើម្បី សាក សួរ ។
លោក វែង ចក់ នាយ ប៉ុស្តិ៍ នគរបាល សង្កាត់ ជ្រោយ ចង្វារ បាន ប្រាប់ ឲ្យ ដឹង ថា៖
លោក សោម ប៊ុនី្ន អធិការ នគរបាល ខណ្ឌ ឫស្សីកែវ បាន ឲ្យ ដឹង ថា ករណី អត្តឃាត និង ការ នាំ ខ្លួន មនុស្ស ក្នុង ក្រុម គ្រួសារ នៃ មន្រ្តី យោធា ទៅ សាក សួរ នៅ អធិការ ដ្ឋាន នគរបាល ខណ្ឌ ឫស្សីកែវ នោះ លោក មិន ទាន់ អាច បញ្ជាក់ ពី មូល ហេតុ និង ដំណើរ រឿង លម្អិត ថា នេះ ជា អំពើ ឃាតកម្ម ឬ អត្តឃាត នោះ បាន នៅ ឡើយ ទេ ។
លោក បន្ត ថា ស្ត្រី ជា ប្រពន្ធ និង កូន ស្រី ប្រាប់ សមត្ថកិច្ច ថា ជន រង គ្រោះ បាញ់ សម្លាប់ ខ្លួន ឯង បន្ទាប់ ពី ធ្វើ ដំណើរ ទៅ ដល់ ផ្ទះ រក រឿង បាញ់ ប្រពន្ធ កូន និង ប្អូន ជី ដូន មួយ ឈ្មោះ ឆៃ ថន ភេទ ប្រុស អាយុ ៣៤ ឆ្នាំ មាន ទីលំនៅ ខណ្ឌ ពោធិ៍សែនជ័យ មួយ គ្រាប់ តែ ពុំ ផ្ទុះ ។
ឥស្សរ ជនខ្មែរចង់ឲ្យលើកលែងទោសអ្នក ទោស នយោបាយដើម្បីផ្សះផ្សាជាតិ
ព្រះអង្គម្ចាស់ មាន បន្ទូល ទៀត ថា ការ លើកលែង ទោស អ្នក នយោបាយ វា ពុំ មែន ជា រឿង អ្វី ថ្មី ដែល គួរ ឲ្យ ភ្ញាក់ ផ្អើល នោះ ទេ ។
លោក ស្រី ជា វណ្ណាត អ្នក វិភាគ ឯករាជ្យ ក៏ យល់ ស្រប ទៅ នឹង បន្ទូល របស់ ព្រះ អង្គ ម្ចាស់ ធម្មិ កោ ដែរ ។
លោក ស្រី មាន ប្រសាសន៍ ថា រាជ រដ្ឋាភិបាល គួរ តែ ធ្វើ ការ ដោះ លែង អ្នក ទោស នៅ ក្នុង ឱកាស ដ៏ ពិសេស សម្រាប់ ព្រះ វិញ្ញាណ ក្ខន្ធ ព្រះ បាទ ន រោត្តម សីហនុ ដែល នេះ ជា ឱកាស ដ៏ ល្អ សម្រាប់ សម្តែង នូវ ការ ដឹង គុណ ដល់ អតីត ព្រះ មហាវីរ ក្សត្រ ។
លោក សឺន ស៊ូប៊ែរ្តិ៍ ជា សមាជិក ក្រុម ប្រឹក្សា រដ្ឋធម្មនុញ្ញ បាន ថ្លែង ថា បើ តាម ទំនៀម ទម្លាប់ នៅ ពេល មាន ពិធី បុណ្យ ធំ ៗ ជា ពិសេស ការ យាង ចូល ទិវង្គត របស់ ព្រះ មហាវីរ ក្សត្រ នៅ ពេល នេះ គឺ គេ គួរ តែ ធ្វើ ពិធី លើក លែង ទោស ដល់ អ្នក ទោស ខ្លះ ដើម្បី ជា ការ ឧទ្ទិស កុសល ដល់ ព្រះ វិញ្ញាណ ក្ខន្ធ សម្តេច ឪ ដែល រដ្ឋា ភិបាល គួរ តែ ពិនិត្យ លើ ករណី នេះ ។
យ៉ាងណា ក្តី លោក បណ្ឌិត សុខ ទូច អ្នក វិភាគ ឯករាជ្យ បាន ឲ្យ ដឹង ថា មាន ចំណុច មួយ ចំនួន ដែល រដ្ឋាភិបាល អាច ធ្វើ ការ លើក លែង ទោស ឲ្យ អ្នក នយោបាយ បាន ហើយ ជាមួយ គ្នា នេះ អ្នក ទោស នយោបាយ ខ្លួន ឯង ក៏ ត្រូវ សរសេរ លិខិត ទៅ រដ្ឋាភិបាល ក៏ ដូចជា ព្រះ មហាក្សត្រ ដើម្បី សុំ ព្រះ រាជ ទាន ការ លើក លែង ទោស ។
អ្នក នយោបាយ ត្រូវ សម្តែង និង ទទួល កំហុស របស់ ខ្លួន ដើម្បី ឲ្យ រាជ រដ្ឋា ភិបាល លើក លែង ទោស ។
លោក យឹម សុវណ្ណ អ្នកនាំ ពាក្យ គណបក្ស ប្រឆាំង សម រង្ស៊ី បាន ឲ្យ ដឹង កាល ពី ថ្ងៃ ម្សិល មិញ ថា លោក ទូច សារិន ប្រធាន នាយក ដ្ឋាន រដ្ឋបាល នៃ ទីស្តី ការ គណៈ រដ្ឋ មន្រ្តី បាន បញ្ជូន លិខិត លោក សម រង្ស៊ី ប្រធាន គណបក្ស សង្គ្រោះ ជាតិ កម្ពុជា ត្រឡប់ ទៅ វិញ កាល ពី ថ្ងៃ សៅរ៍ ដោយ បញ្ជាក់ ថា លិខិត នោះ មិន បាន ពណ៌នា ពី អាសយ ដ្ឋាន រស់ នៅ ច្បាស់ លាស់ របស់ លោក សម រង្ស៊ី ។
លោក យឹម សុវណ្ណ បញ្ជាក់ ថា លិខិត របស់ លោក សម រង្ស៊ី នឹង ត្រូវ ផ្ញើ ជូន លោក នាយក រដ្ឋ មន្រ្តី ហ៊ុន សែន ម្តង ទៀត នៅ ថ្ងៃ ចន្ទ នេះ បន្ទាប់ ពី លិខិត នេះ ត្រូវ បាន កែ តម្រូវ ដាក់ អាសយដ្ឋាន ច្បាស់ លាស់ ។
កាល ពី សប្តាហ៍ មុន លោក សម រង្ស៊ី បាន បញ្ជូន លិខិត ពីរ ដាច់ ដោយ ឡែក ពី គ្នា មួយ ថ្វាយ ព្រះ មហាក្សត្រ នរោត្តម សីហ មុនី និង មួយ ទៀត ជូន លោក នាយក រដ្ឋ មន្រ្តី ដោយ ទូល សុំ ព្រះ មហា ក្សត្រ និង ស្នើ លោក នាយក រដ្ឋ មន្ត្រី ជួយ ព្រះ រាជ អន្តរាគមន៍ និង អន្តរា គមន៍ ដើម្បី ត្រួស ត្រាយ ផ្លូវ សម្រាប់ ការ វិល ត្រឡប់ មក វិញ របស់ លោក ដើម្បី មក គោរព វិញ្ញាណ ក្ខន្ធ ព្រះ មហា វីរ ក្សត្រ និង ឃើញ ព្រះ ភក្ត្រ របស់ ព្រះអង្គ ជា ចុង ក្រោយ នៅ ព្រះ បរម រាជ វាំង ។
ពលរដ្ឋផ្អើលមើលរូបសម្តេចឪក្នុងព្រះ ខែ
ភ្នំពេញៈ ភាព ភ្ញាក់ផ្អើល របស់ ប្រជាពលរដ្ឋ បាន កើត ឡើង ផ្ទួន ៗ គ្នា ក្រោយ ដែល ព្រះ មហា វីរក្សត្រ សម្តេច ព្រះ បាទ ន រោត្តម សីហនុ ទ្រង់ សោយទិវង្គត ហើយ កាល ពី យប់ មិញ នេះ អ្នក រស់ នៅ រាជធានី ភ្នំពេញ ជាច្រើន បាន ទូរស័ព្ទ ផ្ទួន ៗ គ្នា មក ភ្នំពេញ ប៉ុស្តិ៍ ដោយ បាន អះអាង ថា បាន មើល ឃើញ ព្រះឆាយា ល័ក្ខណ៍ សម្តេច ឪ នៅ ក្នុង ព្រះខែ ថ្ងៃ៦ កើត ភាគ ច្រើន ដូច រូប ក្នុង ក្រដាស ប្រាក់ ១ម៉ឺន រៀល ។
កញ្ញា នួន ពេជ្រ ស៊ូដានី អ្នក រស់ នៅ ម្តុំ បុរី សឡា សង្កាត់ ស្ទឹងមានជ័យ រៀប រាប់ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា នាង បាន មើល ឃើញ រូប សម្តេច ឪ ក្នុង ចំណិត ព្រះ ខែ បន្ទាប់ ពី អ្នក ភូមិ ផ្អើល មើល ឈូ ឆរ នៅ លើ ដង ផ្លូវ ។
ពេជ្រ ស៊ូដានី និយាយ ថា ៖
លោក អ៊ឹម រាត្រី អាយុ ៤៨ ឆ្នាំ នៅ ចម្ការ ដូង ក្នុង សង្កាត់ - ខណ្ឌ ដង្កោ ក៏ អះអាង ដែរ ថា អ្នកភូមិ និង អ្នក ផ្ទះ គាត់ ៩០ ភាគរយ បាន មើល ឃើញ ព្រះឆាយាល័ក្ខណ៍ ព្រះករុណា ព្រះ នរោត្តម សីហនុ នៅ ក្នុង ចំណិត ព្រះ ខែ ក្នុង យប់ ថ្ងៃ ៦ កើត ខែ អស្សុជ នេះ ដែរ ។
លោក រាត្រី បន្ត ថា ៖
ការ ផ្អើល មើល រូប សម្តេច ឪ ប្រតិស្ឋាន ក្នុង ព្រះខែ យប់ មិញ នេះ មិន មែន តែ នៅ ភ្នំពេញ ទេ អ្នក ខេត្ត កណ្តាល ខេត្ត ព្រះសីហនុ កំពង់ឆ្នាំង ព្រៃវែង រហូត នៅ ប្រទេស ថៃ ឥណ្ឌា ខ្លះ សុទ្ធ តែ អះអាង ដូច គ្នា ដែរ ប៉ុន្តែ ក៏ មាន អ្នក ដែល ថា មើល មិន ឃើញ ឬ គ្រាន់ តែ ព្រិល នោះ ក៏ មិន តិច នាក់ ដែរ ។
កញ្ញា ធឿន ស៊ីនួន នៅ ម្តុំ បែក ចាន ស្រុក អង្គស្នួល ខេត្ត កណ្តាល អះអាង ថា នាង បាន ឃើញ រូប ព្រះឆាយា ល័ក្ខណ៍ ដូច ក្នុង ក្រដាស លុយ ១ម៉ឺន រៀល ហើយ ថា អ្នក ផ្សារ បាន ផ្អើល មក មើល ពេញ ផ្លូវ ។
លោក ពុត ថុង អ្នក រត់ តាក់ ស៊ី កំពង់ឆ្នាំង ភ្នំពេញ និយាយ ថា៖
លោក អាចារ្យ អះអាង ថា៖
ព្រះ តេជគុណ សុខ ប៊ុន ធឿន ព្រះ ចៅអធិការ វត្ត នន្ទ មុនី សង្កាត់ ស្ទឹង មានជ័យ មាន សង្ឃ ដីកា ថា ព្រះអង្គ មិន បាន ទត មើល ទេ តែ ថា បើ ដូច តែ បរិស័ទ បាន ឃើញ នោះ តាម ព្រះ ធម៌ ជា ប្រផ្នូល មួយ បង្ហាញ ពី បារមីធម៌ ដែល អតីត ព្រះ មហាក្សត្រ ដែល ធ្លាប់ មាន ព្រហ្ម វិហារ ធម៌ ចំពោះ ប្រជានុរាស្ត្រ ព្រះអង្គ តាំង ពី សម័យ សង្គម រាស្ត្រ និយម រហូត មក ។
ព្រះតេជគុណ មាន សង្ឃ ដីកា ថា ៖
ស្នងការ ព្រះវិហារនឹងត្រូវជំនួសដោយស្នងការ រងពោធិ៍សាត់
ព្រះវិហារៈ តំណែង ស្នងការ នគរបាល ខេត្ត ព្រះវិហារ ដែល ដឹក នាំ ដោយ លោក ម៉ៅ ពៅ អស់ រយៈ ពេល ៥ ឆ្នាំ មក ហើយ នោះ នឹង ត្រូវ ជំនួស ដោយ លោក ស៊ី គីរី ស្នងការ រង នគរបាល ខេត្ត ពោធិ៍សាត់ នៅ ក្នុង សប្តាហ៍ នេះ ដែល ពិធី ផ្ទេរ តំណែង នឹង ត្រូវ ធ្វើ ឡើង ក្រោម អធិបតីភាព លោក នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ។
លោក រស់ បូណាន ស្នងការ រង ខេត្ត ពោធិ៍សាត់ បាន និយាយ ថា លោក ស្នងការ រង ស៊ី គីរី នឹង ត្រូវ បាន តែងតាំង ជា ស្នងការ ខេត្ត ព្រះវិហារ ជំនួស លោក ម៉ៅ ពៅ ។
លោក កែវ ចំរើន ស្នងការ រង ខេត្ត ព្រះវិហារ បាន ឲ្យ ដឹង ដែរ ថា ពិត ជា មាន ការ ផ្លាស់ ប្តូរ តំណែង ស្នងការ ខេត្ត ព្រះ វិហារ មែន ដែល ពិធី ប្រកាស ផ្ទេរ មុខ តំណែង នេះ នឹង ត្រូវ ធ្វើ ឡើង នៅ ថ្ងៃ ទី២៥ តុលា ប៉ុន្តែ លោក មិន បាន ប្រាប់ ពី មូលហេតុ នៃ ការ ផ្លាស់ ប្តូរ នេះ ទេ ដោយ ថ្លែង ថា៖
ប៉ុន្តែ មន្ត្រី ក្រសួង មហាផ្ទៃ ដែល សុំ មិន បញ្ចេញ ឈ្មោះ បាន ថ្លែង ថា លោក ឧប នាយក រដ្ឋ មន្ដ្រី ស ខេង រដ្ឋ មន្ដ្រី ក្រសួង មហាផ្ទៃ បាន ចេញ លិខិត ជា ផ្លូវ ការ រួច រាល់ ហើយ កាល ពី ថ្ងៃ ទី១៩ ខែ តុលា ឆ្នាំ ២០១២ អំពី ការ ផ្លាស់ ប្តូរ តំណែង ស្នងការ ខេត្ត ព្រះវិហារ នេះ ។
បើ តាម លោក ឡោ ចាន់ មន្ត្រី សម្រប សម្រួល សិទ្ធិ មនុស្ស អង្គការ អាដ ហុក ប្រចាំ ខេត្ត ព្រះវិហារ លោក ម៉ៅ ពៅ ធ្លាប់ រង នូវ បណ្ដឹង កាល ពី ថ្ងៃ ទី៣ ខែ សីហា ឆ្នាំ ២០១២ ពី ស្ត្រី ម្នាក់ ឈ្មោះ ហេង ឆេង ហ៊ាង ប្ដឹង មក ការិយាល័យ អាដហុក ដោយ ចោទ ស្នងការ រូប នោះ ថា បាន ប្រើ ហិង្សា ដោយ ជេរ និង វាយ ដំ ទៅ លើ រូប គាត់ ៕
ភ្នំពេញៈ កុមារ ៧ នាក់ នៅ អង្គការ ក្នុង ស្រុក មួយ ហៅ ថា ផ្ទះ របស់ យើង ក្នុង ខណ្ឌ មានជ័យ បាន រង របួស ធ្ងន់ ដោយ សារ ជញ្ជាំង ឥដ្ឋ រលំ សង្កត់ លើ កាល ពី ព្រឹក ថ្ងៃ សុក្រ ហើយ ត្រូវ បាន បញ្ជូន ទៅ សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរ ពេទ្យ ។
លោក ហៀក ចាន់ លាង អភិបាល រង ខណ្ឌ មាន ជ័យ បាន ថ្លែង កាល ពី ម្សិលមិញ ថា នាយក អង្គការ នេះ បាន ឲ្យ កុមារ ជាច្រើន នាក់ ដែល រស់ នៅ ទី នោះ បំផ្លាញ បន្ទប់ ចាស់ ដើម្បី សាង សង់ ការិយាល័យ ថ្មី ប៉ុន្តែ ពួក គេ គ្មាន ជំនាញ ជា កម្មករ សំណង់ ទេ ដែល បណ្តាល ឲ្យ ពួក គេ រង គ្រោះថ្នាក់ ។
លោក បន្ថែម ថា លោក បាន ចុះ ទៅ មើល កន្លែង កើត ហេតុ ហើយ ពួក គេ បាន ប្រញាប់ ប្រញាល់ បញ្ជូន ក្មេង រងគ្រោះ ទៅ មន្ទីរ ពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
លោក ហៀក ចាន់ លាង បញ្ជាក់ ថា៖
លោក ស្រី វ៉ាន់ កញ្ញា ប្រធាន ការិយាល័យ សង្គមកិច្ច ខណ្ឌ មានជ័យ បាន ថ្លែង កាល ពី ម្សិល មិញ ថា កុមារ ពីរ នាក់ ត្រូវ បាន អនុញ្ញាត ឲ្យ ចាក ចេញ ពី មន្ទីរ ពេទ្យ បន្ទាប់ ពី គ្រូ ពេទ្យ បាន លាង របួស របស់ ពួក គេ ប៉ុន្តែ កុមារ ៥ នាក់ ទៀត រង របួស ធ្ងន់ ត្រង់ ដៃ និង ក្បាល ត្រូវ តែ សម្រាក ព្យាបាល នៅ មន្ទីរ ពេទ្យ ។
លោក វណ្ណ ថុល អនុ ប្រធាន សហព័ន្ធ សហជីព កម្មករ ឈើ និង សំណង់ កម្ពុជា ថ្លែង ថា នាយក អង្គការ នេះ មិន គួរ ដាក់ ការងារ ប្រភេទ បែប នេះ ឲ្យ កុមារ ធ្វើ ឡើយ ព្រោះ វា មាន គ្រោះថ្នាក់ ។
លោក ហង់ វិបុល បន្ត ថា៖
ពលរដ្ឋ បន្ថែម ថា៖
ពលរដ្ឋ សន្លប់ ក្រោម គំនរ ឥដ្ឋ ហើយ ត្រូវ បាន បញ្ជូន ទៅ មន្ទីរ ពេទ្យ ។
ពលរដ្ឋ បន្ត ថា៖
ក្លិប កម្សាន្ត ផ្អាកការ ប្រគំតន្ត្រីអំឡុងពេល កាន់ទុក្ខសម្តេចឪ
សេចក្តី ជូន ដំណឹង មាន អត្ថន័យ ថា ជា ការ គារវកិច្ច ក្នុង រយៈ ពេល កាន់ មរណទុក្ខ ព្រះ បរម សព ព្រះមហា វីរក្សត្រ គ្មាន លក់ គ្រឿង ស្រវឹង ហើយ គ្មាន តូរ្យ តន្រ្តី កំដរ ទេ រហូត ទាល់ តែ មាន សេចក្តី ជូន ដំណឹង បន្ថែម ទៀត ។
បទ បញ្ជា ហាម ឃាត់ ក្លិប ខារ៉ាអូខេ ភោជនីយដ្ឋាន និង កន្លែង កម្សាន្ត ដទៃ ទៀត មិន ឲ្យ លេង ភ្លេង ខ្លាំង ឬ ប្រគំ ត ន្រ្តី ជា សាធារណៈ ទេ ជា ការ គារវកិច្ច ដល់ ព្រះ មហា វីរក្សត្រ នរោត្តម សីហនុ ដែល បាន សោយ ទិវង្គត ដោយ សារ ព្រះជរា ពាធ កាល ពី ថ្ងៃ ទី ១៥ ខែ តុលា នៅ ទីក្រុង ប៉េកាំង ។
លោក ខៀវ កាញារីទ្ធ រដ្ឋ មន្រ្តី ក្រសួង ព័ត៌មាន បាន ថ្លែង ថា ម្ចាស់ ហាង មិន គួរ លេង តន្រ្តី ឌីស្កូ ឬ ហ៊ីបហប ហើយ លោក ឡុង ឌីម៉ង់ អ្នក នាំ ពាក្យ សាលា រាជធានី ភ្នំពេញ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាល ពី ម្សិលមិញ ថា ការ ហាម ឃាត់ គ្រឿង ស្រវឹង ប្រហែល ជា ការ យល់ ខុស ។
ប៉ុន្តែ សារ ហាក់ ដូច ជា មាន អត្ថន័យ ផ្សេង ។
នៅ ហាង ពន្លឺ ថ្មី ក្នុង ខណ្ឌ ទួលគោក អាកប្បកិរិយា គ្មាន សណ្តាប់ ធ្នាប់ របស់ ភ្ញៀវ មួយ ចំនួន បាន នាំ ឲ្យ មាន សំណើ ជាក់ លាក់ ខុស ពី ធម្មតា ។
និយោជិត ម្នាក់ ដែល ស្នើ សុំ មិន បញ្ចេញ ឈ្មោះ បាន ថ្លែង ថា៖
លោក ស្រី ថ្លែង ថា ដំបូង គេ ប្រាប់ ឲ្យ បិទ ភោជនីយដ្ឋាន ទាំង មូល ដែល ជា ការ ពិបាក ដោយ ភោជនីយដ្ឋាន ក៏ ជួល បន្ទប់ សណ្ឋាគារ ផង ដែរ ។
បន្ទាប់ មក អាជ្ញាធរ ថា ភោជនីយដ្ឋាន អាច បន្ត បើក ទ្វារ ប៉ុន្តែ ត្រូវ លុប ចោល ព្រឹត្តិការណ៍ តន្រ្តី ផ្ទាល់ និង រក្សា សំឡេង កុំ ឲ្យ ឮ ខ្លាំង ។
សេចក្តី ណែ នាំ នេះ កាន់ តែ ស្រពេច ស្រពិល ថែម ទៀត ។
អាជីវកម្ម ទាំង អស់ ដែល ភ្នំពេញ ប៉ុស្តិ៍ បាន សួរ ព័ត៌មាន នោះ បាន រាយការណ៍ ថា ប្រាក់ ចំណូល ពួក គេ បាន ធ្លាក់ ចុះ ដោយ សារ បទប្បញ្ញតិ្ត និង ការ រាំងស្ទះ ផ្លូវ ជុំវិញ ព្រះបរម រាជ វាំង ។
ភ្នំពេញៈ ពេល វេលា កាន់ តែ អស់ បន្តិច ម្តង ៗ ចំពោះ ការ ស្នើ សុំ លុប ចោល ប្រការ មួយ ចំនួន នៃ សេចក្តី ថ្លែង ការណ៍ អាស៊ាន ដែល ដាក់ កំហិត ដល់ សិទ្ធិ របស់ ប្រជាជន ជា ជាង ការពារ និង លើក កម្ពស់ សិទ្ធិ របស់ ប្រជាជន ។
នេះ បើ យោង តាម ក្រុម សង្គម ស៊ីវិល ដែល បាន ថ្លែង កាល ពី ម្សិលមិញ ។
លោក ណាយ វ៉ាន់ ដា អនុ ប្រធាន ផ្នែក តាមដាន នៅ អង្គការ សិទ្ធិ មនុស្ស អាដហុក បាន ថ្លែង ថា ក្រុម សង្គម ស៊ីវិល ត្រូវ ការ ឱកាស ច្រើន ជាង មុន ដើម្បី ពិគ្រោះ យោបល់ ជាមួយ ថ្នាក់ ដឹក នាំ អំពី ការ ប្រើ ពាក្យ ពេចន៍ មួយ ចំនួន នៅ ក្នុង សេចក្តី ថ្លែងការណ៍ ដែល គេ រំពឹង ថា ក្រុម រដ្ឋ មន្រ្តី ជាន់ ខ្ពស់ នឹង អនុម័ត នៅ ក្នុង កិច្ច ប្រជុំ កំពូល អាស៊ាន នៅ រាជធានី ភ្នំពេញ ពី ថ្ងៃ ទី ១៨ ដល់ ថ្ងៃ ទី ២០ វិច្ឆិកា ខាង មុខ ។
ក្រុម សង្គម ស៊ីវិល បាន ស្នើ សុំ ឲ្យ មាន ការ ពិ គ្រោះ យោបល់ បន្ថែម នេះ បន្ទាប់ ពី គ្រាន់ តែ បាន ឃើញ សេចក្តី ថ្លែង ការណ៍ ព្រាង លេច ធ្លាយ និង រង ការ រិះគន់ ថា មាន ប្រការ ពាក់ព័ន្ធ នឹង បញ្ហា សីលធម៌ សាធារណៈ និង សាសនា ដែល រើស អើង នឹង ស្រ្តី ។
លោក ស្រី Yuyun Wahyuningrum ទីប្រឹក្សា ជាន់ ខ្ពស់ ស្តីពី អាស៊ាន និង សិទ្ធិ មនុស្ស សម្រាប់ ក្រុម ការងារ សិទ្ធិ មនុស្ស របស់ សម្ព័ន្ធ អង្គការ ក្រៅ រដ្ឋាភិបាល ឥណ្ឌូនេស៊ី បាន ថ្លែង ថា មាត្រា មួយ ចំនួន ក្នុង សេចក្តី ថ្លែងការណ៍ ព្រាង នេះ បង្ហាញ ថា សេចក្តី ថ្លែងការណ៍ ព្រាង នេះ មាន ការ សម្រប សម្រួល ច្រើន សម្រាប់ អត្ថប្រយោជន៍ ជាតិ នៃ រដ្ឋ អាស៊ាន ជា ជាង ធ្វើ ឲ្យ ប្រសើរ ឡើង ចំពោះ បញ្ហា សិទ្ធិ មនុស្ស ៕
អ្នក ប ទុមសាគរ ខ្វល់នឹងការបញ្ជាឲ្យឈប់ធ្វើចម្ការ
កោះ កុងៈ ពលរដ្ឋ ប្រមាណ ២០០ គ្រួសារ នៅ ក្នុង ស្រុក បទុម សាគរ ខេត្ត កោះ កុង កើត ទុក្ខ មិន សុខ ចិត្ត នឹង ការ ដែល ថា អភិបាល ស្រុក បញ្ជា ឲ្យ បញ្ឈប់ ការ ដាំដុះ លើ ដី ចម្ការ គាត់ ជាង ១០០ ហិកតា ដើម្បី ទុក ដី ឲ្យ ទៅ ក្រុមហ៊ុន សម្បទាន ចិន អភិវឌ្ឍ ។
