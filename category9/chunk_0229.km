( កំពត ) ៖ អភិបាល ខេត្ត កំពត លោក ម៉ៅ ធ និន នៅ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ បាន ដឹកនាំ មន្ត្រី ពាក់ព័ន្ធ ក្រោម ឱវាទ ចូលរួម ក្នុង ពិធី បញ្ចុះ ខណ្ឌ សីមា ព្រះវិហារ ក្នុង វត្ត ឧត្តម គិរី សុវណ្ណ មុនី រស្មី ហៅ វត្តភ្នំ តូច ស្ថិត នៅ ភូមិ ប្រីយ៍ ពីរ ឃុំ ស្រែ ជា ខាងជើង ស្រុក ដង ទង់ ខេត្ត កំពត ។
នា ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ថ្លែង ថា សន្តិភាព ធ្វើឲ្យ កម្ពុជា រីកចម្រើន ទាំង ផ្នែក ពុទ្ធ ចក្រ និង អាណាចក្រ ។ ហើយ ប្រទេស កម្ពុជា ផ្នែក ពុទ្ធ ចក្រ និង អាណាចក្រ មិន អាច កាត់ផ្តាច់ ពី គ្នា បាន ទេ អ្វី ដែល សំខាន់ ដែល ធ្វើឲ្យ ផ្នែក ទាំង ពីរ នេះ មាន ការអភិវឌ្ឍន៍ រីកចម្រើន ទៅ បាន គឺ អាស្រ័យ លើ កត្តា សន្តិភាព ។ ជាក់ស្តែង កម្ពុជា បន្ទាប់ពី មាន សុខ សន្តិភាព ផ្នែក ពុទ្ធ ចក្រ និង អាណាចក្រ មាន ភាពរីកចម្រើន គួរឲ្យ មោទនៈ បំផុត ។
បន្ទាប់ពី កម្ពុជា មាន សន្តិភាព ពេញ ផ្ទៃ ប្រទេស កំណើន សេដ្ឋកិច្ច បាន កើនឡើង ជាលំដាប់ ក្នុង កម្រិត ៧ភាគរយ ក្នុង មួយ ឆ្នាំ កម្ពុជា បាន ប្រែក្លាយ ពី ប្រទេស ក្រីក្រ ទៅជា ប្រទេស មាន ប្រាក់ ចំណូល មធ្យម កម្រិត ទាប ហើយ តាម ការព្យាករណ៍ នៅ ឆ្នាំ ២០៣០ ខាងមុខ នឹង ក្លាយជា ប្រទេស មាន ប្រាក់ ចំណូល មធ្យម កម្រិត ខ្ពស់ ខណៈ ដែល បច្ចុប្បន្ន ហេដ្ឋារចនាសម្ព័ន្ធ ផ្សេង ៗ ផ្លូវ ទឹក ភ្លើង ពិសេស ធនធាន មនុស្ស ត្រូវបាន ពង្រីក បង្កើន សមត្ថភាព ប្រសិទ្ធភាព និង ប្រសិទ្ធផល ។
ទន្ទឹម គ្នា នោះ ផ្នែក ពុទ្ធ ចក្រ ក៏ បាន ដើរ តួនាទី សំខាន់ ក្នុង ការជួយ តម្រង់ ទិស និង ជា ចំណែក សំខាន់ មួយ ជំរុញ ដល់ ការអភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ព្រោះ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ តែង ជឿ ទៅ លើ បុណ្យ បាប ជឿ លើកម្ម ផល និង រក្សា បាន នូវ គុណធម៌ ព្រហ្មវិហារ ធម៌ ក្នុង គោល នយោបាយ ដឹកនាំ ដើម្បី បម្រើ ប្រយោជន៍ ដល់ ប្រជាជន និង ប្រទេស ជាតិ រហូត សម្រេចបាន សមិទ្ធផល ជាច្រើន ដូច សព្វ ថ្ងៃ នេះ ៕
រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ ប្រារព្ធ ទិវា ជាតិ ២០ ឧសភា ដើម្បី រំលឹក ដល់ វិញ្ញាណក្ខន្ធ អ្នក ដែល បាន ស្លាប់ ក្នុង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត
( បន្ទាយមានជ័យ )៖ នៅ ព្រឹក ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ព្រះសង្ឃ និង ប្រជាពលរដ្ឋ នៅ ខេត្ត បន្ទាយមានជ័យ បាន រៀបចំ ប្រារព្ធ ទិវា ជាតិ ២០ ឧសភា ដើម្បី រំលឹក ដល់ វិញ្ញាណក្ខន្ធ ប្រជាពលរដ្ឋ ដែល បាន ស្លាប់ បាត់បង់ជីវិត ក្នុង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
ពិធី នេះ មាន ការអញ្ជើញ ចូលរួម ពី លោក ខេង ស៊ុម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក អ៊ុ រាត្រី អភិបាល ខេត្ត ព្រមទាំង សមាជិក ក្រុមប្រឹក្សា ខេត្ត អភិបាល រង ខេត្ត អភិបាល ក្រុង មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត មន្ត្រីរាជការ លោកគ្រូ អ្នកគ្រូ ប្រជាពលរដ្ឋ តា ជី យាយ ជី សិស្សានុសិស្ស យុវជន កាយ រិទ្ធ យុវជន សសយក យ៉ាង ច្រើន កុះករ ផងដែរ ។
ទិវា ជាតិ នៃ ការចងចាំ ២០ឧសភា ជា កម្មវិធី រំលឹក ដល់ វិញ្ញាណក្ខន្ធ ដល់ ជនរងគ្រោះ ជាង ៣លាន នាក់ ដែល បាន ស្លាប់ បាត់បង់ជីវិត នៅក្នុង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។ ប្រជាជន កម្ពុជា គ្រប់ ៗ រូបចងចាំ មិន អាច បំភ្លេច បាន ក្នុង របប កម្ពុជា ប្រជាធិបតេយ្យ ឬ ហៅ ថា របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ( ១៧ មេសា ១៩៧៥ - ៦ មករា ១៩៧៩ ) ដែល ជា របប ដ៏ ឃោរឃៅ និង ខ្មៅ ងងឹត ។
តាមរយៈ សារ សំឡេង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា អ្នក ដែល បាន ចាក់ ដូស ទី៤ រួចហើយ កន្លងមក នៅក្នុង ប្រទេស កម្ពុជា មាន ដូចជា មន្រ្តី រាជការ អ្នកការទូត អ្នកសារព័ត៌មាន និង សិល្បករ សិល្បការិនី ជាដើម ។
សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ បន្ត រក្សា នូវ ស្ថានភាព ដ៏ ល្អ ប្រសើរ នេះ តាមរយៈ ការការពារ ខ្លួន ចំពោះ មុខ ជំងឺ កូវីដ១៩ ដែល មិន ទាន់ បាន បញ្ចប់ និង ទទួលយក វ៉ាក់សាំង ។ សម្តេច ក៏ អំពាវនាវ ឱ្យ ជន រួម ជាតិ ដែល ទទួលបាន ដូស ទី២ហើយ បន្ត ចាក់ដូស ទី៣ ។
គណៈកម្មការ ចំពោះ កិច្ច សម្រាប់ ចាក់ វ៉ាក់សាំង កម្ពុជា នឹង ផ្តល់ នូវ ព័ត៌មាន លម្អិត ទាក់ទង នឹង ទី កន្លែង ដែល ត្រូវ ចាក់ វ៉ាក់សាំង ដូស ទី៥ ជូន ដល់ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ អ្នកការទូត បុគ្គលិក អង្គការ សហ ប្រជាជាតិ អ្នកសារព័ត៌មាន និង សិល្បករ ផងដែរ ។
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ជម្រើស តែ មួយ គត់ ដែល ល្អ ជាង គេ ក្នុង ការការពារ ជីវិត ប្រជាជន គឺ វ៉ាក់សាំង ដោយ បាន ការពារ ការឆ្លង រោគ រាតត្បាត នេះ ។ សម្តេច ក៏ បាន ថ្លែងអំណរគុណ ដល់ ជន រួម ជាតិ ដែល បាន ចូលរួម សហការ ប្រយុទ្ធ នឹង ជំងឺ កាច សាហាវ នេះ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ដល់ ជន រួម ជាតិ ដែល បាន គាំទ្រ សម្តេច គាំទ្រ ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ហើយ បន្ត ដំណើរ ឈាន ទៅ មុខ ដើម្បី រក្សា នូវ សុខ សន្តិភាព រក្សា អ្វី ដែល កំពុង មាន នៅក្នុង ដៃ មិន ឱ្យ បាត់បង់ ។ យើង ធ្វើ ការ ច្រើន ហើយ យើង នឹង បន្ត ធ្វើ ទៀត ដើម្បី កូន ចៅ ។ សម្តេច សង្ឃឹម ថា ការគាំទ្រ នេះ ពិតជា មាន តម្លៃ សម្រាប់ សន្តិភាព ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍ សម្រាប់ ប្រទេស នេះ ៕
( ភ្នំពេញ ) ៖ សមាគម មន្ត្រីរាជការ តុលាការ និង អយ្យការ អម តុលាការ កំពូល នៅ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ បាន រៀបចំ មហាសន្និបាត របស់ សមាគម ក្រោម អធិបតីភាព កិត្តិនីតិកោសល បណ្ឌិត ឌិត មុន្នី ប្រធាន តុលាការ កំពូល . លោកស្រី ជា លាង អគ្គ ព្រះរាជអាជ្ញា នៃ មហា អយ្យការ អម តុលាការ កំពូល និង ប្រធាន គណៈកម្មាធិការ កណ្តាល របស់ សមាគម ។
មហាសន្និបាត នេះ ត្រូវបាន ប្រារព្ធ ឡើង ដើម្បី ធ្វើ ការបោះឆ្នោត ជ្រើសតាំង សមាសភាព គណៈកម្មាធិការ កណ្ដាល អាណត្តិ ថ្មី យោង តាម ប្រការ ១៦ នៃ លក្ខន្តិកៈ សមាគម មន្ត្រីរាជការ តុលាការ និង អយ្យការ អម តុលាការ កំពូល ដោយ មាន ការចូលរួម ពី ឯកឧត្តម លោកជំទាវ លោក លោកស្រី ជា សមាជិក សមាជិកា សមាគម ចំនួន ៩២ រូប ។
ជា លទ្ធផល មហាសន្និបាត បាន សម្រេច ជ្រើសតាំង សមាសភាព គណៈកម្មាធិការ កណ្តាល អាណត្តិ ថ្មី មាន ចំនួន ១៩ រូប និង បាន ជ្រើសតាំង លោក ជីវ កេង អនុប្រធាន តុលាការ កំពូល ជា ប្រធាន សមាគម ។
ក្រៅពី នេះ មហាសន្និបាត បាន ធ្វើ វិសោធនកម្ម លក្ខន្តិកៈ របស់ សមាគម ឱ្យ បាន សមស្រប តាម កាលានុវត្តភាព នៃ ការរីកចម្រើន ក្នុង សង្គម ជាក់ស្ដែង ក្នុង គោលបំណង លើកស្ទួយ ដល់ ការជួយ សម្រាល ទុក្ខ របស់ សមាជិក សមាគម ក្នុង ករណី មរណភាព ឬ ជួបប្រទះ នូវ ការលំបាក ខ្លាំង ៕ លោក ហ៊ុន ម៉ានី៖ ការចូលរួម ឃោសនា បោះឆ្នោត ពេលនេះ មិន ត្រឹមតែ ជា សេរីភាព បុគ្គល ទេ ប៉ុន្តែ ជាលំនឹង ប្រជាធិបតេយ្យ ដែល កម្ពុជា ប្រឹងប្រែង បណ្តុះ និង ទទួល ផ្លែ ផ្កា
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង ជា តំណាងរាស្រ្ត មណ្ឌល ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ នេះ ដែល ជា ថ្ងៃ ដំបូង នៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥នេះ បាន ធ្វើដំណើរ ទៅ មូលដ្ឋាន របស់ លោក ដើម្បី ធ្វើ ការឃោសនា ពី គោល នយោបាយ បក្ស ប្រជាជន កម្ពុជា ជូន ដល់ ប្រជាពលរដ្ឋ ។
លោក បាន លើកឡើង តាម បណ្តាញ សង្គម ហ្វេសបុក ថា ក្រោម ម្លប់ នៃ សន្តិភាព ថ្ងៃ នេះ ប្រជាជន កម្ពុជា ដែល គ្រប់ អាយុ បោះឆ្នោត បាន ចេញដំណើរ ទៅ តាម មូលដ្ឋាន រៀង ៗ ខ្លួន ធ្វើ ចលនា ឃោសនា គណបក្ស ដែល ខ្លួន គាំទ្រ ។
« នេះ មិន ត្រឹមតែ ជា សេរីភាព បុគ្គល ប៉ុន្តែ ជា ការសរបញ្ជាក់ ពី លំនឹង ប្រជាធិបតេយ្យ ដែល កម្ពុជា ខ្លួន ឯង ប្រឹងប្រែង បណ្តុះ និង ទទួលបាន ផ្លែ ផ្កា នៅ ពេល នេះ ។ ខ្ញុំ សូម ជូនពរ ឲ្យ ដំណើរការ នៃ យុទ្ធនាការ នេះ ប្រព្រឹត្តិ ទៅ ដោយ ជោគជ័យ ក្នុង ភាពថ្លៃថ្នូរ និង ដើម្បី អនាគត កម្ពុជា តែ មួយ » ។ នេះ បើ តាម លោក ហ៊ុន ម៉ានី ។
ឆ្លៀត ឱកាស នេះ លោក បាន ថ្លែងអំណរគុណ ដល់ សមាជិក យើង គ្រប់ រូប ដែល បាន ដាក់ ការជឿជាក់ មក លើ បក្ស ប្រជាជន កម្ពុជា ជារៀងរហូតមក ហើយក៏ សូម ជូនពរ ឲ្យ សមាជិក យើង គ្រប់ រូប ដែល ចូលរួម ក្នុង យុទ្ធនាការ នេះ បាន ប្រកបដោយ ភាពជោគជ័យ និង សុខ សុវត្ថិភាព ។
ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥នេះ មាន ឃុំ សង្កាត់ ចំនួន ១៦៥២ ដែល ត្រូវបាន បោះឆ្នោត ជ្រើសរើស សមាជិក្រុមប្រឹក្សា ឃុំ សង្កាត់ ចំនួន ២៨០០៨ នាក់ នៅ ទូទាំង ប្រទេស កម្ពុជា ។ ការបោះឆ្នោត នឹង ធ្វើឡើង នៅ ថ្ងៃទី ០៥ ខែមិថុនា ឆ្នាំ ២០២២ ចាប់ពី ម៉ោង ៧:០០ ព្រឹក រហូតដល់ ម៉ោង ៣:០០ រសៀល ៕ ១៤ ថ្ងៃ ទៀត នឹង ដល់ ថ្ងៃ បោះឆ្នោត ឃុំ ប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ ថ្ងៃទី ០៥ ខែមិថុនា ! តើ ប្រជាពលរដ្ឋ ត្រូវ មាន អ្វី ខ្លះ ដើម្បី បោះឆ្នោត បាន ?
កុំ ឲ្យ ថ្ងៃ សប្បាយ ក្លាយជា ទុក្ខ ដោយសារ ការបើកបរ របស់ អ្នក ! ស្លាប់ ៤នាក់ និង របួស ២នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២០ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ២នាក់ ។
នេះ ជា ការលើកឡើង របស់ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន ថ្លែង ក្នុង នាម ជា សហ ប្រធាន ដឹកនាំ វេទិកា កិច្ចសន្ទនា កម្រិត ខ្ពស់ ស្តីពី វិស័យ សកម្មភាព មីន នា ល្ងាច ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ នៅ ខេត្ត សៀមរាប ។
ទេសរដ្ឋមន្រ្តី លី ធុជ បាន បន្ត ទៀត ថា ដើម្បី សម្រេចបាន នូវ ចក្ខុវិស័យ ឆ្នាំ ២០២៥ កម្ពុជា គ្មាន មីន កាត់បន្ថយ ការគំរាមកំហែង នៃ សំណល់ ជាតិ ផ្ទុះ ពី សង្គ្រាម ជា អប្បបរមា និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម ប្រកបដោយ សុវត្ថិភាព យើង ត្រូវ បន្ត ពង្រឹង កិច្ច ខិតខំ ប្រឹងប្រែង កៀរគរ ធនធាន ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ពង្រឹង ទំនាក់ទំនង ល្អ ជាមួយ ម្ចាស់ ជំនួយ ដែល បាន កសាង ទំនុកចិត្ត គ្នា និង សម្រេច នូវ សមិទ្ធផល រួម ជាច្រើន ឆ្នាំ និង ស្វែងរក កិច្ចសហប្រតិបត្តិការ បន្ថែម ជាមួយ ម្ចាស់ ជំនួយ ថ្មី ៗ នា ពេល ខាងមុខ ។
ផ្ទុយទៅវិញ តាមរយៈ ផែនការ ខ្មៅក ខ្វក់ នេះ ក្រុម នេះ បន្ត ធ្វើ បាតុកម្ម អុក ឡុក បន្ត ទៀត នៅក្នុង អំឡុង ពេល យុទ្ធនាការ ឃោសនា បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ដោយ រៀបចំ ឱ្យ មាន សកម្មភាព ប៉ះទង្គិច ជាមួយ សមត្ថកិច្ច គ្រប់ រូបភាព តាម ដែល អាច ធ្វើ បាន ដូចជា បង្កឲ្យ មាន ភាពយឺតយ៉ាវ នៅពេល សមត្ថកិច្ច នាំឡើង លើ រថយន្ត ជាដើម ដើម្បី ឲ្យ ក្រុម ខ្លួន ថត សកម្មភាព យក ទៅ ផ្សព្វផ្សាយ មួល បង្កាច់ ឲ្យ ប្រជាពលរដ្ឋ អស់ ជំនឿ មក លើ អាជ្ញាធរ ។
សមត្ថកិច្ច ខេត្ត សៀមរាប ឃាត់ខ្លួន ជន បរទេស ម្នាក់ ករណី ហិង្សា ដោយ ចេតនា លើ ស្រ្តី ខ្មែរ
( សៀមរាប ) ៖ សមត្ថកិច្ច ខេត្ត សៀមរាប បាន ឃាត់ខ្លួន ជន បរទេស ម្នាក់ ករណី ហិង្សា ដោយ ចេតនា មាន ស្ថាន ទម្ងន់ ទោស ដោយ យក ញញួរ វាយ ជនរងគ្រោះ នៅ ថ្ងៃទី ១៨ ខែឧសភា ឆ្នាំ ២០២២ នៅ ចំនុច មុខ បន្ទប់ ជួល ស្ថិត នៅ ភូមិ បឹង ដូន ប៉ា សង្កាត់ ស្ល ក្រាម ក្រុង សៀមរាប ខេត្ត សៀមរាប ។
ចំណែក ជនសង្ស័យ ត្រូវបាន ឃាត់ខ្លួន ភ្លាម ៗ ហើយ បញ្ជូន មក សាកសួរ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត សៀមរាប ។
តាម របាយការណ៍ របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត សៀមរាប បច្ចុប្បន្ន ជនសង្ស័យ ត្រូវបាន កញ្ញា វ៉ា សក្កដា ព្រះរាជអាជ្ញា ( ស្តីទី ) នៃ អយ្យការ អម សាលាដំបូង ខេត្ត សៀមរាប សម្រេច ឲ្យ ឃាត់ខ្លួន បណ្តោះអាសន្ន នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ដើម្បី រៀបចំ កសាង សំណុំរឿង បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ចាត់ការ បន្ត តាម នីតិវិធី ច្បាប់ បន្ត ៕ ចំនួន ករណី កើត ជំងឺ អុត ស្វា នៅ ចក្រភព អង់គ្លេស កើន ដល់ ២០ករណី ក្រោយ រកឃើញ ១១ករណី ទៀត
កន្លងមក ប្រទេស អង់គ្លេស បាន រាយការណ៍ អំពី ករណី សរុប ចំនួន ៩ករណី នៃ ជំងឺ កម្រិត ស្រាល ជាធម្មតា ដែល ត្រូវបាន កំណត់ លក្ខណៈ ដោយ រោគសញ្ញា គ្រុន ក្តៅ និង កន្ទួល រមាស់ ។
សម្រាប់ ករណី ឆ្លង ថ្មី ចុងក្រោយ គេ បង្អស់ គឺ ត្រូវបាន រាយការណ៍ នៅក្នុង ប្រទេស បារាំង អ៉ីតាលី ស៊ុយអែត និង អូស្ត្រាលី ខណៈ ជំងឺ នេះ ភាគ ច្រើន កើតមាន នៅ តាម កន្លែង ដាច់ស្រយាល នៃ តំបន់ អាហ្វ្រិក កណ្តាល និង អាហ្រ្វិក ខាងលិច ជាដើម ។ ជាទូទៅ ករណី ឆ្លង ដែល លេចឡើង នៅ ក្រៅ តំបន់ នៃ ទ្វីប អាហ្រ្វិក ខាងលើ គឺ ភាគ ច្រើន ទាក់ទង ទៅ នឹង ការធ្វើដំណើរ ទៅកាន់ តំបន់ ទាំងនោះ ផ្ទាល់ ។
២៖ អ៊ុយក្រែន អះអាង ថា ការវាយប្រហារ របស់ រុស្ស៉ី លើ តំបន់ ដុន បាស់ កាន់តែ ខ្លាំង ឡើង
៣៖ ទិវា ជាតិ នៃ ការចងចាំ៖ សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ពលរដ្ឋ ឱ្យ រួមគ្នា ថែរក្សា សុខ សន្តិភាព
៥៖ លោក ហ៊ុន ម៉ាណែត៖ ទិវា ជាតិ នៃ ការចងចាំ ជា ការរំលឹក នូវ អតីតកាល នៃ ទុក្ខវេទនា ដ៏ សែន ជូរ ចត់ និង ឈឺចាប់ ខ្លោចផ្សា បំផុត ក្នុង ប្រវត្តិសាស្ដ្រ កម្ពុជា
៦៖ សហរដ្ឋ អាមេរិក មាន បំណង បញ្ជូន មីស៊ីល ប្រឆាំង នាវា ចម្បាំង ឱ្យ អ៊ុយក្រែន ដើម្បី ប្រយុទ្ធ តតាំង ជាមួយ នាវា ចម្បាំង រុស្ស៉ី
៧៖ ស្វែងយល់៖ « វេទិកា សេដ្ឋកិច្ច ពិភពលោក » ដែល នឹង មាន វត្តមាន សម្តេច តេជោ ហ៊ុន សែន ចូលរួម ក្នុង វេទិកា នេះ នៅ ប្រទេស ស្វីស
៨៖ ស្វែងយល់ ពី ប្រទេស ស្វីស ទីកន្លែង ដែល កំពុង ធ្វើជា ម្ចាស់ ផ្ទះ នៃ « វេទិកា សេដ្ឋកិច្ច ពិភពលោក »
៩៖ ស្នងការ រាជធានី ភ្នំពេញ ត្រៀម កម្លាំង ចំនួន ១. ១៣៥ នាក់ ដើម្បី ការពារ ក្នុង យុទ្ធនាការ ឃោសនា បោះឆ្នោត រយៈពេល ១៤ ថ្ងៃ
១០៖ ការបញ្ជូន អាវុធ ឱ្យ អ៊ុយក្រែន មិន មែន ជា ផ្លូវ ឆ្ពោះ ទៅរក សន្តិភាព ទេ . នេះ បើ តាម ប្រមុខ ការទូត ចិន
១១៖ បច្ចុប្បន្នភាព ប្រចាំ ថ្ងៃ៖ គិត ត្រឹម ព្រឹក ថ្ងៃទី ២០ ខែឧសភា នេះ តំបន់ អាស៊ាន មាន អ្នក ឆ្លង កូវីដ១៩ ជាង ៣១.៦លាន នាក់ និង ស្លាប់ ៣៥. ០ម៉ឺន នាក់
១២៖ រដ្ឋមន្រ្តី ការបរទេស អាមេរិក ចោទ រុស្ស៉ី ថា កំពុង ប្រើប្រាស់ ស្បៀងអាហារ ធ្វើជា អាវុធ នៅ អ៊ុយក្រែន
១៤៖ សេតវិមាន៖ លោក ចូ បៃ ដិន អាចនឹង បើក កិច្ចសន្ទនា ជាថ្មី ជាមួយ លោក ស៊ី ជិន ពីង នៅ ប៉ុន្មាន សប្ដាហ៍ ខាងមុខ នេះ
១៥៖ លោក ចូ បៃ ដិន ថា សហរដ្ឋ អាមេរិក គំា ទ្រ ពេញ ទំហឹង ឱ្យ ស៊ុយអែត និង ហ្វាំងឡង់ ចូលណា តូ
១៦៖ មេទ័ព កំពូល អាមេរិក - រុស្ស៉ី ជជែកគ្នា ជា លើក ដំបូង ចាប់តាំងពី សង្រ្គាម កើតមាន នៅ អ៊ុយក្រែន
១៧៖ ព្រឹទ្ធសភា អាមេរិក អនុម័ត ក្នុង សំឡេង គាំទ្រ លើសលប់ លើ កញ្ចប់ ជំនួយ ៤០ ពាន់ លាន ដុល្លារ សម្រាប់ អ៊ុយក្រែន
១៨៖ កូរ៉េ ខាងជើង អះអាង ថា ទទួលបាន លទ្ធផល ល្អ ប្រសើរ ក្នុង ការប្រយុទ្ធ ប្រឆាំង កូវីដ១៩ ខណៈ ចំនួន អ្នក ចេញ រោគសញ្ញា គ្រុន ក្តៅ កើន លើស២លាន នាក់
២១៖ វិភាគ អន្តរជាតិ៖ ដំណើរ ផ្សងព្រេង របស់ លោក ចូ បៃ ដិន មកកាន់ តំបន់ អាស៊ី
២៖ អ្នកដឹកនាំរឿង របស់ រុស្ស៊ី ប្រកាស ប្រឆាំង សង្គ្រាម នៅ អ៊ុយក្រែន អំឡុង ពេល ដាក់បញ្ចាំង ភាពយន្ត របស់ ខ្លួន នៅ បារាំង
រយៈពេល ៥ ថ្ងៃ ក្នុង សប្តាហ៍ នេះ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បង្ក្រាប រថយន្ត អត់ ពន្ធ ចំនួន ២៧ គ្រឿង នៅ ទូទាំង ប្រទេស
( ភ្នំពេញ ) ៖ រយៈពេល ៥ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១៦ ដល់ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ នេះ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន ធ្វើ ការបង្ក្រាប រថយន្ត អត់ ពន្ធ ចំនួន ២៧ គ្រឿង នៅ ទូទាំង ប្រទេស ដែល សុទ្ធសឹង ជ្រក ក្រោម ផ្លាកលេខ ក្លែងក្លាយ ។
រថយន្ត ទាំង២៧ គ្រឿង ដែល អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បង្ក្រាប បាន ក្នុង រយៈពេល ១ សប្តាហ៍ នេះ រួម មាន៖
ឱសានវាទ ចុងក្រោយ នៃ យុទ្ធនាការ ប្រមូល ពន្ធ អាករ លើ រថយន្ដ មាន ស្រាប់ នៅក្នុង ប្រទេស ត្រឹម ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២២ ហើយ ចាប់ពី ថ្ងៃទី ០១ ខែកក្កដា ឆ្នាំ ២០២២ត ទៅ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ពុំ មាន សិទ្ធ ទទួល បង់ ពន្ធ រថយន្ដ មាន ស្រាប់ ក្នុង ប្រទេស នោះ ទេ តួនាទី ដ៏ សំខាន់ គឺ ការចុះបង្ក្រាប ។
ករណី ដែល រថយន្ដ គ្មាន ពន្ធ បង្ក្រាប បាន ក្រោយ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២២ គឺ រថយន្ដ ចង្កូត ឆ្វេង ត្រូវ ទទួលរង នូវ ការ បង់ ពន្ធ អាករ តាម ច្បាប់ ជាធរមាន ផង និង បង់ ពិន័យ ថែម ទៀត ។ ដោយឡែក រថយន្ដ ចង្កូត ស្ដាំ នៅ ពេល ដែល បង្ក្រាប បាន នឹង ត្រូវ ដោះ បំណែក ដោយ បម្លែង រថយន្ដ ទៅជា គ្រឿង បំណែក រថយន្ដ ពីព្រោះ រថយន្ដ ចង្កូត ស្ដាំ គឺជា រថយន្ដ ហាមឃាត់ ក្នុង ការនាំចូល សម្រាប់ ប្រើប្រាស់ នៅក្នុង ប្រទេស និង មួយ ទៀត គឺ អាច កម្ទេចចោល តែម្ដង ។
លោក គុណ ញឹម ក៏ បាន អំពាវនាវ ដល់ ម្ចាស់ រថយន្ដ ទាំងឡាយ ដែល នៅ មិន ទាន់ នាំយក រថយន្ដ របស់ ខ្លួន ចូលមក បង់ ពន្ធ អាករ សូម រួសរាស់ មក បំពេញ កាតព្វកិច្ច ពន្ធ អាករ ឲ្យបាន ត្រឹម ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២២ ។
សូម ជម្រាប ថា ចាប់ពី ខែកញ្ញា ដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២១ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន អនុញ្ញាតឲ្យ រថយន្ត អត់ ពន្ធ ចង្កូត ឆ្វេង អាច ចូល បង់ ពន្ធ បាន ជាមួយ ការអនុគ្រោះ ពន្ធ - អាករ ១០ភាគរយ ។ ខណៈ រថយន្ត ចង្កូត ស្តាំ ( កែច ង្កួត រួច បង់ ពន្ធ ) ទទួលបាន ការអនុគ្រោះ ពន្ធ ១០ភាគរយ រហូតដល់ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២២ ។
គិត ត្រឹម ថ្ងៃទី ៣ ខែឧសភា ឆ្នាំ ២០២២ រថយន្ត គ្មាន ពន្ធ ជ្រក ក្រោម ផ្លាកលេខ ផ្សេង ៗ ទាំង ចង្កូត ឆ្វេង និង ចង្កូត ស្តាំ ចំនួន ជិត ៧ពាន់ គ្រឿង បាន ចូលខ្លួន ប្រកាស និង បង់ ពន្ធ ដែល គិត ជា ទឹកប្រាក់ ៦០ លាន ដុល្លារ បាន បង់ ចូល ថវិកា ជាតិ ៕
រដ្ឋបាល រាជធានី ភ្នំពេញ រៀបចំ កិច្ចប្រជុំ ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ចុងក្រោយ ឯកសារ ផែនទី បង្ហាញ ផ្លូវ យុទ្ធសាស្រ្ត ស្តីពី ទីក្រុង វៃ ឆ្លាត និង មាន ចីរភាព របស់ រាជធានី ភ្នំពេញ ឆ្នាំ ២០២២ - ២០៣៥
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន រៀបចំ កិច្ចប្រជុំ ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ចុងក្រោយ ឯកសារ ផែនទី បង្ហាញ ផ្លូវ យុទ្ធសាស្រ្ត ស្តីពី ទីក្រុង វៃ ឆ្លាត និង មាន ចីរភាព របស់ រាជធានី ភ្នំពេញ ឆ្នាំ ២០២២ - ២០៣៥ នៅ សាល ប្រជុំ ជាន់ ទី ១១ អគារ គ សាលា រាជធានី ភ្នំពេញ ដោយ មាន ការចូលរួម ពីសំណាក់ មន្រ្តី បច្ចេកទេស ជាន់ ខ្ពស់ របស់ ក្រសួង - ស្ថាប័ន ជំនាញ និង អ្នកជំនាញ ការពាក់ព័ន្ធ ជាច្រើន រូប ។
ឯកសារ នេះ បាន ឆ្លង គណៈកម្មការសិក្សា និង ប្រតិបតិ្ត គម្រោង អភិវឌ្ឍន៍ រាជធានី ភ្នំពេញ ប្រកបដោយ ចីរភាព និង ភាពវៃឆ្លាត ដែល មាន លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ជា ប្រធាន គណៈកម្មការ រួចរាល់ ផងដែរ ។
ក្នុង ឱកាស នោះ លោក បាន បន្ថែម ថា ដំណើរការ រៀបចំ ទីក្រុង ឆ្លាត គឺជា ដំណើរការ មួយ វែងឆ្ងាយ ដែល ទាមទារ នូវ ធនធាន ច្រើន ទាំង ធនធាន មនុស្ស ធនធាន ថវិកា ក៏ ដូចជា ការប្តេជ្ញាចិត្ត ពីសំណាក់ ថ្នាក់ដឹកនាំ គ្រប់ កម្រិត ប៉ុន្តែ ទោះបី យ៉ាងណា ក៏ដោយ យើង អាច ចាប់ផ្តើម ជាមួយនឹង គម្រោង ជាក់លាក់ មួយចំនួន ទៅ តាម លទ្ធភាព ដែល រាជធានី របស់ យើង ក៏ ដូចជា លទ្ធភាព នៃ ការសហការ និង ការគាំទ្រ ពី ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ។
ឯកសារ ផែនទី បង្ហាញ ផ្លូវ យុទ្ធសាស្រ្ត ស្តីពី ទីក្រុង វៃ ឆ្លាត និង មាន ចីរភាព នេះ បាន ផ្តោត សំខាន់ លើ វិស័យ គន្លឹះ ជា អាទិភាព ចំនួន ៥រួម មាន៖
* ទី១៖ ការគ្រប់គ្រង នគរ រូបនីយកម្ម ប្រកបដោយ ភាពឆ្លាតវៃ * ទី២៖ ទីក្រុង ដែល មាន សុវត្ថិភាព និង សន្តិសុខ * ទី៣៖ ប្រព័ន្ធ ចរាចរណ៍ ដែល មាន ភាពវៃឆ្លាត* ទី ៤៖ បរិស្ថាន រស់ នៅ វៃ ឆ្លាត* ទី ៥៖ អភិបាលកិច្ច ឆ្លាត ។
សម្រាប់ ការសិក្សា និង រៀបចំ ចង ក្រង ឯកសារ នេះ ត្រូវបាន ធ្វើឡើង ស្រប តាម លទ្ធភាព របស់ រដ្ឋបាល រាជធានី និង ការចូលរួម របស់ សមាគម (AIMF) ដែល នៅក្នុង ដំណាក់កាល ចុងក្រោយ នេះ រដ្ឋបាល រាជធានី ស្នើសុំ ឲ្យ មាន ការចូលរួម មតិ យោបល់ របស់ ក្រសួង - ស្ថាប័ន ជំនាញ ពាក់ព័ន្ធ ដើម្បីឱ្យ ឯកសារ នេះ មាន លក្ខណៈ ផ្លូវការ និង កាន់តែ គ្រប់ ជ្រុងជ្រោយ បន្ថែម ទៀត ។
កិច្ចប្រជុំ ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ចុងក្រោយ ក្នុង ថ្ងៃ នេះ ទទួលបាន មតិ យោបល់ និង ធាតុ ចូល ពីសំណាក់ មន្រ្តី ជំនាញ របស់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ រួម មាន៖ ក្រសួង រៀបចំ ដែនដី នគរ រូបនីយកម្ម និង សំណង់ . សាកលវិទ្យាល័យ ភូមិន្ទ វិចិត្រ សិល្បៈ . សាកលវិទ្យាល័យ បច្ចេកវិទ្យា កម្ពុជា . ក្រសួង សាធារណៈការ និង ដឹកជញ្ជូន . ក្រសួង បរិស្ថាន . ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ៕
លោក ឥត សារ៉ាត់ ប្រាប់ ឱ្យ សមាជិក បក្ស ត្រូវ ក្តាប់ ឱ្យ ជាប់ ចំនួន សមាជិក ដើម្បី យក ជ័យជម្នះ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥
( សៀមរាប ) ៖ លោក ឥត សារ៉ាត់ សមាជិក គណៈ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ការ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ក្រុង សៀមរាប បាន ប្រាប់ ទៅ បេក្ខជន ពេញ សិទ្ធិ និង បេក្ខជន បម្រុង ទាំងអស់ ត្រូវ ក្តាប់ និង គ្រប់គ្រង ឱ្យ ជាប់ ចំនួន សមាជិក បក្ស ឱ្យ បាន ច្បាស់លាស់ ដើម្បី ដណ្តើម ជ័យជម្នះ ថ្ងៃ បោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ដែល នឹង ប្រព្រឹត្ត នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ នេះ ។
ការណែនាំ បែប នេះ របស់ លោក ឥត សារ៉ាត់ បាន ធ្វើឡើង ក្នុង ឱកាស ជួប សំណេះសំណាល ជាមួយ បេក្ខជន ពេញ សិទ្ធិ និង បេក្ខជន បម្រុង ក្រុមប្រឹក្សា សង្កាត់ អាណត្តិ ទី៥ និង សកម្មភាព ការងារ ដើម្បី ឆ្ពោះ ទៅកាន់ ការបោះឆ្នោត ជ្រើសរើស ក្រុប្រឹក្សា សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ក្រុង សៀមរាប ។
ក្រោយ ស្តាប់ របាយការណ៍ របស់ ប្រធាន គណៈកម្មាធិការ បក្ស ក្រុង សៀមរាប រួច . លោក ឥត សារ៉ាត់ ក៏ បាន ណែនាំ ឱ្យ ក្រុមការងារ នៅ តាម សង្កាត់ ទាំង ១២ នៃ ក្រុង សៀមរាប ត្រូវ យកចិត្តទុកដាក់ តាមដាន ត្រួតពិនិត្យមើល សមាជិក គណបក្ស និង អ្នកគាំទ្រ គណបក្ស ដែល មិន ទាន់ មាន អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ប្រភេទ ថ្មី ឬ មាន ដែរ តែ ហួស សុពលភាព ឬ បាត់ ឬ ខូច ត្រូវ ចាត់ចែង ជួយ ពួកគាត់ ឱ្យ ទៅ ធ្វើ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ បម្រើ ឱ្យ ការបោះឆ្នោត នៅ គណៈកម្មការ ឃុំ សង្កាត់ រៀបចំ ការបោះឆ្នោត ឱ្យ បាន ទាន់ ពេល វេលា ។
ក្នុង នាម ជា ប្រធាន ក្រុមការងារ រាជ រដ្ឋាភិបាល ចុះ មូលដ្ឋាន ក្រុង សៀមរាប . លោក ឥត សារ៉ាត់ បាន សង្កត់ធ្ងន់ ថា « បើ គណបក្ស យើង ឈ្នះ យើង ឈ្នះ ទាំងអស់ គ្នា ព្រោះ យើង ជិះ ទូក ជាមួយគ្នា ដូច ច្នេះ យើង ត្រូវ ខិតខំ ប្រឹងប្រែង ធ្វើ យ៉ាងណា ដើម្បី ទទួលបាន ជ័យជំនះ សម្រាប់ ការបោះឆ្នោត នា ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ ខាងមុខ នេះ » ។
បន្ថែម ពី នេះ លោក ឥត សារ៉ាត់ ក៏ បាន ណែនាំ ដល់ ថ្នាក់ដឹកនាំ គណបក្ស ទាំងអស់ ត្រូវ ខិតខំ ពង្រឹង សាមគ្គី គ្នា ជា ធុង មួយ ដើម្បី គាំទ្រ គោល នយោបាយ របស់ គណបក្ស ប្រជាជន កម្ពុជា ។
លោក ក៏ បាន កោតស សើរ ចំពោះ សមាជិក សមាជិក បក្ស ក្រុង ទាំងអស់ ដែល រក្សា បេះដូង គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ព្រមទាំង បាកៀរគ អ្នកគាំទ្រ មកពី គណបក្ស ផ្សេង ៗ ឱ្យ ចូលរួម ជីវភាព នយោន បាយ ជាមួយ គណប ក្យ ប្រជាជន កម្ពុជា ជា បន្តបន្ទាប់ ជាពិសេស បាន បម្រើ ប្រជាពលរដ្ឋ តាម តួនាទី ភារកិច្ច ដែល ថ្នាក់ លើ ប្រគល់ជូន ។ បន្ថែម ពី នេះ ស្តែង ឱ្យ ឃើញ ក្នុង ដំណាក់កាល រាត្បាត នៃ ជំងឺ កូវីដ១៩ សមាជិក សមាជិកា គណបក្ស បាន លះបង់ គ្រប់ បែបយ៉ាង ដើម្បី ទប់ស្កាត់ ការរីករាល នៃ ជំងឺ នេះ ជាមួយ រាជ រដ្ឋាភិបាល យ៉ាង សស្រាកស្រាំ ផងដែរ ។
បន្ថែម ពី នេះ លោក ឥត សារ៉ាត់ ក៏ បាន លើកឡើង ថា ក្នុង នាម ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា របស់ គណបក្ស ត្រូវ ខិតខំ ធ្វើ យ៉ាងណា ដើម្បី បំពេញ កាតព្វកិច្ច ឱ្យ បាន ល្អ និង ត្រៀមលក្ខណៈ ឱ្យ បាន គ្រប់គ្រាន់ សម្រាប់ យុទ្ធនាការ ឃោសនា បោះឆ្នោត ដែល នឹង ចាប់ផ្តើម នូវ ថ្ងៃទី ២១ ខែឧសភា ឆ្នាំ ២០២២ ស្អែក នេះ ជាពិសេស ត្រូវ អនុវត្ត ឱ្យ បាន ត្រឹមត្រូវ តាម ច្បាប់ រដ្ឋធម្មនុញ្ញ និង ការកំណត់ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) ជាពិសេស មិន ត្រូវ ធ្វើ អ្វី ឱ្យ មាន កំហុសឆ្គង ជាដាច់ខាត ។
លោក ឥត សារ៉ាត់ បាន គូសបញ្ជាក់ ថា៖ « យើង ត្រូវតែ ចូលរួម ប្រកួតប្រជែង ឱ្យ បាន ត្រឹមត្រូវ ដើម្បី អនុវត្ត តាម ច្បាប់ គឺ យើង ឈ្នះ ឈ្នះ ដោយ ត្រឹមត្រូវ ឈ្នះ ដោយ យុត្តិធម៌ នេះ ជា ការប្តេជ្ញាចិត្ត ខ្ពស់ ណាស់ របស់ គណបក្ស យើង ដូច្នេះ យើង ត្រូវ គោរព ច្បាប់ នៃ ការបោះឆ្នោត » ។
លោក បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សមាជិក សមាជិកា របស់ គណបក្ស ដែល បាន ខិតខំ ប្រឹងប្រែង កន្លងមក ហើយក៏ បាន ជំរុញ ដល់ អង្គ ពិធី ទាំងអស់ ឱ្យ ចូលរួម ឱ្យ សកម្ម បន្ថែម ទៀត ក្នុង ការបំពេញ តួនាទី របស់ ខ្លួន ព្រោះ ទាំងអស់ គ្នា ជា ផ្នែក មួយ ដ៏ សំខាន់ សម្រាប់ គណបក្ស ប្រជាជន កម្ពុជា ៕ លោក ហង់ ជួន ណារ៉ុន បញ្ចូល សមាជិក គណបក្ស ប្រជាជន ថ្មី ២៨២ នាក់ នៅ ឃុំ កង តាណឹង ស្រុក កង មាស ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ លោក បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ត្រី ក្រសួង អប់រំ យុវជន និង កីឡា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ស្រុក កង មាស បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី សំណេះសំណាល និង បញ្ចូល សមាជិក គណបក្ស ប្រជាជន កម្ពុជា ថ្មី ក្នុង ឃុំ កង តាណឹង ស្រុក កង មាស ខេត្ត កំពង់ចាម ។
កម្មវិធី នេះ សមាជិក គណបក្ស ប្រជាជន ថ្មី ចំនួន ២៨២ នាក់ ( ស្រី ១៥០ ) ត្រូវបាន ប្រកាស បញ្ចូល ជា សមាជិក បក្ស ។ ក្នុង ឱកាស នោះ តំណាង សមាជិក បក្ស ដែល បាន ចូលរួម ថ្មី បាន លើកឡើង ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា ប៉ុណ្ណោះ ដែល មាន ឧត្តម គតិ ត្រឹមត្រូវ មាន គុណ បំបាច់ ធំ ធេង ចំពោះ ជាតិ មាតុភូមិ មាន ការអភិវឌ្ឍ រីកចម្រើន គ្រប់ វិស័យ និង គោរព ទាំងស្រុង នូវ កម្មវិធី នយោបាយ និង លក្ខខន្តិកៈ ព្រមទាំង ប្តេជ្ញា ថា នឹង ចូលរួម ជីវភាព នយោបាយ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ។
ក្នុង ឱកាស នេះ លោក រដ្ឋមន្ត្រី ហង់ ជួន ណារ៉ុន បាន លើកឡើង អំពី លក្ខណៈ សម្បត្តិ ពេញលេញ និង សមិទ្ធផល ធំ ធេង ដែល គណបក្ស ប្រជាជន កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច អគ្គ សេនា បតី តេជោ ហ៊ុន សែន បាន ធ្វើ ដើម្បី ប្រជាពលរដ្ឋ និង ប្រទេសជាតិ ។
លោក រដ្ឋមន្រ្ដី ក៏ បាន វាយតម្លៃ ខ្ពស់ ដល់ ថ្នាក់ដឹកនាំ បក្ស និង ក្រុមការងារ ចុះ ជួយ ឃុំ សម្រាប់ ការកសាង សមិទ្ធផល ជាច្រើន ក្នុង ឃុំ ព្រមទាំង បាន អំពាវនាវ ឲ្យ សមាជិក ទាំងអស់ ចូលរួម បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា នា ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ ខាងមុខ ។
សូម ជម្រាប ថា ការធ្វើ យុទ្ធនាការ ឃោសនា បោះឆ្នោត នឹង ប្រព្រឹត្តទៅ រយៈពេល ១៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២១ ខែឧសភា ដល់ ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០២២ ដោយឡែក សម្រាប់ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ គឺជា ថ្ងៃ ដំណើរការបោះឆ្នោត ៕ ១៥ ថ្ងៃ ទៀត នឹង ដល់ ថ្ងៃ បោះឆ្នោត ឃុំ ប្រឹក្សា ឃុំ - សង្កាត់ អាណត្តិ ទី៥ ថ្ងៃទី ០៥ ខែមិថុនា ! តើ ប្រជាពលរដ្ឋ ត្រូវ មាន អ្វី ខ្លះ ដើម្បី បោះឆ្នោត បាន ?
សូម បញ្ជាក់ ថា ផ្អែក តាម របាយការណ៍ ផ្លូវការ នៃ ការចុះបញ្ជី បេក្ខជន គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត ដែល ទទួលបាន ពី គណៈកម្មការ រាជធានី - ខេត្ត រៀបចំ ការបោះឆ្នោត . មាន គណបក្ស នយោបាយ ចំនួន ១៧ និង មាន បេក្ខជន សរុប ចំនួន ៨៦. ០៩២ នាក់ ក្នុង នោះ ស្រ្តី មាន ចំនួន ២៧. ៨១៣ នាក់ ត្រូវបាន ចុះបញ្ជី សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ៕ តំណាង លោក ហ៊ុន ម៉ានី ចូលរួម ទិវា ជាតិ នៃ ការចងចាំ នៅ ទំនប់ អាភាព ហៅ ម. ៤០១ ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ នេះ នៅ វិមាន នៃ ការចងចាំ ស្ថិត នៅ ទំនប់ អាភាព ហៅ ម. ៤០១ មាន រៀបចំ កម្មវិធី ជាតិ នៃ ការចងចាំ ដោយ មាន ការអញ្ជើញ ចូលរួម ជា អធិបតី ពីសំណាក់ លោក បណ្ឌិត ហេង សុខ គង់ សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុប្រធាន ទី១ ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ស្រុក បសេដ្ឋ ខេត្ត កំពង់ស្ពឺ តំណាង លោក ហ៊ុន ម៉ានី អ្នកតំណាងរាស្រ្ត មណ្ឌល កំពង់ស្ពឺ និង លោកស្រី ។
ចូលរួម ក្នុង ឱកាស នោះ ផងដែរ មាន លោក វេជ្ជបណ្ឌិត ស្រូយ អាដុល្លារ អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក បសេដ្ឋ និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ឃ៉ំ កាត់ ភ្លុក ឧកញ៉ា ស៊ុន ប៊ុន ហេង និង លោកស្រី ព្រមទាំង ក្រុមការងារ និង លោកតា លោកយាយ ប្រជាពលរដ្ឋ ក្នុង ភូមិ ឃុំ ស្រុក និង បណ្តា ខេត្ត មួយចំនួន ដែល មាន ញាតិការ បាន ស្លាប់ នៅ ទីនេះ ប្រមាណ ជិត ២០០ នាក់ ផងដែរ ។
ក្នុង របាយការណ៍ ថ្ងៃសុក្រ នះ ដែរ វៀតណាម ក៏ បាន រកឃើញ ករណី អ្នកស្លាប់ ថ្មី ម្នាក់ ទៀត ផងដែរ ។
អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក សន្ទុក ជួប សំណេះសំណាល ជាមួយ សមាជិក អតីត យុទ្ធជន ក្នុង ឃុំ ក្រយា១៧៩ នាក់
( កំពង់ធំ )៖ ដោយ មាន ការចង្អុលបង្ហាញ ពី ថ្នាក់ដឹកនាំ . លោក ម៉ែន លី អនុប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក សន្ទុក បាន ដឹកនាំ សហការី អញ្ជើញ ទៅ សំណេះសំណាល សាកសួរ សុខទុក្ខ បងប្អូន អតីត យុទ្ធជន ដែល កំពុង រស់ នៅ លើ ដី សម្បទាន សង្គមកិច្ច ស្ថិត នៅ ភូមិ ដង ក្តា ឃុំ ក្រយា ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ ។
លោក ម៉ែន លី បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល សម្តេច ទាំង ទ្វេរ លោក តែងតែ យកចិត្តទុកដាក់ គិត គូរ ខ្ពស់ ដល់ ជីវភាព រស់ នៅ របស់ បងប្អូន អតីត យុទ្ធជន គ្រប់ ពេលវេលា ។
លោក បាន ផ្តាំផ្ញើ តាមរយៈ ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត កំពង់ធំ ជូនពរ ដល់ បងប្អូន អតីត យុទ្ធជន ទាំងអស់ និង ក្រុមគ្រួសារ សូម បាន ប្រកបដោយ សេចក្ដីសុខ សេចក្ដីចម្រើន មាន សុខភាព ល្អ សុភមង្គល និង ជោគជ័យ គ្រប់ ភារកិច្ច ។
កន្លងទៅ រាជ រដ្ឋាភិបាល បាន សង្កេតឃើញ ថា ការពិសា គ្រឿងស្រវឹង គ្រប់ ប្រភេទ ភាគ ច្រើន អាច បង្កឱ្យ មាន អំពើហិង្សា គ្រោះថ្នាក់ ចរាចរណ៍ គ្រោះថ្នាក់ សង្គម ការប្រព្រឹត្ត បទល្មើស នានា ឬ ករណី ខ្លះ អាច បណ្ដាលឱ្យ បាត់ សណ្ដាប់ធ្នាប់ សាធារណៈ ថែម ទៀត ផង ។
អនុលោម តាម ច្បាប់ បទបញ្ជា និង នីតិវិធី សម្រាប់ ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ និង ដើម្បីឱ្យ ដំណើរការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ដែល ព្រះរាជាណាចក្រ កម្ពុជា បាន កំណត់ រៀបចំ ធ្វើ នៅ ថ្ងៃទី ៥ ខែមិថុនា ឆ្នាំ ២០២២ ប្រព្រឹត្តទៅ ដោយ សេរី ត្រឹមត្រូវ និង យុត្តិធម៌ គ្មាន អំពើហិង្សា គ្មាន ការគំរាមកំហែង គ្មាន ការបំភិតបំភ័យ និង គ្មាន បាតុភាព នានា ដែល អាច កើត មាន ឡើង ដោយសារតែ ការពិសា គ្រឿងស្រវឹង នោះ រាជ រដ្ឋាភិបាល សូម ធ្វើ ការណែនាំ ដូច ខាងក្រោម ៖
ស្វែងរក វិជ្ជា កិត្តិយស មាន សេព គ្រឿងញៀន នាំមហន្ដរាយ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែឧសភា៖ បង្ក្រាប ១៦ករណី ឃាត់ខ្លួន ៣៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២០ ខែឧសភា ឆ្នាំ ២០២២ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៦ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១០ករណី . ដឹកជញ្ជូន រក្សាទុក ៣ករណី និង ជួញដូរ ៣ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៣៦ នាក់ ។
