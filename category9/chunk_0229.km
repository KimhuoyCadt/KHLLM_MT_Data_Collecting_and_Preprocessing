( កំពង់ធំ )៖ លោក ងួន រតនៈ អភិបាល ខេត្ត កំពង់ធំ បាន ដាស់តឿន ដល់ ប្រធាន អង្គភាព ទាំងអស់ ត្រូវ ទទួលខុសត្រូវ ចំពោះ មុខ ច្បាប់ រាល់ កិច្ចការងារ របស់ ខ្លួន ។
លោក បាន ថ្លែង យ៉ាង ដូច្នេះ នៅក្នុង កិច្ចប្រជុំ ប្រចាំ ខែ របស់ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត កំពង់ធំ រសៀល ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២២ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត ព្រះរាជអាជ្ញា កងកម្លាំង ទាំង បី ប្រភេទ និង អភិបាល ក្រុង ស្រុក ។
លោក ក៏ បាន ជំរុញ ឲ្យ រដ្ឋបាល ឃុំ ត្រូវ បង្កើន ការយកចិត្ត ទុក្ខ ដាក់ ផ្តល់ សេវា និង សុខ ទុក្ខ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន របស់ ខ្លួន ឲ្យបាន ល្អ ដូចជា ការផ្តល់ សេវា ប្រកបដោយ តម្លាភាព ឆាប់រហ័ស ជឿជាក់ និង ដោះស្រាយ បញ្ហា ផ្សេង ៗ ជូន ប្រជាពលរដ្ឋ ពិសេស ពលរដ្ឋ ដែល ងាយ រងគ្រោះ ឲ្យ ទាន់ ពេល វេលា ។
លើស ពី នេះ លោក បាន ឲ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច កងកម្លាំង ទាំង បី ត្រូវ ក្តាប់ ព័ត៌មាន សន្តិសុខ សុវត្ថិភាព តាម មូលដ្ឋាន និង សន្តិសុខ ឲ្យបាន ដើម្បី ឆ្លើយតប ឬ បង្ក្រាប បទល្មើស និង ជួយ ជនរងគ្រោះ បាន ទាន់ ពេល វេលា ។
ទាក់ទង និង បទល្មើស ព្រៃឈើ ត្រូវ ត្រួតពិនិត្យ ទៅ លើ ឈ្មួញ ដែល ទិញ ឈើ តើ មាន ច្បាប់ អនុញ្ញាត ឬ អត់ ហើយ សមត្ថកិច្ច ជំនាញ និង សមត្ថកិច្ច ពាក់ព័ន្ធ ដែល នៅ ឈរ ជើង តំបន់ នោះ ហាក់បីដូចជា មិន ចាប់អារម្មណ៍ មាន សភាព ធូរលុង បណ្តែត បណ្តោយ ឲ្យ សមកម្មភាព ដឹកជញ្ជូន ឈើ តាម រថយន្ត រឺ គោយន្ត កន្ត្រៃយ៍ ចេញ តាំងពី ក្នុង ព្រៃ រហូតមកដល់ ផ្លូវ ជាតិ កំពុងតែ មាន កម្មភាព យ៉ាង រលូន ដោយ ពុំ មាន ទប់ស្កាត់ អ្វី ឡើយ បើ បាត ដៃ យើង មិន ស្អាត ការបង្ក្រាប បទល្មើស គឺ មិន ទទួល ជោគជ័យ ដែរ ។
លោក ងួន រតនៈ ក៏ បាន ឲ្យ អាជ្ញាធរ មូលដ្ឋាន ត្រូវ ត្រួតពិនិត្យ ទៅ លើ ការចាក់ វ៉ាក់សាំង របស់ ប្រជាពលរដ្ឋ ថា តើ បាន ចាក់ ប៉ុន្មាន លើក ហើយ ។
លោក បាន អំពាវនាវ ដល់ មន្ត្រី កងកម្លាំង ប្រជាពលរដ្ឋ សូម ចូលរួម បរិច្ចាក ជា ថវិកា សម្ភារៈ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ដើម្បី យក ថវិកា និង សម្ភារៈ ទាំងអស់ នោះ យក ទៅ ជួយ ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បាន ទាន់ ពេល ៕ រដ្ឋបាល ខណ្ឌ ទួលគោក ត្រៀម រៀបចំ ឱ្យ ពលរដ្ឋ នៅ ស្ថានីយ៍ បូម ទឹក ទួលគោក ២ ចាប់ ឆ្នោត យក ដី ឡូតិ៍ ប្រទាន កម្ម របស់ សម្ដេច តេជោ ហ៊ុន សែន
( ភ្នំពេញ ) ៖ នៅពេល ខាងមុខ រដ្ឋបាល ខណ្ឌ ទួលគោក និង មាន រៀបចំ ពិធី ជូន ប្រជាពលរដ្ឋ មួយចំនួន ឱ្យ ចូលរួម ចាប់ ឆ្នោត ទទួលយក ដី ឡូតិ៍ ដែល ជា ប្រទាន កម្ម ដី ដ៏ ថ្លៃថ្លា របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោយពី បញ្ហា ស្មុកស្មាញ ជាច្រើន ត្រូវបាន ដោះស្រាយ បញ្ចប់ ដោយ តម្លាភាព នឹង ដោយ មាន ការយកចិត្តទុកដាក់ សម្របសម្រួល គ្រប់ បែបយ៉ាង របស់ មន្ត្រី និង ការិយាល័យ ជុំ នាញ ពាក់ព័ន្ធ ហើយ នឹង អាជ្ញាធរ គ្រប់ ជាន់ ថ្នាក់ តាំងពី ភូមិ - សង្កាត់ - ខណ្ឌ - រាជធានី ។
( រតនគិរី ) ៖ នៅ ល្ងាច ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២២ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ សហការ ជាមួយ រដ្ឋបាល ខេត្ត រតនគិរី បាន រៀបចំ សិក្ខាសាលា ពិគ្រោះយោបល់ លើ សេចក្តីព្រាង ប្លង់ គោល ប្រើប្រាស់ ដី ស្រុក អូរជុំ និង ស្រុក បរ កែវ ។
សិក្ខាសាលា ដ៏ មាន សារៈសំខាន់ នេះ ធ្វើឡើង នៅ សាល ប្រជុំ សាលា ខេត្ត រតនគិរី ក្រោម អធិបតីភាព លោក ឌុច វន ទី តូ អនុ រដ្ឋលេខាធិការ ក្រសួង រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ និង លោក ញ៉ែម សំអឿន អភិបាល ខេត្ត រតនគិរី ។
សូម បញ្ជាក់ ថា ការសិក្សា ស្តីពី ប្លង់ គោល ប្រើប្រាស់ ដី ស្រុក អូរជុំ និង ស្រុក បរ កែវ ខេត្ត រតនគិរី ក៏ ជា ផ្នែក មួយ នឹង ជួយ ជំរុញ ឲ្យ ភូមិភាគ ឦសាន្ត ដែល ជា តំបន់ កន្ទុយ នាគ ឲ្យ ក្លាយទៅជា ប៉ូល សេដ្ឋកិច្ច ទី៤ តាមរយៈ ការប្រែក្លាយ សក្តានុពល ដី មាន ជីវជាតិ សម្បូរ ធនធាន ធម្មជាតិ រួមផ្សំ ជាមួយ កត្តា ភូមិសាស្ត្រ ផង ឱ្យ ទៅជា ការអភិរក្ស និង អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព មាន គោលដៅ រួម និង មាន ចរឹត អន្តរ វិស័យ ៕
អ្នកនាំពាក្យ៖ ក្រសួង ការងារ កំពុង ពិនិត្យ ផ្ទៀងផ្ទាត់ បន្ថែម ជាមួយ បងប្អូន អតីត បុគ្គលិក ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ដែល ត្រូវបាន បញ្ឈប់ ពី ការងារ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២២ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន របស់ ការិយាល័យ អ្នកនាំពាក្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ជុំវិញ បញ្ហា ការងារ អតីត បុគ្គលិក ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ។ នេះ បើ តាម សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ០៤ ខែឧសភា ។
ក្នុង សេចក្ដីប្រកាស ព័ត៌មាន បាន ឲ្យដឹង ថា នា ពេល កន្លងមក មាន បងប្អូន អតីត បុគ្គលិក ក្រុមហ៊ុន ណាហ្គាវើលដ៍ មួយចំនួន បាន គោរព ស្នើសុំ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ឲ្យ ជួយ អន្តរាគមន៍ ក្រុមហ៊ុន ផ្តល់ ប្រាក់ បំណាច់ បញ្ចប់ កិច្ចសន្យា ការងារ ស្រប តាម ច្បាប់ ស្តីពី ការងារ ចំពោះ បងប្អូន អតីត បុគ្គលិក ដែល ត្រូវបាន បញ្ឈប់ ពី ការងារ រួម និង ស្វែងរក ឱកាស ការងារ ថ្មី ដើម្បី ទទួលបាន ប្រាក់ ចំណូល ទៀងទាត់ សម្រាប់ ផ្គត់ផ្គង់ ជីវភាព គ្រួសារ ។
អនុវត្ត តាម គោលការណ៍ ណែនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច ក្រឡាហោម មន្ត្រី ជំនាញ របស់ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ធ្វើ ការពិនិត្យ ផ្ទៀងផ្ទាត់ ការទូទាត់ ប្រាក់ បំណាច់ បញ្ចប់ កិច្ចសន្យា ការងារ ជាមួយ តំណាង ក្រុមហ៊ុន ហើយ ពិនិត្យ ឃើញ ថា ការទូទាត់ ចំនួន ៤ ចំណុច គឺ បាន ត្រឹមត្រូវ ស្រប តាម ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្តិ ពាក់ព័ន្ធ នឹង ការបញ្ឈប់ ពី ការងារ រួម ។
ទន្ទឹមនឹង នេះ មន្ត្រី ជំនាញ របស់ ក្រសួង បាន និង កំពុង រង់ចាំ ធ្វើ ការពិនិត្យ ផ្ទៀងផ្ទាត់ បន្ថែម ជាមួយ បងប្អូន អតីត បុគ្គលិក ដែល ត្រូវបាន បញ្ឈប់ ពី ការងារ រួម និង នៅ មាន ចម្ងល់ អំពី ការទូទាត់ នេះ ។ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក៏ បាន ជួយ ស្វែងរក ឱកាស ការងារ ថ្មី សម្រាប់ បងប្អូន អតីត បុគ្គលិក ។
ដោយឡែក គិត ត្រឹម ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២២ នេះ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ នៅ មិន ព្រម ទទួលយក បងប្អូន អតីត បុគ្គលិក ណាមួយ ដែល ត្រូវបាន បញ្ឈប់ ពី ការងារ រួម ឲ្យ ចូល ធ្វើ ការវិញ ដូច ការលើកឡើង របស់ មតិ មួយចំនួន ឡើយ ៕
រហូតមកដល់ ពេលនេះ លោក ពូទីន បាន ពណ៌នា សកម្មភាព របស់ រុស្ស៊ី នៅ អ៊ុយក្រែន ថា ជា « ប្រតិបត្តិការ យោធា ពិសេស » ជាជាង សង្រ្គាម ។ ប៉ុន្តែ អ្នកនយោបាយ លោក ខាងលិច និង អ្នកសង្កេតការណ៍ រុស្ស៊ី មួយចំនួន បាន ប៉ាន់ស្មាន ថា លោក អាចនឹង រៀបចំ សម្រាប់ សេចក្តីប្រកាស ដ៏ សំខាន់ មួយ នៅ ថ្ងៃចន្ទ សប្តាហ៍ ក្រោយ ដោយ មើលឃើញ ពី សេណារីយ៉ូ ជាច្រើន ដែល អាច កើតមាន ដូចជា ការប្រកាស សង្រ្គាម ច្បាស់លាស់ ឬ ការប្រកាស ជ័យជម្នះ ។
គួរ បញ្ជាក់ ថា ទិវា ជ័យ ជំនះ ដែល ត្រូវនឹង ថ្ងៃទី ៩ នៃ ខែឧសភា នេះ គឺជា ព្រឹត្តិការណ៍ ជាតិ ដ៏ សំខាន់ បំផុត មួយ នៅក្នុង ប្រទេស រុស្ស៊ី និង ជា ការចងចាំ នៃ ការលះបង់ ដ៏ ធំ របស់ សូវៀត ដែល បាន ធ្វើឡើង ក្នុង អំឡុង ពេល ការបរាជ័យ របស់ ណាស៊ី អាល្លឺម៉ង់ នៅក្នុង អ្វី ដែល ត្រូវបាន គេ ស្គាល់ នៅក្នុង ប្រទេស រុស្ស៊ី ថា ជា សង្រ្គាម ស្នេហាជាតិ ដ៏ អស្ចារ្យ ៕
១៖ ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ អ្នក ឆ្លង ថ្មី ប្រភេទ អូមី ក្រុង ១នាក់ . ជាសះស្បើយ ១២នាក់ និង គ្មាន អ្នកស្លាប់
២៖ អ៊ុយក្រែន ទទួលបាន ជំនួយ ហិរញ្ញវត្ថុ ពី អន្តរជាតិ សរុប ៤. ៧៣ ពាន់ លាន ដុល្លារ ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង
៣៖ រថយន្ត គ្មាន ពន្ធ ជ្រក ក្រោម ផ្លាកលេខ ផ្សេង ៗ ចំនួន ជិត ៧ពាន់ គ្រឿង ចូល ខ្លួន បង់ ពន្ធ ទទួល ចំណូល ជិត សម្រាប់ ថវិកា ជាតិ បាន ៦០ លាន ដុល្លារ
៤៖ អូស្ត្រាលី ប្រកាស ដាក់ទណ្ឌកម្ម លើ សមាជិក សភា រុស្ស៉ី ៧៥ រូប រួមទាំង រដ្ឋមន្ត្រី នៃ តំបន់ ដុន បាស់ ៣២ រូប ទៀត
៥៖ មេ គយ កម្ពុជា៖ យុទ្ធនាការ បោសសម្អាត រថយន្ត គ្មាន ពន្ធ ធ្វើឱ្យ ការរត់ ពន្ធ រថយន្ត ទាំង ចង្កូត ឆ្វេង និង ស្តាំ ឈានដល់ កម្រិត សូន្យ
៦៖ យោធា កូរ៉េ ខាងត្បូង អះអាង ថា មី ស៉ីល ដែល កូរ៉េ ខាងជើង បាញ់ តេស្ត នា ថ្ងៃពុធ នេះ គឺជា មីស៉ីល បាលីស្ទី គ
៧៖ លោក គុណ ញឹម៖ សល់ ជាង ៥០ ថ្ងៃ ទៀត ផុត ឱសានវាទ ឲ្យ ចូល បង់ ពន្ធ គយ នឹង បង្ក្រាប រថយន្ត ឥត ពន្ធ កាន់តែ ខ្លាំង ខណៈ រថយន្ដ ចង្កូត ស្ដាំ អាច កម្ទេចចោល
១០៖ តុលាការ ហ្វីជី សម្រេច ឲ្យ សហរដ្ឋ អាមេរិក អាច រឹបអូស នាវា ប្រណីត របស់ មហាសេដ្ឋី រុស្ស៉ី
១១៖ កម្ពុជា ទទួលបាន ពានរង្វាន់ ប្រាក់ ពិភពលោក ក្នុង ឱកាស ចូលរួម ពិព័រណ៍ ពិភពលោក នៅ ឌុយ បៃ
១២៖ សម្តេច ប៉ាប ហ្រ្វង់ ស៉ី ស ចង់ យាង ទៅ ទីក្រុង មូស្គូ ដើម្បី ជួប លោក ពូទីន ប៉ុន្តែ មិន ទាន់ ទទួលបាន ចម្លើយ
១៣៖ បច្ចុប្បន្នភាព ប្រចាំ ថ្ងៃ៖ គិត ត្រឹម ព្រឹក ថ្ងៃទី ០៤ ខែឧសភា នេះ តំបន់ អាស៊ាន មាន អ្នក ឆ្លង កូវីដ១៩ ជាង ៣១. ៤លាន នាក់ និង ស្លាប់ ៣៤. ៨ម៉ឺន នាក់
១៤៖ ក្រសួង ការពារ ជាតិ បេឡារុស៖ សមយុទ្ធ យោធា ដ៏ គួរឲ្យ ភ្ញាក់ផ្អើល មិន មែន ដើម្បី គំរាមកំហែង ដល់ ប្រទេស ជិតខាង ទេ
១៩៖ ការឈប់ សម្រាក បុណ្យ ចំ លើ ថ្ងៃអាទិត្យ មិន លើក ទៅ ឈប់ សម្រាក ថ្ងៃ បន្ទាប់ ឡើយ . បើ កម្មករ និយោជិត ធ្វើការ នៅ ថ្ងៃ ឈប់បុណ្យ នេះ ត្រូវ គិត ប្រាក់ បន្ថែម ២ដង
២០៖ វិភាគ អន្តរជាតិ៖ សង្រ្គាម អ៊ុយក្រែន ដាស់ យក្ស ជប៉ុន ឱ្យ ភ្ញាក់ ពី ដេក ?
ក្រសួង ការងារ ជូនដំណឹង ស្តីពី វឌ្ឍនភាព នៃ ការដោះស្រាយ វិវាទ ការងារ រួម នៅ ក្រុមហ៊ុន ណាហ្គាវើលដ៍
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២២ នេះ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន បន្ត អញ្ជើញ គូ ភាគី វិវាទ រវាង តំណាង បាតុករ និង តំណាង ក្រុមហ៊ុន ណាហ្គាវើលដ៍ មក ជួបប្រជុំ ដោះស្រាយ ជា លើក ទី៩ ។
ខាងក្រោម នៅជា សេចក្តីប្រកាស លទ្ធផល នៃ កិច្ច ប្រជុំ៖
រដ្ឋមន្រ្តី ក្រសួង ពាណិជ្ជកម្ម ជួប អតីត ទូត ជប៉ុន ពិភាក្សា ពី ការជំរុញ សក្តានុពល ពាណិជ្ជកម្ម កម្ពុជា - ជប៉ុន
ក្នុង ជំនួប នោះ លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន សម្តែង នូវ សេចក្តី សោមនស្ស រីករាយ និង ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ អតីត ឯក អគ្គ រដ្ឋទូត ជប៉ុន និង គណៈប្រតិភូ ក្រុមហ៊ុន FORVAL ជប៉ុន ព្រមទាំង ថ្លែង កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ លើ ទំនាក់ទំនង ដ៏ ល្អ រវាង ប្រទេស ទាំង ពីរ ជាពិសេស កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ សេដ្ឋកិច្ច - ពាណិជ្ជកម្ម នា ពេល កន្លងមក ។
លោក រដ្ឋមន្ត្រី ក៏ បាន គូសបញ្ជាក់ អំពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រសួង ពាណិជ្ជកម្ម ក្នុង ការធ្វើឱ្យ ប្រសើរឡើង នូវ បរិយាកាស ធុរកិច្ច នៅ កម្ពុជា ដើម្បី សម្រួល ដល់ ធុរ ជន និង បាន ស្នើ ឱ្យ ក្រុមហ៊ុន FORVAL ពិនិត្យ លទ្ធភាព ពង្រីក ប្រតិបត្តិការ ធុរកិច្ច នៅ កម្ពុជា និង វិនិយោគ លើ វិស័យ ដែល មាន សក្តានុពល នានា បន្ថែម ទៀត ។
ទន្ទឹមនឹង នេះ លោក រដ្ឋមន្ត្រី បាន ស្នើ ឱ្យ អតីត ឯក អគ្គ រដ្ឋទូត ជប៉ុន ក៏ ដូចជា វិស័យ ឯកជន ជប៉ុន ជួយ គាំទ្រ ឱ្យ មាន ការបង្កើត កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម សេរី ទ្វេ ភាគី កម្ពុជា - ជប៉ុន ដូច ដែល បាន លើកឡើង នៅក្នុង ជំនួប រវាង សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ជាមួយ លោក Fumio Kishida នាយក រដ្ឋមន្រ្តី ជប៉ុន ដើម្បី ផលប្រយោជន៍ ប្រជាជន និង វិស័យ ធុរកិច្ច នៃ ប្រទេស ទាំង ពីរ ។
នៅក្នុង ជំនួប នេះ ភាគី ទាំង ពីរ បាន សម្តែង សារជាថ្មី នូវ ការប្តេជ្ញាចិត្ត បន្ត កិច្ចសហការ សម្របសម្រួល និង ជំរុញ សកម្មភាព ធុរកិច្ច និង វិនិយោគ ជាពិសេស លើ វិស័យ ដែល មាន សក្តានុពល នានា នៅ កម្ពុជា ដើម្បី ជំរុញ កំណើន សេដ្ឋកិច្ច - ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ បន្ថែម ទៀត ៕ ក្រសួង ៣ កំពុង សិក្សា រួមគ្នា អំពី ការកំណត់ អាយុ អនុញ្ញាតឱ្យ ទទួលទាន គ្រឿងស្រវឹង ដើម្បី លើកកម្ពស់ សុវត្ថិភាព ចរាចរណ៍
( ភ្នំពេញ ) ៖ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក្រសួង អប់រំ យុវជន និង កីឡា និង ក្រសួង សុខាភិបាល កំពុង សហការ គ្នា ដើម្បី ឈាន ទៅដល់ ការពិចារណា លើ ការកំណត់ អាយុ អនុញ្ញាតឱ្យ ទទួលទាន គ្រឿងស្រវឹង សម្រាប់ មនុស្ស ពេញ វ័យ ដើម្បី លើកកម្ពស់ សុវត្ថិភាព ចរាចរណ៍ និង កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ។ នេះ បើ តាម ការអះអាង របស់ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
សូម បញ្ជាក់ ថា សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក កាលពី ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២១ បាន បញ្ជាក់ ថា គ្រោះថ្នាក់ ចរាចរណ៍ ពេញ មួយ ឆ្នាំ ២០២១ មាន ២ ៦៧០ លើក ចំពោះ ចំនួន អ្នកស្លាប់ បាត់បង់ជីវិត មាន ចំនួន ១ ៤៩៧ នាក់ និង អ្នក រងរបួស មាន ចំនួន ៣ ៦១៥ នាក់ ។
តាម ផ្នែក ជំនាញ បាន រកឃើញ ពី មូលហេតុ នៃ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ឆ្នាំ ២០២១ នេះ ដោយសារ ការបើកបរ ដោយ ល្បឿន លឿន ចំនួន ៣៨ ភាគរយ ការ មិន គោរព សិទ្ធិ មាន ចំនួន ២៤ ភាគរយ ការ មិន ប្រកាន់ ស្តាំ មាន ចំនួន ១៤ភាគរយ ការប្រជែង គ្រោះថ្នាក់ មាន ៨ភាគរយ បត់ ឆ្វេង - ស្តាំ មិន ប្រយ័ត្ន មាន ៨ភាគរយ ស្រវឹង ៤ភាគរយ កត្តា យានយន្ត មាន ៣ភាគរយ និង ង ងុយ មាន ១ភាគរយ ។
សម្តេច ក្រឡាហោម ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ដើម្បី សុវត្ថិភាព តាម ពាក្យស្លោក របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សារ អំពាវនាវ របស់ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក រួម មាន៖
* ថ្ងៃ នេះ ថ្ងៃស្អែក កុំ ឲ្យ មាន គ្រោះថ្នាក់ ចរាចរណ៍ * គោរព ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ជា កាតព្វកិច្ច របស់ អ្នកប្រើប្រាស់ ផ្លូវ គ្រប់ រូប * បើកបរ លើស ល្បឿន ដែល ច្បាប់ កំណត់ ងាយ ប្រឈម នឹង គ្រោះថ្នាក់ * បើ ស្រវឹង សូម កុំ បើកបរ * គោរព ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក គឺ គោរព ជីវិត ខ្លួន ឯង និង អ្នកដទៃ * គោរព ច្បាប់ ស្តីពី ចរាចរណ៍ ផ្លូវគោក គឺ លើកកម្ពស់ កិត្យានុភាព ជាតិ * ការពារ ជីវិត អ្នក ត្រូវ ពាក់ មួក សុវត្ថិភាព ៕
ឡាវ រកឃើញ ករណី ឆ្លង កូវីដ១៩ ចំនួន ២៦៣ នាក់ ក្នុង របាយការណ៍ ថ្ងៃពុធ នេះ
សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ផ្ញើ សារលិខិត ជូន ជន រួម ជាតិ ក្នុង ទិវា ឆ្មប ជាតិ ៥ឧសភា ២០២២
សូម អាន សារលិខិត ដែល មាន ខ្លឹមសារ ទាំងស្រុង ខាងក្រោម នេះ៖
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ មាន ៩. ៧៨៦ ករណី ជា ករណី ឆ្លង ក្នុង សហគមន៍ និង ៤ករណី ទៀត ជា ករណី នាំចូល ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ អ្នកជំងឺ ចំនួន ៥៤ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ខណៈ អ្នកជំងឺ ចំនួន ១៧. ១០៩ នាក់ ផ្សេង ទៀត ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
( ក្រចេះ ) ៖ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ដែល ជា មុខសញ្ញា អាទិភាព ចំនួន ៨៧ គ្រួសារ ក្នុង ភូមិ ទាំង៦ នៃ ឃុំ ដំរី ផុង ស្រុក ឆ្លូង ខេត្ត ក្រចេះ កាលពី ថ្ងៃទី ៣ ខែឧសភា ឆ្នាំ ២០២២ បាន មក ទទួល អំណោយ មនុស្សធម៌ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា តាមរយៈ លោក វេជ្ជបណ្ឌិត អ៊ុយ សំអាត នាយក នាយកដ្ឋាន គ្រប់គ្រង គ្រោះមហន្តរាយ ។
នា ឱកាស នោះ លោក វេជ្ជបណ្ឌិត បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ ពី ហ្លួង ម៉ែ នរោត្តម មុនិនា ថ សីហនុ ព្រះប្រធាន កិត្តិយស និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ក្តីអាណិត ស្រឡាញ់ ការគិតគូរ ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ របស់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ទាំងអស់ ដោយ ក្តី នឹករលឹក ជា ទីបំផុត ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ១៤នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៤ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ១៤នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៤ ខែឧសភា ឆ្នាំ ២០២២ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ថ្ងៃទី ០៥ ខែឧសភា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ១៤ នាក់ នោះ មាន ០៤ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ០៣ ករណី និង ជនសង្ស័យ ១០នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៥ ករណី ។
ជាមួយគ្នា នេះ លោក បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ អនុវត្ត នូវ ពាក្យស្លោក « ៣កុំ ១រាយការណ៍ » ដែល មាន ន័យ ថា « កុំ ពាក់ព័ន្ធ កុំ អន្តរាគមន៍ កុំ លើកលែង ក្នុង បទល្មើស នានា និង ជួយ រាយការណ៍ ពី បទល្មើស គ្រឿងញៀន និង បទល្មើស ផ្សេង ៗ ទៀត » ដែល កើតមាន នៅ មូលដ្ឋាន របស់ ខ្លួន ជូន ដល់ សមត្ថកិច្ច ៕ គ.ជ. ប នឹង ដាក់បញ្ចូល កម្មវិធី ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន ចំនួន ៣ ជា ជំនួយ ដល់ ការគ្រប់គ្រង ការបោះឆ្នោត
( ភ្នំពេញ ) ៖ លោក ប្រាជ្ញ ចន្ទ ប្រធាន គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) បាន ឱ្យដឹង ថា ដោយ ផ្អែក លើ បទពិសោធ នៃ ការបោះឆ្នោត កន្លងមក គ.ជ. ប បាន ដាក់ បន្ថែម បទប្បញ្ញត្តិ មួយចំនួន ឱ្យ ស្រប នឹង ច្បាប់ ស្តីពី វិសោធនកម្ម ច្បាប់ ស្តីពី ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ព្រមទាំង ការដាក់បញ្ចូល ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន ដើម្បី ជា ជំនួយ ដល់ ការរៀបចំ និង ការគ្រប់គ្រង ការបោះឆ្នោត ឱ្យ កាន់តែ ល្អ ប្រសើរ មាន តម្លាភាព និង មាន សុក្រិត ភាព ថែម មួយ កម្រិត ទៀត ដែល ក្នុង នោះ រួម មាន៖
*កម្មវិធី គ្រប់គ្រង ការចុះបញ្ជី បេក្ខជន នៃ គណបក្ស នយោបាយ *កម្មវិធី ចេញ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ បម្រើ ឱ្យ ការបោះឆ្នោត *កម្មវិធី គ្រប់គ្រង លទ្ធផល នៃ ការបោះឆ្នោត ។
ពាក់ព័ន្ធ នឹង ការចេញ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ បម្រើ ឱ្យ ការបោះឆ្នោត លោក ប្រាជ្ញ ចន្ទ បាន បញ្ជាក់ ថា សុំ ឱ្យ មាន ការផ្សព្វផ្សាយ ទូលំទូលាយ ជាបន្ត ទៀត ជូន អ្នក មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ដែល គ្មាន អត្តសញ្ញាណប័ណ្ណ សញ្ជាតិ ខ្មែរ ប្រើ សម្រាប់ បោះឆ្នោត ដោយ ពួកគាត់ ត្រូវ ស្នើសុំ ធ្វើ ឯកសារ បញ្ជាក់ អត្តសញ្ញាណ សម្រាប់ បម្រើ ឱ្យ ការបោះឆ្នោត ដែល មាន រយៈពេល ៣០ ថ្ងៃ គឺ ចាប់ពី ថ្ងៃទី ៥ ខែឧសភា ដល់ ថ្ងៃទី ៣ ខែមិថុនា ឆ្នាំ ២០២២ ។
លោក ប្រាជ្ញ ចន្ទ ប្រធាន គ.ជ. ប ក៏ បាន ក្រើន រំលឹក ដល់ សិក្ខាម ទាំងអស់ ឱ្យ យកចិត្តទុកដាក់ ខ្ពស់ ក្នុង ការបង្ការ ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ១៩ ដោយ ត្រូវ គោរព តាម វិធានការចាំបាច់ របស់ រដ្ឋាភិបាល បើ ទោះបីជា អត្រា កើនឡើង ខ្ពស់ នៃ ការចាក់ វ៉ាក់សាំង ដូស ជំរុញ ក្នុង ក្របខ័ណ្ឌ ទូទាំង ប្រទេស មាន សភាពស៊ាំ ក្នុង សហគមន៍ ធ្វើឱ្យ ការឆ្លង រាលដាល នៃ ជំងឺ នេះ ថយចុះ មក នៅ កម្រិត តិចតួច បំផុត ជា អំណោយផល ដល់ ការធានា បាន នូវ ការរៀបចំ ដំណើរការបោះឆ្នោត ជ្រើស រើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ ឆ្នាំ ២០២២ ក៏ដោយ ។
សមាសភាព ដែល ចូលរួម ក្នុង វគ្គ បណ្តុះបណ្តាល នេះ រួម មាន សមាសភាព គណៈកម្មការ - រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត ប្រធាន លេខាធិការដ្ឋាន នៃ គណៈកម្មការ រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត តំណាង ក្រុមប្រឹក្សា ធម្មនុញ្ញ ព្រឹទ្ធសភា ក្រសួង មហាផ្ទៃ តំណាង គណបក្ស នយោបាយ ដែល ចូលរួម ក្នុង ការបោះឆ្នោត ជ្រើសរើស ក្រុមប្រឹក្សា ឃុំ សង្កាត់ អាណត្តិ ទី៥ តំណាង អង្គការ សមាគម និង អ្នកសារព័ត៌មាន សរុប ប្រមាណ ២៦០ នាក់ ៕
គួរ បញ្ជាក់ ថា ចាប់តាំងពី សង្រ្គាម ផ្ទុះឡើង មក . ក្រុម មន្ត្រី អ៊ុយក្រែន បាន អះអាង ថា ទាហាន របស់ ខ្លួន បាន សម្លាប់ ឧត្ដមសេនីយ៍ រុស្ស៉ី ១២នាក់ ខណៈ មន្ត្រី អាមេរិក មិន បាន បញ្ជាក់ លម្អិត ថា តើ ឧត្ដមសេនីយ៍ រុស្ស៉ី ប៉ុន្មាន នាក់ ត្រូវបាន សម្លាប់ នោះ ទេ ៕
EDC ជូនដំណឹង ពី ការរអាក់រអួល ចរន្ត នៅ ថ្ងៃ នេះ ដល់ ថ្ងៃទី ០៨ ខែឧសភា ដើម្បី រុះរើ គន្លង ខ្សែ បណ្តាញ ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការអនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ អគ្គិសនី របស់ អគ្គិសនី កម្ពុជា ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ០៥ ខែឧសភា ឆ្នាំ ២០២២ ដល់ ថ្ងៃទី ០៨ ខែឧសភា ឆ្នាំ ២០២២ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ដូច សេចក្តី ជូនដំណឹង លម្អិត ខាងក្រោម ។
ក្រោយ បើក ព្រំដែន កម្ពុជា - ថៃ ចាប់ផ្ដើម ជំរុញ ទេសចរណ៍ ឡើងវិញ
( ភ្នំពេញ ) ៖ បន្ទាប់ពី រដ្ឋាភិបាល ថៃ អនុញ្ញាតឱ្យ បើក ច្រក ព្រំដែន ជាមួយ កម្ពុជា ឡើងវិញ ចាប់ពី ថ្ងៃទី១ ខែឧសភា ឆ្នាំ ២០២២ នោះ មក សមាគម - ក្រុមហ៊ុន ឯកជន ក្នុង វិស័យ ទេសចរណ៍ មួយចំនួន នៅ កម្ពុជា ថៃ ក៏ ដូចជា វៀតណាម បាន សហការ រៀបចំ ផែនការជំរុញ ចរន្ត ភ្ញៀវ ទេសចរ ឡើងវិញ ប៉ុន្តែ បែប បទ នៅ តាម ព្រំដែន ខាង ភាគី ថៃ ហាក់ មិន ទាន់ រលូន នៅ ឡើយ ។
លោក ធួន ស៉ីណាន បាន ថ្លែង ប្រាប់ អ្នកសារព័ត៌មាន នា ថ្ងៃទី ៤ ខែមេសា ឱ្យដឹង ថា ការបើក ច្រក ព្រំដែន រវាង ភាគី កម្ពុជា និង ភាគី ថៃ នេះ គឺ ពិតជា ល្អ មែនទែន សម្រាប់ វិស័យ ទេសចរណ៍ ដឹកជញ្ជូន ពាណិជ្ជកម្ម ក៏ ដូចជា វិស័យ ផ្សេង ទៀត ដែល ជា ចំណុច ពិសេស សម្រាប់ ការបន្ត កិច្ចអភិវឌ្ឍ សេដ្ច កិច្ច រវាង ប្រទេស ទាំង ពីរ ។
លោក បាន បន្ត ថា តាម ទិដ្ឋភាព ជាក់ស្ដែង នៅ ពេល ក្រុមការងារ សមា គម PATA បាន ឆ្លងកាត់ ច្រក ព្រំដែន ចាំ យាម - ខ្លង យ៉ៃ កាលពី ថ្ងៃទី ៣ ខែឧសភា ម្សិលមិញ ឃើញ ថា ខាង ភាគី កម្ពុជា គឺ ពិតជា មាន ការអនុវត្ត កិច្ចការ បំពេញ បែបបទ ឯកសារ បាន យ៉ាង ល្អ តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ទាំង មន្ត្រី អន្តោប្រវេសន៍ មន្ត្រី ច្រក ព្រំដែន ក៏ ដូចជា មន្ត្រី គយ ជាដើម ។
លោក ថា ចរន្ត ភ្ញៀវ ទេសចរ តាម ផ្លូវគោក នឹង កាន់តែ មាន ច្រើន ថែម ទៀត ប្រសិនបើ ខាង ភាគី ថៃ បន្ធូរបន្ថយ លក្ខខណ្ឌ ឬ បែបបទ ឯកសារ មួយចំនួន បន្ថែម ទៀត ដោយសារ នៅ ថ្ងៃ ម្សិលមិញ ពេល ដែល លោក ឆ្លងកាត់ ព្រំដែន កាតម្រូវ លក្ខខណ្ឌ ពី ខាង ភាគី ថៃ គឺ នៅ មិន ទាន់ មាន ភាពច្បាស់លាស់ នៅឡើយ ដូចជា លក្ខខណ្ឌ នៃ ការបើកបរ រថយន្ត ផ្ទាល់ខ្លួន ចូលទៅ ប្រទេស ថៃ និង បញ្ហា ដែល ភាគី ថៃ ស្នើ ឱ្យ ខាង ភាគី កម្ពុជា ធ្វើតេស្ត រហ័ស លើ ភ្ញៀវ និង អ្នកដំណើរ ជាដើម ។
អនុប្រធាន សភា ទេសចរណ៍ ខេត្ត ត្រាត រូប នេះ បាន បញ្ជាក់ ទៀត ថា តាម ច្រក ព្រំដែន ចាំ យាម - ខ្លង យ៉ៃ នៅ ទាន់ មាន ចរន្ត ភ្ញៀវ ទេសចរ ចេញ ចូល ច្រើន នៅឡើយ ទេ ប៉ុន្តែ ទោះជា យ៉ាងណា ការកក់ សណ្ឋាគារ រី ស៊ត គឺ ចាប់ផ្ដើម មាន ខ្លះ ៗ ហើយ ។
យ៉ាងណាមិញ លោក ធួន ស៉ីណាន ក្នុង នាម តំណាង ភាគី កម្ពុជា និង លោកស្រី វីយ៉ាដា ក្នុង នាម តំណាង ភាគី ថៃ ព្រមទាំង លោក ង្វៀន ហុង ហ៉ីវ (Nguyen Hong Hieu) តំណាង ភាគី វៀតណាម នឹង ចូលរួម ដឹកនាំ ក្នុង កិច្ចប្រជុំ ផ្លាស់ប្ដូរ ផ្គូរ ផ្គង ដៃគូ ក្រុមហ៊ុន ទីភ្នាក់ងារ ទេសចរណ៍ និង ផ្លាស់ប្ដូរ ពាណិជ្ជកម្ម រវាង កម្ពុជា ថៃ និង វៀតណាម នាទីក្រុង បាងកក រយៈពេល ២ ថ្ងៃ បន្ត ទៀត ដើម្បី ពិគ្រោះ ពិភាក្សា លម្អិត អំពី ដំណើរការ ជំរុញ ចរន្ត ភ្ញៀវ ទេសចរ ទៅ មក ជា លក្ខណៈ ទ្វេ ភាគី ឬ ត្រី ភាគី នា ពេល ខាងមុខ ឆាប់ ៗ នេះ ។
គួរ ជម្រាប ថា បើ តាម ស្ថានទូត កម្ពុជា ប្រចាំ ប្រទេស ថៃ បាន បញ្ជាក់ ថា អ្នកដំណើរ ដែល ត្រូវ ធ្វើដំណើរ ពី កម្ពុជា ទៅកាន់ ប្រទេស ថៃ តាម ផ្លូវ អាកាស ក្ដី តាម ផ្លូវគោក ក្ដី ត្រូវបាន បែងចែក ជា៣ ប្រភេទ ហើយក៏ ត្រូវ អនុវត្ត តាម លក្ខខណ្ឌ ផ្សេង គ្នា ផងដែរ ក្នុង នោះ រួម មាន៖
( ភ្នំពេញ ) ៖ ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២២ លោក ថោង រដ្ឋសក្តិ អគ្គ នាយក អភិវឌ្ឍន៍ ទេសចរណ៍ និង សហប្រតិបត្តិការ អន្តរជាតិ តំណាង ភាគី កម្ពុជា បាន ដឹកនាំ មន្ត្រី ជំនាញ ក្រសួង ទេសចរណ៍ ចូលរួម ក្នុង កិច្ចប្រជុំ ក្រុមការងារ អនុវត្ត ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ ឆ្នាំ ២០២០ - ២០២៥ ចក្ខុវិស័យ ឆ្នាំ ២០៣០ ជាមួយ ភាគី វៀតណាម និង ឡាវ តាម ប្រព័ន្ធ វីដេអូ ។
ជា ផ្នែក មួយ ក្នុង ការរួមចំណែក ស្តារ ឡើងវិញ ក្រោយ វិបតិ្ត ជំងឺ កូវីដ - ១៩ តាម ផែនទី ចង្អុល ផ្លូវ ស្តីពី ការស្តារ វិស័យ ឡើងវិញ វិស័យ ទេសចរណ៍ កម្ពុជា ២០២០ - ២០២៥ ក្នុង នោះ ភាគី កម្ពុជា បាន ឯកភាព តាម សំណើរ របស់ អង្គប្រជុំ ដោយ ទទួលបន្ទុក ដឹកនាំ សកម្មភាព ស្នូល ចំនួន ៥ រួម មាន៖
១៖ ចែករំលែក បទពិសោធន៍ នៃ ការគ្រប់គ្រង គោលដៅ ការអភិរក្ស ធនធាន ធម្មជាតិ និង វប្បធម៌ និង ការអភិវឌ្ឍន៍ សហគមន៍ ទេសចរណ៍ / អេកូ - ទេសចរណ៍ និង ផ្ទះ ស្នាក់ នៅក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ ។
២៖ ពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ ការបណ្តុះបណ្តាល និង ពង្រឹង សមត្ថភាព ធនធាន មនុស្ស ឆ្ពោះទៅ ស្តង់ដា អ្នកជំនាញ ទេសចរណ៍ អាស៊ាន ផ្តោត លើ ជំនាញ បដិសណ្ឋារកិច្ច ដើម្បី លើកកម្ពស់ គុណភាព សេវាកម្ម ។
៥៖ កិច្ចសហការ ក្នុង ការឆ្លើយតប ទៅនឹង ការបម្រែបម្រួល អាកាសធាតុ គ្រោះមហន្តរាយ និង ការឆ្លើយតប រហ័ស ទៅនឹង ទឹក ជំនន់ ខ្យល់ព្យុះ និង ការស្តារ ឡើងវិញ ក្រោយមហត្ត រាយ ដែល អាច កើត មាន ឡើង ជា យថាហេតុ ។
អង្គប្រជុំ បាន សម្រេច ឯកភាព តាម យោបល់ របស់ លោក ថោង រដ្ឋសក្តិ តំណាង កម្ពុជា លើ ការងារ សំខាន់ រួម មាន៖
១៖ ការផ្សព្វផ្សាយ រួមគ្នា រវាង ប្រទេស ទាំង៣ ដើម្បី ផ្សព្វផ្សាយ ពី សក្តានុពល ទេសចរណ៍ តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ នៅក្នុង ព្រឹត្តិការណ៍ ពិព័រណ៌ ទេសចរណ៍ កម្រិត អន្តរជាតិ ការរៀបចំ វីដេអូ ស្លាកសញ្ញា និង យីហោ ផ្សព្វផ្សាយ តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ ជាពិសេស ការផ្សព្វផ្សាយ តាម ប្រព័ន្ធ ឌីជីថល ២០២២ - ២០២៥ ។
២៖ រៀបចំ កិច្ចប្រជុំ ក្រុមការងារ អនុវត្ត ផែនការអភិវឌ្ឍន៍ ទេសចរណ៍ តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ ឆ្នាំ ២០២០ - ២០២៥ ចក្ខុវិស័យ ឆ្នាំ ២០៣០ ចំនួន ២ដង ក្នុង មួយ ឆ្នាំ ដើម្បី បូកសរុប ការងារ មុននឹង រាយការណ៍ ជូន អង្គការ ជាតិ ទេសចរណ៍ អាស៊ាន និង ការបញ្ជូល សមាសភាព អន្តរ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ទៅក្នុង ក្រុមការងារ (Working Group) ដើម្បី ដឹកនាំ ការងារ ក្នុង បុរេសកម្ម និង មាន ការទទួលខុសត្រូវ ខ្ពស់ ។
៣៖ រៀបចំ ស្តង់ដា ទេសចរណ៍ សំខាន់ ៗ សម្រាប់ កម្រិត តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ ដោយ យក គំរូ តាម ស្តង់ដា ទេសចរណ៍ អាស៊ាន ដែល បាន អនុវត្ត ។
អតីត យុទ្ធជន កម្ពុជា ៣៦ គ្រួសារ ដែល មាន ជីវភាព ខ្វះខាត នៅ ស្រុក ត្បែងមានជ័យ និង ក្រុង ព្រះវិហារ ទទួល អំណោយ សម្តេច តេជោ
នៅក្នុង ឱកាស នេះ ដែរ លោក ឧត្តមសេនីយ៍ ទោ ច័ន្ទ សុភ័ក្ត្រា ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា ខេត្ត ព្រះវិហារ បាន ថ្លែង ពាំនាំ នូវ ប្រសាសន៍ ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន ប្រធាន សមាគម អតីត យុទ្ធជន កម្ពុជា និង លោក ទេសរដ្ឋមន្ត្រី គន់ គីម អគ្គ លេខាធិការ សមាគម អតីត យុទ្ធជន កម្ពុជា ដែល ជានិច្ច ជាកាល តែង បាន យកចិត្តទុកដាក់ គិតគូរ ជានិច្ច ពី សុខ ទុក្ខ និង ជីវភាព រស់ នៅ របស់ បងប្អូន អតីត យុទ្ធ កម្ពុជា របស់ យើង និយាយ ដោយឡែក បងប្អូន អតីត យុទ្ធជន កម្ពុជា នៅ ខេត្ត ព្រះវិហារ ។
សូម បញ្ជាក់ ថា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល នាំទៅ ប្រគល់ ជូន បងប្អូន អតីត យុទ្ធជន កម្ពុជា ចំនួន ៣៦ គ្រួសារ នា ឱកាស នេះ រួម មាន៖ អង្ករ ចំនួន ៣០ គីឡូ មី ម៉ាម៉ា ចំនួន ១កេស ត្រីខ ១យួរ . សារ៉ុង ១. ប៊ី ចេង ១កញ្ចប់ និង ថវិកា ចំនួន ២០.០០០ រៀល ផងដែរ ៕
អភិបាល ខេត្ត ព្រៃវែង ណែនាំ ដល់ មន្ទីរ រៀបចំ ដែនដី ត្រូវ ពន្លឿន ក្នុង ការចេញ ប័ណ្ណ កម្មសិទ្ធិ ជូន ដល់ ពលរដ្ឋ ឲ្យបាន លឿន
( ព្រៃវែង ) ៖ លោក ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង បាន ណែនាំ ដល់ មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី ខេត្ដ ត្រូវ ពន្លឿន ក្នុង ការចេញ ប័ណ្ណ កម្មសិទ្ធិ ជូន ដល់ ប្រជាពលរដ្ឋ ឲ្យបាន លឿន ឆាប់ រហ័ស តាម ការសន្យា របស់ ខ្លួន ដែល បាន សន្យា ជាមួយ ប្រជាពលរដ្ឋ កាលពី ពេល កន្លងទៅ ។
លោក ថា ចំពោះ ប័ណ្ណ កម្មសិទ្ធ ដែល មិន បាន ចេញ តាម ការសន្យា នោះ ត្រូវ ធ្វើ ការពន្យល់ ប្រាប់ ពលរដ្ឋ ឲ្យបាន យល់ ច្បាស់ អំពី មូលហេតុ នៃ ការយឺតយ៉ាវ ក្នុង ការចេញ ប័ណ្ណ កម្មសិទ្ធិ ជូន ពលរដ្ឋ នៅ ស្រុក កំចាយ មារ ដែល លោក ប្រធាន មន្ទីរ បាន សន្យា នោះ ធ្វើ យ៉ាងណា កុំ ឲ្យ ប្រជាពលរដ្ឋ ដែល គាត់ ទន្ទឹងរង់ចាំ មាន ការអាក់អន់ ស្រពន់ចិត្ត ។
ការថ្លែង របស់ អភិបាល ខេត្ត ព្រៃវែង បែប នេះ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ៤ ខែឧសភា ឆ្នាំ ២០២២ ក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព របស់ រដ្ឋបាល ខេត្ត ព្រៃវែង ដើម្បី ពិនិត្យ និង វាយតម្លៃ អំពី សកម្មភាព ការងារ របស់ ថ្នាក់ដឹកនាំ ក្រុង ស្រុក ទាំងអស់ នៅ ខេត្ត ព្រៃវែង ដែល បាន អនុវត្តន៍ កន្លងមក នេះ ។
នៅក្នុង កិច្ចប្រជុំ នោះ ក៏ មាន ការចូលរួម ពី លោក លោកស្រី អភិបាល រង ខេត្ត លោក ប្រធាន សាលាដំបូង ខេត្ត ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត លោក នាយក នាយក រង រដ្ឋបាល ខេត្ត លោក មេបញ្ជាការ កងកម្លាំង ទាំង បី លោក លោកស្រី ប្រធាន មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត លោក លោកស្រី អភិបាល ក្រុង ស្រុក ប្រធាន ច្រកទ្វា ព្រំដែន ទាំង៦ នៃ ខេត្ត ព្រៃវែង ផងដែរ ។
លោក ជា សុមេធី បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការខិតខំ ប្រឹងប្រែង ធ្វើការងារ អស់កម្លាំង កាយ ចិត្ត របស់ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត អាជ្ញាធរ ក្រុង ស្រុក ទាំង ១៣ នៃ ខេត្ត ព្រៃវែង ដើម្បី បម្រើ ផលប្រយោជន៍ ជូន បងប្អូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន របស់ ខ្លួន បាន ល្អ ប្រសើរ ។
លោក អភិបាល ខេត្ត បាន ណែនាំ ដល់ ដល់ រដ្ឋបាល ស្រុក ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត នូវ ផែនការ សកម្មភាព ការងារ របស់ ខ្លួន ជា បន្តបន្ទាប់ ទៀត ធ្វើ យ៉ាងណា ដើម្បី ធានា ដល់ ការបម្រើ សេវា សាធារណៈ ជូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន របស់ ខ្លួន ឲ្យបាន ល្អ ប្រសើរឡើង បន្ថែម ទៀត ។
លោក ក៏ បាន ជំរុញ ដល់ អាជ្ញាធរ ក្រុង ស្រុក ត្រូវ អនុវត្ត នៅ ភូមិ ឃុំ មាន សុវត្ថិភាព ឲ្យបាន ល្អ ធ្វើ យ៉ាងណា ដើម្បី ធានា សុវត្ថិភាព ជូន បងប្អូន ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន បាន កាន់ ល្អ ប្រសើរឡើង ។
ជម្រើស ផ្សេង ទៀត សម្រាប់ លោក ពូទីន នោះ គឺ ប្រកាស ដាក់ ចេញ ច្បាប់ កែន កងទ័ព រុស្ស៉ី ដែល អាច ត្រូវបាន ប្រើប្រាស់ ក្នុង ការកែន កងទ័ព ទាំងស្រុង ឬមួយ ផ្នែក នៅក្នុង ករណី មាន ការឈ្លានពាន ប្រឆាំង សហព័ន្ធ រុស្ស៉ី ឬ ការគំរាម ឈ្លានពាន ដោយ ផ្ទាល់ ឬ ក៏ ជម្លោះ ប្រដាប់អាវុធ ដែល គំរាមកំហែង ដោយ ផ្ទាល់ ដល់ សហព័ន្ធ រុស្ស៉ី ។ តាមរយៈ ការដាក់ចេញ ច្បាប់ នេះ . វា នឹង ផ្ដល់ ឱ្យ រដ្ឋាភិបាល លោក ពូទីន មិន ត្រឹមតែ អំណាច កែន កងទ័ព ប៉ុណ្ណោះ តែ វា ក៏ អាច បង្វែរ ធនធាន សេដ្ឋកិច្ច នានា យកមក ធ្វើ សង្រ្គាម ផងដែរ ។
