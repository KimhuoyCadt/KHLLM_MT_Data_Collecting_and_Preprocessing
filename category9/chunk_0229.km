( វ៉ាស៉ីន តោន ) ៖ ឆ្លៀត ក្នុង ឱកាស អម ដំណើរ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ចូលរួម កិច្ចប្រជ៉ំ កំពូល អាស៊ាន - អាមេរិក អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង ជា ប្រធាន ក្រុមប្រឹក្សា ពិគ្រោះយោបល់ ធុរកិច្ច អាស៊ាន ឆ្នាំ ២០២២ បាន ជួប ពិភាក្សា ការងារ ធុរកិច្ច ជាមួយ លោក ម៉ាក មាលី អនុប្រធាន ជាន់ ខ្ពស់ របស់ ក្រុមប្រឹក្សា ធុរកិច្ច អាមេរិក អាស៊ាន នា ព្រឹក ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២២ ( ម៉ោង នៅ អាមេរិក ) នៅ ទីក្រុង វ៉ាស៊ីនតោន សហរដ្ឋ អាមេរិក ។
ក្នុង ឱកាស នោះ លោក ម៉ាក មាលី អនុប្រធាន ជាន់ ខ្ពស់ របស់ ក្រុមប្រឹក្សា ធុរកិច្ច អាមេរិក អាស៊ាន បាន ជម្រាប អ្នក ឧកញ៉ា គិត ម៉េង ថា លោក បាន គាំទ្រ ចំពោះ កិច្ចសហប្រតិបត្តិការ រវាង កម្ពុជា និង អាមេរិក ជា រួម ក្នុង ការជំរុញ ធុរកិច្ច និង វិនិយោគ អាមេរិក អាស៊ាន និង អាមេរិក កម្ពុជា ឲ្យ មាន ការរីកចម្រើន ។
លោក បាន បញ្ជាក់ ថា ក្រុមប្រឹក្សា ធុរកិច្ច អាមេរិក - អាស៊ាន តែងតែ ចូលរួម យ៉ាង សកម្ម ជួយ គាំទ្រ ដល់ កិច្ចប្រជុំ កំពូល ធុរកិច្ច និង វិនិយោគ អាស៊ាន ។ សម្រាប់ ឆ្នាំ ២០២២ នេះ ក្រុមប្រឹក្សា ធុរកិច្ច អាមេរិក អាស៊ាន រីករាយ នឹង សហការ គាំទ្រ ជាមួយ សភា ពាណិជ្ជកម្ម កម្ពុជា ដើម្បីឲ្យ កិច្ចប្រជុំ កំពូល ធុរកិច្ច និង វិនិយោគ អាស៊ាន ប្រព្រឹត្តទៅ ប្រកបដោយ ជោគជ័យ នៅ កម្ពុជា ។
គួរ ជម្រាប ថា ទំនាក់ទំនង សេដ្ឋកិច្ច ពាណិជ្ជកម្ម រវាង កម្ពុជា និង អាមេរិក មាន ការកើនឡើង ទោះបីជា មាន វីដ១៩ យ៉ាងណា ក៏ដោយ ក៏ មាន ការកើនឡើង រហូតដល់ ជិត ១០ ពាន់ លាន ដុល្លារ នៅក្នុង ឆ្នាំ ២០២១ ក្នុង នោះ កម្ពុជា បាន នាំ ទំនិញ ទៅកាន់ ទីផ្សារ អាមេរិក មាន សំលៀកបំពាក់ ស្បែកជើង វិស័យ កសិកម្ម គ្រឿង សង្ហារឹម ជាដើម ។ ជាមួយគ្នា នោះ ក្រុមហ៊ុន អាមេរិកាំង ជាច្រើន ក៏ មាន វត្តមាន ទៅ វិនិយោគ នៅ កម្ពុជា ។
អ្នក ឧកញ៉ា គិត ម៉េង បាន ថ្លែង អំពី ទំនាក់ទំនង ការទូត កម្ពុជា អាមេរិច ដែល ជា ខួប ៧២ ឆ្នាំ ។ អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង ជា ប្រធាន ក្រុមប្រឹក្សា ពិគ្រោះយោបល់ ធុរកិច្ច អាស៊ាន ឆ្នាំ ២០២២ បាន អញ្ជើញ គណៈប្រតិភូ ធុរកិច្ច អាមេរិក ទៅ ទស្សនកិច្ច និង ស្វែងយល់ ការវិនិយោគ នៅឯ ប្រទេស កម្ពុជា ផងដែរ ៕
មេដឹកនាំ អាស៊ាន - អាមេរិក ប្តេជ្ញា ពង្រឹង ទំនាក់ទំនង ឱ្យ ក្លាយជា ទំនាក់ទំនង ពិសេស ដែល មិន អាច ខ្វះ គ្នា បាន
( វ៉ាស៊ីនតោន . អាមេរិក ) ៖ ដូច អ្វី ដែល បាន គ្រោង ទុក នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២២ មេដឹកនាំ កំពូល អាស៊ាន និង អាមេរិក ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា ប្រធាន អាស៊ាន និង លោក ចូ បៃ ដិន ប្រធានាធិបតី អាមេរិក បាន បើក កិច្ចប្រជុំ កំពូល ពិសេស ដើម្បី ជជែក លើ ពី ការពង្រឹង ទំនាក់ទំនង និង ដាក់ចេញ នូវ កិច្ចសហប្រតិបត្តិការ នានា ពង្រឹង នូវ ទំនាក់ទំនង អាស៊ាន - អាមេរិក ឱ្យ កាន់តែ រឹងមាំ និង ខ្លាំងក្លា ថែម ទៀត ។
កិច្ចប្រជុំ កំពូល ពិសេស ត្រូវបាន ប្រារព្វ ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង ការបរទេស អាមេរិក ក្នុង រដ្ឋធានី វ៉ាស៊ីនតោន ដោយ បាន ឯកភាព គ្នា ចេញ នូវ សេចក្តីថ្លែងការណ៍ ស្តីពី ចក្ខុវិស័យ រួម នៃ កិច្ចប្រជុំ កំពូល ពិសេស អាស៊ាន - សហរដ្ឋ អាមេរិក ។
ស្រប ពេល នៃ ការប្រារព្ធ ខួប លើក ទី៤៥ ឆ្នាំ នៃ ទំនាក់ទំនង ដៃគូ សន្ទនា អាស៊ាន - សហរដ្ឋ អាមេរិក នៅ ឆ្នាំ ២០២២ នេះ មេដឹកនាំ អាស៊ាន និង សហរដ្ឋ អាមេរិក បាន ប្ដេជ្ញា រួមគ្នា ពង្រឹង កិច្ច ខិតខំ ប្រឹងប្រែង រួម ដើម្បី បង្កើត ភាព ជា យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ អាស៊ាន - សហរដ្ឋ អាមេរិក ដែល ប្រកបដោយ អត្ថន័យ ខ្លឹមសារ និង ផលប្រយោជន៍ ទៅ វិញ ទៅមក និង បង្កើត សករាជ ថ្មី មួយ នៅក្នុង ទំនាក់ទំនង អាស៊ាន និង សហរដ្ឋ អាមេរិក ។
លើ ការគាំទ្រ ការអភិវឌ្ឍ អនុ តំបន់ មេដឹកនាំ ទាំងអស់ បាន បន្ត គាំទ្រម ជ្ឍភាព អាស៊ាន និង ឯកភាព អាស៊ាន ក្នុង ការ លើកកម្ពស់ ការអភិវឌ្ឍ អនុ តំបន់ របស់ អាស៊ាន ។ ពិសេស ការប្ដេជ្ញា បន្ថែម ទៀត ក្នុង ការលើកកម្ពស់ ស្ថិរភាព សន្តិភាព និង វិបុលភាព និង ការអភិវឌ្ឍ ប្រកបដោយ ចិរភាព នៅក្នុង អនុ តំបន់ មេគង្គ តាមរយៈ គំនិត ផ្តួចផ្តើម ក្រោម ក្របខ័ណ្ឌ ភាព ជាដៃគូ មេគង្គ - សហរដ្ឋ អាមេរិក ។
ការប្រើប្រាស់ បច្ចេកវិទ្យា និង ការលើកកម្ពស់ ន វានុវត្តន៍ មេដឹកនាំ អាស៊ាន - អាមេរិក បាន ជំរុញ ឲ្យ មាន ការលើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ជីវបច្ចេកវិទ្យា កសិកម្ម ឆ្លាតវៃ កសិកម្ម ដែល ធន់ នឹង អាកាសធាតុ វិទ្យាសាស្ត្រ ចំណីអាហារ ឧតុនិយម មីក្រូ អេឡិចត្រូនិក វិទ្យាសាស្ដ្រ សមុទ្រ ថាមពល និង លំហ ។
លើ ការដោះស្រាយ ការប្រែប្រួល អាកាសធាតុ មេដឹកនាំ អាស៊ាន - អាមេរិក បាន ធ្វើ ការគូសបញ្ជាក់ ដូចគ្នា ក្នុង ការពង្រឹង ភាពជាដៃគូ ដើម្បី ពង្រឹង សមត្ថភាព របស់ អាស៊ាន ក្នុង ការពង្រឹង ភាពធន់ នឹង គ្រោះមហន្តរាយ និង ការសម្រប ខ្លួន ទៅនឹង ផល ប៉ះពាល់ នៃ ការប្រែប្រួល អាកាសធាតុ ដូចជា ការកើនឡើង នូវ កម្រិត ទឹក សមុទ្រ ទឹក ជំនន់ ញឹកញាប់ ជាង មុន គ្រោះ រាំងស្ងួត និង ព្រឹត្តិការណ៍ អាកាសធាតុ ធ្ងន់ធ្ងរ ដទៃ ទៀត ការកើនឡើង នូវ ហានិភ័យ នៃ អសន្តិសុខ ទឹក ថាមពល និង អាហារ និង ព្យុះ បំផ្លិចបំផ្លាញ កាន់តែ ច្រើន ឡើង ៗ ។
លើ ការរក្សា សន្តិភាព ការកសាង ទំនុកចិត្ត មេដឹកនាំ អាស៊ាន - អាមេរិក បាន បញ្ជាក់ ជាថ្មី នូវ ទំនួល ខុសត្រូវ របស់ ភាគី ទាំង អស់ ក្នុង ការប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ គោរព គ្នា ទៅ វិញ ទៅ មក ចំពោះ អធិបតេយ្យភាព បូរណភាព ទឹកដី និង សិទ្ធ ស្មើគ្នា នៃ ប្រជាជាតិ ទាំងអស់ ។
ជាមួយនិង សន្ទុះ ដែល បាន និង កំពុង វិវឌ្ឍ យ៉ាង លឿន នៃ ការឈាន ឆ្ពោះ ទៅរក ប្រយោជន៍ រួម តែ មួយ សម្តេច តេជោ បាន អញ្ជើញ ប្រធានាធិបតី សហរដ្ឋ អាមេរិក ចូ បៃ ឌិន ចូលរួម កិច្ចប្រជុំ កំពូល អាស៊ាន - សហរដ្ឋ អាមេរិក លើក ទី១០ ដែល នឹង ប្រព្រឹត្តទៅ នៅ កម្ពុជា ក្នុង ខែវិច្ឆិកា ខាងមុខ ៕
កុំ ឲ្យ ថ្ងៃ សប្បាយ ក្លាយជា ទុក្ខ ដោយសារ ការបើកបរ របស់ អ្នក ! របួស ៥នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១៣ ខែឧសភា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២២ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៤លើក បណ្ដាលឲ្យ មនុស្ស របួស ធ្ងន់ ស្រាល ៥នាក់ ។
រដ្ឋាភិបាល ថៃ ពិចារណា កាត់បន្ធយ ពន្ធ គយ លើ ប្រេង ម៉ាស៊ូត ចំនួន ៥បាត ក្នុង មួយ លីត្រ
( បាងកក )៖ ក្រសួង ហិរញ្ញវត្ថុ របស់ ប្រទេស ថៃ កំពុង ពិចារណា លើ សំណើ របស់ មន្ត្រី រដ្ឋាភិបាល ក្នុង ការកាត់បន្ថយ ពន្ធ គយ លើ ប្រេង ម៉ាស៊ូត ចំនួន ៥បាត ក្នុង មួយ លីត្រ នៅ ពេល ដែល ការកាត់បន្ថយ ពន្ធ ដែល កំពុង អនុវត្ត បច្ចុប្បន្ន ផុត កំណត់ នៅ ថ្ងៃទី ២០ ខែឧសភា ។ នេះ បើ យោង តាម កាសែត បាងកក ប៉ុស្តិ៍ ។
កាសែត បាងកក ប៉ុស្តិ៍ បាន រាយការណ៍ ដកស្រង់ ប្រភព ពី ក្រសួង ហិរញ្ញវត្ថុ ថៃ ដែល សុំ មិន បញ្ចេញ ឈ្មោះ ថា គោលដៅ កាត់បន្ថយ ពន្ធ នេះ គឺ ដើម្បី ទប់ទល់ នឹង កំណើន អតិផរណា ។
ក្រសួង ហិរញ្ញវត្ថុ ថៃ ជឿ ថា សង្រ្គាម រវាង រុស្ស៊ី និង អ៊ុយក្រែន នឹង បន្ត ទៅ មុខ ទៀត ដោយ បន្ត ធ្វើឱ្យ តម្លៃ ប្រេង ពិភពលោក កើនឡើង ។ ប្រភព ដដែល បាន ឱ្យដឹង ថា ខ្លួន មើលឃើញ ថា ការខាតបង់ ប្រាក់ ចំណូល ពី ការទម្លាក់ ពន្ធ គយ នេះ មាន តម្លៃ ក្នុង ការលះបង់ ប្រសិនបើ វា អាច ជួយ សម្រួល ដល់ ការចំណាយ លើ ការរស់នៅ របស់ សាធារណៈ ជន ដោយសារ អតិផរណា ដែល កើនឡើង នា ពេល បច្ចុប្បន្ន គឺជា បញ្ហា សំខាន់ បំផុត ។
កន្លងមក រដ្ឋាភិបាល ថៃ បាន សម្រេច កាត់បន្ថយ ពន្ធ អាករ សម្រាប់ ប្រេង ម៉ាស៊ូត ចំនួន ៣បាត ក្នុង មួយ លីត្រ ពី កម្រិត ពន្ធ សរុប ចំនួន ៥. ៩៩បាត ក្នុង មួយ លីត្រ ដែល អនុវត្ត ចាប់ពី ថ្ងៃទី ១៨ ខែកុម្ភៈ ដល់ ថ្ងៃទី ២០ ខែឧសភា ដើម្បី បន្ធូរបន្ថយ សម្ពាធ អតិផរណា លើ វិស័យ សាធារណៈ និង ឯកជន ។
ការកាត់បន្ថយ ពន្ធ គយ នេះ បាន ធ្វើឱ្យ នាយកដ្ឋាន គយ ខាតបង់ សរុប ប្រហែល ១៧.១ប៊ីលាន បាត ( ប្រហែល ៤៨៨ លាន ដុល្លារ ) ។ រាល់ ការកាត់បន្ថយ ពន្ធ គយ លើ ប្រេង ម៉ាស៊ូត ១បាត ក្នុង មួយ លីត្រ ត្រូវបាន ប៉ាន់ប្រមាណ ថា នឹង ធ្វើឱ្យ រដ្ឋាភិបាល ថៃ ខាតបង់ ប្រហែល ១. ៩ពាន់ លាន បាត ក្នុង មួយ ខែ ។
អភិបាល ខេត្ត ត្បូងឃ្មុំ ជំរុញ ឲ្យ ក្រុមហ៊ុន វិស័យ ឯកជន បង្កើន ការវិនិយោគ មកកាន់ ទឹកដី ខេត្ត ត្បូងឃ្មុំ ខណៈ ប្រ៊េន LG បាន បើក សម្ពោធ ហាង សាខា ទី ១៧ថ្មី របស់ ខ្លួន លើ ទឹកដី ក្រុង សួង
( ត្បូងឃ្មុំ ) ៖ លោក បណ្ឌិត ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ បាន ថ្លែង ជំរុញ ឲ្យ ក្រុមហ៊ុន វិស័យ ឯកជន បង្កើន ការវិនិយោគ ឲ្យ កាន់តែ ច្រើន មកកាន់ ទឹកដី ខេត្ត ត្បូងឃ្មុំ ពិសេស ពាក់ព័ន្ធ នឹង បច្ចេកវិទ្យា ក្នុង ការបង្កើន សេវាកម្ម ឬ ផលិតផល ន វានុវត្តន៍ និង ការចាប់ យក ឱកាស ថ្មី ៗ ដើម្បី បំពេញ តម្រូវការ ជាក់ស្តែង របស់ អតិថិជន ។
បន្ថែម ពី នេះ លោក បណ្ឌិត អភិបាល ខេត្ត ក៏ បាន សម្តែង ការចូលរួម រីករាយ អបអរសាទរ ចំពោះ ការបើក ដំណើរការ ហាង ថ្មី នៅ កណ្តាល បេះដូង ក្រុង សួង ដែល ជា តំបន់ កំពុង មាន អភិវឌ្ឍ ខ្លាំង ជា កន្លែង តាំង បង្ហាញ ដ៏ អស្ចារ្យ មួយ សម្រាប់ គ្រប់ ផលិតផល ថ្មី ៗ ជាពិសេស ជា ទីប្រជុំជន មាន ប្រជាជន កំពុងតែ មាន ភាពរីកចម្រើន កំពុង ស្វែងរក នូវ អ្វី ដែល ថ្មី ៗ និង មាន គុណភាពល្អ ។
( កណ្ដាល )៖ ឆ្លង ចរន្ត អគ្គិសនី បណ្ដាលឲ្យ កើត អគ្គិភ័យ ឆាបឆេះ បន្ទប់ ជួល អស់ ១១ បន្ទប់ . រោង ដាក់ ក្រណាត់ និង ឃ្លាំង ផ្សារ ដែក ទាំងស្រុង ហើយ នគរបាល ប្រើប្រាស់ ឡាន ទឹក អស់ ១១ឡាន ទើប បាញ់ បាន រលត់ ទាំងស្រុង នៅ ល្ងាច ថ្ងៃទី ១៣ ខែឧសភា ឆ្នាំ ២០២២ នេះ ។
លោក បន្ត ថា ម្ចាស់ ទីតាំង ឈ្មោះ ញឹម សុខ ភេទ ប្រុស អាយុ ៧០ ឆ្នាំ មុខរបរ នៅ ផ្ទះ អាសយដ្ឋាន បច្ចុប្បន្ន រស់ នៅ ភូមិ លេខ ៤ សង្កាត់ អូ ឬ ស្សី៤ ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ ។ សម្ភារៈ ខូចខាត រួមាន៖ - ឆេះ បន្ទប់ ជួល ចំនួន ១១ បន្ទប់ និង របស់ ប្រើប្រាស់ ក្នុង បន្ទប់ ជួល ទាំងស្រុង ។ - ឆេះ កំទេច ក្រណាត់ សំរាប់ ធ្វើ ខ្នើយ ៕
១៖ ក្រសួង សុខាភិបាល៖ ថ្ងៃ នេះ កម្ពុជា គ្មាន អ្នក ឆ្លង ជំងឺ កូវីដ១៩ នោះ ទេ ៦ ថ្ងៃ ជាប់ គ្នា ហើយ ដែល គ្មាន អ្នក ឆ្លង ថ្មី ខណៈ អ្នក ជាសះស្បើយ ៣នាក់ និង គ្មាន អ្នកស្លាប់
