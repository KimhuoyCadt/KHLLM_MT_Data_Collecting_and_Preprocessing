( ភ្នំពេញ ) ៖ នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា នា ថ្ងៃព្រហស្បតិ៍ ទី៣០ ខែតុលា ឆ្នាំ ២០១៩ លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ ងទី១ កាកបាទ ក្រហម កម្ពុជា បាន ទទួល ជួប ពិភាក្សា ការងារ ជាមួយ ប្រតិភូ មូលនិធិ កាកបាទ ក្រហម រដ្ឋធានី ប៉េកាំង ដឹកនាំ ដោយ លោកស្រី ហ្សាវ ជីង លីង អគ្គ នាយិកា មូលនិធិ កាកបាទ ក្រហម រដ្នធានី ប៉េកាំង ។
ការអញ្ជើញ មក ទស្សនកិច្ច លើក ដំបូង នៅ កម្ពុជា នេះ ដើម្បី សិក្សា ស្វែងយល់ ពី លទ្ធភាព ក្នុង កិច្ចសហប្រតិបត្តិការ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ។
ក្នុង ឱកាស ជួប ពិភាក្សា នោះ លោកស្រី អគ្គ លេខាធិការ រង ទី១ បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ចំពោះ គណៈប្រតិភូ ព្រមទាំង បាន រំលឹក ពី ទំនាក់ទំនង រវាង កាកបាទ ក្រហម កម្ពុជា និង កាកបាទ ក្រហម ចិន ដែល បាន ចាប់ផ្តើម តាំងពី ឆ្នាំ ២០០១មក ។
លោកស្រី បាន រំលឹក ថា កាលពី ឆ្នាំ ២០០២ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន បាន អញ្ជើញ ទៅ ទស្សនកិច្ច នៅ កាកបាទ ក្រហម រដ្ឋធានី ប៉េកាំង ដែល ពេល នោះ សមាគមន៍ ជាតិ ទាំង២ បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ជាមួយគ្នា ផងដែរ ។
កន្លងមក កាកបាទ ក្រហម កម្ពុជា ក៏ មាន ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ជាមួយ សាខា កាកបាទ ក្រហម នៃ តំបន់ ស្វយ័ត ក្វាង ស៊ី នៃ ប្រទេស ចិន ហើយ ដែល កិច្ចសហប្រតិបត្តិការ នេះ បាន និង កំពុង អនុវត្ត នៅ តាម បណ្តា សាខា កាក បាកបាទ ក្រហម កម្ពុជា ខេត្ត មួយចំនួន នៅក្នុង ប្រទេស ។
ដោយឡែក តាមរយៈ ដំណើរទស្សនកិច្ច របស់ ប្រតិភូ នា ពេលនេះ លោកជំទាវ អគ្គ លេខាធិការ ងទី ១សង្ឃឹម ថា កិច្ចសហការ រវាង សមាគម ជាតិ ទាំង ពីរ នឹង កាន់តែ រឹងមាំ និង រីកចម្រើន ។
លោកស្រី អគ្គ លេខាធិការ ងទី១ បាន បញ្ជាក់ ដែរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចាត់ទុក កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ចិន និង កម្ពុជា ជា កិច្ចសហប្រតិបត្តិការ ដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ ហើយ ដែល កាកបាទ ក្រហម កម្ពុជា ក៏ នឹង ក្លាយជា ដៃគូ យុទ្ធសាស្ត្រ លើ វិស័យ មនុស្សធម៌ ជាមួយ កាកបាទ ក្រហម ចិន ផងដែរ ។
លោកស្រី ហ្សាវ ជីង លីង បាន សម្តែង ក្តីរីករាយ ចំពោះ ដំណើរទស្សនកិច្ច ជា លើក ដំបូង របស់ លោកស្រី និង ប្រតិភូ មកកាន់ ប្រទេស កម្ពុជា ហើយ សង្ឃឹម ថា តាមរយៈ ការពិភាក្សា គ្នា ក្នុង ថ្ងៃ នេះ និង អាច ជំរុញ ឱ្យ កិច្ចសហប្រតិបត្តិការ រវាង សមាគម ជាតិ នៃ ប្រទេស ទាំង ២កាន់តែ រឹងមាំ និង រីកចំរើន ថែម ទៀត ។
លោកស្រី មានប្រសាសន៍ ទៀត ថា មូលនិធិ កាកបាទ ក្រហម ប៉េកាំង បាន បង្កើត នៅ ឆ្នាំ ២០០៨ បន្ទាប់ពី មាន គ្រោះ រញ្ជួយ ដី នៅ ខេត្ត ស៊ី ឈាន់ ។
ក្នុង រយៈពេល ជាង ១០ឆ្នាំ ចុងក្រោយ នេះ មូលនិធិ កាកបាទ ក្រហម ប៉េកាំង បាន ស្វែងរក មូលនិធិ បាន យ៉ាង ច្រើន ក្នុង ការជួយ ដល់ ជនរងគ្រោះ ហើយ ក្រៅពី ការជួយសង្គ្រោះ មូលនិធិ ក៏ បាន ធ្វើការ ទៅ លើ ផ្នែក អប់រំ ផ្នែក ព្យាបាល និង ផ្នែក បរិស្ថាន ផងដែរ ។
លោកស្រី បាន បញ្ជាក់ ទៀត ថា គោលបំណង នៃ ទស្សនកិច្ច នៅ កម្ពុជា នា ពេលនេះ គឺ ចង់ ដឹង ថា តើ មូលនិធិ កាកបាទ ក្រហម ប៉េកាំង អាច ជួយ អ្វី ខ្លះ ដល់ កាកបាទ ក្រហម កម្ពុជា ។
ក្រោយពី ទទួលបាន ព័ត៌មាន ពី គ្នា ទៅ វិញ ទៅ មក នៅក្នុង កិច្ចពិភាក្សា នេះ ភាគី ទាំង ពីរ សង្ឃឹម ថា នឹង អាច ឈានទៅ សម្រេច ចេញ ជា គម្រោង កិច្ចសហប្រតិបត្តិការ ណាមួយ ក្នុង ដំណើរទស្សនកិច្ច ជា លើក ទី២ របស់ លោកស្រី និង ប្រតិភូ មូលនិធិ កាកបាទ ក្រហម ប៉េកាំង នៅ កម្ពុជា នា ពេល ខាងមុខ ៕ ស្នងការ នគរបាល ខេត្ត ក្រចេះ៖ កម្លាំង នគរបាល ទូទាំង ខេត្ត ត្រៀមខ្លួន រួចហើយ ដើម្បី អនុវត្ត បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល ក្នុង ការកម្ទេច ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់
( ក្រចេះ ) ៖ ស្នងការ នគរបាល ខេត្ត ក្រចេះ លោក ឧត្តមសេនីយ៍ ទោ លន់ សុផាត បាន អះអាង ថា កម្លាំង នគរបាល ទូទាំង ខេត្ត ក្រចេះ បាន ត្រៀម ខ្លួន រួច ជាស្រេច ហើយ ដើម្បី អនុវត្ត នូវ បទបញ្ជា របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជា បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ក្នុង ការវាយ កម្ទេច ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល ចង់ បំផ្លាញ សន្ដិភាព ។
ការប្រកាស របស់ លោក ឧត្តមសេនីយ៍ ទោ លន់ សុផាត បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នេះ ក្នុង ឱកាស បាន អញ្ជើញ ដឹកនាំ កិច្ចប្រជុំ ពង្រឹង សន្តិសុខ ផ្ទៃក្នុង ដោយ មាន ការចូលរួម ពី លោក លោកស្រី ស្នងការ រង អធិការ នគរបាល ស្រុក ក្រុង ទូទាំង ខេត្ត ។
ក្រោយ កិច្ចប្រជុំ នា រសៀល នោះ លោក ឧត្តមសេនីយ៍ ទោ លន់ សុផាត បាន ចុះ ពិនិត្យ ការហាត់ សម របៀប របស់ កម្លាំង នគរបាល អន្តរាគមន៍ ចំនួន ជាង ១០០ នាក់ ដែល កំពុងតែ បំពាក់ បំប៉ន ហ្វឹកហ្វឺន ដើម្បី ពង្រឹង កិច្ចការងារ សន្តិសុខ និង ត្រៀម ការអន្តរាគមន៍ ។
ថ្លែង ក្នុង ឱកាស សំណេះសំណាល ជាមួយ នាយ នាយ រង នគរបាល និង កងកម្លាំង នគរបាល អន្តរាគមន៍ នា រសៀល នោះ លោក ឧត្តមសេនីយ៍ ទោ លន់ សុផាត បាន នាំ ការសួរសុខទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ជំរុញ ឲ្យ កងកម្លាំង នគរបាល ខិតខំ យកចិត្តទុកដាក់ ក្នុង បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ ។
បន្ថែម ពី នេះ លោក ឧត្តមសេនីយ៍ ទោ លន់ សុផាត បាន ជំរុញ និង ក្រើន រំលឹក ដល់ នាយ នាយ រង នគរបាល ដឹកនាំ កងកម្លាំង នគរបាល ត្រៀម អន្តរាគមន៍ រង់ចាំ បញ្ជា របស់ អគ្គ ស្នងការ នគរបាល ជាតិ បង្រ្កាប បន្ទាន់ ក្រុម ជន ឧទាម ក្រៅ ច្បាប់ ដឹកនាំ ដោយ ឧក្រិដ្ឋ ជន សម រង្សី ក្នុង ចេតនា បង្ក ភាពវឹកវរចលាចល ក្នុង ប្រទេស កម្ពុជា និង ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ។
ដាច់ចរន្ត អគ្គិសនី តំបន់ មួយចំនួន ក្នុង ក្រុង ព្រះសីហនុ ដោយសារ អេស្កាវ៉ាទ័រ កាយ ដី សាងសង់ អគារ បណ្ដាលឲ្យ រលំ បង្គោល ខ្សែ បណ្ដាញ តង់ ស្យុង មធ្យម១ ដើម
( ព្រះសីហនុ) ៖ អគ្គិសនី កម្ពុជា បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ វេលា ម៉ោង ៥៖៣០ នាទី ល្ងាច អគ្គិសនី ខេត្ត ព្រះសីហនុ បាន ធ្វើ ការផ្អាក ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី បណ្តោះអាសន្ន នៅ បន្ទប់ ភ្លើង លេខ PMT97 មូលហេតុ ដោយសារ មាន អេស្កាវ៉ាទ័រ កាយ ដី សាងសង់ អគារ បណ្ដាលឲ្យ រលំ បង្គោល ខ្សែ បណ្ដាញ តង់ ស្យុង មធ្យម (MV) ចំនួន ០១ ដើម ដែល បណ្តាលឲ្យ ដាច់ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន ស្ថិត នៅ ភូមិ លេខ ០៥ សង្កាត់ លេខ ០៤ ក្រុង ព្រះសីហនុ ខេត្ត ព្រះសីហនុ ។
អតិថិជន មាន ចរន្ត អគ្គិសនី ប្រើប្រាស់ ឡើងវិញ នៅ វេលា ម៉ោង ៦៖១០នាទី ល្ងាច ។
អគ្គិសនី កម្ពុជា សូម អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ នៅពេល បំពេញ ការងារ នៅជិត គន្លង ខ្សែ បណ្ដាញ អគ្គិសនី ពីព្រោះ អាច បណ្ដាលឲ្យ មាន ការរអាក់រអួល ក្នុង ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី និង គ្រោះថ្នាក់ ជា យថាហេតុ ៕ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ណែនាំ ដល់ បងប្អូន អតីត សកម្មជន ទណ្ឌិត សម រង្ស៊ី កុំ ទៅ ប្រព្រឹត្ត នូវ អ្វី ផ្ទុយ ពី ច្បាប់ ដែល នាំ ទុក្ខ ដល់ គ្រួសារ និង បំផ្លាញ ជាតិ
( បន្ទាយមានជ័យ ) ៖ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ឧប នាយក រដ្ឋមន្ត្រី ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ អ្នកតំណាងរាស្រ្ត នៅ ល្ងាច ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ បាន ទទួល ជួប សំណេះសំណាល ជាមួយ អតីត ថ្នាក់ដឹកនាំ មូលដ្ឋាន និង អតីត សកម្មជន គណបក្ស សង្រ្គោះ ជាតិ ដែល ចេញមុខ ប្រកាស មិន គាំទ្រ ផែនការ របស់ ទណ្ឌិត សម រង្សី ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន សម្តែង នូវ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ដល់ អស់ លោក ទាំងអស់ និង ថ្លែងអំណរគុណ ដល់ បងប្អូន ក្នុង នាម ជា មហា គ្រួសារ អ្នក បន្ទាយមានជ័យ ដែល មាន ការភ្ញាក់ រលឹក ទាន់ ពេលវេលា ដើរ លើ ផ្លូវ ត្រូវ មិន ទៅ ចូលរួម ជាមួយ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ បំផ្លាញ ជាតិ ហើយ ត្រឡប់មក ចូលរួម កសាង មូលដ្ឋាន យើង ឲ្យ រីកចម្រើន ជាមួយគ្នា ។
ក្នុង ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន ថ្លែង បន្ត ថា សុខ សន្តិភាព គឺ ទុន វិនិយោគ មួយ ដ៏ ធំ សម្រាប់ ប្រជាពលរដ្ឋ យើង គ្រប់ រូប មាន សន្តិភាព មាន ការរីកចម្រើន និង មាន អ្វី ៗ ទាំងអស់ តែ បើ គ្មាន សន្តិភាព កុំ និយាយ ឲ្យ សោះ ពី ការរីកចម្រើន និង ភាពសុខសាន្ត គឺ នាំ មក តែ ភាពសោកសៅ បែកបាក់ កូន ៗ គ្មាន ឱកាស បាន ទៅ រៀនសូត្រ បាត់បង់ អនាគត ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ក៏ បាន ផ្តាំផ្ញើ ដល់ បងប្អូន ទាំងអស់ គ្នា ខិតខំ បង្កបង្កើន ផល និង ឆ្លៀត ចាប់ យក ផល ផ្លែ ផ្កា នៃ សន្តិភាព ដើម្បី អនាគត យើង កូន ចៅ យើង កុំ ទៅ ប្រព្រឹត្ត នូវ អ្វី ផ្ទុយ ពី ច្បាប់ នូវ ឲ្យ មាន ទោស នាំ ទុក្ខ ដល់ គ្រួសារ និង បំផ្លាញ ប្រទេសជាតិ ។
ជា ការឆ្លើយតប ទៅនឹង ទឹកចិត្ត ដ៏ មហា ទិគុណ របស់ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បងប្អូន អតីត ថ្នាក់ដឹកនាំ មូលដ្ឋាន និង អតីត សកម្មជន គណបក្ស សង្គ្រោះ ជាតិ ក្នុង ខេត្ត បន្ទាយមានជ័យ បាន ប្តេជ្ញា មិន គាំទ្រ ដល់ ទណ្ឌិត សម រង្ស៊ី ជាដាច់ខាត ព្រោះ ទណ្ឌិត រូប នេះ កំពុងតែ រត់ គេច ពី សំណាញ់ ច្បាប់ របស់ កម្ពុជា ហើយ កម្ពុជា មាន សម្តេច តេជោ ហ៊ុន សែន និង ថ្នាក់ដឹកនាំ យើង គឺ គ្រប់គ្រាន់ នាំ កម្ពុជា ទៅ មុខ បាន ៕
៤៖ ពលរដ្ឋ ខ្មែរ អាមេរិកាំង រស់ នៅ រដ្ឋ មីនី សូតា សហរដ្ឋ អាមេរិក ប្រឆាំង ចំពោះ ការវិលត្រឡប់ របស់ លោក សម រង្ស៉ី ក្នុង ការផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ( ចុច អាន )
៦៖ តុលាការ ខេត្ត កំពង់ស្ពឺ ចោទប្រកាន់ មនុស្ស ១១នាក់ ពាក់ព័ន្ធ នឹង ផែនការ របស់ ទណ្ឌិត សម រង្ស៉ី ក្នុង ការផ្តួលរំលំ រាជ រដ្ឋាភិបាល កម្ពុជា ( ចុច អាន )
៧៖ សម្តេច តេជោ ហ៊ុន សែន ចេញ សេចក្តីសម្រេច បង្កើត គណៈកម្មការរៀបចំ ពិធី បុណ្យ ព្រះសព សម្តេច ព្រះធម្ម លិខិត លាស់ ឡាយ ( ចុច អាន )
៨៖ សម្ដេច ក្រឡាហោម ស ខេង ដាក់ ចេញ វិធានការ៨ ចំណុច ដើម្បី បង្កើន ការថែរក្សា សន្តិសុខ ក្នុង ឱកាស ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា និង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក ( ចុច អាន )
១០៖ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន និង កំពុង មមាញឹក ក្នុង ការតុបតែង រាជធានី ភ្នំពេញ ដើម្បី ទទួល ព្រះរាជ ពិធី បុណ្យ អុំ ទូក និង ពិធី បុណ្យ ធំ ៗ ជាច្រើន ទៀត ( ចុច អាន )
១៖ ព្រះមហាក្សត្រ ថៃ បន្ត ដក តំណែង មន្ត្រី វាំង ជាច្រើន រូប ទៀត ដោយសារ ពួកគេ ធ្វើការ មិន បាន ល្អ និង គ្មាន ភាពស្មោះត្រង់ ( ចុច អាន )
រដ្ឋមន្រ្តី វង សូត ជំរុញ ឲ្យ គ្រប់ សមាភាព គណៈកម្មាធិការ ជាតិ កម្ពុជា ដើម្បី មនុស្ស ចាស់ ថ្មី ទាំងអស់ ត្រូវ ចូលរួមចំណែក លើកស្ទួយ សុខុមាលភាព មនុស្ស ចាស់
( ភ្នំពេញ ) ៖ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ជំរុញ ឲ្យ សមាភាព គណៈកម្មាធិការ ជាតិ កម្ពុជា ដើម្បី មនុស្ស ចាស់ ថ្មី ទាំងអស់ ត្រូវ ចូលរួមចំណែក លើកស្ទួយ សុខុមាលភាព មនុស្ស ចាស់ ។
លោក បាន បន្ត ថា សមាសភាព ទាំងអស់ មិន ត្រឹមតែ ជួយ លើកស្ទួយ សុខុមាលភាព មនុស្ស ចាស់ ឲ្យ មាន ភាព កាន់តែ ប្រសើរ តែ ប៉ុណ្ណោះ ទេ តែ ក៏ ត្រូវ រួមចំណែក យ៉ាង សកម្ម ក្នុង ការអនុវត្ត គោល នយោបាយ ជាតិ កាត់បន្ថយ ភាពក្រីក្រ និង បង្កើត មណ្ឌល បណ្ដុះបណ្ដាល អ្នក ថែទាំ មនុស្ស ចាស់ សំដៅ ដល់ ការមើល ថែ មនុស្ស ចាស់ ដែល គ្មាន ទីពឹង ឲ្យបាន ល្អ ប្រសើរ និង មាន ភាព កក់ក្ដៅ ក្នុង ជីវិត រស់ នៅ ផងដែរ ។
លោក វង សូត បាន បន្ថែម ថា ក្រសួង សង្គមកិច្ច បាន ផ្ដល់ ការលើកទឹកចិត្ត ដល់ អង្គការ ដៃគូ ដែល បាន និង កំពុង អនុវត្ត គម្រោង លើកស្ទួយ សុខុមាលភាព និង សកម្មភាព របស់ មនុស្ស ចាស់ នៅ តាម សហគមន៍ ឲ្យ កាន់តែ ខ្លាំងក្លា ថែម ទៀត ផងដែរ ។
ជាក់ស្ដែង ក្រសួង បាន សហការ ជាមួយ អង្គការ ជួយ ជន ចាស់ជរា អន្តរជាតិ កម្ពុជា បង្កើត កម្មវិធី ថែទាំង មនុស្ស ចាស់ តាម លំនៅដ្ឋាន ដែល បាន អនុវត្ត ចាប់តាំងពី ឆ្នាំ ២០០៤ នៅ តាម បណ្ដាល ខេត្ត មួយចំនួន ដូចជា បន្ទាយមានជ័យ . បាត់ដំបង . សៀមរាប និង បន្ត អនុវត្ត នៅ បណ្ដាល ខេត្ត ផ្សេង ទៀត ក្រោម ការឧបត្ថម្ភ មូលនិធី ពី កិច្ចសហប្រតិបត្តិការ កូរ៉េ - អាស៊ាន ផងដែរ ។
ការលើកឡើង របស់ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ស្តីពី វឌ្ឍនភាព កាងារ របស់ គណៈកម្មាធិការ ជាតិ កម្ពុជា ដើម្បី មនុស្ស ចាស់ និង ប្រកាស សមាសភាព ថ្មី របស់ គណៈកម្មាធិការ ជាតិ កម្ពុជា ដើម្បី មនុស្ស ចាស់ រៀបចំ ធ្វើ នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នាទី ស្តីការ ក្រសួង សង្គមកិច្ច ។
( ភ្នំពេញ ) ៖ នៅក្នុង យុគសម័យ ទំនើប និង ទីផ្សារ ប្រកួតប្រជែង បច្ចេកវិទ្យា ពិតជា បាន ចូលរួមចំណែក ក្នុង ការជួយ សម្រួល ដល់ អតិថិជន និង សាធារណជន ក្នុង ការប្រកប មុខរបរ ទទួលទាន ប្រកបដោយ ភាពងាយស្រួល ចំណេញ ពេលវេលា និង បង្កើន ចំណូល សម្រាប់ គ្រួសារ ។
ឆ្លើយតប ទៅនឹង តម្រូវការ នេះ ប្រាសាក់ ដែល ជា គ្រឹះស្ថាន ហិរញ្ញវត្ថុ ធំ ជាង គេ នៅ កម្ពុជា បាន និង កំពុង ផ្តល់ សេវា ទូទាត់ វិក្កយបត្រ ទឹក - ភ្លើង ដែល អនុញ្ញាតឱ្យ អតិថិជន ទាំងអស់ អាច ប្រើប្រាស់ សេវា នេះ ដោយ មិន អស់ កម្រៃ សេវា មាន ភាពស្រួល និង រហ័ស ទាន់ចិត្ត តាមរយៈ ប្រើ ម៉ាស៊ីន អេធី អឹម និង សេវា ធនាគារ ចល័ត ប្រាសាក់ ឬ ប្រាសាក់ ម៉ូបាល ប៊ែង ឃីង បាន គ្រប់ ពេលវេលា និង ទីកន្លែង ។
ប្រភេទ វិក្កយបត្រ ដែល អតិថិជន ប្រាសាក់ អាច ទូទាត់ បាន គឺ មាន វិក្កយបត្រ ទឹក របស់ រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ និង វិក្កយបត្រ អគ្គិសនី កម្ពុជា រាជធានី ភ្នំពេញ ខេត្ត កណ្ដាល កំពត កំពង់ចាម ក្រចេះ រតនគិរី បន្ទាយមានជ័យ ស្រុក កំពង់ត្រា ច ស្នួល វើន សៃ លំ ផាត់ និង ស្រុក តា វែង ។
ការផ្តល់ ជូន សេវា ទូទាត់ វិក្កយបត្រ ទឹក - ភ្លើង នេះ ផ្តល់ ភាពងាយស្រួល កាន់តែ ខ្លាំង ចំពោះ អតិថិជន ទាំងអស់ ដោយ មិន ចាំបាច់ ធ្វើដំណើរ ទៅ បង់ ថ្លៃ ទឹក - ភ្លើង នោះ ទេ ដោយ អតិថិជន គ្រាន់តែ ប្រើប្រាស់ សេវា ធនាគារ ចល័ត ឬ ប្រាសាក់ ម៉ូបាល ប៊ែង ឃីង ឬ អាច រក ទីតាំង ម៉ាស៊ីន អេធី អឹម ប្រាសាក់ ដែល នៅជិត លោក អ្នក បំផុត នោះ អតិថិជន អាច ទូទាត់ វិក្កយបត្រ ទឹក - ភ្លើង បាន ដោយ ខ្លួន ឯង បាន យ៉ាង ងាយ ។
សូមអញ្ជើញ មក បើក គណនី សន្សំ នៅ ប្រាសាក់ ថ្ងៃ នេះ ដើម្បី ទទួលបាន ការទូទាត់ វិក្កយបត្រ ទឹក - ភ្លើង និង ធ្វើ ប្រតិបត្តិការ សេវា ធនាគារ ជាច្រើន ទៀត ដោយ មិន អស់ កម្រៃ សេវា ។
ពេញ មួយ ខែតុលា សមត្ថកិច្ច ខេត្ត ព្រះវិហារ ត្រួតពិនិត្យ រថយន្ដ ធ្វើដំណើរ លើ ដង ផ្លូវ បាន ៥០០ គ្រឿង . រកឃើញ ១៦២ គ្រឿង ខុស លក្ខណៈ បច្ចេកទេស
( ព្រះវិហារ ) ៖ រថយន្ត ចំនួន ៥០០ គ្រឿង ត្រូវបាន កម្លាំង សមត្ថកិច្ច ខេត្ដ ព្រះវិហារ ឃាត់ ធ្វើ ការត្រួតពិនិត្យ ក្នុង រយៈពេល មួយ ខែតុលា ឆ្នាំ ២០១៩ នេះ ដែល ធ្វើដំណើរ តាម ដងផ្លូវ ក្នុង ភូមិសាស្ដ្រ ខេត្ត ព្រះវិហារ ដែល ក្នុង នោះ រកឃើញ ១៦២ គ្រឿង មិន ត្រឹមត្រូវ តាម លក្ខណៈ បច្ចេកទេស ។
ក្នុង នោះ ត្រួតពិនិត្យ ឃើញ ថា ត្រឹមត្រូវ មាន ចំនួន ៣៣៨ គ្រឿង ខណៈ ដែល ១៦២ គ្រឿង ទៀត ខុស លក្ខណៈ បច្ចេកទេស ក្នុង នោះ រួម មាន ដឹក សំពីង សំពោង ១២ គ្រឿង . ខ្វះ ឯកសារ ១៣២ គ្រឿង . ឯកសារ ក្លែងក្លាយ ៤គ្រឿង . ដោះរាន ត ខាងក្រោយ ៤គ្រឿង . គ្មាន បណ្ណ បើកបរ ៩នាក់ និង ប័ណ្ណ បើកបរ ក្លែងក្លាយ ម្នាក់ ។
ជាមួយគ្នា នោះ ដែរ លោក សំ លាង ទ្រី ក៏ បាន ធ្វើ ការអំពាវនាវ ឲ្យ ពលរដ្ឋ ដែល ជា ម្ចាស់ យានយន្ត ទាំងអស់ ត្រូវ មាន ឯកសារ គ្រប់គ្រាន់ និង ត្រឹមត្រូវ បញ្ជាក់ ពី អត្តសញ្ញាណ រថយន្ត និង អ្នកបើកបរ រាល់ ពេល បើកបរ តាម ដងផ្លូវ និង ត្រូវ ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ដើម្បី ចៀស ផុត ពី គ្រោះថ្នាក់ ផ្សេង ៗ ៕
សមាគម ក្រុមប្រឹក្សា មូលដ្ឋាន ខេត្ត កំពង់ធំ រៀបចំ មហាសន្និបាត លើក ទី៣ និង ដាក់ចេញ ទិសដៅ បន្ដ
( កំពង់ធំ ) ៖ រដ្ឋបាល ខេត្ត កំពង់ធំ បាន រៀបចំ មហាសន្និបាត លើក ទី៣ របស់ សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ខេត្ត កំពង់ធំ ក្រោម អធិបតីភាព លោក ចាន់ តារា អភិបាល រង ខេត្ត កំពង់ធំ ដោយ មាន ការចូលរួម ពី ក្រុមប្រឹក្សា ស្រុក ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ប្រមាណ ជាង ៣០០ នាក់ ដោយ មាន ការឧបត្ថម្ភ គាំទ្រ ពី សហភាព អឺរ៉ុប សហការ ជាមួយ រដ្ឋបាល ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ ។
ជាមួយគ្នា នេះ ដែរ លោក ក៏ បាន លើកឡើង ទៀត ថា ការលើកកម្ពស់ ស្ថាប័ន និង ការប្រតិបត្តិការ របស់ សមាគម ក្រុមប្រឹក្សា មូលដ្ឋាន ដើម្បី ធានា នូវ ការពេញចិត្ត របស់ សមាជិក ក្រុមប្រឹក្សា នៅ មូលដ្ឋាន ក្នុង ការបំពេញ មុខងារ និង ការទទួលខុសត្រូវ ក៏ ដូចជា ការធ្វើឲ្យ ប្រជាពលរដ្ឋ នៅ តាម មូលដ្ឋាន មាន សេចក្តី ពេញចិត្ត ចំពោះ ការបំពេញ ការងារ របស់ អាជ្ញាធរ មូលដ្ឋាន និង ក្រុមប្រឹក្សា ក្នុង ការផ្ដល់ សេវា សាធារណៈ កាន់តែ រហ័ស មាន ប្រសិទ្ធភាព និង កាន់តែ គួរឲ្យ ទុកចិត្ត នឹង ឆ្លើយតប ចំពោះ តម្រូវការ របស់ ពួកគាត់ ។
ជាមួយគ្នា នោះ លោក ចាន់ តារា បាន វាយតម្លៃ ខ្ពស់ ចំពោះ មហាសន្និបាត ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន អាណតិ្ត ទី៣ ដោយ ផ្អែក ទៅ លើ ការកែទម្រង់ ការអភិវឌ្ឍ តាម បែ ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ដើម្បី បង្កើតឡើង នូវ វប្បធម៌ ប្រជាធិតេយ្យ នៅ មូលដ្ឋាន ដោយ មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ ការលើកកម្ពស់ គុណភាព សេវា សាធារណៈ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច មូលដ្ឋាន ដែល ឆ្លើយតប នឹង តម្រូវការ ជាក់ស្តែង របស់ ប្រជាពលរដ្ឋ សម្ដៅ លើកស្ទួយ គុណភាព នៃ ជីវិត របស់ ប្រជាពលរដ្ឋ និង ចូលរួម កាត់បន្ថយ ភាពក្រីក្រ ដោយ ប្រសិទ្ធភាព ។
ចុងក្រោយ លោក បាន ផ្តាំផ្ញើ ដល់ អង្គ មហាសន្និបាត ត្រូវ សាមគ្គី គ្នា រវាង ថ្នាក់ដឹកនាំ សមាគម ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ខេត្ត កំពង់ធំ ដោយ នាំមក នូវ សមិទ្ធផល ជាច្រើន ជូន ដល់ សមាជិក ស្រប គោលបំណង និង ទិសដៅ របស់ សមាគម ក្នុង ការលើកកម្ពស់ ឋានៈ និង សមត្ថភាព របស់ ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ៕
កន្លែង កម្សាន្ត លក្ខណៈ កញ្ចក់ រួម មាន ស្ពាន និង កន្លែង ជិះ រំអិល ជាដើម បាន រីក វត្តមាន យ៉ាង ច្រើន នៅក្នុង ប្រទេស ចិន ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ ដែល ចង់ ទទួលបាន បទពិសោធន៍ យ៉ាង រំភើប ប្លែក ៗ ។ ប៉ុន្តែ ឧបទ្ទវហេតុ មួយចំនួន ធ្លាប់ បាន កើតឡើង និង មាន ករណី មនុស្ស បាត់បង់ជីវិត យ៉ាងតិច ០២ ករណី ។ បើ តាម ការប៉ាន់ស្មាន ស្ពាន កញ្ចក់ ប្រមាណ ២. ៣០០ខ្សែ មាន វត្តមាន នៅក្នុង ប្រទេស ចិន ។
អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ដឹកនាំ កិច្ចប្រជុំ អន្តរ ក្រសួង ពិនិត្យ និង ពិភាក្សា អំពី « សេចក្តីព្រាង គោល នយោបាយ ជាតិ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ឆ្នាំ ២០២០ - ២០៣០
( ភ្នំពេញ ) ៖ អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្រ្តី រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន គណៈកម្មាធិការ គោល នយោបាយ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ( គ.ស. ហ) បាន ដឹកនាំ កិច្ចប្រជុំ អន្តរ ក្រសួង ដើម្បី ពិនិត្យ និង ពិភាក្សា អំពី « សេចក្តីព្រាង គោល នយោបាយ ជាតិ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ឆ្នាំ ២០២០ - ២០៣០ » ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ នៃ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ របស់ រាជ រដ្ឋាភិបាល ។
សេចក្តីព្រាង គោល នយោបាយ ជាតិ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ ឆ្នាំ ២០២០ - ២០៣០. រៀបចំ ដោយ ក្រុមការងារ នៃ អគ្គ លេខាធិការដ្ឋាន នៃ ក្រុមប្រឹក្សា ជាតិ វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា នៃ ក្រសួង ផែនការ គឺជា សេចក្តីព្រាង ដ៏ មាន សារៈសំខាន់ កំណត់ យុទ្ធសាស្ត្រ និង វិធានការ ដើម្បី សម្រេចបាន នូវ គោលដៅ ដែល បាន កំណត់ សមស្រប តាម បរិការណ៍ ជាក់ស្តែង នៃ ប្រទេសជាតិ រួម មាន៖
* គោលបំណង ទី ១៖ កសាង និង ពង្រឹង ធនធាន មនុស្ស ឱ្យ បាន គ្រប់គ្រាន់ ទាំង បរិមាណ ក៏ ដូចជា គុណភាព និង សមាសភាព ដោយ ពិនិត្យ ពិចារណា ទៅ លើ កត្តា សមភាព យេនឌ័រ . ផ្តល់ លទ្ធភាព ឱ្យ បំពេញ ភារកិច្ច និង មាន ការលើកទឹកចិត្ត សមស្រប ដើម្បីឱ្យ បាន ធនធាន មនុស្ស ផ្នែក វ. ប.ន ជាតិ មាន សមត្ថភាព ។
* គោលបំណង ទី ៣៖ ពង្រឹង ស្ថាប័ន យន្តការស្ថាប័ន និង ក្របខ័ណ្ឌ គតិយុត្តិ ផ្នែក វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង ន វានុវត្តន៍ សម្រាប់ គាំទ្រ ប្រព័ន្ធ អេកូន វានុវត្តន៍ ជាតិ ដើម្បី ធ្វើជា មូលដ្ឋាន នៃ ការអភិវឌ្ឍ វិស័យ ឯកជន និង រដ្ឋ ឱ្យ បាន ប្រកបដោយ ជវភាព និង ទីផ្សារ ប្រកបដោយ សក្តានុពល ព្រម ជាមួយនឹង កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ បាន ល្អ ប្រសើរ ។
* គោលបំណង ទី ៤៖ បណ្តុះ សង្គម ឱ្យ មាន វប្បធម៌ វ. ប.ន ប្រកបដោយ បរិយាប័ន្ន ដោយ ការកសាង ទំនុកចិត្ត សាធារណៈ លើ ផលិតផល និង សេវា បច្ចេកវិទ្យា ជាតិ និង ការពេញចិត្ត ទៅ លើ លទ្ធផល នៃ ការខិតខំ និង ការវិនិយោគ លើ ការអភិវឌ្ឍ វ. ប.ន របស់ ខ្លួន ក៏ ដូចជា ទៅ លើ ការកែទម្រង់ អភិបាលកិច្ច ផ្នែក វ. ប.ន ។
( ភ្នំពេញ ) ៖ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា សម្ដែង ការគាំទ្រ ចំពោះ ការធ្វើ សមយុទ្ធ រួមគ្នា រវាង កងទ័ព កម្ពុជា - វៀតណាម អំពី ការសង្គ្រោះ ពេល មាន គ្រោះមហន្ដរាយ ដែល សមយុទ្ធ នេះ នឹង ត្រូវ ធ្វើឡើង នៅក្នុង ខែធ្នូ ខាងមុខ នេះ ។
នេះ បើ តាម ការបញ្ជាក់ ឲ្យដឹង ពី លោក អ៊ាង សុផល្លែត ជំនួយការ សម្ដេច តេជោ ហ៊ុន សែន ក្រោយ បញ្ចប់ ជំនួប សម្ដែង ការគួរសម របស់ សម្តេច តេជោ ហ៊ុន សែន ជាមួយ លោក ឧត្តមសេនីយ៍ ឯក បម្រុង ផាន វ៉ាន់ ហ្សាង អនុ រដ្ឋមន្ត្រី និង ជា ប្រធាន អគ្គ សេនាធិការ នៃ កងទ័ព ប្រជាជន វៀតណាម នៅ ល្ងាច ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នេះ នៅក្នុង វិមាន សន្ដិភាព ។
សម្ដេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ថា សមយុទ្ធ នេះ ជា ការអនុវត្ត មួយ ដែល ផ្ដល់ នូវ ផលប្រយោជន៍ ដល់ ប្រជាជន ទាំង ពីរ នៅ ពេល ដែល មាន គ្រោះមហន្តរាយ ជាពិសេស ពេល មាន ភ្លើង ឆេះ ព្រៃ និង មាន ទឹក ជំនន់ ជាដើម ។
សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន បន្ត ថា ភ្លើង ឆេះ ព្រៃ មិន ស្គាល់ ព្រំដែន ទេ ដូច្នេះ ការអនុវត្ត សមយុទ្ធ នេះ តម្រូវឲ្យ កងទ័ព កម្ពុជា ចូល ទៅក្នុង ទឹកដី វៀតណាម ហើយ កងទ័ព វៀតណាម ចូល នៅក្នុង ទឹកដី កម្ពុជា ។
ដើម្បី ជៀសវាង ដល់ ការយល់ ច្រឡំ និង ឲ្យ មាន ការយល់ដឹង ទូលំទូលាយ ផង សម្តេច តេជោ ហ៊ុន សែន បាន ផ្ដល់ អនុសាសន៍ ឲ្យ មាន សកម្មភាព មនុស្សធម៌ ជាមួយ ក្នុង សមយុទ្ធ នេះ គឺ ភាគី កម្ពុជា អាច ចូលទៅ ព្យាបាល ប្រជាជន វៀតណាម ហើយ ប្រជាជន វៀតណាម ចូលមក ព្យាបាល ប្រជាជន កម្ពុជា ដើម្បី ត្រៀម នៅពេល មាន គ្រោះមហន្តរាយ ហើយក៏ អាច ជំរុញ ឲ្យ មាន កម្មវិធី ដូចជា កីឡា សិល្បៈ រួមគ្នា ផងដែរ ។
គួរ ជម្រាប ថា ក្នុង ជំនួប នោះ លោក ផាន វ៉ាន់ ហ្សាង បាន នាំ នូវ ការ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពី នាយក រដ្ឋមន្ត្រី វៀតណាម ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន ហើយក៏ បាន គោរព រាយការណ៍ ជូន សម្ដេច តេជោ ថា លោក នឹង ជួបពិភាក្សា ការងារ ជាមួយ នាយ ឧត្តមសេនីយ៍ វង្ស ពិសេន នៅ ថ្ងៃស្អែក នេះ ។
បន្ថែម ពី នេះ លោក ក៏ បាន រាយការណ៍ ជូន សម្ដេច តេជោ ហ៊ុន សែន ទៀត ដែរ ថា កិច្ចសហប្រតិបត្តិការ រវាង ក្រសួង ការពារ ជាតិ និង ក្រសួង ការពារ ជាតិ ទាំង ពីរ គឺ បាន ប្រព្រឹត្តទៅ យ៉ាង ល្អ ប្រសើរ ជាពិសេស លើ ការរៀបចំ សមយុទ្ធសង្គ្រោះ ពេល មាន គ្រោះមហន្តរាយ ដែល នឹង ប្រព្រឹត្តទៅ នៅ ខែធ្នូ ខាងមុខ ។
ជា ការឆ្លើយតប សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ចំពោះ ការផ្ដាំផ្ញើ សួរសុខទុក្ខ ផង ហើយក៏ បាន សម្ដែង នូវ អំណរគុណ ចំពោះ របាយការណ៍ ដែល បាន លើកឡើង ។
ជាមួយ នេះ សម្ដេចក៏ បាន សម្ដែង នូវ ការរីករាយ ផងដែរ ជាមួយនឹង ទំនាក់ទំនង រវាង កងទ័ព ទាំង ពីរ កន្លងមក ដែល ទំនាក់ទំនង ទាំងនោះ បាន នាំមក នូវ ផលប្រយោជន៍ ជូន ដល់ ប្រជាជន ជាពិសេស ប្រជាជន ដែល កំពុងតែ រស់ នៅ តាម ព្រំដែន ៕ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ថ្លែងអំណរគុណ របស់ បងប្អូន មហា គ្រួសារ អ្នក បន្ទាយមានជ័យ មិន ចូលរួម ជាមួយ ពួក ឧទ្ទាម ក្រៅ ច្បាប់ ធ្វើ សកម្មភាព បំផ្លាញ ជាតិ
( បន្ទាយមានជ័យ ) ៖ នា រសៀល ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន ឧប នាយក រដ្ឋមន្ត្រី និង ប្រធាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត បន្ទាយមានជ័យ អ្នកតំណាងរាស្រ្ត និង លោកស្រី ម៉ៅ ម៉ាល័យ កែ គឹម យ៉ាន អម ដោយ ក្រុមការងារ ពី ថ្នាក់ ជាតិ ថ្នាក់ ក្រោម ជាតិ និង អាជ្ញាធរ មូលដ្ឋាន បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ ការប្រណាំង ទូក ង នៅ ក្រុង សិរី សោភ័ណ ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន បាន ពាំនាំ ការផ្តាំផ្ញើ សួរសុខទុក្ខ និង ជូនពរ ជ័យ ពី សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា . សម្តេច ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង ជាពិសេស សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដល់ បងប្អូន ជន រួម ជាតិ ទាំងអស់ ក្នុង ខេត្ត បន្ទាយមានជ័យ និង បងប្អូន ដែល មកពី តាម បណ្តា ខេត្ត នានា ទាំងអស់ ។
ជាមួយគ្នា នេះ និង ជាថ្មី ម្តង ទៀត នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ទឹកចិត្ត ស្រឡាញ់ នូវ សុខ សន្តិភាព របស់ បងប្អូន មហា គ្រួសារ អ្នក បន្ទាយមានជ័យ ដោយ មិន ចូលរួម ជាមួយ ពួក ឧទ្ទាម ក្រៅ ច្បាប់ ធ្វើ សកម្មភាព បំផ្លាញ ជាតិ និង សូមឲ្យ ស្មារតី ស្រឡាញ់ សន្តិភាព នេះ នៅ ជាមួយ បងប្អូន ជារៀងរហូត ដើម្បី រក្សា ការរីកចម្រើន ទាំងអស់ គ្នា ។
ជាមួយនឹង ទឹកចិត្ត សប្បុរស នាយ ឧត្តមសេនីយ៍ កែ គឹម យ៉ាន និង លោកស្រី ម៉ៅ ម៉ាល័យ បាន ឧបត្ថម្ភ ដល់ គណកម្មការរៀបចំ និង កីឡា ទូកង ទាំង ២៦ សរុប ចំនួន ៦៤៤ នាក់ រួម មាន៖ ទឹក សុទ្ធ សរុប ៥០០ យួរ ទឹកក្រូច ៣០០ កេស មី សរុប ១៨៤ កេស សារុង សរុប ១១២៥ សារុង ដែល សរុប ជា ថវិកា មាន ចំនួន ៧៤ លាន ៩៧៦ ពាន់ រៀល គត់ ៕
រដ្ឋមន្ត្រី សុខាភិបាល៖ ត្រឹម ឆ្នាំ ២០១៩ កម្ពុជា កាត់បន្ថយ អត្រា ប្រេវ៉ាឡង់ នៃ ភាពពិការ ភ្នែក ធ្លាក់ចុះ មក នៅ ត្រឹម ០. ៣៧% . ពលរដ្ឋ កម្ពុជា ជាង ៦ម៉ឺន នាក់ ពិការ ភ្នែក
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន ថ្លែង ថា កម្ពុជា បាន កាត់បន្ថយ អត្រា ប្រេវ៉ាឡង់ នៃ ភាពពិការ ភ្នែក ពី ០. ៣៨% នៅ ឆ្នាំ ២០០៧ មក នៅ ត្រឹម ០. ៣៧% នៅ ឆ្នាំ ២០១៩ នេះ ដែល បាន ជួយ លើកកម្ពស់ សុខភាព ភ្នែក ដល់ ប្រជាពលរដ្ឋ បាន កាន់តែ ប្រសើរឡើង ថែម ទៀត ។
ការថយចុះ នៃ អត្រា ប្រេវ៉ាឡង់ នៃ ភាពពិការ ភ្នែក នេះ ដោយសារតែ ប្រជាពលរដ្ឋ មាន ការយល់ដឹង ច្រើន ពី សារៈសំខាន់ នៃ សុខភាព ភ្នែក និង មាន សេវា ព្យាបាល ជំងឺ ភ្នែក គ្រប់គ្រាន់ តាំងពី ថ្នាក់ មូលដ្ឋាន ដល់ ថ្នាក់ ជាតិ ដែល ធ្វើឲ្យ ប្រជាពលរដ្ឋ មាន ភាពងាយស្រួល ក្នុង ការមក ពិនិត្យ និង ព្យាបាល វះកាត់ នៅពេល មាន បញ្ហា ភ្នែក ។
ការថ្លែង បែប នេះ របស់ រដ្ឋមន្ត្រី ក្នុង សិក្ខាសាលា ថ្នាក់ ជាតិ ស្តីពី ការផ្សព្វផ្សាយ លទ្ធផល អង្កេត រហ័ស ស្តីពី ភាពពិការ ភ្នែក ដែល អាច ជៀសវាង បាន នៅ កម្ពុជា និង ការពិនិត្យ ឡើងវិញ នៃ ផែនការ យុទ្ធសាស្ត្រ ដើម្បី គ្រប់គ្រង និង បង្ការ ភាព ពិការ ភ្នែក ២០១៦ - ២០២០ នៅ ថ្ងៃទី ៣០ ខែតុលា នេះ នៅ សណ្ឋាគារ ភ្នំពេញ ។
លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង សង្ឃឹម ថា តាមរយៈ ទិន្នន័យ នៃ លទ្ធផល ស្រាវជ្រាវ នេះ នឹង យក ទៅ ប្រើប្រាស់ ជា ជំនួយ យ៉ាង សំខាន់ ដល់ អ្នក ផ្តល់ សេវា សុខភាព ភ្នែក និង អ្នកធ្វើ ផែនការ សកម្មភាព សម្រាប់ ដោះស្រាយ បញ្ហា ភាពពិការ ភ្នែក និង ខ្សោយ គំហើញ នៅ កម្ពុជា ទាំង ថ្នាក់ ជាតិ និង ក្រោម ជាតិ កាន់តែ ថយចុះ ជា បន្តបន្ទាប់ ទៀត ។
លោក សាស្ត្រាចារ្យ បាន ជំរុញ ឲ្យ កម្មវិធី ជាតិ សុខភាព ភ្នែក បន្ត សហការ ជាមួយ អង្គការ ដៃគូ នានា ដើម្បី បណ្តុះបណ្តាល គ្រូពេទ្យ ឯ ទេស ភ្នែក និង ហេដ្ឋារចនាសម្ព័ន្ធ ឲ្យបាន ច្រើន ថែម ទៀត ដើម្បី សម្រួល ដល់ ការមក ទទួល សេវា ព្យាបាល ភ្នែក របស់ ប្រជាពលរដ្ឋ ។
ចំណែក លោក គង់ នាត នាយក វិទ្យាស្ថាន ស្តារ គំហើញ ប្រាយ អ៊ិន ហូល ឌិន បាន ប្តេជ្ញា ថា នឹង បន្ត ជួយ គាំទ្រ ដល់ ក្រសួង សុខាភិបាល លើ ការបណ្តុះបណ្តាល ធនធាន មនុស្ស ផ្នែក ជំងឺ ភ្នែក និង អប់រំ ផ្សព្វផ្សាយ ស្តីពី សុខភាព ភ្នែក ដល់ សហគមន៍ ដើម្បី ចូលរួម កាត់បន្ថយ ភាពពិការ ភ្នែក និង គំហើញ ចុះខ្សោយ នៅ កម្ពុជា កាន់ តែ ថយចុះ ថែម ទៀត ។
លោក សាស្ត្រាចារ្យ បាន បន្ត ទៀត ថា នា ពេល លប ច្បន្ន នេះ យើង មាន គ្រូពេទ្យេ ឯកទេស ភ្នែក ចំនួន ៧០ នាក់ ចក្ខុ គិលានុប្បដ្ឋាក យិការចំនួន ២៣៧ នាក់ ចក្ខុ មាត្រ ការី ចំនួន ១១៨ នាក់ ដែល កំពុង បម្រើ ការងារ នៅ តាម គ្រឹះស្ថាន សាធារណៈ ចំនួន ២១ នៃ មន្ទីរពេទ្យ ខេត្ត និង រាជធានី ភ្នំពេញ ។
លោក សាស្ត្រាចារ្យ បាន បន្ថែម ទៀត ថា ដើម្បី ជួយ សម្រួល ដល់ ការថែទាំ ភ្នែក ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ នៅ តាម ខេត្ត ដាច់ស្រយាល កម្មវិធី ជាតិ សុខភាព ភ្នែក បាន បង្កើត ក្រុម គ្រូពេទ្យ ចល័ត ចុះ ទៅ ធ្វើ ការពិនិត្យ ព្យាបាល និង វះកាត់ ភ្នែក ឡើង បាយ ចំនួន ២ដង ក្នុង ១ខែ ។ ក្រៅពី នេះ យើង បាន ផលិត ឯកសារ អប់រំ សុខភាព ភ្នែក សំខាន់ ៗ នៅ កម្ពុជា ដែល បាន ផ្សព្វផ្សាយ តាមរយៈ វិទ្យុ ទូរទស្សន៍ និង បណ្តាញ សង្គម ហ្វេ ប៊ុក ផងដែរ ។
តែ យ៉ាងណា ក៏ដោយ លោក សាស្ត្រាចារ្យ ងី ម៉េង បាន បញ្ជាក់ ថា តាមរយៈ លទ្ធផល ស្រាវជ្រាវ យើង បាន រកឃើញ នូវ មូលហេតុ សំខាន់ ៗ ដែល ជា ឧបសគ្គ រារាំង អ្នកជំងឺ មិន មក ទទួល សេវា ថែរក្សា ភ្នែក មាន រួម មាន ការភ័យខ្លាច ក្នុង ការវះកាត់ ជំងឺ ភ្នែក ឡើង បាយ ដែល មាន ប្រមាណ ៤៥ ភាគរយ ។
អ្នកជំងឺ គិត ថា ពុំ ចាំបាច់ ព្យាបាល ភ្នែក ព្រោះ នៅ មើលឃើញ តិច ៗ និង អាច ដើរ បាន ប្រមាណ ១៧ភាគរយ អ្នកជំងឺ បារម្ភ ពី បញ្ហា ថវិកា ថ្លៃ ព្យាបាល មាន ប្រមាស ណ១៤ ភាគរយ និង អ្នកជំងឺ មិន ទាន់ មាន ការយល់ដឹង ពី ជំងឺ ភ្នែក ដែល អាច ព្យាបាល បាន មាន ប្រមាណ ១១. ៨ភាគរយ ។
ជន ក្បត់ ជាតិ សម រង្ស៉ី និង បក្ខពួក ត្រូវបាន គេ ហៅ ថា ជា អ្នកនយោបាយ ប្រជានិយម ធ្វើ នយោបាយ បោកប្រាស់ រាស្រ្ត និង ឆក់ ឱកាស ក្នុង ការផ្គាប់ ផ្គន់ចិត្ត របស់ រាស្ត្រ លើ បញ្ហា ដែល រាស្ត្រ ថ្នាំង ថ្នាក់ ដោយ មិន បាន ថ្លឹងថ្លែង ពី ស្ថានភាព ពិត របស់ សង្គមជាតិ នោះ ឡើយ ។
រីឯ ចំណុច រួម ទី២៖ គឺ ការស្អប់ខ្ពើម ពួក ឥស្សរជន អ្នក មាន អំណាច ឬ អ្នក មាន ឥទ្ធិពល ដូចជា ថ្នាក់ដឹកនាំ ប្រទេស និង អ្នកកាសែត នៃ ប្រព័ន្ធ ផ្សព្វផ្សាយ នានា ( ទាំង ពួក មិន កាន់ ជើង ខ្លួន ទាំង ពួក មាន ជំហរ អព្យាក្រឹត …) ដែល ពួក ប្រជានិយម ចោទ ថា ឋិតនៅ ខាងពួក ឥស្សរជន និង ចោទ ថា កំពុង ចិញ្ចឹម ប្រព័ន្ធ គ្រប់គ្រង បច្ចុប្បន្ន ដែល មិន ផ្តល់ យោជន៍ ដល់ រាស្ត្រ ។
នាយក គ្រប់គ្រង ការផ្សាយ វិទ្យុ បារាំង ជា ខេមរ ភាសា រូប នេះ បន្ត លើកឡើង ថា អាស្រ័យ ទៅតាម ស្ថានភាព ផ្ទៃក្នុង នៃ ប្រទេស នីមួយ ៗ ពួក ប្រជានិយម ជា អ្នក ប្រកាន់ វណ្ណៈ និង ប្រកាន់ ពូជសាសន៍ ។ នៅក្នុង ន័យ នេះ ពួក ប្រជានិយម ដែល ជាទូទៅ មិន មែន ជា អ្នកក្រីក្រ ទាល់តែសោះ ញុះញង់ រាស្ត្រ ឱ្យ ស្អប់ខ្ពើម ពួក អ្នក មាន និង អ្នក មាន អំណាច ឱ្យ ស្អប់ខ្ពើម ពួក អ្នក ដែល មិន គាំទ្រ ពួក ខ្លួន និង ឱ្យ ស្អប់ខ្ពើម ពួក ជន អន្តោប្រវេសន៍ ដែល ពួកគេ ចោទ ថា ប្រឆាំង នឹង ប្រយោជន៍ រាស្ត្រ . ប្រឆាំង នឹង ប្រយោជន៍ ជាតិ ។
អ្នក ព័ត៌មាន ជំនាញ ភូមិសាស្ត្រ នយោបាយ ពិភពលោក ដ៏ មាន ប្រជាប្រិយភាព រូប នេះ បាន បញ្ជាក់ ថា ជា រួម មក ពួក ប្រជានិយម ពេល មាន អំណាច នៅក្នុង ដៃ ហើយ មិន រារែក នឹង ប្រមូលផ្តុំ អំណាច បែប ផ្តាច់ការឡើយ ដ្បិត អាង ថា ពួកគេ បំពេញ តាម បំណង របស់ រាស្ត្រ ដែល បាន បោះឆ្នោត ឱ្យ ពួកគេ ក្នុង គោលដៅ សងសឹក អ្នកធ្វើបាប រាស្ត្រ ។
( ពោធិ៍សាត់ ) ៖ លេច វត្តមាន ហ្វូង សត្វ កុក រាប់ ពាន់ ក្បាល នៅ អាង ព្រះពន្លៃ ស្ថិត ក្នុង ឃុំ ផ្ទះ រុង ស្រុក តា លោ សែន ជ័យ ខេត្ត ពោធិ៍សាត់ បង្កឲ្យ មាន ការភ្ញាក់ផ្អើល និង បង្កើត ក្ដីរំភើប រីករាយ យ៉ាង ខ្លាំង ដល់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ជាពិសេស អាជ្ញាធរ ខេត្ត ស្រុក និង ភ្ញៀវ ទេសចរ មាន បំណង ចង់ ទៅ គយគន់ មើល សត្វ ទាំងនោះ ។
លោក អភិបាល រង ស្រុក បន្ត ថា បងប្អូន ប្រជាពលរដ្ឋ អាច មក ទស្សនា មើល ពួកវា នៅពេល ព្រលឹម អុរ ឬ ពេល ជិត អសង្គត ។ បងប្អូន ប្រជាពលរដ្ឋ អាច ធ្វើដំណើរ តាម ផ្លូវ ជាតិ លេខ ៥៥ ( ក្រាល កៅស៊ូ ) ពី ផ្លូវ ជាតិ លេខ ៥ ស្ពាន ស្វាយ អាត់ កាត់ បូជនីយដ្ឋាន លោក ឧកញ៉ា ឃ្លាំង មឿង ទៅដល់ ឃុំ សំរោង បត់ ស្ដាំ ឆ្ពោះទៅ ឃុំ ផ្ទះ រុង ស្រុក តា លោ សែន ជ័យ នឹង ឃើញ ហើយ ។
លោក ចេង ប៊ុន លេខ បាន បន្ថែម ថា នៅពេល ថ្ងៃ ពួកវា បាន ហើរ ទៅ រក ចំណី នៅ កន្លែង ផ្សេង លុះ ម៉ោង ៥ល្ងាច ទើប ត្រឡប់ មកវិញ ដោយ ហើរ ខ្វែងខ្វាត ជុំវិញ មាត់ បឹង និង ជុំវិញ ទំនប់ ដំណាក់ ឈើ ក្រម រួច ក៏ ដេក នៅលើ ដើមឈើ ពេញ ក្នុង ផ្ទៃ បឹង ព្រះពន្លៃ តែម្តង ។
ជាមួយគ្នា នោះ លោក អភិបាល រង ស្រុក ក៏ បាន អំពាវនាវ ដល់ សមត្ថកិច្ច ជំនាញ មន្ត្រី និង ប្រជាពលរដ្ឋ សហការ ជួយ ទប់ស្កាត់ បង្ក្រាប បទល្មើស ដើម្បីឲ្យ សត្វ ទាំងនោះ រួចផុត ពី ការយាយី ពីសំណាក់ ជន ខិលខូច ៕
សូម ទស្សនា វីដេអូ សារលិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន ទាំង ស្រុង៖
ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ឲ្យដឹង ថា នៅ ពេល នេះ កម្លាំង នគរបាល ជំនាញ របស់ លោក កំពុងតែ ចេញ អន្ដរាគមន៍ ដើម្បី ជួយសង្គ្រោះ ។ ខណៈ មូលហេតុ មិន ទាន់ ដឹង ច្បាស់ នៅឡើយ ទេ ។
ទេសរដ្ឋមន្ដ្រី លី ធុជ៖ មន្ដ្រី អាជ្ញាធ មីន ត្រូវ យកចិត្តទុកដាក់ បំពេញ ការងារ ឲ្យបាន ត្រឹមត្រូវ និង មាន ប្រសិទ្ធភាព តាម ភារកិច្ច ដែល រាជ រដ្ឋាភិបាល ប្រគល់ ជូន
( សៀមរាប ) ៖ ទេសរដ្ឋមន្រ្តី លី ធុជ អនុប្រធាន ទី១ អាជ្ញាធរ មីន តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង ជា ប្រធាន អាជ្ញាធរ មីន បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បិទ អង្គ វិបស្សនា ការងារ របស់ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ កម្ពុជា គ្រប់គ្រង សកម្មភាព កំចាត់ មីន និង សង្រ្គោះ ជន ពិការ ដោយសារ មីន នៅ ខេត្ត សៀមរាប ។
ឆ្លៀត ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្រ្តី លី ធុជ បាន នាំ នូវ សេចក្តី សួរសុខទុក្ខ និង ក្តី នឹករលឹក របស់ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី និង ជា ប្រធាន អាជ្ញាធរ មីន ជូន ចំពោះ មន្រ្តី បុគ្គលិក អាជ្ញាធរ មីន និង ភាគី ពាក់ព័ន្ធ វិស័យ សកម្មភាព មីន ទាំងអស់ នៅ កម្ពុជា ព្រមទាំង បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ការខិតខំ ប្រឹងប្រែង បំពេញ ការងារ អស់ ពី កម្លាំង កាយ កម្លាំងចិត្ត មិន ខ្លាច ការនឿយហត់ ដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ របស់ ថ្នាក់ដឹកនាំ មន្រ្តី បុគ្គលិក នៃ អាជ្ញាធរ មីន ទាំងអស់ នា ពេល កន្លងមក នេះ ។
លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន កោតសរសើរ និង ថ្លែងអំណរគុណ យ៉ា ជ្រាលជ្រៅ ដល់ អង្គការ UNDP NPA UNICEF ប្រទេស ម្ចាស់ ជំនួយ និង ដៃគូ អភិវឌ្ឍន៍ ដ៏ទៃ ទៀត ដែល បាន និង កំពុង គាំទ្រ ដល់ រាជ រដ្ឋាភិបាល ក្នុង វិស័យ សកម្មភាព មីន ដើម្បី ចូលរួមចំណែក សង្រ្គោះ ជីវិត ប្រជាពលរដ្ឋ កម្ពុជា ឲ្យ រួចផុត ពី គ្រោះថ្នាក់ ដោយសាមីន និង សំណល់ ជាតិ ផ្ទុះ ពី សង្រ្គាម និង ចូលរួមចំណែក កាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ នៅ តាម តំបន់ ជនបទ ។
ទេសដ្ឋមន្រ្តី ក៏ បាន រំលឹក ដាស់តឿន ដល់ ថ្នាក់ដឹកនាំ មន្រ្តី បុគ្គលិក ទាំងអស់ នៃ អាជ្ញាធរ មីន ត្រូវ មាន ជំនឿ និង ជឿ ទុកចិត្ត លើ ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ហើយ បន្ត គាំទ្រ សម្តេច ដើម្បី សម្តេច បន្ត រក្សា ការពារ សន្តិភាព ស្ថិរភាព នយោបាយ សណ្តាប់ធ្នាប់ សង្គម និង ការអភិវឌ្ឍ ។
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
អគ្គិសនី កម្ពុជា ជូនដំណឹង ពី ការផ្អាក ចរន្ត អគ្គិសនី នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃទី ០៣ ខែវិច្ឆិកា
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការផ្អាក ការផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី ដើម្បី អនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ បង្ក លក្ខណៈ ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ នៅ ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ ដល់ ថ្ងៃទី ០៣ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ៕
សូម កុំ បើកបរ ស្ថិត ក្រោម ឥទ្ធិពល គ្រឿងស្រវឹង ! ស្លាប់ ៥នាក់ និង របួស ២០ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ៣០ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ១៥លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ របួស ស្រាល ៩នាក់ និង របួស ធ្ងន់ ១១នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១៥លើក នេះ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . ប្រជែង . បត់ គ្រោះថ្នាក់ . ស្រវឹង និង កត្ដាយាន ៕
គួរ ជម្រាប ថា ករណី សម្លាប់ ខ្លួន ដោយសារ ត្រូវបាន គេ ចំអក ថា មាន « សម្បុរ ខ្មៅ » មិន មែន ទើបតែ កើតឡើង ជា លើក ទី១ នៅក្នុង ប្រទេស ឥណ្ឌា នោះ ទេ ។ ពោលគឺ កាលពី ឆ្នាំ ២០១៤ ស្ត្រី ម្នាក់ មាន អាយុ ២៩ ឆ្នាំ បាន សម្លាប់ ខ្លួន ឯង បន្ទាប់ពី ត្រូវបាន ប្ដី ចំអក ថា មាន ស្បែក ខ្មៅ ( សម្បុរ ខ្មៅ ) ហើយ កាលពី ឆ្នាំ ២០១៨ ក្មេងស្រី ម្នាក់ អាយុ ១៤ ឆ្នាំ ក៏ បាន សម្លាប់ ខ្លួន ផងដែរ ដោយសារតែ មិត្ត រួម ថ្នាក់ ហៅ ថា ស្រី អាក្រក់ ស្បែក ខ្មៅ ៕
កម្លាំង នគរបាល ទូទាំង ខេត្ត កំពត ប្រកាស ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ មិន ឲ្យ ក្រុម ឧទ្ទាម មក បំផ្លាញ បាន ជាដាច់ខាត
( កំពត ) ៖ កម្លាំង នគរបាល ទូទាំង ខេត្ដ កំពត នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នេះ ក្រោម ការដឹកនាំ បញ្ជា ផ្ទាល់ ពី លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ស្នងការ នគរបាល ខេត្ត បាន ប្រកាស ប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ថា ត្រូវតែ ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដែល កើត ចេញពី ការបោះឆ្នោត មិន ឲ្យ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ មក បំផ្លាញ បាន ឡើយ ។
លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ ក្នុង ឱកាស ចុះ ត្រួតពិនិត្យ កងកម្លាំង បាន អះអាង ថា បដិវត្ត ពណ៍ បាន បំផ្លាញ សុខ សន្តិភាព ប្រទេស ផ្សេង ៗ ជាច្រើន មកហើយ ដូច្នេះ នៅ កម្ពុជា ក្រោម ការដឹកនាំ ដ៏ ឈ្លាសវៃ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រធាន នោះ មិន ចាញ់បោក កល ល្បិច របស់ ជន ណា ឡើយ ហើយ បើ មាន ក្តិប បដិវត្ត ពណ៍ មួយ ដាច់ខាត ត្រូវតែ កម្ទេច មួយ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន សង្កត់ធ្ងន់ ថា ទម្រាំ មាន សន្តិភាព ដូច សព្វ ថ្ងៃ នេះ ប្រមុខ រាជ រដ្ឋាភិបាល បាន យក សាច់ ស្រស់ ឈាម ស្រស់ ទៅ ប្តូរ ដែល ជា តម្លៃ មិន អាច កាត់ថ្លៃ បាន ដូច្នេះ បើ មាន អ្វី ក៏ដោយ ដែល បង្កលាចល អ្វី ក៏ដោយ ឲ្យ តែ បណ្តាលឲ្យ ប៉ះពាល់ ដល់ សន្តិភាព រំខាន ដល់ សេចក្តីសុខ សុវត្ថិភាព របស់ ប្រជាពលរដ្ឋ រស់ នៅ គឺ យើង ទាំងអស់ គ្នា ជា កងកម្លាំងប្រដាប់អាវុធ ត្រូវតែ បង្ក្រាប កម្ទេចចោល ជាដាច់ខាត ។
គួរ ជម្រាប ថា ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ ម៉ៅ ច័ន្ទ មធុរិទ្ធ បាន នាំ ការសួរសុខទុក្ខ ពីសំណាក់ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ជំរុញ ឲ្យ កងកម្លាំង នគរបាល ត្រូវ ខិតខំ យកចិត្តទុកដាក់ ក្នុង បុព្វហេតុ ការពារ ជាតិ មាតុភូមិ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី៣០ ខែតុលា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
ប្រធានាធិបតី នៃ សាធារណរដ្ឋ ហុង គ្រី និង ភរិយា បាន អញ្ជើញ មកដល់ កម្ពុជា ហើយ នៅ យប់ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០១៩ ដើម្បី បំពេញ ទស្សនកិច្ច ផ្លូវ រដ្ឋ រយៈពេល ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ២៧ ដល់ ៣០ ខែតុលា ឆ្នាំ ២០១៩ តាម ការអញ្ជើញ របស់ ព្រះមហាក្សត្រ កម្ពុជា ។
ក្នុង ដំណើរទស្សនកិច្ច លើក នេះ លោក ប្រធានាធិបតី បាន ចូល គាល់ ព្រះមហាក្សត្រ ខ្មែរ នៅ ព្រះបរម រាជ វាំង និង ជួប សម្តែង ការគួរសម ដាច់ដោយឡែក ពី គ្នា ចំពោះ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា និង សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា កម្ពុជា ព្រមទាំង មាន ជំនួប ពិភាក្សា ការងារ ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ផងដែរ ។
ទស្សនកិច្ច ផ្លូវ រដ្ឋ លើក ដំបូង មកកាន់ កម្ពុជា របស់ លោក យ៉ាណូស អាឌ័រ មកកាន់ កម្ពុជា បាន ក្លាយជា ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ ក្នុង ទំនាក់ទំនង ទ្វេ ភាគី កម្ពុជា - ហុង គ្រី ហើយ នឹង រួមចំណែក យ៉ាង សំខាន់ ដល់ ការពង្រឹង បន្ថែម ទៀត នូវ ចំណង មិត្តភាព និង សាមគ្គីភាព ក៏ ដូចជា បង្កើន វិសាលភាព និង ជម្រៅ នៃ កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ៕ ប្រធានាធិបតី ហុង គ្រី កោតសរសើរ ភាព ដ៏ អស្ចារ្យ នៃ តំបន់ ទេសចរណ៍ ខេត្ត សៀមរាប - អង្គរ និង សន្យា ផ្សព្វផ្សាយ ដល់ ភ្ញៀវ ទេសចរ ហុង គ្រី ឲ្យ មក ទស្សនា កាន់តែ ច្រើន
បើ តាម លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ៣០ ខែតុលា នេះ តាមរយៈ ទស្សនា តំបន់ គោលដៅ ទេសចរណ៍ ខេត្ត សៀមរាប លោក ប្រធានាធិបតី និង ភរិយា បាន សម្តែង ការកោតសរសើរ ភាព ដ៏ អស្ចារ្យ នៃ តំបន់ ទេសចរណ៍ ខេត្ត សៀមរាប - អង្គរ និង សន្យា ជំរុញ ការផ្សព្វផ្សាយ តំបន់ ទេសចរណ៍ នេះ ដល់ ភ្ញៀវ ទេសចរ ជនជាតិ ហុង គ្រី មក ទស្សនា ខេត្ត សៀមរាប កាន់តែ ច្រើន បន្ថែម ទៀត ។
គួរ ជម្រាប ថា ប្រាសាទ ព្រះគោ ជា ប្រាសាទ មួយ ស្ថិត ក្នុង ក្រុម ប្រាសាទ រលួស ហើយ ដែល ប្រទេស ហុង គ្រី ធ្លាប់ បាន ជួយ ជួសជុល កាល ក្នុង ទសវត្សន៍ ទី៩០ ។
លោក យ៉ាណូស អាឌ័រ (Janos Ader) ប្រធានាធិបតី នៃ សាធារណរដ្ឋ ហុង គ្រី និង ភរិយា នឹង ចាកចេញ ពី កម្ពុជា នៅ ម៉ោង ជាង ៨៖៤៥ នាទី យប់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នេះ ៕ អាល្លឺម៉ង់ បន្ត ជួយ បណ្តុះបណ្តាល ធនធាន មនុស្ស ក្នុង វិស័យ សុខាភិបាល ពិសេស លើកកម្ពស់ សុខុមាលភាព ប្រជាជន នៅ តំបន់ ដាច់ស្រយាល
ការលើកឡើង បែប នេះ របស់ លោក គ្រីស្ទាន បែក ហ្គឺ ក្នុង ឱកាស ចូល ជួប សម្តែង ការគួរសម និង ជំនួប ពិភាក្សា ការងារ ជាមួយ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នៅ ទីស្តីការ ក្រសួង ។
លោក គ្រីស្ទាន បែក ហ្គឺ បាន ថ្លែង បន្ត ថា ការ ដែល អាល្លឺម៉ង់ បន្ត ជួយ ដល់ ក្រសួង សុខាភិបាល នេះ គឺ ដោយសារតែ មើលឃើញ ពី ការរីកចម្រើន របស់ វិស័យ នេះ គួរឲ្យ កត់សំគាល់ ។ ដូចនេះ អាល្លឺម៉ង់ នឹង បន្ត ខិតខំ ជួយ ដល់ វិស័យ សុខាភិបាល នៅ កម្ពុជា ជាបន្ត ទៀត ដើម្បី លើកកម្ពស់ សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ កាន់តែ ប្រសើរឡើង ថែម ទៀត ។
ជា កិច្ច ឆ្លើយតប លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង បាន ថ្លែងអំណរគុណ ដ៏ យ៉ាង ជ្រាលជ្រៅ ចំពោះ រដ្ឋាភិបាល អាល្លឺម៉ង់ ដែល បាន ជួយ ដល់ ក្រសួង សុខាភិបាល ទាំង ជំនួយ បច្ចេកទេស និង ថវិកា ដែល ធ្វើឲ្យ កម្ពុជា ទទួលបាន ជោគជ័យ ក្នុង ការសម្រេចបាន គោលដៅ អភិវឌ្ឍន៍ សហសវត្ស នា ពេល កន្លងមក ហើយ យើង នឹង បន្ត ខិតខំ បន្ត ទៀត ដើម្បី ឈានទៅ សម្រេច ឲ្យបាន ទៅ តាម គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព ។
លោក សាស្ត្រាចារ្យ បាន បញ្ជាក់ ថា ការពង្រីក ការសហការ ជាមួយ អាល្លឺម៉ង គឺ មាន នៅ ខេត្ត កំពង់ធំ កំពត និង កែប នេះ នឹង ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការពង្រឹង សេវា ថែទាំ សុខាភិបាល សុខភាព បឋម ជូន ដល់ ពលរដ្ឋ ក្រីក្រ នៅ តាម តំបន់ ជនបទ ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ស្រប ទៅតាម គោលដៅ របស់ រាជ រដ្ឋាភិបាល របស់ យើង ។
រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង បាន ថ្លែង បន្ត ថា កន្លងមក នេះ អាល្លឺម៉ង់ ធ្លាប់ បាន ជួយ ដល់ ក្រសួង សុខាភិបាល លើ ជំនួយ បច្ចេកទេស និង ថវិកា ដើម្បី អភិវឌ្ឍន៍ ធនធាន មនុស្ស និង គម្រោង មូលនិធិ សមធម៌ ក្នុង ការគាំពារ សង្គម ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ជាពិសេស ជួយ លើកកម្ពស់ ដល់ សុខភាព មាតា និង ទារក ទើបនឹង កើត ៕
រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ ប្រកាស ពី ការប្រារព្ធ ទិវា រ បុណ្យ ឯករាជ្យ ជាតិ ហូប អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ និង ពិធី បណ្តែត ប្រទី ប រាំ លេង កំសាន្ត សប្បាយរីករាយ ជុំ ពលរដ្ឋ ទូទាំង ខេត្ត នៅ ថ្ងៃទី ០៩ និង ១១ ខែវិច្ឆិកា ខាងមុខ
( ត្បូងឃ្មុំ ) ៖ លោក ជា ម ច័ន្ទ សោភ័ណ អភិបាល ខេត្ត ត្បូងឃ្មុំ នៅ ព្រឹក ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតីភាព ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា ដោយ មាន ការចូលរួម ពី អភិបាល រង ខេត្ត មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត និង មន្ត្រី ពាក់ព័ន្ធ ជាច្រើន រូប ទៀត បាន សម្រេច យក ថ្ងៃទី ០៩ ខែវិច្ឆិកា ប្រារព្ធ ទិវា រ បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា និង ទិវា រកំណើត កងយោធពល ខេមរភូមិន្ទ ខួប លើក ទី៦៦ និង ថ្ងៃទី ១១ ខែវិច្ឆិកា ប្រារព្ធ ពិធី បណ្តែត ប្រទី ប ជួបជុំ បងប្អូន ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ។
លោក អភិបាល ខេត្ត ក៏ បាន ក្រើន រំលឹក និង ជំរុញ ដល់ កងកម្លាំងប្រដាប់អាវុធ ទាំង៣ ប្រភេទ រួមម ជាមួយ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ស្រុក សហការ គ្នា ធ្វើ យ៉ាងណា ការពារ សុខ សុវត្ថិភាព ពលរដ្ឋ ក្នុង ពិធី ទាំង២ ខាងលើ នេះ ឲ្យបាន ល្អ ជាពិសេស ទប់ស្កាត់ និង ឃាត់ខ្លួន ឲ្យ ខាន តែ បាន រាល់ ជន អគតិ ទាំងអស់ ដែល មាន គំនិត និង សកម្មភាព រួម ជាមួយ អ្នកទោស ជន ក្បត់ ជាតិ សម រង្ស៊ី បង្ក មាន ឲ្យ មាន ការចលាចល លើ ទឹកដី ខេត្ត ត្បូងឃ្មុំ នោះ ឡើយ ។
សូម បញ្ជាក់ ថា ពិធី បុណ្យ ទាំង២ ដែល រដ្ឋបាល ខេត្ត នឹង រៀបចំឡើង ឲ យ៉ាង អធិកអធម សប្បាយ ជួបជុំ ប្រជាពលរដ្ឋ នោះ គឺ
១៖ ទិវា បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា និង ទិវា រកំណើត កងយោធពល ខេមរភូមិន្ទ ខួបៀ លើក ទី៦៦ ( ១៩៥៣ - ២០១៩ ) ដែល នឹង ធ្វើឡើង នៅ បរិវេណ រដ្ឋបាល សាលា ខេត្ត នា ថ្ងៃទី ០៩ ខែវិច្ឆិកា ដោយ មាន អ្នកចូលរួម ដោយ ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ ជុំវិញ ខេត្ត កងកម្លាំង ប្រដាច់ អាវុធ អង្គការ នានា វិស័យ ឯកជន សិស្សានុសិស្ស និស្សិត និង ប្រជាពលរដ្ឋ ជាង ២ពាន់ នាក់ ក្នុង នោះ ក៍ បាន រៀបចំ ឲ្យ មាន ការហូប អំបុក ការពារ ជាតិ សាសនា ព្រះមហាក្សត្រ រីករាយ ជុំគ្នា ផងដែរ ។
លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង បាន បញ្ជាក់ ឲ្យដឹង ថា ដោយ អនុវត្ត តាម បទបញ្ជា ដ៏ ម៉ឹង ម៉ាត់ របស់ លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស កម្លាំង កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន យកចិត្តទុកដាក់ ស្រាវជ្រាវ ករណី ខាងលើ រហូត ឈានដល់ ការបង្ក្រាប បាន ជាក់ស្តែង ។
ជនសង្ស័យ ឈ្មោះ ធុយ វី ឬ ធុយ ឬ ទ្ធី នេះ បាន ចាកចេញ ទៅ ប្រទេស ថៃ ដោយ មាន ការផ្តូច ផ្តើម ពី ឈ្មោះ សម សេរី ជា មេ ចលនា រណសិរ្ស រំដោះ ជាតិ ខ្មែរ និង ជា នាយក រដ្ឋមន្ត្រី នៃ រដ្ឋាភិបាល និរទេសជាតិ ខ្មែរ ខុស ច្បាប់ ហើយ ឈ្មោះ ធុយ វី ធ្លាប់ ត្រូវបាន តែងតាំង ជា អ្នកនាំពាក្យ របស់ រណសិរ្ស រំដោះ ជាតិ ខ្មែរ និង ជា រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម ក្នុង រដ្ឋាភិបាល និរទេស ខុស ច្បាប់ របស់ សម សេរី ផងដែរ ។ នៅក្នុង ឆ្នាំ ២០១៩ ឈ្មោះ ធុយ វី ត្រូវបាន សម សេរី តែងតាំង ទៅជា អនុ រដ្ឋមន្ត្រី ក្រសួង វប្បធម៌ និង សាសនា វិញ ។
ឈ្មោះ ធុយ វី បាន បញ្ជាក់ ថា រូប គេ ពិតជា បាន ចូលរួម ក្នុង សកម្មភាព រួម គំនិត ក្បត់ ជាមួយ ក្រុម ឧទ្ទាម សម សេរី និង ក្រុម អតីត CNRP ពិតប្រាកដ មែន ក្នុង នោះ រូប គេ បាន ចូលរួម ក្នុង ការប្រជុំ ទទួល ផែនការ នានា . រៀបចំ ឯកសារ និង សៀវភៅ ដែល មាន ខ្លឹមសារ ញុះញង់ បង្កឲ្យ មាន ចលាចល ក្នុង សង្គម និង បាន ធ្វើ ការផ្សព្វផ្សាយ ខ្លឹមសារ នយោបាយ និង ស្ថានភាព នៅក្នុង ស្រុក ខ្មែរ ដោយ ផ្តោត លើ ការរិះគន់ វាយប្រហារ ដល់ រដ្ឋាភិបាល កម្ពុជា បច្ចុប្បន្ន តាមរយៈ ប្រព័ន្ធ បណ្តាញ សង្គម ហ្វេសប៊ុក ។
បើ តាម អាវុធហត្ថ រាជធានី ភ្នំពេញ ឈ្មោះ ធុយ វី បាន ឆ្លើយ បន្ថែម ថា ចំពោះ គូកន និង បក្ខពួក របស់ ខ្លួន គឺ នៅ ប្រទេស ថៃ ទាំងអស់ មិន មាន នៅ កម្ពុជា នោះ ទេ ហើយ រូប គេ តែង លួច ចេញ ចូលមក ប្រទេស កម្ពុជា តាម ស្ថានភាព ជាក់ស្តែង ដែល អាច ចូល បាន នៅ ពេល ដែល មាន កិច្ចការ ត្រូវ ធ្វើ ដើម្បី យក ទៅ រាយការ ឱ្យ សម សេរី មុនពេល បង្ហោះ តាម បណ្តាញ សង្គម ៕
អភិបាល ខេត្ត កណ្ដាល ជំរុញ មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ ផ្សព្វផ្សាយ ប្រជាជន ទាំងអស់ កុំ ចូលរួម ជាមួយ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល ប៉ង ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល
( កណ្ដាល ) ៖ លោក បណ្ឌិត ម៉ៅ ភិរុណ អភិបាល ខេត្ត កណ្ដាល ជំរុញ ដល់ មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ ត្រូវ ផ្សព្វផ្សាយ ណែនាំ ដល់ ប្រជាជន ទាំងអស់ កុំ ចូលរួម ជាមួយ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល ប្រើប្រាស់ ឧបាយកល គ្រប់ រូបភាព ក្នុង បំណង វិលត្រឡប់ ចូល ស្រុក ដើម្បី ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ និង រំខាន ភាព សុខសាន្ត របស់ ប្រជាជន នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ខាងមុខ នេះ ។
លោក អភិបាល ខេត្ត បាន ថ្លែង បែប នេះ នៅក្នុង កិច្ចប្រជុំ ផ្សព្វផ្សាយ សភាព សភាពការណ៍ ថ្មី ៗ នៅ កម្ពុជា ជូន ដល់ មន្ត្រីរាជការ អជ្ញាធរ មូលដ្ឋាន និង កងកម្លាំង មាន សមត្ថកិច្ច ជាង ៥០០ នាក់ នៅ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ នេះ ។
លោក ម៉ៅ ភិរុណ បាន បញ្ជាក់ ថា ការចូលរួម របស់ ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ក្នុង ការថែរក្សា ការពារ សុខ សន្តិភាព ស្ថិរភាព សណ្តាប់ធ្នាប់ និង ការអភិវឌ្ឍ សង្គម គឺ បាន បង្ហាញ អំពី ស្មារតី ស្នេហាជាតិ យ៉ាង ពិតប្រាកដ ដែល ជា មូលដ្ឋានគ្រឹះ យ៉ាង សំខាន់ សម្រាប់ កសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ឲ្យ កាន់តែ សម្បូរសប្បាយ ជា បន្ត ទៀត ។
ក្នុង ជំនួប នេះ ដែរ លោក នួន ផា ប្រធាន ក្រុមប្រឹក្សា ខេត្ត កណ្តាល បាន ជំរុញ ឲ្យ អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ បន្ត ចូលរួម ទប់ស្កាត់ បដិវត្ត ពណ៌ ដែល កើត ចេញ ពី ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល មាន បំណង ប៉ុនប៉ង ចង់ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ។
ពិសេស កងកម្លាំង មាន សមត្ថកិច្ច គ្រប់ លំដាប់ថ្នាក់ ត្រូវ ខិតខំ អនុវត្ត តួនាទី ភារកិច្ច ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ ដើម្បី ចូលរួម អនុវត្ត នូវ កម្មវិធី នយោបាយ យុទ្ធសាស្ត្រ ចតុកោណសំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ឲ្យ កាន់តែ មាន ប្រសិទ្ធភាព និង ទទួលបាន លទ្ធផល ជោគជ័យ ថែម ទៀត ៕ ADB ចុះ កិច្ចព្រមព្រៀង ផ្តល់ ហិរញ្ញប្បទាន ៨៩ លាន ដុល្លារ ដល់ កម្ពុជា ដើម្បី ជួយ លើ ការផ្គត់ផ្គង់ ទឹក - អនាម័យ ជនបទ និង អភិវឌ្ឍ វិស័យ ហិរញ្ញវត្ថុ
ប្រជាពលរដ្ឋ ប្រមាណ ៤០០.០០០ នាក់ នឹង ទទួលបាន ប្រយោជន៍ ពី កម្មវិធី អភិវឌ្ឍ វិស័យ សេវា ផ្គត់ផ្គត់ ទឹក និង អនាម័យ ជន បទ ដំណាក់កាល ទី៣ ដែល ធនាគារ អភិវឌ្ឍន៍ អាស៊ី បាន អនុម័ត កាលពី ខែកញ្ញា ឆ្នាំ ២០១៩ តាមរយៈ ការសាងសង់ និង ការស្តារ ហេដ្ឋារចនាសម្ព័ន្ធ ផ្គត់ផ្គង់ ទឹក និង អនាម័យ ចំនួន ២.៥០០ កន្លែង ព្រមទាំង ការអនុវត្ត យុទ្ធនាការ លើកកម្ពស់ ការយល់ដឹង យ៉ាងហោចណាស់ ក្នុង ភូមិ ចំនួន ៤០០ នៃ ខេត្ត ចំនួន ១០ ក្នុង ប្រទេស កម្ពុជា ។
ដំណើរទស្សនកិច្ច នេះ ដើម្បី ស្វែងយល់ អំពី បច្ចេក វេជ្ជសាស្ត្រ នៃ វិស័យ សុខាភិបាល និង តំបន់ ទេសចរណ៍ មួយចំនួន ក្នុង ប្រទេស ម៉ាឡេស៊ី ៕
គ្រឿងញៀន បង្កឲ្យ មាន អំពើហិង្សា និង ឧក្រឹដ្ឋកម្ម ! យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស ថ្ងៃទី ៣០ ខែតុលា៖ បង្ក្រាប បាន ៣៩ ករណី ឃាត់ខ្លួន៦០ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ៣០ ខែតុលា ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប គ្រឿងញៀន ខុស ច្បាប់ ចំនួន ៣៩ ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៦០ នាក់ ។
