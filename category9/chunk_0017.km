( ភ្នំពេញ ) ៖ អគ្គ មេបញ្ជាការ នៃ កងយោធ ខេមរភូមិន្ទ ស្វាគមន៍ យ៉ាង កក់ក្ដៅ បំផុត ចំពោះ ដំណើរទស្សនកិច្ច របស់ ឧត្ដមសេនីយ៍ ឯក បម្រុង ហ្វាន វ៉ាន់ យ៉ាង ប្រធាន អគ្គ សេនាធិការ កងទ័ព ប្រជាជន វៀតណាម និង ជា អនុ រដ្ឋមន្ត្រី ក្រសួង ការពារ ប្រទេស នា ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ ។
ក្នុង ដំណើរទស្សនកិច្ច គណៈប្រតិភូ របស់ លោក មក លើ ទឹកដី នៃ ព្រះរាជាណាចក្រ កម្ពុជា នា ពេលនេះ ពិតជា បាន នាំមក នូវ ការពង្រឹង ពង្រីក ទំនាក់ទំនង ជា ប្រពៃណី ប្រវត្តិសាស្ត្រ រវាង កងទ័ព យើង ទាំង ពីរ ក៏ ដូចជា ការបង្កើន នូវ ការរិត ចំណង សាមគ្គីភាព នៃ ប្រទេស ទាំង ពីរ ។
ជា កិច្ច បន្ត នាយ ឧត្តមសេនីយ៍ បាន កោតស សរសើរ នូវ រាល់ កិច្ចការងារ ដែល បាន ធ្វើ ល្អ កន្លងមក ដែល កងទ័ព ទាំង ពីរ ធ្វើ បាន ហើយ បាន អនុវត្ត ទៅ តាម ការចុះហត្ថលេខា ជា ប្រចាំ ឆ្នាំ របស់ រដ្ឋមន្ត្រី ការពារ ប្រទេស ទាំង ពីរ ។ ក្នុង នោះ ដែរ នាយ ឧត្តមសេនីយ៍ បាន បន្ថែម ថា យើង ត្រូវ បន្ត នូវ ការយកចិត្តទុកដាក់ ដូច ជា៖
អគ្គ មេបញ្ជាការ គាំទ្រ និង ចូលរួម សហការ ក្នុង ការអញ្ជើញ ទៅ ចូលរួម ទស្សនា ការ តាំងពី ពណ៌ កងទ័ព លើ វិស័យ ការពារ ជាតិ ក៏ ដូចជា ខួប លើក ទី ៧៥ នៃ ការបង្កើត កងទ័ព ប្រជាជន វៀតណាម ៕ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស បំពាក់ ប្រព័ន្ធ ទាញយក ថាមពល មក ប្រើប្រាស់ ឡើងវិញ ក្នុង សង្វាក់ ផលិតកម្ម ស្រាបៀរ កម្ពុជា ដើម្បី ជួយ បរិស្ថាន
ប្រព័ន្ធ នេះ ដំណើរការ ដោយ ស្វ័យប្រវត្តិ ត្រូវបាន ផ្គត់ផ្គង់ ដោយ ក្រុមហ៊ុន Krones របស់ ប្រទេស អាល្លឺម៉ង់ ដែល ជា ក្រុមហ៊ុន ផលិត ម៉ាស៊ីន ផលិត ស្រាបៀរ ឈាន មុខ គេ នៅក្នុង ពិភពលោក ។ លើស ពី នេះ ប្រព័ន្ធ ទាញយក ថាមពល មក ប្រើប្រាស់ ឡើងវិញ បាន ជួយ កាត់បន្ថយ ចំហាយ ចេញ ពី ឡ កម្ដៅ ដែល បាន ប្រើ សម្រាប់ ផលិត ស្រាបៀរ និង បាន ចូលរួម កាត់បន្ថយ ផល ប៉ះពាល់ នៃ ការប្រែប្រួល អាកាសធាតុ ដោយ ការទប់ ថាមពល កម្តៅ មិន ឲ្យ ភាយ ទៅក្នុង បរិយាកាស ។
គួរ បញ្ជាក់ ថា សីតុណ្ហភាព កម្ដៅ ដែល បាន មកពី ប្រព័ន្ធ ទាញយក ថាមពល មក ប្រើប្រាស់ ឡើងវិញ អាច យកមក កម្ដៅ ទឹក រងូរ បាន យ៉ាង ល្អ ដែល ផ្ដល់ ភាពងាយស្រួល ទ្វេរ ដង ក្នុង ការស្ងោរ ស្រាបៀរ និង ចំនេញ ពេល វេលា សម្រាប់ ការផលិត ស្រាបៀរ ផងដែរ ។
ឆេះ រថភ្លើង ដឹក អ្នកដំណើរ នៅ ប៉ាគីស្ថាន ផ្តាច់ ជីវិត មនុស្ស យ៉ាងតិច ៦៥ នាក់ និង ជាច្រើន នាក់ ទៀត រងរបួស
( អ៊ីស្លា ម៉ា បាដ) ៖ មនុស្ស យ៉ាងតិច ៦៥ នាក់ បាន បាត់បង់ជីវិត និង ជាច្រើន នាក់ ទៀត បាន រងរបួស បន្ទាប់ពី រថភ្លើង មួយ ខ្សែ ត្រូវបាន ភ្លើង ឆាប ឆេះ នៅ ភាគ ខាងកើត ប្រទេស ប៉ាគីស្ថាន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃ ព្រហស្បតិ៍ ទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា នៅពេល កើត ហេតុ ដោយសារតែ ភាពភ័យខ្លាច អ្នកដំណើរ មួយចំនួន បាន សម្រេចចិត្ត លោត ចេញ ពី រថភ្លើង តែម្តង ថែម ទៀតផង ។ អាជ្ញាធរ ឥណ្ឌា បាន បញ្ជាក់ ថា តួលេខ ជាក់លាក់ ចុងក្រោយ នៃ ចំនួន អ្នកស្លាប់ អាច ច្រើន ជាង ខាងលើ នៅពេល ប្រតិបត្តិការ ជួយ សង្រ្គោះ ចប់ រួចរាល់ ។ ជាមួយគ្នា នេះ ការស៊ើបអង្កេត ក៏ នឹង ត្រូវ ធ្វើឡើង ផងដែរ ថា ហេតុ អ្វី បានជា មាន ការអនុញ្ញាតឲ្យ អ្នកដំណើរ យក ធុង ហ្គាស ឡើង លើ រថភ្លើង បែប នេះ ព្រោះ វា ជា របស់ ហាមឃាត់ ៕
បុណ្យ ក ឋិន ទាន សាមគ្គី របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ទទួលបាន បច្ច័យ ១០ម៉ឺន ដុល្លារ ដើម្បី កសាង ទី អារាម វត្ត២ ក្នុង រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ បុណ្យ ក ឋិន ទាន សាមគ្គី ដែល ផ្តួចផ្តើម ឡើង ដោយ គណៈ អភិបាល រាជធានី ភ្នំពេញ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ មន្ត្រីរាជការ អាជ្ញាធរដែនដី និង មន្ទីរ អង្គភាព ជុំវិញ រាជធានី ភ្នំពេញ ប្រមូល បាន បច្ច័យ ចំនួន ១០ម៉ឺន ដុល្លារ ដើម្បី វេរ ប្រគេន ព្រះសង្ឃ ដែល គង់ ចាំ ព្រះវស្សា អស់ កាល ត្រីមាស ក្នុង ពុទ្ធ សីមាវត្ត ចំនួន ២ នោះ គឺ វត្ត ព្រះបារមីវង្គត បូរីក បិល ភ័ស្ថ ស្ថិត ក្នុង សង្កាត់ ទឹក ថ្លា ខណ្ឌ សែនសុខ និង វត្ត វិមាន តេជះ ( ហៅ វត្ត ស្រះចក ) ស្ថិត ក្នុង សង្កាត់ ស្រះចក ខណ្ឌ ដូនពេញ ។
គួរ បញ្ជាក់ ថា បច្ច័យ ចំនួន ១០ម៉ឺន ដុល្លារ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ប្រគេន ដល់ ដែល គង់ នៅ វត្ត ព្រះបារមីវង្គត បូរីក បិល ភ័ស្ថ ចំនួន ៥ម៉ឹន ដុល្លារ និង ប្រគេន ដល់ ព្រះសង្ឃ នៅ វត្ត ស្រះចក ចំនួន ៥ ម៉ឺន ដុល្លារ ដូចគ្នា ៕
អាជ្ញាធរ ខណ្ឌ ចំការមន បើក វេទិកា សាធារណៈ និង ផ្សព្វផ្សាយ ឯកសារ ជំនួយ ស្មារតី ជូន ដល់ ប្រជាពលរដ្ឋ ដើម្បីឲ្យ យល់ ពី សភាពការណ៍ កុំ ឲ្យ ចាញ់ ការញុះញង់ របស់ ក្រុម ឧទ្ទាម សម រង្សី
( ភ្នំពេញ ) ៖ អាជ្ញាធរ ខណ្ឌ ចំការមន បាន បើក យុទ្ធនាការ វេទិកា សាធារណៈ និង ផ្សព្វផ្សាយ ឯកសារ ជំនួយ ស្មារតី ជូន ដល់ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ខណ្ឌ ដើម្បីឲ្យ យល់ ពី សភាពការណ៍ កុំ ចាញ់បោក ការញុះញង់ របស់ ទណ្ឌិត សម រង្ស៉ី ដែល កំពុង រត់គេចខ្លួន នៅ ក្រៅ ប្រទេស និង ប្រាប់ ប្រជាពលរដ្ឋ ត្រូវ នាំគ្នា សប្បាយរីករាយ នៅ ថ្ងៃ បុណ្យ ឯករាជ្យ ជាតិ ៩វិច្ឆិកា និង ថ្ងៃ អក អំបុក ខាងមុខ នេះ ។
ក្នុង នោះ ដែរ ប្រជាពលរដ្ឋ ក៏ បាន សំណូមពរ ឲ្យ ក្រុមហ៊ុន កោះ ពេជ្រ ត ប្រព័ន្ធ ទឹក ស្អាត នៅ គម្រោង អេលីហ្សេ. សូម ជួយ ឲ្យ បង្កើន ប្រព័ន្ធ ទូរស័ព្ទ កាន់តែ ខ្លាំង ដើម្បី ទំនាក់ទំនង គ្នា . ស្នើ ដល់ អ្នក ចិញ្ចឹម ឆ្កែ ស្រឡាញ់ ឆ្កែ សូម កុំ ព្រលែង សត្វ ឆ្កែ ពាស វាលពាសកាល ដែល ជា ហេតុ នាំឲ្យ សត្វ ឆ្កែ ជុះ អាចម៍ ដាក់ តាម ផ្លូវ របង ផ្ទះ គេ និង ស្នើសុំ ដល់ ក្រុមហ៊ុន កោះ ពេជ្រ ជួយ បំពាក់ កាមេរ៉ា តាម ដងផ្លូវ ឲ្យបាន ច្រើន ថែម ទៀត ដើម្បី ងាយស្រួល ចាប់ មុខ សញ្ញា ប្រព្រឹត្ត បទល្មើស ក្នុង កោះ ពេជ្រ ផងដែរ ។
ក្នុង ឱកាស នោះ សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ប្រាប់ ដល់ ក្មួយ ៗ ជា សិស្សានុសិស្ស និង យុវជន យុវនារី ទាំងអស់ ត្រូវ ខិតខំ រៀនសូត្រ ឲ្យបាន ខ្ជាប់ ខ្លួន ត្រូវ ចូលរួម ឲ្យបាន គ្រប់ សកម្មភាព ដើម្បី គាំទ្រ ដំណើរការអភិវឌ្ឍ សាលារៀន និង សង្គមជាតិ យើង ។
សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ណែនាំ ដល់ គ្រឹះស្ថាន សិក្សា គ្រប់ កម្រិត រួមទាំង ទី វត្តអារាម ត្រូវ ផ្តល់ លទ្ធភាព ក្នុង ការអប់រំ ពេញលេញ និង មាន គុណភាព តាមរយៈ ការបង្កើន ការផ្សព្វផ្សាយ ការធ្វើ យុទ្ធនាការ ប្រមូល កុមារ ចូលរៀន ។
សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « គ្រឹះស្ថាន សិក្សា គ្រប់ កម្រិត រួមទាំង ទី វត្តអារាម ត្រូវ ផ្តល់ លទ្ធភាព ក្នុង ការអប់រំ ពេញលេញ និង មាន គុណភាព តាមរយៈ ការបង្កើន ការផ្សព្វផ្សាយ ការធ្វើ យុទ្ធនាការ ប្រមូល កុមារ ចូលរៀន និង ត្រៀមលក្ខណៈ តាម គ្រប់ រូបភាព ដូចជា អាកាសធាតុ ក្តៅ ហួត ហែង ទឹក ជំនន់ ខ្យល់ កន្ត្រាក់ - ល-» ។
សម្ដេច តេជោ បន្ដ ទៀត ថា គ្រឹះស្ថាន សិក្សា ត្រូវ ធានា រយៈពេល នៃ ការៀន និង បង្រៀន ឲ្យបាន ពេញលេញ ស្រប តាម កម្មវិធី សិក្សា ដែល បាន កំណត់ ។ គ្រឹះស្ថាន សិក្សា ត្រូវ ខិតខំ ពង្រីក សក្តានុពល របស់ ខ្លួន ដើម្បីឲ្យ ក្លាយទៅជា សាលា កុមារ មេត្រី កម្រិត អភិវឌ្ឍ និង ប្រែក្លាយ ខ្លួន ទៅជា សាលារៀន ជំនាន់ ថ្មី សម្រាប់ បង្កើត ធនធាន មនុស្ស មាន ជំនាញ ខ្ពស់ លើ មុខវិជ្ជាវិទ្យាសាស្រ្ត បច្ចេកវិទ្យា វិស្វកម្ម និង គណិតវិទ្យា ។
ទន្ទឹម គ្នា នោះ នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ក៏ បាន ជំរុញ ឲ្យ ក្រសួង អប់រំ យុវជន និង កីឡា និង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ រួមគ្នា ពិនិត្យ ឡើងវិញ នូវ គោល នយោបាយ ក្របខណ្ឌ បទដ្ឋាន និង យន្ត ការចាំបាច់ ដើម្បី ដឹកនាំ គ្រប់គ្រង និង អនុវត្ត ឲ្យ មាន ប្រសិទ្ធភាព និង ធានា បាន នូវ ការអប់រំ ប្រកបដោយ គុណភាព និង បរិយាប័ន្ន សម្រាប់ សិស្សានុសិស្ស គ្រប់ រូប ស្រប តាម គោលដៅ អភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
សម្ដេច តេជោ ហ៊ុន សែន ក៏ បាន ជំរុញ បង្កើន ប្រសិទ្ធភាព ក្នុង ការប្រើប្រាស់ ហិរញ្ញប្បទាន សម្រាប់ គ្រឹះស្ថាន សិក្សា ការពង្រាយ គ្រូបង្រៀន ឲ្យបាន ដល់ គ្រប់ សាលារៀន និង ការបន្ត អភិវឌ្ឍ សមត្ថភាព នាយក សាលា និង គ្រូបង្រៀន នៅ តាម គ្រឹះស្ថាន បណ្ដុះបណ្ដាល និង គ្រឹះស្ថាន សិក្សា ជាពិសេស ការពង្រឹង ការងារ អធិការកិច្ច និង យន្ត ការពិនិត្យ កែលម្អ ជាប្រចាំ ផងដែរ ៕
ភ្ញៀវ ទេសចរ ខេត្ត ក្រចេះ កើន ជាង ១០០ % ក្នុង ខែតុលា ឆ្នាំ ២០១៩ ក្រោយ រៀបចំ ទិវា សត្វ ផ្សោត ទន្លេ មេគង្គ
លោក បាន បន្ត ជំហរ រៀបចំ ទិវា សត្វ ផ្សោត ទន្លេ មេគង្គ សម្រាប់ ឆ្នាំ ២០២០ ឲ្យ កាន់តែ អធិកអធម បន្ថែម ទៀត និង គ្រោង រៀបចំ កែលម្អ រមណីយដ្ឋាន « អន្លង់ ផ្សោត កាំ ពី » ឲ្យ ក្លាយជា រមណីដ្ឋាន ស្តង់ដា និង ជា មជ្ឈមណ្ឌល អប់រំ ជីវសាស្ត្រ សត្វ ផ្សោត ទន្លេ មេគង្គ លើក ដំបូង នៅ កម្ពុជា ។
កម្មវិធី ទិវា សត្វ ផ្សោត ទន្លេ មេគង្គ ឆ្នាំ ២០១៩ ជា ព្រឹត្តិការណ៍ ទេសចរណ៍ ដែល ទទួលបាន ចំណាប់អារម្មណ៍ ខ្លាំង ពីសំណាក់ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត និង ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ នានា ក្នុង នោះ ក្រៅពី ការកម្សាន្ត សប្បាយ ភ្ញៀវ ទេសចរ បាន យល់ដឹង កាន់តែ ច្បាស់ ពី ជីវសាស្ត្រ របស់ សត្វ ផ្សោត ទន្លេ មេគង្គ ដែល ជា ធនធាន សត្វ កម្រ ដែល កម្ពុជា កំពុង យកចិត្តទុកដាក់ ការពារ និង អភិរក្ស ក៏ ដូចជា រៀបចំ ឲ្យ កា្លយ ជា ផលិតផល ទេសចរណ៍ មិន ចេះ រីងស្ងួត និង ដ៏ ទាក់ទាញ សម្រាប់ ខេត្ត ក្រចេះ ផងដែរ ។
សូម ជម្រាប ថា តាមរយៈ គម្រោង អភិរក្ស សត្វ ផ្សោត របស់ អង្គការ WWF ជល ផល កម្ពុជា និង រដ្ឋបាល ខេត្ត ក្រចេះ និង ស្ទឹងត្រែង រហូតមកដល់ បច្ចុប្បន្ន នេះ ចំនួន សត្វ ផ្សោត ទន្លេ មេគង្គ មាន កំណើន ប្រមាណ ១៥% ដោយ មាន ចំនួន ៨០ ក្បាល នៅ ឆ្នាំ ២០១៥ និង កើនឡើង ដល់ ៩២ ក្បាល នៅ ឆ្នាំ ២០១៧ ៕ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ៖ កម្ពុជា ប្ដេជ្ញា ទប់ស្កាត់ ការនាំ សារធាតុ គីមី ផ្សំ និង គ្រឿងញៀន ចេញ - ចូល តំបន់ ត្រីកោណ មាស
ការបញ្ជាក់ ជំហរ បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស ដែល នាយ ឧត្តមសេនីយ៍ បាន អញ្ជើញ ក្នុង ពិធី សម្ពោធ ដាក់ ឱ្យ ដំណើរការ មជ្ឈមណ្ឌល សម្របសម្រួល សុវត្ថិភាព ទន្លេ មេគង្គ (SMCC) នៅ កម្ពុជា ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ប្រធាន ប្រតិភូ នៃ ប្រទេស សមាជិក SMCC ដែល មកពី ប្រទេស ទាំង៥ ក្នុង មហា អនុ តំបន់ ទន្លេ មេគង្គ ( ចិន ឡាវ សហភាព មីយ៉ាន់ម៉ា ថៃ និង វៀតណាម ) ។
នាយ ឧត្តមសេនីយ៍ បាន ថ្លែង ថា ក្នុង នាម ជា ប្រទេស ដែល មាន ចំណែក ទទួលខុសត្រូវ តំបន់ គោលដៅ ទី ០៨ ( ទន្លេ មេគង្គ ក្រោម ) កម្ពុជា បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ក្នុង ការត្រួតពិនិត្យ បង្ការ ទប់ស្កាត់ និង បង្ក្រាប នូវ រាល់ បទល្មើស គ្រឿងញៀន គ្រប់ ប្រភេទ តាមរយៈ ការរៀបចំ នូវ យន្តការវិធានការ មួយចំនួន ដូច ជា៖
* ការបង្កើត គណៈកម្មការត្រួតពិនិត្យ គ្រឿងញៀន ភាគ ឦសាន * ការរៀបចំ បង្កើត ភូមិ ឃុំ / សង្កាត់ គ្មាន គ្រឿងញៀន នៅក្នុង ខេត្ត ព្រះវិហារ និង ខេត្ត ស្ទឹងត្រែង * ការបើក យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ លើក ទី១ ទី២ ទី៣ និង ទី៤ ដែល បាន និង កំពុង បន្ត យកចិត្ត ខ្ពក់ ដាក់ ជាប់ ជាប្រចាំ ដូច ភ្លៀង រលឹម ដោយ ផ្តោត សំខាន់ ក្នុង ការទប់ស្កាត់ និង បង្ក្រាប បទល្មើស គ្រឿងញៀន ( ក្នុង ខេត្ត ភាគ ឦសាន ) ពី តំបន់ តំបន់ ត្រីកោណ មាស ដែល កម្ពុជា រឹបអូស គ្រឿងញៀន បាន ជាច្រើន រយ គីឡូក្រាម រួច មកហើយ ។
ជាក់ស្ដែង ថ្មី ៗ នេះ កម្ពុជា បង្ក្រាប បាន ០១ ករណី ចាប់ យក គ្រឿងញៀន បាន ប្រមាណ ១០០ គីឡូក្រាម នៅ ខេត្ត កំពង់ធំ ដែល នាំមកពី តំបន់ ត្រីកោណ មាស ចូលមក ប្រទេស កម្ពុជា តាម ប្រទេស ថៃ ។
លោក ថា « យើង បាន ធ្វើ ការពង្រឹង សមត្ថភាព ដល់ សមត្ថកិច្ច តាម ច្រក ឱ្យ ពង្រឹង ការត្រួតពិនិត្យ សារធាតុ គីមី ផ្សំ ដែល មាន ចែង ក្នុង តារាង ឧបសម្ព័ន្ធ នៃ ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន ឱ្យ មាន ការត្រួតពិនិត្យ កាន់ តឹងរឹង យកចិត្តទុកដាក់ ធ្វើ ការឃ្លាំមើល និង រាយការណ៍ ពី វត្តមាន នៃ ការចរាចរ សារធាតុ គីមី ផ្សំ ទាំងឡាយ ណា ដែល អាច ផលិត គ្រឿងញៀន បាន និង មិន មាន ចែង ក្នុង តារាង ឧបសម្ព័ន្ធ នៃ ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ គ្រឿងញៀន កម្ពុជា » ។
ក្នុង បទសម្ភាស ជាមួយ ក្រុម អ្នកយកព័ត៌មាន Fresh News . អ្នកស្រី សួស សោភ័ណ្ឌ បាន ប្រាប់ ថា ការរៀបចំ សិក្ខាសាលា នេះ ឡើង គឺ ដើម្បី បង្ហាញ គន្លឹះ រកស៊ី ដល់ នារី ទាំងអស់ ឈាន ឆ្ពោះ ទៅរក ភាពជោគជ័យ និង លុបបំបាត់ ភាពភ័យខ្លាច ក្នុង ការចេញមុខ ធ្វើ ជំនួញ ម្យ៉ាងទៀត វា ក៏ ជា ឱកាស ជួបជុំ ចែករំលែក បទពិសោធន៍ ដល់ គ្នា ទៅ វិញ ទៅ មក ផងដែរ ។ អ្នកស្រី បាន បន្ថែម ថា ភាពជោគជ័យ ត្រូវ តែ មាន ការកំណត់ គោលដៅ ភាព ជឿជាក់ និង ទំនុកចិត្ត និង ចេះ បង្កើន គំនិត ថ្មី ៗ ។
ចំពោះ អ្នកស្រី ទ្រី ដាណា ដែល ជា អគ្គ នាយិកា ក្រុមហ៊ុន ដាណា ទ្រី ខេមបូឌា ត្រេនឌីង ខូអិលធីឌី បាន បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ មាន នារី ប្រមាណ ៥ម៉ឺន នាក់ ហើយ ដែល បាន រកស៊ី ជាមួយ NNP នៅ គ្រប់ ២៥ រាជធានី ខេត្ត ។ អ្នកស្រី បាន លើកឡើង ថា ស្រ្តី ភាគ ច្រើន ដែល ជោគជ័យ ក្នុង ការចាប់ អាជីវកម្ម ជាមួយ NNP គឺជា ស្រ្តី មេ ផ្ទះ ហើយ មិន មាន មុខរបរ ច្បាស់លាស់ ។
លោកស្រី បញ្ជាក់ ថា ទាំងអស់ នេះ មិន មែន ជា ឧបសគ្គ និង បញ្ហា ប្រឈម របស់ ស្រ្តី ឡើយ អ្វី ដែល សំខាន់ គឺ ពួកគាត់ ត្រូវ មាន គោលដៅ ខ្លួន ឯង ឲ្យ ច្បាស់ ហើយ ជំនះ ការលំបាក ឲ្យបាន នោះ ភាពជោគជ័យ នឹង រត់ មក រក ឲ្យ ទាំងអស់ គ្នា ដោយ ឯង ៗ ។
ក្រុមហ៊ុន ដាណា ទ្រី ខេមបូឌា ត្រេនឌីង ខូអិលធីឌី បាន ផ្តល់ ឱកាស ការងារ និង មុខរបរ ថែមទាំង ប្រាក់ ចំណូល ដល់ នារី ៗ ជាច្រើន ជាពិសេស គឺ បាន ផ្លាស់ប្តូរ ជីវិត របស់ នារី ៗ រាប់ ម៉ឺន នាក់ ផ្តើម ចេញ ពី ស្រ្តី មេ ផ្ទះ គ្មាន ចំណូល មក ជា ស្រ្តី ដែល មាន មុខរបរ ច្បាស់លាស់ និង មាន ប្រាប់ ចំណូល រាប់ ពាន់ ដុលារ ក្នុង មួយ ខែ ៗ ៕
នៅក្រោយ គណបក្ស សង្រ្គោះ ជាតិ CNRP ត្រូវបាន រំលាយ នៅ ឆ្នាំ ២០១៧ ហើយ លោក កឹម សុខា អតីត ប្រធាន គណបក្ស ប្រឆាំង នេះ ត្រូវបាន ចាប់ខ្លួន ពី បទ ក្បត់ ជាតិ និង កំពុង ស្ថិត ក្រោម ការត្រួតពិនិត្យ របស់ តុលាការ ហើយ អ្នកវិភាគ បាន លើកឡើង ថា សហរដ្ឋ អាមេរិក នឹង ដាក់ទណ្ឌកម្ម សេដ្ឋកិច្ច យ៉ាង ធ្ងន់ធ្ងរ ប្រឆាំង រដ្ឋាភិបាល ស្រប ច្បាប់ នៅ កម្ពុជា ។ ប៉ុន្តែ ផ្ទុយទៅវិញ រដ្ឋបាល ប្រធានាធិបតី អាមេរិក មិន បាន ដាក់ទណ្ឌកម្ម ឬ ចាត់ វិធានការជា ដំកុំ ភួន ណាមួយ នោះ ទេ ។
ជាក់ស្ដែង នៅ ពេល ដែល ទីក្រុង វ៉ាស៊ីនតោន បាន ព្យួរ ការផ្ដល់ ជំនួយ និង ដាក់ទណ្ឌកម្ម មន្ត្រី កម្ពុជា យ៉ាងហោចណាស់ ម្នាក់ វា បង្ហាញ យ៉ាង ច្បាស់ ទៅ ហើយ ថា អាមេរិក ចង់ ទុក ផ្លូវ ចរចា ជាមួយ កម្ពុជា ដោយ ប្រើប្រាស់ វិធីសាស្ត្រ ពីរ នោះ គឺ ទី មួយ បង្ហាញ ឱ្យ គេ ឯង គ្រប់ គ្នា ដឹង ថា អាមេរិក មាន គោលជំហរ ម៉ឺងម៉ាត់ ចំពោះ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ហើយ ទី ពីរ គឺ រក្សា ភាព ទន់ភ្លន់ ចំពោះ យោធា សង្គម ស៊ីវិល និង ប្រជាជន កម្ពុជា ទាំងមូល ។
ពោល និយាយ ឱ្យ ចំ ទៅ គឺ សហរដ្ឋ អាមេរិក មាន ការរារែកចិត្ត ក្នុង ការដាក់ទណ្ឌកម្ម ឬ ចាត់ វិធានការ ម៉ឺងម៉ាត់ ចំពោះ រដ្ឋាភិបាល កម្ពុជា គឺ ដោយសារតែ ចិន ជាពិសេស ក្រោយ សារព័ត៌មាន អាមេរិក ចុះផ្សាយ ថា រដ្ឋាភិបាល កម្ពុជា បាន ចុះ កិច្ចព្រមព្រៀង ជា សំងាត់ ដោយ អនុញ្ញាតឱ្យ កងទ័ព ចិន ប្រើប្រាស់ មូលដ្ឋាន ជើង ទឹក កម្ពុជា នៅ ឆ្នេរសមុទ្រ រាម (Ream) ដែល បើក ផ្លូវ ទៅកាន់ ការពង្រីក ឥទ្ធិពល ចិន ក្នុង ឈូង សមុទ្រ ថៃ ស្រាប់ ។
លោក Murphy បាន គូសបញ្ជាក់ នៅក្នុង ពិធី ស្បថ ចូលកាន់ តំណែង ជា ផ្លូវការ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ នឹង ពង្រីក កម្មវិធី ដែល នឹង ផ្ដល់ អំណាច ដល់ យុវជន កម្ពុជា ដែល តំណាង ៧០ ភាគ នៃ ប្រជាជន កម្ពុជា សរុប និង តំណាង ឱ្យ អនាគត នៃ ប្រទេស ដើម្បី ចូលរួម ក្នុង កិច្ចការ នយោបាយ ។ មិន តែ ប៉ុណ្ណោះ ខ្ញុំ នឹង បន្ត អភិវិឌ្ឍន៍ កម្មវិធី នានា ដែល នឹង ផ្ដល់ អំណាច និង ឯករាជ្យភាព សម្រាប់ ប្រព័ន្ធ ផ្សព្វផ្សាយ នៅ កម្ពុជា ផងដែរ » ។
គួរ បញ្ជាក់ ថា ការលើកឡើង ខាងលើ របស់ លោក Murphy ត្រូវបាន អ្នកជំនាញ ខ្លះ យល់ ថា សហរដ្ឋ អាមេរិក នឹង បន្ត នយោបាយ អត់ធ្មត់ ចំពោះ កម្ពុជា ដោយ សុខចិត្ត រង់ចាំ ឱ្យ ទំនាក់ទំនង ជាមួយ កម្ពុជា ល្អ ប្រសើរឡើង ក្រោយ នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន បង្ហាញ ទំនោរ ផ្ទេរ អំណាច ឱ្យ កូនប្រុស ច្បង គឺ លោក ហ៊ុន ម៉ាណែត ដែល ទទួលបាន ការអប់រំ ពី សហរដ្ឋ អាមេរិក ។
លើស ពី នេះ ទៅ ទៀត បើ ទោះជា សមយុទ្ធ យោធា រួមគ្នា អាមេរិក - កម្ពុជា ឈ្មោះ Angkor Sentinel ត្រូវបាន ផ្អាក តាំងតែពី ឆ្នាំ ២០១៧ ក៏ដោយ ក៏ សហរដ្ឋ អាមេរិក នៅតែ បន្ត ធ្វើ កិច្ចសហប្រតិបត្តិការ ជាមួយ កម្ពុជា ដដែល ក្នុង បេសកកម្ម រក្សា សន្តិភាព ការស្រាវជ្រាវ វេជ្ជសាស្ត្រ ការស្វែងរក អដ្ឋិធាតុ ទាហាន អាមេរិក ដែល បាន ស្លាប់ ក្នុង សម័យ សង្រ្គាម និង បញ្ហា គ្រាប់ មីន ជាដើម ៕
( វៀតណាម ) ៖ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងគោក បាន ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ កងទ័ព ជើងគោក កម្ពុជា ចូល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ ឧត្តមសេនីយ៍ ឯក បម្រុង ឡេ ជៀម អនុ រដ្ឋមន្ត្រី ក្រសួង ការពារ ប្រទេស វៀតណាម ដើម្បី ពង្រឹង ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ក្នុង វិស័យ ការពារ ជាតិ រវាង ប្រទេស ទាំង ពីរ ។
ការដឹកនាំ នាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ កងទ័ព ជើងគោក កម្ពុជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត បាន ធ្វើឡើង នា ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០១៩ នៅក្នុង ឱកាស នៃ ដំណើរទស្សនកិច្ចការងារ នៅ រដ្ឋធានី ហាណូយ សាធារណរដ្ឋ សង្គម និយម វៀតណាម និង បន្ទាប់ពី កិច្ចប្រជុំ ប្តូរ វេន ប្រចាំ ឆ្នាំ ស្តីពី កិច្ចសហប្រតិបត្តិការ លើ ការងារ គ្រប់គ្រង និង ការការពារ ព្រំដែន ឆ្នាំ ២០១៩ - ២០២០ ។
ក្នុង ជំនួប នេះ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត បាន ជម្រាប ជូន អនុ រដ្ឋមន្ត្រី ក្រសួង ការពារ ប្រទេស វៀតណាម អំពី លទ្ធផល ប្រកបដោយ ផ្លែផ្កា នៃ កិច្ចប្រជុំ សហប្រតិបត្តិការ ប្រចាំ ឆ្នាំ លើ ការងារ គ្រប់គ្រង និង ការការពារ ព្រំដែន រវាង កងទ័ព នៃ ប្រទេស ទាំង ពីរ និង បាន ថ្លែងអំណរគុណ ចំពោះ រដ្ឋាភិបាល និង ក្រសួង ការពារ ប្រទេស វៀតណាម ចំពោះ ការជំរុញ គាំទ្រ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិការ ដ៏ ល្អ នេះ និង បាន ស្នើ ឱ្យ មាន គាំទ្រ បន្ថែម ទៀត លើ វិស័យ ហ្វឹកហ្វឺន បណ្តុះបណ្តាល ធនធាន មនុស្ស ។
ជា ការឆ្លើយតប ឧត្តមសេនីយ៍ ឯក បម្រុង ឡេ ជៀម បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ជោគជ័យ នៃ ទំនាក់ទំនង កិច្ចសហប្រតិបត្តិ ល្អ រវាង កងទ័ព នៃ ប្រទេស ទាំង ពីរ ជាពិសេស រវាង បញ្ជាការ ដ្ឋាន កងទ័ព ជើងគោក នៃ កងយោធពល ខេមរភូមិន្ទ និង បញ្ជាការដ្ឋាន កងទ័ព ការពារ ព្រំដែន ក្រសួង ការពារ ប្រទេស វៀតណាម និង បាន បញ្ជាក់ អំពី ការបន្ត ជួយ លើ ការហ្វឹកហ្វឺន បណ្តុះបណ្តាល ធនធាន មនុស្ស ព្រមទាំង បន្ត ជំរុញ ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិ ក្នុង វិស័យ ការពារ ជាតិ រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ប្រសើរឡើង ថែម ទៀត ៕
រដ្ឋមន្ដ្រី កសិកម្ម៖ រាជ រដ្ឋាភិបាល នៅតែ ចាត់ទុក វិស័យ កសិកម្ម ជា វិស័យ សំខាន់ ក្នុង ការទ្រទ្រង់ កំណើន សេដ្ឋកិច្ច និង ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ជនបទ
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្រ្តី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នា ព្រឹក ថ្ងៃទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង សិក្ខាសាលា ស្តីពី « ការលើកស្ទួយ ការចិញ្ចឹម សត្វ ជា លក្ខណៈ គ្រួសារ ដើម្បី ចូលរួម កាត់បន្ថយ ភាពក្រីក្រ និង កង្វះ អាហារូបត្ថម្ភ នៅ កម្ពុជា » ។ សិក្ខាសាលា នេះ ធ្វើឡើង នៅ សណ្ឋាគារ កាំបូឌីយ៉ាណា រាជធានី ភ្នំពេញ ។
លោក ខៃ រ៉ូល ហាហ្វីស មាន មតិ ស្វាគមន៍ និង រាយការណ៍ ជូន អង្គ ពិធី ជ្រាប ថា អង្គការ នេះ បាន មក ចូលរួម អភិវឌ្ឍ វិស័យ ផលិតកម្ម គោ ជា លក្ខណ គ្រួសារ នៅ កម្ពុជា តាំងពី ឆ្នាំ ២០០៧ គោលបំណង សំខាន់ របស់ អង្គការ គឺ ផ្តល់ ជំនួយ មនុស្សធម៌ ដើម្បី ជួយ ដល់ ជន ក្រីក្រ និង ជន ងាយ រងគ្រោះ តាមរយៈ លើកកម្ពស់ ផលិតភាព ផលិតកម្ម សត្វ គោ ជា លក្ខណ គ្រួសារ ។ គោល នយោបាយ របស់ អង្គការ ក្នុង ការចែក គោ ជូន ប្រជាពលរដ្ឋ ការបណ្តុះបណ្តាល បច្ចេកទេស ការជ្រើសរើស និង បង្កាត់ ពូជ ចិញ្ចឹម ផលិត ចំណី ការការពារ ព្យាបាល ជំងឺ និង ទីផ្សារ ផងដែរ ។
លោក ខៃ រ៉ូល ហាហ្វីស បន្ដ ទៀត ថា ផលប្រយោជន៍ នៃ ការចិញ្ចឹម គោ ប្រៀប បាន ធនាគារ សន្សំ ប្រាក់ គឺ វា អាច ផ្តល់ ជា សាច់ ទឹកដោះ ស្បែក ឆ្អឹង និង លា មក ផលិត ជី ធម្មជាតិ ផលិត ជាហ្គាស សម្រាប់ ប្រើ ចំអិន អាហារ កាត់បន្ថយ ការប្រើ ឈើ ធ្វើ ពី អុស និង ធ្យូង ជា ពិសេស កាត់បន្ថយ ផល ប៉ះពាល់ បរិស្ថាន ទៀតផង ។ ទាំងអស់ នេះ គឺជា ប្រាក់ ចំណូល និរន្តភាព សម្រាប់ គ្រួសារ កសិករ នៅ ជនបទ ។
ដើម្បី ទទួលបាន ជោគជ័យ ក្នុង ការអនុវត្ត គម្រោង នេះ បន្ថែម ទៀត លោក រដ្ឋមន្រ្តី វេង សា ខុន បាន ផ្តល់ ចក្ខុវិស័យ និង អនុសាសន៍ មួយចំនួន ជូន អង្គ ពិធី ទាំងមូល ដើម្បី ជា ធាតុ ចូល សម្រាប់ យក ទៅ ពិចារណា និង អនុវត្ត បន្ត ដូចត ទៅ៖
( សាន់ហ្វ្រាន់ស៊ីស្កូ ) ៖ ក្រុមហ៊ុន បច្ចេកវិទ្យា ដ៏ ធំ របស់ អាមេរិក Apple បាន ប្រកាស ពី ការកើនឡើង នៃ ប្រាក់ ចំណូល សម្រាប់ ត្រីមាស កន្លងទៅ ខណៈ ការលក់ សេវាកម្ម របស់ ខ្លួន កំពុងតែ ប្រសើរឡើង ខ្លាំង ជាង ការរំពឹងទុក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ស៊ីន ហួរ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី ៣១ ខែតុលា ឆ្នាំ ២០១៩ ។
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ បាន អំពាវនាវ ដល់ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ចូលរួម ទស្សនា កម្សាន្ត ក្នុង ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល នឹង ប្រព្រឹត្តទៅ ចាប់ពី ថ្ងៃទី១០ - ១២ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
តាម សេចក្ដីជូនដំណឹង របស់ ក្រសួង ទេសចរណ៍ បាន ឱ្យដឹង ថា ព្រឹត្តិការណ៍ បុណ្យ ប្រពៃណី នេះ ជា ឱកាស ដ៏ ល្អ ដើម្បីឲ្យ ទេសចរ ជាតិ - អន្តរជាតិ បាន ស្វែងយល់ កាន់តែ ច្បាស់ អំពី វប្បធម៌ ប្រពៃណី ទំនៀមទម្លាប់ របស់ ខ្មែរ ដែល មាន តាំងពី បុរាណកាល មក ពិសេស ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប និង សំពះ ព្រះខែ អក អំបុក ដែល ជា ពិធី ដ៏ មាន ប្រជាប្រិយ បំផុត សម្រាប់ ប្រជាពលរដ្ឋ កម្ពុជា ។
ជាមួយគ្នា នេះ ក្រសួង ទេសចរណ៍ នឹង រៀបចំ វេទិកា ដោយឡែក ស្ថិត នៅ ខាងជើង វេទិកា កិត្តិយស មុខ ព្រះបរម រាជ វាំង សម្រាប់ ជូន ទេសចរ បរទេស បាន ចូលរួម ទស្សនា ការប្រណាំង ទូក ក្នុង គោលបំណង បង្កើន សកម្មភាព ផ្សព្វផ្សាយ ទេសចរណ៍ « កម្ពុជា៖ រាជាណាចក្រ អច្ឆរិយៈ ផ្តល់ ភាពកក់ក្តៅ » និង ចលនា ប្រលង ប្រណាំង « ទីក្រុង ស្អាត រមណីយដ្ឋាន ស្អាត សេវា ល្អ បដិសណ្ឋារកិច្ច ល្អ » ឲ្យ កាន់តែ ទូលំទូលាយ ថែម ទៀត ។
សូម បញ្ជាក់ ថា ការរៀបចំ ធម្មយាត្រា ក្នុង ដែនដី ទាំង៥ នៃ តំបន់ ទន្លេ មេគង្គ កើតឡើង ដោយ ចេតនា និង បំណង ដ៏ បរិសុទ្ធ ដើម្បី សហការ រួម សាមគ្គី ផ្លាស់ប្ដូរ បទពិសោធន៍ រវាង គ្នា និង គ្នា ស្វែងយល់ ពី ពុទ្ធ វប្បធម៌ ប្រពៃណីយ៍ នៃ ព្រះពុទ្ធ សាសនិក តាម តំបន់ ទន្លេ មេគង្គ ក្នុង គោលបំណង ឱ្យ ពុទ្ធ សាសនិក នាំយក ពុទ្ធ ឱវាទ មេរៀន របស់ ព្រះសម្មាសម្ពុទ្ធ ជា អង្គម្ចាស់ មក ប្រតិបត្តិ គ្រប់ ពេលវេលា ។
