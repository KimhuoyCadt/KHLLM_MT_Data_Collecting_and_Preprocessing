( ភ្នំពេញ ) ៖ ដោយសារ នា ពេល ដ៏ ខ្លី ខាងមុខ នេះ រាជធានី ភ្នំពេញ ត្រៀមខ្លួន ធ្វើ ពិធី បុណ្យ ធំ ៗ ដូចជា បុណ្យ ឯករាជ្យ ជាតិ ៩ វិច្ឆិកា . ព្រះរាជ ពិធី បុណ្យ អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក ក្នុង ខែវិច្ឆិកា ខាងមុខ នេះ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ស្នើ ដល់ មន្ត្រី ក្រោម ឱវាទ រដ្ឋបាល រាជធានី ភ្នំពេញ ត្រូវ កាត់បន្ថយ ការធ្វើដំណើរ ទៅ ក្រៅ ប្រទេស ។
ការស្នើ ដល់ មន្ត្រី ក្រោម ឱវាទ បែប នេះ របស់ លោក អភិបាល រាជធានី ភ្នំពេញ បាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ វឌ្ឍនៈ ភាព របស់ គណៈកម្មការ និង អនុគណៈកម្មការរៀបចំ មហាសន្និបាត នា រសៀល ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៩ នៅ សាលា រាជធានី ភ្នំពេញ ។
លោក ឃួង ស្រេង បាន ថ្លែង ថា មហាសន្និបាត របស់ AIMF ប្រព្រឹត្តទៅ ត្រូវ នឹង ខួបកំណើត លើក ទី ៤០ ថ្ងៃ បង្កើត សមាគម AIMF និង ខួប ៤០ ឆ្នាំ របស់ កម្ពុជា ក្រោយ ថ្ងៃ រំដោះ ពី របប ប្រល័យ ពូជសាសន៍ ក្រោម ប្រធានបទ ទីក្រុង ដែល មាន ភាពធន់ ការគិតគូ ពី បញ្ហា ប្រឈម និង ការស្ថាបនាទីក្រុង ឡើងវិញ ។
លោក បាន បន្ត ថា នេះ ជា កិត្តិយស ធំ ធេង ណាស់ សំរាប់ រាជធានី ភ្នំពេញ ក៏ ដូច កិត្តិយស ជាតិ ទាំងមូល ដែល ទទួលបាន ប្រតិភូ ជាង ៣០០ ទីក្រុង ក្នុង ពិភពលោក ដែល ធ្វើឲ្យ កម្ពុជា ពិសេស រាជធានី ភ្នំពេញ ល្បីរន្ទឺ លើ ឆាក អន្តរជាតិ ។
លោក អភិបាល បន្ត ទៀត ថា ការងារ ទាំងអស់ យើង គិតគូ រៀបចំ យ៉ាង ម៉ត់ចត់ ទាំង ការធ្វើ បដិសណ្ឋារកិច្ច ភ្ញៀវ . ការស្នាក់នៅ របស់ ប្រតិភូ . ការរៀបចំ តាំងពិព័ណ៌ បង្ហាញ ពី ដំណើរការអភិវឌ្ឍន៍ រាជធានី ភ្នំពេញ . ការរៀបចំ កែលំអរ សួនច្បារ ការតុបតែង លំអរ តាម ទី សាធារណៈ ជាដើម ។
លោក បាន គូសបញ្ជាក់ ថា ចំណុច សំខាន់ បំផុត នោះ គឺ ការពង្រឹង សន្តិសុខ សណ្តាប់ធ្នាប់ របៀបរៀបរយ សាធារណៈ ត្រូវតែ ឲ្យបាន ល្អ ប្រសើរ ។ ដូច្នេះហើយ ទើប ការធ្វើដំណើរ ទៅ ក្រៅ ប្រទេស របស់ មន្ត្រី ក្រោម ឱវាទ រដ្ឋបាល រាជធានី ភ្នំពេញ ក្នុង ដំណាក់កាល នេះ ត្រូវបាន កំហិត ជា ចាំបាច់ ៕
គួរ ជម្រាប ថា ពិធី ស្បថ ចូលកាន់ តំណែង សម្រាប់ អាណត្តិ ទី ពីរ របស់ លោក Widodo ត្រូវបាន រៀបចំឡើង កាលពី ថ្ងៃអាទិត្យ កន្លងទៅ ក្រោម វត្តមាន ថ្នាក់ដឹកនាំ និង តំណាង មកពី ប្រទេស ជាច្រើន ៕ លោក វេង សាខុន ប្រាប់ ឲ្យ ប្រជាពលរដ្ឋ ស្រុក ជើង ព្រៃ ត្រូវ គោរព ច្បាប់ កុំ ជឿ តាម ការញុះញង់ និង ត្រូវ ដើរ តាម មាគ៌ា ដ៏ ត្រឹមត្រូវ ច្បាស់លាស់ របស់ រាជ រដ្ឋាភិបាល
( កំពង់ចាម ) ៖ លោក វេង សាខុន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ស្រុក តំបែរ ខេត្ត ត្បូងឃ្មុំ . ស្រុក កំពង់សៀម និង ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម នៅ ព្រឹក ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង វេទិកា សាធារណៈ ដែល បាន រៀបចំ ធ្វើ នៅក្នុង បរិវេណ វត្ត ពោធិរតនា រាម ( ស្អាង ) ក្នុង ភូមិ ស្អាង ។ ឃុំត្រពាំង គង នេះ គឺជា ឃុំ ទី៧ ក្នុង ចំណោម ១០ឃុំ ក្នុង ស្រុក ជើង ព្រៃ ដែល បាន រៀបចំ វេទិកា នេះ ។
ពិធី នេះ មាន គោលបំណង ធ្វើ ការតាមដាន ការអនុវត្ត កម្មវិធី គោ នយោបាយ និង យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់ កាល ទី៤ និង គោល នយោបាយ ភូមិ ឃុំ មាន សុវត្ថិភាព របស់ រាជ រដ្ឋាភិបាល និង ជាពិសេស ដើម្បី ផ្សាភ្ជាប់ រវាង ថ្នាក់ដឹកនាំ ជាមួយ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ឲ្យ កាន់តែ ស្អិត រមួត និង ស៊ីជម្រៅ ដែល ជា ឱកាស ល្អ ដើម្បី តាមដាន អំពី សេចក្តីសុខ ទុក្ខ បញ្ហា ប្រចាំ ថ្ងៃ និង ដោះស្រាយ សេចក្តីត្រូវ ការចាំបាច់ ជូន ពលរដ្ឋ ។
វេទិកា នេះ មាន ការចូលរួម ពីសំណាក់ លោក ប្រធាន អនុប្រធាន ក្រុមការងារ អភិបាល ស្រុក សមាជិក ក្រុម ប្រឹក្សា ស្រុក ប្រធាន - អនុប្រធាន ការិយាល័យ ជុំវិញ ស្រុក និង បងប្អូន ប្រជាពលរដ្ឋ ប្រមាណ ៤០០ នាក់ ។
លោក វេង សាខុន ក្នុង នាម ថ្នាក់ដឹកនាំ ក្រុមការងារ ចុះ មូលដ្ឋាន ស្រុក ជើង ព្រៃ លោក បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី សម្តេច កិត្តិព្រឹត្ត បណ្ឌិត សម្តេច ពញា ចក្រី ប្រធាន រដ្ឋសភា និង សម្តេច វិបុល សេនា ភក្តី ប្រធាន ព្រឹទ្ធសភា ដែល សម្តេច តែងតែ គិតគូរ ពី សុខ ទុក្ខ បញ្ហា ជីវភាព របស់ បងប្អូន គ្រប់ ពេលវេលា ។
លោក បន្ត ថា បើ ទោះបី សម្តេច មិន បាន អញ្ជើញ មក ជួប សំណេះសំណាល ជាមួយ បងប្អូន ដោយ ផ្ទាល់ ប៉ុន្តែ ទឹកចិត្ត គោរព ស្រឡាញ់ និង បេះដូង របស់ សម្តេច គឺ ស្ថិត នៅ ជាប់ បងប្អូន គ្រប់ ពេលវេលា ហើយ សម្តេច ទាំង៤ បាន ស្នើឲ្យ បងប្អូន ប្រជាពលរដ្ឋ យើង ចូលរួម ពិធី អក អំបុក នៅ ថ្ងៃទី ៩ វិច្ឆិកា ខាងមុខ បាន គ្រប់ ៗ គ្នា និង បាន ជូនពរ ឲ្យ ជួប តែ ពុទ្ធ ពរ ទាំង៤ កុំបី ឃ្លៀងឃ្លាត ឡើយ ។
លោក បាន ជម្រាប ជូន បងប្អូន អំពី ដំណើរការវិវឌ្ឍន៍ រីកចម្រើន របស់ ប្រទេសជាតិ ជា បន្តបន្ទាប់ពី ដំណាក់កាល មួយ មក ដំណាក់កាល មួយ ហើយ ជា ជំហាន ៗ ក្រោម ការដឹកនាំ ប្រកប ដ៏ ភាពឈ្លាសវៃ របស់ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ គោល នយោបាយ ឈ្នះ - ឈ្នះ ធ្វើឲ្យ ប្រទេសជាតិ ទទួលបាន នូវ សុខ សន្តិភាព ស្ថិរភាព ពេញ ទូទាំង ផ្ទៃ ប្រទេស និង ឈាន ទៅ ធ្វើ ការអភិវឌ្ឍ ជា បណ្តើរ ៗ និង ទទួលបាន កំណើន សេដ្ឋកិច្ច ល្អ ប្រសើរ ក្នុង រយៈពេល ជាង ពីរ ទសវត្ស កន្លងមក នេះ ។
ទន្ទឹមនឹង នេះ រាជ រដ្ឋាភិបាល បាន ដាក់ចេញ នូវ កម្មវិធី គោល នយោបាយ និង យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៤ រួម ជាមួយនិង ការដាក់ចេញ នយោបាយ ធ្វើ កំណែទម្រង់ គ្រប់ វិស័យ ឲ្យ កាន់តែ ស៊ីជម្រៅ និង មាន ប្រសិទ្ធភាព ដើម្បី ឈានទៅ សម្រេច ចក្ខុវិស័យ នា ឆ្នាំ ២០៣០ និង ឆ្នាំ ២០៥០ របស់ រាជ រដ្ឋាភិបាល ។
លោក វេង សា ខុន បាន ផ្តាំផ្ញើ សមាជិក សមាជិកា ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក ឃុំ និង ភូមិ អាជ្ញាធរ មូលដ្ឋាន និង កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ជាន់ ថ្នាក់ ជាពិសេស បងប្អូន ប្រជាពលរដ្ឋ មេត្តា បន្ត រក្សា សុខ សន្តិភាព សន្តិសុខ សណ្តាប់ធ្នាប់ មូលដ្ឋាន ឲ្យបាន ល្អ កុំ ជឿ តាម ពាក្យ មួល បង្កាច់ បំភ្លៃ ការពិត លាប ពណ៌ ឈាន ទៅ បង្ក អស្ថិរភាព បះបោរ និង ហិង្សា ក្នុង សង្គម ។
លោក បាន បញ្ជាក់ ជូន ពលរដ្ឋ ថា ប្រទេស យើង មាន ច្បាប់ ហើយ ច្បាប់ បាន ដាក់ទោសទណ្ឌ ដល់ ជន ណា ដែល មិន គោរព ឬ មិន អនុវត្ត តាម មិន ចំពោះ តែ គណបក្ស ឬ បុគ្គល ណា ម្នាក់ ឡើយ ត្រូវតែ ប្រឈម នឹង ការផ្តន្ទាទោស តាម ច្បាប់ កំណត់ ។ ដូច្នេះ ក្នុង នាម ពលរដ្ឋ ម្នាក់ ត្រូវតែ គោរព ច្បាប់ ដែល មាន ជាធរមាន និង ដើរ តាម មាគ៌ា ដ៏ ត្រឹមត្រូវ ច្បាស់លាស់ របស់ រាជ រដ្ឋាភិបាល ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី ។
ក្នុង ពិធី សំណេះសំណាល នេះ បងប្អូន ប្រជាពលរដ្ឋ បាន ចោទសួរ សំណូមពរ និង សំណើ ដូចជា ស្តារ ប្រឡាយ លូ ទឹក ដី និង គ្រួស ក្រហម សម្រាប់ ជួសជុល កែលម្អ ផ្លូវ លំ និង សំលៀកបំពាក់ ប្រជាការពារ ហើយនិង សហគមន៍ កសិកម្ម អភិវឌ្ឍ កសិករ ស្នើសុំ ឃ្លាំង ស្តុក ស្រូវ ពូជ ហើយ នឹង ម៉ាស៊ីន ព្រោះ ស្រូវ ។ ដើម្បី ជួយ ចែករំលែក និង ដោះស្រាយ សំណើ លោក ប្រធាន និង សហការី បាន ជួយ ឧបត្ថម្ភ ថវិកា មួយ ចំនួន ផងដែរ ។ ដោយឡែក អ្នក ដែល អញ្ជើញ មក ចូលរួម ម្នាក់ ទទួលបាន ថវិកា ២ម៉ឺន រៀល ផងដែរ ៕
អភិបាល រាជធានី ភ្នំពេញ ប្រកាស លុបបំបាត់ ពាក្យ « ចង់ ជួប ចៅសង្កាត់ ដើម្បីឲ្យ ផ្ដល់ សេវា ពិបាក ជាង ចង់ ជួប រដ្ឋមន្ដ្រី »
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន ប្រកាស លុបបំបាត់ ពាក្យ រិះគន់ ថា « ចប់ ជួប ចៅសង្កាត់ ដើម្បីឲ្យ ផ្ដល់ សេវា ពិបាក ជាង ចង់ ជួប រដ្ឋមន្ដ្រី » ព្រោះថា ឥលូវ នៅ តាម សាលា សង្កាត់ ទូទាំង រាជធានី ភ្នំពេញ បាន បង្កើត ក្រុមការងារ មួយ ដើម្បី ចាំ ផ្ដល់ សេវា រដ្ឋបាល ជូន ប្រជាពលរដ្ឋ គ្រប់ ពេលវេលា ។
ការលើកឡើង របស់ លោក ឃួង ស្រេង ក្នុង ឱកាស អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បិទ វគ្គ បណ្ដុះបណ្ដាល ការប្រាស្រ័យទាក់ទង និង បដិសណ្ឋារកិច្ច ក្នុង ការផ្ដល់ សេវា រដ្ឋបាល សាធារណៈ ជូន ប្រជាពលរដ្ឋ តាម សង្កាត់ ក្នុង រាជធានី ភ្នំពេញ នៅ សាលា រាជធានី ភ្នំពេញ នា ល្ងាច ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៩ ។
អភិបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ទៀត ថា ការបង្កើត ឲ្យ មាន វគ្គ បណ្ដុះបណ្ដាល ការប្រាស្រ័យទាក់ទង និង បដិសណ្ឋារកិច្ច ក្នុង ការផ្ដល់ សេវា រដ្ឋបាល សាធារណៈ ជូន ប្រជាពលរដ្ឋ តាម សង្កាត់ ក្នុង រាជធានី ភ្នំពេញ នេះ ក្នុង គោលបំណង ធ្វើ យ៉ាងណា ឲ្យ ការផ្ដល់ សេវា ជូន នៅ កៀក កិត ជាមួយ ប្រជាពលរដ្ឋ ហើយ អ្នក ផ្តល់ សេវា មាន ស្នាមញញឹម ការផ្តល់ សេវា មាន តម្លាភាព គណនេយ្យភាព និង ទាន់ ពេលវេលា ទៅ តាម តម្រូវការ ប្រើប្រាស់ ចាំបាច់ របស់ ប្រជាពលរដ្ឋ ។
លោក ឃួង ស្រេង បាន បន្ដ ថា កន្លងមក នេះ ការផ្ដល់ សេវាកម្ម ជូន ប្រជាពលរដ្ឋ ឃើញ ថា មន្ត្រី របស់ យើង អនុវត្ត បាន ល្អ ប្រសើរ ហើយ ប៉ុន្តែ ទោះបីជា យ៉ាងណា ក្តី យើង ត្រូវតែ ខិតខំ បន្ថែម ទៀត ដើម្បីឲ្យ ការផ្ដល់ សេវា នេះ កាន់តែ ល្អ ប្រសើរ ។ ជាង នេះ ទៅ ទៀត អ្វី ដែល សំខាន់ មិន អាច ខ្វះ បាន មួយ ទៀត នោះ គឺ សាមគ្គីភាព ផ្ទៃក្នុង ដែល មន្ត្រី ទាំងអស់ ត្រូវតែ មាន សាមគ្គីភាព ផ្ទៃ ក្នុង ទើប ការ អនុវត្ត ការងារ នៅក្នុង អង្គភាព របស់ ខ្លួន ទទួលបាន ភាពជោគជ័យ ។
គួរ បញ្ជាក់ ថា វគ្គ បណ្ដុះបណ្ដាល ការប្រាស្រ័យទាក់ទង និង បដិសណ្ឋារកិច្ច ក្នុង ការផ្ដល់ សេវា រដ្ឋបាល សាធារណៈ ជូន ប្រជាពលរដ្ឋ តាម សង្កាត់ ក្នុង រាជធានី ភ្នំពេញ គឺ មាន ការចូលរួម ពី អស់ លោក ជា ចៅសង្កាត់ ស្មៀន ទាំង ១០៥ នៅក្នុង រាជធានី ភ្នំពេញ តែ ម្តង ហើយ នេះ ក៏ ជា វគ្គ បណ្តុះបណ្តាល ដំបូង ផងដែរ ៕
នៅក្នុង ឱកាស នោះ ដែរ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន ជម្រាប ជូន ភាគី ក្រុមការងារ រៀបចំ សមយុទ្ធនាគ មាស ឆ្នាំ ២០២០ របស់ ភាគី កងទ័ព រំដោះ ប្រជាជន ចិន ដែរ ថា ជា ការ ល្អ គួរ ជ្រើសរើស យក ទីលាន បាញ់ គ្រាប់ ពិត តេជោ សែន ក្នុង ស្រុក ជុំ គីរី ខេត្ត កំពត របស់ កងពល តូច លេខ ៧០ ដូច ដែល យើង បាន រួមគ្នា ធ្វើ ពីរ ឆ្នាំ មុន ៗ ព្រោះ ទីតាំង នោះ មាន ទីលាន ស្រាប់ និង កន្លែង ស្នាក់ នៅ ស្រាប់ ។
នាយ ឧត្តមសេនីយ៍ បាន បន្ត ថា ដោយឡែក ទីលាន ថ្មី របស់ កងពល តូច ទ័ព ពិសេស ឆត្រយោង លេខ ៩១១ ដែល ក្រុមការងារ ជំនាញ ទាំង ពីរ បាន ចុះ ទៅ ពិនិត្យមើល នោះ យើង នឹង រួមគ្នា បន្ត សិក្សា ស្រាវជ្រាវ និង កសាង ទីតាំង ថ្មី នោះ សម្រាប់ ឆ្នាំ បន្តបន្ទាប់ ខាងមុខ ទៀត ព្រោះ ទីតាំង ថ្មី នេះ ក៏ ពុំ ទាន់ បាន កសាង នូវ អ្វី នៅឡើយ ទេ ។
