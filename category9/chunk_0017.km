( ភ្នំពេញ ) ៖ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « សក្តានុពល នៃ ការវិនិយោគ នៅ កម្ពុជា » នៅ ម៉ោង ៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០១៩ នេះ នៅ សាល ប្រជុំ B នៃ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី ។
សេចក្ដីជូនដំណឹង របស់ អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល បាន បញ្ជាក់ ថា សន្និសីទ នេះ មាន ការចូលរួម ពី វា គ្មិន លោក ជា វុទ្ធី អគ្គ លេខាធិការង ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា ។
សន្និសីទ សារព័ត៌មាន នេះ ធ្វើឡើង ក្នុង គោលបំណង ដើម្បី បង្ហាញ ពី ការរីកលូតលាស់ ការវិនិយោគ នៅ ប្រទេស កម្ពុជា ក៏ ដូចជា ការទាក់ទាញ វិនិយោគ បន្ថែម ទៀត ដោយសារតែ កម្ពុជា មាន សក្តានុពល ខ្ពស់ សម្រាប់ ការវិនិយោគ គ្រប់ វិស័យ ៕ សរុប ព័ត៌មាន ពិសេស ៗ ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ ( ភ្នំពេញ ) ៖ សរុប ព័ត៌មាន ជាតិ - អន្តរជាតិ ប្រចាំ ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ ( ផ្សាយ ពី ថ្ងៃចន្ទ - សុក្រ ចាប់ពី ម៉ោង ៧៖០០ នាទី យប់ ) ។
១៖ សម្តេច តេជោ ហ៊ុន សែន អនុញ្ញាតឱ្យ ទេសរដ្ឋមន្ត្រី វ៉ា គឹម ហុង បំភ្លឺ ជូន ឧត្តម ក្រុមប្រឹក្សា ពិគ្រោះ និង ផ្តល់ យោបល់ នៅ ថ្ងៃស្អែក ( ចុច អាន )
២៖ សម្ដេច ក្រឡាហោម ស ខេង ព្រមាន ចាប់ខ្លួន បុគ្គល ដែល ចូលរួម ក្នុង ផែនការ ធ្វើ រដ្ឋប្រហារ ជា បន្តបន្ទាប់ ទៀត ( ចុច អាន )
៣៖ សម្ដេច ក្រឡាហោម ស ខេង៖ រាជ រដ្ឋាភិបាល ប្ដេជ្ញាចិត្ត យ៉ាង មុតមាំ ដើម្បី ធ្វើ កំណែទម្រង់ នៅ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ លើកកម្ពស់ ការផ្ដល់ សេវា ជូន ពលរដ្ឋ ( ចុច អាន )
៥៖ តុលាការ ខេត្ត សៀមរាប បង្គាប់ ឱ្យ ចាប់ខ្លួន ឈ្មោះ ឃុន វាន ដែល ពាក់ព័ន្ធ នឹង អំពើ ក្បត់ ជាតិ ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ( ចុច អាន )
៦៖ ចាប់ខ្លួន អតីត អនុប្រធាន ប្រតិបត្តិ CNRP ២រូប នៅ ខេត្ត កំពង់ស្ពឺ ពាក់ព័ន្ធ បទល្មើស ញុះ ញុង ឲ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ ( ចុច អាន )
៧៖ តុលាការ ខេត្ត កំពង់ចាម ចេញ ប្រកាស អំពី ការចោទប្រកាន់ មនុស្ស ២នាក់ ពាក់ព័ន្ធ នឹង បទ « រួម គំនិត ក្បត់ » ប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ( ចុច អាន )
៨៖ កិច្ចប្រជុំ រដ្ឋមន្ត្រី បរិស្ថាន អាស៊ាន លើក ទី ១៥ ទទួល ផ្លែ ផ្កា យ៉ាង ជោគជ័យ ដោយ អនុម័ត និង ឯកភាព លើ ឯកសារ សំខាន់ ៣ ( ចុច អាន )
៩៖ រដ្ឋមន្ត្រី បរិស្ថាន កម្ពុជា៖ អាស៊ាន មិន ទាន់ អាច ដោះស្រាយ បញ្ហា ផ្សែង អ័ព្ទ ឆ្លង ដែន នៅ ឆ្នាំ ២០២០ តាម គោលដៅ បាន នោះ ទេ ( ចុច អាន )
១០៖ លោក នេត្រ ភក្ត្រា៖ សមាជិក អាស៊ាន ជំរុញ ឱ្យ រួមគ្នា អភិរក្ស ជីវៈ ចម្រុះ ធនធាន ធម្មជាតិ ដោយ បង្កើត មជ្ឈមណ្ឌល អាស៊ាន សម្រាប់ ជីវៈ ចម្រុះ ( ចុច អាន )
១១៖ លំនៅឋាន ស្តង់ដា ជប៉ុន ទី មួយ នៅ កម្ពុជា ទុន វិនិយោគ ៧០ លាន ដុល្លារ កំពុង ទាក់ យក បេះដូង ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ និង មកពី បណ្តា ខេត្ត ( ចុច អាន )
៤៖ លោកស្រី ហ៊ីល ឡារី គ្លីនតុន បញ្ចេញ ប្រតិកម្ម តប ទៅនឹង ពាក្យសម្តី របស់ លោក ដូណាល់ ត្រាំ ( ចុច អាន )
៥៖ នាយក រដ្ឋមន្រ្តី ឥណ្ឌា នឹង បើក កិច្ចប្រជុំ កំពូល ក្រៅ ផ្លូវការ ជាមួយ លោក ស៊ី ជីន ពីង ក្នុង សប្តាហ៍ នេះ ( ចុច អាន )
៦៖ សហរដ្ឋ អាមេរិក ត្រៀម រឹតត្បិត ការផ្តល់ ទិដ្ឋាការ ដល់ មន្ត្រី ចិន មួយចំនួន . ចិន ឆ្លើយតប វិញ ដោយ មិន បង្អង់ យូរ ( ចុច អាន )
៧៖ ទីបំផុត សិង្ហបុរី ដណ្តើម បាន លេខ ១ពី សហរដ្ឋ អាមេរិក និង ក្លាយជា ប្រទេស មាន សេដ្ឋកិច្ច ប្រកួតប្រជែង ខ្លាំង បំផុត លើ លោក ( ចុច អាន )
៩៖ សមយុទ្ធ យោធា ការពារ អឺរ៉ុប៖ សហរដ្ឋ អាមេរិក គ្រោង ដាក់ពង្រាយ កងទ័ព ២០.០០០ នាក់ នៅ ទូទាំង តំបន់ អាត្លង់ទិច ( ចុច អាន )
១០៖ ទីបំផុត មេ ភេរវករ ក្រុម អាល់កៃដា ប្រចាំ អាស៊ី ខាងត្បូង ត្រូវបាន កងទ័ព អាមេរិក - អាហ្វហ្គានីស្ថាន សម្លាប់ ( ចុច អាន )
ប៉ុន្តែ ភ្លាម ៗ មិន ទាន់ មាន ការបញ្ជាក់ ណាមួយ ថា ករណី បាញ់ប្រហារ ទាំង ២លើក នេះ មាន ជាប់ពាក់ព័ន្ធ គ្នា នោះ ទេ ខណៈ ប៉ូលិស អាល្លឺម៉ង់ ប្រាប់ ឱ្យ ប្រជាជន ក្នុង តំបន់ ស្ថិត នៅក្នុង ផ្ទះ ជា បណ្ដោះអាសន្ន សិន ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
៣៖ ទីប្រឹក្សា ប្រធានាធិបតី តួកគី បាន ឲ្យដឹង ថា លោក អឺ ដូហ្គាន់ និង លោក ដូណាល់ ត្រាំ បាន ព្រមព្រៀង គ្នា ផ្ទេរ ការដឹកនាំ យុទ្ធនាការ កម្ទេច ក្រុម ភេរវករ ISIS នៅ ស៊ីរី មក ឲ្យ តួកគី ។ ហេតុ ដូចនេះ តួកគី នឹង លើក ទ័ព ឆ្លង ចូល ទឹកដី ភាគ ខាងជើង ប្រទេស ស៊ីរី ក្នុង ពេល ប៉ុន្មាន ថ្ងៃ ខាងមុខ ។
៤៖ ប្រទេស សិង្ហបុរី បាន វ៉ា ដាច់ សហរដ្ឋ អាមេរិក ឡើង ទៅ ឈរ លេខរៀង ទី១ ក្នុង នាម ជា ប្រទេស ដែល មាន សេដ្ឋកិច្ច ប្រកួតប្រជែង ខ្លាំង ជាង គេ បំផុត នៅលើ ពិភពលោក ក្នុង ឆ្នាំ ២០១៩ នេះ តែម្តង ។
៥៖ សហរដ្ឋ អាមេរិក បាន ប្រកាស ថា ខ្លួន នឹង ដាក់ ការរឹតត្បិត លើ ការផ្ដល់ ទិដ្ឋាការ ដល់ ក្រុម មន្ត្រី ចិន មួយចំនួន រួមទាំង សមាជិក គ្រួសារ របស់ ពួកគេ ដែល អាមេរិក ចោទ ថា មាន ជាប់ពាក់ព័ន្ធ នឹង ការគាបសង្កត់ និង ធ្វើ ទុក្ខបុកម្នេញ លើ ជនជាតិ ដើម ភាគ តិច ម៉ូស្លីម អ៊ុយហ្គឺ (Uighurs) ។
៦៖ មេដឹកនាំ នៃ ក្រុម ភេរវករ អាល់កៃដា (al-Qaeda) សាខា ប្រចាំ តំបន់ អាស៊ី ខាងត្បូង ត្រូវបាន កងកម្លាំង ចំរុះ អាមេរិក - អាហ្វហ្គានីស្ថាន ផ្តាច់ ជីវិត បាត់ ទៅ ហើយ នៅ ភាគ ខាងត្បូង ប្រទេស អាហ្វហ្គានីស្ថាន កាលពី ចុង ខែកញ្ញា កន្លងទៅ នេះ ៕ អភិបាល ខេត្ត កំពត ក្រើន រំលឹក មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ត្រូវ ពន្លឿន ការចេញ បណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ឆាប់
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ដឹកនាំ ក្នុង កិច្ចប្រជុំ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត ប្រចាំ ខែកញ្ញា នា រសៀល ថ្ងៃទី ៩ ខែតុលា ឆ្នាំ ២០១៩ នេះ នៅ សាល ប្រជុំ សាលា ខេត្ត ។ ក្នុង កិច្ចប្រជុំ នោះ ក៏ មាន ការចូលរួម ពី លោក លោកស្រី ជា មន្ត្រីរាជការ ថ្នាក់ដឹកនាំ និង កងកម្លាំងប្រដាប់អាវុធ ពាក់ព័ន្ធ ទាំងអស់ ជាង ៧០ រូប ។
ថ្លែង ក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត បាន ក្រើន រំលឹក មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ជាពិសេស ស្ថាប័ន ច្រក ចេញ ចូល តែ មួយ ខេត្ត និង មន្ទីរ សូរិយោដី ខេត្ត ត្រូវ សហការ គ្នា ពន្លឿន ការចេញ ប័ណ្ណ កម្មសិទ្ធិ ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ឆាប់ ក្រោយពី បាន វាស់វែង ដីធ្លី ជូន ប្រជាពលរដ្ឋ ជាច្រើន ខែ និង ឆ្នាំ មកហើយ មិន ទាន់ មាន ការចេញ ប័ណ្ណ កម្មសិទ្ធិ ។ ចាំបាច់ ត្រូវតែ កែសម្រួល ឡើងវិញ ពោលគឺ មិន អាច ឱ្យ ការងារ បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ នៅ យឺតយ៉ាវ បន្ត ទៀត ឡើយ ។
លោក អភិបាល ខេត្ត បន្ត ទៀត ថា អង្គភាព ច្រក ចេញ ចូល តែ មួយ ត្រូវ បម្រើ ការងារ ជូន អ្នក មក ទទួល សេវា ឱ្យ បាន ឆាប់ រហ័ស ស្រប តាម នីតិវិធី ច្បាប់ ដែល បាន កំណត់ ។
ក្នុង ករណី ការងារ ផ្នែក វិស័យ ណា មួយ មាន ភាពរាំងស្ទះ ត្រូវ រាយការណ៍ ជូន រដ្ឋបាល ខេត្ត ដើម្បី មាន មូលដ្ឋាន ក្នុង ការដោះស្រាយ តាម តម្រូវការ របស់ ប្រជាពលរដ្ឋ ។ លោក អភិបាល ខេត្ត ថា រូប លោក បាន លើកឡើង ក្នុង អង្គប្រជុំ ជារឿយ ៗ កន្លងមក ថា អ្នក មក ទទួល សេវា ពិសេស ប្រជាពលរដ្ឋ ដែល ត្រូវការ បណ្ណ កម្មសិទ្ធិ ដីធ្លី ដើម្បី យក ទៅ ប្រើប្រាស់ ក្នុង ភាពចាំបាច់ តែង រអ៊ូរទាំ អំពី ការលំបាក ចំពោះ បញ្ហា នេះ ។
ខ្ញុំ កត់សំគាល់ ជាច្រើន ឆ្នាំ ណាស់ មកហើយ ថា គ្មាន សកម្មជន ឬ មន្ត្រី អ្នកស្មោះស្ម័គ្រ ជាមួយ លោក សម រង្ស៊ី ណា ម្នាក់ បាន ទទួល ពរ ជ័យ និង ស្គាល់ ភាពចម្រុង ចម្រើន ក្នុង ជីវិត នយោបាយ ជីវិត ការងារ ឬ ក្នុង របររកស៊ី របស់ ខ្លួន សោះឡើយ ។
ដើម្បី មើល ឲ្យ ឃើញ បញ្ហា នេះ កាន់តែ ច្បាស់ យើង អាច ក្រឡេក ថយ ក្រោយ បន្តិច ទៅ មើល ដំណើរ ជីវិត នយោបាយ របស់ លោក សម រង្ស៊ី តាំងពី ចាប់ផ្តើម ដំបូង ។ ក្រោយ ការបណ្តេញ ចេញ ពី គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច លោក សម រង្ស៊ី បាន ទៅ បង្កើត គណបក្ស នយោបាយ ថ្មី មួយ កាលពី ឆ្នាំ ១៩៩៥ ដែល មាន ឈ្មោះ ថា គណបក្ស ជាតិ ខ្មែរ ។ មិន បាន ប៉ុន្មាន ឆ្នាំ ផង គណបក្ស នេះ ក៏ ត្រូវ បែកបាក់ ខ្ទេចខ្ទី ដោយសារ ជម្លោះ ផ្ទៃក្នុង ដែល បង្ខំ ឲ្យ លោក សម រង្ស៊ី រត់ ទៅ បង្កើត បក្ស ថ្មី មួយ ទៀត ដោយ ដាក់ ឈ្មោះ ខ្លួន ឯង គឺ គណបក្ស សម រង្ស៊ី ។
ទីបំផុត អ្នក ទាំងនោះ ធ្លាក់ខ្លួន ក្រកាន់តែ ខ្លាំង ហើយ វិលត្រឡប់ ទៅ ស្រុក វិញ ដោយ អស់សង្ឃឹម បន្ទាប់ពី លោក សម រង្ស៊ី សម្រេច ចូល អង្គុយ ក្នុង សភា ធ្វើ ព្រងើយ ។ បច្ចុប្បន្ន នេះ មន្ត្រី អ្នក នៅជិតស្និទ្ធ ជាមួយ លោក សម រង្ស៊ី ក៏ កំពុង រង ទុក្ខ ទោស និរាស ប្រាស់ ព្រាត់ ដូចគ្នា ដែរ ។ ជាក់ស្តែង លោក អេង ឆៃ អ៊ាង ដែល កាល នៅ ស្រុក ខ្មែរ ធ្លាប់ មាន លុយ ចាយ សប្បាយ ហ៊ឺហា ស្រី ញី និង លេង ល្បែង កាស៊ីណូ តាម ចិត្ត ឥឡូវ ធ្លាក់ខ្លួន ប្រាស់ ព្រាត់ គ្រួសារ ក្លាយជា ជន ពនេចរ អនាថា នៅ ក្រៅ ប្រទេស ។
វគ្គ បណ្តុះបណ្តាល ជន បង្គោល វិស័យ បរិស្ថាន ចំនួន ១០០ នាក់ ត្រូវបាន បិទ បញ្ចប់ ដោយ ជោគជ័យ
ចុងបញ្ចប់ នៃ វគ្គ បណ្តុះបណ្តាល នោះ មាន ចែក វិញ្ញាបនបត្រ បញ្ជាក់ ការសិក្សា ដល់ សិក្ខាកាម ដែល ជាប់ ជ័យលាភី ទាំង ១០០ នាក់ ផងដែរ ៕
ពិព័រណ៍ អចលន ទ្រព្យ ឆ្នាំ ២០១៩ បំបែក កំណត់ត្រា នៃ ការលក់ អចលន ទ្រព្យ ច្រើន បំផុត បើ ធៀប នឹង ឆ្នាំ ២០១៨
ពិព័រណ៍ អចលន ទ្រព្យ កម្ពុជា ឆ្នាំ ២០១៩ ជា វេទិកា ដែល រៀបចំឡើង ជារៀងរាល់ ឆ្នាំ ហើយ វេទិកា នេះ មាន គោលដៅ សំខាន់ បំផុត ក្នុង ការនាំយក អ្នកទិញ ឲ្យ ជួប ផ្ទាល់ ជាមួយ អ្នកលក់ ។
លោក បន្ត ថា « ខណ នេះ យើង កំពុង ធ្វើ ការបូកសរុប លទ្ធផល ចុង ក្រោយ ក៏ប៉ុន្ដែ យើង ប្រាកដ ច្បាស់ ថា ចំនួន អ្នកចូលរួម គឺ មាន ការកើនឡើង ទ្វេ ដង បើ ប្រៀបធៀប ជាមួយ ព្រឹត្តិការណ៍ កាលពី ឆ្នាំ មុន ហើយ វា បាន បំបែក កំណត់ត្រា នៃ ការលក់ អចលន ទ្រព្យ ដែល មាន ចំនួន ៣០លាន ដុល្លារ កាលពី ពិព័រណ៍ ឆ្នាំ ២០១៨ ដោយ តាមរយៈ ព័ត៌មាន បឋម របស់ យើង បង្ហាញ ថា ចំនួន នៃ ការលក់ អចលន ទ្រព្យ ក្នុង កំឡុង ពេល ពិព័រណ៍ នោះ គឺ មាន ចំនួន លើស ពី ៤០ លាន ដុល្លារ ហើយ » ។
ពិព័រណ៍ អចលន ទ្រព្យ កម្ពុជា ត្រូវបាន រៀបចំឡើង យ៉ាង ល្អ និង បាន ទទួល ការគាំទ្រ កាន់តែ ខ្លាំង ឡើង ដោយសារ ពិព័រណ៍ ឆ្នាំ នេះ បាន ប្រមូលផ្តុំ ដោយ គម្រោង ធំ ៗ អ្នកជំនាញ ល្បី ៗ ក្នុង វិស័យ អចលន ទ្រព្យ អ្នកអភិវឌ្ឍន៍ ភ្នាក់ងារ ស្ថាប័ន ហិរញ្ញវត្ថុ អ្នកជំនាញ ផ្នែក ច្បាប់ អ្នក វិនិយោគ ក្នុង ស្រុក និង អន្តរជាតិ និង អ្នកទិញ ផ្ទះ ជាច្រើន នាក់ ។
អ្នកជំនាញ អចលន ទ្រព្យ និង អ្នក ច្បាប់ ជាង ២០ នាក់ បាន ធ្វើ បទបង្ហាញ អំពី ប្រធានបទ នានា ជុំវិញ ទីផ្សារ និង និន្នាការ បច្ចុប្បន្ន នៃ វិស័យ អចលន ទ្រព្យ ។
ក្រៅពី នេះ ម្ចាស់ ឧបត្ថម្ភ កម្មវិធី ផ្សេង ៗ ទៀត ហើយ ពិព័រណ៍ អចលន ទ្រព្យ នេះ មាន អ្នក អភិវឌ្ឍន៍ ចូលរួម ជាច្រើន ផងដែរ ៕
ចិន ប្រកាស ឈរ នៅ ខាង ប៉ាគីស្ថាន ចំពោះ មុខ ជម្លោះ រវាង ឥណ្ឌា និង ប៉ាគីស្ថាន លើ តំបន់ កាស្មៀរ
( ប៉េកាំង ) ៖ ប្រធានាធិបតី ចិន លោក ស៊ី ជិន ពី ង នា ថ្ងៃពុធ នេះ បាន និយាយ ថា លោក កំពុងតែ តាមដាន ស្ថានការណ៍ នៅ តំបន់ កំពុង វិវាទ នោះ គឺ កាស្មៀរ ហើយ លោក នឹង បន្ត គាំទ្រ ទីក្រុង អ៊ីស្លា ម៉ា បាដ ជុំវិញ បញ្ហា នានា ដែល ពាក់ព័ន្ធ នឹង ផលប្រយោជន៍ ស្នូល របស់ ប៉ាគីស្ថាន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន CNA នៅ ល្ងាច ថ្ងៃពុធ ទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ ។
គួរ ជម្រាប ថា ភាពតានតឹង នៅ តំបន់ ជម្លោះ កាស្មៀរ ក្នុង ឆ្នាំ នេះ បាន កើនឡើង ខ្លាំង ថែម ទៀត កាលពី ខែសីហា កន្លងទៅ នៅពេល ឥណ្ឌា បាន សម្រេច ដក ស័្វយភាព នៃ ចំណែក កាស្មៀរ ដែល ខ្លួន កាន់កាប់ ។ ទង្វើ នេះ បាន ទទួលរង ការរិះគន់ ធ្ងន់ ៗ ពី ប៉ាគីស្ថាន ដែល ជា គូ បដិបក្ខ ហើយ ចិន ដែល ឈរ នៅ ខាង ទីក្រុង អ៊ីស្លា ម៉ា បាដ ក៏ បាន លើក យក បញ្ហា នោះ ទៅ ជជែក ដល់ ក្រុមប្រឹក្សា សន្តិសុខ របស់ អង្គការ សហ ប្រជាជាតិ ផងដែរ ។
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៩ ខែតុលា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ និង ផាក ពិន័យ ចំនួន ១. ៦១៨ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង ៥.១៥៩ គ្រឿង រកឃើញ យានយន្ត ល្មើស ច្បាប់ និង ផាក ពិន័យ ចំនួន ១.៦១៨ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ចំនួន ១. ១៣៤ គ្រឿង ។ នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក សង្កែ ចុះ ដោះស្រាយ បន្ទាន់ កាយ ប្រឡាយ បង្ហូរ ទឹក ពី ស្ទឹង សង្កែ ជូន ប្រជាពលរដ្ឋ ប្រើប្រាស់ បាន ទាន់ ពេលវេលា នៅ ឃុំ តា ប៉ុន
នៅក្នុង ឱកាស នោះ ក៏ មាន ការចូលរួម ពី មន្រ្តី ជំនាញ ពាក់ព័ន្ធ គណៈ អភិបាល ស្រុក ក្រុមប្រឹក្សា ស្រុក កងកម្លាំង មន្រ្តី រាជការ ក្រុមប្រឹក្សា ឃុំ ប្រជាពលរដ្ឋ ក្នុង សហគមន៍ មួយចំនួន ចូលរួម ផងដែរ ។
លោក កុល វីរក្ស បាន ឲ្យដឹង ថា ដោយ មើលឃើញ ទុក្ខ កង្វល់ ការលំបាក ជាបន្ទាន់ របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន មក លោក បាន ដឹកនាំ ក្រុមការងារ ចុះ ទៅ អន្តរាគមន៍ ដោយ យក គ្រឿងចក្រ កាយ ប្រឡាយ មេ ពី ទំនប់ ស្ទាក់ ទឹក សាលា តា អន់ ក្នុង ស្រុក ឯក ភ្នំ ដើម្បី បើ មុខ ឲ្យ ទឹក ហូរ តាម អូរ និង តាម ទ្វារ ទឹកនាំ ទឹក ទៅដល់ គោលដៅ សម្រាប់ ទុក្ខ ជូន ប្រជាពលរដ្ឋ ប្រើប្រាស់ នៅក្នុង ឃុំ តា ប៉ុន ស្រុក សង្កែ ទាន់ ពេល វេលា ។
លោក កុល វីរក្ស បាន បញ្ជាក់ ថា ការសង្គ្រោះ បន្ទាន់ នេះ គឺ បាន ជោគជ័យ ក៏ អាស្រ័យ ដោយ មាន មន្រ្តី ជំនាញ ពាក់ព័ន្ធ ទាំងអស់ សហការ ចូលរួម គិត ពី ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ជា ធំ ជារៀងរហូត មក គឺ មិន ដែល អាក់ខាន ម្តង ណា ឡើយ ។
ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ តា ប៉ុន ទាំងអស់ ពិសេស ជន ងាយ រងគ្រោះ បាន ថ្លែងអំណរគុណ ដល់ លោក ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ និង លោក ប្រធាន សាខា កាកបាទ ក្រហម ខេត្ត ដែល តែងតែ ដឹង សុក្ខ ទុក្ខ និង ជួយ ប្រជាពលរដ្ខ ពេល ជួប ការលំបាក ម្តង ៗ គឺ ចុះ មក ជួយ បាន ពេលវេលា រហូតមក ពួកគាត់ បាន ឆ្លើ តប ថា សូម ជូនពរ ដល់ ថ្នាក់ដឹកនាំ ទាំងអស់ មាន សុខភាព ល្អ និង ជ័យជំនះ គ្រប់ ភារកិច្ច ពិសេស ថ្នាក់ដឹក កំពូល គឺ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ហ៊ុន សែន នឹង នៅ បន្ត ដឹកនាំ ប្រទេសជាតិ ប្រកបដោយ សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ តទៅ ៕
រដ្ឋមន្រ្តី វង សូត៖ កម្មវិធី សាងសង់ ផ្ទះ ជូន ជន ពិការ ក្រីក្រ របស់ មូលនិធិ ជន ពិការ បាន ជួយ លើកកម្ពស់ ជីវភាព របស់ ជន ពិការ ក្រីក្រ
( បាត់ដំបង ) ៖ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន លើកឡើង ពី ការយកចិត្តទុកដាក់ របស់ រាជ រដ្ឋាភិបាល ដល់ បងប្អូន ជន ពិការ តាមរយៈ ការផ្តល់ សេវា ស្តារ លទ្ធភាព ពលកម្ម ដោយ ឥត គិត ថ្លៃ ការផ្តល់ របប គោល នយោបាយ ពិនិត្យ ថែទាំ សុខភាព ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ការជម្រុញ ឱ្យ ទទួលបាន ការងារ ធ្វើ ការសម្របសម្រួល សមស្រប សម្រាប់ ជន ពិការ និង ការដាក់បញ្ចូល ជន ពិការ ទៅក្នុង សកម្មភាព សង្គម ។
លោក បាន បន្ត ថា កត្តា សុខ សន្តិភាព និង ការអភិវឌ្ឍ បាន ជម្រុញ ឱ្យ ជន ពិការ បាន ទទួល ការគាំពារ ពី រាជ រដ្ឋាភិបាល ដូច អ្វី ដែល មាន នៅ ទីនេះ ស្រាប់ គឺ កម្មវិធី សាងសង់ ផ្ទះ ជូន ជន ពិការ ក្រីក្រ របស់ មូលនិធិ ជន ពិការ នេះ គឺ បាន ជួយ លើកកម្ពស់ ដល់ ជីវភាព របស់ ជន ពិការ ក្រីក្រ ក្នុង ការរស់នៅ ប្រកបដោយ សុខុមាលភាព និង សេចក្តីថ្លៃថ្នូរ ។
ថ្លែង ក្នុង កម្មវិធី នេះ លោក ជួរ រតនៈ នាយក មូលនិធិ ជន ពិការ បាន ឱ្យដឹង ថា កម្មវិធី សាងសង់ ផ្ទះ នេះ គឺ បាន ប្រើប្រាស់ ថវិកា មួយ ផ្នែក ពី ហិប ប្រាក់ វិភាគទាន សប្បុរសធម៌ មូលនិធិ ជន ពិការ ដោយ អស់ ថវិកា សរុប ចំនួន ១៤.២៨០ .០០០ រៀល ដោយឡែក ថវិកា មួយ ផ្នែក ទៀត កន្លងមក មូលនិធិ ជន ពិការ បាន ប្រើប្រាស់ លើ ការទិញ អំណោយ សប្បុរស ធម៌ សម្រាប់ ផ្តល់ ជូន ដល់ ជន ពិការ ក្រីក្រ ចំនួន ៨៩១ នាក់ ។
ក្នុង ថ្ងៃ នេះ ផងដែរ មូលនិធិ ជន ពិការ ក៏ បាន ផ្តល់ អំណោយ សប្បុរសធម៌ មួយចំនួន ដល់ លោក ភា បឿន រួម មាន ថវិកា ២០ ម៉ឺន រៀល អង្ករ ២៥ គីឡូ ក្រោម ត្រីខ ០២ យួរ ទឹក ស៊ីវ អ៊ីវ០១ យួរ ទឹកត្រី ០១យួរ អំបិល ០២ កញ្ចប់ មី ០១កេស មុង ០១ ភួយ ០១ កន្ទេល ០១ និង សម្លៀកបំពាក់ ១កញ្ចប់ ។
បន្ថែម ពីលើ នោះ រដ្ឋមន្ត្រី វង សូត ក៏ បាន ប្រគល់ សោរ ផ្ទះ ជា និមិត្តរូប នៃ ការប្រគល់ ផ្ទះ ជូន ជន ពិការ ក្រីក្រ និង បាន ផ្តល់ ជូន ថវិកា ដល់ ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម ដោយ ក្នុង ម្នាក់ ទទួលបាន ថវិកា ចំនួន ៣០.០០០ រៀល ។
គួរ បញ្ជាក់ ថា មូលនិធិ ជន ពិការ បាន ទទួល ព័ត៌មាន ពី សាខា មូលនិធិ ជន ពិការ ខេត្ត បាត់ដំបង ដែល កន្លងមក បាន សហការ ជាមួយ អាជ្ញាធរ ឃុំ ជ្រោយ ស្តៅ ក្នុង ការកំណត់ លក្ខណៈ វិនិច្ឆ័យ របស់ លោក ភា បឿន ។
តាម របាយការណ៍ របស់ អាជ្ញាធរ ឃុំ ជ្រោយ ស្តៅ គឺ លោក ភា បឿន អាយុ ៥៧ ឆ្នាំ បាន គ្រោះថ្នាក់ ចរាចរណ៍ បណ្តាលឲ្យ បាក់ ឆ្អឹង ដៃ ម្ខាង និង ឈឺ រ៉ាំរ៉ៃ រហូតដល់ ធ្លាក់ខ្លួន ពិការ រីឯ ប្រពន្ធ បាន ស្លាប់ ចោល អស់ ២០ ឆ្នាំ ហើយ សព្វ ថ្ងៃ រស់ នៅ ជាមួយ កូន ពិការ ឈ្មោះ បឿន វេ ភេទ ប្រុស អាយុ ២៨ ឆ្នាំ ពិការ ពី កំណើត ដោន ស៊ីន ដ្រូម និង ម្រាមដៃ ម្រាម ជើង ជាប់ គ្នា មាន ទីលំនៅ ក្នុង ភូមិ ឃុំ ខាងលើ ៕
ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន ដឹកនាំ កិច្ចប្រជុំ ពិនិត្យ និង ពិភាក្សា លើ សេចក្តីព្រាង « យុទ្ធសាស្ត្រ ស្តីពី ការគ្រប់គ្រង បំណុល សាធារណៈ ២០១៩ - ២០២៣ »
កិច្ចប្រជុំ នេះ រៀបចំឡើង ក្រោម អធិបតីភាព របស់ លោក អគ្គ បណ្ឌិត សភាចារ្យ អូន ព័ន្ធ មុនីរ័ត្ន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង ជា ប្រធាន គណៈកម្មាធិការ គ្រប់គ្រង បំណុល សាធារណៈ ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ នៃ ក្រសួង - ស្ថាប័ន . សមាជិក នៃ គណៈកម្មាធិការ គ្រប់គ្រង បំណុល សាធារណៈ ព្រមទាំង ថ្នាក់ដឹកនាំ និង មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ។
សេចក្តីព្រាង « យុទ្ធសាស្ត្រ ស្តីពី ការគ្រប់គ្រង បំណុល សាធារណៈ ២០១៩ - ២០២៣ » នេះ ត្រូវបាន រៀបចំឡើង អនុលោម តាម បរិការណ៍ ជាក់ស្តែង របស់ កម្ពុជា និង ឧត្តមានុវត្ត ជា អន្តរជាតិ ដោយ៖
១៖ ពិនិត្យ លើ វឌ្ឍនភាព នៃ ការ អនុវត្ត យុទ្ធសាស្រ្ត ស្តីពី ការគ្រប់គ្រង បំណុល សាធារណៈ ២០១៥ - ២០១៨ ព្រមទាំង
ដើម្បី បន្ត ធានា នូវ ប្រសិទ្ធភាព . ស័ក្តិសិទ្ធិភាព . តម្លាភាព . គណនេយ្យភាព . និង ចីរភាព នៃ ការគ្រប់គ្រង បំណុល សាធារណៈ ក្នុង រយៈពេល មធ្យម និង វែង . សម្រាប់ ឆ្នាំ ២០១៩ - ២០២៣ . រាជ រដ្ឋាភិបាល នឹង ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ គន្លឹះ ទាំង ៥រួម មាន៖
អង្គប្រជុំ បាន វាយតម្លៃ ខ្ពស់ អំពី សារៈសំខាន់ នៃ « យុទ្ធសាស្ត្រ ស្តីពី ការគ្រប់គ្រង បំណុល សាធារណៈ ២០១៩ - ២០២៣ » នេះ ហើយ បាន ពិភាក្សា ស៊ីជម្រៅ លើ ខ្លឹមសារ តាម ជំពូក នីមួយ ៗ នៃ សេចក្តីព្រាង យុទ្ធសាស្រ្ត សំដៅ ធានា បាន នូវ សង្គតិភាព និង ភាពប្រឡាក់ ក្រឡា ជាមួយ គោល នយោបាយ និង យុទ្ធសាស្ត្រ ពាក់ព័ន្ធ ផ្សេង ទៀត ។
( ភ្នំពេញ ) ៖ កញ្ញា ឆែ ដានី ម្ចាស់ ពានរង្វាន់ សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន លើ វេទិកា កិច្ចពិភាក្សា ចំណេះដឹង ទូទៅ ស្តី វប្បធម៌ ជាតិ ឆ្នាំ ២០១៨ កំពុង ធ្លាក់ខ្លួន ឈឺ ធ្ងន់ធ្ងរ និង ដង្ហោយ ស្វែងរក ការជួយសង្គ្រោះ ជីវិត ពី សប្បុរសជន ។
កញ្ញា ឆែ ដានី មាន អាយុ ២៦ ឆ្នាំ ជា កូន អ្នក ខេត្ត ពោធិ៍សាត់ ទើប បញ្ចប់ ការសិក្សា ផ្នែក អក្សរ ខ្មែរ នៅ សាកលវិទ្យា ភូមិន្ទ ភ្នំពេញ ។ កញ្ញា ជា កុល ធីតា ខ្មែរ មួយ រូប ដែល បាន រួមចំណែក យ៉ាង សកម្មភាព លើ ការងារ មនុស្សធម៌ ជាពិសេស លើ ផ្នែក វប្បធម៌ ។ កញ្ញា ធ្លាប់ បាន ចូលរួម ក្នុង សកម្មភាព យុវជន ស្ម័គ្រចិត្ត ជួយ រៀបចំ ព្រឹត្តិការណ៍ អង្គរ សង្ក្រាន្ត និង កម្មវិធី ក្រមា វែង ជាង គេ លើ ពិភពលោក របស់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ផងដែរ ។
កញ្ញា ដានី ត្រូវបាន គេ ស្គាល់ កញ្ញា ច្បាស់ តាមរយៈ ការលេង ឧបករណ៍ បុរាណ ខ្មែរ « សាដៀវ ឬ ឯក តន្ត្រី » ។ ព្រោះតែ ការស្រឡាញ់ ឧបករណ៍ តន្ត្រី បុរាណ ខ្មែរ ដានី បាន ឆ្លៀត ពី ការសិក្សា រៀនសូត្រ ទៅ រៀន លេង ឧបករណ៍ នេះ រហូតដល់ ស្ទាត់ជំនាញ ។
ដានី បាន រៀបរាប់ ក្នុង បណ្ណ អំពាវនាវ នោះ ទៀត ថា ក្រុម គ្រូពេទ្យ បាន ព្យាបាល ដោយ ប្រើ ថ្នាំ ចាក់ អស់ រយៈពេល បី សប្តាហ៍ មក ហើយ ប៉ុន្តែ ខួរ ឆ្អឹង នៅតែ មិន ដំណើរការ ។ ក្រោយពី ព្យាបាល មួយ រយៈ មក នេះ គ្រូពេទ្យ បាន ផ្តល់ ជម្រើស ព្យាបាល ពីរ យ៉ាង ជូន កញ្ញា គឺ ការបណ្តុះ ខួង ឆ្អឹង និង ប្រើប្រាស់ ថ្នាំ ចាក់ ប្រភេទ ផ្សេង ។ ការព្យាបាល ក្នុង ជម្រើសទី១ មាន ឱកាស ជាសះស្បើយ ៨០ ភាគរយ ខណៈ ជម្រើស ទី២ មាន ឱកាស ជាសះស្បើយ ប្រមាណ ៦០ ភាគរយ ។
បើ តាម បណ្ណ អំពាវនាវ ស្វែងរក ការជួយសង្គ្រោះ កញ្ញា ដានី បាន បញ្ជាក់ ថា ការព្យាបាល ក្នុង ជម្រើស ទាំង ពីរ នេះ ត្រូវ ចំណាយ ថវិកា ប្រមាណ ៥ម៉ឺន ដុល្លារ ។
កញ្ញា ដានី បាន បញ្ជាក់ ថា ទំហំ ទឹកប្រាក់ សម្រាប់ ព្យាបាល ជំងឺ នេះ កញ្ញា និង គ្រួសារ មិន មាន លទ្ធភាព នោះ ឡើយ ។ ដោយសារ ចង់ បន្ត មាន ជីវិត ដើម្បី រស់ រៀន នៅលើ ពិភពលោក នេះ បន្ត ទៀត ដើម្បី បាន តបស្នង សង គុណ អ្នក មាន គុណ និង ធ្វើ សកម្មភាព ក្នុង បុព្វហេតុ វប្បធម៌ នោះ កញ្ញា ដានី បាន ទទូច សុំ ក្តី សណ្តោស ពី សប្បុរស ជន ជួយ បន្ត ជីវិត របស់ កញ្ញា ។
កញ្ញា បាន អំពាវនាវ យ៉ាង ដូច្នេះ « នេះ ប្រហែលជា ក្តីសង្ឃឹម ចុងក្រោយ របស់ នាងខ្ញុំ ហើយ ។ គ្រួសារ នាងខ្ញុំ ពុំ មាន លទ្ធភាព ដើម្បី បន្ត ព្យាបាល ជំងឺ នាងខ្ញុំ ទេ តែ ខ្ញុំ នៅ មាន សង្ឃឹម ថា បងប្អូន មិត្តភក្តិ នឹង អាច ជួយ ចូលរួម តាម លទ្ធភាព ដែល អាច ជួយ បាន ដើម្បីឲ្យ ខ្ញុំ អាច បង្រៀន ដូច ដើម និង ធ្វើ ការងារ ស្ម័គ្រចិត្ត ដើម្បី យុវជន និង សង្គមជាតិ បន្ត ទៀត ។ ខ្ញុំ មិន អាច សរសេរ បាន ច្រើន ទេ ញ័រ ដៃ ណាស់ មាន តែ អរគុណ ទុក ជាមុន សម្រាប់ ទឹកចិត្ត បរិច្ចាគ ជួយ នាងខ្ញុំ » ។
ព្រោះតែ ក្តី អាណិតអាសូរ ចំពោះ កញ្ញា ឆែ ដានី . អ្នកលេង បណ្តាញ សង្គម ជាច្រើន បាន ចែករំលែក នូវ សារ អំពាវនាវ នេះ ជាមួយ ការរំលេច នូវ សារ អាណិតអាសូរ ជាច្រើន ។
( ព្រៃវែង ) ៖ នៅ ព្រឹក ថ្ងៃទី ៩ ខែតុលា ឆ្នាំ ២០១៩ នេះ នគរបាល នៃ អធិការដ្ឋាន ស្រុមពារក៍ ខេត្ត ព្រៃវែង បាន អញ្ជើញ ភាគី រងគ្រោះថ្នាក់ ចរាចរណ៍ កាលពី ថ្ងៃទី ២៤ ខែកញ្ញា នៅ ចំណុច ខាងកើត គល់ ស្ពាន អ្នកលឿង ក្នុង ភូមិ ព្រែក ខ្សាយ ឃុំ ព្រែក ខ្សាយ ( ក) ស្រុក ពាមរក៍ ដើម្បីឲ្យ មក ដោះស្រាយ តែ មិន បាន ទទួល លទ្ធផល អ្វី នោះ ទេ ដោយសារតែ ជន បង្ក មិន មក ចូលរួម គឺ ឲ្យ តែ ក្រុមហ៊ុន កាំ មិន កូ និង តំណាង ដែល មិន ដឹង រឿង មក ដោះស្រាយ ។
សូម បញ្ជាក់ ថា គ្រោះ ចរាចរណ៍ រវាង រថយន្ត ធុន ធំ និង រថយន្ត ស្តារិច នៅ ចំណុច ខាងកើត គល់ ស្ពាន អ្នកលឿង ក្នុង ភូមិ ព្រែក ខ្សាយ ឃុំ ព្រែក ខ្សាយ ( ក) ស្រុក ពាមរក៍ ខេត្ត ព្រៃវែង បាន អូសបន្លាយ ពេល ជាង ១០ ថ្ងៃ មក ហើយ មិន ទាន់ ឃើញ ភាគី ម្ចាង ទៀត ចូលខ្លួន ដោះស្រាយ នោះ ទេ ។ ម្ចាស់ រថយន្ត រងគ្រោះ អំពាវនាវ សមត្ថកិច្ច ជួយ ជំរុញ ក្រុម ធានារ៉ាប់រង CAMINCO ចូលមក បញ្ចប់ រឿង ដែល ទាមទារ សំណង ថ្លៃ ខូចខាត រថយន្ត និង ប៉ះពាល់ ផ្លូវចិត្ត សរុប ៦៨.០០០ ដុល្លារ ។
លោក វាល ចន្ទ័ ដារិទ្ធ បាន បញ្ជាក់ ថា លោក សូម សំណូមពរ ដល់ ម្ចាស់ រថយន្ត បង្កហេតុ ខាង លើ ចូល ខ្លួន មក ដោះស្រាយ នូវ សំណង ដែល ទាមទារ ទី ១៖ ថ្លៃ រថយន្ត ខូចខាត ចំនួន ៤. ៨០០០ ដុល្លារ . ទី ២៖សង ប៉ះពាល់ ផ្លូវចិត្ត មក លើ ក្រុមគ្រួសារ ដែល មាន ការ ភិតភ័យ ចំនួន ទឹកប្រាក់ ២០.០០០ ដុល្លារ អាមេរិក ។
លោក អធិការ បញ្ជាក់ ថា មូលហេតុ ដោយសារ រថយន្ត ធុន ធំ ដឹក ជី បើក បុក ពីក្រោយ រថយន្ត ហ៉ី យិន ដាយ ស្តារិច ចំពោះ គ្រោះថ្នាក់ ខាងលើ មិន បណ្តាលឲ្យ មាន មនុស្ស រងរបួស ទេ រីឯ រថយន្ត ទាំង ពីរ យកមក រក្សាទុក នៅ ប៉ិស្តិ៍ រដ្ឋបាល ឃុំ អ្នកលឿង ដោយ ប៉ុស្តិ៍ រដ្ឋបាល ឃុំ ព្រែក ខ្សាយ ( ក) មាន ភាពចង្អៀត ពេក ៕
អភិបាល ខណ្ឌ ដង្កោ បន្ដ បើក ការដ្ឋាន សាងសង់ ផ្លូវ បេតុង ជូន ពលរដ្ឋ នៅ សង្កាត់ សាក់ សំពៅ និង រៀបចំ ពិសារ នំបញ្ចុក សាមគ្គី
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ នេះ លោក នុត ពុធ ដារ៉ា ជំនួយការ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង ជា អភិបាល ខណ្ឌ ដង្កោ បាន ដឹកនាំ លោក អភិបាល រង មន្ត្រីរាជការ ខណ្ឌ សង្កាត់ ភូមិ ធ្វើ ពិធី បើក ការដ្ឋាន ស្ថាបនា ផ្លូវ បេតុង ០១ ខ្សែ ប្រវែង ៤៥០ ម៉ែត្រ ទទឹង ០៥ម៉ែត្រ ស្ថិត ក្នុង ភូមិ ខ្វិត សង្កាត់ សាក់ សំពៅ និង បាន រៀបចំ ពិធី ពិសា នំបញ្ចុក សាមគ្គី ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ប្រកបដោយ បរិយាកាស រីករាយ និង ស្និទស្នាល យ៉ាង ក្រៃលែង ។
នៅ ចំពោះមុខ ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម ជាច្រើន រយ នាក់ នេះ លោក អភិបាល ខណ្ឌ ដង្កោ បាន គូស រំលេច ពី សមិទ្ធផល ថ្មី មួយ នេះ ទៀត ជា ចំណង ដៃ ជូន បងប្អូន ដើម្បី ងាយស្រួល ធ្វើដំណើរ ។ ជាមួយគ្នា នេះ លោក នុត ពុធ ដារ៉ា ក៏ សុំ ការយោគយល់ ពី បងប្អូន ដែល រស់ នៅ តាម សងខាង ផ្លូវ សូម អធ្យាស្រ័យ ចំពោះ ក្រុមការងារ ជួសជុល ផ្លូវ ផង និង ចូលរួម សហការ ជាមួយ មន្រ្តី ក្រុមការងារ ឲ្យបាន ល្អ ប្រសើរ ដែល ទាំង នេះ ជា ផលប្រយោជន៍ រួម របស់ បងប្អូន នោះ ទេ ។
លោក អភិបាល ខណ្ឌ ក៏ បាន លើកឡើង ទៀត ថា នេះ ក៏ មិន មែន ជា សមិទ្ធផល ចុងក្រោយ សម្រាប់ បងប្អូន នោះ ឡើយ គឺ នៅ មាន បន្ត ទៀត ទាំង នេះ ជា ការចូលរួម ទាំង ផ្ទាល់ និង ប្រយ៉ោល លើ ការកាត់បន្ថយ ភាពក្រីក្រ របស់ ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន ដែល ជា ការចង់បាន របស់ ប្រមុខ រាជ រដ្ឋាភិបាល ៕ រដ្ឋមន្ត្រី ២រូប អបអរសាទរ នារី ឆ្នើម ៥៦ រូប ទទួលបាន ជ័យលាភី ក្នុង វិស័យ ទេសចរណ៍
( ភ្នំពេញ ) ៖ លោក ថោង ខុន រដ្ឋមន្ដ្រី ក្រសួង ទេសចរណ៍ និង លោកស្រី អ៉ឹង កន្ថា ផាវី រដ្ឋមន្រ្តី ក្រសួង កិច្ចការ នារី បាន អបអរសារទរ និង កោតសរសើរ ដល់ នារី ឆ្នើម ៥៦ រូប ក្នុង ឆ្នាំ ២០១៩ នេះ ដែល បាន ខិតខំ ប្រឹងប្រែង ក្នុង ការអភិវឌ្ឍ ខ្លួន ដើម្បី ដណ្តើមយក ជ័យលាភី នារី ឆ្នើម ក្នុង វិស័យ ទេសចរណ៍ ។
ថ្លែង សុន្ទរកថា រួមគ្នា នា ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ នេះ ក្នុង កម្មវិធី សិក្ខាសាលា ចែករំលែក បទពិសោធន៍ នារី ឆ្នើម ផ្នែក ឯកជន ក្នុង វិស័យ ទេសចរណ៍ នៅ គណៈកម្មាធិការ ជាតិ អូឡាំពិក កម្ពុជា រាជធានី ភ្នំពេញ រដ្ឋមន្ត្រី ទាំង ទ្វេ ក៏ បាន ផ្តាំផ្ញើ ដល់ នារី ឆ្នើម ទាំងអស់ ដែល បាន ទទួល ជ័យលាភី សូម បន្ត ខិតខំ អភិវឌ្ឍ ខ្លួន និង ចូលរួម ចែករំលែក បទពិសោធន៍ ភាពជោគជ័យ របស់ ខ្លួន ទៅកាន់ នារី ដទៃ ទៀត ក្នុង ន័យ រួមគ្នា ពង្រឹង សាមគ្គីភាព និង បណ្តាញ នារី ព្រមទាំង បង្កើន ន វានុវត្ត ថ្មី ៗ ក្នុង វិស័យ ទេសចរណ៍ ។
លោក ថោង ខុន បាន រំពឹង ថា សិក្ខាសាលា នេះ នឹង ផ្តល់ ផលប្រយោជន៍ ជាច្រើន ដល់ នារី ឯកជន ក្នុង វិស័យ ទេសចរណ៍ ។
លោក បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ មាន ជំនឿ យ៉ាង មុតមាំ ថា កម្មវិធី សិក្ខាសាលា ចែករំលែក បទពិសោធន៍ នារី ឆ្នើម ផ្នែក ឯកជន ក្នុង វិស យ័ទេសចរណ៍ ថ្ងៃ នេះ នឹង ផ្តល់ ផលប្រយោជន៍ ដល់ បងប្អូន នារី ឯកជន ក្នុង វិស័យ ទេសចរណ៍ តាមរយៈ ការចែករំលែក បទពិសោធន៍ ភាពជោគជ័យ នៃ ការងារ របស់ ខ្លួន ពិសេស រួមចំណែក លើកកម្ពស់ និង ផ្ដល់ គុណ តម្លៃ ចំពោះ ស្រ្តី កំពុង បម្រើការ ក្នុង វិស័យ ទេសចរណ៍ » ។
លោក រដ្ឋមន្ត្រី មាន សុទិ ដិ្ឋ និយម ថា ក្រុម នារី នេះ នឹង ក្លាយទៅជា បណ្តាញ ដ៏ ល្អ សម្រាប់ ទំនាក់ទំនង ចែករំលែក នូវ បទពិសោធន៍ ព័ត៌មាន និង ជួយ អន្តរាគមន៍ ទាន់ ពេលវេលា ក្នុង ករណី ដែល មាន ការរំលោភបំពាន ឬ អំពើហិង្សា កើតឡើង ។ អ្វី ដែល លោក កាន់តែ រំពឹងទុក នោះ គឺ ការផ្តើម ចេញ ពី ក្រុម នារី ឯកជន ដោយ ឈាន ទៅ ចាប់ យក ភាព លេចធ្លោ ជា វិជ្ជមាន ក្នុង នាម ជា « នារី ឆ្នើម » ដែល ប្រកប ទៅ ដោយ គុណ វុឌ្ឍិក្នុង វិជ្ជាជីវៈ និង ជំនាញ ។
លោក បណ្ឌិត ថោង ខុន ក្នុង នាម ក្រសួង ទេសចរណ៍ ក៏ បាន កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រុមការងារ យេនឌ័រ ក្រសួង ទេសចរណ៍ ក្នុង ការចូលរួមចំណែក អភិវឌ្ឍ ធនធាន ស្ត្រី ជាពិសេស ជំរុញ ការលើកកម្ពស់ សិទ្ធិ តួនាទី តម្លៃ ស្រ្ដី និង បង្កើន ភាពអង់អាច ជា កត្តា រួមចំណែក ដ៏ សំខាន់ ដល់ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ កម្ពុជា សំដៅ ធ្វើឱ្យ កម្ពុជា ក្លាយទៅជា គោលដៅ ទេសចរណ៍ ដ៏ ទាក់ទាញ នៅក្នុង តំបន់ ក៏ ដូចជា នៅលើ ឆាក អន្តរជាតិ ។
ជាមួយគ្នា នេះ លោកស្រី អ៉ឹង កន្ថា ផាវី បាន សម្តែង នូវ ការកោតសរសើរ ដល់ ក្រសួង ទេសចរណ៍ ក្នុង ការរៀបចំ កម្មវិធី នេះ ។ លោកស្រី បញ្ជាក់ ថា៖ « នាងខ្ញុំ មាន សេចក្តី សោមនស្ស រីករាយ និង ពេញចិត្ត យ៉ាង ក្រៃលែង ក្នុង ការចូលរួម ក្នុង សិក្ខាសាលា ចែករំលែក បទពិសោធន៍ នារី ឆ្នើម ផ្នែក ឯកជន ក្នុង វិស័យ ទេសចរណ៍ ដែល រៀបចំឡើង ដោយ ក្រសួង ទេសចរណ៍ ក្នុង គោលបំណង ដើម្បី លើកទឹកចិត្ត ដល់ ស្រ្តី ដែល បាន ខិតខំ រួមចំណែក អភិវឌ្ឍ វិស័យ ទេសចរណ៍ ជាតិ ឱ្យ មាន ការរីកចម្រើន ជា បន្តបន្ទាប់ ។
លោកស្រី រដ្ឋមន្ត្រី បាន គាំទ្រ យ៉ាង ពេញ ទំហឹង ដល់ ក្រសួង ទេសចរណ៍ ដែល បាន ផ្តួចផ្តើម គំនិត និង រៀបចំ ឱ្យ មាន កាិរ ចងក្រង បណ្តាញ នារី ក្នុង វិស័យ ទេសចរណ៍ ដែល បណ្តាញ នេះ ពិតជា មាន សារៈសំខាន់ សម្រាប់ ការចែករំលែក ចំណេះដឹង បទពិសោធន៍ និង ការផ្តល់ ប្រឹក្សា យោបល់ ឱ្យ គ្នា ទៅ វិញ ទៅមក ក្នុង ន័យ កសាង និង អភិវឌ្ឍន៍ សមត្ថភាព របស់ ស្រ្តី ដើម្បី ទទួលបាន ភាពជោគជ័យ ក្នុង ឧស្សាហកម្ម មួយ នេះ ៕
មន្រ្តី កាំ កុងត្រូល ខេត្ត ពោធិ៍សាត់ បន្ត ចុះ អង្កេត ទំនិញ នៅ ផ្សារ មេ ទឹក ស្រុក បាកាន
( ពោធិ៍សាត់ ) ៖ ថ្ងៃទី ០៩ ខែតុលា ឆ្នាំ ២០១៩ នេះ មន្រ្តី សាខា កាំ កុងត្រូល ខេត្ត ពោធិ៍សាត់ បាន សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង អាជ្ញាធរដែនដី បាន ចុះ ផ្សព្វផ្សាយ អប់រំ និង ត្រួតពិនិត្យ ទំនិញ ម្ហូប អាហារ ដែល ដាក់តាំង លក់ នៅ ផ្សារ មេ ទឹក និង តូប លក់ ចាប់ ហួយ នានា នៅក្នុង ភូមិ ចិន តាយ និង ភូមិ មេ ទឹក ឃុំ មេ ទឹក ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ ។
លោក តូច ចៅ កុយ ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត ពោធិ៍សាត់ បាន ប្រាប់ ភ្នាក់ងារ Fresh News ឲ្យដឹង ថា ក្នុង ការត្រួតពិនិត្យ មន្រ្តី ជំនាញ បាន រកឃើញ ទំនិញ ខូច គុណភាព ហួស ថ្ងៃ កំណត់ ប្រើប្រាស់ ដោយ បាន ធ្វើ កំណត់ហេតុ ដកហូត ទំនិញ ចំនួន ០៦មុខ សរុប ១៩៩.៣គីឡូក្រាម យក ទៅ ដុត កំទេចចោល នៅ ចំពោះមុខ សមត្ថកិច្ច និង ម្ចាស់ ទំនិញ ផ្ទាល់ ។
