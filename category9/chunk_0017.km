( ភ្នំពេញ ) ៖ ណាហ្គាវើលដ៍ បេះដូង សប្បុរស ដែល ជា ក្រុមការងារ សង្គម របស់ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ កំពុង ធ្វើ ការសហការ ជាមួយ អង្គការ « ធីន ឆាឡេន » កម្ពុជា ដើម្បី ជួយ ដល់ យុវជន - យុវនារី និង សហគមន៍ រងគ្រោះ ឲ្យ កសាង ជីវិត របស់ ពួកគេ ឡើងវិញ តាមរយៈ ការឧបត្ថម្ភ រយៈពេល មួយ ឆ្នាំ របស់ ក្រុមហ៊ុន ណាហ្គាវើលដ៍ ។ នេះ បើ តាម សេចក្ដីប្រកាស ព័ត៌មាន ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
ការឧបត្ថម្ភ របស់ ណាហ្គាវើលដ៍ បេះដូង សប្បុរស នឹង ផ្តោត ទៅ លើ ការមើល ថែ សុខភាព ការផ្តល់ ប្រឹក្សា កម្មវិធី អក្ខរកម្ម និង ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ដូចជា ជំនាញ កាត់ដេរ បច្ចេកទេស ធ្វើ អេកូ - កសិកម្ម និង ជំនាញ ជួសជុល ម៉ូតូ ជាដើម ។
ជា ផ្នែក មួយ នៃ ការងារ ទំនួល ខុសត្រូវ ឆ្ពោះ ទៅរក ការកសាង ប្រទេសជាតិ ប្រកបដោយ និរន្តរភាព ណាហ្គាវើលដ៍ បេះដូង សប្បុរស តែងតែ ចុះ ទៅតាម សហគមន៍ យ៉ាង ទៀងទាត់ ដោយ ផ្តោត ទៅ លើ ការលើកកម្ពស់ វិស័យ អប់រំ ការចូល ជិត សហគមន៍ ការអភិវឌ្ឍ វិស័យ កីឡា និង ការគាំពារ បរិស្ថាន ដែល បាន ផ្តល់ ផលប្រយោជន៍ ដល់ ប្រជាជន កម្ពុជា ដែល ជួប ការលំបាក ជាង ២០៤.០០០ នាក់ គិត មកដល់ បច្ចុប្បន្ន ៕
ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង និង គណៈកម្មការ មូលបត្រ កម្ពុជា បន្ដ រៀបចំ សិក្ខាសាលា ស្ដីពី យុទ្ធសាស្រ្ត សម្រាប់ ការវិនិយោគ ជោគជ័យ ក្នុង ខេត្ត កំពត
( កំពត ) ៖ ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង និង គណៈកម្មការ មូលបត្រ កម្ពុជា បាន បន្ដ សហការរៀបចំ សិក្ខាសាលា បង្កើន ចំណេះដឹង ទាក់ទង នឹង ការវិនិយោគ ការកាត់បន្ថយ ហានិភ័យ នៃ ការវិនិយោគ និន្នាការ នៃ ការវិនិយោគ និង យុទ្ធសាស្រ្ត សម្រាប់ ការវិនិយោគ ជោគជ័យ នៅ ខេត្ត កំពត ប្រកបដោយ ជោគជ័យ ។
សិក្ខាសាលា នេះ ជា សមិទ្ធិផល ថ្មី មួយ ទៀត បន្ថែម ទៅ លើ សិក្ខាសាលា របស់ ស្ថាប័ន ទាំង ពីរ នៅ ខេត្ត ចំនួន ៦រួច មកហើយ រួម មាន៖ ខេត្ត ព្រះសីហនុ ខេត្ត កំពង់ចាម ខេត្ត បន្ទាយមានជ័យ ខេត្ត បាត់ដំបង ខេត្ត សៀមរាប និង ខេត្ត តាកែវ ។ ជាក់ស្ដែង សិក្ខាសាលា នៅ ខេត្ត កំពត នេះ បាន ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ ក្នុង គោលបំណង បង្កើន ចំណេះដឹង ទាក់ទង នឹង ការវិនិយោគ ការកាត់បន្ថយ ហានិភ័យ នៃ ការវិនិយោគ និន្នាការ នៃ ការវិនិយោគ និង យុទ្ធសាស្រ្ត សម្រាប់ ការវិនិយោគ ជោគជ័យ ។
សិក្ខាសាលា នេះ រៀបចំឡើង ក្រោម ការចូលរួម ពី លោក សុខ ដារ៉ា អគ្គ នាយក រង នៃ គណៈកម្មការ មូលបត្រ កម្ពុជា ។ លោក សុខ ដារ៉ា បាន បញ្ជាក់ ពី បេសកកម្ម របស់ គណៈកម្មការ មូលបត្រ កម្ពុជា ក្នុង ការពង្រឹង បទបញ្ញត្តិ សម្រាប់ ទីផ្សារ ឧបករណ៍ និស្សន្ទ នៅ កម្ពុជា និង បាន លើកទឹកចិត្ត ឱ្យ វិនិយោគិន បង្កើន ចំណេះដឹង ត្រៀមខ្លួន រួចរាល់ ក៏ ដូចជា ជ្រើសរើស ក្រុមហ៊ុន ដែល ទទួលបាន អាជ្ញាបណ្ណ ពី គណៈកម្មការ មូលបត្រ កម្ពុជា ដើម្បី បញ្ចៀស ហានិភ័យ ។
លោក ក៏ បាន សរសើរ ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង ថា ជា ក្រុមហ៊ុន ឈាន មុខ និង តែងតែ មាន ភាព សកម្ម ក្នុង ការលើកកម្ពស់ ស្ដង់ដារ នៃ ការជួញដូរ ឧបករណ៍ និស្សន្ទ និង អនុវត្ត តាម បទប្បញ្ញាតិ និង កិច្ច គាំពារ វិនិយោគិន ។
លោក បាន បន្ដ ថា ចាប់តាំងពី មាន វត្តមាន នៃ សិក្ខាសាលា តាម បណ្ដា ខេត្ត ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង ជា ក្រុមហ៊ុន សមភាគី កណ្តាល តែ មួយ គត់ ដែល ជា ដៃគូ សហការ របស់ គណៈកម្មការ មូលបត្រ កម្ពុជា ក្នុង ការរៀបចំ ព្រឹត្តិការណ៍ មួយ នេះ ។
ក្រុមហ៊ុន ក៏ បាន អនុញ្ញាតឱ្យ ក្រុមហ៊ុន ឈ្មួញ ជើង សា ឧបករណ៍ និស្សន្ទ ឆ្នើម របស់ ខ្លួន ចូលរួម ផងដែរ ។ ក្រៅពី ការផ្ដល់ ចំណេះ ជំនាញ ក្នុង ការវិនិយោគ ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង បាន បង្ហាញ នូវ ឱកាស វិនិយោគ ផ្សេង ៗ ទៅកាន់ សាធារណៈ ជន ជាពិសេស វិនិយោគិន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
ក្រសួង សង្គមកិច្ច ចុះ MoU ជាមួយ អង្គការ ចំនួន ២ ដើម្បី ជួយ កុមារ រងគ្រោះ ដោយសារ ការ រំលោភបំពាន ផ្លូវភេទ និង ជួញដូរ កុមារ
( ភ្នំពេញ ) ៖ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ចុះហត្ថលេខា លើ អនុស្សារណៈ នៃ កិច្ចព្រមព្រៀង (MoU) ជាមួយ អង្គការ ចំនួន ២ ដើម្បី ជួយ ក្នុង វិស័យ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ដោយ ផ្តោត សំខាន់ លើ ការជួយ ការពារ ជនរងគ្រោះ ពី ការជួញដូរ មនុស្ស ករណី កេងប្រវ័ញ្ច លើ កុមារ ការរំលោភបំពាន ផ្លូវភេទ ការជួញដូរ ផ្លូវ ភេទ និង ការជួញដូរ កម្លាំង ពលកម្ម ជាដើម ។ អង្គការ ទាំង២ នោះ រួម មាន ៖១៖ អង្គការ ដៃ កម្ពុជា (ARM) . ២៖ មូលនិធិ អេ២១ (A ២១) ។
ពិធី ចុះហត្ថលេខា នៃ កិច្ចព្រមព្រៀង (MoU) នា ពេលនេះ បាន រៀបចំឡើង ជា ផ្លូវការ នា ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៩ ដោយ មាន ការចូលរួម ពី លោក តូច ចាន់ នី អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន បច្ចេកទេស ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង មាន ការរួម ពី ថ្នាក់ដឹកនាំ អង្គការ ទាំង ២ រួម នឹង មន្រ្តី រាជការ ពាក់ព័ន្ធ របស់ ក្រសួង សង្គមកិច្ច ជាច្រើន រូប ទៀត ផងដែរ ។
បន្ថែម ពីលើ នោះ លោក តូច ចាន់ នី បាន ស្នើឲ្យ ក្រុមការងារ ក្រសួង និង អង្គការ ដែល សហការ នា ពេលនេះ រួមគ្នា ដើម្បី ធ្វើ ការងារ ដោយ យកចិត្តទុកដាក់ ឲ្យ ខ្លាំង បំផុត តាម ដែល អាច ធ្វើ បាន ។ សម្រាប់ ក្រសួង ស. អ. យ វិញ នៅតែ ស្វាគមន៍ ជានិច្ច ជាមួយ ដៃគូ ពាក់ព័ន្ធ និង អង្គការ នានា ដើម្បី ជួយ ដល់ ជនរងគ្រោះ នៅ កម្ពុជា ឲ្យ មាន ជីវភាព និង ជីវិត រស់ នៅ ល្អ ប្រសើរ ថែម មួយ កម្រិត ទៀត ។
គួរ បញ្ជាក់ ថា អង្គការ ទាំង២ ដែល បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ជាមួយ ក្រសួង សង្គមកិច្ច នា ពេលនេះ សុទ្ធសឹងតែ ជា អង្គការ ដែល បាន ចូលរួមចំណែក ជួយ ការពារ ជនរងគ្រោះ ពី ការជួញដូរ មនុស្ស ករណី កេងប្រវ័ញ្ច លើ កុមារ ការរំលោភបំពាន ផ្លូវភេទ ការជួញដូរ ផ្លូវ ភេទ និង ការជួញដូរ កម្លាំង ពលកម្ម ៕
បច្ចុប្បន្ន សព តម្កល់ ធ្វើ បុណ្យ នៅ គេហដ្ឋាន ផ្ទះ លេខ ៤៦៤ ផ្លូវ ៣៩០ សង្កាត់ បឹងកេងកង៣ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ ។
ដំណឹង នេះ ចាត់ទុក ជា ការអញ្ជើញ លោក លោកស្រី ដែល ស្គាល់ លោក មាស ហួន ចូលរួម បុណ្យ សព ដែល កំពុង ប្រារព្ធ ធ្វើ បុណ្យ តាម ប្រពៃណី ៕
តំណាង នាយ ឧត្តមសេនីយ៍ សៅ សុខា នាំយក ថវិកា ៣០ លាន រៀល ប្រគល់ ជូន ក្រុមគ្រួសារ អាវុធហត្ថ ដែល ទើបតែ ទទួលមរណភាព ដោយ គ្រោះថ្នាក់ ចរាចរណ៍
លោក ឧត្តមសេនីយ៍ ទោ ឌៀប វណ្ឌី ក៏ បាន ធ្វើ ការពាំនាំ នូវ ប្រសាសន៍ សួរសុខទុក្ខ និង ចូលរួម រំលែក ទុក្ខ របស់ លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា ទៅដល់ ក្រុមគ្រួសារ សព និង បាន សម្តែង នូវ ការសោកស្តាយ យ៉ាង ក្រៀមក្រំ បំផុត ចំពោះ ការបាត់បង់ សមាជិក ដ៏ ល្អ មួយ រូប នេះ ចេញ ពី ជួរ អង្គភាព កងរាជអាវុធហត្ថ ។
លោក វរសេនីយ៍ ត្រី ម៉ាន់ ដាវីត បាន ឲ្យដឹង ដែរ ថា ជានិច្ច ជាកាល លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា តែងតែ យកចិត្ត ទុក្ខ ដាក់ ទៅដល់ បុគ្គលិក របស់ កងរាជអាវុធហត្ថ ទូទាំង ប្រទេស ទាំងអស់ តាំងពី ការហូបចុក ស្លៀកពាក់ ស្នាក់ នៅ រៀនសូត្រ និង ការថែទាំ សុខភាព ជាពិសេស នូវ ពេល ដែល បងប្អូន កំពុង ជួប នូវ ទុក្ខលំបាក ដូចជា ពេលនេះ ជាដើម ។
តំណាង ក្រុមគ្រួសារ សព លោក ព្រិន្ទ បាល ឯក ស៊ឹម បញ្ញា ក៏ បាន ធ្វើការ ថ្លែងអំណរគុណ ជូន ទៅដល់ ក្រុមការងារ ជាពិសេស គឺ លោក នាយ ឧត្តមសេនីយ៍ សៅ សុខា ដែល ជា ប្រធាន អង្គភាព ដ៏ គំរូ ដែល តែងតែ យកចិត្តទុកដាក់ និង ជួយ ទៅដល់ ក្រុមគ្រួសារ បុគ្គលិក កងរាជអាវុធហត្ថ ទាំងអស់ នូវ ពេល ដែល កំពុង ជួប ទុក្ខលំបាក ដូចជា រូបលោក ផ្ទាល់ ផងដែរ ៕ ប្រាសាក់ ចូលរួម ឧបត្ថម្ភ កម្មវិធី « ទិវា បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ កម្ពុជា » ឆ្នាំ ២០១៩
គោលបំណង នៃ ព្រឹត្តិការណ៍ ដ៏ មាន សារៈសំខាន់ នេះ គឺ ដើម្បី បង្កើន ការយល់ដឹង និង ផ្លាស់ប្ដូរ ព័ត៌មាន គ្នា អំពី និន្នាការ ទីផ្សារ និង ការវិវឌ្ឍ រីកចម្រើន នៃ វិស័យ បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ (FinTech) ក៏ ដូចជា បញ្ហា បទប្បញ្ញត្តិ ដែល ទាក់ទិន នឹង សេវា ហិរញ្ញវត្ថុ នៅក្នុង ប្រទេស កម្ពុជា និង នៅក្នុង តំបន់ ។
កម្មវិធី នេះ មាន អ្នកចូលរួម ប្រមាណ ៥០០ នាក់ ដែល ជា តំណាង ពី មន្ត្រី រដ្ឋាភិបាល អ្នកធ្វើ គោល នយោបាយ និយ័តករ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មជ្ឈដ្ឋាន បណ្ឌិត បញ្ញវន្ត ព្រមទាំង ក្រុមហ៊ុន បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ ផងដែរ ។ សូម បញ្ជាក់ ថា FinTech ឬ បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ ជា កម្មវិធី កុំព្យូទ័រ កម្មវិធី តាម ទូរស័ព្ទ (app) ឬ ដំណោះស្រាយ ផ្នែក បច្ចេកវិទ្យា នានា ដែល ត្រូវបាន ប្រើប្រាស់ ដើម្បី ជា ជំនួយ ឬ ផ្ដល់ ដំណោះស្រាយ ហិរញ្ញវត្ថុ ។
លោក សាយ សូនី បាន បញ្ជាក់ ថា បច្ចេកវិទ្យា ទាំងនេះ បាន ជួយ បង្កើន ប្រសិទ្ធភាព សុវត្ថិភាព និង តម្លាភាព នៃ សេវា ហិរញ្ញវត្ថុ ដោយ បាន កាត់បន្ថយ ចំណាយ និង បង្កើន លទ្ធភាព កាន់តែ ច្រើន ឲ្យ ប្រជាជន ទទួល បាន សេវា ហិរញ្ញវត្ថុ ។ បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ បាន ជួយ ធ្វើឱ្យ វិស័យ ហិរញ្ញវត្ថុ មាន ការរីកចម្រើន យ៉ាង ខ្លាំង ដែល រួមចំណែក ក្នុង ការកាត់បន្ថយ ភាពក្រីក្រ និង លើក កំពស់ បរិយាប័ន្ន ហិរញ្ញវត្ថុ ។
លោក សូនី បន្ថែម ទៀត ថា « បច្ចុប្បន្ន នេះ យើង មាន អតិថិជន ជាង ៤១០ ពាន់ នាក់ ដែល ពួកគាត់ អាច ប្រើប្រាស់ សេវា ហិរញ្ញវត្ថុ ប្រាសាក់ ដែល រួម មាន សេវា ឥណទាន បញ្ញើ សន្សំ ទូទាត់ វិក្កយបត្រ ផ្ទេរ ប្រាក់ ប្តូរ ប្រាក់ តាមរយៈ ការិយាល័យ ទាំង ១៨០ សាខា អេធី អឹម និង សេវា ធនាគារ ចល័ត យ៉ាង ងាយស្រួល » ។
សូម ជម្រាប ថា ក្នុង រយៈពេល ៦ខែ ដើម ឆ្នាំ ២០១៩នេះ ប្រាសាក់ មាន ទ្រព្យសកម្ម សរុប ច្រើន ជាង ២. ៨០០លាន ដុល្លារ អាមេរិក សម្ពៀត ឥណទាន ច្រើន ជាង ២. ៣៧០លាន ដុល្លារ អាមេរិក បណ្តាញ ការិយាល័យ និង ម៉ាស៊ីន អេធី អឹម ទូទាំង ប្រទេស សេវា ហិរញ្ញវត្ថុ ឌីជីថល ដែល ស្រប តាម តម្រូវការ អតិថិជន និង បុគ្គលិក ជិត ៨. ២០០ នាក់ ព្រមទាំង បាន ផ្តល់ អគារ បណ្ណាល័យ ចំនួន ៤០ នៅ តាម បណ្តា ខេត្ត នានា នៅ កម្ពុជា ៕
ករណី នេះ ជនសង្ស័យ បាន សារភាព ថា កើតឡើង ដោយសារ ជនរងគ្រោះ បាន ទំនាក់ទំនង ជនសង្ស័យ ដើម្បី ប្តូរ ប្រាក់ ចិន ជា ប្រាក់ ដុល្លារ អាមេរិក ចំនួន ៧០.០០០ ដុល្លារ លុះ នៅ ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០១៩ ជនរងគ្រោះ បាន ទៅ ហាង ប្តូរ ប្រាក់ របស់ ជនសង្ស័យ ដែល មាន ស្លាក យីហោ ប្តូរ ប្រាក់ ជាំង ស៊ូ ស្ថិត នៅ ក្រុម ទី១៤ ភូមិ ៤ សង្កាត់ ៤ ក្រុង ព្រះសីហនុ បន្ទាប់ពី ជនរងគ្រោះ បាន វេប្រាក់ ទៅឲ្យ ជនសង្ស័យ រួចរាល់ ហើយ ក៏ ត្រូវ ជនសង្ស័យ ប្រើ កាំបិត កាប់ និង ចាក់ សម្លាប់ ជនរងគ្រោះ តែម្តង ។
នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អញ្ជើញ សួរសុខទុក្ខ ស្នងការ ខេត្ត ព្រះសីហនុ ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅពេទ្យ កាល់ម៉ែត
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ ដែល កំពុង សម្រាក ព្យាបាល ជំងឺ នៅ មន្ទីរពេទ្យ កាល់ម៉ែត ។
ថ្លែង ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន បាន ផ្ដាំផ្ញើ ដល់ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ត្រូវ ខិតខំ ប្រឹងប្រែង ថែរក្សា សុខភាព ដើម្បី មាន សុខភាព ល្អ ឡើងវិញ នឹង បាន ទៅ បំពេញ ការងារ ដឹកនាំ បញ្ជា កងកម្លាំង នគរបាល ខេត្ដ ព្រះសីហនុ ។
បន្ថែម ពី នេះ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត អគ្គ ស្នងការ នគរបាល ជាតិ ក៏ បាន ផ្ដាំផ្ញើ ដល់ លោកគ្រូ អ្នកគ្រូពេទ្យ ត្រូវ យកចិត្តទុកដាក់ មើល ថែ អ្នកជំងឺ ទូទៅ ឲ្យបាន ល្អ ។
ជាមួយគ្នា នេះ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ថ្លែងអំណរគុណ ជូន ចំពោះ នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ ដែល បាន គិតគូ យកចិត្ត ទុក្ខ ដាក់ ពី សុខ ទុក្ខ មន្រ្តី ក្រោម ឱវាទ ជាពិសេស បាន ឧបត្ថម ថវិកា សម្រាប់ ជួយ ព្យាបាល ដល់ រូបលោក ផងដែរ ៕ ករណី ផ្ទុះ បាតុកម្ម ប្រឆាំង រដ្ឋាភិបាល អ៊ីរ៉ាក់ កាន់តែ ធ្ងន់ធ្ងរ និង អាច ឈានដល់ រដ្ឋប្រហារ ...
( បាកដាដ) ៖ គណកម្មាការ ជាន់ ខ្ពស់ អ៊ីរ៉ាក់ សម្រាប់ សិទ្ធិ មនុស្ស បាន ឱ្យដឹង ថា មនុស្ស យ៉ាងហោចណាស់ ១៩ នាក់ បាន ស្លាប់ . ១. ០៤១ នាក់ រងរបួស និង ៦២ នាក់ ផ្សេង ទៀត ត្រូវបាន ចាប់ខ្លួន នៅក្នុង បាតុកម្ម តវ៉ា ដ៏ ហិង្សា ចាប់តាំងពី ថ្ងៃអង្គារ មក ។ នេះ បើ តាម ការដកស្រង់ ចេញផ្សាយ ដោយ សារព័ត៌មាន Sputnik នៅ ព្រឹក ថ្ងៃសុក្រ ទី ០៤ ខែតុលា ឆ្នាំ ២០១៩ ។
បាតុកម្ម តវ៉ា នៅក្នុង ប្រទេស អ៊ីរ៉ាក់ បាន ផ្ទុះឡើង តាំងតែពី ថ្ងៃអង្គារ មក ម្ល៉េះ ហើយ បច្ចុប្បន្ន នេះ បាន និង កំពុង រីករាលដាល កាន់តែ កាន់ ខ្លាំង នៅក្នុង រដ្ឋធានី បាកដាដ ជា ទី ដែល បាតុករ ជាង ៤.០០០ នាក់ នាំគ្នា ធ្វើ បាតុកម្ម ប្រឆាំង នឹង រដ្ឋាភិបាល របស់ នាយក រដ្ឋមន្ត្រី អ៊ីរ៉ាក់ លោក អាឌែល អាប់ឌុល ម៉ាហ៍ ឌី (Adel Abdul Mahdi) ។ ក្រុម បាតុករ ទាំង នេះ នាំគ្នា ធ្វើ បាតុកម្ម តវ៉ា ដើម្បី សម្ដែង ការខឹងសម្បារ នឹង អំពើពុករលួយ . វិបត្តិ គ្មាន ការងារ ធ្វើ ព្រមទាំង ទាមទារ ជីវិត រស់ នៅ តាម បែប ស្ដង់ដារ សមរម្យ ។
ជុំវិញ វិបត្តិ ខាង នេះ ដែរ ក្រុម អ្នកជំនាញ ជាច្រើន ដូចជា លោក ការីម វ៉ាសហ្វី (Karim Wasfi) បាន វាយតម្លៃ ថា រដ្ឋប្រហារ អាចនឹង ផ្ទុះឡើង នៅក្នុង ប្រទេស អ៊ីរ៉ាក់ បើសិនជា រដ្ឋាភិបាល មិន ព្រម ឬ មិន អាច ដោះស្រាយ បញ្ហា ហើយ នៅតែ បន្ត ការគាបសង្កត់ ឬ ប្រើ ហិង្សា កាន់តែ ខ្លាំង លើ ក្រុម បាតុករ ។
អគ្គ នាយកដ្ឋាន ពន្ធដារ និង បេឡា ជាតិ របប សន្តិសុខ សង្គម ប្រកាស ជ្រើសរើស បុគ្គលិក ជាប់ កិច្ចសន្យា សរុប ជិត ៤០០ នាក់
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង បេឡា ជាតិ របប សន្តិសុខ សង្គម ( ប.ស.ស ) នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ចេញ សេចក្តីជូនដំណឹង ប្រកាស ជ្រើសរើស បុគ្គលិក ជាប់ កិច្ចសន្យា ក្នុង នោះ អគ្គ នាយកដ្ឋាន ពន្ធដារ ត្រូវការ ជ្រើសរើស ៦៨ នាក់ និង បសស ត្រូវ ជ្រើសរើស ២៣១ នាក់ ៕
សូម អាន សេចក្តីជូនដំណឹង ទាំង ស្រុង៖ សម្តេច តេជោ ហ៊ុន សែន និង គណៈប្រតិភូ ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល បាន អញ្ជើញ ទៅដល់ ទីក្រុង ហាណូយ ប្រកបដោយ សុវត្ថិភាព (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង គណៈប្រតិភូ ជាន់ ខ្ពស់ រាជ រដ្ឋាភិបាល បាន អញ្ជើញ ទៅដល់ ទីក្រុង ហាណូយ ប្រកបដោយ សុវត្ថិភាព និង បាន ចាប់ផ្តើម ដំណើរ បំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ប្រទេស វៀតណាម នៅ ព្រឹក ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០១៩ នេះ ។
យន្តហោះ ពិសេស របស់ ព្រះរាជាណាចក្រ កម្ពុជា ជើងហោះហើរ លេខ ០០១ បាន ធ្វើ ការចុះចត នៅ អាកាសយានដ្ឋាន អន្តរជាតិ ណូយ បៃ រដ្ឋធានី ហាណូយ ប្រកបដោយ សុវត្តិភាព នៅ ម៉ោង ៨៖៤០ នាទី ព្រឹក ក្រោម វត្តមាន នៃ ការទទួល បដិសណ្ឋារកិច្ច ស្វាគមន៍ យ៉ាង ស្និទ្ធស្នាល រាក់ទាក់ ពីសំណាក់ ថ្នាក់ ដឹកនាំ ជាន់ ខ្ពស់ រដ្ឋាភិបាល វៀតណាម ជាច្រើន រូប ។ ការបំពេញ ទស្សនកិច្ច ផ្លូវការ នេះ ធ្វើឡើង តប តាម ការអញ្ជើញ របស់ លោក ង្វៀន សួន ហ្វ៊ុក (Nguyen Xuan Phuc) នាយក រដ្ឋមន្ត្រី វៀតណាម ។
លោក ដូណាល់ ត្រាំ ធ្វើការកត់សម្គាល់ បែប នេះ គឺជា ប្រតិកម្ម ជា លើក ដំបូង បន្ទាប់ពី កូរ៉េ ខាងជើង អះអាង ថា ខ្លួន បាន បាញ់ សាកល្បង ដោយ ជោគជ័យ នូវ ប្រភេទ មីស៊ីល បាញ់ ចេញ ពី នាវា មុជទឹក មួយ គ្រាប់ កាលពី ថ្ងៃពុធ កន្លងទៅ ។ ថ្លែង នៅ ចំពោះមុខ អ្នកសារព័ត៌មាន នៅឯ សេតវិមាន នៅ ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ ( ម៉ោង នៅ វ៉ាស៊ីនតោន ) លោក ត្រាំ បាន លើកឡើង ដូច្នេះ ថា៖ « ពួកគេ ( កូរ៉េ ខាងជើង ) ចង់ ជួប ចរចា ដូច្នេះ យើង នឹង ជួប ចរចា ជាមួយ ពួកគេ ហើយ យើង នឹង បាន ឃើញ ថា នឹង មាន អ្វី កើតឡើង » ។
គួរ ជម្រាប ថា កូរ៉េ ខាងជើង កាលពី ថ្ងៃពុធ កន្លងទៅ បាន បាញ់ សាកល្បង មីស៊ីល បាលិស្ទី គ មួយ គ្រាប់ ចេញ ពី នាវា មុជទឹក ។ ប៉ុន្តែ ប៉ុន្មាន ម៉ោង ក្រោយ ប្រាប់ ទីក្រុង ព្យុងយ៉ាង ឱ្យ ឈប់ បង្ក រឿង សហរដ្ឋ អាមេរិក ក៏ បាន បាញ់ សាកល្បង ដោយ ជោគជ័យ នូវ មីស៊ីល បាលិស្ទីគ អន្តរ ទ្វីប ផងដែរ ៕
ព្រះរាជ សារ ព្រះមហាក្សត្រ ក្នុង ឱកាស បើក សម័យ ប្រជុំ រដ្ឋសភា លើក ទី៣ នីតិកាល ទី ០៦
( ភ្នំពេញ ) ៖ នៅក្នុង ឱកាស បើក សម័យ ប្រជុំ លើក នេះ ព្រះមហាក្សត្រ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ប្រទាន ព្រះរាជ សារ មួយ ច្បាប់ ជូន ដល់ រដ្ឋសភា ។
សម័យ ប្រជុំ រដ្ឋសភា នៅ ព្រឹក ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា ដោយ មាន សមាជិក រដ្ឋសភា ចូលរួម ចំនួន ១០៧ រូប ក្នុង នោះ របៀបវារៈ ៧ ផងដែរ ៕
ខាងក្រោម នេះ ជា ព្រះរាជ សារ ទាំងស្រុង របស់ ព្រះមហាក្សត្រ៖ ក្រសួង ធនធាន ទឹក បញ្ជាក់ ស្ថានភាព កំពស់ ទឹក នៅ តាម ស្ថានីយ ជលសាស្ត្រ នានា ប្រចាំ ថ្ងៃទី ០៤ ខែតុលា នេះ !
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ០៤ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
កុំ ប្រើប្រាស់ ទូរស័ព្ទ ដៃ នៅពេល បើកបរ ! ស្លាប់ ២នាក់ និង របួស ១នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស នៅ ថ្ងៃទី ០៣ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ២នាក់ និង របួស ធ្ងន់ ១នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង៣លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១ គ្រឿង . រថយន្ត តូច ២គ្រឿង . រថយន្ដ ធំ១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន ប្រកាន់ ស្ដាំ . ប្រជែង . និង មិន គោរព សិទ្ធ ។
សូម បញ្ជាក់ ថា រយៈពេល ០៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ២១ លើក . បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ចំនួន ១៧នាក់ របួស ធ្ងន់ ៤៩ នាក់ និង របួស ស្រាល ៣៩ នាក់ ៕
ជន ដៃ ដល់ ដែល ត្រូវ គេ អះអាង ថា ជា បុគ្គលិក បម្រើ ការងារ ផ្នែក រដ្ឋបាល នៅក្នុង ទីស្នាក់ការ ប៉ូលិស នោះ ផ្ទាល់ ត្រូវបាន កម្លាំង ប៉ូលិស បារាំង បាញ់ សម្លាប់ ភ្លាម ៗ ផងដែរ ។ យ៉ាងណាមិញ ពុំ ទាន់ មាន ការបញ្ជាក់ ច្បាស់ ពី ចេតនា នៅ ពីក្រោយ សកម្មភាព វាយប្រហារ នេះ នៅឡើយ ទេ ។ ជា បឋម ក្រុម អ្នក ស៊ើបអង្កេត បាន ដាក់ ការសង្ស័យ ថា ករណី នេះ បង្កឡើង ដោយ ជម្លោះ កន្លែង ការងារ ជាជាង ទង្វើ ភេរវកម្ម ។
សូម ជម្រាប ថា នៅ ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០១៩ ខាងមុខ នេះ គឺជា ព្រះរាជ ពិធី បុណ្យ ខួប លើក ទី ១៥ នៃ ការយាង គ្រង ព្រះបរម សិរី រាជសម្បត្តិ របស់ ព្រះមហាក្សត្រ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះបរម នាថ នរោត្តម សីហមុនី ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ ស្ថានការណ៍ ទូទាំង សកលលោក និង រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ផ្សេង ៗ ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ កូរ៉េ ខាងជើង ប្រកាស ពី ការធ្វើតេស្ត មីស៊ីល ផ្លោង ចេញ ពី នាវា មុជទឹក ទទួលបាន ជោគជ័យ ជាថ្មី ទៀត ។
២៖ អ្នកវិទ្យាសាស្រ្ត អូស្រ្តាលី ស្រាវជ្រាវ ឃើញ ថា កាឡាក់ស៊ី Andromeda ដែល នៅក្បែរ យើង ធ្លាប់ មាន ប្រវត្តិ លេប ត្របាក់ កាឡាក់ស៊ីដទៃ ។
៣៖ ធ្លាក់ យន្តហោះ ទម្លាក់ គ្រាប់បែក ស៊េរី ចាស់ នៅ អាមេរិក បណ្តាលឲ្យ មនុស្ស ៧នាក់ ស្លាប់ ។
៤៖ ប្រជាជន ឥណ្ឌា នាំគ្នា ប្រមូល សំរាម ផ្លាស្ទិក កំឡុង ព្រឹត្តិការណ៍ មួយ សំដៅ លើកកម្ពស់ ការគាំពារ បរិស្ថាន ។
៦៖ រកឃើញ សាកសព មនុស្ស ៦នាក់ ក្នុង ករណី បាក់ ស្ពាន នៅ តៃវ៉ាន់ កាលពី ថ្ងៃអង្គារ ។
៧៖ ហុងកុង នឹង លែង ឲ្យបាតុករ ពាក់ ម៉ាស់ ធ្វើ បាតុកម្ម ខណៈ អំពើហិង្សា កាន់តែ ក្តៅ គគុក ឡើង ៗ ។
៤៖ អតីត និស្សិត ខ្មែរ ម្នាក់ ទៀត ដែល បញ្ចប់ ការសិក្សា នៅ សាលា យោធា ចិន ចេញមុខ ខឹងសម្បា នឹង លោក សម រង្ស៉ី ដែល ប្រមាថ សញ្ញាបត្រ លោក ហ៊ុន ម៉ាណែត ( ចុច អាន )
៧៖ ព័ត៌មាន លម្អិត៖ ជន ដៃ ដល់ ដែល បាញ់ សម្លាប់ ជនរងគ្រោះ នៅ ក្រុង បាន លុង គឺជា មិត្តភ័ក្តិ នឹង គ្នា ហើយក៏ ជា មន្ដ្រី នគរបាល ដូចគ្នា . ផ្ដើម ចេញ ពី គំនុំ ផ្ទាល់ខ្លួន ( ចុច អាន )
៩៖ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ កិច្ចប្រជុំ រដ្ឋមន្ត្រី បរិស្ថាន អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ រយៈពេល ៥ ថ្ងៃ ( ចុច អាន )
៧៖ រុស្ស៊ី៖ គ្មាន ឡើយ ភស្ដុតាង បង្ហាញ ថា អ៊ីរ៉ង់ ជា អ្នកវាយប្រហារ លើ រោងចក្រ ប្រេង អារ៉ាប៊ី សាអូឌីត ( ចុច អាន )
៨៖ ធ្លាក់ យន្តហោះ ទម្លាប់ គ្រាប់បែក ស៊េរី ចាស់ នៅ អាមេរិក បណ្តាលឲ្យ មនុស្ស ៧នាក់ ស្លាប់ ( ចុច អាន )
១០៖ អ៊ីស្រាអែល មាន ការប្រុងប្រយ័ត្ន នឹង រុស្ស៊ី យ៉ាង ខ្លាំង ក្រោយ ការបាញ់ ទម្លាក់ យន្តហោះ យោធា រុស្ស៊ី កាលពី ឆ្នាំ ២០១៨ ( ចុច អាន )
សារព័ត៌មាន Hindu របស់ ឥណ្ឌា បាន ចេញផ្សាយ តាម សម្តី អ្នកនាំពាក្យ នៃ ក្រសួង ការបរទេស អាមេរិក យ៉ាង ដូច្នេះ ថា « យើង ជម្រុញឲ្យ បណ្តា សម្ព័ន្ធមិត្ត និង ដៃគូ របស់ យើង ទាំងអស់ បញ្ឈប់ ការធ្វើ ប្រតិបត្តិការ ( កិច្ចព្រមព្រៀង ទិញ សព្វាវុធ ) ជាមួយ រុស្ស៊ី ដែល ជា ការប្រថុយ នឹង ទណ្ឌកម្ម របស់ សហរដ្ឋ អាមេរិក តាមរយៈ ច្បាប់ CAATSA ដែល ត្រូវបាន អនុម័ត កន្លងមក » ។
គួរ បញ្ជាក់ ថា ប្រទេស ឥណ្ឌា ដែល ត្រូវបាន ទីក្រុង វ៉ាស៊ីនតោន ចាត់ទុក ជា ដៃគូ យុទ្ធសាស្ត្រ ក្នុង ការទប់ទល់ ឥទ្ធិពល ចិន ក្នុង តំបន់ អាស៊ី នោះ បាន ចុះហត្ថលេខា ជាមួយ រុស្ស៊ី ក្នុង ទឹកប្រាក់ ៥. ៤៣ ពាន់ លាន ដុល្លារ ដើម្បី ទទួលបាន ប្រព័ន្ធ ការពារ ដែន អាកាស S-400 ចំនួន ០៥ គ្រឿង បើ ទោះបីជា ត្រូវ ប្រឈមមុខ ទណ្ឌកម្ម ដូច មាន ចែង ក្នុង ច្បាប់ CAATSA របស់ សហរដ្ឋ អាមេរិក ដែល ត្រូវបាន អនុម័ត ឡើង ដើម្បី ប្រឆាំង សម្ព័ន្ធមិត្ត ណា ដែល ទិញ សព្វាវុធ ពី រុស្ស៊ី នោះ ក៏ដោយ ។
មិន ត្រឹមតែ ប្រទេស ឥណ្ឌា នោះ ឡើយ បណ្តា ប្រទេស មួយចំនួន ទៀត ដែល មាន ទំនាក់ទំនង ជា យុទ្ធសាស្ត្រ ជាមួយ អាមេរិក ជាពិសេស គឺ តួកគី តែ ម្តង ក៏ បាន ទិញ ប្រព័ន្ធ ការពារ មីស៊ីល S-400 ពី រុស្ស៊ី រួចរាល់ ហើយ ដែរ ខណៈ ទីក្រុង វ៉ាស៊ីនតោន បាន តបស្នង ទៅ តួកគី វិញ តាមរយៈ ការព្យួរ សិទ្ធិ ប្រទេស នេះ ពី កម្មវិធី អភិវឌ្ឍន៍ យន្តហោះ ចម្បាំង បំបាំង កាយ F-35 ប៉ុន្តែ តួកគី នៅតែ បន្ត ការតវ៉ា របស់ ខ្លួន ជុំវិញ ការដាក់ទណ្ឌកម្ម របស់ អាមេរិក ៕
ប្រាសាក់ បើក សាខា ថ្មី មួយ ទៀត នៅ កណ្ដាល ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ
( កំពង់ស្ពឺ ) ៖ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ប្រាសាក់ ប្រកាស បើក ឱ្យ ដំណើរការ ការិយាល័យ សាខា ចំនួន១ បន្ថែម ទៀត ស្ថិត គឺ សាខា ស្វាយ ក្រវ៉ាន់ មាន ទីតាំង នៅ ខាងត្បូង សាលា ខេត្ត កំពង់ស្ពឺ ចម្ងាយ ប្រហែល៣០០ ម៉ែត្រ ក្នុង ភូមិ ទួល គក សង្កាត់ ស្វាយ ក្រវ៉ាន់ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ ។
លោក សាយ សូនី នាយក ប្រតិបត្តិ នៃ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ប្រាសាក់ ឲ្យដឹង ថា « យើង មាន ក្តីរំភើប រីករាយ ដែល បាន ពង្រីក បណ្តាញ ការិយាល័យ របស់ យើង ឱ្យ ខិត ជិត អតិថិជន ដើម្បី បម្រើ សេវា ធនាគារ ជូន ប្រកបដោយ ភាពងាយស្រួល . លឿន រហ័ស និង សុវត្ថិភាព ជាមួយនឹង សេវា ហិរញ្ញវត្ថុ ដ៏ សម្បូរបែប ពី ប្រាសាក់ ។ ការបើក គណនី សន្សំ នៅ ប្រាសាក់ នៅ ថ្ងៃ នេះ អតិថិជន អាច ផ្ទេរ ប្រាក់ ទិញ កាត ទូរស័ព្ទ ផ្ទេរ ប្រាក់ តាម លេខ សម្ងាត់ ទៅ អ្នក គ្មាន គណនី ពិនិត្យ សម តុល្យ គណនី និង សេវា ផ្សេង ៗ ដោយ មិន អស់ កម្រៃ សេវា » ។
សូម បញ្ជាក់ ថា ប្រាសាក់ ក្នុង រយៈពេល ៦ខែ ដើម ឆ្នាំ ២០១៩នេះ ប្រាសាក់ មាន ទ្រព្យសកម្ម សរុប ច្រើន ជាង ២. ៨០០លាន ដុល្លារ អាមេរិក សម្ពៀត ឥណទាន ច្រើន ជាង ២. ៣៧០លាន ដុល្លារ អាមេរិក អតិថិជន ប្រាក់ កម្ចី ៤១០ ពាន់ នាក់ បណ្តាញ ការិយាល័យ និង ទីតាំង ម៉ាស៊ីន អេធី អឹម គ្របដណ្តប់ ទូទាំង ប្រទេស និង បុគ្គលិក ជិត ៨. ២០០ នាក់ ព្រមទាំង បាន ផ្តល់ អគារ បណ្ណាល័យ ចំនួន ៤០ នៅ តាម បណ្តា ខេត្ត នានា នៅ កម្ពុជា ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ ចេញផ្សាយ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ តុលាការ ជាន់ ខ្ពស់ សហភាព អឺរ៉ុប បាន គូសបញ្ជាក់ ដូច្នេះ ថា៖ « តុលាការ នៅក្នុង សហភាព អឺរ៉ុប អាច បង្គាប់ឱ្យ អ្នក ផ្ដល់ សេវាកម្ម ដូចជា Facebook លុបចោល ការបញ្ចេញមតិ ទាំងឡាយ ណា ដែល ត្រូវបាន ចាត់ទុក ថា ខុស ច្បាប់ » ។
ការដាក់ពាក្យ ចូលរៀន នៅ West Point ត្រូវ ចំណាយ ពេល ច្រើន ជាង ការដាក់ពាក្យ ទៅ មហាវិទ្យាល័យ ផ្សេង ទៀត និង មាន លក្ខខណ្ឌ ច្រើន ។ ដំណើរការដាក់ពាក្យ នៃ និស្សិត នាយ ទាហាន បរទេស គឺ ចាំបាច់ ដូចគ្នា នឹង ពលរដ្ឋ អាមេរិក ដែរ ។
អ្នកស្រី បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « អ្នកបញ្ចប់ ការសិក្សា នៅ មហាវិទ្យាល័យ សាកលវិទ្យាល័យ ឬ វិទ្យាស្ថាន ថ្នាក់ ឧត្តម សិក្សា នឹង ទទួលបាន សញ្ញាបត្រ ឬ វិញ្ញាបនបត្រ ប្រសិនបើ ពួកគេ បំពេញ តាម លក្ខខណ្ឌ នៃ គ្រឹះស្ថាន សិក្សា ទាំងនោះ បាន ។ ប្រទេស កំណើត របស់ និស្សិត គឺ មិន មែន ជា បញ្ហា ឡើយ » ។
លោកស្រី បាន អួត អំពី គុណភាព សិក្សា នៅ សហរដ្ឋ អាមេរិក ដោយ បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « គ្រឹះស្ថាន ថ្នាក់ ឧត្តម សិក្សា របស់ អាមេរិក មាន ឈ្មោះ ល្បី រន្ទឺ ដោយសារតែ គុណភាព គ្មាន គូ ប្រៀប ហើយ អាច ផ្តល់ ជំនាញ ភាសា អង់គ្លេស យ៉ាង ល្អ ឥត ខ្ចោះ ដើម្បី ត្រៀម សម្រាប់ អាជីព នា ពេល អនាគត » ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៧ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៥ករណី និង ជួញដូរ ១២ករណី ឃាត់ខ្លួន ជនសង្ស័យ ៣៨ នាក់ ។
នគរបាល កម្ពុជា និង វៀតណាម បើក កិច្ចប្រជុំ បូកសរុប លទ្ធផល សហប្រតិបត្តិការ បង្ការ ទប់ស្កាត់ ប្រឆាំង គ្រឿងញៀន ឆ្នាំ ២០១៩
( សៀមរាប ) ៖ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន រៀបចំ កិច្ចប្រជុំ លើក ទី២ ដើម្បី បូកសរុប លទ្ធផល សហប្រតិបត្តិការ ត ស៊ូ បង្ការ ទប់ស្កាត់ ប្រឆាំង គ្រឿងញៀន ឆ្នាំ ២០១៩ និង ទិសដៅ សហប្រតិបត្តិការ ឆ្នាំ ២០២០ ជាមួយ នាយកដ្ឋាន តម្រួត ស្រាវជ្រាវ បទល្មើស គ្រឿងញៀន ក្រសួង នគរបាល នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម និង នាយកដ្ឋាន បង្ការ ប្រឆាំង គ្រឿងញៀន និង បទល្មើស បញ្ជាការដ្ឋាន កងទ័ព ការពារ ព្រំដែន ក្រសួង ការពារ ជាតិ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ។
គណៈប្រតិភូ នាយកដ្ឋាន តម្រួត ស្រាវជ្រាវ បទល្មើស គ្រឿងញៀន ក្រសួង នគរបាល នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ដឹកនាំ ដោយ លោក ឧត្ដមសេនីយ៍ ទោ ផាម វ៉ាន់ កាក ប្រធាន នាយកដ្ឋាន ជា ប្រធាន ប្រតិភូ រួម សមាជិក ១២ រូប ចូលរួម ។ គណៈប្រតិភូ នាយកដ្ឋាន បង្ការ ប្រឆាំង គ្រឿងញៀន និង បទល្មើស បញ្ជាការដ្ឋាន កងទ័ព ការពារ ព្រំដែន ក្រសួង ការពារ ជាតិ នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម ដឹកនាំ ដោយ លោក ឧត្ដមសេនីយ៍ ត្រី ង៉ូ ថា យ យុង ប្រធាន នាយកដ្ឋាន ជា ប្រធាន ប្រតិភូ រួម សមាជិក ១២ រូប ចូលរួម ។
ដោយ មាន ការឯកភាព ពី ថ្នាក់ដឹកនាំ នៃ ភាគី ទាំង បី ក្នុង គោលបំណង បង្កើន ចំណង សាមគ្គីភាព មិត្តភាព សហប្រតិបត្តិការ ល្អ ឱ្យ កាន់តែ មាន ប្រសិទ្ធភាព ខ្ពស់ ក្នុង ការតស៊ូ បង្ការ ទប់ស្កាត់ និង ប្រឆាំង បទល្មើស គ្រឿងញៀន សំដៅ ថែរក្សា ស្ថេរភាព សន្តិសុខ សណ្តាប់ធ្នាប់ រួមចំណែក លើកស្ទួយ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម របស់ ប្រទេស ទាំង ពីរ ភាគី ទាំង៣ បាន ឯកភាព គ្នា ក្នុង របៀប វរៈ ចំនួន ៦ ដូច ជា៖
* ទី ១៖ ភាគី ទាំង បី បន្ត ដំណើរការ « ផែនការ ចំណុច ខ្ពស់ អំពី ការងារ ផ្សព្វផ្សាយ វាយលុក បង្រ្កាប បទល្មើស គ្រឿងញៀន តាម បណ្តោយ ព្រំដែន កម្ពុជា - វៀតណាម » និង ការបង្កើត នូវ យន្តការ សម្រាប់ ទំនាក់ទំនង ទាន់ ហេតុការណ៍ ដើម្បី ផ្លាស់ប្តូរ ព័ត៌មាន សហការចាត់ វិធានការ បង្ការ ទប់ស្កាត់ និង បង្រ្កាប បទល្មើស គ្រឿងញៀន ទាន់ ពេល វេលា ។
* ទី ២៖ ភាគី ទាំង បី អាច បង្កើត គណៈ បញ្ជាការ ករណី ( ក្នុង ករណី ចាំបាច់ ) ដើម្បី សហការ តាម ស្វែងរក និង ចាប់ខ្លួន មេក្លោង បណ្តាញ ខ្សែរយៈ ដែល ជា មេក្លោង កំពុង រត់គេចខ្លួន សំដៅ ធានា ការ បង្រ្កាប ឲ្យ ដល់ ប្ញស គល់ ។
ជនសង្ស័យ ម្នាក់ លួងលោម នាង ប្អូន រំលោភ បាន សម្រេច ជាច្រើន ដង មិន អស់ចិត្ត ចាប់ នាង បង យក ទៅ រំលោភ ទៀត ត្រូវ កម្លាំង សមត្ថកិច្ច ខេត្ត ព្រះវិហារ ចាប់ វាយ ខ្មោះ
( ព្រះវិហារ ) ៖ បុរស ម្នាក់ ត្រូវបាន កម្លាំង នគរបាល ស្រុក ជាំ ក្សាន្ត ខេត្ត ព្រះវិហារ ឃាត់ខ្លួន ក្រោយ មាន ពាក្យបណ្តឹង របស់ អនាព្យាបាល របស់ នារី រងគ្រោះ ២នាក់ ប្តឹង ពី បទ ចាប់រំលោភ បាន សម្រេច លើ កូនស្រី គាត់ ។
លោក អធិការ ស្រុក បាន ឲ្យដឹង ទៀត ថា បុរស ជា ជនសង្ស័យ បាន មក ស្នាក់ នៅ ផ្ទះ ជាមួយ ជនរងគ្រោះ អស់ រយៈពេល ២ឆ្នាំ ហើយ ។
លោក រៀបរាប់ ដំណើរ រឿង ថា កំលុង ខែមេសា ឆ្នាំ ២០១៩ ជនសង្ស័យ បាន លួងលោម នារី ជា ប្អូន រំលោភ បាន សម្រេច នៅ រោង ខាងក្រោយ ផ្ទះ ជាច្រើន ដង លុះ នៅ ខែកញ្ញា នេះ ជនសង្ស័យ បាន លួងលោម នាំ នារី ជា បង ចេញ ពី ផ្ទះ ចាប់រំលោភ ទៀត ក៏ ត្រូវ ម្តាយ នារី រងគ្រោះ ដាក់ពាក្ស បណ្តឹង មក សមត្ថកិច្ច ។
លោក ឱ សេង បាន បន្ត ទៀត ថា បន្ទាប់ពី ទទួល ពាក្ស បណ្តឹង ពី ម្តាយ នារី រងគ្រោះ ទាំង២ សមត្ថកិច្ច នគរបាល ស្រុក ជាំ ក្សាន្ត និង នគរបាល ប៉ុស្តិ៍ រដ្ឋបាល ស្រអែម បាន ធ្វើ ការស្រាវជ្រាវ រហូត ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ បាន និង បាន រៀបចំ កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ ស្នងការដ្ឋាន ខេត្ត ព្រះវិហារ ដើម្បី ចាត់ការ ទៅតាម ច្បាប់ ៕ ហុងកុង នឹង លែង ឲ្យបាតុករ ពាក់ ម៉ាស់ ធ្វើ បាតុកម្ម ខណៈ អំពើហិង្សា កាន់តែ ក្តៅ គគុក ឡើង ៗ
( ហុងកុង) ៖ ទីក្រុង ហុងកុង អាចនឹង អនុវត្ត ច្បាប់ គ្រា អាសន្ន មួយ ដែល មាន គោលដៅ ហាម ក្រុម បាតុករ ពាក់ ម៉ាស់ បិទ មុខ កំឡុង ធ្វើ បាតុកម្ម ខណៈ អាជ្ញាធរ កំពុង ទប់ទល់ នឹង បាតុកម្ម តវ៉ា លាយឡំ ជាមួយ អំពើហិង្សា អស់ រយៈពេល ជាង ៤ខែ មក នេះ ។ នេះ បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ នៅក្នុង ស្រុក ដកស្រង់ ចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ល្ងាច ថ្ងៃព្រហស្បតិ៍ ទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ ។
ក្រុម បាតុករ ជាច្រើន បាន ពាក់ ម៉ាស់ បិទ មុខ ដើម្បី លាក់បាំង អត្តសញ្ញាណ និង ការពារ ការបាញ់ ឧស្ម័ន បង្ហូរ ទឹកភ្នែក របស់ អាជ្ញាធរ ។ ជាក់ស្ដែង នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ តែម្ដង ក្រុម បាតុករ ជាច្រើន នាក់ បាន ប៉ះទង្គិច គ្នា ជាថ្មី ជាមួយ ប៉ូលិស ហុងកុង ដើម្បី បង្ហាញ ការខឹងសម្បារ របស់ ពួកគេ ទៅនឹង ប៉ូលិស ហុងកុង ដែល បាន បាញ់ បាតុករ ម្នាក់ អាយុ ១៨ ឆ្នាំ ឱ្យ របួស ធ្ងន់ ចំ ដើមទ្រូង ខណៈ បាតុករ ច្រើន ជាង ១៨០ នាក់ ត្រូវបាន ចាប់ខ្លួន កាលពី ថ្ងៃអង្គារ កន្លងទៅ ។
គួរ ជម្រាប ថា នៅក្នុង បាតុកម្ម តវ៉ា នៅ ថ្ងៃព្រហស្បតិ៍ នេះ ក្រុម បាតុករ ពាក់ ម៉ាស់ ខ្មៅ ក៏ បាន គប់ ដប សាំង លើ ប៉ូលិស ផងដែរ ជា ហេតុ ធ្វើឱ្យ ប៉ូលិស ត្រូវបាញ់ ឧស្ម័ន បង្ហូរ ទឹកភ្នែក ដើម្បី បំបែក ពួកគេ ៕ សាកលវិទ្យាល័យ IU ផ្តល់ អាហារូបករណ៍ ២១៧ កន្លែង សម្រាប់ ឆ្នាំ សិក្សា ថ្មី
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួមចំណែក អភិវឌ្ឍន៍ ធនធាន មនុស្ស ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា និង ជួយ បំពេញ ក្តីស្រម័យ របស់ អ្នកសិក្សា នោះ សាកលវិទ្យាល័យ អន្តរជាតិ IU បាន ផ្តល់ អាហារូបករណ៍ ១០០ ភាគរយ ២១៧ កន្លែង នៅក្នុង បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ឆ្នាំ ២០១៩ - ២០២០ ។
យោង តាម សាកលវិទ្យាល័យ បាន ឱ្យដឹង ថា អាហារូបករណ៍ នេះ សម្រាប់ វិស័យ សុខាភិបាល មាន ចំនួន ៨០ កន្លែង និង ជំនាញ ក្រៅពី វិស័យ សុខាភិបាល ១៣៧ កន្លែង ។
ដូច្នេះ សិស្ស ទើប ប្រលង ជាប់ មធ្យមសិក្សា ទុតិយភូមិ ឬ អ្នក ចង់ ទទួលបាន អាហារូបករណ៍ នេះ កុំ ភ្លេច ចូលរួម សន្និសីទ ដែល ធ្វើឡើង នៅ សាកលវិទ្យាល័យ IU ក្នុង សង្កាត់ ភ្នំពេញ ថ្មី ខណ្ឌ សែនសុខ ឬ ទស្សនា តាមរយៈ ទំព័រ Facebook របស់ សាកលវិទ្យាល័យ ។
សូម បញ្ជាក់ ថា សាកលវិទ្យាល័យ អន្តរជាតិ IU គឺជា សាកលវិទ្យាល័យ មួយ ដែល ទទួលបាន សិទ្ធិ ក្នុង ការបណ្តុះបណ្តាល លើ ជំនាញ វិជ្ជាជីវៈ សុខាភិបាល រួម មាន៖ ថ្នាក់ វេជ្ជបណ្ឌិត ទូទៅ . ថ្នាក់ បរិញ្ញាបត្រ ឱសថ . ថ្នាក់ ទន្ត បណ្ឌិត ទូទៅ . ថ្នាក់ បរិញ្ញាបត្រ / បរិញ្ញាបត្រ រង គិលានុបដ្ឋាក . ថ្នាក់ បរិញ្ញាបត្រ / បរិញ្ញាបត្រ រង ឆ្មប . ថ្នាក់ បរិញ្ញាបត្រ សុខភាព សាធារណៈ . ថ្នាក់ បរិញ្ញាបត្រ រង បច្ចេកទេស មន្ទីរពិសោធន៍ . ថ្នាក់ បរិញ្ញាបត្រ រង ទន្ត គិលានុបដ្ឋាក និង ថ្នាក់ បរិញ្ញាបត្រ រង បច្ចេកទេស វិទ្យុសាស្ត្រ ។
ការទទួល ពាក្យ ប្រលង ចូល សិក្សា សម្រាប់ ថ្នាក់ បរិញ្ញាបត្រ ឈប់ ទទួល ពាក្យ នៅ ថ្ងៃទី ០១ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ហើយ ថ្នាក់ បរិញ្ញាបត្រ រង ឈប់ ទទួល ពាក្យ នៅ ថ្ងៃទី ១៣ ខែធ្នូ ឆ្នាំ ២០១៩ ។
ដោយឡែក ការប្រលង វិញ ថ្នាក់ បរិញ្ញាបត្រ ធ្វើឡើង នៅ ថ្ងៃទី ២៣ - ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ហើយ ថ្នាក់ បរិញ្ញាបត្រ រង ធ្វើឡើង នៅ ថ្ងៃទី ២៨ - ២៩ ខែធ្នូ ឆ្នាំ ២០១៩៕ អគ្គិសនី កម្ពុជា ផ្អាក ផ្គត់ផ្គង់ អគ្គិសនី នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល រយៈពេល ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៤ - ០៦ ខែតុលា
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា នៅ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការផ្អាក ផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី ចំនួន ៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៤ ដល់ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០១៩ តាម តំបន់ មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្ដាល ដើម្បី អនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ បង្ក លក្ខណៈ ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ ៕
កម្លាំង សមត្ថកិច្ច ចុះបង្ក្រាប ទីតាំង បើក ល្បែងស៊ីសង តាម អ៉ីនធឺណេត មួយ កន្លែង នៅមុខ ផ្សារ សូរិយា ម៉ល ក្នុង ខណ្ឌ ដូនពេញ ឃាត់ខ្លួន មនុស្ស ជាង ១០នាក់
បើ តាម សេចក្ដីរាយការណ៍ ក្នុង ប្រតិបត្តិការ នេះ កម្លាំង នគរបាល ខណ្ឌ ដូនពេញ បាន ឃាត់ខ្លួន មនុស្ស ប្រុស ស្រី ជាង ១០នាក់ និង ដកហូត បាន វត្ថុតាង កុំព្យូទ័រ ជាច្រើន គ្រឿង ផងដែរ ។
ក្រោយ ឃាត់ខ្លួន មនុស្ស ទាំងអស់ នោះ ត្រូវបាន បញ្ជូន ទៅ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដូនពេញ ដើម្បី កសាង សំណុំរឿង ចាត់ការបន្ដ តាម នីតិវិធី ៕
ក្នុង កំលុង ពេល ស្នាក់ នៅ ទីក្រុង ហាណូយ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង អញ្ជើញ ដាក់ កម្រង ផ្កា គោរព វិញ្ញា ក្ខន្ធ នៅ វិមាន អនុស្សាវរីយ៍ បុព្វបុរស និង យុទ្ធជន ពាលី និង នៅ វិមាន តម្កល់ សព លោក ហូជីមិញ ។
ក្នុង ក្របខណ្ឌ នៃ ការវិនិយោគ ផ្ទាល់ ពី វៀតណាម រហូតដល់ ខែវិច្ឆិកា ឆ្នាំ ២០១៨ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បាន ចុះបញ្ជី គម្រោង វិនិយោគ របស់ ក្រុមហ៊ុន វៀតណាម ចំនួន ៧៥ គម្រោង លើ ទុន វិនិយោគ សរុប ចំនួន ប្រមាណ ២. ៤ពាន់ លាន ដុល្លារ អាមេរិក ដែល ផ្តោត សំខាន់ លើ វិស័យ កសិកម្ម និង ហេដ្ឋារចនាសម្ព័ន្ធ ៕ អភិបាល ខេត្ត កំពត ចុះ សួរសុខទុក្ខ កម្មករ - កម្ម ការិនី រងគ្រោះថ្នាក់ ចរាចរណ៍ ជិត ៣០ នាក់ ដែល កំពុង សំរាក ព្យាបាល នៅ មន្ទីរពេទ្យ ខេត្ត កំពត និង តាកែវ
( កំពត ) ៖ លោក ជា វ តាយ អភិបាល ខេត្ត កំពត និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត អម ដំណើរ ដោយ មន្ត្រី សាលា ខេត្ត កំពត និង មន្ត្រី សាលា ស្រុក ជុំ គីរី បាន អញ្ជើញ ចុះ ទៅដល់ ជួប ផ្ទាល់ កម្មករ - កម្ម ការិនី រងគ្រោះថ្នាក់ ចរាចរណ៍ ដែល កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត តាកែវ និង មន្ទីរពេទ្យ បង្អែក ស្រុក ឈូក និង ពេទ្យ ស្រុក ជុំ គិរី នៃ ខេត្ត កំពត ។
ជំនួប សួរ សុខទុក្ខ ជន រងគ្រោះថ្នាក់ ចរាចណ៍ បណ្ដាលឱ្យ រងរបួស ស្រាល និង ធ្ងន់ សរុប ចំនួន ២៨ នាក់ ក្នុង នោះ ស្រី ២៦ នាក់ បាន ធ្វើឡើង នៅ យប់ ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០១៩ ។
លោក ជា វ តាយ បាន ចូលរួម សោកស្ដាយ និង ក្ដី ទុក្ខលំបាក ជាមួយ កម្មករ - កម្ម ការិនី រងគ្រោះថ្នាក់ ទាំងអស់ នោះ ក៏ ដូចជា ក្រុមគ្រួសារ ។ លោក អភិបាល ខេត្ត បាន សំណូមពរ ផ្ដាំផ្ញើ ដល់ បុគ្គលិក មន្ទីរពេទ្យ បង្អែក ដែល ពាក់ព័ន្ធ សូម ឱ្យ មេត្តា ជួយ យកចិត្តទុកដាក់ ថែទាំ និង ព្យាបាល របួស ដល់ កម្មករ - កម្ម ការិនី ធ្វើ ខាង ណា ឱ្យ មាន សភាព ធូរស្រាល និង ឆាប់ ជាស្បើយ បាន ត្រឡប់ ទៅ ផ្ទះ វិញ ឆាប់ ៗ នេះ ដើម្បី ទៅ បំពេញ ការងារ ដូច សព្វ ដង ផងដែរ ។
ក្នុង ឱកាស នោះ លោក អភិបាល ខេត្ត បាន នាំយក នូវ ថវិកា សរុប ចំនួន ១២.០០០.០០០ រៀល ( ដប់ ពីរ លាន រៀល ) ដើម្បី ឧបត្ថម្ភ បន្ថែម ជូន ដល់ កម្មករ - កម្ម ការិនី ដែល រងគ្រោះ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ទាំងអស់ ផងដែរ ។
( សៀមរាប ) ៖ លោក អៀង ពិសិដ្ឋ ឋានន្តរសកិ្តវរៈ មន្ត្រី ថ្នាក់ លេខ ៤ អភិបាល រង ស្រុក សូទ្រនិគម ត្រូវបាន ប្រកាស ឲ្យ ចូលកាន់ តំណែង ជា អភិបាល ស្រុក ស្វាយលើ នា ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ នៅ រដ្ឋបាល សាលា ស្រុក ស្វាយលើ ជំនួស លោក ស៊ិក ប៊ុន ស៊ិន អតីត អភិបាល ស្រុក ដែល ត្រូវបាន ចូលនិវត្ត និង បាន ប្រកាស អភិបាល រង ស្រុក ១រូប នាយក រដ្ឋបាល សាលា ស្រុក ១រូប ក្រោម អធិបតីភាព របស់ លោក ទៀ សីហា អភិបាល ខេត្ត សៀមរាប ។
លោក សន សេរី វុទ្ធី នាយក ទី ចាត់ការ ធនធាន មនុស្ស នៃ សាលា ខេត្ត បាន អាន នូវ អនុ ក្រិត្យ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រកាស តែងតាំង លោក អៀង ពិសិដ្ឋ ឲ្យ កាន់ មុខតំណែង ជា អភិបាល ស្រុក ស្វាយលើ ដើម្បី ដឹកនាំ ការអភិវឌ្ឍន៍ គ្រប់ វិស័យ បន្ត ជំនួស លោក ស៊ិក ប៊ុន ស៊ិន អតីត អភិបាល ស្រុក ដែល ត្រូវបាន ចូលនិវត្ត ។
ថ្លែង នា ឱកាស នោះ លោក ទៀ សីហា បាន បញ្ជាក់ ផងដែរ ថា តាម ច្បាប់ ក្រឹត្យ ក្រម របស់ មន្ត្រីរាជការ គ្រប់ រូប ជា គណៈ អភិបាល ខេត្ត / ក្រុង / ស្រុក ដែល បាន បម្រើ ការងារ គ្រប់ អាណត្តិ របស់ ខ្លួន ឬ ក៏ បាន គ្រប់ អាយុ បំពេញ ការងារ គឺ ត្រូវ ចូលនិវត្តន៍ មិន ថា ថ្នាក់ដឹកនាំ មន្ត្រី បុគ្គលិក ឡើយ ។
ជាមួយគ្នា នេះ លោក អភិបាល ខេត្ត បាន ក្រើន រំលឹក ដល់ អភិបាល ស្រុក ស្វាយលើ ដែល ត្រូវបាន តែងតាំង ថ្មី ត្រូវ ខិតខំ បំពេញ ការងារ ដោយ ស្មារតី យកចិត្តទុកដាក់ និង មាន ការទទួលខុសត្រូវ ខ្ពស់ ប្រឹងប្រែង ឲ្យ អស់ ពី កម្លាំង កាយ ចិត្ត ប្រាជ្ញា ស្មារតី ដើម្បី បំពេញ ការងារ ក្នុង ការឆ្លើយតប តាម តម្រូវការ របស់ ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ សកម្ម ថែម ទៀត ដោយ ត្រូវ គោរព រដ្ឋធម្មនុញ្ញ ច្បាប់ និង លិខិត បទដ្ឋាន គតិយុត្ត ជាធរមាន របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
គ្រូបង្រៀន រូប នេះ ក៏ បាន ធ្វើការ ថ្កោលទោស យ៉ាង ដាច់ខាត ចំពោះ ទណ្ឌិត សម រង្ស៉ី ដែល ហ៊ាន ប្រមាថ ព្រះចេស្ដារ ព្រះមហាក្សត្រ និង មាន បំណង់ ចង់ ផ្ដួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ។
អ្នកគ្រូបង្រៀន បាន លើកឡើង យ៉ាង ដូច្នេះ ថា « ក្នុង នាម ខ្ញុំ ជា គ្រូបង្រៀន ម្នាក់ នៅ ខេត្ត កណ្ដាល ខ្ញុំ សូម ដាក់ទោស ដាច់ខាត ចំពោះ ទណ្ឌិត សម រង្ស៉ី ដែល នឹង មាន គម្រោង មក ប្រទេស កម្ពុជា នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ បើ លោក មក មាន វត្ថុ ដែល ចាំ ទទួល លោក គឺ ខ្នោះ ដៃ ព្រោះ លោក ជា ទណ្ឌិត មួយ ដែល បាន មើលងាយ ព្រះមហាក្សត្រ ហើយ នឹង មាន គម្រោង ចង់ ផ្ដួលរំលំ ព្រះមហាក្សត្រ ។
ក្នុង នាម ជា ពលរដ្ឋ ម្នាក់ ខ្ញុំ សូម អំពាវនាវ ដល់ លោកគ្រូ អ្នកគ្រូ ទាំងអស់ ឈប់ ជឿ ខ្ញុំ ទុកចិត្ត ដល់ មនុស្ស ដែល មិន បាន ធ្វើ អ្វី សោះ ចំពោះ ប្រទេសជាតិ យើង ក្រឡែក មើល គ្រប់ ហេដ្ឋារចនាសម្ព័ន្ធ គ្រប់ វិស័យ ទាំងអស់ គឺ មាន សម្ដេច ជា អ្នកដឹកនាំ ហើយ ព្រះមហាក្សត្រ គង់ ជា ម្លប់ ដ៏ ត្រជាក់ សម្រាប់ ពួកយើង ដូច្នេះហើយ ខ្ញុំ សូម ថ្កោល ទោស ដាច់ខាត និង សូម អំពាវនាវ លោកគ្រូ អ្នកគ្រូ ទាំងអស់ ត្រូវ ថ្កោល ទោស ដាច់ខាត ចំពោះ ទណ្ឌិត សម រង្ស៉ី ដែល នឹង មាន គំនិត និង មាន គម្រោង មក ប្រទេស កម្ពុជា នា ពេល ខាងមុខ នេះ » ។
ជន ក្បត់ ជាតិ សម រង្ស៉ី បាន ប្រកាស នឹង វិលត្រឡប់មក កម្ពុជា វិញ នៅ ថ្ងៃទី ០៩ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ខាងមុខ ដើម្បី ប្រឆាំង និង ផ្តួល របប ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បច្ចុប្បន្ន ។ ការវិលត្រឡប់ នេះ ត្រូវបាន រាជ រដ្ឋាភិបាល កម្ពុជា ប្រកាស ថា ជា ការប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ កើត ចេញពី ការបោះឆ្នោត ៕ អភិបាល រង ខេត្ត កណ្ដា ល៖ មនុស្ស ចាស់ ក៏ ជា ធនធាន ដ៏ សំខាន់ ក្នុង ការចូលរួម អភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ឲ្យបាន រីកចម្រើន
( កណ្ដាល ) ៖ លោក នូវ ប៉េង ច័ន្ទ តារា អភិបាល រង ខេត្ត កណ្តាល តំណាង លោក បណ្ឌិត ម៉ៅ ភិរុណ អភិបាល ខេត្ត កណ្តាល នៅ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន លើកឡើង ថា មនុស្ស ចាស់ ក៏ ជា ធនធាន ដ៏ សំខាន់ ក្នុង ការចូលរួម អភិវឌ្ឍន៍ ប្រទេស កម្ពុជា ឲ្យបាន រីកចម្រើន ។
ការលើកឡើង បែប នេះ គ្រា ដែល លោក អញ្ជើញ ជា អធិបតី ក្នុង ពិធី ប្រារព្ធ ទិវា មនុស្ស ចាស់ កម្ពុជា និង ទិវា មនុស្ស ចាស់ អន្តរជាតិ ១ តុលា ឆ្នាំ ២០១៩ ក្រោម ប្រធានបទ « គាំទ្រ សុខ មាលភាព មនុស្ស ចាស់ គឺជា កត កត្តា ដ៏ សំខាន់ ក្នុង ការអនុវត្ត ប្រព័ន្ធ គាំពារ សុខុមាលភាព មនុស្ស គ្រប់ វ័យ ក្នុង សង្គមជាតិ កម្ពុជា » ដែល បាន ប្រារព្ធ ឡើង នៅ ក្នុង បរិវេន សាលា ស្រុក កៀនស្វាយ នា ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ ។
លោក បន្ត ទៀត ថា រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង ជា ប្រធាន កិត្តិយស គណៈកម្មាធិការ ជាតិ កម្ពុជា ដើម្បី មនុស្ស ចាស់ តែងតែ ផ្តល់ ក្តី អាណិត ស្រលាញ់ សណ្តោស ប្រណី យកចិត្តទុកដាក់ និង គិតគូរ ខ្ពស់ ពី សុខ ទុក្ខ របស់ លោកយាយ លោក តា និង ជន រួម ជាតិ ទាំងអស់ ហើយ ថ្នាក់ដឹកនាំ មិន ចង់ឲ្យ ប្រជាពលរដ្ឋ របស់ ខ្លួន ណា ម្នាក់ ជួប ភាពអត់ឃ្លាន នោះ ឡើយ ។
បន្ទាប់ពី សំណេះសំណាល លោក នូវ ប៉េង ច័ន្ទ តារា បាន ចែកជូន លោកយាយ - លោក តា ចំនួន ២០០ នាក់ ក្នុង ម្នាក់ ៗ ទទួលបាន អង្គរ ២៥ គីឡូ មី យើង ១កេស ទឹកត្រី មួយ យួរ និង ថវិកា ៥០.០០០ រៀល ផងដែរ ៕
លោក គីម រិទ្ធិ ជំរុញ ឲ្យ យុវជន លេង កីឡា ដែល នាំមក នូវ សុខភាព មិត្តភាព និង សាមគ្គីភាព
( កណ្ដាល ) ៖ លោក គីម រិទ្ធី អភិបាល រង ខេត្ត កណ្តាល និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត កណ្ដាល បាន លើកឡើង ថា ក្នុង នាម ជា កីឡាករ ត្រូវតែ ហ៊ាន ទទួលយក នូវ ភាព ឈ្នះ និង ចាញ់ ហើយ អ្វី ដែល ជា ចំណុច ពិសេស នោះ គឺ ត្រូវតែ មាន សាមគ្គីភាព គ្នា ល្អ និង ដើម្បី មិត្តភាព ហើយ ក៏ ដើម្បី សុខភាព ដែរ ។
លោក គីម រិទ្ធី បាន លើកឡើង បែប នេះ នៅក្នុង សន្និសីទ សារព័ត៌មាន ស្តីពី ការប្រកួត កីឡា បាល់ទាត់ ពានរង្វាន់ សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត កណ្តាល ឆ្នាំ ២០១៩ នា ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ ។
លោក បន្ត ថា នេះ ជា លើក ទី១ ហើយ ដែល ស .ស .យ . ក ខេត្ត កណ្តាល បង្កើត ការប្រកួត បាល់ទាត់ ពានរង្វាន់ នេះ ឡើង ខណៈ កន្លងទៅ យើង បាន ត្រឹមតែ សហការ ជាមួយ មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត កណ្តាល តែ ប៉ុណ្ណោះ ដែល ការបង្កើត ព្រឹត្តិការណ៍ នេះ ឡើង គឺ ដើម្បី បំផុស យុវជន ងាក មក លេង កីឡាកាន់តែ ច្រើន និង បង្កើន នូវ សាមគ្គីភាព មិត្តភាព ក៏ ដើម្បី សុខភាព ផងដែរ ។
លោក ថា ជាង នេះ ទៅ ទៀត ក៏ ដើម្បីឲ្យ យុវជន ចាក ផុត ពី គ្រឿងញៀន និង អំពើ ឧបាយ មុខ ផង ទាំងពួង ដែរ ដោយ យក ពេលវេលា ទៅ លេង កីឡា វិញ ដូចនេះ កីឡាករ ទាំងអស់ ត្រូវតែ ប្រកាន់ខ្ជាប់ នូវ គោលការណ៍ ៣ រួម មាន កីឡា រ នាំមក នូវ មិត្តភាព សាមគ្គីភាព និង សុខភាព ។
លោក ធុល នាង ទីប្រឹក្សា សម្តេច ពញា ចក្រី ហេង សំរិន និង ជា ប្រធាន មន្ទីរ ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ព្រមទាំង ជា អនុប្រធាន គណៈកម្មការរៀបចំ ការប្រកួត បាន ដឹង ថា ក្រុម កីឡា ដែល ត្រូវ ចូលរួម ប្រកួត មាន ទាំងអស់ ចំនួន ១៦ ក្រុម ដែល ការប្រកួត នឹង ចាប់ផ្តើម នៅ ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ហើយ ប្រកួត តែ ថ្ងៃសៅរ៍ - អាទិត្យ តែ ប៉ុណ្ណោះ និង គ្រោង បិទ បញ្ចប់ នៅ ថ្ងៃទី ០១ ខែធ្នូ ឆ្នាំ ២០១៩ ។
( កំពង់ចាម ) ៖ ក្នុង ពិធី ខួប អនុស្សាវរីយ៍ លើក ទី ២១ ទិវា មនុស្ស ចាស់ កម្ពុជា និង ទិវា មនុស្ស ចាស់ អន្តរជាតិ ១ តុលា ប្រារព្ធ ធ្វើ នៅ សាលា ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម នា ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម បាន ថ្លែង លើកទឹកចិត្ត ឲ្យ មនុស្ស វ័យ ចំណាស់ ជា និវត្ត ជន ថែរក្សា សុខភាព និង ចូលរួម ថែរក្សា សុខ សន្តិភាព ប្រទេសជាតិ ឲ្យ កាន់តែ មាន ភាពរីកចម្រើន ទៅ អនាគត ។
លោក អភិបាល ខេត្ត បាន ថ្លែង ថា « សូម លោក ពូ អ្នក មីង លោក អ៊ុ ដែល ជា និវត្ត ជន ទាំងអស់ ថែរក្សា សុខភាព បើសិន មាន ជំងឺ ឈឺថ្កាត់ សូម ប្រញាប់ ទៅ រក មន្ទីពេទ្យ ព្រោះ បច្ចុប្បន្ន ការពិនិត្យ និង ព្យាបាល សុខភាព មិន អស់ លុយ ទេ ព្រោះ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ជា អ្នក ចេញ លុយ ជំនួស » ។
លោក អ៊ុន ចាន់ ដា បន្ថែម ទៀត ថា ទន្ទឹមនឹង នេះ ក្រៅពី ផ្តល់ ប័ណ្ណ ប .ស. ស រាជ រដ្ឋាភិបាល តែងតែ បាន គិតគូរ អំពី កំណែទម្រង់ តំឡើង ប្រាក់ បៀវត្ស ដល់ សោធន និវត្តន៍ យើង ជា បន្តបន្ទាប់ ផងដែរ ។ លោក អភិបាល ខេត្ត បន្ត ថា ប៉ុន្មាន ថ្ងៃ កន្លងទៅ នេះ សម្ដេច តេជោ ហ៊ុន សែន បាន ណែនាំ ឲ្យ អាជ្ញាធរ ខេត្ត យកចិត្តទុកដាក់ ចំពោះ មនុស្ស ចាស់ ដែល ងាយ រងគ្រោះ ពិសេស គឺ នៅក្នុង រដូវ ទឹក ជំនន់ ។
លោក បន្ត ថា « ខ្ញុំ សូម ថ្លែងអំណរគុណ ចំពោះ ការលះបង់ ការខិតខំ បំពេញ ភារកិច្ច របស់ លោក ពូ អ្នក ម៉ីង លោក អ៊ុ ចូលនិវត្តន៍ ទាំងអស់ ដែល បាន បំពេញ ភារកិច្ច ជូន ជាតិ មាតុភូមិ កន្លងមក និង ចូលរួម រក្សា សុខ សន្តិភាព ស្ថិរភាព ឲ្យ កូន ចៅ ជំនាន់ ក្រោយ បាន រស់ សុខសាន្ត ដូច សព្វ ថ្ងៃ ដូច្នេះ សូម លោក ពូ អ្នក មីង លោក អ៊ុទាំងអស់ បន្ត ជួយ ថែរក្សា សុខ សន្តិភាព ដែល យើង កំពុងតែ មាន នេះ ឲ្យបាន ស្ថិតស្ថេរ គង់វង្ស យូរអង្វែង ទៅ អនាគត »៕
រដ្ឋមន្ដ្រី កសិកម្ម ប្រាប់ ប្រធាន មូលនិធិ អន្តរជាតិ សម្រាប់ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម អំពី ចក្ខុវិស័យ និង ទិសដៅ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម របស់ កម្ពុជា ប្រែក្លាយទៅជា កសិកម្ម ទំនើប
លោក ស្នើសុំ ឲ្យ គ្រប់ តួអង្គ មេត្តា ពង្រឹង និង ពង្រីក វប្បធម៌ នេះ កាន់តែ ល្អ ប្រសើរ ថែម ទៀត ដើម្បី រួមគ្នា បម្រើ និង ការពារ នូវ ឧត្តម ប្រយោជន៍ ជាតិ ឲ្យ កាន់តែ មាន សកម្មភាព ខ្លាំងក្លា រស់រវើក និង ប្រទាក់ ក្រឡា គ្នា ក្នុង ការអភិវឌ្ឍ សង្គម - សេដ្ឋកិច្ច ជាតិ និង និយាយ ដោយឡែក សម្រាប់ វិស័យ កសិកម្ម ឲ្យ មាន ការរីកចម្រើន តាមរយៈ ការទាញយក ប្រយោជន៍ ពី មូលនិធិ IFAD មក ប្រើ ប្រកបដោយ តម្លាភាព ឆ្លើយតប ទៅនឹង តម្រូវការ ពិតប្រាកដ របស់ ប្រជាជន ក្នុង បរិបទ បច្ចុប្បន្ន នេះ ។
១៖ ជំរុញ កំណើន ផលិតកម្ម កសិកម្ម តាមរយៈ ការធ្វើ ពិពិធកម្ម ដែល មាន សក្តានុពល និង បង្កើន ការនាំចេញ ដោយ ពង្រឹង និង ពង្រីក ការធ្វើ ទំនើបកម្ម កសិកម្ម ដើម្បី បង្កើន ផលិតភាព និង ការប្រកួតប្រជែង ដោយ អនុវត្ត បច្ចេកទេស កសិកម្ម ឆ្លាតវៃ និង ការបន្ស៉ាំ ទៅនឹង បម្រែបម្រួល អាកាសធាតុ ។
២៖ ជំរុញ កំណើន ផលិតកម្ម សត្វ ឲ្យ កើន ៣ភាគរយ ក្នុង ១ ឆ្នាំ និង បង្កើន ការចិញ្ចឹម ជា លក្ខណៈ ពាណិជ្ជកម្ម ឲ្យ កើន ដល់ ២២ ភាគរយ ព្រមទាំង ជំរុញ ការចិញ្ចឹម គោ ពូជ ល្អ ៗ ឲ្យបាន ប្រមាណ ៣០ ភាគរយ នៅ ឆ្នាំ ២០២៣ ។
៣៖ បង្កើន ការគ្រប់គ្រង ធនធាន ជល ផល ឲ្យ មាន ប្រសិទ្ធភាព និង និរន្តរភាព ដោយ ពង្រឹង ការអនុវត្ត ច្បាប់ ស្តីពី ជល ផល រក្សា ស្ថិរភាព នៃ ផល ចាប់ពី ធម្មជាតិ ក្នុង រង្វង់ ៦០០ ពាន់ តោន ក្នុង ១ ឆ្នាំ បង្កើន ផល វារី វប្បកម្ម ២០ ភាគរយ ក្នុង ១ឆ្នាំ ។
៤៖ បន្ត គ្រប់គ្រង ធនធាន ព្រៃឈើ និង សត្វ ព្រៃ ប្រកបដោយ ចីរភាព ចូលរួម ជំរុញ ការថែរក្សា គម្រប ព្រៃឈើ ឲ្យបាន ល្អ ប្រសើរ ព្រមទាំង បង្កើន ចំណូល របស់ សហគមន៍ ព្រៃឈើ ឲ្យ កើន ២០ ភាគរយ ក្នុង ១ ឆ្នាំ តាមរយៈ ការធ្វើ ពិពិធកម្ម កសិកម្ម និង ជំរុញ ការស្តារ ព្រៃឈើ ឡើងវិញ ព្រមទាំង បន្ត អនុវត្ត នូវ វិធានការ ចាំបាច់ នានា ដើម្បី ចូលរួមចំណែក ធ្វើឲ្យ ប្រព័ន្ធ អេកូឡូស៊ី មាន ចីរភាព ។
លោក រដ្ឋមន្រ្តី ក៏ បាន រំលេច ពី បញ្ហា ប្រឈម មួយ ចំនួន ផងដែរ ដែល ជា ឧបសគ្គ រាំងស្ទះ ដល់ ការអភិវឌ្ឍន៍ វិស័យ កសិកម្ម ទាំង ក្នុង ពេល បច្ចុប្បន្ន ក៏ ដូចជា ពេល អនាគត ។ ដូច្នេះ ឆ្លៀត យក ឱកាស នេះ លោក បាន ស្នើឲ្យ គ្រប់ តួអង្គ ពាក់ព័ន្ធ ត្រូវ រួមគ្នា ដោះស្រាយ បញ្ហា ទាំងនោះ ឲ្យ មាន លក្ខណៈ ប្រទាក់ ក្រឡា គ្នា ជា អន្តរ វិស័យ ប្រកបដោយ ប្រសិទ្ធភាព រួមទាំង វិស័យ ឯកជន ដែល ជា កម្លាំង ចលករ នៃ កំណើន សេដ្ឋកិច្ច សមស្រប តាម អភិក្រម « រដ្ឋ - ឯកជន - ដៃគូ អភិវឌ្ឍន៍ និង សហគមន៍ »៕
ឃាតម្ម សម្លាប់ បុរស ម្នាក់ នៅ ខណ្ឌ ព្រែក ព្នៅ នៅ ពេល នេះ កម្លាំង នគរបាល តាម ចាប់ បាន ហើយ . ជា បក្ខពួក ក្រុម ចោរប្លន់ ទាំង ៧នាក់ ដែល បង្ក្រាប បាន នៅ ខណ្ឌ ពោធិ៍សែនជ័យ
( ភ្នំពេញ ) ៖ ក្រោយពី កម្លាំង នគរបាល នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ បើក ប្រតិបត្តិការ បង្ក្រាប ក្រុម ចោរ ឆក់ ប្លន់ ក្នុង រាជធានី ភ្នំពេញ ចំនួន ៧នាក់ នោះ បែក ធ្លាយ បក្ខពួក ក្រុម ជនសង្ស័យ ចំនួន ៣នាក់ គឺជា ជនដៃ ដល់ ពាក់ព័ន្ធ និង ករណី ឃាតកម្ម សម្លាប់ មនុស្ស នៅ ខណ្ឌ ព្រែក ព្នៅ កាលពី ២ខែ មុន ។
លោក យឹម សារ៉ាន់ អធិការ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ឲ្យដឹង នៅ ថ្ងៃទី ៣ ខែតុលា ឆ្នាំ ២០១៩ ថា ក្រោយពី កម្លាំង ជំនាញ របស់ លោក បាន ធ្វើ ការបង្ក្រាប ក្រុម ចោរ ឆក់ និង ប្លន់ ទាំងនោះ ដោយ ធ្វើ ការសាកសួរ អស់ រយៈពេល មួយ យប់ មួយ ថ្ងៃ ទើប បែក ធ្លាយ ក្រុម ជនសង្ស័យ ចំនួន ៣នាក់ ជា ឃាតករ បាន វាយ សម្លាប់ បុរស ម្នាក់ នៅ ថ្ងៃទី ១៤ ខែសីហា ឆ្នាំ ២០១៩ នៅ ម្តុំ វត្ត ពោធិ៍ កន្លងទៅ នៅ ខណ្ឌ ព្រែក ព្នៅ កាលពី ២ខែ មុន ។
លោក យឹម សារ៉ាន់ បាន បន្ត ថា ជនសង្ស័យ ដែល ជាប់ ករណី ឃាតកម្ម ទី ១៖ ឈ្មោះ សៀង តុង ភេទ ប្រុស អាយុ ១៨ ឆ្នាំ មុខរបរ ជាង ពិដាន មាន ទីលំនៅ ភូមិ ស្វាយ សង្កាត់ ស្នោរ ខណ្ឌ ពោធិ៍សែនជ័យ . ២៖ ឈ្មោះ ម៉ៅ សុវណ្ណ ហៃ ភេទ ប្រុស អាយុ ១៨ ឆ្នាំ មុខរបរ មិន ពិត មាន ទីលំនៅ ភូមិ ចុង ថ្នល់ សង្កាត់ ពន្សាំង ខណ្ឌ ព្រែក ព្នៅ និង ៣៖ ឈ្មោះ យ៉ុង សហសវត្សន៍ អាយុ ២៣ ឆ្នាំ ស្នាក់ នៅ សង្កាត់ ស្នោរ ។
លោក អធិការ រូប នេះ បាន បន្ត ទៀត ថា ខណៈ នេះ កម្លាំង ជំនាញ ខណ្ឌ ពោធិ៍សែនជ័យ កំពុង សហការ យ៉ាង ក្តៅ គគុក ជាមួយ កម្លាំង ជំនាញ ខណ្ឌ ព្រែក ព្នៅ និង កម្លាំង ជំនាញ នៃ ស្នងការដ្ឋាន រាជធានី ភ្នំពេញ កំពុង ស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ រក ភស្តុតាង បន្ថែម ទៀត ផងដែរ ។
សូម រម្លឹក ថា កម្លាំង នគរបាល នៃ អធិការ រដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ បាន បើក ប្រតិបត្តិការ តាម បង្ក្រាប ក្រុម ចោរ ឆក់ ប្លន់ ដ៏ សកម្ម បាន ចំនួន ៧នាក់ ក្រោយ ក្រុម ជនសង្ស័យ ទាំងនោះ បាន ធ្វើ សកម្មភាព រាប់ មិន អស់ នៅក្នុង ទឹកដី ខណ្ឌ កំបូល និង ខណ្ឌ ពោធិ៍សែនជ័យ ព្រមទាំង ខណ្ឌ នានា ទៀត ផងដែរ និង ដកហូត មធ្យោបាយ ធ្វើ សកម្មភាព ម៉ូតូ ៤គ្រឿង ។
លោក យឹម សារ៉ាន់ អធិការ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ថា ប្រតិបត្តិការ បង្ក្រាប ខាងលើ នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០១៩ វេលា ម៉ោង ១១៖១០នាទី ចំណុច ផ្លូវ មហាវិថី វិមាន ឈ្នះ ឈ្នះ ភូមិ ស្រែ រាជ្ជៈ សង្កាត់ សំរោង ក្រោម ខណ្ខ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
លោក យឹម សារ៉ាន់ បាន បន្ត ទៀត ថា ជនសង្ស័យ រួម មាន៖
ចំណែកឯកជនរងគ្រោះ ទី១៖ ឈ្មោះ មាន ចរិយា ភេទ ស្រី អាយុ ៣១ ឆ្នាំ មុខរបរ នៅ ផ្ទះ មាន ទីលំនៅ ភូមិ តា អិន សង្កាត់ ស្នោរ ខណ្ឌ ពោធិ៍សែនជ័យ និង ទី២៖ ឈ្មោះ ស្រស់ សំណាង ភេទ ប្រុស អាយុ ១៧ ឆ្នាំ មុខរបរ សិស្ស មាន ទី ភូមិ ត្រពាំងពោធិ៍ សង្កាត់ ឪឡោក ខណ្ឌ កំបូល វត្ថុតាង ត្រូវបាត់បង់ ម៉ូតូ១ គ្រឿង ម៉ាក ហុងដា ប៊ិត ពណ៌ ផ្កាឈូក ស៊េរី ឆ្នាំ ២០១៩ ពាក់ ស្លាកលេខ ភ្នំពេញ 1HU-8226 ជា របស់ ជនរងគ្រោះ មាន ឈ្មោះ មាន ចរិយា ។
យោង តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ អ្នកនាំពាក្យ សាលាដំបូង រាជធានី ភ្នំពេញ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ យប់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន ឱ្យដឹង ថា ដីកា បង្គាប់ ឱ្យ ចាប់ខ្លួន ទណ្ឌិត សម រង្ស៉ី និង ភរិយា ព្រមទាំង មនុស្ស ជំនិត នេះ ត្រូវបាន ចៅក្រម សើុប សួរ សាលាដំបូង រាជធានី ភ្នំពេញ ចេញ នៅ ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០១៩ ម្សិលមិញ នេះ ។
ក្នុង សេចក្តីប្រកាស ព័ត៌មាន បាន បញ្ជាក់ ទៀត ថា ជន ត្រូវ ចោទ ទាំង ៩រូប កាលពី ថ្ងៃទី ១៩ ខែកញ្ញា កន្លងទៅ នេះ ត្រូវបាន អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ចោទប្រកាន់ នៅក្នុង សំណុំរឿង ព្រហ្មទណ្ឌ ពី បទ « ឧបឃាត » ដោយ យោង តាម មាត្រា ២៧ និង ៤៥១ នៃ ក្រម ព្រហ្មទណ្ឌ ។
ការចោទប្រកាន់ នេះ ពាក់ព័ន្ធ « ការប៉ុនប៉ង ធ្វើ រដ្ឋប្រហារ » ផ្តួលរំលំ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ឧបាយកល ជា « ផែនការ នៃ ការវិលត្រឡប់មក កម្ពុជា វិញ របស់ ឧក្រិដ្ឋ ជន សម រង្ស៉ី » ដោយ មាន ការអំពាវនាវ និង ប្រើ ថវិកា ប៉ុនប៉ង បង្កើត កងកម្លាំង ឧទ្ទាម ប្រដាប់អាវុធ ខុស ច្បាប់ ដើម្បី ចូលរួម អនុវត្ត ផែនការ នេះ ។
ក្នុង សេចក្តីជូន ព័ត៌មាន បាន បញ្ជាក់ ថា ដីកា បង្គាប់ ឱ្យ ចាប់ខ្លួន ត្រូវបាន បញ្ជូន ទៅកាន់ ស្ថាប័ន មាន សមត្ថកិច្ច ដើម្បី អនុវត្ត ស្រប តាម ច្បាប់ និង នីតិវិធី ជាធរមាន ។ រដ្ឋសភា នឹង បើក សម័យ ប្រជុំ ថ្មី នៅ ព្រឹក ស្អែក នេះ ដោយ មាន របៀបវារៈ ចំនួន ៧
( ភ្នំពេញ ) ៖ បន្ទាប់ពី វិស្សមកាល រយៈពេល ៣ខែ រដ្ឋសភា នឹង បើក សម័យ ប្រជុំ លើក ទី៣ នីតិកាល ទី៦ នៅ ព្រឹក ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០១៩ ស្អែក នេះ ដោយ មាន របៀបវារៈ ចំនួន ៧ ។ នេះ បើ តាម ការប្រកាស របស់ រដ្ឋសភា ។
កិច្ចប្រជុំ នេះ នឹង ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច ហេង សំរិន ប្រធាន រដ្ឋសភា ក្នុង នោះ របៀបវារៈ ដូច ជា៖
និង ទី៧៖ ការពិភាក្សា និង អនុម័ត សេចក្តីព្រាង ច្បាប់ ស្តីពី របប សន្តិសុខ សង្គម ៕ ប្រទះឃើញ សព ស្ត្រី ម្នាក់ ត្រូវ ឃាតក វាយ សម្លាប់ នៅលើ ផ្ទះ ក្នុង ក្រុង ស្ទឹងត្រែង
( ស្ទឹងត្រែង ) ៖ មាន ករណី ភ្ញាក់ផ្អើល មួយ ដោយ ប្រទះឃើញ សព ស្ត្រី ម្នាក់ ត្រូវបាន ឃាត ក វាយ សម្លាប់ នៅលើ ផ្ទះ ដោយ មិន ទាន់ ដឹង មូលហេតុ សព ស្ត្រី រងគ្រោះ ត្រូវ គេ អះអាង ថា ជា ប្រពន្ធ មន្ត្រី នគរបាល វរ ការពារ ព្រំដែន ៧០១ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ព្រឹក ថ្ងៃទី ៣ ខែតុលា ឆ្នាំ ២០១៩ ស្ថិត នៅ ភូមិ កោះ ខន ឌិន សង្កាត់ សាមគ្គី ក្រុង ស្ទឹងត្រែង ខេត្ត ស្ទឹងត្រែង ។
សព ស្ត្រី រងគ្រោះ មាន ឈ្មោះ ផៃ ណា អាយុ ២៧ ឆ្នាំ រស់ នៅ ភូមិ កោះ ខន ឌិន សង្កាត់ សាមគ្គី ក្រុង ស្ទឹងត្រែង មាន កូន ៤នាក់ ចំណែក ប្តី ឈ្មោះ តី ឯក សូគី នៅ ធ្វើការ នៅ អង្គភាព វរ ការពារ ព្រំដែន ៧០១ ។
មន្ត្រី នគរបាល បាន បញ្ជាក់ ថា សព ស្ត្រី រងគ្រោះ មាន ស្នាម ជាំ ទ្រុឌ ចំនួន ពីរ កន្លែង នៅ ចំណុច ភ្នែក ខាងឆ្វេង និង មួយ កន្លែង ទៀត ក្រោម ចង្កា ខាងឆ្វេង និង មាន ស្នាម ហើម ពក លើ កញ្ចឹងក ។ នៅលើ ខ្លួន សព ស្ត្រី រងគ្រោះ នគរបាល ជំនាញ បាន រកឃើញ ទូរស័ព្ទដៃ មួយ គ្រឿង និង លុយ ចំនួន ៣ម៉ឺន រៀល ក្នុង ហោប៉ៅ ដោយឡែក ក្បែរ សព ជនរងគ្រោះ ជំនាញ បាន ប្រមូល វត្ថុតាង មាន ដំបង ១ បែក ជា២ ជា ច្រវា ទូក ។ ជំនាញ បាន ដាក់ ការសង្ស័យ ថា ជនរងគ្រោះ ត្រូវ ជន ដៃ ដល់ ប្រើប្រាស់ ច្រវា ទូក វាយ សម្លាប់ ក្នុង អំពើ ឃាតកម្ម នេះ ។
បច្ចុប្បន្ន សមត្ថកិច្ចំ នាញ កំពុងតែ ដុត ដុត ជើង ស្រាវជ្រាវ វែក មុខ ជន ដៃ ដល់ នាំមក ផ្តន្ទាទោស តាម ច្បាប់ ។ ចំណែក សព នគរបាល ជំនាញ ក្រោម ការសម្របសម្រួល ពី ព្រះរាជអាជ្ញា បាន ប្រគល់ ជូន គ្រួសារ ធ្វើ បុណ្យ តាម ប្រពៃណី នៅ ផ្ទះ កន្លែង កើត ហេតុ ៕ ក្រុមហ៊ុន ហ្គោល ដេន អេហ្វ អិកស៍ លីង ឃែ ភីថល ចូលរួម ចែករំលែក វិធីសាស្រ្ត ជោគជ័យ សម្រាប់ វិនិយោគិន ក្នុង សិក្ខាសាលា ឧបករណ៍ និស្សន្ទ តាម បណ្ដា ខេត្ត សម្រាប់ ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ហ្គោល ដេន អេហ្វ អិកស៍ លីង ឃែ ភីថល បាន ចូលរួម ក្នុង សិក្ខាសាលា តាម បណ្ដា ខេត្ត នៅ ខេត្ត តាកែវ ដែល រៀបចំឡើង ដោយ គណៈកម្មការ មូលបត្រ កម្ពុជា និង ក្រុមហ៊ុន សមភាគី កណ្តាល ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង ។
សិក្ខាសាលា ដែល រៀបចំ នៅ ខេត្ត តាកែវ នេះ ជា លើក ទី៦ នៃ សិក្ខាសាលា តាម បណ្ដា ខេត្ត ដែល ក្រុមហ៊ុន បាន ចែករំលែក ចំណេះដឹង បទពិសោធន៍ ក៏ ដូចជា វិធីសាស្រ្ត ជោគជ័យ សម្រាប់ វិនិយោគិន បន្ទាប់ពី ខេត្ត កំពង់ចាម ខេត្ត សៀមរាប ខេត្ត បន្ទាយមានជ័យ ខេត្ត បាត់ដំបង និង ខេត្ត ព្រះសីហនុ ។
ប្រធានបទ សម្រាប់ ឆ្នាំ ២០១៩ នេះ ធ្វើឡើង ក្រោម ប្រធានបទ « អ្វី ជា ការជួញដូរ ឧបករណ៍ និស្សន្ទ ការត្រៀមខ្លួន ការវិនិយោគ និង ការយល់ដឹង ពាក់ព័ន្ធ » ផ្ដោត សំខាន់ ទៅ លើ ការផ្សព្វផ្សាយ និង ពង្រីក ការយល់ដឹង អំពី ការវិនិយោគ លើ ឧបករណ៍ និស្សន្ទ នៅ ទូទាំង ប្រទេស ព្រមទាំង បង្កើន ទំនុកចិត្ត សម្រាប់ វិនិយោគិន និង អនុញ្ញាតឱ្យ វិនិយោគិន ត្រៀម ខ្លួន រួចរាល់ សម្រាប់ ការវិនិយោគ លើ វិស័យ ឧបករណ៍ និស្សន្ទ ។
លោក សុខ ដារ៉ា អគ្គ នាយក រង នៃ គណៈកម្មការ មូលបត្រ កម្ពុជា បាន ប្រកាស បើក កម្មវិធី សិក្ខាសាលា តាម បណ្ដា ខេត្ត ឆ្នាំ ២០១៩ នេះ ហើយ បាន បញ្ជាក់ ពី ទិសដៅ របស់ គណៈកម្មការ មូលបត្រ កម្ពុជា ក្នុង ការពង្រឹង បទបញ្ញត្តិ សម្រាប់ ទីផ្សារ ឧបករណ៍ និស្សន្ទ នៅ កម្ពុជា និង បាន លើកទឹកចិត្ត ឱ្យ វិនិយោគិន បង្កើន ចំណេះដឹង ត្រៀមខ្លួន រួចរាល់ ក៏ ដូចជា ជ្រើសរើស ក្រុមហ៊ុន ដែល ទទួលបាន អាជ្ញាបណ្ណ ពី គណៈកម្មការ មូលបត្រ កម្ពុជា ដើម្បី បញ្ចៀស ហានិភ័យ ។
លោក ក៏ បាន សរសើរ ក្រុមហ៊ុន ហ្គោល ដេន អេហ្វ អិកស៍ លីង ឃែ ភីថល ដែល តែងតែ មាន ភាព សកម្ម ក្នុង ការលើកស្ទួយ ស្ដង់ដារ នៃ ការជួញដូរ ឧបករណ៍ និស្សន្ទ និង អនុវត្ត គោលការណ៍ ការពារ វិនិយោគិន ។
លោក ឡុង សំណាង ប្រធាន ផ្នែក ប្រឹក្សា យោបល់ ហិរញ្ញវត្ថុ នៃ ក្រុមហ៊ុន ហ្គោល ដេន អេហ្វ អិកស៍ លីង ឃែ ភីថល បាន សម្តែង ភាពសប្បាយរីករាយ ក្នុង ការចូលរួម ក្នុង សិក្ខាសាលា តាម បណ្ដា ខេត្ត ឆ្នាំ ២០១៩ ជាមួយ គណៈកម្មការ មូលបត្រ កម្ពុជា ។
ក្នុង នោះ លោក បាន ធ្វើ បទបង្ហាញ ស្តីពី « យុទ្ធសាស្រ្ត ក្នុង ការជួញដូរ ឧបករណ៍ និស្សន្ទ » ដែល ផ្តោត ទៅ លើ ចំណេះដឹង អំពី ការជួញដូរ ផលិតផល ឧបករណ៍ និស្សន្ទ ដែល ជា ផលិតផល ដ៏ ពេញនិយម មួយ ក្នុង ចំណោម ផលិតផល ហិរញ្ញវត្ថុ ការ ទប់ស្កាត់ និង ការកាត់បន្ថយ ហានិភ័យ ពី ការវិនិយោគ និង យុទ្ធសាស្រ្ត ល្អ ៗ ដើម្បី ទាញយក ផល គាប់ ប្រសើរ ពី ការវិនិយោគ ។
ក្រោយពី ចូលរួម សិក្ខាសាលា ក្នុង ខេត្ត តាកែវ នេះ ក្រុមហ៊ុន នឹង បន្ត ចូលរួម សិក្ខាសាលា នៅ ខេត្ត កំពត ខេត្ត កែប និង ខេត្ត ផ្សេង ៗ ទៀត នៅ ទូទាំង ប្រទេស កម្ពុជា ។ លទ្ធផល នៃ សិក្ខាសាលា តាម បណ្ដា ខេត្ត នៅ ខេត្ត តាកែវ បាន បង្ហាញ នូវ ភាពជោគជ័យ គួរឱ្យ កត់សម្គាល់ ដោយ ទទួលបាន មិន ត្រឹមតែ ការចូលរួម យ៉ាង ច្រើន កុះករ ប៉ុណ្ណោះ ទេ ថែមទាំង ការគាំទ្រ និង កំណើន នៃ ចំណេះ ជំនាញ របស់ សិក្ខាកាម ។
បន្ទាប់ពី សិក្ខាសាលា ត្រូវបាន បញ្ចប់ សិក្ខាកាម ជាច្រើន នាក់ បាន ស្នើសុំ កិច្ចប្រជុំ ជា លក្ខណៈ ឯកជន និង ជា ក្រុម តូច ៗ ជាមួយ អ្នកជំនាញ របស់ ក្រុមហ៊ុន ដើម្បី ពិភាក្សា លម្អិត ទៅ លើ ការវិនិយោគ មួយ នេះ ៕ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៣ ខែតុលា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ និង ផាក ពិន័យ ជិត ២ពាន់ គ្រឿង
សម្រាប់ លទ្ធផល នៃ ការត្រួតពិនិត្យ រយៈពេល ០៣ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ នគរបាល បាន ត្រួតពិនិត្យ យានយន្ត ចំនួន ១៣.២៤៣ គ្រឿង រកឃើញ យានយន្ត ល្មើស ៤.៥៦៣ គ្រឿង និង ផាក ពិន័យ ៤. ៥៦៣ គ្រឿង ៕ ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង សហការ ជាមួយ គណៈកម្មការ មូលបត្រ កម្ពុជា រៀបចំ សិក្ខាសាលា បង្កើន ចំណេះដឹង ទាក់ទង នឹង ការវិនិយោគ នៅក្នុង ខេត្ត តាកែវ
( តាកែវ )៖ ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិច ឆេង សហការ ជាមួយ គណៈកម្មការ មូលបត្រ កម្ពុជា បាន សហការរៀបចំ សិក្ខាសាលា ដើម្បី បង្កើន ចំណេះដឹង ទាក់ទង នឹង ការវិនិយោគ ការកាត់បន្ថយ ហានិភ័យ នៃ ការវិនិយោគ និន្នាការ នៃ ការវិនិយោគ និង យុទ្ធសាស្រ្ត សម្រាប់ ការវិនិយោគ ជោគជ័យ តាម បណ្ដា ខេត្ត នៅ ខេត្ត តាកែវ ប្រកបដោយ ជោគជ័យ ។
សិក្ខាសាលា ដែល រៀបចំឡើង ក្នុង ខេត្ត តាកែវ នេះ បាន ទាក់ទាញ សិក្ខាកាម ជាង ១០០ នាក់ មកពី វិស័យ ផ្សេង ៗ ចូលរួម ដើម្បី បង្កើន ចំណេះដឹង ទាក់ទង នឹង ការវិនិយោគ ការកាត់បន្ថយ ហានិភ័យ នៃ ការវិនិយោគ . និន្នាការ នៃ ការវិនិយោគ និង យុទ្ធសាស្រ្ត សម្រាប់ ការវិនិយោគ ជោគជ័យ ។
សិក្ខាសាលា នេះ រៀបចំឡើង ក្រោម ការចូលរួម ពី លោក សុខ ដារ៉ា អគ្គ នាយក រង នៃ គណៈកម្មការ មូលបត្រ កម្ពុជា ។
លោក សុខ ដារ៉ា បាន បញ្ជាក់ ពី ទិសដៅ របស់ គណៈកម្មការ មូលបត្រ កម្ពុជា ក្នុង ការពង្រឹង បទបញ្ញត្តិ សម្រាប់ ទីផ្សារ ឧបករណ៍ និស្សន្ទ នៅ កម្ពុជា និង បាន លើកទឹកចិត្ត ឱ្យ វិនិយោគិន បង្កើន ចំណេះដឹង ត្រៀមខ្លួន រួចរាល់ ក៏ ដូចជា ជ្រើសរើស ក្រុមហ៊ុន ដែល ទទួលបាន អាជ្ញាបណ្ណ ពី គណៈកម្មការ មូលបត្រ កម្ពុជា ដើម្បី បញ្ចៀស ហានិភ័យ ។
លោក ក៏ បាន សរសើរ ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៉ិ ឆេង ជា ក្រុមហ៊ុន ឈាន មុខ និង តែងតែ មាន ភាព សកម្ម ក្នុង ការលើកកម្ពស់ ស្ដង់ដារ នៃ ការជួញដូរ ឧបករណ៍ និស្សន្ទ និង អនុវត្ត តាម បទបញ្ញាតិ និង កិច្ច គាំពារ វិនិយោគិន ។
ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៊ិច ឆេង ជា ក្រុមហ៊ុន សមភាគី កណ្តាល មួយ គត់ ដែល សហការ ជាមួយ គណៈកម្មការ មូលបត្រ កម្ពុជា ក្នុង ការរៀបចំ សិក្ខាសាលា តាម បណ្ដា ខេត្ត សម្រាប់ ឆ្នាំ ២០១៩ នេះ ។ ក្រុមហ៊ុន បាន អនុញ្ញាតឱ្យ ក្រុមហ៊ុន ឈ្មួញ ជើង សា ឧបករណ៍ និស្សន្ទ ឆ្នើម របស់ ខ្លួន ចូលរួម ក្នុង ព្រឹត្តិការណ៍ នេះ ផងដែរ ។
ក្រៅពី ការផ្ដល់ ចំណេះ ជំនាញ ក្នុង ការវិនិយោគ ក្រុមហ៊ុន ខេមបូឌាន ដេរី វ៉េទីវ អ៊ិច ឆេង បាន បង្ហាញ នូវ ឱកាស វិនិយោគ ផ្សេង ៗ ទៅកាន់ សាធារណៈ ជន ជាពិសេស វិនិយោគិន នៅ ទូទាំង ប្រទេស កម្ពុជា ។
( ភ្នំពេញ ) ៖ កម្លាំង នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដូនពេញ បាន ឆ្មក់ ចុះបង្ក្រាប ទីតាំង ល្បែង ស៉ី សង មួយ កន្លែង ដែល លួច លាក់ ជួញដូរ និង ចែកចាយ សារធាតុ គ្រឿងញៀន ខុស ច្បាប់ ដោយ ឃាត់ខ្លួន មនុស្ស ប្រុស ស្រី ចំនួន ១៥នាក់ ព្រមទាំង ហូត សម្ភារ មួយចំនួន ។
លោក ម៉ៅ ចាន់ថុន អធិការ រង ទទួលបន្ទុក ផ្នែក គ្រឿងញៀន នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ដូនពេញ បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News ឲ្យដឹង ថា ដោយ អនុវត្តន៍ តាម បទបញ្ជា របស់ លោក ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ និង លោក សុខ ពេញវុធ អភិបាល ដូន ពេញ បាន បើក ការស្រាវជ្រាវ បង្ក្រាប ទីតាំង បើក ល្បែង ស៉ី សង មួយ កន្លែង ដែល លួច លាក់ ជួញដូរ និង ចែកចាយ សារធាតុ ញៀន ដោយ ខុស ច្បាប់ ។
បើ តាម លោក អធិការ រង ជា លទ្ធផល នៃ កិច្ច ប្រតិបត្តិការ នេះ កម្លាំង សមត្ថកិច្ច បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ១៥នាក់ ក្នុង នោះ មាន ស្រី ៧នាក់ . ជនជាតិ ម៉ាឡេស៉ី ២នាក់ និង ដកហូត ម្សៅ ក្រាម ពណ៌ ស ថ្លា សង្ស័យ ជា គ្រឿងញៀន ចំនួន ១២ កញ្ចប់ . ដាវ កែច្នៃ ចំនួន មួយ ដើម . ថង់ សម្រាប់ ច្រក គ្រឿងញៀន មួយចំនួន . ដែក កេះ មួយចំនួន និង ឧបករណ៍ ប្រើប្រាស់ មួយចំនួន ។
ក្រោយពី ធ្វើ ការឆែកឆេរ រួច មក កម្លាំង នគរបាល ជំនាញ បាន នាំ ខ្លួន ជនសង្ស័យ ប្រុស ស្រី ចំនួន ១៥ នាក់ ខាងលើ រួម ជាមួយ វត្ថុតាង យក ទៅ អធិការ ខណ្ឌ ដូនពេញ ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ច្បាប់ ៕ លោក វង្សី វិស្សុត បាន បង្ហាញ ពី សក្តានុពល របស់ កម្ពុជា នៅ វេទិកា ហេដ្ឋារចនាសម្ព័ន្ធ អាស៊ី ឆ្នាំ ២០១៩
( ភ្នំពេញ ) ៖ លោក វង្សី វិស្សុត អនុប្រធាន ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ត្រូវបាន អញ្ជើញ ចូលរួម ជា វាគ្មិន ក្នុង កម្រិត ពិភាក្សា ថ្នាក់ដឹកនាំ ស្តីពី « ការពង្រឹង ភាពជាដៃគូ ដើម្បី សម្រេច ចក្ខុ - វិស័យ ហេដ្ឋារចនាសម្ព័ន្ធ ប្រចាំ តំបន់ អាស៊ី » នៅក្នុង « វេទិកា ហេដ្ឋារចនាសម្ព័ន្ធ អាស៊ី ឆ្នាំ ២០១៩ » ដែល បាន ប្រព្រឹត្តិ ទៅ ចាប់ ពី ថ្ងៃទី ០២ ដល់ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នៅ ប្រទេស សឹង្ហបុរី ។
( សៀមរាប ) ៖ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩. សមាគម ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ខេត្ត សៀមរាប រៀបចំ មហាសន្និបាត អាណត្តិ ទី៣ ដោយ បាន ជ្រើសរើស លោក សាម ឡម ចៅសង្កាត់ សាលា កំរើក ជា ប្រធាន និង អនុប្រធាន ចំនួន ០៨ រូប ផ្សេង ទៀត ដោយ ទទួល សម្លេង ឆ្នោត គាំទ្រ ២៦២ សន្លឹក និង មិន គាំទ្រ ៤សន្លឹក ។
មហាសន្និបាត ប្រព្រឹត្តិ ទៅ ក្រោម អធិបតីភាព លោក អ៉ឹង ហឿន ប្រធាន ក្រុមប្រឹក្សា ខេត្ត សៀមរាប លោក នាក់ ណេរ៉ុន អភិបាល រង ខេត្ត សៀមរាប និង លោក ស យ កុសល ប្រធាន សម្ព័ន្ធភាព ជាតិ ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ។
អ្នកចូលរួម មហាសន្និបាត សរុប ៣៤៧ នាក់ ក្នុង នោះ ប្រតិភូ ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ចំនួន ២៩៥ នាក់ មក ពី ក្រុង ស្រុក ទាំង ១២ និង ឃុំ សង្កាត់ ទាំង ១០០ ។
សមាគម ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ខេត្ត សៀមរាប ត្រូវបាន បង្កើតឡើង ក្នុង គោលបំណង លើកកម្ពស់ ឋានៈ អភិវឌ្ឍ មត្ថភាព និង ការពារ ផលប្រយោជន៍ ស្រប ច្បាប់ របស់ ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ដែល ជា សមាជិក សមាគម គឺ ក្រុង ១ ស្រុក ១១ ឃុំ ៨៨ និង សង្កាត់ ចំនួន ១២៕
កិច្ចប្រជុំ លើក ទី ១៥ រដ្ឋមន្ត្រី បរិស្ថាន អាស៊ាន នេះ នឹង ពិនិត្យ ពិភាក្សា លើ កិច្ចសហប្រតិបត្តិការ ថ្នាក់ តំបន់ លើ វិស័យ បរិស្ថាន ក្នុង នោះ រួម មាន បញ្ហា ទាក់ទង នឹង ការប្រែប្រួល អាកាសធាតុ និរន្តរភាព បរិស្ថាន ទីក្រុង ការអភិរក្ស ជីវៈ ចម្រុះ បរិស្ថាន តំបន់ ឆ្នេរសមុទ្រ ការងារ អប់រំ បរិស្ថាន ការគ្រប់គ្រង ធនធាន ទឹក ការគ្រប់គ្រង សារធាតុ គីមី និង សំណល់ គ្រោះថ្នាក់ ការគ្រប់គ្រង ការ បំពុល ផ្សែង អ័ព្ទ ឆ្លង ដែន និង សាលា មេត្រីភាព បរិស្ថាន ជាដើម ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ ក្រសួង បរិស្ថាន បាន ឱ្យដឹង បន្ថែម ថា ឯកសារ សំខាន់ ចំនួន ៣ នឹង ត្រូវ យកមក ពិនិត្យ និង អនុម័ត រួម មាន៖
១៖ សេចក្តីព្រាង សេចក្តីថ្លែងការណ៍ រួម អាស៊ាន ស្តីពី ការប្រែប្រួល អាកាសធាតុ នៅ កិច្ចប្រជុំ កំពូល លើក ទី២៥ នៃ អនុសញ្ញា ក្របខណ្ឌ សហ ប្រជាជាតិ ស្តីពី ការប្រែប្រួល អាកាសធាតុ (COP25-UNFCCC) ២៖ សេចក្តីព្រាង ផែនការ យុទ្ធសាស្ត្រ អាស៊ាន ស្តីពី បរិស្ថាន ៣៖ សំណើ សុំ ដាក់បញ្ចូល ឧទ្យាន ជាតិ របស់ ប្រទេស ថៃ វៀតណាម មីយ៉ាន់ម៉ា សរុប ចំនួន ៥ ទៅជា ឧទ្យាន បេតិកភណ្ឌ អាស៊ាន ។
ជាមួយគ្នា នេះ ដែរ កម្ពុជា នឹង ទទួល រៀបចំ ពិធី ប្រគល់ ពានរង្វាន់ សាលា មេត្រីភាព បរិស្ថាន អាស៊ាន លើក ទី៣ និង យុវជន ឆ្នើម មេត្រីភាព បរិស្ថាន អាស៊ាន លើក ទី១ សម្រាប់ រដ្ឋ ជា សមាជិក អាស៊ាន ទាំងអស់ តាមរយៈ មូលនិធិ សមាហរណកម្ម អាស៊ាន - ជប៉ុន ។ នៅក្នុង ក្របខណ្ឌ នៃ កិច្ចប្រជុំ រដ្ឋមន្ត្រី បរិស្ថាន អាស៊ាន លើក ទី ១៥ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នេះ ក៏ នឹង មាន ពិធី ដាំ ដើម ផ្កា ក្រវ៉ាន់ នៅមុខ ប្រាង្គ ប្រាសាទ អង្គរ ផងដែរ ។
សូម ជម្រាប ជូន ថា កិច្ចប្រជុំ រដ្ឋមន្ត្រី បរិស្ថាន អាស៊ាន តែងតែ ធ្វើ រៀងរាល់ ២ឆ្នាំ ម្តង ក្នុង គោលបំណង ជជែក ពិភាក្សា អំពី កិច្ច សហប្រតិបត្តិការ បរិស្ថាន នៅក្នុង តំបន់ ។ កិច្ចប្រជុំ លើក ទី ១៤ រដ្ឋមន្រ្តី បរិស្ថាន អាស៊ាន និង កិច្ចប្រជុំ ពាក់ព័ន្ធ រួមទាំង កិច្ចប្រជុំ ជាមួយ បណ្តា ប្រទេសជា ដៃគូ សន្ទនា ត្រូវបាន ប្រារព្ធ ធ្វើឡើង កាលពី ខែកញ្ញា ឆ្នាំ ២០១៧ នៅ ប្រទេស ប្រ៊ុយណេ ដែល ជា ប្រទេស ម្ចាស់ ផ្ទះ ៕
( ភ្នំពេញ ) ៖ សម្រាប់ ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០១៩ ខាងមុខ នេះ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ (NEA) នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នឹង សហការ ជាមួយ ក្រុមហ៊ុន ធំ ៗ ចំនួន ១១ រៀបចំ វេទិកា ការងារ ដើម្បី ជ្រើសរើស កម្លាំង ពលកម្ម ចំនួន ១.៣៧៥ កន្លែង ទៀត ហើយ ។
ដូច្នេះ សម្រាប់ សិស្ស និស្សិត និង អ្នក កំពុង ស្វែងរក ការងារ ធ្វើ កុំ ភ្លេច ត្រៀម និង យក ប្រវត្តិ រូប សង្ខេប (CV) ដើម្បី ចូលរួម ដាក់ពាក្យ ផ្ទាល់ និង សម្ភាស ផ្ទាល់ ជាមួយ អ្នកតំណាង ក្រុមហ៊ុន ចាប់ពី ម៉ោង ០៨៖០០ នាទី ព្រឹក ដល់ ម៉ោង ០៥៖០០ នាទី ល្ងាច នៅ មជ្ឈមណ្ឌល ការងារ រាជធានី ភ្នំពេញ ស្ថិត នៅក្នុង ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ។
លោក យស់ យឿន ចៅសង្កាត់ រតនៈ ត្រូវបាន មហាសន្និបាត បោះឆ្នោត ជ្រើសតាំង ជា ប្រធាន សមាគម ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ខេត្ត បាត់ដំបង
( បាត់ដំបង ) ៖ សមាគម ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ខេត្ត បាត់ដំបង នៅ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ បាន រៀបចំ មហាសន្និបាត អាណត្តិ ទី៣ ដោយ បាន ជ្រើសរើស លោក យស់ យឿន ចៅសង្កាត់ រតនៈ នៃ ក្រុង បាត់ដំបង ជា ប្រធាន និង អនុប្រធាន ចំនួន ០៨ រូប ផ្សេង ទៀត ដោយ ទទួល សម្លេង ឆ្នោត គាំទ្រ ចំនួន ២៩៦ សន្លឹក និង មិន គាំទ្រ ២ សន្លឹក ។
មហាសន្និបាត ប្រព្រឹត្តិ ទៅ ក្រោម អធិបតីភាព លោក អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត បាត់ដំបង លោក ងួន រតនៈ អភិបាល ខេត្ត បាត់ដំបង និង លោក សំរិទ្ធិ អេង អនុប្រធាន សម្ព័ន្ធភាព ជាតិ ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ។
អ្នកចូលរួម មហាសន្និបាត សរុប ៤២៧ នាក់ ក្នុង នោះ ប្រតិភូ ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ចំនួន ៣៣៦ នាក់ មក ពី ក្រុង ស្រុក ទាំង ១៤ និង ឃុំ សង្កាត់ ទាំង ១០២ ។
សមាគម ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ខេត្ត បាត់ដំបង ត្រូវបាន បង្កើតឡើង ក្នុង គោលបំណង លើកកម្ពស់ ឋានៈ អភិវឌ្ឍ មត្ថភាព និង ការពារ ផលប្រយោជន៍ ស្រប ច្បាប់ របស់ ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ ដែល ជា សមាជិក សមាគម គឺ ក្រុង ១ ស្រុក ១៣ ឃុំ ៩២ និង សង្កាត់ ចំនួន ១០៕
លោក ប៉ែន ស៊ីម៉ន ជួប សំណេះសំណាល ជាមួយ សិស្ស ជាប់ បាក់ឌុប ៤. ១១៦ នាក់ នៅ ខេត្ត កំពត និង ផ្តល់ រង្វាន់ ម៉ូតូ ដល់ សិស្ស និទ្ទេស A
លោក អភិបាល ខេត្ត ជា វ តាយ បាន ឲ្យដឹង អំពី ស្ថានភាព វឌ្ឍនភាព នៃ វិស័យ អប់រំ ក្នុង ខេត្ត កំពត ។ ជាក់ស្ដែង ជា លទ្ធផល នៃ ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ ២០១៩ នា សម័យ ប្រឡង ថ្ងៃទី ១៩ ខែសីហា ឆ្នាំ ២០១៩ នេះ សម្រាប់ ខេត្ត កំពត មាន បេក្ខជន បាន មក ប្រឡង សរុប ចំនួន ៥. ១៤៥ នាក់ ស្រី ២. ៦៣៥នាក់ ។
វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ នៅ ខណ្ឌ បឹងកេងកង . ពលរដ្ឋ សំណូមពរ ច្រើន ពាក់ព័ន្ធ ការងារ សាធារណការ និង បញ្ហា សំរាម . សុំ ឲ្យ អាជ្ញាធរ រាជធានី ភ្នំពេញ ជួយ ដោះស្រាយ
( ភ្នំពេញ ) ៖ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី ដែល បាន ធ្វើឡើង នៅ សាល ប៊ែល ធី ខណ្ឌ បឹងកេងកង នា ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ ប្រជាពលរដ្ឋ បាន លើកឡើង ជា សំណើរ និង សំណូមពរ ច្រើន ពាក់ព័ន្ធ ការងារ សាធារណការ និង បញ្ហា សំរាម ដើម្បីឲ្យ អាជ្ញាធរ រាជធានី ភ្នំពេញ ជួយ ដោះស្រាយ ជូន ពួកគាត់ ។
វេទិកា នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ប៉ា សុជាតិ វង្ស ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ . លោក កើត ឆែ អភិបាល រង រាជធានី ភ្នំពេញ តំណាង ឲ្យ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ . លោក សំហេង បុរស ប្រធាន ក្រុមការងារ ចុះ ជួយ ខណ្ឌ បឹងកេងកង . លោក ធឹម សំអាន អភិបាល ខណ្ឌ បឹងកេងកង . លោក អធិការ ខណ្ឌ និង មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា មន្ត្រី ចំណុះ ឲ្យ រដ្ឋបាល រាជធានី ព្រមទាំង ប្រជាពលរដ្ឋ រាប់ រយ នាក់ ។
លោក បន្ត ថា វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី នេះ នឹង ផ្តល់ ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង ការចូលរួម ក្នុង ដំណើរការ អភិបាលកិច្ច ល្អ និង ជា ឧបករណ៍ មួយ សម្រាប់ លើក កំពស់ គណនេយ្យភាព តម្លាភាព ក្នុង ដំណើរការ ពិនិត្យមើល លើ ការផ្តល់ សេវា សាធារណៈ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ក្នុង គោលបំណង ដើម្បី ធានា ថា រាល់ បញ្ហា អាទិភាព របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ត្រូវបាន ពិនិត្យ ដោះស្រាយ និង ឆ្លើយតប ។
លោក បន្ដ ថា គ្រប់ អ្នក ពាក់ព័ន្ធ ទាំងអស់ ក្នុង មូលដ្ឋាន ត្រូវបាន រួមបញ្ចូល បរិយាប័ន នៅក្នុង ដំណើរការ នៃ ការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ។ ម្យ៉ាងទៀត ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ មាន គោលបំណង ជំរុញ នូវ ប្បធម៌ នៃ ការពិភាក្សា និង លើក កំពស់ គណនេយ្យភាព តាម បែប ប្រជាធិបតេយ្យ ។
លោក ប៉ា សុជាតិ វង្ស បាន បញ្ជាក់ ទៀត ថា សម្រាប់ វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ ដែល បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ០៣ តុលា ២០១៩នេះ ប្រជាពលរដ្ឋ បាន លើកឡើង ជា សំណើរ និង សំណូមពរ ច្រើន ពាក់ព័ន្ធ ការងារ សាធារណការ និង បញ្ហា សំរាម ដើម្បីឲ្យ អាជ្ញាធរ រាជធានី ភ្នំពេញ ជួយ ដោះស្រាយ ជូន ពួកគាត់ ក្នុង នោះ រួម មាន៖ សំណើរ និង សំណូមពរ ដោយ ផ្ទាល់ មាត់ ចំនួន ១៦ នាក់ ស្មើ និង ១៩ បញ្ហា និង សំណើរ សំណូមពរ ជា លាយលក្ខណ៍ អក្សរ ចំនួន ៧២ សន្លឹក ។
លោក បន្ដ ថា បញ្ហា ដែល ជា កង្វល់ នេះ ភាគ ច្រើន ប្រជាពលរដ្ឋ ចង់ឲ្យ អាជ្ញាធរ ជួយ ពួកគាត់ ក្នុង រួម មាន ការ ជំរុញ ឲ្យ កាត់ មែក ឈើ ដែល បាំង បង្គោល ភ្លើង បំភ្លឺ ផ្លូវ សាធារណៈ ការជួសជុល ផ្លូវ ដែល ទទួលរង ការខូចខាត នៅក្នុង មូលដ្ឋាន ហើយ បញ្ហា ដែល ប្រឈម ខ្លាំង ជាង គេ នោះ គឺ បញ្ហា សំរាម ដែល ធ្វើឲ្យ បាត់បង់ សណ្តាប់ធ្នាប់ និង បរិស្ថាន យ៉ាង ធ្ងន់ធ្ងរ ។
លោក បន្ត ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី តែងតែ ធ្វើ ការណែនាំ ឲ្យ អាជ្ញាធរ រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ ដោះស្រាយ បញ្ហា ស្ទះ៣ នោះ គឺ ការដោះស្រាយ ការកកស្ទះ ចរាចរ ស្ទះ លូ និង ស្ទះ សំរាម ។ បញ្ហា ៣នេះ ហើយ ដែល ជា កង្វល់ របស់ បងប្អូន ប្រជាពលរដ្ឋ ប្រចាំ ថ្ងៃ ព្រោះថា នៅ ភ្នំពេញ យើង បច្ចុប្បន្ន នេះ មាន ការអភិវឌ្ឍ រីកចំរើន យ៉ាង ខ្លាំង ដែល ធ្វើឲ្យ មាន កំណើន យានយន្ត និង មនុស្ស កើនឡើង ជាលំដាប់ ។
លោក ប៉ា សុជាតិ វង្ស បន្ដ ទៀត ថា មកដល់ ពេលនេះ ប្រជាពលរដ្ឋ នៅ ភ្នំពេញ មាន រហូតដល់ទៅ ៣លាន ៥០ម៉ឺន នាក់ ទៅ ហើយ ដោយ ក្នុង នោះ ប្រជាពលរដ្ឋ ដែល បាន ចុះ ស្ថិតិ មាន ចំនួន ២លាន ៣សែន នាក់ ប្រជាពលរដ្ឋ ដែល ចំណាកស្រុក មក បំពេញ ការងារ នៅ ភ្នំពេញ មាន ចំនួន ៨០ម៉ឺន នាក់ ជាមួយនិង អ្នកទេសចរណ៍ រាប់ សិប ម៉ឺន នាក់ ទៀត ។
ក្នុង ឱកាស នោះ ដែរ លោក ប៉ា សុជាតិ វង្ស ក៏ បាន ជំរុញ ឲ្យ មាន ការចូលរួម ហូប អំបុក នៅ រមណីយដ្ឋាន វត្តភ្នំ ទាំងអស់ គ្នា ផង ស្រប ពេល ដែល ទណ្ឌិត សម រង្ស៊ី ប្រើ យុទ្ធនាការ ម្រាម ៩ ចង់ បង្កើត ឲ្យ មាន បដិវត្ត ពណ៌ ប្រឆាំង រាជ រដ្ឋាភិបាល ។
ដោយឡែក បញ្ហា សំរាម វិញ លោក កើត ឆែ បាន បញ្ជាក់ ផងដែរ ថា សំរាម ជា បញ្ហា របស់ យើង ទាំងអស់ គ្នា ដែល ត្រូវ ប្រឈមមុខ ដោះស្រាយ ហើយ បញ្ហា នេះ បើ មិន មាន ការចូលរួម ការភ្ញាក់ រលឹក ពី ប្រជាពលរដ្ឋ យើង អនុវត្ត មិន បាន ជោគជ័យ នោះ ទេ ។ លោក ថា បញ្ហា នេះ ការអប់រំ ណែនាំ ប្រជាពលរដ្ឋ វា ជា រឿង សំខាន់ ដែល អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ត្រូវ រួមគ្នា អប់រំ ណែនាំ ប្រជាពលរដ្ឋ ឲ្យ ពួកគាត់ ចេះ ទុកដាក់ សម្រាម ឲ្យបាន ត្រឹមត្រូវ និង បញ្ជ្រៀប ការយល់ដឹង ពី ផល ប៉ះពាល់ នៃ សម្រាម នេះ ៕
ទេសរដ្ឋមន្ត្រី ចម ប្រសិទ្ធ៖ អនាគត បច្ចេកវិទ្យា ឌីជីថល នៅ កម្ពុជា នឹង បើក ផ្លូវ ទទួលយក ការវិនិយោគ
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ចម ប្រសិទ្ធ រដ្ឋមន្ត្រី ក្រសួង ឧស្សាហកម្ម និង សិប្បកម្ម បាន ថ្លែង ថា អនាគត បច្ចេកវិទ្យា ឌីជីថល នៅ កម្ពុជា នឹង បើក ផ្លូវ ទទួលយក ការវិនិយោគ នៅក្នុង សេដ្ឋកិច្ច ឌីជីថល និង ឈាន ទៅ ពង្រឹង វិស័យ ដែល ជា ឆ្អឹង ខ្នង សេដ្ឋកិច្ច ដ៏ សំខាន់ របស់ ប្រទេស កម្ពុជា និង បង្កើត ជា វិស័យ ថ្មី ទៀត ។
លោក ទេសរដ្ឋមន្ត្រី ចម ប្រសិទ្ធ បាន ថ្លែង ទៀត ថា ទិដ្ឋភាព អាជីវកម្ម ដែល កំពុង វិវឌ្ឍន៍ យ៉ាង ឆាប់រហ័ស នៅ កម្ពុជា ទាំងអស់ ពឹងផ្អែក កាន់តែ ខ្លាំង លើ បច្ចេកវិទ្យា ឌីជីថល ដើម្បី គាំទ្រ ដល់ អាជីវកម្ម ថ្មី ៗ និង អាជីវកម្ម កំពុង ដំណើរការ ស្រាប់ ព្រមទាំង គាំទ្រ ដល់ ភាពស្មុគស្មាញ ដែល កើតឡើង កាន់តែ ខ្លាំង ឡើង នៅក្នុង ការគ្រប់គ្រង ប្រតិបត្តិការ ។
លោក បញ្ជាក់ ថា នៅពេល អង្គភាព នានា នៅ កម្ពុជា មាន លក្ខណៈ កាន់តែ ធំ ទៅ ៗ និង កាន់តែ ស្មុគស្មាញ ទាមទារ ឲ្យ មាន ផែនការ យ៉ាង ហ្មត់ចត់ ដើម្បី កាត់បន្ថយ និង បង្រួម អប្បបរមា ពេលវេលា និង កាត់បន្ថយ ការគំរាមកំហែង ដល់ អាទិភាព ប្រតិបត្តិការ ។
បើ តាម អ្នកជំនាញ លើកឡើង ថា កម្ពុជា អាច តភ្ជាប់ ទំនាក់ទំនង ទៅកាន់ អ្នកជំនួញ ខាង ឌីជីថល និង សហគ្រិន បច្ចេកវិទ្យា ដើម្បី ទាញយក កម្លាំង នៃ បច្ចេកវិទ្យា នៅក្នុង ឧស្សាហកម្ម ៤.០ សម្រាប់ ការផ្លាស់ប្តូរ ផលិតផល និង សេវាកម្ម ដែល មាន លក្ខណៈ ប្រកួតប្រជែង នៅក្នុង ខ្សែ សង្វាក់ តម្លៃ សកល និង បណ្តាញ ផលិតកម្ម ។
អគ្គ នាយក ពន្ធដារ៖ ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ គឺជា ដៃគូ យ៉ាង សំខាន់ ក្នុង ការផ្តល់ សេវាកម្ម ពន្ធដារ ដើម្បី ចូលរួម សម្រេច ឱ្យ បាន នូវ យុទ្ធសាស្រ្ត កៀរ គរ ចំណូល
( ភ្នំពេញ ) ៖ លោក គង់ វិបុល ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៅ ថ្ងៃទី ០៣ ខែតុលា នេះ បាន ថ្លែង ចាត់ទុក ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ គឺជា ដៃគូ យ៉ាង សំខាន់ ក្នុង ការផ្តល់ សេវាកម្ម ពន្ធដារ ដើម្បី ចូលរួម សម្រេច ឱ្យ បាន នូវ យុទ្ធសាស្រ្ត កៀរ គរ ចំណូល ។
ការថ្លែង យ៉ាង ដូច្នេះ របស់ លោក គង់ វិបុល ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី បើក សិក្ខាសាលា ផ្សព្វផ្សាយ ស្ដីពី « សិទ្ធិ និង កាតព្វកិច្ច របស់ ភា្នក់ងារ សេវាកម្ម ពន្ធដារ » ។
លោក ឧកញ៉ា សុខ ពិសិដ្ឋ សហ ប្រធាន ក្រុមការងារ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង ផ្នែក ឯកជន បាន លើកឡើង អំពី សារៈសំខាន់ នៃ ចំណេះដឹង ផ្នែក ពន្ធដារ ដែល ជា ចំណេះដឹង មូលដ្ឋាន ដែល ពាណិជ្ជករ គ្រប់ រូប ត្រូវ ចេះដឹង ក្នុង ការធ្វើ អាជីវកម្ម ព្រមទាំង បាន គូសបញ្ជាក់ អំពី វឌ្ឍនភាព នៃ កំណែទម្រង់ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ដែល ផ្ដល់ ភាពងាយស្រួល ដល់ អ្នក ជាប់ ពន្ធ ក្នុង ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ ។
លោក គង់ វិបុល បាន សម្ដែង នូវ កិច្ច ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ វត្តមាន របស់ លោក ឧកញ៉ា ប្រធាន ក្រុមការងារ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង ផ្នែក ឯកជន តំណាង ក្រុមប្រឹក្សា ជាតិ គណនេយ្យ តំណាង សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា ថ្នាក់ដឹកនាំ និង មន្ត្រី នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ និង លោក លោកស្រី នាង កញ្ញា ជា ម្ចាស់ និង តំណាង សហគ្រាស ដែល បាន ឆ្លៀត ពេលវេលា ដ៏ មាន តម្លៃ ចូលរួម ក្នុង សិក្ខាសាលា នា ព្រឹក នេះ ។
លោក ក៏ បាន គូសបញ្ជាក់ អំពី កិច្ចសហការ ជិតស្និទ្ធ រវាង រដ្ឋបាល សារពើពន្ធ និង វិស័យ ជន និង ការបន្ត ធ្វើ កំណែទម្រង់ នានា បន្ត ទៀត ដើម្បី ធានា នូវ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ ក៏ ដូចជា ដើម្បី ផ្ដល់ ភាពងាយស្រួល ជូន ដល់ អ្នក ជាប់ ពន្ធ ក្នុង ការបំពេញ កាតព្វកិច្ច សារពើពន្ធ ។
លោក អគ្គ នាយក ក៏ បាន ជម្រាប ជូន អង្គ សិក្ខាសាលា ផងដែរ ថា សិក្ខាសាលា នេះ ត្រូវបាន រៀបចំឡើង សម្រាប់ សហគ្រាស ដែល ទទួលបាន អាជ្ញាប័ណ្ណ ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ ដែល មាន ការកើនឡើង ជារៀងរាល់ ថ្ងៃ ។ ជាក់ស្ដែង គិត ត្រឹម ខែកញ្ញា ឆ្នាំ ២០១៩ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន បណ្ដុះបណ្ដាល បេក្ខជន ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ ចំនួន ៤ ៥២៨ នាក់ និង មាន បេក្ខជន ប្រឡង ជាប់ ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ ចំនួន ៩៩៥ នាក់ ក្នុង នោះ សហគ្រាស ដែល ទទួលបាន អាជ្ញាប័ណ្ណ ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ មាន ចំនួន ២១០ សហគ្រាស ។
លោក បញ្ជាក់ ថា « ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ គឺជា ដៃគូ យ៉ាង សំខាន់ របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ ក្នុង ការផ្តល់ សេវាកម្ម ពន្ធដារ ដើម្បី ចូលរួម សម្រេច ឱ្យ បាន នូវ គោលបំណង នៃ យុទ្ធសាស្រ្ត កៀរ គរ ចំណូល ឆ្នាំ ២០១៩ - ២០២៣ » ។
តាម របៀបវារៈ ដែល បាន គ្រោង ទុក អង្គ សិក្ខាសាលា បាន រៀបចំ ឱ្យ មាន ការធ្វើ បទបង្ហាញ នូវ ប្រធានបទ សំខាន់ ៗ ជូន សិក្ខាកាម រួម មាន បទ បង្ហាញ ស្ដី ពី៖
១៖ ប្រព័ន្ធ បច្ចេកវិទ្យា ព័ត៌មាន របស់ អគ្គ នាយកដ្ឋាន ពន្ធដារ សម្រាប់ ផ្ដល់ សេវាកម្ម ពន្ធដារ ជូន អ្នក ជាប់ ពន្ធ ២៖ សិទ្ធិ និង កាតព្វកិច្ច របស់ ភា្នក់ងារ សេវាកម្ម ពន្ធដារ ៣៖ លក្ខណ វិនិច្ឆ័យ និង អត្ថប្រយោជន៍ ដែល ទទួលបាន ពី ការវាយតម្លៃ កម្រិត អនុលោម ភាព សារពើពន្ធ និង ៤៖ វិធាន នៃ ការប្រើប្រាស់ វិក្កយបត្រ សម្រាប់ អ្នក ជាប់ ពន្ធ ដែល បាន ចុះបញ្ជី ពន្ធដារ តាម របប ស្វ័យប្រកាស ។
លោក គង់ វិបុល ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ ការចូលរួម របស់ សិក្ខាកាម ដែល ជា អ្នកបម្រើការ ក្នុង វិស័យ ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ ដែល បាន ចូលរួម ជា ការផ្ដល់ សំណួរ យោបល់ និង មតិ ស្ថាបនា ដើម្បី រដ្ឋបាល សារពើពន្ធ អាច យក ធ្វើជា មូលដ្ឋាន សម្រាប់ ធ្វើ ការសិក្សា បន្ថែម ពិចារណា និង កែលម្អ បន្ថែម ទៀត ដើម្បី ឈាន ទៅដល់ ការសម្រេច គោលបំណង សំខាន់ ពីរ នៃ យុទ្ធសាស្រ្ត កៀរ គរ ចំណូល ឆ្នាំ ២០១៩ - ២០២៣ ព្រមទាំង ពង្រឹង នូវ ប្រសិទ្ធភាព និង តម្លាភាព នៃ ការគ្រប់គ្រង ប្រមូល ចំណូល ពន្ធ ។
លោក បាន សំណូមពរ ដល់ ម្ចាស់ និង អ្នកតំណាង សហគ្រាស ដែល ទទួលបាន អាជ្ញាប័ណ្ណ ភ្នាក់ងារ សេវាកម្ម ពន្ធដារ ដែល ជា សិក្ខាកាម ទាំងអស់ ចែករំលែក ចំណេះដឹង ដែល បាន ទទួល ព្រឹក នេះ បន្ត ទៅ ឱ្យ សហការី ដែល មិន បាន ចូលរួម ក្នុង គោលដៅ បន្ត បង្កើន និង ធ្វើ បច្ចុប្បន្នភាព ចំណេះដឹង និង ជំនាញ ទាក់ទិន នឹង វិជ្ជាជីវៈ របស់ ខ្លួន ដើម្បីឱ្យ ការផ្តល់ សេវា ឱ្យ អ្នក ជាប់ ពន្ធ ប្រកបដោយ គុណភាព និង វិជ្ជាជីវៈ និង អនុវត្ត ការងារ របស់ ខ្លួន ឱ្យ បាន ត្រឹមត្រូវ ទាន់ ពេលវេលា និង ចូលរួម ទប់ស្កាត់ បាន នូវ អំពើ គេចវេះ ពន្ធ ។
យ៉ាងណាមិញ លោក សេង ពន្លក អធិការ នគរបាល ស្រុក ពាមរក៍ បាន ឲ្យដឹង ថា រថយន្ត រងគ្រោះ ម៉ាក ស្តារិច ស៊េរី ឆ្នាំ ២០១៩ ពណ៌ ខ្មៅ ស្លាកលេខ ភ្នំពេញ 2BC-5354 បើកបរ ដោយ ឈ្មោះ វាល ចន្ទ័ ដារិទ្ធ ភេទ ប្រុស អាយុ ៤៨ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ វិជ្ជបណ្ឌិត នៅ ភូមិ ពន្លា សង្កាត់ ព្រែក ប្រា ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ រថយន្ត រង ការខូចខាត ផ្នែក ខាងមុខ និង ខាងក្រោយ ។
ចំណែក រថយន្ត បង្ក ម៉ាក ហ៉ី យិន ដាយ ពណ៌ បៃតង ស្លាកលេខ ស្វាយរៀង 3A-0809 បើកបរ ដោយ ឈ្មោះ ហ៊ួត បញ្ញា ជនជាតិ ខ្មែរ មុខរបរ បើកបរ រស់ នៅ ភូមិ កំពង់ចម្លង ឃុំ កំពង់ចម្លង ស្រុក លើក ដែក ខេត្ត កណ្តាល រថយន្ត រង ការខូចខាត ផ្នែក ខាងមុខ ។
លោក អធិការ បញ្ជាក់ ថា មូលហេតុ ដោយសារ រថយន្ត ធុន ធំ ដឹក ជី បើក បុក ពីក្រោយ រថយន្ត ហ៉ី យិន ដាយ ស្តារិច ចំពោះ គ្រោះថ្នាក់ ខាងលើ មិន បណ្តាលឲ្យ មាន មនុស្ស រងរបួស ទេ រីឯ រថយន្ត ទាំង ពីរ យកមក រក្សាទុក នៅ ប៉ិស្តិ៍ រដ្ឋបាល ឃុំ អ្នកលឿង ដោយ ប៉ុស្តិ៍ រដ្ឋបាល ឃុំ ព្រែក ខ្សាយ ( ក) មាន ភាពចង្អៀត ពេក ។
របាយការណ៍ នេះ រួម មាន៖ ១៖ ដំណោះស្រាយ ផល ប៉ះពាល់ ពី ការប្រែប្រួល អាកាសធាតុ លើ កំណើន សេដ្ឋកិច្ច ក្នុង ប្រទេស កម្ពុជា និង ២៖ ការកាត់បន្ថយ ហានិភ័យ វិនិយោគ ក្នុង វិស័យ ថាមពល កកើត ឡើងវិញ នៅ ប្រទេស កម្ពុជា » ។
បើ យោង តាម សេចក្តីជូនដំណឹង របស់ ក . ជ. អ. ច . ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន ពិធី ប្រកាស នេះ នឹង ធ្វើឡើង នៅ ថ្ងៃសុក្រ ទី ០៤ ខែតុលា ឆ្នាំ ២០១៩ នៅ សណ្ឋាគារ សូហ្វីតែ ល ភូគី ត្រា រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោក សាយ សំអាល់ ប្រធាន ក្រុមប្រឹក្សា ជាតិ អភិវឌ្ឍន៍ ដោយ ចីរភាព និង ជា រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន និង លោក រស់ សីល វ៉ា អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។
របាយការណ៍ ទាំង ពីរ នេះ ត្រូវបាន រៀបចំឡើង ក្នុង គោលដៅ ចូលរួម កាត់បន្ថយ ហានិភ័យ និង ជួយ សម្របសម្រួល នូវ បរិយាកាស អំណោយផល សម្រាប់ វិនិយោគិន វិស័យ ឯកជន ដែល មាន បំណង វិនិយោគ លើ វិធានការបន្ស៉ី ទៅនឹង ការប្រែប្រួល អាកាសធាតុ និង លើ ថាមពល ពន្លឺ ព្រះអាទិត្យ នៅ កម្ពុជា ៕ ពលរដ្ឋ ក្រីក្រ នៅ សង្កាត់ ពន្សាំង ខណ្ឌ ព្រែក ព្នៅ បាន ទទួល អំណោយ ពី សប្បុរសជន សម្រាប់ បន្ត ជីវភាព ប្រចាំ ថ្ងៃ
( ភ្នំពេញ ) ៖ ប្រជាពលរដ្ឋ រស់ នៅក្នុង ភូមិ កន្លែង គល់ ចំនួន ២គ្រួសារ ដែល កំពុង ជួប ការលំបាក និង ជិវិភាព ខ្វះខាត ហើយ សព្វ ថ្ងៃ រស់ នៅ លើ ចិញ្ចើ មផ្លូវ ក្នុង ភូមិ ត្រូវ ប្រឈម បញ្ហា ជាច្រើន បាន ទទួល អំណោយ ពី លោក ហ៊ុយ សាវឿន ហៅ ឌេល និង ភរិយា តាមរយៈ លោក ប្រធាន ប្រជាការពារ សង្កាត់ ពន្សាំង និង លោក វរសេនីយ៍ ត្រី លោក ប៉ិន ថារ៉ាន់ នាយ ប៉ុស្តិ៍ ពន្សាំង លោក ចែម សួយ នាយ រង ប៉ុស្តិ៍ ពន្សាំង ។
លោក ប៉ិន ថារ៉ាន់ បាន លើកឡើង ថា ការជួយ នេះ ជា ទឹកចិត្ត របស់ លោក ហ៊ុយ សាវឿន ហៅ ឌេល និង ភរិយា ព្រមទាំង នគ បាល រដ្ឋបាល ប៉ុស្តិ៍ ពន្សាំង ដើម្បី ជួយ សម្រួល ដល់ ការលំបាក និង ការដោះ ទល់ មួយ គ្រា ពិសេស ក្មួយ ៗ ឲ្យ មាន នូវ សម្ភារ សម្រាប់ ការសិក្សា រ ទោះបីជា មិន ច្រើន យ៉ាង ក៏ដោយ រូប លោក និង បង ប្រុស ហ៊ុយ សាវឿន ឌេល និង ក្រុមការងារ ប៉ុស្តិ៍ រដ្ឋបាល ពន្សាំង នឹង បន្ត កិច្ចការងារ ជួយ ដល់ បងប្អូន ក៏ដូចជា ប្រជាពលរដ្ឋ នៅ ទូទាំង សង្កាត់ ពន្សាំង ដែល ជួប ការលំបាក និង ជីវភាព ខ្វះខាត ។
ជួស មុខ ឲ្យ គ្រួសារ ក្រីក្រ ទាំង២ លោក នាយ នគរបាល ប៉ុស្តិ៍ ពន្សាំង សូម ថ្លែងអំណរ អរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ ចិត្ត សប្បុរសធម៌ លោក ហ៊ុយ សាវឿន និង ភរិយា ដែល តែងតែ ជួយ មិន ថា បងប្អូន ប្រជាកាពារ សង្កាត់ ភូមិ និង ប្រជាពលរដ្ឋ ក្រីក្រ គ្រប់ ទីកន្លែង តាម បណ្តា ខេត្ត ផងដែរ ។
សូម បញ្ជាក់ ថា ឆ្លៀត ក្នុង ឱកាស នោះ ដែរ លោក ហ៊ុយ សាវឿន និង ប៉ូលីស ប៉ុស្តិ៍ នគរបាល ពន្សាំង ចូលរួម ថវិការ ចំនួន ២០ ម៉ឺន រៀល ចួល រួម ពិធី បុណ្យ នៅក្នុង ភូមិ ដដែល នោះ ដោយ លោកស្រី សំ សារុំ បាន ទទួលមរណភាព ដោយ រោគ គាពាធ ៕
សហព័ន្ធ ស្រូវ អង្ករ សង្កេតឃើញ ថា ប្រភេទ អង្ករ ក្រអូប ជាង ជាង ៨០% ត្រូវបាន នាំចេញ ដូចជា ពូជ ផ្កា រំដួល ផ្កា ម៉ាលី ស និង សែន ក្រអូប ជាដើម ។ ជាមួយគ្នា នេះ ដើម្បី និរន្តភាព និង កំណើន ទីផ្សារ សហព័ន្ធ ស្រូវ អង្ករ បាន អំពាវនាវ សូមឲ្យ បងប្អូន កសិករ ត្រូវ ជ្រើសរើស ពូជ ឲ្យបាន ត្រឹមត្រូវ ជាពិសេស ផ្កា រំដួល និង សែន ក្រអូប ក្នុង ការដាំដុះ ៕
ប៉ុន្តែ លោក ប្រធានាធិបតី ហុង ដូរ៉ាស់ បាន អះអាង ថា ការចោទប្រកាន់ ថា លោក មាន ជាប់ពាក់ព័ន្ធ នឹង អំពើ ពុករលួយ គឺជា រឿង មិន ពិត និង គួរឱ្យ អស់ សំណើច ដ្បិត រដ្ឋអាជ្ញា អាមេរិក មិន បាន និយាយ ថា លោក ទទួលបាន ប្រាក់ ដែល ស្ដេច គ្រឿង El Chapo ផ្ដល់ ឱ្យ ប្អូន ប្រុស របស់ លោក ឡើយ ។
មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង សង្គមកិច្ច៖ វិស័យ ពិការភាព កម្ពុជា បាន រីកចម្រើន ខ្លាំង ស្រប តាម របៀបវារៈ របស់ អង្គការ សហ ប្រជាជាតិ និង ពិភពលោក
ការលើកឡើង របស់ លោក ញឹក វណ្ណារ៉ា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ក្នុង ជំនួប ជាមួយ លោកស្រី សាស្រ្តាចារ្យ ចាន់ ធែល អូស ធ្លឺ ជំនាញ ការឧបករណ៍ សិប្បនិម្មិត និង រណប និង ជា អ្នកឯកទេស គ្លីនិក ព្យាបាល ដោយ ចលនា នៃ សាកលវិទ្យាល័យ សាល ថម សុន ប្រទេស អង់គ្លេស នាទី ស្តីការ ក្រសួង សង្គមកិច្ច នៅ ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ ។
ជាមួយគ្នា នោះ លោកស្រី សាស្រ្តាចារ្យ ចាន់ ធែល អូស ធ្លឺ បាន សម្តែង នូវ ការកោតសរសើ និង ថ្លែងអំណរគុណ ដែល ប្រទេស កម្ពុជា បាន គាំទ្រ អោយ មាន កិច្ចសហប្រតិបត្តិការ រវាង នៃ សាកលវិទ្យាល័យ សាល ថម សុន ប្រទេស អង់គ្លេស និង វិទ្យាស្ថាន ជាតិ សង្គមកិច្ច នៃ ប្រទេស កម្ពុជា ពិសេស សាលា ឧបករណ៍ សិប្បនិម្មិត និង រណប កម្ពុជា នា ពេល កន្លងមក នេះ ។
លោកស្រី សាស្រ្តាចារ្យ និង លោក ញឹក វណ្ណារ៉ា បាន ឯកភាព គ្នា ក្នុង ការរឹត ចំណង មិត្តភាព លើ ការងារ បច្ចេកវិទ្យា ឧបករណ៍ សិប្បនិម្មិត និង រណប និង វិស័យ ពិការភាព បន្ថែម ទៀត ដែល ជា ផ្នែក មួយ នៃ ការជម្រុញ ការគោរព សិទ្ធិ និង ការអភិវឌ្ឍន៍ តាម បែប បរិយា បន្ន ដែល ឈរ លើ គោលការណ៍ នៃ អនុសញ្ញា ស្តីពី សិទ្ធិ ជន មាន ពិការភាព និង ច្បាប់ ស្តីពី កិច្ចការពារ និង លើកកម្ពស់ សិទ្ធិ ជន ពិការ ។
បន្ថែម ពីលើ នេះ លោកស្រី ប្រកាស ថា នឹង យក បញ្ហា ទាំងអស់ នេះ ទៅ ភិភាក្សា ហើយ នឹង ធ្វើ ការទំនាក់ទំនង នៅ ពេល ក្រោយ ទៀត ៕
ប្អូន ស្រី ដ៏ កម្សត់ កើត ជំងឺ ដុះ សាច់ កាច ចម្លែក ខ្វះ លុយ ព្យាបាល ទ្រាំ ឈឺ ជាង ១ឆ្នាំ មកហើយ ទទូច សុំ ក្ដី មេត្តា ពី សប្បុរស ជន ជួយ យកអាសារ
បង ស្រី ជីដូនមួយ ប្អូន ស្រី កម្សត់ នេះ បាន បញ្ជាក់ ទៀត ថា ក្នុង ពេល ទៅ ពិនិត្យ នោះ លោកគ្រូពេទ្យ ក៏ បាន បញ្ជាក់ ថា ឈាម របស់ ស្រី កុល បាន ស៊ាំ នឹង ថ្នាំ ពន្យា ជំងឺ អេដស៍ ដំណាក់កាល ទី១ ហើយ ក៏ បាន ឱ្យ ក្មួយ របស់ គាត់ លេប ថ្នាំ ពន្យា ក្នុង តំណាក់កាល ទី២ បន្ទាប់ពី លេប ថ្នាំ តំណាក់កាល ទី២ នេះ ប្អូន ស្រី របស់ គាត់ ក៏ ចាប់ផ្តើម ឈឺ ធ្មេញ ជា បន្តបន្ទាប់ ក្រោយមក គាត់ បាន ផ្សំ ថ្នាំ ឱ្យ លេប ដើម្បី បំបាត់ អាការៈ ឈឺ ធ្មេញ នេះ ក្រោយពី បាត់ ឈឺ ធ្មេញ នេះ ក៏ បាន ឡើង ដរ ប៉ោង ចេញ ពី ច្រមុះ ដល់ ភ្នែក នេះ តែម្តង ។
គាត់ ក៏ បាន នាំ ស្រី កុល ទៅ មន្ទីពេទ្យ គុន្ធ បុប្ផា ដើម្បី ព្យាបាល ក្រោយ ទទួលបាន ថ្នាំ ពេទ្យ អាការៈ ស្រី កុល ក៏ បាន ស្រក ដូច ធម្មតា វិញ តែ មិន បាន យូរ ប៉ុន្មាន ផង ក៏ បាន កើតឡើង មកវិញ តែម្តង ។ បើ តាម ការបញ្ជាក់ ពី គ្រូពេទ្យ ស្រី កុល មាន ជំងឺ មហារីក សាច់ កាច តាំងពី កំណើត មក ម្ល៉េះ គ្រាន់តែ ពេលនេះ ទើប ចេញ រោគសញ្ញា តែ ប៉ុណ្ណោះ ហើយ ជំងឺ នេះ ត្រូវតែ បាញ់ កាំរស្មី គីមី ហើយ បន្ទាប់ពី បាញ់ ក៏ មិន សង្ឃឹម ថា ជា នោះ ដែរ ទើប គាត់ ចេះតែ នៅ បន្ត រក ថ្នាំ ខ្មែរ ឱ្យ ផឹក ជា បន្តបន្ទាប់មក ។
មន្ទីរ ផែនការ ខេត្ត ក្រចេះ បើក កិច្ចប្រជុំ ផ្សព្វផ្សាយ ពី ដំណើរការ រៀបចំ និង កសាង ផែនការអភិវឌ្ឍន៍ រយៈពេល ៥ ឆ្នាំ
( ក្រចេះ ) ៖ មន្ទីរ ផែនការ ខេត្ត ក្រចេះ នៅ ថ្ងៃទី ៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន បើក ការកិច្ចប្រជុំ ផ្សព្វផ្សាយ ពី ដំណើរការ រៀបចំ និង កសាង ផែនការអភិវឌ្ឍន៍ រយៈពេល ៥ ឆ្នាំ ( ២០២០ - ២០២៤ ) នៅ សាល ប្រជុំ សាលា ខេត្ត ក្រោម វត្តមាន លោក ប៉ែន លីណាត អភិបាល រង ខេត្ត ក្រចេះ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ សមាជិក ក្រុមប្រឹក្សា ខេត្ត មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ ជុំវិញ ខេត្ត យ៉ាង ច្រើន ផងដែរ ។
លោក បាន បន្ថែម ទៀត ថា ហើយ ការអនុវត្ត គម្រោង និង ផែនការ សកម្មភាព នេះ បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ មូលដ្ឋាន នៅក្នុង ខេត្ត ឱ្យ មាន ការរីកចម្រើន គួរ ឱ្យ កត់សម្គាល់ គឺ ពិតជា បាន ផ្ដល់ នូវ ផលប្រយោជន៍ យ៉ាង ពិតប្រាកដ ដល់ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ស្រប តាម ទិសដៅ នៃ កម្មវិធី ជាតិ សម្រាប់ ការអភិវឌ្ឍ តាម បែប ប្រជាធិបតេយ្យ នៅ ថ្នាក់ ក្រោម ជាតិ ។
លោក អភិបាល រង ខេត្ត បាន ជំរុញ ដល់ អង្គប្រជុំ ទាំងអស់ ត្រូវ បន្ត ចូលរួម ឱ្យ បាន គ្រប់ ៗ គ្នា និង យកចិត្តទុកដាក់ ខ្ពស់ បន្ថែម ទៀត អំពី គោលការណ៍ ណែនាំ ផ្នែក នយោបាយ ប្រតិទិន ការងារ និង ដំណើរការ នៃ ការរៀបចំ និង ការកសាង ផែនការអភិវឌ្ឍន៍ ខេត្ត និង របៀប ដែល អ្នក ពាក់ព័ន្ធ នីមួយ ៗ អាច ចូលរួម ក្នុង កិច្ច ដំណើរការ នេះ និង អាច បំពេញ ធាតុ ចូល នានា អាច រៀបចំ គម្រោង អាទិភាព របស់ ខ្លួន ក្នុង ការរៀបចំ ផែនការអភិវឌ្ឍន៍ រយៈពេល ប្រាំ ឆ្នាំ អាណត្តិ ទី៣ សម្រាប់ រៀបចំ រៀបចំ ផែនការ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ ខេត្ត ៕
វិនិយោគិន ខ្មែរ ចាប់ ដៃ ជាមួយ ជប៉ុន គ្រោង វិនិយោគ លើ គម្រោង អចលន ទ្រព្យ ដ៏ ធំ មួយ នៅ កម្ពុជា
គម្រោង ដ៏ ធំ នេះ ត្រូវបាន លោក បណ្ឌិត គីម ហ៊ាង បាន បង្ហាញ លម្អិត ថា ការសហការ វិនិយោគ ជាមួយ ជប៉ុន នេះ ធ្វើឡើង បន្ទាប់ពី មើលឃើញ ថា ជប៉ុន ជា ប្រទេស មួយ ដែល ពូកែ សាងសង់ និង ជា ប្រទេស ដែល មាន ទុន ច្រើន ដោយ ក្នុង នោះ ក្រុមហ៊ុន ទាំង២ នឹង សហការ គ្នា វិនិយោគ លើ គម្រោង សាងសង់ ដោយ អាចនឹង សាងសង់ ជា បុរី . ខុនដូ និង ផ្សារ ទំនើប ជាដើម ។
លោក បណ្ឌិត បញ្ជាក់ ថា គម្រោង ជាមួយនឹង ជប៉ុន នេះ គ្រោង នឹង សាងសង់ នៅ ចុង ឆ្នាំ ២០២០ ប៉ុន្ដែ បច្ចុប្បន្ន នេះ ជប៉ុន បាន និង កំពុង សិក្សា នៅឡើយ ។ ដោយឡែក សម្រាប់ ប្រទេស កម្ពុជា បាន ត្រៀម ខ្លួន រួចរាល់ ហើយ ក្នុង ការមក វិនិយោគ ក្នុង នោះ ទុន ដែល នឹង ត្រូវ ចំណាយ គឺ ខ្ទង់ លាន ដុល្លារ ៕ គណៈកម្មការ មូលបត្រ កម្ពុជា ចូលរួម កិច្ចប្រជុំ លើ កិច្ចសហប្រតិបត្តិការ ទីផ្សារ មូលធន ក្នុង តំបន់ ទន្លេ មេគង្គ លើក ទី១០ និង វេទិកា ទីផ្សារ មូលធន អាស៊ាន លើក ទី ៣១ នៅ ថៃ
កិច្ចប្រជុំ MCMC លើក ទី១០ នេះ បាន រៀបចំឡើង ក្នុង គោលបំណង ចែករំលែក ពី បច្ចុប្បន្នភាព បទប្បញ្ញត្តិ ថ្មី ៗ និង ផលិតផល មូលបត្រ ថ្មី ៗ . បញ្ហា ប្រឈម ក្នុង ការអភិវឌ្ឍ ទីផ្សារ មូលបត្រ . ពិភាក្សា ពី គម្រោង រៀបចំ កម្មវិធី កសាង សមត្ថភាព ដល់ មន្ត្រី . បន្ត កិច្ចពិភាក្សា ពី កិច្ចសហការ ក្នុង ក្របខណ្ឌ បច្ចេកទេស . ព្រមទាំង ការគ្រប់គ្រង និង ការអភិវឌ្ឍ ទីផ្សារ មូលបត្រ ដើម្បីឲ្យ ប្រទេស សមាជិក ទាំងអស់ ទទួលបាន នូវ វឌ្ឍនភាព ទីផ្សារ មូលបត្រ ប្រកបដោយ ចីរភាព និង ប្រសិទ្ធភាព ខ្ពស់ ។
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ដំណាក់កាល ទី១ ត្រូវបាន បញ្ចប់ ប្រកបដោយ ជោគជ័យ គម្រោង អភិវឌ្ឍ អគារ ខុនដូ Urban Village ដែល ជា គម្រោង ទទួលបាន ពានរង្វាន់ យ៉ាង ច្រើន បាន បើក ការសម្ពោធ ដំណាក់កាល ទី២ របស់ ខ្លួន ជា ផ្លូវការ នៅ រសៀល ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០១៩ ដោយ បាន ផ្តល់ ជូន ដល់ អតិថិជន នូវ អគារ លំនៅឋាន ដែល មាន តំលៃ សមរម្យ មាន គុណភាព ខ្ពស់ និង អគារ ពាណិជ្ជកម្ម ដ៏ ល្អ ដែល ស្ថិត នៅ ទីតាំង ភូមិសាស្ត្រ ល្អ ដែល ភ្ជាប់ ទៅនឹង ទេសភាព ធម្មជាតិ នៅ កណ្តាល ទីក្រុង ដែល មាន ការអភិវឌ្ឍន៍ ខ្លាំង ។
( ភ្នំពេញ ) ៖ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម លោក ប៉ាន សូរស័ក្តិ បាន សម្តែង ការពេញចិត្ត ជាខ្លាំង ចំពោះ ទំនាក់ទំនង ដ៏ ល្អ រវាង កម្ពុជា និង សាធារណរដ្ឋ កូរ៉េ ដែល បាន ចាប់ផ្តើម ឡើង កាលពី ឆ្នាំ ១៩៩៧មក នោះ ។ លោក រដ្ឋមន្ត្រី បាន មើលឃើញ ថា ទំនាក់ទំនង ដ៏ ប្រសើរ រវាង កម្ពុជា និង សាធារណរដ្ឋ កូរ៉េ ធ្វើឱ្យ ទំហំ ពាណិជ្ជកម្ម រវាង ប្រទេស ទាំង ពីរ កើនឡើង ជា បន្តបន្ទាប់ ។
ការគូសបញ្ជាក់ របស់ លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន ធ្វើឡើង ក្នុង ឱកាស ដែល រូប លោក អញ្ជើញ ចូលរួម ពិធី បុណ្យ ជាតិ សាធារណរដ្ឋ កូរ៉េ ដែល បាន ធ្វើឡើង នៅ រាត្រី ថ្ងៃទី ០២ ខែតុលា ឆ្នាំ ២០១៩ ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី បាន ថ្លែង សេចក្ដីកោតសរសើរ ចំពោះ រដ្ឋាភិបាល និង ប្រជាជន នៃ សាធារណរដ្ឋ កូរ៉េ លើ ភាពជោគជ័យ គួរឱ្យ កត់សម្គាល់ ក្នុង ការជម្នះ ឧបសគ្គ ជាច្រើន ដើម្បី សម្រេចបាន នូវ វឌ្ឍនភាព នៅក្នុង ប្រទេស និង លើកកម្ពស់ កិត្តិនាម របស់ ប្រទេស កូរ៉េ លើ ថ្នាល អន្តរជាតិ ។
លោក រដ្ឋមន្ត្រី បាន បន្ត កត់សម្គាល់ ថា ជាមួយនឹង ការរីកចម្រើន ជា បន្តបន្ទាប់ ក្នុង វិស័យ អប់រំ វិទ្យាសាស្ត្រ បច្ចេកវិទ្យា និង សុខុមាលភាព សង្គម សាធារណរដ្ឋ កូរ៉េ បាន ប្រែក្លាយ ខ្លួន ទៅជា មេដឹកនាំ ឧស្សាហកម្ម ពិភពលោក មួយ និង បាន ចូលរួមចំណែក យ៉ាង សំខាន់ ដល់ សន្តិភាព និង សន្តិសុខ អន្តរជាតិ ក៏ ដូចជា ការអភិវឌ្ឍ ប្រកបដោយ បរិយាប័ន្ន និង និរន្តរភាព នៅក្នុង តំបន់ ដែល រួម មាន ទាំង ប្រទេស កម្ពុជា ផងដែរ ។
ចំពោះ ទំនាក់ទំនង ទ្វេ ភាគី កម្ពុជា - កូរ៉េ លោក រដ្ឋមន្ត្រី បាន សម្ដែង ការពេញចិត្ត ចំពោះ ការបង្កើន ចំណង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ប្រកបដោយ ផ្លែផ្កា នៅក្នុង វិស័យ ផ្សេង ៗ រវាង ប្រទេស យើង ទាំង ពីរ ចាប់តាំងពី ពេល យើង ចាប់ផ្តើម ទំនាក់ទំនង ការទូត ជាថ្មី ក្នុង ឆ្នាំ ១៩៩៧ ។
សាធារណរដ្ឋ កូរ៉េ បាន ជួយ ដល់ ប្រទេស កម្ពុជា លើ វិស័យ សំខាន់ ៗ ជាច្រើន រួម មាន ការបណ្តុះបណ្តាល ធនធាន មនុស្ស សុខាភិបាល ហេដ្ឋារចនាសម្ព័ន្ធ ការអភិវឌ្ឍ ជនបទ កសិកម្ម បច្ចេកវិទ្យា ព័ត៌មាន និង គមនាគមន៍ ។ ក្នុង ក្របខ័ណ្ឌ កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច ពាណិជ្ជកម្ម ទ្វេ ភាគី កំពុង កើនឡើង ពី ប្រមាណ ៦០០ លាន ដុល្លារ អាមេរិក ក្នុង ឆ្នាំ ២០១៧ ដល់ ជាង ៧០០ លាន ដុល្លារ អាមេរិក ក្នុង ឆ្នាំ ២០១៨ និង ប្រហែល ៤៥០ លាន ដុល្លារ អាមេរិក នៅ ឆមាស ទី១ នៃ ឆ្នាំ ២០១៩ ។
លោក រដ្ឋមន្ត្រី ក៏ បាន គូសបញ្ជាក់ ពី ដំណើរទស្សនកិច្ច ផ្លូវ រដ្ឋ របស់ លោក ប្រធានាធិបតី Moon Jae-in មកកាន់ ប្រទេស កម្ពុជា កាលពី ខែមីនា កន្លងទៅ និង ដំណើរទស្សនកិច្ច របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ទៅកាន់ សាធារណរដ្ឋ កូរ៉េ នា ពេល ខាងមុខ សម្រាប់ កិច្ចប្រជុំ កំពូល រំលឹក ខួប អនុស្សាវរីយ៍ អាស៊ាន - សាធារណរដ្ឋ កូរ៉េ និង កិច្ចប្រជុំ កំពូល មេគង្គ - សាធារណរដ្ឋ កូរ៉េ លើក ទី១ នៅ ខែវិច្ឆិកា ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ សង្ឃឹម ថា តាមរយៈ អនុព័ន្ធ យោធា ថៃ ថ្មី នឹង ធ្វើឱ្យ ចំណង មិត្តភាព កងទ័ព ទាំង ពីរ កាន់តែ រឹងមាំ
នាយ ឧត្តមសេនីយ៍ នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ បាន បញ្ជាក់ ថា កន្លងមក កងទ័ព ប្រទេស យើង ទាំង ពីរ តែងតែ រួមគ្នា បង្កើន នូវ កិច្ចសហប្រតិបត្តិការ ជាមួយគ្នា បាន យ៉ាង ល្អ ប្រសើរ ចាប់តាំងពី ថ្នាក់ដឹកនាំ កំពូល រហូតដល់ ថ្នាក់ ក្រោម ។
នាយ ឧត្តមសេនីយ៍ ឥត សារ៉ាត់ ក៏ បាន អរគុណ ផងដែរ ចំពោះ នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ កងទ័ព ភូមិន្ទ ថៃ ដែល បាន បង្ក គ្រប់ លក្ខណៈ ងាយស្រួល ឱ្យ ប្រតិភូ របស់ នាយ ឧត្តមសេនីយ៍ បាន ចូលរួម ក្នុង កិច្ចប្រជុំ ថ្នាក់ មេបញ្ជាការ កងទ័ព អាស៊ាន នា ពេល កន្លងមក ។
ក្នុង ជំនួប នា ឱកាស នោះ លោក វរសេនីយ៍ ឯក សារ៉ា យុទ្ធ ប៊ុន ជឺ បាន សម្ដែង នូវ អំណរគុណ ចំពោះ នាយ ឧត្តមសេនីយ៍ អគ្គ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ ដែល បាន ផ្ដល់ ឱកាស ឱ្យ រូប លោក ដែល ជា អនុព័ន្ធ យោធា ចាស់ ថ្មី បាន ចូល ជួប សំដែង ការគួរសម ជម្រាប លា និង បង្ហាញ មុខ ព្រមទាំង បាន បង្ក គ្រប់ លក្ខណៈ សម្បត្តិ ងាយស្រួល គ្រប់ បែបយ៉ាង ដល់ រូបលោក ក្នុង ការបំពេញ បេសកកម្ម កាទូត ចូលធា នៅ កម្ពុជា រហូត ទទួលបាន ជោគជ័យ ក្រោយពេល បញ្ចប់ អាណត្តិ នេះ ។
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន បញ្ជាក់ ទៀត ថា ជន ដៃ ដល់ រូប នេះ ឈ្មោះ នួន មករា អាយុ ៣១ ឆ្នាំ ជា មន្ដ្រី នគរបាល ការិយាល័យ ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ។ ដោយ មិន ចង់ បញ្ជាក់ លម្អិត លោក ស្នងការ បាន អះអាង ត្រឹម ថា ការសម្លាប់ ជនរងគ្រោះ ដោយ ការបាញ់ប្រហារ នេះ ផ្ដើម ចេញ ពី រឿង គំនុំ ផ្ទាល់ខ្លួន ។
ជន ដៃ ដល់ នួន មករា ស្ថិត ក្រោម ការសួរនាំ របស់ នគរបាល ព្រហ្មទណ្ឌ នៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ដើម្បី កសាង សំណុំរឿង បញ្ជូន ទៅកាន់ តុលាការ ផ្ដន្ទាទោស ទៅ តាម ផ្លូវ ច្បាប់ ។
សូម បញ្ជាក់ ថា លោក ផន ទុំ ដែល មាន តួនាទី ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ពេល កំពុង អង្គុយ ផឹក កាហ្វេ នៅក្នុង ហាង មួយ កន្លែង ភូមិ អូរ កន្សែង សង្កាត់ បឹង កន្សែង ក្រុង បាន លុង នៅ វេលា ម៉ោង ប្រមាណ ០៩៖ ២០ នាទី ព្រឹក មិញ បាន រង នូវ ការ បាញ់ប្រហារ មួយ គ្រាប់ ចំ ក្បាល ពីសំណាក់ ជន ដៃ ដល់ បណ្ដាលឲ្យ ប្រកាច់ នៅ កន្លែង កើត ហេតុ ហើយ សាក្សី ព្រមទាំង សមត្ថកិច្ច បាន អះអាង ដូចគ្នា ថា ជនរងគ្រោះ បាន ស្លាប់ នៅ ពេល នោះ ។
ប៉ុន្ដែ មួយ សន្ទុះ ក្រោយមក ក្រុមគ្រួសារ របស់ ជនរងគ្រោះ ដែល បាន ធ្វើដំណើរ មកដល់ ទីតាំង កើត ហេតុ នោះ នៅតែ មិន អស់ចិត្ត និង បាន ដឹក ជនរងគ្រោះ ឆ្ពោះទៅ មន្ទីរពេទ្យ នៅ ប្រទេស វៀតណាម ៕
( រតនគិរី ) ៖ ខ្មាន់ កាំភ្លើង ដែល បាញ់ សម្លាប់ នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ត្រូវ កម្លាំង សមត្ថកិច្ច តាម ចាប់ខ្លួន បាន ហើយ នៅ មុន នេះ បន្ដិច វេលា ម៉ោង ជិត ១១ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ ។
លោក ឧត្តមសេនីយ៍ ទោ យិន ចំណាន ស្នងការ នគរបាល ខេត្ត រតនគិរី បាន ប្រាប់ ភ្នាក់ងារ Fresh News ឲ្យដឹង ថា ជន ដៃ ដល់ ត្រូវ កម្លាំង នគរបាល តាម ចាប់ខ្លួន បាន ហើយ និង ដកហូត បាន កាំភ្លើង ខ្លី មួយ ដើម ជាមួយ រថយន្ដ ដែល ជិះ ធ្វើ សកម្មភាព មួយ គ្រឿង ផងដែរ ។ ពេលនេះ កំពុង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល ខេត្ត ដើម្បី ធ្វើ ការសួរនាំ ។
សូម ជម្រាប ថា មន្ដ្រី នគរបាល ម្នាក់ មាន តួនាទី ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ម្នាក់ ត្រូវបាន ខ្មាន់ កាំភ្លើង បាញ់ប្រហារ បណ្ដាលឲ្យ ស្លាប់ ភ្លាម ៗ នៅនឹង កន្លែង ។ ហេតុការណ៍ នេះ កើតឡើង នៅ វេលា ម៉ោង ប្រមាណ ៩ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ ស្ថិត ក្នុង ហាង កាហ្វេ មួយ កន្លែង ភូមិ អូរ កន្សែង សង្កាត់ បឹង កន្សែង ក្រុង បាន លុង ខេត្ត រតនគិរី ។
សមត្ថកិច្ច មូលដ្ឋាន បាន បញ្ជាក់ ថា ជនរងគ្រោះ ឈ្មោះ ផន ទុំ មាន តួនាទី ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ៕
អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា ជាតិ គាំពារ សង្គម ផ្សព្វផ្សាយ និង បញ្ជ្រាប ការយល់ដឹង អំពី ដំណើរ នៃ ការកសាង ប្រព័ន្ធ គាំពារ សង្គម នៅ កម្ពុជា
សិក្ខាសាលា នេះ មាន គោលបំណង ផ្សព្វផ្សាយ និង បញ្ជ្រាប ការយល់ដឹង អំពី ដំណើរ នៃ ការកសាង ប្រព័ន្ធ គាំពារ សង្គម នៅ កម្ពុជា ដោយ មាន ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០១៦ - ២០២៥ ជា គោល ក្នុង គោលដៅ ធានា នូវ សន្តិសុខ ប្រាក់ ចំណូល និង កាត់បន្ថយ ភាពងាយ រងគ្រោះ ផ្នែក សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ របស់ ប្រជាជន ដើម្បី លើកកម្ពស់ សុខុមាលភាព និង សាមគ្គីភាព សង្គម ព្រមទាំង កាត់បន្ថយ ភាពក្រីក្រ ជា អតិបរមា ។
ក្របខណ្ឌ គោល នយោបាយ ជាតិ គាំពារ សង្គម ២០១៦ - ២០២៥ ត្រូវបាន រៀបចំឡើង ដោយ ផ្តោត លើស សរ ស្តម្ភ ២ សំខាន់ ៗ គឺ ប្រព័ន្ធ ជំនួយ សង្គម និង ប្រព័ន្ធ សន្តិសុខ សង្គម ដើម្បី សម្រេច ឱ្យ បាន នូវ ទស្សនវិស័យ និង ការខិតខំ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការប្រែក្លាយ ឋានៈ និង មុខមាត់ របស់ កម្ពុជា ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ទៅជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
ប្រព័ន្ធ ជំនួយ សង្គម ត្រូវបាន បង្កើតឡើង ដើម្បី គ្រប់គ្រង កម្មវិធី ដែល រួមបញ្ចូល អន្តរាគមន៍ សម្រាប់ ជា ប្រយោជន៍ ដល់ ប្រជាជន ក្រីក្រ និង ងាយ រងគ្រោះ ។ ប្រព័ន្ធ នេះ មាន ធាតុ ផ្សំ ៤ សំខាន់ ៗ គឺ៖ ១- ការឆ្លើយតប ទៅនឹង គ្រោះអាសន្ន . ២ - ការអភិវឌ្ឍ មូលធន មនុស្ស . ៣ - ការបណ្ដុះបណ្ដាល វិជ្ជាជីវៈ និង ៤ - សុខុមាលភាព សម្រាប់ ប្រជាជន ងាយ រងគ្រោះ ។
គោលដៅ ចម្បង នៃ ក្របខណ្ឌ គោល នយោបាយ នេះ គឺ ធ្វើ ការបន្ស៊ី ប្រមូលផ្តុំ និង ពង្រឹង កម្មវិធី ដែល មាន ស្រាប់ ដើម្បី បង្កើន ប្រសិទ្ធភាព តម្លាភាព និង សង្គតិភាព នៃ កម្មវិធី នានា ក្នុង ប្រព័ន្ធ គាំពារ សង្គម ទាំងមូល រួមទាំង ការពង្រីក វិសាលភាព ដើម្បី ឆ្លើយតប នឹង តម្រូវការ របស់ ប្រជាជន ស្រប តាម ការរីកចម្រើន នៃ សេដ្ឋកិច្ច ជាតិ ព្រមទាំង រៀបចំ ឱ្យ មាន ក្របខណ្ឌ អភិបាលកិច្ច ដើម្បី ធានា ឱ្យ បាន នូវ ប្រសិទ្ធភាព នៃ ការគ្រប់គ្រង និង បង្កើន ប្រសិទ្ធភាព ចំណាយ ថវិកា ។
តាមរយៈ គោល នយោបាយ នេះ ប្រជាជន កម្ពុជា ជាពិសេស ប្រជាជន ក្រីក្រ និង ងាយ រងគ្រោះ ទទួលបាន ការគាំពារ ក្រោម រូបភាព ផ្សេង ៗ ក្នុង ក្របខ័ណ្ឌ នៃ ការងារ គាំពារ សង្គម ដូចជា ការបង្កើត មជ្ឈមណ្ឌលកុមារ កំព្រា មជ្ឈមណ្ឌល គាំពារ សុខភាព មាតា និង ទារក ការឧបត្ថម្ភ ចំពោះ ប្រជាជន ក្រីក្រ ដែល មក សម្រាក ព្យាបាល ឬ សម្រាល កូន និង ការផ្តល់ ការអប់រំ ក៍ ដូចជា ការផ្តល់ តាវ កាលិក សោធន ថែទាំ សុខភាព ហានិភ័យ ការងារ ពិការ ភាពជាដើម ៕
ប្រមុខ ការទូត កម្ពុជា ទទួល ជួប សន្ទនា ជាមួយ ទូត ថ្មី មីយ៉ាន់ម៉ា
ជំនួប នេះ បាន ធ្វើឡើង នៅ ទីស្តីការ ក្រសួង ការបរទេស កម្ពុជា ក្នុង រាជធានី ភ្នំពេញ ៕
សិស្ស និទ្ទេស A ចំនួន ២៥ នាក់ ក្នុង ខណ្ឌ ដូនពេញ បាន ទទួល ថវិកា ឧបត្ថម្ភ លើកទឹកចិត្ត ពី អភិបាល ខណ្ឌ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ រដ្ឋបាល ខណ្ឌ ដូនពេញ បាន រៀបចំ ពិធី សំណេះសំណាល ជាមួយ បេក្ខជន ដែល បាន ប្រឡង ជាប់ និទ្ទេស A ឆ្នាំ សិក្សា ២០១៨ - ២០១៩ សរុប ចំនួន ២៥ នាក់ ក្នុង ខណ្ឌ ដូនពេញ ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក សុខ ពេញវុធ អភិបាល ខណ្ឌ ដូនពេញ ។
បេក្ខជន ដែល ប្រឡង ជាប់ និទ្ទេស A ទាំង ២៥ នាក់ ក្នុង នោះ មាន ស្រី ចំនួន ០៩ នាក់ មកពី វិទ្យាល័យ ព្រះស៊ីសុវត្ថិ ចំនួន ១៨ នាក់ . វិទ្យាល័យ ហ៊ុន សែន ប៊ុន រ៉ានី វត្តភ្នំ ចំនួន ០៣ នាក់ . វិទ្យាល័យ វត្ត កោះ ម្នាក់ និង វិទ្យាល័យ អន្ដរជាតិ អាយ ស៊ី អេស ចំនួន ០៣ នាក់ ។
ក្នុង ឱកាស នោះ ម្នាក់ ៗ ទទួលបាន ថវិកា ឧបត្ថម្ភ លើកទឹកចិត្ត ចំនួន ១.០០០.០០០ រៀល សរុប ២៥.០០០.០០០ រៀល ក្នុង នោះ ថវិកា លោក សួន រិនឌី អនុប្រធាន ទី១ ក្រុមការងារ ចុះ ជួយ ខណ្ឌ ដូនពេញ ចំនួន ២.០០០.០០០ រៀល . លោក សារិន វណ្ណា អនុប្រធាន ក្រុមការងារ ចុះ ជួយ ខណ្ឌ ដូនពេញ និង ជា ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង់ និង សុរិយោដី រាជធានី ភ្នំពេញ ចំនួន ១១.០០០.០០០ រៀល និង លោក សុខ ពេញវុធ ចំនួន ១២.០០០.០០០ រៀល ផងដែរ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ នាយ ឧត្តមសេនីយ៍ សៅ សុខា អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ មេបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស បាន អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ប្រជុំ ត្រួតពិនិត្យ ការអនុវត្ត តួនាទី ភារកិច្ច និង ការងារ កងរាជអាវុធហត្ថ រយៈពេល ៩ខែ និង ផ្សព្វផ្សាយ ទិសដៅ ត្រី មាស ៤ ឆ្នាំ ២០១៩ ។
កិច្ចប្រជុំ ដែល បាន ធ្វើឡើង នៅ បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ក៏ មាន ការចូលរួម ពីសំណាក់ លោក មេបញ្ជាការ រង នាយ រង សេនាធិការ នាយ រង សេនាធិការ ស្នងការ ស្នងការ រង នាយក រង សាលា នាយ ការិយាល័យ និង នាយ ទាហាន នាយ ទាហាន រង នៃ កងរាជអាវុធហត្ថ ជាច្រើន រូប ទៀត ៕
តុលាការ ចេញ សាលក្រម « ចាត់ របៀប » ឱ្យ ស៊ើបអង្កេត លើ សំណុំរឿង អតីត បុគ្គលិក វិទ្យុ អាស៊ី សេរី ឡើងវិញ
( ភ្នំពេញ ) ៖ សំណុំរឿង អតីត បុគ្គលិក វិទ្យុ អាស៊ី សេរី ២រូប គឺ លោក អ៊ួន ឈិន និង លោកយាង សុភារិន្ទ ហៅ យាង សុជា មេត្តា ពុំ ត្រូវបាន តុលាការ ប្រកាស សាលក្រម អង្គ សេចក្តី តាម ការគ្រោងទុក នៅ ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ ទេ ។ រឿង នេះ ចៅក្រម ជំនុំជម្រះ លោក អ៉ឹម វណ្ណ : បាន ចេញ « សាលក្រម ចាត់ របៀប » ឱ្យ ស៊ើបអង្កេត ភស្តុតាង ពាក់ព័ន្ធ ឡើងវិញ ។
សាលក្រម ចាត់ របៀប នេះ តុលាការ តម្រូវ ឱ្យ មាន ចៅក្រម ស៊ើបសួរ ១រូប ផ្សេង ទៀត ធ្វើ ការវិភាគ ឲ្យបាន លម្អិត ថែម ទៀលើ ភស្តុង តាង មួយចំនួន ដូចជា ទិន្នន័យ សម្ភារ : កុំព្យូទ័រ ឧបករណ៍ បញ្ជូន សារ ដទៃ ទៀត ក្នុង បន្ទប់ Studio ដែល ជា កន្លែង ប្រមូល ភស្តុតាង ល្មើស របស់ ជនជាប់ចោទ ទាំង២រូប មុននឹង ធ្វើ ការសម្រេច សាលក្រម ដោយ តុលាការ ចាត់ទុក ថា ភស្តុតាង កន្លងមក មិន ទាន់ មាន ភាពច្បាស់លាស់ ដើម្បី ធ្វើ ការវិន្និច្ឆ័យ នៅឡើយ ។
តុលាការ ក្រុង ភ្នំពេញ មិន ទាន់ បញ្ជាក់ អំពី ថេរ វេលា ក្នុង ការប្រកាស សាលក្រម ទេ ដោយ រង់ចាំ លទ្ធផល នៃ ការស៊ើបអង្កេត នេះ ។
លោក អ៊ួន ឈិន និង លោក យាង សុជា មេត្តា ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន កាលពី ថ្ងៃទី ១៤ ខែវិច្ឆិកា ឆ្នាំ ២០១៧ ក្រោយ វិទ្យុ អាស៊ី សេរី ដែល លួច បើក ការិយាល័យ មិន ស្រប ច្បាប់ នៅ កម្ពុជា នោះ បាន ដក ខ្លួន ថយ ហើយ បិទ ការិយាល័យ នេះ ទៅ វិញ ដោយ ឯកឯង ។ អ្នក ទាំង ពីរ ត្រូវបាន តុលាការ ឃុំ ខ្លួន ក្នុង ពន្ធនាគារ អស់ ជិត១ ឆ្នាំ ហើយ បន្ទាប់មក ត ក៏ ត្រូវបាន តុលាការ ដោះលែង ឱ្យ នៅ ក្រៅ ឃុំ នៅ ថ្ងៃទី ២១ ខែសីហា ឆ្នាំ ២០១៨ ។
ជន ត្រូវ ចោទ អ៊ួន ឈិន និង យាង សុភារិន្ទ ហៅ យាង សុជា មេត្តា ត្រូវបាន តុលាការ ចោទប្រកាន់ ពាក់ព័ន្ធ នឹង ការផ្តល់ឱ្យ រដ្ឋ ឬ ភ្នាក់ងារ បរទេស ដែល អាច អន្តរាយ ដល់ ការការពារ ជាតិ ។ កាលពី ថ្ងៃទី ០៩ ខែសីហា ឆ្នាំ ២០១៩ អ្នក ទាំង ពីរ ក៏ ត្រូវបាន តុលាការ ចោទ មួយ ករណី ទៀត គឺ ផលិត វីឌីអូ អាសអាភាស ៕ នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល ខេត្ត រតនគិរី ម្នាក់ ត្រូវ ខ្មាន់ កាំភ្លើង បាញ់ សម្លាប់ ក្នុង ហាង កាហ្វេ មួយ កន្លែង នៅ ក្រុង បាន លុង
( រតនគិរី ) ៖ មន្ដ្រី នគរបាល ម្នាក់ មាន តួនាទី ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ម្នាក់ ត្រូវបាន ខ្មាន់ កាំភ្លើង បាញ់ប្រហារ បណ្ដាលឲ្យ ស្លាប់ ភ្លាម ៗ នៅនឹង កន្លែង ។
ហេតុការណ៍ នេះ កើតឡើង នៅ វេលា ម៉ោង ប្រមាណ ៩ព្រឹក ថ្ងៃទី ០៣ ខែតុលា ឆ្នាំ ២០១៩ នេះ ស្ថិត ក្នុង ហាង កាហ្វេ មួយ កន្លែង ភូមិ អូរ កន្សែង សង្កាត់ បឹង កន្សែង ក្រុង បាន លុង ខេត្ត រតនគិរី ។
សមត្ថកិច្ច មូលដ្ឋាន បាន បញ្ជាក់ ថា ជនរងគ្រោះ ឈ្មោះ ផន ទុំ មាន តួនាទី ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត រតនគិរី ។ បច្ចុប្បន្ន កម្លាំង សមត្ថកិច្ច ជំនាញ ក្រុង បាន លុង និង កម្លាំង របស់ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពុង ស្វែងរក ជន ដៃ ដល់ ក្នុង ករណី ឃាតកម្ម ដ៏ សាហាវ នេះ ៕
យន្ដហោះ B-17 ខាងលើ បាន ធ្លាក់ ម៉ោង ប្រមាណ ៩៖ ៥៤ នាទី ព្រឹក ថ្ងៃពុធ ( ម៉ោង ក្នុង តំបន់ ) បន្ទាប់ពី យន្ដហោះ នេះ ត្រូវបាន គេ រាយការណ៍ ថា មាន បញ្ហា បច្ចេកទេស ក្រោយ ហោះ ឡើង បាន បន្តិច និង ព្យាយាម ចុះចត វិញ ភ្លាម ៗ ។ ប៉ុន្តែ បញ្ហា ឬ មូលហេតុ ឱ្យ ប្រាកដ នៃ គ្រោះថ្នាក់ នេះ មិន ទាន់ ត្រូវបាន បញ្ជាក់ នៅឡើយ ទេ ។
គួរ ជម្រាប ថា បើ តាម ប្រព័ន្ធ ផ្សព្វផ្សាយ អាមេរិក អ្នកដំណើរ សរុប ១០នាក់ និង អាកាសយានិក ០៣ នាក់ បាន ស្ថិត នៅលើ យន្ដហោះ B-17 នៅពេល មាន គ្រោះថ្នាក់ កើតឡើង ខណៈ មនុស្ស ០៦ នាក់ ត្រូវបាន បញ្ជូន ទៅកាន់ មន្ទីរពេទ្យ នៅក្បែរ កន្លែង កើត ហេតុ ហើយ មនុស្ស ម្នាក់ នៅលើ ដី ក៏ បាន រងរបួស ផងដែរ ៕ អ្នកវិទ្យាសាស្ត្រ៖ ប្រហោង ខ្មៅ (Black Hole) ចំនួន ៣ ដែល នឹង បុក គ្នា នោះ នឹង ធ្វើឲ្យ កាឡាក់ស៊ី ពួកវា ប្រែប្រួល សណ្ឋាន
លោក គូសបញ្ជាក់ ថា៖ « ដូច្នេះ ខ្ញុំ សូម ប្រឆាំង ដាច់ខាត ចំពោះ ទណ្ឌិត សម រង្ស៉ី ដែល ជា អ្នកនយោបាយ ចាស់ វស្សា ផ្អែក លើ ចំណេះដឹង មិន ច្បាស់លាស់ ប្រើប្រាស់ ព័ត៌មាន មិន ពិត ដើម្បី ផលប្រយោជន៍ នយោបាយ ផ្ទាល់ខ្លួន » ។
ប៉ុន្តែ ទោះជា យ៉ាង នេះ ក្តី ទណ្ឌិត សម រង្ស៉ី មេ ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ពុំ ហ៊ាន ភ្នាល់ តាម ការបបួល របស់ លោក បណ្ឌិត ហ៊ុន ម៉ាណែត នោះ ឡើយ ៕
( ភ្នំពេញ ) ៖ ឱកាស ពិសេស សម្រាប់ ពលរដ្ឋ កម្ពុជា យើង ក្នុង ការស្វែងយល់ ពី វិស័យ អចលន ទ្រព្យ នៅ ជុំវិញ ពិភពលោក ក្នុង វេទិកា អចលន ទ្រព្យ ដ៏ ធំ ប្រចាំ ឆ្នាំ ពិព័រណ៍ អចលលន ទ្រព្យ កម្ពុជា ឆ្នាំ ២០១៩ ដែល នឹង ប្រព្រឹត្ដទៅ រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០៤ - ០៥ ខែតុលា ឆ្នាំ ២០១៩ នេះ នៅ សណ្ឋាគារ ណាហ្គាវើល ចាប់ផ្ដើម ពី ១០ព្រឹក ដល់ ម៉ោង ៦ល្ងាច ។
ចូលរួម ដោយ សេរី រយៈ ពីរ ថ្ងៃ នេះ ដើម្បី ទិញ អចលន ទ្រព្យ ដើរ មើល គម្រោង ណាមួយ ដែល ល្អ ជាង គេ និង ស្វែងយល់ ពី គម្រោង ធំ ៗ ជាង ៦០ គម្រោង និង ក្រុមហ៊ុន ផ្សេង ៗ ទៀត ជាមួយ ការបញ្ចុះ តម្លៃ និង ការផ្តល់ ជូន ពិសេស ៗ ជាច្រើន ។ អ្វី ដែល សំខាន់ មួយ ទៀត គឺ ការចូលរួម ស្តាប់ អ្នកជំនាញ ធ្វើ បទបង្ហាញ ពី ឱកាស សក្តានុពល តំបន់ វិនិយោគ និង គន្លឹះ ល្អ ៗ ដើម្បី អាច វិនិយោគ ដោយ ជោគជ័យ ក្នុង វិស័យ អចលន ទ្រព្យ ។
ប្រសិនបើ អ្នក ចង់ ទិញ ផ្ទះ ជាមួយនឹង ជម្រើស ដ៏ ច្រើន អ្នក គួរ ចូលរួម ជាមួយ ពិព័រណ៍ អចលន ទ្រព្យ កម្ពុជ ឆ្នាំ ២០១៩ នៅ ថ្ងៃស្អែក នេះ !
ពិព័រណ៍ លំនៅឋាន កម្ពុជា គឺជា វេទិកា តាំង បង្ហាញ គម្រោង អចលន ទ្រព្យ គ្រប់ បែបយ៉ាង មកពី ទូទាំង ប្រទេស កម្ពុជា ក្នុង នោះ រាប់ ចាប់ពី គម្រោង បុរី ខុនដូ អា ផាត មេន ដីឡូតិ៍ និង អចលន ទ្រព្យ បែប អាជីវកម្ម ជាមួយនឹង ក្រុមហ៊ុន ភ្នាក់ងារ អចលន ទ្រព្យ ធំ ៗ ជាច្រើន គម្រោង ។
ទោះបី មិន ទាន់ ទិញ ផ្ទះ ក៏ដោយ តែ អ្នក គួរ ទៅ មើល ក៏ ល្អ ដែរ ដោយសារ នេះ ជា ឱកាស ដែល មាន តែ ម្តង ក្នង មួយ ឆ្នាំ ។ ចំណាយ ពេល ចុង សប្តាហ៍ ដើរ មើល ផ្ទះ ល្អ ៗ នៅក្នុង ពិព័រណ៍ ពីរ ថ្ងៃ អ្នក នឹង ទទួលបាន ចំណេះដឹង និង ដឹង ពី ជម្រើស លំនៅដ្ឋាន កាន់តែ ច្រើន ទៅ ពេល អនាគត ។ តារាងកាលវិភាគ កម្មវិធី និង ការចូលរួម ធ្វើ បទបង្ហាញ របស់ វា គ្មិន ជំនាញ ក្នុង ពិព័រណ៍ អចលន ទ្រព្យ កម្ពុជា ២០១៩ នេះ ។
ឱកាស ល្អ មកដល់ ហើយ ! ឆ្លៀត ពេល ចូលរួម ក្នុង ពិព័រណ៍ និង សិក្ខាសាលា ឥត គិត ថ្លៃ របស់ យើង នៅឯ ពិព័រណ៍ អចលន ទ្រព្យ ឆ្នាំ ២០១៩ ។ កុំ ភ្លេច ចូលរួម ក្នុង ពិព័រណ៍ ដ៏ ធំ នេះ ពិសេស កុំ ភ្លេច ប្រាប់ ក្រុមគ្រួសារ មិត្តភក្តិ និង អ្នក ដែល ចង់ ទិញ លំនៅឋាន ឲ្យ មក ស្វែងរក ជម្រើស លំនៅឋាន ល្អ ៗ នៅក្នុង ពិព័រណ៍ ដ៏ ធំ ប្រចាំ ឆ្នាំ នេះ ។
