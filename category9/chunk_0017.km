( ភ្នំពេញ ) ៖ លោក ប៉ា សុជាតិ វង្ស ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ បើក វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី ប្រជាពលរដ្ឋ នៅតែ លើកឡើង ពី កង្វល់ របស់ ខ្លួន ពាក់ព័ន្ធ នឹង ការប្រមូល សំរាម របស់ ក្រុមហ៊ុន ស៊ីន ទ្រី មិន ទាន់ បាន ល្អ និង សូម ឱ្យ អាជ្ញាធរ ជួយ អន្តរាគមន៍ ខណៈ ដែល សំរាម បាន បង្កើត ឱ្យ មាន ជា កង្វល់ ឱ្យ ពួកគាត់ រាល់ ថ្ងៃ នោះ ។
ជាក់ស្តែង វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី បាន ធ្វើឡើង នៅ សាលា ខណ្ឌ មានជ័យ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ លោក នួន ផារ័ត្ន អភិបាល រង រាជធានី ភ្នំពេញ តំណាង ឱ្យ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង មាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា មន្ត្រី ចំណុះ ឱ្យ រដ្ឋបាល រាជធានី ព្រមទាំង ប្រជាពលរដ្ឋ រាប់ រយ នាក់ ។
នៅក្នុង វេទិកា នេះ ដែរ ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ខណ្ឌ បាន លើកឡើង ជា សំណើ និង សំណូមពរ ជាច្រើន ក្នុង នោះ ពាក់ព័ន្ធ នឹង បញ្ហា សំរាម ប្រជាពលរដ្ឋ បាន លើកឡើង ដដែល ថា ក្រុមហ៊ុន ស៊ិន ទ្រី នៅតែ មិន ព្រម មក ប្រមូល សំរាម ឱ្យ អស់ នោះ ទេ ដោយ ទុក ឱ្យ ស្អុយ ប៉ះពាល់ ដល់ បរិស្ថាន នៅក្នុង ភូមិឋាន របស់ ពួកគាត់ ។ ពួកគាត់ បាន ឱ្យដឹង ថា ដោយ ថ្ងៃ ខ្លះ បាន ទុក សំរាម ចោល រហូតដល់ ២០ ថ្ងៃ ក៏ មាន ដែរ ដូច្នេះ ពួកគាត់ បាន សំណូមពរ ឱ្យ អាជ្ញាធរ ជួយ អន្តរាគមន៍ លើ បញ្ហា ដដែរ ជា ដដែល នេះ ផង ។
លោក បាន បន្ត ថា វេទិកា ផ្សព្វផ្សាយ និង ពិគ្រោះយោបល់ របស់ ក្រុមប្រឹក្សា រាជធានី នេះ នឹង ផ្តល់ ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង ការចូលរួម ក្នុង ដំណើរការ អភិបាលកិច្ច ល្អ និង ជា ឧបករណ៍ មួយ សម្រាប់ លើក កម្ពស់ គណនេយ្យភាព តម្លាភាព ក្នុង ដំណើរការ ពិនិត្យ មើល លើ ការផ្តល់ សេវា សាធារណៈ របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ ក្នុង គោលបំណង ដើម្បី ធានា ថា រាល់ បញ្ហា អាទិភាព របស់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ត្រូវបាន ពិនិត្យ ដោះស្រាយ និង ឆ្លើយតប ។
លោក នួន ផារ័ត្ន ក៏ បាន លើកឡើង ដែរ ថា រាល់ សំណើរ និង សំណូមពរ របស់ បងប្អូន ប្រជាពលរដ្ឋ ពាក់ព័ន្ធ បញ្ហា ការជួសជុល ផ្លូវការ ដាក់ បង្គោល ភ្លើង សាធារណៈ ជាដើម រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង ធ្វើ ការដោះស្រាយ ទៅ តាម ធនធាន ដែល មាន ពោល គឺ កម្រិត ណា ត្រូវ ប្រគល់ ឱ្យ ខណ្ឌ និង កម្រិត ណា ប្រគល់ ឱ្យ ថ្នាក់ រាជធានី ដោះស្រាយ ។ តែ ទោះបីជា យ៉ាងណា ក្តី មកដល់ ពេលនេះ យើង បាន ដាក់ បង្គោល ភ្លើង បំភ្លឺ សាធារណៈ បាន ជា ២ម៉ឺន ដើម ហើយ ហើយ ការងារ នេះ យើង នៅតែ បន្ត ទៅ តាម កម្រិត ធនធាន ដែល មាន ។
( កោះកុង ) ៖ ឧត្តមសេនីយ៍ ទោ សំ ឃិត វៀន ស្នងការ នគរបាល បាល ខេត្ត កោះកុង បាន ចុះ សំណេះសំណាល និង ពាំនាំ ការផ្តាំផ្ញើ សួរសុខទុក្ខ ពី នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អង្គ ស្នងការ នគរបាល ជាតិ និង ធ្វើ ការផ្សព្វផ្សាយ បទ បញ្ជា សភាពការណ៍ ភាព ថ្មី និង ធ្វើ ការផ្តល់ អាវ រងា ដល់ កងកម្លាំង ឈរជើង វរៈ សេនា តូច នគរបាល ការពារ ព្រំដែន គោក លេខ ៨២៧ និង ធ្វើ ការត្រួតពិនិត្យ គុណភាព អាវុធ នៅ រសៀល ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០១៩ ដោយ មាន ការចូលរួម ពី ស្នងការរង ព្រមទាំង កម្លាំង នគរបាល ជាតិ ជាច្រើន នាក់ ។
ឧត្តមសេនីយ៍ ទោ សំ ឃិត វៀន បាន ថ្លែង ថា កម្លាំង នគរបាល ជាតិ មាន តួនាទី សំខាន់ ណាស់ ក្នុង ការពារ ប្រទេសជាតិ ការពារ សុវត្តិភាព ប្រជាពលរដ្ឋ ឲ្យ មាន សុខ សន្តិភាព មាន ការអភិវឌ្ឍ រីកចំរើន មាន ធនធាន មនុស្ស ដោយសារ ក្រោម ការដឹកនាំ ដ៍ ឈ្លាស វ៉ៃ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។ ដូច្នេះ កម្លាំង នគរបាល ជាតិ យើង ទាំងអស់ ត្រូវ ជឿជាក់ ទៅ លើ សម្តេច តេជោ ជានិច្ច ដែល សម្តេច តែងតែ រក សុខ សន្តិភាព ជូន ជាតិ ជូន ប្រជាជន ទូទាំង ប្រទេស ។
ឧត្តមសេនីយ៍ សំ ឃិត វៀន បាន ថ្លែង បន្ត ថា ជន ក្បត់ ជាតិ ទណ្ឌិត សម រង្ស៊ី មាន ផែនការណ៍ ចង់ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល កើត ចេញ ពី បេះដូង ប្រជាពលរដ្ឋ ស្រប ច្បាប់ ដែល និង កំពង់ រក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ ប៉ុណ្ណោះ ទេ ពេលនេះ ទណ្ឌិត សម រង្ស៊ី កំពង់ វិវត្តន៍ ខ្លួន ក្លាយទៅជា មេ ភេវករ ហើយ ព្រោះ តាមរយៈ ការលើកឡើង របស់ ទណ្ឌិត រូប នេះ ថា នឹង កៀង គរ លុយ ដើម្បីឲ្យ ទ័ព ផ្តាច់ ខ្លួន ហើយ បង្វែរ ចុង កាណុង ដាក់ រាជ រដ្ឋាភិបាល វិញ ។
( ភ្នំពេញ ) ៖ លោក សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន ថ្លែង ថា ក្រសួង សុខាភិបាល បាន ដាក់ បញ្ជូល ថ្នាំ មួយ ប្រភេទ ថ្មី បន្ថែម ទៀត ដើម្បី ព្យាបាល ជំងឺ គ្រុនចាញ់ ដែល មាន ឈ្មោះ ថា Primaquin ដែល មាន សមត្ថភាព ពិសេស អាច ព្យាបាល អ្នក ដែល មាន ជំងឺ គ្រុនចាញ់ ដោយ ទទួលបាន ប្រសិទ្ធភាព ខ្ពស់ ថែមទាំង អាច បង្ការ ជំងឺ គ្រុនចាញ់ មិន ឱ្យ ឆ្លង រាល ទៅ មនុស្ស ដ៏ទៃ ទៀត តាមរយៈ សត្វ មូស ផងដែរ ។
លោក សាស្រ្តាចារ្យ ម៉ម ប៊ុន ហេង បាន បញ្ជាក់ ទៀត ថា បច្ចុប្បន្ន នេះ ក្រសួង បាន នឹង កំពុង ធ្វើ ការសាង ល្បង ថ្នាំ Primaquin នេះ ចំនួន ៤ ខេត្ត ជាមុន សិន បើ ឃើញ ថា នៅតែ មាន ប្រសិទ្ធ ខ្ពស់ ក្រសួង និង បន្ត ប្រើប្រាស់ ឱសថ ប្រភេទ នេះ ទៅ តាម បណ្តា ខេត្ត ផ្សេង ៗ ទៀត ផងដែរ ដើម្បី ធ្វើ យ៉ាងណា ឈាន ទៅដល់ ផែនការ លុបបំបាត់ ជំងឺ គ្រុនចាញ់ គ្រប់ ប្រភេទ ឲ្យបាន តាម ការកំណត់ នៅ ឆ្នាំ ២០២៥ ។
ជន ត្រូវ ចោទ រូប នេះ ត្រូវបាន កម្លាំង សមត្ត កិច្ច បាន ធ្វើ ការឃាត់ខ្លួន កាលពី ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០១៩ ក្រោយ ធ្វើ កាស្រាវជ្រាវ ដោយ រកឃើញ ទីតាំង ចំនួន ២កន្លែង កំពុង លួចលាក់ ផលិត ឱសថ មិន ត្រឹមត្រូវ តាម ច្បាប់ របស់ កម្ពុជា ។
