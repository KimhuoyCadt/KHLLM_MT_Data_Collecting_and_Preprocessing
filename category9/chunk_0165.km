ជាមួយ បញ្ហា ប្រឈមមុខ នៃ វិស័យ អប់រំ ទាំង នេះ និង កុមារ ដល់ អាយុ ចូល សាលារៀន បន្ត កាន់តែ កើន ច្រើន ឡើង ៗ
ពួកគេ ទាំង ពីរ ត្រូវការបោះជំហាន ទី១ មុននឹង បោះជំហាន ទី២ ។
បរិយាកាស ផែនដី ងាយ មាន ចំណាំងផ្លាត ជាមួយ ជំហាន រលក ទាប ជាង គេ ដែល ជា ពណ៌ ផ្ទៃ មេឃ ដូច្នេះហើយ ចំណាំងផ្លាត នេះ ក៏ បង្កើត ឱ្យ ផ្ទៃ មេឃ មាន ពណ៌ ផ្ទៃ មេឃ ។
រាល់ ទំនាក់ ទេសចរណ៍ និង ពាណិជ្ជកម្ម ជាមួយ គុយ បា នឹង ត្រូវ រឹតបន្តឹង ឡើងវិញ ក្រោម វិធានការ ថ្មី របស់ លោក ត្រាំ ។
ប៉ុន្តែ វា អត្រា នេះ បាន ធ្លាក់ចុះ ជា បន្តបន្ទាប់ ។
ប្រកាស នេះ ខ្ញុំ សង្ឃឹម ថា លោក ប៉ែន សំអាត … បន្ត ការអាន
ការតាមដាន ជាង មួយ ទសវត្ស ៤៣ ភាគរយ នៃ អ្នកជំងឺ បាន ស្លាប់ ។
ពិព័រណ៍ នេះ មាន តាំង បង្ហាញ នូវ ផលិតផល និង សេវា ជាច្រើន ប្រភេទ ដូចជា ៖
លោក នីរតនា ភរិយា និង កូន
ជា ពេលវេលា ត្រូវ ចរចា និង ផ្តោះ ប្តូរ មតិ យោបល់ មិន មែន ជា ពេល ត្រូវ ចុះ ថ្នល់ ធ្វើ បាតុកម្ម ទេ ៕
សូម្បីតែ អ្នក ឱ្យ កូន បៅ ដោះ ក៏ដោយ ប៉ុន្តែ បើសិនជា អ្នកទទួលទាន ផលិតផល ទឹកដោះគោ នោះ ក៏ ធ្វើឱ្យ ទារក មាន ប្រតិកម្ម របាន ដែរ ។
ចុង ឆ្នាំ នេះ ខេត្ត កោះកុង នឹង មាន ព្រលានយន្តហោះ ថ្មី ហើយ បូក គោ ញូស
ពេល ដែល លោក ហ៊ុន សែន ចេញ ពី ប្រជុំ លោក ក៏ មិន ព្រម ឆ្លើយ សំណួរ របស់ អ្នកកាសែត ពី ចំណាប់អារម្មណ៍ អង្គប្រជុំ នោះ ដែរ ។
៩ឫកពា របស់ ពួកគេ សំដែង អោយ ឃើញ ថា
គឺ លោក គង់ ពុទ្ធី ផ្តល់អោយ តែ មនុស្ស ជំនិត ខ្លួន ។
ចំពោះ ព្រឹត្តិការណ៍ ដែល មាន មនុស្ស តិច ជាង ១.០០០ នាក់ អាជ្ញាធរ មូលដ្ឋាន នឹង ធ្វើ ការសម្រេចចិត្ត លើ ស្ថានភាព ជាក់ស្តែង ។
ដូចនេះ ចង់ ហេតុការណ៍ ល្អ ឬ អាក្រក់ កើតឡើង យ៉ាងណា ក៏ គេ មិន ដឹង ដែរ ។
សូម្បី តំណាងរាស្ត្រ បក្ស កាន់អំណាច ក៏ គាំទ្រ ភោជនីយដ្ឋាន កញ្ញា រ៉ូហ្ស៊េត នោះ ដែរ ។
ដែល កើតមាន ក្រោម ការដឹកនាំ របស់ ខ្លួន ទៀតផង ៖
ឃើញញឹកញាប់ ណាស់ មួយ រយៈ ចុងក្រោយ នេះ រឿង ស្រលាញ់ គ្នា ណាស់ ដល់ ពេល រៀបការ ហើយ បែរជា ប្តី លួច មាន ស្រី ក្រៅ ក្បត់ ចិត្ត ប្រពន្ធ ទៅ វិញ យូរ ៗ
មិត្ត ទាំងអស់ ទើប សម្រេច រួចរាល់ នូវ កិច្ចការ មួយ ដែល ខ្ញុំ ពុំ អាច មាន ពេល ធ្វើ បាន - នោះ គឺ យក បាន សញ្ញាប័ត្រ មហាវិទ្យាល័យ ។
ដើម្បី សេចក្តីស្រឡាញ់ ដែល ព្រះអង្គ មាន ចំពោះ យើង យើង ត្រូវ រស់ នៅ ដោយ ទី បន្ទាល់ ដែល សក្តិសម នឹង ព្រះនាម ព្រះអង្គ ដោយ ឆ្លុះបញ្ចាំង ឱ្យ គេ ឃើញ ថា យើង មាន លក្ខណៈ ដូច ព្រះអង្គ នៅក្នុង ពាក្យសម្តី និង ការប្រព្រឹត្ត របស់ យើង ។
សូម មើល រូប ខាងក្រោម បើ អ្នក ចង់បាន ដូចនេះ សូម ចូល ទៅកាន់ ចុច ទីនេះ
ក្រុម គ្រូពេទ្យ កម្ពុជា នឹង បន្ត តាមដាន សុខភាព ពួកគេ ជារៀងរាល់ ថ្ងៃ ៕
និពន ធបទ ច្រម ងេ
ការចុះ ថ្លៃ នេះ យោង ទៅ លើ ស្ថានភាព ទីផ្សារ ប្រេង ឆៅ ពិភពលោក ។
ដើម្បីឱ្យ អ្នកប្រើប្រាស់ អាច រើស ប្រើ បាន តាម ក្លិន ដែល ខ្លួន ចូលចិត្ត ។
នៅក្នុង ឱកាស នោះ ដែរ លោក រដ្ឋមន្ត្រី ក៏ បាន ឧបត្ថម្ភ ជូន លោកគ្រូ - អ្នកគ្រូ ទាំង១, ០១០នាក់ ក្នុង ម្នាក់ ៗ
ស្រី ស្អាត កាណាដា ម្នាក់ អាយុ ២១ ឆ្នាំ បដិសេធ រដ្ឋាភិបាល មិន ព្រម ចាកចេញ ពី វូហាន ដោយសារ មូលហេតុ មួយ នេះ
លើ ស្ពាន អ្នកលឿង ថ្មី មិន មែន ជា មជ្ឈមណ្ឌល កម្សាន្ត ទេ !
តួអង្គ ឈ្មោះ ឈុន ស៊ីណា ប្រាប់ នាង ថា ខ្ញុំ ដឹង ថា ខ្ញុំ គួរតែ អភ័យទោស ប៉ុន្តែ គាត់ សម្លាប់ ឪពុក របស់ ខ្ញុំ ហើយ ស្រែក ដាក់ ម្តាយ ខ្ញុំ ទៀត ។
កងទ័ព ត្រូវ គោរព ឱ្យ បាន នូវ រាល់ បទបញ្ជា ជាពិសេស បទបញ្ជា ផ្ទៃក្នុង
ជនសង្ស័យ បាន រត់គេចខ្លួន តែ ត្រូវ ប៉ូលិស ឃាត់ បាន ។
នាំគ្នា ងូតទឹក ស្រាត ដើម្បី បំបែក ឯកត្តកម្ម
រពឹស ណាស់ ងាយ ប៉ះទង្គិច ក្បាល អ៊ីចឹង ប៉ា ម៉ាក់ ត្រូវ ដឹង ធ្វើ ម៉េច ហើយ !
វេទិកា នេះ បើក អោយ មាន ការចូលរួម យ៉ាង ទូលំទូលាយ ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ក្នុង វិស័យ ការងារ មាន ដូចជា ៖
ដើម្បី ការពារ កុំព្យូទ័រ អ្នក ត្រូវ មាន ៖
យើង ដឹង ហើយ កាសែត ចុះផ្សាយ អស់ ហើយ ថា មកពី ប្រេស៊ីល អី ។
រុស្ស៊ី តែងតែ ធ្វើ ទំនើបកម្ម ទៅ លើ សព្វាវុធ គ្រប់ ប្រភេទ របស់ ខ្លួន ។
អូស្ត្រាលី និង អាស៊ាន ចែករំលែក ការងារ ស៊ើបអង្កេត ដើម្បី ប្រឆាំង អំពើ ភេរវកម្ម
ទោះបីជា អ្នកនាង មមាញឹក ក្នុង ការងារ យ៉ាងណា ក៏ដោយ ក៏ អ្នកនាង មិន ដែល ធ្វេសប្រហែស ក្នុង ការថែរក្សា សម្រស់ ឡើយ ។
ពលរដ្ឋ កំពុង ពិនិត្យ ឈ្មោះ បោះឆ្នោត !
សម្ភារៈ ដែក អ៊ីណុក ដែក ថែប កាបូន ។
លោក បន្ត ថា ការរីកចម្រើន ផ្នែក នេះ អាច នាំ ដល់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង សង្គម ៖
ព្រឹត្តិការណ៍ ប្រចាំ ឆ្នាំ នេះ ប្រព្រឹត្តិ ទៅ នៅ ថ្ងៃទី 22 ខែមេសា ដោយ ក្នុង នោះ …
នាងខ្ញុំ ចាបក វី ជូន សេចក្តីប្រែ សម្រួល ។
ដូច្នេះ ចូរ ធ្វើ យ៉ាងណា ដុស សម្អាត ធ្មេញ ឱ្យ បាន ស្អាត ល្អ សិន មុនពេល ចាប់ផ្តើម សកម្មភាព មួយ នេះ ។
កាល ហ្នឹង គគ្រិច ខ្លាំង មែនទែន ហ្មង ។
ករណី នេះ បន្សល់ទុក កូនប្រុស អាយុ ១៣ ឆ្នាំ និង អាយុ ១៨ ឆ្នាំ ឱ្យ រស់ នៅ កំព្រា ៕
ហើយ ទី៤ គឺ បញ្ហា ក្រមសីលធម៌ ។
ការ មិន យោគយល់ គ្នា ការចោទ និង មាក់ងាយ គ្នា បាន កើត មាន ឡើង រវាង ជាតិ សាសន៍ ដែល នៅក្បែរ គ្នា ទាំង ពីរ នេះ ។
ជា មនុស្ស សម្បូរ មិត្តភក្តិ មាន ចិត្ត សប្បុរស សន្តោស ប្រណី ជាពិសេស មនុស្ស ប្រភេទ នេះ មិន ងាយ ជឿ ទៅ លើ រឿង អាក្រក់ ៗ
ទៀត ដែល អនុញ្ញាតឱ្យ ផ្សព្វផ្សាយ ជាសាធារណៈ ។
ទាន ដែល អូន ចែក ក្នុង ១គ្រួសារ ៗ
