ខ្ញុំ ដឹង ថា ខ្ញុំ ល្ងង់ ក្នុង ការទាយ ថា លោក នឹង មាន ការបោះឆ្នោត តាម បែប ប្រជាធិបតេយ្យ ថ្មី ។
ម្យ៉ាង វិញ ទៀត ស្ទូឌីយោ និយាយ ថា ពួកគេ មិន បានជាប់ពាក់ព័ន្ធ ជាមួយនិង រឿង នោះ ទេ ។
នៅពេល ព្រះអង្គ មាន ព្រះជន្មាយុ ១៦ វស្សា ព្រះអង្គ ទ្រង់ បាន រៀប អភិសេក ជាមួយ ព្រះនាង ពិម្ពាយ សោធ រា ។
យើង នឹង ដណ្តឹង នាង ធ្វើជា ភរិយា
លំដាប់ ពិភពលោក ទៅ ចូលរួម ផងដែរ ។
លោក ពេត្រុស បដិសេធ ថា មិន ស្គាល់ ព្រះយេស៊ូវ
ទំព័រ ក្នុង ចំណាត់ថ្នាក់ ក្រុម សម្តេច ប៉ាប
នេះ សហរដ្ឋ អាមេរិក កំពុងតែ មាន ការព្រួយបារម្ភ និង ការប្រុងប្រយ័ត្ន កាន់តែ ខ្លាំង ឡើង ៗ
សំឡេង គាត់ និយាយ បន្ត មកកាន់ ខ្ញុំ ៖
អេក្រង់ ស ទំហំម ។
ទោះបីជា ព្រះទ្រង់ ដាក់ យើង នៅ កន្លែងណា ក៏ដោយ ក្នុង លោកិយ នេះ ក៏ ព្រះអង្គ នៅតែ អាច ប្រើ យើង …
ក្រសួង ការងារ ព្រួយបារម្ភ ការបំលាស់ ទី របស់ ពលករ មិន មាន ជំនាញ ច្បាស់លាស់ ក្នុង សហគមន៍ អាស៊ាន
ឈឺ ពេលព្រឹក ពេល ខ្លះ ក្អួត ។
គាត់ និយាយ ពាក្យ នេះ ដូច ឱ្យ ហេតុ អញ្ចឹង មុនពេល លោត លោកគ្រូ លឹម សាយ និយាយ ថា ខ្ញុំ … មាន វិដេអូ
ដែល ព្រះអង្គ បាន ប្រទាន មក ឱ្យ ប្រជាជាតិ ទាំងអស់
ព្រះយេស៊ូវ បើក សំដែង
បើសិនជា យើង នឹក គិត ពី រឿង ដែល បាន កើតឡើង ក្នុង ជីវិត របស់ យើង ដែល ចាស់ ជាង គេ តាំងពី
ការបន្តាប ខ្លួន ការចុះ ចូល ចំពោះ ព្រះហើយ និង មនុស្ស ភាគ ទី២
នៅពេល ខ្ញុំ ចាប់ផ្តើម ធ្វើ សមាធិ ដំបូង ខ្ញុំ ត្រូវ លួងលោម ខ្លួន ឯង ដើម្បី ធ្វើ វា ក្នុង រយៈពេល ៥ឬ ១០នាទី ។
និង យំ អាឡោះអាល័យ អ្នក ទាំង ពោល ថា
ដោយសារ ដែល បណ្តាល មកពី
ម្តាយ ខ្ញុំ ម្តាយ គេ ជីដូន ខ្ញុំ ជីដូន គេ ពិត មិន ចង់ឱ្យ លំបាក ឡើយ
ដើម្បី រម្ងាប់ ភាពខឹង របស់ យើង មិន បញ្ចេញ ទៅ លើ កូន ។
អង្គការ ពាណិជ្ជកម្ម ពិភពលោក យើង ចូល តាំងពី ក្នុង ឆ្នាំ ២០០៣ ឯណោះ ។
ស្តេប មាន អ្វី ពិសេស សម្រាប់ ឱកាស តារា ញូស៍
នេះ ជា គម្រោង ធំ មួយ ដែល នឹង ត្រូវការ ពេលវេលា ។
ពិតជា សំខាន់ ណាស់ ដូចគ្នា នេះ ដែរ ប្រសិនបើ អ្នក ចង់ឱ្យ មនុស្ស ជា ទី ស្រលាញ់ របស់ អ្នក …
ដែល កើតឡើង នៅក្នុង សង្គម ។
មិន តែ ប៉ុណ្ណោះ សូម្បីតែ សម្ភារៈ ប្រើប្រាស់ ជាមួយ រថយន្ត ក៏ មាន តម្លៃ ថ្លៃ ផងដែរ ។
លក់ ទ្វារ គ្រប់ ប្រភេទ
ក្រុមហ៊ុន អាកាសចរណ៍ ថៃ មួយ យក មនុស្ស ខ្ទើយ ធ្វើជា អ្នក បំរើ តាម យន្តហោះ
វា អាច មាន ស្ថានភាពខ្លាំងក្លា តែ មួយ រយៈពេល ខ្លី ហើយ វា អាច បាត់ ទៅវិញ ក៏ មាន ។
បើ គាត់ បណ្តែត បណ្តោយ ប្រហែលជា ស្គាល់ សង្គម ច្រើន ជាង ។
នៅពេល គេ ចាប់ផ្តើម ថ្វាយ តង្វាយ ដុត ទាំងមូល គេ ក៏ ចាប់ផ្តើម ច្រៀង ថ្វាយ ព្រះអម្ចាស់ ដោយ មាន ត្រែ និង ឧបករណ៍ តន្ត្រី របស់ ព្រះបាទ ដាវីឌ ជា ស្តេច ស្រុក អ៊ីស្រាអែល ប្រគំ កំដរ ផង ។
ខ្ញុំ ជិះ កង់ មក ធ្វើការរាល់ ថ្ងៃ ដែរ ។
នឹង ប្រើ ថ្លាង ទាំងនោះ សំរាប់ ស្ងោរ សាច់ ។
នេះ បាន និង កំពុង ទទួល ការចាប់អារម្មណ៍ ជាខ្លាំង នៅលើ បណ្តាញ សង្គម ។
ដោយ សេចក្តីគោរព ពី ចំងាយ ពី ខ្ញុំបាទ ពិសិដ្ឋ
ក្នុង រដ្ឋសភា តើ គណកម្មាធិការ និមួយ ៗ
គួរឱ្យ អាណិត បំផុត គឺ កុមារា កុមារី ដែល គ្មាន មិន បាន ដឹង អី ហើយ រងគ្រោះ ដែរ ។
ប្លាស្ទិក អត់ បាន ទេ ពុល ខ្លាំង ណាស់ ។
នេះ ប៉ុន្តែ គាត់ បាន រត់គេចខ្លួន រួច មុនពេល ត្រូវបាន ចាប់ខ្លួន ។
ទូលបង្គំ សូម លើក តម្កើង ព្រះអង្គ យ៉ាង អស់ ពី ចិត្ត
ឧបទ្ទវហេតុ នេះ ត្រូវបាន ដឹង ជាសាធារណៈ លើក ដំបូង នៅពេល អ្នកប្រើ ហ្វេសប៊ុក ម្នាក់ បាន បង្ហាញ វីដេអូ និង រូបភាព ពី ឧបទ្ទវហេតុ នេះ ដែល មាន អ្នកចែករំលែក តគ្នា ជាង ៤. ៤០០ ដង ។
រួច គេ ចូលមក ឃាត់ អី ទៅ បាន ចៅសង្កាត់ ចូលមក ហៅ ទៅ សម្របសម្រួល ខាងក្នុង ។
ខ្ញុំ ក៏ ស្រែក តែម្តង ទៅ ។
បំបាត់ អផ្សុក ។
ច្បាំង ចុះ ច្បាំង ឡើង អស់ ដី រលីង ។
ដូច្នេះ ប្រជាពលរដ្ឋ ទាំងអស់ គឺជា ចំណាប់ខ្មាំង របស់ អ្នក ផ្តាច់ការ ។
ទៅ រឿង ចម្លែក ៗ
ហើយ នៅ រស់ ឥឡូវ ប្រាប់ រឿង ពិត
គាត់ តែងតែ និយាយ អំពី បញ្ហា ប្រាក់ខែ នេះ រហូត ។
កាល គេ ជឿ ដំណឹង ល្អ អំពី ព្រះរាជ្យ របស់ ព្រះជាម្ចាស់ និង អំពី ព្រះនាម ព្រះយេស៊ូគ្រិស្ត ដែល លោក ភីលីព ប្រកាស ប្រាប់ គេ ក៏ ទទួល ពិធី ជ្រមុជ ទឹក ទាំង ប្រុស ទាំង ស្រី ។
អ្នក នឹង មាន អារម្មណ៍ ថា ល្បឿន កុំព្យូទ័រ របស់ អ្នក នឹង ប្រសើរឡើង មួយ រំពេច ។
ពិសេស យល់ ពី ការលំបាក ក្នុង នាម ជា ស្ត្រី ម្នាក់ ក្នុង ពេល បច្ចុប្បន្ន នេះ ។
គឺ អាមេរិក តាម ទំលាក់ ដាក់ ពួក យៀក កុង ដែល
ត្រកូល ក្បត់ ជាតិ សាសនា និង ព្រះមហាក្សត្រ បង្ហាញ ច្បាស់ ហើយ !
គាត់ មិន ដែល ធ្វើឱ្យ ខ្ញុំ ពិបាក ទេ ។
ប៉ុន្តែ យើង អាចនឹង ភ្ញាក់ផ្អើល បើ បាន ដឹង លក្ខណៈ ពិសេស របស់ មនុស្ស ចូលចិត៌្ត ពណ ខ្មៅ តាម ការបកស្រាយ ខាងក្រោម នេះ ៖
ម៉ាមី មិន ចេះ វិន័យ សង្ឃ អ្វី ទេ ហើយក៏ មិន ដឹង សង្ឃ ណាមួយ ខុស ណាមួយ ត្រូវ ផងដែរ ។
ហេតុការណ៍ បាន កើតឡើង នៅ ច្រក ព្រំដែន ឡែម ខេត្ត បាត់ដំបង ។
ការងារ ទំនាក់ទំនង ត្រួត គ្នា ច្រើន ធ្វើឱ្យ ឥទ្ធិពល អាក្រក់ ដល់ ការងារ ។
ខ្ញុំ មិន អាច ហៅ ថា កវី បាន ទេ បាន ត្រឹមតែ ហៅ អ្នកនិពន្ធ ប៉ុណ្ណោះ ។
ដូច្នេះ នៅ មិន ទាន់ ច្រើន ទេ ។
ជា ចុងក្រោយ នេះ ស្រី ពៅ ក៏ បាន ចេញដំណើរ ទៅកាន់ មន្ទីរពេទ្យ ប្រទេស ឥណ្ឌា
លោក ចំណាយ ប្រាក់ ជាច្រើន ដើម្បី ទទួលបាន ការអនុញ្ញាត ។
តែងតែ ខិតខំ ស្វែងរក មិត្ត ស្រី ដែល អស្ចារ្យ និង ទាន់សម័យ ។
ថ្ងៃ ដោយ លក់ បែប នេះ
ការគ្រប់គ្រង អចលន ទ្រព្យ របស់ អ្នក ៖
ដល់ ពេលវេលា ដើម្បី ពិភាក្សា ធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ ហើយ
គ្មាន ការបោះឆ្នោត ឡើងវិញ តាម ការចង់បាន របស់ ក្រុម ប្រឆាំង ឡើយ
កត្តា ធ្វើឱ្យ សត្វ លូតលាស់ ដូចជា សារធាតុ អាសេនិច ។
ស្វាគមន៍ ការមកវិញ នៃ ប្លក របស់ សាមឺឌី !
អ្នកណា ថា មិន ចូលចិត្ត កាលពី មុន ទំនេរ ៗ
ជា កិត កិត្តិយស បំផុត បើ ខ្ញុំបាទ ត្រូវបាន ជ្រើសរើស ជា ជ័យលាភី បន្ទាប់ពី បាន សំរេចចិត្ត ប្រកបដោយ សុភវិនិច្ឆ័យ ពី សំនាក់ គណកម្មាការ ។
រាត្រី នោះ គេ ឃើញ ថា មិត្ត រួម អាជីព រួម ការងារ របស់ កូនកំលោះ កូនក្រមុំ …
ប៉ុន្តែ យើង មិន មាន កិច្ចសន្យា នៅ ឆ្នាំ នេះ ទេ ។
ដទៃ ធ្វើបាប នាង រួមទាំង ជា មិត្ត ជិតស្និទ្ធិ នឹង គ្នា នោះ ។
ជា លើក ដំបូង លោក ត្រាំ ហាក់ ទទួលស្គាល់ បរាជ័យ ក្នុង ការបោះឆ្នោត
នោះ គឺ ជនជាតិ ជ្វីហ្វ ។
មិន ទាន់ មាន ការបញ្ជាក់ ថា ជា អំពើ ភេរវកម្ម !
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក អ្នកប្រើប្រាស់ តាំង ប៊ុន ហុង ៖
សំរាប់ វីនដូវ ទាញយក ទីនេះ
ជា តួយ៉ាង ប្រសិនបើ អ្នក មាន ពេល គួរ ដើរ ឬ ជិះ កង់ ជំនួស ការបើក រថយន្ត ៕
ពួក អ្នកវិទ្យាសាស្ត្រ នឹង បញ្ជូន សារ ទៅ មនុស្ស ភព ក្រៅ នៅ ឆ្នាំ ក្រោយ នេះ ហើយ !
បង្កឱ្យ មាន ការភ្ញាក់ផ្អើល កាលពី ម៉ោង ៥ ៖
ក្នុង ការថ្លែង ទៅកាន់ ប្រជាជាតិ កាលពី យប់ ថ្ងៃអង្គារ នាយក រដ្ឋមន្ត្រី ណារ៉េន ដ្រា ម៉ូឌី បាន និយាយ ថា ប្រទេស ដែល មាន ប្រជាជន ១៣ ពាន់ លាន នាក់ នេះ កំពុង ប្រយុទ្ធ នឹង សង្គ្រាម ធំ មួយ ជាថ្មី ។
កូន ភ្លោះ ខ្លួន ជាប់ គ្នា គឺជា ករណី កម្រ ណាស់ ។
ពួកគេ បាន ជិះ កង់ តវ៉ា កាលពី ថ្ងៃសៅរ៍ ទី ១៧មិថុនា ប្រឆាំង នឹង អ្នកបើកបរ និង ការបញ្ចេញ ឧស្ម័ន ពុល ពី រថយន្ត ។
បើ ដូច្នេះ មែន ខ្ញុំ គ្មាន យោបល់ អ្វី ទេបាទ ហួស នឹង និយាយ ជាមួយ ពួក លោក ធំ អស់ ហ្នឹង ហើយ ។
ដើម្បី សម្រេចបាន គោលដៅ នេះ ការិយាល័យ ជំរឿន នឹង ៖
អ្នកដឹកនាំ ដ៏ អស្ចារ្យ ម្នាក់ ត្រូវតែ មាន តម្លាភាព ជានិច្ច មិន ថា ស្ថិត ក្នុង ស្ថានភាព ណា ក៏ដោយ ។
ប៉ុន្តែ នៅតែ ជាប់ បណ្តឹង ពាក់ព័ន្ធ នឹង ការតវ៉ា ដីធ្លី នៅ បឹងកក់ ។
ទោះ យ៉ាងណា អំណាច នៃ ការសម្រេចចិត្ត គឺ …
គេ មិន អាច ទាក់ទង មន្ត្រី សហរដ្ឋ អាមេរិក បាន ភ្លាម ៗ
ពួកគេ ពេលនេះ បាន ចេញ ពី មន្ទីរពេទ្យ អស់ ហើយ ៕
ភាពជោគជ័យ របស់ ខេម នៅ ថ្ងៃ នេះ ធ្វើឱ្យ លោក ខ្លួន ឯង សឹងតែ នឹកស្មាន មិន ដល់ ទៅ ហើយ ។
ក្នុង រយៈពេល នេះ ដែរ លោក អ្នក មិន ត្រូវ ប្រគល់ កិច្ចការ សំខាន់ ៗ
នេះ ក៏ ដោយសារ វា ជា បញ្ហា សន្តិសុខ ជាតិ ផងដែរ ។
របួស អ្នក ទាំង ពីរ តម្រូវ ឱ្យ មាន ការព្យាបាល ។
សូម ទស្សនា វីដេអូ ខាងក្រោម ប្រសិនបើ អ្នក មិន ទាន់ បាន មើល ៖
េត្ត សៀមរាប នោះ ។
អា នេះ ជា បញ្ហា ធំ ក្នុង ខេត្ត ព្រះសីហនុ ។
២០ ព្រះអង្គ ត្រាស់ ហៅ អ្នក ទាំង ពីរ ភ្លាម គេ ក៏ ដើរ តាម ព្រះយេស៊ូ ទៅ ទុក ឪពុក អោយ នៅក្នុង ទូក ជាមួយ ពួក កូន ឈ្នួល ។
ព្រះយេស៊ូ បាន បញ្ជា ឱ្យ យើង ធ្វើជា បន្ទាល់ ប្រកាស ប្រាប់ ប្រជាជន ថា ព្រះជាម្ចាស់ បាន តែងតាំង ព្រះអង្គ ឱ្យ វិនិច្ឆ័យ ទោស មនុស្ស រស់ និង មនុស្ស ស្លាប់ ។
សង្ឃឹម ថា រោងចក្រ នេះ នឹង បន្ត ដើរ លើ គំនរ សន្តិភាព ។
តែ លោក ចាមេស កន្លងមក បាន អះអាង អំណាច របស់ លោក គឺ បាន មកពី ការប្រទាន របស់ ព្រះជាម្ចាស់ ៕
ដែល រសាយចិត្ត ពី
៨ឥឡូវនេះ ព្រះអម្ចាស់ ជា ចៅក្រម ដ៏ សុចរិត បាន បម្រុង ភួង ជ័យ នៃ សេចក្តីសុចរិត ទុក សំរាប់ ខ្ញុំ ហើយ ព្រះអង្គ នឹង ប្រទាន អោយ ខ្ញុំ នៅ ថ្ងៃ ដែល ព្រះអង្គ យាង មក ទ្រង់ មិន ត្រឹមតែ ប្រទាន អោយ ខ្ញុំ ម្នាក់ ប៉ុណ្ណោះ ទេ គឺ ប្រទាន អោយ អស់ អ្នក ដែល មាន ចិត្ត ស្រឡាញ់ ទន្ទឹងរង់ចាំ ព្រះអង្គ យាង មក យ៉ាង ឱឡារិក នោះ ដែរ ។
ជា មនុស្ស ចូលចិត្ត ចំអក ឱ្យ ខ្លួន ឯង ។
មិន អាច ស្វែងរក ការបំភ្លឺ ណាមួយ ពី បុរស ជា ប្តី ជុំវិញ ការចោទប្រកាន់ របស់ ស្ត្រី ជា ប្រពន្ធ នោះ បាន ទេ ម្សិលមិញ នេះ ៕
តើ មាន កន្លែង ណាមួយ ដែល អ្នក ពុំ បាន
វា អាចនឹង មាន ទិន្នន័យ ខុសគ្នា បន្តិច ប៉ុន្តែ អ្នក អាច ប្រើ វា ដើម្បី ប្រៀបធៀប គេហទំព័រ នីមួយ ៗ
អ្នក នឹង បាន ឃើញ អ្វី ជាពិសេស និង មាន អារម្មណ៍ ជាពិសេស ។
និង សន្សំ សំចៃ ប្រាក់ ដើម្បី បង្កើត គ្រួសារ ថ្មី សម្រាប់ នា ពេល អនាគត ៕
ចូរ ពិភាក្សា ជាមួយ គ្រូពេទ្យ របស់ អ្នក ពី របៀប ទទួលបាន កាល់ស្យូម ថែម ទៀត ប្រសិនបើ អ្នក គិត ថា អ្នក មិន ទទួល កាល់ស្យូម គ្រប់គ្រាន់ ពី អារហារ ដែល អ្នកទទួលទាន ទេ ។
តែ ក្រុម សមត្ថកិច្ច មិន បាន រកឃើញ អ្វី គួរអោយ សង្ស័យ និង ប៉ម នេះ ត្រូវបាន បើក ឡើងវិញ ។
ចំនួន ២ របស់ ទូរទស្ស ហង្ស មាស ។
ប៉ុន្តែ ជាញឹកញាប់ យើង ច្រើន តែ មាន ការស្ទាក់ស្ទើរ មិន ចង់ បែក ចេញ ពី របស់របរ ដែល មាន តម្លៃ ដែល យើង ប្រើ ជា រៀងរាល់ ថ្ងៃ ។
ទាល់តែ ផ្កាយ អនុវត្តន៍ មុន បាន ខ្ញុំ ធ្វើ តាម !
អ្នក អភិវឌ្ឍន៍ ត្រូវ អនុវត្ត តាម …
មុខវិជ្ជា វិទ្យាសាស្ត្រ នយោបាយ មាន ការចាប់អារម្មណ៍ តិច ពី យុវជន សារព័ត៌មាន តោះ អាន
ទោះ យើង មាន ការនឿយហត់ ក៏ដោយ ក៏ យើង នៅតែ អាច បើក ស្លាប នៃ សេចក្តីជំនឿ របស់ យើង ដើម្បី ហោះហើរ !
អូស្ត្រាលី ហ្វេសប៊ុក ច្បាប់
ខ្ញុំ ចូល ធ្វើ បដិវត្តន៍ នៅពេល អាយុ ១៤ ឆ្នាំ ។
បង បឿន នេះ គ្រាន់តែ ចូលចិត្ត អាន ក៏ ចាំបាច់ សើច ដែរ ខ្ញុំ ប៊ិះ ទូរស័ព្ទហៅ ឡានពេទ្យ !
អ្នក ត្រូវ បង្ហាញ ថា ហេតុ អ្វី បានជា ខ្ញុំ មិន ធ្វើ ដូច្នេះ ។
ចុច ត្រង់នេះ ដើម្បី ទៅ ទស្សនា វីដេអូ ធ្វើ
នៅ ថ្ងៃ នេះ ផ្តល់ ផល ល្អ សម្រាប់ លោក អ្នក ទំនាក់ទំនង ការងារ ឬ បើ ចង់ ធ្វើ អ្វី មួយ សំខាន់ ក៏ តែង ផ្តល់ ផល ល្អ មកវិញ ជានិច្ច ។
