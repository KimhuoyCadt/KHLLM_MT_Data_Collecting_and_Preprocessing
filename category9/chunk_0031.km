( បន្ទាយមានជ័យ )៖ ឧប នាយក រដ្ឋមន្ដ្រី កែ គឹម យ៉ាន ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ត បន្ទាយមានជ័យ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ អម ដំណើរ ដោយ ក្រុមការងារ ថ្នាក់ ជាតិ ខេត្ត ក្រុង ស្រុក និង មូលដ្ឋាន បាន បន្ដ អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ជិត ៣០០០ នាក់ មកពី ឃុំ គុត្ត សត ឃូំ កូប និង ឃុំ សំរោង ស្រុក អូរ ជ្រៅ ខេត្ត បន្ទាយមានជ័យ ។
ក្នុង ឱកាស នោះ ឧប នាយក រដ្ឋមន្ដ្រី កែ គឹម យ៉ាន បាន មាន មតិ សំណេះសំណាល និង នាំ ការផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី . សម្ដេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា . សម្ដេច វិបុល សេនា ភក្ដី សាយ ឈុំ ប្រធាន ព្រឹទ្ធសភា និង សម្តេច ក្រឡាហោម ស ខេង ។
ជាមួយគ្នា នេះ លោក កែ គឹម យ៉ាន បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ អ្នក អូរ ជ្រៅ ទាំងអស់ ដែល គោរព ស្រលាញ់ សម្តេច តេជោ ហ៊ុន សែន ចូលរួម ថែរក្សា សន្តិភាព ជាមួយ សម្តេច តេជោ ហ៊ុន សែន និង សូម បន្ត ថែរក្សា សន្តិភាព នេះ ឲ្យ នៅ គង់វង្ស ដោយ អញ្ជើញ ទៅ បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ឲ្យបាន គ្រប់ គ្នា លេខរៀង ទី ២០ ងាយ ចាំ ងាយ គិត ស្រួល គូស ដើម្បី សម្តេច តេជោ ហ៊ុន សែន បន្ត នាំយក វិបុលភាព វិបុល សុខ សម្រាប់ យើង និង កូន ចៅ យើង ។
លទ្ធផល នៃ ការប្រកួត រវាង អាហ្សង់ទីន នឹង ក្រូអាត នា ពេល កន្លងទៅ គឺជា រឿង គួរឲ្យ ភ្ញាក់ផ្អើល បំផុត មួយ ដោយ ការចាញ់ ០ - ៣ទល់ នឹង ក្រូអាត នេះ គឺជា បរាជ័យ ដ៏ ធំ បំផុត សម្រាប់ ក្រុម អាហ្សង់ទីន នៅក្នុង ប្រវត្តិសាស្រ្ត ។ បើ តាម សំបុត្រ បន្សល់ទុក ដោយ លោក Alex អ្នក ជឿជាក់ ថា អាហ្សង់ទីន នឹង អាច ឡើង ទៅ វគ្គ បន្ទាប់ ប៉ុន្តែ លោក មិន អាច ទ្រាំទ្រ ចំពោះ ការចាញ់ យ៉ាង អាម៉ាស់ នេះ បាន ។
គួរ ជម្រាប ថា នា ពេល កន្លងទៅ អ្នក អត្ថាធិប្បាយ បាល់ទាត់ ទូរទស្សន៍ អេហ្ស៊ីប ម្នាក់ ក៏ ត្រូវបាន គេ រាយការណ៍ ថា បាន ស្លាប់ ដោយសារ គាំង បេះដូង តែ ប៉ុន្មាន នាទី ប៉ុណ្ណោះ បន្ទាប់ពី ក្រុម ជម្រើសជាតិ អារ៉ាប៊ី សាអូឌីត ទាត់ បាល់ បញ្ចូល គ្រាប់ ទី ពីរ ដើម្បី ផ្ដួល អេហ្ស៊ីប នៅ ចុង ម៉ោង ក្នុង ព្រឹត្តិការណ៍ បាល់ទាត់ ៕
( បាត់ដំបង ) ៖ អតីត សមាជិក អតីត គណបក្ស សង្រ្គោះ ជាតិ ក្នុង សង្តាត់ អូរម៉ាល់ ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង បាន ប្តេជ្ញា ថា នឹង ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ខាងមុខ នេះ ដើម្បី អនាគត គ្រួសារ គាត់ សហគមន៍ គាត់ និង ដេម្បី ប្រទេសជាតិ មាន សន្តិភាព ទទួលបាន ការអភិវឌ្ឍ បន្ត ទៀត ។
ការប្តេជ្ញាចិត្ត បែប នេះ បាន ធ្វើឡើង ក្នុង ឱកាស អតីត សមាជិក គណប្ស សង្រ្គោះ ជាតិ ៣២៣ នាក់ ប្រកាស បញ្ចូល ជា សមាជិក គណបក្ស ប្រជាជន កម្ពុជា នៅក្នុង សង្កាត់ អូរម៉ាល់ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ក្រោម អធិបតីភាព លោក ឡេង ប៉េង ឡុង សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ សង្កាត់ អូរម៉ាល់ និង សង្កាត់ វត្ត គរ ក្រុង បាត់ដំបង ខេត្ត បាត់ដំបង ។
តំណាង អតីត គណបក្ស សង្រ្គោះ ជាតិ ដែល ស្ម័គ្រចិត្ត ចូលរួម ជីវភាព ជាមួយ មហា គ្រួសារ គណបក្ស ប្រជាជន កម្ពុជា បាន លើកឡើង ថា ការសម្រេចចិត្ត ចូលរួម ជីវភាព នយោបាយ ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា នា ឱកាស នេះ បន្ទាប់ពី បាន តាមដាន យ៉ាង យកចិត្តទុកដាក់ ចំពោះ កម្មវិធី គោល នយោបាយ និង សកម្មភាព គណបក្ស ប្រជាជន កម្ពុជា ឃើញ ថា គណបក្ស ប្រជាជន កម្ពុជា មាន ឧត្តម គតិ ខ្ពង់ខ្ពស់ មាន គោល នយោបាយ ក្នុង ការបម្រើ ប្រទេសជាតិ និង ប្រជាជន តាំងពីដើម មក ។
លោក ឡេង ប៉េង ឡុង បាន ស្វាគមន៍ និង កោតសរសើរ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ការសម្រេចចិត្ត របស់ ប្រជាពលរដ្ឋ នៅ ពេល នេះ ។ លោក បាន គូ សញ្ជាក់ ថា នេះ ជា ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ ពីព្រោះថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា មួយ តែ ប៉ុណ្ណោះ ដែល បាន ពលីកម្ម រំដោះ ពលរដ្ឋ និង បាន បម្រើ ពលរដ្ឋ រហូតមក នៅ គ្រប់ កាលៈទេសៈ ដោយ បាន លះបង់ សាច់ ស្រស់ ឈាម ស្រស់ ក្នុង ការស្វែងរក សន្តិភាព ជូន ពលរដ្ឋ ។
ប្រធាន ក្រុមការងារ សង្កាត់ អូរម៉ាល់ រូប នេះ បាន បញ្ជាក់ ថា ថ្នាក់ដឹកនាំ គណបក្ស ប្រជាជន កម្ពុជា ពិសេស សម្តេច តេជោ ហ៊ុន សែន បាន លះបង់ សេចក្តីសុខ និង ជីវិត ខ្លួន ក្នុង ការបម្រើ ការពារ ទឹកដី និង ពលរដ្ឋ រហូតមក ។
លោក ឡេង ប៉េង ឡុង បាន អបអរសាទរ ចំពោះ ការចេញ ទៅ បោះឆ្នោត របស់ ប្រជាពលរដ្ឋ នៅ ថ្ងៃទី ២៩ ខែកកក្កដា ខាងមុខ នេះ ដែល ជា ការបោះឆ្នោត ជ្រើសរើស មេដឹកនាំ ប្រទេសជាតិ បន្ត ទៀត ។ លោក បន្ត ថា មាន តែ គណបក្ស ប្រជាជន កម្ពុជា មួយ ប៉ុណ្ណោះ ដែល មាន គោល នយោបាយ ជាតិ ច្បាស់លាស់ ក្នុង ការបម្រើ ប្រជាពលរដ្ឋ ៕
( ភ្នំពេញ ) ៖ ធនាគារ ឯកទេស វីង បាន ធ្វើ ការចាប់ឆ្នោត ជា លើក ដំបូង ដើម្បី ស្វែងរក អ្នក ឈ្នះ រង្វាន់ ទាំង ២០ នាក់ ដែល បាន ប្រើប្រាស់ សេវា ផ្ទេរ ប្រាក់ ពី ក្រៅ ប្រទេស របស់ ធនាគារ ឯកទេស វីង ក្នុង កំឡុង ថ្ងៃទី ១៥ ខែឧសភា រហូតដល់ ថ្ងៃទី ១៤ ខែមិថុនា ឆ្នាំ ២០១៨ ។
ខាងក្រោម នេះ ជា ឈ្មោះ អតិថិជន ដែល ឈ្នះ រង្វា ន់៖
ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ ដូនសរ ប្រាប់ យុវជន រួមគ្នា ថែរក្សា សន្តិភាព និង ត្រៀម ឯកសារ ឲ្យបាន គ្រប់គ្រាន់ នាំគ្នា ទៅ បោះឆ្នោត
( ស្វាយរៀង ) ៖ លោក គឹម ងួន ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ឃុំ ដូនសរ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង នៅ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ បាន អំពាវនាវ ឲ្យ យុវជន រួមគ្នា ថែរក្សា សន្តិភាព ដោយ យើង មាន សន្តិភាព និង ស្ថេរភាព នយោបាយ ទើប យើង ទទួលបាន ការអភិវឌ្ឍ ប្រទេស ឲ្យ រីកចម្រើន ។
មិន តែ ប៉ុណ្ណោះ លោក គឹម ងួន ក៏ បាន អំពាវនាវ ពលរដ្ឋ ឲ្យ មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត និង ត្រៀម ឯកសារ ឲ្យបាន គ្រប់គ្រាន់ ដើម្បី នាំគ្នា ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ ។
ការថ្លែង បែប នេះ ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម សំណេះសំណាល ជា យុវជន គណបក្ស ប្រមាណ ជិត ៥០០ នាក់ នៅ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ឃុំ ដូនសរ ស្រុក ស្វាយ ជ្រំ ខេត្ត ស្វាយរៀង នៅ ព្រឹក ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ ។ ក្នុង ឱកាស នោះ លោក គឹម ងួន បាន នាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខ ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជូន អង្គ ពិធី ផងដែរ ។
លោក គឹម ងួន ផ្តាំផ្ញើ ដល់ អាជ្ញាធរដែនដី កងកម្លាំងប្រដាប់ ត្រូវ ការពារ សន្តិសុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ ប្រសើរ បន្ថែម ទៀត ជាពិសេស ត្រូវ ផ្តល់ សេវា សាធារណៈ ឲ្យបាន រហ័ស នៅក្នុង មូលដ្ឋាន ។ បន្ថែម ជាង នេះ ត្រូវ រួមគ្នា ថែរក្សា សមិទ្ធផល ដែល មាន ស្រាប់ និង បន្ត កសាង ឲ្យបាន ច្រើន បន្ថែម ទៀត ក្នុង ការសំរួល ដល់ ការរស់នៅ របស់ ពលរដ្ឋ ឲ្យ មាន ជីវភាព ធូធារ ។
នៅក្នុង ឱកាស នោះ ក្រុម យុវជន របស់ គណបក្ស ប្រជាជន បាន ប្តេជ្ញា ការពារ សុខ សន្តិភាព និង ការអភិវឌ្ឍ និង នាំគ្នា ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ឲ្យបាន គ្រប់ ៗ គ្នា ៕
រដ្ឋបាល ព្រៃឈើ ខេត្ត កណ្ដាល បកស្រាយ និង បញ្ជាក់ ពី ប្រតិបត្តិការ ចាប់ រថយន្ដ ដឹក ឈើ របស់ ស្ដ្រី ជន ពិការ . ឈើ ជា ប្រភេទ ឈើ លេខ ២ មាន ចំនួន ជាង ២៣ម៉ែត្រ គូប
( កណ្ដាល ) ៖ រដ្ឋបាល ព្រៃឈើ ខេត្ត កណ្ដាល នៅ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ បាន ចេញមក បកស្រាយ និង បញ្ជាក់ អំពី ប្រតិបត្តិការ ចាប់ រថយន្ដ ដឹក ឈើ របស់ ស្ដ្រី ជន ពិការ ដែល ដឹក មកពី ខេត្ត ពោធិ៍សាត់ លក់ នៅ ដេប៉ូ ឈើ ក្នុង ស្រុក ស្អាង ខេត្ត កណ្ដាល មិន មែន ជា ឈើ ជជុះ មិន មែន ចំនួន ១០ម៉ែត្រ គូប នោះ ទេ ពោល ជា ឈើ ប្រភេទ លេខ ២ និង មាន ចំនួន ជាង ២៣ម៉ែត្រ គូប ។
លោក បាន បន្ត ថា ចំពោះ ពាក្យ ថា កម្លាំង ចុះ ទៅ ឃាត់ ប្រើ ឥរិយាបទ មិន ល្អ ដោយ ប្រើ ពាក្យសំដី គំរោះគំរើយ នោះ ក៏ មិន មាន ដែរ លោក បាន សួរ ទៅ នាយ សង្កាត់ រដ្ឋបាល ព្រៃឈើ អង្គស្នួល ដែល ជា អ្នកដឹកនាំ ក្នុង ការបង្រា បទល្មើស ព្រៃឈើ នេះ បាន ប្រាប់ លោក ថា កម្លាំង របស់ លោក មិន បាន ប្រើ ពាក្យសំដី មិន ល្អ នោះ ទេ ម្យ៉ាង វិញ ទៀត ខណៈ ចុះ ទៅ ឃាត់ នោះ ក៏ មិន មាន ការប៉ះទង្គិច គ្នា នោះ ទេ ដោយ រថយន្ត ដឹក ឈើ បាន បើក អែប ឲ្យ កម្លាំង ធ្វើ ការត្រួតពិនិត្យ ។
ក្រោយពី ការឃាត់ ត្រួតពិនិត្យ ឃើញ ថា ការដឹកជញ្ជូន ឈើ អារ នេះ គ្មាន លិខិត អនុញ្ញាត ពី រដ្ឋបាល ព្រៃឈើ ក៏ រាយការណ៍ ជូន មក លោក ភ្លាម ហើយ បាន យក រថយន្ដ ដឹក ឈើ នោះ មក រក្សាទុក បណ្តោះអាសន្ន នៅ ស្នាក់ការ សង្កាត់ រដ្ឋបាល ព្រៃឈើ តា ខ្មៅ ដើម្បី ចាត់ការ បន្ត តាម នីតិវិធី ច្បាប់ ស្តីពី ព្រៃឈើ ។
នាយ ផ្នែក រដ្ឋបា ព្រៃឈើ តា ខ្មៅ បាន បន្ថែម ថា មន្ត្រី រដ្ឋបាល ព្រៃឈើ តាម បណ្តាល ខេត្ត ជាប់ ផ្លូវ លេខ ជាតិ លេខ ៥ ប្រាប់ ថា ស្រី្ត នេះ គឺជា ឈ្ញួញ រកស៊ី ឈើ គឺ ពួកគាត់ ធ្លាប់ បាន ចាប់ ឈើ របស់ ស្ត្រី ពិការ នេះ ដែរ ជាក់ស្តែង មន្រ្តី រដ្ឋបាល ព្រៃឈើ ផ្នែក កំពង់ស្ពឺ បាន ចាប់ ឃាត់ រថយន្ត របស់ គាត់ ចំណុះ ០៥តោន មាន ផ្ទុក ឈើ ចំនួន ប្រហែល១០ មែត្រ គូប និង បាន បញ្ជូន សនុំរឿង ទៅ តុលាការ កាលពី ចុង ឆ្នាំ ២០១៧ កន្លងមក ថ្មី ៗ នេះ ។
( កំពង់ធំ )៖ លោក ជា អឿង អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ប្រាសាទ បល្ល័ង្ក នៅ រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ បាន ដឹកនាំ ក្រុមការងារ ចុះ សាកសួរ សុខទុក ប្រជាពលរដ្ឋ និង ស្វែងយល់ ពី ស្ថានភាព នៃ ការអភិវឌ្ឍន៍ នៅក្នុង ភូមិ ឃុំ រួមទាំង បញ្ហា ប្រឈម នានា របស់ ពលរដ្ឋ នៅក្នុង ភូមិ ពពេល ឃុំ សាលា វិស័យ ស្រុក ប្រាសាទ បល្ល័ង្ក ខេត្ត កំពង់ធំ ។
លោក ជា អឿង បាន មានប្រសាសន៍ ផ្តាំផ្ញើ ការសាកសួរ សុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល ជានិច្ច ជាកាល សម្តេច តែងតែ គិតគូរ និង យកចិត្តទុកដាក់ ខ្ពស់ ជាប់ ជាប្រចាំ អំពី សុខ ទុក្ខ និង ការលំបាក ខ្វះខាត របស់ ប្រជាជន នៅ ទូទាំង ប្រទេស ។
លោក បាន លើកឡើង ថា សមិទ្ធិផល ដែល កើត មាន ឡើង នា ពេលនេះ គឺជា សក្ខីភាព ដែល បង្ហាញ នូវ ភាពរីកចម្រើន របស់ ប្រទេស ជាតិ លើ គ្រប់ វិស័យ ទាំង នៅ ទីក្រុង និង ជនបទ ដាច់ស្រយ៉ាល ក្រោម ការដឹកនាំ ដ៏ ត្រឹមត្រូវ និង ការគិតគូរ គ្រប់ ជ្រុងជ្រោយ ប្រកបដោយ ភាពវៃឆ្លាត និង ចក្ខុវិស័យ វែងឆ្ងាយ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្រ្តី ។
លោក បាន បន្ត ថា ជាមួយនឹង ការទទួលបាន នូវ សមិទ្ធិផល ថ្មី ៗ ខាងលើ វា ជា ឱកាស ដ៏ ល្អ ដើម្បី បង្ហាញ ពី ភាពជិតស្និទ្ធ ជា ប្រជាពលរដ្ឋ តាម មូលដ្ឋាន ផងដែរ ដើម្បី បាន ដឹង ពី សុខ ទុក្ខ ស្ថានភាព នៃ ការអភិវឌ្ឍន៍ និង បញ្ហា ប្រឈម នានា ដើម្បី ដោះស្រាយ ជូន ពួកគាត់ ជាដើម ។
លោក បាន ក្រើន រំលឹក ដល់ ក្រុមប្រឹក្សា ឃុំ ទាំងអស់ ត្រូវ បន្ត យកចិត្តទុកដាក់ ក្នុង ការបំពេញ ភារកិច្ច របស់ ខ្លួន ឱ្យ បាន ល្អ ប្រសើរ ជូន ដល់ ប្រជាពលរដ្ឋ និង ត្រូវ ស្វែងយល់ ពី បញ្ហា ប្រឈម និង ទុក្ខ កង្វល់ របស់ ប្រជាពលរដ្ឋ ដើម្បី ចាត់ វិធានការ ដោះស្រាយ ឱ្យ បាន ទាន់ ពេលវេលា និង ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ៕ ព្រឹក នេះ នគរបាល បញ្ជូន ជនសង្ស័យ សម្លាប់ នារី ចង ការប្រាក់ ព្រោះ គ្មាន លុយ សង ហើយ បោះចោល សព ក្នុង ប្រឡាយ ទឹក ស្អុយ ទៅ តុលាការ
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ កម្លាំង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ បាន បញ្ជូន ខ្លួន ក្រុន ជន ដៃ ដល់ ចំនួន ៣នាក់ ទៅ តុលាការ ដើម្បី ផ្ដ ទ្ទាទោស តាម ច្បាប់ ពាក់ព័ន្ធ ករណី ឃាតកម្ម លើ ស្ត្រី រកស៊ី ចង ការប្រាក់ ដែល ជនសង្ស័យ ទី ១៖ ឈ្មោះ អាត អឿន ភេទ ស្រី អាយុ ៣១ ឆ្នាំ មុខរបរ លក់ នំប៉័ង . ទី ២៖ ឈ្មោះ កែវ សុផានិត ភេទ ប្រុស អាយុ ២៨ ឆ្នាំ មុខរបរ លក់ នំប៉័ង និង ទី៣៖ ឈ្មោះ សុខ ហេង ហៅ អេត ចាយ ភេទ ប្រុស អាយុ ៣១ ឆ្នាំ ។
តាម ចម្លើយ សារភាព របស់ ជនសង្ស័យ ទាំង ៣នាក់ បាន ឲ្យដឹង ថា កន្លងមក ឈ្មោះ អាត អឿន បាន ចង ការប្រាក់ ពី ជនរងគ្រោះ ចំនួន ២០ ម៉ឺន រៀល ។ ដោយ មើលឃើញ ជនរងគ្រោះ មាន ម៉ូតូ និង គ្រឿងអលង្កា ជាប់ ខ្លួន នោះ ជនសង្ស័យ ទាំង ៣នាក់ ក៏ បាន រៀបចំ ផែនការសម្លាប់ និង ប្លន់ យក ទ្រព្យសម្បត្តិ ពី ជនរងគ្រោះ តែម្តង ។
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ឬស្សីកែវ បាន បញ្ជា ឲ្យ មន្ត្រី នាំយក គ្រឿងចក្រ ភ្លាម ៗ ទៅស្ដារ កាយ ប្រឡាយ មួយ កន្លែង ដើម្បី រំដោះ ជំនន់ ទឹកភ្លៀង ធ្លាក់ ជោគជាំ ប៉ុន្មាន ថ្ងៃ ជាប់ ៗ គ្នា នេះ បណ្ដាល លិច លង់ នៅក្នុង សាលា វិទ្យាល័យ ជា ស៊ីម ចំរើន រដ្ឋ ស្ថិត ក្នុង ភូមិ ស្វាយប៉ាក សង្កាត់ ស្វាយប៉ាក ខណ្ឌ ឬស្សីកែវ ដោយសារតែ សិស្សានុសិស្ស ពិបាក ទៅ សិក្សា និង សម្រាក រយៈពេល ២ ថ្ងៃ ។
( កំពង់ធំ )៖ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ អំពាវនាវ ប្រជាពលរដ្ឋ ក៏ ដូចជា ក្រុម អាជីវករ លក់ដូរ ក្នុង ក្រុង ស្ទឹង សែន រួមគ្នា ជួយ ថែរក្សា នូវ ប្រព័ន្ធ លូរំដោះ ទឹក ជំនន់ ទឹកភ្លៀង នៅ តាម ដងផ្លូវ មួយចំនួន ដែល អាជ្ញាធរ ក្រុង បាន និង កំពុង សាងសង់ នៅ ពេល នេះ ដើម្បី បាន ជួយ រំដោះ ទឹក ពេល មាន ភ្លៀង ធ្លាក់ ម្តង ៗ និង ធ្វើឲ្យ មាន ជះ ក្លិន ស្អុយ ។
លោក សុខ លូ បាន អំពាវនាវ យ៉ាង ដូច្នេះ នៅក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ ២សង្កាត់ គឺ ពេលព្រឹក សង្កាត់ ដំរី ជាន់ ខ្លា និង ពេល រសៀល សង្កាត់ កំពង់ រទេះ នៅ ក្រុង ស្ទឹង សែន ដែល មាន ប្រជាពលរដ្ឋ ចូលរួម ប្រមាណ ជាង ២ពាន់ នាក់ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ។
លោក សុខ លូ បាន បញ្ជាក់ ថា អាជ្ញាធរ ខេត្ត ខិតខំ អភិវឌ្ឍន៍ នៅ ទូទាំង កំពង់ធំ ទាំងមូល ដោយឡែក នៅក្នុង ក្រុង ស្ទឹង សែន ក៏ មាន ការអភិវឌ្ឍ រីកចម្រើន គួរឲ្យ កត់សម្គាល់ ផងដែរ ហើយ ការអភិវឌ្ឍ តែងតែ មាន ការប៉ះពាល់ ខ្លះ ៗ មិន ខាន ទេ ដូច្នេះ សូមឲ្យ ប្រជាពលរដ្ឋ មាន ការយោគយល់ និង ធ្យាស្រ័យ ។
ជាមួយគ្នា នោះ លោក អភិបាល ខេត្ត ក៏ បាន នាំ នូវ ការផ្តាំផ្ញើ ក្តី នឹករលឹក របស់ សម្តេច តេជោ ហ៊ុន សែន ចំពោះ ប្រជាពលរដ្ឋ ទាំងអស់ និង ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បាន ខិតខំ អស់ កម្លាំង កាយ ចិត្ត និង ពេលវេលា មក បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កន្លងមក គឺ មាន ន័យ ថា ប្រជាពលរដ្ឋ ទាំងអស់ បាន ធ្វើ ការជ្រើសរើស ថ្នាក់ដឹកនាំ ដែល ខ្លួន ពេញចិត្ត ព្រមទាំង រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការកសាង ប្រទេសជាតិ ឲ្យ កាន់តែ រីកចម្រើន ប្រកបដោយ សុខ សន្តិភាព ៕
កាកបាទ ក្រហម កម្ពុជា នាំយក អំណោយ ជូន គ្រួសារ សព ឳពុក កូន និង ក្មួយ សរុប ៣នាក់ ដែល ស្លាប់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ រថយន្ដ បុក ម៉ូតូ នៅ ខណ្ឌ ឫស្សីកែវ
សូម បញ្ជាក់ ថា ពិតជា គួរឲ្យ រន្ធត់ និង អាណោច អាធម៌ ជា ទីបំផុត ក្នុង គ្រួសារ ខ្មែរ ឥស្លាម មួយ ដែល បាន បាត់បង់ សមាជិក របស់ ខ្លួន ក្នុង មួយ ប៉ព្រិច ភ្នែក សោះ រហូតដល់ទៅ ៣នាក់ ក្នុង នោះ មាន ម្នាក់ ជិត ដល់ ថ្ងៃ ភ្ជាប់ពាក្យ ទៅ ហើយ និង បុរស ម្នាក់ ផ្សេង ទៀត ត្រូវ នគរបាល ចាប់ វាយ ខ្នោះ ដោយសារ ជួប ឧបត្ថវ ហេតុ គ្រោះថ្នាក់ ចរាចរណ៍ រវាង រថយន្ដ ធុន ធំ បើក ទៅ បុក ម៉ូតូ ពីក្រោយ ក្នុង ទិសដៅ ស្រប គ្នា ។
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន១០ គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ ចំនួន ១០គ្រឿង ។
បច្ចុប្បន្ន យានយន្ត ទាំងនោះ បាន ញ្ជូន ទៅ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បី ធ្វើ កា អប់រំ ណែនាំ បន្ត តាម នីតិវិធី ។ សល់ ត្រឹមតែ ២៩ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ នឹង ចូល មកដល់ . សូម បងប្អូន ត្រៀម ខ្លួន អញ្ជើញ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា !
( ភ្នំពេញ ) ៖ គិត មកដល់ ត្រឹម ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ គឺ សល់ តែ រយៈពេល ២៩ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ នឹង ចូល មកដល់ ។ ដូច្នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ដែល គ្រប់ អាយុ បោះឆ្នោត និង មាន ឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត សូម ត្រៀម ឯកសារ សម្រាប់ បម្រើ ដល់ ការបោះឆ្នោត ឲ្យ រួចរាល់ ដើម្បី អញ្ជើញ ទៅ ចូលរួម បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ។
ឧត្តមសេនីយ៍ ឯក រុន រ័ត្ន វាសនា អញ្ជើញ បិទ វគ្គ ផ្សព្វផ្សាយ ស្តីពី ការត្រួតពិនិត្យ លើ បណ្ណ បើកបរ អន្តរជាតិ
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក រុន រ័ត្ន វាសនា ប្រធាន នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៅ រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ បិទ វគ្គ ផ្សព្វផ្សាយ ស្តីពី ការត្រួតពិនិត្យ លើ បណ្ណ បើកបរ អន្តរជាតិ ។
ក្នុង ឱកាស នោះ ដែរ លោក ឧត្តមសេនីយ៍ ឯក បាន ផ្តាំផ្ញើ ដល់ សិក្ខាកាម ទាំងអស់ ប្រឹងប្រែង យក ចំណេះ វិជ្ជា ដែល បាន សិក្សា រៀនសូត្រ នៅ ថ្ងៃ នេះ ទៅ អនុវត្តន៍ ឲ្យបាន ខ្ជាប់ខ្ជួន និង ម៉ឹង ម៉ាត់ បំផុត ។ លោក ក៏ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ អគ្គ នាយកដ្ឋាន ដឹកជញ្ជូន ផ្លូវគោក ដែល បាន ចូលរួម ក្នុង វគ្គ បណ្តុះបណ្តាល នេះ ។
សូម ជម្រាប ថា នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្តាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ក្រសួង មហាផ្ទៃ នៅ ព្រឹក ថ្ងៃទី ២៩ ខែមិថុនា នេះ បាន រៀបចំ វគ្គ ផ្សព្វផ្សាយ ស្តីពី ការត្រួតពិនិត្យ លើ បណ្ណ បើកបរ អន្តរជាតិ ដោយ មាន ការចូលរួម ពី មន្ត្រី នគរបាល នាយកដ្ឋាន នគរបាល ចរាចរណ៍ ស្នងការរង ប្រធាន ការិយាល័យ នគរបាល ចរាចរណ៍ នៃ ស្នងការដ្ឋាន រាជធានី ខេត្ត ទាំង ២៥ ។
គោលបំណង នៃ ការរៀបចំ កិច្ចប្រជុំ នេះ ដើម្បី លើកកម្ពស់ សមត្ថភាព និង ជំនាញ ដល់ មន្ត្រី នគរបាល ចរាចរណ៍ ផ្លូវគោក ក្នុង ការពិនិត្យ ឲ្យបាន ត្រឹមត្រូវ លើ បណ្ណ បើកបរ អន្តរជាតិ ព្រមទាំង ស្វែងយល់ បន្ថែម ពី លិខិត បទដ្ឋាន ពាក់ព័ន្ធ ដូចជា អនុសញ្ញា អន្តរជាតិ ស្តីពី បណ្ណ បើកបរ អន្តរជាតិ និង កិច្ចព្រមព្រៀង ទទួលស្គាល់ បណ្ណ បើកបរ ទៅ វិញ ទៅ មក ទ្វេ ភាគី ឬ ពហុ ភាគី ជាមួយ កម្ពុជា ៕
រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ! កម្លាំង នគរបាល ខេត្ត ព្រះសីហនុ ចាប់ បាន យានយន្ដ ល្មើស ច្បាប់ ១០៥ ដែល ល្មើស ច្បាប់
( ព្រះសីហនុ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ ស្នងការ នគរបាល ខេត្ត ព្រះសីហនុ បាន ដាក់បញ្ជា ឲ្យ កម្លាំង ជំនាញ ផែន សណ្ដាប់ធ្នាប់ ចុះ ត្រួតពិនិត្យ និង រឹតបណ្ដឹង អនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ពិសេស អ្នកបើកបរ គ្មាន ប័ណ្ណ បើកបរ ឬ មាន ប័ណ្ណ បើកបរ អន្តរជាតិ មិន ត្រូវ ព្រមទាំង រថយន្ត គ្មាន ផ្លាកលេខ ។
ជាក់ស្ដែង នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ ផ្លូវគោក បាន ចុះ ត្រួតពិនិត្យ និង រឹតបណ្ដឹង អនុវត្ត ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ពិសេស អ្នកបើកបរ គ្មាន ប័ណ្ណ បើកបរ ឬ មាន ប័ណ្ណ បើកបរ អន្តរជាតិ មិន ត្រឹមត្រូវ និង រថយន្ត គ្មាន ស្លាកលេខ លើ៤ គោលដៅ ( ក្រុង ព្រះសីហនុ ៣ គោលដៅ និង ស្រុក ស្ទឹង ហាវ មួយ គោលដៅ ) ។
លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន បញ្ជាក់ ថា ជា លទ្ធផល ពិនិត្យ ឃើញ មធ្យោបាយ ល្មើស ចំនួន ១០៥ គ្រឿង ក្នុង នោះ រថយន្ត ០៥ គ្រឿ ង៖
ក្រសួង ធម្មការ និង សាសន ផ្សព្វផ្សាយ និង ប្រកាស ជា ផ្លូវការ គោល នយោបាយ វត្ត សង្គហ កុមារ និង កម្មវិធី កិច្ចការពារ កុមារ តាម វត្ត អារាម
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ក្រសួង ធម្មការ និង សាសនា និង គណៈ សង្ឃ នាយក ទាំង ពីរ គណៈ បាន ប្រារព្ធ ពិធី ផ្សព្វផ្សាយ និង ប្រកាស ជា ផ្លូវការ គោល នយោបាយ វត្ត សង្គហ កុមារ និង កម្មវិធី កិច្ចការពារ កុមារ តាម វត្ត អារាម ក្រោម ព្រះរាជា ធិបតីភាព សម្តេច ព្រះអភិសិរី សុគន្ធា មហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត បួរ គ្រី សម្តេច ព្រះមហាសង្ឃរាជ នៃ គណៈធម្មយុត្តិក និកាយ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក សេង សុមុនី អ្នកនាំពាក្យ ក្រសួង ធម្មការ និង សាសនា បាន ថ្លែង ថា ក្នុង ពិធី នេះ ថ្នាក់ដឹកនាំ បាន ពិភាក្សា ផ្តោត ទៅ លើ ការលុបបំបាត់ អំពើហិង្សា គ្រប់ រូបភាព ពិសេស លើ ស្រី្ត និង កុមារ រួមទាំង ផ្សព្វផ្សាយ យុទ្ធនាការ ប្រយុទ្ធ គ្រឿងញៀន ប្រគេន ដល់ មន្ត្រី សង្ឃ ព្រះសង្ឃ ទាំង ពីរ គណៈ ព្រះមេ គណគ្រប់ រាជធានី - ខេត្ត និង ប្រធាន មន្ទីរ ធម្មការ និង សាសនា ផងដែរ ។
១៖ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា នឹង មាន ការចុះហត្ថលេខា ជាមួយ ចិន ដើម្បី សាងសង់ ផ្លូវ ក្រវាត់ រាជធានី ភ្នំពេញ ទី៣ ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ ( ចុច អាន )
៣៖ ថ្ងៃ បើក យុទ្ធនាការ ឃោសនា បោះឆ្នោត ខាងមុខ សម្តេច តេជោ ហ៊ុន សែន នឹង ប្រកាស ដាក់ ចេញ គោល នយោបាយ មួយចំនួន សម្រាប់ ការកសាង អភិវឌ្ឍន៍ ជាតិ បន្ត ទៀត ( ចុច អាន )
៤៖ សម្តេច តេជោ ហ៊ុន សែន៖ រាជធានី ភ្នំពេញ នា ពេល បច្ចុប្បន្ន ប្រឈម ការកកស្ទះ ៣យ៉ាង គឺ កកស្ទះ ចរាចរ កកស្ទះ លូ និង កកស្ទះ សំរាម ( ចុច អាន )
៧៖ កងយោធពល ខេរម ភូមិន្ទ ថ្កោល ទោស ចំពោះ របាយការណ៍ HRW ដែល វាយប្រហារ មក លើ ថ្នាក់ដឹកនាំ កងកម្លាំងប្រដាប់អាវុធ កម្ពុជា ១២រូប ( ចុច អាន )
៨៖ ក្រុមការងារ ថ្នាក់ ក្រសួង និង រដ្ឋបាល ខេត្ត កោះកុង រៀបចំ ពិធី ចាប់ ឆ្នោត យក ដី ឡូតិ៍ និង ប្រគល់ ថវិកា ជូន ប្រជាពលរដ្ឋ មាន ទំនាស់ ជាមួយ ក្រុមហ៊ុន ស្ករ អំពៅ ក្នុង ខេត្ត កោះកុង នៅ ព្រឹក ស្អែក ( ចុច អាន )
១០៖ ពលរដ្ឋ ខ្មែរ រស់ នៅ ប្រទេស អូស្ត្រាលី អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ប្រើ សិទ្ធិ របស់ ខ្លួន ទៅ បោះឆ្នោត នា ថ្ងៃទី ២៩ ខែកក្កដា ! ( ចុច អាន )
ទស្សនមិត្ត អ្នកអាន៖ លទ្ធិ ប្រជាធិបតេយ្យ និង សិទ្ធិ មនុស្ស នៅ កម្ពុជា មិន ស្ថិត នៅលើ បបូរមាត់ របស់ ជន បរទេស ឡើយ ! ( ចុច អាន )
៧៖ រដ្ឋមន្ត្រី ការពារ ជា តិ៖ អំពើ ភេរវកម្ម ជា ការគម្រាមកំហែង ធំ បំផុត ចំពោះ ម៉ាឡេស៊ី ( ចុច អាន )
( ភ្នុំ ពេញ ) ៖ ថ្លែង នៅក្នុង វគ្គ ផ្សព្វផ្សាយ នា ព្រឹក ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ ឪពុក កូន ពីរ នាក់ បាន គេច ផុត ពី ឃាតក លាក់ មុខ ទាំង តក់ស្លុត នៅ ចំណុច ផ្លូវ ផ្លូវ ៦០ម៉ែត្រ ព្រំប្រទល់ ភ្នំពេញ និង ក្រុង តាខ្មៅ ក្រោម គ្រោះថ្នាក់ ចរាចរណ៍ រមួយ រវាង រថយន្ត កាម៉ារី បាឡែន ( ម្ចាស់ រត់ បាត់ ) ជាមួយ រថយន្ត តា កូម៉ា ( ជិះ គ្នា ពីរ នាក់ ឪពុក កូន ) បណ្តាលឲ្យ មាន ការភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ដែល ក្នុង នោះ ក្មេងប្រុស តូច ម្នាក់ បាន ប៉ះទង្គិច ធ្ងន់ធ្ងរ បណ្តាលឲ្យ សន្លប់ ស្តូកស្តឹង ។
គ្រោះថ្នាក់ ចរាចរណ៍ ត្រូវបាន គេ ចាត់ទុក ថា ជា ឃាតក លាក់ មុខ ដ៏ សាហាវ បំផុត គួរឲ្យ ភ័យខ្លាច ដោយ បាន ធ្វើឲ្យ មនុស្ស ជាច្រើន នាក់ ត្រូវ ស្លាប់ បាត់បង់ជីវិត ក៏ ដូចជា រងរបួស ធ្ងន់ និង រងរបួស ស្រាល ហើយ រថយន្ត និង ម៉ូតូ រាប់ រយ ពាន់ គ្រឿង ក៏ រង ការខូចខាត ផងដែរ ។ មាន មូលហេតុ ជាច្រើន ដែល នៅតែ ធ្វើឲ្យ គ្រោះថ្នាក់ ចរាចរណ៍ ពុំ មាន ការថយចុះ ជាពិសេស គឺ ការបំពាន ច្បាប់ ចរាចរណ៍ មិន គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ពេល ស្រវឹង បើកបរ បញ្ច្រាស ទិស បើក ជែង លើ ផ្លូវ តូច ចង្អៀត ហើយក៏ មាន បញ្ហា បច្ចេកទេស យានយន្ត ផងដែរ ។
( ភ្នំពេញ ) ៖ តាម បញ្ជាក់ របស់ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ បាន ឱ្យដឹង ថា សាកលវិទ្យាល័យ ពហុ បច្ចេកទេស Ningbo នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន នឹង ផ្ដល់ អាហារូបករណ៍ ដល់ និសិ្សត កម្ពុជា លើ ជំនាញ បច្ចេកទេស សំណង់ អគ្គិសនី និង អេឡិចត្រូនិច ខណៈ កម្ពុជា ក៏ កំពុង ត្រូវការលើ ជំនាញ ទាំង នេះ ជា ចាំបាច់ សម្រាប់ អភិវឌ្ឍន៍ ធនធាន មនុស្ស ។
លោក ឡៅ ហ៊ីម បញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នីតិកាល ទី៥នេះ បាន ចាត់ទុក ការអភិវឌ្ឍ ធនធាន មនុស្ស ជា វិស័យ អាទិភាព ក្នុង ចំណោម វិស័យ អាទិភាព ទាំង បួន នៃ យុទ្ធសាស្រ្ត ចតុកោណ ដំណាក់កាល ទី៣ ដើម្បី លើកកម្ពស់ ជំនាញ ដែល ត្រូវការ ជា ចាំបាច់ ក្នុង ការធានា បាន នូវ ការប្រកួតប្រជែង ក្នុង ទីផ្សារ ពលកម្ម ក្នុង តំបន់ ដែល កាន់តែ បើក ចំហ និង ជំរុញ សេដ្ឋកិច្ច ឱ្យ ឈានឡើង កម្រិត ខ្ពស់ មួយ ទៀត ហើយ ជាពិសេស ផ្តល់ ជូន ប្រជាពលរដ្ឋ នូវ អំណាច ក្នុង ការកំណត់ វាសនា ជីវិត របស់ ខ្លួន និង សម្រេច ក្តីប្រាថ្នា នៅ កន្លែង ការងារ ។
បច្ចុប្បន្ន ក្រសួង ការងារ មាន គ្រឹះស្ថាន ក្រោម ឱវាទ ចំនួន ១០២ ក្នុង នោះ មាន គ្រឹះស្ថាន សាធារណៈ ក្រោម ឱវាទ ចំនួន ៣៩ ទូទាំង រាជធានី - ខេត្ត ។ ក្រសួង បាន នឹង កំពុង កែទម្រង់ ស៊ីជម្រៅ លើ ផ្នែក អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ៖ ១. ពង្រឹង គុណភាព ការអប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ . ២. បង្កើន លទ្ធភាព ទទួលបាន ការបណ្តុះបណ្តាល ប្រកបដោយ សមធម៌ . ៣. លើកទឹកចិត្ត ភាព ជាដៃគូរ វាង រដ្ឋ និង ឯកជន និង ៤. លើកកម្ពស់ អភិបាលកិច្ច ក្នុង ប្រព័ន្ធ អប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ ៕
មន្ត្រី កាំ កុងត្រូល ខេត្ត បន្ទាយមានជ័យ រកឃើញ ទំនិញ ខូច គុណភាព ចម្រុះ ជាង ៨៩ គីឡូក្រាម នៅ ផ្សារ សិរី សោភ័ណ
លោក សាន វិជ្ជា សារ៉ា វុធ បាន ថ្លែង ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត បន្ទាយមានជ័យ ឱ្យដឹង ថា ការទប់ស្កាត់ និង ត្រួតពិនិត្យ រក ទំនិញ គ្មាន គុណភាព ហួស កាលបរិច្ឆេទ កំណត់ និង ប្រើប្រាស់ ជាតិ គីមី ព្រមទាំង ធ្វើ ការធ្វើតេស្ត បឋម (Test Kit) ធ្វើឡើង ដោយ គ្មាន កាល កំណត់ នោះ ឡើយ ដើម្បី ទប់ស្កាត់ ឱ្យ បាន កាន់តែ ខ្ពស់ ចំពោះ ការចរាចរណ៍ ទំនិញ ខូច គុណភាព និង គ្មាន ច្បាប់ អនុញ្ញាត នៅលើ ទីផ្សារ ដែល នាំឱ្យ ប៉ះពាល់ ដល់ សុខភាព របស់ ប្រជាពលរដ្ឋ ។
លោក បាន បន្ត ថា ទំនិញ ដែល មន្រ្តី របស់ លោក តែង ធ្វើ សកម្មភាព ពិនិត្យ ជាប្រចាំ គឺ ពិនិត្យ ទៅកាលបរិច្ឆេទ លើ សំបក វិចខ្ចប់ រួមទាំង ពិនិត្យ រក សារជាតិ គីមី នៅលើ បន្លែ ត្រី សាច់ ជាដើម ហើយ ប្រតិបត្តិការ ធ្វើតេស្ត បឋម រក សារធាតុ គីមី លើ ចំនី អាហារ គឺ ដើម្បី ចូលរួមចំណែក ទប់ស្កាត់ ចរាចរណ៍ ទំនិញ ដែល ខូច គុណភាព និង មាន សារធាតុ គីមី ជាពិសេស បាន ធ្វើ ការពន្យល់ ណែនាំ ដល់ ពលរដ្ឋ និង អាជីវករ ទាំងអស់ ឱ្យ បាន យល់ដឹង ពី ប្រភេទ ទំនិញ ដែល គ្មាន គុណភាព ផងដែរ ។
លោក ប្រធាន ក៏ បាន សំនូមពរ ដល់ អាជីវករ ទាំងអស់ និង អ្នកប្រើប្រាស់ ត្រូវ រួមគ្នា លុបបំបាត់ ការដាក់ តាំង លក់ និង ប្រើប្រាស់ ទំនិញ ខូច គុណភាព ឬ ទំនិញ ប្រើប្រាស់ សារធាតុ គីមី ព្រោះ វា បាន បង្ករ ផល ប៉ះពាល់ ខ្លាំង សម្រាប់ សុខភាព និង រស់ នៅ ជីវភាព ប្រចាំ ថ្ងៃ ។
នា ពេល នោះ ដែរ មន្ត្រី ជំនាញ កាំ កុងត្រូល ខេត្ត បាន ប្រទះឃើញ នំប៉័ង ខ្ចប់ គ្មាន ស្លាកសញ្ញា និង អានាម័យ ភ្លាម នោះ មន្ត្រី ជំនាញ បាន អប់រំ ដល់ អាជីវក និង មិន អនុញ្ញាត និង បាន រៀបចំ ពាក់ព័ន្ធ នំប៉័ង ខាងលើ នេះ ទៅកាន់ រដ្ឋបាល ខេត្ត ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ ប្រសិនជា នៅតែ បន្ត សកម្មភាព ទៀត រៀបចំ ផាក ពិន័យ ១០លាន រៀល ។
សូម បញ្ជាក់ ថា ក្នុង ការចុះ ត្រួតពិនិត្យ ទំនិញ នា ឱកាស នោះ មន្ត្រី សាខា កាំ កុងត្រូល ខេត្ត បាន ដកហូត ទំនិញ ហួស សុពលភាព និង ខូច គុណភាព ប្រមាណ ៨៩. ០៤ គីឡូក្រាម រួម មាន៖ កម្ទេច មី កញ្ចប់ ៥៧២ កញ្ចប់ គោ ខាប់ ចំនួន ៣កំប៉ុង ខ្ទឹម ជ្រក់៦កែវ ប័រ ២០ កំប៉ុង ដើម្បី យក ទៅ កម្ទេចចោល ៕
សមាជិក ព្រឹទ្ធសភា អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត គ្រប់ គ្នា ដើម្បី ជ្រើសរើស ថ្នាក់ដឹកនាំ ប្រទេស ឆ្ពោះ ទៅរក សន្តិភាព និង ស្ថិរភាព
( ត្បូងឃ្មុំ ) ៖ លោក ឆាយ វណ្ណា សមាជិក ព្រឹទ្ធសភា កម្ពុជា បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទាំងអស់ ប្រើប្រាស់ សិទ្ធ របស់ ខ្លួន ទៅ បោះឆ្នោត ជ្រើសរើស តំណាងរាស្រ្ត អាណត្តិ ទី៦ នៅ ថ្ងៃអាទិត្យ ទី ២៩ ខែកក្កដ ឆ្នាំ ២០១៨ ខាងមុខ នេះ ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បី គាំទ្រ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បន្ត ដឹកនា ប្រទេស ជាតិ រក្សា ការពារ សមិទ្ធផល និង សន្តិភាព ដែល កំពុង មាន បច្ចុប្បន្ន ជាពិសេស ធានា បាន ការអភិវឌ្ឍ ប្រទេសជាតិ រីកចម្រើន ថែម ទៀត និង ពង្រឹង លទ្ធិ ប្រជាធិបតេយ្យ ប្រកបដោយ និរន្តរភាព ។
លោក ក៏ បាន លើកឡើង ផងដែរ ថា អ្វី ៗ ដែល យើង ទាំងអស់ គ្នា ទទួលបាន នៅ ពេល នេះ គឺ ផ្តើម ចេញ ពី ការរំដោះ ប្រទេសជាតិ ឲ្យ រួចផុត ពី របប ប្រល័យ ពូជសាសន៍ នៅ ថ្ងៃ៧ ខែមករា ឆ្នាំ ១៩៧៩ និង នយោបាយ ឈ្នះ ៗ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល ធ្វើឲ្យ កម្ពុជា យើង ទទួលបាន នូវ សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ ពេលនេះ យោធា រុស្ស៊ី ធ្វើ ទំនើបកម្ម សព្វាវុធ បាន ៦០ ភាគរយ ហើយ និង ព្យាយាម សម្រេច តាម គោលដៅ ឲ្យបាន នៅ ឆ្នាំ ២០២១ ។
៤៖ ប៉ូលិស អាមេរិក ចាត់ វិធានការក្តៅ ចាប់ ក្រុម ប្រឆាំង ដូណាល់ ត្រាំ ជិត ៦០០ នាក់ ឃុំ ខ្លួន ដោយ ភាគ ច្រើន ជា ស្ត្រី ភេទ ពាក់ព័ន្ធ នយោបាយ អន្តោប្រវេសន៍ ដ៏ គ្មាន មនុស្សធម៌ ។
៥៖ ព្រលានយន្តហោះ កោះ ទេសចរណ៍ បាលី នៃ ប្រទេស ឥណ្ឌូណេស៊ី បើក ទ្វារ ដំណើរការ ឡើងវិញ ក្រោយពី បំផ្ទុះ ភ្នំ ភ្លើង នៅ ទីនោះ បាន បង្កឲ្យ ភ្ញៀវ ទេសចរ រាប់ ពាន់ នាក់ ជាប់គាំង ចេញ ទៅ ណា ពុំ កើត ។
៦៖ ទីបំផុត ទីស្នាក់ការ កងទ័ព អាមេរិក ប្រចាំ កូរ៉េ ខាងត្បូង ផ្លាស់ប្តូរ ទីតាំង ទៅ កន្លែង ថ្មី ។
៧៖ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក ថ្លែង ថា « អត់ ទាន់ បាន ទទួល អដ្ឋិធាតុ ទាហាន ពី កូរ៉េ ខាងជើង នោះ ទេ » ដែល វា រឿង ផ្ទុយ ពី លោក ត្រាំ ធ្លាប់ លើកឡើង ។ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៩ ខែមិថុនា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ៣០៧ គ្រឿង និង ផាក ពិន័យ ១០៦ គ្រឿង . រាជធានី ភ្នំពេញ ឃាត់ យានយន្ដ បាន ២៤២ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ១.៩៦៩ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ៣០៧ គ្រឿង ( ម៉ូតូ ៧៥ ភាគរយ ) អប់រំ២០១ គ្រឿង និង ផាក ពិន័យ ១០៦ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ២៩ ខែមិថុនា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ៧២១ គ្រឿង . អប់រំ ៣៣ គ្រឿង និង ផាក ពិន័យ ចំនួន ៥៧ គ្រឿង ។ ដោយឡែក រាជធានី ភ្នំពេញ ឃាត់ យាន យ្ដ បាន ២៤៧ គ្រឿង ។
ក្រសួង ប្រៃសណីយ៍ ស្នើ ដល់ ក្រុមហ៊ុន ផ្ដល់ សេវា ទូរស័ព្ទ ចល័ត ទាំងអស់ ពង្រឹង គុណភាព សេវា ក្នុង ចន្លោះ ពេល យុទ្ធនាការ ឃោសនា បោះឆ្នោត និង ការបោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ខាងមុខ
( ភ្នំពេញ ) ៖ លោក ត្រាំ អ៊ីវតឹក រដ្ឋមន្ដ្រី ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ចេញ លិខិត ផ្លូវការ មួយ ច្បាប់ ស្នើ ទៅដល់ អគ្គ នាយក និង ប្រធាន ក្រុមហ៊ុន ផ្ដល់ សេវា ទូរស័ព្ទ ចល័ត ទាំងអស់ ពង្រឹង គុណភាព សេវា ទូរស័ព្ទ ចល័ត ក្នុង ចន្លោះ ពេល យុទ្ធនាការ បោះឆ្នោត និង ការបោះឆ្នោត ជ្រើសរើស តំណាងរាស្ដ្រ នីតិកាល ទី៦ នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ នា ពេល ខាងមុខ នេះ ។
ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន បញ្ជាក់ ថា ក្នុង ពេល ខាងលើ ប្រជាពលរដ្ឋ ចាំបាច់ ក្នុង ការទាក់ទង និង ទទួលបាន ព័ត៌មាន ថ្មី ៗ អំពី គោល នយោបាយ អភិវឌ្ឍន៍ នានា របស់ រាជ រដ្ឋាភិបាល ពិសេស ព័ត៌មាន ចាំបាច់ សម្រាប់ ការបោះឆ្នោត ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន នៅក្នុង លិខិត របស់ លោក ត្រាំ អ៊ីវតឹក ដែល មាន ខ្លឹមសារ ទាំងស្រុង ៖
មេក្លោង ជួញដូរ គ្រឿងញៀន ជនជាតិ ឡាវ ម្នាក់ រួម ជាមួយ ថ្នាំ ញៀន ជាង ៣គីឡូក្រាម ត្រូវបាន កម្លាំង នគរបាល ចុះបង្ក្រាប
( ស្ទឹងត្រែង ) ៖ មេក្លោង ជួញដូរ គ្រឿងញៀន ជនជាតិ ឡាវ ដ៏ សកម្ម ម្នាក់ រួម ជាមួយ ថ្នាំញៀន ជាង ៣គីឡូក្រាម ត្រូវបាន កម្លាំង ជំនាញ « ក៩ » របស់ មន្ទីរ ប្រឆាំង គ្រឿងញៀន ខេត្ត ស្ទឹងត្រែង បើក ប្រតិបត្តិការ ចុះបង្ក្រាប បាន ។
ប្រតិបត្តិការ ចុះបង្ក្រាប មេក្លោង ជួញដូរ គ្រឿងញៀន ខាងលើ នេះ បាន ធ្វើឡើង នៅ ចំណុច ផ្លូវ លំ ភូមិ ខាំ ផាន់ សង្កាត់ សាមគ្គី ក្រុង ស្ទឹងត្រែង ខេត្ត ស្ទឹងត្រែង នៅ វេលា ម៉ោង ១៣៖ ៣០នាទី នា ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ក្រោម ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ . នាយ ឧត្តមសេនីយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង នគរបាល ជាតិ ទទួល ផែន គ្រឿងញៀន និង ប្រធាន មន្ទីរ ប្រឆាំង គ្រឿង លោក ឡឹក វណ្ណៈ ក្រោម ការសម្របសម្រួល ពី តំណាង អយ្យការ ។
លោក បាន បន្ថែម ទៀត ថា ក្នុង នោះ ចាប់ យក វត្ថុតាង បាន រួម មាន៖ សារធាតុ ញៀន ប្រភេទ ម៉េតំហ្វេតាមីន ៣កញ្ចប់ ធំ ប្រមាណ ៣គីឡូ និង ទូរស័ព្ធ១ គ្រឿង ប្រើប្រាស់ លេខ ០២០២៨៣៣៣៣៨៦ ។
ក្រោយ បង្ក្រាប បាន កម្លាំង នគរបាល ខេត្ត និង កម្លាំង BLO ដោយ សហការ ជាមួយ កម្លាំង នគរបាល ឡាវ ក៏ បាន បន្ត ឃាត់ខ្លួន មេក្លោង ឈ្មោះ ចាវ ពែន ភេទ ប្រុស អាយុ ៣១ ឆ្នាំ ជនជាតិ ឡាវ មាន ទីលំនៅ ភូមិ ចាប់ សាន់ ខា ខន ស្រុក ប៉ាក់ សេ ខេត្ត ចំប៉ា សាក់ និង ដកហូត បាន រថយន្ត ២គ្រឿង ប៉ុន្ដែ សមត្ថកិច្ច ឡាវ មិន ប្រគល់ឲ្យ ទេ ៕ ធនាគារ ជាតិ នៃ កម្ពុជា បង្ហាញ ឈ្មោះ ក្រុមហ៊ុន ចំនួន ៥ ដែល កំពុង ប្រតិបត្តិការផ្ដល់ កម្ចី ដោយ មិន មាន ច្បាប់ អនុញ្ញាត ត្រឹមត្រូវ និង ស្នើឲ្យ ប្រជាពលរដ្ឋ ប្រុងប្រយ័ត្ន
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា នា រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្ដីប្រកាស ព័ត៌មាន ឲ្យ សាធារណៈ ជន ប្រយ័ត្ន ចំពោះ ក្រុមហ៊ុន ចំនួន ៥ ដែល កំពុង ប្រតិបត្តិការផ្ដល់ កម្ចី ក្នុង ប្រទេស កម្ពុជា ដោយ មិន មាន ច្បាប់ អនុញ្ញាត ពី ធនាគារ ជាតិ នៃ កម្ពុជា ។
ការចេញ សេចក្ដីប្រកាស ព័ត៌មាន នេះ ធ្វើឡើង បន្ទាប់ពី ធនាគារ ជាតិ នៃ កម្ពុជា បាន សង្កេតឃើញ ថា ថ្មី ៗ នេះ មាន ក្រុមហ៊ុន ឯកជន មួយចំនួន បាន ផ្សព្វផ្សាយ ពី ការផ្តល់ កម្ចី យ៉ាង សកម្ម តាមរយៈ បណ្ដាញ សង្គម ការចែក នាមប័ណ្ណ និង ផ្ញើ សារ តាម ទូរស័ព្ទ ជាដើម ។ ក្រុមហ៊ុន ទាំងនោះ រួម មាន៖ ក្រុមហ៊ុន ឥណទាន សុចរិត ភ្នំពេញ . ក្រុមហ៊ុន ឥណទាន អន្ដរជាតិ . ក្រុមហ៊ុន ឥណទាន កម្ពុជា និង ក្រុមហ៊ុន ឥណទាន ភ្នំពេញ ជាដើម ។
ដើម្បី បញ្ជា្រស នូវ រាល់ បញ្ហា នានា ដែល កើតឡើង បណ្ដាល មកពី ការប្រើប្រាស់ កម្ចី មិន ត្រឹមត្រូវ ពី ក្រុមហ៊ុន នានា នេះ ធនាគារ ជាតិ បាន បង្ហាញ ពី ផលវិបាក ធំ ៗ ដែល កើតមាន មកពី ការប្រើប្រាស់ កម្ចី ខុស ច្បាប់ ដូច ជា៖
១៖ អតិថិជន អាច ប្រឈម នឹង បំណុល វ័ណ្ឌ ក ដោយសារ អត្រា ការប្រាក់ និង កម្រៃ សេវា ផ្សេង ៗ ខ្ពស់ ខ្លាំង ជាង គ្រឹះស្ថាន ស្រប ច្បាប់ និង ការគណនាការ ប្រាក់ មិន ត្រឹមត្រូវ តាម ច្បាប់ និង បទប្បញ្ញត្តិ ។
២៖ អតិថិជន អាច ប្រឈមមុខ នឹង ការគំរាមកំហែង គៀប សង្កត់ គ្រោះថ្នាក់ ឬ រូបភាព ផ្សេង ៗ ដើម្បី បង្ខំ ឲ្យ សង ប្រាក ដើម ការប្រាក់ និង ប្រាក់ ពិន័យ ដែល មិន សម ហេតុផល ទៅ ក្រុមហ៊ុន វិញ ។
៣៖ ទ្រព្យ ធានា របស់ អតិថិជន អាច ត្រូវបាន ក្រុមហ៊ុន ឬ អ្នកផ្ដល់ កម្ចី ខុស ច្បាប់ រឹបអូស ដោយ ពុំ ឆ្លងការត់ ការសម្រេច ពី តុលាការ ជាដើម ។
ធនាគារ ជាតិ នៃ កម្ពុជា បញ្ជាក់ ទៀត ថា « សូម សាធារណជន ជ្រាប់ ជា ព័ត៌មាន និង បង្កើន ការប្រុងប្រយ័ត្ន ពី ការប្រើប្រាស់ សេវាកម្ម កម្ចី ខុស ច្បាប់ ពី ក្រុមហ៊ុន ឬ អ្នកផ្ដល់ កម្ចី ដែល គ្មាន ច្បាប់ អនុញ្ញាត ទាំងនោះ » ។
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ ធនាគារ ជាតិ បាន នឹង កំពុង សហការ ជាមួយ អាជ្ញាធរ ពាក់ព័ន្ធ ដើម្បី ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ទៅ លើ ក្រុមហ៊ុន ឬ អ្នកផ្ដល់ កម្ចី ខុស ច្បាប គ្រប់ រូបភាព ទាំងអស់ ៕
ក្រុម អ្នក ជួយ សង្រ្គោះ បាន ចូល ទៅក្នុង ច្រក រូង ផ្លូវ ខាងលើ ក្នុង ជម្រៅ ១១ម៉ែត្រ មុននឹង គេ ជឿជាក់ ថា ពួកគេ នឹង ត្រូវ មុជទឹក បន្ត នៅ ជម្រៅ ១១ម៉ែត្រ បន្ថែម ទៀត ។ ប៉ុន្តែ អ្វី ដែល គួរឱ្យ កត់សម្គាល់ នោះ គឺ ការរកឃើញ ប្រហោង ផ្លូវ នេះ កំពុង ផ្ដល់ ក្ដីសង្ឃឹម ថា ក្រុម អ្នក ជួយ សង្រ្គោះ អាចនឹង រកឃើញ ផ្លូវ ចូល ទៅដល់ ទីតាំង ដែល អ្នក ទាំង ១៣នាក់ កំពុង ជាប់គាំង ខណៈ ក្រុម អ្នកជំនាញ មក ពី សហរដ្ឋ អាមេរិក អង់គ្លេស និង ចិន កំពុង ជួយ ដល់ ប្រតិបត្តិការ ជួយ សង្រ្គោះ ។
លើស ពី នេះ ទៅ ទៀត បើ តាម ប្រវត្តិ នៃ រូបភាព របស់ ក្រុម ក្មេង ៗ កីឡាករ ទាំងនោះ គឺ ពួកគេ ធ្លាប់ ទៅកាន់ ទីនោះ កាលពី ចុង ឆ្នាំ ២០១៦ ផងដែរ ។ បើ តាម សារព័ត៌មាន ថៃ រហូតមក ទល់ នឹង យប់ ថ្ងៃព្រហស្បតិ៍ នេះ ប្រតិបត្តិការ ជួយសង្គ្រោះ នៅតែ បន្ត ដដែល ហើយ មិន ទាន់ មាន តម្រុយ អ្វី គួរឲ្យ កត់សម្គាល់ នោះ ឡើយ ដោយ គ្រាន់តែ ក្រុម សង្គ្រោះ បាន ឃើញ ដាន ជើង មនុស្ស មួយ ដែល គេ ជឿជាក់ ថា ជា សមាជិក មួយ ក្នុង ចំណោម ១៣នាក់ ៕
សម្រាប់ ថ្ងៃសៅរ៍ នេះ ក្រុម ជំនាញ - សង្គ្រោះ នឹង ព្យាយាម ទម្លាក់ ខ្លួន ចូល ទៅកាន់ ប្រហោង ភ្នំ នានា ផ្សេង ទៀត ដើម្បី រក ផ្លូវ ចូល ទៅក្នុង រូង ភ្នំ ខណៈ ភ្លៀង ធ្លាក់ នៅតែ អាច គំរាមកំហែង ប្រតិបត្តិការ នេះ បាន គ្រប់ ពេលវេលា ។ ប្រតិបត្តិការ នៅ ថ្ងៃសៅរ៍ នេះ គឺ ត្រូវ ប្រើ រយៈពេល យូរ និង ផ្លូវ វែងឆ្ងាយ ដូច្នេះ សមាជិក នៃ ក្រុម សង្គ្រោះ បាន រៀបចំ ចំណីអាហារ និង ទឹក សុទ្ធ ទៅ តាម ខ្លួន ពួកគេ រួច ជាស្រេច ផងដែរ ។
លើស ពី នេះ ទៅ ទៀត បើ តាម ប្រវត្តិ នៃ រូបភាព របស់ ក្រុម ក្មេង ៗ កីឡាករ ទាំងនោះ គឺ ពួកគេ ធ្លាប់ ទៅកាន់ ទីនោះ កាលពី ចុង ឆ្នាំ ២០១៦ ផងដែរ ៕
គួរ បញ្ជាក់ ផងដែរ ថា បារាំង ឡើង មក វគ្គ ១៦ ក្រុម ដោយ ស្រួល ជាមួយនឹង ការបញ្ចប់ ទៅ ដោយ ចំណាត់ថ្នាក់ លេខ ១ នៃ ពូល C លេង ៣ប្រកួត សន្សំ ពិន្ទុ ក្នុង ពូល ឈ្នះ ២ដង និង ស្មើ១ ដង មិន ដែល ស្រប ពេល អាហ្សង់ទីន បាន ឡើង មក ទាំង ត្រដាបត្រដួស បំផុត ជាពិសេស ១ប្រកួត កាត់សេចក្តី ពេល បាន យកឈ្នះ នីហ្សេរីយ៉ា ២- ១ ចុង ម៉ោង បញ្ចប់ ទៅ ដោយ ចំណាត់ថ្នាក់ លេខ ២ នៃ ពូល D ។
នៅក្នុង កិច្ចពិភាក្សា រវាង ប្រមុខ ការទូត នៃ ប្រទេស សម្ព័ន្ធមិត្ត ទាំង ពីរ ជា ចុងក្រោយ ក៏ បាន សម្រេច បន្ត ការដាក់ សម្ពាធ ទៅ លើ កូរ៉េ ខាងជើង ដដែល ដើម្បីឲ្យ រដ្ឋ កុម្មុយនិស្ត មួយ នេះ ធ្វើ អ្វី ៗ ទៅ តាម ការព្រមព្រៀង របស់ ខ្លួន ជាមួយ មេដឹកនាំ កំពូល អាមេរិក និង កូរ៉េ ខាងត្បូង នោះ គឺ ការរំសាយ អាវុធ នុយក្លេអ៊ែរ ទាំងស្រុង ជា ថ្នូរ នឹង ការដក ទណ្ឌកម្ម សេដ្ឋកិច្ច ។
( កំពង់ធំ )៖ លោក ឧត្តមសេនីយ៍ ទោ សោម ស៊ុន មេបញ្ជាការ រង យោធភូមិភាគ ទី៤ និង មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង កំពង់ធំ នៅ រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ បាន ទទួល បដិសណ្ឋារកិច្ច ប្រតិភូ អគ្គ រដ្ឋទូត ឥណ្ឌូនេស៊ី ប្រចាំ កម្ពុជា ដែល អញ្ជើញ មក ជួប ធ្វើ ការពិភាក្សា ការងារ មួយចំនួន និង ពិនិត្យ ទីតាំង អនុស្សាវរីយ៍ កាល ដែល កងទ័ព ឥណ្ឌូនេស៊ី មក ឈរ ជើង ក្នុង សម័យ សង្គ្រាម ក្នុង នាម ជា អ្នកសម្របសម្រួល គ្រប់ ភាគី ជម្លោះ នៅ ប្រទេស កម្ពុជា ។
