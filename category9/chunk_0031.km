( ព្រៃវែង ) ៖ នៅ ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០១៨ ស្នាក់ការបក្ស ឃុំ ថ្ម ពូន បាន រៀបចំ កម្មវិធី ជួប សំណេះសំណាល ជាមួយ មេ គ្រសារបក្ស ប្រជាជន ចំនួន ៥៥៤ នាក់ មកពី ៥ភូមិ ក្នុង ចំណោម ១១ភូមិ ក្នុង ឃុំ ថ្ម ពូន ស្រុក កញ្ចៀច ខេត្ត ព្រៃវែង ។
ពិធី នេះ បាន ធ្វើឡើង ក្រោម វត្តមាន លោក ដាំ វុទ្ធី អនុប្រធាន ក្រុមការងារ ទី១ ស្រុក កញ្ចៀច និង លោក ស៊ូ សាវុធ អនុប្រធាន ក្រុមការងារ ស្រុក ជា តំណាង នាយ ឧត្ត សេនីយ៍ នេត សាវឿន នេត សាវឿន ប្រធាន ក្រុម ទី១ ស្រុក ស្វាយអន្ទរ និង ស្រុក កញ្ចៀច និង អម ជាមួយ ប្រធាន ក្រុមការងារ ទទួល ឃុំ មេបក្ស ឃុំ មេសាខា អនុសាខា បក្ស គ្រប់ ភូមិ ទាំង ១១ក្នុង ឃុំ ។
ក្នុង ឱកាស នោះ លោក ដាំ វុទ្ធី បាន ផ្តាំផ្ញើ និង ការនឹករលឹក របស់ សម្តេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា . សម្តេស ក្រឡាហោម ស ខេង អនុប្រធាន គណបក្ស និង នាយ ឧត្តមសេនីយ៍ នេត សាវឿន ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ញ្ចៀច និង ស្រុក ស្វាយអន្ទរ ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ នៅក្នុង ឃុំ ក៏ ដូចជា ទូទាំង ខេត្ត ផងដែរ និង ថ្លែងអំណរគុណ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បន្ដ គាំទ្រ គណបក្ស ប្រជាជន ។
លោក បាន គូសបញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន មាន គោល នយោបាយ និង យុទ្ធសាស្រ្ត ច្បាស់លាស់ ជាច្រើន អាណត្តិ កន្លងមក បាន ដឹកនាំ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ ដោយ ចាប់ផ្តើម កសាង ពី បាត ដៃ ទរ ទេ គំនរ ផេះ ផង់ បន្សល់ ពីរបប ប៉ុល ពត មក រុងរឿង ដូច សព្វ ថ្ងៃ ពិសេស អាណត្តិ ទី ៥នេះ ហេដ្ឋារចនាសម្ព័ន្ធ មាន៖ ផ្លូវ ថ្នល់ ស្ពាន មន្ទីរពេទ្យ សាលារៀន សាលា សង្កាត់ មាន កាន់តែ ច្រើន កាន់តែ ទំនើប និង នៅជិត មូលដ្ឋាន របស់ បងប្អូន ទៀតផង ។
បន្ថែម ពី នេះ ទៀត លោក ក៏ បាន សូម ការអភ័យទោស ពី ការខ្វះខាត របស់ មន្ត្រីរាជការ នៅ មូលដ្ឋាន ដែល បម្រើ សេវា ជូន ប្រជាពលរដ្ឋ មិន បាន ល្អ និង រាល់ អំពើ ឆ្គាំឆ្គង ទាំងឡាយ ទាំង ចេតនា ក្តី អចេតនា ក្តី ព្រមទាំង បាន ណែនាំ មន្ត្រី ឲ្យ ចុះ ជាប់ ជាមួយ មូលដ្ឋាន ខិតខំ បម្រើ ប្រជាពលរដ្ឋ ឲ្យបាន ល្អ និង ទាន់ ពេល វេលា ។
បន្ទាប់ពី កម្មវិធី នេះ ក្រុមការងារ បន្ត យក បំពង់ ទឹក ក្តៅ ចុះ តាម ផ្ទះ មេ គ្រួសារ បក្ស នៅសល់ មិន បាន មក ចូលរួម ចំនួន ០៦ ភូមិ បន្ត ទៀត ដោយ បាន ប្រគល់ ដល់ មេ គ្រួសារ បក្ស សរុប ២៨៩៦ ក្នុង ឃុំ ថ្ម ពូន ៕
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ ជិត ៣ម៉ឺន នាក់ នៅ ខេត្ត កណ្តាល
( កណ្តាល ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ព្រឹក ថ្ងៃព្រសហស្បតិ៍ ៨រោច ខែ បឋ មាសាឍ ឆ្នាំ ច សំរឹទ្ធិ ស័ក ព .ស ២៥៦២ ត្រូវនឹង ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ កម្ម ការិនី សរុប ២៧. ៥២៩ នាក់ មកពី រោងចក្រ ចំនួន ២៥ នៅក្នុង ខេត្ត កណ្តាល ។
* សម្តេច តេជោ ហ៊ុន សែន ចាប់ផ្តើម ថ្លែង សំណេះសំណាល ជាមួយ កម្មករ ជិត ៣ម៉ឺន នាក់ មកពី រោងចក្រ ចំនួន ២៥ នៅ ខេត្ត កណ្តាល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ពេលនេះ ប្រទេស កម្ពុជា បាន ឆ្លង ផុត ពី ប្រទេស ក្រីក្រ តោកយ៉ាក ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប ហើយ ជីវភាព ប្រជាពលរដ្ឋ ក៏ បាន ប្រែប្រួល ខុសពី អតីតកាល ដែល រក តែ ស្បែកជើង ពាក់ មិន ចង់បាន ផង នោះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា បើ គ្មាន សង្គ្រាម ឆ្នាំ ១៩៧០ និង របប ប្រល័យ ពូជសាសន៍ ទេ កម្ពុជា នឹង មាន ការរីកចម្រើន ជាង នេះ ។ ប៉ុន្តែ ជា អកុសល សង្គ្រាម នេះ បាន បំផ្លេច បំផ្លាញ កម្ពុជា គ្មាន សល់ កម្ពុជា បាន ប្រឹងប្រែង ងើបឡើង ទាំង លំបាក ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ ដែល បាន ប្រឹងប្រែង រួមគ្នា ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី ស្តារ ប្រទេស ឡើងវិញ រួមគ្នា ទប់ស្កាត់ មិន ឲ្យ របប ប្រល័យ ពូជសាសន៍ វិល មក ជាថ្មី ។ សម្តេច តេជោ នេះ ជា មរតក និង សមិទ្ធផល ដ៏ ធំធេង សម្រាប់ ប្រជាពលរដ្ឋ ក្នុង សម័យ បច្ចុប្បន្ន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន អរគុណ ចំពោះ ការស្រឡាញ់ រាប់អាន និង ការសម្តែង នូវ ភាពរ៉ាក់ទាក់ របស់ កម្មករ កម្ម ការិនី ដែល នេះ ជា ថាមពល ដ៏ ខ្លាំងក្លា សម្រាប់ ការបន្ត ដឹកនាំ ប្រទេស និង យក ខ្លួន ពាំង ការពារ សុខ សន្តិភាព សម្រាប់ ជាតិ និង ប្រជាជន ។
* ពាក់ព័ន្ធ នឹង ហ្នឹង រឿង នេះ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង នូវ រឿង អប់រំ មួយ ថា សត្វ ឆ្កែ ដែល កំពុង ពាំ សាច់ មួយ ដុំ នៅក្នុង មាត់ ប៉ុន្តែ នៅ ពេល វា ពាំ សាច់ នោះ ទៅ ឆ្លុះ ក្នុង ទឹក ស្រាប់តែ ឃើញ ស្រមោល សាច់ ក្នុង ទឹក ធំ ជាង សាច់ នៅក្នុង មាត់ ក៏ ទម្លាក់ សាច់ ក្នុង មាត់ ចោល ចង់ ស្រវាយក សាច់ ស្រមោល ក្នុង ទឹក តែ ទីបំផុត បាត់បង់ សាច់ នៅក្នុង មាត់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប្រាក់ ឈ្នួល របស់ កម្មករ កម្ម ការិនី និង ប្រាក់ បៀវត្សរ៍ របស់ មន្រ្តី រាជការ មិន មែន ស្ថិត នៅ ត្រឹម ប៉ុណ្ណេះ ទេ ពោល នៅ ពេល ដែល កម្រិត សេដ្ឋកិច្ច ជាតិ ក្លាយទៅជា ប្រទេស ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ និង ជា ប្រទេស មាន ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០ នោះ ប្រាក់ ឈ្នួល និង ប្រាក់ បៀវត្សរ៍ កាន់តែ ឡើង ខ្ពស់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការបង្កើត កំពង់ផែ បង្កើត ផ្លូវ បង្កើត ថាមពល អគ្គិសនី ដើម្បី តម្លៃ អគ្គិសនី ចុះ ទាប គឺ ដើម្បី ទាក់ទាញ អ្នក វិនិយោគ ដើម្បីឲ្យ អ្នក វិនិយោគ មាន ផលចំណេញ ហើយ ផល ចំណេញ ពី ការរកស៊ី នោះ នឹង ជួយ ប្រាក់ ឈ្នួល របស់ កម្មករ កម្ម ការិនី បាន កាន់តែ ខ្ពស់ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច ជា ប្រមុខ បាន យក ជីវិត ធ្វើជា ដើមទុន ដឹកនាំ ចលនា រំដោះ ជីវិត ប្រជាពលរដ្ឋ ចេញ ពី របប ប្រល័យ ពូជសាសន៍ បន្ទាប់មក ត្រូវ ប្រឹងប្រែង ទប់ស្កាត់ ការពារ មិន ឲ្យ របប ប្រល័យ ពូជសាសន៍ វិល មក វិញ ហើយ ម្ខាង ទៀត ត្រូវ ប្រឹងប្រែង ស្តារ ប្រទេស ឡើងវិញ ។
* សម្តេច ប្រមុខ គណបក្ស ប្រជាជន កម្ពុជា បាន ថ្លែង ថា សុខ សន្តិភាព និង ការអភិវឌ្ឍ នៅ កម្ពុជា មាន តែ បាត ដៃ របស់ គណបក្ស ប្រជាជន កម្ពុជា គ្មាន បាត ដៃ របស់ បក្ស ប្រឆាំង នោះ ឡើយ ។ បក្ស ប្រឆាំង បាន ត្រឹមតែ រារាំង មិន ឲ្យ មាន ការទិញ ផលិតផល របស់ កម្ពុជា និង មិន ឲ្យ បរទេស ផ្តល់ ជំនួយ មក ឲ្យ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា យើង ត្រូវ មាន មោទនភាព ចំពោះ សម្លៀកបំពាក់ ដែល ផលិត នៅ កម្ពុជា ហើយ ត្រូវបាន លក់ នៅលើ ទីផ្សារ ពិភពលោក ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ចោទសួរ ថា ហេតុ អ្វី បានជា អ្នក វិនិយោគ បាន មក បណ្តាក់ទុន រកស៊ី នៅ កម្ពុជា គ្រា ដែល មាន តម្លៃ ប្រាក់ ឈ្នួល ខ្ពស់ ជាង បណ្តា ប្រទេស មួយចំនួន មាន តម្លៃ ដឹកជញ្ជូន និង តម្លៃ អគ្គិសនី ថ្លៃ ជាង បណ្តា ប្រទេស មួយចំនួន ? សម្តេច បាន បញ្ជាក់ ថា កត្តា ទាក់ទាញ ទី១ គឺ កម្ពុជា មាន សុខ សន្តិភាព និង ស្ថេរភាព និង កត្តា មួយ ទៀត គឺ កម្ពុជា មាន កម្លាំង ពលកម្ម ជំនាញ អាច បំពេញ នូវ ស្តង់ដារ គុណភាព ផលិតផល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន បន្ត ថា ព្រោះតែ កត្តា នេះ ហើយ ទើប សម្តេច តែង អំពាវនាវ ដល់ កម្មករ កម្ម ការិនី ឲ្យ ប្រឹងប្រែង លើកកម្ពស់ គុណភាព ផលិតផល ដែល ផលិត នៅ កម្ពុជា ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ចោទសួរ ថា តើ ត្រូវ រក្សាទុក នូវ អ្វី ដែល មាន នៅក្នុង ដៃ រួចទៅហើយ ឬ ត្រូវ ធ្វើ ការផ្លាស់ប្តូរ ?
* សម្តេច តេជោ ហ៊ុន សែន បាន រំលឹក ថា ព្រោះតែ ការ « ដូរ ៗ » ដោយ មិន បាន ពិចារណា ទសវត្សរ៍ ឆ្នាំ ៧០ បាន ធ្វើឲ្យ កម្ពុជា រលំ រលាយ ។ សម្តេច លើកឡើង ថា មួយ ថ្ងៃ ជយោសម្តេច នរោត្តម សីហនុ ហើយ មួយ ថ្ងៃ ទៀត ដូរ សម្តេច នរោត្តម សីហនុ ទីបំផុត កម្ពុជា ធ្លាក់ ក្នុង ភ្លើង សង្គ្រាម ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នៅ ថ្ងៃទី ០៧ ខែកក្កដា ឆ្នាំ ២០១៨ ដែល ជា ថ្ងៃ បើក យុទ្ធនាការ ឃោសនា បោះឆ្នោត សម្តេច នឹង ប្រកាស បង្ហាញ នូវ គោល នយោបាយ មួយចំនួន សម្រាប់ ជា ប្រយោជន៍ ដល់ ប្រជាពលរដ្ឋ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គណបក្ស ប្រជាជន កម្ពុជា បាន ធ្វើ តាំងពី ប្រជាពលរដ្ឋ ពី ត្រឹមតែ ៥លាន នាក់ រហូតដល់ ប្រមាណ ១៦លាន នាក់ ទៅ ហើយ ។ គណបក្ស ប្រជាជន ធ្វើ តាំងពី ពលរដ្ឋ ពី ៥លាន នាក់ ខ្វះ អង្ករ បរិភោគ មកដល់ ពលរដ្ឋ ប្រមាណ ១៦លាន នាក់ មាន អង្ករ ហូប គ្រប់គ្រាន់ ហើយ សល់ អង្ករ សម្រាប់ នាំចេញ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ប្រសិនបើ គណបក្ស សង្គ្រោះ ជាតិ មិន ត្រូវបាន រំលាយ ចោល ទេ សង្គ្រាម នៅ កម្ពុជា មិន អាច គេចផុត នោះ ឡើយ ។ សម្តេច តេជោ ថា គេ ធ្វើ នយោបាយ ដើម្បី បង្រួបបង្រួម ជាតិ តែ បក្ស សង្គ្រោះ ជាតិ ធ្វើ នយោបាយ បំបែកបំបាក់ ជាតិ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង បន្ត ថា ពេល គេ ដើរ តាម ខ្លួន ជា អ្នកស្នេហាជាតិ ពេល គេ មិន គាំទ្រ ជា អាយ៉ង បរទេស ដូច្នេះ តើ ការបង្រួបបង្រួម ជាតិ កើតឡើង បាន យ៉ាងណា ?
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ថា សម្តេច បន្ត ដឹកនាំ ប្រទេស យ៉ាងតិច១០ ឆ្នាំ ដើម្បី ចាំ ការពារ ប្រទេស ពី ការប៉ុនប៉ង បំបែកបំបាក់ របស់ ក្រុម បក្ស ប្រឆាំង ដែល ត្រូវបាន រំលាយ ។ សម្តេច បន្ត ថា ដរាបណា អតីត មេ បក្ស ប្រឆាំង មួយ នេះ នៅតែ មាន វត្តមាន សម្តេច នៅតែ បន្ត ដឹកនាំ ការពារ ប្រទេស មួយ នេះ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ភាព សុខសាន្ត នៅ តាម រោងចក្រ គឺជា បំណងប្រាថ្នា របស់ សម្តេច ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រាប់ ថៅកែ រោងចក្រ ថា ប្រសិនបើ ថៅកែង រោងចក្រ គ្មាន កម្មករ មិន មែន មាន ឈ្មោះ ជា ថៅកែ រោងចក្រ នោះ ទេ គឺ មាន ឈ្មោះ ត្រឹមតែ ថៅកែ ឃ្លាំង ប៉ុណ្ណោះ ដោយឡែក កម្មករ បើ គ្មាន រោងចក្រ ក៏ គ្មាន ការងារ ធ្វើ និង មិន មាន ប្រាក់ ឈ្នួល ដូចគ្នា ។ ក្នុង ន័យ នេះ សម្តេច អំពាវនាវ ឲ្យ ថៅ កែ និង កម្មករ ត្រូវ រួមគ្នា បង្កើ សហគមន៍ សុខសាន្ត នៅ តាម រោងចក្រ ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ ប្រជាកសិករ ថា បើ ទោះបី មាន គោយន្ត ប៉ុន្តែ កុំ បោះបង់ ចោល ការចិញ្ចឹម សត្វ គោ បើ មិន ចិញ្ចឹម គោ សម្រាប់ ភ្ជួរ រាស់ ក៏ ចិញ្ចឹម មេ គោ ដែរ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា រហូតមកដល់ ពេលនេះ សម្តេច បាន បញ្ចេញ ថវិកា រហូតដល់ទៅ ជាង ២០លាន ដុល្លារ ដើម្បី ដោះស្រាយ បញ្ហា របស់ កម្មករ ដែល ថៅកែ រត់ ចោល ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ទទួលស្គាល់ ថា ការដឹកនាំ របស់ សម្តេច នៅ មាន ចំណុច ខ្វះខាត ប៉ុន្តែ អា ចំណុច ល្អ ប្រសើរ នោះ ច្រើន ជាង ព្រោះតែ ចំណុច ល្អ ប្រសើរ ច្រើន ជាង នោះ ហើយ ទើប នាំឲ្យ កម្ពុជា មាន ការរីកចម្រើន ដូច ពេល បច្ចុប្បន្ន ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ផ្តាំ ទៅ ប្រេដ អាដាម ថា កម្ពុជា មិន ស្ថិត នៅក្រោម ច្បាប់ របស់ បរទេស ណាមួយ នោះ ឡើយ
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ថា ព្រោះតែ បរទេស តាំង ខ្លួន ជា ម្ចាស់ របស់ ខ្មែរ នោះ ហើយ ទើប ធ្វើឲ្យ ខ្មែរ ស្លាប់ អស់ រាប់ លាន នាក់ ពី អតីតកាល ខ្មែរ បច្ចុប្បន្ន មិន អនុញ្ញាតឲ្យ បរទេស ធ្វើជា ម្ចាស់ ហើយ ខ្មែរ បច្ចុប្បន្ន ក៏ មិន មាន ពូជ ក្បត់ ជាតិ ពី ឪដល់ កូន នោះ ដែរ ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បន្ត អំពាវនាវ ដល់ កម្មករ កម្ម ការិនី បន្ត រួមគ្នា ទប់ស្កាត់ កុំ ឲ្យ មាន ការរីករាលដាល នៃ ជំងឺ អេដស៍ ។
* សម្តេច តេជោ បន្ត អំពាវនាវ ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ត្រូវ ខិតខំ បរិយាកាស អព្យាក្រឹត ដើម្បី ធានា ដល់ ការដំណើរការបោះឆ្នោត ប្រកបដោយ យុត្តិធម៌ និង តម្លាភាព ។
* សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ដល់ មន្រ្តី រាជការ ទាំងអស់ មិន ត្រូវ ប្រើ ទ្រព្យសម្បត្តិ របស់ រដ្ឋ ទៅ ធ្វើ យុទ្ធនាការ ឃោសនា បោះឆ្នោត នោះ ឡើយ ដើម្បី ធានា ថា ទ្រព្យសម្បត្តិ របស់ រដ្ឋ មិន ត្រូវ យក ទៅ បម្រើ ដល់ ការបោះឆ្នោត ដោយ គណបក្ស នយោបាយ ណាមួយ នោះ ឡើយ ជាពិសេស បក្ស កាន់អំណាច ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន អំពាវនាវ ដល់ ប្រព័ន្ធ ផ្សព្វផ្សាយ ទាំងអស់ ត្រូវ ជួល ម៉ោង ផ្សព្វផ្សាយ ទៅដល់ គណបក្ស នយោបាយ ទាំងអស់ ខណៈ ដែល គណបក្ស ប្រជាជន កម្ពុជា បាន ជួល គ្រប់ ទូរទស្សន៍ អស់ ហើយ ដើម្បី ផ្សព្វផ្សាយ ក្នុង ពេល យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត ។
* សម្តេច តេជោ បន្ថែម ថា សម្រាប់ ទូរទស្សន៍ ជាតិ គឹត្រូវ ផ្តល់ ម៉ោង ស្មើ ៗ គ្នា ដល់ គ្រប់ គណបក្ស នយោបាយ ទាំងអស់ ក្នុង អំឡុង ពេល យុទ្ធនាការ ឃោសនា រក សំឡេង ឆ្នោត ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តាំ ទៅ ប្រជាពលរដ្ឋ ថា ប័ណ្ណ ព័ត៌មាន ស្តីពី ការបោះឆ្នោត មិន អាច យក ទៅ បោះឆ្នោត បាន នោះ ឡើយ ពោល មាន តែ អត្តសញ្ញាណប័ណ្ណ ទើប អាច បម្រើ ដល់ ការបោះឆ្នោត បាន ។
* សម្តេច នាយក រដ្ឋមន្ត្រី បាន ថ្លែង ថា សម្តេច នឹង ចេញ សារាចរណ៍ ណែនាំ មួយ ជូន ដល់ ប្រជាពលរដ្ឋ សម្រាប់ ថ្ងៃ បោះឆ្នោត ដែល ធ្វើ តាម សំណើ របស់ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ។
* សម្តេច តេជោ ហ៊ុន សែន បន្ត អំពាវនាវ ឲ្យ រួបរួម គ្នា ធ្វើ យ៉ាងណា ឲ្យ ការបោះឆ្នោត ប្រព្រឹត្តទៅ ដោយ ជោគជ័យ ដោយ មិន ត្រូវ ឲ្យ មាន ការ ផិត ភ័យ ណាមួយ ដល់ ប្រជាពលរដ្ឋ នោះ ឡើយ ។
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា ការបោះឆ្នោត បក្ស ណា ឈ្នះ ឆ្នោត ជា រឿង មួយ ប៉ុន្តែ អ្វី ដែល សំខាន់ គឺជាតិ ទាំងមូល បាន ឈ្នះ តាមរយៈ នៃ ការរៀបចំ ការបោះឆ្នោត មួយ ប្រកបដោយ ជោគជ័យ ។
* សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន រំលឹក ដល់ កម្មករ កម្ម ការិនី ថា ពួកគេ អាច ឈប់ សម្រាក បាន ៣ ថ្ងៃ សម្រាប់ ការបោះឆ្នោត ខាងមុខ ដោយ មាន ប្រាក់ ឈ្នួល ដដែល ។
គណៈប្រតិភូ គ.ជ. ប កម្ពុជា នឹង ត្រឡប់ មកដល់ កម្ពុជា នៅ យប់ នេះ ក្រោយ បំពេញ ទស្សនកិច្ច តាម ការអញ្ជើញ របស់ គ.ជ. ប អង់គ្លេស
លោក ឌឹម សុវណ្ណា រុំ បាន បញ្ជាក់ ថា ការអញ្ជើញ របស់ គ.ជ. ប អង់គ្លេស សបញ្ជាក់ ឱ្យ ឃើញ ថា ជា ការបើក ទំព័រ ថ្មី មួយ ទៀត សម្រាប់ កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស មួយ នៅ អឺរ៉ុប ដែល មាន បទពិសោធន៍ តាំងពី បុរាណកាល ក្នុង ការរៀបចំ ការបោះឆ្នោត ហើយ ជា ប្រទេស សមាជិក អចិន្ត្រៃយ៍ នៅក្នុង អង្គការ សហ ប្រជាជាតិ ទៀតផង ។ ដំណើរទស្សនកិច្ច នេះ មាន គោលបំណង ដើម្បី ស្វែងយល់ និង ដកស្រង់ បទពិសោធន៍ ល្អ ៗ អំពី ការបោះឆ្នោត នៅ ចក្រភព អង់គ្លេស ៕
ប៉ុន្តែ យ៉ាងណា ទោះជា កំពុង មាន អំណាច ពេញ នៅក្នុង ដៃ ក៏ដោយ ក៏ ប្រធានាធិបតី ចិន រូប នេះ នៅតែ បញ្ជាក់ ថា យុទ្ធនាការ ប្រឆាំង អំពុករលួយ នេះ មិន ទាន់ បញ្ចប់ នោះ ទេ ។ លោក ស៊ី បាន លើកឡើង តាមរយៈ ការស្រង់ សម្ដី ដោយ ស៊ីន ហួរ ដូច្នេះ ថា « ការប្រយុទ្ធ ប្រឆាំង នឹង អំពើពុករលួយ នឹង នៅតែ ត្រូវ ធ្វើឡើង ជានិច្ច ... ដូច្នេះ យើង ត្រូវតែ ពង្រឹង ស្មារតី រៀបចំ ត្រៀមខ្លួន ឱ្យ ហើយ ប្រឈមមុខ នឹង បញ្ហា នៅពេល អនាគត ប្រកបដោយ ការទទួលខុសត្រូវ » ។
គួរ រំលឹក ថា កាលពី ខែមីនា កន្លាង ទៅ សភា ប្រជាជន ចិន បាន អនុម័ត លុបចោល អាណត្តិ ប្រធានាធិបតី ចិន ដែល នេះ គឺជា ការបើក ដៃ ឱ្យ លោក ស៊ី ជិន ពីង អាច កាន់អំណាច មិន មាន ពេល កំណត់ និង ក្លាយជា មេដឹកនាំ ដ៏ មាន ឥទ្ធិពល បំផុត បន្ទាប់ពី អតីត ប្រធានាធិបតី ចិន លោក ម៉ៅ សេទុង ៕ បើកបរ សូម ប្រុងប្រយ័ត្ន ! រថយន្ត ដឹក កម្មករ រោងចក្រ បើក លើស ល្បឿន កំណត់ ក្រឡាប់ បណ្តាលឱ្យ របួស ធ្ងន់ ស្រាល ជាង ១០នាក់ នៅ ស្រុក កណ្តាល ស្ទឹង
( កណ្តាល ) ៖ នៅ ព្រឹក ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ រថយន្ត កូរ៉េ ដឹកម្មករ - កម្ម ការិនី បើកបរ លើស ល្បឿន កំណត់ បណ្តាល ឱ្យ ក្រឡាប់ ធ្វើឱ្យ កម្មករ កម្ម ការិនី រងរបួស ធ្ងន់ ស្រាល ជាង ១០ ស្ថិត នៅ បណ្តោយ ផ្លូវ ជាតិ លេខ ៣ នៅ ស្រុក កណ្តាល ស្ទឹង ខេ ត្កណ្តាល ។
( ភ្នំពេញ ) ៖ លោក ប៉ា សុជាតិ វង្ស ប្រធាន គណបក្ស ប្រជាជន រាជធានី ភ្នំពេញ និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន ខណ្ឌ មានជ័យ នៅ ថ្ងៃទី ៥ ខែ កក្កដា ឆ្នាំ ២០១៨ នៅ ទីស្នាក់ការ គណបក្ស សង្កាត់ ស្ទឹងមានជ័យ២ បាន ធ្វើ ពិធី សំណេះសំណាល ជាមួយ សមាជិក របស់ គណបក្ស សង្គ្រោះ ជាតិ ដែល សុំ រួមរស់ ជីវភាព នយោបាយ ជា មួយ សមាជិក គណបក្ស កម្ពុជា ចំនួន ៣៧៥ នាក់ ។
ក្នុង នោះ ក៏ មាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ ក្រុមការងារ គណះ បក្ស រាជធានី ចុះ ជួយ តាម មូលដ្ឋាន សង្កាត់ ក្នុង ខណ្ឌ មានជ័យ រួមទាំង លោក ប្រធាន អនុប្រធាន គណះ បក្ស ខណ្ឌ និង លោក ប្រធាន គណះ បក្ស សង្កាត់ ទាំង ៧ចូលរួម ក្នុង ពិធី បញ្ចូល សមាជិក បក្ស ថ្មី នា ឱកាស នេះ ដែរ ។
សមាជិក សមាជិកា ដែល បាន ផ្ទេរ ជីវភាព របស់ គណះ បក្ស សង្គ្រោះ ជាតិ មក រួម រស់ ជីវភាព នយោបាយ ជាមួយ គណះ បក្ស ប្រជាជន សរុប ចំនួន ៣៧៥ នាក់ រួម មាន សង្កាត់ ស្ទឹងមានជ័យ ទី៣ ចំនួន ៦៣ នាក់ . សង្កាត់ ស្ទឹងមានជ័យ ទី ២៨ នាក់ . សង្កាត់ បឹង ទំពន់ទី១ ១៥នាក់ . សង្កាត់ បឹង ទំពន់ ទី ២ ចំនួន ២២០ នាក់ . សង្កាត់ ចាក់អង្រែ ក្រោម ១៥នាក់ . សកម្មជន ផ្លក ច យ ៣៤នាក់ ។
លោក ប៉ា សុជាតិ វង្ស ប្រធាន គណបក្ស រាជធានី ភ្នំពេញ បាន បញ្ជាក់ បន្ថែម ថា ការចូល ជា សមាជិក ថ្មី របស់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ នេះ គឺជា សញ្ញា វិជ្ជមាន មួយ ដែល អាច ឈាន ទៅរក ភាពជោគជ័យ យ៉ាង លើសលប់ នៅ ថ្ងៃ បោះឆ្នោត ខាងមុខ ពីព្រោះថា សមាជិក សមាជិកា របស់ គណបក្ស ប្រជាជន កម្ពុជា ម្នាក់ ៗ គឺជា សម្លេង ឆ្នោត មួយ សម្លេង នៃ សន្លឹក ឆ្នោត ដើម្បី គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ។
បន្ថែម ពីលើ នោះ លោក ប៉ា សុជាតិ វង្ស ប្រធាន គណបក្ស រាជធានី ភ្នំពេញ ក៏ បាន ធ្វើ ការអំពាវនាវ អោយ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ អញ្ជើញ ទៅ បោះឆ្នោត នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ដើម្បី គាំទ្រ គណបក្ស ប្រជាជន ដឹកនាំ ប្រទេស រីកចំរើន បន្ថែម ទៀត ៕
ទស្សនៈ កូន ខ្មែរ៖ ឧបាយកល ដ៏ ពិស ពុល នៅ ពីក្រោយ ការពង្រាយ « អ្នកសង្កេតការណ៍ ស្ម័គ្រចិត្ត »!
នៅ ពីក្រោយ ការពង្រាយ « អ្នកសង្កេតការណ៍ ស័្ម គ្រចិត្ត » របស់ ក្រុម នេះ មាន បិទបាំង ដោយ ឧបាយក កល ទុច្ចរិត យ៉ាង ពិស ពុល បំផុត ពោលគឺ សកម្មភាព នេះ មាន គោលដៅ ដើម្បី៖
បន្ទាប់មក នៅ ក្រោយ បោះឆ្នោត ពួកគេ នឹង ចេញ របាយការណ៍ មួយ ទៀត ដោយ ប្រើប្រាស់ អ្នក សង្កេតការណ៍ ក្រៅ ច្បាប់ និង ការប្រឌិត ព័ត៌មាន ដើម្បី ធ្វើឲ្យ មាន សំឡេង បង្កាច់បង្ខូច លទ្ធផល នៃ ការបោះឆ្នោត ។ គោលដៅ របស់ ពួកគេ ស្ថិត ក្នុង សេណារី យោរួម មួយ ដោយ មាន ពួក បរទេស ស្បែក សរជា អ្នកផ្គត់ផ្គង់ លុយកាក់ និង បញ្ជា ពីក្រោយ ខ្នង នោះ គឺ ការបំផ្លាញ ការបោះឆ្នោត បំផ្លាញ ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស និង បំផ្លាញ របប រាជានិយម នៅ កម្ពុជា តែម្តង ដើម្បី ជួយ គណបក្ស មួយ ដែល ស្លាប់ បាត់ ទៅ ហើយ នោះ ឲ្យ រស់ ឡើងវិញ ។
ដោយ៖ សាស្ត្រាចារ្យ វិទ្យាសាស្ត្រ សង្គម នៃ សាកលវិទ្យាល័យ កំពង់ចាម សល់ ត្រឹមតែ ២៤ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ នឹង ចូល មកដល់ . សូម បងប្អូន ត្រៀម ខ្លួន អញ្ជើញ ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា !
( ភ្នំពេញ ) ៖ គិត មកដល់ ត្រឹម ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ គឺ សល់ តែ រយៈពេល ២៤ ថ្ងៃ ទៀត ប៉ុណ្ណោះ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ឆ្នាំ ២០១៨ នឹង ចូល មកដល់ ។ ដូច្នេះ សូម បងប្អូន ប្រជាពលរដ្ឋ ដែល គ្រប់ អាយុ បោះឆ្នោត និង មាន ឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត សូម ត្រៀម ឯកសារ សម្រាប់ បម្រើ ដល់ ការបោះឆ្នោត ឲ្យ រួចរាល់ ដើម្បី អញ្ជើញ ទៅ ចូលរួម បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ។ តើ ត្រូវ មាន ឯកសារ អ្វី ខ្លះ និង ត្រូវ ធ្វើ អ្វី ខ្លះ ដើម្បី បោះឆ្នោត បាន ?
នៅ ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ កម្មករ ជិត ៣ម៉ឺន នាក់ នៅ ខេត្ត កណ្តាល
លោក អ៉ិត សំហេង រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ឲ្យដឹង ថា រោងចក្រ សហគ្រាស ទាំង ១៨ ដែល អនុញ្ញាតឲ្យ កម្មករ កម្ម ការិនី អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នៅ ថ្ងៃ នេះ វិនិយោគ ដោយ ជនជាតិ ចិន ចំនួន ២១ រោងចក្រ . វិនិយោគ ដោយ ជនជាតិ កូរ៉េ ១រោងចក្រ . ជប៉ុន ចំនួន ១រោងចក្រ និង ខ្មែរ ២ រោងចក្រ ។ រោងចក្រ ទាំង ២៥ នេះ មាន រោងចក្រ កាត់ សម្លៀកបំបាក់ ចំនួន ២១ ផលិត កាបូប ចំនួន ៣ និង ដេរ ប៉ាក់ ចំនួន ១ ។
បើ តាម លោក អ៉ិត សំហេង ផលិតផល ដែល ផលិត ដោយ រោងចក្រ ទាំងនេះ ត្រូវបាន នាំចេញ ទៅកាន់ ទីផ្សារ អន្តរជាតិ និង ផ្គត់ផ្គង់ ទីផ្សារ ក្នុង ប្រទេស ផងដែរ ។
លោក រដ្ឋមន្ត្រី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន បញ្ជាក់ ថា រោងចក្រ សហគ្រាស ដែល មាន មូលដ្ឋាន នៅក្នុង ស្រុក អង្គស្នួល និង មកពី បណ្តា ស្រុក នានា នៅក្បែរ នោះ បាន បង្កើត នូវ មុខរបរ និង ការងារ បន្ថែម ជាច្រើន ងាយស្រួល ដល់ យុវជន ក្នុង ការរក ការងារ ធ្វើ ក្នុង មូលដ្ឋាន របស់ ខ្លួន របរ ជួល ផ្ទះ លក់ ម្ហូប អាហារ ការដឹកជញ្ជូន និង សេវាកម្ម ផ្សេង ៗ ទៀត រួមចំណែក ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច និង ជីវភាព របស់ ប្រជាជន ក្នុង មូលដ្ឋាន ។
លោក រដ្ឋមន្ត្រី បាន ឲ្យដឹង ថា ក្នុង ខេត្ត កណ្តាល មកដល់ ពេល បច្ចុប្បន្ន នេះ មាន រោងចក្រ សហគ្រាស គ្រឹះស្ថាន ចំនួន ៤៦២ មាន កម្មករ និយោជិត ចំនួន ១៥០. ៥១៥ នាក់ ដែល មាន ប្រាក់ ឈ្នួល សរុប ៣៦៣ លាន ដុល្លារ ។ ក្នុង នោះ រោងចក្រ កាត់ដេរ សម្លៀកបំពាក់ និង ផលិត ស្បែកជើង មាន ចំនួន ១៦៨ មាន កម្មករ និយោជិត ចំនួន ១៣៤. ៣២៣ នាក់ ដែល មាន ប្រាក់ ឈ្នួល សរុប ជាង ៣២២ លាន ដុល្លារ អាមេរិក ។
សូម បញ្ជាក់ ថា ជំនួប សំណេះសំណេះសំណាល រវាង សម្តេច តេជោ ហ៊ុន សែន និង កម្មករ កម្ម ការិនី នៅក្នុង ខេត្ត កណ្តាល នា ថ្ងៃ នេះ គឺជា ការជួប សំណេះសំណាល លើក ទី ៤៩ ហើយ គិត ចាប់តាំងពី ថ្ងៃទី ២០ ខែសីហា ឆ្នាំ ២០១៧មក នោះ ។ ជំនួប ទាំង ៤៨ លើក នេះ មាន កម្មករ កម្ម ការិនី ចូលរួម សរុប ៦៨១. ៦៣៣ នាក់ ៕
គួរ បញ្ជាក់ ថា លោក ដូណាល់ ត្រាំ បាន ព្រមាន ថា ទីក្រុង វ៉ាស៊ីនតោន នឹង តម្លើង ពន្ធ ២០ ភាគរយ លើ ការនាំចូល រថយន្ដ អឺរ៉ុប មកកាន់ សហរដ្ឋ អាមេរិក បើសិនជា សហភាព អឺរ៉ុប មិន ព្រម ដក ចេញ របាំង ពាណិជ្ជកម្ម របស់ ខ្លួន ទេ នោះ ៕ លោក ឯ ម ច័ន្ទ មក រា៖ ថវិកា ៥០៦ លាន រៀល ឧបត្ថម្ភ ពី សម្តេច ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជួយ ដល់ កម្មវិធី ប្រឡង សំនៀង ជន ពិការ កម្ពុជា បង្ហាញ ពី ការយកចិត្តទុកដាក់ ខ្ពស់ លើ ជន មាន ពិការ ភាព
( ភ្នំពេញ ) ៖ លោក ឯ ម ច័ន្ទ មករា អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ បាន ថ្លែងអំណរគុណ ដល់ សម្តេច ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ជួយ ឧបត្ថម្ភ ថវិកា ៥០៦ លាន រៀល ជួយ ដល់ កម្មវិធី ប្រឡង សំនៀង ជន ពិការ កម្ពុជា ។
លោក ឯ ម ច័ន្ទ មករា បន្ថែម ឲ្យដឹង ថា ការជួយ ឧបត្ថម្ភ ថវិកា ពីសំណាក់ ថ្នាក់ដឹកនាំ ទាំង២ ក្នុង ការជួយ ដល់ ជន មាន ពិការភាព នា ពេលនេះ គឺ បាន បង្ហាញ ពី ការយកចិត្តទុកដាក់ ខ្ពស់ ដល់ ជន មាន ពិការភាព ដោយ មិន រើសអើង ឡើយ ។
អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ លោក ឯ ម ច័ន្ទ មករា បាន បន្ត ថា នេះ មិន មែន ជា លើក ទី១ ឡើយ ដែល សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន យកចិត្តទុកដាក់ លើ ជន មាន ពិការភាព កន្លងមក រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច បាន ជួយ ឧបត្ថម្ភ ឧបករណ៍ ភ្លេង និង ថវិកា ឧបត្ថម្ភ មួយចំនួន ទៀត ជួយ សម្រួល ដល់ ការរស់នៅ របស់ ជន មាន ពិការភាព ជា បន្តបន្ទាប់ ផងដែរ ។
គួរ បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ឧបត្ថម្ភ ទឹកប្រាក់ ចំនួន ៥០៦ លាន រៀល ដល់ កម្មវិធី ប្រឡង សំនៀង ជន ពិការ កម្ពុជា ពានរង្វាន់ សម្តេច តេជោ ហ៊ុន សែន ។
ការឧបត្ថម្ភ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ទាំង ទ្វេ នេះ បាន ធ្វើឡើង នៅក្នុង កម្មវិធី ប្រឡង សំនៀង ជន ពិការ កម្ពុជា នៅ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នា ពហុកីឡដ្ឋាន ជាតិ អូឡាំពិក ។
គួរឲ្យ កត់សម្គាល់ ផងដែរ ថា អនុបាត ចំណេញ សុទ្ធ ជា មធ្យម សម្រាប់ ផ្សារ ទាំងមូល បាន ឡើង ខ្ពស់ រហូតដល់ ជិត ២០% កាលពី ឆ្នាំ ២០១៥ មុននឹង ធ្លាក់ចុះ មក ត្រឹម ១៦. ៨៨% នៅ ឆ្នាំ បន្ទាប់ ។
បើ តាម សេចក្តីប្រកាស ព័ត៌មាន ដដែល ចំពោះ បរិមាណ ជួញដូរ នៃ ភាគហ៊ុន នីមួយ ៗ តួរ លេខ បាន បង្ហាញ ថា ការជួញដូរ ភាគហ៊ុន PWSA មាន បរិមាណ ល្អ បង្គួរ ប៉ុន្តែ ធ្លាក់ចុះបរិមាណ បន្តិចបន្តួច ក្នុង រយៈពេល ៣ឆ្នាំ ចុងក្រោយ នេះ ផ្ទុយ ស្រឡះ ពី ភាគហ៊ុន PPAP ដែល មាន ទំហំ ជួញដូរ កើនឡើង ជា បន្តបន្ទាប់ គួរឲ្យ កត់សម្គាល់ ។
សូម ជម្រាប ថា លោក អ្នក អាច អាច ស្វែងរក ព័ត៌មាន បន្ថែម នៃ ភាគហ៊ុន នីមួយ ៗ នៅក្នុង សៀវភៅ « ព័ត៌មាន អំពី ភាគហ៊ុន ឆ្នាំ ២០១៨ » ។ សៀវភៅ ព័ត៌មាន អំពី ភាគហ៊ុន ត្រូវបាន បោះផ្សាយ ជារៀងរាល់ ឆ្នាំ និង មាន រួមបញ្ចូល នូវ ព័ត៌មាន លម្អិត របស់ ក្រុមហ៊ុន ចុះបញ្ជី នៅ CSX សម្រាប់ ជា ជំនួយ ក្នុង ការសម្រេចចិត្ត វិនិយោគ ។
សៀវភៅ នេះ រួម មាន ព័ត៌មាន អាជីវកម្ម សំខាន់ ៗ របស់ ក្រុមហ៊ុន . របាយការណ៍ ហិរញ្ញវត្ថុ . សមាសភាព ថ្នាក់ដឹកនាំ ក្រុមហ៊ុន និង គោល នយោបាយ ភាគលាភ . ស្ថិតិ ជួញដូរ និង អនុបាត ហិរញ្ញវត្ថុ សំខាន់ ៗ មួយចំនួន ដែល ឆ្លុះបញ្ចាំង ពី ស្ថានភាព អាជីវកម្ម និង ការជួញដូរ របស់ ក្រុមហ៊ុន ចុះបញ្ជី ។ បន្ថែម ពីលើ នេះ ការបោះផ្សាយ សម្រាប់ ឆ្នាំ ២០១៨ នេះ បាន បញ្ចូល បន្ថែម នូវ ការប្រៀបធៀប អនុបាត . បម្រែបម្រួល ថ្លៃ ភាគហ៊ុន និង ទំហំ នៃ ការជួញដូរ របស់ ភាគហ៊ុន ទាំងអស់ សម្រាប់ រយៈពេល បី ឆ្នាំ ចុងក្រោយ ចាប់ពី ឆ្នាំ ២០១៥ ដល់ ២០១៧ ។
៣៖ សម្តេច តេជោ ហ៊ុន សែន៖ ដើម្បី នាំ ប្រទេស មកដល់ ដំណាក់កាល ដូច ពេល បច្ចុប្បន្ន ពឹងផ្អែក សំខាន់ លើ កត្តា សន្តិភាព ដែល ផ្តល់ ទំនុកចិត្ត ដល់ អ្នក វិនិយោគ និង អ្នកទេសចរ ( ចុច អាន )
៤៖ សម្តេច តេជោ ហ៊ុន សែន ប្រាប់ ឲ្យ អភិបាល រាជធានី ភ្នំពេញ ពិនិត្យ ស្ថានភាព ពង្រីក ការតភ្ជាប់ រថយន្តក្រុង សាធារណៈ ទៅ តាម តំបន់ ផ្សេង ៗ ទៀត ដែល មាន កម្មករ - កម្ម ការិនី ធ្វើ ការ ច្រើន ( ចុច អាន )
៦៖ ទំនាក់ទំនង មិត្តភាព និង កិច្ចសហប្រតិបត្តិការ ភាពជាដៃគូ យុទ្ធសាស្ត្រ គ្រប់ ជ្រុងជ្រោយ កម្ពុជា - ចិន មាន ការវិវឌ្ឍ យ៉ាង ល្អ ប្រសើរ ( ចុច អាន )
៧៖ អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល៖ រាល់ ការបោះឆ្នោត ម្ដង ៗ កម្ពុជា ជួប យុទ្ធនាការ ប្រឆាំង របស់ បរទេស ដើម្បី ការពារ បក្ស អាយ៉ង របស់ គេ ក្នុង រូបភាព ដាក់ សម្ពាធ ឬ ទណ្ឌកម្ម ( ចុច អាន )
៨៖ អ្នកសារព័ត៌មាន ជាតិ និង អន្តរជាតិ ជាង ៩០០ នាក់ ត្រូវបាន គ.ជ. ប ប្រកាស ទទួលស្គាល់ ដើម្បី ចូលរួម យក ព័ត៌មាន ដំណើរ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ( ចុច អាន )
១៖ តុលាការ ម៉ាឡេស៊ី ចោទប្រកាន់ លោក ណា ជី ប រ៉ាហ្សាក់ ជាច្រើន ករណី ពាក់ព័ន្ធ អំពើពុករលួយ កាលពី លោក នៅ កាន់អំណាច ! ( ចុច អាន )
៧៖ ទីក្រុង ដាម៉ាស់ អំពាវនាវ ឱ្យ ប្រជាជន ស៊ីរី ត្រឡប់ ចូល ស្រុក វិញ ក្រោយ ទឹកដី មួយ ផ្នែក ធំ ត្រូវបាន រំដោះ ( ចុច អាន )
៨៖ អ៊ីរ៉ង់ ថា នឹង ជួប មហា អំណាច ទាំង៥ នៅ ថ្ងៃសុក្រ នេះ ដើម្បី ជជែក ពី កិច្ចព្រមព្រៀង នុយក្លេអ៊ែរ ( ចុច អាន )
១០៖ ការប្រើប្រាស់ ព័ត៌មានវិទ្យា នៅ ប្រទេស ចិន ក្លាយជា កត្តា ជំរុញ ដល់ ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច ( ចុច អាន )
( ភ្នំពេញ ) ៖ លោក សេង រិទ្ធី ប្រធាន ក្រុមប្រឹក្សា ចៅក្រម នៃ សាលាដំបូង រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន បើក សវនាការ កាត់ទោស បុរស ជនជាតិ នីហ្ស៊េ រីយ៉ា២នាក់ ពាក់ព័ន្ធ សំណុំរឿង ដឹកជញ្ជូន គ្រឿងញៀន ជាង ១គីឡូក្រាម ចូល ប្រទេស កម្ពុជា កាលពី ខែកក្កដា ឆ្នាំ ២០១៧ ។
គួរ រំលឹក ថា សមត្ថកិច្ច មន្ទីរ ប្រឆាំង គ្រឿងញៀន ក្រសួង មហាផ្ទៃ បាន ឃាត់ខ្លួន ជនជាប់ចោទ ខាងលើ ជា បន្តបន្ទាប់ កាលពី ថ្ងៃទី ១៣ ខែកក្កដា ឆ្នាំ ២០១៧ ។ ក្រោយពេល ឃាត់ខ្លួន សមត្ថកិច្ច បាន ដកហូត គ្រឿងញៀន ប្រភេទ កាកូអ៊ីន ចំនួន ១.១ គីឡូក្រាម ៕ ទេសរដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន ដឹកនាំ កិច្ចប្រជុំ គណៈកម្មការ មូលបត្រ កម្ពុជា លើក ទី ៥២ ដោយ ពិភាក្សា លើ របៀបវារៈសំខាន់ ៗ ចំនួន ៤
* របៀបវារៈ ទី៣៖ អនុម័ត ដោយ ផ្តល់ ការអនុញ្ញាត ជា គោលការណ៍ លើ ការផ្តល់ ការទទួលស្គាល់ ធនាគារ កម្ពុជា សាធារណៈ ធ្វើជា ភ្នាក់ងារ ទូទាត់ សាច់ប្រាក់ ពាក់ព័ន្ធ នឹង មូលបត្រ ។
* របៀបវារៈ ទី៤៖ អនុម័ត លើ សេចក្តីព្រាង ប្រកាស ស្ដីពី ការផ្ដល់ ការអនុញ្ញាត ដល់ ក្រុមហ៊ុន ចែកចាយ លក់ មូល - បត្រ និង ភ្នាក់ងារ ចែកចាយ លក់ មូលបត្រ ៕
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៤ ខែកក្កដា លទ្ធផល៖ បង្ក្រាប ១៤ករណី ឃាត់ខ្លួន ២០ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៤ ខែកក្កដា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ ១១៨ គ្រឿង និង ផាក ពិន័យ ៥២ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន ១.១៣០ គ្រឿង រកឃើញ ល្មើស ច្បាប់ ១១៨ គ្រឿង ( ម៉ូតូ ៤៥ ភាគរយ ) អប់រំ៦៦ គ្រឿង និង ផាក ពិន័យ ៥២ គ្រឿង . នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
របាយការណ៍ បាន បញ្ជាក់ ទៀត ថា ចំពោះ ការត្រួតពិនិត្យ មួក និង កញ្ចក់ នៅ ថ្ងៃទី ០៤ ខែកក្កដា នេះ ត្រួតពិនិត្យ រួម បាន ចំនួន ១១៧ គ្រឿង . អប់រំ ចំនួន ១៤ គ្រឿង និង ផាក ពិន័យ ចំនួន ១៤ គ្រឿង ។
សូម បញ្ជាក់ ថា រយៈពេល ០៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ ដល់ ០៤ ខែកក្កដា នេះ សមត្ថកិច្ច ត្រួតពិនិត យានយន្ត សរុប ៦.៦២០ គ្រឿង រកឃើញ មធ្យោបាយ ល្មើស ៧៤៥ គ្រឿង អប់រំ៣៣១ គ្រឿង និង ពិន័យ ៤១៤ គ្រឿង ៕
កងទ័ព នៅ កងពល តូច អន្តរាគមន៍ លេខ១ ត្រៀម រួច ជាស្រេច កម្ទេច ក្រុម ឧទ្ទាម ក្បត់ ជាតិ ដូច សម រង្ស៊ី ក្រោយ អំពាវនាវ ឲ្យ កងកម្លាំងប្រដាប់អាវុធ បះបោរ ប្រឆាំង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់
( កំពង់ឆ្នាំង ) ៖ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ កងពល តូច អន្តរាគមន៍ លេខ១ សូម ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ សម្តី របស់ ទណ្ឌិត សម រង្ស៊ី ដែល នៅតែ បន្ដ គគ្លើន ញុះញង់ ឲ្យ កងកម្លាំងប្រដាប់អាវុធ បះបោរ ប្រឆាំង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ទាំង នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ទាំងអស់ នៃ កងពល តូច អន្តរាគមន៍ លេខ១ បាន ប្រកាស ទៅ ទណ្ឌិត រត់ ចោល ស្រុក ជាថ្មី ម្ដង ទៀត ថា « កងទ័ព បាន ត្រៀម រួច ជាស្រេច ហើយ ដើម្បី កម្ទេច ក្រុម ឧទ្ទាម ក្បត់ ជាតិ ចង់ បង្កើត បដិវត្តន៍ ពណ៌ ដែល ចង់ឲ្យ សង្គមជាតិ កម្ពុជា វិល ទៅរក សង្គ្រាម សា ជា ថ្មី ឡើងវិញ » ។
លោក ឧត្តមសេនីយ៍ ឯក ព្រហ្ម ផេង មេបញ្ជាការ កងពល តូច អន្តរាគមន៍ លេខ១ បាន បញ្ជាក់ ខ្លាំង ៗ ថា « យើងខ្ញុំ សូម ចាត់ទុក សម្តី ញុះញង់ បែប នេះ ជា សម្តី ក្បត់ ជាតិ ទាំងស្រុង មិន អាច លើកលែង បាន និង ត្រូវតែ ថ្កោល ទោស ឲ្យ ធ្ងន់ បន្ថែម ទៀត និង សូម ផ្តាំ ទៅ ទណ្ឌិត សម រង្ស៊ី ថា កុំ ដេក ស្រម៉ៃ ចង់ បំបែកបំបាក់ទឹកចិត្ត ស្មារតី របស់ កងទ័ព ឲ្យ ក្បត់ នឹង សម្តេច តេជោ ឲ្យ សោះ ពិសេស កងទ័ព និង ប្រជាជន ពីព្រោះ កងទ័ព គឺជា អ្នកបម្រើ ប្រជាជន បម្រើ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ បម្រើ សម្តេច តេជោ ហ៊ុន សែន » ។
សូម ជម្រាប ថា ទណ្ឌិត សម រង្ស៊ី អតីត ប្រធាន អតីត គណបក្ស សង្រ្គោះ ជាតិ ដែល កំពុង មាន សំណុំរឿង ស្អេកស្កះ នៅ តុលាការ កម្ពុជា នៅ យប់ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ចេញ វីដេអូ ឃ្លីប មួយ អំពាវនាវ ជាថ្មី ឲ្យ កម្លាំងប្រដាប់អាវុធ បះបោរ ប្រឆាំង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ដែល ដឹកនាំ ដោយ សម្ដេច តេជោ ហ៊ុន សែន ។
( ត្បូងឃ្មុំ ) ៖ នៅ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ សាខា កាំ កុងត្រូល ខេត្ត ត្បូងឃ្មុំ ដឹកនាំ ដោយ លោក មាស មោរ៉ា ប្រធាន សាខា កាំ កុងត្រូល ខេត្ត បាន ដឹកនាំ មន្ត្រី កាំ កុងត្រូល បន្ត ធ្វើ ការ ចុះ ត្រួតពិនិត្យ ព្រមទាំង ណែនាំ តាម បណ្តា ស្ថានីយ ដេប៉ូលក់ និង ចែកចាយ ប្រេងឥន្ធនៈ ចំនួន ០៩ ទីតាំង រួម មាន តូតាល់ សូគី ម៉ិច សាវីម៉ិច និង តេលា នៅ ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ អំពី តម្លៃ ប្រេង តាម សេចក្តីជូនដំណឹង របស់ ក្រសួង ពាណិជ្ជកម្ម ចុះ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ ។
លោក មាស មោរ៉ា បាន ឲ្យដឹង ថា តម្លៃ លក់ ប្រេង ទាំង ០៩ ស្ថានីយ រួម មាន៖
តាមរយៈ លទ្ធផល ក្រោយ ការត្រួតពិនិត្យ ស្ថានី យ៏ និង ដេប៉ូ ប្រេងឥន្ធនៈ ទាំង ០៩ ខាងលើ ឃើញ ថា ចំពោះ សាំង ធម្មតា និង ប្រេង ម៉ាស៊ូត ថ្លៃ លក់ មិន លើ ស ពី សេចក្តីជូនដំណឹង របស់ ក្រសួង ពាណិជ្ជកម្ម ឡើយ ។
លោក ប្រធាន កាំ កុងត្រូល ខេត្ត បញ្ជាក់ ថា ដោយឡែក ចំពោះ ប្រេងសាំង ស៊ុប ពែរ មាន ០២ ស្ថានី យ៏ លក់ លើស ៥០ រៀល ក្នុង មួយ លីត្រ និង ០១ ស្ថានីយ៌ ទៀត លក់ លើស ១០០ រៀល ពី សេចកី្ត ជូន ដំណឹង របស់ ក្រសួង ពាណិជ្ជកម្ម ។ ប៉ុន្តែ ជាទូទៅ យើង សង្កេតឃើញ ថា នៅ ស្រុក មេមត់ ខេត្ត ត្បូងឃ្មុំ ប្រេង គ្រប់ ប្រភេទ លក់ ទាប ជាង តម្លៃ ដែល បាន កំណត់ នៅក្នុង សេចក្តីជូនដំណឹង របស់ ក្រសួង ពាណិជ្ជ លេខ ២៣៦៥ ចុះ ថ្ងៃ ២៩ / ០៦ / ២០១៨ ។
ជាមួយគ្នា នោះ មន្រ្តី កាំ កុងត្រូល ខេត្ត បាន ធ្វើ ការណែនាំ ដល់ ម្ចាស់ ស្ថានីយ និង ដេប៉ូបន្ត ចូលរួម សហការ អនុវត្ត តាម គោលការណ៍ ណែនាំ របស់ ក្រសួង ពាណិជ្ជកម្ម ឲ្យ មាន ប្រសិទ្ធភាព និង ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ ៕ មន្ត្រី កាំ កុងត្រូល ចុង ទី ភ្នំពេញ បន្ត ចុះ អង្កេត រក ផលិតផល ខូច គុណភាព នៅ ផ្សារ នាគ មាស និង នៅ តាម ហាង និង ផ្ទះ លក់ដូរ មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ ដើម្បី ការពារ ផលប្រយោជន៍ អ្នកប្រើប្រាស់ និង ចូលរួម ទប់ស្កាត់ ផល ប៉ះពាល់ ដល់ សុខភាព អ្នកប្រើប្រាស់ តាមរយៈ ចំណីអាហារ នៅ ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក គង់ វុទ្ធី អនុប្រធាន សាខា កាំ កុងត្រូល ផែ ស្ងួត ចុង ទី ភ្នំពេញ បាន សហការ ជាមួយ មន្រ្តី មន្ទីរ ពាណិជ្ជកម្ម ភ្នំពេញ អាជ្ញាធរ ខណ្ឌ ទួលគោក ចុះ ត្រួតពិនិត្យ ទំនិញ នៅ ផ្សារ នាគ មាស នៅ តាម ផ្ទះ លក់ ទំនិញ និង ហាង លក់ ទំនិញ មួយចំនួន នៅក្នុង រាជធានី ភ្នំពេញ ។
លោក គង់ វុទ្ធី បាន បញ្ជាក់ ថា នៅក្នុង ប្រតិបត្តិការ ចុះ ត្រួតពិនិត្យ នេះ គឺ ធ្វើឡើង តាម បទបញ្ជា លោក ប្រធាន ប្រតិភូ ទទួលបន្ទុក អគ្គ នាយកដ្ឋាន កាំកុងត្រូល និង លោក ប្រធាន សាខា ផែ ស្ងួត ចុង ទី ភ្នំពេញ ដែល គិត អំពី សុវត្ថិភាព និង សុខភាព ដល់ បងប្អូន ប្រជាពលរដ្ឋ ហើយ សកម្មភាព នេះ គឺ បាន ធ្វើឡើង ដូច ភ្លៀង រលឹម យ៉ាង ដូច្នេះ ដែរ ។
ជាមួយគ្នា នោះ ដែរ លោក ក៏ បាន ណែនាំ ដល់ ក្រុម អាជីវករ ទាំងអស់ ដាក់ តាំង លក់ ផលិត ផល អោយ ត្រូវ តាម លក្ខណៈ បច្ចេកទេស ដោយ ញែក ចេញ ពី គ្នា រវាង គ្រឿង ប្រើប្រាស់ ដែល ផ្ទុក សារធាតុ ពុល និង ម្ហូប អាហារ ហាម ការដាក់ តាំង ផលិតផល ភេសជ្ជៈ ត្រូវ កំដៅ ថ្ងៃ និង ការដាក់ លក់ ផលិតផល ហួស កាលបរិច្ឆេទ ជាដើម ផងដែរ ។
លោក ក៏ បាន អំពាវនាវ ដល់ អាជីវករ អ្នកចែកចាយ លក់ ដុំ លក់ រាយ អ្នកផលិត នាំចូល ចែកចាយ ត្រូវតែ មាន ប្រភព ច្បាស់លាស់ សិន មុននឹង ទទួល លក់ ហើយ បញ្ជប់ ការលាយ បន្ថែម នូវ សារធាតុ គីមី ទៅ លើ ផលិតផល ម្ហូប អាហារ ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ សុខភាព អ្នកប្រើប្រាស់ ៕ ប្រកាស បញ្ចូល សមាជិក បក្ស ថ្មី ជាង ១ ពាន់ នាក់ នៅ ឃុំ ចំនួន ៣ ក្នុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ . លោក វង សូត ស្នើឲ្យ សមាជិក បក្ស ផ្តល់ ទំនុកចិត្ត និង ភាពកក់ក្តៅ ជូន ប្រជាពលរដ្ឋ
( ត្បូងឃ្មុំ ) ៖ ក្នុង ពិធី ប្រកាស បញ្ចូល សមាជិក បក្ស ថ្មី ១០១៨ នាក់ នៅ ឃុំ កោងកាង ឃុំ ក្រែ ក ឃុំ ដូនតី ក្នុង ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ លោក វង សូត អនុប្រធាន ក្រុមការងារ ចុះ ជួយ បក្ស ថ្នាក់ ខេត្ត និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ នៅ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ស្នើឲ្យ សមាជិក បក្ស ទាំងអស់ ត្រូវ ផ្តល់ ទំនុកចិត្ត និង ភាពកក់ក្តៅ ជូន ប្រជាពលរដ្ឋ ។
លោក វង សូត ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ បាន ថ្លែង បែប នេះ ខណៈ លោក និង លោកជំទាវ បាន អញ្ជើញ សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា បក្ស មូលដ្ឋាន និង ប្រកាស ចូល ជា សមាជិក គណបក្ស ចំនួន ៣៨៩ នាក់ មកពី ភូមិ ចំនួន ២២ ស្ថិត នៅ ឃុំ កណ្ដោល ជ្រុំ ស្រុក ពញា ក្រែក ខេត្ត ត្បូងឃ្មុំ នៅ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ ។
លោក វង សូត បាន ថ្លែង ឲ្យដឹង ថា បច្ចុប្បន្ន នេះ ប្រទេស កម្ពុជា កំពុងតែ មាន ការរីកចំរើន ទៅ មុខ ជាលំដាប់ ក្រោម ការដឹកនាំ របស់ គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ជា ប្រមុខ ដ៏ ល្អ ។ លោក វង សូត បន្ត ថា សម្តេច តេជោ ហ៊ុន សែន ដឹកនាំ កម្ពុជា ក្រោយ ថ្ងៃ ០៧ ខែមករា ឆ្នាំ ១៩៧៩ មក បាន នាំយក សន្តិភាព និង សុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ទូទាំង ប្រទេស ។
លោក វង សូត បាន លើកឡើង ថា ការផ្តល់ សេចក្តីទុកចិត្ត របស់ ប្រជាពលរដ្ឋ មក លើ រាជ រដ្ឋាភិបាល ដឹកនាំ ដោយ គណបក្ស ប្រជាជន កម្ពុជា គឺ បាន ធ្វើឲ្យ ប្រទេសជាតិ មាន សុខ សន្តិភាព និង ភាពរីកចម្រើន លើ គ្រប់ វិស័យ ពិសេស ស្មើ មុខ ស្មើ មាត់ លើ ឆាក អន្តរជាតិ ក្នុង នោះ ប្រទេស កម្ពុជា សម្រេចបាន នូវ គ្រឹះ លទ្ធិ ប្រជាធិតេយ្យ និង ការគោរព សិទ្ធិ មនុស្ស បាន យ៉ាង ពេញលេញ ផ្ទុយ ពី ក្រុម មនុស្ស មួយចំនួន ដែល បាន ដើរ និយាយ រិៈ គន់ មួល បង្កាច់ តែ ប្រជាជន និង ប្រទេសជាតិ ខ្លួន ឯង ។
លោក បាន បន្ថែម ថា ដើម្បី រក្សា បាន នូវ សុខ សន្តិភាព និង ភាពរីក ចម្រើន នេះ គឺ អាស្រ័យ លើ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ គ្នា ការពារ ពោលគឺ កុំ ចាញ់ ឧបាយកល ជន ឆបោក មួយចំនួន ដែល បាន ត្រឹម និយាយ តែ មិន បាន ធ្វើ អ្វី ទាល់តែសោះ ៕
សម្រែក ហ៊ោ កញ្ជ្រៀវ របស់ ប្រជារាស្ត្រ ខ្មែរ បាន បន្លឺ ឡើង យ៉ាង កង រំពង នៅពេញ បរិវេណ ពន្លាត ក្រមា១០០០ ម៉ែត្រ នា មជ្ឈមណ្ឌល កោះ ពេជ្រ អបអរសាទរ ជោគជ័យ គួរ ជាទីមោទន និង ជា កិត្តិយស ជាតិ ថ្មី មួយ ទៀត របស់ កម្ពុជា ដែល កើត ចេញពី ការរួម សាមគ្គី របស់ ប្រជាជន ខ្មែរ ។
ព្រម ជាមួយគ្នា នេះ ផងដែរ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ បាន សម្តែង ការចូលរួម អបអរសាទរ ក្រមា ខ្មែរ បំបែក ឯតទគ្គកម្ម ក្រមា វែង ជាង គេ លើ ពិភពលោក តាមរយៈ ការផលិត ជាបទចម្រៀង មួយ បទ ក្រោម ចំណងជើង ថា « ក្រមា សាមគ្គី ក្រមា កម្ពុជា » ដែល មាន អត្ថន័យ ខ្លឹមសារ ទាំងស្រុង ដូច ខាងក្រោម៖ អភិបាល រាជធានី ភ្នំពេញ ចុះ ពិនិត្យ រថយន្តក្រុង ជា ជំនួយ ជប៉ុន ជើង ទី១ ចំនួន ២០ គ្រឿង
( ភ្នំពេញ ) ៖ ក្នុង គោលដៅ ដើម្បី បម្រើ លើ វិស័យ ដឹកជញ្ជូន សាធារណៈ រថយន្តក្រុង រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ពេញ និង តំណាង អង្គការ ចៃការ នៃ ប្រទេស ជប៉ុន បាន អញ្ជើញ ចុះ ពិនិត្យ និង ជិះ សាកល្បង រថយន្ត ថ្មី នេះ ដែល បាន រក្សាទុក នៅ តំបន់ អភិវឌ្ឍន៍ ជ្រោយ ចង្វារ សង្កាត់ ជ្រោយ ចង្វា ខណ្ឌ ឬស្សីកែវ ។
លោក ឃួង ស្រេង បាន លើកឡើង ថា ដោយ មើលឃើញ ស្ថានភាពកកស្ទះ ចរាចរណ៍ នៅក្នុង រាជធានី ភ្នំពេញ ខាង អង្គការ ចៃការ របស់ ប្រទេស ជប៉ុន បាន សម្រេច ផ្តល់ ជូន ៨០ គ្រឿង ក្នុង នោះ ក្នុង ជំហាន ទី១ ជប៉ុន ផ្តល់ឲ្យ ២០ គ្រឿង នេះ . ជំហាន ទី២ បន្ត ប្រគល់ ជូន ចំនួន ២០ គ្រឿង . ទី៣ ចំនួន ២០ គ្រឿង និង ទី៤ បំណាច់ ឆ្នាំ នេះ ប្រគល់ ជូន ២០ គ្រឿង ទៀត បង្គ្រប់ តែម្តង ។
លោក ស្នើឲ្យ ប្រជាពលរដ្ឋ គោរព ច្បាប់ ចរាចរណ៍ ទាំងអស់ គ្នា ការចូលរួម របស់ បងប្អូន គឺជា ការចូលរួម យ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ ខ្លួន ឯង និង អភិវឌ្ឍ ប្រទេសជាតិ យើង ឲ្យបាន រីកចំរើន ឆាប់ រហ័ស ។
លោក អ៊ាន សុឃីម ប្រធាន រដ្ឋាករ ស្វ័យត ដឹកជញ្ជូន សាធារណៈ រថយន្តក្រុង រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា ការបង្កើត រថយន្តក្រុង ឡើង នេះ ដោយសារតែ កំណើន ប្រជាជន ជាមួយ កំណើន យានយន្ត កើនឡើង ខ្ពស់ ទើប សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី សម្រេច បង្កើត ឲ្យ មាន រថយន្តក្រុង នេះ ឡើង នៅ ថ្ងៃទី១ ខែកញ្ញា ឆ្នាំ ២០១៤ ដោយ មាន រថយន្ត ៥៧ គ្រឿង ។
( ភ្នំពេញ ) ៖ កងពល តូច ទ័ព ពិសេស ឆត្រយោង ៩១១ នៅ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ចេញ សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស ដល់ ទណ្ឌិត សម រង្ស៊ី មេ ចលនា សង្រ្គោះ ជាតិ ដែល អំពាវនាវ ឱ្យ កងកម្លាំងប្រដាប់អាវុធ ងើប បះបោរ ប្រឆាំង នឹង រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ ។
ខាងក្រោម នេះ ជា សេចក្តីថ្លែងការណ៍ របស់ កងពល តូច ទ័ព ពិសេស ឆត្រយោង ៩១១៖
អបអរសាទរ ពិធី រុក្ខ ទិវា ៩ កក្កដា ! កូន ឈើ ជិត ២ពាន់ ដើម ត្រូវបាន មន្រ្តី និង ពលរដ្ឋ យក ទៅ ដាំ នៅ ព្រលានយន្តហោះ ចាស់ ក្នុង ខេត្ត មណ្ឌលគិរី
( មណ្ឌលគិរី ) ៖ កូន ឈើ ចម្រុះ និង ឈើ ហូប ផ្លែ គ្រប់ ប្រភេទ ចំនួន ១៥០០ ពាន់ ដើម ត្រូវបាន អាជ្ញាធរ ខេត្ត មណ្ឌលគីរី មន្ត្រីរាជការ លោកគ្រូ អ្នកគ្រូ ប្រជាពលរដ្ឋ រួម និង សិស្សានុសិស្ស បាន រៀបចំ ដាំ នៅ ទីតាំ ព្រលានយន្តហោះ ក្នុង ទីធ្លា សួនច្បារ ស្ថិត នៅ ភូមិ ដោះ ក្រមុំ សង្កាត់ សុខដុម ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគិរី នៅ ព្រឹក ថ្ងែ ទី៥ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ដើម្បី អបអរសាទរ ពិធី រុក្ខ ទិវា ៩ កក្កដា ឆ្នាំ ២០១៨ ។
លោក សុង ឃាង ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ខេត្ត មណ្ឌលគិរី បាន ឱ្យដឹង ថា ទិវា ហត្ថកម្ម ដាំ ដើមឈើ ជា ប្រពៃណី ជាតិ ហៅ ថា បុណ្យ រុក្ខ ទិវា ត្រូវបាន ប្រារព្ធ ធ្វើឡើង នៅ ទី៩ ខែកក្កដា ជារៀងរាល់ ឆ្នាំ ទូទាំង ប្រទេស សំដៅ ធានា នូវ ការគ្រប់គ្រង ព្រៃឈើ ប្រកបដោយ និរន្ដភាព និង មាន ផលប្រយោជន៍ សម្រាប់ សង្គម សេដ្ឋកិច្ច និង បរិស្ថាន រួមទាំង ការអភិរក្ស ជីវៈ ចម្រុះ និង មរតក វប្បធម៌ ពិសេស អាច បង្កើត បាន នូវ ម្លប់ បៃតង ឡើងវិញ ធ្វើឱ្យ ទីក្រុង ស្អាត ។
ជាមួយគ្នា នេះ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី បាន ថ្លែង ថា ការដាំ ដើមឈើ ពិតជា មាន ប្រយោជន៍ ណាស់ ដូចនេះ ប្រជាពលរដ្ឋ យើង ទាំងអស់ គ្នា សូម ចូលរួម ដាំដុះ កូន ឈើ រក្សា ការពារ និង ស្រឡាញ់ ព្រៃឈើ ស្រឡាញ់ ជីវ ចម្រុះ សត្វ ព្រៃ ដើម្បី ប្រែក្លាយ តំបន់ រស់ នៅ ឱ្យ មាន គម្រប ពណ៌ បៃតង ស្រស់បំព្រង និង អភិរក្ស ធនធាន ព្រៃឈើ សម្រាប់ ជា មូលដ្ឋានគ្រឹះ នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ជាតិ ។
លោក អភិបាល ខេត្ត បាន បញ្ជាក់ បន្ថែម ទៀត ថា ការបាត់បង់ ព្រៃឈើ និង គម្រប ព្រៃឈើ បណ្តាលឱ្យ តំបន់ យើង ទទួលរង ការគំរាមកំហែង ពី ធម្មជាតិ ដូចនេះ យើង ត្រូវ នាំគ្នា បញ្ឈប់ ការកាប់ រាន ដុត ឈូសឆាយ ដី ព្រៃឈើ ធ្វើជា កម្មសិទ្ធ ហើយ នាំគ្នា រក្សា ការពារ និង ដាំ ដើមឈើ ឡើងវិញ ឱ្យ បាន ច្រើន រួមទាំង ឈើ ហូប ផ្លែ ផងដែរ ៕ តុលាការ ខេត្ត កណ្ដាល ផ្តន្ទាទោស ស្ត្រី ម្នាក់ ដែល ចាក់ សម្លាប់ ប្រុស ស្នេហ៍ ប្លន់ ទ្រព្យសម្បត្តិ លោះ ប្តី ចេញ ពី គុក ដាក់ ពន្ធនាគារ ៣០ ឆ្នាំ
( កណ្ដាល ) ៖ លោក សាយ សម្ផស្ស សេរី ប្រធាន ក្រុមប្រឹក្សា ជំនុំជម្រះ សាលាដំបូង ខេត្ត កណ្ដាល នៅ ថ្ងៃទី ០៥ ខែកក្កដា នេះ ប្រកាស សាលក្រម ផ្តន្ទាទោស ស្ត្រី ម្នាក់ ដាក់ ពន្ធនាគារ ៣០ ឆ្នាំ ពី បទ ឃាតកម្ម ចាក់ សម្លាប់ ប្រុស ស្នេហ៍ ប្លន់ ទ្រព្យសម្បត្តិ ដើម្បី លោះ ប្តី ចេញពី ពន្ធនាគារ ។
ជនជាប់ចោទ ឈ្មោះ ផេង ណាន ហៅ ណា អាយុ ៣៣ ឆ្នាំ មុខរបរ នារី ម៉ាស្សា ស្នាក់ នៅ ភូមិ ព្រៃ បឹង សង្កាត់ កន្ទោក ខណ្ឌ ពោធិ៍សែនជ័យ ។
ជនរងគ្រោះ ឈ្មោះ នួន សុភាព អាយុ ៥៨ ឆ្នាំ ជា ម្ចាស់ ហាង កោស ជប់ ម៉ាស្សា មួយ កន្លែង ផង ជា មន្ត្រី យោធា នៅ អង្គភាព កងពល តូច ទ័ព ពិសេស ឆត្រយោង ៩១១ផង និង ក៏ ជា អ្នកសារព័ត៌មាន សំឡេង ប្រជាជន ផងដែរ មាន លំនៅក្នុង ភូមិ ស្រែ អំពិល សង្កាត់ ស្នោរ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
ចំពោះមុខ សមត្ថកិច្ច ស្ត្រី ជនសង្ស័យ ឆ្លើយ សារភាព ថា នៅ មុនពេល កើត ហេតុ ជនរងគ្រោះ បាន ទូរស័ព្ទ មក បបួល នាង ទៅ រួមភេទ ស្រប ពេល នោះ ដោយសារតែ នាង កំពុង ត្រូវការ លុយ ចំនួន ២៥០០ ដុល្លារ ដើម្បី រត់ ការដោះលែង ប្តី ដែល កំពុង ជាប់ ពន្ធនាគារ ព្រៃស ផង ណាមួយ ឃើញ ជនរងគ្រោះ មាន គ្រឿងអលង្ការ ជាប់ ខ្លួន ច្រើន ក៏ មាន គំនិត ចង់ សម្លាប់ ជនរងគ្រោះ ដើម្បី ប្លន់ យក ទ្រព្យសម្បត្តិ នោះ តែម្តង ។
ស្ត្រី សង្ស័យ បាន ឆ្លើយ សារ ភាព ទៀត ថា ពេល នោះ នាង បាន ទារ តម្លៃ ខ្លួន ក្នុង ការរួមភេទ ចំនួន ១០ម៉ឺន រៀល តែ ជនរងគ្រោះ ឱ្យ តែ ២០ ដុល្លារ ប៉ុណ្ណោះ ហើយ នាង ក៏ យល់ព្រម ទៅ ជាមួយ ដោយ បាន រៀបចំ គម្រោង ទុក ជាមុន និង បាន យក កូន កាំបិត ចុង ស្រួច លាក់ ទុក ក្នុង កាបូប រួច ជាស្រេច ។
លុះ មកដល់ វេលា ម៉ោង ប្រមាណ ១១ព្រឹក ថ្ងៃទី ២១ ខែមករា ឆ្នាំ ២០១៨ ជនសង្ស័យ បាន ទូរស័ព្ទ ដើម្បី ណាត់ គ្នា រក កន្លែង រួមភេទ រហូតដល់ ម៉ោង ប្រហែល ១២ ថ្ងៃត្រង់ ទើប ជនរងគ្រោះ បាន ជិះ ម៉ូតូ មក ទទួល នាង នៅ ចំណុច មុខ ច្រក ចូល ភូមិ បូរី កម្មករ ឃុំ បែក ចាន ស្រុក អង្គស្នួល ដើម្បី ទៅ ចូល ដេក ផ្ទះសំណាក់ កើត ហេតុ ដែល មាន ចម្ងាយ ប្រហែល កន្លះ គីឡូម៉ែត្រ ប៉ុណ្ណេះ ពី កន្លែង ដែល ជនរងគ្រោះ មក ទទួល នាង ។
( វ៉ាស៊ីនតោន ) ៖ ថ្លែង ក្នុង ឱកាស ប្រារព្ធ ខួប ទី ២៤២ នៃ បុណ្យ ឯករាជ្យ ជាតិ របស់ សហរដ្ឋ អាមេរិក ចេញ ពី សេតវិមាន ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន សម្តែង ការកោតសរសើរ និង ស្ញប់ស្ញែង ចំពោះ កងកម្លាំង យោធា ដែល បាន ពលី និង ខិតខំ ការពារ សិទ្ធិ សេរីភាព នៃ ប្រទេសជាតិ របស់ ពួកគេ នា ពេល កន្លងមក នេះ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន រុស្ស៊ី Sputnik នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី០៥ ខែកក្កដា ឆ្នាំ ២០១៨ ។
លោក ដូណាល់ ត្រាំ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « អរគុណ អ្នក ទាំងអស់ គ្នា ដែល បាន រក្សា ការពារ អាមេរិក ឲ្យ មាន សុវត្ថិភាព និង រឹងមាំ ព្រមទាំង មាន មោទនភាព និង អង់អាច ហើយ មាន សេរីភាព ។ សូម ព្រះប្រទាន ពរ ដល់ អ្នក ទាំងអស់ គ្នា . សូម ព្រះប្រទាន ពរ ដល់ យោធា របស់ យើង . និង សូមឲ្យ ព្រះជា ម្ចាស់ ប្រទាន ពរ ដល់ សហរដ្ឋ អាមេរិក ទាំងមូល ។ រីករាយ ទិវា ជាតិ ០៤ កក្កដា » ។
លោក ត្រាំ បាន បន្ថែម ទៀត ថា សេរីភាព របស់ អាមេរិក គឺ បាន មកពី ការបង្ហូរ ញើស - ឈាម និង ពលី របស់ អ្នកស្នេហាជាតិ អាមេរិក ដែល បាន តស៊ូ ប្រយុទ្ធ នៅលើ សមរភូមិ តាំងពី សម័យ មុន ៗ រហូតមកដល់ សម័យ នេះ ។
គួរ ជម្រាប ថា នា ឱកាស នោះ លោក ប្រធានាធិបតី អាមេរិក ក៏ បាន ឆ្លៀត ថ្លែង ពាក់ព័ន្ធ នឹង គម្រោង មហិច្ឆតា របស់ លោក ផ្ទាល់ ស្តីពី ការបង្កើត កង អង្គភាព ថ្មី នៅក្នុង ជួរ កម្លាំងប្រដាប់អាវុធ អាមេរិក ផងដែរ គឺ កងទ័ព នៅ ទី អវកាស ដោយ លោក បាន អះអាង ថា វា នឹង លេចចេញ ជា រូបរាង នា ពេល ឆាប់ ៗ ខាងមុខ ។
ថ្ងៃ បុណ្យ ឯករាជ្យ ឬ ក៏ ទិវា ជាតិ ០៤ កក្កដា គឺជា ថ្ងៃ ឈប់សម្រាក ទូទាំង សហរដ្ឋ អាមេរិក ដើម្បី អបអរ ថ្ងៃ ប្រកាស ឯករាជ្យ នៃ មហា អំណាច មួយ នេះ កាលពី ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ១៧៧៦ ។ កាលពី ជាង ២៤០ ឆ្នាំ មុន នេះ ក្រុម ចំណុះ អាមេរិក ទាំង ១៣ បាន ប្រកាស ខ្លួន ជា ប្រជាជាតិ ឯករាជ្យ មួយ ហៅ ថា សហរដ្ឋ អាមេរិក ដែល វា មាន ន័យ ថា ក្រុម ទាំងនោះ លែង ស្ថិត ក្រោម នឹម អាណានិគម របស់ ចក្រភព អង់គ្លេស ទៀត ហើយ ៕
កិច្ចចរចា បរាជ័យ . ទ័ព អាកាស រុស្ស៊ី វាយ កម្ទេច មូលដ្ឋាន ក្រុម ប្រឆាំង និង ដណ្តើម បាន ទឹកដី មួយ ភាគ ធំ មក ជូន រដ្ឋាភិបាល ស៊ីរី វិញ !
( ស៊ីរី ) ៖ ក្រុម អង្គការ ឃ្លាំមើល សិទ្ធិ មនុស្ស ស៊ីរី បាន អះអាង ថា ការវាយប្រហារ តាម ផ្លូវ អាកាស របស់ កងកម្លាំង ទ័ព អាកាស រុស្ស៊ី ប្រឆាំង នឹង ក្រុម ឧទ្ទាម ស៊ីរី នៅឯ ភាគ និរតី នៃ ប្រទេស បាន ចាប់ផ្ដើម ឡើងវិញ តែ ប៉ុន្មាន ម៉ោង ប៉ុណ្ណោះ ក្រោយ ក្រុម ឧទ្ទាម ប្រកាស ថា ការចរចា ជាមួយ ទីក្រុង ម៉ូស្គូ បាន បរាជ័យ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CGTN នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី០៥ ខែកក្កដា ឆ្នាំ ២០១៨ ។
គួរ បញ្ជាក់ ថា អង្គការ សហ ប្រជាជាតិ កាលពី ថ្ងៃចន្ទ ក៏ បាន ឱ្យដឹង ដែរ ថា ក្នុង ការវាយប្រយុទ្ធ គ្នា អស់ រយៈពេល ច្រើន ជាង ពីរ សប្ដាហ៍ មក នេះ រវាង ក្រុម ឧទ្ទាម និង កងកម្លាំង រដ្ឋាភិបាល ស៊ីរី ដែល មាន ជំនួយ ពី រុស្ស៊ី បាន ផ្ដាច់ យក ជីវិត មនុស្ស ច្រើន ជាង ១៣០ នាក់ និង បង្ខំឱ្យ មនុស្ស ២៧០.០០០ នាក់ រត់ ភៀសខ្លួន ចេញ ពី ផ្ទះសម្បែង របស់ ពួកគេ នៅឯ ភាគ និរតី នៃ ប្រទេស ៕
( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០១៨ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន ៤គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
ប្រធានាធិបតី វេណេស៊ុយអេឡា អំពាវនាវ ឲ្យ បញ្ឈប់ ជាបន្ទាន់ នូវ នយោបាយ ធ្វើ ទុក្ខបុកម្នេញ មេដឹកនាំ តំបន់ អាមេរិក ឡាទីន !
( ការ៉ាកាស់ ) ៖ ប្រធានាធិបតី វេណេស៊ុយអេឡា លោក នីកូឡាស់ ម៉ាឌូរ៉ូ បាន អំពាវនាវ ឱ្យ បិទ បញ្ចប់ ជាបន្ទាន់ នូវ នយោបាយ ធ្វើ ទុក្ខបុកម្នេញ លើ បណ្ដា មេដឹកនាំ អាមេរិក ឡាទីន ដែល ត្រូវបាន គេ ធ្វើបាប ដោយ ប្រើប្រាស់ ច្បាប់ បន្ទាប់ពី អស់ អំណាច ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CGTN នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី០៥ ខែកក្កដា ឆ្នាំ ២០១៨ ។
* ចាប់ពី ថ្ងៃទី ០៥ ដល់ ថ្ងៃទី ០៩ នឹង មាន ភ្លៀង ធ្លាក់ ច្រើន ជា បន្តបន្ទាប់ នៅ តាម បណ្តាល ខេត្ត ជាប់ មាត់ សមុទ្រ ។
* ចាប់ពី ថ្ងៃទី ០៥ ដល់ ថ្ងៃទី ១១ ខែកក្កដា នឹង មាន ភ្លៀង ធ្លាក់ រាយប៉ាយ ឡើងវិញ ពី មធ្យម ទៅ ច្រើន ក្នុង ក្របខ័ណ្ឌ ស្ទើរ ទូទាំង ប្រទេស ។
ជាមួយគ្នា នេះ ក្រសួង អំពាវនាវ សូម បងប្អូន ប្រជានេសាទ និង អ្នកធ្វើដំណើរ តាម សមុទ្រ បង្កើត ការប្រុងប្រយ័ត្ន ខ្ពស់ ដើម្បី ជៀសវាង នូវ គ្រោះថ្នាក់ ផ្សេង ៗ ដែល អាច កើតឡើង ជា យថាហេតុ ។
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្តីជូនដំណឹង របស់ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម ដូច ខាងក្រោម៖
សូម ពាក់ មួក សុវត្ថិភាព គ្រប់ ពេល បើកបរ ! ស្លាប់ ៧នាក់ និង របួស ១៧នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៤ ខែកក្កដា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ . របួស ស្រាល ២នាក់ និង របួស ធ្ងន់ ១៥នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង១០លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ៧គ្រឿង រថយន្ត តូច៦ គ្រឿង រថយន្ដ ធុន ធំ ២គ្រឿង និង កង់១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្មើស ល្បឿន . មិន ប្រកាន់ ស្ដាំ . កត្តា យានយន្ដ និង មិន គោរព សិទ្ធិ ។
សូម បញ្ជាក់ ថា យោង តាម របាយការណ៍ បាន ឲ្យដឹង ទៀត ថា រយៈ៤ ថ្ងៃ នេះ គិត ចាប់ពី ថ្ងៃទី ០១ដល់ ថ្ងៃទី ០៤ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ កើតឡើង ចំនួន ២៩ លើក បណ្ដា ឲ្យ មនុស្ស ស្លាប់ ចំនួន ១៩ នាក់ ក្នុង នោះ រងរបួស ធ្ងន់ ចំនួន ៣៣ នាក់ និង ស្រាល ចំនួន ២០ នាក់ ៕
រដ្ឋមន្ត្រី ម៉ម ប៊ុន ហេង ណែនាំឲ្យ មន្ទីរ សុខាភិបាល រាជធានី - ខេត្ត ត្រៀមលក្ខណៈ ទុក ជាមុន សម្រាប់ អន្តរាគមន៍ និង ផ្តល់ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ ប្រសិនបើ មាន គ្រោះមហន្តរាយ ទឹក ជំនន់ ក្នុង រដូវ ភ្លៀង
( ភ្នំពេញ ) ៖ លោក សាស្ត្រាចារ្យ ម៉ម ប៊ុន ហេង រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល បាន ណែនាំឲ្យ មន្ទីរ សុខាភិបាល រាជធានី - ខេត្ត ទាំងអស់ ត្រៀមលក្ខណ : ទុក ជាមុន ដោយ មាន ផែនការ ត្រឹមត្រូវ សម្រាប់ អន្តរាគមន៍ និង ផ្តល់ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ ប្រសិនបើ មាន គ្រោះមហន្តរាយ ទឹក ជំនន់ ក្នុង រដូវ ភ្លៀង ដែល កំពុងតែ ធ្លាក់ មក ជា បន្តបន្ទាប់ នេះ ។
លោកស្រី វេជ្ជបណ្ឌិត ថ្លែង បន្ដ ថា អ្នក ដែល ងាយ រងគ្រោះ ជាង គេ គឺ ស្រ្តី មាន ផ្ទៃពោះ កុមារ មនុស្ស ចាស់ និង ជន ពិការ ដូច្នេះ គ្រប់ មន្ដ្រី ទាំងអស់ ត្រូវ យកចិត្តទុកដាក់ រៀបចំ ផែន ការត្រៀម ឆ្លើយតប រួម មាន ទី ទួល សុវត្ថភាព ទឹក ស្អាត ក្រុម គ្រូពេទ្យ សម្ភារៈ បរិក្ខា ថ្នាំ ពេទ្យ សម្រាប់ ជួយសង្គ្រោះ ជនរងគ្រោះ ដោយ សារ ទឹក ជំនន់ ជាពិសេស ការអប់រំ សុខភាព និង សុវត្ថិភាព ចំណីអាហារ និង សុខភាព ផ្លូវចិត្ត ។
លើស ពី នេះ ត្រូវ ផ្តល់ នូវ សេវា សុខភាព ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ប្រសិនបើ ទោះជា មាន ទឹក ជំនន់ កើត មាន ឡើង ក៏ដោយ ព្រោះ ប្រជាពលរដ្ឋ នឹង អាច មាន បម្លាស់ ទី ទៅ នៅ តាម ទី ទួល សុវត្ថិភាព ដូច្នេះ សេវា ពិនិត្យ ផ្ទៃពោះ និង ចាក់ ថ្នាំ បង្ការ ដល់ កុមារ គឺ ត្រូវតែ ធ្វើជា ចាំបាច់ ដោយ ក្រុម គ្រូពេទ្យ ចល័ត ទៅដល់ ទីស្នាក់នៅ របស់ ពួកគាត់ ។
សូម ជម្រាប ថា សិក្ខាសិលា នេះ មាន ការអញ្ជើញ ចូលរួម ពី តំណាង គណកម្មការគ្រប់គ្រង គ្រោះមហន្តរាយ តំណាង សម្ព័ន្ធ ភាព ប្រែប្រួល អាកាសធាតុ នៃ ក្រសួង បរិស្ថាន ថ្នាក់ដឹកនាំ និង មន្ត្រី ទទួលបន្ទុក ការងារ គ្រប់គ្រង គ្រោះមហន្តរាយ នៃ នាយកដ្ឋាន ការពារ សុខភាព របស់ ក្រសួង សុខាភិបាល បុគ្គលិក មន្ត្រី សុខាភិបាល មកពី ខេត្ត ចំនួន ១៥ និង តំណាង អង្គការ សុខភាព ពិភពលោក ផងដែរ ៕
ថ្លែង ចេញពី ការិយាល័យ របស់ ខ្លួន នៅ ថ្ងៃអង្គារ សប្ដាហ៍ នេះ នាយក រដ្ឋមន្រ្តី ថៃ លោក ប្រាយុទ្ធ ចាន់ អូចា បាន គូសបញ្ជាក់ ដូច្នេះ ថា៖ « រូង ភ្នំ ស្ថិត នៅក្នុង ខេត្ត ឈៀង រ៉ាយ ភាគ ខាងជើង នៃ ប្រទេស ទំនង អាចនឹង ក្លាយជា កន្លែង ដ៏ ល្បីល្បាញ ទាំង នៅក្នុង ស្រុក និង ពិភព លោក ហើយ វា ក៏ អាចនឹង ក្លាយជា តំបន់ ទេសចរណ៍ ដ៏ សំខាន់ ផងដែរ ។ ដូច្នេះ យើង ត្រូវតែ ចាត់ វិធានការធានា សុវត្ថិភាព ឱ្យ ស្រប ទៅ តាម សកម្មភាព ទេសចរណ៍ » ។
ក្រុម ជំនាញ ត្រូវ បង្ហាត់ ពួកគេ ទាំង ១៣នាក់ ពី របៀប មុជទឹក និង ប្រើប្រាស់ បរិក្ខា មុជទឹក ជាមុន សិន ខណៈ ស្បៀងអាហារ បំពង់ អុក ស៊ី ហ្សែន និង ថ្នាំ ពេទ្យ កំពុង ត្រូវបាន ក្រុម សង្គ្រោះ ផ្សេង ទៀត បញ្ជូន ទៅ ខាងក្នុង រូង ភ្នំ ជា បណ្ដើរ ៗ ហើយ ៕
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍
ជាក់ស្ដែង នៅ រសៀល ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម ដឹកនាំ គណៈ ស្នងការ ទទួល ចុះ ជួយ ស្រុក ក្រុង និង បាន ចុះ ត្រួតពិនិត្យ កម្លាំង ដែល មាន ភារកិច្ចការពារ ការបោះឆ្នោត តាម បណ្តា ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល ចំនួន ១២ប៉ុស្ដិ៍ និង កម្លាំង ប្រជាការពារ ១២ឃុំ នៅ ស្រុក បាធាយ ។
ស្នងការ នគរបាល ខេត្ត កំពង់ចាម ក៏ បាន ឲ្យដឹង ដែរ ថា សម្រាប់ កម្លាំង នគរបាល ទូទាំង ខេត្ត កំពង់ចាម ដែល ត្រៀម រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ដំណើរការបោះឆ្នោត នេះ មាន ចំនួន ៤. ០២៨ នាក់ ដោយ មាន ទាំង កម្លាំង ត្រៀម អន្ដរាគមន៍ ២៤ ម៉ោង លើ ២៤ ម៉ោង និង កម្លាំង ដែល រៀបចំ តាម ផែនការ ៕
សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ឧបត្ថម្ភ កម្មវិធី ប្រឡង សំនៀង ជន ពិការ កម្ពុជា ចំនួន ៥០៦ លាន រៀល
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន ឧបត្ថម្ភ ទឹកប្រាក់ ចំនួន ៥០៦ លាន រៀល ដល់ កម្មវិធី ប្រឡង សំនៀង ជន ពិការ កម្ពុជា ពានរង្វាន់ សម្តេច តេជោ ហ៊ុន សែន ។
លិខិត មិត្ត អ្នកអាន៖ ទ្រង់ ស៊ីសុវត្ថិ ធម្មិកោ កំពុង លាង ជម្រះ ខ្លួន ពី ឧបាយកល ទុច្ចរិត អនុវត្ត ផែនការបំផ្លាញ ការបោះឆ្នោត
នៅក្នុង កាសែត ភ្នំពេញ ប៉ុស្តិ៍ ចេញផ្សាយ ថ្ងៃទី ៤ ខែកក្កដា ទ្រង់ ស៊ីសុវត្ថិ ធម្មិកោ បាន ទទួលស្គាល់ ថា មាន ការជួបជុំគ្នា ប៉ុន្តែ គឺ ជួប ជាមួយ ជាមួយ គូ ស្វាមី ពីរ គូ ដែល ទើប រៀបការ ហើយ ទ្រង់ មិន បាន ចូលរួម ។ ប៉ុន្មាន ម៉ោង ក្រោយមក ហ្វេសប៊ុក ឈ្មោះ ស៊ីសុវត្ថិ ធម្មិកោ បាន ប៉ុស្តិ៍ រូប មួយ ជាមួយ ចំណងជើង ថា « ដើម្បី កុំ ឱ្យ ហ្វ្រេសញ៉ូវ មួល បង្កាច់ មុន ជប់លៀង មនុស្ស លើស ពី ៥នាក់ យើង ត្រូវ ដាក់ពាក្យ សុំ ច្បាប់ » ។
រវាង សារ ទាំង ពីរ នេះ គឺ មាន ភាពផ្ទុយ គ្នា ព្រោះ នៅក្នុង រូប នេះ មិន បាន បង្ហាញ ពី យុវជន ដែល ជា គូ ស្វាមី ភរិយា ឡើយ ហើយក៏ មិន បាន បញ្ជាក់ ថា ជំនួប ក្នុង រូប នេះ ធ្វើ នៅ ទីណា ដែរ ។ នេះ គឺជា ការភូតកុហក ទាំងស្រុង របស់ ទ្រង់ ស៊ីសុវត្ថិ ធ ម្មិកោ តែ ប៉ុណ្ណោះ ដើម្បី ដោះ ខ្លួន ចេញ ពី ផែនការបំផ្លាញ ការបោះឆ្នោត និង បំផ្លាញ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ស្រប តាម ផែនការ របស់ មេ ច លនា ឧទ្ទាម ខុស ច្បាប់ និង ចៅហ្វាយ នាយ របស់ ខ្លួន ។
( កំពង់ធំ ) ៖ អភិបាល ខេត្ត កំពង់ធំ លោក សុខ លូ បាន ថ្លែង ថា ប្រជាពលរដ្ឋ ដែល គ្រប់ អាយុ បោះឆ្នោត និង មាន ឈ្មោះ ក្នុង បញ្ជី ឈ្មោះ បោះឆ្នោត សូមអញ្ជើញ ទៅ ចូលរួម បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ឲ្យបាន គ្រប់ ៗ គ្នា ព្រោះ សន្លឹក ឆ្នោត របស់ បងប្អូន មួយ សន្លឹក មាន តម្លៃ ខ្ពស់ ណាស់ សម្រាប់ ជ្រើសរើស មេដឹកនាំ ប្រទេស ឲ្យ មាន សុខ សន្តិភាព និង ការអភិវឌ្ឍ ។
លោក បាន ថ្លែង យ៉ាង ដូច្នេះ ក្នុង ពិធី សំណេះសំណាល ជាមួយ មេ គ្រួសារ នៅ សង្កាត់ ស្រយ៉ូវ ជាង ៣ពាន់ នាក់ ដែល ជា សង្កាត់ ចុងក្រោយ នៃ ក្រុង ស្ទឹង សែន នា ថ្ងៃទី ៤ ខែកក្កដា ឆ្នាំ ២០១៨ ។
ក្នុង ឱកាស នោះ លោក សុខ លូ បាន ផ្តាំផ្ញើ និង ការនឹករលឹក របស់ សម្តេច តេជោ ហ៊ុន សែន ចំពោះ បងប្អូន ប្រជាពលរដ្ឋ នៅ សង្កាត់ ស្រយ៉ូវ ក៏ ដូចជា ទូទាំង ខេត្ត ផងដែរ និង ថ្លែងអំណរគុណ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ដែល បន្ដ គាំទ្រ គណបក្ស ប្រជាជន ។
សូម បញ្ជាក់ ថា មកដល់ ពេលនេះ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន ជួប សំណេះសំណាល ជាមួយ មេ គ្រួសារ ទាំង ៨សង្កាត់ ក្នុង ក្រុង ស្ទឹង សែន សរុប ជាង ១ម៉ឺន នាក់ ហើយ ៕
ក្តៅ គគុក ! យោធា អាហ្វហ្គានីស្ថាន « ផ្តាច់ ជីវិត ក្រុម សកម្ម ប្រយុទ្ធ ១៣២ នាក់ » ក្នុង ការវាយលុក ទាំង ផ្លូវគោក និង ផ្លូវ អាកាស !
( កាប៊ុល) ៖ ជន សកម្ម ប្រយុទ្ធ ប្រមាណ ១៣២ នាក់ បាន បាត់បង់ជីវិត និង ២៨ នាក់ រងរបួស ក្នុង អំឡុង ប្រតិបត្តិការ យោធា ដ៏ ក្តៅ គគុក ទាំង តាម ផ្លូវគោក និង ផ្លូវ អាកាស នៅ ប្រទេស អាហ្វហ្គានីស្ថាន ដែល ប្រព្រឹត្តទៅ តាំងពី ថ្ងៃអង្គារ មក ។ នេះ បើ តាម ការឲ្យដឹង ពី ក្រសួង ការពារ ជាតិ អាហ្វហ្គានីស្ថាន ដកស្រង់ ខ្លឹមសារ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ល្ងាច ថ្ងៃពុធ ទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ ។
យោង តាម សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង ការពារ ជាតិ អាហ្វហ្គានីស្ថាន កងកម្លាំង ជើង គោក របស់ ខ្លួន បាន បើក ប្រតិបត្តិការ យោធា ចំនួន ជិត ១០០ លើក ក្នុង ទ្រង់ទ្រាយ ទាំង តូច ទាំង ធំ នៅ ខេត្ត ចំនួន ១៥ ក្នុង ចំណោម ខេត្ត ទាំង ៣៤ របស់ ប្រទេស អាហ្វហ្គានីស្ថាន ។
ជាមួយគ្នា នេះ កងទ័ព អាកាស អាហ្វហ្គានីស្ថាន ក៏ បាន ចេញ ប្រតិបត្តិការ វាយប្រហារ តាម ផ្លូវ អាកាស ទៅ លើ ក្រុម សកម្ម ប្រយុទ្ធ ក្នុង អំឡុង ពេល ដូចគ្នា ផងដែរ ។ យ៉ាងណាមិញ ពុំ មាន ការបញ្ជាក់ ថា តើ មាន ចំនួន រងគ្រោះ នៅ ខាង កងកម្លាំង សន្តិសុខ ដែរ ឬក៏ អត់ ឡើយ ។
គួរ ជម្រាប ថា យោធា អាហ្វហ្គានីស្ថាន និង កង យោធា ចំរុះ ដឹកនាំ ដោយ អង្គការ NATO និង សហរដ្ឋ អាមេរិក បាន បង្កើន ប្រតិបត្តិការ តាម ផ្លូវគោក និង ផ្លូវ អាកាស ប្រឆាំង នឹង ក្រុម សកម្ម ប្រយុទ្ធ ក្នុង អំឡុង ពេល ប៉ុន្មាន ខែ ចុងក្រោយ នេះ ខណៈ ដែល ក្រុម សកម្ម ប្រយុទ្ធ បាន បើក ការវាយប្រហារ កាន់តែ ញឹកញាប់ ឡើង ៗ នៅ ទូទាំង ប្រទេស ៕ វិទ្យាស្ថាន ជាតិ ពហុ បច្ចេកទេស កម្ពុជា រៀបចំ ពិព័រណ៌ ការងារ លើក ទី២ ដើម្បី លើកកម្ពស់ ការអភិវឌ្ឍ វិស័យ ការងារ
ពិព័រណ៌ ការងារ នេះ ត្រូវបាន បង្កើតឡើង ដើម្បី ចូលរួមចំណែក លើកកម្ពស់ ការអភិវឌ្ឍ វិស័យ ការងារ ការបង្កើន ឱកាស ទទួលបាន ការងារ និង ឱកាស កម្មសិក្សា កាន់តែ ងាយស្រួល សម្រាប់ និស្សិត វិទ្យាស្ថាន ជាតិ ពហុ បច្ចេកទេស កម្ពុជា (NPIC) និង ដើម្បី បង្កើត ឲ្យ មាន ការជួបគ្នា រវាង និស្សិត ក្រុមហ៊ុន និង ដៃគូ ពាក់ព័ន្ធ នានា សំដៅ ចូលរួមចំណែក ផ្សព្វផ្សាយ ពី តម្រូវការ ការងារ ជំនាញ និង កម្លាំង ពលកម្ម នៅ កម្ពុជា ។
ការលើកឡើង បែប នេះ របស់ លោក បណ្ឌិត គីម ហ៊ាង ធ្វើឡើង ក្នុង ឱកាស ដែល លោក អញ្ជើញ ចូលរួម ក្នុង វេទិកា ស្ដីពី « ការធ្វើ អាជីវកម្ម អចលទ្រព្យ ក្នុង ប្រទេស កម្ពុជា ក្នុង ថ្ងៃ អនាគត » នា ព្រឹក ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ ក្នុង មជ្ឈមណ្ឌល សហប្រតិបត្តិការ កម្ពុជា - កូរ៉េ ។
( កំពង់ចាម ) ៖ លោក ឧប នាយក រដ្ឋមន្ដ្រី យឹម ឆៃលី សមាជិក អចិន្ដ្រៃយ៍ គណៈកម្មាធិការ កណ្ដាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ដ កំពង់ចាម បាន ស្នើសុំ ឲ្យ សមាជិក - សមាជិក របស់ គណបក្ស ប្រជាជន កម្ពុជា ទាំងអស់ នៅក្នុង ខេត្ត កំពង់ចាម ត្រូវ ខិតខំ ការពារ សុខ សន្ដិភាព ឲ្យបាន ល្អ ប្រសើរ កុំ ឲ្យ ក្រុម ណា បុគ្គល ណា ឬ គណបក្ស ណា មក បំផ្លាញ ជាដាច់ខាត ។
ការស្នើសុំ យ៉ាង ដូច្នេះ របស់ ឧប នាយក រដ្ឋមន្ដ្រី យឹម ឆៃលី បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ក្នុង ឱកាស លោក អញ្ជើញ ចូលរួម ជា អធិបតីភាព ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ អាគារ ស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ឃុំត្រពាំង គរ ឃុំ ព្រីង ឃុំ ព្រៃ ចារ និង ឃុំ គោក រ វៀង ស្រុក ជើង ព្រៃ ខេត្ត កំពង់ចាម ដែល មាន អ្នកចូលរួម សរុប ប្រមាណ ៤០០ នាក់ ។
ថ្លែង ក្នុង ពិធី នោះ ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ដ កំពង់ចាម បាន ស្នើសុំ ឲ្យ សមាជិក - សមាជិកា គណបក្ស ប្រជាជន ទាំងអស់ ធ្វើ យ៉ាង ម្ដេច ខិតខំ ថែរក្សា សន្ដិភាព ស្ថេរភាព សង្គម មួយ នេះ ឲ្យបាន ល្អ ប្រសើរ កុំ ឲ្យ បុគ្គល ណា ក្រុម ណា បក្សពួក ណា ឬ ក៏ គណបក្ស ណា មក បំផ្លាញ សុខ សន្ដិភាព ប្រទេស កម្ពុជា បាន នោះ ឡើយ ។
ឧប នាយក រដ្ឋមន្ដ្រី យឹម ឆៃលី បាន បញ្ជាក់ ថា សុខ សន្ដិភាព ដែល បាន មកដល់ សព្វ ថ្ងៃ នេះ គឺ បាន មក ពី ជីដូ - ជីតា ឪពុក - ម្ដាយ គណបក្ស ប្រជាជន កម្ពុជា ដែល ខិតខំ ថែរក្សា រហូតមកដល់ សព្វ ថ្ងៃ . ជា រួម គណបក្ស ប្រជាជន កម្ពុជា ត ស៊ូ ខ្លាំង ណាស់ រហូតដល់ យក អាយុជីវិត ដើម្បី បញ្ចប់ សង្គ្រាម ដើម្បី រំដោះ ប្រទេស កម្ពុជា ឲ្យ រួចផុត អំពី របប សង្គ្រាម ជាពិសេស ក្នុង របប ប្រល័យ ពូជសាសន៍ ប៉ុល ពត ។
ជាមួយគ្នា នោះ ឧប នាយក រដ្ឋមន្ដ្រី យឹម ឆៃលី ក៏ បាន ជំរុញ ដល់ សមាជិក - សមាជិកា បក្ស ត្រូវ ពង្រឹង សមត្ថភាព ការងារ ឲ្យ សកម្ម បន្ថែម ទៀត ដើម្បី បំពេញ កាតព្វកិច្ច បម្រើ ប្រជាពលរដ្ឋ ពិសេស ដោះ សា្រយ នូវ បញ្ហា ដែល កើត មាន ឡើង នៅក្នុង ភូមិ - ឃុំ របស់ ខ្លួន ឲ្យ ទាន់ ពេល វេលា ។
ឧប នាយក រដ្ឋមន្ដ្រី យឹម ឆៃលី ក៏ បាន ផ្តាំផ្ញើ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន មក ចូលរួម ទាំងអស់ សូមអញ្ជើញ ចូលរួម ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ខាងមុខ នេះ និង បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ ដើម្បី គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី បន្ត ទៀត ដើម្បី ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍ នេះ ឲ្យបាន យូរអង្វែង សម្រាប់ អនាគត កូន ចៅ យើង បន្ត ទៅ ទៀត ៕
អ្នក ឧកញ៉ា ពង់ ឃាវ សែ នាំយក ថវិកា ៥៥ម៉ឺន ដុល្លារ ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា
ជាមួយនឹង ការផ្សព្វផ្សាយ និង បំផុស ចលនា នេះ សមាគម សម្ព័ន្ធ ខ្មែរ - ចិន នៅ កម្ពុជា បាន ប្រមូល វិភាគទាន សប្បុរ ជន ជូន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សរុប ចំនួន ប្រមាណ ៥៥ម៉ឺន ដុល្លារ សហរដ្ឋ អាមេរិក ក្នុង នោះ មាន ប្រាក់ រៀល ចំនួន ២១៧. ៤៩២. ៨០០ រៀល និង ប្រាក់ ដុល្លារ អាមេរិក ចំនួន ៥០២. ១៨០ ដុល្លារ ។
ការចូលរួម ផ្តល់ វិភាគទាន សប្បុរ ធម៌ នេះ បង្ហាញ ឱ្យ ឃើញ ថា សមាគម សម្ព័ន្ធ ខ្មែរ ចិន នៅ កម្ពុជា បាន ចូលរួម យ៉ាង សកម្ម ក្នុង ការគាំទ្រ គោល នយោបាយ ទ្រទ្រង់ និង ធានា ចិរភាព នៃ ប្រតិបត្តិការ របស់ មន្ទីរពេទ្យ គន្ធ បុប្ជា តាមរយៈ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដែល មាន សម្តេច អតេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ ម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ស្ថាបនិក និង ជា ប្រធាន កិត្តិយស ។
បន្ថែម លើ ការនាំមក នូវ ថវិកា ដែល ជា វិភាគទាន សប្បុរសធម៌ សម្រាប់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា លោក ឧកញ៉ា និង តំណាង សមាគម សម្ព័ន្ធ ខែ្មរ - ចិន នៅ កម្ពុជា ក៏ បាន សំដែង ការកោតស សើរ អំពី ការគិតគូរ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ ហ៊ុន សែន ទាំង ក្នុង ការគាំពារ សុខ មាលភាព កុមារ ក៏ ដូចជា ការដឹកនាំ និង អភិវឌ្ឍ ជាតិ ទាំងមូល និង បាន បញ្ជាក់ ពី ការគាំទ្រ សម្តេច តេជោ ជា នាយក រដ្ឋមន្រ្តី ក្នុង អណ្ណ តិ ក្រោយ ៗ ជាបន្ត ទៀត ។
ក្នុង នាម ប្រធាន ក្រុមប្រឹក្សា បរធន បាល នៃ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ម អគ្គ បណ្ឌិត សភាចារ្យ ទេសរដ្ឋមន្ត្រី អូន ព័ន្ធ មុនីរ័ត្ន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ សមាគម សម្ព័ន្ធ ខ្មែរ ចិន នៅ កម្ពុជា ដែល គាំទ្រ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល និង បាន ជួយ ផ្សព្វផ្សាយ បំផុស ការចូលរួម ផ្តល់ វិភាគទាន សប្បុរ ធម៌ ដល់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា នេះ ដែល សបញ្ជាក់ ពី ការចូលរួម លើកស្ទួយ សុខុមាលភាព របស់ កុមារ ដែល ជា អនាគត របស់ ប្រទេសជាតិ ។
ការប្រកួត រវាង អេស្ប៉ាញ និង រុស្ស៊ី បាន អូសបន្លាយ ពេល ដល់ ១២០ នាទី មុននឹង ឈានដល់ ការទាត់ បាល់ ១១ម៉ែត្រ ម្នាក់ ០៥ គ្រាប់ ។ ក្នុង រយៈពេល ១២០ នាទី ក្រុម ជម្រើសជាតិ អេស្ប៉ាញ បាន គ្រប់គ្រង បាល់ ស្ទើរតែ ទាំងស្រុង ហើយ បញ្ជូន បាល់ ឱ្យ គ្នា ទៅ វិញ ទៅ មក រហូតដល់ ១.០០០ ដង ឯណោះ ។ ប៉ុន្តែ នៅ ចុងបញ្ចប់ បែរជា មក ត្រូវ ចាញ់ រុស្ស៊ី យ៉ាង ចុក ឈាម ដោយ ការកាត់ក្ដី ដោយ ទាត់ បាល់ ១១ម៉ែត្រ ទៅ វិញ ។
២៖ ជ័យជម្នះ នៅ ចុង ម៉ោង
៥៖ ពិភពលោក ស្រឡាំងកាំង ក្រោយ អង់គ្លេស ឈ្នះ ដោយសារ ការ ស៊ុត បាល់ ១១ម៉ែត្រ
ប្រភព៖ ស៊ីន ហួរ
រថភ្លើង ដែល រដ្ឋ មន្រ្តី ស៊ុន ចាន់ថុល និង គណៈប្រតិភូ ធ្វើដំណើរ នៅក្នុង ថ្ងៃ សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ពី ខេត្ត ពោធិ៍សាត់ បាន មកដល់ រាជធានី ភ្នំពេញ នៅ រសៀល ថ្ងៃ នេះ (Video inside) ( ពោធិ៍សាត់ )៖ នៅ រសៀល ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ រថភ្លើង ដែល ដឹក លោក ស៊ុន ចាន់ថុល រដ្ឋមន្រ្តី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង គណៈប្រតិភូ ព្រមទាំង ក្រុមការងារ បាន មកដល់ រាជធានី ភ្នំពេញ ហើយ បន្ទាប់ពី ប្រកាស ដាក់ ឲ្យ ប្រើប្រាស់ កំណាត់ ផ្លូវ ដែក ពី ពោធិ៍សាត់ មកដល់ បាត់ ដឹង និង ពី បាត់ ដឹង មក រាជធានី ភ្នំពេញ ។
ពិធី ដាក់ ឲ្យ ប្រើប្រាស់ ជា បណ្តោះអាសន្ន កំណាត់ ផ្លូវ ដែក ពី ពោធិ៍សាត់ មក បាត់ ដឹង នេះ ធ្វើឡើង ក្រោម អធិបតីភាព លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្រ្តី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។ ពលរដ្ឋ ខ្មែរ នៅ ប្រទេស ស្វីស ប្រឆាំង ការដាក់ទណ្ឌកម្ម លើ រាជ រដ្ឋាភិបាល កម្ពុជា
( ភ្នំពេញ ) ៖ ពលរដ្ឋ ខ្មែរ មួយចំនួន នៅ ប្រទេស ស្វីស បាន ផ្ញើញ ត្តិ មួយ ច្បាប់ ចុះ ថ្ងៃទី ០៣ ខែមិថុនា ឆ្នាំ ២០១៨ ជូន លោក Alain BERSET ប្រធានាធិបតី នៃ សហព័ន្ធ ស្វីស គាំទ្រ ការថែរក្សា សន្តិភាព ស្ថិរភាព និង កិច្ចអភិវឌ្ឍ នៅ កម្ពុជា ហើយ បាន អំពាវនាវ សហព័ន្ធ ស្វីស កុំ ឱ្យ ដាក់ទណ្ឌកម្ម ណាមួយ និង កុំ ឱ្យ គាំទ្រ ការដាក់ទណ្ឌកម្ម ដោយ ប្រទេស ណាមួយ មក លើ រដ្ឋាភិបាល កម្ពុជា ។
ញត្តិ ដែល អត្ថបទ ដើម ជា ភាសា បារាំង ភ្ជាប់ ដោយ ហត្ថលេខា របស់ ពលរដ្ឋ ខ្មែរ មាន ខ្លឹមសារ ទាំងស្រុង ដូច ខាងក្រោម នេះ៖ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ពន្យល់ ក្រុមហ៊ុន ស្មាត អាស្យាតា អំពី លក្ខខន្តិកៈ នៃ ការចុះបញ្ជី ពាណិជ្ជនាម នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ ដើម្បី រួមចំណែក ពង្រឹង ការអនុវត្ត វិស័យ កម្មសិទ្ធិ បញ្ញា ជាតិ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម បាន ពន្យល់ ក្រុមហ៊ុន ស្មាត អាស្យាតា (Smart Axiata) ដែល ជា ប្រតិបត្តិករ ទូរគមនាគមន៍ ចល័ត អំពី ច្បាប់ ស្តីពី ពាណិជ្ជនាម និង លក្ខខណ្ឌ តម្រូវ មួយចំនួន ដើម្បី ទទួលបាន ការចុះបញ្ជី នាមករណ៍ ក្រុមហ៊ុន និង សិទ្ធិ ការពារ ពាណិជ្ជ នាម ស្រប ច្បាប់ នៅក្នុង ប្រទេស កម្ពុជា ។
ការបកស្រាយ របស់ ឯកឧត្តម រដ្ឋមន្ត្រី បាន ធ្វើឡើង នៅក្នុង ជំនួប ពិភាក្សា ជាមួយ លោក ថូម៉ាស ហ៊ុន (Thomas HUNDT) នាយក ប្រតិបត្តិ ក្រុមហ៊ុន Smart នៅ ទីស្តីការ ក្រសួង ពាណិជ្ជកម្ម កាលពី ព្រឹក ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ ដែល បាន ដាក់ពាក្យ សុំ ចុះបញ្ជី ម៉ាក ក្រុមហ៊ុន ស្មាត អាស្យាតា ខូអិលធីឌី និង ការចុះបញ្ជី ជា ម៉ាក ល្បី ។
នៅក្នុង ឱកាស នោះ លោក ប៉ាន សូរស័ក្តិ បាន ជម្រាប លោក ថូម៉ាស ហ៊ុន អំពី ភាពខុសគ្នា រវាង ពាណិជ្ជនាម និង ពាក្យ សាធារណៈ ព្រមទាំង លក្ខខណ្ឌ ចាំបាច់ នៃ ការជ្រើសរើស ឈ្មោះ ដើម្បី ចុះបញ្ជី ពាណិជ្ជនាម ។ ឯកឧត្តម រដ្ឋមន្ត្រី បាន ស្នើ ដល់ លោក នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ស្មាត អាស្យាតា សហការ ជាមួយ នាយកដ្ឋាន កម្មសិទ្ធិ បញ្ញា នៃ ក្រសួង ពាណិជ្ជកម្ម ដើម្បី បំពេញ លក្ខខណ្ឌ ទៅ តាម ច្បាប់ ស្តីពី ពាណិជ្ជនាម និង អំពើ នៃ ការប្រកួតប្រជែង មិន ស្មោះត្រង់ ដែល ជា ផ្នែក មួយ នៃ វិស័យ កម្មសិទ្ធិ បញ្ញា ។
លើស ពី នេះ លោក រដ្ឋមន្ត្រី ក៏ គូសបញ្ជាក់ ពី ការប្តេជ្ញាចិត្ត របស់ ក្រសួង ពាណិជ្ជកម្ម ក្នុង ការគាំទ្រ វិស័យ ឯកជន និង ការលើកកម្ពស់ វិស័យ កម្មសិទ្ធិ បញ្ញា ជាតិ ព្រមទាំង បាន ថ្លែងអំណរគុណ ដល់ លោក ថូ ម៉ាស ហ៊ុន ដែល បាន វិនិយោគ និង ធ្វើ សកម្មភាព សង្គម ជាច្រើន ដើម្បី ចូលរួម អភិវឌ្ឍ ប្រទេស កម្ពុជា ។
ជា ការឆ្លើយតប លោក ថូម៉ាស ហ៊ុន បាន ថ្លែងអំណរគុណ ដល់ ឯកឧត្តម រដ្ឋមន្ត្រី ដែល បាន បកស្រាយ ពី នីតិវិធី និង លក្ខខណ្ឌ តម្រូវ សម្រាប់ ការចុះបញ្ជី ពាណិជ្ជនាម នៅក្នុង ប្រទេស កម្ពុជា ។ លោក នាយក ប្រតិបត្តិ រូប នេះ បាន សន្យា រៀបចំ សំណើ សុំ ចុះបញ្ជី ពាណិជ្ជនាម ក្រុមហ៊ុន ឡើងវិញ ដោយ សហការ ជាមួយ នាយកដ្ឋាន កម្មសិទ្ធិ បញ្ញា និង អនុវត្តន៍ ទៅ តាម លក្ខន្តិកៈ ដែល ច្បាប់ បាន កំណត់ ។
សូម បញ្ជាក់ ថា ពាណិជ្ជនាម សំដៅ លើ ឈ្មោះ ឬ សញ្ញា សម្គាល់ ដែល ប្រើប្រាស់ សម្រាប់ បញ្ជាក់ អត្តសញ្ញាណ និង សម្គាល់ លក្ខណៈ ខុសគ្នា នៃ ក្រុមហ៊ុន ឬ សហគ្រាស នីមួយ ៗ ។ ការប្រើប្រាស់ ពាណិជ្ជនាម នៅក្នុង ប្រទេស កម្ពុជា ត្រូវ គោរព តាម ច្បាប់ ស្តីពី ម៉ាក ពាណិជ្ជនាម និង អំពើ នៃ ការប្រគួត ប្រជែង មិន ស្មោះត្រង់ ដែល រដ្ឋ សភា បាន អនុម័ត និង ដាក់ ឲ្យ ប្រើប្រាស់ កាលពី ថ្ងៃទី ០៦ ខែធ្នូ ឆ្នាំ ២០០១ នៅក្នុង សម័យ ប្រជុំ រដ្ឋសភា លើក ទី៧ នីតិកាល ទី២៕
បំពាក់ ឋានន្ដរស័ក្ដិ និង គ្រឿង ឥស្សរិយយស ប័ណ្ណ សរសើរ ដល់ មន្ដ្រី នគរបាល ចំនួន ៦០ នាក់ នៃ អធិការដ្ឋាន នគរបាល ស្រុក ស្ទោង និង ស្រុក កំពង់ស្វាយ
( កំពង់ធំ ) ៖ នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល អគ្គ ស្នងការ រង និង ជា តំណាង នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ នៅ រសៀល ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន បន្ដ អញ្ជើញ បំពាក់ ឋានន្ដរស័ក្ដិ គ្រឿង ឥស្សរិយយស ប្រគល់ ប័ណ្ណ សរសើរ និង លិខិត សរសើរ ដល់ មន្ដ្រី នគរបាល ជាតិ ចំនួន ៦០ នាក់ ចំណុះ អធិការដ្ឋាន នគរបាល ស្រុក ស្ទោង និង ស្រុក កំពង់ស្វាយ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ធំ ។
បន្ថែម ពី នេះ នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល ក៏ បាន ក្រើន រំលឹក ដល់ កម្លាំង នគរបាល ក្រោម បង្គាប់ ទាំងអស់ ត្រូវ មាន ការប្រុងប្រយ័ត្ន ហើយ ជៀស ឲ្យ ផុត ពី ការដាក់ វិន័យ របស់ ថ្នាក់ លើ ដែល កម្លាំង នគរបាល ធ្វើ កិច្ចការងារ ជាមួយ ប្រជាពលរដ្ឋ ប្រព្រឹត្ត កំហុសឆ្គង ហើយ មាន ការបង្ហោះ តាម បណ្តាញ ព័ត៌មាន សង្គម បង្កឲ្យ ប៉ះពាល់ កិត្តិយស នគរបាល ជាតិ ។
បន្ថែម ពី នេះ នាយ ឧត្តមសេនីយ៍ ប៉ែន វិបុល បាន នាំមក នូវ អំណោយ ជូន មន្ដ្រី នគរបាល ជាតិ នៃ អធិការដ្ឋាន នគរបាល ស្រុក ស្ទោង និង អធិការដ្ឋាន នគរបាល ស្រុក កំពង់ស្វាយ ក្នុង អធិការដ្ឋាន នីមួយ ៗ ទទួលបាន៖ អង្ករ ១០០ គីឡូក្រាម . ទឹកត្រី ៥យួរ . ទឹក ស៊ីអ៊ីវ ៥យួរ . មី៤កេះ . អាវ ភ្លៀង គ្រប់ គ្នា . អាវ ពន្លឺ និង ដំបង ពិល មួយចំនួន និង ថវិកា ៥០០.០០០ រៀល ។
ជូន ប៉ុស្ដិ៍ នគរបាល រដ្ឋបាល ចំនួន ២៤ ប៉ុស្ដិ៍ ( អធិការដ្ឋាន នគរបាល ស្រុក ស្ទោង ចំនួន ១៣ប៉ុស្ដិ៍ និង អធិការដ្ឋាន នគរបាល ស្រុក កំពង់ស្វាយ ចំនួន ១១ប៉ុស្ដិ៍ ) ក្នុង មួយ ប៉ុស្ដិ៍ ទទួលបាន៖ អង្គរ ៥០ គីឡូក្រាម . ទឹកត្រី ១យួរ . ទឹក ស៊ីអ៊ីវ១ យួរ . មី២កេះ . អាវ ភ្លៀង គ្រប់ គ្នា . អាវ ពន្លឺ និង ដំបង ពិល មួយចំនួន និង ថវិកា ១០០.០០០ រៀល ៕
« សប្ដាហ៍ ភាពយន្ត ចិន » ដែល មាន រយៈពេល ៥ ថ្ងៃ នេះ គឺជា ព្រឹត្តិការណ៍ ដ៏ សំខាន់ មួយ ដើម្បី អបអរសាទរ ខួប ឆ្នាំ លើក ទី៦០ នៃ ការបង្កើត ទំនាក់ទំនង ការទូត រវាង កម្ពុជា និង ចិន ក្នុង គោលបំណង ជំរុញ ការផ្លាស់ប្ដូរ និង កិច្ចសហប្រតិបត្តិការ ផ្នែក វប្បធម៌ សិល្បៈ និង ភាពយន្ត រវាង ប្រទេស ទាំង ពីរ ឱ្យ កាន់តែ ស៊ីជម្រៅ ថែម មួយ កម្រិត ទៀត ។
បន្ទាប់ពី កម្មវិធី « សប្ដាហ៍ ភាពយន្ត ចិន » បាន បញ្ចប់ ទៅ ភាពយន្ត ទាំងអស់ នេះ នឹង នាំយក ទៅ ចាក់បញ្ចាំង ជូន ប្រជាជន កម្ពុជា ទស្សនា ដោយ ឥត គិត ថ្លៃ នៅ តាម បណ្ដា ខេត្ត និង តាម តំបន់ ជនបទ នានា នៅក្នុង ប្រទេស កម្ពុជា ដែល មាន ដូចជា ខេត្ត រតនគីរី និង មណ្ឌលគីរី ជាដើម ៕
( ភ្នំពេញ )៖ គណៈប្រតិភូ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ដឹកនាំ ដោយ ឯកឧត្តម បណ្ឌិត គុណ ញឹម អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា បាន អញ្ជើញ ទៅ ចូលរួម សន្និបាត ប្រចាំ ឆ្នាំ លើក ទី ១៣២ របស់ អង្គការ គយ ពិភពលោក ចាប់ពី ថ្ងៃទី ២៨ ដល់ ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០១៨ នៅ ទីក្រុង ព្រុច សែល ប្រទេស បែលហ្សិក ។
អង្គ សន្និបាត បាន ពិភាក្សា ផ្តោត លើ ប្រធានបទ គន្លឹះ មួយចំនួន រួម មាន៖ ១. កិច្ច សម្រួល ពាណិជ្ជកម្ម ដែល ផ្តោត ការអនុវត្ត កិច្ចព្រមព្រៀង សម្រួល ពាណិជ្ជកម្ម របស់ អង្គការ ពាណិជ្ជកម្ម ពិភពលោក ២. ពាណិជ្ជកម្ម តាម អេឡិចត្រូនិច និង ការប្រឈម របស់ រដ្ឋបាល គយ ៣. ការទប់ស្កាត់ ប្រឆាំង ហិរញ្ញប្បទាន ខុស ច្បាប់ ៤. សហប្រតិបត្តិការ រវាង គយ និង ប៉ូលីស ក្នុង ការទប់ស្កាត់ បទល្មើស ឆ្លង ដែន និង ៥. ការកសាង ធនធាន មនុស្ស អភិវឌ្ឍ ស្ថាប័ន និង អភិបាលកិច្ច ។
ទន្ទឹម នេះ អង្គ សន្និបាត ក៏ បាន សា្តប់ របាយការណ៍ និង ពិភាក្សា លើ ការងារ បច្ចេកទេស គយ ដូចជា វិធាន ដើមកំណើត ទំនិញ ការកំណត់ តម្លៃ គិត ពន្ធ គយ និង ការចាត់ ថ្នាក់ ទំនិញ អនុលោម ភាព និង កិច្ច សម្រួល ពាណិជ្ជកម្ម និង ការកសាង សមត្ថភាព ។ នៅក្នុង ចំណោម ឧបករណ៍ សំខាន់ ៗ របស់ WCO អង្គ សន្និបាត ក៏ បាន អនុម័ត ក្របខណ្ឌ ស្តង់ដារ ស្តីពី កាធ្វើ ពាណិជ្ជកម្ម អេឡិចត្រូនិច ឆ្លងកាត់ ព្រំដែន ដើម្បី ជួយ ឲ្យ ប្រទេស ជា សមាជិក អាច អភិវឌ្ឍ យុទ្ធសាស្រ្ត និង ផែនការគ្រប់គ្រង ប្រតិបត្តិការ ពាណិជ្ជកម្ម អេឡិចត្រូនិច ។
គណៈប្រតិភូ នៃ អគ្គ នាយកដ្ឋាន គយ និង រដ្ឋាករ កម្ពុជា ក៏ បាន ឆ្លៀត ក្នុង ឱកាស ប្រជុំ ទ្វេ ភាគី ជាមួយ គណៈប្រតិភូ គយ ថៃ ដែល ដឹកនាំ ដោយ លោក អគ្គ នាយក Kulit Sombatsiri ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ រវាង រដ្ឋបាល គយ ទាំង ពីរ និង ពិភាក្សា ពី លក្ខខណ្ឌ តម្រូវ ដើម្បី ពន្លឿន ការចុះហត្ថលេខា លើ អនុស្សរណៈ យោគយល់ គ្នា ស្តីពី ទំនិញ ឆ្លងកាត់ រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង ព្រះរាជ ណាចក្រ ថៃ ។
ក្រោយពេល សន្និបាត របស់ អង្គការ គយ ពិភពលោក គណៈប្រតិភូ គយ កម្ពុជា បាន បន្ត ដំណើរ ទៅ ចូលរួម សន្និបាត លើក ទី២០ នៃ រដ្ឋបាល គយ ប្រទេស និយាយ ភាសា បារាំង ដែល បាន ប្រព្រឹត្តទៅ ពី ថ្ងៃទី ០២ ដល់ ថ្ងៃទី ០៣ ខែកក្កដា ឆ្នាំ ២០១៨ នៅ ទីក្រុង លីល ប្រទេស បារាំង ។
អង្គ សន្និបាត បាន ពី ភាក្សា លើ ប្រធានបទ ពង្រឹង កិច្ចសហប្រតិបត្ត ការគយ រួម មាន ការផ្លាស់ប្ដូរ និង ចែករំលែក បទពិសោធ និង ការលើកកម្ពស់ ការប្រើប្រាស់ ភាសា បារាំង នៅក្នុង វិស័យ គយ ។ តំណាង គណៈប្រតិភូ គយ កម្ពុជា ក៏ បាន ធ្វើ បទបង្ហាញ ស្តីពី បទពិសោធ និង វឌ្ឍនភាព នៃ កំណែទម្រង់ និង ទំនើបកម្ម ស្ថាប័ន គយ កម្ពុជា ជាពិសេស លើ ការអនុវត្ត ប្រព័ន្ធ អាស៊ី គូដា (ASYCUDA) . E-Customs និង ប្រព័ន្ធ បញ្ជរ តែ មួយ ជាតិ ៕
ចិន ផ្តល់ បទពិសោធន៍ ដល់ កម្ពុជា ទាក់ទង នឹង ការថែរក្សា បរិស្ថាន
( ភ្នំពេញ ) ៖ លោក ZHAO Yingmin អនុ រដ្ឋមន្ត្រី នៃ ក្រសួង អេកូឡូស៊ី និង បរិស្ថាន នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន សន្យា ផ្តល់ បទពិសោធន៍ ដល់ កម្ពុជា ទាក់ទង នឹង ការការពារ បរិស្ថាន ខណៈ បង្កើត ការិយាល័យ រៀបចំ មជ្ឈមណ្ឌល សហប្រតិបត្តិការ បរិស្ថាន រួមគ្នា បន្ថែម ទៀត នោះ ។
លោក សាយ សំអាល់ រដ្ឋមន្ត្រី ក្រសួង បរិស្ថាន ដែល ចូលរួម ជា សក្ខីភាព ក្នុង ពិធី ចុះហត្ថលេខា បាន ថ្លែង ថា ឯកសារ ដែល ចុះ កិច្ចព្រមព្រៀង រួមគ្នា នេះ នឹង កំណត់ ទិសដៅ ច្បាស់លាស់ សម្រាប់ កិច្ច គាំពារ បរិស្ថាន នៅ កម្ពុជា តាមរយៈ ការជួយ បណ្តុះបណ្តាល ដល់ មន្ត្រី កម្ពុជា ដើម្បីឱ្យ មាន សមត្ថភាព ក្នុង អនុវត្ត ការងារ បរិស្ថាន ប្រកបដោយ ប្រសិទ្ធភាព និង ប្រសិទ្ធផល ព្រមទាំង ផ្តល់ នូវ ព័ត៌មាន ជាក់លាក់ មួយ ដែល ធ្វើឱ្យ វិស័យ បរិស្ថាន ឱ្យ កាន់តែ ប្រសើរឡើង ។
ថ្លែង នៅក្នុង ឱកាស នោះ ដែរ លោក សាយ សំអាល់ បាន លើកឡើង ថា កម្ពុជា ស្វាគមន៍ ជានិច្ច ចំពោះ ការផ្តល់ បទពិសោធន៍ របស់ ភាគី ចិន ហើយក៏ អគុណ ដល់ ភាគី ចិន ដែល បាន ជួយ ដល់ កម្ពុជា ក្នុង ការគ្រប់គ្រង លើ វិស័យ បរិស្ថាន នេះ ៕
ឃាត់ខ្លួន ជនសង្ស័យ ប្តី ប្រពន្ធ ពាក់ព័ន្ធ ករណី ជួញដូរ គ្រឿងញៀន នៅ ស្រុក ឆ្លូង
( ក្រចេះ ) ៖ កម្លាំង នគរបាល ស្រុក ឆ្លូង សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ រដ្ឋបាល ឃុំ ដំរី ផុង និង កម្លាំង ប្រជាការពារ ភូមិ ដឹកនាំ ដោយ លោក ឆុង តូរ៉ាន់ អធិការ ស្រុក ឆ្លូង បាន ចុះ ប្រតិបត្តិការ បង្រ្កាប មុខ សញ្ញ ជួញដូរ ថ្នាំ ញៀន និង ឃាត់ បាន ជនសង្ស័យ ពីរ នាក់ ប្តី ប្រពន្ធ និង រឹបអូស វត្តុតាង ថ្នាំ ញៀន ជាច្រើន កាលពី យប់ ថ្ងៃទី ៣ ខែកក្កដា ឆ្នាំ ២០១៨ ម្សិលមិញ នៅ ចំណុច អូដ ង្ហិត ស្ថិត ក្នុង ភូមិ ២៧សែន ជ័យ ឃុំ ដំរី ផុង ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
លោក ឆុង តូរ៉ាន់ បាន ឲ្យដឹង ថា ជនសង្ស័យ ជា ប្តី ប្រពន្ធ ដែល ត្រូវ ឃាត់ខ្លួន រួម មាន៖ ឈ្មោះ ទិត ម៉ាត់ ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ ជនជាតិ ឥស្លាម និង ឈ្មោះ រឿន ស្រី ណា ភេទ ស្រី អាយុ៣០ ឆ្នាំ ជាតិ ខ្មែរ ។ ជនសង្ស័យ ទាំង ពីរ នាក់ ខាងលើ មាន ទីលំនៅ ចំណុច អូរ ដង្ហិត ស្ថិត ក្នុង ភូមិ ២៧សែន ជ័យ ឃុំ ដំរី ផុង ស្រុក ឆ្លូង ខេត្ត ក្រចេះ ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ពីរ នាក់ ប្តី ប្រពន្ធ រួមទាំង វត្ថុតាង ត្រូវបាន កម្លាំង អធិការដ្ឋាន នគរបាល ស្រុក ឆ្លូង កំពុង កសាង សំណុំរឿង បញ្ជូន ទៅ ការិយាល័យ ប្រឆាំង បទល្មើស គ្រឿងញៀន ខេត្ត ដើម្បី បន្ត ចាត់ការ តាម នីតិវិធី ៕ សមាជិក ព្រឹទ្ធសភា ណែនាំឲ្យ មន្ត្រី មូលដ្ឋាន នៅ ខេត្ត កំពង់ធំ ត្រូវ ស្វែងយល់ ពី បញ្ហា ប្រឈម និង ទុក្ខ កង្វល់ របស់ ពលរដ្ឋ ដើម្បី ដោះស្រាយ ឱ្យ បាន ទាន់ ពេលវេលា និង ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់
( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី សមាជិក ព្រឹទ្ធសភា នៅ ព្រឹក ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ បាន ចុះ ជួប សំណេះសំណាល ជាមួយ ប្រជាពលរដ្ឋ នៅ ឃុំ កំពង់ស្វាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ដោយ មាន ការចូលរួម ពី ប្រជាពលរដ្ឋ ប្រមាណ ជាង១.០០០ នាក់ ដែល មកពី ៥ភូមិ ផ្សេង គ្នា ។
លោក ឃឹម ប៊ុន សុង៖ ទោះជា ស្ថិត ក្នុង តម្លៃ ណា ក៏ដោយ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន យើង នឹង ថែរក្សា បាន នូវ សុខ សន្តិភាព ស្ថេរភាព នយោបាយ និង ការអភិវឌ្ឍ
( សៀមរាប ) ៖ លោក ឃឹម ប៊ុន សុង សមាជិក គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន គណកម្មាធិការ នៃ គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត សៀមរាប បាន ថ្លែង ថា ទោះជា ស្ថិត ក្នុង តម្លៃ នៃ លក្ខខណ្ឌ ណា ក៏ដោយ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង ជា ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា កម្ពុជា នឹង ថែរក្សា ការពារ បាន នូវ សុខ សន្តិភាព ស្ថេរភាព នយោបាយ និង ជំរុញ នូវ ការអភិវឌ្ឍ ឲ្យ កាន់តែ មាន ការរីកចម្រើន បន្ថែម ទៀត ។
ថ្លែង របស់ លោក ឃឹម ប៊ុន សុង ត្រូវបាន ធ្វើឡើង នៅ ថ្ងៃទី ០៤ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា សង្កាត់ ស្រង៉ែ ក្រុង សៀមរាប ជាង ២០០ នាក់ ។
លោក ឃឹម ប៊ុន សុង បាន បន្ថែម ទៀត ថា « យើង នឹង មិន អនុញ្ញាតិ ឲ្យ មាន ចលនា បដិវត្ត ពណ៌ ញុះញង់ បង្ករ សង្គ្រាម បំផ្លាញ សន្តិភាព រាំង ខ្ទប់ ដល់ ការអភិវឌ្ឍ ប្រទេសជាតិ នោះ ឡើយ ។ គណបក្ស ប្រជាជន កម្ពុជា ចាប់បដិសន្ធិ ក្នុង បុព្វហេតុ បម្រើ ប្រជាជន និង ប្រទេសជាតិ ហើយ គណបក្ស ប្រជាជន កម្ពុជា បាន ក្លាយជា គណបក្ស ចាស់ទុំ ខាង នយោបាយ មាន បទពិសោធន៍ និង សមត្ថភាព ពេញលេញ ក្នុង ការដឹកនាំ ប្រទេសជាតិ ស្វែងរក និង រក្សា សុខ សន្តិភាព និង ការកសាង អភិវឌ្ឍន៍ ប្រទេសជាតិ » ។
លោក បាន បញ្ជាក់ ទៀត ថា ដើម្បី ថែរក្សា សុខ សន្តិភាព បន្ត និរន្តរភាព នៃ ការអភិវឌ្ឍ ប្រទេសជាតិ សូមឲ្យ ប្រជាពលរដ្ឋ និង អ្នក មាន ឈ្មោះ មាន សិទ្ធិ បោះឆ្នោត សូម ទៅ បោះឆ្នោត ទាំងអស់ គ្នា សម្រាប់ នីតិកាល ទី៦ នា ថ្ងៃទី ២៩ ខែ កក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ កុំបី ខកខាន ឲ្យ សោះ ហើយ កុំ ជឿ នូវ ការ ឃោសនា អកុសល ការញុះ ញុង របស់ ក្រុម ជន អគតិ ក្នុង គោលបំណង បំផ្លាញ សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ នៅ កម្ពុជា ឲ្យ សោះ ។
លោក ឃឹម ប៊ុន សុង ក៏ បាន ជំរុញ ឲ្យ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ដែល នៅ ចៅសង្កាត់ មេភូមិ និង ក្រុមប្រឹក្សា សង្កាត់ ត្រូវ ខិតខំ បម្រើ សេវា សាធារណៈ នៅ តាម មូលដ្ឋាន របស់ ខ្លួន ទាំង សេវា តម្រូវការ សេវា ចាំបាច់ ជាពិសេស លិខិតស្នាម ផ្សេង ៗ ដែល បម្រើ ឲ្យ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ឲ្យបាន ប្រសើរឡើង ថែម ទៀត ។
ក្នុង ឱកាស នោះ ដែរ លោក ក៏ បាន ផ្តល់ ជូន ដល់ សមាជិក សមាជិកា ទាំងអស់ ម្នាក់ ៗ ថវិកា ២ម៉ឺន រៀល ព្រមទាំងអញ្ជើញ ចុះ ត្រួតពិនិត្យ ផ្លូវ កា្រល គ្រួស ក្រហម មួយ ខ្សែ ប្រវែង១.៧៣០ ម៉ែត្រ ដែល សាងសង់ ឡើង ដោយ ក្រុមការងារ ចុះ ជួយ សង្កាត់ ស្រង៉ែ ព្រមទាំង សូមឲ្យ បន្ត ការជួស ជុល បន្ថែម ផ្លូវ ប្រវែង ២០០ ម៉ែត្រ ទៀត ផងដែរ ៕
ព្រឹក ស្អែក នេះ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី នឹង បន្ត ចុះ ពិនិត្យ ព្យាបាល ជំងឺ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ នៅ ស្រុក គិរី វង់ ខេត្ត តាកែវ
( តាកែវ )៖ ក្រុមការងារ គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ចំនួន ១៧១ នាក់ នៅ ព្រឹក ថ្ងៃទី ០៥ ខែកក្កដា ឆ្នាំ ២០១៨ ស្អែក នេះ នឹង ចុះ ពិនិត្យ ព្យាបាល ជំងឺ និង ចែកជូន អំណោយ ថ្នាំ ពេទ្យ ដល់ ប្រជាពលរដ្ឋ ប្រមាណ ជាង ៣ពាន់ នាក់ នៅ វត្ត ពោធិវង្ស លើ ភូមិ ត្រពាំង ស្រង់ ឃុំ ព្រះបាទ ជាន់ ជុំ ស្រុក គិរី វង្ស ខេត្ត តាកែវ ។
ការពិនិត្យ និង ព្យាបាល ជំងឺ ដោយ ឥត គិត ថ្លៃ ជូន ប្រជាពលរដ្ឋ នោះ រួម មាន៖ ជំងឺ ទូទៅ មាន វះកាត់ ខ្នាត តូច ជំងឺ ផ្លូវចិត្ត ជំងឺ ទូទៅ ផ្នែក កុមារ ជំងឺ រោគ ស្ត្រី ជំងឺ ឬ ស ដូង បាត ជំងឺ សួត ក្រពះ ពោះវៀន ជំងឺ ផ្លូវ ដង្ហើម ជំងឺ ប្រដាប់ រំលាយ អាហារ ជំងឺ សើស្បែក ជំងឺ ព្រូន ជំងឺ ស្លេកស្លាំង ជំងឺ សន្លាក់ ឆ្អឹង ជំងឺ រលាក ថ្លើម ជំងឺ កាមរោគ ជំងឺ គ្រុនចាញ់ ជំងឺ គ្រុន ឈាម ជំងឺ ភ្នែក សុខភាព មាត់ ធ្មេញ ជំងឺ ទឹកនោម ផ្អែម ជំងឺ បេះដូង លើស ឈាម ជំងឺ ត្រចៀក ច្រមុះ បំពង់ក រ ជំងឺ តម្រងនោម អេកូសាស្ត្រ ... ។ល ។
( ភ្នំពេញ ) ៖ ដើម្បី ការពារ ផលប្រយោជន៍ អ្នកប្រើប្រាស់ និង ចូលរួម ទប់ស្កាត់ ផល ប៉ះពាល់ ដល់ សុខភាព អ្នកប្រើប្រាស់ តាមរយៈ ចំណីអាហារ នៅ ថ្ងៃទី ៤ ខែកក្ដ ដា ឆ្នាំ ២០១៨ នេះ មន្ត្រី សាខា កាំ កុងត្រូល កំពង់ផែ អន្តរជាតិ ភ្នំពេញ សហការ ជាមួយ មន្ទីរ ពាណិជ្ជកម្ម និង អាជ្ញាធរដែនដី បាន បន្ត ចុះ ពិនិត្យ ផ្សព្វផ្សាយ អំពី គុណភាព និង សុវត្ថិភាព ម្ហូប អាហារ តាម ផ្ទះ ម៉ាត ផ្សារ ច្បារអំពៅ ផ្សារ បន្លែ ច្បារអំពៅ បឋមសិក្សារ ច្បារអំពៅ បឋមសិក្សា វាល ស្បូវ ផ្សារ ព្រែក ឯង ក្នុង ខណ្ឌ ច្បារអំពៅ ។
នៅក្នុង ឱកាស ចុះ ទៅ ពិនិត្យ នំ ចំណី នៅក្នុង សាលា បឋមសិក្សា ច្បារអំពៅ មន្រ្តី កាំ កុងត្រូល ក៏ បាន ណែនាំ អ្នកលក់ដូរ ឲ្យ យល់ដឹង ពី អនាម័យ និង បាន បង្រៀន សិស្ស ឲ្យ ចេះ មើល ពី របៀប ផលិតផល ហួស កាលបរិច្ឆេទ ផងដែរ ។ ជាមួយគ្នា នោះ មន្រ្តី កាំ កុងត្រូល ក៏ បាន ប្រាប់ ពី អាជីវករ ដែល លក់ ភេសជ្ជៈ ដូច ជា៖ ស្ទីង ខារ៉ា បាវ គោ ជល់ ជាដើម ដែល ភេសជ្ជៈ ទាំងនេះ មាន គុណភាព ខ្លាំង សម្រាប់ តែ មនុស្ស ពេញ វ័យ អីចឹង ទេ សូម អាជីវករ ទាំងអស់ នៅ ក្នុង សាលា កុំ លក់ ឲ្យ ក្មេង ៗ ព្រោះ អាច មាន បញ្ហា ប៉ះពាល់ សុខភាព សិស្ស ជាដើម ។
បើ តាម លោក ប៊ុន ចំរើន ប្រធាន សាខា កាំ កុងត្រូល កំពង់ផែ អន្តរជាតិ ភ្នំពេញ បាន ឲ្យដឹង ថា ទោះបី ការចុះអង្កេត ទំនិញ នៅ ផ្សារ ខាងលើ រក មិន ឃើញ មាន ផលិតផល ម្ហូប អាហារ ណាមួយ មាន សារធាតុ គីមី ហាមឃាត់ ក៏ដោយ តែ នេះ ជា សកម្មភាព ប្រចាំ ខែ ប្រចំា ឆ្នាំ របស់ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល នៃ ក្រសួង ពាណិជ្ជកម្ម ដែល បាន ដាក់ចេញ គោលការណ៍ ច្បាស់លាស់ ។
យោង តាម អាជ្ញាធរ គ្រប់គ្រង គ្រោះមហន្តរាយ ឥណ្ឌូណេស៊ី មនុស្ស ៣១ នាក់ ត្រូវបាន គេ អះអាង ថា បាន សា្លប់ . ១៣០ នាក់ ត្រូវបាន ជួយ សង្រ្គោះ និង ០៣ នាក់ ទៀត នៅតែ បន្ត បាត់ខ្លួន នៅឡើយ ក្រោយ សាឡង់ មួយ គ្រឿង ផ្ទុក អ្នកដំណើរ រហូតដល់ទៅ ១៦៤ នាក់ បាន លិច នៅឯ ខេត្ត ស៊ូឡាវេស៊ី (Sulawesi) កាលពី ថ្ងៃអង្គារ ។
ប៉ុន្តែ ភ្លាម ៗ បែប នេះ ពុំ មាន ព័ត៌មាន បញ្ជាក់ អំពី មូលហេតុ នៃ ការលិចសាឡង់ នោះ ឡើយ ដោយ គ្រាន់ ករណី បែប នេះ មិន មែន ទើប កើតឡើង ជា លើក ទី មួយ នោះ ឡើយ នៅក្នុង ឆ្នាំ ២០១៨ នេះ ។ ជាក់ស្ដែង កាលពី ខែ មុន ( មិថុនា ) ក៏ មាន ករណី លិច សាឡង់ ដឹក អ្នកដំណើរ មួយ ផងដែរ នៅ បឹង តូបា ដែល ជា រណ្តៅ ភ្នំ ភ្លើង ជ្រៅ បំផុត របស់ ឥណ្ឌូណេស៊ី បាន បណ្តាលឲ្យ មនុស្ស ប្រមាណ ២០០ នាក់ ស្លាប់ ។
គួរ បញ្ជាក់ ថា ជាទូទៅ មូលហេតុ នៃ សោកនាដកម្ម បែប នេះ ភាគ ច្រើន គឺ បណ្ដាល មកពី ការដឹក លើស ចំណុះ និង ការ មិន គោរព បទដ្ឋាន ដឹកជញ្ជូន ជាដើម ៕ លោក ស្តើង សុខុម៖ គណបក្ស ប្រជាជន កម្ពុជា នឹង នាំ កម្ពុជា ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០
( ព្រៃវែង ) ៖ លោក ស្តើង សុខុម សមាជិក គណៈកម្មាធិការ កណ្តាល គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ស្តីទីក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង បាន ថ្លែង ថា គណបក្ស ប្រជាជន កម្ពុជា មាន មហិច្ឆតា ធ្វើឲ្យ ប្រទេសជាតិ ក្លាយជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នំា ២០៣០ និង ប្រទេស អភិវឌ្ឍ នៅ ឆ្នាំ ២០៥០ ។ ដូចនេះ បោះឆ្នោត ឲ្យ គណបក្ស ប្រជាជន កម្ពុជា នឹង នាំមក នូវ ភាពរីកចម្រើន ថ្កើន ថ្កាន បន្ត ទៀត ។
លោក ស្តើង សុខុម បាន ថ្លែង យ៉ាង ដូច្នេះ ក្នុង ពិធី ជួប សំណេះសំណាល ជាមួយ លោកគ្រូ អ្នកគ្រូ និង លោកគ្រូពេទ្យ អ្នកគ្រូពេទ្យ ជាង ៥០០ នាក់ នៅ ទូទាំង ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង នា ព្រឹក ថ្ងៃទី ៣ ខែកក្កដា នេះ នៅ ទីស្នាក់ការ គណបក្ស ប្រជាជន កម្ពុជា ស្រុក កំចាយ មារ ខេត្ត ព្រៃវែង ។
នៅក្នុង ឱកាស នោះ លោក ស្តើង សុខុម បាន ថ្លែង កោតសរសើរ ចំពោះ ស្មារតី ស្នេហាជាតិ របស់ លោកគ្រូ អ្នកគ្រូ លោកគ្រូពេទ្យ អ្នកគ្រូពេទ្យ ដែល បាន លះបង់ កម្លាំង កាយ ចិត្ត លើ ការបង្ហាត់ បង្រៀន ការផ្ទេរ ចំណេះដឹង ដល់ កូន ចៅ ប្រជាជន ដែល នេះ ជា គុណូបការៈ ដ៏ ថ្លៃថ្លា របស់ គ្រូបង្រៀន នៅ ទូទាំង ប្រទេស ក្នុង ការបណ្តុះបណ្តាល ធនធាន មនុស្ស សម្រាប់ អភិវឌ្ឍន៍ ប្រទេសជាតិ ។
« រាជ រដ្ឋាភិបាល បាន ខិតខំ បង្កើន ថវិកា ជាតិ ទៅ លើ វិស័យ ទាំង ពីរ នេះ តាមរយៈ ការសាងសង់ សាលារៀន អន្តេ វាសិក សម្រាប់ លោកគ្រូ អ្នកគ្រូ សម្រាប់ សិស្ស ព្រមទាំង ពង្រាយ សាលារៀន និង គ្រូ ទៅកាន់ មូលដ្ឋាន ភូមិ ឃុំ ហើយ ប្រាក់ខែ គ្រូបង្រៀន ក៏ ត្រូវបាន តម្លើង ជា បន្តបន្ទាប់ ដែរ ប្រាក់ខែ ទាប បំផុត ជាង ១លាន រៀល នៅ ឆ្នាំ ២០១៨ នេះ គឺ កើនឡើង ពី ៤០ ម៉ឹន រៀល ក្នុង ឆ្នាំ ២០១៣ ។ ដូចគ្នា នេះ គ្រូពេទ្យ ក៏ ត្រូវបាន យកចិត្តទុកដាក់ ដូចគ្នា » ។ លោក ស្តើង សុខុម បញ្ជាក់ បន្ថែម ។
( រតនគិរី ) ៖ ក្នុង ដំណើរ បេសកកម្ម លើក ទី៣ លើ ទឹកដី ស្រុក អូរជុំ ខេត្ត រតនគិរី ក្រុមការងារ មែក សឺដេស និង កំណប់ អាថ៌កំបាំង បាន សង្កេតឃើញ ថា ក្មេង ៗ ទាំង ប្រុស ទាំងស្រី របស់ ជនជាតិ ដើម ភាគ តិច គ្រឹង នៅ ទីនោះ ដូច មិន មាន ម្នាក់ ណា ស្លៀក សម្លៀកបំពាក់ ប្រពៃណី នោះ ឡើយ ខណៈ ឪពុក ម្ដាយ របស់ ពួកគេ ក៏ មិន សូវ ស្លៀក សម្លៀកបំពាក់ ប្រពៃណី ដូច កាលពី មុន ប៉ុន្មាន ដែរ ។
