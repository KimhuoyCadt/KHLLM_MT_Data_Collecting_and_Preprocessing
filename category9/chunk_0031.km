( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី នាយកដ្ឋាន នគរបាល ចរាចរណ៍ និង សណ្ដាប់ធ្នាប់ សាធារណៈ នៃ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ៩លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៧នាក់ . របួស ស្រាល ៣នាក់ និង របួស ធ្ងន់ ៧នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ៩លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន១០ គ្រឿង រថយន្ត តូច២គ្រឿង រថយន្ដ ធុន ធំ ៥គ្រឿង និង អ្នក ថ្មើរជើង ម្នាក់ ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន ល្មើស ល្បឿន . បត់ គ្រោះថ្នាក់ .ប្រជែង និង កត្តា យានយន្ដ ។
លោក Nasheed បាន ដាក់ពាក្យ ប្រកួតប្រជែង នៅក្នុង ការបោះឆ្នោត ប្រធានាធិបតី ប៉ុន្តែ ការជ្រើសរើស ឲ្យ ឈរឈ្មោះ របស់ លោក ត្រូវបាន បដិសេធ ដោយ គណៈកម្មាធិការ បោះឆ្នោត ដោយសារតែ លោក ប្រឈមមុខ នឹង ការចោទប្រកាន់ ពី បទ ពាក់ព័ន្ធ នឹង អំពើ ភេរវកម្ម ។
គណៈកម្មាធិការ បោះឆ្នោត បាន ឲ្យដឹង កាលពី ខែ មុន ថា ជន ណា ដែល ត្រូវបាន ផ្តន្ទាទោស ពី បទ ព្រហ្មទណ្ឌ មិន អាច ចូលរួម ប្រកួតប្រជែង នៅក្នុង ការបោះឆ្នោត ជ្រើសតាំង ប្រធានាធិបតី នោះ ទេ ដោយ បាន ព្រមាន ថា បើ មាន ការបោះឆ្នោត ដូច្នោះ មែន វា នឹង ត្រូវ ចាត់ទុក ជា មោឃៈ ៕
មេ អាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ ផ្សព្វផ្សាយ សភាពការណ៍ ថ្មី ៗ និង ចែក បរិក្ខា យោធា ជូន កងកម្លាំង អាវុធហត្ថ ក្រោម ឱវាទ
( កំពង់ស្ពឺ ) ៖ លោក ឧត្តមសេនីយ៍ ត្រី ជូ សារុន មេបញ្ជាការ កងរាជអាវុធហត្ថ ខេត្ត កំពង់ស្ពឺ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ បាន ប្រជុំ ផ្សព្វផ្សាយ សភាពការណ៍ ថ្មី ៗ និង ចែក បរិក្ខា យោធា ជូន ដល់ នាយ នាយ រង អាវុធហត្ថ ក្រោម ឱវាទ ។
ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក មេបញ្ជាការ រង នាយ រង សេនាធិការដ្ឋាន ប្រធាន - អនុប្រធាន មន្ទីរ ទាំង ៥ នាយ ការិយាល័យ ជំនួយការ កង អនុ សេនា ធំ ថ្មើរជើង ត្រៀម អន្តរាគមន៍ និង កម្លាំង ត្រៀម អន្តរាគមន៍ ជំហាន ២ មេបញ្ជាការ មូលដ្ឋាន កងរាជអាវុធហត្ថ ក្រុង - ស្រុក ស្នាក់ការសន្តិសុខ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ មេបញ្ជាការ បាន ប្រាប់ ឲ្យ កងកម្លាំង ទាំងអស់ ត្រូវ ខិតខំ ប្រឹងប្រែង យកចិត្តទុកដាក់ បំពេញ ភារកិច្ច ជូន អង្គភាព និង យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ សុខ ទុក្ខ ប្រជាពលរដ្ឋ ការពារ សន្តិសុខ សុវត្តិភាព ក្នុង មូលដ្ឋាន ដើម្បី ពង្រឹង គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្តិភាព របស់ រាជ រដ្ឋាភិបាល ។
មេបញ្ជាការ បាន បន្ត ថា ថ្ងៃ នេះ អង្គភាព បាន នាំ សម្ភារ បរិក្ខា យោធា យកមក ចែកជូន រួម មាន៖ ឯកសណ្ឋាន ប្រយុទ្ធ លេខ ៥ ចំនួន ២០០ កំប្លេ. ខ្សែក្រវាត់ ចំនួន ២០០ ខ្សែ និង អាវយឺត ចំនួន ២០០ អាវ ។ សម្ភារ បរិក្ខា ទាំងអស់ នេះ អង្គភាព កងរាជអាវុធហត្ថ ខេត្ត ទទួលបាន មក ពី ការឧបត្ថម្ភ គាំទ្រ ពីសំណាក់ សប្បុរសជន នានា ក្នុង ខេត្ត ៕
អ្នក ស្វែងរក ការងារ ធ្វើ ចាត់ទុក NEA ជា ទិសដៅ សម្រាប់ អ្នក ចង់ ផ្លាស់ប្តូរ ការងារ និង អ្នក ចង់បាន ការងារ ធ្វើ
( ភ្នំពេញ ) ៖ សម្រាប់ វេទិកា ការងារ នៅ ចុង ខែមិថុនា របស់ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដែល បាន រៀបចំឡើង នៅ ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០១៨ យ៉ាងហោចណាស់ មាន អ្នក ជាប់ ការងារ ស្ថាពរ ចំនួន ៤៩ នាក់ ខណៈ មាន អ្នក ជាប់ បឋម ១១៧ នាក់ ក្រុមហ៊ុន ដែល ចូលរួម ក្នុង វេទិកា នោះ មាន ១០ក្រុមហ៊ុន ។
គន្ធា បាន ឲ្យដឹង ដែរ ថា កន្លងមក ខ្លួន ក៏ ធ្លាប់ បម្រើ ការងារ នៅ ផ្សារ ទំនើប មួយ ដោយ មាន តួនាទី ជា អ្នកលក់ ។ គន្ធា បញ្ជាក់ បន្ថែម ថា វេទិកា នេះ ពិតជា ងាយស្រួល ណាស់ សម្រាប់ អ្នក ចង់បាន ការងារ ធ្វើ ព្រោះ យើង អាច ចូល សម្ភាស ជាមួយ ក្រុមហ៊ុន ដែល យើង ស្រឡាញ់ បាន ដោយ សេរី ។
អ្នក ទាំង ពីរ បាន ចាត់ទុក វេទិកា ការងារ របស់ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ ថា បាន រួមចំណែក ជាច្រើន ក្នុង ការនាំយក ឱកាស ការងារ ដល់ សិស្ស និស្សិត ដែល មាន បំណង ចង់ ស្វែងរក ការងារ « វេទិកា នេះ ពិតជា ល្អ ណាស់ បង ព្រោះ បាន ជូយ ដល់ ខ្ញុំ ក៏ ដូចជា អ្នក កំពុង ស្វែងរក ការងារ ធ្វើឲ្យ ឆាប់ ទទួលបាន ការងារ ធ្វើ ពិសេស បាន ជួយ ដល់ សិស្ស និស្សិត ឲ្យបាន ជួប ដោយ ផ្ទាល់ ជាមួយនឹង ក្រុមហ៊ុន » ។
គួរ បញ្ជាក់ ថា គិត ត្រឹម រយៈពេល ៥ខែ ក្នុង ឆ្នាំ ២០១៨ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន រៀបចំ វេទិកា ការងារ នៅ តាម មជ្ឈមណ្ឌល ការងារ ទាំង ១១ ខេត្ត របស់ ខ្លួន បាន ចំនួន ៣៥ លើក ចុះឈ្មោះ អ្នក ស្វែងរក ការងារ ធ្វើ បាន ប្រមាណ ៦៧១៨ នាក់ ក្នុង នោះ មាន អ្នកទទួលបាន ការងារ ធ្វើ តាមរយៈ NEA មាន ចំនួន ២. ៨៣២នាក់ ។
សម្ពោធ សមិទ្ធផល នានា និង បុណ្យ បញ្ចុះ ខណ្ឌ សីមា ព្រះវិហារ វត្ត ចន្ទ បុប្ផា រាម ខេត្ត ស្វាយរៀង . នាយ ឧត្តមសេនីយ៍ សៅ សុខា អំពាវនាវ ពលរដ្ឋ ត្រូវ រួមគ្នា ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍
នាយ ឧត្តមសេនីយ៍ ក៏ បាន ចូលរួម អបអរសាទរ នូវ សមិទ្ធផល ទាំងអស់ ដែល បាន កើតឡើង តាម សទ្ធា ជ្រះថ្លា របស់ ព្រះតេជគុណ ព្រះសង្ឃ គ្រប់ ព្រះអង្គ លោកយាយ លោក តា ពុទ្ធ បរិស័ទ ក៏ ដូចជា សប្បុរសជន ទាំងអស់ ដែល បាន ចូលរួមចំណែក ក្នុង ការកសាង ព្រះវិហារ នេះ ឡើង ទោះបី នៅ ទីណា ក៏ដោយ តែងតែ បាន រួមគ្នា ក្នុង ការកសាង ទាំង វិស័យ អាណាចក្រ និង ពុទ្ធ ចក្រ ។
ហើយ យើង រៀបចំ ពិធី នៅ ថ្ងៃ នេះ គឺ រៀបចំ ដោយ សុខ សន្តិភាព និង ភាពសម្បូរសប្បាយ និង គ្មាន ភិតភ័យ អ្វី ទាំងអស់ នេះ ហើយ ជា ការដឹកនាំ ដ៏ ត្រឹមត្រូវ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ដឹកនាំ ដែល បាន ដឹកនាំ ធ្វើ ការកសាង និង អភិវឌ្ឍន៍ ប្រទេសជាតិ ដូច សព្វ ថ្ងៃ នេះ ហើយ ពី មួយ ថ្ងៃ ទៅ មួយ ថ្ងៃ ជីវភាព រស់ នៅ របស់ ប្រជាជន ក៏ បាន ប្រែ មុខមាត់ គួរឱ្យ កត់សម្គាល់ ផងដែរ ។
នាយ ឧត្តមសេនីយ៍ បាន បន្ត ថា « យើង បាន ឃើញ ទាំងអស់ គ្នា រួច មកហើយ ផ្លូវថ្នល់ សាលារៀន មណ្ឌល សុខភាព រួមទាំង ព្រះវិហារ នេះ និង សមិទ្ធិផល ជាច្រើន រាប់ មិន អស់ គឺ វា មិន អាច កើតឡើង ដោយ ឯកឯង បាទ ទេ ប្រសិន ណា គ្មាន សន្តិភាព និង ស្ថិត ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ គឺ បាន បញ្ចប់ សង្គ្រាម ទាំងស្រុង នៅ ប្រទេស កម្ពុជា » ។
ឆ្លៀត ក្នុង ឱកាស នោះ ផងដែរ នាយ ឧត្តមសេនីយ៍ សៅ សុខា ក៏ បាន អំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ត្រូវ រួមគ្នា ថែរក្សា សុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ និង រួមគ្នា ថែរក្សា នូវ សមិទ្ធផល នានា របស់ រាជ រដ្ឋាភិបាល ដែល បាន ផ្តល់ ជូន ឲ្យបាន គង់វង្ស សម្រាប់ ទុក បន្ត ដល់ កូន ចៅ ជំនាន់ ក្រោយ ៗ ទៀត ។
មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ត្រូវតែ ប្រព្រឹត្ត អំពើ ល្អ និង បម្រើ សេវា សាធារណៈ ឲ្យបាន ល្អ ប្រសើរ ជូន ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន ។ រួមគ្នា ការពារ សន្ដិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ អនុវត្ដ ឱ្យ បាន នូវ គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ស្តីពី ភូមិ - ឃុំ មាន សុវត្ថិភាព ជៀស ឲ្យ ផុត គ្រឿងញៀន មិន ត្រូវ មាន បង តូច បង ធំ និង ក្រុម ក្មេង ទំនើង និង ចូល គោរព ច្បាប់ ចរាចរណ៍ និង មិន ត្រូវ ជឿ តាម ការញុះញង់ របស់ ជន អគតិ មួយ ក្តាប់ តូច ដែល តែងតែ រារាំង ដល់ រាជ រដ្ឋាភិបាល ក្នុង ការអភិវឌ្ឍន៍ ប្រទេសជាតិ ។
បងប្អូន ទាំងអស់ គ្នា ត្រូវ ចូលរួម បោះឆ្នោត ឲ្យបាន គ្រប់គ្រប់ គ្នា ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃអាទិត្យ ទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ នា ពេល ខាងមុខ កុំបី អាក់ ខាន ឡើយ និង ត្រូវ ជ្រើសរើស ថ្នាក់ដឹកនាំ ដែល បាន រួម សុខ រួម ទុក្ខ ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ មិន ចេះ ភូតភរ កុហក បោកប្រាស់ និង មាន សមត្ថភាព គ្រប់គ្រាន់ ក្នុង ការដឹកនាំ ប្រទេស ឆ្ពោះ ទៅរក វឌ្ឍនភាព និង ធានា បាន នូវ សុខ សន្តិភាព ជូន ប្រទេសជាតិ ៕
អភិបាល ខណ្ឌ ឬស្សីកែវ ជម្រុញឲ្យ មន្ត្រី កងកម្លាំងប្រដាប់អាវុធ ពង្រឹង ការពារ សន្តិសុខ ជូន ពលរដ្ឋ អំឡុង ពេល ឃោសនា និង បោះឆ្នោត នៅ ថ្ងៃ ២៩ កក្កដា ខាងមុខ
ក្នុង កិច្ចប្រជុំ ខាង លើ នេះ លោក ជា ពិសី បាន ជម្រុញ ដល់ កងកម្លាំង ទាំង ប៉ូលីស អាវុធហត្ថ ខណ្ឌ និង មន្ត្រី ពាក់ព័ន្ធ ធ្វើ យ៉ាងណា ទប់ស្កាត់ ការពារ ថែរក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ ជូន ប្រជាពលរដ្ឋ ឲ្យបាន រឹងមាំ នៅពេល ឃោសនា និង បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ និតិកាល ទី៦ នៃ រដ្ឋសភា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ ជាពិសេស ចូលរួម សហការ គ្នា ក្នុង ការក្តាប់ សភាពការណ៍ ឲ្យបាន ច្បាស់លាស់ ដើម្បី ងាយស្រួល កំណត់ មុខ សញ្ញា បទល្មើស ងាយស្រួល បង្ក្រាប ឲ្យបាន ទាន់ ពេល វេលា ។
( កំពង់ចាម ) ៖ ក្រោយ ទទួលបាន បទបញ្ជា យ៉ាង ម៉ឺងម៉ាត់ ពី នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ . នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម បាន បើក កិច្ចប្រជុំ ជា លើក ទី៨ ផ្សព្វផ្សាយ ផែនការ ការពារ និង សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សម្រាប់ កិច្ច ដំណើរការ រៀបចំ ការបោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រ នីតិកាល ទី៦ ។
កិច្ចប្រជុំ នេះ ក៏ មាន ការចូលរួម ពី អភិបាល រង ក្រុង កំពង់ចាម . ស្នងការ រង ទទួល ការងារ ផែន សេដ្ឋកិច្ច និង ទទួល ដឹកនាំ ក្រុង កំពង់ចាម . លោក មេបញ្ជាការ សឹក រង ក្រុង . លោក មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ក្រុង លោក អធិការ អធិការ រង ក្រុង លោក ចៅសង្កាត់ លោក នាយ នាយ រង ប៉ុស្តិ៍ ទាំង ៤សង្កាត់ និង កម្លាំង ប្រជាការពារ ។
បើ តាម លោក ឧត្តមសេនីយ៍ ស្នងការ កិច្ចការពារ ការបោះឆ្នោត ទី ១៖ ត្រូវការពារ គ្រប់ គណបក្ស នយោបាយ ដែល មាន សិទ្ធិ ចូលរួម បោះឆ្នោត . ទី ២៖ ការពារ អ្នកសង្កេតការណ៍ ជាតិ អន្ដរជាតិ អង្គការ ក្រៅ រដ្ឋាភិបាល សមាគម ដែល មាន ការអនុញ្ញាតិ ពី គ.ជ. ប. ទី ៣៖ ការពារ វា គ្មិន គណបក្ស នយោបាយ ទី ៤៖ ការពារ ទីស្នាក់ការ របស់ គ.ជ. ប នៅ ខេត្ត នៅ ឃុំ សង្កាត់ និង ការិយាល័យ បោះឆ្នោត និង ការពារ គ្រប់ ការដឹកជញ្ជូន ឯកសារ ដែល ពាក់ព័ន្ធ ដល់ ការបោះឆ្នោត ។
ជាមួយគ្នា នោះ លោក ឧត្តមសេនីយ៍ ស្នងការ បាន ផ្តាំផ្ញើ ដល់ កងកម្លាំង ដែល ជា កម្លាំង របស់ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ប្រជាពលរដ្ឋ គ្រប់ រូប ត្រូវ ត្រៀម ឯកសារ ពាក់ព័ន្ធ ការបោះឆ្នោត ត្រូវតែ ចូលរួម ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា និង ជំរុញ ផ្សព្វផ្សាយ ដល់ ក្រុមគ្រួសារ ឲ្យ ចូលរួម បោះឆ្នោត ព្រោះ ជា កាតព្វកិច្ច របស់ ពលរដ្ឋ ដើម្បី ជ្រើសរើស ថ្នាក់ដឹកនាំ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន សន្តិភាព សុវត្ថិភាព ស្ថេរភាព តាម បែប លទ្ធិ ប្រជាធិបតេយ្យ ។
សូម ជម្រាប ថា ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម បាន ត្រៀម សម្រាប់ រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ សម្រាប់ ដំណើរការបោះឆ្នោត នេះ មាន ចំនួន ៤. ០២៨ នាក់ ដោយ មាន ទាំង កម្លាំង ត្រៀម អន្ដរាគមន៍ ២៤ ម៉ោង លើ ២៤ ម៉ោង និង កម្លាំង ដែល រៀបចំ តាម ផែនការ ៕ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម៖ ខ្មែរ នឹង គាំទ្រ ផលិតផល ខ្មែរ កាន់តែ ច្រើន នៅពេល សហគ្រិន អាច ពង្រឹង គុណភាព ជាមួយ តម្លៃ សមរម្យ
( ក្រុង ព្រៃវែង ) ៖ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម លោក ប៉ាន សូរស័ក្តិ បាន បង្ហាញ ជំនឿ ថា ប្រជាពលរដ្ឋ ខ្មែរ នឹង ងាក មក គាំទ្រ ហើយ ប្រើប្រាស់ ផលិតផល ខ្មែរ កាន់តែ ច្រើន នៅ ពេលណា ដែល ផលិត ករ និង សហគ្រិន ក្នុង ស្រុក អាច ផលិត ទំនិញ ដែល មាន គុណភាព ខ្ពស់ ជាមួយ តម្លៃ សមរម្យ ប្រហាក់ប្រហែល ទំនិញ នាំចូល ពី បរទេស ព្រោះ នេះ គឺជា កត្តា សត្យានុម័ត នៃ ការប្រកួតប្រជែង ទីផ្សារ សេរី ។
លោក រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ ដូច្នោះ នា ឱកាស អញ្ជើញ ជា អធិបតីភាព នៅក្នុង ពិធី បើក ព្រឹត្តិការណ៍ ពិព័រណ៍ ផលិតផល ខ្មែរ នៃ យុទ្ធនាការ ទិញ ផលិតផល ខ្មែរ រដូវកាល ទី៣ ដែល រៀបចំឡើង កាលពី រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នៅក្នុង បរិវេណ អតីត មន្ទីរពេទ្យ យោធា ខាងលិច តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត ព្រៃវែង ក្រោម ការចូលរួម ពី ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ អាជ្ញាធរ ខេត្ត តំណាង អង្គការ អាជីវករ ពាណិជ្ជករ និង និស្សិត ប្រមាណ ៣០០ នាក់ ។
នៅក្នុង ឱកាស នោះ លោក ប៉ាន សូរស័ក្តិ បាន អំពាវនាវ ឲ្យ ផលិត ករ បន្ត ខំប្រឹង អភិវឌ្ឍន៍ គុណភាព ផលិតផល ឲ្យបាន កាន់តែ ប្រសើរ ថែម ទៀត ដោយ ប្រើប្រាស់ គំនិត ច្នៃប្រឌិត ទាំង បច្ចេកទេស ផលិត ការវេច ខ្ចប់ ការដាក់ ម៉ាក និង ការកំណត់ តម្លៃ ព្រមទាំង ធ្វើ យុទ្ធសាស្ត្រ ទីផ្សារ ដើម្បី អាច ប្រកួតប្រជែង ជាមួយ ទំនិញ នាំចូល ពី បរទេស ។
លោក រដ្ឋមន្ត្រី បាន លើក យក បញ្ហា ប្រឈម និង លក្ខខណ្ឌ ដែល កម្ពុជា ត្រូវ បំពេញ ក្រោយ ចូលរួម នៅក្នុង សហគមន៍ សេដ្ឋកិច្ច អាស៊ាន និង បាន ពន្យល់ អង្គ ពិធី អំពី វិធានការណ៍ រយៈពេល ខ្លី ដែល រាជ រដ្ឋាភិបាល កំពុង អនុវត្តន៍ ដូចជា ការយក ពន្ធ និង ការប្រើប្រាស់ ច្បាប់ ឧបាស្រ័យ ពាណិជ្ជកម្ម ដើម្បី ទប់ស្កាត់ ការហូរ ចូល នូវ ប្រភេទ ទំនិញ ដែល អាច បង្ក ផល ប៉ះពាល់ ដល់ សុខ មាលភាព ប្រជាជន និង ហានី ភ័យ ចំពោះ សេដ្ឋកិច្ច កម្ពុជា ។
« សរុប ឲ្យ ខ្លី ! ដើម្បីឲ្យ ផលិតផល ខ្មែរ មាន ទីផ្សារ ខ្ពស់ ទាមទារ ឲ្យ មាន ការចូលរួម ពី គ្រប់ ភាគី ពាក់ព័ន្ធ ជាពិសេស ផលិតករ សហគ្រិន និង ប្រជាជន ខ្មែរ ទាំងអស់ ហើយ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន ក្រសួង ពាណិជ្ជកម្ម ជា សេនាធិការ នឹង នៅតែ បន្ត ស្វែងរក ទីផ្សារ ថ្មី ៗ និង គាំទ្រ វិស័យ ឯកជន ជានិច្ច » លោក ប៉ាន សូរស័ក្តិ បាន គូសបញ្ជាក់ ។
បន្ទាប់ពី ទទួលបាន ជោគជ័យ ចំនួន ២ រដូវកាល ជាប់ គ្នា ក្រសួង ពាណិជ្ជកម្ម បាន ជ្រើសរើស យក រាជធានី - ខេត្ត ចំនួន ៦ ធ្វើជា កន្លែង រៀបចំ យុទ្ធនាការ ទិញ ផលិតផល ខ្មែរ រដូវកាល ទី៣ ដោយ ចាប់ផ្តើម ពី ខេត្ត បន្ទាយមានជ័យ រួច បន្ត ទៅដល់ ខេត្ត កណ្តាល កំពង់ឆ្នាំង ព្រៃវែង កោះ កុង និង បិទ បញ្ចប់ នៅ រាជធានី ភ្នំពេញ ៕
មន្រ្តី នគបាល ការិយាល័យ ប្រឆាំង បទល្មើស សេដ្ឋកិច្ច នៃ ស្នងការដ្ឋាន នគ បាល ខេត្ត ស្វាយរៀង បាន ឲ្យដឹង ថា កាលពី វេលា ម៉ោង ១០៖៣០ នាទី យប់ ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០១៨ មាន ប្រជាពលរដ្ឋ រាយការណ៍ ថា មាន រថយន្ត យីឌុប៥ គ្រឿង ផ្ទុក ទំនិញ ពេញ គ្រប ជិត សង្ស័យ ថា ដឹក ឈើ ប្រណិត ឆ្លង ដែន ទៅ ប្រទេស វៀតណាម ។
ទោះបីជា យ៉ាងណា មហាជន នៅតែ ដាក់ ចម្ងល់ ថា ចាប់ ឃាត់ រថយន្ត បាន តែ ២ គ្រឿង ឯ៣ គ្រឿង ទៀត បាន បើក ចូលទៅ ប្រទេស វៀតណាម បាត់ ស្រមោល តាម ច្រក របៀង ទាំង យប់ ។ បើ ទំនិញ ស្រប ច្បាប់ ហេតុអី បានជា ធ្វើចរាចរណ៍ នៅ ពេល យប់ អាធ្រាត្រ បែប នេះ ។
ស្នងការដ្ឋាន ខេត្ត ស្វាយរៀង៖ កីឡា នាំ នូវ សុខភាព ល្អ និង ប្រែក្លាយ មនុស្ស ម្នាក់ ឲ្យ មាន អនាគត ល្អ !
( ស្វាយរៀង ) ៖ លោក ហូ សុងរចនា ស្នងការ រង នគរបាល ខេត្ត ស្វាយរៀង បាន ថ្លែង ថា កីឡា នាំមក នូវ សុខភាព មាំមួន និង អាច ប្រែក្លាយ ខ្លួន យើង ឲ្យ មាន អនាគត ល្អ ។ ការថ្លែង បែប នេះ បាន ធ្វើឡើង នៅក្នុង ពិធី សំណេះសំណាល ជាមួយ ក្រុម កីឡាករ មកពី ១០ឃុំ នៅ ស្រុក ស្វាយជ្រុំ និង ចែក សម្ភារ កីឡា ចំនួន ៣៦៥ កំប្លេ ស្នើ ២២ ក្រុម នា រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នៅក្នុង ភូមិ ឃួច ឃុំ ក្រោល គោ ។
លោក ហូ សុងចរនា បាន បន្ត ទៀត ថា ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថេរភាព នយោបាយ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ធ្វើឲ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ក្នុង នោះ វិស័យ កីឡា ក៏ មាន ការរីកចម្រើន គួរឲ្យ កត់សម្គាល់ ផងដែរ ។
លោក ហូ សុងរចនា បាន ពាំនាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក ពី លោក ឧត្តមសេនីយ៍ ទោ កឹង ឃ ន ស្នងការ នគរបាល ខេត្ត ជូន ដល់ អង្គ ពិធី និង បាន បញ្ជាក់ ប្រាប់ ប្អូន ៗ ជា កីឡាករ ឲ្យ ខិតខំ រៀនសូត្រ លេង កីឡា ដើម្បី សុខភាព ល្អ ជៀស ឲ្យ ឆ្ងាយ ពី គ្រឿងញៀន ។
លោក ហូ សុងរចនា បាន អំពាវនាវ ឲ្យ ប្អូន ៗ កីឡាករ ទាំងអស់ ថែរក្សា សុខ សន្តិភាព ឲ្យ ស្ថិតស្ថេរ គង់វង្ស ដើម្បី ទទួលបាន សម ទ្ធិផល ថ្មី ៗ បន្ថែម ទៀត ជាពិសេស ប្រជាពលរដ្ឋ និង កីឡាករ ដែល ជា យុវជន ត្រូវ នាំគ្នា ទៅ បោះឆ្នោត នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ឲ្យបាន គ្រប់ ៗ គ្នា គឺ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ដែល មាន លេខរៀង ទី២០ ដើម្បី គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន ធ្វើជា នាយក រដ្ឋមន្រី្ដ នៅ អាណត្តិ ទី៦ និង អាណត្តិ ជា បន្តបន្ទាប់ ទៀត ។
នៅក្នុង ឱកាស នោះ កីឡាករ ពីរ នាក់ បាន បេ្តជ្ញា ខិតខំ រៀនសូត្រ និង លេង កីឡា ដើម្បី អនាគត ភ្លឺស្វាង ជៀស ឆ្ងាយ ពី គ្រឿងញៀន ព្រមទាំង នាំគ្នា ទៅ បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា ផងដែរ ។ បន្ទាប់ពី មាន ការឧបត្ថម្ភ សម្ភារ កីឡា លោក ហូ សុងរចនា ក៏ បាន ចូល បច្ច័យ នូវ ថវិកា មួយ ចំនួន ដល់ កម្មវិធី នេះ ផងដែរ ៕ លោក វង្សី វិស្សុត៖ កម្ពុជា ត្រូវការសហគ្រិន ចំណាន ៗ ច្រើន បន្ថែម ទៀត ដើម្បី សម្រេច ក្លាយជា ប្រទេស ចំណូល ខ្ពស់ នៅ ឆ្នាំ ២០៥០
សិក្ខាសាលា នេះ មាន គោលបំណង ធ្វើ ការពិគ្រោះយោបល់ និង ប្រមូល ធាតុ ចូល ពីសំណាក់ តួអង្គ ពាក់ព័ន្ធ ទាំងអស់ នៅក្នុង ការរៀបចំ និង ការដាក់ ឱ្យ ដំណើរការ អនុវត្ត នូវ « មូលនិធិ លើកកម្ពស់ សហគ្រិន ភាព » ដែល ជា គំនិត ផ្តួចផ្តើម ថ្មី របស់ រាជ រដ្ឋាភិបាល នេះ ឱ្យ ទទួលបាន ជោគជ័យ ហើយ មាន ប្រសិទ្ធភាព និង ស័ក្តិសិទ្ធភាព ខ្ពស់ តាម គោលដៅ ដែល រំពឹងទុក ។
លោក វង្សី វិស្សុត បាន បន្ត ថា យុទ្ធសាស្រ្ត ក្នុង ការអភិវឌ្ឍ សេដ្ឋកិច្ច ក៏ ដូចជា ការសាង ជាតិ របស់ យើង គឺ ត្រូវ បន្ត រក្សា ឱ្យ មាន កំណើន ខ្ពស់ ដើម្បី បង្កើត ទ្រព្យ និង បង្កើត តម្លៃ បន្ថែម ដើម្បី យក ទៅ ធ្វើ ការបែងចែង ឡើងវិញ សម្រាប់ បម្រើ ប្រជាពលរដ្ឋ ឱ្យ កាន់តែ មាន ជីវភាព ធូរធា និង កាន់តែ មាន សមធម៌ ក្នុង សង្គម ហើយ អាច បន្ត ទ្រទ្រង់ កំណើន បាន យូរអង្វែង ថែម ទៀត ។ ក៏ប៉ុន្តែ ក្បាល ម៉ាស៊ីន អូស កំណើន សេដ្ឋកិច្ច សព្វ ថ្ងៃ នេះ ចាប់ផ្តើម ថមថយ កម្លាំង ថាមពល ដែល ទាមទារ ឱ្យ យើង ត្រូវ មាន ការគិតគូរ ឡើងវិញ ។
សិក្ខាសាលា ពិគ្រោះយោបល់ នេះ ក៏ មាន ការរៀបចំ ឱ្យ មាន វគ្គ ពិភាក្សា និង សំណួរ ចម្លើយ យ៉ាង ផុល ផុស ប្រកបដោយ គុណភាព និង មាន លក្ខណៈ ស៊ីជម្រៅ ៕ ប៉ៃលិន ពី សមរភូមិ ចុងក្រោយ ក្លាយជា តំបន់ អភិវឌ្ឍ ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ សម្តេច តេជោ
( ប៉ៃលិន ) ៖ ខេត្ត ប៉ៃលិន គឺជា ខេត្ត មួយ នៅក្នុង ប្រទេស កម្ពុជា ក្នុង ចំណោម រាជធានី / ខេត្ត ទាំង២៥ ដែល ជា ខេត្ត ស្ថិត នៅ ទិស ពាយ័ព្យ នៃ ប្រទេស ដែល មាន ចម្ងាយ ពី រាជធានី ភ្នំពេញ ប្រវែង ៣៧១ គីឡូម៉ែត្រ និង ពី ខេត្ត បាត់ដំបង មាន ប្រវែង ៨៤ គីឡូម៉ែត្រ ។ ផ្លូវ ជាតិ ដែល ធ្វើដំណើរ ពី រាជធានី ភ្នំពេញ ទៅកាន់ ខេត្ត ប៉ៃលិន មាន ២ខ្សែ គឺ ខ្សែ ផ្លូវ ជាតិ លេខ ៥ មកដល់ ខេត្ត បាត់ដំបង និង ពី ខេត្ត បាត់ដំបង មកកាន់ មកកាន់ ខេត្ត ប៉ៃលិន គឺ ខ្សែ ផ្លូវ ជាតិ លេខ ៥៧ ។
ដោយសារ មាន កិច្ច ខិតខំ ប្រឹងប្រែង ពី សម្តេច តេជោ ហ៊ុន សែន ដែល លោក បាន ដាក់ចេញ នូវ គោល នយោបាយ ឈ្នះ - ឈ្នះ ដោយ យក អាយុជីវិត ធ្វើជា ដើមទុន ក្នុង ការបញ្ចប់ សង្រ្គាម ដែល ចាប់ផ្តើម នៅ ឆ្នាំ ១៩៩៦ និង ទទួលបាន ជោគជ័យ ទាំងស្រុង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ១៩៩៨ ដែល ធ្វើឱ្យ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ និន្នាការ ចូលមក រួមរស់ ក្នុង សង្គមជាតិ ខ្មែរ តែ មួយ ស្ថិត ក្រោម ច្បាប់ រដ្ឋធម្មនុញ ។
ក្រោយពី តំបន់ ប៉ៃលិន ទទួលបាន សុខ សន្តិភាព ពេញលេញ ក្រោម នយោបាយ ឈ្នះ - ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា តំបន់ នេះ ដែល ពីមុន ជា ចំណែក មួយ នៃ ខេត្ត បាត់ដំបង ត្រូវបាន ត្រូវបាន បង្កើត ជា ក្រុង ប៉ៃលិន ។ ទន្ទឹម នេះ ខេត្ត ប៉ៃលិន ក៏ មាន តំបន់ រម្មណីយដ្ឋាន ទេសចរណ៍ វប្បធម៌ ប្រត្តិសាស្ត្រ ភ្នំ យ៉ាត និង រម្មណីយដ្ឋាន បែប ធម្មជាតិ ជាច្រើន កន្លែង ទៀត ដែល បាន ទាក់ទាញ ភ្ញៀវ ទេសចរណ៍ ជាតិ អន្តរជាតិ មក លេង កំសាន្ត ជារៀងរាល់ ឆ្នាំ ។
គិត មកដល់ ឆ្នាំ ២០១៨ នៃ រាជ រដ្ឋាភិបាន អាណត្តិ ទី៥ នៃ រដ្ឋសភា ខេត្ត ប៉ៃលិន ទទួលបាន សុខ សន្តិភាព ពេញលេញ មាន រយៈពេល ២០ និង ទទួលបាន ការអភិវឌ្ឍន៍ ដូច បណ្តា រាជធានី ខេត្ត ទូទាំង ប្រទេស ក្នុង នោះ វិស័យ អាទិភាព ទាំង៤ ដែល សម្តេច តេជោ ហ៊ុន សែន បាន ដាក់ចេញ ក្នុង អំឡុង ទស្សវត្យ ឆ្នាំ ៨០ ក៏ ស្ថិត នៅ ជា អាទិភាព មកដល់ បច្ចុប្បន្ន គឺ « ទឹក ភ្លើង ផ្លូវ មនុស្ស »៕
សូម ទស្សនា វិដេអូបទ យក ការណ៍ ស្តីពី វឌ្ឍនភាព នៅ ខេត្ត ប៉ៃលិន រយៈពេល ៥ឆ្នាំ មក នេះ៖
យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែមិថុនា លទ្ធផល៖ បង្ក្រាប ២៨ ករណី ឃាត់ខ្លួន ៥៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រា ប៖
( ភ្នំពេញ ) ៖ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ សហការ ជាមួយ នគរបាល រាជធានី ភ្នំពេញ និង កម្លាំង នគរបាល ខេត្ត ព្រៃវែង បាន នាំ ខ្លួន ឃាត ករ ប្តី ប្រពន្ធ ២នាក់ មក ចង្អុលបង្ហាញ និង ធ្វើត្រាប់ ពី ទីកន្លែង ដែល ពួកគេ វាយ សម្លាប់ នារី អ្នករកស៊ី រាប់ លុយ ម្នាក់ ហើយ យក សព មក ទម្លាក់ ចោល ក្នុង ប្រឡាយ ទឹក ស្អុយ ស្ថិត នៅ ផ្លូវ ៣៧១ ភូមិ អូបែក ក្អម សង្កាត់ អូបែក ក្អម ខណ្ឌ សែនសុខ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ។
លោក ជា វ វិបុល បាន បញ្ជាក់ ថា ជនរងគ្រោះ ក្នុង អំពើ ឃាតកម្ម នេះ មាន ឈ្មោះ ខ្នើយ សឹង អាយុ ៣១ ឆ្នាំ ស្នាក់ នៅ ភូមិ ទ្រា២ សង្កាត់ ស្ទឹងមានជ័យ១ ខណ្ឌ មានជ័យ ។ ដោយឡែក ជន ដៃ ដល់ រួម មាន៖
បើ តាម លោក ជា វ វិបុល មុន ឈានដល់ ប្រតិបត្តិការ ចាប់ ជនសង្ស័យ ទាំង ៣នាក់ នេះ នាយកដ្ឋាន ព្រហ្មទណ្ឌ បាន ទទួល ពាក្យបណ្ដឹង ពី បងប្អូន របស់ ជនរងគ្រោះ ដោយ អះអាង ថា មាន ការបាត់ សមាជិក ក្រុមគ្រួសារ រយៈពេល ១០ ថ្ងៃ មិន ឃើញ ។ បន្ទាប់ពី ទទួលបាន ពាក្យបណ្តឹង នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក្រសួង មហាផ្ទៃ បាន បើក ការស្រាវជ្រាវ រហូត កំណត់ មុខ សញ្ញា បាន និង ឈានដល់ ការចាប់ខ្លួន ជន ដៃ ដល់ ទាំង៣ នាក់ តែម្តង ដោយ មាន កិច្ចសហការ ជាមួយ នគរបាល រាជធានី ភ្នំពេញ និង នគរបាល ខេត្ត ព្រៃវែង ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង៣នាក់ ខាងលើ ត្រូវបាន កម្លាំង នគរបាល ជំនាញ កសាង សំណុំរឿង ដើម្បី បញ្ជូន ទៅ សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម ច្បាប់ ៕
លោក វេង សាខុន បន្ត ចុះ ជួប សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ជាង ១ពាក់ នាក់ នៅ ស្រុក កំពង់សៀម និង អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ទៅ បោះឆ្នោត ទាំងអស់ គ្នា
( កំពង់ចាម ) ៖ លោក វេង សាខុន សមាជិក គណៈកម្មាធិការ កណ្តាល នៃ គណបក្ស ប្រជាជន កម្ពុជា និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ស្រុក តំបែរ និង ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម នា រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ជួប សំណេះសំណាល សួរសុខទុក្ខ បងប្អូន ប្រជាពលរដ្ឋ ក្នុង ឃុំ វិហារ ធំ ស្រុក កំពង់សៀម ខេត្ត កំពង់ចាម ប្រមាណ ជាង ១ ពាន់ នាក់ ។
ក្នុង ឱកាស ជួប សំណេះសំណាល នោះ លោក វេង សា ខុន បាន ជម្រាប ជូន ពលរដ្ឋ ពី ដំណើរការ រីកចំរើន របស់ កម្ពុជា ជា ជំហាន ៗ ទាំង វិស័យ ពុទ្ធ ចក្រ និង អាណាចក្រ ក្រោម ការដឹង នាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្នុង រយៈពេល ជាង ២០ ឆ្នាំ បន្ទាប់ពី ប្រទេសជាតិ ត្រូវបាន រំដោះ ចេញ ពី សង្រ្គាម ខណៈ បច្ច ប្បន្ន នេះ ប្រទេសជាតិ មាន សុខ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ ស្ទើ គ្រប់ វិស័យ ។
លោក បាន បញ្ជាក់ ទៀត ថា ដើម្បី លើកកម្ពស់ កម្រិត ជីវភាព របស់ ប្រជាពលរដ្ឋ ឲ្យ កាន់តែ ប្រសើរ ថែម ទៀត ឆ្លើយតប ទៅ តាម កំណើន សេដ្ឋកិច្ច ជាតិ រាជ រដ្ឋាភិបាល បាន ខិតខំ យកចិត្តទុកដាក់ អភិវឌ្ឍ លើ គ្រប់ វិស័យ ដូចជា ហេដ្ឋារចនាសម្ព័ន្ធ សង្គម សេដ្ឋកិច្ច ទេសចរណ៍ កសិកម្ម គមនាគមន៍ អប់រំ សុខាភិបាល ។ល ។
សូម បញ្ជាក់ ថា ដើម្បី សម្រួល ដល់ ជីវភាព របស់ ពលរដ្ឋ កម្ពុជា រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ នូវ គោល នយោបាយ គាំពារ សង្គម កាត់បន្ថយ សេវា សាធារណៈ ការធ្វើ លិខិត បញ្ជាក់ អត្រា នុគោលដ្ឋាន ឥត គិត ថ្លៃ បញ្ចុះ តម្លៃ អគ្គិសនី ពន្ធ ប្រេង ឥន្ទនៈ ឧបត្ថម្ភ ស្រី មាន ផ្ទៃពោះ ដែល មាន ជីវភាព ក្រីក្រ និង ដំឡើង ប្រាក់ បៀវត្ស ជូន កម្មករ កម្មការ នី មន្រ្តី រាជការ និង កង កំលាំងប្រដាប់អាវុធ គ្រប់ លំដាប់ថ្នាក់ ជារៀងរាល់ ឆ្នាំ ក្នុង បំណង ប្រែក្លាយ កម្ពុជា ឲ្យ ទៅជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នា ឆ្នាំ ២០៣០ ។
( មណ្ឌលគិរី ) ៖ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី បាន ស្នើរ ដល់ ម្ចាស់ ទីតាំង កំសាន្ត ម្ចាស់ ផ្ទះសំណាក់ និង សណ្ឋាគារ ចូលរួម សហការផ្តល់ ព័ត៌មាន សំងាត់ ទាក់ទង ករណី ជួញដូរ និង ប្រើប្រាស់ គ្រឿញៀន ជូន សមត្ថកិច្ច ដើម្បី ធ្វើ ការទប់ស្កាត់ បង្រ្កាប និង លុបបំបាត់ ព្រោះ ឥទ្ធិពល នៃ ថ្នាំ ញៀន វា ធ្វើឱ្យ ខូច សុខភាព ខាតបង់ ទ្រព្យសម្បត្តិ កើតមាន វិបត្តិ ក្នុង គ្រួសារ អំពើហិង្សា អំពើ ចោរកម្ម ផ្សេង ៗ និង បង្ក ភាពវឹកវរ ដល់ សង្គមជាតិ ទៀតផង ។
ជាមួយគ្នា នេះ លោក ឡោ សុខា ស្នងការ ខេត្ត មណ្ឌលគិរី ថ្លែង ប្រាប់ Fresh News ប្រចាំ ខេត្ត មណ្ឌលគិរី នៅ រសៀល ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ថា ដោយ មាន ការសហការ ល្អ ជួយ ផ្តល់ ព័ត៌មាន ពី ម្ចាស់ ក្លឹប កំសាន្ត . ខារ៉ាអូរ ខេ. ផ្ទះសំណាក់ . សណ្ឋាគារ និង ទីតាំង ផ្សេង ៗ ទៀត ធ្វើឱ្យ កងកម្លាំង សមត្ថកិច្ច នគរបាល ខេត្ត - ក្រុង នៅ ខេត្ត មណ្ឌលគិរី ងាយស្រួល ក្នុង ការបង្រ្កាប ប្រកបដោយ ជោគជ័យ ។
ជាមួយគ្នា នេះ លោក ឡោ សុខា បាន បន្ត ថា មាន ម្ចាស់ ទីតាំង ចំនួន ២កន្លែង នៅក្នុង ក្រុង សែនមនោរម្យ មាន ទីតាំង ខារ៉ាអូរ ខេ យីហោ « ដៃ ៨» មាន ទីតាំង ក្បែរ ជើង ភ្នំ ដោះ ក្រមុំ និង ផ្ទះសំណាក់ យីហោ « ភ្នំ មាស » បាន សហការផ្តល់ ព័ត៌មាន ដល់ សមត្ថកិច្ច ធ្វើឱ្យ សមត្ថកិច្ច ឈាន ទៅ បង្រ្កាប និង ឃាត់ខ្លួន ជនសង្ស័យ ជួញដូរ សារធាតុ ញៀន បាន ចំនួន ៣នាក់ ក្នុង នោះ ស្រី ម្នាក់ រួមទាំង សារធាតុ សង្ស័យ ថ្នាំ ញៀន ៩កញ្ចប់ តូច និង ៤កញ្ចប់ ធំ ។
លោក ស្នងការ ខេត្ត បាន បន្ថែម ទៀត ថា ប៉ុន្មាន ថ្ងៃ មក នេះ សមត្ថកិច្ច នគរបាល បាន ធ្វើ ការ បង្រ្កាប និង ឃាត់ខ្លួន ជនសង្ស័យ ជាប់ពាក់ព័ន្ធ ថ្នាំ ញៀន រួម និង វត្ថុតាង បានជាច្រើន ករណី ។
លោក កាន់ ពេញ អធិការ ក្រុង សែនមនោរម្យ បាន ឱ្យដឹង ថា ជនសង្ស័យ ទាំង ៣នាក់ ខាងលើ ដែល នគរបាល ធ្វើ ការឃាត់ខ្លួន បាន ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នៅ ទីតាំង ខាងលើ ករណី ថ្នាំ ញៀន ទី១៖ ឈ្មោះ ពេជ្រ រ៉ាលីន ភេទ ប្រុស អាយុ ៣១ ឆ្នាំ ទី២៖ ឈ្មោះ គា ស៊ីម ភេទ ប្រុស អាយុ ៣៣ ឆ្នាំ និង ទី៣៖ ឈ្មោះ ម៉ម លី ភេទ ស្រី អាយុ ៣១ ឆ្នាំ ពួកគេ ទាំង ៣នាក់ ស្នាក់ នៅ បណ្តោះអាសន្ន ក្នុង ក្រុង សែនមនោរម្យ ខេត្ត មណ្ឌលគិរី ។
លោក អធិការ ឱ្យដឹង ថា នៅ រសៀល ថ្ងៃ នេះ ជនសង្ស័យ ទាំង ៣នាក់ រួម និង វត្ថុតាង បញ្ជូន ទៅ កាន់ ការិយាល័យ ជំនាញ ស្នងការ ខេត្ត ដើម្បី ចាត់ការ បន្ត តាម និតិវិធី ៕ គ.ជ. ប ចាប់ផ្តើម ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ រហូតដល់ ថ្ងៃទី ៥ ខែកក្កដា នៅ គណៈកម្មការ ឃុំ - សង្កាត់ រៀបចំ ការបោះឆ្នោត
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ហៅ កាត់ គ.ជ. ប បាន ចាប់ផ្តើម ចុះឈ្មោះ ភ្នាក់ងារ គណបក្ស នយោបាយ ចាប់ពី ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ រហូតដល់ ថ្ងៃទី ៥ ខែកក្កដា ឆ្នាំ ២០១៨ នៅ គណៈកម្មការ ឃុំ - សង្កាត់ រៀបចំ ការបោះឆ្នោត ។ នេះ បើ តាម ការបញ្ជាក់ របស់ មន្រ្តី គ.ជ. ប នៅ រសៀល ថ្ងៃទី ២៩ ខែមិថុនា នេះ ។
គ្រប់ គណបក្ស មាន សិទ្ធ ដាក់ ភ្នាក់ងារ ពេញ សិទ្ធិ ម្នាក់ និង បម្រុង ម្នាក់ របស់ ខ្លួន នៅ គ្រប់ ការិយាល័យ បោះឆ្នោត ទូទាំង ២២៩៦៧ មណ្ឌល នៅ ទូទាំង ប្រទេស កម្ពុជា ។
ការចុះបញ្ជី ភ្នាក់ងារ គណបក្ស គ.ជ. ប តម្រូវ ឱ្យ មាន ឯកសារភ្ជាប់ ជាមួយ ដូច ខាងក្រោម៖
* ភ្នាក់ងារ គណបក្ស នយោបាយ ដែល មាន ឈ្មោះ បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ត្រី នីតិកាល ទី៦
* ភ្នាក់ងារ គណបក្ស នយោបាយ មាន លិខិត បញ្ជាក់ ដោយ ប្រធាន គណបក្ស ឬ តំណាង គណបក្ស ៕
យុវជន ម្នាក់ ជិះ ម៉ូតូ ជែង រថយន្ត រេ ចង្កូត ទៅ បុក រថយន្ត ដឹក ដី បណ្តាលឲ្យ ស្លាប់ នៅ ស្រុក ថ្មគោល ខេត្ត បាត់ដំបង
សមត្ថកិច្ច បាន បញ្ជាក់ បន្ថែម ថា មុនពេល កើត ហេតុ មាន ម៉ូតូ មួយ គ្រឿង បើកបរ ពី ជើង ទៅ ត្បូង ។ លុះ ដល់ ចំណុច កើត ហេតុ ម៉ូតូ បាន ជែង រថយន្ត តូរីស មួយ គ្រឿង រួច បាន រេ ដៃ ចង្កូត ទៅ បុក រថយន្ត ដឹក ដី ដែល កំពុង បើក ចញ្រ្ចាស ទិស គ្នា បណ្ដាលឲ្យ ស្លាប់ នៅ កន្លែង កើត ហេតុ ។
បច្ចុប្បន្ន រថយន្ត និង ម៉ូតូ ត្រូវបាន សមត្ថកិច្ច អូស យកមក រក្សាទុក នៅ អធិការដ្ឋាន នគរបាល ស្រុក ថ្មគោល ចំណែក សាកសព ត្រូវ ក្រុមគ្រួសារ យក ធ្វើ បុណ្យ តាម ប្រពៃណី ៕ ចាប់ ជនសង្ស័យ ម្នាក់ ដកហូត គ្រឿងញៀន ICE ២ថង់ ធំ ស្មើ ៩៨៨ .៦ក្រាម និង ថ្នាំ ញៀន WY ៤.០៣៥ គ្រាប់ នៅ ក្រុង ប៉ោយប៉ែត
( បន្ទាយមានជ័យ )៖ កាលពី យប់ ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០១៨ វេលា ម៉ោង ១៩៖ ២០នាទី កម្លាំង ការិយាល័យ បទល្មើស គ្រឿងញៀន សហការ ជាមួយ កម្លាំង អាវុធហត្ថ ក្រុង ប៉ោយប៉ែត ដឹកនាំ ដោយ លោក វរសេនីយ៍ ឯក ស ប៊ុន សឿង មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត បាន ចុះ ប្រតិបត្តិការ បង្រ្កាប ករណី ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន និង ឃាត់ខ្លួន ជនសង្ស័យ បាន ម្នាក់ នៅ ចំណុច រង្វង់ មូល ប៉ោយប៉ែត ស្ថិត ក្នុង ភូមិ ក្បាល ស្ពាន ១ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ។
លោក ឧត្តមសេនីយ៍ ត្រី បោន ប៊ិន មេបញ្ជាការ អាវុធហត្ថ ខេត្ត បាន ឲ្យដឹង នា រសៀ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ថា ក្រោយ ទទួលបាន ព័ត៌មាន ពី បណ្តាញ ផ្តល់ ព័ត៌មាន លោក បាន ទទួល ការអនុញ្ញាត ពី លោក មាស ច័ន្ទ ពិសិដ្ឋ ព្រះរាជអាជ្ញា អម សាលាដំបូង ខេត្ត និង បាន ដឹកនាំ កម្លាំង ដោយ សហការ ជាមួយ កម្លាំង អាវុធហត្ថ ក្រុង ប៉ោយប៉ែត ចុះ ប្រតិបត្តិការ បង្រ្កាប ករណី ខាងលើ រហូត ឈានដល់ ការឃាត់ខ្លួន ជនសង្ស័យ បាន ម្នាក់ ។
ជនសង្ស័យ ឈ្មោះ អ៊ឹម ច យ ( ហៅ ចិត្រ ) ភេទ ប្រុស អាយុ ៤០ ឆ្នាំ ជនជាតិ ខ្មែរ មុខរបរ មិន ពិតប្រាកដ បច្ចុប្បន្ន ស្នាក់ នៅ បណ្តោះអាសន្ន ក្នុង បន្ទប់ ជួល ស្ថិត នៅ ភូមិ ក្បាល ស្ពាន ១ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
បើ តាម សមត្ថកិច្ច យោង តាម ចម្លើយ សារភាព របស់ ជនសង្ស័យ និង ការធ្វើតេស្ត លើ សារធាតុ ញៀន អាច បញ្ជាក់ ថា ជនសង្ស័យ ខាងលើ ពិតជា បាន ប្រព្រឹត្ត បទល្មើស ជួញដូរ ដោយ ខុស ច្បាប់ នូវ សារធាតុ ញៀន ។ កម្លាំង ជំនាញ កងរាជអាវុធហត្ថ ខេត្ត បាន កសាង សំណុំរឿង បញ្ជូន ជនសង្ស័យ រួម ជាមួយ វត្ថុតាង ទៅ តុលាការ ដើម្បី ចាត់ការ ទៅតាម នីតិវិធី ៕
តុលាការ ចេញ ដីកា ឃុំ ខ្លួន ជនសង្ស័យ ៥នាក់ ពាក់ព័ន្ធ បទល្មើស ជួល ស្រ្តី ខ្មែរ ឲ្យ ព ពោះ ជំនួស
( ភ្នំពេញ ) ៖ លោក កោ វណ្ឌី អនុប្រធាន និង ជា ចៅក្រម ស៊ើបសួរ នៃ សាលាដំបូង រាជធានី ភ្នំពេញ បាន សម្រេច ចេញ ដីកា ឲ្យ ឃុំ ខ្លួន ជា បណ្តោះអាសន្ន ក្រុម ជនសង្ស័យ ចំនួន ០៥ នាក់ ដែល ពាក់ព័ន្ធ បទល្មើស ជួល ស្រ្តី ខ្មែរ ឲ្យ ព ពោះ ជំនួស ។ ការចេញ ដីកា សម្រេច ឲ្យ ឃុំ ខ្លួន នេះ ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០១៨ ។
លោក លី សុផាន់ ណា អ្នកនាំពាក្យ សាលាដំបូង រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ជនសង្ស័យ ទាំង ៥នាក់ ត្រូវបាន អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ សម្រេច ចោទប្រកាន់ ពី បទ « ការជួញដូរ មនុស្ស ដោយ ឆ្លង ដែន និង បទ អន្តរ ការី ជាមួយ ស្រ្តី ព ពោះ » ត្រង់ មាត្រា ១៦ ច្បាប់ ស្តីពី ការបង្រ្កាប ការជួញដូរ មនុស្ស និង ការពារ អនីតិជន និង មាត្រា ៣៣២ នៃ ក្រម ព្រហ្មទណ្ឌ ។
គួរ រំលឹក ថា កម្លាំង នគរបាល ការិយាល័យ ប្រឆាំង ការជួញដូរ មនុស្ស និង ការពារ អនីតិជន សហការ ជាមួយ កម្លាំង នគរបាល មូលដ្ឋាន បាន ចុះបង្ក្រាប ករណី ជួញដូរ មនុស្ស សម្រាប់ នាំ ឆ្លង ដែន និង បទ ធ្វើ អន្តរការី នៃ អំពើព ពោះ ជំនួស ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ស្រី ប្រុស ៥នាក់ និង រំដោះ បាន នារី រងគ្រោះ ចំនួន ៣៣ នាក់ ។
ប្រតិបត្តិការ ចុះបង្ក្រាប ការពពោះ ជំនួស នេះ ត្រូវបាន ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ២១ ខែមិថុនា ឆ្នាំ ២០១៨ ចំណុច ផ្ទះ វីឡា លេខ ២A ផ្លូវ ៣៤៨ និង ផ្ទះ វិឡា លេខ ៩A ផ្លូវ ៣៤៨ ស្ថិត នៅក្នុង បុរី វិមាន ភ្នំពេញ តាម បណ្ដោយ ផ្លូវ លេខ ៥ ក្នុង សង្កាត់ ឬស្សីកែវ ខណ្ឌ ឬស្សីកែវ ដោយ មាន ការបញ្ជា ផ្ទាល់ ពី នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ។
បើ តាម នគរបាល ប្រតិបត្តិការ នេះ ស្ថិត ក្រោម ការសម្របសម្រួល ពី លោក គុជ គីម ឡុង ព្រះរាជអាជ្ញា រង នៃ អយ្យកាអម សាលាដំបូង រាជធានី ភ្នំពេញ និង ដឹកនាំ បង្ក្រាប ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ចាន់ កិត្តិខុម ស្នងការ រង ទទួល ផែន ប្រឆាំង ការជួញដូរ មនុស្ស និង ការពារ អនីតិជន នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
ក្រោយ ប្រតិបត្តិការ ស្រ្តី ព ពោះ ជំនួស ចំនួន ៣៣ នាក់ ត្រូវបាន បញ្ជួន ទៅ មន្ទីរ សង្គមកិច្ច រាជធានី ភ្នំពេញ រីឯ អ្នក មិន ពាក់ព័ន្ធ បាន អនុញ្ញាតឲ្យ ត្រឡប់ ទៅ ផ្ទះ វិញ ៕ តំណាងរាស្រ្ត ស សុខា ប្រាប់ ដល់ យុវជន ដែល ជា ឈាម ថ្មី របស់ CPP ត្រូវ ខិតខំ ប្រែក្លាយ ខ្លួន ជា យុវជន ល្អ របស់ បក្ស
( ព្រៃវែង ) ៖ លោក ស សុខា អ្នកតំណាងរាស្រ្ត មណ្ឌល ព្រៃវែង នា ព្រឹក ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី បញ្ចូល សមាជិក យុវជន គណបក្ស ប្រជាជន កម្ពុជា ស្រុក ពារាំង ខេត្ត ព្រៃវែង ចំនួន ៥២៨ នាក់ ។
ថ្លែង ទៅកាន់ អង្គ ពិធី លោក ស សុខា បាន សម្តែង នូវ ការស្វាគមន៍ យ៉ាង កក់ក្តៅ ដល់ យុវជន ដែល ទើប ចូល ជា សមាជិក បក្ស ទាំងអស់ និង ថ្លែង នូវ ការកោតសរសើរ ក្នុង ការសម្រេចចិត្ត ដ៏ ត្រឹមត្រូវ ចូល ជា សមាជិក នៃ មហា គ្រួសារ គណបក្ស ប្រជាជន កម្ពុជា ។
ជាមួយគ្នា នោះ លោក ស សុខា បាន ផ្តាំផ្ញើ ដល់ យុវជន ដែល ជា ឈាម ថ្មី របស់ បក្ស ត្រូវ ខិតខំ ប្រែក្លាយ ខ្លួន ជា យុវជន ល្អ របស់ បក្ស និង ថែរក្សា សាមគ្គីភាព ផ្ទៃក្នុង បក្ស ឲ្យបាន ល្អ ប្រសើរ ។
អ្នកតំណាងរាស្រ្ត វ័យ ក្មេង រូប នេះ បាន បន្ថែម ថា ក្នុង នាម ជា យុវជន បក្ស យើង មាន តួនាទី កៀគរ កម្លាំង គាំទ្រ បក្ស បន្ថែម ទាំង ក្នុង ស្រទាប យុវជន និង មហាជន ទូទៅ ។
ក្នុង ឱកាស នោះ ផងដែរ លោក ស សុខា ក៏ បាន រម្លឹក ដល់ យុវជន ទាំងអស់ ឲ្យ ប្រើប្រាស់ សិទ្ធិ ស្រប ច្បាប់ ដែល មាន ចូលរួម បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន កម្ពុជា ឲ្យបាន គ្រប់ ៗ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ ៕ ឃាត់ខ្លួន ជនសង្ស័យ ម្នាក់ ដើរ ឆបោក ប្រាក់ ពី ម្ចាស់ ស្ថានីយ៍ និង ដេប៉ូលក់ ប្រេង ឥន្ទនៈ នៅ ខណ្ឌ ដង្កោ
( ភ្នំពេញ ) ៖ បន្ទាប់ពី មាន ការប្រកាស របស់ អគ្គ នាយកដ្ឋាន កាំកុងត្រូល ក្រសួង ពាណិជ្ជកម្ម ពាក់ព័ន្ធ ករណី ជន ខិលខូច ដើរ ឆបោក ទារ ប្រាក់ ពី ម្ចាស់ ស្ថានីយ៍ និង ដេប៉ូ ប្រេង ឥន្ទនៈ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ មន្រ្តី កាំ កុងត្រូល បាន សហការ ជាមួយ ម្ចាស់ ដេប៉ូ ប្រេង តេលា ឡូង ស៊ី ដេត បាន ឃាត់ បុរស ជា អ្នក ដើរ ឆបោក នោះ ហើយ ។
ហេតុការណ៍ នេះ បាន កើតឡើង នៅ ចំណុច ផ្លូវ លេខ ២៧១ សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។ ការឃាត់ខ្លួន នេះ មាន ការជួយជ្រោមជ្រែង ពី មន្រ្តី កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ផងដែរ ។
ជនសង្ស័យ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ដើម្បី សួរនាំ ព័ត៌មាន និង បញ្ជូន ឲ្យ ទី បញ្ជាការដ្ឋាន កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ដើម្បី បន្ត ចាត់ការ តាម នីតិវិធី ៕ មហា យក្ស ចិន នឹង ក្លាយជា « ប្រទេស 5G ធំ ជាង គេ លើ លោក » នៅ ឆ្នាំ ២០២៥ !
យោង តាម របាយការណ៍ ខាងលើ ដដែល ក្រុមហ៊ុន ទូរស័ព្ទ ចល័ត ចិន ទាំង បី កំពុង ដឹកនាំ ការធ្វើតេស្ដ លើ ប្រព័ន្ធ 5G ដែល ជា ផ្នែក មួយ នៃ ផែនការរួម មាន បញ្ចូល ទាំង ការស្រាវជ្រាវ និង ការអភិវឌ្ឍ ព្រមទាំង ការដាក់ពង្រាយ បណ្ដាញ យុទ្ធសាស្ត្រ ក្រោម ទម្រង់ ពាណិជ្ជកម្ម ទ្រង់ទ្រាយ ធំ នៅ ត្រឹម ឆ្នាំ ២០២០ ។
សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ សាលា ឧបដ្ឋាន ថ្មី វត្ត បាឡាត់ តម្លៃ ជិត ៣០ម៉ឺន ដុល្លារ នៅ ស្រុក សង្កែ . សម្តេច ស ខេង ប្រាប់ ពលរដ្ឋ ឲ្យ ទៅ ចូលរួម បោះឆ្នោត គ្រប់ ៗ គ្នា
( បាត់ដំបង ) ៖ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ សម្តេច ក្រឡាហោម ស ខេង អនុប្រធាន គណបក្ស ប្រជាជន កម្ពុជា និង ជា អ្នកតំណាងរាស្រ្ត មណ្ឌល បាត់ដំបង បាន អញ្ជើញ ជា អធិបតី ក្នុង ពិធី សម្ពោធ ដាក់ ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ សាលា ឧបដ្ឋាន ថ្មី វត្ត បាឡាត់ ស្ថិត នៅ ភូមិន រា២ ឃុំ ន រា ស្រុក សង្កែ ខេត្ត បាត់ដំបង ដែល មាន តម្លៃ ជិត ៣០ម៉ឺន ដុល្លារ ។
ក្នុង ឱកាស នោះ សម្ដេច ក្រឡាហោម ស ខេង បាន ថ្លែង ថា នៅក្នុង ខេត្ត បាត់ដំបង មាន ចំនួន ១០២ ឃុំ - សង្កាត់ ក្នុង ចំណោម នេះ នៅសល់ តែ ៤ឃុំ ប៉ុណ្ណោះ ដែល ផ្លូវ មិន ទាន់ បាន ក្រាល កៅស៊ូ ព្រោះ ឃុំ ដែល នៅសល់ នេះ ខ្លះ ក៏ មាន នៅក្នុង តំបន់ បឹង ទន្លេ សាប តែ ក៏ ត្រូវ ពិនិត្យមើល ស្ថានភាព ផ្លូវ ទឹក ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ធ្វើដំណើរ បាន ស្រួល ហើយ ក្នុង ជំហាន បន្ទាប់ គឺ ត្រូវ មាន ការអភិវឌ្ឍ ក្រាល កៅស៊ូ ឲ្យ ដល់ គ្រប់ ភូមិ ។
សម្ដេច ក្រឡាហោម បាន បន្ត ថា មន្ទីរ ជំនាញ ចំនួន ២ គឺ មន្ទីរ អភិវឌ្ឍន៍ ជនបទ ខេត្ត និង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ឲ្យ សហការ គ្នា និង ធ្វើ សេនាធិការ ឲ្យ អភិបាល ខេត្ត ដើម្បី សិក្សា និង លើក គម្រោង អភិវឌ្ឍន៍ ផ្លូវ ឲ្យ ទៅដល់ ភូមិ របស់ ប្រជាពលរដ្ឋ នៅ បណ្ដា ឆ្នាំ ខាងមុខ ជាពិសេស នៅ អាណត្តិ ទី៦ ហើយ ចំពោះ គម្រោង ក្រាល កៅស៊ូ នេះ គឺ ធ្វើឲ្យ បាន នៅ ទូទាំង ប្រទេស តែម្ដង ។
ជាមួយគ្នា នេះ សម្តេច ក៏ បាន ជំរុញ ដល់ ប្រជាពលរដ្ឋ មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត ទាំងអស់ ឲ្យ ទៅ ចូលរួម បោះឆ្នោត ទាំងអស់ គ្នា នៅ ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ ខាងមុខ នេះ សូម ទៅ បោះឆ្នោត ឲ្យបាន គ្រប់ ៗ គ្នា ដើម្បីឲ្យ មាន និរន្តរភាព សន្តិភាព ក្នុង ប្រទេស ក៏ ដូចជា ជួយ ពង្រឹង លទ្ធិ ប្រជាធិបតេយ្យ នៅ កម្ពុជា ឲ្យ កាន់តែ ប្រសើរឡើង និង មាន ការអភិវឌ្ឍ ប្រទេស ឲ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ៕
កម្ពុជា នាំចេញ ផល នេសាទ បាន ជិត ៧ពាន់ តោន នៅ រយៈពេល ៥ខែ ដើម ឆ្នាំ ២០១៨
តាម របាយការណ៍ របស់ ក្រសួង កសិកម្ម បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា រយៈពេល ៥ខែ ឆ្នាំ ២០១៨ ដែល គិត ចាប់ពី ខែមករា ដល់ ខែឧសភា ដែល នាំចេញ ផល នេសាទ ស្រស់ បាន ចំនួន ៤.១៧០តោន និង ផល នេសាទ កែច្នៃ បាន ចំនួន ២.៣៣០តោន ៕
ពិធី អបអរសាទរ និង ការធ្វើ ព្យុហយាត្រា នេះ ប្រព្រឹត្ត ឡើង ក្រោម អធិបតីភាព សម្តេចេ ពិជ័យ សេនា ទៀ បាញ់ ឧប នាយក រដ្ឋមន្ត្រី និង ជា រដ្ឋមន្ត្រី ក្រសួង ការពារ ជាតិ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ នាយ ទាហាន ជាន់ ខ្ពស់ នៃ ក្រសួង ការពារ ជាតិ កម្ពុជា . មេបញ្ជាការ យោធ ភូមិភាគី ទី១ របស់ ព្រះរាជាណាចក្រ ថៃ ឡង ដ៏ . តំណាង កងទ័ព ប្រជាជន វៀតណាម ប្រមាណ ៣០០០ នាក់ នៅ បញ្ជាការដ្ឋាន យោធ ភូមិភាគ ទី៥ ខេត្ត បាត់ដំបង នា ព្រឹក ថ្ងៃទី ២៨ ខែមិថុនា ឆ្នាំ ២០១៨ ម្សិលមិញ ។
សូម ជម្រាប ថា យោធ ភូមិភាគ ទី៥ មាន ខេត្ត ចំនួន ៤រួម មាន៖ ទី ១៖ ខេត្ត បាត់ដំបង . ទី ២៖ ខេត្ត ពោធិ៍សាត់ . ទី ៣៖ ខេត្ត ប៉ៃលិន និង ទី៤៖ ខេត្ត បន្ទាយមានជ័យ ៕ លោក ហ៊ុន ម៉ានិត បំពាក់ អាវុធ វែង ៤១ ដើម ជូន កម្លាំង នគរបាល អន្តរាគមន៍ រាជធានី ភ្នំពេញ គោលបំណង ការពារ សន្តិសុខ សណ្តាប់ធ្នាប់ និង សុវត្ថិភាព ដល់ ពលរដ្ឋ និង សម្រាប់ ថ្ងៃ បោះឆ្នោត
( ភ្នំពេញ ) ៖ អាវុធ វែង ចំនួន ៤១ ដើម ត្រូវបាន បំពាក់ ជូន កម្លាំង នគរបាល អន្តរាគមន៍ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ នេះ ក្នុង គោលបំណង ដើម្បី ការពារ សន្តិសុខ និង សណ្តាប់ធ្នាប់ ទូទៅ ជូន ដល់ ប្រជាពលរដ្ឋ ភ្ញៀវ ទេសចរណ៍ នៅ ទូទាំង រាជធានី ភ្នំពេញ ។ ជាពិសេស ទៅ ទៀត នោះ ការបំពាក់ អាវុធ នេះ ក៏ ដើម្បី ពង្រឹង កងកម្លាំង នគរបាល ដើម្បី ចូលរួម លើ កិច្ចការ រក្សា សន្តិសុខ សម្រាប់ ថ្ងៃ យុទ្ធនាការ ឃោសនា បោះឆ្នោត និង ថ្ងៃ បោះឆ្នោត ផងដែរ នា ថ្ងៃទី ២៩ ខែកក្កដា ឆ្នាំ ២០១៨ នេះ ។
អាវុធ វែង ថ្មី ៗ ស្រឡាង ទាំង ៤១ ដើម នេះ ត្រូវបាន បំពាក់ ដោយ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ានិត អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ស្រាវជ្រាវ ចារកិច្ច ក្រសួង ការពារ ជាតិ ដោយ មាន ចូលរួម ពី នាយ ឧត្តម សេនីយ៍ ជួន សុវណ្ណ អគ្គ ស្នងការ រង នគរបាល ជាតិ និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ ផងដែរ ។
ថ្លែង ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ក្រោយពេល បំពាក់ អាវុធ នោះ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ បាន ថ្លែង ថា « ពិត ណាស់ នេះ ជា ការបំពាក់ អាវុធ វែង ចំនួន ៤១ ដើម ជូន កងកម្លាំង នគរបាល អន្តរាគមន៍ ពិសេស នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ដើម្បីឲ្យ កងកម្លាំង ទាំងនោះ បង្កើត កិច្ចការពារ សុវត្ថិភាព សន្តិសុខ និង សណ្តាប់ធ្នាប់ ទូទៅ ជូន ប្រជាពលរដ្ឋ ក៏ ដូចជា ដំណើរការបោះឆ្នោត ផងដែរ » ។
នាយ ឧត្តមសេនីយ៍ ស្នងការ បាន បញ្ជាក់ ទុក ជាមុន ថា ការបំពាក់ អាវុធ ជូន កងកម្លាំង នោះ វា ជា រឿង ធម្មតា មិន មាន អ្វី ចំឡែក នោះ ទេ ហើយ បើ កងកម្លាំង មិន មាន អាវុធ កាន់ តើ ឲ្យ ទៅ ធ្វើជា កងកម្លាំង នៃ ស្ថាប័ន យ៉ាងដូចម្តេច ទៅ ? នេះ ជា ការ សង្កត់ធ្ងន់ របស់ នាយ ឧត្តមសេនីយ៍ ស្នងការ ដើម្បី ឆ្លើយតប ទុក ជាមុន ចំពោះ ការលើកឡើង ទាំងឡាយ ដែល នឹង កើត មាន ឡើង យ៉ាង ច្បាស់ ក្រោយ ពិធី នេះ ត្រូវ ផ្សព្វផ្សាយ ជាសាធារណៈ នោះ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ ជួន សុវណ្ណ ក៏ បាន បញ្ជា ទៅ កងកម្លាំង នគរបាល ទាំងអស់ ទាំង ជំនាញ ការិយាល័យ និង នគរបាល ទាំង ១២ខណ្ឌ ត្រៀម ជានិច្ច ចំពោះ កិច្ចសហការ គ្នា លើ ការថែរក្សា សន្តិសុខ និង សណ្តាប់ធ្នាប់ សាធារណៈ តាម មូលដ្ឋាន ឲ្យ ជាប់ ជាប្រចាំ ជូន ប្រជាពលរដ្ឋ ទាំងអស់ និង ត្រូវ ជួយ អន្តរាគមន៍ ភ្លាម ៗ នៅពេល មាន បាតុភាព ណាមួយ កើតឡើង ដោយ ការរៀបចំ របស់ ក្រុម អគតិ ខ្លះ និង បាតុភាព កើតឡើង ដោយ យថាហេតុ នោះ ។
ចំពោះ ការបំពាក់ អាវុធ ថ្មី ៗ ទាំង ៤១ ដើម ខាងលើ នេះ នាយ ឧត្តមសេនីយ៍ ស្នងការ សូម ថ្លែងអំណរគុណ ដល់ លោក ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ានិត ដែល បាន គិតគូ មក លើ កងកម្លាំង នគរបាល ហើយ នាយ ឧត្តមសេនីយ៍ បាន សន្យា ថា កងកម្លាំង ទាំងអស់ នឹង ប្រើប្រាស់ អាវុធ ទាំង នេះ ស្រប ទៅតាម ច្បាប់ និង មិន ឲ្យ មាន ការប៉ះពាល់ ដល់ ពលរដ្ឋ នោះ ឡើយ ៕ ទីបំផុត ទីស្នាក់ការ កងទ័ព អាមេរិក ប្រចាំ កូរ៉េ ខាងត្បូង ផ្លាស់ប្តូរ ទីតាំង ទៅ កន្លែង ថ្មី ហើយ !
( សេអ៊ូល ) ៖ កងទ័ព អាមេរិក ប្រចាំ កូរ៉េ ខាងត្បូង USFK បាន ផ្លាស់ប្តូរ ទីស្នាក់ការ កណ្តាល របស់ ខ្លួន នា ថ្ងៃសុក្រ នេះ ទៅកាន់ មូលដ្ឋាន ថ្មី នៅឯ ភាគ ខាងត្បូង នៃ រដ្ឋធានី សេអ៊ូល ដោយ វា គឺជា គម្រោង រុះរើ ទីតាំង ដែល កូរ៉េ ខាងត្បូង និង សហរដ្ឋ អាមេរិក ធ្លាប់ បាន ព្រមព្រៀង គ្នា កាលពី ខែឧសភា ឆ្នាំ ២០០៣ ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួរ នៅ រសៀល ថ្ងៃសុក្រ ទី ២៩ ខែមិថុនា ឆ្នាំ ២០១៨ ។
សម្រាប់ ដំណើរការ សាងសង់ នៃ ទីស្នាក់ការ ខាងលើ បាន ចំណាយ ពេល ប្រមាណ ជា ១០ ឆ្នាំ ហើយ ការចំណាយ ៩០ ភាគរយ នៃ គម្រោង តម្លៃ ១០.៨ ពាន់ លាន ដុល្លារ នេះ គឺ ទទួលបាន ពី រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង ៕
ពិធី ប្រគល់ វិញ្ញាបនបត្រ សិស្ស ឆ្នើម និង សញ្ញាបត្រ បញ្ចប់ ការសិក្សា ដល់ សិស្សានុសិស្ស ខាងលើ នេះ បាន រៀបចំ ធ្វើឡើង ក្រោម អធិបតីភាព លោក បណ្ឌិត អឹម កុច រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា តំណាង រដ្ឋមន្ដ្រី ក្រសួង អប់រំ យុវជន និង កីឡា និង មាន ចូលរួម ពី លោក - លោកស្រី មាតាបិតា និង អាណាព្យាបាល សិស្សានុសិស្ស យ៉ាង ច្រើន កុះករ ។
