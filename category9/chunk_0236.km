វិទ្យាស្ថាន វិទ្យាសាស្រ្ត សុខាភិបាល ខ. ភ. ម ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ ខ្មែរ តែ មួយ
នាយ ឧត្តមសេនីយ៍ អ៊ុយ សារិន្ទ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
អគ្គ លេខាធិការ រង រដ្ឋសភា លោក គាំម កុសល ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ លោក គាំម កុសល អគ្គ លេខាធិការ រង រដ្ឋសភា នៅ ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
ថ្នាក់ដឹកនាំ មន្ត្រីរាជការ និង បុគ្គលិក ទាំងអស់ នៃ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ពិតជា មាន មោទនភាព គោរព កោតស សើរ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត និង សូម ប្តេជ្ញា អនុវត្ត តាម មាគ៌ា ដឹកនាំ ដ៏ ឆ្នើម ឧត្តុង្គឧត្តម របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល បាន ដឹកនាំ កម្ពុជា ទទួលបាន នូវ សមិទ្ធផល ជា ប្រវត្តិសាស្ត្រ រាប់ មិន អស់ ជាពិសេស នាំមក នូវ សុខ សន្តិភាព សុវត្ថិភាព ស្ថិរភាព សង្គម អធិបតេយ្យភាព នីតិរដ្ឋ និង ភាពល្បីរន្ទឺ នៅលើ ឆាក អន្តរជាតិ ។
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ មនុស្ស ៣៦ នាក់ ត្រូវបាន អប់រំ និង ពិន័យ ករណី ល្មើស វិធានការ សុខាភិបាល និង វិធានការ រដ្ឋបាល ថ្ងៃទី ០៦ ខែតុលា
( ភ្នំពេញ ) ៖ ក្នុង ការអនុវត្ត វិធានការ នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០២១ សមត្ថកិច្ច ជំនាញ បាន រកឃើញ មនុស្ស ៣៦ នាក់ ទៀត បាន ប្រព្រឹត្ត ល្មើស វិធានការ សុខាភិបាល និង វិធានការ រដ្ឋបាល សរុប ៩ករណី ព្រមទាំង បាន ធ្វើការ ផាកពិន័យ ជា ទឹកប្រាក់ សរុប ចំនួន ៨០ ម៉ឺន រៀល ផងដែរ ។ ក្នុង ចំណោម អ្នក ដែល បាន ល្មើស វិធានការ ទាំង នេះ មិន មាន មនុស្ស ត្រូវបាន បញ្ជូន ទៅ តុលាការ ទេ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស៖ បើកបរ សូម ប្រុងប្រយ័ត្ន គ្រប់ វិនាទី ! ស្លាប់ ៣នាក់ និង របួស ២២ នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ៦ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ៦ ខែតុលា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៣នាក់ និង របួស ធ្ងន់ ស្រាល ២២ នាក់ ។
គណបក្ស ខ្មែរ តែ មួយ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ គណបក្ស ខ្មែរ តែ មួយ នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០២១ នេះ បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
គណបក្ស ខ្មែរ តែ មួយ បាន បញ្ជាក់ នៅក្នុង ញត្តិ គាំទ្រ យ៉ាង ដូច្នេះ ថា ដើម្បី រក្សា សន្តិភាព ស្ថិរភាព នយោបាយ និង ការអភិវឌ្ឍន៍ ប្រទេសជាតិ គឺ មេដឹកនាំ នៃ ស្ថាប័ន កំពូល ទាំង៤ របស់ ជាតិ ត្រូវ ប្រកាន់ភ្ជាប់ នូវ ភាពស្មោះត្រង់ ចំពោះ ជាតិ និង មាតុភូមិ កម្ពុជា ដើម្បី ដឹកនាំ ប្រទេស ដោយ តម្កល់ ឧត្តម ប្រយោជន៍ ជាតិ ជា ធំ ។
សភា ពាណិជ្ជកម្ម កម្ពុជា ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ លោក មេធាវី សាំង វណ្ណៈ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ ខ្មែរ តែ មួយ
អភិបាល ខេត្ត ប៉ៃលិន ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
ទេសរដ្ឋមន្ដ្រី អង្គ វង្ស វឌ្ឍានា ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
ទីភ្នាក់ងារ សុខភាព បាន និយាយ ថា ទិន្នន័យ បាន ចង្អុលបង្ហាញ ពី ការកើនឡើង នៃ ជំងឺ រលាក សាច់ដុំ បេះដូង និង រលាក ស្រោម បេះដូង ក្នុង ចំណោម យុវជន និង មនុស្ស ពេញ វ័យ ដែល បាន ចាក់ វ៉ាក់សាំង ហើយ ។
អភិបាល ខេត្ត ឧត្តរមានជ័យ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
នាយ ឧត្តមសេនីយ៍ សន្តិ បណ្ឌិត ម៉ៅ ប៊ុន ណារិន ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ ខ្មែរ តែ មួយ
ឧត្តមសេនីយ៍ ឯក ចាប ភក្ដី និង ឧត្តមសេនីយ៍ ឯក កែវ ធី ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
អភិបាល ខេត្ត បន្ទាយមានជ័យ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
លោក យឹម ណុល សន ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឱ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ លោក យឹម ណុល សន អនុប្រធាន ប្រចាំ ការ នៃ ក្រុមប្រឹក្សា សេដ្ឋកិច្ច សង្គមកិច្ច និង វប្បធម៌ ប្រកាស គាំទ្រ ពេញ ទំហឹង ចំពោះ គំនិត ផ្តួចផ្តើម ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ ដើម្បី កំណត់ ឱ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
លោក សោម ពិសិដ្ឋ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ អភិបាល ខណ្ឌ កំបូល ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ៦ ខែតុលា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១៣. ៤៥៦. ៦៧២ នាក់ ។ ក្នុង រួម មាន៖
រុស្ស៊ី រាយការណ៍ ពី ចំនួន អ្នកស្លាប់ ដោយសារ កូវី ដ១៩ ប្រចាំ ថ្ងៃ ច្រើន បំផុត មិន ធ្លាប់ មាន
( ម៉ូស្គូ) ៖ មជ្ឈមណ្ឌល ត្រួតពិនិត្យ និង ឆ្លើយតប ជំងឺ ឆ្លង រុស្ស៊ី បាន រាយការណ៍ នៅ ថ្ងៃពុធ នេះ ថា រុស្ស៊ី បាន បញ្ជាក់ ពី ការស្លាប់ ទាក់ទង នឹង ជំងឺ កូវីដ១៩ ចំនួន ៩២៩ នាក់ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដែល ជា ចំនួន ប្រចាំ ថ្ងៃ ខ្ពស់ បំផុត នៅក្នុង ប្រទេស ដោយ ធ្វើឱ្យ ចំនួន អ្នកស្លាប់ សរុប កើនឡើង ដល់ ២១២. ៦២៥ នាក់ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃពុធ ទី ០៦ ខែតុលា ឆ្នាំ ២០២១ ។
នៅក្នុង អត្ថបទ ដដែល នោះ ក៏ បាន បញ្ជាក់ នៅ ខាងក្រោម ថា៖ « អត្ថបទ នេះ ត្រូវបាន ធ្វើ កែសម្រួល នៅ ថ្ងៃទី ៦ ខែតុលា ឆ្នាំ ២០២១ ។ អត្ថបទ មុន បាន និយាយ ដោយ មិន ត្រឹមត្រូវ ថា មេដឹកនាំ កម្ពុជា លោក ហ៊ុន សែន ស្ថិត ក្នុង ចំណោម អ្នក ដែល បាន ទទួល លិខិត ឆ្លង ដែន ប្រទេស ស៉ី ព្រ» ។
តាមរយៈ សេចក្តីថ្លែងការណ៍ ក្រុម មេធាវី រាជ រដ្ឋាភិបាល កម្ពុជា បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា « សម្តេច អគ្គ មហា សេនា បតី តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ ព្រះរាជាណាចក្រ កម្ពុជា មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ គ្មាន សញ្ជាតិ បរទេស ណាមួយ គ្មាន លំនៅដ្ឋាន ណាមួយ នៅឯ បរទេស ហើយក៏ មិន ដែល រត់ ចោល ប្រជាជន និង ប្រទេស កម្ពុជា នោះ ទេ ។ ការចុះផ្សាយ ថា សម្តេច ហ៊ុន សែន មាន លិខិត ឆ្លង ដែន ប្រទេស ស៊ីប (Cyprus) ជា ការចុះផ្សាយ ដែល បំផ្លើស និង ប្រាសចាក ពី ការពិត សុទ្ធសាធ » ។
ក្រុម មេធាវី រាជ រដ្ឋាភិបាល កម្ពុជា សូម បដិសេធ យ៉ាង ដាច់អហង្ការ ចំពោះ ការចុះផ្សាយ ដែល មាន ចេតនា បំភ្លៃ ការពិត នេះ ។ ក្រុម មេធាវី រាជ រដ្ឋាភិបាល មាន ការខកចិត្ត យ៉ាង ខ្លាំង ដែល សារព័ត៌មាន The Guardian ក្នុង នាម ជា សារព័ត៌មាន ដែល មាន កិត្តិនាម មួយ នៅ ទ្វីប អឺរ៉ុប បែរជា មិន គោរព ក្រមសីលធម៌ វិជ្ជាជីវៈ សារព័ត៌មាន ហើយ ចុះផ្សាយ ខ្លឹមសារ ដែល គ្មាន មូលដ្ឋាន និង ផ្ទុយ ពី ការពិត ទាំងស្រុង បែប នេះ ។
លោក កើត រិទ្ធ រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌ កម្ពុជា នៅ ថ្ងៃទី ០៦ ខែតុលា ឆ្នាំ ២០២១ នេះ បាន ផ្ញើ លិខិត មួយ ទៅ លោកស្រី STEPHIE DRACOS រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌ នៃ ប្រទេស ស៊ីប ដើម្បី ស្នើសុំ កិច្ចសហការស្រាវជ្រាវ ជុំវិញ ការចោទប្រកាន់ បំផ្លើស ការពិត ចំពោះ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា មាន លិខិត ឆ្លង ដែន ស៊ីប ឬ សញ្ជាតិ ស៊ីប ។
នាយ ឧត្តមសេនីយ៍ សួស អង្គារ៍ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
