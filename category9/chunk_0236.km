( ភ្នំពេញ ) ៖ កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន - អង្គការ សហ ប្រជាជាតិ (AUMM) ដែល គ្រោង ធ្វើឡើង នៅ ល្ងាច ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ តាម ប្រព័ន្ធ វីដេអូ ត្រូវបាន លើក ទៅ ពេល ក្រោយ វិញ ដោយសារ មូលហេតុ បច្ចេកទេស ។ នេះ បេី តាម ការបញ្ជាក់ របស់ លោក កុយ គួង អ្នកនាំពាក្យ ក្រសួង ការបរទេស កម្ពុជា ។
ទោះជា យ៉ាង នេះ ក្តី ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា នឹង ចេញ សេចក្តីជូន ព័ត៌មាន អំពី កាលបរិច្ឆេទ នៃ កិច្ចប្រជុំ នេះ ម្តង ទៀត នា ពេល ខាងមុខ ។
កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន - អង្គការ សហ ប្រជាជាតិ (AUMM) ត្រូវបាន គ្រោង ធ្វេី ឡេីង ដេីម្បី ពិនិត្យ អំពី វឌ្ឍនភាព នៃ កិច្ចសហប្រតិបត្តិការ អាស៊ាន - អង្គការ សហ ប្រជាជាតិ ពិសេស ការអនុវត្ត ផែនការ សកម្មភាព នៃ សេចក្តីថ្លែងការណ៍ រួម ស្តីពី ភាពជាដៃគូ គ្រប់ ជ្រុងជ្រោយ រវាង អាស៊ាន និង អង្គការ សហ ប្រជាជាតិ ឆ្នាំ ២០២១ - ២០២៥ ។
កិច្ចប្រជុំ ក៏ នឹង ផ្លាស់ប្តូរ យោបល់ គ្នា ផងដែរ អំពី ការពង្រឹង បន្ថែម ទៀត នូវ កិច្ចសហប្រតិបត្តិការ រវាង អាស៊ាន និង អង្គការ សហ ប្រជាជាតិ ដោយ ពិចារណា ទៅ លើ ការរាតត្បាត នៃ ជំងឺ កូវីដ - ១៩ និង ផែនការស្តារ ឡើងវិញ ក្រោយ វិបត្តិ ជំងឺ រាតត្បាត នេះ ។ ជាមួយគ្នា នេះ ក៏ នឹង មាន ការលើកឡើង ផងដែរ អំពី បញ្ហា តំបន់ និង អន្តរជាតិ ដែល មាន សារៈសំខាន់ ចំពោះ ការថែរក្សា សន្តិភាព ស្ថិរភាព សន្តិសុខ និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព នៅក្នុង តំបន់ ៕
ទោះជា យ៉ាងណា បណ្តា ប្រទេស ដែល មាន អ្នក ឆ្លង ចាប់ពី ១០.០០០ ករណី គឺ មាន ១៧១ ប្រទេស និង ដែនដី ខណៈ ប្រទេស កម្ពុជា យើង ឈរ នៅ លេខរៀង ទី ១០៨ ។
អគ្គ រដ្ឋទូត បារាំង ថា អូស្ត្រាលី ធ្វើ ដូច ក្មេង មិន ដឹង ខ្យល់ ដែល លាក់បាំង គម្រោង ផលិត នាវា មុជទឹក ជាមួយ អាមេរិក
ជុំវិញ ព័ត៌មាន ខាងលើ នេះ ក្រសួង ការបរទេស ចិន បាន ចេញ សេចក្តីថ្លែងការណ៍ ដោយ បង្ហាញ អំពី ការប្រឆាំង យ៉ាង ខ្លាំងក្លា ចំពោះ ការលួច បង្វឹក កងទ័ព តៃវ៉ាន់ ពីសំណាក់ កងទ័ព សហរដ្ឋ អាមេរិក បែប នេះ ។ ចិន បាន ព្រមាន ខ្លាំង ៗ នៅ ថ្ងៃសុក្រ នេះ ថា « សហរដ្ឋ អាមេរិក គួរតែ ទទួលស្គាល់ អំពី ភាពផុយស្រួយ កម្រិត ខ្ពស់ នៃ ស្ថានការណ៍ នៅ កោះ តៃវ៉ាន់ និង ការបង្ក ផល ប៉ះពាល់ ដ៏ អាក្រក់ ដោយសារតែ សកម្មភាព នានា របស់ ខ្លួន » ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន លោក ចាវ លីចៀន (Zhao Lijian) បាន សង្កត់ធ្ងន់ ក្នុង សន្និសីទ សារព័ត៌មាន នៅ ថ្ងៃសុក្រ នេះ ទៀត ថា « សហរដ្ឋ អាមេរិក គួរតែ បញ្ឈប់ ការលក់ អាវុធ ទៅ ឱ្យ កោះ តៃវ៉ាន់ និង ទំនាក់ទំនង យោធា អាមេរិក - តៃវ៉ាន់ ដើម្បី កុំ ឱ្យ ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ ទំនាក់ទំនង ចិន - អាមេរិក ព្រមទាំង សន្តិភាព និង ស្ថិរភាព នៅ ច្រក សមុទ្រ តៃវ៉ាន់ ។ ចិន នឹង ចាត់ វិធានការចាំបាច់ ទាំងអស់ ដើម្បី ការពារ អធិបតេយ្យភាព និង បូរណភាព ទឹកដី របស់ ខ្លួន » ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ៦ករណី ក្នុង នោះ ករណី ជួញដូរ ៦ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ១៣នាក់ ។
អភិបាល ខេត្ត កំពង់ស្ពឺ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ ភូមិន្ទ វិចិត្រ សិល្បៈ បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
ប្រធាន សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត ស្វាយរៀង ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
លោក នាក់ ភា ប្រធាន សហគមន៍ មាន ជ័យ ស្នួល ទ្រេត បាន ឱ្យដឹង ថា សហគមន៍ បាន ចាប់ផ្តើម នាំចេញ ស្លឹក គ្រៃ ភ្លុក ដំរី ក្រៀម កាលពី ខែ មុន ទៅ ប្រទេស ថៃ ហើយ រហូតមកដល់ ពេលនេះ ទើបតែ នាំចេញ ប្រហែលជាង ១០តោន ប៉ុណ្ណោះ ។ លោក បន្ថែម ថា បញ្ហា ប្រឈម នៃ ការនាំចេញ ក្រៅពី ការដាំដុះ នៅ មាន បរិមាណ តិច បច្ចុប្បន្ន នេះ កសិករ កំពុង ប្រឈម នឹង ការផលិត ដោយសារតែ មេឃ ភ្លៀង គ្មាន ថ្ងៃ សម្រាប់ ហាល ។
ប្រធាន សហគមន៍ រូប នេះ បាន បញ្ជាក់ ថា សហគមន៍ មាន ជ័យ ស្នួល ទ្រេត មាន កសិករ ជា សមាជិក ជាង ១០០ គ្រួសារ កំពុង ដាំដុះ ស្លឹក គ្រៃ ពូជ ភ្លុក ដំរី លើ ផ្ទៃដី ជាង ២០០ ហិកតា ។ នៅ ថ្ងៃ ខាងមុខ សហគមន៍ គ្រោង ពង្រីក ការដាំដុះ ឱ្យ បាន ១០០០ ហិកតា សម្រាប់ ផលិត ស្លឹក គ្រៃ នាំចេញ ។
លោក នាក់ ភា បាន ឱ្យដឹង ថា តម្លៃ ស្លឹក គ្រៃ ក្រៀម ដែល សហគមន៍ ទិញ ពី កសិករ មាន តម្លៃ ១៤០០ រៀល ក្នុង មួយ គីឡូក្រាម ។ តែ យ៉ាងណា សហគមន៍ ទទួល ទិញ ស្លឹក គ្រៃ ដែល ដាំដុះ តាម ស្តង់ដារ សេរី រាង្គ ដោយ មិន ប្រើ សារធាតុ គីមី ឡើយ ។
លោក បាន ឱ្យដឹង ថា បន្ថែម ពី ទីផ្សារ ថៃ លោក កំពុង សម្លឹង ចាប់ យក ទីផ្សារ ចិន ដែល ជា ទីផ្សារ ធំ សម្រាប់ នាំចេញ ដោយ ផ្ទាល់ ផងដែរ ។
ដោយឡែក សម្រាប់ គល់ ស្លឹក គ្រៃ ស្រស់ វិញ មិន ទាន់ អាច នាំចេញ ទៅ ក្រៅ ប្រទេស បាន គឺ មាន តែ ទីផ្សារ ក្នុង ស្រុក ប៉ុណ្ណោះ ដោយ សហគមន៍ មាន លទ្ធភាព ផ្គត់ផ្គង់ ប្រមាណ ២០តោន ទៅ ៥០តោន ក្នុង មួយ ថ្ងៃ ។
ប្រធាន សហគមន៍ រូប នេះ បន្ថែម ថា ក្រៅពី នាំចេញ ស្លឹក គ្រៃ ក្រៀម លោក ក៏ កំពុង រក ទីផ្សារ នាំចេញ គល់ ស្លឹក គ្រៃ ទៅ ប្រទេស មួយចំនួន ទៀត ដូចជា ទៅ សឹង្ហបុរី និង កូរ៉េ ។
សម្រាប់ ស្លឹក គ្រៃ ក្រៀម ដែល កម្ពុជា នាំចេញ នេះ គេ យក ទៅ កែច្នៃ ធ្វើជា តែ ភេសជ្ជៈ ប៉ូវ កម្លាំង និង ម្សៅ ស្លឹក គ្រៃជាដើម ៕ អភិបាល ខណ្ឌ មានជ័យ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ លោក ពេជ្រ កែវ មុនី អភិបាល ខណ្ឌ មានជ័យ បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
គួរ បញ្ជាក់ ថា នៅ ក្រោយ ជំនួប បិទ ទ្វារ ក្នុង ទីក្រុង Zurich ក្រុម មន្ត្រី អាមេរិក បាន អះអាង ថា ពួកគេ បាន ព្រមព្រៀង គ្នា ជាមួយ ក្រុម មន្ត្រី ចិន លើ គោលការណ៍ មួយចំនួន ក្នុង ការ រៀបចំ ជំនួប កំពូល តាម ប្រព័ន្ធ វីដេអូ រវាង លោក ប្រធានាធិបតី អាមេរិក ចូ បៃ ដិន និង ប្រធានាធិបតី ចិន លោក ស៊ី ជិន ពីង នៅ មុន ដំណាច់ ឆ្នាំ ២០២១ នេះ ៕
រយៈពេល ៣ ថ្ងៃ ក្នុង ឱកាស ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ ខេត្ត កណ្ដាល ទទួល ភ្ញៀវ ទេសចរ ជិត ៣ម៉ឺន នាក់
លោក ជួប សោភ័ណ្ឌ ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត កណ្ដាល បាន ឱ្យដឹង នៅ ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ ថា នៅក្នុង ឱកាស ឈប់ សម្រាក បុណ្យ ភ្ជុំ បិណ្ឌ ៣ ថ្ងៃ មាន ភ្ញៀវ ទេសចរ ជាតិ សរុប ចំនួន ២៥. ១៤៩ នាក់ និង អន្តរជាតិ ចំនួន ៧២ នាក់ បាន មក លេង កម្សាន្ត នៅ តាម រមណីយដ្ឋាន នានា ក្នុង ខេត្ត កណ្តាល ។ សំរាប់ ឆ្នាំ ២០២១ នេះ ភ្ញៀវ ទេសចរណ៍ ជាតិ ថយចុះ ចំនួន ៥៩. ៨៦% និង ភ្ញៀវ អន្តរជាតិ ថយចុះ ៥.២៥ % ធៀប នឹង រយៈពេល ដូចគ្នា ឆ្នាំ ២០២០ កន្លងទៅ ។
លោក ជួប សោភ័ណ្ឌ បន្ត ថា អត្រា ថយចុះ នៃ ចំនួន ភ្ញៀវ ទេសចរ ក្នុង ដំណើរកម្សាន្ត ក្នុង ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ រយៈពេល ៣ ថ្ងៃ នេះ គឺ ដោយសារ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង ព្រឹត្តការណ៍ សហគមន៍ ២០កុម្ភៈ ដែល មាន ហានិភ័យ ខ្ពស់ ម្យ៉ាងទៀត ប្រជាពលរដ្ឋ មាន ការយល់ដឹង បាន ខ្ពស់ ក្នុង ឆ្លង នៃ ជំងឺ កូវីដ១៩ បំប្លែង ថ្មី Delta ដើម្បី កុំ ឱ្យ មាន ការរីករាលដាល ឆ្លង ចូលក្នុង សហគមន៍ និង ក្រុមគ្រួសារ ដោយ ពលរដ្ឋ ភាគ ច្រើន មិន ចេញដំណើរកម្សាន្ត តាម តំបន់ ទេសចរណ៍ និង តាម រម្មណីយ៍ដ្ឋាន នោះ ទេ ។
( ភ្នំពេញ ) ៖ សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា ដែល មាន អ្នក ឧកញ៉ា លី ហួរ ជា ប្រធាន បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
រយៈពេល ៣ ថ្ងៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ខេត្ត កោះកុង ទទួល ភ្ញៀវ ទេសចរ ប្រមាណ ១ម៉ឺន នាក់
លោក បាន បញ្ជាក់ ថា ក្នុង រយៈពេល ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ដែរ មន្ទីរ ទេសចរណ៍ បាន សហការ ជាមួយ អាជ្ញាធរដែនដី និង តាម រមណីយដ្ឋាន និង ភោជនីយដ្ឋាន ធ្វើ ការផ្សព្វផ្សាយ អំពី វិធានការបង្កា ទប់ស្កាត់ ជំងឺ កូវីដ១៩ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕ ឃាតកម្ម ! បុរស ចំណាស់ ម្នាក់ ត្រូវ ជន ដៃ ដល់ ចាក់ សម្លាប់ នៅ សង្កាត់ ព្រែក ថ្មី ខណ្ឌ ច្បារអំពៅ
( ភ្នំពេញ ) ៖ បុរស ចំណាស់ ម្នាក់ ត្រូវ ឃាតក មិន ស្គាល់ មុខ ចាក់ សម្លាប់ នៅលើ គ្រែ បង្កឱ្យ មាន ការភ្ញាក់ផ្អើល កាលវេលា ម៉ោង ៧៖៣០ នាទី ព្រឹក ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ នៅ ចំណុច ដីឡូតិ៍ តាម ផ្លូវ លំ ស្ថិត នៅ ភូមិ កោះ ក្របី ១ សង្កាត់ ព្រែក ថ្មី ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ។
បុរស ជា ជនរងគ្រោះ មាន ឈ្មោះ អាត់ សូត្រ អាយុ ៧១ ឆ្នាំ ជា អ្នក មើល ដី ចំការ ឱ្យ គេ ស្នាក់ នៅ ភូមិ កោះ ក្របី ១ សង្កាត់ ព្រែក ថ្មី ខណ្ឌ ច្បារអំពៅ និង មាន ប្រព្ធ ឈ្មោះ ណាត នី អាយុ ៤៣ ឆ្នាំ ។
លោក ម៉ៅ សឿត អធិការ នគរបាល ខណ្ឌ ច្បារអំពៅ បាន បញ្ជាក់ ថា ក្រោយពី ទទួលបាន ព័ត៌មាន ភ្លាម ៗ លោក បាន កដឹកនាំ កម្លាំង ចុះ មក កន្លែង កើត ហេតុ ប្រទះឃើញ បុរស វ័យ ៧០ ឆ្នាំ បាន ស្លាប់ នៅលើ គ្រែ ហើយ ជនរងគ្រោះ ដេក គ្រែ តែ មួយ ជាមួយ ប្រពន្ធ ។ បើ តាម ការសន្និដ្ឋាន ជា ជំហាន បឋម គឺជា ករណី ឃាតកម្ម ។
លោក អធិការ ខណ្ឌ ច្បារអំពៅ បាន បញ្ជាក់ ថា សម្រាប់ ករណី ឃាតកម្ម នេះ កម្លាំង មូលដ្ឋាន បាន សហការ ជាមួយ កម្លាំង ជំនាញ ការិយាល័យ កោសល្យវិច្ច័យ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ និង ក្រុម គ្រូពេទ្យ ដើម្បី យក សំណាក សព ជាមុន សិន ពិនិត្យ រក មេរោគ កូវីដ១៩ ដើម្បី បញ្ជាក់ ឱ្យ ច្បាស់ ថា សព ជនរងគ្រោះ មាន ជំងឺ កូវីដ១៩ ឬ អត់ ។
តាមរយៈ ការធ្វើ កោសល វិច្ឆ័យ របស់ សមត្ថកិច្ច ជំនាញ បាន បញ្ជាក់ ថា ជនរងគ្រោះ ស្នាម របួស នៅលើ ខ្លួន ចំនួន ៦កាំបិត ដោយ របួស ធ្ងន់ ចំ ក្បាល ផុង រលា ចំហៀង ខាងស្ដាំ ស្មា ខាងក្រោយ ចំនួន ៤កន្លែង ទៀត គឺ ជនសង្ស័យ ប្រើ កាំបិត ធំ ( អាច ជា កាំបិត បុ័ង តោ) ។ ចំពោះ ករណី នេះ មន្ត្រី ជំនាញ កោសល្យវិច្ឆ័យ រាជធានី ភ្នំពេញ បាន សន្និដ្ឋាន គឺជា ករណី ឃាតកម្ម និង បាន ប្រគល់ សព ឱ្យ គ្រួសារ យក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី គេហដ្ឋាន ។
ចំពោះ ករណី ឃាតកម្ម ខាងលើ នេះ សមត្ថកិច្ច ជំនាញ កំពុង បើក ការស្រាវជ្រាវ យ៉ាង យកចិត្តទុកដាក់ បំផុត ដើម្បី ស្វែងរក ឃាតករ យកមក ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ ៕
គណបក្ស ប្រជាជន កម្ពុជា ក្រសួង សុខាភិបាល ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ គណបក្ស ប្រជាជន កម្ពុជា ក្រសួង សុខាភិបាល បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
លិខិត ប្ដូរ សារ និង ឯកសារ ពាក់ព័ន្ធ ស្តីពី ការផ្តល់ ឥណទាន សម្បទាន និង ហិរញ្ញប្បទាន ឥត សំណង របស់ ជប៉ុន ខាងលើ នឹង ត្រូវ ចុះហត្ថលេខា នៅ ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២១ ដោយ ឧប នាយក រដ្ឋមន្ត្រី ប្រាក់ សុខុន រដ្ឋមន្ត្រី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង លោក មិកា មិ ម៉ាសាហ៊ីរ៉ូ (MIKAMI Masahiro) ឯក អគ្គ រាជ ទូត ជប៉ុន ប្រចាំ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ទីស្ដីការ ក្រសួង ។
ក្រសួង ការបរទេស បញ្ជាក់ ថា ការផ្តល់ ឥណទាន សម្បទាន និង ហិរញ្ញប្បទាន ឥត សំណង របស់ ជប៉ុន រួម មាន៖
ឥណទាន សម្បទាន និង ហិរញ្ញប្បទាន ឥត សំណង ខាងលើ ដែល ផ្ដល់ ដោយ រដ្ឋាភិបាល ជប៉ុន នឹង ចូលរួមចំណែក យ៉ាង សំខាន់ ដល់ ការលើកកម្ពស់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក៏ ដូចជា ជួយ ពង្រឹង បន្ថែម ទៀត នូវ ទំនាក់ទំនង ដ៏ ល្អ ដែល មាន ស្រាប់ និង ចំណង មិត្តភាព រវាង ប្រទេស ទាំង ពីរ ៕
ក្រុមការងារ គ្រប់គ្រង សិស្ស - និស្សិត អាហារ រូបករណ៍ សម្ដេច តេជោ និង សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
តុលាការ កំពូល និង មហា អយ្យការ អម តុលាការ កំពូល ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ តុលាការ កំពូល និង មហា អយ្យការ អម តុលាការ កំពូល បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ សេចក្តីថ្លែង ហេតុ នៃ សេចក្តីព្រាង ច្បាប់ ធម្មនុញ្ញ ស្តីពី វិសោធនកម្ម មាត្រា មួយចំនួន នៃ រដ្ឋធម្មនុញ្ញ ក្នុង ការកំណត់ សញ្ជាតិ ខ្មែរ តែ មួយ សម្រាប់ មេដឹកនាំ ស្ថាប័ន កំពូល ជាតិ
( ភ្នំពេញ ) ៖ កិច្ចប្រជុំ ពេញ អង្គ របស់ គណៈ រដ្ឋមន្ត្រី ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ បាន សម្រេច ទាំងស្រុង ហើយ លើ ខ្លឹមសារ នៃ សេចក្តីព្រាង ច្បាប់ ធម្មនុញ្ញ ស្តីពី វិសោធនកម្ម មាត្រា មួយចំនួន នៃ រដ្ឋធម្មនុញ្ញ ក្នុង កំណត់ សញ្ជាតិ ខ្មែរ តែ មួយ ចំពោះ ប្រធាន ព្រឹទ្ធសភា រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ។
មុន ឈានដល់ កិច្ចពិភាក្សា លើ សេចក្តីព្រាង ច្បាប់ នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី ប៊ិន ឈិន រដ្ឋមន្ត្រី ទទួលបន្ទុក ទីស្តីការ គណៈ រដ្ឋមន្ត្រី បាន អញ្ជើញ ឡើង អាន នូវ សេចក្តីថ្លែង ហេតុ បញ្ជាក់ ពី គោលបំណង នៃ ការតាក់តែង ច្បាប់ នេះ ឡើង ។
គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
គណបក្ស ហ្វ៊ុន ស៊ិនប៉ិច បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « នេះ ជា ការបង្ហាញ នូវ ភាពស្មោះត្រង់ ចំពោះ ជាតិ ដោយ តម្កល់ ឧត្តម ប្រយោជន៍ ជាតិ ជា ធំ ក៏ ដូចជា ការប្រឆាំង នឹង ការជ្រែត ជ្រែក នយោបាយ ពី ខាងក្រៅ ចូលមក កិច្ចការ ផ្ទៃក្នុង នៃ ការដឹកនាំ ប្រទេសជាតិ » ។
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ ប្រទះឃើញ សព នារី ម្នាក់ ត្រូវ គេ សម្លាប់ ដាក់ ក្នុង បង្វិច ភួយ ក្នុង ផ្ទះសំណាក់ យីហោ « យ៉ិនស៊ិន ថ្មី » នៅ ក្រុង ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ មាន ការភ្ញាក់ផ្អើល មួយ ដោយ ប្រទះឃើញ នារី ម្នាក់ ត្រូវបាន គេ សម្លាប់ ដាក់ ក្នុង បង្វិច ភួយ បម្រុង ដឹក ដាក់ លើ ម៉ូតូ ទៅ ទម្លាក់ ចោល តែ ត្រូវ មេ ការ ផ្ទះសំណាក់ ឃើញ ទាន់ ក៏ ឃាត់ តែ ជនសង្ស័យ ភ័យ ស្លន់ស្លោរ រួច រត់គេចខ្លួន បាត់ ស្រមោល ។
ហេតុការណ៍ នេះ បង្កឱ្យ មាន ការភ្ញាក់ផ្អើល នា វេលា ម៉ោង ៨ព្រឹក ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ នៅ ចំណុច ផ្ទះសំណាក់ យីហោ « យ៉ិនស៊ិន ថ្មី » ក្នុង សង្កាត់ រលាប ក្រុង ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។
មេ ការ ផ្ទះសំណាក់ រូប នេះ បន្ត ថា លុះ វេលា ម៉ោង ប្រហែល៨ ព្រឹក ថ្ងៃទី ១០ ខែតុលា ឆ្នាំ ២០២១ នេះ គេ បាន ឃើញ ទ្វា បន្ទប់ លេខ ៦ចំហរ ហើយ បុរស ជា ជនសង្ស័យ បាន ទាញ អូសបង្វិច ភួយ ចំនួន មួយ ចេញ ពី ក្នុង បន្ទប់ ដាក់ លើ ម៉ូតូ បម្រុង ដឹក ទៅ ប្លុង ចោល ។
បច្ចុប្បន្ន សមត្ថកិច្ច ជំនាញ ផ្នែក ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ សហការ ជាមួយ ក្រុម គ្រូពេទ្យ ជំនាញ ក្រោម ការសម្របសម្រួល ពី លោក ប៊ុង តាំង ទី ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង ខេត្ត បាន នឹង កំពុង ចុះ ធ្វើ កោសល្យវិច្ច័យ និង ពិនិត្យ សាកសព នៅ កន្លែង កើត ហេតុ ដើម្បី ប្រកាស ស្វែងរក ក្រុមគ្រួសារ មក ទទួលយក ទៅ ធ្វើ បុណ្យ តាម ប្រពៃណី ។
ក្នុង ឱកាស ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ត្រី នា ព្រឹក ថ្ងៃសុក្រ ទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ឱ្យដឹង ថា សម្តេច បាន បញ្ជា ឱ្យ មាន ការស្រាវជ្រាវ ពាក់ព័ន្ធ អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ១៩ តើ ពួកគេ បាន ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ឬ អត់ ?
បើ តាម សម្តេច តេជោ ហ៊ុន សែន មាន អ្នកជំងឺ វ័យ ក្មេង មួយចំនួន បាន ស្លាប់ ដោយសារតែ ពួកគេ មិន បាន ចាក់ វ៉ាក់សាំង ។ សម្តេច តេជោ ក៏ បាន បញ្ជា ឱ្យ ស្រាវជ្រាវ ពី មូលហេតុ ដែល ពួកគេ មិន ព្រម ចាក់ វ៉ាក់សាំង ផងដែរ ។ លទ្ធផល ស្រាវជ្រាវ បង្ហាញ ថា អ្នក មិន ព្រម ចាក់ នោះ គឺជា អ្នក មាន និន្នាការ ប្រឆាំង និង អ្នក ខ្លះ ទៀត ជឿ តាម ការឃោសនា របស់ ក្រុម ប្រឆាំង នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជា ទៅ អាជ្ញាធរ ពាក់ព័ន្ធ ឱ្យ ខិតខំ ស្រាវជ្រាវ រក អ្នក មិន ទាន់ ចាក់ វ៉ាក់សាំង នេះ មក ទទួល វ៉ាក់សាំង ឱ្យ បាន គ្រប់ គ្នា ដោយ សម្តេច មិន ចង់ ឃើញ ពួកគេ ត្រូវ ស្លាប់ ព្រោះតែ មិន បាន ចាក់ វ៉ាក់សាំង នោះ ឡើយ ។
សម្តេច តេជោ បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ « យើង ត្រូវ ប្រឹងប្រែង រួមគ្នា ស្រាវជ្រាវ ព្រោះ មាន មួយ ក្រុម ដែល បាន ឃោសនា មិន ព្រម ចាក់ វ៉ាក់សាំង ហើយ ទៅ ឃោសនា មិន ឱ្យ គេ ចាក់ វ៉ាក់សាំង ។ យើង មិន ចង់ ទុក ឱ្យ អ្នក ប្រឆាំង ដែល ជឿ តាម ការឃោសនា អកុសល នោះ ពួកគេ ស្លាប់ ទេ យើង ចង់ឱ្យ ពួកគេ រស់ » ។
ទន្ទឹម គ្នា នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បន្ត អំពាវនាវ ដល់ អ្នក មិន ទាន់ បាន ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ទៅ ស្វែងរក ការចាក់ វ៉ាក់សាំង នៅ តាម មន្ទីរពេទ្យ រដ្ឋ ឬ មន្ទីរពេទ្យ បង្អែក តាម ខេត្ត នានា គឺ អាជ្ញាធរ នៅតែ ទទួល ចាក់ វ៉ាក់សាំង ជូន ពួកគេ ។
ពាក់ព័ន្ធ ការចាក់ វ៉ាក់សាំង នេះ សម្តេច តេជោ ក៏ បាន គូសបញ្ជាក់ ដែរ ថា ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ មិន ត្រឹមតែ ជួយ ការពារ សុខភាព ការពារ អាយុជីវិត ពី ការយាយី មេរោគ កូវីដ១៩ ប៉ុណ្ណោះ ទេ ។ តែ ទៅ ថ្ងៃ មុខ ការចាក់ វ៉ាក់សាំង នឹង ក្លាយទៅជា តម្រូវ ការចាំបាច់ ពាក់ព័ន្ធ ការរស់នៅ ប្រចាំ ថ្ងៃ ផងដែរ ។
សូម បញ្ជាក់ ថា គិត ត្រឹម ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២១ រាជ រដ្ឋាភិបាល កម្ពុជា ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ អាយុ ចាប់ពី ៦ឆ្នាំ ឡើង បាន ចំនួន ជាង ១៣លាន នាក់ ហើយ ស្មើនឹង ប្រមាណ ៨៤. ១១ភាគរយ នៃ ប្រជាពលរដ្ឋ សរុប នៅ ទូទាំង ប្រទេស ។
សម្តេច តេជោ បាន បញ្ជាក់ ថា មកដល់ ពេលនេះ កម្ពុជា មាន វ៉ាក់សាំង នៅក្នុង ស្តុក រហូតដល់ទៅ ១១លាន ដូស សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ៕
អភិបាល ខណ្ឌ ច្បារអំពៅ នាំយក អំណោយ មនុស្សធម៌ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ជួប ការលំបាក ខ្វះខាត ៣០ គ្រួសារ នៅ សង្កាត់ ព្រែក ឯង
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២១ នេះ លោក ចេង មុនីរ៉ា ប្រធាន កិត្តិយស អនុសាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ច្បារអំពៅ បាន ចុះ សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ មនុស្សធម៌ ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត ចំនួន ១០គ្រួសារ ចាស់ជរា ១០គ្រួសារ ជន ពិការ ៥គ្រួសារ និង អ្នក ផ្ទុក មេរោគ អេដស៍ ៥គ្រួសារ សរុប ៣០ គ្រួសារ នៅ សង្កាត់ ព្រែក ឯង ។
លោក ប្រធាន កិត្តិយស អនុសាខា សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ បង្កើន ការប្រុងប្រយត្ន័ បន្ថែម ទៀត ជាពិសេស សូម គោរព អនុវត្ត តាម វិធានការ នានា របស់ រាជ រដ្ឋាភិបាល ក្រសួង សុខាភិបាល និង រដ្ឋបាល រាជធានី ភ្នំពេញ ជាពិសេស សូម បន្ត អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ វិធានការ ការពារ ខ្លួន ពី ជំងឺ កូវីដ « ៣ការពារ និង ៣កុំ » របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ចូលរួម ទប់ស្កាត់ និង ការពារ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ទាំងអស់ គ្នា ។
បើ តាម ក្រសួង សុខាភិបាល ថៃ ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ១១. ០៦៨ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ថៃ ទូទៅ និង ៧២ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ អ្នកជំងឺ ចំនួន ១១៦ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ។ ដោយឡែក អ្នកជំងឺ ចំនួន ៩. ៩៣៣ នាក់ ផ្សេង ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
សាកលវិទ្យាល័យ ហេង សំរិន ត្បូងឃ្មុំ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
( ភ្នំពេញ ) ៖ សាកលវិទ្យាល័យ ហេង សំរិន ត្បូងឃ្មុំ បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
ក្នុង កិច្ចប្រជុំ ពេញ អង្គ របស់ គណៈ រដ្ឋមន្ត្រី នា ព្រឹក ថ្ងៃសុក្រ ទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ថ្លែង គូសបញ្ជាក់ ថា « រដ្ឋ ទាំង ពីរ សុទ្ធតែ ជា រដ្ឋ រងគ្រោះ ដូចគ្នា ដោយសារតែ សារព័ត៌មាន The Guardian ។ ដ្បិត ថា សារព័ត៌មាន បាន កែ ហើយ តែ យើង ត្រូវ បញ្ជាក់ រវាង រដ្ឋ និង រដ្ឋ ជាមួយគ្នា ។ បើ ចាំបាច់ ឯកឧត្តម ប្រាក់ សុខុន ឬ ឯកឧត្តម កើត រិទ្ធ ជួប រដ្ឋមន្ត្រី ការបរទេស ឬ ជួប រដ្ឋមន្ត្រី យុត្តិធម៌ តាម ប្រព័ន្ធ វីដេអូ និយាយ គ្នា ឱ្យ ច្បាស់ លើ រឿង ហ្នឹង » ។
បើ តាម សម្តេច តេជោ ហ៊ុន សែន ដើម្បី បញ្ជាក់ ពី ភាពស្អាតស្អំ ពាក់ព័ន្ធ រឿង សញ្ជាតិ នេះ កម្ពុជា បាន ធ្វើ កំណត់ ទូត ទៅ អគ្គ រដ្ឋទូត សហភាព អឺរ៉ុប និង អគ្គ រដ្ឋទូត ប្រទេស អឺរ៉ុប ប្រចាំ នៅ កម្ពុជា បូករួម ទាំង ប្រទេស អង់គ្លេស ផងដែរ ។
ការចុះផ្សាយ នាំឱ្យ មាន ការប្រតិកម្ម ខ្លាំង ពី រាជ រដ្ឋាភិបាល កម្ពុជា និង មាន ការទាមទារ ឱ្យ បំភ្លឺ ឡើងវិញ ពី សារព័ត៌មាន មួយ នេះ ផងដែរ ។ ក្រោយ ការទាមទារ សារព័ត៌មាន មួយ នេះ ក៏ បាន យល់ព្រម កែប្រែ ការផ្សាយ របស់ ខ្លួន ដោយ ប្តូរ មក ថា មនុស្ស ក្បែរ ខ្លួន សម្តេច តេជោ ជា អ្នក ទទួលបាន សញ្ជាតិ ពី ប្រទេស សាយ ប្រឹស វិញ ៕
ប្រធាន សាលាដំបូង និង ព្រះរាជអាជ្ញា ខេត្ត ព្រះវិហារ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
ខាងក្រោម ជា ខ្លឹមសារ ទាំង ស្រុង៖
ចំណេះដឹង ទូទៅ៖ តើ ទឹក សមុទ្រ ក កើតឡើង តាំងពី ពេលណា ?
ប្រហែលជា ៤. ៥០០លាន ឆ្នាំ មុន ផែនដី មាន សណ្ឋាន ខុសពី បច្ចុប្បន្ន គឺ ពុំ មាន មហាសមុទ្រ និង សមុទ្រ ទេ ។ ភ្នំ ភ្លើង បាន ព្រួស កម្អែល ផេះ និង ឧស្ម័ន ពាសពេញ ភព ទាំងមូល នៅ ពេល នោះ ភព មាន សីតុណ្ហភាព ក្តៅ ជាង បច្ចុប្បន្ន ខ្លាំង ណាស់ ។
ឧស្ម័ន ភ្នំ ភ្លើង គួបផ្សំ នឹង ឧស្ម័ន ផ្សេង ៗ និង ចំហាយ ទឹក បាន ចាប់ផ្តើម បង្កើត បរិយាកាស ភព ផែនដី ។ នៅ ខណៈពេល បរិយាកាស បាន វិវត្ត ផែនដី ក៏ បាន ចុះ ត្រជាក់ ។ ប្រហែលជា មុន ៤ពាន់ លាន ឆ្នាំ មុន ផែនដី បាន ចុះ ត្រជាក់ ល្មម ដែល ធ្វើឱ្យ ចំហាយ ទឹក ក្លាយជា កំណក ហើយ ធ្លាក់ មក ជា ភ្លៀង ។
កោះ តៃវ៉ាន់ ដែល ត្រូវបាន ចាត់ទុក ត្រឹមតែ ជា ខេត្ត មួយ របស់ ប្រទេស ចិន នោះ បាន អះអាង ថា ក្បួន យន្តហោះ ចម្បាំង ចិន ក្នុង ទំហំ ធំ បំផុត មិន ធ្លាប់ មាន បាន ចល័ត ចូល មកកាន់ តំបន់ ការពារ ដែន អាកាស ដែល ត្រូវបាន កំណត់ ដោយ តៃវ៉ាន់ ។ យោធា តៃវ៉ាន់ បាន អះអាង កាលពី ដើម សប្តាហ៍ នេះ ថា យន្តហោះ ចម្បាំង ចិន ជាច្រើន ប្រភេទ សរុប រហូតដល់ទៅ ១៤៨ គ្រឿង បាន ចល័ត ចូលមក ក្នុង តំបន់ ការពារ ដែន អាកាស ស្ថិត នៅ ភាគ និរតី កោះ នេះ នៅក្នុង រយៈពេល ០៤ ថ្ងៃ ជាប់ ៗ គ្នា គិត ចាប់ពី ថ្ងៃសុក្រ សប្តាហ៍ មុន ។
ជុំវិញ ស្ថានការណ៍ ដ៏ រសើប បំផុត ដែល កោះ តៃវ៉ាន់ មិន ធ្លាប់ បាន ជួបប្រទះ ជាង ៤០ ឆ្នាំ មក នេះ លោកស្រី ត្សៃ អ៊ីង វិន បាន លើកឡើង ថា « តៃវ៉ាន់ មិន ចង់បាន ការប្រឈមមុខ ដាក់ គ្នា ផ្នែក យោធា នោះ ឡើយ ... យើង សង្ឃឹម ចង់បាន សន្តិភាព . ស្ថិរភាព . ការរួមរស់ ដែល អាច ទុកចិត្ត បាន និង ផ្តល់ ប្រយោជន៍ ដល់ គ្នា ទៅ វិញ ទៅ មក ជាមួយនិង អ្នកជិតខាង ទាំងអស់ ។ ប៉ុន្តែ តៃវ៉ាន់ ក៏ នឹង ធ្វើ អ្វី ៗ គ្រប់ យ៉ាង ដើម្បី ការពារ សេរីភាព និង របៀប រស់ នៅ បែប ប្រជាធិបតេយ្យ របស់ ខ្លួន » ។
( ភ្នំពេញ ) ៖ លោកស្រី រាជ ផាវឿន ចៅសង្កាត់ ទួល សង្កែទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ លោក បណ្ឌិត អ៊ុក កោសា ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
បើ តាម ការសិក្សា ស្រាវជ្រាវ ខាងលើ កុមារ ចំនួន ១២០. ៦៣០ នាក់ ដែល ត្រូវបាន គេ ប៉ាន់ស្មាន ថា បាន បាត់បង់ អ្នក ថែទាំ បឋម ខណៈ ២២. ០០៧ នាក់ ទៀត បាន បាត់បង់ អ្នក ថែទាំ បន្ទាប់បន្សំ ឬ ជីដូន ជីតា ដែល ទទួលខុសត្រូវ ក្នុង ការផ្តល់ លំនៅដ្ឋាន ដល់ ពួកគេ ។ ប៉ុន្តែ មិន មាន ការផ្ដល់ តម្រូវការ មូលដ្ឋាន ទេ នៅ ចន្លោះ ថ្ងៃទី ០១ ខែមេសា ឆ្នាំ ២០២០ និង ថ្ងៃទី៣០ ខែមិថុនា ឆ្នាំ ២០២១ ។
ការព្រមាន ខាងលើ របស់ លោក Faisal Mekdad ធ្វើឡើង នៅក្នុង បទសម្ភាសន៍ ជាមួយ ទូរទស្សន៍ រដ្ឋ ស៊ីរី នៅ ថ្ងៃព្រហស្បតិ៍ សប្ដាហ៍ នេះ ។ ថ្លែង នា ឱកាស នោះ រដ្ឋមន្ត្រី ការបរទេស ស៊ីរី រូប នេះ ក៏ បាន លើកឡើង ផងដែរ ថា កងទ័ព អាមេរិក ត្រូវតែ ចាកចេញ ពី ទឹកដី ស៊ីរី ដ្បិត កងទ័ព ស៊ីរី អាចនឹង ចូល ទៅកាន់ តំបន់ ទាំងនោះ នៅ ថ្ងៃ ណាមួយ ។
សេចក្តីព្រាង វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ធម្មនុញ្ញ បន្ថែម ពាក់ព័ន្ធ នឹង ការកំណត់ ឱ្យ មាន សញ្ជាតិ ខ្មែរ តែ មួយ សម្រាប់ មេដឹកនាំ ស្ថាប័ន កំពូល ៗ របស់ ជាតិ ត្រូវបាន គណៈ រដ្ឋមន្រ្តី អនុម័ត ហើយ និង ត្រៀម បញ្ជូន ទៅកាន់ រដ្ឋសភា
កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្រ្តី នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដោយ មាន ការចូលរួម ពី សមាជិក នានា របស់ រាជ រដ្ឋាភិបាល ក្នុង នោះ មាន របៀបវារៈ ចំនួន ៤ ដែល ត្រូវបាន ពិភាក្សា និង អនុម័ត ដូច ជា៖
១៖ សេចក្តីព្រាង ច្បាប់ ធម្មនុញ្ញ ស្តីពី វិសោធនកម្ម មាត្រា ១៩ ថ្មី មាត្រា ៤២ ថ្មី មាត្រា ១០៦ ថ្មី ( មួយ ) មាត្រា ១១៩ ថ្មី និង មាត្រា ១៣ថ្មី នៃ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង មាត្រា ៣ នៃ ច្បាប់ ធម្មនុញ្ញ បន្ថែម សំដៅ ធានា នូវ ដំណើរការជា ប្រក្រតី នៃ ស្ថាប័ន ជាតិ
២៖ សេចក្តីព្រាង ច្បាប់ ស្តីពី ភាពជាដៃគូ វាង រដ្ឋ និង ឯកជន
៤៖ បញ្ហា ផ្សេង ៗ សំណើ សុំ ការយល់ព្រម ពី គណៈ រដ្ឋមន្ត្រី ដើម្បី សុំ ការអនុម័ត ពី ស្ថាប័ន នីតិប្បញ្ញត្តិ លើ សេចក្តីព្រាង ច្បាប់ ស្តីពី ការអនុម័ត យល់ព្រម លើ កិច្ចព្រមព្រៀង បន្ថែម ទៅ លើ កិច្ចព្រមព្រៀង រវាង រាជ រដ្ឋាភិបាល កម្ពុជា និង អង្គការ សហ ប្រជាជាតិ ទាក់ទង ទៅ នឹង ការកាត់សេចក្តី នៅក្រោម ច្បាប់ កម្ពុជា នូវ ឧក្រិដ្ឋកម្ម ដែល ប្រព្រឹត្ត ឡើង នៅ ក្នុង រយៈកាល នៃ កម្ពុជា ប្រជាធិបតេយ្យ ស្តីពី ការរៀបចំ ក្នុង ពេល អន្តរកាល និង ការបញ្ចប់ ការងារ របស់ អង្គ ជំនុំជម្រះ វិសាមញ្ញ ផងដែរ ។
លោក ផៃ ស៊ីផាន អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បញ្ជាក់ ថា ការរៀបចំ សេចក្តីព្រាង ច្បាប់ ធម្មនុញ្ញ ស្តីពី វិសោធនកម្ម មាត្រា ១៩ ថ្មី មាត្រា ៨២ មាត្រា ១០៦ ថ្មី ( មួយ ) មាត្រា ១១៩ ថ្មី និង មាត្រា ១៣៧ ថ្មី នៃ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង មាត្រា ៣និង មាត្រា៤ នៃ ច្បាប់ ធម្មនុញ្ញ បន្ថែម សំដៅ ធានា នូវ ដំណើរការជា ប្រក្រតី នៃ ស្ថាប័ន ជាតិ ។
ការរៀបចំ សេចក្តីព្រាង វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ធម្មនុញ្ញ បន្ថែម ទាក់ទង នឹង ការកំណត់ ឱ្យ មាន សញ្ជាតិ ខ្មែរ តែ មួយ សម្រាប់ មេដឹកនាំ ស្ថាប័ន កំពូល ៗ រួម មាន ប្រធាន រដ្ឋសភា ប្រធាន ព្រឹទ្ធសភា នាយក រដ្ឋមន្រ្តី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ បាន ធ្វើឡើង បន្ទាប់ពី បន្ទាប់ពី មេ ឧទ្ទាម សម រង្ស៉ី បាន ផ្សព្វផ្សាយ ចោទប្រកាន់ ខុសពី ការពិត ថា សម្តេច តេជោ ហ៊ុន សែន បាន ទិញ សញ្ជាតិ ពី ប្រទេស សាយ ប្រឺ ស (Cyprus) ។
( កំពត ) ៖ ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា គណបក្ស ប្រជាជន កម្ពុជា ខេត្ត កំពត បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ ព្រះសាសន សោភ័ណ ហឿម សុវណ្ណារ៉ា ប្រគេន បច្ច័យ សម្រាប់ ទ្រទ្រង់ ចង្ហាន់ ព្រះសង្ឃ ក្នុង វត្ត ពោធិលង្កា ក្រុង សៀមរាប ក្រោយ វត្ត ត្រូវ បិទ ដោយសារ កូវី ដ១៩
ព្រះសាសន សោភ័ណ ហឿម សុវណ្ណារ៉ា ក៏ បាន គោរព ប្រគេន ពរ ជូន ចំពោះ ព្រះសង្ឃ កូនសិស្ស តា ជី យាយ ជី ចំនួន ៧១ អង្គ / នាក់ ដែល កើត ជំងឺ កូវីដ១៩ ក្នុង វត្ត ពោធិលង្កា ឆាប់ បាន ជាសះស្បើយ ពី ជំងឺ កូវីដ១៩ ផងដែរ ។ ជាមួយគ្នា នោះ ព្រះសាសន សោភ័ណ ក៏ បាន ប្រគេន ថវិកា ១៥ម៉ឺន រៀល ដល់ កងកម្លាំង ប្រចាំ ការ នៅ វត្ត នេះ ផងដែរ ។
សូម ជម្រាប ដែរ ថា គិត ត្រឹម ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១១៤. ៣៥១ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១០៦. ៨៣៩ នាក់ . ស្លាប់ សរុប ចំនួន ២. ៤៥៩នាក់ ៕ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម កម្ពុជា ថ្លែង ក្នុង សន្និសីទ UN ថា ប្រព័ន្ធ ពហុ ភាគី ជា ឧបករណ៍ មួយ ដ៏ សំខាន់ សម្រាប់ ដោះស្រាយ បញ្ហា កូវីដ១៩ និង បញ្ហា ប្រឈម នានា
( ភ្នំពេញ ) ៖ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម របស់ កម្ពុជា បាន លើកឡើង ថា ប្រព័ន្ធ ពហុ ភាគី គឺជា ឧបករណ៍ មួយ ដ៏ មាន សារៈសំខាន់ សម្រាប់ ដោះស្រាយ បញ្ហា បង្ក ពី វិបត្តិ ជំងឺ កូវីដ១៩ និង បញ្ហា ប្រឈម នានា កំពុង កើតមាន លើ សាកលលោក នា ពេល បច្ចុប្បន្ន ។
ក្នុង សេចក្តីថ្លែងការណ៍ នោះ លោក រដ្ឋមន្ត្រី បាន គូស រំលេច ពី ផល ផល ប៉ះពាល់ នានា បង្កឡើង ដោយ ជំងឺ កូវីដ១៩ និង បញ្ហា ប្រឈម មួយ ចំនួន ទៀត ។ លោក រដ្ឋមន្ត្រី ប៉ាន សូរស័ក្តិ បាន លើកឡើង ថា ប្រព័ន្ធ ពហុ ភាគី គឺជា ឧបករណ៍ មួយ ដ៏ មាន សារៈសំខាន់ ដើម្បី ដោះស្រាយ បញ្ហា ប្រឈម នានា ដែល ពិភពលោក ទាំងមូល កំពុង ជួបប្រទះ ជាពិសេស ប្រទេស អភិវឌ្ឍន៍ តិចតួច ។
ក្នុង សេចក្តីថ្លែងការណ៍ នោះ លោក រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ក៏ បាន ចង្អុលបង្ហាញ នូវ បញ្ហា ប្រឈម ជា អាទិភាព មួយចំនួន ដែល ចាំបាច់ សម្រាប់ ប្រទេស អភិវឌ្ឍន៍ តិចតួច រួម មាន៖
* ការទទួលបាន សមភាពវ៉ាក់សាំង ដែល មាន សុវត្ថិភាព ប្រសិទ្ធភាព និង ការចែកចាយ ទាន់ ពេលវេលា ដល់ ប្រទេស អភិវឌ្ឍន៍ តិចតួច ។ សម្រាប់ កម្ពុជា រាជ រដ្ឋាភិបាល បាន ចាត់ទុក វ៉ាក់សាំង ជា ឧបករណ៍ យុទ្ធសាស្ត្រ ដើម្បី បង្កើត ភាពសុាំ ក្នុង សហគមន៍ ក្នុង ការប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ ។
ក្នុង ឱកាស បុណ្យ ភ្ជុំ កន្លងទៅ នេះ រាជ រដ្ឋាភិបាល កម្ពុជា មិន បាន បិទ ការឈប់ សម្រាក និង ការដើរលេង កម្សាន្ត របស់ ប្រជាពលរដ្ឋ ខ្មែរ នោះ ឡើយ ។ ប្រជាពលរដ្ឋ ខ្មែរ បាន ធ្វើដំណើរ ទៅ លេង ស្រុក កំណើត ជួបជុំ គ្រួសារ ហើយក៏ មាន ការធ្វើដំណើរកម្សាន្ត ទៅកាន់ កន្លែង លេង កម្សាន្ត នានា យ៉ាង ច្រើន កុះករ ផងដែរ ។
ក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្ត្រី នា ព្រឹក ថ្ងៃសុក្រ ទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា នេះ គឺជា ការសាកល្បង មួយ ដ៏ ធំ របស់ កម្ពុជា ហើយ បើ ក្រោយ ពិធី បុណ្យ ភ្ជុំ នេះ ស្ថានភាព ឆ្លង ជំងឺ កូវីដ១៩ ស្ថិត ដូច ក្នុង ស្ថានភាព រាល់ ថ្ងៃ គឺ កម្ពុជា អាច ឈាន ទៅ បើក សកម្មភាព សេដ្ឋកិច្ច និង សង្គម គ្រប់ វិស័យ ឡើងវិញ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ « នេះ គឺជា ការសាកល្បង ដ៏ ធំ របស់ យើង ដើម្បី ឈាន ទៅ បើក ប្រទេស ឡើងវិញ លើ គ្រប់ វិស័យ ។ ប្រសិនបើ ក្នុង រង្វង់ ១០ ទៅ ១៥ ថ្ងៃ ស្ថានភាព របស់ យើង នៅ ហ្នឹង នរ អត្រា ឆ្លង ត្រឹម ប៉ុណ្ណេះ ដូច រាល់ ថ្ងៃ និង ការស្លាប់ ត្រឹម កម្រិត ប៉ុណ្ណេះ ខ្ញុំ គិត ថា ដល់ ពេលវេលា ដែល យើង ត្រូវ បើក សេដ្ឋកិច្ច និង សង្គម ឡើងវិញ លើ គ្រប់ វិស័យ តែ ទៅ តាម គន្លង ថ្មី ជាមួយ វិធានការ របស់ យើង ដែល នឹង នាំ ទៅដល់ ការងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច របស់ យើង » ។
ក្នុង កិច្ចប្រជុំ នា ព្រឹក មិញ នេះ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ថ្លែងអំណរគុណ ដល់ អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន យកចិត្តទុកដាក់ រក្សា សន្តិសុខ សណ្តាប់ធ្នាប់ និង ទប់ស្កាត់ ការឆ្លង ជំងឺ កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ។ សម្តេច តេជោ ក៏ បាន អរគុណ ដល់ ប្រជាពលរដ្ឋ គ្រប់ រូប ដែល បាន មាន ម្ចាស់ ការ និង ស្វ័យ ការពារ ខ្លួន ពី គ្រោះថ្នាក់ ចរាចរណ៍ និង បង្ការ ការ ចម្លង ការឆ្លង ជំងឺ កូវីដ១៩ ។
រយៈពេល ៣ ថ្ងៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ដើរលេង កម្សាន្ត តាម រមណីយដ្ឋាន នានា ក្នុង ខេត្ត រតនគីរី ជាង ៧ម៉ឺន នាក់
លោក ង៉ែត ពិទូ ប្រធាន មន្ទីរ ទេសចរណ៍ ខេត្ត រតនគិរី បាន ថ្លែង ឲ្យដឹង នៅ ព្រឹក ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២១ នេះ ថា មូលហេតុ នៃ ការធ្លាក់ចុះ ចំនួន ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ដែល មក លេង កំសាន្ត នា ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ នៅ ឆ្នាំ ២០២១ គឺ មកពី កត្តា នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ និង កត្តា សេដ្ឋកិច្ច ព្រមទាំង កត្តា អាកាសធាតុ ផងដែរ ពីព្រោះ រយៈពេល ៣ ថ្ងៃ នៃ ការឈប់ សម្រាក ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ នៅ ខេត្ត រតនគិរី មាន ភ្លៀង ធ្លាក់ ជោគជាំ ជាប់ ៗ គ្នា ។
លោក បាន បញ្ជាក់ ថា ក្នុង រយៈពេល ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ដែរ មន្ទីរ ទេសចរណ៍ បាន សហការ ជាមួយ អាជ្ញាធរដែនដី និង តាម រមណីយដ្ឋាន និង ភោជនីយដ្ឋាន ធ្វើ ការផ្សព្វផ្សាយ អំពី វិធានការបង្កា ទប់ស្កាត់ ជំងឺ កូវីដ១៩ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
ដោយឡែក ចំពោះ ឥរិយាបទ ភ្ញៀវ សង្កេតឃើញ ថា ពួកគាត់ ភាគ ច្រើន បាន ប្រកាន់ខ្ជាប់ នូវ ការ ពាក់ ម៉ាស់ និង រក្សា គម្លាត បាន ត្រឹមត្រូវ ។ ចំណែក ការងារ គ្រប់គ្រង សន្តិសុខ សណ្តាប់ សុវត្ថិភាព អនាម័យ បរិស្ថាន នៅ គ្រប់ រមណីយដ្ឋាន គឺ បាន ល្អ ប្រសើរ ៕ ទេសចរ ជាង ៣ម៉ឺន នាក់ ដើរកម្សាន្ត ខេត្ត សៀមរាប ក្នុង ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ
យោង តាម របាយការណ៍ របស់ មន្ទីរ ទេសចរណ៍ ខេត្ត សៀមរាប ដែល បណ្ដាញ សារព័ត៌មាន Fresh News ទទួលបាន បាន ឱ្យដឹង ថា រយៈពេល ៣ ថ្ងៃ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ប្រជាពលរដ្ឋ ក្នុង ខេត្ត រួម នឹង ទេសចរ មកពី បណ្ដា ខេត្ត ក្រុង នានា សរុប ៣៣. ២២២ នាក់ បាន ដើរកម្សាន្ត ក្នុង រមណីយដ្ឋាន សហគមន៍ អេកូ ទេសចរណ៍ ក្នុង ខេត្ត សៀមរាប ។
មន្ទីរ ទេសចរណ៍ ខេត្ត បាន បញ្ជាក់ ថា ទេសចរ ដែល ដើរកម្សាន្ត ក្នុង រមណីយដ្ឋាន អង្គរ មាន ប្រមាណ ២១.០០០ នាក់ រមណីយដ្ឋាន ឧទ្យាន ជាតិ ភ្នំ គូលែន មាន ប្រមាណ ៦.៣០០ នាក់ និង សហគមន៍ ទេសចរណ៍ - អេកូ ទេសចរណ៍ មាន ប្រមាណ ៥. ៧០០ នាក់ ។ បន្ថែម ពី នេះ ទេសចរ បរទេស ផ្ទៃក្នុង មាន ចំនួន ២២២ នាក់ ៕ សាខា សមាគម សិស្ស និស្សិត បញ្ញវន្ត ក្មេង វត្ត ខេត្ត កំពង់ចាម ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ កំណត់ ឱ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ ខ្មែរ តែ មួយ
( ភ្នំពេញ ) ៖ សាខា សមាគម សិស្ស និស្សិត បញ្ញវន្ត ក្មេង វត្ត ខេត្ត កំពង់ចាម ប្រកាស គាំទ្រ ពេញ ទំហឹង ចំពោះ គំនិត ផ្តួចផ្តើម ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ ដើម្បី កំណត់ ឱ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន មាន សញ្ជាតិ ខ្មែរ តែ មួយ ។
ក្នុង ញត្តិ គាំទ្រ ធ្វើឡើង នៅ ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ សាខា សមាគម សិស្ស និស្សិត បញ្ញវន្ត ក្មេង វត្ត ខេត្ត កំពង់ចាម បាន បង្ហាញ ការយល់ឃើញ របស់ ខ្លួន ថា ក្នុង នាមជា អ្នកតំណាង ប្រជាជាតិ ខ្មែរ ជា អ្នកការពារ និង ទទួលខុសត្រូវ ចំពោះ ផលប្រយោជន៍ ជាតិ ពិតប្រាកដ គឺ មិន ត្រូវ លាយឡំ និង ទទួលខុសត្រូវ ចំពោះ ជាតិ ដទៃ ក្នុង ពេល តែ មួយ ឡើយ ។ ម្យ៉ាង វិញ ទៀត ប្រវត្តិសាស្ត្រ បាន បង្រៀន ថា មាន តែ ជនជាតិ ខ្មែរ ដែល តែងតែ នៅ ជាមួយ ប្រជាជន ខ្មែរ ឈរ ខាង ប្រជាជន ខ្មែរ ជាដរាប រៀង មក ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ ប្រយុទ្ធ ប្រឆាំង អំពើ ជួញដូរ មនុស្ស បាន ប្រកាស គាំទ្រ ចំពោះ គំនិត ផ្តួចផ្តើម ដ៏ ខ្ពង់ខ្ពស់ ប្រកបដោយ ឧត្តម គតិ ស្នេហាជាតិ ដ៏ ជ្រាលជ្រៅ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ដែល មាន ការពាក់ព័ន្ធ ដើម្បី កំណត់ ឲ្យ ប្រធាន ព្រឹទ្ធសភា . ប្រធាន រដ្ឋសភា . នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវតែ ជា ឥស្សរជន ដែល មាន សញ្ជាតិ ខ្មែរ តែ មួយ គត់ ។
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ វិទ្យាស្ថាន ជាតិ អប់រំ (NIE) ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
សម្តេច បាន លើកឡើង ដូច្នេះ ថា៖ « ដើម្បី បង្ហាញ នូវ ការស្មោះត្រង់ ចំពោះ ជាតិ និង បញ្ចៀស នូវ ការជ្រៀត ជ្រែក ពី បរទេស ថ្នាក់ដឹកនាំ ជាតិ ដែល កាន់ តួនាទី ជា ប្រធាន ព្រឹទ្ធសភា ប្រធាន រដ្ឋសភា នាយក រដ្ឋមន្ត្រី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ត្រូវ មាន សញ្ជាតិ ខ្មែរ តែ មួយ »៕ លោក ឡាំ ហេង ហួត ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
ស្ថាន បេសកកម្ម អចន្ដ្រៃយ៍ របស់ កម្ពុជា នៅ ហ្សឺណែវ ប្រកាស គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
គិត ត្រឹម ថ្ងៃទី ៨ ខែតុលា ឆ្នាំ ២០២១ កម្ពុជា រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩៖ សរុប ចំនួន ១១៤. ៣៥១ នាក់ . អ្នក ជាសះស្បើយ សរុប ចំនួន ១០៦. ៨៣៩ នាក់ . ស្លាប់ សរុប ចំនួន ២. ៤៥៩នាក់ ៕ អភិបាល ខណ្ឌ ទួលគោក ជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ ឱ្យ ទៅ ទទួល វ៉ាក់សាំង លើក ទី៣ នៅ តាម ទីតាំង ចំនួន ៦ ចាប់ពី ថ្ងៃទី ១១ ខែតុលា ក្រោយ ចាក់ វ៉ាក់សាំង លើក ទី១ និង លើក ទី២ រួចហើយ
( ភ្នំពេញ ) ៖ លោក ជា ពិសី អភិបាល ខណ្ឌ ទួលគោក បាន ជម្រាប ជូនដំណឹង ដល់ ប្រជាពលរដ្ឋ រស់ នៅ តាម បណ្ដារ សង្កាត់ ទាំងអស់ ចំនួន ១០ ក្នុង មូលដ្ឋាន ខណ្ឌ ដែល បាន ចាក់ វ៉ាក់សាំង លើក ទី១ និង លើក ទី២ រួចហើយ សូមអញ្ជើញ ទៅ ចាក់ វ៉ាក់សាំង លើក ទី៣ ( ដូស ជម្រុញ ) នៅ តាម ទីតាំង ចំនួន ៦កន្លែង ចាប់ពី ថ្ងៃទី ១១ ខែតុលា ឆ្នាំ ២០២១ ។
អ្នកនាំពាក្យ មជ្ឈមណ្ឌល កម្មវិធី សិល្បៈ នៃ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន ថ្លែង ថា នឹង បន្ត គាំទ្រ សិល្បករ តៃវ៉ាន់ ចូលរួម សកម្មភាព សិល្បៈ ប្រឆាំង នឹង ការគាបសង្កាត់ ពី ប្រព័ន្ធ សារព័ត៌មាន តៃវ៉ាន់ ដែល មាន លំអៀង ខាង នយោបាយ
( ប៉េកាំង ) ៖ យប់ ថ្ងៃទី ១ ខែតុលា បន្ទាប់ពី អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន បាន ចាក់ផ្សាយ « កម្មវិធី ពិសេស ដើម្បី អបអរសាទរ បុណ្យ ជាតិ ចិន ឆ្នាំ ២០២១ សិបុន ចិន កោតសរសើរ មាតុ ប្រទេស » ទទួលបាន ការចាប់អារម្មណ៍ និង ប្រតិកម្ម តប យ៉ាង ខ្លាំង ទាំង ក្នុង និង ក្រៅ ប្រទេស ។ សិល្បករ ហុងកុង ម៉ាកាវ និង តៃវ៉ាន់ ជាច្រើន រូប បាន សម្តែង ជាមួយ សិល្បករ ចិន ដី គោក លើ ឆាក ជាមួយគ្នា ។
បុណ្យ ជាតិ ចិន ឆ្នាំ នេះ យើង ក៏ បាន ផលិត កម្មវិធី សិល្បៈ ផងដែរ ។ មិន ថា កម្រិត សិល្បៈ ឬមួយ ក៏ កម្រិត ពេញចិត្ត ពីសំណាក់ ទស្សនិកជន ទាំង ជាតិ និង អន្តរជាតិ ក្តី កម្មវិធី ពិសេស ដើម្បី អបអរ បុណ្យ ជាតិ ឆ្នាំ នេះ សុទ្ធតែ បាន បំកែក កំណត់ត្រា ថ្មី ។ សិល្បករ តៃវ៉ាន់ ទៅ សម្តែង កម្មវិធី នៅ ចិន ដី គោក ក៏ ដូចជា ចូលរួម សកម្មភាព ដូចជា រាត្រី សមោស រ សិល្បៈ នៃ អគ្គ ស្ថានីយ វិទ្យុ និង ទូរទស្សន៍ មជ្ឈិម ចិន ជាដើម បាន ទទួល ការពេញនិយម ពី ទស្សនិកជន និង មាន ប្រតិកម្ម យ៉ាង សកម្ម ក្នុង សង្គម ។
ប៉ុន្តែ ប្រព័ន្ធ សារព័ត៌មាន នៃ កោះ តៃវ៉ាន់ ដែល មាន លំអៀង ខាង នយោបាយ មិន អើពើ នឹង ការពិត ជាក់ស្តែង និង បំភិតបំភ័យ សិល្បករ តៃវ៉ាន់ ដែល មាន ការប្រាស្រ័យទាក់ទង ជាមួយ ចិក ដី គោក អាច និយាយ បាន ថា គឺ រក រឿង គ្រប់ បែបយ៉ាង ដើម្បី ធ្វើ ការគាបសង្កាត់ យើង ប្រឆាំង យ៉ាង ដាច់ខាត ចំពោះ រឿង នេះ ។ យើង សូម រំលឹក ឡើងវិញ ថា បន្ត ស្វាគមន៍ សិល្បករ តៃវ៉ាន់ មក ចូលរួម កម្មវិធី សិល្បៈ និង សម្តែង កម្មវិធី សិល្បៈ ជាមួយ ជន រួម ជាតិ ចិន ដី គោក ៕
សម្តេច ព្រះមហាសង្ឃរាជ បួរ គ្រី គាំទ្រ គំនិត ផ្ដួច ផ្ដើម របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ កំណត់ ឲ្យ ថ្នាក់ដឹកនាំ កំពូល របស់ ជាតិ មាន សញ្ជាតិ តែ មួយ គត់ គឺ សញ្ជាតិ ខ្មែរ
ក្នុង កិច្ចប្រជុំ ពេញ អង្គ របស់ គណៈ រដ្ឋមន្ត្រី នៅ ព្រឹក ថ្ងៃ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន គូសបញ្ជាក់ ថា ការធ្វើ ច្បាប់ នេះ ក្នុង ល្បឿន លឿន បែប នេះ ជា ការបញ្ជាក់ នូវ ល្បឿន ការងារ របស់ គណៈ រដ្ឋមន្ត្រី កម្ពុជា ដែល ធ្វើ ការងារ អត់ ដេក ពួន ហើយ ដើម្បី បញ្ជាក់ ពី សញ្ជាតិ របស់ សម្តេច ។
សូម បញ្ជាក់ ថា ការរៀបចំ សេចក្តីព្រាង វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ធម្មនុញ្ញ បន្ថែម ទាក់ទង នឹង ការកំណត់ ឱ្យ មាន សញ្ជាតិ ខ្មែរ តែ មួយ សម្រាប់ មេដឹកនាំ ស្ថាប័ន កំពូល ៗ រួម មាន ប្រធាន រដ្ឋសភា ប្រធាន ព្រឹទ្ធសភា នាយក រដ្ឋមន្រ្តី និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ បាន ធ្វើឡើង បន្ទាប់ពី បន្ទាប់ពី មេ ឧទ្ទាម សម រង្ស៉ី បាន ផ្សព្វផ្សាយ ចោទប្រកាន់ ខុស ពី ការពិត ថា សម្តេច តេជោ ហ៊ុន សែន បាន ទិញ សញ្ជាតិ ពី ប្រទេស សាយ ប្រឺ ស (Cyprus) ។
ក្រោយ មាន ការបំភ្លៃ បែប នេះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជា ឱ្យ រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌ លោក កើត រិទ្ធ សិក្សា អំពី ការរៀបចំ ធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ និង ច្បាប់ ពាក់ព័ន្ធ ដើម្បី កំណត់ ឱ្យ នាយក រដ្ឋមន្រ្តី . ប្រធាន រដ្ឋសភា . ប្រធាន ព្រឹទ្ធសភា និង ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ មាន សញ្ជាតិ ខ្មែរ តែ មួយ ៕
លោក បាន បញ្ជាក់ ទៀត ថា សេចក្តីព្រាង ច្បាប់ ស្តីពី ភាពជាដៃគូរ វាង រដ្ឋ និង ឯកជន នេះ នឹង ក្លាយជា ក្របខណ្ឌ គតិយុត្ត ដ៏ សំខាន់ មួយ ក្នុង ការបង្កើត បរិស្ថាន អំណោយផល ដើម្បី បន្ត ជំរុញ ការចូលរួម របស់ វិស័យ ឯកជន ក្នុង ការអភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ សាធារណៈ និង ផ្តល់ សេវា សាធារណៈ ឱ្យ កាន់តែ ប្រសើរ សំដៅ ជំរុញ កំណើន សេដ្ឋកិច្ច ឡើងវិញ នៅ ក្រោយពេល ដែល វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ ថមថយ និង ពង្រឹង ភាពប្រកួតប្រជែង របស់ កម្ពុជា នៅក្នុង តំបន់ និង សកលលោក ។
សេចក្តីព្រាង ច្បាប់ ស្តីពី ភ. រ. ជ នេះ ជា ច្បាប់ ថ្មី ជំនួស ឱ្យ ច្បាប់ ស្តីពី សម្បទាន ហើយក៏ ពុំ មែន ជា ច្បាប់ ស្តីពី វិសោធនកម្ម នោះ ទេ ។ ទន្ទឹម នេះ ដើម្បី អនុវត្ត តាម បទបញ្ញត្តិ នៃ សេចក្តីព្រាង ច្បាប់ នេះ ឱ្យ បាន ពេញលេញ និង មាន លក្ខណៈ ជា ប្រព័ន្ធ ស្រប តាម ចក្ខុវិស័យ ដូច មាន ចែង នៅក្នុង ឯកសារ គោល នយោបាយ ស្តីពី ការអភិវឌ្ឍ យន្តការភ. រ. ជ សម្រាប់ ការគ្រប់គ្រង គម្រោង វិនិយោគ សាធារណៈ ២០១៦ - ២០២០ ។
សេចក្តីព្រាង ច្បាប់ នេះ ផ្តល់ នូវ អត្ថប្រយោជន៍ គន្លឹះ ចំនួន ២ដូច ខាងក្រោម៖
* ការពង្រីក លំហ ហិរញ្ញវត្ថុ សាធារណៈ៖ តាមរយៈ ការអនុវត្ត យុទ្ធសាស្រ្ត កៀរ គរ ចំណូល និង ការគ្រប់គ្រង បំណុល សាធារណៈ ប្រកបដោយ ភាពហ្មត់ចត់ និង ប្រយ័ត្នប្រយែង ខ្ពស់ . លទ្ធភាព បង្កើន ចំណាយ សាធារណៈ ក្នុង ការរៀបចំ អភិវឌ្ឍ ហេដ្ឋារចនាសម្ព័ន្ធ សាធារណៈ ដែល ជា ឃ្នាស់ នៃ កំណើន សេដ្ឋកិច្ច និង ពង្រីក វិសាលភាព សេវា សាធារណៈ ឱ្យ កាន់តែ ប្រសើរ និង ខិត ជិត ប្រជាពលរដ្ឋ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ព្រឹក ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ របស់ គណៈ រដ្ឋមន្ត្រី ដើម្បី ពិភាក្សា និង ពិនិត្យ លើ ការធ្វើ វិសោធនកម្ម មាត្រា មួយចំនួន នៃ រដ្ឋធម្មនុញ្ញ ដើម្បី កំណត់ សញ្ជាតិ ខ្មែរ តែ មួយ សម្រាប់ មេដឹកនាំ ស្ថាប័ន កំពូល ចំនួន ៤ របស់ ជាតិ រួម មាន ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ ប្រធាន ព្រឹទ្ធសភា រដ្ឋសភា និង នាយក រដ្ឋមន្ត្រី ។
ជា កិច្ច ចាប់ផ្តើម នៃ កិច្ចប្រជុំ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង គូសបញ្ជាក់ ពី គោលបំណង និង មូលហេតុ មួយចំនួន ដែល នាំឱ្យ មាន ការគិតគូ ក្នុង ការរៀបចំ ធ្វើ វិសោធនកម្ម នេះ ។
សូម ទស្សនា និង ស្តាប់ប្រសាសន៍ ទាំងស្រុង របស់ សម្តេច តេជោ៖ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ១៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ០៧ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ១៦ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ០៧ ខែតុលា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ០៨ ខែតុលា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ១៦ នាក់ នោះ មាន ០៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ០៥ ករណី និង ជនសង្ស័យ ០៩ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៧ ករណី ។
( វ៉ាស៊ីនតោន ) ៖ ក្រសួង ការបរទេស អាមេរិក បាន បញ្ចេញ របាយការណ៍ ថ្មី មួយ ស្ដីពី ការស្ដុក ទុក ក្បាល គ្រាប់ នុយក្លេអ៊ែរ របស់ សហរដ្ឋ អាមេរិក ដែល មាន ចំនួន ៣. ៧៥០ គ្រាប់ គិត ត្រឹម ខែកញ្ញា ឆ្នាំ ២០២០ កន្លងទៅ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CGTN នៅ ថ្ងៃសុក្រ ទី ០៨ ខែតុលា ឆ្នាំ ២០២១ ។
បើ តាម របាយការណ៍ ថ្មី ដដែល ក្នុង ចំណោម ក្បាល គ្រាប់ នុយក្លេអ៊ែរ ខាងលើ មាន ទាំង ក្បាល គ្រាប់ កំពុង ប្រើប្រាស់ និង មិន ទាន់ ត្រូវបាន ប្រើ ខណៈ ក្បាល គ្រាប់ នុយក្លេអ៊ែរ ជាង ២.០០០ គ្រាប់ ផ្សេង ទៀត ត្រូវបាន ដាក់ ឱ្យ ចូល និវត្តន៍ និង រង់ចាំ ការបំផ្លាញ ចោល ហើយ នេះ គឺជា លើក ដំបូង បំផុត ក្នុង រយៈពេល ៤ឆ្នាំ មក នេះ ដែល អាមេរិក បង្ហើប ពី ចំនួន ក្បាល គ្រាប់ នុយក្លេអ៊ែរ បន្ទាប់ពី ការបិទបាំង របស់ លោក ដូណាល់ ត្រាំ ។
