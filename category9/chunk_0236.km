( ភ្នំពេញ ) ៖ មន្ត្រី ជាន់ ខ្ពស់ អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន កម្ពុជា និង មន្ត្រី ជាន់ ខ្ពស់ ត្រួតពិនិត្យ គ្រឿងញៀន អាស៊ាន នៅ ព្រឹក ថ្ងៃទី ១៣ ខែតុលា ឆ្នាំ ២០២១ នេះ បាន បើក កិច្ចប្រជុំ ASOD ត្រៀម សម្រាប់ កិច្ចប្រជុំ ថ្នាក់ រដ្ឋមន្រ្តី អាស៊ាន លើក ទី៧ ស្តីពី បញ្ហា គ្រឿងញៀន តាម ប្រព័ន្ធ វីដេអូ ។ ដែល កិច្ចប្រជុំ ត្រៀម នេះ កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ ។
កិច្ចប្រជុំ នេះ ភាគី កម្ពុជា គឺ នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ អគ្គ លេខាធិការ នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន តំណាង ឧប នាយក រដ្ឋមន្ត្រី កែវ គឹម យ៉ាន ដែល មាន ការអញ្ជើញ ចូលរួម កិច្ចប្រជុំ ពី តំណាង ស្ថាប័ន ត្រួតពិនិត្យ គ្រឿងញៀន នៃ បណ្តា រដ្ឋ អាស៊ាន ។
នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ បាន ថ្លែង ដោយ កោតសរសើរ និង ថ្លែង នូវ អំណរ អគុណ ចំពោះ បណ្តា ប្រទេស ជា សមាជិក អាស៊ាន ទាំងអស់ ចំពោះ កិច្ចសហប្រតិបត្តិការ និង ខិតខំ ប្រឹងប្រែង លើ ការងារ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ទទួលបាន លទ្ធផល គួរ កត់សម្គាល់ ។
ថ្លែង នូវ ការកោតសរសើរ ដល់ ក្រុមប្រឹក្សា ត្រួតពិនិត្យ គ្រឿងញៀន ឥណ្ឌូនេស៊ី ដែល បាន ដឹកនាំ កិច្ចប្រជុំ ក្រុមការងារ បច្ចេកទេស ដើម្បី ពិនិត្យ លើ សេខ ក្តីព្រាង របាយការណ៍ វាយតម្លៃ ពាក់កណ្តាល អាណត្តិ ស្តីពី ការអនុវត្ត ផែនការ សកម្មភាព សហគមន៍ អាស៊ាន ប្រឆាំង នឹង បទល្មើស គ្រឿងញៀន ២០១៦ - ២០២៥ កាលពី ថ្ងៃទី៣០ ខែកញ្ញា ឆ្នាំ ២០២១ បាន បញ្ចប់ ជាស្ថាពរ ។
នាយ ឧត្តមសេនីយ៍ មាស វិរិទ្ធ បាន បន្ត ថា វិបត្តិ សកល កូវីដ១៩ ដែល នៅតែ បន្ត គំរាមកំហែង ដល់ សុខភាព សាធារណៈ សេដ្ឋកិច្ច និង សន្តិសុខ ពិភពលោក ប៉ុន្តែ បណ្តា រដ្ឋ ជា សមាជិក អាស៊ាន ទាំងអស់ បន្ត យកចិត្តទុកដាក់ ប្រយុទ្ធ ប្រឆាំង នឹង គ្រឿងញៀន នៅក្នុង តំបន់ ក៏ ដូចជា ពិភពលោក ៕
មនុស្ស ៥នាក់ ត្រូវបាន អប់រំ និង ពិន័យ ករណី ល្មើស វិធានការ សុខាភិបាល និង វិធានការ រដ្ឋបាល ថ្ងៃទី ១២ ខែតុលា
( ភ្នំពេញ ) ៖ ក្នុង ការអនុវត្ត វិធានការ នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២១ សមត្ថកិច្ច ជំនាញ បាន រកឃើញ មនុស្ស ៥នាក់ ទៀត បាន ប្រព្រឹត្ត ល្មើស វិធានការ សុខាភិបាល និង វិធានការ រដ្ឋបាល សរុប ៥ករណី ព្រមទាំង បាន ធ្វើការ ផាកពិន័យ ជា ទឹកប្រាក់ សរុប ចំនួន ១លាន រៀល ផងដែរ ។ ក្នុង ចំណោម អ្នក ដែល បាន ល្មើស វិធានការ ទាំង នេះ មិន មាន មនុស្ស ត្រូវបាន បញ្ជូន ទៅ តុលាការ ទេ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស៖ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៥៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ១២ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៥៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ១៣ ខែតុលា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៥៧ នាក់ នោះ មាន ៣៤នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ២០ ករណី និង ជនសង្ស័យ ២៣នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ០៩ ករណី ។
សារលិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ឱកាស ទិវា ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ថ្ងៃទី ១៣ ខែតុលា ឆ្នាំ ២០២១
ក្នុង ឱកាស ដ៏ ប្រពៃ នៃ ទិវា ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ១៣ តុលា ២០២១ សម្តេច តេជោ ហ៊ុន សែន ក្នុង នាម រាជ រដ្ឋាភិបាល កម្ពុជា បាន ថ្លែង នូវ សារលិខិត ជូន បងប្អូន ជន រួម ជាតិ ទាំងអស់ ជា ទីស្រឡាញ់ ក្នុង គោលបំណង លើកកម្ពស់ វប្បធម៌ ត្រៀម បង្ការ ហានិភ័យ គ្រោះមហន្តរាយ ដែល យើង ម្នាក់ ៗ ត្រូវ ចូលរួម និង ចាត់ទុក ការគ្រប់គ្រង គ្រោះមហន្តរាយ គឺជា ភារកិច្ច យើង ទាំងអស់ គ្នា ។
ទិវា ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ប្រារព្ធ ធ្វើឡើង នា ថ្ងៃទី ១៣ ខែតុលា ជារៀងរាល់ ឆ្នាំ ដែល រាជ រដ្ឋាភិបាល បាន សម្រេច កំណត់ ស្រប ជាមួយ ទិវា អាស៊ាន គ្រប់គ្រង គ្រោះមហន្តរាយ និង ទិវា អន្តរជាតិ កាត់បន្ថយ គ្រោះ មហន្តរាយ ។ ឆ្នាំ នេះ ជា ឆ្នាំ ទី២ នៃ ការប្រារព្ធ ពិធី ប៉ុន្តែ អាស្រ័យ ដោយ ស្ថានភាព នៃ ជំងឺ កូវីដ - ១៩ មិន ទាន់ ស្រាកស្រាន្ត ដែល ជា ហេតុ មិន អាច ឱ្យ មាន ការជួបជុំ មហាជន ប្រារព្ធ មីទ្ទីង និង ធ្វើ យុទ្ធនាការ អប់រំ អំពី ការកាត់បន្ថយ ហានិភ័យ គ្រោះមហន្តរាយ នោះ បាន ឡើយ ៕
អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្របខ័ណ្ឌ ទូទាំង ប្រទេស នាំយក ទៅ ប្រគល់ ជូន លោក តា លោកយាយ ដល់ ខ្នង ផ្ទះ នៅ ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២១ នេះ ។
លោក តា លោកយាយ ទាំង ៧នាក់ ដែល ទទួលបាន អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នោះ រួម មាន៖
សូម ជម្រាប ថា រហូតមកដល់ ថ្ងៃទី ១២ ខែតុលា ឆ្នាំ ២០២១ នេះ ក្នុង នាម ជា សេនាធិការ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា . លោកស្រី ឱ វណ្ណឌីន បាន នាំយក អំណោយ មនុស្សធម៌ របស់ សម្ដេច ផ្ដល់ជូន លោក តា លោកយាយ ដែល មាន អាយុ ១០០ ឆ្នាំ ឡើង បាន ចំនួន ១៣៦ នាក់ រួចហើយ ខណៈ នៅ មួយចំនួន ទៀត នឹង យក ទៅ ប្រគល់ ជូន ដល់ ខ្នង ផ្ទះ ជា បន្ដ បន្ទាប់ ៕
នៅក្នុង កិច្ចប្រជុំ នេះ លោក អ៊ុច បូរ រិទ្ធ ក្នុង នាម សម្តេច តេជោ ហ៊ុន សែន បាន ចេញ សេចក្តីថ្លែងការណ៍ មួយ ទៅកាន់ បណ្តា ប្រទេស មិន ចូល បក្ស សម្ព័ន្ធ ដោយ រំលឹក ឡើងវិញ អំពី គោលបំណង នៃ ការបង្កើត ចលនា មិន ចូល បក្ស សម្ព័ន្ធ និង ការចូលរួម របស់ កម្ពុជា កាលពី ៦០ ឆ្នាំ មុន ក្នុង ការប្រឆាំង នឹង ការបែកបាក់ នៃ ការបែងចែក ភូមិសាស្ត្រ នយោបាយ និង មនោគម វិជ្ជា ដែល កើត ចេញ ពី សង្គ្រាម ត្រជាក់ ។
លោក រដ្ឋមន្រ្តី ប្រតិភូ បាន កត់សម្គាល់ ថា ប្រទេស សមាជិក ទាំងអស់ បាន ឈរ យ៉ាង រឹងមាំ រួមគ្នា ប្រឆាំង នឹង ការដាក់ទណ្ឌកម្ម លើ រដ្ឋ សមាជិក ចលនា មិន ចូល បក្ស សម្ព័ន្ឋ ដោយ ខុស ច្បាប់ ជា ឯកតោ ភាគី ក្រៅ ប្រព័ន្ធ តុលាការ និង ការដាក់ទណ្ឌកម្ម ក្រៅ ប្រព័ន្ឋ សមត្ថកិច្ច របស់ ខ្លួន ។
ក្នុង សេចក្តីថ្លែងការណ៍ នេះ កម្ពុជា បាន ជំរុញ ឱ្យ ចលនា មិន ចូល បក្ស សម្ព័ន្ឋ ត្រូវតែ មាន ការប្តេជ្ញាចិត្ត ក្នុង ការបរិហារ នយោបាយ រើសអើង និង ការបែងចែក ជាតិ សាសន៍ ដែល ប្រឆាំង នឹង គោលការណ៍ និង គោលបំណង របស់ ចលនា មិន ចូល បក្ស សម្ព័ន្ឋ ដូច ដែល មាន ចែង ក្នុង ធម្មនុញ្ញ អង្គការ សហ ប្រជាជាតិ ។
