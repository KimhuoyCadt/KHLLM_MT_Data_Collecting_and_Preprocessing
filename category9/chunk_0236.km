( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
សូម អាន ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក ជំនន់ របស់ ក្រសួង ធនធាន ទឹក ពី ស្ថានភាព កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ដូច ខាងក្រោម៖ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ យានយន្ត ៥៣៨ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ នា ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០២១
ក្តីសង្ឃឹម របស់ ប្រមុខ ការទូត កម្ពុជា បង្ហាញ ឡើង ក្រោយពី ចូលរួម ក្នុង កិច្ចប្រជុំ រដ្ឋមន្រ្តី ការបរទេស អាស៊ាន - សហរដ្ឋ អាមេរិក ក្នុង ឱកាស នៃ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ លើក ទី ៧៦ ដែល ប្រព្រឹត្តទៅ ដោយ ផ្ទាល់ និង តាម ប្រព័ន្ធ វីដេអូ នៅ យប់ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ។
អំណោយ ដែល បាន ចែកជូន ប្រជាពលរដ្ឋ នេះ រួម មាន៖ មី មួយ កេះ ត្រីខ កំប៉ុង ១យួរ អង្ករ ២៥ គីឡូក្រាម ស្ករ ត្នោត ម៉ាស់ និង ទឹក លាង ដៃ ។ ការចែក អំណោយ ត្រូវបាន រៀបចំឡើង នៅក្នុង តំបន់ គោលដៅ តាមរយៈ កិច្ចសហការ រវាង អាជ្ញាធរ មូលដ្ឋាន និង សមាគម អតីតម្ម សិក្សា ការី កម្ពុជា - កូរ៉េ ។
ការចែក អំណោយ នេះ ធ្វើឡើង ស្រប តាម បេសកកម្ម របស់ សមាគម អតីតម្ម សិក្សា ការី កម្ពុជា - កូរ៉េ ដើម្បី គាំទ្រ សុខុមាលភាព សហគមន៍ ជនបទ ដោយ សង្ឃឹម ថា គ្រឿង ឧបភោគ បរិភោគ នឹង ជួយ កាត់បន្ថយ ការលំបាក របស់ គ្រួសារ ដែល មាន ប្រាក់ ចំណូល ទាប និង ងាយ រងគ្រោះ នៅក្នុង ប្រទេស កម្ពុជា ដែល កំពុង មាន ស្ថានការណ៍ ធ្ងន់ធ្ងរ ដោយសារ វិបត្តិ ជំងឺ កូវីដ - ១៩ ។
សូម បញ្ជាក់ ថា សមាគម អតីតម្ម សិក្សា ការី កម្ពុជា - កូរ៉េ ត្រូវបាន បង្កើតឡើង នៅក្នុង ប្រទេស កម្ពុជា តាំងពី ឆ្នាំ ២០០២ ក្រោម ការគាំទ្រ ពី ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ កូរ៉េ ។ ដំបូង សមាគម នេះ មាន ឈ្មោះ ថា « ក្លឹប ខ្ញុំ ស្រឡាញ់ កូរ៉េ» ។
ទីភ្នាក់ងារ សហប្រតិបត្តិការ អន្តរជាតិ កូរ៉េ ( កយកា-KOICA) ត្រូវបាន បង្កើតឡើង នៅ ឆ្នាំ ១៩៩១ ក្រោម ក្រសួង ការបរទេស នៃ សាធារណរដ្ឋ កូរ៉េ គឺជា ទីភ្នាក់ងារ រដ្ឋាភិបាល ដែល បាន ផ្តល់ នូវ កម្មវិធី ជំនួយ ឥត សំណង របស់ ប្រទេស កូរ៉េ ។
សម្រាប់ កម្ពុជា លោក ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី ប្រធាន ក្រុមប្រឹក្សា ស្តារ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ បាន អញ្ជើញ ជា តំណាង របស់ សម្តេច តេជោ ហ៊ុន សែន ចូលរួម នៅក្នុង កិច្ចប្រជុំ ដ៏ មាន សារៈសំខាន់ មួយ នេះ ។ លោក ឧប នាយក រដ្ឋមន្ត្រី បាន អញ្ជើញ ថ្លែង ថា បង្ហាញ ពី ចក្ខុវិស័យ ក៏ ដូចជា ការប្តេជ្ញាចិត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង រក្សា ឱ្យ បាន នូវ សន្តិសុខ ស្បៀងអាហារ នេះ បើ ទោះបី កំពុង ស្ថិត ក្នុង វិបត្តិ ជំងឺ កូវីដ១៩ យ៉ាងណាក្តី ។
ដើម្បី ធានា ដល់ សន្តិ ស្បៀង នេះ លោក ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន កសាង នូវ ផែនទី បង្ហាញ ផ្លូវ មួយ ស្តីពី ប្រព័ន្ធ ស្បៀង សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព នៅ កម្ពុជា ឆ្នាំ ២០៣០ ។ បើ តាម លោក ឧប នាយក រដ្ឋមន្ត្រី ផែនទី បង្ហាញ ផ្លូវ នេះ បាន រៀបចំឡើង ផ្អែក លើ លទ្ធផល កិច្ចសន្ទនា និង ការវិភាគ ហើយ បាន ផ្សារភ្ជាប់ ក្របខ័ណ្ឌ គោល នយោបាយ និង យុទ្ធសាស្ត្រ នានា ដែល មាន ស្រាប់ ។
ដើម្បី សម្រេច ឱ្យ បាន ចក្ខុវិស័យ ស្តីពី ប្រព័ន្ធ ស្បៀង ឆ្នាំ ២០៣០ ដែល ផ្តល់ នូវ សន្តិសុខ ស្បៀង និង អាហារូបត្ថម្ភ សម្រាប់ មនុស្ស គ្រប់ រូប គិតគូ ពី ចីរភាព សេដ្ឋកិច្ច សង្គម និង បរិស្ថាន រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន ដាក់ចេញ នូវ ការងារ អាទិភាព ចំនួន ៤រួម មាន៖
ទី១៖ កម្ពុជា ប្ដេជ្ញា ត្រឹម ឆ្នាំ ២០៣០ នឹង ធ្វើឱ្យ របប អាហារ សុខភាព មាន ភាពងាយស្រួល អាច រក បាន និង មាន តម្លៃ សមរម្យ សម្រាប់ ប្រជាពលរដ្ឋ កម្ពុជា គ្រប់ រូប ។
ទី២៖ កម្ពុជា នឹង បន្ត អនុវត្ត សកម្មភាព លើកកម្ពស់ សមភាព យេនឌ័រ បង្កើត ការងារ សមរម្យ អភិវឌ្ឍន៍ សហគ្រិន និង ផ្តល់ ឱកាស ការងារ សម្រាប់ យុវជន ស្ត្រី និង ជន ងាយ រងគ្រោះ និង ផ្ដល់ ទីកន្លែង សម្រាប់ យុវជន ចូលរួម ក្នុង កិច្ចសន្ទនា គោល នយោបាយ ។
ទី ៣៖ ក្នុង បរិការណ៍ ដែល ពិភពលោក ទាំងមូល បាន នឹង កំពុង ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ និង ការប្រែប្រួល អាកាសធាតុ កម្ពុជា នឹង បន្ត ធ្វើ សកម្មភាព ដើម្បី ដោះស្រាយ ភាពងាយ រងគ្រោះ និង កាត់បន្ថយ ភាពក្រីក្រ ពង្រឹង ភាពធន់ របស់ តួអង្គ ពាក់ព័ន្ធ ពង្រឹង បណ្តាញ ការងារ និង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ។
ទី៤៖ កម្ពុជា នឹង បន្ត រៀបចំ កិច្ចសន្ទនា ការសម្របសម្រួល និង ការសហការ ជាមួយ គ្រប់ តួអង្គ ពាក់ព័ន្ធ ដើម្បី ធ្វើឱ្យ ប្រព័ន្ធ ស្បៀង កាន់តែ មាន បរិយាប័ន្ន ឆ្លើយតប ទៅនឹង តម្រូវការ របស់ អ្នកប្រើប្រាស់ ជន ងាយ រងគ្រោះ និង ជនជាតិ ដើម ភាគ តិច ។ល ។
នា ឱកាស ថ្លែង សេចក្តីថ្លែងការណ៍ នេះ ដែរ ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី បាន គូសបញ្ជាក់ ក្នុង អង្គប្រជុំ ដែរ ថា កម្ពុជា នឹង ធ្វើជា ប្រធាន អាស៊ាន នៅ ឆ្នាំ ២០២២ គឺជា ពេលវេលា ដ៏ សំខាន់ មួយ សម្រាប់ កម្ពុជា ពង្រឹង កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស នានា ដើម្បីឱ្យ ប្រព័ន្ធ ស្បៀង កាន់តែ មាន ភាពរឹងមាំ និង មាន ចីរភាព សម្រាប់ មនុស្ស ភព ផែនដី និង វិបុលភាព ។
លោក ឧប នាយក រដ្ឋមន្ត្រី ក៏ បាន ឆ្លៀត បញ្ជាក់ ទៀត ថា ដោយ ប្រទេស កម្ពុជា នឹង ក្លាយទៅជា ប្រទេស ដែល មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៣០ ប្រព័ន្ធ ស្បៀង គឺជា មូលដ្ឋានគ្រឹះ ដ៏ សំខាន់ សម្រាប់ ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព លុបបំបាត់ គ្រោះ អត់ឃ្លាន និង បញ្ហា អាហារូបត្ថម្ភ និង កាត់បន្ថយ ភាពក្រីក្រ ដោយ មិន ទុក នរណា ម្នាក់ ចោល នោះ ឡើយ ៕
ស្ថានីយ៍ ថ្លឹង រថយន្ត អចល័ត អូរ ពោធិ - ព្រះវិហារ កំពុង សាងសង់ . ពេល សង់ រួច មន្រ្តី សង្ឃឹម ថា ការដឹកជញ្ជូន លើស ទម្ងន់ កំណត់ នឹង ត្រូវការបន្ថយ
( ព្រះវិហារ ) ៖ ស្ថានីយ៍ ថ្លឹង រថយន្ត អចល័ត អូរ ពោធិ - ព្រះវិហារ បាន និង កំពុង ដំណើរការ សាងសង់ ជា ផ្លូវការ ក្រោយ ទទួលបាន ការឯកភាព ពី លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន តាម សំណើរ របស់ អាជ្ញាធរ ខេត្ត និង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ខេត្ត ព្រះវិហារ ។
ក្នុង ឱកាស ចុះ ពិនិត្យមើល វឌ្ឍនភាព នៃ ការសាងសង់ ស្ថានីយ៍ អចល័ត អូរ ពោធិ - ព្រះវិហារ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ លោក សំ លាង ទ្រី បាន ណែនាំ ដល់ ក្រុមការងារ បច្ចេកទេស ត្រូវ ធ្វើ ការសាងសង់ ស្ថានីយ៍ នេះ ស្រប តាម គំនូស ប្លង់ តាម បទដ្ឋាន បច្ចេកទេស ប្រយោជន៍ ដើម្បីឲ្យ សំណង់ នេះ មាន គុណភាព ប្រើ បា្រស់ បាន យូរអង្វែង ។
លោក ប្រធាន មន្ទីរ បាន ថ្លែង ថា ដោយ អនុវត្ត តាម ការណែនាំ ពី លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ ក្រុមការងារ ជំនាញ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត តែង ចុះ ជាប់ ជាប្រចាំ តាម ដងផ្លូវ ជាតិ នានា ក្នុង ទិសដៅ ត្រួតពិនិត្យមើល រថយន្ត ដែល ដឹកជញ្ជូន លើស ទម្ងន់ បណ្តាលឲ្យ ផ្លូវថ្នល់ របស់ យើង ងាយ នឹង រង ខូចខាត ។
លោក សំ លាង ទ្រី បាន ថ្លែង បញ្ជាក់ ថា ស្រប ពេល ដែល ស្ថានីយ៍ ថ្លឹង រថយន្ត អចល័ត អូរ ពោធិ - ព្រះវិហារ នេះ បាន សាងសង់ រួចរាល់ នឹង ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ នោះ លោក សង្ឃឹម ថា ការដឹកជញ្ជូន លើស ទម្ងន់ កំណត់ នឹង ត្រូវការបន្ថយ ហើយ មន្ត្រី របស់ យើង ក៏ មិន ពិបាក ដើរល្បាត ឃ្លាំមើល តទៅទៀត ដែរ ។
( រតនគិរី ) ៖ ក្រុម អាជីវករ បាន ផ្ទុះ ការតវ៉ា ស្នើសុំ ឱ្យ មាន ការជួយ អន្តរាគមន៍ ពី រដ្ឋបាល ខេត្ត រតនគិរី បន្ទាប់ពី ក្រុមហ៊ុន ហេង ដារ៉ា វិនិយោគ ផ្សារ បាន លុង បាន រុះរើ កន្លែង លក់ដូរ របស់ ពួកគាត់ ដើម្បី រៀបចំ ជា តូប ថ្មី ដោយ សន្យា រក្សា ភាព ដើម ជូន ពួកគាត់ វិញ ពោលគឺ លក់ នៅ កន្លែងណា ឲ្យ លក់ នៅ កន្លែង នោះ វិញ តែ មិន បាន ធ្វើ តាម សន្យា ឡើយ ដោយ ផ្តល់ កន្លែង លក់ សម្រាប់ ពួកគាត់ តូច ហើយ ត្រូវ ឱ្យ ធ្វើ ការចាប់ឆ្នោត ដើម្បី រើស ទីតាំង ថ្មី វិញ ។
ពាក់ព័ន្ធ បញ្ហា ខាងលើ នេះ លោក ជួន សុផល តំណាង ក្រុមហ៊ុន វិនិយោគ ផ្សារ បាន លុង បាន ឱ្យដឹង ដែរ ថា កាល ដែល លោក ឲ្យ គេ រុះរើ រៀបចំ ជា តូប ឲ្យ មាន សណ្ដាប់ធ្នាប់ នោះ គឺ កន្លែង លក់ ពួក គាត់ ពី មុន បាំង តង់ និង ឆ័ត្រ មិន មាន សណ្ដាប់ធ្នាប់ ទេ ។ ពេលនេះ លោក រៀបចំ មាន ដំបូល ត្រឹមត្រូវ ចែកចេញ ជា តូប ដែល មាន ទទឹង ១.២ម៉ែត្រ និង បណ្ដោយ ៣ម៉ែត្រ ។
លោក បន្ត ថា បើ តូប តូច ពិបាក ក្នុង ការលក់ដូរ អាជីវករ ម្នាក់ ៗ មាន សិទ្ធ អាច យក ២តូប បាន អាស្រ័យ លើ មុខរបរ ក៏ប៉ុន្តែ ក្នុង សៀវភៅ បន្ទុក ឈ្នួល តូប លក់ ចម្រុះ តម្លៃ ១០០ ដុល្លារ ក្នុង ១ឆ្នាំ . តូប លក់ ត្រី សាច់ តម្លៃ ៩០ ដុល្លារ ក្នុង ១ឆ្នាំ . តូប លក់ បន្លែ តម្លៃ ៨០ ដុល្លារ ក្នុង ១ ឆ្នាំ ( តូប មាន ទទឹង ១.២ម៉ែត្រ និង បណ្តោយ ៣ម៉ែត្រ ) ។ ម្យ៉ាង វិញ ទៀត បើ និយាយ ពី អ្នកលក់ កន្លែងណា ត្រូវ លក់ កន្លែង នោះ វិញ មិន អាច បាន ទេ គឺ ត្រូវ ធ្វើ ការចាប់ឆ្នោត មាន ភាពយុត្តិធម៍ ស្មើភាព គ្នា ។
លោក ជា ម ច័ន្ទ សោភ័ណ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ នូវ ទឹកចិត្ត ដ៏ ថ្លៃថ្លា របស់ សម្តេច ទាំង ទ្វេ ក៏ ដូចជា លោក ហ៊ុន ម៉ាណែត និង លោកស្រី ពេជ ចន្ទ មុនី ដែល បាន នាំយក មក ឧបត្ថម្ភ ផ្តល់ ជូន សម្ភារៈ បរិក្ខារ ពេទ្យ ចម្រុះ យ៉ាង ច្រើន ទាំងនេះ ដើម្បី ចែកជូន ក្រុម គ្រូពេទ្យ មន្ត្រីរាជការ និង កងកម្លាំងប្រដាប់អាវុធ ប្រយុទ្ធ ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ជា បន្ត ទៀត ។
ចំពោះ សម្ភារៈ បរិក្ខារ ពេទ្យ ទាំង ១៥០ កេស រួម មាន៖ សម្ភារៈ រុំ និង ថែទាំ របួស សម្ភារៈ ជំនួយ ការពិនិត្យ ជំងឺ ទូទៅ និង រោគ ស្ត្រី ជំនួយ ការងារ មន្ទីរពិសោធន៍ ជំនួយ ការវះកាត់ និង បរិក្ខារ ផ្សេង ៗ ជាច្រើន ទៀត ៕ រដ្ឋបាល ខេត្ដ ពោធិ៍សាត់ ណែនាំ ពី វិធានការបន្ថែម ការពារ និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩ ក្រោយ រាជ រដ្ឋាភិបាល ប្រកាស ផ្អាក ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ
រដ្ឋបាល ខេត្ត ក៏ បាន ធ្វើ ការណែនាំ ដល់ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង - ស្រុក កម្លាំងប្រដាក់ អាវុធ គ្រប់ ប្រភេទ ប្រធាន មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ ដូចត ទៅ៖
ទី១៖ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង - ស្រុក ត្រូវ ធានា ឱ្យ បាន នូវ ការចូលរួម អនុវត្ត របស់ ប្រជាពលរដ្ឋ ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន នូវ ស្មារតី នៃ សេចក្តីសម្រេច ខាងលើ ប្រកបដោយ ការទទួលខុសត្រូវ ខ្ពស់ និង ចាត់តាំង ផែនការអនុវត្ត ឱ្យ បាន ច្បាស់លាស់ ។
ទី២៖ មន្ទីរ ធម្មការ និង សាសនា ខេត្ត ត្រូវ ចាត់ចែង ផ្សព្វផ្សាយ នូវ ខ្លឹមសារ នៃ សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល ដល់ បណ្ដា គ្រប់ វត្ត អារាម ទូទាំង ខេត្ត ។
និង ទី៣៖ គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ក្រុង - ស្រុក លោក - លោកស្រី ប្រធាន មន្ទីរ - អង្គភាព ពាក់ព័ន្ធ ត្រូវ ធ្វើ ការសម្របសម្រួល ជាមួយ យន្តការ ដែល មាន ការពាក់ព័ន្ធ ទាំងអស់ ដើម្បី ធានា ដល់ ការនាំយក ចង្ហាន់ និង ទេយ្យ វត្ថុ ចាំបាច់ នានា ប្រគេន ដល់ ព្រះសង្ឃ នៅ តាម បណ្តា វត្ត អារាម នានា ដែល ស្ថិត ក្នុង សមត្ថកិច្ច ដែនដី របស់ ខ្លួន ៕
ការអនុម័ត ខាងលើ នេះ ត្រូវបាន ធ្វើឡើង បន្ទាប់ពី មាន ការពន្យារ ពេល ដោយសារតែ ការបិទ រដ្ឋាភិបាល កន្លងមក នេះ ព្រមទាំង វិបត្តិ ប្រាក់ បំណុល ដែល រដ្ឋាភិបាល នឹង អាច ជួបប្រទះ នៅក្នុង ខែតុលា ខាងមុខ នេះ ។ ទោះជា យ៉ាងណា ក៏ដោយ ក្រុម សមាជិក សភា បក្ស ប្រជាធិបតេយ្យ ដែល មាន សំឡេង ភាគ ច្រើន ស្រាប់ នៅក្នុង សភា តំណាងរាស្ត្រ បាន អះអាង ថា ពួក អាច ដោះស្រាយ បញ្ហា នានា បាន លុះត្រា ណា តែ ប្រាក់ ជំនួយ សម្រាប់ Iron Dome ត្រូវបាន អនុម័ត ។
ការអនុម័ត ត្រូវបាន ធ្វើឡើង ដោយ រលូន ក្នុង សំឡេង គាំទ្រ ៤២០ ទល់ នឹង សំឡេង ប្រឆាំង ៩។ ប្រធាន សភា តំណាងរាស្ត្រ អាមេរិក លោកស្រី ណេន ស៊ី ផេឡូស៊ី (Nancy Pelosi) បាន ថ្លែង ក្នុង ឱកាស នោះ ថា « ការអនុម័ត កញ្ចប់ ថវិកា លើក នេះ ឆ្លុះបញ្ចាំង យ៉ាង ច្បាស់ អំពី ការឯកភាព គ្នា នៅក្នុង សភា ដើម្បី សន្តិសុខ ប្រទេស អ៊ីស្រាអែល ។ ជំនួយ ដល់ អ៊ីស្រាអែល ពិតជា មាន សារៈសំខាន់ ណាស់ ពីព្រោះ សន្តិសុខ របស់ អ៊ីស្រាអែល គឺជា ភាពចាំបាច់ សម្រាប់ សន្តិសុខ របស់ អាមេរិក » ។
បទ វិភាគ អន្តរជាតិ៖ « ប្រជាធិបតេយ្យ ជា តម្លៃ រួម របស់ មនុស្សជាតិ ទាំងមូល តែ មិន មែន ជា ប៉ាតង់ របស់ ប្រទេស ណាមួយ នោះ ទេ »
ការពិត ជាក់ស្តែង បាន បញ្ជាក់ ថា ពី ការ ដែល ប្រជាជន ចិន ចំនួន ១.៤០០ លាន នាក់ បាន បម្រះ ខ្លួន ចេញ ផុត ពី ភាពក្រីក្រ ដាច់ខាត ដល់ ប្រទេស ចិន គ្រប់គ្រង បាន នូវ ការរីករាលដាល នៃ ជំងឺ កូវីដ ១៩ មុន គេ បង្អស់ នៅ ទូទាំង ពិភពលោក រហូតដល់ អត្រា រួមចំណែក របស់ ចិន ចំពោះ កំណើន សេដ្ឋកិច្ច សកល បាន លើស ពី ៣០ ភាគរយ ក្នុង រយៈជាច្រើន ឆ្នាំ កន្លងមក វា អាច មើលឃើញ យ៉ាង ច្បាស់ ថា ប្រសិទ្ធភាព អភិបាលកិច្ច នៃ ប្រជាធិបតេយ្យ បែប ចិន បាន ធ្វើឱ្យ ពិភពលោក ភ្ញាក់ផ្អើល យ៉ាង ខ្លាំង ។
( ភ្នំពេញ ) ៖ ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០២១ គឺជា ខួប គម្រប់ ២៣ឆ្នាំ ហើយ ដែល សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ត្រូវបាន គេ ប៉ុនប៉ង ធ្វើឃាត និង បាញ់ គ្រាប់ រ៉ូកែត បេ៤០ រហូតដល់ទៅ ៤គ្រាប់ សំដៅ ចូល ក្បួន រថយន្ត របស់ សម្តេច ហើយ ក្នុង នោះ មាន គ្រាប់ រ៉ូកែត មួយ គ្រាប់ ដែល ក្រុម ឃាតក បាញ់ សម្តៅ រថយន្ត សម្តេច នោះ មិន ហោះ ទៅ ត្រូវ រថយន្ត សម្តេច បែរជា ហោះ ទៅ ត្រូវ ផ្ទះ ប្រជាពលរដ្ឋ នាំឲ្យ ពលរដ្ឋ ម្នាក់ បាន ស្លាប់ ។
ព្រឹត្តិការណ៍ ប៉ុនប៉ង ធ្វើឃាត នេះ គឺជា ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ មួយ ដែល មិន អាច បំភ្លេច បាន ឡើយ ។ សម្តេច តេជោ ហ៊ុន សែន តែង បាន រំលឹក ពី ការធ្វើឃាត នេះ តែ មិន បាន រៀបរាប់ ឲ្យបាន លំអិត ពី ព្រឹត្តិការណ៍ នេះ ឡើយ ។
កាលពី រាត្រី ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០១៨ លោក ខៀវ កាញារីទ្ធ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន ដែល ជា អ្នក ស្ថិត នៅក្នុង ព្រឹត្តិការណ៍ នេះ ដែរ បាន ចេញមក រៀបរាប់ រំលឹក ព្រឹត្តិការណ៍ នោះ យ៉ាង លំអិត ដើម្បី ចែកជូន ប្រជាពលរដ្ឋ ខ្មែរ បាន ជ្រាប ពី ព្រឹត្តិការណ៍ ដ៏ សំខាន់ របស់ ខ្មែរ ក្នុង គ្រា ដែល វិបត្តិ នៃ ភ្លើង សង្គ្រាម មិន ទាន់ បិទ បញ្ចប់ ទាំងស្រុង នោះ ។
ខាងក្រោម នេះ គឺ ខ្លឹមសារ ទាំងស្រុង នៃ ព្រឹត្តិការណ៍ ប៉ុនប៉ង ធ្វើឃាត សម្តេច តេជោ ហ៊ុន សែន ដែល រៀបរាប់ ដោយ លោក រដ្ឋមន្ត្រី ខៀវ កាញារី ទ្ធ៖
ថ្ងៃ នេះ សម្តេច តេជោ រំលឹក ពី ខួប ទី២៣ នៃ ការប៉ុនប៉ង ធ្វើឃាត សម្តេច នៅ សៀមរាប ។ ខ្ញុំ សូម អនុញ្ញាត រំលឹក រឿង នេះ ព្រោះ កាល នោះ ខ្ញុំ នៅជាប់ នឹង ការងារ នេះ ។ បើ និយាយ រឿង នេះ ខ្ញុំ នៅតែ ព្រឺព្រួច នឹកឃើញ សំដី លោក ជីវតា ក្វាន់ ពេល ដែល លោក មក ប្រទេស ខ្មែរ សម័យ អង្គរ ។ ពិត មែន តែ សម័យ លោក ជីវតា ក្វាន់ មកដល់ ស្រុក ខ្មែរ ប្រទេស យើង ចាប់ផ្តើម ទន់ខ្សោយ ខ្លះ ហើយ ក្តី ក៏ប៉ុន្តែ ចំណុច មួយ ដែល លោក ជីវតា ក្វាន់ កត់សម្គាល់ គឺ៖ « ទេវតា រក្សា ស្រុក នេះ ខ្លាំង ពូកែ ណាស់ » ។
លុះ ព្រឹក ថ្ងៃទី ២៣ លោក បាន ឲ្យ គេ សួរ ទើប ដឹង ថា វត្ត ព្រះអង្គ ខ្មៅ នេះ នៅក្នុង អង្គរ ធំ តាម ផ្លូវ ទៅ ប្រាសាទ បាយ័ន តែម្តង ។ នៅ រសៀល ថ្ងៃទី ២៣ នោះ សម្តេច និង សមាជិក ជាប់ ឆ្នោត ជាសភា នៃ គណបក្ស ប្រជាជន ទាំងអស់ បាន ជិះ រថយន្តក្រុង រួមគ្នា មួយ ( រួមទាំង ខ្ញុំ ផង ) ទៅ វត្ត ព្រះអង្គ ខ្មៅ ។
ក្រុម អភិរក្ស អង្គរ បាន ឲ្យដឹង ថា ហេតុ បានជា វត្ត នេះ មាន នាម វត្ត ព្រះអង្គ ខ្មៅ យ៉ាង នេះ ដោយ ក្នុង សម័យ សង្គ្រាម សាសនា ក្រោយ អង្គរ រវាង ព្រហ្មញ្ញ និង ពុទ្ធសាសនា គេ បាន ដុត វត្ត នេះ រោល រាល ទាំង ព្រះបដិមា ព្រះពុទ្ធ ឡើង ខ្មៅ អ៊ូញ ទើប គេ ឲ្យ ឈ្មោះ វត្ត នេះ រហូតមក ។ ក្រោយពី ធ្វើ ការបន់ស្រន់ ហើយ សម្តេច តេជោ បាន ចាក់ គម្ពីរ ត្រូវ ត្រង់ ព្រះពោធិ៍ សត្វ ប្រសូត នៅក្នុង រាជ វង្ស តែ ព្រះអង្គ មិន មាន បន្ទូល អី ទាំងអស់ ដូចជា គថ្លង់ រហូតដល់ ព្រះបិតា ទ្រាំ លែង បាន បញ្ជា ឲ្យ យក ទៅ សម្លាប់ ចោល តែ មិន សុគត ។
ក្នុង សម័យ ប្រជុំ ទី មួយ សភា ប្រធានបក្ស នានា ដែល មាន អាសនៈ ក្នុង សភា អង្គុយ កៅអី ជួរ មុខ ទាំងអស់ គ្នា ។ នៅ ពេល នោះ ទើប សម្តេច ស ខេង ( នៅ ជា រដ្ឋមន្ត្រី មហាផ្ទៃ ) បាន ទទួល ទូរស័ព្ទ មក ថា មាន ការបង្កៃ គ្រាប់ បេ៤០ បួន គ្រាប់ លាក់ ក្នុង គុម្ព ផ្កា ក្រដាស អម ផ្លូវ ហើយ បញ្ជា ដោយ ប្រព័ន្ធ ទូរសព្ទ ចល័ត ។
ក្រសួង ទេសចរណ៍ បង្កើត QR-Code ផ្ទុក ឯកសារ បច្ចុប្បន្នភាព វិធាន សុវត្ថិភាព ទេសចរណ៍ និង នីតិវិធី ប្រតិបត្តិ ស្ដង់ដា អប្បបរមា SOP តាម គន្លង ប្រក្រតី ភាព ថ្មី សម្រាប់ ភោជនីយដ្ឋាន - អាហារដ្ឋាន
( ភ្នំពេញ ) ៖ ដើម្បី ផ្ដល់ ភាពងាយស្រួល ដល់ ម្ចាស់ អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ ប្រតិបត្តិករ ទេសចរណ៍ ក៏ ដូចជា ភ្ញៀវ ទេសចរ . ឥលូវនេះ ក្រសួង ទេសចរណ៍ បាន បង្កើត QR-Code ដើម្បី ផ្ទុក បណ្ដុំ ឯកសារ « បច្ចុប្បន្នភាព វិធាន សុវត្ថិភាព ទេសចរណ៍ និង នីតិវិធី ប្រតិបត្តិ ស្ដង់ដា អប្បបរមា SOP តាម គន្លង ប្រក្រតី ភាព ថ្មី » សម្រាប់ អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ។
ក្រសួង ទេសចរណ៍ ក៏ បាន អនុញ្ញាតឱ្យ ម្ចាស់ អាជីវកម្ម សេវាកម្ម ស្នាក់ នៅ ទេសចរណ៍ ប្រតិបត្តិករ ទេសចរណ៍ ភ្ញៀវ ទេសចរ អាច ស្កេន QR-Code នេះ ដើម្បី ទាញយក ឯកសារ « បច្ចុប្បន្នភាព វិធាន សុវត្ថិភាព ទេសចរណ៍ និង នីតិវិធី ប្រតិបត្តិ ស្ដង់ដា អប្បបរមា SOP តាម គន្លង ប្រក្រតី ភាព ថ្មី » សម្រាប់ អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ ទុក មើល ខ្លួន ឯង ឬ អាច ចែកចាយ បន្ត ហើយក៏ អាច បិទ ផ្សព្វផ្សាយ នៅ តាម មូលដ្ឋាន អាជីវកម្ម របស់ ខ្លួន បាន ផងដែរ ។
បើ តាម ក្រសួង ទេសចរណ៍ ការជំរុញ ការផ្សព្វផ្សាយ ឯកសារ « បច្ចុប្បន្នភាព វិធាន សុវត្ថិភាព ទេសចរណ៍ និង នីតិវិធី ប្រតិបត្តិ ស្ដង់ដា អប្បបរមា SOP តាម គន្លង ប្រក្រតី ភាព ថ្មី » ទាំងនេះ គឺ ត្រូវបាន រៀបចំឡើង ស្រប តាម វិធានការចាំបាច់ របស់ រាជ រដ្ឋាភិបាល និង ក្រសួង សុខាភិបាល ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ - ១៩ រក្សា បាន នូវ ស្ថិរភាព អាជីវកម្ម និង ធានា បាន នូវ សុវត្ថិភាព ជូន ដល់ ភ្ញៀវ ទេសចរ ជាតិ - អន្តរជាតិ ៕
សូម ទាញយក ឯកសារ « បច្ចុប្បន្នភាព វិធាន សុវត្ថិភាព ទេសចរណ៍ និង នីតិវិធី ប្រតិបត្តិ ស្ដង់ដា អប្បបរមា SOP តាម គន្លង ប្រក្រតី ភាព ថ្មី » សម្រាប់ អាជីវកម្ម ភោជនីយដ្ឋាន និង អាហារដ្ឋាន ទេសចរណ៍ តាមរយៈ QR-Code ដូច ខាងក្រោម៖
រដ្ឋបាល ខេត្ត ព្រៃវែង សំរេច ផ្អាក ការរៀបចំ ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩
រដ្ឋបាល ខេត្ត ក៏ សូម ធ្វើ ការផ្អាក ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ សម្រាប់ ឆ្នាំ ២០២១ នេះ ហើយ ត្រូវ អនុវត្ត ដូច ខាងក្រោម៖
ទី ២៖ រដ្ឋបាល ក្រុង ស្រុក ត្រូវ ធ្វើ ការសម្របសម្រួល ដើម្បី ធានា ដល់ ការនាំយក ចង្ហាន់ និង ទេយ្យ វត្ថុ ចាំបាច់ នានា ប្រគេន ព្រះសង្ឃ នៅ តាម បណ្តា វត្ត អារាម នានា ដែល ស្ថិត ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន ៕
លោក ប៉ែន សុវិជាតិ អនុ រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង ពាណិជ្ជកម្ម បាន គូសបញ្ជាក់ ថា ការធ្លាក់ចុះ ការនាំចេញ របស់ កម្ពុជា ក្នុង រង្វង់ ៥% រយៈពេល ៨ ខែ ឆ្នាំ នេះ ជា បម្រែបម្រួល ធម្មតា នៃ ចរន្ត ពាណិជ្ជកម្ម ទូទៅ ដែល អាចនឹង បំពេញ បន្ថែម មកវិញ ដោយ ការនាំចេញ ៣ - ៤ខែ ចុង ឆ្នាំ ។
បើ តាម ក្រសួង សុខាភិបាល ថៃ ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ មាន ១២.៥២៧ ករណី ត្រូវបាន រកឃើញ នៅលើ ប្រជាជន ថៃ ទូទៅ និង ១៧០ ករណី ទៀត ត្រូវបាន រកឃើញ នៅលើ អ្នកទោស តាម ពន្ធនាគារ ។ ក្រៅពី ការរកឃើញ ករណី ឆ្លង ថ្មី ៗ ខាងលើ នេះ អ្នកជំងឺ ចំនួន ១៣២ នាក់ បន្ថែម ទៀត ក៏ ត្រូវបាន រាយការណ៍ ថា ស្លាប់ ផងដែរ ក្នុង រយៈពេល ២៤ ម៉ោង ចុងក្រោយ ដូចគ្នា ។ ដោយឡែក អ្នកជំងឺ ចំនួន ១៣. ៥៤០ នាក់ ផ្សេង ទៀត ទើបតែ ត្រូវបាន អនុញ្ញាតឱ្យ ចាកចេញ ពី មន្ទីរពេទ្យ ក្រោយ ជាសះស្បើយ ។
សម្តេច តេជោ ហ៊ុន សែន ធ្លាប់ បាន រៀបរាប់ នៅលើ បណ្តាញ សង្គម យ៉ាង ដូច្នេះ ថា៖
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី សង្កត់ធ្ងន់ ថា « តែ អ្នក ត្រូវ ដឹង ថា ពេលណា នៅ កាន់ តំណែង ជា នាយក រដ្ឋមន្ត្រី ខ្ញុំ មិន ឲ្យ ពួក អ្នក សម្លាប់ ខ្ញុំ បាន ទេ មិន ឲ្យ ពួក អ្នក ធ្វើ រដ្ឋប្រហារ ឬ ធ្វើ បដិវត្ត ពណ៌ បាន ទេ ។ ទោះ ដោយ តម្លៃ ណា ក៏ដោយ ខ្ញុំ ត្រូវការពារ សន្តិភាព និង ការពារ ជីវិត ប្រជាជន កម្ពុជា ឲ្យ ខាន តែ បាន »៕
ខាងក្រោម ជា វីដេអូ ឆ្នាំ ២០១៧ សម្តេច រំលឹក ពី ការប៉ុនប៉ង ធ្វើឃាត សម្តេច៖
នៅក្នុង ជំនួប ជាមួយ លោក ម៉ូឌី . លោកស្រី ហារីស បាន កត់សម្គាល់ យ៉ាង ដូច្នេះ ថា « សហរដ្ឋ អាមេរិក ក៏ ដូចជា ឥណ្ឌា ផងដែរ មាន អារម្មណ៍ ថា មាន មោទនភាព យ៉ាង ខ្លាំង នៅក្នុង ភាព ជា សមាជិក នៃ តំបន់ ឥណ្ឌូ - ប៉ាស៊ីហ្វិក ប៉ុន្តែ ប្រការ នេះ ក៏ ស្ថិត ក្នុង ភាពផុយស្រួយ និង សារៈសំខាន់ ផងដែរ ... បញ្ហា ទាំងនេះ គឺ ទៅ លើ ទំនាក់ទំនង រួម មាន ការរក្សា តំបន់ ឥណ្ឌូ - ប៉ាស៊ីហ្វិក ប្រកបដោយ ភាព សេរី និង បើក ចំហ » ។
ការលើកឡើង របស់ លោក ហ៊ុន ម៉ានី គឺ បាន ធ្វើឡើង ចំនឹង ថ្ងៃ ខួប ទី ២៨ ឆ្នាំ ( ២៤ កញ្ញា ១៩៩៣ - ២៤ កញ្ញា ២០២១ ) ដែល ជា ថ្ងៃ ប្រកាស ឱ្យ ប្រើ រដ្ឋធម្មនុញ្ញ ដែល ជា ច្បាប់ កំពូល និង ជា មូលដ្ឋានគ្រឹះ នៃ ក្របខណ្ឌ ច្បាប់ ក្នុង ការដឹកនាំ កសាង អភិវឌ្ឍន៍ ប្រទេសជាតិ ។
លោក បាន បញ្ជាក់ ថា រដ្ឋធម្មនុញ្ញ របស់ ព្រះរាជាណាចក្រ កម្ពុជា បាន ផ្តល់ឱ្យ ប្រជាពលរដ្ឋ មាន សិទ្ធ សេរីភាព ក្នុង ការរស់នៅ ក្នុង សង្គម នៃ សុខដុម ភាវូបនីយកម្ម ដែល ពោរពេញ ទៅ ដោយ សេចក្តីសុខ សុភមង្គល និង សន្តិភាព ពេញលេញ ពិតប្រាកដ ។
សូម បញ្ជាក់ ថា ចំណុច សំខាន់ ៗ ដែល បាន ចែង ច្បាស់ នៅក្នុង រដ្ឋធម្មនុញ្ញ មាន ដូចជា កម្ពុជា ត្រូវ គោរព ដាច់ខាត នូវ របប រាជានិយម អាស្រ័យ រដ្ឋធម្មនុញ្ញ និង របប ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ។ ព្រះរាជាណាចក្រ កម្ពុជា ជា រដ្ឋ ឯករាជ្យ អធិបតេយ្យ សន្តិភាព អព្យាក្រឹត្យ អចិន្ត្រៃយ៍ មិន ចូល បក្ស សម្ព័ន្ធ ជាដើម ៕
រដ្ឋបាល ខេត្ដ កោះ កុង ផ្អាក ការរៀបចំ ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ ដើម្បី ទប់ស្កាត់ ជំងឺ កូវីដ ១៨
រដ្ឋបាល ខេត្ត ក៏ បាន ធ្វើ ការណែនាំ ដូច ខាងក្រោម ៖
ទី១៖ ផ្អាក ការរៀបចំ ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ ចាប់ពី បិណ្ឌ បួន រហូតដល់ ថ្ងៃ ភ្ជុំ បិណ្ឌ ។
ទី ២៖ អភិបាល ក្រុង ខេមរភូមិន្ទ និង អភិបាល ស្រុក គ្រប់ ស្រុក ត្រូវ ចាត់ចែង រៀបចំ យន្តការ ឱ្យ បាន សមស្រប ដើម្បី ធានា ដល់ ការនាំយក ចង្ហាន់ និង ទេយ្យ វត្ថុ ចាំបាច់ នានា ប្រគេន ដល់ ព្រះសង្ឃ នៅ តាម បណ្តា វត្ត អារាម ក្នុង ដែន សមត្ថកិច្ច របស់ ខ្លួន និង រក្សា សណ្តាប់ធ្នាប់ របៀបរៀបរយ ឱ្យ បាន ល្អ ប្រសើរ ជាពិសេស ការអនុវត្ត នៅ វិធានការ សុខាភិបាល ។
និង ទី៣៖ មន្ទីរ ធម្មការ និង សាសនា ខេត្ត ត្រូវ ចូលរួម សហការ ចាត់ចែង ក្នុង ការរៀបចំ ទទួលយក ចង្ហាន់ ទេយ្យ វត្ថុ ដើម្បី ប្រគេន ព្រះសង្ឃ នៅ តាម បណ្តា វត្ត នានា ៕
គ្រួសារ ខាងលើ នេះ បាន ទទួល សំណង កាលពី ខែកុម្ភៈ ឆ្នាំ ២០០៨ ដោយសារ ពួកគេ មាន សមាជិក គ្រួសារ បាន ស្លាប់ និង ទ្រព្យសម្បត្តិ របស់ ពួកគេ ត្រូវបាន បំផ្លាញ ដោយសារ ប្រតិបត្តិការ យោធា របស់ អង់គ្លេស ។ ប៉ុន្តែ មិន មាន ព័ត៌មាន លម្អិត អ្វី បន្ថែម ចំពោះ ការផ្ដល់ សំណង តិចតួច បំផុត នេះ ទេ ៕
ព្រះមហាក្សត្រ និង សម្តេច ម៉ែ នឹង យាង ត្រឡប់មក ប្រទេស កម្ពុជា វិញ នៅ ថ្ងៃទី ២៥ ខែកញ្ញា ស្អែក នេះ ក្រោយ ពិនិត្យ ព្រះរាជ សុខភាព នៅ ក្រុង ប៉េកាំង (Video inside) ( ភ្នំពេញ ) ៖ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ កម្ពុជា និង សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នឹង យាង ត្រឡប់មក ប្រទេស កម្ពុជា វិញ នៅ រសៀល ថ្ងៃទី ២៥ ខែកញ្ញា ឆ្នាំ ២០២១ ក្រោយ ពិនិត្យ ព្រះរាជ សុខភាព នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន ។
សម្ដេច ហេង សំរិន៖ រយៈពេល ២៨ ឆ្នាំ រដ្ឋសភា តែង បាន បំពេញ តួនាទី របស់ ខ្លួន ស្រប តាម រដ្ឋធម្មនុញ្ញ
( ភ្នំពេញ ) ៖ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៅ ព្រឹក ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន លើកឡើង ថា រយៈពេល ២៨ ឆ្នាំ កន្លងមក រដ្ឋសភា តែង បាន បំពេញ តួនាទី របស់ ខ្លួន ស្រប តាម រដ្ឋធម្មនុញ្ញ ក្នុង ការចូលរួម លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ និង ការអភិវឌ្ឍ ប្រទេសជាតិ ។
ការលើកឡើង របស់ សម្តេច ប្រធាន រដ្ឋសភា ចំនឹង ខួប ទី ២៨ ឆ្នាំ ( ២៤ កញ្ញា ១៩៩៣ - ២៤ កញ្ញា ២០២១ ) នៃ ថ្ងៃ ប្រកាស ឲ្យ ប្រើ រដ្ឋធម្មនុញ្ញ ដែល ជា ច្បាប់ កំពូល និង មូលដ្ឋានគ្រឹះ នៃ ក្របខណ្ឌ ច្បាប់ ក្នុង ការដឹកនាំ កសាង អភិវឌ្ឍន៍ ប្រទេសជាតិ ។
សម្ដេច ហេង សំរិន បាន បន្ដ ថា រដ្ឋធម្មនុញ្ញ ឆ្នាំ ១៩៩៣ បាន ធ្វើឲ្យ ប្រទេស កម្ពុជា យើង បាន វិលត្រឡប់ មកកាន់ « ព្រះរាជាណាចក្រ កម្ពុជា » សារជាថ្មី ឡើងវិញ ក្រោយពី យើង បាន បញ្ចប់ សង្រ្គាម ស៊ីវិល និង មាន ការបោះឆ្នោត ដោយ សេរី ជា សកល លើក ទី១ នៅ ឆ្នាំ ១៩៩៣ និង បាន នាំមក នូវ សុខ សន្តិភាព ការបង្រួបបង្រួម ជាតិ និង វឌ្ឍនភាព នៅក្នុង សង្គមជាតិ របស់ យើង រហូតមកដល់ សព្វ ថ្ងៃ នេះ ។
សម្ដេច ហេង សំរិន បាន បន្ថែម ទៀត ថា សូម ជន រួម ជាតិ គោរព ការពារ និង អនុវត្ត តាម ច្បាប់ រដ្ឋធម្មនុញ្ញ សំដៅ កសាង និង លើកកម្ពស់ នីតិរដ្ឋ នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា យើង រួបរួម គ្នា ពង្រឹង ឯកភាព ជាតិ រក្សា ការពារ ទឹកដី កម្ពុជា អធិបតេយ្យ និង អារ្យធម៌ អង្គរ ដ៏ បវរ របស់ ជាតិ សាសន៍ យើង ក្នុង ការដឹកនាំ មាតុ ប្រទេស ឆ្ពោះ ទៅជា កោះសន្តិភាព រុងរឿង ថ្កុំថ្កើងត រៀង ទៅ ។
រដ្ឋធម្មនុញ្ញ ដែល ចាប់កំណើត ក្រោយ វិបត្តិ ភ្លើង សង្គ្រាម មាន អាយុកាល ២៨ ឆ្នាំ ហើយ
( ភ្នំពេញ ) ៖ រដ្ឋធម្មនុញ្ញ ជា ច្បាប់ កំពូល សម្រាប់ ប្រទេស កម្ពុជា ដែល ប្រកាន់ នូវ របប ប្រជាធិបតេយ្យ ។ រដ្ឋធម្មនុញ្ញ គ្រប់គ្រង បញ្ហា អធិបតេយ្យភាព តួនាទី និង ឋានៈ របស់ ព្រះមហាក្សត្រ សិទ្ធិ ជា មូលដ្ឋាន របស់ ប្រជាពលរដ្ឋ ខ្មែរ សេដ្ឋកិច្ច ការអប់រំ វប្បធម៌ និង កិច្ចការ សង្គម ការប្រព្រឹត្តទៅ នៃ រដ្ឋសភា ព្រឹទ្ធសភា សមាជ និង រាជ រដ្ឋាភិបាល ការប្រព្រឹត្តទៅ នៃ ស្ថាប័ន តុលាការ ក្រុមប្រឹក្សា ធម្មនុញ្ញ រដ្ឋបាល និង សភា ជាតិ ។
ជាពិសេស រដ្ឋធម្មនុញ្ញ ក៏ ជា បន្ទាត់ ក្រឹត្យ មួយ សម្រាប់ តម្រង់ ទិស ឲ្យ ប្រជាពលរដ្ឋ កម្ពុជា រស់ នៅ ទៅតាម ច្បាប់ ។ មិន តែ ប៉ុណ្ណោះ រាល់ ច្បាប់ និង ឯកសារ គតិយុត្ត ទាំងឡាយ របស់ ព្រះរាជាណាចក្រ កម្ពុជា ត្រូវ អនុលោម ទៅតាម រដ្ឋធម្មនុញ្ញ បើ ពុំ នោះ សោត ច្បាប់ និង ឯកសារ គតិយុត្ត ទាំងនោះ នឹង អធ មនុញ្ញភាព ។
រដ្ឋធម្មនុញ្ញ ដែល កម្ពុជា កំពុង និង ប្រើប្រាស់ នា ពេល បច្ចុប្បន្ន នេះ បាន កើតឡើង ជាថ្មី បន្ទាប់ពី សង្រ្គាម ដ៏ រ៉ាំរៃ ជាច្រើន ទសវត្សរ៍ ត្រូវបាន បញ្ចប់ ក្រោម ជំនួប កិច្ចចរចា ស្វែងរក សន្តិភាព ទីក្រុង ប៉ារីស ២៣ តុលា ១៩៩១ ។ រដ្ឋធម្មនុញ្ញ នេះ ក៏ ជា សារ បង្ហាញ ពី ស្មារតី រួបរួម សាមគ្គីភាព របស់ ប្រមុខ ដឹកនាំ ខ្មែរ រួម មាន សម្តេច ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ ដែល ជា មេដឹកនាំ ចលនា តស៊ូ និង សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រដ្ឋាភិបាល សម័យ រដ្ឋ កម្ពុជា ។
លោក អ៉ឹម ឈុន លឹម ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ បាន ថ្លែង ថា រដ្ឋធម្មនុញ្ញ ដែល កំពុង ប្រើ បច្ចុប្បន្ន នេះ គឺជា ច្បាប់ កំពូល កើត ចេញ ពី ឆន្ទៈ រួម របស់ ប្រជារាស្ត្រ ខ្មែរ គ្រប់ និន្នាការ នយោបាយ បាន ក្លាយជា មូលដ្ឋាន គតិយុត្ត ដ៏ រឹងមាំ សម្រាប់ កសាង កម្ពុជា ឲ្យ មាន សន្តិភាព ស្ថិរភាព និង វឌ្ឍនភាព ប្រកបដោយ ចីរភាព ។
ប្រធាន ក្រុមប្រឹក្សា ធម្មនុញ្ញ បាន លើកឡើង ដែរ ថា រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា គឺជា សមិទ្ធផល ប្រវត្តិសាស្ត្រ បន្ទាប់ពី ប្រជាជាតិ ខ្មែរ សម្រេចបាន កិច្ចព្រមព្រៀង ស្ដីពី ដំណោះស្រាយ នយោបាយ រួម មួយ នៃ ជម្លោះ កម្ពុជា នៅក្នុង សន្និសីទ ទីក្រុង ប៉ារីស ស្តីពី កម្ពុជា ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ១៩៩១ ។
* រដ្ឋធម្មនុញ្ញ លើក ទី ៣៖ គឺជា រដ្ឋធម្មនុញ្ញ របស់ កម្ពុជា ប្រជាធិបតេយ្យ ដែល មាន តែ ២១មាត្រា ចែកចេញ ជា ១៦ជំពូក ហើយ ត្រូវបាន អនុម័ត នៅ ថ្ងៃទី ៥ ខែមករា ឆ្នាំ ១៩៧៦ ។ រដ្ឋធម្មនុញ្ញ កម្ពុជា ប្រជាធិបតេយ្យ នេះ ដែល ធ្វើឲ្យ មាន ការផ្លាសស់ប្តូរ របប គ្រប់គ្រង រដ្ឋ នៅក្នុង ប្រទេស ខ្មែរ ពី របប សារធារណរដ្ឋ ប្រែ ទៅជា របស កុម្មុនីសផ្តាច់ការ សម្លាប់ រង្គាល លើ ប្រជាជន ខ្លួន ឯង ក្នុង អំឡុង ពេល បី ឆ្នាំ ៨ខែ និង ២០ ថ្ងៃ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៣៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែកញ្ញា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៧ នាក់ នោះ មាន ២២ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៣ករណី និង ជនសង្ស័យ ១៥នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១០ករណី ។
សូម ពាក់ ខ្សែក្រវាត់ សុវត្ថិភាព ជានិច្ច ពេល ធ្វើដំណើរ តាម រថយន្ត ! គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ២៣ ខែកញ្ញា ម្សិលមិញ ស្លាប់ ៦នាក់ និង របួស ៨នាក់
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ម្សិលមិញ មាន គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ចំនួន ៩ករណី បណ្តាលឲ្យ មាន អ្នកស្លាប់ ចំនួន ៦នាក់ និង របួស ចំនួន ៨នាក់ ។ នេះ បើ តាម របាយការណ៍ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
សេចក្តីសម្រេច របស់ រាជ រដ្ឋាភិបាល ដែល ចុះហត្ថលេខា ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន សម្រេច ដូច ខាងក្រោម៖
( ពិភពលោក ) ៖ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ១៖ នាយក រដ្ឋមន្ត្រី អង់គ្លេស ប្រាប់ បារាំង ឲ្យ « អត់ធ្មត់ បន្តិច » និង ទុក ឱកាស ឲ្យ អង់គ្លេស អាមេរិក និង អូស្ត្រាលី បាន ធូរស្រាល
២៖ អាមេរិក និង អង់គ្លេស បង្ហាញ ការស្វាគមន៍ ចំពោះ ចិន ជុំវិញ ការប្តេជ្ញាចិត្ត ដោះស្រាយ បញ្ហា បម្រែបម្រួល អាកាសធាតុ
៦៖ អ្នកការទូត ជាន់ ខ្ពស់ អាមេរិក ប្រចាំ ប្រទេស ហៃ ទី ប្រកាស លា លែង ចេញ ពី តំណែង ជុំវិញ ការប្រព្រឹត្ត អំពើ អមនុស្សធម៌ ចំពោះ អន្តោប្រវេសន៍ ទេសាភិបាល រង ធនាគារ ជាតិ កិច្ចប្រជុំ គណៈកម្មាធិការ ប្រតិបត្តិ (SEACEN EXCO) លើក ទី ២០
កិច្ចប្រជុំ នេះ ដឹកនាំ ដោយ ធនាគារ កណ្តាល ព្រុយណេ ដែល ជា ប្រធាន ក្នុង អាណត្តិ នេះ និង មាន ការចូលរួម ពីសំណាក់ ទេសាភិបាល រង ធនាគារ កណ្តាល និង អាជ្ញាធរ រូបិយវត្ថុ ដទៃ ទៀត ដែល ជា សមាជិក មជ្ឈមណ្ឌល ស៊ាសិន (SEACEN) ព្រមទាំង តំណាង មកពី ធនាគារ សម្រាប់ ការទូទាត់ អន្តរជាតិ (BIS) ។
សិក្ខាសាលា ជាន់ ខ្ពស់ ដែល សហការរៀបចំ ដោយ មជ្ឈមណ្ឌល ស៊ាសិន និង ធនាគារ BIS លើ ប្រធានបទ « ការផ្លាស់ប្តូរ នៃ លំហូរ មូលធន ទៅកាន់ ប្រទេស កំពុង លូតលា ស់៖ ការគ្រប់គ្រង លំហូរ មូលធន និង ការដក វិញ នៃ នយោបាយ រូបិយវត្ថុ វិត្ថារកម្ម » ។
ទន្ទឹម នេះ កិច្ចប្រជុំ SEACEN EXCO បាន ពិភាក្សា និង អនុម័ត លើ លទ្ធផល ការងារ មួយចំនួន ដូច ជា៖ សកម្មភាព ប្រតិបត្តិ របស់ មជ្ឈមណ្ឌល ស៊ាសិន ការបណ្តុះបណ្តាល និង ស្រាវជ្រាវ ការគ្រប់គ្រង ថវិកា ឆ្នាំ ២០២១ គម្រោង ថវិកា សម្រាប់ ឆ្នាំ ២០២២ និង ការផ្តល់ សិទ្ធិ ដល់ នាយក ប្រតិបត្តិ ស៊ាសិន សម្រាប់ ដោះស្រាយ ការងារ ប្រចាំ ថ្ងៃ ជាដើម ។
គួរ រំលេច ថា មជ្ឈមណ្ឌល ស៊ាសិន បាន រួមចំណែក ដ៏ សំខាន់ ក្នុង ការជួយ ពង្រឹង សមត្ថភាព ជំនាញ របស់ មន្ត្រី - បុគ្គលិក ធនាគារ កណ្តាល ដែល ជា សមាជិក តាមរយៈ ការបណ្តុះបណ្តាល និង ស្រាវជ្រាវ ហើយ ធនាគារ ជាតិ នៃ កម្ពុជា ដែល ជា សមាជិក ដ៏ សកម្ម មួយ របស់ មជ្ឈមណ្ឌល បាន រួមចំណែក ធ្វើជា ម្ចាស់ ផ្ទះ រៀបចំ វគ្គ បណ្តុះបណ្តាល ស៊ាសិន នា ពេល កន្លងមក ផងដែរ ៕ វិភាគ អន្តរជា តិ៖ តើ ចិន ពិតជា គំរាមកំហែង ដល់ សណ្ដាប់ធ្នាប់ ពិភពលោក ដូច អាមេរិក ចោទ មែន ឬ ?
( វ៉ាស៊ីនតោន ) ៖ នា ឱកាស ថ្លែង សុន្ទរកថា ទៅកាន់ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ ជា លើក ដំបូង នៅក្នុង អាណត្តិ របស់ ខ្លួន នៅ ថ្ងៃអង្គារ ទី ២១ ខែកញ្ញា នេះ លោក ប្រធានាធិបតី ចូ បៃ ដិន បាន និយាយ ថា សហរដ្ឋ អាមេរិក មិន មាន ចេតនា បង្ក « សង្រ្គាម ត្រជាក់ » ជាមួយ ប្រទេស ណាមួយ ឡើយ ហើយក៏ មិន ចង់ ឃើញ ពិភពលោក បែកបាក់ គ្នា ឬ បែងចែក បក្ខពួក នោះ ដែរ ។
វោហា ស័ព្ទ និង គោល នយោបាយ តឹងរ៉ឹង ចំពោះ ចិន បែប នេះ វា ទាក់ទាញ បាន ប្រជាប្រិយភាព និង ការគំាទ្រ ខ្លាំង នៅក្នុង ស្រុក ប៉ុន្តែ ថា តើ វា នឹង មាន ប្រសិទ្ធភាព សម្រាប់ នយោបាយ ការបរទេស ដែរ ឬ ក៏ យ៉ាងណា ? ក្រុម អ្នកជំនាញ ភាគ ច្រើន យល់ ថា ចិន មិន បាន បង្ក ការគំរាមកំហែង ជាក់ស្ដែង ដូច ដែល អតីត សហភាព សូវៀត បាន បង្កឡើង នោះ ទេ ហើយ ការគិត បែប នេះ គឺ មាន មូលហេតុ ២៖
គួរ បញ្ជាក់ ថា បើ តាម ក្រុម អ្នកជំនាញ ជា យុទ្ធសាស្ត្រ របស់ ចិន ក្នុង រយៈពេល មធ្យម ចិន គ្រាន់តែ ចង់ ក្លាយជា មហាអំណាច នៅក្នុង តំបន់ អាស៊ី ខាងកើត ដើម្បី ស្មើ មុខ ស្មើ មាត់ នឹង សហរដ្ឋ អាមេរិក និង មាន តួនាទី ក្នុង ការចូលរួម ចាត់ចែង សណ្ដាប់ធ្នាប់ ពិភពលោក ។ ប៉ុន្តែ នេះ វា មិន មែន មាន ន័យ ថា ចិន អាច ឬ ចង់ ដាក់ សណ្ដាប់ធ្នាប់ ពិភពលោក គ្រប់គ្រង ដោយ ចិន នោះ ទេ តែ អ្វី ដែល ចិន ចង់ ប្រហែលជា ការបញ្រ្ជាប ប្រព័ន្ធ នយោបាយ និង គុណ តម្លៃ របស់ ចិន លើ បណ្ដា ប្រទេស ដទៃ ។
អាមេរិក និង បណ្ដា ប្រទេស លោក ខាងលិច តែងតែ ចោទប្រកាន់ ចិន ថា ជា អ្នក បំផ្លាញ ប្រជាធិបតេយ្យ ប៉ុន្តែ ធាតុ ពិត ប្រជាជាធិបតេយ្យ មិន មែន រង ការគំរាមកំហែង តែ ពី ខាងក្រៅ ទេ ពោលគឺ សូម្បីតែ នៅ សហរដ្ឋ អាមេរិក ប្រជាធិបតេយ្យ ក៏ ធ្លាប់ ត្រូវបាន គេ សម្លាប់ ដែរ នៅក្រោយ ក្រុម អ្នកគាំទ្រ អតីត ប្រធានាធិបតី លោក ដូណាល់ ត្រាំ ចូល អុក ឡុក វិមាន សភា ជាតិ កាលពី ថ្ងៃទី ០៦ ខែមករា ឆ្នាំ ២០២១ ជា ពេល មួយ ដែល កាសែត អាមេរិក ធំ ៗ ដាក់ ចំណងជើង នៅលើ ក្រប ទំព័រ មុខ របស់ ខ្លួន ថា « ថ្ងៃ ដែល ប្រជាធិបតេយ្យ ស្លាប់ »៕
អ្នកការទូត ជាន់ ខ្ពស់ អាមេរិក ប្រចាំ ប្រទេស ហៃ ទី ប្រកាស លា លែង ចេញ ពី តំណែង ជុំវិញ ការប្រព្រឹត្ត អំពើ អមនុស្សធម៌ ចំពោះ អន្តោប្រវេសន៍
ទន្ទឹម នឹង នោះ លោក បាន សង្កត់ធ្ងន់ ថា លោក បាន ថ្កោល ទោស ចំពោះ ការសម្រេចចិត្ត ដ៏ អមនុស្សធម៌ ដែល បាន និរទេស ជនភៀសខ្លួន ហៃ ទី រាប់ ពាន់ នាក់ ខណៈ ដែល អនុសាសន៍ ផ្ទាល់ខ្លួន របស់ លោក ត្រូវបាន គេ « មិន អើពើ និង ច្រានចោល » ។
កាលពី សប្តាហ៍ មុន ជន អន្តោប្រវេសន៍ ជាង ១៥.០០០ នាក់ ដែល ភាគ ច្រើន ជា ជនជាតិ ហៃ ទី ត្រូវបាន គេ មើលឃើញ ថា បាន ប្រមូលផ្តុំ គ្នា នៅ ស្ពាន អាកាស មួយ នៅ ទីក្រុង Del Rio រដ្ឋ តិចសាស់ ខណៈ ឆ្មាំ ការពារ អាមេរិក មួយចំនួន បាន ជិះ សេះ ដេញ តាម ចាប់ និង បណ្ដេញ ពួកគេ ចេញ ពី ទឹកដី អាមេរិក ហើយ រូបភាព នៃ សកម្មភាព នេះ ត្រូវបាន បង្ហោះ លើ បណ្ដាញ ទំនាក់ទំនង សង្គម ។
គួរ បញ្ជាក់ ថា ក្រុម អ្នកលេង បណ្ដេញ ទំនាក់ទំនង សង្គម ខ្លះ បាន ប្រដូច រូបភាព ឆ្មាំ ការពារ ព្រំដែន អាមេរិក ជិះ សេះ ទៅនឹង ប្រវត្តិសាស្ត្រ នៃ ការធ្វើ ទុក្ខបុកម្នេញ លើ ជនជាតិ ស្បែក ខ្មៅ នៅលើ ទឹកដី អាមេរិក កាលពី អតីតកាល ហើយ ប្រធាន ឆ្មាំ ការពារ ព្រំដែន អាមេរិក លោក Raul Ortiz បាន ឱ្យដឹង ការស៊ើបអង្កេត មួយ ត្រូវបាន ធ្វើឡើង ដើម្បី ដឹង ឱ្យ ប្រាកដ ថា តើ ថា ការជិះ សេះ គំរាមកំហែង ជន អន្តោប្រវេសន៍ ដោយ ក្រុម មន្ត្រី អនុវត្ត ច្បាប់ គឺជា រឿង មិន ត្រឹមត្រូវ ឬ ក៏ យ៉ាងណា ៕
រដ្ឋបាល ខេត្ត តាកែវ សម្រេច បិទ ខ្ទប់ ភូមិ ចំនួន ៣ ក្នុង ឃុំ ព្រៃ កប្បាស និង ឃុំ អង្កាញ់ ស្រុក ព្រៃ កប្បាស ជា បណ្តោះអាសន្ន បន្ទាប់ពី រកឃើញ អ្នកជំងឺ ១៩ បំប្លែង ថ្មី Delta
រដ្ឋបាល ខេត្ត បាន សម្រេច យ៉ាង ដូច្នេះ ថា៖ « ត្រូវបាន បិទ ខ្ទប់ ភូមិសាស្ត្រ ភូមិ ត្រពាំង ក្រូច ភូមិ ព្រៃ ព្រំ ឃុំ ព្រៃ កប្បាស និង ភូមិ ព្រីង ឃុំ អង្កាញ់ ស្រុក ព្រៃ កប្បាស ខេត្ត តាកែវ ដែល ជា តំបន់ មាន ការឆ្លង រាលដាល នៃ មេរោគ បំប្លែង ថ្មី ប្រភេទ Delta ចាប់ពី ម៉ោង ១៦៖០០ នាទី រសៀល ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី » ។
បើ តាម សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា ការសម្រេច បិទ ខ្ទប់ ភូមិ ទាង ៣នេះ គឺ ធ្វើឡើង នៅក្នុង គោលបំណង ដើម្បី កាត់ផ្តាច់ការឆ្លង រាលដាល នៃ មេរោគ បំប្លែង ថ្មី ប្រភេទ Delta នៅក្នុង ភូមិសាស្ត្រ ដែល ត្រូវបាន បិទ ខ្ទប់ និង ទប់ស្កាត់ ជំងឺ នេះ មិន ឱ្យ ឆ្លង រាលដាល ទៅ តំបន់ ផ្សេង ៗ ទៀត ៕
( ភ្នំពេញ ) ៖ ព្រះសិរី កោសល សុំ សុខា ព្រះរាជា គណៈ កិត្តិយស នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រះវិន័យ ធរ គណ រាជធានី ភ្នំពេញ ព្រះគ្រូ សង្ឃ សរណ វេទី ព្រះអនុគណខណ្ឌ កំបូល និង ជា ព្រះចៅ អធិការ វត្ត ភ្នៀត សិម្ព លី សង្កាត់ ស្នោរ ខណ្ឌ កំបូល បាន បកស្រាយ ថា បើ យើង គ្មាន ធនធាន គ្រប់គ្រាន់ យើង មិន ចាំបាច់ ធ្វើ បុណ្យ ឲ្យបាន គ្រប់ ៧វត្ត នៅ រដូវ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ និង កាន់ បិណ្ឌ ក៏ បាន ដែរ ។
ការបកស្រាយ របស់ ព្រះតេជគុណ ធ្វើឡើង បន្ទាប់ពី មាន ការលើកឡើង ថា បុគ្គល ណា មិន បាន ទៅ ធ្វើ បុណ្យ ៧វត្ត ក្នុង រដូវកាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ នឹង ត្រូវ ឪពុក ម្តាយ ជីដូន ជីតា និង សាច់ញាតិ ដែល ស្លាប់ ទៅ ហើយ កើត ជា ប្រេត ដាក់ បណ្តាសារ ។ ព្រះសិរី កោសល សុំ សុខា ពន្យល់ ថា នេះ ជា ការលើកឡើង ត ៗ គ្នា តាំងពី បុរាណកាល តែ ប៉ុណ្ណោះ ពោលគឺ មិន មាន ការចែង ទុក ក្នុង តម្រា ផ្លូវការ អ្វី ឡើយ ៕
សូម ទស្សនា វីដេអូ ខាងក្រោម៖ អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន ប្រគល់ ជូន លោកយាយ អាយុ ១០០ ឆ្នាំ ម្នាក់ បន្ថែម ទៀត នៅ ខេត្ត កំពង់ធំ ក្រោយ ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង កូវីដ១៩
( កំពង់ធំ )៖ លោកយាយ អាយុ ១០០ ឆ្នាំ ឡើង ម្នាក់ បន្ថែម ទៀត នៅ ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ទទួលបាន អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា បន្ទាប់ពី រូប គាត់ បាន ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ។
អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ត្រូវបាន លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្របខ័ណ្ឌ ទូទាំង ប្រទេស នាំយក ទៅ ប្រគល់ ជូន ដល់ ខ្នង ផ្ទះ នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
លោកយាយ ដែល ទទួលបាន អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ឈ្មោះ ហោ ហ៊ូ អាយុ ១០០ ឆ្នាំ រស់ នៅ ភូមិ ធន់ មោង ឃុំ កំពង់ថ្ម ស្រុក សន្ទុក ខេត្ត កំពង់ធំ ។
ក្នុង ឱកាស នោះ លោកស្រី ឱ វណ្ណឌីន បាន នាំ នូវ ការផ្ដាំផ្ញើ សាកសួរ សុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ជូន លោកយាយ ហោ ហ៊ូ ព្រមទាំង បាន ជម្រាប សាកសួរ អំពី ស្ថានភាព សុខភាព ក្រោយពី ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ផងដែរ និង មូលហេតុ អ្វី ដែល ជំរុញ ឲ្យ រូប គាត់ ទៅ ទទួលយក នូវ ការចាក់ វ៉ាក់សាំង ។
សូម ជម្រាប ថា ការយក អំណោយ របស់ សម្ដេច តេជោ ហ៊ុន សែន ផ្ដល់ជូន លោកតា និង លោកយាយ នា ឱកាស នេះ ធ្វើឡើង បន្ទាប់ពី លោកស្រី ឱ វណ្ឌ ឌីន បាន បញ្ចប់ ពី ពិធី ប្រគល់ អំណោយ ជូន លោក តា លោកយាយ អាយុ ១០០ ឆ្នាំ ឡើង នៅ ខេត្ត រតនគិរី . ខេត្ត ស្ទឹងត្រែង . ខេត្ត ព្រះវិហារ . ខេត្ត កំពង់ចាម និង ខេត្ត តាកែវ កាលពី ដើម សប្ដាហ៍ នេះ ៕
សេចក្តីប្រកាស រួម សន្និសីទ លើក ទី៨ គណៈកម្មការ កិច្ចការ បរទេស នៃ សភា កម្ពុជា - ឡាវ - វៀតណាម ស្តីពី « ការជំរុញ ភាពជាដៃគូ សភា ដើម្បី ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង ការឆ្លើយតប ចំពោះ វិបត្តិ កូវីដ - ១៩ ក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ CLV
( ភ្នំពេញ ) ៖ សន្និសីទ លើក ទី៨ នៃ គណៈកម្មការ កិច្ចការ បរទេស សភា នៃ ប្រទេស កម្ពុជា - ឡាវ - វៀតណាម ក្រោម មូល បទ ស្តីពី « ការជំរុញ ភាពជាដៃគូ សភា ដើម្បី ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព និង ការឆ្លើយតប ចំពោះ វិបត្តិ កូវីដ - ១៩ ក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ កម្ពុជា - ឡាវ - វៀតណាម (CLV)» ត្រូវបាន រៀបចំឡើង ដោយ គណៈកម្មការ កិច្ចការ បរទេស សហប្រតិបត្ដិការ អន្ដរជាតិ ឃោសនា ការ និង ព័ត៌មាន នៃ រដ្ឋសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នៅ រាជធានី ភ្នំពេញ តាម ប្រព័ន្ធ និម្មិត ។
សន្និសីទ នេះ រៀបចំឡើង ក្នុង គោលបំណង ដើម្បី ពង្រឹង ភាពជាដៃគូ សភា និង ទំនាក់ទំនង មិត្តភាព ជា ប្រពៃណី នៃ សភា ប្រទេស ទាំង បី ព្រមទាំង ពន្លឿន ការស្តារ ឡើងវិញ នូវ សេដ្ឋកិច្ច និង ជីវភាព រស់ នៅ របស់ ប្រជាជន នៅក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ នៃ ប្រទេស ទាំង បី កម្ពុជា - ឡាវ - វៀតណាម ដែល ទទួលរង ផល ប៉ះពាល់ បណ្តាល មកពី វិបត្តិ ជំងឺ កូវីដ - ១៩ ។ ក្រោយ សន្និសីទ នេះ ភាគី ទាំង បី បាន ចេញ សេចក្តីប្រកាស រួមគ្នា ផងដែរ ៕
សូម អាន សេចក្តីប្រកាស រួម ខាងក្រោម៖ រដ្ឋមន្ត្រី ការបរទេ ស៖ តាលី បង់ ចង់ មាន ទំនាក់ទំនង ល្អ ជាមួយ សហគមន៍ អន្តរជាតិ ទាំងអស់ រួមទាំង ប្រទេស ជិតខាង ផងដែរ
( កាប៊ុល) ៖ រដ្ឋមន្ត្រី ការបរទេស ស្តីទី នៃ រដ្ឋបាល អាហ្វហ្កានីស្ថាន ដែល ទើប បង្កើត ថ្មី បាន និយាយ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ ថា អាហ្វហ្គានីស្ថាន ចង់ មាន ទំនាក់ទំនង ជា មិត្តភាព ជាមួយ សហគមន៍ អន្តរជាតិ ទំាង អស់ រួមទាំង ប្រទេស ជិតខាង និង តំបន់ ផងដែរ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ សារព័ត៌មាន ស៊ីន ហួរ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ។
លោក Muttaqi ក៏ បាន និយាយ ផងដែរ ថា អាហ្វហ្គានីស្ថាន នឹង មិន ត្រូវបាន ប្រើប្រាស់ ដើម្បី ប្រឆាំង នឹង ប្រទេស ណាមួយ ឡើយ ហើយ រដ្ឋបាល ថ្មី នឹង មិន អនុញ្ញាតឱ្យ នរណា ម្នាក់ ប្រើ ដី អាហ្វហ្គានីស្ថាន ដើម្បី ប្រឆាំង នឹង នរណា ម្នាក់ ដែរ ។
លោក បាន មានប្រសាសន៍ ថា « អាហ្វហ្គានីស្ថាន ដែល មាន សន្តិភាព និង ស្ថិរភាព គឺជា ផលប្រយោជន៍ របស់ ប្រទេស ជិតខាង តំបន់ និង ពិភពលោក ទាំងមូល ។ ហើយ ការដាក់ សម្ពាធ លើ អាហ្វហ្គានីស្ថាន នឹង មិន ផ្តល់ ផលប្រយោជន៍ ដល់ នរណា ម្នាក់ ឡើយ »៕
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ នា ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្ដីសម្រេច បិទ ខ្ទប់ វត្ត មុនី សុវណ្ណ ហៅ វត្ត ចំពុះ ក្អែក មាន ទីតាំង នៅ ភូមិ ចំពុះ ក្អែក សង្កាត់ ព្រែក ថ្មី ខណ្ឌ ច្បារអំពៅ ចាប់ពី ថ្ងៃទី ២៣ ខែកញ្ញា ដល់ ថ្ងៃទី ០៦ ខែតុលា ដោយសារ មាន ការឆ្លង រាលដាល ជំងឺ កូវីដ - ១៩ ៕
ខង ក្រោម នេះ ជា សេចក្ដីសម្រេច របស់ រដ្ឋបាល រាជធានី ភ្នំពេញ៖
( ស្វាយរៀង ) ៖ ក្រុមការងារ ស្រាវជ្រាវ និង ស្វែងរក អ្នក ប៉ះពាល់ អ្នកជំងឺ កូវីដ១៩ ខេត្ត បាន រកឃើញ ព្រះសង្ឃ គង់ នៅ វត្ត កំពង់ត្រា ច ស្ថិត នៅ ភូមិ តា ត្រាវ ឃុំ កំពង់ត្រា ច ស្រុក រមាសហែក មាន មេរោគ កូវីដ១៩ បំប្លែង ថ្មី Delta កាលពី ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០២១ ។
រដ្ឋបាល ខេត្ត ស្វាយរៀង សូម បងប្អូន ដែល ពាក់ព័ន្ធ ទាំង ផ្ទាល់ និង ប្រយោល សូម ធ្វើចត្តាឡី ស័ក តាមដាន សុខភាព អនុវត្ត តាម វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ « ៣ការពារ និង ៣កុំ » របស់ សម្ដេច តេជោ ហ៊ុន សែន នឹង ស្ម័គ្រចិត្ត ទៅ យក វត្ថុ វិភាគ សំណាក នៅ តាម ទីតាំង យក សំណាក នៅជិត ផ្ទះ ។
សម្រាប់ អ្នក ដែល គ្មាន រោគសញ្ញា សូម ដាក់ ខ្លួន ដាច់ដោយឡែក និង តាមដាន សុខភាព របស់ ខ្លួន រយៈពេល ២១ ថ្ងៃ ចាប់ពី ថ្ងៃ ដែល អ្នក បាន ប៉ះពាល់ ឬ ទៅ ទីកន្លែង នោះ ៕ អ្នកលក់ អង្ករ ជាង មាស និង គ្រឿង ក្រអូប ៣នាក់ នៅ ផ្សារ វាល យន្ត ឆ្លង កូវីដ ប្រភេទ ថ្មី ដែល តា . រដ្ឋបាល ខេត្ត ស្វាយរៀង អំពាវនាវ អ្នក ពាក់ ពន្ធ័ ប្រញាប់ ទៅ ធ្វើតេស្ត កូវីដ
( ស្វាយរៀង ) ៖ ក្រុមការងារ ស្រាវជ្រាវ និង ស្វែងរក អ្នក ប៉ះពាល់ អ្នកជំងឺ កូវីដ១៩ ខេត្ត សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ អាជីវករ កម្មករ - កម្ម ការិនី ដែល ធ្លាប់ ទៅ ផ្សារ វាល យន្ត នៅ សង្កាត់ ស្វាយរៀង ក្រុង ស្វាយរៀង សូម ទៅ ធ្វើតេស្ត រក កូវីដ១៩ ដោយសារ មាន អ្នកលក់ អង្ករ ជាង មាស និង អ្នកលក់ គ្រឿង ក្រអូប ចំនួន ៣នាក់ រកឃើញ មេរោគ កូវីដ១៩ បំប្លែង ថ្មី Delta កាលពី ថ្ងៃទី ១៨ ខែកញ្ញា ឆ្នាំ ២០២១ ។
រដ្ឋបាល ខេត្ត សូម បងប្អូន ដែល ពាក់ព័ន្ធ ទាំង ផ្ទាល់ និង ប្រយោល សូម ធ្វើចត្តាឡី ស័ក តាមដាន សុខភាព អនុវត្ត តាម វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល និង វិធានការ « ៣ការពារ និង ៣កុំ » របស់ សម្ដេច តេជោ ហ៊ុន សែន នឹង ស្ម័គ្រចិត្ត ទៅ យក វត្ថុ វិភាគ សំណាក នៅ តាម ទីតាំង យក សំណាក នៅជិត ផ្ទះ ។
សម្រាប់ អ្នក ដែល គ្មាន រោគសញ្ញា សូម ដាក់ ខ្លួន ដាច់ដោយឡែក និង តាមដាន សុខភាព របស់ ខ្លួន រយៈពេល ២១ ថ្ងៃ ចាប់ពី ថ្ងៃ ដែល អ្នក បាន ប៉ះពាល់ ឬ ទៅ ទីកន្លែង នោះ ៕
នគរបាល ខេត្ត ព្រះសីហនុ ចាប់ ជនសង្ស័យ ៣នាក់ ក្រោយ ចូល គាស់ ទ្វារ សណ្ឋាគារ លួច យក សម្ភារ មួយចំនួន
( ព្រះសីហនុ) ៖ កាលពី ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌ កម្រិត ធ្ងន់ បាន ទទួល ព័ត៌មាន តាម ទូរស័ព្ទ ពី ឈ្មោះ កែវ ចំរើន អាយុ ៣៧ ឆ្នាំ ជា បុគ្គលិក សណ្ឋាគារ កាស៊ីណូ ស៊ីន នាវ ស្ថិត ក្នុង ភូមិ ៣ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ខេត្ដ ព្រះសីហនុ ថា មាន ករណី គាស់ ទ្វារ ចូលក្នុង សណ្ឋាគារ ធ្វើ សកម្មភាព លួច យក សម្ភារៈ ចេញ ពី ក្នុង ទីតាំង ។
ទទួលបាន ព័ត៌មាន ភ្លាម ស្នងការ នគរបាល ខេត្ត លោក ឧត្តមសេនីយ៍ ទោ ជួន ណារិន្ទ បាន ចាត់ កម្លាំង ជំនាញ ចុះ ទៅកាន់ កន្លែង កើត ហេតុ និង ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ចំនួន ០៣ នាក់ ដែល ធ្វើ សកម្មភាព ក្នុង ទីតាំង នោះ ហើយ ពួកគេ បម្រុង ដឹក សម្ភារ ជាច្រើន ចេញ ពី ក្នុង ទីតាំង រួម មាន៖ ទូទឹកកក . កង្ហា . ម៉ាស៊ីន ត្រជាក់ . ទូបោក ខោអាវ . ចង្ក្រាន ហ្គាស . ម៉ាស៊ីន គិត លុយ . វ៉ាំងនន និង ឈើ តុក្កតា បេង ចំនួន ០៤ ។
ជនសង្ស័យ ដែល ឃាត់ខ្លួន ដូច ខាងក្រោម៖
១ - ឈ្មោះ ឃុន ម៉ៅ អាយុ ៣៧ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ សា្នក់ នៅ ភូមិ ៣ សង្កាត់ លេខ ១ ក្រុង ព្រះសីហនុ ( អ្នកទទួល ផល )២ - ឈ្មោះ ឈាង ចន្ថា ហៅ អាប្រុស អាយុ ២១ ឆ្នាំ មុខរបរ មិន ពិតប្រាកដ ស្នាក់ នៅ បណ្ដោះអាសន្ន ភូមិ៣ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ៣ - ឈ្មោះ ពេជ្រ ចាន់ ថេត អាយុ ២៩ ឆ្នាំ មុខរបរ កម្មករ នេសាទ ស្នាក់ នៅ បណ្ដោះអាសន្ន ក្រុម៣ ភូមិ ៣ សង្កាត់ លេខ ៣ ក្រុង ព្រះសីហនុ ។
សម្ភារ វត្ថុតាង ដកហូត បាន រួម មាន៖ ម៉ូតូ ០១ គ្រឿង និង ឧបករណ៍ សម្រាប់ ធ្វើ សកម្មភាព គាស់ លួច សម្ភារ ជាច្រើន ទៀត រួមទាំង សម្ភារ របស់របរ ប្រើប្រាស់ និង គ្រឿង បរិក្ខា ជាច្រើន ដូច រៀបរាប់ ខាងលើ ។ ជនសង្ស័យ មាន អត្ដសញ្ញាណ ខាងលើ កម្លាំង ជំនាញ បាន នាំមកកាន់ ការិយាល័យ នគរបាល ព្រហ្មទណ្ឌក មិ្រត ធ្ងន់ កំពុង បន្ដ សាកសួរ និង បង្ក សំណុំរឿង ចាត់ការ តាម នីតិវិធី ៕
វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ស៊ីណូ វ៉ាក់ របស់ ក្រុមហ៊ុន ចិន ចំនួន ៣លាន ដូស បន្ថែម ទៀត ដែល ជា ការបញ្ជាទិញ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នោះ បាន ដឹក មកដល់ ប្រទេស កម្ពុជា ហើយ
( ភ្នំពេញ ) ៖ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ស៊ីណូ វ៉ាក់ របស់ ក្រុមហ៊ុន ចិន ចំនួន ៣លាន ដូស បន្ថែម ទៀត ដែល ជា ការបញ្ជាទិញ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នោះ បាន ដឹក មកដល់ ប្រទេស កម្ពុជា ហើយ នៅ ព្រឹក ថ្ងៃសុក្រ ទី២៤ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
បើ តាម ការបញ្ជាក់ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ក្នុង ពេល បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន កុមារ អាយុ ៦ ឆ្នាំ ដល់ ១២ ឆ្នាំ កាលពី ថ្ងៃទី ១៧ ខែកញ្ញា កន្លងទៅ បាន បញ្ជាក់ ថា វ៉ាក់សាំង ដែល កម្ពុជា បាន បញ្ជាទិញ មក នៅ ពេល នេះ គឺ សម្រាប់ បម្រើ ដល់ ការចាក់ ជូន កុមារ អាយុ ៦ ឆ្នាំ ទៅ ១២ឆ្នាំ ។ បើ តាម សម្តេច តេជោ ហ៊ុន សែន នៅ ចុង ខែ នេះ ក៏ នឹង មាន វ៉ាក់សាំង មកដល់ ប្រមាណ ៣លាន ដូស បន្ថែម ទៀត ។
បទបញ្ជា ដាច់ ណាត់ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឱ្យ ល្បឿន នៃ ការចាក់ វ៉ាក់សាំង របស់ កម្ពុជា មាន ភាព លឿន លយ គួរឱ្យ កត់សម្គាល់ ។ គិត ត្រឹម ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ កម្ពុជា ចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ អាយុ ៦ឆ្នាំ ឡើង ទៅ បាន ចំនួន សរុប ជាង ១២.៦លាន នាក់ ស្មើ ជិត ៨០ ភាគរយ នៃ ចំនួន ប្រជាពលរដ្ឋ កម្ពុជា សរុប ១៦លាន នាក់ ។
ការណ៍ នេះ បាន នាំឱ្យ ប្រជាពលរដ្ឋ ខ្មែរ កោត ស្ញប់ស្ញែង និង អរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ កិច្ចប្រឹងប្រែង និង ការតម្កល់ ខ្ពស់ នៃ តម្លៃ ជីវិត របស់ ប្រជាពលរដ្ឋ ពីសំណាក់ សម្តេច តេជោ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ៕
លោកស្រី ឱ វណ្ណឌីន បន្ដ បិទ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជុំទី១ ជូន ប្រជាពលរដ្ឋ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង នៅ ខេត្ត ឧត្ដរ មានជ័យ
( ឧត្តរមានជ័យ )៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្របខ័ណ្ឌ ទូទាំង ប្រទេស នៅ ព្រឹក ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បន្ដ អញ្ជើញ ជា អធិបតីភាព បិទ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជុំទី១ ជូន ប្រជាពលរដ្ឋ ដែល មាន អាយុ ១៨ ឆ្នាំ ឡើង នៅ ខេត្ត ឧត្តរមានជ័យ ។
ក្នុង ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្ដរ មានជ័យ ព្រមទាំង មន្ដ្រី ពាក់ព័ន្ធ ជាច្រើន ទៀត ផងដែរ ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ឧត្តរមានជ័យ ។
លោក ប៉ែន កុសល្យ បាន បញ្ជាក់ ថា ដោយ អនុវត្ត តាម ផែនការ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ ជូន ប្រជាពលរដ្ឋ ដែល មាន អាយុ ចាប់ពី អាយុ ១៨ ឆ្នាំ ឡើង ជុំ ទី១ នៅ ទូទាំង ខេត្ត ឧត្តរមានជ័យ ចំនួន ត្រូវ ចាក់ វ៉ាក់សាំង មាន ចំនួន ១៥៦. ៤៣៦ នាក់ ក្នុង នោះ៖
លោក ប៉ែន កុសល្យ បាន បន្ថែម ថា ដោយ ពិនិត្យ លើ ស្ថានភាព នេះ ទើប រដ្ឋបាល ខេត្ត គោរព ស្នើសុំ បិទ បញ្ចប់ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ - ១៩ ទូទាំង ខេត្ត នា ថ្ងៃ នេះ និង គោរព ស្នើសុំ បើក ដំណើរការ កន្លែង ចាក់ វ៉ាក់សាំង អចិន្ត្រៃយ៍ ចំនួន ០៥កន្លែង ( មួយ កន្លែង ក្នុង មួយ ក្រុង ស្រុក ) ដោយ រដ្ឋបាល ខេត្ត នឹង ចេញ សេចក្តីជូនដំណឹង ជា ផ្លូវការ ដើម្បីឲ្យ ប្រជាពលរដ្ឋ ដែល ពុំ ទាន់ ទទួលបាន ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ មក ទទួលយក សេវា ក្រោយពី ការបិទ បញ្ចប់ យុទ្ធនាការ នេះ តាម គោលដៅ ដូច ខាងក្រោម៖
* ក្រុង សំរោង នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត * ស្រុក បន្ទាយ អំពិល នៅ មណ្ឌល សុខភាព គោក មន* ស្រក ចុង កាល់ នៅ មណ្ឌល សុខភាព ចុង កាល់* ស្រុក អន្លង់ វែង នៅ មន្ទីរពេទ្យ បង្អែក អន្លង់ វែង * ស្រុក ត្រពាំងប្រាសាទ នៅ មណ្ឌល សុខភាព ត្រពាំងប្រាសាទ ។
បន្ថែម ពី នេះ លោកស្រី ឱ វណ្ណឌីន បាន ណែនាំ ដល់ រដ្ឋបាល ខេត្ដ ឧត្តរមានជ័យ ត្រូវ បន្ដ ជំរុញ និង បង្កើន នូវ ការផ្សព្វផ្សាយ យុទ្ធនាការជាតិ ក្រោម ប្រធានបទ រួមគ្នា ទទួលខុសត្រូវ ទប់ស្កាត់ ការចម្លង វីរុស កូវីដ១៩ ដល់ ប្រជាពលរដ្ឋ បន្ថែម ទៀត ដើម្បី បន្ដ ចូលរួម ទប់ស្កាត់ និង ការពារ ជំងឺ កូវីដ១៩ ។
ជាមួយគ្នា នេះ លោកស្រី ឱ វណ្ណឌីន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ដែល រដ្ឋបាល ខេត្ត កំពង់ធំ សម្រេច ក្នុង ផែនការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ។ បន្ថែម ពី នេះ លោកស្រី ក៏ បាន ផ្ដល់ អនុសាសន៍ មួយចំនួន ជូន ដល់ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ ដើម្បី ជំរុញ ការចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ ដែល នៅ សេសសល់ មិន ទាន់ បាន ចាក់ ដោយ ប្រការ ណាមួយ ។
កូរ៉េ ខាងជើង ថា កូរ៉េ ខាងត្បូង អំពាវនាវ ឱ្យ បញ្ចប់ សង្រ្គាម កូរ៉េ គឺ លឿន រហ័ស ពេក ហើយ
ការកត់សម្គាល់ របស់ លោក Ri Thae Song ធ្វើឡើង បន្ទាប់ពី ប្រធានាធិបតី កូរ៉េ ខាងត្បូង លោក មូន ចែ អ៉ីន កាលពី ថ្ងៃអង្គារដើម សប្ដាហ៍ នេះ បាន អំពាវនាវ ឱ្យ មាន ការបិទ បញ្ចប់ សង្រ្គាម កូរ៉េ ជា ផ្លូវការ កំឡុង ពេល លោក ថ្លែង សុន្ទរកថា ទៅកាន់ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ ជាមួយ ការស្នើ ឱ្យ កូរ៉េ ទាំង២ រួម ជាមួយ សហរដ្ឋ អាមេរិក និង ចិន ធ្វើ សេចក្ដីថ្លែងការណ៍ រួមគ្នា មួយ ។
គួរ បញ្ជាក់ ថា កូរ៉េ ទាំង២ សព្វ ថ្ងៃ នៅតែ ស្ថិត នៅក្នុង ស្ថានភាពប្រកាស សង្រ្គាម នឹង គ្នា ជានិច្ច ពីព្រោះថា ក្រោយ បញ្ចប់ សង្រ្គាម កូរ៉េ ( ១៩៥០ - ១៩៥៣ ) កូរ៉េ ទាំង២ បាន ឯកភាព គ្នា តែ លើ បទ ឈប់ បាញ់ តែ ប៉ុណ្ណោះ មិន មែន សន្ធិសញ្ញា សន្តិភាព បញ្ចប់ សង្រ្គាម នោះ ទេ ៕
ចិន៖ « ចំពោះ មុខ បញ្ហា បម្រែបម្រួល អាកាសធាតុ គឺ តម្រូវឲ្យ ពិភពលោក ទាំងមូល រួមគ្នា ដោះស្រាយ »
ហេតុ ដូច្នេះ លោក Zhang Jun ក្នុង នាម ជា តំណាង អចិន្ត្រៃយ៍ របស់ ចិន នៅ UN បាន សង្កត់ធ្ងន់ ប្រាប់ ក្រុមប្រឹក្សា សន្តិសុខ ក្នុង ឱកាស ជជែក វែកញែក ដោយ បើក ចំហ កម្រិត ខ្ពស់ ស្តីពី បញ្ហា អាកាសធាតុ និង សន្តិសុខ ថា វា ជា រឿង ចាំបាច់ ណាស់ ក្នុង ការរក្សា បណ្តាញ សំខាន់ ៗ សម្រាប់ កិច្ចសហប្រតិបត្តិការ អន្តរជាតិ ឆ្លើយតប នឹង ការប្រែប្រួល អាកាសធាតុ ។
( ភ្នំពេញ ) ៖ ក្នុង ការអនុវត្ត វិធានការ នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ សមត្ថកិច្ច ជំនាញ បាន រកឃើញ មនុស្ស ៤នាក់ ទៀត បាន ប្រព្រឹត្ត ល្មើស វិធានការ សុខាភិបាល និង វិធានការ រដ្ឋបាល សរុប ៤ករណី ព្រមទាំង បាន ធ្វើការ ផាកពិន័យ ជា ទឹកប្រាក់ សរុប ចំនួន ៨០ ម៉ឺន រៀល ផងដែរ ។ ក្នុង ចំណោម អ្នក ដែល បាន ល្មើស វិធានការ ទាំង នេះ មិន មាន មនុស្ស ត្រូវបាន បញ្ជូន ទៅ តុលាការ ទេ ។
ខាងក្រោម នេះ ជា សេចក្តីប្រកាស៖ ថ្ងៃ នេះ ខួប ២៨ ឆ្នាំ នៃ ទិវា ប្រកាស ឲ្យ ប្រើប្រាស់ រដ្ឋធម្មនុញ្ញ ជាតិ . សម្តេច តេជោ ហ៊ុន សែន អរគុណ ជន រួម ជាតិ ដែល បាន ចូលរួម ថែរក្សា ការពារ សន្កិភាព ដើម្បី ប្រទេសជាតិ កាន់តែ រីកចម្រើន រុងរឿង
ជាមួយគ្នា នេះ សម្តេច នាយក រដ្ឋមន្ត្រី ក៏ បាន ពន្យល់ ផងដែរ អំពី ប្រវត្តិ នៃ ការបង្កើតឡើង ជា ប្រវត្តិសាស្ត្រ នៃ រដ្ឋធម្មនុញ្ញជាតិ នៅក្នុង ឆ្នាំ ១៩៩៣ ។
លើស ពី នេះ សម្តេច ប្រមុខ រាជ រដ្ឋាភិបាល បាន អរ គណុដល់ ជន រួម ជាតិ ដែល បាន ចូលរួម ថែរក្សា ការពារ សន្កិភាព ដើម្បី ប្រទេសជាតិ កាន់តែ រីកចម្រើន រុងរឿង ឆ្ពោះទៅ មុខ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បង្ហោះ សារ ទាំងស្រុង យ៉ាង ដូច្នេះ ថា « អបអរសាទរ ខួប ២៨ ឆ្នាំ នៃ ទិវា ប្រកាស ឲ្យ ប្រើប្រាស់ រដ្ឋធម្មនុញ្ញ ជាតិ ! នៅ ថ្ងៃទី ២៤កញ្ញា នេះ គឺជា ខួប ទី ២៨ ឆ្នាំ ដែល កម្ពុជា បាន ប្រកាស ឲ្យ ប្រើប្រាស់ ជា ផ្លូវការ នូវ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ផ្តើម ចេញ ពី កិច្ចព្រមព្រៀង សន្តិភាព ទីក្រុង ប៉ារីស នៅ ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ១៩៩១ ស្តីពី ដំណោះស្រាយ រួមបញ្ចប់ នូវ វិបត្តិ កម្ពុជា ជា ប្រវត្តិសាស្ត្រ ដែល បន្ទាប់មក នៅ ថ្ងៃទី ២៣ - ២៨ ខែឧសភា ប្រទេស យើង បាន រៀបចំ ការបោះឆ្នោត ជា លើក ដំបូង ក្រោម ការឧបត្ថម្ភ គាំពារ ពី អង្គការ សហ ប្រជាជាតិ អ៊ុន តាក់ (UNTAC) ។ ក្រោយពី ការបោះឆ្នោត រួច មក រដ្ឋធម្មនុញ្ញជាតិ ក៏ ត្រូវបាន បង្កើតឡើង ជា ប្រវត្តិសាស្ត្រ នៅក្នុង ឆ្នាំ ១៩៩៣ ផងដែរ ។
នៅ ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ១៩៩៣ នៅក្នុង មហា ប្រាសាទ ទេ វា វិនិច្ឆ័យ នៅក្នុង ព្រះបរម រាជ វាំង ព្រះករុណា ព្រះបាទ សម្តេច ព្រះនរោត្តម សីហនុ អតីត មហា វីរក្សត្រ ព្រះបរម រតន កោដ្ឋ ព្រះអង្គ បាន ឡាយ ព្រះហត្ថលេខា លើ ព្រះរាជ ក្រម ប្រកាស ឲ្យ ប្រើ រដ្ឋធម្មនុញ្ញ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជា ផ្លូវការ ។ នៅ ថ្ងៃទី ២៤ ខែកញ្ញា គឺជា ថ្ងៃ កំណើត រដ្ឋធម្មនុញ្ញ ឆ្នាំ ១៩៩៣ ដែល មកដល់ ឆ្នាំ ២០២១ គឺ រដ្ឋធម្មនុញ្ញ កម្ពុជា មាន អាយុកាល ២៨ ឆ្នាំ ហើយ ។
រដ្ឋធម្មនុញ្ញ គឺជា ច្បាប់ កំពូល នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។ ច្បាប់ និង សេចក្តីសម្រេច ទាំងឡាយ នៃ ស្ថាប័ន នានា របស់ រដ្ឋ ត្រូវ ស្រប ទៅនឹង រដ្ឋធម្មនុញ្ញ ជាដាច់ខាត ។ ចំណុច សំខាន់ ៗ បំផុត មួយចំនួន ដែល បាន ចែង ច្បាស់ នៅក្នុង រដ្ឋធម្មនុញ្ញ មាន ដូចជា « កម្ពុជា ត្រូវ គោរព ដាច់ខាត នូវ របប រាជានិយម អាស្រ័យ រដ្ឋធម្មនុញ្ញ របប ប្រជាធិបតេយ្យ សេរី ពហុ បក្ស ។
រដ្ឋធម្មនុញ្ញ កម្ពុជា បាន ចែង អំពី គោលការណ៍ នៃ ការបែងចែក អំណាច ដាច់ដោយឡែក ពី គ្នា គឺ ១) អំណាច នីតិបញ្ញត្តិ . ២) នីតិប្រតិបត្តិ និង ៣) តុលាការ ហើយក៏ បាន អនុម័ត នូវ សិទ្ធិ ជាមូលដ្ឋាន របស់ ប្រជាពលរដ្ឋ និង គោលការណ៍ នីតិរដ្ឋ ជាដើម ។ សូម អរគុណ បងប្អូន ជន រួម ជាតិ ដែល បាន ចូលរួម ថែរក្សា ការពារ សន្កិភាព ដើម្បី ប្រទេសជាតិ កាន់តែ រីកចម្រើន រុងរឿង ឆ្ពោះទៅ មុខ ។ អរគុណ សន្តិភាព »៕
ព្រឹក នេះ វ៉ាក់សាំង ៣លាន ដូស ទៀត នឹង ដឹក មកដល់ ប្រទេស កម្ពុជា
( ភ្នំពេញ ) ៖ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ស៊ីណូ វ៉ាក់ របស់ ក្រុមហ៊ុន ចិន ចំនួន ៣លាន ដូស បន្ថែម ទៀត ដែល ជា ការបញ្ជាទិញ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នោះ នឹង ដឹក មកដល់ ប្រទេស កម្ពុជា នៅ ព្រឹក ថ្ងៃសុក្រ ទី២៤ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
( ភ្នំពេញ ) ៖ គិត ត្រឹម យប់ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១២.៨២៣ . ៨៦៨ នាក់ ។ ក្នុង រួម មាន៖
( ភ្នំពេញ ) ៖ ប្រធាន រាជ បណ្ឌិត សភា កម្ពុជា លោក បណ្ឌិត សុខ ទូច នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ បាន សំណូមពរ ទៅកាន់ អ្នកនយោបាយ កុំ ដើរ ពឹងពាក់ បរទេស ដើម្បី សម្រេច មហិច្ឆតា របស់ ខ្លួន ដែល ជា អំពើ នាំឱ្យ ជាតិ ខាតបង់ ។
ជាក់ស្ដែង យើង ត្រូវ ពិនិត្យមើល ប្រវត្តិ សាស្ត្រ៖
« ដូច្នេះ សូម អ្នកនយោបាយ កុំ ដើរ ពឹងពាក់ បរទេស ដើម្បី តែ បុព្វហេតុ មហិច្ឆតា អំណាច របស់ ខ្លួន ហើយ បណ្ដោយ ឱ្យ ប្រទេសជាតិ ធ្លាក់ រងគ្រោះ ប្រជាជនជា អ្នកទទួលរង ទុក្ខលំបាក » ។ នេះ បើ តាម សំណេរ លោក បណ្ឌិត ។
រដ្ឋបាល ខេត្ត បាន សម្រេច យ៉ាង ដូច្នេះ ថា៖ « ត្រូវបាន បន្ត បិទ ខ្ទប់ ភូមិសាស្ត្រ ភូមិ កំពង់ហ្លួង ឃុំ អង្គរ បូរី ស្រុក អង្គរ បូរី ខេត្ត តាកែវ ដែល ជា តំបន់ មាន ការឆ្លង រាលដាល នៃ មេរោគ បំប្លែង ថ្មី ប្រភេទ Delta រយៈពេល ១ សប្តាហ៍ បន្ត ទៀត ចាប់ពី ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ រហូតដល់ ថ្ងៃទី ២៩ ខែកញ្ញា ឆ្នាំ ២០២១ » ។
បើ តាម សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត បាន បញ្ជាក់ ថា ក្នុង អំឡុង ពេល នៃ ការបន្ត បិទ ខ្ទប់ នេះ បងប្អូន អាជីវករ និង ប្រជាពលរដ្ឋ ដែល បាន ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ដោយ ប្រយោល់ ជាមួយ អ្នកវិជ្ជមាន មេរោគ បំប្លែង ថ្មី ប្រភេទ Delta នៅ ទីតាំង ខាងលើ ត្រូវ បន្ត ចូលរួម សហការ ជាមួយ អាជ្ញាធរ មាន សមត្ថកិច្ច និង ក្រុមការងារ សុខាភិបាល ដើម្បី ស្រាវជ្រាវ រក អ្នក ពាក់ព័ន្ធ យក សំណាក ទៅ ធ្វើតេស្ត រក មេរោគ បំប្លែង ថ្មី ប្រភេទ Delta ។
បុគ្គល គ្រប់ រូប មាន កាតព្វកិច្ចអនុវត្ត វិធានការ សុខាភិបាល រួម មាន ការពាក់ ម៉ាស់ ការរក្សា គម្លាត សុវត្ថិភាព បុគ្គល ជាពិសេស អនុវត្ត តាម អនុសាសន៍ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា គឺ « ៣ការពារ និង ៣កុំ » ព្រមទាំង ប្រកាន់ខ្ជាប់ នូវ ការធ្វើ អនាម័យ ដើម្បី សម្លាប់ មេរោគ ការវាស់ កម្ដៅ ដើម្បី ប្រយុទ្ធ និង ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត តាកែ វ៖
( ភ្នំពេញ ) ៖ ឈានចូល ដល់ ថ្ងៃ១ រោច ខែ ភទ្របទ គឺជា ពេលវេលា ដែល ប្រជាពលរដ្ឋ ខ្មែរ នាំគ្នា ប្រារព្ធ ពិធី បុណ្យ កាន់ បិណ្ឌ នៅ តាម វត្ត អារាម នានា ដែល មាន រយៈពេល ១៥ ថ្ងៃ ។ ជារៀងរាល់ ឆ្នាំ នៅ តាម វត្ត អារាម នានា មាន ពុទ្ធ បរិស័ទ កកកុញ នាំគ្នា យក ចង្ហាន់ ឬ ទេយ្យ ទាន ទៅ ប្រគេន ព្រះសង្ឃ ដែល ធ្វើ ឱ្យ ការលក់ ទំនិញ បន្លែ ត្រី សាច់ និង ស្លា ដក់ ជាដើម មាន ការកើនឡើង ជាង ថ្ងៃ ធម្មតា ។
មិន ខុសពី ឆ្នាំ មុន ការប្រារព្ធ ពិធី បុណ្យ កាន់ បិណ្ឌ បាន ប្រព្រឹត្តិ ទៅក្នុង ពេល រីករាល នៃ ជំងឺ កូវីដ១៩ មនុស្ស មួយចំនួន បាន កាត់បន្ថយ ទៅ វត្ត អារាម បញ្ជៀស ការជួបជុំ មនុស្ស ច្រើន ដើម្បី កាត់បន្ថយ ហានិភ័យ នៃ ការឆ្លង រីករាលដាល នៃ ជំងឺ កូវីដ១៩ ហេតុ នេះ ហើយ ការលក់ដូរ ទំនិញ នៅ តាម ផ្សារ ហាក់ ស្ងប់ស្ងាត់ ខ្លាំង ។
រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម លើកទឹកចិត្ត អ្នកប្រើប្រាស់ រាយការណ៍ សកម្មភាព មិន សុចរិត របស់ ធុរ ជន ឬ ម្ចាស់ អាជីវកម្ម
( ភ្នំពេញ ) ៖ ក្រសួង ពាណិជ្ជកម្ម និង ទីភ្នាក់ងារ កិច្ចសហប្រតិបត្តិការ អាល្លឺម៉ង់ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ បាន រួមគ្នា រៀបចំ សិក្ខាសាលា ថ្នាក់ ជាតិ មួយ ផ្សព្វផ្សាយ ច្បាប់ ស្តីពី កិច្ចការពារ អ្នកប្រើប្រាស់ ក្រោម ប្រធានបទ « ការធ្វើ ធុរកិច្ច ប្រកបដោយ ក្រមសីលធ ម៌៖ សុខុមាលភាព របស់ អតិថិជន និង ធុរកិច្ច របស់ អ្នក » ។
ពិធី ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្ត្រី ក្រសួង ពាណិជ្ជកម្ម និង មាន ការអញ្ញើ ចូលរួម ពី អ្នក ឧកញ៉ា គិត ម៉េង ប្រធាន សភា ពាណិជ្ជកម្ម កម្ពុជា និង លោក ហ្វ្រាង យ៉ាត់ ខឺ (Frank Jattke) ប្រធាន ក្រុមការងារ អាស៊ាន នៃ ទីភ្នាក់ងារ កិច្ចសហប្រតិបត្តិការ អាល្លឺម៉ង់ (GIZ) ប្រចាំ កម្ពុជា ព្រមទាំង តំណាង វិស័យ ឯកជន ដៃគូ អភិវឌ្ឍ ជាច្រើន រូប ទៀត ប្រមាណ ជា ១៥០ នាក់ ។
ថ្លែង នៅក្នុង សិក្ខាសាលា នេះ លោក ប៉ាន សូរស័ក្តិ បាន អំពាវនាវ ដល់ អ្នកធ្វើ ធុរកិច្ច ទាំងឡាយ ដែល មិន ទាន់ បាន អនុវត្ត នូវ កាតព្វកិច្ចការពារ អ្នកប្រើប្រាស់ ឱ្យ យកចិត្តទុកដាក់ អនុវត្ត នូវ ការតព្វកិច្ច ទាំងនោះ ស្រប តាម ច្បាប់ និង បទប្បញ្ញត្តិ ជាធរមាន ដើម្បី រួមចំណែក ជាមួយ ស្ថាប័ន មាន សមត្ថកិច្ច និង អ្នកប្រើប្រាស់ ក្នុង ការកសាង សង្គម ឱ្យ មាន សុខដុមនីយកម្ម និង មាន ការអភិវឌ្ឍ ប្រកបដោយ និរន្តរភាព ។
ក្នុង ឱកាស នោះ លោក រដ្ឋមន្ត្រី ពាណិជ្ជកម្ម ក៏ បាន លើកទឹកចិត្ត ដល់ អ្នកប្រើប្រាស់ ឱ្យ រាយការណ៍ ពី ធុរ ជន និង ម្ចាស់ អាជីវកម្ម ទាំងឡាយ ណា ដែល ប្រព្រឹត្ត សកម្មភាព មិន សុចរិត ក្នុង ធុរកិច្ច មកកាន់ ក្រសួង ពាណិជ្ជកម្ម ឬ គណៈកម្មាធិការ ជាតិ ការពារ អ្នកប្រើប្រាស់ តាមរយៈ អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ ( ក .ប. ប. ) ដើម្បី ស្វែងរក ដំណោះស្រាយ បញ្ហា រួមគ្នា ឱ្យ បាន ទាន់ ពេល វេលា ។
លោក រដ្ឋមន្ត្រី បាន គូស រំលេច ថា « ការការពារ អ្នកប្រើប្រាស់ ប្រកបដោយ ប្រសិទ្ធភាព តម្រូវ ឱ្យ អាជីវកម្ម ទទួលបាន ការជូនដំណឹង អំពី កាតព្វកិច្ច របស់ ខ្លួន ចំពោះ អ្នកប្រើប្រាស់ និង ចៀសវាង សកម្មភាព ណាមួយ ដែល អាច ភូត កុហក ពង្វាង ការពិត ឬ ធ្វើឱ្យ ខូច ប្រយោជន៍ ដល់ អ្នកប្រើប្រាស់ ទាំង ក្នុង ប្រតិបត្តិការ ជា ទម្លាប់ ប្រពៃណី ឬ ក្នុង ពាណិជ្ជកម្ម អេឡិចត្រូនិក » ។
លោក រដ្ឋមន្ត្រី បន្ថែម ថា « ការការពារ ផលប្រយោជន៍ និង សិទ្ធិ របស់ អ្នកប្រើប្រាស់ មិន គួរ ត្រូវបាន ចាត់ទុក ថា ជា ឧបសគ្គ ដល់ អាជីវកម្ម ឡើយ ។ ផ្ទុយទៅវិញ អាជីវកម្ម ដែល លក់ ផលិតផល ឬ សេវាកម្ម ទៀង ត្រង់ និង បម្រើ អតិថិជន របស់ ពួកគេ ដោយ ស្មើភាព ជា ឧទាហរណ៍ ដោយ ការគោរព តាម ការធានា អះអាង និង ការធានា លើ ផលិតផល អាច ពង្រីក មូលដ្ឋាន អតិថិជន និង ការប្រកួតប្រជែង របស់ ពួកគេ ។ អ្នកតំណាង មកពី សហគមន៍ ពាណិជ្ជកម្ម ក៏ អាច ដើរតួ ជា ដៃគូ ដែល ទុកចិត្ត សម្រាប់ រដ្ឋាភិបាល ក្នុង ការគាំទ្រ ដល់ ការការពារ អ្នកប្រើប្រាស់ » ។
លោក ហ្វ្រាង យ៉ាត់ ខឺ (Frank Jattke) ប្រធាន ក្រុមការងារ អាស៊ាន នៃ ទីភ្នាក់ងារ កិច្ចសហប្រតិបត្តិការ អាល្លឺម៉ង់ (GIZ) ប្រចាំ កម្ពុជា បាន លើកឡើង ថា ការធ្វើ ធុរកិច្ច ប្រកបដោយ សុចរិត យុត្តិធម៌ ទាំង តាម ប្រព័ន្ធ អនឡាញ និង មិន មែន អនឡាញ គឺជា កត្តា សំខាន់ ជំរុញ នូវ ភាពជោគជ័យ ក្នុង ធុរកិច្ច ដោយសារ ក្រុមហ៊ុន ដែល ទទួលបាន ការពេញចិត្ត ពេញ ថ្លើម ពីសំណាក់ អតិថិជន ឬ អ្នកប្រើប្រាស់ អាច ពង្រីក មូលដ្ឋាន អតិថិជន របស់ ខ្លួន បាន កាន់តែ ទូលំទូលាយ ។
លោក ហ្វ្រាង យ៉ាត់ ខឺ បាន ប្រកាស ថា ក្រមសីលធម៌ នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ត្រូវ យក ទៅ ផ្សព្វផ្សាយ នៅ ទូទាំង ប្រទេស ជា សមាជិក អាស៊ាន ទាំងអស់ ហើយ វា ក៏ ជា ផ្នែក មួយ នៃ កិច្ច ខិតខំ ប្រឹងប្រែង ស្តារ ប្រទេស ឡើងវិញ ក្រោយពី វិបត្តិ នៃ ជំងឺ រាតត្បាត ។
សូម ជម្រាប ជូន ថា ប្រទេស កម្ពុជា មាន របប គាំពារ អ្នកប្រើប្រាស់ ក្មេង ជាង គេ នៅក្នុង តំបន់ អាស៊ាន ហើយ ច្បាប់ ស្តីពី កិច្ចការពារ អ្នកប្រើប្រាស់ ត្រូវបាន ប្រកាស ឱ្យ ប្រើ តាម ព្រះរាជ ក្រម លេខ នស/ រក ម/ ១១១៩ / ០១៦ ចុះ ថ្ងៃទី ០២ ខែវិច្ឆិកា ឆ្នាំ ២០១៩ ។ ក្នុង នោះ អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ ( ក .ប. ប. ) ដើរ តួនាទី ជា ស្ថាប័ន អនុវត្ត សំខាន់ និង ត្រូវបាន ប្រគល់ នូវ ភារកិច្ច ទាក់ទង នឹង ការការពារ អតិថិជន អនុលោម តាម បទប្បញ្ញត្តិ នៃ ច្បាប់ នេះ ។
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១
១៖ សម្តេច តេជោ ហ៊ុន សែន ស្នើ ឱ្យ មាន ការពិចារណា ឡើងវិញ ឬ ផ្អាក ការប្រារព្ធ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ
៤៖ ទីបំផុត បារាំង ព្រម បញ្ជូន ឯក អគ្គ រដ្ឋទូត ទៅកាន់ សហរដ្ឋ អាមេរិក វិញ បន្ទាប់ពី លោក បៃ ដិន និង លោក ម៉ាក្រុង ជួប សន្ទនា គ្នា តាម ទូរស័ព្ទ
៥៖ សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ពិភពលោក ឱ្យ កំណត់ វ៉ាក់សាំង កូវីដ១៩ ទាំងអស់ ដែល WHO ទទួលស្គាល់ ជា ទំនិញ យុទ្ធសាស្ត្រ គន្លឹះ សកល ដោយ គ្មាន ការរើសអើង
៧៖ វ៉ាក់សាំង ចិន ចំនួន ៣លាន ដូស ថ្មី ទៀត ដែល ជា ការបញ្ជាទិញ របស់ កម្ពុជា នឹង ត្រូវ ដឹក មកដល់ នៅ ថ្ងៃស្អែក នេះ
៨៖ សម្តេច តេជោ ហ៊ុន សែន អំពាវនាវ ឱ្យ ប្រទេស ទាំងអស់ រួមគ្នា បញ្ឈប់ វិបត្តិ កូវីដ១៩ តាម លទ្ធភាព រៀង ខ្លួន ដោយ ទឹកចិត្ត ស្មោះសរ និង មិន បង្កប់ របៀបវារៈ នយោបាយ
១០៖ សម្តេច តេជោ ហ៊ុន សែន នឹង អញ្ជើញ ថ្លែង សុន្ទរកថា តំណាង ជាតិ ក្នុង កិច្ចពិភាក្សា ទូទៅ កម្រិត ខ្ពស់ នៃ មហាសន្និបាត អង្គការ សហ ប្រជាជាតិ លើក ទី ៧៦ នៅ ថ្ងៃទី ២៥ ខែកញ្ញា
១២៖ ជប៉ុន ដក កម្ពុជា ចេញ ពី បញ្ជី ប្រទេស ដែល តម្រូវឲ្យ ធ្វើចត្តាឡី ស័ក ក្នុង មណ្ឌល និង ធ្វេី តេស្ត ថ្ងៃទី ៣ ពេល ចូល ប្រទេស ខ្លួន
១៣៖ អ្នកជំនាញ វេជ្ជសាស្ត្រ អង់គ្លេស អះអាង ថា អត្រា ឆ្លង កូវីដ - ១៩ លើ កុមារ មាន កម្រិត ខ្ពស់
១៤៖ ខេត្ត កំពង់ធំ បិទ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជុំទី១ ជូន ប្រជាពលរដ្ឋ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង
១៥៖ អាមេរិក និង អង់គ្លេស បង្ហាញ ការស្វាគមន៍ ចំពោះ ចិន ជុំវិញ ការប្តេជ្ញាចិត្ត ដោះស្រាយ បញ្ហា បម្រែបម្រួល អាកាសធាតុ
១៦៖ រដ្ឋមន្ត្រី អប់ រំ៖ ២ឆ្នាំ បន្ទាប់ពី កូវីដ វាយលុក កម្ពុជា បាន ប្រែក្លាយ វិបត្តិ ទៅជា ឱកាស ក្នុង ការលើកកម្ពស់ ការអប់រំ តាម បែប ឌីជីថល និង បំណិន សតវត្ស ទី ២១ ដល់ គ្រូបង្រៀន
១៨៖ ជប៉ុន ប្រកាស បង្កើន ការបរិច្ចាគ វ៉ាក់សាំង កូវីដ១៩ រហូតដល់ ៦០ លាន ដូស
៤៖ កម្ពុជា ទទួលបាន ការសាទរ ពី បណ្ដា ប្រទេស អាស៊ាន ក្រោយ សាងសង់ ហេដ្ឋារចនាសម្ព័ន្ធ ហើយ មុន ស៊ីហ្គេម ឆ្នាំ ២០២៣
កម្ពុជា មាន គម្រប ព្រៃឈើ ៨. ៥លាន ហិកតា ស្មើនឹង ជាង ៤៦ ភាគរយ នៅ ឆ្នាំ ២០១៨
( ភ្នំពេញ ) ៖ កម្ពុជា មាន ផ្ទៃដី ព្រៃឈើ ប្រមាណ ៨. ៥១០. ៨០៧ ហិកតា ស្មើនឹង ៤៦. ៨៦% ធៀប នឹង ផ្ទៃដី សរុប ទូទាំង ប្រទេស គិត ត្រឹម ឆ្នាំ ២០១៨ ។ របាយការណ៍ ស្ថានភាព បរិស្ថាន លើក ទី៤ និង សៀវភៅ ធនធាន គម្រប ព្រៃឈើ កម្ពុជា ឆ្នាំ ២០១៨ ដែល ផ្សព្វផ្សាយ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
មន្ត្រី ជាន់ ខ្ពស់ ក្រសួង បរិស្ថាន បាន បញ្ជាក់ ថា ការប្រកាស ឱ្យ ប្រើប្រាស់ និង ផ្សព្វផ្សា យេ របាយការណ៍ ស្តីពី ស្ថានភាព បរិស្ថាន ជាតិ លើក ទី៤ និង លទ្ធផល នៃ ការសិក្សា វាយតម្លៃ ធនធាន គម្រប ព្រៃឈើ កម្ពុជា ឆ្នាំ ២០១៨ នេះ ជា សមិទ្ធផល ថ្មី ២ បន្ថែម ទៀត ដែល ជា ផ្លែ ផ្កា នៃ កិច្ចសហប្រតិបត្តិការ រវាង ក្រសួង បរិស្ថាន ក្រសួង ស្ថាប័ន នៃ រាជ រដ្ឋាភិបាល កម្ពុជា និង ដៃគូ អភិវឌ្ឍន៍ ក្នុង វិស័យ បរិស្ថាន និង ធនធាន ធម្មជាតិ ។
ទិន្នន័យ នេះ បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការរៀបចំ ផែនការដាំ ស្តារ ព្រៃ ឡើងវិញ រៀបចំ ដី បម្រុងទុក អចិន្រ្តៃយ៍ ដើម្បី ធ្វើ ផែនការអភិវឌ្ឍ ឃុំ / សង្កាត់ ចូលរួម ចំណែក គោល នយោបាយ កាត់ ឆ្វៀល ដី និង សម្បទាន ដី សង្គមកិច្ច ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ដែល កំពុង អាស្រ័យ ផល នៅលើ ដី ព្រៃ ។
បើ តាម លោក ជួប ប៉ារីស៍ អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ចំណេះដឹង និង ព័ត៌មាន បរិស្ថាន នៃ ក្រសួង បរិស្ថាន បាន ថ្លែង ថា របាយការណ៍ ស្តីពី ស្ថានភាព បរិស្ថាន ជាតិ លើក ទី៤ និង លទ្ធផល ការសិក្សា វាយតម្លៃ ធនធាន គម្រប ព្រៃឈើ កម្ពុជា ឆ្នាំ ២០១៨ ដែល ចេញផ្សាយ និង ដាក់ ឱ្យ ដំណើរការ នៅ ថ្ងៃ នេះ បាន បោះពុម្ព ផ្សាយ ជា ភាសារ ខ្មែរ និង អង់គ្លេស ផងដែរ ៕ សមាគម កម្មសិទ្ធិ បញ្ញា ដែល ចំណុះ ក្រោម ក្រសួង ពាណិជ្ជកម្ម សហការ ជាមួយ ស្ថាប័ន ពាក់ព័ន្ធ ការពារ ម៉ាក យីហោ ទំនិញ ក្នុង និង ក្រៅ ប្រទេស
សិក្ខាសាលា នេះ ត្រូវបាន រៀបចំឡើង ក្រោម វត្តមាន លោកស្រី មេធាវី សេង វួច ហ៊ុន ប្រធាន សមាគម កម្មសិទ្ធ បញ្ញា កម្ពុជា និង លោក Petter Willimott មន្រ្តី ទទួលបន្ទុក នៃ អង្គការ កម្មសិទ្ធ បញ្ញា ពិភពលោក ប្រចាំ នៅ ប្រទេស សិង្ហបុរី ព្រមទាំង មាន ការថ្លែង សុន្ទរកថា បើក កម្មវិធី ដោយ លោក សួន វិជ្ជា ទីប្រឹក្សា ក្រសួង ពាណិជ្ជកម្ម ប្រធាន លេខាធិកាដ្ឋាន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង កម្មសិទ្ធ បញ្ញា និង ជា ប្រធាន នាយកដ្ឋាន កម្មសិទ្ធិ បញ្ញា ហើយក៏ មាន ការឈ្មោះ ចូលរួម ពី សិក្ខាកាម ចំនួន ៣៦៩ នាក់ ផងដែរ ។
គួរ បញ្ជាក់ ថា សិក្ខាសាលា តាម ប្រព័ន្ធ អនឡាញ នេះ មាន គោលបំណង ជួយ ឱ្យ ម្ចាស់ អាជីវកម្ម និង សាធារណជន ទាំងអស់ ស្វែងយល់ ពី កិច្ចការពារ ម៉ាក យីហោ និង ម៉ាក សម្គាល់ ភូមិសាស្រ្ត ទំនិញ កិច្ចការពារ ម៉ាក យីហោ នៅ ក្រៅ ប្រទេស និង របៀប នៃ ការចុះបញ្ជី ដោយ ប្រើប្រាស់ ប្រព័ន្ធ Madrid ព្រមទាំង តួនាទី របស់ មេធាវី ជំនាញ កម្មសិទ្ធិ បញ្ញា នៅក្នុង អាជីវកម្ម របស់ អ្នក ផងដែរ ៕
ឯកជន ក្នុង វិស័យ ទេសចរណ៍ ស្នើ រដ្ឋាភិបាល ឆាប់ ប្រកាស ពី ពេល បើក ទេសចរណ៍ អន្តរជាតិ ផ្លូវការ ដើម្បី ផ្សព្វផ្សាយ ដល់ ភ្ញៀវ អន្តរជាតិ និង ប្រជែង ទីផ្សារ ឱ្យ បាន មុន គេ
( ភ្នំពេញ ) ៖ សមាគម ទីភ្នាក់ងារ ក្រុមហ៊ុន ឯកជន ដែល ប្រកប ការងារ - អាជីវកម្ម ក្នុង វិស័យ ទេសចរណ៍ ទាំង ក្នុង ស្រុក និង ក្រៅ ស្រុក បាន ទទួច ស្នើ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា ពន្លឿន ការប្រកាស « ពេលវេលា បើក ទេសចរណ៍ អន្តរជាតិ ឡើងវិញ ជា ផ្លូវការ » ដើម្បី ងាយស្រួល ក្នុង ការទំនាក់ទំនង ជាមួយ ដៃគូ ក្រៅ ប្រទេស ក្នុង ការផ្សព្វផ្សាយ ដល់ ភ្ញៀវ ទេសចរ ពិសេស គឺ ដើម្បី ទាក់ទាញ ភ្ញៀវ ទេសចរ អន្តរជាតិ ឱ្យ បាន មុន ប្រទេស ដទៃ ។
លោកស្រី ឆាយ ស៉ីវលីន ប្រធាន សមាគម CATA បាន ឱ្យដឹង ថា គោលបំណង នៃ ការរៀបចំ សន្និសីទ សារព័ត៌មាន នេះ គឺ ដើម្បី ជូន សារ ទៅកាន់ រាជ រដ្ឋាភិបាល ពាក់ព័ន្ធ នឹង សំណើ ជូយ ពន្លឿន ការប្រកាស បើក ទទួល ទេសចរ អន្តរជាតិ ឡើងវិញ ពីព្រោះ ស្ថានភាព នា ពេលនេះ គឺ ពិតជា មាន សារសំខាន់ ណាស់ សម្រាប់ ការស្ដារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ ជាតិ ។
លោកស្រី បាន បញ្ជាក់ ថា ខណៈ ដែល ប្រទេស ក្នុង តំបន់ និង ប្រទេស ក្រៅ កំពុងតែ ស្ងាត់ ស្ងៀម នា ពេលនេះ កម្ពុជា គួរតែ ប្រញាប់ ចាប់ យក ឱកាស ទទួល ភ្ញៀវ ទេសចរ អន្តរជាតិ ឱ្យ បាន មុន គេ ។
ប្រទេស កម្ពុជា មាន អ្វី ៗ ផ្ដល់ជូន ភ្ញៀវ ទេសចរ ច្រើន ណាស់ ។ កន្លងទៅ មិន បាន ប្រើប្រាស់ ឱ្យ អស់ សក្ដានុពល ដោយសារតែ ពីមុន ភ្ញៀវ អន្តរជាតិ មុននឹង មក ទស្សនា កម្ពុជា គឺ គេ បាន ដើរលេង ប្រទេស ជិតខាង សឹងតែ អស់ចិត្ត ទៅ ហើយ ដូច្នេះ គោលដៅ មួយចំនួន នៅ កម្ពុជា ពួកគេ មិន ទាន់ បាន ទៅដល់ ឡើយ ប៉ុន្តែ ឱកាស ថ្មី នេះ គឺជា ឱកាស ដែល កម្ពុជា ត្រូវ ប្រើប្រាស់ សក្ដានុពល ទេសចរណ៍ ទាំងនោះ ឱ្យ បាន ច្រើន ។ នេះ បើ តាម ការបន្ថែម របស់ លោកស្រី ឆាយ ស៉ីវលីន ។
លោកស្រី បាន បង្ហាញ ការព្រួយបារម្ភ ថា « ប្រសិនបើ ការប្រកាស នៅតែ យឺតយ៉ាវ ហើយ ប្រទេស ក្នុង តំបន់ ប្រកាស បើក មុន ទៀត នោះ ភ្ញៀវ ទេសចរ នឹង ជ្រើសរើស គោលដៅ ទេសចរណ៍ ក្រៅពី កម្ពុជា រីឯ ក្រុមហ៊ុន ទីភ្នាក់ងារ ទេសចរណ៍ នឹង ដាក់ គោលដៅ កម្ពុជា ទៅ លេខរៀង ខាងក្រោម បន្ទាប់ពី គោលដៅ ប្រទេស ដទៃ » ។
លោក បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ពិត ណាស់ ថា ការបើក ទេសចរណ៍ ឡើងវិញ នេះ នឹង ធ្វើឡើង ទៅតាម ជំហាន ៗ ប៉ុន្តែ បេី មិន ចាប់ផ្ដើម ពី ពេលនេះ ទេ នោះ ស្ថានការណ៍ ស្រោចស្រង់ វិស័យ ទេសចរណ៍ ជាតិ នឹង កាន់តែ យឺតយ៉ាវ ទៀត ហើយ » ។
លោក អាឡាំង បាន បន្ត ថា នៅ ប្រទេស ខ្លះ ដូចជា ប្រទេស កូស្ដារីកា សាធារណរដ្ឋ ដូមីនិក គឺ បាន រៀបចំ វិស័យ ទេសចរណ៍ របស់ គេ ស្ទើរតែ បាន ល្អ ដូច កាលពី ឆ្នាំ ២០១៩ ទៅ ហើយ ខណៈ ក្រុមហ៊ុន ដៃគូ នៅ ក្រៅ ប្រទេស ក៏ កំពុង រង់ចាំ ចម្លើយ នៅ ប្រទេស កម្ពុជា ផងដែរ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ ទាំងស្រុង នៃ សារលិខិត របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ទូល ថ្លែងអំណរ ព្រះរាជ គុណ ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា៖ លោក គង់ គាំ ហៅ សម រង្ស៉ី ថា ជា ពូជ ក្បត់ ជាតិ និង បម្រើ យួន សេរី ក្រោយ រង ការចោទ ថា អ្នក ទៅ បង្កើត បក្ស ថ្មី « ជា ពូជ មិន ស្នេហាជាតិ និង ជាបន្លា យួន »
រហូតមកដល់ ពេលនេះ ក្រៅពី គណបក្ស ឆន្ទៈ ខ្មែរ គឺ មាន គណបក្ស យ៉ាងហោចណាស់ ៥ទៀត ត្រូវបាន និង កំពុង រៀបចំ បង្កើតឡើង ដោយ អតីត ថ្នាក់ដឹកនាំ នៃ អតីត គណបក្ស សង្រ្គោះ ជាតិ ក្នុង នោះ មាន គណបក្ស កែទម្រង់ កម្ពុជា . គណបក្ស កម្ពុជា និយម . គណបក្ស អភិរក្ស និយម . គណបក្ស ខ្មែរ ស្រលាញ់ ជាតិ និង គណបក្ស បេះដូង ជាតិ ផងដែរ ។
ការរៀបចំ បង្កើត បក្ស នេះ ធ្វើឡើង បន្ទាប់ពី ពួកគេ ទទួលបាន នីតិសម្បទាន យោបាយ ឡើងវិញ ដែល រហូតមកដល់ ពេលនេះ មាន អតីត ថ្នាក់ដឹកនាំ នៃ អតីត គណបក្ស សង្រ្គោះ ជាតិ ចំនួន ២៦ រូប ហើយ ត្រូវបាន ព្រះមហាក្សត្រ និង ប្រមុខរដ្ឋ ស្តីទី ផ្តល់ នីតិសម្បទាន យោបាយ នេះ ៕
ពិធី ប្រគល់ និង ទទួល នេះ បាន ធ្វើឡើង ក្រោម វត្ដមាន លោកស្រី លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា ដែល ប្រព្រឹត្ដទៅ ទីស្នាក់ការ កណ្ដាល កាកបាទ ក្រហម កម្ពុជា នា ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
ក្នុង ឱកាស នោះ លោកស្រី ពុំ ចន្ទីនី បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ ការថ្លែងអំណរគុណ និង កោតសរសើរ ចំពោះ ថ្នាក់ដឹកនាំ និង បុគ្គលិក សុខាភិបាល ទាំងអស់ នៃ មន្ទីរពេទ្យ ដែល ជា វីរ ជន ជួរ មុខ មាន ភាពឈ្លាសវៃ ក្នុង ការគ្រប់គ្រង និង ទប់ស្កាត់ បាន ការចម្លង មេរោគ កូវីដ - ១៩ នៅក្នុង មន្ទីរពេទ្យ ។
លោកស្រី បាន ជូន ពរ ថ្នាក់ដឹកនាំ និង បុគ្គលិក សុខាភិបាល ទាំងអស់ នៃ មន្ទីរពេទ្យ សូម មាន សុខភាព ល្អ រឹងមាំ មាន សុវត្ថិភាព និង ចៀស ឆ្ងាយ ពី ជំងឺ នានា ដើម្បី បន្ត ផ្តល់ ក្តីសង្ឃឹម និង ភាពកក់ក្តៅ ដល់ អ្នកជំងឺ ទាំងឡាយ ដែល កំពុង សម្រាក ព្យាបាល នៅក្នុង មន្ទីរពេទ្យ ។
ជាមួយគ្នា នោះ តំណាង មន្ទីរពេទ្យ ដែល អញ្ជើញ មក ទទួល ម៉ាស និង ជែល បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ បំផុត ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល បាន ផ្តល់ សម្ភារ ដ៏ មាន សារសំខាន់ នេះ ជូន ដល់ មន្ទីរពេទ្យ ដើម្បី ប្រើប្រាស់ ក្នុង ការងារ ចូលរួម ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ មេរោគ កូវីដ - ១៩ និង តម្រូវ ការចាំបាច់ នានា ។
ក្នុង ចំណោម ករណី ឆ្លង ថ្មី ៗ ខាងលើ មាន ០៧ ករណី ជា ករណី នាំចូល ក្រៅពី នោះ ជា ករណី ឆ្លង ក្នុង ស្រុក ទាំងអស់ ខណៈ ទីក្រុង ហូជីមិញ ដែល ជា ចំណុច កណ្តាល នៃ ការផ្ទុះ រីករាល នៃ ជំងឺ នេះ បាន រ៉ាប់រង ករណី ឆ្លង ថ្មី តែ ឯង រហូតដល់ ៥. ០៥២ នាក់ ។
ក្នុង របាយការណ៍ ថ្ងៃព្រហស្បតិ៍ នេះ ក្រសួង សុខាភិបាល វៀតណាម ក៏ បាន ប្រកាស ពី ករណី អ្នកស្លាប់ ថ្មី ដោយសារ ជំងឺ ដ៏ កាច សាហាវ នេះ ទេ ចំនួន ២៣៦ នាក់ បន្ថែម ទៀត ផងដែរ ។
ព្រះសិរី កោសល សុំ សុខា ព្រះរាជា គណៈ កិត្តិយស នៃ ព្រះរាជាណាចក្រ កម្ពុជា ព្រះវិន័យ ធរ គណ រាជធានី ភ្នំពេញ ព្រះគ្រូ សង្ឃ សរណ វេទី ព្រះអនុគណខណ្ឌ កំបូល និង ជា ព្រះចៅ អធិការ វត្ត ភ្នៀត សិម្ព លី សង្កាត់ ស្នោរ ខណ្ឌ កំបូល បាន បកស្រាយ សំណួរ ខាងលើ ៕
អាជីវករ ខេត្ត បន្ទាយមានជ័យ ប្តឹង ប្រធាន សាខា កិច្ចការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្រ្កាប ការក្លែងបន្លំ ខេត្ត ទៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ
( ភ្នំពេញ ) ៖ អាជីវករ នៅ ខេត្ត បន្ទាយមានជ័យ បាន យក ពាក្យបណ្ដឹង មក ដាក់ នៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ ប្ដឹង ឲ្យ បើក ការស៊ើបអង្កេត ទៅ លើ ប្រធាន អង្គភាព សាខា កិច្ចការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រគួត ប្រជែង និង បង្រ្កាប ការក្លែងបន្លំ ( ក .ប. ប ) ខេត្ត បន្ទាយមានជ័យ និង មន្ត្រី ក្រោម ឱវាទ ពាក់ព័ន្ធ ទៅនឹង ការប្រព្រឹត្ត អំពើពុករលួយ ជា ប្រព័ន្ធ នា ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
ក្រោយមក អ្នកស្រី ហម គឹម វង់ សម្រេចចិត្ត ឈប់ បង់ប្រាក់ ឲ្យ មន្ត្រី ក . ប. ប ខេត្ត បន្ទាយមានជ័យ បន្ទាប់ពី បាន មើល ព័ត៌មាន ផ្សាយ ពី សកម្មភាព មិន ប្រក្រតី របស់ មន្ត្រី ក .ប. ប ដើរ ជំរិត ទារ ប្រាក់ ពី អ្នក ដ៏ទៃ ដោយ ព័ត៌មាន បាន បញ្ជាក់ ថា ការបង់ប្រាក់ ដោយ គ្មាន វិក័យប័ត្រ ជា អំពើ ខុស ច្បាប់ និង ជា សកម្មភាព ប្រព្រឹត្ត អំពើពុករលួយ ។
បច្ចុប្បន្ន ដោយ កើតទុក្ខ មិន សុខចិត្ត អំពី សកម្មភាព ជំរិត ទាប្រាក់ របស់ មន្ត្រី ក . ប. ប ខេត្ត បន្ទាយមានជ័យ អ្នកស្រី ហម គឹម វង់ បាន សម្រេចចិត្ត ដាក់ពាក្យ ប្តឹង មក អង្គភាព ប្រឆាំង អំពើពុករលួយ ដើម្បី អោយ ស៊ើបអង្គេ ត និង ចាត់ការ តាម នីតិវិធី ច្បាប់ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ០៦ ខែកញ្ញា ឆ្នាំ ២០២១ កន្លងទៅ នេះ ពលរដ្ឋ ខេត្ត បន្ទាយមានជ័យ ម្នាក់ ក៏ បាន ដាក់ពាក្យបណ្ដឹង ទៅ អង្គភាព ប្រឆាំង អំពើពុករលួយ ឲ្យ បើក ការស៊ើបអង្កេត លើ មន្ត្រី ( ក .ប. ប ) ខេត្ត បន្ទាយមានជ័យ និង មន្ត្រី ក្រោម ឱវាទ ពាក់ព័ន្ធ នឹង ការប្រព្រឹត្ត អំពើពុករលួយ ជា ប្រព័ន្ធ នេះ ដែរ ដោយ ពលរដ្ឋ បាន ចោទ ថា ប្រធាន ក . ប. ប ខេត្ត បន្ទាយមានជ័យ និង មន្ត្រី ក្រោម ឱវាទ បាន ជំរិត ទារ លុយ ចំនួន ១.៤០០.០០០ រៀល ដោយ មិន មាន ឯកសារ ច្បាស់លាស់ ៕
គណៈកម្មការ ជាតិ ការពារ អ្នកប្រើប្រាស់ រៀបចំ សិក្ខាសាលា ថ្នាក់ ជាតិ ផ្សព្វផ្សាយ ច្បាប់ ស្ដីពី « កិច្ចការពារ អ្នកប្រើប្រាស់ »
( ភ្នំពេញ ) ៖ សមាជិក នៃ គណៈកម្មការ ជាតិ ការពារ អ្នកប្រើប្រាស់ (NCCP) បាន ជួប ជាមួយ សភា ពាណិជ្ជកម្ម កម្ពុជា នា ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ដើម្បី ពិភាក្សា និង ផ្សព្វផ្សាយ ច្បាប់ ស្ដីពី កិច្ចការពារ អ្នកប្រើប្រាស់ ក្រោម ប្រធានបទ « ការធ្វើ ធុរកិច្ច ប្រកបដោយ ក្រមសីលធ ម៌៖ សុខុមាលភាព អ្នកប្រើប្រាស់ និង ធុរកិច្ច របស់ លោក អ្នក » ដោយ មាន អ្នកចូលរួម ប្រមាណ ១៥០ នាក់ ដែល ព្រឹត្តិការណ៍ នេះ ត្រូវបាន រៀបចំឡើង ក្នុង ទម្រង់ កូន កាត់ និង សហការ រៀបចំ ជាមួយ ទីភ្នាក់ងារ កិច្ចសហប្រតិបត្តិការ អាល្លឺម៉ង់ (GIZ) ។
មាន ក្រុមហ៊ុន ៣ បាន ចូលរួម ចែករំលែក បទ ពិសោធន៍ របស់ ពួកគេ ក្នុង សកម្មភាព មេត្រីភាព ចំពោះ អ្នកប្រើប្រាស់ ដែល ជា ការបំផុស គំនិត ដល់ ក្រុមហ៊ុន ផ្សេង ទៀត នៅក្នុង សហគមន៍ ធុរកិច្ច ជាពិសេស ដល់ សហគ្រិន ជំនាន់ ក្រោយ ឱ្យ យកចិត្តទុកដាក់ ដល់ កិច្ចការពារ អ្នកប្រើប្រាស់ ។
សិក្ខាសាលា ថ្នាក់ ជាតិ នេះ ក៏ មាន គោលបំណង ចែករំលែក ក្រមសីលធម៌ ធុរកិច្ច តាម ប្រព័ន្ធ អនឡាញ សម្រាប់ អាស៊ាន ដែល បាន បង្កើតឡើង ដើម្បី លើកទឹកចិត្ត ដល់ ការ អនុវត្ត ធុរកិច្ច ដោយ ត្រឹមត្រូវ នៅក្នុង បរិយាកាស ពាណិជ្ជកម្ម អេឡិចត្រូនិក ដែល កំពុង វិវត្ត ។ ក្រមសីលធម៌ នេះ បំពេញ បន្ថែម នូវ ការណែនាំ និង សកម្មភាព ផ្សព្វផ្សាយ របស់ អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ (CCF) ចំណុះ ក្រោម ក្រសួង ពាណិជ្ជកម្ម ។
លោក រដ្ឋមន្រ្តី បាន លើកទឹកចិត្ត ដល់ អ្នកប្រើប្រាស់ ធ្វើ សេចក្តីរាយការណ៍ ពី ធុរ ជន ទាំងឡាយ ណា ដែល ប្រព្រឹត្ត សកម្មភាព មិន សុចរិត ក្នុង ធុរកិច្ច មកកាន់ ក្រសួង ពាណិជ្ជកម្ម ឬ គណៈកម្មាធិការ ជាតិ ការពារ អ្នកប្រើប្រាស់ តាមរយៈ អគ្គ នាយកដ្ឋាន ក . ប. ប. ដើម្បី ស្វែងរក ដំណោះស្រាយ បញ្ញា រួមគ្នា ឱ្យ បាន ទាន់ ពេល វេលា ។
អ្នក ឧកញ៉ា បាន បន្ដ ថា ការការពារ អ្នកប្រើប្រាស់ ប្រកប ដោយ ប្រសិទ្ធភាព តម្រូវ ឱ្យ អាជីវកម្ម ទទួល បាន ការជូនដំណឹង អំពី កាតព្វកិច្ច របស់ ខ្លួន ចំពោះ អ្នកប្រើប្រាស់ និង ចៀសវាង សកម្មភាព ណាមួយ ដែល អាច ភូត កុហក ពង្វាង ការពិត ឬ ធ្វើឱ្យ ខូច ប្រយោជន៍ ដល់ អ្នកប្រើប្រាស់ ទាំង ក្នុង ប្រតិបត្តិការ ជា ទម្លាប់ ប្រពៃណី ឬ ក្នុង ពាណិជ្ជកម្ម អេឡិចត្រូនិច ។
ការការពារ ផល ប្រយោជន៍ និង សិទ្ធិ របស់ អ្នកប្រើប្រាស់ មិន គួរ ត្រូវបាន ចាត់ទុក ថា ជា ឧបសគ្គ ដល់ អាជីវកម្ម ឡើយ ។ ផ្ទុយទៅវិញ អាជីវកម្ម ដែល លក់ ផលិតផល ឬ សេវាកម្ម ទៀង ត្រង់ និង បម្រើ អតិថិជន របស់ ពួកគេ ដោយ ស្មើភាព ជា ឧទាហរណ៍ ដោយ ការគោរព តាម ការធានា អះអាង និង ការធានា លើ ផលិតផល អាច ពង្រីក មូលដ្ឋាន អតិថិជន និង ការប្រកួតប្រជែង របស់ ពួកគេ ។ អ្នកតំណាង មកពី សហគមន៍ ពាណិជ្ជកម្ម ក៏ អាច ដើរតួ ជា ដៃគូ ដែល ទុកចិត្ត សម្រាប់ រដ្ឋាភិបាល ក្នុង ការគាំទ្រ ដល់ ការការពារ អ្នកប្រើប្រាស់ ។
លោក ហ្វាង យ៉ាត់ ឌឺ បាន ប្រកាស ថា ក្រមសីលធម៌ នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ត្រូវ យក ទៅ ផ្សព្វផ្សាយ នៅ ទូទាំង ប្រទេស ជា សមាជិក អាស៊ាន ទាំងអស់ ហើយ វា ក៏ ជា ផ្នែក មួយ នៃ កិច្ច ខិតខំប្រឹង ប្រែង ស្តារ ប្រទេស ឡើងវិញ ក្រោយពី វិបត្តិ នៃ ជំងឺ រាតត្បាត ។ ប្រទេស កម្ពុជា មាន របប គាំពារ អ្នកប្រើប្រាស់ ក្មេង ជាង គេ នៅក្នុង តំបន់ អាស៊ាន ។
សូម រំលឹក ថា អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ កិច្ចការ ប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ (CCF) ដើរ តួនាទី ជា ស្ថាប័ន អនុវត្ត សំខាន់ និង ត្រូវបាន ប្រគល់ នូវ ភារកិច្ច ទាក់ទង នឹង ការការពារ អតិថិជន អនុលោម តាម បទប្បញ្ញត្តិ នៃ ច្បាប់ នេះ ។ គណៈកម្មាធិការ ជាតិ ការពារ អ្នកប្រើប្រាស់ (NCCP) គឺជា ស្ថាប័ន គោល នយោបាយ ខ្ពស់ ជាង គេ ហើយ បច្ចុប្បន្ន មាន ក្រសួង ពាក់ព័ន្ធ ចំនួន ៧៕ រុស្ស៊ី ធ្វើតេស្ដ ប្រព័ន្ធ ខែល ការពារ មីស៊ីល នៅឯ សមុទ្រ ខ្មៅ ខណៈ អ៊ុយក្រែន ធ្វើ សមយុទ្ធ យោធា ជាមួយ NATO
សមយុទ្ធ យោធា រួមគ្នា ជាមួយ សហរដ្ឋ អាមេរិក ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Reuters នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៣ ខែកញ្ញា ឆ្នាំ ២០២១ ។
សមយុទ្ធ នៅ អ៊ុយក្រែន ដែល មាន ការចូលរួម ពី កងទ័ព អាមេរិក និង កងទ័ព អង្គការ ណា តូ (NATO) ដទៃ ទៀត គ្រោង នឹង ដំណើរការ រហូតដល់ ថ្ងៃទី ០១ ខែតុលា ខាងមុខ នេះ ។ ក្រសួង ការពារ ជាតិ រុស្ស៉ី បាន ឱ្យដឹង នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ ថា កង នាវា ចរ សមុទ្រ ខ្មៅ របស់ ប្រទេស រុស្ស៉ី បាន អនុវត្ត ការបាញ់ប្រហារ កម្ទេច លើ គោលដៅ សមុទ្រ ខ្មៅ ដោយ ប្រព័ន្ធ ខែល ការពារ មីស៉ីល Bastion ជា ប្រព័ន្ធ ការពារ ប្រឆាំង នឹង នាវា ចល័ត និង ប្រព័ន្ធ ការពារ ពី ផ្ទៃ ទឹក ដល់ ផ្ទៃដី ។
( ភ្នំពេញ ) ៖ ក្នុង សារលិខិត អបអរ ទិវា ទេសចរណ៍ ពិភពលោក ឆ្នាំ ២០២១ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន បង្ហាញ នូវ យុទ្ធសាស្ត្រ អាទិភាព ចំនួន ដែល ធ្វើ ឈាន ទៅ បើក សកម្មភាព ទេសចរណ៍ ជាតិ និង អន្តរជាតិ ឡើងវិញ ជា ជំហាន ៗ បន្ទាប់ពី បាន ផ្អាក អស់ មួយ រយៈ ដោយសារតែ ការវាយលុក ពី ជំងឺ កូវីដ១៩ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល បាន កំណត់ ជា មុំ យុទ្ធសាស្ត្រ គន្លឹះ យ៉ាង ម៉ឹង ម៉ាត់ ដាក់ចេញ នូវ គោល នយោបាយ ចាក់ ស្រោច វ៉ាក់សាំង កូវីដ - ១៩ ឱ្យ បាន លឿន តាម គោលដៅ កំណត់ បន្ត ជំរុញ អនុវត្ត វិធានការ រដ្ឋបាល និង សុខាភិបាល ជាពិសេស វិធាន « ៣ - ការពារ ៣ - កុំ » ដើម្បី ជា មូលដ្ឋាន នៃ ការបើក សកម្មភាព សេដ្ឋកិច្ច និង សង្គម ពេញលេញ ឡើងវិញ ជា ជំហាន ៗ ក្នុង គន្លង ប្រក្រតី ភាព ថ្មី និង ការទទួលខុសត្រូវ ខ្ពស់ ។
ដើម្បី ស្រោចស្រង់ វិស័យ ទេសចរណ៍ ពី វិបត្តិ ជំងឺ កូវីដ១៩ នេះ សម្ដេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ដាក់ចេញ យុទ្ធសាស្ត្រ អាទិភាព ចំនួន ៤។ យុទ្ធសាស្ត្រ ទាំង៤ នោះ រួម មាន៖
៣៖ វិបត្តិ កូវីដ - ១៩ បាន ធ្វើឱ្យ មាន ការចាកចេញ ពី ការងារ ខ្សែ សង្វាក់ ផ្គត់ផ្គង់ ទេសចរណ៍ គ្រប់ កម្រិត ត្រូវ ផ្អាក ស្ទើរ ទាំងស្រុង ដែល ទាំងនេះ បាន បង្ក ជា ឧបសគ្គ នៃ ដំណើរការស្តារ ឡើងវិញ នៃ វិស័យ ទេសចរណ៍ នា ពេល ខាងមុខ ។ ក្នុង ន័យ នេះ សម្ដេច តេជោ បាន អំពាវនាវ ដល់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ត្រូវ សហការ កាន់តែ សកម្ម ថែម ទៀត ជាមួយ ក្រសួង ទេសចរណ៍ បណ្តុះបណ្តាល ជំនាញ បន្ថែម និង ជំនាញ ថ្មី ដល់ យុវជន ស្រប តាម យន្តការអភិវឌ្ឍន៍ ជំនាញ ទេសចរណ៍ ប្រកបដោយ ចីរភាព ។
៤៖ បន្ទាប់ពី វិបត្តិ កូវីដ - ១៩ សម្ដេច នាយក រដ្ឋមន្ត្រី បាន បង្ហាញ ការយល់ឃើញ ថា និន្នាការ ទេសចរណ៍ នឹង មាន សភាព ខុសពីមុន ពោលគឺ ការគិតគូរ អំពី សុវត្ថិភាព និង ផាសុកភាព នឹង ក្លាយជា កត្តា អាទិភាព ក្នុង ការសម្រេចចិត្ត ជ្រើសរើស គោលដៅ ធ្វើដំណើរកម្សាន្ត ។ ក្នុង ន័យ នេះ សម្ដេច តេជោ បាន លើកទឹកចិត្ត និង គាំទ្រ នូវ ការដាក់ ចុះ យុទ្ធនាការ « កម្ពុជា សុវត្ថិភាព ឬ Cambodia safe» ដើម្បី ជា មុំ យុទ្ធសាស្រ្ត ទាក់ទាញ ទេសចរ ផ្ទៃក្នុង និង អន្តរជាតិ ក្នុង ដំណាក់កាល នៃ ការបើក ឡើងវិញ និង ពេល អនាគត ។
បន្ថែម ពីលើ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន លើកទឹកចិត្ត ដល់ ស្ថាប័ន ពាក់ព័ន្ធ អាជ្ញាធរ មូលដ្ឋាន ផ្នែក ឯក យុវជន និង ដៃគូ អភិវឌ្ឍន៍ ជាតិ - អន្តរជាតិ ចូលរួម ត្រៀមលក្ខណៈ ចាប់ផ្តើម បើក ឡើងវិញ នូវ សកម្មភាព ទេសចរ ជាតិ - អន្តរជាតិ ជា ជំហាន ៗ នា ពេល ខាងមុខ ផងដែរ ៕ ព្រះចៅ អធិការ វត្ត គិរី ធម្មរាជ ខេត្ត កំពង់ឆ្នាំង ប្រកាស ផ្អាក ពិធី កាន់ បិណ្ឌ ក្នុង វត្ត ដើម្បី ចូលរួម ទប់ស្កាត់ ជំងឺ កូវីដ១៩
ព្រះសាសន សោភ័ណ ហឿម សុវណ្ណារ៉ា បាន មាន សង្ឃ ដិកា ថា ការផ្អាក ពិធី កាន់ បិណ្ឌ នេះ មិន មែន ដោយសារ វត្ត របស់ ព្រះមាន ផ្ទុះ ជំងឺ កូវីដ១៩ នោះ ទេ តែ ផ្អាក ដើម្បី ចូលរួម ទប ស្កាត់ ជំងឺ កូវីដ១៩ កុំ ឱ្យ មាន ការឆ្លង រីករាលដាល ខ្លាំង ដោយ ហេតុ ថា បន្ទាប់ពី ពិធី កាន់ បិណ្ឌ បាន ២វេន រួច មក មាន ការផ្ទុះ ឆ្លង រីករាលដាល ខ្លាំង នៃ ជំងឺ កូវីដ១៩ នេះ នៅ តាម វត្ត មួយចំនួន ដូចនេះ ដើម្បី បង្ការ ជំងឺ នេះ ក៏ សម្រេច ផ្អាក ពិធី កាន់ បិណ្ឌ តែម្តង សម្រាប់ វត្ត គិរី ធម្មរាជ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន ផ្តល់ អាទិភាព ដល់ ព្រះចៅ អធិការ នៅ តាម វត្ត នីមួយ ៗ ក្នុង ការដាក់ចេញ វិធានការ នានា ដើម្បី ទប់ស្កាត់ និង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នេះ ផងដែរ ៕
អាជ្ញាធរ ខេត្ត ឧត្តរមានជ័យ សម្រេច បិទ ផ្សារ ត្រពាំងប្រាសាទ និង ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ៣១ ខ្នង ទៀត នៅ ស្រុក ត្រពាំងប្រាសាទ ដើម្បី ការពារ ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩
( ឧត្តរមានជ័យ )៖ អាជ្ញាធរ ខេត្ត ឧត្តរមានជ័យ បាន ចេញ សេចក្តីសម្រេច បិទ ខ្ទប់ បណ្តោះអាសន្ន ផ្សារ ត្រពាំងប្រាសាទ និង ផ្ទះ ប្រជាពលរដ្ឋ ជុំវិញ ផ្សារ ត្រពាំងប្រាសាទ ព្រមទាំង ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ៣១ ខ្នង ទៀត ស្ថិត ក្នុង ស្រុក ត្រពាំងប្រាសាទ ដើម្បី ទប់ស្កាត់ ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ ។
យោង សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ ដែល អង្គភាព ព័ត៌មាន Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន សម្រេច ថា ត្រូវបាន បិទ ខ្ទប់ បណ្តោះអាសន្ន ទីតាំង ផ្សារ និង ផ្ទះ ប្រជាពលរដ្ឋ ជុំវិញ ផ្សារ ត្រពាំងប្រាសាទ ព្រមទាំង ផ្ទះ ប្រជាពលរដ្ឋ ចំនួន ៣១ ខ្នង ទៀត ស្ថិត ក្នុង ស្រុក ត្រពាំងប្រាសាទ ចាប់ពី ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២១ រហូត មាន ការសម្រេច ជាថ្មី ដោយ មូលហេតុ ទីតាំង មាន ការពាក់ព័ន្ធ និង អ្នកជំងឺ កូវីដ១៩ ។
ក្នុង អំឡុង ពេល នៃ ការបិទ ខ្ទប់ ជា បណ្តោះអាសន្ន នេះ រដ្ឋបាល ស្រុក ត្រពាំងប្រាសាទ ត្រូវ៖
( កោះកុង) ៖ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ អាជ្ញាធរ ក្រុង ខេមរភូមិន្ទ ខេត្ត កោះកុង បាន ចុះ រៀបចំ សណ្តាប់ធ្នាប់ និង ចាត់ វិធានការក្តៅ ចំពោះ ការលក់ដូរ លើ ចំណី ផ្លូវ សាធារណៈ យ៉ាង អាណាធិបតេយ្យ ជុំវិញ បរិវេន ផ្សារ ដង ទង់ ក្រោយ ពួកគាត់ មិន ព្រម ចូល លក់ដូរ ក្នុង ផ្សារ ។
លោក ឈឹម ចិន អភិបាល រង ក្រុង បាន ឲ្យដឹង ថា អាជ្ញាធរ ធ្លាប់ បាន ជូន សេចក្តី ដំណឹង ទៅកាន់កាន់ បងប្អូន អាជីវករ លក់ដូរ ផ្នែក ខាងក្រៅ ជាច្រើន ដង រួច មកហើយ ប៉ុន្តែ ពួកគាត់ មិន ស្តាប់ ហើយ នៅតែ ផ្គើន មិន ព្រម ចូល លក់ដូរ ក្នុង ផ្សារ វិញ ដែល មាន តូប បម្រុងទុកឲ្យ គាត់ លក់ គ្រប់គ្រាន់ ហើយ មាន ទីតាំង ១កន្លែង ទៀត គឺ ផ្សារ កោះ កុង ថ្មី នៅ មិន ឆ្ងាយ ពី គ្នា ប៉ុន្មាន ទេ សម្រាប់ ទុក ជូន គាត់ ចូល លក់ ។
លោក អភិបាល រង ក្រុង បាន បន្ត ថា ក្រោយពី មាន មាន ចំណាត់ការក្តៅ ពី អាជ្ញាធរ អាជីវករ មួយចំនួន តូច នេះ បាន យល់ព្រម ចូល លក់ដូរ នៅក្នុង ផ្សារ ដែល មាន តូប បម្រុងទុកឲ្យ គាត់ វិញ តាម ការណែនាំ របស់ អាជ្ញាធរ ហើយ សន្យា ថា មិន ចេញ លក់ លើ ផ្លូវ សាធារណៈ ទៀត ទេ នាំឲ្យ ខូច សណ្តាប់ធ្នាប់ និង បរិស្ថាន ផ្សារ ។
លោក បាន ព្រមាន ថា « បើសិន អាជីវករ ណា ម្នាក់ មិន ព្រម ស្តាប់ តាម ការណែនាំ អាជ្ញាធរ នឹង ដកហូត តូប ទុក ជា សម្បត្តិ រដ្ឋ និង ធ្វើ ការពិន័យ តាម ផ្លូវ ច្បាប់ »៕
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន គណៈកម្មការ អប់រំ យុវជន កីឡា កិច្ចការ សាសនា វប្បធម៌ និង ទេសចរណ៍ នៃ រដ្ឋសភា និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា បាន ចូលរួម អបអរសារទរ ជាមួយ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ដែល ជា លើក ដំបូង ក្នុង ប្រវិត្ដសាស្ដ្រ កម្ពុជា អង្គការ សហ ប្រជាជាតិ (UN) បាន ប្រកាស វាយតម្លៃ ថា កម្ពុជា បាន ផុត ពី ប្រទេស អភិវឌ្ឍ តិចតួច ។
ការចូលរួម អបអរសារទរ របស់ លោក ហ៊ុន ម៉ានី យ៉ាង ដូច្នេះ ថា ធ្វើឡើង ក្នុង ឱកាស អញ្ជើញ ចូលរួម ក្នុង កម្មវិធី សន្និសីទ សារព័ត៌មាន ស្តីពី « កម្មវិធី ស្វ័យ សិក្សា MoEYS E-Learning ៥ខែ បន្ទាប់ពី ការដាក់ ឲ្យ ប្រើប្រាស់ ជាសាធារណៈ » ដែល រៀបចំ ដោយ ក្រសួង អប់រំ យុវជន និង កីឡា និង សហភាព សហព័ន្ធ យុវជន កម្ពុជា នា ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នៅ វិទ្យាល័យ ព្រះស៊ីសុវត្ថិ ។
លោក ហ៊ុន ម៉ានី បាន ថ្លែង យ៉ាង ដូច្នេះ ថា « ថ្ងៃ នេះ ក្នុង នាម ជា ប្រជាពលរដ្ឋ ខ្មែរ មួយ រូប ខ្ញុំ សូម ចូលរួម អបអរសារទរ ជាមួយ សម្ដេច តេជោ ហ៊ុន សែន ដែល ប៉ុន្មាន ថ្ងៃ មុន បាន ប្រកាស ថា ជា លើក ដំបូង ហើយ ក្នុង ប្រវិត្ដសាស្ដ្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដែល អង្គការ សហ ប្រជាជាតិ បាន ប្រកាស វាយតម្លៃ ថា កម្ពុជា បាន ផុត ឬ ក៏ បាន មាន លក្ខណៈ សម្បត្ដិ មួយ កម្រិត បន្ថែម ទៀត ដោយ មិន មែន ស្ថិត នៅក្នុង ប្រទេស អភិវឌ្ឍន៍ តិច តូច គឺ បាន ផុត ទៅដល់ ជា ប្រទេស នៃ ការអភិវឌ្ឍន៍ ក្នុង ដំណាក់ការអភិវឌ្ឍន៍ » ។
លោក ហ៊ុន ម៉ានី បាន បន្ថែម ទៀត ថា ក្នុង នាម ជា ប្រជាពលរដ្ឋ ខ្មែរ គ្រប់ រូប គួរតែ មាន មោទភាព ព្រោះថា ប្រទេស ផ្សេង ៗ ក៏ ជួប បញ្ហា កូវីដ - ១៩ ហើយ ប្រទេស ផ្សេង ៗ មាន វិធីសាស្ដ្រ របស់ គេ ប៉ុន្ដែ កម្ពុជា ក៏ មាន វិធីសាស្ដ្រ ធ្វើ យ៉ាងណា ដើម្បី បងប្អូន សិស្សានុសិស្ស ដែល ជា ធនធាន មិន អាច ខ្វះ បាន របស់ កម្ពុជា នៅតែ ទទួលបាន មេរៀន ក្នុង ការបណ្ដុះបណ្ដាល សមត្ថភាព របស់ ខ្លួន ផងដែរ ។
គូសបញ្ជាក់ ថា នា ពេល ថ្មី ៗ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ប្រកាស ថា តាម ការវាយតម្លៃ ចុងក្រោយ របស់ អង្គការ សហ ប្រជាជាតិ (UN) ដែល ធ្វើឡើង នៅ រៀងរាល់៣ ឆ្នាំ ម្តង បង្ហាញ ថា ជា លើក ដំបូង ក្នុង ប្រវត្តិសាស្រ្ត របស់ កម្ពុជា កម្ពុជា មាន លទ្ធភាព អាច បំពេញ តាម លក្ខខណ្ឌ ដែល អាច ចាត់ទុក ថា រួចផុត ពី ឋានៈ ជា ក្រុម ប្រទេស មាន ការអភិវឌ្ឍ តិចតួច ។
ការលើកឡើង របស់ សម្តេច តេជា ហ៊ុន សែន យ៉ាង ដូច្នេះ តាមរយៈ សារលិខិត អបអរសាទរ ក្នុង ឱកាស នៃ ទិវា សន្តិភាព អន្តរជាតិ ថ្ងៃទី ២១ ខែកញ្ញា ឆ្នាំ ២០២១ ។
សម្តេច តេជោ បន្ត ថា អស់ រយៈពេល ជាង ពីរ ទសវត្សរ៍ កន្លងមក នេះ កំណើន សេដ្ឋកិច្ច កម្ពុជា បាន កើនឡើង ជា មធ្យម ប្រមាណ ៧% ជារៀងរាល់ ឆ្នាំ ហើយ សន្ទុះ នៃ ការរីកចម្រើន នេះ បាន ត្រួសត្រាយ ផ្លូវ សម្រាប់ កម្ពុជា ទទួលបាន ឋានៈ ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ទាប ក្នុង ឆ្នាំ ២០១៥ ហើយ អាចនឹង ឈានទៅ សម្រេចបាន ឋានៈ ជា ប្រទេស មាន ចំណូល មធ្យម កម្រិត ខ្ពស់ ត្រឹម ឆ្នាំ ២០៣០ និង ប្រទេស មាន ចំណូល កម្រិត ខ្ពស់ នៅ ឆ្នាំ ២០៥០ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ឲ្យដឹង ទៀត ថា ជា ការកត់សម្គាល់ បើ ទោះជា កម្ពុជា កំពុង ទទួលរង ផល ប៉ះពាល់ ដោយសារ វិបត្តិ ជំងឺ កូវីដ១៩ យ៉ាងណា ក៏ដោយ ក៏ អាត្រា កំណើន សេដ្ឋកិច្ច កម្ពុជា សម្រាប់ ឆ្នាំ ២០២១ រំពឹង ថា នឹង អាច ងើបឡើង មកវិញ ស្ថិត នៅក្នុង រង្វង់២. ៥% បន្ទាប់ពី មាន ការធ្លាក់ចុះ ក្នុង កម្រិត - ១. ៩% ក្នុង ឆ្នាំ ២០២០៕ ក្រុង សៀមរាប បន្ត ដាក់ ជា « តំបន់ ក្រហម » និង « លឿង ទុំ » រយៈពេល ១សប្ដាហ៍ ទៀត
សូម បញ្ជាក់ ថា អាជ្ញាធរ ខេត្ត សៀមរាប បាន កំណត់ ភូមិសាស្រ្ដ ក្រុង សៀមរាប ជា តំបន់ ក្រហម និង លឿង ទុំ កាលពី ថ្ងៃទី ១៧ ខែកញ្ញា កន្លង បន្ទាប់ពី ក្រុង មួយ នេះ មាន ការឆ្លង រាលដាល ជំងឺ កូវីដ១៩ មាន សន្ទុះ ខ្លាំង គួរឱ្យ កត់សម្គាល់ ។ អាជ្ញាធរ បញ្ជាក់ ថា វិធានការ នេះ នឹង ជួយ គ្រប់គ្រង និង ទប់ស្កាត់ ការឆ្លង រាលដាល បន្ត ទៅ កាន់តែ តំបន់ ផ្សេង មាន ប្រសិទ្ធភាព ខ្ពស់ ៕ រដ្ឋបាល ខណ្ឌ ដង្កោ ពង្វាង ចរាចរណ៍ ជា បណ្តោះអាសន្ន លើ កំណាត់ ផ្លូវ បេតុង ស្ពាន ស៊ិន ទ្រី ( ចាស់ ) ស្ថិត នៅ ភូមិ សំបួរ សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ
( ភ្នំពេញ ) ៖ រដ្ឋបាល ខណ្ឌ ដង្កោ នៅ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ពី ការពង្វាង ចរាចរណ៍ ជា បណ្តោះអាសន្ន លើ កំណាត់ ផ្លូវ បេតុង ឋាន ស៊ិន ទ្រី ( ចាស់ ) ស្ថិត នៅ ភូមិ សំបួរ សង្កាត់ ដង្កោ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ដើម្បី ធានា បាន សុវត្ថិភាព ដល់ ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ និង ដើម្បី បញ្ចៀស ការកកស្ទះ ចរាចរណ៍ ។ នេះ បើ យោង តាម សេចក្តីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន ។
រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បន្ដ ថា ការពង្វាង នេះ គឺ ដើម្បី រៀបចំ ដាក់ ប្រព័ន្ធ លូ ដែល មាន មុខកាត់ ១.៥ម៉ែត្រ ចំនួន ០២ ខ្សែ ដើម្បី រំដោះ ទឹក ជំនន់ ទឹកភ្លៀង ដែល ជន់ លិច ផ្លូវ បេតុង និង ផ្ទះ ប្រជាពលរដ្ឋ ស្ថិត ក្នុង ភូមិ សំបួរ សង្កាត់ ដង្កោ ។ ដើម្បី ធានា បាន សុវត្ថិភាព ដល់ ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ ឆ្លងកាត់ លើ កំណាត់ ផ្លូវ បេតុង ស្ពាន ស៊ិន ទ្រី ( ចាស់ ) និង ដើម្បី បញ្ចៀស ការកកស្ទះ ចរាចរណ៍ ។
រដ្ឋបាល ខណ្ឌ ដង្កោ បាន បញ្ជាក់ ថា ការពង្វាង ចរាចរណ៍ ជា បណ្តោះអាសន្ន នឹង ធ្វើឡើង ចាប់ពី ថ្ងៃសុក្រ ៣រោច ខែ ភទ្រប ទ ឆ្នាំ ឆ្លូវ ត្រី ស័ក ព .ស ២៥៦៥ ត្រូវនឹង ថ្ងៃទី ២៤ ខែកញ្ញា ឆ្នាំ ២០២១ ត ទៅ រហូតដល់ មាន ការជូនដំណឹង ជាថ្មី ។
បន្ថែម ពី នេះ ទៀត លោក ក៏ បាន សង្ឃឹម និង ជឿជាក់ ថា សាធារណជន និង ប្រជាពលរដ្ឋ ទាំងអស់ ចូលរួម អនុវត្ត តាម សេចក្តីជូនដំណឹង នេះ ដោយ ស្មារតី យោគយល់ អធ្យាស្រ័យ ដោយ ក្តី អនុគ្រោះ ៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខណ្ឌ ដង្កោ៖ សម្តេច ក្រឡាហោម ស ខេង ណែនាំ ដល់ ប្រធាន ក្រុមប្រឹក្សា ស្រុក - ក្រុង - ខណ្ឌ ពី ការពង្រឹង ការអនុវត្ត តួនាទី ភារកិច្ច របស់ ការិយាល័យ ប្រជាពលរដ្ឋ ក្រុង ស្រុក ខណ្ឌ
សម្តេច ក្រឡាហោម ស ខេង សូម ធ្វើ ការណែនាំ មួយចំនួន ដល់ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ដូច ខាងក្រោម៖
* នៅពេល អនុម័ត គម្រោង ថវិកា ប្រចាំ ឆ្នាំ របស់ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ក្រុមប្រឹក្សា ក្រុង ស្រុក ខណ្ឌ ត្រូវ ពិនិត្យមើល និង ធានា ថា ផែនការ សកម្មភាព និង ថវិកា របស់ ការិយាល័យ ប្រជាពលរដ្ឋ ក្រុង ស្រុក ខណ្ឌ ត្រូវបាន ដាក់បញ្ចូល នៅក្នុង គម្រោង ថវិកា ប្រចាំ ឆ្នាំ របស់ រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ
* រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ត្រូវ ធានា ឱ្យ មាន ការ ការពារ ដល់ ប្រធាន និង បុគ្គលិក ការិយាល័យ ប្រជាពលរដ្ឋ ពី ការគំរាមកំហែង នានា ក្នុង ដំណើរការ អនុវត្ត តួនាទី និង ភារកិច្ច របស់ ខ្លួន ជាពិសេស នៅក្នុង ដំណើរការ ស៊ើបអង្កេត និង សម្រុះសម្រួល ដោះស្រាយ បណ្ដឹង
* រដ្ឋបាល ក្រុង ស្រុក ខណ្ឌ ត្រូវ ផ្តល់ ប្រាក់ បេសកកម្ម ដល់ ប្រធាន ការិយាល័យ ប្រជាពលរដ្ឋ ក្រុង ស្រុក ខណ្ឌ ឱ្យ ស្មើនឹង ប្រាក់ បេសកកម្ម របស់ ប្រធាន ក្រុមប្រឹក្សា ក្រុង ស្រុក ខណ្ឌ និង ត្រូវ បែងចែក ប្រាក់ រង្វាន់ លើកទឹកចិត្ត ដែល ទទួលបាន ពី ការផ្តល់ សេវា រដ្ឋបាល ជូន ប្រធាន និង បុគ្គលិក ការិយាល័យ ប្រជាពលរដ្ឋ ដើម្បី ឧបត្ថម្ភ លើកទឹកចិត្ត ដល់ យន្តការសម្រុះសម្រួល ដោះស្រាយ បណ្តឹង នេះ
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា បាន រៀបចំ កិច្ចប្រជុំ ពិភាក្សា ជាមួយ តំណាង គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ក្រោម ការចូលរួម របស់ លោកស្រី បណ្ឌិត ជា សិរី ឧបការី ទេសាភិបាល និង ជា អគ្គ នាយក បច្ចេកទេស ។
ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើក ពី ភាពសំខាន់ របស់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ក្នុង ការអនុវត្ត គោល នយោបាយ និង វិធានការ នានា ដើម្បី គាំទ្រ ការងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច ក្នុង ស្ថានភាព កំពុង ប្រឈម ភាព មិន ច្បាស់លាស់ ពី វិបត្តិ ជំងឺ កូវីដ១៩ នៅក្នុង កិច្ចប្រជុំ ដែល រៀបចំ ជាមួយ តំណាង គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ រៀបចំឡើង នៅ ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
ធនាគារ ជាតិ នៃ កម្ពុជា បញ្ជាក់ ថា « ក្នុង ស្ថានភាព ដែល កម្ពុជា ក៏ ដូចជា ប្រទេស នានា កំពុង ប្រឈម នឹង ភាព មិន ច្បាស់លាស់ ដែល បណ្តាល មកពី វិបត្តិ ជំងឺ កូវីដ១៩ តួនាទី របស់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ មាន សារៈសំខាន់ ណាស់ ក្នុង ការចូលរួម អនុវត្ត គោល នយោបាយ និង វិធានការ នានា ដើម្បី គាំទ្រ ការងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច ប្រកបដោយ ភាពជឿជាក់ » ។
ក្នុង នោះ ប្រាក់ រៀល ក៏ មាន សារៈសំខាន់ ផងដែរ ក្នុង ការលើកកម្ពស់ ប្រសិទ្ធភាព នយោបាយ រូបិយវត្ថុ ដែល នឹង ពង្រឹង ដល់ ការរក្សា ស្ថិរភាព ថ្លៃ តម្លៃ ប្រាក់ រៀល និង គាំទ្រ សកម្មភាព សេដ្ឋកិច្ច ។
សូម ជម្រាប ថា កិច្ចប្រជុំ នេះ មាន គោលបំណង ផ្តល់ ឱកាស ដល់ ថ្នាក់ដឹកនាំ ធនាគារ ជាតិ នៃ កម្ពុជា និង គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ បាន ជួប ពិភាក្សា ផ្លាស់ប្តូរ យោបល់ ពី បច្ចុប្បន្នភាព នៃ វិស័យ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ កម្ពុជា បញ្ហា ប្រឈម និង ការអនុវត្ត គោល នយោបាយ និង វិធានការ នានា ដែល ធនាគារ ជាតិ នៃ កម្ពុជា បាន ដាក់ចេញ និង ទិសដៅ អាទិភាព ។
កិច្ច ជំនួប នេះ ត្រូវបាន រៀបចំឡើង ជាប្រចាំ ដើម្បី ពង្រឹង ការពិភាក្សា ផ្នែក គោល នយោបាយ រវាង ធនាគារ ជាតិ នៃ កម្ពុជា និង គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ៕
ក្រសួង ការងារ នឹង រៀបចំ ពិព័រណ៍ ការងារ និង ផលិតភាព អនឡាញ ឆ្នាំ ២០២១ នា ថ្ងៃទី ៤- ៥ ខែវិច្ឆិកា ខាងមុខ
តាមរយៈ សារ សំឡេង ពិសេស នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ឱ្យដឹង ថា នៅ តាម ទី វត្តអារាម មួយ ចំនួន រួមទាំង វត្ត ជំពុះ ក្អែក របស់ សម្តេច ព្រះពោធិ៍វង្ស អំ លីមហេង ផង បាន រកឃើញ មាន ការឆ្លង ជំងឺ កូវីដ១៩ ។
សម្តេច តេជោ បាន លើកឡើង ថា ការរកឃើញ ឆ្លង ជំងឺ កូវីដ១៩ នេះ ជា សញ្ញា មិន ល្អ សម្រាប់ ការគ្រប់គ្រង ជំងឺ កូវីដ១៩ ដែល អាច ឈានដល់ ការផ្ទុះឡើង ជាថ្មី នៃ ជំងឺ កូវីដ១៩ បំផ្លាញ ដល់ កិច្ចប្រឹងប្រែង ដែល កម្ពុជា បាន ខិតខំ គ្រប់គ្រង និង ធ្វើឱ្យ មាន ស្ថានភាពល្អ ប្រសើរ ក្នុង រយៈពេល កន្លងមក នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ណែនាំ ទៅ ឧប នាយក រដ្ឋមន្ត្រី អូន ព័ន្ធ មុនី ត័រ្ន រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ លោក ម៉ម ប៊ុន ហេង និង ផ្នែក ពាក់ព័ន្ធ ដទៃ ទៀត ក៏ ដូចជា រដ្ឋមន្ត្រី ក្រសួង ធម្មការ ចូលរួម ពិនិត្យ ពិចារណា លើ រឿង នេះ ឱ្យ បាន ម៉ត់ចត់ ។
សម្រាប់ សម្តេច តេជោ ហ៊ុន សែន គឺ ចង់ឱ្យ មាន ការរក្សា នូវ ស្ថានភាព ដែល កម្ពុជា បាន អនុវត្តន៍ កន្លងមក ដែល ជា ការរស់នៅ តាម បែប គន្លង ថ្មី ដោយ រក្សា នូវ ភាពស្ងប់ស្ងាត់ បន្ថយ ការប្រមូលផ្តុំ ជាដើម ។ តាម សម្តេច តេជោ ហ៊ុន សែន គឺ ចង់ឱ្យ មាន ការពិចារណា ក្នុង ផ្អាក ពិធី បុណ្យ កាន់ បិណ្ឌ និង បុណ្យ ភ្ជុំ បិណ្ឌ ។ បើ មិន ផ្អាក ពិធី បុណ្យ កាន់ បិណ្ឌ ទេ ត្រូវ រក វិធី កាត់បន្ថយ ការជួបជុំ គឺ អនុញ្ញាតឱ្យ មាន មនុស្ស តិច បំផុត ទៅ ទី អារាម កាន់ បិណ្ឌ សម្រាប់ វេន នីមួយ ៗ ។
សម្តេច តេជោ ហ៊ុន សែន បាន ផ្តល់ អាទិភាព ដល់ ព្រះចៅ អធិការ នៅ តាម វត្ត នីមួយ ៗ ក្នុង ការដាក់ចេញ វិធានការ នានា ដើម្បី ទប់ស្កាត់ និង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ នេះ ។
សម្តេច តេជោ ហ៊ុន សែន បាន សូម ការយោគយល់ ពី ព្រះសង្ឃ គ្រប់ ព្រះអង្គ និង ប្រជាពុទ្ធ បរិស័ទ ទូទាំង ប្រទេស ចំពោះ មុខ ស្ថានភាព ដ៏ លំបាក របស់ សង្គមជាតិ នា ពេលនេះ ។ សម្តេច តេជោ រំពឹង ថា ក្រោយ ពិធី បុណ្យ កាន់ បិណ្ឌ ឬ បុណ្យ ភ្ជុំ បិណ្ឌ នេះ ទៅ នឹង មាន មហន្តរាយ សម្រាប់ ប្រជាពលរដ្ឋ ខ្មែរ ព្រោះតែ ជំងឺ កូវីដ១៩ ៕
( ភ្នំពេញ ) ៖ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន បាន ផ្តល់ អំណោយ ជា លើក ទី២ ជូន អង្គការ ផ្ទះបាយ កុមារ ដែល ស្ថិត នៅ សង្កាត់ បឹងកេងកង៣ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ ដែល ពិធី នេះ ប្រព្រឹត្តទៅ នៅ ទីស្នាក់ការ កណ្តាល កាកបាទ ក្រហម កម្ពុជា ។
ពិធី ប្រគល់ និង ទទួល នេះ បាន ធ្វើឡើង ក្រោម អធិបតីភាព លោកស្រី ម៉ែន នារី សោភ័គ អគ្គ លេខាធិការ រង ទី១ កាកបាទ ក្រហម កម្ពុជា ។
ក្នុង ឱកាស នោះ លោកស្រី ម៉ែន នារី សោភ័គ បាន ពាំនាំ ប្រសាសន៍ របស់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ផ្តាំផ្ញើ សួរសុខទុក្ខ និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ថ្នាក់ដឹកនាំ - បុគ្គលិក នៃ អង្គការ ផ្ទះបាយ កុមារ ដែល បាន ជួយ ដល់ កុមារ ទុរគត កុមារ កំព្រា គ្មាន ទីពឹង ឱ្យ មាន អាហារ បរិភោគ និង ទទួលបាន ការសិក្សា រៀនសូត្រ បណ្តុះបណ្តាល យុវជន ឱ្យ មាន ចំណេះដឹង ហើយ ធ្វើ ការចែករំលែក ក្តីស្រឡាញ់ ដល់ កុមារ ៗ ជំនាន់ ក្រោយ ៗ ទៀត ។
ជាមួយគ្នា នោះ លោក ង៉ូវ ឈីវ ប្រធាន អង្គការ ផ្ទះបាយ កុមារ បាន ថ្លែងអំណរគុណ ចំពោះ កាកបាទ ក្រហម កម្ពុជា ជាពិសេស សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល បាន ផ្តល់ ការឧបត្ថម្ភ ជា បន្តបន្ទាប់ និង បាន ផ្តល់ អំណោយ ជូន នា ពេលនេះ ដែល កាន់តែ ជួយ សម្រួល ការលំបាក ដល់ កុមារ គ្រប់ រូប នៃ អង្គការ ផ្ទះបាយ កុមារ ។
( បន្ទាយមានជ័យ )៖ ប្រជាពលរដ្ឋ ជាច្រើន គ្រួសារ ដែល កំពុង រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង រស់ នៅ តាម ដងស្ទឹង សិរី សោភ័ណ និង ស្ទឹង មង្គល បូរី ត្រូវបាន អាជ្ញាធរ និង សមត្ថកិច្ច បាន ជម្លៀស ទៅកាន់ ទី ទួល មាន សុវត្ថិភាព តាំងពី ល្ងាច ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២១ ។
ដោយឡែក លោក រ័ត្ន ដាស៊ីណង់ អភិបាល ស្រុក មង្គល បូរី ក៏ បាន បញ្ជាក់ ផងដែរ ថា សម្រាប់ ផ្ទះ ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម បណ្តោយ ដង ស្ទឹង មង្គល បូរី បាន លិច ជា បណ្តើរ ៗ ហើយ ក្នុង នោះ លោក បាន ជម្លៀស ប្រជាពលរដ្ឋ ដឹកជញ្ជូន ទូក កាណូត មក រស់ នៅ ទី ទួល មាន សុវត្ថិភាព នៅ កន្លែង ផ្លូវ វាង ក្រុង ជាបណ្តើរ ផងដែរ ។
លោក អ៊ុ រាត្រី អភិបាល ខេត្ត បន្ទាយមានជ័យ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ ពិស្ថានភាព ទឹក ភ្លាម ៗ និង បាន ថា ក្រោយពី មាន ភ្លៀង ធំ ធ្លាក់ មក ជាប់ ៗ គ្នា ៣ ថ្ងៃ ស្រាប់តែ ទឹក ស្ទឹង សិរី សោភ័ណ ហក់ ឡើង យ៉ាង ខ្លាំង នៅ ខ្វះ តែ កន្លះ ម៉ែត្រ ទឹក អាច ឡើង ដល់ ឆ្នាំ មុន ហើយ តែ តំបន់ វាល ទំនាម ភូមិ តាម មាត់ អូរ ស្ទឹង លិច តែ មិន ទាន់ ប៉ះពាល់ ដល់ អាយុជីវិត សត្វ និង ហេដ្ឋារចនាសម្ព័ន្ធ នោះ ឡើយ ។
លោក ថា ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ទាំងអស់ ត្រូវបាន អាជ្ញាធរ ជម្លៀស ទៅ ទី ទួល សុវត្ថិភាព អស់ ហើយ ថែមទាំង បាន ចែក ស្បៀង ឲ្យ ទុក បរិភោគ ទៀតផង ។ លោក អភិបាល ខេត្ត បាន ផ្តាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ទាំងអស់ ត្រូវ ចូលរួម ថែរក្សា បរិស្ថាន ជុំវិញ កន្លែង ស្នាក់ នៅ ត្រូវ ចេះ ធ្វើ អនាម័យ ជាប្រចាំ ហូប ស្អាត ផឹក ស្អាត និង រស់ នៅ ស្អាត ៕
ចំណេះដឹង ទូទៅ៖ តើ ផែនដី មាន ប៉ុន្មាន ពណ៌ ប្រសិនបើ មើល ពី អវកាស ?
ផែនដី គឺជា ភព ដ៏ ស្រស់ស្អាត បំផុត ដែល ពោរពេញ ទៅ ដោយ សមុទ្រ ពណ៌ ខៀវ ស្រងាត់ ព្រៃឈើ ពណ៌ បៃតង វាល លម្ហ ពណ៌ ក្រហម ព្រឿង និង ពពក ពណ៌ ស ក្បុស រាយប៉ាយ តាម សណ្ឋាន ផ្សេង គ្នា ចម្រុះ សម្បូរបែប គួរ ជា ទី គយគន់ ។ នេះ បើ តាម អវកាសយានិក និង រូបភាព ដែល បាន ថត ពី ទី អវកាស មក ។
ផែនដី ប្រៀប ដូចជា ដុំ សិលា មូល ដ៏ ធំ ដែល មាន ការប្រែប្រួល ផ្ទៃ ខាងលើ និង បរិយាកាស ដោយ ឆ្លងកាត់ រយៈពេល រាប់ លាន ឆ្នាំ តាំងពី ក កើត ដំបូង មក ។ ប្រការ នេះ ហើយ ទើប ផែនដី អនុគ្រោះ ឱ្យ រុក្ខជាតិ សត្វ មនុស្ស និង ភាវៈ មាន ជីវិត ផ្សេង ទៀត រាប់ មិន អស់ អាច រស់ នៅ បាន ។
អុក ស៉ី សែន គឺជា ឧស្ម័ន ដ៏ សំខាន់ ដែល ធ្វើឱ្យ មនុស្ស សត្វ ដកដង្ហើម បាន ទ្រទ្រង់ ដល់ ការរស់នៅ ប្រចាំ ថ្ងៃ ៕
ប្រតិភូ សាលា រាជធានី ភ្នំពេញ នាំ អំណោយ សម្តេច តេជោ ហ៊ុន សែន ចែកជូន កងទ័ព នៅ សមរភូម ជួរ មុខ ក្នុង ខេត្ត ព្រះវិហារ ដែល ជា អង្គភាព សម្ព័ន្ធ មេត្រីភាព
នៅក្នុង ឱកាស នេះ លោក ស៊ុយ សារិទ្ធ បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ក៏ ដូចជា ថ្នាក់ដឹកនាំ ទាំងអស់ នៃ សាលា រាជធានី ភ្នំពេញ ជូន ចំពោះ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន ក្នុង អង្គភាព កងពល ធំ អន្តរាគមន៍ លេខ ៣ ហើយក៏ សូម ថ្លែង កោតសរសើរ ដែល កន្លងមក ក៏ ដូចជា ពេល បច្ចុប្បន្ន នេះ បាន បូជា នូវ កម្លាំង កាយ ចិត្ត ឈរ ជើង ការពារ ទឹកដី តាម ខ្សែ របន្ទាត់ ព្រំដែន កម្ពុជា ថៃ ឡាវ ដោយ មិន គិត ពី ឧបស្គ្គ អ្វី ឡើយ ។
លោក អភិបាល រាជធានី ភ្នំពេញ បាន ថ្លែង បញ្ជាក់ ថា « ជាទូទៅ អង្គភាព សាលា រាជធានី ភ្នំពេញ ដែល ជា អង្គភាព ចង សម្ព័ន្ធ មេត្រី បាន ប្រកាន់ នូវ ជំហរ ទៀងទាត់ គឺ តែងតែ ចុះ មក ជួប សួរ សុខទុក្ខ សំណេះសំណាល និង នាំ អំណោយ មក ប្រគល់ ជូន នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន របស់ យើង រៀងរាល់ ពិធី បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ និង ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ » ។
លោក ឧត្តមសេនីយ៍ ឯក ស្រី ឌឹក បាន លើកឡើង ទៀត ថា សាលា រាជធានី ភ្នំពេញ គឺជា អង្គភាព សម្ព័ន្ធ មេត្រីភាព មួយ តែង បាន យកចិត្តទុកដាក់ រួម សុខ រួម ទុក្ខ គិតគូរ ពី សុខ ទុក្ខ របស់ បងប្អូន ជាប្រចាំ ព្រមទាំង បាន ចូលរួមចំណែក ជួយ ឧបត្ថម្ភ គាំទ្រ យ៉ាង ច្រើន ដល់ អង្គភាព យើងខ្ញុំ ទាំង ស្មារតី សម្ភារ ថវិកា សម្រាប់ កសាង អង្គភាព ក៏ ដូចជា ថវិកា ចែកជូន ដល់ ដៃ បងប្អូន ផ្ទាល់ ផងដែរ ។
លោក ថា « កត្តា ទាំងអស់ នេះ គែ ពិតជា បាន សបញ្ជាក់ ឲ្យ ឃើញ យ៉ាង ច្បាស់ អំពី ការអាណិត ស្រឡាញ់ ការយកចិត្តទុកដាក់ ការរួម សុខ រួម ទុក្ខ ការផ្សារ ភ្ជាប់គ្នា យ៉ាង ជិតស្និទ្ធ រវាង សមូរ ភូមិ និង សមូរ ភូមិ ក្រោយ រវាង មន្ត្រីរាជការ ស៊ីវិល និង កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ ស្រប តាម គោល នយោបាយ ដឹកនាំ ដ៍ ត្រឹមត្រូវ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល សម្តេច តេជោ ហ៊ុន សែន ៕
សម្ដេច តេជោ ហ៊ុន សែន ចេញ សារលិខិត ក្នុង ឱកាស ទិវា ទេសចរណ៍ ពិភពលោក ឆ្នាំ ២០២១
ខាងក្រោម នេះ ជា សារលិខិត របស់ សម្តេច តេជោ ហ៊ុ ន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា៖ ខេត្ត កំពង់ធំ បិទ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជុំទី១ ជូន ប្រជាពលរដ្ឋ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង
( កំពង់ធំ )៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល និង ជា ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្របខ័ណ្ឌ ទូទាំង ប្រទេស នៅ ព្រឹក ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន អញ្ជើញ ជា អធិបតីភាព បិទ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជុំទី១ ជូន ប្រជាពលរដ្ឋ ដែល មាន អាយុ ១៨ ឆ្នាំ ឡើង នៅ ខេត្ត កំពង់ធំ ។
ក្នុង ពិធី នេះ ក៏ មាន ការចូលរួម ពី លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ ព្រមទាំង មន្ដ្រី ពាក់ព័ន្ធ ជាច្រើន ទៀត ផងដែរ ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ សាលា ខេត្ត កំពង់ធំ ។
ជាមួយគ្នា នេះ លោកស្រី ឱ វណ្ណឌីន បាន វាយតម្លៃ ខ្ពស់ ចំពោះ លទ្ធផល ដែល រដ្ឋបាល ខេត្ត កំពង់ធំ សម្រេច ក្នុង ផែនការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ ។ បន្ថែម ពី នេះ លោកស្រី ក៏ បាន ផ្ដល់ អនុសាសន៍ មួយចំនួន ជូន ដល់ រដ្ឋបាល ខេត្ត កំពង់ធំ ដើម្បី ជំរុញ ការចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ប្រជាពលរដ្ឋ ដែល នៅ សេសសល់ មិន ទាន់ បាន ចាក់ ដោយ ប្រការ ណាមួយ ។
លោកស្រី ប្រធាន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្របខ័ណ្ឌ ទូទាំង ប្រទេស បាន គូសបញ្ជាក់ អំពី ការខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ក្នុង ការដឹកនាំ រៀបចំ ផែនការ និង ដាក់ចេញ នូវ អភិក្រម ផ្កា រីក ក្នុង ការចាក់ វ៉ាក់សាំង ជូន ប្រជាពលរដ្ឋ រហូត សម្រេចបាន លទ្ធផល ជិត ៩៩ ភាគរយ នៃ ផែនការ១០លាន នាក់ ចំពោះ ប្រជាពលរដ្ឋ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង ។
បន្ថែម ពី នេះ លោកស្រី ឱ វណ្ណឌីន បាន ណែនាំ ដល់ រដ្ឋបាល ខេត្ត កំពង់ធំ ត្រូវ បន្ដ ជំរុញ និង បង្កើន នូវ ការផ្សព្វផ្សាយ យុទ្ធនាការជាតិ ក្រោម ប្រធានបទ រួមគ្នា ទទួលខុសត្រូវ ទប់ស្កាត់ ការចម្លង វីរុស កូវីដ១៩ ដល់ ប្រជាពលរដ្ឋ បន្ថែម ទៀត ដើម្បី បន្ដ ចូលរួម ទប់ស្កាត់ និង ការពារ ជំងឺ កូវីដ១៩ ។
ចំពោះ ខ្លឹមសារ នៃ សេចក្ដីព្រាង សេចក្ដីប្រកាស រួមទាំង ២៥ ចំណុច នៃ អង្គ សន្និសីទ លើក ទី៨ នៃ គណៈកម្មការ កិច្ចការ បរទេស នៃ សភា កម្ពុជា - ឡាវ - វៀតណាម (CLV) ដែល សភា កម្ពុជា ធ្វើជា ម្ចាស់ ផ្ទះ គឺ មាន ផ្សាយ ជូន ទាំងស្រុង នៅក្នុង គេហទំព័រ របស់ រដ្ឋសភា ៕ លោក ឈាង វុន ដឹកនាំ ប្រតិភូសភា កម្ពុជា ចូលរួម សន្និសីទ លើក ទី៨ នៃ គណៈកម្មការ កិច្ចការ បរទេស នៃ សភា ប្រទេស កម្ពុជា - ឡាវ - វៀតណាម
ក្នុង ដំណើការបន្ត នៃ សន្និសីទ លើក ទី៨ នា ពេលនេះ បើ ទោះបី រៀបចំ តាម ប្រព័ន្ធ និម្មិត ក៏ ពិត មែន តែ ក្នុង នាម ម្ចាស់ ផ្ទះ រៀបចំ សន្និសីទ គណៈកម្មការ កិច្ចការ បរទេស សភា កម្ពុជា បាន រៀបចំ អោយ មាន កម្មវិធី និង ដំណើរការកិច្ចប្រជុំ ប្រហាក់ប្រហែល នឹង ការប្រជុំ ផ្ទាល់ ដែរ ដោយ បាន ចែក ដំណើការជា បី វគ្គ រួមមានៈ
- វគ្គ ទី១ អង្គ សន្និសីទ បាន ស្តាប់ របាយការណ៍ ទូទៅ ស្តីពី ការអនុវត្ត ផែនការ គម្រោង អភិវឌ្ឍន៍ ក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ CLV និង វិធានការឆ្លើយតប ជំងឺ កូវីដ - ១៩ ពី គណៈកម្មាធិការ សម្របសម្រួល រួម នៃ ប្រទេស ទាំង បី កម្ពុជា ឡាវ និង វៀតណាម ។
នៅក្នុង វគ្គ នេះ គណៈកម្មាធិការ សម្របសម្រួល រួម នៃ ប្រទេស ទាំង បី កម្ពុជា ឡាវ វៀតណាម បាន លើកឡើង ពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រដ្ឋាភិបាល និង ស្ថាប័ន ពាក់ព័ន្ធ នៃ ប្រទេស របស់ ខ្លួន នៅក្នុង ការអនុវត្ត ផែនការ គម្រោង អភិវឌ្ឍន៍ ក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ CLV និង បង្ហាញ ពី វិធានការ ក្នុង ការឆ្លើយតប នឹង ជំងឺ កូវីដ - ១៩ ដែល បាន នឹង កំពុង រីករាលដាល នៅក្នុង ប្រទេស ក៏ ដូចជា នៅ តំបន់ ត្រីកោណ អភិវឌ្ឍ នេះ ផងដែរ ។
សូម ជម្រាប ថា សន្និសីទ លើក ទី៨ គណៈកម្មការ កិច្ចការ បរទេស នៃ សភា កម្ពុជា - ឡាវ - វៀតណាម រៀបចំឡើង ក្នុង គោលបំណង ពង្រឹង ភាពជាដៃគូ និង ទំនាក់ទំនង មិត្តភាព ជា ប្រពៃណី នៃ សភា ប្រទេស ទាំង បី ព្រមទាំង ពន្លឿន ការស្តារ ឡើងវិញ នូវ សេដ្ឋកិច្ច និង ជីវភាព រស់ នៅ របស់ ប្រជាជន ក្នុង តំបន់ ត្រីកោណ អភិវឌ្ឍន៍ កម្ពុជា - ឡាវ - វៀតណាម ដែល បណ្ដាល មកពី ផល ប៉ះពាល់ ដោយ វិបត្តិ កូវីដ - ១៩ ៕
អាជ្ញាធរ ខេត្ត កណ្ដាល បង្គាប់ឲ្យ មាន ការ ទប់ស្កាត់ និង បង្ក្រាប បទល្មើស ឆ្លង ដែន ខុស ច្បាប់ នានា
( កណ្ដាល ) ៖ លោក ណុប ដារ៉ា អភិបាល រង ខេត្ត កណ្តាល បាន ដាក់ បទបញ្ជា ឲ្យ សមត្ថកិច្ច គ្រប់ ជំនាញ តាម ច្រក ព្រំដែន នៃ ស្រុក កោះ ធំ ត្រូវ ទប់ស្កាត់ និង បង្ក្រាប ឱ្យ បាន នូវ បទល្មើស ឆ្លង ដែន ខុស ច្បាប់ នានា ស្រប តាម គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល ក្រសួង មហាផ្ទៃ និង រដ្ឋបាល ខេត្ត ។
លោក បាន ដាក់ បទបញ្ជា យ៉ាង ដូច្នេះ នៅក្នុង កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ គ្រប់គ្រង ច្រកទ្វារ ព្រំដែន នៅក្នុង ភូមិសាស្ត្រ ស្រុក កោះ ធំ កាលពី រសៀល ថ្ងៃទី ២២ ខែកញ្ញា ឆ្នាំ ២០២១ តំណាង អភិបាល ខេត្ត ដោយ មាន វត្តមាន ចូលរួម ពី តំណាង ស្នងការ នគរបាល ខេត្ត . សាខា គយ និង រដ្ឋាករ ខេត្ត . អាជ្ញាធរ ស្រុក កោះ ធំ ព្រមទាំង កងកម្លាំង មាន សមត្ថកិច្ច ច្រកទ្វារ ព្រំដែន និង មន្ត្រី ពាក់ព័ន្ធ ផងដែរ ។
លោក បាន ថ្លែង ថា បំណង ក្នុង ការចុះ ទៅ សិក្សា នេះ គឺ ដើម្បី ស្វែងយល់ អំពី បញ្ហា ប្រឈម នានា និង ដំណើរការ ចរាចរ ទំនិញ ទាំង ផ្លូវ ទឹក និង ផ្លូវគោក ខណ: ដែល ការរឹតបន្តឹង បញ្ហា ជំងឺ កូវីដ១៩ បាន ធ្វើឡើង ពិសេស នៅ ខាង ភាគី វៀតណាម កំពុង មាន ករណី ផ្ទុះ ជំងឺ កូវីដ១៩ ធ្ងន់ធ្ងរ ។
ក្នុង កិច្ចប្រជុំ នេះ លោក ណុប ដារ៉ា បាន ក្រើន រំលឹក ដល់ អាជ្ញាធរ មូលដ្ឋាន ប្រធាន ច្រកទ្វារ ព្រំដែន និង មេបញ្ជាការ កងកម្លាំង សមត្ថកិច្ច ឈរ ជើង តាម ព្រំដែន ត្រូវ ណែនាំ មន្ត្រី ក្រោម ឱវាទ យកចិត្តទុកដាក់ បំពេញ តួនាទី ឲ្យបាន ម៉ឺងម៉ាត់ ។
ក្នុង ឱកាស នោះ លោក បាន ផ្តាំផ្ញើ ដល់ មេបញ្ជាការ កងកម្លាំង សមត្ថកិច្ច ឈរ ជើង នៅ ព្រំដែន ណែនាំ បងប្អូន កងកម្លាំង ថែរក្សា សុខភាព និង អនុវត្ត វិធានការ សុខាភិបាល របស់ សម្តេច តេជោ ហ៊ុន សែន « ៣ការពារ និង ៣កុំ » ដើម្បី បង្ការ និង ទប់ស្កាត់ ការឆ្លង រីករាលដាន នៃ ជំងឺ កូវីដ - ១៩៕ របាយការណ៍ ស្ថានភាព បរិស្ថាន និង ធនធាន គម្រប ព្រៃឈើ កម្ពុជា ជា ភស្តុតាង បង្ហាញ ថា ក្រុម សកម្មជន និង សង្គម ស៊ីវិល មួយចំនួន មិន អាច បន្ត កុហុក ពិភពលោក អំពី រឿង ព្រៃឈើ កម្ពុជា បាន ទេ
របាយការណ៍ ស្ថានភាព បរិស្ថាន ជាតិ គឺជា ការចងក្រង ប្រមូលផ្តុំ នូវ ឯកសារ ទិន្នន័យ គោល និង ព័ត៌មានវិទ្យាសាស្ត្រ អំពី បរិស្ថាន និង ធនធាន ធម្មជាតិ សម្រាប់ អ្នកសិក្សា ស្រាវជ្រាវ អ្នកគ្រប់គ្រង អ្នកធ្វើ ផែនការ សហគមន៍ ឧស្សាហក រ វិនិយោគិន អង្គការ ជាតិ អន្តរជាតិ ប្រើប្រាស់ ជា មូលដ្ឋាន សម្រាប់ ការអប់រំ ចំណេះដឹង បរិស្ថាន ការធ្វើ សេចក្តីសម្រេច ការគ្រប់គ្រង និង ធ្វើ ផែនការ សកម្មភាព ដើម្បី សម្រេចបាន ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ស្រប តាម កម្មវិធី នយោបាយ ជាតិ ។
លើ ការងារ គ្រប់គ្រង ធនធាន ធម្មជាតិ និង អភិរក្ស ជីវៈ ចម្រុះ ក្រសួង បរិស្ថាន បាន រៀបចំ បង្កើត តំបន់ ការពារ ធម្មជាតិ ដែល បច្ចុប្បន្ន មាន ផ្ទៃដី សរុប ៧.៣លាន ហិកតា ហើយ បាន រៀបចំ កំណត់ និង បែងចែក តំបន់ គ្រប់គ្រង បោះ បង្គោល ព្រំ បណ្ដុះបណ្ដាល មន្ត្រី ជំនាញ និង មន្ត្រី ឧទ្យានុរក្ស បំពាក់ ឧបករណ៍ មធ្យោបាយ និង សម្ភារ ចាំបាច់ ពង្រឹង ការងារ ល្បាត និង អនុវត្ត វិធានការ ច្បាប់ លើ បទល្មើស ធនធាន ធម្មជាតិ ។
ឥណទាន កាបូន គឺជា ឯកតា ហិរញ្ញវត្ថុ នៃ ការវាស់វែង តាង ដោយ ការស្រូបយក ឧស្ម័ន ផ្ទះ កញ្ចក់ ដែល សម មូល ឧស្ម័ន កាបូនិក ចំនួន ១តោន ពី បរិយាកាស ។ ប្រទេស អភិវឌ្ឍ នៅលើ សាកលលោក ដែល ជាប់ កាតព្វកិច្ច ចូលរួម កាត់បន្ថយ ការបញ្ចេញ កាបូន ត្រូវ ចំណាយ ថវិកា ទិញ ឧស្ម័ន កាបូន ពី ប្រទេស កំពុង អភិវឌ្ឍ ឬ អភិវឌ្ឍ តិចតួច ដើម្បីឱ្យ ប្រទេស ក្រីក្រ ទាំងនេះ រក្សា ព្រៃឈើ ដែល ជា អាង ស្តុក កាបូន ក្នុង ការទប់ស្កាត់ ស្រូបទាញយក នូវ ឧស្ម័ន កាបូនិក ដែល ជះឥទ្ធិពល អាក្រក់ ជំរុញ ឱ្យ មាន ការកើនឡើង កម្ដៅ ។
រហូតមកដល់ ពេលនេះ មាន តែ ប្រទេស កម្ពុជា និង ប្រទេស ឥណ្ឌូនេស៊ី តែ ប៉ុណ្ណោះ នៅក្នុង ចំណោម ប្រទេស អាស៊ាន ដែល បាន លក់ ឥណទាន កាបូន ក្នុង ទីផ្សារ កាបូន ស្ម័គ្រចិត្ត នេះ ។
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៣ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១៩ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ១ករណី និង ជួញដូរ ១៨ករណី និង ឃាត់ខ្លួន ជនសង្ស័យ ២៥ នាក់ ។
ទីប្រឹក្សា សម្តេច តេជោ ស្នើ រដ្ឋមន្ត្រី អប់រំ ថៃ ផ្តល់ ឱកាស ឱ្យ កូន ៗ ពលករ ខ្មែរ បាន ទទួល ការអប់រំ
( បាងកក . ថៃ )៖ លោក បណ្ឌិត សុខ សុក្រឹត្យា ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា និង ជា រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ បាន ស្នើ រដ្ឋមន្ត្រី អប់រំ ថៃ គិតគូរ និង ផ្តល់ ឱកាស ឱ្យ កូន ៗ ពលករ ខ្មែរ កំពុង ធ្វើការ នៅក្នុង ប្រទេស ថៃ បាន ទទួល ការអប់រំ នៅ តាម សាលា បង្រៀន របស់ ថៃ ។
សំណើ លោក បណ្ឌិត សុខ សុក្រឹត្យា បាន ធ្វើឡើង ក្នុង ពេល ជួប សម្តែង ការគួរសម និង ពិភាក្សា ការងារ ជាមួយ លោកស្រី បណ្ឌិត Treenuch Thienthong រដ្ឋមន្ត្រី ក្រសួង អប់រំ ថៃ ។ នៅក្នុង ជំនួប នេះ លោក បណ្ឌិត សុខ សុក្រឹត្យា និង លោកស្រី បណ្ឌិត រដ្ឋមន្ត្រី អប់រំ ថៃ បាន ជជែកគ្នា ច្រើន លើ បញ្ហា អប់រំ រួម មាន ការផ្តល់ អាហារូបករណ៍ សម្រាប់ និស្សិត កម្ពុជា ក៏ ដូចជា ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅក្នុង ប្រទេស កម្ពុជា ក្រោម ព្រះរាជ ឧបត្ថម្ភ ដ៏ ថ្លៃថ្លា របស់ ព្រះអង្គម្ចាស់ក្សត្រិយ៍ មហាចក្រី សិរិន ថន ។
បន្ថែម ពីលើ នេះ លោក បណ្ឌិត សុខ សុក្រឹត្យា ក៏ បាន បង្ហាញ ពី ការបារម្ភ ចំពោះ កូន ៗ ពលករ ខ្មែរ ដែល ខកខាន ឱកាស ក្នុង ការសិក្សា រៀនសូត្រ ។ នៅ ចំពោះ មុខ រដ្ឋមន្ត្រី ក្រសួង អប់រំ ថៃ . លោក បណ្ឌិត សុខ សុក្រឹត្យា បាន ស្នើ រដ្ឋាភិបាល ថៃ ជួយ ទំនុកបម្រុង និង មើលការខុសត្រូវ ចំពោះ កុមារ កម្ពុជា ធ្វើ យ៉ាងណា ឱ្យ ពួកគេ មាន ឱកាស ទទួលបាន ការអប់រំ នៅ សាលា ដូច កុមារ ដទៃ ទៀត ដែរ ។
ឆ្លើយតប សំណើ នេះ លោកស្រី រដ្ឋមន្ត្រី អប់រំ ថៃ បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល ថៃ បាន យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ កុមារ កម្ពុជា ដែល បាន មក តាម ឪពុក ម្តាយ របស់ ពួកគេ បំពេញ ការងារ នៅក្នុង ប្រទេស ថៃ ។ ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល ថៃ ក៏ បាន ផ្តល់ ឱកាស ក្នុង ការសិក្សា អប់រំ នៅ តាម សាលា រដ្ឋ និង មណ្ឌល ថែទាំ កុមារ ជូន ពួកគេ ដូច នឹង កុមារ របស់ ថៃ ផងដែរ ។
បើ ទោះបី យ៉ាណា លោកស្រី រដ្ឋមន្ត្រី បាន សន្យា នាំយក សំណើ ខាងលើ ជូន គណៈ រដ្ឋមន្ត្រី ថៃ ដើម្បី រិះរក មធ្យោបាយ ជួយ ដល់ កុមារ ដែល កំពុង ត្រូវការ ជា ចាំបាច់ នូវ សិទ្ធិ ជាមូលដ្ឋាន ក្នុង ការទទួលបាន ការអប់រំ និង សិទ្ធិ ក្នុង ការអភិវឌ្ឍ នេះ ។
នៅក្នុង ជំនួប នេះ លោក បណ្ឌិត សុខ សុក្រឹត្យា ក៏ បាន ស្នើ រដ្ឋមន្ត្រី អប់រំ ថៃ ឱ្យ ជួយ បណ្តុះបណ្តាល ជំនាញ វិជ្ជាជីវៈ ទេសចរណ៍ ដោយសារ ធនធាន មនុស្ស ខាង ផ្នែក ទេសចរណ៍ នៅ មាន កម្រិត អាច ប្រឈម នឹង ការខ្វះខាត នា ពេល ខាងមុខ នៅ ពេល ដែល កម្ពុជា បើក ទទួល ទេសចរ អន្តរជាតិ និង វិស័យ ទេសចរណ៍ ពិភពលោក បើក ដំណើរការ ឡើងវិញ ។
លោក បណ្ឌិត សុខ សុក្រឹត្យា និង លោកស្រី បណ្ឌិត រដ្ឋមន្ត្រី អប់រំ ថៃ ក៏ បាន ពិភាក្សា គ្នា អំពី គម្រោង វិទ្យាស្ថាន បច្ចេកវិទ្យា កំពង់ស្ពឺ ក្រោម ព្រះរាជ ឧបត្ថម្ភ ដ៏ ថ្លៃថ្លា របស់ ព្រះអង្គម្ចាស់ក្សត្រិយ៍ មហាចក្រី សិរិន ថន ដែល បច្ចុប្បន្ន វិទ្យាស្ថាន ខាងលើ កំពុង បំពេញ បេសកកម្ម ក្នុង ការបណ្តុះបណ្តាល ជំនាញ បច្ចេកទេស ដល់ និស្សិត កម្ពុជា ជាច្រើន នាក់ ដើម្បី ពង្រឹង ធនធាន មនុស្ស ឆ្លើយតប ទៅនឹង តម្រូវការ ការងារ បច្ចុប្បន្ន នៅ កម្ពុជា ។
តាមរយៈ លោកស្រី រដ្ឋមន្ត្រី អប់រំ ថៃ លោក បណ្ឌិត សុខ សុក្រឹត្យា ក៏ បាន សម្តែង ការគោរព ថ្លែងអំណរគុណ ព្រះអង្គម្ចាស់ក្សត្រិយ៍ មហាចក្រី សិរិន ថន ដែល បាន យក ព្រះទ័យ ទុកដាក់ ក្នុង ការបណ្តុះបណ្តាល ធនធាន មនុស្ស និង គុណភាព អប់រំ នៅ កម្ពុជា ។ ទីប្រឹក្សា ផ្ទាល់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ ក្រសួង អប់រំ ថៃ ដែល បាន យកចិត្តទុកដាក់ មើល ថែ សិស្ស និស្សិត កម្ពុជា ដែល កំពុង បន្ត ការសិក្សា នៅ ប្រទេស ថៃ ក្នុង អំឡុង ពេល កូវីដ - ១៩ ។
នៅក្នុង ជំនួប ខាងលើ នេះ លោកស្រី រដ្ឋមន្ត្រី ក្រសួង អប់រំ ថៃ ក៏ បាន សម្តែង ការអបអរសាទរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ ជោគជ័យ លើ ការចាក់ វ៉ាក់សាំង និង ការគ្រប់គ្រង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ។ លោកស្រី ក៏ បាន សម្តែង នូវ ការកោតសរសើរ ចំពោះ ការដឹកនាំ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល បាន ធ្វើឱ្យ កម្ពុជា មាន សុខ សន្តិភាព ពេញលេញ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ យ៉ាង ឆាប់រហ័ស ។
លោក បណ្ឌិត សុខ សុក្រឹត្យា និង លោកស្រី រដ្ឋមន្ត្រី អប់រំ ថៃ បាន ប្តេជ្ញា បន្ត ជំរុញ ទំនាក់ទំនង រវាង កម្ពុជា - ថៃ ឱ្យ កាន់តែ ល្អ ប្រសើរ ។ ជាពិសេស បង្កើត ឱ្យ មាន កិច្ចសហប្រតិបត្តិការ ល្អ ទាំង ផ្នែក រដ្ឋ និង ឯកជន និង ប្រជាជន តាមរយៈ ការបង្កើត ឱ្យ មាន កម្មវិធី អភិវឌ្ឍ ធនធាន មនុស្ស ឲ្យ ស្រប តាម តម្រូវការ ទីផ្សារ ជំនាន់ ថ្មី ៕ នាយក រដ្ឋមន្រ្តី នូវែលសេឡង់៖ « វិធានការ lockdown អាច បញ្ចប់ ទៅ បាន ទាល់តែ ការចាក់ វ៉ាក់សាំង ឈានដល់ អត្រា ខ្ពស់ »
