( ត្បូងឃ្មុំ ) ៖ រដ្ឋបាល ខេត្ត ត្បូងឃ្មុំ បាន ចេញ សេចក្តីជូនដំណឹង ពី ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ ជូន ដល់ កុមារ ដែល មាន អាយុ៦ ឆ្នាំ ដល់ អាយុ ក្រោម ១២ ឆ្នាំ នៅ ថ្ងៃទី ១៨ ខែកញ្ញា ឆ្នាំ ២០២១ ស្អែក នេះ ក្នុង ភូមិសាស្ត្រ ខេត្ត ដើម្បី បង្កើត ភាពស៊ាំ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។ នេះ បើ យោង តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១៧ ខែកញ្ញា ។
រដ្ឋបាល ខេត្ដ ក៏ បាន អំពាវនាវ ដល់ មាតាបិតា អាណាព្យាបាល ដែល មាន បុត្រ ធីតា អាយុ ចាប់ពី ០៦ ឆ្នាំ ដល់ អាយុ ក្រោម ១២ ឆ្នាំ និង បាន ចុះឈ្មោះ ស្ម័គ្រចិត្ត ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជាមួយ អាជ្ញាធរ ភូមិ ឃុំ សង្កាត់ សូមអញ្ជើញ នាំ បុត្រ ធីតា ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ដោយ ឥត គិត ថ្លៃ នៅ តាម ទីតាំង ចាក់ វ៉ាក់សាំង ដែល រដ្ឋបាល ខេត្ត បាន រៀបចំ ចាប់ពី ថ្ងៃទី ១៨ ខែកញ្ញា ឆ្នាំ ២០២១ ដល់ ថ្ងៃទី ០៨ ខែតុលា ឆ្នាំ ២០២១ តាម ពេលវេលា ដូច ខាងក្រោម៖
រដ្ឋបាល ខេត្ត សង្ឃឹម យ៉ាង មុតមាំ ថា ប្រជាពលរដ្ឋ ដែល រស់ នៅក្នុង ខេត្ត ត្បូងឃ្មុំ និង ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការទទួលយក ការចាក់ វាក់ សាំង ការពារ ជំងឺ ក្រេវីដ១៩ ដោយ ស្ម័គ្រចិត្ត និង ឥត គិត ថ្លៃ ដើម្បី កាត់ផ្តាច់ការឆ្លង រាលដាល នៃ ជំងឺ កូវីដ១៩ នៅក្នុង សហគមន៍ និង ត្រូវ ចូលរួម បង្កើន ការអនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន នូវ វិធានការ « ៣ការពារ និង ៣កុំ »៕
ខាងក្រោម នេះ ជា សេចក្ដីជូនដំណឹង របស់ រដ្ឋបាល ខេត្ដ ត្បូង ឃ្មុំ៖ ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ជំរុញ ឱ្យ អាជ្ញាធរ មូលដ្ឋាន ខិតខំ ដោះស្រាយ បញ្ហា ប្រឈម ជូន ពលរដ្ឋ ដោយ ឈរ លើ គោលការណ៍ ទទួលខុសត្រូវ និង មាន ប្រសិទ្ធភាព
( កំពង់ធំ )៖ លោកស្រី ឃួន ឃុន ឌី សមាជិក ព្រឹទ្ធសភា និង ជា ប្រធាន ក្រុមការងារ ចុះ ជួយ ស្រុក កំពង់ស្វាយ បាន ជំរុញ អាជ្ញាធរ មូលដ្ឋាន ដោះស្រាយ បញ្ហា ជូន ប្រជាពលរដ្ឋ ដោយ ឈរ លើ គោលការណ៍ ទទួលខុសត្រូវ និង មាន ប្រសិទ្ធភាព ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ទប់ស្កាត់ ការប្រើប្រាស់ ជួញដូរ គ្រឿងញៀន និង ចូលរួម អនុវត្ត បទល្មើស ផ្សេង ៗ ។
ការជំរុញ បែប នេះ របស់ លោកស្រី ក្នុង ពេល ដែល លោកស្រី ជួប សំណេះសំណាល ជាមួយ អាជ្ញាធរ ឃុំ ភូមិ នៅក្នុង ឃុំ ផាត់ សណ្តាយ ស្រុក កំពង់ស្វាយ ខេត្ត កំពង់ធំ ថ្ងៃទី ១៦ ខែកញ្ញា ឆ្នាំ ២០២១ ដោយ មាន ការចូលរួម ពី លោកស្រី លឹម ផល្លា អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ធំ រួម នឹង ក្រុមការងារ ផងដែរ ។
នា ឱកាស នោះ ដែរ លោកស្រី ឃួន ឃុន ឌី បាន កោតសរសើរ ដល់ ក្រុមការងារ និង អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ដែល បាន ខិតខំ រួមគ្នា សម្រេចបាន នូវ សមិទ្ធផល ល្អ ៗ ជាច្រើន លើ គ្រប់ វិស័យ រក្សា បាន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ សន្តិសុខ សណ្តាប់ធ្នាប់ សាធារណៈ សុវត្ថិភាព សង្គម និង ខិតខំ ជំរុញ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម បាន ល្អ ប្រសើ ឆ្ពោះទៅ មុខ ។
បន្ថែម ពី នេះ ទៀត ព លោកស្រី ឃួន ឃុន ឌី បាន បញ្ជាក់ ប្រាប់ ទៅ មន្ត្រី មូលដ្ឋាន ត្រូវ ពង្រឹង សមាជិក ចាស់ ពង្រីក សមាជិក ថ្មី ត្រូវ មាន ការសាមគ្គីភាព ជាមួយ សមាជិក បក្ស ដើម្បី ធានា រក្សា បាន នូវ ភាព សុខដុមរមនា រក្សា ប្រក្រតីភាព នៃ ជីវភាព សង្គម សេដ្ឋកិច្ច ប្រជាជន ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ ជនរងគ្រោះ និង ជន ងាយ រងគ្រោះ នៅក្នុង មូលដ្ឋាន ឱ្យ កាន់តែ ល្អ ប្រសើរឡើង ថែម ទៀត ។
លោកស្រី បាន ផ្តាំផ្ញើ ដល់ អាជ្ញាធរ មូលដ្ឋាន ឱ្យ ធ្វើ អំពើ ល្អ ជា គម្រូ ល្អ ដល់ ប្រជាពលរដ្ឋ ដើម្បីឱ្យ ប្រជាពលរដ្ឋ ជឿ ទុកចិត្ត ត្រូវ ថែរក្សា សុខភាព ពិសេស ការពារ ជំងឺ កូវីដ១៩ និង ទៅ ទទួល វ៉ាក់សាំង ឱ្យ បាន គ្រប់ គ្នា ។
សម្រាប់ កម្មវីធី នេះ ដែរ ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ក៏ បាន សំណូមពរ សូម ឱ្យ ក្រុមការងារ ជួយ សាងសង់ ផ្លូវ ដី ស ប្រវែង ២៥ គីឡូម៉ែត្រ ចេញ ពី ឃុំ កំពង់គោ ទៅ ឃុំ ផាត់ សណ្តាយ ដើម្បី ងាយស្រួល ធ្វើដំណើរ និង ដឹក កសិផល ផ្សេង ៗ នៅ រដូវ ប្រាំង ព្រោះថា រដូវ ប្រាំង ទឹក ស្ទឹង សែន គោក រាក់ អស់ ។
លោកស្រី បាន ឧបត្ថម្ភ ថវិកា និង សម្ភារ ដល់ ក្រុមការងារ និង បាន នាំយក ថវិកា គ្រឿង ឧបភោគ បរិភោគ តៅ ប្រគេន ព្រះសង្ឈ នៅ វត្ត សុវណ្ណ ជល សាហៅ វត្ត កំពង់ចម្លង ផងដែរ ៕ រដ្ឋបាល ខេត្ត សៀមរាប កំណត់ ភូមិសាស្ត្រ មួយចំនួន ក្នុង ក្រុង សៀមរាប ជា « តំបន់ ក្រហម » រយៈពេល ១ សប្តាហ៍ ទៀត ដើម្បី ទប់ស្កាត់ កូវីដ១៩
ខាងក្រោម នេះ ជា សេចក្តីសម្រេច របស់ រដ្ឋបាល ខេត្ត សៀមរាប៖ រកឃើញ អាជីវករ លក់ មាស នៅ ផ្សារ វាល យន្ត ក្រុង ស្វាយរៀង កើត ជំងឺ កូវីដ បំប្លែង ថ្មី Delta . អាជ្ញាធរ អំពាវនាវ អ្នក ពាក់ព័ន្ធ ប្រញាប់ ធ្វើតេស្ត រក ជំងឺ កូវីដ
( ស្វាយរៀង ) ៖ រដ្ឋបាល ខេត្ដ ស្វាយរៀង និង ក្រុមការងារ ស្រាវជ្រាវ នៅ ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ បាន រកឃើញ អាជីវករ លក់ មាស ម្នាក់ មាន វិជ្ជមាន ជំងឺ កូវីដ១៩ បំប្លែង ថ្មី ប្រភេទ Delta ស្ថិត នៅ ភូមិ វាល យន្ត សង្កាត់ ស្វាយរៀង ក្រុង ស្វាយរៀង ក្រុង ស្វាយរៀង ។
ក្រោយ រកឃើញ មាន ការឆ្លង មេរោគ បំប្លែង ថ្មី ខាងលើ នេះ រដ្ឋបាល ខេត្ត អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ដែល ពាក់ព័ន្ធ ទាំង ផ្ទាល់ និង ប្រយោល សូម ធ្វើចត្តាឡី ស័ក តាមដាន សុខភាព និង អនុវត្ត តាម វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល គឺ វិធានការ « ៣ការពារ និង ៣កុំ » របស់ សម្ដេច តេជោ ហ៊ុន សែន និង ស្ម័គ្រចិត្ត ទៅ យក វត្ថុ វិភាគ សំណាក នៅ តាម ទីតាំង យក សំណាក នៅជិត ផ្ទះ ដើម្បី ស្វែងរក មេរោគ កូវីដ១៩ ។
សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ថ្លែង បែប នេះ នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០២១ ក្នុង ឱកាស អញ្ជើញ ប្រកាស បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ដល់ កុមារ អាយុ ចាប់ពី ៦ ឆ្នាំ ដល់ ១២ ឆ្នាំ នៅ វិមាន សន្តិភាព ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « យើង ចាក់ដូស ទី៣ បាន ៨០ ម៉ឺន នាក់ ហើយ ប៉ុន្តែ ដោយសារ មាន តម្រូវការ ដូស ទី៣នេះ ។ តាម គោលការណ៍ ចាក់ ដូសទី១ ហើយ ត្រូវ ចាក់ ដូស ទី២ អញ្ចឹង ត្រូវ ចាក់ដូស ទី៣ ពោលគឺ យក តាម គោលការណ៍ នេះ តែម្តង ដើម្បី កុំ ឲ្យ ពិបាក » ។
គិត ត្រឹម យប់ ថ្ងៃទី ១៦ ខែកញ្ញា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១១. ៥២៧. ០៣៣ នាក់ ក្នុង នោះ អ្នក បាន ចាក់ ដូស ទី២ មាន ចំនួន ជាង ១០លាន នាក់ ខណៈ អ្នក ចាក់ ដូស ទី៣ មាន ជាង ៨០ ម៉ឺន នាក់ ។
ក្នុង ពិធី បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ដល់ កុមារ អាយុ ចាប់ពី ៦ ឆ្នាំ ដល់ ១២ ឆ្នាំ សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បញ្ជាក់ ថា កុមារ ទាំងអស់ ដែល ត្រូវ ទទួល វ៉ាក់សាំង គឺ ធ្វើឡើង តាម គោលការណ៍ ស្ម័គ្រចិត្ត ។ សម្តេច តេជោ ថែមទាំង ណែនាំ ឱ្យ គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង សិក្សា លទ្ធភាព ការចាក់ វ៉ាក់សាំង ដល់ កុមារ អាយុ៣ ទៅ ៦ឆ្នាំ ទៀតផង ។
ទោះជា យ៉ាង នេះ ក្តី សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ទៀត ថា នៅពេល ខាងមុខ វ៉ាក់សាំង កូវីដ១៩ នឹង ក្លាយជា វ៉ាក់សាំង កាតព្វកិច្ច សម្រាប់ មនុស្ស ។ សម្តេច តេជោ ក៏ បាន ប្រាប់ អ្នក ដែល ចង់ឱ្យ សម្តេច លុប អនុក្រឹត្យ កំណត់ វ៉ាក់សាំង កូវីដ១៩ ជា វ៉ាក់សាំង កាតព្វកិច្ច ឱ្យ ទៅ ស្នើ ប្រធានាធិបតី បារាំង លុប ច្បាប់ ដាក់ វ៉ាក់សាំង នេះ ជា វ៉ាក់សាំង កាតព្វកិច្ច ដូចគ្នា ៕
ការបង្ហើប របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០២១ ក្នុង ឱកាស អញ្ជើញ ប្រកាស បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ដល់ កុមារ អាយុ ចាប់ពី ៦ ឆ្នាំ ដល់ ១២ ឆ្នាំ នៅ វិមាន សន្តិភាព ។
សម្តេច តេជោ ហ៊ុន សែន បាន ចោទសួរ ទៅ ក្រុម ប្រឆាំង ថា « តើ ចង់ឱ្យ សម្តេច បញ្ចេញ វីដេអូ ប្រជុំ របស់ អ្នកឯង ដែល និយាយ អំពី ការរៀបចំ កងកម្លាំង ឬ យ៉ាងណា » ?
សូម ជម្រាប ថា នៅ ព្រឹក ថ្ងៃទី ១៦ ខែកញ្ញា ឆ្នាំ ២០២១ សម្តេច តេជោ ហ៊ុន សែន បញ្ជាក់ យ៉ាង ច្បាស់ ៗ ទៅ ក្រុម ឧទ្ទាម ថា ការចូល ទៅ ប្រជុំ តាម Zoom ប៉ុន្មាន ថ្ងៃ មុន មិន មែន ជា ការផ្តល់ សញ្ញា សម្រាប់ ការចចារ ឲ្យ នោះ ទេ សូម កុំ យល់ ខុស ឲ្យ សោះ ប៉ុន្តែ គឺជា ការជូន សារ ទៅ ក្រុម ឧទ្ទាម ឲ្យ ភ្លឺ ភ្នែក ថា កន្លែងណា ក៏ មាន មនុស្ស របស់ សម្តេច ដែរ សូម ប្រុងប្រយ័ត្ន កុំ ធ្វើ សកម្មភាព ណាមួយ ប្រឆាំង ផលប្រយោជន៍ ជាតិ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ណែនាំ ឱ្យ គណៈកម្មការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ សិក្សា បន្ថែម អំពី លទ្ធភាព ការចាក់ វ៉ាក់សាំង ដល់ កុមារ អាយុ៣ ឆ្នាំ ទៅ អាយុ៦ ឆ្នាំ ដែល មាន ចំនួន ៩១៥. ០៤៦ នាក់ នៅក្នុង ប្រទេស កម្ពុជា ខណៈ ដែល ពួកគេ ត្រូវ ចូល សិក្សា ថ្នាក់ មត្តេយ្យ ។
ការចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ គឺ មាន សារៈសំខាន់ ណាស់ ក្នុង ការជួយ ឱ្យ ប្រជាពលរដ្ឋ មាន អង្គ បដិបក្ខ រឹងមាំ ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ១៩ កាត់បន្ថយ អត្រា ស្លាប់ ដោយសារ ឥទ្ធិពល មេរោគ ហើយក៏ ជួយ កាត់បន្ថយ ការរីករាលដាល ជំងឺ ផងដែរ ។ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល ដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន បាន យកចិត្តទុកដាក់ ខ្ពស់ លើ ការងារ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ នេះ ។
ការណែនាំ បែប នេះ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ជា អធិបតីភាព ប្រកាស បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ១៩ ជូន ដល់ កុមារ អាយុ ចាប់ពី ៦ ឆ្នាំ ដល់ ១២ ឆ្នាំ នៅ វិមាន សន្តិភាព ។
សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក ថា ការរៀបចំ សិក្សា ពី លទ្ធភាព ចាក់ វ៉ាក់សាំង កូវីដ១៩ ជូន ដល់ កុមារ មាន អាយុ៣ ឆ្នាំ ដល់ ៦ ឆ្នាំ គឺជា កិច្ចការ ទី១ ដែល ត្រូវ ធ្វើ នៅពេល ខាងមុខ នេះ ដូច្នេះ គឺ បាន ប្រគល់ ការងារ នេះ ទៅ គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់ កូវីដ១៩ ព្រមទាំង អ្នកជំនាញ ជាន់ ខ្ពស់ ផ្នែក វេជ្ជសាស្ត្រ ដើម្បី សិក្សា អំពី ការចាក់ វ៉ាក់សាំង ដល់ កុមារ ពី អាយុ៣ ឆ្នាំ ដល់ អាយុ ៦ឆ្នាំ ។
ជុំវិញ ការត្រៀម លទ្ធភាព សម្រាប់ សិក្សា ចាក់ វ៉ាក់សាំង កូវីដ១៩ ដល់ កុមារ មាន យុ៣ ឆ្នាំ ទៅដល់ អាយុ៦ ឆ្នាំ នេះ ដែរ សម្តេច តេជោ ហ៊ុន សែន បាន វាយតម្លៃ អាចនឹង ប្រើប្រាស់ វ៉ាក់សាំង ប្រមាណ ២លាន ដូស ខណៈ កុមារ ទាំង នេះ អាច ចូល សិក្សា ថ្នាក់ ម តេយ្យ សិក្សា បាន ជាដើម ។
បន្ថែម ពី នេះ សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា ប្រសិន គណៈកម្មការ ចំពោះ កិច្ច ចាក់ វ៉ាក់សាំង កូវីដ១៩ ក្នុង ក្របខណ្ឌ ទូទាំង ប្រទេស និង ក្រុម អ្នកជំនាញ វេជ្ជសាស្ត្រ ជាន់ ខ្ពស់ ផ្នែក វ៉ាក់សាំង រកឃើញ ថា វ៉ាក់សាំង កូវីដ១៩ អាច ចាក់ ជូន ដល់ កុមារ ដែល មាន អាយុ៣ ឆ្នាំ ទៅ អាយុ៦ ឆ្នាំ បាន ក្នុង នាម រាជ រដ្ឋាភិបាល គឺ មិន ខ្លាច ត្រៀម ថវិកា ដើម្បី ទិញ វ៉ាក់សាំង មក ជូន កុមារ កម្ពុជា ជាង ៩១ម៉ឺន នាក់ នោះ ទេ ។
សូម ជម្រាប ថា តាមរយៈ សារ សំឡេង របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល ត្រូវបាន ផ្សព្វផ្សាយ កាលពី ថ្ងៃទី ១៥ ខែកញ្ញា បាន គូសបញ្ជាក់ ថា វ៉ាក់សាំង ប្រើ សម្រាប់ ចាក់ ជូន កុមារ អាយុ ពី ៦ ឆ្នាំ ទៅ ១២ ឆ្នាំ នេះ គឺជា វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ដែល ជា វ៉ាក់សាំង ផលិត ដោយ ក្រុមហ៊ុន ចិន ។
សម្តេច ក៏ បាន គូសបញ្ជាក់ ក្នុង សារ សំឡេង នោះ ថា កុមារ អាយុ ចន្លោះ ពី ៦ ឆ្នាំ ទៅ ១២ឆ្នាំ នេះ មាន ចំនួន ប្រមាណ ១លាន ៨០ម៉ឺន នាក់ ។ ការចាក់ វ៉ាក់សាំង ជូន ដល់ កុមារ អាយុ ចន្លោះ ពី ៦ ឆ្នាំ ទៅ ១២ឆ្នាំ នេះ គឺ ដើម្បី បង្កើត ភាពសាំ ក្នុង សង្គម ឱ្យ កាន់តែ ធំ ដែល អាច ឈាន ទៅ បើក លំហរ សកម្មភាព ក្នុង សង្គម ឱ្យ កាន់តែ ទូលាយ ។ បន្ថែម ពីលើ នេះ គោលដៅ សំខាន់ ក្នុង ការចាក់ វ៉ាក់សាំង នេះ ដើម្បីឱ្យ កុមារ តូច ៗ អាច ចូល រៀន នៅ សាលា ឡើងវិញ ។
គិត ត្រឹម យប់ ថ្ងៃទី ១៦ ខែកញ្ញា ឆ្នាំ ២០២១ ក្រសួង សុខាភិបាល និង ក្រសួង ការពារ ជាតិ បាន ចាក់ វ៉ាក់សាំង ការពារ កូវី ដ១៩ ជូន មន្រ្តី រាជការ ប្រជាពលរដ្ឋ និង កងកម្លាំងប្រដាប់អាវុធ នៅ ទូទាំង ប្រទេស សរុប ចំនួន ១១. ៥២៧. ០៣៣ នាក់ ។
រយៈពេល ៤៧ ថ្ងៃ នៃ ការចាប់ផ្តើម ដំណើរការ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ១៩ ជូន កុមារ និង យុវវ័យ មាន អាយុ ចាប់ពី ១២ ឆ្នាំ ដល់ ១៧ ឆ្នាំ ក្រុម គ្រូពេទ្យ ចាក់ បាន ចំនួន ១. ៧២១. ៩២៤ នាក់ នាក់ ខណៈ ទូទាំង ប្រទេស ចាក់ បាន ចំនួន ១១. ៥២៧. ០៣៣ នាក់ ( គិត ត្រឹម ថ្ងៃទី ១៦ ខែកញ្ញា )៕ សណ្ឋាគារ ក្រវ៉ាន់ ត្រូវបាន ជ្រើសរើស ជា សណ្ឋាគារ ទី០១ នៅ ទីក្រុង ភ្នំពេញ ក្នុង ការធ្វើជា មណ្ឌល ព្យាបាល អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល
( ភ្នំពេញ ) ៖ ក្រសួង សុខាភិបាល បាន អនុញ្ញាតអោយ សណ្ឋាគារ ក្រវ៉ាន់ ធ្វើជា មណ្ឌល ព្យាបាល ថែទាំ អ្នកជំងឺ កូវីដ១៩ កម្រិត ស្រាល នៅក្នុង រាជធានី ភ្នំពេញ ដំបូង គេ សម្រាប់ ប្រជាជន កម្ពុជា និង ជន បរទេស ដែល មាន ជីវភាព មធ្យម មិន ចង់ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ អោយ មាន ជម្រើស ក្នុង ការស្នាក់ នៅ របៀប ឯកជន ។
មណ្ឌល ព្យាបាល ថែទាំ អ្នកជំងឺ កូវីដ១៩ ក្រវ៉ាន់ បាន សហការណ៍ ដៃគូ ជាមួយ គ្លីនិក ឯកជន ទេព និមិត្ត ក្នុង ការបើក ព្យាបាល អ្នកជំងឺ កូវីដ១៩ ស្រប តាម នីតិវិធី ប្រតិបត្តិ ស្តង់ដារ របស់ ក្រសួង សុខាភិបាល ។
ក្រុម គ្រូពេទ្យ និង គិលានុបដ្ឋាយិកា របស់ មណ្ឌល ព្យាបាល នេះ សុទ្ធតែ ជា បុគ្គលិក ពេទ្យ ដែល មាន ក្រមសីលធម៌ វិជ្ជាជីវៈ មាន បទពិសោធន៍ ក្នុង ការព្យាបាល អ្នកជំងឺ កូវីដ១៩ នឹង មាន ឱសថ ព្យាបាល ជំងឺ ប្រកបដោយ គុណភាព គួរ ជា ទី ទុកចិត្ត ។ អ្នកជំងឺ នឹង ទទួលបាន សេវា មើល ថែទាំ ព្យាបាល យ៉ាង យកចិត្តទុកដាក់ ពីសំណាក់ ក្រុមការងារ បច្ចេកទេស ពេទ្យ និង ការតាមដាន ជំងឺ យ៉ាង ហ្មត់ចត់ និង អាហារ ០៣ ពេល យ៉ាង ឆ្ងាញ់ ពិសារ ។
គួរ បញ្ជាក់ ផងដែរ ថា សណ្ឋាគារ ក្រវ៉ាន់ គឺជា សណ្ឋាគារ លំដាប់ថ្នាក់ ផ្កាយ ០៤ មាន ចំនួន ៩៥ បន្ទប់ គេង ស្អាត ទំនើប បន្ទប់ នីមួយ ៗ មាន បំពាក់ សម្ភារៈ ប្រើប្រាស់ ប្រព័ន្ធ សុវត្ថិភាព អគ្គីភ័យ ក្លឹប ហាត់ប្រាណ និង មាន អាង ហែលទឹក នៅ ជាន់ ទី ១៥ អាច អោយ អ្នក ជម្ងឺ សម្រាក លំហែរ អារម្មណ៍ និង ហាត់ប្រាណ បាន ។ លោក អ្នក អាច សម្រាក ព្យាបាល នៅ មណ្ឌល ព្យាបាល ជំងឺ កូវីដ១៩ កម្រិត ស្រាល ក្រវ៉ាន់ ប្រៀប បាន ដូចជា សម្រាក លំហែ រវិស្សមកាល នៅ សណ្ឋាគារ ផ្កាយ ០៤ និង អាច គយគន់ ទេសភាព ទីក្រុង ភ្នំពេញ ដ៏ ស្រស់ស្អាត ។
ក្រសួង ការងារ ជូនដំណឹង ពី ការឈប់ សម្រាក របស់ កម្មករ និយោជិត ដោយ មាន ប្រាក់ ឈ្នួល ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ រយៈពេល ៣ ថ្ងៃ
ក្រសួង បាន បញ្ជាក់ ទៀត ថា ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស អាច ពិភាក្សា ជាមួយ តំណាង កម្មករ និយោជិត ក្នុង ការរៀបចំ ឬ ផ្លាស់ប្តូរ ការឈប់ សម្រាក នេះ នៅ ពេលណា មួយ ផ្សេង ទៀត ក្នុង ករណី មាន ការព្រមព្រៀង ពី កម្មករ និយោជិត ។
កម្មករ និយោជិត ដែល ធ្វើការ ថ្ងៃ ឈប់បុណ្យ ភ្ជុំ បិណ្ឌ នេះ មាន សិទ្ធិ ទទួល នូវ ប្រាក់ បំណាច់ បន្ថែម ដែល មាន ចំនួន ស្មើនឹង ប្រាក់ ឈ្នួល ថ្ងៃ ធ្វើ ការធម្មតា ។
កម្មករ និយោជិត ដែល ឈប់ សម្រាក ត្រូវ អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម ស្មារតី សេចក្ដីណែនាំ របស់ ក្រសួង សុខាភិបាល ចុះ ថ្ងៃទី ៨ ខែកញ្ញា ឆ្នាំ ២០២១ ស្ដីពី ការការពារ ការចម្លង វីរុស កូវីដ - ១៩ និង ការពុល ចំណីអាហារ ក្នុង អំឡុង ពិធី បុណ្យ កាន់ បិណ្ឌ និង ភ្ជុំ បិណ្ឌ និង វិធាន សុខាភិបាល ជាធរមាន នានា ៕
រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ នឹង បើក យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ជំងឺ កូវីដ ជូន ដល់ កុមារ ពី អាយុ ៦ ឆ្នាំ ដល់ អាយុ ១២ ឆ្នាំ នៅ ថ្ងៃទី ១៨ ខែកញ្ញា ស្អែក
( ឧត្តរមានជ័យ ) ៖ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ បាន ចេញ សេចក្តីជូនដំណឹង ពី ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ ជូន ដល់ កុមារ ដែល មាន អាយុ ០៦ ឆ្នាំ ដល់ អាយុ ក្រោម ១២ ឆ្នាំ ចាប់ពី ថ្ងៃទី ១៨ ខែកញ្ញា ឆ្នាំ ២០២១ ស្អែក នេះ ក្នុង ក្របខណ្ឌ ទូទាំង ខេត្ត ដើម្បី បង្កើត ភាពស៊ាំ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ។ នេះ បើ យោង តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ព្រឹក ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០២១ នេះ ។
