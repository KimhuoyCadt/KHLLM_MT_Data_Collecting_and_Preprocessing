គណៈកម្មាធិការ នេះ នឹង ដឹកនាំ ដោយ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ លោក ប៊ុន ហុន ដែល នឹង ធ្វើជា ប្រធាន ។ តំណាង មកពី ទីស្តីការ គណៈ រដ្ឋមន្ត្រី នឹង ធ្វើជា អនុប្រធាន ។
គណៈកម្មាធិការ នេះ ក៏ នឹង ត្រូវបាន ចូលរួម ដោយ តំណាង មកពី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ។ សេវា ស៊ីវិល ; យុត្តិធម៌ ; វប្បធម៌ និង វិចិត្រ សិល្បៈ ; សាសនា និង ធម្មការ ; និង មន្ត្រី ផ្សេង ទៀត មកពី ក្រសួង មហាផ្ទៃ ។
គណៈកម្មាធិការ មាន ភារកិច្ច ស្រាវជ្រាវ និង សរសេរ បទដ្ឋាន គតិយុត្ត ដើម្បី គ្រប់គ្រង ផ្តល់ និង ដកហូត តំណែង ឧកញ៉ា ។ ពួកគេ ក៏ នឹង កំណត់ យ៉ាង ច្បាស់ នូវ សិទ្ធិ និង ភារកិច្ច របស់ អ្នក ដែល មាន កិត្តិយស ផងដែរ ។
គណៈកម្មាធិការ នឹង បញ្ជូន ការងារ ទៅ រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ លោក ស ខេង ដើម្បី ពិនិត្យ និង អនុម័ត និង រៀបចំ ឯកសារ ផ្លូវ ច្បាប់ សម្រាប់ រដ្ឋាភិបាល ប្រើប្រាស់ ក្នុង ការរៀបចំ គោល នយោបាយ ថ្មី របស់ ខ្លួន ទាក់ទង នឹង ឋានន្តរស័ក្តិ ។
ចំណាត់ការ នេះ បាន កើតឡើង បន្ទាប់ពី មាន រឿង អាស្រូវ ជា បន្តបន្ទាប់ ពាក់ព័ន្ធ នឹង ឧកញ៉ា ជាមួយ អ្នក មាន កិត្តិយស ។
នាយ ឧត្តមសេនីយ៍ សៅ សុខា បាន បញ្ជាក់ ថា មាន តែ មន្ត្រី កងរាជអាវុធហត្ថ ចំនួន ជិត ៥០០ នាក់ ប៉ុណ្ណោះ ក្នុង ចំណោម មន្ត្រី កងរាជអាវុធហត្ថ ជិត ៥០០ នាក់ ដែល បាន ធ្វើតេស្ត Covid-19 ត្រូវបាន រកឃើញ ថា បាន ឆ្លង វីរុស នេះ ។
សុខា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា ការធ្វើតេស្ត នេះ ត្រូវបាន គ្រប់គ្រង ដោយ កងរាជអាវុធ ជាតិ អស់ រយៈពេល មួយ សប្តាហ៍ ហើយ នឹង បន្ត រហូតដល់ គ្រប់ គ្នា ត្រូវបាន ធ្វើតេស្ត ។ ការធ្វើតេស្ត នេះ បាន ចាប់ផ្ដើម នៅ ថ្ងៃទី ១០ ខែឧសភា នៅ ទីបញ្ជាការ កងរាជអាវុធហត្ថ លើ ផ្ទៃ ប្រទេស ក្នុង រាជធានី ភ្នំពេញ ដោយ ប្រើ តេស្ត អង់ទី ហ្សែនរហ័ស Covid-19 ។
លោក ថា លក្ខខណ្ឌ តម្រូវ ការធ្វើតេស្ត សម្រាប់ កងរាជអាវុធហត្ថ បាន កើតឡើង បន្ទាប់ពី ពួកគេ ត្រូវបាន ចាត់ ឲ្យ អនុវត្ត បទបញ្ជា បិទ ផ្លូវ របស់ រដ្ឋាភិបាល ក្នុង រាជធានី ភ្នំពេញ ។
មន្ត្រី ទាំង ៣នាក់ ដែល បាន ធ្វើតេស្ដ រកឃើញ ថា មាន ផ្ទុក វីរុស នេះ មាន សភាព ល្អ ហើយ កំពុង ទទួល ការព្យាបាល នៅ មណ្ឌល សុខភាព ។
ការធ្វើតេស្ត រហ័ស បាន បង្ហាញ ថា ពួកគេ ភាគ ច្រើន មិន មាន ជំងឺ នោះ ទេ ។ យើង បាន រកឃើញ តែ បី ករណី ប៉ុណ្ណោះ ហើយ ពួកវា មិន ស្ថិត ក្នុង ចំណោម អ្នក ដែល ត្រូវបាន ដាក់ពង្រាយ ក្នុង បេសកកម្ម បិទ ប្រទេស ថ្មី ៗ នេះ ទេ ។
ពួកគេ ប្រហែលជា បាន ឆ្លង មេរោគ ពី សមាជិក គ្រួសារ ដែល រស់ នៅក្នុង តំបន់ ក្រហម ។ ប៉ុន្តែ យើង មិន ដឹង ច្បាស់ ថា ពួកគេ ឆ្លង ដោយ របៀប ណា នោះ ទេ ។
ដោយ មិន បាន បង្ហាញ ពី ចំនួន ជាក់លាក់ នោះ លោក កឹម សុខា បាន ថ្លែង ថា មន្ត្រី ជាច្រើន ទៀត នៅតែ ត្រូវ ធ្វើតេស្ត ។ លោក បាន ជំរុញ ដល់ សមាជិក កងរាជអាវុធហត្ថ ទាំងអស់ ត្រូវ គោរព យ៉ាង ម៉ឺងម៉ាត់ នូវ វិធានការ ការពារ សុខភាព ដែល ណែនាំ ដោយ ក្រសួង សុខាភិបាល និង ត្រូវ ប្រកាន់ខ្ជាប់ នូវ វិន័យ យោធា ។
ទណ្ឌិត ចំនួន ១៤៦ នាក់ ត្រូវបាន បញ្ជូន ចេញ ពី ពន្ធនាគារ ខេត្ត ព្រះសីហនុ ទៅកាន់ ពន្ធនាគារ ខេត្ត កំពត ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ក្នុង ចំណោម អ្នកទោស ដែល បង្កឡើង ដោយ ស្ថានភាពកកកុញ បន្ទាប់ពី អ្នកទោស ចំនួន ៣៤ នាក់ បាន ធ្វើតេស្ត វិជ្ជមាន ជំងឺ កាលពី ថ្ងៃទី ៨ ឧសភា ។
អ្នកនាំពាក្យ អគ្គ នាយកដ្ឋាន ពន្ធនាគារ (GDP) នៃ ក្រសួង មហាផ្ទៃ លោក នុត សាវ ណា បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា មិន មាន ករណី ថ្មី ត្រូវបាន រកឃើញ ទេ ចាប់តាំងពី ថ្ងៃទី ៨ ឧសភា ។
លោក បាន ថ្លែង ថា៖ សុខភាព អ្នកទោស វិជ្ជមាន កូវីដ - ១៩ គឺជា រឿង ធម្មតា ។
សាវ៉ា ណា បាន និយាយ ថា អ្នកទោស ស្ត្រី នឹង ត្រូវ ឃុំ ខ្លួន នៅ ខេត្ត កំពត រហូតដល់ ជំងឺ រាតត្បាត បាន ធូរស្រាល ។
លោក បាន មានប្រសាសន៍ ថា យើង សម្រេចចិត្ត ផ្ទេរ ពួកគេ ទៅ ពន្ធនាគារ ខេត្ត កំពត ដោយសារ ពួកគេ ជា ប្រជាជន ងាយ រងគ្រោះ ហើយ ដោយសារ ពន្ធនាគារ ខេត្ត របស់ យើង មាន តែ របង សន្តិសុខ ប៉ុណ្ណោះ ។ យើង មិន មាន ជញ្ជាំង ថ្ម ទេ ដូច្នេះ យើង គិត ថា មេរោគ ងាយ ឆ្លង ។
លោក បាន បន្ត ថា៖ ជម្រើស ដ៏ ល្អ បំផុត គឺ ត្រូវ យក វា ចេញ ដើម្បី ធ្វើ បន្ទប់ បន្ថែម ទៀត និង រក្សា សុវត្ថិភាព និង កាត់បន្ថយ ការភ័យខ្លាច ។
ដើម្បី ទប់ស្កាត់ ការរីករាលដាល នៃ មេរោគ Covid-19 GDP បាន ស្នើ ដល់ នាយក រដ្ឋមន្ត្រី អនុម័ត ការចាក់ វ៉ាក់សាំង សម្រាប់ អ្នកទោស នៅ តំបន់ ដែល មាន ហានិភ័យ ខ្ពស់ ក្នុង រាជធានី ភ្នំពេញ កណ្តាល ព្រះសីហនុ និង ខេត្ត សៀមរាប ។
បន្ទាប់ពី ទទួលបាន ការណែនាំ ពី លោក ហ៊ុន សែន អ្នក ជាប់ ឃុំ ជាង មួយ ម៉ឺន នាក់ ក្នុង រាជធានី ភ្នំពេញ ត្រូវបាន ចាក់ វ៉ាក់សាំង ក្នុង រយៈពេល បី ថ្ងៃ ចាប់ពី ថ្ងៃទី 7-9 ខែឧសភា ។
ព្រះរាជអាជ្ញា អម សាលាដំបូង រាជធានី ភ្នំពេញ បាន បន្ត សាកសួរ បុរស ពីរ នាក់ នៅ ថ្ងៃទី ១៦ ខែឧសភា លើ ករណី រឹបអូស គ្រឿងញៀន ជាង ៧០ គីឡូក្រាម នៅពេល ពួកគេ ត្រូវ ចាប់ខ្លួន កាលពី ថ្ងៃទី ១២ ខែឧសភា នៅ រាជធានី ភ្នំពេញ ។
លោក អ៊ិន សុង អនុប្រធាន មន្ទីរ ប្រឆាំង គ្រឿងញៀន ក្រុង បាន និយាយ ថា ជនសង្ស័យ ទាំង ពីរ នាក់ ជា ជនជាតិ ចិន អាយុ ៤០ ឆ្នាំ និង ៥៨ ឆ្នាំ ។
លោក បាន មានប្រសាសន៍ ថា បុរស ជនជាតិ ចិន ពីរ នាក់ នេះ គឺជា សម គំនិត នៃ ជនសង្ស័យ គ្រឿងញៀន ចំនួន ប្រាំ នាក់ ផ្សេង ទៀត រួមទាំង ជនជាតិ ខ្មែរ និង វៀតណាម ផងដែរ ដែល ត្រូវបាន ដាក់ ឱ្យ ឃុំ ខ្លួន បណ្តោះអាសន្ន ដោយ តុលាការ ខេត្ត ស្វាយរៀង កាលពី សប្តាហ៍ មុន ។
អ្នក ទាំង ៥នាក់ ត្រូវបាន ចាប់ខ្លួន កាលពី ថ្ងៃទី ១២ ខែឧសភា ពី បទ ជួញដូរ មេតំហ្វេតាមីន ជាង ១១គីឡូក្រាម ។
សុង មិន បាន និយាយ លម្អិត បន្ថែម ទៀត អំពី ថ្នាំ ញៀន ៧០ គីឡូក្រាម ដែល ប៉ូលិស បាន និយាយ ថា ពួកគេ បាន រឹបអូស នៅ ភ្នំពេញ ទេ ដោយ លើកឡើង ពី ការស៊ើបអង្កេត កំពុង បន្ត ។
ប៉ុន្តែ យោង តាម ទំព័រ ហ្វេសប៊ុក ផ្លូវការ របស់ អគ្គ ស្នងការ នគរបាល ជាតិ នៅ ថ្ងៃទី ១៦ ខែឧសភា បាន ឲ្យដឹង ថា មន្ត្រី មន្ទីរ ប្រឆាំង គ្រឿងញៀន បាន ចុះបង្រ្កាប ទីតាំង មួយ កាលពី ថ្ងៃទី ១២ ខែឧសភា នៅក្នុង សហគមន៍ ច្រកទ្វារ បុរី បឹង ស្នោ ក្នុង សង្កាត់ និរោធ ខណ្ឌ ច្បារអំពៅ ។
បច្ចុប្បន្ន ជនសង្ស័យ ទាំង ២នាក់ ត្រូវបាន គេ រកឃើញ នៅ ទីតាំង មួយ ផ្សេង ទៀត ក្នុង សង្កាត់ ។
ក្នុង ប្រតិបត្តិការ នោះ សមត្ថកិច្ច បាន ឃាត់ខ្លួន ជនសង្ស័យ ជា មេខ្លោង ទាំង ២នាក់ និង ដកហូត បាន ថ្នាំ ញៀន ជាង ៧០ គីឡូក្រាម ។
រតនគិរីៈ នគរបាល ខេត្ត រតនគិរី កំពុង តាម ចាប់ខ្លួន បុរស ម្នាក់ ដែល ចោទប្រកាន់ ថា បាន រំលោភ ក្មេងស្រី អាយុ ១៤ ឆ្នាំ ហើយ ប៉ុនប៉ង សម្លាប់ នាង កាលពី ថ្ងៃទី ៦ ខែឧសភា នៅ ឃុំ ញ៉ាង ស្រុក អណ្តូង មាស ។
លោក សោម ចាន់ តារា អធិការ នគរបាល ស្រុក បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃទី ១៦ ឧសភា ថា ជនសង្ស័យ មិន ស្គាល់ អត្តសញ្ញាណ បាន មក ធ្វើការ ជា អ្នកកាប់ ជ័រ នៅ ឃុំ ប៉ុន្មាន ថ្ងៃ មុន កើត ហេតុ ។
លោក បន្ត ថា៖ វា ពិបាក ក្នុង ការកំណត់ អត្តសញ្ញាណ ជនសង្ស័យ ព្រោះ គាត់ មិន មែន មកពី តំបន់ នោះ ទេ ។ យើង កំពុង ស្វែងរក គាត់ តាម ប្រភេទ ការងារ ដែល គាត់ ធ្វើ ។
លោក ថា ជន ដៃ ដល់ មកពី ខេត្ត ផ្សេង ហើយ ស្គាល់ ឪពុក ម្តាយ ជនរងគ្រោះ ។ ខណៈ ក្រុមហ៊ុន របស់ គាត់ ត្រូវបាន បិទ មួយ រយៈ ខ្លី គាត់ ស្នាក់ នៅក្នុង ភូមិ ។
លោក បន្ត ថា នៅ ថ្ងៃទី ៦ ខែឧសភា ឪពុក ម្តាយ នាង បាន ទៅ បាត់ ដោយ ទុក កូនស្រី ឲ្យ នៅ មើល ថែ អ្នកជិតខាង ។ ជនសង្ស័យ បាន ចូល ទៅក្នុង ផ្ទះ ឃើញ ក្មេងស្រី នៅ ម្នាក់ឯង ក៏ លួងលោម ឱ្យ ឡើងជិះ ម៉ូតូ ។
ក្រោយ ដើរ រក អស់ ជាច្រើន ម៉ោង ឪពុក ម្តាយ និង អ្នកជិតខាង បាន ប្រទះឃើញ ជនរងគ្រោះ ដេក ស្លាប់ នៅលើ ដី ព្រៃ ដោយ ត្រូវកាត់ បំពង់ ក ហើយ បញ្ជូន ទៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ។
ស្នងការ រង នគរបាល ខេត្ត លោក កែវ ដាវី មានប្រសាសន៍ នៅ ថ្ងៃទី ១៦ ឧសភា ថា ក្រុម គ្រូពេទ្យ បាន ជួយ ជីវិត ក្មេងស្រី រងគ្រោះ ។
ក្មេងស្រី កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ហើយ អាច និយាយ បាន បន្តិច ។ យើង នឹង ព្យាយាម ទទួល ព័ត៌មាន ពី នាង នៅ ពេល ដែល នាង អាច និយាយ បាន ធម្មតា ។
សមត្ថកិច្ច បាន ឲ្យដឹង ថា លោកស្រី ប៊ុន រ៉ានី ហ៊ុន សែន ភរិយា លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន និង ជា ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន អំពាវនាវ ដល់ សមត្ថកិច្ច ពាក់ព័ន្ធ ទាំងអស់ ឲ្យ នាំ ខ្លួន ជនល្មើស មក ផ្តន្ទាទោស តាម ច្បាប់ ។ លោកស្រី ប៊ុន រ៉ានី ក៏ បាន ឧបត្ថម្ភ អង្ករ មី ត្រីខ កំប៉ុង ទឹកដោះគោ ទឹក ស្អាត និង ថវិកា ចំនួន ៥លាន រៀល ( ១. ២៥០ ដុល្លារ ) ដល់ គ្រួសារ ក្មេងស្រី រងគ្រោះ ផងដែរ ។
រាជធានី ភ្នំពេញ នឹង កាត់បន្ថយ ទំហំ តំបន់ ដែល កំណត់ ជា តំបន់ ក្រហម មក ត្រឹម កម្រិត គ្រួសារ ហើយ ចាត់ ថ្នាក់ តំបន់ ពណ៌ ទឹកក្រូច ទៅជា ពណ៌ លឿង វិញ នេះ បើ តាម រដ្ឋបាល ក្រុង ។
ការចាក់ វ៉ាក់សាំង ការពារ ជំងឺ កូវីដ - ១៩ នៅ តាម បណ្តា ខណ្ឌ នានា ក្នុង រាជធានី ភ្នំពេញ នៅ ខាងក្រៅ តំបន់ ក្រហម នឹង ចាប់ផ្តើម ក្នុង ខែ នេះ ដោយ គោលដៅ បន្ទាប់ គឺ ខេត្ត កណ្តាល មុននឹង ពង្រីក ទៅ ខេត្ត ព្រះសីហនុ និង ផ្នែក ផ្សេង ទៀត ក្នុង ប្រទេស តាម លំដាប់ អាទិភាព ។.
លោក យ៉ក សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល ដែល មាន វត្តមាន ក្នុង ពិធី ប្រគល់ វ៉ាក់សាំង នៅ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ បាន ប្រាប់ អ្នកយកព័ត៌មាន ថា ឆ្នាំ នេះ យើង ត្រូវ ចាក់ វ៉ាក់សាំង គ្រប់ ៗ គ្នា នៅ គ្រប់ ទីតាំង អាទិភាព ។
គណៈកម្មការ ជាតិ ទទួល ថ្នាំ បង្ការ ជំងឺ កូវីដ - ១៩ និង គណៈកម្មាធិការ លទ្ធកម្ម វ៉ាក់សាំង ដឹកនាំ ដោយ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន កំពុង ធ្វើ គ្រប់ បែបយ៉ាង ដើម្បី ចាក់ ថ្នាំ បង្ការ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ ដែល មាន អាយុ ចាប់ពី ១៨ ឆ្នាំ ឡើង នៅក្នុង រាជធានី ភ្នំពេញ ខេត្ត កណ្តាល និង ខេត្ត ផ្សេង ៗ ទៀត ។
ក្នុង ការបង្ហោះ តាម ហ្វេសប៊ុក លោក ហ៊ុន សែន បាន និយាយ ថា កម្ពុជា បាន ទិញ វ៉ាក់សាំងស៊ីណូ វ៉ាក់ ចំនួន ៣លាន ដូស រហូតមកដល់ ពេលនេះ ក្នុង នោះ មាន ចំនួន ៥០ ម៉ឺន ដូស ដែល បាន មកដល់ ថ្ងៃទី ១៦ ឧសភា ។
លោក សម្បត្តិ បាន បញ្ជាក់ ជាថ្មី ថា កម្ពុជា នឹង រៀបចំ ការផ្គត់ផ្គង់ វ៉ាក់សាំង ឱ្យ បាន គ្រប់គ្រាន់ ដើម្បី ចាក់ វ៉ាក់សាំង ការពារ ប្រជាជន ពី ១០ ទៅ ១៣ លាន នាក់ ។
មកទល់ ពេលនេះ កម្ពុជា បាន ចម្លង មនុស្ស ជាង ពីរ លាន នាក់ ហើយ ។
នៅ តំបន់ ក្រហម ក្នុង រាជធានី ភ្នំពេញ ក្រុម គ្រូពេទ្យ យោធា បាន ចាប់ផ្តើម ចាក់ ថ្នាំ លើក ទី២ ដល់ ប្រជាពលរដ្ឋ បន្ទាប់ពី ការចាក់ លើក ទី១ ជិត រួចរាល់ សម្រាប់ មនុស្ស គ្រប់ គ្នា ក្នុង រយៈពេល ត្រឹមតែ ១៥ ថ្ងៃ ប៉ុណ្ណោះ ។
លោក អ៊ិត សារ៉ាត់ អគ្គ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ ចម្រុះ នៃ កងយោធពល ខេមរភូមិន្ទ មានប្រសាសន៍ ថា ក្នុង រយៈពេល ១៥ ថ្ងៃ មាន ប្រជាពលរដ្ឋ ជាង ៦៥ ម៉ឺន នាក់ ត្រូវបាន ចាក់ វ៉ាក់សាំង ដោយ ចាក់ លើក ទី១ ។ យោធា បាន ដាក់ពង្រាយ គ្រូពេទ្យ ចំនួន 3.442 នាក់ មកពី 31 អង្គភាព សម្រាប់ យុទ្ធនាការ ចាក់ វ៉ាក់សាំង នេះ ។
ក្រសួង ការពារ ជាតិ បាន ចាប់ផ្តើម ដំណើរការចាក់ វ៉ាក់សាំង នៅ តំបន់ ក្រហម ក្នុង រាជធានី ភ្នំពេញ ក្នុង ខណ្ឌ ចំនួន ៦ រួម មាន កំបូល ដង្កោ ពោធិ៍សែនជ័យ មានជ័យ ទួលគោក និង ឬស្សីកែវ កាលពី ថ្ងៃទី១ ខែឧសភា ។
សម្រាប់ ប្រជាពលរដ្ឋ នៅ ក្រៅ តំបន់ ក្រហម រដ្ឋបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ១៥ ខែឧសភា បាន ប្រកាស យុទ្ធនាការ លើក ទី១ សម្រាប់ សង្កាត់ បឹងកេងកង និង ខណ្ឌ សែនសុខ ចាប់ពី ថ្ងៃទី ១៨ ដល់ ថ្ងៃទី ៣១ ខែឧសភា ដោយ ការចាក់ លើក ទី២ នឹង ធ្វើឡើង នៅ ថ្ងៃទី១ - ១៥ ខែមិថុនា ។
ដោយឡែក អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល លោកស្រី ឱ វណ្ណឌីន មានប្រសាសន៍ ថា អ្នក ដែល ជាសះស្បើយ ពី ជំងឺ កូវីដ - ១៩ មិន ចាំបាច់ ចាក់ វ៉ាក់សាំង ការពារ ជំងឺ នោះ ទេ ព្រោះ ពួកគេ បាន បង្កើត អង្គ បដិប្រាណ ចំពោះ ជំងឺ SARS-CoV-2 រួចហើយ ប៉ុន្តែ ពួកគេ អាច ចាក់ ថ្នាំ បាន ៦ ខែ បន្ទាប់ពី ជាសះស្បើយ ប្រសិនបើ ពួកគេ បំណងប្រាថ្នា ។
វ៉ាន់ ឌីន ដែល ជា ប្រធាន គណៈកម្មាធិការ ជាតិ ទទួល ថ្នាំ បង្ការ Covid-19 ផងដែរ នោះ បាន កត់សម្គាល់ ថា អ្នក ដែល នៅតែ ចង់ ចាក់ វ៉ាក់សាំង ប្រឆាំង នឹង វីរុស ថ្មី និង ប្រភេទ របស់ វា អាច ធ្វើ ដូច្នេះ បាន ប្រាំមួយ ខែ បន្ទាប់ពី ការជាសះស្បើយ ឡើងវិញ ។
អង្គការ សុខភាព ពិភពលោក ក៏ បាន ដាស់តឿន កាលពី ថ្ងៃទី ១៤ ឧសភា ថា សូម្បីតែ អ្នក ដែល បាន ទទួល ថ្នាំ បង្ការ ក៏ គួរ បន្ត ពាក់ ម៉ាស់ មុខ នៅ កន្លែង ដែល មាន មេរោគ ឆ្លង ។
បុរស ជនជាតិ ចិន ៣នាក់ ត្រូវបាន ចាប់ខ្លួន ពី បទ ប្លន់ ប្រដាប់អាវុធ ហើយ បន្ទាប់មក បាន បាញ់ ទៅ លើ មន្ត្រី ប៉ូលីស ដែល កំពុង ស្វែងរក ពួកគេ ក្រោយមក ។ ពួកគេ ត្រូវបាន បញ្ជូន ទៅ សាលាដំបូង ខេត្ត ព្រះសីហនុ កាលពី ថ្ងៃទី ១៦ ខែឧសភា ។
ស្នងការ រង នគរបាល ខេត្ត លោក កុល ផល្លី បាន និយាយ នៅ ថ្ងៃទី ១៦ ខែឧសភា ថា ជន ទាំង ៣នាក់ នេះ ក្រៅពី ជាប់ពាក់ព័ន្ធ ក្នុង អំពើ ប្លន់ ក៏ ជាប់ពាក់ព័ន្ធ ប្រើប្រាស់ អាវុធ ខុស ច្បាប់ ហើយ ពួកគេ នឹង ត្រូវ ប្រឈមមុខ នឹង ច្បាប់ ។
លោក ផល្លី បាន ថ្លែង ថា៖ ជនសង្ស័យ ទាំង បី នាក់ នេះ បាន ប្លន់ ជនជាតិ ចិន ម្នាក់ ទៀត ។
លោក ផល្លី បាន និយាយ ថា សមត្ថកិច្ច បាន ទទួល សេចក្តីរាយការណ៍ ពី ប្រជាពលរដ្ឋ ថា មាន បុរស មួយ ក្រុម បាន ប្លន់ បុរស ម្នាក់ ទៀត ដោយ កាំភ្លើង ខ្លី ហើយ បាន បាញ់ មួយ គ្រាប់ នៅ ភូមិ ២ សង្កាត់ ៣ ក្នុង ក្រុង ព្រះសីហនុ ។
លោក បន្ត ថា នគរបាល សហការ ជាមួយ កម្លាំង អន្តរាគមន៍ ពិសេស និង ប៉ុស្តិ៍ នគរបាល សង្កាត់ លេខ ៣ បាន ចុះ ទៅដល់ កន្លែង កើត ហេតុ ប៉ុន្តែ ជនសង្ស័យ បាន រត់គេចខ្លួន បាត់ អស់ ហើយ ។
ប៉ូលិស បាន ចាប់ផ្តើម តាម រក ជនសង្ស័យ ហើយ ពេល ទៅដល់ ផ្លូវ តូច មួយ ក្នុង ភូមិ២ ក៏ បាន រកឃើញ ពួកគេ ។ នៅ ពេល នោះ បុរស ម្នាក់ បាន បាញ់ ទៅ លើ មន្ត្រី ចំនួន ពីរ ដង ប៉ុន្តែ មិន បាន សម្រេច ។
ជនសង្ស័យ បាន រត់ ទៅ ពួន នៅក្នុង ផ្ទះ គ្មាន មនុស្ស ។ ប៉ូលិស បាន ចាប់ខ្លួន រហូតដល់ ម៉ោង ៧ យប់ ថ្ងៃទី ១៤ ខែឧសភា ទើប ចាប់ខ្លួន អ្នក ទាំង បី ។ ប៉ូលិស បាន ឲ្យដឹង ថា នៅពេល ចាប់ខ្លួន ជា ចុងក្រោយ ពួកគេ ក៏ រឹបអូស បាន កាំភ្លើង ខ្លី K59 មួយ ដើម ដែល នៅ មាន ផ្ទុក ដោយ គ្រាប់ រំសេវ ចំនួន ៤ គ្រាប់ ។
ដើម្បី អបអរសាទរ ទិវា គ្រួសារ អន្តរជាតិ ថ្ងៃទី ១៥ ឧសភា លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន បាន អំពាវនាវ ដល់ ដៃគូ អភិវឌ្ឍន៍ ជាតិ និង អន្តរជាតិ និង វិស័យ ឯកជន បន្ត ជួយ គ្រួសារ នៅ កម្ពុជា ដើម្បី ជួយ លុបបំបាត់ ភាពក្រីក្រ ។
លោក បាន មានប្រសាសន៍ ថា គ្រប់ ភាគី ទាំង រដ្ឋាភិបាល និង វិស័យ ឯកជន គ្រប់ លំដាប់ថ្នាក់ ត្រូវ លើកកម្ពស់ សុខុមាលភាព គ្រួសារ និង បន្ត បង្កើន សកម្មភាព មនុស្សធម៌ ដែល ផ្តោត លើ គ្រួសារ របស់ ពួកគេ ។
ឆ្នាំ នេះ ទិវា គ្រួសារ អន្តរជាតិ ត្រូវបាន ប្រារព្ធ ឡើង នៅ ថ្ងៃទី ១៥ ខែឧសភា ក្រោម ប្រធានបទ សេវា សង្គម មាន តួនាទី សំខាន់ ក្នុង ការលើកកម្ពស់ តម្លៃ គ្រួសារ ។
លោក ហ៊ុន សែន មានប្រសាសន៍ ថា ការលើកកម្ពស់ វប្បធម៌ សន្តិភាព សាមគ្គីភាព សេវា សង្គម និង ភាពសុខដុមរមនា ក្នុង គ្រួសារ គឺ ដើម្បី ជួយ លុបបំបាត់ ភាពក្រីក្រ និង កម្ចាត់ ជំងឺ កូវីដ - ១៩ នៅ កម្ពុជា ។
សេវា សង្គម នៅ កម្ពុជា គឺជា កម្លាំង សេវា ស៊ីវិល ដែល បង្កើតឡើង ដោយ អ្នកជំនាញ លើ វិស័យ ដូចជា ការងារ សង្គម ការអប់រំ សុខភាព យុត្តិធម៌ សង្គម ការងារ និង ការរៀបចំ សហគមន៍ ដែល ជួយ ដល់ គ្រួសារ កម្ពុជា និង លើកកម្ពស់ ការអភិវឌ្ឍ សេដ្ឋកិច្ច សង្គម និង វប្បធម៌ របស់ ប្រទេសជាតិ ។
ក្នុង ប្រទេស ដែល រីកចម្រើន ប្រកបដោយ និរន្តរភាព គ្រួសារ នីមួយ ៗ ត្រូវ លើកកម្ពស់ ការអប់រំ .. . ដល់ សមាជិក ទាំងអស់ ដើម្បី បណ្តុះ ពួកគេ ឱ្យ មាន សុជីវធម៌ ... ពួកគេ ត្រូវ រស់ នៅក្នុង ជីវភាព សមរម្យ និង ថ្លៃថ្នូរ ហើយ ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការអភិវឌ្ឍន៍ សេដ្ឋកិច្ច សង្គម វប្បធម៌ ។ ស្ថិរភាព នយោបាយ និង ជួយ រក្សា តម្លៃ វប្បធម៌ ជាតិ និង ទំនៀមទម្លាប់ របស់ ខ្លួន ។
លោក ក៏ បាន ទទួលស្គាល់ ថា កាកបាទ ក្រហម កម្ពុជា បាន និង កំពុង ផ្តល់ ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ដល់ យុវជន យ៉ាង សកម្ម និង លើកកម្ពស់ សីលធម៌ សង្គម និង តម្លៃ ស្ត្រី ។
លោក ថា ការងារ របស់ កាកបាទ ក្រហម កម្ពុជា បាន ទប់ស្កាត់ អំពើហិង្សា ក្នុង គ្រួសារ និង ការជួញដូរ មនុស្ស និង បាន ជួយ សម្រាល ការលំបាក របស់ ជន ងាយ រងគ្រោះ នៅ ទូទាំង ប្រទេស ។
យើង បាន ឃើញ កម្មវិធី ជាច្រើន ដែល ធ្វើឡើង ដោយ អង្គការ សង្គម ស៊ីវិល អង្គការ សង្គម ស៊ីវិល បាន ដើរ តួនាទី ជាច្រើន ។ យើង បាន ធ្វើការ ដើម្បី លុបបំបាត់ អំពើហិង្សា ក្នុង គ្រួសារ និង ការរើសអើង ។ យើង ធ្វើ ការងារ នេះ ដោយ ឯករាជ្យ មិន គិត ពី គោល នយោបាយ របស់ រដ្ឋាភិបាល ឡើយ ។
លោកស្រី បាន ជំរុញ ឲ្យ រដ្ឋាភិបាល ប្ដេជ្ញា ខ្លួន ឯង ចំពោះ យុត្តិធម៌ សង្គម ជាពិសេស យុត្តិធម៌ សម្រាប់ ជន ក្រីក្រ ដែល រង ទុក្ខ នៅក្នុង កណ្តាប់ដៃ អ្នក មាន អំណាច ។
យោង តាម អគ្គ នាយកដ្ឋាន ការពារ អ្នកប្រើប្រាស់ ការប្រកួតប្រជែង និង បង្ក្រាប ការក្លែងបន្លំ (CCF) របស់ ក្រសួង ពាណិជ្ជកម្ម បាន ឱ្យដឹង ថា ទឹក អាល់កុល ក្លែងក្លាយជាង 40 តោន ត្រូវបាន រឹបអូស ទូទាំង ប្រទេស ចាប់តាំងពី ការផ្ទុះឡើង នៃ Covid-19 កាលពី ថ្ងៃទី 20 ខែកុម្ភៈ ។
នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន កាលពី ថ្ងៃទី ១៨ ខែឧសភា CCF បាន និយាយ ថា ចំពេល មាន ការរីករាលដាល នៃ ជំងឺ រាតត្បាត ទឹក អនាម័យ ក្លែងក្លាយ ត្រូវបាន លក់ តាម វិធី ជាច្រើន រួមទាំង នៅលើ ប្រព័ន្ធ ផ្សព្វផ្សាយ សង្គម ផងដែរ ។
មន្ត្រី CCF កាលពី ថ្ងៃទី ១៨ ខែឧសភា រឹបអូស បាន ថ្នាំ អាល់កុល ក្លែងក្លាយ ចំនួន ១៨៣ កំប៉ុង ជាង ៥០០០លីត្រ នៅ ភូមិ ប្រការ សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
លោក បន្ត ថា៖ ជា លទ្ធផល យើង បាន បិទ ទីតាំង នោះ ហើយ រឹបអូស បាន កំប៉ុង ដែល មាន ជាតិ អាល់កុល ក្លែងក្លាយ ឬ មេតាណុល ចំនួន ៥. ៤៩០ លីត្រ ។ យើង រឹបអូស បាន ផលិតផល និង កំពុង កសាង សំណុំរឿង តាម នីតិវិធី ច្បាប់ ។
ទឹក អនាម័យ ក្លែងក្លាយ ក៏ ត្រូវបាន រកឃើញ នៅ តាម ខេត្ត ផ្សេង ទៀត រួម មាន ខេត្ត ស្វាយរៀង បន្ទាយមានជ័យ និង ព្រះវិហារ ។ មន្ត្រី CCF និង អាជ្ញាធរ មូលដ្ឋាន ក្នុង ខេត្ត ទាំងនេះ បាន រឹបអូស និង បំផ្លាញ ចោល ចំនួន ៣៣០ លីត្រ កាលពី ថ្ងៃទី ១៨ ឧសភា ។
CCF បន្ថែម ថា មេតាណុល គឺជា សារធាតុ ពុល ។ ការប្រើ វា ជា ថ្នាំ សំលាប់ មេរោគ មិន ត្រឹមតែ សម្លាប់ មេរោគ ប៉ុណ្ណោះ ទេ ថែមទាំង ប៉ះពាល់ ដល់ សុខភាព មនុស្ស ដូចជា ស្បែក និង ភ្នែក ឈឺ ក្បាល និង បាត់បង់ ស្មារតី ។ វា ក៏ អាច បណ្តាលឲ្យ ស្លាប់ ផងដែរ ប្រសិនបើ លាយ ជាមួយនឹង អេតាណុល ។
ប្រជាពលរដ្ឋ ជាង ៤០ គ្រួសារ រស់ នៅ ភូមិ កំពង់តាឡុង ឃុំ បឹង ខ្យាង ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល បាន នាំគ្នា បោះ តង់ យាម ស្រែ និង បិទ ផ្លូវ ចូល ភូមិ ដើម្បី រារាំង ក្រុមហ៊ុន សាងសង់ មិន ឲ្យ ប្រើប្រាស់ គ្រឿងចក្រ ឈូសឆាយ ដី ស្រែ របស់ ពួកគាត់ សម្រាប់ ភ្នំ ថ្មី គម្រោង អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ។
អ្នក ទាំង ៤៨ គ្រួសារ អះអាង ថា ពួកគេ មិន ទាន់ បាន ទទួល សំណង សម្រាប់ ការបាត់បង់ ដី ស្រែ ចម្ការ របស់ ពួកគាត់ នៅឡើយ ទេ ។
លោក ឡុង សុភ័ក្រ្ត ប្រជាពលរដ្ឋ នៅ ភូមិ កំពង់តាឡុង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ កាលពី ថ្ងៃទី ១៨ ខែឧសភា ថា ក្រុមហ៊ុន សំណង់ ដែល ធ្វើការ នៅ អាកាសយានដ្ឋាន អន្តរជាតិ ភ្នំពេញ ថ្មី ថ្មី ៗ នេះ បាន ប្រើប្រាស់ គ្រឿងចក្រ ដើម្បី ឈូសឆាយ ដី ស្រែ ចម្ការ របស់ គាត់ និង អ្នកភូមិ ដទៃ ទៀត ។
លោក បាន បន្ត ថា៖ នៅ ថ្ងៃទី ១៤ ខែឧសភា ក្រុមហ៊ុន បាន ប្រើ គ្រឿងចក្រ ឈូសឆាយ ដី ស្រែ ចម្ការ របស់ ខ្ញុំ និង បង ប្រុស ខ្ញុំ សរុប ជាង ១.៥ ហិកតា ។
លោក ឃាង សុខ មាន អ្នកជិតខាង ឈ្មោះ សុភ័ក្រ បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា កាលពី ថ្ងៃទី ១៤ ឧសភា អ្នកភូមិ បាន ឡោមព័ទ្ធ ឈូសឆាយ របស់ ក្រុមហ៊ុន សំណង់ ហើយ ទាមទារ ឱ្យ តំណាង របស់ ខ្លួន ផ្តល់ សំណង ជូន អ្នកភូមិ ឱ្យ បាន ត្រឹមត្រូវ សម្រាប់ ដី និង ដំណាំ របស់ ពួកគេ ។
បន្ទាប់មក ពួកគេ បាន ឃាត់ខ្លួនអ្នកបើកបរ ដែល ក្រោយមក ត្រូវបាន សមត្ថកិច្ច មូលដ្ឋាន ឃុំ ខ្លួន រយៈពេល ខ្លី ។ ប៉ុន្តែ តំណាង ក្រុមហ៊ុន មិន បាន សម្រុះសម្រួល ដំណោះស្រាយ ណាមួយ ឡើយ ហើយ អ្នកបើកបរ ត្រូវបាន ដោះលែង វិញ ហើយ ។
លោក សុខ មាន ដែល អះអាង ថា ដី លំនៅដ្ឋាន និង ដី ស្រែ ចំការ របស់ គាត់ ទាំង ពីរ បាន រង ផល ប៉ះពាល់ ដោយសារ ការ សាងសង់ ផ្លូវ រត់ ដំបូង របស់ ព្រលានយន្តហោះ បាន និយាយ ថា ក្រុមហ៊ុន បាន រំលោភ លើ កិច្ចព្រមព្រៀង របស់ ខ្លួន ជាមួយ អ្នកភូមិ ម្តង ហើយ ម្តង ទៀត ។
លោក បន្ត ថា នេះ ជា លើក ទី៣ហើយ ដែល ក្រុមហ៊ុន បាន រំលោភ លើ កិច្ចព្រមព្រៀង ដែល ចែង ថា នឹង មិន មាន ការឈូសឆាយ ដី ស្រែ ចម្ការ ដោយ មិន ចរចា សំណង សមរម្យ ជាមួយ ម្ចាស់ ជាមុន សិន ។
លោក បាន ថ្លែង ថា៖ ឥឡូវនេះ អ្នកភូមិ យើង ចំនួន ៤៨ នាក់ បាន បោះ តង់ ការពារ ដី ស្រែ របស់ ពួកគេ ដើម្បី ការពារ ក្រុមហ៊ុន មិន ឲ្យ បញ្ជូន មនុស្ស និង គ្រឿងចក្រ ទៅ ឈូសឆាយ ម្តង ទៀត ។
លោក អ៊ុច សាវឿន អភិបាល ស្រុក កណ្តាល ស្ទឹង បាន ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ ថា បន្ទាប់ពី អ្នកភូមិ រៀបចំ បិទ ផ្លូវ រួច អភិបាល ខេត្ត គង់ សោភ័ណ្ឌ បាន ចេញ លិខិត អញ្ជើញ ប្រជាពលរដ្ឋ ចំនួន ១៣គ្រួសារ ដែល រងគ្រោះ ដីធ្លី ដោយសារ ការ សាងសង់ ផ្លូវ រត់ ទី១ ដើម្បី ពិភាក្សា អំពី សំណង ជូន ពួកគាត់ នៅ ថ្ងៃទី ១៨ ខែឧសភា ។
ទោះជា យ៉ាងណា លោក ថា អ្នកភូមិ មិន បាន ជួប លោក សោភ័ណ្ឌ ទេ ព្រោះ អ្នក ខ្លះ ចាស់ ពេក ធ្វើដំណើរ ផ្លូវ ឆ្ងាយ ។
លោក ថា សោភ័ណ្ឌ បាន អញ្ជើញ ពលរដ្ឋ តែ ១៣ គ្រួសារ ប៉ុណ្ណោះ ដែល ដីឡូតិ៍ បាន រង ផល ប៉ះពាល់ ពី ផ្លូវ រត់ ដំបូង របស់ ព្រលានយន្តហោះ ប៉ុន្តែ អ្នកភូមិ កំពង់តាឡុង ទាំងអស់ រងគ្រោះ ដោយសារ គម្រោង ទាំងមូល ហើយ សុំ ជួប គាត់ ដើម្បី ដោះស្រាយ បញ្ហា ដីធ្លី របស់ ពួកគេ និង ដូច្នេះ ពួកគេ បាន ស្នើសុំ ពន្យារ ពេល ។
លោក បាន មានប្រសាសន៍ ថា យើង មិន អាច បង្ខំ អ្នកភូមិ ឲ្យ រុះរើ តង់ ចេញ ពី ដី របស់ ខ្លួន បាន ទេ រហូតដល់ ការដោះស្រាយ សំណង ផល ប៉ះពាល់ ត្រូវបាន បញ្ចប់ ។
លោក សៅ វឿន បាន បន្ត ថា ចំនួន ដី ដែល រង ផល ប៉ះពាល់ ពី ការសាងសង់ ព្រលានយន្តហោះ សរុប មាន ជាង ២០០០ ឡូត៍ ប៉ុន្តែ មាន តែ ១០០០ ឡូត៍ ប៉ុណ្ណោះ ដែល ត្រូវបាន គេ មើល ថែរហូតមកដល់ ពេលនេះ ។
លោក ថា យន្តការ សំណង គោល នយោបាយ បង្កើតឡើង ដោយ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នឹង ផ្តល់ សំណង តាម ប្រភេទ និង ទំហំ ដី ។
ដី លំនៅឋាន ជាប់ ផ្លូវ តម្លៃ ៨ ដុល្លារ ក្នុង មួយ ម៉ែត្រ ការ៉េ ហើយ តម្លៃ ៥ ដុល្លារ ក្នុង មួយ ម៉ែត្រ ការ៉េ សម្រាប់ ដី ចម្ងាយ ១០០ ម៉ែត្រ ពី ផ្លូវ និង ៣ ដុល្លារ ក្នុង មួយ ម៉ែត្រ ការ៉េ សម្រាប់ ដី ស្រែ ក្បែរ បឹង ។
លោក សុខ មាន បាន និយាយ ថា ការកំណត់ តម្លៃ ដី របស់ ពួកគេ នៅ ត្រឹម ៨ ដុល្លារ សម្រាប់ ដី លំនៅដ្ឋាន ជាប់ ផ្លូវ និង ៥ ដុល្លារ សម្រាប់ ដី ស្រែ គឺ ទាប ពេក ហើយ មិន សមស្រប នឹង តម្លៃ ទីផ្សារ បច្ចុប្បន្ន ដែល គាត់ ថា បច្ចុប្បន្ន មាន ចន្លោះ ពី ៧៥ ទៅ ១៥០ ដុល្លារ ក្នុង មួយ ម៉ែត្រ ការ៉េ ។
យើង ទាំងអស់ គ្នា មាន ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី ជា ប្រព័ន្ធ ដូច្នេះ មិន គួរ កំណត់ ក្នុង តម្លៃ ថេរ ទាប បែប នេះ ទេ ។
លោក បាន បន្ត ថា៖ យើង ចង់បាន ការសម្រុះសម្រួល ជាមួយ ដំណោះស្រាយ សំណង សមរម្យ សម្រាប់ ដី របស់ យើង ក្នុង តម្លៃ ទីផ្សារ ដើម្បីឲ្យ យើង មាន លទ្ធភាព ទិញ ដី ឬ ផ្ទះ នៅជិត ព្រលានយន្តហោះ ថ្មី ព្រោះ យើង មិន ចង់ ចាកចេញ ។
លោក ម៉ី សារិទ្ធ តំណាង សាជីវកម្ម វិនិយោគ នៅ បរទេស កម្ពុជា (OCIC) ដែល មើល ការខុសត្រូវ លើ គម្រោង សាងសង់ ព្រលានយន្តហោះ បាន បដិសេធ មិន ធ្វើ អត្ថាធិប្បាយ ទេ នៅ ថ្ងៃទី ១៨ ខែឧសភា ។
លោកស្រី ឱ វណ្ណឌីន អ្នកនាំពាក្យ ក្រសួង និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ ទទួល ថ្នាំ បង្ការ បាន និយាយ ថា យុទ្ធនាការ ទ្រង់ទ្រាយ ធំ អាច ចាប់ផ្តើម នៅ ខែ ក្រោយ ។
លោកស្រី បាន មានប្រសាសន៍ ថា យើង រំពឹង ថា នៅក្នុង ខែមិថុនា យើង នឹង អាច ចាក់ វ៉ាក់សាំង គ្រប់ ខណ្ឌ ទាំងអស់ នៃ រាជធានី ភ្នំពេញ ហើយ យើង នឹង ពិចារណា និង សិក្សា លម្អិត អំពី លទ្ធភាព នៃ ការពង្រីក ទៅ ខេត្ត កណ្តាល ជាមួយនឹង វ៉ាក់សាំង ដែល យើង មាន នៅក្នុង ដៃ ។ ខណ្ឌ កេងកង និង ខណ្ឌ សែនសុខ ដែល បាន ចាប់ផ្តើម នៅ ថ្ងៃទី ១៨ ខែឧសភា ។
វ៉ាន់ ឌីន បន្ថែម ថា ការចាក់ វ៉ាក់សាំង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល គឺជា អាទិភាព ខ្ពស់ បំផុត របស់ លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ហើយ នឹង ក្លាយជា សមិទ្ធិផល ដ៏ អស្ចារ្យ នៅពេល បញ្ចប់ ។
អ្នកស្រី បន្ត ថា៖ នៅ ពេល ដែល ថ្នាំ បង្ការ ច្រើន ទៀត ត្រូវបាន បញ្ជូន មក កម្ពុជា យើង នឹង ជំរុញ វ៉ាក់សាំង ទាំងនោះ ចេញ ទៅ ប្រជាជន ខេត្ត ព្រះសីហនុ នៅ ពេល ដែល យើង បាន បញ្ចប់ ការចាក់ វ៉ាក់សាំង នៅ ខេត្ត កណ្តាល ។
មក ទល់នឹង ពេលនេះ កម្ពុជា គ្រោង នឹង ទទួល វ៉ាក់សាំង ជាង ប្រាំ លាន ដូស ទាំង ការបរិច្ចាគ និង តាមរយៈ ការបញ្ជាទិញ របស់ រដ្ឋាភិបាល ដោយ វ៉ាក់សាំង ភាគ ច្រើន ទាំង ពីរ ប្រភេទ គឺ មកពី ប្រទេស ចិន ។
ជាមួយគ្នា នេះ ក្រុមការងារ ចាក់ ថ្នាំ បង្ការ របស់ ក្រសួង ការពារ ជាតិ នៅ រាជធានី - ខេត្ត បាន បន្ត យុទ្ធនាការ របស់ ខ្លួន នៅ ទូទាំង ៨ខណ្ឌ រួម មាន កំបូល ដង្កោ ពោធិ៍សែនជ័យ មានជ័យ ទួលគោក ឫស្សីកែវ រួម ជាមួយនឹង ការបន្ថែម នា ពេល ថ្មី ៗ នេះ នៃ សង្កាត់ បឹងកេងកង និង ខណ្ឌ សែនសុខ ។
ហើយ ខណៈ ដែល តំបន់ ក្រហម ជាច្រើន ក្នុង រាជធានី ភ្នំពេញ នឹង ត្រូវកាត់បន្ថយ មក ត្រឹម កម្រិត ផ្ទះ ឬ អគារ នោះ អភិបាល ខេត្ត ឃួង ស្រេង បាន ថ្លែង ថា លោក មិន អាច បញ្ជាក់ ពី ការដក បម្រាម គោចរ ពី ម៉ោង ៨ យប់ ដល់ ម៉ោង ៣ ទៀប ភ្លឺ នោះ ទេ ។
ប្រទេស កម្ពុជា បាន មើលឃើញ ពី ការថយចុះ នៃ ករណី សកម្ម ថ្មី និង ការកើនឡើង គួរឱ្យ កត់សម្គាល់ ក្នុង ការ ជាសះស្បើយ ។ កាលពី ថ្ងៃទី ១៨ ខែឧសភា ក្រសួង សុខាភិបាល បាន រាយការណ៍ ថា មាន អ្នក ឆ្លង ចំនួន ៣៤៥ នាក់ ប៉ុណ្ណោះ និង ជាសះស្បើយ ឡើងវិញ ចំនួន ១. ៣៣៧ នាក់ ។
ដោយឡែក នៅ ថ្ងៃទី ១៨ ឧសភា ក្នុង ជំនួប និម្មិត ជាមួយ រដ្ឋមន្ត្រី សុខាភិបាល
កម្ពុជា កំពុង ដំណើរការបាន ល្អ ក្នុង ការដាក់ ឱ្យ ប្រើប្រាស់ វ៉ាក់សាំង Covid-19 ដល់ ក្រុម អាទិភាព - បុគ្គលិក ថែទាំ សុខភាព មនុស្ស ចាស់ និង អ្នក ផ្សេង ទៀត ដែល មាន លក្ខខណ្ឌ ដែល ធ្វើឱ្យ ពួកគេ ប្រឈម នឹង ការឈឺ ខ្លាំង ប៉ុន្តែ ដូច ប្រទេស ដទៃ ទៀត ដែរ វា កំពុង ជួបប្រទះ បញ្ហា ផ្គត់ផ្គង់ ។
គាត់ បាន និយាយ ថា " យើង ដឹង ថា មនុស្ស ធុញទ្រាន់ នឹង ជំងឺ រាតត្បាត ប៉ុន្តែ យើង ទាំងអស់ គ្នា យល់ស្រប ថា យើង ត្រូវតែ រក្សា វិធានការ សុខភាព សាធារណៈ និង អាកប្បកិរិយា ការពារ ដែល ការពារ និង បន្ថយ ការចម្លង នៃ វីរុស " ។
យើង សង្ឃឹម ចំពោះ រឿង ល្អ ហើយ យើង ត្រៀមខ្លួន សម្រាប់ អាក្រក់ ។ ខ្ញុំ សូម សរសើរ ដោយ ស្មោះ អស់ ពី ចិត្ត ចំពោះ រដ្ឋមន្ត្រី ក្រសួង សុខាភិបាល និង សហការី ក្នុង ក្រសួង សុខាភិបាល ចំពោះ ការដឹកនាំ របស់ ពួកគេ ។
លោក នាយក រដ្ឋមន្ត្រី ហ៊ុន សែន ណែនាំឲ្យ ក្រសួង រៀបចំ យុទ្ធនាការ ផ្សព្វផ្សាយ ទិវា ជាតិ នៃ ការអប់រំ បណ្តុះបណ្តាល បច្ចេកទេស និង វិជ្ជាជីវៈ (TVET) ដើម្បី លើកទឹកចិត្ត ប្រជាពលរដ្ឋ ឲ្យ អភិវឌ្ឍ ជំនាញ ដែល មាន ប្រាក់ ចំណូល ខ្ពស់ ។
រដ្ឋាភិបាល បាន កំណត់ យក ថ្ងៃទី ១៥ ខែមិថុនា ជា ថ្ងៃ TVET ដើម្បី លើកកម្ពស់ កម្លាំង ពលកម្ម ជំនាញ និង ប្រសិទ្ធភាព ដើម្បី បំពេញ តម្រូវការ អាជីវកម្ម និង ឧស្សាហកម្ម ទាំង ក្នុង និង ក្រៅ ប្រទេស ។
ក្នុង សារាចរ រំលឹក ទិវា ផ្សព្វផ្សាយ ថ្ងៃទី ១៨ ឧសភា លោក ហ៊ុន សែន ណែនាំឲ្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ផលិត វីដេអូ និង ឯកសារ រឹង និង សហការ ជាមួយ ក្រសួង ពាក់ព័ន្ធ អាជ្ញាធរ ថ្នាក់ ក្រោម ជាតិ និង ដៃគូ ផ្សេង ទៀត ដើម្បី ផ្សព្វផ្សាយ ព័ត៌មាន ទូទាំង ប្រទេស ។
សម្តេច នាយក រដ្ឋមន្ត្រី បាន ផ្តាំផ្ញើ ដល់ ក្រសួង ព័ត៌មាន ណែនាំ ដល់ ប្រព័ន្ធ ផ្សព្វផ្សាយ ក្នុង ការផ្សាយ សារ វីដេអូ និង ឯកសារ ផ្សេង ៗ ក្នុង ឱកាស បុណ្យ ជាតិ ។
សម្តេច ហ៊ុន សែន អំពាវនាវ ដល់ ភាគី ពាក់ព័ន្ធ ទាំងអស់ ចូលរួម ផ្សព្វផ្សាយ ជា ឱឡារិក ទិវា ជាតិ នេះ និង អបអរសាទរ ទូទាំង ប្រទេស ។
អ្នកនាំពាក្យ ក្រសួង ព័ត៌មាន លោក មាស សុភ័ណ្ឌ និង លោក ផុស សុវណ្ណ មិន អាច ទាក់ទង សុំ ការបំភ្លឺ បាន ទេ នៅ ថ្ងៃទី ១៨ ខែឧសភា ។
កាលពី ខែសីហា ឆ្នាំ 2020 ទីភ្នាក់ងារ ស្វីស សម្រាប់ ការអភិវឌ្ឍន៍ និង កិច្ចសហប្រតិបត្តិការ បាន ចុះ កិច្ចសន្យា ជាមួយ ក្រសួង ការងារ ដើម្បី គាំទ្រ គម្រោង បង្កើត ប្រព័ន្ធ រៀន ពី ចម្ងាយ ឬ ប្រព័ន្ធ បណ្តុះបណ្តាល តាម អ៊ីនធឺណិត សម្រាប់ TVET ដើម្បី ជួយ ដល់ យុវជន កម្ពុជា ក្នុង អំឡុង ពេល Covid-19 និង ទៅ អនាគត ។
ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន សម្រេច ដាក់ចេញ នូវ យន្តការ និង នីតិវិធី សម្រាប់ ការអនុវត្ត កម្មវិធី ផ្តល់ ជំនួយ សង្គម តាមរយៈ សាច់ប្រាក់ បន្ទាប់ពី ការបិទ ផ្ទះ សម្រាប់ គ្រួសារ ដែល មាន អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ - ១៩ និង អ្នក ផ្ទុក មេរោគ កូវីដ - ១៩ និង ការលំបាក ពាក់ព័ន្ធ ។
យោង តាម សេចក្តីសម្រេច ចុះហត្ថលេខា ដោយ រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ លោក អូន ព័ន្ធ មុនីរ័ត្ន និង ចេញ នៅ ថ្ងៃទី ១៧ ខែឧសភា ការផ្តល់ សាច់ប្រាក់ ដល់ បុគ្គល និង គ្រួសារ ដែល មាន ការលំបាក ផ្នែក ហិរញ្ញវត្ថុ ដោយសារ ជំងឺ កូវីដ - ១៩ នឹង ចាប់ផ្តើម ពី ដើម ខែមិថុនា នេះ តទៅ ។
សេចក្តីថ្លែងការណ៍ បាន បន្ថែម ថា ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ត្រូវ រៀបចំ សំណើ សម្រាប់ ការទូទាត់ ប្រាក់ បុរេប្រទាន ក្នុង រយៈពេល ពី 4 ទៅ 6 សប្តាហ៍ បន្ទាប់ពី កាលបរិច្ឆេទ នៃ ការផ្តល់ ប្រាក់ បុរេប្រទាន ។
កាលពី ថ្ងៃទី ១១ ខែឧសភា រដ្ឋាភិបាល បាន ចេញ សេចក្តីប្រកាស ស្តីពី ការអនុវត្ត កម្មវិធី ជំនួយ សង្គមជា សាច់ប្រាក់ ដោយ សន្យា ឧបត្ថម្ភ ជា សាច់ប្រាក់ ដល់ គ្រួសារ អ្នកស្លាប់ ដោយសារ ជំងឺ កូវីដ - ១៩ ចំនួន ៣០០.០០០ រៀល ( ៧៥ ដុល្លារ ) និង ប្រាក់ ឧបត្ថម្ភ ជា សាច់ប្រាក់ សម្រាប់ ថ្លៃ អគ្គិសនី និង ទឹក ស្អាត រយៈពេល ៥ ខែ ។
កម្មករ ដែល ឆ្លង កូវីដ - ១៩ នឹង ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ជា កញ្ចប់ ចំនួន ១៦ ម៉ឺន រៀល ក្នុង ម្នាក់ សម្រាប់ អ្នក រស់ នៅ ភ្នំពេញ តា ខ្មៅ ខេត្ត កណ្ដាល និង ខេត្ត ព្រះសីហនុ ។
អ្នកនាំពាក្យ ក្រសួង សង្គមកិច្ច លោក សំ ហេង បូរុស មានប្រសាសន៍ ថា ក្រុមការងារ កំពុង សម្របសម្រួល ជាមួយ អាជ្ញាធរ ឃុំ ដើម្បី ចង ក្រង ស្ថិតិ អំពី ចំនួន ប្រជាពលរដ្ឋ ដែល នឹង មាន សិទ្ធិ ទទួលបាន ជំនួយ ជា សាច់ប្រាក់ នៅ រាជធានី ភ្នំពេញ តា ខ្មៅ និង ខេត្ត ព្រះសីហនុ ។
នៅ ពេល នេះ យើង កំពុង អនុញ្ញាតឱ្យ អាជ្ញាធរ ឃុំ និង អ្នកស្ម័គ្រចិត្ត របស់ យើង ធ្វើ ការសម្ភាសន៍ តាម ផ្ទះ អំពី ស្ថានភាព រស់ នៅ និង បញ្ហា ប្រឈម របស់ ពួកគេ ។ ទោះបីជា យើង មិន ទាន់ មាន ទិន្នន័យ ចុងក្រោយ ក៏ដោយ ប៉ុន្តែ យើង អាច ប៉ាន់ប្រមាណ ថា នឹង មាន មនុស្ស មួយចំនួន ធំ ដែល នឹង ទទួលបាន អត្ថប្រយោជន៍ ។
លោក ប៉ុល ហំម អតីត អនុប្រធាន គណបក្ស សង្គ្រោះ ជាតិ ដែល ត្រូវ រំលាយ ដោយ តុលាការ កំពូល រួម ជាមួយ លោក ផាន់ ចាន់ សាក់ អតីត សមាជិក ជាន់ ខ្ពស់ គណបក្ស នេះ បាន សុំ ការអនុញ្ញាតឲ្យ ចូល ប្រឡូក ក្នុង ឆាក នយោបាយ វិញ នៅ មុន ការបោះឆ្នោត ឃុំ សង្កាត់ និង ទូទៅ ខាងមុខ ដោយ ការស្វែងរក លើក ក្រោយ នេះ ។ ចូលរួម ជាមួយ គណបក្ស កំណែទម្រង់ កម្ពុជា ដែល ទើប បង្កើត ថ្មី (CRP) ។
ទាំង លោក ហម និង លោក ចាន់ សាក់ ស្ថិត ក្នុង ចំណោម សមាជិក ទាំង ១១៨ របស់ គណបក្ស ដែល ត្រូវបាន ហាមឃាត់ មិន ឱ្យ ធ្វើ នយោបាយ រយៈពេល ៥ ឆ្នាំ នៅ ពេល ដែល គណបក្ស សង្គ្រោះ ជាតិ ត្រូវបាន រំលាយ កាលពី ខែវិច្ឆិកា ឆ្នាំ ២០១៧ ។
អ្នក ទាំង ពីរ បាន ដាក់ លិខិត ស្នើសុំ ស្តារ នីតិសម្បទា នយោបាយ ទៅ ក្រសួង មហាផ្ទៃ នៅ ថ្ងៃទី ១៧ ខែឧសភា ។
លោក ឈឹម កាន ប្រធាន នាយកដ្ឋាន សមាគម និង គណបក្ស នយោបាយ នៃ ក្រសួង មហាផ្ទៃ បាន បញ្ជាក់ ប្រាប់ ភ្នំពេញ ប៉ុស្តិ៍ នៅ ថ្ងៃទី ១៨ ខែឧសភា ថា ក្រសួង បាន ទទួល សំណើ ស្តារ នីតិសម្បទា និង កំពុង ពិនិត្យ មើល ឡើងវិញ មុននឹង សម្រេច ថា តើ ត្រូវ បញ្ជូន ពួកគេ ទៅ ព្រះមហាក្សត្រ ឬ យ៉ាងណា ។
លោក បាន ថ្លែង ថា៖ ប្រសិនបើ ពួកគេ មិន បាន ធ្វើ អ្វី ខុស ក្នុង អំឡុង ពេល ដែល ពួកគេ ត្រូវបាន រារាំង មិន ឱ្យ ធ្វើ នយោបាយ ហើយ មិន បំពាន នឹង ដីកា របស់ តុលាការ ទេ នោះ យើង នឹង ស្តារ ពួកគេ ឡើងវិញ ។
គិត ត្រឹម ថ្ងៃទី ១៨ ខែឧសភា សមាជិក អតីត គណបក្ស សង្គ្រោះ ជាតិ សរុប ចំនួន ២២រូប ត្រូវបាន ស្តារ នីតិសម្បទា ឡើងវិញ ។
លោក Chansak បាន និយាយ ថា CRP គឺជា បណ្តុំ នៃ អតីត មន្ត្រី គណបក្ស សង្គ្រោះ ជាតិ ដែល ឥឡូវនេះ ត្រូវបាន ស្តារ នីតិសម្បទា ហើយ វា នឹង ជា ជម្រើស ដែល មាន នៅលើ សន្លឹក ឆ្នោត របស់ មនុស្ស គ្រប់ គ្នា ជាមួយនឹង តារាង បេក្ខជន ពេញលេញ នៅក្នុង ការបោះឆ្នោត ឃុំ សង្កាត់ ឆ្នាំ 2022 ដែល ពួកគេ មាន បំណង ប្រកួតប្រជែង ជាមួយ គណបក្ស ប្រជាជន កម្ពុជា ដែល កំពុង កាន់អំណាច ។ ការិយាល័យ ទាំងអស់ ។
ស្ថាបនិក CRP លោក ចាន់ រ័ត្ន មានប្រសាសន៍ ថា មិន ចាំបាច់ ឲ្យ អតីត សមាជិក គណបក្ស សង្គ្រោះ ជាតិ ខ្ជះខ្ជាយ ពេលវេលា រង់ចាំ ដំណោះស្រាយ នយោបាយ ដែល សម្របសម្រួល ដោយ សហគមន៍ អន្តរជាតិ នោះ ទេ ចាប់តាំងពី គម្រោង ពាណិជ្ជកម្ម អ្វី ៗ លើកលែងតែ សព្វាវុធ ត្រូវបាន សហភាព អឺរ៉ុប ផ្អាក រួចហើយ ហើយ នៅតែ មិន មាន សញ្ញា នៃ ការចរចា រវាង គណបក្ស កាន់អំណាច និង អតីត បក្ស ប្រឆាំង ។
លោក ចាន់ រ័ត្ន បាន មានប្រសាសន៍ ថា ឥឡូវនេះ បើ មាន អ្វី មួយ សម្ពាធ ពី សហគមន៍ អន្តរជាតិ ពិតជា តិច ជាង កាលពី មុន ទៅ ទៀត ។
លោក ចាន់ រ័ត្ន មានប្រសាសន៍ ថា អ្នកនយោបាយ ទាំងនោះ មិន គួរ រង់ចាំ ទៀត ទេ ព្រោះ គ្មាន ផ្លូវ ចេញ ក្រៅពី ការស្វែងរក ការស្តារ នីតិសម្បទាន យោបាយ និង ចូលរួម ក្នុង ការបោះឆ្នោត នោះ ទេ ។
អ្នកវិភាគ នយោបាយ លោក ឯ ម សុវណ្ណារ៉ា មានប្រសាសន៍ ថា លោក ជឿជាក់ ថា លោក ហម នឹង ចូលរួម ជាមួយ គណបក្ស របស់ លោក ចាន់ រ័ត្ន ផងដែរ បើ ទោះជា លោក សង្ស័យ ថា គណបក្ស សង្រ្គោះ ជាតិ នឹង មាន ផល ប៉ះពាល់ ពិតប្រាកដ ដល់ ការបោះឆ្នោត ឬ ទទួលបាន ការគាំទ្រ ពី សាធារណជន ក៏ដោយ ។
លោក ថា អ្នកគាំទ្រ បក្ស ប្រឆាំង នឹង គាំទ្រ បាន លុះត្រាតែ សមាជិក គណបក្ស សង្គ្រោះ ជាតិ ទាំងអស់ ចូលរួម ជាមួយនឹង ការគាំទ្រ ពី អតីត មេដឹកនាំ របស់ ខ្លួន គឺ កឹម សុខា និង លោក សម រង្ស៊ី ។
ទាំង កឹម សុខា និង សម រង្ស៊ី មិន គាំទ្រ ការស្តារ នីតិសម្បទាន យោបាយ ទេ ។ សម្រាប់ លោក កឹម សុខា ទោះបី សវនាការ របស់ លោក កំពុង រង់ចាំ ក៏ដោយ ក៏ លោក មិន ទាន់ ស្វែងរក ការស្តារ នីតិសម្បទា ដែរ ។ ប្រការ នេះ បាន ធ្វើឲ្យ អ្នកគាំទ្រ គណបក្ស សង្គ្រោះ ជាតិ មួយចំនួន ស្ទាក់ស្ទើរ ក្នុង ការគាំទ្រ CRP ។
អាជ្ញាធរ ជាតិ អប្សរា (ANA) គ្រោង នឹង ដោះលែង សត្វ ស្លាប ចំនួន ១១ ក្បាល ពី ប្រភេទ សត្វ កម្រ ចំនួន ៣ ចូល ទៅក្នុង ព្រៃ ឧទ្យាន អង្គរ និង អំពាវនាវ ដល់ សាធារណជន ចូលរួម ថែរក្សា សត្វ ទាំងអស់ នៅក្នុង ឧទ្យាន នេះ ។
សត្វ ស្លាប ដែល នឹង ត្រូវ បញ្ចេញ ក្នុង ឧទ្យាន នោះ រួម មាន សត្វ ក្ងោក ចំនួន ៥ ក្បាល ស្នែង ធំ ៣ ក្បាល និង ស្នែង កម្រ ៣ ក្បាល ដែល បាន បរិច្ចាគ ពី អង្គការ អភិរក្ស សត្វ ព្រៃ និង សហគមន៍ មូលដ្ឋាន ។
ANA បាន បញ្ជាក់ ថា នា ពេល កន្លងមក គម្រោង នេះ ទទួលបាន ជោគជ័យ ក្នុង ការដោះលែង សត្វ ព្រៃ ជា ច្រើន ប្រភេទ ចូល ទៅក្នុង ឧទ្យាន ក្នុង នោះ មាន កូនក្រញូង ចំនួន ១១ក្បាល ដែល បាន សម្រាល បាន កូន ចំនួន ៤នាក់ សត្វ កណ្តៀរ ធម្មតា ចំនួន ៥ ក្បាល សត្វ កណ្ដៀរ រលោង ចំនួន ៤ ក្បាល ក្នុង ចំណោម សត្វ ដទៃ ទៀត ។
សេចក្តីប្រកាស ព័ត៌មាន បាន និយាយ ថា ទេសភាព អង្គរ ដើម បាន បាត់ ពី ពិភពលោក ហើយ ការរកឃើញ ឡើងវិញ នៃ ទីតាំង នេះ បាន នាំ ទៅដល់ ការទទួលស្គាល់ ជា សកល នៃ អង្គរ ថា ជា មជ្ឈមណ្ឌល បេតិកភណ្ឌ វប្បធម៌ របស់ កម្ពុជា ។
