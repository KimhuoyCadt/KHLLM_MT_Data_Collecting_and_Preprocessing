( ភ្នំពេញ ) ៖ អ្នក ជិះ បញ្ច្រាស នៅ រង្វង់ មូល វិមាន ឯករាជ្យ នៅតែ បន្ត កើតមាន ស្ទើរ ជារៀងរាល់ ថ្ងៃ បើ ទោះបីជា សមត្ថកិច្ច និង អាជ្ញាធរ ដាក់ កម្លាំង ប្រចាំ ការស្ទាក់ ចាប់ ទាំង យប់ ទាំង ថ្ងៃ ក្តី ជាក់ស្តែង នៅ យប់ មិញ ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ សមត្ថកិច្ច អនុវត្តន៍ ច្បាប់ និង អាជ្ញាធរ បាន ឃាត់ បាន យានយន្ត ចំនួន១ គ្រឿង បញ្ជូន ទៅ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ។
របាយការណ៍ របស់ អាជ្ញាធរ ខណ្ឌ ដូនពេញ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ ចាប់ពី ម៉ោង ០៧៖០០ នាទី ព្រឹក ដល់ ម៉ោង ១០៖០០ នាទី យប់ កម្លាំង គណៈ បញ្ជាការ ឯកភាព ខណ្ឌ ដូនពេញ សហការ ជាមួយ ការិយាល័យ ចរាចរណ៍ ជើង គោក នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ អនុវត្ត យុទ្ធនាការ ឃាត់ ម៉ូតូ និង រថយន្ត បើក បញ្ច្រាស ទិសដៅ ចរាចរណ៍ នៅ រង្វង់ មូល ជុំវិញ វិមាន ឯករាជ្យ និង ផ្លូវ ព្រះសុរា ម្រឹត ស្ថិត ក្នុង សង្កាត់ ចតុមុខ ខណ្ឌ ដូនពេញ ឃាត់ យានយន្ត សរុប ចំនួន១ គ្រឿង ក្នុង នោះ រួម មាន៖ ម៉ូតូ ១ គ្រឿង ។
( ភ្នំពេញ ) ៖ « អ្នកណា អើយ ! ម្តេច អ្នករុក គួន យាយី ប្រជាជាតិ យើង មិន ឈប់ឈរ យ៉ាង នេះ ? តើ អ្នក មាន សីលធម៌ ទេ ? » ។ នេះ គឺជា ចំណងជើង នៃ ខ្សែ វីដេអូ ឯកសារ ពិត មួយ បង្ហាញ ពី ប្រវត្តិសាស្ត្រ ឈឺចាប់ របស់ ប្រជាជន កម្ពុជា ដោយសារ ការជ្រៀត ជ្រែក របស់ បរទេស អំពើ ក្បត់ ជាតិ របស់ អ្នកនយោបាយ សម័យ ចាស់ និង ថ្មី ដែល នាំឲ្យ កើតមាន រដ្ឋប្រហារ សង្គ្រាម ស៊ីវិល អំពើ ប្រល័យ ពូជសាសន៍ និង ការសម្លាប់ រង្គាល នៅ កម្ពុជា កាលពី ជាង ៤០ ឆ្នាំ ។
ជា អកុសល អ្នកនយោបាយ ប្រឆាំង ផ្កាប់ មុខ សម័យ ថ្មី នេះ ហាក់ នៅ វង្វេង មនសិកា ជាតិ នៅឡើយ ដែល នេះ ជា គ្រោះថ្នាក់ ធំ បំផុត របស់ ប្រទេសជាតិ ។ ប៉ុន្តែ ទោះបីជា យ៉ាងណា ប្រជាជន កម្ពុជា ប្តេជ្ញា មិន អនុញ្ញាតឲ្យ ប្រវត្តិសាស្ត្រ ជូរចត់ នេះ កើតមាន សារជាថ្មី នៅ កម្ពុជា ទោះបី តាម រូបភាព ណា ក៏ដោយ ។
បច្ចុប្បន្ន ក្រោម ការដឹកនាំ ដោយ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី កម្ពុជា ពោរពេញ ដោយ សុខ សន្តិភាព ស្ថេរភាព និង ការអភិវឌ្ឍន៍ ឥត ឈប់ឈរ ។ ជាមួយនឹង ការរីកចម្រើន លើ គ្រប់ វិស័យ និង មាន ការឯកភាព ទឹកដី កម្ពុជា ក៏ ត្រូវ ខិតខំ ពង្រឹង ការឯកភាព ខាង ទស្សនៈ ដើម្បី រួមគ្នា ថែរក្សា ការពារ ភាព សុខសាន្ត របស់ ប្រទេសជាតិ ដោយ ឈរ លើ ស្មារតី ផលប្រយោជន៍ កម្ពុជា ជា ធំ ដើម្បី អនាគត កូន ចៅ អ្នកជំនាន់ ក្រោយ តទៅ រាប់ ជំនាន់ ។
ព្រឹក ថ្ងៃ នេះ គណៈ រដ្ឋមន្រ្តី បើក កិច្ចប្រជុំ ពេញ អង្គ ដើម្បី ពិភាក្សា លើ របៀបវារៈ មួយចំនួន ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន
( ភ្នំពេញ )៖ គណៈ រដ្ឋមន្រ្តី កម្ពុជា បើក កិច្ចប្រជុំ ពេញ អង្គ នៅ ថ្ងៃពុធ ទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ដើម្បី ពិភាក្សា និង ឆ្លង របៀបវារៈ មួយចំនួន ។ កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដោយ មាន ការចូលរួម ដោយ សមាជិក នានា របស់ រាជ រដ្ឋាភិបាល ។
លោក ផៃ ស៊ីផាន អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ឱ្យដឹង ថា កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី នៅ ថ្ងៃពុធ សប្តាហ៍ នេះ មាន របៀបវារៈ ដូចត ទៅ៖
អ្នកនាំពាក្យ ក្រសួង ការបរទេស កម្ពុជា ក៏ បាន រលឹក ទៀត ថា « ការបរាជ័យ ក្នុង ការប៉ុនប៉ង ជំរុញ ឱ្យ មាន ការផ្លាស់ប្តូរ របប តាមរយៈ មធ្យោបាយ មិន មែន ប្រជាធិបតេយ្យ មិន មែន ជា ការអនុវត្ត សិទ្ធិ មនុស្ស ជា មូលដ្ឋាន និង លទ្ធិ ប្រជាធិបតេយ្យ នោះ ទេ ។ រាជ រដ្ឋាភិបាល កម្ពុជា មាន សិទ្ធិ អធិបតេយ្យ ពេញលេញ ក្នុង ការចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ចាំបាច់ ចំពោះ បុគ្គល និង អង្គភាព ទាំងឡាយ ណា ដែល រំលោភ រដ្ឋធម្មនុញ កម្ពុជា និង ច្បាប់ ជាធរមាន ផ្សេង ទៀត សំដៅ ការពារ សន្តិសុខ ជាតិ និង នីតិរដ្ឋ របស់ ខ្លួន » ។
ជាមួយគ្នា នេះ កម្ពុជា បាន ទាមទារ ឱ្យ អ្នកនយោបាយ និង រដ្ឋ ការ បរទេស ទាំងអស់ ប្រកាន់ ឲ្យបាន ខ្ជាប់ខ្ជួន នូវ គោលការណ៍ ប្រព័ន្ធ ពហុ ភាគី និយម និង បទដ្ឋាន មូលដ្ឋាន ណែ ទំនាក់ទំនង អន្តរជាតិ ដូច ដែល មាន ចែង នៅក្នុង ធម្មនុញ្ញ អង្គការ សហ ប្រជាជាតិ គោរព អធិបតេយ្យភាព កម្ពុជា និង ចៀសវាង ពី ការជ្រៀត ជ្រែក ចូល កិច្ចការ ផ្ទៃក្នុង កម្ពុជា ដោយ យក លេស បញ្ហា សិទ្ធិ មនុស្ស និង លទ្ធិ ប្រជាធិបតេយ្យ ៕
ដំណើរ ឆ្ពោះទៅ ក្រេប ជញ្ជក់ ចំណេះដឹង ផ្នែក វិស័យ បាល់ទាត់ នៅ ប្រទេស ជប៉ុន នេះ ក្រោយពេល សៀង ចន្ធា បង្ហាញ ខ្លួន លើ ទីលាន ជាង ៥០នាទី ក្នុង ការប្រកួត ដ៏ តានតឹង ដែល ក្រុម ជម្រើសជាតិ កម្ពុជា បាន រង បរាជ័យ ក្រោម ថ្វី ជើង ក្រុម ជម្រើសជាតិ បារ៉ែ ន ដោយ លទ្ធផល ១- ០ នា ព្រលប់ ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ នៅលើ ទីលាន ពហុកីឡដ្ឋាន ជាតិ ។
( កណ្ដាល ) ៖ នៅ ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ គណៈប្រតិភូ ខេត្ត កណ្ដាល ជាច្រើន នាក់ ដឹកនាំ ដោយ លោក ម៉ៅ ភិរុណ អភិបាល នៃ គណៈអភិបាល ខេត្ត កណ្ដាល និង ឧត្តមសេនីយ៍ ទោ អ៊ាវ ចំរើន ស្នងការ នគរបាល ខេត្ត កណ្ដាល ព្រមទាំង មន្ត្រី អ្នកមុខអ្នក ការ ជាច្រើន នាក់ ផ្សេង ទៀត ទៅ ខេត្ត អាន យ៉ាន ប្រទេស វៀតណាម ដើម្បី បើក ការប្រជុំ ប្ដូរ វេន បូកសរុប ការងារ ៦ខែ ដើម ឆ្នាំ ២០១៩ ដែល ប្រព្រឹត្តិ ទៅ ចំនួន ២ ថ្ងៃ គឺ ថ្ងៃទី១០ - ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ ។
