( ភ្នំពេញ ) ៖ ក្រុម ជនសង្ស័យ ជនជាតិ ចិន មួយ ក្រុម បាន វាយដំ បុរស ជនជាតិ ម្នាក់ បណ្តាលឲ្យ រងរបួស ធ្ងន់ បាក់ ក្តោង ច្រមុះ និង ប៉ោង ភ្នែក ឆ្វេង រួច ចាប់ រុញ បញ្ចូល ក្នុង រថយន្ត តែ ត្រូវបាន កម្លាំង នគរបាល នៃ អធិការដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ តាម បង្ក្រាប បាន ។
លោក យឹម សារ៉ាន់ អធិការ នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News នៅ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ថា ហេតុការណ៍ ខាង លើ បាន កើតឡើង កាល វេលា ម៉ោង ១៥៖០០ ថ្ងៃទី ១០ ខែកញ្ញា ២០១៩ ម្សិលមិញ ចំណុច មុខ ផ្ទះសំណាក់ ដំរី ធំ ស្ថិត ភូមិ ក្បាល ដំរី ២ សង្កាត់ កាកាប២ ខណ្ឌ ពោធិ៍សែនជ័យ រាជធានី ភ្នំពេញ ។
បច្ចុប្បន្ន ជនសង្ស័យ បាន បញ្ចូន ទៅ កាន់ ផ្នែក ជំនាញ នៃ អធិការដ្ឋាន នគរបាល ខណ្ឌ ពោធិ៍សែនជ័យ ដើម្បី សួរនាំ និង ឃុំ ខ្លួន ជា បណ្តោះអាសន្ន បន្ត តាម និតិវិធី ៕ ពិធី ដាំ ដើមឈើ ជិត ១ពាន់ ដើម នៅ ខេត្ត កែប និង ខេត្ត កំពត របស់ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា
លោក សាស្រ្តាចារ្យ ងួន ស្តេច ភក្តី បាន បន្ត ថា នេះ ចាត់ទុក ជា ពេល លើក ទី១ ហើយ របស់ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា ដែល ជា ថ្នាល បណ្តុះបណ្តាល សាធារណៈ របស់ រដ្ឋ បាន និង កំពុងតែងតែង ចូលរួមចំណែក ក្នុង ការដំា ដើមឈើ ដែល ជា ទិសដៅ ដ៏ សំខាន់ ក្នុង ការពង្រឹង ទំាង ចំណេះ ជំនាញ និង បទពិសោធន៍ ជាក់ស្តែង ប្រគេន ជូន ដល់ សមណ និស្សិត និស្សិត ដើម្បីឲ្យ ពួកគេ ចូលរួម ថែរក្សា បរិស្ថាន របស់ ជាតិ ក្រោម ទិស ស្លោក ដំា ដើមឈើ ចេញពី យើង ដើម្បី ដើមឈើ កុំ មើល បំណំា ត្រូវតែ ដំា បង្ហាញ ។
លោក ភូ លិ អភិបាល រង នៃ គណៈអភិបាល ខេត្ត កំពត បាន សម្តែង នូវ ការគាំទ្រ និង លើក ទិកចិត្ត ចំពោះ ស្មារតី របស់ ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហមុនី រាជា ដែល បាន បង្កើត កម្មវិធី ដាំ ដើមឈើ នេះ ឡើង ដែល ជា គំរូរ មួយ ដ៏ ល្អ របស់ សង្គមជាតិ ក្នុង ការចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី ថែរក្សា ការពារ បរិស្ថាន និង បង្កើត ភាព បៃតង នៅ ជំវិញ ខ្លួន ។
លោក បាន បន្ត ថា « យុវជន យើង ទាំងអស់ គឺជា ទំពាំង ស្នង ប្ញស្សី សម្រាប់ បន្ត រវេន ពី ជំនាន់ មុន ក្នុង ការចូលរួម អភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន ជាពិសេស នោះ ការស្រលាញ់ ការពារ ធម្មជាតិ នឹង បរិស្ថាន គឺជា កាត្វកិច្ច មួយ របស់ យុវជន យើង ដែល មិន អាច ខ្វះ បាន តាម រយ : សកម្មភាព ផ្សេង ៗ ដូចជា រុក្ខ ទិវា ក្នុង ថ្ងៃ នេះ ជាដើម បាន បង្ហាញ ឲ្យ ឃើញ យ៉ាង ច្បាស់ ថា យុវជន កម្ពុជា មាន សាមគ្គីភាព នឹង ធ្វើ បាន គ្រប់ យ៉ាង ដើម្បី ជា ប្រយោជន៍ ជាតិ » ។
( ភ្នំពេញ ) ៖ វិទ្យាស្ថាន អន្តរជាតិ « អាយ ឃី » ប្រកាស ផ្តល់ អាហារូបករណ៍ ពេញ ថ្លៃ ១០០ ភាគរយ ចំនួន ៤០០ កន្លែង ដល់ សិស្សានុសិស្ស ដែល ទើប ប្រលង ជា ប់ បាក់ឌុប សម្រាប់ ឆ្នាំ សិក្សា ២០១៩ - ២០២០ ដើម្បី រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង វិស័យ អប់រំ នៅ កម្ពុជា ឱ្យ កាន់តែ មាន ប្រសិទ្ធិភាព ខ្ពស់ ជាពិសេស ប្អូន ៗ ដែល អញ្ជើញ មកពី បណ្តា ខេត្ត នានា ។
អាហារូបករណ៍ ដែល វិទ្យាស្ថាន ប្រកាស ផ្តល់ ជូន លើ ជំនាញ គ្រប់គ្រង ពាណិជ្ជកម្ម និង ជំនាញ អក្សរសាស្រ្ត អង់គ្លេស ។
មន្រ្តី ក្រសួង សង្គមកិច្ច៖ ការស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ ជូន ជន ពិការ ជា យុទ្ធសាស្រ្ត សម្រាប់ កាត់បន្ថយ ភាពក្រីក្រ និង ការដាក់បញ្ចូល ជន ពិការ ទៅក្នុង សង្គម
( ពោធិ៍សាត់ )៖ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ទទួលស្គាល់ ថា ការស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ ជូន ជន ពិការ គឺជា យុទ្ធសាស្ត្រ មួយ សម្រាប់ ការស្តារ លទ្ធភាព ពលកម្ម ការផ្តល់ ឱកាស ស្មើភាព គ្នា ការកាត់បន្ថយ ភាពក្រីក្រ និង ការដាក់បញ្ចូល ជន ពិការ ទៅក្នុង សង្គម ។ ការងារ នេះ បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជំរុញ ឲ្យ ជន ពិការ ទទួលបាន នូវ សេវាកម្ម នានា របស់ សង្គម និង សិទ្ធិ យ៉ាង ពេញលេញ ក្នុង ការចូលរួម សកម្មភាព សង្គម ។
គោលការណ៍ រួម នៃ ការងារ ស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ គឺ ការធ្វើ បរិយា បន្ន ការចូលរួម និរន្តរភាព ការផ្តល់ សិទ្ធិ អំណាច ការតស៊ូ មតិ ដោយ ខ្លួន ឯង និង បរិយាកាស ដែល គ្មាន ឧបសគ្គ សម្រាប់ ជន ពិការ ហើយ វា ជា សក្តានុពល មួយ ក្នុង ការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ជន ពិការ ការផ្លាស់ប្តូរ ឥរិយាបទ សង្គម មក លើ ជន ពិការ ផងដែរ ។
នេះ ជា ការលើកឡើង របស់ លោក ញ៉ឹក វណ្ណារ៉ា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតី យុទ្ធជន និង យុវនីតិសម្បទា និង ជា តំណាង របស់ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នៅក្នុង សិក្ខាសាលា ផ្លាស់ប្តូរ បទពិសោធន៍ លើ គម្រោង កម្មវិធី អភិវឌ្ឍន៍ សហគមន៍ ប្រកបដោយ បរិយា បន្ន រៀបចំ ធ្វើ នៅ ខេត្ត ពោធិ៍សាត់ រយៈពេល ២ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១១ - ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ ។
សិក្ខាសាលា នេះ ក៏ មាន ការចូលរួម ពី លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ប្រចាំ ខេត្ត ពោធិ៍សាត់ និង អង្គការ ដៃគូ ជាតិ និង អន្តរជាតិ ជាច្រើន ស្ថាប័ន ទៀត ។
លោក ញ៉ឹក វណ្ណារ៉ា បាន បន្ថែម ឲ្យដឹង ថា សិក្ខាសាលា នេះ ធ្វើឡើង ក្នុង គោលបំណង ប្រមូល ចង ក្រង ឯកសារ ពាក់ព័ន្ធ កម្មវិធី អភិវឌ្ឍន៍ សហគមន៍ ប្រកបដោយ បរិយា បន្ន វិញ ដែល ពីមុន កម្មវិធី ស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ ប៉ុន្តែ បច្ចុប្បន្ន ត្រូវបាន ផ្លាស់ប្តូរ មក ជា កម្មវិធី អភិវឌ្ឍន៍ សហគមន៍ ប្រកបដោយ បរិយា បន្ន ហើយ កម្ពុជា គ្រោង ធ្វើជា ម្ចាស់ ផ្ទះ នៅ ឆ្នាំ ២០២៣ ។
លោក បន្ត ថា ដូច្នេះ ដើម្បី អនុវត្ត ការងារ នេះ ឲ្យ ទទួលបាន ជោគជ័យ និង មាន ប្រសិទ្ធភាព អ្នក ដែល ដើរ តួនាទី ដ៏ សំខាន់ ក្នុង កិច្ចការ នេះ គឺ៖
១៖ សម្រាប់ ថ្នាក់ ជាតិ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ ដើរ តួនាទី ជា អ្នកគ្រប់គ្រង សម្របសម្រួល និង ធ្វើ ផែនការ ផ្តល់ ការកសាង សមត្ថភាព ត្រួតពិនិត្យ និង វាយតម្លៃ លើ កម្មវិធី ស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ ។ កិច្ចសហប្រតិ បត្តិការ រវាង ក្រសួង ស្ថាប័ន និង អង្គការ មិន មែន រដ្ឋាភិបាល ពាក់ព័ន្ធ គួរ ត្រូវបាន ពង្រឹង ឲ្យបាន ជិតស្និទ្ធិ ។
២៖ សម្រាប់ ថ្នាក់ រាជធានី ខេត្ត មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង មន្ទីរ វិស័យ ដទៃ ទៀត គឺ មាន តួនាទី ត្រួតពិនិត្យ សកម្មភាព និង ផ្តល់ របាយការណ៍ ជូន ថ្នាក់ ជាតិ អំពី វឌ្ឍនៈភាព នៃ ការងារ ស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ ។
៣៖ សម្រាប់ ថ្នាក់ មូលដ្ឋាន ការិយាល័យ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា ក្រុមប្រឹក្សា ឃុំ បុគ្គលិក អង្គការ មិន មែន រដ្ឋាភិបាល មេភូមិ ជន ពិការ គ្រួសារ និង សហគមន៍ របស់ ពួកគេ គួរ ធ្វើ ការរួមគ្នា ដើម្បី អនុវត្ត និង គាំទ្រ សកម្មភាព ការងារ ស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ ឲ្យ មាន ប្រសិទ្ធភាព ។ -
លោក ញ៉ឹក វណ្ណារ៉ា បាន បញ្ជាក់ ថា សិក្ខាសាលា នេះ ពិត មែន តែ មាន រយៈពេល ខ្លី តែ វា មាន សារៈសំខាន់ ណាស់ សម្រាប់ ការងារ គ្រប់គ្រង ការងារ សម្របសម្រួល និង ការអនុវត្ត ទាំង កម្រិត ជាតិ រាជធានី ខេត្ត និង មូលដ្ឋាន សំដៅ ពង្រឹង គុណភាព និង ប្រសិទ្ធភាព ក្នុង ការផ្តល់ សេវា ស្តារ លទ្ធភាព ពលកម្ម នៅ សហគមន៍ ជូន ជន ពិការ ។
លោក រំពឹង ថា តាមរយៈ ការបង្ហាញ នូវ លទ្ធផល និង ចំណុច ខ្លាំង ចំណុច គួរ កែលម្អ រ ការចែករំលែក នូវ បទពិសោធ ល្អ ពី គ្នា ទៅ វិញ ទៅមក និង ការពិភាក្សា របស់ អង្គ សិក្ខាសាលា យើង នឹង ទទួលបាន នូវ លទ្ធផល ផ្លែ ផ្កា និង អនុសាសន៍ ល្អ ៗ ដើម្បី ជា ត្រី វិស័យ សម្រាប់ ការ រៀបចំ ផែនការ សកម្មភាព អនុវត្ត បន្ត នា ឆ្នាំ ខាងមុខ ៕
នា ឱកាស នោះ លោក ជា ម ច័ន្ទ សោភ័ណ បាន អំពាវនាវ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ត្រូវ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ត្រូវ ថែរក្សា សុខភាព របស់ ខ្លួន ឲ្យ ចៀស ផុត ពី ជំងឺ ផ្សេង ៗ ដែល បណ្តាល មកពី ការ ខ្វះ អនាម័យ ជាពិសេស ត្រូវ ប្រយ័ត្ន ក្មេង តូច ៗ និង មនុស្ស ចាស់ ដែល គ្រោះថ្នាក់ ដោយសារ លង់ទឹក ។
មួយវិញទៀត ត្រូវ ប្រុងប្រយ័ត្ន ចំពោះ សត្វ អសិរពិស បើសិន មាន តិច ឬ ខាំ ត្រូវ បញ្ជូន ទៅ មណ្ឌល សុខភាព ឬ ក្រុម គ្រូពេទ្យ នៅជិត បំផុត ដោយ រដ្ឋបាល ខេត្ត បាន រៀបចំ នៅ តាម ទីតាំង ទី ទួល សុវត្ថិភាព ពេញ ២៤ ម៉ោង ។ លោក អភិបាល ខេត្ត បាន ផ្តាំផ្ញើ ដល់ អាជា្ញធរ ស្រុក ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ទៅ លើ សុខ ទុក្ខ របស់ បងប្អូន ប្រជាពលរដ្ឋ ។
បើ តាម លោក សយ ទូច និង លោក រស់ សុខ ន នាយក សាខា កាកបាទ ក្រហម ខេត្ត បាន ឲ្យដឹង ថា គ្រួសារ រង ផល ប៉ះពាល់ ចំនួន ៣០០ គ្រួសារ ក្នុង ១គ្រួសារ ៗ ទទួលបាន គ្រឿង ឧបភោគ បរិភោគ និង ថវិការ ២មុឺន រៀល ។ ក្នុង នាម គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ស្រុក លោក សយ ទូច បាន ត្រៀម កម្លាំង ពេញ ២៤ ម៉ោង ដើម្បី សង្គ្រោះ ប្រជាពលរដ្ឋ ឲ្យបាន ទាន់ ពេល វេលា ។
( បន្ទាយមានជ័យ )៖ លោក សាន វិជ្ជា សារ៉ា វុធ ប្រធាន សាខា កាំ កុងត្រូល សាខា ខេត្ត នា ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន សហការ ជាមួយ ក្រុមការងារ រថយន្ត មន្ទីរពិសោធន៍ ចល័ត កាំ កុងត្រូល និង ចូលរួម មន្ត្រី ពាណិជ្ជកម្ម ខេត្ត ចុះ ពិនិត្យ និង ស្វែងរក មុខ ម្ហូប ទំនិញ ណា ដែរ បង្កឲ្យ ប៉ះពាល់ ដល់ សុខភាព របស់ ប្រជាពលរដ្ឋ គ្រប់ រូប នៅក្នុង តាម ផ្សារ ត្រី ផ្សារ អគ្គៈ ថ្មី ក្រុង ប៉ោយប៉ែត ។
លោក បន្ត ថា ព្រឹក នេះ លោក បាន ប្រទះ ឃើញ មាន លត និង បាញ់ ដុប ដាក់ លក់ នៅលើ ទីផ្សារ ក្នុង ផ្សារ ត្រី ក្រុង ប៉ោយប៉ែត មាន ផ្ទុក សារធាតុ គីមី បរ៉ាក់ ( ទឹក អន្សា ) ដែល បង្កឲ្យ ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ នា ពេល អនាគត ទោះបីជា វា មិន បង្កឲ្យ ប៉ះពាល់ សុខភាព ភ្លាម ៗ ក៏ដោយ ។ ក្នុង នោះ បាន រកឃើញ មាន បន្លែ ខាត់ ណា នាំយក ពី ប្រទេស ថៃ មាន ផ្ទុក សារធាតុ គីមី ថ្នាំ សម្លាប់ សត្វ ល្អិត ដែល បង្កឲ្យ ប៉ះពាល់ ដល់ សុខភាព មនុស្ស យ៉ាង ធ្ងន់ធ្ងរ ។
លោក បាន បញ្ជាក់ ថា បញ្ហា គ្រោះថ្នាក់ សម្ពាធ ឈាម ធ្លាក់ចុះ ខ្លាំង ធ្វើឲ្យ ចុះខ្សោយ ប្រព័ន្ធ ប្រសៃ ប្រាសាទ កណ្តាល បំពង ខ្សល់ សួត ត្បៀត តូច នាំឲ្យ ពិបាក ដកដង្ហើម ឫ កើត ហឺត នាំឲ្យ រលាក ក្រពះ រលាក ប្រព័ន្ធ ឈាម រត់ នាំឲ្យ ហើម ខ្លួន ស្បែក ឡើង ក្រហម និង មាន រមាស់ ចាក់ ឡើង ឆៀប ៗ ។
បើ តាម ការបញ្ជាក់ ពី ក្រុមការងារ រថយន្ត មន្ទីរពិសោធន៍ ចល័ត បាន ឲ្យដឹង ថា បន្ទាប់ពី បាន ធ្វើ ការត្រួតពិនិត្យ និង ធ្វើតេស្ត បឋម ដើម្បី រក សារធាតុ ឃាត់ ក្នុង ចំណោម បន្លែ ត្រី សាច់ និង ម្ហូប អាហារ ចំនួន ៥៦មុខ ជា លទ្ធផល មន្ត្រី ជំនាញ បាន រកឃើញ ថា មាន ៣មុខ គឺ បាញ់ ដុប លត និង បន្លែង ខាត់ ណា គឺ មាន សារធាតុ ហាមឃាត់ ដែល ធ្វើឲ្យ ប៉ះពាល់ ដល់ សុខភាព អ្នកទទួលទាន ៕ ចូលរួម អបអរសាទរ ! បេក្ខជន ពិការ ដៃ ជើង និង ភ្នែក ៣នាក់ នៅ ខេត្ត កំពង់ធំ សម្រេច ជោគវាសនា របស់ ខ្លួន ដោយ ប្រឡង ជាប់ បាក់ឌុប បាន និទ្ទេស D
( កំពង់ធំ )៖ បេក្ខជន ប្រឡង មធ្យមសិក្សា ទុតិយភូមិ ( បាក់ឌុប ) នា សម័យ ប្រឡង ១៩ សីហា ឆ្នាំ ២០១៩ បាន សម្រេច ជោគវាសនា របស់ ខ្លួន ដោយ ប្រឡង ជាប់ សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ បាន និទ្ទេស D ។
( ព្រះវិហារ ) ៖ នៅ ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត ព្រះវិហារ រួម ជាមួយ ថ្នាក់ដឹកនាំ មន្ទីរ អង្គភាព ជុំវិញ ខេត្ត បាន អញ្ជើញ ចូលរួម ក្នុង ពិធី បើក ការដ្ឋាន ជួសជុល ផ្លូវ អ៊ុត បេតុង កៅស៊ូ (AC) លើក ដំបូង កំរាស់ ៥សង់ទីម៉ែត្រ លើ ផ្លូវ ចំនួន ៣ខ្សែ ដែល មាន ប្រវែង សរុប ៤៨៥០ម៉ែត្រ ស្មើ និង ៧២១៥០ ម៉ែត្រ ការ៉េ ក្នុង ក្រុង ព្រះវិហារ ។
លោក ប្រាក់ សុវណ្ណ បាន ចាត់ទុក ថា ថ្ងៃ នេះ ជា ប្រវត្តិសាស្ត្រ ហើយ ដែល ខេត្ត ព្រះវិហារ បាន បើក ការដ្ឋាន សាងសង់ ផ្លូវ អ៊ុត បេតុង កៅស៊ូ (AC) ដែល មាន កំរាស់ ៥សង់ទីម៉ែត្រ លើ ផ្លូវ ចំនួន ៣ខ្សែ ក្នុង ក្រុង ព្រះវិហារ ដើម្បី បង្ក លក្ខណៈ ងាយស្រួល ដល់ ការធ្វើចរាចរណ៍ របស់ បងប្អូន ប្រជាពលរដ្ឋ ។
លោក អភិបាល ខេត្ត ព្រះវិហារ បាន បន្ត ទៀត ថា « សមិទ្ធិផល ខាងលើ នេះ គឺ ផ្តល់ ជូន ដោយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ជូន ដល់ រដ្ឋបាល ខេត្ត ព្រះវិហារ តាមរយៈ គម្រោង អភិវឌ្ឍន៍ ខេត្ត សម្រាប់ ឆ្នាំ ២០១៩ និង មាន គម្រោង ផ្លូវ អ៊ុត បេតុង កៅស៊ូ ប្រភេទ នេះ សម្រាប់ ផែនការអភិវឌ្ឍន៍ ក្នុង ខេត្ត ជា បន្តបន្ទាប់ សម្រាប់ ឆ្នាំ ខាងមុខ ទៀត ដើម្បី បំរើ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ » ។
ជាមួយគ្នា នោះ លោក ប្រាក់ សុវណ្ណ បាន ណែនាំ ដល់ ក្រុមហ៊ុន ដែល ទទួល ការអនុវត្តន៍ សាងសង់ ផ្លូវ នេះ ត្រូវ យកចិត្តទុកដាក់ ធ្វើ យ៉ាងណា ត្រូវ គោរព តាម បទដ្ឋាន បច្ចេកទេស ដើម្បី ធានា ឲ្យ ផ្លូវ នេះ មាន គុណភាព និង សោភណ្ឌ័ភាព ។ លោក អភិបាល ខេត្ត រំពឹង ថា ក្រោយពី សាងសង់ ផ្លូវ នេះ រួច នឹង ជួយ លើក សម្រស់ ខេត្ត របស់ យើង ក្នុង ការចូលរួម ប្រឡង ប្រណាំង ទីក្រុង ស្អាត និង អាច ទទួលបាន ផ្កា រំដួល២ ឬ ៣ទង នា ឆ្នាំ បន្តបន្ទាប់ ទៀត ។
ដោយឡែក លោក សំ លាង ទ្រី ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ បាន លើកឡើង ថា ផ្លូវ ចាក់ បេតុង ៣ខ្សែ ក្នុង ក្រុង ព្រះវិហារ ដែល បើក ការដ្ឋាន ជួសជុល នៅ ពេល នេះ រួម មាន៖
លោក សំ លាង ទ្រី បាន គូសបញ្ជាក់ ថា ផ្លូវ ទាំង ៣ខ្សែ នេះ គឺ បាន សាងសង់ តាំងពី ឆ្នាំ ២០០៥ ម្ល៉េះ រហូតមកដល់ ពេលនេះ មាន អាយុកាល ១៥ឆ្នាំ ហើយ ។
លោក ថា ការ ដែល ផ្លូវ នេះ អាច ប្រើប្រាស់ បាន យូរ រហូតមកដល់ សព្វ ថ្ងៃ នេះ ក៏ ដោយសារតែ យើង មាន ការថែទាំ ជួសជុល ជាប្រចាំ ផងដែរ ជាទូទៅ ប្រភេទ ផ្លូវ DBST ជីវិត របស់ វា គឺ មាន អាយុកាល ចន្លោះ តែ ពី ៤ទៅ៦ ឆ្នាំ ឆ្នាំ ប៉ុណ្ណោះ ។ លោក ថា បន្ទាប់ពី ផ្លូវ នេះ សាងសង់ រួច អាច ប្រើប្រាស់ បាន រហូត ១០ឆ្នាំ ទៀត ។
លោក សំ លាង ទ្រី បាន ឲ្យដឹង ទៀត ថា បច្ចុប្បន្ន នេះ ទោះបី មាន ទឹក ជំនន់ លិច ផ្លូវ ផ្នែក ខ្លះ នៃ ក្រុង ព្រះវិហារ ក៏ដោយ ប៉ុន្តែ ស្រប ពេល និង ទឹក ស្រក វិញ អជ្ញាធរ ខេត្ត និង មន្ទីរ ជំនាញ នឹង ចាប់ផ្តើម យកចិត្តទុកដាក់ ធ្វើ ការជួសជុល ឡើងវិញ ហើយ ។
លោក ក៏ សូម អំពាវនាវ ផងដែរ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន លំដ្ឋាន រស់ នៅក្បែរ ផ្លូវ ត្រូវ ចូលរួម ថែរក្សា ផ្លូវថ្នល់ របស់ យើង ប្រយោជន៍ ដើម្បីឲ្យ ការប្រើប្រាស់ បាន យូរអង្វែង ពោល កុំ ចាក់ ដី ខ្ពស់ ជាង ផ្លូវ កុំ ចាក់ ដី លប់ លូ និង យក ចំណី ផ្លូវ ធ្វើ អាជីវកម្ម ជាដាច់ខាត ៕
ទឹក ជំនន់ វាយប្រហារ មូលដ្ឋាន ស្រុក ប្រាសាទ សំបូរ និង ស្រុក សណ្តាន់ ខេត្ត កំពង់ធំ . អាជ្ញាធរ ស្វែងរក ទី ទួល មាន សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ស្នាក់ នៅ បណ្តោះអាសន្ន
( កំពង់ធំ )៖ ប្រជាពលរដ្ឋ ដែល កំពុង រស់ នៅ តាម ដងស្ទឹង សែន ក្នុង ស្រុក ប្រាសាទ សំបូរ និង នៅ តាម ភូមិ មួយចំនួន កំពុង ទទួល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។ ស្រប ពេល នោះ ដែរ ប្រជាពលរដ្ឋ តាម បណ្តា ភូមិ និង មន្រ្តី អាជ្ញាធរ កំពុងតែ ខិតខំ ស្វះស្វែងរក ទី ទួល សុវត្ថិភាព ដើម្បី ការពារ ទ្រព្យសម្បត្តិ របស់ ពួកគាត់ ដូចជា សត្វ ពាហនៈ ជាដើម ។
លោក បាន ណែនាំឲ្យ បងប្អូន រស់ នៅ តាម ដងស្ទឹង សែន បន្ត ប្រុងប្រយ័ត្ន ខ្ពស់ ក្នុង ការស់ នៅ ប្រចាំ ថ្ងៃ ជាពិសេស កុមារ តូច ៗ ដែល អាច ប្រឈម នឹង ការលង់ទឹក ស្លាប់ បាន និង ត្រូវ ត្រៀមទុក ជាមុន នូវ ស្បៀងអាហារ ថ្នាំ សង្កូវ ជាដើម ព្រោះ ស្ថានភាព ទឹក ឆ្នាំ នេះ សម្រាប់ ស្រុក ប្រាសាទ សំបូរ មិន ទាន់ ដល់ កម្រិត ប្រកាស អាសន្ន នៅឡើយ ទេ ។ ដោយឡែក ស្រុក សណ្ដាន់ គឺ បាន ដល់ កម្រិត ប្រកាស អាសន្ន ហើយ ។
លោក សុខ លូ បាន ប្រាប់ ពលរដ្ឋ ថា នៅពេល មាន បញ្ហា ក្នុង រដូវ ទឹក ជំនន់ នេះ មិន ថា ទីកន្លែងណា ទេ អាជ្ញាធរ នៅ តាម មូលដ្ឋាន និមួយ ៗ បាន ត្រៀម ខ្លួន ជាស្រេច ក្នុង ការជួយ ដល់ បងប្អូន គ្រប់ ពេលវេលា ហើយ ការត្រៀម សម្រាប់ រដូវ ទឹក សម្រក វិញ នោះ ប្រសិនបើ មាន ការខូចខាត ផល ដំណាំ ស្រូវ របស់ ពួកគាត់ យើង មាន គ្រាប់ ពូជ សម្រាប់ ចែកជូន ដល់ ពួកគាត់ ទៀត ផងដែរ ។
ក្នុង ការចុះ សួរសុខទុក្ខ នេះ ដែរ លោក ក៏ បាន នាំយក អំណោយ និង ថវិកា ចំនួន ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ដែល កំពុងតែ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ទាំងនោះ ផងដែរ ៕ នាយក រដ្ឋមន្ត្រី បន្ទោស ភាគី ក្នុង ស្រុក និង អន្តរជាតិ ដែល ធ្វើឲ្យ ការដោះស្រាយ បញ្ហា លីប៊ី ត្រូវ រាំងស្ទះ
ថ្លែង នៅក្នុង សេចក្ដីថ្លែងការណ៍ មួយ ចេញផ្សាយ នៅ ថ្ងៃអង្គារ សប្ដាហ៍ នេះ លោក Serraj បាន កត់សម្គាល់ យ៉ាង ដូច្នេះ ថា « តួនាទី របស់ រដ្ឋាភិបាល រួបរួម ជាតិ លីប៊ី គឺ ស្វែងរក ដំណោះស្រាយ នយោបាយ ដើម្បី បើក ផ្លូវ ឆ្ពោះ ទៅរក បោះឆ្នោត ប្រជាមតិ លើ រដ្ឋធម្មនុញ្ញ ថ្មី និង ការបោះឆ្នោត សកល .. . ប៉ុន្តែ គួរ ឱ្យ សោកស្ដាយ នោះ ភាគី មួយចំនួន ទាំង នៅក្នុង ស្រុក និង អន្តរជាតិ មួយចំនួន បាន បង្ក ឧបសគ្គ ដល់ គោលបំណង មួយ នេះ ជាពិសេស គឺ តាមរយៈ ការវាយប្រហារ លើ រដ្ឋធានី ទ្រី ប៉ូលីនា ប៉ុន្មាន ខែ មក នេះ » ។
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃស្អែក នេះ ទីភ្នាក់ងារ ជាតិ មុខរបរ និង ការងារ (NEA) នៃ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ មាន ឱកាស ការងារ ចំនួន ៩០៣ កន្លែង ទៀត ហើយ កំពុង រង់ចាំ សិស្ស / និស្សិត អ្នក ស្វែងរក ការងារ និង អ្នក មាន បំណង ចង់ ផ្លាស់ប្តូរ ការងារ ថ្មី ជាមួយនឹង ក្រុមហ៊ុន ធំ ៗ ចំនួន ១១ ក្នុង វេទិកា ការងារ នៅ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ ស្អែក នេះ ។
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បើក កិច្ចប្រជុំ ដក ពិសោធន៍ ការងារ បង្ការ ទប់ស្កាត់ និង បង្ការ អំពើ លួច ឆក់ ក្នុង រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ព្រឹក ថ្ងៃទី ១១ ខែសីហា ឆ្នាំ ២០១៩ នេះ បាន បើក កិច្ចប្រជុំ ដក ពិសោធន៍ ការងារ បង្ការ ទប់ស្កាត់ និង បង្ការ អំពើ លួច ឆក់ ក្នុង ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ ។
កិច្ចប្រជុំ នេះ ត្រូវបាន ធ្វើឡើង នៅ សាល ប្រជុំ នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ ហ៊ឹម យ៉ាន និង លោក ឧត្តមសេនីយ៍ ឯក អ៉ិន បូរ៉ា អគ្គ ស្នងការ រង នគរបាល ជាតិ និង មាន ការចូលរួម ពី ប្រធាន នាយកដ្ឋាន អនុប្រធាន នាយកដ្ឋាន និង ថ្នាក់ដឹកនាំ នគរបាល ដែល ពាក់ព័ន្ធ ជាច្រើន ទៀត ផងដែរ ។
យោង តាម របាយការណ៍ របស់ លោក ឧត្តមសេនីយ៍ ទោ ស៊ុយ សុគន្ធា ប្រធាន ក្រុម លេខាធិការដ្ឋាន បង្ការ ទប់ស្កាត់ និង បង្ក្រាប អំពើ លួច ឆក់ ក្នុង រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា បទល្មើស ជា រួម ក្នុង ខែសីហា បាន កើតឡើង ចំនួន ៦៣ ករណី ប៉ុន្ដែ ដោយ មាន កិច្ច ខិតខំ ប្រឹងប្រែង ពី កម្លាំង គ្រប់ អង្គភាព ទាំងអស់ សហការ គ្នា បង្ក្រាប បាន ចំនួន ៥០ ករណី ចាប់ខ្លួន ជនសង្ស័យ បាន ៦៤ នាក់ ស្មើនឹង ៧៩ ភាគរយ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក អ៉ិន បូរ៉ា បាន ធ្វើការកត់សម្គាល់ ឃើញ ថា បើ ទោះបី បទល្មើស ជា រួម មាន ការកើនឡើង មែន ប៉ុន្ដែ ការបង្ក្រាប ក៏ មាន ប្រសិទ្ធភាព ដោយ មាន ការរួមដៃ គ្នា យ៉ាង ស្អិត រមួត ពី កម្លាំង គ្រប់ អង្គភាព ដែល មាន ការពាក់ព័ន្ធ ទាំងអស់ ហើយ នេះ ក៏ ជា មោទនភាព ចំពោះ កងកម្លាំង ទាំងអស់ ផងដែរ ។
ប៉ុន្ដែ ទោះជា យ៉ាងណា អគ្គ ស្នងការរង អ៉ិន បូរ៉ា ក៏ បាន ក្រើន រំលឹក ដល់ ថ្នាក់ដឹកនាំ និង កម្លាំង នគរបាល ពាក់ព័ន្ធ ទាំងអស់ ត្រូវតែ រួមគ្នា បង្ការ ទប់ស្កាត់ បន្ថែម ទៀត សម្ដៅ កាត់បន្ថយ រាល់ គ្រប់ បទល្មើស ដែល អាចនឹង កើត មាន ឡើង ដើម្បី រក្សា សន្ដិសុខ សណ្ដាប់ធ្នាប់ និង សុវត្ថិភាព សង្គម ជូន ប្រជាពលរដ្ឋ និង ភ្ញៀវ ទេសចរ ។
ជាមួយគ្នា នេះ នាយ ឧត្តមសេនីយ៍ ហ៊ឹម យ៉ាន ក៏ បាន ធ្វើ ការវាយតម្លៃ ខ្ពស់ ចំពោះ កម្លាំង នគរបាល ជំនាញ យុត្តិធម៌ ដែល បាន បំពេញ ការងារ យ៉ាង ល្អ ប្រសើរ ដោយ សហការ ជាមួយ កម្លាំង ជំនាញ ពាក់ព័ន្ធ ទាំងអស់ លើ ការងារ បង្ការ ទប់ស្កាត់ និង បង្ក្រាប អំពើ លួច ឆក់ ក្នុង ភូមិសាស្ដ្រ រាជធានី ភ្នំពេញ ។
បន្ថែម ពី នេះ លោក ឧត្តមសេនីយ៍ ឯក ង៉ែង ជួ ប្រធាន នាយកដ្ឋាន នគរបាល ព្រហ្មទណ្ឌ ក៏ បាន ណែនាំ ដល់ នគរបាល ព្រហ្មទណ្ឌ ទាំងអស់ ត្រូវ ធ្វើ បច្ចុប្បន្នភាព រាល់ មុខ សញ្ញា ទាំងឡាយ ដែល អតីតកាល ឬ បច្ចុប្បន្ន កាល នេះ ធ្លាប់ មាន សកម្ម ភាព លួច ឆក់ ដើម្បី ដាក់ ចេញ វិធានការអប់រំ ទប់ស្កាត់ និង តាមដាន បង្ក្រាប់ ពេល មុខ សញ្ញា ទាំង នេះ ធ្វើ សកម្មភាព ឡើងវិញ ។
លោក បន្ដ ថា ជំនាញ ក៏ ត្រូវ ធ្វើ បច្ចុប្បន្នភាព រាល់ មុខ សញ្ញា ទាំងឡាយ ( លួច . ប្លន់ . ចាក់ ជក់ . ប្រើប្រាស់ គ្រឿងញៀន ) ដែល មាន ដីកា បង្គាប់ ឲ្យ ចាប់ខ្លួន ឬ ដីកា ស្វែងរក ចាប់ខ្លួន ( ដោយ ផ្អែក តាម សាលក្រម ឬ សាល ដីកា ស្ថាពរ ) សម្ដៅ រកឃើញ នូវ មុខ សញ្ញា ទាំងនោះ ដើម្បី ធ្វើ ការបង្ក្រាប ឬ ក្តាប់ បាន ពី ការរត់គេចខ្លួន ជា បុគ្គល ឬ ជា គ្រួសារ ដើម្បី មាន វិធានការស៊ើបអង្កេត ស្រាវជ្រាវ ឲ្យបាន ម៉ត់ចត់ ៕
ប្រកាស ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន នៅ រាជធានី ភ្នំពេញ . លោកស្រី ម៉ែន សំអន ជំរុញ ឲ្យ មន្រ្តី ខិតខំ ដោះស្រាយ បញ្ហា ប្រឈម នានា របស់ ប្រជាពលរដ្ឋ
( ភ្នំពេញ ) ៖ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន នៅ រាជធានី ភ្នំពេញ ត្រូវបាន ប្រកាស ជា ផ្លូវការ ដើម្បី ត្រួតពិនិត្យ និង គាំទ្រ ការអនុវត្ត កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល សំរាប់ ខណ្ឌ ទាំង ១៤ក្នុង រាជធានី ភ្នំពេញ ។
ពិធី ប្រកាស ជា ផ្លូវការ ត្រូវ បាន ធ្វើឡើង នា រសៀល ថ្ងៃទី ១០ ខែកញ្ញា នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម អធិបតីភាព លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា ព្រឹទ្ធសភា និង អធិការកិច្ច និង ជា ប្រធាន ក្រុមការងារ ចុះ មូលដ្ឋាន រាជធានី ភ្នំពេញ ។
លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ និង ជា អនុប្រធាន អចិន្ត្រៃយ៍ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន រាជធានី ភ្នំពេញ បាន លើកឡើង ពី សកម្មភាព របស់ ក្រុមការងារ ចុះ ជួយ រាជធានី ភ្នំពេញ ដែល បាន ខិតខំ ប្រឹងប្រែង ដោះស្រាយ រាល់ សំណូមពរ និង ឆ្លើយតប តាម តំរូវការ របស់ ប្រជាពលរដ្ឋ ក៏ ដូចជា ដើម្បី ត្រូត ពិនិត្យ និង គាំទ្រ ការអនុវត្ត កម្មវិធី នយោបាយ និង យុទ្ធសាស្ត្រ ចតុកោណ ដំណាក់ កាល ទី៤ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា នៅ រាជធានី ភ្នំពេញ និង ទទួលបាន ការគាំទ្រ យ៉ាង ពេញ ទំហឹង ពី ប្រជាពលរដ្ឋ ។
