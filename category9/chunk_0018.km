( ភ្នំពេញ ) ៖ ក្រុម មេធាវី រាជ រដ្ឋាភិបាល នៅ រសៀល ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្តីថ្លែងការណ៍ ដោយ ស្នើ ដល់ ស្ថាប័ន មាន សមត្ថកិច្ច អយ្យការ និង តុលាការ គ្រប់ ជាន់ ថ្នាក់ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ឲ្យបាន តឹងរ៉ឹង និង ធ្ងន់ធ្ងរ បំផុត លើ ក ទណ្ឌិត សម រង្ស៊ី ដែល ហ៊ាន ប្រមាថ ដ៏ ធ្ងន់ធ្ងរ បំផុត លើ អង្គ ព្រះមហាក្សត្រ ខណៈ ក្រសួង ព្រះបរម រាជ វាំង ក៏ បាន ចេញ សេចក្តីថ្លែងការណ៍ ថ្កោលទោស យ៉ាង ដាច់អហង្កា ផងដែរ ។
ក្រុម មេធាវី រាជ រដ្ឋាភិបាល បន្ថែម ថា ក្នុង ពាក្យសម្តី ដែល ទណ្ឌិត សម រង្ស៊ី បាន លើកឡើង ក៏ ជា ការនិយាយ បរិហារ ចោទប្រកាន់ ផ្ទុយ ពី ការពិត ទម្លាក់ កំហុស លើ សម្តេច តេជោ ហ៊ុន សែន ក្នុង ចេតនា ញុះញង់ បង្កឲ្យ មាន ភាពវឹកវរ ចលាច ល អសន្តិសុខ ក្នុង សង្គម ដែល ជា ការបំពាន លើ មាត្រា ៣០៥ មាត្រា ៤៩៤ និង មាត្រា ៤៩៥ នៃ ក្រម ព្រហ្មទណ្ឌ ។
ក្រុម មេធាវី រាជ រដ្ឋាភិបាល បញ្ជាក់ ទៀត ថា បុគ្គល សម រង្ស៊ី រូប នេះ មាន ពាក្យបណ្តឹង និង មាន សាលក្រម សាល ដីការស្ថាពរ ផ្តន្ទាទោស ជាច្រើន ដែល រហូតមកដល់ ពេលនេះ បាន ក្លាយទៅជា ទណ្ឌិត មួយ រូប កំពុង ត្រូវបាន សមត្ថកិច្ច តាម ចាប់ខ្លួន យកមក អនុវត្ត ទោស ក្នុង ពន្ធនាគារ ។
ចំណែក សេចក្តីថ្លែងការណ៍ របស់ ក្រសួង ព្រះបរម រាជ វាំង បាន បញ្ជាក់ ថា៖ « ក្រសួង ព្រះបរម រាជ វាំង សូម ប្រកាស ដាច់ អហង្កា ថ្កោល ទោស ចំពោះ លោក សម រង្សី ដែល មាន ចរិត ជា ជនក្បត់ ជាតិ តែងតែ ពោល ពាក្យ ប៉ះពាល់ ដល់ ព្រះកិត្តិនាម ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ដែល ព្រះអង្គ កំពុង គង់ ប្រថាប់ បំពេញ ព្រះរាជ តួនាទី ដ៏ ឧត្តុង្គឧត្តម ជា និមិត្តរូប នៃ ឯកភាព ជាតិ និង រិរន្តរភាពជាតិ » ។
ព្រះបរម រាជ វាំង បាន បញ្ជាក់ ទៀត ថា៖ អាស្រ័យ លើ ព្រះរាជ តួនាទី ដ៏ ឧត្តុង្គឧត្តម ខាងលើ នេះ សង្គមជាតិ កម្ពុជា កំពុង ទទួលបាន សេចក្តីសុខ សន្តិភាព និង ការអភិវឌ្ឍន៍ ក្រោម ការដឹកនាំ របស់ រាជដ្ឋាភិបាល នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោកស្រី ម៉ែន សំអន អញ្ជើញ ចូលរួម សូត្រ មន្ត នៅ វត្ត ព្រៃ ឆ្លាក់ ក្រុង ស្វាយរៀង
( ស្វាយរៀង ) ៖ លោកស្រី កិត្ដិ សង្គហ បណ្ឌិត ម៉ែន សំអន ឧប នាយក រដ្ឋមន្ដ្រី និង រដ្ឋមន្ដ្រី ក្រសួង ទំនាក់ទំនង ជាមួយ រដ្ឋសភា - ព្រឹទ្ធសភា និង អធិការកិច្ច និង ជា ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខេត្ត ស្វាយរៀង ព្រមទាំង ក្រុមការងារ បាន ចូលរួម ក្នុង ពិធី សូត្រ មន្ត ព្រះសង្ឃ ៦៧ អង្គ ជាមួយ ពុទ្ធ បរិស័ទ នៅ វត្ត ព្រៃ ឆ្លាក់ នា រសៀល ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ ស្ថិត ក្នុង ភូមិ ព្រៃ ឆ្លាក់ សង្កាត់ ព្រៃ ឆ្លាក់ ក្រុង ស្វាយរៀង ។
ថ្លែង ក្នុង ឱកាស នោះ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ក៏ ពាំនាំ នូវ ការសាកសួរ សុខទុក្ខ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល ជានិច្ចកាល លោក តែងតែ គិតគូរ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ នៅ ទូទាំង ប្រទេស កម្ពុជា ។
លោកស្រី កិត្តិសង្គហ បណ្ឌិត បាន បួងសួង ដល់ វត្ថុ ស័ក្ដិសិទ្ធិ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ និង ពុទ្ធ បរិស័ទ ចំណុះ ជើង វត្ត ទាំងអស់ សូម បាន ជួបប្រទះ តែ ព្រះពុទ្ធ ពរ ទាំង ៤ប្រការ និង សុំ តែ សេចក្តីសុខ សេចក្តី ចម្រើន និង សុភមង្គល គ្រប់ ក្រុមគ្រួសារ ។
ក្នុង ឱកាស នោះ លោកស្រី កិត្តិសង្គហ បណ្ឌិត ម៉ែន សំអន និង ក្រុមការងារ ក៏ បាន ប្រគេន បច្ច័យ ១០លាន រៀល ដល់ វត្ត ព្រៃ ឆ្លាក់ និង ព្រះសង្ឃ ៦៦ អង្គ ក្នុង មួយ អង្គ ទទួលបាន ស្លា ដក មួយ និង បច្ច័យ ៤ម៉ឺន រៀល ។
មួយចំណែក នៃ កុសល ផល បុណ្យ នេះ សូម ឧទ្ទិស ជូន ចំពោះ ដូង វិញ្ញាណក្ខន្ធ អ្នកស្នេហាជាតិ គ្រប់ ជំនាន់ ដែល បាន បូជា អាយុជីវិត ក្នុង បុព្វហេតុ ការពារ និង កសាង ជាតិ មាតុភូមិ និង ប្រជាជន សូមឲ្យ ដួង វិញ្ញាណក្ខន្ធ អ្នក ទាំងនោះ ចាប់ កំណើត កើត ក្នុង ឋាន សុគតិភព កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ ក្រសួង ការងារ ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ទណ្ឌិត សម រង្ស៉ី ដែល បាន ប្រមាង យ៉ាង ធ្ងន់ធ្ងរ លើ អង្គ ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ យប់ ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្តីថ្លែងការណ៍ ថ្កោលទោស ចំពោះ ទណ្ឌិត សម រង្ស៉ី ដែល ប្រមាថ ដល់ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជារាស្ត្រ ខ្មែរ ទូទាំង ប្រទេស និង ជា និមិត្តរូប នៃ ឯកភាព ជាតិ និង និរន្តរភាពជាតិ ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន អំពាវនាវ ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច ពិសេស ស្ថាប័ន អយ្យការ និង តុលាការ គ្រប់ ជាន់ ថ្នាក់ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ចំពោះ ជន ក្បត់ ជាតិ និង បំផ្លិចបំផ្លាញ ជាតិ រូប នេះ ចំពោះ ទង្វើ យ៉ាង គឃ្លីន ដែល តែងតែ ប្រមាថ យ៉ាង ធ្ងន់ធ្ងរ បំផុត ដល់ អង្គ ព្រះមហាក្សត្រ ដែល ព្រះអង្គ កំពុង គង់ ប្រថាប់ បំពេញ ព្រះរាជ តួនាទី ដ៏ ឧត្តុង្គឧត្តម ជូន ជាតិ មាតុភូមិ ។
ការមានប្រសាសន៍ បែប នេះ របស់ សម្តេច ក្រឡាហោម ស ខេង បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស ដែល សម្តេច បាន អញ្ជើញ ចូលរួម ពិធី ជូនដំណើរ ប្រតិភូ កីឡា ទូក កានូកម្ពុជា ចូលរួម ហ្វឹកហាត់ កីឡា ទូក កានូ និង ប្រកួត កីឡា ទូក កានូ ជា លក្ខណៈ មិត្តភាព និង ទស្សនៈកិច្ច សិក្សា នៅ ប្រទេស ជប៉ុន នៅឯ ស្ថានទូត ជប៉ុន ប្រចាំ កម្ពុជា ។
នៅក្នុង ឱកាស នោះ ដែរ សម្តេច ក្រឡាហោម ស ខេង ក៏ បាន ថ្លែងអំណរគុណ ដល់ រដ្ឋាភិបាល ភិបាល ជប៉ុន តាមរយៈ ស្ថានទូត ជប៉ុន ប្រចាំ នៅ កម្ពុជា ដែល បាន រៀបចំ ដំណើរទស្សនកិច្ច សិក្សា របស់ ក្រុម កីឡាករ កីឡាការិនី « ទូក កានូ និង រ៉ូអ៊ីង » នៅ ប្រទេស ជប៉ុន ដែល ជា កីឡា មួយ ប្រភេទ ថ្មី របស់ ជប៉ុន ខិតខំ បង្ហាត់ បង្រៀន ដល់ កម្ពុជា ។
បន្ថែម ពី នេះ សម្តេច ក្រឡាហោម ស ខេង ក៏ បាន ជំរុញ ឱ្យ កីឡាករ កីឡាការិនី « ទូក កានូ» ទាំងអស់ ត្រូវ សហការ គ្នា ឱ្យ បាន ល្អ នៅក្នុង ពេល ហ្វឹកហាត់ និង ការប្រកួត លក្ខណៈ អន្តរជាតិ នានា ផងដែរ ។ ជាពិសេស ត្រូវ ស្តាប់ តាម ការណែនាំ របស់ លោកគ្រូ បើ ទោះបី វា ជា កីឡា មួយ ថ្មី មែន ប៉ុន្តែ ក្នុង នាម ជា កីឡា ត្រូវតែ តស៊ូ អត់ធ្មត់ លត់ ដុំ ដើម្បី ធ្វើ យ៉ាងណា ឱ្យ សម្រេចបាន នូវ អ្វី ដែល កំពុង នឹង ប្រឈម និង តម្រូវការ ចំពោះ មុខ ផងដែរ ។
កំឡុង ពេល កម្មវិធី អ្នកចូលរួម នឹង ជួប សំណេះសំណាល ជាមួយ លោក Masanori Narita ជា ប្រធាន សហព័ន្ធ ទូក កានូជប៉ុន និង ធ្វើ ទស្សនកិច្ច ទីតាំង ប្រកួត កីឡាកានូ និង រ៉ូអ៊ីង ដែល ជា ទីតាំង ប្រកួត សម្រាប់ ព្រឹត្តិការណ៍ ប្រកួត កីឡា អូឡាំពិក តូក្យូ ២០២០ ។ កីឡាករ កម្ពុជា ក៏ នឹង ចូលរួម ការហ្វឹកហាត់ រួមគ្នា ជាមួយ សមាជិក និង កីឡាករ ជម្រើសជាតិ ជប៉ុន នៅ ទីលាន ប្រកួត គី បាហ្កាតា ក្នុង ទីក្រុង កូម៉ាត្សឹ ខេត្ត អ៊ីស៊ីកាវ៉ា ។
កម្មវិធី JENESYS មាន គោលបំណង ជំរុញ ការយល់ដឹង និង ការកសាង ទំនុកចិត្ត ទៅ វិញ ទៅមក ក្នុង ចំណោម ប្រជាជន ជប៉ុន និង បណ្តា ប្រទេស ចូលរួម និង ដើម្បី កសាង មូលដ្ឋានគ្រឹះ នៃ កិច្ចសហប្រតិបត្តិការ និង ចំណង មិត្តភាព នា ពេល អនាគត ។ តាមរយៈ កម្មវិធី នេះ ក្រសួង ការបរទេស ជប៉ុន បាន អញ្ជើញ យុវជន កម្ពុជា ចំនួន ជាង ២០០០ នាក់ ហើយ តាំងពី ឆ្នាំ ២០០៧មក ៕
មេស៉ី ម៉ាក់ ប្រកាស ថ្កោល ទោស ទណ្ឌិត សម រង្ស៉ី ដែល ប្រមាថ ព្រះចេស្ដា ព្រះមហាក្សត្រ និង ស្នើឲ្យ ចាត់ វិធានការ ច្បាប់ ចំពោះ ជន ទុច្ចរិត នេះ !
( ភ្នំពេញ ) ៖ លោក ហេង រតនា អគ្គ នាយក មជ្ឈមណ្ឌល សកម្មភាព កំចាត់ មីន កម្ពុជា ( ស៊ីម៉ាក់ ) នៅ ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ចេញមក ប្រកាស ថ្កោល ទោស ទណ្ឌិត សម រង្ស៉ី យ៉ាង ដាច់អហង្ការ ចំពោះ ការប្រមាថ យ៉ាង ធ្ងន់ធ្ងរ ដល់ អង្គ ព្រះមហាក្សត្រ ដែល ជាទីគោរព សក្ការៈ បំផុត របស់ ប្រជារាស្ដ្រ ខ្មែរ ទូទាំង ប្រទេស ។
លោក ហេង រតនា ក្រៅពី ការប្រកាស ថ្កោល ទោស ខ្លាំង ៗ ទៅ លើ ទណ្ឌិត រត់ ចោល ស្រុក រូប នេះ ហើយ ក៏ បាន ប្រកាស ប្រឆាំង ដាច់ខាត ចំពោះ ទង្វើ បំផ្លាញ សេចក្តីថ្លៃថ្នូរ និង ប្រកបដោយ ទុច្ចរិត នេះ ដូច្នេះ សូមឲ្យ រាជ រដ្ឋាភិបាល មេត្តា ចាត់ វិធានការ ច្បាប់ ចំពោះ ជន ទុច្ចរិត នេះ ឲ្យ ខាន តែ បាន ។
អគ្គ នាយក មជ្ឈមណ្ឌល កំចាត់ មីន កម្ពុជា បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ខ្ញុំបាទ និង ក្រុមគ្រួសារ ក៏ ដូច ប្រជាពលរដ្ឋ ខែ្មរ ទាំងអស់ នៃ ទឹកដី ព្រះរាជាណាចក្រ នេះ មាន ក្តី គោរព ស្រលាញ់ ព្រះមហាក្សត្រ យ៉ាង ជ្រាលជ្រៅ ជាង ជីវិត ដែល វប្បធម៌ និង សីលធម៌ ដ៏ ល្អ ផូរផង់ នេះ មាន តាំងពី ដូន តា ខែ្មរ រាប់ ពាន់ ឆ្នាំ មុន មក ម្លេះ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃសុក្រ ទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ ស្ថានការណ៍ ទូទាំង សកលលោក និង រឿង ហេតុ គួរឲ្យ ចាប់អារម្មណ៍ ផ្សេង ៗ ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
១៖ ក្រុម អ្នកវិទ្យាសាស្ត្រ ចិន និង កាណាដា សហការ គ្នា រកឃើញ អំបូរ សត្វ ប្រភេទ ថ្មី ដែល មាន អាយុកាល ចំណាស់ បំផុត ។
៣៖ ចិន ដក ផលិតផល កសិកម្ម អាមេរិក មួយចំនួន បន្ថែម ទៀត ចេញ ពី បញ្ជី ត្រូវ ដំឡើង ពន្ធ ។
៤៖ ម៉ិចស៊ីកូសុំ ឲ្យ អាមេរិក ទប់ ស្តាត់ ការរត់ ពន្ធ កាំភ្លើង ខុស ច្បាប់ តាម ព្រំដែន ឲ្យ ដូច ម៉ិចស៊ីកូ ទប់ស្កាត់ លំហូរ ជនភៀសខ្លួន ដែរ ។
៥៖ អាមេរិក ត្រៀម បញ្ចេញ ឈ្មោះ បុគ្គល សំខាន់ ម្នាក់ ទៀត ដែល បាន ចូល ដៃ បង្ក មហា ភេរវកម្ម ១១/ កញ្ញា ។
៧៖ អ្នកវិទ្យាសាស្រ្ត ប្រទះឃើញ វត្ថុអវកាស ថ្មី មួយ ទៀត ដែល ទើបតែ ឆ្លង ចូលមក ក្នុង ប្រព័ន្ធ ព្រះអាទិត្យ របស់ យើង ។ រដ្ឋបាល ខេត្ត កំពង់ចាម ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ប្រមាថ ព្រះមហាក្សត្រ
( កំពង់ចាម ) ៖ ក្នុង នាម ក្រុមប្រឹក្សា គណៈ អភិបាល មន្ដ្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ប្រភេទ និង ប្រជាពលរដ្ឋ ទាំងអស់ រដ្ឋបាល ខេត្ត កំពង់ចាម បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល បាន ប្រមាថ យ៉ាង គឃ្លើន បំផុត ចំពោះ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ រដ្ឋបាល ខេត្ត កំពង់ចាម បាន បញ្ជាក់ ថា « ទង្វើ បែប នេះ របស់ ទណ្ឌិត សម រង្ស៉ី យើងខ្ញុំ ទាំងអស់ គ្នា សូម ធ្វើ ការគាំទ្រ ទាំងស្រុង នូវ សេចក្ដីថ្លែងការណ៍ របស់ ក្រសួង ព្រះបរម រាជ វាំង ហើយ សូម ធ្វើការ ថ្កោលទោស ដាច់ អហង្ការ ចំពោះ ទណ្ឌិត សម រង្ស៉ី រូប នេះ និង សូម អាជ្ញាធរ មាន សមត្ថកិច្ច ដែល ពាក់ព័ន្ធ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ជាបន្ទាន់ និង តឹងរ៉ឹង បំផុត ចំពោះ ទង្វើ រំលោភបំពាន ដ៏ ធ្ងន់ធ្ងរ លើ អង្គ ព្រះមហាក្សត្រ និង លើ រដ្ឋធម្មនុញ្ញា នៃ ព្រះរាជាណាចក្រ កម្ពុជា » ។
រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ប្រមាថ ព្រះមហាក្សត្រ
( ឧត្ដរ មានជ័យ ) ៖ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ ព្រះសង្ឃ មន្ដ្រីរាជការ បញ្ញវន្ដ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល បាន ប្រមាថ យ៉ាង គឃ្លើន បំផុត ចំពោះ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ រដ្ឋបាល ខេត្ត ឧត្តរមានជ័យ បាន បញ្ជាក់ ថា « ក្នុង នាម ព្រះសង្ឃ មន្ដ្រីរាជការ បញ្ញវន្ដ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ឧត្តរមានជ័យ រដ្ឋបាល ខេត្ត សូម ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ទង្វើ ប្រមាថ នេះ និង សូម សំណូមពរ ឲ្យ ស្ថាប័ន មាន សមត្ថកិច្ច ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ដោយ គ្មាន ការលើកលែង ចំពោះ បុគ្គល ទណ្ឌិត ក្បត់ ជាតិ ខាងលើ ឲ្យបាន ធ្ងន់ធ្ងរ បំផុត ឲ្យ សក្ដិសម នឹង ទង្វើ របស់ ខ្លួន » ។
( ភ្នំពេញ ) ៖ លោក ស សុខា រដ្ឋលេខាធិការ ក្រសួង អប់រំ យុវជន និង កីឡា នៅ យប់ ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន សម្ដែង នូវ ការ ហួសចិត្ត យ៉ាង ខ្លាំង និង ប្រកាស ថ្កោល ទោស ទណ្ឌិ សម រង្ស៊ី ដែល បាន ប្រមាថ ព្រះចេស្ដា អង្គ ព្រះមហាក្សត្រ ។
លោក ស សុខា តាមរយៈ Facebook ក៏ បាន អះអាង ថា គ្រប់ រូបភាព នៃ ការប្រមាថ ព្រះមហាក្សត្រ លោក សូម គាំទ្រ ចំពោះ ចំណាត់ការ ផ្លូវ ច្បាប់ នានា របស់ រាជ រដ្ឋាភិបាល និង តុលាការ ព្រោះ ការប្រមាថ អង្គ ព្រះមហាក្សត្រ ស្មើនឹង ប្រមាថ ប្រជារាស្ដ្រ ទាំងអស់ គ្នា ។
លោក ស សុខា បាន បង្ហោះ សារ យ៉ាង ដូច្នេះ ថា « ក្នុង នាម យុវជន ជំនាន់ ក្រោយ ម្នាក់ ខ្ញុំ ពិតជា មាន ការសោកស្ដាយ ដោយ ក្ដី ហួសចិត្ត មិន អាច ទទួលយក បាន បន្ទាប់ពី លោក សម រង្ស៊ី ចាត់ទុក ព្រះមហាក្សត្រ ជា អាយ៉ង របស់ រាជ រដ្ឋាភិបាល ឬ គណបក្ស ប្រជាជន » ។
រដ្ឋធម្មនុញ្ញ កម្ពុជា ដែល ជា ច្បាប់ កំពូល របស់ ប្រទេស បាន តម្កល់ ព្រះអង្គ ជា ព្រះប្រមុខរដ្ឋ ដែល មិន អាច ប៉ះពាល់ និង រំលោភបំពាន បាន តែ មេដឹកនាំ នយោបាយ ប្រឆាំង បែរជា ប្រមាថ ព្រះចេស្ដា ជារឿយ ៗ ។ ព្រះមហាក្សត្រ លោក មិន ធ្វើ នយោបាយ និង មិន កាន់អំណាច នោះ ទេ ។ លោក ជា និមិត្តរូប ជាតិ ដែល អាច សម្របសម្រួល នយោបាយ ក្នុង ករណី ចាំបាច់ ដែល ពុំ មែន ជា រឿង ព្រហ្មទណ្ឌ ក្នុង ដែន សមត្ថកិច្ច របស់ តុលាការ ។
សម្រាប់ ខ្ញុំ ផ្ទាល់ ប្រហែល មិន ខុសពី យុវជន ដ៏ទៃ ទៀត ដែរ ចង់ ឃើញ ខ្មែរ រួមគ្នា ជាពិសេស ចង់ ឃើញ អ្នកនយោបាយ ជា គម្រូ ល្អ ដល់ យុវជន បន្ត វេន ដោយ មិន គួរ ជំរុញ លើកទឹកចិត្ត យុវជន ឲ្យ ធ្វើ ការសម្រេចចិត្ត ដូច ភ្លលង ចំបើង ណាមួយ ទេ ។ ចំពោះ គ្រប់ រូបភាព នៃ ការប្រមាថ ព្រះមហាក្សត្រ ខ្ញុំ សូម គាំទ្រ ចំពោះ ចំណាត់ការ ផ្លូវ ច្បាប់ នានា របស់ រាជ រដ្ឋាភិបាល និង តុលាការ ។ ប្រមាថ អង្គ ព្រះមហាក្សត្រ ស្មើនឹង ប្រមាថ យើង ទាំងអស់ គ្នា ។
ខ្ញុំ យល់ ថា អ្នកនយោបាយ មាន លោក សម រង្ស៊ី ជាដើម ពុំ គួរ យក កម្ពុជា ធ្វើជា ផ្ទាំង ក្រឡា អុក និង យក យុវជន ប្រជាជន កងកម្លាំងប្រដាប់អាវុធ ជាតិ ធ្វើជា កូន អុក ដើម្បី ប្រយោជន៍ ផ្ទាល់ខ្លួន មិន មែន ប្រយោជន៍ ប្រជាជន និង ប្រទេសជាតិ នោះ ឡើយ » ។
( ភ្នំពេញ ) ៖ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ សម រង្ស៊ី ដែល បាន ប្រមាថ យ៉ាង គឃ្លើន បំផុត ចំពោះ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
( ភ្នំពេញ ) ៖ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ សម រង្ស៊ី ដែល បាន ប្រមាថ យ៉ាង គឃ្លើន បំផុត ចំពោះ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា « ពាក្យសម្ដី របស់ ទណ្ឌិត សម រង្ស៊ី ដែល បាន ផ្សព្វផ្សាយ ជាសាធារណៈ ខាងលើ គឺជា ការប្រម ថា យ៉ាង ធ្ងន់ធ្ងរ ដល់ ព្រះចេស្ដា អង្គ ព្រះមហាក្សត្រ និង បញ្ជាក់ ឲ្យ កាន់តែ ច្បាស់ ថា ឈាម ជ័រ នៃ ពូជ កូន ជន ក្បត់ ជាតិ បាន បង្ហាញ ពី ចរិក ក្បត់ ជាតិ កាន់តែ ច្បាស់ របស់ ទណ្ឌិត សម រង្ស៊ី ដូច ទង្វើ ក្បត់ ជាតិ របស់ សម សារី ជា ឪពុក » ។
( បន្ទាយមានជ័យ ) ៖ អភិបាល ខេត្ត បន្ទាយមានជ័យ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ សម រង្ស៊ី ដែល បាន ប្រមាថ យ៉ាង គឃ្លីន បំផុត ចំពោះ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ អភិបាល ខេត្ត បាន បញ្ជាក់ ថា ក្នុង នាម ក្រុមប្រឹក្សា ខេត្ត គណៈ អភិបាល ខេត្ត មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត សូម ធ្វើការ ថ្កោលទោស ចំពោះ លោក សម រង្សី ដែល មាន ចរិក ជា ជនក្បត់ ជាតិ តែងតែ បង្ក ចលាចល ញុះញង់ និង បាន ប្រមាថ ពាក្យ ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ ព្រះកិត្តិនាម ព្រះករុណា ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ។
អភិបាល ខេត្ត កំពង់ស្ពឺ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស ជន ក្បត់ ជាតិ សម រង្ស៊ី ដែល ប្រមាថ ព្រះមហាក្សត្រ
( ភ្នំពេញ ) ៖ អភិបាល ខេត្ត កំពង់ស្ពឺ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ និង ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត បាន ចេញ សេចក្តីថ្លែងការណ៍ ប្រកាស ថ្កោល ទោស យ៉ាង ដាច់អហង្ការ ចំពោះ ជន ក្បត់ ជាតិ សម រង្ស៊ី ដែល បាន ប្រមាថ យ៉ាង គឃ្លីន បំផុត ចំពោះ អង្គ ព្រះមហាក្សត្រ ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក ហ៊ុន ម៉ានី៖ ការប្រមាថ លើ ព្រះចេស្តា អង្គ ព្រះមហាក្សត្រ របស់ ទណ្ឌិត សម រង្ស៊ី បង្ហាញ ពី សីលធម៌ បែប អនាថា របស់ ខ្លួន និង បើក ដៃ ឲ្យ បរទេស មាក់ងាយ កិត្តិយស ជាតិ ទាំងមូល
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី អ្នកតំណាងរាស្ត្រ មណ្ឌល កំពង់ស្ពឺ និង ជា ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន បញ្ចេញ ទស្សន របស់ ខ្លួន លើ Facebook ដោយ បាន ចាត់ទុក អំពើ ប្រមាថ ព្រះចេស្តា អង្គ ព្រះមហាក្សត្រ របស់ ទណ្ឌិត និង ជន ក្បត់ ជាតិ សម រង្ស៊ី មិន ត្រឹមតែ ជា ការបង្ហាញ ពី សីលធម៌ បែប អនាថា របស់ ខ្លួន ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែមទាំង ជា ការបើក ដៃ ឲ្យ បរទេស មាក់ងាយ មក លើ កិត្តិយស ជាតិ ថែម ទៀត ផង ។
លោក ហ៊ុន ម៉ានី បាន ចាត់ទុក វិធីសាស្ត្រ របស់ លោក សម រង្ស៊ី ដើម្បី កុំ ឲ្យ មហាជន ជន បំភ្លេច ខ្លួន តាមរយៈ ការប្រមាថ ព្រះមហាក្សត្រ គឺជា វិធីសាស្ត្រ បែប កខ្វក់ និង គ្មាន ការទទួលខុសត្រូវ ហើយ លោក បាន ស្នើឲ្យ ទណ្ឌិត សម រង្ស៊ី បញ្ឈប់ ជាបន្ទាន់ នូវ អំពី អសីលធម៌ បែប នេះ ។
លោក ហ៊ុន ម៉ានី បាន សរសេរ យ៉ាង ដូច្នេះ ថា « ការយក ប្រយោជន៍ និង និមិត្តរូប ជាតិ មក ជាន់ ឈ្លី ដើម្បី ម ប្រើ នូវ មហិច្ចតា ផ្ទាល់ខ្លួន បែប បំផ្លិចបំផ្លាញ ជាតិ ជា ទង្វើ ដែល មិន អាច អត់ ឱន ឲ្យបាន ជាដាច់ខាត ។ ការប្រមាថ លើ ព្រះចេស្តា អង្គ ព្រះមហាក្សត្រ តាម រយ : ការប្រើប្រាស់ ពាក្យពេចន៍ បែប អសីលធម៌ របស់ លោក សម រង្សី មិន ត្រឹមតែ ជា ការបង្ហាញ ពី សីលធម៌ បែប អនាថា របស់ ខ្លួន ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែមទាំង ជា ការបើក ដៃ ឲ្យ បរទេស ផ្តើម មាក់ងាយ មក លើ កិត្តិយស ជាតិ របស់ យើង ។
លោក បញ្ជាក់ ទៀត ថា « ពិត ណាស់ វិធីសាស្រ្ត នៃ ការធ្វើអោយ មហាជន កុំ អោយ បំភ្លេច ខ្លួន នៅ មាន ច្រើន ទៀត ដូច្នេះ សូម លោក បញ្ឈប់ នូវ វិធីសាស្រ្ត បែប កខ្វក់ និង គ្មាន ការទទួលខុសត្រូវ នេះ ជាបន្ទាន់ ។ ទង្វើ របៀប លោក នេះ ហើយ ដែល ធ្វើអោយ ប្រទេស កម្ពុជា យើង បាត់បង់ មុខមាត់ និង ផលប្រយោជន៌ ដែល លោក ផ្ទាល់ មិន ដែល ចេះ ទទួលខុសត្រូវ ម្តង ណា ឡើយ » ។
១៖ ព្រះបរម រាជ វាំង ចេញ សេចក្តីថ្លែងការណ៍ ថ្កោល ទោស ដាច់ អហង្កា ចំពោះ ជន ក្បត់ ជាតិ សម រង្ស៉ី ដែល ហ៊ាន ប្រមាថ ព្រះកិត្តិនាម ព្រះមហាក្សត្រ ( ចុច អាន )
២៖ រដ្ឋមន្រ្តី ក្រសួង យុត្តិធម៌ ចេញ អធិបញ្ជា ឱ្យ អយ្យការ អម សាលាដំបូង រាជធានី ភ្នំពេញ ចាត់ការ តាម ផ្លូវ ច្បាប់ ជាបន្ទាន់ និង តឹងរឹង បំផុត ចំពោះ ទង្វើ ទណ្ឌិត សម រង្ស៊ី ប្រមាថ អង្គ ព្រះមហាក្សត្រ ( ចុច អាន )
៣៖ ក្រុម មេធាវី រាជ រដ្ឋាភិបាល ស្នើ ដល់ ស្ថាប័ន មាន សមត្ថកិច្ច និង តុលាការ គ្រប់ ជាន់ ថ្នាក់ ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ឲ្យ ធ្ងន់ធ្ងរ បំផុត លើ ទណ្ឌិត សម រង្ស៊ី ដែល ប្រមាថ អង្គ ព្រះមហាក្សត្រ ( ចុច អាន )
៤៖ ទីបំផុត ព្រះរាជអាជ្ញា សម្រេច ចោទប្រកាន់ និង ស្នើសុំ ឲ្យ ឃុំ ខ្លួន សម រង្ស៉ី ជា បណ្តោះអាសន្ន ពី បទ ប្រមាថ អង្គ ព្រះមហាក្សត្រ ( ចុច អាន )
៥៖ ប្រធាន គណបក្ស ពេជ្រ ស្រស់៖ ទណ្ឌិត សម រង្ស៉ី មាន នយោបាយ ទុចរិត . អ្នក ប្រមាថ ព្រះមហាក្សត្រ មាន តែ ពួក ក្បត់ ជាតិ ប្លន់ រាជ បល្ល័ង្ក តែ ប៉ុណ្ណោះ ( ចុច អាន )
៦៖ ជន ក្បត់ ជាតិ សម រង្ស៉ី ពិតជា ថ្លើម ធំ ណាស់ ហ៊ាន ប្រមាថ ព្រះចេស្តា អង្គ ព្រះមហាក្សត្រ ដែល ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ ប្រជារាស្រ្ត ខ្មែរ ( ចុច អាន )
៨៖ នាយក រដ្ឋមន្រ្តី ឡាវ លោក ថង លូន ស៊ី ស៊ូលីត បាន អញ្ជើញ ចាកចេញ ពី ប្រទេស កម្ពុជា ក្រោយ បញ្ចប់ ទស្សនកិច្ច ដោយ ជោគជ័យ រយៈពេល ២ ថ្ងៃ ( ចុច អាន )
៩៖ នាយក រដ្ឋមន្រ្តី ឡាវ ប្រាប់ ប្រមុខរដ្ឋ ស្តីទី កម្ពុជា ថា ភាគី ទាំង ពីរ នឹង ខិតខំ ធ្វើឱ្យ ព្រំដែន កម្ពុជា - ឡាវ មាន សន្តិភាព មិត្តភាព និង ការអភិវឌ្ឍ ( ចុច អាន )
១០៖ ព័ត៌មាន លម្អិត ស្តីពី ដំណើរទស្សនកិច្ច របស់ នាយក រដ្ឋមន្រ្តី ឡាវ ថង លូន ស៊ី ស៊ូលីត មកកាន់ កម្ពុជា រយៈពេល ២ ថ្ងៃ ( ចុច អាន )
១១៖ ក្រសួង បរិស្ថាន ជូនដំណឹង ម្ចាស់ អាជីវកម្ម លក់ វត្ថុអនុស្សាវរីយ៍ ២៧កន្លែង នៅ រាជធានី ភ្នំពេញ ដែល សង្ស័យ ថា លក់ដូរ គ្រឿងចម្លាក់ ធ្វើ ពី ភ្លុក ដំរី និង កុយ រមាស តម្រូវ ឱ្យ បញ្ឈប់ ជាបន្ទាន់ ( ចុច អាន )
១២៖ ទូត កម្ពុជា ប្រតិកម្ម នឹង ការចុះផ្សាយ របស់ សារព័ត៌មាន ទេសចរណ៍ ឥណ្ឌូនេស៊ី ដែល សរសេរ ខុស ធ្ងន់ធ្ងរ ថា « ប្រាសាទ អង្គរវត្ត ជា របស់ ថៃ » ( ចុច អាន )
១៣៖ ក្រសួង ធនធាន ទឹក៖ ភ្លៀង នឹង បន្ដ ធ្លាក់ នៅ ទូទាំង ប្រទេស រហូតដល់ ថ្ងៃទី ១៩ ខែកញ្ញា ដោយសារ រង ឥទ្ធិពល សម្ពាធ ទាប ( ចុច អាន )
១៥៖ លោក ហេង ឡុង សម្រេច ដាក់ពាក្យបណ្ដឹង ជា ផ្លូវការ ទៅ សមត្ថកិច្ច កូរ៉េ ប្ដឹង អ្នក លួច ថត វីដេអូ និង បង្ហោះ តាម បណ្ដាញ សង្គម ដោយ គ្មាន ការអនុញ្ញាត ( ចុច អាន )
៣៖ ជប៉ុន ដាក់ពាក្យ តវ៉ា ក្រោយ ទូក បំពាក់ កាំភ្លើង របស់ កូរ៉េ ខាងជើង បើក ចូលមកកាន់ ដែន សមុទ្រ ជា កម្មសិទ្ធិ ជប៉ុន ( ចុច អាន )
៧៖ រុស្ស៊ី គំរាម ពី សង្គ្រាម នុយក្លេអ៊ែរ ផ្ទុះឡើង បើសិនជា សន្ធិសញ្ញា នុយក្លេអ៊ែរ ជាមួយ អាមេរិក ត្រូវ ស្លាប់ បាត់ មួយ ទៀត ( ចុច អាន )
៨៖ អ៊ីស្រាអែល ទាត់ ចោល របាយការណ៍ ដែល ថា ខ្លួន កំពុង លួច ស៊ើបការណ៍ លើ សហរដ្ឋ អាមេរិក ( ចុច អាន )
( ភ្នំពេញ ) ៖ រហូតមកដល់ ល្ងាច ថ្ងៃទី ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ មាន រយៈពេល ៦ ថ្ងៃ ហើយ ក្រុមការងារ ជួយសង្គ្រោះ នៅ មិន អាច អូស សាឡង់ ដែល បុក គឿង ជាប់ សសរ ស្ពាន ព្រែក តា មាក់ បាន នោះ ទេ បើ ទោះបី ប្រើ ស្ទើរ គ្រប់ មធ្យោបាយ យ៉ាងណា ក្ដី ។ សម្រាប់ ប្រតិបត្តិការ នៅ ថ្ងៃ នេះ ក្រុមការងារ ក្រោម ការបញ្ជា ពី លោក ទេសរដ្ឋមន្រ្តី ស៊ុន ចាន់ថុល បាន ប្រើប្រាស់ នាវា ទាញ អូស និង បុក ដើម្បី ជំនួយ បន្ថែម នៅតែ មិន បាន ជោគជ័យ ។
សេចក្ដីរាយការណ៍ ពី កន្លែង កើត ហេតុ បាន អះអាង ថា តាំងពី ថ្ងៃ កើត ហេតុ រហូតមកដល់ ថ្ងៃទី ១៣ ខែកញ្ញា នេះ សមត្ថកិច្ច មក ពី គ្រប់ ស្ថាប័ន បាន រួម ដៃ គ្នា និង ប្រើ ស្ទើរ គ្រប់ មធ្យោបាយ ដើម្បី អូស សាឡង់ ដឹក ខ្សាច់ នោះ ចេញ ពី កន្លែង ដែល គៀប ជាប់ ប៉ុន្ដែ មិន ទាន់ ទទួលបាន ជោគជ័យ នៅឡើយ ទេ ពោល គ្រាន់តែ រង្គើរ ក្បាល បន្ដិច ប៉ុណ្ណោះ ហើយ ឧបសគ្គ ធំ បំផុត ក្នុង ប្រតិបត្តិការ នេះ គឺ បណ្ដាល មកពី កម្លាំង ទឹក ហូរ ខ្លាំង ។
បើ តាម សេចក្ដីរាយការណ៍ ក្រុមហ៊ុន សៀង ហៃ ដែល ជា ក្រុមហ៊ុន ទទួលបាន សិទ្ធិ សាងសង់ ស្ពាន ព្រែក តា មាក់ ក៏ បាន ចុះ មកដល់ កន្លែង កើត ហេតុ ផងដែរ ដើម្បី ចូលរួម ពិនិត្យ ស្ថានភាព ជាក់ស្ដែង ជាមួយ សមត្ថកិច្ច របស់ កម្ពុជា ។ ក្នុង នោះ ក្រុមហ៊ុន ក៏ បាន អះអាង ដែរ ថា ចំពោះ សាឡង់ ដែល បុក គឿង នេះ មិន បង្ក ការប៉ះពាល់ ដល់ គុណភាព ស្ពាន នោះ ទេ ដូច្នេះ មិន មាន អ្វី គួរឲ្យ ព្រួយ បារម្ភ ខ្លាំង នោះ ឡើយ ។
សូម ជម្រាប ថា ប្រតិបត្តិការ ជួយសង្គ្រោះ នេះ ក្រុមការងារ បច្ចេកទេស ដែល មាន ខាង ក្រសួង ពាក់ព័ន្ធ និង អ្នកជំនាញ មក ពី កំពង់ផែ ស្វយ័ត ភ្នំពេញ ដឹកនាំ ដោយ លោក ទេសរដ្ឋមន្ដ្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ដ្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ។
កាលពី រសៀល ថ្ងៃទី ០៧ ខែកញ្ញា ឆ្នាំ ២០១៩ មាន សាឡង់ ដឹក ខ្សាច់ មួយ គ្រឿង បាន បើក និង ទៅជាប់គាំង ជាមួយ សសរ ស្ពាន ព្រែក តា មាក់ ( សសរ ទី៣ ) បណ្តាលឲ្យ គាប ជាប់ នៅនឹង សសរ ស្ពាន ទី៣ ស្ពាន ព្រែក តា ម៉ាក់ តែម្តង ។ ភ្លាម ៗ ក្រោយ ទទួលបាន ព័ត៌មាន អភិបាល ខេត្ត កណ្តាល លោក ម៉ៅ ភិរុណ បាន ចុះ ទៅ ជួយ អន្តរាគមន៍ ដើម្បី រក មធ្យោបាយ ទាញ ក្បាល សាឡង់ ដឹក ខ្សាច់ នេះ ចេញ ពី សសរ ស្ពាន ។
សេចក្តីថ្លែងការណ៍ របស់ អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ បាន បញ្ជាក់ ថា កាលពី យប់ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ ទណ្ឌិត សម រង្ស៉ី បាន ផ្តល់ កិច្ចសម្ភាសន៍ យ៉ាង គឃ្លើន ដល់ វិទ្យុ អាស៊ី សេរី ដែល បាន ធ្វើឱ្យ ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ ព្រះកិត្តិនាម ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ដែល ជា និមិត្តរូប នៃ ឯកភាព ជាតិ និង និរន្តរភាពជាតិ ។
