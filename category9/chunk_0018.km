( កំពង់ចាម ) ៖ មន្ដ្រី នគរបាល ចំនួន ១៥៧ នាក់ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពង់ចាម ត្រូវបាន ប្រកាស ផ្ទេរ ភារកិច្ច តែងតាំង មុខ តំណែង និង បំពាក់ ឋានន្តរសក្តិ ។ ពិធី នេះ ត្រូវបាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ក្រោម អធិបតីភាព លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល ស្នងការ នគរបាល ខេត្ត កំពង់ចាម ។
ក្នុង ពិធី នេះ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី លោក លោកស្រី ស្នងការ រង លោក អនុប្រធាន ផែន លោក លោកស្រី នាយ នាយ រង ការិយាល័យ លោក អធិការ ស្រុក ក្រុង ទាំង១០ សរុប អ្នកចូលរួម ចំនួន ២៥០ នាក់ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ទោ ឯ ម កុសល បាន ជំរុញ ឲ្យ មន្ដ្រី នគរបាល ទាំងអស់ ត្រូវ បង្កើន ការយកចិត្តទុកដាក់ លើ ការងារ ត្រូវ ទទួលខុសត្រូវ សម្រាប់ ការអនុវត្ត តាម តួនាទី និង ភារកិច្ច ត្រូវ ចេះ ស្មោះត្រង់ ចំពោះ ប្រជាពលរដ្ឋ និង ឆ្លើយតប ធ្វើអន្តរាគមន៍ ទាន់ ពេល វេលា ។
បន្ថែម ពី នេះ លោក ឧត្តមសេនីយ៍ ស្នងការ ក៏ បាន ធ្វើ ការផ្ដាំផ្ញើ ជូន មន្រ្តី បន្ត វេន ខិតខំ ពង្រឹង និង បន្ត អនុវត្ត យ៉ាង មឹង ម៉ាត់ ចំពោះ វិន័យ ០០៦ របស់ កងកម្លាំង នគរបាល ជាតិ បង្កើន សមត្ថភាព ថ្មី ៗ ដើម្បី បំពេញ ការងារ ក្នុង អង្គភាព ឲ្យបាន ល្អ ប្រសើរ ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ។
ដើម្បី ឆ្លើយតប នូវ ទឹកចិត្ត ដ៏ ប្រពៃ ថ្លៃថ្លា និង សកម្មភាព ដ៏ ល្អ ដុង ឧត្តម របស់ ថ្នាក់ លើ លោក វរសេនីយ៍ ទោ អឿ សុភា បាន ធ្វើ ការប្ដេជ្ញាចិត្ត និង សូម សន្យា ដូច ខាងក្រោម៖
( ពិភពលោក ) ៖ នៅ ថ្ងៃចន្ទ ទី០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
៣៖ ក្រសួង មហាផ្ទៃ នឹង ចុះ MoU ជាមួយ សភា ពាណិជ្ជកម្ម អឺរ៉ុប នៅ កម្ពុជា លើ ការប្រការ ប្រយុទ្ធ ប្រឆាំង ការនាំចូល ផលិតផល ក្លែងក្លាយ ( ចុច អាន )
៤៖ ព័ត៌មាន លម្អិត នៃ ដំណើរទស្សនកិច្ច របស់ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន នៅ ទីក្រុង ប៉េកាំង ប្រទេស ចិន រយៈពេល ៣ ថ្ងៃ ( ចុច អាន )
៥៖ ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល៖ ផ្លូវ ៣៦ ខ្សែ ស្មើនឹង ៦០ គីឡូម៉ែត្រ រង ផល ប៉ះពាល់ ខូចខាត ដោយសារ ជំនន់ ទន្លេ មេគង្គ និង ទឹកភ្លៀង ( ចុច អាន )
៧៖ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន បង្ហាញ ក្តី រំពឹង ថា អភិបាល ខេត្ត ព្រះសីហនុ និង ប្រជាពលរដ្ឋ នឹង រួមគ្នា លើក សម្រស់ ក្រុង ព្រះសីហនុ ឡើងវិញ ( ចុច អាន )
៩៖ ក្រសួង ធនធាន ទឹក អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ បង្កើន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ បាតុភូត ផ្គរ រន្ទះ និង ខ្យល់ កន្ត្រាក់ ខណៈ កម្ពុជា នឹង ភ្លៀង ធ្លាក់ ច្រើន ចាប់ពី ថ្ងៃ នេះ ដល់ ថ្ងៃ ១៥ ខែកញ្ញា ( ចុច អាន )
១៖ លោក ដូណាល់ ត្រាំ លុបចោល កិច្ចចរចា ស្វែងរក សន្តិភាព ជាមួយ ពួក តាលី បង់ ដោយសារ ការបំផ្ទុះ គ្រាប់បែក នៅ ទីក្រុង កាប៊ុល ( ចុច អាន )
២៖ ក្រុម បាតុករ ចង់ឲ្យ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ ទៅ រំដោះ ទីក្រុង ហុងកុង ( ចុច អាន )
៧៖ ស្តេច អារ៉ាប៊ី សាអូឌីត ដក តំណែង រដ្ឋមន្រ្តី ថាមពល ហើយ តែងតាំង ព្រះបុត្រា ឲ្យ ឡើង ជំនួស ( ចុច អាន )
៨៖ ជនជាតិ ជប៉ុន ម្នាក់ ស្លាប់ និង ៣០ នាក់ រងរបួស ដោយសារ ព្យុះ ទីហ្វុង វាយលុក ទីក្រុង តូក្យូ ( ចុច អាន )
១០៖ សង្គ្រាម បង្ហូរ ឈាម គ្នា ឯង នៅ លីប៊ី៖ កងទ័ព ទ្រី ប៉ូលី ចាប់ផ្តើម បណ្តេញ ទ័ព លីប៊ី ខាងកើត ឲ្យ ចេញ ពី តំបន់ ភាគ ខាងត្បូង ទីក្រុង វិញ ( ចុច អាន )
កាន់តែ ងាយស្រួល គ្រប់ ពេលវេលា គ្រប់ ទីកន្លែង តាមរយៈ សេវា ធនាគារ ចល័ត ប្រាសាក់
លោក សាយ សូនី នាយក ប្រតិបត្តិ គ្រប់គ្រង ទីផ្សារ របស់ ប្រាសាក់ បាន ឱ្យដឹង ថា សេវា ធនាគារ ចល័ត ប្រាសាក់ រចនា ឡើង ដោយ បច្ចេកវិទ្យា កម្រិត ខ្ពស់ បំផុត ដែល ធានា បាន សុវត្ថិភាព សម្រាប់ អតិថិជន អាច ធ្វើ ប្រតិបត្តិការ ចាត់ចែង សាច់ប្រាក់ តាមរយៈ ការប្រើ ទូរស័ព្ទ ដៃ Tablet ឬ កុំព្យូទ័រ ។
ជាមួយ សេវា នេះ អតិថិជន អាច ពិនិត្យមើល សម តុល្យ និង របាយការណ៍ គណនី ផ្ទេរ ប្រាក់ ផ្ទេរ ប្រាក់ ទៅ អ្នក គ្មាន គណនី ពិនិត្យ អត្រា ប្តូរ ប្រាក់ និង បង់ ថ្លៃ ទឹក ថ្លៃ ភ្លើង ទិញ កាត ទូរស័ព្ទ គ្រប់គ្រង ប័ណ្ណ អេធី អឹម ដោយ ងាយស្រួល និង មិន គិត កម្រៃ សេវា បាន គ្រប់ ពេលវេលា គ្រប់ ទីកន្លែង ។
លោក សាយ សូនី បាន បន្ត ទៀត ថា ការប្រើប្រាស់ សេវា ធនាគារ ចល័ត ប្រាសាក់ ជា ជំនួយ ដល់ អតិថិជន របស់ យើង ដែល មមាញឹក អាច ធ្វើ ប្រតិបត្តិការ បាន គ្រប់ ពេលវេលា គ្រប់ ទីកន្លែង ហើយ នេះ ក៏ បាន ឆ្លុះបញ្ចាំង ពី ភាពទាន់សម័យ របស់ អតិថិជន ក្នុង យុគសម័យ បច្ចេកវិទ្យា ដ៏ ទំនើប នេះ ។
នេះ គឺជា ការប្ដេជ្ញាចិត្ត របស់ ប្រាសាក់ ក្នុង ការនាំយក បទពិសោធន៍ ដ៏ អស្ចារ្យ និង មាន ភាពងាយស្រួល ជូន ដល់ អតិថិជន ដើម្បី រួមចំណែក ក្នុង ការជំរុញ បរិយាប័ន្ន ហិរញ្ញវត្ថុ នៅ កម្ពុជា ។
មន្ត្រី ចិន៖ ក្បាច់គុន ថៃ ជី និង យូហ្កា ពេញនិយម បំផុត នៅ ចិន ឥណ្ឌា និង ប្រទេស មួយចំនួន ទៀត លើ ពិភពលោក
មន្ត្រី ជាន់ ខ្ពស់ របស់ ចិន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ចិន និង ឥណ្ឌា គឺជា សមាជិក របស់ អង្គការ សហប្រតិបត្តិការ សៀង ហៃ ដូចគ្នា ។ ក្បាច់គុណ ថៃ ជី និង យូហ្កា គឺជា កីឡា មួយ ប្រភេទ កំពុងតែ ពេញនិយម បំផុត និង ជា កម្មវិធី ហាត់ប្រាណ សមរម្យ មួយ សម្រាប់ ប្រជាជន ចិន ប្រជាជន ឥណ្ឌា និង ប្រជាជន នៃ បណ្ដា ប្រទេស មួយចំនួន ទៀត លើ ពិភពលោក នេះ » ។
លោកស្រី បន្ត ថា កីឡា ទាំង ពីរ ប្រភេទ នេះ ជួយ សម្រួល ដល់ អ្នក ហាត់ ទាំងឡាយ ឲ្យ មាន អារម្មណ៍ ល្អ និង មាន ភាព ស្ងប់ សុខ ទាំង ផ្លូវកាយ និង ផ្លូវចិត្ត ។ ពួកវា មិន ត្រឹមតែ ជា កីឡា ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែមទាំង ជា ការសង្ខេបម នៃ ទស្សនវិជ្ជា របស់ ជីវិត មនុស្ស និង ការធ្វើឱ្យ មាន ភាព កាន់តែ ប្រសើរឡើង ផ្នែក ប្រាជ្ញា ស្មារតី ។
រីឯ SCO ក៏ ត្រូវបាន ប្រកាស ឡើង ដោយ ក តិកាសញ្ញា មួយ នៅ ឆ្នាំ ២០០១ ក្រោម គំនិត ផ្តួចផ្ដើម របស់ លោក ស៉ី ជិន ពីង ដដែល និង ត្រូវបាន ចុះហត្ថលេខា នៅ ឆ្នាំ ២០០២ ហើយ ត្រូវបាន ចូល ជាធរមាន នៅ ឆ្នាំ ២០០៣ ។
( ភ្នំពេញ ) ៖ ទស្សនិកជន ចូលរួម ទស្សនា ផ្ទាល់ បាល់ទាត់ មួយចំនួន ប្រហែលជា មិន បាន ដឹង ទេ ថា រាល់ ការប្រកួត បាល់ទាត់ មិត្តភាព រវាង ក្រុម គោ ព្រៃ ជាមួយនិង ក្រុម បរទេស ភេសជ្ជៈ ប៉ូវ កម្លាំង វើក តែងតែ ផ្តល់ នូវ ភាពសប្បាយរីករាយ បន្ថែម និង វត្ថុអនុស្សាវរីយ៍ នៅ ស្តង់ ភេសជ្ជៈ របស់ ខ្លួន ដោយ ឥត គិត ថ្លៃ សម្រាប់ អ្នកចូលរួម លេង ល្បែង កម្សាន្ត ជាមួយ វិញ្ញាសារ ផ្សេង ៗ របស់ ក្រុមហ៊ុន ដូចជា ការលេង ត្រិះ បាល់ និង បង្វិល កង ជាដើម ។
លោកស្រី គង់ កុសល តំណាង អោយ ក្រុមហ៊ុន ខ្មែរ ប៊ែ វើរី ជីស ក៏ សូម លើកទឹកចិត្ត អ្នកគាំទ្រ បាល់ទាត់ ទាំងអស់ គ្នា គួរតែ បាន ទៅ ទស្សនា និង ចូលរួម លេង កម្សាន្ត នៅ ទីនោះ នៅ ថ្ងៃទី ១០កញ្ញា ស្អែក នេះ ដែល កម្ពុជា នឹង ប្រកួត ជាមួយ ក្រុម ជម្រើសជាតិ បារ៉ែ ន ហើយ ម្យ៉ាង វិញ ទៀត យើង បាន ត្រៀម អាវយឺត មួក និង កាដូ ផ្សេង ទៀត ជាច្រើន សម្រាប់ អ្នកចូលរួម ទាំងអស់ គ្នា ផងដែរ ៕ គម្រោង បុរី តម្លៃ សមរម្យ ថ្មី មួយ ទៀត ផុស ឡើង នៅលើ ទឹកដី ស្រុក អង្គស្នួល ខេត្ត កណ្តាល
( កណ្តាល ) ៖ ដោយ មើលឃើញ ពី កំណើន ប្រជាជន មក រស់ នៅ ទីក្រុង ភ្នំពេញ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ មាន ការកើនឡើង និង សន្ទុះ សេដ្ឋកិច្ច នៅ កម្ពុជា កាន់តែ រីកចំរើន ក្រោម ការដឹកនាំ ពី ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រុមហ៊ុន បុរី អេច អឹម អមតៈ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ធ្វើ កាធ្វើ ការបើក លក់ គម្រោង បុរី ទី ០១ របស់ ខ្លួន ចំនួន ២.០០០ល្វែង លើ ផ្ទៃ ២០ ហិកតា ស្ថិត នៅលើ ទី ដី ភូមិ ព្រៃ ខ្លា ស្រុក អង្គស្នួល ខេត្ត កណ្ដាល ជាមួយនឹង ការផ្តល់ ជូន អតិថិជន ក្នុង តម្លៃ មួយ ដែល សមរម្យ ផងដែរ ។
លោក ផាក់ សំផេង ជំទប់ ទី ០១ ឃុំ ក្រាំងម្កាក់ ស្រុក អង្គស្នួល ខេត្ត កណ្ដាល បាន ឱ្យដឹង ដែរ ថា លោក ពិតជា មានអារម្មណ៍ សប្បាយរីករាយ ដែល ក្រុមហ៊ុន បុរី អេច អឹម អមតៈ បាន ចុះ មក អភិវឌ្ឍន៍ សំណង់ លំនៅដ្ឋាន នៅក្នុង មូលដ្ឋាន របស់ គាត់ ពោលគឺ បាន ប្រែក្លាយ ទីតាំង មួយ ដែល ជា ទីកន្លែង បង្កបង្កើន ផល ឱ្យ ក្លាយជា ទីប្រជុំជន ដែល មាន ផ្ទះល្វែង សួនច្បារ បង្គោល ភ្លើង បំភ្លឺ ផ្លូវ និង ហេដ្ឋារចនាសម្ព័ន្ធ នានា ល្អ ស្អាត បែប នេះ ។
ចិន ព្រមាន បរទេស កុំ លូក ដៃ ឲ្យ សោះ ក្រោយ ក្រុម បាតុករ សម្រុក ទៅ មុខ កុងស៊ុល អាមេរិក និង ស្នើឲ្យ លោក ត្រាំ ជួយ រំដោះ ហុងកុង
( ហុងកុង) ៖ រដ្ឋាភិបាល ទីក្រុង ហុងកុង បាន ចេញមុខ ព្រមាន ទៅនឹង ការលូក ដៃ ចូល អន្តរាគមន៍ ពី បរទេស ក្រោយ ក្រុម បាតុករ ទើបតែ នាំគ្នា ដង្ហែរ ក្បួន តវ៉ា ទៅដល់ ស្ថាន កុងស៊ុល អាមេរិក និង ប្រកូកប្រកាស សុំ ការជួយជ្រោមជ្រែង ពី ទីក្រុង វ៉ាស៊ីនតោន ។ នេះ បើ តាម ការដកស្រង់ ការផ្សាយ ចេញ ពី សារព័ត៌មាន CNA នៅ ល្ងាច ថ្ងៃចន្ទ ទី០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ ។
នា ថ្ងៃចន្ទ នេះ អ្នកនាំពាក្យ រដ្ឋបាល ពិសេស ហុងកុង បាន ព្រមាន ប្រឆាំង ចំពោះ ការចង់ លូក ដៃ ពី បរទេស មក ក្នុង បញ្ហា ក្រុង ហុងកុង ខណៈ កាលពី ថ្ងៃអាទិត្យ ក្រុម បាតុករ បាន ប្រមូលផ្តុំ គ្នា នៅ ពីមុខ ស្ថាន កុងស៊ុល អាមេរិក ប្រចាំ ហុងកុង ដើម្បី គាំទ្រ ឲ្យ សភា អាមេរិក អនុម័ត ច្បាប់ មួយ ពាក់ព័ន្ធ បញ្ហា សិទ្ធិ មនុស្ស នៅ ទីក្រុង ហុងកុង និង បាន ស្នើឲ្យ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ មក ជួយ រំដោះ ទីក្រុង ស្វយ័ត របស់ ចិន នេះ ថែម ទៀត ផង ។
ជាមួយគ្នា នេះ រដ្ឋបាល ទីក្រុង ហុងកុង បាន ថ្កោលទោស ចំពោះ ទង្វើ លក្ខណៈ ជ្រុលនិយម របស់ ក្រុម បាតុករ ដែល បាន វាយ បំផ្លាញ ទ្រព្យសម្បត្តិ សាធារណៈ ដុត ភ្លើង និង បិទ ច្រកផ្លូវ នៅ ស្ថានីយ រថភ្លើង មួយ កន្លែង ផងដែរ កាលពី ម្សិលមិញ នេះ ដែល ជា សប្តាហ៍ ទី ១៤ហើយ នៃ ចលនា បាតុកម្ម នៅ ហុងកុង ។
គួរ ជម្រាប ថា ក្រោយពី ក្រុម បាតុករ បាន ទៅ ប្រកូកប្រកាស សុំ ការជួយជ្រោមជ្រែង ពី អាមេរិក ស្ថាប័ន សារព័ត៌មាន នៃ រដ្ឋាភិបាល ចិន នា ថ្ងៃចន្ទ នេះ បាន ព្រមាន ថា ទីក្រុង ហុងកុង គឺជា ដែនដី ដែល មិន អាច កាត់ផ្តាច់ បាន ជាដាច់ខាត របស់ ចិន ហើយ ចលា នា ចង់ បំបែក រដ្ឋ ក្នុង ទម្រង់ ណាមួយ នឹង កម្ទេចចោល ដោយ គ្មាន ការអត់ ឱន ឡើយ ៕
លោក ហេង សួរ អ្នកនាំពាក្យ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដែល បាន ដឹកនាំ គណៈប្រតិភូ ចូលរួម ប្រជុំ ប្រចាំ ឆ្នាំ លើក ទី ១៥ នៃ សន្និសីទ EPS នៅ ប្រទេស កូរ៉េ ជាមួយនឹង ប្រទេស ទាំង ១៥ ផ្សេង ទៀត នា ថ្មី ៗ នេះ បាន អះអាង ថា លក្ខណៈ ល្អ ប្រសើរ ជាង គេ របស់ កម្ពុជា ក្នុង ការផ្តល់ សេវា ទាំង នេះ មាន ដូច ជា៖
១៖ រយៈពេល ធ្លាក់ កិច្ចសន្យា រហូតដល់ ថ្ងៃ ចេញដំណើរ ដល់ កូរ៉េ តិច ជាង គេ គឺ ត្រឹម ៤១ ថ្ងៃ ក្នុង ខណៈពេល រយៈពេល មធ្យម នៃ ប្រទេស ផ្សេង ទៀត មាន ចំនួន ៤៨ ថ្ងៃ ។
២៖ អត្រា ពលករ ផ្លាស់ប្តូរ ថៅកែ ក្នុង រយៈពេល ៣ខែ ដំបូង ក្រោយពេល ចូល ធ្វើ ការ ទាប ជាង គេ ។
៣៖ អត្រា ពលករ រស់នៅ ខុស ច្បាប់ មាន ចំនួន តិច ជាង មធ្យម ភាគ ។
៥៖ មាន ប្រព័ន្ធ ប្រឡង តេស្ត សមត្ថភាព ភាសា កូរ៉េ តាម កុំព្យូទ័រ ធំ ជាង គេ ។
៦៖ មាន សេវា អម ពលករ រហូតដល់ និយោជក មក ទទួល ល្អ ដែល ជា ហេតុ ធ្វើឲ្យ និយោជក មិន ដែល អន់ចិត្ត ចំពោះ ការខកខាន ជើង យន្តហោះ ឬ វង្វេង យន្តហោះ ដូច ពលករ ប្រទេស មួយចំនួន ។
៨៖ មាន អត្រា ជោគជ័យ ក្នុង ជីវិត ខ្ពស់ ក្នុង ចំណោម ពលករ ដែល ចប់ កិច្ចសន្យា ការងារ ហើយ វិលត្រឡប់ ទៅដល់ កម្ពុជា វិញ ។
ជារៀងរាល់ ឆ្នាំ ប្រទេស កូរ៉េ ខាងត្បូង បាន អញ្ជើញ តំណាង ប្រទេស ទាំង ១៦ ដែល បាន បញ្ជូន ពលករ ទៅ ធ្វើការ នៅ ប្រទេស កូរ៉េ ប្រជុំ វាយតម្លៃ និង ផ្តល់ ពិន្ទុ ហើយ ប្រទេស ដែល មាន ពិន្ទុ ល្អ កូរ៉េ នឹង រក្សា ចំនូន កូតា ផ្ទុយទៅវិញ បើ ប្រទេស មាន ពិន្ទុ តិច គេ នឹង បន្ថយ កូតា ក្នុង ការទទួលយក ពលករ ពី ប្រទេស នោះ ជាដើម ។
របាយការណ៍ ដែល ផ្តល់ ដោយ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ឱ្យដឹង ថា គិត ត្រឹម ខែសីហា ឆ្នាំ ២០១៩ នេះ កម្ពុជា មាន ពលករ ប្រមាណ ៥៤. ៣១៩ នាក់ កំពុង ធ្វើ ការងារ នៅ ប្រទេស កូរ៉េ ខាងត្បូង ក្នុង នោះ មាន ស្រ្តី ១១. ៧២០ នាក់ ។ ពលករ ទាំងនោះ បញ្ជូន ថវិកា មកកាន់ គ្រួសារ នៅ ស្រុក កំណើត ក្នុង ប្រទេស កម្ពុជា ក្នុង ១ ឆ្នាំ ៗ ប្រមាណ ៥០០ លាន ដុល្លារ សហរដ្ឋ អាមេរិក ៕ លោក ហ៊ុន ម៉ានី អបអរសាទរ បេក្ខជន ប្រឡង បាក់ឌុប ដែល ទទួលបាន ជោគជ័យ និង លើកទឹកចិត្ត ឲ្យ អ្នក មិន ទទួល ជោគជ័យ ត្រូវ ខិតខំ បន្ថែម ទៀត
( ភ្នំពេញ ) ៖ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា នៅ ល្ងាច ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សារ អបអរសាទរ ដល់ បេក្ខជន ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ( បាក់ឌុប ) ឆ្នាំ ២០១៩ ដែល ទទួលបាន ជោគជ័យ សម្រាប់ ការប្រឡង ។
ជាមួយគ្នា នេះ លោក ហ៊ុន ម៉ានី ក៏ លើកទឹកចិត្ត ដល់ បេក្ខជន ដែល មិន ទាន់ ទទួលបាន ជោគជ័យ លើក នេះ ត្រូវតែ បន្ដ ខិតខំ ប្រឹងប្រែង បន្ថែម ទៀត សម្រាប់ ការប្រឡង លើក ក្រោយ និង ដើម្បី ទទួល ជោគជ័យ នៅ ថ្ងៃ ខាងមុខ ជា បន្ដ បន្ទាប់ ។
ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា រូប នេះ បាន បង្ហោះ សារ យ៉ាង ដូច្នេះ ថា « អបអរសាទរ ប្អូន ៗ ទាំងអស់ គ្នា ដែល ទទួលបាន លទ្ធផល គាប់ ប្រសើរ ក្នុង ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ ២០១៩ ។ លទ្ធផល ដែល ប្អូន ៗ ទទួលបាន នៅ ពេល នេះ បាន កើត ចេញ ពី ការខិតខំ ប្រឹងប្រែង ច្រើន ណាស់ ដែល ប្អូន បាន ពុះពារ ចេញ ពី ខ្លួន ឯង ផង ពី ការបង្ហាត់ បង្ហាញ របស់ លោកគ្រូ អ្នកគ្រូ ព្រមទាំង ការទំនុកបម្រុង ពីសំណាក់ លោក ពុក អ្នកម្តាយ អាណាព្យាបាល ផង ។
ជោគជ័យ ថ្ងៃ នេះ ជា ការចាប់ផ្តើម ជំហាន ថ្មី មួយ ទៀត សម្រាប់ អាជីព ការងារ និង វិជ្ជាជីវៈ របស់ ខ្លួន ។ ចាប់ពី ថ្ងៃ នេះ តទៅ ជាពិសេស ក្នុង បរិបទ សង្គម ស៊ីវីល័យ ដែល មាន ការវិវឌ្ឍ យ៉ាង ឆាប់រហ័ស ប្អូន ៗ គួរ បន្ត សិក្សា ស្វែងរក ចំណេះដឹង កម្រិត ឧត្តម សិក្សា និង ចាប់ យក ជំនាញ គោល មួយ សម្រាប់ គោលដៅ ជីវិត និង ដើម្បី ធ្វើ យ៉ាងណា ជា ចលករ ដ៏ មាន សក្តានុពល ហើយ ក្លាយទៅជា ប្រជាពលរដ្ឋ ឆ្នើម របស់ កម្ពុជា ។
ដោយឡែក ខ្ញុំ សូម លើកទឹកចិត្ត ដល់ ប្អូន ៗ ដែល មិន ទាន់ ទទួលបាន ជោគជ័យ នៅ ថ្ងៃ នេះ សូម ប្អូន ៗ ប្រឹងប្រែង ហាត់ ពត់ លត់ ដំខ្លួន បន្ថែម ដាក់ អាទិភាព លើ ការសិក្សា អោយ បាន ច្រើន សម្រាប់ ការប្រឡង លើក ក្រោយ និង ដើម្បី ទទួលបាន ជោគជ័យ នៅ ថ្ងៃ ខាងមុខ ជា បន្តបន្ទាប់ » ។
គួរ រំលឹក ថា ការប្រឡង បាក់ឌុប ដែល ប្រព្រឹត្តទៅ កាលពី ថ្ងៃទី ១៩ - ២០ ខែសីហា ឆ្នាំ ២០១៩ មាន មណ្ឌល ប្រឡង គ្រប់ រាជធានី ខេត្ត ចំនួន ២០២ មណ្ឌល បន្ទប់ ប្រឡង ៤. ៧២៤ បន្ទប់ និង បេក្ខជន ចុះឈ្មោះ ក្នុង បញ្ជី សរុប ១១៧០៤៣ នាក់ ។ បេក្ខជន អវត្តមាន ចំនួន ១៨៣៥ នាក់ ៕
រដ្ឋមន្រ្តី វង សូត ផ្ញើ សារ រំលែក ទុក្ខ ជូន គ្រួសារ សព ឧត្តមសេនីយ៍ ទោ ស៊ឹម តៃ ដែល ទទួលមរណភាព ក្នុង ជន្មាយុ ៦៣ ឆ្នាំ
( ភ្នំពេញ ) ៖ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ថ្នាក់ដឹកនាំ ព្រមទាំង មន្រ្តី រាជការ នៃ ក្រសួង នេះ ទាំងអស់ បាន ផ្ញើ សារ រំលែក មរណទុក្ខ ជូន គ្រួសារ សព ឧត្តមសេនីយ៍ ទោ ស៊ឹម តៃ នាយក ការិយាល័យ ចារកិច្ច នៃ ក្រសួង ការពារ ជាតិ ដែល ទទួលមរណភាព ដោយ រោគា ពាធ នា វេលា ម៉ោង ០២៖ ៥០នាទី រសៀល ថ្ងៃទី ០៨ ខែកញ្ញា ឆ្នាំ ២០១៩ ក្នុង ជន្មាយុ ៦៣ ឆ្នាំ ។
ក្នុង សារ រំលែក ទុក្ខ នេះ ដែរ លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន បង្ហាញ ក្តី សោក សង្រែង ថា មរណភាព របស់ ឧត្តមសេនីយ៍ ទោ ស៊ឹម តៃ នាយក ការិយាល័យ ចារកិច្ច នៃ ក្រសួង ការពារ ជាតិ គឺជា ការបាត់បង់ កុលបុត្រ មួយ រូប ដែល បាន បម្រើ ឧត្តម ប្រយោជន៍ ជាតិ សាសនា ព្រះមហាក្សត្រ ព្រមទាំង បាន ធ្វើ ពលីកម្ម សព្វ គ្រប់ បែបយ៉ាង ដើម្បី បុព្វហេតុ បម្រើ ប្រជាពលរដ្ឋ និង សង្គមជាតិ ដោយ ស្មោះសរ ។
រដ្ឋមន្រ្តី វង សូត ក៏ បាន សម្តែង នូវ សមាន ចិត្ត ដ៏ ក្រៀមក្រំ ចូលរួម រំលែក ទុក្ខ ដោយ ក្តី សោកស្តាយ អាឡោះអាល័យ បំផុត ជាមួយ ឧត្តមសេនីយ៍ ទោ ស៊ឹម តៃ ព្រមទាំង ក្រុមគ្រួសារ និង សូម បួងសួង ដល់ វត្ថុ ស័ក្តិសិទ្ធិ ក្នុង លោក និង តេជៈ បារមី នៃ ព្រះពុទ្ធ ព្រះធម៌ ព្រះសង្ឃ សូម តាម ជួយ បីបាច់ ថែរក្សា ដល់ ដួង វិញ្ញាណក្ខន្ធ របស់ ឧត្តមសេនីយ៍ ទោ ស៊ឹម តៃ ទៅកាន់ សុគតិភព ជានិច្ច និរន្តរ៍ ត រៀង ទៅ ៕
ទីផ្សារ ធានារ៉ាបរង អាយុជីវិត នៅ កម្ពុជា កំពុង រីកលូតលាស់ ខ្លាំង នា ពេល បច្ចុប្បន្ន ដោយសារ មាន ក្រុមហ៊ុន ជាច្រើន ចូលមក វិនិយោគ
( ភ្នំពេញ ) ៖ លោក យក់ ចំរើន ឬទ្ធិ អគ្គ នាយក ក្រុមហ៊ុន ធានារ៉ាបរង អាយុជីវិត ហ្វត តេ បាន ឲ្យដឹង ថា បច្ចុប្បន្ន នេះ ទីផ្សារ ធានារ៉ាបរង អាយុជីវិត នៅ កម្ពុជា កំពុង រីកលូតលាស់ ខ្លាំង ដោយសារតែ មាន ក្រុមហ៊ុន ធានារ៉ាបរង ចូលមក ច្រើន និង ជួយ ឲ្យ ទីផ្សារ មាន ការរី លូតលាស់ ។
លោក បន្ថែម ថា ជាក់ស្ដែង ក្រុមហ៊ុន ធានារ៉ាបរង អាយុជីវិត ហ្វត តេ មាន ធានារ៉ាបរង អាយុជីវិត ដែល មាន អាយុកាល ៦ខែ និង ធានារ៉ាបរង អាយុជីវិត ទូទៅ ដែល មាន អាយុកាល ២០ ជាង ឆ្នាំ ។
លោក យក់ ចំរើន ឬទ្ធិ បាន បញ្ជាក់ ថា « ទីផ្សារ ធានារ៉ាបរង មាន ការរីកលូតលាស់ ខ្លាំង ដោយសារ ក្រុមហ៊ុន រ៉ាប រង អាយុជីវិត ចូលមក ច្រើន ដែល ធ្វើឲ្យ ទីផ្សារ កាន់តែ រីកលូតលាស់ ហើយ សម្រាប់ ក្រុមហ៊ុន ធានារ៉ាបរង អាយុជីវិ ហ្វត តេ ក្នុង ឆ្នាំ នេះ នឹង អាច រក ចំណូល លើ ទីផ្សារ កម្ពុជា ទាំងមូល បាន ២៥០ លាន ដុល្លារ » ។
លោក យក់ ចំរើន ឬទ្ធិ បាន ឲ្យដឹង ថា ជា ប្រពៃណី របស់ ពលរដ្ឋ កម្ពុជា កន្លងមក ពេល មាន ជំងឺ ម្ដង ៗ ពួកគាត់ តែងតែ លក់ ផ្ទះ . គោ ក្របី និង ទ្រព្យសម្បត្តិ ផ្សេង ៗ ដើម្បី ព្យាបាល ជំងឺ ធ្វើ យ៉ាងណា ឲ្យ តែ ជីវិត នៅ រស់ ហើយ នៅ ពេល ដែល ពួកគាត់ លក់ ទៅ ប្រើប្រាស់ សម្រាប់ ព្យាបាល និង ចាយវាយ ពេល មាន ជំងឺ អស់ គាត់ នឹង ចាប់ផ្ដើម ជាថ្មី ជាមួយ បាត ដទៃ ទទេ ។
លោក បន្ថែម ថា ដោយ ឃើញ នូវ ទិដ្ឋភាព បែប នេះ ក្នុង នាមជា អ្នកធ្វើ ការងារ ក្នុង វិស័យ ធានារ៉ាប់រង មិន ចង់អោយ មាន ទិដ្ឋភាព បែប នេះ កើត មាន ឡើង នៅក្នុង ស្រុក ខ្មែរ ទៀត ទើប ក្រុមហ៊ុន ហ្វត តេ សហការ ជាមួយ ក្រុមហ៊ុន ធានារ៉ាប់រង ក្រៅ ប្រទេស នាំយក នូវ ប័ណ្ណ សន្យា ធានារ៉ាប់រង ថ្មី ដែល អាច ការពារ សុខភាព ពលរដ្ឋ កម្ពុជា បាន យ៉ាង មាន ប្រសិទ្ធភាព និង អាច ទៅ ព្យាបាល ជាមួយ មន្ទីរពេទ្យ ល្បី ៗ នៅលើ ពិភពលោក ដែល ជា ដៃគូរ របស់ ខ្លួន ។
លោកស្រី បញ្ជាក់ ថា ក្រៅពី បង្កើត ផលិតផល ធានារ៉ាប់រង ថ្មី Further ក៏ មាន ការផ្ដល់ជូន សេវាកម្ម ពាក់ព័ន្ធ ដទៃ ទៀត រាប់ ចាប់តាំងពី ការចំណាយ លើ ថ្លៃ ព្យាបាល រហូតដល់ ការណាត់ជួប ជាមួយ គ្រូពេទ្យ ការធ្វើដំណើរ និង ការស្នាក់ នៅ ថែម ទៀត ។ បន្ថែម ពី នេះ ក្រុមហ៊ុន ក៏ ផ្ដល់ជូន អ្នកបកប្រែ និង សេវា ប្រែ ជូន សម្រាប់ ជា របាយការណ៍ នៃ ការព្យាបាល ផងដែរ ៕ ទឹក ទន្លេ មេគង្គ នៅ ខេត្ត ត្បូងឃ្មុំ ហក់ ឡើង លើស កម្រិត ប្រកាស អាសន្ន . ថ្ងៃ នេះ អភិបាល ខេត្ត ចុះ អន្តរាគមន៍ និង ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ
( ត្បូងឃ្មុំ ) ៖ គ្រា ដែល ទឹក ជំនន់ ទន្លេ មេគង្គ នៅ ខេត្ត ត្បូងឃ្មុំ បន្ត ហក់ ឡើង លើស កម្រិត ប្រកាស អាសន្ន ដែល បណ្ដាលឱ្យ ប៉ះពាល់ ដល់ ការរស់នៅ និង សុខ សុវត្ថិភាព ប្រជាពលរដ្ឋ នោះ នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ លោក ជា ម ច័ន្ទ សោភ័ណ និង លោកស្រី បាន បន្ត ដឹកនាំ ក្រុមការងារ មន្ទីរ អង្គភាព និង អាជ្ញាធរ ស្រុក ចុះ ពិនិត្យមើល ស្ថានភាព ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅក្នុង ស្រុក តំបែរ ។
ជាមួយ ការចុះ តាម មើក ស្ថានភាព ការលិចលង់ និង សួរសុខទុក្ខ ពលរដ្ឋ នោះ លោក បាន ចែកជូន នូវ ម៉ុង នំ ចំណី ព្រមទាំង ថវិការ ដើម្បី ជួយ សម្រួល តម្រូវការ ចំពោះ មុខ របស់ បងប្អូន ផងដែរ ។
( ព្រៃវែង ) ៖ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ប្រមាណ ជិត ៥០០ នាក់ បាន ធ្វើដំណើរ ទៅកាន់ ទឹកដី ស្រុក ព្រះស្តេច ខេត្ត ព្រៃវែង ដើម្បី ធ្វើ ការងារ មនុស្សធម៌ ដូច សព្វ ដង ដោយ ពិនិត្យ ព្យាបាល ជូន ប្រជាពលរដ្ឋ និង ចែកជូន ថ្នាំ ពេទ្យ ដោយ មិន គិត ថ្លៃ សម្រាប់ ការងារ មនុស្សធម៌ នេះ ត្រូវបាន ប្រជាពលរដ្ឋ ជិត ៥ពាន់ នាក់ ក្នុង ខេត្ត ត្បូងឃ្មុំ នោះ មាន ការកោត ស្ញប់ស្ញែង និង ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ លោក ហ៊ុន ម៉ានី ។
ប្រជាពលរដ្ឋ ម្នាក់ រស់ នៅ នៅ ស្រុក ព្រះសេ្តច ខេត្ត ព្រៃវែង បាន លើកឡើង ថា រូប គាត់ ពិតជា សប្បាយ ចិត្ត ពន់ពេក ដោយ បាន ឃើញ ក្រុម គ្រូពេទ្យ ស្ម័គ្រចិត្ត លោក ហ៊ុន ម៉ានី ចុះ មក ពិនិត្យ និង ព្យាបាល ថែមទាំង ផ្តល់ ជា អំណោយ ថ្នាំ ពេទ្យ ដោយ មិន គិត ថ្លៃ ទៀត នេះ ជា រឿង ដ៏ ល្អ សម្រាប់ ប្រជាពលរដ្ឋ ទាំងអស់ រួមទាំង រូប ខ្ញុំ ផ្ទាល់ ផងដែរ ។
រូប គាត់ បន្ត ទៀត ថា « ខ្ញុំ សូម សរសើរ ដល់ ក្រុម គ្រូពេទ្យ ទាំងអស់ ដោយ ម្នាក់ ៗ សុទ្ធតែ មាន ជំនាញ ច្បាស់លាស់ រួម នឹង សម្ភារ បច្ចេកទេស ត្រឹមត្រូវ ហើយ អាច ឆាប់ រក មុខជំងឺ របស់ ខ្ញុំ បាន លឿន ទៀតផង ។ ខ្ញុំ ចង់ឲ្យ ក្រុម គ្រូពេទ្យ ទាំងអស់ ឧស្សាហ៍ ចុះ មក បន្តិច ព្រោះ ការ ដែល គាត់ ចុះ មក នេះ គឺ ចំណេញ ខ្លាំង ណាស់ ដល់ ពលរដ្ឋ និង ខ្ញុំ ដោយ មិន អស់ លុយ និង ចំណេញ ពេលវេលា ថែម ទៀត » ។
សមាសភាព ទីប្រឹក្សា និង មេធាវី ដូច មាន រាយ នាម ខាងក្រោម៖
លោក ងួន ច័ន្ទ មុនី ទីប្រឹក្សា ជាន់ ខ្ពស់ លោក ជា សុភាព ទីប្រឹក្សា ជាន់ ខ្ពស់ លោក ឯ ម ច័ន្ទ មករា ទីប្រឹក្សា ជាន់ ខ្ពស់ លោក យឹម វិស្សុត ទីប្រឹក្សា និង ជា មេធាវី ប្រចាំ អង្គភាព លោក លី រដ្ឋ ធី ទីប្រឹក្សា និង ជា មេធាវី ប្រចាំ អង្គភាព លោក សេង ជ័យ វុធ ទីប្រឹក្សា លោក លឹម សុភ័ក្ត្រ ទីប្រឹក្សា លោក មាស គឹម សាន្ត ទីប្រឹក្សា លោក ហួរ ហួត ទីប្រឹក្សា លោក ហែម សុភក្ត្រ ទីប្រឹក្សា
នាយ ឧត្តមសេនីយ៍ ខ្វាន់ ស៊ាម ជំរុញ ឱ្យ នាយ ទាហាន ត្រូវ ប្រកាន់ភ្ជាប់ គុណធម៌ និង សីលធម៌ កុំ យក អំណាច ទៅ គំរាមកំហែង ដល់ ថ្នាក់ ក្រោម
ការលើកឡើង បែប នេះ របស់ នាយ ឧត្តមសេនីយ៍ ខ្វាន់ ស៊ាម បាន ធ្វើឡើង នៅ ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ នៅក្នុង ឱកាស ដែល នាយ ឧត្តមសេនីយ៍ បាន អញ្ជើញ ជា អធិបតីភាព ពិធី បើក វគ្គ ហ្វឹកហ្វឺន បំប៉ន ជំនាញ វិស្វកម្ម ឆ្នាំ ២០១៩ ស្ថិត នៅ ចោម ចៅ រាជធានី ភ្នំពេញ ដោយ មាន ការអញ្ជើញ ចូលរួម ពីសំណាក់ ឧត្តមសេនីយ៍ ឯក ឧត្តមសេនីយ៍ ទោ មេបញ្ជាការ រង បញ្ជាការដ្ឋាន វិស្វកម្ម ឧត្តមសេនីយ៍ នាយ រង សេនាធិការ ស្នងការ រង នាយ ការិយាល័យ មេបញ្ជាការ កង ឯកភាព និង នាយ ទាហាន នាយ ទាហាន រង ពល ទាហាន ជាច្រើន រូប ទៀត ។
ក្នុង ឱកាស នោះ នាយ ឧត្តមសេនីយ៍ ខ្វាន់ ស៊ាម បាន វាយតម្លៃ និង កោតសរសើរ ខ្ពស់ ចំពោះ ស្នាដៃ ដែល បញ្ជាការដ្ឋាន វិស្វកម្ម សម្រេចបាន កន្លងមក នាយ ឧត្តមសេនីយ៍ បាន ក្រើន រំឮក ដល់ នាយ ទាហាន នាយ ទាហាន រង ដែល បាន បំពាក់ ឋានន្តរស័ក្តិ ចំនួន ១. ២៤៤ នាក់ នៅ ពេល នេះ ដែល បាន ខិតខំ ប្រឹង បំពេញ តួនាទី របស់ ខ្លួន ដោយ មិន ខ្លាច នឿយហត់ ។
ជាមួយគ្នា នេះ ដែរ ឧត្តមសេនីយ៍ ទោ សឹង សុខ ន មេបញ្ជាការ រង បញ្ជាការដ្ឋាន វិស្វកម្ម បាន បញ្ជាក់ ថា ក្រោយពី អនុវត្ត ភារកិច្ច ជំនាញ វិស្វកម្ម នា រដូវ ប្រាំង តាម បណ្តា ការដ្ឋាន ទិស ខាងមុខ នៃ មាតុភូមិ រួច មក កង ឯកភាព នីមួយ ៗ បាន រួសរាន់ ប្រមូលផ្តុំ កម្លាំង និង មធ្យោបាយ គ្រឿង បំពាក់ ចូល ទីតាំង ដែល បាន កំណត់ ដើម្បី ធ្វើការថែទាំ ជួសជុល សម្រាប់ ត្រៀម អនុវត្ត ភារកិច្ច នៅ ដំណាក់កាល ខាងមុខ ទៀត និង ចាត់តាំង វគ្គ ហ្វឹកហ្វឺន បំប៉ន ទៅ តាម ជំនាញ ឯកទេស របស់ កង ឯកភាព នីមួយ ៗ ។
ក្នុង ខណៈ នោះ នាយ ឧត្តមសេនីយ៍ ក៏ បាន នាំយក នូវ អំណោយ ដ៏ ថ្លៃថ្លា របស់ ឧត្តមសេនីយ៍ ឯក ហ៊ុន ម៉ាណែត អគ្គ មេបញ្ជាការ រង ខ. ភ. ម មេបញ្ជាការ បញ្ជការ រដ្ឋាន កងទ័ព ជើងគោក រួម មាន៖ ភេសជ្ជៈ ចំនួន ៧០០ កេស គ្រាប់ ពូជ ចំនួន ១៨៧ កញ្ចប់ និង ២៨គ.ក្រ ជូន ដល់ បណ្តា កង ឯកភាព ចំណុះ បញ្ជាការដ្ឋាន វិស្វកម្ម ផងដែរ ៕
( កែប )៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា បាន តែងតាំង សមាសភាព ថ្នាក់ដឹកនាំ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កែប ចំនួន ៣៤ រូប នៃ អាណត្តិ ទី៥នេះ ដែល ធ្វើឡើង នៅក្នុង អង្គ ពិធី បើក សន្និបាទ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កែប អាណត្តិ ទី៥ ( ឆ្នាំ ២០១៩ - ២០២៥ ) នា ព្រឹក ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នៅ សាល ប្រជុំ សាលា ខេត្ត កែប ។
ពិធី នេះ បាន ប្រារព្ធ ទៅ ក្រោម វត្តមាន លោកស្រី ពុំ ចន្ទីនី អគ្គ លេខាធិការ កាកបាទ ក្រហម កម្ពុជា . លោក កែន សត្ថា អធិបាល ខេត្ត កែប លោក ឡាយ ផេង អនុប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កែប និង ចូលរួម ពីសំណាក់ គណៈ កិត្តិយស សាខា គណៈកម្មាធិការ សាខា អាណត្តិ ទី៤ សមាជិក - សមាជិកា ពេញ សិទ្ធិ មន្ត្រី បច្ចេកទេស ទីស្នាក់ការ កណ្តាល ក្រុម ប្រតិបត្តិ សាខា យុវជន កាកបាទ ក្រហម កម្ពុជា និង អ្នកស្ម័គ្រចិត្ត ប្រមាណ ៣០០ នាក់ ។
ក្នុង ឱកាស នោះ លោក កែន សត្ថា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កែប អាណត្តិ ទី៥ បាន កោតសរសើរ ចំពោះ គណៈ កិត្ត យស សាខា គណៈកម្មាធិការ សាខា អាណត្តិ ទី៤ ព្រមទាំង សមាជិក សមាជិកា អ្នកស្ម័គ្រចិត្ត ទីប្រឹក្សា យុវជន កាកបាទ ក្រហម និង អនុសាខា កាកបាទ ក្រហម ក្រុង ស្រុក ទាំងអស់ ដែល បាន បំពេញ បេសកកម្ម ដ៏ ឧត្តុងឧត្តម របស់ ខ្លួន ដោយ សេចក្ដីក្លាហាន មិន រើសអើង និង មាន ឆន្ទៈ គ្រប់ ពេលវេលា កន្លងមក រហូត ធ្វើឲ្យ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កែប មាន ដំណើរការ ល្អ ពី មួយ អាណត្តិ ទៅ មួយ អាណត្តិ ។
លោក អភិបាល ខេត្ត ក៏ បាន ប្តេជ្ញាចិត្ត ថា ត្រូវ បន្ត ពង្រឹង អភិបាលកិច្ច ល្អ ពង្រឹង និង ពង្រីក សមត្ថភាព គៀរ គរ រក មូលនិធិ និង គ្រប់គ្រង មាន គណនេយ្យភាព និង តម្លាភាព និង ខិតខំ ពង្រឹង សមត្ថភាព គ្រប់គ្រង គ្រោះមហន្តរាយ ប្រកបដោយ ប្រសិទ្ធភាព ត្រូវ ខិតខំ ពង្រឹង ពង្រីក អភិវឌ្ឍ កម្លាំង ចលករ រួម មាន : យុវជន និង អ្នកស្ម័គ្រចិត្ត ពាក់ព័ន្ធ ឱ្យ កាន់តែ សកម្ម ថែម ទៀត និង បន្ត ខិតខំ អភិវឌ្ឍ សាខា អនុសាខា ឱ្យ នៅជា សាខា មាន ដំណើរការ ល្អ លើ គ្រប់ វិស័យ ។
លើស ពី នេះ ទៀត ប្រធាន គណៈកម្មាធិការ សាខា ត្រូវ យកចិត្តទុកដាក់ អនុវត្ត យុទ្ធសាស្ត្រ របស់ សមាគម ជាតិ ផែនការអភិវឌ្ឍន៍ សាខា បន្ត អភិបាលកិច្ច ល្អ ដឹកនាំ គ្រប់គ្រង ដោយ មាន តម្លាភាព គណនីយភាព៕ ម្ចាស់ កសិដ្ឋាន ចិញ្ចឹម ជ្រូក នៅ ស្រុក ត្បែងមានជ័យ ខេត្ត ព្រះវិហារ អំពាវនាវ អាជ្ញាធរ និង សមត្ថកិច្ច ជួយ សង្រ្គោះ សត្វ ជ្រូក ជាច្រើន ពាន់ ក្បាល ដែល ត្រូវ ទឹក ជំនន់ វាយប្រហារ
( ព្រះវិហារ ) ៖ តាម សេចក្តីរាយការណ៍ ពី ម្ចាស់ កសិដ្ឋាន ចិញ្ចឹម ជ្រូក មួយ កន្លែង នៅ ភូមិ ស្រែ ព្រាង ឃុំ ប្រមេរុ ស្រុក ត្បែងមានជ័យ ខេត្ត ព្រះវិហារ ថា នៅ រសៀល ថ្ងៃ ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ទឹក ជំនន់ បាន ហក់ ឡើង យ៉ាង ខ្លាំង បណ្តាលឲ្យ លិច កសិដ្ឋាន ចិញ្ចឹម ជ្រូក របស់ គាត់ ធ្វើឲ្យ សត្វ ជ្រូក របស់ គាត់ បាត់បង់ ជាច្រើន ក្បាល និង ជាច្រើន ក្បាល ទៀត កំពុង ជួយ សង្រ្គោះ ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ ប៉ូលិស ហុងកុង ក៏ បាន បញ្ជាក់ ដែរ ថា មនុស្ស ទាំង ១៥៧ នាក់ ខាងលើ ត្រូវបាន ចាប់ខ្លួន កំឡុង បាតុកម្ម តវ៉ា នៅ ចន្លោះ ពី ម៉ោង ៥ល្ងាច កាលពី ថ្ងៃសុក្រ និង ម៉ោង ៨ព្រឹក ថ្ងៃចន្ទ នេះ ហើយ ក្នុង ចំណោម អ្នក ទាំងនេះ ទៀតសោត មាន ១២៥ នាក់ ជា បុរស និង ស្ត្រី ៣២ នាក់ ដែល មាន អាយុ ចាប់ពី ១៣ ឆ្នាំ រហូតដល់ ៦៣ ឆ្នាំ ។
គួរ ជម្រាប ថា បាតុកម្ម តវ៉ា កាលពី ចុង សប្ដាហ៍ កន្លង នៅតែ បន្ត មាន អំពើហិង្សា ផ្ទុះឡើង ស្រប ពេល ក្រុម បាតុករ ប្រកាន់ ជំហរ ធ្វើ បាតុកម្ម ប្រឆាំង រដ្ឋាភិបាល ទីក្រុង ហុងកុង ដដែល បើ ទោះជា សេចក្ដីព្រាង ច្បាប់ ធ្វើ បត្យាប័ន ជនសង្ស័យ ទៅកាន់ ចិន ដី គោក ត្រូវបាន លុបចោល ក៏ដោយ ។ ពួកគេ បាន បន្ថែម ការទាមទារ ឱ្យ ដោះលែង ក្រុម បាតុករ ដែល ត្រូវបាន អាជ្ញាធរ ចាប់ខ្លួន ជាពិសេស គឺ អំពាវនាវ ឱ្យ នាយក ប្រតិបត្តិ ក្រុង ហុងកុង លោកស្រី Carrie Lam ចុះចេញ ពី តំណែង ៕
វិទ្យាស្ថាន ពហុ បច្ចេកវិទ្យា មិត្តភាព កម្ពុជា - ចិន ចាប់ ដៃ ក្រុមហ៊ុន ជិន ប៉ី ពង្រឹង ការបណ្តុះបណ្តាល វិជ្ជាជីវៈ ជូន ប្រជាពលរដ្ឋ ខ្មែរ
( ព្រះសីហនុ) ៖ ដើម្បី ឆ្លើយតប កំណើន សេដ្ឋកិច្ច និង តម្រូវការ ទីផ្សារ ការងារ វិទ្យាស្ថាន ពហុ បច្ចេកវិទ្យា មិត្តភាព កម្ពុជា - ចិន ខេត្ត ព្រះសីហនុ និង ក្រុមហ៊ុន ជិន ប៉ី គ្រុប (Jin Bei Group) បាន ចុះ អនុស្សារណៈ នៃ ការយោគយល់ គ្នា ក្នុង បំណង បង្កើត កិច្ចសហការ បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ជាពិសេស យុវជន នៅក្នុង ខេត្ត ព្រះសីហនុ ។
អនុស្សរណៈ នៃ ការយោគយល់ នេះ ត្រូវបាន ចុះហត្ថលេខា នៅ ថ្ងៃទី ៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ រវាង លោក ប៊ូ សំអាត តំណាង វិទ្យាស្ថាន ពហុ បច្ចេកវិទ្យា មិត្តភាព កម្ពុជា ចិន ខេត្ត ព្រះសីហនុ និង តំណាង ក្រុមហ៊ុន ជិន ប៉ី គ្រុប ។
ការ ចុះអនុស្សារណៈ នៃ ការយោគយល់ នេះ គឺជា កិច្ច ខិតខំ ប្រឹងប្រែង របស់ ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ មូលដ្ឋាន ខេត្ត ព្រះសីហនុ និង អាជ្ញាធរ ខេត្ត ព្រះសីហនុ ក្នុង ការគិតគូរ ស្វះស្វែងរក ការគាំទ្រ ពី មជ្ឈដ្ឋាន ផ្សេង ៗ ដើម្បី បណ្តុះបណ្តាល វិជ្ជាជីវៈ ដល់ ប្រជាពលរដ្ឋ យុវជន នៅក្នុង ខេត្ត ព្រះសីហនុ ឱ្យ មាន ស្តង់ដារ ត្រឹមត្រូវ ខណៈពេល បច្ចុប្បន្ន នេះ ខេត្ត មាន ឆ្នេរសមុទ្រ ស្អាត មួយ នេះ មាន ការវិនិយោគ ពី បរទេស យ៉ាង ច្រើន ហើយ មាន តម្រូវការ ផ្នែក ទីផ្សារ ពលកម្ម ខ្ពស់ និង ទាមទារ ឱ្យ មាន ជំនាញ ច្បាស់លាស់ ។
យោង តាម ក្រសួង សុខាភិបាល បារាំង រលក កម្ដៅ បាន វាយប្រហារ លើ ប្រទេស បារាំង និង តំបន់ ខ្លះ នៃ ទ្វីប អឺរ៉ុប ពី ថ្ងៃទី ២៤ ខែមិថុនា ដល់ ថ្ងៃទី ៧ ខែកក្កដា និង ពី ថ្ងៃទី ២១ ខែកក្កដា ដល់ ថ្ងៃទី ២៧ ខែកក្កដា កន្លងទៅ នេះ ។ លើស ពី នេះ ទៅ ទៀត អាត្រា ស្លាប់ កំឡុង អាកាសធាតុ ក្ដៅ ខ្លាំង ទាំង ពីរ លើក នេះ មាន ៩.១ ភាគរយ ខ្ពស់ ជាង ពេល ធម្មតា ។
គួរ បញ្ជាក់ ថា បារាំង និង តំបន់ ខ្លះ នៃ ទ្វីប អឺរ៉ុប រង ការវាយប្រហារ ដោយ រលក កម្ដៅ ជាប់ កំណត់ត្រា ថ្មី មួយ នៅក្នុង រដូវ ក្ដៅ ឆ្នាំ ២០១៩ នេះ ដោយ សីតុណ្ហភាព ហក់ ឡើង ដល់ ៤៥. ៩អង្សា សេ ឯណោះ កាលពី ថ្ងៃទី ២៨ ខែមិថុនា កន្លងទៅ ៕ ជំនន់ ទន្លេ មេគង្គ នៅ ខេត្ត ត្បូងឃ្មុំ លើស កម្រិត ដែល ត្រូវ ប្រកាស អាសន្ន . អាជ្ញាធរ នាំ អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់
( ត្បូងឃ្មុំ ) ៖ ជំនន់ ទឹក ទន្លេ មេគង្គ ក្នុង ខេត្ត ត្បូងឃ្មុំ ឡើង លើស កម្រិត ដែល ត្រូវ ប្រកាស អាសន្ន ហើយ ពោល នៅ ពេល នេះ មាន កម្ពស់ ១៥. ៦៤ម៉ែត្រ ខណៈ កម្រិត ប្រកាស អាសន្ន ត្រឹមតែ ១៥.២០ ម៉ែត្រ ដែល ធ្វើឲ្យ លិច ភូមិឋាន របស់ ប្រជាពលរដ្ឋ មួយចំនួន នៅ ជាប់ ដង ទន្លេ ។
ឆ្លើយតប នឹង បញ្ហា នេះ ភ្លាម ៗ លោក ហាក់ សុខ មករា អភិបាល រង ខេត្ត ត្បូងឃ្មុំ នៅ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ ក្រុមការងារ និង អាជ្ញាធរ ពាក់ព័ន្ធ ចុះ សួរសុខទុក្ខ និង ចែកជូន ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ នៅក្នុង មូលដ្ឋាន ឃុំ ជីរោរ៍ ១ និង ឃុំ ពាម ជីលាំង ស្រុក ត្បូងឃ្មុំ ដែល រស់ នៅ តាម បណ្តោយ ទន្លេ មេគង្គ ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ហាក់ សុខ មករា បាន សម្តែង នូវ ក្តី អាណិតអាសូរ ដល់ ពលរដ្ឋ រងគ្រោះ ទាំងអស់ ដោយ ទឹក ជំនន់ ជន់ លិច ផ្ទះសម្បែង និង ដំណាំ ក៏ ដូចជា លិច ផ្លូវ កាត់ផ្តាច់ការធ្វើដំណើរ របស់ ពួកគាត់ ។
អភិបាល រង ខេត្ត រូប នេះ ក៏ បាន អំពាវនាវ ឲ្យ ពលរដ្ឋ ដែល រស់ នៅ តាម ដងទន្លេ ទាំងអស់ ត្រូវ មើល ថែរក្សា សមាជិក គ្រួសារ ពិសេស កូន តូច ៗ និង មនុស្ស ចាស់ . ត្រូវ ពិសារ ទឹក ឆ្អិន ជានិច្ច និង ត្រូវ ហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត និង ត្រូវ ប្រុងប្រយ័ត្ន ចំពោះ សត្វ អាសិរពិស បង្ក ការ គ្រោះថ្នាក់ ដល់ បងប្អូន ។ ហើយ បើ មាន បញ្ហា អ្វី សូម រាយការណ៍ ទៅ អាជ្ញាធរ និង ក្រុម គ្រូពេទ្យ ដែល មាន ប្រចាំ ការពេញ ២៤ ម៉ោង ដើម្បី ជួយ ដល់ បងប្អូន ភ្លាម ៗ ៕
ក្រសួង ទេសចរ ណ៍៖ អ្នកជំនាញ ទេសចរណ៍ កម្ពុជា ៧០ នាក់ ទទួលបាន ការ ពង្រឹង សមត្ថភាព ភាសា ជប៉ុន
( ភ្នំពេញ ) ៖ ក្រោម ការសហការ រវាង ក្រសួង ទេសចរណ៍ ជាមួយ មជ្ឈមណ្ឌល អាស៊ាន - ជប៉ុន និង មជ្ឈមណ្ឌល សហប្រតិបត្តិការ កម្ពុជា - ជប៉ុន អ្នកជំនាញ ទេសចរណ៍ កម្ពុជា ប្រមាណ ៧០ នាក់ បាន និង កំពុង ទទួលបាន ការបណ្តុះបណ្តាល ពង្រឹង សមត្ថភាព ភាសា ជប៉ុន ដើម្បី លើកកម្ពស់ សមត្ថភាព ជំនាញ ភាសា ជប៉ុន ឱ្យ កាន់តែ មាន លក្ខណៈ ស្ទាត់ជំនាញ ។
ពិធី បើក វគ្គ បណ្ដុះបណ្ដាល នេះ ធ្វើឡើង នៅ សណ្ឋាគារ សុខា ភ្នំពេញ នា រសៀល ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ ក្រោម អធិបតីភាព លោក ប៉ាក់ សុខុម រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង មាន ការចូលរួម ពីសំណាក់ កញ្ញា Mizuho Kanda ប្រធាន ផ្នែក ទទួលបន្ទុក ទេសចរណ៍ និង ជា តំណាង មជ្ឈមណ្ឌល អាស៊ាន - ជប៉ុន សាស្រ្តាចារ្យ នៃ មជ្ឈមណ្ឌល សហប្រតិបត្តិការ កម្ពុជា ជប៉ុន មន្រ្តី ជំនាញ អ្នកជំនាញ ទេសចរណ៍ សិស្ស និស្សិត ដែល ចូលរួម សរុប ប្រមាណ ៧០ នាក់ ។
នៅក្នុង ពិធី បើក សិក្ខាសាលា នេះ លោក រដ្ឋលេខាធិការ បាន គូសបញ្ជាក់ ពី ភាពរីកចម្រើន នៃ វិស័យ ទេសចរណ៍ កម្ពុជា ក្រោម ម្លប់ នៃ សុខ សន្តិភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដែល កើត ចេញពី ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
សិក្ខាសាលា បណ្តុះបណ្តាល នេះ ត្រូវបាន រៀបចំឡើង ចំពេលវេលា និង ស្រប តាម សំណូមពរ របស់ អ្នកជំនាញ ទេសចរណ៍ នៅក្នុង ការចូលរួម កសាង ធនធាន មនុស្ស ក្នុង វិស័យ ទេសចរណ៍ បន្ថែម ជាពិសេស លើកកម្ពស់ សមត្ថភាព ជំនាញ ភាសា ជប៉ុន ឱ្យ កាន់តែ មាន លក្ខណៈ ស្ទាត់ជំនាញ ក្នុង ការចូលរួម ផ្តល់ សេវាកម្ម ទេសចរណ៍ ឱ្យ កាន់តែ ល្អ ប្រសើរ និង ពេញចិត្ត ពីសំណាក់ ភ្ញៀវ ទេសចរ ជាពិសេស ទេសចរ ជប៉ុន ដែល បាន និង កំពុង មាន ការកើនឡើង ជាលំដាប់ ក្នុង ការមក ទស្សនា នៅ កម្ពុជា ។
គួរ កត់សម្គាល់ ថា សម្រាប់ រយៈពេល ៧ខែ ដើម ឆ្នាំ ២០១៩នេះ កម្ពុជា ទទួលបាន ភ្ញៀវ ទេសចរ អន្តរជាតិ ជាង ៣. ៨លាន នាក់ កើនឡើង ១១.១% ធៀប នឹង រយៈពេល ដូចគ្នា ក្នុង ឆ្នាំ ២០១៨ ដោយ ក្នុង នោះ កម្ពុជា បាន ទទួល ទេសចរ ជនជាតិ ជប៉ុន ចំនួន ១១៣. ១៥៩ នាក់ កើនឡើង ប្រមាណ ២.៦% ។
ស្រឡាញ់ ជីវិត អ្នក សូម កុំ ប៉ះពាល់ គ្រឿងញៀន ! យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស ថ្ងៃទី ០៩ ខែកញ្ញា៖ បង្ក្រាប បាន ២៧ ករណី ឃាត់ខ្លួន ៤៣ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប គ្រឿងញៀន ខុស ច្បាប់ ចំនួន ២៧ ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៤៣ នាក់ ។
បើ យោង តាម របាយការណ៍ របស់ គណៈកម្មការ ទី៣ នៃ យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ បាន ឲ្យដឹង ថា ប្រភេទ បទល្មើស រួម មាន៖ ជួញដូរ ១៤ករណី ឃាត់ខ្លួន ២៧ នាក់ និង ប្រើប្រាស់ ១៣ករណី ឃាត់ខ្លួន ១៦ នាក់ ។
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ០៩ ខែកញ្ញា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ និង ផាក ពិន័យ ចំនួន ១. ០៦៦ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង១.១៣៦ គ្រឿង រកឃើញ យានយន្ត ល្មើស ច្បាប់ និង ផាក ពិន័យ ចំនួន ១.០៦៦ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ចំនួន ៨៦៧ គ្រឿង ។ នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
សម្រាប់ លទ្ធផល នៃ ការត្រួតពិនិត្យ រយៈពេល ៩ ថ្ងៃ ចាប់ពី ថ្ងៃទី ០១ ដល់ ថ្ងៃទី ០៩ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ នគរបាល បាន ត្រួតពិនិត្យ យានយន្ត ចំនួន ២៤.៧៥៦ គ្រឿង រកឃើញ យានយន្ត ល្មើស ១៤.១៥២ គ្រឿង ក្នុង នោះ ម៉ូតូ ១១.៤៣៤ គ្រឿង និង ផាក ពិន័យ ១៣.១៨៧ គ្រឿង ក្នុង នោះ ម៉ូតូ ១០. ៨០៤ គ្រឿង ៕ យុទ្ធនាការ ទប់ស្កាត់ ពលកម្ម កុមារ ក្នុង សិប្បកម្ម ផលិត ឥដ្ឋ បន្ត ចុះ ដល់ ៥០ ទីតាំង ទៀត ក្នុង ខេត្ត កំពង់ចាម ត្បូងឃ្មុំ និង ក្រចេះ
( កំពង់ចាម ) ៖ យុទ្ធនាការ ទប់ស្កាត់ ការប្រើប្រាស់ ពលកម្ម កុមារ ក្នុង វិស័យ សិប្បកម្ម ផលិត ឥដ្ឋ នៅតែ បន្ត អនុវត្ត វិធានការ យ៉ាង ម៉ឺងម៉ាត់ និង បាន ចុះ ទៅដល់ ខេត្ត កំពង់ចាម ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត ក្រចេះ ដើម្បី លើកកម្ពស់ ការអនុវត្ត ច្បាប់ ស្តីពី ការងារ និង យុទ្ធនាការ សហគមន៍ ផលិត ឥដ្ឋ គ្មាន ពលកម្ម កុមារ នៅ ឆ្នាំ ២០២០ ។
ការ យុទ្ធនាការ ក្នុង ខេត្ត ទាំង បី នេះ គឺ បាន ចុះ ទៅដល់ សិប្បកម្ម ផលិត ឥដ្ឋ ចំនួន ៥០ ទីតាំង គិត ចាប់ពី ថ្ងៃទី២ ខែកញ្ញា ឆ្នាំ ២០១៩ មក ។
លោក វ៉េង ហៀង ប្រធាន នាយកដ្ឋាន ការងារ កុមារ នៃ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ បាន ដឹកនាំ ក្រុមការងារ ចុះ យុទ្ធនាការ ទប់ស្កាត់ ការប្រើប្រាស់ ពលកម្ម កុមារ ក្នុង វិស័យ សិប្បកម្ម ផលិត ឥដ្ឋ ដោយ បាន ប្រាប់ ពី វឌ្ឍនភាពលក្ខខណ្ឌ ការងារ មាន ជា អាទិ៍៖
* ការយល់ដឹង អំពី ការទប់ស្កាត់ ការប្រើប្រាស់ ពលកម្ម កុមារ ក្នុង ចំណោម និយោជក កម្មករ និយោជិត ក្រុមគ្រួសារ និង សហគមន៍ នៅក្នុង វិស័យ សិប្បកម្ម ផលិត ឥដ្ឋ មាន ការរីកចម្រើន គួរឱ្យ កត់សម្គាល់ បើ ធៀប ទៅនឹង ឆ្នាំ ២០១៦ ។
* គ្រប់ សិប្បកម្ម ផលិត ឥដ្ឋ ទាំងអស់ មិន មាន ប្រើប្រាស់ ពលកម្ម កុមារ នោះ ទេ និង និយោជក ប្រមាណ ១០ភាគរយ មាន សញ្ញា ហាម ប្រើប្រាស់ កុមារ អាយុ ក្រោម ១៥ ឆ្នាំ ។
* គ្រប់ សិប្បកម្ម ទាំងអស់ បាន ប្រើប្រាស់ ឧស មិន ប៉ះពាល់ ដល់ បរិស្ថាន ។
* គ្មាន ការ កាត់ បំណុល ការដាក់បន្ទុក សេរីភាព កម្មករ និយោជិត ការងារ ដោយ បង្ខំ និង ទាសភាព បំណុល ឬ អន្ទាក់ បំណុល នោះ ទេ ។
* ម៉ាស៊ីន ផលិត ដុំ ឥដ្ឋ នៅ មិន ទាន់ មាន លក្ខណៈ ស្វ័យប្រវត្តិ នៅឡើយ ។
នា កំលុង ពេល ចុះ យុទ្ធនាការ នេះ ផងដែរ និយោជក និង សហគមន៍ ផលិត ឥដ្ឋ ទាំងអស់ បាន ប្តេជ្ញា ជំរុញ ឱ្យ កុមារ ទទួលបាន ការអប់រំ បណ្តុះបណ្តាល ជំនាញ និង ទប់ស្កាត់ គ្រោះថ្នាក់ ការងារ ក៏ ដូចជា ការប្រើប្រាស់ ពលកម្ម កុមារ នៅក្នុង សិប្បកម្ម ផលិតផល ឥដ្ឋ ។
ម្យ៉ាងទៀត ទណ្ឌិត សម រង្ស៉ី ពី ដើម រៀង មក នៅ ស្រុក ខ្មែរ តិច ជាង នៅ បរទេស ព្រោះ សម រង្ស៉ី មាន សញ្ជាតិ បរទេស មួយ ទៀត ។ ដូច្នេះហើយ ទណ្ឌិត សម រង្ស៉ី មិន ដែល ស្គាល់ ទឹកចិត្ត ប្រជាពលរដ្ឋ ខ្មែរ និង មិន បាន យល់ ថា ប្រជាពលរដ្ឋ ខ្មែរ ត្រូវការ អ្វី នោះ ទេ សូម្បី សេចក្តីសុខ សុខ សន្តិភាព ដែល ប្រជាពលរដ្ឋ ខ្មែរ កំពុង រក្សា ក៏ ទណ្ឌិត រង្ស៉ី តែងតែ មាន ចេតនា រៀបចំ ផែនការបំផ្លាញ ដែរ ។
បើ ពី និត្យ លើ ទិដ្ឋភាព ច្បាប់ និង ទង្វើ ទាំង នេះ ទណ្ឌិត រង្ស៉ី បាន ប្រព្រឹត្ត នូវ ទង្វើ ក្បត់ ជាតិ ដែល ច្បាប់ និង ប្រជាពលរដ្ឋ ខ្មែរ មិន អាច អត់ ឱន ឱ្យ បាន ឡើយ ។
ជាក់ស្តែង ចុងក្រោយ នេះ និយាយ ដដែល ៗ ថា នឹង មក កម្ពុជា នៅ ថ្ងៃទី ៩ ខែវិច្ជិកា ឆ្នាំ ២០១៩ ខណៈ ខ្លួន មាន ទោស ជាប់ ពេញ ខ្លួន ច្បាប់ កំពុងតែ ចាំ អនុវត្តន៍ ចាប់បញ្ចូល គុក ។
ទណ្ឌិត សម រង្ស៉ី ដែល មាន សញាតិ ជា ខ្មែរ ប៉ុន្តែ ចង់ បង្ករ សង្គ្រាម ឱ្យ ខ្មែរ ធ្លាប់ បាន មើលងាយ ច្បាប់ កម្ពុជា មើលងាយ រដ្ឋធម្មនុញ្ញ ដែល ជា ច្បាប់ កំពូល របស់ ជាតិ ។ ទណ្ឌិត សម រង្ស៉ឺ យល់ ខុស ថា ខ្លួន អាង មាន លិខិត ឆ្លង ដែន បរទេស ប្រើ លិខិត ឆ្លង ដែន បរទេស ច្បាប់ របស់ កម្ពុជា មិន អាច ធ្វើ អ្វី ខ្លួន បាន ។
