( បាត់ដំបង ) ៖ ក្នុង គោលបំណង ទ្រទ្រង់ វិស័យ ពុទ្ធសាសនា ដែល ជា សាសនា របស់ រដ្ឋ ឲ្យបាន គ្រប់ កាល ព្យាករណ៍ របស់ ព្រះសម្មាសម្ពុទ្ធ បរម គ្រូ លោកស្រី ខៀវ ស៊ីណា ជា ចាន់ តូ អនុប្រធាន កិត្តិយស សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត កំពង់ធំ . ព្រះមុនី កោសល បណ្ឌិត យ៉ន សេង យៀត អនុប្រធាន លេខាធិការដ្ឋាន គណៈ សង្ឃ នាយក នៃ កម្ពុជា និង ក្រុមការងារ បាន នាំយក ទេយ្យ ទាន ទៅ ប្រគេន សមណ សិស្ស ជិត ១០០០ អង្គ កំពុង សិក្សា ផ្នែក ភាសា បាលី និង នៅ សកលវិទ្យាល័យ ខេត្ត បាត់ដំបង ។
លោកស្រី ខៀវ ស៊ីណា ជា ចាន់តូ បាន ជំរុញ ដល់ សមណ សិស្ស គ្រប់ ព្រះអង្គ ខិតខំ សិក្សា រៀនសូត្រ ដើម្បី យក ចំណេះដឹង ទៅ ទ្រទ្រង់ ព្រះសាសនា ឲ្យបាន រឹងមាំ និង ជា ធនធាន មនុស្ស ផ្នែក ព្រះពុទ្ធ សាសនា ក្នុង ប្រទេស កម្ពុជា កាន់តែ ច្រើន ។
ព្រះមុនី កោសល បណ្ឌិត យ៉ន សេង យៀត មាន សង្ឃ ដីកា ថា ការនាំ នូវ ទេយ្យ ទាន ចំពោះ សមណសិស្ស នៅ ពេល នេះ ដើម្បី ជួយ សម្រួល ដល់ ការចំណាយ របស់ ព្រះសង្ឃ ហើយ សកម្មភាព នេះ បាន បុណ្យ កុសល ខ្លាំង ណាស់ ។ ព្រះអង្គ មាន សង្ឃ ដីកា បញ្ជាក់ ថា លោកស្រី ខៀវ ស៊ីណា ជា ចាន់ តូ គឺជា ពុទ្ធ សាសនិក មួយ រូប ដែល មាន សទ្ធា ជ្រះថ្លា បាន ជួយ ឧបត្ថម្ភ បច្ច័យ ជាច្រើន ក្នុង ការលើកស្ទួយ វិស័យ ពុទ្ធ ចក្រ នៅក្នុង ខេត្ត បាត់ដំបង ។
សូម បញ្ជាក់ ថា លោកស្រី ខៀវ ស៊ីណា និង ក្រុមការងារ ព្រមទាំង ព្រះអង្គ យ៉ន សេង យៀត ក៏ បាន នាំ បច្ច័យ ទៅ ប្រគេន ព្រះសង្ឃ ចំនួន ៣វត្ត ផ្សេង ទៀត នៅក្នុង ខេត្ត បាត់ដំបង ផងដែរ គឺ មាន វត្ត ស្លា កែត . វត្ត ក្ដុល ដូន ទាវ និង វត្ត កុណ្ណៈ កុដិ ជា ការចូលរួម ក្នុង ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ នា ពេល ខាងមុខ ផងដែរ ៕
រដ្ឋមន្ត្រី ឃោសនា ការចិន៖ ជូហៃ គឺជា ទឹកដី នៃ ការចាប់ផ្តើម សករាជ ថ្មី របស់ ចិន
លោកស្រី រដ្ឋមន្ត្រី បាន ថ្លែង បែប នេះ នៅ រសៀល ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ ក្នុង ឱកាស ដែល លោកស្រី បាន ធ្វើ ពិធី ទទួលទាន អាហារ ស្វាគមន៍ ដល់ ប្រតិភូ ព័ត៌មាន ១៨ ប្រទេស ក្នុង នោះ មាន អ្នក ព័ត៌មាន កម្ពុជា ដែល ពួកគេ មកពី ប្រទេស សមាជិក អង្គការ សហប្រតិបត្តិការ សៀង ហៃ (SCO) បន្ទាប់ពី បាន ធ្វើដំណើរ មកដល់ ទឹក ក្រុង នេះ ក្រោយ បញ្ចប់ បេសកកម្ម នៅ ទីក្រុង ឆាង អាន ។
មូលហេតុ ដែល លោកស្រី ថ្លែង បែប នេះ ព្រោះថា បើ មើល តាម កំណើន សេដ្ឋកិច្ច ទីក្រុង ដែល រុំ ព័ទ្ធ ទៅ ដោយ សមុទ្រ និង ភ្នំ មួយ នេះ បាន រីកចម្រើន យ៉ាង ខ្លាំង នៅ ឆ្នាំ ២០១៨ ។ ទោះបី ជូហៃ គឺជា ទឹកដី តូច ប៉ុន្តែ មាន ការវិនិយោគ ច្រើន ហើយ ការរស់ នៅ ទីនេះ មាន ស្តង់ដារ ខ្ពស់ ខ្លាំង ក្រោយពេល ចាប់ផ្តើម អភិវឌ្ឍន៍ ត្រឹមតែ ៤០ ឆ្នាំ ប៉ុណ្ណោះ ។
ជូហៃ មាន ប្រជាជន សរុប ១.៨លាន នាក់ ។ ទីក្រុង នេះ ត្រូវបាន បែងចែក ជា បី តំបន់ គឺ សៀង ជូ ដែល ជា ទីតាំង រដ្ឋាភិបាល . ជីវ័ន្ដ កន្លែង អភិវឌ្ឍន៍ តិច ជាង សៀង ជូ ប៉ុន្តែ ជា កន្លែង អាកាសចរណ៍ និង តូ មិន គឺជា កន្លែង អភិវឌ្ឍន៍ តិចតួច ប៉ុន្តែ សម្បូរបែប ទៅ ដោយ សិល្ប: វប្បធម៌ នានា ជាច្រើន ។
ក្នុង ឱកាស នោះ ដែរ លោកស្រី សង្ឃឹម ថា កិច្ចសហប្រតិបត្តិការ ជាមួយ SCO នឹង ធ្វើឱ្យ ប្រទេស ជា សមាជិក ទាំងអស់ កាន់តែ មាន ទំនាក់ទំនង ស៉ី ជម្រៅ ក្រោម គំនិត ផ្តួចផ្តើម « ខ្សែក្រវាត់ និង ផ្លូវ » ។ ជាពិសេស នោះ ប្រទេស សមាជិក ទាំងអស់ នឹង រួមគ្នា ដើរ ទៅ មុខ មាន ជោគវាសនា រួមគ្នា ក្នុង ការអភិវឌ្ឍន៍ លើ វិស័យ ទេសចរណ៍ សេដ្ឋកិច្ច វប្បធម៌ និង ពាណិជ្ជកម្ម ជាដើម ។
ប្រទេស ជា អ្នកសង្កេតការណ៍ មាន ៤ រួម មាន អាហ្វកានីស្ថាន បេឡារុស អ៉ីរ៉ង និង ម៉ុងហ្គោលី ។ ចំណែកឯ ប្រទេស ដែល ជា ដៃគូ សន្ទនា មាន ៦ រួម មាន កម្ពុជា អាហ្សេ បេហ្សង់ អាមេនី នេប៉ាល់ តួកគី និង ស្រី ឡាំង កា៕
( ភ្នំពេញ ) ៖ ដោយ អនុវត្ត តាម បទបញ្ជា របស់ នាយ ឧត្តមសេនីយ៍ នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង ក្រោម ការដឹកនាំ ដោយ ផ្ទាល់ ពីសំណាក់ នាយ ឧត្ដមសេនិយ៍ ម៉ក់ ជីតូ អគ្គ ស្នងការ រង នគរបាល ជាតិ . ឧត្ដមសេនីយ៍ ឯក ឡឹក វណ្ណៈ នាយ មន្ទីរ ប្រឆាំង បទល្មើស គ្រឿងញៀន កម្លាំង ជំនាញ បាន ឆ្មក់ បង្ក្រាប និង ឃាត់ខ្លួន មេក្លោង ជួញដូរ គ្រឿងញៀន ម្នាក់ ដោយ ដកហូត បាន គ្រឿងញៀន ចំនួន ៣៨៥៣ ក្រ. ៨៩ ( ជិត ៤គីឡូក្រាម ) ។
ប្រតិបត្តិការ បង្ក្រាប មេក្លោង ជួញដូរ គ្រឿងញៀន នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ ដោយ កម្លាំង ជំនាញ ( ក ១១) របស់ មន្ទីរ ប្រឆាំង គ្រឿងញៀន បាន បង្រ្កាប ករណី ជួញដូរ គ្រឿងញៀន ស្ថិត នៅ ចំណុច ផ្លូវ លំ ផ្ទះ គ្មាន លេខ បន្ទប់ លេខ ៩ នៅក្នុង ភូមិ ស្លែង រលើង សង្កាត់ អូរបែក ក្អម ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា នៅ ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ផ្ញើ សារ ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត ជូន លោកស្រី ខាំ ភៀន ភរិយា របស់ ព្រឹទ្ធាចារ្យ ប៊ូ ថង និង ក្រុមគ្រួសារ ចំពោះ មរណភាព របស់ ព្រឹទ្ធាចារ្យ ប៊ូ ថង ក្នុង ជន្មាយុ ៨២ ឆ្នាំ ដោយ រោគា ពាធ ។
ក្នុង លិខិត សម្តេច តេជោ ហ៊ុន សែន បាន ចាត់ទុក មរណភាព របស់ នាយ ឧត្តមសេនីយ៍ ប៊ូ ថង សមាជិក ព្រឹទ្ធសភា គឺជា ការបាត់បង់ ស្វាមី បិតា ជីតា ដែល ប្រកបដោយ ព្រហ្មវិហារ ធម៌ និង ជា ការបាត់បង់ ឥស្សរជន ស្នេហាជាតិ ដ៏ ឧត្តុងឧត្តម ដែល បាន បូជា កម្លាំង កាយ កម្លាំងចិត្ត ប្រាជ្ញា ស្មារតី និង ហ៊ាន បូជា ជីវិត ក្នុង បុព្វហេតុ តស៊ូ រំដោះ ជាតិ និង ប្រជាជន កម្ពុជា ពី របប ប្រល័យ ពូជសាសន៍ ហើយ បាន ចូលរួមចំណែក យ៉ាង សកម្ម ក្នុង ការស្តារ និង អភិវឌ្ឍ ប្រទេសជាតិ ឲ្យ មាន ការរីកចម្រើន លើ គ្រប់ វិស័យ ។
សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ទៀត ថា ព្រឹទ្ធាចារ្យ ប៊ូ ថង បាន ខិតខំ លើកកម្ពស់ សិទ្ធិ សេរីភាព គ្រប់ បែបយ៉ាង របស់ បងប្អូន ជនជាតិ ភាគ តិច ហើយ បាន ចូលរួម ប្រែក្លាយ តំបន់ ភូមិភាគ ឦសាន ឲ្យ ក្លាយជា តំបន់ មាន ការអភិវឌ្ឍន៍ ដ៏ ឆាប់រហ័ស និង បាន បន្សល់ទុក នូវ ស្នាដៃ ជាច្រើន ក្នុង ការបម្រើ ស្ថាប័ន ព្រឹទ្ធសភា ដើម្បី ពង្រឹង លទ្ធិ ប្រជាធិបតេយ្យ និង នីតិរដ្ឋ នៅ កម្ពុជា ។
លិខិត របស់ សម្តេច តេជោ ហ៊ុន សែន បន្ថែម ថា « ក្នុង ឱកាស ប្រកបដោយ សមាទុក្ខ ដ៏ ក្រៀមក្រំ បំផុត នេះ ភរិយា ខ្ញុំ និង រូប ខ្ញុំ សូម ចូលរួម ចែករំលែក នូវ មរណទុក្ខ ដោយ ក្តីស្រណោះ និង អាឡោះអាល័យ ជាមួយ លោកជំទាវ និង បុត្រា បុត្រី ព្រមទាំង បងប្អូន កូនក្មួយ ទាំងអស់ នៃ សព ដោយ សេចក្តីសង្វេគ ជា ទីបំផុត ។ ភរិយា ខ្ញុំ និង ខ្ញុំ សូម ឧទ្ទិស បួងសួង ឲ្យ ដួង វិញ្ញាណក្ខន្ធ ឯកឧត្តម ប៊ូ ថង ឆាប់ បាន ចាប់កំណើត ក្នុង សុគតិភព គ្រប់ ៗ ជាតិ កុំបី ឃ្លៀងឃ្លាត ឡើយ »៕
( ភ្នំពេញ ) ៖ បន្ទាប់ពី ទទួលបដិណ្ឋាកិច្ច ស្វាគមន៍ នាយក រដ្ឋមន្រ្តី ឡាវ . នា ម៉ោង ១០៖០០ នាទី ព្រឹក ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ទទួល ជួប ពិភាក្សា ទ្វេ ភាគី ជាមួយ លោក ថង លូន ស៊ី ស៊ូលីត នាយក រដ្ឋមន្រ្តី ឡាវ នៅ វិមាន សន្តិភាព ហើយ បន្ទាប់ពី នោះ ភាគី ទាំង ពីរ មាន សន្និសីទ រួម ព្រមទាំងអញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ចុះហត្ថលេខា លើ ឯកសារ មួយចំនួន ។
លោក បណ្ឌិត ថង លូន ស៊ី ស៊ូលីត ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា នៅ ម៉ោង ប្រមាណ ៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ដើម្បី បំពេញ ទស្សនកិច្ច ផ្លូវការ រយៈពេល ២ ថ្ងៃ នៅ ថ្ងៃទី ១២ - ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ តាម ការអញ្ជើញ របស់ នាយក រដ្ឋមន្រ្តី កម្ពុជា ។
អំឡុង ទស្សនកិច្ច នេះ នាយក រដ្ឋមន្រ្តី ឡាវ អញ្ជើញ ដាក់ កម្រង ផ្កា នៅ វិមាន ឯករាជ្យ និង គោរព ព្រះវិញ្ញាណក្ខន្ធ នៅ មណ្ឌប ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះនរោត្ដម សីហនុ « ព្រះបរម រតន កោដ្ឋ » អតីត ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ហើយ បន្ត ចូល ជួប សម្តែង ការគួរសម ចំពោះ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង ជួប សម្តែង ការគួរសម ចំពោះ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ ប្រមុខរដ្ឋ ស្តីទី នៃ ព្រះរាជាណាចក្រ កម្ពុជា ។
ក្រសួង ការបរទេស បាន កត់សម្គាល់ ថា ដំណើរទស្សនកិច្ច ផ្លូវការ របស់ លោក បណ្ឌិត ថង លូន ស៊ី ស៊ូលីត នៅ កម្ពុជា នេះ នឹង រួមចំណែក កាន់តែ ប្រសើរ ក្នុង ការពង្រឹង និង ពង្រីក បន្ថែម ទៀត នូវ ចំណង មិត្តភាព ជា ប្រពៃណី ដ៏ យូរ លង់ សាមគ្គីភាព ភាតរភាព និង កិច្ចសហប្រតិបត្តិការ ប្រកបដោយ ផ្លែផ្កា រវាង កម្ពុជា និង ឡាវ ៕ ក្រសួង អប់រំ សម្រេច បង្កើត « គណៈកម្មការពិនិត្យ និង ដោះស្រាយ ការតវ៉ា របស់ បេក្ខជន » ពាក់ព័ន្ធ លទ្ធផល ប្រឡង បាក់ឌុប
ក្រសួង អប់រំ បញ្ជាក់ ថា ការបង្កើត គណៈកម្មការ នេះ ក្នុង បំណង ធ្វើឲ្យ បេក្ខជន និង អាណាព្យាបាល មាន សេចក្តីទុកចិត្ត និង ទទួល លទ្ធផល នៃ ការប្រឡង បាក់ឌុប ខណៈ ដែល មាន បេក្ខជន មួយចំនួន បាន តវ៉ា ពុំ សុខចិត្ត លើ លទ្ធផល « ធ្លាក់ » និង មាន បេក្ខជន មួយចំនួន ទៀត ពុំ សុខចិត្ត ដោយសារ ទទួលបាន និទ្ទេស ត្រឹម «B» និង «C» ហើយ ទាមទារ យក និទ្ទេស «A» ។
ជាមួយគ្នា នេះ ក្រសួង អប់រំ បាន បញ្ជាក់ យ៉ាង លម្អិត អំពី ដំណើរការបច្ចេកទេស ទាំង៣ ដំណាក់ គឺ ដំណាក់កាល សំណេរ ដំណាក់កាល កំណែ និង ដំណាក់កាល បូក ស្រង់ ពិន្ទុ ដើម្បី ធានា បាន នូវ ភាពសុក្រឹត្យ យុត្តិធម៌ និង តម្លាភាព ។
ក្រសួង អប់រំ ក៏ បាន សំណូមពរ ជាថ្មី ដល់ បេក្ខជន ទាំងអស់ ត្រូវ ចងចាំ ថា លទ្ធផល ប្រឡង ឆ្លុះបញ្ចាំង សារសំខាន់ បី យ៉ាង គឺ៖ ១៖ អ្នក ចេះ គឺជាប់ . ២៖ ការប្រឡង បាន ប្រព្រឹត្តទៅ ដោយ យុត្តិធម៌ តម្លាភាព គោលការណ៍ ច្បាប់ និង ភាពទទួលបាន . និង ៣៖ លទ្ធផល ប្រឡង ពុំ មែន ជា ការកំណត់ វាសនា របស់ បេក្ខជន ទេ ប៉ុន្តែ ជា ការវាស់ស្ទង់ សមត្ថភាព និង ជំរុញ ឲ្យ មាន ការខំប្រឹង បន្ត ទៅ មុខ ទៀត ។
ការហ៊ាន អះអាង បញ្ជាក់ យ៉ាង ដូច្នេះ របស់ លោក ស៊ុន ចាន់ថុល ដោយសារតែ លោក បាន ពិភាក្សា រួចរាល់ ជាមួយ ក្រុមហ៊ុន សាងសង់ ស្ពាន របស់ ចិន ដែល ជា ទទួលខុសត្រូវ ក្នុង ការសាងសង់ ស្ពាន ព្រែក តា មាក់ នេះ ដើម្បីឲ្យ ដឹង ច្បាស់ ថា ការប៉ះទង្គិច ប្រាកដជា មិន ខូច ដល់ គ្រឹះ ស្ពាន ។
ជាមួយគ្នា នេះ ចំពោះ ប្រតិបត្តិការ ទាញ សាឡង់ ដឹក ខ្សាច់ ដែល ជាប់ គឿង នេះ ដែរ លោក ទេសរដ្ឋមន្ត្រី បញ្ជាក់ ថា ក្រសួង នឹង ប្រើប្រាស់ គ្រប់ មធ្យោបាយ ដើម្បី ធ្វើ យ៉ាង ទាញ សាឡង់ នេះ ចេញ ឲ្យបាន ។
សូម ជម្រាប ថា នៅ ព្រឹក ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ស្ថាប័ន ពាក់ព័ន្ធ ផ្សេង ទៀត បាន បន្ត ប្រតិបត្តិការ ទាញ សាឡង់ ដឹក ខ្សាច់ ដែល ជាប់ គឿង នៅសសរ ស្ពាន ព្រែក តា មាក់ បន្ទាប់ពី ចំណាយ ពេល អស់ ជាច្រើន ថ្ងៃ រួម មក ។
ក្រោយ ហេតុការណ៍ សាឡង់ ដឹក ខ្សាច់ ទម្ងន់ ជិត២.០០០តោន ជាប់ គឿង នឹង សសរ ទី៣ ស្ពាន ព្រែក តា មាក់ នេះ បាន កើតឡើង តាំងពី រសៀល ថ្ងៃទី ៨ ខែកញ្ញា ឆ្នាំ ២០១៩ ។
រយៈពេល ប៉ុន្មាន ថ្ងៃ មក នេះ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ មួយ ចំនួន ទៀត បាន ប្រើប្រាស់ នូវ វិធីសាស្ត្រ នានា មួយចំនួន ប៉ុន្តែ នៅតែ មិន ទាន់ អាច ទាញ សាឡង់ ដ៏ ធ្ងន់ មួយ នេះ ចេញ ពី សសរ ស្ពាន នៅឡើយ ទេ ៕ ក្រសួង អប់រំ ចេញ សេចក្តីប្រកាស ព័ត៌មាន ជុំវិញ ករណី បេក្ខជន មួយ ក្រុម តវ៉ា ចំពោះ លទ្ធផល ប្រឡង សញ្ញាបត្រ បាក់ ឌុប
( ភ្នំពេញ ) ៖ ក្រសួង អប់រំ យុជន និង កីឡា នៅ ព្រឹក ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ចេញ សេចក្តីប្រកាស ព័ត៌មាន ជុំវិញ ករណី បេក្ខជន មួយ ក្រុម លើក គ្នា តវ៉ា ចំពោះ លទ្ធផល ប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ សម័យ ប្រឡង ១៩ សីហា ឆ្នាំ ២០១៩ ។
ក្នុង សេចក្តីប្រកាស ព័ត៌មាន ក្រសួង អប់រំ បាន ពន្យល់ លម្អិត អំពី ដំណើរការបច្ចេកទេស ទាំង៣ ដំណាក់ គឺ ដំណាក់កាល សំណេរ ដំណាក់កាល កំណែ និង ដំណាក់កាល បូក ស្រង់ ពិន្ទុ ដើម្បី ធានា បាន នូវ ភាពសុក្រឹត្យ ។
សូម ជម្រាប ថា នៅ ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ ម្សិលមិញ មាន បេក្ខជន ប្រឡង បាក់ឌុប មួយចំនួន ក្រុម បាន នាំគ្នា តវ៉ា នៅមុខ ក្រសួង អប់រំ ចំពោះ លទ្ធផល នៃ ការប្រឡង បាក់ឌុប សម័យ ប្រឡង ១៩ សីហា ឆ្នាំ ២០១៩៕ ក្រសួង និង ស្ថាប័ន ពាក់ព័ន្ធ បន្ត ប្រតិបត្តិការ ទាញ សាឡង់ ដឹក ខ្សាច់ ដែល ជាប់ គឿង នៅសសរ ស្ពាន ព្រែក តា មាក់
( កណ្តាល ) ៖ នៅ ព្រឹក ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ស្ថាប័ន ពាក់ព័ន្ធ ផ្សេង ទៀត បាន បន្ត ប្រតិបត្តិការ ទាញ សាឡង់ ដឹក ខ្សាច់ ដែល ជាប់ គឿង នៅសសរ ស្ពាន ព្រែក តា មាក់ បន្ទាប់ពី ចំណាយ ពេល អស់ ជាច្រើន ថ្ងៃ រួម មក ។
រយៈពេល ប៉ុន្មាន ថ្ងៃ មក នេះ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ មួយ ចំនួន ទៀត បាន ប្រើប្រាស់ នូវ វិធីសាស្ត្រ នានា មួយចំនួន ប៉ុន្តែ នៅតែ មិន ទាន់ អាច ទាញ សាឡង់ ដ៏ ធ្ងន់ មួយ នេះ ចេញ ពី សសរ ស្ពាន នៅឡើយ ទេ ៕
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ប្រគល់ ថវិកា ទទួលបាន ពី ការបរិច្ចាគ កន្លងមក ចំនួន ៨ ពាន់ លាន រៀល ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា
( ភ្នំពេញ ) ៖ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា បាន ប្រគល់ ថវិកា ដែល ទទួលបាន ពី ការបរិច្ចាគ កន្លងមក ចំនួន ៨.០០០.០០០.០០០ ( ប្រាំបី ប៊ីលាន ) រៀល ជូន មន្ទីរពេទ្យ គន្ធ បុប្ផា ដើម្បី ប្រើប្រាស់ ក្នុង ការពិនិត្យ ពិគ្រោះ និង ព្យាបាល ជំងឺ ដល់ កុមារ និង ទារក ដោយ មិន គិត ថ្លៃ និង ប្រកបដោយ គុណភាព ។
ការប្រគល់ ជូន នេះ ធ្វើឡើង នៅ រសៀល ថ្ងៃពុធ ទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ ដែល ជា កិច្ចសហប្រតិបត្ត ការ និង ការគាំទ្រ ជា បន្តបន្ទាប់ របស់ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ចំពោះ កិច្ច ដំណើរការ របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ទាំង៥ ទីតាំង ក្នុង ស្មារតី « ខ្មែរ ជួយ ខ្មែរ » ។
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សូម ថ្លែងអំណរគុណ ចំពោះ ទឹកចិត្ត សប្បុរសធម៌ និង ការបរិច្ចាគ របស់ សប្បុរសជន ដើម្បី ចូលរួម សម្រេច នូវ បេសកកម្ម ដ៏ ចម្បង និង តែ មួយ គត់ របស់ មូលនិធិ គឺ ការធានា ចីរភាព របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ។
ក្នុង ករណី សាធារណជន មាន បំណង ចូលរួម បរិច្ចាគ ដោយ ផ្ទាល់ នៅ មន្ទីរពេទ្យ គន្ធ បុប្ផា សូម មេត្តា ផ្តល់ ដំណឹង ជាមុន មក លេខាធិការដ្ឋាន មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ដើម្បី ក្រុមការងារ អាច រៀបចំ កត់ត្រា ថវិកា បរិច្ចាគ ទាំងអស់ ក្នុង បញ្ជី រួម តែ មួយ ដែល បង្ហាញ ពី សាមគ្គីភាព ក្នុង ស្មារតី « ខ្មែរ ជួយ ខ្មែរ » ។
( ភ្នំពេញ ) ៖ ក្រសួង ធនធាន ទឹក និង ឧតុនិយម នៅ ព្រឹក ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ចេញ ព្រឹត្ត បត្រ ព័ត៌មាន និង ព្យាករណ៍ កម្ពស់ ទឹក នៅ តាម បណ្តា ស្ថានីយ ជលសាស្ត្រ ទាំង៨ រួម មាន ស្ថានីយ៖
នាយក រដ្ឋមន្រ្តី ឡាវ នឹង មកដល់ កម្ពុជា នៅ ព្រឹក នេះ ដើម្បី បំពេញ ទស្សនកិច្ច ផ្លូវការ២ ថ្ងៃ
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ថង លូន ស៊ី ស៊ូលីត នាយក រដ្ឋមន្រ្តី ឡាវ នឹង ដឹកនាំ គណៈប្រតិភូ ជាន់ ខ្ពស់ អញ្ជើញ មកដល់ ប្រទេស កម្ពុជា នៅ ម៉ោង ប្រមាណ ៩៖៣០ នាទី ព្រឹក ថ្ងៃទី ១២ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ដើម្បី បំពេញ ទស្សនកិច្ច ផ្លូវការ រយៈពេល ២ ថ្ងៃ នៅ ថ្ងៃទី ១២ - ១៣ ខែកញ្ញា ឆ្នាំ ២០១៩ តាម ការអញ្ជើញ របស់ នាយក រដ្ឋមន្រ្តី កម្ពុជា ។
ក្នុង អំឡុង ទស្សនកិច្ច នេះ លោក នាយក រដ្ឋមន្រ្តី ឡាវ នឹង ជួបពិភាក្សា ទ្វេ ភាគី ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ហើយ ភាគី ទាំង ពីរ ក៏ នឹង អញ្ជើញ ជា អធិបតីភាព ក្នុង ពិធី ចុះហត្ថលេខា លើ ឯកសារ មួយចំនួន និង ធ្វើ សេចក្តីប្រកាស ព័ត៌មាន រួមគ្នា ផងដែរ ។ នេះ បើ តាម ការប្រកាស របស់ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ កម្ពុជា ។
ក្រសួង ការបរទេស បាន កត់សម្គាល់ ថា ដំណើរទស្សនកិច្ច ផ្លូវការ របស់ លោក បណ្ឌិត ថង លូន ស៊ី ស៊ូលីត នៅ កម្ពុជា នេះ នឹង រួមចំណែក កាន់តែ ប្រសើរ ក្នុង ការពង្រឹង និង ពង្រីក បន្ថែម ទៀត នូវ ចំណង មិត្តភាព ជា ប្រពៃណី ដ៏ យូរ លង់ សាមគ្គីភាព ភាតរភាព និង កិច្ចសហប្រតិបត្តិការ ប្រកបដោយ ផ្លែផ្កា រវាង កម្ពុជា និង ឡាវ ៕
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ ពី អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស ចំនួន ១៣លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ . របួស ស្រាល ១២នាក់ និង របួស ធ្ងន់ ៣នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា នៅក្នុង ហេតុការណ៍ គ្រោះថ្នាក់ ចរាចរណ៍ ទាំង ១៣លើក នេះ បណ្ដាលឲ្យ ខូត ខាត ម៉ូតូ ចំនួន ១៤ គ្រឿង . រថយន្ត តូច ១០គ្រឿង . រថយន្ដ ធំ១ គ្រឿង ហើយ មូលហេតុ ដែល បណ្ដាលឲ្យ កើត មាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . មិន ប្រកាត់ ស្ដាំ . ប្រជែង . និង ស្រវឹង ។
ដោយឡែក បើ តាម មេធាវី ការពារ ក្ដី ឱ្យ លោក នាយក រដ្ឋមន្ត្រី សិង្ហបុរី អត្ថបទ ចុះផ្សាយ ខាងលើ គឺជា រឿង មិន ពិត និង ធ្វើឱ្យ ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ ដល់ កិត្តិយស របស់ លោក លី ជាពិសេស ការចោទប្រកាន់ ថា លោក លី សៀន ឡុង បាន ភូត កុហក ឪពុក ខ្លួន ឯង គឺ អតីត នាយក រដ្ឋមន្ត្រី សិង្ហបុរី លោក លី ក្វាន់ យូ ថា ផ្ទះ នៅ ផ្លូវ 38 Oxley ត្រូវបាន ចុះបញ្ជី ជា ទ្រព្យសម្បត្តិ រដ្ឋ ហើយ ដែល នេះ មិន ចាំបាច់ ត្រូវ បំផ្លាញ ផ្ទះ មួយ ខ្នង នេះ ទេ ។
អភិបាល ខេត្ត កំពត បញ្ជា អាជ្ញាធរ យក គ្រឿងចក្រ កាយ ដី ដែល ជន មិន ស្គាល់ អត្តសញ្ញាណ ចាក់ រំលោភ យក ដៃ មាត់ ព្រែក ក្បាល រមាស នៅ ស្រុក ទឹក ឈូ
ការចុះបញ្ជា ផ្ទាល់ របស់ អភិបាល ខេត្ត កំពត ធ្វើឡើង នៅ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ នៅ ភូមិសាស្រ្ត ចំណុច ដៃ ព្រែក ធម្មជាតិ ជិត ស្ពាន ក្បាល រមាស ជាប់ ខាងជើង ផ្លូវ ជាតិ លេខ ៣៣ ស្ថិត ក្នុង ភូមិ ត្រពាំង ធំ ឃុំ ជុំ គ្រៀល ស្រុក ទឹក ឈូ ខេត្ត កំពត ។
លោក ជា វ តាយ បាន បញ្ជាក់ ថា រាល់ ដី សាធារណៈ របស់ រដ្ឋ មិន អាច បុគ្គល ណា មាន សិទ្ធិ កាន់កាប់ ឬ មាន បំណង ទន្ទ្រាន រំលោភ យក មកកាន់កាប់ ដោយ ល្មើស ច្បាប់ បាន ឡើយ ។ ជា ការជាក់ស្ដែង ទីតាំង ដី នេះ គឺជា ដី ដៃ ព្រែក ដែល មាន មុខងារ យ៉ាង សំខាន់ ក្នុង ការដោះ ទឹក នាំចូល ក្នុង ព្រែក ក្បាល រមាស ទៅក្នុង សមុទ្រ ថែម ទៀត ផង ។
លោក អភិបាល ខេត្ត ក៏ បាន ណែនាំ ដល់ មន្រ្តី អាជ្ញាធរ ពាក់ព័ន្ធ ត្រូវតែ កាយ យក អាចម៍ ដី ដែល បាន ចាក់ ចូល ដៃ ព្រែក នេះ ឲ្យបាន ឆាប់ និង ក៏ បាន រលឹក ណែនាំ ដល់ អាជ្ញធរ មូលដ្ឋាន ក៏ ដូច មន្ត្រី សមត្ថកិច្ច ពាក់ព័ន្ធ មុននឹង អនុញ្ញាតឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ធ្វើ ការសុំ ច្បាប់ ចាក់ ដី អភិវឌ្ឍ ទីតាំង អ្វី មួយ ត្រូវតែ ពិនិត្យ ឲ្យបាន គ្រប់គ្រាន់ រាល់ ឯកសារ ឲ្យបាន ត្រឹមត្រូវ ស្រប ច្បាប់ ថា តើ ទីតាំង ដី ដែល ប្រជាពលរដ្ឋ បាន ស្នើសុំ ចាក់ ដី នោះ មាន ប័ណ្ណ កម្មសិទ្ធ កាន់កាប់ ស្រប ច្បាប់ ដែរ ឬ នៅ ។
លោក សង្កត់ធ្ងន់ ថា បើ ពុំ ដូច្នោះ ទេ សូម អាជ្ញាធរ មូលដ្ឋាន សូម កុំ អនុញ្ញាតឲ្យ ចាក់ ដី ឲ្យ សោះ ព្រោះ ការហាមឃាត់ ដូចនេះ គឺ ដើម្បី រួមគ្នា ទប់ស្កាត់ រាល់ បទល្មើស ឬ បុគ្គល ដែល តែងតែ ដើរ រំលោភបំពាន យក ដី រដ្ឋ ឬ ឯកជន ដែល នាំឲ្យ កើត ជា វិវាទ ទំនាស់ ដីធ្លី និង នាំឲ្យ មាន ការលំបាក ដល់ អាជ្ញាធរ ឬ ថ្នាក់ដឹកនាំ ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃពុធ ទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។ ដូច្នេះ បើ ចង់ ដឹង ថា តើ ព្រឹត្តិការណ៍ រូបភាព ប្រចាំ ថ្ងៃ នេះ មាន អ្វី ខ្លះ នោះ សូម ទស្សនា ដូច ខាងក្រោម៖
២៖ អ្នកនាំពាក្យ រដ្ឋាភិបាល ទីក្រុង ប៉េកាំង នា ថ្ងៃពុធ នេះ បាន ព្រមាន ថា ការចង់បាន ឯករាជ្យ នៃ កោះ តៃវ៉ាន់ « គឺជា ផ្លូវ គ្មាន ច្រក ចេញ » ដែល នឹង នាំ ទៅ រក ភាព បរាជ័យ ហើយ វា នឹង បរាជ័យ កាន់តែ ឆាប់ ប្រសិនបើ ពួកគេ ពឹងផ្អែក លើ ការប្រើ កម្លាំង បាយ ៕
៦៖ ពលរដ្ឋ អូស្ត្រាលី បី នាក់ ត្រូវបាន ចាប់ និង ឃុំ ខ្លួន នៅក្នុង ប្រទេស អ៊ីរ៉ង់ ដោយ ពុំ ទាន់ មាន ការបញ្ជាក់ ពី មូលហេតុ ឱ្យ បាន ច្បាស់ នៅឡើយ ទេ ៕ ក្រសួង បរិស្ថាន រកឃើញ សាលា បឋមសិក្សា និង មធ្យមសិក្សា ៦ ដែល ទទួល ជ័យលាភី សាលា មេត្រី បរិស្ថាន ឆ្នាំ ២០១៩
លោកស្រី បាន ថ្លែង ថា ចលនា សាលា មេត្រី បរិស្ថាន កម្ពុជា មិន ត្រឹមតែ ជំរុញ ឱ្យ សិស្សានុសិស្ស លោកគ្រូ អ្នកគ្រូ ប្រតិបត្តិ មេត្រីភាព បរិស្ថាន តែ ក្នុង បរិវេណ សាលារៀន ប៉ុណ្ណោះ ទេ ប៉ុន្តែ ថែមទាំង អនុវត្ត នៅក្នុង សហគមន៍ ជុំវិញ សាលារៀន ផងដែរ ដោយ ចាំបាច់ ត្រូវ មាន កិច្ចសហការ ពី អាណាព្យាបាល សិស្ស អាជ្ញាធរ មូលដ្ឋាន និង អ្នក ពាក់ព័ន្ធ ក្នុង សហគមន៍ ទាំងអស់ ស្រប តាម លក្ខខណ្ឌ វិនិច្ឆ័យ ៤ ចំណុច នៃ សាលា មេត្រី បរិស្ថាន ។
លក្ខខណ្ឌ វិនិច្ឆ័យ ទាំង ៤ចំណុច នៃ សាលា មេត្រី បរិស្ថាន រួម មាន ទី ១៖ មាន គោលការណ៍ និង រដ្ឋបាល របស់ សាលា លើ ការងារ បរិស្ថាន . ទី ២៖ មាន ការបង្រៀន មេរៀន បរិស្ថាន និង សកម្មភាព អប់រំ បរិស្ថាន ក្នុង សាលា និង សហគមន៍ ជុំវិញ ( ជា កម្មវិធី សិក្សា បន្ថែម ឬ បញ្ជ្រាប ) ទី ៣៖ មាន សម្ភារ បរិក្ខារ អប់រំ បរិស្ថាន ហេដ្ឋារចនាសម្ព័ន្ធ នានា និង ការប្រតិបត្តិ បរិស្ថាន ទី ៤៖ មាន ភាពជាដៃគូ ជាមួយ អ្នក ពាក់ព័ន្ធ និង ការផ្សព្វផ្សាយ តាម សហគមន៍ ។
វីដេអូ នេះ លោក កឹម សុខា បាន បញ្ជាក់ ដោយ ខ្លួន ឯង យ៉ាង ច្បាស់ ថា តាំងពី ឆ្នាំ ១៩៩៣ បន្ទាប់ពី ខ្លួន ជាប់ ឆ្នោត ជា តំណាងរាស្ត្រ ដំបូង លោក ត្រូវបាន សហរដ្ឋ អាមេរិក ហៅ ឱ្យ ទៅ សហរដ្ឋ អាមេរិក មុន គេ បង្អស់ ក្នុង នាម អ្នកនយោបាយ ខ្មែរ ហើយ រហូត ឱ្យ លោក លា លែង ពី គណបក្ស នយោបាយ ដែល កំពុង ឈរឈ្មោះ តាម ការបង្គាប់បញ្ជា របស់ បរទេស នៅ ឆ្នាំ ២០០២ ដោយ បាន បង្កើត អង្គការ មួយ ដែល មាន ឈ្មោះ ថា « មជ្ឈមណ្ឌល សិទ្ធិ មនុស្ស កម្ពុជា » ។
តាមរយៈ វីដេអូ នោះ លោក កឹម សុខា បាន បញ្ជាក់ ថា ដើម្បី អនុវត្ត នយោបាយ របស់ ខ្លួន ឱ្យ ទទួលបាន ជោគជ័យ នោះ សហរដ្ឋ អាមេរិក បាន ណែនាំ ឱ្យ លោក យក គម្រូ តាម ការធ្វើ បដិវត្តន៍ របស់ ប្រទេស យ៉ូហ្គោល ស្លាវី និង ប្រទេស ស៊ែប៊ី ដែល បាន ផ្តួលរំលំ រដ្ឋាភិបាល ស្រប ច្បាប់ ដោយ បាន ចោទ ថា ជា របប ដឹកនាំ ផ្តាច់ការ ។
ហើយ ផែនការ ដើម្បី ធ្វើ បដិវត្តន៍ ដើម្បី ផ្តួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ នៅ កម្ពុជា លោក កឹម សុខា បាន បញ្ជាក់ បន្ថែម ទៀត ថា គឺ លោក មិន មែន ធ្វើ តាម ការ នឹកឃើញ របស់ ខ្លួន លោក តែ ម្នាក់ឯង នោះ ទេ គឺ លោក ទទួលបាន ការបណ្តុះបណ្តាល ពី ក្រុម អ្នកជំនាញ ការ សាស្ត្រាចារ្យ នៅ សាកលវិទ្យាល័យ ក្នុង ទីក្រុង វ៉ាស៊ីនតោន និង ប្រទេស កាណាដា ដែល អាមេរិក បាន ជួល មក ដើម្បី ផ្តល់ ជា យុទ្ធសាស្ត្រ ដល់ លោក ដើម្បី ផ្លាស់ប្តូរ មេដឹកនាំ នៅ កម្ពុជា ។
ពាក់ព័ន្ធ នឹង លាតត្រដាង របស់ លោក កឹម សុខា អំពី ផែនការ ផ្តួលរំលំ រាជ រដ្ឋាភិបាល កម្ពុជា នេះ នា ពេល កន្លងទៅ សម្តេច ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ធ្លាប់ បាន ចោទ ជា សំណួរ ថា តើ ចំពោះ រឿង នេះ លោក កឹម សុខា ជា អ្នក ចោទប្រកាន់ អាមេរិក តែ ម្នាក់ឯង ឬ ក៏ អាមេរិក ជា អ្នក ចោទប្រកាន់ លោក កឹម សុខា ?
សូម បញ្ជាក់ ថា ការចេញ វីដេអូ ចំនួន ៣ ដែល ជា មូលហេតុ នាំឱ្យ មាន ការចាប់ខ្លួន លោក កឹម សុខា បាន ធ្វើឡើង បន្ទាប់ពី អ្នកនាំពាក្យ ក្រសួង ការបរទេស សហរដ្ឋ អាមេរិក បាន ចេញ វីដេអូ មួយ អំពាវនាវ ឱ្យ រដ្ឋាភិបាល កម្ពុជា ទម្លាក់ ចោល ការចោទប្រកាន់ លើ លោក កឹម សុខា ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ បាន ចេញ សេចក្តីថ្លែងការណ៍ មួយ នៅ យប់ ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ ដោយ ឆ្លើយតប ចំពោះ សេចក្តីថ្លែងការណ៍ របស់ លោក ស្រី Morgan Ortagus អ្នកនាំពាក្យ ក្រសួង ការបរទេស សហរដ្ឋ អាមេរិក ។
អ្នកនាំពាក្យ ក្រសួង ការបរទេស កម្ពុជា ក៏ បាន រលឹក ទៀត ថា « ការបរាជ័យ ក្នុង ការប៉ុនប៉ង ជំរុញ ឱ្យ មាន ការផ្លាស់ប្តូរ របប តាមរយៈ មធ្យោបាយ មិន មែន ប្រជាធិបតេយ្យ មិន មែន ជា ការអនុវត្ត សិទ្ធិ មនុស្ស ជា មូលដ្ឋាន និង លទ្ធិ ប្រជាធិបតេយ្យ នោះ ទេ ។ រាជ រដ្ឋាភិបាល កម្ពុជា មាន សិទ្ធិ អធិបតេយ្យ ពេញលេញ ក្នុង ការចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ចាំបាច់ ចំពោះ បុគ្គល និង អង្គភាព ទាំងឡាយ ណា ដែល រំលោភ រដ្ឋធម្មនុញ កម្ពុជា និង ច្បាប់ ជាធរមាន ផ្សេង ទៀត សំដៅ ការពារ សន្តិសុខ ជាតិ និង នីតិរដ្ឋ របស់ ខ្លួន »៕
ខាងក្រោម នេះ ជា វីដេអូ ដែល បង្ហាញ ដោយ ក្រសួង យុត្តិធ ម៌៖ សម្តេច តេជោ បង្គាប់ឱ្យ បើក បៀវត្ស សម្រាប់ ខែកញ្ញា និង ប្រាក់ ឧបត្ថម្ភ ៥ម៉ឺន រៀល ជូន មន្ត្រីរាជការ នៅ សប្តាហ៍ ទី ពីរ ដើម្បី អបអរ បុណ្យ ភ្ជុំ បិណ្ឌ
( ភ្នំពេញ ) ៖ ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ឆ្នាំ ២០១៩ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន សម្រេច បើក ប្រាក់ បៀវត្ស សម្រាប់ ខែកញ្ញា សរុប តែ មួយ លើក និង ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ចំនួន ៥ម៉ឺន រៀល ក្នុង ម្នាក់ ជូន ដល់ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ មន្ត្រី ជាប់ កិច្ចសន្យា បុគ្គលិក អណ្តែត និង មន្ត្រី ចូល និវត្តន៍ នៅ ទូទាំង ប្រទេស ក្នុង សប្តាហ៍ ទី ពីរ នៃ ខែកញ្ញា តែម្តង ។
ការសម្រេច បែប នេះ របស់ ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង នៅ ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ក្នុង កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្រ្តី ដើម្បី ពិភាក្សា និង ឆ្លង របៀបវារៈ មួយចំនួន នៅ វិមាន សន្តិភាព ។
តាម សេចក្តីប្រកាស លទ្ធផល នៃ កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បង្ហាញ ថា ក្នុង កិច្ចប្រជុំ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា ក្នុង ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ឆ្នាំ កុរ ព.ស.២៥៦៣ នេះ រាជ រដ្ឋាភិបាល បាន សម្រេច បើក ប្រាក់ បៀវត្ស សម្រាប់ ខែកញ្ញា សរុប តែ មួយ លើក ព្រមទាំង ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ចំនួន ៥ម៉ឺន រៀល ក្នុង ម្នាក់ ជូន ដល់ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ មន្ត្រី ជាប់ កិច្ចសន្យា បុគ្គលិក អណ្តែត និង មន្ត្រី ចូល និវត្តន៍ ក្នុង សប្តាហ៍ ទី ពីរ នៃ ខែកញ្ញា ។
( ពោធិ៍សាត់ )៖ មាន ករណី អំពើហិង្សា ២ករណី ផ្សេង កើតឡើង ដោយសារតែ ផឹក ស្រា ស្រវឹង ដោយ ស្ត្រី ម្នាក់ ទាញ កាំបិត ចាក់ ប្តី ធ្លាយ ពោះវៀន និង ម្នាក់ ទៀត ស្រវឹង ស្រា វាយ ប្រពន្ធ បែក ក្បាល ហូរ ឈាម ។
ករណី ទី១៖ ស្ត្រី ម្នាក់ មេ ផ្ទះ ទំនង ទាស់ ពាក្យសម្តី ជាមួយ ប្តី ទ្រាំ មិន បាន ក៏ ទាញ កាំបិត ខ្លី ចាក់ ប្តី បណ្តាលឱ្យ ធ្លាយ ពោះរបួស ធ្ងន់ ត្រូវ ក្រុមគ្រួសារ បញ្ជូន ទៅ សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ បង្អែក ពោធិ៍សាត់ ខេត្ត ពោធិ៍សាត់ ។
ហេតុការណ៍ ដ៏ កម្រ នេះ បាន កើតឡើង កាលពី វេលា ម៉ោង ០៤៖៣០ នាទី ល្ងាច ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ ត្រង់ ចំណុច ផ្ទះ ជនរងគ្រោះ ស្ថិត ក្នុង ភូមិ ដីក្រហម ឃុំ អន្លង់ រាប ស្រុក វាលវែង ខេត្ត ពោធិ៍សាត់ ។
លោក ធាង ឡេង បាន បន្ត ថា មុនពេល កើត ហេតុ ជនសង្ស័យ បាន ផឹក ស្រា ស្រវឹង ជោគជាំ ដោយ ហេតុតែ ញៀន ស្រា ជាប្រចាំ ជនសង្ស័យ បាន ធ្លោយ ប្រើ ពាក្យ សម្តី មិន សាកសម ទៅ លើ ប្តី កំសត់ រហូត ឈានដល់ ប្រើប្រាស់ អំពើហឹង្សា ទាញ កាំបិត ខ្លី ចាក់ ទៅ លើ ប្តី បណ្តាលឱ្យ រងរបួស ធ្ងន់ ធ្លាយ ពោះ ផ្នែក ខាងឆ្វេង ដៃ បញ្ជូន ទៅ សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត ពោធិ៍សាត់ ។
បច្ចុប្បន្ន ជនរងគ្រោះ បាន ធូរស្រាល បន្តិច ហើយ រង់ចាំ ព្យាបាល បន្ត ដោយឡែក ស្ត្រី មេផ្ទះ ជើង ខ្លាំង ដែល ស្រវឹង ខួប ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន បញ្ជូន ទៅ អធិការដ្ឋាន នគរបាល ស្រុក វាលវែង ចាត់ការ តាម នីតិវិធី ។
ករណី ទី២៖ នៅ ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ នៅឯ ភូមិ កំពែង ឃុំ ព្រងិល ស្រុក ភ្នំ ក្រវាញ ឯណោះ វិញ សមត្ថកិច្ច ក៏ បាន ធ្វើ ការឃាត់ខ្លួន ជនសង្ស័យ ជា ប្តី ម្នាក់ មាន ឈ្មោះ ទិត សេង លី អាយុ ៥៦ ឆ្នាំ បាន ផឹក ស្រា ស្រវឹង ទាញ បំពង់ ទឹក ក្តៅ វាយ ទៅ លើ ជនរងគ្រោះ ជា ប្រពន្ធ មាន ឈ្មោះ វេន ផល្លី អាយុ ៥៣ ឆ្នាំ ត្រូវ ក្បាល ខាងឆ្វេង បណ្តាលឱ្យ បែក ក្បាល ហូរ ឈាម ដេរ ចំនួន ៣ថ្នេរ ។ ចំពោះ ករណី នេះ សមត្ថកិច្ច សន្យា អប់រំ និង ឱ្យ ត្រលប់ ទៅ ផ្ទះ វិញ ផងដែរ ៕
ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី និង អភិបាល ខេត្ត កំពង់ចាម ចុះ ពិនិត្យ ស្ថានភាព ទឹក ជំនន់ ក្នុង ក្រុង កំពង់ចាម
( កំពង់ចាម ) ៖ ឧប នាយក រដ្ឋមន្ត្រី យឹម ឆៃលី ប្រធាន ក្រុមប្រឹក្សា ស្តារ អភិវឌ្ឍន៍ វិស័យ កសិកម្ម និង ជនបទ និង លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម នា រសៀល ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ ស្ថានភាព ទឹក ជំនន់ នៅ ជុំវិញ ក្រុង កំពង់ចាម ដើម្បី ទប់ស្កាត់ គ្រោះថ្នាក់ ណាមួយ ដែល កើតឡើង ជា យថាហេតុ ។
សូម បញ្ជាក់ ផងដែរ ថា គិត ត្រឹម ម៉ោង ១២ ថ្ងៃត្រង់ ថ្ងៃទី ១១ ខែកញ្ញា នេះ កម្ពស់ ទឹក ក្នុង ខេត្ត កំពង់ចាម មិន ឡើង មិន ចុះ គឺ ស្ថិត ក្នុង កម្ពស់ ១៥. ៧៥ម៉ែត្រ ស្មើនឹង កម្ពស់ កាលពី វេលា ម៉ោង ៦ព្រឹក ថ្ងៃ ដដែល នេះ ។
ទោះជា យ៉ាងណា ក៏ដោយ អាជ្ញាធរ ខេត្ត បាន ត្រៀម ម៉ាស៊ីន បូម ទឹក នៅ ចំណុច ជិត ស្ពាន គីសូណា មួយ កន្លែង និង នៅ មាត់ ទន្លេ ជិត ផ្សារ ថ្ម គោល ក្នុង សង្កាត់ បឹង កុក មួយ កន្លែង ដើម្បី ត្រៀមលក្ខណៈ បូម ទឹក ចេញ ពី ក្រុង នៅពេល មាន ទឹក ជំនន់ ជន់ ហូរ ចូល ផងដែរ ៕
EDC ផ្អាក ផ្គត់ផ្គង់ អគ្គិសនី នៅ តំបន់ មួយចំនួន ទៅ តាម ពេលវេលា និង ទីកន្លែង ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្តាល ចាប់ពី ថ្ងៃទី ១២ ដល់ ថ្ងៃទី ១៥ ខែកញ្ញា
( ភ្នំពេញ ) ៖ អគ្គិសនី កម្ពុជា (EDC) បាន ចេញ សេចក្ដីជូនដំណឹង ស្ដីពី ការផ្អាក ផ្គត់ផ្គង់ ចរន្ត អគ្គិសនី ចំនួន ៤ ថ្ងៃ ចាប់ពី ថ្ងៃទី ១២ - ១៤ ខែកញ្ញា ឆ្នាំ ២០១៩ តាម តំបន់ មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ និង ខេត្ត កណ្ដាល ដើម្បី អនុវត្ត ការងារ ជួសជុល ផ្លាស់ប្តូរ តម្លើង បរិក្ខារ នានា និង រុះរើ គន្លង ខ្សែ បណ្តាញ បង្ក លក្ខណៈ ដល់ ការដ្ឋាន ពង្រីក ផ្លូវ ៕
សម្រាប់ ព័ត៌មាន លម្អិត សូម អាន សេចក្ដីជូនដំណឹង របស់ អគ្គិសនី កម្ពុជា ទាំង ស្រុង៖ ប្រធានាធិបតី អ៊ីរ៉ង់៖ « ការល្មោភ សង្រ្គាម របស់ អាមេរិក ប្រឆាំង មក លើ អ៊ីរ៉ង់ នឹង គ្មាន ថ្ងៃ ជោគជ័យ ឡើយ »
អតិថិជន ឆ្នោត មហាសំណាង កោស ១សន្លឹក មាន ឱកាស ឈ្នះ រង្វាន់ ធំ លុយ សុទ្ធ ៤០ លាន រៀល ពិតជា មិន ធម្មតា មែន !
ពិតជា គួរឲ្យ រំភើប និង ត្រេកអរ ជំនួស អតិថិជន មាន សំណាង លោក ពូ ទូច លាភី អាយុ ៥១ ឆ្នាំ បាន ចំណាយ ថវិកា ត្រឹមតែ ៤ពាន់ រៀល ប៉ុណ្ណោះ ក៏ បាន ឈ្នះ រង្វាន់ ធំ រហូតដល់ ៤០ លាន រៀល ពី ឆ្នោត កោស ផ្សង សំណាង ឈ្មោះ « ឃ្មុំ មាស » ។ រង្វាន់ ធំ ឆ្នោត មហាសំណាង ទឹកប្រាក់ ៤០ លាន រៀល នេះ មិន មែន ឈ្នះ ជា លើក ទី មួយ នោះ ទេ កន្លងមក ឆ្នោត មហាសំណាង បាន ប្រគល់ រង្វាន់ ធំ ៗ យ៉ាង ច្រើន សន្ធឹកសន្ធាប់ ជូន ដល់ បណ្តា អតិថិជន ទូទាំង ២៥ រាជធានី ខេត្ត - ក្រុង ដែល តែងតែ និយម គាំទ្រ និង ផ្សង សំណាង ឆ្នោត មហាសំណាង ។
គួរ បញ្ជាក់ ផងដែរ ថា ក្រុមហ៊ុន ឆ្នោត មហាសំណាង គឺជា ប្រតិបត្តិករ ឆ្នោត កម្សាន្ត ផ្សង សំណាង ស្រប ច្បាប់ ដែល ទទួលបាន អាជ្ញាបណ្ណ ពី រាជ រដ្ឋាភិបាល កម្ពុជា ដើម្បី ប្រតិបត្តិការ លក់ ឆ្នោត ឡូតូ ៥ខ្ទង់ ជាមួយ រង្វាន់ លួង ចិត្ត ២ខ្ទង់ និង ៣ខ្ទង់ និង ឆ្នោត កោស ភ្លាម ឈ្នះ ភ្លាម ។ ប្រភេទ ឆ្នោត កោស ភ្លាម ឈ្នះ ភ្លាម មាន រង្វាន់ យ៉ាង ធំ សន្ធឹកសន្ធាប់ ប្រាក់ រង្វាន់ រហូតដល់ ៨៨ លាន រៀល ។
លើស ពី នេះ ក៏ មាន ប្រភេទ ឆ្នោត ដែល កំពុង ពេញនិយម គាំទ្រ យ៉ាង ខ្លាំង នៅលើ ទីផ្សារ មាន ដូចជា ឆ្នោត កោស យាយ សំក្តីស្រមៃ ឆ្នោត កោស យាយ សំយាយ សយ ឆ្នោត កោស សប្បាយ កោស ឆ្នោត កោសឃ្មុំ មាស ឆ្នោត កោស បាល់ទាត់ ពិភពលោក និង ប្រភេទ ឆ្នោត កោស ដទៃ ផ្សេង ៗ ទៀត ។ ឆ្នោត មហាសំណាង មា ន កេរិ៍ត ឈ្មោះ ល្បីល្បាញ ទទួលបាន ការគាំយ៉ាង ខ្លាំង ជាមួយ ការកម្សាន្ត សប្បាយ ផ្សង សំណាង ពីសំណាក់ មហាជន ក្នុង ប្រទេស កម្ពុជា ។
( ក្រចេះ ) ៖ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ចំនួន ៨៥៧ គ្រួសារ នៅ ភូមិ ចំនួន ៤ ស្ដិត នៅ ឃុំ ដា ស្រុក ចិត្រ បុរី ខេត្ដ ក្រចេះ នៅ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន ទួល ព្រះរាជ អំណោយ ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង សម្ដេច ព្រះមហាក្សត្រីន រោត្ដម មុនិនា ថ សីហនុ ព្រះវរាជ មាតា ជាតិ ខ្មែរ តាមរយៈ សម្ដេច ចៅហ្វា វាំង គង់ សំអុល ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង ព្រះបរម រាជ វាំង និង ជា ព្រះរាជ តំណាង ដ៏ ខ្ពង់ខ្ពស់ របស់ ព្រះមហាក្សត្រ ។
ក្នុង ពិធី ចែក ព្រះរាជ អំណោយ នោះ ដែរ ដោយ មាន ការចូលរួម ពី លោក គុយ សុផល ឧត្ដម ក្រុមប្រឹក្សា ផ្ទាល់ ព្រះមហាក្សត្រ លោក វ៉ា ថន អភិបាល ខេត្ត ក្រចេះ លោក - លោកស្រី ជា តំណាង កាកបាទ ក្រហម កម្ពុជា តំណាង ក្រសួង ស្ថាប័ន នានា ព្រមទាំង អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ ក្រោម ឱវាទ ។
សម្ដេច ចៅហ្វា វាំង គង់ សំអុល ព្រះរាជ តំណាង ព្រះមហាក្សត្រ បាន ពាំនាំ នូវ ព្រះរាជ បណ្ដាំ សាកសួរ សុខទុក្ខ និង ព្រះរាហ ឬ អាណិត ស្រឡាញ់ និង សេចក្ដី នឹករលឹក យ៉ាង ជ្រាលជ្រៅ បំផុត របស់ ព្រះករុណា ព្រះបាទ សម្ដេច ព្រះបរម នាថ នរោត្ដម សីហមុនី និង សម្ដេច ព្រះមហាក្សត្រី ព្រះវរាជ មាតា ជាតិ ខ្មែរ ជា ទី សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ជូន ចំពោះ បងប្អូន កូន ចៅ ចៅ ទូត នៅ ទូទាំង ប្រទេស ពិសេស ព្រះហឬ ទ័យ យកចិត្តទុកដាក់ ចំពោះ ជីវភាព រស់ នៅ របស់ បងប្អូន ប្រជារាស្ត្រ របស់ ព្រះអង្គ ។
ជាមួយគ្នា នេះ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន តែងតែ យកចិត្តទុកដាក់ និង មាន វិធានការ ក្នុង ការជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ផ្សេង ៗ បាន ទាន់ ពេលវេលា នៅ គ្រប់ ទីកន្លែង ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ ពណ៌ សម្បុរ ជាតិ សាសន៍ ណាមួយ ឡើយ ។
ឱកាស បវេសនកាល ឆ្នាំ សិក្សា ថ្មី សិក្សា ដើម្បី ការងារ និង មុខរបរ នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស
សាកលវិទ្យាល័យ មាន អគារ សិក្សា ផ្ទាល់ខ្លួន ធំ ទូលាយ កណ្តាល រាជធានី ភ្នំពេញ សម្ភារ រូបវន្ត ទំនើប សាស្រ្តាចារ្យ មាន សមត្ថភាព វិជ្ជាជីវៈ ខ្ពស់ មាន ដៃគូ ផ្តល់ ការងារ និង ដៃគូ អន្តរជាតិ ជាច្រើន ។ សិក្សា នៅ សាកលវិទ្យាល័យ ធនធាន មនុស្ស ដើម្បី ទទួលបាន នូវ ឧត្តមភាព សមត្ថភាព ជំនាញ និង ឱកាស ការងារ ជាង ៩០% ។
ក្រុមហ៊ុន ព្រូដិនសល កម្ពុជា បើក សម្ពោធ សាខា ថ្មី ក្នុង ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ ព្រូដិនសល កម្ពុជា ដែល ជា ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត ឈានមុខ គេ នៅ កម្ពុជា បាន បើក សម្ពោធ សាខា ថ្មី របស់ ខ្លួន ដើម្បី ពង្រីក អាជីវកម្ម ក្នុង ខេត្ត ក្រចេះ ។ ការបង្កើត សាខា ថ្មី មួយ នេះ ក៏ ដើម្បី បំពេញ តម្រូវ ដែល កំពុងតែ កើន ឡើង ឥត ឈប់ឈរ លើ សន្តិសុខ ហិរញ្ញវត្ថុ និង ការរៀបចំ គម្រោង ហិរញ្ញវត្ថុ រយៈពេល វែង ព្រមទាំង ផ្ដល់ នូវ សន្តិភាព ផ្លូវចិត្ត ដល់ ក្រុម គួ្រសារ នៅ កម្ពុជា ។
ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ នេះ ត្រូវបាន ធ្វើឡើង ក្រោម អធិបតីភាព លោក ទុយ ប៊ុន សេរី រ័ត្ន មុនី អភិបាល រង ខេត្ត ក្រចេះ . លោក David Nutman នាយក ប្រតិបត្តិ ក្រុមហ៊ុន ព្រូដិនសល កម្ពុជា និង លោក អ៊ិន មាត្រា តំណាង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ព្រមទាំង ភ្ញៀវ កិត្តិយស និង បុគ្គលិក ក្រុមហ៊ុន ព្រូដិនសល ផងដែរ ។ សាខា ថ្មី នេះ មាន ទីតាំង ស្ថិត នៅលើ ផ្លូវ ព្រះសីហនុ នៅ កណ្តាល ក្រុង ក្រចេះ តែម្តង ។
ពិធី បើក សម្ពោធ សាខា ថ្មី នេះ មាន ន័យ ថា ក្រុមហ៊ុន ព្រូដិនសល កម្ពុជា បច្ចុប្បន្ន មាន វត្តមាន នៅ ខេត្ត ក្រចេះ ខេត្ត សៀមរាប ខេត្ត បាត់ដំបង និង រាជធានី ភ្នំពេញ ។ ក្រុមហ៊ុន ក៏ មាន គម្រោង ពង្រីក អាជីវកម្ម របស់ ខ្លួន បន្ថែម ទៀត ដើម្បី គ្របដណ្តប់ ទីក្រុង សំខាន់ ៗ ដទៃ ទៀត នា ពេល អនាគត ផងដែរ ។ ផលិតផល ធានារ៉ាប់រង អាយុជីវិត របស់ ក្រុមហ៊ុន ព្រូដិនសល កម្ពុជា ក៏ អាច រក បាន តាមរយៈ ធនាគារ អេស៊ីលីដា ដែល ជា ធនាគារ ដៃគូ របស់ ក្រុមហ៊ុន ចាប់តាំងពី ឆ្នាំ ២០១៣ ដែល មាន សាខា ចំនួន ១៥៦ ទូទាំង ប្រទេស ។
លោក David Nutman បាន ថ្លែង ថា « ក្រុមហ៊ុន ព្រូដិនសល កម្ពុជា មាន មោទនភាព ដែល ក្លាយជា ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត ឈានមុខ គេ នៅក្នុង ប្រទេស និង ជា ក្រុមហ៊ុន ដែល អតិថិជន មាន ជំនឿ ទុកចិត្ត បំផុត ។ យើង ប្តេជ្ញា បម្រើ សេចក្តីត្រូវការ លើ ការការពារ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ និង ជួយ ពួកគាត់ ឱ្យ សម្រេច គោលដៅ ហិរញ្ញវត្ថុ រយៈពេល វែង របស់ ពួកគាត់ តាមរយៈ ការផ្តល់ ជូន នូវ សេវាកម្ម ជំនាញ និង ដំណោះស្រាយ ដ៏ ល្អ បំផុត របស់ យើង » ។
នា ពេល ថ្មី នេះ ៗ ក្រុមហ៊ុន ព្រូដិនសល កម្ពុជា សម្រច បាន នូវ សមិទ្ធផល ដ៏ អស្ចារ្យ មួយ ដែល បាន ក្លាយជា ក្រុមហ៊ុន ធានារ៉ាប់រង អាយុជីវិត ដំបូង គេ បង្អស់ នៅ កម្ពុជា ដែល បាន លក់ បណ្ណ សន្យា រ៉ាប់រង ចំនួន ២០ម៉ឺន បណ្ណ ដោយ ក្នុង នោះ មាន ទឹកប្រាក់ ការពារ និង សន្សំ សរុប ប្រមាណ ជាង ៤.៣ ពាន់ លាន ដុល្លារ ( គិត ត្រឹម ខែមិថុនា ឆ្នាំ ២០១៩ ) ដែល នេះ ជា ការឆ្លុះបញ្ចាំង ពី ការកើនឡើង នូវ ទំនុកចិត្ត លើ ផលិតផល និង សេវាកម្ម ផ្សេង ៗ របស់ ក្រុមហ៊ុន ។
លោក បន្ដ ថា វិស័យ ធានារ៉ាប់រង មាន សមាសធាតុ ២សំខាន់ ៗ គឺ ការផ្តល់ ការសន្សំ សំចៃ ប្រាក់ និង ការការពារ ដែល ខុសពី វិស័យ ផ្សេង ទៀត ។ សូម លើកទឹកចិត្ត ឱ្យ ក្រុមហ៊ុន ពង្រឹង ទំនុកចិត្ត និង ការជឿជាក់ សម្រាប់ អតិថិជន របស់ ខ្លួន និង សូម ជូនពរ ឱ្យ ព្រូដិនសល ជួប ការ ជោគជ័យ ក្នុង អាជីវកម្ម របស់ ខ្លួន ៕
អគ្គ នាយកដ្ឋាន ពន្ធដារ អញ្ជើញ ម្ចាស់ ក្រុមហ៊ុន ពីរ ទៀត ឲ្យ ចូលមក ទូទាត់ បំណុល ពន្ធ ជំពាក់ រដ្ឋ
លោក ហង្ស ពុទ្ធា បាន បញ្ជាក់ បែប នេះ ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន នៅឯ ព្រលានយន្តហោះ អន្តរជាតិ ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ បន្ទាប់ពី លោក បាន បញ្ចប់ ការបំពេញ ទស្សនកិច្ច ផ្លូវការ នៅ ប្រទេស រុស្ស៉ី ដើម្បី ស្វែងយល់ និង ស្រង់ យក បទពិសោធន៍ ពាក់ព័ន្ធ នឹង ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ក្នុង ដំណើរការបោះឆ្នោត ជាមួយនឹង គ.ជ. ប មកពី ប្រទេស ប្រមាណ ជា៣០ ផ្សេង ទៀត ។
លោក ហង្ស ពុទ្ធា បាន គូសបញ្ជាក់ ថា ការទៅ បំពេញ ទស្សនកិច្ច នៅ ប្រទេស រុស្ស៉ី នេះ គឺ បាន ធ្វើ ការងារ សំខាន់ ចំនួន ពី រ៖ ១៖ ចូលរួម សន្និសីទ អន្ត ជាតិ ស្តីពី « ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ក្នុង ដំណើរការបោះឆ្នោត » និង ២៖ ចូលរួម សង្កេតមើល ការបោះឆ្នោត សភា ជាន់ ទាប នៅ ទីក្រុង ម៉ូស្គូ
លោក បាន បន្ថែម ថា ការបោះឆ្នោត ដោយ ប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ក្នុង ដំណើរការបោះឆ្នោត គឺ ប្រទេស រុស្ស៉ី ជា អ្នករៀបចំ ធ្វើ មុន គេ ហើយ គ.ជ. ប នៃ កម្ពុជា និង ប្រទេស ជាង ៣០ ទៀត ជា អ្នកចូលរួម ស្វែងយល់ និង ស្រង់ យក បទពិសោធន៍ ។
ពាក់ព័ន្ធ នឹង សំណួរ សួរ ថា តើ គ.ជ. ប នៃ កម្ពុជា នឹង ប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ក្នុង ដំណើរការបោះឆ្នោត ដែរ ឬ ទេ ? លោក ហង្ស ពុទ្ធា បាន ពន្យល់ ថា លោក នឹង ធ្វើ របាយការណ៍ ពី ដំណើរការបោះឆ្នោត ដោយ ប្រើ ប្រព័ន្ធ ឌីជីថល នេះ ដាក់ ជូន សមាជិក គ.ជ. ប និង គណៈកម្មការ ជំនាញ ដើម្បី សិក្សា បន្ថែម ថា តើ យើង គួរ ប្រើប្រាស់ ឬ មិន ប្រើប្រាស់ ប្រព័ន្ធ បោះឆ្នោត ឌីជីថល នេះ ?
ប៉ុន្តែ លោក យល់ឃើញ ថា ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ក្នុង ដំណើរការបោះឆ្នោត គឺ ល្អ ប៉ុន្តែ មិន ប្រាកដ ថា អាច អនុវត្តន៍ នៅក្នុង ក្របខ័ណ្ឌ ប្រទេស កម្ពុជា បាន នៅឡើយ ទេ ក្នុង ស្ថានភាព បច្ចុប្បន្ន នេះ ។ ប្រទេស កម្ពុជា ត្រូវការ ច្បាប់ ថវិកា សមត្ថភាព មន្ត្រី ប្រព័ន្ធ អគ្គិសនី និង ប្រព័ន្ធ អ៊ិនធឺណិត ... ។
កត្តា អវិជ្ជមាន មាន ជា អាទិ៍៖
* គេ អាច ប្រើ បណ្តាញ សង្គម ដោយ ខ្វះ សីលធម៌ និង វិជ្ជាជីវៈ បម្រើ ក្រុម នយោបាយ ណាមួយ ដែល រារាំង ការរីកចម្រើន នៃ ប្រជាធិបតេយ្យ និង ការបោះឆ្នោត តាមរយៈ ការផ្សព្វផ្សាយ ព័ត៌មាន ដែល ធ្វើឱ្យ មាន ការភាន់ច្រឡំ មាន កាន់តែ ច្រើន
* ជន អនាមិក ខាងក្នុង និង ខាងក្រៅ ប្រទេស អាច វាយប្រហារ លើ ប្រព័ន្ធ កុំព្យូទ័រ ជាដើម ។ ចំពោះ ការចូលរួម សង្កេតការណ៍ បោះឆ្នោត សភា ជាន់ ទាប នៅ ទីក្រុង ម៉ូស្គូ វិញ លោក ហង្ស ពុទ្ធា បាន វាយតម្លៃ ក្នុង កម្រិត ដែល លោក បាន ពិនិត្យមើល ឃើញ ថា មាន តំបន់ ខ្លះ នៅ ប្រទេស រុស្ស៉ី បាន ប្រើ ប្រព័ន្ធ ឌីជីថល និង តំបន់ ខ្លះ ទៀត មិន បាន ប្រើ ប្រព័ន្ធ ឌីជីថល ទេ ។ ជា រួម ការបោះឆ្នោត នៅ ទីក្រុង ម៉ូស្គូ ប្រទេស រុស្ស៉ី បាន ប្រព្រឹត្តទៅ ដោយ រលូន ។
លោក បាន ជម្រាប ជូន ថា គ.ជ. ប នៃ កម្ពុជា បាន ប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល ខ្លះ រួច មកហើយ គឺ ការប្តូរ ពី ការចុះឈ្មោះ អ្នកបោះឆ្នោត ដោយ ដៃ មក ចុះឈ្មោះ ដោយ ប្រព័ន្ធ កុំព្យូទ័រ ។ គ.ជ. ប ក៏ កំពុង ពិចារណា លើក ការបង្កើត កម្មវិធី ចុះបញ្ជី គណបក្ស នយោបាយ ឈរឈ្មោះ បោះឆ្នោត និង បញ្ជី បេក្ខជន ឈរឈ្មោះ ដោយ ប្រើប្រាស់ ប្រព័ន្ធ កុំព្យូទ័រ សម្រាប់ ការបោះឆ្នោត នៅពេល ខាងមុខ ៕ អភិបាល ខេត្ត ពោធិ៍សាត់ ជួប សំណេះសំណាល និង ផ្តល់ កំព្យូទ័រ យួរ ដៃ ម្នាក់ ១គ្រឿង ជូន បេក្ខជន ទទួល និទ្ទេស A ទាំង ៧រូប
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នា រសៀល ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន អនុញ្ញាតឱ្យ លោកគ្រូ អ្នកគ្រូ អាណាព្យាបាល សិស្ស ជាពិសេស បេក្ខជន ខេត្ត ពោធិ៍សាត់ ដែល បាន ទទួល និទ្ទេស A ទាំង ០៧ រូប ក្នុង ការប្រឡង សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ឆ្នាំ ២០១៩ ចូល ជួប សំណេះសំណាល និង សម្តែង ការគួរសម នៅ បន្ទប់ ការិយាល័យ ផ្ទាល់ របស់ លោក នា សាលា ខេត្ត ពោធិ៍សាត់ ។
បេក្ខជន ទាំង ០៧ រូប ក្នុង ម្នាក់ ត្រូវបាន ទទួល កុំព្យូទ័រ យួរ ដៃ ចំនួន ០១ គ្រឿង និង ថវិកា ៣០ ម៉ឺន រៀល ដើម្បី លើកទឹកចិត្ត និង អបអរសាទរ ចំពោះ ការខិតខំ ប្រឹងប្រែង ។ ដោយឡែក លោកគ្រូ អ្នកគ្រូ ១២នាក់ ម្នាក់ ៗ ទទួលបាន ថវិកា ៥០ ម៉ឺន រៀល . អាណាព្យាបាល សិស្ស ១៤នាក់ ម្នាក់ ៗ ទទួលបាន សារុង៣ និង ថវិកា ៥ម៉ឺន រៀល ។
លោក ម៉ៅ ធ និន បាន សម្តែង អារម្មណ៍ មោទនភាព ខ្ពស់ ជាមួយនឹង កិច្ច ខិតខំ ប្រឹងប្រែង រៀនសូត្រ របស់ ក្មួយ ៗ គ្រប់ គ្នា រហូត ទទួលបាន ជោគជ័យ ប្រលង ជាប់ សញ្ញាបត្រ មធ្យមសិក្សា ទុតិយភូមិ ដែល ប្រព្រឹត្តទៅ កាលពី ថ្ងៃទី ១៩ - ២០ ខែសីហា ឆ្នាំ ២០១៩ កន្លងទៅ ជាពិសេស ខេត្ត ពោធិ៍សាត់ ទទួលបាន និទ្ទេស A ចំនួន ០៧ នាក់ ។
ជាមួយគ្នា នោះ លោក ក៏ សូម ថ្លែងអំណរគុណ ចំពោះ មាតាបិតា លោកគ្រូ អ្នកគ្រូ ក្រុមការងារ ចុះ ជួយ មូលដ្ឋាន និង បណ្តាល អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន រួមចំណែក ផ្គត់ផ្គង់ ជំរុញ លើកទឹកចិត្ត បង្ហាត បង្រៀន ក្មួយ ៗ ទាំងអស់ គ្នា រហូត ទទួលបាន ជោគជ័យ នា ថ្ងៃ នេះ ។
លោក ម៉ៅ ធ និន បាន ក្រើន រំឮ ក ឱ្យ ក្មួយ ៗ បន្ត កិច្ច ខិតខំ ប្រឹងប្រែង សិក្សា រៀនសូត្រ តទៅទៀត ដើម្បី សម្រេចបាន នូវ ក្តីស្រមៃ របស់ ខ្លួន នា ពេល អនាគត និង បាន មក រួមចំណែក អភិវឌ្ឍន៍ ខេត្ត របស់ យើង ឱ្យ កាន់តែ រីកចម្រើន ក្រោម ដំបូល សន្តិភាព ដ៏ រឹងមាំ នេះ ៕ វិទ្យាស្ថាន អាស៊ី កម្ពុជា ខេត្ត ក្រចេះ បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេសជា ដៃគូ ដើម្បី អភិវឌ្ឍន៍ វិស័យ អប់រំ របស់ ខ្លួន
( ក្រចេះ ) ៖ វិទ្យាស្ថាន អាស៊ី កម្ពុជា ខេត្ត ក្រចេះ បាន បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេសជា ដៃគូរ ដើម្បី អភិវឌ្ឍន៍ វិស័យ អប់រំ របស់ ខ្លួន ពង្រឹង នូវ គុណភាព និង សមត្ថភាព អប់រំ សិក្សា របស់ ខ្លួន ក្នុង ការប្រកួតប្រជែង ជាមួយ វិទ្យាស្ថាន និង សាកលវិទ្យាល័យ នានា ក្នុង ការចាប់ យក សិស្ស - និស្សិត ឱ្យ មក ចូល សិក្សា នៅ វិទ្យាស្ថាន របស់ ខ្លួន ។
ជាក់ស្តែង នៅ ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ បាន អញ្ជើញ សាកលវិទ្យាល័យ ប្រទេស ឥណ្ឌូនេស៊ី ហៅ កាត់ (UII) ដើម្បី ទស្សនកិច្ច សិក្សា ផ្លាស់ប្តូរ បទពិសោទ ការងារ បង្រៀន ដែល ខ្លួន ទទួលបាន ជោគជ័យ បង្ហាញ ដល់ សិស្ស និស្សិត និង សាស្រ្តាចារ្យ នៅ វិស្ថាន អាស៊ី កម្ពុជា ក្នុង គោលបំណង បន្ត លើ កិច្ចសហប្រតិបត្តិការ ដៃគូរ ។
បើ តាម កញ្ញា ចាន់ សូលីការ ជា និស្សិត ឆ្នាំ ទី៣ បាន បញ្ជាក់ ពី ការទទួលបាន សារៈប្រយោជន៍ ពី វិទ្យាស្ថាន និង កិច្ចសហប្រតិបត្តិកា គឺ ទទួលបាន ចំណេះដឹង បទពិសោធន៍ ថ្មី តាមរយៈ ទស្សនៈកិច្ច សិក្សា ជាមួយ សាកលវិទ្យាល័យ របស់ ខ្លូន ក្នុង និង ក្រៅ ប្រទេស ជាពិសេស បរិបទ ការរស់នៅ ក្នុង សង្គម និង ប្រទេស ដៃគូរ ក្នុង ពិភពលោក ផងដែរ ។
កញ្ញា បាន បន្ត ទៀត ថា ការសហការ ជាមួយ ដៃគូ នៅ ក្រៅ ប្រទេស គឺ សារៈប្រយោជន៍ ដោយសារតែ លោក នាយក អាស៊ី កម្ពុជា បាន បង្កើន កម្មវិធី ការផ្លាស់ប្ដូរ បទពិសោធន៍ ក្នុង ការសិក្សា ទាំង ក្នុង ប្រទេស និង ក្រៅ ប្រទេស ហើយ ធ្វើឱ្យ គាត់ ទទួលបាន បទពិសោធន៍ ថ្មី ៗ និង គំនិត ថ្មី ផងដែរ ។
លោក នាយក វិស្ថាន អាស៊ី កម្ពុជា បាន បញ្ជាក់ បន្ថែម ថា គោលបំណង គឺ ដើម្បី ពង្រឹង និង ការលើកម្ពស់ គុណភាព អប់រំ សិក្សា របស់ វិទ្យាស្ថាន ដើម្បីឱ្យ ស្រប ទៅនឹង កម្មវិធី សិក្សា ជាតិ និង អន្តរជាតិ ដើម្បី ប្រកួតប្រជែង ធនធាន មនុស្ស ជាមួយ បណ្តាល ប្រទេស ក្នុង សមាគមន៍ អាស៊ាន ឬ ក៏ អាច ទៅ បម្រើ ការងារ ក្នុង ប្រទេស ជា សមាគមន៍ អាស៊ាន ផងដែរ ។
ទស្សនៈកិច្ច សិក្សា របស់ សាកលវិទ្យាល័យ នៃ ប្រទេស ឥណ្ឌូនេស៊ី ពេលនេះ គឺ លើ កិច្ចសហប្រតិបត្តិការ ដៃគូរ ក្នុង សមាគមន៍ ដែល មាន ដៃគូរ សហប្រតិបត្តិការ ចំនួន ជាង ៨១ សាលា នៃ បណ្តាល ប្រទេស ជា សមាគមន៍ អាស៊ាន ក្នុង គោលបំណង ផ្តល់ ឱកាស ឱ្យ និស្សិត បាន សិក្សា រៀនសូត្រ ទទួលបាន ចំនេះ ដឹង បទពិសោទន៍ ថ្មី ៗ ពី សាកលវិទ្យាល័យ ដៃគូរ និង វប្បធម៌ រស់ នៅ របស់ ប្រទេស នៅក្នុង ពិភពលោក និង ជាពិសេស ដើម្បី សហការ គ្នា ពង្រឹង លើ ការងារ បង្រៀន របស់ លោកគ្រូ សាស្រ្តាចារ្យ និង ធ្វើ ការផ្លាស់ប្តូរ សាស្រ្តាចារ្យ គ្នា ទៅ វិញ ទៅមក ។
លើស ពី នេះ ទៅ ទៀត វិទ្យាស្ថាន មាន ដៃគូរ អាស៊ាន - ចិន ១៧សាលា ដែល ក្នុង ប្រទេស កម្ពុជា មាន ចំនួន ៣សាលា គឺ វិទ្យាស្ថាន អាស៊ី កម្ពុជា . សាកលវិទ្យាល័យ ស្វាយរៀង . សាកលវិទ្យាល័យ មានជ័យ ដែល ជា ដៃគូ ហើយ ក្នុង ឆ្នាំ នេះ ដែរ និង មាន រៀបចំ ធ្វើជា ម្ចាស់ ផ្ទះ នៃ កិច្ចប្រជុំ អាស៊ាន ចិន ដែល រួមគ្នា ជាមួយ សកលវិទ្យាល័យ ស្វាយរៀង ក្នុង គោលបំណង ពង្រឹង សហប្រតិបត្តិការ បន្ថែម ៕
( កណ្ដាល ) ៖ កម្លាំង សមត្ថកិច្ច បាន សម្រេច ចុះ ផ្អាក សកម្មភាព ការសង់ រូបសំណាក « ព្រះសិអារ្យ មេត្រី » នៅលើ ភ្នំ ស្អាង ស្ថិត នៅ ឃុំ ស្អាង ភ្នំ ស្រុក ស្អាង ខេត្ត កណ្ដាល ក្រោយ រកឃើញ ថា ការសាងសង់ ឡើង ដោយ ខុស ច្បាប់ ។ ការផ្អាក សកម្មភាព នេះ ត្រូវបាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ។
មន្ដ្រី នគរបាល មូលដ្ឋាន បាន ឲ្យដឹង ថា ការចុះ ផ្អាក សកម្មភាព ការសង់ រូបសំណាក ដោយ គ្មាន ច្បាប់ អនុញ្ញាត នេះ ត្រូវបាន ធ្វើឡើង ដោយ កម្លាំង នៃ អធិការដ្ឋាន នគរបាល ស្រុក ស្អាង សហការ ជាមួយ កម្លាំង នគរបាល ប៉ុស្ដិ៍ រដ្ឋបាល ឃុំ ស្អាង ភ្នំ និង មាន ការចូលរួម ពី អាជ្ញាធរ ពាក់ព័ន្ធ ផងដែរ ។
តាម សេចក្តីរាយការណ៍ បាន ឲ្យដឹង ថា ការសាងសង់ នេះ គឺ មាន តែ លិខិត ពី មេឃុំ តែ ប៉ុណ្ណោះ ប៉ុន្តែ ខាង គណៈកម្មការ វត្ត និង ព្រះសង្ឃ មិន បាន ដឹង នោះ ទេ ហើយក៏ មិន អនុញ្ញាត នោះ ឡើយ ។
សូម រំលឹក ថា រូបសំណាក « ព្រះសិអារ្យ មេត្រី » ត្រូវបាន បុគ្គល ម្នាក់ ដែល គេ អះអាង ថា ជា មន្ដ្រី ទាហាន ផង នោះ បាន និង កំពុង សាងសង់ នៅលើ ភ្នំ ស្អាង ស្ថិត នៅ ឃុំ ស្អាង ភ្នំ ស្រុក ស្អាង ខេត្ត កណ្ដាល ដែល ត្រូវបាន ព្រះសង្ឃ និង ពុទ្ធ បរិសាទ នៅ ទីនោះ មាន សង្ឃ ដីកា និង អះអាង ថា គ្មាន លិខិត អនុញ្ញាត ពី អាជ្ញាធរ និង មន្ដ្រី ជំនាញ នោះ ឡើយ ។
បុគ្គល រូប នេះ ត្រូវបាន គេ ប្រាប់ ថា ឈ្មោះ យ៉ែម រចនា និង ដែល អះអាង ថា ជា មន្ដ្រី យោធា ផង នោះ បាន ប្រើ កម្មករ ទៅ សង រូបសំណាក ទៅ លើ ថ្ម ធម្មជាតិ ដែល ដុះ ស្រាប់ នៅលើ ភ្នំ ស្អាង ជា យូរ ថ្ងៃ មក ហើយ ប៉ុន្ដែ ពុំ មាន អាជ្ញាធរ ពាក់ព័ន្ធ និង សមត្ថកិច្ច ណាមួយ ចុះ ទៅ សួរនាំ ដើម្បី ធ្វើ ការទប់ស្កាត់ នោះ ទេ ។
ព័ត៌មាន ខាងលើ នេះ ត្រូវបាន ទម្លាយ ចេញ ពី ក្រុមការងារ ចុះ ពង្រឹង ឃុំ ស្អាង ភ្នំ ពេល ដែល ចុះ ទៅ ជួប ជាមួយ ព្រះសង្ឃ និង ពុទ្ធ បរិសាទ ដើម្បី រៀបចំ ពិធី បុណ្យ ភ្ជុំ បិណ្ឌ នៅលើ ភ្នំ ស្អាង នា រសៀល ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ ។
ប្រភព ព័ត៌មាន ពី ក្រុមការងារ ចុះ ពង្រឹង ឃុំ ស្អាង ភ្នំ បាន បញ្ជាក់ មកកាន់ បណ្ដាញ ព័ត៌មាន Fresh News នឹង សុំឲ្យ ជួយ ចុះផ្សាយ ពី បុគ្គល ឈ្មោះ រចនា បាន និង កំពុង សង់ រូបសំណាក « ព្រះសិអារ្យ មេត្រី » នៅ ពីលើ ថ្ម ធម្មជាតិ ដ៏ ធំ មួយ ដែល បាន ដុះ ស្រាប់ នៅលើ ភ្នំ ស្អាង ដោយ គ្មាន ការអនុញ្ញាត ឬ មាន លិខិត ណាមួយ ពី អាជ្ញាធរ ក៏ ដូចជា មន្ដ្រី ជំនាញ នោះ ឡើយ ៕ រដ្ឋមន្ដ្រី ប៉ាន សូរស័ក្តិ ដឹកនាំ គណៈប្រតិភូ កម្ពុជា ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្រ្តី សេដ្ឋកិច្ច អាស៊ាន លើក ទី ៥១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ
( ថៃ )៖ លោក ប៉ាន សូរស័ក្តិ រដ្ឋមន្រ្តី ពាណិជ្ជកម្ម និង ជា រដ្ឋមន្រ្តី សេដ្ឋកិច្ច អាស៊ាន សម្រាប់ កម្ពុជា បាន ដឹកនាំ គណៈប្រតិភូ កម្ពុជា អញ្ជើញ ទៅ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្រ្តី សេដ្ឋកិច្ច អាស៊ាន លើក ទី ៥១ និង កិច្ចប្រជុំ ពាក់ព័ន្ធ នៅ ទីក្រុង បាងកក ប្រទេស ថៃ ចាប់ពី ថ្ងៃទី ០៥ - ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ និង ទទួលបាន លទ្ធផល ដូច ខាងក្រោម៖
* កិច្ចប្រជុំ ទ្វេ ភាគី ជាមួយ ក្រុមប្រឹក្សា ធុរកិច្ច អាស៊ាន - អាមេរិក៖ លោក រដ្ឋមន្ត្រី បាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ចំពោះ គណៈប្រតិភូ ក្រុមប្រឹក្សា ធុរកិច្ច អាស៊ាន - អាមេរិក ដឹកនាំ ដោយ ឯក អគ្គ រដ្ឋទូត Michael Michalak អនុប្រធាន ជាន់ ខ្ពស់ ក្រុមប្រឹក្សា ធុរកិច្ច អាស៊ាន - អាមេរិក និង បាន ជម្រាប ពី ការប្តេជ្ញាចិត្ត របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការជំរុញ ពាណិជ្ជកម្ម វិនិយោគ និង បរិយាកាស ធុរកិច្ច នៅ កម្ពុជា ។
ក្នុង កិច្ចប្រជុំ នេះ ផងដែរ លោក រដ្ឋមន្រ្តី បាន ផ្តល់ អនុសាសន៍ ដល់ ក្រុមប្រឹក្សា ធុរកិច្ច អាស៊ាន - អាមេរិក ឲ្យ មាន តំណាង នៅ កម្ពុជា ដើម្បី ជួយ ជំរុញ សកម្មភាព ធុរកិច្ច ក៏ ដូចជា កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស ទាំង ពីរ ។ កិច្ចប្រជុំ ក៏ បាន ពិភាក្សា អំពី ផែនការ របស់ ប្រទេស កម្ពុជា ក្នុង ការកែលម្អ ហេដ្ឋារចនាសម្ព័ន្ធ ការតភ្ជាប់ អភិបាលកិច្ច ល្អ និង ការអភិវឌ្ឍ ធនធាន មនុស្ស សេដ្ឋកិច្ច ឌីជីថល ពាណិជ្ជកម្ម អេឡិចត្រូនិក និង ការអភិវឌ្ឍ សហគ្រាស ធុន តូច និង មធ្យម ផងដែរ ។
ប្រទេស ចិន និង សហរដ្ឋ អាមេរិក បាន និង កំពុង ផុង ខ្លួន កាន់តែ ជ្រៅ ទៅក្នុង សង្គ្រាម ដំឡើង ពន្ធ រាប់ រយ ពាន់ លាន ដុល្លារ ដាក់ គ្នា ទៅ វិញ ទៅមក ដោយសារតែ សហរដ្ឋ អាមេរិក បាន ចោទប្រកាន់ ចិន ថា បាន លួច កេង ចំណេញ ជាច្រើន លើ វិស័យ ពាណិជ្ជកម្ម ជាមួយ ខ្លួន ខណៈ ចិន ក៏ បាន អះអាង តប វិញ ថា វា គ្រាន់តែ ជា នយោបាយ របស់ រដ្ឋបាល លោក ដូណាល់ ត្រាំ ដើម្បី បង្កើន ប្រជាប្រិយភាព មុន ការបោះឆ្នោត ប្រធានាធិបតី អាណត្តិ ថ្មី ឆ្នាំ ២០២០ និង ជា ការបង្អាក់ សន្ទុះ នៃ ការអភិវឌ្ឍ សេដ្ឋកិច្ច ដ៏ ខ្លាំងក្លា របស់ ចិន តែ ប៉ុណ្ណោះ ។
ទោះបីជា បែប នេះ ក្តី ក្រុម អ្នកវិភាគ អន្តរជាតិ បាន លើកឡើង ស្រដៀង ៗ គ្នា ថា សង្គ្រាម នេះ មិន បាន ផ្តល់ ផល ចំណេញ ដល់ នរណា ម្នាក់ ឡើយ ព្រោះ ទាំង អាមេរិក និង ចិន សុទ្ធតែ មាន ការខាតបង់ ដូច ៗ គ្នា ។ ដោយឡែក ការប្រកាស មិន យក ពន្ធ ពី ទំនិញ អាមេរិក ទាំង ១៦មុខ ខាងលើ នេះ វិញ គឺ នឹង ត្រូវ អនុវត្ត ជា ផ្លូវការចាប់ពី ថ្ងៃទី ១៧ ខែកញ្ញា ឆ្នាំ ២០១៩ និង មាន សុពលភាព រយៈពេល មួយ ឆ្នាំ ។
គួរ បញ្ជាក់ ថា ការសម្រេចចិត្ត របស់ ទីក្រុង ប៉េកាំង បែប នេះ គឺជា លើក ដំបូង ហើយ គិត ចាប់តាំងពី មហា យក្ស សេដ្ឋកិច្ច ទាំង ពីរ លើ លោក នេះ បាន ផ្ទុះ សង្គ្រាម ដំឡើង ពន្ធ ដាក់ គ្នា ទៅ វិញ ទៅ មក ហើយ ទំនិញ ដែល ចិន បាន លើកលែង ការដំឡើង ពន្ធ នាំចូល នោះ គឺ មាន ដូចជា សាច់ ត្រី ចំណី សត្វ ឧបករណ៍ ស្គែន វេជ្ជសាស្ត្រ និង ថ្នាំ គីមី មួយចំនួន ប៉ុន្តែ សម្រាប់ ផលិតផល សណ្តែក និង សាច់ ជ្រូក ដែល លោក ត្រាំ ចង់ឲ្យ ចិន លើកលែង ការដំឡើង ពន្ធ នោះ មិន ទាន់ មាន នៅក្នុង មុខ ទំនិញ ទាំង ១៦មុខ នៅឡើយ ទេ ។
សម្រាប់ ការផ្តល់ ជូន ខាងលើ នេះ គឺ ត្រូវបាន ធ្វើឡើង តាម ការសន្យា កាលពី សប្តាហ៍ មុន នៅក្នុង កិច្ចសន្ទនា តាម ទូរស័ព្ទ រវាង មន្ត្រី ជាន់ ខ្ពស់ ពាណិជ្ជកម្ម ចិន និង សហរដ្ឋ អាមេរិក ដោយ ចិន ក៏ ចង់បាន ការតបស្នង មកវិញ ដែរ នោះ គឺ អាមេរិក ត្រូវ បន្ធូរបន្ថយ សម្ពាធ លើ ក្រុមហ៊ុន បច្ចេកវិទ្យា យក្ស ចិន Huawei និង ឈប់ ដំឡើង ពន្ធ លើ ទំនិញ ចិន តទៅទៀត ៕
ប្រជាពលរដ្ឋ ៥៥គ្រួសារ នៅ តំបន់ ក្បាល ឆាយ ខេត្ត ព្រះសីហនុ បាន ទទួល អំណោយ ពី ថ្នាក់ដឹកនាំ ខេត្ត
( ព្រះសីហនុ) ៖ លោក ជា ម ហ៊ីម ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង លោក គួច ចំរើន អភិបាល នៃ គណៈអភិបាល ខេត្ត ព្រះសីហនុ បាន អញ្ជើញ សាកសួរ សុខទុក្ខ និង នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ចំនួន ៤៥ គ្រួសារ ដែល រស់ នៅ តំបន់ ក្បាល ឆាយ ភូមិ១ សង្កាត់ ១ ក្រុង ខេត្ត ព្រះសីហនុ នា រសៀល ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ ។
ក្នុង ឱកាស នោះ លោក គួច ចំរើន បាន សំណេះសំណាល ជាមួយ បងប្អូន ប្រជាពលរដ្ឋ ថា ដោយសារ រដូវ នេះ ប្រឈម នឹង ភ្លៀង ធ្លាក់ ជា បន្តបន្ទាប់ ពិបាក ក្នុង ការងារ រកស៊ី ដូច្នេះ ត្រូវ ថែទាំ សុខភាព កូន ចៅ ដេក ក្នុង មុង ផឹក ទឹក ស្អាត ចៀសវាង ពី ជំងឺ ផ្សេង ៗ រដ្ឋបាល ខេត្ត តែងតែ គិតគូរ ពី សុខ ទុក្ខ ប្រជាពល រដ្ឋ នៅក្នុង ខេត្ត ដោយ មិន ប្រកាន់ វណ្ណ ពណ៌ សម្បុរ ឬ ប្រកាន់ និន្នាការ នយោបាយ គឺ ធ្វើ យ៉ាងណា ជួយ ដោះស្រាយ ជីវភាព ប្រជាពលរដ្ឋ បាន ទាន់ ពេល វេលា ។
រយៈពេល ៣ ថ្ងៃ កម្លាំង អាវុធហត្ថ ចាប់ រថយន្ដ បាកុង និង ត្រាក់ទ័រ ៥ គ្រឿង រួច ដុត បំផ្លាញ ចោល នៅ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ រយៈពេល ៣ ថ្ងៃ កម្លាំង អាវុធហត្ថ ខេត្ត ពោធិ៍សាត់ សហការ ជាមួយ កម្លាំង មូលដ្ឋាន អាវុធហត្ថ ស្រុក ភ្នំ ក្រវាញ និង ស្រុក វាលវែង ដឹកនាំ ដោយ លោក វរសេនីយ ទោ ឡាយ វិទូ មេបញ្ជាការ រង កងរាជអាវុធហត្ថ ខេត្ត នា ថ្ងៃទី ០៩ - ១០ - ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ បាន បន្ត ប្រតិបត្តិការ ស្រាវជ្រាវ និង រកឃើញ រថយន្ត បាកុង ចំនួន ៣គ្រឿង និង ត្រាក់ទ័រ ចំនួន ២គ្រឿង ទៀត ដែល ក្រុម ឧក្រិដ្ឋ ជន យក ទៅ លាក់ ទុក ដើម្បី បម្រើ ជា មធ្យោបាយ ដឹក ឈើ និង ឈូសឆាយ ដី ព្រៃ ។
នៅ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩នេះ វិញ កម្លាំង បាន បន្ត ចុះ ប្រតិបត្តិការ រឹបអូស រថយន្ត បាកុង ១គ្រឿង ទៀត នៅ ភូមិ ស្ទឺង ថ្មី ឃុំ ប្រម៉ោយ ស្រុក វាលវែង យកមក រក្សាទុក នៅ មូលដ្ឋាន អាវុធហត្ថ ស្រុក វាលវែង ដើម្បី បម្រើ ការ បង្ក្រាប បទល្មើស ធនធាន ធម្មជាតិ នា ពេល ក្រោយ ។
សំណុំរឿង ប្រមាថ និង ញុះញង់ ឱ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ របស់ ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក ត្រូវបាន តុលាការ បិទ ការស៊ើបសួរ និង បាន បញ្ជូន ទៅ ចៅក្រម ជំនុំជម្រះ កាលពី ថ្ងៃទី ០៦ ខែសីហា ឆ្នាំ ២០១៩ ។ ក្នុង សំណុំរឿង នេះ លោក សម រង្ស៉ី លោក ហូ វ៉ាន់ និង កាក់ កុម្ភារ ត្រូវបាន ចោទប្រកាន់ ពី បទ ផ្តើម គំនិត ប្រមាថ និង ញុះញង់ ឲ្យ ប្រព្រិត បទឧក្រិដ្ឋ ជាអាទិ៍ ចំណែក ឈ្មោះ គង់ មាស់ ត្រូវបាន ចោទប្រកាន់ ពី បទ ប្រមាថ និង ញុះញង់ ឲ្យ ប្រព្រិត បទឧក្រិដ្ឋ ជាអាទិ៍ តាម បញ្ញត្តិ មាត្រា ៤៩៥ និង ៥០២ នៃ ក្រម ព្រហ្មទណ្ឌ ។
បើ តាម របាយការណ៍ សមត្ថកិច្ច . ក្រោយ ការចាប់ខ្លួន អតីត សកម្មជន ក្រុម ប្រឆាំង នេះ សមត្ថកិច្ច បាន រកឃើញ មាន ឯកសារ សំខាន់ ៗ ជាច្រើន ដែល ទាក់ទង នឹង ផែនការ ប៉ុនប៉ង ផ្តួលរំលំ រាជ រដ្ឋាភិបាល តាម បញ្ជា របស់ បុគ្គល សម រង្សី ៕
ពលរដ្ឋ ជាង១.០០០ គ្រួសារ នៅ ខេត្ត ត្បូងឃ្មុំ ដែល ទឹក ជំនន់ វាយប្រហារ ត្រូវ ជម្លៀស ទៅ កន្លែង មាន សុវត្ថិភាព . ទេសរដ្ឋមន្ដ្រី គន់ គីម និង អភិបាល ខេត្ត យក អំណោយ ចែកជូន
( ត្បូងឃ្មុំ ) ៖ ប្រជាពលរដ្ឋ ជាង១.០០០ គ្រួសារ ត្រូវបាន ជម្លៀស ទៅកាន់ ទី ទួល សុវត្ថិភាព នៅ ឃុំ ទន្លេ បិទ ខេត្ត ត្បូងឃ្មុំ ដោយសារ ផ្ទះ របស់ ពួកគាត់ ត្រូវ ទឹក លិច ទាំងស្រុង ។ ពលរដ្ឋ ទាំងអស់ នេះ មកពី ឃុំ ចំនួន ៤ រួម មាន៖ ឃុំ ជីរ៉ូ១. ឃុំ ទន្លេ បិទ . ឃុំ បឹងប្រួល និង ឃុំ ពាម ជីលាំង ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ ។
ដោយ មាន ទឹក ជំនន់ បណ្តាល មក ធម្មជាតិ បែប នេះ នៅ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ទេសរដ្ឋមន្រ្តី គន់ គីម អនុប្រធាន ទី១ គណៈកម្មាធិការ ជាតិ គ្រប់ គ្រោះមហន្តរាយ និង អភិបាល ខេត្ត ត្បូងឃ្មុំ លោក ជា ម ច័ន្ទ សោភ័ណ្ឌ សហការ ជាមួយ អង្គការ ការីតា ស កម្ពុជា ឆ្លើយតប ទាន់ ពេលវេលា ដោយ ជួយ ទូក ចំនួន ៤គ្រឿង និង ម៉ាស៊ីន ទូក ១ គ្រឿង ស៊ី ទែន២ បង្គន់៤ ធុង ចម្រុះ ទឹក ស្អាត ចំនួន ២ តង ខៀវ ចំនួន ១២៥តង់ យក ទៅ ចែកជូន និង ពិនិត្យ ស្ថានភាព ។
ដោយឡែក គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ចំនួន ៤០០តង់ សម្រាប់ ជួយ សម្រាល ដល់ បងប្អូន ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ។
ថ្លែង ក្នុង ឱកាស នោះ ទេសរដ្ឋមន្រ្តី គន់ គីម ក្នុង នាម គ្រោះមហន្តរាយ តំណាង សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង ជា ប្រធាន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្ដរាយ បាន កោតសរសើរ អាជ្ញាធរ ខេត្ត ផងដែរ ក្នុង ការងារ សង្រ្គោះ ទាន់ ពេលវេលា មិន ឲ្យ ប្រជាជន ណា ម្នាក់ គ្រោះថ្នាក់ ឡើយ ។
បន្ថែម ពី នេះ ទេសរដ្ឋមន្ត្រី គន់ គីម បាន ថ្លែងអំណរគុណ ដល់ អង្គការ ការីតា ស កម្ពុជា ដែល តែងតែ ចូលរួម សហការ គាំទ្រ ជាប្រចាំ ពេល មាន គ្រោះមហន្តរាយ ម្តង ៗ និង អរគុណ ក្រសួង សុខាភិបាល បាន យក ពេទ្យ ប្រចាំ ការ នៅ ទី ទួល សុវត្ថិភាព ដើម្បី ត្រៀម ជួយ សង្រ្គោះ ក្នុង ការឈឺ ដង្កាត់ ផ្សេង ៗ ៕
១៖ រាជ រដ្ឋាភិបាល ចេញ សេចក្តីសម្រេច កែសម្រួល របៀបរបប ការងារ និង ការបែងចែក ភារកិច្ច របស់ ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល ក្រោយ បញ្ចប់ តំណែង លោក ញឹម វណ្ណ ដា ( ចុច អាន )
២៖ អ្នកនាំពាក្យ ការបរទេស កម្ពុជា ចេញ សេចក្តីថ្លែងការណ៍ ឆ្លើយតប ទៅ អ្នកនាំពាក្យ ក្រសួង ការបរទេស អាមេរិក អំពី ករណី លោក កឹម សុខា ( ចុច អាន )
៣៖ សម្តេច តេជោ ហ៊ុន សែន៖ លុយ បាន ពី ប្រេង មិន យកមក ប្រើ ក្នុង ចំណាយ ចរន្ត ឡើយ តែ គឺ សម្រាប់ ហេដ្ឋារចនាសម្ព័ន្ធ បម្រើ អភិវឌ្ឍន៍ ជាតិ ( ចុច អាន )
៦៖ គណៈ រដ្ឋមន្រ្តី អនុម័ត លើ ការធានា របស់ រាជ រដ្ឋាភិបាល សម្រាប់ គម្រោង ទិញ ថាមពល អគ្គិសនី ផលិត ដោយ ធ្យូងថ្ម ២៤០០ មេហ្កាវ៉ាត់ ពី ប្រទេស ឡាវ ( ចុច អាន )
៧៖ សម្តេច តេជោ ហ៊ុន សែន បញ្ចេញ រថយន្ត រដ្ឋ១២០ គ្រឿង ទៅ តាម បណ្តា ខេត្ត មួយចំនួន ដើម្បី សម្រួល ការធ្វើដំណើរ ជូន ពលរដ្ឋ ឥត គិត ថ្លៃ ឱកាស បុណ្យ ភ្ជុំ បិណ្ឌ ( ចុច អាន )
៨៖ បេក្ខជន ប្រឡង បាក់ឌុប មួយចំនួន តវ៉ា លទ្ធផល នៅ ក្រសួង អប់រំ . អ្នកនាំពាក្យ ក្រសួង អប់រំ បញ្ជាក់ ថា ក្រសួង មិន មាន គោលការណ៍ បើក ចំហរ ជូន បេក្ខជន ដូច ឆ្នាំ ២០១៨ ទេ ( ចុច អាន )
១៖ នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក អាបេ ស៊ីន ហ្សូ ធ្វើ ការរុះរើ គណៈ រដ្ឋមន្ត្រី ទ្រង់ទ្រាយ ធំ ( ចុច អាន )
២៖ នាយក រដ្ឋមន្រ្តី ជប៉ុន តែងតាំង រដ្ឋមន្រ្តី ការបរទេស ថ្មី និង ផ្លាស់ ប្រមុខ ការទូត ចាស់ ឲ្យ ឡើង ជា រដ្ឋមន្រ្តី ការពារ ជាតិ វិញ ( ចុច អាន )
៤៖ លោក គីម ជុង អ៊ុន គឺជា អ្នកអង្កេត ដោយ ផ្ទាល់ នូវ ការធ្វើតេស្ត ជើង ទម្របាញ់ រ៉ុក្កែត ខ្នាត យក្ស ( ចុច អាន )
៧៖ នាវា ចម្បាំង កាណាដា ធ្វើដំណើរកាត់ តាម ច្រក សមុទ្រ តៃវ៉ាន់ ចំពេល កំពុង មាន ភាពតានតឹង ជាមួយ ចិន ( ចុច អាន )
៨៖ រុស្ស៊ី ត្រៀម ជិត រួចរាល់ហើយ ដើម្បី ឆ្លើយតប ទៅនឹង ការធ្វើតេស្ដមីស៊ីស របស់ សហរដ្ឋ អាមេរិក ( ចុច អាន )
១១៖ អ៊ីរ៉ង់ ស្វាគមន៍ ការខ្ទាត ចេញ ពី តំណែង នៃ ទីប្រឹក្សា សន្តិសុខ ជាតិ អាមេរិក ចន បូល តុន ( ចុច អាន )
១២៖ អូស្ត្រាលី ណែនាំ ពលរដ្ឋ ឲ្យ ប្រយ័ត្ន ពេល ទៅ អ៊ីរ៉ង់ ព្រោះ ជនជាតិ ខ្លួន ៣នាក់ ហើយ ត្រូវ ចាប់ ឃុំ នៅ ទីនោះ ដោយ មិន បញ្ជាក់ មូលហេតុ ( ចុច អាន )
១៤៖ នាយក រដ្ឋមន្ត្រី បន្ទោស ភាគី ក្នុង ស្រុក និង អន្តរជាតិ ដែល ធ្វើឲ្យ ការដោះស្រាយ បញ្ហា លីប៊ី ត្រូវ រាំងស្ទះ ( ចុច អាន )
១៥៖ វិមាន ក្រឹម ឡាំង ទាត់ ចោល ព័ត៌មាន ដែល ថា ធ្លាប់ មាន គិញ សម្ងាត់ អាមេរិក លួច ស៊ើបការណ៍ ក្នុង រដ្ឋាភិបាល រុស្ស៊ី ( ចុច អាន )
រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល ស្នើ ធនាគា អភិវឌ្ឍន៍ ចិន បញ្ជូន កម្ចី ទុន វិនិយោគ សាងសង់ ព្រលានយន្តហោះ ថ្មី ទាំង ពីរ នៅ កម្ពុជា ឱ្យ បាន ឆាប់រហ័ស បំផុត
ក្នុង ជំនួប នោះ លោក បណ្ឌិត រដ្ឋមន្ត្រី ក៏ បាន ស្នើសុំ លោក លាវ ហ្វួ ជួយ ជ្រុំ ជ្រែង និង ជម្រាប ជូន ដល់ ប្រធាន ក្រុមប្រឹក្សាភិបាល ធនាគារ លើ ការបញ្ជូន កម្ចី ទុន វិនិយោគ នៃ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ ថ្មី ទាំង ពីរ នៅ កម្ពុជា ឲ្យ បាន ឆាប់រហ័ស បំផុត ដើម្បី ឆ្លើយតប តាម តម្រូវការ នៃ ទីផ្សារ ដឹកជញ្ជូន តាម ផ្លូវ អាកាស នា ពេល បច្ចុប្បន្ន ។
ក្នុង កិច្ចពិភាក្សា ការងារ នេះ លោក លាវ ហ្វួ បាន ជម្រាប ជូន លោក បណ្ឌិត រដ្ឋ មន្ត្រី ថា ធនាគា អភិវឌ្ឍន៍ ចិន ជាធនាគា ពាណិជ្ជកម្ម មួយ ដ៏ ធំ មួយ នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការបំពេញ ចក្ខុវិស័យ និង គោលដៅ គំនិត ផ្តួចផ្តើម ខែ ក្រវ៉ាត់ និង ផ្លូវ នៃ យុទ្ធសាស្ត្រ អភិវឌ្ឍន៍ របស់ រដ្ឋាភិបាល សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល ក្នុង នោះ ធនាគា របស់ លោក បាន ចូលរួម គម្រោង អភិវឌ្ឍន៍ ហេដ្ឋារចនាសម្ព័ន្ធ ជាច្រើន នៅ កម្ពុជា នា ពេល កន្លងមក ។
លោក បាន បន្ត ថា ឥឡូវនេះ ធនាគា របស់ លោក នឹង យកចិត្តទុកដាក់ លើ ការចូលរួមចំណែក នៃ ការកសាង ហេដ្ឋារចនាសម្ព័ន្ធ វិស័យ អាកាសចរ ស៊ីវិល នៅ កម្ពុជា តាមរយៈ ការផ្តល់ កម្ចី ទុន វិនិយោគ ដោយ ផ្ទាល់ ជាពិសេស លើ ការកសាង អាកាសយានដ្ឋាន អន្តរ ថ្មី នៅ ភ្នំពេញ និង នៅ សៀមរាប ដោយ ឃើញ នូវ កំណើន នៃ ការដឹកជញ្ជូន តាម ផ្លូវ អាកាស នៅ កម្ពុជា មាន ភាពរឹង ម៉ាជាលំដាប់ ។
ជា ការឆ្លើយតប លោក បណ្ឌិត រដ្ឋមន្ត្រី បាន កោតសរសើរ ដោយ ស្មោះ និង វាយតម្លៃ យ៉ាង ខ្ពស់ លើ ការចូលរួមចំណែក របស់ ធនាគា អភិវឌ្ឍន៍ ចិន ក៏ ដូចជា រដ្ឋាភិបាល នៃ សាធារណរដ្ឋ ប្រជាមានិត ចិន ដែល បាន ឆ្លើយតប យ៉ាង ទាន់ ពេលវេលា មាន ប្រសិទ្ធភាព និង ពុំ មាន លក្ខខណ្ឌ លើ ការផ្តល់ ទុន វិនិយោគ ហេដ្ឋារចនាសម្ព័ន្ធ នៅ កម្ពុជា នា ពេល កន្លងមក ហើយ បាន ឈាន មកដល់ ដំណាក់ ថ្មី មួយ ទៀត នៃ ការយកចិត្តទុកដាក់ វិនិយោគ ហេដ្ឋារចនាសម្ព័ន្ធ វិស័យ អាកាសចរ ស៊ីវិល ៕
រាជ រដ្ឋាភិបាល បញ្ចេញ អង្ករ ១ ពាន់ តោន និង ថវិកា ២ពាន់ លាន រៀល ឱ្យ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ដើម្បី ត្រៀម ជួយ ពលរដ្ឋ ដែល ប្រឈម គ្រោះ ទឹក ជំនន់ (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ប្រកាស ថា រាជ រដ្ឋាភិបាល កម្ពុជា បាន សម្រេច បញ្ចេញ អង្ករ ចំនួន ១.០០០ តោន និង ថវិកា ចំនួន ២.០០០ លាន រៀល ជូន ដល់ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ដើម្បី ត្រៀម ជួយសង្គ្រោះ ដល់ ប្រជាពលរដ្ឋ នៅ តាម បណ្តា ខេត្ត ទាំងឡាយ ដែល ប្រឈម នឹង គ្រោះ ទឹក ជំនន់ ។
ការប្រកាស របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី នៅ វិមាន សន្តិភាព នា ព្រឹក ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ ដោយ ពិភាក្សា និង អនុម័ត របៀបវារៈ មួយចំនួន ដែល បាន គ្រោង ទុក ។
តាម ការប្រកាស លទ្ធផល នៃ កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី នៅ ថ្ងៃ នេះ បាន ឱ្យដឹង ថា នៅក្នុង កិច្ចប្រជុំ នោះ សម្តេច តេជោ ហ៊ុន សែន បាន លើកឡើង ថា៖ រាជ រដ្ឋាភិបាល បាន សម្រេច បញ្ចេញ អង្ករ ចំនួន ១.០០០ តោន និង ថវិកា ចំនួន ២.០០០ លាន រៀល ជូន ដល់ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ដើម្បី ត្រៀម ជួយសង្គ្រោះ ដល់ ប្រជាពលរដ្ឋ នៅ តាម បណ្តា ខេត្ត ទាំងឡាយ ដែល ប្រឈម នឹង គ្រោះ ទឹក ជំនន់ ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បង្គាប់ឱ្យ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ត្រូវ សហការ ជាមួយ កាកបាទ ក្រហម កម្ពុជា ក្នុង ការនាំយក អង្ករ និង សម្ភារៈ ប្រើប្រាស់ ផ្សេង ៗ ដើម្បី ចែកជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ។
សម្តេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ បន្ថែម ទៀត ថា រាជ រដ្ឋាភិបាល ក៏ បាន ណែនាំ ផងដែរ ដល់ ក្រសួង ស្ថាប័ន និង រដ្ឋបាល ដែនដី គ្រប់ លំដាប់ថ្នាក់ ត្រូវ សហ ការ ត្រៀម ផ្ដល់ ស្រូវ ពូជ ជូន ដល់ ប្រជាកសិករ នៅ តាម បណ្តា ខេត្ត នានា ដែល បាន ដាំដុះ ស្រូវ វស្សា ហើយ ទទួលរង ការខូចខាត ដោយ គ្រោះ ទឹក ជំនន់ ៕
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃពុធ ទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ គណៈ រដ្ឋមន្រ្តី បាន បើក កិច្ចប្រជុំ ពេញ អង្គ មួយ ក្រោម អធិបតីភាព សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដើម្បី ពិភាក្សា និង ឆ្លង របៀបវារៈ មួយចំនួន ។
របៀបវារៈ នៃ កិច្ចប្រជុំ នេះ មាន ដូចត ទៅ៖
១៖ ការធានា របស់ រាជ រដ្ឋាភិបាល សម្រាប់ គម្រោង ទិញ ថាមពល អគ្គិសនី ផលិត ដោយ ធ្យូងថ្ម ២៤០០ មេហ្កាវ៉ាត់ ពី ប្រទេស ឡាវ ។ ២៖ បញ្ហា ផ្សេង ៗ សំណើ សុំ ការយល់ព្រម ពី គណៈ រដ្ឋមន្រ្តី ដើម្បី សុំ ការអនុម័ត យល់ព្រម ពី ស្ថាប័ន នីតិប្បញ្ញត្តិ លើ៖២. ១៖ កិច្ចព្រមព្រៀង អាស៊ាន ស្តីពី ពាណិជ្ជកម្ម តាម ប្រព័ន្ធ អេឡិចត្រូនិក ។២. ២៖ កិច្ចព្រមព្រៀង ស្តីពី ការបង្កើត ក្របខណ្ឌ សម្ព័ន្ធភាព ថាមពល ព្រះអាទិត្យ អន្តរជាតិ ៕
ខាងក្រោម នេះ ជា លទ្ធផល ផ្លូវការ នៃ កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្រ្តី នៅ ថ្ងៃ នេះ៖
ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ខេត្ត ត្បូងឃ្មុំ បាន ទទួល អំណោយ ពី កាកបាទ ក្រហម កម្ពុជា ខេត្ត ត្បូងឃ្មុំ
( ត្បូងឃ្មុំ ) ៖ លោក ហាក់ សុខ មករា អភិបាល រង ខេត្ត និង ជា អនុប្រធាន អចិន្ត្រៃយ៍ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ត្បូងឃ្មុំ បាន ដឹកនាំ ក្រុមការងារ ចុះ សាកសួរ សុខទុក្ខ ប្រជាពលរដ្ឋ រងគ្រោះ ចំនួន ០២ រូប ដែល បាន មក ស្នាក់ នៅ ទី ទួល សុវត្ថិភាព ឃុំ ទន្លេ បិទ ដែល បច្ចុប្បន្ន កំពុង ត្រូវបាន សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ ខេត្ត កំពង់ចាម ។
លោក ហាក់ សុខ មករា បាន នាំយក អំណោយ មនុស្សធម៌ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត រួម មាន៖ សម្ភារ និង ថវិកា មួយ ចំនួន ជូន ដល់ ជនរងគ្រោះ ទាំង ពីរ នាក់ ។
លោក បាន ពាំនាំ ការផ្ដាំផ្ញើ ការសួរសុខទុក្ខ ពីសំណាក់ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា និង បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ត្រូវ ប្រកាន់ខ្ជាប់គោលការណ៍ ហូប ស្អាត ផឹក ស្អាត និង អនាម័យ ស្អាត ជាពិសេស ត្រូវ ប្រុងប្រយ័ត្ន ចំពោះ គ្រោះថ្នាក់ ដោយ សត្វ អាសិរពិស ដែល ងាយ នឹង កើតឡើង នា រដូវ ទឹក ជំនន់ នេះ ៕
យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១១ ខែកញ្ញា៖ រកឃើញ យានយន្ដ ល្មើស ច្បាប់ និង ផាក ពិន័យ ចំនួន ២. ០០៩ គ្រឿង
( ភ្នំពេញ ) ៖ យុទ្ធនាការ រឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ នេះ កម្លាំង នគរបាល ចរាចរណ៍ បាន ត្រួតពិនិត្យ យានយន្ដ ចំនួន គ្រឿង២.១៧៦ គ្រឿង រកឃើញ យានយន្ត ល្មើស ច្បាប់ និង ផាក ពិន័យ ចំនួន ២.០០៩ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ចំនួន ១. ៥៥០ គ្រឿង ។ នេះ បើ តាម របាយការណ៍ ផ្លូវការ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
ស្រឡាញ់ ជីវិត អ្នក សូម កុំ ប៉ះពាល់ គ្រឿងញៀន ! យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ទូទាំង ប្រទេស ថ្ងៃទី ១១ ខែកញ្ញា៖ បង្ក្រាប បាន ៣៥ ករណី ឃាត់ខ្លួន ១១៥ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប គ្រឿងញៀន ខុស ច្បាប់ ចំនួន ៣៥ ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ១១៥ នាក់ ។
បើ យោង តាម របាយការណ៍ របស់ គណៈកម្មការ ទី៣ នៃ យុទ្ធនាការ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ បាន ឲ្យដឹង ថា ប្រភេទ បទល្មើស រួម មាន៖ ជួញដូរ ២១ ករណី ឃាត់ខ្លួន ៦១ នាក់ និង ប្រើប្រាស់ ១៤ករណី ឃាត់ខ្លួន ៥៤ នាក់ ។
របាយការណ៍ ដដែល បាន ឲ្យដឹង ទៀត ថា លទ្ធផល បង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស ចាប់ពី ថ្ងៃទី ០១ ខែមករា ដល់ ថ្ងៃទី ១១ ខែកញ្ញា ឆ្នាំ ២០១៩ មាន ចំនួន សរុប ៦. ៧៤២ ករណី ដោយ ឃាត់ មនុស្ស ចំនួន ១៤. ៤២៨ នាក់ ( ស្រី ៩៩៤ នាក់ ) ( ជន បរទេស ៣២៤ នាក់ ស្រី ៥៥ នាក់ មាន ១២សញ្ជាតិ )៕ សង្គតិភាព ផែនការការងារ របស់ អង្គការ សង្គម ស៊ីវិល ស្រប តាម ផែនការអភិវឌ្ឍន៍ និង វិនិយោគ ថ្នាក់ មូលដ្ឋាន ចូលរួមចំណែក យ៉ាង សំខាន់ ក្នុង ការសម្រេចបាន នូវ ក្របខ័ណ្ឌ គោលដៅ អភិវឌ្ឍន៍ ប្រកបដោយ ចីរភាព កម្ពុជា
( កណ្តាល ) ៖ លោក ចៅក្រម ជួន វណ្ណៈ ចៅក្រម ទទួលបន្ទុក សំណុំរឿង អនុវត្ត នៃ សាលាដំបូង ខេត្ត កណ្តាល នៅ ថ្ងៃទី ១០ ខែកញ្ញា ឆ្នាំ ២០១៩ បាន ចេញ ដីកា សម្រេច ប្រគល់ អចលវត្ថុ លេខ ០១៩ / ១៩ ដោយ សម្រេច លើ ០២ ចំនុច សំខាន់ ៗ រួម មាន៖
២៖ បង្គាប់ ឲ្យ ប្រធាន មន្ទី រៀបចំ ដែនដី នគរូបនីយកម្ម សំណង និង សុរិយោដី ខេត្ត កណ្តាល និង ភូបាល ស្រុក ពញា ឮ រៀបចំ ធ្វើ ប័ណ្ណ សម្គាល់ សិទ្ធិ កាន់កាប់ អចលន វត្ថុ ដី មាន ទំហំ ៤២. ៦២៩.៦០ ម៉ែត្រ ការ៉េ ដែល មាន ទីតាំង ភូមិ ស្រែ តាមែង ឃុំ ទំនប់ ធំ ស្រុក ពញា ឮ ខេត្ត កណ្តាល ដើម្បី កសាង ប័ណ្ណ តាម នីតិវិធី នៃ ច្បាប់ ភូមិបាល ចាប់ពី ថ្ងៃ នេះ តទៅ ។
ចំពោះ ករណី ក្នុង ការចេញ លិខិត បញ្ជាក់ ការកាន់កាប់ អចលន វត្ថុ ជាន់ គ្នា នេះ ត្រូវបាន ឈ្មោះ ឆាយ ហុង ប្តឹង មេឃុំ ទំនប់ ធំ លោក នូ ឡេន និង ឈ្មោះ យ៉ែប សុភឿន ទៅ អង្គភាព ប្រឆាំ អំពើពុករលួយ ពី បទ ពុករលួយ រំលោភ អំណាច និង មិន អនុវត្ត សេចក្តីសម្រេច របស់ តុលាការ ដើម្បី ចាត់ការ តាម នីតិវិធី ច្បាប់ ៕ ឥទ្ធិពល នៃ សង្គ្រាម ពាណិជ្ជកម្ម រវាង ចិន និង អាមេរិក កំពុង ជះ លើ អាល្លឺម៉ង់ ក្នុង កម្រិត ធ្ងន់ ...
