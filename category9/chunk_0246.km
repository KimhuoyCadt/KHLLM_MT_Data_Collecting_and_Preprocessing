( ភ្នំពេញ ) ៖ អគ្គ លេខាធិការដ្ឋាន ព្រឹទ្ធសភា បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី លទ្ធផល នៃ ការបើក សម័យ ប្រជុំ លើក ទី៦ព្រឹទ្ធសភា នីតិកាល ទី៤ ដែល បាន ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០២០ ក្រោម អធិបតីភាព លោក កិត្តិនីតិកោសល បណ្ឌិត ស៊ឹម កា ប្រធាន ស្តីទី ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា ដោយ មាន សមាជិក ព្រឹទ្ធសភា មាន វត្តមាន ចំនួន ៥៧ រូប ។
អគ្គ លេខាធិការ គ.ជ. ប ៖ ការបណ្ដុះបណ្ដាល ការងារ ជំនាញ ដល់ មន្ត្រី បោះឆ្នោត ជា រឿង ចាំបាច់ ដែល ខកខាន មិន បាន
( ព្រៃវែង ) ៖ ក្នុង ឱកាស បើក វគ្គ បណ្តុះបណ្តាល ស្តីពី « ប្រសិទ្ធភាព នៃ ការបណ្ដុះបណ្ដាល ការអប់រំ ការផ្សព្វផ្សាយ ព័ត៌មាន ការដាក់ ការទទួល និង ការដោះស្រាយ ពាក្យ បណ្ដឹង ក្នុង ដំណើរការបោះឆ្នោត » ជូន មន្រ្តី រាជការ គ.ជ. ប នា ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០២០ នេះ លោក ទេព នី ថា អគ្គ លេខាធិការ គ.ជ. ប បាន ថ្លែង ថា ការបណ្ដុះបណ្ដាល ការងារ ជំនាញ ដល់ មន្ត្រី បោះឆ្នោត គឺជា រឿង ចាំបាច់ ដែល មិន អាច ខកខាន បាន ។
លោក បាន ថ្លែង ថា នេះ ជា លើក ទី ពីរ ហើយ ដែល គ.ជ. ប បាន រៀបចំ ឱ្យ មាន វគ្គ បណ្តុះបណ្តាល នេះ ឡើង ក្នុង គោលបំណង ដើម្បី ពង្រឹង សមត្ថភាព មន្ត្រីរាជការ គ.ជ. ប ពិសេស ថ្នាក់ដឹកនាំ លេខាធិការដ្ឋាន រាជធានី ខេត្ត រៀបចំ ការបោះឆ្នោត អំពី ការរៀបចំ ចាត់ចែង ដំណើរការបោះឆ្នោត ដើម្បី ត្រៀមលក្ខណសម្បត្តិ ក្នុង ការចូលរួម អនុវត្ត ការងារ បោះឆ្នោត នា ពេល ខាងមុខ ឱ្យ ទទួលបាន ជោគជ័យ ស្រប តាម ច្បាប់ បទបញ្ជា និង នីតិវិធី របស់ គ.ជ. ប ។
លោក បាន បញ្ជាក់ ថា នេះ ជា ជំហាន ថ្មី មួយ ទៀត ក្នុង ក្របខ័ណ្ឌ ការងារ កែទម្រង់ របស់ គ.ជ. ប ដើម្បី ពង្រឹង សមត្ថភាព មន្ត្រីរាជការ គ.ជ. ប ទៅ តាម មុខជំនាញ ទទួលខុសត្រូវ ដើម្បី ធានា ឱ្យ មាន ប្រសិទ្ធភាព ខ្ពស់ លើ ការងារ តាមរយៈ ការបណ្ដុះបណ្ដាល ដល់ មន្ត្រី គ.ជ. ប គ្រប់ លំដាប់ថ្នាក់ ឱ្យ ទទួលបាន ចំណេះដឹង ជំនាញ និង ព័ត៌មាន គ្រប់គ្រាន់ ដើម្បី អនុវត្ត ការងារ ឱ្យ ទទួលបាន ជោគជ័យ ។
ទន្ទឹមនឹង នេះ លោក មាន ជំនឿ យ៉ាង មុតមាំ ថា មន្ត្រីរាជការ គ.ជ. ប ទាំងអស់ នឹង ទទួលបាន ចំណេះដឹង ថ្មី ៗ បន្ថែម ទៀត ដើម្បី ជា មូលដ្ឋាន ក្នុង ការអនុវត្ត ការងារ ឱ្យ កាន់តែ ល្អ ប្រសើរ ។ ការគ្រប់គ្រង ការបោះឆ្នោត គឺជា ដំណើរការ រៀបចំ ដែល មាន ភាពស្មុគស្មាញ ទាមទារ ឱ្យ មាន ធនធាន គ្រប់គ្រាន់ មាន មន្ត្រី ដែល មាន ជំនាញ បច្ចេកទេស យល់ដឹង ច្បាស់លាស់ ពាក់ព័ន្ធ នឹង កិច្ចការ បោះឆ្នោត ក្នុង ស្ថាប័ន រៀបចំ ការបោះឆ្នោត ដូចនេះ ការបណ្ដុះបណ្ដាល អំពី ការងារ ជំនាញ ដល់ មន្ត្រី បោះឆ្នោត នេះ គឺជា រឿង ចាំបាច់ ដែល ខកខាន ពុំ បាន ។
លោក បាន បន្ត ទៀត ថា បន្ទាប់ពី បញ្ចប់ វគ្គ បណ្តុះបណ្តាល នេះ ថ្នាក់ដឹកនាំ លេខាធិការដ្ឋាន គ.ជ. ប ទាំងអស់ នឹង ពិនិត្យ មើល ឡើងវិញ អំពី ការធ្វើ វិសោធនកម្ម បទបញ្ជា និង នីតិវិធី និង ក្រមសីលធម៌ សម្រាប់ គណបក្ស នយោបាយ ដើម្បី កែសម្រួល មុននឹង ឈាន ទៅដល់ ការដាក់ ជូន ភាគី ពាក់ព័ន្ធ ទាំង ១១ពិនិត្យ និង ដើម្បី ត្រៀមលក្ខណៈ សម្រាប់ ការងារ នៅ ឆ្នាំ ២០២១ ខាងមុខ នេះ ។
សូម ជម្រាប ជូន ថា វគ្គ បណ្ដុះបណ្ដាល នេះ រៀបចំឡើង រយៈពេល ៤ ថ្ងៃ គឺ ចាប់ពី ថ្ងៃទី ២៦ ដល់ ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០២០ នៅ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត ព្រៃវែង ដែល មាន អ្នកចូលរួម ចំនួន ប្រមាណ ជា ១២០ នាក់ ដែល ជា មន្ត្រី មកពី ទីស្ដីការ គ.ជ. ប និង លធ . ខប ទាំង ២៥ រាជធានី ខេត្ត ៕
ដំណឹង មរណភាព ! លោក ឱក សុជាតិ ទីប្រឹក្សា រាជ រដ្ឋាភិបាល និង ជា អតីត ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ហ្វីលីពីន បាន ទទួលមរណភាព ក្នុង អាយុ ៦៦ ឆ្នាំ
( ភ្នំពេញ ) ៖ លោក ឱក សុជាតិ ទីប្រឹក្សា រាជ រដ្ឋាភិបាល និង ជា អតីត ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ ប្រទេស ហ្វីលីពីន បាន ទទួលមរណភាព ដោយ រោគា ពាធ នៅក្នុង ជន្មាយុ ៦៦ ឆ្នាំ ។
មរណភាព របស់ លោក ឱក សុជាតិ គឺជា ការបាត់បង់ នូវ ស្វាមី ឪពុក ជីតា ប្រកបដោយ ព្រហ្មវិហារ ធម៌ មួយ រូប និង ជា ការបាត់ មន្ត្រី ដ៏ ឆ្នើម ដែល ក្នុង មួយ ជីវិត របស់ លោក បាន លះបង់ សព្វ បែប យ៉ាង ក្នុង បុព្វហេតុ បម្រើ ជាតិ សាសនា ព្រះមហាក្សត្រ និង បាន ចូលរួម កសាង ប្រទេស ជាមួយ ថ្នាក់ដឹកនាំ រាជ រដ្ឋាភិបាល កម្ពុជា ។
