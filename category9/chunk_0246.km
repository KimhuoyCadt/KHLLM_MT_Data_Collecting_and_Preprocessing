( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ សូម ថ្លែង យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោក ឌី វិជ្ជា អគ្គ ស្នងការ រង នគរបាល ជាតិ និង លោកស្រី ហ៊ុន ម៉ាណា ដែល បាន ចូលរួម ឧបត្ថម្ភ អំណោយ សម្រាប់ ជួយ សង្រ្គោះ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល ទទួល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
សាលា រាជធានី ភ្នំពេញ ទទួលបាន នូវ ការឧបត្ថម្ភ រួម មាន៖
លោក ឃួង ស្រេង បាន ប្រាប់ បណ្តាញ ព័ត៌មាន Fresh News នៅ ព្រឹក ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ នេះ ថា រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង យក អំណោយ ទាំងនេះ ទៅ ប្រើ សម្រាប់ ចែកជូន បន្ដ ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ស្ទឹង ព្រែក ត្នោត ពិសេស ប្រជាពលរដ្ឋ នៅ មូលដ្ឋាន ខណ្ឌ ដង្កោ ដែល កំពុង ជម្លៀស មកកាន់ ទី ទួល សុវត្ថិភាព ។
តាម ផែនការ ដែល បាន គ្រោង ទុក សម្ដេច តេជោ ហ៊ុន សែន នៅ ព្រឹក ថ្ងៃទី ២២ ខែតុលា ឆ្នាំ ២០២០ ស្អែក នេះ បន្ទាប់ពី បញ្ចប់ ពិធី សំណេះសំណាល និង ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ជាង ១ម៉ឺន គ្រួសារ ទៀត នៅ ក្រុង ប៉ោយប៉ែត និង ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ សម្ដេច នឹង ធ្វើដំណើរ តាម ឧទ្ធម្ភាគចក្រ ត្រឡប់មក រាជធានី ភ្នំពេញ វិញ ដើម្បី ដឹកនាំ កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ដ្រី នៅ ព្រឹក ថ្ងៃសុក្រ ។
ដោយសារតែ ស្ថានភាព មិន ទាន់ ធូរស្រាល និង មិន អាច មើល រំលង ពី ទុក្ខលំបាក របស់ ប្រជាពលរដ្ឋ ដែល រង នូវ ការវាយប្រហារ ដោយ ទឹក ជំនន់ នោះ ប្រមុខ នៃ រាជ រដ្ឋាភិបាល ដែល តែង នៅក្បែរ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ទាំងអស់ បាន បញ្ជាក់ ជាថ្មី ថា ក្រោយ បញ្ចប់ កិច្ចប្រជុំ ពេញ អង្គ គណៈ រដ្ឋមន្ដ្រី សម្ដេច នឹង ត្រឡប់ ទៅ ខេត្ត មួយ នេះ ម្ដង ទៀត ។
សម្ដេច តេជោ ហ៊ុន សែន បាន មានប្រសាសន៍ យ៉ាង ដូច្នេះ ថា « ស្អែក នេះ ខ្ញុំ ត្រឡប់ ទៅ ( ភ្នំពេញ ) ដើម្បី ដឹកនាំ កិច្ចប្រជុំ គណៈ រដ្ឋមន្ដ្រី នៅ ថ្ងៃសុក្រ ហើយ ថ្ងៃសៅរ៍ ខ្ញុំ នឹង វិលត្រឡប់ មកវិញ ( បន្ទាយមានជ័យ ) ព្រោះថា ប្រជាពលរដ្ឋ មកដល់ ពេលនេះ មិន មែន ២ម៉ឺន គ្រួសារ ទេ ដែល រងគ្រោះ នៅក្នុង ខេត្ត បន្ទាយមានជ័យ ឡើង ដល់ ៣ម៉ឺន ចឹង ខ្ញុំ ត្រូវ ឲ្យ រៀបចំ ១៥.០០០ គ្រួសារ ទៀត ខ្ញុំ នឹង ហោះ តាម ឧទ្ធម្ភាគចក្រ មក ព្រឹក ថ្ងៃសៅរ៍ » ។
ក្នុង កាលៈទេសៈ នេះ សម្ដេច តេជោ នាយក រដ្ឋមន្ដ្រី បាន ណែនាំ ទៅ រដ្ឋបាល ខេត្ត បន្ទាយមានជ័យ ត្រូវ យកចិត្តទុកដាក់ ស្រាវជ្រាវ រក ពលរដ្ឋ ណា ដែល មិន ទាន់ បាន ទទួល ជំនួយ ព្រោះថា ខេត្ត បន្ទាយមានជ័យ គឺជា ខេត្ត ដែល រងគ្រោះ ធ្ងន់ ជាង គេ ក្នុង ចំណោម បណ្ដា ខេត្ត ដែល មាន ទឹក ជំនន់ ។
ក្នុង នាម រាជ រដ្ឋាភិបាល សម្ដេច តេជោ ហ៊ុន សែន បាន សម្ដែង នូវ ការសោកស្ដាយ ជាមួយនឹង អ្វី ដែល បាន បាត់បង់ ហើយ នេះ មិន មែន គ្រាន់តែ ជា ការបាត់បង់ របស់ ក្រុមគ្រួសារ នីមួយ ៗ នោះ ទេ ប៉ុន្ដែ នេះ ជា ការបាត់បង់ របស់ ជាតិ យើង ទាំងមូល ក្នុង ការលំបាក នៅក្នុង ជីវភាព រស់ នៅ របស់ ប្រជាជន ។
សម្ដេច បាន អះអាង ថា ផល ប៉ះពាល់ ទាំងឡាយ ដែល បណ្ដាល មកពី ទឹក ជំនន់ នឹង បង្កើត ជា ទម្ងន់ បន្ថែម ក្នុង ពេល ដែល កម្ពុជា កំពុង ប្រឈម ជាមួយ ជំងឺ ឆ្លង រាតត្បាត កូវីដ - ១៩ ។
គួរ ជម្រាប ថា សម្ដេច តេជោ ហ៊ុន សែន បាន ចាកចេញ ពី រាជធានី ភ្នំពេញ ឆ្ពោះ ទៅកាន់ ខេត្ត បន្ទាយមានជ័យ កាលពី ថ្ងៃទី ២០ ខែតុលា ឆ្នាំ ២០២០ ម្សិលមិញ និង សម្រាក មួយ យប់ នៅ ខេត្ត សៀមរាប ទើប បន្ដ ដំណើរ ទៅ កន្លែង រងគ្រោះ ក្នុង ខេត្ត បន្ទាយមានជ័យ ។
ប្រសាសន៍ សំខាន់ ៗ របស់ សម្ដេច តេជោ ហ៊ុន សែន ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ ( គោលដៅ ទី២)
( បន្ទាយមានជ័យ )៖ សម្ដេច តេជោ ហ៊ុន សែន ប្រមុខ នៃ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល តែង នៅក្បែរ ប្រជាពលរដ្ឋ គ្រប់ កាលៈទេសៈ ទាំងអស់ នោះ នៅ ព្រឹក ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន អញ្ជើញ ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ៥ពាន់ គ្រួសារ ( គោលដៅ ទី២ ) ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ នៅ ស្រុក មង្គល បូរី ខេត្ត បន្ទាយមានជ័យ ។
សម្រាប់ ថ្ងៃទី ២១ ខែតុលា នេះ សម្តច តេជោ ហ៊ុន សែន ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ សរុប ១ម៉ឺន គ្រួសារ ( សរុប ទាំង ពីរ ទីតាំង ) ។
ខាងក្រោម ជា ខ្លឹមសារ សំខាន់ របស់ សម្តេច តេជោ ហ៊ុន សែន ថ្លែង នៅ គោលដៅ ទី ២៖
* សម្តេច តេជោ ហ៊ុន សែន បញ្ជាក់ ថា សម្តេច នឹង ត្រឡប ទៅ ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃសៅរ ម្តង ទៀត ក្រោយ កិច្ចប្រជុំ គណៈ រដ្ឋមន្រ្តី ដោយសារតែ ស្ថានភាព នៅ ធ្ងន់ធ្ងរ នៅឡើយ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ចង់ឱ្យ ប្រតិកម្ម រហ័ស ផលិត វីដេអូ មួយ ដែល ធ្វើ ការប្រៀបធៀប ទឹក ជំនន់ រវាង ប្រទេស កម្ពុជា ជាមួយ ប្រទេស ផ្សេង
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា មកដល់ ម៉ោង នេះ ទោះបីជា បរទេស ណា ប្រកាស ផ្តល់ ជំនួយ រឿង ទឹក ជំនន់ ប៉ុន្តែ រាជ រដ្ឋាភិបាល កម្ពុជា មិន ទាន់ បាន ទទួល មួយ កាក មួយ សេន នៅឡើយ ទេ ។
* សម្តេច តេជោ បន្ត អំពាវនាវ កុំ ឱ្យ ប្រមាថ ជន ពិការ ។ បើ មិន បាន ធ្វើ អ្វី ជួយ ជន ពិការ កុំ ប្រមាថ ។ ក្នុង នាម សម្តេច ជា នេះ ពិការ ព្រោះ ជាតិ សម្តេច ឈឺចាប់ ណាស់ ការប្រមាថន នេះ
* សម្តេច តេជោ ហ៊ុន សែន ថ្លែង ចង់ បង្កើត សមាគម មួយ ដើម្បី ជួយ ការពារ សិទ្ធិ ជន ពិការ
* សម្តេច តេជោ ហ៊ុន សែន ផ្តាំផ្ញើ ដល់ ម្ចាស់ ជំនួយ ជា សប្បុរសជន ថា មិន ធ្វើឱ្យ ម្ចាស់ ជំនួយ ខកចិត្ត ទេ ហើយ សន្យា ថា នឹង ប្រើប្រាស់ ទៅដល់ ជនរងគ្រោះ ពិតប្រាកដ
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា កិច្ចការ បន្ទាប់ ក្រោយ បញ្ចប់ ទឹក ជំនន់ គឺ ការដាំដុះ តទៅទៀត ដើម្បី ជំរុញ វិស័យ កសិកម្ម
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែង ថា គ្រោះ ផ្ទួន គ្នា សម្រាប់ កម្ពុជា តែ ទន្ទឹមនឹង ជួប គ្រោះ ទឹក ជំនន់ យើង មិន ត្រូវ ភ្លេច ការពារ ខ្លួន ពី កូវីដ១៩
* សម្តេច តេជោ ហ៊ុន សែន បាន ថ្លែងអំណរគុណ ដល់ ពលរដ្ឋ ដែល បាន បោះឆ្នោត ជូន គណបក្ស ប្រជាជន កម្ពុជា គាំទ្រ សម្តេច ធ្វើជា នាយក រដ្ឋមន្រ្តី ហើយ ស្នើ ឱ្យ ពលរដ្ឋ បន្ត បោះឆ្នោត គាំទ្រ គណបក្ស ប្រជាជន បន្ត ទៀត
អាជ្ញាធរ កំពុង តាមដាន កម្ពស់ ទឹក ស្ទឹង សែន ខេត្ត ព្រះវិហារ ដើម្បី ត្រៀម ជួយសង្គ្រោះ ពលរដ្ឋ . ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ៣០ គ្រួសារ នៅ សង្កាត់ កំពង់ប្រណាក ទទួល អំណោយ ពី កាកបាទ ក្រហម
( ព្រះវិហារ ) ៖ លោក ឡុង សុវណ្ណ ប្រធាន ក្រុមប្រឹក្សា ខេត្ត ព្រះវិហារ និង លោក ប្រាក់ សុវណ្ណ អភិបាល ខេត្ត និង ជា ប្រធាន គណៈកម្មាធិការ សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត នៅ ព្រឹក ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ ក្រុមការងារ បន្ត នាំយក អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា ផ្តល់ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ និង ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ចំនួន ៣០ គ្រួសារ នៅ ភូមិ ចំនួន ៣ ក្នុង សង្កាត់ កំពង់ប្រណាក ក្រុង ព្រះវិហារ ខេត្ត ព្រះវិហារ ។
នៅក្នុង ឱកាស នោះ ដែរ លោក ប្រាក់ សុវណ្ណ បាន ផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ជានិច្ច ជាកាល សម្តេច តែងតែ យកចិត្តទុកដាក់ គិតគូ ជានិច្ច ពី សុខ ទុក្ខ និង ការរស់នៅ បងប្អូន ប្រជាពលរដ្ឋ យើង ពិសេស ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ផ្សេង ៗ និង ប្រជាពលរដ្ឋ ជាចាស់ជរា គ្មាន ទីពឹង ក្មេង កំព្រា ស្ត្រី មេម៉ាយ ជាដើម ។
លោក ប្រាក់ សុវណ្ណ បាន ថ្លែង ថា សម្រាប់ ប្រជាពលរដ្ឋ នៅក្នុង ខេត្ត ព្រះវិហារ មាន ភ័ព្វសំណាង ខ្លាំង ណាស់ ដែល មិន បាន រងគ្រោះ ធ្ងន់ធ្ងរ ដោយ ទឹក ជំនន់ ដូច ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ នៅ ខេត្ត ពោធិ៍សាត់ ខេត្ត បាត់ដំបង ខេត្ត ប៉ៃលិន និង ខេត្ត បន្ទាយមានជ័យ ។ លោក ថា ព្រឹក នេះ ផងដែរ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា កំពុង មាន វត្តមាន នៅ ខេត្ត បន្ទាយមានជ័យ ដឹកនាំ ក្រុមការងារ ចុះ សង្គោះ ប្រជាពលរដ្ឋ និង ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ជាង ១០០០០ គ្រួសារ ។
លោក ប្រាក់ សុវណ្ណ ក៏ ថ្លែង ផ្តាំផ្ញើ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ ពិសេស បងប្អូន ប្រជាពលរដ្ឋ ដែល រស់ នៅ តាម ដងស្ទឹង សែន ត្រូវ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ ទ្រព្យសម្បត្តិ មាន តម្លៃ និង ត្រូវ អប់រំ ណែនាំ កូន ចៅ តូច ៗ កុំ ឲ្យ ចុះ លេង ទឹក ផ្តេសផ្តាស ខ្លាច មាន គ្រោះថ្នាក់ ជា យថាហេតុ ណាមួយ កើតឡើង ។ ពិសេស ត្រូវ ថែរក្សា សុខភាព ឲ្យបាន ល្អ ត្រូវ ហូប ស្អាត ផឹក ស្អាត រស់ នៅ ស្អាត ជានិច្ច ដើម្បី ការពារ ពី ជំងឺ ផ្សេង ៗ និង ត្រូវ បន្ត អនុវត្តន៍ វិធានការ របស់ ក្រសួង សុខាភិបាល ដើម្បី ការពារ ពី ជំងឺ កូវីដ១៩ ផងដែរ ។
សូម បញ្ជាក់ ថា សម្ភារ ដែល ផ្តល់ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ក្នុង ពេលនេះ គឺ ក្នុង មួយ គ្រួសារ ៗ ទទួលបាន៖ អង្ករ ២៥ គីឡូ មី១ កេស ត្រីខ១យួរ ទឹកស៊ី អីវ ១យួរ ទឹក បរិសុទ្ធ ២យួរ តង់១ សារុង១ ក្រមា១ ភួយ ១ មុង១ និង ថវិកា មួយ ចំនួន ៕ អនុវត្ត តាម អនុសាសន៍ របស់ សម្តេច នាយក រដ្ឋមន្ត្រី . ឧកញ៉ា វ័យ ក្មេង ៨នាក់ ប្រមូល ថវិកា បាន ៨ម៉ឺន ដុល្លារ ទិញ ស្បៀងអាហារ ចែកជូន ពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ក្នុង ខេត្ត បន្ទាយមានជ័យ
ឧកញ៉ា អ៉ឹង ឃាង បាន បញ្ជាក់ ឲ្យដឹង ថា ការចែកជូន អំណោយ ស្បៀងអាហារ ដល់ ប្រជាពលរដ្ឋ នេះ នឹង ធ្វើឡើង ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ នៅ ថ្ងៃទី ២៣ ខែតុលា ឆ្នាំ ២០២០ ដល់ ប្រជាពលរដ្ឋ ១ ពាន់ គ្រួសារ ហើយ អំណោយ ដែល ត្រូវ ចែកជូន រួម មាន៖ អង្ករ មី ទឹកត្រី ទឹក ស៉ី អ៉ីវ ទឹក បរិសុទ្ធ និង ថវិកា មួយ ចំនួន ផងដែរ ។
អំណោយ របស់ សម្តេច ហេង សំរិន ត្រូវបាន យក ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ចំនួន ៣០០ គ្រួសារ ដែល រងគ្រោះ ទឹក ជំនន់ នៅ ខេត្ត ពោធិ៍សាត់
( ពោធិ៍សាត់ )៖ នៅ ព្រឹក ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ លោក រ៉ូហ្វី អូស្មាន តំណាងរាស្ត្រ មណ្ឌល ខេត្ត ពោធិ៍សាត់ បាន អញ្ជើញ សំណេះសំណាល សាកសួរ សុខទុក្ខ និង នាំយក នូវ អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ របស់ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង អំណោយ របស់ ក្រុមការងារ រាជ រដ្ឋ ភិបាល ចុះ ជួយ ខេត្ត ពោធិ៍សាត់ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ចំនួន ៣០០ គ្រួសារ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ ចំនួន ៧ភូមិ ក្នុង ឃុំ ព្រងិល ស្រុក ភ្នំ ក្រវាញ ខេត្ត ពោធិ៍សាត់ ។
ក្នុង ឱកាស នោះ លោក រ៉ូហ្វី អូស្មាន បាន នាំ នូវ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ ពី សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា និង សម្តេច ធម្មវិសុទ្ធ វង្សា សៅ ទី ហេង សំរិន និង ចូលរួម សោកស្តាយ ជាមួយ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ទាំងអស់ ដោយ ក្តីអាណិតអាសូ សម្តេច ទាំង ទ្វេ តែងតែ បាន យកចិត្តទុកដាក់ និង ខ្វល់ខ្វាយ ជាប់ ជានិច្ច ចំពោះ ស្ថានភាព រស់ នៅ របស់ បងប្អូន ជាពិសេស នៅក្នុង ពេល រងគ្រោះ ដោយ ទឹក ជំនន់ នេះ ។
ជាមួយគ្នា នេះ លោក រ៉ូហ្វី អូស្មាន បាន បន្ត ក្រើន រំលឹក ដល់ ប្រជាពលរដ្ឋ គ្រប់ រូប ឲ្យ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ចំពោះ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ដោយ នៅតែ អនុវត្ត ឲ្យបាន ខ្ជាប់ខ្ជួន នៅ វិធានការ របស់ ក្រសួង សុខាភិបាល ត្រូវ ថែរក្សា សុខភាព ឲ្យបាន ល្អ និង ចូលរួម សម្អាត ភូមិ លំនៅដ្ឋាន របស់ ខ្លួន នៅពេល ទឹក ជំនន់ បាន ស្រកចុះ ទៅ វិញ ៕
ជាមួយគ្នា នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន អំពាវនាវ ដល់ ធនាគារ និង គ្រឹះស្ថាន មីក្រូហរិញ្ញវត្ថុ មិន ត្រូវ រឹបអូស ទ្រព្យសម្បត្តិ ផ្ទះ សំបែង ដីធ្លី របស់ ប្រជាពលរដ្ឋ ដែល ប៉ះពាល់ ក្នុង ដំណាក់កាល កូវីដ១៩ និង នៅក្នុង ដំណាក់កាល នៃ គ្រោះ ទឹក ជំនន់ នោះ ឡើយ ។
ជាថ្មី ម្តង ទៀត សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន អំពាវនាវ ផងដែរ ដល់ ស្ថាប័ន ធនាគារ និង គ្រឹះ មីក្រូ ហិញ្ញវត្ថុ សូមឲ្យ រឹបអូស ទ្រព្យសម្បត្តិ របស់ អ្នក ដែល ជឿ តាម ក្រុម ញុះញង់ ចង់ឲ្យ វិស័យ ធនាគារ នៅ កម្ពុជា រដួលរលំ តាមរយៈ ការអំពាវនាវ ឲ្យ ប្រជាជន ដក ប្រាក់ ចេញ ពី ធនាគារ ឲ្យ អស់ និង មិន ឲ្យ សង ត្រឡប់ ទៅ ធនាគារ វិញ ជាដើម ដែល ការណ៍ នេះ សម្តេច គាំទ្រ ឲ្យ មាន ការរឹបអូស ទ្រព្យសម្បត្តិ បើសិន ជឿ លើ ការឃោសនា របស់ ក្រុម ទាំងនោះ ។
សម្តេច ប្រមុខ រាជ រដ្ឋាភិបាល បាន លើកឡើង ថា ស្ថាប័ន ធនាគារ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ធ្វើ អាជីវកម្ម ត្រូវការផល ចំណេញ ប៉ុន្តែ បើ ចំណេញ លើ ការលំបាក របស់ ប្រជាជន ក៏ ពុំ មែន ជា ការសប្បាយរីករាយ នោះ ដែរ ។ សម្តេច សង្ឃឹម ថា គ្រប់ ធនាគារ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ ទាំងអស់ នោះ ចូលរួម អនុវត្តន៍ តាម ការអំពាវនាវ របស់ សម្តេច ។
សម្តេច តេជោ ក៏ បាន ជំរុញ ឲ្យ ធនាគារ ជាតិ នៃ កម្ពុជា និង ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បន្ត ធ្វើ ការណែនាំ ដល់ គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ និង ស្ថាប័ន ធនាគារ ឲ្យ មាន ការយោគយល់ ដល់ ប្រជាពលរដ្ឋ ដែល បាត់បង់ ប្រាក់ ចំណូល ដោយសារ ជំងឺ កូវីដ១៩ និង ដោយសារ គ្រោះ ទឹក ជំនន់ នេះ ផងដែរ ។
សម្តេច បន្ត ថា បើ តាម របាយការណ៍ របស់ គណៈកម្មាធិការ គ្រប់គ្រង គ្រោះមហន្តរាយ គ្រោះ ធម្មជាតិ ដោយ ទឹក ជំនន់ កំពុង ប៉ះពាល់ ដល់ ប្រជាពលរដ្ឋ ចំនួន ១៤. ៣៤៨ គ្រួសារ ស្មើនឹង ប្រជាជន ជាង ៤១ម៉ឺន នាក់ ដែល ចំនួន នេះ មិន ច្រើន រហូតដល់ ធនាគារ និង គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ មិន អាច ជួយ ដោះស្រាយ បាន នោះ ទេ ។
តំណាង រដ្ឋមន្ដ្រី វង សូត ចុះ សំណេះសំណាល និង ចែក អំណោយ ជូន ពលរដ្ឋ ៧៦ គ្រួសារ ដែល រងគ្រោះ ទឹក ជំនន់ នៅ ក្រុង ច្បារមន
( កំពង់ស្ពឺ ) ៖ លោក ញ៉ឹក វណ្ណារ៉ា រដ្ឋលេខាធិការ តំណាង លោក វង សូត រដ្ឋមន្រ្តី ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា នៅ ព្រឹក ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ នេះ អញ្ជើញ ចុះ សំណេះសំណាល និង នាំយក គ្រឿង ឧបភោគ ជូន ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ចំនួន ៧៦ គ្រួសារ នៅ ភូមិ ពង្រ ភូមិ ស្វាយ ក្រវ៉ាន់ សង្កាត់ កណ្តោដុំ សង្កាត់ ស្វាយ ក្រវ៉ាន់ ក្រុង ច្បារមន ខេត្ត កំពង់ស្ពឺ ។
អំណោយ ទាំងនោះ រួម មាន អង្ករ មី ត្រីខ ទឹកត្រី ទឹក ស៉ី អ៉ីវ ប្រេង ឆា និង ថវិកា ៤ម៉ឺន រៀល ក្នុង មួយ គ្រួសារ ដែល ជា អំណោយ សប្បុរសធម៌ លោក ឧកញ៉ា អ៊ុច សម្បត្តិ ស្ថាបនិក ក្រុមហ៊ុន គ្រួសារ កក់ក្តៅ និង លោកស្រី ហ៊ឹម សុភ័ក្រ្ត អគ្គ នាយិការ ។
ក្នុង ពិធី នេះ ដែរ លោក ញ៉ឹក វណ្ណារ៉ា បាន លើកឡើង ថា ការជួយគ្នា ក្នុង គ្រា លំបាក គឺជា គុណធម៌ ដ៏ ប្រពៃ ដើម្បី គ្រួសារ កក់ក្តៅ និយាយ ជា រួម គឺ គ្រួសារ ខ្មែរ យើង ចេះ ជួយ គ្នា ក្នុង គ្រា ជួប ការលំបាក ។
ជាមួយគ្នា នោះ លោក ក៏ បាន សម្តែង នូវ ការកោតសរសើរ និង ថ្លែងអំណរគុណ ចំពោះ លោក ឧកញ៉ា អ៊ុច សម្បត្តិ ស្ថាបនិក ក្រុមហ៊ុន គ្រួសារ កក់ក្តៅ និង លោកស្រី ហ៊ឹម សុភ័ក្រ្ត អគ្គ នាយិការ ដែល ប្រកបដោយ ចិត្ត សប្បុរសធម៌ បាន យកចិត្តទុកដាក់ ចូលរួម ចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការផ្តល់ ភាពកក់ក្តៅ ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ៕
លោក ជា ចាន់ តូ៖ នៅពេល ប្រព័ន្ធ ធនាគារ និង ហិរញ្ញវត្ថុ រីកចម្រើន ជឿនលឿន ការពង្រឹង ប្រសិទ្ធភាព ត្រួតពិនិត្យ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា ក៏ ត្រូវ កែលម្អ ជា បន្តបន្ទាប់
( ភ្នំពេញ ) ៖ លោក ជា ចាន់តូ ទេសាភិបាល ធនាគារ ជាតិ នៃ កម្ពុជា បាន លើកឡើង ថា នៅពេល ប្រព័ន្ធ ធនាគារ និង ហិរញ្ញវត្ថុ រីកចម្រើន ជឿនលឿន យ៉ាង ឆាប់រហ័ស ការពង្រឹង ប្រសិទ្ធភាព ត្រួតពិនិត្យ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា ក៏ ត្រូវ កែលម្អ ជា បន្តបន្ទាប់ ។
ជាក់ស្ដែង ធនាគារ ជាតិ នៃ កម្ពុជា ត្រូវ ធ្វើ កំណែទម្រង់ អគ្គ នាយកដ្ឋាន ត្រួតពិនិត្យ ដើម្បី ធានា បាន នូវ សុខភាព និង និរន្តរភាព គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ។
ការលើកឡើង របស់ លោក ជា ចាន់តូ ធ្វើឡើង ក្នុង ឱកាស លោក អញ្ជើញ ចូលរួម កម្មវិធី សំណេះសំណាល ជាមួយ មន្រ្តី - បុគ្គលិក អគ្គ នាយកដ្ឋាន ត្រួតពិនិត្យ ដែល ត្រូវ ទទួលបាន ការផ្ទេរបញ្ចូល និង តែងតាំង ថ្មី បន្ទាប់ពី អគ្គ នាយកដ្ឋាន ត្រួតពិនិត្យ បាន ធ្វើ កំណែទម្រង់ រចនាសម្ព័ន្ធ ឡើងវិញ ស្រប តាម ផែនទី បង្ហាញ ផ្លូវ នៃ ការត្រួតពិនិត្យ ផ្អែក លើ ហានិភ័យ និង ទស្សនៈ អនាគត និង និយាម អន្តរជាតិ ក្នុង ការត្រួតពិនិត្យ គ្រឹះស្ថាន ធនាគារ ប្រកបដោយ ប្រសិទ្ធភាព ។
លោក ទេសាភិបាល បាន លើកឡើង ថា « នៅ ពេល ដែល ប្រព័ន្ធ ធនាគារ និង ហិរញ្ញវត្ថុ មាន ការរីកចម្រើន ជឿនលឿន យ៉ាង ឆាប់រហ័ស ការពង្រឹង ប្រសិទ្ធភាព ត្រួតពិនិត្យ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា ក៏ ត្រូវបាន កែលម្អ ជា បន្តបន្ទាប់ ។ ដូច្នេះ ធនាគារ ជាតិ នៃ កម្ពុជា ត្រូវ ធ្វើ កំណែទម្រង់ អគ្គ នាយកដ្ឋាន ត្រួតពិនិត្យ ដើម្បី ធានា បាន នូវ សុខភាព និង និរន្តរភាព គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ » ។
លោក បន្ដ ថា ទន្ទឹម នេះ ធនធាន មនុស្ស ក៏ ត្រូវ ធ្វើ ការបែងចែក តាម ចំណេះដឹង ជំនាញ និង តាម តម្រូវការ ជាក់ស្តែង ។
លើស ពី នេះ លោក ទេសាភិបាល បាន ផ្តល់ ឱវាទ សំខាន់ ៗ មួយចំនួន ដល់ មន្រ្តី - បុគ្គលិក របស់ ធនាគារ ជាតិ នៃ កម្ពុជា ទាំងអស់ រួម មាន៖
ការថ្លែង របស់ សម្តេច តេជោ ហ៊ុន សែន យ៉ាង ដូច្នេះ ធ្វើឡើង ក្នុង ឱកាស សម្តេច អញ្ជើញ ចុះ សាកសួរ សុខទុក និង នាំយក អំណោយ ចែកជូន បងប្អូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ខេត្ត បន្ទាយមានជ័យ ក្នុង នោះ មាន បងប្អូន ជន ពិការ ផងដែរ ។
ក្នុង ឱកាស នោះ សម្តេច តេជោ ហ៊ុន សែន បាន អំពាវនាវ ដល់ បងប្អូន ជន រួម ជាតិ ទាំង សូម មេត្តា យោគយល់ ចំពោះ ជន ពិការ បើ ទោះបី មិន បាន ផ្តល់ អ្វី ឲ្យ ជន ពិការ សូម កុំ ប្រមាថ ជន ពិការ ដោយ ប្រើប្រាស់ ពាក់ពេចន៍ អសុរោះ មក លើ ជន ពិការ ។
សម្តេច តេជោ បាន លើកឡើង ថា សម្តេច ទទួលបាន ការឈឺចាប់ ធ្ងន់ធ្ងរ ណាស់ នៅពេល គេ ប្រមាថ សម្តេច ហៅ សម្តេច ថា « អាខ្វាក់ » ហើយ សម្តេច នឹង មិន អត់ឱន ឲ្យ ទេ ចំពោះ អ្នក ដែល ហៅ សម្តេច ថា « អាខ្វាក់ » ព្រោះ ការខូច ភ្នែក ម្ខាង របស់ សម្តេច គឺ ខូច ដើម្បី ជាតិ មាតុភូមិ ដែល មិន គួរ ទទួលបាន ការប្រមាថ ដូចនេះ ទេ ។
សម្តេច តេជោ ហ៊ុន សែន បាន អំរុញ ឲ្យ អាជ្ញាធរ មាន សមត្ថកិច្ច យកចិត្តទុកដាក់ ដល់ ជន ពិការ ផងដែរ ហើយ ជា ទម្លាប់ របស់ សម្តេច ឲ្យ តែ បាន ជួប ជន ពិការ តែងតែ ជួយ ឧបត្ថម្ភ ដល់ ជន ពិការ ទាំងនោះ ។
សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន ថ្លែង យ៉ាង ដូចនេះ ថា « មកដល់ ម៉ោង នេះ ពេលនេះ ទោះបី បរទេស ខ្លះ ប្រកាស ថា ផ្តល់ ជំនួយ ក៏ប៉ុន្តែ យើង មិន ទាន់ បាន ទទួល មួយ សេន ណា យកមក ប្រើប្រាស់ ទេ » ។
សម្តេច តេជោ ហ៊ុន សែន ក៏ បាន បន្ថែម ទៀត ថា សម្តេច តែងតែ ប្រាប់ ទៅដល់ រដ្ឋមន្ត្រី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ថា ត្រូវតែ ត្រៀម ថវិកា បម្រុងទុក ដើម្បី បាន ប្រើប្រាស់ ភ្លាម ៗ ជាក់ស្តែង នៅ ពេល នេះ ពលរដ្ឋ ២ម៉ឺន គ្រួសារ បាន ទទួល អំណោយ ដែល បាន យក ពី រាជធានី ភ្នំពេញ ហើយ នៅ ពេល នេះ ដែរ ក៏ ត្រូវតែ ដឹក អំណោយ មក បន្ថែម ចំនួន ១៥.០០០ គ្រួសារ ដើម្បី ទុក ចែកជូន ពលរដ្ឋ រងគ្រោះ បន្ថែម ទៀត ក្នុង ស្តង់ដារ របស់ សម្តេច ។
សូម បញ្ជាក់ ដែរ ថា កាលពី ល្ងាច ថ្ងៃទី ១៧ ខែតុលា ឆ្នាំ ២០២០ សហរដ្ឋ អាមេរិក តាមរយៈ ទីភ្នាក់ងារ ផ្តល់ ជំនួយ របស់ សហរដ្ឋ អាមេរិក USAID បាន ប្រកាស ផ្តល់ ថវិកា សរុប ចំនួន ១០០.០០០ ដុល្លារ ជា ជំនួយ មនុស្សធម៌ ដើម្បី ជួយ ក្នុង ការឆ្លើយតប នឹង គ្រោះ ធម្មជាតិ ទឹក ជំនន់ ដែល បង្កឡើង ដោយ ទឹកភ្លៀង នៅ ប្រទេស កម្ពុជា តែ មកដល់ ពេលនេះ កម្ពុជា មិន ទាន់ ទទួលបាន ជំនួយ មួយ សេន ណាមួយ ឡើយ ។
ក្រសួង ការងារ ជូនដំណឹង ពី ការបើក ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ លើក ទី៣៤ ជូន កម្មករ និយោជិត ជិត ២ពាន់ នាក់ ទៀត ដែល ត្រូវបាន ព្យួរ កិច្ចសន្យា ការងារ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការបើក ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ ( លើក ទី៣៤ ) ជូន បងប្អូន កម្មករ និយោជិត សរុប ចំនួន ១៩៣៧ នាក់ នៅ រោងចក្រ សហគ្រាស ចំនួន ៩ ក្នុង វិស័យ កាត់ដេរ ដែល ត្រូវបាន ព្យួរ កិច្ចសន្យា ការងារ ស្រប តាម ស្មារតី នៃ កញ្ចប់ វិធានការ របស់ រាជ រដ្ឋាភិបាល ។ នេះ បើ តាម សេចក្តីជូនដំណឹង ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ៕
បើ តាម លោក ហង្ស សាមឿន ទឹក ជំនន់ បាន បង្ក ផល ប៉ះពាល់ ដល់ ១៩ រាជធានី - ខេត្ត ស្មើ ៩១ ក្រុង / ស្រុក / ខណ្ឌ រួម មាន៖ ពោធិ៍សាត់ ប៉ៃលិន បន្ទាយមានជ័យ ភ្នំពេញ បាត់ដំបង ស្វាយរៀង ឧត្តរមានជ័យ សៀមរាប តាកែវ កំពង់ស្ពឺ មណ្ឌលគិរី ព្រះសីហនុ កោះ កុង ព្រះវិហារ ស្ទឹងត្រែង កំពង់ចាម កណ្តាល កំពង់ឆ្នាំង កំពង់ធំ ។
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម និង ជា ប្រធាន សាខា កាកបាទ ក្រហម ខេត្ត លោក អ៊ុន ចាន់ ដា បាន ណែនាំមន្ត្រី សាខា កាកបាទ ក្រហម ខេត្ត ឲ្យ ត្រៀមលក្ខណៈ ទាំង កម្លាំង ស្បៀង សម្ភារ និង ថវិកា ដើម្បី ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ឲ្យបាន ទាន់ ពេលវេលា ពេល មាន គ្រោះមហន្តរាយ កើតឡើង ។
លោក អភិបាល ខេត្ត បាន ថ្លែង ដូច្នេះ នា ព្រឹក ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ ក្នុង កិច្ចប្រជុំ បូកសរុប លទ្ធផល សកម្មភាព ការងារ រយៈពេល ៩ខែ ដើម ឆ្នាំ និង លើក ទិសដៅ ការងារ បន្ត ៣ខែ ចុង ឆ្នាំ ២០២០ នៅ ស្នាក់ការសាខា កាកបាទ ក្រហម ខេត្ត កំពង់ចាម ។
ជាមួយ នេះ សាខា ក៏ បាន រួមចំណែក ជាមួយ រដ្ឋាភិបាល ក្នុង កិច្ចសហការ ដឹកនាំ កម្លាំង យុវជន កាកបាទ ក្រហម កម្ពុជា និង អ្នកស្ម័គ្រចិត្ត ចុះ យុទ្ធនាការ អប់រំ ផ្សព្វផ្សាយ អំពី សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក និង ការអប់រំ សុខភាព ពាក់ព័ន្ធ ទៅនឹង ការកាត់បន្ថយ ហានិភ័យ នៃ ការឆ្លង កូវីដ១៩ . ជម្ងឺ គ្រុន ឈីក គ្រុន ឈាម នៅ តាម ភ្លើង ស្តុប នានា ក្នុង ក្រុង កំពង់ចាម ក្នុង ឱកាស ថ្ងៃ ឈប់សម្រាក ជំនួស ថ្ងៃ បុណ្យ ចូល ឆ្នាំ ថ្មី ប្រពៃណី ជាតិ ក្នុង អំឡុង ខែកក្កដា កន្លងទៅ នោះ ផងដែរ ។
( ភ្នំពេញ ) ៖ លោក ប៉ាន់ យ៉ារ៉ាក់ ភូន សាប់ ឯក អគ្គ រាជ ទូត នៃ ព្រះរាជាណាចក្រ ថៃ ប្រចាំ កម្ពុជា នៅ ថ្ងៃទី ២១ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ តំណាង ក្រុមហ៊ុន ថៃ ចំនួន ៧ ដែល កំពុង វិនិយោគ នៅ រាជធានី ភ្នំពេញ នាំ អំណោយ សប្បុរសធម៌ មក ប្រគល់ ជូន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ ដើម្បី បន្ត ចែកជូន ដល់ ប្រជាពលរដ្ឋ រង ដែល គ្រោះ ដោយសារ ទឹក ជំនន់ ។
លោក ប៉ាន់ យ៉ារ៉ាក់ ភូន សាប់ បាន ឱ្យដឹង ថា គោលបំណង ដែល លោក ដឹកនាំ វិស័យ ឯកជន របស់ ថៃ នាំ អណោយ មក ប្រគល់ ជូន គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ កម្ពុជា នា ថ្ងៃ នេះ ដើម្បី ចូលរួម រសម្រាល ការលំបាក របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ខណៈពេល បច្ចុប្បន្ន នេះ ប្រទេស កម្ពុជា កំពុង ជួប គ្រោះ ទឹក ជំនន់ ដែល ធ្វើឱ្យ ប៉ះពាល់ ដល់ បណ្តា រាជធានី - ខេត្ត ចំនួន ១៩ ។ ដូច្នេះ ក្នុង នាម ជា ប្រទេស ជាប់ ភូមិ ផង របង ជាមួយគ្នា មិន អាច ឈរ ឱប ដៃ មើល ទុក្ខលំបាក នោះ ទេ ។
ឯក អគ្គ រាជ ទូត ថៃ ប្រចាំ កម្ពុជា រូប នេះ បាន បញ្ជាក់ ថា អំណោយ ដែល នាំមក ប្រគល់ ជូន នា ឱកាស នេះ រួម មាន៖ អាហារ . ថ្នាំ ពេទ្យ ព្រមទាំង សម្ភារ ប្រើប្រាស់ មួយចំនួន ផងដែរ ។
ទន្ទឹមនឹង នេះ ដែរ លោក ហង្ស សាមឿន បាន ឱ្យដឹង ថា ដោយ គិត ចាប់ពី ថ្ងៃទី ០១ ខែកញ្ញា ដល់ ថ្ងៃទី ២០ ខែតុលា ឆ្នាំ ២០២០ កម្ពុជា បាន ទទួលរង ផល ប៉ះពាល់ នៅក្នុង ១៩រាធានី - ខេត្ត ក្នុង នោះ មាន ប្រជាជនរង ផល ប៉ះពាល់ ចំនួន ១០៤. ៣៤៨ គ្រួសារ ស្មើ ប្រមាណ ៤១៧. ៣៩២ នាក់ . ប្រជាជន បាន ជម្លៀស មក ទី ទួល សុវត្ថិភាព ចំនួន ១០. ៥៨៣ គ្រួសារ ស្មើ ប្រមាណ ៤២. ៣៣២ នាក់ និង ប្រជាជន ស្លាប់ ចំនួន ៣៤ នាក់ ។ ចំពោះ ទិន្នន័យ រួម នៃ ផល ប៉ះពាល់ និង ខូចខាត នឹង ធ្វើ ការប៉ាន់ប្រមាណ បូកសរុប បន្ទាប់ពី ជំនន់ ទឹកភ្លៀង ត្រូវបាន បញ្ចប់ ។
