( បន្ទាយមានជ័យ )៖ ក្រោយពី មាន ភ្លៀង ធ្លាក់ ជាប់ ៗ គ្នា ធ្វើឲ្យ មាន ជំនន់ ទឹកភ្លៀង លិច ផ្លូវ លំ និង ប្រព័ន្ធ បង្ហូរ ទឹក មួយចំនួន មាន ការកកស្ទះ ហូរ ទឹក មិន ទាន់ នោះ . លោក គាត ហ៊ុល អភិបាល ក្រុង ប៉ោយប៉ែត បាន ដឹកនាំ ក្រុមការងារ នាំយក គ្រឿងចក្រ ចុះ កាយ ស្ដារ ប្រមូល សំរាម និង ល្បាប់ ភក់ ចេញ ពី ប្រឡាយ បាន ប្រវែង សរុប ជាង ៣០០០ ម៉ែត្រ នៅក្នុង ភូមិ ផ្សារ កណ្ដាល និង ភូមិបាលិលេយ្យ និង ភូមិ គីឡូ លេខ ៤ នៅ សង្កាត់ ប៉ោយប៉ែត ។
ប្រតិបត្តិការ ចុះ កាយ ស្ដារ ប្រមូល សំរាម និង ល្បាប់ ភក់ នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០២០ ដោយ ក្រុមការងារ អាជ្ញាធរ បាន កាយ ស្ដារ ប្រឡាយ តាម ចំណុច គោលដៅ រួម មាន៖ ភូមិ ផ្សារ កណ្ដាល សង្កាត់ ផ្សារ កណ្ដាល មេភូមិ អនុភូមិ និង កម្លាំង ប្រជាការពារ បាន ស្ដារ ចំនួន ៣ទីតាំង សរុប ប្រវែង ១.០០០ ម៉ែត្រ ។
ភូមិបាលិលេយ្យ សង្កាត់ ប៉ោយប៉ែត អនុភូមិ និង កម្លាំង ប្រជាការពារ បាន ស្ដារ ផ្លូវ ខាងត្បូង អនុវិទ្យាល័យ អូជ្រៅ ចាក់ ទៅ ស្រះ ៥០ សរុប ប្រវែង ជាង ១.០០០ ម៉ែត្រ និង ភូមិ គីឡូ លេខ ៤ បាន មួយចំនួន ផងដែរ ជាមួយគ្នា នោះ ក្រុមការងារ អភិវឌ្ឍន៍ សង្កាត់ ប៉ោយប៉ែត បាន ចុះ ស្ដារ ប្រមូល សំរាម មុខ លូ ប្រអប់ ផងដែរ ។
( បន្ទាយមានជ័យ )៖ ផ្ទះ ប្រជាពលរដ្ឋ ខ្មែរ ជាច្រើន ខ្នង នៅ តាម ព្រំដែន កម្ពុជា - ថៃ ក្នុង ខេត្ត បន្ទាយមានជ័យ ត្រូវបាន រង នៅ ការលិចលង់ ដោយ ទឹក ជំនន់ ធ្លាក់ មកពី ប្រទេស ថៃ និង ទឹកភ្លៀង គិត ត្រឹម ល្ងាច ថ្ងៃទី ៤ ខែតុលា ឆ្នាំ ២០២០ ។
ប្រឈម នឹង គ្រោះ ធម្មជាតិ មួយ នេះ កម្លាំង យោធា របស់ អង្គភាព វរសេនា តូច ថ្មើរជើង លេខ ៥១៣ សហការ ជាមួយ អាជ្ញាធរ និង សមត្ថកិច្ច ពាក់ព័ន្ធ បាន ចុះ ជួយសង្គ្រោះ ភ្លាម ៗ នៅក្នុង ភូមិ វត្ត ចាស់ ឃុំ អូរ បី ជាន់ ស្រុក អូរ ជ្រៅ ដោយ បាន សង្គ្រោះ ដឹកជញ្ជូន ទាំង សម្ភារ និង ជម្លៀស ពលរដ្ឋ ទៅកាន់ ទី ទួល មាន សុវត្ថិភាព ទាន់ ពេលវេលា ចំនួន ២៨ គ្រួសារ ។
លោក វរសេនីយ៍ ត្រី ប្លង់ ហឿប មេបញ្ជាការ ស្តីទី វរសេនា តូច ថ្មើរជើង លេខ ៥១៣ របស់ កងពល តូច ថ្មើរជើង លេខ ៥១ បាន ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News ប្រចាំ ខេត្ត បន្ទាយមានជ័យ នៅ ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២០ ថា នៅ ភូមិ វត្ត ចាស់ ឃុំ អូរ បី ជាន់ ស្រុក អូរ ជ្រៅ មាន ប្រជាពលរដ្ឋ ជាច្រើន គ្រួសារ រងគ្រោះ ដោយ ទឹក ធ្លាក់ មកពី ប្រទេស ថៃ និង ទឹកភ្លៀង បណ្តាលឲ្យ ជន់ លិច ផ្ទះ របស់ ពួកគាត់ ។
ភ្លាម ៗ លោក បាន ដឹកនាំ កម្លាំង ចំនួន ៣៥ នាក់ មាន រថយន្ត តូច ២គ្រឿង សហការ ជាមួយ កម្លាំង កងរាជអាវុធហត្ថ កម្លាំង នគរបាល និង អាជ្ញាធរ មូលដ្ឋាន ចុះ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រងគ្រោះ ។
លោក បាន បញ្ជាក់ ទៀត ថា កម្លាំងប្រដាប់អាវុធ ទាំង៣ រួម មាន នគរបាល អាវុធហត្ថ និង យោធា មាន ភារកិច្ច បន្ថែម ពី ការងារ ស្នូល គឺ ជួយ ដល់ ការងារ សង្គម ដូចជា ចុះ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយសារ គ្រោះ ធម្មជាតិ ផ្សេង ៗ មាន ជំនន់ ទឹកភ្លៀង ជាដើម ។
លោក បាន អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ទាំងអស់ ពេល មាន ទឹក ជំនន់ សូម បង្កើន ការយកចិត្តទុកដាក់ ប្រុងប្រយ័ត្ន ខ្ពស់ ដើម្បី ចៀសវាង គ្រោះថ្នាក់ ផ្សេង ៗ ដែល អាច កើត មាន ឡើង ដោយ យថាហេតុ និង ត្រៀម រក ទី ទួល សុវត្ថិភាព សម្រាប់ ជម្លៀស ប្រជាពលរដ្ឋ ដែល ងាយ រងគ្រោះ ជាដើម ផងដែរ ៕
អភិបាល ខេត្ត កំពង់ស្ពឺ ណែនាំ មន្ត្រី ជំនាញ យកចិត្តទុកដាក់ ឱ្យ បាន ខ្ពស់ អំពី ស្ថានភាព ទឹក ជំនន់ ជំងឺ ឆ្លង ផ្សេង ៗ និង ស្ថានភាព ផ្លូវ តាម មូលដ្ឋាន
( កំពង់ស្ពឺ ) ៖ នៅក្នុង ឱកាស ដឹកនាំ ក្រុមការងារ ចុះ ត្រួតពិនិត្យ និង ស្វែងរក សំណោះស្រាយ ដើម្បី ទប់ស្កាត់ គ្រោះមហន្តរាយ ផ្សេង ៗ ដែល កើតឡើង មកពី ជំនន់ ទឹកភ្លៀង កំពង់ស្ពឺ នៅ ព្រឹក ថ្ងៃទី ៥ ខែតុលា ឆ្នាំ ២០២០ នេះ លោក វ៉ី សំណាង អភិបាល កំពង់ស្ពឺ បាន អំពាវនាវ យ៉ាង ចាំបាច់ ចំពោះ មន្ទីរ កសិកម្ម មន្ទីរ ធនធាន ទឹក មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន និង មន្ទីរ សុខាភិបាល ត្រូវ ត្រៀម សង្គ្រោះ រាល់ បញ្ហា គ្រោះ ជំនន់ ទឹកភ្លៀង ជា យថាហេតុ ដែល អាច កើតមាន គ្រប់ ពេល ចំពោះ ខេត្ត កំពង់ស្ពឺ ។
អភិបាល ខេត្ត បាន បញ្ជាក់ ទៀត ថា ខេត្ត កំពង់ស្ពឺ នៅ មិន ទាន់ ទទួលរង ផល ប៉ះពាល់ ដោយ ជំនន់ ទឹកភ្លៀង នៅឡើយ ទេ មកទល់ ពេលនេះ ។ លោក អំពាវនាវ ថា ជំនន់ ទឹកភ្លៀង បើ ទោះបីជា មាន រយៈពេល ខ្លី ក៏ ពិត មែន ប៉ុន្តែ វា អាច ធ្វើឱ្យ ប៉ះពាល់ ដល់ ហេដ្ឋារចនាសម្ព័ន្ធ មួយ ចំនួន និង ក៏ អាច ធ្វើឲ្យ ប៉ះពាល់ ដល់ ជីវភាព រស់ នៅ របស់ ប្រជា ពលរដ្ឋ ផងដែរ ។ ចំពោះ ប្រជាពលរដ្ឋ ត្រូវ យកចិត្តទុកដាក់ ទៅ លើ ជន ចាស់ជរា ក្មេង ក្មេង ដែល អាច មាន បញ្ហា ប្រឈម ជាមួយនឹង ការលង់ទឹក ជាដើម ។
ក្នុង នោះ ដែរ អាជ្ញាធរ និង មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ត្រូវ យកចិត្តទុកដាក់ ដោយ ធ្វើ ការតាមដាន ឱ្យ ជាប់ ជាប្រចាំ ចំពោះ បញ្ហា ប្រឈម ទាំងឡាយ ដើម្បី អាច មាន លទ្ធភាព ឆ្លើយតប ក្នុង ការសង្គ្រោះ ទាន់ ពេលវេលា ជាពិសេស សូម មេត្តា កុំ ទ ន្រ្ទាន កាន់កាប់ ដី ចំណី ផ្លូវ របស់ រដ្ឋ ៕
