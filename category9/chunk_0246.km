( ភ្នំពេញ ) ៖ ក្នុង សប្តាហ៍ មុន នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា បាន ចំណាយ ពេលវេលា យ៉ាង ច្រើន ក្នុង ការចុះ ជួប សួរ សុខទុក្ខ ផ្តល់ កម្លាំងចិត្ត និង ផ្តល់ ជំនួយ ឧបត្ថម្ភ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅក្នុង ខេត្ត បន្ទាយមានជ័យ ដែល សកម្មភាព នេះ ហើយ បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ មាន ក្តីរំភើប ឥត គណនា ជា មួួយ នឹង ការយល់ឃើញ ថា « ទីណា ពលរដ្ឋ មាន ទុក្ខលំបាក ទីនោះ តែង មាន វត្តមាន សម្តេច តេជោ ហ៊ុន សែន » ។
( ពិភពលោក ) ៖ នៅ ថ្ងៃអង្គារ ទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ ព្រឹត្តិការណ៍ អន្តរជាតិ សំខាន់ ៗ ជាច្រើន បាន កើតឡើង រួម មាន ទាំង ព្រឹត្តិការណ៍ នយោបាយ និង ស្ថានការណ៍ ទូទាំង សកលលោក ដ៏ គួរឲ្យ ចាប់អារម្មណ៍ ជាច្រើន ។
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០
១៖ ថ្ងៃ នេះ ក្រសួង សុខាភិបាល ប្រកាស រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ ថ្មី ម្នាក់ ទៀត លើ ស្ត្រី ជនជាតិ បារាំង ខណៈ ករណី ជាសះស្បើយ មិន មាន ទេ
៣៖ ៩ខែ ឆ្នាំ ២០២០ កម្ពុជា ទទួលបាន ភ្ញៀវ អន្តរជាតិ ជាង ១លាន នាក់ និង ភ្ញៀវ ផ្ទៃក្នុង ជាង ៧លាន នាក់ តែ ថយចុះ ដោយសារ បញ្ហា កូវីដ
៥៖ ក្រសួង ធនធាន ទឹក៖ ឥទ្ធិពល ព្យុះ ម៉ូឡាវ នឹង ធ្វើឲ្យ កម្ពុជា បន្ត មាន ភ្លៀង ធ្លាក់ ពី តិច ទៅ ច្រើន ចាប់ពី ថ្ងៃទី ២៨ ខែតុលា ដល់ ថ្ងៃទី ០២ ខែវិច្ឆិកា !
៦៖ រដ្ឋមន្ត្រី ការបរទេស និង ការពារ ជាតិ អាមេរិក ទៅ ទស្សនៈកិច្ច នៅ ឥណ្ឌា ដើម្បី ជជែក ពិភាក្សា អំពី ការគំរាមកំហែង របស់ ចិន
៧៖ ក្រសួង អប់រំ ចេញ សេចក្ដីណែនាំ ស្តីពី ការបើក ដំណើរការ គ្រឹះស្ថាន សិក្សា សាធារណៈ ក្នុង ដំណាក់កាល ទី៣ ចាប់ពី ថ្ងៃទី ០២ ខែវិច្ឆិកាត ទៅ
៨៖ ចិន ប្រាប់ អាមេរិក ឲ្យ ឈប់ រញ៉េរញ៉ៃ ជាមួយ ស្រីលង្កា ខណៈ លោក ប៉ុម ប៉េអូ កំពុង ស្ថិត នៅ ឥណ្ឌា ដើម្បី បន្ត យុទ្ធសាស្ត្រ ចាក់ រុក ចិន
៩៖ កងទ័ព មួក ខៀវ កម្ពុជា ៧៣ នាក់ ទើប បញ្ចប់ បេសកកម្ម នៅ ស៊ូ ដង់ ខាងត្បូង
១០៖ ទីបំផុត លោកស្រី បារែត ដែល មាន ទំនោគាំទ្រ លោក ត្រាំ ត្រូវបាន ទទួលស្គាល់ ជា ច្រៅ ក្រម តុលាការ កំពូល ថ្មី របស់ អាមេរិក
១១៖ លិខិត ចំហរ៖ អ្នក ចម្បាំង ចចក សិង្ហបុរី ម្នាក់ កំពុង បំផ្លាញ សាមគ្គីភាព និង មជ្ឈភាព អាស៊ាន
១៣៖ ក្រសួង សុខាភិបាល រំលឹក សេចក្តីណែនាំ ករណី មាន រៀបចំ ពិធី អុំ ទូក បណ្តែត ប្រទី ប សំពះ ព្រះខែ និង អក អំបុក តាម ភូមិ ឃុំ និង ទី វត្តអារ៉ាម ក្នុង បរិបទ នៃ ការប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩
១៥៖ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា អនុម័ត គម្រោង វិនិយោគ ថ្មី ៣ទៀត មាន ទឹកប្រាក់ ជាង ១០លាន ដុល្លារ បង្កើត ការងារ ជិត ៤០០ កន្លែង !
១៦៖ សហរដ្ឋ អាមេរិក៖ ក្មេងប្រុស អាយុ ទើប ៣ឆ្នាំ យក កាំភ្លើង មក លេង និង រៀល កៃ បាញ់ ចំ ខ្លួន ឯង បណ្តាលឲ្យ ស្លាប់ នៅក្នុង ថ្ងៃ ខួបកំណើត
១៧៖ ជប៉ុន ផ្តល់ ជំនួយ ឥត សំណង ជាង ២០លាន ដុល្លារ ដល់ កម្ពុជា សម្រាប់ គម្រោង កែលម្អ មន្ទីរពេទ្យ បង្អែក ខេត្ត សៀមរាប
១៩៖ ក្រុម បាតុករ ថៃ ដង្ហែញ្ញតិ ទៅ ស្ថានទូត អាល្លឺម៉ង់ ដើម្បី ស្នើឲ្យ ស៊ើបអង្កេត លើ ស្តេច . បាតុករ ស្រែក ពាក្យស្លោក ថា « យើង ជា មនុស្ស មិន មែន ជា ធូលី ឡើយ »
៤៖ ថ្នាក់ដឹកនាំ កីឡាការ៉ាតេកម្ពុជា នាំ គ្រូ អន្ដរជាតិ ២រូប មក ពង្រឹង ចំណុច ខ្វះខាត ត្រៀម ស៊ីហ្គេម
៦៖ គួរ យល់ដឹង ! ប្រាសាទ ធម្មនន្ទ សាងឡើង ឧទ្ទិស ថ្វា ព្រហ្មញ្ញ សាសនា តែ បន្សល់ នូវ ចម្លាក់ ព្រះពុទ្ធ សាសនា ជាច្រើន
ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង ចូលរួម ជាមួយ សប្បុរសជន ០២ ក្រុម ចុះ ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ក្នុង ខណ្ឌ ដង្កោ !
( ភ្នំពេញ ) ៖ បើ ទោះបីជា ស្ថានភាព ជំនន់ ទឹកភ្លៀង ក្នុង ខណ្ឌ ដង្កោ បាន ស្រកចុះ ខ្លះ ក៏ដោយ តែ អាវុធហត្ថ រាជធានី ភ្នំពេញ នៅតែ បន្ត ត្រៀម ជួយសង្គ្រោះ និង បម្រើ ពលរដ្ឋ នៅ តាម តំបន់ លិច ទឹក គ្រប់ គោលដៅ ដដែល ព្រម ជាមួយគ្នា នោះ នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ កម្លាំង អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ចូលរួម ជួយ លើក ដាក់ លី សែង និង រៀបចំ អំណោយ របស់ សប្បុរសជន ០២ ក្រុម ដើម្បី ចែកជូន ប្រជាពលរដ្ឋ ២ គោលដៅ សរុប ស្មើនឹង ៧៦០ គ្រួសារ ក្នុង នោះ រួម មាន៖
( ភ្នំពេញ ) ៖ ជនជាតិ អាមេរិក ដែល មាន ប្រពន្ធ ជនជាតិ ខ្មែរ រស់ នៅ ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ហើយ ផ្ទះ របស់ គាត់ ត្រូវបាន លិច លង់ ដោយ ជំនន់ ស្ទឹង ព្រែក ត្នោត ដែរ នោះ បង្ហាញ ចំណាប់អារម្មណ៍ ក្រោយ ទទួលបាន ការសង្គ្រោះ យ៉ាង យកចិត្តទុកដាក់ ពី កម្លាំង សង្គ្រោះ ។
លោក ដន សេម ក៏ បាន ថ្លែងអំណរគុណ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា និង អាជ្ញាធរ ពាក់ព័ន្ធ ទាំងអស់ ដែល បាន អន្ដរាគមន៍ សង្គ្រោះ ប្រជាពលរដ្ឋ រង នូវ ការលិចលង បាន ទាន់ ពេល វេលា ។ លោក បាន ចាត់ទុក ថា ព្យុះភ្លៀង បែប នេះ មិន មែន កើត តែ នៅ ប្រទេស កម្ពុជា នោះ ទេ ពោល សហរដ្ឋ អាមេរិក ក៏ ធ្លាប់ កើតមាន ដែរ ។
ជួប ជាមួយ ឧត្តមសេនីយ៍ ត្រី កញ្ញា យុង ខេមរា មេបញ្ជាការ រង ក ពល តូច លេខ ៧០. លោក ដន សេម បាន គូសបញ្ជាក់ ថា រាជ រដ្ឋាភិបាល កម្ពុជា ក្រៅពី សង្គ្រោះ ប្រជាពលរដ្ឋ ភ្លាម ៗ នៅពេល លិច លង់ នោះ នៅពេល ទឹក ស្រក អស់ ទៅ វិញ ក៏ ជួយ ដឹកជញ្ជូន ប្រជាពលរដ្ឋ ត្រឡប់មក គេហដ្ឋាន វិញ ផងដែរ ដែល នេះ ជា គំរូ មួយ ដ៏ ល្អ ។
សូម ស្ដាប់ ការលើកឡើង របស់ លោក ដន សេម ខាងក្រោម នេះ៖
( ភ្នំពេញ ) ៖ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា កម្ពុជា បាន ផ្ញេី សារ លិខិត ថ្វាយ ព្រះពរ ព្រះករុណា ព្រះបាទ សម្តេច ព្រះ បរម នាថ នរោត្តម សីហមុនី ព្រះមហាក្សត្រ នៃ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ឱកាស ខួប ១៦ ព្រះវស្សា នៃ ការយាង គ្រង ព្រះបរម សិរី រាជសម្បត្តិ របស់ ព្រះអង្គ នៅ ថ្ងៃទី ២៩ ខែតុលា ឆ្នាំ ២០២០២ ស្អែក នេះ ។
( ភ្នំពេញ ) ៖ ក្រុម ម៉ូតូ ប៊ី អឹម ដឹប៊ល យូ កម្ពុជា នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ចូលរួម បរិច្ចាគ ២០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រាប់ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា ផ្តល់ អំណោយ មនុស្សធម៌ ដល់ ពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់
( ពោធិ៍សាត់ )៖ ជា ផ្នែក មួយ នៃ ការងារ សង្គម របស់ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា (GMAC) នៅ ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០២០ ថ្នាក់ដឹកនាំ របស់ សមាគម បាន នាំយក អំណោយ ចែកជូន ប្រជាពលរដ្ឋ ដែល រង គ្រោះ ដោយសារ ទឹក ជំនន់ ចំនួន ១០០០ គ្រួសារ នៅក្នុង ខេត្ត ពោធិ៍សាត់ ដែល កម្មវិធី នេះ ត្រូវបាន រៀបចំឡើង នៅ បរិវេន សាលា ខេត្ត ពោធិ៍សាត់ ដោយ ផ្ទាល់ ។
យោង របាយការណ៍ របស់ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន ឲ្យដឹង ថា គ្រោះ ទឹក ជំនន់ ដែល បង្កឡើង ដោយសារ ភ្លៀង ធ្លាក់ ជាច្រើន ថ្ងៃ ជាប់ ៗ គ្នា គិត ចាប់តាំងពី ដើម ខែតុលា ឆ្នាំ ២០២០ នេះ មក បាន បង្ក ផល ប៉ះ ធ្ងន់ធ្ងរ ដល់ ជីវភាព របស់ ប្រពលរដ្ឋ កម្ពុជា នៅ តាម បណ្តា ខេត្ត ចំនួន ១៩ ដែល នៅក្នុង នោះ ខេត្ត ពោធិ៍សាត់ ក៏ ជា ខេត្ត មួយ ដែល រង ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ដោយសារ គ្រោះ ទឹក ជំនន់ នេះ ផងដែរ ។
គ្រោះ ទឹក ជំនន់ នេះ មិន ត្រឹមតែ បង្កអោយ ខូចខាត ផ្ទះ សំបែង និង របស់របរ ប្រើប្រាស់ របស់ ប្រជាពលរដ្ឋ ប៉ុណ្ណោះ ទេ វា ក៏ បាន បង្ក មហន្តរាយ ដល់ អាយុជីវិត មនុស្ស សត្វ ពាហន : ព្រមទាំង ធ្វើអោយ ខូខាត ចំការស្រែ របស់ ប្រជាពលរដ្ឋ រាប់ ម៉ឺន ហិកតា ។ ប្រជាពល រដ្ឋ ជាច្រើន គ្រួសារ នៅ តាម តំបន់ ជន លិច ទាំងនោះ ត្រូវបាន ជម្លៀស ទៅ រក ទី ទួល សុវត្ថិភាព និង ទទួល ការឧបត្ថម្ភ ជា បណ្តោះអាសន្ន នៅ ជម្រក ស្នាក់ នៅ និង គ្រឿង ឧបភោគ បរិភោគ ផ្សេង ទៀត ពី រាជ រដ្ឋាភិបាល និង សម្បុរស ជន នានា ។
ដោយ មើលឃើញ ស្ថានភាព បែប នេះ និង ក្នុង គោលបំណង ចូលរួមចំណែក សម្រាល នូវ ទុក្ខលំបាក ប្រជាពលរដ្ឋ ដែល កំពុង រង ទុក្ខ ថ្នាក់ដឹកនាំ សមាគម រោងចក្រ កាត់ដេរ នៅ កម្ពុជា បាន នាំយក អំណោយ ទៅ ចែកជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ក្នុង ទី រួម ខេត្ត ពោធិ៍សាត់ ក្នុង សង្កាត់ ចំនួន ៧ និង មកពី ស្រុក កណ្តៀង ចំនួន ៣ឃុំ ។ អំណោយ ដែល ចែកជូន មាន ដូចជា សម្លៀកបំពាក់ ភួយ មី កញ្ចប់ ត្រីខ កំប៉ុង អង្ករ ទឹក បរិសុទ្ធ និង គ្រឿង ឧបភោគ បរិភោគ ផ្សេង ទៀត ។
គួរ បញ្ជាក់ ផងដែរ ថា អំណោយ ទាំង នេះ គឺជា ការបរិច្ចាក ពី រោងចក្រ ដែល ជា សមាជិក របស់ សមាគម (GMAC) និង មួយ ផ្នែក ទៀត ជា ថវិការ ផ្ទាល់ របស់ សមាគម ព្រមទាំង ការបរិច្ចាក ថវិការ ផ្ទាល់ខ្លួន ពី សមាជិក គណកម្មការ ប្រតិបត្តិ របស់ សមាគម អ្នកគ្រប់គ្រង និង បុគ្គលិក គ្រប់ លំដាប់ថ្នាក់ នៃ លេខាធិការដ្ឋាន របស់ សមាគម និង សហគម សឹង្ហបុរី នៅ កម្ពុជា (SCC) ។
ថ្នាក់ដឹកនាំ សមាគម និង សមាជិក សង្ឃឹម ថា អំណោយ ទាំងនេះ នឹង អាច ជួយ បន្ធូរបន្ថយ ការលំបាក របស់ ប្រជាពលរដ្ឋ យើង ដែល កំពុង រង ទុក្ខលំបាក បាន មួយចំណែក នា គ្រា លំបាក នេះ ។
ថ្នាក់ដឹកនាំ សមាគម ក៏ សូម ឆ្លៀត ឱកាស នេះ ថ្លែងអំណរគុណ ដល់ សមាជិក របស់ សមាគម ដែល ស្ម័គ្រ ចូលរួមចំណែក ផ្តល់ ជា អំណោយ ជូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ នេះ តាមរយៈ សមាគម និង សូម ថ្លែងអំណរគុណ ដល់ អាជ្ញាធរដែនដី គ្រប់ លំដាប់ថ្នាក់ ដែល ជួយ សម្របសម្រួល លើ កម្មវិធី ចុះ ចែក អំណោយ នេះ តាំងពី ដើម រហូត ចប់ បាន យ៉ាង រលូន ក៏ ដូចជា បាន ចង្អុលបង្ហាញ គ្រួសារ ពលរដ្ឋ ដែល រងគ្រោះ ប្រកបដោយ តម្លាភាព ៕ ឯក អគ្គ រដ្ឋទូត សហរដ្ឋ អាមេរិក ទស្សនកិច្ច « បណ្ណាល័យ សម្តេច ម៉ែ »
មជ្ឈមណ្ឌល ឯកសារ កម្ពុជា បាន បង្កើត ឲ្យ មាន « បណ្ណាល័យ សម្តេច ម៉ែ » ស្ថិត នៅក្នុង ទីក្រុង ភ្នំពេញ ដើម្បី ថ្វាយ ព្រះរាជ កិត្តិយស ជាទីគោរព សក្ការៈ ដ៏ ខ្ពង់ខ្ពស់ បំផុត ជូន សម្តេច ព្រះមហាក្សត្រី នរោត្តម មុនិនា ថ សីហនុ ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ ក្នុង សេរីភាព សេចក្តីថ្លៃថ្នូរ និង សុភមង្គល ដែល បាន ខិតខំ ប្រឹងប្រែង ដើម្បី សម្តេច ព្រះបរម រតន កោដ្ឋ នរោត្តម សីហនុ អតីត ព្រះមហា វីរក្សត្រ ព្រះវរ រាជ បិតា ជាតិ ខ្មែរ ប្រទេសជាតិ កម្ពុជា និង ប្រជាជន កម្ពុជា ។
ថ្ងៃ នេះ លោក ឯក អគ្គ រដ្ឋទូត ផា ទ្រីក មូហ្វី និង ភរិយា បាន អញ្ជើញ ធ្វើ ទស្សនកិច្ច មកកាន់ « បណ្ណាល័យ សម្តេច ម៉ែ » ។ លោក បាន ស្នើសុំ ឲ្យ មាន ទស្សនកិច្ច ជា លើក ទី២ សម្រាប់ បុគ្គលិក ស្ថានទូត ទាំងអស់ នៅ ពេល ក្រោយ ទៀត ។
ដំណើរទស្សនកិច្ច ចាប់ផ្តើម ដោយ ការរៀបរាប់ យ៉ាង ពិស្តារ អំពី ពិព័រណ៍ នៃ ព្រះឆាយាល័ក្ខណ៍ របស់ សម្តេច ព្រះបរម រតន កោដ្ឋ ព្រះវរ រាជ បិតា ជាតិ ខ្មែរ . សម្តេច ព្រះវរ រាជ មាតា ជាតិ ខ្មែរ និង រាជ វង្សានុវង្ស ផ្តល់ ដោយ បណ្ឌិត ហូលីយ៉ូ អេ. ជែល ដ្រេស អតីត អ្នក សរសេរ ព្រះរាជ ជីវប្រវត្តិ របស់ សម្តេច ព្រះបរម រតន កោដ្ឋ អម ជាមួយនឹង ភ្លេង ដែល ជា ព្រះរាជ និពន្ធ របស់ សម្តេច ព្រះបរម រតន កោដ្ឋ ។
លោក ឯក អគ្គ រដ្ឋទូត ផា ទ្រីក មូហ្វី តំណាង ឲ្យ ស្ថានទូត សហរដ្ឋ អាមេរិក ប្រចាំ នៅ កម្ពុជា បាន ចារ ចំណារ អនុស្សារីយ៍ លើ សៀវភៅ ក្រាំង មាស របស់ « បណ្ណាល័យ សម្តេច ម៉ែ » ដែល មាន ខ្លឹមសារ ដូចត ទៅ៖
ក្នុង ព្រះរាជ សារ របស់ ព្រះមហាក្សត្រ ជា អម្ចាស់ ជីវិត តម្កល់ លើ ត្បូង ព្រះអង្គ មាន សេចក្តីរីករាយ ដោយ សម្ដែង នូវ អំណរគុណ ដ៏ ជ្រាលជ្រៅ បំផុត ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន ។
ព្រះអង្គ បាន មាន ព្រះបន្ទូល ថា៖ ខ្ញុំ សូម កោតសរសើរ ដ៏ កក់ក្តៅ បំផុត ចំពោះ ទឹកចិត្ត ស្នេហាជាតិ មាតុភូមិ និង ប្រជារាស្រ្ត របស់ សម្ដេច អគ្គ មហា សេនា បតី តេជោ ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ដ៏ ឆ្នើម ឈ្លៀសវៃ ប៉ិនប្រសព្វ ដែល បាន ខិតខំ ដឹកនាំ កសាង ជាតិ គ្រប់ វិស័យ ទាំងអស់ និង ជួយ ប្រជារាស្រ្ត គ្រប់ ពី កន្លែង ទាំងអស់ នៅ ទូទាំង ព្រះរាជាណាចក្រ កម្ពុជា ធ្វើឲ្យ ប្រទេសជាតិ យើង មាន ភាពរីកចម្រើន រុងរឿង គ្រប់ វិស័យ និង ប្រជារាស្រ្ត បាន ទទួល សេចក្តីសុខ សន្តិភាព ។
ព្រះអង្គ ក៏ បាន ប្រសិទ្ធិពរ បវរ សួស្តី សិរី មង្គល វិបុល សុខ មហា ប្រសើរ ជូន ចំពោះ សម្ដេច តេជោ ហ៊ុន សែន ឱ្យ ប្រកប តែ ពុទ្ធ ពរ ៤ ប្រការ គឺ អាយុ វណ្ណៈ សុខៈ និង ពលៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ផងដែរ ៕
( កំពង់ស្ពឺ ) ៖ ក្នុង រយៈពេល នៃ គ្រោះ ធម្មជាតិ ទឹក ជំនន់ លោកស្រី លាង ធារ៉ា និង ស្វាមី គឺ លោក ឧកញ៉ា ឌី ជោត តែងតែ នាំយក អំណោយ ទៅ ចែកជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ នៅ តាម បណ្តា ខេត្ត នានា ហើយ ថ្មី ៗ នេះ អ្នក ទាំង២ បាន នាំយក អំណោយ ទៅ ចែកជូន ដល់ គ្រួសារ ដែល រងគ្រោះ ប្រមាណ ២០០ គ្រួសារ ដែល រស់ នៅ ឃុំ អម លាំង ស្រុក ថ្ពង ខេត្ត កំពង់ស្ពឺ ផងដែរ ។
លោកស្រី ក៏ បាន ផ្ដាំផ្ញើ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម ប្រឹងប្រែង លើកកម្ពស់ ជីវភាព របស់ ខ្លួន ហើយ ត្រូវ ជម្នះ ឲ្យបាន នូវ ការមើលងាយ ផ្សេង ៗ ។ លោកស្រី លើកឡើង ថា « បើ គេ មើលងាយ ថា យើង ល្ងង់ យើង ត្រូវ ប្រឹង រៀនសូត្រ . បើ ចង់ មាន ផ្ទះ ល្អ មាន លុយ មាន អនាគត ល្អ ត្រូវតែ ឲ្យ កូន ចៅ រៀនសូត្រ ឲ្យ មាន ចេះដឹង » ។
ជាមួយគ្នា នោះ ផងដែរ លោកស្រី ក៏ អរគុណ ទៅដល់ គណៈ អភិបាល ស្រុក កម្លាំង យុវជន ស្ម័គ្រចិត្តស .ស .យ . ក ភូម - ឃុំ ដែល បាន ទទួល យ៉ាង កក់ក្ដៅ និង រៀបចំ យ៉ាង ល្អ ក្នុង ការជួបជុំ ប្រកបដោយ ភាពងាយស្រួល ។
ជំនួស មុខ រដ្ឋាភិបាល និង ប្រជាជន វៀតណាម លោក ង្វៀង សួន ហ្វុក បាន ផ្ញើ ជូន សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី អាជ្ញាធរ និង ប្រជាជន បណ្តា ខេត្ត - ក្រុង ដែល រង ផល ប៉ះពាល់ ព្រមទាំង បណ្តា ក្រុមគ្រួសារ ដែល មាន សមាជិក រងគ្រោះថ្នាក់ ដោយ អកុសល « នូវ ការ សួរសុខទុក្ខ ដោយ ស្មោះស្ម័គ្រ និង ជ្រាលជ្រៅ បំផុត » ។
ជាមួយគ្នា នេះ លោក មាន ក្តី ជឿជាក់ ម៉ុត មាំ ថា ក្រោម ការដឹកនាំ និង យកចិត្តទុកដាក់ ខ្ពស់ ពី សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ប្រជាជន កម្ពុជា នឹង ជម្នះ លើ ការលំបាក ទាំងនេះ និង រក ជីវភាព ប្រក្រតី ឡើងវិញ នា ពេល ឆាប់ ៗ ដ៏ ខ្លី ខាងមុខ ។
សូម បញ្ជាក់ ថា ជំនន់ ទឹកភ្លៀង ដែល បង្កឡើង ដោយ ព្យុះ បន្តបន្ទាប់ កន្លងមក នេះ បាន និង កំពុង វាយលុក នៅ តាម បណ្តា រាជធានី - ខេត្ត មួយចំនួន ក្នុង ប្រទេស កម្ពុជា បង្កឱ្យ ប៉ះពាល់ ធ្ងន់ធ្ងរ ដល់ ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ហេដ្ឋារចនាសម្ព័ន្ធ និង ទ្រព្យសម្បត្តិ រដ្ឋ - ឯកជន មួយចំនួន ផងដែរ ។
របាយការណ៍ របស់ គណៈកម្មាធិការ ជាតិ គ្រប់គ្រង គ្រោះមហន្តរាយ បាន បង្ហាញ ថា គិត ត្រឹម ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០២០ អ្នកស្លាប់ ដោយសារ គ្រោះ ទឹក ជំនន់ បាន កើនឡើង រហូតដល់ ៤៣ នាក់ ។ ក្នុង នោះ ខេត្ត បន្ទាយមានជ័យ មាន រហូតដល់ទៅ ២៦ នាក់ ។
យោង តាម របាយការណ៍ បាន គូសបញ្ជាក់ ថា ខេត្ត ដែល មាន ពលរដ្ឋ ស្លាប់ ដោយសារ គ្រោះ ទឹក ជំនន់ នេះ រួម មាន៖ បន្ទាយមានជ័យ ២៦ នាក់ . ពោធិ៍សាត់ ៦នាក់ . ប៉ៃលិន ១នាក់ . ព្រះសីហនុ ២នាក់ . កំពង់ធំ ៦នាក់ . ស្ទឹងត្រែង ១នាក់ និង កំពង់ឆ្នាំង ១នាក់ ៕
ខាងក្រោម នេះ ជា លិខិត របស់ នាយក រដ្ឋមន្ត្រី វៀតណាម ផ្ញេី ជូន សម្តេច តេជោ ហ៊ុន សែ ន៖
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៦៣ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ២៧ ខែតុលា ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៦៣ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២៨ ខែតុលា នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៦៣ នាក់ នោះ មាន ២៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១៨ ករណី និង ជនសង្ស័យ ៣៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១២ករណី ។
សេចក្តីប្រកាស ព័ត៌មាន ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន មុន នេះ បន្តិច បាន បញ្ជាក់ ថា ករណី វិជ្ជមាន វីរុស កូវីដ - ១៩ ថ្មី ចំនួន ០២ នាក់ រួម មាន៖ បុរស ជនជាតិ ខ្មែរ អាយុ ៣៤ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ភូមិ តា ស្គរ ឃុំ សារិកា កែវ ស្រុក ល្វាឯ ម ខេត្ត កណ្ដាល និង បុរស ជនជាតិ ខ្មែរ អាយុ ២៣ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ស្រុក បាកាន ខេត្ត ពោធិ៍សាត់ ។ បុរស ទាំង ពីរ នាក់ នេះ បាន ធ្វើដំណើរ មកពី ប្រទេស ជប៉ុន បន្ត ជើងហោះហើរ នៅ ប្រទេស កូរ៉េ ខាងត្បូង មកដល់ កម្ពុជា នៅ ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០២០ ។
លទ្ធផល ធ្វើតេស្ត វត្ថុ សំណាក របស់ ពួកគាត់ គឺ វិជ្ជមាន វីរុស កូវីដ - ១៩ ដែល ផ្តល់ ដោយ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា រាជធានី ភ្នំពេញ ហើយ បច្ចុប្បន្ន អ្នកជំងឺ ទាំង ពីរ នាក់ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត ។
សូម កត់សម្គាល់ ថា អ្នកដំណើរ តាម យន្តហោះ ជាមួយ អ្នកជំងឺ ទាំង២ សរុប មាន ចំនួន ៣៩ នាក់ ( ស្រី ០៧ នាក់ ) ដែល ក្នុង ចំនួន នេះ មាន អ្នកជំងឺ ០២ នាក់ ខាងលើ នេះ ផងដែរ ។ រីឯ អ្នកដំណើរ ចំនួន ៣៧ នាក់ ដែល មាន លទ្ធផល តេស្ត អវិជ្ជមាន វីរុស កូវីដ - ១៩ នោះ ត្រូវបាន ដាក់ ឱ្យ ធ្វើចត្តាឡី ស័ក ចំនួន ១៤ ថ្ងៃ នៅ វិទ្យាល័យ ពោចិន តុង ចំនួន ១១នាក់ និង សណ្ឋាគារ មួយចំនួន ក្នុង រាជធានី ភ្នំពេញ ចំនួន ២៨ នាក់ ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ០៧៖០០ ព្រឹក ថ្ងៃទី ២៨ ខែតុលា ឆ្នាំ ២០២០ នៅ កម្ពុជា មាន អ្នក ឆ្លង វីរុស កូវីដ - ១៩ មាន ចំនួន សរុប ២៩០ នាក់ ( ស្ត្រី ៥៩ នាក់ និង បុរស ២៣១ នាក់ ) ក្នុង នោះ ចំនួន អ្នក ព្យាបាល ជាសះស្បើយ សរុប ទូទាំង ប្រទេស មាន ចំនួន ២៨៣ នាក់ និង អ្នក សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត រាជធានី ភ្នំពេញ ចំនួន ០៧ នាក់ ៕
គោលដៅ ទេសចរណ៍ ថ្មី ៗ នឹង បង្កើតឡើង ដើម្បី ទាក់ទាញ ទេសចរ អន្តរជាតិ មកកាន់ សៀមរាប - អង្គរ ឱ្យ បាន ៧លាន នាក់ នៅ ឆ្នាំ ២០៣៥
( ភ្នំពេញ ) ៖ លោក ថោង ខុន រដ្ឋមន្ត្រី ក្រសួង ទេសចរណ៍ បាន ថ្លែង ឱ្យដឹង ថា ដើម្បី ទាក់ទាញ ទេសចរ អន្តរជាតិ មកកាន់ ខេត្ត សៀមរាប - អង្គរ ឱ្យ បាន ប្រមាណ ៧ លាន នាក់ នៅ ឆ្នាំ ២០៣៥ គោលដៅ ទេសចរណ៍ ធំ ៗ ថ្មី នៅ ជុំវិញ អង្គរ នឹង ត្រូវបាន បង្កើតឡើង ដែល ផែនការ នេះ ត្រូវបាន ដាក់បញ្ចូល ក្នុង ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត សៀមរាប ។
ក្រោយ បញ្ចប់ កិច្ចប្រជុំ បូកសរុប លទ្ធផល ការងារ រយៈពេល ៩ខែ ឆ្នាំ ២០២០ និង ទិសដៅ អនុវត្ត បន្ត នៅ ត្រីមាស ទី៤ ឆ្នាំ ២០២០ ក្នុង ដំណាក់កាល វិបត្តិ នា រសៀល ថ្ងៃទី ២៦ ខែតុលា ឆ្នាំ ២០២០ លោក ថោង ខុន បាន ប្រាប់ ក្រុម អ្នកសារព័ត៌មាន ថា ផែនការ មេអភិវឌ្ឍន៍ ទេសចរណ៍ ខេត្ត សៀមរាប ត្រូវបាន ដាក់ ឆ្លង គណៈកម្មការ ជាតិ អភិវឌ្ឍន៍ វិស័យ ទេសចរណ៍ ហើយ ក្នុង នោះ ក្រសួង ទេសចរណ៍ ក៏ កំពុង រៀបចំ កែសម្រួល ឱ្យ វា ខ្លី ជាង មុន ដើម្បី ដក់ ឆ្លង រាជ រដ្ឋាភិបាល ពិនិត្យ និង អនុមត្តិ នៅពេល ខាងមុខ ។
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា គោលដៅ ទេសចរណ៍ ថ្មី ចំនួន ៤ ធំ ៗ បន្ថែម ទៀត លើ គោលដៅ ទេសចរណ៍ ២ ដែល មាន ស្រាប់ អាចនឹង ត្រូវបាន បង្កើតឡើង ក្នុង នោះ រួម មាន តំបន់ បឹង ទន្លេ សាប តំបន់ ភ្នំ គូលែន តំបន់ បន្ទាយស្រី និង ទីក្រុង សៀមរាប ថ្មី ។
លោក រដ្ឋមន្ត្រី បាន បញ្ជាក់ ថា ចំពោះ ការបង្កើត ទីក្រុង សៀមរាប ថ្មី នេះ គឺ ក្នុង គោលបំណង ដើម្បី ទ្រទ្រង់ ដល់ ទីក្រុង សៀមរាប បច្ចុប្បន្ន ដែល មិន អាច សាងសង់ សំណង់ ទំនើប ខ្ពស់ ៗ ឬ សំណង់ ដែល ប៉ះពាល់ ដល់ សម្បត្តិ បេតិកភណ្ឌ វប្បធម៌ ។
ម្យ៉ាង វិញ ទៀត រាជ រដ្ឋាភិបាល កម្ពុជា បាន ដាក់ចេញ ចក្ខុវិស័យ ទាក់ទាញ ភ្ញៀវ ទេសចរ អន្តរជាតិ មក ទស្សន ខេត្ត សៀមរាប ឱ្យ បាន ៧ លាន នាក់ នៅ ឆ្នាំ ២០៣៥ ដោយ នឹង បង្កើ ការងារ ផ្ទាល់ ប្រមាណ ៩០ ម៉ឺន នាក់ រួម ជាមួយ ការទទួលបាន ប្រាក់ ចំណូល ប្រមាណ ៥ ពាន់ លាន ដុល្លារ ក្នុង រយៈពេល ដូចគ្នា នោះ ។ ដើម្បី សម្រេច ចក្ខុវិស័យ នេះ ទីក្រុង សៀមរាប បច្ចុប្បន្ន មិន អាច ទ្រទ្រង់ បាន គ្រប់គ្រាន់ ឡើយ គឺ ចាំបាច់ ត្រូវ បង្កើត ឱ្យ មាន ទីក្រុង ថ្មី មួយ ទៀត ។
ចំពោះ ទីតាំង ទីក្រុង សៀមរាប ថ្មី នេះ ត្រូវបាន លោក រដ្ឋមន្ត្រី បង្ហើប ឱ្យដឹង ថា គឺ ត្រូវ ស្ថិត នៅ ក្រៅពី តំបន់ ការពារ របស់ អាជ្ញាធរ ជាតិ អប្សា រា៕ សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ថ្លែងអំណរគុណ ព្រះមហាក្សត្រ នៃ កម្ពុជា ប្រោស ព្រះរាជូបត្ថម្ភ ព្រះរាជ ទ្រព្យ ១.០០០ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ខែតុលា
សម្ដេច កិត្តិព្រឹទ្ធបណ្ឌិត សូម ថ្លែងអំណរគុណ ព្រះមហាក្សត្រ នៃ កម្ពុជា ប្រោស ព្រះរាជូបត្ថម្ភ ព្រះរាជ ទ្រព្យ ១.០០០ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ខែតុលា
ឧកញ៉ា គួច ម៉េង លី ចែក ស្បៀងអាហារ ដល់ ពលរដ្ឋ រងគ្រោះ ទឹក ជំនន់ នៅ ខណ្ឌ ច្បារអំពៅ និង ស្រុក កៀនស្វាយ
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី តាមរយៈ មូលនិធិ ម៉េង លី ជេ. គួច បាន ធ្វើ ការចែក ស្បៀងអាហារ ជូន ដល់ ប្រជាពលរដ្ឋ ក្នុង សង្កាត់ វាល ស្បូវ ខណ្ឌ ច្បារអំពៅ និង ឃុំ គគីរ ស្រុក កៀនស្វាយ សរុប ចំនួន ២៣៨ គ្រួសារ ដែល រង ផល ប៉ះពាល់ ដោយសារ គ្រោះ ទឹក ជំនន់ ។
សូម បញ្ជាក់ ផងដែរ ថា ក្រៅពី ការបរិច្ចាគ ខាងលើ លោក ឧកញ៉ា វេជ្ជបណ្ឌិត គួច ម៉េង លី ក៏ បាន ឧបត្ថម្ភ ថវិកា ចំនួន ១០០ លាន រៀល ( ២៥.០០០ ដុល្លារ ) ជូន ដល់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដើម្បី រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។ ក្នុង ការរួមចំណែក ជួយ ប្រជាពលរដ្ឋ រងគ្រោះ ទឹក ជំនន់ លោក ឧកញ៉ា បាន បរិច្ចាគ ថវិកា សរុប ២០០ លាន រៀល ៕
ថ្លែង នៅក្នុង សន្និសីទ សារព័ត៌មាន ទៀងទាត់ មួយ នៅ ថ្ងៃអង្គារ នេះ អ្នកនាំពាក្យ ក្រសួង ការបរទេស ចិន លោក Wang Wenbin បាន សម្តែង ការប្រឆាំង យ៉ាង ម៉ឺងម៉ាត់ ចំពោះ ការលក់ អាវុធ របស់ សហរដ្ឋ អាមេរិក ទៅឲ្យ កោះ តៃវ៉ាន់ ដោយ សង្កត់ធ្ងន់ ថា ចំណាត់ការ របស់ ទីក្រុង វ៉ាស៊ីនតោន មួយ នេះ វា បាន រំលោភបំពាន យ៉ាង ធ្ងន់ធ្ងរ ទៅ លើ គោលការណ៍ ចិន តែ មួយ ហើយក៏ ជា ការជ្រៀត ជ្រែក ក្នុង កិច្ចការ ផ្ទៃក្នុង របស់ ចិន ដែល អាចនឹង ធ្វើឲ្យ អន្តរាយ ដល់ អធិបតេយ្យភាព និង សន្តិសុខ របស់ ខ្លួន ។
បេក្ខជន ៧៣ នាក់ ទទួលបាន លទ្ធផល ល្អ ក្នុង នោះ ៦នាក់ ជាប់ ស្ថាពរ និង ៦៧ នាក់ បាន ជាប់ បឋម ក្នុង កម្មវិធី កិច្ចសម្ភាស ការងារ នា ថ្ងៃ នេះ !
ក្រុមហ៊ុន ធំ ៗ ទាំង៣ ដែល បាន ចូលរួម ក្នុង កិច្ចសម្ភាស នា ចុង ខែតុលា ដើម្បី ជ្រើសរើស បុគ្គលិក នោះ រួម មាន៖ ធនាគារ កាណាឌីយ៉ា . គ្រឹះស្ថាន មីក្រូ ហិរញ្ញវត្ថុ អម្រឹត . ភោជនីយដ្ឋាន សួគ៌ា ។
គួរ បញ្ជាក់ ផងដែរ ថា កម្មវិធី « កិច្ចសម្ភាស ប្រចាំ ខែ » គឺជា ផ្នែក មួយ នៃ យន្តការវេទិកា ការងារ របស់ រាជ រដ្ឋាភិបាល ក្នុង ការផ្ដល់ ឱកាស ដល់ សាធារណៈ ជន ទូទៅ ជាពិសេស យុវជន ដែល ចង់ ស្វែង ការងារ ធ្វើ អ្នក ស្វែងរក កន្លែង កម្មសិក្សា ឬ អ្នក ចង់ ផ្លាស់ប្តូរ ការងារ អាច ទទួលបាន កាន់តែ ងាយស្រួល ចំណេញ ពេលវេលា និង នៅ មួយ កន្លែង ។
ឯកឧត្តម ឯក សុខ ចាន់ និង លោកជំទាវ បរិច្ចាគ ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ជួយសង្គ្រោះ ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឯក សុខ ចាន់ និង លោកជំទាវ នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ចូលរួម បរិច្ចាគ ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រាប់ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី ក៏ បាន ថ្លែងអំណរគុណ ផងដែរ ដល់ សប្បុរសជន នានា ដែល បាន ចូលរួម ឧបត្ថម្ភ ជួយ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ទទួលរងគ្រោះ ដោយសារ ជំនន់ ទឹកភ្លៀង នា ពេលនេះ ៕ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី អៀង មូលី និង លោកជំទាវ ទុំ សេដ្ឋា បរិច្ចាគ ៤លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ជួយសង្គ្រោះ ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់
( ភ្នំពេញ ) ៖ ឯកឧត្តម ទេសរដ្ឋមន្ត្រី អៀង មូលី និង លោកជំទាវ ទុំ សេដ្ឋា នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ចូលរួម បរិច្ចាគ ៤លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រាប់ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
ក្រុមហ៊ុន បណ្តុំ ព័ត៌មាន សុខភាព សេដ្ឋកិច្ច និង សន្តិសុខ សង្គម បរិច្ចាគ ៨០ ម៉ឺន រៀល និង ១៨៧១ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ជួយសង្គ្រោះ ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់
( ភ្នំពេញ ) ៖ លោក យ៉ាវ គីម ហ៊ាន តំណាង ក្រុមហ៊ុន បណ្តុំ ព័ត៌មាន សុខភាព សេដ្ឋកិច្ច និង សន្តិសុខ សង្គម នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ចូលរួម បរិច្ចាគ ៨០ ម៉ឺន រៀល និង ១៨៧១ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រាប់ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ កែវ តាំ និង លោកជំទាវ បរិច្ចាគ ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ជួយសង្គ្រោះ ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ កែវ តាំ រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង លោកជំទាវ នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ចូលរួម បរិច្ចាគ ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា សម្រាប់ ជួយ សង្រ្គោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ ។
កាកបាទ ក្រហម កម្ពុជា នឹង ចាត់ចែង នាំយក អំណោយ ទាំងនេះ ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត ដែល បាន ទទួល រងគ្រោះ ដោយ ទឹក ជំនន់ ដោយ ផ្ទាល់ ដៃ ។
គួរ ជម្រាប ថា ប្រទេស ចិន និង កោះ តៃវ៉ាន់ បាន បែកបាក់ គ្នា នៅក្នុង សង្គ្រាម ស៊ីវិល ឆ្នាំ ១៩៤៩ ហើយ ប្រទេស ចិន បាន ចាត់ទុក កោះ តៃវ៉ាន់ ត្រឹមតែ ជា ខេត្ត មួយ របស់ ខ្លួន តែ ប៉ុណ្ណោះ ដោយ ស្រប ទៅតាម ច្បាប់ អន្តរជាតិ ។ ចិន ជារឿយ ៗ តែងតែ ព្រមាន ថា ខ្លួន នឹង ប្រើប្រាស់ យោធា បង្រួបបង្រួម ជាតិ ក្នុង ករណី ដែល មាន យោធា បរទេស ណាមួយ ហ៊ាន ចូលមក ផ្តាច់ តៃវ៉ាន់ ចេញពី ចិន ឬ នៅ ពេល ដែល កោះ តៃវ៉ាន់ ប្រកាស ឯករាជ្យ ៕
អំណោយ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត តាមរយៈ ឯកឧត្តម ឧកញ៉ា បណ្ឌិត ទ្រី ភាព និង លោកជំទាវ ឧកញ៉ា គៀន ស្រី នាង ត្រូ បាន ផ្តល់ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ នៅ ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល
( កណ្តាល ) ៖ ឯកឧត្តម ឧកញ៉ា បណ្ឌិត ទ្រី ភាព ទីប្រឹក្សា ផ្ទាល់ សម្តេច តេជោ និង ជា ប្រធាន គណៈកម្មាធិការ សាខា បក្ស « ខ៦ » ព្រមទាំង ក្រុមការងារ នៅ ព្រឹក ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ បាន អញ្ជើញ ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ចែកជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល កំពុង ទទួល រងគ្រោះ ដោយ ទឹក ជំនន់ យ៉ាង ធ្ងន់ធ្ងរ ចំនួន ១.១២០ គ្រួសារ ក្នុង ឃុំ ទាំង៧ នៃ ស្រុក កណ្តាល ស្ទឹង ខេត្ត កណ្តាល ។
ក្នុង ឱកាស នោះ ឯកឧត្តម ឧកញ៉ា បណ្ឌិត បាន នាំ ពាក្យ ផ្ដាំផ្ញើ សួរសុខទុក្ខ ពីសំណាក់ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដោយ សម្ដេច តែងតែ គិតគូរ និង បារម្ភ ពី សុខ ទុក្ខ របស់ ប្រជាពលរដ្ឋ គ្រប់ រូប ហើយ សម្តេច ទាំង២ ពិតជា មាន ការសោកស្តាយ ចំពោះ ការខូចខាត ស្រែ ចំការ សត្វ ចិញ្ចឹម និង ទ្រព្យសម្បត្តិ នានា របស់ បងប្អូន ប្រជាពលរដ្ឋ ដោយសារ គ្រោះ ទឹក ជំនន់ នេះ ។
ឯកឧត្តម បណ្ឌិត ឧកញ៉ា បន្ត ថា អំណោយ នេះ គឺ សម្រាប់ ជូន បងប្អូន ប្រជាពលរដ្ឋ ដោះស្រាយ ជីវភាព ភ្លាម ៗ ក្នុង រយៈពេល ខ្លី តែ ប៉ុណ្ណោះ តែ អ្វី ដែល សំខាន់ គឺ ត្រូវ ស្តារ ជីវភាព គ្រួសារ ឡើងវិញ ដោយ ខិតខំ បង្កបង្កើន ផល និង ចិញ្ចឹម សត្វ ក្រោយពេល ទឹក ស្រក វិញ ។ រាជ រដ្ឋាភិបាល បាន ត្រៀម គ្រាប់ ពូជ អ្នក បច្ចេកទេស ផ្នែក កសិកម្ម សម្រាប់ ចែកជូន និង ណែនាំ ដល់ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយ ទឹក ជំនន់ សម្រាប់ បង្កបង្កើន ផល ក្រោយពេល ទឹក ស្រក ផងដែរ ។
បន្ទាប់ពី ចែក អំណោយ ជូន ដល់ បងប្អូន ប្រជាពលរដ្ឋ ចំនួន ១១២០ គ្រួសារ រួចហើយ នោះ ឯកឧត្តម បណ្ឌិត ឧកញ៉ា ទ្រីភាព ក៏ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យមើល ទីតាំង ភូមិសាស្រ្ត នៅ ឃុំ ត្បែង ស្ថិត នៅក្នុង ស្រុក កណ្ដាល ស្ទឹង ខេត្ត កណ្ដាល ជាពិសេស ពិនិត្យមើល ហេដ្ឋារចនាសម្ព័ន្ធ ដែល ខូចខាត ដោយសារ ទឹក ជំនន់ ដូចជា ផ្លូវ ប្រឡាយ ទឹក សាលារៀន ជាដើម ដែល មាន ការខូចខាត ដោយ ជំនន់ ទឹកភ្លៀង ដែល ទាំងអស់ នេ ទាមទា អោយ មាន ការជួសជុល ស្ថាបនា ឡើងវិញ នា ពេល ឆាប់ ខាងមុខ នេះ ផងដែរ ៕
ចំណេះដឹង ទូទៅ៖ អ្នកណា ដែល និយាយ ថា ផែនដី វិល ជុំវិញ ព្រះអាទិត្យ មុន គេ ?
អារី ស្ដាក មិន ត្រឹម អះអាង ថា ផែនដី និង ផ្កាយ ព្រះគ្រោះ ផ្សេង ៗ ទៀត វិល ជុំវិញ ព្រះអាទិត្យ ប៉ុណ្ណោះ ទេ គាត់ ក៏ អាច គណនា ពី ទំហំ និង រយៈ ចម្ងាយ រវាង ផែនដី - ព្រះអាទិត្យ និង រវាង ផែនដី - ព្រះច័ន្ទ បាន ផងដែរ ។
លោក បាន អះអាង ទៀត ថា មេឃ មិន មែន ជា ឋានសួគ៌ ដូច ដែល មនុស្ស គ្រប់ គ្នា ជឿ នោះ ទេ តែ វា គឺជា ចក្រវាឡ ដ៏ ធំ មួយ ស្ទើរតែ មិន អាច វាស់ ទំហំ បាន ។ ការអះអាង របស់ ជនជាតិ សាម៉ូស រូប នេះ មិន ទទួលបាន ការគាំទ្រ ជឿជាក់ ពីសំណាក់ មហាជន នា សម័យ នោះ ឡើយ ព្រោះ ពួកគេ បាន ជឿ តាម ទ្រឹស្ដី សាសនា រួចទៅហើយ ថា ព្រះអាទិត្យ និង ព្រះច័ន្ទ គឺ សុទ្ធតែ វិល ជុំវិញ ភព ផែនដី ហើយ មេឃ គឺជា ឋានសួគ៌ សម្រាប់ ព្រះអាទិទេព រស់ នៅ ។
សភា ពាណិជ្ជកម្ម ហ៊ូបេ ឧបត្ថម្ភ ថវិកា ១៣. ៣៥០ ដុល្លារ ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ប្រតិបត្តិការ ជួយ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់
( ភ្នំពេញ ) ៖ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ សភា ពាណិជ្ជកម្ម ហ៊ូបេ ដែល បាន ជួយ ឧបត្ថម្ភ ថវិកា ចំនួន ១៣. ៣៥០ ដុល្លារ ( មួយ ម៉ឺន បី ពាន់ បី រយ ហាសិប ដុល្លារ អាមេរិក ) ដល់ កាកបាទ ក្រហម កម្ពុជា សម្រាប់ ប្រតិបត្តិការ ជួយ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ បង្ក ដោយ ទឹក ជំនន់ រហ័ស ឆ្នាំ ២០២០ នេះ ។
សូម បញ្ជាក់ ថា ក្នុង រយៈពេល ២៦ ថ្ងៃ គិត ចាប់ពី ថ្ងៃទី១ ដល់ ទី ២៦ ខែតុលា ឆ្នាំ ២០២០ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន បាន ផ្តល់ អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត ដោយ ទឹក ជំនន់ បាន សរុប ចំនួន ១៩. ០៥៤ គ្រួសារ រស់ នៅ ភូមិ ចំនួន ៤៦៣ ឃុំ ចំនួន ១៦២ ស្រុក ចំនួន ៥៦ ក្នុង រាជធានី - ខេត្ត ចំនួន ១៤ ( ក្នុង នោះ ឆ្លើយតប ដោយ ទីស្នាក់ការ កណ្តាល ចំនួន ៩. ៩០០ គ្រួសារ និង ដោយសាខា ចំនួន ៩. ១៥៤ គ្រួសារ )៕
អំណោយ លោក ហ៊ុន ម៉ាណែត ត្រូវបាន ផ្ដល់ជូន ប្រជាពលរដ្ឋ ជិត ៤០០ គ្រួសារ រងគ្រោះ ជំនន់ ទឹកភ្លៀង នៅ ខេត្ត កំពង់ចាម
( កំពង់ចាម ) ៖ អំណោយ របស់ លោក ហ៊ុន ម៉ាណែត សមាជិក អចិន្ត្រៃយ៍ គណបក្ស ប្រជាជន កម្ពុជា និង ជា អនុប្រធាន ក្រុមការងារ ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ត កំពង់ចាម តាមរយៈ អាជ្ញាធរ ខេត្ត កំពង់ចាម បាន ចែកជូន ដល់ ប្រជាពលរដ្ឋ ចំនួន ៣៧៨ គ្រួសារ ដែល រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង នា ពេល កន្លងទៅ ថ្មី ៗ នេះ ។
ពិធី នេះ បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នៅមុខ សាលា ខេត្ត កំពង់ចាម ក្រោម អធិបតីភាព លោក រិន វីរ : សមាជិក អចិន្ត្រៃយ៍ យុវជន គណបក្ស ប្រជាជន ថ្នាក់ កណ្ដាល តំណាង លោក ហ៊ុន ម៉ាណែត និង លោក អ៊ុន ចាន់ ដា អភិបាល ខេត្ត កំពង់ចាម ព្រមទាំង ថ្នាក់ដឹកនាំ ជាច្រើន នាក់ ទៀត ។
ក្នុង ឱកាស នោះ លោក រិន វីរៈ បាន ផ្ដាំផ្ញើ សួរសុខទុក្ខ ទុក ប្រជាពលរដ្ឋ ពីសំណាក់ លោក ហ៊ុន ម៉ាណែត និង បាន ផ្ដល់ ជា អំណោយ មក ចែកជូន ប្រជាពលរដ្ឋ នៅពេលេនះ ។ លោក បន្ត ថា បន្ទាប់ពី មាន បញ្ហា ជំនន់ ទឹកភ្លៀង ភ្លាម អភិបាល ខេត្ត កំពង់ចាម បាន ធ្វើ លិខិត ស្នើ ទៅ លោក ហ៊ុន ម៉ាណែត ដើម្បី សុំ ការផ្ដល់ ជំនួយ យកមក ជួយសង្គ្រោះ ដល់ ប្រជាពលរដ្ឋ ដែល ទទួលរង ផល ប៉ះពាល់ នៃ ចំនួន ទឹកភ្លៀង នេះ ។
ថ្លែង ទៅកាន់ ប្រជាពលរដ្ឋ លោក អ៊ុន ចាន់ ដា បាន បញ្ជាក់ ថា ក្នុង នាម អាជ្ញាធរ ខេត្ត លោក សូម ចូលរួម សោកស្ដាយ និង ចូលរួម រំលែក នូវ ផលលំបាក ទាំងឡាយ ដែល ប្រជាពលរដ្ឋ ទាំងអស់ ដែល រងគ្រោះ ដោយសារ ជំនន់ ទឹកភ្លៀង និង ជំនន់ ទន្លេ មេគង្គ ។
លោក បាន ឲ្យដឹង ថា ជំនន់ ទឹកភ្លៀង នេះ ផងដែរ បាន ជន់ លិច តាម ដងផ្លូវ និង ហូរ ចូល ផ្ទះ ប្រជាពលរដ្ឋ មួយចំនួន នៅក្នុង ក្រុង កំពង់ចាម និង ស្រុក កំពង់សៀម ដែល មិន ទាន់ មាន ប្រព័ន្ធ លូ ច្បាស់លាស់ ។ ទន្ទឹម នឹង នោះ ខាង អាជ្ញាធរ ខេត្ត និង មន្ត្រី ពាក់ព័ន្ធ ក៏ បាន ចុះ ពិនិត្យ និង មាន វិធានការ បន្ទាន់ ដើម្បី កាយ បើក មុខ ទឹក បង្ហូរ រំដោះ ទឹក កុំ ឲ្យ លិច យូរ ដែល បង្ក ការរំខាន ដល់ ប្រជាពលរដ្ឋ ។
ជុំវិញ ខាង លើ បញ្ហា នេះ CAC បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ពេល ខ្លះ កម្មវិធី រុករក តាម ប្រព័ន្ធ អ៉ិន ធើណិត លើ ទូរស័ព្ទ ចល័ត បាន រីកចម្រើន តាម របៀប ដែល គ្មាន លក្ខណៈ .. . ហើយ បាន ក្លាយជា ទីកន្លែង ដែល ប្រមូលផ្ដុំ ដោយ ភាពច្របូកច្របល់ នៃ ព័ត៌មាន ដែល ត្រូវបាន ចេញផ្សាយ ដោយ ប្រព័ន្ធ ផ្សព្វផ្សាយ ខ្លួន ឯង » ។
បន្ថែម ពី នេះ CAC ក៏ បាន គូសបញ្ជាក់ បន្ថែម ដែរ ថា « បន្ទាប់ពី ការធ្វើ កំណែទម្រង់ រួចរាល់ កម្មវិធី រុករក តាម ប្រព័ន្ធ អ៉ិនធើណិត លើ ទូរស័ព្ទ ចល័ត ដែល នៅតែ ជា បញ្ហា លេចធ្លោ មួយ នេះ នឹង ត្រូវបាន ដោះស្រាយ យ៉ាង តឹងរឹង ទៅតាម ច្បាប់ និង បទបញ្ជា រហូតដល់ អាជីវកម្ម ដែល ពាក់ព័ន្ធ ទាំងអស់ ត្រូវបាន ហាមឃាត់ » ។
រដ្ឋមន្រ្តី ធនធាន ទឹក ចុះ អន្តរាគមន៍ ជួសជុល ហេដ្ឋារចនាសម្ព័ន្ធ ប្រព័ន្ធ ធារាសាស្រ្ត និង បញ្ជា ឲ្យ បើក ទ្វារ ទឹក បញ្ចូល ទៅ តាម អាងទឹក តំបន់ ទំនាប នានា ក្នុង ខេត្ត ព្រៃវែង ដើម្បី ទុក ប្រើប្រាស់ នា ពេល ខាងមុខ
ឆ្លៀត ក្នុង ឱកាស នោះ លោក រដ្ឋមន្រ្តី ក៏ បាន ណែនាំ បន្ថែម ដល់ នាយកដ្ឋាន ជំនាញ និង មន្ទីរ ធនធាន ទឹក និង ឧតុនិយម ខេត្ត ព្រៃវែង ត្រូវ ចាត់ បន្ត ជួសជុល និង កែលម្អ បន្ថែម ពេល ទឹក សម្រក ដើម្បី និរន្តរភាព នៃ ការប្រើប្រាស់ សំណង់ អាងទឹក នេះ ។
បច្ចុប្បន្ន ក្រសួង ធនធាន ទឹក និង ឧតុនិយម កំពុង អនុវត្ត នូវ វិធីសាស្រ្ត ២យ៉ាង រួម មាន៖
* ទី ១៖ អន្តរាគមន៍ ខ្ចប់ ទឹក ទុកឲ្យ ខាន តែ បាន * ទី ២៖ បន្ត ជួសជុល ពង្រឹង កែលំអរ ឲ្យបាន ល្អ ប្រសើរ តាម លក្ខណៈ បច្ចេកទេស និង លទ្ធភាព ទៅ តាម ស្ថានភាព ជាក់ស្តែង នៃ ទីតាំង នីមួយ ៗ ដើម្បី ពង្រឹង គុណភាព សំណង់ និង ស្តុក រក្សារ ទឹក ឲ្យបាន ច្រើន ជូន បងប្អូន ប្រជាពលរដ្ឋ ប្រើប្រាស់ ជា ពហុ ប្រយោជន៍ បាន យូរអង្វែង ៕ ប្រមុខ ការទូត កម្ពុជា រំលឹក មន្ត្រី UN ថា មាន កងទ័ព មួក ខៀវ កម្ពុជា ជាង ៧ពាន់ នាក់ កំពុង ថែរក្សា សន្តិភាព ក្រោម ឆ័ត្រ UN
លោក ប្រមុខ ការទូត កម្ពុជា រំលឹក បែប នេះ ក្នុង សន្និសីទ ជាន់ ខ្ពស់ ស្តីពី « អនាគត ដែល យើង ចង់បាន តួនាទី នៃ ពហុ ភាគី និយម ក្នុង ពិភពលោក ក្រោយ កូវីដ - ១៩ » ដែល បាន ធ្វើឡើង នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នៅ ទីស្តីការ ក្រសួង ការបរទេស ។
បើ តាម លោក ប្រាក់ សុខុន . កម្ពុជា ជាប់ ចំណាត់ថ្នាក់ លេខ ១៧ ក្នុង ចំណោម ១២០ ប្រទេស ដែល បញ្ជូន ស្ត្រី ច្រើន ទៅ ចូលរួម ក្នុង បេសកកម្ម ថែរក្សា សន្តិភាព របស់ អ.ស.ប នេះ ។ កម្ពុជា បច្ចុប្បន្ន ស្ថិត នៅ ចំណាត់ថ្នាក់ ទី២ ក្នុង ចំណោម ប្រទេស សមាជិក អាស៊ាន បើ និយាយ ពី ចំនួន ចូលរួម របស់ ស្ត្រី ។
លោក សួន សេរី រដ្ឋា ជួប សំណេះសំណាល ជាមួយ ជនជាតិ ដើម ភាគ តិច និង ពិភាក្សា ពី សារសំខាន់ នៃ ការចុះបញ្ជី ស្វ័យ អត្តសញ្ញាណ ជនជាតិ ដើម ភាគ តិច តាម ច្បាប់ នៅ ខេត្ត ក្រចេះ
( ក្រចេះ ) ៖ លោក សួន សេរី រដ្ឋា រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ មន្ត្រី នាយកដ្ឋាន អភិវឌ្ឍ ជនជាតិ ដើម ភាគ តិច និង មន្ត្រី មន្ទី អភិវឌ្ឍ ជនបទ ខេត្ត ក្រចេះ ចុះ មកដល់ មូលដ្ឋាន ជនជាតិ ព្នង នៅ ភូមិ កំពង់ព្នៅ ឃុំ កំពង់ខ្ញែ និង មូលដ្ឋាន បងប្អូន ជនជាតិ មិល នៅ ភូមិ ចង្ហ ប ឃុំ ក្បាលដំរី ទឹកដី ដង ទន្លេ មេគង្គ ក្នុង ស្រុក សំបូរ ខេត្ត ក្រចេះ ។
ក្នុង ឱកាស នោះ លោក សួន សេរី រដ្ឋា បាន សំណេះសំណាល ជាមួយនឹង មេដឹកនាំ ចាស់ ៗ ជនជាតិ ដើម ភាគ តិច ហើយ ពិភាក្សា បង្ហាញ ពី សារសំខាន់ នៃ ការចុះបញ្ជី ស្វ័យ អត្តសញ្ញាណ ជនជាតិ ដើភាគ តិច តាម ច្បាប់ ដើម្បីឱ្យ សហគមន៍ និង បងប្អូន ជនជាតិ ដើម ភាគ តិច ទាំងអស់ ទទួលបាន នូវ ផលប្រយោជន៍ ច្បាប់ និង ផលប្រយោជន៍ ស្រប ច្បាប់ តាម គោល នយោបាយ ជាតិ សម្រាប់ អភិវឌ្ឍ ជនជាតិ ដើម ភាគ តិច ដែល រាជ រដ្ឋាភិបាល បាន អនុម័ត និង ដាក់ ចេញ ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ថ្ងៃទី ២៧ ខែតុលា នេះ មាន យានយន្ត ១.០៧៨ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ. រយៈពេល ១៨០ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ១៩៩ .៦៦៤ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១៤៧ .៥៤២ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៥២. ១២២ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ១៨០ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ០៨ លើក ក្នុង នោះ ស្លាប់ ០២ នាក់ របួស ១០នាក់ ( របួស ធ្ងន់ ០៩ នាក់ ) ។
លោក ឃួង ស្រេង ថ្លែងអំណរគុណ អគ្គ នាយិកា ក្រុមហ៊ុន អ៊ែត វូត អាហរ័ណ នីហរ័ណ ដែល បរិច្ចាគ ទឹក បរិសុទ្ធ ៥ ពាន់ កេស ដើម្បី ចូលរួមចំណែក ជួយសង្គ្រោះ ពលរដ្ឋ រងគ្រោះ ដោយសារ ទឹក ជំនន់
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នេះ បាន ថ្លែងអំណរគុណ លោកជំទាវ ឧកញ៉ា លីម ឈីវ ហួរ អគ្គ នាយិកា ក្រុមហ៊ុន អ៊ែត វូត អាហរ័ណ នីហរ័ណ ព្រមទាំង សហការី ដែល បាន ឧបត្ថម្ភ ទឹក បរិសុទ្ធ ណាវី ចំនួន ៥.០០០ កេស ជូន រដ្ឋបាល រាជធានី ភ្នំពេញ ដើម្បី ចូលរួមចំណែក ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ ដែល រងគ្រោះ ដោយសារ ទឹក ជំនន់ និង ទឹកភ្លៀង ។
លោក អភិបាល សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ លោកជំទាវ ឧកញ៉ា លីម ឈីវ ហួរ និង សប្បុរសជន ជិត ឆ្ងាយ ដែល បាន ចូលរួម ឧបត្ថម្ភ ជា សម្ភារ ប្រើប្រាស់ ជា គ្រឿង ឧបភោគ បរិភោគ សម្រាប់ ជួយ សង្រ្គោះ ដល់ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ បាន ទាន់ ពេល វេលា ។
លោក ឃួង ស្រេង បាន ថ្លែងអំណរគុណ យ៉ាង ដូច្នេះ ថា៖ « ទឹកចិត្ត សប្បុរស ធម៌ ដ៏ ថ្លៃថ្លា មួយ នេះ ស្តែង ឱ្យ ឃើញ អំពី ការគិតគូរ និង ក្តី អាណិត ស្រលាញ់ ចំពោះ ជន រួម ឈាម ដោយ ឈរ លើ បុព្វហេតុ ជាតិ សាមគ្គី ជា ធ្លុង មួយ ក្នុង ស្មារតី ជួយ គ្នា នៅក្នុង កាលៈទេសៈ ដែល ប្រទេសជាតិ បាន និង កំពុង រងគ្រោះ ដោយសារ ទឹក ជំនន់ និង ទឹកភ្លៀង ។ សមាន ចិត្ត របស់ លោកជំទាវ ឧកញ៉ា នឹង ត្រូវបាន ចងចាំ ទុក ដោយ រាជ រដ្ឋាភិបាល រដ្ឋបាល រាជធានី ភ្នំពេញ និង ប្រជាពលរដ្ឋ កម្ពុជា ទាំងអស់ » ។
ជាមួយគ្នា នេះ លោក អភិបាល ក៏ បាន សន្យា ថា រាល់ អំណោយ របស់ សប្បុរសជន ទាំងអស់ នឹង នាំយក ទៅ ជួយ ដល់ ដៃ ប្រជាពលរដ្ឋ រងគ្រោះ ហើយ បើ នៅ សេសសល់ នឹង យក ទៅ ជួយ ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ នៅ តាម មូលដ្ឋាន ដោយ មិន ធ្វើអោយ ម្ចាស់ អំណោយ ខក បំណង ឡើយ ៕
ប៉ុម ប៉េអូ អះអាង ថា « អាមេរិក និង ឥណ្ឌា ត្រូវតែ រួម ដៃ គ្នា » ដើម្បី ទប់ទល់ ការគំរាមកំហែង នានា ដែល បង្កឡើង ដោយ ចិន
( ញូ ដេលី ) ៖ សហរដ្ឋ អាមេរិក និង ឥណ្ឌា ត្រូវតែ ធ្វើ ការងារ រួមគ្នា ដើម្បី ទប់ទល់ នឹង ការគំរាមកំហែង លើ សន្តិសុខ និង សេរីភាព ដែល បង្កឡើង ដោយ ប្រទេស ចិន ។ នេះ បើ តាម សម្តី របស់ រដ្ឋមន្ត្រី ការបរទេស អាមេរិក ដកស្រង់ ដោយសារព័ត៌មាន CNA នៅ ល្ងាច ថ្ងៃអង្គារ ទី ២៧ ខែតុលា ឆ្នាំ ២០២០ ។
លោក ប៉ុម ប៉េអូ បាន សង្កត់ធ្ងន់ បន្ថែម ទៀត ថា សហរដ្ឋ អាមេរិក និង ប្រទេស ឥណ្ឌា ក៏ ត្រូវ ធ្វើ កិច្ចសហការ រួមគ្នា ផងដែរ សំដៅ លើកកម្ពស់ សន្តិភាព និង ស្ថិរភាព ក្នុង តំបន់ ទាំងមូល ។
( ភ្នំពេញ ) ៖ អភិបាល រាជធានី ភ្នំពេញ លោក ឃួង ស្រេង បាន ជំរុញ ឲ្យ អាជ្ញាធរ ខណ្ឌ ទាំង ១៤ មន្ទីរ ពាក់ព័ន្ធ ទាំងអស់ ចុះ ពិនិត្យ ធ្វើ របាយការណ៍ ឲ្យបាន ជាក់លាក់ និង ជា បន្ទាន់ ដើម្បី ស្រង់ ទិន្នន័យ នៃ ការខូចខាត ហេដ្ឋារចនាសម្ព័ន្ធ នានា នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ក្នុង ដំណាក់កាល លិច លង់ ដោយ ទឹក ជំនន់ ទឹកភ្លៀង នា ប៉ុន្មាន ថ្ងៃ កន្លងមក នេះ ។
ការជំរុញ បែប នេះ ដើម្បីឲ្យ រដ្ឋបាល រាជធានី ភ្នំពេញ មាន ទិន្នន័យ ច្បាស់លាស់ មួយ បញ្ជូន ទៅ ក្រសួង មហាផ្ទៃ ក៏ ដូចជា រាជ រដ្ឋាភិបាល ដើម្បី សុំ ថវិកា យកមក ធ្វើ ការជួសជុល កែលំអរ ហេដ្ឋារចនាសម្ព័ន្ធ ដែល ខូចខាត នេះ ឲ្យបាន ល្អ ប្រសើរ ឡើងវិញ ។
ការជំរុញ បែប នេះ របស់ លោក ឃួង ស្រេង បាន ធ្វើឡើង ក្នុង កិច្ចប្រជុំ ស្តីពី តំបន់ រង ការលិចលង់ ដោយ ទឹកភ្លៀង នៅ តំបន់ មួយចំនួន ក្នុង ខណ្ឌ មានជ័យ ខណ្ឌ ពោធិសែន ជ័យ ខណ្ឌ សែនសុខ ខណ្ឌ កំបូល និង ខណ្ឌ ដង្កោ និង មន្ទីរ ពាក់ព័ន្ធ នា រសៀល ថ្ងៃទី ២៧ ខែតុលា ឆ្នាំ ២០២០ នៅ សាលា រាជធានី ភ្នំពេញ ។
លោក សាំ ពិសិដ្ឋ ប្រធាន មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ បាន បញ្ជាក់ ថា ក្នុង អំឡុង នៃ ការលិចលង់ ដោយ ជំនន់ ទឹកភ្លៀង នា ប៉ុន្មាន ថ្ងៃ នេះ បើ គ្មាន ការដឹកនាំ និង ចុះបញ្ជា ផ្ទាល់ ពី លោក អភិបាល រាជធានី ភ្នំពេញ ទេ ផល ប៉ះពាល់ ហេដ្ឋារចនាសម្ព័ន្ធ នានា នឹង មាន លក្ខណៈ ធ្ងន់ធ្ងរ ជាង នេះ តែ ដោយ ការខិតខំ ប្រឹងប្រែង ជំរុញ ពីសំណាក់ អភិបាល រាជធានី ភ្នំពេញ បាន ធ្វើឲ្យ ផល ប៉ះពាល មាន លក្ខណៈ ធូរស្រាល ។
លោក បញ្ជាក់ ថា ការពង្រីក តួ ប្រឡាយ បង្ហូរ ទឹក ឲ្យ មាន លក្ខណៈ ធំ ជាង មុន នេះ ក្រោយពី ការកាយ ប្រឡាយ នេះ ហើយ យើង នឹង រក្សា ប្រឡាយ ក្នុង ទំហំ ដដែល ដោយ មិន មាន ការលុប ដាក់ ប្រព័ន្ធ លូ តូច ទេ សំដៅ ធ្វើ យ៉ាងណា កុំ ឲ្យ មាន បញ្ហា លិច លង់ ដោយ ជំនន់ ទឹកភ្លៀង នេះ លិច លង់ នៅ ឆ្នាំ ក្រោយ ៗ ទៀត ៕ ព្រះធម្មវិបស្សនា ម៉ុន សាយ ផ្តល់ ស្បៀងអាហារ ដល់ ពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ ២១០ គ្រួសារ នៅ ក្រុង ពោធិ៍សាត់
ព្រះធម្មវិបស្សនា ម៉ុន សាយ មាន សង្ឃ ដីការបន្ត ថា អំណោយ ទាំងនេះ ដ្បិត តែ មិន អាច ផ្គត់ផ្គង់ បាន គ្រប់គ្រាន់ ក៏ ពិត មែន តែ ក៏ អាច ជួយ សម្រួល ជីវភាព បាន មួយ គ្រា ផងដែរ ដែល នេះ គឺជា ទឹកចិត្ត ក្នុង នាម ជា ខ្មែរ ដូចគ្នា គឺ ត្រូវតែ ចេះ ជួយ គ្នា ក្នុង គ្រា លំបាក ដោយ មិន ប្រកាន់ ជាតិ សាសន៍ សាសនា ណាមួយ នោះ ឡើយ ។
ព្រះធម្មវិបស្សនា ម៉ុន សាយ ក៏ មាន សង្ឃ ដីការអំពាវនាវ ឱ្យ ប្រជាពលរដ្ឋ ថែរក្សា សុខភាព ពិសារ ទឹក ឆ្អិន ជាប់ ជានិច្ច ត្រូវ មើលថែ កូន ចៅ កុំ ឱ្យ ចុះ លេង ទឹក ជាពិសេស បន្ទាប់ពី ស្រកចុះ វិញ ត្រូវ ខិតខំ ដាំ ដំណាំ រួមផ្សំ ឡើងវិញ ដើម្បី លើកស្ទួយ ជីវភាព ឱ្យ កាន់តែ ល្អ ប្រសើរ ឡើងវិញ ផងដែរ ។
