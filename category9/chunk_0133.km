ែ មាន ការមមាញឹក យ៉ាង ខ្លាំង ក្នុង កា
ចំពោះ ព្យុះ ផ្សេង ទៀត ដែល មាន ឈ្មោះ ដូចគ្នា សូម មើល អំពី អសង្ស័យ កម្ម ។
ឥត ឈប់ឈរ ទាំង លើ ទិដ្ឋភាព សេដ្ឋកិច្ច សង្គម និង បរិស្ថាន ។
