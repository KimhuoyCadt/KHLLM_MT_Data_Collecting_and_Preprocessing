គ្រប់ សមាជិក ទាំងអស់ នោះ និយាយ អំពី អ្វី ?
២៧ បងប្អូន ទាំងនោះ បាន សំរេចចិត្ត ដូច្នេះ ព្រោះ គេ មាន ជំពាក់ បំណុល ម្យ៉ាង គឺ បងប្អូន សាសន៍ ដទៃ បាន ទទួល សម្បត្តិ ខាង វិញ្ញាណ រួម ជាមួយ សាសន៍ យូដា យ៉ាងណា គេ ក៏ ត្រូវ យក សម្បត្តិ ខាង លោកីយ៍ ទៅ ជួយ សាសន៍ យូដា យ៉ាង នោះ ដែរ ។
នាងរចំ ភ្ញៀង នៅតែ បន្ត រស់ នៅ ជាមួយ គ្រួសារ នោះ រហូតមកដល់ សព្វ ថ្ងៃ ។
ការបែកបាក់ នាំឱ្យ អ្នក មិន មាន ភាពសប្បាយរីករាយ ឡើយ ។
ដែល ជួយ ឱ្យ ខ្ញុំ រីកចម្រើន ក្នុង ការប្រកួត ។
ព្រះអង្គ ជា ព្រះមហាក្សត្រ ដ៏ ឧត្តម
រឿង នេះ និយាយ សំដៅ ពិសេស នៅពេល នាង ពាក់ ស្រោមជើង កីឡា តែម្តង ។
សង្ហារ ចាប់ពី ពេល នោះ មក ហើយ ឥឡូវ ខ្ញុំ ចូលចិត្ត តែ ស្រី ណា ស្អាត ៗ
ដល់ គេ មិន ឱ្យ កិច្ចសន្យា យក ខ្ញុំ មក ដាក់ ឃុំ គ្រប់ កន្លែង ។
ការដាក់ របាយការណ៍ នេះ គឺ គ្របដណ្តប់ លើ បញ្ហា ដែល បាន កើតឡើង ក្នុង រយៈពេល បួន ឆ្នាំ កន្លះ កន្លងទៅ ។
គ្នា ដែល ចុះហត្ថលេខា ទទួលស្គាល់ ដោយ មេភូមិ និង មេឃុំ ជាន់ លើ គ្នា ទៀតផង ។
ពួកគេ ងឿងឆ្ងល់ ពេក រក និយាយ មិន រួច
ទាល់តែ ព្រះបាន បើក សម្តែង ឱ្យ គាត់ ភ្ញាក់ ខ្លួន ទើប គាត់ ប្រែ ចិត្ត ស្តាប់ បង្គាប់ តាម ព្រះអង្គ វិញ ។
អាចនឹង បាត់បង់ ប្រជាប្រិយភាព មុនពេល ចេញ លក់ ។
លោក ហ៊ឹម សារិន អង្គុយ នៅ ខាងស្តាំ
នៅពេល ស្នេហា កើតឡើង មាន រឿងរ៉ាវ ផ្សេង ៗ
គាត់ ចង់បាន តែ មួយ ប៉ុណ្ណោះ គឺ អាធំ ជាង គេ បំផុត នៅក្នុង ចំការ នោះ ។
ចង្ក្រាន បាយ ដែល ធ្លាប់ ប្រើប្រាស់ ពី សម័យ មុន គឺ នៅ បន្ត យកមក ប្រើ ដដែល ។
នៅ ជុំវិញ ស្ពក បាយ ក្រុមគ្រួសារ ជន គ្រប់ រូប គ្នា …
យើង មាន មូលហេតុ យ៉ាង ច្បាស់ ថា ព្រះជាម្ចាស់ មិន សព្វ ព្រះហឫទ័យ ឱ្យ បុត្រា បុត្រី របស់ ព្រះអង្គ ទៅ រៀបការ ជាមួយ អ្នក មិន ជឿ ទេ ។
នៅ ពេល ដែល រដូវ ក្តៅ ចូល មកដល់ អំពើហិង្សា ដោយ កាំភ្លើង នៅក្នុង ទីក្រុង សំខាន់ ៗ
ធ្វើការ ក្នុង ស្ថានភាពលំបាក និង គ្រោះថ្នាក់ ។
គាត់ គិត ថា ទស្សនៈ របស់ គាត់ សុទ្ធតែ ត្រឹមត្រូវ ទាំងអស់ អ្នកណា គិត ខុសពី គាត់ គឺ ខុស ។
