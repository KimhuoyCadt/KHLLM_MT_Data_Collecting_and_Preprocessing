ប្រពន្ធ ១ប្តី ៥បណ្តាក់ វេន គ្នា ដូច ខ្យង រស់ នៅក្នុង ផ្ទះ តែ មួយ ដំណឹង ថ្មី !
លោកស្រី ជា សិរី ត្រូវបាន ជ្រើសរើស ជា សមាជិក គណៈកម្មការ វាយតម្លៃ ដ៏ សំខាន់ នៅ ឆ្នាំ នេះ
នរណា ក៏ ចង់ ឭ ពាក្យ សរសើរ ដែរ ព្រោះ វា អាច ធ្វើឱ្យ មនុស្ស ម្នាក់ ៗ
សុចរិត ៣និង ទុច្ចរិត ៣
ប៉ុន្តែ មាន កង្វល់ អំពី បរិស្ថាន មួយ ទៀត គឺ ទឹក កខ្វក់ ។
ដំណើរ ដែល បណ្តាលឱ្យ កើត មាន ឡើង ហាក់ដូចជា មាន ទេវតា នាំ បណ្តាលការណ៍ ហ្នឹង វា ជា ចៃដន្យ ៕
ប្រជាពលរដ្ឋ សំណូមពរ ចេញ ច្បាប់ ចោរប្លន់ ត្រូវ ប្រហារជីវិត ដើម្បី រក្សា សន្តិសុខ សង្គម !
ស្ថានភាព របស់ ពិភពលោក សព្វ ថ្ងៃ នេះ អាច បង្ក គ្រោះថ្នាក់ ដល់ ជីវិត មនុស្ស ទាំងឡាយ បាន ហើយ នេះ ក៏ បង្ហាញ ដែរ ថា យើង កំពុង រស់ នៅ គ្រា ចុងបញ្ចប់ នៃ របៀប របប ពិភពលោក ។
ចូលរួម សម្តែង ផ្ទាល់ ផងដែរ !
នេះ គឺជា លើក ទី១ ហើយ បន្ទាប់ពី ការផ្ទូះ ភ្នំ ភ្លើង នេះ ត្រូវ …
ដែល សមាគម ចង់បាន និង បាន ចូលរួម ថវិកា ជាមួយ សមាគម ផងដែរ ។
ដោយៈ ឫទ្ធិ ស័ក្តិ
ឱ្យ តែ ប៉ះ គ្នា អ្នកគាំទ្រ ក្រុម ទាំង សងខាង តែង បង្ក ហិង្សា ជារឿយ ៗ
សម្តេច ព្រមាន ថា ជន ណា ធ្វើ បាតុកម្ម ចំពោះ តែ រឿង បុគ្គល គឺ ត្រូវ បង្ក្រាប ។
ស្វែងយល់ ពី ក្មេរ ត្រូវ ស្វែងយល់ ពី ព្យញ្ជនៈក ដល់ អទើប ដឹង រឿង ពី ឫសគល់ មកដល់ បច្ចុប្បន្ន នឹង ទៅ អនាគត ។
យ៉ាងណា ក្តី បុរស ជា អ្នកបើក ឡាន បាន យល់ ថា នោះ គឺជា អំពើ មួយ គ្រោះថ្នាក់ ណាស់ ចំពោះ ខ្លួន គាត់ និង អ្នកដទៃ ។
បើសិន ជើង មាន អំណោយផល ល្អ លោក អ្នក មិន ត្រូវ ញញើត ស្លៀក សំពត់ ខ្លី ត្រឹម លើ ជង្គង់ ដែរ ។
ក៏ប៉ុន្តែ អ្នក ផ្តល់ ហិរញ្ញវត្ថុ ដល់ លោក ស យ សុភាព បាន អះអាង ថា ការផ្អាក ចេញផ្សាយ កាសែត ប្រចាំ ថ្ងៃ នោះ មកពី បញ្ហា ពុករលួយ ។
ក្រោយពី ព្រឹត្តិការណ៍ នោះ មក , ព្រះវិញ្ញាណ ណែនាំ លោក ប៉ូលឱ្យ សំរេចចិត្ត ទៅ ក្រុង យេរូ សាឡឹម , ដោយ ធ្វើដំណើរ ឆ្លងកាត់ ស្រុក ម៉ាសេដូន និង ស្រុក អាខៃ ។
ម្ចាស់ ជំនួយ ក៏ ចូលរួម ផងដែរ ។
គ្នា សុទ្ធតែ បំពាក់ អាវុធ ដូច ៗ
ម្យ៉ាងទៀត គជបលោក គិត ថា អព្យា ក្រិត្យ ឬ អត់ ?
ប៉ុន្តែ អ្នក ត្រូវ ស្តាប់ បង្គាប់ ហើយ កាន់ និង ប្រតិបត្តិ តាម បទបញ្ជា របស់ ព្រះអង្គ ដែល ខ្ញុំ ប្រគល់អោយ អ្នក នៅ ថ្ងៃ នេះ ។
ប៉ុន្តែ អ្នកប្រើប្រាស់ ភាគ ច្រើន ពុំ បាន ដឹង ពី របៀបវាយ របស់ វា នៅឡើយ ទេ ។
នេះ ទោះបី ពលរដ្ឋ ដែល បាន ចាក់ វ៉ាក់សាំង ២ម្ជុល មាន ត្រឹមតែ ៧% ប៉ុណ្ណោះ ក្នុង ចំណោម ប្រជាពលរដ្ឋ សរុប ទូទាំង ប្រទេស ?
ព្រះយេស៊ូវ ចង់ឱ្យ បុរស នោះ ដឹង ថា គាត់ ចាំបាច់ ត្រូវ មាន ភាពប្រាកដប្រជា នៅក្នុង ការហៅ ទ្រង់ យ៉ាង ដូចនេះ ។
ទោះបី គេ មិន មែន ជា អ្នក ប្រដាល់ ដែល ចូលចិត្ត វាយ ប្តូរ ក៏ដោយ តែ ការវាយ ចេញ របស់ គេ មាន ប្រសិទ្ធិភាព ណាស់ ។
ខ្ញុំ នៅ រង់ចាំ មតិ ពី អ្នក ទាំងអស់ គ្នា ។
ភោជនីយដ្ឋាន ឥណ្ឌា ដាក់ អ្នករត់ តុជា រ៉ូបូត ស្វាគមន៍ ភ្ញៀវ រាប់ រយ នាក់ ១ ថ្ងៃ ភ្នំពេញ ប៉ុស្តិ៍
កុំ ទុក វត្ត កែវ សិក្ខាគីរី ស្វរៈ ជា នំ ដ៏ ឆ្ងាញ់ សម្រាប់ ពួក សៀម ឈ្លានពាន
ជាទូទៅ ដើម្បី ទទួលបាន អត្ថប្រយោជន៍ គេ មិន គួរ ទទួលទាន អាហារ នេះ តែ ឯង មួយ មុខ នោះ ទេ ។
ទុក ឯណា បើ ខ្ញុំ ខ្វះខាត ម្ល៉េះ ។
ព្រមទាំង បង្ក្រាប ស្តេច នានា ?
តែ គាត់ ជា សកម្មជន ការពារ ដីធ្លី ការពារ ព្រៃឈើ យ៉ាង សកម្ម ។
១៩ហេតុ ដែល បណ្តាល អោយ មាន ទោស នោះ គឺ ពន្លឺ បាន យាង មក ក្នុង ពិភពលោក ប៉ុន្តែ មនុស្សលោក ចូលចិត្ត ភាព ងងឹត ជាង ពន្លឺ ដ្បិត អំពើ របស់ គេ សុទ្ធតែ អាក្រក់ ។
ជំងឺ មិន មែន ជា គោលបំណង ដើម របស់ ព្រះទេ ។
កុំ ថា ឡើយ រឿង រួមភេទ សូម្បីតែ រដូវ របស់ ស្ត្រី ក៏ ខ្មាស់ ដែរ ។
បញ្ហា នេះ ត្រូវបាន ដោះស្រាយ តាមរយៈ ការសម្រេច ពី រដ្ឋាភិបាល សហព័ន្ធ ប៉ុណ្ណោះ ។
លោក ថូ ម៉ាស ប៊ីត ធី ដែល គេ ស្គាល់ ទូទាំង ពិភពលោក ថា ជា បុរស មាន គភ៌ បាន ប្រកាស ចែក ផ្លូវ ពី ប្រពន្ធ ការ ជាមួយគ្នា ប្រាំបួន ឆ្នាំ របស់ គាត់ ហើយ ។
ចំពោះ ការប្រមូល ផល ជ័រ កៅស៊ូ ស្វាមី របស់ ខ្ញុំ និង រូប ខ្ញុំ ត្រូវ ធ្វើដំណើរ ទៅកាន់ ចម្ការ នៅ ម៉ោង ៧ល្ងាច ។
គាត់ បាន បន្ត និយាយ ទៀត ថា ការរៀបការ គឺជា ការសម្រេចចិត្ត ដ៏ សំខាន់ បំផុត ក្នុង ជីវិត នេះ ខ្ញុំ អរគុណាស់ ដែល មនុស្ស ជាច្រើន បាន ផ្ញើ សារ អបអរ យើង ។
ព្រះអង្គ ប្រទាន ទឹកភ្លៀង មក យើង
ព្រះជា អម្ចាស់ នឹង ជូត ទឹកភ្នែក ចេញ ពីមុខ
កាហ្វេ គឺជា ភេសជ្ជៈ ដែល គេ ផឹក ច្រើន ជាង គេ នៅលើ លោក នេះ បន្ទាប់ពី ទឹក ។
កាល នោះ គាត់ មិន មាន ចំណាប់អារម្មណ៍ នឹង ការខាង វិញ្ញាណ ទេ ។
តាមពិត ទៅ វិធីសាស្ត្រ ក្នុង ការការពារ ជំងឺ មហារីក គឺ មាន លក្ខណៈ ងាយស្រួល ទេ ឱ្យ តែ អ្នក ធ្វើ បាន ។
ពួកយើង កំពុង រង់ចាំ គេ ត្រឡប់មក លេង វិញ ។
ម្នាល ភិក្ខុ ទាំងឡាយ អ្នក ជម្ងឺ ៣ពួក នេះ រមែង មាន នៅក្នុង លោក ។
ពួកគេ ចុះ ថយ ពុំ ត្រឹមតែ បរិមាណ ទេ ក៏ប៉ុន្តែ ទាំង គុណភាព ផងដែរ ព្រោះ យើង សង្កេតឃើញ ពួកគេ ធ្វើ ប្រតិបត្តិការ លែង មាន ប្រសិទ្ធភាព ដូច កាលពី មុន ។
ពាក្យ មួយ អស្ចារ្យ ។
ម្យ៉ាងទៀត ខ្ញុំ ជាប់ រវល់ ក្នុង កិច្ចការ ផង អញ្ចឹង បាន ចេះតែ អើត ពី ក្រៅ ដោយ នឹករលឹក ។
នៅ ពេល នោះ មាន តែ ស្ថានីយ ធ្វើ ការចំនួន បី តែ ប៉ុណ្ណោះ ។
ដែល គេ អង្គុយ ហើយនិង សិល្បៈ ល្អ ៗ
តែ ខ្ញុំ នៅតែ ចង់ ដឹង នូវ អាថ៌កំបាំង ដែល គ្មាន មនុស្ស ដឹង ។
វា ហាក់ដូចជា មាន លក្ខណៈ ឆ្គង ៗ
ជួយ ឱ្យ អ្នក ឆាប់ គេង លក់ ស្កប់ស្កល់ សុខភាព
