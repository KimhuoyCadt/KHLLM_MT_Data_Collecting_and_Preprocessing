ប៉ុន្តែ នៅក្នុង ប្រការ ដែល ពួកគាត់ បាន និយាយ យោង ទៅ លើ ប្រការ ផ្សេង ៗ
លោកស្រី គ្លីនតុន មកដល់ ថ្ងៃ នេះ
យុវជន ព្រះសង្ឃ ត្រូវ គេ មើលឃើញ ថា …
២គ្រាន់តែ ចេះ និយាយ ពី បញ្ហា គ្មាន អ្វី អស្ចារ្យ ឡើយ ។
ក៏ប៉ុន្តែ មូលហេតុ ពិតប្រាកដ នៃ ការសន្លប់ នោះ នៅ មិន ទាន់ កំណត់ នៅឡើយ ទេ ។
យើង យកចិត្តទុកដាក់ ចំពោះ ប្រជាពលរដ្ឋ ទាំងនោះ ជន ត្រូវ គេ បណ្តេញ ចេញ ហើយ យើង ស្តាប់ កង្វល់ របស់ ពួកគាត់ ។
ហើយ រំកិល ខ្លួន ចូលទៅ ក្បែរ គេ ។
លុះ ព្រឹកឡើង ថ្ងៃ ដដែល ទើប ឆែក វា ល្លី នោះ ឃើញ សុទ្ធតែ ប្រភេទ លុយ ខ្មៅ ស្រដៀង នឹង ក្រដាស លុយ ១០០ ដុល្លារ ។
ត្រណម ទាំង ៣យ៉ាង ពេល អ្នក ស្នាក់ នៅ សណ្ឋាគារ !
តើ យើង ត្រូវ ពិនិត្យមើល យ៉ាងម៉េច ប្រសិនបើ គាត់ ជា បុរស នៅ ហ្ស៊ីន !
នៅ ឆ្នេរសមុទ្រ មួយ មាន មនុស្ស ងូតទឹក លេង យ៉ាង ច្រើន កុះករ ទាំង ប្រុស ទាំង ស្រី ។
ជាមួយនឹង ស្វាមី ដោយសារតែ នាង មាន ការរវល់ រៀង ៗ
ព្រះអង្គ ទ្រង់ ព្រះសណ្តាប់ឮ សំរែក
ដូច្នេះ ជឿជាក់ ថា បុរស ប្រភេទ នេះ ពិបាក ស្វែងរក ប្រពន្ធ បន្តិច ។
ប៉ូលិស បាន ចំណាយ ពេល ជាង ២ ម៉ោង ទម្រាំតែ ចាប់ខ្លួន ជនល្មើស បាន ។
ក្រុម អភិរក្ស ព្រួយបារម្ភ ខ្លាច ព្រៃឡង់ នឹង វិនាស ហិនហោច ក្នុង រយៈពេល ប៉ុន្មាន ឆ្នាំ ខាងមុខ
លោក ថា ផ្នែក នីមួយ ៗ
កំពុង ស្វែងរក ស្នេហា ថ្មី ។
ចំណែកឯ ការព្យាបាល ឬ ការថែទាំ សុខភាព ដែល បណ្តាល មកពី ការជក់ បារី គេ បាន ប៉ាន់ប្រមាណ ថា គឺ ចំណាយ មាន ទំហំ ធំ ជាង ការចំណាយ ទៅ លើ ការទិញ បារី យកមក ជក់ ។
ព្រះបិតា ជា ម្ចាស់ នៅ អស់ កល្ប ជានិច្ច ។
ប៉ុន្តែ ព្រះយេស៊ូវ មិន បាន បំផ្លាញ អ្វី ឡើយ ។
ដូច្នេះ អ្នក ពិតជា មានអារម្មណ៍ ថា មិន អាច ធ្វើ អ្វី ៗ
បន់ស្រន់ គ្រប់ អស់ ទេវតា វត្ថុ សក្តិសិទ្ធិ ព្រះអង្គ សំរិទ្ធ ព្រះអង្គ ឈើ ព្រះអង្គ ថ្ម បាយ អរ ។
មនុស្ស រាប ទាប នឹង ឮ ហើយ នឹង មាន សេចក្តីអំណរ ដែរ
ទំព័រ ដូចតទៅ នេះ តភ្ជាប់ មក តឹឡា មេឌ៏ ៖
លោកស្រី យីង ឡាក់ បាត់ខ្លួន នៅ ថ្ងៃ ប្រកាស …
យើង មិន ត្រូវ អាន ព្រះបន្ទូល ទាំង ប្រញាប់ប្រញាល់ ដើម្បីឱ្យ ឆាប់ បាន ចេញ ទៅ ខាងក្រៅ ផ្ទះ ឡើយ ។
លោក យង់ គិម អេង បន្ត ថា គណបក្ស នយោបាយ នីមួយ ៗ
ប្រជាជន នៅ ភាគ ខាងត្បូង និង ភាគ កណ្តាល ប្រទេស ថៃ មិន បោះឆ្នោត គាំទ្រ លោក ទេ ។
ខ្ញុំ ធ្លាប់ លឺ គេ និយាយ ពី ស្តេច ម្ទេស នៅ ស្រុក អឺរ៉ុប តែ ហឹរ ចាញ់ ម្ទេស ស្រុក យើង ។
កូន ង៉ា នោះ ឆាប់ គេង
តើ មកទល់ ពេលនេះ ដំណើរ យ៉ាងដូចម្តេច ហើយ ?
៣នាក់ ទៀត នៅ ឯណា
កុំ ប្រើ ដៃ ដើម្បី កាន់ អាហារ សូម ប្រើប្រាស់ សម្ភារៈ ស្អាត ដូចជា ចង្កឹះ ឬ សម និង ស្លាបព្រា ជំនួស វិញ ។
នេះ ជា អ្វី ដែល អ្នកនយោបាយ វ័យ ក្មេង ត្រូវ រៀនសូត្រ ។
នៅនឹង កន្លែង ហើយ គាត់ ទាំង ពីរ នាក់ ក៏ ជា អាចារ្យ វត្ត នេះ ផងដែរ ។
ពត៌មាន ប្រចាំ ថ្ងៃ ពេល ចេញ ក្រៅ បើ ជួប រឿង ទាំងនេះ ថ្មី ៗ
ម្តង ប៉ុន្តែ អ្នក មិន ត្រូវ ត្រដុស ខ្លាំង ទេ ធ្វើអោយ ស្បែក អ្នក ដាច់ ទៅជា ក្រហាយ បាន ។
ប៉ុន្តែ រឿង លុយកាក់ ក៏ ធានា ថា អ្នក មិន ចាំបាច់ ត្រូវ ខ្វាយខ្វល់ ច្រើន ។
ពួកយើង មាន ភាព ម៉ឺងម៉ាត់ និង សុចរិតភាព ខ្ពស់ ចំពោះ ការពិត ។
សកម្មភាព មនុស៌្ស ធម ថ្នាក់ដឹកនាំ មិន ទុក ឱ្យ ពលរដ្…
១២ នេះ ជាបញ្ជី រាយ នាម កូន ចៅ របស់ លោក អ៊ីស្មា អែល កូន របស់ លោក អប្រាហាំ ជា កូន ដែល នាង ហាការ អ្នក បំរើ របស់ លោកស្រី សារ៉ា បង្កើត ជូន លោក អប្រាហាំ ។
១ ព្រះបាទ សាឡូម៉ូន បាន ចង សម្ពន្ធមិត្ត ជាមួយ ព្រះចៅ ផារ៉ោន ជា ស្តេច ស្រុក អេស៊ីប ដោយ រៀប អភិសេក ជាមួយ បុត្រី របស់ ព្រះបាទ ផារ៉ោន ។
ការព្យាយាម ដក សេចក្តីក្រោធ របស់ ព្រះជា ម្ចាស់ ចេញ ប្រៀប ដូចជា ការព្យាយាម ដក សេចក្តី បរិសុទ្ធ របស់ ទ្រង់ ចោល អញ្ចឹង ។
សព្វ ថ្ងៃ នេះ ដែរ សាសនា ជាច្រើន បង្រៀន ថា ព្រះគឺជា ព្រះបី រួមគ្នា ជា ព្រះតែ មួយ ប៉ុន្តែ គម្ពីរ បង្រៀន យ៉ាង ច្បាស់ ថា មាន តែ ព្រះយេហូវ៉ា ប៉ុណ្ណោះ គឺជា ព្រះពិត ហើយ លោក យេស៊ូ គឺជា បុត្រ របស់ ព្រះ។
លោក សាស្ត្រាចារ្យ បន្ត ថា វា ៗ
ខាងមុខ នេះ ដោយ ក្នុង នោះ រួម មាន ដូចជា ៖
ទីតាំង ខ្ញុំ មាន នៅ ខេត្ត សៀមរាប ខ្ញុំ អាច ផ្ញើរ ជូន លោក អ្នក បាន គ្រប់ ខេត្ត ក្រុង បាន
មិន ចង់ បង្ហាញ ទំនាក់ទំនង ឱ្យ គេ ឯង ដឹង ព្រោះតែ ហេតុផល ទាំងនេះ
តែម្តង ធ្វើឱ្យ កីឡាករ ឡាវ ដួល សន្លប់ ក្រោក លែង រួច ។
ចង់ ឆាប់ បាត់ រាក រូស ចូរ ព្យាយាម ញ៉ាំ ភេសជ្ជៈ មួយ នេះ ទៅ
ភឹ មេរៀបការ ជាមួយ សុខ បាន ជាង មួយ ឆ្នេ៉ើំយ ។
ដែល ត្រូវការ រថយន្ត ប្រភេទ នេះ ច្បាស់ជា ពេញចិត្ត ដោយសាវា មិន ស៊ី សាំង ទៀត ទេ ។
ព្រមទាំង មាន ជោគមាន ជ័យ ក្នុង គ្រួសារ ក៏ ដូចជា ខ្លួនអ្នក ផ្ទាល់ ។
លោក គឺជា ជំទប់ ទី ពីរ សង្កាត់ ប៉ោយប៉ែត ។
ខ្ញុំ ធ្វើ សកម្មភាព មនុស៌្សធម នៅ តាម ប្រទេស ជាច្រើន រួមទាំង ពេល ដែល ខ្ញុំ បាន រស់ នៅ ប្រទេស ប៉ូឡូញ ផងដែរ ។
ទ្រង់ គឺជា សិប្បករ ដែល មាន ជំនាញ អស្ចារ្យ បំផុត ដែល បាន ប្រមូល កម្ទេច ដែល គ្មាន ប្រយោជន៍ និង បែកបាក់ នៃ ជីវិត របស់ យើង ដើម្បី ស្អាង ឡើងវិញ ឱ្យ មាន តម្លៃ និង មាន ន័យ ។
ចូរ ផ្អែក ខ្លួន ទៅនឹង ជញ្ជាំង ជាមួយនឹង ការលុត ជង្គង់ រួច ដាក់ ខ្នើយ មួយ នៅ ពីមុខ អ្នក ហើយ ចាំ ហៅ នាង មក ។
ទុក អោយ ពួកគេ លើកតម្កើង រូប កូនគោ ទៅ
សេនោ បិយា តាត អនិន្ទិតង្គិយោ, ខត្តិយកញ្ញា បដិលោភយន្តិ នំ ។
ប្រាកដ អត់ ថា លោក ឯង ចូលចិត្ត រសជាតិ ថ្នាំ របស់ ប៉េកាំង ?
ប៉ុន្តែ ផ្ទុយ ពី ការចុះផ្សាយ ដ៏ កក្រើក អ្នក ទាំង ពីរ បែរជា មិន មាន មង្គលការ នៅក្នុង ថ្ងៃ នោះ ទៅ វិញ ។
តោះ ជិត ដល់ ថ្ងៃ ហើយ ព្រឹត្តិការណ៍ កាល យើង នៅ ក្មេង ចូលរួម ទាំងអស់ គ្នា !
កក់ សក់ ជាប្រចាំ កក់ បាន រាល់ ថ្ងៃ រឹតតែ ល្អ ហើយ កុំ សិត សក់ ជាមួយនឹង ក្រាស់ សរសៃ តូច ៗ
រីករាយ ដំណើរកម្សាន្ត ទៅកាន់ ប្រទេស ថៃ រយៈពេល ចំនួន ៤ ថ្ងៃ របស់ បុគ្គលិក សម្បត្តិ ហ្វាយ នែន ។
បឹង នេះ អាច ត្រូវបាន គេ ធ្វើដំណើរ តាម ផ្លូវ ពីរ ផ្សេង គ្នា ។
គ្មាន នរណា ម្នាក់ ហ៊ាន ចូល ទៅក្នុង អាគារ នោះ ឡើយ ដោយ ខ្លាច ព្រលឹង ខ្មោច អ្នកគ្រូ ចន្ធូ ចេញមក លង នៅ ពេល យប់ ។
បរិសុទ្ធ ដែល សង្ឃឹម ដល់ ព្រះក៏ បាន តែង ខ្លួន យ៉ាង ដូច្នោះ ទាំង ចុះ ចូល ចំពោះ ប្តី ខ្លួន ដែរ ។
កាលបើ បាន ឃើញ ហើយ ចូរ មក ប្រាប់ យើង វិញ ផង ដើម្បី អោយ យើង បាន ទៅ ថ្វាយបង្គំ ព្រះអង្គ ដែរ ។
ដង ខាងលើ នៃ ព្រែក នេះ ជា ទីប្រជុំ នៃ ជ្រោះ ជាច្រើន ។
លោក អ៊ីសាក ក៏ ទៅ នៅ ក្រុង កេរ៉ា ជ្រកកោន នឹង ព្រះបាទ អប៊ី ម៉ាឡិច ជា ស្តេច នៃ ជនជាតិ ភីលី ស្ទីន ។
ប៉ះពាល់ ទង្គើស អារម្ម ណ៏ ធ្វើឱ្យ គេ មិន សប្បាយ ចិត្ត ។
យើង ចង់ ផ្តល់ របាយការណ៍ ទៅ ឱ្យ ប្រទេស នីមួយ ៗ
បាត់បង់ ពេលវេលា ផ្ទាល់ខ្លួន ៖
របស់ ខ្លួន នៅ ផ្ទះ ចាប់ពី ពេលនេះ ។
ម្យ៉ាងទៀត ការហៅ
ដុំ ថ្ម អវកាស ប៉ុន តារាង បាល់ទាត់ ៣ដង ហោះ មក ជិត ផែនដី កាលពី ថ្ងៃ ២៧ មិថុនា
ខ្ញំ ដឹង ថា អ្នក
ព្រះយេស៊ូវ បាន ផ្តើម ហៅ សាវក ទ្រង់ ជា មិត្ត សំឡាញ់ ជា ជាង អ្នក បំរើ ព្រោះតែ ទ្រង់ បាន ទុកចិត្ត ពួកគេ លើ គ្រប់ យ៉ាង ដែល ទ្រង់ ឮ ពី ព្រះបិតា យ៉ូហាន ១៥១៥ ។
ដូចនេះ អ្នក ត្រូវតែ រៀន ចេះ ថែទាំ ខ្លួន ឱ្យ បាន ល្អ ៕
តើ ការបន្ត ឆ្លង រាប់ រយ នាក់ រៀងរាល់ ថ្ងៃ នេះ មកពី មូលហេតុ អ្វី ?
ព្រោះ និយាយ អញ្ចឹង ម៉ា បងប្អូន ខ្ញុំ នេះ គេ ស្អប់ ដោយសារ អញ្ចឹង ។
ព្រះសព ព្រះអង្គ ត្រូវបាន តម្កល់ ធ្វើ បុណ្យ តាម បវេណី ព្រះពុទ្ធ សាសនា នៅ វត្ត និរោធ រង្សី ចំនួន ៣ខែ ចាប់តាំងពី ថ្ងៃ ទទួល អនិច្ច ធម្មនេះ តទៅ ។
ពួកគេ នៅ ខាងក្រោម នេះ ហើយ ៖
ឈ្មោះ ពេញ ត្រូវបាន ប្រទាន ឱ្យ ដោយ វិវរណៈ មកពី ព្រះ ទៅកាន់ យ៉ូសែប ស្ម៊ីធ នៅក្នុង ឆ្នាំ ១៨៣៨ ។
សូម ប្រាប់ ពួកគេ អំពី សេចក្តីសង្ឃឹម ដ៏ អស្ចារ្យ របស់ អ្នក អំពី អនាគត ។
ក៏ បង្គាប់ សេចក្តី ដូច បង្គាប់ ចៅ មុន ។
១១ខ្ញុំ និយាយ ដូច្នេះ មិន មែន មកពី ខ្ញុំ ខ្វះខាត ទេ ដ្បិត ខ្ញុំ បាន រៀន អោយ ចេះ ស្កប់ ចិត្ត ក្នុង គ្រប់ កាលៈទេសៈ ។
បន្ទាប់ ទៅ នេះ ខ្ញុំ នឹង រៀបរាប់ អំពី មនុស្ស ពីរ នាក់ ដែល កំពុងតែ មាន រោគ អស់សង្ឃឹម នេះ ៖
រូបមន្ត ទាំង២នេះ ត្រូវ ថតចម្លង ។
វា មិន ត្រឹមតែ ធ្វើអោយ អ្នក រីករាយ ក្នុង ការចំណាយ ពេល ធ្វើ លំហាត់ប្រាណ ជា មួយគ្នា ប៉ុណ្ណោះ នោះ ទេ ប៉ុន្តែ គេ នឹង ទទួលបាន ប្រយោជន៍ ពី ការធ្វើ លំហាត់ប្រាណ ដែល អ្នក បាន ដាក់ អោយ គេ ធ្វើ ផងដែរ ៕
បើ ពិនិត្យ ឱ្យ ដិតដល់ ពួក នាង កំដរ គេ ផឹក ស្រា ១កែវ ២កែវ
តែ បើសិនជា ស្តេច ក្រុម ព្រះឈ្នះ លើ លោក ហ៊ុន សែន វិញ សួរ ថា តើ ពេល នោះ ស្តេច ក្រុម ព្រះនឹង ចោទ លោក ហ៊ុន សែន យ៉ាងដូចម្តេច ?
មនុស្ស ដូចគ្នា រស់ នៅ ក្រោម មេឃ តែម្តង ហេតុអីក៏ មាន វាសនា ខុសគ្នា ?
៨ ព្រះអង្គ អាចនឹង ប្រទាន ពរ ដ៏ ហូរហៀរ គ្រប់ យ៉ាង ដល់ បងប្អូន ដើម្បី អោយ បងប្អូន មាន អ្វី ៗ
ទីបំផុត ចែកា សុខចិត្ត យក កូន ចេញ ហើយ ដោយសារតែ … មាន វីដេអូ
ដែល ប្រាថ្នា ចង់ ជួប និង មើល ពី សម្រស់ នាង ដោយ ផ្ទាល់ ។
ប្រសិនបើ ចៀន ឬ អាំង សាច់ អោយ ទន់ ឈ្ងុយ ឆ្ងាញ់ ពិសា គួរអោយ ចង៉ ទទួលទាន គួរ ដាក់ ស្រា ចូលទៅ មិន ថា ជា ស្រា អ្វី ក៏ដោយ ។
ពិតជា គួរឱ្យ អនិច្ចា ខណៈ កុមារ តូច ៗ
អ្នក ច្បាស់ជា មិន ចង់ ធ្វើដំណើរ តាម រថយន្តក្រុង នៅ ពេល ដែល មើល វីដេអូ នេះ
ការទុកចិត្ត ខ្លួន ឯង មាន ន័យ ថា អ្នក គោរព និង ឱ្យ តម្លៃ ខ្លួន ឯង អ្នក ជា មនុស្ស ច្បាស់លាស់ មិន និយាយ ម្តង បែប នេះ ម្តង បែប នោះ ជាដើម ។
ក្នុង គម្ពីរ សម្ពន្ធ មេត្រី ថ្មី ព្រះយេស៊ូ បាន លើក យក ការផ្សងព្រេង របស់ លោក យ៉ូណា ស នៅក្នុង ពោះ ត្រី ចំនួន បី ថ្ងៃ បី យប់ ដើម្បី ពន្យល់ អំពី ការសុគត និង ការរស់ ឡើងវិញ របស់ ព្រះអង្គ ។
ព្រាប សុវត្ថិ ចាប់ ដៃ កែវ ស្រី នាង ១២ ថ្ងៃ
នាង និយាយ រក ខ្ញុំ យ៉ាង ម្ញិក ម្ញក់ ៖
លុយកាក់ ជា ថ្ងៃ មិន ល្អ សម្រាប់ ការបញ្ចេញ ទុន រកស៊ិ ។
លោក បន្ថែម ថា គ្រួសារ លោក ត្រូវបាន សង្គ្រោះ ដោយ ក្រុម អ្នក ជួយសង្គោះ ។
វា ជា ជម្រើស របស់ ពួកគេ ក្នុង ការប្រើ គំនិត ស្រមៃ របស់ ពួកគេ ។
រហូត ទាល់តែ ចង្អៀត ទឹកដី ។
ស្រី ស្អាត សុខចិត្ត ហុច ថ្ពាល់ ឱ្យ ប្រុស ៗ
មន្ត្រី កម្ពុជា ធ្លាប់ បាន និយាយ ថា ប្រទេស ចិន នឹង ផ្តល់ សម្ភារៈ ផ្សេង ៗ
សំដៅ ទៅដល់ អេឡូហ៊ីម ដែល ពាក្យ បុរាណ មាន ន័យ ថា អ្នក ទាំងឡាយ ណា ដែល មកពីលើ មេឃ ។
ទាល់តែ ដល់ ពេល ស្រោច គ្រឿង ។
កំពុង បន្ត ធ្វើ ការងារ - វិមាន ៧មករា
ដែល ជា តម្រូវការ សម្រាប់ ប្រពន្ធ របស់ គាត់ មិន ឱ្យ ទំនេរ ដែ នោះ ទេ ។
ព្រោះ អី នាង ស្អាត សឹង អី
សុភ័ក្ត្រ សង្ខេប អ៊ីចឹង ធ្វើឱ្យ នឹកឃើញ ដល់ ព្រឹត្តិការណ៍ ទាំងនោះ ឡើងវិញ ។
ចិន នឹង វ៉ា ដាច់ អាមេរិក ក្នុង រយៈពេល ៥ឆ្នាំ ខាងមុខ នេះ
ច្បាប់ ថ្មី នេះ នឹង រំពឹង ថា នឹង អនុញ្ញាតឱ្យ ជន បរទេស អាច ទិញ អគារ ដែល មាន តម្លៃ លើស ពី ៥ពាន់ លាន រូព្យ៉ា ស ឬ ស្មើ ៣៧៥០០០ ដុល្លារ អាមេរិក ទោះបីជា ពួកគេ មិន អាច ទិញ ទ្រព្យសម្បត្តិ ដែល ជា ដីធ្លី ក៏ដោយ ។
ដូចនេះ យើង មិន អាច ប៉ាន់ស្មាន បាន ច្រើន នោះ ទេ ។
ដើម្បី លើកកម្ពស់ ជីវភាព គ្រួសារ នោះ ទើប ជា ការប្រសើរ ជាង ។
ក៏ប៉ុន្តែ ខ្ញុំ សូម និយាយប្រាប់ ពួកគេ ថា ពួកគេ នឹង ត្រូវ ខាតបង់ ។
នោះ ទេ តែ វា នឹង បម្រើ ឱ្យ សេដ្ឋកិច្ច ប្រទេស កម្ពុជា ទាំងមូល ផងដែរ ។
អាត្មា ក៏ បាន និមន្ត មក ចូលរួម បង្សុកូល ។
