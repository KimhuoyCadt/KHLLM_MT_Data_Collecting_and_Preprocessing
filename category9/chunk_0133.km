ព្រះរាជា ទ្រង់ ព្រះរាជានុញ្ញាត តាម សុំ ។
លោក គីម ជុង អ៊ុន បាន ឱ្យដឹង ទៀត ថា ការអភិវឌ្ន៍ អាវុធ គឺ សម្រាប់ ការពារ ខ្លួន ហើយ មិន មែន ដើម្បី ចាប់ផ្តើម សង្គ្រាម នោះ ទេ ។
ជូន ពលរដ្ឋ របស់ ខ្លួន ទាំងអស់ ២៥លាន នាក់ ៕
ជប៉ុន ប្រមូល ទូត នៅ សេអ៊ូល ចូល ស្រុក វិញ ដើម្បី ប្រឆាំង នឹង រូបសំណាក ទាសករ ផ្លូវភេទ
ចូលរួម សម្តែង ផ្ទាល់ ផងដែរ ។
គាត់ ក៏ បាន អត់ទ្រាំ ដោយ ក្តីសង្ឃឹម ។
ដូច្នេះ ខ្ញុំ ថា អោយ តែ ត្រូវបាន ទៅ គង់តែ ថ្ងៃ ណាមួយ បាន ទៅ មិន ខាន
ខ្ញុំ យល់ ថា បាន ១០កៅអី គ្រាន់បើ ហើយ លើក នេះ ។
គ្រប់ គ្នា ពូកែ ប៉ុន ណា តែងតែ ត្រូវការ ពិគ្រោះយោបល់ ។
មាន ជំពូក ជាច្រើន នៃ កណ្ឌ គម្ពីរ នេះ គឺជា សេចក្តី អធិស្ឋាន ។
សារឿន អល់ អែក សម្រេចចិត្ត ដោយ ខ្លួន ឯង ៖
ឆ្នាំ ក្រោយ សង្ឃឹម ថា សង្ក្រាន្ត នឹង កើត នៅ គ្រប់ ទីកន្លែង ។
កាល ដើម ឡើយ មាន ក្មេងស្រី ឯកោ ម្នាក់ ដែល រមែង ប្រាថ្នា ចង់បាន ក្តីស្រឡាញ់ ណាស់ ។
មាន ស្ត្រី ច្រើន ជាង ៤០ ភាគរយ បាន ជួបប្រទះ នឹង ការឈឺចាប់ នេះ នៅក្នុង ជីវិត របស់ ពួកគេ ។
អត្ថន័យ សុបិន ឃើញ ពស់ បញ្ជាក់ ពី រឿង អាក្រក់ និង ល្អ ក្នុង ជីវិត តាម ពណ៌ របស់ វា
ស្វាមី ទាំងឡាយ ហាម និយាយ ពាក្យ ទាំង នេះ ដាច់ខាត នៅពេល ភរិយា កំពុង ពពោះ
គេ នឹកស្មាន ថា បើ ពោល ពាក្យ យ៉ាង ច្រើន ដូច្នេះ ព្រះរបស់ គេ នឹង ស្តាប់ គេ ។
ការធ្វើ បែប នេះ នឹង អាច ធ្វើឱ្យ ប្រពន្ធ សប្បាយ ចិត្ត បាន ។
តែ មិន ត្រូវ ដាក់ ឱ្យ រលោង ពេក រហូត បាត់បង់ ភាព ដើម ទាំងស្រុង ទេ ឧទាហរណ៍ ៖
សង្ឃឹម ថា វា នឹង បានជា គំនិត ដល់ លោក អ្នក អាន ក្នុង ការផ្តើម គិត ពិចារណា ក្នុង រឿង នេះ ដែរ ៕
គាត់ ចាប់អារម្មណ៍ ខ្លាំង ណាស់ លើ របៀប តុបតែង ខ្លួន និង អត្តចរិត របស់ អ្នក ។
មាន អ្នកម្តាយ មួយចំនួន តែងតែ បារម្ហ ពី កូន ជានិច្ច ថា ហេតុ អ្វី បានជា កូន នៅ មិន ទាន់ ចេះ និយាយ ។
អង្គភាព យើងខ្ញុំ នឹង រង់ចាំ ការឆ្លើយតប ពី លោក នៅ រៀងរាល់ ម៉ោង ធ្វើការ ៕
ខ្ញុំ សុំ ប្រាប់ ឱ្យ អ្នក រាល់គ្នា ដឹង ច្បាស់ ថា អ្នកណា ជឿ អ្នក នោះ មាន ជីវិត អស់ កល្ប ជានិច្ច ។
ក្នុង វ័យ ៩០ ឆ្នាំ លោកស្រី បាន ប្តូរ ទៅ គាំទ្រ គណបក្ស សាធារណរដ្ឋ កាលពី ២ឆ្នាំ មុន ដោយ សង្ឃឹម ថា គណបក្ស សាធារណរដ្ឋ អាច ពង្រឹង យោធា អាមេរិក បាន ។
ហើយ ខ្ញុំ ក៏ មាន ស្ទិល ប្រកួត ខុស ៗ
ដំណើរការ នេះ អាច ត្រូវការ រយៈពេល ជាច្រើន ខែ ដើម្បី អាច សម្រេចបាន ៕
ប៉ុន្តែ ចំនួន អ្នក ជក់ បារី វិញ នៅក្នុង ប្រទេស អាល្លឺម៉ង់ នេះ កំពុងតែ ធ្លាក់ចុះ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ។
ពី ផល ពិបាក របស់ គាត់ ចេញមក ដើម្បី ដោះស្រាយ ទាំងអស់ គ្នា !
ទើបតែ អាយុ ២៩ ឆ្នាំ ក្លាយជា ស្ត្រី ក្មេង ជាង គេ ដែល ចាប់ផ្តើម អាជីវកម្ម មាន តម្លៃ រាប់ ពាន់ លាន ដុល្លារ
លើស នេះ ទៀត សាលា ជាច្រើន ត្រូវបាន បិទ ទ្វារ ផងដែរ ។
លោកយាយ អោយ ភ្លើង ឪពុក នាង ពៅ កាន់តែ ទ្រ ហ៊ោ យំ
កូន ចិញ្ចឹម ត្រូវ មាន អាយុ តិច ជាង ៨ឆ្នាំ ។
ចំណែក សេដ្ឋី ហើយ ទ្រង់ គ្មាន ព្រះរាជ ឳង្កា អ្វី បន្តិច សោះឡើយ ទ្រង់ លែង ទៅ វិញ ។
គ្រាន់តែ និយាយ ភ្លាម ខ្ញុំ យល់ បាត់ ហើយ
បំពេញ តាម តម្រូវការ របស់ អ្នកប្រើប្រាស់ ។
មនុស្ស ទាំងអស់ នៅលើ លោក នេះ រមែង ប្រាថ្នា ចង់បាន គ្រួសារ មួយ ដែល មាន សុភមង្គល សេចក្តីថ្លៃថ្នូរ រស់ នៅ ដោយ កិត្តិយស ទាំង ការងារ ចិញ្ចឹម ជីវិត ក៏ ស្ថិត ក្នុង សុចរិត ទៀង ត្រង់ ។
ហើយ តែ កាលណា ប្រព្រឹត្ត ខុស អា ហ្នឹង ត្រូវ មាន ការទទួលខុសត្រូវ តាម ផ្លូវ ច្បាប់ ។
ពួកយើង បាន ដឹង ថា អ្នក ពិតជា ទទួលរង ការឈឺចាប់ ច្រើន ណាស់ ។
វា ពិតជា គួរឱ្យ រំខាន ភ្នែក មែនទែន ខណៈពេល ដែល ខ្ញុំ កំពុងតែ ជិះ តាម ផ្លូវ ត្រឡប់មក ផ្ទះ ។
តែ លោក បាន អះអាង ថា ពលរដ្ឋ ម្នាក់ ៗ
លោក ជា អ្នក មក ទស្សនា ម្នាក់ ។
ពេល អ្នក ដើរ ចូល ទៅក្នុង ហាង អ្នក នឹង ឃើញ មាន អន្លក់ ស្រស់ ៗ
ស្ត្រី រូប នោះ ពួក ខាងក្រៅ គឺ ឆន្ទៈ ដូចគ្នា ទាំងអស់ ។
ឯកឧត្តម ហ៊ុន ភឿង បាន ទួលមរណភាព ហើយ កាលពី ថ្ងៃសៅរ៍
ឥឡូវនេះ នាង គឺជា អ្នក រាំ និង អ្នក សំដែង ការប្រគំ តន្ត្រី ដ៏ សំខាន់ ។
ទោះជា សិទ្ធិ បញ្ចេញមតិ ត្រូវបាន រិត ត្បិត មែន ប៉ុន្តែ សន្តិសុខ ជាតិ ត្រូវបាន ធានា ។
រឿង នេះ បាន ធ្វើឱ្យ ខ្ញុំ យំ ៣ដង បន្ទាប់ពី អាន រឿង នេះ ។
នេះ ហើយ អជ្ញាធរ ក៏ មាន គម្រោង ដាំ ដើមឈើ កូន ស្តៅ នៅលើ នៅលើ ខ្នង ទំនប់ នោះ ផងដែរ ៕
ចូរ អ្នក ប្រាប់ តុលាការ ថា ពួកគេ នឹង ចំណេញ ពេល ច្រើន បើសិន ពួកគេ មិន ធ្វើ ការផ្សះផ្សា ។
ដូច្នេះ ប្រជាជន ទាំងអស់ កុំ មាន ក្តីបារម្ភ ភិតភ័យ លើ ហេតុការណ៍ នៅ ជុំវិញ ដែល កើតឡើង ។
ឯកឧត្តម រដ្ឋមន្ត្រី វង សូត ៖
ខ្ញុំ ស្រវា ឱប ម្តាយ ខ្ញុំ ដែល មាន តែ ស្បែក ដណ្តប់ ឆ្អឹង ប៉ុណ្ណោះ ។
អនុប្រធាន មន្ទីរ សុខាភិបាល របួស ធ្ងន់ មិន ទាន់ ដឹង យ៉ាងណា ខណៈ ប្រពន្ធ ស្លាប់ ក្រោយ ជួប រឿង អកុសល
ថៃ ស្ថិត នៅក្រោម ច្បាប់ អាជ្ញា សឹក នៅឡើយ ក្រោយ រដ្ឋប្រហារ ថ្ងៃ ២២ឧសភា ។
ប៉ុន្តែ ឥឡូវ ពុំ ទាន់ មាន ពត៌មាន លំអិត និង តំលៃ នៅឡើយ ទេ ។
និយាយ ទៅ ពួកយើង រស់ នៅ ដាច់ដោយឡែក ពី គ្នា ។
៤៨ អ្នកណា ផាត់ ខ្ញុំ ចោល ហើយ មិន ទទួល ពាក្យ ខ្ញុំ អ្នក នោះ មាន ចៅក្រម កាត់ទោស រួចស្រេច ទៅ ហើយ គឺ ពាក្យ ដែល ខ្ញុំ បាន និយាយ នឹង កាត់ទោស គេ នៅ ថ្ងៃ ចុងក្រោយ បង្អស់ ។
ដល់ ពេល កាលពី ថ្ងៃសៅ មុន ប្អូន ខ្ញុំ ទូរសព្ធ មក ខ្ញុំ ថា មក ផ្ទះ វិញ ឆាប់ ៗ
ស្វា នៅ ឥណ្ឌា កំពុង ក្លាយជា កត្តា គ្រោះថ្នាក់ ចំពោះ មនុស្ស ។
កូន អប្រិយ ភាគ ២
ប្រឆាំង អំពើពុករលួយ ម្នាក់ និង បាន តែ ក្នុង ករណី ស៊ើបអង្កេត ប៉ុណ្ណោះ ។
តាមរយៈ បង្កើត ឱ្យ ពួកគាត់ មានអារម្មណ៍ សប្បាយរីករាយ នៅក្នុង កិច្ចការ ដើម្បី សង្គម ។
បាន ត្រឹម ម៉ា ទប់ទល់ ចាយ ស្រួល ។
