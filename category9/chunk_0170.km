តើ មេដឹកនាំ កូរ៉េ ខាងជើង គីម ជុង អ៊ុន នៅ ទីណា ហើយ ហេតុ អ្វី បានជា លោក មិន បង្ហាញ ខ្លួន ជាសាធារណៈ អស់ រយៈពេល ជាង ពីរ សប្តាហ៍ មក នេះ ?
ទម្លាក់ ញ្ជូន បាទ
លោក កឹម សុខា អនុប្រធាន គណបក្ស សង្គ្រោះ ជាតិ នៅក្នុង ជំនួប ជាមួយ តំណាង កម្មករ កាលពី ដើម ខែ នេះ ។
គួរ បញ្ជាក់ ថា រហូតមកដល់ ពេលនេះ រាជ រដ្ឋាភិបាល មិន ទាន់ បាន ចាត់តាំង អ្នកនាំពាក្យ ឱ្យ បាន គ្រប់ ក្រសួង និង ស្ថាប័ន រដ្ឋ នៅឡើយ ទេ ។
ទំព័រ ដើម សម្លេង - រូបភាព
លោក លោកស្រី អ្នកនាង កញ្ញា និង អង្គ សន្និសីទ ទាំងមូល ជា ទី មេត្រី !
ការជក់ បារី អាច ប៉ះពាល់ ដល់ ជីវិត ផ្លូវភេទ ច្រើន ណាស់ ។
អ្នក នៅលើ ទន្លេ គ្មាន ដីធ្លី ទេ ។
ពូទីន ជា មនុស្ស មាន ឥទ្ធិពល បំផុត លើ ពិភពលោក
ផ្សិត នេះ ត្រូវ អ្នកវិទ្យាសាស្ត្រ ពិពណ៌នា ដំបូង នៅ ឆ្នាំ ២០០៦ ។
មាត់ អ្នក សួរ បន្លឺ ឡើង ទៀត ថា
ចូលរួម អត់ មាន គណបក្ស ប្រឆាំង ធំ ចូលរួម ។
គល់ អញ្រ ពះសុគត
សម្តី មាស របស់ អ្នកប្រាជ្ញ ចិន ខុង ជឺ ទាំង ៥ឃ្លា នេះ នឹង អាច ផ្លាស់ប្តូរ ជីវិត អ្នក ប្រស …
លោក បញ្ជាក់ ថា ផ្សារ ព្រំដែន នេះ នឹង អាច ដំណើរការ សាងសង់ នៅ ចុង ឆ្នាំ នេះ ឬ ដើម ឆ្នាំ ក្រោយ ។
នៅក្នុង សេចក្តីប្រកាស ព័ត៌មាន បាន ឱ្យដឹង ថា សម្រាប់ គម្រោង ការ នេះ ដែរ នឹង ផ្តោត សំខាន់ លើ ការបង្កើន វិស័យ ថាមពល សុខ មាលភាព និង ទិសដៅ ដែល រដ្ឋាភិបាល បាន ដាក់ ក្នុង ទិសដៅ អាទិភាព មួយចំនួន ទៀត ។
កីឡាករ ដែល នៅសល់ នឹង បន្ត ហ្វឹកហាត់ រហូតដល់ យើង ទៅ បរទេស កូរ៉េ ខាងត្បូង អឺរ៉ុប ។
នាយក រដ្ឋមន្ត្រី អង់គ្លេស ថា ម៉ូស្គូ អាច …
ក្រុមគ្រួសារ អធិរាជ ជប៉ុន ត្រូវបាន គេ គិត ថា មាន វ័យ ចំណាស់ ជាង គេ បំផុត នៅលើ ពិភពលោក ជាមួយនឹង ប្រវត្តិសាស្ត្រ ទេវកថា ដែល បាន ត្រឡប់ ទៅ កាលពី ជាង២, ៦០០ឆ្នាំ មុន ៕
៣ អ្នក ក្រតូចតាច
អញ្ជើញ ថ្លែង មតិ
ថា ការទាមទារ កាលពី ពេល មុន ៗ
កូនប្រុស បង្កើត លោក ស៊ិន សុង អតីត រដ្ឋមន្ត្រី ក្រស …
ម្តាយ ខាង កូនកំលោះ មាន អាយុ លើស ខាង ស្រី តែ ១ឆ្នាំ ប៉ុណ្ណោះ ។
មនុស្ស គ្រប់ ជាតិ សាសន៍ តែង ប្រារព្វ ធ្វើ ពិធី ប… បន្ត ការអាន
ការថ្លែង កោតស សើរ និង ការវាយតម្លៃ ខ្ពស់ បែប នេះ របស់ ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី ប្រចាំ កម្ពុជា បាន ធ្វើឡើង …
កម្រង រូបសាធារណៈ
ខ្ញុំ ក៏ សួរ គាត់ វិញ
ពាក្យ គន្លឹះ គឹម សុខ
ប្លក់ របស់ លោក ពិតជា មាន ប្រយោជន៍ ខ្លាំង ណាស់ ។
ថែមទាំង មាន កូនស្រី ម្នាក់ អាយុ ៩ ឆ្នាំ
រាជ រដ្ឋាភិបាល កម្ពុជា បំពាក់ គ្រឿង ឥស្សរិយយសសហមេត្រី ជូន អ្នកជំនាញ ការ នៃ ក្រសួង រតនាគារ សហរដ្ឋ អាមេរិក
ះ មាន ទីតាំង ភូមិសា
មួយចំនួន របស់ តួអង្គ ត្រូវ ចាប់ ព្រះកាយ ជា អាទិ៍ ៖
ពួក មនុស្ស សុចរិត នឹង ព័ទ្ធ ទូល បង្គំ ជុំវិញ
សេចក្តីស្រឡាញ់ ដែល យើង មាន ចំពោះ មនុស្ស ម្នាក់ ប្រហែល ហាក់ដូចជា កិច្ចការ ដ៏ តូច ប៉ុន្តែ សេចក្តីស្រឡាញ់ ជា អំណោយ ដ៏ ប្រសើរ បំផុត ១កូរិន ថូស ១៣១៣ ។
គម្រោង នេះ មាន ទំនាក់ទំនង យ៉ាង ជិតស្និទ្ធ ទៅនឹង កង្វះ អត្រា ឥណ
អង្គការ ,ក្រម, គ្រឿង បរិក្តារ មួយ សម្រាប់
យើង ជា ប្រជាជន ដែល ត្រូវបាន ធ្វើ ទុក្ខបុកម្នេញ ទោះជា ឧបសគ្គ ទាំងនេះ ក្តី ក៏ យើង រក្សា ការតស៊ូ សំរាប់ អ្វី ដែល យើង ចង់ សំរេច ។
ពត៌មាន ប្រចាំ ថ្ងៃ សុខភាព ទូទៅ តើ យើង គួរ ដឹង អ្វី ខ្លះ មុននឹង សម្រេចចិត្ត បិទ ក្រចក សិប្បនិម្មិត ?
ប្រធានបទៈ សាលា បឋមសិក្សា ពុំ មាន បញ្ហា ចោទ
ផលិតផល ពី ទឹកដោះគោ ៖
ក្នុង ករណី ដែល សង មិន រួច ទ្រព្យ ឬ ហេដ្ឋារចនាសម្ព័ន្ធ នោះ នឹង ត្រូវ ធ្លាក់ ទៅក្នុង ការគ្រប់គ្រង របស់ ភាគី ចិន ។
ជាប់ ទោស សរុប ១០ឆ្នាំ ។
ដើម្បី អោយ ដឹង ថា ព្រះអម្ចាស់
ទោះបីជា យ៉ាងណា ព្រឹត្តិការណ៍ ខ្សែក្រវាត់ ពិភពលោក ដែល មាន បេក្ខភាព ៨នាក់ មកពី បណ្តា ប្រទេស ផ្សេង ៗ
តើ កម្ពុជា នឹង ទៅជា យ៉ាងណា ប្រសិនបើ អាមេរិក ដាក់ទណ្ឌកម្ម សេដ្ឋកិច្ច មែន ?
ណារ៉េន ក៏ លែង ត្រូវការ បុរស ៗ
វៀតណាម - ប្រទេស នៃ ការចាប់ផ្តើម អាជីព
តាម យោបល់ របស់ ខ្ញុំបាទ ដើម្បី រួមចំណែក កាត់បន្ថយ ការកកស្ទះ ចរាចរណ៍ ជាពិសេស អនុវត្ត វិធានការ ទប់ស្កាត់ រថយន្ត ធំ ចូល កណ្តាល ក្រុង គឺ កម្លាំង មាន សមត្ថកិច្ច គ្រប់ ដង ផ្លូវ គឺជា អ្នកទទួលខុសត្រូវ ។
មន្ត្រី រដ្ឋាភិបាល រិះគន់ បណ្តឹង លោក ហ៊ុន ម៉ាណែត
ខណៈពេល ដែល មាន ការកោង ខ្នង គឺជា សញ្ញា មួយ ជាក់ច្បាស់ ថា មាន ជំងឺ ខ្សោយ បេះដូង ពីមុន មក ។
ស្នេហា ដែល អ្នកតែង ប៉ុនប៉ង នោះ នឹង ទទួលយក បាន ពិត មែន ។
នេះ គឺជា ពាក្យសំដី មួយ ឃ្លារ ដែល អ្នក កំពុងតែ លើក តំកើន ម្តាយ របស់ ខ្លួន ហើយ បង្អាប់ ប្រពន្ធ ខ្លួន ឯង អញ្ចឹង ។
ការប៉ះទង្គិច គ្នា កើនឡើង នៅ ទីក្រុង ទ្រី ប៉ូលីប្…
ចេំ លើយ របស់ សមក
ជាមួយគ្នា ទៀតផង ប៉ុន្តែ ដំណឹង នេះ ទើបតែ បែក ធ្លាយ អំឡុង រយៈពេល ១ ឆ្នាំ នេះ តែ ប៉ុណ្ណោះ ៕
កាលពី មុន ត្រូវបាន ប្តូរ ជា ផ្ទះ ធំ យ៉ាង ល្អ ស្អាត ហើយ សម្ភារៈ សម្រាប់ ប្រើប្រាស់ ក្នុង គ្រួសារ នីមួយ ៗ
បញ្ហា ទី៨ - ជា នន្តា ជានន្តបាប ករណ ប្បញ្ហា
ការសិក្សា ថ្មី មួយ បាន រកឃើញ ថា ចំនួន ប្រជាពលរដ្ឋ រស់ នៅក្នុង រាជធានី ភ្នំពេញ នឹង កើន ដល់ បួន លាន នាក់ នៅ …
ប៉ុន្តែ បញ្ហា នៅ ត្រង់ ថា តើ នឹង ជ្រើសរើស ពេលវេលា បែប ណា ដើម្បី ធ្វើឱ្យ ការចូលនិវត្តន៍ នេះ មាន រសជាតិ ទ្វេ ឡើង ?
ចំពោះ ភាព បរិសុទ្ធ ផ្លូវកាយ ផ្លូវចិត្ត របស់ នាង នៅតែ ល្អ ទាំងអស់ ដូចគ្នា ។
ការជួញដូរ ផ្លូវភេទ ជា អំពើ ខុស ច្បាប់ នៅក្នុង ប្រទេស ឥណ្ឌូណេស៊ី ។
