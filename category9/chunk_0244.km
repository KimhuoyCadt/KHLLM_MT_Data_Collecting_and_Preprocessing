( ភ្នំពេញ ) ៖ បច្ចុប្បន្ន វិស័យ បច្ចេកវិទ្យា កំពុង រីកចម្រើន យ៉ាង ខ្លាំង នៅ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង នោះ ដែរ ការទំនាក់ទំនង បាន ប្រែក្លាយ ពី ការបញ្ជូន សារ ដោយ សំបុត្រ មក ជា ការបញ្ជូន សារ តាម បែប អេឡិចត្រូនិក ជំនួស វិញ ដែល វា មាន លក្ខណៈ ឆាប់រហ័ស លឿន ទាន់ ចិត្ត ទាំង ការផ្ញើ និង ទទួល ។
ឯកឧត្តម ឈឹម គឹម លាង និង លោកជំទាវ ឡាច សាម៉ន បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឈឹម គឹម លាង ទីប្រឹក្សា ក្រសួង មហាផ្ទៃ និង លោកជំទាវ ឡាច សាម៉ន ទីប្រឹក្សា ក្រសួង ភិវឌ្ឍន៍ ជនបទ នៅ ថ្ងៃទី ១៦ ខែធ្នូ ឆ្នាំ ២០២០ បាន បរិច្ចាគ ថវិកា ចំនួន ៥០០ ដុល្លារ សហរដ្ឋ អាមេរិក ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ ។
មន្ត្រីរាជការ និង ព្រះសង្ឃ ខេត្ត កំពង់ចាម បាន បរិច្ចាគ ថវិកា សរុប ជាង ១៤៦ លាន រៀល និង ៣២០ ដុល្លារ ជូន សម្ដេច តេជោ ទិញ វ៉ាក់សាំង កូវីដ១៩
( កំពង់ចាម ) ៖ មន្ត្រី រដ្ឋបាល សាលា ខេត្ត កំពង់ចាម បាន ឲ្យដឹង ថា គិត ត្រឹម ថ្ងៃទី ១៧ ខែធ្នូ ឆ្នាំ ២០២០ នេះ មាន មន្ត្រីរាជការ និង ព្រះសង្ឃ ក្នុង ខេត្ត កំពង់ចាម បាន ចូលរួម បរិច្ចាគ ថវិកា សរុប ចំនួន ១៤៦.៤៦២.០០០ និង ៣២០ ដុល្លារ តាមរយៈ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា ជូន សម្ដេច តេជោ ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន កាលពី ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕
អភិបាល ខេត្ត ស្ទឹងត្រែង ចុះ ពិនិត្យ វឌ្ឍនភាព ការងារ ជួសជុល ផ្លូវ បេតុង និង ផ្លូវ កៅស៊ូ DBST ក្នុង ក្រុង ស្ទឹងត្រែង
( ស្ទឹងត្រែង ) ៖ លោក ម៉ុម សារឿន អភិបាល ខេត្ត ស្ទឹងត្រែង បាន ដឹកនាំ មន្រ្តី បច្ចេកទេស ចុះ ពិនិត្យ វឌ្ឍនភាព ការងារ ជួសជុល ផ្លូវ បេតុង និង ផ្លូវ កៅស៊ូ DBST ស្ថិត តាម បណ្តោយ មាត់ ទន្លេ ក្នុង ក្រុង ស្ទឹងត្រែង ។ សកម្មភាព បាន ធ្វើឡើង នា រសៀល ថ្ងៃពុធ ទី ១៦ ខែធ្នូ ឆ្នាំ ២០២០ ។
ការជួសជុល ផ្លូវ បេតុង មាន ប្រវែង សរុប ៨៥៦.៧ម៉ែត្រ ពី ចំណុច ស្ពាន ព្រែក ពោធិ៍ ទៅ ស្ពាន សេកុង ។ ចំណែកឯ ការស្ថាបនា ផ្លូវ កៅស៊ូ DBST ប្រវែង ៨៣០ ម៉ែត្រ ពី ចំណុច ស្ពាន អូរ ដំណាក់ ទៅ ស្ពាន បាចុង ។
ក្នុង ឱកាស ចុះ ត្រួតពិនិត្យ នោះ លោក ម៉ុម សារឿន បាន ឲ្យដឹង ថា ដើម ឡើយ ផ្លូវ តាម មាត់ ទន្លេ ទាំងនេះ បាន រង ការខូចខាត ដោយសារ ទឹក ជំនន់ បណ្តាលឲ្យ បាក់ ស្រុត ដូចនេះ លោក ក៏ បាន ជំរុញ ឲ្យ មាន ការជួសជុល និង ស្ថាបនា ឡើងវិញ ដោយ លើក ផ្លូវ ឲ្យ ខ្ពស់ ជាង មុន ដើម្បី បង្ការ កុំ ឲ្យ មាន ការខូចខាត ផ្លូវ ពេល ដែល មាន ទឹក ជំនន់ កើត មាន ឡើង ។ ពិសេស ទៀត នោះ ការស្ថាបនា ផ្លូវ ឡើងវិញ ដើម្បី ជួយ សម្រួល ដល់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ បាន ងាយស្រួល ព្រមទាំង ជួយ លើកកម្ពស់ ដល់ សោភ័ណភាព ក្នុង ក្រុង ស្ទឹងត្រែង ទាំងមូល ។
លោក បន្ត ថា ការជួសជុល ដាក់ ជា ផ្លូវ បេតុង នេះ អាចនឹង មាន ធ្វើឲ្យ ផ្លូវ ទាំង២ មាន ភាពរឹងមាំ និង យូរអង្វែង ដោយ មិន បង្ក ផលលំបាក ដល់ ប្រជាពលរដ្ឋ ក្នុង តំបន់ ធ្វើដំណើរ ទៀត ឡើយ ជាពិសេស ប្រជាពលរដ្ឋ ដែល ធ្វើដំណើរ ឆ្លងកាត់ កាន់តែ មាន ភាពងាយស្រួល ច្រើន ឡើង ៗ ដោយ មិន ចាំបាច់ ព្រួយបារម្ភ ពី ផលលំបាក ដូច ពីមុន ។
លោក អភិបាល ខេត្ត បាន ណែនាំ មន្ត្រី ជំនាញ និង ក្រុមការងារ ត្រូវ យកចិត្តទុកដាក់ ក្នុង ការបន្ត សាងសង់ ផ្លូវ បេតុង និង ផ្លូវ កៅស៊ូ DBST ឲ្យ មាន គុណភាព ខ្ពស់ ដើម្បី ធានា នូវ ភាពរឹងមាំ និង ប្រើប្រាស់ បាន យូរអង្វែង ផងដែរ ៕ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ព្រមាន ចាត់ វិធានការ ព្យួរ ឬ លុប អាជ្ញា បណ្ណ ចំពោះ ប្រតិបត្តិករ ទូរគមនាគមន៍ ណា ដែល មិន តភ្ជាប់ និង បញ្ជូន ទិន្នន័យ មក DMC
( ភ្នំពេញ ) ៖ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ នៅ ថ្ងៃទី ១៧ ខែធ្នូ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ថ្មី មួយ រំលឹក ដល់ ប្រតិបត្តិករ ទូរគមនាគមន៍ ទាំងអស់ អំពី ការតភ្ជាប់ និង បញ្ជូន ទិន្នន័យ សេវា ទូរគមនាគមន៍ និង ព័ត៌មានវិទ្យា មកកាន់ មជ្ឈមណ្ឌល គ្រប់គ្រង ទិន្នន័យ សេវា ទូរគមនាគមន៍ និង ព័ត៌មានវិទ្យា (DMC) ។
ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ បាន បញ្ជាក់ ឲ្យដឹង ថា ក្រសួង សង្កេតឃើញ ថា ប្រតិបត្តិករ ភាគ ច្រើន បាន ធ្វើ ការតភ្ជាប់ ជាមួយ មជ្ឈមណ្ឌល គ្រប់គ្រង ទិន្នន័យ សេវា ទូរគមនាគមន៍ និង ព័ត៌មានវិទ្យា (DMC) នៅ ពេល ដែល ប្រតិបត្តិករ មួយចំនួន ទៀត នៅ មិន ទាន់ បាន តភ្ជាប់ បើ ទោះបីជា ក្រសួង បាន ក្រើន រំលឹក តាមរយៈ លិខិត ជូន ដំណឹង និង កិច្ចប្រជុំ ជាច្រើន លើក ។
ក្រសួង សង្កត់ធ្ងន់ ថា « ដើម្បី បង្កើន ប្រសិទ្ធភាព និង តម្លាភាព ក្នុង ការកៀរ គរ ចំណូល រដ្ឋ ពី វិស័យ ទូរគមនាគមន៍ ប្រតិបត្តិករ ទូរគមនាគមន៍ ទាំងអស់ ត្រូវ ធ្វើ ការតភ្ជាប់ និង បញ្ជូន ទិន្នន័យ មក មជ្ឈមណ្ឌល គ្រប់គ្រង ទិន្នន័យ សេវា ទូរគមនាគមន៍ និង ព័ត៌មានវិទ្យា (DMC) សម្រាប់ ជា មូលដ្ឋាន ផ្ទៀងផ្ទាត់ ការបង់ ចំណូល ជូន រដ្ឋ ឱ្យ បាន ចប់ សព្វគ្រប់ ត្រឹម ថ្ងៃទី១ ខែមករា ឆ្នាំ ២០២១ ជា កំហិត » ។
សិស្ស ចៅក្រម . សិស្ស ក្រឡាបញ្ជី និង សិស្សសារ ការី នៃ រាជ បណ្ឌិត សភា វិជ្ជាជីវៈ តុលាការ បរិច្ចាគ ថវិកា ជាង ១៣លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ សិស្ស ចៅក្រម . សិស្ស ក្រឡាបញ្ជី និង សិស្សសារ ការី នៃ រាជ បណ្ឌិត សភា វិជ្ជាជីវៈ តុលាការ បាន បរិច្ចាគ ថវិកា ចំនួន ១៣. ២២០.០០០ រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ខាងក្រោម នេះ ជា បញ្ជី ឈ្មោះ៖ អតីត ប្រមុខ ការទូត អាមេរិក ប្រចាំ UN ជំរុញ ឱ្យ លោក បៃ ដិន រក្សាទុក គោល នយោបាយ ការបរទេស ខ្លះ របស់ លោក ត្រាំ
គួរ បញ្ជាក់ ថា អង្គ បោះឆ្នោត នៅក្នុង សហរដ្ឋ អាមេរិក កាលពី ថ្ងៃចន្ទ កន្លងទៅ បាន ទទួលស្គាល់ ជ័យជម្នះ របស់ លោក ចូ បៃ ដិន ជា ផ្លូវការ បើ ទោះជា លោក ដូណាល់ ត្រាំ នៅតែ ចោទ ថា ការបោះឆ្នោត ប្រធានាធិបតី កាលពី ថ្ងៃទី ០៣ ខែវិច្ឆិកា កន្លងទៅ ត្រូវបាន លួច បន្លំ ក៏ដោយ ។ ការទទួលស្គាល់ ជ័យជម្នះ របស់ លោក ចូ បៃ ដិន ដោយ អង្គ បោះឆ្នោត ត្រូវ គេ រំពឹង ថា នឹង ត្រូវបាន សភា ទាំង២ ទទួលស្គាល់ ជា ចុងក្រោយ នៅ ថ្ងៃទី ០៦ ខែមករា ហើយ លោក បៃ ដិន នឹង ស្បថ ចូលកាន់ តំណែង ជា ប្រធានាធិបតី អាមេរិក ទី ៤៦ នៅ ថ្ងៃទី ២០ ខែមករា ឆ្នាំ ២០២១ ៕
