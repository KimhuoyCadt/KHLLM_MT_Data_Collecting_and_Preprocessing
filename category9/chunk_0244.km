( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១០លើក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៤នាក់ និង របួស ធ្ងន់ ស្រាល ២១ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធិ . ប្រជែង បត់ គ្រោះថ្នាក់ និង មិន ប្រកាន់ ស្ដាំ ៕
( ហ្សាការតា ) ៖ បន្ទាប់ពី យន្តហោះ ដឹក អ្នកដំណើរ មួយ គ្រឿង ផ្ទុក មនុស្ស ជាង ៦០ នាក់ បាន ដាច់ ការទាក់ទង ហើយ ទំនងជា ធ្លាក់ ចូល ក្នុង សមុទ្រ ជ្វា នៅ ប្រទេស ឥណ្ឌូណេស៊ី នា ថ្ងៃសៅរ៍ នេះ ប្រតិបត្តិការ រុករក និង ជួយ សង្រ្គោះ កំពុង បន្ត ប្រព្រឹត្តទៅ យ៉ាង សកម្ម ជា ទីបំផុត ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន CNA នៅ ថ្ងៃសៅរ៍ ទី០៩ ខែមករា ឆ្នាំ ២០២១ ។
លោក នី ផល្លី បាន ថ្លែង កោតសរសើរ ដល់ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ គ្រប់ ភាគី ពាក់ព័ន្ធ គ្រប់ លំដាប់ថ្នាក់ ពិសេស ក្រុមការងារ ជួរ មុខ សុខាភិបាល និង អាជ្ញាធរ ព្រមទាំង ប្រជាពលរដ្ឋ មូលដ្ឋាន ក្នុង ការប្រឹងប្រែង ចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ប្រកបដោយ ជោគជ័យ និង ប្រសិទ្ធភាព ខ្ពស់ ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
លោក នី ផល្លី បាន ជំរុញ និង លើកទឹកចិត្ត ដល់ គ្រប់ ភាគី ពាក់ព័ន្ធ នៃ អាជ្ញាធរ មូលដ្ឋាន គ្រប់ លំដាប់ថ្នាក់ បន្ត កិច្ច ខិតខំ ប្រឹងប្រែង ទប់ស្កាត់ និង អប់រំ ដល់ ប្រជាពលរដ្ឋ ជាប្រចាំ ក្នុង ការបង្ការ និង ទប់ស្កាត់ ជំងឺ កូវីដ១៩ « យើង អាច ភ្លេច កូវីដ១៩ តែ កូវីដ១៩ មិន ភ្លេច យើង នោះ ទេ » ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក នី ផល្លី ក៏ បាន ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យមើល ស្ថានភាព និង ជីវភាព រស់ នៅ របស់ ប្រជាពលរដ្ឋ ក្នុង ឃុំ ផងដែរ ៕
( ភ្នំពេញ ) ៖ នា រសៀល ថ្ងៃទី ៩ ខែមករា ឆ្នាំ ២០២១ លោក ឧត្តមសេនីយ៍ ឯក រ័ត្ន ស្រ៊ាង មេបញ្ជាការ រង អាវុធហត្ថ លើ ផ្ទៃ ប្រទេស និង ជា មេបញ្ជាការ អាវុធហត្ថ រាជធានី ភ្នំពេញ បាន ចាត់ តំណាង ឲ្យ ក្រុមការងារ អាវុធហត្ថ រាជធានី ភ្នំពេញ ដឹកនាំ ដោយ លោក ឧត្តមសេនីយ៍ ត្រី ពង្ស សាវរិទ្ធ មេបញ្ជាការ រង និង ជា នាយ សេនាធិការ កងរាជអាវុធហត្ថ រាជធានី ភ្នំពេញ ចុះ សួរសុខទុក្ខ លោក វរសេនីយ៍ ឯក សូ ស៊ី ដារិទ្ធ នាយ រង សេនាធិការ ដែល មាន ជំងឺ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីពេទ្យ ព្រះកេតុ មាលា ហៅ ពេទ្យ ១៧៩ ។
ក្នុង ឱកាស នោះ ក្រុមការងារ បាន នាំយក ថវិកា ចំនួន ១.២០០.០០០ រៀល . ភេសជ្ជៈ ០៤ កេស ទៅ ជូន ជា អំណោយ សួរសុខទុក្ខ និង ទុក ជា ការចែករំលែក សម្រាល បន្ទុក គ្រួសារ ក្នុង ការសម្រាក ព្យាបាល ផងដែរ ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ មាន យានយន្ត ១.២៤៥ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ
បើ តាម អ្នកនាំពាក្យ . រយៈពេល ០៩ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ នេះ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ៨.១៥០ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ៦.០៤៩ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ២. ១០១ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ០៨ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១០លើក ក្នុង នោះ ស្លាប់ ០៤ នាក់ របួស ២១នាក់ ( របួស ធ្ងន់ ១៤នាក់ ) ។
ដោយឡែក រយៈពេល ០៩ ថ្ងៃ មក នេះ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ចំនួន ៨៥ លើក បណ្ដាលឱ្យ មនុស្ស ស្លាប់ ៤៨ នាក់ របួស ១១០ នាក់ ( របួស ធ្ងន់ ៧៨ នាក់ )៕
អាជ្ញាធរ ចុះអនុវត្តន៍ ច្បាប់ រុះរើ ខ្ទម និង ទប់ស្កាត់ កាប់ ការទន្រ្ទានដី រដ្ឋ អនាធិបតេយ្យ យក ទៅ ធ្វើជា កម្មសិទ្ធិ នៅក្នុង តំបន់ ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវ៉ាញ ខាងត្បូង ខេត្ត កោះកុង
លោក សុខ សុទ្ធី បាន ឲ្យដឹង ថា ការចុះអនុវត្តន៍ វិធានការ របស់ រដ្ឋបាល ខេត្ត សម្រាប់ បងប្អូន ប្រជាពលរដ្ឋ ដែល បាន កាប់ ទន្ទ្រាន និង សង់ ខ្ទម លើក ដី របស់ ឧទ្យាន ជាតិ ជា អនាធិបតេយ្យ ដោយ គ្មាន ការអនុញ្ញាត នោះ គណៈ បញ្ជាការ ឯកភាព ខេត្ត ស្រុក ត្រូវ មាន វិធាន ទប់ស្កាត់ មិន អនុញ្ញាត បន្ត ទៀត ឡើយ ហើយ អាជ្ញាធរ ត្រូវតែ អនុវត្តន៍ ច្បាប់ ជាបន្ទាន់ មិន ឲ្យ រីករាល ដាល់ បន្ត ទៀត ឡើយ ពីព្រោះ ដី តំបន់ នេះ តំបន់ ឧទ្យាន ជាតិ ជួរ ភ្នំ ក្រវ៉ាញ ខាងត្បូង ។
លោក សុខ សុទ្ធី បាន បន្ថែម ថា រដ្ឋបាល អាជ្ញាធរ ខេត្ត ស្រុក បាន អញ្ជើញ គាត់ ទាំង ៥គ្រួសារ មក ធ្វើ ការណែនាំ ធ្វើ កិច្ចសន្យា ដល់ ពួកគាត់ ចំនួន ៤- ៥ដង មក ហើយ មុននឹង ក្រុមការងារ ចុះអនុវត្តន៍ ច្បាប់ ក្នុង ការរុះរើ ខ្ទម ទាំង ៥នេះ ដោយ មិន អនុញ្ញាតឲ្យ សាងសង់ និង កាប់ ទន្ទា្រន ដី ព្រៃ របស់ រដ្ឋ បន្ត ឡើយ ។
ការអញ្ជើញ ជួប សំណេះសំណាល នាសៀល ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២១ ម្សិលមិញ ក្នុង គោលបំណង ដើម្បី ពង្រឹង ស្មារតី សតិអារម្មណ៍ និង គោលជំហរ នយោបាយ សម្រាប់ ត្រៀម ជួយ គណបក្ស ប្រជាជន កម្ពុជា ដណ្ដើម យក ជ័យជម្នះ ក្នុង ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ នា ឆ្នាំ ២០២២ និង បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នៅ ឆ្នាំ ២០២៣ ខាងមុខ ដើម្បីឱ្យ សម្ដេច តេជោ ហ៊ុន សែន ដឹកនាំ ប្រទេស ជា កម្ពុជា ឱ្យ បន្ត ទៅ រក ការរីកចម្រើន សុខ សន្តិភាព ស្ថិរភាព នយោបាយ និង អភិវឌ្ឍន៍ លើ គ្រប់ វិស័យ ។
នា ឱកាស នោះ ដែរ លោកស្រី ក៏ បាន ចែក អំណោយ ជូន ប្រជាពលរដ្ឋ ដែល បាន ចូលរួម ដោយ ម្នាក់ ៗ ទទួលបាន ក្រម៉ា សាប៊ូ ម៉ាស ព្រមទាំង ថវិកា មួយ ចំនួន ផងដែរ ៕ ទូត ខ្មែរ នៅ ជប៉ុន ជូនដំណឹង បន្ទាន់ ពី លក្ខខណ្ឌ ចេញ ចូល និង រស់ នៅ ជប៉ុន ក្រោយ ជប៉ុន ដាក់ ប្រទេស ក្នុង ភាពអាសន្ន ព្រោះ ជំងឺ កូវីដ១៩
យោង តាម សេចក្តីជូនដំណឹង បាន បញ្ជាក់ ថា យោង តាម វិធានការ របស់ រដ្ឋាភិបាល ជប៉ុន ដែល ចូល ជាធរមាន នៅ យប់ ថ្ងៃទី ៨ ខែមករា សម្រាប់ ប្រទេស កម្ពុជា នេះ រួម មាន៖
២៖ ប្រជាពលរដ្ឋ ខ្មែរ ដែល មាន សិទ្ធិ ស្នាក់ នៅ ត្រូវ មាន លិខិត បញ្ជាក់ អវិជ្ជមាន កូវីដ១៩ ក្នុង រង្វង់ ៧២ ម៉ោង មុន ចេញដំណើរ ហើយ ត្រូវ ធ្វើតេស្ត ម្ដង ទៀត ពេល មកដល់ ជប៉ុន ។ ក្នុង ករណី មិន មាន លិខិត បញ្ជាក់ អវិជ្ជមាន កូវីដ១៩ នេះ ទេ អ្នកដំណើរ ត្រូវ ស្នាក់ នៅ ទីតាំង កំណត់ ដោយ ប្រធាន ស្ថានីយ ចត្តាឡី ស័ក ជប៉ុន ។
៣៖ វិធានការ ខាងលើ ត្រូវ អនុវត្ត តាម កាលបរិច្ឆេទ ដូច ខាងក្រោម៖
- ធ្វើតេស្ត សម្រាប់ អ្នកដំណើរ ទាំងអស់ ដែល មកដល់ ជប៉ុន ពី ម៉ោង ០០:០០ ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ - ត្រូវ មាន លិខិត បញ្ជាក់ អវិជ្ជមាន កូវីដ១៩ ក្នុង រង្វង់ ៧២ ម៉ោង មុន ចេញដំណើរ សម្រាប់ អ្នកដំណើរ ដែល មកដល់ ជប៉ុន ពី ម៉ោង ០០:០០ ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០២១ - វិធានការ ទាំង នេះ នឹង ត្រូវ អនុវត្ត រហូតដល់ មាន ការលើកលែង ស្ថានភាពអាសន្ន ( តាម គម្រោង ការប្រកាស ភាពអាសន្ន នៅ ត្រូវ លើកលែង នៅ ថ្ងៃទី ៧ ខែកុម្ភៈ ឆ្នាំ ២០២១) ។
ប្រកាស កែសម្រួល និង បំពេញ បន្ថែម សមាសភាព យុវជន គណបក្ស ខណ្ឌ ពោធិ៍សែនជ័យ . លោក ហែម ដារិទ្ធ ជា ប្រធាន
( ភ្នំពេញ ) ៖ លោក ហែម ដារិទ្ធ ត្រូវបាន ប្រកាស តែងតាំង ជា ប្រធាន យុវជន គណបក្ស ប្រជាជន កម្ពុជា ខណ្ឌ ពោធិ៍សែនជ័យ និង លោក ព្រាប ម៉ាណែល ជា អនុប្រធាន រួម ជាមួយ ប្រធាន អនុប្រធាន យុវជន បក្ស សង្កាត់ . ប្រធាន អនុប្រធាន យុវជន បក្ស ភូមិ និង សហគមន៍ និង សមាជិក សមាជិក ការ យុវជន បក្ស សរុប ចំនួន ៧៦២ រូប ថែម ទៀត ។
ពិធី ប្រកាស កែសម្រួល និង បំពេញ បន្ថែម សមាសភាព យុវជន គណបក្ស មូលដ្ឋាន ខណ្ឌ ពោធិ៍សែនជ័យ ធ្វើឡើង នា ព្រឹក ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ នេះ នៅ ភូមិ ចំការ ឪឡឹក១ សង្កាត់ កាកាបទី១ ខណ្ឌ ពោធិ៍សែនជ័យ ក្រោម អធិបតីភាព លោក ទេសរដ្ឋមន្រ្តី ឃុន ហាំង ប្រធាន ក្រុមការងារ ថ្នាក់ ជាតិ ចុះ ជួយ ខណ្ឌ ពោធិ៍សែនជ័យ . លោក ម៉ប សារិន ប្រធាន ក្រុមការងារ ថ្នាក់ កណ្តាល ចុះ ជួយ ខណ្ឌ ពោធិ៍សែនជ័យ និង លោក នួន ផារ័ត្ន ប្រធាន ក្រុមការងារ យុវជន គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ ។
គោលបំណង សំខាន់ នៃ ការកែសម្រួល និង បំពេញ បន្ថែម សមាសភាព យុវជន គណបក្ស មូលដ្ឋាន នា ឱកាស នេះ ដើម្បី ឈាន ឆ្ពោះ ទៅរក ភាពជោគជ័យ ក្នុង ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ សង្កាត់ ឆ្នាំ ២០២២ និង បោះឆ្នោត តំណាងរាស្រ្ត ឆ្នាំ ២០២៣ ។
សម្រេចបាន គោលដៅ នេះ គណៈកម្មាធិការ បក្ស ប្រជាជន ខណ្ឌ ពោធិ៍សែនជ័យ បន្ត យកចិត្តទុកដាក់ លើ ចលនា មហាជន និង ការចិញ្ចឹម ចលនាម នហាជន នៅ មូលដ្ឋាន ដោយ ប្រើ នូវ មធ្យោបាយ សរុប កម្លាំង សរុប និង ធនធាន ដែល មាន ស្រាប់ បន្ត អនុវត្តន៍ តាម គោលការណ៍ ( រក្សា ចាស់ ពង្រីក ថ្មី ) ពិសេស ក្នុង ស្រទាប់ យុវជន ជំនាន់ ក្រោយ ដែល ជា អ្នក បន្ត វេន ព្រោះ យុវជន គឺជា កម្លាំង ស្នូល របស់ គណបក្ស ដែល គ្រប់ កាលៈទេសៈ មិន អាច ខ្វះ យុវជន បាន ឡើយ ។
ក្នុង ឱកាស នោះ ក្នុង នាម គណបក្ស ប្រជាជន កម្ពុជា រាជធានី ភ្នំពេញ លោក បាន នាំយក ថវិកា ឧបត្តម្ភ ដល់ គណបក្ស ខណ្ឌ ចំនួន ២លាន រៀល . បក្ស សង្កាត់ ទាំង៧ មួយ សង្កាត់ ១លាន រៀល និង សមាជិក សមាជិក បក្ស ដែល បាន ចូលរួម ម្នាក់ ៗ ៣ម៉ឺន រៀល និង នាឡិកា បក្ស ម្នាក់ ១ គ្រឿង ផងដែរ ៕ លោក ងួន ញ៉ិល ត្រួតពិនិត្យ ការងារ គណបក្ស ស្រុក បារាយណ៍ - ស្រុក តាំង គោក
( កំពង់ធំ )៖ លោក ងួន ញ៉ិល សមាជិក គណៈ អចិន្ត្រៃយ៍ នៃ គណៈកម្មាធិការ កណ្តាល និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ខេត្ត កំពង់ធំ នា ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ នេះ បាន បើក កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ គណបក្ស ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក ព្រមទាំង បាន ផ្ដល់ អនុសាសន៍ ជាច្រើន ដល់ ថ្នាក់ដឹកនាំ និង សមាជិក បក្ស ថ្នាក់ ស្រុក ដើម្បី បន្ត វឌ្ឍនភាព ការងារ តទៅទៀត ។
ក្នុង របាយការណ៍ របស់ លោក ថោង ខុន ប្រធាន ក្រុមការងារ រាជ រដ្ឋា ភុិបាល ចុះ ខេត្ត កំពង់ធំ និង ប្រធាន ក្រុមការងារ បក្ស ចុះ ជួយ ស្រុក បារាយណ៍ និង ស្រុក តាំង គោក បាន បង្ហាញ អំពី លទ្ធផល ការងារ សំខាន់ ៗ ដែល រដ្ឋបាល ស្រុក និង គណបក្ស ស្រុក ទាំង ពីរ សម្រេចបាន ដូច ជា៖
* ការងារ សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សាធារណៈ៖ កម្លាំង សមត្ថកិច្ច នៃ រដ្ឋបាល ស្រុក ទាំង ពីរ បាន ធ្វើ ការគ្រប់គ្រង សន្តិសុខ សុវត្ថិភាព សណ្តាប់ធ្នាប់ សាធារណៈ បាន ល្អ ប្រសើរ និង ពុំ មាន អ្វី កើតឡើង គួរឲ្យ កត់សម្គាល់ ទេ ។ បាន ចុះ ផ្សព្វផ្សាយ ជា ប្រចាំ នៅ តាម បណ្តា ភូមិ ឃុំ ស្តីពី គោល នយោបាយ ភូមិ - ឃុំ មាន សុវត្ថិភាព ។ បាន អនុវត្ត តាម លក្ខណៈ សម្បត្តិ របស់ ភូមិ ឃុំ - សង្កាត់ មាន សុវត្ថិភាព មាន ៨ យ៉ាង ( តាម សេចក្តីព្រាង ឯកសារ ក្រសួង មហាផ្ទៃ ) ។
* លទ្ធផល នៃ ការងារ ឆ្វៀល ដី នៅ តំបន់ ៣៖ ការខិតខំ អនុវត្ត លើ ការងារ បង្កបង្កើន ផល ការងារ ផ្តល់ សេវា សាធារណៈ ការងារ អន្តរាគមន៍ បូម ទឹក សង្គ្រោះ ស្រូវ ប្រជាពលរដ្ឋ ការងារ ជួយសង្គ្រោះ ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ជំនន់ ទឹកភ្លៀង ការងារ ប្រយុទ្ធ ប្រឆាំង ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ការងារ ឧបត្ថម្ភ សាច់ប្រាក់ ដល់ គ្រួសារ ក្រីក្រ ( ក្រ១ និង ក្រ២ ) ដែល រងគ្រោះ ដោយ វិបត្តិ ជំងឺ កូវីដ១៩ ព្រមទាំង ការងារ បណ្តុះបណ្តាល ធនធាន មនុស្ស ផងដែរ ។
ក្រោយ ស្ដាប់ នូវ របាយការណ៍ ខាងលើ លោក ងួន ញ៉ិល បាន លើកឡើង អំពី ប្រវត្តិ នៃ ការតស៊ូ របស់ គណបក្ស ប្រជាជន កម្ពុជា ទម្រាំ ឈាន ថ្ងៃ រំដោះ ៧ មករា ដែល ជា ថ្ងៃ រំដោះ ប្រជាពលរដ្ឋ កម្ពុជា ពី របប ប្រល័យ ពូជសាសន៍ និង ការកសាង ប្រទេស ពី បាត ដៃ ទទេ រហូតដល់ មាន ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ដូច ពេល បច្ចុប្បន្ន ក្រោម ការដឹកនាំ របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រធាន គណបក្ស ប្រជាជន កម្ពុជា ។
ចំណេះដឹង ទូទៅ៖ ក្នុង ចំណោម ប្រធានាធិបតី អាមេរិក ៤៥ រូប មាន ២៥ រូប កាន់ តំណែង ត្រឹម ១ អាណត្តិ និង តិច ជាង នេះ
ក្រោយមក ទៀត រដ្ឋធម្មនុញ្ញ អាមេរិក បាន កំណត់ ឲ្យ បុគ្គល ១រូប កាន់ តំណែង ជា ប្រធានាធិបតី តែ ២អាណត្តិ ប៉ុណ្ណោះ ហើយ ក្នុង ១អាណត្តិ ៗ មាន រយៈពេល ៤ឆ្នាំ ដដែល ៕
លោកស្រី ឱ វណ្ណឌីន៖ ៧ ចំណុច ដែល មូលដ្ឋាន សេវា សុខាភិបាល ឯកជន ត្រូវ អនុវត្ត ដើម្បី ភាពរីកចម្រើន ក្នុង វិស័យ សុខភាព សាធារណៈ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ លោកស្រី វេជ្ជបណ្ឌិត ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បាន ថ្លែង ថា ការចូលរួម របស់ សេវា សុខាភិបាល ឯកជន គឺ ពិតជា មាន សារសំខាន់ ណាស់ ដើម្បី ចូលរួម ជាមួយ ក្រសួង សុខាភិបាល ក្នុង ការជួយ បំពេញ បន្ថែម នូវ ភាព អាច ទទួលបាន និង ងាយ ទៅ ទទួល សេវា សុខភាព នៅ តាម តំបន់ ឬ ទីកន្លែង នីមួយ ៗ ទៅ តាម ការសម្រេចចិត្ត របស់ អ្នកជំងឺ ឬ ក្រុមគ្រួសារ អ្នកជំងឺ ផ្ទាល់ ក្នុង គោលបំណង រួមគ្នា ធ្វើឱ្យ មាន ភាពរីកចម្រើន ក្នុង វិស័យ សុខភាព សាធារណៈ នៅ កម្ពុជា ។
លោកស្រី បាន ផ្ដល់ជូន អនុសាសន៍ ចំនួន ៧ ចំណុច សម្រាប់ ការអនុវត្តន៍ នៅ តាម មូលដ្ឋាន សេវា សុខាភិបាល ឯកជន ទាំងអស់ ដើម្បី ភាពរីក ច្រើន ក្នុង វិស័យ សុខភាព សាធារណៈ នៅ កម្ពុជា មាន ដូច ជា៖
១៖ នៅក្នុង បរិបទ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ ត្រូវ ចូលរួម ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ជាមួយ ក្រសួង សុខាភិបាល ក៏ ដូចជា ជាមួយ រាជ រដ្ឋាភិបាល ដោយ អនុវត្ត តាម គោលការណ៍ ណែនាំ របស់ ក្រសួង សុខាភិបាល ដោយ មិន អនុញ្ញាតឱ្យ សេវា ឯកជន ពិនិត្យ និង ព្យាបាល ជំងឺ កូវីដ - ១៩ ឡើយ និង តម្រូវ ឱ្យ មាន ការចូលរួម ពី សេវា សុខាភិបាល ឯកជន ក្នុង ការត្រួតពិនិត្យ ឆែក រក ករណី សង្ស័យ កូវីដ - ១៩ ដោយ ប្រើប្រាស់ តាម និយមន័យ សង្ស័យ ករណី កូវីដ - ១៩ នៅ ពេល ដែល មាន អតិថិជន មក ប្រើប្រាស់ សេវា នៅ កន្លែង របស់ ខ្លួន ។
ដោយ នេះ ស្រប តាម អនុសាសន៍ ណែនាំ ដ៏ ខ្ពង់ខ្ពស់ របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល បាន ថ្លែង ទៅកាន់ ជន រួម ជាតិ នៅ ថ្ងៃទី ១៥ ខែធ្នូ ឆ្នាំ ២០២០ ហើយ ចាំបាច់ ត្រូវ បញ្ជូន អ្នក ដែល សង្ស័យ ទៅ មន្ទីរពេទ្យ រដ្ឋ ព្រមទាំង អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល លើ វិធានការ ការពារ ការចម្លង រោគ នៅក្នុង ទី កន្លែង របស់ ខ្លួន តាម លិខិត ណែនាំ លេខ ១០៣ អបស.ម ព ចុះ ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០២០ និង លិខិត ណែនាំ លេខ ១០៤ អបស.ម ព ចុះ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ។
៣៖ សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន ត្រូវ ចេះ រៀបចំ ផែនការ សកម្មភាព ការងារ ប្រចាំ ឆ្នាំ របស់ ខ្លួន ឱ្យ បាន ច្បាស់លាស់ ដើម្បី អនុវត្ត ជារៀងរាល់ ឆ្នាំ ដោយ ខិតខំ រក្សា ឱ្យ បាន នូវ តុល្យភាព រវាង បរិមាណ និង គុណភាព បច្ចេកទេស ដែល ជា ក្តី ព្រួយបារម្ភ របស់ យើង ទាំងអស់ គ្នា ។
៤៖ ត្រូវ ចេះ អភិវឌ្ឍ បច្ចេកវិទ្យា ពេទ្យ ដោយ ប្រើប្រាស់ កំព្យូទ័រ ឬ ប្រព័ន្ធ អនឡាញ ដើម្បី ចូលរួម ជាមួយ ក្រសួង សុខាភិបាល ក្នុង ការធ្វើ ការចុះបញ្ជិ កាសុំ អជ្ញាប័ណ្ណ បើក សេវា សុខាភិបាល ឯកជន តាម ប្រព័ន្ធ អេឡិចត្រូនិក នា ពេល ខាងមុខ នេះ ដើម្បី ងាយស្រួល ក្នុង ការគ្រប់គ្រង និង តាមដាន ការអនុវត្តន៍ ផង និង ក៏ អាច ឆ្ពោះ ទៅរក ការធ្វើ ការវាយតម្លៃ គុណភាព (Accreditation) បាន ដែរ នា ពេល អនាគត ។
៦៖ សូម ធ្វើ ការព្យាបាល អ្នកជំងឺ ដោយ គោរព ឱ្យ បាន នូវ ក្រមសីលធម៌ វិជ្ជាជីវៈ ពេទ្យ មិន មាន ការរើសអើង ដោយ មាន ការទទួលខុសត្រូវ ខ្ពស់ និង បន្ត ខិតខំ ពង្រឹង ចំណេះដឹង បន្ថែម ទៀត ធានា ឱ្យ ទទួលបាន នូវ ការ ពង្រឹង សមត្ថភាព ដើម្បី ពង្រឹង បច្ចេកទេស ក្នុង ការព្យាបាល ជំងឺ បាន ល្អ ប្រសើរ ព្រមទាំង ធ្វើ ការអភិវឌ្ឍន៍ បច្ចេកវិទ្យា ពេទ្យ ឱ្យ បាន សមស្រប ទាន់សម័យ ផងដែរ ។
៧៖ សូម ធ្វើ ការអំពាវនាវ ដល់ ម្ចាស់ ឬ អ្នកទទួលខុសត្រូវ មូលដ្ឋាន សេវា សុខាភិបាល ឯកជន ទាំងអស់ ដែល មាន នៅ កម្ពុជា ដូចជា មន្ទីរពេទ្យ ឯកជន មន្ទីរ ពហុ ព្យាបាល មន្ទីរ សម្រាក ព្យាបាល មន្ទីរពិសោធន៍ មន្ទីរ ព្យាបាល មាត់ ធ្មេញ មជ្ឈមណ្ឌល កែ សម្ផស្ស និង បន្ទប់ ពិគ្រោះ ព្យាបាល ជំងឺ សូម មាន សាមគ្គីភាព គ្នា ល្អ ចូលរួម ជា ធ្លុង មួយ ស្ម័គ្រចិត្ត ចូល ជា សមាជិក សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន ឱ្យ បាន គ្រប់ ៗ គ្នា ។
លើស ពី នោះ ត្រូវ សហការ ជាមួយ សមាគម នេះ ដើម្បី បានជា កម្លាំង ដ៏ រឹងមាំ សម្រាប់ ជួយ គ្នា ទៅ វិញ ទៅមក និង ចែករំលែក បទពិសោធន៍ ក៍ ដូចជា ព័ត៌មាន នានា របស់ ក្រសួង សុខាភិបាល ជម្រុញ ដំណើ ការ សមាគម នេះ ឱ្យ មាន សកម្មភាព សកម្ម សំដៅ រួមគ្នា អភិវឌ្ឍ វិស័យ សុខាភិបាល ឱ្យ បាន រីកចម្រើន បន្ថែម ទៀត ដើម្បី ជា ផលប្រយោជន៍ ធ្វើឱ្យ បាន ល្អ ប្រសើរឡើង នូវ សុខភាព ប្រជាជន ទូទៅ ចូលរួមចំណែក អភិវឌ្ឍ ប្រទេសជាតិ បាន រុងរឿង ។
ការថ្លែង ដូច្នេះ របស់ លោកស្រី ឱ វណ្ណឌីន ក្នុង ឱកាស អញ្ជើញ ប្រកាស ដាក់ ឲ្យ ដំណើរការ ជា ផ្លូវការ សមាគម អ្នក ផ្តល់ សេវាកម្ម សុខាភិបាល ឯកជន នៅ កម្ពុជា នៅ សណ្ឋាគារ សាន់ វេ នៅ ព្រឹក ថ្ងៃទី ០៩ ខែមករា ឆ្នាំ ២០២១ នេះ ។
លោកស្រី បាន បញ្ជាក់ បន្ថែម ថា « ក្នុង ឱកាស សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា ដែល មិន ធ្លាប់ មាន ពីមុន មក ឥឡូវនេះ ទើបតែ បាន រៀបចំ នៅ ឆ្នាំ ២០២០ ហើយ ដាក់ ឱ្យ ដំណើរការ នៅ ថ្ងៃ នេះ សូម សមាគម ចូលរួម លើកស្ទួយ ការគោរព ក្រមសីល វិជ្ជាជីវៈ សុខាភិបាល និង អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល » ។
ក្នុង ឱកាស នោះ លោកស្រី ក៏ បាន កោតសរសើរ និង ថ្លែងអំណរគុណ ដល់ ការខិតខំ ប្រឹងប្រែង របស់ ស្ថាបនិក សមាគម នេះ ដែល បាន ចាត់ចែង រៀបចំ សមាគម អ្នក ផ្តល់ សេវា សុខាភិបាល ឯកជន នៅ កម្ពុជា រហូត បាន ដាក់ចេញ ឱ្យ ប្រើប្រាស់ នា ពេលនេះ ៕ អភិបាល ខេត្ត កំពត ប្រគល់ ឧបករណ៍ វាស់ កំដៅ និង បាញ់ ទឹក អាកុល ស្វ័យប្រវត្តិ ដល់ សាលា បឋមសិក្សា និង មត្តេយ្យ ចំនួន ៩៩ សាលា
( ក្រចេះ ) ៖ លោកស្រី ស៊ុន សាភឿន តំណាងរាស្ត្រ មណ្ឌល ខេត្ត ក្រចេះ អនុប្រធាន ក្រុមការងារ គណបក្ស ចុះ មូលដ្ឋាន ខេត្ត ក្រចេះ ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ឃុំ ហាន់ ជ័យ និង ជា ប្រធាន ក្រុមការងារ សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ « ន .ក .ស. អ» ថ្នាក់ កណ្ដាល ចុះ ជួយ ខេត្ត ក្រចេះ បាន អញ្ជើញ ជួប សំណេះសំណាល ជាមួយ ក្រុមការងារ សមាគម នារី កម្ពុជា ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ « ន .ក .ស. អ» ចំនួន ប្រមាណ ជាង ៤០ នាក់ ដែល មកពី ឃុំ ទាំង៨ នៃ ស្រុក ឆ្លូង ។
ពិធី នៅ រសៀល ថ្ងៃទី ០៨ ខែមករា ឆ្នាំ ២០២១ ធ្វើឡើង ដើម្បី ពង្រឹង ស្មារតី សតិអារម្មណ៍ និង គោលជំហរ នយោបាយ សម្រាប់ ត្រៀម ជួយ គណបក្ស ប្រជាជន កម្ពុជា ដណ្ដើម យក ជ័យ ជំនះ ក្នុង ការបោះឆ្នោត ក្រុមប្រឹក្សា ឃុំ - សង្កាត់ នា ឆ្នាំ ២០២២ និង បោះឆ្នោត ជ្រើសតាំង តំណាងរាស្ដ្រ នៅ ឆ្នាំ ២០២៣ ខាងមុខ ដើម្បី បាន សម្ដេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី ដឹកនាំ ប្រទេសជាតិ តទៅទៀត ក្នុង សុខ សន្តិភាព និង ការអភិឌ្ឍ ។
លោកស្រី ក៏ បាន លើក ផងដែរ អំពី ការអភិវឌ្ឍ ឥត ឈប់ឈរ លើ គ្រប់ វិស័យ និង សមិទ្ធផល ធំ ៗ ដែល រាជ រដ្ឋាភិបាល សម្រេច បាន ជាពិសេស ភាពជោគជ័យ ជា ប្រវត្តិសាស្ត្រ នៃ ការរកឃើញ ដំណក់ ប្រេង ដំបូង ក្រោម ការខិតខំ ប្រឹងប្រែង របស់ សម្ដេច តេជោ ហ៊ុន សែន ប្រតិបត្តិករ នៃ នយោបាយ ឈ្នះ ឈ្នះ ដែល បាន រំដោះ ប្រទេសជាតិ និង ប្រជាជន កម្ពុជា ចេញ ពី របប ប្រល័យ ពូជសាសន៍ ហើយ បាន កសាង អភិវឌ្ឍ ប្រទេស តាំងពី បាត ដៃ ទទេ រហូត មាន អ្វី ៗ គ្រប់ យ៉ាង ដូច សព្វ ថ្ងៃ ។
កូនស្រី បាន ប្រាប់ ថា ម្តាយ ខ្ញុំ ឈ្មោះ ជួប សារ៉ែ ន អាយុ ៣៨ ឆ្នាំ មុខរបរ នៅ ផ្ទះ ឪពុក ខ្ញុំ ឈ្មោះ សេង គឹម សាន អាយុ ៥៨ ឆ្នាំ មុខរបរ ជា គ្រូបង្រៀន វិទ្យាស្ថាន កងរាជអាវុធហត្ថ កំបូល ស្នាក់ នៅ កន្លែង កើត ហេតុ ខាង លើ ។
សមត្ថកិច្ច ខណ្ឌ សែនសុខ បាន បញ្ជាក់ ថា ក្រោយ កើត ហេតុ កម្លាំង បាន ចុះ ទៅដល់ គឺ បាន រកឃើញ កាំភ្លើង ខ្លី មួយ ដើម ម៉ាក K59 សំបក គ្រាប់ ចំនួន ៤គ្រាប់ នៅក្នុង បន្ទប់ ជួល ដែល មាន ករណី បាញ់ សម្លាប់ គ្នា រវាង ប្តី ប្រពន្ធ ខាងលើ ។
បើ តាម លោក វិជ្ជបណ្ឌិត នង សុវណ្ណ រត័្ន គ្រូពេទ្យ កុសល្យវិច្ច័យ បាន បញ្ចាក់ ថា ករណី ខាងលើ ពិតជា ករណី ឃាតកម្ម នឹង ធ្វើ អត្តឃាត ( បាញ់ សំលាប់ ខ្លួន ឯង ) ពិតប្រាកដ មែន ។
( ភ្នំពេញ ) ៖ លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បាន អះអាង ថា សណ្ឋាគារ ដៃគូ ទាំងអស់ បាន ផ្តល់ កិច្ចសហការ យ៉ាង ល្អ ក្នុង ការទទួល អ្នកដំណើរ ជា ជន បរទេស ឬ ខ្មែរ ស្នាក់ នៅ ធ្វើចត្តាឡី ស័ក ។ ការបញ្ជាក់ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សារព័ត៌មាន ខ្មែរ ថា មស៍ ចុះផ្សាយ ថា មាន កន្លែង មួយចំនួន មិន អនុញ្ញាតឱ្យ ពលរដ្ឋ ខ្មែរ ធ្វើចត្តាឡី ស័ក ។
ក្រសួង បាន បញ្ជាក់ ថា ជាមួយគ្នា នេះ ដែរ ព័ត៌មាន អ្នកដំណើរ ដែល បាន ចុះផ្សាយ ( ឈ្មោះ SEAN) ដែល សារព័ត៌មាន ខ្មែរ ថែមស៍ បាន លេីក កាលពី ថ្ងៃទី ៨ ខែមករា ឆ្នាំ ២០២១ នោះ ក្រសួង មិន អាច រកឃើញ មាន នៅក្នុង ប្រព័ន្ធ កម្មវិធី គ្រប់គ្រង អ្នកដំណើរ ឡេីយ ហើយ សណ្ឋាគារ ពាក់ព័ន្ធ ដែល ត្រូវបាន លើកឡើង ថា មាន បញ្ហា ដាក់ នៅក្នុង សារព័ត៌មាន នេះ ដែរ ក៏ បាន បញ្ជាក់ មក ក្រសួង រួច ហេីយ ដែរ ថា មិន មាន ករណី ដូច ការចុះផ្សាយ នេះ ទេ ។
អ្នក ឆ្លង កូវីដ១៩ ទាំង ៤នាក់ រួម មាន៖
១៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២៦ ឆ្នាំ ស្នាក់ នៅ ឃុំ បឹង ព្រីង ស្រុក ថ្មគោល ខេត្ត បាត់ដំបង បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២១ ។
២៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២១ ឆ្នាំ ស្នាក់ នៅ ឃុំ ជ្រោយ ស្មៅ ស្រុក ថ្មគោល ខេត្ត បាត់ដំបង បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២១ ។
៤៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២៦ ឆ្នាំ ស្នាក់ នៅ ភូមិបាលិលេយ្យ សង្កាត់ ប៉ោយប៉ែត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ០៥ ខែមករា ឆ្នាំ ២០២១ ។
សូម កត់សម្គាល់ ថា៖ លទ្ធផល ធ្វើតេស្ត វត្ថុ សំណាក របស់ ស្ត្រី ទាំង ០៤ នាក់ ខាងលើ នេះ ផ្តល់ ដោយ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា រាជធានី ភ្នំពេញ គឺ វិជ្ជមាន វីរុស កូរីដ - ១៩ ហើយ បច្ចុប្បន្ន អ្នកជំងឺ ត្រូវបាន ដាក់ ឱ្យ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បន្ទាយមានជ័យ ។
ចំពោះ អ្នក ជាសះស្បើយ ទាំង ០៦ នាក់ រួម មាន៖
១៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ៣៦ ឆ្នាំ ស្នាក់ នៅ ភូមិ ផ្សារ ព្រំ ឃុំ ស្ទឹង កាច់ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ។
២៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២៧ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ភូមិ ផ្សារ ព្រំ ឃុំ ស្ទឹង កាច់ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ។
៣៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២៤ ឆ្នាំ មាន អាសយដ្ឋាន ស្នាក់ នៅ ឃុំ ស្ទឹង កាច់ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២០ ។
