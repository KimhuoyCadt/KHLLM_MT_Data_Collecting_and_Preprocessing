( កំពង់ធំ ) ៖ ថ្ងៃ បើក បវេសនកាល ឆ្នាំ សិក្សា ថ្មី ឆ្នាំ ២០២១ នៅ វិទ្យាល័យ ហ៊ុន សែន បល្ល័ង្ក ស្ថិត នៅក្នុង ក្រុង ស្ទឹង សែន នា ព្រឹក ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២១ លោក សុខ លូ អភិបាល ខេត្ត កំពង់ធំ បាន អំពាវនាវ សិស្សានុសិស្ស ទាំងអស់ សូម រក្សា គម្លាត សុវត្ថិភាព និង រក្សា អនាម័យ ឱ្យ បាន ជាប់ ជានិច្ច ដើម្បី ចៀសវាង នូវ ការឆ្លង ជំងឺ កូវីដ១៩ នៅ គ្រប់ ទីកន្លែង ដែល ធ្វើឲ្យ ប៉ះពាល់ ការសិក្សា និង សេដ្ឋកិច្ច ជាតិ ទាំងមូល ។
ជាមួយគ្នា នេះ លោក សុខ លូ បាន អាន សារលិខិត សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ថ្លែង ក្នុង ឱកាស បើក បវេសនកាល ឆ្នាំ សិក្សា ២០២០ - ២០២១ ព្រមទាំង មានប្រសាសន៍ បន្ថែម ទៀត ថា ក្មួយ ៗ សម័យ នេះ ពិតជា មាន ភ័ព្វសំណាង ណាស់ ដែល បាន រស់ នៅ ក្រោម ម្លប់ សន្តិភាព ដែល មាន សម្ដេច តេជោ ហ៊ុន សែន បាន យកចិត្តទុកដាក់ ខ្ពស់ ទៅ លើ វិស័យ អប់រំ នេះ ដែល បាន សាងសង់ អគារ សិក្សា ខ្ពស់ មាន បន្ទប់ រៀន ស្អាត ធំ ទូលាយ វិស័យ អប់រំ ល្អ និង មាន គុណភាព ។
លោក បន្ត ទៀត ថា កន្លងមក អត្រា កំណើន សិស្ស នៃ ការប្រឡង ជាប់ បាក់ឌុប និង សិស្ស ពូកែ ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ គឺ មាន ការកើនឡើង ហើយ សង្ឃឹម ថា ថ្នាក់ ទី ១២ ឆ្នាំ នេះ នឹង មាន សិស្ស ប្រឡង ជាប់ បាន ច្រើន នឹង ទទួលបាន និទ្ទេស ល្អ ថែម ទៀត ។ ដូច្នេះ សូម ក្មួយ ៗ ត្រូវ ខិតខំ សិក្សា រៀនសូត្រ ស្ដាប់ ដំបូន្មាន ឪពុក ម្ដាយ លោកគ្រូ អ្នកគ្រូ ដើម្បី ក្លាយជា សិស្ស ល្អ កូន ល្អ ពលរដ្ឋ ល្អ នៅក្នុង សង្គម ហើយ ជា ទំពាំង ស្នង ឬស្សី សំរាប់ អនាគត ប្រទេសជាតិ យើង ។
លើស ពី នេះ ទៀត លោក ក៏ បាន អំពាវនាវ ដល់ លោកគ្រូ អ្នកគ្រូ ទាំងអស់ សូម ខិតខំ បន្ត ជួយ ផ្សព្វផ្សាយ បន្ថែម ទៀត អំពី ការរស់នៅ បែប កន្លង ថ្មី ដើម្បី ជៀសវាង ឆ្លង ជំងឺ កូវីដ១៩ ដោយ រក្សា គម្លាត សុវត្ថិភាព ការរក្សា អនាម័យ ឱ្យ បាន ជាប់ ជានិច្ច រាល់ ការធ្វើដំណើរ ត្រូវ ពាក់ ម៉ាស នឹង មាន ទឹក អាកល់ ឬ ជែល លាង ដៃ យក តាម ខ្លួន ជានិច្ច មិន ត្រូវ មាន ការជួបជុំគ្នា នោះ ទេ ហើយ ជំងឺ កូវីដ១៩ នេះ មិន មែន កើតមាន តែ នៅ ប្រទេស កម្ពុជា នោះ ទេ គឺ កើតមាន ទូទាំង សាកលលោក ដោយ ពុំ ទាន់ មាន ថ្នាំ ព្យាបាល នោះ ទេ ។
ទន្ទឹម នោះ ដែរ លោក តាន់ ប៊ុន ហុង ប្រធាន មន្ទីរ អប់រំ យុវជន និង កីឡា ខេត្ត បាន ថ្លែង ថា ក្រសួង អប់រំ បាន ចេញ សេចក្តីណែនាំ ដល់ គ្រឹះស្ថាន សិក្សា ទាំងអស់ ត្រូវ អនុវត្ត ទៅ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល និង អង្គការ សុខភាព ពិភពលោក ដោយ រក្សា អនាម័យ ស្អាត រក្សា គម្លាត សុវត្តិភាព និង ពាក់ ម៉ាស ក្នុង ករណី ចាំបាច់ ។
ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល ជំរុញ ឱ្យ សិស្ស មន្ត្រី ជាន់ ខ្ពស់ នៃ សាលា ភូមិន្ទ រដ្ឋបាល យក ចំណេះដឹង ដែល ខ្លួន មាន ទៅ បម្រើ ជាតិ មាតុភូមិ ឱ្យ មាន ការរីកចម្រើន ថែម ទៀត
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល រដ្ឋមន្ត្រី ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន ជំរុញ ឱ្យ កម្មសិក្សា ការី និង សិស្ស មន្ត្រី ជាន់ ខ្ពស់ ជំនាន់ ទី ១១ នៃ សាលា ភូមិន្ទ រដ្ឋបាល ត្រូវ យក ចំណេះដឹង និង បទពិសោធន៍ របស់ ខ្លួន ទៅ បម្រើ ជាតិ មាតុភូមិ ឱ្យ កាន់តែ មាន ការរីកចម្រើន ថែម ទៀត ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ថ្លែង ជំរុញ យ៉ាង ដូចនេះ នា ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២១ ក្នុង ឱកាស អញ្ជើញ ធ្វើបាឋ កថា តាម អនឡាញ ជូន ដល់ កម្មសិក្សា ការី និង សិស្ស មន្ត្រី ជាន់ ខ្ពស់ ជំនាន់ ទី ១១ នៃ សាលា ភូមិន្ទ រដ្ឋបាល និង ដោយ មាន ការអញ្ជើញ ចូលរួម ពី ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ ពាក់ព័ន្ធ របស់ ក្រសួង ជាច្រើន រូប ផងដែរ ។
បាឋ កថា នេះ ដែរ ធ្វើឡើង ដើម្បី ចែករំលែក នូវ ព័ត៌មាន ពាក់ព័ន្ធ ទៅនឹង ការកែទម្រង់ ស៊ីជម្រៅ ក្នុង វិស័យ សាធារណការ និង ដឹកជញ្ជូន ដើម្បីឱ្យ ពួកគាត់ បាន យល់ ច្បាស់ អំពី ទិសដៅ ក៏ ដូចជា ចក្ខុវិស័យ របស់ ក្រសួង និង ត្រៀមខ្លួន រួច ជាស្រេច ដើម្បី ចូលរួម សហការ អនុវត្ត ប្រកបដោយ ឆន្ទៈ ខ្ពស់ ។
លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន បន្ថែម ថា ក្រសួង ក៏ បាន ទិញ គ្រឿងចក្រ ទំនើប ៗ ដែល មិន ធ្លាប់ មាន ជូន ដល់ មន្ទីរ រាជធានី - ខេត្ត ទាំង២៥ ដើម្បី ពង្រឹង ប្រសិទ្ធភាព ការងារ សាងសង់ ថែម ទៀត ដោយ ហេតុ ថា ក្រសួង មិន ទទួលយក ផ្លូវ ធ្វើ មុខ ខូច ក្រោយ ធ្វើ ក្រោយ ខូច មុខ ឬ ចាក់ ស្ដើង ស៊ី ក្រាស់ ចាក់ ក្រាស់ ស៊ី ស្ដើង ទៀត ឡើយ ពោលគឺ ត្រូវ ធ្វើ ផ្លូវ ឱ្យ មាន គុណភាព តាម ស្តង់ដា បច្ចេកទេស និង សៀវភៅ បន្ទុក ។
ទាក់ទង នឹង វិស័យ ដឹកជញ្ជូន លោក ទេសរដ្ឋមន្ត្រី ស៊ុន ចាន់ថុល បាន ឱ្យដឹង ដែរ ថា ក្រសួង បាន ប្រើប្រាស់ យន្តការព័ត៌មានវិទ្យា ដើម្បី ធ្វើ ទំនើបកម្ម សេវា សាធារណៈ ដូច ជា៖ ការចុះបញ្ជី យានជំនិះ ការប្ដូរ និង ពន្យារ បណ្ណ បើកបរ ការស្នើសុំ ត្រួតពិនិត្យ លក្ខណៈ បច្ចេកទេស យានជំនិះ និង ការប្រឡង យក បណ្ណ បើកបរ តាម អនឡាញ ក៏ ដូចជា បង្កើត កម្មវិធី ព័ត៌មានវិទ្យា នានា ឱ្យ ស្រប តាម ការរីកចម្រើន ផ្នែក ព័ត៌មានវិទ្យា របស់ សកលលោក ផងដែរ ។
បង្រ្កាប រថយន្ត ដឹក ឈើ កែច្នៃ ខុស ច្បាប់ ជាច្រើន គ្រឿង នៅ ផ្លូវ ជាតិ លេខ ៦២ ជាប់ ព្រំប្រទល់ ខេត្ត ព្រះវិហារ និង ខេត្ត កំពង់ធំ
( ព្រះវិហារ ) ៖ មន្ត្រី ជំនាញ ខេត្ត ព្រះវិហារ បាន ចុះបង្ក្រាប រថយន្ត ដឹកជញ្ជូន ឈើ កែច្នៃ និង រថយន្ត ដឹក គ្រឿង សង្ហារឹម កែច្នៃ ខុស ច្បាប់ ជាច្រើន នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៦២ ភូមិ អូរ ពោធិ ក្នុង ឃុំ រម្មណីយ៍ ស្រុក រវៀង ខេត្ត ព្រះវិហារ ។
ប្រតិបត្តិការ បង្រ្កាប រថយន្ត ដឹកជញ្ជូន ឈើ និង គ្រឿងសង្ហារឹម កែច្នៃ ដោយ ខុស ច្បាប់ នេះ បាន ធ្វើឡើង នៅ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២១ ក្រោម ការដឹកនាំ បញ្ជា ពី លោក វុធ សាវី ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ព្រះវិហារ ។
លោក វុធ សាវី បាន ថ្លែង ប្រាប់ ភ្នាក់ងារ ព័ត៌មាន Fresh News នៅ ព្រឹក ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ នេះ ថា ដោយ មាន ការសម្របសម្រួល និង ណែនាំ ពី លោក ទី សុវិន ថាល់ ព្រះរាជអាជ្ញា ខេត្ត ព្រះវិហារ . លោក បាន ដឹកនាំ កម្លាំង រដ្ឋបាល ព្រៃឈើ និង កម្លាំង បរិស្ថាន ចុះបង្រ្កាប ការដឹកជញ្ជូន ឈើ និង គ្រឿងសង្ហារឹម កែច្នៃ ដោយ ខុស ច្បាប់ បាន ជាច្រើន រថយន្ត ។
លោក ព្រះរាជអាជ្ញា រង បាន បញ្ជាក់ ថា វត្ថុតាង ដូចជា រថយន្ត ឈើ និង វត្ថុ មួយចំនួន ទៀត ត្រូវបាន បញ្ជូន ទៅ ចាត់ការ តាម ច្បាប់ ឱ្យ បាន តឹងរឹង ក្នុង គោលបំណង ចូលរួម អភិរក្ស ព្រៃឈើ កុំ ឱ្យ មាន ការកាប់បំផ្លាញ និង មាន ការទិញ ដូរ ពី ក្រុម ឈ្មួញ តទៅទៀត ពិសេស បង្រ្កាប អ្នកទិញ តែម្តង ។
លោក សង្កត់ធ្ងន់ ថា ក្នុង ប្រតិបត្តិការ នេះ មាន អ្នក អន្តរាគមន៍ ច្រើន ណាស់ តែ លោក មិន ស្តាប់ ទេ ផ្ទុយទៅវិញ គឺ ត្រូវតែ អនុវត្ត ទៅតាម ច្បាប់ ជាដាច់ខាត ៕ នគរបាល ការពារ ព្រំដែន គោក ៨១៥ ទទួល ពលករ ខ្មែរ ២៧ នាក់ ទើប ត្រឡប់ ពី ថៃ និង បញ្ជូន ទៅ ធ្វើចត្តាឡី ស័ក
( បន្ទាយមានជ័យ )៖ ក្នុង កំឡុង ពេល ប្រទេស ថៃ កំពុង មាន សន្ទុះ កើនឡើង នៃ ការឆ្លង ជំងឺ កូវីដ១៩ ក្នុង សហគមន៍ ដែល បង្កឱ្យ មាន ការភ័យខ្លាច នោះ ធ្វើឱ្យ ពលករ ខ្មែរ ជាច្រើន ត្រូវ បង្ខំ ចិត្ត ត្រឡប់មក ស្រុក កំណើត វិញ កម្លាំង នគរបាល ការពារ ព្រំដែន គោក វរ លេខ ៨១៥ នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត បន្ទាយមានជ័យ ឈរ ជើរ នៅ តាម បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ បាន រៀបចំ ទទួល ពលករ ខ្មែរ ចំនួន ២៧ នាក់ បន្ថែម ទៀត រួច បញ្ជូន ទៅ ធ្វើចត្តាឡី ស័ក តាម វិធាន សុខាភិបាល នៅ ស្រុក ម៉ាឡៃ ។
លោក វរសេនីយ៍ ឯក សួង សៅ មេបញ្ជាការវរសេនា តូច ការពារ ព្រំដែន គោក លេខ ៨១៥ បាន ឱ្យដឹង ថា ដោយ មាន ការយកចិត្តទុកដាក់ ពីសំណាក់ ឧត្តមសេនីយ៍ ទោ សិទ្ធិ ឡោះ ស្នងការ នគរបាល ខេត្ត លោក បាន ចាត់ ឱ្យ កម្លាំង ក្រោម ឱវាទ រៀបចំ ចាត់ចែង តាម ភារកិច្ច រៀង ៗ ខ្លួន ដើម្បី នាំ ពលករ ខ្មែរ ទាំងអស់ ដែល វិលត្រឡប់ មកពី ប្រទេស ថៃ វិញ ដើម្បី បញ្ជូន ទៅកាន់ មណ្ឌល ធ្វើចត្តាឡី ស័ក តាម វិធាន សុខាភិបាល ឱ្យ បាន ខ្ជាប់ខ្ជួន ។
លោក វរសេនីយ៍ ឯក សួង សៅ បាន បន្ត ថា កម្លាំង នគរបាល ជំនាញ បាន រៀបចំ និង ត្រៀម កម្លាំង តាម ខ្សែ បន្ទាត់ ព្រំដែន ដោយ រង់ចាំ ទទួល ពលករ ខ្មែរ ដែល បាន ប្រាប់ មុខ ស្រុក កំណើត វិញ ក្នុង នោះ កម្លាំង ឈរជើង នៅ ចំណុច នគរបាល ការពារ ព្រំដែន ប៉ុស្តិ៍ ចំបក់ ក្នុង ភូមិ បឹង បេង ឃុំ បឹង បេង ស្រុក ម៉ាឡៃ ។
លោក ថា លោក អនុ សេនីយ៍ ឯក ប៉ុន គុណ នាយ ប៉ុស្ពិ៍ វរសេនា តូការពារ ព្រំដែន គោក លេខ ៨១៥. លោក វរសេនីយ៍ ត្រី មាស ម៉េង ហ៊ួង មេបញ្ជាការ រង នគ ការពារ ព្រំដែន គោក ៨១៥ . លោក អនុ សេនីយ៍ ឯក អ៊ុន វណ្ណៈ នាយ ប៉ុស្ពិ៍ រដ្ឋា បាល ឃុំ បឹង បេង និង ផ្នែក យោធា សឹង រង ស្រុក ម៉ាឡៃ បាន សហការ គ្នា កាលពី យប់ ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២១ ទទួល ពលករ ខ្មែរ ដែល អាជ្ញាធរ ថៃ ចាប់ បញ្ជួន ពួកគាត់ មក តាម ច្រក របៀង របស់ ប៉ុស្តិ៍ ចំបក់ នគបាល ការពារ ព្រំដែន គោក វរសេនា តូច ៨១៥ ។
បើ តាម របាយការណ៍ របស់ សមត្ថកិច្ច បាន ឱ្យដឹង ថា ពលករ ខ្មែរ ចំនួន ២៧ នាក់ ក្នុង នោះ មាន ស្ត្រី ១០នាក់ និង កុមារ ៤នាក់ ។
សមត្ថកិច្ច បាន ឱ្យដឹង ទៀត ថា បន្ទាប់ពី បាន ទទួល ពលករ ខ្មែរ រួច មក លោក អនុ សេនីយ៍ ឯក ប៉ុន គុណ បាន អប់រំ ណែនាំ ពួកគាត់ ចំពោះ បញ្ហា ជំងឺ កូវីដ១៩ ដែល កំពុង មាន សន្ទុះ ឆ្លង រីករាលដាល ក្នុង សហគមន៍ នៅ ប្រទេស ថៃ និង សូម ប្រជាពលរដ្ឋ អនុវត្តន៍ តាម ការណែនាំ របស់ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង សុខាភិបាល ។ បន្ទាប់ពី ធ្វើ ការអប់រំ ណែនាំ រួច ពលករ ខ្មែរ ទាំង ២៧ នាក់ ត្រូវបាន បញ្ជួន ទៅ មណ្ឌល ចត្តាឡី ស័ក ក្នុង ស្រុក ម៉ាឡៃ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ៕
លោក ឃួង ស្រេង៖ រាជធានី ភ្នំពេញ គ្មាន ការកាប់ ដើមឈើ ទេ មាន តែ ដាំ បន្ថែម ( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ បាន បញ្ជាក់ យ៉ាង ច្បាស់ ថា នៅ រាជធានី ភ្នំពេញ គ្មាន ការកាប់ ដើមឈើ យក ចេញ ទេ មាន តែ ការដាំ ថ្មី បន្ថែម ដើម្បីឲ្យ ទីក្រុង ក្លាយជា ទីក្រុង មាន ពណ៌ បៃតង មាន បរិស្ថាន ល្អ ។
ការសម្រេច បែប នេះ បាន ធ្វើឡើង ខណៈ ដែល លោក ឃួង ស្រេង ដឹកនាំ មន្ត្រី ជំនាញ និង អាជ្ញាធរ ខណ្ឌ ចុះ ពិនិត្យមើល ស្ថានភាព ដើមឈើ ទាំង៣ ដើម នា ព្រឹក ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ នេះ ។
ក្នុង ដំណើរ នៃ ការចុះ ពិនិត្យ ដើមឈើ នេះ លោក ឃួង ស្រេង បាន បញ្ជាក់ ថា ដើមឈើ ទាំង៣ ដើម នេះ មិន ត្រូវបាន កាប់ ចេញ នោះ ទេ ដោយសារ វា អាច នៅ បន្ត ឈរ ទៀត បាន ។ តែ លោក បាន បញ្ជា ឲ្យ មន្ទីរ បរិស្ថាន មន្ទីរ កសិកម្ម និង មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ សហការ គ្នា មើល ថែ ដោយ ធ្វើ បាន ត្រឹមតែ លះ មែក ឬ កាត់ មែក ដែល ស្អុយ ចេញ បាន ចំណែក ដើមឈើ ទាំងមូល ត្រូវ ធ្វើ ជើង ទម្រ ទប់ ដើម ដើម្បី កុំ ឲ្យ រំលំ បង្ក គ្រោះថ្នាក់ ដល់ ប្រជាពលរដ្ឋ ។
លោក សំ សាមុត ប្រធាន អង្គភាព សួនច្បារ និង រុក្ខជាតិ នៃ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន រាជធានី ភ្នំពេញ បាន ឱ្យដឹង កាលពី ថ្ងៃ៨ ខែមករា កន្លងមក នេះ ហើយ ថា ដើមឈើ ធំ ៗ នៅ សួន កាណាឌីយ៉ា . មុខ ពេទ្យ ព្រះអង្គ ឌួង មាន ចំនួន ប្រមាណ ៥០ ដើម ហើយ ក្នុង ចំនួន ដើមឈើ ធំ ៗ ទាំងនេះ អាជ្ញាធរ ដោយ មាន ការឯកភាព ពី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន យក ចេញ និង ដាំ ដើមឈើ ថ្មី ជំនួស វិញ ដោយសារតែ ដើមឈើ ចំនួន ៣ដើម នេះ ពុក គល់ ប្រហោង ក្នុង ដើម្បី កុំ ឲ្យ គ្រោះថ្នាក់ ដល់ ប្រជាពលរដ្ឋ ជា អ្នកដំណើរ ជា យថាហេតុ ៕
ក្រសួង ការងារ ជូនដំណឹង ស្តីពី ការបើក ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ លើក ទី ៤៦ ជូន កម្មករ និយោជិត ដែល ត្រូវបាន ព្យួរ កិច្ចសន្យា ការងារ
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ នា ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការបើក ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ លើក ទី ៤៦ ជូន កម្មករ និយោជិត ដែល ត្រូវបាន ព្យួរ កិច្ចសន្យា ការងារ ស្រប តាម ស្មារតី នៃ កញ្ចប់ វិធានការ របស់ រាជ រដ្ឋាភិបាល ។
សេចក្តីជូនដំណឹង របស់ ក្រសួង ការងារ បាន បញ្ជាក់ ថា ការបើក ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ លើក ទី ៤៦ នេះ មាន កម្មករ និយោជិត សរុប ចំនួន ២. ៣២៨នាក់ នៅ រោងចក្រ - សហគ្រាស ចំនួន ២៧ ក្នុង វិស័យ កាត់ដេរ និង វិស័យ ទេសចរណ៍ ៕
លោកស្រី រដ្ឋលេខាធិការ បាន បន្ត ថា៖ ក្រោយពេល វះកាត់ ហើយ ក្រុម គ្រូពេត្យ ក៏ បាន យក សំណាក ស្រ្តី ខាងលើ ទៅ ពិនិត្យមើល នៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ ដោយ លទ្ធផល គឺ គាត់ អវិជ្ជមាន ជំងឺ កូវីដ១៩ ផងដែរ ៕
( ព្រះសីហនុ) ៖ ក្រោយ យល់ដឹង ពី ផ្លូវ ច្បាប់ នោះ ប្រជាពលរដ្ឋ ចំនួន ៩គ្រួសារ ដែល លួច សាងសង់ ខ្ទម នៅលើ ដី របស់ លោកស្រី ខៃ ណារិន មេបញ្ជាការ រង កងពល តូច លេខ ៧០ បាន ចេញមក សារភាព ពី កំហុស របស់ ខ្លួន ក្រោយ បាន ទិញ ដីត ពី មនុស្ស មួយ ក្រុម ដែល បាន យក ដី របស់ លោកស្រី ទៅ លក់ដូរ ។
ប្រជាពលរដ្ឋ ទាំង ៩គ្រួសារ នេះ បាន ថ្លែង ថា ពួកគាត់ ពិតជា បាន ទិញ ត ពី មនុស្ស មួយ ក្រុម ដែល បាន លួច លក់ ដី របស់ លោកស្រី ហើយ ការទិញ ត គ្នា នេះ មិន មាន ឯកសារ ត្រឹមត្រូវ ទទួលស្គាល់ ពី អាជ្ញាធរ និង មន្រ្តី ជំនាញ នោះ ឡើយ ។ សូម បញ្ជាក់ ថា ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ នេះ លោកស្រី ខៃ ណារិន មេបញ្ជាការ រង កងពល តូច លេខ ៧០ ត្រូវបាន បណ្តាញ សង្គម មួយ ចំនួន ធ្វើ ការផ្សាយ ចោទប្រកាន់ ថា លោកស្រី អាង អំណាច ជា មន្រ្តី យោធា ជាន់ ខ្ពស់ ទៅ រំលោភ យក ដី របស់ ប្រជាពលរដ្ឋ ជាក់ស្តែង ។
ដើម្បី ការពារ ខ្លួន ចំពោះ ការចោទប្រកាន់ នេះ លោកស្រី មេបញ្ជាការ រង កងពល បាន ដាក់ ពាក្យ បណ្តឹង ទៅកាន់ តុលាការ និង សមត្ថកិច្ច ពាក់ព័ន្ធ ។ ក្រោយ ដាក់ ពាក្យ បណ្តឹង នេះ ក្រុម ប្រជាពលរដ្ឋ ដែល បាន លួច មក សាងសង់ នៅលើ ដី របស់ លោកស្រី ចំនួន ៩គ្រួសារ បាន ចេញមក ទទួលស្គាល់ ទោស កំហុស ។ តែ យ៉ាងណា ក៏ដោយ នោះ លោកស្រី ខៃ ណារិន មិន បាន បោះបង់ ការទាមទារ នោះ ឡើយ លោកស្រី សុខចិត្ត ចែកជូន ដី ដល់ ប្រជាពលរដ្ឋ ទាំង ៩គ្រួសារ ដោយ មួយ គ្រួសារ ទទួលបាន ម្នាក់ មួយឡូតិ៍ ទំហំ ៥គុណ ២០ សម្រាប់ ធ្វើ លំនៅដ្ឋាន ទៀតផង ។
សូម បញ្ជាក់ ថា លោកស្រី ឧត្តមសេនីយ៍ ទោ ខៃ ណារិន អាយុ ៦២ ឆ្នាំ មាន តួនាទី ជា មេបញ្ជាការ រង កងពល តូច លេខ ៧០ កាលពី ថ្ងៃទី ៦ ខែមករា ឆ្នាំ ២០២១ បាន ចេញមក ច្រានចោល ចំពោះ ការចោទប្រកាន់ ទាំងឡាយ តាម បណ្តាញ សង្គម និង ព័ត៌មាន មួយចំនួន ដែល បាន ធ្វើ ការចោទប្រកាន់ ខុសពី ការពិត មក លើ លោកស្រី ពាក់ព័ន្ធ នឹង វិវាទ ដីធ្លី មួយ នៅ ឃុំ កែវ ផុស ស្រុក ស្ទឹង ហាវ ខេត្ត ព្រះសីហនុ ។
នៅក្នុង សេចក្តី បំភ្លឺ ជូន សាធារណៈ ជន កាលពី ពេល កន្លងទៅ លោកស្រី ខៃ ណារិន ក៏ បាន លើកឡើង ផងដែរ ថា មាន បុគ្គល មួយ ក្រុម បាន ធ្វើ ការសាងសង់ ផ្ទះ នៅលើ ដី របស់ លោកស្រី ដែល មាន ការទទួលស្គាល់ និង លិខិតស្នាម ត្រឹមត្រូវ ស្ថិត នៅ ភូមិ ឬ ទី២ ឃុំ កែវ ផុស ស្រុក ស្ទឹង ហាវ ព្រមទាំង បាន ដាក់ពាក្យ ប្តឹង ដើម្បី ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ផងដែរ ។
ខាងក្រោម នេះ ជា លិខិត បំភ្លឺ ឯកសារ ពាក់ព័ន្ធ និង សកម្មភាព លួច សាងសង់ រោង នៅលើ ដី របស់ លោក ស្រី៖
ផ្លូវ កៅស៊ូ ប្រភេទ DBST ជាង ៣០ គីឡូ ម៉េត្រ នៅ ស្រុក ព្រៃឈរ និង ស្រុក ស្ទឹងត្រង់ ខេត្ត កំពង់ចាម នឹង បង្ហាញ វត្តមាន នា ពេល ឆាប់ ៗ សម្រាប់ ការធ្វើដំណើរ របស់ ប្រជាពលរដ្ឋ
( កំពង់ចាម ) ៖ អភិបាល ខេត្ត កំពង់ចាម លោក អ៊ុន ចាន់ ដា នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ដឹកនាំ ក្រុមការងារ មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ចុះ ពិនិត្យ ការស្ថាបនា ផ្លូវ ក្នុង ស្រុក ព្រៃឈរ និង ស្រុក ស្ទឹងត្រង់ ។
ការប្រកាស នេះ បាន ធ្វើឡើង ក្រោយ ប្រទេស កម្ពុជា បាន អនុវត្ត យ៉ាង ខ្ជាប់ខ្ជួន លើ បញ្ហា សិទ្ធិ មនុស្ស រួម មាន៖ សិទ្ធិ សេដ្ឋកិច្ច សង្គមកិច្ច វប្បធម៌ សិទ្ធិ របស់ ជន ឬ ក្រុម ជាក់លាក់ ដូចជា ស្ត្រី កុមារ ជន ពិការ ជនជាតិ ភាគី តិច ក្រុម អ្នកស្រឡាញ់ ភេទ ដូចគ្នា រួមទាំង សិទ្ធិ សេរីភាព ការងារ របស់ ពលករ ក៏ ដូចជា សិទ្ធិ សេរីភាព ការជួបជុំគ្នា ការបង្កើត អង្គការ ក្រៅ រដ្ឋាភិបាល បក្ស នយោបាយ សិទ្ធិ សេរីភាព ក្នុង ការបញ្ចេញមតិ រួមទាំង សេរីភាព សារព័ត៌មាន ។ល ។
លោក កែវ រ៉េមី បាន លើកឡើង ថា ប្រទេស កម្ពុជា ក្រោម ដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន មាន ផែនការ ច្បាស់លាស់ លើ ការងារ គោរព សិទ្ធិ មនុស្ស ជាក់ស្តែង បើ ទោះបី កម្ពុជា បាន ជួប វិបត្តិ ជា បន្តបន្ទាប់ ដូច ជា៖ វិបត្តិ រាតត្បាត ជំងឺ កូវីដ - ១៩ . វិបត្តិ គ្រោះ ទឹក ជំនន់ និង គ្រោះមហន្តរាយ ផ្សេង ៗ ទៀត ក្នុង ឆ្នាំ ២០២០ នេះ ក្តី ប៉ុន្តែ កម្ពុជា មិន មាន ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយសារតែ អត់ ស្បៀងអាហារ ឬ ស្លាប់ ដោយសារ ជំងឺ កូវីដ - ១៩ នោះ ទេ ។
លោក កែវ រ៉េមី បាន បញ្ជាក់ ថា បច្ចុប្បន្ន នេះ ប្រទេស កម្ពុជា មិន ទាន់ មាន ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយសារតែ អត់ បាយ ឬ ស្លាប់ ដោយសារតែ ជំងឺ កូវីដ - ១៩ នោះ ទេ ដូច្នេះ នេះ ជា គំរូ មួយ ដែល រាជ រដ្ឋាភិបាល កម្ពុជា បាន ខិតខំ ធ្វើ ការងារ គោរព សិទ្ធិ រស់រាន មាន ជីវិត នេះ យ៉ាង យកចិត្តទុកដាក់ បំផុត ។
ពាក់ព័ន្ធ នឹង ការងារ សិទ្ធិ មនុស្ស ដែល កម្ពុជា សម្រេចបាន ដោយ ជោគជ័យ នេះ ដែរ ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា រូប នេះ បាន គូសបញ្ជាក់ បន្ថែម ថា គណៈកម្មាធិការ នឹង ខិតខំ បន្ត ជំរុញ ការងារ របស់ ខ្លួន បន្ថែម ទៀត ពី ឆ្នាំ ចាស់ បន្ត ទៅ ឆ្នាំ ថ្មី ដើម្បី ធ្វើ យ៉ាងណា លើកស្ទួយ វិស័យ សិទ្ធិ មនុស្ស កម្ពុជា ឱ្យ កាន់តែ ល្អ ប្រសើរ បន្ថែម ទៀត ជាដើម ។
ទន្ទឹមនឹង នេះ ដែរ លោក កែវ រ៉េមី បាន លើកឡើង ថា ក្រៅពី នេះ រាជ រដ្ឋាភិបាល កម្ពុជា បាន គិតគូរ យ៉ាង ខ្លាំង ទៅ លើ ស្ថានភាព រស់ នៅ របស់ កម្មករ កម្ម ការិនី ដែល បាន រង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ - ១៩ ដោយ បាន បញ្ចេញ កញ្ចប់ ថវិកា ដើម្បី ជួយ សម្រាល ការលំបាក របស់ ពួកគាត់ ក្រៅពី នេះ នៅ មាន ការជួយ ដល់ ស្ត្រី សម្រាល កូន និង ប្រជាពលរដ្ឋ រងគ្រោះ ទូទាំង ប្រទេស ។
ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន បន្ថែម ថា សិទ្ធិ រស់រាន មាន ជីវិត គឺ រឿង សំខាន់ បំផុត សម្រាប់ មនុស្ស ទាំងឡាយ ដូច្នេះ តាមរយៈ វិធានការ យ៉ាង តឹងរ៉ឹង បំផុត របស់ សម្តេច តេជោ ហ៊ុន សែន លើ កិច្ចការងារ ជួយ អាយុជីវិត របស់ ប្រជាពលរដ្ឋ ។ សម្រាប់ ឆ្នាំ ២០២០ កន្លងមក នេះ ប្រទេស កម្ពុជា ក៏ បាន ជួបប្រទះ បញ្ហា គ្រោះ ទឹក ជំនន់ រាជ រដ្ឋាភិបាល បាន បញ្ចេញ កញ្ចប់ ថវិកា ដើម្បី ជួយ ដល់ ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយសារ ទឹក ជំនន់ ទាំងនេះ ហើយ គឺជា ការគោរព សិទ្ធិ មនុស្ស យ៉ាង ខ្លាំង ផងដែរ ៕
សម្ដេច តេជោ ហ៊ុន សែន បាន បញ្ជាក់ ថា « អនុក្រឹត្យ នេះ កំណត់ អំពី វិធាន និង នីតិវិធី នៃ ការអនុវត្ដ ប្រាក់ បេសកកម្ម នៅក្នុង ប្រទេស និង ក្រៅ ប្រទេស ដើម្បី លើកកម្ពស់ ប្រសិទ្ធភាព ភាពសក្ដិសិទ្ធិ តម្លាភាព និង គណនេយ្យភាព នៃ ការបំពេញ បេសកកម្ម នៅក្នុង ប្រទេស និង ក្រៅ ប្រទេស របស់ ថ្នាក់ដឹកនាំ មន្ដ្រីរាជការ សាធារណៈ និង មន្ដ្រី ជាប់ កិច្ចសន្យា នៃ ក្រសួង ស្ថាប័ន អង្គភាព រដ្ឋបាល ថ្នាក់ ជាតិ និង រដ្ឋបាល ថ្នាក់ ក្រោម ជាតិ នៃ កម្ពុជា » ។
សម្ដេច តេជោ ហ៊ុន សែន បាន បន្ថែម ទៀត ថា អនុក្រឹត្យ នេះ មាន វិសាលភាព អនុវត្ត ចំពោះ៖
* សមាជិក រាជ រដ្ឋាភិបាល រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី * រដ្ឋលេខាធិការ អនុ រដ្ឋលេខាធិការ* សមាសភាព ក្រុមប្រឹក្សា រាជធានី ខេត្ត ក្រុង ស្រុក ខណ្ឌ ឃុំ សង្កាត់ * មន្ត្រីរាជការ សាធារណៈ គ្រប់ លំដាប់ថ្នាក់ * ទីប្រឹក្សា ជំនួយការ* មន្ត្រី ជាប់ កិច្ចសន្យា ដែល មាន ការ ទទួលស្គាល់ ជា ផ្លូវការ ពី ក្រសួង មុខងារ សាធារណៈ * ជំនួយការហិរញ្ញវត្ថុ នៃ រដ្ឋបាល ឃុំ សង្កាត់ ៕
ខាងក្រោម នេះ អនុក្រឹត្យ របស់ សម្ដេច តេជោ ហ៊ុន សែន ដែល មាន ខ្លឹមសារ ទាំង ស្រុង៖ លោក ដូណាល់ ត្រាំ យល់ព្រម ដាក់ រដ្ឋធានី វ៉ាស៊ីនតោន ក្នុង ភាពអាសន្ន រហូតដល់ ថ្ងៃទី ២៤ ខែមករា
( វ៉ាស៊ីនតោន ) ៖ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ នៅ ថ្ងៃចន្ទ សប្ដាហ៍ នេះ ( ម៉ោង នៅ វ៉ាស៊ីនតោន ) បាន អនុម័ត ហើយ លើ ការប្រកាស ដាក់ រដ្ឋធានី វ៉ាស៊ីនតោន ឌីស៊ី ក្នុង ភាពអាសន្ន រហូតដល់ ថ្ងៃទី ២៤ ខែមករា ដោយ នឹង គ្របដណ្ដប់ ទាំង ថ្ងៃ ដែល លោក ចូ បៃ ដិន ត្រូវ ស្បថ ចូលកាន់ តំណែង ជា ប្រធានាធិបតី ថ្មី របស់ សហរដ្ឋ អាមេរិក នៅ ថ្ងៃទី ២០ ខែមករា នេះ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួ នៅ ថ្ងៃអង្គារ ទី ១២ ខែមករា ឆ្នាំ ២០២១ ។
គួរ បញ្ជាក់ ថា ការប្រកាស ដាក់ រដ្ឋធានី វ៉ាស៊ីនតោន ក្នុង ភាពអាសន្ន ត្រូវបាន បញ្ជូន ឱ្យ លោក ដូណាល់ ត្រាំ ដោយ អភិបាល លោកស្រី Muriel Bowser ដែល បាន សម្រេច ដាក់ ភាពអាសន្ន លើ រដ្ឋធានី មួយ នេះ រយៈពេល ១៥ ថ្ងៃ បន្ទាប់ពី ក្រុម កុបក រគាំទ្រ លោក ត្រាំ អុក ឡុក ចូល វិមាន សភា កាលពី ថ្ងៃទី ០៦ ខែមករា ដោយ បង្កឱ្យ មាន អំពើហិង្សា និង ភាពចលាចល ផ្ដាច់ ជីវិត មនុស្ស ៥នាក់ ក្នុង នោះ រួម មាន ប៉ូលិស ម្នាក់ ។
ទោះជា យ៉ាង នេះ ក្ដី ការរំពឹង នេះ ក៏ ផ្អែក សំខាន់ លើ កត្តា អាកាសធាតុ ផងដែរ មាន ន័យ ថា ប្រសិនបើ ឆ្នាំ នេះ អាកាសធាតុ ដំណើរការ ល្អ ប្រសើរ ការផលិត អំបិល បាន ច្រើន និង ផ្គត់ផ្គង់ គ្រប់គ្រាន់ ប៉ុន្ដែ បើ អាកាសធាតុ ប្រែល ប្រួល ( ភ្លៀង កក់ខែ ពិសេស ភ្លៀង ចំ តំបន់ ផលិត អំបិល ) នោះ ការផ្គត់ផ្គង់ អំបិល អាស្រ័យ ទៅតាម នោះ ដែរ ។
លោក បាន បន្ដ ថា « ក្នុង ឆ្នាំ នេះ មិន ទាន់ ហ៊ាន ព្យាករណ៍ ច្បាស់លាស់ នោះ ឡើយ ថា អំបិល ក្នុង ស្រុក រ អាច ផលិត និង ផ្គត់ផ្គង់ បាន គ្រប់គ្រាន់ លើ ទីផ្សារ ព្រោះ ការផលិត អំបិល នេះ អាស្រ័យ លើ អាកាសធាតុ ប្រសិនបើ ឆ្នាំ នេះ អាកាសធាតុ អំណោយផល មេឃ រាំង ភ្លៀង ស្រឡះ ល្អ មិន មាន ភ្លៀង កក់ខែ នៃ ការផលិត ( ខែមករា - មីនា ) នោះ អំបិល នឹង ផលិត បាន គ្រប់គ្រាន់ ក្នុង ឆ្នាំ ២០២១ ប៉ុន្ដែ បើ អាកាសធាតុ មិន អំណោយផល ល្អ ទេ មាន ភ្លៀង កក់ខែ ញឹកញាប់ នោះ ការផលិត អំបិល និង ថមថយ ទៅ តាម នោះ ដែរ » ។
លោក បាន បន្ថែម ថា ការផលិត អំបិល ក្នុង ខេត្ត កំពត ពេលណា ភ្លៀង រាំង ល្អ ក្នុង ន្លោះ ខែ មករា . កុម្ភៈ និង មីនា រយៈពេល ៣ខែ នេះ នោះ ការផលិត មាន ច្រើន លើសលុប ប្រើប្រាស់ គ្រប់គ្រាន់ ប៉ុន្ដែ បើ ក្នុង ៣ខែ នេះ មាន ភ្លៀង កក់ខែ ក្នុង ខែ ណាមួយ ឬ ភ្លៀង កក់ខែ ទាំង៣ ខែ នេះ និង ចំ មណ្ឌល ផលិត អំបិល មាន ទឹកភ្លៀង ច្រើន អំបិល នឹង មិន អាច ផលិត បាន ច្រើន នោះ ឡើយ ។
លោក ឲ្យដឹង ទៀត ថា នៅក្នុង ឆ្នាំ ២០២០ ក្នុង ចន្លោះ ខែធ្នូ ចន្លោះ ថ្ងៃទី ១៨ ដល់ ថ្ងៃទី ២៤ អំបិល លក់ អស់ រហូតដល់ ១៣.០០០ តោន ដែល ជា បរិមាណ ដ៏ ច្រើន ប៉ុន្ដែ តម្លៃ មិន សូវ បាន ថ្លៃ នោ ទេ ។ ក្នុង ចន្លោះប្រមាណ ជា កន្លះ ខែ នេះ ការលក់ អំបិល បាន ច្រើន ដោយសារតែ ចំពេល រដូវ ដែល បងប្អូន ពលរដ្ឋ ធ្វើ ត្រី ប្រហុក ផ្អក ។
លោក បាន បន្ថែម ថា ជាទូទៅ ការផ្គត់ផ្គង់ អំបិល លើ ទីផ្សារ មាន ចន្លោះ ១០ម៉ឺន តោន ក្នុង មួយ ឆ្នាំ ។ និយាយ ចំពោះ ឆ្នាំ នេះ អំបិល មាន តម្លៃ ធូរ ថ្លៃ មែនទែន ដោយសារតែ ផលិត អំបិល បាន ច្រើន ជាង ឆ្នាំ មុន ។
ងាក ក្រឡែក ទៅ មើល ការផលិត អំបិល ក្នុង សហគ្រាស ឯកជន វិញ ក៏ ឃើញ ថា ដើម ឆ្នាំ នេះ ការផលិត អំបិល កំពុងតែ ដំណើរការ ផងដែរ ។
កញ្ញា ថូង ធី ដា ស្ថាបនិក សហគ្រាស ផលិត អំបិល ថូង អ៊ិនធ័រ ប្រាយស៍ បាន ឲ្យដឹង ថា ក្នុង ឆ្នាំ នេះ សហគ្រាស ផលិត អំបិល ថូង អ៊ិនធ័រ ប្រាយស៍ ទើប ដំណើរការ ក្នុង ការផលិត អំបិល ដូច្នេះ មិន អាច សន្និដ្ឋាន ច្បាស់លាស់ បាន ទេ ថា តើ ក្នុង ឆ្នាំ នេះ អាច ផលិត បាន ប៉ុន្មាន តោន នោះ ឡើយ ប៉ុន្ដែ ជា ការប៉ាន់ស្មាន អាចនឹង ផលិត បាន ២ម៉ឺន តោន ក្នុង មួយ ឆ្នាំ ។
កញ្ញា បន្ដ ថា សម្រាប់ ការចែកចាយ អំបិល របស់ សហគ្រាស ផលិត អំបិល ថូង អ៊ិនធ័រ ប្រាយស៍ លើ ទីផ្សារ មាន តម្លៃ ខ្ពស់ ជាង គេ បន្ដិច ។ ជាទូទៅ សហគ្រាស បាន ចែកចាយ លើ ទីផ្សារ បាន ចំនួន ៣- ៥តោន ក្នុង ១ខែ សម្រាប់ អំបិល ល្អ ព្រី មៀម និង អំបិល ធម្មតា បាន ១០ - ២០តោន ក្នុង ១ខែ ។
ក្រសួង កសិកម្ម ប្រកាស ដាក់ ភូមិ មួយ នៃ ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ជា តំបន់ ផ្ទុះ ជំងឺ ផ្កា សាយ បក្សី ក្រោយ សត្វ មាន់ កសិករ ងាប់ ជា បន្តបន្ទាប់
( ភ្នំពេញ ) ៖ ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ចេញ ប្រកាស ស្ដីពី ការកំណត់ តំបន់ ជំងឺ ផ្កា សាយ បក្សី ក្រោយ ផ្ទុះ ជំងឺ នេះ ក្នុង ភូមិ ព្រែក តា ច្រែង ឃុំ ព្រែក នរិន្ទ ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ។
សេចក្តីប្រកាស ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន នៅ ថ្ងៃទី ១២ ខែមករា នេះ ក្រសួង កសិកម្ម បាន ណែនាំឲ្យ អគ្គ នាយកដ្ឋាន សុខភាព សត្វ និង ផលិតកម្ម សត្វ ត្រូវ ចាត់ វិធានការបព្យាបាល នៅ តំបន់ ផ្ទុះ ជំងឺ ផ្តាសាយ បក្សី ដូច ខាងក្រោម៖
តាម ប្រព័ន្ធ ទិន្នន័យ គ្រឺះ ភូត គាម អនាម័យ នៃ អគ្គ នាយកដ្ឋាន កសិកម្ម បាន បញ្ជាក់ ឲ្យដឹង ថា ពេញ មួយ ឆ្នាំ ២០២០ កន្លងទៅ នេះ កម្ពុជា បាន នាំចេញ ផ្លែ ក្រូចឆ្មារ ចំនួន ២. ៣០០តោន មាន កំណើន ១០០ ភាគរយ និង ផ្លែ ក្រូច ថ្លុង ចំនួន ១៧.៤០០ តោន មាន កំណើន ១០០ ភាគរយ បើ ប្រៀបធៀប នឹង ឆ្នាំ ២០១៩ ។
លោក រដ្ឋមន្ដ្រី វេង សា ខុន បាន ឲ្យដឹង ទៀត ថា ការចាប់ផ្ដើម នាំចេញ ក្រូចឆ្មារ និង ក្រូច ថ្លុង វា នឹង ជួយ ជំរុញ កំណើន សេដ្ឋកិច្ច មួយ កម្រិត បន្ថែម ទៀត ហើយ នៅ ពេល ដែល មាន ការនាំចេញ នេះ នឹង ធ្វើឲ្យ ប្រជាពលរដ្ឋ កាន់តែ មាន ទឹកចិត្ដ ផុល ផុស ក្នុង ការដាំ បន្ថែម ទៀត ។
រដ្ឋមន្ដ្រី កសិកម្ម បាន ថ្លែង ទៀត ថា « នេះ ជា ឱកាស មាស របស់ ប្រជាជន ដែល ប្រទេស មួយចំនួន ជួប បញ្ហា យើង មាន ឱកាស ល្អ ក្នុង ការផលិត ហើយ នេះ ជា អ្វី ដែល យើង ឆ្លើយតប ជាមួយនឹង សម្ដេច តេជោ ហ៊ុន សែន ដែល មាន ប្រសាសន៍ កន្លងទៅ ក្នុង ការផ្ដល់ អនុសាសន៍ ឲ្យ ប្រជាជន ចេះ ចាប់ យក ឱកាស មាស កំឡុង កូវីដ - ១៩ » ។
ដោយឡែក ផ្ទៃដី ដាំដុះ ផ្លែ ក្រូចឆ្មារ មាន សរុប ចំនួន ១. ២៥៣ ហិកតា និង ផ្ទៃដី ប្រមូល ផល មាន សរុប ចំនួន ៨៤៥ ហិកតា ។ ក្នុង នោះ ខេត្ត បាត់ដំបង គឺជា ខេត្ត មួយ ក្នុង ចំណោម ខេត្ដ ដទៃ ទៀត ដែល មាន ផ្ទៃដី ដាំដុះ ច្រើន ជាង គេ សរុប ចំនួន ១៣៨ ហិកតា ៕
( កំពង់ឆ្នាំង ) ៖ ករណី គ្រោះថ្នាក់ ចរាចរណ៍ ដែល បង្កឡើង ដោយ នាយក សាលា ពល ទាហាន យោធ ភូមិភាគ ពិសេស ដោយ រថយន្ត របស់ គាត់ បុក ម៉ូតូ ពលរដ្ឋ មួយ គ្រួសារ នៅលើ កំណាត់ ផ្លូវ ជាតិ លេខ ៥ បណ្តាលឲ្យ ស្លាប់ កូន តូច អាយុ ៣ឆ្នាំ ម្នាក់ និង រងរបួស បាក់ ជើង ឪពុក យ៉ាង ធ្ងន់ធ្ងរ កាលពី ថ្ងៃទី ២៩ ខែវិច្ឆិកា ឆ្នាំ ២០២០ កន្លងទៅ នៅ មិន ទាន់ បាន ដោះស្រាយ នោះ ទេ ហើយ ជនរងគ្រោះ ទាំង ម្តាយ និង ឪពុក នៅតែ ទទូច ឲ្យ ជន បង្ក ជា មន្រ្តី យោធា ជាន់ ខ្ពស់ រូប នេះ ចេញមក ទទួលខុសត្រូវ និង ផ្តល់ សំណង ជូន ដល់ ក្រុមគ្រួសារ របស់ ខ្លួន ។
ដោយឡែក ប្ដី របស់ គាត់ ក៏ បាន រងគ្រោះ បាក់ ជើង ខាងឆ្វេង ត្រូវបាន បញ្ជូន ទៅ សង្គ្រោះ នៅ មន្ទីរពេទ្យ ព្រះកេតុ មាលា នៅឯ ទីក្រុង ភ្នំពេញ រយៈពេល ៤យប់ ៤ ថ្ងៃ ទើប ចេញ ពី មន្ទីរពេទ្យ មក ព្យាបាល នៅ ផ្ទះ វិញ មកដល់ បច្ចុប្បន្ន នេះ ប្ដី របស់ គាត់ មិន ទាន់ ជាសះស្បើយ ដើរ បាន នៅឡើយ ទេ គឺ ដេក នៅតែ លើ គ្រែ មួយ កន្លែង តែ ប៉ុណ្ណោះ ។
ដូច្នេះ របាយការណ៍ របស់ សមត្ថកិច្ច ទាំងអស់ គឺជា ឯកសារ ផ្លូវការ ដោយ មាន ការចុះហត្ថលេខា ទទួលស្គាល់ ពី លោក ឧត្តមសេនីយ៍ ទោ ខូវ លី ស្នងការ នគរបាល ខេត្ត កំពង់ឆ្នាំង ទៀតផង ។ ដូច្នេះ បើ ភាគី ណា មិន ពេញចិត្ត ឬ ក៏ មិន ឯកភាព ជាមួយនឹង របាយការណ៍ របស់ សមត្ថកិច្ច ជំនាញ នោះ ទេ អស់ លោក មាន សិទ្ធិ ប្ដឹង បាន ។
របាយការណ៍ របស់ លោក វរសេនីយ៍ ឯក ឈឹម សាវុន បាន សង្កត់ធ្ងន់ ទៀត ថា ជន បង្ក មាន ចេតនា គេចវេស មិន ទទួលខុសត្រូវ ផ្នែក ព្រហ្មទណ្ឌ ដោយ បង្ហាញ អត្តសញ្ញា អ្នកបើកបរ មិន ពិតប្រាកដ ថែម ទៀត ផង ៕ មន្រ្តី ក្រសួង សាធារណការ៖ ខេត្ត កំពត ក្លាយជា គោលដៅ ទេសចរណ៍ មួយ យ៉ាង សំខាន់ ដូច្នេះ ទើប គម្រោង មួយចំនួន ត្រូវបាន ក្រសួង បង្វែរ មកកាន់ ខេត្ត នេះ មុន គេ
( កំពត ) ៖ លោក វង្ស ពិសិដ្ឋ អនុ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន លើកឡើង ថា រយៈពេល ចុងក្រោយ នេះ ខេត្ត កំពត ក្លាយជា គោលដៅ ទេសចរណ៍ មួយ យ៉ាង សំខាន់ និង អាច និយាយ បាន ថា ជា គោលដៅ ទេសចរណ៍ លំដាប់ ទី២ នៅក្នុង ប្រទេស បន្ទាប់ពី ខេត្ត សៀមរាប ហើយ លំហូរ ការធ្វើចរាចរ ដឹក ទំនិញ ឆ្លងកាត់ តាម ផ្លូវ នៃ ខេត្ត នេះ ក៏ ច្រើន ជាង ផ្លូវ ជាតិ លេខ ៤។
លោក ថា ហេតុ ដូច្នេះហើយ ទើប គម្រោង មួយចំនួន ត្រូវបាន ក្រសួង បាន បង្វែ មកកាន់ ខេត្ត កំពត មុន ។ ជាក់ស្តែង ដូចជា ការពន្លឿន ការងារ ស្ថាបនា ផ្លូវ ជាតិ លេខ ៣ និង លេខ ២ គឺ សុទ្ធសឹងតែ បម្រើ ដល់ ការងារ ធ្វើ ទេសចរណ៍ និង ការដឹកជញ្ជូន ទំនិញ ចេញ ចូល ឆ្លងកាត់ ខេត្ត កំពត ។
សូម បញ្ជាក់ ថា ដើម្បី បំពេញ តម្រូវការ ពលរដ្ឋ ក៏ ដូចជា ភ្ញៀវ ទេសចរ សម្រួល ការធ្វើដំណើរ កុំ ឲ្យ កកស្ទះ រដ្ឋបាល ខេត្ត កំពត បាន និង កំពុង សាងសង់ ស្ពាន ត្រើយ កោះ ដែល មាន សភាព ចាស់ ទ្រុឌទ្រម និង បាន កំពុង សិក្សា ដាក់ សំណើរ ទៅ រាជ រដ្ឋាភិបាល ដើម្បី សុំ សាងសង់ ស្ពាន ឆ្លងកាត់ ព្រែក កំពង់បាយ មួយ បន្ថែម ទៀត ផងដែរ ។
សូម បញ្ជាក់ ថា កាលពី ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២១ លោក វង្ស ពិសិដ្ឋ និង លោក ជា វ តាយ អភិបាល ខេត្ត កំពត បាន ដឹកនាំ កិច្ចប្រជុំ ពិភាក្សា និង ធ្វើ បទបង្ហាញ វឌ្ឍនភាព ការងារ សម្រាប់ អនុវត្ត គម្រោង សាងសង់ ប្រព័ន្ធ លូ ប្រមូល ទឹក កខ្វក់ ស្ថានីយ៍ អាង ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ និង ប្រព័ន្ធ រំដោះ ទឹកភ្លៀង នៃ គម្រោង អភិវឌ្ឍន៍ ក្រុង របៀង២ ដោយ ចូលរួម ពី អ្នក ពាក់ព័ន្ធ ជាច្រើន រូប ។
បន្ទាប់ពី ស្តាប់ របាយការណ៍ បទ បង្ហាញ និង ពិភាក្សា រួច មក លោក អភិបាល ខេត្ត បាន ឯកភាព និង ផ្តល់ នូវ អនុសាសន៍ និង គោលការណ៍ មួយចំនួន ដូច ខាងក្រោម៖
លោក អភិបាល ខេត្ត ក៏ បាន លើក បញ្ជាក់ ថា ក្រុង កំពត គ្រោង ពង្រីក សួនច្បារ ពី ចំណុច គល់ ស្ពាន ចាស់ ដល់ គល់ ស្ពាន ថ្មី គឺ ត្រួត កន្លែង គ្នា ជាមួយ គម្រោង សាងសង់ ប្រព័ន្ធ លូ ប្រមូល ទឹក កខ្វក់ ស្ថានីយ៍ អាង ប្រព្រឹត្តកម្ម ទឹក កខ្វក់ និង ប្រព័ន្ធ រំដោះ ទឹកភ្លៀង នៃ គម្រោង អភិវឌ្ឍន៍ ក្រុង របៀង ២ របស់ ADB ដែរ ។
ដើម្បី កាត់បន្ថយ ការចំណាយ មិន ចាំបាច់ និង ចំណេញ ពេលវេលា ធានា បាន នូវ អនាម័យ បរិស្ថាន ស្អាត នាំមក នូវ សោភ័ណ្ឌភាព ផាសុខភាព ទាក់ទាញ ទេសចរ ឲ្យ កាន់តែ ច្រើន អាជ្ញា ធារ ខេត្ត ក៏ ដូចជា ជំនាញ បាន សម្រេច ថា នឹង ធ្វើ ការស្ថាបនា គម្រោង ទាំង ពីរ នេះ ព្រម ជាមួយគ្នា តែម្តង ៕ ខ្ទម អនាធិបតេយ្យ ចំនួន ១១ទៀត ដែល លួច សាងសង់ នៅ តំបន់ ឧទ្យាន ជាតិ ស្រុក បូទុម សាគរ ខេត្ត កោះកុង ត្រូវ អាជ្ញាធរ ចុះ រុះរើ ចោល
( កោះកុង ) ៖ ដើម្បី ទប់ស្កាត់ ការកាប់ ទន្ទា្រន និង សង់ ខ្ទម យ៉ាង អនាធិបតេយ្យ នៅលើ ដី រដ្ឋ តំបន់ ឧទ្យាន ជាតិ អាជ្ញាធរ ខេត្ត កោះកុង និង អាជ្ញាធរ ស្រុក បទុម សាគរ បាន ចុះ រុះរើ ខ្ទម ទាំង នេះ បន្ត ទៀត ថា ក្រោយ លួច សាងសង់ ស្ថិត នៅ ឃុំ ថ្ម ស ស្រុក បូទុម សាគរ ខេត្ត កោះកុង ជា ដី ក្នុង តំបន់ ឧទ្យាន ជាតិ ស្រុក បូទុម សាគរ ។
ប្រតិបត្តិការ ចុះ រុះរើស ខ្ទម អនាធិបតេយ្យ ចំនួន ១១ទៀត នេះ បាន ធ្វើឡើង នា ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២១ ដឹកនាំ លោក សុខ សិទ្ធី អភិបាល រង ខេត្ត កោះកុង ក្រោម ការសម្របសម្រួល ពី លោក អេង ចាន់ ភារ៉ា ព្រះរាជអាជ្ញា រង នៃ អយ្យការ អម សាលាដំបូង ខេត្ត ដោយ មាន ការចូលរួម ពី កម្លាំង ចម្រុះ រួម មាន៖ កម្លាំង អាវុធហត្ថ កម្លាំង នគរបាល មន្ទីរ បរិស្ថាន និង អង្គការ សម្ព័ន្ធ សត្វ ព្រៃ ។
លោក សុខ សុទ្ធី បាន ឱ្យដឹង ថា រដ្ឋបាល ខេត្ត បាន ទប់ស្កាត់ មិន អនុញ្ញាតឱ្យ ការកាប់ ទន្ទ្រាន និង សង់ ខ្ទម លើ ដី រដ្ឋ ជា ដី របស់ ឧទ្យាន ជាតិ បន្ត ទៀត ឡើយ ត្រូវតែ អនុវត្ត ច្បាប់ ជាបន្ទាន់ មិន ឱ្យ មាន ការរីករាលដាល បន្ត ទៀត ឡើយ ពីព្រោះ ដី នៅ តំបន់ ហាមឃាត់ នេះ នេះ ជា ដី របស់ ឧទ្យាន ជាតិ ។
លោក សុខ សុទ្ធី បាន បន្ថែម ថា រដ្ឋបាល ខេត្ត និង ស្រុក មុន ចុះ រុះរើ ខ្ទម ទាំង ១១នេះ . អាជ្ញាធរ បាន ហាមឃាត់ ជាច្រើន ដង មក ហើយ ប៉ុន្តែ ពួកគាត់ នៅតែ លួច កាប់ ទន្ទ្រាន សង់ ខ្ទម ជា បន្តបន្ទាប់ ទើប គណៈ បញ្ជាការ ឯកភាព ខេត្ត មាន ចំណាត់ការ នៅ ពេល នេះ តែម្តង ។
លោក បាន បញ្ជាក់ ថា រដ្ឋបាល ខេត្ត ស្រុក នឹង បន្ត ចុះ ត្រួតពិនិត្យ ជាប្រចាំ ទៅ លើ ទីតាំង ខាងលើ នេះ បើ ប្រជាពលរដ្ឋ ។ លោក ថា ចំពោះ ប្រជាពលរដ្ឋ ទាំង ១០គ្រួសារ មិន មាន ដី រស់ នៅ មែន សូម ឱ្យ ពួកគាត់ ដាក់ សំណើរ ចូលមក សាលា ឃុំ សាលា ស្រុក ដើម្បី សុំ ចុះឈ្មោះ សំណើ សុំ ដី សម្បទា សង្គកិច្ច របស់ រដ្ឋ រស់ នៅ ស្រប់ ច្បាប់ ។
លោក សុខ សុទ្ធី បាន លើកឡើង ថា បើ ប្រជាពលរដ្ឋ ទាំង ១០គ្រួសារ មាន ដី ហើយ លក់ អស់ គឺ អាជ្ញាធរ មិន អនុញ្ញាតឱ្យ ចុះឈ្មោះ ដាក់ សំណើរ ឡើយ ។ លោក អភិបាល សូម អំពាវរ នាវ ដល់ ប្រជាពលរដ្ឋ កុំ ជឿ លើ ការញុះ ញុង់ របស់ ជន ខិលខូច មួយចំនួន ដែល បង្ក អសន្តិសុខ ដល់ សង្គម កាប់ ទន្រ្ទាន ដី រដ្ឋ ជា ដី ឧទ្យាន ជាតិ នាំឱ្យ ប្រឈមមុខ ច្បាប់ ៕
ឯក អគ្គ រដ្ឋទូត គុយ បា អរគុណ កម្ពុជា ដែល តែងតែ ជួយ គាំទ្រ ដល់ ប្រទេស គុយ បា ក្នុង វិស័យ ការទូត លើ ឆាក អន្ដរជាតិ
ក្រៅពី អរគុណ កម្ពុជា ហើយ នោះ លោកស្រី បាន អះអាង ថា ប្រទេស គុយ បា នឹង បន្ត កិច្ចសហប្រតិបត្តិការ ជាមួយ ប្រទេស កម្ពុជា លើ វិស័យ ពាក់ព័ន្ធ ផ្សេង ៗ ទៀត ដូចជា វិស័យ កសិកម្ម និង អភិវឌ្ឍន៍ ជនបទ ជាដើម ។
បណ្ឌិត សភាចារ្យ បាន បន្ត ថា កាលពី ឆ្នាំ កន្លងទៅ រដ្ឋាភិបាល គុយ បា បាន គ្រោង អញ្ជើញ សម្ដេច តេជោ នាយក រដ្ឋមន្រ្ដី ទស្សនកិច្ច នៅ ប្រទេស គុយ បា ដើម្បី អបអរសាទរ ខួប លើក ទី ៦០ នៃ ទំនាក់ទំនង ការទូត រវាង ប្រទេស កម្ពុជា - គុយ បា តែ ត្រូវបាន អាក់ខាន ដោយសារ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩ ។
បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន បាន ថ្លែងអំណរគុណ ប្រទេស គុយ បា សារជាថ្មី ម្ដង ទៀត និង បាន ជម្រាប ជូន អំពីមុខងារ របស់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ទន្ទឹម ហ្នឹង នេះ ក៏ បាន ចូល ជាមួយ រាជ រដ្ឋាភិបាល ក៏ ដូចជា ក្រសួង សុខាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ ១៩ ។ ភាគី ទាំង ពី បាន ពិភាក្សា គ្នា និង ប្ដេជ្ញា បន្ត កិច្ចសហប្រតិបត្តិ ឲ្យ កាន់តែ ល្អ ប្រសើ បន្ថែម ទៀត រវាង ប្រទេស ទាំង ពីរ ជាពិសេស លើ វិស័យ អភិវឌ្ឍន៍ ជនបទ ។
សិក្ខាសាលា ឆ្លុះបញ្ចាំង ការអភិវឌ្ឍ សមត្ថភាព សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន នៅ ខេត្ត ពោធិ៍សាត់ ត្រូវបាន បិទ បញ្ចប់
( ពោធិ៍សាត់ )៖ សិក្ខាសាលា ស្តីពី ឆ្លុះបញ្ចាំង ការអភិវឌ្ឍ សមត្ថភាព សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ដែល បាន ដំណើរការ ទៅ មួយ ថ្ងៃ ពេញ តាម កម្មវិធី ដែល បាន គ្រោង ទុក ប្រកប ទៅ ដោយ លទ្ធផល ជា ផ្លែ ផ្កា នៅ សាល ប្រជុំ សាលា ខេត្ត ពោធិ៍សាត់ ត្រូវបាន ធ្វើ ពិធី បិទ បញ្ចប់ កាលពី ល្ងាច ថ្ងៃទី ១១ ខែមករា ឆ្នាំ ២០២១ ក្រោម អធិបតីភាព លោក សំរិទ្ធិ អេង ប្រធាន ក្រុមប្រឹក្សា ក្រុង ពោធិ៍សាត់ ប្រធាន សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គម្រោង ។
អង្គ សិក្ខាសាលា នេះ សហការរៀបចំ ដោយ សមាគម ក្រុមប្រឹក្សា ក្រុង ស្រុក ឃុំ សង្កាត់ នៃ ខេត្ត ពោធិ៍សាត់ . វិទ្យាស្ថាន តស៊ូ មតិ និង គោល នយោបាយ និង អង្គការ អេអេអាក់ស្យុង (Aide et Action) ដោយ បាន ការចូលរួម ពី ថ្នាក់ដឹកនាំ និង លេខា សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន . ប្រធាន សាខា គណៈកម្មាធិការ និង សមាជិក តាម ក្រុង ស្រុក ឃុំ សង្កាត់ . មន្ត្រី លេខាធិការដ្ឋាន . មន្ត្រី គម្រោង និង ប្រធាន អនុប្រធាន និង លេខា សមាគម ៥ ខេត្ត សរុប ប្រមាណ ៧០ រូប ។
ថ្លែង ក្នុង ឱកាស បិទ សិក្ខាសាលា លោក សំរិទ្ធិ អេង ប្រធាន ក្រុមប្រឹក្សា ក្រុង ពោធិ៍សាត់ ប្រធាន សមាគម ក្រុមប្រឹក្សា ថ្នាក់ មូលដ្ឋាន ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គម្រោង បាន ឱ្យដឹង ថា សិក្ខាសាលា រយៈពេល មួយ ថ្ងៃ នេះ បាន ឆ្លុះបញ្ចាំង អំពី សកម្មភាព ដែល បាន អនុវត្ត កន្លងមក រយៈពេល មួយ ឆ្នាំ និង លើក ទិសដៅ សម្រាប់ អនុវត្ត ឆ្នាំ ២០២១ ដោយ ផ្តោយការយកចិត្តទុកដាក់ ទៅ លើ ផែនការ សកម្មភាព របស់ សមាគម និង គម្រោង អភិវឌ្ឍន៍ សមត្ថភាព ស្ថាប័ន និង ការប្រតិបត្តិ របស់ សមាជិក ក្រុមប្រឹក្សា សមាគម ថ្នាក់ មូលដ្ឋាន ។
គួរ បញ្ជាក់ ថា កាលពី ថ្ងៃសុក្រ សប្តាហ៍ មុន គណនី Twitter របស់ លោក ដូណាល់ ត្រាំ ត្រូវបាន បិទ ជា អចិន្ត្រៃយ៍ ដោយសារតែ ការផ្ទុះ អំពើហិង្សា នៅ វិមាន សភា អាមេរិក ។ ក្រោយ ព្រឹត្តិការណ៍ ដ៏ អាក្រក់ នោះ ឥឡូវ ក្រុមហ៊ុន បណ្តាញ សង្គម អាមេរិក កំពុង បង្កើន ការខិតខំ ថែម ទៀត ដើម្បី លុបបំបាត់ មាតិកា ទាំងឡាយ នៅលើ ប្រព័ន្ធ ប្រើប្រាស់ របស់ ពួកគេ ដែល អាច នាំទៅ រក អំពើហិង្សា ដូច ហេតុការណ៍ ដែល បាន កើតឡើង កន្លងមក ៕
គួរ បញ្ជាក់ ថា ខណៈ សហរដ្ឋ អាមេរិក កំពុង បន្ត ការចាក់ វ៉ាក់សាំង ទៅដល់ បុគ្គលិក សុខាភិបាល និង ប្រជាជន ដែល ប្រឈមមុខ ខ្លាំង បំផុត នោះ លោក ចូ បៃ ដិន ដែល នឹង ត្រូវ ស្បថ ឡើង កាន់ តំណែង ប្រធានាធិបតី អាមេរិក ជា ផ្លូវការ នៅ ថ្ងៃទី ២០ ខែមករា ឆ្នាំ ២០២១ ធ្លាប់ បាន លើកឡើង ដែរ ថា លោក នឹង ប្រើ ពេល ១០០ ថ្ងៃ ដើម្បី ទប់ទល់ ការឆ្លង រាតត្បាត វីរុស កូរ៉ូណា ក្នុង នោះ មាន ដូចជា ការតម្រូវ ឲ្យ ពាក់ ម៉ាស ទូទាំង ប្រទេសជាដើម ៕
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ផលិត វីដេអូ របាយការណ៍ សង្ខេប ស្តីពី វឌ្ឍនភាព ការងារ ប្រមូល ចំណូល ពន្ធ បាន ២ ៨៨៩ លាន ដុល្លារ នៅ ឆ្នាំ ២០២០ ។
គួរ បញ្ជាក់ ថា រដ្ឋបាល អតីត ប្រធានាធិបតី អាមេរិក លោក បារ៉ាក់ អូបាម៉ា ធ្លាប់ បាន ដក គុយ បា ចេញ ពី បញ្ជី ខ្មៅ នៃ ប្រទេស គាំទ្រ ភេរវកម្ម កាលពី ឆ្នាំ ២០១៥ ក្នុង គោលបំណង ស្ដារ ឡើងវិញ នូវ ទំនាក់ទំនង ការទូត រវាង ប្រទេស ទាំង២ ។ តែ ក្រោយ លោក ត្រាំ ឡើង កាន់ តំណែង ជា ប្រធានាធិបតី ចាប់តាំង ឆ្នាំ ២០១៦មក លោក បាន លុបចោល នយោបាយ របស់ លោក អូបាម៉ា ជាច្រើន ចំពោះ គុយ បា ហើយ លោក ក៏ បាន ដាក់ទណ្ឌកម្ម លើ គុយ បា ឡើងវិញ ផងដែរ ៕
លោក រដ្ឋមន្ត្រី បាន បន្ត ថា កំណើន សេដ្ឋកិច្ច បាន ក្លាយជា ដើម ចម មួយ យ៉ាង សំខាន់ នៃ ដំណើរការវិវត្តន៍ រីកចម្រើន កម្រិត ជីវភាព របស់ ប្រជាពលរដ្ឋ បាន ធ្វើឲ្យ ប្រជាពលរដ្ឋ ចាប់អារម្មណ៍ គិតគូរ ពី ការរស់នៅ ស្អាត បញ្ហា សុខភាព និង មាន និន្នាការ ប្រកាន់ យក របប អាហារ មួយ មាន គុណភាព និង សុវត្ថិភាព ជាពិសេស បន្លែ ផ្លែ ឈើ និង ត្រី សាច់ ។
អ្នក ជាសះស្បើយ ទាំង ២នាក់ នេះ គឺជា ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ៣៦ ឆ្នាំ ស្នាក់ នៅ ឃុំ បឹង រាំង ស្រុក កំរៀង ខេត្ត បាត់ដំបង បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២០ និង ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ៣៣ ឆ្នាំ ស្នាក់ នៅ ឃុំ ស្ទឹង កាច់ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ។ ស្ត្រី ទាំង២នាក់ នេះ ត្រូវបាន ព្យាបាល ជាសះស្បើយ និង ត្រូវបាន អនុញ្ញាតឲ្យ ចេញ ពី មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ៧៖០០ នាទី ព្រឹក ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ នេះ កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង ជំងឺ កូវីដ១៩ សរុប ចំនួន ៣៩២ នាក់ ក្នុង នោះ អ្នក ព្យាបាល ជាសះស្បើយ ចំនួន ២៧៦ នាក់ និង អ្នកជំងឺ កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ១៦នាក់ ៕
លោក ងួន ឡាយ បាន ឲ្យដឹង ទៀត ថា « សម្រាប់ ចុង ឆ្នាំ ២០២០ និង ដើម ឆ្នាំ ២០២១ នេះ ឃើញ ថា កសិករ ខ្នាត តូច ធំ ទាំងអស់ ដែល ស្ថិត នៅក្នុង សមាគម គឺ សុទ្ធសឹងតែ មាន ដៃគូ រួចហើយ ដែរ ដូច្នេះ ម្រេច នៅពេល ខាងមុខ ទៀត នឹង មាន ស្ថានភាព ល្អ ព្រោះថា យើង មាន នីតិវិធី ថ្មី ដែល ក្រុមហ៊ុន ទទួល ទិញ ផលិតផល របស់ យើង គឺ ពួកគេ ទិញ នៅក្នុង លក្ខណៈ សមធម៌ មាន ន័យ ថា ក្រុមហ៊ុន ទាំងនោះ បាន ចាប់ ដៃ ជាមួយ កសិករ ផ្ទាល់ សម្រាប់ ការលក់ ចេញ ទៅ សហគម អឺរ៉ុប និង អាមេរិក ព្រោះ គេ ពេញចិត្ត និង ទិញ នូវ ផលិតផល ដែល ជា លក្ខណៈ សមធម៌ នេះ » ។
