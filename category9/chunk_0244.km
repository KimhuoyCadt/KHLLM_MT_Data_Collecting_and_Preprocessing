( ភ្នំពេញ ) ៖ ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ អះអាង ថា ពេញ មួយ ឆ្នាំ ២០២០ កន្លងទៅ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ បាន រក្សា សន្តិសុខ សណ្ដាប់ធ្នាប់ ការគ្រប់គ្រង និង ការទប់ស្កាត់ ជំងឺ កូវីដ១៩ ជាមួយនឹង ការគ្រប់គ្រង រដ្ឋបាល ទូទៅ បាន យ៉ាង ល្អ ប្រសើរ រហូត ទទួលបាន ការគាំទ្រ និង ការជឿទុកចិត្ត ពីសំណាក់ ប្រជាពលរដ្ឋ នៅ រាជធានី ភ្នំពេញ យ៉ាង ពេញ ទំហឹង ។
នេះ បើ តាម ការលើកឡើង របស់ លោក ប៉ា សុជាតិ វង្ស ប្រធាន ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ ក្នុង កិច្ចប្រជុំ សាមញ្ញ លើក ទី២០ របស់ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ នា ព្រឹក ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០២១ នេះ នៅ សាលា រាជធានី ភ្នំពេញ ។ កិច្ចប្រជុំ នេះ ធ្វើឡើង ក្រោម វត្តមាន លោក ប៉ា សុជាតិ វង្ស និង លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ។
នៅក្នុង ឱកាស នោះ លោក ប៉ា សុជាតិ វង្ស បាន លើកឡើង ថា បញ្ហា សន្តិសុខ សណ្ដាប់ធ្នាប់ សាធារណៈ ការទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ និង ការគ្រប់គ្រង រដ្ឋបាល ទូទៅ ក្នុង មួយ ឆ្នាំ ២០២០ នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ រក្សា បាន យ៉ាង ល្អ ប្រសើរ ។ ប៉ុន្តែ ក៏ នៅ មាន ចំណុច ខ្វះខាត សេសសល់ មួយចំនួន ដែល អាជ្ញាធរ ត្រូវ បន្ត យកចិត្តទុកដាក់ ថែម ទៀត ដែរ ។
ជាមួយគ្នា នោះ ដែរ ក្រុមប្រឹក្សា រាជធានី បាន កោតសរសើរ ថែម ទៀត ចំពោះ រដ្ឋបាល រាជធានី ភ្នំពេញ ដែល បាន យកចិត្តទុកដាក់ ដល់ ការខិតខំ ពង្រឹង ការបង្ក្រាប បទល្មើស គ្រឿងញៀន និង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ក៏ ដូចជា ការដោះស្រាយ បញ្ចប់ ទំនាស់ និង ពាក្យបណ្តឹង ក្នុង ឆ្នាំ ២០២០ កន្លងមក នេះ ដែល ថ្នាក់ ខណ្ឌ បាន ដោះស្រាយ បញ្ចប់ ចំនួន ១៨៨ ករណី និង ថ្នាក់ សង្កាត់ ដោះស្រាយ បញ្ចប់ បាន ២. ៤៨ករណី ។
ចំណែក មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ បាន ខិតខំ សិក្សា ស្រាវជ្រាវ រកឃើញ សំណង់ ចាស់ ៗ នៅ តាម វត្ត ចំនួន ៦៩ លើ ៨៩វត្ត ក្នុង ខណ្ឌ ទាំង ១៤ ព្រមទាំង រកឃើញ វត្ថុ បុរាណ ដែល មាន នៅ តាម វត្ត ទាំង ៣៦ លើ ១១០វត្ត និង ទួល បុរាណ ចំនួន ២ទៀត ( ទួល សំរោង និង ទួល ចាស់ ) ។ លោក ថែមទាំង កោតសរសើរ ចំពោះ សកម្មភាព ការបំបែក សហកម្ម សិទ្ធិ តាម បុរី មួយចំនួន ។
ក្នុង កិច្ចប្រជុំ នោះ លោក ឃួង ស្រេង បាន បញ្ជាក់ ថា ចំពោះ រាល់ សំណើ និង សំណូមពរ របស់ ក្រុមប្រឹក្សា រាជធានី ភ្នំពេញ សុំ ឱ្យ រដ្ឋបាល រាជធានី ពង្រឹង តួនាទី គ្រប់ ថ្នាក់ ទាំង ថ្នាក់ ខណ្ឌ និង សង្កាត់ ពី របៀបរបប ធ្វើ ការងារ ឲ្យ កាន់តែ ល្អ ប្រសើរ នោះ រដ្ឋបាល រាជធានី ភ្នំពេញ នឹង ខិតខំ ធ្វើ កិច្ចការ នេះ ឱ្យ ប្រសើរឡើង ថែម ទៀត ៕
លោក ឧកញ៉ា លាង ពៅ មានប្រសាសន៍ ថា៖ « ខ្ញុំ សូម ស្ងើចសរសើរ ដល់ មន្ត្រី នគរបាល យើង ដែល ខិតខំ បំពេញ កិច្ចការ ដើម្បី សុវត្ថិភាព ប្រជាពលរដ្ឋ កម្ពុជា ។ ការលះបង់ ដ៏ ធំធេង នេះ មិន គួរ ត្រូវបាន មើល រំលង ឡើយ ។ ដូច្នេះហើយ ទើប ក្រុមការងារ ទឹកចិត្ត កម្ពុជា នឹង នៅតែ បន្ត សកម្មភាព ចែក អំណោយ ដល់ នគរបាល នៅ ទូទាំង កម្ពុជា យើង ក្នុង គោលបំណង តែ មួយ គត់ គឺ ដើម្បី ថ្លែងអំណរគុណ និង លើកទឹកចិត្ត ដល់ ពួកគាត់ ជាពិសេស » ។
វរសេនីយ៍ ទោ ពៅ សុភាព នាយ រង ការិយាល័យ នគរបាល ចរាចរណ៍ ផ្លូវគោក ក៏ បាន ថ្លែងអំណរគុណ ចំពោះ យុទ្ធនាការ ទឹកចិត្ត កម្ពុជា និង ក្រុមការងារ ដែល បាន ចុះ មក ចែក អំណោយ ជូន នគរបាល ដោយ ផ្ទាល់ ។ លោក ថ្លែង ថា « នេះ សបញ្ជាក់ អំពី ស្មារតី ចេះ ជួយ យកអាសារ គ្នា ទៅ វិញ ទៅ មក របស់ ជនជាតិ ខ្មែរ យើង » ។
ព្រឹក ស្អែក អង្គភាព អ្នកនាំពាក្យ រាជ រដ្ឋាភិបាល រៀបចំ សន្និសីទ សារព័ត៌មាន ស្ដីពី « វឌ្ឍនភាព មូលដ្ឋាន ឃុំ សង្កាត់ និង ទិសដៅ ការងារ បន្ដ »
គណៈកម្មការ សុខភាព ជាតិ ចិន បាន គូសបញ្ជាក់ នៅ ថ្ងៃពុធ នេះ ថា ករណី ឆ្លង COVID-19 ថ្មី ៗ សរុប ចំនួន ១១៥ ករណី ត្រូវបាន រកឃើញ នៅ ប្រទេស ចិន បើ ប្រៀបធៀប ទៅនឹង ៥៥ករណី កាលពី មួយ ថ្ងៃ មុន ។ នេះ គឺជា ការកើនឡើង នូវ ករណី ឆ្លង ជំងឺ ប្រចាំ ថ្ងៃ ខ្ពស់ បំផុត គិត ចាប់តាំងពី ថ្ងៃទី៣០ ខែកក្កដា ឆ្នាំ ២០២០ កន្លងទៅ នេះ ។
ឆ្នាំ ២០២០ មេធាវី ស្ម័គ្រចិត្ត គណៈកម្មាធិការ សិទ្ធិ មនុស្ស បំពេញ ភារកិច្ច ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ និង រហ័ស ជូន ដល់ ពលរដ្ឋ ក្រីក្រ
( ភ្នំពេញ ) ៖ លោក កែវ រ៉េមី រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្ត្រី និង ជា ប្រធាន គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន បញ្ជាក់ ថា ឆ្នាំ ២០២០ កន្លងទៅ ក្រុម មេធាវី ស្ម័គ្រចិត្ត របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន បំពេញ ភារកិច្ច របស់ ខ្លួន ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ និង រហ័ស ជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ដែល គ្មាន លទ្ធភាព ពឹងពាក់ មេធាវី ឯកជន ដោយ មិន យក កម្រៃ ។
ជាមួយនឹង កិច្ចការងារ លើ វិស័យ សិទ្ធិ មនុស្ស នេះ ដែរ លោក កែវ រ៉េមី បាន គូសបញ្ជាក់ ថា គណៈកម្មាធិការ សិទ្ធិ មនុស្ស បាន បញ្ជូន ក្រុម មេធាវី ស្ម័គ្រចិត្ត ឱ្យ ការពារ ក្តី ជូន ស្រ្តី ឈ្មោះ ពេជ្រ សូណែត ដែល ត្រូវបាន សាលាដំបូង កាត់ទោស ឱ្យ ជាប់ ពន្ធនាគារ ១៦៦ ឆ្នាំ នោះ រួចផុត បទ ចោទ ចំនួន ៨ សំណុំរឿង ។ ការរួចផុត បទ ចោទ ៨រឿង នេះ បាន ធ្វើឱ្យ ស្រ្តី ខាងលើ នៅសល់ ទោស តែ ២ សំណុំរឿង ប៉ុណ្ណោះ ដែល ត្រូវ អនុវត្ត ទោស ចំនួន ១៩ ឆ្នាំ ក្នុង ពន្ធនាគារ ។
ប្រធាន គណៈកម្មាធិការ សិទ្ធិ ម មនុស្ស កម្ពុជា រូប នេះ បាន ឱ្យដឹង ថា រហូត មក ពេលនេះ មាន កុមារ តូច តាម ម្តាយ ដែល ជាប់ ក្នុង ពន្ធនាគារ ចំនួន ៣នាក់ ហើយ ត្រូវបាន យកមក ឱ្យ ស្នាក់ នៅ ជាមួយ អង្គការ « ការអភិវឌ្ឍន៍ កុមារ កម្ពុជា » ដើម្បីឱ្យ ទទួលបាន ការសិក្សា រៀនសូត្រ ដូច កុមារ ដទៃ ដែល អាច ធ្វើឱ្យ ជីវិត របស់ កុមារ ទាំងនោះ មាន ភាព ភ្លឺ ថ្លា ទៅ ថ្ងៃ អនាគត ជាដើម ។
ជាមួយនឹង សមិទ្ធផល ដែល ទទួលបាន ជោគជ័យ លើ ការផ្តល់ ជំនួយ ផ្នែក ច្បាប់ ដោយ មិន យក ម្រៃ នេះ ដែរ លោក កែវ រ៉េមី បាន លើកទឹកចិត្ត ដល់ អ្នក ច្បាប់ និង ក្រុម មេធាវី របស់ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា ត្រូវ ខិតខំ បន្ត ក្នុង ការបំពេញ ភារកិច្ច នេះ បន្ត ទៅ ទៀត ដើម្បី ជា ប្រយោជន៍ ដល់ សង្គមជាតិ ទាំងមូល រួមទាំង ការថែរក្សា ឱ្យ បាន នូវ យុត្តិធម៌ នៅក្នុង សង្គមជាតិ ជាដើម ។
បន បន្ថែម ពី នេះ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន សម្រេច ផ្តល់ មេធាវី ការពារ ក្តី ដោយ ឥត គិត ថ្លៃ ជូន ស្ត្រី ជាប់ ឃុំ ដែល មាន កូន តូច នៅ ជាមួយ នៅ មណ្ឌល អប់រំ កែប្រែ ទី២ ( ម២ ) ដែល ទារិកា អាយុ ៥ខែ នោះ បាន ស្លាប់ នៅ មន្ទីរពេទ្យ ដោយ ជំងឺ រលាក សួត ធ្ងន់ធ្ងរ ។
លោក កែវ រ៉េមី បាន បញ្ជាក់ ថា ដោយ មាន ការគាំទ្រ ពី សម្តេច តេជោ ហ៊ុន សែន ក្រុមការងារ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា បាន ចូលរួម ដោះស្រាយ ករណី ការធ្វើ ទារុណកម្ម លើ អ្នក ជាប់ ពន្ធនាការ ក្នុង ខេត្ត បន្ទាយមានជ័យ រហូត បាត់បង់ជីវិត និង បាន នាំយក ជន ដែល ប្រព្រឹត្ត ល្មើស យកមក ផ្តន្ទាទោស តាម ផ្លូវ ច្បាប់ ព្រមទាំង ករណី ជាច្រើន ទៀត ត្រូវបាន ដោះស្រាយ បាន យ៉ាង ល្អ ដោយ ឈរ លើ គោលការណ៍ ច្បាប់ និង សិទ្ធិ មនុស្ស ៕
អាជ្ញាធរ ស្រុក បូទុម សាគរ ខេត្ត កោះកុង កំពុង រៀបចំ បង្កើន សោភ័ណភាព តាម ផ្លូវ សាធារណៈ ក្នុង មូលដ្ឋាន របស់ ខ្លួន
( កោះកុង ) ៖ អាជ្ញាធរ ស្រុក បូទុម សាគរ ខេត្ត កោះកុង បាន ខិតខំ រៀបចំ កែលម្អ សោភ័ណភាព នៅ តាម ផ្លូវ សាធារណៈ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ដោយ មាន ការដាក់ ភ្លើង បំភ្លឺ នៅ ដង ផ្លូវ ទីប្រជុំជន និង តាម មូលដ្ឋាន របស់ ប្រជាពលរដ្ឋ ព្រមទាំង បាន ជំរុញ ឱ្យ ប្រជាពលរដ្ឋ បង្កើន ការដាំដុះ ដំណាំ កសិកម្ម ចិញ្ចឹម មាន់ - ទា សម្រាប់ ដោះ ក្នុង ជីវភាព គ្រួសារ ។ ស្រុក បូទុម សាគរ ជា ស្រុក មួយ ស្ថិត នៅ ពាក់កណ្តាល ដង ផ្លូវ ជាតិ លេខ ៤៨ ក្រុង ខេមរភូមិន្ទ និង ស្រុក ស្រែ អំបិល ។
លោក បាន ជំរុញ ឲ្យ ប្រជាពលរដ្ឋ គ្រប់ មូលដ្ឋាន បង្កើន ការដាំដុះ ដំណាំ កសិកម្ម ចិញ្ចឹម មាន់ ទា ហើយ លោក នឹង ផ្តល់ ពូជ ជូន ពួកគាត់ ទៀតផង ជាក់ស្តែង ប៉ុន្មាន ថ្ងៃ មុន នេះ លោក និង លោកស្រី អភិបាល ខេត្ត បាន ផ្តល់ ពូជ មាន់ ចំនួន ៥៥០ ក្បាល ជូន ប្រជាពលរដ្ឋ ផងដែរ ។
លោក បាន បញ្ជាក់ ថា សូឡា មាន ចំនួន ជាង ២០០ អំពូល និង ឧបករណ៍ លំហាត់ប្រាណ ភ្លើង បំភ្លឺ តាម ដង សាធារណៈ ទីប្រជុំ នេះ គឺ លោក បាន មក ពី ទឹកចិត្ត សប្បុរសជន ដែល បាន ជួយ ឧបត្ថម្ភ កន្លងមក ក្នុង នោះ ក៏ មាន ការឧបត្ថម្ភ ពី មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត កោះកុង ខណៈ អាជ្ញាធរ នឹង ខិតខំ កៀរ គរ សប្បុរសជន បន្ថែម ទៀត ដើម្បី ដាក់ ភ្លើង បំភ្លឺ នៅ តាម មូលដ្ឋា នៅ ដាច់ស្រយាល ។
លោក អភិបាល ស្រុក ក៏ បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន ទាំងអស់ សូម ចូលរួម ថែរក្សា អនាម័យ បរិស្ថាន ដើម្បី សោភ័ណភាព ក្នុង ស្រុក ទាំងមូល និង ត្រូវ ចូល ថែរក្សា សុខភាព ការពារ ជំងឺ ឆ្លង កូវីដ១៩ កុំ មាន ឆ្លង ចូល សហគមន៍ ឲ្យ សោះ ៕ គ.ជ. ប ប្រកាស មិន យក បក្ស ណា ជា សត្រូវ តែ ប្រកាន់ ជំហរ ផ្នែក ច្បាប់ លើ អនុប្រធាន LDP
ការប្រកាស ជំហរ ផ្នែក ច្បាប់ របស់ គ.ជ. ប បាន ឡើង បន្ទាប់ពី គ.ជ. ប បាន ប្តឹង លោក អ៉ី សាំង ឡេង ចំនួន ៣ បទល្មើស គឺ បទ បរិហារ កេរ្តិ៍ ជាសាធារណៈ ជេរ ប្រមាថ ជាសាធារណៈ និង បទ ញុះញង់ ឱ្យ ប្រព្រឹត្ត បទឧក្រិដ្ឋ ជាអាទិ៍ ជាដើម ។
យ៉ាងណា ក៏ដោយ គ.ជ. ប ប្រកាស ថា គ្រប់ គណបក្ស នយោបាយ ទាំងអស់ ចំនួន ជាង ៤០ ដែល បាន ចុះបញ្ជី នោះ គឺ សុទ្ធតែ ជា ដៃគូ ដ៏ ល្អ ជាមួយ ស្ថាប័ន នេះ ហើយ គ.ជ. ប គាំទ្រ ជានិច្ច សម្រាប់ មតិ យោបល់ និង ការរិះគន់ ដើម្បី ស្ថាបនា ប៉ុន្តែ ការប្រមាថ មើលងាយ នឹង មិន លើកលែង ឱ្យ នោះ ឡើយ ហើយ នឹង ត្រូវ ចាត់ វិធានការ ទៅតាម ច្បាប់ ដូច្នេះ ដែរ ។
ថ្លែង នៅក្នុង សន្និសីទ សារព័ត៌មាន នា ព្រឹក ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០២១ លោក សោម សូរីដា បាន លើកឡើង ថា គ.ជ. ប . ជា អាជ្ញា កណ្តាល មួយ សម្រាប់ លើ កិច្ចការងារ បោះឆ្នោត ហើយ ស្ថាប័ន នេះ ពុំ បាន យក គណបក្ស នយោបាយ ណាមួយ ធ្វើជា សត្រូវ នោះ ឡើយ ប៉ុន្តែ មន្រ្តី មួយ រួប នៃ គណបក្ស សម្ព័ន្ធ ដើម្បី ប្រជាធិបតេយ្យ ដែល បាន ចោទប្រកាន់ និង ជេរ ប្រមាថ យ៉ាង គឃ្លេីន មក លើ ស្ថាប័ន ជាតិ មួយ នេះ នឹង មិន លើកលែង ឱ្យ នោះ ឡើយ ហើយ គ.ជ. ប. នឹង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ដូច អ្វី ដែល គ.ជ. ប បាន ប្រកាស នា ពេល កន្លងមក ។
ទន្ទឹមនឹង នេះ ដែរ លោក សោម សូរីដា បាន អំពាវនាវ ដល់ គ្រប់ ភាគី ពាក់ព័ន្ធ ចូលរួម ផ្ដល់ មតិ យោបល់ និង កែសម្រួល ករណី មាន កំហុសឆ្គង ក្នុង ន័យ រិះគន់ ដើម្បី ស្ថាបនា ដែល ពោរពេញ ដោយ ការគោរព សិទ្ធិ អ្នកដទៃ មាន ការយោគយល់ គ្នា ទៅវិញ ទៅ មក ហើយ ត្រូវ ប្រកបដោយ សេចក្ដីស្មោះត្រង់ និង ការលើកទឹកចិត្ត ។
អគ្គ លេខ ខាធិការ រង រូប នេះ បាន បន្ថែម ថា ក្នុង នាម គ.ជ. ប លោក ស្នេី គ្រប់ ភាគី ពាក់ព័ន្ធ បន្ត ចូលរួម ជាមួយ គ.ជ. ប បន្ត ទៀត នៅក្នុង ឆ្នាំ ២០២១ និង ឆ្នាំ ខាងមុខ ដើម្បី គោរព ឱ្យ ខាងតែ បាន នូវ សិទ្ធិ របស់ ម្ចាស់ ឆ្នោត និង ធានា ថា គ្មាន ទេ អស្ថិរភាព ក្រោយ ការបោះឆ្នោត ដោយ តម្កល់ សន្តិភាព និង ការអភិវឌ្ឍ ជា ធំ ។
លោក សោម សូរីដា បាន គូសបញ្ជាក់ ថា « ជា ការកត់សម្គាល់ របស់ គ.ជ. ប មេរៀន ទាំងឡាយ ខាងលើ នេះ គ្មាន ពណ៌ សម្បូរ នយោបាយ ក្នុង នោះ ទេ គឺ សុទ្ធតែ ជា គំនិត មេរៀន សម្រាប់ គ្រប់ ភាគី ប្រកាន់ យក សំដៅ ក សាង ប្រទេស ឱ្យ ចៀស ផុត ពី ការស្អប់ខ្ពើម ជាតិ សាសន៍ ឯង ដោយ យក គ្នា ស ត្រូវ ស្លាប់ រស់ ដែល ខ្មែរ ធ្លាប់ ភ្លក់ រសជាតិ រាប់ ទសវត្ស រួច មកហើយ កុំ ភ្លេច ឱ្យ សោះ មេរៀន ប្រវត្តិសាស្ត្រ នេះ » ។
( កំពង់ធំ )៖ លោក ម៉ាក់ ប៊ុន ហុង អភិបាល ក្រុង ស្ទឹង សែន ខេត្ត កំពង់ធំ បាន អំពាវនាវ ឱ្យ អាជ្ញាធរ សង្កាត់ បង្កើន ការយកចិត្តទុកដាក់ ខ្ពស់ លើ គុណភាព នៃ ការសាងសង់ ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ គម្រោង មូនិធិ សង្កាត់ ដើម្បីឱ្យ ការអភិវឌ្ឍ ចំ គោលដៅ និង សមស្រប តាម គោល នយោបាយ របស់ រាជ រដ្ឋាភិបាល ។
ការអំពាវនាវ បែប នេះ របស់ លោក ម៉ាក់ ប៊ុន ហុង បាន ធ្វើឡើង នៅ ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០២១ នេះ ក្នុង ពិធី បើក កិច្ចប្រជុំ សាមញ្ញ ក្រុមប្រឹក្សា ក្រុង លើក ទី១៩ អាណាត្តិ ទី៣ ។ លោក ក៏ បាន ជំរុញ ដល់ អាជ្ញាធរ សង្កាត់ ទាំង៨ ក្នុង ក្រុង ស្ទឹង សែន ឱ្យ បង្កើន ការយកចិត្តទុកដាក់ បន្ថែម លើ ការអនុវត្ត គម្រោង ប្រព័ន្ធ ហេដ្ឋារចនាសម្ព័ន្ធ មូលនិធិ ឃុំ - សង្កាត់ ប្រកបដោយ ប្រសិទ្ធភាព ។
ជាមួយគ្នា នេះ លោក ស្នើ ឱ្យ មន្ត្រី បច្ចេកទេ ហេដ្ឋារចនាសម្ព័ន្ធ ខេត្ត កំពង់ធំ ចុះ ពិនិត្យ និង វាយតម្លៃ គុណភាព ស្តង់ដារ ប្រកបដោយ ភាពត្រឹមត្រូវ ច្បាស់លាស់ ទៅ តាម ដំណាក់កាល នីមួយ ៗ និង ពន្យល់ ឱ្យ បាន ច្បាស់ ទៅកាន់ អាជ្ញាធរ សង្កាត់ ដែល ពាក់ព័ន្ធ ដើម្បីឲ្យ ពួកគាត់ បាន ទទួល សមិទ្ធផល ប្រកបដោយ គុណភាព និង ប្រើប្រាស់ បាន យូរអង្វែង ៕
សណ្ឋាគារ នៅ កម្ពុជា ត្រៀមខ្លួន ទទួល ភ្ញៀវ ឡើងវិញ ក្នុង ឆ្នាំ ថ្មី ជាមួយ ការរំពឹង ថា ស្ថានភាព កូវីដ១៩ នឹង ធូរស្បេី យ
( ភ្នំពេញ ) ៖ ពេញ មួយ ឆ្នាំ ២០២០ មក នេះ ទោះបីជា ខ្សត់ ភ្ញៀវ ចូល ស្នាក់ នៅ និង រង ផល ប៉ះពាល់ ជាច្រើន ពី វិបត្តិ ជំងឺ កូវីដ - ១៩ យ៉ាងណា ក៏ដោយ ក៏ បណ្ដា សណ្ឋាគារ និង រីសត នានា ដែល ជា សមាជិក សមាគម សណ្ឋាគារ កម្ពុជា នៅតែ ត្រៀមខ្លួន ជានិច្ច ក្នុង ទទួល ភ្ញៀវ ទេសចរ ឡើងវិញ សម្រាប់ ឆ្នាំ ២០២១ នេះ ដោយ ថែមទាំង ខិតខំ កែលម្អ សោភ័ណភាព ទីតាំង របស់ ខ្លួន ពង្រីក គោលដៅ ទស្សនា ឱ្យ កាន់តែ សម្បូរបែប ជាង មុន និង មាន ការលើកទឹកចិត្ត ជាច្រើន ដល់ ភ្ញៀវ ទេសចរ ក្នុង ស្រុក ផងដែរ ។
ដូច យើង ដឹង ស្រាប់ ហើយ ថា ដោយសារតែ វិបត្តិ នៃ ជំងឺ កូវីដ - ១៩ បាន បង្ក ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ជា សកល ទាំង អាយុជីវិរបស់ មនុស្សជាតិ វិបត្តិ សង្គម និង សេដ្ឋកិច្ច របស់ ពិភពលោក ក្នុង នោះ ប្រទេស កម្ពុជា ក៏ រង ផល ប៉ះពាល់ ធ្ងន់ធ្ងរ ផងដែរ ។ ក្រៅពី បង្ក ការឆ្លង រីករាលដាល ដល់ ប្រជាពលរដ្ឋ ផល ប៉ះពាល់ នៃ ជំងឺ នេះ ក៏ បង្ក ជា វិបត្តិ ដល់ វិស័យ មួយចំនួន ផងដែរ ពិសេស គឺ វិស័យ ការងារ និង វិស័យ ទេសចរណ៍ ដែល រង ផល ប៉ះពាល់ ធ្ងន់ ជាង គេ ។
បើ តាម ប្រធាន សមាគម ខាងលើ គិត ត្រឹម ពាក់កណ្ដាល ខែមករា ឆ្នាំ ២០២១ នេះ ក្រុមហ៊ុន ដែល ជា សមាជិក របស់ សមាគម សណ្ឋាគារ កម្ពុជា នៅ មិន ទាន់ ទទួលបាន ការកក់ កន្លែង ស្នាក់ ពីសំណាក់ ភ្ញៀវ បរទេស ណា ម្នាក់ នៅឡើយ ទេ គឺ ស្ងាត់ ឈឹង តែម្ដង ។
សកម្មភាព បាន ធ្វើឡើង នៅ ថ្ងៃទី ១២ ខែមករា ឆ្នាំ ២០២១ អម ដំណើរ ដោយ លោក សៅ សារ៉ាត់ ឣ្នក តំណាងរាស្រ្ត មណ្ឌល ប៉ៃលិន ព្រមទាំង ក្រុមការងារ ។
លោក ប្រធាន ក្រុមការងារ បាន ជំរុញ ដល់ កម្លាំង ចម្រុះ ទាំងអស់ និង មន្ត្រី ប្រចាំ ការ នៅ តាម ច្រក ទ្វារ ព្រំដែន អន្តរជាតិ ត្រូវ ធ្វើ យ៉ាងណា ខិតខំ តាមដាន រាល់ សភាពការណ៍ នៃ ការឆ្លង ដែន របស់ ពលករ ខ្មែរ និង ត្រូវ ប្រចាំ ការ ២៤ ម៉ោង តាម គោលដៅ ដែល ខ្លួន ទទួលខុសត្រូវ ក្រែង សមត្ថកិច្ច ថៃ បញ្ជូន ពលករ ខ្មែរ ត្រឡប់ មកវិញ ហើយ ប្រសិនបើ មាន មែន មន្ត្រី ជំនាញ សុខាភិបាល ត្រូវ ពិនិត្យ សុខភាព និង ធ្វើចត្តាឡី ស័ក ១៤ ថ្ងៃ សិន ដើម្បី ទុប ស្កាត់ ការចម្លង រីករាលដាល កូវីដ - ១៩ ចូលក្នុង សហគមន៍ ។
នៅក្នុង ឱកាស នោះ ផងដែរ លោក នាយ ឧត្តមសេនីយ៍ អ៉ី ឈាន បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ កង ម្លាំង ចម្រុះ ដែល កំពុង ឈរជើង ការពារ នៅ តាម បន្ទាត់ ព្រំដែន និង នៅ តាម គោលដៅ ទាំងអស់ ដែល បាន ខិតខំ បំពេញ ការងារ ទាំង កំលាំង កាយ ទាំង កំលាំងចិត្ត ប្រកបដោយ ការទទួល ខុស ត្រូវ ខ្ពស់ ក្នុង ការរួមគ្នា ប្រយុទ្ធ ប្រឆាំង និង ទប់ស្កាត់ ការចម្លង រីករាលដាល ជំងឺ កូវីដ - ១៩ ជាពិសេស លើកទឹកចិត្ត ដល់ ក្រុម គ្រូពេទ្យ ជំនាញ ទាំងអស់ ដែល កំពុង បំពេញ បេសកកម្ម ដ៏ ថ្លៃថ្លា នេះ សម្រាប់ ប្រទេសជាតិ ។
( ភ្នំពេញ ) ៖ រថយន្ត សង្គ្រោះ បន្ទាន់ ទី៤៤ ដែល ជា អំណោយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ត្រូវ ប្រគល់ ជូន ដល់ មន្ទីរពេទ្យ បង្អែក ១៦មករា ខេត្ដ ព្រះវិហារ ហើយ នៅ ព្រឹក ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០២១ នេះ តាមរយៈ លោក ឧកញ៉ា បណ្ឌិត ជា រតនា និង ឧកញ៉ា លី ហៀក រតនា ដើម្បី ទុក សម្រាប់ ទុក បម្រើ សេវា សុខភាព ជូន ពលរដ្ឋ កាន់តែ ប្រសើរ ។
លោក វេជ្ជបណ្ឌិត ស៊ុម ស៊ិញ អនុប្រធាន មន្ទីរ សុខាភិបាល ខេត្ដ ព្រះវិហារ បាន ថ្លែង ថា ដោយសារ ស្ថានភាព នៅ មន្ទីរ សុខាភិបាល ខេត្ដ ព្រះវិហារ មាន ការខ្វះខាត រថយន្ដ សង្គ្រោះ បន្ទាន់ សម្រាប់ ដឹកជញ្ជូន អ្នកជំងឺ ពី ព្រះវិហារ ទៅកាន់ រាជធានី ភ្នំពេញ និង ទៅកាន់ ខេត្ដ សៀមរាប ដូច្នេះ រថយន្ដ សង្គ្រោះ បន្ទាន់ នេះ នឹង ចូលរួមចំណែក យ៉ាង ច្រើន ក្នុង ការសង្គ្រោះ ជីវិត ពលរដ្ឋ យើង បាន ទាន់ ពេល វេលា ។
លោក វេជ្ជបណ្ឌិត បាន ថ្លែង បន្ដ ថា « ក្នុង នាម ខ្ញុំ តំណាង ឱ្យ ខាង មន្ទីរ សុខាភិបាល ខេត្ដ និង ប្រជាពលរដ្ឋ សូម គោរព ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជា ទីបំផុត ចំពោះ សម្តេច តេជោ ហ៊ុន សែន និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល បាន ផ្ដល់ រថយន្ដ នេះ ដើម្បី ផ្ដល់ ភាពងាយស្រួល ដល់ មន្ទីរ សុខាភិបាល យើង ក្នុង ការដឹកជញ្ជូន អ្នកជំងឺ ។ យើងខ្ញុំ នឹង យក ទៅ ប្រើប្រាស់ ប្រកបដោយ ប្រសិទ្ធភាព ខ្ពស់ ជូន ប្រជាពលរដ្ឋ ដោយ មិន ប្រកាន់ ឋានៈ មាន ក្រ អ្វី ឡើយ » ។
ក្នុង ឱកាស នោះ លោក វេជ្ជបណ្ឌិត ក៏ ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ចំពោះ ទឹកចិត្ត ប្រកបដោយ សប្បុរសធម៌ របស់ លោក ឧកញ៉ា បណ្ឌិត ជា រតនា និង ឧកញ៉ា លី ហៀក រតនា ដែល បាន ចូលរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ជួយ ដល់ សង្គមជាតិ កន្លងមក នេះ និង បន្ដ ទៅ ថ្ងៃ អនាគត ។
ជាមួយគ្នា នោះ លោក ឧកញ៉ា បណ្ឌិត ជា រតនា បាន ថ្លែង ថា រថយន្ត សង្គ្រោះ បន្ទាន់ ទី៤៤ ដែល បាន ប្រគល់ ជូន មន្ទីរពេទ្យ បង្អែក ១៦មករា ខេត្ត ព្រះវិហារ នេះ « ខ្ញុំបាទ សង្ឃឹម ថា រថយន្ត នេះ នឹង អាច ជួយ សម្រួល ដល់ ប្រជាពលរដ្ឋ នៅ ទីនោះ បាន »៕
បុគ្គលិក ផ្នែក សុខាភិបាល សរុប ១. ៤៨លាន នាក់ នឹង ទទួលបាន ការចាក់ វ៉ាក់សាំង COVID-19 ដោយ ចាប់ផ្តើម ពី សប្តាហ៍ នេះ ទៅ ។ ក្នុង នោះ មនុស្ស ជាង ៥៦០.០០០ នាក់ ត្រូវ គេ រំពឹង ថា នឹង ទទួលបាន ការចាក់ វ៉ាក់សាំង ក្នុង ខែមករា នេះ ហើយ ជាង ៩០០.០០០ នាក់ ទៀត នឹង ទទួល ការចាក់ នៅក្នុង ខែកុម្ភៈ ។ សម្រាប់ ក្រុម បន្ទាប់ គឺ បុគ្គលិក រដ្ឋ សរុប ប្រមាណ ១៧.៤លាន នាក់ ដែល ស្ថិត ក្នុង ក្រុម មនុស្ស ប្រឈម ហានិភ័យ ខ្ពស់ ។
ប្រភព ពី ក្រុម អ្នកការទូត អឺរ៉ុប ដែល សុំ មិន បញ្ចេញ អត្តសញ្ញាណ បាន ប្រាប់ ថា លោក Pompeo ត្រូវបាន ក្រុម មន្រ្តី នៅ ទីក្រុង ព្រុច សែល និង ក្រុម មន្រ្តី នៅ ប្រទេស លុចហ្សំបួរ « បដិសេធ មិន ជួប » បន្ទាប់ពី សហភាព អឺរ៉ុប បាន ថ្កោលទោស ជាខ្លាំង ចំពោះ អំពើហិង្សា កាលពី ថ្ងៃទី ០៦ ខែមករា នៅ រដ្ឋធានី វ៉ាស៉ីនតោន ពេល ដែល ក្រុម អ្នកគាំទ្រ ប្រធានាធិបតី អាមេរិក លោក ដូណាល់ ត្រាំ បាន ចូល អុក ឡុក វិមាន សភា អាមេរិក ហើយ បង្កឲ្យ មាន មនុស្ស បាត់បង់ជីវិត ០៥ នាក់ ថែម ទៀត ។
គួរ បញ្ជាក់ ថា នៅ ថ្ងៃអង្គារ សប្តាហ៍ នេះ ( ពេលវេលា នៅ អាមេរិក ) លោក ប្រមុខ ការទូត របស់ សហរដ្ឋ អាមេរិក បាន ប្រកាស ពី ការលុបចោល គម្រោង ទស្សនកិច្ច ទាំងអស់ របស់ ក្រសួង ការបរទេស អាមេរិក ដោយ លើក ហេតុផល ថា ការសម្រេច ធ្វើ បែប នេះ គឺ ចាំបាច់ ដើម្បី ផ្តោត ទៅ លើ ដំណើរការផ្ទេរ អំណាច នៃ ប្រធានាធិបតី អាមេរិក ដែល នឹង ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ២០ ខែមករា ជាមួយ ការស្បថ ចូលកាន់ តំណែង របស់ ប្រធានាធិបតី ជាប់ ឆ្នោត លោក ចូ បៃ ដិន ៕
គួរ បញ្ជាក់ ថា នៅក្នុង របាយការណ៍ កាលពី ថ្ងៃចន្ទ ដើម សប្តាហ៍ នេះ សហរដ្ឋ អាមេរិក បាន ចាក់ វ៉ាក់សាំង COVID-19 សម្រាប់ ដូស ដំបូង ជូន ដល់ ប្រជាជន ខ្លួន ជិត ៩លាន នាក់ ហើយ ។ បន្ថែម ពី នេះ លោក ចូ បៃ ដិន ដែល នឹង ត្រូវ ស្បថ ឡើង កាន់ តំណែង ប្រធានាធិបតី អាមេរិក ជា ផ្លូវការ នៅ ថ្ងៃទី ២០ ខែមករា ឆ្នាំ ២០២១ ធ្លាប់ បាន លើកឡើង ដែរ ថា លោក នឹង ប្រើ ពេល ១០០ ថ្ងៃ ដើម្បី ទប់ទល់ ការឆ្លង រាតត្បាត វីរុស កូរ៉ូណា ក្នុង នោះ មាន ដូចជា ការតម្រូវ ឲ្យ ពាក់ ម៉ាស ទូទាំង ប្រទេសជាដើម ៕
បើ តាម គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ដឹកជញ្ជូន នៃ សហរដ្ឋ អាមេរិក ក្រុម អ្នកតំណាង និង ក្រុម អ្នកជំនាញ បី រូប ទៀត នឹង ត្រូវ បញ្ជូន ទៅកាន់ រដ្ឋធានីហ្សាការតា ដើម្បី ចូលរួម ក្នុង ការស៊ើបអង្កត ជាមួយ អាជ្ញាធរ ឥណ្ឌូណេស៊ី លើ សោកនាដកម្ម យន្ដហោះ Boeing 737-500 ដែល បាន ធ្លាក់ ចូល ក្នុង សមុទ្រ ជ្វា ៤នាទី ក្រោយ ហោះ ចេញ ពី អាកាសយានដ្ឋាន ក្នុង រដ្ឋធានីហ្សាការតា ។
កម្មករ ពីរ នាក់ ក្នុង កសិដ្ឋាន ចិញ្ចឹម មាន់ ដែល ផ្ទុះ ជំងឺ ផ្តាសាយ បក្សី ត្រូវបាន យកសំណាក់ ទៅ ពិនិត្យ នៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ
( បាត់ដំបង ) ៖ កម្មករ ពីរ នាក់ ដែល មើល ថែ មាន់ ក្នុង កសិដ្ឋាន ចិញ្ចឹម មាន់ មួយ កន្លែង ដែល សង្ស័យ មាន ផ្ទុះ ជំងឺ ផ្តាសាយ បក្សី H5N1 ត្រូវបាន យកសំណាក់ ទៅ ពិនិត្យ នៅ វិទ្យាស្ថាន បាស្ទ័រ រាជធានី ភ្នំពេញ ហើយ មន្ត្រី ជំនាញ បាន ដាក់ ពួកគេ ឱ្យ នៅ មួយ កន្លែង សិន ពោលគឺ មិន ទាន់ អនុញ្ញាតឱ្យ ចេញ ទៅ ជួប អ្នកដទៃ ឡើយ ។
តាម សេចក្ដីរាយការណ៍ នា ថ្ងៃទី ១៣ ខែមករា ឆ្នាំ ២០២១ នេះ បាន ឱ្យដឹង ថា លោក វឿង ប៊ុន រ៉េត ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត បាត់ដំបង នៅ ថ្ងៃ ម្សិលមិញ បាន ចុះ មក យក សំណាក កម្មករ រពីរ នាក់ ដែល មើល ថែ មាន់ ក្នុង កសិដ្ឋា ដែល មាន ផ្ទុះ ជំងឺ ផ្តាសាយ បក្សី H5N1 នៅ ភូម ព្រែក កញ្ច្រែង ឃុំ ព្រែក ហ្លួង ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង ផ្ញើ ទៅ វិទ្យាស្ថាន ប៉ាស្ទ័រ រាជធានី ភ្នំពេញ ។ កម្មករ ពីរ នាក់ ដែល ជា អ្នកថែ និង ប៉ះពាល់ មាន់ ងាប់ ផ្ទាល់ មាន ឈ្មោះ រ៉ន បញ្ញា អាយុ ២១ ឆ្នាំ និង ឈ្មោះ ខន ជីវ័ន អាយុ ២៨ ឆ្នាំ ។
លោក វេជ្ជបណ្ឌិត អ៊ុក វិទ្យា អនុប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត បាត់ដំបង បាន ឱ្យដឹង ថា សុខភាព កម្មករ ទាំង ពីរ នាក់ នេះ ល្អ ធម្មតា ពុំ មាន រោគសញ្ញា បង្ហាញ គួរឱ្យ សម្គាល់ នោះ ទេ ។
សូម បញ្ជាក់ ថា បើ តាម លោក ហូ ណា ម ម្ចាស់ កសិដ្ឋាន ខាងលើ បាន ឱ្យដឹង ថា កសិដ្ឋាន នេះ ចិញ្ចឹម មាន់ មួយ ខែ មក ហើយ ដែល នាំចូល ពូជ ពី ក្រុមហ៊ុន មួយ របស់ ប្រទេស វៀតណាម ចំនួន ១.៣០០ ក្បាល និង មាន់ ស្រែ ២០០ ក្បាល ទាកាប៉ា ជាង ២០០ ក្បាល និង ក្ងាន មួយចំនួន ។
តាម កម្មករ មើល ថែ ផ្ទាល់ បាន បញ្ជាក់ ថា មាន់ ចាប់ផ្តើម ឈឺ ងាប់ ចាប់់ ពី ថ្ងៃទី ៣១ - ០៥ ខែមករា គឺ ងាប់ ទាំងអស់ តែម្តង ហើយ មាន់ ដែល ងាប់ ទាំងនេះ ត្រូវបាន មន្រ្តី ជំនាញ បាន ចុះ មក ណែនាំ ឱ្យ កប់ ចោល និង បាន បាញ់ ថាំ សម្លាប់ មេរោគ ជុំវិញ កសិដ្ឋាន ផងដែរ ។
សូម បញ្ជាក់ ថា លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ បាន បញ្ជាក់ កាលពី ថ្ងៃទី ១១ ខែមករា ថា លទ្ធផល ធ្វើតេស លើ សំណាក សត្វ មាន់ ដែល ងាប់ ជាង ១.០០០ ក្បាល នៅ ភូមិ ព្រែក តា ច្រែង ឃុំ ព្រែក នរិន្ទ ស្រុក ឯក ភ្នំ ខេត្ត បាត់ដំបង បាន បង្ហាញ ថា គឺជា គ្រុន ផ្តាសាយ បក្សី (H5N1) ប៉ុន្តែ ប្រភេទ ជំងឺ នេះ គឺ មិន ប៉ះពាល់ ដល់ មនុស្ស ទេ ។
លោក ឈឹម វ ជិរា ប្រធាន មន្ទីរ កសិកម្ម ខេត្ត បាត់ដំបង បាន អំពាវនាវ ពលរដ្ឋ ថា ប្រសិនបើ ឃើញ មាន់ ឈឺ ឬ ងាប់ ខុស ប្រក្រតី និង សង្ស័យ កើត ជំងឺ ផ្តាយ សាយ បក្សី ត្រូវ រាយការណ៍ ជាបន្ទាន់ មកកាន់ អាជ្ញាធរ មូលដ្ឋាន និង មន្រ្តី ការិយាល័យ បសុព្យាបាល ឬ មន្ទីរ កសិកម្ម ផ្ទាល់ ដើម្បី ចុះ អន្តរាគមន៍ ភ្លាម ៗ ៕
ក្នុង ខែធ្នូ ឆ្នាំ ២០២០ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ទទួល ថវិកា បរិច្ចាគ ជិត ៣៦ ម៉ឺន ដុល្លារ សម្រាប់ ជួយ ទ្រទ្រង់ ដំណើរការ មន្ទីរពេទ្យ គន្ធ បុប្ផា ទាំង ៥ទីតាំង
មូលនិធិ គន្ធ បុប្ផា កម្ពុជា សូម ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ដល់ សប្បុរសជន ទាំងអស់ ចំពោះ ការបន្ត គាំទ្រ និង បរិច្ចាគ ថវិកា ដើម្បី រួមគ្នា ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ ដូចជាមួយ មូលនិធិ គន្ធ បុប្ផា កម្ពុជា ក្នុង ការទ្រទ្រង់ ផ្នែក ហិរញ្ញវត្ថុ និង ធានា ឱ្យ បាន នូវ កិច្ច ដំណើរការ ប្រកបដោយ ចីរភាព ប្រសិទ្ធភាព និង គុណភាព របស់ មន្ទីរពេទ្យ គន្ធ បុប្ផា ទាំង 0៥ ទីតាំង សំដៅ លើកកម្ពស់ សុខុមាលភាព កុមារ និង ទារក នៅ កម្ពុជា ។
