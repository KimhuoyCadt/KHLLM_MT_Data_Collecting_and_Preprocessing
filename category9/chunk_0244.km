( ភ្នំពេញ ) ៖ ព្យុះ ពាក្យ រិះគន់ បាន កក្រើក ពេញ បណ្តាញ សង្គម ហ្វេសប៊ុក ក្នុង រយៈពេល ប៉ុន្មាន ថ្ងៃ មក នេះ ដោយសារតែ តម្លៃ ពង ទា បាន ធ្លាក់ ថ្លៃ ។ ព្យុះ ពាក្យ រិះគន់ នេះ បាន បាញ់ ឆ្ពោះ ចំរដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ លោក វេង សាខុន តែម្តង ។
ក្នុង ដំណើរ ចុះ ពិនិត្យ ការប្រមូល ត្រី ប្រហុក តាម ដងទន្លេ សាប នៅ ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២០ លោក វេង សាខុន មិន ទោមនស្ស ចំពោះ ការរិះគន់ ចំពោះ ពាក្យពេចន៍ លេប ខាយ ឌឺដង មួយចំនួន ចំពោះ រូប លោក នោះ ទេ ។
លោក រដ្ឋមន្ត្រី បាន ពន្យល់ ថា ការជោជន់ ពង ទា និង រហូតដល់ ការធ្លាក់ ថ្លៃ នេះ បណ្តាល មកពី កត្តា មួយ ចំនួន ដូចជា ការអនុវត្តន៍ វិធានការ ទប់ស្កាត់ ការចម្លង កូវីដ១៩ នាំ ពិធី ផ្សេង ៗ ត្រូវបាន ផ្អាក . តម្រូវការ នៅ តាម អាហារដ្ឋាន ភោជនីយដ្ឋាន និង សណ្ឋាគារ មួយចំនួន ត្រូវបាន កាត់បន្ថយ ។ ជាមួយគ្នា ក្នុង កំលុង ពេលនេះ ត្រី ទឹក សាប សម្បូរ ជា ហេតុ នាំឱ្យ ពលរដ្ឋ កាត់បន្ថយ ការហូប ពង ទា ផងដែរ ។
ជាមួយនឹង ការធ្លាក់ តម្លៃ ពង ទា នេះ នាំឱ្យ មាន ការលើកឡើង មួយចំនួន ថា ការធ្លាក់ ថ្លៃ ព្រោះតែ មាន ការនាំចូល ពង ទា ពី ប្រទេស ជិតខាង ។ ជាពិសេស ពី ប្រទេស វៀតណាម តែម្តង ។
ឆ្លើយតប ការលើកឡើង នេះ លោក វេង សា ខុន បាន អះអាង និង បញ្ជាក់ ថា ក្រោយពេល មាន ការត្អូញត្អែរ របស់ ប្រជាពលរដ្ឋ លោក បាន ចាត់ មន្ត្រី ជំនាញ សិក្សា ស្រាវជ្រាវ ភ្លាម ពី តម្លៃ ពង ទា នៅ កម្ពុជា និង នៅ វៀតណាម ។ តាម ការសិក្សា តម្លៃ ពង ទា នៅ កម្ពុជា និង វៀតណាម ប្រហាក់ប្រហែល គ្នា ហើយ វៀតណាម ថ្លៃ ជាង កម្ពុជា បន្តិច ផង ។
ការលើក ហេតុផល បែប នេះ គឺ លោក រដ្ឋមន្ត្រី ចង់ គូសបញ្ជាក់ ថា មិន មាន ឈ្មួញ ណា ម្នាក់ នាំចូល ពង ទា ពី វៀតណាម មក កម្ពុជា គ្រា ដែល តម្លៃ ប្រហាក់ប្រហែល គ្នា បែប នេះ ឡើយ ។
« អ្វី ដែល យើង បាន មើលឃើញ ថា មិន មាន បាតុភាព នាំចូល ទេ ហើយ ទន្ទឹមនឹង ហ្នឹង យើង ក៏ បាន បញ្ជាក់ ថា រដូវ ត្រី ត្រូវ ផង ប្រជាជន កាត់បន្ថយ ការហូប ហើយ ទន្ទឹម នឹង នោះ អគ្គ នាយកដ្ឋាន បាន ប្រកាស ជូន ថា ក្នុង ករណី ប្រជាជន ណា ពិនិត្យ ឃើញ ថា មាន ការនាំចូល ដោយ ខុស ច្បាប់ ត្រូវ រាយការណ៍ ជាបន្ទាន់ មក អគ្គ នាយកដ្ឋាន ផលិតកម្ម សត្វ សុខភាព សត្វ នេះ ជាបន្ទាន់ » ។ នេះ ជា ការបញ្ជាក់ របស់ លោក រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម ។
លោក រដ្ឋមន្ត្រី បាន អំពាវនាវ ដល់ អ្នក ចិញ្ចឹម ទាយក ពង រាយការណ៍ ជូន ក្រសួង កសិកម្ម ដើម្បី ចុះ ទៅ ចាប់ ក្រុម ឈ្មួញ ដែល លួច នាំ ពង ទា ចូល ព្រោះ ក្រសួង មិន មាន អនុញ្ញាតឱ្យ ឈ្មួញ នាំ ពង ទា ចូល នោះ ឡើយ ។
ករណី ដែល លោក ខូវ គាត បាន បិទ ផ្លូវ សាធារណៈ ដែល មាន ទទឹង ៥ម៉ែត្រ និង បណ្ដោយ ជិត ៥គីឡូម៉ែត្រ ខាងលើ នេះ ក្នុង ពេល ខាងមុខ ឆាប់ ៗ នេះ មន្ត្រី ជំនាញ នឹង ឱ្យ លោក ខូវ គាត បើក ផ្លូវ នេះ ឡើងវិញ ដោយ ស្វ័យប្រវត្តិ បើ ពុំ នោះ ទេ មន្ត្រី ជំនាញ នឹង ចាត់ វិធានការ តាម ផ្លូវ ច្បាប់ ។
ក្រោយពី ក្រុមការងារ ចម្រុះ បាន បញ្ជាក់ ថា ផ្លូវ ដែល សុំ បើក នោះ ជា ផ្លូវ ទ័ល មិន អាច ទំលាយ បើក ទៅកាន់ ផ្លូវ លេខ ៥៣ បាន ព្រោះ បាន ប៉ះពាល់ ដី កម្មសិទ្ធ ប្រជាពលរដ្ច ចំនួន ៥ប័ណ្ណ ផ្សេង ទៀត ដូច្នេះ បើ ចង់ បើក ទាល់តែ មាន ការចរចា ឬ ទិញ ដូរ និង យល់ព្រម ពី ម្ចាស់ ក្បាល ដី ៥បណ្ណ័ ខាងលើ នេះ សិន ។
ដោយឡែក ករណី ដី ផ្លូវ សាធារណៈ ដែល និស្សិត បាន វាស់វែង ទុក ឱ្យ នោះ គឺជា ផ្លូវ ទាល់ ប៉ុន្តែ បើ ប្រជាពលរដ្ឋ ចង់ ស្នើសុំ ឲ្យ បើក ផ្លូវ នេះ ឡើងវិញ ត្រូវ ដាក់ពាក្យបណ្ដឹង ជាថ្មី ដើម្បី សុំ បើក ផ្លូវ ខាងលើ នេះ ដែល លោក ខូវ គាត បាន បិទ នោះ គឺ គ្មាន បញ្ហា ទេ ហើយ អាជ្ញាធរ នឹង ចាត់ការ តាម នីតិវិធី ។
សូម បញ្ជាក់ ថា តាម បណ្ដឹង ចុះ ថ្ងៃទី ២០ ខែមីនា ឆ្នាំ ២០២០ របស់ ប្រជាពលរដ្ឋ ចំនួន ៣ភូមិ នៅក្នុង ឃុំ អម លាំង បាន បញ្ជាក់ ថា លោក ខូវ គាត បាន បិទ ផ្លូវ សាធារណៈ ក្នុង ភូមិ ខ្វិត ទួល ឃ្លាំង ជិត ៥គីឡូម៉ែត្រ អស់ រយៈពេល ជាង ៥ឆ្នាំ មកហើយ ដែល ក្រុម និសិ្សត បាន វាស់វែង ទុកឲ្យ ។ ដូចនេះ ទើប ពួក គាត់ សុំ អន្តរាគមន៍ ដល់ អាជ្ញាធរ ខេត្ត កំពង់ឆ្នាំង ឲ្យ បើក ផ្លូវ ខាងលើ នេះ វិញ បើ ដោះស្រាយ មិន បាន ពួកគាត់ នឹង ស្នើសុំ ទៅ ថ្នាក់ លើ ជា បន្ត ទៀត ។
( បន្ទាយមានជ័យ )៖ ក្រោយពី ទទួល ព័ត៌មាន ថា មាន ពលករ ចំណាកស្រុក ដែល ចូលទៅ ធ្វើការ នៅ ប្រទេស ថៃ បាន នាំគ្នា សម្រុក មក តាម ច្រក របៀង អូរ បី ជាន់ ត្រូវបាន អាជ្ញាធរ សមត្ថកិច្ច ក្រុង ប៉ោយប៉ែត បាន ចុះ សួរសុខទុក្ខ ។
លោក គាត ហ៊ុល អភិបាល ក្រុង ប៉ោយប៉ែត បាន ប្រាប់ ថា ដោយសារ ប្រទេស ថៃ នៅក្នុង ខេត្ត សាមុទ្រ សាខ ន ផ្ទុះ ឡើងវិញ នូវ ជំងឺ ឆ្លង កូវីដ១៩ ដែល ជា ក្តីបារម្ភ និង ក្រោយ ពី ទទួលបាន បទបញ្ជា ពី សម្តេច តេជោ ប្រមុខ ថ្នាក់ រាជ រដ្ឋាភិបាល កម្ពុជា . គណៈ បញ្ជាការ ឯកភាព រដ្ឋបាល ខេត្ត / ក្រុង ថ្នាក់ដឹកនាំ កងកម្លាំងប្រដាប់អាវុធ គ្រប់ ស្ថាប័ន ខេត្ត / ក្រុង និង អាជ្ញាធរ មូលដ្ឋាន បាន អញ្ជើញ ចុះ ត្រួតពិនិត្យ មើល នូវ ស្ថានភាព ទូទៅ តាម បន្ទាត់ ព្រំដែន កម្ពុជា - ថែ ។
ជាពិសេស នៅ ច្រក អូរ បី ជាន់ ស្ថិត នៅ ឃុំ អូរ បី ជាន់ ស្រុក អូរ ជ្រៅ ខេត្ត បន្ទាយមានជ័យ តែម្តង ដើម្បី ដាក់ វិធានការ បន្ថែម ក្នុង ការពង្រឹង ការគ្រប់គ្រង ប្រជាពលរដ្ឋ ដែល បាន វិលត្រឡប់ មកពី ប្រទេស ថៃ ឲ្យបាន ហ្មត់ចត់ តឹងរឹង បំផុត ដោយ ត្រួតពិនិត្យ វាស់ កំដៅ រួច បញ្ជូន ទៅ មន្ទីរពេទ្យ ក្រុង ប៉ោយប៉ែត ដើម្បី ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ឲ្យបាន ត្រឹមត្រូវ តាម វិធានការ របស់ ក្រសួង សុខាភិបាល ។
បើ តាម ក្រុម គ្រូពេទ្យ និង មន្ត្រី ជំនាញ ដែល ប្រចាំ ការ នៅ ចំណុច ខាងលើ បាន ឲ្យដឹង ថា ក្រោយពី ទទួលបាន បទបញ្ជា ពី សម្តេច តេជោ រួច មក មន្ត្រី ជំនាញ ពាក់ព័ន្ធ ទាំងអស់ បាន រឹតបន្តឹង បំផុត នៅ ពេល ដែល ពួក កាត់ ចេញ ពី ទឹកដី ថៃ មិន អនុញ្ញាតឲ្យ ពួកគាត់ ចេញ ទៅ ណា បាត់ មួយ នាក់ នោះ ទេ ដោយ ធ្វើ ការពិនិត្យ សំណាក និង ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ។
មន្ត្រី ជំនាញ ដដែរ បន្ត ថា ប្រជាពលរដ្ឋ ដែល ចេញ ពី ទឹកដី ថៃ ក្រោយ ពិនិត្យ រួច ត្រូវបាន បញ្ជូន ទៅ កន្លែង ពិនិត្យ សំណាក និង ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ នៅ ចំនួន ៤ទីតាំង ដែល អាជ្ញាធរ ខេត្ត និង ក្រុង បាន រៀបចំ រួចជាស្រេច រួម មាន ទី ១៖ នៅ មន្ទីរពេទ្យ បង្អែក ប៉ោយប៉ែត ( ដី ថ្មី ) . ទី២៖ មណ្ឌល សុខភាព ប៉ោយប៉ែត១. ទី ៣៖ សាលា ព្រហ្ម និមិត្ត និង ទី៤៖ សាលា វិទ្យាល័យ និមិត្ត ថ្មី ។
មន្ត្រី ជំនាញ បញ្ជាក់ ថា ពលរដ្ឋ ដែល ចេញ មក ពី ទឹកដី ថៃ រយៈពេល កន្លងមក ក៏ ដូចជា ពេលនេះ សុទ្ធសឹងតែ ជួប បញ្ហា ដោយសារ ដាច់ ប៉ាស្ព័រ . អត់ មាន ការងារ ធ្វើ និង មាន ធុរៈ ក្នុង គ្រួសារ ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ អ្នកនាំពាក្យ ប្រធានាធិបតី ហ្វីលីពីន បាន គូសបញ្ជាក់ ថា « រាល់ ជើងហោះហើរ ទាំងអស់ ពី ចក្រភព អង់គ្លេស មកកាន់ ប្រទេស ហ្វីលីពីន ត្រូវបាន ផ្អាក ចាប់ពី ថ្ងៃទី ២៤ ខែធ្នូ រហូតដល់ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ » ។ សម្រាប់ អ្នកដំណើរ ទាំងអស់ ដែល ធ្លាប់ ធ្វើដំណើរ ទៅ ចក្រភព អង់គ្លេស ក្នុង រយៈពេល ១៤ ថ្ងៃ ចុងក្រោយ នេះ រួមទាំង អ្នកធ្វើដំណើរ ឆ្លងកាត់ ក៏ ត្រូវបាន ហាមឃាត់ ជា បណ្តោះអាសន្ន មិន ឲ្យ ចូល ប្រទេស អាស៊ាន មួយ នេះ ក្នុង រយៈពេល ដូច ខាងលើ នេះ ផងដែរ ។
ទូត អូស្ដ្រាលី ប្រាប់ រដ្ឋមន្ដ្រី ក្រសួង ពាណិជ្ជកម្ម ថា នឹង បង្កើន ការផ្ដល់ អាហារូបករណ៍ ជូន និស្សិត កម្ពុជា
ជា ការចាប់ផ្ដើម លោក រដ្ឋមន្ដ្រី និង លោក ឯក អគ្គ រាជ ទូត បាន ពិភាក្សា លើ វិបិត្ត កូវីដ - ១៩ ដែល មាន ផល ប៉ះពាល់ កន្លងមកដល់ ការរស់នៅ ប្រចាំ ថ្ងៃ របស់ ប្រជាជន គ្រប់ គ្នា និង បាន អបអរសាទ លើ ការចុះហត្ថលេខា នៃ កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ តំបន់ (RCEP) ដែល កម្ពុជា និង អូស្ដ្រាលី ជា សមាជិក ក្នុង ខែវិច្ឆិកា កន្លងមក ។
ក្នុង កិច្ចប្រជុំ នេះ លោក រដ្ឋមន្រ្ដី បាន ស្នើឲ្យ ភាគី អូស្ដ្រាលី ផ្ដល់ មន្រ្ដី បច្ចេសទេស ការពារ អ្នកប្រើប្រាស់ (Consumer Protection) មក ប្រចាំ ការ នៅ កម្ពុជា ដើម្បី ចែករំលែក បទពិសោធ និង លើកម្ពស់ ប្រសិទ្ធភាព ការងារ សំដៅ បង្កើន បរិមាណ នាំចេញ ផលិតផល កម្ពុជា ទៅ អូស្ដ្រាលី និង ស្នើសុំ ឲ្យ ភាគី អូស្ដ្រាលី បន្ដ គាំទ្រ ផ្ដល់ អាហារូបករណ៍ ជូន កម្ពុជា ។ លោក រដ្ឋមន្ដ្រី ក៏ បាន អញ្ជើញ ក្រុមហ៊ុន ពាណិជ្ជកម្ម អេឡិចត្រូនិច អូស្រ្ដាលី ទាំងឡាយ មក វិនិយោគ នៅ កម្ពុជា ផងដែរ ។
ជា ការឆ្លើយតប លោក ឯក អគ្គ រាជ ទូត បាន ជម្រាប លោក រដ្ឋមន្រ្ដី ថា អូស្រ្ដាលី នឹង បន្ដ ផ្ដល់ អាហារូបករណ៍ ជូន កម្ពុជា ហើយក៏ បាន កោតស សើរ កម្ពុជា ទោះបី ក្នុង ស្ថានភាព លំបាក់ ក្នុង វិបត្ត កូវីដ - ១៩ ការនាំចេញ អង្ករ ផ្កា ម្លិះ ខ្មែរ ទៅ អូស្ដ្រាលី បាន កើនឡើង ប្រមាណ ៦០ ភាគរយ ។
លោក ឯក អគ្គ រាជ ទូត ក៏ បាន ជម្រាប រដ្ឋមន្រ្ដី ប៉ាន សូរស័ក្តិ នូវ គម្រោង CAVAC ដែល ភាគី អូស្រ្ដាលី បាន គាំទ្រ ដែល ហ្វឹកហ្វឺន កសិករ ខ្មែរ ប្រមាណ ២. ០០០នាក់ ក្នុង វិស័យ អេឡិចត្រូនិច ដើម្បី លក់ ផលិតផល របស់ ខ្លួន តាម ប្រព័ន្ធ អនឡាញ ។
នៅក្នុង កិច្ចប្រជុំ លើក ទី១៨ នៃ គណៈកម្មការ ចម្រុះ កម្ពុជា - វៀតណាម ភាគី ទាំង ពីរ បាន កត់សម្គាល់ ឃើញ ពី មិត្តភាព រឹងមាំ ជា ប្រពៃណី ភាពជា អ្នកជិតខាង ល្អ និង ស្ថិរភាព យូរអង្វែង រួមទាំង ការលើកកម្ពស់ បន្ថែម នូវ ភាពជាដៃគូ យុទ្ធសាស្រ្ត គ្រប់ ជ្រុងជ្រោយ រវាង ប្រទេស ទាំង ពីរ ដែល បាន គូសបញ្ជាក់ តាមរយៈ កិច្ចសន្ទនា តាម ទូរស័ព្ទ និង ប្រព័ន្ធ វីដេអូ របស់ ថ្នាក់ដឹកនាំ និង ការផ្លាស់ប្តូរ ទស្សនកិច្ច របស់ ថ្នាក់ដឹកនាំ ជាន់ ខ្ពស់ ជា បន្តបន្ទាប់ នា ពេល កន្លងមក ។
ភាគី ទាំង ពីរ បាន អបអរសាទរ ចំពោះ កិច្ចសហប្រតិបត្តិការ ដ៏ មាន ប្រសិទ្ធភាព និង ការជួយគាំទ្រ គ្នា ទៅ វិញ ទៅមក ក្នុង ការការពារ និង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ រាតត្បាត កូវីដ - ១៩ ស្រប ពេល ដែល កំពុង ខិតខំ រក្សា លំហូរ ពាណិជ្ជកម្ម នៃ ទំនិញ ឆ្លងកាត់ ព្រំដែន និង ការវិនិយោគ ។
ភាគី ទាំង ពីរ បាន ឯកភាព ពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ការគាំទ្រ ទៅ វិញ ទៅ មក នៅ ថ្នាក់ តំបន់ និង អន្តរជាតិ បន្ត សម្របសម្រួល ក្នុង ការប្រយុទ្ធ ប្រឆាំង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន បទល្មើស ដែល បាន គ្រោង ទុក និង បទល្មើស អ៉ីនធឺណែត និង ធ្វើឲ្យ ប្រសើរ នូវ យន្តការ សម្រាប់ ការផ្លាស់ប្តូរ ព័ត៌មាន នៅ គ្រប់ វិស័យ ។
សម្រាប់ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ អប់រំ និង ធនធាន មនុស្ស លោក ប្រាក់ សុខុន បាន ថ្លែងអំណរគុណ ចំពោះ សមភាគី វៀតណាម ដែល បាន សម្របសម្រួល ឱ្យ និស្សិត កម្ពុជា អាច ចូលទៅ ប្រទេស វៀតណាម ឡើងវិញ បាន ដើម្បី បន្ត ការសិក្សា របស់ ពួកគេ ។ ភាគី ទាំង ពីរ បាន ឯកភាព បន្ត ផ្តល់ អាហារូបករណ៍ ឱ្យ គ្នា ទៅ វិញ ទៅ មក ដល់ សិស្ស - និស្សិត សម្រាប់ ឆ្នាំ សិក្សា ២០២០ និង ២០២១ ។
ចំពោះ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ភាគី ទាំង ពីរ បាន បញ្ជាក់ ជាថ្មី នូវ ការប្តេជ្ញាចិត្ត ដ៏ មោះ មុត និង កិច្ច ខិតខំ ប្រឹងប្រែង រួម ក្នុង ការគ្រប់គ្រង សកម្មភាព កេងប្រវ័ញ្ច ខុស ច្បាប់ នានា ការដឹកជញ្ជូន និង ការជួញដូរ ឈើ ហ៊ុប និង សត្វ ព្រៃ ខុស ច្បាប់ ឆ្លង ដែន ។ ភាគី ទាំង ពីរ ក៏ បាន ឯកភាព ធ្វើ ការសម្របសម្រួល យ៉ាង ជិតស្និទ្ធ ក្នុង ការពង្រឹង កិច្ចសហប្រតិបត្តិការ លើ ផ្នែក អនាម័យ សត្វ និង រុក្ខជាតិ ជល ផល កៅស៊ូ ផ្លែ ឈើ ផលិតផល សាច់ គោ សាច់ ជ្រូក និង ប្រព័ន្ធ ធារាសាស្ត្រ ។
ភាគី ទាំង ពីរ បាន បញ្ជាក់ ជាថ្មី នូវ ការប្តេជ្ញាចិត្ត ក្នុង ការធ្វើ ការរួមគ្នា ដើម្បី អនុវត្ត ឱ្យ បាន ជោគជ័យ នូវ គម្រោង នានា ផ្នែក បរិស្ថាន ធនធាន ទឹក និង ឧតុនិយម ។ ភាគី ទាំង ពីរ បាន ឯកភាព បង្កើន កិច្ចសហប្រតិបត្តិការ ក្នុង ការប្រើប្រាស់ ការគ្រប់គ្រង និង អភិវឌ្ឍ ធនធាន ទឹក ទន្លេ មេគង្គ ប្រកបដោយ ប្រសិទ្ធភាព និង និរន្តរភាព ក៏ ដូចជា ការជំរុញ ការការពារ និង អភិរក្ស បរិស្ថាន សកម្មភាព ពាក់ព័ន្ធ អាកាសធាតុ កំណើន បៃតង និង ការគ្រប់គ្រង ដីធ្លី ។
សម្រាប់ កិច្ចសហប្រតិបត្តិការ លើ វិស័យ ថាមពល ភាគី ទាំង ពីរ បាន ឯកភាព ក្នុង ការស្វែងរក កាលានុវត្តភាព សម្រាប់ កិច្ចសហប្រតិបត្តិការ ពាណិជ្ជកម្ម ក្នុង វិស័យ ថាមពល និង ការសិក្សា ស្រាវជ្រាវ រួម ស្តីពី ការអភិវឌ្ឍ ថាមពល ស្អាត និង ក កើត ឡើងវិញ ។
បន្ទាប់ពី កិច្ចប្រជុំ លើក ទី១៨ នៃ គណៈកម្មការ ចម្រុះ កម្ពុជា - វៀតណាម លោក ប្រាក់ សុខុន និង លោក ផាម ប៊ិញ មិញ បាន ធ្វើ ការចុះហត្ថលេខា លើ កំណត់ហេតុ នៃ កិច្ចប្រជុំ លើក ទី១៨ នៃ គណៈកម្មការ ចម្រុះ កម្ពុជា - វៀតណាម និង ធ្វើ ការផ្លាស់ប្តូរ លិខិតូបករណ៍ នៃ ការផ្ដល់ សច្ចាប័ន លើ សន្ធិសញ្ញា បំពេញ បន្ថែម លើ សន្ធិសញ្ញា កំណត់ ព្រំដែន រដ្ឋ ឆ្នាំ ១៩៨៥ និង សន្ធិសញ្ញា បំពេញ បន្ថែម ឆ្នាំ ២០០៥ និង ពិធីសារ ខណ្ឌ សីមា និង បោះ បង្គោល ព្រំដែន គោក រវាង ព្រះរាជាណាចក្រ កម្ពុជា និង សាធារណរដ្ឋ សង្គម និយម វៀតណាម ៕
អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា នៅ អាមេរិក និង ពលរដ្ឋ ខ្មែរ - អាមេរិក បរិច្ចាគ ប្រាក់ ១៥០. ៥៨៧ ដុល្លារ ដល់ សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ក្នុង ស្មារតី ស្រឡាញ់ ជាតិ មាតុភូមិ និង រួមចំណែក កាត់បន្ថយ ការលំបាក របស់ រាជ រដ្ឋាភិបាល លោក ម៉ឹង ពន្លក ប្រធាន សមាគម ចលនា យុវជន កម្ពុជា ( ក្រុម ១៥៧ ) តំណាង ឱ្យ ក្រុមការងារ រៀបចំ អង្គការ ចាត់តាំង យុវជន គណបក្ស ប្រជាជន កម្ពុជា នៅ សហរដ្ឋ អាមេរិក និង បងប្អូន ប្រជាពលរដ្ឋ ខ្មែរ - អាមេរិក នៅ ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន នាំយក ថវិកា ចំនួន ១៥០. ៥៨៧ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ការធ្វើ យុទ្ធនាការ រ៉ៃ អង្គាស ថវិកា នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ពី ការត្រៀម ថវិកា ទិញ វ៉ាក់សាំង កូវីដ - ១៩ មក ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ស្រប ពេល ដែល ជំងឺ កូវីដ - ១៩ បាន ឆ្លង ចូល ដល់ សហគមន៍ កម្ពុជា ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ថ្មី សាងសង់ សម្រេចបាន ៣៥ ភាគរយ ហើយ
( សៀមរាប ) ៖ រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល បាន អះអាង ថា គិត មក ត្រឹម ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ថ្មី សម្រេចបាន ៣៥ ភាគរយ ហើយ ។
ការបញ្ជាក់ នេះ ធ្វើឡើង ក្នុង ឱកាស ដែល នាយ ឧត្តមសេនីយ៍ បណ្ឌិត ម៉ៅ ហាវណ្ណាល់ រដ្ឋមន្ត្រី ទទួលបន្ទុក រដ្ឋលេខាធិការដ្ឋាន អាកាសចរ ស៊ីវិល បាន ដឹកនាំ មន្ត្រី ជាន់ ខ្ពស់ និង មន្ត្រី ជំនាញ ចុះ ត្រួតពិនិត្យ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ថ្មី នៅ ព្រឹក ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ។
លោក រដ្ឋមន្ត្រី ម៉ៅ ហាវណ្ណាល់ បាន ការកោតសរសើរ និង ថ្លែងអំណរគុណ ក្រុមហ៊ុន AIAI ដែល បាន ធ្វើ ការសាងសង់ អាកាសយានដ្ឋាន អន្តរជាតិ សៀមរាប អង្គរ ថ្មី តាម ផែនការ ដែល បាន គ្រោង ទុក ។
លោក ក៏ បាន លើកឡើង ផងដែរ ថា ប្រទេស កម្ពុជា ជាពិសេស ខេត្ត សៀមរាប នឹង ទទួលបាន នូវ អាកាសយានអន្តរជាតិ ថ្មី មួយ នា ឆ្នាំ ២០២៣ ឆាប់ ៗ ខាងមុខ ដែល នឹង ចូលរួមចំណែក ក្នុង ការទាក់ទាញ ភ្ញៀវ ទេសចរ មក ទស្សនា ខេត្ត សៀមរាប សំដៅ ជំរុញ កំណើន សេដ្ឋកិច្ច ជាតិ ការបង្កើន ការងារ និង ប្រាក់ ចំណូល ជូន ប្រជាពលរដ្ឋ និង រួមចំណែក ការអភិវឌ្ឍ ន៏ សង្គម ប្រកបដោយ ចីរភាព ។
សូម ជម្រាប ថា អាកាសយានដ្ឋាន អន្ត ជាតិ អង្គរ ថ្មី ជា ការវិនិយោគ ដោយ ក្រុមហ៊ុន មកពី ខេត្ត យូណាន ប្រទេស ចិន ក្នុង ទឹកប្រាក់ ៨៨០ លាន ដុល្លារ ស្ថិត នៅក្នុង ភូមិសាស្ត្រ ស្រុក សូទ្រនិគម នៅលើ ផ្ទៃដី ១៧០០ ហិកតា ។
ការលើកឡើង បែប នេះ របស់ លោក សោម អូន បាន ធ្វើឡើង នៅ ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ក្នុង ឱកាស ដែលោក បាន ដឹកនាំ ក្រុមការងារ ចុះ យុទ្ធនាការ អប់រំ និង ចែក ម៉ាស ដល់ បងប្អូន កម្មករ និយោជិត នៅ រោងចក្រ កាត់ដេរ សម្លៀកបំពាក់ ហ្គោល ដេន ហ្គ្រេស អឹភែរឹល ឯ . ក មាន ទីតាំង ស្ថិត នៅ ភូមិ អន្លង់ គង ថ្មី សង្កាត់ ព្រៃ ស ខណ្ឌ ដង្កោ រាជធានី ភ្នំពេញ ។
ក្នុង ឱកាស នោះ ដែរ លោក ក៏ បាន អំពាវនាវ ដល់ កម្មករ និយោជិត សូម កុំ ធ្វេសប្រហែស និង ត្រូវ បន្ត ចូលរួម អនុវត្ត ឱ្យ បាន ខ្ជាប់ខ្ជួន តាម វិធាន សុខាភិបាល ដើម្បី ការពារ ជំងឺ កូវីដ - ១៩ ។
លោក សោម អូន បាន បន្ថែម ថា ដោយសារតែ ប្រមុខ ដឹកនាំ មាន វិធានការ និង មាន យុទ្ធសាស្ត្រ ច្បាស់លាស់ ប្រកបដោយ គតិបណ្ឌិត បាន ធ្វើឱ្យ ជំងឺ កូវីដ - ១៩ នៅក្នុង ប្រទេស កម្ពុជា ស្ថិត ក្នុង ស្ថានភាព គ្រប់គ្រង បាន ។
មេសហជីព រូប នេះ ក៏ បាន លើកឡើង ថា ជាក់ស្តែង ថ្មី ៗ នេះ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា បាន នឹង កំពុង ស្វែងរក ការបញ្ជាទិញ ថ្នាំ វ៉ាក់សាំង ពី បរទេស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។ ប៉ុន្តែ ទោះ យ៉ាងណា ក៏ដោយ នៅក្នុង អន្តរកាល នេះ គឺ សូម បង កម្មករ និយោជិត ទាំងអស់ កុំ ធ្វេសប្រហែស ឱ្យ សោះ ពីព្រោះ ជំងឺ ឆ្លង ដ៏ កាច សាហាវ នេះ វា អាចនឹង ផ្ទុះឡើង គ្រប់ ពេលវេលា ។
លោក សោម អូន បាន អំពាវនាវ ដល់ បងប្អូន កម្មករ និយោជិត និង ថៅកែ រោងចក្រ បន្ត ចូលរួម អនុវត្ត នូវ អនុសាសន៍ របស់ សម្តេច នាយក រដ្ឋមន្ត្រី និង តាម សេចក្តីណែនាំ បន្ថែម របស់ ក្រសួង ការងារ លេខ ១៥៥ ចុះ ថ្ងៃទី២ ខែធ្នូ ឆ្នាំ ២០២០ ស្តីពី វិធានការ បង្ការ ជំងឺ កូវីដ - ១៩ នៅ តាម រោងចក្រ សហគ្រាស និង វិធានការ របស់ ក្រសួង សុខាភិបាល ។
សូម បញ្ជាក់ ថា បន្ទាប់ពី សំណេះសំណាល ជាមួយ គណៈកម្មាធិការ សហជីព ប្រធាន ក្រុម និង ប្រធាន ផ្នែក លោក សោម អូន និង ក្រុមការងារ ព្រមទាំង មន្ត្រី រដ្ឋបាល រោងចក្រ បាន អញ្ជើញ ធ្វើ ទស្សនកិច្ច និង សួរសុខទុក្ខ បងប្អូន កម្មករ នៅ តាម សង្វាក់ ផលិតកម្ម និង បាន ចែក ម៉ាស មួយចំនួន ជូន ដល់ បងប្អូន កម្មករ និយោជិត ដោយ ទទួលបាន គ្រប់ ៗ ៕ ក្រសួង ទេសចរណ៍ នឹង បើក វគ្គ បណ្ដុះបណ្ដាល ភាសា ចិន កម្រិត មូលដ្ឋាន ក្នុង វិស័យ ទេសចរណ៍ ដោយ ឥត គិត ថ្លៃ តាម អនឡាញ នៅ ដើម ឆ្នាំ ២០២១ ត ទៅ
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ នឹង បើក វគ្គ បណ្ដុះបណ្ដាល ភាសា ចិន កម្រិត មូលដ្ឋាន ក្នុង វិស័យ ទេសចរណ៍ ដោយ ឥត គិត ថ្លៃ តាម ប្រព័ន្ធ អនឡាញ ដល់ បុគ្គលិក បម្រើ ការងារ ក្នុង វិស័យ ទេសចរណ៍ យុវជន សិស្ស និស្សិត និង សាធារណជន ដែល មាន បំណង អភិវឌ្ឍ សមត្ថភាព លើ ជំនាញ នេះ ។
ច្បាប់ ស្ដីពី អភ័យ ឯក សិទ្ធិ ពេញ មួយ ជីវិត របស់ ប្រធានាធិបតី រុស្ស៊ី ខាងលើ គឺជា ផ្នែក មួយ នៃ ការធ្វើ វិសោធនកម្ម រដ្ឋធម្មនុញ្ញ ដែល ត្រូវបាន សភា រុស្ស៊ី អនុម័ត កាលពី រដូវ ក្ដៅ កន្លងទៅ នេះ ក្នុង គោលបំណង ត្រួសត្រាយ ឱ្យ លោក ពូទីន កាន់អំណាច រហូតដល់ ឆ្នាំ ២០៣៦ ឬ អស់ មួយ ជីវិត បើសិនជា លោក ចង់ ខណៈ បើ តាម រដ្ឋធម្មនុញ្ញ ចាស់ លោកពូទីន ត្រូវ ចុះចេញ ពី តំណែង នៅ ឆ្នាំ ២០២៤ ។
ធនាគារ ជាតិ នៃ កម្ពុជា និង ឡាវ ប្តេជ្ញា បន្ត ពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង ទ្វេ ភាគី ជា ប្រពៃណី ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត
( ភ្នំពេញ ) ៖ ធនាគារ ជាតិ នៃ កម្ពុជា និង ធនាគារ កណ្ដាល ឡាវ បាន ប្តេជ្ញា បន្ត ពង្រឹង និង ពង្រីក កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង ទ្វេ ភាគី ជា ប្រពៃណី ឱ្យ កាន់តែ រីកចម្រើន ថែម ទៀត ដើម្បី ជា ប្រយោជន៍ ដល់ ប្រទេស ទាំង ពីរ ដែល ឋិត នៅ ភូមិ ផង របង ជាមួយ ។
កិច្ចប្រជុំ ទ្វេ ភាគី រវាង ធនាគារ កណ្តាល ទាំង ពីរ ត្រូវបាន រៀបចំឡើង ជារៀងរាល់ ឆ្នាំ ក្នុង គោលបំណង ពង្រឹង កិច្ចសហប្រតិបត្តិការ និង ទំនាក់ទំនង ទ្វេ ភាគី សំដៅ រួមចំណែក ក្នុង ការអភិវឌ្ឍ វិស័យ ហិរញ្ញវត្ថុ និង សេដ្ឋកិច្ច និង ទំនាក់ទំនង មិត្តភាព រវាង ប្រទេស ទាំង ពីរ ។
កិច្ចប្រជុំ នេះ ភាគី ទាំង ពីរ បាន ពិភាក្សា ផ្លាស់ប្តូរ យោបល់ លើ ស្ថានភាព សេដ្ឋកិច្ច ការដឹកនាំ គោល នយោបាយ រូបិយវត្ថុ ការត្រួតពិនិត្យ ធនាគារ ជាពិសេស គោល នយោបាយ និង វិធានការ ដែល ប្រទេស ទាំង ពីរ អនុវត្ត ក្នុង ពេល ដែល ទទួល រង ឥទ្ធិពល អវិជ្ជមាន នៃ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ ។
ធនាគារ កណ្តាល ឡាវ និង ធនាគារ ជាតិ នៃ កម្ពុជា បាន ដើរ តួនាទី យ៉ាង សំខាន់ ក្នុង ការជួយ កាត់បន្ថយ ផល ប៉ះពាល់ មក លើ សេដ្ឋកិច្ច តាមរយៈ ការរក្សា ស្ថិរភាព ថ្លៃ និង ការអនុវត្ត គោល នយោបាយ រូបិយវត្ថុ វិត្ថារកម្ម ដើម្បី គាំទ្រ ការផ្តល់ សន្ទនីយភាព របស់ វិស័យ ធនាគារ ចំពោះ សកម្មភាព សេដ្ឋកិច្ច ។
ជាមួយគ្នា នេះ ធនាគារ កណ្តាល ទាំង ពីរ ក៏ បាន ចូលរួម ក្នុង ការជួយ សម្រាល បន្ទុក របស់ ប្រជាជន ក្រីក្រ និង ក្រុមហ៊ុន - សហគ្រាស ដែល ទទួលរង ការធ្លាក់ចុះ ចំណូល ដោយ បាន បន្ធូរបន្ថយ បញ្ញត្តិកម្ម មួយ ចំនួន ដែល ផ្តល់ លទ្ធភាព ឱ្យ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ អាច រៀបចំ ឥណទាន ឡើងវិញ បាន ។
ទន្ទឹម នេះ ធនាគារ កណ្តាល ទាំង ពីរ ក៏ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ វឌ្ឍនភាព នៃ កិច្ចសហប្រតិបត្តិការ ទ្វេ ភាគី ដែល បាន រួមចំណែក ពង្រឹង សមត្ថភាព ជំនាញ តាមរយៈ ការផ្លាស់ប្តូរ ចំណេះដឹង និង ជំនាញ និង ពង្រឹង ការអភិវឌ្ឍ វិស័យ ធនាគារ និង សេដ្ឋកិច្ច នៃ ប្រទេស ទាំង ពីរ ។
សូម បញ្ជាក់ ថា បច្ចុប្បន្ន ធនាគារ ពាណិជ្ជ ខ្មែរ ចំនួន ២ មាន វត្តមាន នៅ ប្រទេស ឡាវ និង មាន ការរីកចម្រើន គួរឱ្យ កត់សម្គាល់ ។ ធនាគារ រកណ្តាល ឡាវ បាន វាយតម្លៃ ខ្ពស់ ចំពោះ វិធានការ ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ - ១៩ និង ប្រសិទ្ធភាព នៃ គោល នយោបាយ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា ក្នុង ការគាំទ្រ សកម្មភាព សេដ្ឋកិច្ច ។
ធនាគារ កណ្តាល ឡាវ បាន ថ្លែងអំណរគុណ ដល់ ធនាគារ ជាតិ នៃ កម្ពុជា ដែល បាន ផ្តល់ ជំនួយ បច្ចេកទេស ដល់ ធនាគារ កណ្តាល ឡាវ នា ពេល កន្លងមក និង បាន ស្នើសុំ ការពង្រីក វិសាលភាព នៃ កិច្ចសហប្រតិបត្តិការ បន្ថែម លើ ការចែករំលែក បទពិសោធន៍ លើ ប្រព័ន្ធ ទូទាត់ ជាពិសេស ប្រព័ន្ធ បាគង និង បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ ។
លោក រដ្ឋមន្រ្តី បាន សម្តែង នូវ ការកោតសរសើរ ដល់ ក្រុមហ៊ុន ដែល បាន ផលិត ទឹក សម្លាប់ មេរោគ ប្រកបដោយ គុណភាព នៅ កម្ពុជា ដែល ជា ការចូលរួមចំណែក ដល់ ការការពារ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ និង មេរោគ នានា ។
លោកស្រី ហេង ពិសី បាន សម្តែង នូវ ការថ្លែងអំណរគុណ ដល់ លោក រដ្ឋមន្រ្តី ថោង ខុន ចំពោះ ការគាំទ្រ ដល់ ផលិតផល របស់ ក្រុមហ៊ុន ដែល លោក តែងតែ គិតគូរ ដល់ ការចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ និង ការជំរុញ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ប្រកបដោយ ចីរភាព ។
នា ឱកាស នោះ ក្រុមហ៊ុន បាន ចូលរួម ឧបត្ថម្ភ ដល់ ក្រសួង ទេសចរណ៍ នូវ ទឹក សម្លាប់ មេរោគ ម៉ាក Ebiodis ចំណុះ ៣០ លីត្រ ៥ លីត្រ ១ លីត្រ ៥០០ មីលីលីត្រ និង ១០០ មីលីលីត្រ ព្រមទាំង ឧបករណ៍ បាញ់ ស្វ័យប្រវត្តិ លើ តុ និង ឧបករណ៍ បាញ់ ស្វ័យប្រវត្តិ ព្យួរ ជញ្ចាំង ដើម្បី ប្រើប្រាស់ តាម ការចាំបាច់ ក្នុង ការចូលរួម បង្ការ ទប់ស្កាត់ មេរោគ ផ្សេង ៗ ពិសេស នៅក្នុង ដំណាក់កាល នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ ។
គួរ បញ្ជាក់ ថា បើ តាម ប៉ូលិស បារាំង ស្ត្រី ខាងលើ ត្រូវបាន សង្រ្គោះ ដោយ សុវត្ថិភាព ។ ខ្មាន់ កាំភ្លើង ក៏ បាន ដុត ផ្ទះ ផងដែរ តែ ត្រូវបាន ពន្លត់ ទាន់ ពេលវេលា ដោយ ក្រុម ពន្លត់ អគ្គិភ័យ ។ យ៉ាងណា ក៏ដោយ មិន ទាន់ មាន ព័ត៌មាន លម្អិត ពី ខ្មាន់ កាំភ្លើង នៅឡើយ ទេ ៕
UPDATE: ម្ចាស់ កាំភ្លើង ដែល ផ្តល់ឲ្យ បក្ខពួក បាញ់ សន្តិសុខ ក្រុមហ៊ុន សូ ងួន ស្លាប់ និង របួស នៅ ខេត្ត កំពត ត្រូវបាន កម្លាំង នគរបាល ចាប់ខ្លួន បាន ហើយ
លោក ឧត្តមសេនីយ៍ ស្នងការ បាន បញ្ជាក់ ថា « នៅ ពេល នេះ កម្លាំង ព្រហ្មទណ្ឌ របស់ យើង សហការ ជាមួយ កម្លាំង នគរបាល ខេត្ត ពោធិ៍សាត់ បាន ចាប់ខ្លួន ឈ្មោះ ហេង យ៉ុង ដែល ជា ម្ចាស់ កំា ភ្លើង បាន ហើយ តាម ដីកា បង្គាប់ ឲ្យ ចាប់ខ្លួន របស់ តុលាការ » ។
បើ តាម លោក ស្នងការ នៅ ពេល នេះ កម្លាំង នគរបាល របស់ លោក បាន និង កំពុង នាំ ខ្លួន ជន នេះ មកកាន់ ខេត្ត កំពត ដើម្បី ចាត់ការ បន្ត ទៀត ។
សូម រំលឹក ថា បក្ខពួក ខ្មាន់ កាំភ្លើង ២នាក់ ដែល បាញ់ សន្ដិសុខ ក្រុមហ៊ុន សូ ងួន បណ្ដាលឲ្យ ស្លាប់ ម្នាក់ និង របួស ធ្ងន់ ម្នាក់ ក្នុង ហេតុការណ៍ ប៉ះទង្កិច គ្នា ដោយ ជម្លោះ ដីធ្លី នៅ ស្រុក ឈូក ខេត្ត កំពត កាលពី ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ត្រូវបាន កម្លាំង នៃ ស្នងការដ្ឋាន នគរបាល ខេត្ត កំពត ចាប់ខ្លួន បាន នៅ ថ្ងៃទី ១៩ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
សូម រំលឹក ថា ជម្លោះ ដីធ្លី រវាង ប្រជាពលរដ្ឋ និង ក្រុមហ៊ុន ឧកញ៉ា សូ ងួន នៅ ឃុំ ត្រពាំង ផ្លាំង ស្រុក ឈូក ខេត្ដ កំពត រហូត ឈានដល់ ការប៉ះទង្កិច គ្នា មួយ ប្រាវ រវាង ពលរដ្ឋ និង សន្ដិសុខ ក្រុមហ៊ុន នៅ វេលា ម៉ោង ប្រមាណ ១០ព្រឹក ថ្ងៃទី ១៨ ខែវិច្ឆិកា ឆ្នាំ ២០២០ នេះ ។ ក្នុង ការប៉ះទង្កិច គ្នា នេះ ប្រជាពលរដ្ឋ បាន ប្រើប្រាស់ កាំភ្លើង ស្នប់ កែច្នៃ បាញ់ បណ្ដាលឲ្យ សន្ដិសុខ ម្នាក់ ស្លាប់ នៅ កន្លែង កើត ហេតុ និង ម្នាក់ រងរបួស ធ្ងន់ ។
អ្នកនាំពាក្យ រដ្ឋាភិបាល ជប៉ុន លោក កាត់ ស៊ូណូប៊ុ កាតុ (Katsunobu Kato) បាន គូសបញ្ជាក់ នៅ ថ្ងៃពុធ នេះ ថា « រដ្ឋាភិបាល ជប៉ុន នឹង បោះជំហាន ជា បន្តបន្ទាប់ ប្រកបដោយ ភាពបត់បែន ដើម្បី ទប់ស្កាត់ ការឆ្លង រាតត្បាត វីរុស នៅក្នុង ប្រទេស នេះ ។ យើង សូម អំពាវនាវ ឲ្យ ប្រជាជន ទាំងអស់ អត់ធ្មត់ និង ផ្អាក ការធ្វើដំណើរ ក្នុង រយៈពេល ខ្លី ទៅកាន់ ចក្រភព អង់គ្លេស » ។
អ្នកនាំពាក្យ ខាងលើ នេះ ក៏ បាន បញ្ជាក់ បន្ថែម ផងដែរ ថា អាជ្ញាធរ ជប៉ុន នឹង ស្មើ ឲ្យ ពលរដ្ឋ ជប៉ុន រួមទាំង ជន បរទេស ដែល បាន មក ស្នាក់ នៅ ជប៉ុន ក្នុង រយៈពេល វែង ត្រូវ ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ក្រោយ ត្រលប់ មកពី ចក្រភព អង់គ្លេស នៅ មុន ថ្ងៃព្រហស្បតិ៍ ស្អែក នេះ ។
បន្ថែម ពី ខាងលើ នេះ ទៀត ជនជាតិ ជប៉ុន ទាំងអស់ ដែល ត្រលប់ មកពី ចក្រភព អង់គ្លេស វិញ ក្រោយ បំរាម ខាងលើ នេះ ចូល ជាធរមាន នោះ នឹង តម្រូវឲ្យ មាន លិខិត បញ្ជាក់ ជា ផ្លូវការ ថា ពួកគេ បាន ទទួល ការធ្វើតេស្ត ចេញ លទ្ធផល « អវិជ្ជមាន » នៅ កំឡុង ពេល ៧២ ម៉ោង មុន ការចេញដំណើរ មកកាន់ ទឹកដី កំណើត វិញ ៕ រដ្ឋមន្រ្តី សង្គមកិច្ច នាំយក អំណោយ សម្តេច តេជោ ហ៊ុន សែន ទៅ ចែកជូន សមាគម សំនៀង ជន ពិការ
ថ្លែង នៅក្នុង ឱកាស នោះ លោក វង សូត បាន លើកឡើង ថា ការចែក អំណោយ ជូន ជន មាន ពិការភាព នា ពេល បាន បង្ហាញ ឲ្យ ឃើញ ពី ការគិតគូរ និង យកចិត្តទុកដាក់ ពី សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ដែល មាន ចំពោះ ជន មាន ពិការភាព នៅ កម្ពុជា ។
រដ្ឋមន្រ្តី វង សូត បាន បន្ថែម ថា « បើ ទោះបីជា ឆ្នាំ នេះ យើង មិន បាន រៀបចំ ប្រារព្ធ ទិវា ជន មាន ពិការ ភាព ក្តី ក៏ប៉ុន្តែ ការអនុវត្ត នូវ ផែនការ យុទ្ធសាស្ត្រ ជាតិ ស្តីពី ពិការភាព ការលើកកម្ពស់ សិទ្ធិ ជន មាន ពិការភាព នៅ កម្ពុជា របស់ យើង នៅតែ បន្ត អនុវត្ត ជារៀងរាល់ ថ្ងៃ ។
លោក រដ្ឋមន្ត្រី វង សូត នឹង ចាត់ លោក ឯ ម ច័ន្ទ មករា រដ្ឋលេខាធិការ និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ នាំយក អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ដើម្បី បន្ត ចែក ឱ្យ បាន ដល់ ដៃ របស់ ជន មាន ពិការ ភាព ដែល កំពុង ស្នាក់ នៅ តាម មជ្ឈមណ្ឌល ផ្សេង ៗ ទៀត នា ពេល ខាងមុខ ដ៏ ខ្លី នេះ ។
ជំហរ ខាងលើ បាន បង្ហាញ ឡើង ក្នុង ឱកាស ឧប នាយក រដ្ឋមន្រ្តី ប្រាក់ សុខុន រដ្ឋមន្រ្តី ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ នៃ កម្ពុជា បាន ធ្វើជា សហ ប្រធាន ដឹកនាំ កិច្ចប្រជុំ លើក ទី១៨ នៃ គណៈកម្មការ ចម្រុះ កម្ពុជា - វៀតណាម ជាមួយ ឧប នាយក រដ្ឋមន្រ្តី ផាម ប៊ិញ មិញ រដ្ឋមន្រ្តី ការបរទេស នៃ សាធារណរដ្ឋ សង្គម និយម វៀតណាម តាម ប្រព័ន្ធ វីដេអូ នា ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២០ ម្សិលមិញ ស្តីពី កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច វប្បធម៌ វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ។
ក្រសួង ការបរទេស បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ភាគី វៀតណាម បាន សម្តែង នូវ អំណរគុណ ចំពោះ ការគាំទ្រ និង កិច្ចសហប្រតិបត្តិការ ដែល ភាគី កម្ពុជា បាន ផ្ដល់ ដល់ ប្រទេស វៀតណាម ក្នុង អំឡុង ពេល ធ្វើជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២០ និង បាន សន្យា ផ្ដល់ ការគាំទ្រ ដល់ កម្ពុជា ក្នុង ការរៀបចំ ឱ្យ បាន ជោគជ័យ នូវ កិច្ចប្រជុំ កំពូល អាស៉ី - អឺរ៉ុប លើក ទី ១៣ នៅ ឆ្នាំ ២០២១ និង នៅពេល កម្ពុជា ធ្វើជា ប្រធាន អាស៊ាន ឆ្នាំ ២០២២ » ។
ភាគី ទាំង ពីរ បាន អបអរសាទរ ចំពោះ កិច្ចសហប្រតិបត្តិការ ដ៏ មាន ប្រសិទ្ធភាព និង ការជួយគាំទ្រ គ្នា ទៅ វិញ ទៅ មក ក្នុង ការការពារ និង ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ រាតត្បាត កូវីដ - ១៩ ស្រប ពេល ដែល កំពុង ខិតខំ រក្សា លំហូរ ពាណិជ្ជកម្ម នៃ ទំនិញ ឆ្លងកាត់ ព្រំដែន និង ការវិនិយោគ ។ សម្រាប់ កិច្ចសហប្រតិបត្តិការ ផ្នែក នយោបាយ និង សន្តិសុខ ភាគី ទាំង ពីរ បាន គូសបញ្ជាក់ ពី កិច្ច ខិតខំ ប្រឹងប្រែង រួម ក្នុង ការសម្របសម្រួល ជំហរ នៅក្នុង វេទិកា តំបន់ និង អន្តរជាតិ ជាពិសេស នៅក្នុង អាស៊ាន និង អង្គការ សហ ប្រជាជាតិ ។
របង ថ្ម នៅមុខ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី ស្ថាបនា សម្រេចបាន ៩០ ភាគរយ ហើយ . ក្រុមការងារ កំពុង សម្រុក លាប ថ្នាំ
( ភ្នំពេញ ) ៖ របង ថ្ម នៅមុខ ទីស្តីការ គណៈ រដ្ឋមន្ត្រី តាម បណ្តាយ មហាវិថី សហព័ន្ធ រុស្ស៊ី ប្រវែង ជិត ១គីឡូម៉ែត្រ ចាប់ពី ការាស សាំង តូតាល់ ជិត ស្តុប BKC ( កាណាឌីយ៉ា ) រហូតដល់ ស្តុប វត្ត នាគវ័ន បាន ដំណើរការ ស្ថាបនា លេចចេញ ជា របង ថ្ម បាន ប្រវែង ជាង ៤០០ ម៉ែត្រ ក្នុង ប្រវែង សរុប ៦៥០ ម៉ែត្រ ហើយ មកដល់ ពេលនេះ សម្រេចបាន ៩០ ភាគរយ គឺ បាន ឈានចូល ដល់ តំណាក់កាល នៃ ការលាប ថ្នាំ ។
មន្ត្រី រដ្ឋបាល រាជធានី ភ្នំពេញ បាន ឲ្យដឹង ថា គម្រោង នៃ ការរៀបចំ សាងសង់ របង ថ្ម នៅ តាម បណ្ដោយ មហាវិថី សហព័ន្ធ រុស្ស៊ី ទល់ មុខ ទីស្ដីការ គណៈ រដ្ឋមន្ត្រី នេះ រដ្ឋបាល រាជធានី ភ្នំពេញ គ្រោង ធ្វើជា ពីរ ដំណាក់កាល ក្នុង នោះ ដំណាក់កាល ទី១ ចាប់ផ្ដើម អនុវត្ត ការដ្ឋាន ចេញ ពី ការាស សាំង តូតាល់ រហូតដល់ ផ្លូវ R៦ ( ស្តុប ក្តាន់ ២) មាន ប្រវែង ៦៥០ ម៉ែត្រ កម្ពស់ ២ម៉ែត្រ ហើយ ក្នុង ដំណាក់កាល ទី១ នេះ ដែរ ។
គិត មកដល់ ពេលនេះ ក្រុមការងារ បាន ស្ថាបនា របង ថ្ម នេះ ទៅ តាម គម្រោង បាន សម្រេច ជាច្រើន រយ ម៉ែត្រ ហើយ គឺ បាន លេចចេញ ជា របង ( ចាប់ពី ការាស សាំង តូតាល់ រហូតដល់ ជិត ការាស លក់ រថយន្ត ) ហើយ ក្នុង ប្រវែង នេះ ក្រុមការងារ ស្ថាបនា សម្រេចបាន ៩០ ភាគរយ ហើយ ដោយ នៅ ល្ងាច ថ្ងៃទី ២២ធ្នូ នេះ ក្រុមការងារ កំពុង សម្រុក លាប ថ្នាំ បង្ហើយ ។ ចំពោះ ដំណាក់កាល ទី២ នឹង ចាប់ផ្ដើម ពី ផ្លូវ R៦ ( ស្តុប ក្តាន់ ២) នេះ រហូតដល់ ផ្លូវ បត់ ទៅ វត្ត នាគវ័ន ដែល មាន ប្រវែង ៤៣៧ ម៉ែត្រ ។
មន្ត្រី ជំនាញ បាន បញ្ជាក់ ថា ការរៀបចំ ធ្វើ របង ថ្ម ជាមួយនឹង ការរៀបចំ ការ៉ូឡា សម្រាប់ ថ្មើរជើង នេះ ធ្វើឡើង ដើម្បី លើក សោភណភាព រាជធានី ភ្នំពេញ ឲ្យ កាន់តែ ល្អ ប្រសើរ ដោយសារតែ ផ្លូវ សហព័ន្ធ រុស្ស៊ី ជា ផ្លូវ មួយ ដែល ភ្ញៀវ ជាតិ និង អន្តរជាតិ ឆ្លងកាត់ រាល់ ថ្ងៃ ដូច្នេះ ដាច់ខាត ត្រូវតែ រៀបចំ ផ្លូវ នេះ ឲ្យ មាន សោភណភាព និង សណ្ដាប់ធ្នាប់ ល្អ ប្រសើរ ។
គួរំលឹក ផងដែរ កាលពី ដើម ខែកក្កដា ឆ្នាំ ២០២០ កន្លង នេះ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ក៏ បាន ដឹកនាំ អាជ្ញាធរ ខណ្ឌ ដូនពេញ និង មន្ទីរ ជំនាញ ចុះ ពិនិត្យ មើល ស្ថានភាព នៃ គម្រោង នេះ ផងដែរ ដោយ បាន សូមឲ្យ បងប្អូន ប្រជាពលរដ្ឋ មេត្តា យោគយល់ និង ចូលរួម សហការ ជាមួយ រដ្ឋបាល រាជធានី ភ្នំពេញ ដោយ ហេតុ ថា កំណាត់ ផ្លូវ មួយ នេះ មិន មាន ផ្លូវ ថ្មើរជើង ដូច្នេះ យើង នឹង ធ្វើឲ្យ មាន ចិញ្ចើម សម្រាប់ អ្នក ថ្មើរជើង ដើរ ឲ្យបាន ស្អាត សម ជា ទីក្រុង ដែល ជា បេះដូង នៃ ព្រះរាជាណាចក្រ កម្ពុជា ៕
គួរឲ្យ អាសូរ ! ក្មេងប្រុស - ស្រី ២នាក់ សុំ ម្តាយ ទៅ លេង ទឹក លង់ ស្លាប់ ទាំង ២នាក់ យ៉ាង អណោច អធម៌ នៅ ខេត្ត បន្ទាយមានជ័យ
ក្រុមគ្រួសារ បាន ទៅ រក សព ឃើញ នៅ វេលា ម៉ោង ១២ ថ្ងៃត្រង់ ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២០ នៅ ចំណុច ក្លង ជិក អូរ ធំ ស្ថិត ក្នុង ភូមិ រស្មី សាមគ្គី សង្កាត់ និមិត្ត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
នគរបាល មូលដ្ឋាន បាន ឲ្យដឹង ថា ស ពក្មេង រងគ្រោះ ឈ្មោះ ម៉ៅ ដាវ ភេទ ប្រុស អាយុ ៥ ឆ្នាំ និង ម្នាក់ ទៀត ឈ្មោះ វ៉ង់ វិដា ភេទ ស្រី អាយុ ៦ឆ្នាំ ។ ក្មេង ទាំង ២នាក់ ជា បងប្អូន ជីដូនមួយ និង គ្នា រស់ នៅ ភូមិ រស្មី សាមគ្គី សង្កាត់ និមិត្ត ក្រុង ប៉ោយប៉ែត ខេត្ត បន្ទាយមានជ័យ ។
នគរបាល បាន បញ្ជាក់ ឲ្យដឹង ទៀត ថា បើ តាម ការរៀបរាប់ របស់ ម្តាយ ក្មេង រងគ្រោះ ឈ្មោះ ជុំ ស្រី ថា អាយុ ៣៦ ឆ្នាំ បាន ប្រាប់ សមត្ថកិច្ច ឲ្យដឹង ថា នៅ មុនពេល កើត ហេតុ កូន របស់ គាត់ ឈ្មោះ វ៉ង់ វិដា បាន ឲ្យ ថើប សុំ ម្តាយ ទៅ ចុះ ងូតទឹក ២នាក់ បងប្អូន ដោយ ក្តីអាណិត កូន ដែល ពីមុន ៗ មក មិន មាន សកម្មភាព ថើប ម្តាយ ។
ដោយ ក្តី លួងលោម ពេក ក៏ យល់ព្រម ឲ្យ ងូត ចុះ ងូតទឹក មួយ សន្ទុះ ក្រោយមក ឃើញ ក្មេង រងគ្រោះ ទាំង ២នាក់ បាន ឡើង មកវិញ ហើយ រួច ចូល ងូតទឹក អាង នៅក្នុង ផ្ទះ ដោយ នឹកឃើញ ថា ក្មេង ទាំង ២នាក់ បងប្អូន លឺ មាត់ នៅ អាងទឹក ក្នុង ផ្ទះ គាត់ មិន បាន ចាប់អារម្មណ៍ បន្ត កាប់ ឆ្ការ ស្មៅ ដុះ នៅក្បែរ ផ្ទះ ។
លុះ មួយ ស្របក់ ក្រោយមក ស្រាប់តែ បាត់ មាត់ គាត់ ដើរ ទៅ រក នៅ នឹង អាង មិន ឃើញ ហើយ បាន ឲ្យ ជីដូន ដើរ ទៅ រកមើល នៅ កន្លែង លក់ នំ មិន ឃើញ ពេល នោះ ឃើញ ខោអាវ នៅ មាត់ អូរ គាត់ បាន ចុះ រាវ មើល ស្រាប់តែ ប្រទះឃើញ កូនស្រី របស់ គាត់ បន្ទាប់មករាវ រកឃើញ ក្មួយ ប្រុស ម្នាក់ ទៀត បន្ត ។
នគរបាល មូលដ្ឋាន បាន បញ្ជាក់ ថា ក្រោយពី រាវ រកឃើញ ក្មេង ទាំង ២នាក់ ហើយ ឪពុក ម្តាយ បាន នាំ កូន ទៅ មណ្ឌល សុខភាព សង្កាត់ គ្រូពេទ្យ បាន និយាយ ថា ក្មេង ទាំង២ នាក់ បាន ស្លាប់ ហើយ ។
ដោយ មិន អស់ចិត្ត ឪពុក ម្តាយ បាន បន្ត យក ក្មេង ទាំង ២នាក់ ទៅ មន្ទីរពេទ្យ បង្អែក ក្រុង ប៉ោយប៉ែត ទៀត គ្រូពេទ្យ បាន ប្រាប់ ថា ក្មេង ទាំង ២នាក់ បាន បាត់បង់ជីវិត ហើយ ទើប អស់ចិត្ត យក កូន មក រៀបចំ ធ្វើ បុណ្យ តាម ប្រពៃណី ទាំង ក្តី សោក សៅ បំផុត ៕
ព្រះមហាក្សត្រ ចេញ ព្រះរាជ ក្រឹត្យ ត្រាស់បង្គាប់ ផ្ដល់ គោរមងារ ជា « ឧកញ៉ា » ដល់ លោក ស៊ីន ឃ ន
ការទទួលបាន គោរមងារ របស់ លោក ស៊ីន ឃ ន ត្រូវបាន ធ្វើឡើង តាម សំណើរ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ៕
ពេញ មួយ ថ្ងៃ អគ្គិភ័យ កើតឡើង ៦ករណី បណ្ដាលឲ្យ មនុស្ស ៥នាក់ រងរបួស ធ្ងន់ ស្រាល នៅ រាជធានី ភ្នំពេញ
( ភ្នំពេញ ) ៖ ពេញ មួយ ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២០ ម្សិលមិញ អគ្គិភ័យ កើតឡើង ជា បន្ដ បន្ទាប់ ចំនួន ៦ករណី នៅ រាជធានី ភ្នំពេញ បណ្ដាលឲ្យ មនុស្ស ៥នាក់ រងរបួស ធ្ងន់ ស្រាល ។ នេះ បើ តាម ការឲ្យដឹង ពី លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន នាយ ការិយាល័យ នគរបាល បង្ការ ពន្លត់ អគ្គ ភ័យ និង សង្គ្រោះ នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News នៅ ព្រឹក ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២០ ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន បាន បញ្ជាក់ ថា អគ្គិភ័យ កើតឡើង ទាំង៦ករណី នោះ រួម មាន៖
* លើក ទី ២៖ កើតឡើង នៅ តាម បណ្តោយ ផ្លូវ លេខ ២១៧ សង្កាត់ ស្ទឹងមានជ័យ ទី៣ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ដោយ ឆេះ បំផ្លាញ ទីតាំង អុច ធូក សែន អសនៈ ប៉ុន្ដែ ម្ចាស់ ផ្ទះ អាច ពន្លត់ បាន ដោយ ខ្លួន មិន រីករាលដាល នោះ ទេ
* លើក ទី ៣៖ កើតឡើង នៅ តាម បណ្តោយ ផ្លូវ ជាតិ លេខ ៥ សង្កាត់ ច្រាំង ចំរេះទី១ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ឆេះ ផ្ទះ ថ្ម ក្រោម ឈើ លើ ទំហំ ៥ម៉ែត្រ គុណ ៧ម៉ែត្រ ដោយ ឆេះ បំផ្លាញ ពូក ចំនួន មួយ និង សម្ភារ ប្រើប្រាស់ ប្រចាំ ថ្ងៃ ។ ចំពោះ មូលហេតុ បណ្តាល មកពី ការឆ្លង ចរន្ត អគ្គិសនី ក្នុង នោះ ប្រើប្រាស់ រថយន្ត ចំនួន ៤គ្រឿង . ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ៣ គ្រឿង ប្រើប្រាស់ ទឹក អស់ ១ឡាន និង រថយន្ត របស់ សាលា ខណ្ឌ ឫស្សីកែវ ១គ្រឿង ពុំ បាន ប្រើប្រាស់ ។
* លើក ទី ៤៖ កើតឡើង នៅ តាម បណ្តោយ ផ្លូវ លេខ ៥២៨ កែង ផ្លូវ ៣៣៩ សង្កាត់ បឹងកក់ទី១ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ដោយ ឆេះ បំផ្លាញ ខ្សែភ្លើង និង បង្គោល ភ្លើង ។ ចំពោះ មូលហេតុ ផ្ទុះ សេ ខ្សែភ្លើង ក្នុង នោះ ប្រើប្រាស់ រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន ១ គ្រឿង ។
* លើក ទី ៥៖ កើតឡើង នៅ តាម ផ្លូវ លេខ ៥២៨ កែង ផ្លូវ លេខ ៣៣៧ សង្កាត់ បឹងកក់ទី១ ខណ្ឌ ទួលគោក រាជធានី ភ្នំពេញ ដោយ ឆេះ បំផ្លាញ ខ្សែភ្លើង និង បង្គោល ភ្លើង ។ ចំពោះ មូលហេតុ ផ្ទុះ សេ ខ្សែភ្លើង ក្នុង នោះ ប្រើប្រាស់ រថយន្ត ពន្លត់ អគ្គិភ័យ ចំនួន ១ គ្រឿង ។
* លើក ទី ៦៖ កើតឡើង នៅ ខាងក្រោយ វិទ្យាល័យ បាក់ទូក សង្កាត់ វាលវង់ ខណ្ឌ ៧មករា រាជធានី ភ្នំពេញ ដោយ នៅក្នុង ករណី នេះ បាន បណ្តាលឲ្យ មនុស្ស ចំនួន ៥នាក់ បាន រងរបួស ធ្ងន់ ស្រាល ក្នុង មនុស្ស ប្រុស - ស្រី ២នាក់ រងរបួស ធ្ងន់ ត្រូវ ដឹក យក ទៅ សង្គ្រោះ បន្ទាន់ នៅ មន្ទីរពេទ្យ ខណៈ មនុស្ស ស្រី ៣នាក់ ទៀត រងរបួស ស្រាល ។
ចំពោះ មូលហេតុ បណ្តាល មកពី ការផ្ទុះ ធុង ហ្គាស ក្នុង នោះ ប្រើប្រាស់ រថយន្ត ចំនួន ៨ គ្រឿង ក្នុង នោះ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ ចំនួន ៧គ្រឿង និង រថយន្ត របស់ ផ្សារ អូឡាំព្យា ចំនួន ១ គ្រឿង ។
ជាមួយគ្នា នេះ លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន នាយ ការិយាល័យ បង្ការ ពន្លត់ អគ្គិភ័យ ក៏ បាន សំណូមពរ ដល់ ប្រជាពលរដ្ឋ ទាំងអស់ សូម មាន ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ បំផុត ជាពិសេស រដូវ ធ្លាក់ ខ្យល់ នេះ ត្រូវ យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ ភ្លើង ធូប ភ្លើង ទៀន និង ប្រព័ន្ធ អគ្គិសនី ឲ្យបាន ត្រឹមត្រូវ មុន ចាកចេញ ពី ផ្ទះ ។
លោក វរសេនីយ៍ ឯក ព្រហ្ម យ៉ន ក៏ បាន បន្ត ថា ប្រសិនបើ មាន ករណី គ្រោះ អគ្គិភ័យ កើតឡើង សូម ប្រជាពលរដ្ឋ រាយការណ៍ មកកាន់ លេខ ទូរស័ព្ទ បន្ទាន់ 666 មន្ត្រី ជំនាញ នឹង ចេញ ប្រតិបត្តិការ អន្តរាគមន៍ ជួយសង្គ្រោះ ភ្លាម ៗ តែម្តង ៕ រដ្ឋមន្រ្ដី ក្រសួង ពាណិជ្ជកម្ម ទទួល ជួប សម្ដែង ការគួរសម ឯក អគ្គ រដ្ឋទូត សិង្ហបុរី ដែល ចប់ អាណត្តិ នៅ កម្ពុជា
ជា ការចាប់ផ្ដើម លោក ឯក អគ្គ រដ្ឋទូត បាន អបអរសាទរ កម្ពុជា ចំពោះ ភាពជោគជ័យ នានា ក្នុង ការចរចា កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម ទ្វេ ភាគី ជាមួយ ប្រទេស ដៃគូ ។ លោក ក៏ បាន លើកឡើង អំពី ការចុះហត្ថលេខា នៃ កិច្ចព្រមព្រៀង ភាពជាដៃគូ សេដ្ឋកិច្ច គ្រប់ ជ្រុងជ្រោយ តំបន់ (RCEP) ដែល កម្ពុជា និង សិង្ហបុរី ជា សមាជិក ។
ក្នុង កិច្ចប្រជុំ នេះ លោក ឯក អគ្គ រដ្ឋទូត បាន សង្កត់ធ្ងន់ ថា កម្ពុជា និង សិង្ហបុរី ជា ប្រទេស តូច មែន ប៉ុន្ដែ មាន ការបើក ជំហរ សេដ្ឋកិច្ច ដូចគ្នា ។ លោក បាន អះអាង ថា សិង្ហបុរី និង កម្ពុជា នឹង រួម សហការ គ្នា បង្កើត មជ្ឈមណ្ឌល ភស្ដុភារកម្ម ភ្នំពេញ នៅ តំបន់ សេដ្ឋកិច្ច ពិសេស ភ្នំពេញ ដែល គ្រោង នឹង ចុះហត្ថលេខា នា ពេល ឆាប់ ៗ នេះ ដើម្បី ជួយ គាំពារ ដល់ ខ្សែ ច្រវ៉ាក់ ផ្គត់ផ្គង់ ផងដែរ ។
ជាមួយគ្នា នេះ រដ្ឋមន្រ្ដី ប៉ាន សូរស័ក្ដិ បាន ថ្លែង ថា កម្ពុជា និង សិង្ហបុរី ជា មិត្ត ជិតស្និត ហើយ តែងតែ រួម សហការ គ្នា ដើម្បី ទាញយក ផលប្រយោជន៍ ទៅ វិញ ទៅ មក ក្នុង គ្រប់ វេទិកា ទាំងអស់ ទាំង នៅ អង្គ ការ ពាណិជ្ជកម្ម ពិភពលោក អង្គការ កម្មសិទ្ធិ បញ្ញា ពិភពលោក អាស៊ាន និង វេទិកា ផ្សេង ៗ ទៀត ជាដើម ។ លោក បាន បន្ថែម ថា កន្លងមក ក្រសួង ពាណិជ្ជកម្ម ក៏ បាន យកចិត្តទុកដាក់ ជួយ ដោះស្រាយ បញ្ហា ដែល ធុរ ជន សិង្ហបុរី ជួបប្រទះ កន្លងមក ផងដែរ ។
លោក ឯក អគ្គ រដ្ឋទូត បាន ស្នើសុំ លោក រដ្ឋមន្រ្ដី បន្ដ ការគាំទ្រ និង កិច្ចសហប្រតិបត្តិការ ជាមួយ ឯក អគ្គ រដ្ឋទូត សិង្ហបុរី ដែល មកកាន់ អណត្តិ ថ្មី ហើយ លោក រដ្ឋមន្រ្ដី បាន ជម្រាប ជូន វិញ ថា នឹង បន្ដ សហការ ជាមួយ អគ្គ រដ្ឋទូត សិង្ហបុរី ប្រចាំ កម្ពុជា ថ្មី ដោយ ក្រសួង ពាណិជ្ជកម្ម កន្លងមក មាន ទំនាក់ទំនង និង កិច្ចសហប្រតិបត្តិការ យ៉ាង ល្អ ជាមួយ ប្រទេស សិង្ហបុរី កន្លងមក ដើម្បី ជុំ រុញ កិច្ចសហប្រតិបត្ត ទ្វេ ភាគី រវាង ប្រទេស ទាំង ពីរ បន្ដ ទៀត ។
( ភ្នំពេញ ) ៖ លោក សាយ សំអាល់ រដ្ឋមន្ត្រី រដ្ឋ បរិស្ថាន បាន លើកទឹកចិត្ត ដល់ កសិករ នៅក្នុង តំបន់ ការពារ ធម្មជាតិ ឱ្យ ចូលរួម អនុវត្ត គម្រោង អង្ករ មិត្តភាព សង្គ្រោះ សត្វ ព្រៃ ឱ្យ បាន កាន់តែ សកម្ម ថែម ទៀត ។ លោក ក៏ បាន ស្នើ ឱ្យ អង្គការ WCS និង អង្គការ SMP ពង្រីក គម្រោង នេះ ទៅកាន់ តំបន់ ផ្សេង ៗ ទៀត និង សំណូមពរ ឱ្យ ប្រជាពលរដ្ឋ កម្ពុជា នៅក្នុង ប្រទេស ជួយ គាំទ្រ ដល់ អង្ករ មិត្តភាព សង្គ្រោះ សត្វ ព្រៃ នេះ ។
ការជំរុញ បែប នេះ របស់ លោក រដ្ឋមន្ត្រី បរិស្ថាន បាន ធ្វើឡើង ក្នុង ឱកាស ដែល លោក ព្រមទាំង ថ្នាក់ដឹកនាំ ក្រសួង អញ្ជើញ ជា អធិបតីភាព សម្ពោធ ជា ផ្លូវការ ក្រុម អាយ ប៊ីសរ៉ាយស៍ ខន់ សេវេសិន ស្ថិត នៅ សង្កាត់ ផ្សារ ដើម ថ្កូវ រាជធានី ភ្នំពេញ និង ពិនិត្យមើល ខ្សែ សង្វាក់ វេចខ្ចប់ អង្គការ មិត្តភាព សង្គ្រោះ សត្វ ព្រៃ របស់ ក្រុមហ៊ុន ។
ក្រុមហ៊ុន អាយ ប៊ីសរ៉ាយស៍ ត្រូវបាន បង្កើតឡើង ដោយ អង្គការ សមាគមន៍ អភិរក្ស សត្វ ព្រៃ ក្នុង ឆ្នាំ ២០១៧ ដើម្បី បំពេញ សក្តានុពល នៃ ផលិតផល នេះ និង បង្កើន ការផលិត ។
បច្ចុប្បន្ន ក្រុមហ៊ុន អាយ ប៊ីសរ៉ាយស៍ ធ្វើការ ជាមួយ កសិករ សង្គ្រោះ សត្វ ព្រៃ ចំនួន ៥០០ គ្រួសារ ដោយ ផ្តល់ នូវ តម្លៃ លក់ ទិញ ចេញ ខ្ពស់ ជាង តម្លៃ ទីផ្សារ ១៥០ ភាគរយ ខ្ពស់ ជាង តម្លៃ ទីផ្សារ សម្រាប់ ស្រូវ សរីរាង្គ មិត្តភាព សង្គ្រោះ សត្វ ព្រៃ ពូជ ផ្កា រំដួល ។ កសិករ បាន ប្តេជ្ញា មិន កាប់ ឈើ មិន បរបាញ់ សត្វ ព្រៃ ឬ ប្រើប្រាស់ សារធាតុ គីមី ពុល ដើម្បី ចូលរួម ការពារ តំបន់ ការពារ និង ប្រភេទ កម្រ នៅក្នុង តំបន់ នេះ ។
ដោយឡែក លោក នីក ស្ពេន ស័រ (Nick Spencer) នាយក ក្រុមហ៊ុន អាយ ប៊ីសរ៉ាយស៍ បាន ថ្លែង យ៉ាង ដូច្នេះ ថា៖ « អតិថិជន គាំទ្រ និង ឱ្យ តម្លៃ លើ ផលិតផល និង គុណភាព អង្ករ មិត្តភាព សង្គ្រោះ សត្វ ព្រៃ របស់ យើង ដោយសារ អង្ករ នេះ ផលិត តាម គោលការណ៍ សរីរាង្គ ។ ក៏ប៉ុន្តែ មូលហេតុ ចម្បង ដែល នាំឱ្យ អតិថិជន ទិញ អង្ករ របស់ យើង គឺ ដោយសារ អង្ករ នេះ បាន ផ្សាភ្ជាប់ ទៅនឹង ការអភិរក្ស និង ការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាកសិករ ។
បើ តាម លោក កែន សេរី រដ្ឋា នាយក អង្គការ សមាគ អភិរក្ស សត្វ ព្រៃ កម្ពុជា បាន គូសបញ្ជាក់ ថា៖ « ការសម្រេចបាន លើ ការងារ អភិរក្ស តម្រូវ ឱ្យ យើង ត្រូវ ធ្វើការ យ៉ាង ជិតស្និទ្ធ ជាមួយ សហគមន៍ នៅក្នុង ដែន ជម្រក សត្វ ព្រៃ ដើម្បី ធានា ថា គោលបំណង របស់ ពួកគាត់ ត្រូវបាន ឆ្លើយតប ស្រប ពេល ដែល ទី ជម្រក សត្វ ព្រៃ នៅ ជុំវិញ តំបន់ ដែល ប្រជា សហគមន៍ រស់ នៅ ត្រូវបាន ការពារ ផងដែរ ។ គម្រោង ស្រូវ មិត្តភាព សង្គ្រោះ សត្វ ព្រៃ អាច ជា ឧត្តមានុវត្ត មួយ ដែល មាន ការទទួលស្គាល់ ជា សកល » ។
សូម ជម្រាប ថា សត្វ ត្រយង យក្ស គឺ ប្រភេទ បក្សី ដែល មាន មាឌ ធំ ជាង គេ បំផុត នៅលើ ពិភពលោក ហើយ ដោយសារតែ សត្វ នេះ ជា ប្រភេទ បក្សី កម្រ បាន ធ្វើឱ្យ អ្នក ចូលចិត្ត ទស្សនា សត្វ ស្លាប និង ក្រុម អ្នក អភិរក្ស គិត ថា ប្រភេទ នេះ ស្ទើរតែ លែង មាន វត្តមាន នៅលើ ពិភពលោក នេះ ទៅ ហើយ ។
ត្រយង យក្ស ត្រូវបាន ចាត់ ចំណាត់ថ្នាក់ ជា ប្រភេទ ជិត ផុត ពូជ បំផុត ជាពិសេស ដោយសារ ឥទ្ធិពល នៃ ការរំខាន របស់ មនុស្ស និង ការបរបាញ់ ។ សត្វ ត្រយង យក្ស ដែល នៅ សេសសល់ បាន ប្រមូលផ្តុំ គ្នា ទៅ រស់ នៅក្នុង តំបន់ ភាគ ខាងជើង នៃ ប្រទេស កម្ពុជា ។ ក្នុង ឆ្នាំ ២០០៩ អង្គការ WCS ក្រោម ការគាំទ្រ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា បាន បង្កើត គម្រោង ស្រូវ អាប៊ីស ដែល ជា វិធីសាស្ត្រ មួយ ជួយ គាំទ្រ ដល់ ការ អភិរក្ស ប្រភេទ នេះ ។
គម្រោង នេះ មាន គោលបំណង លើក ទឹកចិត្ត ដល់ សហគមន៍ មូលដ្ឋាន ឱ្យ ចូលរួម អភិរក្ស តាមរយៈ ការទិញ ស្រូវ សរីរាង្គ ពូជ ផ្កា រំដួល ក្នុង តម្លៃ មួយ ខ្ពស់ បំផុត ពី ក្រុម កសិករ ផលិត ដែល បាន ប្តេជ្ញាចិត្ត ចូលរួម ការពារ ព្រៃឈើ និង ឈប់ បរបាញ់ សត្វ ព្រៃ ។
គម្រោង នេះ បាន រួមចំណែក លើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ក្រុម កសិករ គោលដៅ ស្រប ពេល ជាមួយគ្នា ដែរ គឺ ដោះស្រាយ កត្តា គំរាមកំហែង ចំបង ៗ ចំពោះ ប្រភេទ ជិត ផុត ពូជ បំផុត រួមទាំង សត្វ ត្រយង យក្ស និង ការគំរាមកំហែង ដល់ ទី ជម្រក របស់ វា តាមរយៈ ការកាប់ រាន ដី ព្រៃ និង តំបន់ ដី សើម យក ធ្វើជា ស្រែ សម្រាប់ ដាំ ស្រូវ ។
