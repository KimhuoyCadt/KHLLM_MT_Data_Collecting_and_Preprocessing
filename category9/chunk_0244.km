( ប៉េកាំង ) ៖ ចិន បាន ធ្វើ បច្ចុប្បន្នភាព ក៏ ដូចជា ធ្វើ វិសោធនកម្ម ច្បាប់ ស្ដីពី វិស័យ ការពារ ជាតិ ដើម្បី កំណត់ ឱ្យ បាន ច្បាស់ ពី ធម្មជាតិ នៃ ការការពារ ខ្លួន និង តួនាទី របស់ កងទ័ព រំដោះ ប្រជាជន ចិន (PLA) នៅក្នុង ករណី មាន វិបត្តិ ណាមួយ កើតឡើង ខណៈ ខ្លួន កំពុង មាន ទំនាក់ទំនង ដ៏ តានតឹង ជាមួយ សហរដ្ឋ អាមេរិក ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន Sputnik នៅ រសៀល ថ្ងៃព្រហស្បតិ៍ ទី៣១ ខែធ្នូ ឆ្នាំ ២០២០ ។
គួរ បញ្ជាក់ ថា ការធ្វើ បច្ចុប្បន្នភាព ក៏ ដូចជា វិសោធនកម្ម ច្បាប់ ស្ដីពី វិស័យ ការពារ ជាតិ ខាងលើ ដែល មាន ៧៣ មាត្រា និង ១២ជំពូក នោះ នឹង ត្រូវ ចូល ជាធរមាន នៅ ថ្ងៃទី ០១ ខែមករា ឆ្នាំ ២០២១ ខាងមុខ នេះ ៕ មន្ទីរ មុខងារ សាធារណៈ ខេត្ត តាកែវ និង ខេត្ត កែប ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ មន្ទីរ មុខងារ សាធារណៈ ខេត្ត តាកែវ និង ខេត្ត កែប នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
មន្រ្តី ជាន់ ខ្ពស់ ក្រសួង ទេសចរ ណ៍៖ បរិស្ថាន គ្មាន ផ្សែង បារី ក្នុង វិស័យ ទេសចរណ៍ គឺជា ទប់ស្កាត់ ផល ប៉ះពាល់ សុខភាព និង បរិស្ថាន លើកកម្ពស់ វិស័យ ទេសចរណ៍
( ក្រចេះ ) ៖ លោក ហោ សារុន រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ បាន លើកឡើង ថា បរិស្ថាន គ្មាន ផ្សែង បារី ក្នុង វិស័យ ទេសចរណ៍ គឺជា គោលការណ៍ មួយ ដែល ក្រសួង ទេសចរណ៍ បាន ប្រកាន់ខ្ជាប់ ដើម្បី លើកកម្ពស់ ក្នុង ការទប់ស្កាត់ ផល ប៉ះពាល់ សុខភាព និង បរិស្ថាន ដែល កើតឡើង ពី ផលិតផល ថ្នាំជក់ និង ដើម្បី ធានា ឲ្យបាន ថា កម្ពុជា កំពុង អភិវឌ្ឍ វិស័យ ទេសចរណ៍ មួយ ដែល គ្មាន ផ្សែង បារី សាកសម ជា មាស បៃតង ដែល បាន ចូលរួម កសាង សេដ្ឋកិច្ច បៃតង និង សហគមន៍ បៃតង ។
ការលើកឡើង របស់ រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ រូប នេះ ធ្វើឡើង ក្នុង ពិធី បើក សិក្ខាសាលា និង ពិធី ចែក ពាន ស្តីពី បរិស្ថាន គ្មាន ផ្សែង បារី ក្នុង វិស័យ ទេសចរណ៍ ដំណាក់កាល កូវីដ - ១៩ នៅ សាលា ខេត្ត ក្រចេះ នា ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២០ ដែល មាន ការចូលរួម ពី លោកស្រី ខាំ សុភាព អភិបាល រង ខេត្ត ក្រចេះ ។
មូលដ្ឋាន អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ ដែល មាន ស្នាដៃ ឆ្នើម ត្រូវ ទទួល ពាន ទាំងនោះ ត្រូវបាន ជ្រើសរើស តាមរយៈ ការ ចុះ ត្រួតពិនិត្យ វាយតម្លៃ នៅ មូលដ្ឋាន ដោយ ផ្ទាល់ ពីសំណាក់ ក្រុមការងារ បរិស្ថាន គ្មាន ផ្សែង បារី ក្រសួង ទេសចរណ៍ សហការ ជាមួយ មន្ទីរ ពាក់ព័ន្ធ និង ដៃគូ កាលពី ថ្ងៃទី ២៤ ខែវិច្ឆិកា ឆ្នាំ ២០២០ ។
ជា លទ្ធផល ក្រុមការងារ ជ្រើសរើស បាន សណ្ឋាគារ ផ្ទះសំណាក់ ចំនួន ១៥ កន្លែង ក្នុង ចំណោម ២៨ កន្លែង ដែល បាន ចុះ ត្រួតពិនិត្យ និង ភោជនីយដ្ឋាន អាហារដ្ឋាន ចំនួន ១៥ កន្លែង ក្នុង ចំណោម ៣១ កន្លែង ដែល បាន ចុះ ត្រួតពិនិត្យ ដែល មាន ស្នាដៃ ឆ្នើម ក្នុង ការអនុវត្ត បរិស្ថាន គ្មាន ផ្សែង បារី ក្នុង វិស័យ ទេសចរណ៍ ។
ការជ្រើសរើស វាយតម្លៃ ផ្តល់ ជូន សណ្ឋាគារ ភោជនីយដ្ឋាន ឆ្នើម ដែល ទទួល ពាន បរិស្ថាន គ្មាន ផ្សែង បារី ក្នុង វិស័យ ទេសចរណ៍ គឺ ផ្អែក ទៅ លើ ពិន្ទុ នៃ កម្រង សំណួរ ដែល បាន រៀបចំឡើង ដោយ មាន សូចនាករ លក្ខណៈ វិនិច្ឆ័យ ត្រឹមត្រូវ យោង ទៅតាម ច្បាប់ ស្តីពី ការត្រួតពិនិត្យ ផលិតផល ថ្នាំជក់ និង លិខិត បទដ្ឋាន គតិយុត្ត នានា ក្រោម ច្បាប់ រួម មាន៖ អនុក្រឹត្យ ប្រកាស សារាចរ សេចក្តីណែនាំ ជាដើម ។
ចំណុច សំខាន់ ៗ ដែល មូលដ្ឋាន អាជីវកម្ម សេវាកម្ម ទេសចរណ៍ ត្រូវ ប្រកាន់ យក មាន ដូច ជា៖
១៖ ត្រូវ បិទ ផ្សាយ ឬ ដាក់ បម្រាម ហាម ជក់ នៅ តាម ផ្លូវ ចូល និង កន្លែង សមស្រប ដែល អាច មើលឃើញ ច្បាស់
២៖ មិន ត្រូវ ដាក់ តាំង ឬ បង្ហាញ ប្រដាប់ គោះ បារី
៣៖ ត្រូវ បង្គាប់ មិន ឲ្យ អ្នក ជក់ ឬ បង្ហុយ ផ្សែង ផលិតផល ថ្នាំជក់ ក្នុង កន្លែង ហាមឃាត់
៤៖ មិន ត្រូវ ផ្សាយ ពាណិជ្ជកម្ម ផលិតផល ថ្នាំជក់ ក្នុង បរិវេណ មូលដ្ឋាន របស់ ខ្លួន ទោះ ក្នុង ទម្រង់ ណា ក៏ដោយ
៥៖ អាច ដាក់ តាំង បង្ហាញ កញ្ចប់ ផលិតផល ថ្នាំជក់ ធម្មតា បាន តែ មួយ កញ្ចប់ ក្នុង មួយ ម៉ាក
៦៖ ត្រូវ ដាក់ តាំង បង្ហាញ ឬ លក់ តែ ផលិតផល ថ្នាំជក់ ណា ដែល មាន សារ ព្រមាន សុខភាព ជា រូបភាព និង ជា ភាសា ខ្មែរ ទំហំ ៥៥% បោះពុម្ព លើ ផ្នែក ខាងលើ ផ្ទៃ សំខាន់ ទាំង ពីរ នៃ កញ្ចប់ ផលិតផល ថ្នាំជក់ ៕
មន្ទីរ មុខងារ សាធារណៈ ខេត្ត រតនគិរី ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ មន្ទីរ មុខងារ សាធារណៈ ខេត្ត រតនគិរី នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ ព្រមទាំង បុគ្គលិក ទាំងអស់ នៃ ក្រុមហ៊ុន អូសិន ថេកណឡ ជី នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
មន្ទីរ មុខងារ សាធារណៈ ខេត្ត ស្វាយរៀង ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត មណ្ឌលគិរី ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ មន្ទីរ មុខងារ សាធារណៈ ខេត្ត ស្វាយរៀង ខេត្ត ត្បូងឃ្មុំ និង ខេត្ត មណ្ឌលគិរី នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
ក្រុមការងារ ពិសេស ថ្នាក់ ខេត្ត លុបបំបាត់ ជំងឺ គ្រុនចាញ់ ខេត្ត ស្ទឹងត្រែង បើក កិច្ចប្រជុំ ត្រួតពិនិត្យ ការងារ ប្រចាំ ត្រីមាស ទី៤ ឆ្នាំ ២០២០
( ស្ទឹងត្រែង ) ៖ ក្រុមការងារ ពិសេស ថ្នាក់ ខេត្ត លុបបំបាត់ ជំងឺ គ្រុនចាញ់ ខេត្ត ស្ទឹងត្រែង នៅ ព្រឹក ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២០ បាន រៀបចំ កិច្ចប្រជុំ ក្រុមការងារ ពិសេស ថ្នាក់ ខេត្ត លុបបំបាត់ ជំងឺ គ្រុនចាញ់ សម្រាប់ ត្រីមាស ទី៤ ឆ្នាំ ២០២០ ដើម្បី តាមដាន និង គ្រប់គ្រង ករណី ជំងឺ គ្រុនចាញ់ ឈាន ឆ្ពោះ ទៅរក ការលុបបំបាត់ ករណី ជំងឺ គ្រុនចាញ់ ស្រប តាម ទិសដៅ លុបបំបាត់ ជំងឺ ក្នុង ឆ្នាំ ២០២៥ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
កិច្ចប្រជុំ បាន ធ្វើឡើង នៅ សាល ប្រជុំ មន្ទីរ សុខាភិបាល ខេត្ត ស្ទឹងត្រែង ក្រោម វត្តមាន លោក ដួង ពៅ អភិបាល រង ខេត្ត និង ជា ប្រធាន ក្រុមការងារ ពិសេស ថ្នាក់ ខេត្ត លុបបំបាត់ ជំងឺ គ្រុនចាញ់ និង មាន ការចូល ពី លោក លោកស្រី អភិបាល រង ក្រុង ស្រុក អង្គការ ដៃគូ អភិវឌ្ឍន៍ និង អ្នក ពាក់ព័ន្ធ ជាច្រើន នាក់ ។
លោក វេជ្ជ រិន រ៉ាវុឌ្ឍន៍ ប្រធាន ការិយាល័យ បង្កា និង គ្រប គ្រង ជំងឺ នៃ មន្ទីរ សុខាភិបាល ខេត្ត ស្ទឹងត្រែង បាន ឲ្យដឹង ថា ស្ថានភាព ជំងឺ គ្រុនចាញ់ ក្នុង ខេត្ត ស្ទឹងត្រែង រយៈ៣ខែ ចុង ឆ្នាំ ២០២០ នេះ មាន ការថយចុះ ជាខ្លាំង បើ ប្រៀបធៀប រយៈពេល ដូចគ្នា នៅ ចុង ឆ្នាំ ២០១៩ ។ ហើយ នេះ បង្ហាញ ពី ជោគជ័យ មួយ កម្រិត ទៀត ក្នុង ការចូលរួម លុបបំបាត់ ជំងឺ គ្រុនចាញ់ ស្រប តាម ទិសដៅ ដែល បាន កំណត់ ។
លោក វេជ្ជ បាន រំលឹក ថា នៅក្នង អំឡុង រយៈពេល ៣ខែ ចុង២០១៩ កន្លងមក ឃើញ ថា មាន អត្រា អ្នក កើត ជំងឺ គ្រុនចាញ់ មាន រហូតដល់ ៦៩៣ ករណី ក្នុង នោះ ករណី ឆ្លង គ្រុនចាញ់ កាច សាហាវ មាន ១៧៨ ករណី ដោយឡែក ក្នុង រយៈ៣ខែ ចុង ឆ្នាំ ២០២០ ចាប់ពី ខែតុលា ដល់ ខែធ្នូ មាន ករណី កើត ជំងឺ គ្រុនចាញ់ ធ្លាក់ មក នៅ ត្រឹមតែ ១៦៦ ករណី និង ករណី អ្នក កើត គ្រុនចាញ់ កាច សាហាវ មាន ត្រឹមតែ ១៥ ករណី ប៉ុណ្ណោះ ។
លោក ដួង ពៅ អភិបាល រង ខេត្ត ស្ទឹងត្រែង និង ជា ប្រធាន ក្រុមការងារ ពិសេស ថ្នាក់ ខេត្ត លុបបំបាត់ ជំងឺ គ្រុនចាញ់ បាន ថ្លែង ថា ច្រើន ឆ្នាំ មក នេះ ការប្រយុទ្ធ នឹង ជំងឺ គ្រុនចាញ់ នៅ ប្រទេស កម្ពុជា ទទួលបាន ជោគជ័យ គួរឲ្យ កត់សម្គាល់ គឺ កាត់បន្ថយ បន្ទុក នៃ ជំងឺ ដោយ បាន ធ្វើឲ្យ អត្រា ឈឺ និង ស្លាប់ ដោយសារ ជំងឺ គ្រុនចាញ់ ធ្លាក់ចុះ ។
លោក ក៏ បាន បន្ដ ទៀត ថា ការលុបបំបាត់ ទាមទារ ឲ្យ មាន ការរៀបចំ មាន លក្ខណៈ ច្បាស់លាស់ ជាក់លាក់ និង ចាំបាច់ ត្រូវ មាន ការសម្របសម្រួល រវាង មជ្ឈមណ្ឌល ជាតិ ប្រយុទ្ធ នឹង ជំងឺ គ្រុនចាញ់ ប៉ារ៉ាស៊ីត សាស្ដ្រ និង បាណក សាស្ដ្រ ជាមួយនឹង ដៃគូ អភិវឌ្ឍន៍ នានា ។
លោក អភិបាល រង ខេត្ត បាន ណែនាំ ដល់ បុគ្គលិក គ្រប់ ជាន់ ថ្នាក់ ត្រូវ មាន ទំនួល ខុសត្រូវ ខ្ពស់ លើ ការងារ បញ្ហា ប្រឈម និង ដំណោះស្រាយ ផ្សេង ៗ ក្នុង ការយល់ដឹង ពី ជំងឺ គ្រុនចាញ់ អ្នក ពាក់ព័ន្ធ ពិសេស អាជ្ញាធរដែនដី ជួយ អប់រំ ឲ្យ មាន ភាព ទូលំទូលាយ សម្រាប់ ប្រជាពលរដ្ឋ ណែនាំ បន្ត តាម គ្រប់ រូបភាព គ្រប់ សកម្មភាព ដល់ ប្រជាពលរដ្ឋ ដែល ប្រឈម នឹង ជំងឺ គ្រុនចាញ់ នៅ តាម មូលដ្ឋាន ដែល មាន ការលំបាក ក្នុង ការគ្រប់គ្រង ទិន្នន័យ ប្រជាជន ប្រឈម នឹង ជំងឺ គ្រុនចាញ់ ។
ជាពិសេស អាជ្ញាធរដែនដី ជួយ ធ្វើ ក្នុង ការរៀបចំ និង ផ្តល់ព៌ ត័មាន ពី បញ្ហា ជំងឺ គ្រុនចាញ់ និង ត្រូវ ធ្វើ បច្ចុប្បន្នភាព សកម្មភាព អន្តរាគមន៍ នានា ដូចជា កាចែក មុង . អប់រំ ពី បញ្ហា ការការពារ ពី ជំងឺ គ្រុនចាញ់ នឹង ស្នើសុំ អ្នក ពាក់ព័ន្ធ ៕ មន្ទីរ មុខងារ សាធារណៈ ចំនួន ៦ រាជធានី - ខេត្ត ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ មន្ទីរ មុខងារ សាធារណៈ រាជធានី - ខេត្ត ចំនួន ៦៖ រួម មាន មន្ទីរ មុខងារ សាធារណៈ រាជធានី ភ្នំពេញ . ខេត្ត បន្ទាយមានជ័យ . ខេត្ត បាត់ដំបង . ខេត្ត ព្រះសីហនុ . ខេត្ត កំពត និង ខេត្ត ពោធិ៍សាត់ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
( ភ្នំពេញ ) ៖ លោក ទួន សុគន្ធ ប្រធាន មន្ទីរ សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ខេត្ត ព្រៃវែង និង មន្រ្តី រាជការ ទាំងអស់ នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
គ.ជ. ប បើក កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្តីពី ការផ្តល់ សុពលភាព និង ប្រកាស ផ្សាយ បញ្ជី បោះឆ្នោត ផ្លូវការ ឆ្នាំ ២០២០
( ភ្នំពេញ )៖ គណៈកម្មាធិការ ជាតិ រៀបចំ ការបោះឆ្នោត ( គ.ជ. ប ) នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន រៀបចំ កិច្ចប្រជុំ ជាមួយ ភាគី ពាក់ព័ន្ធ ស្តីពី ការផ្តល់ សុពលភាព និង ប្រកាស ផ្សាយ បញ្ជី បោះឆ្នោត ផ្លូវការ ឆ្នាំ ២០២០ ចំនួន អ្នក មាន ឈ្មោះ ក្នុង បញ្ជី បោះឆ្នោត និង ចំនួន ការិយាល័យ បោះឆ្នោត ។
កិច្ចប្រជុំ នេះ បាន ធ្វើឡើង នៅ សាល សន្និសីទ ជាន់ ទី១ នៃ ទីស្តីការ គ.ជ. ប ( វិថី រដ្ឋសភា សង្កាត់ ទន្លេបាសាក់ ខណ្ឌ ចំការមន រាជធានី ភ្នំពេញ ) ។
បើ តាម សេចក្តីជូនដំណឹង របស់ គ.ជ. ប បាន ឱ្យដឹង ថា ភាគី ពាក់ព័ន្ធ ដែល អញ្ជើញ ចូលរួម ក្នុង កម្មវិធី នេះ មាន ជា អាទិ៍៖ * តំណាង ក្រុមប្រឹក្សា ធម្មនុញ្ញ * តំណាង ព្រឹទ្ធសភា * តំណាង រដ្ឋសភា * ក្រសួង ពាក់ព័ន្ធ នានា * តំណាង គណបក្ស នយោបាយ * តំណាង អង្គការ មិន មែន រដ្ឋាភិបាល * អ្នកសារព័ត៌មាន ។
ហើយ សម្រាប់ របៀបវារៈ នៃ កិច្ចប្រជុំ នៅ ថ្ងៃ នេះ មាន ដូច ខាងក្រោម៖
អភិបាល ខេត្ត កណ្ដា ល៖ កងទ័ព ត្រូវ ស្មោះត្រង់ ការពារ បម្រើ សម្ដេច តេជោ ហ៊ុន សែន និង រាជ រដ្ឋាភិបាល កម្ពុជា ឲ្យបាន ល្អ និង ម៉ឺងម៉ាត់ បំផុត
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល បាន លើកឡើង ថា កងទ័ព ទាំងអស់ មាន កតព្វកិច្ច ធំ បំផុត ក្នុង ការការពារ ស្មោះត្រង់ បម្រើ សម្ដេច តេជោ ហ៊ុន សែន និង រាជ រដ្ឋាភិបាល កម្ពុជា ឲ្យបាន ល្អ និង ម៉ឺងម៉ាត់ បំផុត ដើម្បី ជា ខ្នង បង្អែក យ៉ាង រឹងមាំ ក្នុង ការការពារ ជាតិ ឲ្យ មាន សុខ សន្តិភាព មាន ស្ថេរភាព និង មាន សន្តិសុខ ល្អ បំផុត ។
អភិបាល ខេត្ត បាន ថ្លែង យ៉ាង ដូច្នេះ នៅក្នុង ពិធី សំណេះសំណាល សួរសុខទុក្ខ ជាមួយ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៅ អង្គភាព តំបន់ ប្រតិបត្តិការ សឹក រង នា ថ្ងៃទី ៣០ ខែធ្នូ ឆ្នាំ ២០២០ នៅឯ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត កណ្ដាល ។
អភិបាល ខេត្ត បាន ថ្លែង ទៀត ថា « អស់ លោក មាន សំណាង ណាស់ ដែល បាន បំពេញ កតព្វកិច្ច ជា កងទ័ព . ជា មន្ត្រី ដែល មាន ភ័ព សំណាង ជាង គេ មាន មោទកភាព ជាង គេ ព្រោះ មាន សម្ដេច តេជោ ហ៊ុន សែន ជា មេបញ្ជាការ ដ៏ ធំ បំផុត ជា នាយ ឧត្តមសេនីយ៍ ផ្កាយ មាស ៥ផុត លេខ និង ជា នាយក រដ្ឋមន្ត្រី ដែល មាន បេះដូង សន្តិភាព បេះដូង ស្នេហាជាតិ ស្រលាញ់ ជាតិ មាតុភូមិ ប្រជាជន និង គោរព ព្រះមហាក្សត្រ ដែល ទទួលបាន ការគាំទ្រ ពី ប្រជាជន ភាគ ច្រើន លើសលប់ » ។
ទន្ទឹមនឹង សារ នេះ ដែរ លោក អភិបាល ខេត្ត បាន ថ្លែងអំណរគុណ ដល់ កងទ័ព ទាំងអស់ នៅ ខេត្ត ដែល ជា ខ្នង បង្អែក យ៉ាង រឹងមាំ និង ខែល ការពារ សន្តិសុខ យ៉ាង រឹងមាំ និង តែងតែ ជួយ ខ្នះខ្នែ ដល់ ការងារ សង្គម ទូទៅ ដែល ត្រូវការ ជា ចាំបាច់ ខណៈ ទទួលបាន ការសាទរ ពី ប្រជាជន យើង យ៉ាង ច្រើន កុះករ ។
ស្ថិត នៅក្នុង ឱកាស នេះ ដែរ លោក នៃ និយម មេបញ្ជាការ តំបន់ ប្រតិបត្តិការ សឹក រង ខេត្ត កណ្ដាល បាន ថ្លែង ពី សមិទ្ធផល នានា ជាច្រើន ខណៈ លោក ជួស មុខ កងទ័ព ទាំងអស់ នៃ ខេត្ត កណ្ដាល សូម ថ្លែងអំណរគុណ ដល់ លោក អភិបាល ខេត្ត ដែល បាន ឧបត្ថម្ភ ថវិការ សាងសង់ អគារ បន្ថែម ទៀត ផងដែរ ៕ សមាគម អ្នកជំនាញ កុំព្យូរ ទ័រ កម្ពុជា ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ សមាគម អ្នកជំនាញ កុំព្យូរ ទ័រ កម្ពុជា នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
សហគមន៍ កសិកម្ម ស្វាយ កែវ រមៀត គិរីរម្យ ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា នៃ សហគមន៍ កសិកម្ម ស្វាយ កែវ រមៀត គិរីរម្យ សូម ចូលរួម អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
( ភ្នំពេញ ) ៖ ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង កម្ពុជា ព្រមទាំង សមាជិក សមាជិកា និង ថ្នាក់ដឹកនាំ សមាគម ទាំងអស់ នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ នេះ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
ជា លទ្ធផល ក្នុង រយៈពេល ២២២ ថ្ងៃ នៃ ការអនុវត្ត យុទ្ធនាការ នេះ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត ទូទាំង ប្រទេស បាន ដោះស្រាយ សំណុំរឿង ព្រហ្មទណ្ឌ ដែល កកស្ទះ ទាំង ដំណាក់កាល អយ្យការ ទាំង ដំណាក់កាល ស៊ើបសួរ និង ទាំង ដំណាក់កាល ជំនុំជម្រះ មាន ចំនួន សរុប ជាង ៣៥ ១០០ សំណុំរឿង ស្មើនឹង ៨៩ % នៃ សំណុំរឿង ព្រហ្មទណ្ឌ ដែល កក ស្ទះ ( សំណុំរឿង ដែល ត្រូវបាន ជំនុំជម្រះ រួច មាន ចំនួន ជាង ១២ ២០០ សំណុំរឿង ស្មើនឹង ៩៥ % នៃ សំណុំរឿង ទាំងអស់ ក្នុង ដំណាក់កាល ជំនុំជម្រះ ) ។
បន្ថែម ពី នេះ សាលាដំបូង រាជធានី ខេត្ត ទូទាំង ប្រទេស ក៏ បាន ដោះស្រាយ សំណុំរឿង ព្រហ្មទណ្ឌ ដែល ចូល ថ្មី ចំនួន ជាង ៣៦៥០០ សំណុំរឿង ស្មើនឹង ៧៣ % នៃ សំណុំរឿង ចូល ថ្មី ផងដែរ ។
គិត មកដល់ បច្ចុប្បន្ន នេះ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ខេត្ត សរុប ចំនួន ១៥ ហើយ ក្នុង ចំណោម សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត ចំនួន ២៤ បាន ប្រកាស បញ្ចប់ ដោយ ជោគជ័យ នៃ ការអនុវត្ត យុទ្ធនាការ នៅក្នុង ស្ថាប័ន របស់ ខ្លួន ដោយ បាន សម្រេច ដោះស្រាយ សំណុំរឿង ព្រហ្មទណ្ឌ ដែល កកស្ទះ បាន យ៉ាងតិច ៩៥ % និង សំណុំរឿង ដែល ចូល ថ្មី យ៉ាងតិច ៧០ % ។
តាម ការគ្រោងទុក យុទ្ធនាការ ដោះស្រាយ ការកកស្ទះ សំណុំរឿង នៅ តាម សាលាដំបូង រាជធានី ខេត្ត នឹង ត្រូវ ប្រើ រយៈពេល ១ ឆ្នាំ ដោយ ចាប់ផ្តើម គិត ពី ថ្ងៃ ប្រកាស បើក យុទ្ធនាការ កាលពី ថ្ងៃទី ១៨ ខែឧសភា ឆ្នាំ ២០២០ និង គ្រោង បញ្ចប់ នៅ ថ្ងៃទី ១៧ ខែឧសភា ឆ្នាំ ២០២១ ។
ផ្អែក លើ លទ្ធផល ដែល សម្រេចបាន រយៈពេល ២២២ ថ្ងៃ នេះ ជាមួយនឹង ការខិតខំ ប្រឹងប្រែង របស់ សាលាដំបូង និង អយ្យការ អម សាលាដំបូង រាជធានី ខេត្ត និង ដោយ មាន ការគាំទ្រ ពី គ្រប់ តួអង្គ ពាក់ព័ន្ធ ទាំងអស់ គ .យ . ក .ស. មាន ក្ដីរំពឹងទុក យ៉ាង មុតមាំ ថា សាលាដំបូង និង អយ្យការ អម សាលាដំបូង ទូទាំង ប្រទេស នឹង អនុវត្ត យុទ្ធនាការ សម្រេចបាន លទ្ធផល ជោគជ័យ ដោយ ធ្វើ ការដោះស្រាយ សំណុំរឿង កកស្ទះ ទាំងអស់ ហើយ ឈាន ទៅដល់ ការ ប្រកាស បិទ បញ្ចប់ នៃ ការអនុវត្ត យុទ្ធនាការ តាម ផែនការ ដែល បាន គ្រោង ទុក ៕
លទ្ធផល លម្អិត និង សង្ខេប នៃ ការអនុវត្ត យុទ្ធនាការ រយៈពេល ២២២ ថ្ងៃ មាន ភ្ជាប់ ជា ឧបសម្ព័ន្ធ នៃ សេចក្ដីប្រកាស ព័ត៌មាន ខាងក្រោម នេះ៖
អាមេរិក បញ្ជូន យន្តហោះ ទម្លាក់ គ្រាប់បែក B-52 ពីរ គ្រឿង ទៅ មជ្ឈិមបូព៌ា ដើម្បី កំញើញ សត្រូវ ! (Video inside) ( វ៉ាស៊ីនតោន ) ៖ យោធា អាមេរិក នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ បាន ឱ្យដឹង ថា ខ្លួន បាន បញ្ជូន យន្ដហោះ ទម្លាក់ គ្រាប់បែក ពីរ គ្រឿង ទៅកាន់ តំបន់ មជ្ឈិមបូព៌ា ដើម្បី បង្ហាញ ពី អនុភាព ក្នុង ការកំញើញ និង ទប់ស្កាត់ ការវាយប្រហារ ណាមួយ ពី សត្រូវ មក លើ ផលប្រយោជន៍ អាមេរិក នៅក្នុង តំបន់ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន ចិន ស៊ីន ហួ នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ ទី៣១ ខែធ្នូ ឆ្នាំ ២០២០ ។
នៅក្នុង សេចក្ដីថ្លែងការណ៍ របស់ ខ្លួន ទី បញ្ជាការ កណ្ដាល អាមេរិក (CENTCOM) បាន គូសបញ្ជាក់ យ៉ាង ដូច្នេះ ថា « ការបញ្ជូន យន្ដហោះ ទម្លាក់ គ្រាប់បែក B-52 ពីរ គ្រឿង ទៅកាន់ តំបន់ មជ្ឈិមបូព៌ា ក៏ ជា ការបង្ហាញ ផងដែរ ពី ការប្ដេជ្ញាចិត្ត របស់ យោធា អាមេរិក ចំពោះ សន្តិសុខ នៅក្នុង តំបន់ ព្រមទាំង បង្ហាញ ពី សមត្ថភាព តែ មួយ គត់ ដែល អាច ឆ្លើយតប យ៉ាង ឆាប់រហ័ស ទៅនឹង ការគំរាមកំហែង ទាំងឡាយ » ។
គួរ បញ្ជាក់ ថា ការដាក់ពង្រាយ យន្ដហោះ ទម្លាក់ គ្រាប់បែក B-52 ខាងលើ បាន កើត មាន ឡើង បន្ទាប់ពី ស្ថានទូត អាមេរិក ប្រចាំ ទីក្រុង បាកដាដ ប្រទេស អ៉ីរ៉ាក់ រង ការវាយប្រហារ ដោយ គ្រាប់ រ៉ុក្កែត ជាច្រើន គ្រាប់ កាលពី ថ្ងៃទី ២០ ខែធ្នូ នេះ តែ មិន បណ្ដាលឱ្យ មាន អ្នកស្លាប់ ឬ រងរបួស ឡើយ ។
សហរដ្ឋ អាមេរិក បាន ចោទ ថា អ៉ី រ៉ង់ និង ក្រុម ប្រដាប់អាវុធ គាំទ្រ ដោយ ទីក្រុង តេហេរ៉ង់ គឺជា អ្នក នៅ ពីក្រោយ ការវាយប្រហារ ខាងលើ នេះ ខណៈ ក្រុម មន្ត្រី ចារកម្ម អាមេរិក បាន ព្រមាន ទៀត ថា អ៉ីរ៉ង់ ឬ សម្ព័ន្ធមិត្ត របស់ អ៉ីរ៉ង់ អាចនឹង ដឹកនាំ ការវាយប្រហារ លើ អាមេរិក ឬ សម្ព័ន្ធមិត្ត អាមេរិក នៅក្នុង តំបន់ នៅ ថ្ងៃ គម្រប់ ខួប មួយ ឆ្នាំ នៃ ការស្លាប់ របស់ មេទ័ព កំពូល អ៉ី រ៉ង់ លោក កាស្សេម សូឡែ មេនី (Qassem Soleimani) ដែល ត្រូវបាន យន្ដហោះ ដ្រូន អាមេរិក ផ្ដាច់ ជីវិត កាលពី ថ្ងៃទី ០៣ ខែមករា ដើម ឆ្នាំ ២០២០ កន្លងទៅ ៕
ធនាគារ ជាតិ នៃ កម្ពុជា៖ សេដ្ឋកិច្ច កម្ពុជា រំពឹង ងើប ឡើងវិញ ក្នុង រង្វង់ ៤ភាគរយ ក្នុង ឆ្នាំ ២០២១
ប៉ុន្ដែ តាមរយៈ របាយការណ៍ របស់ ធនាគារ ជាតិ នៃ កម្ពុជា បាន ឲ្យដឹង ថា ការរំពឹង ងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច កម្ពុជា ក្នុង រង្វង់ ៤ភាគរយ នេះ អាស្រ័យ លើ បរិការណ៍ ដែល ថ្នាំ បង្ការ មាន ប្រសិទ្ធិភាព អាច ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ ប៉ុណ្ណោះ ។
ការព្យាករណ៍ ពី ការងើប ឡើងវិញ នៃ សេដ្ឋកិច្ច កម្ពុជា របស់ ធនាគារ ជាតិ នៃ នេះ បន្ទាប់ពី មូលនិធិ រូបិយវត្ថុ អន្តរជាតិ រំពឹង ថា សេដ្ឋកិច្ច ពិភពលោក អាច ងើប ឡើងវិញ ក្នុង ឆ្នាំ ២០២១ ប៉ុន្តែ មាន ភាព មិន ស្មើ សាច់ នៅឡើយ និង អាច ប្រឈម នឹង ភាព មិន ប្រាកដប្រជា ខ្ពស់ ។
របាយការណ៍ របស់ ធនាគារ ជាតិ បញ្ជាក់ ថា « ក្នុង បរិការណ៍ ដែល ថ្នាំ បង្ការ មាន ប្រសិទ្ធភាព អាច ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ១៩ បាន ក្នុង ឆមាស ទី១ ឆ្នាំ ២០២១ នោះ សេដ្ឋកិច្ច កម្ពុជា រំពឹង ថា នឹង អាច ងើប ឡើងវិញ ក្នុង រង្វង់ ៤% ហើយ អត្រា អតិផរណា រំពឹង ថា មាន កម្រិត ក្រោម ៣% ដែល ជា កម្រិត ទាប អាច គ្រប់គ្រង បាន ជាមួយនឹង ស្ថិរភាព អត្រា ប្តូរ ប្រាក់ និង ការរក្សា បាន កម្រិត ខ្ពស់ នៃ ទុន បម្រុង អន្តរជាតិ » ។
ចំណែកឯ ស្ថាប័ន ហិរញ្ញវត្ថុ អន្តរជាតិ នានា បាន ព្យាករណ៍ ថា អត្រា កំណើន សេដ្ឋកិច្ច កម្ពុជា អាច សម្រេចបាន ពី ៤% ទៅ៦. ៨% ។ ទោះ យ៉ាងណា ការព្យាករ ទាំង នេះ អាស្រ័យ ជា ចម្បង លើ ប្រសិទ្ធភាព នៃ ថ្នាំ បង្ការ . ល្បឿន នៃ ការងើប ឡើងវិញ នៃ កំណើន ក្នុង ប្រទេសជា ដៃគូ សេដ្ឋកិច្ច ជាមួយ កម្ពុជា និង ការពង្រឹង មូលដ្ឋាន សេដ្ឋកិច្ច ក្នុង ស្រុក ។
វិស័យ កម្មន្ត សាល រំពឹង ថា នឹង ងើបឡើង ជាលំដាប់ ជាពិសេស វិស័យ កាត់ដេរ សម្លៀកបំពាក់ និង ស្បែកជើង ខណៈ ដែល វិស័យ កសិកម្ម រំពឹង ថា នឹង បន្ត មាន កំណើន ល្អ ដូច ឆ្នាំ ២០២០ ដែរ ។ ទន្ទឹម នេះ ការនាំចេញ ផលិតផល កសិកម្ម ជាពិសេស អង្ករ និង កៅស៊ូ រំពឹង ថា មាន សន្ទុះ កំណើន ខ្ពស់ ដែល គាំទ្រ ដោយ ការធ្វើ ពិពិធកម្ម ទីផ្សារ កសិផល កម្ពុជា និង កំណើន តម្រូវការ កៅស៊ូ ក្នុង ស្ថានភាព នៃ ការប្រសើរឡើង នៃ សេដ្ឋកិច្ច ពិភពលោក ។
វិស័យ សំណង់ និង អចលទ្រព្យ រំពឹង ថា ងើបឡើង សន្សឹម ៗ ស្រប ពេល ជាមួយនឹង កំណើន វិនិយោគ ផ្ទាល់ បរទេស . ការងើប ឡើងវិញ នៃ ចំណូល និង ការរំពឹងទុក ពី ការរីកចម្រើន សេដ្ឋកិច្ច ជា រួម នា ពេល អនាគត ។ ម៉្យាងទៀត វិស័យ សណ្ឋាគារ និង ភោជនីយដ្ឋាន ក៏ ដូចជា វិស័យ ដឹកជញ្ជូន នឹង អាច បន្ត កើន ឡើងវិញ ប៉ុន្តែ ក្នុង ល្បឿន យឺត ដោយសារ ការធ្លាក់ចុះ ទេសចរ អន្តរជាតិ បើ ទោះបីជា ទេសចរ ក្នុង ស្រុក មាន ភាព សកម្ម ជាង មុន ក៏ដោយ ៕
គិត ត្រឹម ថ្ងៃព្រហស្បតិ៍ ទី៣១ ខែធ្នូ ឆ្នាំ ២០២០ នេះ តែម្តង ប្រទេស ចិន បាន អនុម័ត ឲ្យ ប្រើប្រាស់ វ៉ាក់សាំង ប្រឆាំង វីរុស COVID-19 ផលិត នៅក្នុង ស្រុក ចំនួន ០៥ រួចទៅហើយ ដោយ បូករួម ទាំង វ៉ាក់សាំង របស់ Sinopharm ។ បើ តាម ក្រសួង វិទ្យាសាស្ត្រ និង បច្ចេកវិទ្យា ចិន វ៉ាក់សាំង ចំនួន ១៤ ផ្សេង ទៀត កំពុង ស្ថិត ក្នុង ការធ្វើតេស្ត ក្នុង នោះ ០៥ កំពុង ស្ថិត ក្នុង ការធ្វើតេស្ត ដំណាក់កាល ទី ៣ ដែល ជា ដំណាក់កាល ចុងក្រោយ ។
គួរ បញ្ជាក់ ថា ប្រទេស ចិន ក៏ ត្រូវបាន ចាត់ទុក ផងដែរ ថា បាន និង កំពុង គ្រប់គ្រង ការឆ្លង រាតត្បាត COVID-19 ក្នុង ប្រទេស ប្រកបដោយ ជោគជ័យ ប៉ុន្តែ នៅ មួយ រយៈពេល ខ្លី ចុងក្រោយ នេះ ការឆ្លង ក្នុង សហគមន៍ បាន កើត មាន ឡើង ជារឿយ ៗ ជាពិសេស នៅក្នុង រដ្ឋធានី ប៉េកាំំង ដែល កំពុង បង្ខំ ឲ្យ អាជ្ញាធរ ចិន បង្កើន ការប្រុងប្រយ័ត្ន ឡើងវិញ ចំពោះ មុខ ថ្ងៃ ឈប់សម្រាក ចូល ឆ្នាំ ថ្មី ៕មី ជាតិ ប្រកាស ជ័យលាភី ប្រកួតប្រជែង ផលិត វីដេអូ « តោះ ! ធ្វើ ល្អ »
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន មីជាតិ បាន ប្រកាស លទ្ធផល ម្ចាស់ ជ័យលាភី នៃ កម្មវិធី ប្រកួតប្រជែង ផលិត វីដេអូ « តោះ ! ធ្វើ ល្អ » ដែល បាន ធ្វើឡើង នៅ រោងចក្រ មីជាតិ ក្រោម ការចូលរួម ពី ថ្នាក់ដឹកនាំ នៃ ក្រុមហ៊ុន គណៈកម្មការ វាយតម្លៃ និង ក្រុម យុវជន ដែល បាន ចូលរួម ក្នុង ការប្រកួតប្រជែង ជាច្រើន រូប ។
ការជួយគ្នា ក្នុង គ្រា អាសន្ន គឺជា ការបង្ហាញ អំពី ទឹកចិត្ត ថ្លៃថ្លា ដែល មនុស្ស គ្រប់ គ្នា ត្រូវ ប្រកាន់ភ្ជាប់ ដែល នេះ ជា ខ្លឹមសារ នៃ វីដេអូ ជ័យលាភី មួយ ក្នុង ចំណោម វីដេអូ ជ័យលាភី ទាំង៣ នៃ កម្មវិធី ប្រកួតប្រជែង ផលិត វីដ អូ « តោះ ! ធ្វើ ល្អ » ដែល រៀបចំឡើង ដោយ ក្រុមហ៊ុន មីជាតិ ។
កម្មវិធី ប្រកាស ជ័យលាភី កាលពី ពេល ថ្មី ៗ កន្លងទៅ នេះ លោក ហុង សុវណ្ណ ប្រធាន ផ្នែក ទីផ្សារ នៃ ក្រុមហ៊ុន មីជាតិ បាន ឱ្យដឹង ថា កម្មវិធី ប្រកួតប្រជែង « តោះ ! ធ្វើ ល្អ » បាន ប្រព្រឹត្តទៅ ក្រោម ប្រធានបទ « ចូលរួម លើកកម្ពស់ ក្រមសីលធម៌ សង្គម ឲ្យ កាន់តែ ប្រសើរ » ជា កម្មវិធី ប្រកួតប្រជែង ផលិត វីដ អូ ខ្លី ដែល បាន បង្កើតឡើង នៅ ដើម ខែតុលា ឆ្នាំ ២០២០ ក្នុង គោលបំណង ជំរុញ និង ចូលរួម លើកកម្ពស់ សីលធម៌ សង្គម តាមរយៈ ការផលិត និង ផ្សព្វផ្សាយ វីដេអូ ខ្លី ។
លោក ហុង សុវណ្ណ បាន បន្ថែម ថា វីដេអូ ទាំងអស់ ដែល បាន ចូលរួម ការប្រកួតប្រជែង សុទ្ធសឹង ជា វីដេអូ មាន គុណភាព និង បាន បង្កប់ នូវ ខ្លឹមសារ ល្អ ជាសារ អប់រំ ដូចជា ការជួយគ្នា ការយល់ អធ្យាស្រ័យ គ្នា ការលើកទឹកចិត្ត ការគោរព គ្នា ការឲ្យ តម្លៃ គ្នា ការស្រលាញ់ រាប អាន គ្នា ជាដើម ។
លោក ឡាវ វ៉ាន់ នាយក គ្រប់គ្រង ក្រុមហ៊ុន មីជាតិ មានប្រសាសន៍ ដែរ ថា ការប្រតិបត្តិ សីលធម៌ សង្គម គឺជា កត្តា សំខាន់ ដើម្បី ចូលរួម ធ្វើឲ្យ សង្គម រស់ នៅ ដោយ ក្តីរីករាយ ។ ការចូលរួម លើកកម្ពស់ សីលធម៌ សង្គម ជា កាតព្វកិច្ច របស់ យើង ម្នាក់ ៗ ដែល ត្រូវ បំពេញ រាល់ ថ្ងៃ គ្រប់ ទង្វើ ល្អ ទោះជា សកម្មភាព តូច ឬ ធំ គឺ សុទ្ធតែ មាន គុណ តម្លៃ មិន អាច កាត់ថ្លៃ បាន ។ មាន តែ ការរួមគ្នា បង្កើត អនុវត្ត និង កែលំអរ ជា ប្រចាំ ទើប សង្គម មាន ការរស់នៅ ប្រកបដោយ ភាពក្សេមក្សាន្ត ទាំងអស់ គ្នា ។
មីជាតិ ក្នុង នាម ជា ក្រុមហ៊ុន ឯកជន ខ្មែរ មួយ តែងតែ រីករាយ បង្កើត និង គាំទ្រ រាល់ សកម្មភាព ដែល ផ្តល់ ប្រយោជន៍ ដល់ សង្គម និង ប្រជាជន ខ្មែរ ។ មីជាតិ សង្ឃឹម ថា ទង្វើ ល្អ សុជីវធម៌ និង សីលធម៌ សង្គម នឹង បន្ត រីកសាយភាយ ពេញ ក្នុង សង្គម ជា និរន្ត ។
( ភ្នំពេញ ) ៖ ឧត្ដមសេនីយ៍ ឯក ខឹម សន និង ឧត្ដមសេនីយ៍ ឯក យ៉ាល់ ពិសិដ្ឋ នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា នៃ សភា មុខរបរ និង មីក្រូស ហគ្រាស កម្ពុជា សម្តែង នូវ ការអបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ទទួលបាន សមិទ្ធផល ប្រវត្តិសាស្ត្រី ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ។
ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា នៃ សភា មុខរបរ និង មីក្រូស ហគ្រាស កម្ពុជា បន្ថែម ថា « សន្តិភាព » របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី គឺជា កត្តា សារវន្ត មិន អាច ខ្វះ បាន សម្រាប់ ការសម្រេច ជោគជ័យ លើ សមិទ្ធផល ជាតិ ជា បន្តបន្ទាប់ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យំ រួមទាំង សមិទ្ធផល ថ្មី ក្នុង វិស័យ ប្រេងកាត ដែល ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស បាន ទន្ទឹងរង់ចាំ ជាច្រើន ជំនាន់ យូរ លង់ ណាស់ មកហើយ ។
ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សម តារា ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធ ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សម តារា អនុ រដ្ឋលេខាធិការ ក្រសួង មហាផ្ទៃ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
រដ្ឋបាល ស្រុក គិរី វង់ ខេត្ត តាកែវ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ រដ្ឋបាល ស្រុក គិរី វង់ ខេត្ត តាកែវ ព្រមទាំង ក្រុមប្រឹក្សា មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ ព្រះសង្ឃ និង ប្រជាពលរដ្ឋ ក្នុង ស្រុក នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ នេះ សម្តែង នូវ ការអបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ទទួលបាន សមិទ្ធផល ប្រវត្តិសាស្ត្រី ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ។
ក្នុង នាម ក្រុមប្រឹក្សា ស្រុក គណៈ អភិបាល ស្រុក មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ កងកម្លាំងប្រដាប់ អាវុធ គ្រប់ ប្រភេទ និង ប្រជាពលរដ្ឋ ទូទាំង ស្រុក គិរី វង់ ពិតជា មាន សេចក្តីរំភើប ឥត ឧបមា និង សូម សម្តែង នូវ អំណរ សាទរ ប្រកបដោយ មនោសញ្ចេតនា គោរព ដឹងគុណ ដ៏ ជ្រាវ ជ្រៅ បំផុត ជូន ចំពោះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ដែល បាន ខិតខំ ប្រឹងប្រែង ដឹកនាំ ប្រទេស កម្ពុជា សម្រេចបាន ជោគជ័យ ទទួលបាន សមិទ្ធផល ធំ ៗ ជា ប្រវត្តិសាស្ត្រ នេះ ។
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ៖ តំណក់ ប្រេង លើក ដំបូង របស់ កម្ពុជា ជា ការបើក សករាជ ប្រវត្តិសាស្ត្រ ថ្មី ក្នុង ការអភិវឌ្ឍ វិស័យ ឧស្សាហកម្ម ប្រេងកាត
( ភ្នំពេញ ) ៖ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន ចាត់ទុក ថា ការទទួលបាន តំណក់ ប្រេង លើក ដំបូង របស់ កម្ពុជា ជា ការបើក នូវ សករាជ ប្រវត្តិសាស្ត្រ ថ្មី ក្នុង ការអភិវឌ្ឍ វិស័យ ឧស្សាហកម្ម ប្រេងកាត ដែល ជា ធនធាន ដ៏ មាន តម្លៃ រួមចំណែក លើកកម្ពស់ សេដ្ឋកិច្ច - សង្គម កម្ពុជា ។
លិខិត របស់ សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន ឲ្យដឹង ថា ព្រឹទ្ធសភា នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន សំដែង នូវ ការចូលរួម អបអរ សមិទ្ធផល ជា ប្រវត្តិសាស្រ្ត ថ្មី ដែល ព្រះរាជាណាចក្រ កម្ពុជា ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ស្រប ពេល ថ្ងៃ ខួប អនុស្សាវរីយ៍ លើក ទី ២២ នៃ ការអនុវត្ត ដោយ ជោគជ័យ នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន ដែល បាន នាំមក នូវ ការបង្រួបបង្រួម ជាតិ សន្តិភាព ស្ថិរភាព និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យ ។
សម្តេច វិបុល សេនា ភក្តី សាយ ឈុំ បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ការទទួលបាន តំណក់ ប្រេង លើក ដំបូង នេះ ជា ការបើក នូវ សករាជ ប្រវត្តិសាស្ត្រ ថ្មី សម្រាប់ ព្រះរាជាណាចក្រ កម្ពុជា ក្នុង ការអភិវឌ្ឍ វិស័យ ឧស្សាហកម្ម ប្រេងកាត ដែល ជា ធនធាន ដ៏ មាន តម្លៃ រួមចំណែក លើកកម្ពស់ សេដ្ឋកិច្ច - សង្គម កម្ពុជា ជាពិសេស ការលើកកម្ពស់ វិស័យ អាទិភាព វិស័យ អប់រំ និង វិស័យ សុខាភិបាល ដែល វិស័យ សំខាន់ សម្រាប់ ការអភិវឌ្ឍ កម្ពុជា » ។
សម្តេច ប្រធាន ព្រឹទ្ធសភា ថែមទាំង បាន វាយតម្លៃ ខ្ពស់ បំផុត ចំពោះ សម្តេច តេជោ ចំពោះ ការដឹកនាំ ដ៏ ឆ្នើម និង ឈ្លាសវៃ ប្រកបដោយ គុណ បំណាច់ ដ៏ ថ្លៃថ្លា និង វីរភាព ដ៏ ឧត្តុង្គឧត្តម ក្នុង ការនាំមក នូវ ជោគជ័យ ធំ ថ្មី ១ជា បន្តបន្ទាប់ សម្រាប់ ប្រជាជាតិ កម្ពុជា ទាំងមូល ។
ហេដ្ឋារចនាសម្ព័ន្ធ ផលិតកម្ម ប្រេង ធំ ៗ និង សំខាន់ ៗ ដែល បាន សាងសង់ តម្លើង និង រៀបចំ រួចរាល់ ជា ស្ថាពរ នៅក្នុង តំបន់ ប្លុក A សម្រាប់ ដំណើរការ ផលិតកម្ម ជា រួម មាន៖
* ផ្លាត ហ្វម អណ្តូង ប្រេង ផលិត នៅ កោះ បាតាង នៃ ប្រទេស ឥណ្ឌូនេស៊ី ចាប់ផ្តើម សាងសង់ នៅ អំឡុង ខែធ្នូ ឆ្នាំ ២០១៩ និង បាន បញ្ចប់ នៅ ខែសីហា ២០២០ ។ ផ្លាត ហ្វម នេះ បាន ដឹក ចូលមកដល់ តំបន់ ប្លុក A និង បាន បញ្ចប់ ការតម្លើង រួចរាល់ ជា ស្ថាពរ នៅ ថ្ងៃទី៧ កញ្ញា ២០២០ ។
* កប៉ាល់ ផលិតកម្ម ប្រេង បាន តម្លើង ជួសជុល និង បំពាក់ សម្ភារៈ បរិក្ខា រួចរាល់ នៅ ខែកញ្ញា ២០២០ នៅ ប្រទេស សឹង្ហបុរី និង បាន ដឹក មកដល់ និង តម្លើង រួចរាល់ នៅ ប្លុក A នៅ ថ្ងៃទី ១៨ ខែតុលា ឆ្នាំ ២០២០ ។ កប៉ាល់ ស្តុក ប្រេង បាន រៀបចំ និង ត្រៀម ចាំ រួចរាល់ នៅ ប្លុក A នៅ ថ្ងៃទី ៩ ខែវិច្ឆិកា ២០២០ ។
អណ្តូង ប្រេង ទី មួយ បាន បញ្ចប់ ការសាងសង់ នៅ ថ្ងៃទី ២៣ ធ្នូ ២០២០ និង ចាប់ផ្តើម ផលិត ចេញ ប្រេង ដំបូង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ២០២០ នេះ ។ ក្រៅពី នេះ មាន អណ្តូង ប្រេង ចំនួន ពីរ ទៀត ក៏ បាន ខួង ជម្រៅ ដល់ ស្រទាប់ ជម្រក រ៉ែ ប្រេង រួចហើយ ដែរ ។ ការចាប់ផ្តើម ផលិតកម្ម ប្រេង នេះ គឺជា ពរ ជ័យ សម្រាប់ កម្ពុជា ។
សម្តេច សង្កត់ធ្ងន់ ថា ចូល ឆ្នាំ សកល ថ្មី ២០២១ ខាងមុខ ទោះ យើង មិន បាន សប្បាយរីករាយ ដូច ឆ្នាំ មុន ៗ ដោយសារតែ កូវីដ - ១៩ តែ យើង ទទួលបាន កាដូ ដ៏ ធំ សម្រាប់ ជាតិ យើង នោះ គឺ ប្រេង ដែល ផលិត ចេញ លើក ដំបូង ក្នុង ទឹកដី យើង ។ ឆ្នាំ ថ្មី សមិទ្ធផល ថ្មី សម្រាប់ សេដ្ឋកិច្ច កម្ពុជា ចាប់ពី ដើម ឆ្នាំ ២០២១ត ទៅ ៕ ពលករ ខ្មែរ មកពី ថៃ វិល តាម ច្រក ទ្វារ អន្តរជាតិ ចាំ យាម ច្រក របៀង និង តាម ផ្លូវ ទឹក សរុប ៣០ នាក់ ក្នុង ខេត្ត កោះកុង លទ្ធផល ធ្វើតេស្ត អវិជ្ជមាន កូវីដ
លោក វេជ្ជបណ្ឌិត ទៅ ម៉ឹង បាន ឲ្យដឹង បន្ថែម ថា រយៈពេល ២ ថ្ងៃ នេះ ពុំ មាន ពលករសំណាក់ ស្រុក ឆ្លង ដែន ពី ប្រទេស ថៃ វិល ចូល ស្រុក កំណើត វិញ តាម ច្រក ទ្វារ អន្តរជាតិ ច្រក របៀង និង តាម ផ្ទៃ ទឹក នោះ ទេ ។
លោក វេជ្ជបណ្ឌិត បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន គ្រប់ មូលដ្ឋាន ត្រូវ មាន ការប្រុងប្រយ័ត្ន ឲ្យបាន ខ្ពស់ ដើម្បី ការពារ ជំងឺ ឆ្លង កូវីដ១៩ កុំ មាន ការរីករាលដាល ពីព្រោះ ជំងឺ កូវីដ១៩ ជា ជំងឺ ឆ្លង សកល ដែល គួរឲ្យ ភ័យខ្លាច ៕
អ្នកនាំពាក្យ ក្រសួង ការពារ ជាតិ ចិន លោក វូ ឈាន (Wu Qian) បាន ថ្លែង នៅ ព្រឹក ថ្ងៃព្រហស្បតិ៍ នេះ ថា « សកម្មភាព របស់ នាវា ចម្បាំង អាមេរិក បាន បញ្ជូន សញ្ញា ខុស មួយ ទៅកាន់ ក្រុម មាន ចេតនា បំបែក ខ្លួន ដែល កំពុង ចង់បាន ឯករាជ្យភាព ឲ្យ តៃវ៉ាន់ និង ធ្វើឱ្យ អន្តរាយ ដល់ សន្តិភាព ព្រមទាំង ស្ថិរភាព យ៉ាង ធ្ងន់ធ្ងរ នៅ ទូទាំង ច្រក សមុទ្រ តៃវ៉ាន់ » ។
អ្នកនាំពាក្យ ខាងលើ នេះ បាន សង្កត់ធ្ងន់ ទៀត ថា « កងទ័ព ប្រជាជន ចិន (PLA) នឹង បង្កើន ស្មារតី កម្រិត ខ្ពស់ ដើម្បី ត្រៀមខ្លួន ឲ្យបាន រួច ជាស្រេច ក្នុង ការដោះស្រាយ រាល់ ការគំរាមកំហែង និង ការបង្កហេតុ ទាំងឡាយ ដើម្បី ការពារ អធិបតេយ្យភាព ជាតិ និង បូរណភាព ទឹកដី យ៉ាង ម៉ឺងម៉ាត់ » ។
( ភ្នំពេញ ) ៖ បណ្ឌិត សភាចារ្យ ហង់ ជួន ណារ៉ុន រដ្ឋមន្ដ្រី ក្រសួង អប់រំ យុវជន និង កីឡា បាន ជូន ដំណឹង ដល់ បេក្ខជន ដែល បាន ប្រឡង ជាប់ សញ្ញាបត្រ មធ្យម
សិក្សា ទុតិយភូមិ សម័យ ប្រឡង ២១ ធ្នូ ២០២០ ប្រញ៉ាប់ រួសរាន់ ទៅ ដាក់ពាក្យ នៅ តាម គ្រឹះស្ថាន ឧត្តម សិក្សា ដែល ធ្លាប់ បាន ជ្រើសរើស កន្លងមក ដើម្បី ទទួលបាន អាហារូបករណ៍ ។
ក្នុង ឆ្នាំ សិក្សា ២០២០ - ២០២១ ដើម្បី ទទួលបាន អាហារូបករណ៍ ចូលរៀន ថ្នាក់ បរិញ្ញាបត្រ មិន បង់ ថ្លៃ សិក្សា ១០០ % នៅ តាម គ្រឹះស្ថាន ឧត្តម សិក្សា ដែល បេក្ខជន បាន ដាក់ពាក្យ ស្នើសុំ កន្លងមក ( នៅ ថ្នាក់ ទី១២ ) សូម បេក្ខជន ប្រញ៉ាប់ រួសរាន់ ទៅ ដាក់ពាក្យ នៅ តាម គ្រឹះស្ថាន ឧត្តម សិក្សា ដែល បេក្ខជន បាន ជ្រើសរើស « មុខជំនាញ ទី១ » កន្លងមក ។
( ភ្នំពេញ ) ៖ ខ្ញុំបាទ ថោង វរ លក្ខណ៍ អ្នកតំណាងរាស្ត្រ មណ្ឌល ខេត្ត ព្រៃវែង និង ជា ប្រធាន ក្រុមការងារ គណបក្ស ចុះ ជួយ ស្រុក ពាមរក៍ ព្រមទាំង ប្រជាពលរដ្ឋ ទូទាំង ស្រុក នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
ឧត្តមសេនីយ៍ ឯក ស ថេត គោរព វិញ្ញាណក្ខន្ធ និង បំពាក់ ស័ក្តិ ថ្នាក់ វរសេនីយ៍ ឯក ( ស័ក្តិ៥) ជូន សព របស់ លោក វរសេនីយ៍ ទោ រ៉េត ស៉ី ណែត ក្រោយ គេ បាញ់ ស្លាប់ ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍
( ភ្នំពេញ ) ៖ ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ នៅ ព្រឹក ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ បាន ដឹកនាំ ស្នងការ រង នាយ ការិយាល័យ និង មន្ត្រី ជាច្រើន រូប ចូលរួម ពិធី បុណ្យ សព គោរព វិញ្ញាណក្ខន្ធ និង បំពាក់ ស័ក្តិ វរសេនីយ៍ ឯក ជូន សព របស់ លោក វរសេនីយ៍ ទោ រ៉េត ស៉ី ណែត ហៅ ញ៉ក់ ដែល ត្រូវបាន ជន ដៃ ដល់ បាញ់ ស្លាប់ ដោយសារ គ្រោះថ្នាក់ ចរាចរណ៍ កាលពី រំលង អធ្រាត្រ យប់ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២០ ។
នៅក្នុង ឱកាស នោះ លោក ឧត្តមសេនីយ៍ ឯក ស្នងការ បាន បង្ហាញ អារម្មណ៍ នឹក ស្រណោះ សោកស្តាយ ដែល បាត់បង់ មន្ត្រី ដ៏ សកម្ម ម្នាក់ ដោយ គាត់ តែងតែ បំពេញ ការងារ បាន យ៉ាង ល្អ ជូន អង្គភាព ក៏ ដូចជា ការចូលរួម សហការណ៍ ក្នុង ការបង្ក្រាប បទល្មើស នានា ជាច្រើន និង បាន ចូលរួមចំណែក ការពារ សុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ ក្នុង រាជធានី ភ្នំពេញ នា ពេល កន្លងមក ។
សូម បញ្ជាក់ ថា លោក វរសេនីយ៍ ទោ រ៉េត ស៉ី ណែត អាយុ ៤១ ឆ្នាំ ជា នាយ រង ការិយាល័យ ព្រហ្មទណ្ឌ កម្រិត ស្រាល នៃ ស្នងការដ្ឋាន នគរបាល រាជធានី ភ្នំពេញ មាន កូន ២នាក់ ស្រី ម្នាក់ ប្រុស ម្នាក់ ជា មន្ត្រី ដ៏ ល្អ មួយ រូប បាន លះបង់ ក្នុង ការបម្រើ សង្គម ជាតិ ហើយ គាត់ ក៏ មាន ការទំនាក់ទំនង យ៉ាង ល្អ ជាមួយ មិត្ត រួម ការងារ ទាំងអស់ ផងដែរ ។
លោក ស្នងការបាន ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ នេះ ជាមួយ ក្រុមគ្រួសារ សព លោក វរសេនីយ៍ ទោ រ៉េត ស៉ី ណែត ផងដែរ ។ ជាមួយ នោះ ដែរ លោក ស្នងការ ក៏ បាន នាំយក ជា សម្ភារៈ និង ថវិកា មួយ ចំនួន ដើម្បី ផ្តល់ ជូន ដល់ ក្រុមគ្រួសារ សព ទៀតផង ។
គួរ ជម្រាប ថា លោក វរសេនីយ៍ ទោ រ៉េត ស៉ី ណែត បាន ស្លាប់ ភ្លាម ៗ បន្ទាប់ពី ខ្មាន់ កាំភ្លើង មិន ស្គាល់ អត្តសញ្ញាណ បាញ់ ចំនួន ៩គ្រាប់ ត្រូវ ក្បាល ១គ្រាប់ ត្រូវ ខ្លួន ២គ្រាប់ ដោយសារតែ ទំនាស់ រឿង គ្រោះថ្នាក់ ចរាចរណ៍ ។
ហេតុការណ៍ បាញ់ប្រហារ បណ្តាលឲ្យ មាន ការភ្ញាក់ផ្អើល ស្ទើរតែ មួយ រាជធានី ភ្នំពេញ បាន កើតឡើង នា យប់ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ នៅ តាម បណ្តោយ មហាវិថី សហព័ន្ធ រុស្ស៉ី ត្រង់ មុខ អាកាសយាន្ត ដ្ឋាន អន្តរជាតិ ភ្នំពេញ ស្ថិត នៅក្នុង ខណ្ឌ ពោធិ៍សែនជ័យ ៕
សមាគម សហគ្រិន ស្ត្រី កម្ពុជា អបអរសាទរ ជាមួយ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ ការទទួលបាន តំណក់ ប្រេង លើក ដំបូង ដែល ជា សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ
( ភ្នំពេញ ) ៖ លោកស្រី អេង លី គង់ ប្រធាន សមាគម សហគ្រិន ស្ត្រី កម្ពុជា បាន ចេញ លិខិត អបអរសាទរ គោរព ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ចំពោះ ការទទួលបាន តំណក់ ប្រេង លើក ដំបូង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ដែល ជា សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ - ឈ្នះ ។
ខាងក្រោម នេះ ជា លិខិត អបអរសាទរ របស់ សមាគម សហគ្រិន ស្ត្រី កម្ពុជា៖ កងទ័ព នៅ កងពល តូច អន្តរាគមន៍ លេខ១ ផ្ញើ សារ អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ នាយ ទាហាន នាយ ទាហាន រង និង ពល ទាហាន នៃ កងពល តូច អន្តរាគមន៍ លេខ១ នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
កិត្តិបរិរក្ស បណ្ឌិត គាត ឈន់ ផ្ញើ សារ អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ កិត្តិបរិរក្ស បណ្ឌិត គាត ឈន់ ប្រធាន កិត្តិយស ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង ភរិយា ឡាយ នារី ព្រមទាំង មន្ដ្រីរាជការ ក្រោម ឱវាទ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
ប្រទេស ចិន ដែល ចាត់ទុក កោះ តៃវ៉ាន់ គ្រាន់តែ ជា ខេត្ត មួយ របស់ ខ្លួន ស្រប តាម ច្បាប់ អន្តរជាតិ នោះ កន្លងមក តែងតែ បាន បង្ហាញ ជំហរ ប្រឆាំង យ៉ាង ខ្លាំងក្លា នៅ ពេល ដែល សហរដ្ឋ អាមេរិក បង្កើន ការគាំទ្រ ចំពោះ កោះ នេះ រួមទាំង ការអនុម័ត លក់ សព្វា អាវុធ និង ការបើក នាវា ចម្បាំង ឆ្លងកាត់ ច្រក សមុទ្រ តៃវ៉ាន់ ដែល ធ្វើឲ្យ ទំនាក់ទំនង រវាង ទីក្រុង ប៉េកាំង និង វ៉ាស៊ីនតោន កាន់តែ មាន ភាព អាក្រក់ ទៅ ៗ ។
គួរ បញ្ជាក់ ថា នេះ គឺជា នាវា ចម្បាំង ទី ១៣ហើយ ដែល បាន បើក ឆ្លងកាត់ ច្រក សមុទ្រ តៃវ៉ាន់ ដោយ កងទ័ព ជើងទឹក អាមេរិក នៅក្នុង ឆ្នាំ ២០២០ នេះ ៕ ថ្នាក់ដឹកនាំ និង មន្ត្រី មន្ទីរ មុខងារ សាធារណៈ ខេត្ត ប៉ៃលិន ផ្ញើ សារ អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ប៉ៃលិន ) ៖ ថ្នាក់ដឹកនាំ និង មន្ត្រី នៃ មន្ទីរ មុខងារ សាធារណៈ ខេត្ត ប៉ៃលិន នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ចេញ សេចក្តីថ្លែងការណ៍ ៤ ចំណុច ក្រោយ មាន ការផ្សព្វផ្សាយ ថា បុគ្គល មួយចំនួន ព្រួយបារម្ភ ចំពោះ អំពើហិង្សា ឬ ការគំរាមកំហែង នយោបាយ នៅ កម្ពុជា
( ភ្នំពេញ ) ៖ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ នៅ ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីថ្លែងការណ៍ ៤ ចំណុច បំភ្លឺ ចំពោះ ការផ្សព្វផ្សាយ ចោទប្រកាន់ ថា មាន បុគ្គល មួយចំនួន ព្រួយបារម្ភ ចំពោះ អំពើហិង្សា ឬ ការគំរាមកំហែង នយោបាយ នៅ កម្ពុជា ។
អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ បាន ចាត់ទុក ថា ការផ្សព្វផ្សាយ ទាំងនោះ បាន ធ្វើ ការចោទប្រកាន់ ដោយ គ្មាន ភស្តុតាង និង ហេតុផល ច្បាស់លាស់ ផ្ទុយ ពី ការពិត មាន ចរិត គុំកួន និង មាន ចេតនា ទុច្ចរិត បំភាន់ សាធារណៈ មតិ ជាតិ - អន្តរជាតិ ឱ្យ មាន ការយល់ ច្រឡំ និង បាត់បង់ ទំនុកចិត្ត ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ អាជ្ញាធរ មាន សមត្ថកិច្ច និង រាជ រដ្ឋាភិបាល ដើម្បី កេង យក ផល ប្រយោជន៍ ផ្នែក នយោបាយ ។
ពាក់ព័ន្ធ ការផ្សព្វផ្សាយ ព័ត៌មាន អកុសល ខាងលើ អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ សូម ធ្វើ ការ បញ្ជាក់ ជូន សាធារណមតិ ជាតិ - អន្តរជាតិ ជ្រាប ថា៖
៤៖ ក្នុង សុច្ឆន្ទៈ ឆ្លុះបញ្ចាំង អំពី សច្ចភាព ក្នុង សង្គម ក៏ ដូចជា ដើម្បី លុបបំបាត់ នូវ ការភ័ន្តច្រឡំ ពីសំណាក់ សាធារណមតិ ជាតិ - អន្តរជាតិ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ កងកម្លាំង អនុវត្ត ច្បាប់ អាជ្ញាធរ មាន សមត្ថកិច្ច និង រាជ រដ្ឋាភិបាល ក្នុង កិច្ចការពារ ថែរក្សា សេចក្ដីសុខ ជូន ប្រជាពលរដ្ឋ យើងខ្ញុំ សូម អំពាវនាវ ដូច ខាងក្រោម៖
* សូម ប្រជាពលរដ្ឋ គ្រប់ រូប ចូលរួម សហការ ជាមួយ កម្លាំង អនុវត្ត ច្បាប់ អាជ្ញាធរ មាន សមត្ថកិច្ច គ្រប់ ជាន់ ថ្នាក់ ក្នុង ការអនុវត្ត គោល នយោបាយ “ ភូមិ ឃុំ សង្កាត់ មាន សុវត្ថិភាព ជាពិសេស សហការ រាយការណ៍ ជូន សមត្ថកិច្ច នូវ រាល់ ហេតុការណ៍ នានា ដែល បាន កើតឡើង និង បាន ជួបប្រទះ ដោយ ផ្ទាល់ ។
ក្នុង សារលិខិត ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន លោក អគ្គ រដ្ឋទូត ចិន បាន លើកឡើង ថា ឆ្នាំ ២០២០ គឺជា ឆ្នាំ ដែល ពុះពារ ខ្លាំង បំផុត ក្នុង ប្រវត្តិសាស្ត្រ នៃ មនុស្សជាតិ ។ ពិភពលោក បាន ឈានដល់ ដំណាក់កាល នៃ ការផ្លាស់ប្តូរ ដ៏ ច្របូកច្របល់ ។ នយោបាយ អំណាច គំនិត សង្គ្រាម ត្រជាក់ ឯកតោ ភាគី និយម និង ការគាំពារ និយម មាន សភាព ក្នុង ដំណើរ បញ្ច្រាស និង ទទឹង ។ ជំងឺ វីរុស កូវីដ - ១៩ បាន បង្ក ជា បញ្ហា ប្រឈម ដែល មិន ធ្លាប់ មាន ពីមុន មកដល់ សុខ សុវត្ថិភាព អាយុជីវិត នៃ មនុស្សជាតិ ។
ខាងក្រោម នេះ ជា សារលិខិត ទាំងស្រុង របស់ អគ្គ រដ្ឋទូត ចិន៖
( ភ្នំពេញ ) ៖ អ្នក ឧកញ៉ា លី ហួរ ប្រធាន សមាគម អ្នក អភិវឌ្ឍន៍ លំនៅឋាន កម្ពុជា និង ថ្នាក់ដឹកនាំ សមាជិក សមាជិកា ទាំងអស់ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
អភិបាល ខេត្ត ស្ទឹងត្រែង អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ លោក ម៉ុម សារឿន អភិបាល ខេត្ត ស្ទឹងត្រែង ព្រមទាំង ក្រុមប្រឹក្សា គណៈ អភិបាល ខេត្ត មន្ត្រីរាជការ កម្លាំងប្រដាប់អាវុធ ព្រះសង្ឃ និង ប្រជាពលរដ្ឋ ក្នុង ខេត្ត សម្តែង នូវ ការអបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ទទួលបាន សមិទ្ធផល ប្រវត្តិសាស្ត្រី ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ។
លោក ម៉ុម សារឿន បន្ថែម ថា « សន្តិភាព » របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី គឺជា កត្តា សារវន្ត មិន អាច ខ្វះ បាន សម្រាប់ ការសម្រេច ជោគជ័យ លើ សមិទ្ធផល ជាតិ ជា បន្តបន្ទាប់ និង ការអភិវឌ្ឍ លើ គ្រប់ វិស័យំ រួមទាំង សមិទ្ធផល ថ្មី ក្នុង វិស័យ ប្រេងកាត ដែល ប្រជាពលរដ្ឋ ខ្មែរ ទូទាំង ប្រទេស បាន ទន្ទឹងរង់ចាំ ជាច្រើន ជំនាន់ យូរ លង់ ណាស់ មកហើយ ។
ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ មន្ទីរ មុខងារ សាធារណៈ ខេត្ត កំពង់ធំ ផ្ញើ សារ អបអរសាទរ និង ជូនពរ សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ ថ្នាក់ដឹកនាំ និង មន្ត្រីរាជការ ទាំងអស់ នៃ មន្ទីរ មុខងារ សាធារណៈ ខេត្ត កំពង់ធំ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
អ្នក ទាំង ២នាក់ ដែល ទើប រកឃើញ ឆ្លង ជំងឺ កូវីដ១៩ នោះ រួម មាន៖
១៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ៣៦ ឆ្នាំ ស្នាក់ នៅ ឃុំ បឹង រាំង ស្រុក កំរៀង ខេត្ត បាត់ដំបង បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ មកដល់ កម្ពុជា នៅ ថ្ងៃទី ២៨ ខែធ្នូ ឆ្នាំ ២០២០ ហើយ បច្ចុប្បន្ន អ្នកជំងឺ ត្រូវបាន ដាក់ ឲ្យ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង ។
២៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ៣៣ ឆ្នាំ ស្នាក់ នៅ ឃុំ ស្ទឹង កាច់ ស្រុក សាលា ក្រៅ ខេត្ត ប៉ៃលិន បាន ធ្វើដំណើរ មកពី ប្រទេស ថៃ ដល់ កម្ពុជា នៅ ថ្ងៃទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ហើយ បច្ចុប្បន្ន អ្នកជំងឺ ត្រូវបាន ដាក់ ឲ្យ សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ បង្អែក ខេត្ត បាត់ដំបង ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ៧៖០០ នាទី ព្រឹក ថ្ងៃទី ៣១ ខែធ្នូ ឆ្នាំ ២០២០ នេះ កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង កូវីដ១៩ សរុប ចំនួន ៣៦៦ នាក់ ក្នុង នោះ ព្យាបាល ជាសះស្បើយ សរុប ចំនួន ៣៦១ នាក់ និង អ្នកជំងឺ ៥នាក់ កំពុង ទទួល ការព្យាបាល នៅ មន្ទីរពេទ្យ ៕
អាជ្ញាធរ បាន អំពាវនាវ ឲ្យ ប្រជាពលរដ្ឋ ជៀសវាង ការធ្វើដំណើរ និង បាន ដាក់ ការរឹតបន្តឹង លើ វិធានការគ្រប់គ្រង នៅក្នុង តំបន់ មួយចំនួន ក្នុង នោះ រួមទាំង កន្លែង ធ្វើ អាជីវកម្ម កម្សាន្ត ផងដែរ ។ ការបិទ តំបន់ ត្រូវបាន ធ្វើឡើង នៅក្នុង ស្រុក មួយចំនួន ផងដែរ ។
ក្រសួង សុខាភិបាល បាន បញ្ជាក់ ថា បាន រកឃើញ ករណី ឆ្លង ថ្មី ចំនួន ២៥០ ករណី នៅ ថ្ងៃពុធ នេះ . ដែល ចំនួន នេះ ស្ថិត ក្នុង ចំណោម ករណី ឆ្លង ប្រចាំ ថ្ងៃ ដែល ច្រើន ជាង គេ បំផុត ចាប់តាំងពី ការផ្ទុះឡើង ដ៏ ធំ មួយ ត្រូវបាន រកឃើញ កាលពី ជិត ២សប្តាហ៍ មុន ដែល នោះ គឺជា ការរកឃើញ ករណី ឆ្លង ច្រើន ជាង គេ បំផុត របស់ ថៃ ។
សមាគម ទ្រទ្រង់ វប្បធម៌ ខ្មែរ រដ្ឋធានី វែល្លីង តុន ប្រទេស នូវ៉ែ លហ្សេឡង់ ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ សមាគម ទ្រទ្រង់ វប្បធម៌ ខ្មែរ រដ្ឋធានី វែល្លីង តុន ប្រទេស នូវ៉ែ លហ្សេឡង់ ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ សម្តេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធិផលប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
( ភ្នំពេញ ) ៖ សមាគម ខ្មែរ - អូស្ត្រាលី នៃ រដ្ឋ ឃ្វីន ស្លែនដ៍ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រី ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
ក្រសួង សុខាភិបាល សិង្ហបុរី បាន គូសបញ្ជាក់ នៅក្នុង សេចក្តីថ្លែងការណ៍ របស់ ខ្លួន ថា បុគ្គលិក សុខាភិបាល ជាង ៣០ នាក់ នៃ មជ្ឈមណ្ឌល ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង គឺជា ក្រុម ដំបូង គេ ដែល ទទួលបាន ការចាក់ វ៉ាក់សាំង កូវីដ - ១៩ នៅ ថ្ងៃពុធ នេះ ។
លោកស្រី Sarah Lim អាយុ ៤៦ ឆ្នាំ ជា គិលានុបដ្ឋាយិកា ជាន់ ខ្ពស់ នៃ ជាតិ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ ឆ្លង គឺជា ជនជាតិ សិង្ហបុរី ដំបូង គេ ដែល ទទួលបាន ការវ៉ាក់សាំង នេះ ខណៈ ដែល លោកស្រី និង បុគ្គលិក ដទៃ ទៀត នឹង វិលត្រឡប់មក ចាក់ វ៉ាក់សាំង ដូស ទី២ នៅ ២១ ថ្ងៃ ក្រោយ ។
នាយក រដ្ឋមន្រ្តី សិង្ហបុរី លោក លី សៀន ឡុង បាន ចាត់ទុក ការចាប់ផ្តើម កម្មវិធី ចាក់ វ៉ាក់សាំង នេះ ជា ជំពូក ថ្មី ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ រាតត្បាត សកល កូវីដ - ១៩ ។ តាមរយៈ ទំព័រ ហ្វេសប៊ុក នាយក រដ្ឋមន្រ្តី រូប នេះ បាន និយាយ ថា « ថ្ងៃ នេះ យើង បាន ចាប់ផ្តើម យុទ្ធនាការ ចាក់ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ - ១៩ ដោយ មាន បុគ្គលិក ថែទាំ សុខភាព ជាង ៣០ នាក់ នៃ មជ្ឈមណ្ឌល ជាតិ ប្រយុទ្ធ នឹង ជំងឺ ឆ្លង ទទួលបាន មុន គេ » ។
នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ សេង ផល្លី ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង
( ភ្នំពេញ ) ៖ នាយ ឧត្តមសេនីយ៍ សាស្ត្រាចារ្យ សេង ផល្លី ប្រធានបណ្ឌិត្យ សភា នគរបាល កម្ពុជា នៅ ថ្ងៃទី៣០ ខែធ្នូ ឆ្នាំ ២០២០ នេះ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រ ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហោ ប៉េង សាកលវិទ្យាធិការ នៃ សាកលវិទ្យាល័យ ជាតិ គ្រប់គ្រង ក្រុមប្រឹក្សាភិបាល គណៈ គ្រប់គ្រង បុគ្គលិក មន្ត្រីរាជការ សាស្ត្រាចារ្យ ព្រមទាំង និស្សិត ទាំងអស់ សូម ផ្ញើ លិខិត អបអរសាទរ និង ជូនពរ ជូន សម្ដេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ដ្រី នៃ កម្ពុជា ចំពោះ សមិទ្ធផល ប្រវត្តិសាស្ត្រី ថ្មី នៃ នយោបាយ ឈ្នះ ឈ្នះ ទទួលបាន តំណក់ ប្រេង លើក ដំបូង ។
