( ភ្នំពេញ ) ៖ អនុ រដ្ឋលេខាធិការ នៃ ក្រសួង ប្រៃសណីយ៍ និង ទូរគមនាគមន៍ ចំនួន ៩រូប បាន រួមគ្នា បរិច្ចាគ ថវិកា សរុប ១៨០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ឯកឧត្តម សុខ ចិន្តា សោភា បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម សុខ ចិន្តា សោភា រដ្ឋមន្ត្រី ប្រតិភូ អម នាយក រដ្ឋមន្រ្តី និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា អភិវឌ្ឍន៍ កម្ពុជា បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
អភិបាល រាជធានី ភ្នំពេញ ចូលរួម មហាសន្និបាត សមាគម អន្តរជាតិ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង លើក ទី៤០ នៅ ប្រទេស ទុយនីស៉ី តាម ប្រព័ន្ធ វីដេអូ
( ភ្នំពេញ ) ៖ កម្មវិធី មហាសន្និបាត សមាគម អន្តរជាតិ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង លើក ទី៤០ នៅ ឆ្នាំ ២០២០ នេះ បាន ប្រារព្ធ ធ្វើឡើង នៅ ទីក្រុង ទុយនីស៉ី ប្រទេស ទុយនីស៉ី ហើយ កិច្ចប្រជុំ នេះ មាន ការចូលរួម ប្រជុំ ដោយ ផ្ទាល់ និង ការប្រជុំ តាមរយៈ ការបញ្ជូន រូបភាព និង សំឡេង មកពី បណ្តាល ទីក្រុង ចំនួន ១៣០ស្មើ និង ១៣០ ប្រទេស ដែល ជា ទីក្រុង ប្រើប្រាស់ ភាសា បារាំង បើ ទោះបី លើ ពិភពលោក ប្រឈម នឹង ជំងឺ កូវីដ ។
ដោយឡែក នៅ ល្ងាច ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ សម្រាប់ រាជធានី ភ្នំពេញ បាន បើក កិច្ចប្រជុំ នេះ តាមរយៈ ការបញ្ជូន រូបភាព និង សំឡេង នៅ សាលា រាជធានី ភ្នំពេញ ក្រោម វត្តមាន លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ ដើម្បី ចូលរួម ពិភាក្សា ក្នុង កម្មវិធី មហាសន្និបាត នេះ ។
ពាក់ព័ន្ធ នឹង ពិធី បើក សន្និបាត ស្តីពី ទីក្រុង កំពុង អភិវឌ្ឍន៍ និង ប្រព័ន្ធ ឌីជីថល នេះ គឺជា មហាសន្និបាត លើក ទី៤០ និង កិច្ចប្រជុំ ការិយាល័យ អចិន្ត្រៃយ៍ លើក ទី ៩២ របស់ សមាគម អន្តរជាតិ អភិបាល ក្រុង ប្រើប្រាស់ ភាសា បារាំង (AIMF) ហើយ សមាគម AIMF តែងតែ ប្រារព្ធ ធ្វើជាមួយនឹង សន្និសីទ បច្ចេកទេស ក្រោម ប្រធានបទ ដាច់ដោយឡែក ពី ឆ្នាំ មួយ ទៅ ឆ្នាំ មួយ ទៀត សម្រាប់ ឆ្នាំ ២០២០ នេះ ។ សមាគម AIMF បាន រៀបចំ សន្និសីទ មួយ ក្រោម ប្រធានបទ ទីក្រុង កំពុង អភិវឌ្ឍន៍ និង ប្រព័ន្ធ ឌីជីថល ។
ទីក្រុង ដែល បាន ចូលរួម ក្នុង កិច្ចប្រជុំ ដោយ ផ្ទាល់ និង តាមរយៈ ការបញ្ជូន តាម រូបភាព និង សំឡេង នេះ មាន ទីក្រុង មួយចំនួន បាន លើកឡើង ពី អត្ថប្រយោជន៍ ពី ប្រព័ន្ធ ឌីជីថល នេះ មាន ប្រព័ន្ធ ឌីជីថល ធ្វើឲ្យ សេដ្ឋកិច្ច មាន ការអភិវឌ្ឍ រីកចម្រើន យ៉ាង លឿន បំផុត ហើយ ប្រព័ន្ធ ឌីជីថល នេះ ក៏ មាន គុណវិបត្តិ មួយចំនួន ផងដែរ បើ យើង ប្រើប្រាស់ មិន ត្រូវ ទិសដៅ ។
( ភ្នំពេញ ) ៖ ធនាគារ អេស៊ីលីដា បាន បរិច្ចាគ ថវិកា១.០០០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ចូរ ប្រាប់ មនុស្ស ជា ទី ស្រលាញ់ ពី គ្រោះថ្នាក់ នៃ គ្រឿងញៀន ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៩ ខែ ធ្នូ៖ បង្ក្រាប ២៤ ករណី ឃាត់ខ្លួន ៣៤ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ២៤ ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ៧ករណី . ជួញដូរ ១៧ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣៤ នាក់ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ កែវ វណ្ណ ថន អគ្គ នាយក រង នៃ អគ្គ នាយកដ្ឋាន អន្ដោប្រវេសន៍ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ អភិបាល ខេត្ត ពោធិ៍សាត់ អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ត្រូវ សហការ ជាមួយ អាជ្ញាធរ ក្នុង ការចូលរួម វិធានការ បង្ការ និង ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១ - ៩
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នា ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ថ្លែង អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ទូទាំង ខេត្ត ត្រូវ មាន កិច្ចសហការ ល្អ ជាមួយ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ ក្នុង ការចូលរួម វិធានការ បង្ការ និង ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ១៩ នៅក្នុង សហគមន៍ ក្នុង ភូមិសាស្ត្រ ខេត្ត ពោធិ៍សាត់ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា យន្តការ ដែល កំពុងតែ ដើរ នេះ គឺជា យន្តការវេទិកា សាធារណៈ ដែល ជា គោលការណ៍ របស់ រាជ រដ្ឋាភិបាល ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន បាន ចង្អុលបង្ហាញ ឱ្យ ថ្នាក់ ខេត្ត ថ្នាក់ មូលដ្ឋាន ផ្សារភ្ជាប់ សុខ ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ដោយ ផ្ទាល់ ទៅ លើ បញ្ហា ប្រឈម និង តម្រូវការ ក្នុង ជីវភាព រស់ នៅ ជាក់ស្តែង ។ លោក ថា ពីមុន ដោះស្រាយ ២ដង ក្នុង មួយ សប្តាហ៍ ក៏ប៉ុន្តែ ឥឡូវនេះ ដោះស្រាយ ២សប្តាហ៍ មួយ១ ដង ដោយសារតែ ជម្លោះ ក៏ ដូចជា បញ្ហា ប្រឈម កាន់តែ ថយចុះ ។
លោក ម៉ៅ ធ និន បាន ឱ្យដឹង ទៀត ថា ជានិច្ច ជាកាល លោក តែងតែ ប្រើប្រាស់ ឋានានុក្រម២ គឺ ទី ១៖ ក្នុង នាម ជា អភិបាល ខេត្ត សម្រាប់ សម្របសម្រួល ដោះស្រាយ បញ្ហា ប្រឈម ជូន ពុក ម៉ែ ប្រជាពលរដ្ឋ ទៅ លើ ផ្លូវ ច្បាប់ និង ទី២៖ ក្នុង ឋានៈ ជា គ្រួសារ មាន តួនាទី ជាបង ជា ប្អូន ជា កូន ជា ក្មួយ និង ជា ចៅ មួយ ក្នុង គ្រួសារ ប្រជាពលរដ្ឋ ជាង ៥០ម៉ឺន នាក់ ទូទាំង ខេត្ត ដើម្បី ចូលរួម សុខ រួម ទុក្ខ ជាមួយ ពួកគាត់ គ្រប់ ពេលវេលា ។
តាមរយៈ វេទិកា សម្របសម្រួល និង ដោះស្រាយ ក្រៅ ប្រព័ន្ធ តុលាការ ដែល លោក ម៉ៅ ធ និន បាន មក ដឹកនាំយន្ត ការ ខេត្ត ពោធិ៍សាត់ រយៈពេល ជាង ៦ ឆ្នាំង កន្លងមក នេះ បាន ធ្វើឱ្យ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន មាន ការសាទរ ចំពោះ ដំណោះស្រាយ ដ៏ មាន ប្រសិទ្ធភាព ៕ ទីក្រុង មួយ នៅ ចិន ធ្វើតេស្ត រក កូវីដ - ១៩ លើ មនុស្ស ជាង ២៥ម៉ឺន នាក់ ក្រោយ រកឃើញ ប្តី ប្រពន្ធ មួយ គូ មាន ផ្ទុក កូវីដ - ១៩
ប្តី ប្រពន្ធ វ័យ ចំណាស់ មួយ គូ ត្រូវបាន រកឃើញ ថា មាន ផ្ទុក វីរុស កូរ៉ូណា កាលពី ថ្ងៃចន្ទ ដើម សប្តាហ៍ នេះ ។ ភ្លាម ៗ នោះ អាជ្ញាធរ ចិន បាន តាមដាន មនុស្ស ដែល មាន ទំនាក់ទំនង ជិតស្និទ្ធ ជាមួយ ពួកគេ ទាំងអស់ និង នាំយក គំរូ អាហារ មក ធ្វើតេស្ត ផងដែរ ។ មន្ត្រី សុខាភិបាល ក្នុង តំបន់ បាន ឲ្យដឹង ថា វីរុស កូរ៉ូណា ត្រូវបាន រកឃើញ នៅក្នុង អាហារ ក្លាសេក្នុង ទូរទឹកកក និង នៅលើ បន្ទះ ក្តារ ដាក់ ម្ហូប នៅក្នុង ផ្ទះល្វែង របស់ ពួកគេ ។
គណៈកម្មការ សុខភាព ប្រចាំ ទីក្រុង ខាងលើ នេះ បាន ប្រកាស ឲ្យដឹង ទៀត ថា គិត ត្រឹម ថ្ងៃអង្គារ សប្តាហ៍ នេះ មនុស្ស ចំនួន ២៥៥. ២០០ នាក់ ត្រូវបាន ធ្វើតេស្ត រក ជំងឺ COVID-19 ក្នុង នោះ អ្នក ឆ្លង គ្មាន រោគសញ្ញា ចំនួន ០៦ នាក់ ត្រូវបាន រកឃើញ ។ នៅ ជុំវិញ បញ្ហា នេះ អាជ្ញាធរ មូលដ្ឋាន បាន សម្រេចចិត្ត បិទ សាលារៀន និង សាលាម តេយ្យ ទាំងអស់ នៅក្នុង សង្កាត់ ពី ទូ (Pidu) ជា ទី ដែល ករណី ឆ្លង ថ្មី ៗ ទាំងនេះ ត្រូវបាន រាយការណ៍ ខណៈ ដែល សិស្ស និង គ្រូបង្រៀន ត្រូវបាន ដាក់ ឲ្យ នៅ ដាច់ដោយឡែក និង រង់ចាំ ទទួល ការធ្វើតេស្ត ។
គួរ បញ្ជាក់ ថា មន្ត្រី សុខាភិបាល ទីក្រុង ធាន ជីន ក៏ ធ្លាប់ បាន បញ្ជាក់ កាលពី ខែវិច្ឆិកា រួច មកហើយ ថា ករណី ថ្មី ៗ នៅក្នុង ទីក្រុង មាន ជាប់ពាក់ព័ន្ធ ទៅនឹង អាហារ ក្លាសេ ដែល នាំចូល ពី បរទេស រួម មាន ក្បាល ជ្រូក ពី តំបន់ អាមេរិក ខាងជើង ជាដើម ៕ អភិបាល ខណ្ឌ ចំការមន និង លោកស្រី បរិច្ចាគ ថវិកា ចំនួន ៥លាន រៀល ជូន សម្តេច តេជោ ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ថេង សុថុល អភិបាល ខណ្ឌ ចំការមន និង លោកស្រី ព្រមទាំង ក្រុមគ្រួសារ បរិច្ចាគ ថវិកា ៥លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
អភិបាល ខណ្ឌ ច្បារអំពៅ និង ភរិយា បរិច្ចាគ ថវិកា ២៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ចេង មុនីរ៉ា អភិបាល ខណ្ឌ ច្បារអំពៅ និង លោកស្រី ព្រមទាំង ក្រុមគ្រួសារ បរិច្ចាគ ថវិកា ២៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
តាម ព្រះរាជ ក្រឹត្យ ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន បញ្ជាក់ ថា ព្រះរាជ ក្រឹត្យ បញ្ចប់ តំណែង លោក ចាន់ យ៉េត បាន ធ្វើឡើង បន្ទាប់ពី មាន សេចក្តីក្រាបបង្គំទូល ថ្វាយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ។
លោក ចាន់ យ៉េត នា ពេល កន្លងទៅ បាន ពាក់ព័ន្ធ យ៉ាង ជ្រៅ ទៅនឹង ទំនាស់ ដីធ្លី នៅ តំបន់ បឹង ជង្រុក និង ៦៧១ ក្នុង ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ ។
កាលពី ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ លោក ចាន់ យ៉េត បាន ប្រកាស ថា ខ្លួន និង សហការី ឈប់ ពាក់ព័ន្ធ នឹង ទំនាស់ ដីធ្លី នៅ តំបន់ បឹង ជង្រុក និង ៦៧១ ក្នុង ស្រុក ម៉ាឡៃ ខេត្ត បន្ទាយមានជ័យ ទៀត ហើយ ចាប់ពី ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ ត ទៅ ។
ខាងក្រោម នេះ ជា ព្រះរាជ ក្រឹត្យ ព្រះមហាក្ស ត្រ៖ ឧត្តមសេនីយ៍ ទោ សេង ធារិន ប្រាប់ ក្រុមការងារ ទំនាក់ទំនង កម្ពុជា - ថៃ ជូនដំណឹង ទៅ ភាគី ថៃ ធ្វើ ការរុះរើ ស្លាកសញ្ញា ដោះ មីន ចេញ នៅ បង្គោល ព្រំដែន លេខ ៣២ - ៣៣
( បន្ទាយមានជ័យ )៖ លោក ឧត្តមសេនីយ៍ ទោ សេង ធារិន មេបញ្ជាការ រង នាយ សេនាធិការ យោធ ភូមិភាគ ទី៥ ព្រឹក ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ បាន ដឹកនាំ ក្រុមការងារ ជួប ជាមួយ ឧត្តមសេនីយ៍ ទោ ព្រំ រឿន និង ឧត្តមសេនីយ៍ ទោ ទឹម ទុំ អនុប្រធាន នាយកដ្ឋាន នគរបាល ព្រំដែន គោក ដើម្បី ពិភាក្សា គ្នា ដោះស្រាយ អំពី សកម្មភាព ដោះ មីន របស់ ភាគី ថៃ ចន្លោះ បង្គោល សីមា លេខ ៣២ - ៣៣ ស្ថិត ក្នុង ភូមិ សាមគ្គី ឃុំ គោក រមៀត ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ។
លោក ឧត្តមសេនីយ៍ ទោ សេង ធារិន បាន ប្រាប់ ឲ្យ ក្រុមការងារ ទំនាក់ទំនង ព្រំដែន កម្ពុជា - ថៃ ជូនដំណឹង ដល់ ភាគី ថៃ ឲ្យ រុះរើ ស្លាកសញ្ញា មីន ចេញ ឲ្យ អស់ ក្នុង រយៈពេល ២ ថ្ងៃ គិត ចាប់ពី ថ្ងៃ នេះ ទៅ ។ បើ រយៈពេល ២ ថ្ងៃ មិន ធ្វើ ការរុះរើ ស្លាកសញ្ញា ដោះ មីន ទេ កម្លាំង ឈរជើង នៅ ទីនោះ នឹង ធ្វើ ការរុះរើ ដោយ ខ្លួន ឯង ហើយ រាល់ សកម្មភាព ផ្សេង ៗ តាម បណ្តោយ ព្រំដែន សូម ភាគី ថៃ ជូនដំណឹង គ្នា ទៅ វិញ ទៅមក ។
ក្រោយ ពិភាក្សា គ្នា ចប់ ក្រុមការងារ បាន ចុះ ត្រួតពិនិត្យ គោលដៅ ថៃ ដោះ មីន ជាក់ស្តែង នៅ ចំណុច ភូមិ សាមគ្គី ឃុំ គោក រមៀត ស្រុក ថ្ម ពួក ខេត្ត បន្ទាយមានជ័យ ៕
ក្រុម មេធាវី រាជ រដ្ឋាភិបាល និង ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ ចូលរួម បរិច្ចាគ ថវិកា សរុប ៣ម៉ឺន ដុល្លារ . ឯកឧត្តម គី តិច បរិច្ចាគ ប្រាក់ បៀវត្ស ពេញ១ ឆ្នាំ ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ដើម្បី ចូលរួមចំណែក ជាមួយ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា ក្នុង ការទិញ វ៉ាក់សាំង កូវីដ១៩ សមាជិក ក្រុម មេធាវី រាជ រដ្ឋាភិបាល និង ក្រុម មេធាវី ស្ម័គ្រចិត្ត សម្តេច តេជោ សែន បាន ចូលរួម ជា ថវិកា សរុប ចំនួន ៣០.០០០ ដុល្លារ ហើយ ចំណែក ឯកឧត្តម គី តិច ក៏ បាន បរិច្ចាគ បៀវត្សរ៍ ក្នុង តួនាទី ជា ប្រធាន ក្រុម មេធាវី រាជ រដ្ឋាភិបាល ចំនួន ១២ខែ ក្នុង ឆ្នាំ ២០២១ ផងដែរ ។
ខាងក្រោម នេះ ជា បញ្ជី ឈ្មោះ សមាជិក ក្រុម មេធាវី ដែល បាន ចូលរួម បរិច្ចាគ៖ ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន និង លោកជំទាវ អ៉ឹម ប៉ូលីកា បរិច្ចាគ ថវិកា ៣ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន និង លោកជំទាវ អ៉ឹម ប៉ូលីកា នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ៣ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ១១ខែ ឆ្នាំ នេះ ខេត្ត ព្រៃវែង ប្រមូល ផល ស្រូវ វស្សា បាន ជាង ២១ម៉ឺន ហិកតា សរុប ទិន្នផល បាន ជិត ៧០ម៉ឺន តោន
( ព្រៃវែង ) ៖ ការប្រមូល ផល ស្រូវ វស្សា របស់ ប្រជាកសិករ នៅ ខេត្ត ព្រៃវែង នៅ ឆ្នាំ ២០២០ បាន ទិន្នផល ល្អ ប្រសើរ ដោយសារ ល្បាយ ទឹកភ្លៀង បាន ធ្លាក់ រាយប៉ាយ នៅ ទូទាំង ខេត្ត និង ក៏ដោយសារ មាន ហេដ្ឋារចនាសម្ព័ន្ធ ប្រឡាយ ទឹក ខ្វាត់ ខ្វែង ធ្វើឲ្យ ខេត្ត មួយ នេះ ប្រមូល ផល ស្រូវ វស្សា គិត ត្រឹម ថ្ងៃទី ៧ ខែធ្នូ សរុប ២១៤. ៦៥២ ហិកតា និង បរិមាណ ផល ៦៩២ .៣០២ តោន ខណៈ ទិន្នផល មធ្យម ៣. ២៣តោន ក្នុង ១ហិកតា ។
លោក បន្ត ថា កម្រិត ទឹកភ្លៀង ក៏ មាន ភាពល្អ ប្រសើរ នៅក្នុង ឆ្នាំ នេះ ធ្វើឲ្យ ទិន្នផល ស្រូវ មាន ការកើនឡើង ពី មួយ ឆ្នាំ ទៅ មួយ ឆ្នាំ ជាពិសេស ដោយសារ មាន ហេដ្ឋារចនាសម្ព័ន្ធ ប្រឡាយ ទឹក ខ្វាត់ ខ្វែង និង ផ្លូវ គនាគមន៍ ជាច្រើន ក្នុង ខេត្ត ដែល នាំឲ្យ វិស័យ ដឹកជញ្ជូន ទាំង ផ្លូវ ទឹក និង ផ្លូវ គោក មាន ភាពងាយស្រួល ក្នុង ការដឹក កសិផល ទៅកាន់ ទីផ្សារ និង ប្រទេស ជិតខាង ផងដែរ ។
ចំពោះ ល្បឿន បង្កបង្កើន ផល ដំណាំ សាក វប្បកម្ម និង ឧស្សាហកម្ម រយៈពេល ខ្លី រដូវ ប្រាំង អនុវត្តន៍ សរុប ៦៣០ ហិកតា ក្នុង នោះ បន្លែ គ្រប់ មុខ ៦៣០ ហិកតា និង ដំណាំ ឧស្សាហកម្ម អនុវត្តន៍ សរុប ១.៩៤០ ហិកតា ដំណាំ ពោត ក្រហម ១.៣៨០ ហិកតា សណ្ដែក បាយ ៥១៩ ហិកតា សណ្ដែក ដី ៧ហិកតា ដំណាំ ល្ង ១ហិកតា អំពៅ ៣ហិកតា ឈូក ៣០ ហិកតា ។
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្តាល និង ក្រុមការងារ ពាក់ព័ន្ធ នា រសៀល ទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ បាន ចុះ ជួប សួរ សុខទុក្ខ និង ពិនិត្យ ការអនុវត្ត ការធ្វើចត្តាឡី ស័ក ដោយ ខ្លួន ឯង របស់ ព្រះសង្ឃ និង យាយ ជី តា ជី ដែល គង់ និង ស្នាក់នៅ វត្ត វិហារ ត្រាញ់ ស្ថិត នៅ ឃុំ ព្រែក ស្លែង ស្រុក កណ្តាល ស្ទឹង ។
ក្រោយ បញ្ចប់ ការសួសុខ ទុក្ខ លោក អភិបាល ខេត្ត ក៏ បាន សួរសុខទុក្ខ ប្រជាពលរដ្ឋ នៅ មណ្ឌល ចត្តាឡី ស័ក ស្ថិត ក្នុង សាលា បឋម បឋមសិក្សា អន្លង់ រមៀត ស្រុក កណ្តាល ស្ទឹង ផងដែរ ខណៈ ដែល ពួកគាត់ គឺជា អ្នក ប៉ះពាល់ ដោយ ប្រយោល នឹង ក្រុមគ្រួសារ លោកស្រី អៀម ធីតា ដែល មាន ផ្ទុក វីរុស កូវីដ - ១៩ ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា ។
លោក អភិបាល ខេត្ត បាន ណែនាំឲ្យ ពលរដ្ឋ បន្ត រក្សា អនាម័យ និង គោរព តាម វិធានការ របស់ ក្រសួង សុខាភិបាល ព្រមទាំង លើកទឹកចិត្ត ឲ្យ ពួកគាត់ ត្រូវ តាំងចិត្ត ឱ្យ បាន រឹងមាំ និង ហាត់ប្រាណ ឲ្យបាន ទៀងទាត់ ពិសា អាហារ ដែល មាន វីតាមីន ច្រើន ដើម្បី ធ្វើឱ្យ រាងកាយ រឹងមាំ ឈ្នះ អស់ ជំងឺ ទាំងឡាយ ។
សូម ជម្រាប បញ្ជាក់ ជូន ផងដែរ ថា លោកស្រី អៀម ធីតា អាយុ ៣៥ ឆ្នាំ មាន អាស័យដ្ឋាន នៅ សង្កាត់ បឹង ទំពន់ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ បាន ទៅ ហាង Pedro ផ្លូវ ព្រះសីហនុ កាលពី ថ្ងៃទី ២៧ ខែវិច្ឆិកា ឆ្នាំ ២០២០ លទ្ធផល ធ្វើតេស្ត កាលពី ថ្ងៃទី ០៧ ខែធ្នូ គឺ លទ្ធផល វិជ្ជមាន វីរុស កូវីដ - ១៩ ។ គាត់ បម្រើការ នៅ ក្រុមហ៊ុន ធានារ៉ាប់រង មួយ នៅ រាជធានី ភ្នំពេញ ពុំ មែន ជា មន្រ្តី រាជការ បម្រើ ការងារ នៅ ទីស្តីការ ក្រសួង មហាផ្ទៃ ឡើយ ។
លោក អភិបាល ខេត្ត កណ្ដាល បាន បញ្ជា ឲ្យ បិទ ផ្សារ ដើម អំពិល និង វត្ត វិហារ ត្រាញ់ ជា បណ្ដោះអាសន្ន សិន ក្រោយ រកឃើញ មនុស្ស ម្នាក់ មាន ផ្ទុក វីរុស កូវីដ - ១៩ ហើយ ពាក់ព័ន្ធ នៅ តំបន់ នោះ ព្រមទាំង មនុស្ស ៧នាក់ ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ៣០ នាក់ ផ្សេង ទៀត ពាក់ព័ន្ធ ដោយ ប្រយោល ត្រូវបាន ណែនាំឲ្យ ធ្វើចត្តាឡី ស័ក ៕ ក្រសួង ការងារ ពន្យារ ពេល សម្រាប់ ស្នើសុំ ការអនុញ្ញាត ប្រើប្រាស់ ហត្ថ ពលកម្ម បរទេស ឆ្នាំ ២០២១
( ភ្នំពេញ ) ៖ ក្រសួង ការងារ និង បណ្ដុះបណ្ដាល វិជ្ជាជីវៈ នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ចេញ សេចក្តីជូនដំណឹង ស្តីពី ការពន្យារ ពេល សម្រាប់ ស្នើសុំ ការអនុញ្ញាត ប្រើប្រាស់ ហត្ថ ពលកម្ម បរទេស ឆ្នាំ ២០២១ ។ នេះ តាម សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន
ក្នុង សេចក្ដីជូនដំណឹង បាន បញ្ជាក់ យ៉ាង ដូចេ្នះ ថា « ក្រសួង បាន ពន្យារ ពេល សម្រាប់ ការស្នើសុំ លិខិត អនុញ្ញាត ប្រើប្រាស់ ហត្ថ ពលកម្ម បរទេស ( កូតា ) សម្រាប់ ឆ្នាំ ២០២១ រហូតដល់ ដំណាច់ ខែមករា ឆ្នាំ ២០២១ » ។
ជាមួយគ្នា នេះ ក្រសួង សូម ក្រើន រំលឹក ដល់ ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ទាំងឡាយ ដែល មាន សេចក្តី ត្រូវការ ប្រើប្រាស់ ហត្ថ ពលកម្ម បរទេស សម្រាប់ ឆ្នាំ ២០២១ ត្រូវ ប្រញាប់ ដាក់ សំណើ សុំ ការអនុញ្ញាត ប្រើប្រាស់ ហត្ថ ពលកម្ម បរទេស ( កូតា ) ឱ្យ បាន មុន ថ្ងៃទី ៣១ ខែមករា ឆ្នាំ ២០២១ ជា កំហិត ។
ក្រសួង បាន គូសបញ្ជាក់ ថា ម្ចាស់ ឬ នាយក រោងចក្រ សហគ្រាស ដែល មិន បាន ស្នើសុំ ការអនុញ្ញាត ប្រើប្រាស់ ហត្ថ ពលកម្ម បរទេស ( កូតា ) ក្រសួង នឹង ចាត់ វិធានការ ផាកពិន័យ តាម ទោស ប្បញ្ញត្តិ ក្នុង ជំពូក ទី ១៦ នៃ ច្បាប់ ស្តីពី ការងារ ៕ អត្រា អ្នកអត់ឃ្លាន នៅក្នុង ប្រទេស ហ្វីលីពីន កើនឡើង ខ្ពស់ បំផុត មិន ធ្លាប់ មាន ពីមុន មក ខណៈ វិធានការរឹតត្បិត នានា ត្រូវបាន អនុវត្ត ដើម្បី ទប់ស្កាត់ កូវីដ - ១៩
សមាគម សម្បុរស ធម៌ កំពុង តស៊ូ ពុះពារ ដើម្បី បំពេញ តម្រូវការ ស្បៀងអាហារ ដែល ចេះតែ កើនឡើង ជាលំដាប់ ខណៈ រាប់ លាន គ្រួសារ កំពុង ជួបប្រទះ នឹង ភាពអត់ឃ្លាន នៅ ទូទាំង ប្រទេស ហ្វីលីពីន ។ វិធានការរឹតត្បិត ប្រឆាំង COVID-19 បាន ធ្វើឱ្យ សេដ្ឋកិច្ច នៅ ប្រទេស ហ្វីលីពីន ធ្លាក់ចុះ និង បាន ធ្វើឱ្យ មនុស្ស ជាច្រើន បាត់បង់ ការងារ ធ្វើ ។
គួរ បញ្ជាក់ ថា ចំនួន ខាងលើ នេះ បាន កើនឡើង យ៉ាង គួរឲ្យ កត់សម្គាល់ ចាប់តាំងពី ខែឧសភា មក ម្លេះ ពោលគឺ រយៈពេល ០២ ខែ បន្ទាប់ពី ប្រទេស ហ្វីលីពីន បាន ធ្លាក់ ចូល ទៅក្នុង ស្ថានភាព ជាប់គាំង យ៉ាង ធ្ងន់ធ្ងរ ដែល សេដ្ឋកិច្ច របស់ ប្រទេស នេះ ត្រូវបាន គេ រំពឹង ថា នឹង ធ្លាក់ចុះ ដល់ ៩.៥ភាគរយ នៅ ឆ្នាំ ២០២០ នេះ ៕ ខេត្ត ប៉ៃលិន ប្រារព្ធ មហោស្រព បង្ហើរ ខ្លែង ឯក ខ្មែរ ថ្នាក់ ខេត្ត លើក ទី១ ឆ្នាំ ២០២០
( ប៉ៃលិន ) ៖ មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ ខេត្ត ប៉ៃលិន បាន រៀបចំ មហា ស្រព បង្ហើរ ខ្លែង ឯក ខ្មែរ ថ្នាក់ ខេត្ត លើក ទី១ ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ពី បេក្ខជន បេក្ខ នារី មកពី ៨ឃុំ / សង្កាត់ ទូទាំង ខេត្ត ស្ថិត ក្រោម អធិបតីភាព លោក ផាន់ ចាន់ ធុល អភិបាល ខេត្ត ប៉ៃលិន ។ មហោស្រព បាន ធ្វើឡើង នៅ រសៀល ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២០ នៅ ពហុកីឡាដ្ឋាន ភ្នំ ចេក ស្ថិត នៅ សង្កាត់ បរ យ៉ាខា ក្រុង ប៉ៃលិន ។
លោក ព្រហ្ម រដ្ឋា ប្រធាន មន្ទីរ វប្បធម៌ និង វិចិត្រ សិល្បៈ ខេត្ត ប៉ៃលិន បាន ឱ្យដឹង ថា ក្នុង មហោស្រព បង្ហើរ ខ្លែង ឯក ខ្មែរ ថ្នាក់ ខេត្ត លើក ទី១ ឆ្នាំ ២០២០ នេះ មាន ការចូលរួម ពីសំណាក់ បេក្ខជន - បេក្ខ នារី តាម បណ្តា ឃុំ / សង្កាត់ ទាំង ០៨ ដោយ មាន ១៦ខ្លែង បូករួម ទាំង ខ្លែង របស់ មន្ទីរ ចូលរួម បង្ហើរ ជា និមិត្តរូប ផងដែរ ។
លោក អភិបាល ខេត្ត ក៏ បាន ជំរុញ ដល់ អាជ្ញាធរ គ្រប់ លំដាប់ថ្នាក់ និង មន្ទីរ វប្បធម៍ និង វិចិត្រ សិល្បៈ ខេត្ត ត្រូវ យកចិត្តទុកដាក់ ព្រមទាំង សហការ គ្នា ពង្រឹង ពង្រីក និង បំផុស ឲ្យ មាន ការចូលរួម រាល់ គ្រប់ សកម្មភាព ពី ប្រជាពលរដ្ឋ និង ស្រទាប់ យុវជន នានា ដែល ទាក់ទង ទៅ នឹង សិល្បៈ វប្បធម៌ ថ្មី ៗ ដើម្បី អភិវឌ្ឍ វប្បធម៌ ជាតិ ក៏ ដូចជា វប្បធម៌ ចម្រុះ នៅ តាម សហគមន៍ ឲ្យបាន ស្ថិតស្ថេរ គង់វង្ស ។
នៅក្នុង ឱកាស នោះ ដែរ លោក ផាន់ ចាន់ ធុល បាន ក្រើន រំលឹក ឱ្យ មន្ត្រី ជំនាញ និង អាជ្ញាធរ មូលដ្ឋាន គ្រប់ ជាន់ ថ្នាក់ ត្រូវ យកចិត្តទុកដាក់ និង ទទួលខុសត្រូវ ខ្ពស់ ព្រមទាំង សហការ គ្នា ចុះ ធ្វើ ការអប់រំ ផ្សព្វផ្សាយ និង ណែនាំ បងប្អូន ប្រជាពលរដ្ឋ ចូលរួម អនុវត្តន៍ តាម ការណែនាំ របស់ រាជ រដ្ឋាភិបាល និង ក្រសួង សុខាភិបាល ដើម្បី បង្ការ និង ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ។
លោក សៀង ពិសិដ្ឋ និង លោកស្រី សុខ ចាន់ លីន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
ជាមួយគ្នា នេះ លោក ឯ ម ច័ន្ទ មករា បាន ថ្កោល ទោស ចំពោះ ជន អនាមិក ដែល បាន Hack ហ្វេសបុក របស់ លោក ហើយ អំពាវនាវ ដល់ សមត្ថកិច្ច ជំនាញ ឱ្យ ជួយ ស្រាវជ្រាវ ដើម្បី ចាប់ខ្លួន ជនល្មើស មក ផ្តន្ទាទោស ៕
ក្នុង សេចក្ដីជូនដំណឹង ដែល បណ្ដាញ ព័ត៌មាន Fresh News ទទួលបាន រដ្ឋបាល ក្រុង សែនមនោរម្យ រៀបរាប់ ថា កាលពី ថ្ងៃទី ០២ ខែធ្នូ ឆ្នាំ ២០២០ កន្លងមក មាន ភ្ញៀវ ឈ្មោះ អិត កុម៉ាល ភេទ ប្រុស អាយុ ៣៥ ឆ្នាំ ស្នាក់ នៅ សង្កាត់ បឹងកេងកង៣ ខណ្ឌ បឹងកេងកង រាជធានី ភ្នំពេញ បាន ទៅ លេង នៅ ទីនោះ និង ស្នាក់ នៅ មួយ យប់ ផងដែរ ។
ដើម្បី ចូលរួម ការពារ នៃ ការរីករាលដាល ក្នុង សហគមន៍ ដែល មាន ផល ប៉ះពាល់ និង បង្ការ ទប់ស្កាត់ ជំងឺ ឆ្លង កូវីដ១៩ រដ្ឋបាល ក្រុង សែនមនោរម្យ សូម ម្ចាស់ អាជីវកម្ម ខាងលើ ត្រូវ ផ្អាក ធ្វើ អាជីវកម្ម បណ្ដោះអាសន្ន ចាប់ពី ថ្ងៃ ជូនដំណឹង នេះ រហូតដល់ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ ។
ជាមួយគ្នា នេះ លោក ស្វាយ សំអ៊ាង ក៏ បាន ប្រាប់ បណ្ដាញ ព័ត៌មាន Fresh News ដែរ ថា ភ្ញៀវ ទេសចរ ឈ្មោះ អិត កុម៉ាល និង មិត្តភ័ក្រ ក៏ បាន ទៅ ដើរលេង កម្សាន្ដ នៅ រម្មណីយដ្ឋាន ទឹកជ្រោះ ប៊ូស្រា ផងដែរ ប៉ុន្ដែ ពេលនេះ មិន បាន ប៉ះពាល់ ឬ ទៅ ជិតស្និត ជាមួយ ភ្ញៀវ ដ៏ទៃ ទៀត នោះ ទេ ។ តែ យ៉ាងណា ក៏ដោយ អាជ្ញាធរ ក៏ បាន ឲ្យ អ្នកលក់ដូរ នៅ តំបន់ នោះ ធ្វើចត្តាឡី ស័ក និង តាមដាន សុខភាព ជាប្រចាំ ផងដែរ ៕
ឯកឧត្តម អ៊ុក សម វិទ្យា និង លោកជំទាវ បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម អ៊ុក សម វិទ្យា ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក បេឡា ជាតិ សន្តិសុខ សង្គម និង លោកជំទាវ បាន ស្ម័គ្រចិត្ត បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ អាមេរិក ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ប៉ែន កុសល្យ អភិបាល ខេត្ត ឧត្តរមានជ័យ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ការប្រកាស របស់ អាជ្ញាធរ សុខាភិបាល អង់គ្លេស ខាងលើ នេះ ត្រូវបាន ធ្វើឡើង ភ្លាម ៗ បន្ទាប់ពី បុគ្គលិក សុខាភិបាល (NHS) របស់ ខ្លួន ចំនួន ០២ នាក់ ដែល បាន ទទួល ការចាក់ វ៉ាក់សាំង កាលពី ថ្ងៃអង្គារ សប្តាហ៍ នេះ បាន ជួប អការៈ អាលែកហ្ស៊ី ប៉ុន្តែ ត្រូវបាន គេ ជឿជាក់ ថា បាន និង កំពុង ធូរស្រាល ឡើ វិញ ជា បណ្តើរ ៗ ហើយ ។
សហព័ន្ធ ស្រូវ អង្ករ កម្ពុជា បង្ហាញ តារាង តម្លៃ ស្រូវ សើម នៅ វាល ស្រែ ដែល កំពុង ប្រមូល ផល តាម បណ្តា ខេត្ត មួយចំនួន សម្រាប់ ថ្ងៃទី ០៩ ខែធ្នូ នេះ
( ភ្នំពេញ ) ៖ សហព័ន្ធ ស្រូវ អង្ក កម្ពុជា បាន បង្ហាញ តារា តម្លៃ ស្រូវ សើម នៅ វាល ស្រែ ដែល កំពុង ប្រមូល ផល តាម បណ្តា ខេត្ត មួយចំនួន សម្រាប់ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ៕
អ្នកនាំពាក្យ អគ្គ ស្នងការដ្ឋាន៖ ថ្ងៃទី ០៩ ខែធ្នូ នេះ មាន យានយន្ត ៤៧៩ គ្រឿង ទៀត ត្រូវបាន ត្រួតពិនិត្យ និង ផាក ពិន័យ
បើ តាម អ្នកនាំពាក្យ អគ្គ ស្នងការ រយៈពេល ២២៣ ថ្ងៃ នៃ ការរឹតបន្ដឹង ច្បាប់ ចរាចរណ៍ ផ្លូវគោក ដោយ បង្កើន ប្រាក់ ពិន័យ តាម អនុក្រឹត្យ លេខ ៣៩ ពោលគឺ ថ្ងៃទី ០១ ខែឧសភា ដល់ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នគរបាល ចរាចរណ៍ ទូទាំង ប្រទេស បាន ត្រួតពិនិត្យ និង ផាក ពិន័យ យានយន្ត សរុប ចំនួន ២៣១ .៦៧១ គ្រឿង ក្នុង នោះ មាន ម៉ូតូ ១៧០ .៦៣៤ គ្រឿង និង រថយន្ត គ្រប់ ប្រភេទ ៦១. ០៣៧ គ្រឿង ។
ឧត្តមសេនីយ៍ ឯក ឆាយ គឹម ខឿន បាន បន្ត ថា រយៈពេល ២២៣ ថ្ងៃ មក នេះ ការអនុវត្ត តាម អនុក្រឹត្យ ថ្មី ក្នុង ការផាកពិន័យ យានយន្ត ល្មើស បាន ដំណើរការ ទៅ យ៉ាង ល្អ ប្រសើរ ។ លោក បាន ថ្លែងអំណរគុណ និង កោតសរសើរ ដល់ ជន រួម ជាតិ ជា អ្នកប្រើប្រាស់ ផ្លូវ ទាំងអស់ ដែល បាន ចូលរួម គោរព ច្បាប់ ចរាចរណ៍ យ៉ាង ល្អ ប្រសើរ រយៈពេល កន្លងមក នេះ ជាពិសេស កោតសរសើរ និង អរគុណ ដល់ នគរបាល ចរាចរណ៍ ដែល បាន លះបង់ និង ខិតខំ ប្រឹងប្រែង ជំរុញ ការរឹតបន្តឹង ចរាចរណ៍ ប្រកបដោយ ស្មារតី ទទួលខុសត្រូវ ខ្ពស់ បំផុត ។
សូម បញ្ជាក់ ថា សម្រាប់ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កម្ពុជា ក៏ បាន កើតឡើង ចំនួន ១១លើក ក្នុង នោះ ស្លាប់ ០៣ នាក់ របួស ១៣នាក់ ( របួស ធ្ងន់ ០៩ នាក់ ) ។
តំណាងរាស្ដ្រ ចំនួន ៤រូប ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ១លាន រៀល រយៈពេល ៦ខែ ជូន រាជ រដ្ឋាភិបាល សម្រាប់ ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ តំណាងរាស្ដ្រ ចំនួន ០៤ រូប បាន ប្រកាស បរិច្ចាគ ប្រាក់ បៀវត្ស ចំនួន ១លាន រៀល ក្នុង មួយ ខែ រយៈពេល ៦ខែ ចាប់ពី ខែមករា - មិថុនា ឆ្នាំ ២០២១ ជូន រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី យក ប្រើប្រាស់ សម្រាប់ ទិញ វ៉ាក់សាំង កូវីដ១៩ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
តំណាងរាស្ដ្រ ទាំង ៥រូប នេះ រួម មាន៖
* ទី១៖ លោកជំទាវ ម៉ាណ ណាវី អ្នកតំណាងរាស្ត្រ មណ្ឌល រាជធានី ភ្នំពេញ *ទី ២៖ ឯកឧត្តម រ៉ូហ្វី អូស្មាន់ តំណាងរាស្ត្រ មណ្ឌល ពោធិ៍សាត់ * ទី ៣៖ ឯកឧត្តម សុះ មុះ សិន សមាជិក គណៈកម្មការ ទី៨ នៃ រដ្ឋសភា និង ជា តំណាងរាស្រ្ត មណ្ឌល កណ្តាល *ទី ៤៖ ឯកឧត្តម ម៉ាត់ សេត សមាជិក គណៈកម្មការ ទី៧ នៃ រដ្ឋសភា និង ជា តំណាងរាស្ត្រ មណ្ឌល កំពត ។
ការប្រកាស របស់ ឯកឧត្តម លោកជំទាវ ជា តំណាងរាស្ដ្រ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ប្រកាស ពី ការត្រៀម ថវិកា ទិញ វ៉ាក់សាំង កូវីដ១៩ មក ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ អភិបាល ខណ្ឌ ព្រែក ព្នៅ និង ភរិយា បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក សុខ សម្បត្តិ អភិបាល ខណ្ឌ ព្រែក ព្នៅ និង ភរិយា បាន បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ លោក ស៊ូ សោគ ន្ធ អភិបាល រង ខណ្ឌ ប្ញស្សីកែវ និង ភរិយា ហម សុជាតា បរិច្ចាគ ថវិកា ចំនួន ២៥០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ស៊ូ សោគ ន្ធ អភិបាល រង ខណ្ឌ ប្ញស្សីកែវ និង ភរិយា ហម សុជាតា បរិច្ចាគ ថវិកា ២៥០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
កូនស្រី ស្លាប់ ឪពុក ម្តាយ មិន មាន លុយ សម្រាប់ ធ្វើ បុណ្យ . សាខា កាកបាទ ក្រហម កម្ពុជា ខេត្ត បន្ទាយមានជ័យ នាំយក អំណោយ ចូលរួម បុណ្យ សព គ្រួសារ ក្រីក្រ ស្ថិត នៅ ក្រុង សិរី សោភ័ណ
នៅក្នុង ឱកាស នោះ លោក លី សារី បាន ពាំនាំ ការសាកសួរ សុខទុក្ខ និង ចូលរួម សោកស្តាយ ចំពោះ គ្រួសារ សព របស់ ប្អូន ស្រី ពីសំណាក់ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ប្រធាន កាកបាទ ក្រហម កម្ពុជា ដែល ជានិច្ចកាល សម្តេច តែងតែ យកចិត្ត ទុក្ខ ដាក់ គិត គូរ ពី ទុក្ខលំបាក របស់ បងប្អូន ប្រជាពលរដ្ឋ គ្រប់ ឧប្បទ្ទវហេតុ ផ្សេង មិន ថា ទី ជិត ក្តី ឫ ឆ្ងាយក្តី ។
លោក បាន បន្ត ថា ក្រោយពី ទទួលបាន ព័ត៌មាន លោក ក៏ បាន ចុះ សួរសុក ទុក្ខ ភ្លាម ដើម្បី នាំយក នូវ ថវិកា មួយ ចំនួន ក្នុង ការចូលរួមចំណែក រំលែក ទុក្ខ ជាមួយ ក្រុមគ្រួសារ សព ប្អូន ស្រី និង ចូលរួម រំលែក ទុក្ខ ដ៏ ក្រៀមក្រំ ជា ទីបំផុត ចំពោះ គ្រួសារ ដែល បាន បាត់បង់ កូន ចៅ ជាទី ស្រលាញ់ ផង នោះ ។ ជាពិសេស អំណោយ ដែល បាន យកមក ផ្តល់ ជូន នា ពេលនេះ ដើម្បី ចូលរួមចំណែក កាត់បន្ថយ ជីវភាព បាន មួយ ផ្នែក ផងដែរ ។
លោក លី សារី សូមឲ្យ ដួង វិញ្ញាណក្ខន្ធ សព របស់ ប្អូន ស្រី យ៉ាត ស្រី ណុច ឱ្យ បាន ទៅកាន់ ឋាន បរម សុខ នៅក្នុង សុគតិភព កុំបី ឃ្លាង ឃ្លាត ឡើយ ។
ក្រុមគ្រួសា នៃ សព ក៏ បាន លើក ម្រាម ដៃ ដប់ សំពះ ថ្លែងអំណរ អគុណ ចំពោះ សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល តែងតែ គិតគូរ ពី សុខ ទុក្ខ ចំពោះ ពលរដ្ឋ ក្រីក្រ ដែល បាន ផ្តល់ អំណោយ តាមរយៈ លោក លី សារី និង អគុណ ចំពោះ នាយ ប៉ុស្តិ៍ នា រង ប៉ុស្តិ៍ នគបាល អន្តោប្រវេសន៍ ច្រទ្វា អន្តរជាតិ ប៉ោយប៉ែត ដែល មាន សទ្ធា ប្រមូល បច្ច័យ ចូលរួម រំលែក ទុក គ្រួសាស ព ផងដែរ ។
( ភ្នំពេញ ) ៖ លោក គឹម រស្មី និង ភរិយា បាន បរិច្ចាគ ថវិកា ១០០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
រដ្ឋបាល រាជធានី ភ្នំពេញ អំពាវនាវ មន្ដ្រីរាជការ និង ប្រជាពលរដ្ឋ ចូលរួម បរិច្ចាគ ធនធាន ជាមួយ រាជ រដ្ឋាភិបាល ដើម្បី ទិញ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ឃួង ស្រេង អភិបាល រាជធានី ភ្នំពេញ នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន អំពាវនាវ ដល់ មន្ដ្រីរាជការ និង ប្រជាពលរដ្ឋ ចូលរួម បរិច្ចាគ ធនធាន តាម លទ្ធភាព ដើម្បី រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការទិញ វ៉ាក់សាំង ប្រឆាំង ជំងឺ កូវីដ - ១៩ ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ។
ក្នុង លិខិត អំពាវនាវ នោះ រដ្ឋបាល រាជធានី ភ្នំពេញ សង្ឃឺម ជឿជាក់ លើ ស្មារតី និង ទឹកចិត្ត សប្បុរសធម៌ ដែល ជា វប្បធម៌ នៃ ការចែករំលែក របស់ ប្រជាជាតិ ។ ទឹកចិត្ត សប្បុរស របស់ ប្រជាពលរដ្ឋ នឹង បាន ជួយ ដល់ គ្រប់ វិស័យ ដូចជា សេដ្ឋកិច្ច សុខភាព សាធារណៈ សង្គមកិច្ច ជាពិសេស ជួយ ដល់ គ្រួសារ បងប្អូន ផ្ទាល់ ។
ការអំពាវនាវ របស់ ប្រមុខ ដឹកនាំ កំពូល រាជ រដ្ឋាភិបាល កម្ពុជា បាន ធ្វើឡើង នៅ កិច្ចប្រជុំ កំពូល នៃ យុទ្ធសាស្រ្ត កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច អាយ៉េ យ៉ាវ៉ាឌី - ចៅ ប្រាយ៉ា - មេគង្គ (ACMECS) លើក ទី៩ តាម ប្រព័ន្ធ វីដេអូ ដែល បាន ធ្វើឡើង នៅ ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០២០ ។ សម្តេច តេជោ ហ៊ុន សែន គឺជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ កំពូល មួយ នេះ ។
ក្រសួង ការបរទេស បាន បន្ថែម ថា ក្រោម មូល បទ « ភាពជាដៃគូ ដើម្បី ការតភ្ជាប់ និង ភាពរឹងមាំ » ថ្នាក់ដឹកនាំ អេក ម៉ិក បាន អះអាង សា ជា ថ្មី ពី ការប្តេជ្ញាចិត្ត ដ៏ មុតមាំ ដើម្បី ទាញយក ឱ្យ បាន ពេញលេញ នូវ សក្ដានុពល សេដ្ឋកិច្ច ដ៏ ធំ សម្បើម របស់ អនុ តំបន់ ព្រមទាំង រៀបចំ ផែនការ សកម្មភាព ដើម្បី សម្រេចបាន នូវ សហគមន៍ អេក ម៉ិក ដែល កាន់តែ តភ្ជាប់ វៃ ឆ្លាត មាន ចីរភាព និង រឹងមាំ ដោយ ឈរ លើ ស្មារតី ភាព ជា អ្នកជិតខាង ល្អ និង មិត្តភាព ប្រពៃណី ក្នុង ការសម្រេច ឱ្យ បាន នូវ សន្តិភាព ស្ថិរភាព និង វិបុលភាព ។
ថ្នាក់ដឹកនាំ អេក ម៉ិក បាន កោតស សើរ កម្ពុជា ដែល ជា ប្រធាន សម្រាប់ រយៈពេល ពីរ ឆ្នាំ ក្នុង ការជំរុញ នូវ គោលដៅ រួម របស់ ប្រទេស សមាជិក ដើម្បី សម្រច បាន នូវ វិបុលភាព និង សុខុមាលភាព របស់ ប្រជាជន ស្ថិត ក្នុង កាលៈទេសៈ ដ៏ ប្រឈម ដែល បង្កឡើង ដោយ ជំងឺ រាតត្បាត កូវីដ - ១៩ និង បញ្ហា សន្តិសុខ មិន មែន ប្រពៃណី នានា មក លើ ជីវភាព រស់ នៅ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម នៅក្នុង អនុ តំបន់ ៕
នាយ ឧត្តមសេនីយ៍ ឃឹម ប៊ុន សុង បរិច្ចាគ ថវិកា ៥០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ ឃឹម ប៊ុន សុង រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ និង ជា ប្រធាន ក្រុមប្រឹក្សា កីឡាកងយោធពល ខេមរភូមិន្ទ ព្រមទាំង សហការី នាយក នាយក រង មជ្ឈមណ្ឌល កីឡាកងយោធពល ខេមរភូមិន្ទ បរិច្ចាគ ថវិកា ៥០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១.០០០.០០០ ដូស ដើម្បី ចាក់ ប្រជាពលរដ្ឋ ប្រមាណ ៥០០.០០០ នាក់ ៕ ឧកញ៉ា ស្រី ចាន់ ថន បាន យក ទឹកប្រាក់ ៧៧. ៧៧៧ ដុល្លារ ទៅ ប្រគល់ ជូន លោក សេង ទៀង ដើម្បី ចូលរួម ទិញ វ៉ាក់សាំង
ក្រសួង ការបរទេស បញ្ជាក់ ថា លទ្ធផល សំខាន់ ៗ នៃ កិច្ចប្រជុំ កំពូល ទាំង៣ មាន ដូច ខាងក្រោម៖
ក្រោម មូល បទ « ភាពជាដៃគូ ដើម្បី ការតភ្ជាប់ និង ភាពរឹងមាំ » ថ្នាក់ដឹកនាំ អេក ម៉ិក បាន អះអាង សា ជា ថ្មី ពី ការប្តេជ្ញាចិត្ត ដ៏ មុតមាំ ដើម្បី ទាញយក ឱ្យ បាន ពេញលេញ នូវ សក្ដានុពល សេដ្ឋកិច្ច ដ៏ ធំ សម្បើម របស់ អនុ តំបន់ ព្រមទាំង រៀបចំ ផែនការ សកម្មភាព ដើម្បី សម្រេចបាន នូវ សហគមន៍ អេក ម៉ិក ដែល កាន់តែ តភ្ជាប់ វៃ ឆ្លាត មាន ចីរភាព និង រឹងមាំ ដោយ ឈរ លើ ស្មារតី ភាព ជា អ្នកជិតខាង ល្អ និង មិត្តភាព ប្រពៃណី ក្នុង ការសម្រេច ឱ្យ បាន នូវ សន្តិភាព ស្ថិរភាព និង វិបុលភាព ។
ថ្នាក់ដឹកនាំ អេក ម៉ិក បាន កោតស សើរ កម្ពុជា ដែល ជា ប្រធាន សម្រាប់ រយៈពេល ពីរ ឆ្នាំ ក្នុង ការជំរុញ នូវ គោលដៅ រួម របស់ ប្រទេស សមាជិក ដើម្បី សម្រច បាន នូវ វិបុលភាព និង សុខុមាលភាព របស់ ប្រជាជន ស្ថិត ក្នុង កាលៈទេសៈ ដ៏ ប្រឈម ដែល បង្កឡើង ដោយ ជំងឺ រាតត្បាត កូវីដ - ១៩ និង បញ្ហា សន្តិសុខ មិន មែន ប្រពៃណី នានា មក លើ ជីវភាព រស់ នៅ និង ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម នៅក្នុង អនុ តំបន់ ។
ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ថ្នាក់ដឹកនាំ បាន ឯកភាព គ្នា បន្ត ពង្រឹង កិច្ច ខិតខំ ប្រឹងប្រែង ថ្នាក់ ជាតិ និង លើកកម្ពស់ កិច្ចសហប្រតិបត្តិការ ក្នុង ក្របខ័ណ្ឌ យន្តការ ដែល ដឹកនាំ ដោយ អាស៊ាន ជាមួយ ដៃគូ ក្រៅ តំបន់ និង អង្គការ អន្តរជាតិ ជាពិសេស អង្គការ សុខភាព ពិភពលោក ដើម្បី ធានា ឱ្យ បាន នូវ វ៉ាក់សាំង ជា ទំនិញ សាធារណៈ និង ការទទួលបាន សេវាកម្ម វេជ្ជសាស្ត្រ ក្នុង តម្លៃ សមរម្យ សម្រាប់ ប្រជាជន ។
ពាក់ព័ន្ធ នឹង ការស្តារ សេដ្ឋកិច្ច - សង្គម ឡើងវិញ ថ្នាក់ដឹកនាំ បាន ពិភាក្សា ពី មធ្យោបាយ និង គោលការណ៍ សហការ ដែល ប្រទេស សមាជិក អាច ជំរុញ ការតភ្ជាប់ ពហុ វិស័យ ប្រកបដោយ សុវត្ថិភាព និង សន្តិសុខ និង ដោះស្រាយ បញ្ហា នានា ដែល បណ្តាល មកពី ជំងឺ កូវីដ - ១៩ មក លើ ការបំលាស់ ទី និង ខ្សែ ចង្វាក់ តម្លៃ សកល ព្រមទាំង ធានា ឱ្យ បាន គ្រប់គ្រាន់ នូវ ការ ការពារ សង្គម និង ប្រជាជន ដែល រង ផល ប៉ះពាល់ ។
ថ្នាក់ដឹកនាំ បាន បញ្ចប់ កិច្ចប្រជុំ ដោយ បាន អនុម័ត លើ សេចក្តីថ្លែងការណ៍ ទីក្រុង ភ្នំពេញ នៃ កិច្ចប្រជុំ កំពូល អេក ម៉ិក លើក ទី៩ ដែល ក្នុង នោះ មាន ឯកសារ ចំនួន ០៣ ជា ឧបសម្ព័ន្ធ៖ ( ១ ) ឯកសារ លក្ខខណ្ឌ យោង ស្តីពី មូលនិធិ អភិវឌ្ឍន៍ អេក ម៉ិក ( ២) ឯកសារ ទស្សនា ទាន ស្តីពី យន្តការការងារ នៃ គណៈកម្មាធិការ សម្របសម្រួល អេក ម៉ិក នៃ ផែនការ មេ អេក ម៉ិក ឆ្នាំ ២០១៩ - ២០២៣ និង ( ៣) បញ្ជី គម្រោង អាទិភាព របស់ ប្រទេស អេក ម៉ិក ។
ក្រោម មូល បទ « លើកកម្ពស់ ការតភ្ជាប់ ប្រកបដោយ ប្រសិទ្ធភាព សម្រាប់ សមាហរណកម្ម តំបន់ » ថ្នាក់ដឹកនាំ CLMV បាន សម្តែង ការពេញចិត្ត ចំពោះ ការអនុវត្ត លទ្ធផល នៃ កិច្ចប្រជុំ កំពូល CLMV លើក ទី៩ និង បាន បញ្ជាក់ ជាថ្មី នូវ ទំនាក់ទំនង មិត្តភាព ជា ប្រពៃណី ដ៏ យូរអង្វែង ភាពជា អ្នកជិតខាង ល្អ និង ផលប្រយោជន៍ ទៅ វិញ ទៅ មក ក្នុង ចំណោម ប្រទេស សមាជិក ទាំង៤ ក៏ ដូចជា បាន ផ្លាស់ប្តូរ ទស្សនៈ លើ ទិសដៅ នា ពេល អនាគត នៃ កិច្ចសហប្រតិបត្តិការ CLMV ដែល ជា ផ្នែក សំខាន់ មួយ នៃ ដំណើរការ កសាង សហគមន៍ អាស៊ាន ។
ថ្នាក់ដឹកនាំ បាន រំលឹក ឡើងវិញ ពី សារៈសំខាន់ នៃ កិច្ចសហប្រតិបត្តិការ CLMV ក្នុង ការបង្រួម គម្លាត អភិវឌ្ឍន៍ ក្នុង តំបន់ អាស៊ាន ការធានា សន្តិភាព ស្ថិរភាព វិបុលភាព និង ការលើកកម្ពស់ ជីវភាព រស់ នៅ របស់ ប្រជាជន ក្នុង តំបន់ ក៏ ដូចជា បង្កើត ជា ធាតុ សំខាន់ មួយ ក្នុង កិច្ច ខិតខំ ប្រឹងប្រែង ពហុ ភាគី ដើម្បី ប្រយុទ្ធ ប្រឆាំង និង ការស្តារ ឡើងវិញ ពី ជំងឺ រាតត្បាត កូវីដ - ១៩ ។
ដើម្បី ដោះស្រាយ បញ្ហា ប្រឈម នា ពេល អនាគត ថ្នាក់ដឹកនាំ បាន គូសបញ្ជាក់ ពី សារៈសំខាន់ នៃ ផែនការ សកម្មភាព CLMV ( ២០២១ - ២០២២ ) ដែល បាន អនុម័ត ដោយ រដ្ឋមន្រ្តី សេដ្ឋកិច្ច CLMV កាលពី ថ្ងៃទី ២៤ ខែសីហា ឆ្នាំ ២០២០ ដោយ បាន បញ្ជាក់ នូវ ទិសដៅ ច្បាស់លាស់ ក្នុង កិច្ចសហប្រតិបត្តិការ ពាណិជ្ជកម្ម និង វិនិយោគ ការអភិវឌ្ឍ ធនធាន មនុស្ស ការអនុវត្ត ការប្តេជ្ញាចិត្ត ក្នុង តំបន់ ការស្តារ ឡើងវិញ ក្រោយ កូវីដ១៩ និង ក្របខ័ណ្ឌ សម្រាប់ ប្រែក្លាយ តំបន់ នេះ ទៅជា មជ្ឈមណ្ឌល ធុរកិច្ច ជឿនលឿន សកល ។
តាមរយៈ គោលបំណង ចម្បង នៃ យន្តការ ក្នុង ការធ្វើឱ្យ កាន់តែ ស៊ីជម្រៅ និង ពន្លឿន កិច្ច ខិតខំ ប្រឹងប្រែង ធ្វើ សមាហរណកម្ម អាស៊ាន ថ្នាក់ដឹកនាំ បាន យកចិត្តទុកដាក់ យ៉ាង ខ្លាំង ចំពោះ ការអនុវត្ត ប្រកបដោយ ប្រសិទ្ធភាព នៃ ផែនការ មេស្តីពី ការតភ្ជាប់ អាស៊ាន ២០២៥ ដែល ផ្តោត លើ ហេដ្ឋារចនាសម្ព័ន្ធ ស្ថាប័ន សេដ្ឋកិច្ច និង ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ក៏ ដូចជា ផែនការ សកម្មភាព ទី៤ នៃ គំនិត ផ្តួចផ្តើម សម្រាប់ សមាហរណកម្ម អាស៊ាន ( ២០២១ - ២០២៥) ។
ថ្នាក់ដឹកនាំ ប្រទេស កម្ពុជា - ឡាវ - វៀតណាម បាន បង្ហាញ ការប្តេជ្ញាចិត្ត យ៉ាង មុតមាំ ក្នុង ការលើកកម្ពស់ ការអភិវឌ្ឍ តំបន់ ត្រីកោណ កម្ពុជា - ឡាវ - វៀតណាម (CLV DTA) ជាមួយនឹង ទស្សនៈ ក្នុង ការពន្លឿន កំណើន សេដ្ឋកិច្ច ការកាត់បន្ថយ ភាពក្រីក្រ និង វឌ្ឍនភាព សង្គម - វប្បធម៌ ដោយ ទាញយក នូវ សក្តានុពល កម្លាំង និង ធនធាន របស់ ប្រទេស សមាជិក នីមួយ ៗ ។
ថ្នាក់ដឹកនាំ បាន ទទួលស្គាល់ ថា ជំងឺ កូវីដ - ១៩ បាន នាំមក នូវ ការរំខាន យ៉ាង ធំធេង ដល់ សុខភាព សាធារណៈ និង សេដ្ឋកិច្ច - សង្គម ដូច្នេះ ការពង្រឹង កិច្ចសហប្រតិបត្តិការ គ្រប់ ជ្រុងជ្រោយ រវាង ប្រទេស សមាជិក ទាំង បី គឺ មាន សារៈសំខាន់ និង ចាំបាច់ ដោយ ផ្តោត លើ ទំនាក់ទំនង ប្រពៃណី សាមគ្គីភាព ការយោគយល់ ការជឿជាក់ អត្ថប្រយោជន៍ រួម និង ការអភិវឌ្ឍ ប្រកបដោយ ចីរភាព ។
ក្នុង អំឡុង ពេល កិច្ចប្រជុំ សម្តេច តេជោ នាយក រដ្ឋមន្រ្តី បាន គូសបញ្ជាក់ ពី ភាពចាំបាច់ នៃ ការបន្ត កិច្ចសហប្រតិបត្តិការ រវាង ប្រទេស CLV ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ការជួញដូរ មនុស្ស និង គ្រឿងញៀន បទល្មើស ឆ្លង ដែន បទល្មើស ព្រៃឈើ និង ឧក្រិដ្ឋកម្ម ឆ្លង ដែន ផ្សេង ទៀត ក៏ ដូចជា ការបោសសំអាត មីន ព្រមទាំង ការជួយ សម្រួល ដល់ ការឆ្លងកាត់ ព្រំដែន របស់ អ្នកដំណើរ ។
ឯកឧត្តម កិត្តិបរិរក្ស បណ្ឌិត គាត ឈន់ និង ភរិយា ឡាយ នារី បរិច្ចាគ ថវិកា ៤០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម កិត្តិបរិរក្ស បណ្ឌិត គាត ឈន់ ប្រធាន កិត្តិយស ឧត្តម ក្រុមប្រឹក្សា សេដ្ឋកិច្ច ជាតិ និង ភរិយា ឡាយ នារី នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ៤០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង ប្រឆាំង មេរោគ កូវីដ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ការចូលរួម បរិច្ចាគ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ពី ការត្រៀម ថវិកា ទិញ វ៉ាក់សាំង កូវីដ១៩ មក ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ស្រប ពេល ដែល មេរោគ មួយ នេះ បាន ឆ្លង ចូល ដល់ សហគមន៍ កម្ពុជា ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ បញ្ជី ឈ្មោះ អគ្គ ព្រះរាជអាជ្ញា សាលាឧទ្ធរណ៍ តំបន់ និង ព្រះរាជអាជ្ញា សាលាដំបូង រាជធានី - ខេត្ត បរិច្ចាគ ថវិកា សរុប ១៩ លាន រៀល និង ២៥. ២០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ បញ្ជី ឈ្មោះ អគ្គ ព្រះរាជអាជ្ញា នៃ មហា អយ្យការ អម សាលាឧទ្ធរណ៍ តំបន់ និង ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង រាជធានី - ខេត្ត ដែល បាន បរិច្ចាគ ថវិកា សរុប ១៩ លាន រៀល និង ២៥. ២០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ បញ្ជី ឈ្មោះ ប្រធាន សាលាឧទ្ធរណ៍ តំបន់ និង ប្រធាន សាលាដំបូង រាជធានី - ខេត្ត បរិច្ចាគ ថវិកា សរុប ៩១ លាន រៀល និង ៤.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ បញ្ជី ឈ្មោះ ប្រធាន សាលាឧទ្ធរណ៍ តំបន់ និង ប្រធាន សាលាដំបូង រាជធានី - ខេត្ត ដែល បាន បរិច្ចាគ ថវិកា សរុប ៩១ លាន រៀល និង ៤.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ លោកស្រី ជា សិរី ទទួលបាន ពានរង្វាន់ « ប្រព័ន្ធ ទូទាត់ នា ពេល អនាគត » ពី មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ បច្ចេកវិទ្យា និង សហគ្រិន និង វិទ្យាស្ថាន ធនាគារ ប៊ុយ ដា ប៉ែ ស
( ភ្នំពេញ ) ៖ លោកស្រី ជា សិរី ឧបការី ទេសាភិបាល និង ជា អគ្គ នាយក បច្ចេកទេស នៃ ធនាគារ ជាតិ នៃ កម្ពុជា ទទួលបាន ពានរង្វាន់ « ប្រព័ន្ធ ទូទាត់ នា ពេល អនាគត » ពី មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ បច្ចេកវិទ្យា និង សហគ្រិន និង វិទ្យាស្ថាន ធនាគារ ប៊ុយ ដាប៉ែស ។
ធនាគារ ជាតិ នៃ កម្ពុជា មាន មោទនភាព យ៉ាង ខ្លាំង ដែល ថ្នាក់ដឹកនាំ ធនាគារ ជាតិ នៃ កម្ពុជា មួយ រូប នេះ ទទួលបាន ពានរង្វាន់ « ប្រព័ន្ធ ទូទាត់ នា ពេល អនាគត » ពី មជ្ឈមណ្ឌល ហិរញ្ញវត្ថុ បច្ចេកវិទ្យា និង សហគ្រិន និង វិទ្យាស្ថាន ធនាគារ ប៊ុយ ដាប៉ែស ។
ជាក់ស្ដែង ដោយ មើលឃើញ ពី ការទូទាត់ របស់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ នៅ កម្ពុជា ពុំ ទាន់ មាន លទ្ធភាព អាច ធ្វើ ការទូទាត់ ឆ្លង គ្រឹះស្ថាន បាន ហើយ គ្រឹះស្ថាន ភាគ ច្រើន បាន រៀបចំ ប្រព័ន្ធ ទូទាត់ សម្រាប់ បម្រើ សេវា ជូន តែ អតិថិជន របស់ គ្រឹះស្ថាន ផ្ទាល់ខ្លួន ប៉ុណ្ណោះ ខណៈ ដែល គ្រឹះស្ថាន មួយចំនួន ទៀត បាន សហការផ្តល់ សេវា ទូទាត់ ជា លក្ខណៈ ទ្វេ ភាគី ជាមួយ ដៃគូ របស់ ខ្លួន ។
ប្រព័ន្ធ បាគង ជា ហេដ្ឋារចនាសម្ព័ន្ធ ប្រព័ន្ធ ទូទាត់ ស្នូល សម្រាប់ ផ្តល់ លទ្ធភាព ដល់ គ្រឹះស្ថាន ធនាគារ និង ហិរញ្ញវត្ថុ ជា សមាជិក អាច ធ្វើ ប្រតិបត្តិការ ទូទាត់ សង ប្រាក់ ឆ្លង ប្រព័ន្ធ គ្នា ទៅ វិញ ទៅ មក (Interoperability) ប្រកបដោយ សុវត្ថិភាព ប្រសិទ្ធភាព មិន គិត កម្រៃ សេវា ផ្ទេរ ប្រាក់ កាត់បន្ថយ ចំណាយ ប្រតិបត្តិការ និង ជំរុញ បរិយាប័ន្ន ហិរញ្ញវត្ថុ ។
ប្រព័ន្ធ បាគង បាន និង កំពុង ចូលរួម ក្នុង ការជំរុញ ការទូទាត់ ( មិន ប្រើ សាច់ប្រាក់ ) ដែល យើង សង្កេតឃើញ ថា តម្រូវការ ទូទាត់ អេឡិចត្រូនិក មាន ការកើនឡើង ក្នុង បរិការណ៍ ប្រទេស កំពុង ទទួលរង ផល ប៉ះពាល់ ពី ជំងឺ កូវីដ១៩ ។
ការដាក់ ឱ្យ ដំណើរការ ប្រព័ន្ធ បាគង គឺជា ជោគជ័យ ថ្មី មួយ ទៀត ដែល ធនាគារ ជាតិ នៃ កម្ពុជា សម្រេចបាន ក្នុង ការធ្វើ ទំនើបកម្ម ប្រព័ន្ធ ទូទាត់ ដែល ឆ្លើយតប ទៅនឹង ការរីកចម្រើន ផ្នែក សេដ្ឋកិច្ច និង បច្ចេកវិទ្យា ហិរញ្ញវត្ថុ នា ពេល បច្ចុប្បន្ន ព្រមទាំង រួមចំណែក ក្នុង ការជំរុញ សេដ្ឋកិច្ច ឆ្ពោះ ទៅរក សេដ្ឋកិច្ច ឌីជីថល ស្រប តាម បដិវត្តន៍ ឧស្សាហកម្ម ៤.០ និង បរិបទ សេដ្ឋកិច្ច ឌីជីថល ក្នុង តំបន់ ៕
ក្រសួង ចំនួន ៣ ចេញ ប្រកាស រួម ស្តីពី លក្ខខណ្ឌ នៃ ការចេញ បណ្ណ បើកបរ សម្រាប់ ជន មាន ពិការ ភាព
( ភ្នំពេញ ) ៖ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន ក្រសួង សុខាភិបាល និង ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ចេញ ប្រកាស រួមគ្នា ស្តីពី ពី លក្ខខណ្ឌ នៃ ការចេញ បណ្ណ បើកបរ សម្រាប់ ជន មាន ពិការ ភាព ក្នុង គោលបំណង លើកកម្ពស់ សិទ្ធិ ជន មាន ពិការភាព ដែល មាន សមត្ថភាព អាច បើកបរ យានយន្ត បាន ។ នេះ បើ យោង តាម ប្រកាស អន្តរ ក្រសួង ដែល Fresh News ទទួលបាន នៅ រសៀល ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ៕
សម្រាប់ ព័ត៌មាន កម្អិត សូម មើល ប្រកាស អន្តរ ក្រសួង ដែល មាន នៅ ខាងក្រោម នេះ៖ ឯកឧត្តម នឿន វិទ្យា និង លោកជំទាវ បរិច្ចាគ ថវិកា ៤លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម នឿន វិទ្យា ប្រធាន នាយកដ្ឋាន គ្រប់គ្រង សារធាតុ គីមី នៃ អគ្គ លេខាធិការដ្ឋាន អាជ្ញាធរ ជាតិ អាវុធ គីមី និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ៤លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម នូ សុវត្ថិ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម នូ សុវត្ថិ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ព្រះអង្គម្ចាស់ ព្រះនាម ព្រះទេវ សត្ថា ពើយ មេត្តា បរិច្ចាគ ថវិកា ៥.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ព្រះអង្គម្ចាស់ ព្រះនាម ព្រះទេវ សត្ថា ពើយ មេត្តា រាជា គណៈ ថ្នាក់ កិត្តិយស ព្រះចៅ អធិការ វត្ត ពោធិវង្ស ខណ្ឌ សែនសុខ រាជធានី ភ្នំពេញ បាន បរិច្ចាគ ថវិកា ៥.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោកស្រី ឱ វណ្ណឌីន រដ្ឋលេខាធិការ និង ជា អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « នោះ ព័ត៌មាន ប្រឌិត ដែល ក្រសួង សុខាភិបាល ធ្លាប់ បាន ច្រានចោល ច្រើន ដង មក ហើយ ។ សូម បងប្អូន កុំ ជឿ ហើយ សូម អាជ្ញាធរ មាន សមត្ថកិច្ច ជួយ ចាត់ការ តាម ផ្លូវ ច្បាប់ ផង »៕ ឯកឧត្តម គង់ វិបុល បរិច្ចាគ ថវិកា ៣ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម គង់ វិបុល ប្រតិភូ រាជ រដ្ឋាភិបាល ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន ពន្ធដារ បាន បរិច្ចាគ ថវិកា ៣ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ប្រធាន ក្រុមប្រឹក្សា ខេត្ត និង ថ្នាក់ដឹកនាំ ខេត្ដ បាត់ដំបង បរិច្ចាគ ថវិកា ៤០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម អ៊ុយ រី ប្រធាន ក្រុមប្រឹក្សា ខេត្ត . ឯកឧត្តម ងួន រតនៈ អភិបាល ខេត្ត ព្រមទាំង ឯកឧត្តម លោកជំទាវ សមាជិក ក្រុមប្រឹក្សា ខេត្ត និង អភិបាល រង ខេត្ត បាត់ដំបង បាន បរិច្ចាគ ថវិកា ៤០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម វង្ស៉ី វិស្សុត បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម រង្ស៉ី វិស្សុត រដ្ឋមន្ដ្រី ប្រតិភូ អម នាយក រដ្ឋមន្ដ្រី និង ជា រដ្ឋលេខាធិការ ប្រចាំ ការ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហរិញ្ញវត្ថុ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោក កង ណែម និង លោកស្រី ឆន លឹម ហ៊ន់ បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
សម្តេច ពិជ័យ សេនា ទៀ បាញ់ ចូលរួម កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន លេីក ទី ១៤ តាមរយៈ វីដេអូ
ក្នុង កិច្ចប្រជុំ នេះ ប្រទេស ជា សមាជិក អាស៊ាន បាន ចុះហត្ថលេខា លើ ផែនការ ការពារ ជាតិ អាស៊ាន ឆ្នាំ ២០២០ - ២០២៣ និង បាន ព្រៀង ឯកសារ ស្តី អំពី ការរក្សា ស្ថិរភាព សន្តិសុខ ក្នុង តំបន់ ដោយ ផ្តោត លើ ប្រធានបទ ចំនួន ៥៖
ទី១៖ នីតិវិធី នៃ ការអនុវត្ត ការងារ របស់ កងកម្លាំង បម្រុង អាស៊ាន ក្នុង ជំនួយ ផ្នែក មនុស្សធម៌ និង គ្រោះមហន្តរាយ ។
ទី២៖ នីតិវិធី នៃ ការផ្លាស់ប្តូរ ព័ត៌មាន ភេវរកម្ម ។
ទី៣៖ គោលការណ៍ នៃ ការប្រើប្រាស់ ទង់ជាតិ អាស៊ាន និង ទង់ជាតិ ប្រទេស ជា សមាជិក ក្នុង បេសកកម្ម រក្សា សន្តិភាព ជាមួយ អង្គការ សហ ប្រជាជាតិ ដើម្បី បង្ហាញ ពី សាមគ្គីភាព របស់ ប្រទេស ក្នុង អាស៊ាន លើ ឆាក អន្តរជាតិ ។
ទី៤៖ នីតិវិធី នៃ ការផ្សារ ភ្ជាប់ រវាង កិច្ចប្រជុំ រដ្ឋមន្ត្រី ការពារ ជាតិ អាស៊ាន និង កិច្ចប្រជុំ អគ្គ មេបញ្ជាការ អាស៊ាន ដើម្បី ពង្រឹង កិច្ចសហប្រតិបត្តិការ យោធា ។
ឯកឧត្តម ម៉ុម សារឿន និង លោកជំទាវ គង់ សំអាត បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ម៉ុម សារឿន អភិបាល ខេត្ត ស្ទឹងត្រែង និង លោកជំទាវ គង់ សំអាត បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
អូស្ត្រាលី គ្រោង ផ្តល់ ជំនួយ ឥត សំណង ៨៥ លាន ដុល្លារ ដល់ កម្ពុជា សម្រាប់ ស្តារ សេដ្ឋកិច្ច - សង្គម ពី វិបត្តិ ជំងឺ កូវីដ១៩
( ភ្នំពេញ ) ៖ រដ្ឋាភិបាល អូស្ត្រាលី គ្រោង ផ្តល់ ហិរញ្ញប្បទាន ឥត សំណង ៨៥ លាន ដុល្លារ អាមេរិក ដល់ កម្ពុជា សម្រាប់ ស្តារ សេដ្ឋកិច្ច សង្គម កម្ពុជា ពី វិបត្តិ ជំងី កូវី ដ១៩ ។
ថ្លែង ក្នុង ពិធី ចុះហត្ថលេខា លើ សេចក្តីថ្លែងការណ៍ រួម ដើម្បី ធានា ប្រសិទ្ធភាព នៃ ការអនុវត្តន៍ ផែនការអភិវឌ្ឍន៍ សម្រាប់ ឆ្លើយតប នឹង ជំងឺ កូវីដ១៩ នៅ កម្ពុជា លោក ផាប្លូ កាង ឯក អគ្គ រដ្ឋទូត អូស្ត្រាលី ប្រចាំ កម្ពុជា បាន បញ្ជាក់ ថា រដ្ឋាភិបាល អូស្ត្រាលី នឹង វិនិយោគ លើ ចង្កោម សកម្មភាព នៃ សសរ ស្តម្ភ ទាំង៣ គឺ ការធានា សន្តិសុខ ផ្នែក សុខាភិបាល ស្ថិរភាព សង្គម និង បរិយាប័ន្ន និង ការស្តារ សេដ្ឋកិច្ច ដើម្បី ជួយ កម្ពុជា ពី វិបត្តិ ជំងឺ កូវីដ១៩ ។
លោក បន្ត ថា ចង្កោម សកម្មភាព ទាំងនោះ រួម មាន៖ ការធ្វើឲ្យ ប្រសើរឡើង គុណភាព និង ភាពងាយស្រួល ក្នុង ការទទួល បាន សេវា សុខាភិបាល តាម មន្ទីរពេទ្យ . ការលើកកម្ពស់ យេនឌ័រ និង ពិការ ភាព . ការជំរុញ ផលិតកម្ម ស្បៀង . ការគាំទ្រ ដល់ ការផ្លាស់ប្តូរ ប្រភព ថាមពល និង ការចូលរួម របស់ ប្រជាពលរដ្ឋ ជាមួយ អាជ្ញាធរ មូលដ្ឋាន ដើម្បី ឆ្លើយតប នឹង ជំងឺ កូវីដ១៩ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ទិត ចន្ថា រដ្ឋលេខាធិការ ប្រចាំ ការ ក្រសួង ទេសចរណ៍ និង លោកជំទាវ នូវ រតនា ព្រមទាំង បុត្រ បាន ស្ម័គ្រចិត្ត បរិច្ចាគ ថវិកា ចំនួន ៦.០០០ ដុល្លារ អាមេរិក ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
អ្នកនាង ចោម ក្វាន់ និង អ្នកនាង ចោម ច័ន្ទ បរិច្ចាគ ថវិកា ៤លាន រៀល និង ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ អ្នកនាង ចោម ក្វាន់ និង អ្នកនាង ចោម ច័ន្ទ បាន បរិច្ចាគ ថវិកា ៤លាន រៀល និង ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ក្រុមហ៊ុន ខ្មែរ ហ៊្វូត គ្រុប បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ខ្មែរ ហ៊្វូត គ្រុប បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
ទេសរដ្ឋមន្ដ្រី ឆាយ ថន និង ថ្នាក់ដឹកនាំ ក្រសួង ផែនការ បរិច្ចាគ ថវិកា ១៤.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម កិត្ដិ សេដ្ឋា បណ្ឌិត ឆាយ ថន ទេសរដ្ឋមន្ដ្រី រដ្ឋមន្ដ្រី ក្រសួង ផែនការ និង ថ្នាក់ដឹកនាំ ក្រសួង ផែនការ បាន បរិច្ចាគ ថវិកា ១៤.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ រដ្ឋលេខាធិការ ឯម ច័ន្ទ មក រា៖ ចាប់ពី ថ្ងៃ នេះ ទៅ ជន មាន ពិការភាព អាច មាន សិទ្ធិ ទទួល ប័ណ្ណ បើកបរ ស្រប ច្បាប់ ដើម្បី ប្រើប្រាស់ យានយន្ត នៅក្នុង ព្រះរាជាណាចក្រ កម្ពុជា ហើយ
( ភ្នំពេញ ) ៖ នៅ រសៀល ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ លោក ឯ ម ច័ន្ទ មករា រដ្ឋលេខាធិការ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា និង ជា អគ្គ លេខាធិការ ក្រុមប្រឹក្សា សកម្មភាព ជន ពិការ បាន សម្តែង ក្តី សប្បាយរីករាយ អបអរសាទរ ចំពោះ ជន មាន ពិការភាព ដែល អាច មាន សិទ្ធិ ទទួល ប័ណ្ណ បើកបរ នៅ ព្រះរាជាណាចក្រ កម្ពុជា ។
លោក រដ្ឋលេខាធិការ ឯម ច័ន្ទ មករា បន្ថែម ថា ផ្នែក សំខាន់ ៗ នៃ យានយន្ត ដែល ត្រូវ កែច្នៃ មាន ដូចជា ហ្នឹង ហ្គារ ចង្កឹះ លេខ ដៃ ចង្កូត កៅអី សម្រាប់ រថយន្ត និង កែច្នៃ ពី កង់ ពីរ ទៅ កង់ បី សម្រាប់ ទោចក្រយានយន្ត ត្រូវ មាន ភាព សមស្រប បង្ក លក្ខណៈ ងាយស្រួល និង ធានា សុវត្ថិភាព ។
“ សុពលភាព ប័ណ្ណ បើកបរ សម្រាប់ ជន មាន ពិការភាព ជា ប្រជាពលរដ្ឋ ខ្មែរ ឬ បរទេស ដែល បាន ប្រឡង ជាប់ មាន សុពលភាព រយៈពេល ១០ឆ្នាំ ដូច ប្រជាពលរដ្ឋ ទូទៅ ។ សុពលភាព ប័ណ្ណ បើកបរ សម្រាប់ ជន មាន ពិការ ភាព ជា ជន បរទេស ហើយ ដែល ត្រូវ ប្ដូរ មក ប័ណ្ណ បើកបរ កម្ពុជា មាន សុពលភាព រយៈពេល ១ឆ្នាំ ម្ដង ” ។ នេះ ជា ការបញ្ជាក់ បន្ថែម របស់ លោក ឯ ម ច័ន្ទ មករា
អភិបាល ខណ្ឌ កំបូល បរិច្ចាគ ថវិកា ២៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ឃឹម ស៊ុន សូដា អភិបាល ខណ្ឌ កំបូល និង ភរិយា ព្រមទាំង ក្រុមគ្រួសារ បាន បរិច្ចាគ ថវិកា ២៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
បញ្ជី ឈ្មោះ ទីប្រឹក្សា ក្រសួង យុត្តិធម៌ បរិច្ចាគ ថវិកា សរុប ៦. ១០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ បញ្ជី ឈ្មោះ ទីប្រឹក្សា ក្រសួង យុត្តិធម៌ ដែល បាន បរិច្ចាគ ថវិកា សរុប ៦.១០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ឯកឧត្តម មាន សុភា និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម មាន សុភា និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម អេង ជា សាន និង លោកជំទាវ បរិច្ចាគ ថវិកា ២៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម អេង ជា សាន ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា ប្រធាន រដ្ឋបាល ជន ផល និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ២៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ មហា ឧបាសិកា ប៊ុន សាម លេន និង ស្វាមី បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ មហា ឧបាសិកា ប៊ុន សាម លេន និង ស្វាមី នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ៥.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
ឯកឧត្តម មួន សារ៉ន និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម មួន សារ៉ន និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ៥.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោកជំទាវ គូ គីម ឡុង បរិច្ចាគ ថវិកា ២៥.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ គូ គីម ឡុង បាន បរិច្ចាគ ថវិកា ២៥.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម អ៊ូច ភា និង លោកជំទាវ ស្រី ប៊ុណ្ណា ដាវី បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម អ៊ូច ភា អភិបាល ខេត្ត តាកែវ និង លោកជំទាវ ស្រី ប៊ុណ្ណា ដាវី បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ឧកញ៉ា ឡាយ ប៊ុន ប៉ា និង លោកជំទាវ ឡាយ ឈុន នី បរិច្ចាគ ថវិកា ៥ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា ឡាយ ប៊ុន ប៉ា និង លោកជំទាវ ឡាយ ឈុន នី បាន បរិច្ចាគ ថវិកា ៥ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ការប្រកាស នេះ បាន បង្ហាញ ឡើង នៅ កិច្ចប្រជុំ កំពូល នៃ យុទ្ធសាស្រ្ត កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច អាយ៉េ យ៉ាវ៉ាឌី - ចៅ ប្រាយ៉ា - មេគង្គ (ACMECS) លើក ទី៩ តាម ប្រព័ន្ធ វីដេអូ ដែល បាន ធ្វើឡើង នៅ ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០២០ ។ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា គឺជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ កំពូល មួយ នេះ ។
លោក កៅ គឹម ហួន បាន បញ្ជាក់ យ៉ាង ដូច្នេះ ថា៖ « ក្របខណ្ឌ យោង មូលនិធិ សម្រាប់ អភិវឌ្ឍន៍ ACMECS ។ នៅក្នុង ក្របខណ្ឌ នេះ គឺ ថៃ បាន ប្រកាស សន្យា ដាក់ វិភាគទាន ២០០ លាន ដុល្លារ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ក៏ បាន ប្រកាស ដែរ ថា កម្ពុជា នឹង ដាក់ ៧លាន ដុល្លារ ក្នុង មូលនិធិ នេះ សម្រាប់ អនុវត្ត គម្រោង អភិវឌ្ឍន៍ ប្រទេស ទាំង៥ នេះ ។
ក្រោម មូល បទ « ភាពជាដៃគូ ដើម្បី ការតភ្ជាប់ និង ភាពរឹងមាំ » កិច្ចប្រជុំ កំពូល ACMECS លើក ទី៩ បាន ពិនិត្យ ឡើងវិញ នូវ កិច្ចសហប្រតិបត្តិការ កន្លងមក និង នា ពេល អនាគត ជាពិសេស លើ វិធី និង មធ្យោបាយ ដើម្បី ពង្រឹង បន្ថែម ទៀត នូវ កិច្ចសហប្រតិបត្តិការ ACMECS លើ គ្រប់ វិស័យ ដែល នឹង ដើរ តួនាទី ជា ក្របខណ្ឌ សាមគ្គីភាព ដ៏ សំខាន់ សម្រាប់ ថែរក្សា សន្តិភាព និង ស្ថិរភាព ក្នុង តំបន់ និង ជំរុញ ការអភិវឌ្ឍ រួមគ្នា ក្រោយ វិបត្តិ ជំងឺ រាតត្បាត សកល កូវីដ - ១៩ ។
បញ្ជី ឈ្មោះ ថ្នាក់ដឹកនាំ ក្រសួង យុត្តិធម៌ ដែល បរិច្ចាគ ថវិកា សរុប ៣១. ២លាន រៀល និង ៩. ២០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ បញ្ជី ឈ្មោះ របស់ ថ្នាក់ដឹកនាំ ក្រសួង យុត្តិធម៌ ដែល បាន បរិច្ចាគ ថវិកា សរុប ៣១. ២លាន រៀល និង ៩. ២០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ អភិបាល រង ខេត្ត សៀមរាប លោក ង៉ាន់ ភិរុណ បរិច្ចាគ ថវិកា ១.៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ង៉ាន់ ភិរុណ អភិបាល រង ខេត្ត សៀមរាប និង ក្រុមគ្រួសារ នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ចំនួន ១.៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឧកញ៉ា លី ឃុន ថៃ និង លោកជំទាវ បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ លោក ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង និង លោកជំទាវ នៅ ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង ប្រឆាំង មេរោគ កូវីដ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម កើត ពុទ្ធ វរី និង លោកជំទាវ បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម កើត ពុទ្ធ វរី អនុ រដ្ឋលេខាធិការ ក្រសួង ទេសចរណ៍ និង លោកជំទាវ ឆន ណាណែត ព្រមទាំង បុត្រ បាន ស្ម័គ្រចិត្ត បរិច្ចាគ ថវិកា ចំនួន ១.០០០ ដុល្លារ អាមេរិក ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឧត្តមសេនីយ៍ ឯក ស ថេត អគ្គ ស្នងការ រង និង ជា ស្នងការ នគរបាល រាជធានី ភ្នំពេញ បាន បរិច្ចាគ ថវិកា ៥០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ភ្ញៀវ រួមទាំង សមាជិក នាវិក ទាំងអស់ ដែល មាន ទំនាក់ទំនង ជិតស្និទ្ធ ជាមួយ ករណី ខាងលើ ត្រូវបាន កំណត់ អត្តសញ្ញាណ និង តម្រូវឲ្យ ធ្វើចត្តាឡី ស័ក ហើយ ក្រោយមក ត្រូវបាន ធ្វើតេស្ត ឃើញ ថា អវិជ្ជមាន ។ ក្រុមហ៊ុន Royal Caribbean បាន បន្ថែម ទៀត ថា កប៉ាល់ ខាងលើ បាន វិលត្រឡប់ មកកាន់ កំពង់ផែ សិង្ហបុរី វិញ ស្រប តាម គោលការណ៍ របស់ រដ្ឋាភិបាល ហើយ ភ្ញៀវ នឹង អនុញ្ញាតឲ្យ ចាកចេញ ពី កប៉ាល់ បន្ទាប់ពី ការពិនិត្យ ត្រូវបាន បញ្ចប់ ។
ក្រុមហ៊ុន នេះ ក៏ កំពុង សហការ ជាមួយ រដ្ឋាភិបាល សិង្ហបុរី ដើម្បី ការពារ សុខភាព និង សុវត្ថិភាព ភ្ញៀវ ព្រមទាំង ក្រុម នាវិក ទាំងអស់ ផងដែរ ។ បន្ថែម ពីលើ នេះ ការធ្វើតេស្ត និង ត្រួតពិនិត្យ ត្រូវបាន អនុវត្ត ស្រប តាម គោលការណ៍ សុខភាព សាធារណៈ ដែល រដ្ឋាភិបាល បាន ដាក់ចេញ ។
សម្តេច តេជោ ហ៊ុន សែន បញ្ជាក់ បែប នេះ នៅ ព្រឹក ថ្ងៃពុធ ទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ ក្នុង ឱកាស សម្តេច ធ្វើជា ប្រធាន ដឹកនាំ កិច្ចប្រជុំ កំពូល នៃ យុទ្ធសាស្រ្ត កិច្ចសហប្រតិបត្តិការ សេដ្ឋកិច្ច អាយ៉េ យ៉ាវ៉ាឌី - ចៅ ប្រាយ៉ា - មេគង្គ (ACMECS) លើក ទី៩ តាម ប្រព័ន្ធ វីដេអូ ។
លោក កៅ គឹម ហួន បាន ថ្លែង ថា អ្វី ដែល គួរឲ្យ ចាប់ អាម្មណ៍ នៅក្នុង កិច្ចប្រជុំ នេះ គឺ វ៉ាក់សាំង ប្រឆាំង នឹង មេរោគ កូវីដ១៩ ។ លោក បន្ត ថា ក្នុង កិច្ចប្រជុំ នេះ សម្តេច តេជោ ហ៊ុន សែន បាន ប្រកាស ស្នើសុំ ឲ្យ ប្រទេស ទាំងអស់ ចែករំលែក នូវ បទពិសោធន៍ ពាក់ព័ន្ធ នឹង ការប្រើប្រាស់ វ៉ាក់សាំង នេះ ដោយសារ វៀតណាម ប្រកាស ថា ខ្លួន បញ្ជាទិញ ថៃ ក៏ កំពុង បញ្ជា ហើយ កម្ពុជា ក៏ កំពុង ត្រៀម បញ្ជាទិញ ដូចគ្នា ដែរ ។
គួរ រំលឹក ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ។ ការប្រកាស នេះ បាន ជំរុញ ឱ្យ មាន ការចូលរួម យ៉ាង សស្រាក់សស្រាំង ពី សាធារណជន ដោយ បាន ចូលរួម បរិច្ចាគ ជាមួយ រដ្ឋាភិបាល ជា បន្តបន្ទាប់ ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
ទីភ្នាក់ងារ គ្រប់គ្រង និង បង្ការ ជំងឺ កូរ៉េ ខាងត្បូង (KDCA) បាន ឲ្យដឹង ថា ចំនួន ករណី ឆ្លង COVID-19 ប្រចាំ ថ្ងៃ បាន កើន លើស ៦០០ ករណី ក្នុង មួយ ថ្ងៃ កាលពី សប្ដាហ៍ មុន ដែល បាន បង្ខំ ឲ្យ ប្រទេស កូរ៉េ ខាងត្បូង ទាំងមូល បាន ដាក់ចេញ នូវ វិធានការរក្សា គម្លាត សុវត្ថិភាព យ៉ាង តឹងរឹង បំផុត ។ វិធានការ នេះ បាន ចូល ជាធរមាន កាលពី ថ្ងៃអង្គារ ម្សិលមិញ រួម មាន ទាំង បម្រាម គោចរ ដែល មិន ធ្លាប់ មាន ពីមុន មក ទៅ លើ ភោជនីយដ្ឋាន និង អាជីវកម្ម ដទៃ ទៀត ផងដែរ ។
រដ្ឋាភិបាល កូរ៉េ ខាងត្បូង បាន ចុះហត្ថលេខា លើ កិច្ចព្រមព្រៀង ជាមួយ ក្រុមហ៊ុន ផលិត ឱសថ ពិភពលោក ចំនួន ៤ ដើម្បី ទិញ វ៉ាក់សាំង COVID-19 សម្រាប់ ប្រជាជន ចំនួន ៤៤លាន នាក់ របស់ ខ្លួន ។
គ្លីនិក ខេម រ៉ា ព្យាបាល កុមារ លោក សាស្រ្តាចារ្យ វេជ្ជបណ្ឌិត យីត ស៊ុន ណារ៉ា បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ គ្លីនិក ខេម រ៉ា ព្យាបាល កុមារ លោក សាស្រ្តា ចារ វេជ្ជបណ្ឌិត យីត ស៊ុន ណារ៉ា បាន បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន និង លោកជំទាវ ហ៊ុន គឹម ឡេង បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម នាយ ឧត្តមសេនីយ៍ សន្ដិ បណ្ឌិត នេត សាវឿន អគ្គ ស្នងការ នគរបាល ជាតិ និង លោកជំទាវ ហ៊ុន គឹម ឡេង បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ក្រុមប្រឹក្សាភិបាល សមាគម សន្តិសុខ សង្គម អាស៊ាន កំពុង ពិភាក្សា គ្នា លើ ការពង្រីក វិសាលភាព របប សន្តិសុខ សង្គម
ប្រការ នេះ តម្រូវ ឱ្យ សមាជិក អាស៊ាន ទាំងអស់ គ្នា បង្កើន ការខិតខំ ទ្វេ ដង បន្ថែម ថែម ទៀត នៅក្នុង សម័យកាល នៃ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ដែល នៅតែ បន្ត ឆ្លង ក្នុង តំបន់ និង ជា សកល ដែល ត្រូវ ខិតខំ រួបរួម គ្នា ជំរុញ កំណើន សេដ្ឋកិច្ច និង ការចែករំលែក ផ្លៃ ផ្កា នៃ កំណើន នេះ ឱ្យ បាន កាន់តែ ប្រសើរឡើង ក្នុង បណ្តា ប្រទេស ជា សមាជិក អាស៊ាន ទាំងអស់ ជាពិសេស លើ ផ្នែក របប សន្តិសុខ សង្គម ។
លោក អ៊ុក សម វិទ្យា បាន វាយតម្លៃ ខ្ពស់ ចំពោះ អង្គភាព សន្តិសុខ សង្គម ជា សមាជិក នៃ សមាគម សន្តិសុខ សង្គម អាស៊ាន ទាំងអស់ និង អង្គការ ជាតិ - អន្តរជាតិ ដែល បាន គាំទ្រ និង ផ្តល់ នូវ កិច្ចសហការ កន្លងមក លើ វិស័យ សន្តិសុខ សង្គម ក៏ ដូចជា ទៅ អនាគត ក្នុង ការចូលរួមចំណែក ចែករំលែក ចំណេះដឹង និង បទពិសោធន៍ គ្នា ទៅ វិញ ទៅមក សម្រាប់ ការអភិវឌ្ឍ ប្រទេស ក្រោម បាវចនា « ចក្ខុវិស័យ តែ មួយ អត្តសញ្ញាណ តែ មួយ សហគមន៍ តែ មួយ » ។
លោក បាន បន្ត ថា ចាប់តាំងពី បេឡា ជាតិ សន្តិសុខ សង្គម ចូល ជា សមាជិក នៃ សមាគម សន្តិសុខ សង្គម អាស៊ាន កាលពី ថ្ងៃទី ២៤ ខែមីនា ឆ្នាំ ២០១១ រហូតមកដល់ ពេល បច្ចុប្បន្ន នេះ ប .ស.ស . ទទួលបាន នូវ បទពិសោធន៍ និង ចំណេះដឹង ជាច្រើន ខាង វិស័យ សន្តិសុខ សង្គម ព្រមទាំង មាន ការកោតសរសើរ ពី ស្ថាប័ន ជាតិ និង អន្តរជាតិ ក្នុង ការលើកកម្ពស់ ឧត្តមភាព នៃ ការគ្រប់គ្រង ចាត់ចែង ប្រព័ន្ធ សន្តិសុខ សង្គម និង ការអភិវឌ្ឍ ប្រព័ន្ធ សន្តិសុខ សង្គម ប្រកបដោយ ថា មវន្ត ។
តាមរយៈ នៃ កិច្ចប្រជុំ នេះ លោក អ៊ុក សម វិទ្យា បាន សំណូមពរ ដល់ សមាជិក ទាំងមូល ចូលរួម ចែករំលែក ផ្តល់ នូវ បទពិសោធន៍ ផ្នែក សន្តិសុខ សង្គម ពី គ្នា ទៅ វិញ ទៅ មក ក្នុង នាម ជា សមាជិក អង្គភាព សន្តិសុខ សង្គម នៃ បណ្តា ប្រទេស នីមួយ ៗ ក្នុង ការអនុវត្ត ទទួលបាន ជោគជ័យ កន្លងមក ដើម្បី ជា ធាតុ ចូល សម្រាប់ ការអភិវឌ្ឍ បន្ថែម នូវ វិស័យ សន្តិសុខ សង្គម របស់ ខ្លួន ឱ្យ កាន់តែ មាន ការអភិវឌ្ឍ បន្ថែម ទៀត សម្រាប់ ប្រទេស ដែល មាន ការអភិវឌ្ឍ តិច ឱ្យ មាន ការអភិវឌ្ឍ កាន់តែ ច្រើន ។
លោក Haji បាន ថ្លែង បន្ត ទៀត ថា បើ ទោះបីជា យ៉ាងណា ក៏ដោយ ក៏ លោក សង្ឃឹម ថា កិច្ចប្រជុំ នា ថ្ងៃ នេះ នឹង ជំរុញ ការទំនាក់ទំនង រវាង ប្រទេស ជា សមាជិក នៃ សមាគម សន្តិសុខ សង្គម អាស៊ាន ឱ្យ កាន់តែ មាន ភាពជិតស្និទ្ធ និង ពង្រឹង ចំណង រួមគ្នា ក្នុង ការដោះស្រាយ រាល់ បញ្ហា ប្រឈម នានា នៃ កិច្ច ដំណើរការ លើ វិស័យ សន្តិសុខ សង្គម តាម បណ្តា ប្រទេស របស់ ខ្លួន ៕ ឧកញ៉ា ឈន ថា រី និង លោកជំទាវ ហុង សុខ ហ៊ាង បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា ឈន ថា រី និង លោកជំទាវ ហុង សុខ ហ៊ាង បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
ការប្រកាស របស់ ឧកញ៉ា ឈន ថា រី និង លោកជំទាវ ហុង សុខ ហ៊ាង បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ពី ការត្រៀម ថវិកា ទិញ វ៉ាក់សាំង កូវីដ១៩ មក ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
( ភ្នំពេញ ) ៖ សម្តេច ព្រះវន រ័ត កិតិ បណ្ឌិត ណយ ច្រឹក ព្រះសង្ឃ នាយក រង ទី២ នៃ ព្រះរាជាណាចក្រ កម្ពុជា និង ជា ព្រះអនុប្រធាន ទី១ ថេរសភា ព្រះពុទ្ធ សាសនា ជា ព្រះអគ្គាធិការ រង ពុទ្ធិក សិក្សា ជាតិ ជា ព្រះអនុគណខណ្ឌ ព្រែក ព្នៅ និង ជា ព្រះគ្រូ ចៅអធិការ វត្ត ច័ន្ទ បុរី វង្ស បាន បរិច្ចាគ ថវិកា ៤.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ឧកញ៉ា ឡេង ប៊ុន គ្រី បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា ឡេង ប៊ុន គ្រី បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ លោក ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត ស្នងការ ខេត្ត កណ្ដាល និង លោកស្រី រ៉េត ផល្លី ដា បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( កណ្ដាល ) ៖ លោក ឧត្តមសេនីយ៍ ទោ ឈឿន សុចិត្ត ស្នងការ ខេត្ត កណ្ដាល និង លោកស្រី រ៉េត ផល្លី ដា បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោក ថេង សុថុល ណែនាំឲ្យ ប្រជាពលរដ្ឋ ប្រុងប្រយ័ត្ន ខ្ពស់ ជានិច្ច ចំពោះ កូវីដ - ១៩ ខណៈ ជំងឺ នេះ កំពុង រាតត្បាត យ៉ាង សកម្ម នៅក្នុង សហគមន៍
លោក ប្រធាន អនុសាខា កាកបាទ ក្រហម ខណ្ឌ ចំការមន បាន លើកឡើង ដូច្នេះ នៅក្នុង ពេល អញ្ជើញ នាំយក អំណោយ មនុស្សធម៌ របស់ កាកបាទ ក្រហម កម្ពុជា តាមរយៈ សាលា រាជធានី ភ្នំពេញ ទៅ ចែកជូន បងប្អូន ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ខ្វះខាត នៅក្នុង សង្កាត់ ទួល ទំពូង១ នា ព្រឹក ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ ក្នុង បរិវេណ សាលារៀន វត្ត ទួល ទំពូង ។
បើ ទោះជា មាន ការបញ្ជាទិញ វ៉ាក់សាំង ពីសំណាក់ រាជ រដ្ឋាភិបាល យ៉ាង នេះ ក្តី លោក ថេង សុថុល បាន ណែនាំឲ្យ ប្រជាពលរដ្ឋ ត្រូវតែ មាន ការប្រុងប្រយ័ត្ន ខ្ពស់ ជានិច្ច ព្រោះថា ជំងឺ ដ៏ កាច សាហាវ នេះ បាន និង កំពុង រាតត្បាត យ៉ាង សកម្ម នៅក្នុង សហគមន៍ របស់ យើង ជាពិសេស ក្នុង រាជធានី ភ្នំពេញ នៅឡើយ ទាមទា ឲ្យ យើង គ្រប់ គ្នា ការពារ ខ្លួន ជាប់ ជានិច្ច តាមរយៈ អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល គឺ ពាក់ ម៉ាស លាង ដៃ និង សាប៊ូ អាល់កុល ឬ ជេល និង រក្សា គម្លាត សង្គម ផងដែរ ។
គួរ បញ្ជាក់ ផងដែរ ថា អំណោយ ដែល ចែកជូន ប្រជាពលរដ្ឋ នៅ ទីនោះ រួម មាន៖ ក្នុង ១គ្រួសារ ទទួលបាន អង្ករ ទឹកត្រី ទឹកស៊ី អ៉ីវ ត្រីខ ស្កសរ សាប៊ូ ម៉ាស អាកុល ទឹកដោះគោ មី និង ថវិកា មួយ ចំនួន ទៀត ផងដែរ ៕
ឯកឧត្តម គង់ សន្យា តំណាង គ្លីនិក សម្ភព បញ្ញា បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម គង់ សន្យា តំណាង ឱ្យ គ្លីនិក សម្ភព បញ្ញា បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោក ហុង លី និង លោកស្រី គឹម គៀង ម្ចាស់ អគារ ឡូវ គឹម សេង ខេត្ត កំពង់ធំ បរិច្ចាគ ថវិកា ១ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( កំពង់ធំ )៖ លោក ហុង លី និង លោកស្រី គឹម គៀង ម្ចាស់ អគារ ឡូវ គឹម សេង ខេត្ត កំពង់ធំ នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ១ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ឯកឧត្តម សាស្ត្រាចារ្យ ឈាង រ៉ា និង លោកជំទាវ បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម សាស្ត្រាចារ្យ ឈាង រ៉ា អគ្គ នាយក មន្ទីពេទ្យ កាល់ម៉ែត និង លោកជំទាវ គីម សុខ លាភ នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
លោកជំទាវ ឃួន វិឡា វណ្ណ ទីប្រឹក្សា អនុប្រធាន ទី២ នៃ រដ្ឋសភា បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ ឃួន វិឡា វណ្ណ ទីប្រឹក្សា អនុប្រធាន ទី២ នៃ រដ្ឋសភា បាន បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង ដឹកនាំ ដោយ លោក អ៉ិត សុធា បរិច្ចាគ ថវិកា ២. ៨៥០ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក អ៉ិត សុធា ព្រះរាជអាជ្ញា នៃ អយ្យការ អម សាលាដំបូង ខេត្ត កំពង់ឆ្នាំង និង ព្រះរាជអាជ្ញា រង ក្រឡាបញ្ជី និង មន្ដ្រី បាន បរិច្ចាគ ថវិកា សរុប ២. ៨៥០ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ក្រុង ឆាង វ៉ុន កូរ៉េ ខាងត្បូង ប្រគល់ រថយន្ត ពន្លត់ អគ្គិភ័យ៣ គ្រឿង ជូន សាលា ខេត្ត ព្រះសីហនុ
( ព្រះសីហនុ) ៖ ទីក្រុង ឆាង វ៉ុន ស្ថិត នៅ ភូមិភាគ ខាងត្បូង បង្អស់ នៃ ឧបទ្វីប កូរ៉េ និង ជា ក្រុង សម្ព័ន្ធ មេត្រីភាព ជាមួយ ខេត្ត ព្រះសីហនុ របស់ កម្ពុជា បាន ផ្ដល់ រថយន្ត ពន្លត់ អគ្គីភ័យ ចំនួន៣ គ្រឿង ក្នុង ដំណាក់កាល ដំបូង ជូន សាលា ខេត្ត ព្រះសីហនុ សម្រាប់ យក ទៅ ប្រើប្រាស់ ការពារ សុវត្ថិភាព ប្រជាជន នៅ ជុំវិញ ខេត្ត តាមរយៈ ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា នៅ កូរ៉េ ខាងត្បូង ។
ឆ្លើយតប និង សំណូមពរ បន្ថែម លោក ឡុង ឌីម៉ង់ សាលាក្រុង ឆាង វ៉ុន បាន ឯកភាព ក្នុង ការផ្ដល់ជូន នូវ វគ្គ បណ្ដុះបណ្ដាល ពិសេស រយៈពេល មធ្យម ដល់ មន្ត្រី នគរបាល ពន្លត់ អគ្គីភ័យ និង សង្គ្រោះ បន្ទាន់ របស់ ខេត្ត ព្រះសីហនុ ឲ្យបាន ទៅ រៀនសូត្រ និង អនុវត្ត ជាក់ស្ដែង នៅ កូរ៉េ ផងដែរ ។
ស្ថានទូត កម្ពុជា បាន វាយតម្លៃ ខ្ពស់ នូវ កិច្ចសហប្រតិបត្តិការ ក្នុង កម្រិត ថ្នាក់ មូលដ្ឋាន នេះ ដែល សបញ្ជាក់ បង្ហាញ ឲ្យ ឃើញ ពី ទំនាក់ទំនង រវាង ប្រជាជន និង ប្រជាជន ប្រទេស ទាំង ពីរ ហើយ ស្ថានទូត នឹង បន្ត ជំរុញ លើក កំពស់ កិច្ចសហប្រតិបត្តិការ ថ្នាក់ មូលដ្ឋាន បែប នេះ ជាមួយ ខេត្ត ក្រុង កូរ៉េ បន្ត ទៅ មុខ ទៀត ។
សូម បញ្ជាក់ ជូន ថា ក្នុង រយៈពេល ប្រមាណ ២ខែ ចុងក្រោយ នេះ សាលាក្រុង សេចុង បាន ផ្ដល់ជូន រថយន្ត សង្គ្រោះ បន្ទាន់ ២គ្រឿង ជូន សាលា ខេត្ត បាត់ដំបង . សាលាក្រុង ស៊ូវ៉ុន បាន ផ្ដល់ជូន រថយន្ត ដឹក សំរាម ១គ្រឿង និង ម៉ាស ចំនួន ៣ម៉ឺន ជូន សាលា ខេត្ត សៀមរាប តាមរយៈ ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា នៅ កូរ៉េ ផងដែរ ៕
យុទ្ធនាការ កៀរ គរ សប្បុរ ជន របស់ លោក សួន សេរី រដ្ឋា ប្រមូល បាន ថវិកា សរុប ១០លាន រៀល ដើម្បី ចូលរួម បរិច្ចាគ ជូន សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ យុទ្ធនាការ កៀរ គរ ថវិកា រយៈពេល ១ ថ្ងៃ របស់ លោក សួន សេរី រដ្ឋា អតីត ប្រធាន គណបក្ស អំណាច ខ្មែរ និង ជា រដ្ឋលេខាធិការ ក្រសួង អភិវឌ្ឍ ជនបទ បាន បិទ បញ្ចប់ នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ដោយ ទទួលបាន ទឹកប្រាក់ សរុប ៥លាន រៀល ហើយ លោក និង ភរិយា បាន សម្រេច បន្ថែម ៥លាន រៀល ទៀត ដើម្បី យក ទៅ ចូលរួម បរិច្ចាគ ជូន សម្តេច តេជោ ហ៊ុន សែន សម្រាប់ ការទិញ វ៉ាក់សាំង កូវីដ១៩ ចាក់ ជូន ប្រជាពលរដ្ឋ ឥត គិត ថ្លៃ ។
ការចូលរួម បរិច្ចាគ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស អំពី ការត្រៀម ថវិកា ទិញ វ៉ាក់សាំង កូវីដ - ១៩ មក ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ស្រប ពេល ដែល ជំងឺ កូវីដ១៩ បាន ឆ្លង ចូល ដល់ សហគមន៍ កម្ពុជា ។
រយៈពេល ១ ថ្ងៃ កាលពី ម្សិលមិញ នេះ ទោះបីជា មាន ចំនួន ទឹកប្រាក់ តិចតួច ប៉ុន្តែ លោក សួន សេរី រដ្ឋា បាន សង្កេតឃើញ ថា មាន ការចូលរួម ច្រើន គួរឱ្យ កត់សម្គាល់ ពី សប្បុរសជន ដែល បង្ហាញ ថា ប្រជាពលរដ្ឋ ខ្មែរ មាន ទឹកចិត្ត សប្បុរស ហើយ តែង ចូលរួម សាមគ្គី ជាមួយ រាជ រដ្ឋាភិបាល ជានិច្ច នៅពេល កម្ពុជា ជួប នឹង បញ្ហា អ្វី មួយ ។
ទន្ទឹមនឹង នេះ ដែរ លោក សួន សេរី រដ្ឋា ក៏ សូម អំពាវនាវ និង លើកទឹកចិត្ត ដល់ មន្ត្រីរាជការ គ្រប់ លំដាប់ថ្នាក់ ទាំងអស់ និង សប្បុរសជន មេត្តា ចូលរួមចំណែក បរិច្ចាគ ថវិកា ឱ្យ បាន ផុសផុល ដែល នេះ ជា ចលនា គាំទ្រ ដល់ រាជ រដ្ឋាភិបាល និង គោរព តាម អនុសាសន៍ ដ៏ ខ្ពង់ខ្ពស់ បំផុត របស់ សម្ដេច តេជោ ហ៊ុន សែន អំពី ខឿន ការពារ សុខភាព របស់ ប្រជាជន នៅក្នុង បេសកកម្ម មនុស្សធម៌ ដ៏ ឧត្តុង្គឧត្តម នេះ ទៅ តាម លទ្ធភាព រៀង ៗ ខ្លួន ក្នុង ការចូលរួម ថែរក្សា និង ការពារ សុខុមាលភាព របស់ ប្រជាពលរដ្ឋ ។
ឯកឧត្តម ច័ន្ទ តានី រដ្ឋលេខាធិការ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ច័ន្ទ តានី រដ្ឋលេខាធិការ ទីស្ដីការ គណៈ រដ្ឋមន្ដ្រី បាន បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
អភិបាល ខេត្ត កណ្តាល បញ្ជា ឲ្យ បិទ ផ្សារ ដើម អំពិល និង វត្ត វិហារ ត្រាញ់ នៅ ស្រុក កណ្តាល ស្ទឹង បណ្តោះអាសន្ន ព្រោះ រកឃើញ អ្នក ឆ្លង កូវីដ១៩ ពាក់ព័ន្ធ នៅ ទីតាំង ទាំងនោះ
( កណ្ដាល ) ៖ លោក គង់ សោភ័ណ្ឌ អភិបាល ខេត្ត កណ្ដាល បាន បញ្ជា ឲ្យ បិទ ផ្សារ ដើម អំពិល និង វត្ត វិហារ ត្រាញ់ ជា បណ្ដោះអាសន្ន សិន ក្រោយ រកឃើញ មនុស្ស ម្នាក់ មាន ផ្ទុក វីរុស កូវីដ - ១៩ ហើយ ពាក់ព័ន្ធ នៅ តំបន់ នោះ ព្រមទាំង មនុស្ស ៧នាក់ ពាក់ព័ន្ធ ដោយ ផ្ទាល់ និង ៣០ នាក់ ផ្សេង ទៀត ពាក់ព័ន្ធ ដោយ ប្រយោល ត្រូវបាន ណែនាំឲ្យ ធ្វើចត្តាឡី ស័ក ។
លោក អភិបាល ខេត្ត បាន បញ្ជា យ៉ាង ដូច្នេះ នា រសៀល ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២០ ក្នុង ពេល លោក ដឹកនាំ ក្រុមការងារ ចុះ ពិនិត្យ និង បញ្ជា ឱ្យ មាន ការស្រាវជ្រាវ រក អ្នក ពាក់ព័ន្ធ នឹង ក្រុមគ្រួសារ របស់ លោកស្រី អៀម ធីតា ដែល មាន លទ្ធផល វិជ្ជមាន វីរុស កូវីដ - ១៩ ជាប់ពាក់ព័ន្ធ នឹង ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា នៅ មណ្ឌល ចត្តាឡី ស័ក ស្រុក កណ្តាល ស្ទឹង ។
យោង របាយការណ៍ របស់ ក្រុម គ្រូពេទ្យ អ្នក ពាក់ព័ន្ធ ៣៧ នាក់ ទៀត ទៅ ធ្វើតេស្ត រក មេរោគ កូវីដ - ១៩ នៅ មន្ទីរពេទ្យ បង្អែក ជ័យ ជំនះ ក្រុង តាខ្មៅ និង បាន ធ្វើចត្តាឡី ស័ក នៅ តាម មណ្ឌល ចត្តាឡី ស័ក ដែល រដ្ឋបាល ខេត្ត បាន រៀបចំ បាន យ៉ាង ត្រឹមត្រូវ តាម វិធាន របស់ ក្រសួង សុខាភិបាល រួចហើយ ។
ចំពោះ ទីកន្លែង ដែល ជាប់ពាក់ព័ន្ធ ក្រុម គ្រូពេទ្យ បាន បាញ់ ថ្នាំ សម្លាប់ មេរោគ ។ ក្រុមការងារ បាន ធ្វើ ការអប់រំ ណែនាំ ដល់ ប្រជាពលរដ្ឋ ចូលរួម សហការ ជាមួយ អាជ្ញាធរ និង ក្រុម គ្រូពេទ្យ ដោយ ផ្តាំ ថា បើ បាន ដឹងខ្លួន ថា មាន ជាប់ពាក់ព័ន្ធ សូម ទៅ ធ្វើតេស្ត និង មិន ត្រូវ មាន ការភ័យខ្លាច ជ្រុល ឬ ជ្រួលច្របល់ ឡើយ ។
ចំពោះ ការបញ្ជា ឱ្យ អាជ្ញាធរ ផ្អាក ដំណើរការផ្សារ ដើម អំពិល និង វត្ត វិហារ ត្រាញ់ ជា បណ្តោះអាសន្ន លោក អភិបាល ខេត្ត បាន សុំ ការអធ្យាស្រ័យ ចំពោះ ប្រជាពលរដ្ឋ និង អាជីវករ ទាំងអស់ ផងដែរ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា បាន បញ្ជា ឲ្យ ក្រសួង និង អាជ្ញាធរដែនដី តាមដាន ឱ្យ បាន ម៉ឺងម៉ាត់ ទៅ លើ ទីតាំង អាជីវកម្ម ទាំងឡាយ ចំពោះ ការអនុវត្តន៍ នូវ វិធានការណែនាំ របស់ ក្រសួង សុខាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ពាក់ព័ន្ធ នឹង « ព្រឹត្តិការណ៍ សហគមន៍ ២៨ វិច្ឆិកា »៕ ឯកឧត្តម ងី តា យី បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ងី តា យី រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បរិច្ចាគ ថវិកា ៣០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
( ភ្នំពេញ ) ៖ ឯកឧត្តម គឹម ប៉ុណ្ណា អនុ រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន និង លោកជំទាវ បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
នាយ ឧត្តម នាវី ទៀ វិញ បរិច្ចាគ ថវិកា៣.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ នាយ ឧត្តម នាវី ទៀ វិញ អគ្គ មេបញ្ជាការ រង នៃ កងយោធពល ខេមរភូមិន្ទ និង ជា មេបញ្ជាការ កងទ័ព ជើងទឹក និង លោកជំទាវ ព្រមទាំង គ្រួសារ បាន បរិច្ចាគ ថវិកា៣.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
( ភ្នំពេញ )៖ គណៈកម្មាធិការ សិទ្ធិ មនុស្ស កម្ពុជា នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ផលិត វីដេមួយ ស្តីពី « សិទ្ធិ និង សន្តិភាព » ក្រោយ កម្ពុជា បិទ បញ្ចប់ សង្គ្រាម ស៊ីវិល ក្រោម នយោបាយ ឈ្នះ ឈ្នះ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ។
ក្រៅពី សិទ្ធិ ជាមូលដ្ឋាន មនុស្ស មាន សិទ្ធិ សង្គម និង សេដ្ឋកិច្ច រួម មាន សិទ្ធិ ទទួលបាន ការងារ ការអប់រំ និង ការចូលរួម ក្នុង ជីវិត វប្បធម៌ សហគមន៍ ។ល ៕
សូម ទស្សនា វីដេអូ ទាំងស្រុង ដូច ខាងក្រោម៖ សម្តេច ព្រះមហា អរិយវង្ស បណ្ឌិត ឃី សុវណ្ណ រតនា បរិច្ចាគ បច្ច័យ ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ សម្តេច ព្រះមហា អរិយវង្ស បណ្ឌិត ឃី សុវណ្ណ រតនា អគ្គ លេខាធិការ រង ថេរ សភា ពុទ្ធសាសនា . សាកលវិទ្យាធិការ រង ទទួលបន្ទុក ដឹកនាំ គ្រប់គ្រង ពុទ្ធិក សាកលវិទ្យាល័យ ព្រះសីហនុ រាជ និង ជា ព្រះចៅ អធិការ វត្ត មង្គល វ័ន ហៅ ស្វាយ ដង្គុំ រាជធានី ភ្នំពេញ បាន បរិច្ចាគ បច្ច័យ ចំនួន ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ សម្ដេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស បរិច្ចាគ បច្ច័យ ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ សម្ដេច ព្រះអគ្គមហាសង្ឃរាជាធិបតី កិត្តិ ឧទ្ទេស បណ្ឌិត ទេព វង្ស សម្ដេច ព្រះមហាសង្ឃរាជ នៃ ព្រះរាជាណាចក្រ កម្ពុជា បាន ប្រោសប្រទាន នូវ បច្ច័យ ចំនួន ១០.០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ ប្រគល់ រថយន្ត១ គ្រឿង និង សម្ភារ ការពារ ជំងឺ កូវីដ - ១៩ ដល់ អធិការ នគរបាល ក្រុង និង រដ្ឋបាល បាល ខេត្ត ទុក បម្រើ ការងារ និង ឆ្លើយតប តាម ការចាំបាច់
( ពោធិ៍សាត់ )៖ រថយន្ត ISUZU ប្រភេទ Pick-up មួយ គ្រឿង និង សម្ភារ បរិក្ខា រួម មាន អាល់កុល ជែល ២ ពាន់ ដប និង ម៉ាស ៥ម៉ឺន ម៉ាស់ ) ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សភា ពាណិជ្ជកម្ម ខេត្ត ពោធិ៍សាត់ ត្រូវបាន ប្រគល់ ជូន អធិការដ្ឋាន នគរបាល ក្រុង ពោធិ៍សាត់ និង រដ្ឋបាល ខេត្ត ពោធិ៍សាត់ ដើម្បី យក ទៅ ប្រើប្រាស់ ជា ប្រយោជន៍ ក្នុង ការងារ ប្រចាំ ថ្ងៃ និង ដើម្បី ឆ្លើយតប ទៅនឹង តម្រូវ ការចាំបាច់ របស់ រដ្ឋបាល ខេត្ត ក្នុង ការងារ ប្រយុទ្ធ ប្រឆាំង នឹង ជំងឺ កូវីដ - ១៩ ។
ពិធី ប្រគល់ - ទទួល អំណោយ និង សម្ភារ បរិក្ខា ខាងលើ ត្រូវបាន ធ្វើឡើង នៅ បរិវេណ សាលា ខេត្ត ដោយ បាន ការអញ្ជើញ ចូលរួម ពី លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ និង ជា ប្រធាន គណៈកម្មាធិការ ខេត្ត ប្រយុទ្ធ ប្រឆាំង ជំងឺ កូវីដ - ១៩. លោក ឧកញ៉ា ទុយ គី ប្រធាន សភា ពាណិជ្ជកម្ម ខេត្ត . លោក លោកស្រី សមាជិក ក្រុមប្រឹក្សា ខេត្ត . លោកស្រី អភិបាល រង ខេត្ត . លោក ស្នងការ រង ខេត្ត . លោក ប្រធាន ការិយាល័យ ប្រជាពលរដ្ឋ និង សមាជិក សមាជិកា សភា ពាណិជ្ជកម្ម ខេត្ត ជាច្រើន ផ្សេង ទៀត ។
ឆ្លៀត ក្នុង ឱកាស នោះ លោក ម៉ៅ ធ និន បាន ផ្តាំផ្ញើ ដល់ កងកម្លាំង នគរបាល នៃ អធិការដ្ឋាន នគរបាល ក្រុង ពោធិ៍សាត់ ទាំងអស់ ត្រូវ ចេះ បង្ការ ទប់ស្កាត់ និង ធ្វើ អនាម័យ ជាប់ ជាប្រចាំ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ពី វិធានការ ការពារ ជំងឺ កូវីដ - ១៩ កុំ ឱ្យ ឆ្លង ដល់ ជួរ កងកម្លាំង ជាពិសេស ត្រូវ ប្រុងប្រយ័ត្ន ខ្ពស់ ដោយ ឧស្សាហ៍ លាង ដៃ នឹង សាប៊ូ ឬ អាល់កុល ឱ្យ បាន ញឹកញាប់ ៕ លោកជំទាវ ខៀវ ហុង ចក់ ឡេង បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ ខៀវ ហុង ចក់ ឡេង បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ លោកជំទាវ ឡេង លីណា និង លោក សុខ វាសនា បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ ឡេង លីណា និង លោក សុខ វាសនា បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ ឯកឧត្តម ឈួរ ច័ន្ទ ឌឿន អភិបាល ខេត្ត កំពង់ឆ្នាំង បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ឈួរ ច័ន្ទ ឌឿន អភិបាល ខេត្ត កំពង់ឆ្នាំង និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ទេសរដ្ឋមន្រ្តី លី ធុជ ថ្លែង សន្ទរកថា គន្លឹះ បើក សិក្ខាសាលា ស្តីពី « ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល របស់ សហគ្រាស ធន តូច បំផុត តូច និង មធ្យម នៅ កម្ពុជា និង ឡាវ »
( ភ្នំពេញ ) ៖ លោក ទេសរដ្ឋមន្រ្តី លី ធុជ ប្រធាន គណៈកម្មាធិការ ជាតិ អេស្កាប់ ( គ.ជ. អ. ស) នៃ រាជ រដ្ឋាភិបាល កម្ពុជា បាន អញ្ជើញ ថ្លែង សន្ទរកថា គន្លឹះ បើក សិក្ខាសាលា ស្តីពី « ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល របស់ សហគ្រាស ធន តូច បំផុត តូច និង មធ្យម នៅ កម្ពុជា និង ឡាវ » ដែល សហការ រៀបចំ ដោយ គណៈកម្មាធិការ ជាតិ អេស្កាប់ និង គណៈកម្មការ សេដ្ឋកិច្ច និង សង្គមកិច្ច សម្រាប់ អាស៊ី និង ប៉ាស៊ីហិ្វក របស់ អង្គការ សហ ប្រជាជាតិ (UNESCAP) ដែល ប្រព្រឹត្តទៅ នៅ ថ្ងៃទី ០៩ ខែធ្នូ ឆ្នាំ ២០២០ តាមរយៈ ប្រព័ន្ធ វីដេអូ ។
សិក្ខាសាលា នេះ ក្នុង គោលបំណង បង្កើន ការយល់ដឹង ទៅ លើ ស្ថានភាព បច្ចុប្បន្ន បញ្ហា ប្រឈម និង កាលានុវត្តភាព នៃ ការប្រើប្រាស់ ប្រព័ន្ធ ឌីជីថល របស់ សហគ្រាស ធន តូច បំផុត តូច និង មធ្យម នៅ កម្ពុជា និង ឡាវ ដែល រួមបញ្ចូល ទាំង កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ របស់ រាជ រដ្ឋាភិបាល និង ការផ្ទេរ ប្រាក់ ពី ក្រៅ ប្រទេស ព្រមទាំង ផ្តល់ ជា វេទិកា សម្រាប់ ការពិភាក្សា និង ផ្លាស់ប្តូរ ចំណេះដឹង និង បទពិសោធន៍ រវាង វិស័យ ឯកជន - រដ្ឋ និង ភ្នាក់ងារ នានា របស់ អង្គការ សហ ប្រជាជាតិ ជាពិសេស អ្នកតាក់តែង គោល នយោបាយ ក្នុង តំបន់ ។
សិក្ខាសាលា នេះ មាន សមាសភាព អ្នកចូលរួម ពី មន្ត្រីរាជការ តំណាង សហគ្រាស ធន តូច បំផុត តូច និង មធ្យម នៅ កម្ពុជា អ្នក ផ្តល់ សេវាកម្ម ឌីជីថល អ្នក ផ្តល់ សេវាកម្ម ហិរញ្ញវត្ថុ អង្គការ អភិវឌ្ឍន៍ អង្គការ មិន មែន រដ្ឋាភិបាល ព្រមទាំង អ្នកជំនាញ ក្នុង វិស័យ សេដ្ឋកិច្ច ឌីជីថល និង អភិវឌ្ឍន៍ សហគ្រាស ធន តូច បំផុត តូច និង មធ្យម ។
ទាក់ទង នឹង ប្រធានបទ សិក្ខាសាលា នេះ ទេសរដ្ឋមន្ត្រី លី ធុជ បាន ថ្លែង ថា បទពិសោធន៍ ទូទាំង ពិភពលោក បាន បង្ហាញ ថា វិបត្តិ កូវីដ១៩ បាន ផ្លាស់ប្តូរ របៀបរបប របស់ យើង ក្នុង ការទំនាក់ទំនង ការបំពេញ កិច្ចការងារ និង ការរស់នៅ ប្រចាំ ថ្ងៃ ហើយ នៅក្នុង វិស័យ ឧស្សាហកម្ម សហគ្រាស នានា ក៏ កំពុង ប្រឈម នឹង បញ្ហា នៃ ការផ្គត់ផ្គង់ និង តម្រូវការ និង អនាគត ពិភពលោក ដែល មិន មាន ភាពច្បាស់លាស់ ផងដែរ ក៏ប៉ុន្តេ យើង ក៏ សង្កេតឃើញ ផងដែរ ថា បច្ចេកវិទ្យា ឌីជីថល បាន ដើរតួរ យ៉ាង សំខាន់ ក្នុង ការដោះស្រាយ បញ្ហា ទាំងនេះ ។
ទេសរដ្ឋមន្ត្រី បាន លើកឡើង ថា « វិបត្តិ » អាច ជា គ្រោះថ្នាក់ ប៉ុន្តែ វា ក៏ អាច ជា « ឱកាស » ផងដែរ ដូច្នេះ យើង ចាំបាច់ ត្រូវតែ មាន សុទិដ្ឋិនិយម ហើយ ចាត់ទុក ថា វិបត្តិ កូវីដ១៩ នេះ ជា ឱកាស ក្នុង ការវិវឌ្ឍ របៀបរបប នៃ ការបំពេញ កិច្ចការងារ និង ការប្រកប អាជីវកម្ម នានា ។
លោក ទេសរដ្ឋមន្ត្រី ក៏ បាន លើកឡើង អំពី ការផ្លាស់ប្តូរ ជា វិជ្ជមាន មួយចំនួន តាមរយៈ ការធ្វើ ឌីជីថល នីយកម្ម ក្នុង អំឡុង ពេល នៃ វិបត្តិ កូវីដ១៩ ដែល មាន ដូច ជា៖
នា ឱកាស នោះ លោក ទេសរដ្ឋមន្រ្តី ក៏ បាន លើកឡើង អំពី កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្នុង ការទប់ស្កាត់ ការរីករាលដាល និង ការបន្ធូរបន្ថយ ផល ប៉ះពាល់ នៃ ជំងឺ កូវីដ១៩ ព្រមទាំង ការប្រើប្រាស់ ដំណោះស្រាយ ឌីជីថល នៅក្នុង « កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង អំឡុង ពេល ជំងឺ កូវីដ១៩ » ។
នៅក្នុង នោះ ផងដែរ រាជ រដ្ឋាភិបាល បាន សម្រេច បង្កើត « កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង អំឡុង ពេល ជំងឺ កូវីដ១៩ » ដែល ជា កម្មវិធី ជំនួយ សង្គម ពិសេស សំដៅ ជួយ ដល់ ជន ក្រីក្រ ដែល មាន ប័ណ្ណ សមធម៌ ( ក្រ- ១ និង ក្រ- ២) ក្នុង គោលបំណង ជួយ សម្រួល ដល់ ជីវភាព របស់ ប្រជាពលរដ្ឋ ដែល មាន ជីវភាព ក្រីក្រ និង ទទួលរង ផល ប៉ះពាល់ ដោយសារ ជំងឺ កូវីដ - ១៩ ដោយ រួមបញ្ចូល ផងដែរ នូវ អ្នក បាត់បង់ ការងារ ឬ អ្នក បាត់បង់ ចំណូល ដែល ត្រូវ ធ្លាក់ខ្លួន ចុះ ទៅក្នុង ភាពទី ទាល់ ក្រីក្រ ឡើងវិញ ។
ការដាក់ចេញ នូវ កម្មវិធី នេះ ស បញ្ជាក់ ឲ្យ ឃើញ យ៉ាង ច្បាស់ ថា រាជ រដ្ឋាភិបាល បើ « ហ៊ាន និយាយ គឺ ហ៊ាន ធ្វើ » ហើយ ធ្វើ ដោយ ម៉ត់ចត់ ច្បាស់លាស់ និង ប្រុងប្រយ័ត្ន បំផុត ។ ជាមួយគ្នា នេះ រាជ រដ្ឋាភិបាល កម្ពុជា ក៏ បាន ប្រើប្រាស់ ដំណោះស្រាយ ឌីជីថល ដើម្បី បង្កើន ប្រសិទ្ធិភាព ក្នុង ការអនុវត្ត កម្មវិធី នេះ ដោយ ផ្តល់ ប្រាក់ ទៅកាន់ ប្រជាពលរដ្ឋ ដែល ទទួល ផល តាមរយៈ ធនាគារ ឯកទេស វីង ដែល មាន បណ្តាញ ភ្នាក់ងារ នៅ ទូទាំង ប្រទេស ។
លោក ថា វា ជា លើក ដំបូង ដែល យើង អាច ផ្តល់ ប្រាក់ ទៅដល់ ពលរដ្ឋ ដែល ទទួល ផល យ៉ាង ច្រើន ក្នុង រយៈពេល ខ្លី ប៉ុណ្ណោះ ហើយ កត្តា មួយ នៃ ភាពជោគជ័យ ក្នុង ការអនុវត្ត កម្មវិធី នេះ ក៏ ដោយសារតែ រាជ រដ្ឋាភិបាល កម្ពុជា បាន ចាប់ យក ការប្រើប្រាស់ បច្ចេកវិទ្យា ថ្មី នេះ ។
ឯកឧត្តម ស៊ឹម ស៊ី ថា និង លោកជំទាវ បរិច្ចាគ ថវិកា ២០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ស៊ឹម ស៊ី ថា អគ្គ នាយក រដ្ឋាករ ទឹក ស្វយ័ត ក្រុង ភ្នំពេញ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ២០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ក្នុង ឱកាស នោះ លោក ម៉ៅ ឌុង ក្នុង នាម សហភាព សហព័ន្ធ យុវជន កម្ពុជា ខេត្ត ត្បូងឃ្មុំ បាន ថ្លែងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ដល់ លោក ហ៊ុន ម៉ានី ដែល បាន ផ្តល់ នូវ សម្ភារ ទាំង នេះ សម្រាប់ ខេត្ត ត្បូងឃ្មុំ បន្ត យុទ្ធនាការ ចុះអប់រំ ផ្សព្វផ្សាយ បញ្ជ្រាប ដល់ ប្រជាពលរដ្ឋ ក្នុង មូលដ្ឋាន ទាំង ០៧ ក្រុង ស្រុក ដើម្បី រួមគ្នា ជាមួយ រាជ រដ្ឋាភិបាល កម្ពុជា ដែល មាន សម្តេច តេជោ ហ៊ុន សែន ជា ប្រមុខ ប្រឆាំង ការរីករាលដាល ជំងឺ កូវីដ១៩ កុំ ឱ្យ មាន ការឆ្លង សាយភាយ បន្ត រីករាលដាល ក្នុង សហគមន៍ ពិសេស ក្នុង មូលដ្ឋាន ខេត្ត ត្បូងឃ្មុំ ។
នា ពេល កន្លងមក វ៉ាក់សាំង មួយ នេះ ត្រូវបាន គេ មើលឃើញ ថា ជា វ៉ាក់សាំង ឈាន មុខ គេ ប៉ុន្តែ ក្រោយមក វា ត្រូវបាន នាំមុខវិញ ដោយ វ៉ាក់សាំង របស់ ក្រុមហ៊ុន អាមេរិក Pfizer ដែល មាន អត្រា ជោគជ័យ រហូតដល់ទៅ ៩៥ ភាគរយ ឯណោះ ហើយ ត្រូវបាន ប្រើប្រាស់ ជា ផ្លូវការ នៅ ចក្រភព អង់គ្លេស កាលពី ថ្ងៃអង្គារ ដំបូង បង្អស់ នៅលើ ពិភពលោក និង ត្រូវបាន គេ ចាត់ទុក ថា ជា ថ្ងៃ V-Day សម្រាប់ ពិភពលោក ទាំងមូល ។
