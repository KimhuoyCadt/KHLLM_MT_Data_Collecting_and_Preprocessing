ឯកឧត្តម សុខុម រិទ្ធី វុធ ប្រធាន គណៈ ទន្ត ពេទ្យ កម្ពុជា ថ្នាក់ដឹកនាំ និង សមាជិក បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម សុខុម រិទ្ធី វុធ ប្រធាន គណៈ ទន្ត ពេទ្យ កម្ពុជា ថ្នាក់ដឹកនាំ និង សមាជិក សមាជិកា បាន បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឧកញ៉ា សុខ សុង និង លោកជំទាវ បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា សុខ សុង និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោកជំទាវ ជា លាង អគ្គ ព្រះរាជអាជ្ញា តុលាការ កំពូល និង ឯកឧត្តម សុខុម រិទ្ធី វុធ បរិច្ចាគ ថវិកា ៦លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ ជា លាង អគ្គ ព្រះរាជអាជ្ញា មហា អយ្យការ អម តុលាការ កំពូល និង ឯកឧត្តម សុខុម រិទ្ធី វុធ បាន បរិច្ចាគ ថវិកា ៦លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
( ភ្នំពេញ ) ៖ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា នៅ ថ្ងៃទី ១២ ខែធ្នូ ឆ្នាំ ២០២០ នេះ អញ្ជើញ ចូលរួម « កិច្ចប្រជុំ កំពូល ស្តីពី ការប្តេជ្ញាចិត្ត ពាក់ព័ន្ធ នឹង អាកាសធាតុ » តាមរយៈ ប្រព័ន្ធ វីដេអូ ។ កិច្ចប្រជុំ នេះ រៀបចំឡើង ដើម្បី ប្រារព្ធ ខួប លើក ទី៥ នៃ កិច្ចព្រមព្រៀង ទី ក្រុង ប៉ារីស ស្តីពី ការប្រែប្រួល អាកាសធាតុ ។
ក្រសួង ការបរទេស បាន ឱ្យដឹង ថា ការអញ្ជើញ ចូលរួម កិច្ចប្រជុំ ស្តីពី បញ្ហា អាកាសធាតុ របស់ សម្តេច តេជោ ហ៊ុន សែន នា ព្រឹក នេះ ធ្វើឡើង តាម ការអញ្ជើញ រួម របស់ លោក អាន់តូនីញ្ញូ ហ្គូទែរ៉េស អគ្គ លេខាធិការ អង្គការ សហ ប្រជាជាតិ . លោក បូរី ស ចន សុន នាយក រដ្ឋមន្រ្តី អង់គ្លេស . លោក អេម៉ានុយ អែល ម៉ាក្រុង ប្រធានាធិបតី បារាំង . លោក សេបាស្ទៀន ភីណេរ៉ា អ៊ីឆែនិក ប្រធានាធិបតី ស៊ីលី និង លោក ហ្សូហ្សេ ប៉េ កុង តេ នាយក រដ្ឋមន្រ្តី អ៊ីតាលី ។
ក្នុង កិច្ចប្រជុំ នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង ថ្លែង សុន្ទរកថា គន្លឹះ មួយ ផងដែរ ពាក់ព័ន្ធ បញ្ហា អាកាស ។ បើ តាម របៀបវារៈ ដែល បាន រៀបចំ សម្តេច តេជោ ហ៊ុន សែន នឹង ថ្លែង សុន្ទរកថា ចន្លោះ ម៉ោង ១១៖៣០ នាទី ទៅ ម៉ោង ១២ យប់ ថ្ងៃទី ១២ ខែធ្នូ នេះ ( ម៉ោង នៅ កម្ពុជា ) ។
ក្នុង សុន្ទរកថា គន្លឹះ នេះ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី នឹង គូសបញ្ជាក់ អំពី ផល ប៉ះពាល់ យ៉ាង ធ្ងន់ធ្ងរ នៃ ការប្រែប្រួល អាកាសធាតុ ទៅ លើ ការអភិវឌ្ឍ សេដ្ឋកិច្ច - សង្គម របស់ ពិភពលោក ដែល ទាមទារ ការដោះស្រាយ តាមរយៈ កិច្ច ខិតខំ ប្រឹងប្រែង រួមគ្នា ។
សម្តេច តេជោ នឹង លើកឡើង ផងដែរ អំពី ការប្តេជ្ញាចិត្ត របស់ កម្ពុជា ក្នុង ការប្រយុទ្ធ ប្រឆាំង នឹង ការប្រែប្រួល អាកាសធាតុ ដោយ មាន វិធានការ និង យុទ្ធសាស្រ្ត ច្បាស់លាស់ និង ប្រកបដោយ ប្រសិទ្ធភាព បើ ទោះបីជា កម្ពុជា មាន ចំណែក តិចតួច ក្នុង ការបញ្ចេញ ឧស្ម័ន ផ្ទះ កញ្ចក់ សកលក្តី ៕
លោក គឹម យឿន និង លោកស្រី ជា អ៉ីម បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក គឹម យឿន និង លោកស្រី ជា អ៉ីម បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ កូនស្រី ទេសរដ្ឋមន្ដ្រី ត្រាំ អ៉ីវ តឹក បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ កូនស្រី ទេសរដ្ឋមន្ដ្រី ត្រាំ អ៉ីវ តឹក បាន បរិច្ចាគ ថវិកា ១០លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឧកញ៉ា សំអាង វឌ្ឍនៈ បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា សំអាង វឌ្ឍនៈ បាន បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ លោកជំទាវ សំអាង កាន្និកា បរិច្ចាគ ថវិកា ៤. ០៧៧.០០០ រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ សំអាង កាន្និកា បាន បរិច្ចាគ ថវិកា ៤. ០៧៧.០០០ រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ក្រុមហ៊ុន វឌ្ឍនៈ អ៉ិន វេស មេន លីមីធីត បរិច្ចាគ ថវិកា ២៧. ៧៣៣ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន វឌ្ឍនៈ អ៉ិន វេស មេន លីមីធីត បាន បរិច្ចាគ ថវិកា ២៧. ៧៣៣ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ពាក់ព័ន្ធ ព្រឹត្តិការណ៍ « សហគមន៍ ២៨វិច្ឆិកា » នៅ ថ្ងៃទី ១១ ខែធ្នូ ឆ្នាំ ២០២០ វត្ថុ សំណាក ចំនួន ៨៣៩ សំណាក ត្រូវបាន ធ្វើ វិភាគ ដោយ វិទ្យាស្ថាន ប៉ាស្ទ័រ កម្ពុជា គឺ មាន លទ្ធផល អវិជ្ជមាន វីរុស កូវីដ១៩ ថ្មី ទាំងអស់ ។ ដោយឡែក មាន នៅសល់ វត្ថុ សំណាក ចំនួន ៦៨សំណាក ផ្សេង ទៀត ដែល ត្រូវ វិភាគ បន្ត នៅ ថ្ងៃទី ១២ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ។
គួរ បញ្ជាក់ ថា រដ្ឋ ឈូង សមុទ្រ អារ៉ាប់ មួយ នេះ បាន ចាប់ផ្តើម ទទួលយក ការតេស្ត ដំណាក់កាល ចុងក្រោយ នៃ វ៉ាក់សាំង COVID-19 របស់ ក្រុមហ៊ុន ចិន Sinopharm កាលពី ខែកក្កដា កន្លងទៅ នេះ ។ ហើយ កាលពី ខែកញ្ញា វ៉ាក់សាំង របស់ ក្រុមហ៊ុន នេះ ក៏ ត្រូវបាន អនុញ្ញាតឲ្យ ប្រើប្រាស់ ជាបន្ទាន់ សម្រាប់ ក្រុម ដែល ប្រឈមមុខ ខ្ពស់ មួួយ ចំនួន នៅក្នុង ប្រទេស អារ៉ាប់ មួយ នេះ ផងដែរ ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ របស់ ខ្លួន ក្រសួង សុខាភិបាល អារ៉ាប់ រួម បាន លើកឡើង ដោយ មិន បាន លម្អិត ច្បាស់ យ៉ាង ដូច្នេះ ថា ការវិភាគ ទៅ លើ លទ្ធផល ធ្វើតេស្ត កន្លងមក បាន បង្ហាញ ថា មិន មាន បញ្ហា សុវត្ថិភាព ធ្ងន់ធ្ងរ ត្រូវបារម្ភ នោះ ទេ ។ មិន តែ ប៉ុណ្ណោះ ថែមទាំង បាន បញ្ជាក់ ទៀត ថា ខ្លួន បាន ចុះបញ្ជី វ៉ាក់ សំាង មួយ នេះ ជា ផ្លូវការ ហើយ ដែរ ។
គួរ បញ្ជាក់ ថា ក្រុមហ៊ុន ផលិត ឱសថ ចិន Sinopharm ក៏ បាន ពង្រីក ដែន តេស្ត របស់ ខ្លួន រហូតដល់ ប្រទេស អេហ្ស៊ីប ហ៊្សក ដានី និង បារ៉ែន ផងដែរ ។ វា ជា វ៉ាក់សាំង មួយ ក្នុង ចំណោម វ៉ាក់សាំង នាំមុខ គេ ទាំង បី របស់ ចិន ខណៈ ដែល វ៉ាក់សាំង ទាំងនេះ ក៏ ត្រូវបាន មនុស្ស ខ្ទង់ លាន នាក់ ទទួល ចាក់ នៅក្នុង ប្រទេស ក្រោម កម្មវិធី ដាក់ ឲ្យ ប្រើប្រាស់ ជាបន្ទាន់ ៕
កំពូល តារា ចម្រៀង សុខ ពិសី បរិច្ចាគ ថវិកា ៣០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ កំពូល តារា ចម្រៀង ប្រចាំ ផលិតកម្ម សាន់ដេរ កញ្ញា សុខ ពិសី បាន បរិច្ចាគ ថវិកា ៣០០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
ឯកឧត្តម ពេជ្រ សម្បត្តិ អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច បរិច្ចាគ ថវិកា ៤លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ពេជ្រ សម្បត្តិ អនុ រដ្ឋលេខាធិការ ក្រសួង សេដ្ឋកិច្ច និង ហរិញ្ញវត្ថុ បាន បរិច្ចាគ ថវិកា ៤លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ភិក្ខុ ម៉ៅ ម៉ាន ចៅអធិការ វត្ត សង្ឃ សាមី ជប់ នៅ ស្រុក ត្បូងឃ្មុំ បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ភិក្ខុ ម៉ៅ ម៉ាន ចៅអធិការ វត្ត សង្ឃ សាមី ជប់ នៅ ស្រុក ត្បូងឃ្មុំ ខេត្ត ត្បូងឃ្មុំ និង លោក អាចារ្យ គណៈកម្មការ វត្ត បាន បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ក្រុមហ៊ុន លឹម លុង បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន លឹម លុង បាន បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម តុ ប សំ និង លោកជំទាវ បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម តុ ប សំ និង លោកជំទាវ បាន បរិច្ចាគ ថវិកា ២ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោកជំទាវ ឥម នី ថា រ៉ា រដ្ឋលេខាធិការ ក្រសួង សាធារណការ បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ ឥម នី ថា រ៉ា រដ្ឋលេខាធិការ ក្រសួង សាធារណការ និង ដឹកជញ្ជូន បាន បរិច្ចាគ ថវិកា ៥០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
គួរ បញ្ជាក់ តាម WHO ទៀត ថា អង្គការ សុខាភិបាល អន្តរជាតិ មួយ នេះ អាចនឹង អនុម័ត ឲ្យ វ៉ាក់សាំង ទាំង បី នេះ ប្រើប្រាស់ នៅក្នុង ប្រទេស មួយចំនួន បើ ទោះបីជា និយ័តករ វេជ្ជសាស្ត្រ នៅក្នុង ប្រទេស ទាំងនោះ មិន ទាន់ អាច ពិនិត្យ វ៉ាក់សាំង បាន លម្អិត ដោយ ខ្លួន ឯង ក៏ដោយ ។ WHO បាន បង្ហើប ឲ្យដឹង ថា បច្ចុប្បន្ន នេះ មាន ក្រុមហ៊ុន ចំនួន ១០ ហើយ បាន ចាប់អារម្មណ៍ ដាក់ពាក្យ មកកាន់ អង្គការ នេះ ដើម្បី ត្រួតពិនិត្យ និង ធ្វើ ការដាក់ចេញ ឲ្យ ប្រើប្រាស់ វ៉ាក់សាំង របស់ ពួកគេ នៅក្នុង ករណី បន្ទាន់ ។
លោកជំទាវ នាង ជា និង ឧកញ៉ា សុខ ប៊ុន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ នាង ជា និង ឧកញ៉ា សុខ ប៊ុន បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឧកញ៉ា អ៉ឹង ឆៃ ងួន អគ្គ នាយក ទូរទស្សន៍ ហង្ស មាស បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា អ៉ឹង ឆៃ ងួន អគ្គ នាយក ទូរទស្សន៍ ហង្ស មាស បាន បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម បណ្ឌិត ឌួង លាង និង លោកជំទាវ កែវ ថាណា រ័ត្ន បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម បណ្ឌិត ឌួង លាង ប្រធាន ក្រុមប្រឹក្សាភិបាល សាកលវិទ្យាល័យ អាស៉ី អឺរ៉ុប និង លោកជំទាវ កែវ ថាណា រ័ត្ន បាន បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោក ចេង ស្រុង ប្រធាន មន្ទីរ រៀបចំ ដែនដី ខេត្ត ព្រះសីហនុ បរិច្ចាគ ថវិកា ២០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោក ចេង ស្រុង ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ និង សុរិយោដី ខេត្ត ព្រះសីហនុ បាន បរិច្ចាគ ថវិកា ២០ លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សម្តេច រាជ បុត្រី ព្រះអនុជ នរោត្តម អរុណ រស្មី បរិច្ចាគ ថវិកា ១៤០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ សម្តេច រាជ បុត្រី ព្រះអនុជ នរោត្តម អរុណ រស្មី បាន បរិច្ចាគ ថវិកា ១៤០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
( ភ្នំពេញ ) ៖ លោកជំទាវ វេជ្ជបណ្ឌិត ឱក លីនី និង ឯកឧត្តម វេជ្ជបណ្ឌិត គីម សួរ ភីរុណ ប្រធាន មន្ទីរ សុខាភិបាល ខេត្ត កំពង់ចាម បាន បរិច្ចាគ ថវិកា ១ ពាន់ ដល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឯកឧត្តម ជា វុទ្ធី និង លោកជំទាវ កង វណ្ណារី បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឯកឧត្តម ជា វុទ្ធី និង លោកជំទាវ កង វណ្ណារី បាន បរិច្ចាគ ថវិកា ៥ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ព្រឹក នេះ ក្រសួង សុខាភិបាល ធ្វើតេស្ត អ្នក ពាក់ព័ន្ធ « ព្រឹត្តិការណ៍ សហគមន៍ ២៨វិច្ឆិកា » លើក ទី៣. ក្រសួង អំពាវនាវ ឱ្យ រក្សា គម្លាត សុវត្ថិភាព
( ភ្នំពេញ ) ៖ ព្រឹក ថ្ងៃទី ១២ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ជា ពេលវេលា សម្រាប់ យក សំណាក ធ្វើតេស្ត រក ជំងឺ កូវីដ១៩ ជា លើក ទី៣ សម្រាប់ អ្នក ពាក់ព័ន្ធ « ព្រឹត្តិការណ៍ សហគមន៍ ២៨វិច្ឆិកា » ទាំង ផ្ទាល់ និង ប្រយោល ។
ក្រសួង សុខាភិបាល បាន រៀបចំ ទីតាំង សម្រាប់ យក សំណាក លើក ទី៣ នេះ នៅ ៧ទីតាំង រួម មាន៖
១៖ ផ្ទះ សម្តេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន វេលា ម៉ោង ៨៖០០ ព្រឹក ២៖ ផ្ទះ សម្តេច ក្រឡាហោម ស ខេង វេលា ម៉ោង ៨៖០០ ព្រឹក ៣៖ រដ្ឋសភា ម៉ោង ៩៖០០ ព្រឹក ៤៖ ក្រសួង មហាផ្ទៃ ម៉ោង ៨៖០០ ព្រឹក ៥៖ ផ្ទះ ឯកឧត្តម ហ៊ុន ម៉ានី ម៉ោង ១១ព្រឹក ៦៖ ទីតាំង អង្គភាព អ្នក បើក យន្តហោះ បន្ទាយ ទួល ក្រសាំង សម្រាប់ ក្រុម អ្នក បើក យន្តហោះ និង ក្រុម អង្គរក្ស សម្តេច តេជោ ៧៖ ពហុកីឡាដ្ឋាន ជាតិ អូឡាំពិក ( សម្រាប់ ប្រជាពលរដ្ឋ ដែល បាន ប៉ះពាល់ ផ្ទាល់ និង ប្រយោល ម៉ោង ៧៖០០ ព្រឹក ។
ជាមួយគ្នា នេះ លោកស្រី យក់ សម្បត្តិ រដ្ឋលេខាធិការ ក្រសួង សុខាភិបាល តាមរយៈ បណ្តាញ ព័ត៌មាន Fresh News បាន អំពាវនាវ ឱ្យ បុគ្គល ទាំងអស់ ដែល នឹង ចូលរួម យក សំណាក ជា លើក ទី៣ នេះ ត្រូវ អនុវត្ត ការរក្សា គម្លាត សុវត្ថិភាព ពាក់ ម៉ាស និង លាង ដៃ នឹង អាល់កុល ជាប់ ជាប្រចាំ ដើម្បី ការពារ ខ្លួន កុំ ឱ្យ ចម្លង កូវីដ១៩ នៅពេល ទៅ យក សំណាក ។
ក្រសួង សុខាភិបាល និង អាជ្ញាធរ ពាក់ព័ន្ធ បាន និង កំពុង ស្វះស្វែង អនុវត្តន៍ វិធានការ នានា យ៉ាង ម៉ឺងម៉ាត់ ដើម្បី កាត់ផ្តាច់ « ព្រឹត្តិការណ៍ សហគមន៍ ២៨វិច្ឆិកា » នេះ ៕ លោកជំទាវ សំអាង ល ក្ខុិ ណា បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ លោកជំទាវ សំអាង ល ក្ខុិ ណា បាន បរិច្ចាគ ថវិកា ១ ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ក្រុមហ៊ុន ស៉ី ភីអ សឺវីស អេឡិកត្រូនិច សេនធ័រ ឯ . ក បរិច្ចាគ ថវិកា ២លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ក្រុមហ៊ុន ស៉ី ភីអ សឺវីស អេឡិកត្រូនិច សេនធ័រ ឯ . ក បាន បរិច្ចាគ ថវិកា ២លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
ឧកញ៉ា លឹម ប៊ុណ្ណា និង លោកជំទាវ ថុង ធីតា បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា លឹម ប៊ុណ្ណា និង លោកជំទាវ ថុង ធីតា បាន បរិច្ចាគ ថវិកា ១ម៉ឺន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
គោរព ច្បាប់ ចរាចរណ៍ បើកបរ ដោយ ការអធ្យាស្រ័យ ខ្ពស់ ! ស្លាប់ ៥នាក់ និង របួស ១៦នាក់ ក្នុង គ្រោះថ្នាក់ ចរាចរណ៍ ទូទាំង ប្រទេស ថ្ងៃទី ១១ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យោង តាម របាយការណ៍ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ឲ្យដឹង ថា នៅ ថ្ងៃទី ១១ ខែធ្នូ ឆ្នាំ ២០២០ មាន ករណី គ្រោះថ្នាក់ ចរាចរណ៍ នៅ ទូទាំង ប្រទេស កើតឡើង ចំនួន ១១លើ ក បណ្ដាលឲ្យ មនុស្ស ស្លាប់ ៥នាក់ និង របួស ធ្ងន់ ស្រាល ១៦ នាក់ ។
ប្រភព ព័ត៌មាន ដដែល បញ្ជាក់ ថា មូលហេតុ ដែល បណ្ដាលឲ្យ កើតមាន គ្រោះថ្នាក់ ចរាចរណ៍ រួម មាន៖ ល្បឿន . មិន គោរព សិទ្ធ . មិន ប្រកាន់ ស្ដាំ . ប្រជែង គ្រោះថ្នាក់ និង បត់ / មិន ប្រយ័ត្ន ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ១១ ខែធ្នូ ឆ្នាំ ២០២០
៣៖ មហាសេដ្ឋី ម៉ាឡេស៊ី លោក តាន់ ស្រ៊ី បរិច្ចាគ ថវិកា ៥លាន ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
៥៖ ក្រសួង សុខាភិបាល បញ្ជាក់ ពី ការយកចិត្តទុកដាក់ លើ អ្នក ជាប់ ឃុំ ក្នុង ពន្ធនាគារ បញ្ចៀស ពី ការឆ្លង ជំងឺ កូវីដ១៩
៦៖ កូរ៉េ ខាងត្បូង នឹង ដាក់ពង្រាយ កងទ័ព នៅ សេអ៊ូល ដើម្បី ជួយ ទប់ស្កាត់ ករណី ឆ្លង កូវីដ - ១៩ ដែល កំពុង កើនឡើង
៧៖ តុលាការ នឹង បន្ត សវនា សំណុំរឿង ទណ្ឌិត សម រង្ស៉ី និង បក្ខពួក នៅ ថ្ងៃទី ២៩ ខែធ្នូ ករណី ញុះញង់ កងទ័ព និង រួម គំនិត ក្បត់
៩៖ អ្នកនាំពាក្យ ក្រសួង សុខាភិបាល បញ្ជាក់ ថា បុរស ធ្លាក់ ពីលើ សណ្ឋាគារ ឡុង លីវ ពេល កំពុង ធ្វើចត្ដាឡី ស័ក ព្រោះ ភ្លាត់ ជើង និង វិបត្តិ ផ្ទាល់ខ្លួន
១១៖ លោក ជិន ម៉ាលី ន៖ ការបង្ហាញ អត្តសញ្ញាណ អ្នក វិជ្ជមាន ជំងឺ កូវីដ - ១៩ កន្លងទៅ មិន មែន ជា ការរំលោភ លើ សិទ្ធិ បុគ្គល និង ឯកជន ភាព ទេ ប៉ុន្តែ ជា វិធានការចាំបាច់
១៣៖ ក្រសួង វប្បធម៌ បន្ត ផ្អាក ជា បណ្តោះអាសន្ន ការចូល ទស្សនា សារមន្ទីរ រោង ភាពយន្ត និង រោង សម្តែង សិល្បៈ គ្រប់ ប្រភេទ នៅ ទូទាំង ប្រទេស
១៥៖ ធនាគារ ធំ មួយ របស់ កូរ៉េ ផ្តល់ អំណោយ ម៉ាស តម្លៃ ១ម៉ឺន ដុល្លារ ដល់ កម្ពុជា និង យល់ព្រម បញ្ចុះ អត្រា ការប្រាក់ ដល់ ពលករ ខ្មែរ ឱ្យ កាន់តែ ប្រសើរ តប តាម ការស្នើ របស់ ស្ថានទូត កម្ពុជា
១៦៖ លោក បូរី ស ចន សុន ប្រាប់ ចក្រភព អង់គ្លេស ឲ្យ ត្រៀមខ្លួន សម្រាប់ ការចាកចេញ ពី អឺរ៉ុប « ដោយ គ្មាន កិច្ចព្រមព្រៀង ពាណិជ្ជកម្ម »
១៧៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ បញ្ឈប់ ដំណើរការ ប្រព័ន្ធ គ្រប់គ្រង ការបង្វិល សង អាករ លើ តម្លៃ បន្ថែម ដោយ ជំនួស វិញ នូវ ប្រព័ន្ធ គ្រប់គ្រង ការដាក់ លិខិត ប្រកាស ពន្ធ តាម អនឡាញ
២១៖ រដ្ឋមន្ដ្រី កសិកម្ម៖ គិត ត្រឹម ថ្ងៃទី ១០ ខែធ្នូ ដំណាំ ស្រូវ ជិត ៦ម៉ឺន ហិកតា ដែល រង ប៉ះពាល់ ដោយ ទឹក ជំនន់ ត្រូវបាន ស្តារ ឡើងវិញ
២២៖ បាតុករ ថៃ ស្វែងរក ជំនួយ ពី អង្គការ សហ ប្រជាជាតិ ប្រចាំ ទីក្រុង បាងកក ដើម្បី លុបចោល ច្បាប់ បរិហារ កេរ្តិ៍ របស់ ព្រះមហាក្សត្រ ថៃ
២៤៖ អង្គ សន្និបាត AIMF សម្រេច ជ្រើសរើស ទីក្រុង ប័រ ដូ ប្រទេស បារាំង ធ្វើជា កន្លែង ប្រជុំ ការិយាល័យ អចិន្ត្រៃយ៍ នៅ ខែមីនា និង ជ្រើសរើស ទីក្រុង គី កាលី ប្រទេស រ៉វាន់ ដា ធ្វើជា ម្ចាស់ ផ្ទះ នៃ មហាសន្និបាត AIMF នៅ ខែកក្ដ ដា ឆ្នាំ ២០២១
២៥៖ ADB ត្រៀម ថវិកា ៩ពាន់ លាន ដុល្លារ ជួយ ប្រទេស សមាជិក រួម ទាំង កម្ពុជា ដើម្បី អាច ទទួល និង ចែកចាយ វ៉ាក់ សំាង កូវីដ១៩
២៦៖ តៃវ៉ាន់ បញ្ចេញ នាវា ល្បាត ស៊េរី ថ្មី ដែល មាន សមត្ថភាព បំពាក់ មីស៊ីល និង អាច វិវឌ្ឍ ខ្លួន ទៅជា នាវា ប្រយុទ្ធ
២៧៖ បទ វិចារណក ថា៖ មហាជន គាំទ្រ សម្តេច តេជោ ហ៊ុន សែន បរិច្ចាគ ថវិកា យ៉ាង ផុល ផុស ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩
៨៖ អ្នកចាំទី ជា វណ្ណ សាក់ ផ្ទេរ ចូល ក្លិប អង្គរ ថា យហ្គឺរ ជា ផ្លូវការ
៩៖ សំអឿន ពិដោរ ផ្ទេរ ពី ព្រះខ័ន រាជ ស្វាយរៀង ទៅ ណាហ្គា ក្រោម លក្ខខណ្ឌ ខ្ចី ជើង
១០៖ គុយ បា សម្រេច បោះបង់ ចោល ប្រព័ន្ធ រូបិយ បណ្ណ ពីរ ផ្សេង គ្នា របស់ ខ្លួន នៅ ដើម ឆ្នាំ ២០២១
សមាគមន៍ នារី ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ សាខា ក្រសួង ព័ត៌មាន បរិច្ចាគ ថវិកា ៣១៣៥ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ សមាគមន៍ នារី ដើម្បី សន្តិភាព និង អភិវឌ្ឍន៍ សាខា ក្រសួង ព័ត៌មាន បរិច្ចាគ ថវិកា ចំនួន ៣១៣៥ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
លោក រដ្ឋមន្ត្រី ក្រសួង អប់រំ បាន បញ្ជាក់ ថា ការជំរុញ ឲ្យ មាន ការស្រាវជ្រាវ រក ក្មេងស្រី ជនជាតិ កូរ៉េ នេះ ធ្វើឡើង តាម សំណើ របស់ អគ្គ ស្នងការដ្ឋាន នគរបាល ជាតិ ។
បើ តាម លោក រដ្ឋមន្ត្រី ក្មេងស្រី ជនជាតិ កូរ៉េ រូប នេះ បាន ចូលមក កម្ពុជា តាំងពី ឆ្នាំ ២០១៤មក ម្ល៉េះ ហើយ មិន ទាន់ ចាកចេញ ពី ប្រទេស កម្ពុជា នៅឡើយ ទេ ៕
ប្រធាន ក្រុមការងារ ស្រុក បាភ្នំ ចុះ ពិនិត្យ សំណង់ អគារ សិក្សា ២ខ្នង ជា អំណោយ របស់ សម្តេច ក្រឡាហោម ស ខេង
( ព្រៃវែង ) ៖ លោក ព្រុំ សុខា រដ្ឋមន្ត្រី ក្រសួង មុខងារ សាធារណៈ និង ជា ប្រធាន ក្រុមការងារ ស្រុក បាភ្នំ បាន ចុះ ទៅ ពិនិត្យ សំណង់ អគារ សិក្សា ២ខ្នង មាន ១១ បន្ទប់ ដែល ជា អំណោយ ដ៏ ថ្លៃថ្លា របស់ សម្តេច ក្រឡាហោម ស ខេង ជូន សាលា បឋមសិក្សា វត្ត នាគរង្សី និង វត្ត ពង ពស់ ស្ថិត ក្នុង ឃុំ រោង ដំរី ស្រុក បាភ្នំ ខេត្ត ព្រៃវែង ។
ការចុះ ទៅ ពិនិត្យ សំណង់ អគារ សិក្សា នេះ បាន ប្រព្រឹត្តទៅ នៅ រសៀល ថ្ងៃទី ១១ ខែធ្នូ ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ដំណើរ ពីសំណាក់ លោកស្រី គង់ សាឡន អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រៃវែង លោក ព្រុំ សន្ធរ ស្នងការ នគរបាល ខេត្ត ដែល ជា អនុប្រធាន ក្រុមការងារ ស្រុក លោក ប្រធាន ក្រុមប្រឹក្សា លោក អភិបាល និង មន្ត្រីរាជការ ស្រុក ព្រមទាំង ប្រធាន ការិយាល័យ អប់រំ ស្រុក នាយក សាលា លោកគ្រូ អ្នកគ្រូ ជាច្រើន រូប ទៀត ។
អគារ សិក្សា ១ខ្នង ៦ បន្ទប់ ស្ថិត ក្នុង សាលា បឋមសិក្សា វត្ត នាគរង្សី សាងសង់ រួចរាល់ ជា ស្ថាពរ ប៉ុន្តែ មិន ទាន់ បាន ធ្វើ ពិធី សម្ពោធ ដាក់ ឱ្យ ប្រើប្រាស់ ជា ផ្លូវការ អាស្រ័យ ដោយ ស្ថានភាព កូវីដ១៩ ។
អគារ សិក្សា មួយ ខ្នង ទៀត ដែល មាន ៥ បន្ទប់ ស្ថិត ក្នុង សាលា បឋមសិក្សា វត្ត ពង ពស់ កំពុង ដំណើរការ សាងសង់ ដែល នឹង ត្រូវ បញ្ចប់ នៅ ដើម ឆ្នាំ ២០២១ ខាងមុខ នេះ ។
អគារ សិក្សា ទាំង ២ខ្នង នេះ គ្រោង ចំណាយ ការសាងសង់ សរុប អស់ ប្រមាណ ១៥០.០០០ ដុល្លារ អាមេរិក ៕ លោកស្រី ស៊ូ សុជាតា ព្រះរាជអាជ្ញា រង ខេត្ត កណ្ដាល និង ស្វាមី បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ លោកស្រី ស៊ូ សុជាតា ព្រះរាជអាជ្ញា រង អម សាលាដំបូង ខេត្ត កណ្ដាល និង ស្វាមី នៅ ថ្ងៃទី ១១ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បរិច្ចាគ ថវិកា ៣ពាន់ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ១៩ ។
ថ្នាក់ដឹកនាំ មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ព្រះសង្ឃ អាជីវករ និង ប្រជាពលរដ្ឋ នៅ ខេត្ត ក្រចេះ បរិច្ចាគ ថវិកា ជាង ២២៣ លាន រៀល និង ២៧៥០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( ភ្នំពេញ ) ៖ ក្រុមប្រឹក្សា គណៈ អភិបាល មន្រ្តី រាជការ កងកម្លាំងប្រដាប់អាវុធ ព្រះសង្ឃ អាជីវករ និង ប្រជាពលរដ្ឋ នៅ ខេត្ត ក្រចេះ បាន បរិច្ចាគ ថវិកា ចំនួន ២២៣ ៥៤៦ ០០០ និង ២៧៥០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ជូន ចាក់ ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ អភិបាល ស្រុក កំពង់ត្រា ច លោក អូន ខន និង ភរិយា បរិច្ចាគ ថវិកា ១លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
អភិបាល ស្រុក អង្គរ ជ័យ លោក កឹម បូណា និង ភរិយា បរិច្ចាគ ថវិកា ១លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
អភិបាល ស្រុក បន្ទាយមាស លោក មួង នឿន និង ភរិយា បរិច្ចាគ ថវិកា ១លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
អភិបាល ស្រុក ទឹក ឈូ លោក នាក់ សុវណ្ណារី និង ភរិយា បរិច្ចាគ ថវិកា ១លាន រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
