( ភ្នំពេញ ) ៖ លោក Pablo Chiho Kang ឯក អគ្គ រដ្ឋទូត វិសាមញ្ញ និង ពេញ សមត្ថភាព របស់ ប្រទេស អូស្រ្តាលី ប្រចាំ កម្ពុជា បាន បញ្ជាក់ ជាថ្មី ជម្រាប ជូន អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី អូន ព័ន្ធ មុនីរ័ត្ន រដ្ឋមន្រ្តី ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ ពី ការត្រៀម ថវិកា ៣០០ លាន ដុល្លារ របស់ រដ្ឋាភិបាល អូស្ដ្រាលី សម្រាប់ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ជួយ ដល់ ប្រទេស នៅ តំបន់ អាស៊ី អាគ្នេយ៍ រួម មាន ប្រទេស កម្ពុជា ផងដែរ ។
លោក អគ្គ រដ្ឋទូត បាន ជម្រាប ជូន ថា រដ្ឋាភិបាល អូស្រ្តាលី សន្យា នឹង ជួយ ឧបត្ថម្ភ គាំទ្រ ដល់ រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ការផ្តល់ ហិរញ្ញប្បទាន ឥត សំណង សម្រាប់ អនុវត្ត គម្រោង និង កម្មវិធី នានា ដែល កំពុង ប្រតិបត្តិការ នៅ កម្ពុជា បន្ត ទៀត សំដៅ លើកកម្ពស់ គុណភាព សេវា សុខាភិបាល . វិស័យ កសិកម្ម . ការផ្គត់ផ្គង់ ទឹក ស្អាត និង ហេដ្ឋារចនាសម្ព័ន្ធ អគ្គិសនី និង គាំទ្រ រាជ រដ្ឋាភិបាល ក្នុង ការអនុវត្ត គោល នយោបាយ គាំពារ សង្គម និង ធានា សមភាព ក្នុង ការទទួលបាន នូវ សេវា សង្គម ដល់ ជន ពិការ និង ស្រ្តី ងាយ រងគ្រោះ ។
លោក អគ្គ រដ្ឋទូត បាន គូសបញ្ជាក់ បន្ថែម ថា រដ្ឋាភិបាល អូស្រ្តាលី នឹង ចូលរួម គាំទ្រ ហិរញ្ញប្បទាន មាន ទឹកប្រាក់ ៣០០ លាន ដុល្លារ អូស្រ្តាលី ដល់ ប្រទេស នៅ តំបន់ អាស៊ី អាគ្នេយ៍ រួម មាន ប្រទេស កម្ពុជា ផងដែរ ក្រោម កញ្ចប់ ជំនួយ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ក្នុង ន័យ បង្ហាញ ពី គោលជំហរ របស់ រដ្ឋាភិបាល អូស្រ្តាលី ដើម្បី ឆ្លើយតប ទៅនឹង ការបញ្ឍប់ ការរីករាលដាល នៃ ជំងឺ កូវីដ - ១៩ ប្រកបដោយ ប្រសិទ្ធភាព សម្រាប់ ជា ប្រយោជន៍ ដល់ កម្ពុជា និង ប្រទេស ក្នុង តំបន់ អាស៊ី អាគ្នេយ៍ ។
កម្មវិធី នេះ នឹង ផ្តោត លើ សមាសភាព ៣ សំខាន់ ៗ រួម មាន៖ ការធ្វើ កិច្ច លទ្ធកម្ម . ការផ្តល់ ប្រឹក្សា បច្ចេកទេស ( ការដឹកជញ្ជូន និង ការរក្សាទុក នូវ វ៉ាក់សាំង ) និង ការផ្តល់ ការបណ្តុះ បណ្តាល ដល់ ក្រុមការងារ សុខាភិបាល ។
លោក អគ្គ បណ្ឌិត សភាចារ្យ ឧប នាយក រដ្ឋមន្រ្តី ក៏ បាន គូសបញ្ជាក់ បន្ថែម ផងដែរ ថា រាជ រដ្ឋាភិបាល កម្ពុជា នឹង បញ្ជាទិញ វ៉ាក់សាំង បង្ការ ជំងឺ កូវីដ - ១៩ ទាំងឡាយ ណា ដែល មាន ការទទួលស្គាល់ ពី អង្គការ សុខភាព ពិភពលោក (WHO) តែ ប៉ុណ្ណោះ ។
លោក អគ្គ រដ្ឋទូត បាន ថ្លែង នូវ ការកោតសរសើរ និង វាយតម្លៃ ខ្ពស់ ចំពោះ កិច្ច ខិតខំ ប្រឹងប្រែង របស់ រាជ រដ្ឋាភិបាល ក្នុង ភាព ជា ម្ចាស់ ប្រកបដោយ បុរេសកម្ម លើ កិច្ចការ ប្រយុទ្ធ ប្រឆាំង នឺង ជំងឺ រាតត្បាត ជា សកល នេះ និង បាន បង្ហាញ ជំហរ ច្បាស់លាស់ ក្នុង ការត្រៀមខ្លួន ជាស្រេច ក្នុង បន្ត សកម្ម ចូលរួម ជាមួយ រាជ រដ្ឋាភិបាល ថែម ទៀត ។
លោក គីម ជុង អ៉ីល ឪពុក របស់ មេដឹកនាំ បច្ចុប្បន្ន គឺ លោក គីម ជុង អ៊ុន ត្រូវបាន តែងតាំង ជា មេបញ្ជាការ ជាន់ ខ្ពស់ ផុត លេខ នៃ កងទ័ព ប្រជាជន កូរ៉េ ខាងជើង កាលពី ឆ្នាំ ១៩៩១ ពោលគឺ ៣ ឆ្នាំ មុនពេល លោក ឡើង កាន់អំណាច ជា មេដឹកនាំ នៃ ប្រទេស អាស៉ី ខាងកើត មួយ នេះ ។
កាសែត រដ្ឋ កូរ៉េ ខាងជើង បាន បន្ត ទៀត ថា « ប្រទេស មួយ មិន អាច ក្លាយជា ប្រទេស មហា អំណាច ដោយ គ្មាន កម្លាំង កងទ័ព ខ្លាំង បាន ឡើយ ។ ប្រវត្តិសាស្រ្ត បាន បង្រៀន យើង ថា សូម្បី ដែល ប្រទេស មហា អំណាយ មួយ អាច ដួលរលំបាន ដោយសារ មាន កម្លាំង កងទ័ព ទន់ខ្សោយ ហើយ ប្រទេស តូច មួយ វិញ ក៏ អាច ទទួលបាន នូវ សេចក្ដីថ្លៃថ្នូរ ប្រៀប ដូច នឹង ប្រទេស មហា អំណាច មួយ យ៉ាង ដូច្នោះ ឲ្យ មាន តែ កម្លាំង កងទ័ព ដ៏ មាន ឥទ្ធិពល » ។
កាសែត ដដែល បាន បញ្ជាក់ ទៀត ថា « កូរ៉េ ខាងជើង បាន បង្កើត នូវ ឧស្សាហកម្ម ការពារ ជាតិ ដ៏ ទំនើប និង ឯករាជ្យ ដែល មាន សមត្ថភាព បង្កើត បរិក្ខា យោធា ណាមួយ បាន យ៉ាង ងាយ ប្រសិនបើ យើង មាន ឆន្ទៈ ដូច្នេះហើយ យើង ត្រូវ ថ្លែងអំណរគុណ ដល់ អតីត មេដឹកនាំ មុន ៗ របស់ យើង » ។ ទន្ទឹម គ្នា នេះ សមិទ្ធិផល របស់ មេដឹកនាំ បច្ចុប្បន្ន គឺ មេដឹកនាំ កំពូល គីម ជុង អ៊ុន ក៏ ត្រូវតែ អរសាទរ ផងដែរ ជាមួយនឹង អាវុធ ថ្មី ដែល ត្រូវបាន ដាក់ បង្ហាញ នៅក្នុង ពិធី ព្យុហយាត្រា យោធា កាលពី ពេល ថ្មី ៗ នេះ សុទ្ធតែ ជា លទ្ធផល នៃ ការលះបង់ របស់ លោក ។
កាលបរិច្ឆេទ ទទួល ពាក្យ ប្រឡង ចាប់ផ្តើម ចាប់ពី ថ្ងៃទី ០៥ ខែមករា រហូតដល់ ថ្ងៃទី ២២ ខែមករា ឆ្នាំ ២០២១ វេលា ម៉ោង ១៧៖០០ នាទី នៅ ទីតាំង ទី១ នៃ សាកលវិទ្យាល័យ វិទ្យាសាស្ដ្រ សុខាភិបាល ។ ខណៈ ការប្រឡង ជ្រើសរើស គ្រោង នឹង ប្រព្រឹត្ដ នៅ ដើម ខែកុម្ភៈ ឆ្នាំ ២០២១ ។
អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ៖ មនុស្ស ៣៧ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន ថ្ងៃទី ២៣ ខែធ្នូ ម្សិលមិញ
( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៣៧ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ រសៀល ថ្ងៃទី ២៤ ខែធ្នូ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៣៧ នាក់ នោះ មាន ១៥នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១២ករណី និង ជនសង្ស័យ ២២ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១០ករណី ។
លោក រដ្ឋមន្ត្រី បាន ចាត់ទុក ថា ការរៀបចំ ទីស្នាក់ការ កណ្ដាល ថ្មី ដែល ប្រកបដោយ ការគិតគូរ យកចិត្តទុកដាក់ គ្រប់ ជ្រុងជ្រោយ នេះ គឺជា ជោគជ័យ មួយ ជំហាន ទៀត សម្រាប់ ប្រតិបត្តិការ ក្នុង វិស័យ ព័ត៌មាន នាយុគសម័យ បច្ចេកវិទ្យា ទំនើប នេះ ។
មិន តែ ប៉ុណ្ណោះ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន រូប នេះ ក៏ បាន ចារ បញ្ជាក់ ពី ចំណាប់អារម្មណ៍ នៅលើ ក្រាំង យ៉ាង ដូច្នេះ ថា « គណៈប្រតិភូ ក្រសួង ព័ត៌មាន សូម ថ្លែង សរសើរ ហេដ្ឋារចនាសម្ព័ន្ធ អង្គភាព Fresh News ដែល ប្រកបដោយ ផាសុកភាព មាន លក្ខណៈ កក់ក្ដៅ ជា គ្រួសារ និង ធានា ប្រសិទ្ធភាព ការងារ ។ សូម ជូនពរ លោក នាយក និង សហការី ទទួលបាន ជ័យជម្នះ ធំ ៗ ក្នុង សមរភូមិ ព័ត៌មាន » ។
សូម បញ្ជាក់ ថា នា ព្រឹក ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ រដ្ឋមន្ត្រី ក្រសួង ព័ត៌មាន លោក ខៀវ កាញារីទ្ធ អម ដំណើរ ដោយ មន្ត្រី ជាន់ ខ្ពស់ មួយចំនួន បាន អញ្ជើញ បំពេញ ទស្សនកិច្ច នៅ ទីស្នាក់ការ កណ្តាល របស់ អង្គភាព ព័ត៌មាន Fresh News ស្ថិត នៅ តាម បណ្តោយ ផ្លូវ ៥៩៨ សង្កាត់ ច្រាំង ចម្រេះ២ ខណ្ឌ ឫស្សីកែវ រាជធានី ភ្នំពេញ ។
ដំណើរ អញ្ជើញ ទស្សនកិច្ច របស់ លោក រដ្ឋមន្ត្រី នៅ ទីស្នាក់ការ កណ្តាល អង្គភាព ព័ត៌មាន Fresh News គឺជា ការផ្តល់ កិត្តិយស ដ៏ ធំធេង ក្នុង នាម ជា អាណាព្យាបាល លើ វិស័យ ព័ត៌មាន នៅ កម្ពុជា ។ វត្តមាន របស់ លោក រដ្ឋមន្ត្រី និង ថ្នាក់ដឹកនាំ ក្រសួង ត្រូវបាន ស្វាគមន៍ យ៉ាង កក់ក្តៅ ពី លោក លឹម ជា វុត្ថា ស្ថាបនិក និង ជា នាយក ប្រតិបត្តិ អង្គភាព ព័ត៌មាន Fresh News និង ថ្នាក់ដឹកនាំ ព្រមទាំង បុគ្គលិក នៅ ទីស្នាក់ការ កណ្តាល ផងដែរ ។
ក្នុង ឱកាស នេះ លោក លឹម ជា វុត្ថា បាន បង្ហាញ ក្តីរំភើប រីករាយ និង គោរព អរគុណ លោក រដ្ឋមន្ត្រី ក្នុង នាម ជា អាណាព្យាបាល លើ វិស័យ ព័ត៌មាន ដែល បាន អញ្ជើញ បំពេញ ទស្សនកិច្ច និង តែង ផ្តល់ ដំបូន្មាន និង ណែនាំ កែលម្អ តម្រង់ ទិស សម្រាប់ អង្គភាព ឱ្យ ឈរ រឹងមាំ លើ សមរភូមិ សតិអារម្មណ៍ ៕
( ពោធិ៍សាត់ )៖ លោក ម៉ៅ ធ និន អភិបាល ខេត្ត ពោធិ៍សាត់ នា ព្រឹក ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បន្ដ ប្រើប្រាស់ និង បំពេញ តួនាទី ជា អ្នកបម្រើ ប្រជាពលរដ្ឋ ដោយ ខិតខំ សម្របសម្រួល និង ដោះស្រាយ នូវ រាល់ ទំនាស់ ក៏ ដូចជា បញ្ហា ប្រឈម នានា ដែល កើតមាន ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ នៅ វេទិកា ក្នុង សាលាខេត្ត ។
កិច្ចសម្របសម្រួល ដោះស្រាយ តាមរយៈ វេទិកា សាធារណៈ ខាងលើ នេះ បាន ការចូលរួម ពី សមាជិក ក្រុមប្រឹក្សា ខេត្ត . លោកស្រី អភិបាល រង ខេត្ត . លោក លោកស្រី ប្រធាន អនុប្រធាន ការិយាល័យ ប្រជាពលរដ្ឋ . អាជ្ញាធរ ស្រុក / ក្រុង ឃុំ / សង្កាត់ . ក្រុម លេខា កត់ត្រា និង ភាគី ពាក់ព័ន្ធ ផ្សេង ទៀត ។
លោក ម៉ៅ ធ និន បាន ឲ្យដឹង ថា នេះ គឺជា ទម្លាប់ ដែល លោក តែងតែ ជួប ជាមួយ ពុក ម៉ែ ប្រជាពលរដ្ឋ ដើម្បី ចូលរួមចំណែក ជាមួយ សុខ ទុក្ខ ដោយ ផ្ទាល់ តាមរយៈ វេទិកា ដោះស្រាយ នា ពេលនេះ ។ ពីមុន លោក បាន ចូលរួម ដោះស្រាយ បញ្ហា ទាំងអស់ នោះ ចំនួន ២ដង ក្នុង មួយ សប្តាហ៍ ក៏ប៉ុន្តែ បច្ចុប្បន្ន នេះ ដោយសារតែ ជម្លោះ ក៏ ដូចជា បញ្ហា ប្រឈម កាន់តែ ថយចុះ លោក បាន ចូលរួម ដោះស្រាយ តែ ២ ឬ ៣សប្តាហ៍ មួយ ១ដង តែ ប៉ុណ្ណោះ ។
លោក អភិបាល ខេត្ត បាន គូសបញ្ជាក់ ថា ដោយសារតែ ស្ថានភាព ការរីករាលដាល ជំងឺ កូវីដ - ១៩ កំពុងតែ ដាក់ សម្ពាធ យ៉ាង ធ្ងន់ធ្ងរ នោះ លោក បាន សម្រេច ជ្រើសរើស សំណុំរឿង ណា ដែល ចាំបាច់ បំផុត ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ធ្វើ ការសម្របសម្រួល និង ដោះស្រាយ មុន គេ ជាក់ស្តែង នា ថ្ងៃ នេះ ផ្ទាល់ តែ ម្តង គឺ មាន ចំនួន ២០ ករណី ដែល កិច្ចការ នេះ ត្រូវ អនុវត្តន៍ តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ។
លោក ម៉ៅ ធ និន បាន បន្ត ថា យន្តការ ដែល លោក ម កំពុងតែ ដើរ នេះ គឺជា យន្តការ របស់ រាជ រដ្ឋាភិបាល តាមរយៈ វេទិកា សាធារណៈ ដែល បាន ចង្អុលបង្ហាញ ឲ្យ ថ្នាក់ ខេត្ត ថ្នាក់ មូលដ្ឋាន ផ្សាភ្ជាប់ សុខ ទុក្ខ ជាមួយ ប្រជាពលរដ្ឋ ដោយ ផ្ទាល់ ទៅ លើ បញ្ហា ប្រឈម និង តម្រូវការ ក្នុង ជីវភាព រស់ នៅ ប្រចាំ ថ្ងៃ ។
ជានិច្ច ជាកាល លោក តែងតែ ប្រើប្រាស់ ឋានានុក្រម២ គឺ ទី ១៖ ក្នុង នាម ជា អភិបាល ខេត្ត សម្រាប់ សម្របសម្រួល ដោះស្រាយ បញ្ហា ប្រឈម ជូន ពុក ម៉ែ ប្រជាពលរដ្ឋ ទៅ លើ ផ្លូវ ច្បាប់ និង ទី២៖ ក្នុង ឋានៈ ជា គ្រួសារ មាន តួនាទី ជាបង ជា ប្អូន ជា កូន ជា ក្មួយ និង ជា ចៅ មួយ ក្នុង គ្រួសារ ប្រជាពលរដ្ឋ ជាង ៥០ម៉ឺន នាក់ ទូទាំង ខេត្ត ដើម្បី ចូលរួម សុខ រួម ទុក្ខ ជាមួយ ពួកគាត់ គ្រប់ ពេលវេលា ។
តាមរយៈ វេទិកា សម្របសម្រួល និង ដោះស្រាយ ខាងលើ នេះ បាន ធ្វើឲ្យ ប្រជាពលរដ្ឋ គ្រប់ មជ្ឈដ្ឋាន ផ្ទុះ ការគាំទ្រ និង មាន ការសាទរ យ៉ាង ខ្លាំង ដោយឡែក ប្រជាពលរដ្ឋ ខ្លះ ក៏ ទទួលបាន អង្ករ ក៏ ដូចជា ថវិកា បន្តិចបន្តួច សម្រាប់ ជា ទ្រនាប់ ដៃ វិលត្រឡប់ ទៅ លំនៅដ្ឋាន វិញ ផងដែរ ៕
( ព្រៃវែង ) ៖ លោក ជា សុមេធី អភិបាល ខេត្ត ព្រៃវែង និង លោក ពេជ្រ ជីវ័ន អ្នកតំណាងរាស្ត្រ មណ្ឌល ព្រៃវែង នៅ ព្រឹក ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ បាន ចុះ សួរសុខទុក្ខ និង នាំយក អំណោយ របស់ សម្តេច ក្រឡាហោម ស ខេង ឧប នាយក រដ្ឋមន្ត្រី រដ្ឋមន្ត្រី ក្រសួង មហាផ្ទៃ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៤៨០ គ្រួសារ មកពី ឃុំ ចំនួន ៣ ក្នុង ស្រុក ពាម ជរ ។
លោក អភិបាល ខេត្ត បាន បន្ត ថា ថ្នាក់ដឹកនាំ គ្រប់ លំដាប់ថ្នាក់ អាជ្ញាធរ ខេត្ត ក្រុង ស្រុក ឃុំ សង្កាត់ ក្នុង ខេត្ត ព្រៃវែង តែងតែ ជួយ ឧបត្ថម្ភ ដល់ ប្រជាពលដ្ឋ ដែល ជួប ការលំបាក ជានិច្ច និង មិន ទុកឲ្យ ប្រជាពលរដ្ឋ ណា ម្នាក់ ស្លាប់ ដោយ អត់ អាហារ នោះ ទេ ។ ដោយឡែក ចំពោះ ជំងឺ កូវីដ - ១៩ ក្នុង ខេត្ត ព្រៃវែង បាន ធ្វើ ការ ផ្សព្វផ្សាយ អប់រំ អំពី វិធានការ ការពារ និង អនាម័យ ជូន ដល់ ប្រជាពលរដ្ឋ ជាប្រចាំ ហើយ រហូតមកដល់ ពេលនេះ ខេត្ត ព្រៃវែង មិន ទាន់ មាន ករណី អ្នក ឆ្លង ជំងឺ កូវីដ - ១៩ នោះ នៅឡើយ ទេ ។
លោក បាន ណែនាំ ដល់ អាជ្ញាធរ ភូមិ ឃុំ ស្រុក ទាំងអស់ ត្រូវ បន្ត អនុវត្ត ចុះ ផ្សព្វផ្សាយ អប់រំ ណែនាំ ដល់ ប្រជាពលរដ្ឋ នៅ វិធានការពារ នៃ ជំងឺ កូវីដ - ១៩ ដោយ ត្រូវ អនុវត្ត តាម ការណែនាំ របស់ ក្រសួង សុខាភិបាល ឲ្យបាន ជាប់ ជានិច្ច ដើម្បី បង្ការ ទប់ស្កាត់ ក្នុង ការរីករាយ ដែល ឆ្លង នៅក្នុង សហគមន៍ ។
អំណោយ របស់ សម្ដេច ក្រឡាហោម ស ខេង ដែល ត្រូវបាន ចែកជូន ដល់ ប្រជាពលរដ្ឋ នោះ ក្នុង មួយ គ្រួសារ ទទួលបាន អង្ករ ២៥ គីឡូក្រាម និង ថវិកា ១ម៉ឺន រៀល ផងដែរ ៕
ក្រសួង អភិវឌ្ឍន៍ ជនបទ ទទួលបាន ម៉ាស ចំនួន ៣ម៉ឺន និង ជែល ចំនួន ២ពាន់ ដប ពី ក្រុមហ៊ុន គ្រួសារ កក់ ក្ដៅ
( ភ្នំពេញ ) ៖ នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នៅ ទីស្ដីការ ក្រសួង លោក បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន រដ្ឋមន្រ្ដី ក្រសួង អភិវឌ្ឍន៍ ជនបទ បាន អនុញ្ញាតឲ្យ លោក ឧកញ៉ា អ៊ុច សម្បត្តិ ស្ថាបនិក ក្រុមហ៊ុន ក្រួសារ កក់ក្ដៅ និង ភរិយា ព្រមទាំង សហការី ចូល ជួប សម្ដែង ការគួរសម និង ធ្វើ ការប្រគល់ និង ទទួល ម៉ាស ចំនួន ៣០.០០០ ម៉ាស និង ជែល ចំនួន ២.០០០ដប ដែល ជា អំណោយ របស់ ក្រុមហ៊ុន គ្រួសារ កក់ក្ដៅ សម្រាប់ ចែកជូន មន្រ្ដី រាជការ ក្រសួង អភិវឌ្ឍន៍ ជនបទ រួមចំណែក ទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ ។
ជាមួយ នេះ ក្រសួង មាន ភារកិច្ច មួយ ទៀត គឺ ថែទាំ សុខភាព ជូន ប្រជាពលរដ្ឋ នៅ ជនបទ ដែល កំពុង ធ្វើ សកម្មភាព ចំនួន ពីរ គឺ ការងារ សម្អាត និង អនាម័យ ជនបទ ដែល ការងារ ទាំង ពីរ នេះ ត្រូវ ផ្សារភ្ជាប់ ទៅនឹង វិស័យ ផ្គត់ផ្គង់ ទឹក ដែល រាជ រដ្ឋាភិបាល បាន កំណត់ ថា នៅ ឆ្នាំ ២០២៥ ប្រជាពលរដ្ឋ នៅ ជនបទ ត្រូវ មាន ទឹក ស្អាត ប្រើប្រាស់ គ្រប់គ្រាន់ ។
លោក ឧកញ៉ា អ៊ុច សម្បត្តិ បាន ជម្រាប ជូន លោក បណ្ឌិត សភាចារ្យ អ៊ុក រ៉ាប៊ុន ថា កន្លងមក ក្រុមហ៊ុន គ្រួសារ កក់ ក្ដៅ បាន ផ្ដល់ជូន ម៉ាស ចំនួន ៥ម៉ឺន ម៉ាស ដល់ រាជ រដ្ឋាភិបាល ផងដែរ ហើយក៏ បាន រួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការទិញ វ៉ាក់សាំង ការពា ជំងឺ កូវីដ១៩ ចំនួន ១ម៉ឺន ដុល្លារ ។ ជាមួយ នេះ ក្រុមហ៊ុន របស់ លោក ក៏ បាន ជួយ ដល់ ប្រជាពលរដ្ឋ ដែល រង ផល ប៉ះពាល់ ដោយសារ ទឹក ជំនន់ បាន មួយចំនួន ធំ នៅ ខេត្ត កំពង់ស្ពឺ ពោធិ៍សាត់ និង ខេត្ត កំពង់ឆ្នាំង ផងដែរ ។
លោក បណ្ឌិត សភាចារ្យ រដ្ឋមន្រ្ដី បាន ថែ្លងអំណរគុណ យ៉ាង ជ្រាលជ្រៅ ជូន ចំពោះ ក្រុមហ៊ុន គ្រួសារ កក់ក្ដៅ ដែល បាន ផ្ដល់ ម៉ាស និង ជែល ដល់ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ជា ការរួមចំណែក ជាមួយ រាជ រដ្ឋាភិបាល ក្នុង ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ ១៩៕ សមាគម ស្បែកជើង កម្ពុជា បរិច្ចាគ ថវិកា ៣៤.៨០០ ដុល្លារ ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ ឧកញ៉ា លី ឃុន ថៃ ប្រធាន សមាគម ស្បែកជើង កម្ពុជា នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន នាំយក ថវិកា ដែល បាន មក ពី ការចូលរួម របស់ សមាជិក សមាជិកា សមាគម ស្បែកជើង កម្ពុជា ចំនួន ៣៤.៨០០ ដុល្លារ អាមេរិក ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង ប្រឆាំង មេរោគ កូវីដ១៩ ។
ឧកញ៉ា លី ឃុន ថៃ និង ក្រុមគ្រួសារ កាលពី ថ្ងៃទី ៩ ខែធ្នូ ឆ្នាំ ២០២០ ក៏ បាន បរិច្ចាគ ថវិកា ២ម៉ឺន ដុល្លារ អាមេរិក ជូន សម្តេច តេជោ ហ៊ុន សែន ដើម្បី ទិញ វ៉ាក់សាំង ប្រឆាំង មេរោគ កូវីដ១៩ សម្រាប់ ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ផងដែរ ៕
លោក លី ស៊ុគ្រី នឹង ក្លាយជា តំណាងរាស្រ្ត ថ្មី មណ្ឌល តាកែវ ជំនួស លោក សុខ សូកាន ខណៈ លោក សៅ សារ៉ាត់ នឹង ក្លាយជា តំណាងរាស្រ្ត ថ្មី មណ្ឌល ប៉ៃលិន ជំនួស លោកស្រី បាន ស្រី មុំ
( ភ្នំពេញ ) ៖ លោក លី ស៊ុគ្រី នឹង ក្លាយជា តំណាងរាស្រ្ត ថ្មី មណ្ឌល តាកែវ ជំនួស លោក សុខ សូកាន ខណៈ លោក សៅ សារ៉ាត់ នឹង ក្លាយជា តំណាងរាស្រ្ត ថ្មី មណ្ឌល ប៉ៃលិន ជំនួស លោកស្រី បាន ស្រី មុំ បន្ទាប់ពី អតីត តំណាងរាស្ត្រ ទាំង ពីរ រូប សម្រេច លា លែង ពី តំណែង ។ នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន របស់ អគ្គ លេខាធិការដ្ឋាន រដ្ឋសភា ដែល បណ្តាញ ព័ត៌មាន Fresh News ទទួលបាន ។
ការសម្រេច ខាងលើ នេះ ត្រូវបាន បង្ហាញ ឡើង នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ ក្នុង ឱកាស គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា នៃ កម្ពុជា បើក កិច្ចប្រជុំ ក្រោម អធិបតីភាព សម្ដេច អគ្គ មហា ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា ។
សេចក្តីប្រកាស ព័ត៌មាន ដដែល បាន ឲ្យដឹង ថា អង្គប្រជុំ បាន ធ្វើ ការពិភាក្សា និង អនុម័ត តាម របៀបវារៈ ដោយ មាន លទ្ធផល ដូច ខាងក្រោម៖
១៖ អង្គប្រជុំ បាន អនុម័ត ទទួលស្គា ល់៖
២៖ អង្គប្រជុំ បាន អនុម័ត សំណើ សុំ ជ្រើសតាំង តំណាងរាស្រ្ត នៃ គណបក្ស ប្រជាជន កម្ពុជា ដើម្បី ដាក់ ជូន សម័យ ប្រជុំ រដ្ឋសភា នា ពេល ខាងមុខ បោះឆ្នោត ផ្តល់ សេចក្តីទុកចិត្ត លើ សមាសភាព ដូច ខាងក្រោម៖
* លោក ខៀវ ភារិទ្ធ ជា សមាជិក គណៈកម្មការ អប់រំ យុវជន កីឡា ធម្មការ កិច្ចការ សាសនា វប្បធម៌ និង ទេសចរណ៍ នៃ រដ្ឋសភា * លោកស្រី នូ សុវណ្ណ នី ជា សមាជិក គណៈកម្មការ សាធារណការ ដឹកជញ្ជូន ទូរគមនាគមន៍ ប្រៃសណីយ៍ ឧស្សាហកម្ម រ៉ែ ថាមពល ពាណិជ្ជកម្ម រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ នៃ រដ្ឋសភា ។
៣៖ អង្គប្រជុំ បាន អនុម័ត កាលបរិច្ឆេទ បន្ត សម័យ ប្រជុំ រដ្ឋសភា លើក ទី៥ នីតិកាល ទី៦ នៅ ព្រឹក ថ្ងៃអង្គារ ទី ២៩ ខែធ្នូ ឆ្នាំ ២០២០ ដោយ មាន របៀបវារៈ ដូច ខាងក្រោម៖
* ការសម្រេច អំពី សុពលភាព នៃ អាណត្តិ៖ - លោក លី ស៊ុគ្រី ជា តំណាងរាស្រ្ត មណ្ឌល តាកែវ - លោក សៅ សារ៉ាត់ ជា តំណាងរាស្រ្ត មណ្ឌល ប៉ៃលិន
សូម បញ្ជាក់ ថា លោក សុខ សូកាន ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា រដ្ឋលេខាធិការ ក្រសួង ការបរទេស និង សហប្រតិបត្តិការ អន្តរជាតិ ខណៈ លោកស្រី បាន ស្រី មុំ ត្រូវបាន ព្រះមហាក្សត្រ ត្រាស់បង្គាប់ តែងតាំង ជា អភិបាល ខេត្ត ប៉ៃលិន ។ ការតែងតាំង នេះ បាន ធ្វើឡើង បន្ទាប់ពី មាន សំណើ ទួល ថ្វាយ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ៕
លោក លី ស៊ុគ្រី លោក សៅ សារ៉ាត់ ចាប់ខ្លួន ជនជាតិ ចិន ម្នាក់ នៅ ក្រុង ព្រះសីហនុ ពាក់ព័ន្ធ ការកាន់កាប់អាវុធ ដោយ ខុស ច្បាប់
( ព្រះសីហនុ) ៖ ជនជាតិ ចិន ម្នាក់ ត្រូវបាន កម្លាំង នគរបាល ខេត្ត ព្រះសីហនុ ចាប់ខ្លួន ពាក់ព័ន្ធ ការកាន់កាប់អាវុធ ដោយ ខុស ច្បាប់ នៅ ចំណុច ផ្លូវ ពយ កំពេញ ចាស់ ស្ថិត នៅ ភូមិ១ សង្កាត់ ៣ ក្រុង ព្រះសីហនុ ។
បន្ទាប់ពី ទទួលបាន ព័ត៌មាន កម្លាំង ជំនាញ ផែនការងារ នគរបាល ព្រហ្មទណ្ឌ បាន សហការ ជាមួយ កម្លាំង ប៉ុស្តិ៍ នគរបាល រដ្ឋបាល សង្កាត់ ៣ ចុះ ទៅដល់ កន្លែង ទីតាំង ខាងលើ រួច ធ្វើ ការត្រួតពិនិត្យ រថយន្ត ជា លទ្ធផល ឃើញ មាន ជនជាតិ ចិន ម្នាក់ និង រកឃើញ មាន អាវុធ ខ្លី១ ដើម ម៉ាក SIGSAUER ពណ៌ ខ្មៅ បង់ កាំភ្លើង ១ មាន គ្រាប់ ៩គ្រាប់ ។ បន្ទាប់មក សមត្ថកិច្ច បាន ឃាត់ខ្លួន ជនជាតិ ចិន ម្នាក់ នោះ មកកាន់ ស្នងការដ្ឋាន នគរបាល ខេត្ត ដើម្បី សួរនាំ ។
( ភ្នំពេញ ) ៖ នៅ ព្រឹក ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ក្រសួង ការពារ ជាតិ បាន បើក កិច្ចប្រជុំ ការងារ កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ស្ថិត ក្រោម អធិបតីភាព នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន រដ្ឋលេខាធិការ ក្រសួង ការពារ ជាតិ សមាជិក គណៈកម្មាការ ជាតិ កែទម្រង់ និង ជា ប្រធាន ក្រុមការងារ កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ក្រសួង ការពារ ជាតិ ។
ថ្លែង នៅក្នុង កិច្ចប្រជុំ នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន បាន លើកឡើង អំពី ដំណើរការ អនុវត្ត ការកែទម្រង់ គ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ឆ្នាំ ២០២០ និង ទិសដៅ ឆ្នាំ ២០២១ របស់ ក្រសួង ការពារ ជាតិ ។
លោក បាន បញ្ជាក់ ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន ជា នាយក រដ្ឋមន្ត្រី រាជ រដ្ឋាភិបាល បាន ផ្តល់ នូវ ថវិកា សម្រាប់ សម្រួល ទៅ តាម តម្រូវការ របស់ ក្រសួង ការពារ ជាតិ ដើម្បី ធានា នូវ សុខភាព ដល់ ខ. ភ. ម ក្នុង ការហ្វឹកហ្វឺន បង្កើន សមត្ថភាព សម្រាប់ ការបំពេញ ភារកិច្ចការពារ សន្តិសុខ សុវត្ថិភាព ជូន ប្រជាពលរដ្ឋ និង ការពារ អធិបតេយ្យ បូរណភាព ទឹកដី ឲ្យបាន គង់វង្ស ។
នាយ ឧត្តមសេនីយ៍ ម៉ឹង សំផន បាន បញ្ចាក់ ទៀត ថា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ក្រសួង ការពារ ជាតិ បាន អនុវត្ត ទទួលបាន ជោគជ័យ លើ ការកែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ឆ្នាំ ២០២០ ហើយ កងទ័ព បាន ទទួល ការយកចិត្តទុកដាក់ គិត គូរ ខ្ពស់ ពី ប្រមុខ រាជ រដ្ឋាភិបាល លើ ជីភាព រស់ នៅ ប្រចាំ ថ្ងៃ និង ការកសាង អង្គភាព ជំរុំ ជំរក ស្នាក់ ថែម ទៀត ។
ក្នុង កិច្ចប្រជុំ នោះ លោកស្រី ភឿង ស កុណា ក៏ បាន បញ្ជាក់ ថា « ក្រសួង វប្បធម៌ កំពុង សហការ ជាមួយ អ្នកជំនាញ ការជាតិ និង អន្តរជាតិ ដើម្បី រៀបចំ ឯកសារ ដាក់បញ្ចូល ប្រាសាទ កោះ កេរ ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក ហើយ នឹង ដាក់ ជូន គណៈកម្មាធិការ បេតិកភណ្ឌ ពិភពលោក ពិនិត្យ និង សម្រេច ក្នុង ពេល ឆាប់ ៗ ខាងមុខ នេះ » ។
គេ នៅ ចាំ បាន ថា កាលពី ឆ្នាំ ២០១៨ កម្ពុជា បាន ចុះសិក្សា ស្រាវជ្រាវ នៅ តំបន់ ប្រាសាទ កោះ កេរ ខេត្ត ព្រះវិហារ និង ប្រាសាទ បន្ទាយ ឆ្មារ ខេត្ត បន្ទាយមានជ័យ ដើម្បី ស្នើ ដាក់ ប្រាសាទ ខ្មែរ ទាំង ពីរ នេះ ទៅក្នុង បញ្ជីសម្បត្តិ បេតិកភណ្ឌ ពិភពលោក បន្ទាប់ពី ប្រាសាទ អង្គរវត្ត បាន ចុះបញ្ជី ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក នៅ ឆ្នាំ ១៩៩២ ប្រាសាទ ព្រះវិហារ នៅ ឆ្នាំ ២០០៨ និង តំបន់ ប្រាសាទ សំបូរ ព្រៃ គុក នៅ ឆ្នាំ ២០១៧ ។
សូម ជម្រាប ថា ប្រាសាទ កោះ កេរ មាន ទីតាំង ស្ថិត នៅក្នុង ភូមិ ស្រយ៉ង់ ជើង ឃុំ ស្រយ៉ង់ ស្រុក គូលេន ខេត្ត ព្រះវិហារ មាន ចម្ងាយ ប្រមាណ ៧២ គីឡូម៉ែត្រ ពី ទី រួម ខេត្ត សៀមរាប បើ ធ្វើដំណើរ តាម ផ្លូវ លេខ ២១១ ហើយ បើ ធ្វើដំណើរ ពី ទី រួម ខេត្ត ព្រះវិហារ មាន ចម្ងាយ ៤៩ គីឡូម៉ែត្រ ប៉ុណ្ណោះ ។
គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា បើក កិច្ចប្រជុំ កំណត់ ថ្ងៃ បោះឆ្នោត ប្រកាស សុពលភាព សមាជិក រដ្ឋសភា ថ្មី (Video inside) ( ភ្នំពេញ ) ៖ សម្តេច ពញា ចក្រី ហេង សំរិន ប្រធាន រដ្ឋសភា នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា បើក កិច្ចប្រជុំ ពិភាក្សា កំណត់ ថ្ងៃ បើក សម័យ ប្រជុំ ពេញ អង្គ រដ្ឋសភា ដើម្បី ប្រកាស សុពលភាព សមាជិក សភា ថ្មី ។
របៀបវារៈ កិច្ចប្រជុំ អចិន្ត្រៃយ៍ នេះ រួម មាន៖
២៖ ការពិនិត្យ សំណើ សុំ ជ្រើសតាំង៖ លោក ខៀវ ភារិទ្ធ ជា សមាជិក គណៈកម្មការ អប់រំ យុវជន កីឡា ធម្មការ កិច្ចការ សាសនា វប្បធម៌ និង ទេសចរណ៍ ។ លោកស្រី នូ សុវណ្ណ នី ជា សមាជិក គណៈកម្មការ សាធារណការ ដឹកជញ្ជូន ទូរគមនាគមន៍ ប្រៃសណីយ៍ ឧស្សាហកម្ម រ៉ែ ថាមពល ពាណិជ្ជកម្ម រៀបចំ ដែនដី នគរូបនីយកម្ម និង សំណង់ ។ ( យោង លិខិត លេខ ០២៧ / ១២២០ / ល គ . គក ចុះ ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២០ របស់ គណបក្ស ប្រជាជន កម្ពុជា )
គួរ បញ្ជាក់ ថា ការបញ្ជាក់ របស់ សិង្ហបុរី ខាងលើ នេះ បាន កើត មាន ឡើង ស្រប ពេល ដែល ទម្រង់ ថ្មី មួយ ផ្សេង ទៀត ( ទម្រង់ ថ្មី ទី២ ) នៃ វីរុស កូរ៉ូណា (COVID-19) ត្រូវបាន រកឃើញ នៅក្នុង ចក្រភព អង់គ្លេស ដោយ មាន ជាប់ពាក់ព័ន្ធ នឹង អ្នកដំណើរ ពីរ នាក់ មកពី ប្រទេស អាហ្វ្រិក ខាងត្បូង ។ អាជ្ញាធរ សុខាភិបាល អង់គ្លេស កំពុង បន្ត តាមដាន វីរុស ទម្រង់ ថ្មី ទី ពីរ នេះ យ៉ាង ល្អិតល្អន់ បំផុត ៕
ក្នុង សេចក្ដីណែនាំ បន្ថែម នេះ បាន អះអាង ថា បន្ទាប់ពី រោងចក្រ - សហគ្រាស និង អាជីវកម្ម ក្នុង វិស័យ កាត់ដេរ - វាយន ភណ្ឌ . ស្បែកជើង . ផលិតផល ធ្វើដំណើរ . កាបូប និង វិស័យ ទេសចរណ៍ ទទួលបាន លិខិត អនុញ្ញាតឲ្យ ព្យួរ កិច្ចសន្យា ការងារ និង / ឬ លិខិត អនុញ្ញាតឲ្យ ពន្យារ ការព្យួរ កិច្ចសន្យា ការងារ ពី ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ ក្រោយពី បាន បំពេញ តាម លក្ខណៈ វិនិច្ឆ័យ និង លក្ខខណ្ឌ នៃ ការព្យួរ កិច្ចសន្យា ការងារ រាជ រដ្ឋាភិបាល កម្ពុជា នឹង៖
* បន្ត ផ្ដល់ ប្រាក់ ឧបត្ថម្ភ ៤០ ដុល្លារ ក្នុង មួយ ខែ ជូន កម្មករ - និយោជិត ម្នាក់ ដែល បំពេញ ការងារ ក្នុង វិស័យ ទេសចរណ៍ ដូច ជា៖ សណ្ឋាគារ . ផ្ទះសំណាក់ . ភោជនីយដ្ឋាន និង ភ្នាក់ងារ ទេសចរណ៍ សម្រាប់ រយៈពេល ០៣ ខែ បន្ថែម ទៀត ពី ខែមករា ដល់ ខែមីនា ឆ្នាំ ២០២១ ។ សហគ្រាស និង អាជីវកម្ម ក្នុង វិស័យ ទេសចរណ៍ ត្រូវ រួមចំណែក តាម គោលការណ៍ ស្ម័គ្រចិត្ត និង តាម លទ្ធភាព ជាក់ស្តែង បន្ថែម លើ អ្វី ដែល រាជ រដ្ឋាភិបាល បាន ផ្តល់ ជូន ។
* បន្ត ពន្យារ ការចាប់ផ្តើម អនុវត្ត របប សន្តិសុខ សង្គម ផ្នែក សោធន រយៈពេល ០៦ ខែ បន្ត ទៀត គឺ រហូតដល់ ខែកក្កដា ឆ្នាំ ២០២១ ។ ការពន្យារ ពេលនេះ នឹង ត្រូវ ផ្អែក លើ ការវាយតម្លៃ ជា បន្តបន្ទាប់ នូវ ស្ថានភាព សង្គម - សេដ្ឋកិច្ច ជាក់ស្តែង ។
