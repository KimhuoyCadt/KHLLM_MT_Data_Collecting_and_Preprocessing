( ភ្នំពេញ ) ៖ យ៉ាងហោចណាស់ មាន ជនសង្ស័យ ៦២ នាក់ ត្រូវបាន សមត្ថកិច្ច ឃាត់ខ្លួន ក្នុង បទល្មើស ព្រហ្មទណ្ឌ និង បទល្មើស គ្រឿងញៀន នៅ ទូទាំង ប្រទេស កម្ពុជា នា ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ ម្សិលមិញ នេះ ។ នេះ បើ តាម ការបញ្ជាក់ របស់ នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ អ្នកនាំពាក្យ ក្រសួង មហាផ្ទៃ ប្រាប់ ដល់ បណ្តាញ ព័ត៌មាន Fresh News ឱ្យដឹង នៅ ព្រឹក ថ្ងៃទី ២៥ ខែធ្នូ នេះ ។
នាយ ឧត្តមសេនីយ៍ ខៀវ សុភ័គ បាន បញ្ជាក់ បន្ថែម ថា ក្នុង ចំណោម ជនសង្ស័យ ទាំង ៦២ នាក់ នោះ មាន ១៦នាក់ ត្រូវបាន ឃាត់ខ្លួន នៅក្នុង បទល្មើស ព្រហ្មទណ្ឌ ១២ករណី និង ជនសង្ស័យ ៤៦ នាក់ ត្រូវបាន ឃាត់ខ្លួន ក្នុង បទល្មើស គ្រឿងញៀន ១៤ករណី ។
អ្នក ជាសះស្បើយ ទាំង ៣នាក់ ជា អ្នកជំងឺ ដែល ឆ្លង ក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២៨វិច្ឆិកា » រួម មាន៖
១៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២៨ ឆ្នាំ ស្នាក់ នៅ ភូមិ ម៉ាក់ ក្លឿង សង្កាត់ ច្បារអំពៅ១ ខណ្ឌ ច្បារអំពៅ រាជធានី ភ្នំពេញ ជា បុគ្គលិក ហាង Pedro ផ្លូវ ព្រះសីហនុ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ។
២៖ បុរស ជនជាតិ ខ្មែរ អាយុ ២៧ ឆ្នាំ ស្នាក់ នៅ បឹង ទំពន់ ខណ្ឌ មានជ័យ រាជធានី ភ្នំពេញ ជា អ្នកចូល ហាង Pedro ផ្លូវ ព្រះសីហនុ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ។ ៣៖ ស្ត្រី ជនជាតិ ខ្មែរ អាយុ ២៦ ឆ្នាំ ស្នាក់ នៅ ខណ្ឌ ដូនពេញ រាជធានី ភ្នំពេញ ជា មិត្តភក្តិ របស់ បុរស ជនជាតិ ខ្មែរ អាយុ ៣៥ ឆ្នាំ ដែល បាន រកឃើញ វិជ្ជមាន កូវីដ១៩ នៅ ថ្ងៃទី ០៨ ខែធ្នូ ឆ្នាំ ២០២០ ត្រូវបាន ព្យាបាល ជាសះស្បើយ ។
សូម ជម្រាប ថា គិត ត្រឹម ម៉ោង ៧៖០០ នាទី ព្រឹក ថ្ងៃទី ២៥ ខែធ្នូ ឆ្នាំ ២០២០ នេះ នៅ កម្ពុជា បាន រកឃើញ អ្នក ឆ្លង កូវីដ១៩ សរុប ចំនួន ៣៦៣ នាក់ ក្នុង នោះ ព្យាបាល ជាសះស្បើយ ចំនួន ៣៥៤ នាក់ និង អ្នកជំងឺ ៩នាក់ កំពុង សម្រាក នៅ មន្ទីរពេទ្យ វិញ ។ សម្រាប់ អ្នក ឆ្លង ក្នុង ព្រឹត្តិការណ៍ « សហគមន៍ ២៨វិច្ឆិកា » វិញ មាន ចំនួន សរុប ៤១ នាក់ ក្នុង ព្យាបាល ជាសះស្បើយ ចំនួន ៣៦ នាក់ និង កំពុង សម្រាក ព្យាបាល នៅ មន្ទីរពេទ្យ ចំនួន ៥នាក់ ៕
អំណោយ ជា សម្ភារ បរិក្ខារ ពេទ្យ ប្រយុទ្ធ នឹង ជំងឺ កូវីដ របស់ លោក ហ៊ុន ម៉ានី ត្រូវបាន ប្រគល់ ជូន មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត
( ភ្នំពេញ ) ៖ លោក បណ្ឌិត ហេង សុខ គង់ ប្រធាន សម្ពន្ធ័ គ្រូពេទ្យ សហភាព សហពន្ធ័យុវជន កម្ពុជា និង សហការី បាន នាំយក បរិក្ខារ ពេទ្យ ដែល ជា អំណោយ របស់ លោក ហ៊ុន ម៉ានី ប្រធាន សហភាព សហព័ន្ធ យុវជន កម្ពុជា និង លោកស្រី យឹម ឆៃលីន ប្រគល់ ជូន ទៅ មន្ទីរពេទ្យ មិត្តភាព កម្ពុជា - សូវៀត ដើម្បី ចូលរួមចំណែក ជាមួយ ក្រុម គ្រូពេទ្យ ក្នុង ការការពារ និង ព្យាបាល ជំងឺ កូវីដ១៩ ។
ក្នុង ឱកាស នោះ លោក បណ្ឌិត ហេង សុខ គង់ បាន ពាំនាំ បណ្តាំ សួរសុខទុក្ខ និង ការថ្លែងអំណរគុណ ពីសំណាក់ ហ៊ុន ម៉ានី និង លោកស្រី ជូន ដល់ ក្រុម ទាហាន អាវ ស ដែល បាន ធ្វើ ពលិកម្ម មិន ខ្លាច ការនឿយហត់ សុខចិត្ត ឃ្លាត ឆ្ងាយ ពី ក្រុមគ្រួសារ ដើម្បី មក ប្រឈមមុខ នឹង ជំងឺ ដ៏ កាច សាហាវ កូវីដ១៩ ។
លើស ពី នោះ លោក ក៏ បាន ធ្វើ ការកោតសរសើរ ដោយ ស្មោះ ពី សមត្ថភាព នៃ ក្រុម គ្រូពេទ្យ ជួរ មុខ យើង ដែល បាន ព្យាបាល អ្នកជំងឺ កូវីដ១៩ ដោយ មិន មាន ការរើសអើង ជាតិ សាសន៍ ឬ ពណ៌ សម្បុរ ឲ្យបាន ជាសះស្បើយ ជា បន្តបន្ទាប់ ដោយ មិន មាន ការស្លាប់ បាត់បង់ជីវិត អ្នកជំងឺ ណា ម្នាក់ ជាពិសេស ក្រុម គ្រូពេទ្យ បាន ប្តេជ្ញាចិត្ត អនុវត្ត ដោយ ជោគជ័យ នូវ អនុសាសន៍ ប្រកបដោយ គតិបណ្ឌិត របស់ សម្តេច តេជោ នាយក រដ្ឋមន្ត្រី ជា បន្តបន្ទាប់ ផងដែរ ។
ជា ការឆ្លើយតប លោក វេជ្ជបណ្ឌិត ងី ម៉េង ប្រធាន មន្ទីរពេទ្យ មិត្តភាព ខ្មែរ - សូវៀត បាន ផ្តាំផ្ញើរការថ្លែងអំណរគុណ លោក ហ៊ុន ម៉ានី និង លោកស្រី ដែល ជានិច្ចកាល បាន ឧបត្ថម្ភ គាំទ្រ និង គិតគូរ ពី សុខ ទុក្ខ របស់ ក្រុម គ្រូពេទ្យ យើង ហើយ លោក វេជ្ជបណ្ឌិត សន្យា នឹង យក អំណោយ នេះ ប្រើប្រាស់ ឲ្យបាន ចំ ទិសដៅ និង ខិតខំ បន្ត ទៀត ក្នុង បុព្វហេតុ សុខភាព របស់ ប្រជាពលរដ្ឋ យើង ក៏ ដូចជា ការពិនិត្យ និង ព្យាបាល ជំងឺ កូវីដ១៩ ឲ្យ អស់ ពី សមត្ថភាព ៕
ពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា ជន ពិការ កុមារ កំព្រា ចំនួន ១៥០ គ្រួសារ នៅ ស្រុក កោះ ញែក ទទួលបាន អំណោយ ពី អភិបាល ខេត្ត មណ្ឌលគិរី
( មណ្ឌលគិរី ) ៖ ដើម្បី ជួយ ដោះស្រាយ នូវ ការខ្វះខាត របស់ ប្រជាពលរដ្ឋ ដែល កំពុង ជួប ការខ្វះខាត ខណៈ ដែល ប្រទេស កម្ពុជា កំពុង រាតត្បាល នៃ ជំងឺ កូវីដ - ១៩ នា រសៀល ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ លោក ស្វាយ សំអ៊ាង អភិបាល ខេត្ត មណ្ឌលគិរី បាន អញ្ជើញ ជួប សំណេះសំណាល និង នាំយក អំណោយ ជា គ្រឿង ឧបភោគ បរិភោគ និង សម្ភារ ប្រើប្រាស់ មួយចំនួន ផ្តល់ ជូន ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា ជន ពិការ កុមារ កំព្រា ចំនួន ១៥០ គ្រួសារ ស្មើនឹង ៥ឃុំ ស្ថិត នៅ ស្រុក កោះ ញែក ។
ថ្លែង ក្នុង ឱកាស នោះ លោក ស្វាយ សំអ៊ាង បាន នាំ ការផ្តាំផ្ញើ សាកសួរ សុខទុក្ខ និង ក្តី នឹករលឹក ពីសំណាក់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្រ្តី នៃ កម្ពុជា និង សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ដែល ជានិច្ចកាល តែងតែ យកចិត្តទុកដាក់ និង គិតគូរ ចំពោះ ប្រជាពលរដ្ឋ ទូទៅ ពិសេស ប្រជាពលរដ្ឋ ក្រីក្រ ជន ចាស់ជរា ស្ត្រី មេម៉ាយ កុមារ កំព្រា ជន ពិការ និង គ្រួសារ ដែល មាន ទុក្ខលំបាក់ ផ្សេង ៗ ដោយ មិន ប្រកាន់ និន្នាការ នយោបាយ អ្វី ឡើយ ។
លោក អភិបាល ខេត្ត បន្ថែម ថា ការនាំយក អំណោយ ផ្តល់ ជូន ពលរដ្ឋ រងគ្រោះ នា ពេលនេះ គឺជា ការចូលរួមចំណែក ដោះស្រាយ នូវ ការខ្វះខាត របស់ ពលរដ្ឋ បាន មួយ កម្រិត ជាពិសេស ដើម្បីឲ្យ ពួកគាត់ មាន លទ្ធភាព ក្នុង ការបង្កបង្កើន ផល និង ប្រកប មុខរបរ ផ្សេង ៗ បន្ថែម ទៀត ។
តាម ការបញ្ជាក់ ពី ប្រធាន មន្ទីរ សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនិតី សម្បទា ខេត្ត មណ្ឌលគិរី លោក ខឹម សុផុន បាន ឲ្យដឹង ថា ប្រជាពលរដ្ឋ រងគ្រោះ ចំនួន ១៥០ គ្រួសារ ស្មើនឹង ៥ឃុំ ក្នុង ស្រុក កោះ ញែក នា ពេលនេះ ដោយ ក្នុង មួយ គ្រួសារ ទទួលបាន អំណោយ រួម មាន៖ អង្ករ ១៥គីឡូក្រាម កន្ទេល១ ភួយ១ ត្រីខ ១យួរ ទឹកត្រី ៤ដប ។
ដោយឡែក លោកស្រី យាន ឌីណា ភរិយា អភិបាល ខេត្ត និង ជា ប្រធាន សាខា សមាគម កាយ ឬទ្ធិ នារី កម្ពុជា ខេត្ត បាន ឧបត្ថម្ភ ក្នុង មួយ គ្រួសារ ២ម៉ឺន រៀល និង សម្ពន្ធ យុវជន ស្រលាញ់ សន្តិភាព ខេត្ត បាន ឧបត្ថម្ភ អាវ រងា ចំនួន ១៥០ អាវ ផងដែរ ៕
នាយក រដ្ឋមន្ត្រី ថៃ លោក ប្រាយុទ្ធ ចាន់ អូចា បាន មានប្រសាសន៍ នៅក្នុង សុន្ទរកថា មួយ ដែល ផ្សាយ ផ្ទាល់ តាម ទូរទស្សន៍ ជាតិ នៅ ថ្ងៃ នេះ យ៉ាង ដូច្នេះ ថា « ខ្ញុំ អាច ធានា បាន ថា រដ្ឋាភិបាល នឹង ធ្វើឲ្យ បាន ល្អ បំផុត ។ ក្រសួង សុខាភិបាល បញ្ជាក់ ប្រាប់ ខ្ញុំ ថា ស្ថានការណ៍ បច្ចុប្បន្ន វា នឹង អាច គ្រប់គ្រង បាន ប្រសិនបើ មនុស្ស គ្រប់ គ្នា ព្រម ចូលរួម សហការ » ។
ក្រុមការងារ យុវជន និង ពលរដ្ឋ ខ្មែរ រស់នៅ ទ្វីប អឺរ៉ុប បរិចា្ចគ ៦១. ៨៦៦ ដុល្លារ អាមេរិក ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ - ១៩
( អឺរ៉ុប ) ៖ ក្រុមការងារ យុវជន និង ប្រជាពលរដ្ឋ ខ្មែរ ដែល កំពុង រស់ នៅ តាម បណ្ដា ប្រទេស និង តំបន់ ក្នុង ទ្វីប អឺរ៉ុប ដូចជា បារាំង អង់គ្លេស អាល្លឺម៉ង់ ស្វីស ប៊ែលហ្សិក និង ហូឡង់ បាន បរិចា្ចគ ថវិកា ចំនួន ៦១. ៨៦៦ ដុល្លារ អាមេរិក តាមរយៈ ឯកឧត្តម ហ៊ុន ម៉ាណែត ដើម្បី ប្រគល់ ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង កូវីដ - ១៩ ។
ការចូលរួម បរិច្ចាគ នេះ បាន ធ្វើឡើង បន្ទាប់ពី សម្តេច តេជោ ហ៊ុន សែន ប្រកាស ពី ការត្រៀម ថវិកា ទិញ វ៉ាក់សាំង កូវីដ - ១៩ មក ចាក់ ជូន ប្រជាពលរដ្ឋ ដោយ ឥត គិត ថ្លៃ ស្រប ពេល ដែល ជំងឺ នេះ បាន ឆ្លង ចូល ដល់ សហគមន៍ កម្ពុជា ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕
សង្ខេប ព្រឹត្តិការណ៍ ព័ត៌មាន សំខាន់ ៗ ប្រចាំ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០
១៖ ថ្ងៃ នេះ ក្រសួង សុខាភិបាល បន្ត ប្រកាស ថា មិន មាន ករណី ឆ្លង កូវីដ១៩ ថ្មី នោះ ទេ ខណៈ អ្នកជំងឺ ចំនួន ២នាក់ ថែម ទៀត បាន ជាសះស្បើយ
៣៖ របាយការណ៍៖ កម្ពុជា ជាប់ ចំណាត់ថ្នាក់ លេខ ១ លើ ពិភពលោក ក្នុង ការគ្រប់គ្រង កូវីដ - ១៩ បាន ល្អ ជាង គេ
៤៖ រដ្ឋមន្ត្រី សុខាភិបាល អង់គ្លេស៖ « ទម្រង់ ថ្មី មួយ ទៀត នៃ វីរុស កូវីដ - ១៩ ត្រូវបាន រកឃើញ លើ អ្នកដំណើរ មកពី ប្រទេស អាហ្វ្រិក ខាងត្បូង »
៥៖ សម្ដេច តេជោ ហ៊ុន សែន សម្រេច បន្ត អនុវត្ត « កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង អំឡុង ពេល ប្រយុទ្ធ នឹង ជំងឺ កូវីដ - ១៩ » ជុំ ទី៤ ចំនួន ៣ខែ ទៀត
៦៖ សិង្ហបុរីរកឃើញ មនុស្ស ម្នាក់ មាន ផ្ទុក វីរុស កូវីដ - ១៩ទម្រង់ ថ្មី ក្រោយ ត្រលប់ មកពី ចក្រភព អង់គ្លេស
៧៖ រាជ រដ្ឋាភិបាល ចេញ សេចក្ដីណែនាំ និង វិធានការ បន្ថែម ដើម្បី គ្រប់គ្រង ផល ប៉ះពាល់ លើ វិស័យ សំខាន់ ៗ នៃ សេដ្ឋកិច្ច និង ការស្ដារ ឡើងវិញ ក្រោយ វិបត្តិ ជំងឺ កូវីដ១៩ ( ជុំ ទី៧)
៩៖ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច បន្ត លើកលែង ពន្ធ ប្រថាប់ ត្រា សម្រាប់ អ្នកទិញ ផ្ទះ តម្លៃ ក្រោម ៧ម៉ឺន ដុល្លារ រហូតដល់ ដំណាច់ ឆ្នាំ ២០២១
១០៖ អង់គ្លេស បិទ ជើងហោះហើរ មកពី អាហ្វ្រិក ខាងត្បូង ក្រោយ រកឃើញ កូវីដ - ១៩ ទម្រង់ ថ្មី ទី២
១១៖ កម្ពុជា កំពុង រៀបចំ ឯកសារ ស្នើ ដាក់បញ្ចូល « ប្រាសាទ កោះ កេរ » ជា សម្បត្តិ បេតិកភណ្ឌ ពិភពលោក
១៣៖ អតីត នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក អាបេ អាចនឹង ត្រូវ កោះហៅ ឲ្យ បង្ហាញ ខ្លួន ក្នុង សភា ពាក់ព័ន្ធ ការចោទប្រកាន់ មួយចំនួន
១៤៖ រាជ រដ្ឋាភិបាល បន្ត ផ្តល់ ប្រាក់ ឧបត្ថម្ភ ដល់ កម្មករ ក្នុង វិស័យ កាត់ដេរ - វាយន ភណ្ឌ . ស្បែកជើង . ផលិតផល ធ្វើដំណើរ កាបូប និង វិស័យ ទេសចរណ៍ ៣ខែ បន្ថែម ទៀត
១៦៖ រាជ រដ្ឋាភិបាល កម្ពុជា សម្រេច បន្ធូរបន្ថយ ការអនុវត្ត ពន្ធ កាត់ទុក លើ ការប្រាក់ សម្រាប់ អ្នក ផ្ដល់ កម្ចី ក្នុង ស្រុក និង ក្រៅ ស្រុក
១៨៖ រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ លើ នាយក ប្រតិបត្តិ អង្គភាព ព័ត៌មាន Fresh News ថា បាន រៀបចំ ទីស្នាក់ការ កណ្ដាល ថ្មី ប្រកបដោយ ផាសុកភាព និង យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ បុគ្គលិក គ្រប់ គ្នា
២០៖ សម្ដេច កិត្ដិ ព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន អញ្ជើញ បើក កិច្ចប្រជុំ គណៈកម្មាធិការ កណ្ដាល ពិនិត្យ សកម្មភាព ការងារ ឆ្នាំ ២០២០ និង ទិសដៅ ការងារ ឆ្នាំ ២០២១
២១៖ អ៉ី ស្រាអែល រកឃើញ អ្នក ផ្ទុក វីរុស កូវីដ - ១៩ទ្រង់ ថ្មី ចំនួន ៣ករណី ដែល សុទ្ធតែ ជា អ្នក ទើប ត្រលប់ មកពី ចក្រភព អង់គ្លេស
២២៖ ទូត ខ្មែរ នៅ កូរ៉េ ខាងត្បូង ចេញ សេចក្តី បំភ្លឺ ករណី ពល ការិនី ម្នាក់ ស្លាប់ ក្រោយ ក្រុម ប្រឆាំង យក ទៅ ចុះផ្សាយ គ្មាន មូលដ្ឋាន ត្រឹមត្រូវ
២៤៖ រដ្ឋមន្ត្រី ខៀវ កាញារីទ្ធ កោតសរសើរ និង វាយតម្លៃ ខ្ពស់ លើ នាយក ប្រតិបត្តិ អង្គភាព ព័ត៌មាន Fresh News ថា បាន រៀបចំ ទីស្នាក់ការ កណ្ដាល ថ្មី ប្រកបដោយ ផាសុកភាព និង យកចិត្តទុកដាក់ ខ្ពស់ ចំពោះ បុគ្គលិក គ្រប់ គ្នា
២៥៖ ប្រទេស ចិន នឹង ផ្អាក ជើងហោះហើរ ត្រង់ ទាំង ទៅ និង មកពី ចក្រភព អង់គ្លេស ក្រោយ ការផ្ទុះ វីរុស កូវីដ - ១៩ ទម្រង់ ថ្មី
២៦៖ កាសែត រដ្ឋ កូរ៉េ ខាងជើង អំពាវនាវ ឲ្យ ពង្រឹង វិស័យ ការពារ ជាតិ ឲ្យ កាន់តែ ខ្លាំង ថែម ទៀត
២៧៖ អតីត នាយក រដ្ឋមន្ត្រី លោក អាបេ សុំ អភ័យទោស ប្រជាជន ជប៉ុន ជុំវិញ ភាព មិន ប្រក្រតី ក្នុង ការប្រើប្រាស់ មូលនិធិ នយោបាយ
២៨៖ គណៈកម្មាធិការ អចិន្ត្រៃយ៍ រដ្ឋសភា បើក កិច្ចប្រជុំ កំណត់ ថ្ងៃ បោះឆ្នោត ប្រកាស សុពលភាព សមាជិក រដ្ឋសភា ថ្មី
២៩៖ អ៉ីរ៉ង់៖ « លោក ដូណាល់ ត្រាំ គួរ ប្រើ ពេល ជិត ផុត អាណត្តិ គិតគូរ ពី បញ្ហា ក្នុង ប្រទេស ខ្លួន ជាជាង ដើរ គំរាមកំហែង ប្រទេស ដទៃ »
១៖ LG និង Magna បណ្ដាក់ទុន រួមគ្នា ១ពាន់ លាន ដុល្លារ ពង្រីក ទីផ្សារ ផ្គត់ផ្គង់ គ្រឿង បំផ្លាស់ រថយន្ត អេឡិចត្រូនិក
ក្រសួង សង្គមកិច្ច៖ ពលរដ្ឋ ក្រក្រី ជាង ៦៨ ម៉ឺន គ្រួសារ រង ផល ប៉ះពាល់ ដោយសារ កូវីដ ទទួលបាន ប្រាក់ ឧបត្ថម្ភ ពី រដ្ឋ សម្រាប់ ជុំ ទី៣ លើក ទី២
( ភ្នំពេញ ) ៖ បើ តាម សេចក្ដីជូនដំណឹង របស់ ក្រសួង សង្គមកិច្ច អតីត យុទ្ធជន និង យុវនីតិសម្បទា បាន ឱ្យដឹង ថា មាន ប្រជាពលរដ្ឋ ក្រីក្រ ចំនួន ៦៨១ .៩៩៩ គ្រួសារ ទទួលបាន ថវិកា ឧបត្ថម្ភ ពី ការអនុវត្ត កម្មវិធី ឧបត្ថម្ភ សាច់ប្រាក់ ជូន គ្រួសារ ក្រីក្រ និង ងាយ រងគ្រោះ ក្នុង ពេល ប្រយុទ្ធ នឹង ជំងឺ កូវីដ១៩ សម្រាប់ ជុំ ទី៣ លើក ទី២ ។
ខាងក្រោម នេះ ជា ខ្លឹមសារ លម្អិត ក្នុង សេចក្ដីជូនដំណឹង របស់ ក្រសួង សង្គមកិច្ច៖
សេចក្តីថ្លែងការណ៍ ពី ការិយាល័យ នាយក រដ្ឋមន្ត្រី លោក បេន ចាមីន ណេតាន់ យ៉ាហ៊ូ បាន ឲ្យដឹង ថា វិធានការចាក់សោរ នឹង ចូល ជាធរមាន ចាប់ពី ម៉ោង ១៧៖០០ ( ម៉ោង នៅក្នុង តំបន់ ) នា ថ្ងៃអាទិត្យ សប្តាហ៍ នេះ សម្រាប់ រយៈពេល ០២ សប្តាហ៍ ។ ប្រសិនបើ ករណី ឆ្លង វីរុស កូរ៉ូណា ទម្រង់ ថ្មី មិន ធ្លាក់ចុះក្រោម អត្រា ១ ទេ ហើយ ចំនួន ករណី ឆ្លង ថ្មី ៗ ប្រចាំ ថ្ងៃ ក៏ មិន តិច ជាង ១.០០០ ករណី នោះ វិធានការរឹតត្បិត នេះ នឹង ត្រូវ អូសបន្លាយ ពីរ សប្តាហ៍ បន្ថែម ទៀត ។
ក្រោម វិធានការចាក់សោរ នេះ ពលរដ្ឋ អុី ស្រាអែល នឹង ត្រូវ ហាមឃាត់ មិន ឲ្យ ធ្វើដំណើរ ឆ្ងាយ ជាង ១គីឡូម៉ែត្រ ពី ផ្ទះ របស់ ពួកគេ ហើយ អាជីវកម្ម នានា នឹង ត្រូវ បិទ ទ្វារ ផងដែរ លើកលែងតែ ការដឹកជញ្ជូន ប៉ុណ្ណោះ ។ ការលើកលែង នឹង ត្រូវ ផ្តល់ ជូន សម្រាប់ អ្នក ដែល ធ្វើដំណើរ ដើម្បី ទៅ ទទួល ការចាក់ វ៉ាក់សាំង ខណៈ ដែល សាលារៀន នឹង នៅតែ បន្ត បើក ផ្នែក មួយចំនួន ។
គួរ បញ្ជាក់ ថា មួយ សប្តាហ៍ ចុងក្រោយ នេះ អ៊ីស្រាអែល បាន មើលឃើញ អត្រា ឆ្លង ថ្មី កើនឡើង យ៉ាង គំហុក ។ រហូតមកទល់ ពេលនេះ ប្រទេស ដែល មាន ប្រជាជន ប្រហែលជា ៩លាន នាក់ នេះ បាន កត់ត្រា ករណី ឆ្លង សរុប ចំនួន ៣៨៥. ០២២ ក្នុង នោះ មនុស្ស ចំនួន ៣.១៥០ នាក់ បាន ស្លាប់ ។
ក្រសួង សាធារណការ និង រដ្ឋបាល ខេត្ត ព្រះវិហារ អំពាវនាវ ឲ្យ មន្ទីរ អង្គភាព ពាក់ព័ន្ធ ចូលរួម យ៉ាង សកម្ម ថែម ទៀត ក្នុង ផែនការ កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ ផ្លូវគោក
ការថ្លែង អំពាវនាវ បែប នេះ ក្នុង ឱកាស ដែល លោក ចូលរួម ដឹកនាំ កិច្ចប្រជុំ « ត្រួតពិនិត្យ ការអនុវត្ត ផែនការ សកម្មភាព សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ឆ្នាំ ២០២០ រយៈពេល ១១ខែ របស់ ខេត្ត ព្រះវិហារ ដែល បាន ធ្វើឡើង នៅ សាល ប្រជុំ មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ព្រះវិហារ នៅ រសៀល ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ ដោយ មាន ការចូលរួម ពី តំណាង អគ្គ ស្នងការ នគរបាល ជាតិ តំណាង មន្ទីរ អង្គភាព ពាក់ពន្ធ័ ជុំវិញ ខេត្ត ជាច្រើន រូប ទៀត ។
នៅក្នុង ឱកាស នោះ លោក សំ លាង ទ្រី តំណាង លោក ប្រាក់ សុវណ្ណ បាន ថ្លែង ឲ្យដឹង ថា ក្រោម ការដឹកនាំ របស់ លោក ប្រាក់ សុវណ្ណ ហេដ្ឋារចនាសម្ពន្ធ័ ផ្លូវថ្នល់ នានា ពិសេស ផ្លូវ នៅក្នុង ទី រួម ខេត្ត កំពុងតែ ធ្វើ ការអភិវឌ្ឍន៍ ដើម្បី បម្រើ ផលប្រយោជន៍ ប្រជាពលរដ្ឋ ពិសេស គឺ ក្នុង គោលបំណង ចូលរួម កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ នៅក្នុង ខេត្ត ។
លោក សំ លាង ទ្រី បាន លើកឡើង យ៉ាង ដូច្នេះ ទៀត ថា បញ្ហា សុវត្ថិភាព ចរចារណ៍ ផ្លូវគោក គឺ ទាមទារ ឲ្យ យើង ទាំងអស់ គ្នា ដែល ជា អ្នកប្រើប្រាស់ ផ្លូវ ត្រូវតែ ចូលរួម គោរព ទាំងអស់ គ្នា ដោយ មិន ត្រូវ បែងចែក ពី បញ្ហា ផ្លាក សញ្ញា កំណត់ ល្បឿន កំណត់ ពី បញ្ហា ផ្លូវ កំណត់ ពី បញ្ហា សញ្ញា ចរាចរណ៍ នោះ ទេ សំខាន់ យើង ត្រូវ មាន ស្មាតី ប្រុងប្រយត្ន័ ជានិច្ច ពេល ធ្វើដំណើរ តាម ដងផ្លូវ ។
លោក សំ លាង ទ្រី បាន លើកឡើង ផងដែរ ថា ដើម្បី ឆ្លើយតប និង ផែនការ សកម្មភាព ទាង៨ ចំណុច របស់ គណៈកម្មាធិការ ជាតិ សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក មន្ទីរ សាធារណការ និង ដឹកជញ្ជូន ខេត្ត ក៏ ដូចជា អាជ្ញាធរ ខេត្ត លេខាធិការដ្ឋាន សុវត្ថិភាព ចរាចរណ៍ ខេត្ត បាន ធ្វើ ការអប់រំ ផ្សព្វផ្សាយ ច្បាប់ ចរាចរណ៍ ផ្លុវ គោក ថ្មី ដល់ មន្ត្រីរាជការ កងកម្លាំងប្រដាប់អាវុធ លោកគ្រូ អ្នកគ្រូ សិស្សានុសិស្ស និង ប្រជាពលរដ្ឋ នៅ ទូទាំង ខេត្ត ព្រះវិហារ ផងដែរ ។
ដោយឡែក លោក ព្រំ វន្ថា ប្រធាន នាយកដ្ឋាន សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ក្រោយពី បាន ស្តាប់ ការលើកឡើង របស់ មន្ទីរ អង្គភាព នានា ជុំវិញ ខេត្ត រួច មក លោក ក៏ បាន ណែនាំ អោយ មន្ទីរ អង្គភាព នានា ជា សមាជិក លេខាធិការដ្ឋាន សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ខេត្ត ត្រូវ ចូលរួម សហការ ផ្តល់ របាយការណ៍ ប្រចាំ ខែ មក លេខ ធិការដ្ឋាន សុវត្ថិភាព ចរាចរណ៍ ផ្លូវគោក ខេត្ត ដើម្បី បូកសរុប វាយតម្លៃ ពី បញ្ហា ប្រឈម នានា រួមគ្នា កាត់បន្ថយ គ្រោះថ្នាក់ ចរាចរណ៍ នៅក្នុង ខេត្ត ព្រះវិហារ ៕
ពលរដ្ឋ នៅ ភូមិ ឫស្សី ដួច ខេត្ត កំពង់ធំ រីករាយ ចំពោះ ការទទួលបាន ផ្លូវ និង ថវិកា ពី គម្រោង អភិវឌ្ឍន៍ ជនបទ របស់ រាជ រដ្ឋាភិបាល
( កំពង់ធំ )៖ ប្រជាពលរដ្ឋ នៅក្នុង ភូមិ ឫស្សី ដួច ឃុំ សាលា វិស័យ ស្រុក ប្រាសាទ បល្ល័ង្ក ខេត្ត កំពង់ធំ មាន ភាពសប្បាយរីករា យ៉ាង ខ្លាំង ក្នុង ពេល ទទួលបាន ទាំង ផ្លូវ ដើរ បាន ស្រួល ផង និង ទទួលបាន ថវិកា ពី គម្រោង អភិវឌ្ឍន៍ ជនបទ របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
ប្រជាពលរដ្ឋ បាន ថ្លែង យ៉ាង ដូច្នេះ គឺ នៅក្នុង ពេល ដែល ប្រជាពលរដ្ឋ ទទួលបាន ការលើក ផ្លូវ នា ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ ដែល ជា គម្រោង សាច់ប្រាក់ ពលកម្ម របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ។
លោក ជិន ហ៊ីន ប្រធាន ក្រុមប្រឹក្សា ឃុំ សាលា វិស័យ បាន ឲ្យដឹង ថា ឃុំ សាលា វិស័យ បាន ទទួល គម្រោង សាច់ប្រាក់ ពលកម្ម ពី រាជ រដ្ឋាភិបាល កម្ពុជា តាមរយៈ ក្រសួង អភិវឌ្ឍន៍ ជនបទ ដោយ គាំទ្រ កសិករ នៅ តាម បណ្ដា ភូមិ ហើយ ភូមិ ឫស្សី ដួច បាន ទទួល គម្រោង នេះ តាំងពី ឆ្នាំ ២០១៧ ដោយ ក្នុង មួយ ឆ្នាំ បាន ទទួលបាន ពី ៣-៤ គីឡូម៉ែត្រ ។
ជាក់ស្តែង ឆ្នាំ ២០២០ នេះ ទទួលបាន ចំនួន ៥ គីឡូម៉ែត្រ ប្រជាពលរដ្ឋ មាន ការសប្បាយរីករាយ ក្រោយពី បញ្ហា កូវីដ១៩ ជា បញ្ហា មួយ ដែល ធ្វើឲ្យ ប្រជាពលរដ្ឋ មួយចំនួន មិន សូវ មាន ការងារ ធ្វើ ចឹង ពេលនេះ ពួកគាត់ បាន ធ្វើជា ពលកម្ម លើក ដោយ ដៃ មក បង្កើត ទៅជា ផ្លូវ ហើយ ក្នុង នោះ រដ្ឋាភិបាល បាន ផ្ដល់ ជា សាច់ប្រាក់ នៅក្នុង មួយ ម៉ែត្រ គីប ទទួលបាន ១២.០០០ រៀល ចំពោះ ការដាំ ស្មៅ តាម ជើង តេនេះ គឺ ក្នុង មួយ ម៉ែត្រ ការេ ៣.០០០ រៀល គិត ជា មធ្យម ទាំង លើក ដី និង ដាំ ស្មៅ ពី ១៥.០០០ ដល់ ១៧.០០០ រៀល តាម ប្រភេទ ជើង ទេ រ ខ្ពស់ ឬ ទាប ។
ជាមួយគ្នា ដែរ លោក ជិន ហ៊ីន បាន ថ្លែងអំណរគុណ ដល់ សម្តេច តេជោ ហ៊ុន សែន ប្រមុខ រដ្ឋាភិបាល កម្ពុជា ដែល បាន ទម្លាក់ សាច់ប្រាក់ ពលកម្ម មក ឲ្យ ប្រជាពលរដ្ឋ មាន ការងារ ធ្វើ នៅក្នុង សម័យ កូវីដ នេះ ដោយ ទទួលបាន ផ្លូវ ដើរ បាន ស្រួល ផង និង បាន ទទួល ថវិកា យកមក ផ្គត់ផ្គង់ ជីវភាព គ្រួសារ ផង ៕
( ភ្នំពេញ ) ៖ អគ្គ នាយកដ្ឋាន ពន្ធដារ នៃ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ បាន ចេញ វីដេអូ ណែនាំ ថ្មី មួយ ស្តីពី កម្មវិធី ប្រកាស ពន្ធ សម្រាប់ អ្នក ជាប់ ពន្ធ តូច លើ ទូរស័ព្ទ ដៃ ដើម្បី ផ្តល់ ជូន អ្នក ជាប់ ពន្ធ កាន់តែ ងាយស្រួល ។
សូម ទស្សនា វីដេអូ ដូច ខាងក្រោម៖ ស្នងការ នគរបាល ខេត្ត តាកែវ បើក កិច្ចប្រជុំ ពង្រឹង ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ សុវត្ថិភាព នៅក្នុង មូលដ្ឋាន ខេត្ត ទាំងមូល និង បន្ត ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩
( តាកែវ )៖ នៅ រសៀល ថ្ងៃ ទី២៤ ខែធ្នូ ឆ្នាំ ២០២០ ស្នងការ នគរបាល ខេត្ត តាកែវ លោក ឧត្តមសេនីយ៍ ទោ សុខ សំណាង បាន រៀបចំ កិច្ចប្រជុំ ស្តីពី ការពង្រឹង ការងារ សន្តិសុខ សណ្តាប់ធ្នាប់ សុវត្ថិភាព នៅក្នុង មូលដ្ឋាន ខេត្ត ទាំងមូល បន្ត ការទប់ស្កាត់ ការរីករាលដាល ជំងឺ កូវីដ១៩ និង ណែនាំ ការអនុវត្ត ការងារ ជំនាញ ដល់ កងកម្លាំង នគរបាល ខេត្ត តាកែវ ទាំងអស់ នៅ សាល ប្រជុំ ស្នងការដ្ឋាន នគរបាល ខេត្ត តាកែវ ។
លោក ឧត្តមសេនីយ៍ ទោ សុខ សំណាង ក៏ បាន ណែនាំ ពី បទបញ្ជា របស់ ថ្នាក់ដឹកនាំ ដល់ កងកម្លាំង នគរបាល ស្តីពី ការពង្រឹង ការគ្រប់គ្រង ដើម្បី បង្ការ ទប់ស្កាត់ ការឆ្លង រាតត្បាត នៃ ជំងឺ កូវីដ១៩ នៅ កម្ពុជា ។
ចំពោះ ការបញ្ហា កូវីដ១៩ លោក ឧត្តមសេនីយ៍ ស្នងការ បាន ណែនាំឲ្យ យកចិត្តទុកដាក់ លើ ការងារ មួយ ចំនួន រួម មាន៖
* ត្រូវ ណែនាំ ដល់ សមត្ថកិច្ច ប្រចាំ ច្រក ទ្វារ ព្រំដែន ឱ្យ ពង្រឹង ការគ្រប់គ្រង និង ការត្រួតពិនិត្យ មធ្យោបាយ ដឹកជញ្ជូន និង អ្នកដំណើរ ដែល ដឹកជញ្ជូន ទំនិញ ចេញ ចូល ឆ្លងកាត់ ព្រំដែន កម្ពុជា - វៀតណាម ស្រប តាម វិធាន ចត្តាឡី ស័ក ដែល កំណត់ ដោយ ក្រសួង សុខាភិបាល ឱ្យ បាន ម៉ត់ចត់ បំផុត ។
* ត្រូវ ចាត់ វិធានការ ឱ្យ បាន តឹងរឹង និង ម៉ឺងម៉ាត់ ដើម្បី បង្ការ ទប់ស្កាត់ កុំ ឱ្យ មាន ការលួច ឆ្លង ដែន ដោយ ខុស ច្បាប់ ចេញ ចូល ឆ្លងកាត់ ព្រំដែន តាម ច្រក របៀង នានា ក្នុង ភូមិសាស្ត្រ របស់ ខ្លួន ។
* បន្ត ជំរុញ ការអប់រំ ណែនាំ និង ផ្សព្វផ្សាយ ដល់ សាធារណជន និង ប្រជាពលរដ្ឋ នៅក្នុង មូលដ្ឋាន របស់ ខ្លួន ជាពិសេស ប្រជាពលរដ្ឋ រស់ នៅ តាម តំបន់ ព្រំដែន ឱ្យ បង្កើន ការប្រុងប្រយ័ត្ន ការពារ ខ្លួន ស្រប តាម ការណែនាំ នានា របស់ ក្រសួង សុខាភិបាល ដើម្បី កុំ ឱ្យ មាន វីរុស កូវីដ១៩ ឆ្លង មក លើ បុគ្គល និង សហគមន៍ មូលដ្ឋាន នៅ កម្ពុជា ៕ ឧកញ៉ា បណ្ឌិត ឡាយ លន់ ផ្ញើ សារ អបអរសាទរ ឯកឧត្តម ហ៊ុន ម៉ាណែត ក្នុង ឱកាស គណបក្ស ប្រជាជន កម្ពុជា តែងតាំង ដំឡើង ឋានៈ ជា អនុប្រធាន គណៈ ចលនា មហាជន នៃ គណៈកម្មាធិការ កណ្តាល
( ភ្នំពេញ ) ៖ ឧកញ៉ា បណ្ឌិត ឡាយ លន់ អគ្គ នាយក ប្លែក អ៉ីហ្គល អន្តរជាតិ នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ផ្ញើ សារ អបអរសាទរ និង ជូនពរ ឯកឧត្តម ហ៊ុន ម៉ាណែត ក្នុង ឱកាស ដែល គណបក្ស ប្រជាជន កម្ពុជា បាន តែងតាំង ដំឡើង ឋានៈ ជា អនុប្រធាន គណៈ ចលនា មហាជន នៃ គណៈកម្មាធិការ កណ្ដាល ។
ខ្ញុំបាទ សូម គោរព ជូនពរ ឯកឧត្តម បណ្ឌិត និង លោកជំទាវ ព្រមទាំង បុត្រា បុត្រី សូម ប្រកបដោយ ពរ ទាំង ៥ប្រការ គឺ៖ អាយុ វណ្ណៈ សុខៈ ពលៈ និង បដិភាណៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
ឧកញ៉ា បណ្ឌិត គីម ហ៊ាង ផ្ញើ សារ អបអរសាទរ ឯកឧត្តម ហ៊ុន ម៉ាណែត ក្នុង ឱកាស គណបក្ស ប្រជាជន កម្ពុជា តែងតាំង ដំឡើង ឋានៈ ជា អនុប្រធាន គណៈ ចលនា មហាជន នៃ គណៈកម្មាធិការ កណ្តាល
ឆ្លៀត ក្នុង ឱកាស ដ៏ វិសេសវិសាល ថ្លៃថ្លា នេះ យើងខ្ញុំ ទាំងអស់ គ្នា សូម សម្តែង នូវ អំណរ សាទរ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត និង សូម បួងសួង ដល់ វត្ថុ ស័ក្តិសិទ្ធិ ទាំងឡាយ ក្នុង លោក សូម ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី សិរី មង្គល មហា ប្រសើរ ជូន ឯកឧត្តម ហ៊ុន ម៉ាណែត សូម ប្រកបដោយ សុខភាព ល្អ បរិបូរណ៌ កម្លាំង មាំ មួន ប្រាជ្ញា វាង វៃ អាយុ យឺន យូរ ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍ ព្រះរាជាណាចក្រ កម្ពុជា ឆ្ពោះ ទៅកាន់ សុខ សន្តិភាព វឌ្ឍនភាព និង សម្បូរ រុងរឿង ជានិច្ច និរន្តរ៍ ត រៀង ទៅ ។
យើងខ្ញុំ ទាំងអស់ គ្នា សូម គោរព ជូនពរ ឯកឧត្តម បណ្ឌិត និង លោកជំទាវ ព្រមទាំង បុត្រា បុត្រី សូម ប្រកបដោយ ពរ ទាំង ៥ប្រការ គឺ៖ អាយុ វណ្ណៈ សុខៈ ពលៈ និង បដិភាណៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕ ក្រសួង សេដ្ឋកិច្ច បើក វគ្គ បណ្តុះបណ្តាល ជា ស៊េរី ពី ចម្ងាយ ស្ដីពី លទ្ធកម្ម សាធារណៈ . នីតិវិធី អនុវត្ត ថវិកា កម្មវិធី សម្រាប់ អង្គភាព ថវិកា និង សវនកម្ម ផ្ទៃក្នុង ជូន មន្ត្រីរាជការ តាម ក្រសួង ស្ថាប័ន
( ភ្នំពេញ ) ៖ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បើក វគ្គ បណ្តុះបណ្តាល ជា ស៊េរី ពី ចម្ងាយ ( ប្រព័ន្ធ វីដេអូ Zoom) ស្តីពី ‹ លទ្ធកម្ម សាធារណៈ . នីតិវិធី អនុវត្ត ថវិកា កម្មវិធី សម្រាប់ អង្គភាព ថវិកា និង សវនកម្ម ផ្ទៃក្នុង › ជូន សិក្ខាកាម គោលដៅ ដែល ជា មន្ត្រីរាជការ ទទួលបន្ទុក ការងារ ពាក់ព័ន្ធ នៃ ក្រសួង ស្ថាប័ន ។
វគ្គ បណ្តុះបណ្តាល នេះ មាន គោលដៅ ពង្រឹង ពង្រីក សមត្ថភាព និង លើកកម្ពស់ ការយល់ដឹង ថែម ទៀត ជូន មន្ត្រី ទទួលបន្ទុក ការងារ លទ្ធកម្ម . ការងារ ថវិកា . ការងារ គណនេយ្យ និង សវន ផ្ទៃក្នុង ដើម្បី ចូលរួមចំណែក លើកកម្ពស់ តម្លាភាព . គណនេយ្យភាព . ប្រសិទ្ធភាព និង ស័ក្តិសិទ្ធភាព នៃ ការអនុវត្ត ការងារ ឱ្យ បាន ត្រឹមត្រូវ តាម គោលការណ៍ បច្ចេកទេស និង អនុលោម តាម លិខិត បទដ្ឋាន គតិយុត្តិ ជាធរមាន និង ក្នុង ក្របខណ្ឌ នៃ កម្មវិធី កែទម្រង់ ការគ្រប់គ្រង ហិរញ្ញវត្ថុ សាធារណៈ - ដំណាក់កាល ទី ៣ របស់ រាជ រដ្ឋាភិបាល ។
ពិធី បើក វគ្គ បណ្តុះបណ្តាល នេះ បាន ប្រព្រឹត្តទៅ ក្រោម ការដឹកនាំ របស់ បណ្ឌិត សភាចារ្យ ហ៊ាន សាហ៊ីប រដ្ឋលេខាធិការ និង ជា ប្រធាន ក្រុមការងារ កសាង សមត្ថភាព ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ និង មាន ការចូលរួម ដោយ ថ្នាក់ដឹកនាំ ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ . គ្រូ ឧទ្ទេស និង សិក្ខាកាម ចូលរួម សរុប ប្រមាណ ៩០ នាក់ ។
ថ្លែង ក្នុង ពិធី នេះ បណ្ឌិត សភាចារ្យ ហ៊ាន សាហ៊ីប បាន គូសបញ្ជាក់ ថា កម្មវិធី វគ្គ បណ្តុះបណ្តាល នេះ គឺជា កិច្ចការ ដ៏ សំខាន់ មួយ ដែល ក្រសួង សេដ្ឋកិច្ច និង ហិរញ្ញវត្ថុ តែង យកចិត្តទុកដាក់ សំដៅ អភិវឌ្ឍ សមត្ថភាព មន្ត្រីរាជការ គោលដៅ ដែល ជា មន្ត្រី ទទួលបន្ទុក ការងារ លទ្ធកម្ម . ការងារ ថវិកា . ការងារ គណនេយ្យ និង សវនកម្ម ជូន ដល់ ក្រសួង ស្ថាប័ន ពាក់ព័ន្ធ សម្រាប់ ការគ្រប់ គ្រង ហិរញ្ញវត្ថុ សាធារណៈ ពិសេស « លទ្ធកម្ម សាធារណៈ . នីតិវិធី អនុវត្ត ថវិកា កម្មវិធី សម្រាប់ អង្គភាព ថវិកា និង សវនកម្ម ផ្ទៃក្នុង » ។
អាជ្ញាធរ បន្ដ ចុះ ត្រួតពិនិត្យ និង ធ្វើតេស្ដ លើ ពលករ មកពី ថៃ ក្នុង ស្រុក ម៉ាទ្បៃ ខេត្ត បន្ទាយមានជ័យ ហើយ ឲ្យ ធ្វើចត្តាឡី ស័ក ១៤ ថ្ងៃ ជា កំហិត
( បន្ទាយមានជ័យ )៖ កម្លាំង ចម្រុះ បាន បន្ដ ចុះ ពិនិត្យ សួរសុខទុក្ខ ពលករ ដែល មកពី ប្រទេស ថៃ ចូលមក កម្ពុជា តាម ច្រក របៀង ផ្សេង ៗ តាម បន្ទាត់ ព្រំដែន កម្ពុជា - ថៃ ក្រោយពី ទទួល ព័ត៌មាន ថា មាន ពលករ ចំណាកស្រុក ដែល ចូលទៅ ធ្វើការ នៅ ប្រទេស ថៃ បាន នាំគ្នា សម្រុក មក តាម ច្រក របៀង ៗ ក្នុង ស្រុក ម៉ាទ្បៃ ក្នុង ខេត្ដ បន្ទាយមានជ័យ កាលពី យប់ ថ្ងៃទី ២៣ ខែធ្នូ ឆ្នាំ ២០២០ ។
ជាពិសេស ស្រុក ម៉ាទ្បៃ ខេត្ត បន្ទាយមានជ័យ តែម្តង ដើម្បី ចាត់ ដាក់ វិធាការបន្ថែម ក្នុង ការពង្រឹង ការគ្រប់គ្រង ប្រជាពលរដ្ឋ ដែល បាន វិលត្រឡប់ មកពី ប្រទេស ថៃ ឲ្យបាន ហ្មត់ចត់ តឹងរឹង បំផុត ដោយ ត្រួតពិនិត្យ វាស់ កំដៅ រួច បញ្ជូន ទៅ មន្ទីរពេទ្យ ដើម្បី ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ឲ្យបាន ត្រឹមត្រូវ តាម វិធានការ របស់ ក្រសួង សុខាភិបាល ។
មន្ត្រី ជំនាញ ដដែរ បន្ត ថា ប្រជាពលរដ្ឋ ដែល ចេញ ពី ទឹកដី ថៃ ក្រោយ ពិនិត្យ រួច ត្រូវបាន បញ្ជូន ទៅ កន្លែក ពិនិត្យ សំណាក និង ធ្វើចត្តាឡី ស័ក រយៈពេល ១៤ ថ្ងៃ ក្នុង វិទ្យា ម៉ាទ្បៃ ស្រុក ម៉ាទ្បៃ ខេត្ត បន្ទាយមានជ័យ ៕
កាកបាទ ក្រហម កម្ពុជា នឹង ចាត់ចែង នាំយក អំណោយ នេះ ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត និង ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ផ្សេង ៗ ដោយ ផ្ទាល់ ដៃ ។
អំណោយ ខាងលើ នេះ គឺជា សក្ខីភាព នៃ ទឹកចិត្ត ជ្រះថ្លា របស់ សប្បុរសជន ដែល បាន បង្ហាញ ពី ស្មារតី នៃ ការចែករំលែក និង កម្លាំង សាមគ្គី គ្នា របស់ ប្រជាជន ខ្មែរ « ស្រឡាញ់ គ្នា ក្នុង គ្រា ក្រ ស្គាល់ មិត្ត ល្អ ក្នុង គ្រា មាន អាសន្ន ខ្មែរ ជួយ ខ្មែរ ខ្មែរ កាន់តែ រឹងមាំ » ។
សូម បញ្ជាក់ ថា ក្នុង ឆ្នាំ ២០២០ នេះ កាកបាទ ក្រហម កម្ពុជា ដែល មាន សម្តេច កិត្តិព្រឹទ្ធបណ្ឌិត ប៊ុន រ៉ានី ហ៊ុន សែន ជា ប្រធាន បាន ផ្តល់ អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ និង ងាយ រងគ្រោះ បំផុត បាន សរុប ចំនួន ១០៥. ០១២ គ្រួសារ ។
ដោយឡែក ចាប់ពី ថ្ងៃទី ១ ខែតុលា ដល់ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ផ្តល់ អំណោយ មនុស្សធម៌ ជូន ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ ទឹក ជំនន់ និង ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត បាន សរុប ចំនួន ៤០. ៦៦៣ គ្រួសារ រស់ នៅ ភូមិ ចំនួន ១. ០៤៥ ឃុំ ចំនួន ៤៤៨ ស្រុក ចំនួន ១៧៩ និង រាជធានី - ខេត្ត ទាំង២៥ ( ក្នុង នោះ ឆ្លើយតប ដោយ ទីស្នាក់ការ ថ្នាក់ កណ្តាល ចំនួន ១៤. ៩៨៦ គ្រួសារ និង ដោយសាខា ចំនួន ២៥. ៦៧៧ គ្រួសារ )៕
អតីត នាយក រដ្ឋមន្ត្រី លោក អាបេ សុំ អភ័យទោស ប្រជាជន ជប៉ុន ជុំវិញ ភាព មិន ប្រក្រតី ក្នុង ការប្រើប្រាស់ មូលនិធិ នយោបាយ
( តូក្យូ ) ៖ អតីត នាយក រដ្ឋមន្ត្រី ជប៉ុន លោក អាបេ ស៊ីន ហ្សូ នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បាន សុំ អភ័យទោស ទៅកាន់ ប្រជាជន ជប៉ុន បន្ទាប់ពី ផ្ទុះ រឿង អាស្រូវ ដែល គេ ចោទប្រកាន់ ថា លោក មាន ជាប់ពាក់ព័ន្ធ នឹង ការបំពាន ច្បាប់ គ្រប់គ្រង មូលនិធិ សម្រាប់ ការធ្វើ សកម្មភាព នយោបាយ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយ ទីភ្នាក់ងារ ព័ត៌មាន Reuters នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៤ ខែធ្នូ ឆ្នាំ ២០២០ ។
ស្ថាន ឯក អគ្គ រាជ ទូត នៃ ព្រះរាជាណាចក្រ កម្ពុជា ប្រចាំ សាធារណរដ្ឋ កូរ៉េ បាន ឲ្យដឹង ថា កាលពី ថ្ងៃទី ២១ ខែធ្នូ ឆ្នាំ ២០២០ កន្លងមក ស្ថានទូត បាន ទទួល ព័ត៌មាន ផ្លូវការ ពី ប៉ូលីស កូរ៉េ អំពី ការស្លាប់ ពល ការិនី ផ្នែក កសិកម្ម ឈ្មោះ នួន សុខ ខេង កើត ថ្ងៃទី ១៦ ខែតុលា ឆ្នាំ ១៩៩០ ដែល កាន់ លិខិត ឆ្លង ដែន លេខ N002***** បាន ទទួលមរណភាព នៅក្នុង បន្ទប់ ស្នាក់នៅ របស់ ខ្លួន នា ថ្ងៃទី ២០ ខែធ្នូ ឆ្នាំ ២០២០ វេលា ម៉ោង ៤៖៣០ នាទី រសៀល ស្ថិត នៅ តំបន់ ផូឆន់ ។
សេចក្តី បំភ្លឺ ដដែល បាន ឲ្យដឹង យ៉ាង ដូច្នេះ៖ « ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សាធារណរដ្ឋ កូរ៉េ បាន បញ្ជាក់ ថា បន្ទាប់ពី បាន ទទួល របាយការណ៍ ផ្លូវការ អំពី ការធ្វើ កោសល្យវិច្ច័យ សាកសព ដែល ផ្ដល់ ដោយ ប៉ូលីស កូរ៉េ នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ គឺ ពល ការិនី ឈ្មោះ នួន សុខ ខេង បាន ស្លាប់ បណ្ដាល មកពី មាន ជំងឺ ក្រិន ថ្លើម ផ្ទាល់ខ្លួន ជា បញ្ហា ចម្បង » ។
យោង ទៅតាម នីតិវិធី របស់ ប៉ូលីស ជាមួយនឹង កិច្ចអន្ដរាគមន៍ និង តាមដាន របស់ ស្ថានទូត ការធ្វើ កោសល្យវិច្ច័យ នេះ នឹង ត្រូវ បញ្ជូន ទៅ តុលាការ និង រដ្ឋអាជ្ញា ធ្វើ ការស៉ើប អង្កេត មើល បន្ត ទៀត ដើម្បីឲ្យ កាន់តែ មាន ភាពច្បាស់លាស់ និង សុក្រឹត្យភាព ។ ទន្ទឹម នេះ ស្ថានទូត កម្ពុជា បាន ទទួល ការសូម ទោស ពី បណ្ដាញ ផ្សព្វផ្សាយ ព័ត៌មាន ក្នុង ស្រុក កូរ៉េ មួយចំនួន និង បាន កែតម្រូវ អំពី មូលហេតុ នៃ ការស្លាប់ របស់ ពល ការិនី ខាងលើ ឡើងវិញ ក្រោយពី ពួកគេ ទទួលបាន ដំណឹង ពី ប៉ូលីស កូរ៉េ ដូចគ្នា ។
លើស ពី នេះ ស្ថានទូត កម្ពុជា តែងតែ ជួយ សម្របសម្រួល ឯកសារ ចាត់ចែង តាម នីតិវិធី ក្នុង ការរៀបចំ ពិធី បូជា សព និង សហការ ជាមួយ ការិយាល័យ មេធាវី ក្រុម អ្នកច្បាប់ ក្នុង ការប្ដឹង ទាមទារ គ្រប់ ករណី ទាំងអស់ ដើម្បី រក យុត្តិធម៌ ឲ្យ មាន តម្លាភាព ជូន ទៅដល់ ក្រុមគ្រួសារ ជនរងគ្រោះ ក៏ ដូចជា ការពារ ផលប្រយោជន៍ របស់ ពលរដ្ឋ ខ្មែរ ទាំងអស់ ។
នា ពេល កន្លងមក ស្ថានទូត កម្ពុជា និង ស្ថានទូត តាម បណ្ដា ប្រទេស បញ្ជូន ពលករ ទាំង ១៥ ទៀត តែងតែ លើក បញ្ហា នៃ ការស្នាក់នៅ របស់ ពលករ បញ្ហា កូវីដ និង បញ្ហា ផ្សេង ៗ ទៅ ពិភាក្សា ជាមួយ អាជ្ញាធរ កូរ៉េ ជាពិសេស អង្គភាព អភិវឌ្ឍន៍ ធនធាន មនុស្ស នៃ ក្រសួង មុខរបរ និង ការងារ នៃ សាធារណរដ្ឋ កូរ៉េ ដើម្បី ឆ្លើយតប និង ដោះស្រាយ បញ្ហា ឲ្យ កាន់តែ មាន ប្រសិទ្ធិភាព និង ផ្ដល់ ភាពកក់ក្ដៅ ទៅដល់ ពលករ ទាំងអស់ ។
ជា អកុសល ក្រុម ឧទ្ទាម ក្រៅ ច្បាប់ ដែល តែងតែ ប្រឆាំង និង មាន បំណង ផ្ដួលរំលំ រាជ រដ្ឋាភិបាល ស្រប ច្បាប់ មួយចំនួន តូច បាន វាយប្រហារ មកកាន់ មន្ត្រី ស្ថានទូត កម្ពុជា ដោយ គ្មាន មូលដ្ឋាន និង ឆ្លៀត កេង ចំណេញ នយោបាយ ពី មរណភាព ពល ការិនី ខាងលើ ។ អំពើ នេះ ស្ថានទូត កម្ពុជា បាន ធ្វើការ ថ្កោលទោស និង ចាត់ទុក ជា អំពើ អគុណធម៌ និង អមនុស្សធម៌ ចំពោះ ប្រជាជាតិ ខ្លួន ឯង ណាស់ ។
ក្រៅពី ការបកស្រាយ យ៉ាង លម្អិត ខាងលើ ស្ថាន ឯក អគ្គ រាជ ទូត កម្ពុជា ប្រចាំ សាធារណរដ្ឋ កូរ៉េ ថែមទាំង បាន អំពាវនាវ ដល់ ប្រជាពលរដ្ឋ ខ្មែរ ទាំងអស់ ជ្រាប ជា ព័ត៌មាន និង សូម ជឿ ទុកចិត្ត លើ ស្ថានទូត កម្ពុជា ក៏ ដូចជា អាជ្ញាធរ មាន សមត្ថកិច្ច កូរ៉េ ហើយ កុំ ជឿ លើ ការបំផ្លើស និង ញុះញង់ របស់ ក្រុម ឧទ្ទាម មួយ ចំនួន តូច ដែល មាន និន្នាការ ប្រឆាំង ជា ហេតុ បណ្ដាលឲ្យ ខាតបង់ ឧត្ដម ប្រយោជន៍ ជាតិ ប្រជាជន និង ទំនាក់ទំនង ល្អ ជាមួយ ភាគី កូរ៉េ ៕
ប្រើ គ្រឿងញៀន គឺ បំផ្លាញ ខ្លួន ឯង ក្រុមគ្រួសារ និង សង្គមជាតិ ! ការបង្ក្រាប គ្រឿងញៀន ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៤ ខែ ធ្នូ៖ បង្ក្រាប ១២ករណី ឃាត់ខ្លួន ៣៦ នាក់
( ភ្នំពេញ ) ៖ យុទ្ធនាការ ប្រយុទ្ធ ប្រឆាំង គ្រឿងញៀន ខុស ច្បាប់ ទូទាំង ប្រទេស សម្រាប់ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន បង្ហាញ ថា កម្លាំង សមត្ថកិច្ច បាន បង្ក្រាប ១២ករណី ក្នុង នោះ ករណី ប្រើប្រាស់ ២ករណី និង ជួញដូរ ១០ករណី ដោយ ឃាត់ខ្លួន ជនសង្ស័យ ៣៦ នាក់ ។
ប្រធាន សមាគម អចលន ទ្រព្យ សកល ផ្ញើ សារ អបអរសាទរ ឯកឧត្តម ហ៊ុន ម៉ាណែត ក្នុង ឱកាស គណបក្ស ប្រជាជន កម្ពុជា តែងតាំង ដំឡើង ឋានៈ ជា អនុប្រធាន គណៈ ចលនា មហាជន នៃ គណៈកម្មាធិការ កណ្តាល
ឆ្លៀត ក្នុង ឱកាស ដ៏ វិសេសវិសាល ថ្លៃថ្លា នេះ លោក សំ សុខ នឿន សូម សម្តែង នូវ អំណរ សាទរ ដោយ ស្មោះ អស់ ពី ដួងចិត្ត និង សូម បួងសួង ដល់ វត្ថុ ស័ក្តិសិទ្ធិ ទាំងឡាយ ក្នុង លោក សូម ប្រសិទ្ធ ពរ ជ័យ បវរ សួស្តី សិរី មង្គល មហា ប្រសើរ ជូន ឯកឧត្តម ហ៊ុន ម៉ាណែត សូម ប្រកបដោយ សុខភាព ល្អ បរិបូរណ៌ កម្លាំង មាំ មួន ប្រាជ្ញា វាង វៃ អាយុ យឺន យូរ ដើម្បី រួមចំណែក ក្នុង ការអភិវឌ្ឍ ព្រះរាជាណាចក្រ កម្ពុជា ឆ្ពោះ ទៅកាន់ សុខ សន្តិភាព វឌ្ឍនភាព និង សម្បូរ រុងរឿង ជានិច្ច និរន្តរ៍ ត រៀង ទៅ ។
ជាមួយ នេះ ផងដែរ លោក សំ សុខ នឿន សូម គោរព ជូនពរ ឯកឧត្តម បណ្ឌិត និង លោកជំទាវ ព្រមទាំង បុត្រា បុត្រី សូម ប្រកបដោយ ពរ ទាំង ៥ប្រការ គឺ៖ អាយុ វណ្ណៈ សុខៈ ពលៈ និង បដិភាណៈ កុំបី ឃ្លៀងឃ្លាត ឡើយ ៕
សហគមន៍ ជនជាតិ ដើម ភាគ តិច ទំពួន ចំនួន ២ភូមិ នៅ ស្រុក វើន សៃ ខេត្ត រតនគិរី ទទួលបាន ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី សមូហភាព ចំនួន ១៥ ក្បាល ដី
( រតនគិរី ) ៖ លោក ថង សាវុន អភិបាល ខេត្ត រតនគិរី និង ជា ប្រធាន គណៈកម្មាធិការ គ្រប់គ្រង ដី រដ្ឋ ថ្នាក់ ខេត្ត នៅ ថ្ងៃទី ២៤ ខែធ្នូ ឆ្មាំ ២០២០ នេះ បាន អញ្ជើញ ប្រគល់ វិញ្ញាបនបត្រ សម្គាល់ ម្ចាស់ កម្មសិទ្ធិ ដីធ្លី សមូហភាព ជូន សហគមន៍ ជនជាតិ ដើម ភាគ តិច ទំពួន ចំនួន ២ភូមិ គឺ ភូមិ រ៉ក និង ភូមិ ឡាឡៃ ស្ថិត ក្នុង ឃុំ កុក ឡាក់ ស្រុក វើន សៃ ។
លោក លី ឧសភា ប្រធាន មន្ទីរ រៀបចំ ដែនដី នគរូបនីកម្ម សំណង់ និង សុរិយោដី ខេត្ត រតនគិរី បាន ឲ្យដឹង ថា ការចែក វិញ្ញាបនបត្រ សម្គាល់ កម្មសិទ្ធិ សមូហភាព សហគមន៍ ជនជាតិ ដើម ភាគ តិច ទំពួន ជូន ដល់ ភូមិ រ៉ក និង ភូមិ ឡាឡៃ ឃុំ កុក ឡាក់ ស្រុក វើន សៃ នា ពេលនេះ មា ដែល មាន ប័ណ្ណ សរុប ចំនួន ១៥ ក្បាល ដី លើ ផ្ទៃដី ចំនួន ១២. ២៥៩. ១៩៦ ហិកតា ។
លោក ថង សាវុន បាន ចាត់ទុក ប័ណ្ណ កម្មសិទ្ធិ ដីធ្លី សមូហភាព ដែល សហគមន៍ ទទួលបាន នេះ គឺជា ឯ សារ មួយ សំខាន់ ណាស់ ជា ឯកសារ តំណាង ឲ្យ ទ្រព្យ សហគមន៍ ទាំងមូល ជា ឯកសារ តំណាង ឲ្យ សិទ្ធិ នៃ កម្មសិទ្ធ ផ្ដាច់ មុខ របស់ កម្មសិទ្ធិ ករ លើ ដីធ្លី របស់ ខ្លួន ក្នុង ការ ប្រើប្រាស់ និង អាស្រ័យ ផល ជាក់ស្តែង រៀង ៗ ខ្លួន ។
លោក ថា ដីធ្លី ដែល ពុក ម៉ែ បងប្អូន បាន ចុះបញ្ជី ជា សមូហភាព នៅក្នុង សៀវភៅ គោល បញ្ជី ដីធ្លី និង ទទួលបាន ប័ណ្ណ កម្មសិទ្ធិ នេះ គឺ បាន បំពេញ លក្ខណ្ឌ គ្រឹះ ដ៏ រឹងមាំ ដែល ធានា ដោយ រដ្ឋ និង ការពារ ដោយ ច្បាប់ ហើយក៏ ជា លក្ខខណ្ឌ សំខាន់ សម្រាប់ ការប្រើប្រាស់ ប័ណ្ណ នេះ ។
ដូច្នេះ ការចុះបញ្ជី ជា លក្ខណៈ សមូហភាព គឺជា ការពង្រឹង សុវត្ថិភាព នៃ ការកាន់កាប់ ដីធ្លី និង ធនធាន ធម្មជាតិ ក្នុង សហគមន៍ ប្រកបដោយ និរន្តរភាព ដែល នឹង ជំរុញ ការប្រើប្រាស់ ដីធ្លី ឲ្យ អស់ សក្ដានុពល ហើយ កត្តា នេះ ពិតជា បាន បញ្ចប់ ជម្លោះ និង វិវាទ ដីធ្លី រវាង ភូមិ និង ភូមិ ជាពិសេស ការកាត់បន្ថយ ភាពក្រីក្រ ដែល ជា គោល នយោបាយ ជំរុញ ការចុះបញ្ជី ដីធ្លី របស់ រាជ រដ្ឋាភិបាល ដែល មាន ចំពោះ ជនជាតិ ដើម ភាគ តិច នៅក្នុង ប្រទេស កម្ពុជា ។
ទន្ទឹម នឹង នោះ លោក អភិបាល ខេត្ត ក៏ បាន លើកឡើង ពី គោល នយោបាយ អភិវឌ្ឍន៍ ជនជាតិ ដើម ភាគ តិច របស់ រាជ រដ្ឋាភិបាល កម្ពុជា ក្រោម ការដឹកនាំ របស់ សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដែល បាន លើកកម្ពស់ ទាំង ជីវភាព រស់ នៅ របស់ បងប្អូន ជនជាតិ ដើម ភាគ តិច ប្រកបដោយ សុខដុមនីយកម្ម នៅ កម្ពុជា ផងដែរ ។
ជាមួយគ្នា នោះ លោក ក៏ បាន ថ្លែង ការកោតសរសើរ ចំពោះ ក្រុមការងារ ចុះបញ្ជី ដីធ្លី និង អ្នក ពាក់ព័ន្ធ ទាំងអស់ ដែល ខិតខំ សម្រេច កិច្ចការ នេះ ដោយ ការទទួលខុសត្រូវ និង តម្លាភាព និង ផ្តាំផ្ញើ ឲ្យ បងប្អូន ប្រជាពលរដ្ឋ សហគមន៍ ជនជាតិ ដើម ភាគ តិច ទាំង ពីរ ភូមិ ត្រូវ ថែរក្សា ឲ្យបាន គង់វង្ស នូវ ប័ណ្ណ កម្មសិទ្ធិ សមូហភាព នេះ ហើយ ត្រូវ មាន សាមគ្គីភាព នៅក្នុង សហគមន៍ ថែរក្សា ដី ទាំងអស់ ដែល បាន ចុះបញ្ជី និង ប្រើប្រាស់ ឲ្យ មាន និរន្តរភាព សម្រាប់ កូនចៅ ជំនាន់ ក្រោយ ៕
ការទទួល សម្ភារ បរិក្ខារ ខាងលើ នេះ ធ្វើឡើង ក្នុង ជំនួប រវាង លោក ថោង ខុន រដ្ឋមមន្រ្តី ក្រសួង ទេសចរណ៍ ជាមួយ លោក ឧកញ៉ា តាំង គួង នា ព្រឹក ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នៅ ទីស្ដីការ ក្រសួង ទេសចរណ៍ ។
លោក រដ្ឋមន្រ្តី បាន កោតសរសើរ ដល់ ក្រុមហ៊ុន ដែល បាន ផលិត ទឹក សម្លាប់ មេរោគ ប្រកបដោយ ស្តង់ដា និង គុណភាព ខ្ពស់ នៅ កម្ពុជា ដែល ជា ការចូលរួមចំណែក ដល់ ការការពារ ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ និង មេរោគ នានា ។
លោក ឧកញ៉ា តាំង គួង បាន ថ្លែងអំណរគុណ ដល់ លោក រដ្ឋមន្រ្តី ថោង ខុន ចំពោះ ការគាំទ្រ ដល់ ផលិតផល របស់ ក្រុមហ៊ុន ដែល លោក តែងតែ គិតគូរ ដល់ ការចូលរួម ទប់ស្កាត់ ការរីករាលដាល នៃ ជំងឺ និង ការជំរុញ ការអភិវឌ្ឍ វិស័យ ទេសចរណ៍ ប្រកបដោយ ចីរភាព ។
នា ឱកាស នោះ ក្រុមហ៊ុន បាន ចូលរួម ឧបត្ថម្ភ ដល់ ក្រសួង ទេសចរណ៍ នូវ ទូសម្លាប់ មេរោគ ១ គ្រឿង ម៉ាស៊ីន សម្លាប់ មេរោគ ក្នុង បរិយាកាស ៥ គ្រឿង ម៉ាស៊ីន វាស់ កម្តៅ និង លាង ដៃ ដោយ ស្វ័យប្រវត្តិ ១ គ្រឿង ទឹក សម្លាប់ មេរោគ ចំណុះ ១០០ មីលីលីត្រ ៤៨០ ដប ទឹក សម្លាប់ មេរោគ ចំណុះ ៥០០ មីលីលីត្រ ២៤ ដប ទឹក សម្លាប់ មេរោគ សម្រាប់ Refill ចំណុះ ១០ លីត្រ ៣០ ប្រអប់ ដើម្បី ប្រើប្រាស់ តាម ការចាំបាច់ ក្នុង ការចូលរួម បង្ការ ទប់ស្កាត់ មេរោគ ផ្សេង ៗ ពិសេស នៅក្នុង ដំណាក់កាល នៃ ការរីករាលដាល ជំងឺ កូវីដ១៩ នេះ ។
កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ប្ញស្សីកែវ ទទួល អង្ករ១តោន ពី សប្បុរសជន ដើម្បី ត្រៀម ចែកជូន ពលរដ្ឋ ងាយ រងគ្រោះ
( ភ្នំពេញ ) ៖ អនុសាខា កាកបាទ ក្រហម កម្ពុជា ខណ្ឌ ប្ញស្សីកែវ ដឹកនាំ ដោយ ប្រធាន កិត្តិយស និង ជា អភិបាល ខណ្ឌ ជា ពិសី បាន ទទួល អំណោយ ជា អង្ករ ចំនួន ១តោន ពី លោក ហួន សីហា ដែល ជា សប្បុរសជន សម្រាប់ រក្សា ត្រៀម ទុក ចែកជូន ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ក្នុង មូលដ្ឋាន ។
ពិធី ប្រគល់ និង ទទួល អង្ករ ចំនួន ១តោន ដើម្បី ត្រៀម ទុក ចែកជូន ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ ក្នុង មូលដ្ឋាន នេះ ក៏ មាន ការចូលរួម ពី អស់ លោក ប្រធាន និង អនុប្រធាន តាម បណ្ដា ការិយាល័យ ជុំ នាញ ចំនួន ផងដែរ ដែល បាន រៀបចំ ធ្វើឡើង នៅ សាលា ខណ្ឌ ឫស្សីកែវ នា ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ ។
អ្ន កនាំ ពាក្យ ក្រសួង ការបរទេស ចិន លោក វ៉ាង វិន ពីន (Wang Wenbin) បាន បញ្ជាក់ នៅក្នុង សន្និសីទ សារព័ត៌មាន ប្រចាំ ថ្ងៃព្រហស្បតិ៍ នេះ ថា « បន្ទាប់ពី ការពិចារណា យ៉ាង ល្អិតល្អន់ ប្រទេស ចិន បាន សម្រេចចិត្ត ថា នឹង ផ្អាក ជា បណ្តោះអាសន្ន នូវ ជើងហោះហើរ ទាំង ទៅ និង មកពី ចក្រភព អង់គ្លេស ។ ចិន ក៏ នឹង បន្ត តាមដាន ស្ថានការណ៍ ទៅ មុខ ទៀត ផងដែរ ហើយ នឹង ចាត់ វិធានការណ៍ ជា បន្តបន្ទាប់ ទៅ តាម ការវិវឌ្ឍ ស្ថានការណ៍ ជាក់ស្តែង » ។
ឥណ្ឌូនេស៊ី សម្រេច ផ្អាក ជើងហោះហើរ ពី ចក្រភព អង់គ្លេស ដើម្បី ព្យាយាម ទប់ស្កាត់ ជំងឺ កូវីដ - ១៩ ទម្រង់ ថ្មី
( ហ្សាកាតា ) ៖ ឥណ្ឌូនេស៊ី នៅ ថ្ងៃព្រហស្បតិ៍ នេះ បាន សម្រេច ហាមឃាត់ អ្នកធ្វើដំណើរ ពី ចក្រ អង់គ្លេស និង បាន ចាត់ វិធានការរឹតបន្តឹង សម្រាប់ អ្នក ដែល ធ្វើដំណើរ មកពី អឺរ៉ុប និង អូស្ត្រាលី ផងដែរ ដើម្បី ព្យាយាម ទប់ស្កាត់ ការឆ្លង រីករាលដាល នៃ ជំងឺ COVID-19 ទម្រង់ ថ្មី ដែល កំពុង យាយី នៅ តាម បណ្តា ប្រទេស ទាំងនោះ ។ នេះ បើ យោង តាម ការចេញផ្សាយ ដោយ សារព័ត៌មាន CNA នៅ យប់ ថ្ងៃព្រហស្បតិ៍ ទី២៤ ខែធ្នូ ឆ្នាំ ២០២០ ។
គួរ បញ្ជាក់ ថា ប្រទេស ឥណ្ឌូនេស៊ី គឺជា ប្រទេស ដែល រងគ្រោះ ធ្ងន់ធ្ងរ ជា គេ បំផុត នៅ អាស៊ី អាគ្នយ៍ ជាមួយនឹង ករណី ឆ្លង សរុប ៦៩២. ៨៣៨ ករណី ក្នុង នោះ ស្លាប់ ២០. ៥៨៩ នាក់ ៕
កាកបាទ ក្រហម កម្ពុជា នឹង ចាត់ចែង ថវិកា នេះ ដេីម្បី ទិញ ស្បៀង - សម្ភារ ប្រេី ប្រាស់ នាំយក ទៅ ចែកជូន ដល់ ប្រជាពលរដ្ឋ ងាយ រងគ្រោះ បំផុត និង ប្រជាពលរដ្ឋ រងគ្រោះ ដោយ គ្រោះ មហន្តរាយ ផ្សេង ៗ ដោយ ផ្ទាល់ ដៃ ។
អំណោយ ខាងលើ នេះ គឺជា សក្ខីភាព នៃ ទឹកចិត្ត ជ្រះថ្លា របស់ សប្បុរស ជនជាតិ - អន្តរជាតិ ដែល បាន បង្ហាញ ពី ស្មារតី នៃ ការចែករំលែក និង កម្លាំង សាមគ្គី គ្នា របស់ ប្រជាជន ខ្មែរ « ស្រឡាញ់ គ្នា ក្នុង គ្រា ក្រ ស្គាល់ មិត្ត ល្អ ក្នុង គ្រា មាន អាសន្ន ខ្មែរ ជួយ ខ្មែរ ខ្មែរ កាន់តែ រឹងមាំ » ។
( ភ្នំពេញ ) ៖ ក្រសួង ទេសចរណ៍ បាន ត្រៀមលក្ខណៈ រួច ជាស្រេច ក្នុង ការដាក់ ឱ្យ អនុវត្ត ផែនទី ចង្អុល ផ្លូវ ស្តីពី ផែនការស្តារ និង លើកស្ទួយ វិស័យ ទេសចរណ៍ ក្នុង និង ក្រោយ វិបត្តិ ជំងឺ កូវីដ១៩ ឆ្នាំ ២០២០ - ២០២៥ ក្រោម ការរំពឹងទុក ថា នឹង ទទួលបាន ការសម្រេច ពី រាជ រដ្ឋាភិបាល ក្នុង ពេល ឆាប់ ៗ ខាងមុខ ។
ការបញ្ជាក់ នេះ ធ្វើឡើង នៅក្នុង កិច្ចប្រជុំ ក្រុមការងារ ជំនាញ របស់ ក្រសួង ទេសចរណ៍ នា ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ ក្រោម អធិបតីភាព លោក រដ្ឋមន្រ្តី ថោង ខុន នៅ ទីស្ដីការ ក្រសួង ទេសចរណ៍ ។
អង្គប្រជុំ បាន ឱ្យដឹង ថា សេចក្តីព្រាង ផែនទី ចង្អុល ផ្លូវ នេះ ត្រូវបាន ដាក់ ឆ្លង កិច្ចប្រជុំ គណៈកម្មាធិការ ជាតិ អភិវឌ្ឍន៍ ទេសចរណ៍ និង បាន ទទួល ការឯកភាព គាំទ្រ ពី គ្រប់ ក្រសួង - ស្ថាប័ន ពាក់ព័ន្ធ ហើយ គ្រោង នឹង ដាក់ ឆ្លង កិច្ចប្រជុំ គណៈកម្មាធិការ ជាតិ អភិវឌ្ឍន៍ ទេសចរណ៍ ចុងក្រោយ មុននឹង ដាក់ ឆ្លង រាជ រដ្ឋាភិបាល នា ពេល ឆាប់ ៗ ខាងមុខ នេះ ។
សេចក្តីព្រាង ផែនទី ចង្អុល ផ្លូវ ខាងលើ នេះ ចែកចេញ ជា បី ដំណាក់កាល រួម មាន៖
អាជ្ញាធរ ជាតិ អប្សរា បញ្ចប់ ការជួសជុល ប្រាសាទ ដំរី ក្រាប នៅលើ ខ្នងភ្នំ គូលែន
( សៀមរាប ) ៖ នាយកដ្ឋាន អភិរក្ស ប្រាសាទ ក្រៅ ឧទ្យាន អង្គរ នៃ អាជ្ញាធរ ជាតិ អប្សរា បាន បញ្ចប់ ការជួសជុល ប្រាសាទ ដំរី ក្រាប នៅលើ ភ្នំ គូលែន ដោយ ប្រាសាទ នេះ មាន ខឿន ពុក ផុយ និង ស្រុត ផ្នែក ខាងលិច ។ រីឯ ជញ្ជាំង មាន ប្រេះ ហែក ជាច្រើន កន្លែង ស៊ុម ទ្វារ ខាងកើត បម្រុង ជ្រុះ ធ្លាក់ និង មាន ការពុក ផុយ ផ្នែក ខ្លះ នៃ ដំបូល ។
ការខូចខាត ទាំងនេះ បណ្តាល មកពី កត្តា មនុស្ស ធម្មជាតិ និង អាយុកាល ដែល ជា មូលហេតុ ចម្បង ដូចជា មាន ជន ខិលខូច ជីក កកាយ គ្រឹះ ប្រាសាទ ឫស ឈើ ដុះ ចាក់ ហែក ខឿន ជញ្ជាំង និង ដំបូល ប្រាសាទ ហើយ ដើមឈើ ខ្លះ ទៀត រលំ សង្កត់ លើ តួ ប្រាសាទ ។
ក្នុង ការងារ ជួសជុល ក្រុមការងារ បាន ពង្រឹង ខឿន ដែល ពុក ផុយ នៅ ជ្រុង ទាំង ៤ រៀប ពង្រឹង ខឿន ផ្នែក ខាងលិច ដែល ស្រុត ចាក់ ថ្នាំ សម្លាប់ កូន រុក្ខជាតិ និង សម្អាត ឫស ដើមឈើ ដែល ដុះ លើ ជញ្ជាំង និង ដំបូល ប្រាសាទ ដើម្បី បញ្ឈប់ ការលូតលាស់ របស់ ដើមឈើ បន្ត ទៀត ។
( ភ្នំពេញ ) ៖ លោក វេង សាខុន រដ្ឋមន្ត្រី ក្រសួង កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ នៅ រសៀល ថ្ងៃទី ២៤ ខែធ្នូ ឆ្នាំ ២០២០ នេះ បាន ដឹកនាំ កិច្ចប្រជុំ ដើម្បី ធ្វើ ការផ្សព្វផ្សាយ និង ពិភាក្សា អំពី ការងារ ប្រមូល ទិន្នន័យ ស្ថិតិ កសិកម្ម និង ការបូកសរុប បញ្ចប់ ការងារ បង្កបង្កើន ផល រដូវ វស្សា ឆ្នាំ ២០២០ ដែល រៀបចំឡើង ដោយ អគ្គ នាយកដ្ឋាន កសិកម្ម ។
កិច្ចប្រជុំ ក៏ មាន ការអញ្ជើញ ចូលរួម ពី ប្រធាន មន្ទីរ កសិកម្ម រុក្ខា ប្រមាញ់ និង នេសាទ ទូទាំង ២៥ រាជធានី - ខេត្ត និង មន្រ្តី ។
លោក រដ្ឋមន្ត្រី បាន លើកឡើង ថា ស្ថិតិ ដំណាំ កសិកម្ម មាន តួនាទី យ៉ាង សំខាន់ ក្នុង ការអភិវឌ្ឍ វិស័យ កសិកម្ម ក៏ ដូចជា ការអភិវឌ្ឍ សេដ្ឋកិច្ច ទាំងមូល ពីព្រោះ វា គឺជា សូចនាករ មួយ អាច វិភាគ និង ឆ្លុះបញ្ចាំង ឱ្យ ឃើញ នូវ ការប្រែប្រួល និង លើក វិធានការ ដើម្បី ទប់ស្កាត់ នូវ រាល់ បាតុភាព អសកម្ម ដែល ជះ ឥទិ្ធពល មក លើ គម្រោង ឬ កម្មវិធី អភិវឌ្ឍន៍ វិស័យ កសិកម្ម ទាំង ក្នុង រយ: ពេល ខ្លី និង រយ: ពេល វែង រួមទាំង មាន វិធានការ ទប់ស្កាត់ នូវ បាតុភាព អតុល្យភាព « រវាង ផ្គត់ផ្គង់ និង តម្រូវការ » ។
លោក រដ្ឋមន្ត្រី បន្ត ថា ជារៀងរាល់ ឆ្នាំ ក្រសួង បាន រៀបចំ ចង ក្រង និង ផ្សព្វផ្សាយ ឯកសារ ស្ថិតិ ស្តីពី ដំណាំ កសិកម្ម ប្រចាំ ឆ្នាំ ដែល តួលេខ ទាំងអស់ បាន ធ្វើ ការដកស្រង់ និង បូកសរុប ដោយ ផ្អែក ទៅ លើ ការធ្វើ អង្កេត របាយការណ៍ របស់ មន្ទីរ ។ ការប្រមូល ទិន្នន័យ ស្ថិតិ ដំណាំ កសិកម្ម បាន អនុវត្ត ដោយ ផ្អែក លើ ការបូកបញ្ចូល ទិន្នន័យ នៅ រដូវ វស្សា ( ចាប់ពី ខែមេសា ដល់ តុលា ) និង រដូវ ប្រាំង ( ចាប់ពី ខែវិច្ឆិកា ដល់ ខែមីនា ) ។
លោក ងិន ឆាយ ប្រតិភូ រាជ រដ្ឋាភិបាល កម្ពុជា ទទួលបន្ទុក ជា អគ្គ នាយក នៃ អគ្គ នាយកដ្ឋាន កសិកម្ម បាន ឲ្យដឹង ថា លទ្ធផល នៃ ការចុះ ស្រង់ ស្ថិតិ ឆ្នាំ ២០២០ នៃ ដំណាំ កសិកម្ម សម្រេចបាន លទ្ធផល ដូច ខាងក្រោម៖
ឆ្លៀត យក ឱកាស នេះ លោក រដ្ឋមន្ត្រី បាន ធ្វើ ការណែនាំ បន្ថែម ដល់ ថ្នាក់ដឹកនាំ អគ្គ នាយកដ្ឋាន កសិកម្ម មន្ទីរ និង មន្រ្តី ជំនាញ ទាំងអស់ ដែល មាន ខ្លឹមសារ ទាក់ទ ង៖
ទី១៖ អគ្គ នាយកដ្ឋាន កសិកម្ម ត្រូវ សម្រួល ការបូកសរុប ទិន្នន័យ ផលិតកម្ម ដំណាំ កសិកម្ម ចាប់ពី ឆ្នាំ ២០២០ ដោយ ចាប់ផ្តើម ពី ថ្ងៃទី១ ខែមករា និង បញ្ចប់ នៅ ថ្ងៃទី ៣១ ខែធ្នូ នៃ ឆ្នាំ នីមួយ ៗ ពោលគឺ បូក ទិន្នន័យ រដូវ ប្រាំង ជាមួយនឹង ទិន្នន័យ រដូវ វស្សា ។
ទី៤៖ មន្ទីរ ត្រូវ ធ្វើ របាយការណ៍ បង្កបង្កើន ផល ដំណាំ ស្រូវ ដំណាំ សាក វប្បកម្ម រយៈពេល ខ្លី និង ដំណាំ ឧស្សាហកម្ម រយៈពេល ខ្លី ( ដំណាំ រដូវ ) ប្រចាំ ថ្ងៃ សប្តាហ៍ ខែ ត្រី មាស ឆមាស និង ប្រចាំ ឆ្នាំ ប្រកប ដោយ ប្រសិទ្ធភាព និង តម្លាភាព ។
ទី៥៖ មន្ទីរ ត្រូវ ធ្វើ របាយការណ៍ បង្កបង្កើន ផល ដំណាំ សាក វប្បកម្ម រយៈពេល វែង និង ដំណាំ ឧស្សាហ កម្ម រយៈពេល វែង ប្រចាំ ត្រីមាស ឆមាស និង ឆ្នាំ ។
ទី៦៖ អគ្គ នាយកដ្ឋាន និង មន្ទីរ ត្រូវ សម្របសម្រួល និង ចុះ ប្រមូល ទិន្នន័យ ដំណាំ កសិកម្ម ទាំង កម្រិត គ្រួសារ ការវិនិយោគ និង ក្រុមហ៊ុន ដី សម្បទាន សេដ្ឋ - កិច្ច ឱ្យ បាន គ្រប់ ជ្រុងជ្រោយ ។
ទី៧៖ មន្ទីរ ត្រូវ សម្របសម្រួល កត់ត្រា ការនាំចេញ កសិផល ក្រៅ ផ្លូវការ តាម ខេត្ត នីមួយ ៗ លើ មុខ ដំណាំ សំខាន់ ៗ និង រាយការណ៍ មក អគ្គ នាយកដ្ឋាន កសិកម្ម ជា ប្រចាំ ថ្ងៃ ព្រមទាំង ត្រូវ សហការ ក្តាប់ ឱ្យ បាន អំពី ការនាំចូល កសិផល តាម ច្រក ព្រំដែន នានា ។
ទី៨៖ អគ្គ នាយកដ្ឋាន កសិកម្ម និង នាយកដ្ឋាន ផែនការ ស្ថិតិ ត្រូវ រៀបចំ ប្រព័ន្ធ ប្រមូល ទិន្នន័យ ឱ្យ បាន ច្បាស់លាស់ គ្រប់ ជ្រុងជ្រោយ ដើម្បី ធ្វើឱ្យ ស្ថិតិ កាន់តែ មាន ភាពសុក្រឹត ។
ទី៩៖ មន្ទីរ ត្រូវ រាយការណ៍ ទិន្នន័យ គ្រប់ ប្រភេទ តាម ទម្រង់ ដែល បាន កំណត់ ទៅ ស្ថាប័ន ពាក់ព័ន្ធ ឱ្យ ទាន់ ពេលវេលា និង មាន សង្គតិភាព ។
ដោយឡែក នៅ ភូមិ កំពង់ប្រាសាទ ឃុំ សែប ស្រុក កំពង់ត្រឡាច គឺជា គោលដៅ មួយ ក្នុង ចំណោម គោលដៅ ជាច្រើន ទៀត ដែល ប្រជាកសិករ បាន នាំគ្នា មក ទិញ ត្រី ធ្វើ ប្រហុក ផ្អក បងប្អូន ប្រជាពលរដ្ឋ ទាំងនោះ មាន មកពី ស្រុក ទឹក ផុស ស្រុក សាមគ្គី មាន ជ័យ ខេត្ត កំពង់ឆ្នាំង និង មកពី ស្រុក ឧដ្ដុង្គ ខេត្ត កំពង់ស្ពឺ ជាដើម ។
លោក ខៀវ ផារិទ្ឋ នាយ រង ផ្នែក រដ្ឋបាល ជល ផល កំពង់ប្រាសាទ ដែល កំពុង តាម ឃ្លាំមើល ទិន្នផល ត្រី នៅ ទីនោះ បាន ឲ្យដឹង ថា តម្លៃ ត្រី គឺ មិន ស្ថិតស្ថេរ នោះ ទេ នៅពេល ដែល ខ្សត់ បន្តិច វា នឹង ឡើង ថ្លៃ រហូតដល់ ពី ៦ ពាន់ ទៅ ៧ ពាន់ រៀល ដូច ប្រជាពលរដ្ឋ លើកឡើង មែន ប៉ុន្តែ នៅ ពេល ដែល ត្រី វា សំបូរ នឹង ចុះ ថ្លៃ ត្រឹម ២ពាន់ រៀល ប៉ុណ្ណោះ ។ តាម ការព្យាករណ៍ របស់ លោក ត្រី នឹង បន្ត ត្រូវ រយៈពេល ៥ ថ្ងៃ ទៀត ។
ឆ្លៀត ឱកាស នេះ លោក ក៏ សូម អំពាវនាវ ដល់ បងប្អូន ប្រជាពលរដ្ឋ ដែល ត្រូវការ ត្រី ធ្វើ ប្រហុក ផ្អក សូមអញ្ជើញ ចុះ មក ទិញ នៅ គ្រប់ ទីកន្លែង ដូចជា កំពង់ប្រាសាទ ជើង កំពង់ឆ្នុក ទ្រូ ស្រុក បរិបូណ៌ និង ក្រុង កំពង់ឆ្នាំង ។ បច្ចុប្បន្ន ត្រី មាន តម្លៃ ដូច ដែល បាន បញ្ជាក់ ជូន ខាងលើ នេះ ៕
មណ្ឌល អប់រំ កែប្រែ ទី៤ បរិច្ចាគ ៦.៨០៦.០០០ រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន ទិញ វ៉ាក់សាំង កូវីដ១៩
( ភ្នំពេញ ) ៖ មណ្ឌល អប់រំ កែប្រែ ទី៤ ( អគ្គ នាយកដ្ឋាន ពន្ធនាគារ ) បាន បរិច្ចាគ ថវិកា ៦.៨០៦.០០០ រៀល ជូន សម្តេច តេជោ ហ៊ុន សែន នាយក រដ្ឋមន្ត្រី នៃ កម្ពុជា ដើម្បី ទិញ វ៉ាក់សាំង ប្រឆាំង មេរោគ កូវីដ១៩ ។
សូម បញ្ជាក់ ថា សម្តេច តេជោ ហ៊ុន សែន នៅ ល្ងាច ថ្ងៃទី ០៧ ខែធ្នូ ឆ្នាំ ២០២០ បាន ប្រកាស ពី ការត្រៀម បម្រុង ថវិកា សម្រាប់ ទិញ វ៉ាក់សាំង យកមក ចាក់ ជូន ប្រជាជន ដោយ ឥត គិត ថ្លៃ ជា ជំហាន ដំបូង ចំនួន ១លាន ដូស ដើម្បី ចាក់ ជូន ប្រជាពលរដ្ឋ ប្រមាណ ៥០ម៉ឺន នាក់ ៕ UN សោកស្ដាយ ចំពោះ លោក ត្រាំ ដែល លើកលែង ទោស ឱ្យ អ្នកសម្លាប់ ជន ស៊ីវិល អ៉ីរ៉ាក់ ១៤ នាក់
( ហ្សឺណែវ ) ៖ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស (OHCHR) នៅ ថ្ងៃពុធ សប្ដាហ៍ នេះ បាន សម្តែង ការសោកស្ដាយ និង ព្រួយបារម្ភ យ៉ាង ខ្លាំង ជុំវិញ ការលើកលែងទោស របស់ ប្រធានាធិបតី អាមេរិក ចំពោះ កង សន្តិសុខ ចំនួន ៤នាក់ របស់ ក្រុមហ៊ុន យោធា ឯកជន Blackwater ដែល ត្រូវបាន កាត់ទោស ពី បទ សម្លាប់ ជន ស៊ីវិល ចំនួន ១៤នាក់ នៅ អ៉ីរ៉ាក់ ។ នេះ បើ តាម ការចេញផ្សាយ ដោយសារព័ត៌មាន ចិន ស៊ីន ហួរ នៅ ថ្ងៃព្រហស្បតិ៍ ទី២៤ ខែធ្នូ ឆ្នាំ ២០២០ ។
នៅក្នុង សេចក្តីថ្លែងការណ៍ មួយ លោក Marta Hurtado អ្នកនាំពាក្យ ការិយាល័យ ឧត្តម ស្នងការ អង្គការ សហ ប្រជាជាតិ ទទួលបន្ទុក សិទ្ធិ មនុស្ស បាន លើកឡើង យ៉ាង ដូច្នេះ ថា៖ « ការលើកលែង ទោស ឲ្យ ពួកគេ គឺ បាន រួមចំណែក ដល់ និទណ្ឌភាព និង មាន ឥទ្ធិពល ជម្រុញ ឲ្យ អ្នកដទៃ ទៀត ប្រព្រឹត្ត ឧក្រិដ្ឋកម្ម បែប នេះ នា ពេល អនាគត » ។ សេចក្តីថ្លែងការណ៍ នេះ ដដែល បាន បញ្ជាក់ ទៀត ថា បុគ្គល ទាំង ៤នាក់ នេះ ត្រូវបាន ផ្តន្ទាទោស ដាក់ ពន្ធនាគារ ពី ១២ ឆ្នាំ ដល់ អស់ មួយ ជីវិត រួមទាំង ការចោទប្រកាន់ ពី បទ ឃាតកម្ម កម្រិត ទី១ ផងដែរ ។
តាមរយៈ ការស៊ើបអង្កេត លើ ឧក្រិដ្ឋកម្ម ទាំង នេះ និង ការបំពេញ នីតិវិធី ច្បាប់ សហរដ្ឋ អាមេរិក បាន បំពេញ កាតព្វកិច្ច របស់ ខ្លួន នៅក្រោម ច្បាប់ អន្តរជាតិ ដោយ ជនរងគ្រោះ ពី ការរំលោភ សិទ្ធិ មនុស្ស មាន សិទ្ធិ មើលឃើញ ជនល្មើស ទាំងនេះ ទទួល ការផ្តន្ទាទោស សមាមាត្រ នឹង ស្ថាន ទម្ងន់ ទោស ដែល ពួកគេ បាន ប្រព្រឹត្ត ។
ការសម្រេច ឃុំ ខ្លួន ជន ត្រូវ ចោទ ទាំង ពីរ នាក់ នេះ ធ្វើឡើង បន្ទាប់ពី តំណាង អយ្យការ លោក ឡុង ជាប បាន ចោទ ពួកគេ ពី បទ ឃាតកម្ម ដោយ គិត ទុក ជាមុន កាន់កាប់អាវុធ ចុស ច្បាប់ និង បទ ចោទ មួយ ទៀត គឺ សម គំនិត តាម បញ្ញត្តិ មាត្រា ២០០ មាត្រា ៤៩០ និង មាត្រា ២៩ នៃ ក្រម ព្រហ្មទណ្ឌ ។
នគ បាល ព្រហ្មទណ្ឌ ខណ្ឌ កំបូល នៃ ស្នងការ រាជធានី ភ្នំពេញ កាលពី ព្រឹក ថ្ងៃទី ២២ ខែធ្នូ ឆ្នាំ ២០២០ បាន បញ្ជូន ខ្លួន ជនសង្ស័យ ទាំង ពីរ ខាងលើ ទៅកាន់ សាលាដំបូង រាជធានី ភ្នំពេញ ដើម្បី ប្រគល់ ជូន តំណាង អយ្យការបើក ការស៉ើប សួរ និង ឈាន ទៅរក ការចោទប្រកាន់ តាម ច្បាប់ ។ ពួកគេ ធ្វើ សកម្មភាព ទាក់ទង នឹង ករណី បាញ់ សម្លាប់ ឈ្មោះ នៅ ចំណាន ដោយ មូលហេតុ ពួក ខ្លួន ជំពាក់ ប្រាក់ ជនរងគ្រោះ ច្រើន ហើយ គ្មាន លទ្ធភាព សង ទើប រៀប ផែនការបាញ់ សម្លាប់ ជនរងគ្រោះ ។
