ប្រភពអាចនឹងត្រូវបានគេបំភិត បំភ័យ ។
ពេល រៀបចំ ផ្លែ ឈើ ត្រូវ បើក ភ្នែក មើល ថា តើ ពួកគេ ជោគជ័យ ប៉ុណ្ណា ។
ជន ជាតិអ៊ីស្រាអែលពោលថា៖ ‹ ថ្ងៃ ស ប្ប័ទរបស់យើងពិតជាអ្នក រាល់គ្នាមែន
១៥ « ដ្បិតបើអ្នកបែរចេញពីការ ដើរតាមទ្រង់ នោះទ្រង់នឹងទុកពួកគេនៅទី រហោស្ថានម្ដងទៀត ហើយអ្នកនឹងបំផ្លាញប្រជាជនទាំងអស់នេះ » ។
អស្ចារ្យណាស់ដែលខ្ញុំមានក្នុងរយៈពេលពីរបីឆ្នាំចុងក្រោយនេះ » ។
អ្នកដែលអង្គុយក្នុង ភាពងងឹតបានឃើញពន្លឺដ៏ អស្ចារ្យ ។
បពិត្រ ព្រះអង្គ ដ៏ ចម្រើន សម្មាសម្ពុទ្ធ
អ្នក បាន ចាកចេញ ពី ព្រះអម្ចាស់ ។
ប៉ុន្តែ ស្ត្រី នៅ ទូទាំង ពិភពលោក ស្បថ នឹង វា ។
ជ្រើសរើស ពួកវា មួយចំនួន ឬ បំពេញ រាល់ ចលនា ហើយ អនុវត្ត ដូច ។
« បើអ្នក ស្រឡាញ់ខ្ញុំ ចូរប្រតិបត្តិតាម បញ្ញត្តិរបស់យើង ។
« បើអ្នក ស្រឡាញ់ខ្ញុំ ចូរប្រតិបត្តិតាម បញ្ញត្តិរបស់ខ្ញុំ ។
ដ្បិតគេខ្លាចទ្រង់ ពីព្រោះហ្វូងមនុស្សទាំងមូលភ្ញាក់ផ្អើលនឹងការ បង្រៀនរបស់ទ្រង់ ។
ការជ្រើសរើស គួរឱ្យ ចាប់អារម្មណ៍ សូមមើល អ្វី ដែល គាត់ ធ្វើជាមួយ ទស្សនាវដ្តី ។
10 ខ្ញុំសូមអង្វរអ្នក ចំពោះកូនរបស់ខ្ញុំ អូណេស៊ីម ដែលបានក្លាយជាកូនរបស់ខ្ញុំ កាលខ្ញុំជាប់គុក ។
ក្រោយពីឪពុកខ្ញុំស្លាប់ ខ្ញុំមិនបានសរសេររយៈពេលប្រាំមួយខែ មកហើយ ។
នេះ ត្រូវបាន កំណត់ ដោយ សញ្ញា របស់ អ្នក និង សមាសភាព រាងកាយ មនុស្ស របស់ អ្នក ។
ម្ចាស់គាត់ដែលទៅធ្វើការ នៅម៉ោង៧ ព្រឹក ត្រឡប់មកវិញ១២ ម៉ោងក្រោយ ។
មិនគិតថាខ្ញុំបានឮអ្វីផ្សេងពីពួកគេ ?
“ វានឹងមានការ លំបាកស្មើគ្នាក្នុងការ ប្រកួតជាមួយពួកគេ ទោះមានឬគ្មាន Ronaldo ។
កុំ ភ្លេច សាតាំង ចង់ បំផ្លាញ អ្នក !
ដូច្នេះ ពួកគេ កំពុង ឃើញ អ្វី មួយ ។
អ្វី ៗអាចនឹងលំបាកនៅពេលដំបូង ប៉ុន្តែវានឹងប្រសើរឡើងនៅពេលក្រោយ ។
ខ្ញុំ ចង់ ឃើញ វា នៅក្នុង
ការអធិស្ឋាន សម្រាប់ កុមារ ។
នៅជិត ផ្ទះ ខ្ញុំ ដែរ ។
២២ ព្រោះអ្នកដឹងក្នុង ចិត្តថា អ្នក បាននិយាយអាក្រក់ ពីអ្នក ដទៃ ជាច្រើនដង ។
ហើយ មួយចំនួន ធំ នៃ ពួកគេ ដូចជា បារ៉ាក់ អូបាម៉ា ។
មនុស្ស បែប នេះ គឺជា អ្នក បោក បញ្ឆោត និង ជា មេ ប្រឆាំង ព្រះគ្រិស្ដ ។
ម្នាលអ្នកឯងស្អាតហើយ ព្រោះពាក្យដែល តថាគតនិយាយនឹងអ្នក ហើយ ។
ជំនាញ រូប មន្ត ដំបូង សម្រាប់ អេកូ បាន មកពី រូប មន្ត ទាំងអស់ ហើយ ឥឡូវនេះ វា ដំណើរការ ជាមួយ បណ្តាញ អាហារ ផងដែរ ។
ជីវិត របស់ ពួកគេ នៅតែ បន្ត ។
កុំ ព្យាយាម ធ្វើឱ្យ មនុស្ស ចូលចិត្ត អ្នក ច្រើន ជាង គាត់ ( អ្នក ជា មនុស្ស ល្អ គ្រប់គ្រាន់ ) ។
មនុស្សគ្រប់គ្នាក្នុងចំណោម ១០០នាក់នោះអាចជាប់គុក ប៉ុន្តែនាងមិនអាចទេ ?
« ចូរធ្វើបុណ្យចម្លងថ្វាយព្រះ‌ អម្ចាស់ ជាព្រះ របស់អ្នក ដូចមានចែងទុកក្នុងសៀវភៅសម្ពន្ធ មេត្រីនេះ » ។
ព្រះជាព្រះវរ បិតាមាន បន្ទូលថា៖ « នេះជាកូនអញដែលអញបានរើស ចូរស្តាប់តាមចុះ !» ។
សត្វ ទាំងអស់ នៅលើ ផែនដី ត្រូវការការ សម្រាក មិន ថា ពេល ថ្ងៃ ឬ ពេល យប់ នោះ ទេ ។
តើ អ្នក ឃើញ ភាពស្មោះត្រង់ របស់ ទ្រង់ ចំពោះ អ្នកទេ ?
លើក ដៃ ឡើង សរសើរ ព្រះនាម ព្រះអម្ចាស់ ។
ហើយអារម្មណ៍នៃយុត្តិធម៌បានវិល មកក្នុង ចិត្តមនុស្សវិញបន្តិចម្តង ៗ
នាង បាន ជួយ ខ្ញុំ ស្វែងរក អ្វី ដែល ខ្ញុំ កំពុង ស្វែងរក ។
កាន់តែ ប្រសើរ ឬ អាក្រក់ ជាង នេះ ( បច្ចុប្បន្ន ) រហូតដល់ ការដាច់ចរន្ត អគ្គិសនី ធ្វើឱ្យ ពួកយើង ជា ផ្នែក មួយ ។
បន្ទាប់មក គាត់បានក្រោកឡើង ហើយដើរតាមលោកអេលី យ៉ា ហើយក្លាយជាជំនួយការ របស់គាត់ ។
« ព្រះជ្រាបថាអ្នកមិនបានផ្ដល់ឱ្យខ្ញុំនូវកំណត់ត្រាស្អាតស្អំមក ទល់ ពេលនេះទេ » ។
មនុស្ស រស់ នៅ ដោយ ភ័យខ្លាច សត្វ ទាំងនេះ ។
ធ្វើ ដើម្បី ជួយ កុមារ ទាំង នេះ ។
សម្តេច សង្ឃដាឡៃ ឡាម៉ា បានមកទីនេះ ។
ខ្ញុំបានយកគាត់ទៅ កាន់ព្រះរាជអាជ្ញាវិញ ។
ក៏ ដូចជា អ្នក អាច ធ្វើ បាន
ពួកគេ តែងតែ ស្វែងរក ទី សំគាល់ និង អព្ភូតហេតុ ។
មិន មែន សុទ្ធតែ ជា ជនជាតិ អាមេរិក ទេ ។
ដូច្នេះ អ្នក នឹង ត្រូវ ស្វែងរក ការពេញចិត្ត និង ការយល់ដឹង ដ៏ ល្អ នៅក្នុង ព្រះនេត្រ នៃ ព្រះ និង មនុស្ស ។
យើង ដឹង ថា ការប្រគល់ គាត់ ទៅ ព្រះជា ម្ចាស់
« នេះជាបុត្រដ៏ ជាទី ស្រឡាញ់របស់យើង ដែលខ្ញុំពេញ ចិត្តយ៉ាងខ្លាំង ចូរស្ដាប់ទ្រង់ » ។
៦ ហើយអ្នក រាល់គ្នាក៏ស្ថិតក្នុងចំណោមអ្នកដែលត្រូវបានហៅឲ្យ មក ជារបស់ព្រះ យេស៊ូវគ្រីស្ទ ។
ចូលរួម ឥឡូវនេះ ក្លាយជា សមាជិក ។
ជន ជាតិអ៊ីស្រាអែលគោរពបូជារូបព្រះ មួយឈ្មោះថា ដាហ្គន ។
“ សម្ព័ន្ធមិត្ត របស់ ខ្ញុំ នឹង ភ្ញាក់ផ្អើល នៅពេល ដឹង ថា ខ្ញុំ នៅ ទីនេះ ។
ប្រសិនបើអ្នកនឹងទទួល យកវា គាត់គឺជាអេលី យ៉ា ដែលត្រូវ មក ។
តើនរណាជានរណា ហើយពួកគេបានធ្វើអ្វី ?
ឥឡូវ នេះ ជា ពេល ដែល ត្រូវ ទទួលស្គាល់ កាន់តែ ច្រើន ដើម្បីឲ្យ យើង ខ្លាច តិច ។
សំលៀកបំពាក់ នេះ បាន មកដល់ ទីក្រុង មូស្គូ ក្នុង រយៈពេល 18 ថ្ងៃ ។
ចំពោះអ្នកដែលត្រូវគេបៀតបៀន ស្អប់ និងមានបំណងបំផ្លាញ ។
SL ៖ ខ្ញុំបានចូលរៀនរយៈពេល ៨ ឆ្នាំ មកហើយ ។
ត្រកូល ផ្ទាល់ខ្លួន របស់ Temujin បន្ទាប់មក បាន បោះបង់ ចោល គាត់ ម្តាយ របស់ គាត់ និង បងប្អូន ប្រាំមួយ នាក់ របស់ គាត់ ដើម្បី ជៀសវាង ការចិញ្ចឹម ពួកគេ ។
ប៉ុន្តែខ្ញុំនឹងស្នាក់នៅក្រុងអេភេសូររហូតដល់ថ្ងៃបុណ្យទី៥០ ដ្បិតទ្វារដ៏ អស្ចារ្យ និងមានប្រសិទ្ធភាពបានបើកឲ្យខ្ញុំ ហើយមាន ស ត្រូវជាច្រើន ។
ព្រះយេស៊ូមានព្រះបន្ទូល តបទៅគេ ថា៖ « តើខ្ញុំមិនបានជ្រើស រើសអ្នកទាំងដប់ ពីរនាក់ទេ ហើយម្នាក់ក្នុងចំណោមអ្នក រាល់គ្នាជាអារក្សឬ ? » ។
ជំពាក់បំណុលប្រពន្ធចំពោះប្តីបន្តកើនឡើង ។
ទ្រង់មិនមានការ ភ័យខ្លាចក្នុង ចិត្តឡើយ ។
សរសើរ អ្នក ដ៏ទៃ ។
កុំមានកំហុស យើងនឹងធ្វើការ ជាមួយរដ្ឋាភិបាល លីប៊ី ដើម្បីកាត់ ទោសឃាតករដែលបានវាយ ប្រហារប្រជាជនយើង » ។
ខ្ញុំ បាន និយាយ នៅក្នុង ចិត្ត របស់ ខ្ញុំ ថា ព្រះជាម្ចាស់ នឹង វិនិច្ឆ័យ មនុស្ស សុចរិត និង មនុស្ស អាក្រក់ ; ដ្បិតមានពេលវេលាសម្រាប់គ្រប់គោលបំណង ៦ និងសម្រាប់រាល់ការងារ ។
កុំធ្វើបែបនេះក្រោមក្រមសិទ្ធិមនុស្ស » ។
ពួកគេត្រូវបានសរសើរដោយការ គាំទ្រដ៏ល្អមួយ ,
ឥឡូវនេះ អ្នក ត្រូវ មើល វា នៅក្នុង ទម្រង់ 3D ដែល វា ត្រូវបាន ចេញផ្សាយ ។
ជាងបើកមាត់ហើយដកការសង្ស័យ » ។
ជ្រុង នៃ ផ្នូរ , ត្រូវបាន ប្រមូលផ្តុំ គ្នា តិចតួច នៃ បុរស និង ស្ត្រី ,
គាត់ជាមេ ដឹក នាំរបស់ទាំងអស់ដល់ក្រុមជំនុំ ដែល ជារូប កាយរបស់គាត់ ។
ទ្រង់មិនមែនជាព្រះ នៃមនុស្សស្លាប់ទេ គឺជាព្រះ នៃមនុស្ស រស់វិញ » ។
១ កូរិន ថូស 14:13 ហេតុនេះហើយបានជាអ្នក ណានិយាយភាសា ដទៃត្រូវអធិស្ឋានសុំឲ្យគេ បក ស្រាយពាក្យដែលគេនិយាយ ។
គាត់បានគោរពតាមទីសម្គាល់ដែលបានធ្វើចំពោះគាត់
តោះ ចាប់ផ្តើម បង្កើត គេហទំព័រ នេះ ដោយ ខ្លួន ឯង ។
ក្រុមហ៊ុន ក៏ បាន ឈ្នះ ពានរង្វាន់ ក្រុមហ៊ុន អាកាសចរណ៍ លំដាប់ សេដ្ឋកិច្ច ល្អ បំផុត របស់ ពិភពលោក ផងដែរ ។
ក្នុងការ សម្រេចតាមការសន្យាដែលបានធ្វើចំពោះបិតា
« តើអ្នកដឹងទេថាពួកផារិស៊ីបានអាក់ អន់ ចិត្តបន្ទាប់ពីពួកគេបានឮពាក្យនេះ ?
ថ្ងៃ មួយ នៅ ពេល ដែល មេឃ ស្រឡះ ជាមួយ ពពក ខ្មៅ ងងឹត ភ្លៀង ធ្លាក់ យ៉ាង ខ្លាំង ។
បានឱ្យពួកគេម្នាក់ ៗទទួល ទោស ប្រហារជីវិត ។
យើង ខ្លាច ជីវិត របស់ យើង ហើយ នោះ ជា មូលហេតុ ដែល យើង បញ្ឆោត អ្នក ។
អ្នក បាននិយាយថានៅទីងងឹតនឹង ឮនៅពេលថ្ងៃ ។
ពួកគេត្រូវបានប្រជាជនចាប់យកមក
« ហេតុអ្វីបានជាត្រូវចំណាយពេលរហូតដល់ពេលនេះដើម្បីចេញសេចក្តីថ្លែងការណ៍ ?
គាត់បានធ្វើទាំងអស់ក្នុងអំណាចរបស់គាត់ដើម្បី បញ្ចូលខ្លួនគាត់ទៅក្នុងការ ពេញ ចិត្ត
អ្នក តែងតែ ស្រស់ស្អាត ,
« ប៉ុន្តែ មកដល់ពេលនេះយើងមិនដឹងថាមានអ្នក ណាចង់ទិញគាត់ឬតម្លៃប៉ុន្មានទេ ។
គ្មានការ ពិពណ៌នាណាល្អជាងព្រះ ដែលត្រូវបានផ្ដល់ឲ្យជាងនេះ ទេ៖ ទ្រង់គឺជា « ខ្ញុំដ៏ អស្ចារ្យ » ។
នាយ ព្រែក ប្តឹង សុំ សន្តិភាព ,
អ្នក រាល់គ្នាបានឈរធ្វើជាសាក្សីដល់ព្រះ‌ អម្ចាស់នៅថ្ងៃនេះ ដើម្បីធ្វើជាព្រះ របស់អ្នក ហើយដើរតាមមាគ៌ារបស់ព្រះអង្គ ព្រមទាំង កាន់តាមច្បាប់ និង បញ្ញត្តិ និងការ វិនិច្ឆ័យរបស់ព្រះអង្គ ហើយស្តាប់តាមសំឡេងរបស់ព្រះអង្គ ។
“ ប៉ុន្តែ ជីវិត របស់ ប្រជាជន ឥណ្ឌា មាន តម្លៃ ជាង ឆ្ងាយ ណាស់ ។
៧ បន្ទាប់មកដល់ថ្ងៃបុណ្យនំបុ័ងឥតមេ ដែលកូនចៀមត្រូវបូជាក្នុងបុណ្យចម្លង ។
ថ្ងៃ ណាមួយ អ្នក នឹង ឃើញ ទ្រង់ ដូច ទ្រង់ ។
ពួកគេត្រូវតម្កល់រូបសំណាកថ្វាយព្រះអង្គ » ។
ធ្វើឱ្យអស់ពីសមត្ថភាពជាមួយគាត់ » ។
ក្នុងការ អួតដោយមានទំនុក ចិត្តលើខ្លួនឯងនេះ ខ្ញុំមិនមែននិយាយដូចព្រះ អម្ចាស់ទេ ប៉ុន្តែជាមនុស្សល្ងង់វិញ ។
អារ៉ាប៊ី សាអូឌីត ស៊ើបការណ៍ បាន ប្រាប់ គាត់ ថា " សុំ ការអភ័យទោស ពី ព្រះ!"
១១ហើយឥឡូវនេះ កូនស្រីអើយ កុំខ្លាចអី ខ្ញុំ នឹង ធ្វើ ចំពោះ អ្នក នូវ អ្វី ដែល អ្នក និយាយ ។ ពីព្រោះអ្នកក្រុងទាំងមូលរបស់ខ្ញុំដឹងថាអ្នក ជាស្ត្រីដែលសក្តិសម ។
ជនជាតិ អេស៊ីប ថ្វាយបង្គំ ព្រះព្រះអាទិត្យ
អូខេ យើងមានមនុស្ស ៨ នាក់ហើយ ដែលល្អណាស់ ។
អ្នក បានស្រឡាញ់សេចក្ដី សុចរិត ។
ដោយ ព្យាការី នៃ សម័យ បុរាណ បំភ្លឺ
“ ប្រសិនបើអ្នកនៅជាប់នឹងខ្ញុំ ហើយពាក្យរបស់ខ្ញុំនៅជាប់នឹងអ្នក ចូរសុំអ្វីដែលអ្នកចង់បាន នោះវានឹងបានប្រទាន មកអ្នក ។
ប៉ុន្តែ កាលទ្រង់ ទតឃើញហ្វូងមនុស្ស ទ្រង់មាន ចិត្តអាណិតអាសូរដល់ពួកគេ ពីព្រោះពួកគេ នឿយ ហត់ ហើយបែកខ្ញែកគ្នា » ។
- ព្រះអម្ចាស់មានព្រះបន្ទូលមកអ្នកថា កុំភ័យខ្លាច ឬ តក់ស្លុតដោយ សារតែហ្វូងដ៏ច្រើននេះឡើយ ដ្បិតការ ប្រយុទ្ធមិនមែនជារបស់អ្នកទេ គឺជារបស់ព្រះ។
ខ្ញុំ និងភរិយាពិតជា រីក រាយណាស់ដែលបានមកទីនេះ ។
« មាត់ឯងមិនមែនជាកន្លែងចាក់សំរាមទេ ដូច្នេះយកសំរាមចេញទៅ » ។
គាត់បានដឹងថាសម្ដេច សង្ឃខ្លួនគាត់ផ្ទាល់គឺ មកពីអើរ៉ុន ដែលបានចុះពី អ័ដាម ។
2 ឆ្លើយតប ទៅ វា ងាយស្រួល ធ្វើជា អ្នករិះគន់
សូម ពិនិត្យមើល ស្នាដៃ មិត្ត ខ្ញុំ ខាងក្រោម គាត់ ពិតជា អស្ចារ្យ មែន ។
ខ្ញុំមិនដឹងថាម៉ាហ្វីយ៉ាជានរណាទេ ។
ហាង ឆេង ត្រូវបាន ជង់ លើ ពួកគេ ផងដែរ ប៉ុន្តែ ពួកគេ នៅតែ អាច រៀបការ បាន ។
ដោយ សារ តែអ្នកមិនអាចស្តាប់ព្រះបន្ទូលរបស់ខ្ញុំ ។
ពីព្រោះអ្នក រាល់គ្នាមិនអាចស្តាប់ពាក្យរបស់ខ្ញុំ ។
ដរាបណាខ្ញុំរកឃើញនាង ហើយនាងប្រគល់ប្រពន្ធខ្ញុំមកខ្ញុំវិញ នោះទាំងអស់នឹងត្រូវបានលើកលែង ទោស ហើយនោះនឹងជាទី បញ្ចប់នៃ វា ។
ដូច្នេះ ចូរប្រាប់ការពិត ហើយកំណត់ ត្រាឲ្យត្រង់ ។
ឱ ព្រះវរ បិតាអើយ ពេលវេលាបានមកដល់ហើយ សូមលើក ត ម្កើងបុត្ររបស់ព្រះអង្គ ។
ប៉ុន្តែប្រសិនបើអ្នកអាចយកវាបាន ហើយនិយាយថា 'បាទ វាបានកើតឡើង ហើយវាជាការ ដោះលែងបាន » ។
៦ នៅ គ្រានោះ គ្មានស្ដេចនៅស្រុកអ៊ីស្រាអែលទេ ។ បុរស ម្នាក់ នឹង ធ្វើ អ្វី ដែល ល្អ នៅក្នុង ភ្នែក របស់ គាត់ ។
នេះជាអត្ថបទប្លក់របស់ខ្ញុំទាំងអស់ ។
ថ្ងៃ មួយ បុរស ម្នាក់ បាន រកឃើញ វា ។
ក្នុងនាមជាមាតាបិតា អ្នកត្រូវត្រៀមខ្លួនសម្រាប់ព្រឹត្តិការណ៍ដែលមិនអាចទាយទុកមុនបានកើតឡើង ។
សូម ចាកចេញ ឥឡូវនេះ ក្នុង ព្រះនាម ព្រះយេស៊ូវ ។
អ្នក ដែល ចូលចិត្ត ក្លិន ក្រអូប ផ្សេង ៗ គ្នា អាច ទៅ រក ក្លិន ក្រអូប បាន ។
ណែនាំកូនរបស់អ្នកឱ្យបានត្រឹមត្រូវ និងប្រើកាំបិតដោយសុវត្ថិភាព ។
រហូតមកដល់ពេលនេះ អ្នកមិនបានសុំអ្វីក្នុងនាមខ្ញុំទេ ប៉ុន្តែសូមអ្នកនឹងទទួល ហើយ អំណររបស់អ្នកនឹងពេញ លេញ ។
ហើយបានចាប់ ផ្តើ មខ្ពស់គ្រប់គ្រាន់ដើម្បីមាន , ប្រសិនបើគាត់បានក្លាយជាច្រើនជាងពួកគេ .
សម្រាប់ឆន្ទៈរបស់ជន ជាតិយូដាជាច្រើនក្នុងការ អត់ទោសកំហុសដែលពួកគេបានរងទុក្ខ ជាច្រើនសតវត្ស ។
ទីបំផុតគាត់បានកត់សម្គាល់ខ្ញុំ » ។
ព្រះបាន បង្កើត មនុស្ស ឱ្យ គ្រប់គ្រង លើ ផែនដី ។
ព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « ខ្ញុំបានធ្វើការ អស្ចារ្យមួយ ហើយអ្នក រាល់គ្នាភ្ញាក់ផ្អើល ។
ហើយ ផ្នែក រឹង នៃ ផែនដី គឺជា ភូមិសាស្ត្រ ។
ពួកគេ ក៏ មិន ត្រូវបាន ធ្វើ បច្ចុប្បន្នភាព ផងដែរ ។
សេរីភាព សារព័ត៌មាន ជុំវិញ ពិភពលោក យោង ទៅតាម អង្គការ អ្នកកាសែត គ្មាន ព្រំដែន ។
បាន បន្ត មកដល់ ហើយ មួយចំនួន ទៀត ត្រូវបាន បន្ថែម
ទិន្នន័យ គឺជា អ្វី គ្រប់ យ៉ាង នៅ ក្នុង យុគសម័យ ព័ត៌មាន ។
ព្រះគុណ និង ព្រះគុណ ដែល ព្រះអង្គ បាន បង្ហាញ ព្រះអង្គ ។
អ័ ប្រាហាំមានអាយុចិត សិបប្រាំឆ្នាំ ហើយសារ៉ាមានអាយុហុកសិបប្រាំ នៅពេលដែលព្រះ បានប្រទានដល់ពួកគេតាមការសន្យា ។
ហើយដោយការ ធ្វើដូច្នេះ ពួកគេគ្មានទោសនៅចំពោះព្រះ យេហូវ៉ា ។
ដោយ មិន លំអៀង ទៅ រក អ្នកណា ម្នាក់ គាត់ បាន ជួប ភាគ ច្រើន នៃ ទីក្រុង នៅពេល ថ្ងៃ នៅ ពេលព្រឹក ។
ក្រោយពីធ្វើអាហារពេលព្រឹកនៅ មាត់ច្រាំងស្រុកកាលីឡេ លោកយេស៊ូបានប្រាប់ពេត្រុសអំពីអ្វីដែលនឹងកើតឡើងនៅចុង បញ្ចប់នៃជីវិតរបស់គាត់ ។
ដូចជា ម៉ាទ្រីស នៃ បង្គា ។
ហើយនៅពេលដែលអ្នកបានឮ សារនេះពីរដ្ឋមន្ត្រី វាហាក់ដូចជាមិនអាចត្រឡប់វិញបាន » ។
ប៉ុន្តែខ្ញុំស្គាល់គាត់ ហើយបើខ្ញុំថាខ្ញុំមិនស្គាល់គាត់ ខ្ញុំនឹងក្លាយជាអ្នកកុហកដូចអ្នកដែរ ។
១១ ដើម្បី កុំ ឲ្យ សាតាំង អាច ទាញយក ប្រយោជន៍ ពី យើង ត្បិត យើង មិន ល្ងង់ខ្លៅ ចំពោះ គោលបំណង របស់ វា ឡើយ ។
ខ្ញុំ ត្រូវ បង្កើត ប្រវត្តិ រូប សង្ខេប តាម អ៊ីមែល ។ វាគួរតែ
កូនប្រុសកូនស្រីរបស់អ្នកដែលអ្នកបានទុកនៅស្រុកយូដានឹងត្រូវគេសម្លាប់ដោយដាវ ។
២៥ ព្រះយេស៊ូដាក់ដៃលើភ្នែកបុរសនោះម្ដងទៀត ។
កុំខ្លាចចុះទៅស្រុកអេស៊ីបឡើយ ព្រោះយើងនឹងតាំងអ្នកឲ្យទៅជាប្រជាជាតិធំ ។
ចាប់ពី ពេល នោះ មក អ្វី ៗ ទាំងអស់ គឺជា វិវរណៈ ។
« ក្នុងចំណោមអ្នក រាល់គ្នា តើមានអ្នក ណាបើកូនសុំនំប៉័ងនឹងឲ្យថ្ម ? » ។
ម្តាយ របស់ គាត់ ឈរ នៅ ពីក្រោយ គាត់ ។
បញ្ជាក់ថាសោ ត្រូវបានបង្កើត ។
ម៉ាស់ ត្រូវបាន រក្សា ពេញ មួយ ឆ្នាំ
បុរស ពិត ដឹង ថា ស្នេហា គឺជា អារម្មណ៍ ដ៏ អស្ចារ្យ បំផុត មួយ នៅក្នុង ពិភពលោក ។
គាត់ ប្រើ ពាក្យ វីរភាព ។
សម្រាប់ ពានរង្វាន់ ដូង មាស ។
អ្នកប្រាជ្ញ ( អ្នក ដែល ត្រៀមខ្លួន ) បាន ចូល ជាមួយ ចៅហ្វាយ ហើយ នៅ ពេល ដែល មនុស្ស ល្ងង់ ត្រឡប់ មកវិញ ពួកគេ ត្រូវបាន បដិសេធ មិន ឲ្យ ចូល ។
កាលព្រះយេស៊ូយាងចេញពីទីនោះទៅ មានបុរសខ្វាក់ពីរនាក់ដើរតាមព្រះអង្គដោយស្រែក ថា៖ « ព្រះរាជ វង្សព្រះបាទដាវីឌ អើយ សូមអាណិតមេត្តាយើងខ្ញុំផង !
« ឱ ព្រះ អើយ សូម សង្គ្រោះទូលបង្គំផង ព្រោះទឹកបានឡើងដល់ ករបស់ទូលបង្គំ ។
គាត់ក៏ឃើញដើមឧទុម្ពរមួយដើមពីចម្ងាយ ដែលមានស្លឹក ។
ហើយបានធ្វើការ ខូចខាតរាប់មិនអស់ដល់ព្រលឹងមនុស្ស ។
គាត់បានបះបោរប្រឆាំងនឹងព្រះ ដូចជាអំពើទុច្ចរិតនៅក្នុងគាត់ ។
ការបង្កើត អតិថិជន
លេអា សូម កុំ ប្រែក្លាយទៅជា ស្រី ឆ្មា ។
« ទ្រង់នឹងលើក ត ម្កើងអ្នក ដើម្បីទទួលបានទឹកដី ជា មរតក » ។
ព្រះទ្រង់ជ្រាបពីព្រះវិញ្ញាណនៃមនុស្ស ហើយទ្រង់ជ្រាបពីគោល ដៅរបស់វា។
ឥឡូវនេះ គាត់នឹងបម្រើម្ចាស់យើង » ។
ក្រុម ដែល តំណាង ឱ្យ នីហ្សេរីយ៉ា
« ក្នុង រយៈពេល តិច ជាង ពីរ ឆ្នាំ រដ្ឋបាល របស់ ខ្ញុំ បាន សម្រេច ស្ទើរតែ ច្រើន ជាង ការគ្រប់គ្រង ផ្សេង ទៀត នៅក្នុង ប្រវត្តិសាស្ត្រ នៃ ប្រទេស របស់ យើង ។
អ្វីដែលល្អជាងនេះ គឺអ្នកអាចចាប់ផ្តើមធ្វើការ ជួញ ដូរដោយត្រឹមតែ ១ ផោនប៉ុណ្ណោះ ។
ហេតុ អ្វី បានជា ព្រះមិន ស្តាប់ ការអធិស្ឋាន របស់ ខ្ញុំ ?
មិន អី ទេ ព្រោះ ខ្ញុំ នៅ ជាមួយ មិត្តភក្តិ ។
អំពើរបស់លោកម៉ូសេ និងព្រះបាទដាវីឌ
ខ្ញុំ ជាអ្នកស្គាល់គាត់ ។
ហើយ យើង ជា អ្នក ចាប់ផ្តើម អាជីវកម្ម ដូច្នេះ យើង មិន មាន ថវិកា ច្រើន សម្រាប់ កិច្ចការ នេះ ទេ ។
ពេលនោះ ពួកគេនឹងយំថាពួកគេមិនមែនជាអ្នកគាំទ្រ ។
ផល ផ្លែ នៃ មែក ធាង នៃ សេចក្តីជំនឿ គឺ គុណធម៌ ចំណេះដឹង និង ការគ្រប់គ្រង ខ្លួន ឯង ផងដែរ ។
អាច ទទួលបាន នៅ ឯកសារ ប្រព័ន្ធ ។
« សម្រាប់ក្រុមក្រហមជំនាន់ទីពីរ ឬទី បី បើអ្នកចាញ់ក្នុងការតស៊ូអំណាច អ្នកនឹងបាត់បង់អ្វី ៗទាំងអស់ ។
28 ពេលគាត់ចូលទៅក្នុងផ្ទះហើយ មនុស្សខ្វាក់ក៏ចូលមកជិតគាត់ ហើយព្រះយេស៊ូមានព្រះបន្ទូលទៅគេ ថា៖ « តើអ្នក ជឿថាខ្ញុំអាចធ្វើដូច្នេះបានឬ ? » ។
នេះ ជា អ្វី ដែល នាង និង សហការី កំពុង ស្តា ប់៖
ខ្ញុំបែរទៅប្រពន្ធខ្ញុំ ហើយនិយាយថា “ មានកូនរបស់ព្រះ” ។
