15 ដូច្នេះ ពួកអ្នកយាមក៏យកប្រាក់ ហើយធ្វើតាមការ ណែនាំ ។
គាត់ មិន គោរព មិត្តភក្តិ និង ក្រុមគ្រួសារ របស់ អ្នកទេ ។
ព្រះបន្ទូលរបស់ព្រះរីក ចម្រើននិងចម្រើនឡើង ។
ហើយនៅពេលល្ងាចសម្រាប់មួយយប់នៅក្នុងទីក្រុង។
ផ្តល់ឱ្យ អ្នក នូវ អារម្មណ៍ នៃ អាថ៌កំបាំង មួយ អ្នកដឹង ។
នេះ ជា ការផ្តល់ របស់ យើង ដែល គ្មាន ទីបញ្ចប់ ។
ហើយ អ្នក នឹង មាន សេចក្តីអំណរ និង ភាពរីករាយ ។ ហើយ មនុស្ស ជាច្រើន នឹង អរសប្បាយ នៅពេល កំណើត របស់ គាត់ ។
អ័ ប្រាហាំមាន ប្រសាសន៍ទៅគាត់ ថា៖ « ប្រសិនបើគេមិនស្តាប់តាមលោកម៉ូសេ និងព្យាការីទេ នោះគេនឹងធ្វើ
មនុស្សដកខ្លួនចេញពីមុខខ្ញុំញឹកញាប់ជាង ។
ហើយទ្រង់មាន បន្ទូលឆ្លើយ ថា៖ « អ្នក ណាដែលសាបព្រោះពូជល្អគឺជាកូនមនុស្ស ។
ក្នុងនោះទីក្រុងដែលមានកំផែងត្រូវបាន ហ៊ុំព័ទ្ធដោយប្រទេសភ្លឺនិងគ្មានកំហុស
ខ្ញុំគិតថាខ្ញុំបាននិយាយរួចហើយថាខ្ញុំបានឮឈ្មោះ
10 យើងមានអាសនៈមួយដែលអ្នក បម្រើក្នុងព្រះពន្លាគ្មានសិទ្ធិបរិភោគ ។
បន្ទាប់ពី រស់នៅទីក្រុងបាងកកបានពីរឆ្នាំ ខ្ញុំគិតថាខ្ញុំស្គាល់ទីក្រុង ។
វា ពិតជា មាន ន័យ ណាស់ សម្រាប់ ខ្ញុំ ក្នុង ការទទួលបាន ប្រាក់ សំណង របស់ ខ្ញុំ ” ។
៣ យើងដឹងថា យើងបានស្គាល់លោកហើយ ប្រសិនបើយើងធ្វើតាមបង្គាប់របស់ លោក ។
ពិធី បុណ្យ នំបុ័ង ឥត មេថ្វាយ ព្រះអម្ចាស់ ; អ្នកត្រូវបរិភោគឥតមេ អស់ រយៈពេលប្រាំពីរថ្ងៃ
អ្នកបង្កើតសន្តិភាពមានសុភមង្គលហើយ ដ្បិតគេនឹងត្រូវហៅថាជាកូនរបស់ព្រះ។
លោកម្ចាស់មាន ប្រសាសន៍ថា “ លោកម្ចាស់ដឹក នាំគ្រប់ការ ទាំងអស់ ហើយគ្មានការតវ៉ាអ្វីឡើយ ព្រោះជាម្ចាស់ ។
សម្រាប់សហគមន៍ទាំងអស់ សុទ្ធតែបរិសុទ្ធ ហើយនៅ កណ្ដាលពួកគេគឺព្រះអម្ចាស់ ហើយហេតុអ្វីបានជាអ្នក រាល់គ្នាត្រូវលើកខ្លួនឡើងលើក្រុមជំនុំរបស់ព្រះអម្ចាស់ ?
មនុស្ស ជាច្រើន ត្រូវបាន បង្ហាញ ដោយ ព្រះ មនុស្ស ជាច្រើន មិន ទាន់ ត្រូវបាន បង្ហាញ ទេ ។
ទ្រង់នឹងរស់ នៅជាមួយពួកគេ ហើយពួកគេនឹងធ្វើជា រាស្ដ្ររបស់ទ្រង់ ព្រះ អង្គទ្រង់នឹងគង់ជាមួយពួកគេ » (NLT) ។
« ហើយដោយថាគាត់បានដកដង្ហើមលើពួកគេហើយនិយាយថា : « សូមទទួលព្រះវិញ្ញាណបរិសុទ្ធ។
ខ្ញុំ ចង់ ប្រាប់ ពី ទីក្រុង ដែល ខ្ញុំ រស់នៅ !
ឥឡូវនេះ វា កាន់តែ ងាយស្រួល ក្នុង ការស្វែងរក និង ដំណើរការ កម្មវិធី ដែល អ្នក ត្រូវការ ។
ដូច្នេះ ការបង្ខំឱ្យ ចាក់ វ៉ាក់សាំង លើ អ្នក ដែល មិន មាន ជំនឿ ពួកគេ នឹង ជួយ កូន របស់ ពួកគេ គឺ ផ្ទុយ ពី អ្វី ដែល ព្រះយេស៊ូវ នឹង ធ្វើ ដោយ ផ្អែក លើ ការអាន ព្រះគម្ពីរ របស់ ខ្ញុំ ។
បើកមាត់របស់អ្នក ។
កុំប្រើអំបោះព្រោះវាមិនរឹងមាំគ្រប់គ្រាន់ ។
ខ្ញុំធ្វើតាមច្បាប់នៃ ភាពរុងរឿងរបស់ព្រះ ហើយខ្ញុំមានសន្តិភាពក្នុង ចិត្ត » ។
មាន អ្នកកាសែត ល្អ មួយចំនួន ដែល ធ្វើការ នៅ ទីនោះ ហើយ ប្រថុយ ជីវិត ដើម្បី រាយការណ៍ អំពី រឿងរ៉ាវ ជុំវិញ ពិភពលោក ។
ខ្ញុំ សង្ឃឹម ថា អ្នក ធ្វើ បាន ល្អ ជាង អ្នក ធ្លាប់ មាន ។
ដូច្នេះ ព្រះ គ្រីស្ទបានយាងមកដើម្បី សង្គ្រោះអស់អ្នកដែលត្រូវវិនាស អស់អ្នកដែលត្រូវបំផ្លាញ និងអ្នកដែលវង្វេង ។
យើងបានជួយគាត់ » ។
គាត់មានកូនស្រីបីនាក់ ហើយគាត់បានសម្រេច ចិត្តសាកល្បងស្នេហារបស់ពួកគេដើម្បីបែងចែករាជាណាចក្ររបស់គាត់ក្នុងចំណោមពួកគេ ។
ហេតុ អ្វីបានជាអ្នកដើរតាមព្រះ គ្រីស្ទងាក មក រកគម្ពីរ សញ្ញាចាស់ ( សៀវភៅសុភាសិត ) សម្រាប់ការ ណែនាំអំពី ការ ចិញ្ចឹមកូន ?
អ្នក តែងតែ មាន ឆន្ទៈ ក្នុង ការសម្រប ខ្លួន ទៅនឹង ការផ្លាស់ប្តូរ ។
អ្នក ណាប្រឆាំងនឹងខ្ញុំ អ្នកនោះប្រឆាំងនឹងអ្នក ។
ពួកគេបាន ស៊ីផឹកជាមួយនឹងពេលដែលអ្នកទាំងបីបានបង្ហាញខ្លួនដល់ អ័ ប្រាហាំ នៅពេលដែលគេនាំ ដំណឹងថាគាត់នឹងមានកូនប្រុសមួយ ។
« ប្រាប់យើងចុះ តើការ ទាំងនេះនឹងកើតឡើងនៅពេលណា ? ហើយអ្វីនឹងជាទីសំគាល់នៃការ យាងមក និងនៃអវសាន កាលនៃពិភពលោក » ។ — ម៉ាថា យ ២៤:៣ ។
៣ហើយគ្មានអ្នក ណានៅស្ថាន សួគ៌ ឬនៅលើផែនដី ឬនៅក្រោមផែនដីនោះឡើយ ដែលអាចបើកសៀវភៅ ឬមើលបាន ។
« ខ្ញុំជាកូនរបស់ប្រជាជន ។
នៅក្នុង សៀវភៅ ចុងក្រោយ របស់ គាត់ ចម្លើយ សង្ខេប ចំពោះ សំណួរ ធំ ស្ទេ ផាន បាន និយាយ ថា “ គ្មាន ព្រះទេ ។
ត្រូវបាន ឡោមព័ទ្ធ ។
ហើយ មាន តែ ប្រាំពីរ ប៉ុណ្ណោះ ដែល ត្រូវបាន សង្គ្រោះ ។
យើងនឹងជួយគេឲ្យរួចពីគ្រប់ទីកន្លែងដែលគេខ្ចាត់ខ្ចាយ ។
ល្ងង់ ហើយច្បាំងនឹងគាត់ ។
២០, កុំបំផ្លាញកិច្ចការរបស់ព្រះ ដើម្បីជាអាហារ ។
« នោះជាអ្វីដែលគេហៅវាបំភ្លឺ ?
ពួកគេរំភើប ចិត្តណាស់ដែលមិនបាននិយាយមួយម៉ាត់ ។
ចំណេះដឹង ត្រូវបាន ផ្តល់ឱ្យ ; ចំណេះដឹង ត្រូវបាន ទទួល ; ប៉ុន្តែ វា មិន ត្រូវបាន បញ្ជា ទេ ។
« លោកគ្រូ យើងដឹងថាលោកមកពីព្រះជាម្ចាស់ហើយ ព្រោះគ្មានអ្នក ណាអាចធ្វើទី សម្គាល់ដែលលោកធ្វើបានឡើយ លើកលែង តែថាព្រះជាម្ចាស់គង់ជាមួយលោក » ។
ជា ការពិត ណាស់ បន្ទាប់ពី ឥត ប្រយោជន៍ ព្យាយាម លើក គម្រប
មិន មែន ដើម្បី បំផ្លាញ ពួកគេ ទេ ប៉ុន្តែ ដើម្បី សង្គ្រោះ ពួកគេ ។
ហើយអ្នកដែលបង្កើតវាជាអ្នកដុត។
ដូចជា សម្រាប់ ការលេចធ្លាយ ប្រេង ពី គម្របសន្ទះ បិទ បើក ។
តើ នរណា ជា ព្រះរាជ បុត្រ របស់ ទ្រង់ ដែល បាន ប្រមូល អឌ្ឍ ចន្ទ
ទ្រង់ជាសេចក្ដីសង្ឃឹមរបស់អ៊ីស្រាអែល ។
គាត់ ត្រូវបាន គេ ជឿជាក់ ថា គាត់ មាន អ្វី មួយ ។
ឥឡូវនេះ ខ្ញុំ ដឹង ថា ពួកគេ ត្រូវការ យើង ហើយ យើង ត្រូវការ ពួកគេ ។
ខ្ញុំ ឈប់ ហើយ ម្នាក់ ក្នុង ចំណោម ពួកគេ មើល មក ខ្ញុំ ។
អ្នក រាល់គ្នាស្រលាញ់ខ្ញុំនៅជុំវិញទីក្រុងនេះ ។
អ្នក នឹង ពេញចិត្ត ចំពោះ អ្វី ដែល អ្នក ឃើញ ។
