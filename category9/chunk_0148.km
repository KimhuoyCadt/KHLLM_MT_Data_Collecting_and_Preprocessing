ប៉ុន្តែ មិន មាន លក្ខណៈ ប្រសើរ ដូច ក្នុង ករណី ស៊ក លិង្គ ចូលក្នុង ទ្វារមាស ឡើយ ។
ផលិតផល វៀតណាម កំពុង អង្រួន ចិត្ត និង ទទួលបាន ការពេញនិយម នៅ សហរដ្ឋ អាមេរិក
ផ្ទះ ព័ត៌មាន សេដ្ឋកិច្ច គម្រោង លំនៅដ្ឋ …
ក្នុង ដើម ដំបូង នៃ ព្រះរាជ កិច្ច នៃ ព្រះយេស៊ូវ អ្វី ៗ
ខ្ញុំ ពិតជា មិន មាន ចម្លើយតប នឹង គាត់ ទេ ក្រៅពី សួរ ថា ៖
ទម្លាប់ មិន ល្អ ៦យ៉ាង ធ្វើឱ្យ អ្នក កើត មុន ព្យាបាល មុន មិន ជា សោះ
នោះ ចាប់ផ្តើម ទូរសព្ទ ទៅកាន់ មិត្តភក្តិ របស់ នាង ដើម្បី ចែកចាយ ពត៌មាន នេះ ។
៥ការបែងចែក នេះ ធ្វើឡើង ដោយ ចាប់ ឆ្នោត ហើយ មាន ចំនួន ស្មើ ៗ
នេះ គឺជា អ្វី ដែល អ្នកការទូត និង មន្ត្រី រដ្ឋាភិបាល មក ពី គ្រប់ ប្រទេស និយាយប្រាប់ ខ្ញុំ ។
ខែ នេះ មាន ទស្សនាវដ្តី ពត៌មានវិទ្យា ចេញ ថ្មី មួយ ទៀត គឺ ទស្សនាវដ្តី អាន ។
ផ្ទុយទៅវិញ បើ ឈាម នៅតែ បន្ត ហូរ មក យើង ត្រូវ អនុវត្ត ជា ដំណាក់ ៗ
លោក ឧកញ្ញ៉ា គង់ នួន
ទាំងអស់ ដែល បាន ឃើញ ភិក្ខុ សង្ឃ នៅពេល អ្វី ៗ
សាំ យ៉ុង បុក ម៉ូតូ ពេញ ទំហឹង បណ្តាលឱ្យ មនុស្ស ម្នាក់ ស្លាប់ ភ្លាម ៗ
បើ ប្រាក់ ឈ្នួល មិន ត្រូវបាន ដោះស្រាយ ទេ យើង មិន បញ្ឈប់ ទេ ។
តម្លៃ ប្រេង កើនឡើង ខណៈ ទំនុកចិត្ត អ្នកប្រើប្រាស់ នៅ សហរដ្ឋ អាមេរិក មាន ការកើនឡើង
មកពី ខ្ញុំ ជិត រៀបការផង ព្រោះ ពេល ស្បែក សតែង ខ្លួន ឆាប់ សម ហើយ លើក សម្រស់ ទៀត ជាពិសេស ពេល ថត ងាយ ស៊ី កាមេរ៉ា ដែរ ។
សូម គិតគូរ អំពី មធ្យោបាយ ដឹកជញ្ជូន និង ការចំណាយ នានា ដែល អាច កើតមាន ទុក ជាមុន ផង ។
ជា បន្ត សូម លោក អ្នកនាង ស្តាប់ បទ យក ការណ៍ ដែល រៀបចំឡើង ដោយ រំដួល ចិត្រា ដូចតទៅ ៖
កុំ ភ្លេច តាមដាន រឿង នេះ ទុក ធ្វើ បទពិសោធន៍ - កម្សាន្ត
របស់ អ្នក ក្រុង កំពត ដ៏ ពេញចិត្ត បំផុត ។
តែ ខ្ញុំ មិន ចូលចិត្ត ខ្ទើយ ទេ ពួក ខ្ទើយ ចំនួន ធំ ចូលចិត្ត និយាយ ចំ អេស ចំអាសណាស់ ភាគ ច្រើន ។
កម្មសិទ្ធិ រឿង អ្វី ?
អ្នកណា ខ្លះ មាន វត្តមាន ពិធី អភិសេក ព្រះអង្គម្ចាស់ អង់គ្លេស ?
ខ្ញុំ ត្រូវបាន ប៉ូលិស បញ្ឈប់ ជាច្រើន ដង ហើយ យាយី ខ្ញុំ ។
ពួកគេ បាន រំលោភ លើ កិច្ចព្រមព្រៀង នេះ អស់ រយៈពេល ជាច្រើន ឆ្នាំ មកហើយ ។
លោក បន្ត ថា មូលហេតុ នៃ ការធ្លាក់ យន្តហោះ នេះ កំពុង ស្ថិត នៅក្រោម ការស៊ើបអង្កេត នៅឡើយ ៕
មាន តែ ខាង ក្រុមការងារ របស់ បក្ស យើង ទេ បាន ជួយ អភិវឌ្ឍ ក្នុង ឃុំ ។
កុំ ភ្លេច ជួយ ចែករំលែក គ្នា ផង ៖
លោក បន្ត ថា គេ លួច កាប់បំផ្លាញ តែ ពេល យប់ ធ្វើឱ្យ មាន ការលំបាក ណាស់ ។
ចំណុច នេះ យើង ត្រូវ ទទួលស្គាល់ ថា បើសិន អវត្តមាន ទាំង ពីរ នាក់ តើ ចរន្ត របស់ កម្ពុជា ទៅ ទី ណា ?
ផ្លូវ លេខ ២០៩ ខាងកើត ខាងកើត ស៊ី មួរ
នេះ ជា ចរិត ចោរ ប្រវត្តិសាស្ត្រ ។
តែ អាដហុក ចេះតែ រាយការណ៍ ធ្វើជា អាជីព របស់ គេ ។
ខ្លួន ដោយ ផ្អែក ទៅ លើ ច្បាប់ អន្តរជាតិ ។
ជនសង្ស័យ ដែល ជា មេខ្យល់ នាំ មនុស្ស ឆ្លង ដែន ទាំងនោះ ពួកគេ ត្រូវតែ ប្រឈម នឹង ផ្លូវ ច្បាប់ ៕
នាយ ឧត្តមសេនីយ៍ នេត សាវឿន ក៏ បាន មានប្រសាសន៍ បន្ត ថា ចាប់ពី ពេលនេះ ទៅក្នុង ខេត្ត សៀមរាប ត្រូវ ដំណើរការ៣
ហើយ រណសិរ្ស ប្រឆាំង នោះ បាន ឆ្លៀត យក គ្រប់ រឿង ដូចជា រឿង ការលា លែង ក្នុង សាលា ក្តី ផង ហើយ ពេល ថ្មី ៗ
ប្រទេស ស៊ីម បាវ៉េ កំពុង ស្ថិត នៅក្នុង ស្ថានភាព មិន ប្រាកដប្រជាមួយ ក្រោយពី យោធា ជាតិ បាន ចូលមក ក្នុង រដ្ឋធានី កាលពី ថ្ងៃអង្គារ កន្លងទៅ នេះ ។
ដូច សិង្ហ ស្ថិត នៅក្នុង ចំណោម សត្វ ព្រៃ
សង្គម ស៊ីវិល យល់ឃើញ ថា ការប៉ះទង្គិច គ្នា នោះ គឺ ពលរដ្ឋ គ្រាន់តែ ប្រើ ស្វ័យ ការពារ ការពារ ទ្រព្យសម្បត្តិ ដីធ្លី របស់ ពួ គេ តែ ប៉ុណ្ណោះ ។
តើ ទឹក មន្ត របស់ ព្រះសង្ឃ អាច ជួយ ឱ្យ ប្រឡង ជាប់ ដោយ មិន ចាំបាច់ ខំប្រឹង រៀនសូត្រ ឬ ?
ជួនកាល មាន ជំលោះ ជាមួយគ្នា ទៅ វិញ ទៅ មក វា គឺជា ចំលាង នៃ ការសាមគ្គីភាព មួយ និង ការស្រលាញ់ ក្នុង ចំនោម ពួកគេ ។
បង្គាប់ ដែល ឱ្យ ជូន តង្វាយ មួយ ភាគ ដប់ ឬ ឱ្យ មួយ ភាគ ក្នុង ដប់ នៃ ទ្រព្យសម្បត្តិ របស់ យើង គឺជា ច្បាប់ ដែល ព្រះបាន ឱ្យ ដល់ ប្រជាជាតិ អ៊ីស្រាអែល សម័យ បុរាណ ។
អ្នកកាន់ គ្រឹស្ត ឱ្យ គោរព តាម រដ្ឋាភិបាល ទោះ យ៉ាងណា កីដោយ ។
យើង គឺជា អ្នកផ្គត់ផ្គង់ ដូច្នេះ យើង ធ្វើ តាម អតិថិជន របស់ យើង ។
វិធីសាស្ត្រ ក្នុង ការរក្សា ចិត្ត ឱ្យ ស្ងប់ និង ទប់ទល់ នឹង ការថប់ អារម្មណ៍ ក្នុង អំឡុង ពេល នៃ ការរាតត្បាត នៃ ជំងឺ កូវីដ១៩
ខ្ញុំ ក៏ ចាប់អារម្មណ៍ ផងដែរ រយៈពេល វែង ទំនាក់ទំនង កិច្ចសន្យា ។
នេះ ជា ពេល ដែល បេប៊ី រៀនសូត្រ ពី អ្វី គ្រប់ យ៉ាង ដូច្នេះ យើង គួរ យក ពេល
សភា និង ជា រដ្ឋលេខាធិការ នៅ ក្រសួង
លោក មហា បូជាចារ្យ សួរ ក្រុម សាវ័ក ថា ៖
ផ្នែក មើលឃើញ នៃ ភ្នែក គឺជា កត្តា ដ៏ សំខាន់ របស់ មនុស្ស ម្នាក់ ។
ពីរ ឆ្នាំ ក្រោយមក ព្រះអង្គនន់ ទ្រង់ មាន នាម ថា ព្រះរាមាធិបតី ។
ឱរ៉ាល់ បើក ដៃ ឱ្យ ក្រុម ជនល្មើស ធ្វើ អ្វី ៗ
តែ បែប នេះ លោកស្រី សង្កត់ធ្ងន់ ថា បញ្ហា សេដ្ឋកិច្ច គឺជា ប្រឈម សម្រាប់ លោកស្រី ។
សូម លោក មេត្តា មានប្រសាសន៍ តែ មួយ ម៉ាត់ នោះ អ្នក បំរើ របស់ ខ្ញុំ ប្របាទ នឹង ជាសះស្បើយ មិន ខាន ។
បង្កើន ថាមពល របស់ អ្នក ដូចម្តេច ទៅ ?
ក្នុង កំឡុង ពេល នោះ តម្លៃ អាភៀន មួយ ខាំ ស្មើនឹង ៥តម្លឹង មាស ។
ជា ប្រទេស មួយ ធ្លាប់ ហែល ឆ្លងកាត់ របប មួយ ដែល មិន ផ្តល់ សិទ្ធិ អ្វី ទាំងអស់ ដល់ ប្រជាជន កម្ពុជា ពិតជា ត្រូវការ ណាស់ នូវ សិទ្ធិ គ្រប់ យ៉ាង ។
អ្នក រាល់គ្នា នឹង ឃើញ ហេតុការណ៍ នេះ ផ្ទាល់ នឹង ភ្នែក នៅ ទីនេះ ។
អ្នកនាំពាក្យ បក្ស ប្រឆាំង រូប នោះ ប្រកាស ដែរ ថា លោក នឹង មិន ឆ្លើយ នឹង សំនួរ ណា ដែល ចង់ ដឹង ពី មូលហេតុ នៃ ការលា ឈប់ របស់ លោក សម រង្ស៊ី ទេ ដោយ ជំរុញ ឱ្យ អ្នកសារព័ត៌មាន សុំ ការពន្យល់ ផ្ទាល់ ពី លោក សម រង្ស៊ី ផ្ទាល់ តែ ម្តង ដែល កំពុងតែ រស់ នៅ និរទេស ខ្លួន ឯ នៅ ក្រៅ ប្រទេស ។
គ្នា ខណៈ ដែល អត្រា ជួល បាន ធ្លាក់ចុះ ជា លើក ទី២ក្នុង រយៈពេល ២ឆ្នាំ ជាប់ គ្នា ។
បើសិនជា គ្មាន នរណា ម្នាក់ នៅក្បែរ នោះ ទេ ខ្ញុំ នឹង ឈប់ ហើយ សូត្រ ទំនុក របស់ ស្តេច ដាវីឌ ឮ ៗ
ហេហេ នាំគ្នា អភិវឌ្ឍ បែប ណឹង ប្រយ័ត្ន ជំងឺ គ្រុន ឈាម កើនឡើង
ក្នុង ករណី នេះ ទារក នឹង ត្រូវបាន ត្រួតពិនិត្យ ដោយ យកចិត្តទុកដាក់ ជាង មុន ។
សមត្ថកិច្ច និយាយ ថា កាលពី វេលា ម៉ោង ១៧ ៖
ស្លាកសញ្ញា អាច ត្រូវបាន ប្តូរ តាម បំណង ស្លាបព្រា ចាន
លោក វីរៈ វណ្ណៈ ដែល ជា ប្រធាន ក្រុម មាន ជំនឿចិត្ត ថា នឹង បាន ទទួល លទ្ធផល ល្អ ពី ការប្រកួត នេះ មិន ខាន ឡើយ ។
ពួក អាបក្ស ស្មូម ឬ បក្ស ស្រី លើក ជើងៈ
រអ៊ូស៊ូ នៅ លេប ទឹក មាត់ ។
សួរ ថា តើ ការទទួលខុសត្រូវ របស់ អ្នកស្រី សន សុម៉ាឡែន មាន ទេ ត្រង់ ចំណុច នេះ ។
ក្រុមគ្រួសារ ខាង ស្រី មិន ព្រម ឱ្យ នាង រុក មីនី ត្រឡប់ ទៅវិញ ជាមួយ គូស្នេហ៍ ទេ ។
លោក ហ៊ុន សែន ថា ជីវិត យុវវ័យ របស់ លោក គឺ ស្រប ពេល ប្រទេស កំពុង កើត សង្គ្រាម ។
លោក បញ្ជាក់ ដូច្នេះ ថា យើង ខកចិត្ត ដែល បណ្តឹង យើង ត្រូវ បដិសេធ ។
ទី៣រក្សា ជនជាប់ចោទ ដើម្បី កុំ ឱ្យ មាន ការប្រព្រឹត្ត បទល្មើស ជាថ្មី ម្តង ទៀត ។
ធម្មតា ថ្នាំ ពីមុន ខ្ញុំ ធ្លាប់ លេប ក៏ វា ធ្វើ ទុក្ខ អ៊ីចឹង ដែរ ។
ផ្ទុយទៅវិញ វត្តមាន នៃ អំពើ ផ្តាច់ការ និង ជន ផ្តាច់ការ ទេ ដែល ត្រូវ ព្រួយបារម្ភ ។
ការវិភាគ ការប្រកួតប្រជែង - គួរតែ ត្រូវបាន គ្រប់គ្រង ជា ផ្នែក ៗ
ទៀត ឱ្យ កាន់តែ ទូលំទូលាយ ទៅកាន់ ប្រជាពលរដ្ឋ ជាពិសេស អ្នក រស់ នៅ តាម ខេត្ត ។
មនោសញ្ចេតនា ជា ថ្ងៃ ដ៏ ល្អ សម្រប់ ការសម្តែង មនោសញ្ចេតនា ចំពោះ មនុស្ស ដែល ខ្លួន ស្រឡាញ់ ។
ដ្បិត ទូលបង្គំ ជា អ្នកដទៃ នៅ ចំពោះ ទ្រង់
ចំណែក ខ្ញុំ វិញ ចូល ដល់ ថ្ងៃទី ពីរ នេះ ច្បាស់ជា បាយ ៗ
នៅ ឥណ្ឌា មាន ពលរដ្ឋ ជាង ៣០០ លាន នាក់ មិន ទាន់ មាន អគ្គីសនី ប្រើប្រាស់ ផង ។
ស្រាប់តែ មាន គេ ស្នើ អោយ បិទ ទំព័រ របស់ ខ្ញុំ ។
ព្រះអម្ចាស់ បាន ធ្វើ កិច្ចការ ដ៏ អស្ចារ្យ ដែល នាំអោយ យើង មាន អំណរ សប្បាយ
ដូច្នេះ នៅពេល ខ្ញុំ ត្រូវបាន ផ្តល់ ឱកាស ទិញ ក្រុម បាល់ទាត់ ខ្ញុំ ជ្រើស យក ឱកាស តែម្តង ។
ជាច្រើន ក្នុង ជីវិត បាន ។
ក្នុង ការពិភាក្សា ។
២តើ គណបក្ស ណាកំសាក ?
នេះ បង្ហាញ ថា គេ តាមដាន អ្នក ដោយ ក្តីបារម្ភ អស់ ពី ចិត្ត ។
បើ ទោះបី បែប ណា ក្តី លទ្ធផល ផ្លូវការ នឹង ត្រូវបាន ប្រកាស នៅ ថ្ងៃទី ២២ ខែឧសភា ឆ្នាំ ២០១៩ ។
យោង តាម មន្ត្រី យោធា សៀម បាន ថ្លែង អោយ ដឹង នៅ ថ្ងៃទី ២១ ខែឧសភា នេះ ថា កិច្ច ប្រតិបត្តិការ យោធា
យេម៉ែន ឆ្លងកាត់ សោកនាដកម្ម សង្គ្រាម ពីរ ឆ្នាំ ដោយ គ្មាន សង្ឃឹម ថា មាន ច្រក ចេញ
រឿងរ៉ាវ តួចតាច បែប នេះ ញាំង ឱ្យ មាន ការរិះគន់ ជាខ្លាំង ដល់ អាជ្ញាធរ មាន សមត្ថកិច្ច ។
វា គ្រាន់តែ ថា វិធី នេះ នឹង ធ្វើឱ្យ មនុស្ស កាន់តែ ច្រើន ទៅ បោះឆ្នោត ។
ចាប់រំលោភ មិន បាន សម្រេច ប្រុង សម្លាប់ បំបិទ មាត់
ខេត្ត កោះកុង ក្លាយជា កន្លែង ទំនិញ គេច ពន្ធ
ភាគ ច្រើន ក្រុម សន្តិសុខ ការពារ តែ នៅលើ ដី ប៉ុណ្ណោះ ពិបាក ក្នុង ការការពារ ពីលើ អាកាស ។
ប្រភេទ ធាតុ ពីរ ចំណិត
មកដល់ ផ្លូវ បំបែក … អ្នកនិពន្ធ វ័យ ក្មេង
តើ វិស័យ ធនាគារ ឆ្លើយតប ដូចម្តេច ចំពោះ បរិយាកាស នេះ ?
នេះ គឺជា ការពិត ទាំង ៥យ៉ាង ដែល អ្នក ប្រហែលជា មិន ទាន់ បាន ដឹង នៅឡើយ ទេ ។
សូម្បីតែ នៅ ចុង ឈើ ក៏ សម្បត្តិ របស់ រដ្ឋ នៅក្នុង ទឹក ក៏ សម្បត្តិ របស់ រដ្ឋ ។
មាស ផ្ទាល់ខ្លួន
អង្គការ លើកលែង ទោស អន្តរជាតិ ជំរុញ ឱ្យ ការពារ សិទ្ធិ អ្នក រកស៊ី ផ្លូវភេទ
វា មិន មែន ជា រឿង ចម្លែក ទេ មនុស្ស ខ្លះ ហាក់ដូចជា មានអារម្មណ៍ ឈឺ ក្រពះ ទៅ វិញ នៅពេល មាន គាំង បេះដូង ។
បាន ហើយ ឥលូវនេះ សូម ចូល ដល់ សាច់រឿង ដែល ចង់ បង្ហាញ ប្រាប់ មិត្ត ៗ
ទោះបីជា បែប ណា ពុំ ទាន់ មាន របាយការណ៍ ស្តី អំពី អ្នកស្លាប់ ឬ របួស និង ការខូចខាត នៅឡើយ ទេ ចំណែក មន្ត្រី នានា ក៏ កំពុង វាយតម្លៃ ពី ស្ថានការណ៍ នៃ បាតុភូត រញ្ជួយ ដី នេះ នៅឡើយ ដែរ ។
សូម បញ្ជាក់ ថា អ្នក ប្រដាល់ ទាំង២រូប នេះ សុទ្ធតែ ត្រៀមខ្លួន សម្រាប់ ការប្រកួត នេះ ដូចគ្នា ។
ចាត់ទុក រឿង ទាំងនេះ ទៅនឹង កិច្ចប្រជុំ អតិថិជន ឬ ក្នុង ក្រុមហ៊ុន ។
ខ្ញុំ មិន នឹកស្មាន ថា នៅ កណ្តាល ព្រៃ ស្ងាត់
យើង នឹង ទទួលបាន ពី ការចូល រូម ការងារ ស្ម័គ្រចិត្ត ពី សង្គម ដូចជា ៖
អ្នក ឃើញ ហេតុការណ៍ និង នគរបាល មាន មាន តួនាទី អ្វី ខ្លះ ?
កម្ពុជា ឆ្ពោះ ទៅកាន់ សង្គម មួយ ដែល ស្អាតស្អំ តាម របៀប ណា ?
អ្នកជំងឺ កំពុង ស្ថិត ក្នុង ការព្យាបាល ពី គ្រូពេទ្យ ៕
លំហាត់ប្រាណ ពេលព្រឹក ទាំង ៧ ដែល ធ្វើឱ្យ អ្នក មានអារម្មណ៍ ស្វាហាប់ ពេញ មួយ ថ្ងៃ
តាមពិត បង ក៏ ចូលចិត្ត ចម្រៀង ដូច ប្អូន ដែរ ប៉ុន្ត មែិន មែន ច្រៀង បង្ហាញ រាង នៅលើ ឆាក នោះ ទេ ។
ហេង ពៅ ចង់ ឆ្លើយ អំពី អ្នក ដែល បាញ់ និង អ្នក ដែល នៅ ពីក្រោយ ខ្នង ព្រោះ
ព្រះរាជា យាង ឡើង គង់ លើ វេទិកា នោះ រួច លុត ជង្គង់ នៅ ចំពោះមុខ សហគមន៍ អ៊ីស្រាអែល ទាំងមូល ហើយ លើក ព្រះហស្ត ឡើង ទៅ លើ មេឃ ទូល ថា ៖
បាល រឺ ទទួល តួនាទី រដ្ឋបាល រឺ នយោបាយ ឡើយ ។
កញ្ញា បាន បន្ថែម ទៀត ថា ខ្ញុំ សូម បដិសេធ ទាំងស្រុង នូវ ព័ត៌មាន ថា ខ្ញុំ បែកបាក់ ផ្ទៃក្នុង និង ឈ្លោះគ្នា ជាមួយ លោក ផែ សុវណ្ណា រិទ្ធ និង លោកស្រី ចំរើន ។
សកម្មភាព ក្រុម បាល់ទាត់ វូហាន ពេល ធ្វើដំណើរ ទៅកាន់ ប្រទេស អេស្បាញ កាលពី ខែមករា ។
ក្រោយពេល ឃើញ ដូចនេះ មនុស្ស ជាច្រើន បាន ស្ញប់ស្ញែង ចំណង មិត្តភាព នេះ ជាខ្លាំង ៕
នរណា ជា អ្នកទទួលខុសត្រូវ ពិតប្រាកដ ។
បុរស ម្នាក់ ជិះ ម៉ូតូ ចេញ ពី ធ្វើ ការវិញ ទាំង មេឃ កំពុងតែ រលឹម ស្រិច ៗ
គឺ ដូចជា ដើម តាត្រៅ នៅ ស្រុក លីបង់
បើសិនជា អ្នក ពិតជា ខ្លាំង ឆ្លាត មេន នោះ អ្នក ធ្វើ អ្វី មួយ ជួយ ប្រជាជន ក្រៅពី បំផុស ធ្វើ បាតុកម្ម ទៅ មើល
អត់ ទេ មិន មេន មាន ន័យ ចឹង ទេ គ្រាន់តែ ចង់ អប់រំ មនុស្ស ចាស់ ខ្លះ
ឆ្នាំ មុន សុង សេង ហ៊ន
សិស្ស បាក់ឌុប ឆ្លើយ ថា ការប្រមូល ប្រាក់ ជូន លោកគ្រូ អ្នកគ្រូ ជា វ ប៌្បធ ម
នេះ បាន បញ្ចប់ នូវ សមយុទ្ធ យោធា រួមគ្នា មិន ធ្លាប់ មាន ក្នុង សមុទ្រ លឿង ។
លោក ខៀវ កាញារីទ្ធ ធ្លាប់ មានប្រសាសន៍ ថា ករណី លោក ហង្ស ចក្រា និង លោក រស់ សុឃិត លោក នឹង ធ្វើ អន្តរាគមន៍ ឱ្យ មាន ការដោះលែង ឱ្យ បាន ឆាប់ ៕
កីឡាករ សួន នឿត របស់ ក្រុម ភ្នំពេញ ក្រោន ត្រូវ សម្រាក ព្យាបាល របួស ជង្គង់ រយៈពេល យូរ
កន្លែង ក្មេង លេង កម្សាន្ត ២ ម៉ោង ឬ កាក់ ចំនួន ២
ថាប់រប នំង នឹង ការធ រើស ធអើង
ហើយ នាង ក៏ បាន ក្លាយជា សិស្ស ពូកែ នៅ ចំណុច នៃ អនាគត ដ៏ អស្ចារ្យ ដែល នឹកស្មាន មិន ដល់ ។
គ្នា ប៉ុន្តែ កម្រ មាន អ្នក ចាប់អារម្មណ៍ កន្លងមក ៖
ទៀត គឺ លឿន រហូត ទ្វេ ដង នៃ ល្បឿន បច្ចុប្បន្ន ។
គួរ បញ្ជាក់ ថា មេដឹកនាំ អតីត គណបក្ស សង្គ្រោះ ជាតិ រូប នេះ ត្រូវបាន សមត្ថកិច្ច ចាប់ខ្លួន កាលពី ថ្ងៃទី ៣កញ្ញា ឆ្នាំ ២០១៧ នៅក្នុង គេហដ្ឋាន ។
ពីសំណាក់ អាជ្ញាធរ ខេត្ត គ្រប់ លំដាប់ថ្នាក់ ប៉ុណ្ណោះ ៕
ចំណែក រឿង ពរ បួន ប្រការ ប្រាំ ប្រការ នោះ មិន ចាំបាច់ ឆ្ងល់ អី ច្រើន ទេ
វា ជា រឿង ដែល មិន នឹកស្មាន ដល់ ទាល់តែសោះ សម្រាប់ ពួកគាត់ ដែល ឆុំពយ ហ៊ាន ធ្វើ បែប នេះ ៕
បរិភោគ អាហារ ដែល មិន មាន ទឹក អាហារ ក្រៀម ដូចជា នំប៉័ង ជាដើម ។
