ជណ្តើរ យន្ត មាស នោះ គឺជា របស់ ទ្រង់ ផ្ទាល់ ដែល តែង យក តាម ព្រះអង្គ ជានិច្ច ពេល ប្រើ យន្តហោះ ។
ទំព័រ ដើម គ្រឿង រថយន្ត
ប៉ុន្តែ កាល នោះ គេ គ្រាន់តែ យក ពន្ធដារ ពុំ បាន គិត ពី កសាង អ្វី ៗ
ពួកគេ នឹង បន្ត រឿងក្តី នេះ ទៅ សាលាឧទ្ធរណ៍ ទៀត និង រក កិច្ចអន្តរាគមន៍ ពី ក្រសួង ពាក់ព័ន្ធ នៅ រាជធានី ភ្នំពេញ ។
សម្តេច សាយ ឈុំ ជួប សវនាការ ជាមួយនឹង លោក ង្វៀន ភូត្រុង
ដោយ ប្រជាជន ជាង ១ភាគ៣ នៅ កម្ពុជា មាន អាយុ ក្រោម ១៥ ឆ្នាំ ហើយ មាន តម្រូវការ ដ៏ ធំ ដើម្បី បង្កើត ការងារ សំណួរ ទាំង នេះ និង ចម្លើយ មាន អត្ថន័យ ជ្រាលជ្រៅ ក្នុង ជីវិត ពិត សម្រាប់ មនុស្ស ជាច្រើន នាក់ ។
រឿង សំរាម ១៦០០តោន ដល់ ណា ហើយ សារព័ត៌មាន នគរ វត្ត
ក្នុង ការសម្អាត ម៉ាស៊ីន ត្រជាក់ ដោយ ខ្លួន ឯង ។
ពិនិត្យ មុនពេល ចេញ រូប មន្ត ទាំងអស់ ដែល ជា បណ្តាញ សង្គម សម្រាប់ មនុស្ស ប្រចាំ ថ្ងៃ ។
៨កុំ និយាយ អ្វី អំពី មិត្ត សម្លាញ់ ឬ អំពី សត្រូវ ឱ្យ សោះ ។
ចំពោះ ការចំណាយ ទាំងអស់ ពួក ខ្ញុំ បាន ចូល លុយ គ្នា ទិញ នំ ខេក ជូន គាត់ ។
ការលើកឡើង របស់ ប្រមុខ កងទ័ព រូប នេះ គឺជា សញ្ញា ដ៏ ល្អ មួយ សម្រាប់ ប្រទេស មីយ៉ាន់ម៉ា ដែល ស្ថិត នៅក្រោម ការគ្រប់គ្រង់ របស់ ក្រុម យោធា នា ពេល កន្លងមក ។
ក្រាប៊ី និង ក្រុង បាងកក រដូវកាល ការប្រៀបធៀប
ពៅ លីដា ខើច លុយ សម្ពោធ ហាង
ផ្លូវ ល្អ មួយ ទៀត ហើយក៏ អាច ជា ដំណោះស្រាយ រយៈពេល យូរ ផងដែរ !
ប៉ុន្តែ យ៉ាងណា កែវ និសា មិន អាច ទាក់ទង សុំ យោបល់ បាន ទេ កាលពី ចុង សប្តាហ៍ មុន នេះ ៕
នៃ តំបន់ ដ៏ កម្សត់ នោះ បាន អង្គុយ ក្រេប ចំណេះដឹង ។
សកម្មជន និង សមាជិក សហជីព ប្រហែល ២០០ នាក់ បាន ចូលរួម ព្រឹត្តិការណ៍ បើក យុទ្ធនាការ នេះ ដោយ អ្នក ខ្លះ កាន់ បដា ដែល សរសេរ ថា គ្រប់ គ្នា ខ្លាច កូវីដ ខ្ញុំ ខ្លាច ដាច់ បាយ ផ្តល់ ប្រាក់ អតីតភាព ឱ្យ ខ្ញុំ និង និយាយ ថា ទេ ចំពោះ ការស្រេកឃ្លាន របស់ កម្មករ ។
ឯកឧត្តម លោកជំទាវ លោក លោកស្រី និង អង្គ សិក្ខាសាលា ទាំងមូល ជា ទី មេត្រី !
ខាងក្រោម នេះ លោក អ្នក អាច រកឃើញ ចម្លើយ ចំពោះ សំណួរ ដែល មនុស្ស ជាច្រើន សួរ អំពី កម្មវិធី រៀន គម្ពីរ របស់ យើង ។
ចង់ ដឹង ថា សិច អាច មាន ប្រយាជន៍ យ៉ាងណា ខ្លះ សូម អាច អត្ថបទ ខាងក្រោម ៖
ដើម្បី ធ្វើ ដូច នោះ អ្នកប្រើប្រាស់ គ្រាន់តែ ធ្វើ តាម ជំហាន ដូច ខាងក្រោម
ជម្លោះ នេះ បាន ឈានដល់ តុលាការ ឃុំ ខ្លួន តារា ស្រី រូប នេះ នៅ ពន្ធនាគារ ។
បុរស បុរស ប្រុស មនុស្ស ធំ
ហង់ ជួន ណារ៉ុន អើយ បើ អសមត្ថភាព ទេ សូម ចុះចេញ ទៅ កុំ យក ដៃ បាំង ព្រះអាទិត្យ និង ភូត សម្តេច ហ៊ុន សែន តទៅទៀត អី ។
បុរស ង្ស័យ រង ការចាប់ខ្លួន មាន ឈ្មោះ សេង សុវ៉ាន់ ភេទ ប្រុស …
ពេល កំពុងតែ ឡើង ឋានសួគ៌ សុខ នោះ ស្រាប់តែ នាង ខាំ លិង្គ របស់ លោក បណ្តាលឱ្យ របួស ធ្ងន់ ។
សម្តេច ក៏ បាន អំពាវនាវ ឱ្យ មាន ការផ្សព្វផ្សាយ ឱ្យ បាន ទូលំទូលាយ អំពី បញ្ហា នេះ ផងដែរ ៕
ព្រះពុទ្ធ ទ្រង់ សម្តែង ថា ការគ្រប់គ្រង ខ្លួន ឯង បានជា កំពូល មនុស្ស ។
ឥឡូវ អង្គការ របស់ យើង បាន ស្វែងរកឃើញ ថា មាន ប្រភេទ សត្វ ស្លាប និង សត្វ ព្រៃ ផ្សេង ៗ
បែលហ្សិក គឺជា ក្រុម មួយ ក្នុង ចំណោម ក្រុម ខ្លាំង ៗ
គ្រប់ ដំណោះស្រាយ ទាំងអស់ កើត ចេញ ពី សំណួរ ។
រីករាយ បាន រាប់អាន សុធា ។
សម្រាប់ ព័ត៌មាន បន្ថែម ៖
លោក បញ្ជាក់ ថា លោក មិន ចាប់អារម្មណ៍ នឹង ការថ្លែង របស់ លោក ខឹម វាសនា នោះ ទេ ។
ក៏ប៉ុន្តែ ប្រទេស ជា សមាជិក អាស៊ាន មួយចំនួន ថ្មី ៗ
ការវះកាត់ អាច ប្រឈម នឹង គ្រោះថ្នាក់ អ្វី ខ្លះ ?
ស្រី មេអំបៅ ច្រៀង ដោយ ៖
ទាំងនេះ - ជីវិត និង សង្គម
តេស្ត អវិជ្ជមាន លើក ទី៣ ៖
សម្តេច តេជោ ដឹកនាំ គណៈប្រតិភូ ទៅ …
សង្គ្រាម នឹង មិន អាច កើតឡើង នៅ ឧបទ្វីប កូរ៉េ ជាដាច់ខាត
ថ្នាក់ដឹកនាំ ក្រសួង បរិស្ថាន អំពាវនាវ ដល់ គ្រប់ ៗ
ជាពិសេស នៅ រដូវ រាំងស្ងួត ឬ នៅពេល ស្រុក ទេស មាន សង្គ្រាម ទុរ ភិក្ស អន្តរាយ ។
មន្ត្រី ជំនាញ ប.ស. សចូលរួម វគ្គ បណ្តុះបណ្តាល ស្តីពី …
នេះ បើ តាម សេចក្តីប្រកាស ព័ត៌មាន រួមគ្នា រវាង អង្គការ UNDP និង ក្រសួង ផែនការ កម្ពុជា ចុះ ថ្ងៃទី ៨ ខែតុលា ៕
ខ្លោងទ្វារ ចូល វត្ត មើល ពី ក្នុង ចេញ ក្រៅ ។
ខ្ញុំ បាន ជាប់ ឆ្កាង ជាមួយនឹង ព្រះគ្រីស្ទ ប៉ុន្តែ ខ្ញុំ រស់នៅ មិន មែន ជា ខ្ញុំ ទៀត គឺជា ព្រះគ្រីស្ទ ទ្រង់ រស់ ក្នុង ខ្ញុំ វិញ ហើយ ដែល ខ្ញុំ រស់ ក្នុង សាច់ ឈាម ឥឡូវនេះ នោះ គឺ រស់ ដោយ សេចក្តីជំនឿ ជឿ ដល់ ព្រះរាជ បុត្រា នៃ ព្រះ ដែល ទ្រង់ ស្រឡាញ់ ខ្ញុំ ក៏ បាន ប្រគល់ ព្រះអង្គ ទ្រង់ ជំនួស ខ្ញុំ ហើយ ។
វា ជា ការឆ្លើយតប ទៅនឹង ការវាយប្រហារ របស់ រដ្ឋាភិបាល ក្រុង វ៉ាស៊ីនតោន អំពី កំណត់ត្រា សិទ្ធិ មនុស្ស របស់ ចិន ។
ប្តី ប្រពន្ធ អាច លែងលះ គ្នា ដោយ ស្ម័គ្រចិត្ត បាន ។
របស់ ចិន នៅ កម្ពុជា ។
សង្ស័យ ហើយ គឺជាក់ច្បាស់ តែម្តង អ្វី ៗ
លោក សែម ហឿន មិន បាន ដឹង ថា ចលនា ប្រឆាំង នោះ កើតមាន តាំងពី ពេលណា ទេ គ្រាន់តែ ដឹង ថា ត្រូវ ធ្វើ សកម្មភាព នៅ ឆ្នាំ ១៩៧៧ ដើម្បី គេច ចេញ ពី របប កម្ពុជា ប្រជាធិបតេយ្យ ៖
ហើយ នៅ ខាងក្នុង ក៏ មាន បន្ទប់ទឹក និង កូន រង្គ សាល មួយ ផងដែរ ។
ស្តាប់ អ្នក ទាំងអស់ គ្នា បរិយាយ ទៅ ដូចជា ជក់ចិត្ត មែនទែន !
ក្នុង កម្មវិធី នេះ មាន និស្សិត ជាច្រើន ដែល មកពី សាកលវិទ្យាល័យ ផ្សេង ៗ
១០ចិត្ត ទូលបង្គំ កំរើក ជាខ្លាំង
យើង ឃើញ ចំនួន បុគ្គលិក យើង ឃើញ ការផ្សព្វផ្សាយ ការងារ ផ្នែក ហិរញ្ញវត្ថុ ច្រើន ជាង គេ ។
