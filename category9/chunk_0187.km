កាលពី សម័យ បុរាណ ពាក្យ ថា កុំព្យូទ័រ ត្រូវបាន គេ ប្រើ សំដៅ លើ មនុស្ស ដែល ធ្វើការ ក្នុង មុខងារ ជា អ្នក គណនា លេខ ។
ក្រសួង ការងារ និង បណ្តុះបណ្តាល វិជ្ជាជីវៈ បាន ឆ្លើយតប ទៅនឹង ការរិះគន់ របស់ អង្គការ សង្គម ស៊ីវិល អំពី សេចក្តីព្រាង ច្បាប់ ស្តីពី …
១. ស្គាល់ ការងារ ដែល ត្រូវ ដាក់
ទីក្រុង លីត ធីស្ស រដ្ឋ ភិន ស៊ល វែន ញា ថ្ងៃទី ១១ ខែមេសា ឆ្នាំ ២០០៨-- សម្ព័ន្ធ ព្រះគម្ពីរ សញ្ញា ផុក ឃីត កំពុងតែ ធ្វើ ការអបអរ ខួប ១០០ នៃ ព័ន្ធ កិច្ច ដែល មិន គួរឱ្យ ជឿ ទាល់តែសោះ នៅក្នុង សហរដ្ឋ អាមេរិក ។
សូម បងប្អូន ប្រជាពលរដ្ឋ បើកបរ ត្រូវ ចេះ មាន អធ្យាស្រ័យ និង គោរព ច្បាប់ ចរាចរណ៍ ដើម្បី ការពារ ខ្លួន ឯង និង អ្នកដទៃ ៕
ស្ត្រី បំរើ សេវា កំសាន្ត និង សកម្មជន ក្នុង ការងារ អេដ
កសិករ ប្រកបរបរ ដាំ ដំណាំ បន្លែ គ្រប់ ប្រភេទ នៅ បណ្តា ស្រុក មួយចំនួន ក្នុង ខេត្ត កណ្តាល កំពុងតែ រអ៊ូរទាំ គ្រប់ ៗ
ម្តាយ ខំពរ ពោះ តាំងពី មួយ ខែ រហូតដល់ ៩ ខែ១០ ថ្ងៃ ។
ទ ចោទ ជាខ្លាំង ។
សូម អាន សេចក្តីប្រកាស ខាងក្រោម ៖
អំពើពុករលួយ គឺ ត្រូវបាន គេ មើលឃើញ ជាទូទៅ ក្នុង ចំណោម មហាជន ។
នៅ ធ្វើជា ធម្មតា ហើយ ពី ធី បុណ្យ អុំ ទូក នោះ ក៏ នៅ ធ្វើ ធម្មតា ដែរ គ្រាន់តែ មិន ធ្វើ ក្នុង កម្រិត ថ្នាក់ ជាតិ តែ ប៉ុណ្ណោះ ។
វត ទុទាំងអស់ ដនះ បាន បគាញ ឱ្យ ដ
កីឡាករ សញ្ជាតិ វែល ខាងលើ នេះ បាន ចូល ហាត់ ពេញ ២សប្តាហ៍ មកហើយ និង មិន មាន បញ្ហា របួស ទៀត នោះ ទេ ។
មឹក បំពុង ក៏ ត្រូវបាន ប្រជាជន ខ្មែរ យើង ញ៉ាំ ច្រើន ដែរ ទាំង ក្នុង តំបន់ សមុទ្រ និង ទីក្រុង ។
តារាចម្រៀង គង់ សុខ ផានិង ស្វាមី នៅ ថ្ងៃ រៀប មង្គលការ ។
សូម ទាក់ទង ផ្នែក ភាសា តាម អាស័យដ្ឋាន អ៊ីម៉ែល ៖
ដោយសារ វិន័យ និង ក្រម សិលធម៌ សុជីវធម៌ ព្រះសង្ឃ មិន អាច ប្រើ ភាសា រួមភេទ ដោយ ចំ ៗ
សូម ចូល មើល ការរំឮ ក ព្រឹត្តិការណ៍ ប្រវត្តិសាស្ត្រ ស្តីពី ការនិរទេស លោក សឺង ង៉ុក ថាញ់ … ។
ថ្លែង ប្រាប់ ទាំង អួល ដើម ក រ តារាចម្រៀង ជួរ មុខ របស់ ផលិតកម្ម ថោន បាន ប្រាប់ ថា គ្មាន អ្វី ដែល ឈឺចាប់ ជាង ការមើលឃើញ ប៉ា របស់ ខ្លួន ធ្លាក់ ក្នុង សភាព បែប នេះ ទេ ។
សមត្ថកិច្ច អំពាវនាវ ដល់ បងប្អូន ណា ដែល បាត់ សមាជិក គ្រួសារ សូម មក ទាក់ទង លោក មេឃុំ ព ពេល ក្នុង ស្រុក បរិបូណ៍ ៕
បាន ធ្វើឱ្យ ក្រុម វណ្ណៈ ដាលីត អស់ ជំនឿចិត្ត ព្រោះ សមាជិក បក្ស ត្រូវ គេ មើលឃើញ ថា ជា មនុស្ស ដដែល ដែល បាន គាបសង្កត់ ពួកគេ ជាដរាប មក នោះ ។
ភ្នំពេញ ប៉ុស្តិ៍ ចាប់ផ្តើម កម្មវិធី លើ ទូរស័ព្ទ ជា ផ្លូវការ
ខ្ញុំ ធ្លាប់ ស៊ុត ចូល គ្រាប់ បាល់ សំខាន់ ៗ
នេះ ក៏ មាន ការផ្តល់ ប្លង់ កម្មសិទ្ធិ ប្រទាន កម្ម ហើយ តំបន់ មួយចំនួន ទៀត ក៏ ត្រូវបាន អនុវត្ត ជា សម្បទាន ដី សង្គមកិច្ច ជា ហូរហែ ។
លោក បាន និយាយ ទៀត ថា ក្រសួង ការបរទេស វាយតម្លៃ ជានិច្ច នូវ ហានិភ័យ ដល់ ពួក អ្នកធ្វើដំណើរ ។
លោក បណ្ឌិត សភាចារ្យ សុខ ទូច បាន បញ្ជាក់ ថា ថ្មី ៗ
ឧបករណ៍ ដើម្បី បង្កើន ការអនុវត្ត ប្រព័ន្ធ នេះ និង បង្កើន ប្រសិទ្ធភាព ការលេង ហ្គេម នេះ ។
ទៀត ថា មិន អាច តវ៉ា បាន ឡើយ បើសិន តាម ការទូទាត់ សំឡេង ឆ្នោត រួចហើយ ហើយ គណបក្ស ទាំងនោះ មិន ទទួល អាសនៈ ណាមួយ នោះ ។
ការវិនាស ហិនហោច ទៀត ដែរ ។
អាជ្ញាធរ មូលដ្ឋាន បាន ត្រៀម ខ្លួន រួច ជាស្រេច ដើម្បី ជួយ ជួយ អន្តរាគមន៍ ក្នុង ការជួយ សាងសង់ ផ្ទះ ដែល ខូចខាត ឡើងវិញ ៕
ពលករ ខ្មែរ ប្រមាណ ជាង ៥ម៉ឺន នាក់ បាន ទទួល ការចាក់ វ៉ាក់សាំង រួចហើយ នៅ ប្រទេស ថៃ
មកដល់ ពេលនេះ នៅ មិន ទាន់ មាន នរណា ម្នាក់ ចេញមុខ ទទួលខុសត្រូវ ចំពោះ ការផ្ទុះ អំពើហិង្សា នេះ ទេ ។
កិច្ចប្រជុំ នោះ ត្រូវបាន លោក ឈុំ សុជាតិ បញ្ជាក់ ថា បាន លើក ពេល ដោយសារតែ ថៃ កំពុង មមាញឹក រឿង ទឹក ជំនន់ ។
ប្រធានាធិបតី កូរ៉េ ខាងត្បូង អំពាវនាវ បញ្ចប់ ភាពអមិត្ត អស់ រយៈពេល ៧០ ឆ្នាំ រវាង ប្រទេស កូរ៉េ ទាំង ពីរ
ក្នុង រយៈពេល ១៣ ឆ្នាំ នៃ ការងារ គ្រប់គ្រង គ្រោះ ទឹក ជំនន់ អ៊ីបាន ដើរ កាត់ មុខ ផ្ទះ របស់ គ្រួសារ គាត់ តែ បី ដង គត់ ។
១. ឧបករណ៍ បច្ចេកវិទ្យា ទាំងនោះ នឹង ធ្វើឱ្យ ប៉ះពាល់ ដល់ ការលូតលាស់ ខួរក្បាល របស់ ក្មេង ។
រដ្ឋាភិបាល ប្រទេស អ៊ីរ៉ង់ បាន អះអាង ថា ខ្លួន នឹង មិន ប្រគល់ ប្រអប់ ខ្មៅ លើ យន្តហោះ …
លោក ម៉ម សូណង់ ដូ គ្មាន សមត្ថភាព ធ្វើ នាយក រដ្ឋមន្ត្រី សូម ទទួលស្គាល់ ត្រឹម ខ្លួន ឯង បាន ហើយ កុំ ឆ្លើយ ដាក់ គេ …
ការលេង កីឡា បាន ត្រឹមត្រូវ និង តាម ក្បួន ខ្នាត មាន ប្រយោជន៍ ណាស់ ចំពោះ សុខភាព រាងកាយ ។
បច្ចុប្បន្ន មាន សមាគម សហគមន៍ ខ្មែរ និង មជ្ឈមណ្ឌល គាំពារ ពលករ ចំនួន ៤៩ …
ភ្នំ ស្វាយ ពោធិសាត់ ៖
ជា ការពិត ភាគី រុស្ស៊ី ចោទ សហរដ្ឋ អាមេរិក ក៏ ដូចជា សម្ព័ន្ធមិត្ត លោក ខាងលិច ថា ចោទ រដ្ឋាភិបាល ស៊ីរី ទាំង ដោយ គ្មាន ភស្តុតាង ។
នៅលើ បណ្តាញ សង្គម តែ យ៉ាងណាមិញ អ្នកនាង ចន ច័ន្ទ លក្ខិណា មិន បាន ទម្លាយ ឈ្មោះ បុគ្គល រូប នោះ ឡើយ ។
កីឡាករ ប៉ែន សុគង់ បាន ឱ្យដឹង ថា ខ្លួន នឹង បង្ហាញ ឱ្យ ពិភពលោក បាន ដឹង ពី វិស័យ កីឡា អត្តពលកម្ម របស់ ប្រទេស កម្ពុជា ក្នុង ព្រឹត្តិការណ៍ អូឡាំពិក នេះ ។
តើ មាន រឿង អ្វី បាន កើតឡើង កាលពី ថ្ងៃទី ៣ ខែវិច្ឆិការ រវាង អ្នកតំណាងរាស្ត្រ ឈាង វុន និង ក្រុម ព្រះសង្ឃ នៅ វត្ត ពោធិយារ៉ា ម ហៅ វត្ត ចាស់ ?
បើ យើង ព្យាយាម បំរះ ឱ្យ ខ្លាំង យើង នឹង ភ្ញាក់ ចេញ ពី សុបិន អាក្រក់ នេះ ។
ច បែំបកប នែត ២ក្ត ប៉េុ
ង និង ពិចារណា លើ
