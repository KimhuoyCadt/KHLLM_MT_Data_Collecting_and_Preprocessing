ជាង នេះ ទៅ ទៀត អ្នក គួរ មាន កំណត់ត្រា ទុក នូវ ឱកាស ទាំងនោះ ដែល នឹង អាច មាន ប្រយោជន៍ សម្រាប់ ថ្ងៃ ខាងមុខ ។
យើង មើលឃើញ ថា ពួកគាត់ មិន សូវ ចេះ ធ្វើ អ្វី
គុណវិបត្តិ សំខាន់ ដើម្បី ដឹង
គ្នា ដែល យើង បាន តម្រៀប នៅមុខ ផ្ទះ ។
លោក គន់ គីម បាន បញ្ជាក់ ។
ដូច្នេះ តើ អ្នក ធ្វើ ដូចម្តេច ដើម្បី ទាក់ទាញ អ្នក ជួល ជន បរទេស ?
នេះ បើ តាម ក្រុម វេជ្ជបណ្ឌិត ។
តែងតែ មាន ទំនាស់ នយោបាយ ជានិច្ច ។
ចំណែក អ្នកស្រី ត្រូវ ចំណាយ ពេល ទាំងស្រុង ដើម្បី ថែទាំ ប្តី ដូចគ្នា ដែរ ។
រឿង ដ៏ គួរឱ្យ ភ្ញាក់ផ្អើល មួយ ខណៈ ដែល នៅ សុខ ៗ
យើង បាន សំភាសន៍ សួរ កសិករ មួយចំនួន នៅ ទីនោះ ។
ត្រង់នេះ ធានា ថា នាង នឹង មាន អារម្មណ៍ ហើយ ចង់ឱ្យ អ្នកធ្វើ បែប នេះ ទៀត ជា មិន ខាន ។
ប៉ុន្តែ ប្រសិនបើ ផ្នែក ខាងលើ ប្រព្រឹត្ត ត្រឹមត្រូវ នោះ អ្នក ផ្សេង ទៀត ក៏ នឹង ដើរ តាម គន្លង នោះ ដែរ ។
ដោយសារ អ្នកណា ម្នាក់ បាន ផ្ញើ រូបថត ស្រើប ស្រាល ឱ្យ ពួកគេ នោះ ពួកគេ ក៏ បង្ខំ ចិត្ត ធ្វើ ដូច្នោះ វិញ ដែរ ។
ជឺ ជិត ស៊ូ គឺជា វិធី មួយ ដើម្បី អភិវឌ្ឍ ខ្លួន ឯង
កាលពី សប្តាហ៍ មុន ឃើញ មាន ចំនួន ៩រថយន្ត ។
ហើយ អល់ ឡោះ មិន និយាយ រក ពួកគេ ឡើយ នៅ ថ្ងៃបរលោក ហើយក៏ មិន សំអាត បាបកម្ម ពួកគេ ដែរ ។
បញ្ហា ទាំងនេះ កើតមាន នៅតែ ក្នុង មាត់ របស់ អ្នក តែ ប៉ុណ្ណោះ ហើយ អនាម័យ ត្រឹមត្រូវ អាច កម្ចាត់ បញ្ហា គួរឱ្យ ខ …
អ្នក មាន អាជីព អន្តរជាតិ ផ្តាស់ ប្តូរ គំនិត គ្នា នៅ វ៉ាស៊ីនតោន
១៧ក្នុង ករណី នេះ ខ្ញុំ បាន ចាត់ លោក ធី ម៉ូថេ ជា កូន ដ៏ ជា ទីស្រឡាញ់ របស់ ខ្ញុំ ដែល ស្មោះត្រង់ នឹង ព្រះអម្ចាស់ អោយ មក រក បងប្អូន ។
លោក នាយក ក្រុមហ៊ុន ក្រឡេក មើល ទៅ និស្សិត កំសត់ ដោយ ក្តីអាណិតអាសូរ ហើយ ប្រាប់ ថា ៖
ពុំ បាន ល្អ ប្រសើរ មាន ទាស់ សម្តី គ្នា បន្តិចបន្តួច ។
ប៉ុន្តែ ក្រោយមក យុទ្ធសាស្ត្រ របស់ យើង ត្រូវបាន កែសម្រួល វិញ ព្រោះ នេះ ជា ការប្រឈមមុខ របស់ ពិភពលោក ។
រឿង សំលេង ទាំង ពីរ
អាជ្ញាធរ ឥណ្ឌូណេស៊ី កំពុង តាម ស្វែងរក …
ខ្ញុំ ពិតជា មាន មោទនភាព ណាស់ ចំពោះ បទពិសោធន៍ និង កម្មវិធី ចាក់ផ្សាយ ខ្សែភាពយន្ត នៅ ថ្ងៃ នេះ ៕
បានជា ប្រជាកសិករ នឹង នរចិត្ត ណាស់ ។
ស្តាប់ ទៅ វា ចម្លែក បន្តិច ប៉ុន្តែ វា ជា ការពិត ។
ចង់ ដឹង ហេតុអី សក់ ជ្រុះ អត្ថបទ នេះ ប្រាប់ ទាំងអស់ ម៉ង
បាន សេចក្តី ថា ជា មនុស្ស ដែល ចូលចិត្ត ភាព សប្បាយរីករាយ សម្រាប់ ខ្លួន ឯង ។
យើង ក៏ មិន ដឹង ថា ដំណើរ រឿង របស់ លោកស្រី យ៉ោម បុប្ផា នេះ មាន យ៉ាងដូចម្តេច បានជា ចូល ទៅដល់ តុលាការ នោះ ទេ ។
បន្ទាប់មក គាត់ អាច ប្រើ ជើង រុញ តិច ៗ
ឥឡូវនេះ លោក មាន អាយុ ៧២ ឆ្នាំ ហើយ ហើយ កំពុង រស់ នៅក្នុង ផ្ទះ តូច មួយ តែ ម្នាក់ឯង ។
ទោះបីជា បែប ណា ការចាក់សោ ពី ខាងក្រៅ
កុំ នៅ អាល័យ អាឡោះ ស្រណោះស្រណោក ដល់ ណាណា ជី វា ។
ម្ចាស់ ក្រុមហ៊ុន នេះ ហើយ ជា ការព្រួយបារម្ភ ដែល ខ្ញុំ ត្រូវ ផ្ទេរ ឱ្យ លោក ជា អ្នកដោះស្រាយ !
ដល់ កន្លែង ធ្វើការ ។
លោក បាន បន្ត ថា វិស័យ វាយន ភណ្ឌ របស់ កម្ពុជា នឹង មាន ការកើនឡើង បន្ត ទៀត ដោយ
បើ តាម ការរៀបរាប់ ពី នារី រងគ្រោះ បាន ឱ្យដឹង ថា ៖
អ្វី ដែល ភរិយា គ្រប់ គ្នា តែង ត្រូវការ តែ ស្វាមី ភ្លេច ពី ភាពសំខាន់ ទាំងនោះ
ការផ្តល់ ប្រឹក្សា អំពី ការវិនិយោគ លើ មូលបត្រ ដល់ អ្នក វិនិយោគ ដោយ ទទួលបាន នូវ កម្រៃ សេវា ហើយនិង
តែ យ៉ាងណា លោក ដូណាល់ ត្រាំ បាន ថ្កោលទោស យ៉ាង ខ្លាំង ចំពោះ ការសម្រេចចិត្ត បែប នេះ ៕
ប្រភេទ ជំងឺ សើស្បកែ ៧យ៉ាង អាច កើត លើ កុមារ ដោយ ងាយ ៗ
ប៉ុន្តែ ដោយសារតែ ក្រុមហ៊ុន ធ្វើ ប្រតិបត្តិការ កាន់តែ ច្រើន ឡើង ៗ
កសិកម្ម ដំណឹង ថ្ងៃ នេះ
ការចូលរួម វិភាគទាន សង្គម មាន ជាអាទិ៍ ពិធី បុណ្យ ចូលរួម អាពាហ៍ពិពាហ៍ ។
តាមពិត គម្ពីរ គឺ ពិសេស មែន ។
ក្នុង ប្រតិបត្តិការ ចុះបង្ក្រាប ករណី ខាងលើ នេះ ក៏ មាន ការសហការ ចូលរួម ពី កម្លាំង អាជ្ញាធរ សង្កាត់ ស្ទឹងមានជ័យ ទី៣ ផងដែរ ។
ម្យ៉ាងទៀត សូម លោក អ្នក កាត់បន្ថយ នូវ ទុក្ខ កង្វល់ ទាំងឡាយ ដែល បាន កើតមាន ពេល មុន ។
សៀមរាប ចែករំលែក
ប៉ុន្តែ ខ្ញុំ គិត ថា អាស៊ាន មិន ដូច សហភាព អឺរ៉ុប នោះ ទេ ។
គ្រូពេទ្យ និង អ្នកជំងឺ វគ្គ ទី៥ ៖
តើ ជា ការលែងលះ គ្នា រៀង រហូត ឬមួយ គ្រាន់ ជា ការចែក ផ្លូវ គ្នា ដើរ មួយ រយៈ ដើម្បី បន្ធូរ អារម្មណ៍ ?
នេះ ក៏ ជា សិក្ខាបទ ដ៏ សំខាន់ សម្រាប់ ឧបាសក ឧបាសិកា ផងដែរ ។
បើ ទោះបី ប្រជាជន អ៊ីតាលី មាន ភាពរីករាយ ដោយ ទទួលបាន នូវ សេរីភាព ខ្លះ ៗ
វា ជួយ ឱ្យ ខួរក្បាល មាន សុខភាព ល្អ និង បង្កើន ការចងចាំ ។
ប៉ុន្តែ ទោះបីជា យ៉ាងណា ក៏ នាង នៅតែ មើល ទៅ លេចធ្លោ ជាមួយនឹង ស្ទីល សក់ ខ្លី នេះ ដែរ និង កាន់តែ ក្មេង ជាង មុន ថែម មួយ កម្រិត ៕
គាត់ បន្ត ថា ពីមុនពេល មាន ភ្លៀង ធ្លាក់ ធំ ៗ
ចំនួន នេះ មិន បាន បូករួម ទាំង ការឧបត្ថម្ភ ផ្សេង ៗ
គឺ ក្រុមហ៊ុន មាន សំណង បន្ថែម ។
យើងខ្ញុំ នឹង កែតម្រូវ និង ទំនាក់ទំនង ទៅ លោក អ្នកវិញ តាម ការគួរ ។
ទាល់តែ ពិនិត្យ ទើប ដឹង ។
បុរស នោះ ក៏ បង្ហាញ ប្រទាល ប្រហាង ហើយ ឆ្លើយ ថា ៖
៩ខ្ញុំ ទូល អង្វរ ព្រះជា ម្ចាស់ ដូចតទៅ នេះ គឺ សូម អោយ បងប្អូន មាន សេចក្តីស្រឡាញ់ ដ៏ លើសលប់ កាន់តែ ខ្លាំង ឡើង ៗ
លោកស្រី បាន បន្ត ទៀត ថា ជន ពិការ ប្រមាណ ជា ៥០ ម៉ឺន នាក់ កំពុង រស់ នៅក្នុង ប្រទេស កម្ពុជា ។
ឥឡូវនេះ ខ្ញុំ គ្រប់គ្រង វា គាត់ និយាយ ។
លោក សុធារិន បាន បន្ថែម ទៀត ថា ពួកគេ នឹក ខ្ញុំ ខ្លាំង ណាស់ ។
