នៅក្នុង សកលលោក ទាំងមូល ក៏ ត្រូវ រង ទុក្ខលំបាក ដូច បងប្អូន ដែរ ។
នៅនឹង កន្លែង កើត ហេតុ ចំណែក ម៉ូតូ ខ្ទាត ចេញ ក្រៅ ខូចខាត តិចតួច ។
បោះជំហាន ទៅ មុខ ជានិច្ច ធ្វើ អ្វី មុន គេ រហូត មាន ចិត្ត សប្បុរសធម៌ និង ឯករាជ្យ
ទៀត ដែល បាន កើតឡើង អស់ រយៈជាច្រើន ឆ្នាំ មកហើយ ។
ប្រសិនបើ ក្តីសុខ របស់ អ្នក គឺ ការអង្គុយ មើល ទេសភាព ទីក្រុង ឬ ពន្លឺ ភ្លើង នៅ ពេល យប់ ពី ទីកន្លែង ខ្ពស់ ៗ
ធ្លាប់ មាន អារម្មណ៍ ធុញ ថប់ នឹង រឿងរ៉ាវ ជាច្រើន ស្មុគស្មាញ នៅ ភ្នំពេញ ទេ ?
មន្ត្រី សមាគម អាដហុក ចំនួន បី នាក់ ផ្សេង ទៀត ក៏ ត្រូវ ចាប់ខ្លួន ក្នុង សំណុំរឿង ដូចគ្នា នេះ ដែរ ។
មក និង សូម បង្ហាញ ជូន ដូច ខាងក្រោម
នេះ ផ្តិល សំរិទ្ធិ នេះ ជា របស់ ចាស់ យូរអង្វែង ហើយ មិន មែន របស់ ឥឡូវ ឥឡា ទេ ។
កុំ ធ្វើដំណើរ កុំ ទៅ សាលារៀន ឬ ទៅ ធ្វើការ ។
ការទាមទារ ឱ្យ បោះឆ្នោត ទ្បើង វិញ គឺ មិន អាច ទៅ រួច
យ៉ាងណាមិញ បច្ចុប្បន្ន នេះ អាជ្ញាធរ ក្រុង បាន តម្រូវ ឱ្យ ពួកគាត់ ធ្វើចត្តាឡី ស័ក នៅ ផ្ទះ រៀង ៗ
ដែល មាន នៅក្នុង ក្រុង នោះ ទុក ជា ជយភ័ណ្ឌ ស្រប តាម ព្រះបន្ទូល ដែល ព្រះអម្ចាស់ បង្គាប់ មក លោក យ៉ូស្វេ ។
មាន គេ ចេញមតិ ជាច្រើន តែ អ្នកឯង នៅតែ ស្ងៀម មាត់ ឱ្យ ឈឹង យ៉ាង នេះ ។
គេ សង្កេតឃើញ ប្រធាន ស្ថាប័ន រដ្ឋ មួយចំនួន …
យើង មាន មិត្តភក្តិ យើង មាន ការរាប់ រក មាន គេ ស្រឡាញ់ មាន គេ ជួយ ។
មនុស្ស ជាច្រើន មិន បាន យកចិត្ត ទុក អ្វី ដែល បាន កើតឡើង អ្នក នៅ ជុំវិញ ខ្លួន ឬ អ្វី ដែល ខ្លួន កំពុង មាន នោះ ឡើយ ហើយ មួយ ថ្ងៃ ៗ
កុណ្ឌ លី វិមាន ទី៨
សេដ្ឋី រូប នេះ ពិតជា ខ្វាយខ្វល់ យ៉ាង ខ្លាំង ប្រញាប់ …
រដ្ឋមន្ត្រី សន …
តៃវ៉ាន់ បាន បាត់បង់ អសនៈ របស់ ខ្លួន នៅ អង្គការ សហ ប្រជាជាតិ ក្រោយពេល ចិន បាន ចូលរួម អង្គការ ពិភពលោក នេះ ក្នុង ឆ្នាំ ១៩៧១ ។
ប៉ុន្តែ កំហុស ធំ បំផុត នោះ គឺ រដ្ឋាភិបាល ព្រោះ ខ្លួន ជា ម៉ែឳ គេ !
វត្ត សំរោង បុរី វិគី ភីឌា
ទាំងអស់ គឺ ពឹង ទៅ លើ ការគិត តែម្តង ។
អង្គការ ទាំង ១២រួម …
កម្មករ រោងចក្រ រងគ្រោះថ្នាក់ ចរាចរណ៍ កន្លងមក ។
ពួកគេ គួរតែ ត្រូវបាន ដោះលែង ។
ប្រញាប់ ឡើង មក ទីនេះ ។
ចូលរួម សហគមន៍ ក្រុម ។
ប៉ុន្តែ សូម ចងចាំ ថា អ្វី ដែល ខ្ញុំ ប្រាប់ អ្នក គឺជា ការពិត ។
ភ្នំពេញ ការបង្ហាញ ម៉ូត កំពុងតែ ក្លាយទៅជា ជំនួញ មួយ មាន ការរីកធំធាត់ នៅក្នុង ប្រទេស កម្ពុជា ។
ភាសា ក្នុង កម្មវិធី ៖
នេះ បើ យោង តាម សេចក្តីថ្លែងការណ៍ មួយ របស់ ព្រះបរម រាជ វាំង ។
ច្រមុះ តូប សៀវភៅ
និព្វា នំ អធិមុត្តា នំ អត្ថំគ ច្ឆន្តិ អាសវា ។
ក្រុម អ្នកវិទ្យាសាស្ត្រ ទាំងនេះ មាន គម្រោង ផលិត ឱសថ ថ្មី នេះ នៅក្នុង ឆ្នាំ ២០១២ ខាងមុខ ។
ជនភៀសខ្លួន នៅ អូស្ត្រាលី អាចនឹង មកដល់ កម្ពុជា នៅ ចុង ឆ្នាំ ២០១៤
គេ ប្រាថ្នា ចង់បាន សេចក្តីស្លាប់
អ្នក នឹង ត្រូវ កំទេច អោយ ទៅជា ទី ស្ងាត់ ជ្រងំ
ពលរដ្ឋ គាំទ្រ ការ មិន ប្រើ គោរមងារ សម្តេច នៅក្នុង អត្ត បទ សារព័ត៌មាន ?
សីតុណ្ហភាព នៅក្នុង ខេត្ត បឹងកាន នៅ ថៃ ភាគ ឦសាន បាន ធ្លាក់ចុះ ដល់ ៩អង្សា សេ នៅ ពេល យប់ កើត ហេតុ ។
មកដល់ ឆ្នាំ ១៩៧៣ ការរួមភេទ ដូចគ្នា ត្រូវបាន ចាត់ទុក ជា ជំងឺ សរសៃ ប្រសាទ កំណត់ ដោយ សម្ព័ន្ធ សមាគម សរសៃ ប្រសាទ អាមេរិក ។
ក្រៅតែ ពី ឱ្យដឹង ថា ផលិតផល នេះ នឹង មិន អាច បង្ហាញ វត្តមាន ក្នុង ទីផ្សារ មុន ឆ្នាំ ២០១៥ ហើយ
ត្រូវ គោរព ចុះ ចូល នឹង ម្ចាស់ របស់ ខ្លួន ដោយ គោរព កោតខ្លាច ទាំងស្រុង មិន ត្រឹមតែ គោរព ចុះ ចូល នឹង ម្ចាស់ ណា ដែល ល្អ និង មាន ចិត្ត សប្បុរស ប៉ុណ្ណោះ ទេ គឺ ត្រូវ ចុះ ចូល នឹង ម្ចាស់ ដែល កាច ផងដែរ ។
សំខាន់ ឧបករណ៍ ចល័ត
ចំពោះ សន្តិសុខ ស្បៀងអាហារ សម្រាប់ ប្រជាពលរដ្ឋ ១៦០លាន នាក់ គឺ ត្រូវបាន ធានា ។
នំប៉័ង ១ដុំ សម្រាប់ រូប៊ីរី ស ពី មួយ ថ្ងៃ មុន
លោក អះអាង ថា នឹង ផ្សព្វផ្សាយ ដំណឹង នេះ បន្ត ទៀត ដើម្បី ស្វែងរក សប្បុរសជន ដែល ចង់ ជួយ ៕
ទទួលយក វា ឥឡូវនេះ និង មាន អារម្មណ៍ ថា ប្លែក
ដ៏ សម្បូរបែប និង រស់រវើក ផ្តើម ពី នោះ ប្អូន ៗ
យប់ នេះ ចាំ មើល កុំ ឱ្យ ខកខាន ព្រះច័ន្ទ ពេញ ដួង មតិ អ្នក
ខ មិន ត្រូវ ធ្វើ សកម្មភាព នយោបាយ ។
សម្រាប់ ប្រទេស ជិតខាង ទាំង ពីរ ដែល តែងតែ ប្រយ័ត្នប្រយែង គ្នា ទៅ វិញ ទៅមក ។
កម្មករ ម្នាក់ រងរបួស ធ្ងន់ ដោយសារ ធ្លាក់ ពីរន្ទា សំណង់ កម្ពស់ ពីរ ជាន់
រាងកាយ សម សួន ស្អាត អ្នកណា ក៏ ចង់បាន ។
លោក នឹង នៅតែ ជា មនុស្ស រុញ ខ្សែ ញាក់ ពីក្រោយ វាំងនន ។
កំប៉េះ គូទ ធំ វា គ្រាន់តែ តំណ ពូជ របស់ ខ្ញុំ ប៉ុណ្ណោះ ។
មនុស្ស ដែល មាន ចិត្ត បរិសុទ្ធ មិន ចាំបាច់ ទទួលបាន ការសរសើរ ពី អ្នកដទៃ ចំពោះ អំពើ សប្បុរស របស់ ពួកគេ ឡើយ ។
គេ នឹង បាត់បង់ ទៅ ដូច សត្វ តិរច្ឆាន ដែរ ។
ក្រោយពេល សម្រាល កូន រួចរាងកាយ នឹង ឆាប់ ជាសះស្បើយ លឿន
លោក មិន ជឿ ថា សហគមន៍ អន្តរជាតិ ខ្វល់ខ្វាយ ពី កម្ពុជា ច្រើន ឡើយ ។
៩ ទេវតា របស់ ព្រះអម្ចាស់ ពោល ទៅ នាង ថា ៖
ដែល មាន សក្កានុពល សេដ្ឋកិច្ច មាន ពលរដ្ឋ រស់ នៅ ច្រើន … ។
កុមារី អាយុ ១៤ ឆ្នាំ ម្នាក់ ត្រូវបាន សំលាប់ នៅក្នុង ប្រតិបត្តិការ នោះ ។
ពេល ខ្ញុំ បាន ជួប ពួកគេ ខ្ញុំ មាន ការជឿជាក់ ។
បច្ចុប្បន្នភាព ចុងក្រោយ ៖
ជួនកាល ខ្ញុំ គិត ថា នេះ ក៏ មកពី សំដេច ចក់ សំដាច់ ចែម សហជីវិន ចក់
ប្រសិន អ្នក មិន ចូលចិត្ត ខ្ទឹម បារាំង នោះ អាច កៀប យក ទឹក ទទួលទាន …
ប្រហែល គាត់ អែង ជា អ្នកបញ្ជា ហើយ
ពិភពលោក ថា រដ្ឋអំណាច និង ប្រជាជន របស់ គេ មាន ភាព សំបូរ រុងរឿង ។
នារី ក្នុង ក្តីស្រមៃ ៖
បញ្ជាក់ ចេះ អក្សរ អង់គ្លេស តិច ៗ
ពួកយើង បាន រស់ នៅក្នុង មជ្ឈដ្ឋាន ដែល មាន ការបំពុល ជាច្រើន ។
មោឃភាព ឬ ផ្លាស់ប្តូរ ប័ណ្ណ ក្នុង រយៈពេល ០៦ ខែ
គាត់ មានអារម្មណ៍ ថា មិន ចូលចិត្ត ខ្លួន ឯង ទាល់តែសោះ ។
ប៉ុន្តែ ព្រះអង្គ មិន ពិរោធ ទាស់ នឹង ពួកគេ រហូតដល់ ធ្វើឱ្យ ពួកគេ បាត់បង់ជីវិត ទាំងអស់ គ្នា ឡើយ ។
ប្រពន្ធ តែង ខ្លួន មិន បាន
នេះ ដំឡូង របស់ ពួកគាត់ រលួយ មើម ជា បន្តបន្ទាប់ ។
២០ ឆ្នាំ ទៀតក៍ ប្រជាជន កម្ពុជា មិន ព្រម ឱ្យ ហ៊ុន សែន
លោក ក៏ វិលត្រឡប់ ពី ស្រុក អេស៊ីប មកវិញ ។
ដូច្នេះ យើង មិន ចង់ ស្វាគមន៍ លោក នៅ ទីនេះ ទេ ។
ឯ ពួក អ្នក ដែល ស្អប់ ទូលបង្គំ ដោយ ឥត ហេតុ
តាម សម្តី លោក សារោជ កែវ កាជី បាន ឱដឹង ថា អ្នក រងរបួស ទាំង ២១ នាក់ នោះ សុទ្ធសឹងតែ ជា យោធា ចូលនិវត្តន៍ ។
ខ្ញុំ ពុំ មាន រូបមន្ត ជោគជ័យ អោយ អ្នកតែ ខ្ញុំ អាច អោយ អ្នក នូវ រូប មន្ត បរាជ័យ ។
បច្ចុប្បន្ន នេះ មាន អង្គការ មិន មែន រដ្ឋាភិបាល ចំនួន ៤ ដែល គាំទ្រ គំរោង នៅក្នុង ខណ្ឌ ទី ១២ ។
ភាសា ចិន កុកងឺ ជា ភាសា ដែល គេ ប្រើ ច្រើន ជាង គេ បំផុត នៅលើ ពិភពលោក
យើង យល់ ថា បាតុកម្ម ទាំង នេះ គេ តែងតែ ប្រឆាំង នឹង រដ្ឋាភិបាល ។
ពួកគេ ចាប់ផ្តើម ស្នេហា ក្នុង ឆ្នាំ ២០០៩ ហើយក៏ បាន បែក គ្នា ដោយសារតែ ខាង ប្រុស ស្រឡាញ់ ខាង ស្រី ខ្លាំង ជាង ។
ដើម ឡើយ បណ្តាញ នេះ បាន ទទួល ការទំនុកបំរុង ពី កងទ័ព អាមេរិក និង ប៉ាគីស្ថាន ។
ប្រើ ផលិតផល ច្រើន ពេក ក្នុង ពេល តែ មួយ
ជា កត្តា កំណត់ នៅលើ ដៃ ប្រជាពលរដ្ឋ ប៉ុណ្ណោះ ។
ប្រសិនជា អ្នក ជា អ្នក ដែល កើត ក្នុង ឆ្នាំ ទាំង៣ ខាងលើ អ្នក នឹង អាច ទទួលបាន ទ្រព្យ ពី ទេវតា ទ្រព្យ ក្នុង ថ្ងៃ នេះ ។
បន្ទាប់មក យើង វាស់ ការធ្លកា់ ចុះ សីតុណ្ហភាព នៃ ទឹក ក្រោយពី ៦១២ និង ២៤ ម៉ោង ។
វា ជា ការប្រកួត ដ៏ ជក់ចិត្ត សម្រាប់ ជំនួប លើក ទី២ របស់ អ្នក ទាំង ពីរ ។
ប៉ុន្តែ ជួនកាល ខ្ញុំ បាន ភ្លេច ខ្លួន …
ចូរ ទៅ ពិគ្រោះយោបល់ ជាមួយ គ្រូពេទ្យ បើសិនជា អ្នក គិត ថា អ្នក ឬ កូន កើត ជំងឺ ស្អូច ៕
តើ ពិធី នេះ ប្រព្រឹត្តទៅ យ៉ាងណា ខ្លះ នោះ ជា បន្ត សូម ស្តាប់ គួន សំបូរ រៀបរាប់ ដូចតទៅ ៖
៣ធម្មតា ពួក ផារី ស៊ី និង ជនជាតិ យូដា ទាំងអស់ តែងតែ ធ្វើ ពិធី លាង ដៃ យ៉ាង ស្អាត ហ្មត់ចត់ មុននឹង បរិភោគ តាម ទំនៀមទម្លាប់ របស់ ចាស់ បុរាណ ។
ព្រះអង្គ វិនិច្ឆ័យ ទោស ប្រជាជន ទាំងឡាយ
រថយន្ត បុក ម៉ូតូ រងរបួស ហើយ រត់ គេច មាន ៣ករណី
រៀងរាល់ ថ្ងៃ ប្រជាជន ទាំងអស់ នាំគ្នា
ការដើរ បង្ហាញ ម៉ូដ មួក បែប អភិជន របស់ ភ្ញៀវ ប្រុស ស្រី ដែល បាន ចូលរួម កម្មវិធី ។
ច គឺ បទ ទូរស័ព្ទ
ឯ ព្រះស្រី សុរិយោ ពណ៌ ក៏ ឡើង ជា ឧភយោរាជ ។
នេះ គឺជា ការផ្លាស់ប្តូរ មុនពេល ក្លាយជា មហារីក ។
ប៉ិន ជួញដូរ ណាស់ ។
គ្រាន់តែ ឮ ភ្លាម យើង ប្រាកដជា ងឿងឆ្ងល់ ថា តើ បុណ្យ នេះ ធ្វើឡើង ក្នុង គោលបំណង អ្វី ហើយ គេ ធ្វើ នៅ ប្រទេស ណា ។
នេះ ជា ថ្នាំ ដំបូង ដែល ត្រូវបាន ចេញផ្សាយ ចំពោះ ជំងឺ នេះ ។
ជាច្រើន ដែល មក ទល់ នឹង សព្វ ថ្ងៃ នេះ នៅតែ ត្រូវបាន គេ យក ទៅ ប្រើប្រាស់ ជាពិសេស ក្នុង ការអប់រំ កុមារ ។
ទាំងអស់ ឬ គ្មាន សោះ ៖
ត្រូវ ចេះ ប្រើប្រាស់ ពេលវេលា ក្នុង ការសម្រេចចិត្ត ឱ្យ បាន យូរ បន្តិច មិន ត្រូវ សម្រេចចិត្ត ទាំង ងងឹតងងុល នោះ ទេ ៕
ពួកគេ ប្រយុទ្ធ ឈ្នះ ដើម្បី អរិយធម៌ ។
នោះ យើងខ្ញុំ នឹង វិលត្រឡប់ មកវិញ
រាល់ ពេល ដែល អ្នក ព្យាបាល ៕
អី គ្រាន់តែ មើលក៍ ក្តៅ ខ្លួន ដែរ មាន វីដេអូ
គោលបំណង សំខាន់ នៃ មហាសន្និបាត នេះ ដើម្បី ជ្រើសតាំង ប្រ
ហើយ ខ្ញុំ គិត ថា រឿង នេះ អាចនឹង ធ្វើ ស្ថានភាពប្រែប្រួល ។
របាយការណ៍ ទាំង៦ ត្រូវបាន រកឃើញ ថា បាន ផ្តល់ លើស ពី ៦៨ លាន ដូស ។
លុះ ដល់ វេលា ម៉ោង ៧យប់ ទើប ត្រឡប់មក ផ្ទះ វិញ ។
ជ្រួញ មុន អាយុ ។
ព្រាន នារី យក ដៃ ស្ទាប សុដន្ត នារី ពេល ជិះ នៅលើ រថភ្លើង មាន វីដេអូ ដំណឹង ប្រាំពីរ
ខណ្ឌ ពោធិសែន ជ័យ
សូម អរ ព្រះគុណ ព្រះអម្ចាស់ ដែល ទ្រង់ មិន បាន ខ្ជះខ្ជាយ ការ អ្វី ឡើយ ។
នឹង មាន ភាពភ្លាំង ភ្លាត់ ។
ប៉ុន្តែ សិល្បៈ អាច ផ្លាស់ប្តូរ អាកប្បកិរិយា និង ការពិត របស់ យើង ។
សុទ្ធតែ ទទួលបាន ប្រាក់ ចំណេញ កាលពី ឆ្នាំ មុន
យើង ចង់ ធ្វើឱ្យ ពិភពលោក នេះ ក្លាយជា កន្លែង មួយ ដែល ល្អ ប្រសើរ ជាង មុន ។
ឡើយ ព្រោះ វា នឹង ធ្វើឱ្យ ស្បែក អ្នក កាន់តែ ស្រអាប់ ៕
វា មិន មែន ជា ការបរាជ័យ នោះ ទេ បើសិនជា អ្នក រីករាយ ជាមួយនឹង ដំណើរ ប្រព្រឹត្តទៅ មួយ នោះ ។
អ៊ីចឹង ហើយ បាន ថា មិន អាច ដោះស្រាយ បាន ភ្លាម ៗ
ថវិកា ជាតិ មាន កម្រិត ទាប ធ្វើឱ្យ ប្រព័ន្ធ យុត្តិធម៌ មិន មាន ប្រសិទ្ធភាព
ជាក់ស្តែង នៅ ថ្ងៃ នេះ មាន តារា ល្បី ៗ
ខ្លួន ហើយ ពួកគាត់ ក៏ មិន ហ៊ាន ទៅ ណា ឆ្ងាយ ពី លំនៅឋាន ដែរ ដោយ ខ្លាចក្រែង ទឹក លិច ។
បងប្អូន នឹង កាប់ សម្លាប់ គ្នា ទៅ វិញ ទៅមក ។
លោក សាន្ត ប៊ុន ធឿន ក៏ ភ្ញាក់ផ្អើល ដែរ នៅពេល ដឹង រឿង បែប នេះ ៕
ដង គឺ មួយ លាន ចំណែក អ្នកណា ឈ្នះ ខ្លួន ឯង បាន អ្នក នោះ ឈ្មោះ ថា ជា មនុស្ស ខ្ពង់ខ្ពស់ ជាង អ្នក ដែល ឈ្នះ ក្នុង សង្គ្រាម នោះ ។
ពួកគេ នាំគ្នា រិះគន់ រាហ៊ូពី រឿង គូរ រូប អប្សរា ស្រាត ដោយ និយាយ ថា ធ្វើ បែប ហ្នឹង វា ខុស ប្រពៃណី ។
ធ្វើ បែប នេះ រៀងរាល់ ថ្ងៃ រហូតដល់ ឃើញ លទ្ធផល វិជ្ជមាន ។
គាត់ យក ត្រចៀក ដើរ ស្តាប់ តាម ជញ្ជាំង ផ្ទះ ដើម្បី ស្វែងរក សម្លេង អ្វី មួយ នោះ ។
ជនជា ឃាតក ដែល រឹតក សម្លាប់ កូន ស្រ…
យុវវ័យ ស្នេហា ម្តាយ ខាង ប្រុស ស្រឡាញ់ កូនប្រសារ បែប នេះ
ចំណែកឯ ស្នាម មុត ជ្រៅ ត្រូវការ ចំណាយ ពេលវេលា ព្យាបាល យូរ ។
តែ ខ្លួន ឯង ផ្ទាល់ គ្មាន អ្វី ផឹក ។
នួន ជា ស្លាប់ ស្រួល ជាង ប្រជាពលរដ្ឋ ដែល គាត់ បាន សម្លាប់
ចុះ មូលហេតុ អ្វី ទើប លោក មិន ព្រម ស្វះស្វែង បញ្ចប់ ថ្នាក់ មហាវិទ្យាល័យ សិន ?
តាម ច្បាប់ ការងារ ៕
និង កុមារ ទាំងអស់ នោះ គឺ មាន អាយុ តិច ជាង ៧ឆ្នាំ ទាំងអស់ ។
នេះ ក្រោយ ស្ពាន មួយ ខ្សែ ត្រូវបាន សាងសង់ រួច
ខ្ញុំ នៅតែ ផ្ទះ ។
ត្រឡប់ មកពី សមរភូមិ យ៉ាង សុខ ស្រួល ។
អូហូខ្ញុំ ចូលចិត្ត កំរង រូបថត នេះ ណាស់
ពួក ស្តេច នៅលើ ផែនដី បាន ប្រុងប្រៀប ខ្លួន ឯ ពួក មេគ្រប់គ្រង បាន ប្រមូល គ្នា ទាស់ នឹង ព្រះអម្ចាស់ ហើយ ទាស់ នឹង ព្រះគ្រីស្ទ របស់ ព្រះអង្គ ។
ត្រូវ អនុវត្ត របៀប ប្រើប្រាស់ ទឹក ក្រោម ដី ។
ការ ស្រលាញ់ របស់ គាត់ តែង បង្ហាញ ចេញ ឱ្យ កូន ៗ
បើ ចំណុច ទី៤ធ្វើ បាន នោះ ខ្ញុំ សុខចិត្ត កោរ សក់
ការបរិភោគ ក្រូច ត្លុង និង ទឹកក្រូច ត្លុង ពិតជា មាន ការពេញនិយម ណាស់ នា ពេល បច្ចុប្បន្ន ។
ជាមួយគ្នា បើ គ្រាន់តែ និយាយ ភាសា ការទូត ទេ មិន ចាំបាច់ ទេ ។
យ៉ាងហោចណាស់ ទាហាន ឥណ្ឌា ចំនួន ២០ នាក់ បាន បាត់បង់ជីវិត ដោយសារ ការវ …
ពង្រឹង ដល់ សាច់ដុំ នៅ អាង ត្រគាក ដែល ល្អ បំផុត ក្នុង ពេល រួម ភេទ
បាទ ខ្ញុំ ដឹង ថា អ្នក ខ្លះ នឹង សប្បាយ នៅពេល ខ្ញុំ ស្លាប់ ទៅ ។
កំពូល ទទួលបាន ធាតុ កំពូល ។
លោក បន្ត ថា ក្រោយពី ការចែក អំណោយ ម្តង ៗ
មាន ហ្វេសប៊ុក ប្រើ អាច ដោះស្រាយ បញ្ហា ជូន ពលរដ្ឋ យ៉ាង ឆាប់រហ័ស
ី នេះ ប្រស និបើ អក្ន ទាញយក កម្មវធិទី កុជា មុន
ស្នូរ ផ្ទុះ នានា ត្រូវបាន ស្តាប់ ឮ នៅ ទីក្រុង ទ្រី ប៉ូលី ។
ព្រះអង្គ ជា ព្រះគួរអោយ កោត ស្ញប់ស្ញែង
ហាក់ឌីជូលីន មិន ញញើត នឹង បញ្ចេញ ភាព សិចស៊ី
ខ្ញុំ នឹង សរសើរ ដល់ ទ្រង់ ដោយ បទ ចំរៀង របស់ ខ្ញុំ
ដូច្នេះ បើ មិន យល់ កន្លែងណា នោះ សូម កុំ លាក់ ទុក ។
ដែល បាន សង្គ្រោះ ទូលបង្គំ !
ន័យ អប់រំ រឿង ៖
យើង មិន ដឹង យ៉ាង ប្រាកដ អំពី របៀប ដែល សាតាំង បណ្តាលឱ្យ ស្តេច ដាវីឌ រាប់ ចំនួន រាស្ត្រ នោះ ទេ ប៉ុន្តែ យើង ដឹង ថា វា ជា ចំណែក ដ៏ ធំ មួយ នៃ ផែនការ របស់ សាតាំង ក្នុង ការទាស់ នឹង រាស្ត្រ របស់ ព្រះជាម្ចាស់ ។
នៅ ពេល ដែល អ្នកស្រាប់តែ ប្រែ ជា មិន ចង់ បរិភោគ អាហារ ផ្សេង ៗ
ភេទ បុរស ភេទ មាន អត្រា កើត ជំងឺ មហារីក ខួរក្បាល ច្រើន ជាង ស្ត្រី ភេទ
យ៉ាងណា ក៏ដោយ លោក បាន បញ្ជាក់ ថា លោក មិន ដែល ហ៊ាន ចេញ ក្រៅ តែ ម្នាក់ឯង នៅក្នុង ទីក្រុង ឡើយ ៕
ខ្ញុំ មិន និយាយ ឱ្យ លម្អិត ទេ គ្រាន់តែ ត្រួស ៗ
ជំនួយ មនុស៌្ស ធម លើក ទី មួយ បាន ទៅដល់ ប្រទេស វ៉េណេស៊ុយអេឡា
ពួកគេ ធ្វើការ ជា ក្រុម ជាជាង ប្រកួត មើល បំណាំ គ្នា ។
ជាមួយគ្នា ហើយ ពេល ដែល អ្នក មើល វា អ្នក នឹង កាន់តែ ស្រឡាញ់ គ្នា ថែម ទៀត ។
រំលោភ សិទ្ធិ ពលរដ្ឋ ។
ទោះបីជា យ៉ាងណា ក៏ដោយ ព្រះទ្រង់ ជា ព្រះតែ សាតាំង មិន មែន ជា ព្រះទេ ។
ជា ហេតុ ដែល ធ្វើឱ្យ សារធាតុ ចិញ្ចឹម បន្សល់ទុក ក្នុង រាងកាយ អ្នក ច្រើន ធ្វើឱ្យ អ្នក ងាយ ធាត់ ខ្លាំង ណាស់ ។
ជំរាប សួនឹង សួស្តី កេសី
ខ្ញុំ មិន បោះឆ្នោត គាំទ្រ ការធ្វើ វិសោធនកម្ម នោះ ហើយ នឹង បោះឆ្នោត
សុនិតា បាន បញ្ចេញ ដំណឹង នេះ ឱ្យ មហាជន បាន ដឹង ម្សិលមិញ នេះ …
ការពិត បើ ពួកគេ មិន រស់ នៅក្នុង បច្ចុប្បន្ន នេះ ពួកគេ ក៍ មិន អាច រស់ នៅក្នុង អនាគត ដែរ ។
សុភមង្គល ថត ដោយ ៖
អត់ លុយ អាយុ ច្រើន ជាង ៥០ ឆ្នាំ អញ្ចឹង ស្រួល ហើយ មិន បាច់ ចំណាយ លុយ សំរាប់ រៀបការ នៅ ជាមួយគ្នា ដោយ មិន បាច់ រៀបការ ទៅ ។
លោក ហ៊ុន ម៉ាណែត ការចុះអនុស្សារណយោគយល់ គ្នាន …
ល្បែង របស់ ក្មេង
ក៏ប៉ុន្តែ គម្រោង នេះ អាចនឹង សម្រេច ទៅ បាន ទាល់តែ ដល់ ឆ្នាំ ២០២០ ឯណោះ ។
ស្រឡាញ់ សុខភាព គឺជា ការ នៅ ឆ្ងាយ ពី ស្រា ។
គេ នឹង ធ្វើបាប ក្រុម អ្នក ជឿ ឥត ត្រា ប្រណី ឡើយ ថែមទាំង មាន អ្នក ខ្លះ ក្នុង ចំណោម បងប្អូន នាំគ្នា ពោល ពាក្យបញ្ឆោត ដើម្បី ទាក់ទាញ ពួក សិស្ស ឱ្យ ទៅ តាម គេ ទៀតផង ។
រថយន្ត ធុន យក្ស ដឹក ដែក របស់ យាយ លឹម ក្រឡាប់ កណ្តាល ផ្លូវ បង្កឱ្យ ស្ទះ ចរាចរណ៍ កណ្តាល ថ្ងៃ
ជាទូទៅ ការកង្វះ អ័រម៉ូន នេះ នឹង ធ្វើឱ្យ ការជ្រុះ អូវ៉ុល មាន បញ្ហា បាន ។
យ៉ាងណាក៍ ដោយ ជារឿយ ៗ
សប្តាហ៍ នេះ ខ្ញុំ បាន ទទួលបាន ចូល ពី ទីផ្សារ ជាក់ស្តែង .
ចូរ និយាយ ថា ទេ ចំពោះ បទល្មើស ព្រៃឈើ និង សត្វ ព្រៃ
អតិថិជន ដើរ មើល ផ្ទះ នៅ ទីក្រុង សាន ហ្វ្រានស៊ីស្កូ មុនពេល សម្រេចចិត្ត ទិញ ។
យើង ចាត់ទុក ជា ការឃោសនា មួល បង្កាច់ ។
ជា ម្ចាស់ សណ្ឋាគារ អាំង ទែ កុង ទីណង់ តាល់ បន្ទាប់ពី ថេង ប៊ុន ម៉ាស្លាប់ និង ក្លឹប កំសាន្ត ស្ប៉ាក ។
សូម ស្តាប់ បទសម្ភាសន៍ រវាង លោក តាំង សារ៉ា ដា ជាមួយនឹង លោក សៀភារម្យ អំពី បញ្ហា នេះ ៖
អស់ រយៈពេល ជាច្រើន ឆ្នាំ ក្រោយមក ខ្ញុំ ក៏ បាន អបអរ ពិធី បុណ្យ ណូអែល ដោយសារ មូលហេតុ ជាច្រើន ដែល ក្នុង នោះ ខ្ញុំ បាន រាប់ ថ្ងៃ នោះ ជា ថ្ងៃ ពិសេស ដោយសារ វា ជា ថ្ងៃ ដែល ខ្ញុំ បាន សម្រាក ។
បុរស បងប្អូន ភ្លោះ ២នាក់ នេះ ធ្វើឱ្យ គេ ស្រឡាំងកាំង គ្រប់ គ្នា !
នោះ ប្រហែលជា ដោយសារតែ រូបរាង ស្រកា និង ជាពិសេស គឺ ពិស របស់ វា ហើយ ។
ប្រទេស ចិន អ្នកលក់ ដុំ
និង ជីវភាព ប្រចាំ ថ្ងៃ ។
មកទល់ ពេលនេះ លោក ដូណាល់ ត្រាំ នៅ មិន ទាន់ ប្រកាស ទទួលស្គាល់ លទ្ធផល បោះឆ្នោត នៅឡើយ ទេ ។
ក៏ និយម យក ផ្កា ធ្វើជា របស់ ជំនូន មួយ យ៉ាង សំខាន់ ដែរ ។
ប្រសិនបើ អ្នក ក្លាយជា ឪពុក ម្តាយ ក្មេង ឬ ប្រាថ្នា ចង់ មាន កូន ឆាប់ ៗ
ប៉ុន្តែ ការសម្រេច ចុងក្រោយ គឺ ស្ថិត នៅ លើ ក្រុមហ៊ុន ។
ក្រោយមក ទៀត ពួកគេ ត្រូវបាន ធ្វើតេស្ត ដោយ អោយ និយាយ អំពី ពាក្យ ដែល ពួកគេ បាន ចាំ ទាំងអស់ ។
អ្នក ចូលចិត្ត ធ្វើ អ្វី ៗ
ខណៈ នេះ អគ្គិភ័យ ក៏ ត្រូវបាន ពន្លត់ ឱ្យ រលត់ ហើយ ដែរ ។
